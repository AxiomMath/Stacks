/-!
# Vanishing of higher étale cohomology on a spectrum with strictly henselian local rings

Let `R` be a ring all of whose local rings are strictly henselian and let `F` be an abelian
sheaf on the small étale site of `Spec R`. If for every pair `f, g ∈ R` the restriction map

`H¹(D(f + g), F) ⟶ H¹(D(f(f + g)), F) ⊕ H¹(D(g(f + g)), F)`

has zero kernel, then `H^q(Spec R, F) = 0` for every `q > 0`.

## Main definitions

* `Stacks.EtaleCohomology.StrictlyHenselian.opensCohomology` — the étale cohomology of an
  abelian sheaf in a fixed degree, read as a presheaf on the lattice of open subschemes.

## Main results

* `Stacks.EtaleCohomology.StrictlyHenselian.exists_restrict_eq_zero` — a positive-degree class
  vanishes on a Zariski neighbourhood of every point, when the local rings are strictly
  henselian.
* `Stacks.EtaleCohomology.StrictlyHenselian.eq_zero_of_mayerVietoris` — a positive-degree class
  over a union of two opens vanishing on each of them is zero, provided the previous degree
  vanishes over their intersection.
* `Stacks.EtaleCohomology.StrictlyHenselian.eq_zero_of_basicOpen` — under the hypotheses of the
  criterion, every positive-degree class over a basic open is zero.
* `Stacks.EtaleCohomology.StrictlyHenselian.subsingleton_H_of_degreeOne_kernel_eq_zero` — the
  vanishing criterion itself.

## References

* [Stacks Project, Tag 0GY0](https://stacks.math.columbia.edu/tag/0GY0)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian AlgebraicGeometry Opposite
  TopologicalSpace

universe w uC vC uD vD u

namespace Stacks.EtaleCohomology.StrictlyHenselian

/-! ### Effacing a positive-degree `Ext`-class by an epimorphism -/

/-- **A positive-degree `Ext`-class is killed by restriction along some epimorphism onto its
first argument.** -/
private lemma exists_epi_precomp_eq_zero {A : Type uC} [Category.{vC} A] [Abelian A]
    [HasExt.{w} A] [HasInjectiveResolutions A] {Y Z : A} {q : ℕ} (hq : 0 < q)
    (e : Ext.{w} Y Z q) :
    ∃ (P : A) (p : P ⟶ Y), Epi p ∧ (Ext.mk₀ p).comp e (zero_add q) = 0 := by
  obtain ⟨n, rfl⟩ : ∃ n, q = n + 1 := ⟨q - 1, by omega⟩
  let I := injectiveResolution Z
  obtain ⟨f, hf, rfl⟩ := I.extMk_surjective e (n + 2) rfl
  obtain ⟨P, p, hp, g, hg⟩ := (I.exact_succ n).exact_up_to_refinements f hf
  refine ⟨P, p, hp, ?_⟩
  rw [I.mk₀_comp_extMk, I.extMk_eq_zero_iff _ _ _ _ n rfl]
  exact ⟨g, hg.symm⟩

/-- A class annihilated by restriction along `g` is annihilated by restriction along every
composite ending in `g`. -/
private lemma comp_eq_zero_of_comp {A : Type uC} [Category.{vC} A] [Abelian A] [HasExt.{w} A]
    {W X Y Z : A} (f : W ⟶ X) (g : X ⟶ Y) {n : ℕ} (e : Ext.{w} Y Z n)
    (h : (Ext.mk₀ g).comp e (zero_add n) = 0) :
    (Ext.mk₀ (f ≫ g)).comp e (zero_add n) = 0 := by
  rw [← Ext.mk₀_comp_mk₀_assoc, h, Ext.comp_zero]

/-- Restricting a section of a presheaf on the opens along two successive inclusions is
restricting it along their composite. -/
private lemma map_homOfLE_trans {T : Type u} [TopologicalSpace T]
    (P : (Opens T)ᵒᵖ ⥤ AddCommGrpCat.{w}) {U V W : Opens T} (hUV : U ≤ V) (hVW : V ≤ W)
    (x : P.obj (op W)) :
    P.map (homOfLE (hUV.trans hVW)).op x = P.map (homOfLE hUV).op (P.map (homOfLE hVW).op x) := by
  rw [show homOfLE (hUV.trans hVW) = homOfLE hUV ≫ homOfLE hVW from Subsingleton.elim _ _,
    op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

/-! ### The free abelian sheaf generated by an object of a site -/

section FreeSheaf

variable {C : Type uC} [Category.{vC} C] (J : GrothendieckTopology C)
  [HasSheafify J AddCommGrpCat.{vC}]

/-- The free abelian sheaf generated by an object of a site: the sheafification of the presheaf
of free abelian groups on the sets of morphisms to that object. -/
@[sga "7 VII 1.4"]
private abbrev freeSheaf (W : C) : Sheaf J AddCommGrpCat.{vC} :=
  (presheafToSheaf J AddCommGrpCat.{vC}).obj (yoneda.obj W ⋙ AddCommGrpCat.free)

/-- The morphism of free abelian sheaves induced by a morphism of the site. -/
private abbrev freeSheafMap {W W' : C} (g : W ⟶ W') : freeSheaf J W ⟶ freeSheaf J W' :=
  (presheafToSheaf J AddCommGrpCat.{vC}).map
    (Functor.whiskerRight (yoneda.map g) AddCommGrpCat.free)

/-- **Morphisms out of the free abelian sheaf on `W` are the sections over `W`.** This is the
composite of the sheafification adjunction, the free-forgetful adjunction and the Yoneda
bijection. -/
private def freeSheafHomEquiv {W : C} {G : Sheaf J AddCommGrpCat.{vC}} :
    (freeSheaf J W ⟶ G) ≃ G.obj.obj (op W) :=
  ((sheafificationAdjunction J AddCommGrpCat.{vC}).homEquiv _ G).trans
    (((AddCommGrpCat.adj.whiskerRight (C := Cᵒᵖ)).homEquiv (yoneda.obj W) G.obj).trans
      yonedaEquiv)

/-- The bijection of `freeSheafHomEquiv` is natural in the sheaf. -/
private lemma freeSheafHomEquiv_naturality_right {W : C}
    {G G' : Sheaf J AddCommGrpCat.{vC}} (a : freeSheaf J W ⟶ G) (f : G ⟶ G') :
    freeSheafHomEquiv J (a ≫ f) = f.hom.app (op W) (freeSheafHomEquiv J a) := rfl

/-- The bijection of `freeSheafHomEquiv` is natural in the object: precomposing with the map of
free abelian sheaves induced by `g` restricts the corresponding section along `g`. -/
private lemma freeSheafHomEquiv_naturality_left {W W' : C} (g : W ⟶ W')
    {G : Sheaf J AddCommGrpCat.{vC}} (f : freeSheaf J W' ⟶ G) :
    freeSheafHomEquiv J (freeSheafMap J g ≫ f) =
      G.obj.map g.op (freeSheafHomEquiv J f) := by
  dsimp only [freeSheafHomEquiv, Equiv.trans_apply]
  rw [Adjunction.homEquiv_naturality_left,
    show Functor.whiskerRight (yoneda.map g) AddCommGrpCat.free =
      ((Functor.whiskeringRight Cᵒᵖ (Type vC) AddCommGrpCat.{vC}).obj
        AddCommGrpCat.free).map (yoneda.map g) from rfl,
    Adjunction.homEquiv_naturality_left]
  exact (yonedaEquiv_naturality _ g).symm

end FreeSheaf

/-- **A fully faithful functor reflects the pushforward of a sieve.** If the image of `g` lies in
the pushforward along a fully faithful functor of a sieve `S`, then `g` lies in `S`. -/
private lemma mem_of_mem_functorPushforward {C : Type uC} [Category.{vC} C] {D : Type uD}
    [Category.{vD} D] (i : D ⥤ C) [i.Full] [i.Faithful] {Y Z : D} (S : Sieve Y) (g : Z ⟶ Y)
    (h : (S.functorPushforward i).arrows (i.map g)) : S.arrows g := by
  obtain ⟨T, a, b, ha, hb⟩ := h
  have hgi : g = i.preimage b ≫ a :=
    i.map_injective (by rwa [Functor.map_comp, Functor.map_preimage])
  rw [hgi]
  exact S.downward_closed ha _

/-! ### Cohomology over the open subschemes -/

variable {X : Scheme.{u}}

/-- **The étale cohomology of an abelian sheaf over the open subschemes of a scheme.** In a
fixed degree it is a presheaf on the lattice of open subschemes of `X`, namely the restriction
of `CategoryTheory.Sheaf.cohomologyPresheaf` along the inclusion of the opens into the small
étale site. -/
public abbrev opensCohomology (F : Sheaf (MayerVietoris.topology X) AddCommGrpCat.{u + 1})
    (q : ℕ) : X.Opensᵒᵖ ⥤ AddCommGrpCat.{u + 1} :=
  (MayerVietoris.opensToSite X).op ⋙ F.cohomologyPresheaf q

/-- Restriction of a cohomology class along an inclusion of opens is the Yoneda product with
the induced map of free abelian sheaves. -/
private lemma opensCohomology_map_apply
    (F : Sheaf (MayerVietoris.topology X) AddCommGrpCat.{u + 1}) (q : ℕ)
    {U V : X.Opens} (i : U ⟶ V) (x : (opensCohomology F q).obj (op V)) :
    (opensCohomology F q).map i.op x =
      (Ext.mk₀ (freeSheafMap (MayerVietoris.topology X)
        ((MayerVietoris.opensToSite X).map i))).comp x (zero_add q) := rfl

/-! ### The empty open subscheme -/

/-- The empty sieve covers the empty open subscheme in the small étale site. -/
private lemma bot_mem_topology_obj_bot (X : Scheme.{u}) :
    (⊥ : Sieve ((MayerVietoris.opensToSite X).obj ⊥)) ∈
      MayerVietoris.topology X ((MayerVietoris.opensToSite X).obj ⊥) := by
  have hemp : IsEmpty ↥(⊥ : X.Opens).toScheme := ⟨fun x => x.2⟩
  have hc : Sieve.ofArrows (fun _ : Empty => (opensToEtale X).obj (⊥ : X.Opens))
      (fun i => i.elim) ∈
        X.smallEtaleTopology ((opensToEtale X).obj (⊥ : X.Opens)) := by
    rw [Scheme.ofArrows_mem_smallEtaleTopology_iff, Set.eq_univ_iff_forall]
    exact fun y => hemp.elim y
  rw [Functor.mem_inducedTopology_iff_of_isCoverDense]
  refine X.smallEtaleTopology.superset_covering ?_ hc
  rintro Y g ⟨Z, a, b, ⟨i⟩, -⟩
  exact i.elim

/-- Sections of an abelian sheaf over the empty open subscheme are unique. -/
private lemma subsingleton_sections_obj_bot
    (G : Sheaf (MayerVietoris.topology X) AddCommGrpCat.{u + 1}) :
    Subsingleton (G.obj.obj (op ((MayerVietoris.opensToSite X).obj (⊥ : X.Opens)))) := by
  have h := (isSheaf_iff_isSheaf_of_type _ _).1
    ((sheafCompose (MayerVietoris.topology X)
      (forget AddCommGrpCat.{u + 1})).obj G).property _ (bot_mem_topology_obj_bot X)
  exact ⟨fun a b => h.isSeparatedFor.ext (by rintro Y g ⟨⟩)⟩

/-- **Cohomology over the empty open subscheme vanishes in every degree.** -/
private lemma subsingleton_opensCohomology_bot
    (F : Sheaf (MayerVietoris.topology X) AddCommGrpCat.{u + 1}) (q : ℕ) :
    Subsingleton ((opensCohomology F q).obj (op (⊥ : X.Opens))) := by
  have hA : IsZero (freeSheaf (MayerVietoris.topology X)
      ((MayerVietoris.opensToSite X).obj (⊥ : X.Opens))) :=
    (IsZero.iff_id_eq_zero _).2 ((freeSheafHomEquiv (MayerVietoris.topology X)).injective
      ((subsingleton_sections_obj_bot _).elim _ _))
  have := hA.hasProjectiveDimensionLT_zero
  have key : ∀ y : Ext.{u + 1} (freeSheaf (MayerVietoris.topology X)
      ((MayerVietoris.opensToSite X).obj (⊥ : X.Opens))) F q, y = 0 :=
    fun y => Ext.eq_zero_of_hasProjectiveDimensionLT y 0 (by omega)
  exact subsingleton_of_forall_eq 0 key

/-! ### Zariski-local vanishing -/

/-- **A positive-degree cohomology class vanishes Zariski-locally** when every local ring of `X`
is strictly henselian: given a class over an open subscheme `U` and a point `p` of `U`, its
restriction to some open neighbourhood of `p` inside `U` is zero. -/
public theorem exists_restrict_eq_zero
    (hlocal : ∀ x : X, StrictlyHenselianLocalRing ↥(X.presheaf.stalk x))
    (F : Sheaf (MayerVietoris.topology X) AddCommGrpCat.{u + 1}) {q : ℕ} (hq : 0 < q)
    (U : X.Opens) (x : (opensCohomology F q).obj (op U)) (p : X) (hp : p ∈ U) :
    ∃ (V : X.Opens) (hVU : V ≤ U), p ∈ V ∧
      (opensCohomology F q).map (homOfLE hVU).op x = 0 := by
  obtain ⟨E, π, hπ, hx⟩ := exists_epi_precomp_eq_zero hq x
  have hls : Sheaf.IsLocallySurjective π :=
    (Sheaf.isLocallySurjective_iff_epi' _ π).2 hπ
  have hmem := Presheaf.imageSieve_mem (MayerVietoris.topology X) π.hom
    (U := op ((MayerVietoris.opensToSite X).obj U))
    (freeSheafHomEquiv (MayerVietoris.topology X) (𝟙 _))
  rw [Functor.mem_inducedTopology_iff_of_isCoverDense] at hmem
  obtain ⟨V, i, hi, hpV⟩ := (Opens.mem_grothendieckTopology ↑X).1
    ((isCocontinuous_opensToEtale X hlocal).cover_lift (U := U) hmem) p hp
  obtain ⟨t, ht⟩ := mem_of_mem_functorPushforward (AsSmall.down (C := X.Etale)) _
    ((MayerVietoris.opensToSite X).map i) hi
  set g := (freeSheafHomEquiv (MayerVietoris.topology X)).symm t with hgdef
  have e₁ : freeSheafHomEquiv (MayerVietoris.topology X) (g ≫ π) = π.hom.app _ t := by
    rw [freeSheafHomEquiv_naturality_right, hgdef, Equiv.apply_symm_apply]
  have e₂ := freeSheafHomEquiv_naturality_left (MayerVietoris.topology X)
    ((MayerVietoris.opensToSite X).map i)
    (𝟙 (freeSheaf (MayerVietoris.topology X) ((MayerVietoris.opensToSite X).obj U)))
  rw [Category.comp_id] at e₂
  have hg : g ≫ π =
      freeSheafMap (MayerVietoris.topology X) ((MayerVietoris.opensToSite X).map i) :=
    (freeSheafHomEquiv (MayerVietoris.topology X)).injective (e₁.trans (ht.trans e₂.symm))
  refine ⟨V, i.le, hpV, ?_⟩
  have hkey := comp_eq_zero_of_comp g π x hx
  rw [hg] at hkey
  exact hkey

/-! ### The Mayer--Vietoris step -/

section MayerVietorisStep

open GrothendieckTopology.MayerVietorisSquare

/-- **A positive-degree class over a union of two opens, vanishing on each of them, is zero**,
provided every class of the previous degree over their intersection vanishes. -/
public theorem eq_zero_of_mayerVietoris
    (F : Sheaf (MayerVietoris.topology X) AddCommGrpCat.{u + 1}) {U V W T : X.Opens}
    (hUW : U ≤ W) (hVW : V ≤ W) (hW : W = U ⊔ V) (hT : T = U ⊓ V) {q : ℕ} (hq : 0 < q)
    (x : (opensCohomology F q).obj (op W))
    (hU : (opensCohomology F q).map (homOfLE hUW).op x = 0)
    (hV : (opensCohomology F q).map (homOfLE hVW).op x = 0)
    (hprev : ∀ y : (opensCohomology F (q - 1)).obj (op T), y = 0) : x = 0 := by
  subst hW hT
  have hU' : (F.cohomologyPresheaf q).map (MayerVietoris.square X U V).f₂₄.op x = 0 := hU
  have hV' : (F.cohomologyPresheaf q).map (MayerVietoris.square X U V).f₃₄.op x = 0 := hV
  have ht : (MayerVietoris.square X U V).toBiprod F q x = 0 := by
    refine Eq.trans (toBiprod_apply (MayerVietoris.square X U V) F x) ?_
    rw [hU', hV']
    exact map_zero _
  have hx : (Ext.mk₀ (MayerVietoris.square X U V).shortComplex.g).comp x (zero_add q) = 0 := by
    refine Eq.trans
      (biprodAddEquiv_symm_biprodIsoProd_hom_toBiprod_apply (MayerVietoris.square X U V)
        F x).symm ?_
    rw [ht, map_zero]
    exact map_zero _
  obtain ⟨y, hy⟩ := Ext.contravariant_sequence_exact₃
    (MayerVietoris.square X U V).shortComplex_shortExact F x hx (n₀ := q - 1) (by omega)
  rw [hprev y] at hy
  exact hy.symm.trans (Ext.comp_zero _ _ _ _ _)

end MayerVietorisStep

/-! ### The ideal of elements along which a class dies -/

section Spec

variable {R : Type u} [CommRing R]

/-- An ideal meeting the complement of every prime that avoids `h` contains a power of `h`. -/
private theorem exists_pow_mem_of_near_every_prime (I : Ideal R) (h : R)
    (hnear : ∀ p : PrimeSpectrum R, h ∉ p.asIdeal → ∃ f : R, f ∉ p.asIdeal ∧ f ∈ I) :
    ∃ n : ℕ, h ^ n ∈ I := by
  by_contra hn
  have hdisj : Disjoint (I : Set R) (Submonoid.powers h) :=
    Set.disjoint_left.mpr (by rintro x hxI ⟨n, rfl⟩; exact hn ⟨n, hxI⟩)
  obtain ⟨p, hp, hIp, hpdisj⟩ := I.exists_le_prime_disjoint (Submonoid.powers h) hdisj
  have hh : h ∉ p := fun hhp => (Set.disjoint_left.mp hpdisj hhp) ⟨1, by simp⟩
  obtain ⟨f, hfp, hfI⟩ := hnear ⟨p, hp⟩ hh
  exact hfp (hIp hfI)

/-- The covering `D(f + g) = D(f(f + g)) ∪ D(g(f + g))`: a prime avoiding `f + g` cannot
contain both `f` and `g`. -/
public lemma basicOpen_add_eq_sup (f g : R) :
    PrimeSpectrum.basicOpen (f + g) =
      PrimeSpectrum.basicOpen (f * (f + g)) ⊔ PrimeSpectrum.basicOpen (g * (f + g)) := by
  have h : PrimeSpectrum.basicOpen (f + g) ≤
      PrimeSpectrum.basicOpen f ⊔ PrimeSpectrum.basicOpen g := by
    intro p hp
    by_cases hf : f ∈ p.asIdeal
    · exact Or.inr fun hg => hp (p.asIdeal.add_mem hf hg)
    · exact Or.inl hf
  rw [PrimeSpectrum.basicOpen_mul, PrimeSpectrum.basicOpen_mul, ← inf_sup_right,
    inf_eq_right.mpr h]

/-- **Sections of a presheaf on the opens of a spectrum vanish over every basic open** as soon
as the sections over the empty open are unique, a section over `D(f + g)` vanishing over
`D(f(f + g))` and over `D(g(f + g))` is zero, and every section vanishes over a basic open
neighbourhood of each point of its domain. -/
private lemma eq_zero_of_basicOpen_add
    (P : (Opens (PrimeSpectrum R))ᵒᵖ ⥤ AddCommGrpCat.{w})
    (hbot : Subsingleton (P.obj (op ⊥)))
    (hadd : ∀ f g : R, ∀ y : P.obj (op (PrimeSpectrum.basicOpen (f + g))),
      P.map (homOfLE (PrimeSpectrum.basicOpen_mul_le_right f (f + g))).op y = 0 →
      P.map (homOfLE (PrimeSpectrum.basicOpen_mul_le_right g (f + g))).op y = 0 → y = 0)
    (hloc : ∀ (U : Opens (PrimeSpectrum R)) (z : P.obj (op U)) (p : PrimeSpectrum R),
      p ∈ U → ∃ (a : R) (ha : PrimeSpectrum.basicOpen a ≤ U),
        a ∉ p.asIdeal ∧ P.map (homOfLE ha).op z = 0)
    (b : R) (x : P.obj (op (PrimeSpectrum.basicOpen b))) : x = 0 := by
  let hb (s : R) : PrimeSpectrum.basicOpen (b * s) ≤ PrimeSpectrum.basicOpen b :=
    PrimeSpectrum.basicOpen_mul_le_left b s
  have restrict_zero {a c : R} (ha : PrimeSpectrum.basicOpen a ≤ PrimeSpectrum.basicOpen b)
      (hc : PrimeSpectrum.basicOpen c ≤ PrimeSpectrum.basicOpen a)
      (hx : P.map (homOfLE ha).op x = 0) :
      P.map (homOfLE (hc.trans ha)).op x = 0 := by
    rw [map_homOfLE_trans P hc ha, hx, map_zero]
  let I : Ideal R :=
    { carrier := {s | P.map (homOfLE (hb s)).op x = 0}
      zero_mem' := by
        have : Subsingleton (P.obj (op (PrimeSpectrum.basicOpen (b * 0)))) := by
          simpa using hbot
        exact Subsingleton.elim _ _
      add_mem' := by
        intro s t hs ht
        change P.map (homOfLE (hb s)).op x = 0 at hs
        change P.map (homOfLE (hb t)).op x = 0 at ht
        have H := hadd (b * s) (b * t)
        rw [show b * s + b * t = b * (s + t) from (_root_.mul_add b s t).symm] at H
        show P.map (homOfLE (hb (s + t))).op x = 0
        refine H _ ?_ ?_
        · rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp]
          exact restrict_zero (hb s)
            (by rw [PrimeSpectrum.basicOpen_mul]; exact inf_le_left) hs
        · rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp]
          exact restrict_zero (hb t)
            (by rw [PrimeSpectrum.basicOpen_mul]; exact inf_le_left) ht
      smul_mem' := by
        intro c s hs
        change P.map (homOfLE (hb s)).op x = 0 at hs
        show P.map (homOfLE (hb (c * s))).op x = 0
        refine restrict_zero (hb s) ?_ hs
        simp only [PrimeSpectrum.basicOpen_mul]
        exact le_inf inf_le_left (inf_le_right.trans inf_le_right) }
  have hnear : ∀ p : PrimeSpectrum R, b ∉ p.asIdeal → ∃ a, a ∉ p.asIdeal ∧ a ∈ I := by
    intro p hp
    obtain ⟨a, ha, hpa, hx⟩ := hloc _ x p hp
    exact ⟨a, hpa, restrict_zero ha (by simp [PrimeSpectrum.basicOpen_mul]) hx⟩
  obtain ⟨n, hn⟩ := exists_pow_mem_of_near_every_prime I b hnear
  have he : PrimeSpectrum.basicOpen (b * b ^ n) = PrimeSpectrum.basicOpen b := by
    rw [← pow_succ', PrimeSpectrum.basicOpen_pow _ _ (Nat.succ_pos n)]
  have : IsIso (homOfLE (hb (b ^ n))) := isIso_homOfLE he
  refine (AddCommGrpCat.mono_iff_injective (P.map (homOfLE (hb (b ^ n))).op)).1
    inferInstance ?_
  change P.map (homOfLE (hb (b ^ n))).op x = 0 at hn
  simpa only [map_zero] using hn

/-! ### The induction on the degree -/

/-- **Vanishing over every basic open, in every positive degree.** Under the hypotheses of
`subsingleton_H_of_degreeOne_kernel_eq_zero`, every positive-degree cohomology class of `F` over a
basic open `D(b)` of `Spec R` is zero. -/
public theorem eq_zero_of_basicOpen
    (hlocal : ∀ x : Spec (CommRingCat.of R), StrictlyHenselianLocalRing
      ↥((Spec (CommRingCat.of R)).presheaf.stalk x))
    (F : Sheaf (MayerVietoris.topology (Spec (CommRingCat.of R))) AddCommGrpCat.{u + 1})
    (h₁ : ∀ f g : R, ∀ y : (opensCohomology F 1).obj (op (PrimeSpectrum.basicOpen (f + g))),
      (opensCohomology F 1).map
          (homOfLE (PrimeSpectrum.basicOpen_mul_le_right f (f + g))).op y = 0 →
      (opensCohomology F 1).map
          (homOfLE (PrimeSpectrum.basicOpen_mul_le_right g (f + g))).op y = 0 → y = 0) :
    ∀ q : ℕ, 0 < q → ∀ b : R,
      ∀ x : (opensCohomology F q).obj (op (PrimeSpectrum.basicOpen b)), x = 0 := by
  intro q
  induction q using Nat.strong_induction_on with
  | h q ih =>
    intro hq b x
    refine eq_zero_of_basicOpen_add (opensCohomology F q)
      (subsingleton_opensCohomology_bot F q) ?_ ?_ b x
    · intro f g y hy₂ hy₃
      by_cases hq1 : q = 1
      · subst hq1
        exact h₁ f g y hy₂ hy₃
      · exact eq_zero_of_mayerVietoris F
          (PrimeSpectrum.basicOpen_mul_le_right f (f + g))
          (PrimeSpectrum.basicOpen_mul_le_right g (f + g))
          (basicOpen_add_eq_sup f g)
          (PrimeSpectrum.basicOpen_mul (f * (f + g)) (g * (f + g))) hq y hy₂ hy₃
          (ih (q - 1) (by omega) (by omega) ((f * (f + g)) * (g * (f + g))))
    · intro U z p hp
      obtain ⟨V, hVU, hpV, hz⟩ := exists_restrict_eq_zero hlocal F hq U z p hp
      obtain ⟨W, ⟨c, rfl⟩, hpc, hcV⟩ :=
        PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hpV V.isOpen
      have hc : PrimeSpectrum.basicOpen c ≤ V := hcV
      refine ⟨c, hc.trans hVU, hpc, Eq.trans (map_homOfLE_trans (opensCohomology F q) hc hVU z) ?_⟩
      rw [hz, map_zero]

/-- Let `R` be a ring all of whose local rings are strictly henselian and let `F` be an abelian
sheaf on the small étale site of `Spec R`. If for all `f, g ∈ R` the kernel of

`H¹(D(f + g), F) ⟶ H¹(D(f(f + g)), F) ⊕ H¹(D(g(f + g)), F)`

is zero, then `H^q(Spec R, F) = 0` for every `q > 0`. -/
@[stacks 0GY0]
public theorem subsingleton_H_of_degreeOne_kernel_eq_zero
    (hlocal : ∀ x : Spec (CommRingCat.of R), StrictlyHenselianLocalRing
      ↥((Spec (CommRingCat.of R)).presheaf.stalk x))
    (F : Sheaf (MayerVietoris.topology (Spec (CommRingCat.of R))) AddCommGrpCat.{u + 1})
    (h₁ : ∀ f g : R, ∀ y : (opensCohomology F 1).obj (op (PrimeSpectrum.basicOpen (f + g))),
      (opensCohomology F 1).map
          (homOfLE (PrimeSpectrum.basicOpen_mul_le_right f (f + g))).op y = 0 →
      (opensCohomology F 1).map
          (homOfLE (PrimeSpectrum.basicOpen_mul_le_right g (f + g))).op y = 0 → y = 0)
    (q : ℕ) (hq : 0 < q) :
    Subsingleton (Sheaf.H.{u + 1} F q) := by
  rw [Stacks.Cohomology.TerminalCohomology.subsingleton_H_iff_subsingleton_H'
    (MayerVietoris.topology (Spec (CommRingCat.of R))) F q _
    (MayerVietoris.topIsTerminal (Spec (CommRingCat.of R)))]
  refine subsingleton_of_forall_eq 0 fun y => ?_
  have hvan := eq_zero_of_basicOpen hlocal F h₁ q hq 1
  rw [PrimeSpectrum.basicOpen_one] at hvan
  exact hvan y

end Spec

end Stacks.EtaleCohomology.StrictlyHenselian

end
