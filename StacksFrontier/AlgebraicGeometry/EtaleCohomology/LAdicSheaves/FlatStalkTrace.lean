module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.LAdicSheaves.StalkMatrix
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.LAdicSheaves.TorsionFreeModel
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.LAdicSheaves.StalkFunctoriality
public import StacksFrontier.Homology.Perfect.ZModPrimePowerReduction
public import StacksFrontier.CategoryTheory.Abelian.PowExact
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Trace.DerivedStalkPerfection

/-!
# Traces on the rational stalks of an ℓ-adic sheaf

Two facts about the trace of an endomorphism `a` of a geometric point `x̄` acting on the rational
stalk `ℚ_ℓ ⊗ F_x̄` of an ℓ-adic sheaf, as used for the point side of the trace formula of
[Tag 03V2](https://stacks.math.columbia.edu/tag/03V2):

* it is invariant under isogeny: if `φ : F ⟶ G` and `ψ : G ⟶ F` compose to multiplication by
  `ℓᴺ` both ways, the rational stalks are identified by `φ` compatibly with `a`;
* this lets one pass to the torsion-free model of `F`, whose stalk is computed from the finite
  levels (item (4) of the proof of Tag 03V2).

## Main results

* `Stacks.EtaleCohomology.basisOfLift`: bases lift along a flat surjection `ℤ/pⁿ⁺²ℤ → ℤ/pⁿ⁺¹ℤ`.
* `Stacks.EtaleCohomology.LAdicSheaf.flatLevelTrivialization`: compatible trivialisations of flat
  finite-level stalks.
* `Stacks.EtaleCohomology.LAdicSheaf.exists_trace_rationalStalkEnd_of_flat`: for flat finite-level
  stalks the rational trace is the ℓ-adic limit of the finite-level traces.
* `Stacks.EtaleCohomology.LAdicSheaf.trace_rationalStalkEnd_of_isogeny`.
* `Stacks.EtaleCohomology.LAdicSheaf.exists_trace_rationalStalkEnd_torsionFreeModel`: item (4) of
  the proof of Tag 03V2.

## References

* [Stacks Project, Tag 03V2](https://stacks.math.columbia.edu/tag/03V2)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Abelian AlgebraicGeometry AlgebraicGeometry.SmallEtale
open Stacks.ZModPrimePower

universe u

namespace Stacks.EtaleCohomology

variable {B : BigEtaleSite.{u}} {X : B.Scheme} {ℓ : ℕ}

variable [∀ (n : ℕ) (S T : B.Scheme) (f : T ⟶ S),
  ((smallEtaleBaseChange B f).sheafPushforwardContinuous
    (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1))))
    (SmallEtale.topology B S.1 S.property)
    (SmallEtale.topology B T.1 T.property)).IsRightAdjoint]
variable [∀ (n : ℕ) (T : B.Scheme) (V : SmallEtale B T.1 T.property),
  HasWeakSheafify ((SmallEtale.topology B T.1 T.property).over V)
    (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1))))]
variable [∀ n : ℕ, HasWeakSheafify
  (SmallEtale.topology B X.1 X.property)
  (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1))))]
variable [IsNoetherian X.1] [Fact ℓ.Prime]

/-! ### Lifting bases along `ℤ/pⁿ⁺²ℤ → ℤ/pⁿ⁺¹ℤ` -/

section Lifting

variable {p : ℕ} [Fact p.Prime]

/-- The kernel of the reduction `ℤ/pⁿ⁺²ℤ → ℤ/pⁿ⁺¹ℤ` is generated by `pⁿ⁺¹`. -/
theorem exists_eq_pow_mul_of_castHom_eq_zero {n : ℕ} {c : ZMod (p ^ (n + 2))}
    (hc : ZMod.castHom (pow_dvd_pow p (Nat.le_succ (n + 1))) (ZMod (p ^ (n + 1))) c = 0) :
    ∃ d, c = (p : ZMod (p ^ (n + 2))) ^ (n + 1) * d := by
  obtain ⟨k, rfl⟩ : ∃ k : ℕ, (k : ZMod (p ^ (n + 2))) = c := ⟨c.val, ZMod.natCast_zmod_val c⟩
  rw [map_natCast, ZMod.natCast_eq_zero_iff] at hc
  obtain ⟨t, rfl⟩ := hc
  exact ⟨t, by push_cast; ring⟩

/-- **A basis lifts along a flat surjection with kernel `pⁿ⁺¹ M`.** Let `M` be a flat
`ℤ/pⁿ⁺²ℤ`-module, `N` a `ℤ/pⁿ⁺¹ℤ`-module and `T : M → N` additive, semilinear over the reduction,
surjective, with kernel `pⁿ⁺¹ M`. Any lift of a basis of `N` is a basis of `M`. -/
noncomputable def basisOfLift {n r : ℕ} {M N : Type*} [AddCommGroup M]
    [Module (ZMod (p ^ (n + 2))) M]
    [AddCommGroup N] [Module (ZMod (p ^ (n + 1))) N] (hM : IsPowExact p (n + 2) M) (T : M →+ N)
    (hT : ∀ (c : ZMod (p ^ (n + 2))) x, T (c • x) =
      ZMod.castHom (pow_dvd_pow p (Nat.le_succ (n + 1))) (ZMod (p ^ (n + 1))) c • T x)
    (hker : ∀ x, T x = 0 → ∃ y, x = p ^ (n + 1) • y)
    (b : Module.Basis (Fin r) (ZMod (p ^ (n + 1))) N) (b' : Fin r → M) (hb' : ∀ i, T (b' i) = b i) :
    Module.Basis (Fin r) (ZMod (p ^ (n + 2))) M := by
  classical
  let ρ := ZMod.castHom (pow_dvd_pow p (Nat.le_succ (n + 1))) (ZMod (p ^ (n + 1)))
  have hρ : Function.Surjective ρ := ZMod.ringHom_surjective ρ
  have hTsum : ∀ g : Fin r → ZMod (p ^ (n + 2)), T (∑ i, g i • b' i) = ∑ i, ρ (g i) • b i := by
    intro g
    rw [map_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [hT, hb']
  have hlift : ∀ x : M, ∃ g : Fin r → ZMod (p ^ (n + 2)), ∃ y,
      x = ∑ i, g i • b' i + p ^ (n + 1) • y := by
    intro x
    choose g hg using fun i => hρ (b.repr (T x) i)
    obtain ⟨y, hy⟩ := hker (x - ∑ i, g i • b' i) (by
      rw [map_sub, hTsum, sub_eq_zero]
      simp_rw [hg]
      exact (b.sum_repr (T x)).symm)
    exact ⟨g, y, by rw [← hy, add_sub_cancel]⟩
  have hspan : ⊤ ≤ Submodule.span (ZMod (p ^ (n + 2))) (Set.range b') := by
    intro x _
    obtain ⟨g, y, rfl⟩ := hlift x
    obtain ⟨g', y', rfl⟩ := hlift y
    have hz : p ^ (n + 1) • p ^ (n + 1) • y' = 0 := by
      rw [smul_smul, ← pow_add, show n + 1 + (n + 1) = (n + 2) + n by omega, pow_add, mul_comm,
        mul_nsmul, pow_nsmul_eq_zero]
    rw [smul_add, hz, add_zero]
    exact Submodule.add_mem _ (Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _
      (Submodule.subset_span ⟨i, rfl⟩)) (Submodule.smul_of_tower_mem _ _ (Submodule.sum_mem _
        fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)))
  have hli : LinearIndependent (ZMod (p ^ (n + 2))) b' := by
    rw [Fintype.linearIndependent_iff]
    intro g hg i
    have h0 : ∀ j, ρ (g j) = 0 := by
      have := hTsum g
      rw [hg, map_zero] at this
      exact (Fintype.linearIndependent_iff.1 b.linearIndependent _ this.symm)
    choose d hd using fun j => exists_eq_pow_mul_of_castHom_eq_zero (h0 j)
    have hx : p ^ (n + 1) • ∑ j, d j • b' j = 0 := by
      rw [← hg, Finset.smul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [hd j, ← smul_smul, ← Nat.cast_smul_eq_nsmul (ZMod (p ^ (n + 2))), Nat.cast_pow]
    obtain ⟨y, hy⟩ := hM (n + 1) (by omega) _ hx
    rw [show n + 2 - (n + 1) = 1 by omega, pow_one] at hy
    have hTy : ∑ j, ρ (d j) • b j = ∑ j, ((p : ZMod (p ^ (n + 1))) * b.repr (T y) j) • b j := by
      rw [← hTsum, ← hy, map_nsmul]
      conv_lhs => rw [← b.sum_repr (T y)]
      rw [Finset.smul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← Nat.cast_smul_eq_nsmul (ZMod (p ^ (n + 1))), smul_smul]
    have hde : ∀ j, ρ (d j) = (p : ZMod (p ^ (n + 1))) * b.repr (T y) j := by
      have h := sub_eq_zero.2 hTy
      rw [← Finset.sum_sub_distrib] at h
      simp_rw [← sub_smul] at h
      exact fun j => sub_eq_zero.1 (Fintype.linearIndependent_iff.1 b.linearIndependent _ h j)
    obtain ⟨ε, hε⟩ := hρ (b.repr (T y) i)
    obtain ⟨f, hf⟩ := exists_eq_pow_mul_of_castHom_eq_zero (c := d i - (p : ZMod (p ^ (n + 2))) * ε)
      (by rw [map_sub, map_mul, map_natCast, hε, hde, sub_self])
    rw [hd i, show d i = (p : ZMod (p ^ (n + 2))) * ε + (p : ZMod (p ^ (n + 2))) ^ (n + 1) * f by
      linear_combination hf]
    calc (p : ZMod (p ^ (n + 2))) ^ (n + 1) * (p * ε + p ^ (n + 1) * f)
        = (p : ZMod (p ^ (n + 2))) ^ (n + 2) * (ε + p ^ n * f) := by ring
      _ = 0 := by rw [← Nat.cast_pow, ZMod.natCast_self, zero_mul]
  exact Module.Basis.mk hli hspan

/-- The `i`-th vector of the basis `basisOfLift` is the lift `b' i`. -/
theorem basisOfLift_apply {n r : ℕ} {M N : Type*} [AddCommGroup M] [Module (ZMod (p ^ (n + 2))) M]
    [AddCommGroup N] [Module (ZMod (p ^ (n + 1))) N] (hM : IsPowExact p (n + 2) M) (T : M →+ N)
    (hT : ∀ (c : ZMod (p ^ (n + 2))) x, T (c • x) =
      ZMod.castHom (pow_dvd_pow p (Nat.le_succ (n + 1))) (ZMod (p ^ (n + 1))) c • T x)
    (hker : ∀ x, T x = 0 → ∃ y, x = p ^ (n + 1) • y)
    (b : Module.Basis (Fin r) (ZMod (p ^ (n + 1))) N) (b' : Fin r → M) (hb' : ∀ i, T (b' i) = b i)
    (i : Fin r) : basisOfLift hM T hT hker b b' hb' i = b' i := by
  simp only [basisOfLift, Module.Basis.coe_mk]

end Lifting

/-! ### The stalk of an ℓ-adic sheaf with flat finite-level stalks -/

section FlatStalk

variable (F : LAdicSheaf B X ℓ) (s : GeometricPoint X.1)

/-- `ℤ/ℓⁿ⁺¹ℤ` is a local ring, being a quotient of `ℤ_ℓ`. -/
theorem zmod_pow_succ_isLocalRing (n : ℕ) : IsLocalRing (ZMod (ℓ ^ (n + 1))) := by
  have : Fact (1 < ℓ ^ (n + 1)) :=
    ⟨Nat.one_lt_pow (Nat.succ_ne_zero n) (Fact.out : ℓ.Prime).one_lt⟩
  exact IsLocalRing.of_surjective' (PadicInt.toZModPow (n + 1)) (ZMod.ringHom_surjective _)

/-- The transition between finite-level stalks has kernel `ℓⁿ⁺¹` times the stalk. -/
theorem finiteLevelStalkTransition_ker (n : ℕ) (x : finiteLevelStalk B X ℓ F s (n + 1))
    (hx : (finiteLevelStalkTransition B X ℓ F s n).hom x = 0) : ∃ y, x = ℓ ^ (n + 1) • y := by
  obtain ⟨e, he⟩ := finiteLevelStalkTransition_quotient B X ℓ F s n
  have h0 : Submodule.Quotient.mk x = 0 := e.injective (by rw [he, hx, map_zero])
  rw [Submodule.Quotient.mk_eq_zero, Submodule.ideal_span_singleton_smul,
    Submodule.mem_smul_pointwise_iff_exists] at h0
  obtain ⟨y, -, hy⟩ := h0
  exact ⟨y, by rw [← hy, ← Nat.cast_smul_eq_nsmul (ZMod (ℓ ^ (n + 2))), Nat.cast_pow]⟩

/-- The rank of the level-`0` stalk. -/
def LAdicSheaf.flatStalkRank : ℕ :=
  Module.finrank (ZMod (ℓ ^ (0 + 1))) (finiteLevelStalk B X ℓ F s 0)

/-- Bases of the finite-level stalks compatible with the transitions, for flat finite-level
stalks: a basis of the level-`0` stalk (free, being finite and flat over the local ring
`ℤ/ℓℤ`), lifted level by level. -/
def LAdicSheaf.flatLevelBasis (hF : ∀ n, IsPowExact ℓ (n + 1) (finiteLevelStalk B X ℓ F s n)) :
    (n : ℕ) → Module.Basis (Fin (LAdicSheaf.flatStalkRank F s)) (ZMod (ℓ ^ (n + 1)))
      (finiteLevelStalk B X ℓ F s n)
  | 0 =>
    haveI := zmod_pow_succ_isLocalRing (ℓ := ℓ) 0
    haveI : Fact (1 < ℓ ^ (0 + 1)) := ⟨by simpa using (Fact.out : ℓ.Prime).one_lt⟩
    haveI : Finite (finiteLevelStalk B X ℓ F s 0) := finite_finiteLevelStalk B X ℓ F s 0
    haveI : Module.Finite (ZMod (ℓ ^ (0 + 1))) (finiteLevelStalk B X ℓ F s 0) :=
      Module.Finite.of_finite
    haveI : Module.Flat (ZMod (ℓ ^ (0 + 1))) (finiteLevelStalk B X ℓ F s 0) :=
      flat_of_isPowExact (hF 0)
    haveI : Module.Free (ZMod (ℓ ^ (0 + 1))) (finiteLevelStalk B X ℓ F s 0) :=
      Module.free_of_flat_of_isLocalRing
    Module.finBasis _ _
  | n + 1 =>
    basisOfLift (hF (n + 1)) (finiteLevelStalkTransition B X ℓ F s n).hom.toAddMonoidHom
      (fun c x => by
        change (finiteLevelStalkTransition B X ℓ F s n).hom (c • x) = _
        exact map_smul _ c x)
      (finiteLevelStalkTransition_ker F s n) (LAdicSheaf.flatLevelBasis hF n)
      (fun i => (finiteLevelStalkTransition_surjective B X ℓ F s n
        (LAdicSheaf.flatLevelBasis hF n i)).choose)
      (fun i => (finiteLevelStalkTransition_surjective B X ℓ F s n
        (LAdicSheaf.flatLevelBasis hF n i)).choose_spec)

/-- The transition from level `n + 1` to level `n` sends each vector of `LAdicSheaf.flatLevelBasis`
at level `n + 1` to the vector with the same index at level `n`. -/
theorem LAdicSheaf.stalkTransition_flatLevelBasis
    (hF : ∀ n, IsPowExact ℓ (n + 1) (finiteLevelStalk B X ℓ F s n)) (n : ℕ)
    (i : Fin (LAdicSheaf.flatStalkRank F s)) :
    LAdicSheaf.stalkTransition B X ℓ F s n (LAdicSheaf.flatLevelBasis F s hF (n + 1) i) =
      LAdicSheaf.flatLevelBasis F s hF n i := by
  show (finiteLevelStalkTransition B X ℓ F s n).hom
    (LAdicSheaf.flatLevelBasis F s hF (n + 1) i) = _
  simp only [LAdicSheaf.flatLevelBasis]
  exact (congrArg (finiteLevelStalkTransition B X ℓ F s n).hom
    (basisOfLift_apply _ _ _ _ _ _ _ i)).trans (finiteLevelStalkTransition_surjective B X ℓ F s n
      (LAdicSheaf.flatLevelBasis F s hF n i)).choose_spec

/-- **Compatible trivialisations of flat finite-level stalks.** -/
def LAdicSheaf.flatLevelTrivialization
    (hF : ∀ n, IsPowExact ℓ (n + 1) (finiteLevelStalk B X ℓ F s n)) :
    LAdicSheaf.LevelTrivialization F s (LAdicSheaf.flatStalkRank F s) where
  equiv n := (LAdicSheaf.flatLevelBasis F s hF n).equivFun.toAddEquiv
  transition n y := by
    funext i
    change (LAdicSheaf.flatLevelBasis F s hF n).equivFun
      (LAdicSheaf.stalkTransition B X ℓ F s n y) i =
        levelRingHom (n + 1) ((LAdicSheaf.flatLevelBasis F s hF (n + 1)).equivFun y i)
    conv_lhs => rw [← (LAdicSheaf.flatLevelBasis F s hF (n + 1)).sum_repr y]
    have h : LAdicSheaf.stalkTransition B X ℓ F s n
        (∑ j, (LAdicSheaf.flatLevelBasis F s hF (n + 1)).repr y j •
          LAdicSheaf.flatLevelBasis F s hF (n + 1) j) =
        (LAdicSheaf.flatLevelBasis F s hF n).equivFun.symm
          (fun j => levelRingHom (n + 1)
            ((LAdicSheaf.flatLevelBasis F s hF (n + 1)).repr y j)) := by
      rw [Module.Basis.equivFun_symm_apply]
      change (finiteLevelStalkTransition B X ℓ F s n).hom _ = _
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_smul]
      exact congrArg _ (LAdicSheaf.stalkTransition_flatLevelBasis F s hF n j)
    rw [h, LinearEquiv.apply_symm_apply]
    rfl

/-- The finite-level stalks of an ℓ-adic sheaf with flat levels are flat. -/
theorem LAdicSheaf.isPowExact_finiteLevelStalk_of_powExact (n : ℕ)
    (hn : PowExact ℓ (n + 1) (finiteLevelStalk B X ℓ F s n)) :
    IsPowExact ℓ (n + 1) (finiteLevelStalk B X ℓ F s n) := by
  intro a ha x hx
  let S := Submodule.span (ZMod (ℓ ^ (n + 1))) {x}
  let g : ModuleCat.of (ZMod (ℓ ^ (n + 1))) S ⟶ finiteLevelStalk B X ℓ F s n :=
    ModuleCat.ofHom S.subtype
  have hg : g ≫ ((ℓ ^ a) • 𝟙 _) = 0 := by
    ext z
    obtain ⟨y, hy⟩ := z
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hy
    show ℓ ^ a • (c • x) = 0
    rw [smul_comm, hx, smul_zero]
  obtain ⟨T, π, hπ, y, hy⟩ := hn a ha g hg
  obtain ⟨t, ht⟩ := (ModuleCat.epi_iff_surjective π).1 hπ
    ⟨x, Submodule.mem_span_singleton_self x⟩
  refine ⟨y.hom t, ?_⟩
  have := congrArg (fun φ => φ.hom t) hy
  change (g.hom (π.hom t)) = ℓ ^ (n + 1 - a) • y.hom t at this
  rw [ht] at this
  exact this.symm

/-- **Traces on the rational stalk of an ℓ-adic sheaf with flat finite-level stalks**: the trace
of an endomorphism `a` of the geometric point on `ℚ_ℓ ⊗ F_x̄` is an ℓ-adic integer whose reductions
modulo `ℓⁿ⁺¹` are the traces of `a` on the finite-level stalks `F_{n, x̄}`. -/
theorem LAdicSheaf.exists_trace_rationalStalkEnd_of_flat
    (hF : ∀ n, IsPowExact ℓ (n + 1) (finiteLevelStalk B X ℓ F s n)) (a : GeometricPoint.Hom s s) :
    ∃ t : ℤ_[ℓ], LinearMap.trace ℚ_[ℓ] _ (LAdicSheaf.rationalStalkEnd B X ℓ F a) = (t : ℚ_[ℓ]) ∧
      ∀ n, PadicInt.toZModPow (n + 1) t =
        LinearMap.trace (ZMod (ℓ ^ (n + 1))) _ (finiteLevelStalkEnd B X ℓ F a n).hom := by
  classical
  let T := LAdicSheaf.flatLevelTrivialization F s hF
  let e := T.stalkEquiv
  have : Module.Free ℤ_[ℓ] (LAdicSheaf.stalk B X ℓ F s) := Module.Free.of_equiv e.symm
  have : Module.Finite ℤ_[ℓ] (LAdicSheaf.stalk B X ℓ F s) := Module.Finite.equiv e.symm
  let A := LinearMap.toMatrix' (e.conj (LAdicSheaf.stalkEnd B X ℓ F a))
  refine ⟨A.trace, ?_, fun n => ?_⟩
  · show LinearMap.trace ℚ_[ℓ] _ ((LAdicSheaf.stalkEnd B X ℓ F a).baseChange ℚ_[ℓ]) = _
    rw [LinearMap.trace_baseChange, ← LinearMap.trace_conj' _ e,
      ← Matrix.toLin'_toMatrix' (e.conj (LAdicSheaf.stalkEnd B X ℓ F a)), Matrix.trace_toLin'_eq]
    rfl
  · let b := LAdicSheaf.flatLevelBasis F s hF n
    have hconj : b.equivFun.conj (finiteLevelStalkEnd B X ℓ F a n).hom =
        Matrix.toLin' (A.map (PadicInt.toZModPow (n + 1))) := by
      refine LinearMap.ext fun w => ?_
      obtain ⟨w', hw'⟩ : ∃ w' : Fin _ → ℤ_[ℓ], (fun i => PadicInt.toZModPow (n + 1) (w' i)) = w :=
        ⟨fun i => (ZMod.ringHom_surjective (PadicInt.toZModPow (n + 1)) (w i)).choose,
          funext fun i => (ZMod.ringHom_surjective (PadicInt.toZModPow (n + 1)) (w i)).choose_spec⟩
      let v := e.symm w'
      have hv : b.equivFun (v.1 n) = w := by
        rw [← hw']
        funext i
        show T.equiv n (v.1 n) i = _
        rw [← LAdicSheaf.LevelTrivialization.toZModPow_stalkEquiv T v n i]
        simp only [v, e, LinearEquiv.apply_symm_apply]
      rw [LinearEquiv.conj_apply_apply, ← hv, LinearEquiv.symm_apply_apply, Matrix.toLin'_apply]
      funext i
      show T.equiv n ((LAdicSheaf.stalkEnd B X ℓ F a v).1 n) i = _
      rw [← LAdicSheaf.LevelTrivialization.toZModPow_stalkEquiv,
        show e (LAdicSheaf.stalkEnd B X ℓ F a v) = Matrix.toLin' A (e v) by
          rw [Matrix.toLin'_toMatrix', LinearEquiv.conj_apply_apply, LinearEquiv.symm_apply_apply],
        Matrix.toLin'_apply, RingHom.map_mulVec]
      congr 1
      funext j
      exact LAdicSheaf.LevelTrivialization.toZModPow_stalkEquiv T v n j
    rw [← LinearMap.trace_conj' _ b.equivFun, hconj, Matrix.trace_toLin'_eq]
    exact AddMonoidHom.map_trace (PadicInt.toZModPow (n + 1)) A

/-- **The finite-level stalks of an ℓ-adic sheaf with flat levels are flat**: the stalk functor is
exact. -/
theorem LAdicSheaf.isPowExact_finiteLevelStalk (n : ℕ) (hn : PowExact ℓ (n + 1) (F.level n)) :
    IsPowExact ℓ (n + 1) (finiteLevelStalk B X ℓ F s n) := by
  have : AB5OfSize.{u, u} (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1)))) :=
    AlgebraicGeometry.aB5OfSize_moduleCat_of_univLE.{u, u + 1, 0} (ZMod (ℓ ^ (n + 1)))
  have : Limits.HasLimitsOfSize.{u, u} (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1)))) :=
    ModuleCat.hasLimitsOfSize.{u, u, u + 1, 0}
  exact LAdicSheaf.isPowExact_finiteLevelStalk_of_powExact F s n <|
    hn.map (etaleModuleStalkFunctor.{u, u + 1, 0} B X (ZMod (ℓ ^ (n + 1))) s)
    (zmodSheaf_nsmul_id (SmallEtale.topology B X.1 X.property) (ℓ ^ (n + 1)) (F.level n))

end FlatStalk

/-! ### Isogeny invariance -/

/-- Multiplication by `k` on an ℓ-adic sheaf acts on the stalks by multiplication by `k`. -/
theorem LAdicSheaf.stalkMap_nsmul_id (F : LAdicSheaf B X ℓ) (s : GeometricPoint X.1) (k : ℕ) :
    LAdicSheaf.stalkMap (k • 𝟙 F) s = k • LinearMap.id := by
  induction k with
  | zero => rw [zero_nsmul, zero_nsmul, LAdicSheaf.stalkMap_zero]
  | succ k ih => rw [succ_nsmul, succ_nsmul, LAdicSheaf.stalkMap_add, ih, LAdicSheaf.stalkMap_id]

/-- Multiplication by `k` on an ℓ-adic sheaf acts on the rational stalks by multiplication by
`k`. -/
theorem LAdicSheaf.rationalStalkMap_nsmul_id (F : LAdicSheaf B X ℓ) (s : GeometricPoint X.1)
    (k : ℕ) :
    LAdicSheaf.rationalStalkMap (k • 𝟙 F) s = (k : ℚ_[ℓ]) • LinearMap.id := by
  refine LinearMap.ext fun x => ?_
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul c v =>
    show LinearMap.baseChange (Padic ℓ) (LAdicSheaf.stalkMap (k • 𝟙 F) s) (c ⊗ₜ v) = _
    rw [LAdicSheaf.stalkMap_nsmul_id, LinearMap.baseChange_tmul, LinearMap.smul_apply,
      LinearMap.id_apply, TensorProduct.tmul_smul, LinearMap.smul_apply, LinearMap.id_apply,
      Nat.cast_smul_eq_nsmul]
  | add x y hx hy => rw [map_add, map_add, hx, hy]

/-- **The trace of an endomorphism of a geometric point on the rational stalk is invariant under
isogeny.** -/
theorem LAdicSheaf.trace_rationalStalkEnd_of_isogeny {F G : LAdicSheaf B X ℓ} (φ : F ⟶ G)
    (ψ : G ⟶ F) (N : ℕ) (h₁ : φ ≫ ψ = (ℓ ^ N) • 𝟙 F) (h₂ : ψ ≫ φ = (ℓ ^ N) • 𝟙 G)
    {s : GeometricPoint X.1} (a : GeometricPoint.Hom s s) :
    LinearMap.trace ℚ_[ℓ] _ (LAdicSheaf.rationalStalkEnd B X ℓ F a) =
      LinearMap.trace ℚ_[ℓ] _ (LAdicSheaf.rationalStalkEnd B X ℓ G a) := by
  have hc : ((ℓ ^ N : ℕ) : ℚ_[ℓ]) ≠ 0 :=
    Nat.cast_ne_zero.2 (pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero)
  have hcomp : ∀ {F' G' : LAdicSheaf B X ℓ} (α : F' ⟶ G') (β : G' ⟶ F'),
      α ≫ β = (ℓ ^ N) • 𝟙 F' →
        LAdicSheaf.rationalStalkMap β s ∘ₗ LAdicSheaf.rationalStalkMap α s =
          ((ℓ ^ N : ℕ) : ℚ_[ℓ]) • LinearMap.id := by
    intro F' G' α β h
    rw [← LAdicSheaf.rationalStalkMap_nsmul_id, ← h]
    simp only [LAdicSheaf.rationalStalkMap, LAdicSheaf.stalkMap_comp, LinearMap.baseChange_comp]
  let e : LAdicSheaf.rationalStalkLeft B X ℓ F s ≃ₗ[ℚ_[ℓ]]
      LAdicSheaf.rationalStalkLeft B X ℓ G s :=
    LinearEquiv.ofLinear (LAdicSheaf.rationalStalkMap φ s)
      (((ℓ ^ N : ℕ) : ℚ_[ℓ])⁻¹ • LAdicSheaf.rationalStalkMap ψ s)
      (by rw [LinearMap.comp_smul, hcomp ψ φ h₂, smul_smul, inv_mul_cancel₀ hc, one_smul])
      (by rw [LinearMap.smul_comp, hcomp φ ψ h₁, smul_smul, inv_mul_cancel₀ hc, one_smul])
  have hconj : LAdicSheaf.rationalStalkEnd B X ℓ G a =
      e.conj (LAdicSheaf.rationalStalkEnd B X ℓ F a) := by
    rw [LinearEquiv.conj_apply]
    refine LinearMap.ext fun x => ?_
    obtain ⟨y, rfl⟩ := e.surjective x
    show LAdicSheaf.rationalStalkEnd B X ℓ G a (LAdicSheaf.rationalStalkMap φ s y) =
      e (LAdicSheaf.rationalStalkEnd B X ℓ F a (e.symm (e y)))
    rw [LinearEquiv.symm_apply_apply]
    exact LinearMap.congr_fun (LAdicSheaf.rationalStalkEnd_comp_rationalStalkMap φ a) y
  rw [hconj, LinearMap.trace_conj']

/-- **Item (4) of the proof of Tag 03V2.** The trace of an endomorphism `a` of a geometric point on
the rational stalk `ℚ_ℓ ⊗ F_x̄` is an ℓ-adic integer whose reduction modulo `ℓⁿ⁺¹` is the trace of
`a` on the level-`n` stalk of the torsion-free model `F'` of `F`. -/
theorem LAdicSheaf.exists_trace_rationalStalkEnd_torsionFreeModel (F : LAdicSheaf B X ℓ)
    {s : GeometricPoint X.1} (a : GeometricPoint.Hom s s) :
    ∃ t : ℤ_[ℓ], LinearMap.trace ℚ_[ℓ] _ (LAdicSheaf.rationalStalkEnd B X ℓ F a) = (t : ℚ_[ℓ]) ∧
      ∀ n, PadicInt.toZModPow (n + 1) t = LinearMap.trace (ZMod (ℓ ^ (n + 1))) _
        (finiteLevelStalkEnd B X ℓ (LAdicSheaf.torsionFreeModel F (LAdicSheaf.torsionBound F))
          a n).hom := by
  obtain ⟨t, ht, htn⟩ := LAdicSheaf.exists_trace_rationalStalkEnd_of_flat
    (LAdicSheaf.torsionFreeModel F (LAdicSheaf.torsionBound F)) s
    (fun n => LAdicSheaf.isPowExact_finiteLevelStalk _ s n
      (LAdicSheaf.powExact_torsionFreeModel_level F le_rfl n)) a
  refine ⟨t, ?_, htn⟩
  rw [LAdicSheaf.trace_rationalStalkEnd_of_isogeny
    (LAdicSheaf.toTorsionFreeModel F (LAdicSheaf.torsionBound F))
    (LAdicSheaf.fromTorsionFreeModel F (LAdicSheaf.torsionBound F)) (LAdicSheaf.torsionBound F)
    (LAdicSheaf.toTorsionFreeModel_comp_fromTorsionFreeModel F _)
    (LAdicSheaf.fromTorsionFreeModel_comp_toTorsionFreeModel F _) a, ht]

end Stacks.EtaleCohomology
