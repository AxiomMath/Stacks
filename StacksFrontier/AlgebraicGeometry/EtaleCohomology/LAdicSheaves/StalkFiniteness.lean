module

public import Mathlib.Algebra.Module.PID
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.LAdicSheaves.Stalk
public import StacksFrontier.RingTheory.AdicCompletion.Finiteness
public import StacksFrontier.RingTheory.AdicCompletion.InverseLimit

/-!
# Finiteness and structure of the stalk of an ℓ-adic sheaf

The stalk of an ℓ-adic sheaf at a geometric point is the inverse limit of its finite-level
stalks. Each finite-level stalk is finite, the transition maps are surjective, and the kernel
of each is the appropriate power of `ℓ` times the next one — so the finite-level stalks form
an `ℓ`-adic inverse system in the sense of `Stacks.AdicCompletion.InverseLimit.InverseSystem`.
Its limit is therefore `ℓ`-adically complete with finite quotients, hence a finite
`ℤ_[ℓ]`-module; and `ℤ_[ℓ]` is a discrete valuation ring, so the structure theorem for
finitely generated modules over a principal ideal domain decomposes the stalk into a free part
and finitely many cyclic modules of `ℓ`-power order.

## Main results

* `Stacks.EtaleCohomology.LAdicSheaf.finite_stalk` — the stalk is a finite `ℤ_[ℓ]`-module.
* `Stacks.EtaleCohomology.LAdicSheaf.stalk_equiv_free_prod_torsion` — the decomposition into a
  free part and cyclic `ℓ`-power torsion.

## Implementation notes

The inverse system is indexed so that level `0` is the zero module and level `n + 1` is the
`n`-th finite-level stalk, which is what makes the kernel condition `ker π n = Iⁿ • ⊤` hold on
the nose. Its limit is then identified with the stalk, which is by definition the submodule of
compatible families, so no further comparison is needed.

The decomposition is stated as the nonemptiness of a linear equivalence because it is not
canonical: the exponents are determined but the splitting is not. The cyclic summands are
written as quotients of `ℤ_[ℓ]` by the submodule generated by a positive power of `ℓ`; the
structure theorem produces them for an arbitrary uniformiser, and `ℓ` is one because `ℤ_[ℓ]`
is a discrete valuation ring in which `ℓ` is irreducible, so the two agree up to a unit and
the ideals they generate are equal.

## References

* [Stacks Project, Tag 03UQ](https://stacks.math.columbia.edu/tag/03UQ)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.SmallEtale

universe u

namespace Stacks.EtaleCohomology

variable (B : BigEtaleSite.{u}) (X : B.Scheme) (ℓ : ℕ)

variable [∀ (n : ℕ) (S T : B.Scheme) (f : T ⟶ S),
  ((smallEtaleBaseChange B f).sheafPushforwardContinuous
    (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1))))
    (SmallEtale.topology B S.1 S.property)
    (SmallEtale.topology B T.1 T.property)).IsRightAdjoint]
variable [∀ (n : ℕ) (T : B.Scheme) (V : SmallEtale B T.1 T.property),
  HasWeakSheafify ((SmallEtale.topology B T.1 T.property).over V)
    (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1))))]
variable [∀ n : ℕ, HasWeakSheafify
  (SmallEtale.topology B X.1 X.property)
  (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1))))]
variable [IsNoetherian X.1] [Fact ℓ.Prime]

private noncomputable def stalkSystem
    (F : LAdicSheaf B X ℓ) (x : GeometricPoint X.1) :
    Stacks.AdicCompletion.InverseLimit.InverseSystem
      (Ideal.span ({(ℓ : PadicInt ℓ)} : Set (PadicInt ℓ))) := by
  classical
  let M : ℕ → Type (u + 1) := fun n => match n with
    | 0 => (⊥ : Submodule (PadicInt ℓ)
        (finiteLevelStalk B X ℓ F x 0))
    | n + 1 => finiteLevelStalk B X ℓ F x n
  let instG : ∀ n, AddCommGroup (M n) := fun n => by
    cases n <;> dsimp [M] <;> infer_instance
  let instMod : ∀ n, Module (PadicInt ℓ) (M n) := fun n => by
    cases n with
    | zero => infer_instance
    | succ n => simpa [M] using
        LAdicSheaf.levelStalkModule B X ℓ F x n
  let π : ∀ n, M (n + 1) →ₗ[PadicInt ℓ] M n := fun n => by
      cases n with
      | zero => exact 0
      | succ n => exact
          LAdicSheaf.stalkTransition B X ℓ F x n
  letI := instG
  letI := instMod
  refine @Stacks.AdicCompletion.InverseLimit.InverseSystem.mk (PadicInt ℓ) inferInstance
    (Ideal.span ({(ℓ : PadicInt ℓ)} : Set (PadicInt ℓ))) M instG instMod π ?_ ?_
  · intro n
    cases n with
    | zero => intro y; exact ⟨0, Subsingleton.elim _ _⟩
    | succ n =>
      exact finiteLevelStalkTransition_surjective B X ℓ F x n
  · intro n
    cases n with
    | zero => simp [π, M]
    | succ n =>
      let Q := ZMod (ℓ ^ (n + 2))
      let V := finiteLevelStalk B X ℓ F x (n + 1)
      let J : Ideal Q := Ideal.span ({(ℓ ^ (n + 1) : Q)} : Set Q)
      obtain ⟨e, he⟩ :=
        finiteLevelStalkTransition_quotient B X ℓ F x n
      have hkerB :
          LinearMap.ker
              (finiteLevelStalkTransition B X ℓ F x n).hom =
            J • (⊤ : Submodule Q V) := by
        ext y
        rw [LinearMap.mem_ker, ← he y, LinearEquiv.map_eq_zero_iff, Submodule.Quotient.mk_eq_zero]
      let _ : Algebra (PadicInt ℓ) Q := (PadicInt.toZModPow (n + 2)).toAlgebra
      let _ : IsScalarTower (PadicInt ℓ) Q V := ⟨fun _ _ _ => mul_smul _ _ _⟩
      have hmap :
          Ideal.map (algebraMap (PadicInt ℓ) Q)
              ((Ideal.span ({(ℓ : PadicInt ℓ)} : Set (PadicInt ℓ))) ^ (n + 1)) = J := by
        simp [J, Ideal.map_span, Ideal.span_singleton_pow]
      have hkerA :
          LinearMap.ker (π (n + 1)) = (J • (⊤ : Submodule Q V)).restrictScalars (PadicInt ℓ) :=
        SetLike.ext fun y => Submodule.ext_iff.mp hkerB y
      rw [hkerA, ← hmap, Ideal.smul_restrictScalars]
      rfl

private noncomputable def stalkSystemLimitEquiv
    (F : LAdicSheaf B X ℓ) (x : GeometricPoint X.1) :
    LAdicSheaf.stalk B X ℓ F x ≃ₗ[PadicInt ℓ]
      (stalkSystem B X ℓ F x).limit := by
  classical
  let S := stalkSystem B X ℓ F x
  letI : Subsingleton (S.M 0) := by
    dsimp [S, stalkSystem]
    infer_instance
  let f : LAdicSheaf.stalk B X ℓ F x →ₗ[PadicInt ℓ]
      S.limit :=
    { toFun := fun a =>
        ⟨(fun n => match n with
            | 0 => 0
            | n + 1 => a.1 n), by
          intro n
          cases n with
          | zero => exact Subsingleton.elim _ _
          | succ n =>
            change LAdicSheaf.stalkTransition B X ℓ F x n
                (a.1 (n + 1)) = a.1 n
            exact a.2 n⟩
      map_add' := by
        intro a b; ext n
        cases n <;> first | exact Subsingleton.elim _ _ | rfl
      map_smul' := by
        intro c a; ext n
        cases n <;> first | exact Subsingleton.elim _ _ | rfl }
  refine LinearEquiv.ofBijective f ⟨fun a b hab => ?_, fun a => ⟨⟨fun n => a.1 (n + 1),
    fun n => a.2 (n + 1)⟩, ?_⟩⟩
  · ext n
    exact congrArg (fun z : S.limit => z.1 (n + 1)) hab
  · ext n
    cases n <;> first | exact Subsingleton.elim _ _ | rfl

/-- The stalk of an ℓ-adic sheaf is finite over the ℓ-adic integers. -/
@[stacks 03UQ "finite_limit_stalk"]
public instance LAdicSheaf.finite_stalk
    (F : LAdicSheaf B X ℓ) (x : GeometricPoint X.1) :
    Module.Finite (PadicInt ℓ)
      (LAdicSheaf.stalk B X ℓ F x) := by
  classical
  let I : Ideal (PadicInt ℓ) := Ideal.span ({(ℓ : PadicInt ℓ)} : Set (PadicInt ℓ))
  let S := stalkSystem B X ℓ F x
  have hI : I.FG := Submodule.fg_span (Set.finite_singleton _)
  have hfiniteLimit : Module.Finite (PadicInt ℓ) S.limit := by
    have : IsAdicComplete I (PadicInt ℓ) := by
      simpa [I, PadicInt.maximalIdeal_eq_span_p] using
        (inferInstance : IsAdicComplete (IsLocalRing.maximalIdeal (PadicInt ℓ))
          (PadicInt ℓ))
    apply Module.Finite.of_iInf_pow_smul_top_eq_bot_of_finite_quotient_smul_top I
    · exact (S.isAdicComplete hI).toIsHausdorff.iInf_pow_smul
    · let e := S.quotientEquiv hI 1
      have : Finite (S.M 1) := finite_finiteLevelStalk B X ℓ F x 0
      have : Finite (S.limit ⧸ I • (⊤ : Submodule (PadicInt ℓ) S.limit)) := by
        simpa [pow_one] using
          (Finite.of_equiv (S.M 1) e.symm.toEquiv :
            Finite (S.limit ⧸ I ^ 1 • (⊤ : Submodule (PadicInt ℓ) S.limit)))
      exact Module.Finite.of_finite
  exact Module.Finite.equiv (stalkSystemLimitEquiv B X ℓ F x).symm

/-- A stalk of an ℓ-adic sheaf is a sum of free and prime-power cyclic modules. -/
@[stacks 03UQ "stalk_structure"]
public theorem LAdicSheaf.stalk_equiv_free_prod_torsion
    (F : LAdicSheaf B X ℓ) (x : GeometricPoint X.1) :
    ∃ (r t : ℕ) (e : Fin t → ℕ),
      (∀ i, 1 ≤ e i) ∧
      Nonempty (LAdicSheaf.stalk B X ℓ F x ≃ₗ[PadicInt ℓ]
        (Fin r →₀ PadicInt ℓ) ×
          DirectSum (Fin t)
            (fun i => PadicInt ℓ ⧸ (PadicInt ℓ) ∙ ((ℓ : PadicInt ℓ) ^ e i))) := by
  classical
  let M := LAdicSheaf.stalk B X ℓ F x
  let R := PadicInt ℓ
  obtain ⟨r, ι, hι, p, hp, e, ⟨hM⟩⟩ :=
    Module.equiv_free_prod_directSum (R := R) (M := M)
  let _ : Fintype ι := hι
  have hℓ : Irreducible (ℓ : R) := PadicInt.irreducible_p
  have hquot : ∀ i,
      (R ⧸ R ∙ p i ^ e i) ≃ₗ[R] (R ⧸ R ∙ (ℓ : R) ^ e i) := by
    intro i
    have hspan : Ideal.span ({p i} : Set R) = Ideal.span ({(ℓ : R)} : Set R) :=
      ((IsDiscreteValuationRing.irreducible_iff_uniformizer (p i)).mp (hp i)).symm.trans
        ((IsDiscreteValuationRing.irreducible_iff_uniformizer (ℓ : R)).mp hℓ)
    exact Submodule.quotEquivOfEq _ _ (by
      simpa only [Ideal.span_singleton_pow] using
        congrArg (fun I : Ideal R => I ^ e i) hspan)
  let cyc : ι → Type := fun i => R ⧸ R ∙ (ℓ : R) ^ e i
  let good : Type := {i : ι // 0 < e i}
  let _ : Fintype good := Fintype.ofFinite good
  let piRestrict : ((i : ι) → cyc i) ≃ₗ[R] ((i : good) → cyc i.1) :=
    { toFun := fun f i => f i.1
      invFun := fun f i => if hi : 0 < e i then f ⟨i, hi⟩ else 0
      left_inv := by
        intro f
        funext i
        by_cases hi : 0 < e i
        · simp [hi]
        · have : Subsingleton (cyc i) :=
            Submodule.Quotient.subsingleton_iff.2 (by simp [Nat.eq_zero_of_not_pos hi])
          exact Subsingleton.elim _ _
      right_inv := fun f => funext fun i => dif_pos i.2
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  let eFin : Fin (Fintype.card good) ≃ good := (Fintype.equivFin good).symm
  let hDS : DirectSum ι (fun i => R ⧸ R ∙ p i ^ e i) ≃ₗ[R]
      DirectSum (Fin (Fintype.card good))
        (fun i => R ⧸ R ∙ (ℓ : R) ^ e (eFin i).1) :=
    (DirectSum.linearEquivFunOnFintype R ι (fun i => R ⧸ R ∙ p i ^ e i)).trans
      ((LinearEquiv.piCongrRight (R := R) hquot).trans (piRestrict.trans
        ((DirectSum.linearEquivFunOnFintype R good (fun i => cyc i.1)).symm.trans
          (DirectSum.lequivCongrLeft R eFin.symm))))
  exact ⟨r, Fintype.card good, (fun i => e (eFin i).1), (fun i => (eFin i).2),
    ⟨hM.trans (LinearEquiv.prodCongr (LinearEquiv.refl _ _) hDS)⟩⟩

end Stacks.EtaleCohomology

end
