/-!
# The connecting map on the Brauer group

Let `K` be a field with separable algebraic closure `Kˢᵉᵖ`. A central simple `K`-algebra `A` of
degree `d` has a projective Galois cohomology class, and the connecting map of the scalar central
extension sends it to a class in `H²(Gal(Kˢᵉᵖ/K), (Kˢᵉᵖ)ˣ)`. This file shows that the resulting
class depends on `A` only through its Brauer class, so that it defines a map

`δ : Br(K) → H²(Gal(Kˢᵉᵖ/K), (Kˢᵉᵖ)ˣ)`,

and that `δ` is a group homomorphism from the Brauer group, whose law is tensor product, to the
second continuous cohomology group, whose law is multiplication of cocycles.

## Main definitions

* `Stacks.GaloisCohomology.brauerDelta`: the map `δ` on the Brauer group.
* `Stacks.GaloisCohomology.brauerDeltaHom`: `δ` as a group homomorphism.

## Main results

* `Stacks.GaloisCohomology.brauerDeltaOfCSA_eq_of_isBrauerEquivalent`: Brauer-equivalent central
  simple algebras have the same class, which is what makes `δ` well defined.
* `Stacks.GaloisCohomology.brauerDelta_mk`: `δ` is computed by the cocycle formula on any
  representative.
* `Stacks.GaloisCohomology.brauerDelta_mul`: `δ` takes tensor product to multiplication.

## Implementation notes

The class of `A` is computed from an arbitrary splitting of `Kˢᵉᵖ ⊗ A` rather than from the
chosen one, because the projective cocycles of two splittings are cohomologous; this is
`brauerDeltaOfCSA_eq_split`. Both facts needed about `δ` then reduce to exhibiting a splitting of
a product and a lift of the resulting projective cocycle:

* for `A ⊗ B` the splitting is the Kronecker product of splittings of the factors, and the
  Kronecker product of lifts is a lift, whose scalar defect is the product of the scalar defects;
* for `Matrix n n K` the canonical splitting admits the constant lift `1`, whose defect is
  trivial, so a matrix algebra over the ground field has trivial class.

Brauer equivalence is generated by passing to a matrix algebra and by isomorphism, and
`Matrix n n A ≅ A ⊗ Matrix n n K`, so the two items above also give invariance under Brauer
equivalence. No `H²` class is ever obtained from an existence statement: every one of them is the
class of an explicitly written cocycle.

Multiplicativity is enough to make `δ` a group homomorphism, by `MonoidHom.mk'`; the Brauer group
is a group, so `δ 1 = 1` follows rather than having to be computed.

The private declarations of this file reach into those of
`StacksFrontier.AlgebraicGeometry.EtaleCohomology.BrauerGroups.NonabelianGaloisCohomology`
through `import all`, since the construction of the classifying bijection of
[Stacks, Tag 03R6](https://stacks.math.columbia.edu/tag/03R6) is not part of its public
interface. A private import places those names in the private scope, so none of them appears in
the statement of a public declaration here.

## References

* [Stacks Project, Tag 03R7](https://stacks.math.columbia.edu/tag/03R7)
-/

@[expose] public noncomputable section

open scoped MatrixGroups TensorProduct Kronecker

namespace Stacks.GaloisCohomology

section Bridge

variable {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω] [Algebra.IsAlgebraic K Ω] {d : ℕ}

/-- The connecting map is the class of any locally constant two-cocycle whose scalar matrix is
the defect of a locally constant lift of the given projective cocycle. -/
private theorem pglConnectingMap_eq_of_scalar_defect (hd : 0 < d) (g : PGLCocycle K Ω d)
    (lift : Gal(Ω/K) → GL (Fin d) Ω)
    (hlift : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = g.toFun σ)
    (hlc : IsLocallyConstant lift) (c : twoCocycles K Ω)
    (hc : ∀ σ τ : Gal(Ω/K), Matrix.GeneralLinearGroup.scalar (Fin d)
      ((c : Gal(Ω/K) × Gal(Ω/K) → Ωˣ) (σ, τ)) = liftDefect lift σ τ) :
    pglConnectingMap hd (Quotient.mk _ g) = twoCohomologyClass c := by
  rw [pglConnectingMap_mk hd g lift hlift hlc]
  congr 1
  refine Subtype.ext (funext fun p => ?_)
  refine scalar_injective (⟨0, hd⟩ : Fin d) ?_
  rw [coe_liftTwoCocycle, twoCocycleOfPGLCocycle_eq, scalar_twoCocycleOfLift_eq_liftDefect]
  exact (hc p.1 p.2).symm

/-- The scalar matrix of the two-cocycle of a lift is the defect of that lift, written out. -/
private theorem scalar_liftTwoCocycle (hd : 0 < d) (g : PGLCocycle K Ω d)
    (lift : Gal(Ω/K) → GL (Fin d) Ω)
    (hlift : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = g.toFun σ)
    (hlc : IsLocallyConstant lift) (σ τ : Gal(Ω/K)) :
    Matrix.GeneralLinearGroup.scalar (Fin d)
        ((liftTwoCocycle hd g lift hlift hlc : Gal(Ω/K) × Gal(Ω/K) → Ωˣ) (σ, τ)) =
      (lift σ)⁻¹ * lift (σ * τ) *
        Matrix.GeneralLinearGroup.map (MulSemiringAction.toRingHom Gal(Ω/K) Ω σ) (lift τ)⁻¹ := by
  rw [coe_liftTwoCocycle, twoCocycleOfPGLCocycle_eq, scalar_twoCocycleOfLift]

end Bridge

section Kronecker

variable {L : Type*} {n m : Type*} [Fintype n] [Fintype m] [DecidableEq n] [DecidableEq m]

/-- The Kronecker product of invertible matrices is multiplicative. -/
private theorem glKronecker_mul [CommSemiring L] (a c : GL n L) (b d : GL m L) :
    Matrix.GeneralLinearGroup.kronecker (a * c) (b * d) =
      Matrix.GeneralLinearGroup.kronecker a b * Matrix.GeneralLinearGroup.kronecker c d :=
  Units.ext (Matrix.mul_kronecker_mul _ _ _ _)

/-- The Kronecker product of inverses is the inverse of the Kronecker product. -/
private theorem glKronecker_inv [CommSemiring L] (a : GL n L) (b : GL m L) :
    Matrix.GeneralLinearGroup.kronecker a⁻¹ b⁻¹ =
      (Matrix.GeneralLinearGroup.kronecker a b)⁻¹ :=
  Units.ext rfl

/-- The Kronecker product commutes with entrywise application of a ring homomorphism. -/
private theorem glKronecker_map {M : Type*} [CommRing L] [CommRing M] (f : L →+* M)
    (a : GL n L) (b : GL m L) :
    Matrix.GeneralLinearGroup.kronecker (Matrix.GeneralLinearGroup.map f a)
        (Matrix.GeneralLinearGroup.map f b) =
      Matrix.GeneralLinearGroup.map f (Matrix.GeneralLinearGroup.kronecker a b) := by
  refine Units.ext ?_
  ext i j
  change f _ * f _ = f (_ * _)
  exact (map_mul f _ _).symm

/-- The Kronecker product of two scalar matrices is the scalar matrix of the product. -/
private theorem glKronecker_scalar [CommSemiring L] (a b : Lˣ) :
    Matrix.GeneralLinearGroup.kronecker
        (Matrix.GeneralLinearGroup.scalar n a) (Matrix.GeneralLinearGroup.scalar m b) =
      Matrix.GeneralLinearGroup.scalar (n × m) (a * b) := by
  refine Units.ext ?_
  change (Matrix.scalar n (a : L)) ⊗ₖ (Matrix.scalar m (b : L)) =
    Matrix.scalar (n × m) ((a : L) * (b : L))
  ext ⟨i, j⟩ ⟨k, l⟩
  by_cases hik : i = k <;> by_cases hjl : j = l <;>
    simp [Matrix.kroneckerMap_apply, Matrix.scalar_apply, Matrix.diagonal, hik, hjl]

/-- The product of two scalar defects is the scalar defect of the Kronecker products. -/
private theorem glKronecker_scalar_defect [Field L] (σ : L →+* L) (a₁ a₂ a₃ : GL n L)
    (b₁ b₂ b₃ : GL m L) (c d : Lˣ)
    (hc : Matrix.GeneralLinearGroup.scalar n c =
      a₁⁻¹ * a₂ * Matrix.GeneralLinearGroup.map σ a₃⁻¹)
    (hd : Matrix.GeneralLinearGroup.scalar m d =
      b₁⁻¹ * b₂ * Matrix.GeneralLinearGroup.map σ b₃⁻¹) :
    Matrix.GeneralLinearGroup.scalar (n × m) (c * d) =
      (Matrix.GeneralLinearGroup.kronecker a₁ b₁)⁻¹ *
        Matrix.GeneralLinearGroup.kronecker a₂ b₂ *
        Matrix.GeneralLinearGroup.map σ (Matrix.GeneralLinearGroup.kronecker a₃ b₃)⁻¹ := by
  rw [← glKronecker_scalar, hc, hd, glKronecker_mul, glKronecker_mul,
    glKronecker_inv, glKronecker_map, glKronecker_inv]

/-- Reindexing invertible matrices along an equivalence of index types. -/
private abbrev glReindex (L : Type*) [CommRing L] (e : n ≃ m) : GL n L →* GL m L :=
  Units.map (Matrix.reindexAlgEquiv L L e).toMonoidHom

private theorem glReindex_scalar (L : Type*) [CommRing L] (e : n ≃ m) (a : Lˣ) :
    glReindex L e (Matrix.GeneralLinearGroup.scalar n a) =
      Matrix.GeneralLinearGroup.scalar m a :=
  Units.ext ((Matrix.reindexAlgEquiv L L e).commutes (a : L))

private theorem glReindex_map (L : Type*) [CommRing L] (e : n ≃ m) (σ : L →+* L) (a : GL n L) :
    glReindex L e (Matrix.GeneralLinearGroup.map σ a) =
      Matrix.GeneralLinearGroup.map σ (glReindex L e a) :=
  Units.ext rfl

end Kronecker

universe u v

section General

variable (K : Type u) [Field K] (Ksep : Type v) [Field Ksep] [Algebra K Ksep]
  [IsSepClosure K Ksep]

section Split

omit [IsSepClosure K Ksep] in
/-- A representative `U` of the value at `σ` of the projective cocycle of a splitting `e` is
characterised by conjugation by `U` intertwining the Galois action across `e`. -/
private theorem splitCocycle_mk_iff (A : Type*) [Ring A] [Algebra K A]
    (d : ℕ) (hd : d ≠ 0) (e : Ksep ⊗[K] A ≃ₐ[Ksep] Matrix (Fin d) (Fin d) Ksep)
    (σ : Gal(Ksep/K)) (U : GL (Fin d) Ksep) :
    Matrix.ProjGenLinGroup.mk U = (splitPGLCocycle K Ksep d hd A e).toFun σ ↔
      ∀ z : Ksep ⊗[K] A, e (tensorGaloisAut K Ksep A σ z) =
        (U : Matrix (Fin d) (Fin d) Ksep) * (e z).map σ *
          (↑(U⁻¹) : Matrix (Fin d) (Fin d) Ksep) := by
  rw [← (pglToMatrixAlgAutEquiv Ksep d hd).injective.eq_iff]
  change pglToMatrixAlgAutEquiv Ksep d hd (Matrix.ProjGenLinGroup.mk U) =
    pglToMatrixAlgAutEquiv Ksep d hd ((pglToMatrixAlgAutEquiv Ksep d hd).symm
      (splitTransportAlgAut K Ksep A d e σ)) ↔ _
  rw [MulEquiv.apply_symm_apply, pglToMatrixAlgAutEquiv_apply]
  refine ⟨fun h z => ?_, fun h => AlgEquiv.ext fun M => ?_⟩
  · simpa [pglToMatrixAlgAut_mk_apply, splitTransportAlgAut, splitTransportAut,
      matrixGaloisAut, AlgEquiv.ofRingEquiv_apply, RingEquiv.mapMatrix_apply,
      Function.comp_def, Matrix.GeneralLinearGroup.coe_inv] using
      (congrArg (fun f : Matrix (Fin d) (Fin d) Ksep ≃ₐ[Ksep] _ => f ((e z).map σ)) h).symm
  · simpa [pglToMatrixAlgAut_mk_apply, splitTransportAlgAut, splitTransportAut,
      matrixGaloisAut, AlgEquiv.ofRingEquiv_apply, RingEquiv.mapMatrix_apply,
      Function.comp_def, Matrix.GeneralLinearGroup.coe_inv] using
      (h (e.symm (M.map σ.symm))).symm

/-- The classifying bijection of tag 03R6 sends the class of `A` to the class of the projective
cocycle of any splitting of `A`. -/
private theorem classification_eq_split (d : ℕ) (hd : d ≠ 0)
    (A : CentralSimpleAlgebraOfDegree.{u, v} K d)
    (e : Ksep ⊗[K] A.1 ≃ₐ[Ksep] Matrix (Fin d) (Fin d) Ksep) :
    centralSimpleAlgebraClassEquivPGLH1 K Ksep d hd (Quotient.mk _ A) =
      Quotient.mk _ (splitPGLCocycle K Ksep d hd A.1 e) :=
  Quotient.sound (.rel _ _ (centralSimpleAlgebraOfDegree_cocycle_changeSplit K Ksep d hd A e))

/-- The class of a central simple algebra is computed by the projective cocycle of any splitting
of it, not only by the chosen one. -/
@[sga "4½ Arcata 3.1.2" "partial"]
private theorem brauerDeltaOfCSA_eq_split (A : CSA.{u, v} K) (d : ℕ) (hd : 0 < d)
    (e : Ksep ⊗[K] A ≃ₐ[Ksep] Matrix (Fin d) (Fin d) Ksep) :
    brauerDeltaOfCSA K Ksep A =
      pglConnectingMap hd (Quotient.mk _ (splitPGLCocycle K Ksep d hd.ne' A e)) := by
  have hdegree : d = Algebra.IsCentralSimple.degree K A :=
    Algebra.IsSplit.matrix_size_eq_degree Ksep e
  subst hdegree
  exact congrArg (pglConnectingMap hd) (classification_eq_split K Ksep _ hd.ne' ⟨A, rfl⟩ e)

end Split

section Tensor

omit [IsSepClosure K Ksep] in
/-- Base change of a tensor product: `(Kˢᵉᵖ ⊗ A) ⊗_{Kˢᵉᵖ} (Kˢᵉᵖ ⊗ B) ≅ Kˢᵉᵖ ⊗ (A ⊗ B)`. -/
private def tensorBaseChange (A B : Type*) [Ring A] [Ring B] [Algebra K A] [Algebra K B] :
    (Ksep ⊗[K] A) ⊗[Ksep] (Ksep ⊗[K] B) ≃ₐ[Ksep] Ksep ⊗[K] (A ⊗[K] B) :=
  (Algebra.TensorProduct.tensorTensorTensorComm K K Ksep Ksep Ksep A Ksep B).trans
    (Algebra.TensorProduct.congr (Algebra.TensorProduct.lid Ksep Ksep) (AlgEquiv.refl :
      (A ⊗[K] B) ≃ₐ[K] (A ⊗[K] B)))

omit [IsSepClosure K Ksep] in
private theorem tensorBaseChange_tmul (A B : Type*) [Ring A] [Ring B]
    [Algebra K A] [Algebra K B] (x y : Ksep) (a : A) (b : B) :
    tensorBaseChange K Ksep A B ((x ⊗ₜ[K] a) ⊗ₜ[Ksep] (y ⊗ₜ[K] b)) =
      (x * y) ⊗ₜ[K] (a ⊗ₜ[K] b) := by
  simp [tensorBaseChange]

omit [IsSepClosure K Ksep] in
private theorem tensorBaseChange_symm_tmul (A B : Type*) [Ring A] [Ring B]
    [Algebra K A] [Algebra K B] (x : Ksep) (a : A) (b : B) :
    (tensorBaseChange K Ksep A B).symm (x ⊗ₜ[K] (a ⊗ₜ[K] b)) =
      (x ⊗ₜ[K] a) ⊗ₜ[Ksep] (1 ⊗ₜ[K] b) := by
  apply (tensorBaseChange K Ksep A B).injective
  simp [tensorBaseChange_tmul]

omit [IsSepClosure K Ksep] in
/-- The splitting of a tensor product induced by splittings of the two factors: the Kronecker
product of the two matrix presentations. -/
private def tensorSplitEquiv (A B : Type*) [Ring A] [Ring B]
    [Algebra K A] [Algebra K B] (d n : ℕ)
    (eA : Ksep ⊗[K] A ≃ₐ[Ksep] Matrix (Fin d) (Fin d) Ksep)
    (eB : Ksep ⊗[K] B ≃ₐ[Ksep] Matrix (Fin n) (Fin n) Ksep) :
    Ksep ⊗[K] (A ⊗[K] B) ≃ₐ[Ksep] Matrix (Fin (d * n)) (Fin (d * n)) Ksep :=
  (tensorBaseChange K Ksep A B).symm.trans
    ((Algebra.TensorProduct.congr eA eB).trans
      ((Matrix.kroneckerAlgEquiv (Fin d) (Fin n) Ksep).trans
        (Matrix.reindexAlgEquiv Ksep Ksep finProdFinEquiv)))

omit [IsSepClosure K Ksep] in
private theorem tensorSplitEquiv_tmul (A B : Type*) [Ring A] [Ring B]
    [Algebra K A] [Algebra K B] (d n : ℕ)
    (eA : Ksep ⊗[K] A ≃ₐ[Ksep] Matrix (Fin d) (Fin d) Ksep)
    (eB : Ksep ⊗[K] B ≃ₐ[Ksep] Matrix (Fin n) (Fin n) Ksep)
    (x : Ksep) (a : A) (b : B) :
    tensorSplitEquiv K Ksep A B d n eA eB (x ⊗ₜ[K] (a ⊗ₜ[K] b)) =
      Matrix.reindexAlgEquiv Ksep Ksep finProdFinEquiv
        (Matrix.kronecker (eA (x ⊗ₜ[K] a)) (eB (1 ⊗ₜ[K] b))) := by
  simp [tensorSplitEquiv, tensorBaseChange_symm_tmul]

omit [IsSepClosure K Ksep] in
/-- The projective cocycle of a tensor splitting is the Kronecker product of the projective
cocycles of the factors. -/
private theorem tensorSplitCocycle_mk (A B : Type*) [Ring A] [Ring B]
    [Algebra K A] [Algebra K B] (d n : ℕ) (hd : d ≠ 0) (hn : n ≠ 0)
    (eA : Ksep ⊗[K] A ≃ₐ[Ksep] Matrix (Fin d) (Fin d) Ksep)
    (eB : Ksep ⊗[K] B ≃ₐ[Ksep] Matrix (Fin n) (Fin n) Ksep)
    (σ : Gal(Ksep/K)) (U : GL (Fin d) Ksep) (V : GL (Fin n) Ksep)
    (hU : Matrix.ProjGenLinGroup.mk U = (splitPGLCocycle K Ksep d hd A eA).toFun σ)
    (hV : Matrix.ProjGenLinGroup.mk V = (splitPGLCocycle K Ksep n hn B eB).toFun σ) :
    Matrix.ProjGenLinGroup.mk (glReindex Ksep finProdFinEquiv
        (Matrix.GeneralLinearGroup.kronecker U V)) =
      (splitPGLCocycle K Ksep (d * n) (mul_ne_zero hd hn) (A ⊗[K] B)
        (tensorSplitEquiv K Ksep A B d n eA eB)).toFun σ := by
  apply (splitCocycle_mk_iff K Ksep _ _ _ _ _ _).2
  have hA := (splitCocycle_mk_iff K Ksep A d hd eA σ U).1 hU
  have hB := (splitCocycle_mk_iff K Ksep B n hn eB σ V).1 hV
  intro z
  induction z using TensorProduct.induction_on with
  | zero => simp
  | add z w hz hw =>
      simp only [map_add, Matrix.map_add σ (map_add σ), Matrix.mul_add, Matrix.add_mul, hz, hw]
  | tmul x z =>
      induction z using TensorProduct.induction_on with
      | zero => simp
      | add a b ha hb =>
          simp only [TensorProduct.tmul_add, map_add, Matrix.map_add σ (map_add σ),
            Matrix.mul_add, Matrix.add_mul, ha, hb]
      | tmul a b =>
          rw [tensorGaloisAut_tmul, tensorSplitEquiv_tmul, tensorSplitEquiv_tmul]
          have hA' := hA (x ⊗ₜ[K] a)
          have hB' := hB (1 ⊗ₜ[K] b)
          simp only [tensorGaloisAut_tmul, map_one] at hA' hB'
          conv_lhs => rw [hA', hB']
          simp only [Matrix.kronecker, Matrix.mul_kronecker_mul, map_mul]
          congr 2
          ext i j
          exact (map_mul σ _ _).symm

/-- The connecting class of a tensor splitting is the product of the connecting classes: the
Kronecker product of lifts is a lift, and its scalar defect is the product of the defects. -/
private theorem pglConnectingMap_tensorSplit (A B : Type*) [Ring A] [Ring B]
    [Algebra K A] [Algebra K B] (d n : ℕ) (hd : 0 < d) (hn : 0 < n)
    (eA : Ksep ⊗[K] A ≃ₐ[Ksep] Matrix (Fin d) (Fin d) Ksep)
    (eB : Ksep ⊗[K] B ≃ₐ[Ksep] Matrix (Fin n) (Fin n) Ksep) :
    pglConnectingMap (Nat.mul_pos hd hn)
        (Quotient.mk _ (splitPGLCocycle K Ksep (d * n) (mul_ne_zero hd.ne' hn.ne')
          (A ⊗[K] B) (tensorSplitEquiv K Ksep A B d n eA eB))) =
      pglConnectingMap hd (Quotient.mk _ (splitPGLCocycle K Ksep d hd.ne' A eA)) *
        pglConnectingMap hn (Quotient.mk _ (splitPGLCocycle K Ksep n hn.ne' B eB)) := by
  set gA := splitPGLCocycle K Ksep d hd.ne' A eA
  set gB := splitPGLCocycle K Ksep n hn.ne' B eB
  set liftA := pglCocycleLift gA
  set liftB := pglCocycleLift gB
  have hliftA : ∀ σ, Matrix.ProjGenLinGroup.mk (liftA σ) = gA.toFun σ := mk_pglCocycleLift gA
  have hliftB : ∀ σ, Matrix.ProjGenLinGroup.mk (liftB σ) = gB.toFun σ := mk_pglCocycleLift gB
  have hlcA : IsLocallyConstant liftA := isLocallyConstant_pglCocycleLift gA
  have hlcB : IsLocallyConstant liftB := isLocallyConstant_pglCocycleLift gB
  refine Eq.trans (pglConnectingMap_eq_of_scalar_defect (Nat.mul_pos hd hn) _
    (fun σ => glReindex Ksep finProdFinEquiv
      (Matrix.GeneralLinearGroup.kronecker (liftA σ) (liftB σ)))
    (fun σ => tensorSplitCocycle_mk K Ksep A B d n hd.ne' hn.ne' eA eB σ (liftA σ) (liftB σ)
      (hliftA σ) (hliftB σ))
    (hlcA.comp₂ hlcB fun U V => glReindex Ksep finProdFinEquiv
      (Matrix.GeneralLinearGroup.kronecker U V))
    (liftTwoCocycle hd gA liftA hliftA hlcA * liftTwoCocycle hn gB liftB hliftB hlcB)
    ?_) ?_
  · intro σ τ
    have h := glKronecker_scalar_defect
      (MulSemiringAction.toRingHom Gal(Ksep/K) Ksep σ)
      (liftA σ) (liftA (σ * τ)) (liftA τ) (liftB σ) (liftB (σ * τ)) (liftB τ)
      ((liftTwoCocycle hd gA liftA hliftA hlcA :
        Gal(Ksep/K) × Gal(Ksep/K) → Ksepˣ) (σ, τ))
      ((liftTwoCocycle hn gB liftB hliftB hlcB :
        Gal(Ksep/K) × Gal(Ksep/K) → Ksepˣ) (σ, τ))
      (scalar_liftTwoCocycle hd gA liftA hliftA hlcA σ τ)
      (scalar_liftTwoCocycle hn gB liftB hliftB hlcB σ τ)
    simpa only [glReindex_scalar, map_mul, map_inv, glReindex_map, liftDefect,
      Subgroup.coe_mul, Pi.mul_apply] using
      congrArg (glReindex Ksep (finProdFinEquiv (m := d) (n := n))) h
  · rw [twoCohomologyClass_mul, ← pglConnectingMap_mk hd gA liftA hliftA hlcA,
      ← pglConnectingMap_mk hn gB liftB hliftB hlcB]

end Tensor

section Descent

omit [IsSepClosure K Ksep] in
/-- The canonical splitting of a matrix algebra over the ground field. -/
private def matrixSplitEquiv (n : ℕ) :
    Ksep ⊗[K] Matrix (Fin n) (Fin n) K ≃ₐ[Ksep] Matrix (Fin n) (Fin n) Ksep :=
  AlgEquiv.ofRingEquiv (f := (matrixEquivTensor (Fin n) K Ksep).symm.toRingEquiv) (by
    intro x
    change (matrixEquivTensor (Fin n) K Ksep).symm
      (x ⊗ₜ[K] (1 : Matrix (Fin n) (Fin n) K)) = _
    rw [matrixEquivTensor_apply_symm]
    simp [Algebra.algebraMap_eq_smul_one])

omit [IsSepClosure K Ksep] in
private theorem matrixSplitEquiv_tmul (n : ℕ) (x : Ksep) (M : Matrix (Fin n) (Fin n) K) :
    matrixSplitEquiv K Ksep n (x ⊗ₜ[K] M) = x • M.map (algebraMap K Ksep) := rfl

/-- A matrix algebra over the ground field has trivial connecting class: its canonical splitting
is Galois equivariant, so the constant family `1` is a lift, with trivial defect. -/
private theorem pglConnectingMap_matrixSplit (n : ℕ) (hn : 0 < n) :
    pglConnectingMap hn
      (Quotient.mk _ (splitPGLCocycle K Ksep n hn.ne' (Matrix (Fin n) (Fin n) K)
        (matrixSplitEquiv K Ksep n))) = 1 := by
  have hlift : ∀ σ : Gal(Ksep/K),
      Matrix.ProjGenLinGroup.mk ((fun _ => 1 : Gal(Ksep/K) → GL (Fin n) Ksep) σ) =
      (splitPGLCocycle K Ksep n hn.ne' (Matrix (Fin n) (Fin n) K)
        (matrixSplitEquiv K Ksep n)).toFun σ := by
    intro σ
    apply (splitCocycle_mk_iff K Ksep _ _ _ _ _ _).2
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | add z w hz hw =>
        simp only [map_add, Matrix.map_add σ (map_add σ), Matrix.mul_add,
          Matrix.add_mul, hz, hw]
    | tmul x M =>
        rw [tensorGaloisAut_tmul, matrixSplitEquiv_tmul, matrixSplitEquiv_tmul]
        ext i j
        simp [Matrix.smul_apply, Matrix.map_apply, map_mul, σ.commutes]
  rw [pglConnectingMap_eq_of_scalar_defect hn _ (fun _ => 1) hlift
    (IsLocallyConstant.const 1) 1 fun σ τ => by simp [liftDefect]]
  exact twoCohomologyClass_one

/-- The class of a tensor product of central simple algebras is the product of the classes. -/
@[sga "4½ Arcata 3.1.2" "partial"]
private theorem brauerDeltaOfCSA_tensor (A B : CSA.{u, v} K) :
    brauerDeltaOfCSA K Ksep (⟨.of K (A ⊗[K] B)⟩ : CSA.{u, v} K) =
      brauerDeltaOfCSA K Ksep A * brauerDeltaOfCSA K Ksep B := by
  have hd := Algebra.IsCentralSimple.degree_pos K A
  have he := Algebra.IsCentralSimple.degree_pos K B
  obtain ⟨eA⟩ := centralSimpleAlgebraOfDegree_splitEquiv K Ksep
    (Algebra.IsCentralSimple.degree K A) ⟨A, rfl⟩
  obtain ⟨eB⟩ := centralSimpleAlgebraOfDegree_splitEquiv K Ksep
    (Algebra.IsCentralSimple.degree K B) ⟨B, rfl⟩
  rw [brauerDeltaOfCSA_eq_split K Ksep A _ hd eA,
    brauerDeltaOfCSA_eq_split K Ksep B _ he eB,
    brauerDeltaOfCSA_eq_split K Ksep _ _ (Nat.mul_pos hd he)
      (tensorSplitEquiv K Ksep A B _ _ eA eB)]
  exact pglConnectingMap_tensorSplit K Ksep A B _ _ hd he eA eB

/-- Passing to a matrix algebra does not change the class. -/
@[sga "4½ Arcata 3.1.2" "partial"]
private theorem brauerDeltaOfCSA_matrix (A : CSA.{u, v} K) (n : ℕ) [NeZero n] :
    brauerDeltaOfCSA K Ksep (⟨.of K (Matrix (Fin n) (Fin n) A)⟩ : CSA.{u, v} K) =
      brauerDeltaOfCSA K Ksep A := by
  have hn : 0 < n := NeZero.pos n
  have hd := Algebra.IsCentralSimple.degree_pos K A
  obtain ⟨eA⟩ := centralSimpleAlgebraOfDegree_splitEquiv K Ksep
    (Algebra.IsCentralSimple.degree K A) ⟨A, rfl⟩
  set d := Algebra.IsCentralSimple.degree K A
  set e := tensorSplitEquiv K Ksep A (Matrix (Fin n) (Fin n) K) d n eA
    (matrixSplitEquiv K Ksep n)
  set f := matrixEquivTensor (Fin n) K A
  rw [brauerDeltaOfCSA_eq_split K Ksep
    (⟨.of K (Matrix (Fin n) (Fin n) A)⟩ : CSA.{u, v} K)
    (d * n) (Nat.mul_pos hd hn) ((tensorAlgEquivOfAlgEquiv K Ksep _ _ f).trans e)]
  have h : (Quotient.mk _ (splitPGLCocycle K Ksep (d * n) (mul_ne_zero hd.ne' hn.ne')
      (Matrix (Fin n) (Fin n) A) ((tensorAlgEquivOfAlgEquiv K Ksep _ _ f).trans e)) :
        PGLH1 K Ksep (d * n)) =
      Quotient.mk _ (splitPGLCocycle K Ksep (d * n) (mul_ne_zero hd.ne' hn.ne')
        (A ⊗[K] Matrix (Fin n) (Fin n) K) e) := by
    apply Quotient.sound
    apply Relation.EqvGen.rel
    refine ⟨1, fun σ => ?_⟩
    simpa only [inv_one, one_mul, map_one, mul_one, splitPGLCocycle] using
      (splitTransportPGL_congr K Ksep (d * n) (mul_ne_zero hd.ne' hn.ne') _ _ f e σ).symm
  rw [h, pglConnectingMap_tensorSplit K Ksep A (Matrix (Fin n) (Fin n) K) d n hd hn eA
    (matrixSplitEquiv K Ksep n), pglConnectingMap_matrixSplit K Ksep n hn]
  exact (mul_one _).trans (brauerDeltaOfCSA_eq_split K Ksep A d hd eA).symm

/-- **Brauer-equivalent central simple algebras have the same connecting class.** This is what
makes the map `δ` of tag 03R7 well defined on the Brauer group. -/
@[sga "4½ Arcata 3.1.2" "partial"]
theorem brauerDeltaOfCSA_eq_of_isBrauerEquivalent (A B : CSA.{u, v} K)
    (h : IsBrauerEquivalent A B) :
    brauerDeltaOfCSA K Ksep A = brauerDeltaOfCSA K Ksep B := by
  obtain ⟨n, m, hn, hm, ⟨e⟩⟩ := h
  have : NeZero n := ⟨hn⟩
  have : NeZero m := ⟨hm⟩
  calc
    brauerDeltaOfCSA K Ksep A =
        brauerDeltaOfCSA K Ksep (⟨.of K (Matrix (Fin n) (Fin n) A)⟩ : CSA.{u, v} K) :=
      (brauerDeltaOfCSA_matrix K Ksep A n).symm
    _ = brauerDeltaOfCSA K Ksep (⟨.of K (Matrix (Fin m) (Fin m) B)⟩ : CSA.{u, v} K) :=
      brauerDeltaOfCSA_eq_of_algEquiv K Ksep _ _ e
    _ = brauerDeltaOfCSA K Ksep B := brauerDeltaOfCSA_matrix K Ksep B m

end Descent

section Delta

/-- **The map `δ : Br(K) → H²(Gal(Kˢᵉᵖ/K), (Kˢᵉᵖ)ˣ)`.** The Brauer class of a central simple
algebra `A` of degree `d` is sent to the class of the scalar two-cocycle
`(σ, τ) ↦ g̃_σ⁻¹ g̃_{σ τ} σ(g̃_τ⁻¹)` of a lift `g̃` of the projective cocycle of a splitting of
`Kˢᵉᵖ ⊗ A`. -/
@[stacks 03R7 "the map δ", sga "4½ Arcata 3.1.2" "definition of δ"]
def brauerDelta : BrauerGroup.{u, v} K → TwoCohomology K Ksep :=
  BrauerGroup.lift (brauerDeltaOfCSA K Ksep) (brauerDeltaOfCSA_eq_of_isBrauerEquivalent K Ksep)

/-- The map `δ` sends the Brauer class of a central simple algebra `A` to
`brauerDeltaOfCSA K Ksep A`. -/
@[simp]
theorem brauerDelta_mk (A : CSA.{u, v} K) :
    brauerDelta K Ksep (Quotient.mk _ A : BrauerGroup.{u, v} K) = brauerDeltaOfCSA K Ksep A :=
  rfl

/-- **The map `δ` of tag 03R7 is a group homomorphism**: it takes the group law of the Brauer
group, which is tensor product, to the group law of the second cohomology group. -/
@[stacks 03R7 "δ is a group homomorphism", sga "4½ Arcata 3.1.2" "δ is a homomorphism"]
theorem brauerDelta_mul (x y : BrauerGroup.{u, v} K) :
    brauerDelta K Ksep (x * y) = brauerDelta K Ksep x * brauerDelta K Ksep y := by
  refine Quotient.inductionOn₂ x y fun A B => ?_
  change brauerDelta K Ksep (Quotient.mk _ (⟨.of K (A ⊗[K] B)⟩ : CSA.{u, v} K)) = _
  rw [brauerDelta_mk, brauerDelta_mk, brauerDelta_mk]
  exact brauerDeltaOfCSA_tensor K Ksep A B

end Delta

end General

section Bundled

variable (K : Type u) [Field K] (Ksep : Type u) [Field Ksep] [Algebra K Ksep]
  [IsSepClosure K Ksep]

/-- The map `δ : Br(K) → H²(Gal(Kˢᵉᵖ/K), (Kˢᵉᵖ)ˣ)` as a group homomorphism, for `Kˢᵉᵖ` in the
universe of `K`, where the Brauer group carries its commutative group structure;
`brauerDelta_mul` is the multiplicativity statement without that restriction. -/
@[sga "4½ Arcata 3.1.2"]
def brauerDeltaHom : BrauerGroup.{u, u} K →* TwoCohomology K Ksep :=
  MonoidHom.mk' (brauerDelta K Ksep) (brauerDelta_mul K Ksep)

/-- The homomorphism `brauerDeltaHom` agrees with `brauerDelta` on every Brauer class. -/
@[simp]
theorem brauerDeltaHom_apply (x : BrauerGroup.{u, u} K) :
    brauerDeltaHom K Ksep x = brauerDelta K Ksep x :=
  rfl

/-- The Brauer class of the ground field has trivial image. -/
@[simp]
theorem brauerDelta_one : brauerDelta K Ksep (1 : BrauerGroup.{u, u} K) = 1 :=
  map_one (brauerDeltaHom K Ksep)

end Bundled

end Stacks.GaloisCohomology
