module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.BrauerGroups.GaloisTwoCohomology
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.BrauerGroups.ProjectiveLiftTwoCocycle

/-!
# The connecting map of the scalar central extension

Let `Ω/K` be an algebraic Galois extension and let `d` be positive. The scalar matrices are the
centre of `GL_d(Ω)`, so

`1 → Ωˣ → GL_d(Ω) → PGL_d(Ω) → 1`

is a central extension of Galois modules, and the associated connecting map takes a continuous
projective `1`-cocycle `g` of `Gal(Ω/K)` to the class of the scalar defect
`(σ, τ) ↦ g̃_σ⁻¹ g̃_{σ τ} σ(g̃_τ⁻¹)` of a continuous lift `g̃` of `g`. This file constructs that
map.

A locally constant lift of a locally constant projective cocycle is obtained by composing with a
set-theoretic section of `GL_d(Ω) → PGL_d(Ω)`, and the class of the defect depends neither on
the lift nor on the representative of the cohomology class, so the map descends to the
nonabelian `H¹` with values in `PGL_d(Ω)`.

## Main definitions

* `Stacks.GaloisCohomology.pglCocycleLift`: a locally constant lift of a projective cocycle.
* `Stacks.GaloisCohomology.liftTwoCocycle`: the scalar defect of a locally constant lift, read as
  a locally constant two-cocycle.
* `Stacks.GaloisCohomology.pglConnectingMap`: the connecting map
  `H¹(Gal(Ω/K), PGL_d(Ω)) → H²(Gal(Ω/K), Ωˣ)`.

## Main results

* `Stacks.GaloisCohomology.isLocallyConstant_twoCocycleOfLift`: the scalar defect of a locally
  constant family of lifts is locally constant.
* `Stacks.GaloisCohomology.twoCohomologyClass_liftTwoCocycle_eq`: the class of the defect does
  not depend on the chosen lift.
* `Stacks.GaloisCohomology.pglConnectingMap_mk`: the connecting map is computed by the defect of
  *any* locally constant lift of the given cocycle.

## Implementation notes

Continuity of a cochain is local constancy for the Krull topology, as in `Hilbert90` and
`TwoCocycleInflation`, whereas `PGLCocycle` states continuity by exhibiting a finite subset of
`Ω` on which the automorphism determines the value; `isLocallyConstant_of_finset` turns the
second into the first, the fixing subgroup of the subfield generated by finitely many algebraic
elements being open.

The scalar defect is read off a diagonal entry by `centerScalar`, hence is a function of the
defect matrix alone, and `isLocallyConstant_of_factorsThrough` is the form of local constancy
this makes available. The scalar by which two lifts of one projective cocycle differ is given by
the same construction, so comparing two lifts produces an explicit coboundary instead of an
existence statement.

## References

* [Stacks Project, Tag 0A2I](https://stacks.math.columbia.edu/tag/0A2I)
* [Stacks Project, Tag 03R7](https://stacks.math.columbia.edu/tag/03R7)
-/

@[expose] public noncomputable section

open scoped MatrixGroups

open groupCohomology

open scoped Pointwise

namespace Stacks.GaloisCohomology

/-- A map that depends only on the value of a locally constant map is locally constant. -/
theorem isLocallyConstant_of_factorsThrough {X α β : Type*} [TopologicalSpace X] {D : X → α}
    (hD : IsLocallyConstant D) {F : X → β} (h : ∀ x y, D x = D y → F x = F y) :
    IsLocallyConstant F := by
  rw [IsLocallyConstant.iff_exists_open]
  exact fun x => ⟨D ⁻¹' {D x}, hD _, rfl, fun y hy => h y x hy⟩

section Scalar

variable {Ω : Type*} [Field Ω] {n : Type*} [Fintype n] [DecidableEq n]

/-- A scalar matrix is central. -/
theorem scalar_mem_center (u : Ωˣ) :
    Matrix.GeneralLinearGroup.scalar n u ∈ Subgroup.center (GL n Ω) := by
  rw [Matrix.GeneralLinearGroup.center_eq_range_scalar]
  exact ⟨u, rfl⟩

/-- Scalar matrices commute with every invertible matrix. -/
theorem scalar_comm (u : Ωˣ) (x : GL n Ω) :
    Matrix.GeneralLinearGroup.scalar n u * x = x * Matrix.GeneralLinearGroup.scalar n u :=
  (Subgroup.mem_center_iff.mp (scalar_mem_center u) x).symm

/-- Equal central matrices have equal scalars. -/
private theorem centerScalar_congr (i : n) {M M' : GL n Ω} {hM : M ∈ Subgroup.center (GL n Ω)}
    {hM' : M' ∈ Subgroup.center (GL n Ω)} (h : M = M') :
    centerScalar i M hM = centerScalar i M' hM' := by
  subst h
  rfl

end Scalar

section Krull

variable {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω] [Algebra.IsAlgebraic K Ω]

/-- A map out of `Gal(Ω/K)` unchanged by right multiplication by the automorphisms fixing a
finite subset of `Ω` pointwise is locally constant for the Krull topology. -/
theorem isLocallyConstant_of_finset {α : Type*} {F : Gal(Ω/K) → α} (S : Finset Ω)
    (hF : ∀ σ a : Gal(Ω/K), (∀ x ∈ S, a x = x) → F (σ * a) = F σ) :
    IsLocallyConstant F := by
  have : Finite ((S : Set Ω)) := S.finite_toSet.to_subtype
  have : FiniteDimensional K (IntermediateField.adjoin K (S : Set Ω)) :=
    IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
  rw [IsLocallyConstant.iff_exists_open]
  intro σ
  refine ⟨σ • ((IntermediateField.adjoin K (S : Set Ω)).fixingSubgroup : Set Gal(Ω/K)),
    (IntermediateField.fixingSubgroup_isOpen _).leftCoset σ, ⟨1, one_mem _, by simp⟩, ?_⟩
  rintro τ ⟨a, ha, rfl⟩
  exact hF σ a fun x hx =>
    (IntermediateField.mem_fixingSubgroup_iff _ a).mp ha x
      (IntermediateField.subset_adjoin K _ hx)

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The Galois action on a fixed invertible matrix is locally constant: the image depends only on
the restriction of the automorphism to the finitely many entries. -/
theorem isLocallyConstant_glMap (M : GL n Ω) :
    IsLocallyConstant fun σ : Gal(Ω/K) =>
      Matrix.GeneralLinearGroup.map (MulSemiringAction.toRingHom Gal(Ω/K) Ω σ) M := by
  classical
  refine isLocallyConstant_of_finset
    (Finset.image (fun ij : n × n => (M : Matrix n n Ω) ij.1 ij.2) Finset.univ) ?_
  intro σ a ha
  apply Units.ext
  ext i j
  rw [Matrix.GeneralLinearGroup.map_apply, Matrix.GeneralLinearGroup.map_apply]
  show (σ * a) ((M : Matrix n n Ω) i j) = σ ((M : Matrix n n Ω) i j)
  rw [AlgEquiv.mul_apply, ha _ (Finset.mem_image.2 ⟨(i, j), Finset.mem_univ _, rfl⟩)]

/-- The defect of a locally constant family of lifts is locally constant. -/
theorem isLocallyConstant_liftDefect (lift : Gal(Ω/K) → GL n Ω)
    (hlc : IsLocallyConstant lift) :
    IsLocallyConstant fun p : Gal(Ω/K) × Gal(Ω/K) => liftDefect lift p.1 p.2 := by
  have h₁ : IsLocallyConstant fun p : Gal(Ω/K) × Gal(Ω/K) => (lift p.1)⁻¹ :=
    (hlc.comp_continuous continuous_fst).comp (Inv.inv : GL n Ω → GL n Ω)
  have h₂ : IsLocallyConstant fun p : Gal(Ω/K) × Gal(Ω/K) => lift (p.1 * p.2) :=
    hlc.comp_continuous continuous_mul
  have h₃ : IsLocallyConstant fun p : Gal(Ω/K) × Gal(Ω/K) =>
      Matrix.GeneralLinearGroup.map (MulSemiringAction.toRingHom Gal(Ω/K) Ω p.1)
        (lift p.2)⁻¹ := by
    rw [IsLocallyConstant.iff_exists_open]
    intro p
    obtain ⟨U, hU, hpU, hUval⟩ :=
      (IsLocallyConstant.iff_exists_open _).1 (isLocallyConstant_glMap (K := K) (lift p.2)⁻¹) p.1
    refine ⟨U ×ˢ (lift ⁻¹' {lift p.2}), hU.prod (hlc _), ⟨hpU, rfl⟩, ?_⟩
    rintro ⟨σ, τ⟩ ⟨hσ, hτ⟩
    rw [show lift τ = lift p.2 from hτ]
    exact hUval σ hσ
  exact (h₁.comp₂ h₂ (· * ·)).comp₂ h₃ (· * ·)

/-- The scalar defect of a locally constant family of lifts with central defect is locally
constant. -/
theorem isLocallyConstant_twoCocycleOfLift (i : n) (lift : Gal(Ω/K) → GL n Ω)
    (hc : ∀ σ τ, liftDefect lift σ τ ∈ Subgroup.center (GL n Ω))
    (hlc : IsLocallyConstant lift) :
    IsLocallyConstant (twoCocycleOfLift i lift hc) := by
  refine isLocallyConstant_of_factorsThrough (isLocallyConstant_liftDefect lift hlc) ?_
  rintro ⟨σ, τ⟩ ⟨σ', τ'⟩ h
  exact centerScalar_congr i h

end Krull

section Ratio

variable {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω] {n : Type*} [Fintype n] [DecidableEq n]

/-- The Galois action on units is the one induced by the semiring action. -/
theorem units_map_toRingHom (σ : Gal(Ω/K)) (u : Ωˣ) :
    Units.map (MulSemiringAction.toRingHom Gal(Ω/K) Ω σ : Ω →* Ω) u = σ • u :=
  rfl

/-- Two lifts of one projective family have central ratio. -/
theorem inv_mul_mem_center_of_mk_eq {lift lift' : Gal(Ω/K) → GL n Ω}
    (h : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = Matrix.ProjGenLinGroup.mk (lift' σ))
    (σ : Gal(Ω/K)) : (lift σ)⁻¹ * lift' σ ∈ Subgroup.center (GL n Ω) := by
  rw [← Matrix.ProjGenLinGroup.mk_eq_one, map_mul, map_inv, h σ]
  group

/-- The scalar by which two lifts of one projective family differ. -/
def liftRatio (i : n) (lift lift' : Gal(Ω/K) → GL n Ω)
    (h : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = Matrix.ProjGenLinGroup.mk (lift' σ)) :
    Gal(Ω/K) → Ωˣ :=
  fun σ => centerScalar i ((lift σ)⁻¹ * lift' σ) (inv_mul_mem_center_of_mk_eq h σ)

/-- The second lift is the first times the scalar matrix of their ratio. -/
theorem eq_mul_scalar_liftRatio (i : n) (lift lift' : Gal(Ω/K) → GL n Ω)
    (h : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = Matrix.ProjGenLinGroup.mk (lift' σ))
    (σ : Gal(Ω/K)) :
    lift' σ = lift σ * Matrix.GeneralLinearGroup.scalar n (liftRatio i lift lift' h σ) := by
  rw [liftRatio, scalar_centerScalar]
  group

variable [Algebra.IsAlgebraic K Ω]

omit [Algebra.IsAlgebraic K Ω] in
/-- The ratio of two locally constant lifts is locally constant. -/
theorem isLocallyConstant_liftRatio (i : n) (lift lift' : Gal(Ω/K) → GL n Ω)
    (h : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = Matrix.ProjGenLinGroup.mk (lift' σ))
    (hlc : IsLocallyConstant lift) (hlc' : IsLocallyConstant lift') :
    IsLocallyConstant (liftRatio i lift lift' h) := by
  refine isLocallyConstant_of_factorsThrough
    (hlc.comp₂ hlc' fun x y => x⁻¹ * y) fun σ τ hστ =>
    centerScalar_congr i hστ

end Ratio

section Independence

variable {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω] {n : Type*} [Fintype n] [DecidableEq n]

/-- The cancellation step in the comparison of two lifts: the two expansions of the lift of a
product agree after removing the part common to both. -/
private theorem units_eq_of_scalar_eq (i : n) {A C : GL n Ω} {u v w c c' : Ωˣ}
    (hEq : A * C * Matrix.GeneralLinearGroup.scalar n c *
        Matrix.GeneralLinearGroup.scalar n v =
      A * Matrix.GeneralLinearGroup.scalar n u *
        (C * Matrix.GeneralLinearGroup.scalar n w) *
        Matrix.GeneralLinearGroup.scalar n c') :
    c * v = u * w * c' := by
  refine scalar_injective i ?_
  rw [map_mul, map_mul, map_mul]
  refine mul_left_cancel (a := A * C) ?_
  calc A * C * (Matrix.GeneralLinearGroup.scalar n c * Matrix.GeneralLinearGroup.scalar n v)
      = A * C * Matrix.GeneralLinearGroup.scalar n c *
          Matrix.GeneralLinearGroup.scalar n v := by group
    _ = A * Matrix.GeneralLinearGroup.scalar n u *
          (C * Matrix.GeneralLinearGroup.scalar n w) *
          Matrix.GeneralLinearGroup.scalar n c' := hEq
    _ = A * (Matrix.GeneralLinearGroup.scalar n u * C) *
          Matrix.GeneralLinearGroup.scalar n w *
          Matrix.GeneralLinearGroup.scalar n c' := by group
    _ = A * (C * Matrix.GeneralLinearGroup.scalar n u) *
          Matrix.GeneralLinearGroup.scalar n w *
          Matrix.GeneralLinearGroup.scalar n c' := by rw [scalar_comm]
    _ = _ := by group

/-- Changing the lift multiplies the scalar defect by the coboundary of the ratio of the two
lifts: `c(σ, τ)⁻¹ c'(σ, τ) = b(σ)⁻¹ b(σ τ) σ(b(τ))⁻¹`. -/
theorem inv_mul_twoCocycleOfLift (i : n) (lift lift' : Gal(Ω/K) → GL n Ω)
    (hc : ∀ σ τ, liftDefect lift σ τ ∈ Subgroup.center (GL n Ω))
    (hc' : ∀ σ τ, liftDefect lift' σ τ ∈ Subgroup.center (GL n Ω))
    (h : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = Matrix.ProjGenLinGroup.mk (lift' σ))
    (σ τ : Gal(Ω/K)) :
    (twoCocycleOfLift i lift hc (σ, τ))⁻¹ * twoCocycleOfLift i lift' hc' (σ, τ) =
      (liftRatio i lift lift' h σ)⁻¹ * liftRatio i lift lift' h (σ * τ) *
        (σ • liftRatio i lift lift' h τ)⁻¹ := by
  have hmap : Matrix.GeneralLinearGroup.map (MulSemiringAction.toRingHom Gal(Ω/K) Ω σ)
      (lift' τ) = Matrix.GeneralLinearGroup.map
        (MulSemiringAction.toRingHom Gal(Ω/K) Ω σ) (lift τ) *
        Matrix.GeneralLinearGroup.scalar n (σ • liftRatio i lift lift' h τ) := by
    rw [eq_mul_scalar_liftRatio i lift lift' h τ, map_mul,
      Matrix.GeneralLinearGroup.map_scalar, units_map_toRingHom]
  have hEq : lift σ * Matrix.GeneralLinearGroup.map
        (MulSemiringAction.toRingHom Gal(Ω/K) Ω σ) (lift τ) *
        Matrix.GeneralLinearGroup.scalar n (twoCocycleOfLift i lift hc (σ, τ)) *
        Matrix.GeneralLinearGroup.scalar n (liftRatio i lift lift' h (σ * τ)) =
      lift σ * Matrix.GeneralLinearGroup.scalar n (liftRatio i lift lift' h σ) *
        (Matrix.GeneralLinearGroup.map (MulSemiringAction.toRingHom Gal(Ω/K) Ω σ) (lift τ) *
          Matrix.GeneralLinearGroup.scalar n (σ • liftRatio i lift lift' h τ)) *
        Matrix.GeneralLinearGroup.scalar n (twoCocycleOfLift i lift' hc' (σ, τ)) := by
    rw [← lift_mul_eq i lift hc σ τ, ← eq_mul_scalar_liftRatio i lift lift' h (σ * τ), ← hmap,
      ← eq_mul_scalar_liftRatio i lift lift' h σ, ← lift_mul_eq i lift' hc' σ τ]
  rw [inv_mul_eq_iff_eq_mul]
  calc twoCocycleOfLift i lift' hc' (σ, τ)
      = (liftRatio i lift lift' h σ * (σ • liftRatio i lift lift' h τ))⁻¹ *
          (liftRatio i lift lift' h σ * (σ • liftRatio i lift lift' h τ) *
            twoCocycleOfLift i lift' hc' (σ, τ)) := by
        rw [inv_mul_cancel_left]
    _ = (liftRatio i lift lift' h σ * (σ • liftRatio i lift lift' h τ))⁻¹ *
          (twoCocycleOfLift i lift hc (σ, τ) * liftRatio i lift lift' h (σ * τ)) := by
        rw [units_eq_of_scalar_eq i hEq]
    _ = _ := by rw [mul_inv]; ac_rfl

end Independence

section Section

variable {n R : Type*} [Fintype n] [DecidableEq n] [CommRing R]

/-- A set-theoretic section of the projection `GL_n(R) → PGL_n(R)`. Choosing a representative of
each projective class is what turns a projective cocycle into a family of invertible matrices;
the extension is central, so no choice of section can be multiplicative. -/
def glOfPGL : PGL(n, R) → GL n R :=
  Function.surjInv Matrix.ProjGenLinGroup.mk_surjective

/-- The section `glOfPGL` is a right inverse of the projection `GL_n(R) → PGL_n(R)`. -/
@[simp]
theorem mk_glOfPGL (x : PGL(n, R)) : Matrix.ProjGenLinGroup.mk (glOfPGL x) = x :=
  Function.surjInv_eq _ _

end Section

section ConnectingMap

variable {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω] {d : ℕ}

/-- The Galois action as a ring homomorphism is the ring homomorphism of the automorphism. -/
theorem toRingHom_eq (σ : Gal(Ω/K)) :
    MulSemiringAction.toRingHom Gal(Ω/K) Ω σ = σ.toRingEquiv.toRingHom :=
  rfl

/-- The scalar matrix of the two-cocycle of a lift is the defect of that lift. -/
theorem scalar_twoCocycleOfLift_eq_liftDefect {n : Type*} [Fintype n] [DecidableEq n] (i : n)
    (lift : Gal(Ω/K) → GL n Ω)
    (hc : ∀ σ τ, liftDefect lift σ τ ∈ Subgroup.center (GL n Ω)) (σ τ : Gal(Ω/K)) :
    Matrix.GeneralLinearGroup.scalar n (twoCocycleOfLift i lift hc (σ, τ)) =
      liftDefect lift σ τ :=
  scalar_twoCocycleOfLift i lift hc σ τ

/-- The Galois two-cocycle of a lift of a projective cocycle is the scalar defect of that lift. -/
theorem twoCocycleOfPGLCocycle_eq (hd : 0 < d) (g : PGLCocycle K Ω d)
    (lift : Gal(Ω/K) → GL (Fin d) Ω)
    (hlift : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = g.toFun σ) :
    twoCocycleOfPGLCocycle hd g lift hlift =
      twoCocycleOfLift (⟨0, hd⟩ : Fin d) lift (pglCocycle_liftDefect_mem_center g lift hlift) :=
  rfl

/-- The lift of a projective Galois cocycle given by the section `glOfPGL`. -/
def pglCocycleLift (g : PGLCocycle K Ω d) : Gal(Ω/K) → GL (Fin d) Ω :=
  fun σ => glOfPGL (g.toFun σ)

/-- The lift `pglCocycleLift g` projects to the projective cocycle `g`. -/
@[simp]
theorem mk_pglCocycleLift (g : PGLCocycle K Ω d) (σ : Gal(Ω/K)) :
    Matrix.ProjGenLinGroup.mk (pglCocycleLift g σ) = g.toFun σ :=
  mk_glOfPGL _

variable [Algebra.IsAlgebraic K Ω]

/-- A continuous projective Galois cocycle is locally constant for the Krull topology. -/
theorem isLocallyConstant_pglCocycle (g : PGLCocycle K Ω d) : IsLocallyConstant g.toFun := by
  obtain ⟨S, hS⟩ := g.continuous
  refine isLocallyConstant_of_finset S fun σ a ha => hS (σ * a) σ fun x hx => ?_
  rw [AlgEquiv.mul_apply, ha x hx]

/-- The lift `pglCocycleLift g` of a continuous projective Galois cocycle is locally constant. -/
theorem isLocallyConstant_pglCocycleLift (g : PGLCocycle K Ω d) :
    IsLocallyConstant (pglCocycleLift g) :=
  (isLocallyConstant_pglCocycle g).comp glOfPGL

/-- The scalar defect of a locally constant lift of a projective Galois cocycle, as a locally
constant two-cocycle with values in `Ωˣ`. -/
def liftTwoCocycle (hd : 0 < d) (g : PGLCocycle K Ω d) (lift : Gal(Ω/K) → GL (Fin d) Ω)
    (hlift : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = g.toFun σ)
    (hlc : IsLocallyConstant lift) : twoCocycles K Ω :=
  twoCocyclesMk (twoCocycleOfPGLCocycle hd g lift hlift)
    (isLocallyConstant_twoCocycleOfLift (⟨0, hd⟩ : Fin d) lift
      (pglCocycle_liftDefect_mem_center g lift hlift) hlc)
    (isMulCocycle₂_twoCocycleOfPGLCocycle hd g lift hlift)

/-- The underlying function of `liftTwoCocycle` is the scalar defect
`twoCocycleOfPGLCocycle hd g lift hlift`. -/
@[simp]
theorem coe_liftTwoCocycle (hd : 0 < d) (g : PGLCocycle K Ω d)
    (lift : Gal(Ω/K) → GL (Fin d) Ω)
    (hlift : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = g.toFun σ)
    (hlc : IsLocallyConstant lift) :
    (liftTwoCocycle hd g lift hlift hlc : Gal(Ω/K) × Gal(Ω/K) → Ωˣ) =
      twoCocycleOfPGLCocycle hd g lift hlift :=
  rfl

/-- The class of the scalar defect does not depend on the chosen locally constant lift. -/
theorem twoCohomologyClass_liftTwoCocycle_eq (hd : 0 < d) (g : PGLCocycle K Ω d)
    (lift : Gal(Ω/K) → GL (Fin d) Ω)
    (hlift : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = g.toFun σ)
    (hlc : IsLocallyConstant lift) (lift' : Gal(Ω/K) → GL (Fin d) Ω)
    (hlift' : ∀ σ, Matrix.ProjGenLinGroup.mk (lift' σ) = g.toFun σ)
    (hlc' : IsLocallyConstant lift') :
    twoCohomologyClass (liftTwoCocycle hd g lift hlift hlc) =
      twoCohomologyClass (liftTwoCocycle hd g lift' hlift' hlc') := by
  have hmk : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = Matrix.ProjGenLinGroup.mk (lift' σ) :=
    fun σ => (hlift σ).trans (hlift' σ).symm
  rw [twoCohomologyClass_eq_iff, mem_twoCoboundaries_iff]
  refine ⟨(liftRatio (⟨0, hd⟩ : Fin d) lift lift' hmk)⁻¹,
    (isLocallyConstant_liftRatio (⟨0, hd⟩ : Fin d) lift lift' hmk hlc hlc').comp
      (Inv.inv : Ωˣ → Ωˣ), fun σ τ => ?_⟩
  simp only [Subgroup.coe_mul, Subgroup.coe_inv, Pi.mul_apply, Pi.inv_apply,
    coe_liftTwoCocycle, twoCocycleOfPGLCocycle_eq]
  rw [inv_mul_twoCocycleOfLift (⟨0, hd⟩ : Fin d) lift lift'
    (pglCocycle_liftDefect_mem_center g lift hlift)
    (pglCocycle_liftDefect_mem_center g lift' hlift') hmk σ τ]
  simp only [smul_inv', div_eq_mul_inv, inv_inv]
  ac_rfl

/-- The class of the scalar defect of a lift of a projective Galois cocycle. -/
def pglConnectingMapOfCocycle (hd : 0 < d) (g : PGLCocycle K Ω d) : TwoCohomology K Ω :=
  twoCohomologyClass (liftTwoCocycle hd g (pglCocycleLift g) (mk_pglCocycleLift g)
    (isLocallyConstant_pglCocycleLift g))

/-- The class of the scalar defect is computed by every locally constant lift. -/
theorem pglConnectingMapOfCocycle_eq (hd : 0 < d) (g : PGLCocycle K Ω d)
    (lift : Gal(Ω/K) → GL (Fin d) Ω)
    (hlift : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = g.toFun σ)
    (hlc : IsLocallyConstant lift) :
    pglConnectingMapOfCocycle hd g = twoCohomologyClass (liftTwoCocycle hd g lift hlift hlc) :=
  twoCohomologyClass_liftTwoCocycle_eq hd g _ _ _ lift hlift hlc

/-- Cohomologous projective Galois cocycles have the same connecting class: conjugating a lift by
a lift of the coboundary leaves the scalar defect unchanged, the defect being central. -/
theorem pglConnectingMapOfCocycle_congr (hd : 0 < d) (f g : PGLCocycle K Ω d)
    (hfg : PGLCocycle.IsCohomologous f g) :
    pglConnectingMapOfCocycle hd f = pglConnectingMapOfCocycle hd g := by
  obtain ⟨b, hb⟩ := hfg
  set lift' : Gal(Ω/K) → GL (Fin d) Ω := fun ρ =>
      (glOfPGL b)⁻¹ * pglCocycleLift f ρ *
        Matrix.GeneralLinearGroup.map (MulSemiringAction.toRingHom Gal(Ω/K) Ω ρ) (glOfPGL b)
    with hdef
  have hmk' : ∀ ρ, Matrix.ProjGenLinGroup.mk (lift' ρ) = g.toFun ρ := by
    intro ρ
    rw [hdef, map_mul, map_mul, map_inv, mk_glOfPGL, mk_pglCocycleLift,
      ← Matrix.ProjGenLinGroup.map_mk, mk_glOfPGL, toRingHom_eq, hb ρ]
  have hlc' : IsLocallyConstant lift' := by
    rw [hdef]
    exact ((isLocallyConstant_pglCocycleLift f).comp
      (fun x => (glOfPGL b)⁻¹ * x)).comp₂ (isLocallyConstant_glMap (glOfPGL b)) (· * ·)
  have hdefect : ∀ ρ κ : Gal(Ω/K),
      liftDefect lift' ρ κ = liftDefect (pglCocycleLift f) ρ κ := by
    intro ρ κ
    have hstep : liftDefect lift' ρ κ =
        (Matrix.GeneralLinearGroup.map (MulSemiringAction.toRingHom Gal(Ω/K) Ω ρ)
            (glOfPGL b))⁻¹ * liftDefect (pglCocycleLift f) ρ κ *
          Matrix.GeneralLinearGroup.map (MulSemiringAction.toRingHom Gal(Ω/K) Ω ρ)
            (glOfPGL b) := by
      simp only [liftDefect, hdef, map_mul, map_inv, ← map_toRingHom_mul]
      group
    rw [hstep, Subgroup.mem_center_iff.mp
      (pglCocycle_liftDefect_mem_center f (pglCocycleLift f) (mk_pglCocycleLift f) ρ κ)]
    group
  rw [pglConnectingMapOfCocycle, pglConnectingMapOfCocycle_eq hd g lift' hmk' hlc']
  congr 1
  refine Subtype.ext (funext fun p => ?_)
  simp only [coe_liftTwoCocycle, twoCocycleOfPGLCocycle_eq]
  exact centerScalar_congr _ (hdefect p.1 p.2).symm

/-- **The connecting map of the scalar central extension.**
`δ_d : H¹(Gal(Ω/K), PGL_d(Ω)) → H²(Gal(Ω/K), Ωˣ)` sends the class of a projective cocycle `g` to
the class of the scalar defect `(σ, τ) ↦ g̃_σ⁻¹ g̃_{σ τ} σ(g̃_τ⁻¹)` of a continuous lift `g̃`. -/
def pglConnectingMap (hd : 0 < d) : PGLH1 K Ω d → TwoCohomology K Ω :=
  Quotient.lift (pglConnectingMapOfCocycle hd) <| by
    intro f g hfg
    induction hfg with
    | rel a b hab => exact pglConnectingMapOfCocycle_congr hd a b hab
    | refl a => rfl
    | symm a b _ ih => exact ih.symm
    | trans a b c _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- The connecting map is computed by the scalar defect of any locally constant lift of any
representative. -/
theorem pglConnectingMap_mk (hd : 0 < d) (g : PGLCocycle K Ω d)
    (lift : Gal(Ω/K) → GL (Fin d) Ω)
    (hlift : ∀ σ, Matrix.ProjGenLinGroup.mk (lift σ) = g.toFun σ)
    (hlc : IsLocallyConstant lift) :
    pglConnectingMap hd (Quotient.mk _ g) =
      twoCohomologyClass (liftTwoCocycle hd g lift hlift hlc) :=
  pglConnectingMapOfCocycle_eq hd g lift hlift hlc

end ConnectingMap

end Stacks.GaloisCohomology
