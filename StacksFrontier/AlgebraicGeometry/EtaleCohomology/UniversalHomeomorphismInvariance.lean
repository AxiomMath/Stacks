module

public import Mathlib.Algebra.Homology.DerivedCategory.Ext.MapBijective
public import Mathlib.CategoryTheory.Abelian.GrothendieckCategory.EnoughInjectives
public import Mathlib.CategoryTheory.Sites.DenseSubsite.SheafEquiv
public import Mathlib.CategoryTheory.Sites.Equivalence
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.HenselianPairRestriction

/-!
# Topological invariance of étale cohomology

A universal homeomorphism of schemes induces an equivalence of small étale sites, hence of
their topoi, and pullback is then an isomorphism on the étale cohomology of every abelian
sheaf. This file carries the sheaf-theoretic half of that statement: once base change on the
small étale sites is a dense subsite inclusion, the inverse image on set-valued sheaves is an
equivalence and the canonical restriction map on étale cohomology is bijective in every degree.

## Main results

* `Stacks.EtaleCohomology.smallEtaleBaseChange_bot_mem_of_isEmpty` and
  `Stacks.EtaleCohomology.isEmpty_of_smallEtale_bot_mem`: the empty sieve on an object of the
  small étale site is covering exactly when that object is empty.
* `Stacks.EtaleCohomology.ext_precomp_iso_bijective`: precomposition with the degree-zero `Ext`
  class of an isomorphism is bijective.
* `Stacks.EtaleCohomology.smallEtaleInverseImage_isEquivalence_of_isDenseSubsite`: the
  inverse-image functor between small étale topoi is an equivalence.
* `Stacks.EtaleCohomology.etaleCohomologyRestrictionMap_bijective_of_isDenseSubsite`:
  restriction is a bijection on étale cohomology in every degree, for every abelian sheaf.

## Implementation notes

The small étale site is Mathlib's `AlgebraicGeometry.Scheme.Etale` with its small étale
topology, and base change is `Stacks.EtaleCohomology.smallEtaleBaseChange`.

The hypothesis carried here is that base change is a dense subsite inclusion of the small étale
site of the target into that of the source. For a universal homeomorphism that is Stacks
Project Tag 04DZ, topological invariance of the small étale site (EGA IV, Theorem 18.1.2),
which is not yet available in this library; stating the hypothesis explicitly keeps the
sheaf-theoretic content separate from that input, so these results are unconditional in
everything else.

`StacksFrontier/AlgebraicGeometry/EtaleCohomology/TopologicalInvariance/Basic.lean` breaks that
hypothesis into its four constituents and proves two of them for an arbitrary surjective
morphism — faithfulness of base change, and that base change neither creates nor destroys
covering sieves. By that file's
`isDenseSubsite_of_universalHomeomorphism_of_full_of_isCoverDense`, the hypothesis used here
reduces, for a universal homeomorphism, to fullness of base change (Tag 0BTY) together with
cover-density, the latter spelled out pointwise in
`Stacks.EtaleCohomology.isCoverDense_smallEtaleBaseChange_iff`. Neither of those two is proved
yet, so the hypothesis is still a hypothesis.

Given the hypothesis, the inverse image on sheaves is identified with the equivalence of sheaf
categories attached to a dense subsite by uniqueness of left adjoints. On abelian sheaves the
identification is additive and exact and preserves injective objects, so it induces a bijection
on `Ext` groups out of a fixed object; the comparison of constant integer sheaves then turns
that bijection into a bijection of the cohomology groups `Sheaf.H`. Enough injectives on the
source comes from the small étale site being essentially small, so its sheaf category is a
Grothendieck abelian category.

## References

* [EGA IV, Theorem 18.1.2]
* [Stacks Project, Tag 03SI](https://stacks.math.columbia.edu/tag/03SI)
* [Stacks Project, Tag 04DZ](https://stacks.math.columbia.edu/tag/04DZ)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry AlgebraicGeometry.Scheme

universe u v w

namespace Stacks.EtaleCohomology

section EmptySieve

variable {X : Scheme.{u}}

/-- The empty sieve on an object of the small étale site is covering exactly when that object is
empty. -/
private theorem smallEtale_bot_mem_iff_isEmpty (U : X.Etale) :
    (⊥ : Sieve U) ∈ smallEtaleTopology X U ↔ IsEmpty U.left := by
  classical
  let Z : PEmpty.{1} → X.Etale := fun i => PEmpty.elim i
  let g : ∀ i : PEmpty.{1}, Z i ⟶ U := fun i => PEmpty.elim i
  have hbot : Sieve.ofArrows Z g = ⊥ := by
    simp [Sieve.ofArrows, Presieve.ofArrows_of_isEmpty]
  rw [← hbot, Scheme.ofArrows_mem_smallEtaleTopology_iff]
  refine ⟨fun h => ⟨fun x => ?_⟩, fun hU => ?_⟩
  · simpa using h.ge (Set.mem_univ x)
  · ext x
    simp [hU.false x]

/-- The empty sieve on an empty object of the small étale site is covering: it is the sieve
generated by the empty family, which is jointly surjective. -/
theorem smallEtaleBaseChange_bot_mem_of_isEmpty (U : X.Etale) (hU : IsEmpty U.left) :
    (⊥ : Sieve U) ∈ smallEtaleTopology X U :=
  (smallEtale_bot_mem_iff_isEmpty U).2 hU

/-- Conversely, if the empty sieve on an object of the small étale site is covering then that
object is empty. -/
theorem isEmpty_of_smallEtale_bot_mem (U : X.Etale)
    (hU : (⊥ : Sieve U) ∈ smallEtaleTopology X U) : IsEmpty U.left :=
  (smallEtale_bot_mem_iff_isEmpty U).1 hU

end EmptySieve

/-- Precomposition with the degree-zero `Ext` class of an isomorphism is bijective. -/
theorem ext_precomp_iso_bijective {C : Type*} [Category C] [Abelian C]
    [HasExt.{w} C] {A B Z : C} (e : A ≅ B) (q : ℕ) :
    Function.Bijective ((Abelian.Ext.mk₀ e.inv).precomp Z (zero_add q)) := by
  apply Function.bijective_iff_has_inverse.mpr
  refine ⟨(Abelian.Ext.mk₀ e.hom).precomp Z (zero_add q), fun x => ?_, fun x => ?_⟩
  · change (Abelian.Ext.mk₀ e.hom).comp
      ((Abelian.Ext.mk₀ e.inv).comp x (zero_add q)) (zero_add q) = x
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
  · change (Abelian.Ext.mk₀ e.inv).comp
      ((Abelian.Ext.mk₀ e.hom).comp x (zero_add q)) (zero_add q) = x
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]

section DenseSubsite

variable {X Y : Scheme.{u}} (f : X ⟶ Y)
  [(smallEtaleBaseChange f).IsDenseSubsite
    (smallEtaleTopology Y) (smallEtaleTopology X)]

/-- Over a dense subsite inclusion, the sheaf pullback along base change is an equivalence. -/
private theorem isEquivalence_sheafPullback_of_isDenseSubsite
    (A : Type*) [Category A] [HasWeakSheafify (smallEtaleTopology X) A]
    [∀ U, HasLimitsOfShape (StructuredArrow U (smallEtaleBaseChange f).op) A]
    [∀ F : Y.Etaleᵒᵖ ⥤ A, (smallEtaleBaseChange f).op.HasLeftKanExtension F] :
    (Functor.sheafPullbackConstruction.sheafPullback (smallEtaleBaseChange f) A
      (smallEtaleTopology Y) (smallEtaleTopology X)).IsEquivalence := by
  let G := smallEtaleBaseChange f
  let : (G.sheafPushforwardContinuous A (smallEtaleTopology Y)
    (smallEtaleTopology X)).IsEquivalence := inferInstance
  let e := Functor.IsDenseSubsite.sheafEquiv (smallEtaleTopology Y) (smallEtaleTopology X) G A
  exact Functor.isEquivalence_of_iso (Adjunction.leftAdjointUniq
    (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous G A
      (smallEtaleTopology Y) (smallEtaleTopology X)) e.toAdjunction).symm

/-- **Stacks Project, Tag 03SI, part (2)**, given the equivalence of small étale sites. The
canonical inverse-image functor between small étale topoi is an equivalence. -/
theorem smallEtaleInverseImage_isEquivalence_of_isDenseSubsite :
    (smallEtaleInverseImage.{u, v} f).IsEquivalence :=
  isEquivalence_sheafPullback_of_isDenseSubsite f (Type (max (u + 1) v))

section Abelian

variable [HasSheafify X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}]

/-- The inverse image on abelian sheaves of the small étale sites is an equivalence. -/
theorem etaleAbelianInverseImage_isEquivalence_of_isDenseSubsite :
    (etaleAbelianInverseImage.{u, v} f).IsEquivalence :=
  isEquivalence_sheafPullback_of_isDenseSubsite f AddCommGrpCat.{max (u + 1) v}

/-- **Stacks Project, Tag 03SI, part (3)**, given the equivalence of small étale sites.
Restriction induces a bijection on étale cohomology in every degree, for every abelian
sheaf. -/
theorem etaleCohomologyRestrictionMap_bijective_of_isDenseSubsite
    [HasSheafify Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}]
    [HasExt.{w} (Sheaf Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    [HasExt.{w} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    (F : Sheaf Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}) (q : ℕ) :
    Function.Bijective (etaleCohomologyRestrictionMap.{u, v, w} f F q) := by
  let A := AddCommGrpCat.{max (u + 1) v}
  let E := etaleAbelianInverseImage.{u, v} f
  let : E.IsEquivalence := etaleAbelianInverseImage_isEquivalence_of_isDenseSubsite.{u, v} f
  let : E.Full := by infer_instance
  let : E.Faithful := by infer_instance
  let : E.Additive := by infer_instance
  let : PreservesFiniteLimits E := etaleAbelianInverseImage_preservesFiniteLimits.{u, v} f
  let : PreservesFiniteColimits E := by infer_instance
  let : E.PreservesInjectiveObjects := inferInstance
  let : EnoughInjectives (Sheaf Y.smallEtaleTopology A) := by
    have : IsGrothendieckAbelian.{max (u + 1) v} (Sheaf Y.smallEtaleTopology A) :=
      Sheaf.isGrothendieckAbelian_of_essentiallySmall Y.smallEtaleTopology A
    exact CategoryTheory.IsGrothendieckAbelian.enoughInjectives
  let c := (etaleAbelianInverseImageConstantIso.{u, v} f).app (AddCommGrpCat.of (ULift ℤ))
  change Function.Bijective
    (fun x => ((Abelian.Ext.mk₀ c.inv).precomp (E.obj F) (zero_add q))
      (E.mapExtAddHom
        ((constantSheaf Y.smallEtaleTopology A).obj (AddCommGrpCat.of (ULift ℤ))) F q x))
  exact (ext_precomp_iso_bijective c q).comp
    (Functor.mapExt_bijective_of_preservesInjectiveObjects E
      ((constantSheaf Y.smallEtaleTopology A).obj (AddCommGrpCat.of (ULift ℤ))) F q)

end Abelian

end DenseSubsite

end Stacks.EtaleCohomology

end
