module

public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import Mathlib.RingTheory.AdicCompletion.AsTensorProduct
public import Mathlib.RingTheory.MvPowerSeries.Equiv
public import StacksFrontier.AlgebraicGeometry.Pullback.StalkFromSpecStalk
public import StacksFrontier.AlgebraicGeometry.Scheme.Glueing.DoubledOrigin
public import StacksCore.Tactic.StacksAttribute

/-!
# Two fpqc coverings of the affine plane

Let `k` be a field, let `𝐀²_k = Spec k[x, y]` and let `iₓ : D(x) ⟶ 𝐀²_k` and `i_y : D(y) ⟶ 𝐀²_k`
be the two standard open immersions. Adding to these two a morphism `g` whose image contains the
origin produces an fpqc covering as soon as `g` is flat and quasi-compact: the family is finite,
so quasi-compactness of the family follows from quasi-compactness of its members, and a point of
`𝐀²_k` outside both `D(x)` and `D(y)` has an ideal containing both variables, hence equals the
origin because the ideal of the origin is maximal.

Two choices of `g` are recorded, the ones in the source: `Spec k[[x, y]] ⟶ 𝐀²_k`, which is flat
because `k[[x, y]]` is the adic completion of `k[x, y]` at the ideal of the variables and the
adic completion of a Noetherian ring is flat over it; and `Spec 𝒪_{𝐀²_k, 0} ⟶ 𝐀²_k`, which is
flat because the local ring is a localization.

## Main results

* `Module.flat_mvPowerSeries_mvPolynomial`: `R[[x₁, …, xₙ]]` is flat over `R[x₁, …, xₙ]`.
* `AlgebraicGeometry.affinePlaneCover`: the three-member family described above.
* `AlgebraicGeometry.presieve₀_affinePlaneCover_mem_fpqcPrecoverage`: it is an fpqc covering
  whenever the third morphism is flat, quasi-compact and hits the origin.
* `AlgebraicGeometry.presieve₀_affinePlanePowerSeriesCover_mem_fpqcPrecoverage` and
  `AlgebraicGeometry.presieve₀_affinePlaneLocalRingCover_mem_fpqcPrecoverage`: the two families
  of the source are fpqc coverings.

## Implementation notes

The affine plane is spelled `Spec k[x, y]` with `k[x, y] = MvPolynomial (Fin 2) k`, and
`k[[x, y]]` is `MvPowerSeries (Fin 2) k`, as in the source. The three members of the family have
different sources, so the family is given by a function into `Σ Y, Y ⟶ 𝐀²_k`; the first two
entries are fixed and the third is a parameter, which is what makes one proof serve both
examples.

## References

* [Stacks Project, Tag 03NY](https://stacks.math.columbia.edu/tag/03NY)
-/

@[expose] public section

open CategoryTheory Limits TopologicalSpace

universe u

/-- **`R[[x₁, …, xₙ]]` is flat over `R[x₁, …, xₙ]`** for a Noetherian ring `R`: the power series
ring is the adic completion of the polynomial ring at the ideal generated by the variables, and
the adic completion of a Noetherian ring is flat over it. -/
@[sga "1 IV 3.1" "special case"]
theorem Module.flat_mvPowerSeries_mvPolynomial (σ : Type*) [Finite σ] (R : Type*) [CommRing R]
    [IsNoetherianRing R] : Module.Flat (MvPolynomial σ R) (MvPowerSeries σ R) :=
  Module.Flat.of_linearEquiv (MvPowerSeries.toAdicCompletionAlgEquiv σ R).toLinearEquiv

namespace AlgebraicGeometry

variable (k : Type u) [Field k]

/-- The basic open `D(xᵢ)` of the `i`-th coordinate on the affine plane `Spec k[x, y]`. -/
noncomputable abbrev affinePlaneBasicOpen (i : Fin 2) :
    (Spec (CommRingCat.of (MvPolynomial (Fin 2) k))).Opens :=
  PrimeSpectrum.basicOpen (MvPolynomial.X i)

/-- The ideal of the origin of the affine plane is maximal: it is the kernel of the surjection
`k[x, y] → k` taking the constant coefficient. -/
private theorem isMaximal_affineOrigin : (affineOrigin k 2).asIdeal.IsMaximal :=
  RingHom.ker_isMaximal_of_surjective
    (MvPolynomial.constantCoeff : MvPolynomial (Fin 2) k →+* k)
    fun a ↦ ⟨MvPolynomial.C a, by simp⟩

/-- A point of the affine plane lying in neither `D(x)` nor `D(y)` is the origin: its ideal
contains both variables, hence contains every polynomial with zero constant coefficient, hence
equals the maximal ideal of the origin. -/
private theorem eq_affineOrigin_of_notMem_basicOpen
    (x : Spec (CommRingCat.of (MvPolynomial (Fin 2) k)))
    (h : ∀ i, x ∉ affinePlaneBasicOpen k i) :
    x = affineOrigin k 2 := by
  have hX : ∀ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) k) ∈ x.asIdeal :=
    fun i ↦ not_not.1 fun hi ↦ h i ((PrimeSpectrum.mem_basicOpen _ _).2 hi)
  have hle : (affineOrigin k 2).asIdeal ≤ x.asIdeal := by
    intro f hf
    have hspan : f ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) k)) := by
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact MvPolynomial.mem_support_iff.mp hm
          (by simpa [MvPolynomial.constantCoeff] using (RingHom.mem_ker).mp hf)
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨i, Set.mem_univ i, by simpa using hi⟩
    refine Ideal.span_le.2 ?_ hspan
    rintro - ⟨i, rfl⟩
    exact hX i
  exact (PrimeSpectrum.ext ((isMaximal_affineOrigin k).eq_of_le x.isPrime.ne_top hle)).symm

/-- The arrows of the fpqc coverings of the affine plane in the source: the two standard open
immersions `D(x) ⟶ 𝐀²_k` and `D(y) ⟶ 𝐀²_k`, together with a third morphism `g`. -/
noncomputable def affinePlaneArrows
    (g : Σ Y : Scheme.{u}, Y ⟶ Spec (CommRingCat.of (MvPolynomial (Fin 2) k))) :
    Fin 3 → Σ Y : Scheme.{u}, Y ⟶ Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) :=
  ![⟨_, (affinePlaneBasicOpen k 0).ι⟩, ⟨_, (affinePlaneBasicOpen k 1).ι⟩, g]

/-- The three-member family `{D(x) ⟶ 𝐀²_k, D(y) ⟶ 𝐀²_k, g}` on the affine plane, where the
first two morphisms are the standard open immersions and the third is a parameter. -/
noncomputable def affinePlaneCover
    (g : Σ Y : Scheme.{u}, Y ⟶ Spec (CommRingCat.of (MvPolynomial (Fin 2) k))) :
    PreZeroHypercover.{0} (Spec (CommRingCat.of (MvPolynomial (Fin 2) k))) where
  I₀ := Fin 3
  X i := (affinePlaneArrows k g i).1
  f i := (affinePlaneArrows k g i).2

/-- **Stacks Project, Tag 03NY.** Adjoining to the two standard open immersions
`D(x) ⟶ 𝐀²_k` and `D(y) ⟶ 𝐀²_k` a flat quasi-compact morphism whose image contains the origin
produces an fpqc covering of the affine plane. -/
theorem presieve₀_affinePlaneCover_mem_fpqcPrecoverage
    (g : Σ Y : Scheme.{u}, Y ⟶ Spec (CommRingCat.of (MvPolynomial (Fin 2) k)))
    (hflat : Flat g.2) (hqc : QuasiCompact g.2)
    (hg : affineOrigin k 2 ∈ Set.range g.2.base) :
    (affinePlaneCover k g).presieve₀ ∈
      Scheme.fpqcPrecoverage (Spec (CommRingCat.of (MvPolynomial (Fin 2) k))) := by
  have _ : IsAffine (affinePlaneBasicOpen k 0).toScheme := IsAffineOpen.Spec_basicOpen _
  have _ : IsAffine (affinePlaneBasicOpen k 1).toScheme := IsAffineOpen.Spec_basicOpen _
  have hflat' : ∀ i : Fin 3, Flat (affinePlaneArrows k g i).2 := by
    intro i
    fin_cases i
    · exact inferInstanceAs (Flat (affinePlaneBasicOpen k 0).ι)
    · exact inferInstanceAs (Flat (affinePlaneBasicOpen k 1).ι)
    · exact hflat
  have hqc' : ∀ i : Fin 3, QuasiCompact (affinePlaneArrows k g i).2 := by
    intro i
    fin_cases i
    · exact inferInstanceAs (QuasiCompact (affinePlaneBasicOpen k 0).ι)
    · exact inferInstanceAs (QuasiCompact (affinePlaneBasicOpen k 1).ι)
    · exact hqc
  have hsurj : ∀ x : Spec (CommRingCat.of (MvPolynomial (Fin 2) k)),
      ∃ i : Fin 3, x ∈ Set.range (affinePlaneArrows k g i).2 := by
    intro x
    by_contra! hx
    have hi : ∀ i : Fin 2, x ∉ affinePlaneBasicOpen k i := fun i hxi ↦
      hx i.castSucc (by
        fin_cases i
        · show x ∈ Set.range (affinePlaneBasicOpen k 0).ι
          rwa [Scheme.Opens.range_ι]
        · show x ∈ Set.range (affinePlaneBasicOpen k 1).ι
          rwa [Scheme.Opens.range_ι])
    exact hx 2 (by
      show x ∈ Set.range g.2.base
      rw [eq_affineOrigin_of_notMem_basicOpen k x hi]
      exact hg)
  refine ⟨?_, ?_⟩
  · rw [Scheme.presieve₀_mem_qcPrecoverage_iff]
    refine ⟨fun {U} hU ↦ ?_⟩
    have _ : Finite (affinePlaneCover k g).I₀ := inferInstanceAs (Finite (Fin 3))
    have _ : ∀ i, QuasiCompact ((affinePlaneCover k g).f i) := hqc'
    exact IsCompactOpenCovered.of_finite_of_isSpectralMap
      (fun i ↦ Scheme.Hom.isSpectralMap _) (fun x _ ↦ hsurj x) U.2 hU.isCompact
  · exact (Scheme.ofArrows_mem_precoverage_iff (P := @Flat)).2 ⟨hsurj, hflat'⟩

/-- **Stacks Project, Tag 03NY.** The family `{D(x) ⟶ 𝐀²_k, D(y) ⟶ 𝐀²_k,
Spec k[[x, y]] ⟶ 𝐀²_k}` is an fpqc covering of the affine plane. -/
@[stacks 03NY "power_series_covering"]
theorem presieve₀_affinePlanePowerSeriesCover_mem_fpqcPrecoverage :
    (affinePlaneCover k ⟨Spec (CommRingCat.of (MvPowerSeries (Fin 2) k)),
        Spec.map (CommRingCat.ofHom
          (algebraMap (MvPolynomial (Fin 2) k) (MvPowerSeries (Fin 2) k)))⟩).presieve₀ ∈
      Scheme.fpqcPrecoverage (Spec (CommRingCat.of (MvPolynomial (Fin 2) k))) := by
  refine presieve₀_affinePlaneCover_mem_fpqcPrecoverage k _ ?_ inferInstance ?_
  · exact Flat.SpecMap_iff.mpr
      (RingHom.flat_algebraMap_iff.mpr (Module.flat_mvPowerSeries_mvPolynomial (Fin 2) k))
  · refine ⟨⟨RingHom.ker (MvPowerSeries.constantCoeff (σ := Fin 2) (R := k)),
      RingHom.ker_isPrime _⟩, ?_⟩
    refine PrimeSpectrum.ext (Ideal.ext fun f ↦ ?_)
    show f ∈ Ideal.comap
        (algebraMap (MvPolynomial (Fin 2) k) (MvPowerSeries (Fin 2) k))
        (RingHom.ker (MvPowerSeries.constantCoeff (σ := Fin 2) (R := k))) ↔ _
    simp only [Ideal.mem_comap, RingHom.mem_ker, affineOrigin]
    rw [MvPowerSeries.algebraMap_apply', ← MvPowerSeries.coeff_zero_eq_constantCoeff_apply,
      MvPowerSeries.coeff_map, MvPolynomial.coeff_coe]
    simp [MvPolynomial.constantCoeff]

/-- **Stacks Project, Tag 03NY.** The family `{D(x) ⟶ 𝐀²_k, D(y) ⟶ 𝐀²_k,
Spec 𝒪_{𝐀²_k, 0} ⟶ 𝐀²_k}` is an fpqc covering of the affine plane. -/
@[stacks 03NY "local_ring_covering"]
theorem presieve₀_affinePlaneLocalRingCover_mem_fpqcPrecoverage :
    (affinePlaneCover k
        ⟨Spec ((Spec (CommRingCat.of (MvPolynomial (Fin 2) k))).presheaf.stalk
            (affineOrigin k 2)),
          (Spec (CommRingCat.of (MvPolynomial (Fin 2) k))).fromSpecStalk
            (affineOrigin k 2)⟩).presieve₀ ∈
      Scheme.fpqcPrecoverage (Spec (CommRingCat.of (MvPolynomial (Fin 2) k))) := by
  refine presieve₀_affinePlaneCover_mem_fpqcPrecoverage k _ (flat_fromSpecStalk _ _)
    inferInstance ?_
  rw [Scheme.range_fromSpecStalk]
  exact specializes_rfl

end AlgebraicGeometry
