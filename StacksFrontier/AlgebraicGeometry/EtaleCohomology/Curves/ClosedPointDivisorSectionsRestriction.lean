module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Curves.ClosedPointDivisorSections
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Curves.ClosedPointDivisorSheaf
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.DirectSumsOfEtaleCohomology
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.ExamplesSheaves.ConstantSheafSections
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.ExtensionByZero.Exactness
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GlobalSectionsClosed.InverseImage
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.LocalAcyclicity.SpecializationMap

/-!
# Restricting sections of `⨁_x i_{x,*} 𝐙` to an étale scheme mapping injectively

Let `X` be a scheme and `D = ⨁_{x ∈ X_0} i_{x,*} 𝐙` the coproduct, over the closed points of `X`,
of the skyscraper sheaves on the small étale site of `X`: the third term of the divisor sequence
of Stacks 03RI. Its sections over an étale `X`-scheme are in general only locally finite sums of
sections of the summands. Over an étale `X`-scheme `W` whose underlying scheme is quasi-compact
and quasi-separated, every section of `D` is a finite sum of sections of the summands, and for a
morphism `W ⟶ T` of the small étale site with `W ⟶ X` injective on points and `W` qcqs, the
restriction `D(T) → D(W)` is surjective.

## Main results

* `Stacks.EtaleCohomology.mem_closure_iUnion_range_of_isColimit`: the point of a coproduct
  cocone of abelian groups is generated by the images of the summands.
* `Stacks.EtaleCohomology.mem_closure_closedPointDivisorSheaf_sections`: sections of `D` over a
  qcqs étale `X`-scheme are generated by sections of the summands.
* `Stacks.EtaleCohomology.surjective_integerSkyscraper_map`: restriction of sections of
  `i_{x,*} 𝐙` along a morphism whose source maps injectively to `X` is surjective.
* `Stacks.EtaleCohomology.surjective_closedPointDivisorSheaf_map`: restriction of sections of
  `D` along such a morphism with qcqs source is surjective.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry AlgebraicGeometry.Scheme
open scoped AlgebraicGeometry.Scheme.SmallEtaleColimits

universe w v u

namespace Stacks.EtaleCohomology

attribute [local instance] Stacks.Cohomology.ColimitsOfCohomology.additive_sheafΓ
attribute [local instance 10000] hasCoproduct_closedPointSkyscraper

/-- `e.hom` is a left inverse of `e.inv` on sections, for a natural isomorphism `e` of functors
to abelian groups. -/
private theorem hom_app_inv_app_apply {J : Type*} [Category J] {F G : J ⥤ AddCommGrpCat.{w}}
    (e : F ≅ G) (j : J) (y : ToType (G.obj j)) : e.hom.app j (e.inv.app j y) = y :=
  Iso.inv_hom_id_apply (e.app j) y

/-- The point of a colimit cocone over a discrete diagram of abelian groups is generated by the
images of the summands. -/
theorem mem_closure_iUnion_range_of_isColimit {I : Type*} {F : Discrete I ⥤ AddCommGrpCat.{w}}
    {c : Cocone F} (hc : IsColimit c) (y : ToType c.pt) :
    y ∈ AddSubgroup.closure (⋃ i : I, Set.range
      (fun y : ToType (F.obj ⟨i⟩) => (show ToType c.pt from c.ι.app ⟨i⟩ y))) := by
  set H := AddSubgroup.closure (⋃ i : I, Set.range
    (fun y : ToType (F.obj ⟨i⟩) => (show ToType c.pt from c.ι.app ⟨i⟩ y)))
  let π : c.pt ⟶ AddCommGrpCat.of (ToType c.pt ⧸ H) :=
    AddCommGrpCat.ofHom (QuotientAddGroup.mk' H)
  have hπ : π = 0 := hc.hom_ext fun ⟨i⟩ => by
    refine AddCommGrpCat.hom_ext (AddMonoidHom.ext fun x => ?_)
    change (QuotientAddGroup.mk' H) (c.ι.app ⟨i⟩ x) = 0
    exact (QuotientAddGroup.eq_zero_iff _).2
      (AddSubgroup.subset_closure (Set.mem_iUnion.2 ⟨i, x, rfl⟩))
  exact (QuotientAddGroup.eq_zero_iff y).1
    (congrArg (fun f : c.pt ⟶ AddCommGrpCat.of (ToType c.pt ⧸ H) => f y) hπ)

/-- Sections of `⨁_x i_{x,*} 𝐙` over a quasi-compact quasi-separated étale `X`-scheme are
finite sums of sections of the summands. -/
theorem mem_closure_closedPointDivisorSheaf_sections (X : Scheme.{u}) (W : X.Etale)
    [CompactSpace W.left] [QuasiSeparatedSpace W.left]
    (s : ToType ((closedPointDivisorSheaf.{u, v} X).obj.obj (op W))) :
    s ∈ AddSubgroup.closure (⋃ x : closedPoints X,
      Set.range ⇑(ConcreteCategory.hom
        ((closedPointDivisorSheaf.ι.{u, v} X x).hom.app (op W)))) := by
  have : Etale W.hom := W.prop
  let Y := W.left
  let D := closedPointDivisorSheaf.{u, v} X
  let F := closedPointSkyscraper.{u, v} X
  let R := etaleRestriction.{u, v} W.hom
  let ΓY := Sheaf.Γ Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}
  have hΓ : PreservesColimitsOfShape (Discrete (closedPoints X)) ΓY := by
    have h0 := preservesColimitsOfShape_discrete_rightDerived_Γ_smallEtale.{v} Y 0
      (ULift.{max (u + 1) v} (closedPoints X))
    have h1 : PreservesColimitsOfShape (Discrete (ULift.{max (u + 1) v} (closedPoints X))) ΓY :=
      preservesColimitsOfShape_of_natIso (ΓY.rightDerivedZeroIsoSelf)
    exact preservesColimitsOfShape_of_equiv (Discrete.equivalence Equiv.ulift) ΓY
  have hc := isColimitOfPreserves (R ⋙ ΓY) (colimit.isColimit (Discrete.functor F))
  let T' := Scheme.Etale.mk (𝟙 Y)
  let e := Sheaf.ΓNatIsoSheafSections Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}
    (isTerminalEtaleMkId Y)
  let φ : (Scheme.Etale.smallEtaleCompose W.hom).obj T' ≅ W :=
    { hom := MorphismProperty.Over.homMk (𝟙 _) rfl trivial
      inv := MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans (Category.id_comp W.hom))
        trivial
      hom_inv_id := MorphismProperty.Over.Hom.ext (Category.id_comp (𝟙 _))
      inv_hom_id := MorphismProperty.Over.Hom.ext (Category.id_comp (𝟙 _)) }
  let Ψ : ToType (ΓY.obj (R.obj D)) →+ ToType (D.obj.obj (op W)) :=
    (D.obj.map φ.inv.op).hom.comp (e.hom.app (R.obj D)).hom
  have hs : s = Ψ (e.inv.app (R.obj D) (D.obj.map φ.hom.op s)) := by
    change s = D.obj.map φ.inv.op (e.hom.app (R.obj D) (e.inv.app (R.obj D)
      (D.obj.map φ.hom.op s)))
    exact ((D.obj.mapIso φ.op).hom_inv_id_apply s).symm.trans
      (congrArg (fun y => D.obj.map φ.inv.op y)
        (hom_app_inv_app_apply e (R.obj D) (D.obj.map φ.hom.op s)).symm)
  rw [hs]
  refine (show AddSubgroup.closure _ ≤ (AddSubgroup.closure _).comap Ψ from ?_)
    (mem_closure_iUnion_range_of_isColimit hc (e.inv.app (R.obj D) (D.obj.map φ.hom.op s)))
  refine (AddSubgroup.closure_le _).2 ?_
  rintro _ ⟨_, ⟨x, rfl⟩, z, rfl⟩
  refine AddSubgroup.subset_closure (Set.mem_iUnion.2
    ⟨x, (F x).obj.map φ.inv.op (e.hom.app (R.obj (F x)) z), ?_⟩)
  change _ = D.obj.map φ.inv.op (e.hom.app (R.obj D)
    (ΓY.map (R.map (closedPointDivisorSheaf.ι.{u, v} X x)) z))
  exact (NatTrans.naturality_apply (closedPointDivisorSheaf.ι.{u, v} X x).hom φ.inv.op _).trans
    (congrArg (fun y => D.obj.map φ.inv.op y)
      (NatTrans.naturality_apply e.hom (R.map (closedPointDivisorSheaf.ι.{u, v} X x)) z).symm)

/-- Restriction of sections of the skyscraper `i_{x,*} 𝐙` along a morphism of the small étale
site whose source maps injectively to `X` is surjective. -/
theorem surjective_integerSkyscraper_map (X : Scheme.{u}) (x : X) {W T : X.Etale} (f : W ⟶ T)
    (hW : Function.Injective W.hom.base) :
    Function.Surjective ((integerSkyscraper.{u, v} X x).obj.map f.op) := by
  let K := Spec (X.residueField x)
  let A := ULift.{max (u + 1) v} ℤ
  let L := smallEtaleConstantSheafIsoLocallyConstantMapsAb.{u, v} K A
  let g := (smallEtaleBaseChange (X.fromSpecResidueField x)).map f
  have hsub : Subsingleton ((smallEtaleBaseChange (X.fromSpecResidueField x)).obj W).left :=
    subsingleton_pullback_fromSpecResidueField W.hom x
      (fun a ha b hb => hW (ha.trans hb.symm))
  intro z
  let w : LocallyConstant ((smallEtaleBaseChange (X.fromSpecResidueField x)).obj W).left A :=
    L.hom.app _ z
  obtain ⟨w', hw'⟩ : ∃ w' : ToType ((smallEtaleLocallyConstantMapsAb.{u, max (u + 1) v} K A).obj
      (op ((smallEtaleBaseChange (X.fromSpecResidueField x)).obj T))),
      (smallEtaleLocallyConstantMapsAb.{u, max (u + 1) v} K A).map g.op w' = w := by
    by_cases hne : Nonempty ((smallEtaleBaseChange (X.fromSpecResidueField x)).obj W).left
    · obtain ⟨p⟩ := hne
      refine ⟨LocallyConstant.const _ (w p), LocallyConstant.ext fun q => ?_⟩
      change w p = w q
      rw [@Subsingleton.elim _ hsub q p]
    · exact ⟨0, LocallyConstant.ext fun q => (hne ⟨q⟩).elim⟩
  refine ⟨L.inv.app _ w', ?_⟩
  apply (ConcreteCategory.bijective_of_isIso (L.hom.app (op
    ((smallEtaleBaseChange (X.fromSpecResidueField x)).obj W)))).1
  change L.hom.app _ (((constantSheaf K.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}).obj
    (AddCommGrpCat.of A)).obj.map g.op (L.inv.app _ w')) = w
  rwa [NatTrans.naturality_apply L.hom g.op, hom_app_inv_app_apply]

/-- Restriction of sections of `⨁_x i_{x,*} 𝐙` along a morphism `W ⟶ T` of the small étale
site is surjective when `W` is quasi-compact and quasi-separated and maps injectively to `X`. -/
theorem surjective_closedPointDivisorSheaf_map (X : Scheme.{u}) {W T : X.Etale} (f : W ⟶ T)
    [CompactSpace W.left] [QuasiSeparatedSpace W.left] (hW : Function.Injective W.hom.base) :
    Function.Surjective ((closedPointDivisorSheaf.{u, v} X).obj.map f.op) := by
  intro s
  have hle : AddSubgroup.closure (⋃ x : closedPoints X,
      Set.range ⇑(ConcreteCategory.hom ((closedPointDivisorSheaf.ι.{u, v} X x).hom.app (op W)))) ≤
      ((closedPointDivisorSheaf.{u, v} X).obj.map f.op).hom.range := by
    rw [AddSubgroup.closure_le]
    rintro _ ⟨_, ⟨x, rfl⟩, t, rfl⟩
    obtain ⟨t', rfl⟩ := surjective_integerSkyscraper_map.{v} X x.1 f hW t
    exact ⟨(closedPointDivisorSheaf.ι.{u, v} X x).hom.app (op T) t',
      (NatTrans.naturality_apply (closedPointDivisorSheaf.ι.{u, v} X x).hom f.op t').symm⟩
  exact hle (mem_closure_closedPointDivisorSheaf_sections.{v} X W s)

end Stacks.EtaleCohomology

end
