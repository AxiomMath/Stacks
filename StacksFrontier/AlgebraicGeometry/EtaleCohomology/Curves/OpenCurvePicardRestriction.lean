module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Curves.ClassGroupPicardBaseChange
public import StacksFrontier.AlgebraicGeometry.Curves.ZetaFunction.PointDivisorClass
public import StacksFrontier.AlgebraicGeometry.Chow.ProperPushforwardPrincipal.OrdPreimmersion
public import StacksFrontier.AlgebraicGeometry.Chow.RationalFunctions.OpenImmersion
public import StacksFrontier.AlgebraicGeometry.Properties.ReducedSubschemeSmoothPullback
public import StacksFrontier.Algebra.Group.EigenvectorCount

/-!
# The Picard group of an open subcurve

Let `S ⊆ C` be a nonempty open subscheme of a smooth curve `C` over a field, both smooth curves.
On divisors supported on closed points, restriction to `S` forgets the points of `C ∖ S`; it is
compatible with principal divisors, because an open immersion does not change orders of
vanishing, and with pullback of Picard classes, because the pullback of the reduced closed point
`x` is the reduced closed point over it, or empty. Hence `Pic(C) → Pic(S)` is surjective and its
kernel is generated by the classes of the closed points of `C ∖ S`.

## Main definitions

* `Stacks.EtaleCohomology.curveDivisorPicardHom`: the class map `D ↦ [𝒪(D)]` from divisors on
  closed points to `Pic`.
* `Stacks.EtaleCohomology.restrictCurveDivisor`: restriction of divisors to an open subcurve.

## Main results

* `Stacks.EtaleCohomology.schemePullbackClassHom_curveDivisorPicardHom`: restriction of divisors
  and pullback of classes agree.
* `Stacks.EtaleCohomology.surjective_schemePullbackClassHom_of_isOpenImmersion`: `Pic(C) → Pic(S)`
  is surjective.
* `Stacks.EtaleCohomology.exists_curveDivisorPicardHom_eq_of_schemePullbackClassHom_eq_zero`:
  its kernel consists of the classes of divisors supported on `C ∖ S`.
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace AlgebraicGeometry

universe u

namespace Stacks.EtaleCohomology

attribute [local instance] AlgebraicGeometry.SmallEtale.zariskiPicardAddCommGroup
  AlgebraicGeometry.schemePicardGroupAddCommGroup

section Divisor

variable {K : Type u} [Field K] {C : Scheme.{u}} (g : C ⟶ Spec (.of K)) [IsCurve K g] [Smooth g]
  [IsLocallyNoetherian C] [AlgebraicGeometry.IsNoetherian C]

/-- `Cl(C) ≅ Pic(C)` for a smooth curve, in the model `Stacks.Picard.ofScheme` of `Pic(C)`. -/
def closedPointClassGroupAddEquivPicard : closedPointClassGroup C ≃+ Stacks.Picard.ofScheme C :=
  (closedPointClassGroupAddEquivSchemePicard g).trans
    (Stacks.GluePicard.picardModelAddEquiv C.toRingedSpace).symm

/-- **The Picard class of a divisor on the closed points of a smooth curve**, `D ↦ [𝒪(D)]`. -/
def curveDivisorPicardHom : (closedPoints C →₀ ℤ) →+ Stacks.Picard.ofScheme C :=
  (closedPointClassGroupAddEquivPicard g).toAddMonoidHom.comp
    (QuotientAddGroup.mk' (closedPointDivisorOfUnit C).range)

/-- Every Picard class of a smooth curve is the class of a divisor on its closed points. -/
theorem surjective_curveDivisorPicardHom : Function.Surjective (curveDivisorPicardHom g) :=
  (closedPointClassGroupAddEquivPicard g).surjective.comp (QuotientAddGroup.mk'_surjective _)

/-- The divisors with trivial class are the principal ones. -/
theorem curveDivisorPicardHom_eq_zero_iff (D : closedPoints C →₀ ℤ) :
    curveDivisorPicardHom g D = 0 ↔ D ∈ (closedPointDivisorOfUnit C).range := by
  change closedPointClassGroupAddEquivPicard g (QuotientAddGroup.mk D) = 0 ↔ _
  rw [AddEquiv.map_eq_zero_iff, QuotientAddGroup.eq_zero_iff]

/-- **The class of a closed point** is the class of the reduced closed point. -/
theorem curveDivisorPicardHom_single (x : closedPoints C) :
    haveI := isEffectiveCartierDivisor_closedPoint g x
    curveDivisorPicardHom g (Finsupp.single x 1) = Stacks.Divisors.picardClass
      (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({x.1} : Set C))) := by
  have := isEffectiveCartierDivisor_closedPoint g x
  change (Stacks.GluePicard.picardModelAddEquiv C.toRingedSpace).symm
    (closedPointClassGroupAddEquivSchemePicard g (QuotientAddGroup.mk (Finsupp.single x 1))) = _
  rw [closedPointClassGroupAddEquivSchemePicard_single, ← picardModelAddEquiv_picardClass,
    AddEquiv.symm_apply_apply]

end Divisor

section OpenImmersion

variable {K : Type u} [Field K] {C S : Scheme.{u}} (g : C ⟶ Spec (.of K)) (gS : S ⟶ Spec (.of K))
  [IsCurve K g] [IsCurve K gS] (j : S ⟶ C) [IsOpenImmersion j]
  [IsLocallyNoetherian C] [AlgebraicGeometry.IsNoetherian C] [IsLocallyNoetherian S]
  [AlgebraicGeometry.IsNoetherian S]

omit [IsLocallyNoetherian C] [AlgebraicGeometry.IsNoetherian C] [IsLocallyNoetherian S]
  [AlgebraicGeometry.IsNoetherian S] in
include g gS in
/-- An open immersion of curves maps closed points to closed points. -/
theorem isClosed_singleton_base_of_isOpenImmersion (x : closedPoints S) :
    IsClosed ({j.base x.1} : Set C) := by
  have : IsDominant j := ⟨(j.isOpenMap.isOpen_range).dense (Set.range_nonempty _)⟩
  refine isClosed_singleton_of_coheight_eq_one g ?_
  rw [Stacks.Chow.coheight_eq_of_isDominant_of_isPreimmersion j]
  exact IsCurve.coheight_eq_one (f := gS) (ne_genericPoint_of_mem_closedPoints_of_isCurve gS x)

/-- The closed point `j x` of `C`, for a closed point `x` of an open subcurve `S`. -/
def closedPointOfOpenImmersion (x : closedPoints S) : closedPoints C :=
  ⟨j.base x.1, isClosed_singleton_base_of_isOpenImmersion g gS j x⟩

omit [IsLocallyNoetherian C] [AlgebraicGeometry.IsNoetherian C] [IsLocallyNoetherian S]
  [AlgebraicGeometry.IsNoetherian S] in
/-- The map `closedPointOfOpenImmersion` on closed points is injective. -/
theorem injective_closedPointOfOpenImmersion :
    Function.Injective (closedPointOfOpenImmersion g gS j) := fun _ _ h =>
  Subtype.ext (j.isOpenEmbedding.injective (congrArg Subtype.val h))

omit [IsLocallyNoetherian C] [AlgebraicGeometry.IsNoetherian C] [IsLocallyNoetherian S]
  [AlgebraicGeometry.IsNoetherian S] in
/-- A closed point of `C` lies in `S` exactly when it is the image of a closed point of `S`. -/
theorem mem_range_closedPointOfOpenImmersion_iff (b : closedPoints C) :
    b ∈ Set.range (closedPointOfOpenImmersion g gS j) ↔ b.1 ∈ Set.range j.base := by
  refine ⟨fun ⟨x, hx⟩ => ⟨x.1, congrArg Subtype.val hx⟩, fun ⟨y, hy⟩ => ?_⟩
  have hyc : IsClosed ({y} : Set S) := by
    have h : j.base ⁻¹' {b.1} = {y} := by
      ext z
      simp only [Set.mem_preimage, Set.mem_singleton_iff, ← hy]
      exact j.isOpenEmbedding.injective.eq_iff
    exact h ▸ b.2.preimage j.base.hom.continuous
  exact ⟨⟨y, hyc⟩, Subtype.ext hy⟩

/-- **Restriction of divisors** to an open subcurve: forget the points of the complement. -/
def restrictCurveDivisor : (closedPoints C →₀ ℤ) →+ (closedPoints S →₀ ℤ) :=
  Finsupp.comapDomain.addMonoidHom (injective_closedPointOfOpenImmersion g gS j)

omit [IsLocallyNoetherian C] [AlgebraicGeometry.IsNoetherian C] [IsLocallyNoetherian S]
  [AlgebraicGeometry.IsNoetherian S] in
/-- The multiplicity of the restricted divisor at `x` is that of `D` at the image of `x`. -/
theorem restrictCurveDivisor_apply (D : closedPoints C →₀ ℤ) (x : closedPoints S) :
    restrictCurveDivisor g gS j D x = D (closedPointOfOpenImmersion g gS j x) := rfl

/-- **Restriction of principal divisors**: an open immersion does not change orders of
vanishing. -/
theorem restrictCurveDivisor_closedPointDivisorOfUnit (f : Additive C.functionFieldˣ) :
    haveI : IsDominant j := ⟨(j.isOpenMap.isOpen_range).dense (Set.range_nonempty _)⟩
    restrictCurveDivisor g gS j (closedPointDivisorOfUnit C f) = closedPointDivisorOfUnit S
      (Additive.ofMul (Units.map (dominantFunctionFieldMap j).toMonoidHom (Additive.toMul f))) := by
  have : IsDominant j := ⟨(j.isOpenMap.isOpen_range).dense (Set.range_nonempty _)⟩
  ext x
  rw [restrictCurveDivisor_apply, closedPointDivisorOfUnit_apply, closedPointDivisorOfUnit_apply]
  exact (Stacks.Chow.ord_dominantFunctionFieldMap_of_isPreimmersion j _ x.1).symm

variable [Smooth g] [Smooth gS]

/-- **Pullback to an open subcurve of the class of a divisor is the class of the restricted
divisor.** -/
theorem schemePullbackClassHom_curveDivisorPicardHom (D : closedPoints C →₀ ℤ) :
    Stacks.Picard.schemePullbackClassHom j (curveDivisorPicardHom g D) =
      curveDivisorPicardHom gS (restrictCurveDivisor g gS j D) := by
  classical
  induction D using Finsupp.induction_linear with
  | zero => simp only [map_zero]
  | add D₁ D₂ h₁ h₂ => simp only [map_add, h₁, h₂]
  | single x n =>
    rw [← Finsupp.smul_single_one, map_zsmul, map_zsmul, map_zsmul, map_zsmul]
    congr 1
    have := isEffectiveCartierDivisor_closedPoint g x
    have hD : Stacks.Divisors.IsPullbackDefined j
        (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({x.1} : Set C))) :=
      Stacks.Divisors.isPullbackDefined_of_flat j _ inferInstance
    have : Stacks.Divisors.IsEffectiveCartierDivisor
        ((Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({x.1} : Set C))).comap j) := hD
    change Stacks.Picard.schemePullbackClass j (curveDivisorPicardHom g (Finsupp.single x 1)) = _
    rw [curveDivisorPicardHom_single, Stacks.Zeta.schemePullbackClass_picardClass_comap j _ hD]
    by_cases hx : x ∈ Set.range (closedPointOfOpenImmersion g gS j)
    · obtain ⟨x', rfl⟩ := hx
      have := isEffectiveCartierDivisor_closedPoint gS x'
      have hcomap : (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure
          ({(closedPointOfOpenImmersion g gS j x').1} : Set C))).comap j =
          Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({x'.1} : Set S)) := by
        refine Scheme.IdealSheafData.comap_vanishingIdeal_of_smooth j _ _ ?_
        rw [Closeds.coe_closure, Closeds.coe_closure, x'.2.closure_eq,
          (closedPointOfOpenImmersion g gS j x').2.closure_eq]
        ext y
        simp only [Set.mem_singleton_iff, Set.mem_preimage]
        exact ⟨fun h => h ▸ rfl, fun h => j.isOpenEmbedding.injective h⟩
      rw [Stacks.Divisors.picardClass_congr hcomap, restrictCurveDivisor,
        Finsupp.comapDomain.addMonoidHom_apply, Finsupp.comapDomain_single,
        curveDivisorPicardHom_single]
    · have hcomap : (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure
          ({x.1} : Set C))).comap j = ⊤ := by
        rw [Scheme.IdealSheafData.comap_vanishingIdeal_of_smooth j _ ⊥ ?_,
          Scheme.IdealSheafData.vanishingIdeal_bot]
        rw [Closeds.coe_closure, x.2.closure_eq, Closeds.coe_bot, eq_comm,
          Set.eq_empty_iff_forall_notMem]
        intro y hy
        exact hx ((mem_range_closedPointOfOpenImmersion_iff g gS j x).2 ⟨y, hy⟩)
      rw [Stacks.Divisors.picardClass_congr hcomap, Stacks.Divisors.picardClass_top,
        restrictCurveDivisor, Finsupp.comapDomain.addMonoidHom_apply,
        Finsupp.comapDomain_single_of_notMem_range hx, map_zero]

include g gS in
/-- **`Pic(C) → Pic(S)` is surjective** for an open subcurve `S ⊆ C`: a divisor on `S` extends
by zero. -/
theorem surjective_schemePullbackClassHom_of_isOpenImmersion :
    Function.Surjective (Stacks.Picard.schemePullbackClassHom j) := by
  intro s
  obtain ⟨D, rfl⟩ := surjective_curveDivisorPicardHom gS s
  refine ⟨curveDivisorPicardHom g (Finsupp.mapDomain (closedPointOfOpenImmersion g gS j) D), ?_⟩
  rw [schemePullbackClassHom_curveDivisorPicardHom g gS, restrictCurveDivisor,
    Finsupp.comapDomain.addMonoidHom_apply,
    Finsupp.comapDomain_mapDomain _ (injective_closedPointOfOpenImmersion g gS j)]

/-- **The kernel of `Pic(C) → Pic(S)` consists of classes of divisors supported on `C ∖ S`**:
if `D|_S = div(f)`, then `D - div(f)` is supported on `C ∖ S`. -/
theorem exists_curveDivisorPicardHom_eq_of_schemePullbackClassHom_eq_zero
    (l : Stacks.Picard.ofScheme C) (hl : Stacks.Picard.schemePullbackClassHom j l = 0) :
    ∃ D : closedPoints C →₀ ℤ, (∀ b ∈ D.support, b ∉ Set.range (closedPointOfOpenImmersion g gS j))
      ∧ curveDivisorPicardHom g D = l := by
  classical
  have : IsDominant j := ⟨(j.isOpenMap.isOpen_range).dense (Set.range_nonempty _)⟩
  obtain ⟨D, rfl⟩ := surjective_curveDivisorPicardHom g l
  rw [schemePullbackClassHom_curveDivisorPicardHom g gS, curveDivisorPicardHom_eq_zero_iff] at hl
  obtain ⟨f, hf⟩ := hl
  set e := Stacks.Chow.functionFieldEquiv_openImmersion j
  set f' : Additive C.functionFieldˣ :=
    Additive.ofMul (Units.map e.symm.toRingHom.toMonoidHom (Additive.toMul f))
  have hf' : Additive.ofMul (Units.map (dominantFunctionFieldMap j).toMonoidHom
      (Additive.toMul f')) = f := by
    apply Additive.toMul.injective
    apply Units.ext
    change dominantFunctionFieldMap j (e.symm _) = _
    rw [← Stacks.Chow.functionFieldEquiv_openImmersion_eq_dominantFunctionFieldMap,
      RingEquiv.apply_symm_apply]
  have hres : restrictCurveDivisor g gS j (D - closedPointDivisorOfUnit C f') = 0 := by
    rw [map_sub, restrictCurveDivisor_closedPointDivisorOfUnit, hf', hf, sub_self]
  refine ⟨D - closedPointDivisorOfUnit C f', ?_, ?_⟩
  · rintro b hb ⟨x', rfl⟩
    have h := DFunLike.congr_fun hres x'
    rw [restrictCurveDivisor_apply, Finsupp.zero_apply] at h
    exact (Finsupp.mem_support_iff.1 hb) h
  · rw [map_sub, (curveDivisorPicardHom_eq_zero_iff g _).2 ⟨f', rfl⟩, sub_zero]

/-- **An automorphism fixing the points of `C ∖ S` fixes the kernel of `Pic(C) → Pic(S)`**: it
fixes the class of each point of `C ∖ S`, `σ^*[𝒪(b)] = [𝒪(σ⁻¹ b)]`. -/
theorem schemePullbackClass_eq_self_of_schemePullbackClassHom_eq_zero (σ : C ⟶ C) [IsIso σ]
    (hσ : ∀ b : closedPoints C, b ∉ Set.range (closedPointOfOpenImmersion g gS j) →
      σ.base b.1 = b.1)
    (l : Stacks.Picard.ofScheme C) (hl : Stacks.Picard.schemePullbackClassHom j l = 0) :
    Stacks.Picard.schemePullbackClass σ l = l := by
  classical
  obtain ⟨D, hD, rfl⟩ :=
    exists_curveDivisorPicardHom_eq_of_schemePullbackClassHom_eq_zero g gS j l hl
  change Stacks.Picard.schemePullbackClassHom σ (curveDivisorPicardHom g D) = _
  conv_lhs => rw [← Finsupp.sum_single D]
  conv_rhs => rw [← Finsupp.sum_single D]
  rw [map_finsuppSum, map_finsuppSum]
  refine Finsupp.sum_congr fun b hb => ?_
  rw [← Finsupp.smul_single_one, map_zsmul, map_zsmul]
  congr 1
  have := isEffectiveCartierDivisor_closedPoint g b
  have hpd : Stacks.Divisors.IsPullbackDefined σ
      (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({b.1} : Set C))) :=
    Stacks.Divisors.isPullbackDefined_of_flat σ _ inferInstance
  have : Stacks.Divisors.IsEffectiveCartierDivisor
      ((Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({b.1} : Set C))).comap σ) := hpd
  have hcomap : (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({b.1} : Set C))).comap σ =
      Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({b.1} : Set C)) := by
    refine Scheme.IdealSheafData.comap_vanishingIdeal_of_smooth σ _ _ ?_
    rw [Closeds.coe_closure, b.2.closure_eq]
    ext y
    simp only [Set.mem_singleton_iff, Set.mem_preimage]
    refine ⟨fun h => h ▸ hσ b (hD b hb), fun h => σ.isOpenEmbedding.injective ?_⟩
    rw [h, hσ b (hD b hb)]
  change Stacks.Picard.schemePullbackClass σ (curveDivisorPicardHom g (Finsupp.single b 1)) = _
  rw [curveDivisorPicardHom_single, Stacks.Zeta.schemePullbackClass_picardClass_comap σ _ hpd,
    Stacks.Divisors.picardClass_congr hcomap]

include g gS in
/-- **Eigenvectors in `Pic` of an open subcurve.** Let `σ` be an automorphism of `C` restricting
to `σS` on `S` and fixing the points of `C ∖ S`. The `N`-torsion `Q`-eigenvectors of `σS^*` on
`Pic(S)` are at most those of `σ^*` on `Pic(C)` times `#(ℤ^{C ∖ S}/(Q - 1)) · #Pic(C)[Q - 1]`. -/
theorem encard_torsion_eigen_le_of_isOpenImmersion (σ : C ⟶ C) [IsIso σ] (σS : S ⟶ S)
    (hcomm : σS ≫ j = j ≫ σ)
    (hfix : ∀ b : closedPoints C, b.1 ∉ Set.range j.base → σ.base b.1 = b.1) (N Q : ℤ) :
    {z : Stacks.Picard.ofScheme S | N • z = 0 ∧
        Stacks.Picard.schemePullbackClassHom σS z = Q • z}.encard ≤
      {w : Stacks.Picard.ofScheme C | N • w = 0 ∧
          Stacks.Picard.schemePullbackClassHom σ w = Q • w}.encard *
        ((Set.univ : Set (({b : closedPoints C // b.1 ∉ Set.range j.base} →₀ ℤ) ⧸
            (zsmulAddGroupHom (α := {b : closedPoints C // b.1 ∉ Set.range j.base} →₀ ℤ)
              (Q - 1)).range)).encard *
          {w : Stacks.Picard.ofScheme C | (Q - 1) • w = 0}.encard) := by
  classical
  have hBiff : ∀ b : closedPoints C,
      b ∉ Set.range (closedPointOfOpenImmersion g gS j) ↔ b.1 ∉ Set.range j.base := fun b =>
    not_congr (mem_range_closedPointOfOpenImmersion_iff g gS j b)
  have hsurj := surjective_schemePullbackClassHom_of_isOpenImmersion g gS j
  refine (Stacks.EigenvectorCount.encard_torsion_eigen_le_mul_of_surjective
    (P := Stacks.Picard.ofScheme S) (P' := Stacks.Picard.ofScheme C)
    (Stacks.Picard.schemePullbackClassHom σ) (Stacks.Picard.schemePullbackClassHom σS)
    (Stacks.Picard.schemePullbackClassHom j) hsurj ?_ ?_ N Q).trans (mul_le_mul' le_rfl ?_)
  · intro w
    change Stacks.Picard.schemePullbackClass j (Stacks.Picard.schemePullbackClass σ w) =
      Stacks.Picard.schemePullbackClass σS (Stacks.Picard.schemePullbackClass j w)
    rw [Stacks.Picard.schemePullbackClass_comp, Stacks.Picard.schemePullbackClass_comp, hcomm]
  · exact schemePullbackClass_eq_self_of_schemePullbackClassHom_eq_zero g gS j σ
      fun b hb => hfix b ((hBiff b).1 hb)
  let ψ : ({b : closedPoints C // b.1 ∉ Set.range j.base} →₀ ℤ) →+ Stacks.Picard.ofScheme C :=
    (curveDivisorPicardHom g).comp (Finsupp.mapDomain.addMonoidHom Subtype.val)
  have hrψ : ∀ D, Stacks.Picard.schemePullbackClassHom j (ψ D) = 0 := by
    intro D
    change Stacks.Picard.schemePullbackClassHom j (curveDivisorPicardHom g
      (Finsupp.mapDomain Subtype.val D)) = 0
    rw [schemePullbackClassHom_curveDivisorPicardHom g gS]
    convert map_zero (curveDivisorPicardHom gS)
    ext x
    rw [restrictCurveDivisor_apply, Finsupp.zero_apply]
    refine Finsupp.mapDomain_of_notMem_range _ _ ?_
    rintro ⟨b, hb⟩
    exact (hBiff _).2 (hb ▸ b.2) ⟨x, rfl⟩
  have hψ : ∀ l, Stacks.Picard.schemePullbackClassHom j l = 0 → ∃ D, ψ D = l := by
    intro l hl
    obtain ⟨D, hD, rfl⟩ :=
      exists_curveDivisorPicardHom_eq_of_schemePullbackClassHom_eq_zero g gS j l hl
    refine ⟨Finsupp.comapDomain Subtype.val D Subtype.val_injective.injOn, ?_⟩
    change curveDivisorPicardHom g (Finsupp.mapDomain Subtype.val _) = _
    rw [Finsupp.mapDomain_comapDomain _ Subtype.val_injective]
    intro b hb
    exact ⟨⟨b, (hBiff b).1 (hD b hb)⟩, rfl⟩
  exact Stacks.EigenvectorCount.encard_torsion_le_mul_of_surjective
    (P := Stacks.Picard.ofScheme S) (P' := Stacks.Picard.ofScheme C)
    (Stacks.Picard.schemePullbackClassHom j) hsurj ψ hrψ hψ (Q - 1)

end OpenImmersion

end Stacks.EtaleCohomology
