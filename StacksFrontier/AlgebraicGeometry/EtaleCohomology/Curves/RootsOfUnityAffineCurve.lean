@[expose] public noncomputable section

open CategoryTheory Opposite

universe t u

namespace AlgebraicGeometry

/-! ### Extensions of free `ℤ/nℤ`-modules of finite rank

An extension of abelian groups `0 → (𝐙/n𝐙)^a → G → (𝐙/n𝐙)^b → 0` need not split. An extension of
`ℤ/nℤ`-modules does, the quotient being free hence projective; and an abelian group annihilated
by `n` is a `ℤ/nℤ`-module. -/

/-- The splitting of a surjection of `ℤ/nℤ`-modules onto a free module of finite rank: the
module is the product of the kernel and the quotient. -/
private def addEquivKerProdOfRightInverse {n : ℕ} {G : Type*} [AddCommGroup G]
    [Module (ZMod n) G] {b : ℕ} (π : G →+ (Fin b → ZMod n))
    (s : (Fin b → ZMod n) →ₗ[ZMod n] G) (hs : ∀ v, π (s v) = v) :
    G ≃+ ↥π.ker × (Fin b → ZMod n) where
  toFun x := (⟨x - s (π x), by simp [AddMonoidHom.mem_ker, hs]⟩, π x)
  invFun p := (p.1 : G) + s p.2
  left_inv x := by simp
  right_inv p := by
    obtain ⟨⟨y, hy⟩, v⟩ := p
    have hy0 : π y = 0 := hy
    have h1 : π ((y : G) + s v) = v := by rw [map_add, hs, hy0, zero_add]
    exact Prod.ext (Subtype.ext (by simp [h1])) h1
  map_add' x y := by
    refine Prod.ext (Subtype.ext ?_) (map_add _ _ _)
    simp only [map_add, Prod.fst_add, AddSubgroup.coe_add, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
    abel

/-- A surjection onto a free `ℤ/nℤ`-module of finite rank whose kernel is free of finite rank
has free source, of the sum of the two ranks. -/
private theorem nonempty_addEquiv_fin_zmod_of_module {n : ℕ} {G : Type*} [AddCommGroup G]
    [Module (ZMod n) G] {a b : ℕ} (π : G →+ (Fin b → ZMod n))
    (hlin : ∀ (r : ZMod n) (x : G), π (r • x) = r • π x)
    (hπ : Function.Surjective π) (e : ↥π.ker ≃+ (Fin a → ZMod n)) :
    Nonempty (G ≃+ (Fin (a + b) → ZMod n)) := by
  let πl : G →ₗ[ZMod n] (Fin b → ZMod n) :=
    { toFun := π, map_add' := π.map_add, map_smul' := hlin }
  obtain ⟨s, hs⟩ :=
    LinearMap.exists_rightInverse_of_surjective πl (LinearMap.range_eq_top.2 hπ)
  exact ⟨(addEquivKerProdOfRightInverse π s (LinearMap.congr_fun hs)).trans
    (((e.prodCongr (AddEquiv.refl _)).trans
      (LinearEquiv.sumArrowLequivProdArrow (Fin a) (Fin b) (ZMod n) (ZMod n)).toAddEquiv.symm).trans
      (LinearEquiv.funCongrLeft (ZMod n) (ZMod n)
        (finSumFinEquiv (m := a) (n := b))).toAddEquiv.symm)⟩

/-- **An extension of a free `ℤ/nℤ`-module of finite rank by another is free of the sum of the
ranks.** Let `G` be an abelian group annihilated by `n`, let `π : G ⟶ (𝐙/n𝐙)^b` be onto and let
its kernel be `(𝐙/n𝐙)^a`. Then `G ≅ (𝐙/n𝐙)^{a + b}`.

Annihilation by `n` is what makes `G` a `ℤ/nℤ`-module; without it the conclusion is false, as
`0 → 𝐙/p𝐙 → 𝐙/p²𝐙 → 𝐙/p𝐙 → 0` shows. Given it, the quotient is a free and hence projective
`ℤ/nℤ`-module, so the surjection splits. -/
theorem nonempty_addEquiv_fin_zmod_of_surjective {n : ℕ} {G : Type*} [AddCommGroup G]
    (htor : ∀ x : G, n • x = 0) {a b : ℕ} (π : G →+ (Fin b → ZMod n))
    (hπ : Function.Surjective π) (e : ↥π.ker ≃+ (Fin a → ZMod n)) :
    Nonempty (G ≃+ (Fin (a + b) → ZMod n)) := by
  let : Module (ZMod n) G := AddCommGroup.zmodModule htor
  exact nonempty_addEquiv_fin_zmod_of_module π
    (fun r x => ZMod.map_smul π r x) hπ e

/-! ### `H^q_ét(X, μ_n)` is annihilated by `n` -/

/-- **The sheaf of `n`-th roots of unity is annihilated by `n`**: it is the kernel of `n · 𝟙` on
the sheaf of units, and the kernel inclusion is a monomorphism. -/
private theorem nsmul_id_rootsOfUnitySheaf_eq_zero {C : Type*} [Category C]
    (J : GrothendieckTopology C) (F : C ⥤ Scheme.{u})
    (hF : Presheaf.IsSheaf J (unitsPresheaf F)) (n : ℕ) :
    n • 𝟙 (rootsOfUnitySheaf J F hF n) = 0 := by
  show n • 𝟙 (Limits.kernel (powerSheaf J F hF n)) = 0
  have hpow : powerSheaf J F hF n = n • 𝟙 (unitsSheaf J F hF) := rfl
  have hnf : n • Limits.kernel.ι (powerSheaf J F hF n) = 0 := by
    have h := Limits.kernel.condition (powerSheaf J F hF n)
    rw [hpow, Preadditive.comp_nsmul, Category.comp_id] at h
    exact h
  exact (cancel_mono (Limits.kernel.ι (powerSheaf J F hF n))).1
    (by rw [Preadditive.nsmul_comp, Category.id_comp, hnf, Limits.zero_comp])

/-- Cohomology kills the zero morphism. -/
private theorem sheafH_map_zero_apply {C : Type*} [Category C] {J : GrothendieckTopology C}
    [HasSheafify J AddCommGrpCat.{u}] [HasExt.{t} (Sheaf J AddCommGrpCat.{u})]
    {F G : Sheaf J AddCommGrpCat.{u}} (q : ℕ) (x : Sheaf.H.{t, u} F q) :
    Sheaf.H.map (0 : F ⟶ G) q x = 0 := by
  have h := Sheaf.H.map_add_apply (0 : F ⟶ G) (0 : F ⟶ G) x
  rw [add_zero] at h
  exact (add_left_cancel ((add_zero (Sheaf.H.map (0 : F ⟶ G) q x)).trans h)).symm

/-- Cohomology carries `n · 𝟙` to multiplication by `n`. -/
private theorem sheafH_map_nsmul_id_apply {C : Type*} [Category C] {J : GrothendieckTopology C}
    [HasSheafify J AddCommGrpCat.{u}] [HasExt.{t} (Sheaf J AddCommGrpCat.{u})]
    (F : Sheaf J AddCommGrpCat.{u}) (q m : ℕ) (x : Sheaf.H.{t, u} F q) :
    Sheaf.H.map (m • 𝟙 F) q x = m • x := by
  induction m with
  | zero => rw [zero_nsmul, zero_nsmul, sheafH_map_zero_apply]
  | succ m ih =>
    rw [succ_nsmul, Sheaf.H.map_add_apply, ih, Sheaf.H.map_id_apply, succ_nsmul]

/-- **`H^q_ét(X, μ_n)` is annihilated by `n`.** The sheaf of `n`-th roots of unity is the kernel
of the `n`-th power map `n · 𝟙` on the sheaf of units, so `n · 𝟙` vanishes on it; cohomology is
additive, so `n · 𝟙` vanishes on `H^q` too.

This is what makes every roots-of-unity cohomology group a `ℤ/nℤ`-module, which is what
`AlgebraicGeometry.nonempty_addEquiv_fin_zmod_of_surjective` needs of it. -/
theorem nsmul_sheafH_rootsOfUnitySheaf_eq_zero {C : Type*} [Category C]
    (J : GrothendieckTopology C) (F : C ⥤ Scheme.{u})
    (hF : Presheaf.IsSheaf J (unitsPresheaf F)) (n : ℕ)
    [HasSheafify J AddCommGrpCat.{u}] [HasExt.{t} (Sheaf J AddCommGrpCat.{u})] (q : ℕ)
    (x : Sheaf.H.{t, u} (rootsOfUnitySheaf J F hF n) q) : n • x = 0 := by
  rw [← sheafH_map_nsmul_id_apply (rootsOfUnitySheaf J F hF n) q n x,
    nsmul_id_rootsOfUnitySheaf_eq_zero, sheafH_map_zero_apply]

/-! ### The affine curve -/

attribute [local instance] AlgebraicGeometry.SmallEtale.zariskiPicardAddCommGroup

section KScheme

variable (k : Type u) [Field k] (X : Scheme.{u}) (f : X ⟶ Spec (.of k))
  (B : BigEtaleSite.{u}) (hX : B.Contains X) (n : ℕ)
  [HasExt.{t} (Sheaf (SmallEtale.topology B X hX) AddCommGrpCat.{u})]

/-- `Pic(X)[n]`, the `n`-torsion of the Picard group of `X`. -/
abbrev picardNTorsion : AddSubgroup (schemePicard X) :=
  (n • AddMonoidHom.id (schemePicard X)).ker

/-- A class `x` of `Pic(X)` lies in `Pic(X)[n]` if and only if `n • x = 0`. -/
theorem mem_picardNTorsion_iff (x : schemePicard X) :
    x ∈ picardNTorsion X n ↔ n • x = 0 := by
  simp [picardNTorsion, AddMonoidHom.mem_ker]

include f in
/-- **A class of `H¹_ét(X, μ_n)` dies in `Pic(X)` exactly when it is the Kummer boundary of a
global unit.** This is exactness of the Kummer long exact sequence at `H¹_ét(X, μ_n)`, read
through the identification `H¹_ét(X, 𝐆_m) = Pic(X)` of [Stacks, Tag 03P8]; the boundary's own
kernel is the group of `n`-th powers, by
`AlgebraicGeometry.kummerBoundary_eq_zero_iff`. So the kernel of the canonical map to `Pic(X)`
is `Γ(X, 𝒪_X)ˣ/(Γ(X, 𝒪_X)ˣ)^n`.

No properness is assumed, and that is the point: on a proper variety over an algebraically
closed field every global unit *is* an `n`-th power, so the kernel is trivial and the map is
injective, which is `AlgebraicGeometry.injective_etaleH1RootsOfUnityToPicard`. On the affine
curve of [Stacks, Tag 03RR] it is not. -/
@[sga "1 XI 6.4" "partial", sga "4 IX 4.6" "partial", sga "6 XIII 3.11" "partial"]
theorem etaleH1RootsOfUnityToPicard_eq_zero_iff (hn : IsUnit (n : k))
    (x : Sheaf.H (kummerSmallEtale B X hX n).X₁ 1) :
    etaleH1RootsOfUnityToPicard X B hX n x = 0 ↔
      ∃ a : Γ(X, ⊤)ˣ, kummerBoundaryHom (SmallEtale.topology B X hX)
        (SmallEtale.toScheme B X hX) (unitsPresheaf_isSheaf_smallEtale B X hX) n
        (kummerSmallEtale_shortExact k X f B hX n hn)
        (SmallEtale.finalIsTerminal B X hX) (Additive.ofMul a) = x := by
  rw [etaleH1RootsOfUnityToPicard_apply,
    show (0 : schemePicard X) = etaleH1UnitsEquivPicard X B hX n 0 from (map_zero _).symm,
    (etaleH1UnitsEquivPicard X B hX n).apply_eq_iff_eq]
  exact (exists_kummerBoundary_iff (SmallEtale.topology B X hX)
    (SmallEtale.toScheme B X hX) (unitsPresheaf_isSheaf_smallEtale B X hX) n
    (kummerSmallEtale_shortExact k X f B hX n hn)
    (SmallEtale.finalIsTerminal B X hX) x).symm

include f in
/-- **The kernel of `H¹_ét(X, μ_n) ⟶ Pic(X)` is the range of the Kummer boundary of the global
units**, that is `Γ(X, 𝒪_X)ˣ/(Γ(X, 𝒪_X)ˣ)^n`. -/
theorem ker_etaleH1RootsOfUnityToPicard_eq_range_kummerBoundaryHom (hn : IsUnit (n : k)) :
    (etaleH1RootsOfUnityToPicard X B hX n).ker =
      (kummerBoundaryHom (SmallEtale.topology B X hX) (SmallEtale.toScheme B X hX)
        (unitsPresheaf_isSheaf_smallEtale B X hX) n
        (kummerSmallEtale_shortExact k X f B hX n hn)
        (SmallEtale.finalIsTerminal B X hX)).range := by
  ext x
  rw [AddMonoidHom.mem_ker, etaleH1RootsOfUnityToPicard_eq_zero_iff k X f B hX n hn,
    AddMonoidHom.mem_range]
  exact ⟨fun ⟨a, ha⟩ => ⟨Additive.ofMul a, ha⟩, fun ⟨y, hy⟩ => ⟨Additive.toMul y, hy⟩⟩

include f in
/-- **The canonical map `H¹_ét(X, μ_n) ⟶ Pic(X)[n]`**: the canonical map to `Pic(X)` has image
in the `n`-torsion, by `AlgebraicGeometry.mem_range_etaleH1RootsOfUnityToPicard_iff`. -/
def etaleH1RootsOfUnityToPicardNTorsion (hn : IsUnit (n : k)) :
    Sheaf.H (kummerSmallEtale B X hX n).X₁ 1 →+ ↥(picardNTorsion X n) :=
  (etaleH1RootsOfUnityToPicard X B hX n).codRestrict (picardNTorsion X n) fun x =>
    (mem_picardNTorsion_iff X n _).2
      ((mem_range_etaleH1RootsOfUnityToPicard_iff k X f B hX n hn _).1 ⟨x, rfl⟩)

include f in
/-- The image of `x` under `H¹_ét(X, μ_n) ⟶ Pic(X)[n]`, viewed in `Pic(X)`, is its image under
the canonical map `H¹_ét(X, μ_n) ⟶ Pic(X)`. -/
@[simp] theorem etaleH1RootsOfUnityToPicardNTorsion_coe (hn : IsUnit (n : k))
    (x : Sheaf.H (kummerSmallEtale B X hX n).X₁ 1) :
    (etaleH1RootsOfUnityToPicardNTorsion k X f B hX n hn x : schemePicard X) =
      etaleH1RootsOfUnityToPicard X B hX n x :=
  rfl

include f in
/-- **`H¹_ét(X, μ_n) ⟶ Pic(X)[n]` is onto**: the second map of the Kummer sequence induces
multiplication by `n` on first cohomology, so the image of `H¹_ét(X, μ_n)` in `Pic(X)` is exactly
the `n`-torsion. -/
@[sga "4 IX 4.7" "partial", sga "4½ Arcata 2.2.4" "Exactness at H¹(X"]
theorem surjective_etaleH1RootsOfUnityToPicardNTorsion (hn : IsUnit (n : k)) :
    Function.Surjective (etaleH1RootsOfUnityToPicardNTorsion k X f B hX n hn) := by
  rintro ⟨y, hy⟩
  obtain ⟨x, hx⟩ := (mem_range_etaleH1RootsOfUnityToPicard_iff k X f B hX n hn y).2
    ((mem_picardNTorsion_iff X n y).1 hy)
  exact ⟨x, Subtype.ext hx⟩

include f in
/-- **The two descriptions of the kernel of `H¹_ét(X, μ_n) ⟶ Pic(X)[n]` agree**: restricting the
codomain to the `n`-torsion does not change the kernel. -/
theorem ker_etaleH1RootsOfUnityToPicardNTorsion (hn : IsUnit (n : k)) :
    (etaleH1RootsOfUnityToPicardNTorsion k X f B hX n hn).ker =
      (etaleH1RootsOfUnityToPicard X B hX n).ker := by
  ext x
  rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_ker, ← Subtype.coe_inj,
    etaleH1RootsOfUnityToPicardNTorsion_coe]
  rfl

/-! ### Clause (3) in degree two -/

include f in
/-- **`H²_ét(X, μ_n) = 0` when `Pic(X)` is `n`-divisible**, which is clause (3) of
[Stacks, Tag 03RR] in degree two.

The Kummer segment `H¹(X, 𝐆_m) --·n--> H¹(X, 𝐆_m) ⟶ H²(X, μ_n) ⟶ H²(X, 𝐆_m)` presents
`H²_ét(X, μ_n)` as `Pic(X)/n·Pic(X)` once the right-hand term vanishes, so the group dies exactly
when `Pic(X)` is `n`-divisible. The two hypotheses are therefore `hGm`, which is
[Stacks, Tag 03RM] on this site, and `hdvd`; neither is available in the library and both are
discussed in the module documentation. The source gets `hdvd` from the surjection
`Pic⁰(X̄) ↠ Pic(X)`, which is where the affine curve's `r ≥ 1` is used. -/
theorem subsingleton_etaleH2_rootsOfUnity_of_divisible (hn : IsUnit (n : k))
    (hGm : Subsingleton (Sheaf.H (kummerSmallEtale B X hX n).X₂ 2))
    (hdvd : ∀ x : schemePicard X, ∃ y, x = n • y) :
    Subsingleton (Sheaf.H (kummerSmallEtale B X hX n).X₁ 2) := by
  refine subsingleton_of_forall_eq 0 fun v => ?_
  obtain ⟨z, hz⟩ := (Stacks.Cohomology.exists_sheafHBoundary_iff
    (kummerSmallEtale_shortExact k X f B hX n hn) 1 2 rfl v).2 (hGm.elim _ _)
  obtain ⟨y, hy⟩ := hdvd (etaleH1UnitsEquivPicardQuotient X B hX n z)
  have hmap : Sheaf.H.map (kummerSmallEtale B X hX n).g 1
      ((etaleH1UnitsEquivPicard X B hX n).symm y) = z := by
    refine (etaleH1UnitsEquivPicardQuotient X B hX n).injective ?_
    rw [etaleH1UnitsEquivPicardQuotient_map_g, AddEquiv.apply_symm_apply, ← hy]
  rw [← hz]
  exact (Stacks.Cohomology.sheafHBoundary_eq_zero_iff
    (kummerSmallEtale_shortExact k X f B hX n hn) 1 2 rfl z).2 ⟨_, hmap⟩

end KScheme

/-! ### The three clauses of Tag 03RR -/

section AffineCurve

variable (k : Type u) [Field k] [IsAlgClosed k] (X : Scheme.{u}) (f : X ⟶ Spec (.of k))
  [IsCurve k f] [Smooth f] (B : BigEtaleSite.{u}) (hX : B.Contains X) (n : ℕ)
  [HasExt.{t} (Sheaf (SmallEtale.topology B X hX) AddCommGrpCat.{u})]

include f in
omit [IsAlgClosed k] [IsCurve k f] [Smooth f] in
/-- **`H¹_ét(X, μ_n) ≅ (𝐙/n𝐙)^{2g + r - 1}`**, clause (2) of [Stacks, Tag 03RR], with `g` the
genus `AlgebraicGeometry.genus` of the smooth projective compactification `X̄` and `r` the number
of points of `X̄ ∖ X`.

The cohomological content is unconditional and is the degree-one sequence of this file: the
canonical map `H¹_ét(X, μ_n) ⟶ Pic(X)[n]` is onto with kernel the Kummer boundary of the global
units. What is carried is the rank count the source performs, in three pieces: `hunits`, the rank
`a` of `Γ(X, 𝒪_X)ˣ/(Γ(X, 𝒪_X)ˣ)^n`; `htors`, the rank `b` of `Pic(X)[n]`; and `hrank`, that
`a + b = 2g + r - 1`. The splitting of the extension is *not* carried — it is
`AlgebraicGeometry.nonempty_addEquiv_fin_zmod_of_surjective`, proved here from the annihilation
of `H¹_ét(X, μ_n)` by `n`.

The identification is asserted as the existence of an isomorphism, which is what the source
means: it claims no canonical map, and obtains the conclusion by counting ranks.

`hj` and `hr` are what make `genus fbar` and `r` be the source's `g` and `r` rather than two free
numerals: they say that `j : X ⟶ X̄` is a morphism over `k` and that `X̄ ∖ X` has exactly `r`
points. They are not used in the derivation, which runs through `hrank`; they are part of the
statement. Affineness of `X` is likewise not assumed: in the source it enters only through
`r ≥ 1`, and through that the divisibility of `Pic(X)` which degree two needs, so under these
hypotheses the statement holds for every smooth curve.

The three carried hypotheses are named in the attribute string. Neither `hGm` nor `hdvd` is among
them: clause (2) needs neither, so this is the registration of clause (2) over the rank count and
nothing else.

This is a partial form of [Stacks, Tag 03RR](https://stacks.math.columbia.edu/tag/03RR); the full
statement is
`AlgebraicGeometry.etaleCohomology_rootsOfUnity_affineSmoothCurve_of_compactification`. -/
theorem nonempty_etaleH1RootsOfUnityAddEquivZModPow (hn : IsUnit (n : k))
    {Xbar : Scheme.{u}} (fbar : Xbar ⟶ Spec (.of k)) [IsCurve k fbar] [Smooth fbar]
    [IsProjectiveVariety k fbar] (j : X ⟶ Xbar) [IsOpenImmersion j] (hj : j ≫ fbar = f)
    (r : ℕ) (hr : Nat.card ↥(Set.range j.base)ᶜ = r) {a b : ℕ}
    (hunits : Nonempty (↥(etaleH1RootsOfUnityToPicard X B hX n).ker ≃+ (Fin a → ZMod n)))
    (htors : Nonempty (↥(picardNTorsion X n) ≃+ (Fin b → ZMod n)))
    (hrank : a + b = 2 * genus fbar + r - 1) :
    Nonempty (Sheaf.H (kummerSmallEtale B X hX n).X₁ 1 ≃+
      (Fin (2 * genus fbar + r - 1) → ZMod n)) := by
  obtain ⟨eu⟩ := hunits
  obtain ⟨et⟩ := htors
  have hcomp : (et.toAddMonoidHom.comp
      (etaleH1RootsOfUnityToPicardNTorsion k X f B hX n hn)).ker =
      (etaleH1RootsOfUnityToPicard X B hX n).ker := by
    rw [← ker_etaleH1RootsOfUnityToPicardNTorsion k X f B hX n hn]
    ext x
    simp only [AddMonoidHom.mem_ker, AddMonoidHom.coe_comp, Function.comp_apply,
      AddEquiv.coe_toAddMonoidHom]
    exact ⟨fun h => et.injective (by rw [h, map_zero]), fun h => by rw [h, map_zero]⟩
  obtain ⟨e⟩ := nonempty_addEquiv_fin_zmod_of_surjective
    (nsmul_sheafH_rootsOfUnitySheaf_eq_zero (SmallEtale.topology B X hX)
      (SmallEtale.toScheme B X hX) (unitsPresheaf_isSheaf_smallEtale B X hX) n 1)
    (et.toAddMonoidHom.comp (etaleH1RootsOfUnityToPicardNTorsion k X f B hX n hn))
    (et.surjective.comp (surjective_etaleH1RootsOfUnityToPicardNTorsion k X f B hX n hn))
    ((AddEquiv.addSubgroupCongr hcomp).trans eu)
  exact ⟨hrank ▸ e⟩

include f in
omit [Smooth f] in
/-- **The étale cohomology of the roots of unity on an affine smooth curve: all three clauses of
[Stacks, Tag 03RR].** Let `X` be an affine smooth curve over an algebraically closed field `k`,
let `n` be invertible in `k`, let `X ⊂ X̄` be a smooth projective compactification, let `g` be the
genus of `X̄` and `r` the number of points of `X̄ ∖ X`. Then

* `H⁰_ét(X, μ_n) = μ_n(k)`, by pullback along the structure morphism;
* `H¹_ét(X, μ_n) ≅ (𝐙/n𝐙)^{2g + r - 1}`;
* `H^q_ét(X, μ_n) = 0` for every `q ≥ 2`.

Clause (1) is canonical, asserted of the named map `AlgebraicGeometry.baseRootsToEtaleH0`, and
forwards unchanged to `AlgebraicGeometry.baseRootsToEtaleH0_bijective_of_isIntegral`, where Tag
03RR is registered; clause (2) is the source's noncanonical identification and is asserted as the
existence of an isomorphism. As in
`AlgebraicGeometry.nonempty_etaleH1RootsOfUnityAddEquivZModPow`, `hj` and `hr` identify the
compactification and the number of punctures and are not used in the derivation, and affineness
of `X` is not assumed.

**CONDITIONAL**, on hypotheses the library does not have and which are therefore carried, none of
them the conclusion of any clause above: `hGm`, the vanishing of `H^q_ét(X, 𝐆_m)` for `q ≥ 2` on
this site, which is [Stacks, Tag 03RM]; `hdvd`, the `n`-divisibility of `Pic(X)`, which is
[Stacks, Tag 03RP] for the Picard scheme of [Stacks, Tag 0BA0]; and `hunits`, `htors`, `hrank`,
the rank count of the degree-one sequence. All five are explicit named arguments and all five are
named in the attribute string, which is what makes this a hypothesis-carrying registration of
clauses (2) and (3) rather than a reason to decline one; see the module documentation for the
precise state of each.

This is a partial form of [Stacks, Tag 03RR](https://stacks.math.columbia.edu/tag/03RR); the full
statement is
`AlgebraicGeometry.etaleCohomology_rootsOfUnity_affineSmoothCurve_of_compactification`. -/
theorem etaleCohomology_rootsOfUnity_affineSmoothCurve (hn : IsUnit (n : k))
    {Xbar : Scheme.{u}} (fbar : Xbar ⟶ Spec (.of k)) [IsCurve k fbar] [Smooth fbar]
    [IsProjectiveVariety k fbar] (j : X ⟶ Xbar) [IsOpenImmersion j] (hj : j ≫ fbar = f)
    (r : ℕ) (hr : Nat.card ↥(Set.range j.base)ᶜ = r) {a b : ℕ}
    (hunits : Nonempty (↥(etaleH1RootsOfUnityToPicard X B hX n).ker ≃+ (Fin a → ZMod n)))
    (htors : Nonempty (↥(picardNTorsion X n) ≃+ (Fin b → ZMod n)))
    (hrank : a + b = 2 * genus fbar + r - 1)
    (hGm : ∀ q, 2 ≤ q → Subsingleton (Sheaf.H (kummerSmallEtale B X hX n).X₂ q))
    (hdvd : ∀ x : schemePicard X, ∃ y, x = n • y) :
    Function.Bijective (baseRootsToEtaleH0 B k X hX f n) ∧
      Nonempty (Sheaf.H (kummerSmallEtale B X hX n).X₁ 1 ≃+
        (Fin (2 * genus fbar + r - 1) → ZMod n)) ∧
      ∀ q, 2 ≤ q → Subsingleton (Sheaf.H (kummerSmallEtale B X hX n).X₁ q) := by
  refine ⟨baseRootsToEtaleH0_bijective_of_isIntegral B k X hX f n
      (Nat.pos_of_ne_zero (ne_zero_of_isUnit_natCast k X f n hn)),
    nonempty_etaleH1RootsOfUnityAddEquivZModPow k X f B hX n hn fbar j hj r hr hunits htors
      hrank, fun q hq => ?_⟩
  rcases Nat.lt_or_ge q 3 with hq3 | hq3
  · obtain rfl : q = 2 := by lia
    exact subsingleton_etaleH2_rootsOfUnity_of_divisible k X f B hX n hn (hGm 2 le_rfl) hdvd
  · exact subsingleton_etaleH_rootsOfUnity_of_three_le k X f B hX n hn hGm q hq3

end AffineCurve

end AlgebraicGeometry

