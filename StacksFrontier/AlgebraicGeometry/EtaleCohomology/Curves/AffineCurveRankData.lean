/-!
# The divisor theory of a punctured smooth projective curve

Let `X̄` be a smooth proper curve over an algebraically closed field `k` and `j : X ⟶ X̄` an open
immersion of a smooth curve, with `X̄ ∖ X = {x₀, …, x_{r'}}`. We describe the divisor theory of
`X` relative to `X̄`:

* the Picard group of a smooth curve is its Weil divisor class group,
  `AlgebraicGeometry.AffineCurveRankData.picardEquivClass` ([Stacks, Tag 0BE9]), and the class of
  `𝒪(x)` for a closed point `x` goes to the class of the prime divisor `[x]`;
* the restriction `ρ : Pic(X̄) ↠ Pic(X)`, read through `Cl`, whose kernel is generated by the
  classes `cᵢ = [𝒪_{X̄}(xᵢ)]`, each of degree one;
* the orders of vanishing at the punctures of the units of `X`, whose kernel consists of
  `n`-th powers (they are constants, by Hartogs and [Stacks, Tag 04L2]) and whose image is the
  lattice of relations among the `cᵢ`.

## References

* [Stacks Project, Tag 03RR](https://stacks.math.columbia.edu/tag/03RR)
* [Stacks Project, Tag 0BE9](https://stacks.math.columbia.edu/tag/0BE9)
-/

@[expose] public noncomputable section

open CategoryTheory Order Opposite AlgebraicGeometry.OpenWeilRestriction

universe u

attribute [local instance] AlgebraicGeometry.SmallEtale.zariskiPicardAddCommGroup

namespace AlgebraicGeometry.AffineCurveRankData

/-! ### Smooth curves: normality, factorial stalks, `Pic = Cl` -/

section SmoothCurve

variable (k : Type u) [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsCurve k f] [Smooth f]

include f in
omit [Smooth f] in
/-- A smooth curve over a field is locally Noetherian. -/
theorem isLocallyNoetherian : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f

include f in
omit [Smooth f] in
/-- A smooth curve over a field has topological Krull dimension at most one. -/
theorem topologicalKrullDim_le_one : topologicalKrullDim X ≤ 1 :=
  (IsCurve.topologicalKrullDim_eq_one (k := k) (f := f)).le

include f in
omit [IsCurve k f] in
/-- A smooth curve is normal ([Stacks, Tag 033C]). -/
theorem isNormal : IsNormal X := by
  have : IsNormal (Spec (.of k)) :=
    isNormal_spec_of_isNormalRing (IsNormalRing.of_isIntegrallyClosed k)
  exact isNormal_of_smooth f

include f in
omit [Smooth f] in
/-- Every point of a smooth curve over a field has coheight at most one. -/
theorem coheight_le_one (x : X) : coheight x ≤ 1 := by
  have h : ((coheight x : ℕ∞) : WithBot ℕ∞) ≤ ((1 : ℕ∞) : WithBot ℕ∞) := by
    apply le_trans (Order.coheight_le_krullDim x)
    rw [← Order.krullDim_eq_of_orderIso (irreducibleSetEquivPoints (α := X))]
    exact topologicalKrullDim_le_one k f
  exact WithBot.coe_le_coe.mp h

include f in
/-- The local rings of a smooth curve are unique factorization domains: they are principal. -/
theorem uniqueFactorizationMonoid_stalk (x : X) :
    UniqueFactorizationMonoid (X.presheaf.stalk x) := by
  have := isLocallyNoetherian k f
  have := isNormal k f
  have := isPrincipalIdealRing_stalk_of_normal_curve X (topologicalKrullDim_le_one k f) x
  infer_instance

variable [IsLocallyNoetherian X]

/-- **`Pic(X) ≅ Cl(X)` for a smooth curve** ([Stacks, Tag 0BE9]). -/
def picardEquivClass : schemePicard X ≃+ weilDivisorClassGroup X :=
  (Stacks.GluePicard.picardModelAddEquiv X.toRingedSpace).symm.trans
    (picardEquivWeilDivisorClassGroupOfForallUniqueFactorizationMonoid X
      (uniqueFactorizationMonoid_stalk k f))

/-- The class of `𝒪_X(D)` goes to the Weil divisor class of `𝒪_X(D)`. -/
theorem picardEquivClass_divisorSchemePicardClass (D : X.IdealSheafData)
    [Stacks.Divisors.IsEffectiveCartierDivisor D] :
    picardEquivClass k f (divisorSchemePicardClass D) =
      weilDivisorClassOfInvertibleSheaf X (Stacks.Divisors.modulesInvertibleSheaf D) := by
  have h1 : (Stacks.GluePicard.picardModelAddEquiv X.toRingedSpace).symm
      (divisorSchemePicardClass D) =
      Stacks.SheafOfModules.picardClass X.toRingedSpace.presheaf
        (Stacks.RingedSpace.structureIsSheaf X.toRingedSpace)
        (Stacks.Divisors.divisorSheaf D) (stacksIsInvertible_divisorSheaf D) :=
    (AddEquiv.symm_apply_eq _).2
      (Stacks.GluePicard.picardModelEquiv_classOf X.toRingedSpace _ _).symm
  show picardToWeilDivisorClassGroup X
    ((Stacks.GluePicard.picardModelAddEquiv X.toRingedSpace).symm
      (divisorSchemePicardClass D)) = _
  rw [h1]
  exact weilDivisorClassOfPicardClass_picardClass X _

end SmoothCurve

/-! ### The class of a closed point -/

section Point

variable (k : Type u) [Field k] [IsAlgClosed k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
  [IsCurve k f] [Smooth f] [IsNoetherian X]

/-- **`𝒪_X(x) ↦ [x]`.** For a closed point `x` of a smooth curve, the isomorphism `Pic = Cl`
sends the class of the divisor `x` to the class of the prime divisor `[x]`. -/
theorem picardEquivClass_pointClass {x : X} (hx : IsClosed ({x} : Set X))
    (hx1 : coheight x = 1) :
    letI := isEffectiveCartierDivisor_ker_pointOfClosedPoint k f hx
    picardEquivClass k f (divisorSchemePicardClass (pointOfClosedPoint f x hx).ker) =
      ((primeWeil (PrimeDivisor.ofCoheightOne x hx1) : WeilDivisor X) :
        weilDivisorClassGroup X) := by
  let := isEffectiveCartierDivisor_ker_pointOfClosedPoint k f hx
  have := isNormal k f
  rw [picardEquivClass_divisorSchemePicardClass]
  refine weilDivisorClassOfInvertibleSheaf_eq_of_forall_ord _ _ fun Z c hc => ?_
  have : IsDiscreteValuationRing (X.presheaf.stalk Z.genericPoint) :=
    Stacks.AlgebraicGeometry.UnitsNormalProper.isDiscreteValuationRing_stalk
      (PrimeDivisor.coheight_genericPoint Z)
  rw [ker_pointOfClosedPoint_eq_vanishingIdeal k f hx] at hc
  rw [primeWeil_apply]
  split_ifs with hZ
  · subst hZ
    have hst : IdealSheafData.stalk (Scheme.IdealSheafData.vanishingIdeal
        (TopologicalSpace.Closeds.closure ({x} : Set X)))
          (PrimeDivisor.ofCoheightOne x hx1).genericPoint =
        IsLocalRing.maximalIdeal
          (X.presheaf.stalk (PrimeDivisor.ofCoheightOne x hx1).genericPoint) := by
      rw [PrimeDivisor.genericPoint_ofCoheightOne x hx1]
      exact Stacks.Divisors.stalk_vanishingIdeal_closure_singleton x
    have := ord_algebraMap_eq_of_span_eq_maximalIdeal_pow _
      (PrimeDivisor.coheight_genericPoint _) c 1 (by rw [pow_one, ← hc, hst])
    rw [this]
    rfl
  · have hne : Z.genericPoint ≠ x := by
      intro h
      apply hZ
      apply PrimeDivisor.genericPoint_injective
      rw [h, PrimeDivisor.genericPoint_ofCoheightOne]
    have hns : Z.genericPoint ∉
        (Scheme.IdealSheafData.vanishingIdeal
          (TopologicalSpace.Closeds.closure ({x} : Set X))).support := by
      rw [← SetLike.mem_coe, Scheme.IdealSheafData.coe_support_vanishingIdeal]
      show Z.genericPoint ∉ closure ({x} : Set X)
      rwa [hx.closure_eq]
    have hst := IdealSheafData.stalk_eq_top_of_notMem_support _ hns
    have := ord_algebraMap_eq_of_span_eq_maximalIdeal_pow _
      (PrimeDivisor.coheight_genericPoint _) c 0 (by rw [pow_zero, Ideal.one_eq_top, ← hc, hst])
    rw [this]
    rfl

end Point

/-! ### Points of a curve -/

section Ord

variable {X : Scheme.{u}} [IsIntegral X]

/-- The rational function `1` has order zero at every point. -/
theorem ord_one' [IsLocallyNoetherian X] (x : X) : X.ord (1 : X.functionField) x = 0 := by
  have h := X.ord_mul (x := x) (f := 1) (g := 1) one_ne_zero one_ne_zero
  rw [one_mul] at h
  linarith

/-- If a nonzero rational function `z` has order zero at `x`, then so does `z⁻¹`. -/
theorem ord_inv_eq_zero [IsLocallyNoetherian X] {z : X.functionField} (hz : z ≠ 0) {x : X}
    (h : X.ord z x = 0) : X.ord z⁻¹ x = 0 := by
  have h2 := X.ord_mul (x := x) hz (inv_ne_zero hz)
  rw [mul_inv_cancel₀ hz, ord_one', h, zero_add] at h2
  exact h2.symm

end Ord

section Points

variable (k : Type u) [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsCurve k f] [Smooth f]

include f in
omit [Smooth f] in
/-- **A point of a curve other than the generic point is a closed point of coheight one.** -/
theorem coheight_eq_one_and_isClosed {x : X} (hx : x ≠ genericPoint X) :
    coheight x = 1 ∧ IsClosed ({x} : Set X) := by
  have hlt : ∀ {a b : X}, b ⤳ a → a ≠ b → a < b := fun {a b} hab hne =>
    lt_iff_le_not_ge.2 ⟨hab, fun hba => hne (hab.antisymm hba).symm.eq⟩
  have h1 : 1 ≤ coheight x := by
    have := Order.coheight_add_one_le (hlt (genericPoint_specializes x) hx)
    have h0 : coheight (genericPoint X) = 0 :=
      Order.coheight_eq_zero.2 fun b _ => genericPoint_specializes b
    rwa [h0, zero_add] at this
  have hc : coheight x = 1 := le_antisymm (coheight_le_one k f x) h1
  refine ⟨hc, ?_⟩
  rw [← closure_subset_iff_isClosed]
  intro z hz
  by_contra hzx
  have hzlt : z < x := hlt (specializes_iff_mem_closure.2 hz) hzx
  have h2 := Order.coheight_add_one_le hzlt
  rw [hc] at h2
  exact absurd (h2.trans (coheight_le_one k f z)) (by norm_num)

include f in
omit [Smooth f] in
/-- A smooth curve over a field whose spectrum is compact is Noetherian. -/
theorem isNoetherian [CompactSpace (Spec (.of k))] : IsNoetherian X :=
  have := isLocallyNoetherian k f
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  { }

end Points

/-! ### The punctured curve -/

section Punctured

variable (k : Type u) [Field k] [IsAlgClosed k] {X Xbar : Scheme.{u}} (f : X ⟶ Spec (.of k))
  (fbar : Xbar ⟶ Spec (.of k)) [IsCurve k f] [Smooth f] [IsCurve k fbar] [Smooth fbar]
  [IsNoetherian X] [IsNoetherian Xbar]
  (j : X ⟶ Xbar) [IsOpenImmersion j] {r' : ℕ} (x : Fin (r' + 1) → Xbar)
  (hxinj : Function.Injective x) (hxS : ∀ y, y ∉ Set.range j.base ↔ y ∈ Set.range x)

include f in
omit [IsAlgClosed k] [Smooth f] [Smooth fbar] [IsNoetherian X] [IsNoetherian Xbar] in
/-- The generic point of `X̄` lies in the image of the open immersion `j : X ⟶ X̄`. -/
theorem genericPoint_mem_range : genericPoint Xbar ∈ Set.range j.base := by
  have : IsDominant j := isDominant_of_isOpenImmersion_of_isIntegral j
  rw [← genericPoint_eq_of_isOpenImmersion j]
  exact ⟨_, rfl⟩

include f hxS in
omit [IsAlgClosed k] [Smooth f] [Smooth fbar] [IsNoetherian X] [IsNoetherian Xbar] in
/-- No puncture `xᵢ` is the generic point of `X̄`. -/
theorem ne_genericPoint (i : Fin (r' + 1)) : x i ≠ genericPoint Xbar := by
  intro h
  have := (hxS (x i)).2 ⟨i, rfl⟩
  rw [h] at this
  exact this (genericPoint_mem_range k f fbar j)

omit [IsAlgClosed k] [Smooth fbar] [IsNoetherian Xbar] in
/-- A puncture `xᵢ` other than the generic point of `X̄` has coheight one. -/
theorem coheight_x (i : Fin (r' + 1)) (hi : x i ≠ genericPoint Xbar) : coheight (x i) = 1 :=
  (coheight_eq_one_and_isClosed k fbar hi).1

/-- The punctures as prime divisors. -/
def Zp (h : ∀ i, x i ≠ genericPoint Xbar) (i : Fin (r' + 1)) : PrimeDivisor Xbar :=
  PrimeDivisor.ofCoheightOne (x i) ((coheight_eq_one_and_isClosed k fbar (h i)).1)

/-- The punctures as Picard classes `cᵢ = [𝒪(xᵢ)]`. -/
def cls (h : ∀ i, x i ≠ genericPoint Xbar) (i : Fin (r' + 1)) : schemePicard Xbar :=
  letI := isEffectiveCartierDivisor_ker_pointOfClosedPoint k fbar
    (coheight_eq_one_and_isClosed k fbar (h i)).2
  divisorSchemePicardClass (pointOfClosedPoint fbar (x i)
    (coheight_eq_one_and_isClosed k fbar (h i)).2).ker

/-- The isomorphism `Pic = Cl` sends `cᵢ = [𝒪(xᵢ)]` to the class of the prime divisor `[xᵢ]`. -/
theorem picardEquivClass_cls (h : ∀ i, x i ≠ genericPoint Xbar) (i : Fin (r' + 1)) :
    picardEquivClass k fbar (cls k fbar x h i) =
      ((primeWeil (Zp k fbar x h i) : WeilDivisor Xbar) : weilDivisorClassGroup Xbar) :=
  picardEquivClass_pointClass k fbar _ _

omit [IsNoetherian Xbar] in
/-- On a proper curve, each class `cᵢ = [𝒪(xᵢ)]` has degree one. -/
theorem picardDegree_cls [IsProper fbar] (h : ∀ i, x i ≠ genericPoint Xbar) (i : Fin (r' + 1)) :
    picardDegree k fbar (topologicalKrullDim_le_one k fbar) (cls k fbar x h i) = 1 :=
  picardDegree_divisorSchemePicardClass_pointOfClosedPoint_eq_one k fbar _ _

include hxinj in
omit [IsAlgClosed k] [Smooth fbar] [IsNoetherian Xbar] in
/-- Distinct punctures give distinct prime divisors. -/
theorem Zp_injective (h : ∀ i, x i ≠ genericPoint Xbar) : Function.Injective (Zp k fbar x h) :=
  fun a b hab => hxinj (by
    simpa [Zp, PrimeDivisor.genericPoint_ofCoheightOne] using
      congrArg PrimeDivisor.genericPoint hab)

include hxS in
omit [IsAlgClosed k] [Smooth fbar] [IsNoetherian X] [IsNoetherian Xbar] in
/-- A prime divisor of `X̄` does not meet `X` if and only if it is one of the punctures. -/
theorem notMem_range_primeDivisorMap_iff (h : ∀ i, x i ≠ genericPoint Xbar)
    (Z' : PrimeDivisor Xbar) :
    Z' ∉ Set.range (primeDivisorMap j) ↔ Z' ∈ Set.range (Zp k fbar x h) := by
  rw [mem_range_primeDivisorMap_iff, hxS]
  constructor
  · rintro ⟨i, hi⟩
    refine ⟨i, PrimeDivisor.genericPoint_injective ?_⟩
    simp [Zp, PrimeDivisor.genericPoint_ofCoheightOne, hi]
  · rintro ⟨i, rfl⟩
    exact ⟨i, by simp [Zp, PrimeDivisor.genericPoint_ofCoheightOne]⟩

variable [IsDominant j]

/-- **The restriction `ρ : Pic(X̄) ↠ Pic(X)`**, read through `Cl`. -/
def restrictPicard : schemePicard Xbar →+ schemePicard X :=
  (picardEquivClass k f).symm.toAddMonoidHom.comp
    ((restrictClass j).comp (picardEquivClass k fbar).toAddMonoidHom)

omit [IsAlgClosed k] in
/-- The restriction `ρ : Pic(X̄) → Pic(X)` is surjective. -/
theorem surjective_restrictPicard : Function.Surjective (restrictPicard k f fbar j) :=
  (picardEquivClass k f).symm.surjective.comp
    ((surjective_restrictClass j).comp (picardEquivClass k fbar).surjective)

include hxinj hxS in
/-- The kernel of the restriction `ρ : Pic(X̄) → Pic(X)` is generated by the classes
`cᵢ = [𝒪(xᵢ)]`. -/
theorem ker_restrictPicard (h : ∀ i, x i ≠ genericPoint Xbar) :
    (restrictPicard k f fbar j).ker = AddSubgroup.closure (Set.range (cls k fbar x h)) := by
  have hk : (restrictPicard k f fbar j).ker =
      (restrictClass j).ker.comap (picardEquivClass k fbar).toAddMonoidHom := by
    ext p
    simp only [restrictPicard, AddMonoidHom.mem_ker, AddSubgroup.mem_comap,
      AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom,
      AddEquiv.map_eq_zero_iff]
  rw [hk, ker_restrictClass j (Zp k fbar x h) (Zp_injective k fbar x hxinj h)
    (notMem_range_primeDivisorMap_iff k fbar j x hxS h)]
  have hr : Set.range (fun i => ((primeWeil (Zp k fbar x h i) : WeilDivisor Xbar) :
      weilDivisorClassGroup Xbar)) =
      (picardEquivClass k fbar).toAddMonoidHom '' Set.range (cls k fbar x h) := by
    rw [← Set.range_comp]
    exact congrArg Set.range (funext fun i => (picardEquivClass_cls k fbar x h i).symm)
  rw [hr, ← AddMonoidHom.map_closure, AddSubgroup.comap_map_eq_self_of_injective]
  exact (picardEquivClass k fbar).injective

end Punctured

/-! ### Hartogs for units -/

section Hartogs

/-- **A rational function of order zero at every point of codimension one of a normal integral
scheme is a global unit.** -/
theorem exists_unit_of_forall_ord_eq_zero {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {z : X.functionField} (hz : z ≠ 0)
    (h0 : ∀ y : X, coheight y = 1 → X.ord z y = 0) :
    ∃ a : Γ(X, ⊤)ˣ, X.presheaf.germ ⊤ (genericPoint X) trivial a.1 = z := by
  obtain ⟨a, ha⟩ :=
    Stacks.AlgebraicGeometry.UnitsNormalProper.exists_globalSection_of_forall_ord_eq_zero hz h0
  obtain ⟨b, hb⟩ :=
    Stacks.AlgebraicGeometry.UnitsNormalProper.exists_globalSection_of_forall_ord_eq_zero
      (inv_ne_zero hz) fun y hy => ord_inv_eq_zero hz (h0 y hy)
  have hab : a * b = 1 := germ_injective_of_isIntegral (X := X) (U := ⊤) (genericPoint X) trivial
    (by rw [map_mul, ha, hb, map_one, mul_inv_cancel₀ hz])
  exact ⟨⟨a, b, hab, (mul_comm b a).trans hab⟩, ha⟩

end Hartogs

/-! ### The units of the punctured curve -/

section UnitsBasic

variable {X Xbar : Scheme.{u}} [IsIntegral X] [IsIntegral Xbar] [IsNoetherian X] [IsNoetherian Xbar]
  (j : X ⟶ Xbar) [IsOpenImmersion j] [IsDominant j] {r' : ℕ} (x : Fin (r' + 1) → Xbar)

/-- A global unit of `X` as a rational function on `X̄`. -/
def unitFn (u : Γ(X, ⊤)ˣ) : Xbar.functionField :=
  (Stacks.Chow.functionFieldEquiv_openImmersion j).symm
    (X.presheaf.germ ⊤ (genericPoint X) trivial u.1)

omit [IsNoetherian X] [IsNoetherian Xbar] in
/-- The rational function of a global unit of `X` is nonzero. -/
theorem unitFn_ne_zero (u : Γ(X, ⊤)ˣ) : unitFn j u ≠ 0 := by
  simpa [unitFn] using (u.isUnit.map (X.presheaf.germ ⊤ (genericPoint X) trivial).hom).ne_zero

omit [IsNoetherian X] [IsNoetherian Xbar] in
/-- The rational function of a product of global units is the product of their rational
functions. -/
theorem unitFn_mul (u v : Γ(X, ⊤)ˣ) : unitFn j (u * v) = unitFn j u * unitFn j v := by
  simp [unitFn]

/-- A global unit of `X` has order zero along every prime divisor of `X̄` meeting `X`. -/
theorem ord_unitFn_primeDivisorMap (u : Γ(X, ⊤)ˣ) (W : PrimeDivisor X) :
    Xbar.ord (unitFn j u) (primeDivisorMap j W).genericPoint = 0 := by
  rw [genericPoint_primeDivisorMap, ← Stacks.Chow.ord_functionFieldEquiv_openImmersion j,
    unitFn, RingEquiv.apply_symm_apply]
  have : Nonempty (⊤ : X.Opens) := ⟨⟨genericPoint X, trivial⟩⟩
  exact Scheme.ord_of_isUnit (U := ⊤) u.isUnit trivial

/-- **The orders at the punctures** of the units of `X`. -/
def ordHom : Additive Γ(X, ⊤)ˣ →+ (Fin (r' + 1) → ℤ) where
  toFun u i := Xbar.ord (unitFn j u.toMul) (x i)
  map_zero' := funext fun i => by
    change Xbar.ord (unitFn j 1) (x i) = 0
    rw [show unitFn j (1 : Γ(X, ⊤)ˣ) = 1 by simp [unitFn]]
    exact ord_one' _
  map_add' u v := funext fun i => by
    change Xbar.ord (unitFn j (u.toMul * v.toMul)) (x i) = _
    rw [unitFn_mul]
    exact Xbar.ord_mul (unitFn_ne_zero j _) (unitFn_ne_zero j _)

omit [IsNoetherian X] in
/-- The `i`-th coordinate of `ordHom j x u` is the order of `u` at the puncture `xᵢ`. -/
theorem ordHom_apply (u : Additive Γ(X, ⊤)ˣ) (i : Fin (r' + 1)) :
    ordHom j x u i = Xbar.ord (unitFn j u.toMul) (x i) := rfl

/-- A nonzero rational function as an invertible rational function. -/
def toRat {Y : Scheme.{u}} [IsIntegral Y] (z : Y.functionField) (hz : z ≠ 0) :
    (Stacks.Chow.rationalFunctions Y)ˣ :=
  Units.map (Stacks.Chow.rationalFunctionsEquivFunctionField Y).1.symm.toMonoidHom
    (Units.mk0 z hz)

/-- The multiplicity of a prime divisor `Z` in the principal divisor of a nonzero rational
function `z` is the order of `z` at the generic point of `Z`. -/
theorem principalDivisor_toRat_apply {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y]
    (z : Y.functionField) (hz : z ≠ 0) (Z : PrimeDivisor Y) :
    (principalDivisor Y (toRat z hz)).1 Z = Y.ord z Z.genericPoint := by
  rw [principalDivisor_apply]
  simp [toRat]

end UnitsBasic

section Units

variable (k : Type u) [Field k] [IsAlgClosed k] {X Xbar : Scheme.{u}} (f : X ⟶ Spec (.of k))
  (fbar : Xbar ⟶ Spec (.of k)) [IsCurve k f] [Smooth f] [IsCurve k fbar] [Smooth fbar]
  [IsNoetherian X] [IsNoetherian Xbar]
  (j : X ⟶ Xbar) [IsOpenImmersion j] [IsDominant j] {r' : ℕ} (x : Fin (r' + 1) → Xbar)
  (hxinj : Function.Injective x) (hxS : ∀ y, y ∉ Set.range j.base ↔ y ∈ Set.range x)
  (h : ∀ i, x i ≠ genericPoint Xbar)

/-- The multiplicity of `Z` in `∑ dᵢ [Pᵢ]` is `∑ dᵢ` times the multiplicity of `Z` in `[Pᵢ]`. -/
private theorem sum_primeWeil_apply {ι : Type*} [Fintype ι] (P : ι → PrimeDivisor Xbar)
    (d : ι → ℤ) (Z : PrimeDivisor Xbar) :
    (∑ i, d i • primeWeil (P i) : WeilDivisor Xbar).1 Z =
      ∑ i, d i * (primeWeil (P i) : WeilDivisor Xbar).1 Z := by
  rw [AddSubgroup.val_finsetSum, Finset.sum_apply]
  simp

/-- The boundary divisor `∑ dᵢ [xᵢ]`. -/
def wsum (d : Fin (r' + 1) → ℤ) : WeilDivisor Xbar :=
  ∑ i, d i • primeWeil (Zp k fbar x h i)

include hxinj in
omit [IsAlgClosed k] [Smooth fbar] in
/-- The multiplicity of the puncture `[xᵢ]` in `∑ dᵢ [xᵢ]` is `dᵢ`. -/
theorem wsum_apply_Zp (d : Fin (r' + 1) → ℤ) (i₀ : Fin (r' + 1)) :
    (wsum k fbar x h d).1 (Zp k fbar x h i₀) = d i₀ := by
  rw [wsum, sum_primeWeil_apply, Finset.sum_eq_single i₀]
  · simp [primeWeil_apply]
  · intro i _ hi
    rw [primeWeil_apply, if_neg (fun e => hi (Zp_injective k fbar x hxinj h e).symm), mul_zero]
  · simp

include hxS in
omit [IsAlgClosed k] [Smooth fbar] [IsNoetherian X] [IsDominant j] in
/-- A prime divisor of `X̄` meeting `X` has multiplicity zero in `∑ dᵢ [xᵢ]`. -/
theorem wsum_apply_primeDivisorMap (d : Fin (r' + 1) → ℤ) (W : PrimeDivisor X) :
    (wsum k fbar x h d).1 (primeDivisorMap j W) = 0 := by
  rw [wsum, sum_primeWeil_apply]
  refine Finset.sum_eq_zero fun i _ => ?_
  rw [primeWeil_apply, if_neg fun e => (notMem_range_primeDivisorMap_iff k fbar j x hxS h _).2
    ⟨i, e.symm⟩ ⟨W, rfl⟩, mul_zero]

/-- The isomorphism `Pic = Cl` sends `∑ dᵢ cᵢ` to the class of the divisor `∑ dᵢ [xᵢ]`. -/
theorem picardEquivClass_sum_cls (d : Fin (r' + 1) → ℤ) :
    picardEquivClass k fbar (∑ i, d i • cls k fbar x h i) =
      ((wsum k fbar x h d : WeilDivisor Xbar) : weilDivisorClassGroup Xbar) := by
  rw [map_sum, wsum, QuotientAddGroup.mk_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_zsmul, picardEquivClass_cls, QuotientAddGroup.mk_zsmul]

omit [IsAlgClosed k] [Smooth fbar] [IsNoetherian Xbar] in
/-- The generic point of the prime divisor `[xᵢ]` is `xᵢ`. -/
theorem genericPoint_Zp (i : Fin (r' + 1)) : (Zp k fbar x h i).genericPoint = x i :=
  PrimeDivisor.genericPoint_ofCoheightOne _ _

include hxinj hxS in
omit [IsAlgClosed k] [Smooth fbar] [IsNoetherian X] [IsNoetherian Xbar] [IsDominant j] in
/-- Every prime divisor of `X̄` is a puncture or meets `X`. -/
theorem primeDivisor_cases (Z : PrimeDivisor Xbar) :
    (∃ W, primeDivisorMap j W = Z) ∨ ∃ i, Zp k fbar x h i = Z := by
  by_cases hZ : Z ∈ Set.range (primeDivisorMap j)
  · exact Or.inl hZ
  · exact Or.inr ((notMem_range_primeDivisorMap_iff k fbar j x hxS h Z).1 hZ)

include hxinj hxS in
omit [IsAlgClosed k] [Smooth f] [Smooth fbar] in
/-- **The divisor of a unit of `X` is supported on the punctures**: `div(u) = ∑ ordᵢ(u) [xᵢ]`. -/
theorem principalDivisor_unitFn (u : Additive Γ(X, ⊤)ˣ) :
    principalDivisor Xbar (toRat (unitFn j u.toMul) (unitFn_ne_zero j _)) =
      wsum k fbar x h (ordHom j x u) := by
  refine Subtype.ext (funext fun Z => ?_)
  rw [principalDivisor_toRat_apply]
  rcases primeDivisor_cases k fbar j x hxinj hxS h Z with ⟨W, rfl⟩ | ⟨i, rfl⟩
  · rw [ord_unitFn_primeDivisorMap, wsum_apply_primeDivisorMap k fbar j x hxS h]
  · rw [wsum_apply_Zp k fbar x hxinj h, ordHom_apply, genericPoint_Zp]

include hxinj hxS in
/-- **The image of the orders at the punctures is the lattice of relations among the `cᵢ`.** -/
theorem mem_range_ordHom_iff (d : Fin (r' + 1) → ℤ) :
    d ∈ (ordHom j x (X := X)).range ↔ ∑ i, d i • cls k fbar x h i = 0 := by
  have := isNormal k f
  constructor
  · rintro ⟨u, rfl⟩
    apply (picardEquivClass k fbar).injective
    rw [picardEquivClass_sum_cls, map_zero, mk_eq_zero_iff]
    exact ⟨_, principalDivisor_unitFn (k := k) (f := f) (fbar := fbar) (j := j) (x := x)
      (hxinj := hxinj) (hxS := hxS) (h := h) u⟩
  · intro hd
    have h0 : ((wsum k fbar x h d : WeilDivisor Xbar) : weilDivisorClassGroup Xbar) = 0 := by
      rw [← picardEquivClass_sum_cls, hd, map_zero]
    obtain ⟨g, hg⟩ := (mk_eq_zero_iff _ _).1 h0
    set z : Xbar.functionField := (Stacks.Chow.rationalFunctionsEquivFunctionField Xbar).1 g
    have hz : z ≠ 0 :=
      (g.isUnit.map (Stacks.Chow.rationalFunctionsEquivFunctionField Xbar).1.toRingHom).ne_zero
    have hzZ : ∀ Z, Xbar.ord z Z.genericPoint = (wsum k fbar x h d).1 Z := fun Z => by
      rw [← hg, principalDivisor_apply]
    set ψ := Stacks.Chow.functionFieldEquiv_openImmersion j
    obtain ⟨a, ha⟩ := exists_unit_of_forall_ord_eq_zero (X := X) (z := ψ z)
      ((map_ne_zero_iff _ ψ.injective).2 hz) fun y hy => by
        have hy' :
            j.base y = (primeDivisorMap j (PrimeDivisor.ofCoheightOne y hy)).genericPoint := by
          rw [genericPoint_primeDivisorMap, PrimeDivisor.genericPoint_ofCoheightOne]
        rw [Stacks.Chow.ord_functionFieldEquiv_openImmersion, hy', hzZ,
          wsum_apply_primeDivisorMap k fbar j x hxS h]
    refine ⟨Additive.ofMul a, funext fun i => ?_⟩
    rw [ordHom_apply, toMul_ofMul, unitFn, ha, RingEquiv.symm_apply_apply,
      ← genericPoint_Zp k fbar x h i, hzZ, wsum_apply_Zp k fbar x hxinj h]

include hxinj hxS h in
omit [Smooth f] in
/-- **A unit of `X` with all its orders at the punctures zero is an `n`-th power**: it is a
constant (Hartogs on `X̄` and [Stacks, Tag 04L2]), and `k` is algebraically closed. -/
theorem exists_nsmul_eq_of_ordHom_eq_zero [IsProper fbar] {n : ℕ} (hn : 0 < n)
    (u : Additive Γ(X, ⊤)ˣ) (hu : ordHom j x u = 0) : ∃ v, u = n • v := by
  have := isNormal k fbar
  have : IsProperVariety k fbar := {}
  set z := unitFn j u.toMul
  have hz0 : ∀ y : Xbar, coheight y = 1 → Xbar.ord z y = 0 := by
    intro y hy
    have hdiv := congrArg (fun D : WeilDivisor Xbar => D.1 (PrimeDivisor.ofCoheightOne y hy))
      (principalDivisor_unitFn (k := k) (f := f) (fbar := fbar) (j := j) (x := x)
        (hxinj := hxinj) (hxS := hxS) (h := h) u)
    simp only [principalDivisor_toRat_apply, PrimeDivisor.genericPoint_ofCoheightOne] at hdiv
    rw [hdiv, hu, wsum]
    simp
  obtain ⟨a, ha⟩ := exists_unit_of_forall_ord_eq_zero (unitFn_ne_zero j u.toMul) hz0
  obtain ⟨c, hc⟩ := (Stacks.AlgebraicGeometry.UnitsNormalProper.bijective_structMap k fbar).2 a.1
  obtain ⟨c', rfl⟩ := IsAlgClosed.exists_pow_nat_eq c hn
  have hc' : c' ≠ 0 := by
    rintro rfl
    rw [zero_pow hn.ne', map_zero] at hc
    exact a.ne_zero hc.symm
  set a' : Γ(Xbar, ⊤)ˣ := (Units.mk0 c' hc').map
    (Stacks.AlgebraicGeometry.UnitsNormalProper.structMap k fbar).toMonoidHom
  have hle : (⊤ : X.Opens) ≤ j ⁻¹ᵁ ⊤ := fun _ _ => trivial
  set v : Γ(X, ⊤)ˣ := a'.map (j.appLE ⊤ ⊤ hle).hom.toMonoidHom
  refine ⟨Additive.ofMul v, ?_⟩
  apply Additive.toMul.injective
  rw [toMul_nsmul, toMul_ofMul]
  apply Units.ext
  apply germ_injective_of_isIntegral (X := X) (U := ⊤) (genericPoint X) trivial
  have : Nonempty (⊤ : X.Opens) := ⟨⟨genericPoint X, trivial⟩⟩
  have : Nonempty (⊤ : Xbar.Opens) := ⟨⟨genericPoint Xbar, trivial⟩⟩
  have hgerm := dominantFunctionFieldMap_germToFunctionField_of_mem j (genericPoint X) ⊤ trivial
    ⊤ trivial hle a'.1
  have hz : X.presheaf.germ ⊤ (genericPoint X) trivial u.toMul.1 =
      Stacks.Chow.functionFieldEquiv_openImmersion j z := by
    simp [z, unitFn]
  have ha' : a.1 = a'.1 ^ n := by rw [← hc]; simp [a', map_pow]
  have hzz : z = (Xbar.germToFunctionField ⊤).hom a'.1 ^ n := by
    rw [← map_pow, ← ha']
    exact ha.symm
  rw [hz, Units.val_pow_eq_pow_val, map_pow, hzz, map_pow]
  congr 1

end Units

end AlgebraicGeometry.AffineCurveRankData

