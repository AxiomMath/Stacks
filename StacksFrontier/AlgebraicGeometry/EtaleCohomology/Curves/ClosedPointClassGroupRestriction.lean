module

public import StacksFrontier.AlgebraicGeometry.AmpleDimensionOne.Basic
public import StacksFrontier.AlgebraicGeometry.Chow.RationalFunctions.OpenImmersion
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Curves.MultiplicativeGroupDivisorClass

/-!
# The divisor class group of an open subcurve

Let `j : U ⟶ Y` be an open immersion of curves over a field `k`. The closed points of `U` are
closed points of `Y`, the two function fields are identified, and orders of vanishing agree. So
restricting a divisor on `Y` to `U` induces a surjection of class groups

`(Y_0 →₀ 𝐙)/div(K^*) → (U_0 →₀ 𝐙)/div(K^*)`

whose kernel is generated by the classes of the points of `Y` not in `U`. For a smooth curve `X`
with smooth projective compactification `X ⊂ X̄` (Tag 0H1F) this presents the class group of `X`
as the quotient of the class group of `X̄` by the finitely many points at infinity.

## Main definitions

* `Stacks.EtaleCohomology.closedPointsMapOfOpenImmersion`: the closed points of `U` as closed
  points of `Y`.
* `Stacks.EtaleCohomology.closedPointClassGroupRestriction`: the restriction of divisor classes.

## Main results

* `Stacks.EtaleCohomology.surjective_closedPointClassGroupRestriction`
* `Stacks.EtaleCohomology.ker_closedPointClassGroupRestriction`: the kernel is generated by the
  classes of the points of `Y` outside `U`.
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace AlgebraicGeometry

universe u

namespace Stacks.EtaleCohomology

variable {k : Type u} [Field k] {U Y : Scheme.{u}} (p : U ⟶ Spec (.of k)) (q : Y ⟶ Spec (.of k))
  [IsCurve k p] [IsCurve k q] (j : U ⟶ Y) [IsOpenImmersion j] [IsIntegral U] [IsIntegral Y]

include p q in
/-- A nonempty open subscheme of an irreducible scheme is dense. -/
theorem isDominant_of_isOpenImmersion_of_isCurve : IsDominant j :=
  ⟨j.isOpenEmbedding.isOpen_range.dense (Set.range_nonempty _)⟩

include p q in
/-- **A closed point of an open subcurve is a closed point of the curve.** It is not the generic
point of `U`, so its image is not the generic point of `Y`, and every other point of a
one-dimensional integral scheme is closed. -/
theorem isClosed_singleton_base_of_mem_closedPoints (x : closedPoints U) :
    IsClosed ({j.base x.1} : Set Y) := by
  have := isDominant_of_isOpenImmersion_of_isCurve p q j
  refine Stacks.AlgebraicGeometry.AmpleDimensionOne.isClosed_singleton_of_ne_genericPoint Y
    (IsCurve.topologicalKrullDim_eq_one q) fun h => ?_
  have hη : j.base (genericPoint U) = genericPoint Y :=
    ((tfae_isDominant_of_isIntegral j).out 1 2).mp (inferInstance : IsDominant j)
  exact ne_genericPoint_of_mem_closedPoints_of_isCurve p x
    (j.isOpenEmbedding.injective (h.trans hη.symm))

/-- **The closed points of an open subcurve, as closed points of the curve.** -/
def closedPointsMapOfOpenImmersion (x : closedPoints U) : closedPoints Y :=
  ⟨j.base x.1, isClosed_singleton_base_of_mem_closedPoints p q j x⟩

/-- The image of a closed point of `U` is its image under `j`. -/
@[simp]
theorem closedPointsMapOfOpenImmersion_coe (x : closedPoints U) :
    (closedPointsMapOfOpenImmersion p q j x : Y) = j.base x.1 :=
  rfl

/-- Distinct closed points of `U` stay distinct in `Y`. -/
theorem injective_closedPointsMapOfOpenImmersion :
    Function.Injective (closedPointsMapOfOpenImmersion p q j) := fun _ _ h =>
  Subtype.ext (j.isOpenEmbedding.injective (congrArg Subtype.val h))

/-- **A closed point of the curve lying in the open subcurve comes from a closed point of it.** -/
theorem exists_closedPointsMapOfOpenImmersion_eq (y : closedPoints Y)
    (hy : y.1 ∈ Set.range j.base) :
    ∃ x, closedPointsMapOfOpenImmersion p q j x = y := by
  obtain ⟨x, hx⟩ := hy
  refine ⟨⟨x, ?_⟩, Subtype.ext hx⟩
  have hc : IsClosed (j.base ⁻¹' {y.1}) := y.2.preimage j.base.hom.continuous
  rwa [show j.base ⁻¹' {y.1} = {x} from Set.ext fun z => ⟨fun hz =>
    j.isOpenEmbedding.injective (hz.trans hx.symm), fun hz => hz ▸ hx⟩] at hc

/-- **Restricting divisors to the open subcurve**: the coefficient at a closed point of `U` is
the coefficient at its image. -/
def closedPointDivisorRestriction : (closedPoints Y →₀ ℤ) →+ (closedPoints U →₀ ℤ) :=
  Finsupp.comapDomain.addMonoidHom (injective_closedPointsMapOfOpenImmersion p q j)

/-- The coefficient of a restricted divisor at `x` is its coefficient at the image of `x`. -/
@[simp]
theorem closedPointDivisorRestriction_apply (d : closedPoints Y →₀ ℤ) (x : closedPoints U) :
    closedPointDivisorRestriction p q j d x = d (closedPointsMapOfOpenImmersion p q j x) :=
  rfl

/-- Every divisor on `U` is a restriction: extend it by zero. -/
theorem surjective_closedPointDivisorRestriction :
    Function.Surjective (closedPointDivisorRestriction p q j) := fun d =>
  ⟨Finsupp.mapDomain (closedPointsMapOfOpenImmersion p q j) d, Finsupp.ext fun x => by
    rw [closedPointDivisorRestriction_apply,
      Finsupp.mapDomain_apply (injective_closedPointsMapOfOpenImmersion p q j)]⟩

variable [IsLocallyNoetherian U] [IsLocallyNoetherian Y] [NoetherianSpace U] [NoetherianSpace Y]

/-- **The divisor of a rational function restricts to its divisor on the open subcurve.** -/
theorem closedPointDivisorRestriction_closedPointDivisorOfUnit
    (f : Additive (Y.functionField)ˣ) :
    haveI := isDominant_of_isOpenImmersion_of_isCurve p q j
    closedPointDivisorRestriction p q j (closedPointDivisorOfUnit Y f) =
      closedPointDivisorOfUnit U (Additive.ofMul
        (Units.map (Stacks.Chow.functionFieldEquiv_openImmersion j).toMonoidHom
          (Additive.toMul f))) := by
  have := isDominant_of_isOpenImmersion_of_isCurve p q j
  refine Finsupp.ext fun x => ?_
  rw [closedPointDivisorRestriction_apply, closedPointDivisorOfUnit_apply,
    closedPointDivisorOfUnit_apply]
  exact (Stacks.Chow.ord_functionFieldEquiv_openImmersion j _ x.1).symm

/-- **Restriction of divisor classes to an open subcurve.** -/
def closedPointClassGroupRestriction :
    closedPointClassGroup Y →+ closedPointClassGroup U :=
  QuotientAddGroup.map _ _ (closedPointDivisorRestriction p q j) <| by
    rintro _ ⟨f, rfl⟩
    exact ⟨_, (closedPointDivisorRestriction_closedPointDivisorOfUnit p q j f).symm⟩

/-- The restriction of the class of a divisor is the class of its restriction. -/
@[simp]
theorem closedPointClassGroupRestriction_mk (d : closedPoints Y →₀ ℤ) :
    closedPointClassGroupRestriction p q j (QuotientAddGroup.mk d) =
      QuotientAddGroup.mk (closedPointDivisorRestriction p q j d) :=
  rfl

/-- **Every divisor class on `U` is restricted from `Y`.** -/
theorem surjective_closedPointClassGroupRestriction :
    Function.Surjective (closedPointClassGroupRestriction p q j) := by
  intro c
  induction c using QuotientAddGroup.induction_on with
  | H d =>
    obtain ⟨d', rfl⟩ := surjective_closedPointDivisorRestriction p q j d
    exact ⟨QuotientAddGroup.mk d', rfl⟩

/-- A divisor whose restriction to `U` vanishes is a combination of the points outside `U`. -/
theorem mem_closure_of_closedPointDivisorRestriction_eq_zero (d : closedPoints Y →₀ ℤ)
    (hd : closedPointDivisorRestriction p q j d = 0) :
    d ∈ AddSubgroup.closure ((fun y => Finsupp.single y (1 : ℤ)) ''
      {y : closedPoints Y | y.1 ∉ Set.range j.base}) := by
  classical
  rw [← Finsupp.sum_single d]
  refine AddSubgroup.sum_mem _ fun y hy => ?_
  rw [← Finsupp.smul_single_one y (d y)]
  refine AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure (Set.mem_image_of_mem _ ?_)) _
  intro hmem
  obtain ⟨x, rfl⟩ := exists_closedPointsMapOfOpenImmersion_eq p q j y hmem
  exact (Finsupp.mem_support_iff.mp hy)
    (by rw [← closedPointDivisorRestriction_apply, hd, Finsupp.zero_apply])

/-- A divisor class restricting to zero is a combination of the points outside `U`. -/
private theorem ker_closedPointClassGroupRestriction_le :
    (closedPointClassGroupRestriction p q j).ker ≤ AddSubgroup.closure
      ((fun y => (QuotientAddGroup.mk (Finsupp.single y (1 : ℤ)) : closedPointClassGroup Y)) ''
        {y : closedPoints Y | y.1 ∉ Set.range j.base}) := by
  have := isDominant_of_isOpenImmersion_of_isCurve p q j
  intro c hc
  induction c using QuotientAddGroup.induction_on with
  | H d =>
    rw [AddMonoidHom.mem_ker, closedPointClassGroupRestriction_mk,
      QuotientAddGroup.eq_zero_iff] at hc
    obtain ⟨g, hg⟩ := hc
    let f : Additive (Y.functionField)ˣ := Additive.ofMul
      (Units.map (Stacks.Chow.functionFieldEquiv_openImmersion j).symm.toMonoidHom
        (Additive.toMul g))
    have hf : closedPointDivisorRestriction p q j (d - closedPointDivisorOfUnit Y f) = 0 := by
      rw [map_sub, ← hg, closedPointDivisorRestriction_closedPointDivisorOfUnit, sub_eq_zero]
      congr 2
      ext
      simp [f]
    have hmk : (QuotientAddGroup.mk d : closedPointClassGroup Y) =
        QuotientAddGroup.mk (d - closedPointDivisorOfUnit Y f) := by
      rw [QuotientAddGroup.eq]
      exact ⟨-f, by
        rw [map_neg]
        abel⟩
    rw [hmk, ← Set.image_image (QuotientAddGroup.mk : _ → closedPointClassGroup Y)]
    exact (AddMonoidHom.map_closure (QuotientAddGroup.mk' _) _).le
      ⟨_, mem_closure_of_closedPointDivisorRestriction_eq_zero p q j _ hf, rfl⟩

/-- The classes of the closed points of `Y` outside `U` restrict to zero. -/
private theorem closure_le_ker_closedPointClassGroupRestriction :
    AddSubgroup.closure
      ((fun y => (QuotientAddGroup.mk (Finsupp.single y (1 : ℤ)) : closedPointClassGroup Y)) ''
        {y : closedPoints Y | y.1 ∉ Set.range j.base}) ≤
      (closedPointClassGroupRestriction p q j).ker := by
  classical
  rw [AddSubgroup.closure_le]
  rintro _ ⟨y, hy, rfl⟩
  rw [SetLike.mem_coe, AddMonoidHom.mem_ker, closedPointClassGroupRestriction_mk,
    QuotientAddGroup.eq_zero_iff]
  refine ⟨0, Finsupp.ext fun x => ?_⟩
  rw [map_zero, Finsupp.zero_apply, closedPointDivisorRestriction_apply,
    Finsupp.single_apply, ite_eq_right]
  rintro rfl
  exact hy ⟨x.1, rfl⟩

/-- **The kernel of the restriction of divisor classes is generated by the classes of the closed
points of `Y` outside `U`.** -/
theorem ker_closedPointClassGroupRestriction :
    (closedPointClassGroupRestriction p q j).ker = AddSubgroup.closure
      ((fun y => (QuotientAddGroup.mk (Finsupp.single y (1 : ℤ)) : closedPointClassGroup Y)) ''
        {y : closedPoints Y | y.1 ∉ Set.range j.base}) :=
  le_antisymm (ker_closedPointClassGroupRestriction_le p q j)
    (closure_le_ker_closedPointClassGroupRestriction p q j)

end Stacks.EtaleCohomology

end
