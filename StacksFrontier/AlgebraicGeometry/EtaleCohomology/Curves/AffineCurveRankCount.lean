module

public import Mathlib.Algebra.Category.Grp.Injective
public import Mathlib.Topology.Instances.AddCircle.Real
public import Mathlib.LinearAlgebra.FreeModule.PID
public import Mathlib.LinearAlgebra.Dimension.Free
public import Mathlib.LinearAlgebra.Pi
public import Mathlib.Algebra.Group.Subgroup.Finsupp

/-!
# The rank count of Tag 03RR, as group theory

Let `X` be an affine smooth curve over an algebraically closed field `k`, `X ⊂ X̄` a smooth
projective compactification with `X̄ ∖ X = {x₀, …, x_{r'}}`, and `n` invertible in `k`. The proof
of [Stacks, Tag 03RR] counts the rank of `H¹_ét(X, μ_n)` from four pieces of data:

* `P = Pic(X̄)` with its degree, and the classes `cᵢ = [𝒪_{X̄}(xᵢ)]`, each of degree one;
* the restriction `ρ : Pic(X̄) ↠ Pic(X)`, whose kernel is generated by the `cᵢ`;
* the orders of vanishing `ord : Γ(X, 𝒪_X)^* ⟶ 𝐙^{r' + 1}` at the punctures, whose kernel is
  the constants `k^*` (all `n`-th powers) and whose image is the lattice of relations among the
  `cᵢ`;
* that `Pic⁰(X̄)` is `n`-divisible with `Pic⁰(X̄)[n] ≅ (𝐙/n𝐙)^{2g}`.

This file proves that these data force `H¹_ét(X, μ_n) ≅ (𝐙/n𝐙)^{2g + r'}`, for any abelian
group `H` killed by `n` that is an extension of `Pic(X)[n]` by `Γ(X, 𝒪_X)^*/n`, which is what the
Kummer sequence makes `H¹_ét(X, μ_n)`. Nothing here mentions a scheme.

## Implementation notes

The source's route is the four-term sequence
`0 → H¹(X̄, μ_n) → H¹(X, μ_n) → ⊕ᵢ 𝐙/n𝐙 → 𝐙/n𝐙 → 0`, built from the description of `H¹(X, μ_n)`
by triples `(L̄, D, ᾱ)`. Here that group of triples is built algebraically, as
`AlgebraicGeometry.AffineCurveRankCount.triples`: pairs `(p, d) ∈ P × 𝐙^{r'}` with
`n p = σ₀(d)`, where `σ₀(d) = ∑ dᵢ (c_{i+1} - c₀)` is the class of the degree-zero divisor `d`,
modulo the pairs `(σ₀(e), n e)`. It sits in two extensions:

* `0 → Pic(X̄)[n] → triples → (𝐙/n𝐙)^{r'} → 0`, which is the source's sequence, so `triples` is
  free of rank `2g + r'`;
* `0 → K/nK → triples → Pic(X)[n] → 0`, where `K = ker σ₀` is the lattice of principal boundary
  divisors.

The Kummer sequence presents `H` as an extension of `Pic(X)[n]` by `Γ(X, 𝒪_X)^*/n ≅ K/nK`. As
`K` is free, `K/nK` is a free `𝐙/n𝐙`-module, hence an injective one, so both extensions with
that kernel split (`AlgebraicGeometry.AffineCurveRankCount.nonempty_addEquiv_prod_of_surjective`),
and `H ≅ K/nK × Pic(X)[n] ≅ triples`.

The rank of `K` is *not* computed and is not `r'` in general: only the total is independent of
the configuration of the punctures in `Pic⁰(X̄)`, and that total is what comes out.

## References

* [Stacks Project, Tag 03RR](https://stacks.math.columbia.edu/tag/03RR)
-/

@[expose] public noncomputable section

open Function

namespace AlgebraicGeometry.AffineCurveRankCount

/-! ### Free `𝐙/n𝐙`-modules are injective among groups killed by `n` -/

section Splitting

variable {n : ℕ} [NeZero n]

/-- The `n`-torsion of `ℝ/ℤ` is the image of `𝐙/n𝐙`. -/
theorem exists_toAddCircle_eq (x : UnitAddCircle) (hx : n • x = 0) :
    ∃ a : ZMod n, ZMod.toAddCircle a = x := by
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective x
  have h0 : ((n * t : ℝ) : UnitAddCircle) = 0 := by
    rwa [← nsmul_eq_mul, AddCircle.coe_nsmul]
  obtain ⟨k, hk⟩ := (AddCircle.coe_eq_zero_iff (1 : ℝ)).1 h0
  refine ⟨k, ?_⟩
  rw [ZMod.toAddCircle_intCast]
  have hn : (n : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (NeZero.ne n)
  have ht : t = (k : ℝ) / n := by
    rw [zsmul_eq_mul, mul_one] at hk
    field_simp
    linarith
  rw [ht]

/-- **A homomorphism to `𝐙/n𝐙` extends from a subgroup of a group killed by `n`.** `ℝ/ℤ` is
divisible, hence an injective abelian group, and a group killed by `n` maps into its `n`-torsion,
which is `𝐙/n𝐙`. -/
theorem exists_extension {G : Type*} [AddCommGroup G] (htor : ∀ x : G, n • x = 0)
    (F : AddSubgroup G) (χ : F →+ ZMod n) : ∃ s : G →+ ZMod n, ∀ x : F, s x = χ x := by
  obtain ⟨h, hh⟩ := (Module.Baer.of_divisible UnitAddCircle).extension_property_addMonoidHom
    F.subtype F.subtype_injective (ZMod.toAddCircle.comp χ)
  have hs : ∀ g : G, ∃ a : ZMod n, ZMod.toAddCircle a = h g := fun g =>
    exists_toAddCircle_eq _ (by rw [← map_nsmul, htor, map_zero])
  choose s hs using hs
  refine ⟨{ toFun := s, map_zero' := ?_, map_add' := ?_ }, ?_⟩
  · apply ZMod.toAddCircle_injective n
    rw [hs, map_zero, map_zero]
  · intro a b
    apply ZMod.toAddCircle_injective n
    rw [map_add, hs, hs, hs, map_add]
  · intro x
    apply ZMod.toAddCircle_injective n
    show ZMod.toAddCircle (s x) = _
    rw [hs]
    exact congrArg (fun φ : F →+ UnitAddCircle => φ x) hh

/-- **An extension of a group by a free `𝐙/n𝐙`-module of finite rank, killed by `n`, splits.** -/
theorem nonempty_addEquiv_prod_of_surjective {G Q : Type*} [AddCommGroup G] [AddCommGroup Q]
    (htor : ∀ x : G, n • x = 0) (π : G →+ Q) (hπ : Surjective π) {m : ℕ}
    (e : ↥π.ker ≃+ (Fin m → ZMod n)) : Nonempty (G ≃+ (Fin m → ZMod n) × Q) := by
  have key : ∀ i : Fin m, ∃ s : G →+ ZMod n, ∀ x : π.ker, s x = e x i := fun i =>
    exists_extension htor π.ker ((Pi.evalAddMonoidHom (fun _ => ZMod n) i).comp e.toAddMonoidHom)
  choose s hs using key
  let r : G →+ (Fin m → ZMod n) :=
    { toFun := fun g i => s i g
      map_zero' := funext fun i => map_zero (s i)
      map_add' := fun a b => funext fun i => map_add (s i) a b }
  have hr : ∀ x : π.ker, r x = e x := fun x => funext fun i => hs i x
  refine ⟨AddEquiv.ofBijective (r.prod π) ⟨?_, ?_⟩⟩
  · rw [injective_iff_map_eq_zero]
    intro g hg
    have h1 : r g = 0 := congrArg Prod.fst hg
    have h2 : π g = 0 := congrArg Prod.snd hg
    have h3 : e ⟨g, h2⟩ = 0 := by rwa [← hr]
    have : (⟨g, h2⟩ : π.ker) = 0 := e.injective (by rw [h3, map_zero])
    exact congrArg Subtype.val this
  · rintro ⟨a, q⟩
    obtain ⟨g, rfl⟩ := hπ q
    refine ⟨g + (e.symm (a - r g) : G), ?_⟩
    have hmem : π (e.symm (a - r g) : G) = 0 := (e.symm (a - r g)).2
    simp only [AddMonoidHom.prod_apply, map_add, hmem, hr, AddEquiv.apply_symm_apply]
    ext <;> simp

/-- `(𝐙/n𝐙)^a × (𝐙/n𝐙)^b ≅ (𝐙/n𝐙)^{a + b}`. -/
def finProdEquiv (a b : ℕ) : (Fin a → ZMod n) × (Fin b → ZMod n) ≃+ (Fin (a + b) → ZMod n) :=
  (LinearEquiv.sumArrowLequivProdArrow (Fin a) (Fin b) ℤ (ZMod n)).symm.toAddEquiv.trans
    (LinearEquiv.funCongrLeft ℤ (ZMod n) finSumFinEquiv.symm).toAddEquiv

end Splitting

/-! ### Quotients by `n` of free abelian groups -/

section Quotients

variable (n : ℕ)

/-- Reduction mod `n`, coordinatewise. -/
def reduceMod (m : ℕ) : (Fin m → ℤ) →+ (Fin m → ZMod n) where
  toFun d i := (d i : ZMod n)
  map_zero' := funext fun _ => Int.cast_zero
  map_add' d e := funext fun i => Int.cast_add (d i) (e i)

/-- The `i`-th coordinate of `reduceMod n m d` is `d i` mod `n`. -/
@[simp] theorem reduceMod_apply {m : ℕ} (d : Fin m → ℤ) (i : Fin m) :
    reduceMod n m d i = (d i : ZMod n) := rfl

/-- Reduction mod `n` from `𝐙^m` to `(𝐙/n𝐙)^m` is surjective. -/
theorem surjective_reduceMod (m : ℕ) : Surjective (reduceMod n m) := fun a =>
  ⟨fun i => ((a i).cast : ℤ), funext fun i => by simp⟩

/-- `d ∈ 𝐙^m` reduces to zero mod `n` if and only if `n` divides every coordinate of `d`. -/
theorem reduceMod_eq_zero_iff [NeZero n] {m : ℕ} (d : Fin m → ℤ) :
    reduceMod n m d = 0 ↔ ∀ i, (n : ℤ) ∣ d i := by
  rw [funext_iff]
  simp [ZMod.intCast_zmod_eq_zero_iff_dvd]

/-- `nA`, the subgroup of multiples of `n`. -/
abbrev nsmulRange (A : Type*) [AddCommGroup A] : AddSubgroup A :=
  (n • AddMonoidHom.id A).range

/-- `x` lies in `nA` if and only if `x = n y` for some `y ∈ A`. -/
theorem mem_nsmulRange {A : Type*} [AddCommGroup A] (x : A) :
    x ∈ nsmulRange n A ↔ ∃ y, n • y = x := by
  simp [nsmulRange]

/-- `𝐙^m / n ≅ (𝐙/n𝐙)^m`. -/
def piIntQuotientEquiv [NeZero n] (m : ℕ) :
    (Fin m → ℤ) ⧸ nsmulRange n (Fin m → ℤ) ≃+ (Fin m → ZMod n) := by
  have hker : (reduceMod n m).ker = nsmulRange n (Fin m → ℤ) := by
    ext d
    rw [AddMonoidHom.mem_ker, mem_nsmulRange, reduceMod_eq_zero_iff]
    constructor
    · intro h
      choose y hy using h
      exact ⟨y, funext fun i => by simp [hy i, nsmul_eq_mul]⟩
    · rintro ⟨y, rfl⟩ i
      exact ⟨y i, by simp [nsmul_eq_mul]⟩
  exact (QuotientAddGroup.quotientAddEquivOfEq hker.symm).trans
    (QuotientAddGroup.quotientKerEquivOfSurjective _ (surjective_reduceMod n m))

/-- Isomorphic groups have isomorphic quotients by `n`. -/
def quotientNsmulCongr {A B : Type*} [AddCommGroup A] [AddCommGroup B] (e : A ≃+ B) :
    A ⧸ nsmulRange n A ≃+ B ⧸ nsmulRange n B :=
  QuotientAddGroup.congr _ _ e (by
    ext x
    simp only [AddSubgroup.mem_map, mem_nsmulRange]
    constructor
    · rintro ⟨_, ⟨y, rfl⟩, rfl⟩; exact ⟨e y, by simp⟩
    · rintro ⟨y, rfl⟩; exact ⟨n • e.symm y, ⟨e.symm y, rfl⟩, by simp⟩)

/-- **A subgroup of `𝐙^r` has free quotient by `n`**: it is free of finite rank `m`, so its
quotient by `n` is `(𝐙/n𝐙)^m`. -/
theorem exists_quotient_nsmul_equiv [NeZero n] {r : ℕ} (K : AddSubgroup (Fin r → ℤ)) :
    ∃ m : ℕ, Nonempty (↥K ⧸ nsmulRange n ↥K ≃+ (Fin m → ZMod n)) := by
  let K' : Submodule ℤ (Fin r → ℤ) := AddSubgroup.toIntSubmodule K
  refine ⟨Module.finrank ℤ K', ⟨?_⟩⟩
  have e : ↥K ≃+ (Fin (Module.finrank ℤ K') → ℤ) := (Module.finBasis ℤ K').equivFun.toAddEquiv
  exact (quotientNsmulCongr n e).trans (piIntQuotientEquiv n _)

/-- **`U/nU ≅ K/nK`** for a homomorphism `ord : U ⟶ 𝐙^r` with image `K` whose kernel consists of
`n`-th multiples: the units of the affine curve modulo `n`-th powers, against the lattice of
principal boundary divisors, the constants `k^*` being `n`-divisible. -/
def unitsQuotientEquiv {U : Type*} [AddCommGroup U] {r : ℕ} (ord : U →+ (Fin r → ℤ))
    (hker : ∀ u, ord u = 0 → ∃ v, u = n • v) :
    U ⧸ nsmulRange n U ≃+ ↥ord.range ⧸ nsmulRange n ↥ord.range := by
  let f : U →+ ↥ord.range ⧸ nsmulRange n ↥ord.range :=
    (QuotientAddGroup.mk' _).comp ord.rangeRestrict
  have hf : Surjective f :=
    (QuotientAddGroup.mk'_surjective _).comp ord.rangeRestrict_surjective
  have hk : f.ker = nsmulRange n U := by
    ext u
    rw [AddMonoidHom.mem_ker, mem_nsmulRange]
    simp only [f, AddMonoidHom.comp_apply, QuotientAddGroup.mk'_apply,
      QuotientAddGroup.eq_zero_iff, mem_nsmulRange]
    constructor
    · rintro ⟨⟨_, v, rfl⟩, hy⟩
      have hy' : n • ord v = ord u := congrArg Subtype.val hy
      obtain ⟨w, hw⟩ := hker (u - n • v) (by rw [map_sub, map_nsmul, hy', sub_self])
      exact ⟨v + w, by rw [nsmul_add, ← hw]; abel⟩
    · rintro ⟨v, rfl⟩
      exact ⟨ord.rangeRestrict v, by ext; simp⟩
  exact (QuotientAddGroup.quotientAddEquivOfEq hk.symm).trans
    (QuotientAddGroup.quotientKerEquivOfSurjective f hf)

end Quotients

/-! ### The group of triples -/

section Triples

variable {n : ℕ} {P Q : Type*} [AddCommGroup P] [AddCommGroup Q] {r' : ℕ}
  (c : Fin (r' + 1) → P)

/-- `σ₀(d) = ∑ dᵢ (c_{i+1} - c₀)`, the class of the degree-zero boundary divisor with
coordinates `d`. -/
def sigma0 : (Fin r' → ℤ) →+ P where
  toFun d := ∑ i, d i • (c i.succ - c 0)
  map_zero' := by simp
  map_add' d e := by simp [add_zsmul, Finset.sum_add_distrib]

/-- `σ₀(d) = ∑ dᵢ (c_{i+1} - c₀)`. -/
theorem sigma0_apply (d : Fin r' → ℤ) : sigma0 c d = ∑ i, d i • (c i.succ - c 0) := rfl

/-- `∑ dᵢ cᵢ = σ₀(e)` for the divisor `d = (-∑ eᵢ, e)` of degree zero. -/
private theorem sum_cons_neg_sum_smul (e : Fin r' → ℤ) :
    ∑ i, (Fin.cons (-∑ j, e j) e : Fin (r' + 1) → ℤ) i • c i = sigma0 c e := by
  rw [Fin.sum_univ_succ, sigma0_apply]
  simp only [Fin.cons_zero, Fin.cons_succ, smul_sub, Finset.sum_sub_distrib, ← Finset.sum_smul,
    neg_smul]
  abel

/-- `σ₀(m d) = m σ₀(d)` for a natural number `m`. -/
@[simp] theorem sigma0_natCast_mul (m : ℕ) (d : Fin r' → ℤ) :
    sigma0 c ((m : Fin r' → ℤ) * d) = m • sigma0 c d := by
  rw [← nsmul_eq_mul, map_nsmul]

variable (n)

/-- The pairs `(p, d)` with `n p = σ₀(d)`. -/
def pairs : AddSubgroup (P × (Fin r' → ℤ)) :=
  (n • AddMonoidHom.fst P (Fin r' → ℤ) - (sigma0 c).comp (AddMonoidHom.snd P _)).ker

/-- `(p, d)` lies in `pairs n c` if and only if `n p = σ₀(d)`. -/
theorem mem_pairs (x : P × (Fin r' → ℤ)) : x ∈ pairs n c ↔ n • x.1 = sigma0 c x.2 := by
  simp [pairs, sub_eq_zero]

/-- The trivial pairs `(σ₀(e), n e)`. -/
def trivialPairs : (Fin r' → ℤ) →+ pairs n c :=
  ((sigma0 c).prod (n • AddMonoidHom.id _)).codRestrict (pairs n c) fun e => by
    rw [mem_pairs]; exact (map_nsmul (sigma0 c) n e).symm

/-- **The group of triples** `(L̄, D, ᾱ)` of the proof of [Stacks, Tag 03RR], algebraically. -/
abbrev triples : Type _ := pairs n c ⧸ (trivialPairs n c).range

variable {n c}

/-- The class of the pair `(p, d)` is trivial iff `(p, d) = (σ₀(e), n e)` for some `e`. -/
private theorem mk_eq_zero_iff (x : pairs n c) :
    (QuotientAddGroup.mk x : triples n c) = 0 ↔
      ∃ e, sigma0 c e = (x : P × (Fin r' → ℤ)).1 ∧ n • e = (x : P × (Fin r' → ℤ)).2 := by
  rw [QuotientAddGroup.eq_zero_iff]
  exact ⟨fun ⟨e, he⟩ => ⟨e, congrArg (fun x : pairs n c => x.1.1) he,
    congrArg (fun x : pairs n c => x.1.2) he⟩, fun ⟨e, h1, h2⟩ => ⟨e, Subtype.ext (Prod.ext h1 h2)⟩⟩

/-- The group of triples is killed by `n`. -/
theorem triples_nsmul_eq_zero (x : triples n c) : n • x = 0 := by
  obtain ⟨⟨⟨p, d⟩, h⟩, rfl⟩ := QuotientAddGroup.mk_surjective x
  rw [← QuotientAddGroup.mk_nsmul, mk_eq_zero_iff]
  exact ⟨d, ((mem_pairs n c _).1 h).symm, rfl⟩

variable (deg : P →+ ℤ) (hc : ∀ i, deg (c i) = 1)
include hc

/-- If every `cᵢ` has degree one, then every `σ₀(d)` has degree zero. -/
theorem deg_sigma0 (d : Fin r' → ℤ) : deg (sigma0 c d) = 0 := by
  simp [sigma0_apply, map_sum, hc]

/-- An element of the subgroup generated by the `cᵢ` of degree zero is a `σ₀(d)`. -/
theorem exists_sigma0_eq {x : P} (hx : x ∈ AddSubgroup.closure (Set.range c))
    (hdeg : deg x = 0) : ∃ d, sigma0 c d = x := by
  obtain ⟨a, rfl⟩ := (AddSubgroup.mem_closure_range_iff_of_fintype).1 hx
  refine ⟨fun i => a i.succ, ?_⟩
  rw [map_sum] at hdeg
  simp only [map_zsmul, hc, smul_eq_mul, mul_one, Fin.sum_univ_succ] at hdeg
  rw [sigma0_apply, Fin.sum_univ_succ]
  have h0 : a 0 = -∑ i : Fin r', a i.succ := by linarith
  simp only [smul_sub, Finset.sum_sub_distrib, ← Finset.sum_smul, h0, neg_smul]
  abel

/-- A relation `∑ dᵢ cᵢ = 0` among the `cᵢ` gives `σ₀(d₁, …, d_{r'}) = 0` and
`d₀ = -∑ d_{i+1}`. -/
private theorem sigma0_succ_eq_zero_of_sum_eq_zero {d : Fin (r' + 1) → ℤ}
    (hd : ∑ i, d i • c i = 0) :
    sigma0 c (fun i => d i.succ) = 0 ∧ d 0 = -∑ i : Fin r', d i.succ := by
  have hdeg := congrArg deg hd
  simp only [map_sum, map_zsmul, hc, smul_eq_mul, mul_one, map_zero] at hdeg
  rw [Fin.sum_univ_succ] at hdeg
  have h0 : d 0 = -∑ i : Fin r', d i.succ := by linarith
  refine ⟨?_, h0⟩
  rw [Fin.sum_univ_succ, h0] at hd
  rw [sigma0_apply, ← hd]
  simp only [smul_sub, Finset.sum_sub_distrib, ← Finset.sum_smul, neg_smul]
  abel

/-- Every `σ₀(d)` lies in the subgroup generated by the `cᵢ`. -/
theorem sigma0_mem_closure (d : Fin r' → ℤ) :
    sigma0 c d ∈ AddSubgroup.closure (Set.range c) := by
  rw [sigma0_apply]
  exact AddSubgroup.sum_mem _ fun i _ => AddSubgroup.zsmul_mem _
    (AddSubgroup.sub_mem _ (AddSubgroup.subset_closure (Set.mem_range_self _))
      (AddSubgroup.subset_closure (Set.mem_range_self _))) _

omit hc in
/-- The `n`-torsion `A[n]` of `A`. -/
abbrev torsion (n : ℕ) (A : Type*) [AddCommGroup A] : AddSubgroup A :=
  (n • AddMonoidHom.id A).ker

/-! #### First extension: `0 → P[n] → triples → (𝐙/n𝐙)^{r'} → 0` -/

omit hc in
/-- The coordinates mod `n` of the divisor of a triple. -/
def triplesToDivisor : triples n c →+ (Fin r' → ZMod n) :=
  QuotientAddGroup.lift _
    ((reduceMod n r').comp ((AddMonoidHom.snd P _).comp (pairs n c).subtype))
    (by
      rintro _ ⟨e, rfl⟩
      funext i
      simp [trivialPairs])

omit hc in
/-- The coordinates mod `n` of the divisor of the class of a pair `(p, d)` are those of `d`. -/
@[simp] theorem triplesToDivisor_mk (x : pairs n c) (i : Fin r') :
    triplesToDivisor (QuotientAddGroup.mk x : triples n c) i =
      ((x : P × (Fin r' → ℤ)).2 i : ZMod n) := rfl

/-- If the degree-zero part of `P` is `n`-divisible, then `triplesToDivisor` is surjective. -/
theorem surjective_triplesToDivisor (hdiv : ∀ x, deg x = 0 → ∃ y, x = n • y) :
    Surjective (triplesToDivisor (n := n) (c := c)) := by
  intro a
  let d : Fin r' → ℤ := fun i => ((a i).cast : ℤ)
  obtain ⟨y, hy⟩ := hdiv (sigma0 c d) (deg_sigma0 deg hc d)
  refine ⟨QuotientAddGroup.mk ⟨(y, d), (mem_pairs n c _).2 hy.symm⟩, funext fun i => ?_⟩
  rw [triplesToDivisor_mk]
  exact ZMod.intCast_zmod_cast (a i)

omit hc in
/-- The torsion class `t ∈ P[n]` as the triple `(t, 0)`. -/
def torsionToTriples : torsion n P →+ triples n c :=
  (QuotientAddGroup.mk' _).comp
    (((AddMonoidHom.inl P (Fin r' → ℤ)).comp (torsion n P).subtype).codRestrict (pairs n c)
      fun t => by
        rw [mem_pairs]
        change n • (t : P) = sigma0 c 0
        rw [map_zero]
        exact AddMonoidHom.mem_ker.1 t.2)

omit hc in
/-- `torsionToTriples` induces an isomorphism of `P[n]` onto the kernel of `triplesToDivisor`. -/
theorem torsionEquivKer [NeZero n] :
    ∃ e : torsion n P ≃+ ↥(triplesToDivisor (n := n) (c := c)).ker,
      ∀ t, (e t : triples n c) = torsionToTriples t := by
  have hmem : ∀ t, torsionToTriples (n := n) (c := c) t ∈
      (triplesToDivisor (n := n) (c := c)).ker := fun t => by
    rw [AddMonoidHom.mem_ker]
    funext i
    show ((0 : Fin r' → ℤ) i : ZMod n) = 0
    simp
  let φ := (torsionToTriples (n := n) (c := c)).codRestrict _ hmem
  refine ⟨AddEquiv.ofBijective φ ⟨?_, ?_⟩, fun t => rfl⟩
  · rw [injective_iff_map_eq_zero]
    intro t ht
    have ht' : torsionToTriples (n := n) (c := c) t = 0 := congrArg Subtype.val ht
    obtain ⟨e, h1, h2⟩ := (mk_eq_zero_iff _).1 ht'
    change sigma0 c e = t at h1
    change n • e = 0 at h2
    have he0 : e = 0 := by
      funext i
      have := congrFun h2 i
      rw [Pi.smul_apply, Pi.zero_apply, smul_eq_zero] at this
      exact this.resolve_left (NeZero.ne n)
    apply Subtype.ext
    rw [← h1, he0, map_zero]
    rfl
  · rintro ⟨x, hx⟩
    obtain ⟨⟨⟨p, d⟩, h⟩, rfl⟩ := QuotientAddGroup.mk_surjective x
    rw [mem_pairs] at h
    have hd : ∀ i, (n : ℤ) ∣ d i := fun i => by
      have := congrFun (AddMonoidHom.mem_ker.1 hx) i
      rw [triplesToDivisor_mk] at this
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).1 this
    choose e he using hd
    have hde : d = n • e := funext fun i => by simp [he i]
    have ht : p - sigma0 c e ∈ torsion n P := by
      rw [AddMonoidHom.mem_ker]
      simp [smul_sub, h, hde]
    refine ⟨⟨_, ht⟩, Subtype.ext ?_⟩
    show QuotientAddGroup.mk _ = QuotientAddGroup.mk _
    rw [QuotientAddGroup.eq]
    refine ⟨e, Subtype.ext ?_⟩
    simp [trivialPairs, hde]

/-! #### Second extension: `0 → K/nK → triples → Q[n] → 0` -/

variable (ρ : P →+ Q) (hker : ρ.ker = AddSubgroup.closure (Set.range c))
include hker

/-- The class in `Q[n]` of a triple. -/
def triplesToTorsion : triples n c →+ torsion n Q :=
  QuotientAddGroup.lift _
    ((ρ.comp ((AddMonoidHom.fst P _).comp (pairs n c).subtype)).codRestrict (torsion n Q)
      fun x => by
        rw [AddMonoidHom.mem_ker]
        have h := (mem_pairs n c _).1 x.2
        simp only [AddMonoidHom.comp_apply, AddSubgroup.coe_subtype, AddMonoidHom.coe_fst,
          AddMonoidHom.smul_apply, AddMonoidHom.id_apply]
        rw [← map_nsmul, h, ← AddMonoidHom.mem_ker, hker]
        exact sigma0_mem_closure deg hc _)
    (by
      rintro _ ⟨e, rfl⟩
      apply Subtype.ext
      simp only [AddMonoidHom.codRestrict_apply, AddMonoidHom.comp_apply,
        AddSubgroup.coe_subtype, AddMonoidHom.coe_fst, ZeroMemClass.coe_zero]
      change ρ (sigma0 c e) = 0
      rw [← AddMonoidHom.mem_ker, hker]
      exact sigma0_mem_closure deg hc _)

omit hker in
/-- If `n p = σ₀(d)` with `n ≠ 0`, then `p` has degree zero. -/
theorem deg_eq_zero_of_mem_pairs [NeZero n] {p : P} {d : Fin r' → ℤ}
    (h : n • p = sigma0 c d) : deg p = 0 := by
  have := congrArg deg h
  rw [map_nsmul, deg_sigma0 deg hc] at this
  simpa [NeZero.ne n] using this

/-- If `ρ` is surjective, then so is `triplesToTorsion`. -/
theorem surjective_triplesToTorsion [NeZero n] (hρ : Surjective ρ) :
    Surjective (triplesToTorsion deg hc ρ hker (n := n)) := by
  rintro ⟨q, hq⟩
  obtain ⟨p', rfl⟩ := hρ q
  let p := p' - deg p' • c 0
  have hc0 : ρ (c 0) = 0 := by
    rw [← AddMonoidHom.mem_ker, hker]
    exact AddSubgroup.subset_closure ⟨0, rfl⟩
  have hρp : ρ p = ρ p' := by simp [p, hc0]
  have hdeg : deg (n • p) = 0 := by simp [p, hc]
  have hmem : n • p ∈ AddSubgroup.closure (Set.range c) := by
    rw [← hker, AddMonoidHom.mem_ker, map_nsmul, hρp]
    simpa using hq
  obtain ⟨d, hd⟩ := exists_sigma0_eq deg hc hmem hdeg
  exact ⟨QuotientAddGroup.mk ⟨(p, d), (mem_pairs n c _).2 hd.symm⟩, Subtype.ext hρp⟩

/-- The principal boundary divisor `κ` as the triple `(0, κ)`. -/
def latticeToTriples : ↥(sigma0 c).ker →+ triples n c :=
  (QuotientAddGroup.mk' _).comp
    (((AddMonoidHom.inr P (Fin r' → ℤ)).comp (sigma0 c).ker.subtype).codRestrict (pairs n c)
      fun κ => by rw [mem_pairs]; simpa using κ.2.symm)

/-- `K/nK ≅ ker(triplesToTorsion)` for the lattice `K = ker σ₀`. -/
theorem latticeQuotientEquivKer [NeZero n] :
    Nonempty (↥(sigma0 c).ker ⧸ nsmulRange n ↥(sigma0 c).ker ≃+
      ↥(triplesToTorsion deg hc ρ hker (n := n)).ker) := by
  have hmem : ∀ κ, latticeToTriples (n := n) (c := c) κ ∈
      (triplesToTorsion deg hc ρ hker (n := n)).ker := fun _ =>
    AddMonoidHom.mem_ker.2 (Subtype.ext (map_zero ρ))
  let φ := (latticeToTriples (n := n) (c := c)).codRestrict _ hmem
  have hφ : Surjective φ := by
    rintro ⟨x, hx⟩
    obtain ⟨⟨⟨p, d⟩, h⟩, rfl⟩ := QuotientAddGroup.mk_surjective x
    rw [mem_pairs] at h
    have hp : ρ p = 0 := congrArg Subtype.val (AddMonoidHom.mem_ker.1 hx)
    have hpm : p ∈ AddSubgroup.closure (Set.range c) := by
      rwa [← hker]
    obtain ⟨e, he⟩ := exists_sigma0_eq deg hc hpm (deg_eq_zero_of_mem_pairs deg hc h)
    have hκ : d - n • e ∈ (sigma0 c).ker := by
      rw [AddMonoidHom.mem_ker, map_sub, map_nsmul, he, ← h, sub_self]
    refine ⟨⟨_, hκ⟩, Subtype.ext ?_⟩
    show QuotientAddGroup.mk _ = QuotientAddGroup.mk _
    rw [QuotientAddGroup.eq]
    refine ⟨e, Subtype.ext ?_⟩
    simp [trivialPairs, he]
  have hk : φ.ker = nsmulRange n ↥(sigma0 c).ker := by
    ext κ
    rw [AddMonoidHom.mem_ker, mem_nsmulRange]
    constructor
    · intro h0
      have h0' : latticeToTriples (n := n) (c := c) κ = 0 := congrArg Subtype.val h0
      obtain ⟨e, h1, h2⟩ := (mk_eq_zero_iff _).1 h0'
      exact ⟨⟨e, h1⟩, Subtype.ext h2⟩
    · rintro ⟨e, rfl⟩
      apply Subtype.ext
      exact (mk_eq_zero_iff _).2 ⟨e, AddMonoidHom.mem_ker.1 e.2, rfl⟩
  exact ⟨(QuotientAddGroup.quotientAddEquivOfEq hk.symm).trans
    (QuotientAddGroup.quotientKerEquivOfSurjective φ hφ)⟩

end Triples

/-! ### The rank count -/

/-- **The rank count of [Stacks, Tag 03RR], as group theory.**

Let `P` be a group with a degree `deg : P ⟶ 𝐙` (`Pic(X̄)`), `c₀, …, c_{r'}` classes of degree
one (the punctures), `ρ : P ↠ Q` a surjection with kernel generated by the `cᵢ` (restriction to
`Pic(X)`), and `ord : U ⟶ 𝐙^{r' + 1}` a homomorphism (orders at the punctures of the units of
`X`) whose kernel consists of `n`-th multiples (the constants) and whose image is the lattice of
relations among the `cᵢ`. Suppose the degree-zero part of `P` is `n`-divisible and
`P[n] ≅ (𝐙/n𝐙)^{2g}`. Then every group `H` killed by `n` which is an extension of `Q[n]` by
`U/nU` is free of rank `2g + r'` over `𝐙/n𝐙`. -/
theorem nonempty_addEquiv_of_rankData {n : ℕ} [NeZero n] {P Q U H : Type*} [AddCommGroup P]
    [AddCommGroup Q] [AddCommGroup U] [AddCommGroup H] {r' : ℕ} (deg : P →+ ℤ)
    (c : Fin (r' + 1) → P) (hc : ∀ i, deg (c i) = 1) (ρ : P →+ Q) (hρ : Surjective ρ)
    (hker : ρ.ker = AddSubgroup.closure (Set.range c))
    (hdiv : ∀ x, deg x = 0 → ∃ y, x = n • y) {g₂ : ℕ}
    (htors : Nonempty (torsion n P ≃+ (Fin g₂ → ZMod n)))
    (ord : U →+ (Fin (r' + 1) → ℤ)) (hordker : ∀ u, ord u = 0 → ∃ v, u = n • v)
    (hordrange : ∀ d, d ∈ ord.range ↔ ∑ i, d i • c i = 0)
    (htor : ∀ x : H, n • x = 0) (π : H →+ torsion n Q) (hπ : Surjective π)
    (hπker : Nonempty (↥π.ker ≃+ U ⧸ nsmulRange n U)) :
    Nonempty (H ≃+ (Fin (g₂ + r') → ZMod n)) := by
  obtain ⟨et⟩ := htors
  obtain ⟨eπ⟩ := hπker
  let ord' : U →+ (Fin r' → ℤ) :=
    { toFun := fun u i => ord u i.succ
      map_zero' := funext fun i => by simp
      map_add' := fun u v => funext fun i => by simp }
  have hrange' : ord'.range = (sigma0 c).ker := by
    ext e
    simp only [AddMonoidHom.mem_range, AddMonoidHom.mem_ker]
    constructor
    · rintro ⟨u, rfl⟩
      exact (sigma0_succ_eq_zero_of_sum_eq_zero deg hc ((hordrange _).1 ⟨u, rfl⟩)).1
    · intro he
      obtain ⟨u, hu⟩ := (hordrange _).2 ((sum_cons_neg_sum_smul c e).trans he)
      exact ⟨u, funext fun i => by simp [ord', hu]⟩
  have hker' : ∀ u, ord' u = 0 → ∃ v, u = n • v := by
    intro u hu
    apply hordker
    have hs := sigma0_succ_eq_zero_of_sum_eq_zero deg hc ((hordrange _).1 ⟨u, rfl⟩)
    have hsucc : ∀ i : Fin r', ord u i.succ = 0 := fun i => congrFun hu i
    funext i
    refine Fin.cases ?_ (fun i => hsucc i) i
    rw [hs.2]
    simp [hsucc]
  obtain ⟨m, ⟨eK⟩⟩ := exists_quotient_nsmul_equiv n (sigma0 c).ker
  have eU : U ⧸ nsmulRange n U ≃+ (Fin m → ZMod n) :=
    (unitsQuotientEquiv n ord' hker').trans
      ((quotientNsmulCongr n (AddEquiv.addSubgroupCongr hrange')).trans eK)
  obtain ⟨eH⟩ := nonempty_addEquiv_prod_of_surjective htor π hπ (eπ.trans eU)
  obtain ⟨eL⟩ := latticeQuotientEquivKer deg hc ρ hker (n := n)
  obtain ⟨eT⟩ := nonempty_addEquiv_prod_of_surjective (triples_nsmul_eq_zero (n := n) (c := c))
    (triplesToTorsion deg hc ρ hker (n := n)) (surjective_triplesToTorsion deg hc ρ hker hρ)
    (eL.symm.trans eK)
  obtain ⟨eD, -⟩ := torsionEquivKer (n := n) (c := c)
  obtain ⟨eT'⟩ := nonempty_addEquiv_prod_of_surjective (triples_nsmul_eq_zero (n := n) (c := c))
    (triplesToDivisor (n := n) (c := c)) (surjective_triplesToDivisor deg hc hdiv)
    (eD.symm.trans et)
  exact ⟨eH.trans (eT.symm.trans (eT'.trans (finProdEquiv g₂ r')))⟩

end AlgebraicGeometry.AffineCurveRankCount

