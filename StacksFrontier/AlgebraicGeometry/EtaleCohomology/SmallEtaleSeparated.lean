module

public import Mathlib.AlgebraicGeometry.Morphisms.UniversallyOpen
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Comparison.ZariskiRestriction

/-!
# Sections of a sheaf on the small étale site inject along a surjection

A single morphism of the small étale site of `X` whose underlying map of spaces is surjective
already generates a covering sieve: coverings of the small étale site are detected by the images
of the underlying maps, and every object of the site is étale over `X` to begin with. For a sheaf
`F` on that site, restriction along such a morphism is therefore a monomorphism — two sections
that agree after restricting to a surjective cover agree.

The case this is wanted for is the one where the target is an *open subscheme*. The structure
morphism `W ⟶ X` of an object of the small étale site is universally open, so its image is an open
subscheme `U₀ ⊆ X`, and `W ⟶ X` factors through `U₀` by a morphism which is onto `U₀`. Viewing
`U₀` in the small étale site along `AlgebraicGeometry.opensToEtale`, the conclusion is that
`F(U₀) ⟶ F(W)` is injective.

That last statement is the one mathematical input of the injectivity half of
[Stacks, Tag 09ZF](https://stacks.math.columbia.edu/tag/09ZF): there, sections of `F` over an
elementary étale neighbourhood `U` of a point are compared with sections over the open image `U₀`
of `U`, and injectivity of `F(U₀) ⟶ F(U)` is what survives the passage to the colimit over
neighbourhoods. It is recorded separately from Tag 09ZF because it needs none of that tag's
hypotheses: no closed immersion, no quasi-compactness, and no hypothesis on Zariski sheaves.

## Main results

* `Stacks.EtaleCohomology.ofArrows_mem_smallEtaleTopology_of_surjective` — a single surjective
  morphism of the small étale site generates a covering sieve.
* `Stacks.EtaleCohomology.mono_smallEtaleSheafMap_of_surjective` — restriction along a surjective
  morphism of the small étale site is a monomorphism, for a sheaf with values in any category.
* `Stacks.EtaleCohomology.injective_smallEtaleSheafMap_of_surjective` — the same for a sheaf of
  types, stated as injectivity of a function.
* `Stacks.EtaleCohomology.exists_opensToEtale_hom_surjective` — an object of the small étale site
  maps onto its open image, by a morphism of the site.
* `Stacks.EtaleCohomology.exists_injective_smallEtaleSheafMap_opensToEtale` — sections of a sheaf
  of types over the open image inject into sections over the object itself.

## Implementation notes

The covering criterion used is Mathlib's
`AlgebraicGeometry.Scheme.ofArrows_mem_smallEtaleTopology_iff`, which characterizes membership of
a sieve generated by a family in terms of the union of the ranges of the underlying maps; a
one-element family indexed by `PUnit` is enough.

The open image is written out as `⟨Set.range _, _⟩` rather than through a named construction,
following Mathlib's own usage in `Mathlib/AlgebraicGeometry/Morphisms/FlatMono.lean` and
`Mathlib/AlgebraicGeometry/Morphisms/FlatDescent.lean`: `Scheme.Hom.opensRange` is available
only for an open immersion, and the image of a merely universally open morphism has no name in
the library.

## References

* [Stacks Project, Tag 09ZF](https://stacks.math.columbia.edu/tag/09ZF)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

universe w v u

namespace Stacks.EtaleCohomology

variable {X : Scheme.{u}}

/-- A single morphism of the small étale site of `X` whose underlying map of spaces is surjective
generates a covering sieve: coverings are detected by the union of the ranges of the underlying
maps, and here the one range is everything. -/
public theorem ofArrows_mem_smallEtaleTopology_of_surjective {U V : X.Etale} (g : U ⟶ V)
    (hg : Function.Surjective g.left.base) :
    Sieve.ofArrows (fun _ : PUnit.{1} ↦ U) (fun _ ↦ g) ∈ Scheme.smallEtaleTopology X V := by
  rw [Scheme.ofArrows_mem_smallEtaleTopology_iff]
  ext y
  simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
  obtain ⟨x, hx⟩ := hg y
  exact ⟨PUnit.unit, x, hx⟩

/-- **Restriction along a surjection is a monomorphism.** For a sheaf on the small étale site of
`X` with values in any category, restriction along a morphism of the site whose underlying map of
spaces is surjective is a monomorphism, because that morphism alone generates a covering sieve. -/
public theorem mono_smallEtaleSheafMap_of_surjective {A : Type v} [Category.{w} A]
    (F : Sheaf (Scheme.smallEtaleTopology X) A) {U V : X.Etale} (g : U ⟶ V)
    (hg : Function.Surjective g.left.base) :
    Mono (F.obj.map g.op) :=
  ⟨fun {_} _ _ h ↦ F.property.hom_ext_ofArrows (fun _ : PUnit.{1} ↦ g)
    (ofArrows_mem_smallEtaleTopology_of_surjective g hg) fun _ ↦ h⟩

/-- **Restriction along a surjection is injective**, for a sheaf of types on the small étale site:
two sections agreeing after restriction along a surjective morphism of the site are equal. -/
public theorem injective_smallEtaleSheafMap_of_surjective
    (F : Sheaf (Scheme.smallEtaleTopology X) (Type w)) {U V : X.Etale} (g : U ⟶ V)
    (hg : Function.Surjective g.left.base) :
    Function.Injective (F.obj.map g.op) :=
  (mono_iff_injective _).1 (mono_smallEtaleSheafMap_of_surjective F g hg)

/-- **An object of the small étale site maps onto its open image.** The structure morphism of an
object `W` of the small étale site of `X` is universally open, so its image is an open subscheme
`U₀` of `X`; reading `U₀` in the small étale site along `opensToEtale`, there is a morphism
`W ⟶ U₀` of the site whose underlying map of spaces is surjective. -/
public theorem exists_opensToEtale_hom_surjective (W : X.Etale) :
    ∃ (U₀ : X.Opens) (g : W ⟶ (opensToEtale X).obj U₀), Function.Surjective g.left.base := by
  have : Etale (W.hom : W.left ⟶ X) := W.prop
  let U₀ : X.Opens :=
    ⟨Set.range (W.hom : W.left ⟶ X).base, (Scheme.Hom.isOpenMap _).isOpen_range⟩
  have hsub : Set.range (W.hom : W.left ⟶ X).base ⊆ Set.range U₀.ι.base := by simp [U₀]
  let t : W.left ⟶ U₀.toScheme := IsOpenImmersion.lift U₀.ι _ hsub
  have ht : t ≫ U₀.ι = (W.hom : W.left ⟶ X) := IsOpenImmersion.lift_fac _ _ hsub
  have hsurj : Function.Surjective t.base := by
    intro y
    obtain ⟨x, hx⟩ : U₀.ι.base y ∈ Set.range (W.hom : W.left ⟶ X).base := y.2
    refine ⟨x, U₀.ι.isOpenEmbedding.injective ?_⟩
    rwa [← Scheme.Hom.comp_apply, ht]
  exact ⟨U₀, MorphismProperty.Over.homMk t ht trivial, hsurj⟩

/-- **Sections over the open image inject into sections over the object.** For a sheaf of types on
the small étale site of `X` and an object `W` of that site, there is an open subscheme `U₀` of `X`
— the image of `W` — and a morphism `W ⟶ U₀` of the site along which restriction of sections is
injective. This is the injectivity input of Tag 09ZF. -/
public theorem exists_injective_smallEtaleSheafMap_opensToEtale
    (F : Sheaf (Scheme.smallEtaleTopology X) (Type w)) (W : X.Etale) :
    ∃ (U₀ : X.Opens) (g : W ⟶ (opensToEtale X).obj U₀),
      Function.Injective (F.obj.map g.op) := by
  obtain ⟨U₀, g, hg⟩ := exists_opensToEtale_hom_surjective W
  exact ⟨U₀, g, injective_smallEtaleSheafMap_of_surjective F g hg⟩

end Stacks.EtaleCohomology

end
