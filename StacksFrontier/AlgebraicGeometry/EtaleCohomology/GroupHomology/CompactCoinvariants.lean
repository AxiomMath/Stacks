module

public import Mathlib.Topology.Algebra.Group.Quotient
public import Mathlib.Topology.Algebra.Group.Subgroup
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GroupHomology.CompactModules

/-!
# Coinvariants of compact modules

Let `Γ` be a topological group, `N` a normal subgroup and `M` a compact `Γ`-module. The
coinvariants `M_N = H₀(N, M)` are the quotient of `M` by the closure of the subgroup generated by
the elements `g • m - m` with `g ∈ N`. This is a compact Hausdorff abelian group, on which `Γ`
acts through `Γ ⧸ N`, continuously. So `H₀(N, -)` is a functor from compact `Γ`-modules to
compact `Γ ⧸ N`-modules, the homological counterpart, in [Stacks, Tag 03VI], of the functor
`H⁰(N, -)` on discrete modules. Taking `N = Γ` gives the coinvariants `M_Γ`, a compact abelian
group.

## Main definitions

* `Stacks.GroupHomology.coinvariantsKernel N M`: the closure of the subgroup generated by the
  `g • m - m`, `g ∈ N`.
* `Stacks.GroupHomology.normalCoinvariantsObj N M`: the compact `Γ ⧸ N`-module `M_N`.
* `Stacks.GroupHomology.normalCoinvariantsFunctor N`: the functor `H₀(N, -)` from compact
  `Γ`-modules to compact `Γ ⧸ N`-modules.
* `Stacks.GroupHomology.compactCoinvariantsFunctor G`: the functor `M ↦ M_G` from compact
  `G`-modules to compact abelian groups.

## Implementation notes

The kernel is closed, which makes the quotient Hausdorff. The residual action of `Γ ⧸ N` is
obtained from the action of `Γ` on `M_N` by endomorphisms through `QuotientGroup.lift`. The
action map `Γ ⧸ N × M_N → M_N` is continuous because the product of the two quotient maps is an
open quotient map.

## References

* [Stacks Project, Tag 03VI](https://stacks.math.columbia.edu/tag/03VI)
-/

@[expose] public noncomputable section

open CategoryTheory

universe u v

namespace Stacks.GroupHomology

variable {Γ : Type u} [Group Γ] [TopologicalSpace Γ] (N : Subgroup Γ)

section Kernel

variable (M : CompactGModule.{u, v} Γ)

/-- The closed subgroup of a compact `Γ`-module topologically generated by the elements
`g • m - m` with `g ∈ N`, the kernel of the projection onto the coinvariants `M_N`. -/
def coinvariantsKernel : AddSubgroup M :=
  (AddSubgroup.closure {x | ∃ g ∈ N, ∃ m : M, g • m - m = x}).topologicalClosure

/-- The kernel of the projection onto the coinvariants is closed. -/
lemma isClosed_coinvariantsKernel : IsClosed (coinvariantsKernel N M : Set M) :=
  AddSubgroup.isClosed_topologicalClosure _

instance : IsClosed (coinvariantsKernel N M : Set M) := isClosed_coinvariantsKernel N M

variable {N M} in
/-- The element `g • m - m` lies in the kernel for `g ∈ N`. -/
lemma smul_sub_mem_coinvariantsKernel {g : Γ} (hg : g ∈ N) (m : M) :
    g • m - m ∈ coinvariantsKernel N M :=
  AddSubgroup.le_topologicalClosure _ (AddSubgroup.subset_closure ⟨g, hg, m, rfl⟩)

/-- The kernel is contained in every closed subgroup containing the elements `g • m - m`. -/
lemma coinvariantsKernel_le {S : AddSubgroup M} (hS : IsClosed (S : Set M))
    (h : ∀ g ∈ N, ∀ m : M, g • m - m ∈ S) : coinvariantsKernel N M ≤ S :=
  AddSubgroup.topologicalClosure_minimal _
    ((AddSubgroup.closure_le _).mpr (by rintro _ ⟨g, hg, m, rfl⟩; exact h g hg m)) hS

variable {M} in
/-- A morphism of compact `Γ`-modules carries the kernel into the kernel. -/
lemma coinvariantsKernel_le_comap {M' : CompactGModule.{u, v} Γ} (f : M ⟶ M') :
    coinvariantsKernel N M ≤ (coinvariantsKernel N M').comap f.hom.toAddMonoidHom :=
  coinvariantsKernel_le N M ((isClosed_coinvariantsKernel N M').preimage f.hom.continuous)
    fun g hg m ↦ by
      change f.hom (g • m - m) ∈ coinvariantsKernel N M'
      rw [map_sub, f.map_smul]
      exact smul_sub_mem_coinvariantsKernel hg _

instance : T2Space (M ⧸ coinvariantsKernel N M) := inferInstance

/-- The projection of a compact `Γ`-module onto its coinvariants, as a continuous
homomorphism. -/
def compactCoinvariantsMk : M →ₜ+ M ⧸ coinvariantsKernel N M where
  toAddMonoidHom := QuotientAddGroup.mk' _
  continuous_toFun := QuotientAddGroup.continuous_mk

/-- An element of `N` acts trivially on the coinvariants. -/
lemma compactCoinvariantsMk_smul {g : Γ} (hg : g ∈ N) (m : M) :
    compactCoinvariantsMk N M (g • m) = compactCoinvariantsMk N M m :=
  (QuotientAddGroup.eq_iff_sub_mem).mpr (smul_sub_mem_coinvariantsKernel hg m)

/-- The map on coinvariants induced by a morphism of compact `Γ`-modules. -/
def coinvariantsMap {M M' : CompactGModule.{u, v} Γ} (f : M ⟶ M') :
    M ⧸ coinvariantsKernel N M →ₜ+ M' ⧸ coinvariantsKernel N M' where
  toAddMonoidHom := QuotientAddGroup.map _ _ f.hom.toAddMonoidHom (coinvariantsKernel_le_comap N f)
  continuous_toFun := (QuotientAddGroup.isQuotientMap_mk _).continuous_iff.mpr
    ((QuotientAddGroup.continuous_mk.comp f.hom.continuous).congr fun _ ↦ rfl)

/-- The induced map on coinvariants sends the class of `m` to the class of `f m`. -/
@[simp] lemma coinvariantsMap_mk {M M' : CompactGModule.{u, v} Γ} (f : M ⟶ M') (m : M) :
    coinvariantsMap N f (m : M ⧸ coinvariantsKernel N M) =
      ((f.hom m : M') : M' ⧸ coinvariantsKernel N M') := rfl

end Kernel

section Action

variable [N.Normal] (M : CompactGModule.{u, v} Γ)

/-- The kernel of the projection onto the coinvariants under a normal subgroup is stable under
the action of `Γ`. -/
lemma coinvariantsKernel_le_comap_smul (γ : Γ) :
    coinvariantsKernel N M ≤
      (coinvariantsKernel N M).comap (DistribSMul.toAddMonoidHom M γ) :=
  coinvariantsKernel_le N M ((isClosed_coinvariantsKernel N M).preimage (continuous_const_smul γ))
    fun g hg m ↦ by
      have hconj : γ * g * γ⁻¹ ∈ N := ‹N.Normal›.conj_mem g hg γ
      have h : γ • (g • m - m) = (γ * g * γ⁻¹) • (γ • m) - γ • m := by
        simp only [smul_sub, smul_smul, inv_mul_cancel_right]
      change γ • (g • m - m) ∈ coinvariantsKernel N M
      rw [h]
      exact smul_sub_mem_coinvariantsKernel hconj _

/-- The action of `Γ` on the coinvariants under a normal subgroup, by endomorphisms. -/
def coinvariantsRepresentation : Γ →* AddMonoid.End (M ⧸ coinvariantsKernel N M) where
  toFun γ := QuotientAddGroup.map _ _ (DistribSMul.toAddMonoidHom M γ)
    (coinvariantsKernel_le_comap_smul N M γ)
  map_one' := DFunLike.ext _ _ fun x ↦ QuotientAddGroup.induction_on x fun m ↦ by
    change ((((1 : Γ) • m : M)) : M ⧸ coinvariantsKernel N M) = m
    rw [one_smul]
  map_mul' g h := DFunLike.ext _ _ fun x ↦ QuotientAddGroup.induction_on x fun m ↦ by
    change (((g * h) • m : M) : M ⧸ coinvariantsKernel N M) = ((g • h • m : M) : _)
    rw [mul_smul]

/-- The action of `Γ ⧸ N` on the coinvariants under `N`: the subgroup `N` acts trivially, so the
action of `Γ` factors through the quotient. -/
def coinvariantsQuotientRepresentation :
    Γ ⧸ N →* AddMonoid.End (M ⧸ coinvariantsKernel N M) :=
  QuotientGroup.lift N (coinvariantsRepresentation N M) fun _ hg ↦
    DFunLike.ext _ _ fun x ↦ QuotientAddGroup.induction_on x fun m ↦
      compactCoinvariantsMk_smul N M hg m

instance : DistribMulAction (Γ ⧸ N) (M ⧸ coinvariantsKernel N M) :=
  DistribMulAction.compHom _ (coinvariantsQuotientRepresentation N M)

/-- The class of `γ` acts on the coinvariants through the action of `γ` on the module. -/
@[simp] lemma mk_smul_mk (γ : Γ) (m : M) :
    (γ : Γ ⧸ N) • (m : M ⧸ coinvariantsKernel N M) = ((γ • m : M) : M ⧸ coinvariantsKernel N M) :=
  rfl

/-- The action of `Γ ⧸ N` on the coinvariants is continuous. -/
instance [IsTopologicalGroup Γ] : ContinuousSMul (Γ ⧸ N) (M ⧸ coinvariantsKernel N M) := ⟨by
  rw [← (QuotientGroup.isOpenQuotientMap_mk.prodMap
    QuotientAddGroup.isOpenQuotientMap_mk).continuous_comp_iff]
  exact (QuotientAddGroup.continuous_mk.comp continuous_smul).congr fun _ ↦ rfl⟩

/-- The coinvariants `M_N = H₀(N, M)` of a compact `Γ`-module under a normal subgroup, as a
compact `Γ ⧸ N`-module. -/
def normalCoinvariantsObj [IsTopologicalGroup Γ] : CompactGModule.{u, v} (Γ ⧸ N) :=
  CompactGModule.of (M ⧸ coinvariantsKernel N M)

end Action

section Functor

variable [N.Normal] [IsTopologicalGroup Γ]

/-- **The coinvariants under a normal subgroup.** Taking coinvariants `M ↦ M_N = H₀(N, M)` under a
normal subgroup `N` of a topological group `Γ` is a functor from compact `Γ`-modules to compact
`Γ ⧸ N`-modules. -/
@[stacks 03VI "H₀(N, -) takes compact Γ-modules to compact Γ/N-modules"]
def normalCoinvariantsFunctor :
    CompactGModule.{u, v} Γ ⥤ CompactGModule.{u, v} (Γ ⧸ N) where
  obj M := normalCoinvariantsObj N M
  map {M M'} f := CompactGModule.ofHom (coinvariantsMap N f) fun q x ↦
    QuotientGroup.induction_on q fun γ ↦ QuotientAddGroup.induction_on x fun m ↦ by
      change ((f.hom (γ • m) : M') : M' ⧸ coinvariantsKernel N M') =
        ((γ • f.hom m : M') : M' ⧸ coinvariantsKernel N M')
      rw [f.map_smul]
  map_id _ := CompactGModule.hom_ext (ContinuousAddMonoidHom.ext fun x ↦
    QuotientAddGroup.induction_on x fun _ ↦ rfl)
  map_comp _ _ := CompactGModule.hom_ext (ContinuousAddMonoidHom.ext fun x ↦
    QuotientAddGroup.induction_on x fun _ ↦ rfl)

/-- The functor `H₀(N, -)` is additive. -/
instance : (normalCoinvariantsFunctor.{u, v} N).Additive where
  map_add {M M' f f'} := CompactGModule.hom_ext (ContinuousAddMonoidHom.ext fun x ↦ by
    induction x using QuotientAddGroup.induction_on with
    | H m => exact QuotientAddGroup.mk_add (coinvariantsKernel N M') (f.hom m) (f'.hom m))

variable (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- **The coinvariants of a compact `G`-module.** The functor `M ↦ M_G = H₀(G, M)` from compact
`G`-modules to compact abelian groups, the quotient of `M` by the closed subgroup topologically
generated by the `g • m - m`. -/
@[stacks 03VI "the coinvariants functor M ↦ M_G = H₀(G, M) on compact G-modules"]
def compactCoinvariantsFunctor : CompactGModule.{u, v} G ⥤ CompactAddCommGrp.{v} :=
  normalCoinvariantsFunctor (⊤ : Subgroup G) ⋙ CompactGModule.forgetAction

/-- The functor `M ↦ M_G` is additive. -/
instance : (compactCoinvariantsFunctor.{u, v} G).Additive :=
  inferInstanceAs
    (normalCoinvariantsFunctor (⊤ : Subgroup G) ⋙ CompactGModule.forgetAction).Additive

end Functor

end Stacks.GroupHomology
