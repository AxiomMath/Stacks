/-!
# The square of the augmentation ideal of a completed group algebra

Let `Λ` be a finite ring, not necessarily commutative, and `G` a compact topological group, with
completed group algebra `Λ[[G]] = lim_U Λ[G/U]` over the open normal subgroups `U`. Let `I` be the
augmentation ideal of `Λ[[G]]` and `I_U` that of `Λ[G/U]`. Since `Λ[[G]]` and `Λ[G/U]` are free over
themselves, `Tor₁^{Λ[[G]]}(Λ, Λ) = I / I²` and `H₁(G/U, Λ) = Tor₁^{Λ[G/U]}(Λ, Λ) = I_U / I_U²`,
and the continuous homology in degree one is `H₁(G, Λ) = lim_U I_U / I_U²`. This file studies the
canonical map

`θ : I / I² → lim_U I_U / I_U²`, `x ↦ (eval_U x)_U`,

i.e. the comparison `Tor₁^{Λ[[G]]}(Λ, Λ) → H₁(G, Λ)` behind the identification
`H_i(G, M) = Tor_i^{Λ[[G]]}(M, Λ)` of [Stacks, Tag 03VI] ("Notes on Homology", item 1).

* `θ` is always surjective: a compatible family of classes lifts, by compactness
  (`exists_mem_ker_augmentation_eval_sub_mem`).
* If `G` is topologically finitely generated, `θ` is injective: `I²` is closed, i.e. an element
  whose image in every `Λ[G/U]` lies in `I_U²` lies in `I²`
  (`mem_augmentationIdealSq_iff_forall_eval_mem`). Indeed, if `G` is topologically generated by
  `g_1, …, g_d`, then `I_U² = ∑_k I_U (ḡ_k - 1)` at every level, and the solutions of
  `eval_U x = ∑_k y_k (ḡ_k - 1)` with `y_k ∈ I_U` form an inverse system of finite non-empty sets.

So for `G` topologically finitely generated, `Tor₁^{Λ[[G]]}(Λ, Λ) = H₁(G, Λ)` canonically
(`augmentationIdeal_comparison`). Without finite generation, injectivity fails:
`AugmentationSquareNotClosed.lean` gives `G = (ℤ/p)^ℕ`, `Λ = 𝔽_p`. The Lean statements here are
about the ideals; the identifications of `Tor₁` with the quotients by squares are in
`TorOneAugmentation.lean` and `TorOneComparison.lean`, and the `Tor` form of the comparison is
`Stacks.GroupHomology.bijective_torOneLimitMap`.

The square `I²` is the additive subgroup generated by the products of two elements of `I`, i.e.
the square of `I` as a `ℤ`-submodule (`Λ[[G]]` need not be commutative); for the two-sided ideal
`I` this is the two-sided ideal `I²`.

## Main definitions

* `finiteAugmentationIdealSq Λ H`: the square of the augmentation ideal of `Λ[H]`.
* `augmentationIdealSq Λ G`: the square of the augmentation ideal of `Λ[[G]]`.

## Main results

* `exists_mem_ker_augmentation_eval_sub_mem`: surjectivity of `θ`.
* `mem_augmentationIdealSq_iff_forall_eval_mem`: `I²` is closed for topologically finitely
  generated `G`.
* `augmentationIdeal_comparison`: both together.

## References

* [Stacks Project, Tag 03VI](https://stacks.math.columbia.edu/tag/03VI)
-/

@[expose] public noncomputable section

universe u v

namespace Stacks.GroupHomology

open MonoidAlgebra CompletedGroupAlgebra CategoryTheory

section FiniteSums

/-- An element of a product `M * N` of additive subgroups of a ring (as `ℤ`-submodules) is a finite
sum of products `α_i β_i` with `α_i ∈ M` and `β_i ∈ N`. -/
theorem exists_sum_mul_of_mem_mul {R : Type*} [Ring R] {M N : Submodule ℤ R} {z : R}
    (hz : z ∈ M * N) :
    ∃ (n : ℕ) (α β : Fin n → R), (∀ i, α i ∈ M) ∧ (∀ i, β i ∈ N) ∧ z = ∑ i, α i * β i := by
  refine Submodule.mul_induction_on hz (fun m hm n hn => ⟨1, fun _ => m, fun _ => n,
    fun _ => hm, fun _ => hn, by simp⟩) ?_
  rintro x y ⟨a, α, β, hα, hβ, rfl⟩ ⟨b, α', β', hα', hβ', rfl⟩
  refine ⟨a + b, Fin.append α α', Fin.append β β', fun i => ?_, fun i => ?_, ?_⟩
  · exact Fin.addCases (fun i => by simpa using hα i) (fun i => by simpa using hα' i) i
  · exact Fin.addCases (fun i => by simpa using hβ i) (fun i => by simpa using hβ' i) i
  · simp [Fin.sum_univ_add]

/-- A ring homomorphism `φ` with `ε' ∘ φ = ε` maps the square of `ker ε` into the square of
`ker ε'`. -/
theorem map_mem_sq_ker {R S T : Type*} [Ring R] [Ring S] [Ring T] {ε : R →+* T} {ε' : S →+* T}
    (φ : R →+* S) (hφ : ∀ x, ε' (φ x) = ε x) {z : R}
    (hz : z ∈ ((RingHom.ker ε).restrictScalars ℤ) ^ 2) :
    φ z ∈ ((RingHom.ker ε').restrictScalars ℤ) ^ 2 := by
  rw [pow_two] at hz ⊢
  refine Submodule.mul_induction_on hz (fun a ha b hb => ?_) fun x y hx hy => ?_
  · rw [map_mul]
    refine Submodule.mul_mem_mul ?_ ?_
    · change φ a ∈ RingHom.ker ε'
      rw [RingHom.mem_ker, hφ]; exact (RingHom.mem_ker).1 ha
    · change φ b ∈ RingHom.ker ε'
      rw [RingHom.mem_ker, hφ]; exact (RingHom.mem_ker).1 hb
  · rw [map_add]; exact add_mem hx hy

/-- The square of `ker ε` lies in `ker ε`. -/
theorem mem_ker_of_mem_sq_ker {R T : Type*} [Ring R] [Ring T] {ε : R →+* T} {z : R}
    (hz : z ∈ ((RingHom.ker ε).restrictScalars ℤ) ^ 2) : ε z = 0 := by
  rw [pow_two] at hz
  rw [← RingHom.mem_ker]
  exact Submodule.mul_induction_on hz (fun a _ b hb => Ideal.mul_mem_left _ a hb)
    fun x y hx hy => add_mem hx hy

end FiniteSums

section Squares

variable (Λ : Type u) [Ring Λ]

/-- The square `I_H²` of the augmentation ideal `I_H` of the group algebra `Λ[H]`: the additive
subgroup generated by the products of two elements of `I_H`. -/
def finiteAugmentationIdealSq (H : Type*) [Group H] : Submodule ℤ (MonoidAlgebra Λ H) :=
  ((RingHom.ker (finiteAugmentation (Λ := Λ) H)).restrictScalars ℤ) ^ 2

/-- The square `I²` of the augmentation ideal `I` of the completed group algebra `Λ[[G]]`: the
additive subgroup generated by the products of two elements of `I`. -/
def augmentationIdealSq (G : Type v) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] :
    Submodule ℤ (CompletedGroupAlgebra Λ G) :=
  ((RingHom.ker (augmentation : CompletedGroupAlgebra Λ G →+* Λ)).restrictScalars ℤ) ^ 2

variable {Λ} {G : Type v} [Group G] [TopologicalSpace G]

/-- The transition map along `U ≤ U` is the identity. -/
theorem quotientAlgebraMap_refl (U : OpenNormalSubgroup G)
    (x : MonoidAlgebra Λ (G ⧸ (U : Subgroup G))) : quotientAlgebraMap Λ (le_refl U) x = x := by
  induction x using MonoidAlgebra.induction_linear with
  | zero => simp
  | add x y hx hy => rw [map_add, hx, hy]
  | single g a =>
    induction g using QuotientGroup.induction_on with
    | H g => exact quotientAlgebraMap_single Λ _ g a

/-- The transition maps compose. -/
theorem quotientAlgebraMap_quotientAlgebraMap {U V W : OpenNormalSubgroup G} (h : U ≤ V)
    (h' : V ≤ W) (x : MonoidAlgebra Λ (G ⧸ (U : Subgroup G))) :
    quotientAlgebraMap Λ h' (quotientAlgebraMap Λ h x) = quotientAlgebraMap Λ (h.trans h') x := by
  induction x using MonoidAlgebra.induction_linear with
  | zero => simp
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]
  | single g a =>
    induction g using QuotientGroup.induction_on with
    | H g => simp only [quotientAlgebraMap_single]

/-- The transition maps send `I_U²` into `I_V²`. -/
theorem quotientAlgebraMap_mem_finiteAugmentationIdealSq {U V : OpenNormalSubgroup G} (h : U ≤ V)
    {z : MonoidAlgebra Λ (G ⧸ (U : Subgroup G))}
    (hz : z ∈ finiteAugmentationIdealSq Λ (G ⧸ (U : Subgroup G))) :
    quotientAlgebraMap Λ h z ∈ finiteAugmentationIdealSq Λ (G ⧸ (V : Subgroup G)) :=
  map_mem_sq_ker _
    (fun x => DFunLike.congr_fun (finiteAugmentation_comp_quotientAlgebraMap (Λ := Λ) h) x) hz

/-- The image of the square of the augmentation ideal of `Λ[[G]]` in `Λ[G/U]` lies in `I_U²`. -/
theorem eval_mem_finiteAugmentationIdealSq [IsTopologicalGroup G] (U : OpenNormalSubgroup G)
    {x : CompletedGroupAlgebra Λ G} (hx : x ∈ augmentationIdealSq Λ G) :
    eval U x ∈ finiteAugmentationIdealSq Λ (G ⧸ (U : Subgroup G)) :=
  map_mem_sq_ker _ (fun y => (augmentation_eq U y).symm) hx

/-- The inverse system of the families in `Λ[G/U]` satisfying `P_U`, for properties `P_U` preserved
by the transition maps. -/
def levelSystem {ι : Type*}
    (P : ∀ U : OpenNormalSubgroup G, (ι → MonoidAlgebra Λ (G ⧸ (U : Subgroup G))) → Prop)
    (hmap : ∀ ⦃U V : OpenNormalSubgroup G⦄ (h : U ≤ V) y, P U y →
      P V fun k => quotientAlgebraMap Λ h (y k)) :
    OpenNormalSubgroup G ⥤ Type _ where
  obj U := {y : ι → MonoidAlgebra Λ (G ⧸ (U : Subgroup G)) // P U y}
  map {U V} f := ↾fun y => ⟨fun k => quotientAlgebraMap Λ (leOfHom f) (y.1 k),
    hmap (leOfHom f) _ y.2⟩
  map_id U := by ext y; simp [quotientAlgebraMap_refl]
  map_comp f g := by ext y; simp [quotientAlgebraMap_quotientAlgebraMap]

/-- The transition maps of `levelSystem` are the transition maps of the group algebras. -/
theorem levelSystem_map_coe {ι : Type*}
    {P : ∀ U : OpenNormalSubgroup G, (ι → MonoidAlgebra Λ (G ⧸ (U : Subgroup G))) → Prop}
    {hmap : ∀ ⦃U V : OpenNormalSubgroup G⦄ (h : U ≤ V) y, P U y →
      P V fun k => quotientAlgebraMap Λ h (y k)} {U V : OpenNormalSubgroup G} (f : U ⟶ V)
    (y : (levelSystem P hmap).obj U) :
    ((levelSystem P hmap).map f y).1 = fun k => quotientAlgebraMap Λ (leOfHom f) (y.1 k) :=
  rfl

end Squares

section Generation

variable {Λ : Type u} [Ring Λ] {H : Type*} [Group H]

/-- If `H` is generated by `s_1, …, s_d`, then every element `b` of `Λ[H]` satisfies
`b - ε(b) = ∑_k c_k (s_k - 1)` for some `c_k ∈ Λ[H]`. -/
theorem exists_sub_augmentation_eq_sum {ι : Type*} [Fintype ι] {s : ι → H}
    (hs : Subgroup.closure (Set.range s) = ⊤) (b : MonoidAlgebra Λ H) :
    ∃ c : ι → MonoidAlgebra Λ H,
      b - single 1 (finiteAugmentation H b) = ∑ k, c k * (single (s k) 1 - 1) := by
  classical
  -- the left ideal of the elements `∑_k c_k (s_k - 1)`
  let J : Set (MonoidAlgebra Λ H) := {z | ∃ c : ι → MonoidAlgebra Λ H,
    z = ∑ k, c k * (single (s k) 1 - 1)}
  have hJ0 : (0 : MonoidAlgebra Λ H) ∈ J := ⟨0, by simp⟩
  have hJadd : ∀ z ∈ J, ∀ z' ∈ J, z + z' ∈ J := by
    rintro _ ⟨c, rfl⟩ _ ⟨c', rfl⟩
    exact ⟨c + c', by simp [add_mul, Finset.sum_add_distrib]⟩
  have hJmul : ∀ a, ∀ z ∈ J, a * z ∈ J := by
    rintro a _ ⟨c, rfl⟩
    exact ⟨fun k => a * c k, by simp [Finset.mul_sum, mul_assoc]⟩
  have hgen : ∀ h : H, single h (1 : Λ) - 1 ∈ J := by
    intro h
    have hh : h ∈ Subgroup.closure (Set.range s) := hs ▸ Subgroup.mem_top h
    induction hh using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨k, rfl⟩ := hx
      refine ⟨Pi.single k 1, ?_⟩
      rw [Fintype.sum_eq_single k fun i hi => by rw [Pi.single_eq_of_ne hi, zero_mul],
        Pi.single_eq_same, one_mul]
    | one => simpa [← MonoidAlgebra.one_def] using hJ0
    | mul x y _ _ hx hy =>
      have : single (x * y) (1 : Λ) - 1 =
          single x 1 * (single y 1 - 1) + (single x 1 - 1) := by
        rw [mul_sub, single_mul_single, mul_one, mul_one]; abel
      rw [this]
      exact hJadd _ (hJmul _ _ hy) _ hx
    | inv x _ hx =>
      have : single x⁻¹ (1 : Λ) - 1 = -single x⁻¹ 1 * (single x 1 - 1) := by
        rw [neg_mul, mul_sub, single_mul_single, inv_mul_cancel, mul_one, mul_one,
          ← MonoidAlgebra.one_def]; abel
      rw [this]
      exact hJmul _ _ hx
  have key : ∀ b : MonoidAlgebra Λ H, b - single 1 (finiteAugmentation H b) ∈ J := by
    intro b
    induction b using MonoidAlgebra.induction_linear with
    | zero => simpa using hJ0
    | add x y hx hy =>
      have : x + y - single 1 (finiteAugmentation H (x + y)) =
          (x - single 1 (finiteAugmentation H x)) + (y - single 1 (finiteAugmentation H y)) := by
        rw [map_add, single_add]; abel
      rw [this]; exact hJadd _ hx _ hy
    | single h a =>
      have : single h a - single 1 (finiteAugmentation H (single h a)) =
          single 1 a * (single h 1 - 1) := by
        rw [finiteAugmentation_single, mul_sub, single_mul_single, one_mul, mul_one, mul_one]
      rw [this]; exact hJmul _ _ (hgen h)
  obtain ⟨c, hc⟩ := key b
  exact ⟨c, hc⟩

/-- **The square of the augmentation ideal of a finitely generated group.** If `H` is generated by
`s_1, …, s_d`, every element of `I_H²` is `∑_k y_k (s_k - 1)` with `y_k ∈ I_H`. -/
theorem exists_eq_sum_of_mem_finiteAugmentationIdealSq {ι : Type*} [Fintype ι] {s : ι → H}
    (hs : Subgroup.closure (Set.range s) = ⊤) {z : MonoidAlgebra Λ H}
    (hz : z ∈ finiteAugmentationIdealSq Λ H) :
    ∃ y : ι → MonoidAlgebra Λ H, (∀ k, finiteAugmentation H (y k) = 0) ∧
      z = ∑ k, y k * (single (s k) 1 - 1) := by
  rw [finiteAugmentationIdealSq, pow_two] at hz
  refine Submodule.mul_induction_on hz (fun a ha b hb => ?_) ?_
  · obtain ⟨c, hc⟩ := exists_sub_augmentation_eq_sum hs b
    rw [(RingHom.mem_ker).1 hb, single_zero, sub_zero] at hc
    refine ⟨fun k => a * c k, fun k => ?_, ?_⟩
    · rw [map_mul, (RingHom.mem_ker).1 ha, zero_mul]
    · rw [hc, Finset.mul_sum]; simp [mul_assoc]
  · rintro x x' ⟨y, hy, rfl⟩ ⟨y', hy', rfl⟩
    exact ⟨y + y', fun k => by simp [hy, hy'], by simp [add_mul, Finset.sum_add_distrib]⟩

end Generation

section Compactness

variable (Λ : Type u) [Ring Λ] [Finite Λ] {G : Type v} [Group G] [TopologicalSpace G]
  [IsTopologicalGroup G] [CompactSpace G]

/-- `Λ[G/U]` is finite, for `Λ` finite, `G` compact and `U` open. -/
theorem finite_monoidAlgebra_quotient (U : OpenNormalSubgroup G) :
    Finite (MonoidAlgebra Λ (G ⧸ (U : Subgroup G))) := by
  classical
  have : Fintype Λ := Fintype.ofFinite Λ
  have : Fintype (G ⧸ (U : Subgroup G)) := Fintype.ofFinite _
  exact Finite.of_equiv _ MonoidAlgebra.coeffEquiv.symm

variable {Λ}

/-- **Compactness of `Λ[[G]]`.** Let `P_U` be properties of finite families in `Λ[G/U]`, satisfiable
at every level and preserved by the transition maps. Then some finite family in `Λ[[G]]` has all
its components satisfying them. -/
theorem exists_forall_eval_of_finite {ι : Type*} [Finite ι]
    (P : ∀ U : OpenNormalSubgroup G, (ι → MonoidAlgebra Λ (G ⧸ (U : Subgroup G))) → Prop)
    (hne : ∀ U, ∃ y, P U y)
    (hmap : ∀ ⦃U V : OpenNormalSubgroup G⦄ (h : U ≤ V) y, P U y →
      P V fun k => quotientAlgebraMap Λ h (y k)) :
    ∃ y : ι → CompletedGroupAlgebra Λ G, ∀ U, P U fun k => eval U (y k) := by
  have (U : OpenNormalSubgroup G) : Finite ((levelSystem P hmap).obj U) := by
    have := finite_monoidAlgebra_quotient Λ U
    exact Subtype.finite
  have (U : OpenNormalSubgroup G) : Nonempty ((levelSystem P hmap).obj U) :=
    let ⟨y, hy⟩ := hne U; ⟨⟨y, hy⟩⟩
  obtain ⟨s, hs⟩ := nonempty_sections_of_finite_cofiltered_system (levelSystem P hmap)
  refine ⟨fun k => mk (fun U => (s U).1 k) fun U V h => ?_, fun U => (s U).2⟩
  exact congrFun ((levelSystem_map_coe (homOfLE h) (s U)).symm.trans
    (congrArg Subtype.val (hs (homOfLE h)))) k

/-- **Surjectivity of `I / I² → lim_U I_U / I_U²`.** For `Λ` finite and `G` compact, a family
`c_U ∈ I_U`, compatible with the transition maps modulo the squares `I_V²`, is the image of some
`x ∈ I` modulo the squares. -/
theorem exists_mem_ker_augmentation_eval_sub_mem
    (c : ∀ U : OpenNormalSubgroup G, MonoidAlgebra Λ (G ⧸ (U : Subgroup G)))
    (hc : ∀ U, finiteAugmentation _ (c U) = 0)
    (hcompat : ∀ ⦃U V : OpenNormalSubgroup G⦄ (h : U ≤ V),
      quotientAlgebraMap Λ h (c U) - c V ∈ finiteAugmentationIdealSq Λ (G ⧸ (V : Subgroup G))) :
    ∃ x : CompletedGroupAlgebra Λ G, augmentation x = 0 ∧
      ∀ U : OpenNormalSubgroup G,
        eval U x - c U ∈ finiteAugmentationIdealSq Λ (G ⧸ (U : Subgroup G)) := by
  obtain ⟨y, hy⟩ := exists_forall_eval_of_finite (ι := Unit)
    (fun U y => finiteAugmentation _ (y ()) = 0 ∧
      y () - c U ∈ finiteAugmentationIdealSq Λ (G ⧸ (U : Subgroup G)))
    (fun U => ⟨fun _ => c U, hc U, by simp [finiteAugmentationIdealSq]⟩)
    (fun U V h y ⟨hy0, hy1⟩ => ⟨by
      rw [← RingHom.comp_apply, finiteAugmentation_comp_quotientAlgebraMap, hy0], by
      have : quotientAlgebraMap Λ h (y ()) - c V =
          quotientAlgebraMap Λ h (y () - c U) + (quotientAlgebraMap Λ h (c U) - c V) := by
        rw [map_sub]; abel
      rw [this]
      exact add_mem (quotientAlgebraMap_mem_finiteAugmentationIdealSq h hy1) (hcompat h)⟩)
  exact ⟨y (), by rw [augmentation_eq topSubgroup]; exact (hy topSubgroup).1, fun U => (hy U).2⟩

omit [CompactSpace G] in
/-- A dense subgroup maps onto every finite quotient: if `g_1, …, g_d` topologically generate `G`,
their images generate `G/U` for every open normal subgroup `U`. -/
theorem closure_range_mk_eq_top {ι : Type*} {g : ι → G}
    (hg : Dense (Subgroup.closure (Set.range g) : Set G)) (U : OpenNormalSubgroup G) :
    Subgroup.closure (Set.range fun k => (g k : G ⧸ (U : Subgroup G))) = ⊤ := by
  refine eq_top_iff.2 fun q _ => ?_
  induction q using QuotientGroup.induction_on with
  | H h =>
    obtain ⟨t, ht, u, hu, htu⟩ := hg.exists_mem_open
      ((isOpenMap_mul_left h) _ U.toOpenSubgroup.isOpen) ⟨h, 1, one_mem U, mul_one h⟩
    have hmk : (t : G ⧸ (U : Subgroup G)) = h := by
      rw [← htu]; exact QuotientGroup.mk_mul_of_mem h hu
    have h1 : QuotientGroup.mk' (U : Subgroup G) t ∈
        (Subgroup.closure (Set.range g)).map (QuotientGroup.mk' _) := ⟨t, ht, rfl⟩
    rw [MonoidHom.map_closure, ← Set.range_comp] at h1
    rw [← hmk]
    exact h1

/-- **The square of the augmentation ideal of `Λ[[G]]` is closed** when `G` is topologically
finitely generated: an element of `Λ[[G]]` whose image in every `Λ[G/U]` lies in `I_U²` lies in
`I²`. Equivalently, `I / I² → lim_U I_U / I_U²` is injective. -/
theorem mem_augmentationIdealSq_iff_forall_eval_mem {ι : Type*} [Finite ι] {g : ι → G}
    (hg : Dense (Subgroup.closure (Set.range g) : Set G)) (x : CompletedGroupAlgebra Λ G) :
    x ∈ augmentationIdealSq Λ G ↔ ∀ U : OpenNormalSubgroup G,
      eval U x ∈ finiteAugmentationIdealSq Λ (G ⧸ (U : Subgroup G)) := by
  have := Fintype.ofFinite ι
  refine ⟨fun hx U => eval_mem_finiteAugmentationIdealSq U hx, fun hx => ?_⟩
  obtain ⟨y, hy⟩ := exists_forall_eval_of_finite
    (fun U y => (∀ k, finiteAugmentation _ (y k) = 0) ∧
      eval U x = ∑ k, y k * (single (g k : G ⧸ (U : Subgroup G)) 1 - 1))
    (fun U => exists_eq_sum_of_mem_finiteAugmentationIdealSq (closure_range_mk_eq_top hg U)
      (hx U))
    (fun U V h y ⟨hy0, hy1⟩ => ⟨fun k => by
      rw [← RingHom.comp_apply, finiteAugmentation_comp_quotientAlgebraMap, hy0], by
      rw [← quotientAlgebraMap_eval h, hy1, map_sum]
      simp [quotientAlgebraMap_single]⟩)
  have hxy : x = ∑ k, y k * (of (g k) - 1) := ext fun U => by
    rw [(hy U).2, map_sum]
    simp
  rw [hxy, augmentationIdealSq, pow_two]
  refine Submodule.sum_mem _ fun k _ => Submodule.mul_mem_mul ?_ ?_
  · change y k ∈ RingHom.ker _
    rw [RingHom.mem_ker, augmentation_eq topSubgroup]
    exact (hy topSubgroup).1 k
  · change _ ∈ RingHom.ker _
    rw [RingHom.mem_ker, map_sub, augmentation_of, map_one, sub_self]

/-- **`Tor₁^{Λ[[G]]}(Λ, Λ) = H₁(G, Λ)` for `G` topologically finitely generated.** For `Λ` finite
and `G` compact and topologically generated by finitely many elements, the canonical map
`I / I² → lim_U I_U / I_U²`, `x ↦ (eval_U x)_U`, is bijective: every family `c_U ∈ I_U` compatible
modulo the squares is the image of some `x ∈ I`, and `x ∈ I` maps to zero exactly when `x ∈ I²`.
Here `I`, `I_U` are the augmentation ideals of `Λ[[G]]` and `Λ[G/U]`. -/
@[stacks 03VI "Notes on Homology (1) in degree one with M = Λ, for G topologically finitely
generated: the canonical map I/I² → lim_U I_U/I_U², i.e. Tor₁^{Λ[[G]]}(Λ, Λ) → H₁(G, Λ), is
bijective"]
theorem augmentationIdeal_comparison {ι : Type*} [Finite ι] {g : ι → G}
    (hg : Dense (Subgroup.closure (Set.range g) : Set G)) :
    (∀ (c : ∀ U : OpenNormalSubgroup G, MonoidAlgebra Λ (G ⧸ (U : Subgroup G))),
      (∀ U : OpenNormalSubgroup G, finiteAugmentation _ (c U) = 0) →
      (∀ ⦃U V : OpenNormalSubgroup G⦄ (h : U ≤ V),
        quotientAlgebraMap Λ h (c U) - c V ∈ finiteAugmentationIdealSq Λ (G ⧸ (V : Subgroup G))) →
      ∃ x : CompletedGroupAlgebra Λ G, augmentation x = 0 ∧
        ∀ U : OpenNormalSubgroup G,
          eval U x - c U ∈ finiteAugmentationIdealSq Λ (G ⧸ (U : Subgroup G))) ∧
    ∀ x : CompletedGroupAlgebra Λ G, x ∈ augmentationIdealSq Λ G ↔ ∀ U : OpenNormalSubgroup G,
      eval U x ∈ finiteAugmentationIdealSq Λ (G ⧸ (U : Subgroup G)) :=
  ⟨fun c hc hcompat => exists_mem_ker_augmentation_eval_sub_mem c hc hcompat,
    mem_augmentationIdealSq_iff_forall_eval_mem hg⟩

end Compactness

end Stacks.GroupHomology
