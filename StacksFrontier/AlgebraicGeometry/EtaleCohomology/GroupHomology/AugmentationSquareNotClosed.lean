module

public import Mathlib.Data.ZMod.Basic
public import Mathlib.LinearAlgebra.Matrix.Rank
public import Mathlib.Topology.Instances.ZMod
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GroupHomology.AugmentationIdealSquare

/-!
# The square of the augmentation ideal of `𝔽_p[[(ℤ/p)^ℕ]]` is not closed

Let `p` be a prime, `Λ = 𝔽_p` and `G = (ℤ/p)^ℕ` with the product topology, a profinite group which
is not topologically finitely generated. Let `I` be the augmentation ideal of the completed group
algebra `Λ[[G]] = lim_U Λ[G/U]` and `I_U` that of `Λ[G/U]`. Writing `e_i` for the basis vectors
of `G`, the element

`f = ∑_t (e_{2t} - 1)(e_{2t+1} - 1) ∈ Λ[[G]]`

(a finite sum in every `Λ[G/U]`) lies in `I_U²` at every finite level, that is, in the closure of
`I²`, but not in `I²` itself: a finite sum `∑_{k < n} α_k β_k` with `α_k, β_k ∈ I` has, at the level
of the first `2m` coordinates, a matrix of second moments `(q_{2a, 2b+1})_{a, b < m}` of rank at
most `2n`, while that of `f` is the identity, of rank `m`.

So the canonical map `I / I² → lim_U I_U / I_U²` is not injective. Since `Λ[[G]]` is free over
itself, `Tor₁^{Λ[[G]]}(Λ, Λ) = I / I²`, while `H₁(G/U, Λ) = Tor₁^{Λ[G/U]}(Λ, Λ) = I_U / I_U²` and
the continuous homology is `H₁(G, Λ) = lim_U H₁(G/U, Λ)`. Hence the identification
`H_i(G, M) = Tor_i^{Λ[[G]]}(M, Λ)` of [Stacks, Tag 03VI] ("Notes on Homology", item 1), read with
the abstract `Tor` over the ring `Λ[[G]]`, fails for `i = 1`, `M = Λ` and this `G`: the canonical
comparison map `Tor₁^{Λ[[G]]}(Λ, Λ) → H₁(G, Λ)` has a non-zero kernel. Both sides have the
cardinality of the continuum, so it is the canonical identification that fails. The statements
here are about the ideals; the identifications of `Tor₁` with `I / I²` and `I_U / I_U²` are
`Stacks.GroupHomology.torOneMk_eq_zero_iff` and `Stacks.GroupHomology.torOneLeg_torOneTrivialMk`,
and the `Tor` form of the counterexample is
`Stacks.GroupHomology.not_injective_torOneLimitMap_piZMod`.

The squares `I²` and `I_U²` are `augmentationIdealSq` and `finiteAugmentationIdealSq` (the additive
subgroups generated by the products). For topologically finitely generated `G` the map above is
bijective (`Stacks.GroupHomology.augmentationIdeal_comparison`); `G = (ℤ/p)^ℕ` shows that the
finite generation cannot be dropped.

## Main results

* `Stacks.GroupHomology.exists_forall_eval_mem_and_not_mem_augmentationIdealSq`: the element `f`.

## References

* [Stacks Project, Tag 03VI](https://stacks.math.columbia.edu/tag/03VI)
-/

@[expose] public noncomputable section

namespace Stacks.GroupHomology

open MonoidAlgebra CompletedGroupAlgebra

section Moments

variable {Λ : Type*} [CommRing Λ] {H : Type*} [Group H]

/-- The moment `x ↦ ∑_h x(h) c(h)` of an element of `Λ[H]` against a function `c : H → Λ`. -/
def moment (c : H → Λ) : MonoidAlgebra Λ H →+ Λ :=
  liftNC (AddMonoidHom.id Λ) c

omit [Group H] in
/-- The moment of `δ_h a` is `a c(h)`. -/
@[simp]
theorem moment_single (c : H → Λ) (h : H) (a : Λ) : moment c (single h a) = a * c h := by
  simp [moment, liftNC_single]

/-- **Second moments of a product.** For additive `c, d : H → Λ`, the moment of `x y` against
`c d` is `q(x) ε(y) + ε(x) q(y) + ℓ_c(x) ℓ_d(y) + ℓ_d(x) ℓ_c(y)`, where `q`, `ℓ_c`, `ℓ_d` are the
moments against `c d`, `c`, `d` and `ε` is the augmentation. -/
theorem moment_mul_mul {c d : H → Λ} (hc : ∀ g h, c (g * h) = c g + c h)
    (hd : ∀ g h, d (g * h) = d g + d h) (x y : MonoidAlgebra Λ H) :
    moment (fun h => c h * d h) (x * y) =
      moment (fun h => c h * d h) x * finiteAugmentation H y +
        finiteAugmentation H x * moment (fun h => c h * d h) y +
        moment c x * moment d y + moment d x * moment c y := by
  induction x using MonoidAlgebra.induction_linear with
  | zero => simp
  | add x x' hx hx' => rw [add_mul, map_add, hx, hx']; simp only [map_add]; ring
  | single g a =>
    induction y using MonoidAlgebra.induction_linear with
    | zero => simp
    | add y y' hy hy' => rw [mul_add, map_add, hy, hy']; simp only [map_add]; ring
    | single h b =>
      rw [single_mul_single]
      simp only [moment_single, finiteAugmentation_single, hc, hd]
      ring

/-- For `x, y` in the augmentation ideal, the second moment of `x y` is
`ℓ_c(x) ℓ_d(y) + ℓ_d(x) ℓ_c(y)`. -/
theorem moment_mul_mul_of_ker {c d : H → Λ} (hc : ∀ g h, c (g * h) = c g + c h)
    (hd : ∀ g h, d (g * h) = d g + d h) {x y : MonoidAlgebra Λ H}
    (hx : finiteAugmentation H x = 0) (hy : finiteAugmentation H y = 0) :
    moment (fun h => c h * d h) (x * y) = moment c x * moment d y + moment d x * moment c y := by
  rw [moment_mul_mul hc hd, hx, hy]; ring

/-- The moment of `δ_h - 1` against an additive `c` is `c(h)`. -/
theorem moment_single_one_sub_one {c : H → Λ} (hc : ∀ g h, c (g * h) = c g + c h) (h : H) :
    moment c (single h 1 - 1) = c h := by
  have h1 : c 1 = 0 := by simpa using hc 1 1
  rw [map_sub, MonoidAlgebra.one_def, moment_single, moment_single, h1]; ring

end Moments

variable (p : ℕ)

/-- The basis vector `e_i` of `(ℤ/p)^ℕ`, written multiplicatively. -/
def piZModBasis (i : ℕ) : ℕ → Multiplicative (ZMod p) :=
  Pi.mulSingle i (Multiplicative.ofAdd 1)

/-- Every open normal subgroup of `(ℤ/p)^ℕ` contains all but finitely many basis vectors. -/
theorem exists_piZModBasis_mem (U : OpenNormalSubgroup (ℕ → Multiplicative (ZMod p))) :
    ∃ n, ∀ i, n ≤ i → piZModBasis p i ∈ U := by
  obtain ⟨I, u, hu, hsub⟩ := isOpen_pi_iff.1 U.toOpenSubgroup.isOpen 1 (one_mem U)
  refine ⟨I.sup id + 1, fun i hi => hsub fun a ha => ?_⟩
  have hai : a ≠ i := by
    rintro rfl
    have := Finset.le_sup (f := id) (Finset.mem_coe.1 ha)
    simp only [id] at this
    omega
  simpa [piZModBasis, Pi.mulSingle_eq_of_ne hai] using (hu a ha).2

/-- The factor `(e_{2t} - 1)(e_{2t+1} - 1)` in `𝔽_p[G/U]`. -/
def piZModTerm (U : OpenNormalSubgroup (ℕ → Multiplicative (ZMod p))) (t : ℕ) :
    MonoidAlgebra (ZMod p) ((ℕ → Multiplicative (ZMod p)) ⧸ (U : Subgroup _)) :=
  (single (piZModBasis p (2 * t) : (ℕ → Multiplicative (ZMod p)) ⧸ (U : Subgroup _)) 1 - 1) *
    (single (piZModBasis p (2 * t + 1) : (ℕ → Multiplicative (ZMod p)) ⧸ (U : Subgroup _)) 1 - 1)

/-- The factor vanishes as soon as `e_{2t} ∈ U`. -/
theorem piZModTerm_eq_zero {U : OpenNormalSubgroup (ℕ → Multiplicative (ZMod p))} {t : ℕ}
    (h : piZModBasis p (2 * t) ∈ U) : piZModTerm p U t = 0 := by
  rw [piZModTerm, (QuotientGroup.eq_one_iff _).2 h, ← MonoidAlgebra.one_def, sub_self, zero_mul]

/-- The transition maps send the factors to the factors. -/
theorem quotientAlgebraMap_piZModTerm {U V : OpenNormalSubgroup (ℕ → Multiplicative (ZMod p))}
    (h : U ≤ V) (t : ℕ) : quotientAlgebraMap (ZMod p) h (piZModTerm p U t) = piZModTerm p V t := by
  simp [piZModTerm, quotientAlgebraMap_single]

/-- An index beyond which every basis vector lies in `U`. -/
def piZModCutoff (U : OpenNormalSubgroup (ℕ → Multiplicative (ZMod p))) : ℕ :=
  (exists_piZModBasis_mem p U).choose

/-- The component at `U` of `f = ∑_t (e_{2t} - 1)(e_{2t+1} - 1)`. -/
def piZModSumComponent (U : OpenNormalSubgroup (ℕ → Multiplicative (ZMod p))) :
    MonoidAlgebra (ZMod p) ((ℕ → Multiplicative (ZMod p)) ⧸ (U : Subgroup _)) :=
  ∑ t ∈ Finset.range (piZModCutoff p U), piZModTerm p U t

/-- The component at `U` is the partial sum up to any `n` such that `e_{2t} ∈ U` for `t ≥ n`. -/
theorem piZModSumComponent_eq {U : OpenNormalSubgroup (ℕ → Multiplicative (ZMod p))} {n : ℕ}
    (hn : ∀ t, n ≤ t → piZModBasis p (2 * t) ∈ U) :
    piZModSumComponent p U = ∑ t ∈ Finset.range n, piZModTerm p U t := by
  have key : ∀ k k', k ≤ k' → (∀ t, k ≤ t → piZModBasis p (2 * t) ∈ U) →
      ∑ t ∈ Finset.range k', piZModTerm p U t = ∑ t ∈ Finset.range k, piZModTerm p U t :=
    fun k k' hkk' hk => (Finset.sum_subset (Finset.range_subset_range.2 hkk') fun t _ ht =>
      piZModTerm_eq_zero p (hk t (by simpa using ht))).symm
  have hc : ∀ t, piZModCutoff p U ≤ t → piZModBasis p (2 * t) ∈ U := fun t ht =>
    (exists_piZModBasis_mem p U).choose_spec _ (by unfold piZModCutoff at ht; omega)
  rw [piZModSumComponent, ← key _ _ (le_max_right n _) hc, key _ _ (le_max_left _ _) hn]

/-- **The element `f = ∑_t (e_{2t} - 1)(e_{2t+1} - 1)` of `𝔽_p[[(ℤ/p)^ℕ]]`.** -/
def piZModSum : CompletedGroupAlgebra (ZMod p) (ℕ → Multiplicative (ZMod p)) :=
  mk (piZModSumComponent p) fun U V h => by
    rw [piZModSumComponent, map_sum]
    simp_rw [quotientAlgebraMap_piZModTerm]
    exact (piZModSumComponent_eq p fun t ht =>
      h ((exists_piZModBasis_mem p U).choose_spec _ (by unfold piZModCutoff at ht; omega))).symm

/-- The component of `f` at `U`. -/
theorem eval_piZModSum (U : OpenNormalSubgroup (ℕ → Multiplicative (ZMod p))) :
    eval U (piZModSum p) = piZModSumComponent p U :=
  rfl

/-- The open normal subgroup of the elements whose first `N` coordinates vanish. -/
def piZModLevel (N : ℕ) : OpenNormalSubgroup (ℕ → Multiplicative (ZMod p)) where
  carrier := {g | ∀ i : Fin N, g i = 1}
  mul_mem' ha hb i := by simp [ha i, hb i]
  one_mem' i := rfl
  inv_mem' ha i := by simp [ha i]
  isOpen' := by
    have : {g : ℕ → Multiplicative (ZMod p) | ∀ i : Fin N, g i = 1} =
        (fun g (i : Fin N) => g i) ⁻¹' {1} := by
      ext g; simp [funext_iff]
    rw [this]
    exact (isOpen_discrete _).preimage (continuous_pi fun i => continuous_apply _)
  isNormal' := Subgroup.normal_of_isMulCommutative _

/-- Membership in `U_N`. -/
theorem mem_piZModLevel {N : ℕ} {g : ℕ → Multiplicative (ZMod p)} :
    g ∈ ((piZModLevel p N : OpenNormalSubgroup _) : Subgroup _) ↔ ∀ i : Fin N, g i = 1 :=
  Iff.rfl

/-- `U_N` lies in the kernel of the `i`-th coordinate, for `i < N`. -/
theorem piZModLevel_le_ker (N : ℕ) (i : Fin N) :
    ((piZModLevel p N : OpenNormalSubgroup _) : Subgroup _) ≤
      (Pi.evalMonoidHom (fun _ => Multiplicative (ZMod p)) (i : ℕ)).ker := fun _ hg =>
  MonoidHom.mem_ker.2 ((mem_piZModLevel p).1 hg i)

/-- The `i`-th coordinate on `G / U_N`, for `i < N`. -/
def piZModCoord (N : ℕ) (i : Fin N) :
    (ℕ → Multiplicative (ZMod p)) ⧸ ((piZModLevel p N : OpenNormalSubgroup _) : Subgroup _) →
      ZMod p :=
  fun h => Multiplicative.toAdd
    (QuotientGroup.lift _ _ (piZModLevel_le_ker p N i) h)

/-- The coordinates are additive. -/
theorem piZModCoord_mul (N : ℕ) (i : Fin N) (g h) :
    piZModCoord p N i (g * h) = piZModCoord p N i g + piZModCoord p N i h := by
  simp [piZModCoord]

/-- The `i`-th coordinate of `e_j` is `1` if `i = j` and `0` otherwise. -/
theorem piZModCoord_piZModBasis (N : ℕ) (i : Fin N) (j : ℕ) :
    piZModCoord p N i (QuotientGroup.mk (s := ((piZModLevel p N : OpenNormalSubgroup _) :
      Subgroup (ℕ → Multiplicative (ZMod p)))) (piZModBasis p j)) =
      if (i : ℕ) = j then 1 else 0 := by
  simp only [piZModCoord, QuotientGroup.lift_mk, Pi.evalMonoidHom_apply, piZModBasis,
    Pi.mulSingle_apply]
  split_ifs <;> rfl

/-- The moment of `δ_{e_j} - 1` against the `i`-th coordinate. -/
theorem moment_piZModCoord_piZModBasis (N : ℕ) (i : Fin N) (j : ℕ) :
    moment (piZModCoord p N i) (single (QuotientGroup.mk (s := ((piZModLevel p N :
      OpenNormalSubgroup _) : Subgroup (ℕ → Multiplicative (ZMod p)))) (piZModBasis p j)) 1 - 1) =
      if (i : ℕ) = j then 1 else 0 := by
  rw [moment_single_one_sub_one (piZModCoord_mul p N i), piZModCoord_piZModBasis]

/-- **The square of the augmentation ideal of `𝔽_p[[(ℤ/p)^ℕ]]` is not closed.** The element
`f = ∑_t (e_{2t} - 1)(e_{2t+1} - 1)` lies, at every finite level `U`, in the square of the
augmentation ideal of `𝔽_p[G/U]`, but not in the square of the augmentation ideal of
`𝔽_p[[G]]`. Equivalently, the canonical map `I / I² → lim_U I_U / I_U²`, i.e.
`Tor₁^{𝔽_p[[G]]}(𝔽_p, 𝔽_p) → H₁(G, 𝔽_p)`, is not injective for `G = (ℤ/p)^ℕ`. -/
theorem exists_forall_eval_mem_and_not_mem_augmentationIdealSq [Fact p.Prime] :
    ∃ f : CompletedGroupAlgebra (ZMod p) (ℕ → Multiplicative (ZMod p)),
      augmentation f = 0 ∧
      (∀ U : OpenNormalSubgroup (ℕ → Multiplicative (ZMod p)),
        eval U f ∈ finiteAugmentationIdealSq (ZMod p) (_ ⧸ (U : Subgroup _))) ∧
      f ∉ augmentationIdealSq (ZMod p) (ℕ → Multiplicative (ZMod p)) := by
  have hδ : ∀ (U : OpenNormalSubgroup (ℕ → Multiplicative (ZMod p))) (j : ℕ),
      finiteAugmentation (Λ := ZMod p) ((ℕ → Multiplicative (ZMod p)) ⧸ (U : Subgroup _))
        (single (QuotientGroup.mk (s := (U : Subgroup (ℕ → Multiplicative (ZMod p))))
          (piZModBasis p j)) 1 - 1) = 0 :=
    fun U j => by simp
  have hmem : ∀ U : OpenNormalSubgroup (ℕ → Multiplicative (ZMod p)),
      eval U (piZModSum p) ∈ finiteAugmentationIdealSq (ZMod p) (_ ⧸ (U : Subgroup _)) :=
        fun U => by
    rw [eval_piZModSum, piZModSumComponent, finiteAugmentationIdealSq, pow_two]
    exact Submodule.sum_mem _ fun t _ => Submodule.mul_mem_mul (hδ U _) (hδ U _)
  refine ⟨piZModSum p, ?_, hmem, ?_⟩
  · have := hmem topSubgroup
    rw [finiteAugmentationIdealSq, pow_two] at this
    rw [augmentation_eq topSubgroup, ← RingHom.mem_ker]
    exact Submodule.mul_induction_on this (fun a _ b hb => Ideal.mul_mem_left _ a hb)
      fun x y hx hy => add_mem hx hy
  intro hf
  rw [augmentationIdealSq, pow_two] at hf
  obtain ⟨n, α, β, hα, hβ, hsum⟩ := exists_sum_mul_of_mem_mul hf
  set m := 2 * n + 1
  let E : Fin m → Fin (2 * m) := fun a => ⟨2 * a, by omega⟩
  let O : Fin m → Fin (2 * m) := fun b => ⟨2 * b + 1, by omega⟩
  let ℓ : Fin (2 * m) → CompletedGroupAlgebra (ZMod p) (ℕ → Multiplicative (ZMod p)) → ZMod p :=
    fun i x => moment (piZModCoord p (2 * m) i) (eval (piZModLevel p (2 * m)) x)
  let P : Matrix (Fin m) (Fin n ⊕ Fin n) (ZMod p) :=
    Matrix.of fun a s => s.elim (fun k => ℓ (E a) (α k)) (fun k => ℓ (E a) (β k))
  let Q : Matrix (Fin n ⊕ Fin n) (Fin m) (ZMod p) :=
    Matrix.of fun s b => s.elim (fun k => ℓ (O b) (β k)) (fun k => ℓ (O b) (α k))
  have hker : ∀ x ∈ (RingHom.ker (augmentation : CompletedGroupAlgebra (ZMod p)
      (ℕ → Multiplicative (ZMod p)) →+* ZMod p)).restrictScalars ℤ,
      finiteAugmentation (Λ := ZMod p) _ (eval (piZModLevel p (2 * m)) x) = 0 := fun x hx => by
    rw [← augmentation_eq]; exact hx
  have hPQ : P * Q = 1 := by
    ext a b
    set q := moment (fun h => piZModCoord p (2 * m) (E a) h * piZModCoord p (2 * m) (O b) h)
    have h1 : q (eval (piZModLevel p (2 * m)) (piZModSum p)) = (P * Q) a b := by
      rw [hsum, map_sum, map_sum, Matrix.mul_apply, Fintype.sum_sum_type, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_mul, moment_mul_mul_of_ker (piZModCoord_mul p _ _) (piZModCoord_mul p _ _)
        (hker _ (hα k)) (hker _ (hβ k))]
      simp [P, Q, ℓ]
      ring
    have h2 : q (eval (piZModLevel p (2 * m)) (piZModSum p)) =
        (1 : Matrix (Fin m) (Fin m) (ZMod p)) a b := by
      rw [eval_piZModSum,
        piZModSumComponent_eq p (n := m) fun t ht => (mem_piZModLevel p).2 fun i => ?_]
      · rw [map_sum, Finset.sum_eq_single (a : ℕ)]
        · rw [piZModTerm, moment_mul_mul_of_ker (piZModCoord_mul p _ _) (piZModCoord_mul p _ _)
            (hδ _ _) (hδ _ _)]
          simp only [moment_piZModCoord_piZModBasis, E, O, Matrix.one_apply, Fin.ext_iff]
          split_ifs <;> first | (exfalso; omega) | norm_num
        · intro t _ ht
          rw [piZModTerm, moment_mul_mul_of_ker (piZModCoord_mul p _ _) (piZModCoord_mul p _ _)
            (hδ _ _) (hδ _ _)]
          simp only [moment_piZModCoord_piZModBasis, E, O]
          split_ifs <;> first | (exfalso; omega) | norm_num
        · intro ha; exact absurd (Finset.mem_range.2 a.2) ha
      · simp only [piZModBasis, Pi.mulSingle_apply]
        exact ite_eq_right_iff.2 fun h => absurd h (by have := i.isLt; omega)
    rw [← h1, h2]
  have hrank := Matrix.rank_mul_le_left P Q
  rw [hPQ, Matrix.rank_one, Fintype.card_fin] at hrank
  have := hrank.trans (Matrix.rank_le_card_width P)
  simp only [Fintype.card_sum, Fintype.card_fin] at this
  omega

end Stacks.GroupHomology
