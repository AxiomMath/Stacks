module

public import Mathlib.Data.Nat.Factorization.Basic
public import Mathlib.Data.Nat.Factorization.Induction
public import Mathlib.Data.ZMod.Basic
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GroupHomology.CompletedGroupAlgebra

/-!
# The completed group algebra of a procyclic group

Let `G` be a compact topological group and `σ ∈ G` an element generating every finite quotient
`G/U` by an open normal subgroup. Let `Λ` be a ring killed by an integer `n ≠ 0` such that, for
every prime `ℓ ∣ n` and every `e`, `G` has a quotient `G → ℤ/ℓ^e` with open kernel sending `σ` to
`1`. Then in the completed group algebra `Λ[[G]]`:

* every group element is central, in particular `σ - 1` is;
* left multiplication by `σ - 1` is injective;
* its image is the augmentation ideal, the kernel of `Λ[[G]] → Λ`.

So `0 → Λ[[G]] → Λ[[G]] → Λ → 0`, the middle map being multiplication by `σ - 1`, is exact. For
`G = Ẑ^{(q)} = ∏_{ℓ ∤ q} ℤ_ℓ`, `σ = 1` and `ℓ ∤ q` these are the hypotheses that hold, and this is
the computation of the derived coinvariants `LH₀(Ẑ^{(q)}, -)` of [Stacks, Tag 03VQ].

All names are in the namespace `Stacks.GroupHomology.Procyclic`.

## Main results

* `of_mul_comm`: group elements are central in `Λ[[G]]`.
* `eq_zero_of_mul_eq_zero`: `(σ - 1) x = 0 → x = 0`.
* `exists_mul_eq_of_augmentation_eq_zero`: every element of the augmentation ideal is `(σ - 1) y`.

## References

* [Stacks Project, Tag 03VQ](https://stacks.math.columbia.edu/tag/03VQ)
* [Stacks Project, Tag 03VI](https://stacks.math.columbia.edu/tag/03VI)
-/

@[expose] public noncomputable section

universe u

namespace Stacks.GroupHomology.Procyclic

open CompletedGroupAlgebra MonoidAlgebra

/-! ### Finite cyclic groups -/

section FiniteCyclic

variable {H : Type u} [Group H] [Finite H] {s : H}

/-- A sum over a finite group generated by `s` is a sum over the powers `s^j`, `j < ord(s)`. -/
public theorem sum_univ_eq_sum_range [Fintype H] (hs : ∀ h : H, ∃ j : ℕ, h = s ^ j) {N : Type*}
    [AddCommMonoid N] (f : H → N) :
    ∑ h, f h = ∑ j ∈ Finset.range (orderOf s), f (s ^ j) := by
  classical
  have himage : (Finset.range (orderOf s)).image (s ^ ·) = Finset.univ := by
    refine Finset.eq_univ_of_forall fun h => ?_
    obtain ⟨j, rfl⟩ := hs h
    exact Finset.mem_image.2 ⟨j % orderOf s, Finset.mem_range.2 (Nat.mod_lt _ (orderOf_pos s)),
      pow_mod_orderOf s j⟩
  rw [← himage, Finset.sum_image]
  intro i hi j hj hij
  exact pow_injOn_Iio_orderOf (Finset.mem_range.1 hi) (Finset.mem_range.1 hj) hij

/-- A sum over `c · ord(t)` consecutive powers of `t` is `c` times the sum over `ord(t)` powers. -/
public theorem sum_range_mul_orderOf {H' : Type*} [Monoid H'] (t : H') {N : Type*}
    [AddCommMonoid N] (f : H' → N) (c : ℕ) :
    ∑ j ∈ Finset.range (c * orderOf t), f (t ^ j) =
      c • ∑ j ∈ Finset.range (orderOf t), f (t ^ j) := by
  induction c with
  | zero => simp
  | succ c ih =>
    rw [add_mul, one_mul, Finset.sum_range_add, ih, succ_nsmul]
    congr 1
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [pow_add, pow_mul', pow_orderOf_eq_one, one_pow, one_mul]

variable {Λ : Type u} [Ring Λ]

omit [Finite H] in
/-- **The kernel of `σ - 1` at a finite level**: an element of `Λ[H]` killed by `s - 1`, for `s`
generating `H`, has constant coefficients. -/
public theorem coeff_eq_of_mul_eq_zero (hs : ∀ h : H, ∃ j : ℕ, h = s ^ j) {x : MonoidAlgebra Λ H}
    (hx : (single s 1 - 1) * x = 0) (h : H) : x.coeff h = x.coeff 1 := by
  have hstep : ∀ h : H, x.coeff (s⁻¹ * h) = x.coeff h := by
    intro h
    have h1 : (single s 1 * x).coeff h = x.coeff (s⁻¹ * h) := by
      rw [coeff_single_mul_eq_mul_coeff (m₂ := s⁻¹ * h), one_mul]
      intro m _
      constructor
      · rintro rfl
        exact (inv_mul_cancel_left s m).symm
      · rintro rfl
        exact mul_inv_cancel_left s h
    have h2 : (single s 1 * x).coeff h = x.coeff h := by
      rw [sub_mul, one_mul, sub_eq_zero] at hx
      rw [hx]
    rw [← h1, h2]
  have hpow : ∀ j : ℕ, ∀ h : H, x.coeff ((s⁻¹) ^ j * h) = x.coeff h := by
    intro j
    induction j with
    | zero => simp
    | succ j ih =>
      intro h
      rw [pow_succ', mul_assoc, hstep, ih]
  obtain ⟨j, rfl⟩ := hs h
  rw [← hpow j (s ^ j), inv_pow, inv_mul_cancel]

omit [Finite H] in
/-- `(s - 1) Σ_{i < j} s^i a = s^j a - a`. -/
public theorem sub_one_mul_sum_range (s : H) (a : Λ) (j : ℕ) :
    (single s 1 - 1) * ∑ i ∈ Finset.range j, single (s ^ i) a = single (s ^ j) a - single 1 a := by
  rw [Finset.mul_sum]
  have : ∀ i, (single s 1 - 1) * single (s ^ i) a = single (s ^ (i + 1)) a - single (s ^ i) a := by
    intro i
    rw [sub_mul, single_mul_single, one_mul, one_mul, ← pow_succ']
  simp_rw [this]
  rw [Finset.sum_range_sub (fun i => single (s ^ i) a), pow_zero]

omit [Finite H] in
/-- **Solutions at a finite level**: for `s` generating `H`, every `x ∈ Λ[H]` is
`(s - 1) z + ε(x)`. -/
public theorem exists_mul_eq_sub (hs : ∀ h : H, ∃ j : ℕ, h = s ^ j) (x : MonoidAlgebra Λ H) :
    ∃ z, (single s 1 - 1) * z = x - single 1 (finiteAugmentation H x) := by
  induction x using MonoidAlgebra.induction_linear with
  | zero => exact ⟨0, by simp⟩
  | add x y hx hy =>
    obtain ⟨z, hz⟩ := hx
    obtain ⟨w, hw⟩ := hy
    refine ⟨z + w, ?_⟩
    rw [mul_add, hz, hw, map_add, single_add]
    abel
  | single h a =>
    obtain ⟨j, rfl⟩ := hs h
    exact ⟨_, by rw [sub_one_mul_sum_range, finiteAugmentation_single]⟩

omit [Finite H] in
/-- In a group in which every element is a power of `s`, `single s 1` commutes with everything. -/
public theorem single_mul_comm (hs : ∀ h : H, ∃ j : ℕ, h = s ^ j) (g : H) (x : MonoidAlgebra Λ H) :
    single g 1 * x = x * single g 1 := by
  induction x using MonoidAlgebra.induction_linear with
  | zero => simp
  | add x y hx hy => rw [mul_add, add_mul, hx, hy]
  | single h a =>
    rw [single_mul_single, single_mul_single, one_mul, mul_one]
    obtain ⟨i, rfl⟩ := hs g
    obtain ⟨j, rfl⟩ := hs h
    rw [← pow_add, ← pow_add, add_comm]

end FiniteCyclic

/-! ### The completed group algebra -/

variable {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  {σ : G} {Λ : Type u} [Ring Λ]

/-- `σ` generates every finite quotient of `G`. -/
public abbrev GeneratesQuotients (σ : G) : Prop :=
  ∀ (U : OpenNormalSubgroup G) (g : G), ∃ j : ℕ,
    (g : G ⧸ (U : Subgroup G)) = (σ : G ⧸ (U : Subgroup G)) ^ j

/-- For every `e`, `G` has a quotient `ℤ/ℓ^e` with open kernel sending `σ` to `1`. -/
public abbrev HasPrimePowerQuotients (σ : G) (ℓ : ℕ) : Prop :=
  ∀ e : ℕ, ∃ ψ : G →* Multiplicative (ZMod (ℓ ^ e)), IsOpen (ψ.ker : Set G) ∧
    ψ σ = Multiplicative.ofAdd 1

section

variable (hgen : GeneratesQuotients σ)
include hgen

omit [IsTopologicalGroup G] [CompactSpace G] in
/-- Every element of a finite quotient is a power of the image of `σ`. -/
public theorem exists_eq_pow (U : OpenNormalSubgroup G) (h : G ⧸ (U : Subgroup G)) :
    ∃ j : ℕ, h = (σ : G ⧸ (U : Subgroup G)) ^ j := by
  induction h using QuotientGroup.induction_on with
  | H g => exact hgen U g

omit [IsTopologicalGroup G] [CompactSpace G] in
/-- **Group elements are central in `Λ[[G]]`.** -/
public theorem of_mul_comm (g : G) (x : CompletedGroupAlgebra Λ G) :
    (of g : CompletedGroupAlgebra Λ G) * x = x * of g :=
  CompletedGroupAlgebra.ext fun U => by
    rw [map_mul, map_mul, eval_of]
    exact single_mul_comm (exists_eq_pow hgen U) _ _

omit [IsTopologicalGroup G] [CompactSpace G] in
/-- `σ - 1` is central in `Λ[[G]]`. -/
public theorem sub_one_mul_comm (x : CompletedGroupAlgebra Λ G) :
    ((of σ : CompletedGroupAlgebra Λ G) - 1) * x = x * ((of σ : CompletedGroupAlgebra Λ G) - 1) :=
  by rw [sub_mul, mul_sub, of_mul_comm hgen, one_mul, mul_one]

end

omit [IsTopologicalGroup G] [CompactSpace G] in
/-- The order of `σ` in a smaller quotient is a multiple of its order in a larger one. -/
public theorem orderOf_dvd_orderOf {U V : OpenNormalSubgroup G} (h : V ≤ U) :
    orderOf (σ : G ⧸ (U : Subgroup G)) ∣ orderOf (σ : G ⧸ (V : Subgroup G)) := by
  rw [orderOf_dvd_iff_pow_eq_one, ← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
  have key := pow_orderOf_eq_one (σ : G ⧸ (V : Subgroup G))
  rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff] at key
  exact h key

/-- The open normal subgroup `V` lies deep enough below `U` for the ring `Λ`: the order of `σ` in
`G/V` is a multiple `c` of its order in `G/U`, with `c Λ = 0`. -/
public def IsDeep (Λ : Type u) [Ring Λ] (σ : G) (U V : OpenNormalSubgroup G) : Prop :=
  V ≤ U ∧ ∃ c : ℕ, orderOf (σ : G ⧸ (V : Subgroup G)) = c * orderOf (σ : G ⧸ (U : Subgroup G)) ∧
    ∀ a : Λ, c • a = 0

omit [IsTopologicalGroup G] [CompactSpace G] in
/-- A subgroup below a deep one is deep. -/
public theorem IsDeep.mono {U V W : OpenNormalSubgroup G} (hV : IsDeep Λ σ U V) (hW : W ≤ V) :
    IsDeep Λ σ U W := by
  obtain ⟨hVU, c, hc, hca⟩ := hV
  refine ⟨hW.trans hVU, ?_⟩
  obtain ⟨d, hd⟩ := orderOf_dvd_orderOf (σ := σ) hW
  refine ⟨d * c, by rw [hd, hc, mul_comm, mul_assoc], fun a => ?_⟩
  rw [mul_smul, hca, smul_zero]

/-- Below every open normal subgroup `U` there is one in which the order of `σ` is multiplied by a
multiple of a prime `p`, if `G` has the `p`-power quotients. -/
public theorem exists_deep_prime {p : ℕ} (hp : p.Prime) (hpow : HasPrimePowerQuotients σ p)
    (U : OpenNormalSubgroup G) :
    ∃ V : OpenNormalSubgroup G, V ≤ U ∧ ∃ t : ℕ,
      orderOf (σ : G ⧸ (V : Subgroup G)) = t * orderOf (σ : G ⧸ (U : Subgroup G)) ∧ p ∣ t := by
  set n := orderOf (σ : G ⧸ (U : Subgroup G))
  have hn : n ≠ 0 := (orderOf_pos _).ne'
  obtain ⟨v, r, hnr, hr⟩ := Nat.exists_eq_pow_mul_and_not_dvd hn p hp.one_lt.ne'
  obtain ⟨ψ, hψopen, hψσ⟩ := hpow (v + 1)
  let K : OpenNormalSubgroup G :=
    { toOpenSubgroup := ⟨ψ.ker, hψopen⟩
      isNormal' := ψ.normal_ker }
  refine ⟨U ⊓ K, inf_le_left, ?_⟩
  set m := orderOf (σ : G ⧸ ((U ⊓ K : OpenNormalSubgroup G) : Subgroup G))
  have hmem : σ ^ m ∈ ((U ⊓ K : OpenNormalSubgroup G) : Subgroup G) := by
    rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_pow, pow_orderOf_eq_one]
  have hK : p ^ (v + 1) ∣ m := by
    have h1 : ψ (σ ^ m) = 1 := hmem.2
    rwa [map_pow, hψσ, ← ofAdd_nsmul, nsmul_one, ofAdd_eq_one, ZMod.natCast_eq_zero_iff] at h1
  obtain ⟨c, hc⟩ : n ∣ m := orderOf_dvd_orderOf (σ := σ) (inf_le_left : U ⊓ K ≤ U)
  refine ⟨c, by rw [hc, mul_comm], ?_⟩
  rw [hc, hr, pow_succ, mul_assoc] at hK
  have h2 : p ∣ r * c := Nat.dvd_of_mul_dvd_mul_left (pow_pos hp.pos v) hK
  exact ((Nat.Prime.coprime_iff_not_dvd hp).2 hnr).dvd_of_dvd_mul_left h2

/-- Below every open normal subgroup `U` there is one in which the order of `σ` is multiplied by a
multiple of `n`, if `G` has the prime power quotients for the primes dividing `n`. -/
public theorem exists_deep_dvd {n : ℕ} (hn : n ≠ 0)
    (hpow : ∀ p : ℕ, p.Prime → p ∣ n → HasPrimePowerQuotients σ p) (U : OpenNormalSubgroup G) :
    ∃ V : OpenNormalSubgroup G, V ≤ U ∧ ∃ t : ℕ,
      orderOf (σ : G ⧸ (V : Subgroup G)) = t * orderOf (σ : G ⧸ (U : Subgroup G)) ∧ n ∣ t := by
  induction n using Nat.recOnMul generalizing U with
  | zero => exact absurd rfl hn
  | one => exact ⟨U, le_rfl, 1, by rw [one_mul], dvd_rfl⟩
  | prime p hp => exact exists_deep_prime hp (hpow p hp dvd_rfl) U
  | mul a b iha ihb =>
    obtain ⟨V₁, hV₁, t₁, ht₁, ha⟩ := iha (left_ne_zero_of_mul hn)
      (fun p hp hpa => hpow p hp (hpa.mul_right b)) U
    obtain ⟨V₂, hV₂, t₂, ht₂, hb⟩ := ihb (right_ne_zero_of_mul hn)
      (fun p hp hpb => hpow p hp (hpb.mul_left a)) V₁
    exact ⟨V₂, hV₂.trans hV₁, t₂ * t₁, by rw [ht₂, ht₁, mul_assoc],
      by rw [mul_comm a b]; exact mul_dvd_mul hb ha⟩

/-- **Deep subgroups exist**, for a ring `Λ` killed by an integer `n ≠ 0` all of whose prime
factors have prime power quotients. -/
public theorem exists_isDeep {n : ℕ} (hn : n ≠ 0)
    (hpow : ∀ p : ℕ, p.Prime → p ∣ n → HasPrimePowerQuotients σ p) (hΛ : ∀ a : Λ, n • a = 0)
    (U : OpenNormalSubgroup G) : ∃ V, IsDeep Λ σ U V := by
  obtain ⟨V, hVU, t, ht, hnt⟩ := exists_deep_dvd hn hpow U
  obtain ⟨d, rfl⟩ := hnt
  exact ⟨V, hVU, n * d, ht, fun a => by rw [mul_comm, mul_smul, hΛ, smul_zero]⟩

variable (hgen : GeneratesQuotients σ)
include hgen

/-- The constant function `λ` on `G/V`, pushed to `G/U` for `V` deep below `U`, vanishes. -/
public theorem quotientAlgebraMap_const_eq_zero {U V : OpenNormalSubgroup G}
    (hV : IsDeep Λ σ U V) (a : Λ) :
    letI := Fintype.ofFinite (G ⧸ (V : Subgroup G))
    quotientAlgebraMap Λ hV.1 (∑ h : G ⧸ (V : Subgroup G), single h a) = 0 := by
  let := Fintype.ofFinite (G ⧸ (V : Subgroup G))
  obtain ⟨hVU, c, hc, hca⟩ := hV
  rw [map_sum, sum_univ_eq_sum_range (exists_eq_pow hgen V)]
  have : ∀ j : ℕ, quotientAlgebraMap Λ hVU (single ((σ : G ⧸ (V : Subgroup G)) ^ j) a) =
      single ((σ : G ⧸ (U : Subgroup G)) ^ j) a := by
    intro j
    rw [← QuotientGroup.mk_pow, quotientAlgebraMap_single, QuotientGroup.mk_pow]
  simp_rw [this]
  rw [hc, sum_range_mul_orderOf (σ : G ⧸ (U : Subgroup G)) (fun t => single t a) c,
    ← Finset.sum_nsmul]
  refine Finset.sum_eq_zero fun j _ => ?_
  rw [smul_single, hca, single_zero]

/-- **Left multiplication by `σ - 1` on `Λ[[G]]` is injective.** -/
public theorem eq_zero_of_mul_eq_zero {n : ℕ} (hn : n ≠ 0)
    (hpow : ∀ p : ℕ, p.Prime → p ∣ n → HasPrimePowerQuotients σ p) (hΛ : ∀ a : Λ, n • a = 0)
    {x : CompletedGroupAlgebra Λ G}
    (hx : ((of σ : CompletedGroupAlgebra Λ G) - 1) * x = 0) : x = 0 := by
  refine CompletedGroupAlgebra.ext fun U => ?_
  obtain ⟨V, hV⟩ := exists_isDeep hn hpow hΛ U
  let := Fintype.ofFinite (G ⧸ (V : Subgroup G))
  have hxV : (single (σ : G ⧸ (V : Subgroup G)) 1 - 1) * eval V x = 0 := by
    have := congrArg (eval V) hx
    rwa [map_mul, map_sub, map_one, eval_of, map_zero] at this
  have hconst : eval V x = ∑ h : G ⧸ (V : Subgroup G), single h ((eval V x).coeff 1) := by
    refine MonoidAlgebra.coeff_injective (Finsupp.ext fun h => ?_)
    rw [coeff_eq_of_mul_eq_zero (exists_eq_pow hgen V) hxV h]
    simp [coeff_sum, coeff_single]
  rw [map_zero, ← quotientAlgebraMap_eval hV.1, hconst]
  exact quotientAlgebraMap_const_eq_zero hgen hV _

/-- Two solutions of `(σ̄ - 1) z = x` at a level deep below `U` have the same image at `U`. -/
public theorem quotientAlgebraMap_eq_of_mul_eq {U V : OpenNormalSubgroup G} (hV : IsDeep Λ σ U V)
    {z z' : MonoidAlgebra Λ (G ⧸ (V : Subgroup G))}
    (h : (single (σ : G ⧸ (V : Subgroup G)) 1 - 1) * z =
      (single (σ : G ⧸ (V : Subgroup G)) 1 - 1) * z') :
    quotientAlgebraMap Λ hV.1 z = quotientAlgebraMap Λ hV.1 z' := by
  let := Fintype.ofFinite (G ⧸ (V : Subgroup G))
  have hd : (single (σ : G ⧸ (V : Subgroup G)) 1 - 1) * (z - z') = 0 := by
    rw [mul_sub, h, sub_self]
  have hconst : z - z' = ∑ y : G ⧸ (V : Subgroup G), single y ((z - z').coeff 1) := by
    refine MonoidAlgebra.coeff_injective (Finsupp.ext fun y => ?_)
    rw [coeff_eq_of_mul_eq_zero (exists_eq_pow hgen V) hd y]
    simp [coeff_sum, coeff_single]
  rw [← sub_eq_zero, ← map_sub, hconst]
  exact quotientAlgebraMap_const_eq_zero hgen hV _

omit [IsTopologicalGroup G] [CompactSpace G] in
/-- A solution of `(σ̄ - 1) z = x_V` at the level `V`, for `x` in the augmentation ideal. -/
public theorem exists_levelSolution {x : CompletedGroupAlgebra Λ G} (hx : augmentation x = 0)
    (V : OpenNormalSubgroup G) :
    ∃ z, (single (σ : G ⧸ (V : Subgroup G)) 1 - 1) * z = eval V x := by
  obtain ⟨z, hz⟩ := exists_mul_eq_sub (exists_eq_pow hgen V) (eval V x)
  refine ⟨z, ?_⟩
  rw [hz, ← augmentation_eq, hx, single_zero, sub_zero]

/-- **The image of `σ - 1` is the augmentation ideal**: every `x` with `ε(x) = 0` is `(σ - 1) y`.
-/
public theorem exists_mul_eq_of_augmentation_eq_zero {n : ℕ} (hn : n ≠ 0)
    (hpow : ∀ p : ℕ, p.Prime → p ∣ n → HasPrimePowerQuotients σ p) (hΛ : ∀ a : Λ, n • a = 0)
    {x : CompletedGroupAlgebra Λ G} (hx : augmentation x = 0) :
    ∃ y : CompletedGroupAlgebra Λ G, ((of σ : CompletedGroupAlgebra Λ G) - 1) * y = x := by
  classical
  choose V hV using exists_isDeep (Λ := Λ) hn hpow hΛ
  choose z hz using exists_levelSolution (Λ := Λ) hgen hx
  let y : ∀ U : OpenNormalSubgroup G, MonoidAlgebra Λ (G ⧸ (U : Subgroup G)) :=
    fun U => quotientAlgebraMap Λ (hV U).1 (z (V U))
  have key : ∀ (U W : OpenNormalSubgroup G) (hW : IsDeep Λ σ U W)
      (t : MonoidAlgebra Λ (G ⧸ (W : Subgroup G))),
      (single (σ : G ⧸ (W : Subgroup G)) 1 - 1) * t = eval W x →
      quotientAlgebraMap Λ hW.1 t = y U := by
    intro U W hW t ht
    let T := W ⊓ V U
    have hTW : T ≤ W := inf_le_left
    have hTV : T ≤ V U := inf_le_right
    have hsol : ∀ (X : OpenNormalSubgroup G) (hX : T ≤ X),
        (single (σ : G ⧸ (X : Subgroup G)) 1 - 1) * quotientAlgebraMap Λ hX (z T) = eval X x := by
      intro X hX
      have := congrArg (quotientAlgebraMap Λ hX) (hz T)
      rwa [map_mul, map_sub, map_one, quotientAlgebraMap_single, quotientAlgebraMap_eval] at this
    have h1 : quotientAlgebraMap Λ hW.1 t =
        quotientAlgebraMap Λ hW.1 (quotientAlgebraMap Λ hTW (z T)) :=
      quotientAlgebraMap_eq_of_mul_eq hgen hW (by rw [ht, hsol W hTW])
    have h2 : quotientAlgebraMap Λ (hV U).1 (z (V U)) =
        quotientAlgebraMap Λ (hV U).1 (quotientAlgebraMap Λ hTV (z T)) :=
      quotientAlgebraMap_eq_of_mul_eq hgen (hV U) (by rw [hz, hsol (V U) hTV])
    have hc : ∀ {X : OpenNormalSubgroup G} (hX : T ≤ X) (hXU : X ≤ U),
        quotientAlgebraMap Λ hXU (quotientAlgebraMap Λ hX (z T)) =
          quotientAlgebraMap Λ (hX.trans hXU) (z T) := by
      intro X hX hXU
      rw [← RingHom.comp_apply]
      congr 1
      refine MonoidAlgebra.ringHom_ext (fun a => ?_) (fun q => ?_)
      · simp
      · induction q using QuotientGroup.induction_on with
        | H g => simp
    rw [h1, hc, show y U = _ from h2, hc]
  refine ⟨CompletedGroupAlgebra.mk y fun U U' hUU' => ?_, ?_⟩
  · let W := V U ⊓ V U'
    have hWU : IsDeep Λ σ U W := (hV U).mono inf_le_left
    have hWU' : IsDeep Λ σ U' W := (hV U').mono inf_le_right
    obtain ⟨t, ht⟩ := exists_levelSolution (Λ := Λ) hgen hx W
    rw [← key U W hWU t ht, ← key U' W hWU' t ht, ← RingHom.comp_apply]
    congr 1
    refine MonoidAlgebra.ringHom_ext (fun a => ?_) (fun q => ?_)
    · simp
    · induction q using QuotientGroup.induction_on with
      | H g => simp
  · refine CompletedGroupAlgebra.ext fun U => ?_
    rw [map_mul, map_sub, map_one, eval_of, eval_mk]
    have := congrArg (quotientAlgebraMap Λ (hV U).1) (hz (V U))
    rwa [map_mul, map_sub, map_one, quotientAlgebraMap_single, quotientAlgebraMap_eval] at this

/-- **The augmentation of `(τ - 1) / (σ - 1)`**: if `(σ - 1) w = τ - 1` in `Λ[[G]]` and `τ = σ^v`
in a finite quotient `G/W` whose order kills `Λ`, then `ε(w) = v`. -/
public theorem augmentation_eq_natCast_of_mul_eq {τ : G} {w : CompletedGroupAlgebra Λ G}
    (hw : ((of σ : CompletedGroupAlgebra Λ G) - 1) * w = of τ - 1) (W : OpenNormalSubgroup G)
    {v : ℕ} (hv : (τ : G ⧸ (W : Subgroup G)) = (σ : G ⧸ (W : Subgroup G)) ^ v)
    (hW : ((orderOf (σ : G ⧸ (W : Subgroup G)) : ℕ) : Λ) = 0) :
    augmentation w = v := by
  let := Fintype.ofFinite (G ⧸ (W : Subgroup G))
  set s := (σ : G ⧸ (W : Subgroup G))
  set z : MonoidAlgebra Λ (G ⧸ (W : Subgroup G)) := ∑ i ∈ Finset.range v, single (s ^ i) 1
  have hz : (single s 1 - 1) * z = single (s ^ v) 1 - single 1 1 := sub_one_mul_sum_range s 1 v
  have hwW : (single s 1 - 1) * eval W w = single (s ^ v) 1 - single 1 1 := by
    have := congrArg (eval W) hw
    rw [map_mul, map_sub, map_one, eval_of, map_sub, map_one, eval_of, hv] at this
    rw [this, one_def]
  have hd : (single s 1 - 1) * (eval W w - z) = 0 := by rw [mul_sub, hwW, hz, sub_self]
  have hconst : eval W w - z =
      ∑ y : G ⧸ (W : Subgroup G), single y ((eval W w - z).coeff 1) := by
    refine MonoidAlgebra.coeff_injective (Finsupp.ext fun y => ?_)
    rw [coeff_eq_of_mul_eq_zero (exists_eq_pow hgen W) hd y]
    simp [coeff_sum, coeff_single]
  have haug : finiteAugmentation (G ⧸ (W : Subgroup G)) (eval W w - z) = 0 := by
    rw [hconst, map_sum]
    simp only [finiteAugmentation_single, Finset.sum_const, Finset.card_univ]
    rw [← Nat.card_eq_fintype_card, ← orderOf_eq_card_of_forall_mem_zpowers, nsmul_eq_mul, hW,
      zero_mul]
    intro x
    obtain ⟨j, rfl⟩ := exists_eq_pow hgen W x
    exact ⟨j, zpow_natCast s j⟩
  rw [augmentation_eq W, ← sub_add_cancel (eval W w) z, map_add, haug, zero_add, map_sum]
  simp [finiteAugmentation_single]

end Stacks.GroupHomology.Procyclic

