module

public import Mathlib.CategoryTheory.Sites.CoverPreserving
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Comparison.ZariskiRestriction

/-!
# Restricting an étale sheaf to the open subschemes already gives a Zariski sheaf

The open subschemes of a scheme `X` sit inside its small étale site along
`AlgebraicGeometry.opensToEtale`, and a Zariski covering of an open subscheme is in particular an
étale covering of it. Restricting a sheaf on the small étale site along that inclusion therefore
produces a presheaf on `X.Opens` which already satisfies the Zariski sheaf condition — no
sheafification is needed.

## Main definitions

* `AlgebraicGeometry.homToOpensToEtale` — the morphism of the small étale site from an object to
  an open subscheme containing the image of its structure morphism.

## Main results

* `AlgebraicGeometry.subsingleton_hom_opensToEtale` — there is at most one morphism of the small
  étale site from a given object to a given open subscheme.
* `AlgebraicGeometry.range_subset_of_hom_opensToEtale` — a morphism to an open subscheme forces
  that subscheme to contain the image of the structure morphism.
* `AlgebraicGeometry.representablyFlat_opensToEtale` — `opensToEtale` is representably flat.
* `AlgebraicGeometry.coverPreserving_opensToEtale` — a Zariski covering sieve of an open
  subscheme generates a covering sieve of the small étale site.
* `AlgebraicGeometry.opensToEtale_isContinuous` — `opensToEtale` is a continuous functor.
* `AlgebraicGeometry.isSheaf_opensToEtale_op_comp` — the restriction of a sheaf on the small
  étale site to the open subschemes is a Zariski sheaf.

## References

* [Stacks Project, Tag 09AX](https://stacks.math.columbia.edu/tag/09AX)
* [Stacks Project, Tag 09ZF](https://stacks.math.columbia.edu/tag/09ZF)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace

universe w v u

namespace AlgebraicGeometry

variable {X : Scheme.{u}}

/-- There is at most one morphism of the small étale site from an object to an open subscheme. -/
public instance subsingleton_hom_opensToEtale (W : X.Etale) (V : X.Opens) :
    Subsingleton (W ⟶ (opensToEtale X).obj V) where
  allEq g h := by
    apply MorphismProperty.Comma.Hom.ext'
    apply Over.OverMorphism.ext
    exact (cancel_mono V.ι).1
      ((MorphismProperty.Over.w g).trans (MorphismProperty.Over.w h).symm)

/-- An open subscheme receiving a morphism of the small étale site from `W` contains the image of
the structure morphism of `W`. -/
public theorem range_subset_of_hom_opensToEtale {W : X.Etale} {V : X.Opens}
    (g : W ⟶ (opensToEtale X).obj V) :
    Set.range (W.hom : W.left ⟶ X).base ⊆ (V : Set X) := by
  have hw : g.left ≫ V.ι = (W.hom : W.left ⟶ X) := MorphismProperty.Over.w g
  rw [← hw, ← Scheme.Opens.range_ι V]
  rintro _ ⟨y, rfl⟩
  exact ⟨g.left.base y, (Scheme.Hom.comp_apply g.left V.ι y).symm⟩

/-- The morphism of the small étale site from `W` to an open subscheme containing the image of
the structure morphism of `W`, obtained by lifting that structure morphism through the open
immersion. -/
public def homToOpensToEtale (W : X.Etale) (V : X.Opens)
    (hV : Set.range (W.hom : W.left ⟶ X).base ⊆ (V : Set X)) :
    W ⟶ (opensToEtale X).obj V := by
  have hrange : Set.range (W.hom : W.left ⟶ X).base ⊆ Set.range V.ι.base := by
    rwa [Scheme.Opens.range_ι]
  exact MorphismProperty.Over.homMk
    ((IsOpenImmersion.lift V.ι (W.hom : W.left ⟶ X) hrange : W.left ⟶ V.toScheme))
    (IsOpenImmersion.lift_fac V.ι (W.hom : W.left ⟶ X) hrange) trivial

/-- The structured arrows from an object `W` of the small étale site to `opensToEtale` form a
cofiltered category. -/
public instance isCofiltered_structuredArrow_opensToEtale (W : X.Etale) :
    IsCofiltered (StructuredArrow W (opensToEtale X)) where
  cone_objs A B := by
    have hA := range_subset_of_hom_opensToEtale A.hom
    have hB := range_subset_of_hom_opensToEtale B.hom
    refine ⟨StructuredArrow.mk (homToOpensToEtale W (A.right ⊓ B.right) ?_),
      StructuredArrow.homMk (homOfLE inf_le_left) (Subsingleton.elim _ _),
      StructuredArrow.homMk (homOfLE inf_le_right) (Subsingleton.elim _ _), trivial⟩
    simpa only [Opens.coe_inf] using Set.subset_inter hA hB
  cone_maps A B f g :=
    ⟨A, 𝟙 A, by rw [StructuredArrow.hom_ext f g (Subsingleton.elim _ _)]⟩
  nonempty := ⟨StructuredArrow.mk (homToOpensToEtale W ⊤ (by simp))⟩

/-- `opensToEtale` is representably flat. -/
public instance representablyFlat_opensToEtale (X : Scheme.{u}) :
    RepresentablyFlat (opensToEtale X) where
  cofiltered := isCofiltered_structuredArrow_opensToEtale

/-- **A Zariski covering is an étale covering.** The sieve on the small étale site generated by
the image of a Zariski covering sieve of an open subscheme is a covering sieve. -/
public theorem coverPreserving_opensToEtale (X : Scheme.{u}) :
    CoverPreserving (Opens.grothendieckTopology X) (Scheme.smallEtaleTopology X)
      (opensToEtale X) where
  cover_preserve {U S} hS := by
    refine (Scheme.smallEtaleTopology X).superset_covering
      (S := Sieve.ofArrows
        (fun i : Σ V : X.Opens, {h : V ⟶ U // S.arrows h} => (opensToEtale X).obj i.1)
        (fun i => (opensToEtale X).map i.2.1)) ?_ ?_
    · refine (Sieve.generate_le_iff _ _).2 ?_
      rintro Z g ⟨i⟩
      exact Sieve.image_mem_functorPushforward (F := opensToEtale X) S i.2.2
    · rw [Scheme.ofArrows_mem_smallEtaleTopology_iff]
      ext y
      simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
      obtain ⟨V, h, hSh, hyV⟩ := hS y.1 y.2
      refine ⟨⟨V, h, hSh⟩, ⟨y.1, hyV⟩, Subtype.ext ?_⟩
      show Subtype.val ((X.homOfLE h.le).base ⟨y.1, hyV⟩) = y.1
      rw [Scheme.homOfLE_base]
      rfl

/-- **Restriction to the open subschemes is a continuous functor.** `opensToEtale` is continuous
for the Zariski topology on `X.Opens` and the small étale topology on `X.Etale`. -/
public instance opensToEtale_isContinuous (X : Scheme.{u}) :
    (opensToEtale X).IsContinuous (Opens.grothendieckTopology X)
      (Scheme.smallEtaleTopology X) :=
  Functor.isContinuous_of_coverPreserving
    (compatiblePreservingOfFlat _ _) (coverPreserving_opensToEtale X)

/-- **The restriction of an étale sheaf to the open subschemes is already a Zariski sheaf.** The
restriction along `opensToEtale` of a sheaf on the small étale site of `X` is a sheaf on the
Zariski site of `X`. -/
public theorem isSheaf_opensToEtale_op_comp {A : Type v} [Category.{w} A]
    (X : Scheme.{u}) (F : Sheaf (Scheme.smallEtaleTopology X) A) :
    Presheaf.IsSheaf (Opens.grothendieckTopology X) ((opensToEtale X).op ⋙ F.obj) :=
  (opensToEtale X).op_comp_isSheaf _ _ F

end AlgebraicGeometry

end
