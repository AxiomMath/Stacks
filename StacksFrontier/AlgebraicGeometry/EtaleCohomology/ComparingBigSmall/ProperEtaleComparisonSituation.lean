/-!
# The comparison situation for a topology finer than the étale topology

Let `E` be a big étale site and `K` a precoverage on its underlying category finer than the étale
one. The pair (`K`, étale), with the proper morphisms as distinguished class and the sheaves
`π_X⁻¹F` pulled back from torsion abelian sheaves `F` on the small étale site as the classes
`𝒜'_X`, is an instance of the comparison situation
`Stacks.ComparingTopologies.CohomologyComparison` of Stacks 0EZ3, given the sheaf condition for
`K`, the comparison of higher direct images along proper morphisms and the refinement property
0EZ8. For the ph topology this is Stacks 0F0I.

## Main definitions

* `AlgebraicGeometry.smallEtaleTorsionPullbackClass` — the class `𝒜'_X` of abelian sheaves on the
  big étale site over `X` of the form `π_X⁻¹F` with `F` a torsion abelian sheaf on `X_étale`.
* `AlgebraicGeometry.ProperDirectImageComparison` — the comparison
  `R^i f_{big,*}(π_X⁻¹F) ≅ π_Y⁻¹(R^i f_{small,*}F)` for proper `f` and torsion `F`.
* `AlgebraicGeometry.properEtaleCohomologyComparison` — the comparison situation of Stacks 0EZ3
  for `K` and the étale topology.

## Main results

* `AlgebraicGeometry.smallEtaleTorsionPullbackClass_isWeakSerreClass` — `𝒜'_X` is a weak Serre
  class, the first paragraph of the proof of Stacks 0F0I.

## Implementation notes

The comparison situation localizes its coarse topology as `J.over X` for the topology `J`
generated by the étale coverings of the site, whereas the étale API is written for the topology
`AlgebraicGeometry.BigEtaleOver.topology` of the slice, generated by the coverings of the slice.
The two are equal (`AlgebraicGeometry.bigEtaleOver_topology_eq_of_obj`) but not definitionally.
The functors of the étale API are therefore restated here for an arbitrary topology `J` on the
slice equal to `BigEtaleOver.topology`, and their properties are proved by substituting that
equality: the functors only depend on `J` through propositional instance arguments, so after the
substitution they are literally the functors of the étale API.

## References

* [Stacks Project, Tag 0F0I](https://stacks.math.columbia.edu/tag/0F0I)
* [Stacks Project, Tag 0EZ3](https://stacks.math.columbia.edu/tag/0EZ3)
* [Stacks Project, Tag 0DDI](https://stacks.math.columbia.edu/tag/0DDI)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

attribute [local instance] preservesBinaryBiproducts_of_preservesBinaryProducts

/-! ### The projection to the small étale site, for a topology equal to the slice topology -/

section Projection

variable (B : BigEtaleSite.{u}) (X : B.Scheme)

/-- The forgetful functor from abelian groups to types preserves filtered colimits of size
`u + 1`. -/
local instance : PreservesFilteredColimitsOfSize.{u + 1, u + 1}
    (forget AddCommGrpCat.{u + 1}) :=
  preservesFilteredColimitsOfSize_of_univLE.{u + 1, u + 1} _

/-- The full inclusion of the small étale site into the big étale slice is continuous for every
topology on the slice equal to the slice topology. -/
public theorem smallEtaleInclusion_isContinuous_of_eq
    {J : GrothendieckTopology (BigEtaleOver B X.obj X.property)}
    (hJ : BigEtaleOver.topology B X.obj X.property = J) :
    (SmallEtale.inclusion B X.obj X.property).IsContinuous
      (SmallEtale.topology B X.obj X.property) J := by
  subst hJ
  infer_instance

variable {J : GrothendieckTopology (BigEtaleOver B X.obj X.property)}
  (hJ : BigEtaleOver.topology B X.obj X.property = J)
  [(SmallEtale.inclusion B X.obj X.property).IsContinuous
    (SmallEtale.topology B X.obj X.property) J]
  [HasWeakSheafify J AddCommGrpCat.{u + 1}]

include hJ

/-- **Exactness of `π_X⁻¹`**, an ingredient of Stacks 0DDI (stated in full as
`AlgebraicGeometry.projectionDerivedAdjunctionUnit_app_isIso`), for a topology on the slice equal to the slice
topology. -/
public theorem smallEtaleInclusion_sheafPullback_exact :
    PreservesFiniteLimits ((SmallEtale.inclusion B X.obj X.property).sheafPullback
        AddCommGrpCat.{u + 1} (SmallEtale.topology B X.obj X.property) J) ∧
      PreservesFiniteColimits ((SmallEtale.inclusion B X.obj X.property).sheafPullback
        AddCommGrpCat.{u + 1} (SmallEtale.topology B X.obj X.property) J) := by
  subst hJ
  have : (projectionRestriction.{u, 0} B X.obj X.property).IsRightAdjoint :=
    ((SmallEtale.inclusion B X.obj X.property).sheafAdjunctionContinuous
      AddCommGrpCat.{u + 1} _ _).isRightAdjoint
  exact (exactFunctor_iff _).1 (projectionPullback_exact.{u, 0} B X.obj X.property)

/-- **Exactness of `π_{X,*}`**, an ingredient of Stacks 0DDI (stated in full as
`AlgebraicGeometry.projectionDerivedAdjunctionUnit_app_isIso`), for a topology on the slice equal to the slice
topology. -/
public theorem smallEtaleInclusion_sheafPushforward_exact :
    PreservesFiniteLimits ((SmallEtale.inclusion B X.obj X.property).sheafPushforwardContinuous
        AddCommGrpCat.{u + 1} (SmallEtale.topology B X.obj X.property) J) ∧
      PreservesFiniteColimits
        ((SmallEtale.inclusion B X.obj X.property).sheafPushforwardContinuous
          AddCommGrpCat.{u + 1} (SmallEtale.topology B X.obj X.property) J) := by
  subst hJ
  exact (exactFunctor_iff _).1 (projectionRestriction_exact.{u, 0} B X.obj X.property)

/-- **Full faithfulness of `π_X⁻¹`**, the underived ingredient of Stacks 0DDI (stated in full on
the unbounded derived category as `AlgebraicGeometry.projectionDerivedAdjunctionUnit_app_isIso`):
the unit of `π_X⁻¹ ⊣ π_{X,*}` on abelian sheaves is an isomorphism, the inclusion of the small étale site being fully faithful and
cocontinuous. -/
public theorem isIso_smallEtaleInclusion_sheafAdjunction_unit :
    IsIso ((SmallEtale.inclusion B X.obj X.property).sheafAdjunctionContinuous
      AddCommGrpCat.{u + 1} (SmallEtale.topology B X.obj X.property) J).unit := by
  subst hJ
  let i := SmallEtale.inclusion B X.obj X.property
  have ev : smallEtaleToBigEtaleFunctor B X X (𝟙 X) = i := by
    dsimp [smallEtaleToBigEtaleFunctor, i]
    rw [Over.mapId_eq]
    rfl
  have : i.IsCocontinuous (SmallEtale.topology B X.obj X.property)
      (BigEtaleOver.topology B X.obj X.property) :=
    ev ▸ smallEtaleToBigEtaleFunctor_isCocontinuous B X X (𝟙 X)
  have : ∀ F : (SmallEtale B X.obj X.property)ᵒᵖ ⥤ AddCommGrpCat.{u + 1},
      i.op.HasPointwiseRightKanExtension F := fun _ => inferInstance
  exact Functor.isIso_unit_of_sheafPushforwardContinuous i AddCommGrpCat.{u + 1} _ _ _

end Projection

/-! ### The class `𝒜'_X` -/

section WeakSerre

variable (B : BigEtaleSite.{u}) (X : B.Scheme)
  (J : GrothendieckTopology (BigEtaleOver B X.obj X.property))
  [(SmallEtale.inclusion B X.obj X.property).IsContinuous
    (SmallEtale.topology B X.obj X.property) J]
  [HasSheafify J AddCommGrpCat.{u + 1}]

/-- **The class `𝒜'_X` of Stacks 0F0I**: the abelian sheaves on the big étale site over `X` (for
a topology `J` on the slice) of the form `π_X⁻¹F`, with `F` a torsion abelian sheaf on the small
étale site of `X`. -/
public def smallEtaleTorsionPullbackClass : ObjectProperty (Sheaf J AddCommGrpCat.{u + 1}) :=
  (Stacks.Torsion.torsionSheafProperty.{u + 1} (SmallEtale.topology B X.obj X.property)).map
    ((SmallEtale.inclusion B X.obj X.property).sheafPullback AddCommGrpCat.{u + 1}
      (SmallEtale.topology B X.obj X.property) J)

variable {B X J}

/-- **Stacks 0F0I, first paragraph of the proof.** The class `𝒜'_X` is a weak Serre class:
`π_X⁻¹` is exact and fully faithful and `π_{X,*}` is exact (Stacks 0DDI), and torsion abelian
sheaves form a Serre subcategory of the small étale site (Stacks 0DD7). -/
public theorem smallEtaleTorsionPullbackClass_isWeakSerreClass
    (hJ : BigEtaleOver.topology B X.obj X.property = J) :
    (smallEtaleTorsionPullbackClass B X J).IsWeakSerreClass := by
  let adj := (SmallEtale.inclusion B X.obj X.property).sheafAdjunctionContinuous
    AddCommGrpCat.{u + 1} (SmallEtale.topology B X.obj X.property) J
  obtain ⟨hL₁, hL₂⟩ := smallEtaleInclusion_sheafPullback_exact B X hJ
  obtain ⟨hR₁, hR₂⟩ := smallEtaleInclusion_sheafPushforward_exact B X hJ
  have := isIso_smallEtaleInclusion_sheafAdjunction_unit B X hJ
  have hff := adj.fullyFaithfulLOfIsIsoUnit
  have := hff.full
  have := hff.faithful
  have : ((SmallEtale.inclusion B X.obj X.property).sheafPullback AddCommGrpCat.{u + 1}
      (SmallEtale.topology B X.obj X.property) J).Additive :=
    Functor.additive_of_preserves_binary_products _
  have : ((SmallEtale.inclusion B X.obj X.property).sheafPushforwardContinuous
      AddCommGrpCat.{u + 1} (SmallEtale.topology B X.obj X.property) J).Additive :=
    Functor.additive_of_preserves_binary_products _
  exact ObjectProperty.isWeakSerreClass_map adj _

end WeakSerre

/-! ### Restriction along a morphism of the site -/

section Restriction

variable (B : BigEtaleSite.{u}) {X Y : B.Scheme} (f : X ⟶ Y)

/-- **Stacks 021I, diagram (3), on abelian sheaves.** Restricting `π_Y⁻¹F` along `Over.map f` to
the big étale site over `X` gives `π_X⁻¹(f⁻¹F)`: both composites are left adjoint to the two
equal composites of direct images, `AlgebraicGeometry.bigSmallEtalePushforwardRestrictionIso`. -/
public def smallEtaleInclusionSheafPullbackRestrictionIso :
    (SmallEtale.inclusion B Y.obj Y.property).sheafPullback AddCommGrpCat.{u + 1}
        (SmallEtale.topology B Y.obj Y.property) (BigEtaleOver.topology B Y.obj Y.property) ⋙
      (Over.map f).sheafPushforwardContinuous AddCommGrpCat.{u + 1}
        (BigEtaleOver.topology B X.obj X.property) (BigEtaleOver.topology B Y.obj Y.property) ≅
    smallEtaleAbelianPullbackFunctor B f ⋙
      (SmallEtale.inclusion B X.obj X.property).sheafPullback AddCommGrpCat.{u + 1}
        (SmallEtale.topology B X.obj X.property) (BigEtaleOver.topology B X.obj X.property) :=
  let adj₁ := ((SmallEtale.inclusion B Y.obj Y.property).sheafAdjunctionContinuous
      AddCommGrpCat.{u + 1} (SmallEtale.topology B Y.obj Y.property)
      (BigEtaleOver.topology B Y.obj Y.property)).comp
    ((Over.map f).sheafAdjunctionCocontinuous AddCommGrpCat.{u + 1}
      (BigEtaleOver.topology B X.obj X.property) (BigEtaleOver.topology B Y.obj Y.property))
  let adj₂ := ((smallEtaleBaseChange B f).sheafAdjunctionContinuous AddCommGrpCat.{u + 1}
      (SmallEtale.topology B Y.obj Y.property) (SmallEtale.topology B X.obj X.property)).comp
    ((SmallEtale.inclusion B X.obj X.property).sheafAdjunctionContinuous AddCommGrpCat.{u + 1}
      (SmallEtale.topology B X.obj X.property) (BigEtaleOver.topology B X.obj X.property))
  adj₁.leftAdjointUniq (adj₂.ofNatIsoRight (bigSmallEtalePushforwardRestrictionIso B X Y f).symm)

variable {B f}

/-- **Stacks 0F0I, property (0EZ5).** Restriction along a morphism of the site carries the class
`𝒜'_Y` into `𝒜'_X`, for topologies on the two slices equal to the slice topologies: by
`smallEtaleInclusionSheafPullbackRestrictionIso` it carries `π_Y⁻¹F` to `π_X⁻¹(f⁻¹F)`, and the
inverse image of a torsion sheaf is torsion. -/
public theorem smallEtaleTorsionPullbackClass_restriction
    {JX : GrothendieckTopology (BigEtaleOver B X.obj X.property)}
    {JY : GrothendieckTopology (BigEtaleOver B Y.obj Y.property)}
    (hX : BigEtaleOver.topology B X.obj X.property = JX)
    (hY : BigEtaleOver.topology B Y.obj Y.property = JY)
    [(SmallEtale.inclusion B X.obj X.property).IsContinuous
      (SmallEtale.topology B X.obj X.property) JX]
    [(SmallEtale.inclusion B Y.obj Y.property).IsContinuous
      (SmallEtale.topology B Y.obj Y.property) JY]
    [HasSheafify JX AddCommGrpCat.{u + 1}] [HasSheafify JY AddCommGrpCat.{u + 1}]
    [(Over.map f).IsContinuous JX JY]
    (G : Sheaf JY AddCommGrpCat.{u + 1}) (hG : smallEtaleTorsionPullbackClass B Y JY G) :
    smallEtaleTorsionPullbackClass B X JX
      (((Over.map f).sheafPushforwardContinuous AddCommGrpCat.{u + 1} JX JY).obj G) := by
  subst hX hY
  obtain ⟨F, hF, ⟨e⟩⟩ := hG
  have : ∀ (S T : B.Scheme) (g : T ⟶ S),
      ((smallEtaleBaseChange B g).sheafPushforwardContinuous AddCommGrpCat.{u + 1}
        (SmallEtale.topology B S.obj S.property)
        (SmallEtale.topology B T.obj T.property)).IsRightAdjoint := fun _ _ g =>
    ((smallEtaleBaseChange B g).sheafAdjunctionContinuous AddCommGrpCat.{u + 1} _ _).isRightAdjoint
  exact ⟨(smallEtaleAbelianPullbackFunctor B f).obj F,
    torsionSheafProperty_smallEtaleAbelianPullback B f F hF,
    ⟨((smallEtaleInclusionSheafPullbackRestrictionIso B f).app F).symm ≪≫
      ((Over.map f).sheafPushforwardContinuous AddCommGrpCat.{u + 1} _ _).mapIso e⟩⟩

end Restriction

/-! ### Descent for a finer topology -/

section FineSheaf

variable (B : BigEtaleSite.{u}) (X : B.Scheme)

/-- The forgetful functor from abelian groups to types preserves filtered colimits indexed by
categories in `Type (u + 1)` with morphisms in `Type u`. -/
local instance : PreservesFilteredColimitsOfSize.{u, u + 1} (forget AddCommGrpCat.{u + 1}) :=
  preservesFilteredColimitsOfSize_of_univLE.{u + 1, u + 1, u, u + 1} _

/-- **Passing to underlying sheaves of sets commutes with `π_X⁻¹`** (Stacks 00YT for the
forgetful functor from abelian groups to sets, along the inclusion of the small étale site). The
right-hand side is the inverse image of sheaves of sets of the morphism of topoi
`AlgebraicGeometry.bigEtaleToSmallEtaleMorphism`. -/
public def smallEtaleInclusionSheafPullbackForgetIso
    (G : Sheaf (SmallEtale.topology B X.obj X.property) AddCommGrpCat.{u + 1}) :
    (sheafCompose (BigEtaleOver.topology B X.obj X.property)
        (forget AddCommGrpCat.{u + 1})).obj
      (((SmallEtale.inclusion B X.obj X.property).sheafPullback
        AddCommGrpCat.{u + 1} (SmallEtale.topology B X.obj X.property)
        (BigEtaleOver.topology B X.obj X.property)).obj G) ≅
      (bigEtaleToSmallEtaleMorphism B X.obj X.property).inverseImage.obj
        ((sheafCompose (SmallEtale.topology B X.obj X.property)
          (forget AddCommGrpCat.{u + 1})).obj G) := by
  let i := SmallEtale.inclusion B X.obj X.property
  haveI : RepresentablyFlat i := by
    have : HasPullbacks (SmallEtale B X.obj X.property) := inferInstance
    have hterm : IsTerminal (i.obj (SmallEtale.final B X.obj X.property)) := by
      simpa [i, SmallEtale.inclusion, SmallEtale.final] using
        (Over.mkIdTerminal : IsTerminal (Over.mk (𝟙 (B.obj X.obj X.property))))
    have : HasTerminal (SmallEtale B X.obj X.property) :=
      (SmallEtale.finalIsTerminal B X.obj X.property).hasTerminal
    have : HasFiniteLimits (SmallEtale B X.obj X.property) :=
      hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : PreservesLimitsOfShape (Discrete PEmpty.{1}) i :=
      Functor.preservesLimitsOfShape_pempty_of_isTerminal i
        (SmallEtale.finalIsTerminal B X.obj X.property) hterm
    have : PreservesFiniteLimits i := preservesFiniteLimits_of_preservesTerminal_and_pullbacks i
    exact flat_of_preservesFiniteLimits i
  haveI : ∀ Y : (BigEtaleOver B X.obj X.property)ᵒᵖ,
      PreservesColimitsOfShape (CostructuredArrow i.op Y) (forget AddCommGrpCat.{u + 1}) :=
    fun Y => by
      have : IsFiltered (CostructuredArrow i.op Y) :=
        IsFiltered.of_equivalence (structuredArrowOpEquivalence i Y.unop)
      exact PreservesFilteredColimitsOfSize.preserves_filtered_colimits _
  exact (i.sheafPullbackSheafComposeIso AddCommGrpCat.{u + 1}
      (SmallEtale.topology B X.obj X.property) (BigEtaleOver.topology B X.obj X.property)
      (forget AddCommGrpCat.{u + 1}) G).symm ≪≫
    ((i.sheafAdjunctionContinuous (Type (u + 1)) (SmallEtale.topology B X.obj X.property)
      (BigEtaleOver.topology B X.obj X.property)).leftAdjointUniq
        (bigEtaleToSmallEtaleMorphism B X.obj X.property).adj).app _

/-- **Descent of the class `𝒜'_X` for a finer topology, from descent of sheaves of sets.** Let
`J'` be a topology on the big étale slice over `X` for which `π_X⁻¹` of every sheaf of sets on
the small étale site is a sheaf. Then every abelian sheaf of the form `π_X⁻¹F`, for a topology `J`
on the slice equal to the slice topology, is a sheaf for `J'`: its underlying sheaf of sets is
`π_X⁻¹` of the underlying sheaf of sets of `F`, by
`smallEtaleInclusionSheafPullbackForgetIso`. -/
public theorem isSheaf_of_mem_smallEtaleTorsionPullbackClass
    (J' : GrothendieckTopology (BigEtaleOver B X.obj X.property))
    (hset : ∀ F : Sheaf (SmallEtale.topology B X.obj X.property) (Type (u + 1)),
      Presieve.IsSheaf J'
        ((bigEtaleToSmallEtaleMorphism B X.obj X.property).inverseImage.obj F).obj)
    {J : GrothendieckTopology (BigEtaleOver B X.obj X.property)}
    (hJ : BigEtaleOver.topology B X.obj X.property = J)
    [(SmallEtale.inclusion B X.obj X.property).IsContinuous
      (SmallEtale.topology B X.obj X.property) J]
    [HasSheafify J AddCommGrpCat.{u + 1}]
    (G : Sheaf J AddCommGrpCat.{u + 1}) (hG : smallEtaleTorsionPullbackClass B X J G) :
    Presheaf.IsSheaf J' G.obj := by
  subst hJ
  obtain ⟨F, -, ⟨e⟩⟩ := hG
  refine (Presheaf.isSheaf_of_iso_iff ((sheafToPresheaf _ _).mapIso e)).1 ?_
  rw [Presheaf.isSheaf_iff_isSheaf_forget (s := forget AddCommGrpCat.{u + 1}),
    isSheaf_iff_isSheaf_of_type]
  exact Presieve.isSheaf_iso _
    ((sheafToPresheaf _ _).mapIso (smallEtaleInclusionSheafPullbackForgetIso B X F)).symm
    (hset ((sheafCompose _ (forget AddCommGrpCat.{u + 1})).obj F))

end FineSheaf

/-! ### Higher direct images along proper morphisms -/

section DirectImage

variable (B : BigEtaleSite.{u})

/-- The category of abelian sheaves on the small étale site of `X` is Grothendieck abelian. -/
local instance (X : B.Scheme) :
    IsGrothendieckAbelian.{u + 1} (Sheaf (SmallEtale.topology B X.obj X.property) Ab.{u + 1}) :=
  smallEtaleSheaf_isGrothendieckAbelian B X

/-- The category of abelian sheaves on the big étale site over `X` is Grothendieck abelian. -/
local instance (X : B.Scheme) :
    IsGrothendieckAbelian.{u + 1} (Sheaf (BigEtaleOver.topology B X.obj X.property) Ab.{u + 1}) :=
  bigEtaleSheaf_isGrothendieckAbelian B X

/-- **The higher direct images of `π_X⁻¹F` along a proper morphism**, the input of Stacks 0F0I for
property (0EZ7): for a proper morphism `f : X ⟶ Y` of the site, a torsion abelian sheaf `F` on
`X_étale` and every `i`, `R^i f_{big,*}(π_X⁻¹F) ≅ π_Y⁻¹(R^i f_{small,*}F)` (Stacks 0DDJ (2) in
degree `i`). Here `f_{big,*}` is restriction along `Over.pullback f`, the direct image of the big
étale site.

It follows from the proper base change theorem: it is `H^i` at `F[0]` of the derived isomorphism
`AlgebraicGeometry.isIso_bigSmallEtaleDerivedBaseChange_app_of_cohomologyCommutesWithBaseChange`
of Stacks 0DDJ (2), granted Stacks 095T for `f`. -/
public abbrev ProperDirectImageComparison : Prop :=
  ∀ ⦃X Y : B.Scheme⦄ (f : X ⟶ Y), IsProper (B.inclusion.map f) →
    ∀ F : Sheaf (SmallEtale.topology B X.obj X.property) Ab.{u + 1},
      Stacks.Torsion.torsionSheafProperty.{u + 1} (SmallEtale.topology B X.obj X.property) F →
      ∀ i : ℕ,
          Nonempty ((((Over.pullback f).sheafPushforwardContinuous Ab.{u + 1}
              (BigEtaleOver.topology B Y.obj Y.property)
              (BigEtaleOver.topology B X.obj X.property)).rightDerived i).obj
                (((SmallEtale.inclusion B X.obj X.property).sheafPullback Ab.{u + 1}
                  (SmallEtale.topology B X.obj X.property)
                  (BigEtaleOver.topology B X.obj X.property)).obj F) ≅
            ((SmallEtale.inclusion B Y.obj Y.property).sheafPullback Ab.{u + 1}
                (SmallEtale.topology B Y.obj Y.property)
                (BigEtaleOver.topology B Y.obj Y.property)).obj
              (((B.smallPushforward f Ab.{u + 1}).rightDerived i).obj F))

variable {B}

/-- **Stacks 0DDJ (2) in degree `i`, for the direct image along the cocontinuous `Over.map f`**,
granted `ProperDirectImageComparison`: for topologies on the two slices equal to the slice
topologies, `R^i f_{big,*}(π_X⁻¹F) ≅ π_Y⁻¹(R^i f_{small,*}F)` for `f` proper and `F` torsion. The
direct image along `Over.map f` is restriction along `Over.pullback f`. -/
public theorem nonempty_rightDerived_overMap_sheafPullback_iso
    (hR : ProperDirectImageComparison B)
    {X Y : B.Scheme} (f : X ⟶ Y) (hf : IsProper (B.inclusion.map f))
    {JX : GrothendieckTopology (BigEtaleOver B X.obj X.property)}
    {JY : GrothendieckTopology (BigEtaleOver B Y.obj Y.property)}
    (hX : BigEtaleOver.topology B X.obj X.property = JX)
    (hY : BigEtaleOver.topology B Y.obj Y.property = JY)
    [(SmallEtale.inclusion B X.obj X.property).IsContinuous
      (SmallEtale.topology B X.obj X.property) JX]
    [(SmallEtale.inclusion B Y.obj Y.property).IsContinuous
      (SmallEtale.topology B Y.obj Y.property) JY]
    [HasSheafify JX Ab.{u + 1}] [HasSheafify JY Ab.{u + 1}]
    [(Over.map f).IsCocontinuous JX JY] [HasInjectiveResolutions (Sheaf JX Ab.{u + 1})]
    [((Over.map f).sheafPushforwardCocontinuous Ab.{u + 1} JX JY).Additive]
    (F : Sheaf (SmallEtale.topology B X.obj X.property) Ab.{u + 1})
    (hF : Stacks.Torsion.torsionSheafProperty.{u + 1} (SmallEtale.topology B X.obj X.property) F)
    (i : ℕ) :
    Nonempty ((((Over.map f).sheafPushforwardCocontinuous Ab.{u + 1} JX JY).rightDerived i).obj
        (((SmallEtale.inclusion B X.obj X.property).sheafPullback Ab.{u + 1}
          (SmallEtale.topology B X.obj X.property) JX).obj F) ≅
      ((SmallEtale.inclusion B Y.obj Y.property).sheafPullback Ab.{u + 1}
          (SmallEtale.topology B Y.obj Y.property) JY).obj
        (((B.smallPushforward f Ab.{u + 1}).rightDerived i).obj F)) := by
  subst hX hY
  obtain ⟨e'⟩ := hR f hf F hF i
  exact ⟨(Functor.rightDerivedIsoOfNatIso
    ((Over.mapPullbackAdj f).sheafPushforwardCocontinuousIso Ab.{u + 1}) i).app _ ≪≫ e'⟩

/-- **Stacks 0F0I, property (0EZ7)**, granted `ProperDirectImageComparison` (Stacks 0DDJ (2)).
The higher direct images along a proper morphism of an abelian sheaf of the class `𝒜'_X` lie in
`𝒜'_Y`, for topologies on the two slices equal to the slice topologies: this is
`nonempty_rightDerived_overMap_sheafPullback_iso` together with the torsion of
`R^i f_{small,*}F` (Stacks 0DDD (1),
`AlgebraicGeometry.SmallEtale.torsionSheafProperty_rightDerived_smallPushforward`). -/
public theorem smallEtaleTorsionPullbackClass_rightDerived (hR : ProperDirectImageComparison B)
    {X Y : B.Scheme} (f : X ⟶ Y) (hf : IsProper (B.inclusion.map f))
    {JX : GrothendieckTopology (BigEtaleOver B X.obj X.property)}
    {JY : GrothendieckTopology (BigEtaleOver B Y.obj Y.property)}
    (hX : BigEtaleOver.topology B X.obj X.property = JX)
    (hY : BigEtaleOver.topology B Y.obj Y.property = JY)
    [(SmallEtale.inclusion B X.obj X.property).IsContinuous
      (SmallEtale.topology B X.obj X.property) JX]
    [(SmallEtale.inclusion B Y.obj Y.property).IsContinuous
      (SmallEtale.topology B Y.obj Y.property) JY]
    [HasSheafify JX Ab.{u + 1}] [HasSheafify JY Ab.{u + 1}]
    [(Over.map f).IsCocontinuous JX JY] [HasInjectiveResolutions (Sheaf JX Ab.{u + 1})]
    [((Over.map f).sheafPushforwardCocontinuous Ab.{u + 1} JX JY).Additive]
    (G : Sheaf JX Ab.{u + 1}) (hG : smallEtaleTorsionPullbackClass B X JX G) (i : ℕ) :
    smallEtaleTorsionPullbackClass B Y JY
      ((((Over.map f).sheafPushforwardCocontinuous Ab.{u + 1} JX JY).rightDerived i).obj G) := by
  obtain ⟨F, hF, ⟨e⟩⟩ := hG
  obtain ⟨e'⟩ := nonempty_rightDerived_overMap_sheafPullback_iso hR f hf hX hY F hF i
  have htors : Stacks.Torsion.torsionSheafProperty.{u + 1} (SmallEtale.topology B Y.obj Y.property)
      (((B.smallPushforward f Ab.{u + 1}).rightDerived i).obj F) := by
    have : IsProper (B.inclusion.map f) := hf
    exact SmallEtale.torsionSheafProperty_rightDerived_smallPushforward f i F hF
  exact ⟨_, htors, ⟨e'.symm ≪≫
    (((Over.map f).sheafPushforwardCocontinuous Ab.{u + 1} _ _).rightDerived i).mapIso e⟩⟩

end DirectImage

/-! ### The comparison situation -/

section Situation

/-- The inclusion of the small étale site of `X` into the big étale site over `X` is continuous
for the localization at `X` of the topology of the site. -/
public instance smallEtaleInclusion_isContinuous_over (E : BigEtaleSite.{u}) (X : E.Scheme) :
    (SmallEtale.inclusion E X.obj X.property).IsContinuous
      (SmallEtale.topology E X.obj X.property) (E.topology.over X) :=
  smallEtaleInclusion_isContinuous_of_eq E X (bigEtaleOver_topology_eq_of_obj E X)

/-- `π_X⁻¹`, into the localization at `X` of the topology of the site, preserves finite limits. -/
public instance smallEtaleInclusion_sheafPullback_over_preservesFiniteLimits (E : BigEtaleSite.{u})
    (X : E.Scheme) :
    PreservesFiniteLimits ((SmallEtale.inclusion E X.obj X.property).sheafPullback Ab.{u + 1}
      (SmallEtale.topology E X.obj X.property) (E.topology.over X)) :=
  (smallEtaleInclusion_sheafPullback_exact E X (bigEtaleOver_topology_eq_of_obj E X)).1

/-- `π_X⁻¹`, into the localization at `X` of the topology of the site, preserves finite
colimits. -/
public instance smallEtaleInclusion_sheafPullback_over_preservesFiniteColimits
    (E : BigEtaleSite.{u}) (X : E.Scheme) :
    PreservesFiniteColimits ((SmallEtale.inclusion E X.obj X.property).sheafPullback Ab.{u + 1}
      (SmallEtale.topology E X.obj X.property) (E.topology.over X)) :=
  (smallEtaleInclusion_sheafPullback_exact E X (bigEtaleOver_topology_eq_of_obj E X)).2

/-- `π_X⁻¹`, into the localization at `X` of the topology of the site, is additive. -/
public instance smallEtaleInclusion_sheafPullback_over_additive (E : BigEtaleSite.{u})
    (X : E.Scheme) :
    ((SmallEtale.inclusion E X.obj X.property).sheafPullback Ab.{u + 1}
      (SmallEtale.topology E X.obj X.property) (E.topology.over X)).Additive :=
  Functor.additive_of_preserves_binary_products _

/-- `π_{X,*}`, from the localization at `X` of the topology of the site, preserves finite
limits. -/
public instance smallEtaleInclusion_sheafPushforward_over_preservesFiniteLimits
    (E : BigEtaleSite.{u}) (X : E.Scheme) :
    PreservesFiniteLimits ((SmallEtale.inclusion E X.obj X.property).sheafPushforwardContinuous
      Ab.{u + 1} (SmallEtale.topology E X.obj X.property) (E.topology.over X)) :=
  (smallEtaleInclusion_sheafPushforward_exact E X (bigEtaleOver_topology_eq_of_obj E X)).1

/-- `π_{X,*}`, from the localization at `X` of the topology of the site, preserves finite
colimits. -/
public instance smallEtaleInclusion_sheafPushforward_over_preservesFiniteColimits
    (E : BigEtaleSite.{u}) (X : E.Scheme) :
    PreservesFiniteColimits ((SmallEtale.inclusion E X.obj X.property).sheafPushforwardContinuous
      Ab.{u + 1} (SmallEtale.topology E X.obj X.property) (E.topology.over X)) :=
  (smallEtaleInclusion_sheafPushforward_exact E X (bigEtaleOver_topology_eq_of_obj E X)).2

/-- `π_{X,*}`, from the localization at `X` of the topology of the site, is additive. -/
public instance smallEtaleInclusion_sheafPushforward_over_additive (E : BigEtaleSite.{u})
    (X : E.Scheme) :
    ((SmallEtale.inclusion E X.obj X.property).sheafPushforwardContinuous Ab.{u + 1}
      (SmallEtale.topology E X.obj X.property) (E.topology.over X)).Additive :=
  Functor.additive_of_preserves_binary_products _

/-- **The comparison situation of Stacks 0EZ3 for a topology finer than the étale topology, with
the proper morphisms as distinguished class and the sheaves pulled back from torsion sheaves on
the small étale sites as the classes `𝒜'_X`.**

Let `E` be a big étale site and `K` a precoverage on its underlying category satisfying the site
axioms, finer than the étale one (`hle`). The coarser topology is the étale topology of `E`, the
distinguished class is the class of proper morphisms, and `𝒜'_X` is
`AlgebraicGeometry.smallEtaleTorsionPullbackClass`. Of the conditions of Stacks 0EZ3 the following
are proved here: `𝒜'_X` is a weak Serre class (Stacks 0DDI, 0DD7), proper morphisms are stable
under base change and the base change exists (property 0EZ4), restriction preserves the classes
`𝒜'` (property 0EZ5, Stacks 021I). The remaining three are the arguments, which depend on `K`:

* `hsheaf`, the sheaf condition for `K` of `π_X⁻¹` of every sheaf of sets on `X_étale`, from which
  property 0EZ6 is deduced for abelian sheaves;
* `hR`, the comparison of higher direct images along proper morphisms, from which property 0EZ7
  is deduced;
* `hrefine`, property 0EZ8 for `K`. -/
public def properEtaleCohomologyComparison (E : BigEtaleSite.{u}) (K : Precoverage E.Scheme)
    [K.HasIsos] [K.IsStableUnderComposition] [K.HasPullbacks] [K.IsStableUnderBaseChange]
    (hle : E.precoverage ≤ K)
    (hsheaf : ∀ (X : E.Scheme) (F : Sheaf (SmallEtale.topology E X.obj X.property) (Type (u + 1))),
      Presieve.IsSheaf (K.toGrothendieck.over X)
        ((bigEtaleToSmallEtaleMorphism E X.obj X.property).inverseImage.obj F).obj)
    (hR : ProperDirectImageComparison E)
    (hrefine : ∀ (U : E.Scheme) (R : Presieve U), R ∈ K U →
      ∃ S : Presieve U, S ∈ E.precoverage U ∧
        ∀ ⦃V : E.Scheme⦄ (v : V ⟶ U), S v →
          ∃ (W : E.Scheme) (f : W ⟶ V), IsProper (E.inclusion.map f) ∧
            Presieve.singleton f ∈ K V ∧
            ∃ T : Presieve W, T ∈ E.precoverage W ∧ T.FactorsThruAlong R (f ≫ v)) :
    Stacks.ComparingTopologies.CohomologyComparison E.Scheme where
  fineCoverage := K
  fine_hasIsos := inferInstance
  fine_stableUnderComposition := inferInstance
  fine_hasPullbacks := inferInstance
  fine_stableUnderBaseChange := inferInstance
  coarseCoverage := E.precoverage
  coarse_hasIsos := inferInstance
  coarse_stableUnderComposition := inferInstance
  coarse_hasPullbacks := inferInstance
  coarse_stableUnderBaseChange := inferInstance
  coarse_le_fine := hle
  morphismProperty := fun _ _ f => IsProper (E.inclusion.map f)
  weakSerre X := smallEtaleTorsionPullbackClass E X (E.topology.over X)
  weakSerreClass X :=
    smallEtaleTorsionPullbackClass_isWeakSerreClass (bigEtaleOver_topology_eq_of_obj E X)
  morphismProperty_baseChange := fun _ _ _ f hf g =>
    ⟨pullback f g, pullback.fst f g, pullback.snd f g, IsPullback.of_hasPullback f g,
      MorphismProperty.of_isPullback ((IsPullback.of_hasPullback f g).map E.inclusion) hf⟩
  weakSerre_relocalizationInverseImage := fun X Y _ G hG =>
    smallEtaleTorsionPullbackClass_restriction (bigEtaleOver_topology_eq_of_obj E X)
      (bigEtaleOver_topology_eq_of_obj E Y) G hG
  weakSerre_isSheaf_fine := fun X G hG =>
    isSheaf_of_mem_smallEtaleTorsionPullbackClass E X _ (hsheaf X)
      (bigEtaleOver_topology_eq_of_obj E X) G hG
  weakSerre_rightDerived_relocalizationPushforward := fun X Y f hf G hG i =>
    smallEtaleTorsionPullbackClass_rightDerived hR f hf (bigEtaleOver_topology_eq_of_obj E X)
      (bigEtaleOver_topology_eq_of_obj E Y) G hG i
  covering_refinement := hrefine

end Situation

end AlgebraicGeometry

