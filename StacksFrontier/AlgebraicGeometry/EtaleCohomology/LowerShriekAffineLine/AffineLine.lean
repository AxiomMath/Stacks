/-!
# The derived lower shriek along the affine line

Let `Y` be an affine scheme, `f : 𝔸¹_Y ⟶ Y` the structure morphism and `ℱ` a constructible sheaf of
`Λ`-modules on `𝔸¹_Y` killed by an integer `n > 0` invertible on `Y`. Granted Tags 095T, 0GKV and
095U as hypotheses (Tag 0GKV only at primes invertible on the base), `Rf_! ℱ` has constructible
cohomology sheaves: the case of Tag 0GKZ where the torsion order is invertible on `Y`. The full
Tag 0GKZ, with no such condition and no hypotheses, is
`Stacks.EtaleCohomology.isConstructibleEtaleModule_homology_derivedLowerShriek_affineLine`.

## Main results

* `isConstructibleEtaleComplex_derivedLowerShriekUnbounded_affineLine_of_isNoetherian_of_isUnit`:
  Tag 0GKZ over a Noetherian base.
* `exists_isConstructibleEtaleModule_etaleModuleInverseImage_affineLine_iso_of_isUnit`: a
  constructible sheaf on `𝔸¹_Y` is the inverse image of one on `𝔸¹_{Y₀}` for a Noetherian affine
  `Y₀` on which `n` is still invertible.
* `isConstructibleEtaleComplex_derivedLowerShriekUnbounded_affineLine_of_isUnit`: Tag 0GKZ when
  the torsion order is invertible on `Y`.

## References

* [Stacks Project, Tag 0GKZ](https://stacks.math.columbia.edu/tag/0GKZ)
* [Stacks Project, Tag 09YU](https://stacks.math.columbia.edu/tag/09YU)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry AlgebraicGeometry.Scheme

attribute [local instance] HasDerivedCategory.standard
attribute [local instance high] Stacks.ConstantSheaf.hasSheafify_moduleCat_of_univLE
attribute [local instance 2000] Sheaf.instHasColimitsOfShape Sheaf.instHasFiniteCoproducts

universe u


namespace Stacks.EtaleCohomology

variable (Λ : Type (u + 1)) [CommRing Λ] [IsNoetherianRing Λ]

/-- Multiplication by `n` on the identities commutes with every morphism. -/
private theorem nsmul_id_comp_eq_comp_nsmul_id {C : Type*} [Category C] [Preadditive C] {X Y : C}
    (f : X ⟶ Y) (n : ℕ) : (n • 𝟙 X) ≫ f = f ≫ (n • 𝟙 Y) := by
  rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]

/-- The structure morphism `𝔸¹_Y ⟶ Y` of an affine scheme `Y` is smooth of relative dimension
`1`. -/
instance smoothOfRelativeDimension_affineLine (Y : Scheme.{u}) [IsAffine Y] :
    SmoothOfRelativeDimension 1 (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) :=
  smoothOfRelativeDimension_affineSpace_over Y 1

/-- **Tag 0GKZ over a Noetherian base**, granted Tags 095T, 0GKV and 095U: for `Y` Noetherian
affine and `ℱ` a constructible sheaf of `Λ`-modules on `𝔸¹_Y` killed by an integer `n > 0`
invertible on `Y`, `R(𝔸¹_Y ⟶ Y)_!(ℱ[0])` has constructible cohomology sheaves, for every
compactification. -/
theorem isConstructibleEtaleComplex_derivedLowerShriekUnbounded_affineLine_of_isNoetherian_of_isUnit
    (h095T : ∀ ⦃S T : Scheme.{u}⦄ (p : S ⟶ T) [IsProper p],
      CohomologyCommutesWithBaseChange.{u, u + 1} p)
    (h0GKV : ∀ {X S : Scheme.{u}} (f : X ⟶ S) [IsProper f] [Smooth f] [GeometricallyConnected f],
      (∀ s : S, topologicalKrullDim (f.fiber s) ≤ ((1 : ℕ) : WithBot ℕ∞)) →
      ∀ (ℓ : ℕ) [Fact ℓ.Prime], IsUnit ((ℓ : ℕ) : Γ(S, ⊤)) → ∀ (q : ℤ),
        Stacks.EtaleCohomology.IsConstructibleEtaleModule (ZMod ℓ)
          ((DerivedCategory.homologyFunctor
              (Stacks.EtaleCohomology.EtaleModules.{u, 0} (ZMod ℓ) S) q).obj
            ((Stacks.EtaleCohomology.etaleModuleDerivedDirectImageUnbounded.{u, 0} (ZMod ℓ) f).obj
              ((DerivedCategory.singleFunctor
                  (Stacks.EtaleCohomology.EtaleModules.{u, 0} (ZMod ℓ) X) 0).obj
                ((constantSheaf X.smallEtaleTopology (ModuleCat.{u + 1} (ZMod ℓ))).obj
                  (ModuleCat.of (ZMod ℓ) (ULift.{u + 1} (ZMod ℓ))))))))
    (h095U : ∀ ⦃S T : Scheme.{u}⦄ (p : S ⟶ T) [IsProper p] (N : ℕ),
      (∀ t : T, topologicalKrullDim (p.fiber t) ≤ N) →
        ∀ F : Sheaf S.smallEtaleTopology AddCommGrpCat.{u + 1},
          Stacks.Torsion.torsionSheafProperty S.smallEtaleTopology F → ∀ q : ℕ, 2 * N < q →
            IsZero (((etaleAbelianDirectImage.{u, u + 1} p).rightDerived q).obj F))
    (Y : Scheme.{u}) [IsAffine Y] [IsNoetherian Y]
    (j : CompactificationOf (Over.mk (𝔸(ULift.{u} (Fin 1); Y) ↘ Y)))
    (F : EtaleModules.{u, u + 1} Λ 𝔸(ULift.{u} (Fin 1); Y)) (hF : IsConstructibleEtaleModule Λ F)
    {n : ℕ} (hn0 : 0 < n) (hn : n • 𝟙 F = 0) (hnY : IsUnit ((n : ℕ) : Γ(Y, ⊤))) :
    IsConstructibleEtaleComplex Λ
      ((derivedLowerShriekUnbounded.{u, u + 1} (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) j Λ).obj
        ((DerivedCategory.singleFunctor (EtaleModules.{u, u + 1} Λ 𝔸(ULift.{u} (Fin 1); Y)) 0).obj
          F)) :=
  isConstructibleEtaleComplex_derivedLowerShriekUnbounded_of_smoothOfRelativeDimension_one_of_isUnit
    Λ h095T h0GKV h095U _ j F hF hn0 hn hnY

/-- **Spreading out with an integer kept invertible.** A constructible sheaf of `Λ`-modules on
`𝔸¹_Y`, `Y` affine, is the inverse image of a constructible sheaf on `𝔸¹_{Y₀}` for a Noetherian
affine `Y₀` under `Y`, and if `n` is invertible on `Y`, then `Y₀` can be chosen with `n` invertible
on it. -/
theorem exists_isConstructibleEtaleModule_etaleModuleInverseImage_affineLine_iso_of_isUnit
    (Y : Scheme.{u}) [IsAffine Y] (F : EtaleModules.{u, u + 1} Λ 𝔸(ULift.{u} (Fin 1); Y))
    (hF : IsConstructibleEtaleModule Λ F) {n : ℕ} (hnY : IsUnit ((n : ℕ) : Γ(Y, ⊤))) :
    ∃ (Y₀ : Scheme.{u}) (_ : IsAffine Y₀) (_ : IsNoetherian Y₀) (g : Y ⟶ Y₀)
      (F₀ : EtaleModules.{u, u + 1} Λ 𝔸(ULift.{u} (Fin 1); Y₀)), IsConstructibleEtaleModule Λ F₀ ∧
        Nonempty ((etaleModuleInverseImage.{u, u + 1} Λ
          (AffineSpace.map (ULift.{u} (Fin 1)) g)).obj F₀ ≅ F) ∧
        IsUnit ((n : ℕ) : Γ(Y₀, ⊤)) := by
  obtain ⟨Y₀, _, _, g, F₀, hF₀, ⟨e⟩⟩ :=
    exists_isConstructibleEtaleModule_etaleModuleInverseImage_affineLine_iso Λ Y F hF
  let D : Y₀.Opens := Y₀.basicOpen ((n : ℕ) : Γ(Y₀, ⊤))
  have : IsAffine D := (isAffineOpen_top Y₀).basicOpen _
  have : IsNoetherian D := ⟨⟩
  have hgD : Set.range g.base ⊆ Set.range D.ι.base := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨y, rfl⟩
    have h1 : g ⁻¹ᵁ D = ⊤ := by
      rw [Scheme.preimage_basicOpen_top, map_natCast]
      exact Scheme.basicOpen_of_isUnit _ hnY
    exact (h1 ▸ trivial : y ∈ g ⁻¹ᵁ D)
  let g' := IsOpenImmersion.lift D.ι g hgD
  refine ⟨D, inferInstance, inferInstance, g',
    (etaleModuleInverseImage.{u, u + 1} Λ (AffineSpace.map (ULift.{u} (Fin 1)) D.ι)).obj F₀,
    isConstructibleEtaleModule_etaleModuleInverseImage Λ _ _ hF₀, ⟨?_⟩, ?_⟩
  · exact ((etaleModuleInverseImageCompIso' Λ (AffineSpace.map (ULift.{u} (Fin 1)) g')
      (AffineSpace.map (ULift.{u} (Fin 1)) D.ι) (AffineSpace.map (ULift.{u} (Fin 1)) g)
      (by rw [← AffineSpace.map_comp, IsOpenImmersion.lift_fac])).app F₀).symm ≪≫ e
  · have h1 := Y₀.toRingedSpace.isUnit_res_basicOpen ((n : ℕ) : Γ(Y₀, ⊤))
    rw [map_natCast] at h1
    rw [← map_natCast D.topIso.inv.hom n]
    exact h1.map _

/-- **The case of Stacks Project, Tag 0GKZ where the torsion order is invertible on `Y`**, granted
Tags 095T, 0GKV and 095U. Let `Y` be an affine scheme,
`Λ` a Noetherian ring and `ℱ` a constructible sheaf of `Λ`-modules on `𝔸¹_Y` killed by an integer
`n > 0` invertible on `Y`. Then `Rf_! ℱ` has constructible cohomology sheaves, where `f : 𝔸¹_Y ⟶ Y`
is the structure morphism and `Rf_!` is computed through any compactification `j` of `f`.

The hypotheses `h095T`, `h0GKV` and `h095U` are Stacks Tags 095T, 0GKV and 095U. The full Tag 0GKZ,
with no invertibility condition and no hypotheses, is
`Stacks.EtaleCohomology.isConstructibleEtaleModule_homology_derivedLowerShriek_affineLine`. -/
theorem isConstructibleEtaleComplex_derivedLowerShriekUnbounded_affineLine_of_isUnit
    (h095T : ∀ ⦃S T : Scheme.{u}⦄ (p : S ⟶ T) [IsProper p],
      CohomologyCommutesWithBaseChange.{u, u + 1} p)
    (h0GKV : ∀ {X S : Scheme.{u}} (f : X ⟶ S) [IsProper f] [Smooth f] [GeometricallyConnected f],
      (∀ s : S, topologicalKrullDim (f.fiber s) ≤ ((1 : ℕ) : WithBot ℕ∞)) →
      ∀ (ℓ : ℕ) [Fact ℓ.Prime], IsUnit ((ℓ : ℕ) : Γ(S, ⊤)) → ∀ (q : ℤ),
        Stacks.EtaleCohomology.IsConstructibleEtaleModule (ZMod ℓ)
          ((DerivedCategory.homologyFunctor
              (Stacks.EtaleCohomology.EtaleModules.{u, 0} (ZMod ℓ) S) q).obj
            ((Stacks.EtaleCohomology.etaleModuleDerivedDirectImageUnbounded.{u, 0} (ZMod ℓ) f).obj
              ((DerivedCategory.singleFunctor
                  (Stacks.EtaleCohomology.EtaleModules.{u, 0} (ZMod ℓ) X) 0).obj
                ((constantSheaf X.smallEtaleTopology (ModuleCat.{u + 1} (ZMod ℓ))).obj
                  (ModuleCat.of (ZMod ℓ) (ULift.{u + 1} (ZMod ℓ))))))))
    (h095U : ∀ ⦃S T : Scheme.{u}⦄ (p : S ⟶ T) [IsProper p] (N : ℕ),
      (∀ t : T, topologicalKrullDim (p.fiber t) ≤ N) →
        ∀ F : Sheaf S.smallEtaleTopology AddCommGrpCat.{u + 1},
          Stacks.Torsion.torsionSheafProperty S.smallEtaleTopology F → ∀ q : ℕ, 2 * N < q →
            IsZero (((etaleAbelianDirectImage.{u, u + 1} p).rightDerived q).obj F)) :
    ∀ (Y : Scheme.{u}) [IsAffine Y]
      (j : CompactificationOf (Over.mk (𝔸(ULift.{u} (Fin 1); Y) ↘ Y)))
      (F : EtaleModules.{u, u + 1} Λ 𝔸(ULift.{u} (Fin 1); Y)),
      IsConstructibleEtaleModule Λ F → ∀ {n : ℕ}, 0 < n → n • 𝟙 F = 0 →
      IsUnit ((n : ℕ) : Γ(Y, ⊤)) →
      IsConstructibleEtaleComplex Λ
        ((derivedLowerShriekUnbounded.{u, u + 1} (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) j Λ).obj
          ((DerivedCategory.singleFunctor (EtaleModules.{u, u + 1} Λ 𝔸(ULift.{u} (Fin 1); Y)) 0).obj
            F)) := by
  intro Y _ j F hF n hn0 hn hnY
  have hFt := isTorsionEtaleModule_of_nsmul_id_eq_zero Λ hn0 hn
  obtain ⟨Y₀, _, _, g, F₀, hF₀, ⟨e⟩, hnY₀⟩ :=
    exists_isConstructibleEtaleModule_etaleModuleInverseImage_affineLine_iso_of_isUnit Λ Y F hF hnY
  let φ := AffineSpace.map (ULift.{u} (Fin 1)) g
  let F₀' := cokernel (n • 𝟙 F₀)
  have hF₀' : IsConstructibleEtaleModule Λ F₀' :=
    (IsConstructibleEtaleModule Λ).prop_cokernel _ hF₀ hF₀
  have hF₀'n : n • 𝟙 F₀' = 0 := by
    rw [← cancel_epi (cokernel.π (n • 𝟙 F₀)), comp_zero, ← nsmul_id_comp_eq_comp_nsmul_id,
      cokernel.condition]
  let e' : (etaleModuleInverseImage.{u, u + 1} Λ φ).obj F₀' ≅ F :=
    PreservesCokernel.iso (etaleModuleInverseImage.{u, u + 1} Λ φ) (n • 𝟙 F₀) ≪≫
      cokernelIsoOfEq (by rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]) ≪≫
      cokernel.mapIso (n • 𝟙 _) (n • 𝟙 F) e e 
        (nsmul_id_comp_eq_comp_nsmul_id _ _) ≪≫
      cokernelIsoOfEq hn ≪≫ cokernelZeroIsoTarget
  have : IsNoetherian 𝔸(ULift.{u} (Fin 1); Y₀) :=
    isNoetherian_of_locallyOfFiniteType (𝔸(ULift.{u} (Fin 1); Y₀) ↘ Y₀)
  have : 𝔸(ULift.{u} (Fin 1); Y₀).IsQuasiAffine := inferInstance
  obtain ⟨j₀, -⟩ := exists_quasiCompact_compactificationOf_of_isQuasiAffine
    (𝔸(ULift.{u} (Fin 1); Y₀) ↘ Y₀)
  have h₀ :=
    isConstructibleEtaleComplex_derivedLowerShriekUnbounded_affineLine_of_isNoetherian_of_isUnit Λ
      h095T h0GKV h095U Y₀ j₀ F₀' hF₀' hn0 hF₀'n hnY₀
  have h₁ := isConstructibleEtaleComplex_etaleModuleDerivedInverseImage Λ g _ h₀
  let sq := AffineSpace.isPullback_map (n := ULift.{u} (Fin 1)) g
  let S₀ :=
    (DerivedCategory.singleFunctor (EtaleModules.{u, u + 1} Λ 𝔸(ULift.{u} (Fin 1); Y₀)) 0).obj F₀'
  have := isIso_derivedLowerShriekBaseChange_app_of_proper_base_change.{u, u + 1} Λ sq j₀ h095T S₀
    0 (torsionCohomologyProperty_etaleModuleForgetDerived_single Λ _
      (isTorsionEtaleModule_of_nsmul_id_eq_zero Λ hn0 hF₀'n))
  refine isConstructibleEtaleComplex_of_iso Λ
    (asIso ((derivedLowerShriekBaseChangeGeneral.{u, u + 1} Λ sq j₀).app S₀) ≪≫
      (derivedLowerShriekUnbounded.{u, u + 1} _ (j₀.baseChange sq) Λ).mapIso
        (((etaleModuleInverseImage.{u, u + 1} Λ φ).mapDerivedCategorySingleFunctor 0).app F₀' ≪≫
          (DerivedCategory.singleFunctor _ 0).mapIso e') ≪≫
      derivedLowerShriekUnboundedCompactificationIsoUnconditional.{u, u + 1} Λ (j₀.baseChange sq) j
        h095T _ 0 (torsionCohomologyProperty_etaleModuleForgetDerived_single Λ F hFt)) h₁

end Stacks.EtaleCohomology

