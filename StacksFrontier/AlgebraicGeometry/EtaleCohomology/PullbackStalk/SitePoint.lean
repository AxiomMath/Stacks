module

public import Mathlib.CategoryTheory.Sites.Point.Basic
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GeometricPointFiber
public import StacksFrontier.AlgebraicGeometry.Size.FiniteType

/-!
# A geometric point as a point of the small étale site

Let `B` be a big étale site containing a scheme `S`, and let `s` be a geometric point of `S`.
The sets of lifts of `s` to the objects of the small étale site of `S` form the functor
`AlgebraicGeometry.geometricPointFiber`. This file verifies the remaining axiom of a point of
a site for that functor — every lift of `s` to an object `X` comes from a lift to some member
of any covering sieve of `X` — and packages the result as a
`CategoryTheory.GrothendieckTopology.Point` of the small étale topology.

Surjectivity is checked on the generators of the topology. For a chosen étale covering
`{X_i → X}` the point `s` lands in the image of one of the `X_i` on underlying spaces, and
since `X_i → X` is étale and the source of `s` is the spectrum of a separably closed field,
the point lifts. The induction over the sieves generated by the precoverage then uses that
the category of pointed étale neighborhoods is cofiltered to combine two lifts.

## Main results

* `AlgebraicGeometry.geometricPointFiber_jointly_surjective` — covering sieves act jointly
  surjectively on the lifts of a geometric point.
* `AlgebraicGeometry.geometricPointSitePoint` — a geometric point of `S` as a point of the
  small étale site of `S`. This is the first assertion of Tag 04FM.
* `AlgebraicGeometry.etaleStalk_eq_presheafFiber` — the stalk of Tag 040R is the fiber of that
  point, which is how the general theory of points of a site applies to it. This is the final
  assertion of Tag 04FM.

## References

* [Stacks Project, Tag 040R](https://stacks.math.columbia.edu/tag/040R)
* [Stacks Project, Tag 04FM](https://stacks.math.columbia.edu/tag/04FM)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u v w

namespace AlgebraicGeometry

variable (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) (s : GeometricPoint S)

-- The cofilteredness of the category of étale neighbourhoods of a geometric point, and the
-- affine refinement it rests on, come from `EtaleCohomology.GeometricPointFiber`, which this
-- module imports; they are not restated here.

/-- A lift of a geometric point to an object `X` of the small étale site is the image of a lift
to some member of a generating étale family of `X`. -/
public theorem geometricPointFiber_exists_lift_of_mem_precoverage
    {X : SmallEtale B S hS} {P : Presieve X} (hP : P ∈ SmallEtale.precoverage B S hS X)
    (x : (geometricPointFiber B S hS s).obj X) :
    ∃ (Y : SmallEtale B S hS) (f : Y ⟶ X) (_ : Sieve.generate P f)
      (y : (geometricPointFiber B S hS s).obj Y),
      (geometricPointFiber B S hS s).map f y = x := by
  rcases (SmallEtale.mem_precoverage_iff (B := B) (S := S) (hS := hS)).mp hP
    with ⟨E, hEP, hE⟩
  let u := SmallEtale.inclusion B S hS ⋙ Over.forget (B.obj S hS)
  have hB : B.IsCovering ⟨u.obj X, E.map u⟩ := hE
  have hEt :
      (PreZeroHypercover.map (schemeBelowInclusion B.cutoff)
        (PreZeroHypercover.map u E)).presieve₀ ∈
        Scheme.etalePrecoverage
          ((schemeBelowInclusion B.cutoff).obj (u.obj X)) :=
    BigEtaleSite.IsCovering.etale hB
  have hcov := (Scheme.ofArrows_mem_precoverage_iff (P := @Etale)).mp hEt
  obtain ⟨i, y, hy⟩ := hcov.1 (x.1 default)
  change E.I₀ at i
  change (SmallEtale.toScheme B S hS).obj (E.X i) at y
  change ((SmallEtale.toScheme B S hS).map (E.f i)) y = x.1 default at hy
  have hfi : Etale ((SmallEtale.toScheme B S hS).map (E.f i)) := hcov.2 i
  obtain ⟨l, hl, _⟩ := Scheme.exists_fac_of_etale_of_isSepClosed
    ((SmallEtale.toScheme B S hS).map (E.f i)) x.1 y hy
  refine ⟨E.X i, E.f i, ?_,
    (⟨l, ?_⟩ : (geometricPointFiber B S hS s).obj (E.X i)), ?_⟩
  · rw [hEP]
    exact Sieve.le_generate _ _ _ (E.presieve₀_f i)
  · have hOver := Over.w ((SmallEtale.inclusion B S hS).map (E.f i))
    change ((SmallEtale.inclusion B S hS).map (E.f i)).left ≫ X.obj.hom =
      (E.X i).obj.hom at hOver
    have hw : (SmallEtale.toScheme B S hS).map (E.f i) ≫
        B.inclusion.map X.obj.hom = B.inclusion.map (E.X i).obj.hom := by
      show B.inclusion.map _ ≫ B.inclusion.map _ = _
      rw [← Functor.map_comp]
      exact congrArg B.inclusion.map hOver
    show l ≫ B.inclusion.map (E.X i).obj.hom = s.hom
    rw [← hw, ← Category.assoc, hl]
    exact x.2
  · exact Subtype.ext hl

/-- Every lift of a geometric point to an object `X` of the small étale site is the image of
a lift to some member of a given covering sieve of `X`. -/
public theorem geometricPointFiber_jointly_surjective
    {X : SmallEtale B S hS} (R : Sieve X) (hR : R ∈ SmallEtale.topology B S hS X)
    (x : (geometricPointFiber B S hS s).obj X) :
    ∃ (Y : SmallEtale B S hS) (f : Y ⟶ X) (_ : R f)
      (y : (geometricPointFiber B S hS s).obj Y),
      (geometricPointFiber B S hS s).map f y = x := by
  have hSat := (CategoryTheory.Precoverage.mem_toGrothendieck_iff
    (J := SmallEtale.precoverage B S hS)).mp hR
  clear hR
  induction hSat with
  | of X P hP =>
      exact geometricPointFiber_exists_lift_of_mem_precoverage B S hS s hP x
  | top X =>
      exact ⟨X, 𝟙 X, by simp, x, by simp⟩
  | pullback X R hSat Y f ih =>
      obtain ⟨Z, g, hg, z, hz⟩ := ih ((geometricPointFiber B S hS s).map f x)
      let z' := Functor.elementsMk (geometricPointFiber B S hS s) Z z
      let y' := Functor.elementsMk (geometricPointFiber B S hS s) Y x
      let t' := Functor.elementsMk (geometricPointFiber B S hS s) X
        ((geometricPointFiber B S hS s).map f x)
      let a : z' ⟶ t' := CategoryOfElements.homMk z' t' g hz
      let b : y' ⟶ t' := CategoryOfElements.homMk y' t' f rfl
      obtain ⟨W, p, q, hpq⟩ := IsCofilteredOrEmpty.cone_objs z' y'
      obtain ⟨W', e, he⟩ := IsCofilteredOrEmpty.cone_maps (p ≫ a) (q ≫ b)
      let eBase : W'.1 ⟶ W.1 := e.val
      let pBase : W.1 ⟶ Z := p.val
      let qBase : W.1 ⟶ Y := q.val
      have heBase : eBase ≫ pBase ≫ g = eBase ≫ qBase ≫ f := by
        simpa [eBase, pBase, qBase, a, b, CategoryOfElements.comp_val,
          Category.assoc] using congrArg Subtype.val he
      refine ⟨W'.1, eBase ≫ qBase, ?_, W'.2, ?_⟩
      · show R ((eBase ≫ qBase) ≫ f)
        rw [Category.assoc, ← heBase, ← Category.assoc]
        exact R.downward_closed hg _
      · have hePoint : (geometricPointFiber B S hS s).map eBase W'.2 = W.2 := e.property
        have hqPoint : (geometricPointFiber B S hS s).map qBase W.2 = x := q.property
        rw [Functor.map_comp_apply, hePoint, hqPoint]
  | transitive X R T hR hlocal ihR ihlocal =>
      obtain ⟨Y, f, hf, y, hy⟩ := ihR x
      obtain ⟨Z, g, hg, z, hz⟩ := ihlocal hf y
      refine ⟨Z, g ≫ f, ?_, z, ?_⟩
      · simpa using hg
      · rw [Functor.map_comp_apply, hz, hy]

/-- **Stacks Project, Tag 04FM.** The functor `u` of
`AlgebraicGeometry.geometricPointFiber` defines a point `p` of the site `S_étale`: a geometric
point of `S`, viewed as a point of the small étale site of `S`, with fiber functor `u`.

The source obtains this from the criterion of Sites, Proposition 00YC, checking that `u(S)` is
a singleton, that `u` preserves fibre products, and that `∐ u(U_i) ⟶ u(U)` is surjective for a
covering. Mathlib's `CategoryTheory.GrothendieckTopology.Point` asks instead for
cofilteredness of the category of elements of `u`, which for this `u` is the cofilteredness of
the category of étale neighbourhoods of the geometric point
(`AlgebraicGeometry.isCofiltered_geometricPointFiber_elements`), together with the joint
surjectivity, which is `AlgebraicGeometry.geometricPointFiber_jointly_surjective`. The two
descriptions of a point agree on a site with finite limits by
`CategoryTheory.GrothendieckTopology.Point.equivFiber`, the formalization of Tag 00YC. -/
@[stacks 04FM "the functor `u` defines a point of the small étale site"]
public def geometricPointSitePoint :
    (SmallEtale.topology B S hS).Point where
  fiber := geometricPointFiber B S hS s
  isCofiltered := isCofiltered_geometricPointFiber_elements B S hS s
  initiallySmall := geometricPointFiber_initiallySmall B S hS s
  jointly_surjective := geometricPointFiber_jointly_surjective B S hS s

/-- The fiber functor of the point attached to a geometric point is the functor of lifts. -/
@[simp]
public theorem geometricPointSitePoint_fiber :
    (geometricPointSitePoint B S hS s).fiber = geometricPointFiber B S hS s :=
  rfl

/-- **Stacks Project, Tag 04FM**, the final assertion: the stalk functor `F ↦ F_p` attached to
the point `p = AlgebraicGeometry.geometricPointSitePoint` by Sites, Equation 04EH — which is
`CategoryTheory.GrothendieckTopology.Point.presheafFiber` — is the stalk functor
`F ↦ F_s̄` at the geometric point of Tag 040R, which is `AlgebraicGeometry.etaleStalk`. Both
are given by the same colimit over the category of étale neighbourhoods, so the general theory
of points of a site — exactness, invariance under sheafification, commutation with colimits —
applies to the stalk at a geometric point. -/
@[stacks 04FM "the stalk functor of `p` is the stalk at the geometric point"]
public theorem etaleStalk_eq_presheafFiber {A : Type v} [Category.{w} A]
    [HasColimitsOfSize.{u, u} A] (F : (SmallEtale B S hS)ᵒᵖ ⥤ A) :
    etaleStalk B S hS s F = (geometricPointSitePoint B S hS s).presheafFiber.obj F := rfl

end AlgebraicGeometry

end
