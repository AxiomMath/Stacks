module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.DirectSumsOfEtaleCohomology
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.EtaleModuleCohomologyForget
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ConstantSheafHom
public import Mathlib.LinearAlgebra.Dimension.Free
public import Mathlib.Algebra.Module.ZMod
public import StacksFrontier.Homology.DerivedIndexing.Basic

/-!
# Cohomology of constant sheaves of `Λ`-modules through abelian constant sheaves

Let `Λ` be a commutative ring, `X` a scheme and `M` a `Λ`-module. The underlying abelian sheaf of
the constant sheaf of `Λ`-modules `M̲` on the small étale site of `X` is the constant abelian sheaf
on the underlying abelian group of `M`, so every additive map `φ : A ⟶ M` out of an abelian group
induces a map `H^q(X, A̲) ⟶ H^q(X, M̲)` from abelian étale cohomology to the cohomology of `M̲` as
a sheaf of `Λ`-modules. This map is additive in `φ`, it is functorial in `A`, and post-composing
`φ` with multiplication by `a ∈ Λ` multiplies the image by `a`. When `X` is quasi-compact and
quasi-separated and `M` is an `𝔽_ℓ`-vector space, every class of `H^q(X, M̲)` comes from a finite
dimensional subspace of `M` (Stacks 03Q5). These give the finiteness of `H^q(X, M̲)` of
[Stacks, Tag 0GJC].

## Main definitions

* `Stacks.EtaleCohomology.etaleModuleForgetConstantSheafIso`: `(M̲)_ab ≅ (M_ab)̲`.
* `Stacks.EtaleCohomology.constantCohomologyMap`: the map `H^q(X, A̲) ⟶ H^q(X, M̲)` induced by an
  additive map `A ⟶ M`.
* `Stacks.EtaleCohomology.finsetClosureCocone`: an abelian group as the filtered colimit of the
  subgroups generated by its finite subsets (`finsetClosureCoconeIsColimit`).

## Main results

* `Stacks.EtaleCohomology.preservesSheafification_forget₂_moduleCat_smallEtale`: forgetting the
  module structure commutes with sheafification on the small étale site.
* `Stacks.EtaleCohomology.constantCohomologyMap_smul`: multiplication by `a ∈ Λ` after `φ`
  multiplies the induced map by `a`.
* `Stacks.EtaleCohomology.exists_constantCohomologyMap_eq_of_isColimit`: on a quasi-compact and
  quasi-separated scheme every class of `H^q(X, M̲)` comes from a stage of a filtered colimit
  presentation of the abelian group `M`.
* `Stacks.EtaleCohomology.module_finite_constantCohomology_of_prime`: the `𝔽_ℓ`-basis trick of
  Tag 0GJC — `H^q(X, M̲)` is a finite `Λ`-module for `M` finite and killed by a prime `ℓ`, as
  soon as `H^q(X, ℤ/ℓ̲)` is finite.
* `Stacks.EtaleCohomology.module_finite_constantCohomology_of_nsmul_eq_zero`: the dévissage of
  Tag 0GJC from an integer `n > 0` to its prime divisors.

## References

* [Stacks Project, Tag 0GJC](https://stacks.math.columbia.edu/tag/0GJC)
* [Stacks Project, Tag 03Q5](https://stacks.math.columbia.edu/tag/03Q5)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry AlgebraicGeometry.Scheme

universe u r

namespace Stacks.EtaleCohomology

variable (Λ : Type r) [CommRing Λ] (X : Scheme.{u})

/-- **Forgetting the module structure commutes with sheafification** on the small étale site
of `X`, for sheaves of `Λ`-modules with values in the universe `max (u + 1) r`. -/
theorem preservesSheafification_forget₂_moduleCat_smallEtale :
    X.smallEtaleTopology.PreservesSheafification
      (forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r}) := by
  have hlim : Limits.HasLimitsOfSize.{u + 1, u + 1} (ModuleCat.{max (u + 1) r} Λ) :=
    ModuleCat.hasLimitsOfSize.{u + 1, u + 1, max (u + 1) r, r} (R := Λ)
  have hcol' : ∀ Y : X.Etale, Limits.PreservesColimitsOfShape (X.smallEtaleTopology.Cover Y)ᵒᵖ
      (forget AddCommGrpCat.{max (u + 1) r}) := fun Y =>
    Stacks.ConstantSheaf.preservesColimitsOfShape_forget_addCommGrp_of_univLE _ Y
  have hcol : ∀ Y : X.Etale, Limits.PreservesColimitsOfShape (X.smallEtaleTopology.Cover Y)ᵒᵖ
      (forget (ModuleCat.{max (u + 1) r} Λ)) := fun Y =>
    Limits.comp_preservesColimitsOfShape
      (forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r})
      (forget AddCommGrpCat.{max (u + 1) r})
  exact GrothendieckTopology.instPreservesSheafification _ _

/-- **The underlying abelian sheaf of a constant sheaf of `Λ`-modules is constant**: `(M̲)_ab` is
the constant abelian sheaf on the underlying abelian group of `M`, naturally in `M`. -/
def etaleModuleForgetConstantSheafIso :
    constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ) ⋙
        etaleModuleForgetAb.{u, r} Λ X ≅
      forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r} ⋙
        constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r} :=
  have := preservesSheafification_forget₂_moduleCat_smallEtale.{u, r} Λ X
  constantCommuteCompose X.smallEtaleTopology
    (forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r})

/-- The constant abelian sheaf functor on the small étale site of `X` is additive. -/
local instance : (constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).Additive :=
  (constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}
    (etaleSiteTerminalIsTerminal X)).left_adjoint_additive

/-- The global sections functor on abelian sheaves on the small étale site of `X` is additive. -/
local instance : (Sheaf.Γ X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).Additive :=
  Functor.additive_of_preserves_binary_products _

/-- **The map `H^q(X, A̲) ⟶ H^q(X, M̲)` induced by an additive map `φ : A ⟶ M`**, from the
cohomology of the constant abelian sheaf `A̲` to the cohomology of the constant sheaf of
`Λ`-modules `M̲`, read on underlying abelian groups through
`Stacks.EtaleCohomology.etaleModuleCohomologyForgetIso`. -/
def constantCohomologyMap (q : ℕ) {A : AddCommGrpCat.{max (u + 1) r}}
    {M : ModuleCat.{max (u + 1) r} Λ}
    (φ : A ⟶ (forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r}).obj M) :
    ((Sheaf.Γ X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).rightDerived q).obj
        ((constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).obj A) ⟶
      (forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r}).obj
        (((etaleModuleGlobalSections.{u, r} Λ X).rightDerived q).obj
          ((constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)).obj M)) :=
  ((Sheaf.Γ X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).rightDerived q).map
      ((constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).map φ ≫
        ((etaleModuleForgetConstantSheafIso.{u, r} Λ X).app M).inv) ≫
    ((etaleModuleCohomologyForgetIso.{u, r} Λ X q).app _).inv

variable {Λ X}

/-- The map `H^q(X, A̲) ⟶ H^q(X, M̲)` induced by a finite sum of additive maps `A ⟶ M` is the sum
of the induced maps. -/
theorem constantCohomologyMap_sum (q : ℕ) {A : AddCommGrpCat.{max (u + 1) r}}
    {M : ModuleCat.{max (u + 1) r} Λ} {ι : Type*} (s : Finset ι)
    (φ : ι → (A ⟶ (forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r}).obj M)) :
    constantCohomologyMap Λ X q (∑ i ∈ s, φ i) = ∑ i ∈ s, constantCohomologyMap Λ X q (φ i) := by
  unfold constantCohomologyMap
  rw [(constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).map_sum,
    Preadditive.sum_comp,
    ((Sheaf.Γ X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).rightDerived q).map_sum,
    Preadditive.sum_comp]

/-- For additive maps `g : A ⟶ B` and `φ : B ⟶ M`, the map induced by `g ≫ φ` is the map
`H^q(X, A̲) ⟶ H^q(X, B̲)` induced by `g` followed by the map induced by `φ`. -/
theorem constantCohomologyMap_comp (q : ℕ) {A B : AddCommGrpCat.{max (u + 1) r}}
    {M : ModuleCat.{max (u + 1) r} Λ} (g : A ⟶ B)
    (φ : B ⟶ (forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r}).obj M) :
    constantCohomologyMap Λ X q (g ≫ φ) =
      ((Sheaf.Γ X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).rightDerived q).map
          ((constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).map g) ≫
        constantCohomologyMap Λ X q φ := by
  simp only [constantCohomologyMap, Functor.map_comp, Category.assoc]

/-- **Multiplication by a scalar after `φ` multiplies the induced map by that scalar.** The
comparison `(M̲)_ab ≅ (M_ab)̲` is natural in `M`, the constant sheaf functor is `Λ`-linear, and
multiplication by `a` on `H^q(X, M̲)` is the map induced by multiplication by `a` on `M̲`, the
right derived functors of the `Λ`-linear functor of global sections being `Λ`-linear
(`Stacks.DerivedLinear.rightDerived_linear`). -/
theorem constantCohomologyMap_smul (q : ℕ) {A : AddCommGrpCat.{max (u + 1) r}}
    {M : ModuleCat.{max (u + 1) r} Λ}
    (φ : A ⟶ (forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r}).obj M)
    (a : Λ) :
    constantCohomologyMap Λ X q
        (φ ≫ (forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r}).map
          (a • 𝟙 M)) =
      constantCohomologyMap Λ X q φ ≫
        (forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r}).map
          (a • 𝟙 (((etaleModuleGlobalSections.{u, r} Λ X).rightDerived q).obj
            ((constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)).obj M))) := by
  have : Functor.Linear Λ (constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)) :=
    inferInstanceAs (Functor.Linear Λ (Functor.const X.Etaleᵒᵖ ⋙
      presheafToSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)))
  have := Stacks.DerivedLinear.rightDerived_linear (R := Λ)
    (etaleModuleGlobalSections.{u, r} Λ X) q
  let F := (constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)).obj M
  have hθ : (constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).map
        ((forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r}).map (a • 𝟙 M)) ≫
        (etaleModuleForgetConstantSheafIso.{u, r} Λ X).inv.app M =
      (etaleModuleForgetConstantSheafIso.{u, r} Λ X).inv.app M ≫
        (etaleModuleForgetAb.{u, r} Λ X).map (a • 𝟙 F) := by
    have h := (etaleModuleForgetConstantSheafIso.{u, r} Λ X).inv.naturality (a • 𝟙 M)
    simp only [Functor.comp_map] at h
    rw [h, Functor.map_smul, CategoryTheory.Functor.map_id]
  have hψ := (etaleModuleCohomologyForgetIso.{u, r} Λ X q).inv.naturality (a • 𝟙 F)
  simp only [Functor.comp_map, Functor.map_smul, CategoryTheory.Functor.map_id] at hψ
  unfold constantCohomologyMap
  rw [(constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).map_comp φ,
    Category.assoc, Iso.app_inv, hθ, ← Category.assoc, Functor.map_comp, Category.assoc,
    Iso.app_inv, hψ]
  simp only [Category.assoc]
  rfl

section Colimit

/-- **On a quasi-compact quasi-separated scheme, every class of `H^q(X, M̲)` comes from a stage
of a filtered colimit presentation of `M`.** If the underlying abelian group of `M` is the
filtered colimit of a diagram `D` of abelian groups, every class of `H^q(X, M̲)` is the image of a
class of `H^q(X, D(j)̲)` for some `j`: the constant sheaf functor is a left adjoint, and étale
cohomology of `X` commutes with filtered colimits (Stacks 03Q5). -/
theorem exists_constantCohomologyMap_eq_of_isColimit [CompactSpace X] [QuasiSeparatedSpace X]
    {J : Type (max (u + 1) r)} [SmallCategory J] [IsFiltered J]
    {D : J ⥤ AddCommGrpCat.{max (u + 1) r}} {M : ModuleCat.{max (u + 1) r} Λ}
    (ι : D ⟶ (Functor.const J).obj
      ((forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r}).obj M))
    (hc : IsColimit (Cocone.mk _ ι)) (q : ℕ)
    (x : ((etaleModuleGlobalSections.{u, r} Λ X).rightDerived q).obj
      ((constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)).obj M)) :
    ∃ (j : J) (y : ((Sheaf.Γ X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).rightDerived
        q).obj ((constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).obj (D.obj j))),
      constantCohomologyMap Λ X q (ι.app j) y = x := by
  let G := constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r} ⋙
    (Sheaf.Γ X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).rightDerived q
  have : PreservesColimitsOfShape J
      (constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}) :=
    (constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}
      (etaleSiteTerminalIsTerminal X)).leftAdjoint_preservesColimits.preservesColimitsOfShape
  have : PreservesColimitsOfShape J
      ((Sheaf.Γ X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).rightDerived q) :=
    preservesColimitsOfShape_rightDerived_Γ_smallEtale.{r} X q J
  have hG := isColimitOfPreserves G hc
  let e := (etaleModuleCohomologyForgetIso.{u, r} Λ X q).app
      ((constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)).obj M) ≪≫
    ((Sheaf.Γ X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).rightDerived q).mapIso
      ((etaleModuleForgetConstantSheafIso.{u, r} Λ X).app M)
  obtain ⟨j, y, hy⟩ := Concrete.isColimit_exists_rep _ hG (e.hom x)
  refine ⟨j, y, ?_⟩
  have h : constantCohomologyMap Λ X q (ι.app j) =
      (G.mapCocone (Cocone.mk _ ι)).ι.app j ≫ e.inv := by
    rw [Functor.mapCocone_ι_app, Functor.comp_map]
    simp only [e, Iso.trans_inv, Functor.mapIso_inv, Iso.app_inv]
    unfold constantCohomologyMap
    rw [Functor.map_comp, Category.assoc]
    simp only [Iso.app_inv]
  rw [h, ConcreteCategory.comp_apply, hy, ← ConcreteCategory.comp_apply, Iso.hom_inv_id,
    ConcreteCategory.id_apply]

end Colimit

section Span

universe w

/-- The subgroups of an abelian group `M` generated by the finite subsets of `M`, as a diagram
of abelian groups indexed by the finite subsets. -/
def finsetClosureDiagram (M : AddCommGrpCat.{w}) : Finset M ⥤ AddCommGrpCat.{w} where
  obj S := AddCommGrpCat.of (AddSubgroup.closure (S : Set M))
  map {S T} h := AddCommGrpCat.ofHom (AddSubgroup.inclusion (AddSubgroup.closure_mono
    (Finset.coe_subset.mpr (leOfHom h))))
  map_id S := by ext; rfl
  map_comp {S T U} f g := by ext; rfl

/-- The cocone of inclusions of the subgroups generated by finite subsets into `M`. -/
def finsetClosureCocone (M : AddCommGrpCat.{w}) : Cocone (finsetClosureDiagram M) where
  pt := M
  ι :=
    { app S := AddCommGrpCat.ofHom (AddSubgroup.closure (S : Set M)).subtype
      naturality {S T} h := by ext; rfl }

/-- An abelian group is the filtered colimit of the subgroups generated by its finite subsets. -/
def finsetClosureCoconeIsColimit (M : AddCommGrpCat.{w}) :
    IsColimit (finsetClosureCocone M) :=
  haveI : ReflectsColimitsOfShape (Finset M) (forget AddCommGrpCat.{w}) :=
    reflectsColimitsOfShape_of_reflectsIsomorphisms
  isColimitOfReflects (forget AddCommGrpCat.{w})
    (Types.FilteredColimit.isColimitOf' _ _
      (fun x => ⟨{x}, ⟨x, AddSubgroup.subset_closure
        (Finset.mem_coe.2 (Finset.mem_singleton_self x))⟩, rfl⟩)
      (fun S _ _ hxy => ⟨S, 𝟙 S, Subtype.ext hxy⟩))

end Span

section Prime

/-- Evaluating a finite sum of morphisms of abelian groups at an element. -/
theorem addCommGrpCat_sum_apply.{v} {A B : AddCommGrpCat.{v}} {κ : Type*} (G : Finset κ)
    (g : κ → (A ⟶ B)) (a : A) : (∑ i ∈ G, g i) a = ∑ i ∈ G, g i a := by
  classical
  induction G using Finset.induction with
  | empty => rfl
  | insert i G hi ih =>
    rw [Finset.sum_insert hi, Finset.sum_insert hi, AddCommGrpCat.hom_add_apply, ih]

/-- The multiples map of an element `m` killed by `ℓ` vanishes at `ℓ`. -/
theorem zmultiplesHom_natCast_eq_zero.{v} (ℓ : ℕ) {A : Type v} [AddCommGroup A] (m : A)
    (hm : ℓ • m = 0) : zmultiplesHom A m ℓ = 0 := by
  rw [zmultiplesHom_apply, natCast_zsmul, hm]

/-- The morphism `ℤ/ℓ ⟶ A` of abelian groups sending `1` to an element `m` killed by `ℓ`. -/
def zmodULiftHom.{v} (ℓ : ℕ) {A : Type v} [AddCommGroup A] (m : A) (hm : ℓ • m = 0) :
    AddCommGrpCat.of (ULift.{v} (ZMod ℓ)) ⟶ AddCommGrpCat.of A :=
  AddCommGrpCat.ofHom ((ZMod.lift ℓ ⟨zmultiplesHom A m, zmultiplesHom_natCast_eq_zero ℓ m hm⟩).comp
    AddEquiv.ulift.toAddMonoidHom)

/-- `zmodULiftHom ℓ m hm` sends `a` to `a.val • m`. -/
theorem zmodULiftHom_apply.{v} (ℓ : ℕ) [NeZero ℓ] {A : Type v} [AddCommGroup A] (m : A)
    (hm : ℓ • m = 0) (a : ZMod ℓ) : zmodULiftHom ℓ m hm (ULift.up a) = a.val • m := by
  show ZMod.lift ℓ ⟨zmultiplesHom A m, zmultiplesHom_natCast_eq_zero ℓ m hm⟩ a = a.val • m
  have ha : a = ((a.val : ℤ) : ZMod ℓ) := by rw [Int.cast_natCast, ZMod.natCast_zmod_val]
  conv_lhs => rw [ha]
  rw [ZMod.lift_coe, zmultiplesHom_apply, natCast_zsmul]

/-- **Coordinates on a finitely generated abelian group killed by a prime `ℓ`.** Such a group
`W` is a finite dimensional `𝔽_ℓ`-vector space, so it has finitely many additive coordinate
functions `e_k : W → ℤ/ℓ` and vectors `v_k` with `w = ∑ (e_k w) • v_k` for every `w`. -/
theorem exists_zmod_coordinates (ℓ : ℕ) [Fact ℓ.Prime] (W : Type*) [AddCommGroup W]
    [Module.Finite ℤ W] (hW : ∀ w : W, ℓ • w = 0) :
    ∃ (d : ℕ) (e : Fin d → (W →+ ZMod ℓ)) (v : Fin d → W),
      ∀ w : W, w = ∑ k, (e k w).val • v k := by
  classical
  let : Module (ZMod ℓ) W := AddCommGroup.zmodModule hW
  have hfin : Module.Finite (ZMod ℓ) W :=
    Module.Finite.of_restrictScalars_finite ℤ (ZMod ℓ) W
  let E : W ≃+ (Fin (Module.finrank (ZMod ℓ) W) → ZMod ℓ) :=
    (@Module.finBasis (ZMod ℓ) W _ _ (AddCommGroup.zmodModule hW)
      (Module.Free.of_divisionRing (ZMod ℓ) W) _ hfin).equivFun.toAddEquiv
  refine ⟨_, fun k => (Pi.evalAddMonoidHom (fun _ => ZMod ℓ) k).comp E.toAddMonoidHom,
    fun k => E.symm (Pi.single k 1), fun w => ?_⟩
  conv_lhs => rw [← E.symm_apply_apply w, ← Finset.univ_sum_single (E w), map_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [← map_nsmul]
  congr 1
  rw [← Pi.single_smul', nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
  rfl

/-- **The `𝔽_ℓ`-basis trick of [Stacks, Tag 0GJC].** Let `X` be quasi-compact and
quasi-separated, `ℓ` a prime such that `H^q(X, ℤ/ℓ̲)` is finite, and `M` a finite `Λ`-module
killed by `ℓ`. Then `H^q(X, M̲)` is a finite `Λ`-module.

Choose generators `s_1, …, s_n` of `M`. Every class of `H^q(X, M̲)` comes from the cohomology of
the constant sheaf on a finitely generated subgroup `W` of `M` (Stacks 03Q5), which is a finite
dimensional `𝔽_ℓ`-vector space. Writing each vector `v_k` of an `𝔽_ℓ`-basis of `W` as
`∑ c_kj s_j`, the inclusion `W ⟶ M` is `∑_k ∑_j c_kj · (1 ↦ s_j) ∘ e_k` for the coordinate
functions `e_k`, so the class lies in the `Λ`-submodule generated by the images of the finite
group `H^q(X, ℤ/ℓ̲)` under the maps induced by `1 ↦ s_j`. -/
theorem module_finite_constantCohomology_of_prime [CompactSpace X] [QuasiSeparatedSpace X]
    (ℓ : ℕ) [Fact ℓ.Prime] (q : ℕ)
    (hfin : Finite (((Sheaf.Γ X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).rightDerived
      q).obj ((constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).obj
        (AddCommGrpCat.of (ULift.{max (u + 1) r} (ZMod ℓ))))))
    (M : ModuleCat.{max (u + 1) r} Λ) [Module.Finite Λ M] (hM : ∀ m : M, ℓ • m = 0) :
    Module.Finite Λ (((etaleModuleGlobalSections.{u, r} Λ X).rightDerived q).obj
      ((constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)).obj M)) := by
  classical
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' Λ M
  let s : Fin n → M := fun j => f (fun i => if j = i then 1 else 0)
  let Z := AddCommGrpCat.of (ULift.{max (u + 1) r} (ZMod ℓ))
  let Mab := (forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r}).obj M
  let ιm : M → (Z ⟶ Mab) := fun m => zmodULiftHom ℓ m (hM m)
  have hιm : ∀ (m : M) (a : ZMod ℓ), ιm m (ULift.up a) = a.val • m :=
    fun m a => zmodULiftHom_apply ℓ m (hM m) a
  let H := ((etaleModuleGlobalSections.{u, r} Λ X).rightDerived q).obj
    ((constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)).obj M)
  let gens : Set H := ⋃ j, Set.range (constantCohomologyMap Λ X q (ιm (s j)))
  suffices hspan : Submodule.span Λ gens = ⊤ from
    ⟨Submodule.fg_def.2 ⟨gens, Set.finite_iUnion fun _ => Set.finite_range _, hspan⟩⟩
  refine eq_top_iff.2 fun x _ => ?_
  obtain ⟨S, y, rfl⟩ := exists_constantCohomologyMap_eq_of_isColimit
    (finsetClosureCocone Mab).ι (finsetClosureCoconeIsColimit Mab) q x
  let W := AddSubgroup.closure (S : Set Mab)
  have : Module.Finite ℤ W :=
    Module.Finite.iff_addGroup_fg.2 ((AddGroup.fg_iff_addSubgroup_fg W).2
      ((AddSubgroup.fg_iff W).2 ⟨S, rfl, S.finite_toSet⟩))
  obtain ⟨d, e, v, hv⟩ := exists_zmod_coordinates ℓ W fun w => Subtype.ext (hM w.1)
  have hc : ∀ k, ∃ c : Fin n → Λ, ((v k : W) : M) = ∑ j, c j • s j := fun k => by
    obtain ⟨c, hc⟩ := hf ((v k : W) : M)
    exact ⟨c, by rw [← hc, LinearMap.pi_apply_eq_sum_univ]⟩
  choose c hc using hc
  let coord : Fin d → ((finsetClosureDiagram Mab).obj S ⟶ Z) := fun k =>
    show AddCommGrpCat.of W ⟶ Z from
      AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp (e k))
  let φS : (finsetClosureDiagram Mab).obj S ⟶
      (forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r}).obj M :=
    show AddCommGrpCat.of W ⟶ Mab from AddCommGrpCat.ofHom W.subtype
  have hφS : (finsetClosureCocone Mab).ι.app S = φS := rfl
  have key : φS = ∑ k, ∑ j, coord k ≫ ιm (s j) ≫
        (forget₂ (ModuleCat.{max (u + 1) r} Λ) AddCommGrpCat.{max (u + 1) r}).map
          (c k j • 𝟙 M) := by
    refine AddCommGrpCat.ext fun w => ?_
    simp_rw [addCommGrpCat_sum_apply]
    show (w.1 : M) = ∑ k, ∑ j, c k j • (show M from ιm (s j) (ULift.up (e k w)))
    simp_rw [hιm, smul_comm (c _ _) ((e _ w).val), ← Finset.smul_sum, ← hc]
    conv_lhs => rw [hv w]
    rw [AddSubgroup.val_finset_sum]
    rfl
  rw [hφS, key]
  simp only [constantCohomologyMap_sum, addCommGrpCat_sum_apply]
  refine Submodule.sum_mem _ fun k _ => Submodule.sum_mem _ fun j _ => ?_
  rw [← Category.assoc, constantCohomologyMap_smul, constantCohomologyMap_comp]
  exact Submodule.smul_mem _ (c k j) (Submodule.subset_span (Set.mem_iUnion.2 ⟨j, _, rfl⟩))

end Prime

section Devissage

attribute [local instance] HasDerivedCategory.standard

/-- Over a Noetherian ring, the middle term of an exact sequence `A ⟶ B ⟶ C` of modules with `A`
and `C` finite is finite. -/
theorem module_finite_of_function_exact {R A B C : Type*} [Ring R] [IsNoetherianRing R]
    [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B] [AddCommGroup C] [Module R C]
    [Module.Finite R A] [Module.Finite R C] {φ : A →ₗ[R] B} {ψ : B →ₗ[R] C}
    (h : Function.Exact φ ψ) : Module.Finite R B := by
  have : Module.Finite R (LinearMap.range ψ) :=
    Module.Finite.iff_fg.2 (IsNoetherian.noetherian _)
  refine Module.Finite.of_exact (f := φ) (g := ψ.rangeRestrict) (fun x => ?_)
    ψ.surjective_rangeRestrict
  exact ⟨fun h' => (h x).1 (congrArg Subtype.val h'), fun h' => Subtype.ext ((h x).2 h')⟩

/-- The cohomology of the constant sheaf on a zero module is a finite module. -/
theorem module_finite_constantCohomology_of_isZero (M : ModuleCat.{max (u + 1) r} Λ)
    (hM : IsZero M) (q : ℕ) :
    Module.Finite Λ (((etaleModuleGlobalSections.{u, r} Λ X).rightDerived q).obj
      ((constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)).obj M)) := by
  have := ModuleCat.subsingleton_of_isZero (Functor.map_isZero
    ((etaleModuleGlobalSections.{u, r} Λ X).rightDerived q)
    (Functor.map_isZero (constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)) hM))
  infer_instance

/-- **[Stacks, Tag 0GJC], the dévissage to a prime.** Let `Λ` be Noetherian, `X` quasi-compact and
quasi-separated, and `n > 0` an integer such that `H^q(X, ℤ/ℓ̲)` is finite for every prime `ℓ`
dividing `n` and every `q`. Then for every finite `Λ`-module `M` killed by `n` and every `q`, the
`Λ`-module `H^q(X, M̲)` is finite.

For `n = ℓ n'` with `ℓ` prime, the short exact sequence `0 ⟶ M[ℓ] ⟶ M ⟶ M/M[ℓ] ⟶ 0` of finite
`Λ`-modules, with `M/M[ℓ]` killed by `n'`, gives an exact sequence
`H^q(X, M[ℓ]̲) ⟶ H^q(X, M̲) ⟶ H^q(X, (M/M[ℓ])̲)`; the left term is finite by the `𝔽_ℓ`-basis
trick (`module_finite_constantCohomology_of_prime`) and the right one by induction on `n`. -/
theorem module_finite_constantCohomology_of_nsmul_eq_zero [IsNoetherianRing Λ] [CompactSpace X]
    [QuasiSeparatedSpace X] (n : ℕ) (hn : 0 < n)
    (hfin : ∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ n → ∀ q : ℕ,
      Finite (((Sheaf.Γ X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).rightDerived q).obj
        ((constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) r}).obj
          (AddCommGrpCat.of (ULift.{max (u + 1) r} (ZMod ℓ))))))
    (M : ModuleCat.{max (u + 1) r} Λ) [Module.Finite Λ M] (hM : ∀ m : M, n • m = 0) (q : ℕ) :
    Module.Finite Λ (((etaleModuleGlobalSections.{u, r} Λ X).rightDerived q).obj
      ((constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)).obj M)) := by
  induction n using Nat.strong_induction_on generalizing M with
  | _ n ih =>
  by_cases h1 : n = 1
  · subst h1
    refine module_finite_constantCohomology_of_isZero M
      (@ModuleCat.isZero_of_subsingleton _ _ M ⟨fun a b => ?_⟩) q
    rw [← one_nsmul a, ← one_nsmul b, hM a, hM b]
  · let ℓ := n.minFac
    have hℓ : ℓ.Prime := Nat.minFac_prime h1
    have : Fact ℓ.Prime := ⟨hℓ⟩
    obtain ⟨n', hn'⟩ : ℓ ∣ n := Nat.minFac_dvd n
    have hn'0 : 0 < n' := Nat.pos_of_ne_zero (by rintro rfl; omega)
    have hn'lt : n' < n := (lt_mul_left hn'0 hℓ.one_lt).trans_eq hn'.symm
    let K : Submodule Λ M := LinearMap.ker ((ℓ : ℕ) • LinearMap.id)
    let g : M →ₗ[Λ] M ⧸ K := K.mkQ
    let S := g.shortComplexKer
    have : PreservesFiniteColimits
        (constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)) :=
      (constantSheafAdj X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)
        (etaleSiteTerminalIsTerminal X)).leftAdjoint_preservesColimits.{0, 0}
        |>.preservesFiniteColimits
    have hS' := (LinearMap.shortExact_shortComplexKer K.mkQ_surjective).map_of_exact
      (constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ))
    have hex : ((S.map (constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ))).map
        ((etaleModuleGlobalSections.{u, r} Λ X).rightDerived q)).Exact :=
      (Stacks.DerivedIndexing.rightDerivedDeltaFunctorOfEnoughInjectives
        (etaleModuleGlobalSections.{u, r} Λ X)).exact_map hS' q
    have h₁ : Module.Finite Λ (((etaleModuleGlobalSections.{u, r} Λ X).rightDerived q).obj
        ((constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)).obj S.X₁)) := by
      have : Module.Finite Λ S.X₁ := inferInstanceAs (Module.Finite Λ (LinearMap.ker g))
      refine module_finite_constantCohomology_of_prime ℓ q (hfin ℓ hℓ ⟨n', hn'⟩ q) S.X₁
        fun x => Subtype.ext ?_
      have hx : (x : M) ∈ K := (Submodule.Quotient.mk_eq_zero K).1 (show g x = 0 from x.2)
      show ℓ • (x : M) = 0
      simpa [K] using hx
    have h₃ : Module.Finite Λ (((etaleModuleGlobalSections.{u, r} Λ X).rightDerived q).obj
        ((constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)).obj S.X₃)) := by
      have : Module.Finite Λ S.X₃ := inferInstanceAs (Module.Finite Λ (M ⧸ K))
      refine ih n' hn'lt hn'0 (fun l hl hln => hfin l hl (hln.trans ⟨ℓ, by rw [hn', mul_comm]⟩))
        S.X₃ fun x => ?_
      obtain ⟨m, rfl⟩ := K.mkQ_surjective x
      show n' • K.mkQ m = 0
      rw [← map_nsmul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, LinearMap.mem_ker]
      show ℓ • n' • m = 0
      rw [smul_smul, ← hn', hM m]
    let F := (etaleModuleGlobalSections.{u, r} Λ X).rightDerived q
    let cs := constantSheaf X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ)
    exact module_finite_of_function_exact (φ := (F.map (cs.map S.f)).hom)
      (ψ := (F.map (cs.map S.g)).hom)
      ((ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).1 hex)

end Devissage

end Stacks.EtaleCohomology

