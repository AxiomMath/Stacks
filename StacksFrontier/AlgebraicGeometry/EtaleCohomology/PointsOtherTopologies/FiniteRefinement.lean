module

public import Mathlib.CategoryTheory.Sites.DenseSubsite.SheafEquiv
public import Mathlib.CategoryTheory.Sites.LeftExact
public import Mathlib.CategoryTheory.Sites.Point.Map
public import Mathlib.CategoryTheory.Sites.Sieves.Basic
public import StacksFrontier.CategoryTheory.Sites.Point.ConservativeFamily
public import StacksFrontier.CategoryTheory.Sites.Point.CriterionForExistenceOfPoints

/-!
# Two site-theoretic criteria for having enough points

The sites of the standard topologies on schemes all have enough points for the same two
reasons, collected here so that each topology uses one copy.

The first is a finiteness criterion: if every covering family of a precoverage can be taken to
have a finite index set, then so can every refinement obtained by saturating, which is the
hypothesis of the criterion for the existence of points. The second transports a conservative
family of points from a dense subsite to the ambient site.

## Main results

* `CategoryTheory.finite_refinement_saturate` refines a saturated sieve by a finite covering
  family.
* `CategoryTheory.Precoverage.hasConservativeFamily_toGrothendieck_of_finite`: a small site with
  fibre products whose topology is generated by finite covering families has a conservative
  family of points (Deligne's criterion, Stacks 0DW0).
* `CategoryTheory.hasConservativeFamily_of_denseSubsite` transports a conservative family of
  points along the inclusion of a dense subsite.

## Implementation notes

Both statements are about an arbitrary site, so they live in `CategoryTheory` rather than in
`AlgebraicGeometry`. In the second, the images of the subsite's points are collected as an
`ObjectProperty` on the points of the ambient site; no smallness of the family is required.

## References

* [Stacks Project, Tag 06VX](https://stacks.math.columbia.edu/tag/06VX)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u u₂ u₁ v₁ w₁ w

namespace CategoryTheory

/-- If every covering family of a precoverage admits a finite representative, then every sieve
saturated for that precoverage is refined by the sieve of a finite covering family which is
itself covering for the generated topology. -/
theorem finite_refinement_saturate {C : Type u₁} [Category.{v₁, u₁} C]
    [Limits.HasPullbacks C] (K : Precoverage C)
    (hbase : ∀ ⦃X : C⦄ ⦃R : Presieve X⦄, R ∈ K X →
      ∃ E : PreZeroHypercover.{w₁} X, Finite E.I₀ ∧ R = E.presieve₀)
    {X : C} {S : Sieve X} (hS : K.Saturate X S) :
    ∃ E : PreZeroHypercover.{w₁} X, Finite E.I₀ ∧ E.sieve₀ ≤ S ∧
      E.sieve₀ ∈ K.toGrothendieck X := by
  induction hS with
  | of X R hR =>
      obtain ⟨E, hEfin, rfl⟩ := hbase hR
      exact ⟨E, hEfin, le_refl _, K.generate_mem_toGrothendieck hR⟩
  | top X =>
      let E : PreZeroHypercover.{w₁} X := PreZeroHypercover.singleton (𝟙 X)
      have hEtop : E.sieve₀ = ⊤ := Sieve.id_mem_iff_eq_top.mp (E.sieve₀_f PUnit.unit)
      exact ⟨E, inferInstance, by simp [hEtop], hEtop ▸ (K.toGrothendieck).top_mem X⟩
  | @pullback X S hS Y f ih =>
      obtain ⟨E, hEf, hEle, hEc⟩ := ih
      let F := E.pullback₁ f
      have hEq : F.sieve₀ = Sieve.pullback f E.sieve₀ :=
        Sieve.ofArrows_eq_pullback_of_isPullback (f := E.f)
          (fun i => IsPullback.of_hasPullback f (E.f i))
      exact ⟨F, hEf, hEq ▸ Sieve.pullback_monotone f hEle,
        hEq ▸ (K.toGrothendieck).pullback_stable f hEc⟩
  | @transitive X S R hS hlocal ihS ihlocal =>
      obtain ⟨E, hEf, hEle, hEc⟩ := ihS
      choose F hFfin hFle hFc using
        (fun i => ihlocal (hEle (E.f i) (E.sieve₀_f i)))
      let G := E.bind F
      have hGfin : Finite G.I₀ := by
        show Finite (Σ i : E.I₀, (F i).I₀); infer_instance
      have hGcov : G.sieve₀ ∈ K.toGrothendieck X := by
        have hEq : Sieve.generate (Presieve.bindOfArrows E.X E.f
            (fun i => (F i).presieve₀)) = G.sieve₀ := by
          rw [Presieve.bindOfArrows_ofArrows]; rfl
        exact hEq ▸ (K.toGrothendieck).bindOfArrows hEc hFc
      have hGle : G.sieve₀ ≤ R := by
        rw [PreZeroHypercover.sieve₀, Sieve.generate_le_iff]
        intro Z g hg
        rcases hg with ⟨p⟩
        show R ((F p.1).f p.2 ≫ E.f p.1)
        simpa [Sieve.pullback_apply] using
          hFle p.1 ((F p.1).f p.2) ((F p.1).sieve₀_f p.2)
      exact ⟨G, hGfin, hGle, hGcov⟩

/-- **Deligne's criterion for finitely generated topologies.** Let `C` be a `w`-small category
with fibre products whose topology is generated by a precoverage `K` each of whose covering
families can be presented with a finite index set. Then the site `(C, K.toGrothendieck)` has a
conservative family of points (Stacks 0DW0). -/
theorem Precoverage.hasConservativeFamily_toGrothendieck_of_finite
    {C : Type u₁} [Category.{v₁, u₁} C] [Limits.HasPullbacks C] [_root_.Small.{w} C]
    [LocallySmall.{w} C] (K : Precoverage C) [HasSheafify K.toGrothendieck (Type w)]
    (hbase : ∀ ⦃X : C⦄ ⦃R : Presieve X⦄, R ∈ K X →
      ∃ E : PreZeroHypercover.{w} X, Finite E.I₀ ∧ R = E.presieve₀) :
    K.toGrothendieck.HasConservativeFamily.{w} := by
  have hEnough : GrothendieckTopology.HasEnoughPoints.{w} K.toGrothendieck := by
    apply GrothendieckTopology.hasEnoughPoints_of_exists_finite_refinement
    intro X R hR
    obtain ⟨E, hFinite, hLe, hCover⟩ :=
      finite_refinement_saturate K hbase ((K.mem_toGrothendieck_iff).mp hR)
    let : Fintype E.I₀ := Fintype.ofFinite E.I₀
    let F := E.reindex (Fintype.equivFin E.I₀).symm
    have hReindex : F.sieve₀ = E.sieve₀ := congrArg Sieve.generate (E.presieve₀_reindex _)
    refine ⟨F.I₀, ?_, F.X, F.f, ?_, ?_⟩
    · show Finite (Fin (Fintype.card E.I₀)); infer_instance
    · simpa [hReindex] using hLe
    · simpa [hReindex] using hCover
  exact GrothendieckTopology.HasConservativeFamily.of_hasEnoughPoints _

/-- Having a conservative family of points passes from a dense subsite to the ambient site:
the pushforward along the inclusion is an equivalence on sheaves, so the images of the points of
the subsite still jointly reflect isomorphisms.

The two categories are allowed to live in different universes: the inclusion of a dense subsite
need not be the inclusion of a subcategory in the literal sense, and the only universe the
statement constrains is the one in which the points take values. -/
theorem hasConservativeFamily_of_denseSubsite
    {C : Type u} [Category C] [LocallySmall.{w} C]
    {D : Type u₂} [Category D] [LocallySmall.{w} D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    (G : C ⥤ D) [G.IsCocontinuous J K] [G.IsContinuous J K]
    [G.IsDenseSubsite J K]
    (hJ : J.HasConservativeFamily.{w}) : K.HasConservativeFamily.{w} := by
  obtain ⟨P, hP⟩ := (GrothendieckTopology.hasConservativeFamily_iff_exists J).1 hJ
  let Q : ObjectProperty (GrothendieckTopology.Point.{w} K) :=
    fun Ψ ↦ ∃ Φ : ObjectProperty.FullSubcategory P, Φ.obj.map G K = Ψ
  refine (GrothendieckTopology.hasConservativeFamily_iff_exists K).2
    ⟨Q, ⟨⟨fun {X Y} f hf ↦ ?_⟩⟩⟩
  let Gstar := G.sheafPushforwardContinuous (Type w) J K
  have hGstar : IsIso (Gstar.map f) :=
    (hP.jointlyReflectIsomorphisms_type.isIso_iff _).2 (by
      intro Φ
      let Ψ : ObjectProperty.FullSubcategory Q := ⟨Φ.obj.map G K, ⟨Φ, rfl⟩⟩
      exact ((MorphismProperty.isomorphisms (Type w)).arrow_mk_iso_iff
        (((Functor.mapArrowFunctor _ _).mapIso
          (Φ.obj.sheafFiberMapIso G K (Type w))).app (Arrow.mk f))).1 (hf Ψ))
  exact Functor.ReflectsIsomorphisms.reflects Gstar f

/-- Having a conservative family of points passes from a site to the topology induced on an
equivalent category by an equivalence of categories.

An equivalence exhibits its source, with the induced topology, as a dense subsite of its
target, so this is the previous statement applied to the inverse equivalence. -/
theorem GrothendieckTopology.HasConservativeFamily.of_inducedTopology
    {C : Type u} [Category C] [LocallySmall.{w} C]
    {D : Type u₂} [Category D] [LocallySmall.{w} D]
    (F : C ⥤ D) [F.IsEquivalence] (K : GrothendieckTopology D)
    (hK : K.HasConservativeFamily.{w}) :
    (F.inducedTopology K).HasConservativeFamily.{w} :=
  have _ : F.asEquivalence.symm.functor.IsDenseSubsite K (F.inducedTopology K) :=
    Equivalence.instIsDenseSubsiteInducedTopologyInverseFunctor K F.asEquivalence.symm
  hasConservativeFamily_of_denseSubsite K (F.inducedTopology K)
    F.asEquivalence.symm.functor hK

end CategoryTheory
