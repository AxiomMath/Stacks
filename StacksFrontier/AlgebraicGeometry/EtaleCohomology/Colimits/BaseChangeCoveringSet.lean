attribute [local instance] isDenseSubsite_smallAffineEtaleInclusion

/-! ### Objects of a small affine etale site from affine schemes etale over the base

`Stacks.EtaleCohomology.QcqsLimitCohomology.objOfAffineOpen` turns an affine open of `S` into an
object of the small affine etale site of `S`, and
`Stacks.EtaleCohomology.AffineEtaleTopOneHypercover.objOfOpenOver` turns an affine open of the
scheme of an object into one. Conditions (3) and (4) of Stacks 0GN4 need objects that are neither:
a *closed* subscheme of the scheme of an object, and an affine open of a fibre product which is
not itself an object because it is not affine. The common generalisation is `objOfEtale` below —
any affine scheme of `B` with an etale morphism to `S`, which is all the definition of the site
asks for — and the two existing constructors are its instances.

Everything in this section is about an arbitrary small affine etale site. The raised site of the
system of base changes enters only in the next sections, through `AsSmall`.
-/

section General

variable (B : AlgebraicGeometry.BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **An affine scheme of `B` with an etale morphism to `S` is an object of the small affine etale
site of `S`**, and the morphism is its structure morphism.

The affineness and etaleness are plain arguments rather than instance arguments: the two
conditions are checked at the call sites from data that instance search cannot see, and keeping
them explicit is what makes `toScheme_objOfEtale` and `structMap_objOfEtale` hold by `rfl`. -/
def objOfEtale (P : Scheme.{u}) (hP : B.Contains P) (g : P ⟶ S) (hg : Etale g)
    (hPaff : IsAffine P) : AlgebraicGeometry.SmallAffineEtale B S hS :=
  ⟨⟨Over.mk (ObjectProperty.homMk g : B.obj P hP ⟶ B.obj S hS), hg⟩, hPaff⟩

/-- The scheme underlying `objOfEtale B S hS P hP g hg hPaff` is `P`. -/
@[simp] lemma toScheme_objOfEtale (P : Scheme.{u}) (hP : B.Contains P) (g : P ⟶ S) (hg : Etale g)
    (hPaff : IsAffine P) :
    (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).obj
      (objOfEtale B S hS P hP g hg hPaff) = P := rfl

/-- The structure morphism of `objOfEtale B S hS P hP g hg hPaff` is the given morphism `g`. -/
@[simp] lemma structMap_objOfEtale (P : Scheme.{u}) (hP : B.Contains P) (g : P ⟶ S)
    (hg : Etale g) (hPaff : IsAffine P) :
    structMap B S hS (objOfEtale B S hS P hP g hg hPaff) = g := rfl

/-! ### The small affine etale site inside the slice over `S` -/

/-- An object of the small affine etale site of `S`, read as an object of `Over S`. -/
def overObj (A : AlgebraicGeometry.SmallAffineEtale B S hS) : Over S :=
  Over.mk (structMap B S hS A)

/-- The structure morphism of an object of the small affine etale site is etale. -/
instance etale_structMap (A : AlgebraicGeometry.SmallAffineEtale B S hS) :
    Etale (structMap B S hS A) := A.obj.property

/-- The structure morphism of an object of the small affine etale site is etale, read in
`Over S`. -/
instance etale_overObj_hom (A : AlgebraicGeometry.SmallAffineEtale B S hS) :
    Etale (overObj B S hS A).hom := A.obj.property

/-- The scheme of an object of the small affine etale site, read in `Over S`, is affine. -/
instance isAffine_overObj_left (A : AlgebraicGeometry.SmallAffineEtale B S hS) :
    IsAffine (overObj B S hS A).left :=
  AlgebraicGeometry.SmallAffineEtale.isAffine_toScheme_obj B S hS A

/-- The structure morphism of an object of the small affine etale site is separated, its source
being affine. -/
instance isSeparated_overObj_hom (A : AlgebraicGeometry.SmallAffineEtale B S hS) :
    IsSeparated (overObj B S hS A).hom := inferInstance

/-- A morphism of the small affine etale site of `S`, read as a morphism of `Over S`. -/
def overHom {A A' : AlgebraicGeometry.SmallAffineEtale B S hS} (t : A ⟶ A') :
    overObj B S hS A ⟶ overObj B S hS A' :=
  Over.homMk ((AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map t)
    (toScheme_map_comp_structMap B S hS t)

/-- The morphism of schemes underlying `overHom B S hS t` is the image of `t` under
`AlgebraicGeometry.SmallAffineEtale.toScheme`. -/
@[simp] lemma overHom_left {A A' : AlgebraicGeometry.SmallAffineEtale B S hS} (t : A ⟶ A') :
    (overHom B S hS t).left = (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map t := rfl

/-! ### The equalizer of two parallel morphisms is again an object

The structure morphism of an object is etale, so the diagonal of `A' ⟶ S` is an open immersion
(Stacks 02GE); it is affine, so `A' ⟶ S` is separated and the diagonal is also a closed
immersion. The equalizer of two morphisms into `A'` over `S` is the base change of that diagonal,
hence an open *and* closed immersion into `A`, so its source is affine, is contained in `B` and is
etale over `S`: an object of the site. Both halves are available —
`AlgebraicGeometry.isOpenImmersion_equalizer_ι_left` and Mathlib's
`AlgebraicGeometry.isClosedImmersion_equalizer_ι_left`.

The inclusion and the factorisation are given names with their codomain and domain ascribed
through `AlgebraicGeometry.SmallAffineEtale.toScheme`, rather than left at the `Over S` spelling
`(overObj _).left`. The two are the same scheme, but only definitionally, and instance search does
not see `Etale (structMap _)` at the second spelling.
-/

/-- The inclusion of the equalizer into the scheme of the source. -/
def equalizerι {A A' : AlgebraicGeometry.SmallAffineEtale B S hS} (a b : A ⟶ A') :
    (equalizer (overHom B S hS a) (overHom B S hS b)).left ⟶
      (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).obj A :=
  (equalizer.ι (overHom B S hS a) (overHom B S hS b)).left

/-- **The equalizer of two morphisms into an etale object is an open subscheme of the source**:
the diagonal of an etale morphism is an open immersion. -/
instance isOpenImmersion_equalizerι {A A' : AlgebraicGeometry.SmallAffineEtale B S hS}
    (a b : A ⟶ A') : IsOpenImmersion (equalizerι B S hS a b) :=
  isOpenImmersion_equalizer_ι_left _ _

/-- **The equalizer of two morphisms into a separated object is a closed subscheme of the
source**: the diagonal of a separated morphism is a closed immersion. -/
instance isClosedImmersion_equalizerι {A A' : AlgebraicGeometry.SmallAffineEtale B S hS}
    (a b : A ⟶ A') : IsClosedImmersion (equalizerι B S hS a b) :=
  isClosedImmersion_equalizer_ι_left _ _

/-- **The equalizer of two parallel morphisms of the small affine etale site is again an object of
it.** -/
def equalizerObj {A A' : AlgebraicGeometry.SmallAffineEtale B S hS} (a b : A ⟶ A') :
    AlgebraicGeometry.SmallAffineEtale B S hS :=
  objOfEtale B S hS (equalizer (overHom B S hS a) (overHom B S hS b)).left
    (Scheme.size_lt_of_isClosedImmersion (equalizerι B S hS a b)
      (contains_toScheme_obj B S hS A))
    (equalizerι B S hS a b ≫ structMap B S hS A) inferInstance
    (isAffine_of_isAffineHom (equalizerι B S hS a b))

/-- The scheme underlying `equalizerObj B S hS a b` is the source of the equalizer of `a` and `b`
in `Over S`. -/
@[simp] lemma toScheme_equalizerObj {A A' : AlgebraicGeometry.SmallAffineEtale B S hS}
    (a b : A ⟶ A') :
    (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).obj (equalizerObj B S hS a b) =
      (equalizer (overHom B S hS a) (overHom B S hS b)).left := rfl

/-- The structure morphism of `equalizerObj B S hS a b` is the inclusion `equalizerι B S hS a b`
followed by the structure morphism of `A`. -/
@[simp] lemma structMap_equalizerObj {A A' : AlgebraicGeometry.SmallAffineEtale B S hS}
    (a b : A ⟶ A') :
    structMap B S hS (equalizerObj B S hS a b) =
      equalizerι B S hS a b ≫ structMap B S hS A := rfl

/-- The inclusion of the equalizer into the source, as a morphism of the site. -/
def equalizerHom {A A' : AlgebraicGeometry.SmallAffineEtale B S hS} (a b : A ⟶ A') :
    equalizerObj B S hS a b ⟶ A :=
  homOfSchemeHom B S hS (equalizerι B S hS a b) rfl

/-- The morphism of schemes underlying `equalizerHom B S hS a b` is `equalizerι B S hS a b`. -/
@[simp] lemma toScheme_map_equalizerHom {A A' : AlgebraicGeometry.SmallAffineEtale B S hS}
    (a b : A ⟶ A') :
    (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map (equalizerHom B S hS a b) =
      equalizerι B S hS a b :=
  toScheme_map_homOfSchemeHom B S hS _ _

/-- The inclusion of the equalizer equalizes the two morphisms. -/
lemma equalizerHom_comp {A A' : AlgebraicGeometry.SmallAffineEtale B S hS} (a b : A ⟶ A') :
    equalizerHom B S hS a b ≫ a = equalizerHom B S hS a b ≫ b := by
  apply (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map_injective
  have h := congrArg (Over.forget S).map
    (equalizer.condition (overHom B S hS a) (overHom B S hS b))
  rw [Functor.map_comp, Functor.map_comp] at h
  rw [Functor.map_comp, Functor.map_comp, toScheme_map_equalizerHom]
  exact h

/-- A pair equalized by a morphism of the site is equalized by it in `Over S`. -/
lemma overHom_condition {A A' Zc : AlgebraicGeometry.SmallAffineEtale B S hS} {a b : A ⟶ A'}
    (γ : Zc ⟶ A) (hγ : γ ≫ a = γ ≫ b) :
    overHom B S hS γ ≫ overHom B S hS a = overHom B S hS γ ≫ overHom B S hS b := by
  apply Over.OverMorphism.ext
  simp only [Over.comp_left, overHom_left]
  exact congrArg (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map hγ

/-- The factorisation through the equalizer, as a morphism of schemes. -/
def equalizerιLift {A A' Zc : AlgebraicGeometry.SmallAffineEtale B S hS} {a b : A ⟶ A'}
    (γ : Zc ⟶ A) (hγ : γ ≫ a = γ ≫ b) :
    (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).obj Zc ⟶
      (equalizer (overHom B S hS a) (overHom B S hS b)).left :=
  (equalizer.lift (f := overHom B S hS a) (g := overHom B S hS b) (overHom B S hS γ)
    (overHom_condition B S hS γ hγ)).left

/-- The factorisation `equalizerιLift B S hS γ hγ` followed by `equalizerι B S hS a b` is the
morphism of schemes underlying `γ`. -/
@[simp] lemma equalizerιLift_comp {A A' Zc : AlgebraicGeometry.SmallAffineEtale B S hS}
    {a b : A ⟶ A'} (γ : Zc ⟶ A) (hγ : γ ≫ a = γ ≫ b) :
    equalizerιLift B S hS γ hγ ≫ equalizerι B S hS a b =
      (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map γ := by
  have hι := congrArg (Over.forget S).map
    (equalizer.lift_ι (f := overHom B S hS a) (g := overHom B S hS b) (overHom B S hS γ)
      (overHom_condition B S hS γ hγ))
  rw [Functor.map_comp] at hι
  exact hι

/-- **A morphism equalizing a parallel pair factors through the equalizer**, with no covering
needed: the equalizer is an object of the site, so the universal property applies verbatim. -/
def equalizerLift {A A' Zc : AlgebraicGeometry.SmallAffineEtale B S hS} {a b : A ⟶ A'}
    (γ : Zc ⟶ A) (hγ : γ ≫ a = γ ≫ b) : Zc ⟶ equalizerObj B S hS a b :=
  homOfSchemeHom B S hS (equalizerιLift B S hS γ hγ)
    (by
      have h : equalizerιLift B S hS γ hγ ≫ (equalizerι B S hS a b ≫ structMap B S hS A) =
          structMap B S hS Zc := by
        rw [← Category.assoc, equalizerιLift_comp]
        exact toScheme_map_comp_structMap B S hS γ
      exact h)

/-- The factorisation `equalizerLift B S hS γ hγ` followed by `equalizerHom B S hS a b` is `γ`. -/
@[simp] lemma equalizerLift_comp {A A' Zc : AlgebraicGeometry.SmallAffineEtale B S hS}
    {a b : A ⟶ A'} (γ : Zc ⟶ A) (hγ : γ ≫ a = γ ≫ b) :
    equalizerLift B S hS γ hγ ≫ equalizerHom B S hS a b = γ := by
  apply (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map_injective
  have h1 : (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map
      (equalizerLift B S hS γ hγ) = equalizerιLift B S hS γ hγ :=
    toScheme_map_homOfSchemeHom B S hS _ _
  rw [Functor.map_comp, h1, toScheme_map_equalizerHom]
  exact equalizerιLift_comp B S hS γ hγ


/-! ### The fibre product of two objects, and a finite affine cover of it

The fibre product over `S` of the schemes of two objects need not be affine, so it is not an
object of the site — that is exactly why condition (3) of Stacks 0GN4 asks for a finite *family*.
It is quasi-compact when `S` is quasi-separated: the structure morphism of an object is
quasi-compact, its source being affine and `S` quasi-separated
(`AlgebraicGeometry.quasiCompact_of_compactSpace`), hence so is its base change. It is separated
over the affine scheme of the first object, hence separated, hence quasi-separated. A finite
affine open cover therefore exists, and each of its members is an affine scheme of `B` etale over
`S`, hence an object of the site by `objOfEtale`.
-/

section Product

variable (A A' : AlgebraicGeometry.SmallAffineEtale B S hS)

/-- The fibre product over `S` of the schemes of two objects of the small affine etale site. -/
abbrev prodScheme : Scheme.{u} := pullback (structMap B S hS A) (structMap B S hS A')

/-- The first projection of the fibre product is etale, being a base change of the structure
morphism of the second object. -/
instance etale_pullback_fst_structMap :
    Etale (pullback.fst (structMap B S hS A) (structMap B S hS A')) :=
  have : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) (structMap B S hS A) :=
    MorphismProperty.instIsStableUnderBaseChangeAlongOfIsStableUnderBaseChange
      (@Etale) (structMap B S hS A)
  MorphismProperty.pullback_fst _ _ (etale_structMap B S hS A')

/-- The second projection of the fibre product is etale, being a base change of the structure
morphism of the first object. -/
instance etale_pullback_snd_structMap :
    Etale (pullback.snd (structMap B S hS A) (structMap B S hS A')) :=
  have : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) (structMap B S hS A') :=
    MorphismProperty.instIsStableUnderBaseChangeAlongOfIsStableUnderBaseChange
      (@Etale) (structMap B S hS A')
  MorphismProperty.pullback_snd _ _ (etale_structMap B S hS A)

/-- The first projection of the fibre product is separated, being a base change of the structure
morphism of the second object, which is separated because its source is affine. -/
instance isSeparated_pullback_fst_structMap :
    IsSeparated (pullback.fst (structMap B S hS A) (structMap B S hS A')) :=
  have : MorphismProperty.IsStableUnderBaseChangeAlong (@IsSeparated) (structMap B S hS A) :=
    MorphismProperty.instIsStableUnderBaseChangeAlongOfIsStableUnderBaseChange
      (@IsSeparated) (structMap B S hS A)
  MorphismProperty.pullback_fst _ _ (inferInstance : IsSeparated (structMap B S hS A'))

/-- The fibre product of the schemes of two objects is a separated scheme: it is separated over
the first, which is affine. -/
instance isSeparated_prodScheme : (prodScheme B S hS A A').IsSeparated := by
  constructor
  have h : IsSeparated (pullback.fst (structMap B S hS A) (structMap B S hS A') ≫
      terminal.from ((AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).obj A)) := inferInstance
  rwa [terminal.comp_from] at h

/-- The fibre product of the schemes of two objects is quasi-compact when `S` is quasi-separated:
the structure morphism of the second object is quasi-compact, hence so is the first projection,
and the scheme of the first object is affine. -/
instance compactSpace_prodScheme [QuasiSeparatedSpace S] :
    CompactSpace (prodScheme B S hS A A') :=
  have : MorphismProperty.IsStableUnderBaseChangeAlong (@QuasiCompact) (structMap B S hS A) :=
    MorphismProperty.instIsStableUnderBaseChangeAlongOfIsStableUnderBaseChange
      (@QuasiCompact) (structMap B S hS A)
  have : QuasiCompact (pullback.fst (structMap B S hS A) (structMap B S hS A')) :=
    MorphismProperty.pullback_fst _ _ (inferInstance : QuasiCompact (structMap B S hS A'))
  QuasiCompact.compactSpace_of_compactSpace
    (pullback.fst (structMap B S hS A) (structMap B S hS A'))

/-- **A finite affine open cover of the fibre product of two objects**, indexed by `Fin m`, which
is the indexing condition (3) of Stacks 0GN4 asks for. -/
theorem exists_finite_affineOpen_cover_prodScheme [CompactSpace S] [QuasiSeparatedSpace S] :
    ∃ (m : ℕ) (O : Fin m → (prodScheme B S hS A A').Opens),
      (∀ i, AlgebraicGeometry.IsAffineOpen (O i)) ∧
        ∀ x : prodScheme B S hS A A', ∃ i, x ∈ O i := by
  classical
  obtain ⟨κ, ν, hκ, hν, O, V, hOaff, hVaff, hOtop, hVle, hVsup⟩ :=
    Stacks.QcqsOneHypercover.exists_finite_affine_oneHypercover_opens (prodScheme B S hS A A')
  have : Finite κ := hκ
  let e : κ ≃ Fin (Nat.card κ) := Finite.equivFin κ
  refine ⟨Nat.card κ, fun i => O (e.symm i), fun i => hOaff _, fun x => ?_⟩
  have hx : x ∈ (⊤ : (prodScheme B S hS A A').Opens) := trivial
  rw [← hOtop] at hx
  obtain ⟨k, hk⟩ := TopologicalSpace.Opens.mem_iSup.1 hx
  refine ⟨e k, ?_⟩
  simpa only [e.symm_apply_apply] using hk

/-- **The object of the site attached to an affine open of the fibre product of two objects.** -/
def prodObj (O : (prodScheme B S hS A A').Opens) (hO : AlgebraicGeometry.IsAffineOpen O) :
    AlgebraicGeometry.SmallAffineEtale B S hS :=
  objOfEtale B S hS (O : Scheme.{u})
    (Scheme.size_lt_of_isOpenImmersion O.ι
      (Scheme.size_pullback_lt _ _ (contains_toScheme_obj B S hS A)
        (contains_toScheme_obj B S hS A')))
    (O.ι ≫ pullback.fst (structMap B S hS A) (structMap B S hS A') ≫ structMap B S hS A)
    (have : IsAffine (O : Scheme.{u}) := hO; inferInstance) hO

/-- The scheme underlying `prodObj B S hS A A' O hO` is the open subscheme `O`. -/
@[simp] lemma toScheme_prodObj (O : (prodScheme B S hS A A').Opens)
    (hO : AlgebraicGeometry.IsAffineOpen O) :
    (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).obj (prodObj B S hS A A' O hO) =
      (O : Scheme.{u}) := rfl

/-- The structure morphism of `prodObj B S hS A A' O hO` is the inclusion of `O`, followed by the
first projection and the structure morphism of `A`. -/
@[simp] lemma structMap_prodObj (O : (prodScheme B S hS A A').Opens)
    (hO : AlgebraicGeometry.IsAffineOpen O) :
    structMap B S hS (prodObj B S hS A A' O hO) =
      O.ι ≫ pullback.fst (structMap B S hS A) (structMap B S hS A') ≫ structMap B S hS A := rfl

/-- The first projection of the object attached to an affine open of the fibre product. -/
def prodObjFst (O : (prodScheme B S hS A A').Opens) (hO : AlgebraicGeometry.IsAffineOpen O) :
    prodObj B S hS A A' O hO ⟶ A :=
  homOfSchemeHom B S hS (O.ι ≫ pullback.fst (structMap B S hS A) (structMap B S hS A'))
    (by
      have h : (O.ι ≫ pullback.fst (structMap B S hS A) (structMap B S hS A')) ≫
            structMap B S hS A =
          O.ι ≫ pullback.fst (structMap B S hS A) (structMap B S hS A') ≫
            structMap B S hS A := Category.assoc _ _ _
      exact h)

/-- The second projection of the object attached to an affine open of the fibre product. -/
def prodObjSnd (O : (prodScheme B S hS A A').Opens) (hO : AlgebraicGeometry.IsAffineOpen O) :
    prodObj B S hS A A' O hO ⟶ A' :=
  homOfSchemeHom B S hS (O.ι ≫ pullback.snd (structMap B S hS A) (structMap B S hS A'))
    (by
      have h : (O.ι ≫ pullback.snd (structMap B S hS A) (structMap B S hS A')) ≫
            structMap B S hS A' =
          O.ι ≫ pullback.fst (structMap B S hS A) (structMap B S hS A') ≫
            structMap B S hS A := by
        rw [Category.assoc, ← pullback.condition]
      exact h)

/-- The morphism of schemes underlying `prodObjFst B S hS A A' O hO` is the inclusion of `O`
followed by the first projection. -/
@[simp] lemma toScheme_map_prodObjFst (O : (prodScheme B S hS A A').Opens)
    (hO : AlgebraicGeometry.IsAffineOpen O) :
    (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map (prodObjFst B S hS A A' O hO) =
      O.ι ≫ pullback.fst (structMap B S hS A) (structMap B S hS A') :=
  toScheme_map_homOfSchemeHom B S hS _ _

/-- The morphism of schemes underlying `prodObjSnd B S hS A A' O hO` is the inclusion of `O`
followed by the second projection. -/
@[simp] lemma toScheme_map_prodObjSnd (O : (prodScheme B S hS A A').Opens)
    (hO : AlgebraicGeometry.IsAffineOpen O) :
    (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map (prodObjSnd B S hS A A' O hO) =
      O.ι ≫ pullback.snd (structMap B S hS A) (structMap B S hS A') :=
  toScheme_map_homOfSchemeHom B S hS _ _

/-- A pair of morphisms of the site out of a common source induces a morphism of schemes into the
fibre product, the two having the same composite with the structure morphisms. -/
def prodLiftScheme {Zc : AlgebraicGeometry.SmallAffineEtale B S hS} (α : Zc ⟶ A) (β : Zc ⟶ A') :
    (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).obj Zc ⟶ prodScheme B S hS A A' :=
  pullback.lift ((AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map α)
    ((AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map β)
    ((toScheme_map_comp_structMap B S hS α).trans
      (toScheme_map_comp_structMap B S hS β).symm)

/-- The morphism `prodLiftScheme B S hS A A' α β` followed by the first projection is the morphism
of schemes underlying `α`. -/
@[simp] lemma prodLiftScheme_fst {Zc : AlgebraicGeometry.SmallAffineEtale B S hS} (α : Zc ⟶ A)
    (β : Zc ⟶ A') :
    prodLiftScheme B S hS A A' α β ≫ pullback.fst (structMap B S hS A) (structMap B S hS A') =
      (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map α :=
  pullback.lift_fst _ _ _

/-- The morphism `prodLiftScheme B S hS A A' α β` followed by the second projection is the
morphism of schemes underlying `β`. -/
@[simp] lemma prodLiftScheme_snd {Zc : AlgebraicGeometry.SmallAffineEtale B S hS} (α : Zc ⟶ A)
    (β : Zc ⟶ A') :
    prodLiftScheme B S hS A A' α β ≫ pullback.snd (structMap B S hS A) (structMap B S hS A') =
      (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map β :=
  pullback.lift_snd _ _ _

/-- **Condition (3) of Stacks 0GN4, at the level of the site.** There are finitely many objects
`V i` with morphisms to `A` and to `A'` such that every pair of morphisms `α : Zc ⟶ A`,
`β : Zc ⟶ A'` factors through one of them over a neighbourhood of any given point of `Zc`.

The `V i` are the objects attached to a finite affine open cover of the fibre product; the pair
`(α, β)` induces a morphism `Zc ⟶ A ×_S A'` of schemes, and over an affine open of `Zc` inside
the preimage of a member of the cover the lift along the open immersion is the required
factorisation. -/
theorem exists_prodCover_factorization [CompactSpace S] [QuasiSeparatedSpace S] :
    ∃ (m : ℕ) (V : Fin m → AlgebraicGeometry.SmallAffineEtale B S hS)
      (p : ∀ i, V i ⟶ A) (q : ∀ i, V i ⟶ A'),
      ∀ (Zc : AlgebraicGeometry.SmallAffineEtale B S hS) (α : Zc ⟶ A) (β : Zc ⟶ A')
        (z : (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).obj Zc),
        ∃ (i : Fin m) (W : AlgebraicGeometry.SmallAffineEtale B S hS) (w : W ⟶ Zc)
          (r : W ⟶ V i), r ≫ p i = w ≫ α ∧ r ≫ q i = w ≫ β ∧
            z ∈ Set.range ((AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map w) := by
  classical
  obtain ⟨m, O, hOaff, hOcov⟩ := exists_finite_affineOpen_cover_prodScheme B S hS A A'
  refine ⟨m, fun i => prodObj B S hS A A' (O i) (hOaff i), fun i => prodObjFst B S hS A A' _ _,
    fun i => prodObjSnd B S hS A A' _ _, ?_⟩
  intro Zc α β z
  obtain ⟨i, hi⟩ := hOcov ((prodLiftScheme B S hS A A' α β).base z)
  -- an affine open of the scheme of `Zc` through `z` inside the preimage of `O i`
  obtain ⟨Wo, hWoaff, hzWo, hWole⟩ :
      ∃ Wo : ((AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).obj Zc).Opens,
        AlgebraicGeometry.IsAffineOpen Wo ∧ z ∈ Wo ∧
          Wo ≤ (prodLiftScheme B S hS A A' α β) ⁻¹ᵁ O i := by
    have hbasis :=
      ((AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).obj Zc).isBasis_affineOpens
    obtain ⟨-, ⟨Wo, hWo, rfl⟩, hzWo, hsub⟩ :=
      hbasis.exists_subset_of_mem_open
        (show z ∈ ((prodLiftScheme B S hS A A' α β) ⁻¹ᵁ O i : Scheme.Opens _) from hi)
        ((prodLiftScheme B S hS A A' α β) ⁻¹ᵁ O i).isOpen
    exact ⟨Wo, hWo, hzWo, hsub⟩
  have hrange : Set.range (Wo.ι ≫ prodLiftScheme B S hS A A' α β) ⊆ Set.range (O i).ι := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro - ⟨x, rfl⟩
    exact hWole x.2
  set ρ : (Wo : Scheme.{u}) ⟶ ((O i : Scheme.{u})) :=
    AlgebraicGeometry.IsOpenImmersion.lift (O i).ι
      (Wo.ι ≫ prodLiftScheme B S hS A A' α β) hrange with hρ
  have hρfac : ρ ≫ (O i).ι = Wo.ι ≫ prodLiftScheme B S hS A A' α β :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hrange
  have hw : Wo.ι ≫ structMap B S hS Zc = structMap B S hS (objOfOpenOver B S hS Zc Wo hWoaff) :=
    (structMap_objOfOpenOver B S hS Zc Wo hWoaff).symm
  have hfst : (Wo.ι ≫ prodLiftScheme B S hS A A' α β) ≫
      (pullback.fst (structMap B S hS A) (structMap B S hS A') ≫ structMap B S hS A) =
      Wo.ι ≫ structMap B S hS Zc := by
    rw [Category.assoc, ← Category.assoc (prodLiftScheme B S hS A A' α β), prodLiftScheme_fst]
    exact congrArg (fun t => Wo.ι ≫ t) (toScheme_map_comp_structMap B S hS α)
  have hρst : ρ ≫ structMap B S hS (prodObj B S hS A A' (O i) (hOaff i)) =
      structMap B S hS (objOfOpenOver B S hS Zc Wo hWoaff) := by
    rw [structMap_objOfOpenOver]
    have h : ρ ≫ ((O i).ι ≫ pullback.fst (structMap B S hS A) (structMap B S hS A') ≫
          structMap B S hS A) = Wo.ι ≫ structMap B S hS Zc := by
      rw [← Category.assoc, hρfac]
      exact hfst
    exact h
  have hproj : ∀ {C : Scheme.{u}} (π : prodScheme B S hS A A' ⟶ C),
      ρ ≫ (O i).ι ≫ π = Wo.ι ≫ prodLiftScheme B S hS A A' α β ≫ π := fun π => by
    rw [← Category.assoc, hρfac, Category.assoc]
  have hmapw : (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map
      (homOfSchemeHom B S hS (Z := objOfOpenOver B S hS Zc Wo hWoaff) (W := Zc) Wo.ι hw) =
      Wo.ι := toScheme_map_homOfSchemeHom B S hS _ _
  have hmapρ : (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map
      (homOfSchemeHom B S hS (Z := objOfOpenOver B S hS Zc Wo hWoaff)
        (W := prodObj B S hS A A' (O i) (hOaff i)) ρ hρst) = ρ :=
    toScheme_map_homOfSchemeHom B S hS _ _
  refine ⟨i, objOfOpenOver B S hS Zc Wo hWoaff,
    homOfSchemeHom B S hS (Z := objOfOpenOver B S hS Zc Wo hWoaff) (W := Zc) Wo.ι hw,
    homOfSchemeHom B S hS (Z := objOfOpenOver B S hS Zc Wo hWoaff)
      (W := prodObj B S hS A A' (O i) (hOaff i)) ρ hρst, ?_, ?_, ?_⟩
  · apply (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map_injective
    rw [Functor.map_comp, Functor.map_comp, toScheme_map_prodObjFst, hmapρ, hmapw]
    exact (hproj (pullback.fst _ _)).trans
      (congrArg (Wo.ι ≫ ·) (prodLiftScheme_fst B S hS A A' _ _))
  · apply (AlgebraicGeometry.SmallAffineEtale.toScheme B S hS).map_injective
    rw [Functor.map_comp, Functor.map_comp, toScheme_map_prodObjSnd, hmapρ, hmapw]
    exact (hproj (pullback.snd _ _)).trans
      (congrArg (Wo.ι ≫ ·) (prodLiftScheme_snd B S hS A A' _ _))
  · rw [hmapw]
    exact ⟨⟨z, hzWo⟩, rfl⟩

end Product

end General

variable {I : Type u} [Preorder I] [Nonempty I] [IsDirected I (· ≤ ·)]
  (T : Scheme.{u}) (X : Over T) (Z : Iᵒᵖ ⥤ Over T)
  [IsAffine T] [∀ i, IsAffine (Z.obj i).left]

/-! ### The limit of the system of base changes is quasi-compact and quasi-separated

Quasi-compactness of the levels is `compactSpace_baseChange_obj`. The levels are
quasi-separated for the same reason — the projection `Y_i ⟶ Z_i` is the base change of `X ⟶ T`
and `Z_i` is affine — and the limit inherits both from any level, the legs of the limit cone of a
directed system with affine transitions being affine.
-/

omit [Nonempty I] [IsDirected I (· ≤ ·)] [IsAffine T] in
/-- **Every level of the system of base changes is a quasi-separated scheme** when `X ⟶ T` is
quasi-separated: the projection `Y_i ⟶ Z_i` is quasi-separated and `Z_i` is affine, hence a
quasi-separated scheme. This is the exact mirror of `compactSpace_baseChange_obj`. -/
instance quasiSeparatedSpace_baseChange_obj [QuasiSeparated X.hom] (i : Iᵒᵖ) :
    QuasiSeparatedSpace ((baseChange T X Z).obj i) :=
  have : QuasiSeparatedSpace ((Z.obj i).left : Scheme.{u}) := inferInstance
  @AlgebraicGeometry.quasiSeparatedSpace_of_quasiSeparated _ _ _ _
    (quasiSeparated_baseChange_fst T X Z i)

variable (cY : Cone (baseChange T X Z)) (hcY : IsLimit cY)

include hcY in
/-- **The limit `Y` of the system of base changes is a quasi-compact scheme** when `X ⟶ T` is
quasi-compact: the transitions of the system are affine (`isAffineHom_baseChange_map'`), so the
legs of the limit cone are affine, and the levels are quasi-compact. -/
@[ega "III 6.9.4" "more general"]
theorem compactSpace_limit_baseChange [QuasiCompact X.hom] : CompactSpace cY.pt :=
  AlgebraicGeometry.Scheme.compactSpace_of_isLimit (baseChange T X Z) cY hcY

include hcY in
/-- **The limit `Y` of the system of base changes is a quasi-separated scheme** when `X ⟶ T` is
quasi-separated: a leg `Y ⟶ Y_i` of the limit cone is affine, hence separated, hence
quasi-separated, and `Y_i` is quasi-separated. -/
theorem quasiSeparatedSpace_limit_baseChange [QuasiSeparated X.hom] :
    QuasiSeparatedSpace cY.pt := by
  obtain ⟨i⟩ : Nonempty Iᵒᵖ := inferInstance
  have : IsAffineHom (cY.π.app i) :=
    AlgebraicGeometry.isAffineHom_π_app (baseChange T X Z) cY hcY i
  exact AlgebraicGeometry.quasiSeparatedSpace_of_quasiSeparated (cY.π.app i)

variable (B : AlgebraicGeometry.BigEtaleSite.{u})
  (hD : ∀ i, B.Contains ((baseChange T X Z).obj i)) (hY : B.Contains cY.pt)

/-! ### The candidate covering set -/

/-- **The candidate covering set of Stacks 0GN3 on the colimit site of the system of base
changes**: the finite coproducts `∐_{i = 1, …, n} h_{U_i}^♯` of sheafified representables of
objects `U_i` of that site, with no restriction on the `U_i`.

The collection of objects is `Set.univ` rather than a sub-collection, and that is forced by
condition (2) of Stacks 0GN4: the refinement of an etale covering has etale sources, so a
collection closed under the refinements it must admit is the collection of all objects. See the
module documentation for why the Zariski collection — the objects attached to the affine opens of
`Y` — fails that condition and with it hypothesis (2) of Stacks 0GN3. -/
def bcCoveringSet :
    Set (Sheaf (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck (Type (u + 1))) :=
  FiniteCoproductSheafifiedYoneda (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck Set.univ

/-! ### Condition (2) of Stacks 0GN4: finite refinements -/

/-- A covering sieve generated by a family downstairs lifts to a covering sieve of the raised
site, the family being lifted by `ULift.up`. -/
private theorem ofArrows_up_mem_toGrothendieck {C : Type*} [Category C] (P : Precoverage C)
    {W : AsSmall C} {ι : Type*} (Bj : ι → C) (fj : ∀ j, Bj j ⟶ AsSmall.down.obj W)
    (h : Sieve.ofArrows Bj fj ∈ P.toGrothendieck (AsSmall.down.obj W)) :
    Sieve.ofArrows (fun j => AsSmall.up.obj (Bj j))
        (fun j => (⟨fj j⟩ : AsSmall.up.obj (Bj j) ⟶ W)) ∈
      (P.comap (AsSmall.down : AsSmall C ⥤ C)).toGrothendieck W := by
  refine (CategoryTheory.AsSmall.mem_comap_toGrothendieck_iff P _).mpr ?_
  refine GrothendieckTopology.superset_covering _ ?_ h
  intro Y' f hf
  obtain ⟨A₀, a₀, q₀, hq₀, rfl⟩ := hf
  obtain ⟨j⟩ := hq₀
  exact ⟨AsSmall.up.obj (Bj j), ⟨fj j⟩, a₀, Sieve.ofArrows_mk _ _ j, rfl⟩

omit [Nonempty I] [IsDirected I (· ≤ ·)] in
include hcY in
/-- **Condition (2) of Stacks 0GN4 on the colimit site of the system of base changes.** Every
covering sieve of every object of the site is refined by a finite covering family — necessarily
with sources in `Set.univ`.

The coverings of the small affine etale site are finite by definition, so this is
`AlgebraicGeometry.finite_refinement_smallAffineEtale` for the site of `Y`, transported across
the universe raise: a sieve of the raised site is covering exactly when its image under
`AsSmall.down` is (`CategoryTheory.AsSmall.mem_comap_toGrothendieck_iff`), and a morphism of the
raised site is a `ULift` of a morphism downstairs, so the refining family is lifted with no
`eqToHom`. -/
theorem bcHasFiniteCoverRefinements_univ (W : bcLimitSiteGen T X Z cY hcY B hD hY) :
    HasFiniteCoverRefinementsFrom (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck
      (Set.univ : Set (bcLimitSiteGen T X Z cY hcY B hD hY)) W := by
  classical
  intro S hS
  have hS' : S.functorPushforward AsSmall.down ∈
      AlgebraicGeometry.SmallAffineEtale.topology B cY.pt hY (AsSmall.down.obj W) :=
    (CategoryTheory.AsSmall.mem_comap_toGrothendieck_iff
      (AlgebraicGeometry.SmallAffineEtale.precoverage B cY.pt hY) S).mp hS
  obtain ⟨E, hfin, hle, hcov⟩ :=
    AlgebraicGeometry.finite_refinement_smallAffineEtale B cY.pt hY hS'
  have : Finite E.I₀ := hfin
  let r : Fin (Nat.card E.I₀) ≃ E.I₀ := (Finite.equivFin E.I₀).symm
  let E' := E.reindex r
  have hE' : E'.sieve₀ = E.sieve₀ := congrArg Sieve.generate (E.presieve₀_reindex r)
  refine ⟨Nat.card E.I₀, fun i => AsSmall.up.obj (E'.X i),
    fun i => ⟨E'.f i⟩, fun _ => Set.mem_univ _, ?_, ?_⟩
  · exact ofArrows_up_mem_toGrothendieck _ E'.X E'.f
      (hE'.symm ▸ hcov : E'.sieve₀ ∈ _)
  · rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
    intro i
    obtain ⟨Zc, gg, hh, hgg, heq⟩ := hle _ (hE' ▸ E'.sieve₀_f i)
    have hfac : (⟨E'.f i⟩ : AsSmall.up.obj (E'.X i) ⟶ W) =
        (⟨hh⟩ : AsSmall.up.obj (E'.X i) ⟶ Zc) ≫ gg := ULift.ext heq
    rw [hfac]
    exact S.downward_closed hgg _

/-! ### Hypothesis (5) of Stacks 0GN3: quasi-compactness of the members of `S` -/

omit [Nonempty I] [IsDirected I (· ≤ ·)] in
include hcY in
/-- **Hypothesis (5) of Stacks 0GN3 for `bcCoveringSet`.** Every finite coproduct of sheafified
representables of objects of the colimit site is a quasi-compact sheaf.

This is condition (2) above fed to the general statement
`Stacks.Cohomology.ColimitsOfCohomology.isQuasiCompact_of_finiteCoproductSheafifiedYoneda`, which
is Stacks 0GN4's quasi-compactness assertion: condition (2) makes each object quasi-compact as an
object of the site, hence each `h_U^♯` quasi-compact as a sheaf, and a finite coproduct of
quasi-compact sheaves is quasi-compact. -/
theorem isQuasiCompact_mem_bcCoveringSet
    {K : Sheaf (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck (Type (u + 1))}
    (hK : K ∈ bcCoveringSet T X Z cY hcY B hD hY) :
    Sheaf.IsQuasiCompact K :=
  isQuasiCompact_of_finiteCoproductSheafifiedYoneda
    (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck Set.univ
    (fun W _ => bcHasFiniteCoverRefinements_univ T X Z cY hcY B hD hY W) hK

/-! ### Condition (1) of Stacks 0GN4: covering the final sheaf -/

include hcY in
/-- **Condition (1) of Stacks 0GN4 on the colimit site of the system of base changes.** There are
finitely many objects `U_1, …, U_m` of the colimit site for which
`∐_i h_{U_i}^♯ ⟶ *` is surjective.

The objects are those attached to a finite affine open cover of `Y`, which exists because `Y` is
a quasi-compact quasi-separated scheme (`compactSpace_limit_baseChange`,
`quasiSeparatedSpace_limit_baseChange`). That they cover the final sheaf is the `coversTop` field
of `Stacks.EtaleCohomology.AffineEtaleTopOneHypercover.exists_finite_isTopOneHypercover`, read at
the small model `AsSmall.down` of the small affine etale site of `Y`; the passage from a covering
sieve of objects to local surjectivity out of the coproduct is
`CategoryTheory.Sheaf.isLocallySurjective_sigmaDesc_of_exists_section`, whose compatibility
condition is free, the sections of the final sheaf being a subsingleton. -/
theorem bcCoversTop_univ [QuasiCompact X.hom] [QuasiSeparated X.hom] :
    ∃ (m : ℕ) (U : Fin m → bcLimitSiteGen T X Z cY hcY B hD hY),
      (∀ i, U i ∈ (Set.univ : Set (bcLimitSiteGen T X Z cY hcY B hD hY))) ∧
        Sheaf.IsLocallySurjective
          (Sigma.desc fun i => terminal.from
            ((Sheaf.sheafifiedYoneda
              (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck).obj (U i))) := by
  classical
  have : CompactSpace cY.pt := compactSpace_limit_baseChange T X Z cY hcY
  have : QuasiSeparatedSpace cY.pt := quasiSeparatedSpace_limit_baseChange T X Z cY hcY
  have : (AsSmall.down : bcLimitSiteGen T X Z cY hcY B hD hY ⥤
      AlgebraicGeometry.SmallAffineEtale B cY.pt hY).IsEquivalence :=
    CategoryTheory.Precoverage.isEquivalence_of_surjective_obj _
      CategoryTheory.AsSmall.surjective_down_obj
  have : (AsSmall.down : bcLimitSiteGen T X Z cY hcY B hD hY ⥤
      AlgebraicGeometry.SmallAffineEtale B cY.pt hY).IsDenseSubsite
      (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck
      (AlgebraicGeometry.SmallAffineEtale.topology B cY.pt hY) :=
    CategoryTheory.AsSmall.isDenseSubsite_down
      (AlgebraicGeometry.SmallAffineEtale.precoverage B cY.pt hY)
  obtain ⟨κ, ν, hκ, hν, W, P, p₁, p₂, hTop⟩ :=
    exists_finite_isTopOneHypercover B cY.pt hY
      (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck AsSmall.down
  have : Finite κ := hκ
  let e : κ ≃ Fin (Nat.card κ) := Finite.equivFin κ
  refine ⟨Nat.card κ, fun i => W (e.symm i), fun _ => Set.mem_univ _, ?_⟩
  refine Sheaf.isLocallySurjective_sigmaDesc_of_exists_section _ ?_
  intro V s
  refine ⟨Sieve.ofObjects (fun i => W (e.symm i)) V, ?_, ?_⟩
  · refine GrothendieckTopology.superset_covering _ ?_ (hTop.coversTop V)
    intro V' g hg
    obtain ⟨k, hk⟩ := (Sieve.mem_ofObjects_iff _ _).1 hg
    refine (Sieve.mem_ofObjects_iff _ _).2 ⟨e k, ?_⟩
    rw [e.symm_apply_apply]
    exact hk
  · intro V' g hg
    obtain ⟨i, ⟨h⟩⟩ := (Sieve.mem_ofObjects_iff _ _).1 hg
    refine ⟨i, ((Sheaf.sheafifiedYoneda
      (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck).obj (W (e.symm i))).obj.map h.op
      (Sheaf.tautologicalSection _ (W (e.symm i))), ?_⟩
    exact (Sheaf.subsingleton_terminalSheaf_obj
      (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck V').elim _ _

/-! ### Covering sieves of the raised site from jointly surjective families -/

omit [Nonempty I] [IsDirected I (· ≤ ·)] in
include hcY in
/-- **A jointly surjective family of objects over an object of the colimit site generates a
covering sieve of it.** The family is given downstairs, on the small affine etale site of `Y`; its
image under the universe raise generates the sieve.

Downstairs this is `AlgebraicGeometry.SmallEtale.mem_topology_of_jointlySurjective` read across
the dense subsite `AlgebraicGeometry.SmallAffineEtale.inclusion`, as in
`Stacks.EtaleCohomology.AffineEtaleTopOneHypercover.ofObjects_mem_topology_of_mem`; the passage up
the raise is `CategoryTheory.AsSmall.mem_comap_toGrothendieck_iff`, a morphism of the raised site
being a `ULift` of a morphism downstairs. -/
theorem mem_toGrothendieck_ofArrows_up {W : bcLimitSiteGen T X Z cY hcY B hD hY} {ι : Type*}
    (Bj : ι → AlgebraicGeometry.SmallAffineEtale B cY.pt hY)
    (fj : ∀ j, Bj j ⟶ AsSmall.down.obj W)
    (hsurj : ∀ x : (AlgebraicGeometry.SmallAffineEtale.toScheme B cY.pt hY).obj
        (AsSmall.down.obj W),
      ∃ j, x ∈ Set.range
        ((AlgebraicGeometry.SmallAffineEtale.toScheme B cY.pt hY).map (fj j))) :
    Sieve.ofArrows (fun j => AsSmall.up.obj (Bj j))
        (fun j => (⟨fj j⟩ : AsSmall.up.obj (Bj j) ⟶ W)) ∈
      (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck W := by
  have hdown : Sieve.ofArrows Bj fj ∈
      AlgebraicGeometry.SmallAffineEtale.topology B cY.pt hY (AsSmall.down.obj W) := by
    rw [← Functor.IsDenseSubsite.functorPushforward_mem_iff
      (J := AlgebraicGeometry.SmallAffineEtale.topology B cY.pt hY)
      (K := AlgebraicGeometry.SmallEtale.topology B cY.pt hY)
      (G := AlgebraicGeometry.SmallAffineEtale.inclusion B cY.pt hY)]
    refine AlgebraicGeometry.SmallEtale.mem_topology_of_jointlySurjective ?_
    intro x
    obtain ⟨j, hj⟩ := hsurj x
    refine ⟨(AlgebraicGeometry.SmallAffineEtale.inclusion B cY.pt hY).obj (Bj j),
      (AlgebraicGeometry.SmallAffineEtale.inclusion B cY.pt hY).map (fj j), ?_, hj⟩
    exact ⟨Bj j, fj j, 𝟙 _, Sieve.ofArrows_mk _ _ j, (Category.id_comp _).symm⟩
  exact ofArrows_up_mem_toGrothendieck _ Bj fj hdown

/-! ### Condition (4) of Stacks 0GN4: equalizers -/

omit [Nonempty I] [IsDirected I (· ≤ ·)] in
include hcY in
/-- **Condition (4) of Stacks 0GN4 on the colimit site of the system of base changes.** For every
parallel pair `a, b : U ⟶ U'` of the colimit site there is a *single* object `V` with a morphism
to `U` equalizing the pair for which `h_V^♯ ⟶ Equalizer(h_a^♯, h_b^♯)` is surjective.

The object is `equalizerObj`, the equalizer of the pair taken in `Over Y`: it is an open and
closed subscheme of the affine scheme of `U`, hence affine, contained in `B` and etale over `Y`.
No covering is involved — the sieve exhibited is `⊤` — because an equalizing morphism factors
through it by the universal property, `equalizerLift`.

No quasi-compactness and no quasi-separatedness of anything is used. -/
theorem bcEqualizer_univ {U U' : bcLimitSiteGen T X Z cY hcY B hD hY} (a b : U ⟶ U')
    (_hU : U ∈ (Set.univ : Set (bcLimitSiteGen T X Z cY hcY B hD hY)))
    (_hU' : U' ∈ (Set.univ : Set (bcLimitSiteGen T X Z cY hcY B hD hY))) :
    ∃ (m : ℕ) (V : Fin m → bcLimitSiteGen T X Z cY hcY B hD hY),
      (∀ i, V i ∈ (Set.univ : Set (bcLimitSiteGen T X Z cY hcY B hD hY))) ∧
        ∃ (p : ∀ i, V i ⟶ U) (hp : ∀ i, p i ≫ a = p i ≫ b),
        Sheaf.IsLocallySurjective (Sigma.desc fun i =>
          equalizer.lift
            (f := (Sheaf.sheafifiedYoneda
              (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck).map a)
            (g := (Sheaf.sheafifiedYoneda
              (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck).map b)
            ((Sheaf.sheafifiedYoneda
              (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck).map (p i)) (by
              simpa only [Functor.map_comp] using
                congrArg (Sheaf.sheafifiedYoneda
                  (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck).map (hp i))) := by
  refine ⟨1, fun _ => AsSmall.up.obj
      (equalizerObj B cY.pt hY (AsSmall.down.map a) (AsSmall.down.map b)),
    fun _ => Set.mem_univ _,
    fun _ => ⟨equalizerHom B cY.pt hY (AsSmall.down.map a) (AsSmall.down.map b)⟩,
    fun _ => ULift.ext (equalizerHom_comp B cY.pt hY _ _), ?_⟩
  refine Sheaf.isLocallySurjective_sigmaDesc_equalizerLift_of_exists_covering a b _ _
    (fun _ => ULift.ext (equalizerHom_comp B cY.pt hY _ _)) ?_
  intro Y' α hα
  refine ⟨⊤, (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck.top_mem Y', ?_⟩
  intro Zc g _
  have hγ : AsSmall.down.map (g ≫ α) ≫ AsSmall.down.map a =
      AsSmall.down.map (g ≫ α) ≫ AsSmall.down.map b := by
    rw [← AsSmall.down.map_comp, ← AsSmall.down.map_comp, Category.assoc, Category.assoc, hα]
  refine ⟨0, ⟨equalizerLift B cY.pt hY (AsSmall.down.map (g ≫ α)) hγ⟩, ?_⟩
  exact ULift.ext (equalizerLift_comp B cY.pt hY (AsSmall.down.map (g ≫ α)) hγ)

/-! ### Condition (3) of Stacks 0GN4: products -/

include hcY in
/-- **Condition (3) of Stacks 0GN4 on the colimit site of the system of base changes.** For any
two objects `U`, `U'` of the colimit site there are finitely many objects `V_i` with morphisms to
both for which `∐_i h_{V_i}^♯ ⟶ h_U^♯ ⨯ h_{U'}^♯` is surjective.

The `V_i` are the objects attached to a finite affine open cover of the fibre product
`U ×_Y U'` of schemes, which exists because `Y` is quasi-compact and quasi-separated
(`exists_prodCover_factorization`); a pair of morphisms into `U` and `U'` induces a morphism into
that fibre product, and over an affine open of the source inside the preimage of a member of the
cover it factors. The resulting family of affine opens of the source is jointly surjective, hence
generates a covering sieve by `mem_toGrothendieck_ofArrows_up`. -/
theorem bcProduct_univ [QuasiCompact X.hom] [QuasiSeparated X.hom]
    (U : bcLimitSiteGen T X Z cY hcY B hD hY)
    (_hU : U ∈ (Set.univ : Set (bcLimitSiteGen T X Z cY hcY B hD hY)))
    (U' : bcLimitSiteGen T X Z cY hcY B hD hY)
    (_hU' : U' ∈ (Set.univ : Set (bcLimitSiteGen T X Z cY hcY B hD hY))) :
    ∃ (m : ℕ) (V : Fin m → bcLimitSiteGen T X Z cY hcY B hD hY),
      (∀ i, V i ∈ (Set.univ : Set (bcLimitSiteGen T X Z cY hcY B hD hY))) ∧
        ∃ (p : ∀ i, V i ⟶ U) (q : ∀ i, V i ⟶ U'),
        Sheaf.IsLocallySurjective (Sigma.desc fun i =>
          prod.lift
            ((Sheaf.sheafifiedYoneda
              (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck).map (p i))
            ((Sheaf.sheafifiedYoneda
              (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck).map (q i))) := by
  classical
  have : CompactSpace cY.pt := compactSpace_limit_baseChange T X Z cY hcY
  have : QuasiSeparatedSpace cY.pt := quasiSeparatedSpace_limit_baseChange T X Z cY hcY
  obtain ⟨m, V₀, p₀, q₀, hfac⟩ :=
    exists_prodCover_factorization B cY.pt hY (AsSmall.down.obj U) (AsSmall.down.obj U')
  refine ⟨m, fun i => AsSmall.up.obj (V₀ i), fun _ => Set.mem_univ _,
    fun i => ⟨p₀ i⟩, fun i => ⟨q₀ i⟩, ?_⟩
  refine Sheaf.isLocallySurjective_sigmaDesc_prodLift_of_exists_covering
    (J := (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck) _ _ _ ?_
  intro Y' α β
  choose idx Wj wj rj hpj hqj hzj using
    hfac (AsSmall.down.obj Y') (AsSmall.down.map α) (AsSmall.down.map β)
  refine ⟨_, mem_toGrothendieck_ofArrows_up T X Z cY hcY B hD hY Wj wj
    (fun x => ⟨x, hzj x⟩), ?_⟩
  intro Zc g hg
  obtain ⟨A₀, c, q, hq, rfl⟩ := hg
  obtain ⟨z⟩ := hq
  refine ⟨idx z, c ≫ ⟨rj z⟩, ?_, ?_⟩
  · exact congrArg (fun t => c ≫ t) (ULift.ext (hpj z))
  · exact congrArg (fun t => c ≫ t) (ULift.ext (hqj z))


/-! ### Stacks 0GN3 at this system, with no covering-set hypothesis left -/

include hcY in
/-- **Stacks 0GN3 on the colimit site of the system of base changes, with no covering-set
hypothesis left.** Let `T = Spec A` be affine, let `Z_i = Spec B_i` be a diagram of affine schemes
over `T` indexed by a nonempty directed `Iᵒᵖ`, let `X ⟶ T` be quasi-compact and quasi-separated —
the source's own hypothesis — and let `cY` be a limit cone of the system `Y_i = Z_i ×_T X` with
apex `Y`. Then

`colim_λ H^p(C_Y, F_λ) ⟶ H^p(C_Y, colim_λ F_λ)`

is an isomorphism in every degree `p`, for every filtered diagram `F` of abelian sheaves on the
colimit site `C_Y` of the system — the small affine etale site of `Y`, raised.

The covering set is `bcCoveringSet`: the finite coproducts of sheafified representables of **all**
objects of the site. All five hypotheses of Stacks 0GN3 are discharged, through the four
object-level conditions of Stacks 0GN4: (1) is `bcCoversTop_univ`, (2) is
`bcHasFiniteCoverRefinements_univ`, (3) is `bcProduct_univ`, (4) is `bcEqualizer_univ`, and (5) is
`isQuasiCompact_mem_bcCoveringSet`, which the criterion re-derives internally from (2).

Only quasi-compactness and quasi-separatedness of `X ⟶ T` are used, and only through
`compactSpace_limit_baseChange` and `quasiSeparatedSpace_limit_baseChange`: conditions (2) and (4)
need neither. -/
theorem isIso_colimit_post_rightDerived_globalSections_bc
    [QuasiCompact X.hom] [QuasiSeparated X.hom]
    (n : ℕ) {Λ : Type (u + 1)} [SmallCategory Λ] [IsFiltered Λ]
    (F : Λ ⥤ Sheaf (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck Ab.{u + 1}) :
    IsIso (colimit.post F
      ((Sheaf.Γ (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck Ab.{u + 1}).rightDerived
        n)) :=
  isIso_colimit_post_rightDerived_globalSections_of_covers
    (bcPrecoverageGen T X Z cY hcY B hD hY).toGrothendieck Set.univ
    (bcCoversTop_univ T X Z cY hcY B hD hY)
    (fun W _ => bcHasFiniteCoverRefinements_univ T X Z cY hcY B hD hY W)
    (fun U hU U' hU' => bcProduct_univ T X Z cY hcY B hD hY U hU U' hU')
    (fun a b hU hU' => bcEqualizer_univ T X Z cY hcY B hD hY a b hU hU') n F


end Stacks.EtaleCohomology.QcqsBaseChange

end
