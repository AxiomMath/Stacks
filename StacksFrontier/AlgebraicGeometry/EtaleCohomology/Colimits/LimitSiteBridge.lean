module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Colimits.AffineEtaleCohomologyColimit
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Colimits.DirectImageSystem
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GlobalSectionsClosed.InverseImage
public import StacksFrontier.AlgebraicGeometry.Topologies.SmallEtaleDenseSubsite
public import StacksFrontier.CategoryTheory.Sites.Topos.ToposReplacement

/-!
# The sites of Stacks 0EYL inside Mathlib's small étale sites

Stacks 0EYL presents the small affine étale site of a limit `X = lim X_i` (affine transition
morphisms) as a colimit of strict small models of the small affine étale sites of the `X_i`
(`Stacks.EtaleCohomology.affineEtaleSiteColimit`). This file embeds those models into Mathlib's
small étale sites `X_i.Etale` and `X.Etale`, the sites carrying the mainstream étale cohomology
of the library, and records the two facts that make the embedding a bridge:

* each embedding is a **dense subsite** inclusion, so restriction along it is an equivalence of
  sheaf categories (Stacks 04HR together with the identification of the models);
* the transition functors of the system and the functors to the limit are, after embedding,
  **base change** along the transition morphisms and the projections: the embedded squares are
  naturally isomorphic to `Stacks.EtaleCohomology.smallEtaleBaseChange`.

## Main definitions

* `levelToEtale` and `limitToEtale`: the embeddings of a level and of the limit site.
* `transitionBaseChangeIso`, `toLimitBaseChangeIso`: the natural isomorphisms of the second
  point.

## Main results

* `levelToEtale_isDenseSubsite`, `limitToEtale_isDenseSubsite`: the first point.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe v u w a b

namespace Stacks.EtaleCohomology.LimitSiteBridge

open Stacks.EtaleCohomology.AffineLimitCohomology

/-! ### Dense subsites -/

/-- An equivalence of categories which identifies the covering presieves of two topologies is a
dense subsite inclusion. -/
theorem isDenseSubsite_of_equivalence {C : Type*} [Category* C] {D : Type*} [Category* D]
    (e : C ≌ D) (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    (h : ∀ (X : C) (R : Presieve X),
      R ∈ J.toPrecoverage X ↔ R.map e.functor ∈ K.toPrecoverage (e.functor.obj X)) :
    e.functor.IsDenseSubsite J K where
  functorPushforward_mem_iff {X S} := by
    rw [← GrothendieckTopology.arrows_mem_toPrecoverage_iff J S, h X S.arrows,
      GrothendieckTopology.mem_toPrecoverage_iff, Sieve.generate_map_eq_functorPushforward,
      Sieve.generate_sieve]

section Affine

variable (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The small affine étale site of Stacks 021B inside Mathlib's small étale site. -/
abbrev affineToEtale : SmallAffineEtale B S hS ⥤ S.Etale :=
  SmallAffineEtale.inclusion B S hS ⋙ SmallEtale.toEtaleSite B S hS

/-- **Stacks 04HR, read in Mathlib's small étale site.** The small affine étale site is a dense
subsite of `S.Etale`. -/
instance affineToEtale_isDenseSubsite :
    (affineToEtale B S hS).IsDenseSubsite (SmallAffineEtale.topology B S hS)
      S.smallEtaleTopology :=
  haveI := (SmallAffineEtale.inclusion_isSpecialCocontinuous B S hS).2
  Functor.isDenseSubsite_comp _ (SmallEtale.topology B S hS) _ _ _

end Affine

section AsSmall

variable {A : Type a} [Category.{b} A] (P : Precoverage A)

/-- The functor `AsSmall.down : AsSmall A ⥤ A` is an equivalence of categories. -/
instance asSmall_down_isEquivalence : (AsSmall.down.{b, a, w} : AsSmall A ⥤ A).IsEquivalence :=
  AsSmall.equiv.isEquivalence_inverse

/-- The functor `AsSmall.up : A ⥤ AsSmall A` is an equivalence of categories. -/
instance asSmall_up_isEquivalence : (AsSmall.up.{b, a, w} : A ⥤ AsSmall A).IsEquivalence :=
  AsSmall.equiv.isEquivalence_functor

/-- Pushing a presieve up to `AsSmall` and back down recovers it. -/
theorem presieve_map_up_down {X : A} (R : Presieve X) :
    (R.map AsSmall.up.{b, a, w}).map AsSmall.down = R := by
  refine le_antisymm ?_ fun _ _ hf => Presieve.map_map (Presieve.map_map hf)
  rintro W f ⟨⟨h⟩⟩
  exact h

/-- `AsSmall.up` carries the coverings of the topology generated by a precoverage to coverings
of the topology generated by its transport. -/
theorem coverPreserving_asSmall_up :
    CoverPreserving P.toGrothendieck (P.comap AsSmall.down.{b, a, w}).toGrothendieck
      AsSmall.up := by
  refine ⟨fun {X S} hS => ?_⟩
  have hle : P.toGrothendieck ≤ (AsSmall.up.{b, a, w}).restrictedTopology
      (P.comap AsSmall.down.{b, a, w}).toGrothendieck := by
    rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
    intro Y R hR
    rw [GrothendieckTopology.mem_toPrecoverage_iff, Functor.mem_restrictedTopology_iff,
      ← Sieve.generate_map_eq_functorPushforward]
    exact Precoverage.generate_mem_toGrothendieck
      (by rwa [Precoverage.mem_comap_iff, presieve_map_up_down])
  exact Functor.mem_restrictedTopology_iff.mp (hle X hS)

/-- **The transport of a precoverage to `AsSmall` generates the restricted topology.** -/
theorem toGrothendieck_comap_asSmall_down :
    (P.comap AsSmall.down.{b, a, w}).toGrothendieck =
      (AsSmall.down.{b, a, w}).restrictedTopology P.toGrothendieck := by
  refine le_antisymm ?_ ?_
  · rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
    intro Y R hR
    rw [GrothendieckTopology.mem_toPrecoverage_iff, Functor.mem_restrictedTopology_iff,
      ← Sieve.generate_map_eq_functorPushforward]
    exact Precoverage.generate_mem_toGrothendieck hR
  · intro X S hS
    rw [Functor.mem_restrictedTopology_iff] at hS
    refine GrothendieckTopology.superset_covering _ ?_
      ((coverPreserving_asSmall_up.{w} P).cover_preserve hS)
    rintro W f ⟨Z, g, h, ⟨Z', g', h', hh', rfl⟩, rfl⟩
    have e : h ≫ AsSmall.up.map (h' ≫ AsSmall.down.map g') = (h ≫ AsSmall.up.map h') ≫ g' := by
      rw [Functor.map_comp, ← Category.assoc]
      rfl
    exact e ▸ S.downward_closed hh' _

/-- `AsSmall.down` is a dense subsite inclusion for the transported topology. -/
instance asSmall_down_isDenseSubsite :
    (AsSmall.down.{b, a, w} : AsSmall A ⥤ A).IsDenseSubsite
      (P.comap AsSmall.down.{b, a, w}).toGrothendieck P.toGrothendieck := by
  rw [toGrothendieck_comap_asSmall_down]
  infer_instance

end AsSmall

section System

variable {I : Type v} [Preorder I] [Nonempty I] [IsDirected I (· ≤ ·)]
  (D : Iᵒᵖ ⥤ Scheme.{max u v}) (c : Cone D)
  (B : BigEtaleSite.{max u v})
  (hD : ∀ i, B.Contains (D.obj i)) (hX : B.Contains c.pt)
  (hc : IsLimit c)
  [∀ {i j : Iᵒᵖ} (a : i ⟶ j), IsAffineHom (D.map a)]

/-- The index of the scheme carried by a level of the system of Stacks 0EYL. -/
abbrev idx (i : (sys D c B hD hX hc).I) : Iᵒᵖ :=
  (affineEtaleSiteColimit D c B hD hX hc).indexEquiv.functor.obj i

/-- The scheme carried by a level. -/
abbrev lvl (i : (sys D c B hD hX hc).I) : Scheme.{max u v} := D.obj (idx D c B hD hX hc i)

/-- The transition morphism of schemes carried by an arrow of the index of the system. -/
abbrev lvlMap {i j : (sys D c B hD hX hc).I} (a : i ⟶ j) :
    lvl D c B hD hX hc i ⟶ lvl D c B hD hX hc j :=
  D.map ((affineEtaleSiteColimit D c B hD hX hc).indexEquiv.functor.map a)

/-- The projection of the limit onto the scheme carried by a level. -/
abbrev lvlπ (i : (sys D c B hD hX hc).I) : c.pt ⟶ lvl D c B hD hX hc i :=
  c.π.app (idx D c B hD hX hc i)

/-- **The embedding of a level of the system of Stacks 0EYL into Mathlib's small étale site** of
the scheme it models. -/
abbrev levelToEtale (i : (sys D c B hD hX hc).I) :
    (sys D c B hD hX hc).C i ⥤ (lvl D c B hD hX hc i).Etale :=
  ((affineEtaleSiteColimit D c B hD hX hc).levelEquiv i).functor ⋙
    affineToEtale B (lvl D c B hD hX hc i) (hD _)

/-- The level equivalence of Stacks 0EYL is a dense subsite inclusion. -/
instance levelEquiv_isDenseSubsite (i : (sys D c B hD hX hc).I) :
    ((affineEtaleSiteColimit D c B hD hX hc).levelEquiv i).functor.IsDenseSubsite
      ((sys D c B hD hX hc).J i) (SmallAffineEtale.topology B (lvl D c B hD hX hc i) (hD _)) :=
  isDenseSubsite_of_equivalence _ _ _ fun Y R =>
    affineEtaleSiteColimit_level_cover D c B hD hX hc i Y R

/-- **A level of the system of Stacks 0EYL is a dense subsite of Mathlib's small étale site** of
the scheme it models. -/
instance levelToEtale_isDenseSubsite (i : (sys D c B hD hX hc).I) :
    (levelToEtale D c B hD hX hc i).IsDenseSubsite ((sys D c B hD hX hc).J i)
      (lvl D c B hD hX hc i).smallEtaleTopology :=
  Functor.isDenseSubsite_comp _ (SmallAffineEtale.topology B (lvl D c B hD hX hc i) (hD _)) _ _ _

/-- **The embedding of the small affine étale site of the limit**, raised to the universe of the
levels, into Mathlib's small étale site of the limit. -/
abbrev limitToEtale : limitSite D c B hX ⥤ c.pt.Etale :=
  AsSmall.down ⋙ affineToEtale B c.pt hX

/-- **The raised small affine étale site of the limit is a dense subsite of `X.Etale`.** -/
instance limitToEtale_isDenseSubsite :
    (limitToEtale D c B hX).IsDenseSubsite (limitSitePrecoverage D c B hX).toGrothendieck
      c.pt.smallEtaleTopology :=
  haveI : (AsSmall.down : limitSite D c B hX ⥤ _).IsDenseSubsite
      (limitSitePrecoverage D c B hX).toGrothendieck (SmallAffineEtale.topology B c.pt hX) :=
    asSmall_down_isDenseSubsite.{max u v + 1} (SmallAffineEtale.precoverage B c.pt hX)
  Functor.isDenseSubsite_comp _ (SmallAffineEtale.topology B c.pt hX) _ _ _

/-- The underlying scheme of the embedding of an object of a level. -/
theorem levelToEtale_obj_hom (i : (sys D c B hD hX hc).I) (Y : (sys D c B hD hX hc).C i) :
    ((levelToEtale D c B hD hX hc i).obj Y).hom =
      affineEtaleStructureMorphism D B hD (idx D c B hD hX hc i)
        (((affineEtaleSiteColimit D c B hD hX hc).levelEquiv i).functor.obj Y) := rfl

/-- **The transition functors of the system are base change along the transition morphisms**,
once embedded in Mathlib's small étale sites: the component at `Y` is the comparison of the
fibre-product square `transition_isPullback` with the chosen fibre product. -/
def transitionBaseChangeIso {i j : (sys D c B hD hX hc).I} (a : i ⟶ j) :
    (sys D c B hD hX hc).u a ⋙ levelToEtale D c B hD hX hc i ≅
      levelToEtale D c B hD hX hc j ⋙ smallEtaleBaseChange (lvlMap D c B hD hX hc a) :=
  NatIso.ofComponents
    (fun Y => MorphismProperty.Over.isoMk
      ((affineEtaleSiteColimit D c B hD hX hc).transition_isPullback a Y).isoPullback
      (((affineEtaleSiteColimit D c B hD hX hc).transition_isPullback a Y).isoPullback_hom_snd))
    (fun {Y Y'} g => by
      apply smallEtaleBaseChange_hom_ext
      have hY :=
        ((affineEtaleSiteColimit D c B hD hX hc).transition_isPullback a Y).isoPullback_hom_fst
      have hY' :=
        ((affineEtaleSiteColimit D c B hD hX hc).transition_isPullback a Y').isoPullback_hom_fst
      have hnat := ((affineEtaleSiteColimit D c B hD hX hc).transitionFst a).naturality g
      have h1 := smallEtaleBaseChange_map_left_fst (lvlMap D c B hD hX hc a)
        ((levelToEtale D c B hD hX hc j).map g)
      exact ((Category.assoc _ _ _).trans
        ((congrArg (fun t => (((sys D c B hD hX hc).u a ⋙
          levelToEtale D c B hD hX hc i).map g).left ≫ t) hY').trans hnat)).trans
        ((congrArg (· ≫ ((levelToEtale D c B hD hX hc j).map g).left) hY.symm).trans
          ((Category.assoc _ _ _).trans ((congrArg (fun t =>
            ((affineEtaleSiteColimit D c B hD hX hc).transition_isPullback a Y).isoPullback.hom ≫ t)
              h1.symm).trans (Category.assoc _ _ _).symm))))

/-- **The functors to the limit are base change along the projections**, once embedded in
Mathlib's small étale sites: the component at `Y` is the comparison of the fibre-product square
`toLimit_isPullback` with the chosen fibre product. -/
def toLimitBaseChangeIso (i : (sys D c B hD hX hc).I) :
    toLimitSmall D c B hD hX hc i ⋙ limitToEtale D c B hX ≅
      levelToEtale D c B hD hX hc i ⋙ smallEtaleBaseChange (lvlπ D c B hD hX hc i) :=
  NatIso.ofComponents
    (fun Y => MorphismProperty.Over.isoMk
      ((affineEtaleSiteColimit D c B hD hX hc).toLimit_isPullback i Y).isoPullback
      (((affineEtaleSiteColimit D c B hD hX hc).toLimit_isPullback i Y).isoPullback_hom_snd))
    (fun {Y Y'} g => by
      apply smallEtaleBaseChange_hom_ext
      have hY :=
        ((affineEtaleSiteColimit D c B hD hX hc).toLimit_isPullback i Y).isoPullback_hom_fst
      have hY' :=
        ((affineEtaleSiteColimit D c B hD hX hc).toLimit_isPullback i Y').isoPullback_hom_fst
      have hnat := ((affineEtaleSiteColimit D c B hD hX hc).toLimitFst i).naturality g
      have h1 := smallEtaleBaseChange_map_left_fst (lvlπ D c B hD hX hc i)
        ((levelToEtale D c B hD hX hc i).map g)
      exact ((Category.assoc _ _ _).trans
        ((congrArg (fun t => ((toLimitSmall D c B hD hX hc i ⋙
          limitToEtale D c B hX).map g).left ≫ t) hY').trans hnat)).trans
        ((congrArg (· ≫ ((levelToEtale D c B hD hX hc i).map g).left) hY.symm).trans
          ((Category.assoc _ _ _).trans ((congrArg (fun t =>
            ((affineEtaleSiteColimit D c B hD hX hc).toLimit_isPullback i Y).isoPullback.hom ≫ t)
              h1.symm).trans (Category.assoc _ _ _).symm))))

omit [Nonempty I] [IsDirected I (· ≤ ·)] [∀ {i j : Iᵒᵖ} (a : i ⟶ j), IsAffineHom (D.map a)] in
/-- A reassociation, in an abstract category so that rewriting meets no foreign structure. -/
theorem chain_aux {𝒞 : Type*} [Category 𝒞] {A₀ A₁ A₂ A₃ A₄ A₅ A₆ A₇ : 𝒞}
    (e : A₀ ⟶ A₁) (ta : A₁ ⟶ A₂) (bc : A₂ ⟶ A₃) (inv : A₃ ⟶ A₄) (fab : A₄ ⟶ A₅)
    (p : A₃ ⟶ A₆) (q : A₆ ⟶ A₅) (r : A₂ ⟶ A₇) (tb : A₇ ⟶ A₆) (tFa : A₁ ⟶ A₇) (tFb : A₇ ⟶ A₅)
    (h4 : inv ≫ fab = p ≫ q) (h5 : bc ≫ p = r ≫ tb) (h2 : ta ≫ r = tFa) (h3 : tb ≫ q = tFb) :
    (e ≫ ta ≫ bc ≫ inv) ≫ fab = e ≫ tFa ≫ tFb := by
  simp only [Category.assoc]
  rw [h4, reassoc_of% h5, reassoc_of% h2, h3]

/-- The transition morphism carried by a composite arrow is the composite of the transition
morphisms carried by its factors. -/
theorem lvlMap_comp {i j k : (sys D c B hD hX hc).I} (a : i ⟶ j) (b : j ⟶ k) :
    lvlMap D c B hD hX hc (a ≫ b) = lvlMap D c B hD hX hc a ≫ lvlMap D c B hD hX hc b :=
  (congrArg D.map (Functor.map_comp _ a b)).trans (D.map_comp _ _)

/-- **The transition isomorphisms are compatible with composition**: the comparison for a
composite transition is the comparison for the second factor, followed by the base change of the
comparison for the first, followed by the comparison of base change along a composite. -/
theorem transitionBaseChangeIso_comp {i j k : (sys D c B hD hX hc).I} (a : i ⟶ j) (b : j ⟶ k)
    (Y : (sys D c B hD hX hc).C k) :
    (transitionBaseChangeIso D c B hD hX hc (a ≫ b)).hom.app Y =
      (levelToEtale D c B hD hX hc i).map
          (eqToHom (Functor.congr_obj ((sys D c B hD hX hc).comp a b) Y)) ≫
        (transitionBaseChangeIso D c B hD hX hc a).hom.app (((sys D c B hD hX hc).u b).obj Y) ≫
        (smallEtaleBaseChange (lvlMap D c B hD hX hc a)).map
          ((transitionBaseChangeIso D c B hD hX hc b).hom.app Y) ≫
        (smallEtaleBaseChangeComp' (lvlMap D c B hD hX hc a) (lvlMap D c B hD hX hc b)
          (lvlMap D c B hD hX hc (a ≫ b)) (lvlMap_comp D c B hD hX hc a b)).inv.app
            ((levelToEtale D c B hD hX hc k).obj Y) := by
  apply smallEtaleBaseChange_hom_ext
  have hc' := (affineEtaleSiteColimit D c B hD hX hc).transitionFst_comp a b Y
  have h1 :=
    ((affineEtaleSiteColimit D c B hD hX hc).transition_isPullback (a ≫ b) Y).isoPullback_hom_fst
  have h2 := ((affineEtaleSiteColimit D c B hD hX hc).transition_isPullback a
    (((sys D c B hD hX hc).u b).obj Y)).isoPullback_hom_fst
  have h3 :=
    ((affineEtaleSiteColimit D c B hD hX hc).transition_isPullback b Y).isoPullback_hom_fst
  have h4 := smallEtaleBaseChangeComp'_fst_fst (lvlMap D c B hD hX hc a)
    (lvlMap D c B hD hX hc b) (lvlMap D c B hD hX hc (a ≫ b)) (lvlMap_comp D c B hD hX hc a b)
    ((levelToEtale D c B hD hX hc k).obj Y)
  have h4' : ((smallEtaleBaseChangeComp' (lvlMap D c B hD hX hc a) (lvlMap D c B hD hX hc b)
      (lvlMap D c B hD hX hc (a ≫ b)) (lvlMap_comp D c B hD hX hc a b)).inv.app
        ((levelToEtale D c B hD hX hc k).obj Y)).left ≫
      pullback.fst ((levelToEtale D c B hD hX hc k).obj Y).hom (lvlMap D c B hD hX hc (a ≫ b)) =
      pullback.fst ((smallEtaleBaseChange (lvlMap D c B hD hX hc b)).obj
          ((levelToEtale D c B hD hX hc k).obj Y)).hom (lvlMap D c B hD hX hc a) ≫
        pullback.fst ((levelToEtale D c B hD hX hc k).obj Y).hom (lvlMap D c B hD hX hc b) := by
    have hih := congrArg (fun φ => φ.left)
      ((smallEtaleBaseChangeComp' (lvlMap D c B hD hX hc a) (lvlMap D c B hD hX hc b)
        (lvlMap D c B hD hX hc (a ≫ b)) (lvlMap_comp D c B hD hX hc a b)).inv_hom_id_app
          ((levelToEtale D c B hD hX hc k).obj Y))
    have hih' : ((smallEtaleBaseChangeComp' (lvlMap D c B hD hX hc a) (lvlMap D c B hD hX hc b)
        (lvlMap D c B hD hX hc (a ≫ b)) (lvlMap_comp D c B hD hX hc a b)).inv.app
          ((levelToEtale D c B hD hX hc k).obj Y)).left ≫
        ((smallEtaleBaseChangeComp' (lvlMap D c B hD hX hc a) (lvlMap D c B hD hX hc b)
        (lvlMap D c B hD hX hc (a ≫ b)) (lvlMap_comp D c B hD hX hc a b)).hom.app
          ((levelToEtale D c B hD hX hc k).obj Y)).left = 𝟙 _ := hih
    rw [← h4]
    exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ _) hih').trans (Category.id_comp _))
  have h5 := smallEtaleBaseChange_map_left_fst (lvlMap D c B hD hX hc a)
    ((transitionBaseChangeIso D c B hD hX hc b).hom.app Y)
  have h3' : ((transitionBaseChangeIso D c B hD hX hc b).hom.app Y).left ≫
      pullback.fst ((levelToEtale D c B hD hX hc k).obj Y).hom (lvlMap D c B hD hX hc b) =
      ((affineEtaleSiteColimit D c B hD hX hc).transitionFst b).app Y := h3
  have h2' : ((transitionBaseChangeIso D c B hD hX hc a).hom.app
        (((sys D c B hD hX hc).u b).obj Y)).left ≫
      pullback.fst ((levelToEtale D c B hD hX hc j).obj (((sys D c B hD hX hc).u b).obj Y)).hom
        (lvlMap D c B hD hX hc a) =
      ((affineEtaleSiteColimit D c B hD hX hc).transitionFst a).app
        (((sys D c B hD hX hc).u b).obj Y) := h2
  have expand : ((levelToEtale D c B hD hX hc i).map
          (eqToHom (Functor.congr_obj ((sys D c B hD hX hc).comp a b) Y)) ≫
        (transitionBaseChangeIso D c B hD hX hc a).hom.app (((sys D c B hD hX hc).u b).obj Y) ≫
        (smallEtaleBaseChange (lvlMap D c B hD hX hc a)).map
          ((transitionBaseChangeIso D c B hD hX hc b).hom.app Y) ≫
        (smallEtaleBaseChangeComp' (lvlMap D c B hD hX hc a) (lvlMap D c B hD hX hc b)
          (lvlMap D c B hD hX hc (a ≫ b)) (lvlMap_comp D c B hD hX hc a b)).inv.app
            ((levelToEtale D c B hD hX hc k).obj Y)).left =
      ((levelToEtale D c B hD hX hc i).map
          (eqToHom (Functor.congr_obj ((sys D c B hD hX hc).comp a b) Y))).left ≫
        ((transitionBaseChangeIso D c B hD hX hc a).hom.app
          (((sys D c B hD hX hc).u b).obj Y)).left ≫
        ((smallEtaleBaseChange (lvlMap D c B hD hX hc a)).map
          ((transitionBaseChangeIso D c B hD hX hc b).hom.app Y)).left ≫
        ((smallEtaleBaseChangeComp' (lvlMap D c B hD hX hc a) (lvlMap D c B hD hX hc b)
          (lvlMap D c B hD hX hc (a ≫ b)) (lvlMap_comp D c B hD hX hc a b)).inv.app
            ((levelToEtale D c B hD hX hc k).obj Y)).left := rfl
  refine h1.trans (hc'.trans ?_)
  refine Eq.trans ?_ (congrArg (· ≫ pullback.fst ((levelToEtale D c B hD hX hc k).obj Y).hom
    (lvlMap D c B hD hX hc (a ≫ b))) expand).symm
  exact (chain_aux _ _ _ _ _ _ _ _ _ _ _ h4' h5 h2' h3').symm

/-- **The functors to the site of the limit are continuous** (one half of Stacks 0A35). -/
theorem toLimitSmall_isContinuous (i : (sys D c B hD hX hc).I) :
    (toLimitSmall D c B hD hX hc i).IsContinuous ((sys D c B hD hX hc).J i)
      (limitSitePrecoverage D c B hX).toGrothendieck :=
  (CategoryTheory.Sites.InverseSystem.InverseSystemOfFiniteSites.exists_isMorphismOfSites_sections_pullback_of_colimit
    (sys D c B hD hX hc) (toLimitSmall D c B hD hX hc) (toLimitSmall_transition D c B hD hX hc)
    (toLimitSmall_obj_descends D c B hD hX hc) (toLimitSmall_hom_descends D c B hD hX hc)
    (toLimitSmall_hom_eventually_eq D c B hD hX hc) (limitSitePrecoverage D c B hX)
    (mem_limitSitePrecoverage_iff D c B hD hX hc)).elim fun hf _ => (hf i).isContinuous

end System

