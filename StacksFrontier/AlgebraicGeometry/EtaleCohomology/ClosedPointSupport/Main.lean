module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.ClosedPointSupport.AbelianColimit
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.ClosedPointSupport.BoundedSiteFilteredColimit
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.ClosedPointSupport.FiniteSupport
public import StacksFrontier.CategoryTheory.Sites.GlobalSections.DerivedGlobalSectionsCohomology
public import StacksCore.Tactic.StacksAttribute

/-!
# Étale sheaves supported at closed points over a separably closed field

Let `K` be a separably closed field, let `X` be a scheme of finite type over `K` and let `F` be
an abelian sheaf on the small étale site of `X` whose support consists of closed points. Then
the positive-degree étale cohomology of `F` vanishes and `F` is generated by its global
sections.

## Main results

* `AlgebraicGeometry.subsingleton_sheafH_and_epi_counit_of_supportSheaf_subset_closedPoints`: an
  abelian sheaf on the small étale site of a finite-type scheme over a separably closed field whose
  support consists of closed points has vanishing positive-degree cohomology and is globally
  generated.

## Implementation notes

"Globally generated" is read as the counit of `CategoryTheory.constantSheafΓAdj` being an
epimorphism, which is what being generated by global sections says: the constant sheaf on the
group of global sections surjects onto the sheaf. It implies the weaker statement that *some*
constant sheaf on a free abelian group surjects onto `F`, since the counit factors every map out
of a constant sheaf.

Finite type over `K` is `AlgebraicGeometry.LocallyOfFiniteType` together with
`AlgebraicGeometry.QuasiCompact` for the structure morphism. Those two give the Noetherian and
quasi-separated hypotheses that [Stacks, Tag 0F0N] and [Stacks, Tag 03Q5] respectively need.

The degree-`q` cohomology group is `CategoryTheory.Sheaf.H`, Mathlib's `Ext`-theoretic sheaf
cohomology, at the `Ext` universe `u + 1`; that it elaborates with no hypothesis on this site is
`AlgebraicGeometry.SmallEtale.isGrothendieckAbelian_sheaf_succ`, installed as a local instance.
Vanishing is transferred to the right derived functors of global sections — which is where
[Stacks, Tag 03Q5] lives — by
`Stacks.Cohomology.GlobalSections.subsingleton_sheafH_iff_isZero_rightDerivedΓ`, whose free
coefficient universe has to be given explicitly because the site has its objects one universe
above its morphisms.

## References

* [Stacks Project, Tag 0F1F](https://stacks.math.columbia.edu/tag/0F1F)
* [Stacks Project, Tag 0F0N](https://stacks.math.columbia.edu/tag/0F0N)
* [Stacks Project, Tag 03Q5](https://stacks.math.columbia.edu/tag/03Q5)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry

attribute [local instance] SmallEtale.isGrothendieckAbelian_sheaf_succ

/-- The set of closed points of a topological space is stable under specialization. -/
public theorem stableUnderSpecialization_setOf_isClosed_singleton (T : Type*)
    [TopologicalSpace T] :
    StableUnderSpecialization {x : T | IsClosed ({x} : Set T)} := by
  intro x y hxy hx
  rw [Set.mem_setOf_eq, hxy.mem_closed hx rfl]
  exact hx

/-- Let `K` be a separably closed field, let `X` be a scheme of finite type over `K` and let `F`
be an abelian sheaf on the small étale site of `X` whose support is contained in the set of
closed points of `X`. Then `H^q(X, F) = 0` for `q > 0`, and `F` is globally generated: the
constant sheaf on its group of global sections surjects onto it. -/
@[stacks 0F1F]
public theorem subsingleton_sheafH_and_epi_counit_of_supportSheaf_subset_closedPoints
    (B : BigEtaleSite.{u}) (K : Type u) [Field K] [IsSepClosed K] (X : B.Scheme)
    (f : X.obj ⟶ Spec (.of K)) [LocallyOfFiniteType f] [QuasiCompact f]
    (F : SmallEtaleAbelianSheaf B X)
    (hF : supportSheaf B X.obj X.property F ⊆ {x : X.obj | IsClosed ({x} : Set X.obj)}) :
    (∀ q : ℕ, 0 < q → Subsingleton (Sheaf.H.{u + 1, u + 1} F q)) ∧
      Epi ((constantSheafΓAdj (SmallEtale.topology B X.obj X.property)
        AddCommGrpCat.{u + 1}).counit.app F) := by
  have : IsLocallyNoetherian X.obj := LocallyOfFiniteType.isLocallyNoetherian f
  have : CompactSpace X.obj := QuasiCompact.compactSpace_of_compactSpace f
  have : IsNoetherian X.obj := { toIsLocallyNoetherian := inferInstance }
  have : QuasiSeparatedSpace X.obj := IsLocallyNoetherian.quasiSeparatedSpace
  obtain ⟨I, hI, hfilt, D, ι, ⟨hcolim⟩, hD⟩ :=
    exists_isFilteredColimit_isClosed_support_abelian B X _
      (stableUnderSpecialization_setOf_isClosed_singleton X.obj) F hF
  have haux : ∀ i, (∀ q : ℕ, 0 < q → Subsingleton (Sheaf.H.{u + 1, u + 1} (D.obj i) q)) ∧
      Epi ((constantSheafΓAdj (SmallEtale.topology B X.obj X.property)
        AddCommGrpCat.{u + 1}).counit.app (D.obj i)) := by
    intro i
    obtain ⟨Z, hZclosed, hZE, hZsupp⟩ := hD i
    exact subsingleton_sheafH_and_epi_counit_of_finite_support B K X f Z
      (finite_of_isClosed_of_forall_isClosed_singleton hZclosed fun _ hx ↦ hZE hx)
      (fun _ hx ↦ hZE hx) (D.obj i) hZsupp
  refine ⟨fun q hq ↦ ?_, ?_⟩
  · rw [Stacks.Cohomology.GlobalSections.subsingleton_sheafH_iff_isZero_rightDerivedΓ.{u, u, u + 1}]
    let Rq := (Sheaf.Γ (SmallEtale.topology B X.obj X.property)
      AddCommGrpCat.{u + 1}).rightDerived q
    have hzero (i) : IsZero (Rq.obj (D.obj i)) :=
      (Stacks.Cohomology.GlobalSections.subsingleton_sheafH_iff_isZero_rightDerivedΓ.{u, u, u + 1}
        _ (D.obj i) q).mp ((haux i).1 q hq)
    have hcol : IsZero (colimit (D ⋙ Rq)) := by
      rw [IsZero.iff_id_eq_zero]
      refine colimit.hom_ext fun i ↦ ?_
      rw [Category.comp_id, comp_zero]
      exact (hzero i).eq_of_src _ _
    have hiso := Stacks.EtaleCohomology.isIso_colimit_post_rightDerived_Γ_boundedSmallEtale
      B X.obj X.property q D
    exact (hcol.of_iso (asIso (colimit.post D Rq)).symm).of_iso
      (Rq.mapIso (hcolim.coconePointUniqueUpToIso (colimit.isColimit D)))
  · refine ⟨fun g g' hgg' ↦ hcolim.hom_ext fun i ↦ ?_⟩
    have hn := (constantSheafΓAdj (SmallEtale.topology B X.obj X.property)
      AddCommGrpCat.{u + 1}).counit.naturality (ι.app i)
    simp only [Functor.id_map] at hn
    have hEq : (constantSheafΓAdj (SmallEtale.topology B X.obj X.property)
        AddCommGrpCat.{u + 1}).counit.app (D.obj i) ≫ (ι.app i ≫ g) =
        (constantSheafΓAdj (SmallEtale.topology B X.obj X.property)
        AddCommGrpCat.{u + 1}).counit.app (D.obj i) ≫ (ι.app i ≫ g') := by
      simp only [← Category.assoc]
      rw [← hn]
      simp only [Functor.const_obj_obj, Category.assoc] at hgg' ⊢
      rw [hgg']
    exact (haux i).2.left_cancellation _ _ hEq

end AlgebraicGeometry

end
