/-!
# Direct image along a closed immersion, cohomology and global generation

Let `i : Z ⟶ X` be a closed immersion in a big étale site. Base change along `i` is a
continuous functor from the small étale site of `X` to that of `Z` carrying the final object to
the final object, so the general comparison of [Stacks, Tag 03YU] identifies the étale
cohomology of an abelian sheaf on `Z` with the étale cohomology of its direct image on `X`.

The same adjunction transports surjectivity statements in the other direction: an abelian
sheaf on `X` whose inverse image vanishes and whose geometric stalks vanish off `Z` is zero,
whence inverse image along `i` reflects epimorphisms into a direct image, and a sheaf on `Z`
generated by its global sections has direct image generated by its global sections.

## Main results

* `AlgebraicGeometry.sheafHEtalePushforwardAddEquiv` — the étale cohomology of an abelian sheaf
  on the small étale site of `Z` agrees with the étale cohomology of its direct image along a
  closed immersion.
* `AlgebraicGeometry.isZero_etaleStalk_of_isZero_sheafPullback` — a sheaf on `X_étale` killed by
  inverse image along `i` has vanishing stalk at every geometric point of `X` whose image lies
  in `Z`.
* `AlgebraicGeometry.isZero_of_isZero_sheafPullback` — an abelian sheaf on `X_étale` killed by
  inverse image along `i` whose geometric stalks vanish away from `Z` is zero.
* `AlgebraicGeometry.epi_of_epi_sheafPullback` — inverse image along `i` reflects the
  epimorphisms whose target is a direct image along `i`.
* `AlgebraicGeometry.epi_constantSheafΓAdj_counit_etalePushforward` — if the canonical map from
  the constant sheaf on the global sections of an abelian sheaf on `Z_étale` is an epimorphism,
  then so is the corresponding map for its direct image on `X_étale`.

## Implementation notes

The cohomology comparison uses `Stacks.Cohomology.BiggerSite.sheafHAddEquiv`, whose hypotheses
are that restriction along base change be right exact and preserve injective objects; both come
from the adjunction between inverse and direct image, the second by
`CategoryTheory.Functor.preservesInjectiveObjects_of_adjunction_of_preservesMonomorphisms`
applied to the left exact inverse image.

The instance `AlgebraicGeometry.SmallEtale.isGrothendieckAbelian_abelianSheaf` is removed for
the cohomology comparison: its universe is `max (u + 1) v` with `v` free, so instance search for
`CategoryTheory.HasExt.{u + 1}` on this site stops on an unsolvable universe constraint instead
of using `AlgebraicGeometry.smallEtaleAbelianSheaf_isGrothendieckAbelian`. The removal is
scoped to the single declaration that needs it so that it cannot reach importers.

Vanishing of a sheaf is checked on geometric stalks. Over a point of the closed subscheme the
stalk is a stalk of the inverse image, by the abelian form of [Stacks, Tag 04CA]; away from it
the stalk is given by hypothesis. Epimorphy then descends by applying this to a cokernel, whose
stalks away from `Z` are quotients of the vanishing stalks of a direct image
([Stacks, Tag 03QP]) and whose inverse image is the cokernel of an epimorphism.

## References

* [Stacks Project, Tag 04CA](https://stacks.math.columbia.edu/tag/04CA)
* [Stacks Project, Tag 03QP](https://stacks.math.columbia.edu/tag/03QP)
* [Stacks Project, Tag 03YU](https://stacks.math.columbia.edu/tag/03YU)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-- The counit of an adjunction `cadj₁ : L₁ ⊣ R₁` at `q.obj F` is an epimorphism as soon as the
counit of a second adjunction `cadj₂ : L₂ ⊣ R₂` is one at `F`, given an adjunction `p ⊣ q`
identifying `L₁ ⋙ p` with `L₂`, invertible at its own counit at `F`, and such that `p` reflects
the epimorphisms with target `q.obj F`.

The adjunct over `p ⊣ q` of the composite of `L₁ ⋙ p ≅ L₂` with the second counit is a map
`L₁.obj (R₂.obj F) ⟶ q.obj F` whose image under `p` is that composite up to the invertible
counit, hence an epimorphism; it is therefore an epimorphism itself, and it factors through the
first counit. -/
private theorem epi_counit_of_epi_counit {A S₁ S₂ : Type*} [Category* A] [Category* S₁]
    [Category* S₂] {L₁ : A ⥤ S₁} {R₁ : S₁ ⥤ A} (cadj₁ : L₁ ⊣ R₁) {L₂ : A ⥤ S₂} {R₂ : S₂ ⥤ A}
    (cadj₂ : L₂ ⊣ R₂) {p : S₁ ⥤ S₂} {q : S₂ ⥤ S₁} (adj : p ⊣ q) (α : L₁ ⋙ p ≅ L₂) (F : S₂)
    (hF : Epi (cadj₂.counit.app F)) (hiso : IsIso (adj.counit.app F))
    (hrefl : ∀ (W : S₁) (ψ : W ⟶ q.obj F), Epi (p.map ψ) → Epi ψ) :
    Epi (cadj₁.counit.app (q.obj F)) := by
  have := hF
  have := hiso
  set M := R₂.obj F with hM
  set ψ : p.obj (L₁.obj M) ⟶ F := α.hom.app M ≫ cadj₂.counit.app F with hψ
  have hψepi : Epi ψ := by
    rw [hψ]
    infer_instance
  set φ : L₁.obj M ⟶ q.obj F := adj.homEquiv (L₁.obj M) F ψ with hφ
  have hfac : p.map φ ≫ adj.counit.app F = ψ := by
    have h := (adj.homEquiv (L₁.obj M) F).symm_apply_apply ψ
    rwa [Adjunction.homEquiv_counit] at h
  have hpφ : Epi (p.map φ) := by
    have h : p.map φ = ψ ≫ inv (adj.counit.app F) := by
      rw [← hfac]
      simp
    rw [h]
    infer_instance
  have hφepi : Epi φ := hrefl _ φ hpφ
  have hw := (cadj₁.homEquiv M (q.obj F)).symm_apply_apply φ
  rw [Adjunction.homEquiv_counit] at hw
  exact epi_of_epi_fac hw

variable (B : BigEtaleSite.{u})

/-- The étale stalk functor at a geometric point, on abelian sheaves, preserves zero
morphisms: it is the fibre functor of the point of the small étale site attached to the
geometric point, and that is a left adjoint, of the skyscraper sheaf functor. -/
private instance preservesZeroMorphisms_etaleStalkFunctorAbelian (Y : Scheme.{u})
    (hY : B.Contains Y) (s : GeometricPoint Y) :
    (etaleStalkFunctorAbelian B Y hY s).PreservesZeroMorphisms := by
  change ((geometricPointSitePoint B Y hY s).sheafFiber
    (A := AddCommGrpCat.{u + 1})).PreservesZeroMorphisms
  infer_instance

variable {Z X : B.Scheme} (i : Z ⟶ X) [IsClosedImmersion (B.inclusion.map i)]

attribute [-instance] AlgebraicGeometry.SmallEtale.isGrothendieckAbelian_abelianSheaf in
/-- **The étale cohomology of an abelian sheaf on a closed subscheme is the étale cohomology of
its direct image.** Base change along a closed immersion `i : Z ⟶ X` is a continuous functor
from the small étale site of `X` to that of `Z` taking the final object to the final object, so
global cohomology does not change under restriction along it, which is direct image `i_*`. -/
public def sheafHEtalePushforwardAddEquiv (G : SmallEtaleAbelianSheaf B Z) (p : ℕ) :
    Sheaf.H.{u + 1, u + 1} G p ≃+
      Sheaf.H.{u + 1, u + 1} ((SmallEtale.etalePushforward.{u, u + 1} B i).obj G) p :=
  letI : ((smallEtaleBaseChange B i).sheafPushforwardContinuous AddCommGrpCat.{u + 1}
      (SmallEtale.topology B X.obj X.property)
      (SmallEtale.topology B Z.obj Z.property)).PreservesInjectiveObjects :=
    Functor.preservesInjectiveObjects_of_adjunction_of_preservesMonomorphisms
      ((smallEtaleBaseChange B i).sheafAdjunctionContinuous AddCommGrpCat.{u + 1}
        (SmallEtale.topology B X.obj X.property) (SmallEtale.topology B Z.obj Z.property))
  Stacks.Cohomology.BiggerSite.sheafHAddEquiv
    (SmallEtale.topology B X.obj X.property) (SmallEtale.topology B Z.obj Z.property)
    (smallEtaleBaseChange B i) (SmallEtale.finalIsTerminal B X.obj X.property)
    (smallEtaleBaseChange_finalIsTerminal B i) rfl G p

/-- **A sheaf killed by inverse image along a closed immersion has vanishing stalk over the
closed subscheme.** A geometric point of `X` whose image lies in `Z` comes from a geometric
point `t` of `Z`, and there the stalk of the sheaf is the stalk at `t` of its inverse image,
by the abelian form of [Stacks, Tag 04CA]. -/
public theorem isZero_etaleStalk_of_isZero_sheafPullback (Q : SmallEtaleAbelianSheaf B X)
    (hin : IsZero (((smallEtaleBaseChange B i).sheafPullback AddCommGrpCat.{u + 1}
      (SmallEtale.topology B X.obj X.property)
      (SmallEtale.topology B Z.obj Z.property)).obj Q))
    (s : GeometricPoint X.obj)
    (hs : s.hom default ∈ Set.range (B.inclusion.map i).base) :
    IsZero (AlgebraicGeometry.etaleStalk B X.obj X.property s Q.obj) := by
  obtain ⟨t, rfl⟩ := exists_geometricPoint_map_eq_of_mem_range B i s hs
  exact IsZero.of_iso (Functor.map_isZero (etaleStalkFunctorAbelian B Z.obj Z.property t) hin)
    ((smallEtalePullbackStalkIsoAbelian B i t).app Q).symm

/-- **An abelian étale sheaf whose inverse image along a closed immersion vanishes and whose
geometric stalks vanish away from the closed subscheme is zero.** Both halves of the stalk
computation are available: over the closed subscheme the stalk is a stalk of the vanishing
inverse image, and away from it the stalk vanishes by hypothesis. -/
public theorem isZero_of_isZero_sheafPullback
    (Q : SmallEtaleAbelianSheaf B X)
    (hout : ∀ s : GeometricPoint X.obj,
      s.hom default ∉ Set.range (B.inclusion.map i).base →
        IsZero (AlgebraicGeometry.etaleStalk B X.obj X.property s Q.obj))
    (hin : IsZero (((smallEtaleBaseChange B i).sheafPullback AddCommGrpCat.{u + 1}
      (SmallEtale.topology B X.obj X.property)
      (SmallEtale.topology B Z.obj Z.property)).obj Q)) :
    IsZero Q := by
  refine isZero_of_forall_isZero_etaleStalk B X.obj X.property Q fun s => ?_
  by_cases hs : s.hom default ∈ Set.range (B.inclusion.map i).base
  · exact isZero_etaleStalk_of_isZero_sheafPullback B i Q hin s hs
  · exact hout s hs

/-- An epimorphism of abelian étale sheaves with vanishing stalk at the source has vanishing
stalk at the target: an epimorphism is locally surjective, hence surjective on the stalk at
every geometric point ([Stacks, Tag 03QP]), and a quotient of a zero group is zero. -/
private theorem isZero_etaleStalk_of_epi {Y : B.Scheme} {F H : SmallEtaleAbelianSheaf B Y}
    (α : F ⟶ H) [Epi α] (s : GeometricPoint Y.obj)
    (hF : IsZero ((etaleStalkPresheafFunctor B Y.obj Y.property s
      AddCommGrpCat.{u + 1}).obj F.obj)) :
    IsZero ((etaleStalkPresheafFunctor B Y.obj Y.property s
      AddCommGrpCat.{u + 1}).obj H.obj) := by
  have : Presheaf.IsLocallySurjective (SmallEtale.topology B Y.obj Y.property) α.hom :=
    (Sheaf.isLocallySurjective_iff_epi' (A := AddCommGrpCat.{u + 1}) α).2 inferInstance
  have : Epi ((etaleStalkPresheafFunctor B Y.obj Y.property s
      AddCommGrpCat.{u + 1}).map α.hom) :=
    (AddCommGrpCat.epi_iff_surjective _).2
      (surjective_etaleStalkMap_of_isLocallySurjective B Y.obj Y.property α s)
  exact IsZero.of_epi ((etaleStalkPresheafFunctor B Y.obj Y.property s
    AddCommGrpCat.{u + 1}).map α.hom) hF

/-- **Inverse image along a closed immersion reflects the epimorphisms into a direct image.**
The cokernel of the given map has vanishing stalks away from the closed subscheme, being a
quotient of a direct image, and its inverse image is the cokernel of an epimorphism, so it
vanishes. -/
public theorem epi_of_epi_sheafPullback {A : SmallEtaleAbelianSheaf B X}
    (G : SmallEtaleAbelianSheaf B Z)
    (φ : A ⟶ (SmallEtale.etalePushforward.{u, u + 1} B i).obj G)
    (hφ : Epi (((smallEtaleBaseChange B i).sheafPullback AddCommGrpCat.{u + 1}
      (SmallEtale.topology B X.obj X.property)
      (SmallEtale.topology B Z.obj Z.property)).map φ)) :
    Epi φ := by
  have := hφ
  refine Preadditive.epi_of_isZero_cokernel φ
    (isZero_of_isZero_sheafPullback B i (cokernel φ) ?_ ?_)
  · intro s hs
    exact isZero_etaleStalk_of_epi B (cokernel.π φ) s
      (smallEtalePushforward_stalk_isZero_of_not_mem_range B i G s hs)
  · exact IsZero.of_iso (isZero_cokernel_of_epi _) (PreservesCokernel.iso _ φ)

/-- **Global generation transports along a closed immersion.** If the canonical map from the
constant sheaf on the global sections of an abelian sheaf on the small étale site of `Z` to that
sheaf is an epimorphism, then the same holds for its direct image on the small étale site of
`X`: inverse image along `i` carries the constant sheaf to the constant sheaf, and it reflects
the epimorphisms into a direct image. -/
public theorem epi_constantSheafΓAdj_counit_etalePushforward (G : SmallEtaleAbelianSheaf B Z)
    (hG : Epi ((CategoryTheory.constantSheafΓAdj (SmallEtale.topology B Z.obj Z.property)
      AddCommGrpCat.{u + 1}).counit.app G)) :
    Epi ((CategoryTheory.constantSheafΓAdj (SmallEtale.topology B X.obj X.property)
      AddCommGrpCat.{u + 1}).counit.app ((SmallEtale.etalePushforward.{u, u + 1} B i).obj G)) :=
  epi_counit_of_epi_counit
    (constantSheafΓAdj (SmallEtale.topology B X.obj X.property) AddCommGrpCat.{u + 1})
    (constantSheafΓAdj (SmallEtale.topology B Z.obj Z.property) AddCommGrpCat.{u + 1})
    ((smallEtaleBaseChange B i).sheafAdjunctionContinuous AddCommGrpCat.{u + 1}
      (SmallEtale.topology B X.obj X.property) (SmallEtale.topology B Z.obj Z.property))
    (Functor.isoWhiskerLeft _ (Functor.sheafPullbackConstruction.sheafPullbackIso
        (smallEtaleBaseChange B i) AddCommGrpCat.{u + 1}
        (SmallEtale.topology B X.obj X.property)
        (SmallEtale.topology B Z.obj Z.property)) ≪≫
      Stacks.Cohomology.BiggerSite.constantSheafCompSheafPullbackIso
        (SmallEtale.topology B X.obj X.property) (SmallEtale.topology B Z.obj Z.property)
        (smallEtaleBaseChange B i) AddCommGrpCat.{u + 1}
        (SmallEtale.finalIsTerminal B X.obj X.property)
        (smallEtaleBaseChange_finalIsTerminal B i) rfl)
    G hG inferInstance
    fun _ ψ hψ => epi_of_epi_sheafPullback B i G ψ hψ

end AlgebraicGeometry

end
