module

public import StacksFrontier.AlgebraicGeometry.FiniteTransitionObstruction.Basic
public import StacksFrontier.AlgebraicGeometry.Descent.QuasiCoherent.PullbackSections
public import Mathlib.AlgebraicGeometry.Morphisms.Affine
public import Mathlib.Algebra.Category.Grp.Ulift
public import Mathlib.Algebra.Category.Grp.Zero

/-!
# The descent situation whose limit has no sections

In the descent situation of Tag 09RD — a directed inverse system of quasi-compact and
quasi-separated schemes with affine transition morphisms, together with a limit cone and a chosen
base index — Tag 01Z0 identifies the global sections of the pullback of a quasi-coherent module to
the limit with the filtered colimit of the global sections of its pullbacks to the later stages.
This file gives a descent situation, with the index type in `Type (u+1)` and the schemes in
`Scheme.{u}`, whose index type is not `u`-small and whose limit is empty, and for which that
identification forces the colimit of the stagewise sections to vanish, while the corresponding
colimit of the stage rings does not.

## The counterexample

`Stacks.LimitSectionsCounterexample.collapse` is the descent situation whose system is
`Stacks.EmptyLimitCounterexample.schemeDiagram` at `Stacks.EmptyLimitCounterexample.bigField`: the
spectra of the subrings of a field `F` generated by finite subsets, indexed by `Finset F` ordered
by inclusion. Its index type is **not** `u`-small, and its limit is the **empty** scheme.

Every sheaf of modules on the empty scheme has vanishing global sections, because the ring of
global sections of the empty scheme is the zero ring. So the apex of the canonical cocone is a zero
object, and the assertion of Tag 01Z0 — that the canonical map out of the filtered colimit of the
stagewise sections is an isomorphism — forces that **colimit** to be zero.

It is not. With the structure sheaf as the module on the base stage, the stagewise sections are the
stage rings, their transition maps are the inclusions of subrings of `F`, and the filtered colimit
of that system of abelian groups is nonzero: the cocone into `F` itself has a nonzero leg already
at the base stage, where `1` is sent to `1`.

## Main definitions

* `Stacks.LimitSectionsCounterexample.DescentSituation`: the descent situation of Tag 09RD.
* `Stacks.LimitSectionsCounterexample.pullbackSectionsLimitCocone`: the canonical cocone from the
  sections over the stages to the sections over the limit.
* `Stacks.LimitSectionsCounterexample.collapse`: the system of Tag 06AC as a descent situation,
  with the index type in `Type (u+1)` and the schemes in `Scheme.{u}`.

## Main results

* `Stacks.LimitSectionsCounterexample.not_small_index`: the index type of
  `Stacks.LimitSectionsCounterexample.collapse` is not `u`-small.
* `Stacks.LimitSectionsCounterexample.isEmpty_limit`: the limit of
  `Stacks.LimitSectionsCounterexample.collapse` is the empty scheme.
* `Stacks.LimitSectionsCounterexample.subsingleton_sections_limit`: the global sections of the
  pullback to the limit of **any** module on the base stage vanish.
* `Stacks.LimitSectionsCounterexample.isZero_apex`: the apex of the canonical cocone is a zero
  object.
* `Stacks.LimitSectionsCounterexample.isZero_colimit_of_isIso_colimitDesc`: if the canonical map
  out of the colimit of the stagewise sections is an isomorphism, then that colimit is zero.
* `Stacks.LimitSectionsCounterexample.not_isZero_colimit_stageSections`: the colimit of the
  stagewise sections, computed at the ring level, is **not** zero.

## References

* [The Stacks Project, Tag 01Z0](https://stacks.math.columbia.edu/tag/01Z0)
* [The Stacks Project, Tag 09RD](https://stacks.math.columbia.edu/tag/09RD)
* [The Stacks Project, Tag 03DS](https://stacks.math.columbia.edu/tag/03DS)
* [The Stacks Project, Tag 06AC](https://stacks.math.columbia.edu/tag/06AC)
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry

universe v u

namespace Stacks.LimitSectionsCounterexample

open Stacks.EmptyLimitCounterexample Stacks.FiniteTransitionObstruction

/-- The descent situation of Tag 09RD: a directed inverse system of quasi-compact and
quasi-separated schemes whose transition morphisms are affine, equipped with a chosen limit cone
and a chosen index. -/
structure DescentSituation (I : Type v) [Preorder I] [IsDirected I (· ≤ ·)] where
  /-- The inverse system of schemes. -/
  system : Iᵒᵖ ⥤ Scheme.{u}
  /-- Every transition morphism in the inverse system is affine. -/
  transition_affine : ∀ {i j : Iᵒᵖ} (f : i ⟶ j), IsAffineHom (system.map f)
  /-- Every scheme in the inverse system is quasi-compact. -/
  quasiCompact : ∀ i : I, CompactSpace (system.obj (op i))
  /-- Every scheme in the inverse system is quasi-separated. -/
  quasiSeparated : ∀ i : I, QuasiSeparatedSpace (system.obj (op i))
  /-- The chosen cone exhibiting the limiting scheme and its projections. -/
  limitCone : Cone system
  /-- The chosen cone is limiting. -/
  isLimit : IsLimit limitCone
  /-- The fixed index of the system. -/
  base : I

section Card

variable {I : Type v} [Preorder I] [IsDirected I (· ≤ ·)]

/-- The stages beyond the chosen base stage, regarded contravariantly as schemes over that base. -/
def schemesOverBase (d : DescentSituation.{v, u} I) :
    {i : I // d.base ≤ i} ⥤ (Over (d.system.obj (op d.base)))ᵒᵖ where
  obj i := op (Over.mk (d.system.map (homOfLE i.2).op))
  map {i j} f := (Over.homMk (d.system.map f.op) (by
    change d.system.map f.op ≫ d.system.map (homOfLE i.2).op =
      d.system.map (homOfLE j.2).op
    rw [← d.system.map_comp]
    exact congrArg (fun k ↦ d.system.map k) (Subsingleton.elim _ _))).op
  map_id i := by
    apply Quiver.Hom.unop_inj
    ext
    exact d.system.map_id _
  map_comp f g := by
    apply Quiver.Hom.unop_inj
    ext
    exact d.system.map_comp _ _

/-- The filtered diagram whose value at `i ≥ base` is the universe lift of `Γ(S_i, f_{i0}^* F₀)`,
the sections of the quasi-coherent presheaf `AlgebraicGeometry.quasiCoherentPresheafFunctor` of
Tag 03DS. -/
def pullbackSectionsDiagram (d : DescentSituation.{v, u} I)
    (F₀ : (d.system.obj (op d.base)).Modules) [F₀.IsQuasicoherent] :
    {i : I // d.base ≤ i} ⥤ AddCommGrpCat.{max v u} :=
  (schemesOverBase d ⋙ quasiCoherentPresheafFunctor _ F₀) ⋙
    AddCommGrpCat.uliftFunctor.{v, u}

/-- The limiting scheme, regarded as a scheme over the chosen base stage. -/
def limitOverBase (d : DescentSituation.{v, u} I) :
    Over (d.system.obj (op d.base)) :=
  Over.mk (d.limitCone.π.app (op d.base))

/-- The natural family of maps from the limiting scheme to the stages beyond the base, viewed in
the opposite of the over category. -/
def schemesOverBaseToLimit (d : DescentSituation.{v, u} I) :
    schemesOverBase d ⟶
      (Functor.const {i : I // d.base ≤ i}).obj (op (limitOverBase d)) where
  app i := (Over.homMk (d.limitCone.π.app (op i.1)) (by
    exact d.limitCone.w (homOfLE i.2).op)).op
  naturality {i j} f := by
    apply Quiver.Hom.unop_inj
    ext
    change d.limitCone.π.app (op j.1) ≫ d.system.map f.op =
      d.limitCone.π.app (op i.1)
    simp

/-- The canonical cocone from the universe lifts of `Γ(S_i, f_{i0}^* F₀)` to the universe lift of
`Γ(S, f_0^* F₀)`, induced by pullback along the limit projections. -/
def pullbackSectionsLimitCocone (d : DescentSituation.{v, u} I)
    (F₀ : (d.system.obj (op d.base)).Modules) [F₀.IsQuasicoherent] :
    Cocone (pullbackSectionsDiagram d F₀) :=
  let c : Cocone (schemesOverBase d ⋙ quasiCoherentPresheafFunctor _ F₀) :=
    Cocone.mk
      Γ((Scheme.Modules.pullback (d.limitCone.π.app (op d.base))).obj F₀, ⊤)
      (Functor.whiskerRight (schemesOverBaseToLimit d)
          (quasiCoherentPresheafFunctor _ F₀) ≫
        (Functor.constComp _ _ _).hom ≫
        (Functor.const {i : I // d.base ≤ i}).map
          ((quasiCoherentPresheaf _ F₀).objIso (op (limitOverBase d))).hom)
  AddCommGrpCat.uliftFunctor.{v, u}.mapCocone c

end Card

/-- **The counterexample.** The system `Stacks.EmptyLimitCounterexample.schemeDiagram` of Tag 06AC
at `Stacks.EmptyLimitCounterexample.bigField` is a descent situation with the index preorder in
`Type (u+1)` and the schemes in `Scheme.{u}`: the transition morphisms are affine, every stage is
quasi-compact and quasi-separated, and the cone with empty vertex is a limit cone. -/
def collapse : DescentSituation.{u + 1, u} (Finset bigField.{u}) where
  system := schemeDiagram bigField.{u}
  transition_affine _ := inferInstance
  quasiCompact _ := inferInstance
  quasiSeparated _ := inferInstance
  limitCone := emptyCone bigField.{u}
  isLimit := isLimitEmptyConeBigField.{u}
  base := ∅

/-- The index type of `Stacks.LimitSectionsCounterexample.collapse` is not `u`-small. -/
theorem not_small_index : ¬ Small.{u} (Finset bigField.{u}) :=
  fun _ => not_small_bigField.{u} (small_of_injective Finset.singleton_injective)

/-- The limit of `Stacks.LimitSectionsCounterexample.collapse` is the empty scheme. -/
theorem isEmpty_limit : IsEmpty (collapse.{u}).limitCone.pt :=
  inferInstanceAs (IsEmpty (∅ : Scheme.{u}))

/-- **The global sections of the pullback to the limit vanish.** For every module `F₀` on the base
stage of `Stacks.LimitSectionsCounterexample.collapse`, the global sections of its pullback to the
empty limit form a subsingleton. -/
theorem subsingleton_sections_limit
    (F₀ : ((collapse.{u}).system.obj (op (collapse.{u}).base)).Modules) :
    Subsingleton
      Γ((Scheme.Modules.pullback ((collapse.{u}).limitCone.π.app
        (op (collapse.{u}).base))).obj F₀, ⊤) :=
  have : Subsingleton Γ((collapse.{u}).limitCone.pt, ⊤) :=
    inferInstanceAs (Subsingleton Γ((∅ : Scheme.{u}), ⊤))
  Module.subsingleton Γ((collapse.{u}).limitCone.pt, ⊤) _

/-- **The apex of the canonical cocone is a zero object.** For every quasi-coherent module `F₀` on
the base stage of `Stacks.LimitSectionsCounterexample.collapse`, the apex of the cocone
`Stacks.LimitSectionsCounterexample.pullbackSectionsLimitCocone` at `F₀` is a zero object. -/
theorem isZero_apex (F₀ : ((collapse.{u}).system.obj (op (collapse.{u}).base)).Modules)
    [F₀.IsQuasicoherent] :
    IsZero (pullbackSectionsLimitCocone collapse.{u} F₀).pt :=
  @AddCommGrpCat.isZero_of_subsingleton _
    ⟨fun _ _ => ULift.ext _ _ ((subsingleton_sections_limit.{u} F₀).allEq _ _)⟩

/-- **The colimit vanishes if the comparison map is an isomorphism.** If the canonical map out of
the filtered colimit of the stagewise sections into the apex of the cocone
`Stacks.LimitSectionsCounterexample.pullbackSectionsLimitCocone` at `F₀`, for `F₀` on the base
stage of `Stacks.LimitSectionsCounterexample.collapse`, is an isomorphism, then that filtered
colimit is zero. -/
theorem isZero_colimit_of_isIso_colimitDesc
    (F₀ : ((collapse.{u}).system.obj (op (collapse.{u}).base)).Modules) [F₀.IsQuasicoherent]
    (h : IsIso (colimit.desc _ (pullbackSectionsLimitCocone collapse.{u} F₀))) :
    IsZero (colimit (pullbackSectionsDiagram collapse.{u} F₀)) :=
  (isZero_apex.{u} F₀).of_iso
    (asIso (colimit.desc _ (pullbackSectionsLimitCocone collapse.{u} F₀)))

section StageSections

variable (F : Type (u + 1)) [Field F]

/-- The stagewise sections at the ring level: the stage rings as abelian groups, over the tail of
the index above the base stage `∅`, with the inclusions of subrings as transition maps. -/
def stageGroupDiagram : {T : Finset F // (∅ : Finset F) ≤ T} ⥤ AddCommGrpCat.{u} where
  obj T := AddCommGrpCat.of (stage F T.1)
  map {T T'} f := AddCommGrpCat.ofHom (stageMap F (leOfHom f)).toAddMonoidHom
  map_id T := by
    ext z
    simp [stageMap, RingEquiv.symm_apply_eq, Subtype.ext_iff]
  map_comp f g := by
    ext z
    simp [stageMap, Subtype.ext_iff]

/-- The universe lift of `Stacks.LimitSectionsCounterexample.stageGroupDiagram` to
`AddCommGrpCat.{u + 1}`. -/
def stageSectionsDiagram :
    {T : Finset F // (∅ : Finset F) ≤ T} ⥤ AddCommGrpCat.{u + 1} :=
  stageGroupDiagram F ⋙ AddCommGrpCat.uliftFunctor.{u + 1, u}

/-- The cocone on the stagewise sections whose apex is the field itself: the stage at `T` is a copy
of the subring generated by `T`, and its leg is that subring's inclusion. -/
def fieldCocone : Cocone (stageSectionsDiagram F) where
  pt := AddCommGrpCat.of F
  ι :=
    { app := fun T => AddCommGrpCat.ofHom
        ((stageToField F T.1).toAddMonoidHom.comp AddEquiv.ulift.toAddMonoidHom)
      naturality := fun T T' f => by
        ext z
        exact stageEquiv_stageMap F (leOfHom f) z.down }

/-- The leg of `Stacks.LimitSectionsCounterexample.fieldCocone` at `T` sends the lift of an element
of the stage at `T` to its image in `F` under `Stacks.EmptyLimitCounterexample.stageEquiv`. -/
theorem fieldCocone_ι_app_apply (T : {T : Finset F // (∅ : Finset F) ≤ T})
    (z : ULift.{u + 1, u} (stage F T.1)) :
    ConcreteCategory.hom ((fieldCocone F).ι.app T) z = (stageEquiv F T.1 z.down : F) := rfl

/-- **The colimit of the stagewise sections is not zero.** The colimit of
`Stacks.LimitSectionsCounterexample.stageSectionsDiagram` at
`Stacks.EmptyLimitCounterexample.bigField` is not a zero object. -/
theorem not_isZero_colimit_stageSections :
    ¬ IsZero (colimit (stageSectionsDiagram bigField.{u})) := by
  intro hz
  have hι : colimit.ι (stageSectionsDiagram bigField.{u}) ⟨∅, le_refl _⟩ = 0 :=
    hz.eq_zero_of_tgt _
  have hleg : (fieldCocone bigField.{u}).ι.app ⟨∅, le_refl _⟩ = 0 := by
    rw [← colimit.ι_desc (fieldCocone bigField.{u}) ⟨∅, le_refl _⟩, hι, zero_comp]
  have hone := ConcreteCategory.congr_hom hleg (ULift.up (1 : stage bigField.{u} ∅))
  rw [fieldCocone_ι_app_apply] at hone
  simp only [map_one, Subring.coe_one] at hone
  exact one_ne_zero (α := bigField.{u}) hone

end StageSections

end Stacks.LimitSectionsCounterexample

end
