module

public import StacksFrontier.AlgebraicGeometry.Constructions.ProjTripleUnitSection
public import StacksFrontier.AlgebraicGeometry.Constructions.ProjTripleClassifyingMorphism
public import StacksFrontier.AlgebraicGeometry.RelativeProjBridge.DegreeOneProducts

/-!
# Graded maps out of a ring generated in degree one are determined in degree one

Let `A` be a quasi-coherent graded `𝒪_S`-algebra, `U` an open of `S` over which the graded ring of
sections `A(U)` is generated by `A(U)_1` over `A(U)_0`, and let `ψ, ψ' : A(U) ⟶ Γ_*(Y, -)` be two
graded maps into the section rings of invertible modules `L, L'` on a scheme `Y`, in the
degreewise spelling `Stacks.AlgebraicGeometry.ProjChartFromRatios.VeroneseSections` at weight
one. If an isomorphism `β : L ≅ L'` carries `ψ` to `ψ'` in degree one, and the degree-one values
of `ψ` generate `L`, then `β` carries `ψ` to `ψ'` in every degree: the two graded maps are
strictly equivalent, `Stacks.AlgebraicGeometry.ProjTripleClassifying.SectionsEquiv`.

## Main results

* `Stacks.Tag01VMVeryAmple.sectionsEquiv_of_degreeOne`: **the strict equivalence.**

## References

* [Stacks Project, Tag 01N8](https://stacks.math.columbia.edu/tag/01N8)
* [Stacks Project, Tag 01NB](https://stacks.math.columbia.edu/tag/01NB)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite MonoidalCategory
open AlgebraicGeometry
open Stacks.AlgebraicGeometry.MorphismToProjUniversal
open Stacks.AlgebraicGeometry.ProjChartFromRatios
open Stacks.AlgebraicGeometry.ProjTripleClassifying
open Stacks.AlgebraicGeometry.ProjTripleStructureMorphism
open Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.AlgebraicGeometry.ProjSectionsUnique (eq_of_smul_restrict_eq)
open Stacks.AmplePullbackPart1 (natTensorPowCongr)
open Stacks.NonvanishingOpen (nonvanishingOpen)
open Stacks.TensorPowers (natTensorPow)
open Stacks.TensorPowerTrivialize (resTop)

universe u

namespace Stacks.Tag01VMVeryAmple

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory

variable {S : Scheme.{u}} (A : SheafGradedAlgebra.{u} S) (U : S.Opens) {Y : Scheme.{u}}
  {L L' : Y.Modules} [Stacks.Ample.IsInvertibleModule Y L] [Stacks.Ample.IsInvertibleModule Y L']

/-- Membership in a homogeneous piece of the ring of sections, transported along an equality of
degrees. -/
theorem grading_mem_of_eq {n n' : ℕ} (e : n = n') {x : A.sectionRing U} (h : x ∈ A.grading U n) :
    x ∈ A.grading U n' :=
  e ▸ h

omit [Stacks.Ample.IsInvertibleModule Y L] in
/-- **A degree-zero section is determined, over the nonvanishing open of a degree-one section
`t`, by its product with `t`.** -/
theorem resTop_eq_of_mulSections_eq (t : Γ(natTensorPow L' 1, ⊤)) (x y : Γ(natTensorPow L' 0, ⊤))
    {W : Y.Opens} (hW : W ≤ nonvanishingOpen Y (natTensorPow L' 1) t)
    (h : mulSections L' t x = mulSections L' t y) :
    resTop (natTensorPow L' 0) x W = resTop (natTensorPow L' 0) y W := by
  have hx := congrArg
    (fun z => (natTensorPow L' 0).presheaf.map (homOfLE (le_top : W ≤ ⊤)).op z)
    (divUnit_resTop_top x)
  have hy := congrArg
    (fun z => (natTensorPow L' 0).presheaf.map (homOfLE (le_top : W ≤ ⊤)).op z)
    (divUnit_resTop_top y)
  simp only at hx hy
  rw [Stacks.TensorPowerTrivialize.res_resTop,
    Stacks.TensorPowerTrivialize.map_smul_resTop] at hx hy
  have h3 := resTop_mulSections_smul_right L' t hx
  have h4 := resTop_mulSections_smul_right L' t hy
  rw [Stacks.AlgebraicGeometry.ProjTripleUnitSection.mulSections_unitGlobal_right, h] at h3
  rw [Stacks.AlgebraicGeometry.ProjTripleUnitSection.mulSections_unitGlobal_right] at h4
  rw [hx, hy, eq_of_smul_restrict_eq (natTensorPow L' 1) t hW h3 h4]

/-- **Two graded maps out of a ring generated in degree one which correspond in degree one
under an isomorphism of invertible modules correspond in every degree**, provided the degree-one
values of the first generate its module. -/
theorem sectionsEquiv_of_degreeOne
    (hgen : Algebra.adjoin (A.grading U 0) (A.grading U 1 : Set (A.sectionRing U)) = ⊤)
    (ψ : VeroneseSections (A.grading U) 1 L) (ψ' : VeroneseSections (A.grading U) 1 L')
    (β : L ≅ L')
    (hcov : ⨆ f : A.grading U 1, nonvanishingOpen Y L (psiSection (A.grading U) ψ f) = ⊤)
    (h1 : ∀ x : A.grading U (1 * 1),
      (natTensorPowCongr β 1).hom.app ⊤ (ψ.toFun 1 x) = ψ'.toFun 1 x) :
    SectionsEquiv (A.grading U) ψ ψ' := by
  have hmem : ∀ (k : ℕ) (y : A.sectionPieces U k),
      DirectSum.of (A.sectionPieces U) k y ∈ A.grading U (k * 1) :=
    fun k y => grading_mem_of_eq A U (Nat.mul_one _).symm (A.of_mem_grading U y)
  have hpos : ∀ (n : ℕ) (x : A.grading U ((n + 1) * 1)),
      (natTensorPowCongr β (n + 1)).hom.app ⊤ (ψ.toFun (n + 1) x) = ψ'.toFun (n + 1) x := by
    intro n
    induction n with
    | zero => exact h1
    | succ n ih =>
      let ι : A.sectionPieces U (n + 1 + 1) →+ A.grading U ((n + 1 + 1) * 1) :=
        (DirectSum.of (A.sectionPieces U) (n + 1 + 1)).codRestrict _ (hmem _)
      let c : Γ(natTensorPow L (n + 1 + 1), ⊤) →+ Γ(natTensorPow L' (n + 1 + 1), ⊤) :=
        .mk' (fun x => (natTensorPowCongr β (n + 1 + 1)).hom.app ⊤ x) (map_add _)
      let P : AddSubgroup (A.sectionPieces U (n + 1 + 1)) :=
        AddMonoidHom.eqLocus (c.comp ((ψ.toFun (n + 1 + 1)).comp ι)) ((ψ'.toFun (n + 1 + 1)).comp ι)
      have hP : P = ⊤ := by
        refine SheafGradedAlgebra.eq_top_of_mul_mem_of_adjoin_eq_top A U hgen (n + 1) P ?_
        intro y z
        have hy := hmem (n + 1) y
        have hz : DirectSum.of (A.sectionPieces U) 1 z ∈ A.grading U (1 * 1) :=
          A.of_mem_grading U z
        have hyz : ((⟨_, hmem _ ((A.mul ((n + 1 : ℕ) : ℤ) 1).app U y z)⟩ :
            A.grading U ((n + 1 + 1) * 1)) : A.sectionRing U) =
            ((⟨_, hy⟩ : A.grading U ((n + 1) * 1)) : A.sectionRing U) *
              ((⟨_, hz⟩ : A.grading U (1 * 1)) : A.sectionRing U) :=
          (DirectSum.of_mul_of y z).symm
        change (natTensorPowCongr β (n + 1 + 1)).hom.app ⊤ (ψ.toFun (n + 1 + 1) ⟨_, hmem _ _⟩) =
          ψ'.toFun (n + 1 + 1) ⟨_, hmem _ _⟩
        rw [ψ.map_mul (n + 1) 1 ⟨_, hy⟩ ⟨_, hz⟩ _ hyz, ψ'.map_mul (n + 1) 1 ⟨_, hy⟩ ⟨_, hz⟩ _ hyz,
          mulSections_natTensorPowCongr, ih, h1]
      intro x
      have hx : (x : A.sectionRing U) =
          DirectSum.of (A.sectionPieces U) (n + 1 + 1) ((x : A.sectionRing U) (n + 1 + 1)) := by
        obtain ⟨y, hy⟩ := (A.mem_grading_iff U (x : A.sectionRing U)).mp
          (grading_mem_of_eq A U (Nat.mul_one _) x.2)
        rw [← hy, DirectSum.of_eq_same]
      have hmemx : ((x : A.sectionRing U) (n + 1 + 1)) ∈ P := hP ▸ AddSubgroup.mem_top _
      have e : x = ⟨_, hmem _ ((x : A.sectionRing U) (n + 1 + 1))⟩ := Subtype.ext hx
      rw [e]
      exact hmemx
  refine ⟨β, fun n => ?_⟩
  cases n with
  | succ n => exact hpos n
  | zero =>
    intro a
    change ψ.toFun 0 a = ψ'.toFun 0 a
    refine sub_eq_zero.mp (Stacks.Algebraization.eq_zero_of_affine_cover _
      (fun f : A.grading U 1 => nonvanishingOpen Y L (psiSection (A.grading U) ψ f)) hcov
      fun B f hBV hBU => ?_)
    have hf1 : (f : A.sectionRing U) ∈ A.grading U (1 * 1) := f.2
    have hfa : (f : A.sectionRing U) * (a : A.sectionRing U) ∈ A.grading U ((1 + 0) * 1) :=
      grading_mem_of_eq A U (by norm_num) (SetLike.mul_mem_graded f.2 a.2)
    have hmul := ψ.map_mul 1 0 ⟨_, hf1⟩ a ⟨_, hfa⟩ rfl
    have hmul' := ψ'.map_mul 1 0 ⟨_, hf1⟩ a ⟨_, hfa⟩ rfl
    have key : mulSections L' (ψ'.toFun 1 ⟨_, hf1⟩)
          (show Γ(natTensorPow L' 0, ⊤) from ψ.toFun 0 a) =
        mulSections L' (ψ'.toFun 1 ⟨_, hf1⟩) (ψ'.toFun 0 a) := by
      have s1 : mulSections L' (ψ'.toFun 1 ⟨_, hf1⟩)
            (show Γ(natTensorPow L' 0, ⊤) from ψ.toFun 0 a) =
          mulSections L' ((natTensorPowCongr β 1).hom.app ⊤ (ψ.toFun 1 ⟨_, hf1⟩))
            ((natTensorPowCongr β 0).hom.app ⊤ (ψ.toFun 0 a)) := by
        rw [h1]
        rfl
      rw [s1, ← mulSections_natTensorPowCongr β 1 0, ← hmul]
      exact (h1 ⟨_, hfa⟩).trans hmul'
    have hW : nonvanishingOpen Y L (psiSection (A.grading U) ψ f) ≤
        nonvanishingOpen Y (natTensorPow L' 1) (ψ'.toFun 1 ⟨_, hf1⟩) := by
      refine le_of_eq ?_
      rw [nonvanishingOpen_psiSection, ← h1 ⟨_, hf1⟩,
        ψ.toFun_eq_pow f.2 1 ⟨_, hf1⟩ (pow_one _).symm]
      exact Opens.ext (Stacks.Ample.nonvanishingLocus_congr (natTensorPowCongr β 1) _).symm
    have e := resTop_eq_of_mulSections_eq (L' := L') _ (ψ.toFun 0 a) (ψ'.toFun 0 a) hW key
    have e1 := Stacks.TensorPowerTrivialize.res_resTop (natTensorPow L 0) (ψ.toFun 0 a)
      (homOfLE hBU)
    have e2 := Stacks.TensorPowerTrivialize.res_resTop (natTensorPow L 0) (ψ'.toFun 0 a)
      (homOfLE hBU)
    have e3 : ∀ x : Γ(natTensorPow L 0, ⊤),
        (natTensorPow L 0).val.map (homOfLE hBV).op x
          = resTop (natTensorPow L 0) x (B : Y.Opens) := fun _ => rfl
    have e4 : (natTensorPow L 0).val.map (homOfLE hBV).op (ψ.toFun 0 a) =
        (natTensorPow L 0).val.map (homOfLE hBV).op (ψ'.toFun 0 a) :=
      (e3 _).trans (e1.symm.trans ((congrArg
        (fun z => (natTensorPow L 0).presheaf.map (homOfLE hBU).op z) e).trans
          (e2.trans (e3 _).symm)))
    exact (map_sub _ _ _).trans (sub_eq_zero_of_eq e4)

end Stacks.Tag01VMVeryAmple

end
