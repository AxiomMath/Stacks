/-!
# Quasi-regularity of the first of two immersions with split conormal sequence

Let `i : Z ⟶ Y` and `j : Y ⟶ X` be immersions with `j` locally of finite presentation whose
conormal sequence is exact and locally split.  If `i ≫ j` is quasi-regular, then so is `i`.  This
is part (1) of [Stacks Project, Tag 068Z].

The argument is local at a point `z` of `Z`.  Near `x = j (i z)` the ideal `I` of `Y` is generated
by sections `f₁, …, f_n` whose classes are a basis of `I_x / 𝔪_x I_x`, and these extend to a basis
of `J_x / 𝔪_x J_x` for the ideal `J` of `Z` by sections `g₁, …, g_m`.  Applying
[Stacks Project, Tag 067N] to `J` turns the whole family into a quasi-regular sequence generating
`J` on one neighbourhood of `x`, and by [Stacks Project, Tag 061R] the images of the `g_b` in
`O_Y` then form a quasi-regular sequence generating the ideal of `i`.

The same conclusion holds when `j` is quasi-regular and admits a retraction instead of having a
split exact conormal sequence: a retraction of `j` splits the map of local rings, and that
splitting makes the adapted bases of the cotangent fibres available with neither exactness nor
finite presentation.

## References

* [Stacks Project, Lemma 31.22.8 (Tag 068Z)](https://stacks.math.columbia.edu/tag/068Z)
* [Stacks Project, Lemma 31.20.5 (Tag 067N)](https://stacks.math.columbia.edu/tag/067N)
* [Stacks Project, Lemma 10.69.5 (Tag 061R)](https://stacks.math.columbia.edu/tag/061R)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open RingTheory.Sequence
open Stacks.RingTheory.QuasiRegular
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

namespace Stacks.AlgebraicGeometry

variable {Z Y X : Scheme.{u}}

/-! ### Commutative algebra of quasi-regular sequences -/

section Algebra

/-- Quasi-regularity only depends on the sequence. -/
private lemma isQuasiRegular_congr {R : Type*} [CommRing R] {r : ℕ} {f g : Fin r → R} (h : f = g)
    (hf : IsQuasiRegular R (List.ofFn f)) : IsQuasiRegular R (List.ofFn g) := h ▸ hf

/-- Quasi-regularity of a finite sequence transports along a ring isomorphism. -/
private theorem isQuasiRegular_of_ringEquiv {R S : Type*} [CommRing R] [CommRing S] (e : R ≃+* S)
    {r : ℕ} {f : Fin r → R} (hf : IsQuasiRegular R (List.ofFn f)) :
    IsQuasiRegular S (List.ofFn fun k => e (f k)) := by
  rw [Stacks.RingTheory.RegularIdealSheaf.isQuasiRegular_ofFn_iff,
    ← Stacks.RingTheory.RegularIdealSheaf.isQuasiRegularRel_iff_bijective] at hf ⊢
  exact Stacks.RingTheory.RegularIdealSheaf.isQuasiRegularRel_ringEquiv e f hf

/-- The ideal generated by a finite list is the ideal generated by the sequence it enumerates. -/
private lemma ofList_ofFn_eq_jid {R : Type*} [CommRing R] {n : ℕ} (f : Fin n → R) :
    Ideal.ofList (List.ofFn f) = Jid f :=
  Stacks.AlgebraicGeometry.RegularIdealSheaf.ideal_ofList_ofFn f

/-- For a ring viewed as a module over itself, quasi-regularity over the quotient module by an
ideal times the whole ring is quasi-regularity over the quotient ring. -/
private lemma isQuasiRegular_quotient_of_smulTop {R : Type*} [CommRing R] (I : Ideal R)
    (l : List (R ⧸ I)) (h : IsQuasiRegular (R ⧸ (I • (⊤ : Submodule R R))) l) :
    IsQuasiRegular (R ⧸ I) l := by
  have hI : I • (⊤ : Submodule R R) = I := by simp
  have hsurj : Function.Surjective (algebraMap R (R ⧸ I)) := Ideal.Quotient.mk_surjective
  have h' := h.of_flat_of_isBaseChange (S := R ⧸ I)
    (IsBaseChange.ofEquiv (LinearEquiv.extendScalarsOfSurjective hsurj
      (Submodule.quotEquivOfEq _ _ hI)))
  simpa using h'

/-- **Stacks Project, Tag 061R, for a concatenation.** If a concatenated sequence is quasi-regular,
then the image of its tail in the quotient by the ideal generated by its head is
quasi-regular. -/
private theorem isQuasiRegular_quotient_of_append {R : Type*} [CommRing R] {n m : ℕ}
    (f : Fin n → R) (g : Fin m → R) (h : IsQuasiRegular R (List.ofFn (Fin.append f g))) :
    IsQuasiRegular (R ⧸ Jid f) (List.ofFn fun b => Ideal.Quotient.mk (Jid f) (g b)) := by
  rw [List.ofFn_fin_append] at h
  have hd := h.quasiRegular_drop_mod_prev (List.ofFn f).length
  rw [List.take_append_length, List.drop_append_length, ofList_ofFn_eq_jid] at hd
  have hq := isQuasiRegular_quotient_of_smulTop (Jid f) _ hd
  rw [List.map_ofFn] at hq
  exact hq

/-- **Stacks Project, Tag 061R, read through a surjection.** If `f` generates the kernel of a
surjective ring map `φ` and the concatenation of `f` and `g` is quasi-regular, then `φ ∘ g` is
quasi-regular. -/
private theorem isQuasiRegular_map_of_ker_eq_jid {R S : Type*} [CommRing R] [CommRing S]
    (φ : R →+* S) (hφ : Function.Surjective φ) {n m : ℕ} (f : Fin n → R) (g : Fin m → R)
    (hker : Jid f = RingHom.ker φ)
    (h : IsQuasiRegular R (List.ofFn (Fin.append f g))) :
    IsQuasiRegular S (List.ofFn fun b => φ (g b)) := by
  have he : (fun b : Fin m => ((Ideal.quotEquivOfEq hker).trans
      (RingHom.quotientKerEquivOfSurjective hφ)) (Ideal.Quotient.mk (Jid f) (g b)))
      = fun b => φ (g b) := by
    funext b
    change (RingHom.quotientKerEquivOfSurjective hφ)
      ((Ideal.quotEquivOfEq hker) (Ideal.Quotient.mk (Jid f) (g b))) = φ (g b)
    rw [Ideal.quotEquivOfEq_mk]
    exact RingHom.quotientKerEquivOfSurjective_apply_mk hφ (g b)
  exact isQuasiRegular_congr he
    (isQuasiRegular_of_ringEquiv _ (isQuasiRegular_quotient_of_append f g h))

end Algebra

/-! ### Germs of a concatenated family -/

section Germs

/-- Sheaf quasi-regularity of a family of sections over an open set is germwise
quasi-regularity. -/
private lemma isIso_quasiRegularMap_iff_forall_germ {W : RingedSpace.{u}} {r : ℕ} (U : Opens W)
    (f : Fin r → W.presheaf.obj (op U)) :
    IsIso (quasiRegularMap (W.restrict U.isOpenEmbedding)
        (fun i => sectionOnRestriction W U (f i))).hom ↔
      ∀ (y : W) (hy : y ∈ U), IsQuasiRegular (W.presheaf.stalk y)
        (List.ofFn (germFamily W U f y hy)) := by
  rw [isQuasiRegularMapIso_iff_forall_germ W U f]
  exact forall_congr' fun y => forall_congr' fun hy =>
    (Stacks.RingTheory.RegularIdealSheaf.isQuasiRegularRel_iff_bijective _).trans
      (Stacks.RingTheory.RegularIdealSheaf.isQuasiRegular_ofFn_iff _).symm

end Germs

/-! ### Moving generating families along an open immersion -/

section OpenImmersion

/-- Germwise quasi-regularity of a family of sections is preserved by transport to the image of an
open immersion. -/
private theorem isQuasiRegular_germ_image {W : Scheme.{u}} (f : W ⟶ X) [IsOpenImmersion f]
    (U : W.Opens) {r : ℕ} (s : Fin r → Γ(W, U))
    (h : ∀ (x : W) (hx : x ∈ U), IsQuasiRegular (W.presheaf.stalk x)
      (List.ofFn (germFamily W.toRingedSpace U s x hx)))
    (y : X) (hy : y ∈ f ''ᵁ U) :
    IsQuasiRegular (X.presheaf.stalk y)
      (List.ofFn (germFamily X.toRingedSpace (f ''ᵁ U)
        (fun b => (f.appIso U).inv (s b)) y hy)) := by
  obtain ⟨x, hx, hxy⟩ := id hy
  subst hxy
  refine isQuasiRegular_congr
    (f := fun b => (asIso (f.stalkMap x)).commRingCatIsoToRingEquiv.symm
      (germFamily W.toRingedSpace U s x hx b)) ?_
    (isQuasiRegular_of_ringEquiv
      (asIso (f.stalkMap x)).commRingCatIsoToRingEquiv.symm (h x hx))
  funext b
  exact ((asIso (f.stalkMap x)).commRingCatIsoToRingEquiv.symm_apply_eq).mpr
    (germ_appIso_inv f U x hx hy (s b)).symm

/-- Germwise quasi-regularity of a family of sections is preserved by pullback along an open
immersion. -/
private theorem isQuasiRegular_germ_preimage {W : Scheme.{u}} (f : W ⟶ X) [IsOpenImmersion f]
    (U : X.Opens) {r : ℕ} (s : Fin r → Γ(X, U))
    (h : ∀ (y : X) (hy : y ∈ U), IsQuasiRegular (X.presheaf.stalk y)
      (List.ofFn (germFamily X.toRingedSpace U s y hy)))
    (x : W) (hx : x ∈ f ⁻¹ᵁ U) :
    IsQuasiRegular (W.presheaf.stalk x)
      (List.ofFn (germFamily W.toRingedSpace (f ⁻¹ᵁ U) (fun b => f.app U (s b)) x hx)) := by
  have hfx : f x ∈ U := hx
  refine isQuasiRegular_congr
    (f := fun b => (asIso (f.stalkMap x)).commRingCatIsoToRingEquiv
      (germFamily X.toRingedSpace U s (f x) hfx b)) ?_
    (isQuasiRegular_of_ringEquiv (asIso (f.stalkMap x)).commRingCatIsoToRingEquiv (h (f x) hfx))
  funext b
  exact Scheme.Hom.germ_stalkMap_apply f U x hfx (s b)

/-- Restricting the defining ideal of an immersion to its coborder range gives the defining ideal
of the lift. -/
private lemma idealRestriction_coborderRange_definingIdealOfHom (j : Z ⟶ X) [IsImmersion j] :
    idealRestriction j.coborderRange.ι (definingIdealOfHom j) =
      definingIdealOfHom j.liftCoborder := by
  rw [show definingIdealOfHom j =
    definingIdealOfHom (j.liftCoborder ≫ j.coborderRange.ι) from
      (congrArg definingIdealOfHom j.liftCoborder_ι).symm]
  exact definingIdealOfHom_comp_open j.liftCoborder j.coborderRange.ι

/-- The coborder range inclusion maps the lift of a point to the point itself. -/
private lemma coborderRange_ι_liftCoborder_apply (j : Z ⟶ X) [IsImmersion j] (z : Z) :
    j.coborderRange.ι (j.liftCoborder z) = j z := by
  rw [← Scheme.Hom.comp_apply, j.liftCoborder_ι]

/-- **Local quasi-regular generators of the defining ideal sheaf of an immersion.** A quasi-regular
immersion has, near every point of its image, a germwise quasi-regular family of sections
generating its defining ideal sheaf on the target. -/
private theorem exists_quasiRegular_generators_near_image (j : Z ⟶ X) [IsImmersion j]
    (hQ : IsQuasiRegularImmersion j) (z : Z) :
    ∃ (V : X.Opens) (_ : j z ∈ V) (n : ℕ) (t : Fin n → Γ(X, V)),
      (∀ (y : X) (hy : y ∈ V), IsQuasiRegular (X.presheaf.stalk y)
        (List.ofFn (germFamily X.toRingedSpace V t y hy))) ∧
        IsGeneratedByOn X.toRingedSpace (definingIdealOfHom j) V t := by
  have hzU : j.liftCoborder z ∈ idealQuotientSupport
      j.coborderRange.toScheme.toRingedSpace (definingIdealOfHom j.liftCoborder) := by
    rw [definingIdealQuotient_support_eq_range]
    exact ⟨z, rfl⟩
  have hpt := coborderRange_ι_liftCoborder_apply j z
  obtain ⟨V, hzV, n, s, hs, hgen⟩ := hQ (j.liftCoborder z) hzU
  refine ⟨j.coborderRange.ι ''ᵁ V, ⟨j.liftCoborder z, hzV, hpt⟩, n,
    fun b => (j.coborderRange.ι.appIso V).inv (s b), ?_,
    (isGeneratedByOn_image_iff j.coborderRange.ι (definingIdealOfHom j) V s).mpr
      (idealRestriction_coborderRange_definingIdealOfHom j ▸ hgen)⟩
  exact isQuasiRegular_germ_image j.coborderRange.ι V s
    ((isIso_quasiRegularMap_iff_forall_germ V s).mp hs)

/-- The stalk of the defining ideal sheaf of a quasi-regular immersion is finitely generated. -/
private theorem quasiRegularImmersion_stalkIdeal_fg (j : Z ⟶ X) [IsImmersion j]
    (hQ : IsQuasiRegularImmersion j) (z : Z) :
    (Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (definingIdealOfHom j) (j z)).FG := by
  obtain ⟨V, hzV, n, t, _, hgen⟩ := exists_quasiRegular_generators_near_image j hQ z
  exact stalkIdeal_fg_of_isGeneratedByOn (definingIdealOfHom j) V t hgen (j z) hzV

end OpenImmersion

/-! ### Realising a basis of the cotangent fibre by quasi-regular generators -/

section Local067N

/-- **Stacks Project, Tag 067N, part (1), from a local witness.** Let `J` be an ideal subsheaf
generated on a neighbourhood `V` of `x` by a germwise quasi-regular family, and let
`f₁, …, f_r ∈ J_x` lift a basis of `J_x / 𝔪_x J_x`.  Then on a smaller neighbourhood the `f_i` are
the germs of sections of `J` forming a germwise quasi-regular family which generates `J`
there. -/
private theorem exists_quasiRegular_generators_of_basis_local {W : LocallyRingedSpace.{u}}
    (J : (Stacks.RingedSpace.structureSheafModule W.toRingedSpace).Submodule) (x : W) {r s : ℕ}
    (f : Fin r → Stacks.RingedSpace.stalkIdeal J x)
    (b : Module.Basis (Fin r) (W.presheaf.stalk x ⧸ IsLocalRing.maximalIdeal (W.presheaf.stalk x))
      (Stacks.RingedSpace.idealCotangentFiber J x))
    (hf : ∀ i, b i = Submodule.Quotient.mk (f i))
    (hne : Stacks.RingedSpace.stalkIdeal J x ≠ ⊤)
    (V : Opens W) (hxV : x ∈ V) (g : Fin s → W.presheaf.obj (op V))
    (hqr : ∀ (y : W) (hy : y ∈ V), IsQuasiRegular (W.presheaf.stalk y)
      (List.ofFn (germFamily W.toRingedSpace V g y hy)))
    (hgen : IsGeneratedByOn W.toRingedSpace J V g) :
    ∃ (U : Opens W) (hxU : x ∈ U) (fU : Fin r → J.obj (op U)),
      (∀ i, W.presheaf.germ U x hxU (fU i).1 = (f i).1) ∧
        (∀ (y : W) (hy : y ∈ U), IsQuasiRegular (W.presheaf.stalk y)
          (List.ofFn (germFamily W.toRingedSpace U (fun i => (fU i).1) y hy))) ∧
        IsGeneratedByOn W.toRingedSpace J U fun i => (fU i).1 := by
  classical
  obtain ⟨hrs, U, hxU, iUV, fU, A, hA, hfU, hchange⟩ :=
    Stacks.RingedSpace.exists_invertible_change_of_local_generators J x f b hf hne V hxV g
      (fun y hy => stalkIdeal_eq_jid_of_isGeneratedByOn J g hgen y hy) hqr
  subst hrs
  simp only [Fin.cast_refl, id_eq] at hchange
  have hUV : U ≤ V := leOfHom iUV
  have hchange' : ∀ i, (fU i).1 = ∑ j, A i j * W.presheaf.map (homOfLE hUV).op (g j) := by
    intro i
    simpa only [show iUV = homOfLE hUV from Subsingleton.elim _ _] using hchange i
  have hspan : ∀ (y : W) (hy : y ∈ U),
      Jid (germFamily W.toRingedSpace U (fun i => (fU i).1) y hy) =
        Jid (germFamily W.toRingedSpace V g y (hUV hy)) := by
    intro y hy
    refine jid_eq_of_isUnit_matrix _ _ ((W.presheaf.germ U y hy).hom.mapMatrix A)
      (hA.map (W.presheaf.germ U y hy).hom.mapMatrix) fun i => ?_
    have h := congrArg (W.presheaf.germ U y hy) (hchange' i)
    simpa only [map_sum, map_mul, RingHom.mapMatrix_apply, Matrix.map_apply,
      W.presheaf.germ_res_apply, germFamily] using h
  refine ⟨U, hxU, fU, hfU, fun y hy => ?_, ?_⟩
  · exact (Koszul.regularity_of_generators_of_eq_span_range
      (Jid (germFamily W.toRingedSpace U (fun i => (fU i).1) y hy)) _ rfl).1
      ⟨germFamily W.toRingedSpace V g y (hUV hy), (hspan y hy).symm, hqr y (hUV hy)⟩
  · refine isGeneratedByOn_of_forall_stalkIdeal_eq J _ fun y hy => ?_
    rw [hspan y hy]
    exact stalkIdeal_eq_jid_of_isGeneratedByOn J g hgen y (hUV hy)

end Local067N

/-! ### The tail of an adapted generating family -/

section Tail

/-- The tail of a germwise quasi-regular generating family of the ideal of `Z` is a germwise
quasi-regular family on `Y`. -/
private theorem isQuasiRegular_germ_tail (j : Z ⟶ X) [IsImmersion j] (U : X.Opens) {n m : ℕ}
    (f : Fin n → Γ(X, U)) (g : Fin m → Γ(X, U))
    (hgen : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom j) U f)
    (hfg : ∀ (y : X) (hy : y ∈ U), IsQuasiRegular (X.presheaf.stalk y)
      (List.ofFn (germFamily X.toRingedSpace U (Fin.append f g) y hy)))
    (z : Z) (hz : z ∈ j ⁻¹ᵁ U) :
    IsQuasiRegular (Z.presheaf.stalk z)
      (List.ofFn (germFamily Z.toRingedSpace (j ⁻¹ᵁ U) (fun b => j.app U (g b)) z hz)) := by
  have hzU : j z ∈ U := hz
  have hqrfg := hfg (j z) hzU
  rw [germFamily_append] at hqrfg
  refine isQuasiRegular_congr
    (f := fun b => (j.stalkMap z).hom (X.presheaf.germ U (j z) hzU (g b))) ?_
    (isQuasiRegular_map_of_ker_eq_jid (j.stalkMap z).hom (j.stalkMap_surjective z)
      (germFamily X.toRingedSpace U f (j z) hzU) (germFamily X.toRingedSpace U g (j z) hzU)
      (ker_stalkMap_eq_jid j U f hgen z hzU).symm hqrfg)
  funext b
  exact Scheme.Hom.germ_stalkMap_apply j U z hzU (g b)

/-- **The tail of two adapted generating families generates the ideal of `i` quasi-regularly.**
Let `i : Z ⟶ Y` and `j : Y ⟶ X` be immersions, let `x = j (i z)`, let the ideal of `j` be
generated near `x` by `f₁, …, f_n` and the ideal of `i ≫ j` by a germwise quasi-regular family
whose first `n` members have the same germs at `x` as the `f_a`. Then the images in `O_Y` of the
remaining members generate the ideal of `i` germwise quasi-regularly near `i z`. -/
private theorem exists_quasiRegular_tail_of_families (i : Z ⟶ Y) (j : Y ⟶ X)
    [IsImmersion j] (z : Z) {n m : ℕ} (Vf Vt : X.Opens)
    (hxVf : j (i z) ∈ Vf) (hxVt : j (i z) ∈ Vt)
    (fU : Fin n → Γ(X, Vf)) (t : Fin (n + m) → Γ(X, Vt))
    (hgerm : ∀ a : Fin n, X.toLocallyRingedSpace.presheaf.germ Vf (j (i z)) hxVf (fU a)
      = X.toLocallyRingedSpace.presheaf.germ Vt (j (i z)) hxVt (t (Fin.castAdd m a)))
    (hgenf : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom j) Vf fU)
    (hQt : ∀ (y : X) (hy : y ∈ Vt), IsQuasiRegular (X.presheaf.stalk y)
      (List.ofFn (germFamily X.toRingedSpace Vt t y hy)))
    (hgent : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom (i ≫ j)) Vt t) :
    ∃ (T : Y.Opens) (_ : i z ∈ T) (m : ℕ) (tail : Fin m → Γ(Y, T)),
      (∀ (y : Y) (hy : y ∈ T), IsQuasiRegular (Y.presheaf.stalk y)
        (List.ofFn (germFamily Y.toRingedSpace T tail y hy))) ∧
        IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom i) T tail := by
  classical
  obtain ⟨O, hxO, hOf, hOt, hsections⟩ :=
    exists_open_map_eq_of_germ_eq (W := X.toLocallyRingedSpace) (j (i z)) Vf Vt hxVf hxVt
      fU (fun a => t (Fin.castAdd m a)) hgerm
  have hsplit : (fun k => X.presheaf.map (homOfLE hOt).op (t k)) =
      Fin.append (fun a => X.presheaf.map (homOfLE hOf).op (fU a))
        fun b => X.presheaf.map (homOfLE hOt).op (t (Fin.natAdd n b)) := by
    funext k
    refine Fin.addCases (fun a => ?_) (fun b => ?_) k
    · rw [Fin.append_left]
      exact (hsections a).symm
    · rw [Fin.append_right]
  have hgenfO : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom j) O
      fun a => X.presheaf.map (homOfLE hOf).op (fU a) :=
    isGeneratedByOn_of_le _ _ hgenf O hOf
  have hQtO : ∀ (y : X) (hy : y ∈ O), IsQuasiRegular (X.presheaf.stalk y)
      (List.ofFn (germFamily X.toRingedSpace O
        (fun k => X.presheaf.map (homOfLE hOt).op (t k)) y hy)) := by
    intro y hy
    rw [germFamily_res Vt O hOt t y hy]
    exact hQt y (hOt hy)
  have hgentO : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom (i ≫ j)) O
      fun k => X.presheaf.map (homOfLE hOt).op (t k) :=
    isGeneratedByOn_of_le _ _ hgent O hOt
  rw [hsplit] at hQtO hgentO
  exact ⟨j ⁻¹ᵁ O, hxO, m, _,
    fun y hy => isQuasiRegular_germ_tail j O _ _ hgenfO hQtO y hy,
    isGeneratedByOn_tail_of_comp i j O _ _ hgenfO hgentO⟩

/-- **A quasi-regular family generating the ideal of `i` near a point.** For immersions whose
conormal sequence is exact and locally split, with `i ≫ j` a quasi-regular immersion, the ideal of
`i` is generated near every point of `Z` by a germwise quasi-regular family of sections of
`O_Y`. -/
private theorem exists_quasiRegular_tail_near_image (i : Z ⟶ Y) (j : Y ⟶ X) [IsImmersion i]
    [IsImmersion j] [LocallyOfFinitePresentation j] (hS : IsSplitExactConormalSequence i j)
    (hij : IsQuasiRegularImmersion (i ≫ j)) (z : Z) :
    ∃ (T : Y.Opens) (_ : i z ∈ T) (m : ℕ) (tail : Fin m → Γ(Y, T)),
      (∀ (y : Y) (hy : y ∈ T), IsQuasiRegular (Y.presheaf.stalk y)
        (List.ofFn (germFamily Y.toRingedSpace T tail y hy))) ∧
        IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom i) T tail := by
  classical
  obtain ⟨U, hxU, n, m, f, g, -, -, -, hgenI, _hfI, hfJ, hgJ, _bI, bJ, _hbI, hbJl, hbJr⟩ :=
    exists_adapted_local_generators i j hS z
      (quasiRegularImmersion_stalkIdeal_fg (i ≫ j) hij z)
  obtain ⟨Vc, hxVc, nc, qc, hqc, hgenc⟩ :=
    exists_quasiRegular_generators_near_image (i ≫ j) hij z
  have hbJ' : ∀ k, (bJ.reindex (finSumFinEquiv (m := n) (n := m))) k =
      Submodule.Quotient.mk ((Sum.elim
        (fun a => (⟨X.presheaf.germ U (j (i z)) hxU (f a), hfJ a⟩ :
          Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
            (definingIdealOfHom (i ≫ j)) (j (i z))))
        fun b => ⟨X.presheaf.germ U (j (i z)) hxU (g b), hgJ b⟩)
          (finSumFinEquiv.symm k)) := by
    intro k
    refine Fin.addCases (fun a => ?_) (fun b => ?_) k
    · rw [Module.Basis.reindex_apply, finSumFinEquiv_symm_apply_castAdd]
      exact hbJl a
    · rw [Module.Basis.reindex_apply, finSumFinEquiv_symm_apply_natAdd]
      exact hbJr b
  obtain ⟨Vt, hxVt, t, ht, hqt, hgent⟩ :=
    exists_quasiRegular_generators_of_basis_local (definingIdealOfHom (i ≫ j)) (j (i z))
      (fun k => Sum.elim
        (fun a => (⟨X.presheaf.germ U (j (i z)) hxU (f a), hfJ a⟩ :
          Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
            (definingIdealOfHom (i ≫ j)) (j (i z))))
        (fun b => ⟨X.presheaf.germ U (j (i z)) hxU (g b), hgJ b⟩) (finSumFinEquiv.symm k))
      (bJ.reindex (finSumFinEquiv (m := n) (n := m))) hbJ'
      (stalkIdeal_definingIdealOfHom_ne_top (i ≫ j) z) Vc hxVc qc hqc hgenc
  exact exists_quasiRegular_tail_of_families i j z U Vt hxU hxVt f (fun k => (t k).1)
    (fun a => by
      have h := ht (Fin.castAdd m a)
      rw [finSumFinEquiv_symm_apply_castAdd] at h
      exact h.symm)
    hgenI hqt hgent

/-- **An immersion is quasi-regular as soon as its ideal is generated near every point of the
source by a germwise quasi-regular family.**  Away from the image of the source the ideal is the
unit ideal, generated by the quasi-regular family `1`. -/
private theorem isQuasiRegularImmersion_of_forall_quasiRegular_tail (i : Z ⟶ Y) [IsImmersion i]
    (htail : ∀ z : Z, ∃ (T : Y.Opens) (_ : i z ∈ T) (m : ℕ) (tail : Fin m → Γ(Y, T)),
      (∀ (y : Y) (hy : y ∈ T), IsQuasiRegular (Y.presheaf.stalk y)
        (List.ofFn (germFamily Y.toRingedSpace T tail y hy))) ∧
        IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom i) T tail) :
    IsQuasiRegularImmersion i := by
  classical
  intro x _
  by_cases hrange : x ∈ Set.range i.liftCoborder.base
  · obtain ⟨z, rfl⟩ := hrange
    obtain ⟨T, hyT, m, tail, hqr, hgen⟩ := htail z
    have hpt := coborderRange_ι_liftCoborder_apply i z
    have hxO : i.liftCoborder z ∈ i.coborderRange.ι ⁻¹ᵁ T := by
      change i.coborderRange.ι (i.liftCoborder z) ∈ T
      rw [hpt]
      exact hyT
    have hgenO := isGeneratedByOn_restriction i.coborderRange.ι (definingIdealOfHom i) T tail hgen
    rw [idealRestriction_coborderRange_definingIdealOfHom] at hgenO
    exact ⟨i.coborderRange.ι ⁻¹ᵁ T, hxO, m, fun b => i.coborderRange.ι.app T (tail b),
      (isIso_quasiRegularMap_iff_forall_germ _ _).mpr
        (isQuasiRegular_germ_preimage i.coborderRange.ι T tail hqr), hgenO⟩
  · have hspan : ∀ (y : i.coborderRange.toScheme) (hy : y ∈ (⟨(Set.range i.liftCoborder.base)ᶜ,
        i.liftCoborder.isClosedEmbedding.isClosed_range.isOpen_compl⟩ :
          i.coborderRange.toScheme.Opens)),
        Jid (germFamily i.coborderRange.toScheme.toRingedSpace _
          (fun _ : Fin 1 => (1 : Γ(i.coborderRange.toScheme, _))) y hy) = ⊤ :=
      fun y hy => (Ideal.eq_top_iff_one _).mpr (Ideal.subset_span ⟨0, by simp [germFamily]⟩)
    refine ⟨⟨(Set.range i.liftCoborder.base)ᶜ,
      i.liftCoborder.isClosedEmbedding.isClosed_range.isOpen_compl⟩, hrange, 1, fun _ => 1, ?_, ?_⟩
    · refine (isIso_quasiRegularMap_iff_forall_germ _ _).mpr fun y hy => ?_
      refine Stacks.AlgebraicGeometry.QuasiRegularUnitIdeal.isQuasiRegular_of_isUnit_mem
        (u := germFamily i.coborderRange.toScheme.toRingedSpace _
          (fun _ : Fin 1 => (1 : Γ(i.coborderRange.toScheme, _))) y hy 0) ?_
        (List.mem_ofFn.mpr ⟨0, rfl⟩)
      simp [germFamily]
    · refine isGeneratedByOn_of_forall_stalkIdeal_eq (definingIdealOfHom i.liftCoborder) _
        fun y hy => ?_
      rw [hspan y hy]
      exact stalkIdeal_definingIdealOfHom_eq_top_of_notMem_range i.liftCoborder y hy

end Tail

/-! ### Part (1) of Stacks tag 068Z -/

/-- **[Stacks Project, Tag 068Z], part (1).** For immersions `i : Z ⟶ Y` and `j : Y ⟶ X` with `j`
locally of finite presentation whose conormal sequence is exact and locally split,
quasi-regularity of `i ≫ j` descends to `i`. -/
@[stacks 068Z "(1) quasi-regularity descends to the first immersion"]
theorem isQuasiRegularImmersion_of_comp_of_isSplitExactConormalSequence
    (i : Z ⟶ Y) (j : Y ⟶ X) [IsImmersion i] [IsImmersion j] [LocallyOfFinitePresentation j]
    (hS : IsSplitExactConormalSequence i j) (hij : IsQuasiRegularImmersion (i ≫ j)) :
    IsQuasiRegularImmersion i :=
  isQuasiRegularImmersion_of_forall_quasiRegular_tail i
    (exists_quasiRegular_tail_near_image i j hS hij)

/-! ### Quasi-regularity of the first of two immersions with the second retracted -/

section Retraction

/-- **Stacks Project, Tag 067N, part (1), at a quasi-regular immersion.** Elements of the stalk
at `g z` of the defining ideal sheaf of a quasi-regular immersion `g` whose classes form a basis
of the cotangent fibre are the germs of sections generating that ideal sheaf germwise
quasi-regularly on a neighbourhood. -/
private theorem exists_quasiRegular_generators_of_isQuasiRegularImmersion (g : Z ⟶ X)
    [IsImmersion g] (hg : IsQuasiRegularImmersion g) (z : Z) {x : X} (hx : g z = x) {r : ℕ}
    (f : Fin r → Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (definingIdealOfHom g) x)
    (b : Module.Basis (Fin r) (X.toLocallyRingedSpace.presheaf.stalk x ⧸
        IsLocalRing.maximalIdeal (X.toLocallyRingedSpace.presheaf.stalk x))
      (Stacks.RingedSpace.idealCotangentFiber (X := X.toLocallyRingedSpace)
        (definingIdealOfHom g) x))
    (hf : ∀ a, b a = Submodule.Quotient.mk (f a)) :
    ∃ (U : X.Opens) (hxU : x ∈ U)
      (fU : Fin r → (definingIdealOfHom g).obj (op U)),
      (∀ a, X.toLocallyRingedSpace.presheaf.germ U x hxU (fU a).1 = (f a).1) ∧
        (∀ (y : X) (hy : y ∈ U), IsQuasiRegular (X.presheaf.stalk y)
          (List.ofFn (germFamily X.toRingedSpace U (fun a => (fU a).1) y hy))) ∧
          IsGeneratedByOn X.toRingedSpace (definingIdealOfHom g) U fun a => (fU a).1 := by
  subst hx
  obtain ⟨V, hxV, n, q, hQ, hgen⟩ := exists_quasiRegular_generators_near_image g hg z
  exact exists_quasiRegular_generators_of_basis_local (definingIdealOfHom g) (g z) f b hf
    (stalkIdeal_definingIdealOfHom_ne_top g z) V hxV q hQ hgen

/-- The stalk of the defining ideal sheaf of a quasi-regular immersion is finitely generated, at
a point presented as the image of a point of the source. -/
private theorem quasiRegularImmersion_stalkIdeal_fg_of_eq (g : Z ⟶ X) [IsImmersion g]
    (hg : IsQuasiRegularImmersion g) (z : Z) {x : X} (hx : g z = x) :
    (Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (definingIdealOfHom g) x).FG := by
  subst hx
  exact quasiRegularImmersion_stalkIdeal_fg g hg z

/-- **A quasi-regular family generating the ideal of `i` near a point, for a retracted `j`.**
For immersions `i : Z ⟶ Y` and `j : Y ⟶ X` with `j` admitting a retraction and both `j` and
`i ≫ j` quasi-regular, the ideal of `i` is generated near every point of `Z` by a germwise
quasi-regular family of sections of `O_Y`. -/
private theorem exists_quasiRegular_tail_of_retraction (i : Z ⟶ Y) (j : Y ⟶ X)
    [IsImmersion i] [IsImmersion j] (ρ : X ⟶ Y) (hρ : j ≫ ρ = 𝟙 Y)
    (hj : IsQuasiRegularImmersion j) (hij : IsQuasiRegularImmersion (i ≫ j)) (z : Z) :
    ∃ (T : Y.Opens) (_ : i z ∈ T) (m : ℕ) (tail : Fin m → Γ(Y, T)),
      (∀ (y : Y) (hy : y ∈ T), IsQuasiRegular (Y.presheaf.stalk y)
        (List.ofFn (germFamily Y.toRingedSpace T tail y hy))) ∧
        IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom i) T tail := by
  have hIJ : Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (definingIdealOfHom j) (j (i z)) ≤
      Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
        (definingIdealOfHom (i ≫ j)) (j (i z)) :=
    stalkIdeal_mono (definingIdealOfHom_le_comp i j) _
  obtain ⟨n, m, v, c, bI, bJ, hbI, hbJ, hcv⟩ :=
    exists_adapted_cotangent_bases (definingIdealOfHom j) (definingIdealOfHom (i ≫ j)) hIJ
      (quasiRegularImmersion_stalkIdeal_fg_of_eq j hj (i z) rfl)
      (quasiRegularImmersion_stalkIdeal_fg_of_eq (i ≫ j) hij z (x := j (i z)) rfl)
      (mk_eq_zero_of_mk_eq_zero_of_retraction i j ρ hρ z hIJ)
  obtain ⟨Vf, hxVf, fU, hfU, -, hgenf⟩ :=
    exists_quasiRegular_generators_of_isQuasiRegularImmersion j hj (i z) rfl v bI hbI
  obtain ⟨Vt, hxVt, t, ht, hQt, hgent⟩ :=
    exists_quasiRegular_generators_of_isQuasiRegularImmersion (i ≫ j) hij z
      (x := j (i z)) rfl c bJ hbJ
  refine exists_quasiRegular_tail_of_families i j z Vf Vt hxVf hxVt
    (fun a => (fU a).1) (fun k => (t k).1) (fun a => ?_) hgenf hQt hgent
  rw [hfU a, ht (Fin.castAdd m a), hcv a]

/-- **Quasi-regularity of the first of two immersions with the second retracted.** Let
`i : Z ⟶ Y` and `j : Y ⟶ X` be immersions and let `ρ : X ⟶ Y` be a retraction of `j`. If both `j`
and `i ≫ j` are quasi-regular immersions, then so is `i`.

This is [Stacks Project, Tag 068Z] part (1) for a retracted second immersion: the retraction
`u ↦ u - ρ^♯ (j^♯ u)` of the stalk of the ideal of `j` takes the place of the splitting of the
conormal sequence, so neither exactness nor finite presentation is needed. -/
theorem isQuasiRegularImmersion_of_comp_of_retraction (i : Z ⟶ Y) (j : Y ⟶ X)
    [IsImmersion i] [IsImmersion j] (ρ : X ⟶ Y) (hρ : j ≫ ρ = 𝟙 Y)
    (hj : IsQuasiRegularImmersion j) (hij : IsQuasiRegularImmersion (i ≫ j)) :
    IsQuasiRegularImmersion i :=
  isQuasiRegularImmersion_of_forall_quasiRegular_tail i
    (exists_quasiRegular_tail_of_retraction i j ρ hρ hj hij)

end Retraction

end Stacks.AlgebraicGeometry

