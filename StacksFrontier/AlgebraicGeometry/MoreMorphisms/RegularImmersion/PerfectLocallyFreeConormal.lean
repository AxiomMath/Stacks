/-! ### Finite projective dimension from perfectness -/

/-- A perfect module over a Noetherian ring has finite projective dimension: a perfect module is
one admitting a bounded resolution by finite projective modules, which is what finiteness of the
projective dimension of a finite module amounts to. -/
private theorem projectiveDimension_ne_top_of_isPerfectModule
    {A : Type u} [CommRing A] [IsNoetherianRing A] {M : Type u} [AddCommGroup M] [Module A M]
    [Module.Finite A M] (h : StacksDraft.Perfect.IsPerfectModule (R := A) M) :
    Module.projectiveDimension A M ≠ ⊤ := by
  obtain ⟨d, F, hF, hzero⟩ :=
    (StacksDraft.Perfect.isPerfectModule_iff_exists_finite_projective_resolution M).mp h
  let G : CategoryTheory.ObjectProperty.LeftResolution
      (fun N : ModuleCat.{u} A => CategoryTheory.Projective N ∧ Module.Finite A N)
      (ModuleCat.of A M) :=
    { complex := F.complex
      property := fun i => ⟨(IsProjective.iff_projective _).mp (hF i).2, (hF i).1⟩
      π := F.π
      quasiIso := F.quasiIso }
  rw [CategoryTheory.projectiveDimension_ne_top_iff]
  refine ⟨d, (ModuleCat.hasProjectiveDimensionLE_iff_exists_leftResolution_projective_finite
    (ModuleCat.of A M) d).mpr ⟨G, ?_⟩⟩
  simpa [G] using hzero

/-- The kernel of a surjection of commutative rings has finite projective dimension as soon as
the target does: the short exact sequence `0 → ker f → A → B → 0` has projective middle term. -/
private theorem projectiveDimension_ker_ne_top {A B : Type u} [CommRing A] [CommRing B]
    (f : A →+* B) (hf : Function.Surjective f)
    (hpd : let _ := f.toAlgebra; Module.projectiveDimension A B ≠ ⊤) :
    Module.projectiveDimension A (RingHom.ker f) ≠ ⊤ := by
  let _ := f.toAlgebra
  let l : A →ₗ[A] B := Algebra.linearMap A B
  have hl : Function.Surjective l := hf
  have hC : l.shortComplexKer.ShortExact := LinearMap.shortExact_shortComplexKer hl
  obtain ⟨d, hd⟩ := (CategoryTheory.projectiveDimension_ne_top_iff (ModuleCat.of A B)).mp hpd
  have h₂ : HasProjectiveDimensionLT l.shortComplexKer.X₂ (d + 1) := inferInstance
  have hd' : HasProjectiveDimensionLT (ModuleCat.of A B) (d + 1) := hd
  have h₃ : HasProjectiveDimensionLT l.shortComplexKer.X₃ (d + 2) :=
    hasProjectiveDimensionLT_of_ge (ModuleCat.of A B) (d + 1) (d + 2) (by lia)
  have hX₁ : HasProjectiveDimensionLT l.shortComplexKer.X₁ (d + 1) :=
    hC.hasProjectiveDimensionLT_X₁ (d + 1) h₂ h₃
  have he : RingHom.ker f = LinearMap.ker l := by
    ext x
    rfl
  rw [CategoryTheory.projectiveDimension_ne_top_iff]
  refine ⟨d, ?_⟩
  have hLE : HasProjectiveDimensionLE (ModuleCat.of A (LinearMap.ker l)) d := hX₁
  exact ModuleCat.hasProjectiveDimensionLE_of_linearEquiv
    (M := ModuleCat.of A (LinearMap.ker l)) (LinearEquiv.ofEq _ _ he).symm d

/-! ### Finite local freeness of the conormal module -/

/-- A finite free module is finite locally free, for the covering family of Stacks tag 00NX. -/
private theorem isFiniteLocallyFree_of_free {R N : Type u} [CommRing R]
    [AddCommGroup N] [Module R N] [Module.Free R N] [Module.Finite R N] :
    Module.IsFiniteLocallyFree R N := by
  have hfp : Module.Finite R N ∧ Module.Projective R N := ⟨inferInstance, inferInstance⟩
  obtain ⟨s, hs, hfree⟩ := ((Module.finite_projective_tfae R N).out 2 7).mp hfp
  exact ⟨↥s, Subtype.val, by rwa [Subtype.range_coe], fun k => hfree k.1 k.2⟩

/-- If a module over the target of a surjection `f : A → B` of commutative rings is finite free
and is `A`-linearly isomorphic to the conormal module of `ker f`, then that conormal module is
finite free over `A ⧸ ker f`.

A basis is carried across the isomorphism — which is `B`-linear once `B` acts on the conormal
module through `A ⧸ ker f ≃ B` — and then along that isomorphism of coefficient rings. -/
private theorem free_finite_cotangent_of_free {A B : Type u} [CommRing A] [CommRing B]
    (f : A →+* B) (hf : Function.Surjective f)
    {M : Type u} [AddCommGroup M] [Module A M] [Module B M]
    [Module.Free B M] [Module.Finite B M]
    (hsmul : ∀ (a : A) (m : M), a • m = f a • m)
    (c : M ≃ₗ[A] (RingHom.ker f).Cotangent) :
    Module.Free (A ⧸ RingHom.ker f) (RingHom.ker f).Cotangent ∧
      Module.Finite (A ⧸ RingHom.ker f) (RingHom.ker f).Cotangent := by
  classical
  let N := (RingHom.ker f).Cotangent
  let e : (A ⧸ RingHom.ker f) ≃+* B := RingHom.quotientKerEquivOfSurjective hf
  have hemk : ∀ a : A, e (Ideal.Quotient.mk (RingHom.ker f) a) = f a := fun _ => rfl
  let _ : Module B N := Module.compHom N (e.symm : B →+* A ⧸ RingHom.ker f)
  have hBsmul : ∀ (b : B) (x : N), b • x = (e.symm b) • x := fun _ _ => rfl
  have hAsmul : ∀ (a : A) (x : N), a • x = (Ideal.Quotient.mk (RingHom.ker f) a) • x :=
    fun a x => (IsScalarTower.algebraMap_smul (A ⧸ RingHom.ker f) a x).symm
  let cB : M ≃ₗ[B] N :=
    { c with
      map_smul' := by
        intro b m
        obtain ⟨a, rfl⟩ := hf b
        show c (f a • m) = (f a) • c m
        rw [← hsmul a m, c.map_smul, hAsmul a (c m), hBsmul (f a) (c m), ← hemk a,
          RingEquiv.symm_apply_apply] }
  let b := ((Module.Free.chooseBasis B M).map cB).mapCoeffs e.symm fun _ _ => rfl
  exact ⟨.of_basis b, .of_basis b⟩

/-- **The algebraic heart of Stacks tag 0FK1.** Let `f : A → B` be a surjection of commutative
rings with `A` Noetherian, let `B` be a perfect `A`-module, and let `M` be a finite free
`B`-module which is `A`-linearly isomorphic to the conormal module of `ker f`.  Then `ker f` is
a regular ideal.

This is Stacks tag 0FJS with its two hypotheses read off perfectness and the finite freeness of
`M`. -/
private theorem isRegular_ker_of_isPerfectModule_of_free
    {A B : Type u} [CommRing A] [IsNoetherianRing A] [CommRing B] (f : A →+* B)
    (hf : Function.Surjective f)
    (hperf : let _ := f.toAlgebra; StacksDraft.Perfect.IsPerfectModule (R := A) B)
    {M : Type u} [AddCommGroup M] [Module A M] [Module B M]
    [Module.Free B M] [Module.Finite B M]
    (hsmul : ∀ (a : A) (m : M), a • m = f a • m)
    (c : M ≃ₗ[A] (RingHom.ker f).Cotangent) :
    (RingHom.ker f).IsRegular := by
  let _ := f.toAlgebra
  have _ : Module.Finite A B :=
    Module.Finite.of_surjective (Algebra.linearMap A B) hf
  obtain ⟨_, _⟩ := free_finite_cotangent_of_free f hf hsmul c
  exact Ideal.isRegular_of_projectiveDimension_ne_top_of_isFiniteLocallyFree_cotangent _
    (projectiveDimension_ker_ne_top f hf (projectiveDimension_ne_top_of_isPerfectModule hperf))
    isFiniteLocallyFree_of_free

/-- The same statement with the module presented as an object of `ModuleCat B` and the
identification with the conormal module as an isomorphism of `ModuleCat A` after restriction of
scalars, which is the shape the sections of a pushforward come in. -/
private theorem isRegular_of_isPerfectModule_of_free
    {A B : Type u} [CommRing A] [IsNoetherianRing A] [CommRing B] (f : A →+* B)
    (hf : Function.Surjective f)
    (hperf : let _ := f.toAlgebra; StacksDraft.Perfect.IsPerfectModule (R := A) B)
    {I : Ideal A} (hI : RingHom.ker f = I)
    (N : ModuleCat.{u} B) [Module.Free B N] [Module.Finite B N]
    (c : (ModuleCat.restrictScalars f).obj N ≅ ModuleCat.of A I.Cotangent) :
    I.IsRegular := by
  subst hI
  let _ : Module A N := ((ModuleCat.restrictScalars f).obj N).isModule
  exact isRegular_ker_of_isPerfectModule_of_free f hf hperf (M := N) (fun _ _ => rfl)
    c.toLinearEquiv

/-! ### Sections of a finite locally free sheaf of modules -/

/-- The sections of a sheaf of modules isomorphic to a free sheaf on a finite index type are a
finite free module over the sections of the sheaf of rings: a finite coproduct is a finite
product, and evaluation at an object preserves products. -/
private theorem free_finite_sections_of_iso {C : Type u} [Category.{u} C]
    {J : GrothendieckTopology C} (R : Sheaf J RingCat.{u})
    [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    (I : Type u) [Finite I] (M : SheafOfModules.{u} R) (c : SheafOfModules.free (R := R) I ≅ M)
    (U : Cᵒᵖ) :
    Module.Free (R.obj.obj U) (M.val.obj U) ∧ Module.Finite (R.obj.obj U) (M.val.obj U) := by
  classical
  let _ := Fintype.ofFinite I
  have _ : HasFiniteBiproducts (SheafOfModules.{u} R) :=
    HasFiniteBiproducts.of_hasFiniteProducts
  let E := SheafOfModules.evaluation R U
  let c' : SheafOfModules.free (R := R) I ≅ ∏ᶜ (fun _ : I => SheafOfModules.unit R) :=
    (biproduct.isoCoproduct (fun _ : I => SheafOfModules.unit R)).symm ≪≫
      biproduct.isoProduct _
  let e := E.mapIso (c.symm ≪≫ c') ≪≫ PreservesProduct.iso E (fun _ : I => SheafOfModules.unit R) ≪≫
    ModuleCat.piIsoPi (fun _ : I => E.obj (SheafOfModules.unit R))
  let e' : (M.val.obj U) ≃ₗ[R.obj.obj U] (I → R.obj.obj U) := e.toLinearEquiv
  exact ⟨Module.Free.of_equiv e'.symm, Module.Finite.equiv e'.symm⟩

/-- **A finite locally free sheaf of modules has finite free modules of sections over all small
enough opens.**  Every point has an open neighbourhood over which the sheaf is a finite free
sheaf, and then the sections over every smaller open are finite free. -/
private theorem exists_opens_free_finite_sections {X : Scheme.{u}} (M : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} M] (x : X) :
    ∃ U : X.Opens, x ∈ U ∧ ∀ V : X.Opens, V ≤ U →
      Module.Free Γ(X, V) Γ(M, V) ∧ Module.Finite Γ(X, V) Γ(M, V) := by
  obtain ⟨q, hq, hfin⟩ :=
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.exists_isFiniteLocallyFreeData (M := M)
  have hc := q.coversTop
  rw [Opens.coversTop_iff] at hc
  have hx : x ∈ ⨆ k, q.X k := by
    rw [hc]
    trivial
  obtain ⟨k, hk⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  refine ⟨q.X k, hk, fun V hV => ?_⟩
  have _ : IsIso (q.generators k).π := hq.isIso k
  have _ : (q.generators k).IsFiniteType := hfin.isFiniteType k
  let W := op (Over.mk (homOfLE hV))
  exact free_finite_sections_of_iso (X.ringCatSheaf.over (q.X k)) (q.generators k).I
    (M.over (q.X k)) (asIso (q.generators k).π) W

/-! ### The affine charts -/

variable {X Y : Scheme.{u}}

/-- **Stacks tag 0FJS over one affine chart.**  Let `i : X ⟶ Y` be an immersion whose canonical
closed factor `j = i.liftCoborder` is perfect, with `Y` locally Noetherian, and let `V` be an
affine open of `i.coborderRange` over which the sections of the conormal sheaf form a finite free
module.  Then the kernel of `Γ(i.coborderRange, V) ⟶ Γ(X, j⁻¹V)` is a regular ideal.

The conormal sheaf is taken as a parameter together with the equation identifying it, so that its
sections carry the module structure over the sections of the structure sheaf that the notation
`Γ(C, U)` provides. -/
private theorem isRegular_ker_app_liftCoborder (i : X ⟶ Y) [IsImmersion i]
    [AlgebraicGeometry.Perfect i.liftCoborder] [IsLocallyNoetherian Y]
    (C : X.Modules) (hC : C = Stacks.Conormal.conormalSheaf i)
    (V : i.coborderRange.toScheme.Opens) (hV : IsAffineOpen V)
    (hfree : Module.Free Γ(X, i.liftCoborder ⁻¹ᵁ V) Γ(C, i.liftCoborder ⁻¹ᵁ V))
    (hfinite : Module.Finite Γ(X, i.liftCoborder ⁻¹ᵁ V) Γ(C, i.liftCoborder ⁻¹ᵁ V)) :
    (RingHom.ker (i.liftCoborder.app V).hom).IsRegular := by
  have _ : IsNoetherianRing Γ(i.coborderRange.toScheme, V) :=
    IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  obtain ⟨I, e, he⟩ := Stacks.Conormal.exists_affineModel i.liftCoborder V hV
  have hIker : RingHom.ker (i.liftCoborder.app V).hom = I := by
    have h := Stacks.Conormal.ker_appLE_eq_of_affineModel i.liftCoborder V hV I e he
    rwa [Scheme.Hom.appLE_eq_app] at h
  have hc : Nonempty ((ModuleCat.restrictScalars (i.liftCoborder.app V).hom).obj
      (ModuleCat.of Γ(X, i.liftCoborder ⁻¹ᵁ V) Γ(C, i.liftCoborder ⁻¹ᵁ V)) ≅
        ModuleCat.of Γ(i.coborderRange.toScheme, V) I.Cotangent) := by
    subst hC
    exact ⟨Stacks.Immersion.pushforwardConormalIsoCotangent i i.coborderRange i.liftCoborder
      i.liftCoborder_ι V hV I e he⟩
  obtain ⟨c⟩ := hc
  rw [hIker]
  exact isRegular_of_isPerfectModule_of_free (i.liftCoborder.app V).hom
    (i.liftCoborder.app_surjective V hV)
    (isPerfectModule_sections_of_perfect_isClosedImmersion i.liftCoborder V hV) (I := I) hIker
    (ModuleCat.of Γ(X, i.liftCoborder ⁻¹ᵁ V) Γ(C, i.liftCoborder ⁻¹ᵁ V)) c

/-- **The principal localization of Stacks tag 07CV read on a basic open.**  If the extension of
the kernel of a closed immersion on an affine open `V` to the localization away from `g` is
generated by a regular sequence, then its kernel over the basic open `D(g)` is generated by a
weakly regular sequence of sections there.

The sections over `D(g)` are the localization away from `g` by
`AlgebraicGeometry.IsAffineOpen.isLocalization_basicOpen`, and the kernel ideal sheaf of the
closed immersion takes basic opens to extended ideals by
`AlgebraicGeometry.Scheme.IdealSheafData.map_ideal_basicOpen`. -/
private theorem exists_generators_basicOpen {W Z : Scheme.{u}} (j : W ⟶ Z) [IsClosedImmersion j]
    (V : Z.Opens) (hV : IsAffineOpen V) (g : Γ(Z, V)) {r : ℕ}
    (fl : Fin r → Localization.Away g)
    (hreg : IsRegular (Localization.Away g) (List.ofFn fl))
    (hspan : (RingHom.ker (j.app V).hom).map (algebraMap Γ(Z, V) (Localization.Away g)) =
      Ideal.span (Set.range fl)) :
    ∃ gen : Fin r → Γ(Z, Z.basicOpen g),
      RingHom.ker (j.app (Z.basicOpen g)).hom = Ideal.span (Set.range gen) ∧
        IsWeaklyRegular Γ(Z, Z.basicOpen g) (List.ofFn gen) := by
  have _ := hV.isLocalization_basicOpen g
  let q : Localization.Away g ≃ₐ[Γ(Z, V)] Γ(Z, Z.basicOpen g) :=
    IsLocalization.algEquiv (Submonoid.powers g) _ _
  refine ⟨fun k => q (fl k), ?_, ?_⟩
  · have hbo := j.ker.map_ideal_basicOpen (⟨V, hV⟩ : Z.affineOpens) g
    rw [Scheme.Hom.ker_apply j (⟨V, hV⟩ : Z.affineOpens),
      Scheme.Hom.ker_apply j (Z.affineBasicOpen (U := ⟨V, hV⟩) g)] at hbo
    have hbo' : RingHom.ker (j.app (Z.basicOpen g)).hom =
        (RingHom.ker (j.app V).hom).map
          (Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom := hbo.symm
    rw [hbo', show (Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom =
      algebraMap Γ(Z, V) Γ(Z, Z.basicOpen g) from rfl,
      show (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen g)) =
        (q : Localization.Away g →+* Γ(Z, Z.basicOpen g)).comp
          (algebraMap Γ(Z, V) (Localization.Away g)) from
        (RingHom.ext fun a => (q.commutes a).symm), ← Ideal.map_map, hspan, Ideal.map_span,
      ← Set.range_comp]
    rfl
  · exact (Stacks.AlgebraicGeometry.isRegular_map_ringEquiv q.toRingEquiv hreg).toIsWeaklyRegular

/-! ### Stacks tag 0FK1 -/

/-- **Stacks tag 0FK1.**  An immersion `i : X ⟶ Y` which is perfect, whose target is locally
Noetherian and whose conormal sheaf is finite locally free, is a regular immersion. -/
@[stacks 0FK1]
theorem isRegularImmersion_of_perfect_of_conormalSheaf (i : X ⟶ Y) [IsImmersion i]
    [AlgebraicGeometry.Perfect i] [IsLocallyNoetherian Y]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
      (Stacks.Conormal.conormalSheaf i)] :
    IsRegularImmersion i := by
  have _ : AlgebraicGeometry.Perfect i.liftCoborder :=
    perfect_of_isPullback_of_flat (IsPullback.of_horiz_isIso_mono
      (show CommSq (𝟙 X) i.liftCoborder i i.coborderRange.ι from ⟨by simp⟩))
  obtain ⟨C, hC⟩ : ∃ C : X.Modules, C = Stacks.Conormal.conormalSheaf i := ⟨_, rfl⟩
  have hFLF : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} C := by
    subst hC
    exact (inferInstance : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
      (Stacks.Conormal.conormalSheaf i))
  show IsRegularIdealSheaf _
    (_root_.Stacks.AlgebraicGeometry.RegularIdealSheaf.definingIdealOfHom i.liftCoborder)
  refine (isRegularIdealSheaf_iff_exists_affine_generators i.coborderRange.toScheme _).mpr
    fun x hx => ?_
  rw [definingIdealQuotient_support_eq_range i.liftCoborder] at hx
  obtain ⟨z, rfl⟩ := hx
  obtain ⟨O, hzO, hO⟩ := exists_opens_free_finite_sections C z
  obtain ⟨T, hT, hTeq⟩ :=
    i.liftCoborder.isClosedEmbedding.isEmbedding.isInducing.isOpen_iff.mp O.isOpen
  have hzT : i.liftCoborder.base z ∈ (⟨T, hT⟩ : i.coborderRange.toScheme.Opens) := by
    show z ∈ i.liftCoborder.base ⁻¹' T
    rwa [hTeq]
  obtain ⟨V, hV, hzV, hVT⟩ := exists_isAffineOpen_mem_and_subset hzT
  have hVO : i.liftCoborder ⁻¹ᵁ V ≤ O := by
    intro y hy
    show y ∈ (O : Set X)
    rw [← hTeq]
    exact hVT hy
  obtain ⟨hfree, hfinite⟩ := hO _ hVO
  have hIp : RingHom.ker (i.liftCoborder.app V).hom ≤
      (hV.primeIdealOf ⟨i.liftCoborder.base z, hzV⟩).asIdeal := by
    intro s hs
    by_contra hns
    have hmem : i.liftCoborder.base z ∈ i.coborderRange.toScheme.basicOpen s :=
      (AlgebraicGeometry.mem_basicOpen_iff_notMem_primeIdealOf hV s ⟨_, hzV⟩).mpr hns
    have hz' : z ∈ i.liftCoborder ⁻¹ᵁ i.coborderRange.toScheme.basicOpen s := hmem
    rw [Scheme.preimage_basicOpen, show (i.liftCoborder.app V).hom s = 0 from hs,
      Scheme.basicOpen_zero] at hz'
    exact hz'
  obtain ⟨g, hg, r, fl, hregfl, hspan⟩ :=
    isRegular_ker_app_liftCoborder i C hC V hV hfree hfinite _ hIp
  obtain ⟨gen, hker, hwreg⟩ := exists_generators_basicOpen i.liftCoborder V hV g fl hregfl hspan
  exact ⟨⟨i.coborderRange.toScheme.basicOpen g, hV.basicOpen g⟩,
    (AlgebraicGeometry.mem_basicOpen_iff_notMem_primeIdealOf hV g ⟨_, hzV⟩).mpr hg, r, gen,
    isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span i.liftCoborder (hV.basicOpen g) gen
      hker, hwreg⟩

end Stacks.AlgebraicGeometry.RegularIdealSheaf

