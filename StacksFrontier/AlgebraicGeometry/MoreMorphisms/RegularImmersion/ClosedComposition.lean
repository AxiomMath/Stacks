module

public import StacksFrontier.AlgebraicGeometry.RegularImmersion.BaseChange
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularImmersion.AffineRegular
public import StacksFrontier.RingTheory.Sequence.Regular.Basic

/-!
# Composition of regular closed immersions

Let `i : Z ⟶ Y` and `j : Y ⟶ X` be closed immersions whose defining ideal sheaves are regular.
Then the defining ideal sheaf of `i ≫ j` is regular. Affine-locally, if the defining ideal of `j`
is cut out by a weakly regular sequence `f` in `Γ(X, U)` and `g` lifts a weakly regular sequence
cutting out the defining ideal of `i` over `j ⁻¹ᵁ U`, then `f ++ g` is weakly regular and cuts out
the defining ideal of `i ≫ j`.

## Main results

* `Stacks.AlgebraicGeometry.isWeaklyRegular_append_of_ker_eq`: a weakly regular sequence cutting
  out the kernel of a surjection, extended by lifts of a weakly regular sequence of the target, is
  weakly regular.
* `Stacks.AlgebraicGeometry.exists_affine_isWeaklyRegular_generators`: a regular defining ideal
  of a closed immersion is cut out, near every point of the image, by a weakly regular sequence
  on an affine open.
* `Stacks.AlgebraicGeometry.isRegularIdealSheaf_comp_of_isClosedImmersion`: the composite of two
  closed immersions with regular defining ideal sheaves has a regular defining ideal sheaf.

## References

* [Stacks Project, Lemma 31.21.5 (Tag 067Q)](https://stacks.math.columbia.edu/tag/067Q)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry RingTheory.Sequence
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.AlgebraicGeometry

universe u

section Algebra

/-- The submodule generated by an ideal acting on the whole ring is that ideal. -/
private theorem ofList_smul_top {A : Type u} [CommRing A] (f : List A) :
    Ideal.ofList f • (⊤ : Submodule A A) = Ideal.ofList f := by
  rw [Ideal.smul_eq_mul, Ideal.mul_top]

/-- The ideal of a list is the ideal spanned by its indexed entries. -/
private theorem ofList_eq_span_range_get {A : Type u} [CommRing A] (l : List A) :
    Ideal.ofList l = Ideal.span (Set.range l.get) :=
  congrArg Ideal.span (by ext a; simp)

/-- The scalars of a lifted list act on the quotient as their images act on the target. -/
private theorem forall₂_smul_quotient {A B : Type u} [CommRing A] [CommRing B] (q : A →+* B)
    (I : Submodule A A) (e : (A ⧸ I) ≃+ B) (he : ∀ a : A, e (Submodule.Quotient.mk a) = q a)
    (g : List A) :
    List.Forall₂ (fun (r : A) (s : B) => ∀ x : A ⧸ I, e (r • x) = s • e x) g (g.map q) := by
  induction g with
  | nil => exact .nil
  | cons a g ih =>
    refine .cons (fun x => ?_) ih
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    rw [show a • (Submodule.Quotient.mk y : A ⧸ I) = Submodule.Quotient.mk (a * y) from rfl,
      he, he, map_mul, smul_eq_mul]

/-- Let `q : A → B` be a surjection whose kernel is generated by a weakly regular sequence `f`,
and let `g` be a list of elements of `A` whose image under `q` is weakly regular in `B`. Then
`f ++ g` is weakly regular in `A`. -/
theorem isWeaklyRegular_append_of_ker_eq {A B : Type u} [CommRing A] [CommRing B] (q : A →+* B)
    (hq : Function.Surjective q) {f : List A} (hf : IsWeaklyRegular A f)
    (hker : RingHom.ker q = Ideal.ofList f) {g : List A}
    (hg : IsWeaklyRegular B (g.map q)) : IsWeaklyRegular A (f ++ g) := by
  refine (isWeaklyRegular_append_iff A f g).mpr ⟨hf, ?_⟩
  let e₀ : (A ⧸ (Ideal.ofList f • (⊤ : Submodule A A))) ≃ₗ[A] A ⧸ Ideal.ofList f :=
    Submodule.quotEquivOfEq _ _ (ofList_smul_top f)
  let e₁ : (A ⧸ Ideal.ofList f) ≃+* B :=
    (Ideal.quotEquivOfEq hker).symm.trans (RingHom.quotientKerEquivOfSurjective hq)
  let e : (A ⧸ (Ideal.ofList f • (⊤ : Submodule A A))) ≃+ B :=
    e₀.toAddEquiv.trans e₁.toAddEquiv
  exact (e.isWeaklyRegular_congr (forall₂_smul_quotient q _ e (fun _ => rfl) g)).mpr hg

/-- Contracting the ideal generated by the image of a list along a surjection adds the kernel's
generators. -/
private theorem comap_ofList_map {A B : Type u} [CommRing A] [CommRing B] (q : A →+* B)
    (hq : Function.Surjective q) {f : List A} (hker : RingHom.ker q = Ideal.ofList f)
    (g : List A) : (Ideal.ofList (g.map q)).comap q = Ideal.ofList (f ++ g) := by
  rw [← Ideal.map_ofList, Ideal.comap_map_of_surjective q hq, ← RingHom.ker_eq_comap_bot, hker,
    Ideal.ofList_append, sup_comm]

end Algebra

section Extraction

variable {Z X : Scheme.{u}} (j : Z ⟶ X)

/-- Near every point of the image of a closed immersion whose defining ideal sheaf is regular
there is an affine open over which the kernel of the map on sections is generated by a weakly
regular sequence. -/
theorem exists_affine_isWeaklyRegular_generators [IsClosedImmersion j]
    (hj : IsRegularIdealSheaf X.toRingedSpace (definingIdealOfHom j)) (z : Z) :
    ∃ (U : X.affineOpens) (_hz : j z ∈ U.1) (r : ℕ) (f : Fin r → Γ(X, U.1)),
      IsWeaklyRegular Γ(X, U.1) (List.ofFn f) ∧
        RingHom.ker (j.app U.1).hom = Ideal.span (Set.range f) := by
  have hz : j z ∈ idealQuotientSupport X.toRingedSpace (definingIdealOfHom j) :=
    definingIdealQuotient_support_eq_range j ▸ ⟨z, rfl⟩
  obtain ⟨U, hzU, r, f, hgen, hwr⟩ :=
    (isRegularIdealSheaf_iff_exists_affine_generators X _).mp hj (j z) hz
  exact ⟨U, hzU, r, f, hwr, ker_app_eq_span_range j U.2 f hgen⟩

/-- The image of a weakly regular sequence of sections over an affine open `U` under restriction
to an affine open `V ≤ U` is weakly regular. -/
theorem isWeaklyRegular_map_res {X : Scheme.{u}} {U V : X.Opens} (hU : IsAffineOpen U)
    (hV : IsAffineOpen V) (hVU : V ≤ U) {l : List Γ(X, U)} (hl : IsWeaklyRegular Γ(X, U) l) :
    IsWeaklyRegular Γ(X, V) (l.map (X.presheaf.map (homOfLE hVU).op).hom) := by
  let q := (X.presheaf.map (homOfLE hVU).op).hom
  let _ : Algebra Γ(X, U) Γ(X, V) := q.toAlgebra
  have hflat : q.Flat := by
    convert (𝟙 X : X ⟶ X).flat_appLE hU hV (by simpa using hVU) using 1
    change q = (CategoryStruct.id Γ(X, U) ≫ X.presheaf.map (homOfLE hVU).op).hom
    rw [Category.id_comp]
  have : Module.Flat Γ(X, U) Γ(X, V) := hflat
  exact hl.of_flat

/-- The kernel of the map on sections over a smaller affine open is the extension of the kernel
over the larger one. -/
theorem ker_app_eq_map_ker_app [IsClosedImmersion j] {U V : X.Opens} (hU : IsAffineOpen U)
    (hV : IsAffineOpen V) (hVU : V ≤ U) :
    RingHom.ker (j.app V).hom =
      (RingHom.ker (j.app U).hom).map (X.presheaf.map (homOfLE hVU).op).hom := by
  rw [← Scheme.Hom.ker_apply j ⟨U, hU⟩, ← Scheme.Hom.ker_apply j ⟨V, hV⟩]
  exact (j.ker.map_ideal (U := ⟨V, hV⟩) (V := ⟨U, hU⟩) hVU).symm

/-- A weakly regular sequence cutting out the kernel of `j.app U` restricts to one cutting out the
kernel of `j.app V` for an affine open `V ≤ U`. -/
private theorem exists_isWeaklyRegular_ker_restrict [IsClosedImmersion j] {U V : X.Opens}
    (hU : IsAffineOpen U) (hV : IsAffineOpen V) (hVU : V ≤ U) {r : ℕ} {f₀ : Fin r → Γ(X, U)}
    (hf₀ : IsWeaklyRegular Γ(X, U) (List.ofFn f₀))
    (hker : RingHom.ker (j.app U).hom = Ideal.span (Set.range f₀)) :
    ∃ f : List Γ(X, V), IsWeaklyRegular Γ(X, V) f ∧
      RingHom.ker (j.app V).hom = Ideal.ofList f :=
  ⟨_, isWeaklyRegular_map_res hU hV hVU hf₀, by
    rw [ker_app_eq_map_ker_app j hU hV hVU, hker, ← Ideal.ofList_ofFn, Ideal.map_ofList]⟩

/-- Given a closed immersion `j`, an open `V` of its source containing `y` and an open `W` of its
target containing `j y`, there is an affine open of the target inside `W` containing `j y` whose
preimage lies in `V`. -/
theorem exists_affineOpen_preimage_le_and_le [IsClosedImmersion j] (V : Z.Opens) (W : X.Opens)
    {y : Z} (hy : y ∈ V) (hyW : j y ∈ W) :
    ∃ U : X.affineOpens, j y ∈ U.1 ∧ j ⁻¹ᵁ U.1 ≤ V ∧ U.1 ≤ W := by
  have hclosed : IsClosed (j '' (Vᶜ : Set Z)) :=
    (IsClosedImmersion.isClosedEmbedding j).isClosedMap _ (isClosed_compl_iff.mpr V.2)
  let T : X.Opens := W ⊓ ⟨(j '' (Vᶜ : Set Z))ᶜ, hclosed.isOpen_compl⟩
  have hyT : j y ∈ T :=
    ⟨hyW, fun ⟨_, hy', heq⟩ => hy' ((IsClosedImmersion.isClosedEmbedding j).injective heq ▸ hy)⟩
  obtain ⟨U, hU, hyU, hUT⟩ := exists_isAffineOpen_mem_and_subset hyT
  exact ⟨⟨U, hU⟩, hyU,
    fun z hz => of_not_not fun hzV => (hUT hz).2 (Set.mem_image_of_mem j hzV),
    fun x hx => (hUT hx).1⟩

end Extraction

section Composition

variable {Z Y X : Scheme.{u}} (i : Z ⟶ Y) (j : Y ⟶ X)

/-- For closed immersions with regular defining ideals and a point `z` of the source, there is
an affine open of `X` around the image of `z` on which the kernel of `(i ≫ j).app` is generated by
a weakly regular sequence. -/
theorem exists_affine_isWeaklyRegular_generators_comp [IsClosedImmersion i] [IsClosedImmersion j]
    (hi : IsRegularIdealSheaf Y.toRingedSpace (definingIdealOfHom i))
    (hj : IsRegularIdealSheaf X.toRingedSpace (definingIdealOfHom j)) (z : Z) :
    ∃ (U : X.affineOpens) (_hz : (i ≫ j) z ∈ U.1) (l : List Γ(X, U.1)),
      IsWeaklyRegular Γ(X, U.1) l ∧
        RingHom.ker ((i ≫ j).app U.1).hom = Ideal.ofList l := by
  obtain ⟨U₀, hU₀mem, r, f₀, hf₀, hker₀⟩ :=
    exists_affine_isWeaklyRegular_generators j hj (i z)
  obtain ⟨V₀, hV₀mem, s, g₀, hg₀, hkerg₀⟩ :=
    exists_affine_isWeaklyRegular_generators i hi z
  obtain ⟨U, hUmem, hUV, hUU₀⟩ :=
    exists_affineOpen_preimage_le_and_le j V₀.1 U₀.1 hV₀mem hU₀mem
  have hV : IsAffineOpen (j ⁻¹ᵁ U.1) := U.2.preimage j
  obtain ⟨f, hfwr, hkerf⟩ := exists_isWeaklyRegular_ker_restrict j U₀.2 U.2 hUU₀ hf₀ hker₀
  obtain ⟨g, hgwr, hkerg⟩ := exists_isWeaklyRegular_ker_restrict i V₀.2 hV hUV hg₀ hkerg₀
  let q : Γ(X, U.1) →+* Γ(Y, j ⁻¹ᵁ U.1) := (j.app U.1).hom
  have hq : Function.Surjective q := j.app_surjective U.1 U.2
  obtain ⟨g', hg'⟩ := List.map_surjective_iff.mpr hq g
  refine ⟨U, hUmem, f ++ g', ?_, ?_⟩
  · exact isWeaklyRegular_append_of_ker_eq q hq hfwr hkerf (hg' ▸ hgwr)
  · have hcomp : ((i ≫ j).app U.1).hom = (i.app (j ⁻¹ᵁ U.1)).hom.comp q :=
      (congrArg CommRingCat.Hom.hom (Scheme.Hom.comp_app i j U.1)).trans
        (CommRingCat.hom_comp _ _)
    rw [hcomp]
    refine (RingHom.comap_ker (i.app (j ⁻¹ᵁ U.1)).hom q).symm.trans ?_
    rw [hkerg, ← hg']
    exact comap_ofList_map q hq hkerf g'

/-- The composite of two closed immersions with regular defining ideal sheaves has a regular
defining ideal sheaf. -/
theorem isRegularIdealSheaf_comp_of_isClosedImmersion [IsClosedImmersion i] [IsClosedImmersion j]
    (hi : IsRegularIdealSheaf Y.toRingedSpace (definingIdealOfHom i))
    (hj : IsRegularIdealSheaf X.toRingedSpace (definingIdealOfHom j)) :
    IsRegularIdealSheaf X.toRingedSpace (definingIdealOfHom (i ≫ j)) := by
  refine (isRegularIdealSheaf_iff_exists_affine_generators X _).mpr fun x hx => ?_
  rw [definingIdealQuotient_support_eq_range (i ≫ j)] at hx
  obtain ⟨z, rfl⟩ := hx
  obtain ⟨U, hzU, l, hl, hker⟩ :=
    exists_affine_isWeaklyRegular_generators_comp i j hi hj z
  exact ⟨U, hzU, l.length, l.get, isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span (i ≫ j)
    U.2 l.get (hker.trans (ofList_eq_span_range_get l)), by simpa using hl⟩

end Composition

end Stacks.AlgebraicGeometry

end
