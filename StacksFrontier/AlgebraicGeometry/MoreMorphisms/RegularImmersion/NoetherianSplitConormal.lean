module

public import StacksFrontier.AlgebraicGeometry.Conormal.SplitCotangentFibre
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.CohenMacaulaySlice.OpenImmersionRegular
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularImmersion.PerfectFactor
public import StacksCore.Tactic.StacksAttribute

/-!
# Regular immersions in a factorization over a locally Noetherian scheme

Let `i : Z ⟶ Y` and `j : Y ⟶ X` be immersions of schemes with `X` locally Noetherian, let `z` be
a point of `Z` and let `y = i z`.  If `i ≫ j` is a regular immersion near `z` and the conormal
sequence `0 ⟶ i^* 𝒞_{Y/X} ⟶ 𝒞_{Z/X} ⟶ 𝒞_{Z/Y} ⟶ 0` is exact and locally split near `z`, then `i`
is a regular immersion near `z` and `j` is one near `y`;  conversely those two conditions make
`i ≫ j` a regular immersion near `z`.  These are the implications `(3) ⇒ (1)` and `(1) ⇒ (2)` of
Stacks tag 0690.

## Main results

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_opens_isRegularImmersion_of_split_near`:
  `(3) ⇒ (1)` of Stacks tag 0690.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_opens_isRegularImmersion_comp_of_factors`:
  `(1) ⇒ (2)` of Stacks tag 0690.

## Implementation notes

"Regular immersion in a neighbourhood of a point" is spelled as in Stacks tag 069E, by an open
subscheme of the source through which the immersion is restricted:  `i` is a regular immersion
near `z` when `∃ W, z ∈ W ∧ IsRegularImmersion (W.ι ≫ i)`.

Both implications are read on local rings, which is what the Noetherian hypothesis is for:
regularity of an immersion into a locally Noetherian scheme is equivalent to each kernel
`O_{X, f z} ⟶ O_{Z, z}` being generated by a regular sequence, and the locus of points where
that holds is open.  For `(3) ⇒ (1)` the splitting of the conormal sequence enters only through
the injectivity of the map of cotangent fibres `I_x / 𝔪_x I_x ⟶ J_x / 𝔪_x J_x` at `x = j (i z)`,
which is the hypothesis of the local-ring statement of Stacks tag 09RK;  the two sides of that
map are presented there by the kernels of the two maps of local rings and here by the stalks of
the two defining ideal sheaves, and `stalkIdeal_definingIdealOfHom_eq_ker` identifies them.

## References

* [Stacks Project, Lemma 31.22.9 (Tag 0690)](https://stacks.math.columbia.edu/tag/0690)
* [Stacks Project, Lemma 31.22.8 (Tag 068Z)](https://stacks.math.columbia.edu/tag/068Z)
* [Stacks Project, Lemma 37.62.11 (Tag 09RK)](https://stacks.math.columbia.edu/tag/09RK)
* [Stacks Project, Lemma 31.20.6 (Tag 063I)](https://stacks.math.columbia.edu/tag/063I)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry RingTheory.Sequence
open IsLocalRing

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

variable {Z Y X : Scheme.{u}}

/-! ### Stalk kernels along an open immersion -/

/-- The map of local rings induced by a composite is the composite of the induced maps. -/
private theorem stalkMap_comp_hom {Z Y X : Scheme.{u}} (f : Z ⟶ Y) (g : Y ⟶ X) (z : Z) :
    ((f ≫ g).stalkMap z).hom = (f.stalkMap z).hom.comp (g.stalkMap (f.base z)).hom := by
  rw [Scheme.Hom.stalkMap_comp]; rfl

/-- **An open immersion on the source does not change the kernel of a map of local rings.**  For
`a : Z' ⟶ Z` an open immersion and `f : Z ⟶ X`, the kernel of the map of local rings induced by
`a ≫ f` at `w` is the kernel of the one induced by `f` at `a w`. -/
public theorem ker_stalkMap_comp_isOpenImmersion {Z' : Scheme.{u}} (a : Z' ⟶ Z)
    [IsOpenImmersion a] (f : Z ⟶ X) (w : Z') :
    RingHom.ker ((a ≫ f).stalkMap w).hom = RingHom.ker (f.stalkMap (a.base w)).hom := by
  rw [stalkMap_comp_hom]
  exact RingHom.ker_comp_of_injective _
    (asIso (a.stalkMap w)).commRingCatIsoToRingEquiv.injective

/-- **Regularity of an immersion near a point is read on the kernel of its map of local rings.**
An immersion into a locally Noetherian scheme is a regular immersion on a neighbourhood of any
point at which that kernel is generated by a regular sequence:  the regular locus is open, and
the immersion restricted to it is regular. -/
@[ega "IV 16.9.10" "(i)"]
private theorem exists_opens_isRegularImmersion_of_mem_regularStalkLocus (f : Z ⟶ X)
    [IsImmersion f] [IsLocallyNoetherian X] (z : Z) (hz : z ∈ regularStalkLocus f) :
    ∃ W : Z.Opens, z ∈ W ∧ IsRegularImmersion (W.ι ≫ f) := by
  refine ⟨⟨regularStalkLocus f, isOpen_regularStalkLocus f⟩, hz, ?_⟩
  set W : Z.Opens := ⟨regularStalkLocus f, isOpen_regularStalkLocus f⟩
  refine isRegularImmersion_of_exists_isRegular_ker_stalkMap (W.ι ≫ f) fun w => ?_
  rw [ker_stalkMap_comp_isOpenImmersion W.ι f w]
  exact w.2

/-- **A regular immersion near a point generates the kernel of its map of local rings there.**
The converse direction of `exists_opens_isRegularImmersion_of_mem_regularStalkLocus`, which needs
no Noetherian hypothesis. -/
public theorem mem_regularStalkLocus_of_exists_opens (f : Z ⟶ X)
    [IsImmersion f] (z : Z) (h : ∃ W : Z.Opens, z ∈ W ∧ IsRegularImmersion (W.ι ≫ f)) :
    z ∈ regularStalkLocus f := by
  obtain ⟨W, hzW, hreg⟩ := h
  have h1 := exists_isRegular_ker_stalkMap_of_isRegularImmersion (W.ι ≫ f) hreg ⟨z, hzW⟩
  rw [ker_stalkMap_comp_isOpenImmersion W.ι f ⟨z, hzW⟩] at h1
  exact h1

/-- **An open immersion on the source does not move the regular locus.**  For `a : Z' ⟶ Z` an
open immersion and `f : Z ⟶ X`, a point `w` of `Z'` lies in the regular locus of `a ≫ f` exactly
when `a w` lies in the regular locus of `f`. -/
public theorem mem_regularStalkLocus_comp_isOpenImmersion {Z' : Scheme.{u}} (a : Z' ⟶ Z)
    [IsOpenImmersion a] (f : Z ⟶ X) (w : Z') :
    w ∈ regularStalkLocus (a ≫ f) ↔ a.base w ∈ regularStalkLocus f := by
  constructor
  · rintro ⟨rs, hrs, hgen⟩
    exact ⟨rs, hrs, hgen.trans (ker_stalkMap_comp_isOpenImmersion a f w)⟩
  · rintro ⟨rs, hrs, hgen⟩
    exact ⟨rs, hrs, hgen.trans (ker_stalkMap_comp_isOpenImmersion a f w).symm⟩

/-! ### The map of cotangent fibres as a map of stalk kernels -/

/-- Injectivity of the reduction of an inclusion of ideals modulo the maximal ideal only depends
on the two ideals, not on the proofs presenting them. -/
private theorem injective_mapQ_smul_top_congr {A : Type u} [CommRing A] (m : Ideal A)
    {I J I' J' : Ideal A} (hI : I = I') (hJ : J = J') (h : I ≤ J) (h' : I' ≤ J')
    (hinj : Function.Injective
      ((m • (⊤ : Submodule A I)).mapQ (m • (⊤ : Submodule A J)) (Submodule.inclusion h)
        (Submodule.smul_top_le_comap_smul_top _ _))) :
    Function.Injective
      ((m • (⊤ : Submodule A I')).mapQ (m • (⊤ : Submodule A J')) (Submodule.inclusion h')
        (Submodule.smul_top_le_comap_smul_top _ _)) := by
  subst hI; subst hJ; exact hinj

/-- **The injectivity hypothesis of Stacks tag 09RK holds along a locally split conormal
sequence.**  For immersions `i : Z ⟶ Y` and `j : Y ⟶ X` whose conormal sequence is exact and
locally split, the reduction modulo `𝔪_x` of the inclusion of the kernel of
`O_{X, x} ⟶ O_{Y, i z}` in the kernel of `O_{X, x} ⟶ O_{Z, z}` is injective at `x = j (i z)`. -/
private theorem injective_mapQ_ker_stalkMap_of_isSplitExactConormalSequence (i : Z ⟶ Y)
    (j : Y ⟶ X) [IsImmersion i] [IsImmersion j] (hS : IsSplitExactConormalSequence i j) (z : Z) :
    Function.Injective
      ((maximalIdeal (X.presheaf.stalk (j.base (i.base z))) •
          (⊤ : Submodule (X.presheaf.stalk (j.base (i.base z)))
            (RingHom.ker (j.stalkMap (i.base z)).hom))).mapQ
        (maximalIdeal (X.presheaf.stalk (j.base (i.base z))) •
          (⊤ : Submodule (X.presheaf.stalk (j.base (i.base z)))
            (RingHom.ker ((i.stalkMap z).hom.comp (j.stalkMap (i.base z)).hom))))
        (Submodule.inclusion
          (Koszul.ker_le_ker_comp (j.stalkMap (i.base z)).hom (i.stalkMap z).hom))
        (Submodule.smul_top_le_comap_smul_top _ _)) := by
  have hI : Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (_root_.Stacks.AlgebraicGeometry.RegularIdealSheaf.definingIdealOfHom j) (j.base (i.base z))
        = RingHom.ker (j.stalkMap (i.base z)).hom :=
    stalkIdeal_definingIdealOfHom_eq_ker j (i.base z)
  have hJ : Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (_root_.Stacks.AlgebraicGeometry.RegularIdealSheaf.definingIdealOfHom (i ≫ j))
        (j.base (i.base z))
        = RingHom.ker ((i.stalkMap z).hom.comp (j.stalkMap (i.base z)).hom) := by
    rw [← stalkMap_comp_hom]
    exact stalkIdeal_definingIdealOfHom_eq_ker (i ≫ j) z
  have hle : Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (_root_.Stacks.AlgebraicGeometry.RegularIdealSheaf.definingIdealOfHom j) (j.base (i.base z)) ≤
        Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
          (_root_.Stacks.AlgebraicGeometry.RegularIdealSheaf.definingIdealOfHom (i ≫ j))
            (j.base (i.base z)) := by
    rw [hI, hJ]
    exact Koszul.ker_le_ker_comp _ _
  refine injective_mapQ_smul_top_congr _ hI hJ hle _ ?_
  intro u v huv
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ u
  obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ v
  rw [Submodule.mapQ_apply, Submodule.mapQ_apply] at huv
  refine injective_idealCotangentFiberMap i j hS z ?_
  rw [idealCotangentFiberMap_mk i j z a (hle a.2), idealCotangentFiberMap_mk i j z b (hle b.2)]
  exact huv

/-! ### The implications of Stacks tag 0690 -/

/-- **`(3) ⇒ (1)` of Stacks tag 0690 with the conormal sequence split on all of `Z`.**  Let
`i : Z ⟶ Y` and `j : Y ⟶ X` be immersions of schemes with `X` locally Noetherian, let `z : Z`
and let `y = i z`.  If `i ≫ j` is a regular immersion in a neighbourhood of `z` and the conormal
sequence of the pair is exact and locally split, then `i` is a regular immersion in a
neighbourhood of `z` and `j` is one in a neighbourhood of `y`. -/
@[ega "IV 19.1.5" "(iv), c)⇒a)", sga "6 VIII 1.3" "(iii), special case"]
theorem exists_opens_isRegularImmersion_of_split (i : Z ⟶ Y) (j : Y ⟶ X) [IsImmersion i]
    [IsImmersion j] [IsLocallyNoetherian X] (hS : IsSplitExactConormalSequence i j) (z : Z)
    (hji : ∃ U : Z.Opens, z ∈ U ∧ IsRegularImmersion (U.ι ≫ (i ≫ j))) :
    (∃ W : Z.Opens, z ∈ W ∧ IsRegularImmersion (W.ι ≫ i)) ∧
      ∃ V : Y.Opens, i.base z ∈ V ∧ IsRegularImmersion (V.ι ≫ j) := by
  have hY : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian j
  have hreg : ∃ rs : List (X.presheaf.stalk (j.base (i.base z))),
      IsRegular (X.presheaf.stalk (j.base (i.base z))) rs ∧
        Ideal.ofList rs = RingHom.ker ((i ≫ j).stalkMap z).hom :=
    mem_regularStalkLocus_of_exists_opens (i ≫ j) z hji
  obtain ⟨hj, hi⟩ := exists_isRegular_generating_ker_stalkMap_factors i j z
    (injective_mapQ_ker_stalkMap_of_isSplitExactConormalSequence i j hS z) hreg
  exact ⟨exists_opens_isRegularImmersion_of_mem_regularStalkLocus i z hi,
    exists_opens_isRegularImmersion_of_mem_regularStalkLocus j (i.base z) hj⟩

/-- **Stacks tag 0690, `(3) ⇒ (1)`.**  Let `i : Z ⟶ Y` and `j : Y ⟶ X` be immersions of schemes
with `X` locally Noetherian, let `z : Z` and let `y = i z`.  If `i ≫ j` is a regular immersion in
a neighbourhood of `z` and the conormal sequence of the pair is exact and locally split in a
neighbourhood of `z`, then `i` is a regular immersion in a neighbourhood of `z` and `j` is one in
a neighbourhood of `y`. -/
@[stacks 0690 "(3) => (1)"]
theorem exists_opens_isRegularImmersion_of_split_near (i : Z ⟶ Y) (j : Y ⟶ X) [IsImmersion i]
    [IsImmersion j] [IsLocallyNoetherian X] (z : Z)
    (hji : ∃ U : Z.Opens, z ∈ U ∧ IsRegularImmersion (U.ι ≫ (i ≫ j)))
    (hS : ∃ W : Z.Opens, z ∈ W ∧ IsSplitExactConormalSequence (W.ι ≫ i) j) :
    (∃ W : Z.Opens, z ∈ W ∧ IsRegularImmersion (W.ι ≫ i)) ∧
      ∃ V : Y.Opens, i.base z ∈ V ∧ IsRegularImmersion (V.ι ≫ j) := by
  obtain ⟨W, hzW, hWS⟩ := hS
  have hY : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian j
  have hmem : z ∈ regularStalkLocus (i ≫ j) :=
    mem_regularStalkLocus_of_exists_opens (i ≫ j) z hji
  have hji' : ∃ U : W.toScheme.Opens, (⟨z, hzW⟩ : W.toScheme) ∈ U ∧
      IsRegularImmersion (U.ι ≫ ((W.ι ≫ i) ≫ j)) := by
    refine exists_opens_isRegularImmersion_of_mem_regularStalkLocus ((W.ι ≫ i) ≫ j) _ ?_
    rw [Category.assoc]
    exact (mem_regularStalkLocus_comp_isOpenImmersion W.ι (i ≫ j) ⟨z, hzW⟩).mpr hmem
  obtain ⟨hi, hj⟩ := exists_opens_isRegularImmersion_of_split (W.ι ≫ i) j hWS ⟨z, hzW⟩ hji'
  refine ⟨exists_opens_isRegularImmersion_of_mem_regularStalkLocus i z ?_, hj⟩
  exact (mem_regularStalkLocus_comp_isOpenImmersion W.ι i ⟨z, hzW⟩).mp
    (mem_regularStalkLocus_of_exists_opens (W.ι ≫ i) ⟨z, hzW⟩ hi)

/-! ### Regular generators of the kernel of a composite -/

/-- Every list in the target of a surjection of rings is the image of a list in its source. -/
private theorem exists_list_map_eq_of_surjective {A B : Type u} [CommRing A] [CommRing B]
    (φ : A →+* B) (hφ : Function.Surjective φ) (ss : List B) :
    ∃ g : List A, g.map φ = ss := by
  induction ss with
  | nil => exact ⟨[], rfl⟩
  | cons b t ih =>
    obtain ⟨g, hg⟩ := ih
    obtain ⟨a, ha⟩ := hφ b
    exact ⟨a :: g, by rw [List.map_cons, ha, hg]⟩

/-- **The kernel of a composite is generated by a regular sequence.**  Let `φ : A →+* B` be a
surjection whose kernel is generated by a regular sequence of `A`, and let `ψ : B →+* C` have
kernel generated by a regular sequence of `B`.  Then the kernel of `ψ ∘ φ` is generated by a
regular sequence of `A`:  lifts of the second sequence extend the first. -/
@[sga "6 VII 4.2" "special case"]
private theorem exists_isRegular_ker_comp_of_surjective {A B C : Type u} [CommRing A]
    [CommRing B] [CommRing C] [Nontrivial C] (φ : A →+* B) (hφ : Function.Surjective φ)
    (ψ : B →+* C)
    (hA : ∃ rs : List A, IsRegular A rs ∧ Ideal.ofList rs = RingHom.ker φ)
    (hB : ∃ ss : List B, IsRegular B ss ∧ Ideal.ofList ss = RingHom.ker ψ) :
    ∃ ts : List A, IsRegular A ts ∧ Ideal.ofList ts = RingHom.ker (ψ.comp φ) := by
  obtain ⟨rs, hrs, hrsI⟩ := hA
  obtain ⟨ss, hss, hssJ⟩ := hB
  obtain ⟨g, hg⟩ := exists_list_map_eq_of_surjective φ hφ ss
  have hker : Ideal.ofList (rs ++ g) = RingHom.ker (ψ.comp φ) := by
    rw [Ideal.ofList_append, hrsI, ← RingHom.comap_ker ψ φ, ← hssJ, ← hg, ← Ideal.map_ofList,
      Ideal.comap_map_of_surjective φ hφ, ← RingHom.ker_eq_comap_bot]
    exact sup_comm _ _
  refine ⟨rs ++ g, ⟨isWeaklyRegular_append_of_ker_eq φ hφ hrs.toIsWeaklyRegular hrsI.symm ?_, ?_⟩,
    hker⟩
  · rw [hg]
    exact hss.toIsWeaklyRegular
  · rw [show Ideal.ofList (rs ++ g) • (⊤ : Submodule A A) = Ideal.ofList (rs ++ g) by
      rw [Ideal.smul_eq_mul, Ideal.mul_top], hker]
    exact (RingHom.ker_ne_top (ψ.comp φ)).symm

/-- **Stacks tag 0690, `(1) ⇒ (2)`.**  Let `i : Z ⟶ Y` and `j : Y ⟶ X` be immersions of schemes
with `X` locally Noetherian and let `z : Z`.  If `i` is a regular immersion in a neighbourhood of
`z` and `j` is one in a neighbourhood of `i z`, then `i ≫ j` is a regular immersion in a
neighbourhood of `z`. -/
@[stacks 0690 "(1) => (2)"]
theorem exists_opens_isRegularImmersion_comp_of_factors (i : Z ⟶ Y) (j : Y ⟶ X) [IsImmersion i]
    [IsImmersion j] [IsLocallyNoetherian X] (z : Z)
    (hi : ∃ W : Z.Opens, z ∈ W ∧ IsRegularImmersion (W.ι ≫ i))
    (hj : ∃ V : Y.Opens, i.base z ∈ V ∧ IsRegularImmersion (V.ι ≫ j)) :
    ∃ U : Z.Opens, z ∈ U ∧ IsRegularImmersion (U.ι ≫ (i ≫ j)) := by
  refine exists_opens_isRegularImmersion_of_mem_regularStalkLocus (i ≫ j) z ?_
  show ∃ ts : List (X.presheaf.stalk ((i ≫ j).base z)),
    IsRegular (X.presheaf.stalk ((i ≫ j).base z)) ts ∧
      Ideal.ofList ts = RingHom.ker ((i ≫ j).stalkMap z).hom
  rw [stalkMap_comp_hom]
  exact exists_isRegular_ker_comp_of_surjective (j.stalkMap (i.base z)).hom
    (j.stalkMap_surjective (i.base z)) (i.stalkMap z).hom
    (mem_regularStalkLocus_of_exists_opens j (i.base z) hj)
    (mem_regularStalkLocus_of_exists_opens i z hi)

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
