/-!
# Regular immersions into a locally Noetherian scheme

For an immersion into a locally Noetherian scheme the four notions of regularity of Stacks tag
063J — regular, Koszul-regular, `H₁`-regular and quasi-regular — are equivalent.

## Main results

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularImmersion_iff_isKoszulRegularImmersion`:
  parts (1) and (2) of Stacks tag 063J agree over a locally Noetherian base.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isKoszulRegularImmersion_iff_isH1RegularImmersion`
  and `Stacks.AlgebraicGeometry.RegularIdealSheaf.isH1RegularImmersion_iff_isQuasiRegularImmersion`:
  the remaining two links of the chain.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.regularImmersion_tfae`: all four parts of Stacks
  tag 063J agree over a locally Noetherian base.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.regularIdealSheaf_tfae`: the closing assertion of
  Stacks tag 063I, that on a locally Noetherian scheme the four notions of Stacks tag 063D agree
  for a quasi-coherent sheaf of ideals.

## Implementation notes

One direction is Stacks tag 063C and needs no hypothesis on the target.  For the other, the chain
of Stacks tag 063K turns Koszul-regularity into quasi-regularity, and the affine criterion of
Stacks tag 063G then presents the defining ideal of the canonical closed factor
`i.liftCoborder` as generated by a quasi-regular sequence on an affine open around each point of
the support.  That is condition (8) of Stacks tag 063I for the kernel ideal sheaf
`i.liftCoborder.ker`, whose condition (5) returns a regular generating sequence on an affine open;
the affine criterion read backwards makes the defining ideal regular.

Passing between the two presentations of the ideal sheaf — an ideal subsheaf of the structure
sheaf, as `Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularIdealSheaf` takes it, and a family
of ideals indexed by the affine opens, as `Stacks.AlgebraicGeometry.RegularIdealSheaf.regular_tfae`
takes it — is `isGeneratedByOn_definingIdealOfHom_iff`, which on an affine open identifies
generation of the defining ideal with the corresponding equality of ideals of sections.

## References

* [Stacks Project, Lemma 31.21.3 (Tag 063L)](https://stacks.math.columbia.edu/tag/063L)
* [Stacks Project, Lemma 31.20.6 (Tag 063I)](https://stacks.math.columbia.edu/tag/063I)
* [Stacks Project, Lemma 31.20.3 (Tag 063G)](https://stacks.math.columbia.edu/tag/063G)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace RingTheory.Sequence

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

variable {Z X : Scheme.{u}}

/-- **Generation of a defining ideal on an affine open, read as an equality of ideals.** For a
closed immersion `j` and an affine open `U` of its target, a family of sections generates
`definingIdealOfHom j` over `U` exactly when it spans the ideal that `Scheme.Hom.ker j` assigns
to `U`. -/
theorem isGeneratedByOn_definingIdealOfHom_iff (j : Z ⟶ X) [IsClosedImmersion j]
    (U : X.affineOpens) {r : ℕ} (f : Fin r → Γ(X, U.1)) :
    IsGeneratedByOn X.toRingedSpace (definingIdealOfHom j) U.1 f ↔
      j.ker.ideal U = Ideal.span (Set.range f) := by
  refine ⟨fun h => ?_, fun h => ?_⟩
  · rw [← definingIdealOfHom_obj_eq_ker j U]
    exact obj_self_eq_span_of_isGeneratedByOn U.2 f h
  · exact isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span j U.2 f
      ((j.ker_apply U).symm.trans h)

/-- A quasi-regular immersion into a locally Noetherian scheme is regular. -/
private theorem isRegularImmersion_of_isQuasiRegularImmersion_aux (i : Z ⟶ X) [IsImmersion i]
    [IsLocallyNoetherian X] (hQ0 : IsQuasiRegularImmersion i) : IsRegularImmersion i := by
  have hQ : IsQuasiRegularIdealSheaf
      i.coborderRange.toScheme.toLocallyRingedSpace.toRingedSpace
      (definingIdealOfHom i.liftCoborder) :=
    (isQuasiRegularImmersion_iff_of_open i i.coborderRange i.liftCoborder i.liftCoborder_ι).mp hQ0
  refine (isRegularImmersion_iff_of_open i i.coborderRange i.liftCoborder
    i.liftCoborder_ι).mpr ?_
  refine (isRegularIdealSheaf_iff_exists_affine_generators i.coborderRange.toScheme
    (definingIdealOfHom i.liftCoborder)).mpr fun x hx => ?_
  have hxr : x ∈ Set.range i.liftCoborder.base :=
    (Set.ext_iff.mp (definingIdealQuotient_support_eq_range i.liftCoborder) x).mp hx
  have hxs : x ∈ i.liftCoborder.ker.support := by
    change x ∈ (i.liftCoborder.ker.support : Set i.coborderRange.toScheme)
    rw [Scheme.Hom.support_ker i.liftCoborder]
    exact subset_closure hxr
  obtain ⟨U, hxU, r, f, hgen, hqr⟩ :=
    (isQuasiRegularIdealSheaf_iff_exists_affine_generators i.coborderRange.toScheme
      (definingIdealOfHom i.liftCoborder)).mp hQ x hx
  have htfae := (regular_tfae i.liftCoborder.ker x hxs).out 8 5
  obtain ⟨V, hxV, s, g, hgenV, hregV⟩ := htfae.mp
    ⟨U, hxU, r, f, (isGeneratedByOn_definingIdealOfHom_iff i.liftCoborder U f).mp hgen, hqr⟩
  exact ⟨V, hxV, s, g,
    (isGeneratedByOn_definingIdealOfHom_iff i.liftCoborder V g).mpr hgenV,
    hregV.toIsWeaklyRegular⟩

/-- **Stacks tag 063L, parts (1) and (2).** An immersion into a locally Noetherian scheme is
regular if and only if it is Koszul-regular. -/
@[stacks 063L "regular iff Koszul-regular"]
theorem isRegularImmersion_iff_isKoszulRegularImmersion (i : Z ⟶ X) [IsImmersion i]
    [IsLocallyNoetherian X] :
    IsRegularImmersion i ↔ IsKoszulRegularImmersion i :=
  ⟨isKoszulRegularImmersion_of_isRegularImmersion i, fun hK =>
    isRegularImmersion_of_isQuasiRegularImmersion_aux i
      (isQuasiRegularImmersion_of_isH1RegularImmersion i
        (isH1RegularImmersion_of_isKoszulRegularImmersion i hK))⟩

/-- **Quasi-regularity implies regularity over a locally Noetherian target.** The affine
criterion of Stacks tag 063G presents the defining ideal of the canonical closed factor
`i.liftCoborder` as generated by a quasi-regular sequence near each point of the support, which
is condition (8) of Stacks tag 063I; its condition (5) returns a regular generating sequence. -/
@[ega "IV 16.9.10" "(ii)", ega "IV 16.9.11" "more general"]
theorem isRegularImmersion_of_isQuasiRegularImmersion (i : Z ⟶ X) [IsImmersion i]
    [IsLocallyNoetherian X] (hQ0 : IsQuasiRegularImmersion i) : IsRegularImmersion i :=
  isRegularImmersion_of_isQuasiRegularImmersion_aux i hQ0

/-- **Quasi-regularity implies Koszul-regularity over a locally Noetherian target.** Only the
hypothesis-free direction of Stacks tag 063K is used to climb back from regularity. -/
theorem isKoszulRegularImmersion_of_isQuasiRegularImmersion (i : Z ⟶ X) [IsImmersion i]
    [IsLocallyNoetherian X] (hQ : IsQuasiRegularImmersion i) : IsKoszulRegularImmersion i :=
  isKoszulRegularImmersion_of_isRegularImmersion i
    (isRegularImmersion_of_isQuasiRegularImmersion i hQ)

/-- **Stacks tag 063L, parts (2) and (3).** An immersion into a locally Noetherian scheme is
Koszul-regular if and only if it is `H₁`-regular. -/
@[stacks 063L "Koszul-regular iff H₁-regular"]
theorem isKoszulRegularImmersion_iff_isH1RegularImmersion (i : Z ⟶ X) [IsImmersion i]
    [IsLocallyNoetherian X] :
    IsKoszulRegularImmersion i ↔ IsH1RegularImmersion i :=
  ⟨isH1RegularImmersion_of_isKoszulRegularImmersion i, fun h =>
    isKoszulRegularImmersion_of_isQuasiRegularImmersion i
      (isQuasiRegularImmersion_of_isH1RegularImmersion i h)⟩

/-- **Stacks tag 063L, parts (3) and (4).** An immersion into a locally Noetherian scheme is
`H₁`-regular if and only if it is quasi-regular. -/
@[stacks 063L "H₁-regular iff quasi-regular"]
theorem isH1RegularImmersion_iff_isQuasiRegularImmersion (i : Z ⟶ X) [IsImmersion i]
    [IsLocallyNoetherian X] :
    IsH1RegularImmersion i ↔ IsQuasiRegularImmersion i :=
  ⟨isQuasiRegularImmersion_of_isH1RegularImmersion i, fun h =>
    isH1RegularImmersion_of_isKoszulRegularImmersion i
      (isKoszulRegularImmersion_of_isQuasiRegularImmersion i h)⟩

/-- **Stacks tag 063L.** For an immersion into a locally Noetherian scheme the four notions of
regularity — regular, Koszul-regular, `H₁`-regular and quasi-regular — are equivalent. -/
@[stacks 063L "the four notions agree over a locally Noetherian base",
  ega "IV 16.9.10",
  ega "IV 16.9.11" "more general"]
theorem regularImmersion_tfae (i : Z ⟶ X) [IsImmersion i] [IsLocallyNoetherian X] :
    List.TFAE [IsRegularImmersion i, IsKoszulRegularImmersion i, IsH1RegularImmersion i,
      IsQuasiRegularImmersion i] := by
  tfae_have 1 ↔ 2 := isRegularImmersion_iff_isKoszulRegularImmersion i
  tfae_have 2 ↔ 3 := isKoszulRegularImmersion_iff_isH1RegularImmersion i
  tfae_have 3 ↔ 4 := isH1RegularImmersion_iff_isQuasiRegularImmersion i
  tfae_finish

/-- **A quasi-regular defining ideal is regular over a locally Noetherian target.** Let `j` be a
closed immersion into a locally Noetherian scheme.  If its defining ideal sheaf is quasi-regular,
it is regular: the affine criterion of Stacks tag 063G presents it as generated by a quasi-regular
sequence on an affine open around each point of the support, which is condition (8) of Stacks
tag 063I for `j.ker`, and condition (5) returns a regular generating sequence. -/
theorem isRegularIdealSheaf_of_isQuasiRegularIdealSheaf_definingIdealOfHom (j : Z ⟶ X)
    [IsClosedImmersion j] [IsLocallyNoetherian X]
    (hQ : IsQuasiRegularIdealSheaf X.toRingedSpace (definingIdealOfHom j)) :
    IsRegularIdealSheaf X.toRingedSpace (definingIdealOfHom j) := by
  refine (isRegularIdealSheaf_iff_exists_affine_generators X (definingIdealOfHom j)).mpr
    fun x hx => ?_
  have hxr : x ∈ Set.range j.base :=
    (Set.ext_iff.mp (definingIdealQuotient_support_eq_range j) x).mp hx
  have hxs : x ∈ j.ker.support := by
    change x ∈ (j.ker.support : Set X)
    rw [Scheme.Hom.support_ker j]
    exact subset_closure hxr
  obtain ⟨U, hxU, r, f, hgen, hqr⟩ :=
    (isQuasiRegularIdealSheaf_iff_exists_affine_generators X (definingIdealOfHom j)).mp hQ x hx
  have htfae := (regular_tfae j.ker x hxs).out 8 5
  obtain ⟨V, hxV, s, g, hgenV, hregV⟩ := htfae.mp
    ⟨U, hxU, r, f, (isGeneratedByOn_definingIdealOfHom_iff j U f).mp hgen, hqr⟩
  exact ⟨V, hxV, s, g, (isGeneratedByOn_definingIdealOfHom_iff j V g).mpr hgenV,
    hregV.toIsWeaklyRegular⟩

/-- **Stacks tag 063I, the closing assertion.** On a locally Noetherian scheme `X` the four notions
of Stacks tag 063D agree for a quasi-coherent sheaf of ideals: the ideal subsheaf of `O_X` cut
out by `I : X.IdealSheafData` (the sections dying on the closed subscheme `I.subschemeι`, whose
sections over an affine open `U` are `I.ideal U`) is regular, if and only if it is
Koszul-regular, if and only if it is `H₁`-regular, if and only if it is quasi-regular. -/
@[stacks 063I "in particular"]
theorem regularIdealSheaf_tfae [IsLocallyNoetherian X] (I : X.IdealSheafData) :
    List.TFAE
      [IsRegularIdealSheaf X.toRingedSpace (definingIdealOfHom I.subschemeι),
        IsKoszulRegularIdealSheaf X.toRingedSpace (definingIdealOfHom I.subschemeι),
        IsH1RegularIdealSheaf X.toRingedSpace (definingIdealOfHom I.subschemeι),
        IsQuasiRegularIdealSheaf X.toRingedSpace (definingIdealOfHom I.subschemeι)] := by
  tfae_have 1 → 2 := isKoszulRegularIdealSheaf_of_isRegularIdealSheaf _ _
  tfae_have 2 → 3 := IsKoszulRegularIdealSheaf.isH1RegularIdealSheaf
  tfae_have 3 → 4 := isQuasiRegularIdealSheaf_of_isH1RegularIdealSheaf _ _
  tfae_have 4 → 1 := isRegularIdealSheaf_of_isQuasiRegularIdealSheaf_definingIdealOfHom _
  tfae_finish

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
