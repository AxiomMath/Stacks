module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularIdealSheaf.NoetherianEquivalence
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Independence
public import StacksFrontier.AlgebraicGeometry.ConormalSheaf.Basic
public import StacksFrontier.AlgebraicGeometry.GeneratedIdealSheafAffine.AffineSections
public import StacksFrontier.AlgebraicGeometry.RegularImmersion.BaseChange
