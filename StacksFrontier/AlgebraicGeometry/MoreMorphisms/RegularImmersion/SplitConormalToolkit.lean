module

public import Mathlib.RingTheory.RingHom.Flat
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularImmersion.SplitConormalSequence
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Generators
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.ImmersionStalk
public import StacksFrontier.AlgebraicGeometry.RegularImmersion.OpenIndependence
public import StacksFrontier.RingTheory.Koszul.Concatenation
public import StacksFrontier.AlgebraicGeometry.QuasiRegular.StalkGenerators

/-!
# Stalk-ideal toolkit for the split conormal sequence

Generators of the defining ideal sheaf of an immersion, read in the local rings: how the
germs of a generating family generate the kernel of the induced map of local rings, how the
stalk ideal behaves under a composition of immersions and off the image, and the shrinking
arguments that let a germ identity be realised on an open neighbourhood.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.RingTheory.QuasiRegular
open Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

namespace Stacks.AlgebraicGeometry

variable {Z Y X : Scheme.{u}}

/-- The ideal generated by a concatenation of two sequences is the sum of the two ideals. -/
theorem jid_append {R : Type*} [CommRing R] {n m : ℕ} (f : Fin n → R) (g : Fin m → R) :
    Jid (Fin.append f g) = Jid f ⊔ Jid g := by
  refine le_antisymm (Ideal.span_le.2 ?_) (sup_le (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_))
  · rintro _ ⟨k, rfl⟩
    refine Fin.addCases (fun a => ?_) (fun b => ?_) k
    · exact Ideal.mem_sup_left (Ideal.subset_span ⟨a, by simp⟩)
    · exact Ideal.mem_sup_right (Ideal.subset_span ⟨b, by simp⟩)
  · rintro _ ⟨a, rfl⟩
    exact Ideal.subset_span ⟨Fin.castAdd m a, by simp⟩
  · rintro _ ⟨b, rfl⟩
    exact Ideal.subset_span ⟨Fin.natAdd n b, by simp⟩

/-- The germs of a concatenation of two families of sections are the concatenation of their
germs. -/
lemma germFamily_append (W : RingedSpace.{u}) (U : Opens W) {n m : ℕ}
    (f : Fin n → W.presheaf.obj (op U)) (g : Fin m → W.presheaf.obj (op U)) (y : W) (hy : y ∈ U) :
    germFamily W U (Fin.append f g) y hy =
      Fin.append (germFamily W U f y hy) (germFamily W U g y hy) := by
  funext k
  refine Fin.addCases (fun a => ?_) (fun b => ?_) k
  · simp only [germFamily, Fin.append_left]
  · simp only [germFamily, Fin.append_right]

/-- A section lies in the defining ideal sheaf of `j` exactly when `j` pulls it back to zero. -/
lemma mem_definingIdealOfHom_iff' (j : Z ⟶ X) (U : X.Opens) (s : Γ(X, U)) :
    s ∈ (definingIdealOfHom j).obj (op U) ↔ j.app U s = 0 := Iff.rfl

/-- The germs of a generating family of the defining ideal sheaf generate the kernel of the
induced map of local rings. -/
theorem ker_stalkMap_eq_jid (j : Z ⟶ X) [IsImmersion j] (U : X.Opens) {n : ℕ}
    (f : Fin n → Γ(X, U)) (hgen : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom j) U f)
    (z : Z) (hz : j z ∈ U) :
    RingHom.ker (j.stalkMap z).hom = Jid (germFamily X.toRingedSpace U f (j z) hz) :=
  (stalkIdeal_definingIdealOfHom_eq_ker j z).symm.trans
    (stalkIdeal_eq_jid_of_isGeneratedByOn (definingIdealOfHom j) f hgen (j z) hz)

/-- Applying `f.app` to a restricted section is restricting the image of the section. -/
private lemma app_map_apply {A B : Scheme.{u}} (f : A ⟶ B) {V' V : B.Opens} (i : V' ⟶ V)
    (t : Γ(B, V)) :
    f.app V' (B.presheaf.map i.op t) =
      A.presheaf.map (homOfLE ((Opens.map f.base).monotone i.le)).op (f.app V t) :=
  ConcreteCategory.congr_hom (f.naturality i.op) t

/-- For an immersion `j`, the stalk at `y` of the defining ideal sheaf of `i` lies in the image
of the stalk at `j y` of the defining ideal sheaf of `i ≫ j`. -/
private lemma stalkIdeal_definingIdealOfHom_le_map_comp (i : Z ⟶ Y) (j : Y ⟶ X) [IsImmersion j]
    (y : Y) :
    Stacks.RingedSpace.stalkIdeal (X := Y.toLocallyRingedSpace) (definingIdealOfHom i) y ≤
      Ideal.map (j.stalkMap y).hom (Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
        (definingIdealOfHom (i ≫ j)) (j y)) := by
  intro a ha
  obtain ⟨V, hyV, t, ht, rfl⟩ := (Stacks.RingedSpace.mem_stalkIdeal_iff _).mp ha
  obtain ⟨b, hb⟩ := j.stalkMap_surjective y (Y.presheaf.germ V y hyV t)
  rw [← hb]
  refine Ideal.mem_map_of_mem _ ?_
  obtain ⟨U, hxU, s, hs⟩ := X.presheaf.exists_germ_eq b
  have hgerm : Y.presheaf.germ (j ⁻¹ᵁ U) y hxU (j.app U s) = Y.presheaf.germ V y hyV t := by
    rw [← Scheme.Hom.germ_stalkMap_apply, hs, hb]
  obtain ⟨Q, hyQ, iQU, iQV, heq⟩ :=
    Y.presheaf.germ_eq y hxU hyV (j.app U s) t hgerm
  obtain ⟨A, hA, hQA⟩ := j.isEmbedding.isInducing.isOpen_iff.mp Q.isOpen
  have hPU : (⟨A, hA⟩ ⊓ U : X.Opens) ≤ U := inf_le_right
  have hpre : j ⁻¹ᵁ (⟨A, hA⟩ ⊓ U : X.Opens) ≤ Q := by
    intro y' hy'
    show y' ∈ (Q : Set Y)
    rw [← hQA]
    exact hy'.1
  have hpreU : j ⁻¹ᵁ (⟨A, hA⟩ ⊓ U : X.Opens) ≤ j ⁻¹ᵁ U :=
    (Opens.map j.base).monotone hPU
  have hyA : j y ∈ (⟨A, hA⟩ : X.Opens) := by
    show y ∈ j.base ⁻¹' A
    rwa [hQA]
  refine (Stacks.RingedSpace.mem_stalkIdeal_iff _).mpr
    ⟨(⟨A, hA⟩ ⊓ U : X.Opens), ⟨hyA, hxU⟩, X.presheaf.map (homOfLE hPU).op s, ?_, ?_⟩
  · have hjmap : j.app (⟨A, hA⟩ ⊓ U : X.Opens) (X.presheaf.map (homOfLE hPU).op s) =
        Y.presheaf.map (homOfLE hpreU).op (j.app U s) := app_map_apply j (homOfLE hPU) s
    have hQ : i.app Q (Y.presheaf.map iQV.op t) = 0 := by
      rw [app_map_apply, show i.app V t = 0 from ht, map_zero]
    refine (mem_definingIdealOfHom_iff' (i ≫ j) _ _).mpr ?_
    show i.app (j ⁻¹ᵁ (⟨A, hA⟩ ⊓ U : X.Opens))
      (j.app (⟨A, hA⟩ ⊓ U : X.Opens) (X.presheaf.map (homOfLE hPU).op s)) = 0
    rw [hjmap, show homOfLE hpreU = homOfLE hpre ≫ iQU from Subsingleton.elim _ _,
      op_comp, Functor.map_comp, CategoryTheory.comp_apply, heq]
    rw [app_map_apply i (homOfLE hpre), hQ, map_zero]
  · exact (X.presheaf.germ_res_apply (homOfLE hPU) (j y) ⟨hyA, hxU⟩ s).trans hs

/-- **The stalk of the ideal of `Z` in `Y` is the image of its stalk in `X`.** For immersions
`i : Z ⟶ Y` and `j : Y ⟶ X`, the stalk at `y` of the defining ideal sheaf of `i` is the image under
`O_{X, j y} ⟶ O_{Y, y}` of the stalk at `j y` of the defining ideal sheaf of `i ≫ j`. -/
lemma stalkIdeal_definingIdealOfHom_comp (i : Z ⟶ Y) (j : Y ⟶ X) [IsImmersion j] (y : Y) :
    Stacks.RingedSpace.stalkIdeal (X := Y.toLocallyRingedSpace) (definingIdealOfHom i) y =
      Ideal.map (j.stalkMap y).hom (Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
        (definingIdealOfHom (i ≫ j)) (j y)) := by
  refine le_antisymm (stalkIdeal_definingIdealOfHom_le_map_comp i j y)
    (Ideal.map_le_iff_le_comap.mpr fun a ha => ?_)
  obtain ⟨U, hxU, s, hs, rfl⟩ := (Stacks.RingedSpace.mem_stalkIdeal_iff _).mp ha
  have hs' : j.app U s ∈ (definingIdealOfHom i).obj (op (j ⁻¹ᵁ U)) := by
    refine (mem_definingIdealOfHom_iff' i _ _).mpr ?_
    have h0 := (mem_definingIdealOfHom_iff' (i ≫ j) U s).mp hs
    rwa [Scheme.Hom.comp_app] at h0
  show (j.stalkMap y).hom (X.presheaf.germ U (j y) hxU s) ∈
    Stacks.RingedSpace.stalkIdeal (X := Y.toLocallyRingedSpace) (definingIdealOfHom i) y
  rw [Scheme.Hom.germ_stalkMap_apply]
  exact (Stacks.RingedSpace.mem_stalkIdeal_iff _).mpr ⟨j ⁻¹ᵁ U, hxU, j.app U s, hs', rfl⟩

/-- The stalk of the defining ideal sheaf of a closed immersion is the unit ideal away from its
image. -/
theorem stalkIdeal_definingIdealOfHom_eq_top_of_notMem_range (j : Z ⟶ X)
    [IsClosedImmersion j] (x : X) (hx : x ∉ Set.range j.base) :
    Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace) (definingIdealOfHom j) x = ⊤ := by
  have hpre : j ⁻¹ᵁ (⟨(Set.range j.base)ᶜ, j.isClosedEmbedding.isClosed_range.isOpen_compl⟩ :
      X.Opens) = ⊥ := by
    ext z
    simp
  have hzero : j.app (⟨(Set.range j.base)ᶜ,
      j.isClosedEmbedding.isClosed_range.isOpen_compl⟩ : X.Opens) 1 = 0 := by
    rw [map_one, hpre]
    exact Subsingleton.elim _ _
  refine (Ideal.eq_top_iff_one _).mpr ((Stacks.RingedSpace.mem_stalkIdeal_iff _).mpr
    ⟨⟨(Set.range j.base)ᶜ, j.isClosedEmbedding.isClosed_range.isOpen_compl⟩, hx, 1,
      (mem_definingIdealOfHom_iff' j _ _).mpr hzero, by simp⟩)

/-- The stalk of an ideal sheaf generated by finitely many sections is finitely generated. -/
theorem stalkIdeal_fg_of_isGeneratedByOn {W : LocallyRingedSpace.{u}}
    (J : (Stacks.RingedSpace.structureSheafModule W.toRingedSpace).Submodule) (U : Opens W)
    {r : ℕ} (f : Fin r → W.presheaf.obj (op U))
    (hgen : IsGeneratedByOn W.toRingedSpace J U f) (x : W) (hx : x ∈ U) :
    (Stacks.RingedSpace.stalkIdeal J x).FG := by
  rw [stalkIdeal_eq_jid_of_isGeneratedByOn J f hgen x hx]
  exact Submodule.fg_span (Set.finite_range (germFamily W.toRingedSpace U f x hx))

/-- The germ of a section transported to the image of an open immersion. -/
lemma germ_appIso_inv {W : Scheme.{u}} (f : W ⟶ X) [IsOpenImmersion f] (U : W.Opens)
    (x : W) (hx : x ∈ U) (hfx : f x ∈ f ''ᵁ U) (s : Γ(W, U)) :
    f.stalkMap x (X.presheaf.germ (f ''ᵁ U) (f x) hfx ((f.appIso U).inv s)) =
      W.presheaf.germ U x hx s := by
  rw [Scheme.Hom.germ_stalkMap_apply,
    show f.app (f ''ᵁ U) ((f.appIso U).inv s) =
      W.presheaf.map (eqToHom (f.preimage_image_eq U)).op s from
      ConcreteCategory.congr_hom (Scheme.Hom.appIso_inv_app f U) s]
  exact TopCat.Presheaf.germ_res_apply W.presheaf (eqToHom (f.preimage_image_eq U)) x hfx s

/-- Two finite families of sections with the same germs at a point agree on a neighbourhood. -/
lemma exists_open_map_eq_of_germ_eq {W : LocallyRingedSpace.{u}} (x : W) (U V : Opens W)
    (hxU : x ∈ U) (hxV : x ∈ V) {n : ℕ} (s : Fin n → W.presheaf.obj (op U))
    (t : Fin n → W.presheaf.obj (op V))
    (h : ∀ i, W.presheaf.germ U x hxU (s i) = W.presheaf.germ V x hxV (t i)) :
    ∃ (O : Opens W) (_ : x ∈ O) (hOU : O ≤ U) (hOV : O ≤ V),
      ∀ i, W.presheaf.map (homOfLE hOU).op (s i) = W.presheaf.map (homOfLE hOV).op (t i) := by
  classical
  choose P hP iPU iPV heq using fun i : Fin n =>
    W.presheaf.germ_eq x hxU hxV (s i) (t i) (h i)
  have hOU : (⨅ i : Fin n, P i) ⊓ U ⊓ V ≤ U := le_trans inf_le_left inf_le_right
  have hOV : (⨅ i : Fin n, P i) ⊓ U ⊓ V ≤ V := inf_le_right
  have hOP : ∀ i, (⨅ i : Fin n, P i) ⊓ U ⊓ V ≤ P i := fun i =>
    le_trans (le_trans inf_le_left inf_le_left) (iInf_le P i)
  have hxInf : x ∈ (⨅ i : Fin n, P i : Opens W) := by
    show x ∈ ((⨅ i : Fin n, P i : Opens W) : Set W)
    rw [Opens.coe_iInf]
    exact Set.mem_iInter.mpr hP
  refine ⟨(⨅ i : Fin n, P i) ⊓ U ⊓ V, ⟨⟨hxInf, hxU⟩, hxV⟩, hOU, hOV, fun i => ?_⟩
  calc W.presheaf.map (homOfLE hOU).op (s i)
      = W.presheaf.map (homOfLE (hOP i) ≫ iPU i).op (s i) := by
        rw [show homOfLE (hOP i) ≫ iPU i = homOfLE hOU from Subsingleton.elim _ _]
    _ = W.presheaf.map (homOfLE (hOP i)).op (W.presheaf.map (iPU i).op (s i)) := by
        simp only [op_comp, Functor.map_comp, CategoryTheory.comp_apply]
    _ = W.presheaf.map (homOfLE (hOP i)).op (W.presheaf.map (iPV i).op (t i)) :=
        congrArg (fun q => W.presheaf.map (homOfLE (hOP i)).op q) (heq i)
    _ = W.presheaf.map (homOfLE (hOP i) ≫ iPV i).op (t i) := by
        simp only [op_comp, Functor.map_comp, CategoryTheory.comp_apply]
    _ = W.presheaf.map (homOfLE hOV).op (t i) := by
        rw [show homOfLE (hOP i) ≫ iPV i = homOfLE hOV from Subsingleton.elim _ _]

/-- The tail of a generating family of the ideal of `Z` generates the ideal of `i`. -/
theorem isGeneratedByOn_tail_of_comp (i : Z ⟶ Y) (j : Y ⟶ X) [IsImmersion j]
    (U : X.Opens) {n m : ℕ} (f : Fin n → Γ(X, U)) (g : Fin m → Γ(X, U))
    (hf : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom j) U f)
    (hfg : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom (i ≫ j)) U (Fin.append f g)) :
    IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom i) (j ⁻¹ᵁ U) fun b => j.app U (g b) := by
  refine isGeneratedByOn_of_forall_stalkIdeal_eq (definingIdealOfHom i) _ fun y hy => ?_
  have hyU : j y ∈ U := hy
  have hzero : Ideal.map (j.stalkMap y).hom
      (Jid (germFamily X.toRingedSpace U f (j y) hyU)) = ⊥ := by
    rw [Ideal.map_eq_bot_iff_le_ker, ← ker_stalkMap_eq_jid j U f hf y hyU]
  have hgerm : (fun b => (j.stalkMap y).hom (germFamily X.toRingedSpace U g (j y) hyU b)) =
      germFamily Y.toRingedSpace (j ⁻¹ᵁ U) (fun b => j.app U (g b)) y hy := by
    funext b
    exact Scheme.Hom.germ_stalkMap_apply j U y hyU (g b)
  rw [stalkIdeal_definingIdealOfHom_comp i j y,
    stalkIdeal_eq_jid_of_isGeneratedByOn (definingIdealOfHom (i ≫ j)) (Fin.append f g) hfg
      (j y) hyU, germFamily_append, jid_append, Ideal.map_sup, hzero, bot_sup_eq, Jid,
    Ideal.map_span, ← Set.range_comp]
  exact congrArg Ideal.span (congrArg Set.range hgerm)

end Stacks.AlgebraicGeometry

end
