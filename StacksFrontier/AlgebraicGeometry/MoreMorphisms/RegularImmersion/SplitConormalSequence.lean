open Stacks.RingedSpace Stacks.AlgebraicGeometry.RegularIdealSheaf

/-- Finitely many elements of the stalk of an ideal subsheaf are the germs of sections of that
subsheaf over one neighbourhood of the point. -/
private theorem exists_common_germ_mem {W : LocallyRingedSpace.{u}}
    (J : (structureSheafModule W.toRingedSpace).Submodule) {w : W} (n : ℕ) :
    ∀ a : Fin n → W.presheaf.stalk w, (∀ b, a b ∈ stalkIdeal J w) →
      ∃ (U : Opens W) (hw : w ∈ U) (s : Fin n → W.presheaf.obj (op U)),
        (∀ b, s b ∈ J.obj (op U)) ∧ ∀ b, W.presheaf.germ U w hw (s b) = a b := by
  induction n with
  | zero => exact fun _ _ => ⟨⊤, trivial, fun b => b.elim0, fun b => b.elim0, fun b => b.elim0⟩
  | succ n ih =>
    intro a ha
    obtain ⟨U, hwU, s, hsJ, hs⟩ := ih (fun b => a b.succ) fun b => ha b.succ
    obtain ⟨U', hwU', t, htJ, ht⟩ := (mem_stalkIdeal_iff J).mp (ha 0)
    refine ⟨U ⊓ U', ⟨hwU, hwU'⟩,
      Fin.cons (W.presheaf.map (homOfLE inf_le_right).op t)
        fun b => W.presheaf.map (homOfLE inf_le_left).op (s b), fun b => ?_, fun b => ?_⟩
    · induction b using Fin.cases with
      | zero => rw [Fin.cons_zero]; exact restrict_mem J (homOfLE inf_le_right) htJ
      | succ b => rw [Fin.cons_succ]; exact restrict_mem J (homOfLE inf_le_left) (hsJ b)
    · induction b using Fin.cases with
      | zero =>
        rw [Fin.cons_zero,
          TopCat.Presheaf.germ_res_apply W.presheaf (homOfLE inf_le_right) w ⟨hwU, hwU'⟩ t]
        exact ht
      | succ b =>
        rw [Fin.cons_succ,
          TopCat.Presheaf.germ_res_apply W.presheaf (homOfLE inf_le_left) w ⟨hwU, hwU'⟩ (s b)]
        exact hs b

/-- The class modulo `m M` of a linear combination is the combination of the classes. -/
theorem quotient_mk_sum_smul {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (m : Ideal R) {n : ℕ} (d : Fin n → R) (y : Fin n → M) :
    (Submodule.Quotient.mk (∑ b, d b • y b) : M ⧸ m • (⊤ : Submodule R M))
      = ∑ b, Ideal.Quotient.mk m (d b) • Submodule.Quotient.mk (y b) := by
  rw [← Submodule.mkQ_apply, map_sum]
  exact Finset.sum_congr rfl fun b _ => by
    rw [Submodule.mkQ_apply, Module.Quotient.mk_smul_mk]

/-- The classes of a generating family of an ideal span its cotangent fibre. -/
theorem span_range_quotient_mk_eq_top {R : Type*} [CommRing R] (m I : Ideal R) {n : ℕ}
    (v : Fin n → I) (hv : Ideal.span (Set.range fun b => (v b : R)) = I) :
    Submodule.span (R ⧸ m) (Set.range fun b =>
        (Submodule.Quotient.mk (v b) : I ⧸ m • (⊤ : Submodule R I))) = ⊤ := by
  refine eq_top_iff.mpr fun ξ _ => ?_
  obtain ⟨c, rfl⟩ := Submodule.Quotient.mk_surjective _ ξ
  have hc : (c : R) ∈ Ideal.span (Set.range fun b => (v b : R)) := by rw [hv]; exact c.2
  obtain ⟨d, hd⟩ := Ideal.mem_span_range_iff_exists_fun.mp hc
  have hcd : c = ∑ b, d b • v b := by
    refine Subtype.ext ?_
    rw [AddSubmonoidClass.coe_finsetSum, ← hd]
    rfl
  rw [hcd, quotient_mk_sum_smul]
  exact Submodule.sum_mem _ fun b _ =>
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨b, rfl⟩)

/-- The cotangent fibre of an ideal subsheaf whose stalk at a point is finitely generated is a
finite-dimensional vector space over the residue field at that point. -/
private theorem finite_idealCotangentFiber {W : LocallyRingedSpace.{u}}
    (J : (structureSheafModule W.toRingedSpace).Submodule) (w : W)
    (hfg : (stalkIdeal J w).FG) :
    Module.Finite (W.presheaf.stalk w ⧸ IsLocalRing.maximalIdeal (W.presheaf.stalk w))
      (idealCotangentFiber J w) := by
  obtain ⟨n, v, hv⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  have hmem : ∀ b, v b ∈ stalkIdeal J w := fun b => by
    rw [← hv]; exact Ideal.subset_span ⟨b, rfl⟩
  exact Module.finite_def.mpr (Submodule.fg_iff_exists_fin_generating_family.mpr
    ⟨n, fun b => Submodule.Quotient.mk ⟨v b, hmem b⟩,
      span_range_quotient_mk_eq_top _ _ (fun b => ⟨v b, hmem b⟩) hv⟩)

/-- **Adapted bases of the cotangent fibres of two nested ideal subsheaves.**  Let `I ⊆ J` be
ideal subsheaves with finitely generated stalks at `w` and suppose that an element of `I_w`
lying in `𝔪_w J_w` already lies in `𝔪_w I_w`.  Then `I_w` is generated by elements whose
classes form a basis of `I_w / 𝔪_w I_w` and extend to a basis of `J_w / 𝔪_w J_w`. -/
private theorem exists_adapted_stalk_generators {W : LocallyRingedSpace.{u}}
    (I J : (structureSheafModule W.toRingedSpace).Submodule) {w : W}
    (hIJ : stalkIdeal I w ≤ stalkIdeal J w) (hI : (stalkIdeal I w).FG)
    (hJ : (stalkIdeal J w).FG)
    (hinj : ∀ a : stalkIdeal I w,
      (Submodule.Quotient.mk ⟨(a : W.presheaf.stalk w), hIJ a.2⟩ : idealCotangentFiber J w) = 0 →
        (Submodule.Quotient.mk a : idealCotangentFiber I w) = 0) :
    ∃ (n m : ℕ) (v : Fin n → stalkIdeal I w) (u : Fin m → stalkIdeal J w)
      (bI : Module.Basis (Fin n) (W.presheaf.stalk w ⧸
          IsLocalRing.maximalIdeal (W.presheaf.stalk w)) (idealCotangentFiber I w))
      (bJ : Module.Basis (Fin n ⊕ Fin m) (W.presheaf.stalk w ⧸
          IsLocalRing.maximalIdeal (W.presheaf.stalk w)) (idealCotangentFiber J w)),
      stalkIdeal I w = Ideal.span (Set.range fun a => (v a : W.presheaf.stalk w)) ∧
      (∀ a, bI a = Submodule.Quotient.mk (v a)) ∧
      (∀ a, bJ (Sum.inl a)
        = Submodule.Quotient.mk ⟨(v a : W.presheaf.stalk w), hIJ (v a).2⟩) ∧
      (∀ b, bJ (Sum.inr b) = Submodule.Quotient.mk (u b)) := by
  classical
  have := finite_idealCotangentFiber I w hI
  have := finite_idealCotangentFiber J w hJ
  have : Nontrivial (W.presheaf.stalk w ⧸ IsLocalRing.maximalIdeal (W.presheaf.stalk w)) := by
    have : Field (W.presheaf.stalk w ⧸ IsLocalRing.maximalIdeal (W.presheaf.stalk w)) :=
      Ideal.Quotient.field _
    infer_instance
  have : Module.Free (W.presheaf.stalk w ⧸ IsLocalRing.maximalIdeal (W.presheaf.stalk w))
      (idealCotangentFiber I w) :=
    @Module.Free.of_divisionRing
      (W.presheaf.stalk w ⧸ IsLocalRing.maximalIdeal (W.presheaf.stalk w))
      (idealCotangentFiber I w) (Ideal.Quotient.field _).toDivisionRing inferInstance inferInstance
  obtain ⟨n, bI⟩ : (n : ℕ) × Module.Basis (Fin n) (W.presheaf.stalk w ⧸
      IsLocalRing.maximalIdeal (W.presheaf.stalk w)) (idealCotangentFiber I w) :=
    ⟨_, Module.finBasis _ _⟩
  choose v hv using fun a => Submodule.Quotient.mk_surjective
    (IsLocalRing.maximalIdeal (W.presheaf.stalk w) •
      (⊤ : Submodule (W.presheaf.stalk w) (stalkIdeal I w))) (bI a)
  -- The classes in `J_w / 𝔪_w J_w` of the chosen lifts are linearly independent.
  have hli : LinearIndependent
      (W.presheaf.stalk w ⧸ IsLocalRing.maximalIdeal (W.presheaf.stalk w))
      fun a => (Submodule.Quotient.mk (Submodule.inclusion hIJ (v a)) :
        idealCotangentFiber J w) := by
    refine Fintype.linearIndependent_iff.mpr fun c hc a => ?_
    choose d hd using fun b => Ideal.Quotient.mk_surjective
      (I := IsLocalRing.maximalIdeal (W.presheaf.stalk w)) (c b)
    have hsum : (Submodule.Quotient.mk (Submodule.inclusion hIJ (∑ b, d b • v b)) :
        idealCotangentFiber J w) = 0 := by
      rw [map_sum]
      simp only [map_smul]
      rw [quotient_mk_sum_smul]
      refine Eq.trans (Finset.sum_congr rfl fun b _ => ?_) hc
      rw [hd b]
    have h0 := hinj _ hsum
    rw [quotient_mk_sum_smul] at h0
    refine Fintype.linearIndependent_iff.mp bI.linearIndependent c ?_ a
    refine Eq.trans (Finset.sum_congr rfl fun b _ => ?_) h0
    rw [hd b, hv b]
  -- Extend the basis through the resulting injection of cotangent fibres.
  have hconstr : ∀ a, bI.constr ℕ
      (fun b => (Submodule.Quotient.mk (Submodule.inclusion hIJ (v b)) :
        idealCotangentFiber J w)) (bI a)
      = Submodule.Quotient.mk (Submodule.inclusion hIJ (v a)) := fun a => bI.constr_basis ℕ _ a
  have hinjc : Function.Injective (bI.constr ℕ
      fun b => (Submodule.Quotient.mk (Submodule.inclusion hIJ (v b)) :
        idealCotangentFiber J w)) := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro ξ hξ
    set c := bI.repr ξ
    have hrep : ∑ b, c b • bI b = ξ := bI.sum_repr ξ
    have hzero : ∀ b, c b = 0 := by
      refine Fintype.linearIndependent_iff.mp hli c ?_
      have hsum : ∑ b, c b • (Submodule.Quotient.mk (Submodule.inclusion hIJ (v b)) :
          idealCotangentFiber J w)
          = bI.constr ℕ (fun b => (Submodule.Quotient.mk (Submodule.inclusion hIJ (v b)) :
            idealCotangentFiber J w)) ξ := by
        rw [← hrep, map_sum]
        exact Finset.sum_congr rfl fun b _ => by rw [map_smul, hconstr b]
      rw [hsum, hξ]
    rw [← hrep]
    exact Finset.sum_eq_zero fun b _ => by rw [hzero b, zero_smul]
  obtain ⟨m, bJ, hbJ⟩ := @exists_basis_sum_of_injective
    (W.presheaf.stalk w ⧸ IsLocalRing.maximalIdeal (W.presheaf.stalk w))
    (idealCotangentFiber I w) (idealCotangentFiber J w) (Ideal.Quotient.field _)
    inferInstance inferInstance inferInstance inferInstance inferInstance n
    (bI.constr ℕ fun b => (Submodule.Quotient.mk (Submodule.inclusion hIJ (v b)) :
      idealCotangentFiber J w)) hinjc bI
  choose u hu using fun b => Submodule.Quotient.mk_surjective
    (IsLocalRing.maximalIdeal (W.presheaf.stalk w) •
      (⊤ : Submodule (W.presheaf.stalk w) (stalkIdeal J w))) (bJ (Sum.inr b))
  refine ⟨n, m, v, u, bI, bJ, ?_, fun a => (hv a).symm, fun a => ?_, fun b => (hu b).symm⟩
  · refine stalkIdeal_eq_span_of_span_idealCotangentFiber I hI v ?_
    have hfun : (fun a => (Submodule.Quotient.mk (v a) : idealCotangentFiber I w)) = bI :=
      funext hv
    rw [hfun]
    exact bI.span_eq
  · rw [hbJ a, hconstr a]
    rfl

open Stacks.AlgebraicGeometry.RegularIdealSheaf in
/-- **Local generators of the ideal of `Y` extending to minimal generators of the ideal of `Z`.**
Let `i : Z ⟶ Y` and `j : Y ⟶ X` be immersions with `j` locally of finite presentation whose
conormal sequence is exact and locally split, and let `z ∈ Z` be a point at which the ideal of
`i ≫ j` has a finitely generated stalk.  Then on a neighbourhood `U` of `x = j (i z)` on which
both immersions are closed, the ideal `I` of `Y` is generated by sections `f₁, …, f_n` whose
classes are a basis of `I_x / 𝔪_x I_x`, and these extend by sections `g₁, …, g_m` to a basis of
`J_x / 𝔪_x J_x`, where `J` is the ideal of `Z`. -/
theorem exists_adapted_local_generators (i : Z ⟶ Y) (j : Y ⟶ X)
    [IsImmersion i] [IsImmersion j] [LocallyOfFinitePresentation j]
    (hS : IsSplitExactConormalSequence i j) (z : Z)
    (hfg : (Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (definingIdealOfHom (i ≫ j)) (j (i z))).FG) :
    ∃ (U : X.Opens) (hx : j (i z) ∈ U) (n m : ℕ)
      (f : Fin n → X.presheaf.obj (op U)) (g : Fin m → X.presheaf.obj (op U)),
      _root_.AlgebraicGeometry.IsClosedImmersion (j.resLE U (j ⁻¹ᵁ U) le_rfl) ∧
      _root_.AlgebraicGeometry.IsClosedImmersion
        (i.resLE (j ⁻¹ᵁ U) (i ⁻¹ᵁ (j ⁻¹ᵁ U)) le_rfl) ∧
      definingIdealOfHom j ≤ definingIdealOfHom (i ≫ j) ∧
      IsGeneratedByOn X.toRingedSpace (definingIdealOfHom j) U f ∧
      ∃ (hfI : ∀ a, X.presheaf.germ U (j (i z)) hx (f a) ∈
          Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace) (definingIdealOfHom j)
            (j (i z)))
        (hfJ : ∀ a, X.presheaf.germ U (j (i z)) hx (f a) ∈
          Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
            (definingIdealOfHom (i ≫ j)) (j (i z)))
        (hgJ : ∀ b, X.presheaf.germ U (j (i z)) hx (g b) ∈
          Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
            (definingIdealOfHom (i ≫ j)) (j (i z)))
        (bI : Module.Basis (Fin n)
          (X.presheaf.stalk (j (i z)) ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk (j (i z))))
          (Stacks.RingedSpace.idealCotangentFiber (X := X.toLocallyRingedSpace)
            (definingIdealOfHom j) (j (i z))))
        (bJ : Module.Basis (Fin n ⊕ Fin m)
          (X.presheaf.stalk (j (i z)) ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk (j (i z))))
          (Stacks.RingedSpace.idealCotangentFiber (X := X.toLocallyRingedSpace)
            (definingIdealOfHom (i ≫ j)) (j (i z)))),
        (∀ a, bI a = Submodule.Quotient.mk ⟨_, hfI a⟩) ∧
        (∀ a, bJ (Sum.inl a) = Submodule.Quotient.mk ⟨_, hfJ a⟩) ∧
        (∀ b, bJ (Sum.inr b) = Submodule.Quotient.mk ⟨_, hgJ b⟩) := by
  classical
  -- An open on which both immersions are closed, shrunk to an affine open in the coborder.
  obtain ⟨U₀, hxU₀, hU₀⟩ := exists_isClosedImmersion_resLE_comp i j z
  obtain ⟨V, hV, hxV, hVU⟩ := exists_isAffineOpen_mem_and_subset
    (X := X) (U := U₀ ⊓ j.coborderRange) ⟨hxU₀, subset_coborder ⟨i.base z, rfl⟩⟩
  have hVU₀ : V ≤ U₀ := fun y hy => (hVU hy).1
  -- The ideal of `Y` is generated near `x` by finitely many sections, by Stacks tag 01TV.
  obtain ⟨W₀, hxW₀, hW₀V, r, g₀, hgenX⟩ :
      ∃ (W₀ : X.Opens) (_ : j (i z) ∈ W₀) (_ : W₀ ≤ V) (r : ℕ)
        (g₀ : Fin r → X.presheaf.obj (op W₀)),
        IsGeneratedByOn X.toRingedSpace (definingIdealOfHom j) W₀ g₀ := by
    have : IsAffine V.toScheme := hV
    have : _root_.AlgebraicGeometry.IsClosedImmersion (j.resLE V (j ⁻¹ᵁ V) le_rfl) :=
      (hU₀ V hVU₀).1
    have hfgker := (locallyOfFinitePresentation_iff_fg_ker (j.resLE V (j ⁻¹ᵁ V) le_rfl)).mp
      inferInstance ⟨⊤, isAffineOpen_top V.toScheme⟩
    rw [Scheme.Hom.ker_apply] at hfgker
    obtain ⟨r, g₀, hg₀⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfgker
    have hgenV := isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span
      (j.resLE V (j ⁻¹ᵁ V) le_rfl) (isAffineOpen_top V.toScheme) g₀ hg₀.symm
    refine ⟨imOpen (X := X.toRingedSpace) V ⊤, ⟨⟨j (i z), hxV⟩, trivial, rfl⟩, imOpen_le V, r, g₀,
      (isGeneratedByOn_restrictSubmodule_iff (X := X.toRingedSpace) V (definingIdealOfHom j) ⊤
        g₀).mp ?_⟩
    exact Eq.mpr (congrArg
      (fun K : (structureSheafModule (X.toRingedSpace.restrict V.isOpenEmbedding)).Submodule =>
        IsGeneratedByOn (X.toRingedSpace.restrict V.isOpenEmbedding) K ⊤ g₀)
      (restrictSubmodule_definingIdealOfHom_resLE j V)) hgenV
  have hstalkW₀ := stalkIdeal_eq_jid_of_isGeneratedByOn (X := X.toLocallyRingedSpace)
    (definingIdealOfHom j) g₀ hgenX (j (i z)) hxW₀
  have hIfg : (Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (definingIdealOfHom j) (j (i z))).FG := by
    rw [hstalkW₀]
    exact Submodule.fg_span (Set.finite_range _)
  have hIJ : Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (definingIdealOfHom j) (j (i z))
      ≤ Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
        (definingIdealOfHom (i ≫ j)) (j (i z)) :=
    stalkIdeal_mono (definingIdealOfHom_le_comp i j) _
  -- The locally split conormal sequence makes the map of cotangent fibres injective.
  have hinjmap := injective_idealCotangentFiberMap i j hS z
  have hinj : ∀ a : Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (definingIdealOfHom j) (j (i z)),
      (Submodule.Quotient.mk ⟨(a : X.presheaf.stalk (j (i z))), hIJ a.2⟩ :
          Stacks.RingedSpace.idealCotangentFiber (X := X.toLocallyRingedSpace)
            (definingIdealOfHom (i ≫ j)) (j (i z))) = 0 →
        (Submodule.Quotient.mk a : Stacks.RingedSpace.idealCotangentFiber
          (X := X.toLocallyRingedSpace) (definingIdealOfHom j) (j (i z))) = 0 :=
    fun a ha => hinjmap (((idealCotangentFiberMap_mk i j z a _).trans ha).trans (map_zero _).symm)
  -- Bases of the two cotangent fibres, adapted to each other.
  obtain ⟨n, m, v, u, bI, bJ, hspanI, hbI, hbJl, hbJr⟩ :=
    exists_adapted_stalk_generators (definingIdealOfHom j) (definingIdealOfHom (i ≫ j))
      hIJ hIfg hfg hinj
  -- Realise the chosen stalk elements by sections on one neighbourhood.
  obtain ⟨U₁, hxU₁, f₁, hf₁, hgf₁⟩ :=
    exists_common_germ_mem (W := X.toLocallyRingedSpace) (definingIdealOfHom j) n
      (fun a => (v a : X.presheaf.stalk (j (i z)))) fun a => (v a).2
  obtain ⟨U₂, hxU₂, g₁, hg₁, hgg₁⟩ :=
    exists_common_germ_mem (W := X.toLocallyRingedSpace) (definingIdealOfHom (i ≫ j)) m
      (fun b => (u b : X.presheaf.stalk (j (i z)))) fun b => (u b).2
  obtain ⟨U₃, hxU₃, hU₃W₀, f₂, g₂, hf₂, hg₂, hgf₂, hgg₂⟩ :
      ∃ (U₃ : X.Opens) (hxU₃ : j (i z) ∈ U₃) (_ : U₃ ≤ W₀)
        (f₂ : Fin n → X.presheaf.obj (op U₃)) (g₂ : Fin m → X.presheaf.obj (op U₃)),
        (∀ a, f₂ a ∈ (definingIdealOfHom j).obj (op U₃)) ∧
        (∀ b, g₂ b ∈ (definingIdealOfHom (i ≫ j)).obj (op U₃)) ∧
        (∀ a, X.presheaf.germ U₃ (j (i z)) hxU₃ (f₂ a)
          = (v a : X.presheaf.stalk (j (i z)))) ∧
        (∀ b, X.presheaf.germ U₃ (j (i z)) hxU₃ (g₂ b)
          = (u b : X.presheaf.stalk (j (i z)))) := by
    refine ⟨W₀ ⊓ U₁ ⊓ U₂, ⟨⟨hxW₀, hxU₁⟩, hxU₂⟩, le_trans inf_le_left inf_le_left,
      fun a => X.presheaf.map (homOfLE (le_trans inf_le_left inf_le_right)).op (f₁ a),
      fun b => X.presheaf.map (homOfLE (inf_le_right :
        W₀ ⊓ U₁ ⊓ U₂ ≤ U₂)).op (g₁ b),
      fun a => Stacks.RingedSpace.restrict_mem _ _ (hf₁ a),
      fun b => Stacks.RingedSpace.restrict_mem _ _ (hg₁ b), fun a => ?_, fun b => ?_⟩
    · rw [TopCat.Presheaf.germ_res_apply X.presheaf
        (homOfLE (le_trans inf_le_left inf_le_right)) (j (i z)) ⟨⟨hxW₀, hxU₁⟩, hxU₂⟩ (f₁ a)]
      exact hgf₁ a
    · rw [TopCat.Presheaf.germ_res_apply X.presheaf
        (homOfLE (inf_le_right : W₀ ⊓ U₁ ⊓ U₂ ≤ U₂)) (j (i z)) ⟨⟨hxW₀, hxU₁⟩, hxU₂⟩ (g₁ b)]
      exact hgg₁ b
  -- Nakayama turns the chosen basis into generators of the stalk, which spread to an open.
  have hjid : Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (definingIdealOfHom j) (j (i z))
      = _root_.Jid (germFamily X.toRingedSpace U₃ f₂ (j (i z)) hxU₃) := by
    have hfun : (fun a => (v a : X.presheaf.stalk (j (i z))))
        = germFamily X.toRingedSpace U₃ f₂ (j (i z)) hxU₃ := funext fun a => (hgf₂ a).symm
    rw [hspanI]
    exact congrArg (fun s => Ideal.span (Set.range s)) hfun
  obtain ⟨U, hxU, hUU₃, hgenU⟩ := exists_isGeneratedByOn_of_stalkIdeal_eq
    (X := X.toLocallyRingedSpace) (definingIdealOfHom j) hxW₀ g₀ hgenX hxU₃ f₂ hf₂ hjid
  have hUU₀ : U ≤ U₀ := le_trans hUU₃ (le_trans hU₃W₀ (le_trans hW₀V hVU₀))
  have hgermf : ∀ a, X.presheaf.germ U (j (i z)) hxU
      (X.presheaf.map (homOfLE hUU₃).op (f₂ a))
      = (v a : X.presheaf.stalk (j (i z))) := fun a => by
    rw [TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hUU₃) (j (i z)) hxU (f₂ a)]
    exact hgf₂ a
  have hgermg : ∀ b, X.presheaf.germ U (j (i z)) hxU
      (X.presheaf.map (homOfLE hUU₃).op (g₂ b))
      = (u b : X.presheaf.stalk (j (i z))) := fun b => by
    rw [TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hUU₃) (j (i z)) hxU (g₂ b)]
    exact hgg₂ b
  refine ⟨U, hxU, n, m, fun a => X.presheaf.map (homOfLE hUU₃).op (f₂ a),
    fun b => X.presheaf.map (homOfLE hUU₃).op (g₂ b), (hU₀ U hUU₀).1, (hU₀ U hUU₀).2,
    definingIdealOfHom_le_comp i j, hgenU, fun a => ?_, fun a => ?_, fun b => ?_, bI, bJ,
    fun a => ?_, fun a => ?_, fun b => ?_⟩
  · rw [hgermf a]; exact (v a).2
  · rw [hgermf a]; exact hIJ (v a).2
  · rw [hgermg b]; exact (u b).2
  · rw [hbI a]
    exact congrArg Submodule.Quotient.mk (Subtype.ext (hgermf a).symm)
  · rw [hbJl a]
    exact congrArg Submodule.Quotient.mk (Subtype.ext (hgermf a).symm)
  · rw [hbJr b]
    exact congrArg Submodule.Quotient.mk (Subtype.ext (hgermg b).symm)

end Adapted

/-! ### Adapted bases for a retracted second immersion -/

section Retraction

open Stacks.RingedSpace Stacks.AlgebraicGeometry.RegularIdealSheaf

/-- **A split surjection of local rings splits the cotangent fibre.** Let `φ : R ⟶ S` be a ring
map of local rings with a ring-map section `ι`, let `J` be an ideal of `R` all of whose values
under `φ` are non-units, and let `K = Ker φ`. Then an element of `K` lying in `𝔪_R J` lies in
`𝔪_R K`.

The map `u ↦ u - ι (φ u)` lands in `K`, is additive, is the identity on `K`, and sends `m * a`
with `m ∈ 𝔪_R` and `a ∈ J` to `m * (a - ι (φ a)) + ι (φ a) * (m - ι (φ m)) ∈ 𝔪_R K`. -/
private theorem mem_smul_ker_of_mem_smul_of_ringSection {R S : Type*} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] (φ : R →+* S) (ι : S →+* R) (hφι : ∀ s, φ (ι s) = s)
    {J : Ideal R} (hJ : ∀ a ∈ J, φ a ∈ IsLocalRing.maximalIdeal S) {u : R} (huK : φ u = 0)
    (hu : u ∈ IsLocalRing.maximalIdeal R • J) :
    u ∈ IsLocalRing.maximalIdeal R • RingHom.ker φ := by
  have hker : ∀ v : R, v - ι (φ v) ∈ RingHom.ker φ := fun v => by
    simp [RingHom.mem_ker, hφι]
  have hmem : ∀ a ∈ J, ι (φ a) ∈ IsLocalRing.maximalIdeal R := by
    intro a ha
    rw [IsLocalRing.mem_maximalIdeal]
    intro hunit
    refine (IsLocalRing.mem_maximalIdeal _).mp (hJ a ha) ?_
    have h := hunit.map φ
    rwa [hφι] at h
  have key : ∀ v ∈ IsLocalRing.maximalIdeal R • J,
      v - ι (φ v) ∈ IsLocalRing.maximalIdeal R • RingHom.ker φ := by
    intro v hv
    refine Submodule.smul_induction_on hv (fun m hm a ha => ?_) (fun a b ha hb => ?_)
    · have hsplit : m • a - ι (φ (m • a))
          = m • (a - ι (φ a)) + ι (φ a) • (m - ι (φ m)) := by
        simp only [smul_eq_mul, map_mul]
        ring
      rw [hsplit]
      exact Submodule.add_mem _ (Submodule.smul_mem_smul hm (hker a))
        (Submodule.smul_mem_smul (hmem a ha) (hker m))
    · have hadd : a + b - ι (φ (a + b)) = (a - ι (φ a)) + (b - ι (φ b)) := by
        rw [map_add, map_add]; ring
      rw [hadd]
      exact Submodule.add_mem _ ha hb
  have h := key u hu
  rwa [huK, map_zero, sub_zero] at h

/-- **The map of local rings of a retracted immersion has a ring-map section.** If `j : Y ⟶ X`
has a retraction `ρ : X ⟶ Y`, then `𝒪_{X, j y} ⟶ 𝒪_{Y, y}` is split by the map of local rings of
`ρ`, read through the identification of the stalks at `ρ (j y)` and at `y`. -/
private theorem exists_stalkMap_section {Y X : Scheme.{u}} (j : Y ⟶ X) (ρ : X ⟶ Y)
    (hρ : j ≫ ρ = 𝟙 Y) (y : Y) :
    ∃ ι : Y.presheaf.stalk y ⟶ X.presheaf.stalk (j y), ι ≫ j.stalkMap y = 𝟙 _ := by
  have hptI : Inseparable ((j ≫ ρ).base y) ((𝟙 Y : Y ⟶ Y).base y) :=
    Inseparable.of_eq (by rw [hρ])
  have h2 : (j ≫ ρ).stalkMap y = (Y.presheaf.stalkCongr hptI).hom := by
    simp [Scheme.Hom.stalkMap_congr_hom (j ≫ ρ) (𝟙 Y) hρ y]
  have h3 : ρ.stalkMap (j y) ≫ j.stalkMap y = (Y.presheaf.stalkCongr hptI).hom := by
    rw [← Scheme.Hom.stalkMap_comp]; exact h2
  refine ⟨(Y.presheaf.stalkCongr hptI).inv ≫ ρ.stalkMap (j y), ?_⟩
  exact (Category.assoc _ _ _).trans
    ((congrArg (fun f => (Y.presheaf.stalkCongr hptI).inv ≫ f) h3).trans
      (Y.presheaf.stalkCongr hptI).inv_hom_id)

/-- **The cotangent fibre of a retracted immersion injects into that of a composite.** For
immersions `i : Z ⟶ Y` and `j : Y ⟶ X` with `j` admitting a retraction, an element of the stalk
`I_x` of the ideal of `j` at `x = j (i z)` lying in `𝔪_x J_x`, for `J` the ideal of `i ≫ j`,
already lies in `𝔪_x I_x`. -/
theorem mk_eq_zero_of_mk_eq_zero_of_retraction (i : Z ⟶ Y) (j : Y ⟶ X)
    [IsImmersion i] [IsImmersion j] (ρ : X ⟶ Y) (hρ : j ≫ ρ = 𝟙 Y) (z : Z)
    (hIJ : Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
        (definingIdealOfHom j) (j (i z)) ≤
      Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
        (definingIdealOfHom (i ≫ j)) (j (i z)))
    (a : Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (definingIdealOfHom j) (j (i z)))
    (h0 : (Submodule.Quotient.mk ⟨(a : X.presheaf.stalk (j (i z))), hIJ a.2⟩ :
      Stacks.RingedSpace.idealCotangentFiber (X := X.toLocallyRingedSpace)
        (definingIdealOfHom (i ≫ j)) (j (i z))) = 0) :
    (Submodule.Quotient.mk a : Stacks.RingedSpace.idealCotangentFiber
      (X := X.toLocallyRingedSpace) (definingIdealOfHom j) (j (i z))) = 0 := by
  obtain ⟨ι, hι⟩ := exists_stalkMap_section j ρ hρ (i z)
  have hsec : ∀ s, (j.stalkMap (i z)).hom (ι.hom s) = s := fun s => by
    simpa using ConcreteCategory.congr_hom hι s
  have hKeq : Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (definingIdealOfHom j) (j (i z))
      = RingHom.ker (j.stalkMap (i z)).hom :=
    stalkIdeal_definingIdealOfHom_eq_ker j (i z)
  have hconvI : IsLocalRing.maximalIdeal (X.presheaf.stalk (j (i z))) •
      RingHom.ker (j.stalkMap (i z)).hom
      = IsLocalRing.maximalIdeal (X.presheaf.stalk (j (i z))) •
        Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace) (definingIdealOfHom j)
          (j (i z)) := by
    rw [hKeq]
  have hJmem : ∀ b ∈ Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (definingIdealOfHom (i ≫ j)) (j (i z)),
      (j.stalkMap (i z)).hom b ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk (i z)) := by
    intro b hb
    have hb0 : ((i ≫ j).stalkMap z).hom b = 0 :=
      RingHom.mem_ker.mp (stalkIdeal_definingIdealOfHom_eq_ker (i ≫ j) z ▸ hb)
    have h : (CommRingCat.Hom.hom ((i ≫ j).stalkMap z)) b
        = (CommRingCat.Hom.hom (j.stalkMap (i z) ≫ i.stalkMap z)) b :=
      congrArg (fun f => (CommRingCat.Hom.hom f) b) (Scheme.Hom.stalkMap_comp i j z)
    have h2 : (CommRingCat.Hom.hom (j.stalkMap (i z) ≫ i.stalkMap z)) b
        = (i.stalkMap z).hom ((j.stalkMap (i z)).hom b) := rfl
    exact IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top _)
      (RingHom.mem_ker.mpr (h2.symm.trans (h.symm.trans hb0)))
  have hzero : (j.stalkMap (i z)).hom (a : X.presheaf.stalk (j (i z))) = 0 :=
    RingHom.mem_ker.mp (hKeq ▸ a.2)
  rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_smul_top_iff] at h0
  rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_smul_top_iff]
  have hmain := mem_smul_ker_of_mem_smul_of_ringSection (j.stalkMap (i z)).hom ι.hom hsec
    hJmem hzero h0
  exact hconvI ▸ hmain

/-- **Adapted bases of the cotangent fibres of two nested ideal subsheaves.** Let `I ⊆ J` be ideal
subsheaves with finitely generated stalks at `w` and suppose that an element of `I_w` lying in
`𝔪_w J_w` already lies in `𝔪_w I_w`. Then there are elements of `I_w` whose classes form a basis
of `I_w / 𝔪_w I_w` and extend to a basis of `J_w / 𝔪_w J_w`. -/
theorem exists_adapted_cotangent_bases {W : LocallyRingedSpace.{u}}
    (I J : (Stacks.RingedSpace.structureSheafModule W.toRingedSpace).Submodule) {w : W}
    (hIJ : Stacks.RingedSpace.stalkIdeal I w ≤ Stacks.RingedSpace.stalkIdeal J w)
    (hI : (Stacks.RingedSpace.stalkIdeal I w).FG)
    (hJ : (Stacks.RingedSpace.stalkIdeal J w).FG)
    (hinj : ∀ a : Stacks.RingedSpace.stalkIdeal I w,
      (Submodule.Quotient.mk ⟨(a : W.presheaf.stalk w), hIJ a.2⟩ :
          Stacks.RingedSpace.idealCotangentFiber J w) = 0 →
        (Submodule.Quotient.mk a : Stacks.RingedSpace.idealCotangentFiber I w) = 0) :
    ∃ (n m : ℕ) (v : Fin n → Stacks.RingedSpace.stalkIdeal I w)
      (c : Fin (n + m) → Stacks.RingedSpace.stalkIdeal J w)
      (bI : Module.Basis (Fin n) (W.presheaf.stalk w ⧸
          IsLocalRing.maximalIdeal (W.presheaf.stalk w))
        (Stacks.RingedSpace.idealCotangentFiber I w))
      (bJ : Module.Basis (Fin (n + m)) (W.presheaf.stalk w ⧸
          IsLocalRing.maximalIdeal (W.presheaf.stalk w))
        (Stacks.RingedSpace.idealCotangentFiber J w)),
      (∀ a, bI a = Submodule.Quotient.mk (v a)) ∧
      (∀ k, bJ k = Submodule.Quotient.mk (c k)) ∧
      (∀ a : Fin n, (c (Fin.castAdd m a) : W.presheaf.stalk w) = (v a : W.presheaf.stalk w)) := by
  obtain ⟨n, m, v, u, bI, bJ, -, hbI, hbJl, hbJr⟩ :=
    exists_adapted_stalk_generators I J hIJ hI hJ hinj
  refine ⟨n, m, v,
    fun k => Sum.elim (fun a => (⟨(v a : W.presheaf.stalk w), hIJ (v a).2⟩ :
        Stacks.RingedSpace.stalkIdeal J w)) u (finSumFinEquiv.symm k),
    bI, bJ.reindex (finSumFinEquiv (m := n) (n := m)), hbI, fun k => ?_,
    fun a => ?_⟩
  · refine Fin.addCases (fun a => ?_) (fun b => ?_) k
    · rw [Module.Basis.reindex_apply]
      simp only [finSumFinEquiv_symm_apply_castAdd, Sum.elim_inl]
      exact hbJl a
    · rw [Module.Basis.reindex_apply]
      simp only [finSumFinEquiv_symm_apply_natAdd, Sum.elim_inr]
      exact hbJr b
  · simp only [finSumFinEquiv_symm_apply_castAdd, Sum.elim_inl]

end Retraction

end Stacks.AlgebraicGeometry

