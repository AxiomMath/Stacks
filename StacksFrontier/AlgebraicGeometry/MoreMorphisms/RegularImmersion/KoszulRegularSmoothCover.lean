/-! ### Smooth affine covers from faithfully flat smooth algebras -/

/-- `Spec` of a faithfully flat smooth algebra is a surjective smooth morphism. -/
theorem specMap_smooth_surjective_of_faithfullyFlat {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B] (hff : Module.FaithfullyFlat A B) (hsm : Algebra.Smooth A B) :
    Smooth (Spec.map (CommRingCat.ofHom (algebraMap A B))) ∧
      Surjective (Spec.map (CommRingCat.ofHom (algebraMap A B))) := by
  let f : CommRingCat.of A ⟶ CommRingCat.of B := CommRingCat.ofHom (algebraMap A B)
  exact ⟨(HasRingHomProperty.Spec_iff (P := @Smooth)).2 ((RingHom.smooth_algebraMap).2 hsm),
    ((AlgebraicGeometry.flat_and_surjective_SpecMap_iff f).2
      ((RingHom.faithfullyFlat_algebraMap_iff).2 hff)).2⟩

/-- The morphism out of a coproduct described by a family of smooth morphisms whose ranges cover
the target is smooth and surjective. -/
theorem sigmaDesc_smooth_surjective {ι : Type u} [Small.{u} ι] {X : Scheme.{u}}
    {Y : ι → Scheme.{u}} (f : ∀ i, Y i ⟶ X) (hsm : ∀ i, Smooth (f i))
    (hcover : ⋃ i, Set.range (f i).base = Set.univ) :
    Smooth (Sigma.desc f) ∧ Surjective (Sigma.desc f) := by
  have : IsZariskiLocalAtSource (@Smooth) := HasRingHomProperty.instIsZariskiLocalAtSource
  exact ⟨IsZariskiLocalAtSource.sigmaDesc hsm,
    Surjective.sigmaDesc_of_union_range_eq_univ hcover⟩

/-! ### The support of the quotient by the defining ideal of a closed immersion -/

/-- For a closed immersion the support of the quotient of the structure sheaf by the defining
ideal is exactly the image.  The support is always the closure of the image, and the image of a
closed immersion is closed. -/
theorem idealQuotientSupport_eq_range {Z X : Scheme.{u}} (j : Z ⟶ X) [IsClosedImmersion j] :
    idealQuotientSupport X.toRingedSpace (definingIdealOfHom j) = Set.range j :=
  Set.ext fun x => (AlgebraicGeometry.mem_idealQuotientSupport_definingIdealOfHom_iff j x).trans
    (by rw [j.isClosedEmbedding.isClosed_range.closure_eq])

/-! ### Properness of the ideal spanned by generators of a defining ideal -/

/-- A family of elements killed by a ring map to a nontrivial ring spans a proper ideal. -/
theorem span_ne_top_of_map_to_nontrivial {R S : Type*} [CommRing R] [CommRing S] [Nontrivial S]
    (φ : R →+* S) {r : ℕ} (f : Fin r → R) (hf : ∀ i, φ (f i) = 0) :
    Ideal.span (Set.range f) ≠ ⊤ :=
  ne_top_of_le_ne_top (RingHom.ker_ne_top φ)
    (Ideal.span_le.mpr (Set.range_subset_iff.2 fun i => RingHom.mem_ker.mpr (hf i)))

/-- A family of sections over an open meeting the image of `j` which `j` kills spans a proper
ideal: the ring of sections of the source over the preimage of such an open is nonzero, because
it has a point, and the unit section is not killed. -/
theorem span_ne_top_of_sections_map_eq_zero {Z X : Scheme.{u}} (j : Z ⟶ X) (U : X.Opens)
    (z : Z) (hz : j z ∈ U) {r : ℕ} (f : Fin r → Γ(X, U))
    (hf : ∀ k, (j.app U).hom (f k) = 0) :
    Ideal.span (Set.range f) ≠ ⊤ := by
  have hS : (0 : Γ(Z, j ⁻¹ᵁ U)) ≠ 1 := by
    intro h
    have hg := congrArg (Z.presheaf.germ (j ⁻¹ᵁ U) z hz) h
    simp only [map_zero, map_one] at hg
    exact (zero_ne_one : (0 : Z.presheaf.stalk z) ≠ 1) hg
  have : Nontrivial Γ(Z, j ⁻¹ᵁ U) := nontrivial_of_ne 0 1 hS
  exact span_ne_top_of_map_to_nontrivial (j.app U).hom f hf

/-! ### The affine chart with a Koszul-regular generating family -/

/-- Around every point of the source of a closed immersion with Koszul-regular defining ideal
sheaf there is an affine open of the target over which the kernel on sections is spanned by a
Koszul-regular family generating a proper ideal. -/
theorem exists_affine_koszul_kernel {Z X : Scheme.{u}} (j : Z ⟶ X) [IsClosedImmersion j]
    (hj : IsKoszulRegularIdealSheaf X.toRingedSpace (definingIdealOfHom j)) (z : Z) :
    ∃ (U : X.affineOpens) (_hz : j z ∈ U.1) (r : ℕ) (f : Fin r → Γ(X, U.1)),
      Koszul.IsKoszulRegular f ∧
        RingHom.ker (j.app U.1).hom = Ideal.span (Set.range f) ∧
        Ideal.span (Set.range f) ≠ ⊤ := by
  obtain ⟨U, hz, r, f, hgen, hf⟩ :=
    (RegularIdealSheaf.isKoszulRegularIdealSheaf_iff_affine X (definingIdealOfHom j)).mp hj (j z)
      (AlgebraicGeometry.mem_idealQuotientSupport_definingIdealOfHom j z)
  have hker : RingHom.ker (j.app U.1).hom = Ideal.span (Set.range f) :=
    ker_app_eq_span_range j U.2 f hgen
  refine ⟨U, hz, r, f, hf, hker, ?_⟩
  exact span_ne_top_of_sections_map_eq_zero j U.1 z hz f fun k =>
    RingHom.mem_ker.mp (hker.ge (Ideal.subset_span ⟨k, rfl⟩))

/-- **Stacks tag 068Q, in the form used here.**  A Koszul-regular family spanning a proper ideal
becomes a regular sequence after a faithfully flat smooth base change. -/
theorem exists_faithfullyFlat_smooth_regular_generators {R : Type u} [CommRing R] {n : ℕ}
    (f : Fin n → R) (hf : Koszul.IsKoszulRegular f)
    (hproper : Ideal.span (Set.range f) ≠ ⊤) :
    ∃ (S : Type u) (_ : CommRing S) (_ : Algebra R S) (g : Fin n → S),
      Module.FaithfullyFlat R S ∧ Algebra.Smooth R S ∧
        RingTheory.Sequence.IsRegular S (List.ofFn g) ∧
        Ideal.map (algebraMap R S) (Ideal.span (Set.range f)) = Ideal.span (Set.range g) := by
  classical
  let σ := {ij : Fin n × Fin n // ij.1 ≤ ij.2}
  let P := MvPolynomial σ R
  let d : P := ∏ i : Fin n, MvPolynomial.X ⟨(i, i), le_rfl⟩
  let S := Localization.Away d
  let g : Fin n → S := fun i ↦ ∑ j : Fin n, if hij : i ≤ j then
    algebraMap P S (MvPolynomial.X ⟨(i, j), hij⟩) * algebraMap R S (f j) else 0
  exact ⟨S, inferInstance, inferInstance, g,
    Koszul.isRegular_upperTriangular_of_isKoszulRegular f hf hproper⟩

/-! ### Kernels of maps on global sections -/

/-- The kernel on global sections of the base change of a closed immersion of affine schemes is
the extension of the kernel of the immersion. -/
theorem ker_appTop_pullback_snd {Z X Y : Scheme.{u}} (i : Z ⟶ X) (g : Y ⟶ X)
    [IsClosedImmersion i] [IsAffine X] [IsAffine Y] :
    RingHom.ker (pullback.snd i g).appTop.hom =
      (RingHom.ker i.appTop.hom).map g.appTop.hom := by
  obtain ⟨hZ, hsurj⟩ := IsClosedImmersion.isAffine_surjective_of_isAffine i
  have : IsAffine Z := hZ
  exact CommRingCat.ker_eq_map_of_isPushout_of_surjective _ _ _ _
    (isPushout_appTop_of_isPullback (IsPullback.of_hasPullback i g)).flip hsurj

/-- Transporting a regular sequence along a ring isomorphism. -/
theorem isRegular_map_ringEquiv {R S : Type*} [CommRing R] [CommRing S] (e : R ≃+* S) {n : ℕ}
    {f : Fin n → R} (hf : RingTheory.Sequence.IsRegular R (List.ofFn f)) :
    RingTheory.Sequence.IsRegular S (List.ofFn fun k ↦ e (f k)) := by
  suffices h : RingTheory.Sequence.IsRegular S ((List.ofFn f).map e) by
    simpa only [List.map_ofFn, Function.comp_def] using h
  refine (e.toAddEquiv.isRegular_congr ?_).mp hf
  exact List.forall₂_map_right_iff.mpr (List.forall₂_same.mpr fun r _ x => e.map_mul r x)

/-- **The map on global sections induced by an isomorphism of schemes is an isomorphism.** Taking
global sections is the functor `AlgebraicGeometry.Scheme.Γ` on the opposite category. -/
theorem isIso_appTop_of_isIso {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] : IsIso f.appTop := by
  rw [← Scheme.Γ_map_op]
  exact Functor.map_isIso Scheme.Γ f.op

/-- The kernel on global sections is unchanged by precomposition with an isomorphism. -/
theorem ker_appTop_comp_iso {Z Z' X : Scheme.{u}} (e : Z' ≅ Z) (i : Z ⟶ X) :
    RingHom.ker (e.hom ≫ i).appTop.hom = RingHom.ker i.appTop.hom := by
  have := isIso_appTop_of_isIso e.hom
  rw [Scheme.Hom.comp_appTop]
  ext s
  exact map_eq_zero_iff _ (ConcreteCategory.bijective_of_isIso e.hom.appTop).injective

/-- The kernel on global sections of a restriction, as an extension of the kernel on sections. -/
theorem ker_appTop_morphismRestrict {Z X : Scheme.{u}} (i : Z ⟶ X) (U : X.Opens) :
    RingHom.ker (i ∣_ U).appTop.hom = (RingHom.ker (i.app U).hom).map U.topIso.inv.hom := by
  rw [← Scheme.Hom.resLE_eq_morphismRestrict]
  show RingHom.ker ((i.resLE U (i ⁻¹ᵁ U) le_rfl).app ⊤).hom = _
  rw [Scheme.Hom.resLE_app_top, Scheme.Hom.appLE_eq_app]
  have hinj := (ConcreteCategory.bijective_of_isIso (i ⁻¹ᵁ U).topIso.inv).injective
  ext s
  rw [Ideal.mem_map_iff_of_surjective _
    (ConcreteCategory.bijective_of_isIso U.topIso.inv).surjective]
  show (i ⁻¹ᵁ U).topIso.inv ((i.app U) (U.topIso.hom s)) = 0 ↔ _
  rw [map_eq_zero_iff _ hinj]
  constructor
  · intro hs
    exact ⟨U.topIso.hom s, hs, congr($(U.topIso.hom_inv_id) s)⟩
  · rintro ⟨t, ht, rfl⟩
    simpa only [← CommRingCat.comp_apply, U.topIso.inv_hom_id, CommRingCat.id_apply]
      using (RingHom.mem_ker.mp ht)

/-- Iterating a base change: the kernel on global sections of the base change along a composite
agrees with the kernel of the twice-base-changed immersion. -/
theorem ker_appTop_pullback_snd_comp {Z X Y T : Scheme.{u}} (i : Z ⟶ X) (g : Y ⟶ X) (a : T ⟶ Y)
    (h : T ⟶ X) (w : a ≫ g = h) :
    RingHom.ker (pullback.snd (pullback.snd i g) a).appTop.hom =
      RingHom.ker (pullback.snd i h).appTop.hom := by
  have H := ((IsPullback.of_hasPullback (pullback.snd i g) a).flip.paste_vert
    (IsPullback.of_hasPullback i g).flip).flip
  rw [w] at H
  rw [← H.isoPullback_hom_snd, ker_appTop_comp_iso]

/-! ### Transport of Koszul regularity -/

open scoped TensorProduct

/-- The Koszul homology of a sequence with coefficients in a module only depends on the module up
to linear equivalence. -/
alias homologyTensor_equiv_of_linearEquiv := Koszul.homologyTensor_equiv_of_linearEquiv

/-- Koszul homology commutes with flat base change. -/
alias koszulHomology_baseChange_equiv := Koszul.koszulHomology_baseChange_equiv

/-- Transporting Koszul regularity along a ring isomorphism. -/
theorem isKoszulRegular_map_ringEquiv {R S : Type u} [CommRing R] [CommRing S] (e : R ≃+* S)
    {n : ℕ} {f : Fin n → R} (hf : Koszul.IsKoszulRegular f) :
    Koszul.IsKoszulRegular fun k ↦ e (f k) := by
  let _ := e.toRingHom.toAlgebra
  have : Module.Flat R S := RingHom.Flat.of_bijective e.bijective
  intro k hk
  have h := hf k hk
  rw [ModuleCat.isZero_iff_subsingleton] at h ⊢
  obtain ⟨E⟩ := koszulHomology_baseChange_equiv (S := S) f k
  exact E.toEquiv.subsingleton

/-! ### Regularity of an immersion through an isomorphism of the source -/

/-- Precomposing with an isomorphism does not change the defining ideal of a morphism. -/
theorem definingIdealOfHom_comp_iso {Z Z' X : Scheme.{u}} (e : Z' ≅ Z) (i : Z ⟶ X) :
    definingIdealOfHom (e.hom ≫ i) = definingIdealOfHom i := by
  refine eq_definingIdealOfHom_of_mem_iff i _ fun U s => ?_
  show ((e.hom ≫ i).app U) s = 0 ↔ (i.app U) s = 0
  rw [Scheme.Hom.comp_app]
  show (e.hom.app (i ⁻¹ᵁ U)) ((i.app U) s) = 0 ↔ (i.app U) s = 0
  exact map_eq_zero_iff _ (ConcreteCategory.bijective_of_isIso (e.hom.app _)).injective

/-- Precomposing with an isomorphism preserves regularity of an immersion. -/
theorem isRegularImmersion_comp_iso {Z Z' X : Scheme.{u}} (e : Z' ≅ Z) (i : Z ⟶ X)
    [IsImmersion i] (hi : IsRegularImmersion i) : IsRegularImmersion (e.hom ≫ i) := by
  refine (isRegularImmersion_iff_of_open (e.hom ≫ i) i.coborderRange
    (e.hom ≫ i.liftCoborder) (by simp)).mpr ?_
  rwa [definingIdealOfHom_comp_iso]

/-! ### The affine case -/

/-- The image of the ideal spanned by a family under a ring map is spanned by the image family. -/
private theorem map_span_range_fin {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) {n : ℕ}
    (f : Fin n → R) :
    Ideal.map φ (Ideal.span (Set.range f)) = Ideal.span (Set.range fun k ↦ φ (f k)) := by
  rw [Ideal.map_span, ← Set.range_comp]
  rfl

/-- A smooth surjective affine cover of an affine scheme over which the base change of a closed
immersion with Koszul-regular defining family has a regular defining family. -/
theorem exists_smooth_surjective_affine_regular_generators {Z X : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] [IsAffine X] {n : ℕ} (f : Fin n → Γ(X, ⊤))
    (hf : Koszul.IsKoszulRegular f) (hker : RingHom.ker i.appTop.hom = Ideal.span (Set.range f))
    (hproper : Ideal.span (Set.range f) ≠ ⊤) :
    ∃ (Y : Scheme.{u}) (g : Y ⟶ X), Surjective g ∧ Smooth g ∧ IsAffine Y ∧
      ∃ t : Fin n → Γ(Y, ⊤),
        RingTheory.Sequence.IsRegular (Γ(Y, ⊤)) (List.ofFn t) ∧
          RingHom.ker (pullback.snd i g).appTop.hom = Ideal.span (Set.range t) := by
  obtain ⟨S, hS, hA, t, hff, hsm, ht, hspan⟩ :=
    exists_faithfullyFlat_smooth_regular_generators f hf hproper
  let α : Γ(X, ⊤) ⟶ CommRingCat.of S := CommRingCat.ofHom (algebraMap (Γ(X, ⊤)) S)
  let g : Spec (.of S) ⟶ X := Spec.map α ≫ X.isoSpec.inv
  obtain ⟨hsmα, hsurjα⟩ := specMap_smooth_surjective_of_faithfullyFlat hff hsm
  have : Smooth (Spec.map α) := hsmα
  have : Surjective (Spec.map α) := hsurjα
  refine ⟨Spec (.of S), g, inferInstanceAs (Surjective g),
    inferInstanceAs (Smooth g), inferInstance, ?_⟩
  let E := (Scheme.ΓSpecIso (.of S)).symm.commRingCatIsoToRingEquiv
  refine ⟨fun k ↦ E (t k), isRegular_map_ringEquiv E ht, ?_⟩
  rw [ker_appTop_pullback_snd, hker]
  have hinv : X.isoSpec.inv.appTop = (Scheme.ΓSpecIso Γ(X, ⊤)).inv := by
    have := isIso_appTop_of_isIso X.isoSpec.hom
    apply (cancel_epi X.isoSpec.hom.appTop).mp
    rw [← Scheme.Hom.comp_appTop, X.isoSpec.inv_hom_id]
    simp only [Scheme.Hom.id_appTop, Scheme.isoSpec_hom, Scheme.toSpecΓ_appTop, Iso.hom_inv_id]
  have happ : g.appTop = α ≫ (Scheme.ΓSpecIso (.of S)).inv := by
    dsimp only [g]
    rw [Scheme.Hom.comp_appTop, hinv]
    exact (Scheme.ΓSpecIso_inv_naturality α).symm
  rw [happ, CommRingCat.hom_comp, ← Ideal.map_map]
  show Ideal.map E.toRingHom
    (Ideal.map (algebraMap (Γ(X, ⊤)) S) (Ideal.span (Set.range f))) = _
  rw [hspan, map_span_range_fin]
  rfl

/-- Reading a regular defining family on an affine open immersion of the target as one on the
corresponding affine open of the target. -/
theorem affine_generators_of_isPullback {T Y Z X : Scheme.{u}} (i : Z ⟶ X) (j : T ⟶ Y)
    (b : T ⟶ Z) (a : Y ⟶ X) [QuasiCompact i] [QuasiCompact j] [IsAffine Y]
    [IsOpenImmersion a] (H : IsPullback j b a i) {n : ℕ} (t : Fin n → Γ(Y, ⊤))
    (ht : RingTheory.Sequence.IsRegular (Γ(Y, ⊤)) (List.ofFn t))
    (hker : RingHom.ker j.appTop.hom = Ideal.span (Set.range t)) :
    ∃ U : X.affineOpens, U.1 = a.opensRange ∧
      ∃ f : Fin n → Γ(X, U.1),
        RingTheory.Sequence.IsRegular (Γ(X, U.1)) (List.ofFn f) ∧
          RingHom.ker (i.app U.1).hom = Ideal.span (Set.range f) := by
  let U : X.affineOpens := ⟨a ''ᵁ ⊤, (isAffineOpen_top Y).image_of_isOpenImmersion a⟩
  let E := (a.appIso ⊤).symm.commRingCatIsoToRingEquiv
  refine ⟨U, a.image_top_eq_opensRange, fun k ↦ E (t k), isRegular_map_ringEquiv E ht, ?_⟩
  have hcomap : RingHom.ker j.appTop.hom
      = Ideal.comap (a.appIso ⊤).inv.hom (RingHom.ker (i.app U.1).hom) := by
    have h := Scheme.ker_ideal_of_isPullback_of_isOpenImmersion i j b a H
      (⟨⊤, isAffineOpen_top Y⟩ : Y.affineOpens)
    rwa [Scheme.Hom.ker_apply, Scheme.Hom.ker_apply] at h
  have hm : RingHom.ker (i.app U.1).hom
      = Ideal.map (a.appIso ⊤).inv.hom (RingHom.ker j.appTop.hom) := by
    rw [hcomap, Ideal.map_comap_of_surjective _
      (ConcreteCategory.bijective_of_isIso (a.appIso ⊤).inv).surjective]
  rw [hm, hker]
  exact map_span_range_fin _ t

/-- The local step: around every point of the source there is an affine smooth morphism to the
target over which the base change of the immersion has a regular defining family. -/
theorem exists_local_smooth_affine_regular_generators {Z X : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i]
    (hi : IsKoszulRegularIdealSheaf X.toRingedSpace (definingIdealOfHom i)) (z : Z) :
    ∃ (Y : Scheme.{u}) (g : Y ⟶ X), Smooth g ∧ IsAffine Y ∧ i z ∈ Set.range g ∧
      ∃ (n : ℕ) (t : Fin n → Γ(Y, ⊤)),
        RingTheory.Sequence.IsRegular (Γ(Y, ⊤)) (List.ofFn t) ∧
          RingHom.ker (pullback.snd i g).appTop.hom = Ideal.span (Set.range t) := by
  obtain ⟨U, hz, n, f, hf, hker, hproper⟩ := exists_affine_koszul_kernel i hi z
  let E := U.1.topIso.symm.commRingCatIsoToRingEquiv
  let f' : Fin n → Γ(U.1.toScheme, ⊤) := fun k ↦ E (f k)
  have hf' : Koszul.IsKoszulRegular f' := isKoszulRegular_map_ringEquiv E hf
  have hker' : RingHom.ker (i ∣_ U.1).appTop.hom = Ideal.span (Set.range f') := by
    rw [ker_appTop_morphismRestrict, hker]
    exact map_span_range_fin _ f
  have hproper' : Ideal.span (Set.range f') ≠ ⊤ := by
    rw [show Ideal.span (Set.range f') = (Ideal.span (Set.range f)).map E.toRingHom from
      (map_span_range_fin E.toRingHom f).symm]
    exact fun h => hproper ((Ideal.map_eq_top_of_bijective _ E.bijective).mp h)
  obtain ⟨Y, g, hsurj, hsm, haff, t, ht, hkt⟩ :=
    exists_smooth_surjective_affine_regular_generators (i ∣_ U.1) f' hf' hker' hproper'
  let g' := g ≫ U.1.ι
  have H := (IsPullback.of_hasPullback (i ∣_ U.1) g).flip.paste_vert
    (isPullback_morphismRestrict i U.1)
  let e := H.flip.isoPullback
  refine ⟨Y, g', inferInstanceAs (Smooth g'), haff, ?_, n, t, ht, ?_⟩
  · obtain ⟨y, hy⟩ := hsurj.surj ⟨i z, hz⟩
    exact ⟨y, congrArg U.1.ι hy⟩
  · have he : e.inv ≫ pullback.snd (i ∣_ U.1) g = pullback.snd i g' :=
      H.flip.isoPullback_inv_snd
    rw [← he]
    exact (ker_appTop_comp_iso e.symm _).trans hkt

/-! ### Gluing -/

/-- For a closed immersion the inclusion of the coborder range is an isomorphism. -/
private theorem isIso_coborderRange_ι {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] :
    IsIso i.coborderRange.ι :=
  isIso_of_isOpenImmersion_of_opensRange_eq_top _
    ((Scheme.Opens.opensRange_ι _).trans (DiagonalConormal.coborderRange_eq_top i))

/-- Regularity of a closed immersion from a cover of its image by affine open immersions over
which the base change has a regular defining family. -/
theorem isRegularImmersion_of_affine_pullback_cover {Z X : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] {κ : Type u} (Y : κ → Scheme.{u}) (a : ∀ k, Y k ⟶ X)
    (haff : ∀ k, IsAffine (Y k)) (hopen : ∀ k, IsOpenImmersion (a k))
    (hreg : ∀ k, ∃ (n : ℕ) (t : Fin n → Γ(Y k, ⊤)),
      RingTheory.Sequence.IsRegular (Γ(Y k, ⊤)) (List.ofFn t) ∧
        RingHom.ker (pullback.snd i (a k)).appTop.hom = Ideal.span (Set.range t))
    (hcover : ∀ z : Z, ∃ (k : κ) (y : Y k), a k y = i z) :
    IsRegularImmersion i := by
  let c := i.coborderRange.ι
  have hc : IsIso c := isIso_coborderRange_ι i
  refine (RegularIdealSheaf.isRegularIdealSheaf_iff_exists_affine_generators
    i.coborderRange.toScheme (definingIdeal i)).mpr fun x hx => ?_
  obtain ⟨z, hz⟩ := (idealQuotientSupport_eq_range i.liftCoborder).le hx
  obtain ⟨k, y, hy⟩ := hcover z
  have := haff k
  have := hopen k
  let a' := a k ≫ inv c
  have H : IsPullback (pullback.snd i (a k)) (pullback.fst i (a k)) a' i.liftCoborder := by
    refine (IsPullback.of_hasPullback i (a k)).flip.of_iso
      (Iso.refl _) (Iso.refl _) (Iso.refl _) (asIso c).symm ?_ ?_ ?_ ?_
    · simp
    · simp
    · simp [a']
    · simp only [Iso.refl_hom, Category.id_comp, Iso.symm_hom, asIso_inv]
      exact (IsIso.comp_inv_eq _).mpr i.liftCoborder_ι.symm
  obtain ⟨n, t, ht, hker⟩ := hreg k
  obtain ⟨U, hU, f, hf, hgen⟩ := affine_generators_of_isPullback
    i.liftCoborder (pullback.snd i (a k)) (pullback.fst i (a k)) a' H t ht hker
  refine ⟨U, ?_, n, f,
    isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span i.liftCoborder U.2 f hgen,
    hf.toIsWeaklyRegular⟩
  show x ∈ (U.1 : Set i.coborderRange.toScheme)
  rw [hU]
  show x ∈ Set.range a'
  refine ⟨y, ?_⟩
  have hcxy : c x = i z := by
    rw [← hz]
    exact congr($(i.liftCoborder_ι) z)
  show inv c (a k y) = x
  rw [hy, ← hcxy, ← Scheme.Hom.comp_apply, IsIso.hom_inv_id]
  rfl

/-- The closed case: a closed immersion with Koszul-regular defining ideal sheaf becomes regular
after a surjective smooth base change. -/
theorem exists_smooth_surjective_regular_baseChange_of_idealSheaf {Z X : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i]
    (hi : IsKoszulRegularIdealSheaf X.toRingedSpace (definingIdealOfHom i)) :
    ∃ (Y : Scheme.{u}) (g : Y ⟶ X), Surjective g ∧ Smooth g ∧
      IsRegularImmersion (pullback.snd i g) := by
  classical
  choose Y g hsm haff hcover n t ht hker using
    exists_local_smooth_affine_regular_generators i hi
  let W : X.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  let V : Option Z → Scheme.{u} := fun k ↦ k.elim W.toScheme Y
  let f : ∀ k, V k ⟶ X := fun k ↦ Option.rec W.ι g k
  let G := Sigma.desc f
  have hsmf : ∀ k, Smooth (f k) := by
    intro k
    cases k with
    | none => exact inferInstanceAs (Smooth W.ι)
    | some z => exact hsm z
  have hsurj : ⋃ k, Set.range (f k).base = Set.univ := by
    refine Set.eq_univ_of_forall fun x => ?_
    by_cases hx : x ∈ Set.range i
    · obtain ⟨z, rfl⟩ := hx
      obtain ⟨y, hy⟩ := hcover z
      exact Set.mem_iUnion.mpr ⟨some z, y, hy⟩
    · exact Set.mem_iUnion.mpr ⟨none, ⟨x, hx⟩, rfl⟩
  obtain ⟨hGsm, hGsurj⟩ := sigmaDesc_smooth_surjective f hsmf hsurj
  refine ⟨∐ V, G, hGsurj, hGsm, ?_⟩
  refine isRegularImmersion_of_affine_pullback_cover (pullback.snd i G) Y
    (fun z ↦ Sigma.ι V (some z)) haff
    (fun z ↦ inferInstanceAs (IsOpenImmersion (Sigma.ι V (some z)))) ?_ ?_
  · exact fun z => ⟨n z, t z, ht z, (ker_appTop_pullback_snd_comp i G (Sigma.ι V (some z)) (g z)
      (Sigma.ι_desc f (some z))).trans (hker z)⟩
  · intro p
    obtain ⟨⟨k, y⟩, hy⟩ := (sigmaMk V).surjective (pullback.snd i G p)
    rw [sigmaMk_mk] at hy
    cases k with
    | some z => exact ⟨z, y, hy⟩
    | none =>
      have hw : i (pullback.fst i G p) = W.ι y := by
        calc
          i (pullback.fst i G p) = G (pullback.snd i G p) :=
            congr($(pullback.condition (f := i) (g := G)) p)
          _ = G (Sigma.ι V none y) := congrArg G hy.symm
          _ = W.ι y := congr($(Sigma.ι_desc f none) y)
      exact (y.property ⟨pullback.fst i G p, hw⟩).elim

/-- **Stacks Project, Tag 0692.**  A Koszul-regular closed immersion becomes a regular immersion
after a surjective smooth base change of its target.

Both conditions are stated with the classes of Stacks tag 063J, parts (2) and (1):
`RegularIdealSheaf.IsKoszulRegularImmersion` and `RegularIdealSheaf.IsRegularImmersion`. -/
@[stacks 0692]
theorem exists_smooth_surjective_regular_baseChange {Z X : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] (hi : RegularIdealSheaf.IsKoszulRegularImmersion i) :
    ∃ (X' : Scheme.{u}) (g : X' ⟶ X),
      Surjective g ∧ Smooth g ∧
        RegularIdealSheaf.IsRegularImmersion (pullback.snd i g) := by
  let c := i.coborderRange.ι
  have hc : IsIso c := isIso_coborderRange_ι i
  obtain ⟨Y, g, hsurj, hsm, hreg⟩ :=
    exists_smooth_surjective_regular_baseChange_of_idealSheaf i.liftCoborder hi
  have Hc : IsPullback i.liftCoborder (𝟙 Z) c i :=
    IsPullback.of_vert_isIso ⟨by simpa only [Category.id_comp] using i.liftCoborder_ι⟩
  have H := ((IsPullback.of_hasPullback i.liftCoborder g).flip.paste_vert Hc).flip
  refine ⟨Y, g ≫ c, inferInstance, inferInstance, ?_⟩
  have he : H.isoPullback.inv ≫ pullback.snd i.liftCoborder g = pullback.snd i (g ≫ c) :=
    H.isoPullback_inv_snd
  simpa only [Iso.symm_hom, he] using isRegularImmersion_comp_iso H.isoPullback.symm _ hreg

end Stacks.AlgebraicGeometry

