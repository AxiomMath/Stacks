/-! ### Support of a derived pullback -/

/-- The stalk functor on `𝒪_X`-modules over the local ring `𝒪_{X,x}` vanishes on a module exactly
when the stalk of the underlying sheaf of abelian groups vanishes. -/
theorem isZero_modulesStalkFunctor_obj_iff {X : Scheme.{u}} (x : X) (M : X.Modules) :
    IsZero ((Stacks.ModuleSkyscraper.modulesStalkFunctor X x).obj M) ↔
      IsZero (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u}) (X := X) M.val.presheaf x) := by
  rw [ModuleCat.isZero_iff_subsingleton, AddCommGrpCat.isZero_iff_subsingleton]
  exact Iff.rfl

/-- **The cohomology of an object of `D(𝒪_X)` vanishes at a point exactly when its derived stalk
there vanishes.** -/
theorem forall_isZero_stalk_homology_iff_isZero_derivedStalkFunctor {X : Scheme.{u}} (x : X)
    (K : DerivedCategory X.Modules) :
    (∀ n : ℤ, IsZero (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u}) (X := X)
        ((DerivedCategory.homologyFunctor X.Modules n).obj K).val.presheaf x)) ↔
      IsZero ((derivedStalkFunctor x).obj K) := by
  refine ⟨fun h => ?_, fun h n => ?_⟩
  · refine DerivedCategory.isZero_of_forall_isZero_homology fun n => ?_
    refine IsZero.of_iso ?_
      (((Stacks.ModuleSkyscraper.modulesStalkFunctor X x).mapDerivedCategoryHomologyIso n).app K)
    exact (isZero_modulesStalkFunctor_obj_iff x _).2 (h n)
  · refine (isZero_modulesStalkFunctor_obj_iff x _).1 ?_
    exact IsZero.of_iso (Functor.map_isZero _ h) (((Stacks.ModuleSkyscraper.modulesStalkFunctor X
      x).mapDerivedCategoryHomologyIso n).app K).symm

/-- **The support of a derived pullback.** If the cohomology of `E'` in `D(𝒪_{T'})` is supported
on `Σ`, then the cohomology of `Lh^*E'` is supported on the preimage of `Σ`: the derived stalk of
`Lh^*E'` at `t` is a derived base change of the derived stalk of `E'` at `h t`. -/
theorem cohomologySupportedOn_derivedPullback {T T' : Scheme.{u}} (h : T ⟶ T') (Sg : Set T')
    (E' : DerivedCategory T'.Modules) (hE : CohomologySupportedOn T'.ringCatSheaf Sg E') :
    CohomologySupportedOn T.ringCatSheaf (h.base ⁻¹' Sg)
      ((derivedPullback (ofScheme h)).obj E') := by
  intro n t ht
  revert n
  refine (forall_isZero_stalk_homology_iff_isZero_derivedStalkFunctor t _).2 ?_
  let F := CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars.{u, u, u}
    (h.stalkMap t).hom
  have := F.additive
  exact IsZero.of_iso (Functor.map_isZero F.functor
    ((forall_isZero_stalk_homology_iff_isZero_derivedStalkFunctor (h.base t) E').1
      fun n => hE n (h.base t) ht)) ((derivedPullbackStalkIso h t).app E')

/-! ### Direct image along an affine morphism -/

/-- **Direct image computes derived direct image on a quasi-coherent module along an affine
morphism:** for `f : X ⟶ S` affine and `M` a quasi-coherent `𝒪_X`-module, `Rf_*(M[0])` is
`(f_*M)[0]` ([Stacks, Tag 0G9N] at the complex concentrated in degree zero on `M`). -/
def derivedPushforwardSingleIsoOfIsAffineHom {X S : Scheme.{u}} (f : X ⟶ S) [IsAffineHom f]
    (M : X.Modules) [M.IsQuasicoherent] :
    (derivedPushforward (ofScheme f)).obj ((DerivedCategory.singleFunctor X.Modules 0).obj M) ≅
      (DerivedCategory.singleFunctor S.Modules 0).obj
        ((Scheme.Modules.pushforward f).obj M) :=
  letI K : CochainComplex X.Modules ℤ := (CochainComplex.singleFunctor X.Modules 0).obj M
  letI α := schemeDerivedPushforwardUnit f
  haveI : IsIso (α.app ((HomotopyCategory.quotient X.Modules (ComplexShape.up ℤ)).obj K)) :=
    affineRightDerivedPushforward_unit_isIso f (schemeDerivedPushforward f) α K
      (Stacks.AlgebraicGeometry.DerivedAffinePushforward.isQuasicoherent_single_obj_X M)
  (schemeDerivedPushforward f).mapIso
      ((DerivedCategory.quotientCompQhIso X.Modules).app K).symm ≪≫
    (asIso (α.app ((HomotopyCategory.quotient X.Modules (ComplexShape.up ℤ)).obj K))).symm ≪≫
    (DerivedCategory.quotientCompQhIso S.Modules).app
      (((Scheme.Modules.pushforward f).mapHomologicalComplex (ComplexShape.up ℤ)).obj K) ≪≫
    DerivedCategory.Q.mapIso
      ((HomologicalComplex.singleMapHomologicalComplex (Scheme.Modules.pushforward f)
        (ComplexShape.up ℤ) 0).app M)

/-! ### The conclusion of the derived Chow lemma -/

/-- **The conclusion of [Stacks, Tag 0CSJ]** for a morphism `f : X ⟶ S` at a point `x`: there are
an open `U ∋ x` of `X`, an `m`, an open `V` of `ℙᵐ_S`, a closed subscheme `iZ : Z ⟶ X ×_S ℙᵐ_S`
of finite presentation, a point `z` of `Z` and an object `E` of `D(𝒪_{X ×_S ℙᵐ_S})` such that,
writing `b` and `c` for the two projections of `Z`: `b` is an isomorphism over `U` and `b z = x`,
`c` is a closed immersion over `V`, `b ⁻¹ᵁ U = c ⁻¹ᵁ V`, the restriction of `E` to `X ×_S V` is
isomorphic to the restriction of `(iZ)_* 𝒪_Z`, and `E` is pseudo-coherent with cohomology
supported on `Z`. -/
def HasDerivedChowDatum {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  ∃ (U : X.Opens) (m : ℕ) (V : (projectiveSpaceOver m S).Opens) (Z : Scheme.{u})
    (iZ : Z ⟶ pullback f (projectiveSpaceOver m S ↘ S)) (z : Z)
    (E : DerivedCategory (pullback f (projectiveSpaceOver m S ↘ S)).Modules),
    x ∈ U ∧ IsClosedImmersion iZ ∧ FinitePresentation iZ ∧
      IsIso ((iZ ≫ pullback.fst f (projectiveSpaceOver m S ↘ S)) ∣_ U) ∧
      (iZ ≫ pullback.fst f (projectiveSpaceOver m S ↘ S)).base z = x ∧
      IsClosedImmersion ((iZ ≫ pullback.snd f (projectiveSpaceOver m S ↘ S)) ∣_ V) ∧
      (iZ ≫ pullback.fst f (projectiveSpaceOver m S ↘ S)) ⁻¹ᵁ U =
        (iZ ≫ pullback.snd f (projectiveSpaceOver m S ↘ S)) ⁻¹ᵁ V ∧
      Nonempty ((derivedPullback
          (ofScheme (pullback.snd f (projectiveSpaceOver m S ↘ S) ⁻¹ᵁ V).ι)).obj E ≅
        (derivedPullback
          (ofScheme (pullback.snd f (projectiveSpaceOver m S ↘ S) ⁻¹ᵁ V).ι)).obj
          ((DerivedCategory.singleFunctor
            (pullback f (projectiveSpaceOver m S ↘ S)).Modules 0).obj
            ((Scheme.Modules.pushforward iZ).obj (SheafOfModules.unit Z.ringCatSheaf)))) ∧
      RingedSpace.IsPseudoCoherent
        (X := (pullback f (projectiveSpaceOver m S ↘ S)).toRingedSpace) E ∧
      CohomologySupportedOn (pullback f (projectiveSpaceOver m S ↘ S)).ringCatSheaf
        (Set.range iZ.base) E

/-! ### Base change of a derived Chow datum -/

section Transfer

variable {S S' X X' : Scheme.{u}} {s : S ⟶ S'} {f : X ⟶ S} {f' : X' ⟶ S'} {φ : X ⟶ X'}

/-- **The limit step of [Stacks, Tag 0CSJ].** Let `X = X' ×_{S'} S` be a base change of
`f' : X' ⟶ S'`. A derived Chow datum for `f'` at the image `φ x` of a point `x` whose complex is
the direct image `(iZ')_* 𝒪_{Z'}` pulls back to a derived Chow datum for `f` at `x`: the closed
subscheme is the scheme-theoretic inverse image of `Z'`, the opens are the inverse images of the
opens, and the complex is the derived pullback of `(iZ')_* 𝒪_{Z'}`. Over `X ×_S V` the
identification of that derived pullback with the direct image of `𝒪_Z` is Tor-independent base
change ([Stacks, Tag 0E23] in the role of [Stacks, Tag 08IB]), the Tor independence being
[Stacks, Tag 0CTA]. -/
theorem hasDerivedChowDatum_of_isPullback (hX : IsPullback φ f f' s) (x : X) (U' : X'.Opens)
    (m : ℕ) (V' : (projectiveSpaceOver m S').Opens) (Z' : Scheme.{u})
    (iZ' : Z' ⟶ pullback f' (projectiveSpaceOver m S' ↘ S')) (hx : φ.base x ∈ U')
    [IsClosedImmersion iZ'] (hfp : FinitePresentation iZ')
    (hU : IsIso ((iZ' ≫ pullback.fst f' (projectiveSpaceOver m S' ↘ S')) ∣_ U'))
    (hV : IsClosedImmersion ((iZ' ≫ pullback.snd f' (projectiveSpaceOver m S' ↘ S')) ∣_ V'))
    (hpre : (iZ' ≫ pullback.fst f' (projectiveSpaceOver m S' ↘ S')) ⁻¹ᵁ U' =
      (iZ' ≫ pullback.snd f' (projectiveSpaceOver m S' ↘ S')) ⁻¹ᵁ V')
    (hpc : RingedSpace.IsPseudoCoherent
      (X := (pullback f' (projectiveSpaceOver m S' ↘ S')).toRingedSpace)
      ((DerivedCategory.singleFunctor (pullback f' (projectiveSpaceOver m S' ↘ S')).Modules 0).obj
        ((Scheme.Modules.pushforward iZ').obj (SheafOfModules.unit Z'.ringCatSheaf)))) :
    HasDerivedChowDatum f x := by
  have hP : IsPullback (projectiveSpaceOverMap m s) (projectiveSpaceOver m S ↘ S)
      (projectiveSpaceOver m S' ↘ S') s := isPullback_projectiveSpaceOverMap m s
  let h := chowBaseChangeMap hX hP
  let Z := pullback iZ' h
  let gZ := pullback.fst iZ' h
  let iZ := pullback.snd iZ' h
  have hZ : IsPullback gZ iZ iZ' h := IsPullback.of_hasPullback iZ' h
  have hb : IsPullback gZ (iZ ≫ pullback.fst f (projectiveSpaceOver m S ↘ S))
      (iZ' ≫ pullback.fst f' (projectiveSpaceOver m S' ↘ S')) φ :=
    hZ.paste_vert (isPullback_chowBaseChangeMap_fst hX hP)
  have hc : IsPullback gZ (iZ ≫ pullback.snd f (projectiveSpaceOver m S ↘ S))
      (iZ' ≫ pullback.snd f' (projectiveSpaceOver m S' ↘ S')) (projectiveSpaceOverMap m s) :=
    hZ.paste_vert (isPullback_chowBaseChangeMap_snd hX hP)
  have hUiso : IsIso ((iZ ≫ pullback.fst f (projectiveSpaceOver m S ↘ S)) ∣_ (φ ⁻¹ᵁ U')) :=
    of_isPullback_morphismRestrict (MorphismProperty.isomorphisms Scheme.{u}) hb U' hU
  obtain ⟨z, hz⟩ := exists_base_eq_of_isIso_morphismRestrict
    (iZ ≫ pullback.fst f (projectiveSpaceOver m S ↘ S)) (φ ⁻¹ᵁ U') (y := x) hx
  refine ⟨φ ⁻¹ᵁ U', m, projectiveSpaceOverMap m s ⁻¹ᵁ V', Z, iZ, z,
    (derivedPullback (ofScheme h)).obj
      ((DerivedCategory.singleFunctor (pullback f' (projectiveSpaceOver m S' ↘ S')).Modules 0).obj
        ((Scheme.Modules.pushforward iZ').obj (SheafOfModules.unit Z'.ringCatSheaf))),
    hx, MorphismProperty.of_isPullback hZ inferInstance,
    ⟨MorphismProperty.of_isPullback hZ hfp.1, MorphismProperty.of_isPullback hZ hfp.2.1,
      MorphismProperty.of_isPullback hZ hfp.2.2⟩, hUiso, hz,
    of_isPullback_morphismRestrict (@IsClosedImmersion) hc V' hV, ?_, ?_, ?_, ?_⟩
  · rw [← Scheme.Hom.comp_preimage (iZ ≫ pullback.fst f (projectiveSpaceOver m S ↘ S)) φ,
      ← Scheme.Hom.comp_preimage (iZ ≫ pullback.snd f (projectiveSpaceOver m S ↘ S))
        (projectiveSpaceOverMap m s), ← hb.w, ← hc.w,
      Scheme.Hom.comp_preimage gZ, Scheme.Hom.comp_preimage gZ, hpre]
  · -- Clause (5): Tor-independent base change over `X ×_S V`.
    let O := pullback.snd f (projectiveSpaceOver m S ↘ S) ⁻¹ᵁ (projectiveSpaceOverMap m s ⁻¹ᵁ V')
    let k := O.ι ≫ h
    let iW := iZ ∣_ O
    let gW := (iZ ⁻¹ᵁ O).ι ≫ gZ
    have sq : IsPullback iW gW k iZ' :=
      ((isPullback_morphismRestrict iZ O).flip.paste_horiz hZ).flip
    have hflat : Flat ((iZ' ⁻¹ᵁ (pullback.snd f' (projectiveSpaceOver m S' ↘ S') ⁻¹ᵁ V')).ι ≫
        iZ' ≫ pullback.fst f' (projectiveSpaceOver m S' ↘ S')) := by
      have e : (iZ' ⁻¹ᵁ (pullback.snd f' (projectiveSpaceOver m S' ↘ S') ⁻¹ᵁ V')) =
          (iZ' ≫ pullback.fst f' (projectiveSpaceOver m S' ↘ S')) ⁻¹ᵁ U' := hpre.symm
      rw [← Z'.isoOfEq_hom_ι e, Category.assoc,
        ← morphismRestrict_ι (iZ' ≫ pullback.fst f' (projectiveSpaceOver m S' ↘ S')) U']
      infer_instance
    have htor : TorIndependent iZ' k := torIndependent_ι_chowBaseChangeMap hX hP iZ' V' hflat
    refine ⟨(Stacks.DerivedPullback.Composition.derivedPullbackCompIsoCanonical (ofScheme O.ι)
        (ofScheme h)).app _ ≪≫
      (derivedPullback (ofScheme k)).mapIso
        (derivedPushforwardSingleIsoOfIsAffineHom iZ' (SheafOfModules.unit Z'.ringCatSheaf)).symm ≪≫
      (Stacks.Cohomology.ClosedImmersionBaseChange.derivedBaseChangeSquareIso sq htor).app _ ≪≫
      (derivedPushforward (ofScheme iW)).mapIso
        (Stacks.Cohomology.DerivedPullbackUnit.derivedPullbackUnitIso (ofScheme gW)) ≪≫
      ((derivedPushforward (ofScheme iW)).mapIso
        (Stacks.Cohomology.DerivedPullbackUnit.derivedPullbackUnitIso
          (ofScheme (iZ ⁻¹ᵁ O).ι))).symm ≪≫
      ((derivedPushforwardRestrictOpenIso iZ O).app _).symm ≪≫
      (derivedPullback (ofScheme O.ι)).mapIso
        (derivedPushforwardSingleIsoOfIsAffineHom iZ (SheafOfModules.unit Z.ringCatSheaf))⟩
  · refine (RingedSpace.isPseudoCoherent_iff_forall
      (X := (pullback f (projectiveSpaceOver m S ↘ S)).toRingedSpace) _).2 fun k => ?_
    exact RingedSpace.KFlatDerivedPullback.isPseudoCoherentFrom_derivedPullback (ofScheme h)
      _ k ((RingedSpace.isPseudoCoherent_iff_forall
        (X := (pullback f' (projectiveSpaceOver m S' ↘ S')).toRingedSpace) _).1 hpc k)
  · rw [Scheme.Pullback.range_snd iZ' h]
    exact cohomologySupportedOn_derivedPullback h _ _
      (cohomologySupportedOn_singleFunctor_pushforward_unit iZ')

end Transfer

/-! ### Derived Chow's lemma -/

/-- **The reduction to a ring of finite type over `ℤ`.** A separated scheme of finite
presentation over a ring `A` is the base change of a separated scheme of finite presentation
over a subring of `A` generated by finitely many elements. -/
theorem exists_isPullback_isSeparated_finitePresentation_adjoin {A : Type u} [CommRing A]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) [IsSeparated f] [LocallyOfFinitePresentation f]
    [QuasiCompact f] :
    ∃ (i : Finset A) (Y : Scheme.{u})
      (p : Y ⟶ Spec (.of (Algebra.adjoin ℤ (i : Set A)))) (φ : X ⟶ Y),
      IsSeparated p ∧ FinitePresentation p ∧
        IsPullback φ f p ((specAdjoinFinsetCone A).π.app (Opposite.op i)) := by
  have hc : IsLimit (specAdjoinFinsetCone A) := isLimit_specAdjoinFinsetCone A
  have hsepf : IsSeparated (f : X ⟶ (specAdjoinFinsetCone A).pt) := ‹IsSeparated f›
  have hfp : FinitePresentation (f : X ⟶ (specAdjoinFinsetCone A).pt) :=
    ⟨‹LocallyOfFinitePresentation f›, ‹QuasiCompact f›, inferInstanceAs (QuasiSeparated f)⟩
  obtain ⟨i, Y, p, g, hp, hpb⟩ :=
    LimitDescent.exists_isPullback_of_finitePresentation_of_essentiallySmall
      (specAdjoinFinsetDiagram A) (specAdjoinFinsetCone A) hc
      (f : X ⟶ (specAdjoinFinsetCone A).pt) hfp
  have : LocallyOfFinitePresentation p := hp.1
  have : QuasiCompact p := hp.2.1
  have : QuasiSeparated p := hp.2.2
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace p
  have : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated p
  have hsep : IsSeparated (pullback.snd p ((specAdjoinFinsetCone A).π.app i)) := by
    rw [← hpb.isoPullback_inv_snd]
    exact MorphismProperty.comp_mem (W := @IsSeparated) _ _ inferInstance hsepf
  let q : Over.mk p ⟶ Over.mk (𝟙 ((specAdjoinFinsetDiagram A).obj i)) := Over.homMk p (by simp)
  have : IsSeparated ((Over.pullback ((specAdjoinFinsetCone A).π.app i)).map q).left :=
    (isSeparated_overPullback_map_left_iff _ p q).mpr hsep
  have : CompactSpace ((Over.mk p).left : Scheme.{u}) := inferInstanceAs (CompactSpace Y)
  have : QuasiSeparatedSpace ((Over.mk p).left : Scheme.{u}) :=
    inferInstanceAs (QuasiSeparatedSpace Y)
  have : CompactSpace ((Over.mk (𝟙 ((specAdjoinFinsetDiagram A).obj i))).left : Scheme.{u}) :=
    inferInstanceAs (CompactSpace ((specAdjoinFinsetDiagram A).obj i))
  have : QuasiSeparatedSpace
      ((Over.mk (𝟙 ((specAdjoinFinsetDiagram A).obj i))).left : Scheme.{u}) :=
    inferInstanceAs (QuasiSeparatedSpace ((specAdjoinFinsetDiagram A).obj i))
  obtain ⟨j, w, hsepw⟩ :=
    exists_isSeparated_baseChange_of_isLimit (specAdjoinFinsetDiagram A) (specAdjoinFinsetCone A)
      i (Over.mk p) (Over.mk (𝟙 ((specAdjoinFinsetDiagram A).obj i))) q hc
  have hsepj : IsSeparated (pullback.snd p ((specAdjoinFinsetDiagram A).map w)) :=
    (isSeparated_overPullback_map_left_iff _ p q).mp hsepw
  have hpw := IsPullback.of_hasPullback p ((specAdjoinFinsetDiagram A).map w)
  rw [← (specAdjoinFinsetCone A).w w] at hpb
  exact ⟨j.unop, pullback p ((specAdjoinFinsetDiagram A).map w),
    pullback.snd p ((specAdjoinFinsetDiagram A).map w), _, hsepj,
    FinitePresentation.of_isPullback hpw hp, IsPullback.of_right' hpb hpw⟩

/-- **Derived Chow's lemma**, [Stacks, Tag 0CSJ]. Let `A` be a ring and let `X` be a separated
scheme of finite presentation over `A`, with structure morphism `f : X ⟶ Spec A`. For every
point `x` of `X` there are an open neighbourhood `U` of `x`, an `m ≥ 0`, an open `V` of
`ℙᵐ_A`, a closed subscheme `iZ : Z ⟶ X ×_A ℙᵐ_A`, a point `z` of `Z` and an object `E` of
`D(𝒪_{X ×_A ℙᵐ_A})` such that, writing `b : Z ⟶ X` and `c : Z ⟶ ℙᵐ_A` for the two projections
of `Z`:

1. `iZ` is of finite presentation;
2. `b` is an isomorphism over `U`, and `b z = x`;
3. `c` is a closed immersion over `V`;
4. `b ⁻¹ᵁ U = c ⁻¹ᵁ V`, and in particular `c z ∈ V`;
5. the restriction of `E` to `X ×_A V` is isomorphic to the restriction of `(b, c)_* 𝒪_Z`;
6. `E` is pseudo-coherent and its cohomology is supported on `Z`.

The proof is the source's: write `X` as the base change of a separated scheme of finite
presentation `X'` over a finitely generated subring `A'` of `A`, apply the Noetherian case
`AlgebraicGeometry.exists_chowDatum_isPseudoCoherent_of_isNoetherian` to `X'`, and pull the
datum back (`AlgebraicGeometry.hasDerivedChowDatum_of_isPullback`). -/
@[stacks 0CSJ]
theorem exists_derivedChowDatum {A : Type u} [CommRing A] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of A)) [IsSeparated f] [LocallyOfFinitePresentation f] [QuasiCompact f]
    (x : X) :
    ∃ (U : X.Opens) (m : ℕ) (V : (projectiveSpaceOver m (Spec (.of A))).Opens) (Z : Scheme.{u})
      (iZ : Z ⟶ pullback f (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A))) (z : Z)
      (E : DerivedCategory
        (pullback f (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A))).Modules),
      x ∈ U ∧ IsClosedImmersion iZ ∧ FinitePresentation iZ ∧
        IsIso ((iZ ≫ pullback.fst f
          (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A))) ∣_ U) ∧
        (iZ ≫ pullback.fst f
          (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A))).base z = x ∧
        IsClosedImmersion ((iZ ≫ pullback.snd f
          (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A))) ∣_ V) ∧
        (iZ ≫ pullback.fst f
            (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A))) ⁻¹ᵁ U =
          (iZ ≫ pullback.snd f
            (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A))) ⁻¹ᵁ V ∧
        (iZ ≫ pullback.snd f
          (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A))).base z ∈ V ∧
        Nonempty ((derivedPullback (ofScheme (pullback.snd f
            (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A)) ⁻¹ᵁ V).ι)).obj E ≅
          (derivedPullback (ofScheme (pullback.snd f
            (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A)) ⁻¹ᵁ V).ι)).obj
            ((DerivedCategory.singleFunctor
              (pullback f (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A))).Modules 0).obj
              ((Scheme.Modules.pushforward iZ).obj (SheafOfModules.unit Z.ringCatSheaf)))) ∧
        RingedSpace.IsPseudoCoherent (X := (pullback f
          (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A))).toRingedSpace) E ∧
        CohomologySupportedOn (pullback f
            (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A))).ringCatSheaf
          (Set.range iZ.base) E := by
  obtain ⟨i, Y, p, φ, hsep, hp, hpb⟩ := exists_isPullback_isSeparated_finitePresentation_adjoin f
  have := isNoetherianRing_adjoinFinset_int A i
  have : LocallyOfFinitePresentation p := hp.1
  have : QuasiCompact p := hp.2.1
  have : LocallyOfFiniteType p := inferInstance
  have H0 := exists_chowDatum_isPseudoCoherent_of_isNoetherian p (φ.base x)
  obtain ⟨U', m, V', Z', iZ', z', E', hx, hiZ, hfp, hU, hz', hV, hpre, he, hpc, hsupp⟩ := H0
  obtain ⟨e⟩ := he
  have H := hasDerivedChowDatum_of_isPullback hpb x U' m V' Z' iZ' hx hfp hU hV hpre
    (hpc.of_iso e)
  obtain ⟨U, m, V, Z, iZ, z, E, hxU, hiZ, hfpZ, hUZ, hz, hVZ, hpreZ, hE, hpcE, hsuppE⟩ := H
  have hzV : z ∈ (iZ ≫ pullback.snd f
      (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A))) ⁻¹ᵁ V := by
    rw [← hpreZ]
    change (iZ ≫ pullback.fst f
      (projectiveSpaceOver m (Spec (.of A)) ↘ Spec (.of A))).base z ∈ U
    rw [hz]
    exact hxU
  exact ⟨U, m, V, Z, iZ, z, E, hxU, hiZ, hfpZ, hUZ, hz, hVZ, hpreZ, hzV, hE, hpcE, hsuppE⟩

end AlgebraicGeometry

end
