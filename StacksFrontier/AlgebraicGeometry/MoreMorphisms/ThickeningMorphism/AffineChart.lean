module

public import Mathlib.AlgebraicGeometry.Morphisms.Affine
public import StacksFrontier.AlgebraicGeometry.Thickenings

/-!
# Affine charts of a cartesian first-order thickening

A cartesian square

```
X --f--→ S
|        |
i        j
↓        ↓
X' -f'-→ S'
```

of schemes, with `i` and `j` first-order thickenings, restricts on a pair of compatible affine
opens `V' ⊆ X'` and `U' ⊆ S'` with `f' V' ⊆ U'` to a square-zero quotient of coordinate rings:
writing `I ⊆ Γ(S', U')` for the ideal of `j` on `U'`, the ideal of `i` on `V'` is the extension
of `I` along `Γ(S', U') ⟶ Γ(X', V')`, and `I ^ 2 = 0`. The two quotients are then the
coordinate rings of `X` and `S` on the preimage opens, and they form a commutative square.

This is the affine-local input for transferring a property of `f` to `f'` across a first-order
thickening of the base.

## Main definitions

* `Stacks.Thickenings.FirstOrderThickeningChart`: a cartesian square of first-order
  thickenings together with a compatible pair of affine opens.
* `Stacks.Thickenings.FirstOrderThickeningChart.ringMap`: the induced map of coordinate rings
  on the chosen affine opens.
* `Stacks.Thickenings.FirstOrderThickeningChart.baseIdeal` and
  `Stacks.Thickenings.FirstOrderThickeningChart.sourceIdeal`: the ideal cutting out the base
  thickening on its chart, and its extension to the source chart.
* `Stacks.Thickenings.FirstOrderThickeningChart.quotientRingMap`: the induced map of quotient
  coordinate rings.

## Main results

* `CommRingCat.ker_eq_map_of_isPushout_of_surjective`: in a pushout square of commutative rings
  with one of the two maps out of the corner surjective, the kernel of the opposite map is the
  extension of its kernel.
* `Stacks.Thickenings.FirstOrderThickeningChart.baseIdeal_sq_eq_bot`: the base chart's ideal is
  square-zero.
* `Stacks.Thickenings.FirstOrderThickeningChart.sourceIdeal_eq_ker`: the source chart's ideal
  is the extension of the base chart's ideal.
* `Stacks.Thickenings.FirstOrderThickeningChart.base_app_surjective` and
  `Stacks.Thickenings.FirstOrderThickeningChart.source_app_surjective`: the two rows are exact
  at their right ends.
* `Stacks.Thickenings.FirstOrderThickeningChart.quotientRingMap_comp_mk`: the square of
  quotient rings commutes.
* `Stacks.Thickenings.appLE_eq_of_hom_eq`: equal morphisms of schemes induce the same map of
  sections.

## Implementation notes

The ideal cutting out an affine piece of a closed immersion is the kernel of the map on
sections to its inverse image. The quotient rings and their commutative square are obtained
from the two kernels and the induced ring map on the chosen affine opens. The kernel equality
states exactness at the middle term of the lower row; exactness at the ideal terms is the
injectivity of the inclusion of an ideal.

The identification of the source ideal rests on the fact that the restriction of a cartesian
square to compatible affine opens is a pushout of coordinate rings, so the kernel of the lower
map is generated by the kernel of the base map.

## References

* [Stacks Project, Tag 09ZW](https://stacks.math.columbia.edu/tag/09ZW)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

namespace CommRingCat

/-- In a pushout square of commutative rings whose left vertical map is surjective, the kernel
of the right vertical map is the extension of the kernel of the left one. -/
theorem ker_eq_map_of_isPushout_of_surjective
    {A B C D : CommRingCat} (f : A ⟶ B) (g : A ⟶ C) (h : B ⟶ D) (k : C ⟶ D)
    (hp : IsPushout f g h k) (hg : Function.Surjective g.hom) :
    RingHom.ker h.hom = (RingHom.ker g.hom).map f.hom := by
  apply le_antisymm
  · intro x hx
    let J : Ideal B := (RingHom.ker g.hom).map f.hom
    let q : B →+* B ⧸ J := Ideal.Quotient.mk J
    let lift : A →+* B ⧸ J := q.comp f.hom
    have hlift : ∀ a ∈ RingHom.ker g.hom, lift a = 0 := fun a ha =>
      (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem f.hom ha) : q (f.hom a) = 0)
    let e := RingHom.quotientKerEquivOfSurjective (f := g.hom) hg
    let qlift : A ⧸ RingHom.ker g.hom →+* B ⧸ J :=
      Ideal.Quotient.lift _ lift hlift
    let k' : C →+* B ⧸ J := qlift.comp e.symm.toRingHom
    have w : f ≫ CommRingCat.ofHom q = g ≫ CommRingCat.ofHom k' := by
      ext a
      show q (f.hom a) = qlift (e.symm (g.hom a))
      rw [RingHom.quotientKerEquivOfSurjective_symm_apply (f := g.hom) hg]
      show q (f.hom a) = (Ideal.Quotient.lift _ lift hlift) (Ideal.Quotient.mk _ a)
      rw [Ideal.Quotient.lift_mk]
      rfl
    let d : D ⟶ CommRingCat.of (B ⧸ J) := hp.desc (CommRingCat.ofHom q)
      (CommRingCat.ofHom k') w
    have hd : d.hom.comp h.hom = q :=
      congrArg CommRingCat.Hom.hom (hp.inl_desc (CommRingCat.ofHom q) (CommRingCat.ofHom k') w)
    have hxq : q x = 0 := by
      rw [← hd, RingHom.comp_apply, RingHom.mem_ker.mp hx, map_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mp hxq
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    simpa [RingHom.mem_ker.mp ha] using congrArg (fun φ : A ⟶ D => φ.hom a) hp.w

end CommRingCat

namespace Stacks.Thickenings

universe u

/-- Two equal morphisms of schemes induce the same map of sections on a pair of opens. -/
theorem appLE_eq_of_hom_eq {X Y : Scheme.{u}} (f g : X ⟶ Y) (h : f = g)
    (U : Y.Opens) (V : X.Opens) (hf : V ≤ f ⁻¹ᵁ U) (hg : V ≤ g ⁻¹ᵁ U) :
    f.appLE U V hf = g.appLE U V hg := by
  subst g
  rfl

/-- The restriction of a morphism to opens, on global sections, is `appLE` up to `topIso`. -/
private theorem resLE_appTop_comp_topIso_hom {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens)
    (V : X.Opens) (h : V ≤ f ⁻¹ᵁ U) :
    (f.resLE U V h).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V h :=
  (arrowResLEAppIso f U V h).hom.w.symm

/-- A cartesian square of first-order thickenings of schemes together with a compatible pair
of affine opens of the two ambient schemes. -/
structure FirstOrderThickeningChart where
  /-- The closed subscheme of the source thickening. -/
  X : Scheme.{u}
  /-- The ambient scheme of the source thickening. -/
  X' : Scheme.{u}
  /-- The closed subscheme of the base thickening. -/
  S : Scheme.{u}
  /-- The ambient scheme of the base thickening. -/
  S' : Scheme.{u}
  /-- The source thickening. -/
  i : X ⟶ X'
  /-- The base thickening. -/
  j : S ⟶ S'
  /-- The morphism of closed subschemes. -/
  f : X ⟶ S
  /-- The morphism of ambient schemes. -/
  f' : X' ⟶ S'
  /-- The source thickening is of first order. -/
  i_firstOrder : IsFirstOrderThickening i
  /-- The base thickening is of first order. -/
  j_firstOrder : IsFirstOrderThickening j
  /-- The square identifies `X` with `S ×_{S'} X'`. -/
  cartesian : IsPullback i f f' j
  /-- The chosen affine open of the ambient base scheme. -/
  U' : S'.Opens
  /-- The chosen affine open of the ambient source scheme. -/
  V' : X'.Opens
  /-- The chosen open of the base is affine. -/
  U'_affine : IsAffineOpen U'
  /-- The chosen open of the source is affine. -/
  V'_affine : IsAffineOpen V'
  /-- The chosen source open maps into the chosen base open. -/
  mapsTo : V' ≤ f' ⁻¹ᵁ U'

namespace FirstOrderThickeningChart

/-- The map of coordinate rings induced by the morphism of ambient schemes on the selected
affine opens. -/
abbrev ringMap (C : FirstOrderThickeningChart.{u}) :
    Γ(C.S', C.U') →+* Γ(C.X', C.V') :=
  (C.f'.appLE C.U' C.V' C.mapsTo).hom

/-- The ideal cutting out the base thickening on the affine chart. -/
abbrev baseIdeal (C : FirstOrderThickeningChart.{u}) :
    Ideal Γ(C.S', C.U') :=
  RingHom.ker (C.j.app C.U').hom

/-- The ideal obtained by extending the base ideal to the source affine chart. -/
abbrev sourceIdeal (C : FirstOrderThickeningChart.{u}) :
    Ideal Γ(C.X', C.V') :=
  (baseIdeal C).map (ringMap C)

/-- The canonical map between the quotient coordinate rings of the two charts. -/
def quotientRingMap (C : FirstOrderThickeningChart.{u}) :
    (Γ(C.S', C.U') ⧸ baseIdeal C) →+* (Γ(C.X', C.V') ⧸ sourceIdeal C) :=
  Ideal.quotientMap (sourceIdeal C) (ringMap C) Ideal.le_comap_map

/-- The ideal defining the first-order thickening on the base chart is square-zero. -/
theorem baseIdeal_sq_eq_bot (C : FirstOrderThickeningChart.{u}) :
    (baseIdeal C) ^ 2 = ⊥ := by
  show (RingHom.ker (C.j.app C.U').hom) ^ 2 = ⊥
  have _ : IsClosedImmersion C.j := C.j_firstOrder.1
  rw [← Scheme.Hom.ker_apply C.j ⟨C.U', C.U'_affine⟩]
  exact congrArg (fun K : Scheme.IdealSheafData C.S' => K.ideal ⟨C.U', C.U'_affine⟩)
    C.j_firstOrder.2

/-- The ideal defining the source thickening on its chart is the extension of the base
ideal. -/
theorem sourceIdeal_eq_ker (C : FirstOrderThickeningChart.{u}) :
    sourceIdeal C = RingHom.ker (C.i.app C.V').hom := by
  have _ : IsClosedImmersion C.i := C.i_firstOrder.1
  have _ : IsClosedImmersion C.j := C.j_firstOrder.1
  let UT : C.S.Opens := C.j ⁻¹ᵁ C.U'
  let UY : C.X.Opens := C.i ⁻¹ᵁ C.V'
  have hUST : UT ≤ C.j ⁻¹ᵁ C.U' := le_rfl
  have hUYi : UY ≤ C.i ⁻¹ᵁ C.V' := le_rfl
  have hUY : UY = C.i ⁻¹ᵁ C.V' ⊓ C.f ⁻¹ᵁ UT := by
    ext x
    show C.i x ∈ C.V' ↔ C.i x ∈ C.V' ∧ C.j (C.f x) ∈ C.U'
    refine ⟨fun hx => ⟨hx, ?_⟩, And.left⟩
    have hcomm : C.f' (C.i x) = C.j (C.f x) := by
      simpa [Scheme.Hom.comp_apply] using congrArg (fun g : C.X ⟶ C.S' => g x) C.cartesian.w
    rw [← hcomm]
    exact C.mapsTo hx
  have hUYf : UY ≤ C.f ⁻¹ᵁ UT := hUY.le.trans inf_le_right
  have _ : IsAffine C.U'.toScheme := C.U'_affine
  have _ : IsAffine C.V'.toScheme := C.V'_affine
  have _ : IsAffine UT.toScheme := C.U'_affine.preimage C.j
  have _ : IsAffine UY.toScheme := C.V'_affine.preimage C.i
  have hpush :=
    isPushout_appTop_of_isPullback (Scheme.Hom.isPullback_resLE C.cartesian hUST C.mapsTo hUY)
  have hpush' : IsPushout (CommRingCat.ofHom (ringMap C)) (C.j.app C.U')
      (C.i.app C.V') (C.f.appLE UT UY hUYf) := by
    refine IsPushout.of_iso hpush C.U'.topIso C.V'.topIso UT.topIso UY.topIso ?_ ?_ ?_ ?_
    · exact resLE_appTop_comp_topIso_hom C.f' C.U' C.V' C.mapsTo
    · rw [← Scheme.Hom.appLE_eq_app]
      exact resLE_appTop_comp_topIso_hom C.j C.U' UT hUST
    · rw [← Scheme.Hom.appLE_eq_app]
      exact resLE_appTop_comp_topIso_hom C.i C.V' UY hUYi
    · exact resLE_appTop_comp_topIso_hom C.f UT UY hUYf
  exact (CommRingCat.ker_eq_map_of_isPushout_of_surjective _ _ _ _ hpush'
    (C.j.app_surjective C.U' C.U'_affine)).symm

/-- The base affine chart restricts surjectively to its thickened closed subscheme. -/
theorem base_app_surjective (C : FirstOrderThickeningChart.{u}) :
    Function.Surjective (C.j.app C.U').hom := by
  have _ : IsClosedImmersion C.j := C.j_firstOrder.1
  exact C.j.app_surjective C.U' C.U'_affine

/-- The source affine chart restricts surjectively to its thickened closed subscheme. -/
theorem source_app_surjective (C : FirstOrderThickeningChart.{u}) :
    Function.Surjective (C.i.app C.V').hom := by
  have _ : IsClosedImmersion C.i := C.i_firstOrder.1
  exact C.i.app_surjective C.V' C.V'_affine

/-- The map on quotient charts commutes with the original map of affine coordinate rings. -/
theorem quotientRingMap_comp_mk (C : FirstOrderThickeningChart.{u}) :
    (quotientRingMap C).comp (Ideal.Quotient.mk (baseIdeal C)) =
      (Ideal.Quotient.mk (sourceIdeal C)).comp (ringMap C) := by
  ext x
  rfl

end FirstOrderThickeningChart

end Stacks.Thickenings

end
