/-! ### Flatness from an `H₁`-regular sequence over a flat quotient -/

/-- If the images of a finite family in an algebra form an `H₁`-regular sequence, then tensoring
the inclusion of the ideal they generate with that algebra stays injective. -/
private theorem lTensor_subtype_span_injective_of_isH1Regular
    {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    {n : ℕ} (a : Fin n → A)
    (ha : Koszul.IsH1Regular (fun k => algebraMap A B (a k))) :
    Function.Injective ((Ideal.span (Set.range a)).subtype.lTensor B) := by
  classical
  let I := Ideal.span (Set.range a)
  let v (k : Fin n) : I := ⟨a k, Ideal.subset_span (Set.mem_range_self k)⟩
  let e : (Fin n → B) →ₗ[B] B ⊗[A] I :=
    (Pi.basisFun B (Fin n)).constr B (fun k => 1 ⊗ₜ[A] v k)
  have he (k : Fin n) (b : B) : e (Pi.single k b) = b ⊗ₜ[A] v k := by
    rw [show Pi.single k b = b • (Pi.basisFun B (Fin n)) k by
      ext j
      by_cases h : j = k <;> simp [Pi.basisFun_apply, h]]
    rw [map_smul, Module.Basis.constr_basis]
    rw [TensorProduct.smul_tmul' (R := A) b (1 : B) (v k)]
    simp only [smul_eq_mul, mul_one]
  have hesurj : Function.Surjective e := by
    have hv : ∀ x : I, ∀ b : B, b ⊗ₜ[A] x ∈ LinearMap.range e := by
      intro x
      obtain ⟨x, hx⟩ := x
      induction hx using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨k, rfl⟩ := hx
        intro b
        exact ⟨Pi.single k b, he k b⟩
      | zero =>
        intro b
        show b ⊗ₜ[A] (0 : I) ∈ LinearMap.range e
        simp
      | add x y hx hy ihx ihy =>
        intro b
        simpa only [show (⟨x + y, _⟩ : I) = ⟨x, hx⟩ + ⟨y, hy⟩ from rfl,
          TensorProduct.tmul_add] using (LinearMap.range e).add_mem (ihx b) (ihy b)
      | smul r x hx ih =>
        intro b
        show b ⊗ₜ[A] (r • (⟨x, hx⟩ : I)) ∈ LinearMap.range e
        rw [← TensorProduct.smul_tmul]
        exact ih (r • b)
    intro t
    induction t using TensorProduct.induction_on with
    | zero => exact ⟨0, e.map_zero⟩
    | tmul b x => exact hv x b
    | add x y hx hy => exact ⟨hx.choose + hy.choose, by simp [hx.choose_spec, hy.choose_spec]⟩
  let l := I.subtype.lTensor B
  have hcomp (c : Fin n → B) : (TensorProduct.rid A B) (l (e c)) =
      Koszul.seqDual (fun k => algebraMap A B (a k)) c := by
    have hc : c = ∑ k, Pi.single k (c k) := by ext k; simp
    rw [hc, map_sum, map_sum, map_sum, map_sum]
    apply Finset.sum_congr rfl
    intro k hk
    simp [he, l, Koszul.seqDual_apply_single, v, Algebra.smul_def, mul_comm]
  have hrel : Koszul.relSpan (fun k => algebraMap A B (a k)) ≤ LinearMap.ker e := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨i, j⟩, rfl⟩
    show e (Koszul.trivRel (fun k => algebraMap A B (a k)) i j) = 0
    rw [Koszul.trivRel, map_sub, he, he]
    apply sub_eq_zero.mpr
    rw [show algebraMap A B (a i) = a i • (1 : B) by simp [Algebra.smul_def],
      show algebraMap A B (a j) = a j • (1 : B) by simp [Algebra.smul_def]]
    rw [TensorProduct.smul_tmul, TensorProduct.smul_tmul]
    congr 1
    exact Subtype.ext (mul_comm _ _)
  apply (injective_iff_map_eq_zero l).mpr
  intro t ht
  obtain ⟨c, rfl⟩ := hesurj t
  apply hrel
  apply ((Koszul.isH1Regular_iff_ker_le_relSpan _).mp ha)
  rw [LinearMap.mem_ker, ← hcomp, ht, map_zero]

/-- **The local criterion of flatness along an `H₁`-regular sequence.** A local homomorphism
essentially of finite presentation is flat as soon as the images of a finite family of the base
are `H₁`-regular, the ideal they generate is proper, and the induced map of quotients is flat. -/
private theorem flat_of_h1Regular_of_flat_quotient
    {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
    [Algebra A B] [IsLocalHom (algebraMap A B)]
    (hB : (algebraMap A B).EssentiallyOfFinitePresentation)
    {n : ℕ} (a : Fin n → A) (ha : Koszul.IsH1Regular (fun k => algebraMap A B (a k)))
    (hI : Ideal.span (Set.range a) ≠ ⊤)
    (hflat : Module.Flat (A ⧸ Ideal.span (Set.range a))
      (B ⧸ (Ideal.span (Set.range a) • (⊤ : Submodule A B)))) :
    Module.Flat A B := by
  let I := Ideal.span (Set.range a)
  have htor : Function.Injective (I.subtype.rTensor B) := by
    have he : I.subtype.rTensor B = (TensorProduct.comm A B A).toLinearMap ∘ₗ
        I.subtype.lTensor B ∘ₗ (TensorProduct.comm A I B).toLinearMap := by
      ext x b
      simp
    rw [he]
    exact (TensorProduct.comm A B A).injective.comp
      ((lTensor_subtype_span_injective_of_isH1Regular a ha).comp
        (TensorProduct.comm A I B).injective)
  exact Module.Flat.of_rTensor_subtype_injective_of_flat_quotient_of_essentiallyOfFinitePresentation
    B B hB I hI htor hflat

/-- A commutative square of rings whose two horizontal arrows are surjective, with matching
kernels and flat right-hand side, exhibits the quotient on the right as a flat algebra over the
quotient on the left. -/
private lemma flat_quotient_of_surjective_square
    {A B C D : Type*} [CommRing A] [CommRing B] [CommRing C] [CommRing D]
    [Algebra A B] (p : A →+* C) (hp : Function.Surjective p)
    (r : B →+* D) (hr : Function.Surjective r) (q : C →+* D) (hq : q.Flat)
    (hw : r.comp (algebraMap A B) = q.comp p)
    (hk : RingHom.ker r = Ideal.map (algebraMap A B) (RingHom.ker p)) :
    Module.Flat (A ⧸ RingHom.ker p)
      (B ⧸ (RingHom.ker p • (⊤ : Submodule A B))) := by
  let I := RingHom.ker p
  let e := RingHom.quotientKerEquivOfSurjective hp
  let : Algebra (A ⧸ I) C := e.toRingHom.toAlgebra
  let : Algebra C D := q.toAlgebra
  let : Algebra (A ⧸ I) D := (q.comp e.toRingHom).toAlgebra
  let : Algebra A D := (q.comp p).toAlgebra
  have : IsScalarTower (A ⧸ I) C D := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower A (A ⧸ I) D := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : Module.Flat (A ⧸ I) C := RingHom.Flat.of_bijective e.bijective
  have : Module.Flat C D := hq
  have : Module.Flat (A ⧸ I) D := Module.Flat.trans (A ⧸ I) C D
  let rA : B →ₐ[A] D := ⟨r, fun a => DFunLike.congr_fun hw a⟩
  have hker : rA.toLinearMap.ker = I • (⊤ : Submodule A B) := by
    rw [Ideal.smul_top_eq_map, ← hk]
    rfl
  let e' : (B ⧸ (I • (⊤ : Submodule A B))) ≃ₗ[A] D :=
    (Submodule.quotEquivOfEq _ _ hker.symm).trans
      (rA.toLinearMap.quotKerEquivOfSurjective hr)
  exact Module.Flat.of_linearEquiv
    (e'.extendScalarsOfSurjective Ideal.Quotient.mk_surjective)

/-! ### Étale charts to relative affine space -/

/-- A smooth morphism admits, near each point, an affine chart with an étale morphism to a
relative affine space over an affine open of the base. -/
private theorem exists_etale_affineSpace_chart_of_smooth {X S : Scheme.{u}}
    (f : X ⟶ S) [Smooth f] (x : X) :
    ∃ (V : S.Opens) (_hV : IsAffineOpen V) (_hxV : f x ∈ V)
      (d : ℕ) (U : X.Opens) (_hU : IsAffineOpen U) (_hxU : x ∈ U)
      (hUV : U ≤ f ⁻¹ᵁ V)
      (π : U.toScheme ⟶ AffineSpace (ULift.{u} (Fin d)) V.toScheme),
      Etale π ∧
        π ≫ (AffineSpace (ULift.{u} (Fin d)) V.toScheme ↘ V.toScheme) =
          f.resLE V U hUV := by
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, -⟩ :=
    S.isBasis_affineOpens.exists_subset_of_mem_open
      (Set.mem_univ (f x)) isOpen_univ
  obtain ⟨d, U, hU, hxU, hUV, π, hπ, hcomm⟩ :=
    AlgebraicGeometry.exists_affine_open_etale_affineSpace f x V hV hxV
      (InfinitesimalLifting.smoothAt_of_smooth f x)
  exact ⟨V, hV, hxV, d, U, hU, hxU, hUV, π, hπ, hcomm⟩

/-- Affine space over an open subscheme is an open subscheme of affine space, so the induced map
is étale. -/
private theorem etale_affineSpace_map_of_openImmersion {S T : Scheme.{u}}
    (j : S ⟶ T) [IsOpenImmersion j] (n : Type u) :
    Etale (AffineSpace.map n j) :=
  MorphismProperty.of_isPullback (AffineSpace.isPullback_map (n := n) j).flip inferInstance

/-- A smooth morphism admits, near each point, an affine chart with an étale morphism to a
relative affine space over the base itself. -/
private theorem exists_etale_affineSpace_chart_over {X S : Scheme.{u}}
    (f : X ⟶ S) [Smooth f] (x : X) :
    ∃ (d : ℕ) (U : X.Opens) (_ : IsAffineOpen U) (_ : x ∈ U)
      (π : U.toScheme ⟶ AffineSpace (ULift.{u} (Fin d)) S),
      Etale π ∧
        π ≫ (AffineSpace.over (ULift.{u} (Fin d)) S).hom = U.ι ≫ f := by
  obtain ⟨V, hV, hxV, d, U, hU, hxU, hUV, π, hπ, hcomm⟩ :=
    exists_etale_affineSpace_chart_of_smooth f x
  let ρ := AffineSpace.map (ULift.{u} (Fin d)) V.ι
  have : Etale ρ := etale_affineSpace_map_of_openImmersion V.ι (ULift.{u} (Fin d))
  refine ⟨d, U, hU, hxU, π ≫ ρ, inferInstance, ?_⟩
  calc
    π ≫ ρ ≫ (AffineSpace.over (ULift.{u} (Fin d)) S).hom =
        π ≫ (AffineSpace.over (ULift.{u} (Fin d)) V.toScheme).hom ≫ V.ι := by
      convert congrArg
        (fun k : AffineSpace (ULift.{u} (Fin d)) V.toScheme ⟶ S => π ≫ k)
        (AffineSpace.map_over (n := ULift.{u} (Fin d)) V.ι) using 1 <;> rfl
    _ = U.ι ≫ f := by
      convert (Scheme.Hom.resLE_comp_ι f hUV) using 1
      exact congrArg (fun k => k ≫ V.ι) hcomm

/-- A morphism to a relative affine space over a base, compatible with a morphism locally of
finite presentation to that base, is itself locally of finite presentation. -/
private theorem locallyOfFinitePresentation_of_affineSpace_over
    {X S : Scheme.{u}} {ι : Type u} [Finite ι] (f : X ⟶ S)
    [LocallyOfFinitePresentation f] (π : X ⟶ AffineSpace ι S)
    (hπ : π ≫ (AffineSpace.over ι S).hom = f) : LocallyOfFinitePresentation π := by
  have : LocallyOfFinitePresentation (π ≫ (AffineSpace.over ι S).hom) := by
    rw [hπ]
    infer_instance
  have : LocallyOfFiniteType (AffineSpace.over ι S).hom := by
    show LocallyOfFiniteType (AffineSpace ι S ↘ S)
    infer_instance
  exact AlgebraicGeometry.locallyOfFinitePresentation_of_comp π (AffineSpace.over ι S).hom

/-- An affine open neighbourhood of the image of a point whose inverse image lies inside a
prescribed open of the source of a closed immersion. -/
private theorem exists_affine_open_with_preimage_le {Y X : Scheme.{u}}
    (i : Y ⟶ X) [IsClosedImmersion i] (W : Y.Opens) (y : Y) (hy : y ∈ W) :
    ∃ U : X.Opens, IsAffineOpen U ∧ i y ∈ U ∧ i ⁻¹ᵁ U ≤ W := by
  obtain ⟨V, hV, hpre⟩ := i.isClosedEmbedding.isInducing.isOpen_iff.mp W.2
  have hxy : i y ∈ V := by
    show y ∈ i.base ⁻¹' V
    rw [hpre]
    exact hy
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxy hV
  let V' : X.Opens := ⟨V, hV⟩
  refine ⟨U, hU, hxU, ?_⟩
  calc
    i ⁻¹ᵁ U ≤ i ⁻¹ᵁ V' := fun z hz => hUV hz
    _ = W := by
      ext z
      show z ∈ i.base ⁻¹' V ↔ z ∈ W
      rw [hpre]
      rfl

/-- An étale chart of the source of a closed immersion, over the base, defined on the inverse
image of an affine open of the ambient scheme. -/
private theorem exists_affine_etale_chart_on_closed_source
    {Y X S : Scheme.{u}} (f : X ⟶ S) (i : Y ⟶ X) [IsClosedImmersion i]
    [Smooth f] [Smooth (i ≫ f)] (y : Y) :
    ∃ (m : ℕ) (U : X.Opens) (_ : IsAffineOpen U) (_ : i y ∈ U)
      (q : (i ⁻¹ᵁ U).toScheme ⟶ AffineSpace (ULift.{u} (Fin m)) S),
      Etale q ∧ q ≫ (AffineSpace.over (ULift.{u} (Fin m)) S).hom =
        (i ⁻¹ᵁ U).ι ≫ i ≫ f := by
  obtain ⟨m, W, hW, hyW, q₀, hq₀, hbase₀⟩ :=
    exists_etale_affineSpace_chart_over (i ≫ f) y
  obtain ⟨U, hU, hyU, hUW⟩ := exists_affine_open_with_preimage_le i W y hyW
  let V := i ⁻¹ᵁ U
  have hVW : V ≤ W := hUW
  let r : V.toScheme ⟶ W.toScheme := Y.homOfLE hVW
  let q : V.toScheme ⟶ AffineSpace (ULift.{u} (Fin m)) S := r ≫ q₀
  have hq : Etale q := inferInstance
  have hqbase : q ≫ (AffineSpace.over (ULift.{u} (Fin m)) S).hom = V.ι ≫ i ≫ f := by
    dsimp only [q]
    rw [Category.assoc, hbase₀, ← Category.assoc, Y.homOfLE_ι hVW]
  exact ⟨m, U, hU, hyU, q, hq, hqbase⟩

/-! ### The regular sequence cutting out the closed subscheme -/

/-- A closed immersion between schemes smooth over a base has a regular defining ideal sheaf on
every open of the ambient scheme. -/
@[ega "IV 17.12.1" "(a) ⇒ (c), special case",
  sga "1 II 4.15" "(i) ⇒ (ii)",
  sga "6 VII 1.10" "special case",
  sga "6 VIII 1.1" "partial"]
private theorem regularIdealSheaf_on_open_of_smooth_closed
    {Y X S : Scheme.{u}} (f : X ⟶ S) (i : Y ⟶ X) [IsClosedImmersion i]
    [Smooth f] [Smooth (i ≫ f)] (U : X.Opens) :
    IsRegularIdealSheaf U.toScheme.toLocallyRingedSpace.toRingedSpace
      (definingIdealOfHom (i.resLE U (i ⁻¹ᵁ U) le_rfl)) := by
  let : IsImmersion i := inferInstance
  let V := i ⁻¹ᵁ U
  let j := i ∣_ U
  have : IsClosedImmersion j := MorphismProperty.of_isPullback
    (AlgebraicGeometry.isPullback_morphismRestrict i U).flip inferInstance
  let i' : V.toScheme ⟶ X := V.ι ≫ i
  have : IsImmersion i' := inferInstance
  have : Smooth (i' ≫ f) := by
    show Smooth (V.ι ≫ (i ≫ f))
    infer_instance
  have hreg := Stacks.AlgebraicGeometry.isRegularImmersion_of_smooth_of_smooth i' f
  have hji : j ≫ U.ι = i' := by
    simpa only [i', V] using morphismRestrict_ι i U
  simpa [Scheme.Hom.resLE_eq_morphismRestrict] using
    (Stacks.AlgebraicGeometry.isRegularImmersion_iff_of_open i' U j hji).mp hreg

/-- Around every point of its source a closed immersion with regular defining ideal sheaf is cut
out, on an affine open, by an `H₁`-regular sequence of sections. -/
private theorem exists_affine_h1Regular_generators_of_closedImmersion
    {Z X : Scheme.{u}} (j : Z ⟶ X) [IsClosedImmersion j]
    (hj : IsRegularIdealSheaf X.toLocallyRingedSpace.toRingedSpace (definingIdealOfHom j))
    (z : Z) :
    ∃ (U : X.Opens) (_ : j z ∈ U) (_ : IsAffineOpen U) (r : ℕ) (a : Fin r → Γ(X, U)),
      RingHom.ker (j.app U).hom = Ideal.span (Set.range a) ∧ Koszul.IsH1Regular a := by
  have hkos := RegularIdealSheaf.isKoszulRegularIdealSheaf_of_isRegularIdealSheaf
    X.toLocallyRingedSpace.toRingedSpace (definingIdealOfHom j) hj
  obtain ⟨U, hzU, r, a, hker, hreg⟩ :=
    (AlgebraicGeometry.isKoszulRegularIdealSheaf_iff_kerGeneratedBy j).mp hkos (j z)
      (subset_closure (Set.mem_range_self z))
  exact ⟨U.1, hzU, U.2, r, a, hker, hreg.isH1Regular⟩

/-- Sections of a closed subscheme lift to sections of an affine ambient scheme. -/
private theorem exists_sections_lift_of_closedImmersion_affine
    {Y X : Scheme.{u}} (i : Y ⟶ X) [IsClosedImmersion i] [IsAffine X]
    {ι : Type*} (g : ι → Γ(Y, ⊤)) :
    ∃ g' : ι → Γ(X, ⊤), ∀ j, i.appTop (g' j) = g j := by
  have hsurj : Function.Surjective i.appTop :=
    (IsClosedImmersion.isAffine_surjective_of_isAffine i).2
  classical
  exact ⟨fun j => Classical.choose (hsurj (g j)), fun j => Classical.choose_spec (hsurj (g j))⟩

/-- The kernel of a closed immersion on the sections of an affine open, transported to the
sections of the corresponding open subscheme. -/
private theorem span_eq_ker_resLE_appTop_of_ker_app_eq_span {Y X : Scheme.{u}}
    (i : Y ⟶ X) (U : X.Opens) {n : ℕ} (a : Fin n → Γ(X, U))
    (hker : RingHom.ker (i.app U).hom = Ideal.span (Set.range a)) :
    Ideal.span (Set.range fun k => U.topIso.inv (a k)) =
      RingHom.ker (i.resLE U (i ⁻¹ᵁ U) le_rfl).appTop.hom := by
  rw [Scheme.Hom.appTop, Scheme.Hom.resLE_app_top, ← Category.assoc, CommRingCat.hom_comp,
    RingHom.ker_comp_of_injective _ (ConcreteCategory.bijective_of_isIso _).1,
    Scheme.Hom.appLE_eq_app, CommRingCat.hom_comp, ← RingHom.comap_ker, hker]
  let e := U.topIso.symm.commRingCatIsoToRingEquiv
  show Ideal.span (Set.range fun k => e (a k)) =
    Ideal.comap e.symm (Ideal.span (Set.range a))
  rw [← Ideal.map_comap_of_equiv e, Ideal.map_span]
  congr 1
  exact Set.range_comp e a

/-! ### The coordinate subspace of relative affine space -/

/-- The standard inclusion of relative affine `m`-space into relative affine `(m + n)`-space, with
the last `n` coordinates zero. -/
noncomputable def coordinateSubspaceEmbedding (S : Scheme.{u}) (m n : ℕ) :
    AffineSpace (ULift.{u} (Fin m)) S ⟶ AffineSpace (ULift.{u} (Fin (m + n))) S :=
  AffineSpace.homOfVector
    (AffineSpace.over (ULift.{u} (Fin m)) S).hom
    (fun i => Fin.addCases
      (fun j => AffineSpace.coord S (ULift.up j))
      (fun _ => 0) i.down)

/-- The coordinate embedding pulls the `j`-th of the first `m` coordinates back to the `j`-th
coordinate. -/
theorem coordinateSubspaceEmbedding_firstCoordinate (S : Scheme.{u}) (m n : ℕ)
    (j : Fin m) :
    (coordinateSubspaceEmbedding S m n).appTop
      (AffineSpace.coord S (ULift.up (Fin.castAdd n j))) =
        AffineSpace.coord S (ULift.up j) := by
  simp [coordinateSubspaceEmbedding]

/-- The coordinate embedding pulls each of the last `n` coordinates back to zero. -/
theorem coordinateSubspaceEmbedding_lastCoordinate (S : Scheme.{u}) (m n : ℕ)
    (j : Fin n) :
    (coordinateSubspaceEmbedding S m n).appTop
      (AffineSpace.coord S (ULift.up (Fin.natAdd m j))) = 0 := by
  simp [coordinateSubspaceEmbedding]

/-- The coordinate subspace is a closed subscheme of relative affine space. -/
theorem coordinateSubspaceEmbedding_isClosedImmersion (S : Scheme.{u}) (m n : ℕ) :
    IsClosedImmersion (coordinateSubspaceEmbedding S m n) := by
  let : (AffineSpace (ULift (Fin m)) S).CanonicallyOver S :=
    AffineSpace.over (ULift (Fin m)) S
  let : (AffineSpace (ULift (Fin (m + n))) S).CanonicallyOver S :=
    AffineSpace.over (ULift (Fin (m + n))) S
  let p : AffineSpace (ULift (Fin (m + n))) S ⟶ AffineSpace (ULift (Fin m)) S :=
    AffineSpace.reindex (fun i : ULift (Fin m) => ULift.up (Fin.castAdd n i.down)) S
  let : p.IsOver S := ⟨AffineSpace.reindex_over
    (fun i : ULift (Fin m) => ULift.up (Fin.castAdd n i.down)) S⟩
  have : (coordinateSubspaceEmbedding S m n).IsOver S := by
    apply (Scheme.Hom.isOver_iff (S := S)).2
    rw [coordinateSubspaceEmbedding]
    show (AffineSpace.homOfVector
        ((AffineSpace.over (ULift (Fin m)) S).hom)
        (fun i : ULift (Fin (m + n)) =>
          Fin.addCases (fun j => AffineSpace.coord S (ULift.up j))
            (fun _ => 0) i.down)) ≫
        (AffineSpace.over (ULift (Fin (m + n))) S).hom =
      (AffineSpace.over (ULift (Fin m)) S).hom
    unfold AffineSpace.homOfVector
    exact pullback.lift_fst _ _ _
  have hcomp : coordinateSubspaceEmbedding S m n ≫ p = 𝟙 _ := by
    let φ : {g : AffineSpace (ULift (Fin m)) S ⟶ AffineSpace (ULift (Fin m)) S //
        g.IsOver S} := ⟨coordinateSubspaceEmbedding S m n ≫ p, inferInstance⟩
    let ψ : {g : AffineSpace (ULift (Fin m)) S ⟶ AffineSpace (ULift (Fin m)) S //
        g.IsOver S} := ⟨𝟙 _, inferInstance⟩
    have hφψ : φ = ψ := by
      apply (AffineSpace.homOverEquiv S).injective
      funext i
      show (coordinateSubspaceEmbedding S m n ≫ p).appTop
          (AffineSpace.coord S i) = AffineSpace.coord S i
      rw [Scheme.Hom.comp_appTop]
      simp [p, coordinateSubspaceEmbedding, AffineSpace.reindex_appTop_coord,
        AffineSpace.homOfVector_appTop_coord]
    exact congrArg Subtype.val hφψ
  have : IsAffineHom p := by
    apply AlgebraicGeometry.isAffineHom_of_forall_exists_isAffineOpen
    intro x
    let overTarget := (AffineSpace (ULift (Fin m)) S ↘ S)
    let overSource := (AffineSpace (ULift (Fin (m + n))) S ↘ S)
    have hOT : IsAffineHom (AffineSpace (ULift (Fin m)) S ↘ S) := inferInstance
    have hOS : IsAffineHom (AffineSpace (ULift (Fin (m + n))) S ↘ S) := inferInstance
    obtain ⟨_, ⟨V, hV, rfl⟩, hxV, _⟩ :=
      S.isBasis_affineOpens.exists_subset_of_mem_open
        (Set.mem_univ (overTarget x)) isOpen_univ
    let W := overTarget ⁻¹ᵁ V
    refine ⟨W, hxV, ?_, ?_⟩
    · let : IsAffineHom overTarget := hOT
      exact IsAffineOpen.preimage (f := overTarget) hV
    · have hpre : p ⁻¹ᵁ W = overSource ⁻¹ᵁ V := by
        show ((AffineSpace.reindex
          (fun i : ULift (Fin m) => ULift.up (Fin.castAdd n i.down)) S) ≫
            (AffineSpace (ULift (Fin m)) S ↘ S)) ⁻¹ᵁ V =
          (AffineSpace (ULift (Fin (m + n))) S ↘ S) ⁻¹ᵁ V
        rw [AffineSpace.reindex_over]
      rw [hpre]
      let : IsAffineHom overSource := hOS
      exact IsAffineOpen.preimage (f := overSource) hV
  let : IsSeparated p := inferInstance
  have : IsClosedImmersion (coordinateSubspaceEmbedding S m n ≫ p) := by
    rw [hcomp]
    infer_instance
  exact IsClosedImmersion.of_comp _ p

/-- Transporting a stalk map along an equality of points. -/
private lemma stalkMap_stalkCongr {X Y : Scheme.{u}} (f : X ⟶ Y)
    {x x' : X} (h : x = x') :
    f.stalkMap x ≫ (X.presheaf.stalkCongr (.of_eq h)).hom =
      (Y.presheaf.stalkCongr (.of_eq (congrArg f h))).hom ≫ f.stalkMap x' := by
  subst x'
  simp

/-- **The kernel of a stalk map is contained in the kernel of any local-ring-valued point that
factors through the morphism.** If `i : X ⟶ Y` is injective on points and the local-ring-valued
point `φ : 𝒪_{Y, i x} ⟶ R` has its associated morphism `Spec R ⟶ Y` factoring through `i`, then
the kernel of `i` on local rings is contained in the kernel of `φ`. -/
private lemma ker_stalkMap_le_ker_of_specTo
    {X Y : Scheme.{u}} (i : X ⟶ Y) (hi : Function.Injective i) (x : X)
    (R : CommRingCat.{u}) (hR : IsLocalRing R) (φ : Y.presheaf.stalk (i x) ⟶ R)
    (hφ : IsLocalHom φ.hom) (q : Spec R ⟶ X)
    (hq : q ≫ i = Spec.map φ ≫ Y.fromSpecStalk (i x)) :
    RingHom.ker (i.stalkMap x).hom ≤ RingHom.ker φ.hom := by
  have he : i (q (IsLocalRing.closedPoint R)) = i x := by
    have h := congrArg (fun f => f (IsLocalRing.closedPoint R)) hq
    change i (q (IsLocalRing.closedPoint R)) =
      Y.fromSpecStalk (i x) (Spec.map φ (IsLocalRing.closedPoint R)) at h
    rw [Spec_closedPoint, Scheme.fromSpecStalk_closedPoint] at h
    exact h
  have hx : x = q (IsLocalRing.closedPoint R) := (hi he).symm
  have hrep : (SpecToEquivOfLocalRing Y R) (q ≫ i) = ⟨i x, φ, inferInstance⟩ := by
    rw [hq]
    exact (SpecToEquivOfLocalRing Y R).apply_symm_apply ⟨i x, φ, inferInstance⟩
  obtain ⟨hpt0, hr0⟩ := SpecToEquivOfLocalRing_eq_iff.mp hrep
  have hpt : i (q (IsLocalRing.closedPoint R)) = i x := hpt0
  have hr : Scheme.stalkClosedPointTo (q ≫ i) =
      (Y.presheaf.stalkCongr (.of_eq hpt)).hom ≫ φ := hr0
  have hcc : (Y.presheaf.stalkCongr (.of_eq hpt)).hom ≫ φ =
      i.stalkMap (q (IsLocalRing.closedPoint R)) ≫ Scheme.stalkClosedPointTo q :=
    hr.symm.trans (Scheme.stalkClosedPointTo_comp q i)
  have hc : φ = (Y.presheaf.stalkCongr (.of_eq hpt)).inv ≫
      (i.stalkMap (q (IsLocalRing.closedPoint R)) ≫ Scheme.stalkClosedPointTo q) :=
    (Iso.eq_inv_comp _).mpr hcc
  have hm : (Y.presheaf.stalkCongr (.of_eq hpt)).inv ≫
      i.stalkMap (q (IsLocalRing.closedPoint R)) =
      i.stalkMap x ≫ (X.presheaf.stalkCongr (.of_eq hx)).hom := by
    simpa only [TopCat.Presheaf.stalkCongr_inv, TopCat.Presheaf.stalkCongr_hom] using
      (stalkMap_stalkCongr i hx).symm
  have hc2 : φ = i.stalkMap x ≫ ((X.presheaf.stalkCongr (.of_eq hx)).hom ≫
      Scheme.stalkClosedPointTo q) :=
    hc.trans (((Category.assoc _ _ _).symm.trans
      (congrArg (fun k => k ≫ Scheme.stalkClosedPointTo q) hm)).trans (Category.assoc _ _ _))
  intro a ha
  show φ a = 0
  rw [hc2]
  show Scheme.stalkClosedPointTo q
    ((X.presheaf.stalkCongr (.of_eq hx)).hom ((i.stalkMap x) a)) = 0
  rw [show (i.stalkMap x) a = 0 from ha, map_zero, map_zero]

/-- The kernel of the coordinate embedding on local rings is generated by the germs of the last
`n` coordinates. -/
private lemma coordinateSubspaceEmbedding_ker_stalkMap (S : Scheme.{u}) (m n : ℕ)
    [IsClosedImmersion (coordinateSubspaceEmbedding S m n)]
    (b : AffineSpace (ULift.{u} (Fin m)) S) :
    RingHom.ker ((coordinateSubspaceEmbedding S m n).stalkMap b).hom =
      Ideal.span (Set.range fun k : Fin n =>
        (AffineSpace (ULift.{u} (Fin (m + n))) S).presheaf.germ ⊤
          (coordinateSubspaceEmbedding S m n b) (Opens.mem_top _)
          (AffineSpace.coord S (ULift.up (Fin.natAdd m k)))) := by
  let X := AffineSpace (ULift.{u} (Fin (m + n))) S
  let Y := AffineSpace (ULift.{u} (Fin m)) S
  let j := coordinateSubspaceEmbedding S m n
  let R := X.presheaf.stalk (j b)
  let a (k : Fin n) : R := X.presheaf.germ ⊤ (j b) (Opens.mem_top _)
    (AffineSpace.coord S (ULift.up (Fin.natAdd m k)))
  let I := Ideal.span (Set.range a)
  have hI : I ≤ RingHom.ker (j.stalkMap b).hom := by
    apply Ideal.span_le.mpr
    rintro _ ⟨k, rfl⟩
    show j.stalkMap b (X.presheaf.germ ⊤ (j b) (Opens.mem_top _)
      (AffineSpace.coord S (ULift.up (Fin.natAdd m k)))) = 0
    rw [Scheme.Hom.germ_stalkMap_apply]
    show Y.presheaf.germ ⊤ b (Opens.mem_top _)
      (j.appTop (AffineSpace.coord S (ULift.up (Fin.natAdd m k)))) = 0
    rw [coordinateSubspaceEmbedding_lastCoordinate, map_zero]
  apply le_antisymm _ hI
  have hinj : Function.Injective j := j.isEmbedding.injective
  have hproper : I ≠ ⊤ := ne_top_of_le_ne_top (RingHom.ker_ne_top _) hI
  have hnt : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hproper
  have hloc : IsLocalRing (R ⧸ I) := IsLocalRing.of_surjective'
    (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  let φ : R ⟶ CommRingCat.of (R ⧸ I) := CommRingCat.ofHom (Ideal.Quotient.mk I)
  have hlocφ : IsLocalHom φ.hom :=
    IsLocalHom.of_surjective φ.hom Ideal.Quotient.mk_surjective
  let t : Spec (.of (R ⧸ I)) ⟶ X := Spec.map φ ≫ X.fromSpecStalk (j b)
  let q : Spec (.of (R ⧸ I)) ⟶ Y := AffineSpace.homOfVector
    (t ≫ (AffineSpace.over (ULift.{u} (Fin (m + n))) S).hom)
    (fun k => t.appTop (AffineSpace.coord S (ULift.up (Fin.castAdd n k.down))))
  have hq : q ≫ j = Spec.map φ ≫ X.fromSpecStalk (j b) := by
    show q ≫ j = t
    apply AffineSpace.hom_ext
    · show (q ≫ coordinateSubspaceEmbedding S m n) ≫
        (AffineSpace (ULift.{u} (Fin (m + n))) S ↘ S) = _
      rw [Category.assoc, coordinateSubspaceEmbedding, AffineSpace.homOfVector_over]
      show q ≫ (AffineSpace (ULift.{u} (Fin m)) S ↘ S) = _
      exact AffineSpace.homOfVector_over _ _
    · rintro ⟨k⟩
      induction k using Fin.addCases with
      | left k =>
        show q.appTop (j.appTop (AffineSpace.coord S (ULift.up (Fin.castAdd n k)))) = _
        rw [coordinateSubspaceEmbedding_firstCoordinate]
        exact AffineSpace.homOfVector_appTop_coord _ _ _
      | right k =>
        show q.appTop (j.appTop (AffineSpace.coord S (ULift.up (Fin.natAdd m k)))) = _
        rw [coordinateSubspaceEmbedding_lastCoordinate, map_zero]
        show 0 = t.appTop (AffineSpace.coord S (ULift.up (Fin.natAdd m k)))
        have ht : t.appTop = X.presheaf.germ ⊤ (j b) (Opens.mem_top _) ≫ φ ≫
            (Scheme.ΓSpecIso (.of (R ⧸ I))).inv := by
          have hfrom : (X.fromSpecStalk (j b)).appTop =
              X.presheaf.germ ⊤ (j b) (Opens.mem_top _) ≫ (Scheme.ΓSpecIso R).inv := by
            rw [Scheme.fromSpecStalk_appTop]
            show X.presheaf.germ ⊤ (j b) (Opens.mem_top _) ≫ (Scheme.ΓSpecIso R).inv ≫
              (Spec R).presheaf.map (𝟙 _) = _
            rw [CategoryTheory.Functor.map_id, Category.comp_id]
          show (Spec.map φ ≫ X.fromSpecStalk (j b)).appTop = _
          rw [Scheme.Hom.comp_appTop, hfrom, Category.assoc,
            ← Scheme.ΓSpecIso_inv_naturality]
        rw [ht]
        show 0 = (Scheme.ΓSpecIso (.of (R ⧸ I))).inv (Ideal.Quotient.mk I (a k))
        rw [(Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span (Set.mem_range_self k)),
          map_zero]
  intro s hs
  have hmem : s ∈ RingHom.ker (Ideal.Quotient.mk I) :=
    ker_stalkMap_le_ker_of_specTo j hinj b (CommRingCat.of (R ⧸ I)) hloc φ hlocφ q hq hs
  rwa [Ideal.mk_ker] at hmem

/-! ### Flatness of the chart -/

/-- A stalk map transported along an equality of morphisms. -/
private lemma stalkMap_congr_hom {X Y : Scheme.{u}} {f g : X ⟶ Y}
    (h : f = g) (x : X) :
    f.stalkMap x = (Y.presheaf.stalkCongr (.of_eq (congrArg (fun k => k x) h))).hom ≫
      g.stalkMap x := by
  subst g
  simp

/-- A commutative square of schemes induces a commutative square of local rings. -/
private lemma stalkMap_square
    {V U B A : Scheme.{u}} {i : V ⟶ U} {q : V ⟶ B} {π : U ⟶ A} {j : B ⟶ A}
    (h : i ≫ π = q ≫ j) (v : V) (he : j (q v) = π (i v)) :
    (A.presheaf.stalkCongr (.of_eq he)).hom ≫ π.stalkMap (i v) ≫ i.stalkMap v =
      j.stalkMap (q v) ≫ q.stalkMap v := by
  have ht : (q ≫ j).stalkMap v =
      (A.presheaf.stalkCongr (.of_eq he)).hom ≫ (i ≫ π).stalkMap v :=
    stalkMap_congr_hom h.symm v
  rw [Scheme.Hom.stalkMap_comp, Scheme.Hom.stalkMap_comp] at ht
  exact ht.symm

/-- **The local criterion applied to a cartesian square.** In a cartesian square whose two closed
immersions have `H₁`-regular generators for the kernel of the right-hand one, and whose left-hand
vertical map is flat, the right-hand vertical map is flat on local rings. -/
private lemma flat_stalkMap_of_isPullback_of_isH1Regular
    {V U B A : Scheme.{u}} {i : V ⟶ U} {q : V ⟶ B} {π : U ⟶ A} {j : B ⟶ A}
    [IsClosedImmersion i] [IsClosedImmersion j] [Flat q] [LocallyOfFinitePresentation π]
    (h : IsPullback i q π j) (v : V) {n : ℕ}
    (a : Fin n → A.presheaf.stalk (j (q v)))
    (hker : RingHom.ker (j.stalkMap (q v)).hom = Ideal.span (Set.range a))
    (hreg : Koszul.IsH1Regular (fun k =>
      ((A.presheaf.stalkCongr (.of_eq (congrArg (fun f => f v) h.w.symm))).hom ≫
        π.stalkMap (i v)) (a k))) :
    (π.stalkMap (i v)).hom.Flat := by
  have he : j (q v) = π (i v) := congrArg (fun f => f v) h.w.symm
  let e : A.presheaf.stalk (j (q v)) ≅ A.presheaf.stalk (π (i v)) :=
    A.presheaf.stalkCongr (.of_eq he)
  let φ : A.presheaf.stalk (j (q v)) ⟶ U.presheaf.stalk (i v) :=
    e.hom ≫ π.stalkMap (i v)
  let : Algebra (A.presheaf.stalk (j (q v))) (U.presheaf.stalk (i v)) :=
    φ.hom.toAlgebra
  have : IsLocalHom (algebraMap (A.presheaf.stalk (j (q v))) (U.presheaf.stalk (i v))) := by
    show IsLocalHom φ.hom
    dsimp only [φ, CommRingCat.hom_comp]
    infer_instance
  have hw : (i.stalkMap v).hom.comp (algebraMap _ _) =
      (q.stalkMap v).hom.comp (j.stalkMap (q v)).hom := by
    have hs := stalkMap_square h.w v he
    rw [← Category.assoc] at hs
    exact congrArg CommRingCat.Hom.hom hs
  have hk : RingHom.ker (i.stalkMap v).hom =
      Ideal.map (algebraMap (A.presheaf.stalk (j (q v))) (U.presheaf.stalk (i v)))
        (RingHom.ker (j.stalkMap (q v)).hom) :=
    Stacks.Flatness.ker_stalkMap_of_isPullback h v he
  have hquot := flat_quotient_of_surjective_square (j.stalkMap (q v)).hom
    (j.stalkMap_surjective _) (i.stalkMap v).hom (i.stalkMap_surjective _)
    (q.stalkMap v).hom (Flat.stalkMap q v) hw hk
  have hefp : e.hom.hom.EssentiallyOfFinitePresentation := by
    let := e.hom.hom.toAlgebra
    have : Algebra.FinitePresentation (A.presheaf.stalk (j (q v)))
        (A.presheaf.stalk (π (i v))) :=
      RingHom.FinitePresentation.of_bijective (ConcreteCategory.bijective_of_isIso e.hom)
    have : IsLocalization (⊥ : Submonoid (A.presheaf.stalk (π (i v))))
        (A.presheaf.stalk (π (i v))) := IsLocalization.self bot_le
    exact RingHom.EssentiallyOfFinitePresentation.of_isLocalization
      (C := A.presheaf.stalk (π (i v))) ⊥
  have hfp : φ.hom.EssentiallyOfFinitePresentation :=
    essFinitePresentation_comp hefp
      (LocallyOfFinitePresentation.essentiallyOfFinitePresentation_stalkMap π (i v))
  rw [hker] at hquot
  have hflat : φ.hom.Flat := flat_of_h1Regular_of_flat_quotient hfp a hreg
    (hker ▸ RingHom.ker_ne_top _) hquot
  exact (RingHom.Flat.comp_iff_of_bijective_right
    (ConcreteCategory.bijective_of_isIso e.hom)).mp hflat

/-- Germs are compatible with the transport along an equality of points. -/
private lemma germ_stalkCongr_top (X : Scheme.{u}) {x y : X} (h : x = y)
    (s : Γ(X, ⊤)) :
    (X.presheaf.stalkCongr (.of_eq h)).hom (X.presheaf.germ ⊤ x (Opens.mem_top _) s) =
      X.presheaf.germ ⊤ y (Opens.mem_top _) s := by
  subst y
  simp

/-- In a cartesian coordinate chart whose last `n` coordinates pull back to an `H₁`-regular
sequence of sections, the chart is flat on local rings at the points of the closed subscheme. -/
private lemma flat_stalkMap_coordinateChart_of_isH1Regular
    {V U S : Scheme.{u}} [IsAffine U] (i : V ⟶ U) [IsClosedImmersion i]
    (m n : ℕ) (π : U ⟶ AffineSpace (ULift.{u} (Fin (m + n))) S)
    (q : V ⟶ AffineSpace (ULift.{u} (Fin m)) S)
    [Etale q] [LocallyOfFinitePresentation π]
    (h : IsPullback i q π (coordinateSubspaceEmbedding S m n)) (v : V)
    (ha : Koszul.IsH1Regular (fun k : Fin n =>
      π.appTop (AffineSpace.coord S (ULift.up (Fin.natAdd m k))))) :
    (π.stalkMap (i v)).hom.Flat := by
  have : IsClosedImmersion (coordinateSubspaceEmbedding S m n) :=
    coordinateSubspaceEmbedding_isClosedImmersion S m n
  let X := AffineSpace (ULift.{u} (Fin (m + n))) S
  let a (k : Fin n) : X.presheaf.stalk (coordinateSubspaceEmbedding S m n (q v)) :=
    X.presheaf.germ ⊤ _ (Opens.mem_top _) (AffineSpace.coord S (ULift.up (Fin.natAdd m k)))
  apply flat_stalkMap_of_isPullback_of_isH1Regular h v a
    (coordinateSubspaceEmbedding_ker_stalkMap S m n (q v))
  have hh' := AlgebraicGeometry.isH1Regular_of_ringHomFlat
    (U.presheaf.germ ⊤ (i v) (Opens.mem_top _)).hom
    (RegularIdealSheaf.germ_flat ⊤ (isAffineOpen_top U) (i v) (Opens.mem_top _)) _ ha
  convert hh' using 1
  funext k
  show (π.stalkMap (i v))
    ((X.presheaf.stalkCongr (.of_eq (show coordinateSubspaceEmbedding S m n (q v) = π (i v)
      from congrArg (fun f => f v) h.w.symm))).hom
      (X.presheaf.germ ⊤ _ (Opens.mem_top _) (AffineSpace.coord S (ULift.up (Fin.natAdd m k))))) = _
  rw [germ_stalkCongr_top X (show coordinateSubspaceEmbedding S m n (q v) = π (i v)
    from congrArg (fun f => f v) h.w.symm)]
  exact Scheme.Hom.germ_stalkMap_apply π ⊤ (i v) (Opens.mem_top _) _

/-! ### Building the cartesian coordinate chart -/

/-- The morphism to relative affine `(m + n)`-space with prescribed coordinates. -/
@[ega "IV 17.11.3"]
private noncomputable def coordinateChartMap {U S : Scheme.{u}}
    (p : U ⟶ S) (m n : ℕ) (g : Fin m → Γ(U, ⊤)) (h : Fin n → Γ(U, ⊤)) :
    U ⟶ AffineSpace (ULift.{u} (Fin (m + n))) S :=
  AffineSpace.homOfVector p (fun i => Fin.addCases g h i.down)

/-- The coordinate chart makes the square with a prescribed chart of the closed subscheme
commute, provided the first `m` coordinates restrict to the chart and the last `n` die. -/
private theorem coordinateChartMap_comp_eq {Y U S : Scheme.{u}} (i : Y ⟶ U)
    (p : U ⟶ S) (m n : ℕ) (g : Fin m → Γ(U, ⊤)) (h : Fin n → Γ(U, ⊤))
    (q : Y ⟶ AffineSpace (ULift.{u} (Fin m)) S)
    (hq : ∀ j, i.appTop (g j) = q.appTop (AffineSpace.coord S (ULift.up j)))
    (hh : ∀ k, i.appTop (h k) = 0)
    (hbase : q ≫ (AffineSpace.over (ULift.{u} (Fin m)) S).hom = i ≫ p) :
    i ≫ coordinateChartMap p m n g h = q ≫ coordinateSubspaceEmbedding S m n := by
  apply AffineSpace.hom_ext
  · simp [coordinateChartMap, coordinateSubspaceEmbedding, hbase]
  · intro z
    cases z with
    | up z =>
      induction z using Fin.addCases with
      | left j =>
        show i.appTop ((coordinateChartMap p m n g h).appTop
          (AffineSpace.coord S (ULift.up (Fin.castAdd n j)))) =
          q.appTop ((coordinateSubspaceEmbedding S m n).appTop
            (AffineSpace.coord S (ULift.up (Fin.castAdd n j))))
        rw [coordinateChartMap, AffineSpace.homOfVector_appTop_coord,
          Fin.addCases_left, coordinateSubspaceEmbedding_firstCoordinate]
        exact hq j
      | right k =>
        show i.appTop ((coordinateChartMap p m n g h).appTop
          (AffineSpace.coord S (ULift.up (Fin.natAdd m k)))) =
          q.appTop ((coordinateSubspaceEmbedding S m n).appTop
            (AffineSpace.coord S (ULift.up (Fin.natAdd m k))))
        rw [coordinateChartMap, AffineSpace.homOfVector_appTop_coord,
          Fin.addCases_right, coordinateSubspaceEmbedding_lastCoordinate, map_zero]
        exact hh k

/-- The first `m` coordinates of a chart of the closed subscheme lift to the affine ambient
scheme, giving a commuting coordinate square. -/
private theorem exists_affine_coordinateChartMap_extending
    {Y X S : Scheme.{u}} (i : Y ⟶ X) [IsClosedImmersion i] [IsAffine X]
    (p : X ⟶ S) (m n : ℕ)
    (q : Y ⟶ AffineSpace (ULift.{u} (Fin m)) S)
    (hbase : q ≫ (AffineSpace.over (ULift.{u} (Fin m)) S).hom = i ≫ p)
    (h : Fin n → Γ(X, ⊤)) (hh : ∀ k, i.appTop (h k) = 0) :
    ∃ g : Fin m → Γ(X, ⊤),
      (∀ j, i.appTop (g j) =
        q.appTop (AffineSpace.coord S (ULift.up j))) ∧
      i ≫ coordinateChartMap p m n g h = q ≫ coordinateSubspaceEmbedding S m n := by
  obtain ⟨g, hg⟩ := exists_sections_lift_of_closedImmersion_affine i
    (fun j => q.appTop (AffineSpace.coord S (ULift.up j)))
  exact ⟨g, hg, coordinateChartMap_comp_eq i p m n g h q hg hh hbase⟩

/-- **Equations generating the kernel identify the closed subscheme with the inverse image of the
coordinate subspace.** -/
private theorem coordinateChartMap_isPullback_of_span_eq_ker
    {Y X S : Scheme.{u}} (i : Y ⟶ X) [IsClosedImmersion i] [IsAffine X]
    (p : X ⟶ S) (m n : ℕ) (g : Fin m → Γ(X, ⊤)) (h : Fin n → Γ(X, ⊤))
    (q : Y ⟶ AffineSpace (ULift.{u} (Fin m)) S)
    (hcomm : i ≫ coordinateChartMap p m n g h = q ≫ coordinateSubspaceEmbedding S m n)
    (hker : Ideal.span (Set.range h) = RingHom.ker i.appTop.hom) :
    IsPullback i q (coordinateChartMap p m n g h) (coordinateSubspaceEmbedding S m n) := by
  have : IsClosedImmersion (coordinateSubspaceEmbedding S m n) :=
    coordinateSubspaceEmbedding_isClosedImmersion S m n
  apply IsPullback.of_isLimit (c := PullbackCone.mk i q hcomm)
  apply PullbackCone.isLimitAux' (PullbackCone.mk i q hcomm)
  intro s
  have hk : i.ker ≤ s.fst.ker := by
    have hk' : RingHom.ker i.appTop.hom ≤ RingHom.ker s.fst.appTop.hom := by
      rw [← hker]
      apply Ideal.span_le.mpr
      rintro _ ⟨k, rfl⟩
      show s.fst.appTop (h k) = 0
      have he := congrArg
        (fun a => a.appTop (AffineSpace.coord S (ULift.up (Fin.natAdd m k))))
        s.condition
      simpa only [Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
        coordinateChartMap, AffineSpace.homOfVector_appTop_coord,
        Fin.addCases_right, coordinateSubspaceEmbedding_lastCoordinate, map_zero,
        RingHom.mem_ker] using he
    rw [Scheme.ker_of_isAffine i, Scheme.ker_of_isAffine s.fst]
    exact (Scheme.IdealSheafData.equivOfIsAffine (X := X)).symm.toOrderIso.monotone hk'
  let l := IsClosedImmersion.lift i s.fst hk
  have hl : l ≫ i = s.fst := IsClosedImmersion.lift_fac i s.fst hk
  refine ⟨l, hl, ?_, ?_⟩
  · show l ≫ q = s.snd
    apply (cancel_mono (coordinateSubspaceEmbedding S m n)).mp
    rw [Category.assoc, ← hcomm, ← Category.assoc, hl, s.condition]
  · intro a ha _
    exact (cancel_mono i).mp (ha.trans hl.symm)

/-- The restriction of a morphism to the inverse image of an open is cartesian. -/
private theorem isPullback_resLE_ι {Y X : Scheme.{u}} (i : Y ⟶ X) (U : X.Opens) :
    IsPullback (i.resLE U (i ⁻¹ᵁ U) le_rfl) (i ⁻¹ᵁ U).ι U.ι i := by
  simpa only [Scheme.Hom.resLE_eq_morphismRestrict] using isPullback_morphismRestrict i U

/-- The restriction of a closed immersion to the inverse image of an open is a closed
immersion. -/
private theorem isClosedImmersion_resLE {Y X : Scheme.{u}} (i : Y ⟶ X) [IsClosedImmersion i]
    (U : X.Opens) : IsClosedImmersion (i.resLE U (i ⁻¹ᵁ U) le_rfl) :=
  MorphismProperty.of_isPullback (isPullback_resLE_ι i U).flip inferInstance

/-- **Lifting the tangential coordinates and adjoining generators of the ideal gives a cartesian
coordinate diagram over the base.** -/
private theorem exists_coordinate_diagram_of_ker_app_eq_span
    {Y X S : Scheme.{u}} (i : Y ⟶ X) [IsClosedImmersion i] (p : X ⟶ S)
    (U : X.Opens) (hU : IsAffineOpen U) (m n : ℕ)
    (a : Fin n → Γ(X, U))
    (hker : RingHom.ker (i.app U).hom = Ideal.span (Set.range a))
    (q : Y ⟶ AffineSpace (ULift.{u} (Fin m)) S)
    (hq : q ≫ (AffineSpace.over (ULift.{u} (Fin m)) S).hom = i ≫ p) :
    ∃ π : U.toScheme ⟶ AffineSpace (ULift.{u} (Fin (m + n))) S,
      π ≫ (AffineSpace.over (ULift.{u} (Fin (m + n))) S).hom = U.ι ≫ p ∧
      IsPullback (i.resLE U (i ⁻¹ᵁ U) le_rfl) ((i ⁻¹ᵁ U).ι ≫ q) π
        (coordinateSubspaceEmbedding S m n) ∧
      ∀ k : Fin n, π.appTop (AffineSpace.coord S (ULift.up (Fin.natAdd m k))) =
        U.topIso.inv (a k) := by
  let j := i.resLE U (i ⁻¹ᵁ U) le_rfl
  have := isClosedImmersion_resLE i U
  let : IsAffine U.toScheme := hU
  let h : Fin n → Γ(U.toScheme, ⊤) := fun k => U.topIso.inv (a k)
  have hk : Ideal.span (Set.range h) = RingHom.ker j.appTop.hom :=
    span_eq_ker_resLE_appTop_of_ker_app_eq_span i U a hker
  have hh (k) : j.appTop (h k) = 0 := by
    show h k ∈ RingHom.ker j.appTop.hom
    rw [← hk]
    exact Ideal.subset_span (Set.mem_range_self k)
  have hbase : ((i ⁻¹ᵁ U).ι ≫ q) ≫
      (AffineSpace.over (ULift.{u} (Fin m)) S).hom = j ≫ (U.ι ≫ p) := by
    rw [Category.assoc, hq, ← Category.assoc, ← Category.assoc]
    exact congrArg (fun k => k ≫ p) (Scheme.Hom.resLE_comp_ι i le_rfl).symm
  obtain ⟨g, hg, hcomm⟩ := exists_affine_coordinateChartMap_extending j (U.ι ≫ p)
    m n ((i ⁻¹ᵁ U).ι ≫ q) hbase h hh
  refine ⟨coordinateChartMap (U.ι ≫ p) m n g h, ?_,
    coordinateChartMap_isPullback_of_span_eq_ker j (U.ι ≫ p) m n g h
      ((i ⁻¹ᵁ U).ι ≫ q) hcomm hk, ?_⟩
  · unfold coordinateChartMap AffineSpace.homOfVector
    exact pullback.lift_fst _ _ _
  · intro k
    simp only [coordinateChartMap, AffineSpace.homOfVector_appTop_coord, Fin.addCases_right]
    rfl

/-! ### Étaleness of the chart -/

/-- In a cartesian square whose top row is an isomorphism and whose bottom row is an
isomorphism, étaleness passes from the left-hand vertical map to the right-hand one. -/
private theorem etale_of_isPullback_of_isIso_horiz
    {P Q R T : Scheme.{u}} {t : P ⟶ Q} {l : P ⟶ R} {r : Q ⟶ T} {b : R ⟶ T}
    (h : IsPullback t l r b) (ht : IsIso t) (hl : Etale l) (hb : IsIso b) : Etale r := by
  have hr : r = inv t ≫ l ≫ b := by rw [← h.w]; simp
  rw [hr]
  infer_instance

/-- In a cartesian square whose bottom row is surjective on stalks and whose left-hand vertical
map is étale, the residue-field fibres of the right-hand vertical map are étale. -/
private theorem etale_fiber_of_isPullback_closedImmersion
    {V U B A : Scheme.{u}} {i : V ⟶ U} {q : V ⟶ B} {π : U ⟶ A} {j : B ⟶ A}
    [SurjectiveOnStalks j] [Etale q] (h : IsPullback i q π j) (b : B) :
    Etale (π.fiberToSpecResidueField (j b)) := by
  have hres : IsIso (j.residueFieldMap b) := j.isIso_residueFieldMap_of_surjectiveOnStalks b
  have hpb := isPullback_fiberToSpecResidueField_of_isPullback h b
  have hqa : Etale (q.fiberToSpecResidueField b) := by
    show Etale (pullback.snd q (B.fromSpecResidueField b))
    infer_instance
  exact etale_of_isPullback_of_isIso_horiz hpb hpb.isIso_fst_of_isIso hqa inferInstance

/-- **The criterion of Stacks tag 02GU applied to the coordinate chart.** -/
private theorem etaleAt_of_flat_of_isPullback_closedImmersion
    {V U B A : Scheme.{u}} {i : V ⟶ U} {q : V ⟶ B} {π : U ⟶ A} {j : B ⟶ A}
    [SurjectiveOnStalks j] [Etale q] [LocallyOfFinitePresentation π]
    (h : IsPullback i q π j) (v : V) (hflat : (π.stalkMap (i v)).hom.Flat) :
    EtaleAt π (i v) := by
  apply ((AlgebraicGeometry.etaleAt_tfae π (i v)).out 1 2).mpr
  refine ⟨hflat, ?_⟩
  have heq : π (i v) = j (q v) := congrArg (fun k : V ⟶ A => k v) h.w
  have : Etale (π.fiberToSpecResidueField (π (i v))) := by
    rw [heq]
    exact etale_fiber_of_isPullback_closedImmersion h (q v)
  exact (AlgebraicGeometry.etale_iff_forall_etaleAt _).mp inferInstance _

/-- Transport a cartesian coordinate chart defined on the source of an open immersion into one
defined on the corresponding open subscheme. -/
private theorem exists_etale_isPullback_on_open
    {S X Y U V A B : Scheme.{u}} (f : X ⟶ S) (i : Y ⟶ X)
    (e : U ⟶ X) [IsOpenImmersion e] (j : V ⟶ U) (k : V ⟶ Y)
    (hopen : IsPullback j k e i) (π : U ⟶ A) [Etale π]
    (q : V ⟶ B) (c : B ⟶ A) (p : A ⟶ S)
    (hbase : π ≫ p = e ≫ f) (hchart : IsPullback j q π c) (v : V) :
    ∃ (W : X.Opens) (_ : k v ∈ i ⁻¹ᵁ W) (π' : W.toScheme ⟶ A)
      (q' : (i ⁻¹ᵁ W).toScheme ⟶ B), Etale π' ∧ π' ≫ p = W.ι ≫ f ∧
        IsPullback (i.resLE W (i ⁻¹ᵁ W) le_rfl) q' π' c := by
  let W := e.opensRange
  let eU := e.isoOpensRange
  have hs : IsPullback (j ≫ eU.hom) k W.ι i := by
    refine hopen.of_iso (Iso.refl _) eU (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · simp
    · simp
    · simp [eU, W]
    · simp
  let eV := hs.isoIsPullback W.toScheme Y (isPullback_resLE_ι i W)
  have hv : k v ∈ i ⁻¹ᵁ W := ⟨j v, congrArg (fun l : V ⟶ X => l v) hopen.w⟩
  refine ⟨W, hv, eU.inv ≫ π, eV.inv ≫ q, inferInstance, ?_, ?_⟩
  · rw [Category.assoc, hbase, ← Category.assoc]
    exact congrArg (fun l => l ≫ f) e.isoOpensRange_inv_comp
  · refine hchart.of_iso eV eU (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · simp [eV]
    · simp
    · simp
    · simp

/-- Shrinking a cartesian coordinate chart to an open on which it is étale. -/
private theorem exists_etale_isPullback_on_open_of_etaleAt
    {S X Y U V A B : Scheme.{u}} (f : X ⟶ S) (i : Y ⟶ X)
    (e : U ⟶ X) [IsOpenImmersion e] (j : V ⟶ U) (k : V ⟶ Y)
    (hopen : IsPullback j k e i) (π : U ⟶ A)
    (q : V ⟶ B) (c : B ⟶ A) (p : A ⟶ S)
    (hbase : π ≫ p = e ≫ f) (hchart : IsPullback j q π c) (v : V)
    (hπ : EtaleAt π (j v)) :
    ∃ (W : X.Opens) (_ : k v ∈ i ⁻¹ᵁ W) (π' : W.toScheme ⟶ A)
      (q' : (i ⁻¹ᵁ W).toScheme ⟶ B), Etale π' ∧ π' ≫ p = W.ι ≫ f ∧
        IsPullback (i.resLE W (i ⁻¹ᵁ W) le_rfl) q' π' c := by
  obtain ⟨H, hH, hv, hπH⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_etale_comp_ι_of_etaleAt π (j v) hπ
  have hr := isPullback_morphismRestrict j H
  have ho := hr.paste_vert hopen
  have hc := hr.paste_vert hchart
  have hb : (H.ι ≫ π) ≫ p = (H.ι ≫ e) ≫ f := by
    simp only [Category.assoc, hbase]
  exact exists_etale_isPullback_on_open f i (H.ι ≫ e) (j ∣_ H)
    ((j ⁻¹ᵁ H).ι ≫ k) ho (H.ι ≫ π) ((j ⁻¹ᵁ H).ι ≫ q) c p hb hc
    (⟨v, hv⟩ : (j ⁻¹ᵁ H).toScheme)

/-! ### The main theorem -/

/-- **Stacks Project, Tag 0FUE.** Let `S` be a scheme and let `i : Y ⟶ X` be a closed immersion
of schemes smooth over `S`. For every `y : Y` there are integers `m, n ≥ 0`, an open
`U ⊆ X` whose inverse image `V = i⁻¹(U)` contains `y`, an étale morphism
`π : U ⟶ 𝐀^{m+n}_S` over `S` and a morphism `q : V ⟶ 𝐀^m_S` making
```
Y ←── V ──→ 𝐀^m_S
│      │        │
↓      ↓        ↓
X ←── U ──→ 𝐀^{m+n}_S
```
commute with cartesian right-hand square, i.e. `V = π⁻¹(𝐀^m_S)`. -/
@[stacks 0FUE]
theorem exists_etale_coordinateSubspaceEmbedding_isPullback
    {S X Y : Scheme.{u}} (f : X ⟶ S) (i : Y ⟶ X)
    [IsClosedImmersion i] [Smooth f] [Smooth (i ≫ f)] (y : Y) :
    ∃ (m n : ℕ) (U : X.Opens) (_ : y ∈ i ⁻¹ᵁ U)
      (π : U.toScheme ⟶ AffineSpace (ULift.{u} (Fin (m + n))) S)
      (q : (i ⁻¹ᵁ U).toScheme ⟶ AffineSpace (ULift.{u} (Fin m)) S),
      Etale π ∧
        π ≫ (AffineSpace.over (ULift.{u} (Fin (m + n))) S).hom = U.ι ≫ f ∧
        IsPullback
          (i.resLE U (i ⁻¹ᵁ U) le_rfl) q π (coordinateSubspaceEmbedding S m n) := by
  classical
  obtain ⟨m, U, hU, hyU, q, hq, hqS⟩ :=
    exists_affine_etale_chart_on_closed_source f i y
  let j := i.resLE U (i ⁻¹ᵁ U) le_rfl
  let z : (i ⁻¹ᵁ U).toScheme := ⟨y, hyU⟩
  have := isClosedImmersion_resLE i U
  have hreg := regularIdealSheaf_on_open_of_smooth_closed f i U
  obtain ⟨W, hzW, hW, n, a, hker, ha⟩ :=
    exists_affine_h1Regular_generators_of_closedImmersion j hreg z
  have hbase : q ≫ (AffineSpace.over (ULift.{u} (Fin m)) S).hom =
      j ≫ (U.ι ≫ f) := by
    rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc]
    exact hqS
  obtain ⟨π, hπS, hpb, hπa⟩ := exists_coordinate_diagram_of_ker_app_eq_span
    j (U.ι ≫ f) W hW m n a hker q hbase
  have hπfp : LocallyOfFinitePresentation π :=
    locallyOfFinitePresentation_of_affineSpace_over (W.ι ≫ U.ι ≫ f) π hπS
  let v : (j ⁻¹ᵁ W).toScheme := ⟨z, hzW⟩
  have : IsClosedImmersion (coordinateSubspaceEmbedding S m n) :=
    coordinateSubspaceEmbedding_isClosedImmersion S m n
  suffices hflat : (π.stalkMap ((j.resLE W (j ⁻¹ᵁ W) le_rfl) v)).hom.Flat by
    have hEt := etaleAt_of_flat_of_isPullback_closedImmersion hpb v hflat
    obtain ⟨T, hyT, π', q', hπ', hbase', hpb'⟩ :=
      exists_etale_isPullback_on_open_of_etaleAt f i (W.ι ≫ U.ι)
        (j.resLE W (j ⁻¹ᵁ W) le_rfl) ((j ⁻¹ᵁ W).ι ≫ (i ⁻¹ᵁ U).ι)
        ((isPullback_resLE_ι j W).paste_vert (isPullback_resLE_ι i U)) π ((j ⁻¹ᵁ W).ι ≫ q)
        (coordinateSubspaceEmbedding S m n)
        (AffineSpace.over (ULift.{u} (Fin (m + n))) S).hom
        (by simpa only [Category.assoc] using hπS) hpb v hEt
    exact ⟨m, n, T, hyT, π', q', hπ', hbase', hpb'⟩
  have : IsAffine W.toScheme := hW
  have := isClosedImmersion_resLE j W
  apply flat_stalkMap_coordinateChart_of_isH1Regular
    (j.resLE W (j ⁻¹ᵁ W) le_rfl) m n π ((j ⁻¹ᵁ W).ι ≫ q) hpb v
  simp_rw [hπa]
  exact AlgebraicGeometry.isH1Regular_of_ringHomFlat W.topIso.inv.hom
    (RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso W.topIso.inv)) a ha

end Stacks.AlgebraicGeometry

