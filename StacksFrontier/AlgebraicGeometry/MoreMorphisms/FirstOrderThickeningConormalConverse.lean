* [Stacks Project, Tag 01R4](https://stacks.math.columbia.edu/tag/01R4)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TensorProduct
open scoped ChangeOfRings

universe u

namespace AlgebraicGeometry.Scheme.Modules

/-- **An invertible morphism of modules is bijective on the sections over every open.**
Evaluation at an open is a functor, so it carries an isomorphism to an isomorphism, and an
isomorphism of modules is a bijection. -/
theorem bijective_app_of_isIso {Y : Scheme.{u}} {M N : Y.Modules} (a : M ⟶ N)
    (ha : IsIso a) (W : Y.Opens) : Function.Bijective (a.val.app (op W)) := by
  have := ha
  have : IsIso (a.val.app (op W)) :=
    show IsIso (((SheafOfModules.forget Y.ringCatSheaf) ⋙
      PresheafOfModules.evaluation Y.ringCatSheaf.obj (op W)).map a) from
      Functor.map_isIso _ a
  exact ConcreteCategory.bijective_of_isIso _

/-- **A morphism out of a pullback, read on a pulled-back section.** For
`a : f^* F ⟶ H` and a section `m` of `F` over `U`, the value of `a` on
`AlgebraicGeometry.Scheme.Modules.pullbackSection f F U V hVU m` is the restriction to `V` of
the value at `U` of the transpose of `a` along `f^* ⊣ f_*`.

This is what makes the affine characterisation of a canonical map — stated through the
transpose, as `Stacks.Immersion.IsInducedConormalSheafMap` is — usable against the
normalization `AlgebraicGeometry.affinePullbackSectionsBaseChangeIso_one_tmul`, which is stated
through `pullbackSection`.  It is naturality of `a` together with
`CategoryTheory.Adjunction.homEquiv_unit`. -/
theorem app_pullbackSection {Y Z : Scheme.{u}} (f : Z ⟶ Y) {F : Y.Modules} {H : Z.Modules}
    (a : (Scheme.Modules.pullback f).obj F ⟶ H) (W : Y.Opens) (W' : Z.Opens)
    (hW : W' ≤ f ⁻¹ᵁ W) (m : F.val.obj (op W)) :
    a.val.app (op W') (Scheme.Modules.pullbackSection f F W W' hW m) =
      H.val.map (homOfLE hW).op
        (((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv F H a).val.app
          (op W) m) := by
  rw [Adjunction.homEquiv_unit]
  exact PresheafOfModules.naturality_apply a.val (homOfLE hW).op _

end AlgebraicGeometry.Scheme.Modules

namespace ModuleCat.ExtendScalars

/-- **Extension of scalars along a ring map is the tensor product over the algebra it defines.**
The `Module A B` instance carried by `(ModuleCat.extendScalars f).obj M` is `Module.compHom B f`,
and that is `Algebra.toModule` for `f.toAlgebra` on the nose, so the two tensor products have the
same elements and the same addition and the comparison is the identity.

This is the bridge the chart computation of [Stacks Project, Tag 063Y] crosses: the sections of a
pullback over a pair of affine charts are computed by
`AlgebraicGeometry.affinePullbackSectionsBaseChangeIso` in the `ModuleCat.extendScalars`
spelling, while the commutative algebra of the tag is stated for the plain tensor product.  It is
an `AddEquiv` rather than a `LinearEquiv` because the two `Module B _` instances on the two sides,
although definitionally equal, are not recognised as such at the transparency the elaborator uses
for instance arguments. -/
def tensorAddEquiv {A B : Type u} [CommRing A] [CommRing B] (f : A →+* B)
    (N : Type u) [AddCommGroup N] [Module A N] :
    letI := f.toAlgebra
    (B ⊗[A] N) ≃+ ((ModuleCat.extendScalars f).obj (ModuleCat.of A N)) :=
  letI := f.toAlgebra
  let E : (B ⊗[A] N) ≃ ((ModuleCat.extendScalars f).obj (ModuleCat.of A N)) :=
    { toFun := fun z => z, invFun := fun z => z, left_inv := fun _ => rfl,
      right_inv := fun _ => rfl }
  { toEquiv := E, map_add' := fun _ _ => rfl }

end ModuleCat.ExtendScalars

namespace Stacks.IdealSheaf

variable {X Y : Scheme.{u}}

/-- **The inverse image of an ideal sheaf on a pair of affine charts.** For a morphism
`f : X ⟶ Y`, an affine open `V ⊆ Y` and an affine open `U ⊆ f ⁻¹ᵁ V`, the ideal of `I.comap f` on
`U` is generated by the image of the ideal of `I` on `V` under `f.appLE V U`.

`Stacks.IdealSheaf.ideal_comap_of_isAffineHom` is the same formula for an affine morphism and
`U = f ⁻¹ᵁ V`; here the morphism is arbitrary and `U` is any affine open over `V`.  Both reduce
to `Stacks.IdealSheaf.ideal_comap_top_of_isAffine` for the restricted morphism
`f.resLE V U : U ⟶ V` of affine schemes, the comparison being
`Stacks.IdealSheaf.ideal_comap_ι_top` on each side. -/
theorem ideal_comap_of_isAffineOpen (I : Y.IdealSheafData) (f : X ⟶ Y)
    {U : X.Opens} {V : Y.Opens} (hU : IsAffineOpen U) (hV : IsAffineOpen V)
    (hUV : U ≤ f ⁻¹ᵁ V) :
    (I.comap f).ideal ⟨U, hU⟩ = Ideal.map (f.appLE V U hUV).hom (I.ideal ⟨V, hV⟩) := by
  have hUa : IsAffine U.toScheme := hU
  have hVa : IsAffine V.toScheme := hV
  set g : U.toScheme ⟶ V.toScheme := f.resLE V U hUV with hg
  have hcomp : U.ι ≫ f = g ≫ V.ι := (Scheme.Hom.resLE_comp_ι f hUV).symm
  have hcomap : (I.comap f).comap U.ι = (I.comap V.ι).comap g := by
    rw [← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp, hcomp]
  have e1 : ((I.comap f).comap U.ι).ideal ⟨⊤, isAffineOpen_top U.toScheme⟩ =
      Ideal.map U.topIso.inv.hom ((I.comap f).ideal ⟨U, hU⟩) :=
    ideal_comap_ι_top (I.comap f) hU _
  have e2 : ((I.comap V.ι).comap g).ideal ⟨⊤, isAffineOpen_top U.toScheme⟩ =
      Ideal.map g.appTop.hom ((I.comap V.ι).ideal ⟨⊤, isAffineOpen_top V.toScheme⟩) :=
    ideal_comap_top_of_isAffine (I.comap V.ι) g
  have e3 : (I.comap V.ι).ideal ⟨⊤, isAffineOpen_top V.toScheme⟩ =
      Ideal.map V.topIso.inv.hom (I.ideal ⟨V, hV⟩) :=
    ideal_comap_ι_top I hV _
  have hgtop : g.appTop = V.topIso.hom ≫ f.appLE V U hUV ≫ U.topIso.inv := by
    rw [hg, Scheme.Hom.appTop, Scheme.Hom.resLE_app_top]
  have hmaps : V.topIso.inv ≫ g.appTop = f.appLE V U hUV ≫ U.topIso.inv := by
    rw [hgtop, Iso.inv_hom_id_assoc]
  refine ideal_map_hom_injective U.topIso.symm ?_
  show Ideal.map U.topIso.inv.hom ((I.comap f).ideal ⟨U, hU⟩) =
      Ideal.map U.topIso.inv.hom
        (Ideal.map (f.appLE V U hUV).hom (I.ideal ⟨V, hV⟩))
  rw [← e1, hcomap, e2, e3, Ideal.map_map, Ideal.map_map, ← CommRingCat.hom_comp,
    ← CommRingCat.hom_comp, hmaps]

end Stacks.IdealSheaf

namespace Stacks.Conormal

/-- **The affine model of a closed immersion whose ideal is the kernel of the section map.**
`Stacks.Conormal.exists_affineModel` produces a presentation of the scheme-theoretic intersection
over an affine open by *some* ideal; by `Stacks.Conormal.ker_appLE_eq_of_affineModel` that ideal
is the kernel of `i.app U`, so the presentation may be taken with that ideal named.

This is the shape `Stacks.Immersion.isInducedConormalSheafMap_immersionConormalSheafMap` is
consumed in, where the ideal must be the same one the commutative algebra of
[Stacks Project, Tag 063Y] is stated for. -/
theorem exists_affineModel_ker {X X' : Scheme.{u}} (i : X ⟶ X') [IsClosedImmersion i]
    (U : X'.Opens) (hU : IsAffineOpen U) :
    ∃ e : pullback i U.ι ≅ Spec (.of (Γ(X', U) ⧸ RingHom.ker (i.app U).hom)),
      pullback.snd i U.ι ≫ hU.isoSpec.hom =
        e.hom ≫ Spec.map (CommRingCat.ofHom
          (Ideal.Quotient.mk (RingHom.ker (i.app U).hom))) := by
  obtain ⟨I, e, he⟩ := exists_affineModel i U hU
  have hI : RingHom.ker (i.app U).hom = I := by
    rw [← Scheme.Hom.appLE_preimage_self i U]
    exact ker_appLE_eq_of_affineModel i U hU I e he
  rw [hI]
  exact ⟨e, he⟩

end Stacks.Conormal

namespace Stacks.Thickenings

open Stacks.Immersion RingedSpaceModuleAdjunction

variable {X X' S S' : Scheme.{u}}

/-- **The glueing step of (2) ⟹ (1) of [Stacks Project, Tag 063Y].** Let
```
X --i--→ X'
|        |
f        f'
↓        ↓
S --j--→ S'
```
be a commutative square with `i` and `j` closed immersions, and suppose that on every pair of
affine opens `V ⊆ S'` and `U ⊆ f' ⁻¹ᵁ V` the ideal cutting out `X` in `U` is generated by the
image of the ideal cutting out `S` in `V`, and that the ring map `Γ(S', V) ⟶ Γ(X', U)` is flat.
Then `f'` is flat and the square is cartesian, which is condition (1) of the tag.

The thickening hypotheses are not used: what the square-zero conditions are for is the
commutative algebra that produces the chart data, `Ideal.bijective_tensorSMulHomToKer_iff`. -/
theorem flat_and_isPullback_of_affine {i : X ⟶ X'} {j : S ⟶ S'} [IsClosedImmersion i]
    [IsClosedImmersion j] (f : X ⟶ S) (f' : X' ⟶ S') (comm : i ≫ f' = f ≫ j)
    (hchart : ∀ (V : S'.Opens) (hV : IsAffineOpen V) (U : X'.Opens) (hU : IsAffineOpen U)
      (hUV : U ≤ f' ⁻¹ᵁ V),
      i.ker.ideal ⟨U, hU⟩ = Ideal.map (f'.appLE V U hUV).hom (j.ker.ideal ⟨V, hV⟩) ∧
        (f'.appLE V U hUV).hom.Flat) :
    Flat f' ∧ IsPullback i f f' j := by
  refine ⟨⟨fun {V} hV {U} hU hUV => (hchart V hV U hU hUV).2⟩,
    isPullback_of_isClosedImmersion i j f f' comm ?_⟩
  have hbasis : ∀ x : X', ∃ (U : X'.affineOpens) (V : S'.Opens),
      IsAffineOpen V ∧ x ∈ U.1 ∧ U.1 ≤ f' ⁻¹ᵁ V := by
    intro x
    obtain ⟨_, ⟨V, hV, rfl⟩, hxV, -⟩ :=
      S'.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (f'.base x)) isOpen_univ
    obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUV⟩ :=
      X'.isBasis_affineOpens.exists_subset_of_mem_open (show x ∈ f' ⁻¹ᵁ V from hxV)
        (f' ⁻¹ᵁ V).isOpen
    exact ⟨⟨U, hU⟩, V, hV, hxU, hUV⟩
  choose U V hV hmem hle using hbasis
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top U ?_ fun x => ?_
  · refine top_le_iff.mp fun x _ => ?_
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hmem x⟩
  · rw [Stacks.IdealSheaf.ideal_comap_of_isAffineOpen j.ker f' (U x).2 (hV x) (hle x)]
    exact ((hchart (V x) (hV x) (U x).1 (U x).2 (hle x)).1).symm

/-! ### The chart data from a bijection on one chart -/

section ChartAlgebra

variable {R T A B : Type u} [CommRing R] [CommRing T] [CommRing A] [CommRing B]

section

variable [Algebra R T] [Algebra R A] [Algebra T B] [Algebra A B] [Algebra R B]
  [IsScalarTower R T B] [IsScalarTower R A B]

/-- **The chart data of (2) ⟹ (1) of [Stacks Project, Tag 063Y], from the bijection on one
chart.** In the commuting square of rings `R ⟶ T`, `R ⟶ A`, `T ⟶ B`, `A ⟶ B` with `A` and `B`
quotients of `R` and of `T` by square-zero ideals `J` and `I`, and `B` flat over `A`, suppose
there is an additive bijection from `B ⊗_R J` onto `I` carrying `b ⊗ x` to `b · x` for `b` in
the image of `T`.  Then `T` is flat over `R` and `I` is generated by the image of `J`.

This is `Ideal.bijective_fibreTensorSMulHomToKer_iff` — the affine case of the tag — read in the
vocabulary the geometric charts produce: an abstract bijection pinned down on the elementary
tensors, rather than the canonical map named.  The two agree because the elementary tensors
`algebraMap T B b ⊗ x` span, by surjectivity of `T ⟶ B`. -/
theorem flat_and_ker_eq_of_addEquiv_chart
    (hA : Function.Surjective (algebraMap R A)) (hT : Function.Surjective (algebraMap T B))
    (hflat : Module.Flat A B)
    (hJ2 : RingHom.ker (algebraMap R A) ^ 2 = ⊥)
    (hI2 : RingHom.ker (algebraMap T B) ^ 2 = ⊥)
    (ψ : (B ⊗[R] (RingHom.ker (algebraMap R A))) ≃+ (RingHom.ker (algebraMap T B)))
    (hψ : ∀ (b : T) (x : RingHom.ker (algebraMap R A)),
      (ψ (algebraMap T B b ⊗ₜ[R] x) : T) = b * algebraMap R T (x : R)) :
    Module.Flat R T ∧
      RingHom.ker (algebraMap T B) =
        Ideal.map (algebraMap R T) (RingHom.ker (algebraMap R A)) := by
  have hJB : ∀ x ∈ RingHom.ker (algebraMap R A), algebraMap R B x = 0 := fun x hx => by
    rw [IsScalarTower.algebraMap_apply R A B, RingHom.mem_ker.mp hx, map_zero]
  have hJA : ∀ x ∈ RingHom.ker (algebraMap R A), algebraMap R A x = 0 :=
    fun _ hx => RingHom.mem_ker.mp hx
  let : Algebra (R ⧸ RingHom.ker (algebraMap R A)) B :=
    (Ideal.Quotient.lift _ (algebraMap R B) hJB).toAlgebra
  let : Algebra (R ⧸ RingHom.ker (algebraMap R A)) A :=
    (Ideal.Quotient.lift _ (algebraMap R A) hJA).toAlgebra
  let : IsScalarTower R (R ⧸ RingHom.ker (algebraMap R A)) B := .of_algebraMap_eq' rfl
  let : IsScalarTower R (R ⧸ RingHom.ker (algebraMap R A)) A := .of_algebraMap_eq' rfl
  let : IsScalarTower (R ⧸ RingHom.ker (algebraMap R A)) A B := .of_algebraMap_eq' (by
    refine Ideal.Quotient.ringHom_ext ?_
    ext x
    show algebraMap R B x = algebraMap A B (algebraMap R A x)
    exact IsScalarTower.algebraMap_apply R A B x)
  have : Module.Flat (R ⧸ RingHom.ker (algebraMap R A)) A := by
    have e : (R ⧸ RingHom.ker (algebraMap R A)) ≃ₗ[R ⧸ RingHom.ker (algebraMap R A)] A :=
      { RingHom.quotientKerEquivOfSurjective hA with
        map_smul' := fun q p => by
          show RingHom.quotientKerEquivOfSurjective hA (q * p) =
            algebraMap (R ⧸ RingHom.ker (algebraMap R A)) A q *
              RingHom.quotientKerEquivOfSurjective hA p
          rw [map_mul]
          rfl }
    exact Module.Flat.of_linearEquiv e.symm
  have := hflat
  have hflatQ : Module.Flat (R ⧸ RingHom.ker (algebraMap R A)) B :=
    Module.Flat.trans (R ⧸ RingHom.ker (algebraMap R A)) A B
  have hbij : Function.Bijective
      ((RingHom.ker (algebraMap R A)).fibreTensorSMulHomToKer T B hI2 hT) := by
    have hcomm : ∀ z : B ⊗[R] (RingHom.ker (algebraMap R A)),
        (RingHom.ker (algebraMap R A)).fibreTensorSMulHomToKer T B hI2 hT
          (TensorProduct.comm R B (RingHom.ker (algebraMap R A)) z) = ψ z := by
      intro z
      induction z with
      | zero =>
        simp only [map_zero]
        rfl
      | add z w hz hw =>
        simp only [map_add, hz, hw]
        rfl
      | tmul b x =>
        obtain ⟨b', rfl⟩ := hT b
        refine Subtype.ext ?_
        rw [TensorProduct.comm_tmul, Ideal.coe_fibreTensorSMulHomToKer_apply,
          Ideal.fibreTensorSMulHom_tmul, hψ b' x, Algebra.smul_def]
        exact mul_comm _ _
    have hcomp : ((RingHom.ker (algebraMap R A)).fibreTensorSMulHomToKer T B hI2 hT) ∘
        (TensorProduct.comm R B (RingHom.ker (algebraMap R A))) = ψ := funext hcomm
    have hb : Function.Bijective
        (((RingHom.ker (algebraMap R A)).fibreTensorSMulHomToKer T B hI2 hT) ∘
          (TensorProduct.comm R B (RingHom.ker (algebraMap R A)))) := by
      rw [hcomp]; exact ψ.bijective
    exact (Function.Bijective.of_comp_iff _
      (TensorProduct.comm R B (RingHom.ker (algebraMap R A))).bijective).mp hb
  obtain ⟨hflatRT, hker⟩ :=
    ((RingHom.ker (algebraMap R A)).bijective_fibreTensorSMulHomToKer_iff T B hJ2 hI2
      hT hflatQ).mp hbij
  refine ⟨hflatRT, Submodule.restrictScalars_injective R T T ?_⟩
  rw [hker, Ideal.smul_top_eq_map]

end

/-- **The chart data of (2) ⟹ (1) of [Stacks Project, Tag 063Y], from a bijection out of an
extension of scalars.** In the commuting square of ring maps `α : R ⟶ T`, `qR : R ⟶ A`,
`qT : T ⟶ B`, `dd : A ⟶ B` with `qR` and `qT` surjective with square-zero kernels `J` and `I`,
and `dd` flat, suppose that the conormal module `N` — any `A`-module identified with `J` over `R`
— has `B ⊗_A N` additively bijective onto `I` by a map carrying `qT b ⊗ n` to `b · w n`.  Then
`α` is flat and `I` is generated by the image of `J`.

This is `Stacks.Thickenings.flat_and_ker_eq_of_addEquiv_chart` with the source written as an
extension of scalars, which is the form
`AlgebraicGeometry.affinePullbackSectionsBaseChangeIso` computes the sections of a pullback in,
and with the `Algebra` and `IsScalarTower` structures built from the ring maps rather than
assumed; that is what makes `ModuleCat.ExtendScalars.tensorAddEquiv` definitional here.  The
comparison `B ⊗_R J ≅ B ⊗_A N` is the base change of `w` followed by
`TensorProduct.equivOfCompatibleSMul`, which applies because `qR` is surjective. -/
theorem flat_and_ker_eq_of_extendScalars_chart
    (α : R →+* T) (qR : R →+* A) (qT : T →+* B) (dd : A →+* B)
    (hsq : qT.comp α = dd.comp qR)
    (hR : Function.Surjective qR) (hT : Function.Surjective qT) (hflat : dd.Flat)
    (hJ2 : RingHom.ker qR ^ 2 = ⊥) (hI2 : RingHom.ker qT ^ 2 = ⊥)
    {N : Type u} [AddCommGroup N] [Module A N] [Module R N]
    (hN : ∀ (r : R) (n : N), r • n = qR r • n)
    (w : N ≃ₗ[R] RingHom.ker qR)
    (Θ : ((ModuleCat.extendScalars dd).obj (ModuleCat.of A N)) ≃+ RingHom.ker qT)
    (hΘ : ∀ (b : T) (n : N), (Θ (qT b ⊗ₜ[A,dd] n) : T) = b * α (w n : R)) :
    α.Flat ∧ RingHom.ker qT = Ideal.map α (RingHom.ker qR) := by
  let : Algebra R T := α.toAlgebra
  let : Algebra R A := qR.toAlgebra
  let : Algebra T B := qT.toAlgebra
  let : Algebra A B := dd.toAlgebra
  let : Algebra R B := (qT.comp α).toAlgebra
  let : IsScalarTower R T B := .of_algebraMap_eq' rfl
  let : IsScalarTower R A B := .of_algebraMap_eq' hsq
  let : IsScalarTower R A N := .of_algebraMap_smul (fun r n => (hN r n).symm)
  have : Module.Flat A B := hflat
  have : TensorProduct.CompatibleSMul R A B N :=
    TensorProduct.CompatibleSMul.of_algebraMap_surjective B N hR
  have : TensorProduct.CompatibleSMul A R B N :=
    ⟨fun r m n => by
      rw [← IsScalarTower.algebraMap_smul A r m, ← IsScalarTower.algebraMap_smul A r n,
        TensorProduct.smul_tmul]⟩
  let e₁ : (B ⊗[R] RingHom.ker qR) ≃ₗ[B] (B ⊗[R] N) := w.symm.baseChange R B _ N
  let e₂ : (B ⊗[R] N) ≃ₗ[B] (B ⊗[A] N) :=
    (TensorProduct.equivOfCompatibleSMul R A B B N).symm
  let bridge : (B ⊗[A] N) ≃+ ((ModuleCat.extendScalars dd).obj (ModuleCat.of A N)) :=
    ModuleCat.ExtendScalars.tensorAddEquiv dd N
  refine flat_and_ker_eq_of_addEquiv_chart hR hT ‹Module.Flat A B› hJ2 hI2
    (e₁.toAddEquiv.trans (e₂.toAddEquiv.trans (bridge.trans Θ))) ?_
  intro b x
  have h1 : (e₁.toAddEquiv.trans (e₂.toAddEquiv.trans (bridge.trans Θ)))
      (algebraMap T B b ⊗ₜ[R] x) = Θ (qT b ⊗ₜ[A, dd] (w.symm x)) := rfl
  rw [h1, hΘ, w.apply_symm_apply]
  rfl

end ChartAlgebra

/-! ### Condition (2) read over a pair of affine charts -/

/-- On a commutative square of schemes, restricting along the top and then the left edge agrees
with restricting along the right and then the bottom edge, over compatible opens. -/
private theorem appLE_comp_app_eq_app_comp_appLE_of_square {i : X ⟶ X'} {j : S ⟶ S'} {f : X ⟶ S}
    {f' : X' ⟶ S'} (comm : i ≫ f' = f ≫ j) (U : X'.Opens) (V : S'.Opens) (hUV : U ≤ f' ⁻¹ᵁ V) :
    f'.appLE V U hUV ≫ i.app U =
      j.app V ≫ f.appLE (j ⁻¹ᵁ V) (i ⁻¹ᵁ U) (preimage_le_preimage_of_square comm U V hUV) := by
  rw [i.app_eq_appLE, j.app_eq_appLE, Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
  simp only [comm]

/-- **The chart data of (2) ⟹ (1) of [Stacks Project, Tag 063Y], read off condition (2).** For a
commutative square of closed immersions with square-zero defining ideals and `f` flat, if the
canonical map `f^* 𝒞_{S/S'} ⟶ 𝒞_{X/X'}` is an isomorphism then on every pair of affine opens
`V ⊆ S'` and `U ⊆ f' ⁻¹ᵁ V` the ideal cutting out `X` in `U` is generated by the image of the
ideal cutting out `S` in `V`, and `Γ(S', V) ⟶ Γ(X', U)` is flat.

The chain is: the sections of `f^* 𝒞_{S/S'}` over `i ⁻¹ᵁ U` are the extension of scalars of the
sections of `𝒞_{S/S'}` over `j ⁻¹ᵁ V` along `Γ(S, j⁻¹V) ⟶ Γ(X, i⁻¹U)`, by
`AlgebraicGeometry.affinePullbackSectionsBaseChangeIso`, which is pinned down on `1 ⊗ n` by
`AlgebraicGeometry.affinePullbackSectionsBaseChangeIso_one_tmul`; condition (2) makes the
canonical map bijective on those sections, by
`AlgebraicGeometry.Scheme.Modules.bijective_app_of_isIso`; and both conormal modules are the
defining ideals themselves, by `Stacks.Conormal.affineConormalIsoCotangent` of
[Stacks Project, Tag 01R3] together with `Ideal.cotangentEquivOfSqZero`.  The value of the
composite on a generator is the affine characterisation
`Stacks.Immersion.isInducedConormalSheafMap_immersionConormalSheafMap` of
[Stacks Project, Tag 01R4], read through
`AlgebraicGeometry.Scheme.Modules.app_pullbackSection`; the commutative algebra is then
`Stacks.Thickenings.flat_and_ker_eq_of_extendScalars_chart`. -/
theorem ideal_eq_and_flat_of_isIso_immersionConormalSheafMap (i : X ⟶ X') (j : S ⟶ S')
    [IsClosedImmersion i] [IsClosedImmersion j]
    (f : X ⟶ S) (f' : X' ⟶ S') (comm : i ≫ f' = f ≫ j) [Flat f]
    (hi2 : i.ker ^ 2 = ⊥) (hj2 : j.ker ^ 2 = ⊥)
    (hiso : IsIso (immersionConormalSheafMap i j f f' (toShHom_square comm)))
    (V : S'.Opens) (hV : IsAffineOpen V) (U : X'.Opens) (hU : IsAffineOpen U)
    (hUV : U ≤ f' ⁻¹ᵁ V) :
    i.ker.ideal ⟨U, hU⟩ = Ideal.map (f'.appLE V U hUV).hom (j.ker.ideal ⟨V, hV⟩) ∧
      (f'.appLE V U hUV).hom.Flat := by
  have hV₀ : IsAffineOpen (j ⁻¹ᵁ V) := hV.preimage j
  have hU₀ : IsAffineOpen (i ⁻¹ᵁ U) := hU.preimage i
  have hred : i ⁻¹ᵁ U ≤ f ⁻¹ᵁ (j ⁻¹ᵁ V) := preimage_le_preimage_of_square comm U V hUV
  have hJ2 : RingHom.ker (j.app V).hom ^ 2 = ⊥ := ker_app_sq_eq_bot j hj2 V
  have hI2 : RingHom.ker (i.app U).hom ^ 2 = ⊥ := ker_app_sq_eq_bot i hi2 U
  obtain ⟨eJ, heJ⟩ := Stacks.Conormal.exists_affineModel_ker j V hV
  obtain ⟨eI, heI⟩ := Stacks.Conormal.exists_affineModel_ker i U hU
  let F : S.Modules := immersionConormalSheaf j
  let H : X.Modules := immersionConormalSheaf i
  have : F.IsQuasicoherent := Stacks.Conormal.conormalSheaf_isQuasicoherent j
  let : Module Γ(S', V) Γ(F, j ⁻¹ᵁ V) := Module.compHom _ (j.app V).hom
  let : Module Γ(X', U) Γ(H, i ⁻¹ᵁ U) := Module.compHom _ (i.app U).hom
  let cJ : ModuleCat.of Γ(S', V) Γ(F, j ⁻¹ᵁ V) ≅
      ModuleCat.of Γ(S', V) (RingHom.ker (j.app V).hom).Cotangent :=
    Stacks.Conormal.affineConormalIsoCotangent j V hV _ eJ heJ
  let cI : ModuleCat.of Γ(X', U) Γ(H, i ⁻¹ᵁ U) ≅
      ModuleCat.of Γ(X', U) (RingHom.ker (i.app U).hom).Cotangent :=
    Stacks.Conormal.affineConormalIsoCotangent i U hU _ eI heI
  let eN : Γ(F, j ⁻¹ᵁ V) ≃ₗ[Γ(S', V)] RingHom.ker (j.app V).hom :=
    cJ.toLinearEquiv.trans ((RingHom.ker (j.app V).hom).cotangentEquivOfSqZero hJ2)
  let eM : Γ(H, i ⁻¹ᵁ U) ≃ₗ[Γ(X', U)] RingHom.ker (i.app U).hom :=
    cI.toLinearEquiv.trans ((RingHom.ker (i.app U).hom).cotangentEquivOfSqZero hI2)
  let a : (Scheme.Modules.pullback f).obj F ⟶ H :=
    immersionConormalSheafMap i j f f' (toShHom_square comm)
  let e₃ := (affinePullbackSectionsBaseChangeIso f F hV₀ hU₀ hred).toLinearEquiv
  let e₄ : Γ((Scheme.Modules.pullback f).obj F, i ⁻¹ᵁ U) ≃ₗ[Γ(X, i ⁻¹ᵁ U)] Γ(H, i ⁻¹ᵁ U) :=
    LinearEquiv.ofBijective (a.val.app (op (i ⁻¹ᵁ U))).hom
      (Scheme.Modules.bijective_app_of_isIso a hiso (i ⁻¹ᵁ U))
  let Θ := e₃.toAddEquiv.trans (e₄.toAddEquiv.trans eM.toAddEquiv)
  have key := flat_and_ker_eq_of_extendScalars_chart (f'.appLE V U hUV).hom (j.app V).hom
    (i.app U).hom (f.appLE (j ⁻¹ᵁ V) (i ⁻¹ᵁ U) hred).hom
    (congrArg CommRingCat.Hom.hom (appLE_comp_app_eq_app_comp_appLE_of_square comm U V hUV))
    (j.app_surjective V hV) (i.app_surjective U hU) (f.flat_appLE hV₀ hU₀ hred) hJ2 hI2
    (fun _ _ => rfl) eN Θ ?_
  · refine ⟨?_, key.1⟩
    rw [Scheme.Hom.ker_apply i ⟨U, hU⟩, Scheme.Hom.ker_apply j ⟨V, hV⟩]
    exact key.2
  · intro b n
    have hmem : (f'.appLE V U hUV).hom (eN n : Γ(S', V)) ∈ RingHom.ker (i.app U).hom :=
      immersionConormalSheafMap_ideal_mem i j f f' comm U hU V hV hUV _ _ eI heI eJ heJ (eN n)
    have hgen := isInducedConormalSheafMap_immersionConormalSheafMap i j f f' comm
      U hU V hV hUV _ _ eI heI eJ heJ (eN n)
      ⟨(f'.appLE V U hUV).hom (eN n : Γ(S', V)), hmem⟩ rfl
    have hb : e₃ ((1 : Γ(X, i ⁻¹ᵁ U)) ⊗ₜ[Γ(S, j ⁻¹ᵁ V),
          (f.appLE (j ⁻¹ᵁ V) (i ⁻¹ᵁ U) hred).hom] n) =
        Scheme.Modules.pullbackSection f F (j ⁻¹ᵁ V) (i ⁻¹ᵁ U) hred n :=
      affinePullbackSectionsBaseChangeIso_one_tmul f F hV₀ hU₀ hred n
    have h2 : e₄ (Scheme.Modules.pullbackSection f F (j ⁻¹ᵁ V) (i ⁻¹ᵁ U) hred n) =
        cI.inv.hom ((RingHom.ker (i.app U).hom).toCotangent
          ⟨(f'.appLE V U hUV).hom (eN n : Γ(S', V)), hmem⟩) := by
      have h0 := (Scheme.Modules.app_pullbackSection f a (j ⁻¹ᵁ V) (i ⁻¹ᵁ U) hred
        (eN.symm (eN n))).trans hgen
      rwa [eN.symm_apply_apply] at h0
    have hone : eM (e₄ (e₃ ((1 : Γ(X, i ⁻¹ᵁ U)) ⊗ₜ[Γ(S, j ⁻¹ᵁ V),
          (f.appLE (j ⁻¹ᵁ V) (i ⁻¹ᵁ U) hred).hom] n))) =
        (⟨(f'.appLE V U hUV).hom (eN n : Γ(S', V)), hmem⟩ : RingHom.ker (i.app U).hom) := by
      rw [hb, h2]
      show ((RingHom.ker (i.app U).hom).cotangentEquivOfSqZero hI2)
        (cI.toLinearEquiv (cI.toLinearEquiv.symm
          ((RingHom.ker (i.app U).hom).toCotangent _))) = _
      rw [LinearEquiv.apply_symm_apply, Ideal.cotangentEquivOfSqZero_toCotangent]
    have hsc : ∀ c : Γ(X, i ⁻¹ᵁ U),
        e₃ (c ⊗ₜ[Γ(S, j ⁻¹ᵁ V), (f.appLE (j ⁻¹ᵁ V) (i ⁻¹ᵁ U) hred).hom] n) =
          c • e₃ ((1 : Γ(X, i ⁻¹ᵁ U)) ⊗ₜ[Γ(S, j ⁻¹ᵁ V),
            (f.appLE (j ⁻¹ᵁ V) (i ⁻¹ᵁ U) hred).hom] n) := by
      intro c
      refine Eq.trans (congrArg e₃ ?_) (e₃.map_smul c _)
      have h := (ModuleCat.ExtendScalars.smul_tmul
        (f := (f.appLE (j ⁻¹ᵁ V) (i ⁻¹ᵁ U) hred).hom)
        (M := ModuleCat.of Γ(S, j ⁻¹ᵁ V) Γ(F, j ⁻¹ᵁ V)) c 1 n).symm
      rwa [mul_one] at h
    have hstep : Θ ((i.app U).hom b ⊗ₜ[Γ(S, j ⁻¹ᵁ V),
          (f.appLE (j ⁻¹ᵁ V) (i ⁻¹ᵁ U) hred).hom] n) =
        b • (⟨(f'.appLE V U hUV).hom (eN n : Γ(S', V)), hmem⟩ :
          RingHom.ker (i.app U).hom) := by
      show eM (e₄ (e₃ _)) = _
      rw [hsc, map_smul]
      have h5 : ∀ m : Γ(H, i ⁻¹ᵁ U), (i.app U).hom b • m = b • m := fun _ => rfl
      rw [h5, map_smul, hone]
    rw [hstep, Submodule.coe_smul, smul_eq_mul]

/-! ### Condition (1) of Tag 063Y -/

/-- **(2) ⟹ (1) of [Stacks Project, Tag 063Y] for a square of closed immersions.** For a
commutative square of closed immersions with square-zero defining ideals and `f` flat, if the
canonical map `f^* 𝒞_{S/S'} ⟶ 𝒞_{X/X'}` is an isomorphism then `f'` is flat and the square is
cartesian.

This is `Stacks.Thickenings.ideal_eq_and_flat_of_isIso_immersionConormalSheafMap` on every
compatible pair of affine opens, glued by
`Stacks.Thickenings.flat_and_isPullback_of_affine`. -/
theorem flat_and_isPullback_of_isIso_immersionConormalSheafMap (i : X ⟶ X') (j : S ⟶ S')
    [IsClosedImmersion i] [IsClosedImmersion j]
    (f : X ⟶ S) (f' : X' ⟶ S') (comm : i ≫ f' = f ≫ j) [Flat f]
    (hi2 : i.ker ^ 2 = ⊥) (hj2 : j.ker ^ 2 = ⊥)
    (hiso : IsIso (immersionConormalSheafMap i j f f' (toShHom_square comm))) :
    Flat f' ∧ IsPullback i f f' j :=
  flat_and_isPullback_of_affine f f' comm fun V hV U hU hUV =>
    ideal_eq_and_flat_of_isIso_immersionConormalSheafMap i j f f' comm hi2 hj2 hiso
      V hV U hU hUV

/-- **[Stacks Project, Tag 063Y], (2) ⟹ (1), for schemes.** Let
`(f, f') : (X ⊂ X') → (S ⊂ S')` be a morphism of first-order thickenings of schemes, with
`f = φ.left` and `f' = φ.right`, and let `f` be flat.  If the canonical map
`f^* 𝒞_{S/S'} ⟶ 𝒞_{X/X'}` is an isomorphism, then `f'` is flat and `X = S ×_{S'} X'`.

The hypothesis is condition (2) of the tag and the conclusion is its condition (1): `Flat φ.right`
is flatness of `f'` and `IsPullback i φ.left φ.right j` is the base-change identity
`X = S ×_{S'} X'`.  The flatness of `f` is the tag's standing hypothesis, and here it is used: it
is what makes `Γ(S, j⁻¹V) ⟶ Γ(X, i⁻¹U)` flat, which is a hypothesis of the commutative algebra
`Ideal.bijective_fibreTensorSMulHomToKer_iff`. -/
@[stacks 063Y "(2) ⟹ (1) for schemes"]
theorem flat_and_isPullback_of_isIso_firstOrderThickeningConormalSheafMap {i : X ⟶ X'}
    {j : S ⟶ S'} (hi : IsFirstOrderThickening i) (hj : IsFirstOrderThickening j)
    (φ : Arrow.mk i ⟶ Arrow.mk j) [Flat φ.left]
    (hiso : letI := hi.1
      letI := hj.1
      IsIso (firstOrderThickeningConormalSheafMap hi hj φ)) :
    Flat φ.right ∧ IsPullback i φ.left φ.right j :=
  let := hi.1
  let := hj.1
  flat_and_isPullback_of_isIso_immersionConormalSheafMap i j φ.left φ.right
    (Arrow.w φ).symm hi.2 hj.2 hiso

/-- **[Stacks Project, Tag 063Y] for schemes.** Let `(f, f') : (X ⊂ X') → (S ⊂ S')` be a morphism
of first-order thickenings of schemes with `f = φ.left` flat.  Then the following are equivalent:

* **(1)** `f'` is flat and `X = S ×_{S'} X'`;
* **(2)** the canonical map `f^* 𝒞_{S/S'} ⟶ 𝒞_{X/X'}` is an isomorphism.

The two directions are
`Stacks.Thickenings.isIso_firstOrderThickeningConormalSheafMap` and
`Stacks.Thickenings.flat_and_isPullback_of_isIso_firstOrderThickeningConormalSheafMap`.  The
standing hypothesis that `f` be flat is not needed for (1) ⟹ (2), where it follows from the other
two; it is needed for (2) ⟹ (1). -/
@[stacks 063Y]
theorem flat_and_isPullback_iff_isIso_firstOrderThickeningConormalSheafMap {i : X ⟶ X'}
    {j : S ⟶ S'} (hi : IsFirstOrderThickening i) (hj : IsFirstOrderThickening j)
    (φ : Arrow.mk i ⟶ Arrow.mk j) [Flat φ.left] :
    letI := hi.1
    letI := hj.1
    (Flat φ.right ∧ IsPullback i φ.left φ.right j) ↔
      IsIso (firstOrderThickeningConormalSheafMap hi hj φ) := by
  let := hi.1
  let := hj.1
  refine ⟨fun h => ?_,
    flat_and_isPullback_of_isIso_firstOrderThickeningConormalSheafMap hi hj φ⟩
  have := h.1
  exact isIso_firstOrderThickeningConormalSheafMap hi hj φ h.2

end Stacks.Thickenings

