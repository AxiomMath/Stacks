/-!
# Finite-type approximation of quasi-coherent modules on a groupoid scheme

Let `G` be a groupoid scheme whose object and arrow schemes are affine, and suppose the ring of
functions on the arrow scheme is free as a module over the ring of functions on the object
scheme via the source map.  Then every quasi-coherent module on `G` is a filtered colimit of
quasi-coherent modules on `G` whose underlying sheaves are of finite type.

The construction is the one of the source.  Choose a basis of the arrow ring over the object
ring.  Expanding a global section of the pullback of a module along the source map in that basis
gives, for every global section `m` of the module, a finitely supported family of *descent
coefficients* — the coefficients of `α(t^*m)` — and the cocycle and identity conditions become
a coassociativity and a counit statement for those coefficients.  The submodule generated by the
coefficients of a single section is therefore finitely generated, contains that section, and is
stable under taking coefficients; such submodules are directed, their union is everything, and
each of them carries a descent morphism restricted from `α`.  Passing from modules of sections
back to sheaves on the affine object scheme gives the required filtered diagram, and the colimit
is computed on underlying modules.

## Main results

* `AlgebraicGeometry.GroupoidScheme.exists_filtered_diagram_of_isFiniteType` expresses a
  quasi-coherent module on such a groupoid scheme as the colimit of a filtered diagram whose
  underlying sheaves are of finite type.

## Implementation notes

The unique finite-sum expansion of the source is expressed by freeness of the arrow ring as a
module over the object ring via pullback along the source map.  The conclusion is packaged as a
colimiting cocone, including the compatible maps to the given module, rather than only as the
existence of a diagram.

Over an affine scheme the category of modules is related to modules over the ring of global
sections by the adjunction obtained from `AlgebraicGeometry.tilde.adjunction` and pullback along
`AlgebraicGeometry.Scheme.toSpecΓ`; its unit is invertible and its counit is invertible at every
quasi-coherent module.  That adjunction, rather than an equivalence of categories, is what the
arguments below use, so that no inverse functor has to be constructed.  Its right adjoint
`moduleΓFunctor` writes its value as `ModuleCat.of Γ(X, ⊤) Γ(F, ⊤)`, which is the spelling in
which a later search for `Module ↑Γ(X, ⊤) ↑((moduleΓFunctor X).obj F)` succeeds.

The identification of the global sections of a pullback with a base change of global sections is
not rebuilt here: it is `Stacks.AlgebraicGeometry.ModuleLimits.bcTop`, together with its
normalisation `bcTop_hom_one_tmul` on the elements `1 ⊗ₜ a`.

Because pullback of modules is only a pseudofunctor, every comparison between a pullback along a
composite and an iterated pullback is carried explicitly; `pullbackSection` and
`reindexSection` are the resulting operations on global sections.

## References

* [Stacks Project, Tag 07TV](https://stacks.math.columbia.edu/tag/07TV)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Stacks.Groupoids
open Stacks.Groupoids.GroupoidScheme
open scoped TensorProduct ChangeOfRings

universe u v w

namespace AlgebraicGeometry.GroupoidScheme

/-- The action of a morphism of `𝒪_X`-modules on global sections, as a `Γ(X, ⊤)`-linear map.

This is the one spelling of that map used in this file.  Reading it off `k.val.app (.op ⊤)`
gives the same function, but linear over `X.ringCatSheaf.obj.obj (.op ⊤)` and with codomain
`↑(H.val.obj (.op ⊤))`; those agree with `Γ(X, ⊤)` and `↑Γ(H, ⊤)` definitionally only.  A goal
mixing the two is accepted at default transparency and is then not type-correct at the `implicit`
transparency that `rw` and `simp` type-check at, so every rewrite on it fails. -/
private def appΓ {X : Scheme.{u}} {F H : X.Modules} (k : F ⟶ H) :
    Γ(F, ⊤) →ₗ[Γ(X, ⊤)] Γ(H, ⊤) where
  toFun := (k.val.app (.op ⊤)).hom
  map_add' := map_add _
  map_smul' r x := (k.val.app (.op ⊤)).hom.map_smul r x

/-- `appΓ` takes a composite to the composite of the induced maps on global sections.

Stating this as a rewrite rule is what keeps a long composite out of a single `change`: the
unfolding of `appΓ` on an iterated composition is definitional, but checking it in one step on a
five-fold composite exhausts the elaborator's recursion budget. -/
private lemma appΓ_comp {X : Scheme.{u}} {F H K : X.Modules} (f : F ⟶ H) (g : H ⟶ K)
    (x : Γ(F, ⊤)) : (appΓ (f ≫ g)) x = (appΓ g) ((appΓ f) x) :=
  rfl

/-- The canonical semilinear map from global sections of a module to global sections of its
pullback, given by the unit of the pullback-pushforward adjunction. -/
private noncomputable def pullbackSection {X Y : Scheme.{u}} (f : X ⟶ Y) (F : Y.Modules) :
    Γ(F, ⊤) →ₛₗ[f.appTop.hom] Γ((Scheme.Modules.pullback f).obj F, ⊤) where
  toFun := (appΓ ((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app F))
  map_add' := map_add _
  map_smul' r m :=
    (appΓ ((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app F)).map_smul r m

private lemma pullbackSection_naturality {X Y : Scheme.{u}} (f : X ⟶ Y)
    {F H : Y.Modules} (k : F ⟶ H) (m : Γ(F, ⊤)) :
    (appΓ ((Scheme.Modules.pullback f).map k)) (pullbackSection f F m) =
      pullbackSection f H ((appΓ k) m) :=
  congr((appΓ $((Scheme.Modules.pullbackPushforwardAdjunction f).unit.naturality k)) m).symm

private lemma pullbackSection_comp {X Y Z : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ Z) (F : Z.Modules) (m : Γ(F, ⊤)) :
    (appΓ ((Scheme.Modules.pullbackComp f g).inv.app F))
        (pullbackSection (f ≫ g) F m) =
      pullbackSection f ((Scheme.Modules.pullback g).obj F) (pullbackSection g F m) := by
  have h := unit_conjugateEquiv
    ((Scheme.Modules.pullbackPushforwardAdjunction g).comp
      (Scheme.Modules.pullbackPushforwardAdjunction f))
    (Scheme.Modules.pullbackPushforwardAdjunction (f ≫ g))
    (Scheme.Modules.pullbackComp f g).inv F
  rw [Scheme.Modules.conjugateEquiv_pullbackComp_inv] at h
  exact congr((appΓ $(h)) m).symm

private lemma pullbackSection_id {X : Scheme.{u}} (F : X.Modules) (m : Γ(F, ⊤)) :
    (appΓ ((Scheme.Modules.pullbackId X).hom.app F))
      (pullbackSection (𝟙 X) F m) = m := by
  have h := unit_conjugateEquiv Adjunction.id
    (Scheme.Modules.pullbackPushforwardAdjunction (𝟙 X))
    (Scheme.Modules.pullbackId X).hom F
  rw [Scheme.Modules.conjugateEquiv_pullbackId_hom] at h
  exact congr((appΓ $(h)) m).symm

private lemma pullbackSection_congr {X Y : Scheme.{u}} {f g : X ⟶ Y}
    (h : f = g) (F : Y.Modules) (m : Γ(F, ⊤)) :
    (appΓ ((Scheme.Modules.pullbackCongr h).hom.app F))
      (pullbackSection f F m) = pullbackSection g F m := by
  subst g
  rfl

/-- Global sections of a module on `X`, as a module over the ring of global sections of `X`.

The value is written `ModuleCat.of Γ(X, ⊤) Γ(F, ⊤)` rather than `F.val.obj (.op ⊤)`.  The two
are definitionally equal, but a search for an instance on the second has to take the ring from
`X.ringCatSheaf`, and the resulting `Module ↑(X.ringCatSheaf.obj.obj (.op ⊤)) _` is not the
`Module ↑Γ(X, ⊤) _` that the consumers below ask for. -/
private noncomputable def moduleΓFunctor (X : Scheme.{u}) : X.Modules ⥤ ModuleCat Γ(X, ⊤) where
  obj F := ModuleCat.of Γ(X, ⊤) Γ(F, ⊤)
  map k := ModuleCat.ofHom (appΓ k)

/-- A global section of a module on `X` is acted on in the same way by `Γ(X, ⊤)` whether it is
read on `X` or on `Spec Γ(X, ⊤)` after pushing forward along `AlgebraicGeometry.Scheme.toSpecΓ`.

On the right the action is the one of the structure sheaf of `X`; on the left it is the action on
a module over a spectrum, which multiplies by `(Scheme.ΓSpecIso Γ(X, ⊤)).inv` and then restricts
along `X.toSpecΓ`.  The two are *not* definitionally equal — the composite of `Scheme.ΓSpecIso`
with `AlgebraicGeometry.Scheme.toSpecΓ_appTop` is what identifies them — so the comparison has to
be made here, once, rather than hoped for at each use. -/
private lemma smul_pushforward_toSpecΓ (X : Scheme.{u}) (F : X.Modules) (r : Γ(X, ⊤))
    (m : Γ((Scheme.Modules.pushforward X.toSpecΓ).obj F, ⊤)) :
    r • m = @HSMul.hSMul ↑Γ(X, ⊤) ↑Γ(F, ⊤) ↑Γ(F, ⊤) instHSMul r m := by
  rw [Scheme.Modules.smul_Spec_def,
    show (⊤ : (Spec Γ(X, ⊤)).Opens).leTop.op = 𝟙 (Opposite.op (⊤ : (Spec Γ(X, ⊤)).Opens)) from
      Subsingleton.elim _ _,
    CategoryTheory.Functor.map_id]
  show @HSMul.hSMul ↑Γ(X, ⊤) ↑Γ(F, ⊤) ↑Γ(F, ⊤) instHSMul
      (X.toSpecΓ.appTop ((Scheme.ΓSpecIso Γ(X, ⊤)).inv r)) m = _
  rw [Scheme.toSpecΓ_appTop]
  simp

/-- The global sections of a module, read on `Spec Γ(X, ⊤)` after pushing forward and read on
`X`: the same module, by `smul_pushforward_toSpecΓ`. -/
private def pushforwardToSpecΓLinearEquiv (X : Scheme.{u}) (F : X.Modules) :
    Γ((Scheme.Modules.pushforward X.toSpecΓ).obj F, ⊤) ≃ₗ[Γ(X, ⊤)] Γ(F, ⊤) where
  toFun x := x
  invFun x := x
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' r x := smul_pushforward_toSpecΓ X F r x

/-- Pushing a module forward to the spectrum of the ring of global sections and taking global
sections there is taking global sections. -/
private noncomputable def pushforwardToSpecΓIso (X : Scheme.{u}) :
    Scheme.Modules.pushforward X.toSpecΓ ⋙ moduleSpecΓFunctor ≅ moduleΓFunctor X :=
  NatIso.ofComponents (fun F ↦ (pushforwardToSpecΓLinearEquiv X F).toModuleIso) (fun _ ↦ rfl)

/-- The adjunction between modules over the ring of global sections of a scheme and modules on
the scheme, obtained from the associated-sheaf adjunction on the spectrum. -/
private noncomputable def affineTildeAdjunction (X : Scheme.{u}) :
    (tilde.functor Γ(X, ⊤) ⋙ Scheme.Modules.pullback X.toSpecΓ) ⊣ moduleΓFunctor X :=
  (tilde.adjunction.comp
    (Scheme.Modules.pullbackPushforwardAdjunction X.toSpecΓ)).ofNatIsoRight
      (pushforwardToSpecΓIso X)

/-- Pushing modules forward along an isomorphism of schemes is an equivalence, with inverse the
push-forward along the inverse. -/
lemma pushforward_isEquivalence {X Y : Scheme.{u}} (e : X ≅ Y) :
    (Scheme.Modules.pushforward e.hom).IsEquivalence :=
  .mk' (Scheme.Modules.pushforward e.inv)
    ((Scheme.Modules.pushforwardComp e.hom e.inv) ≪≫
      Scheme.Modules.pushforwardCongr e.hom_inv_id ≪≫ Scheme.Modules.pushforwardId X).symm
    ((Scheme.Modules.pushforwardComp e.inv e.hom) ≪≫
      Scheme.Modules.pushforwardCongr e.inv_hom_id ≪≫ Scheme.Modules.pushforwardId Y)

/-- Pushforward along an isomorphism of schemes is pullback along its inverse. -/
private noncomputable def pushforwardIsoPullbackInv {X Y : Scheme.{u}} (e : X ≅ Y) :
    Scheme.Modules.pushforward e.hom ≅ Scheme.Modules.pullback e.inv := by
  have := pushforward_isEquivalence e
  exact (Functor.rightUnitor _).symm ≪≫
    Functor.isoWhiskerLeft _ ((Scheme.Modules.pullbackComp e.inv e.hom) ≪≫
      Scheme.Modules.pullbackCongr e.inv_hom_id ≪≫ Scheme.Modules.pullbackId Y).symm ≪≫
    (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight
      (asIso (Scheme.Modules.pullbackPushforwardAdjunction e.hom).counit) _ ≪≫
    Functor.leftUnitor _

private lemma affineTilde_unit_isIso (X : Scheme.{u}) [IsAffine X] :
    IsIso (affineTildeAdjunction X).unit := by
  have : (Scheme.Modules.pullback X.toSpecΓ).IsEquivalence :=
    Scheme.Modules.isEquivalence_pullback_of_isIso X.toSpecΓ
  apply Adjunction.unit_isIso_of_L_fully_faithful

private lemma affineTilde_counit_app_isIso (X : Scheme.{u}) [IsAffine X]
    (M : X.Modules) [M.IsQuasicoherent] :
    IsIso ((affineTildeAdjunction X).counit.app M) := by
  have : (Scheme.Modules.pushforward X.toSpecΓ).IsEquivalence :=
    pushforward_isEquivalence X.isoSpec
  have : ((Scheme.Modules.pushforward X.toSpecΓ).obj M).IsQuasicoherent :=
    Stacks.AlgebraicGeometry.AffinePushforward.isQuasicoherent_pushforward_of_isIso X.isoSpec M
  have : IsIso (tilde.adjunction.counit.app ((Scheme.Modules.pushforward X.toSpecΓ).obj M)) :=
    inferInstanceAs (IsIso ((Scheme.Modules.pushforward X.toSpecΓ).obj M).fromTildeΓ)
  simp only [affineTildeAdjunction, Adjunction.ofNatIsoRight_counit,
    NatTrans.comp_app, Functor.whiskerRight_app, Adjunction.comp_counit_app]
  infer_instance

/-- Over affine schemes, global sections of a pullback of a quasi-coherent module are the base
change of its global sections along the map on global sections.

This is `Stacks.AlgebraicGeometry.ModuleLimits.bcTop`.  Building it instead by uniqueness of
left adjoints — comparing the units of two adjunctions through `Scheme.Modules.pullbackComp` and
`Scheme.Modules.pullbackCongr` — is what forces definitional identifications that Mathlib makes
only inside its own definitions of those comparisons, and is not needed.

The tensor product is written over the `Algebra` structure induced by `f.appTop`, which is the
spelling every statement below uses.  `ModuleCat.extendScalars` presents the same module with its
scalars given by `Module.compHom`; the two are definitionally but not syntactically equal, and a
chain that mixes them is accepted and then blocks every `rw`. -/
private noncomputable def affinePullbackΓEquiv {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (f : X ⟶ Y) (M : Y.Modules) [M.IsQuasicoherent] :
    letI := f.appTop.hom.toAlgebra
    (Γ(X, ⊤) ⊗[Γ(Y, ⊤)] Γ(M, ⊤)) ≃ₗ[Γ(X, ⊤)] Γ((Scheme.Modules.pullback f).obj M, ⊤) :=
  (Stacks.AlgebraicGeometry.ModuleLimits.bcTop f M).toLinearEquiv

private lemma affinePullbackΓEquiv_one_tmul {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (f : X ⟶ Y) (M : Y.Modules) [M.IsQuasicoherent] (m : Γ(M, ⊤)) :
    letI := f.appTop.hom.toAlgebra
    affinePullbackΓEquiv f M ((1 : Γ(X, ⊤)) ⊗ₜ[Γ(Y, ⊤)] m) = pullbackSection f M m :=
  (Stacks.AlgebraicGeometry.ModuleLimits.bcTop_hom_one_tmul f M m).trans
    (Scheme.Modules.pullbackSection_top f M _ m)

/-- Reindexing a global section of a pullback: the canonical map to global sections of the
pullback along the composite. -/
private noncomputable def reindexSection {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    (M : Z.Modules) :
    Γ((Scheme.Modules.pullback g).obj M, ⊤) →ₛₗ[f.appTop.hom]
      Γ((Scheme.Modules.pullback (f ≫ g)).obj M, ⊤) :=
  (appΓ ((Scheme.Modules.pullbackComp f g).hom.app M)).comp
    (pullbackSection f ((Scheme.Modules.pullback g).obj M))

private lemma reindexSection_pullbackSection {X Y Z : Scheme.{u}} (f : X ⟶ Y)
    (g : Y ⟶ Z) (M : Z.Modules) (m : Γ(M, ⊤)) :
    reindexSection f g M (pullbackSection g M m) = pullbackSection (f ≫ g) M m := by
  show (appΓ ((Scheme.Modules.pullbackComp f g).hom.app M))
    (pullbackSection f _ (pullbackSection g M m)) = _
  rw [← pullbackSection_comp]
  exact congr((appΓ $( (Scheme.Modules.pullbackComp f g).inv_hom_id_app M
    )) (pullbackSection (f ≫ g) M m))

/-- The retraction of `pullbackSection` along a section of the morphism.

The three comparison maps are taken through `appΓ`, so that all four factors are linear over
`Γ(X, ⊤)` in one spelling; over the `X.ringCatSheaf` spelling the composition has no
`RingHomCompTriple`. -/
private noncomputable def sectionRetraction {X Y : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ X)
    (h : f ≫ g = 𝟙 X) (F : X.Modules) :
    Γ((Scheme.Modules.pullback g).obj F, ⊤) →ₛₗ[f.appTop.hom] Γ(F, ⊤) :=
  (appΓ ((Scheme.Modules.pullbackId X).hom.app F)).comp
    ((appΓ ((Scheme.Modules.pullbackCongr h).hom.app F)).comp
      ((appΓ ((Scheme.Modules.pullbackComp f g).hom.app F)).comp
        (pullbackSection f ((Scheme.Modules.pullback g).obj F))))

private lemma sectionRetraction_pullbackSection {X Y : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ X) (h : f ≫ g = 𝟙 X) (F : X.Modules) (m : Γ(F, ⊤)) :
    sectionRetraction f g h F (pullbackSection g F m) = m := by
  have hc' : (appΓ ((Scheme.Modules.pullbackComp f g).hom.app F))
      (pullbackSection f _ (pullbackSection g F m)) = pullbackSection (f ≫ g) F m :=
    reindexSection_pullbackSection f g F m
  show (appΓ ((Scheme.Modules.pullbackId X).hom.app F))
    ((appΓ ((Scheme.Modules.pullbackCongr h).hom.app F))
      ((appΓ ((Scheme.Modules.pullbackComp f g).hom.app F))
        (pullbackSection f _ (pullbackSection g F m)))) = m
  rw [hc']
  exact (congrArg (fun x ↦ (appΓ ((Scheme.Modules.pullbackId X).hom.app F)) x)
    (pullbackSection_congr h F m)).trans (pullbackSection_id F m)

/-- The isomorphism underlying `sectionRetraction`. -/
private noncomputable def sectionRetractionIso {X Y : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ X)
    (h : f ≫ g = 𝟙 X) (F : X.Modules) :
    (Scheme.Modules.pullback f).obj ((Scheme.Modules.pullback g).obj F) ≅ F :=
  (Scheme.Modules.pullbackComp f g).app F ≪≫
    (Scheme.Modules.pullbackCongr h).app F ≪≫ (Scheme.Modules.pullbackId X).app F

private lemma identityDescent_eq {S : Scheme.{u}} (G : GroupoidScheme S)
    (M : QuasicoherentModule G) :
    identityDescent G M.alpha =
      (sectionRetractionIso G.identity.left G.target.left
        (congrArg Over.Hom.left G.target_identity) M.module).inv ≫
      (Scheme.Modules.pullback G.identity.left).map M.alpha ≫
      (sectionRetractionIso G.identity.left G.source.left
        (congrArg Over.Hom.left G.source_identity) M.module).hom := by
  rfl

private lemma sectionRetraction_alpha {S : Scheme.{u}} (G : GroupoidScheme S)
    (M : QuasicoherentModule G) (m : Γ(M.module, ⊤)) :
    sectionRetraction G.identity.left G.source.left
      (congrArg Over.Hom.left G.source_identity) M.module
        ((appΓ M.alpha) (pullbackSection G.target.left M.module m)) = m := by
  let et := sectionRetractionIso G.identity.left G.target.left
    (congrArg Over.Hom.left G.target_identity) M.module
  let es := sectionRetractionIso G.identity.left G.source.left
    (congrArg Over.Hom.left G.source_identity) M.module
  have ht := sectionRetraction_pullbackSection G.identity.left G.target.left
    (congrArg Over.Hom.left G.target_identity) M.module m
  change (appΓ et.hom)
    (pullbackSection G.identity.left _
      (pullbackSection G.target.left M.module m)) = m at ht
  have ht' := congrArg (fun x ↦ (appΓ et.inv) x) ht
  have hc (x : Γ((Scheme.Modules.pullback G.identity.left).obj
      ((Scheme.Modules.pullback G.target.left).obj M.module), ⊤)) :
      (appΓ et.inv) ((appΓ et.hom) x) = x :=
    congr((appΓ $(et.hom_inv_id)) x)
  rw [hc] at ht'
  have hm := congr((appΓ $(M.identity)) m)
  rw [identityDescent_eq] at hm
  change (appΓ es.hom)
    ((appΓ ((Scheme.Modules.pullback G.identity.left).map M.alpha))
      ((appΓ et.inv) m)) = m at hm
  rw [← ht'] at hm
  have hn := pullbackSection_naturality G.identity.left M.alpha
    (pullbackSection G.target.left M.module m)
  exact (congrArg (fun x ↦ (appΓ es.hom) x) hn).symm.trans hm

private lemma affinePullbackΓEquiv_tmul {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (f : X ⟶ Y) (M : Y.Modules) [M.IsQuasicoherent]
    (b : Γ(X, ⊤)) (m : Γ(M, ⊤)) :
    letI := f.appTop.hom.toAlgebra
    affinePullbackΓEquiv f M (b ⊗ₜ[Γ(Y, ⊤)] m) = b • pullbackSection f M m := by
  let := f.appTop.hom.toAlgebra
  have hb : (b ⊗ₜ[Γ(Y, ⊤)] m : Γ(X, ⊤) ⊗[Γ(Y, ⊤)] Γ(M, ⊤)) =
      b • ((1 : Γ(X, ⊤)) ⊗ₜ[Γ(Y, ⊤)] m) := by
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  rw [hb, map_smul, affinePullbackΓEquiv_one_tmul]

private lemma exists_pullbackSection_sum {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (f : X ⟶ Y) (M : Y.Modules) [M.IsQuasicoherent] {ι : Type u}
    (b : letI := f.appTop.hom.toAlgebra; Module.Basis ι Γ(Y, ⊤) Γ(X, ⊤))
    (x : Γ((Scheme.Modules.pullback f).obj M, ⊤)) :
    ∃ c : ι →₀ Γ(M, ⊤), x = c.sum (fun i m ↦ b i • pullbackSection f M m) := by
  classical
  let := f.appTop.hom.toAlgebra
  obtain ⟨c, hc⟩ := TensorProduct.eq_repr_basis_left b
    (x := (affinePullbackΓEquiv f M).symm x)
  refine ⟨c, ?_⟩
  calc
    x = affinePullbackΓEquiv f M (c.sum (fun i m ↦ b i ⊗ₜ[Γ(Y, ⊤)] m)) := by
      rw [hc, (affinePullbackΓEquiv f M).apply_symm_apply]
    _ = _ := by
      simp only [Finsupp.sum, map_sum]
      apply Finset.sum_congr rfl
      intro i _
      exact affinePullbackΓEquiv_tmul f M (b i) (c i)

private lemma exists_descent_coefficients_mem_span {S : Scheme.{u}}
    (G : GroupoidScheme S) [IsAffine G.objects.left] [IsAffine G.arrows.left]
    (M : QuasicoherentModule G) {ι : Type u}
    (b : letI := G.source.left.appTop.hom.toAlgebra
      Module.Basis ι Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤))
    (m : Γ(M.module, ⊤)) :
    ∃ c : ι →₀ Γ(M.module, ⊤),
      (appΓ M.alpha) (pullbackSection G.target.left M.module m) =
        c.sum (fun i n ↦ b i • pullbackSection G.source.left M.module n) ∧
      m ∈ Submodule.span Γ(G.objects.left, ⊤) (Set.range c) := by
  obtain ⟨c, hc⟩ := exists_pullbackSection_sum G.source.left M.module b
    ((appΓ M.alpha) (pullbackSection G.target.left M.module m))
  refine ⟨c, hc, ?_⟩
  let r := sectionRetraction G.identity.left G.source.left
    (congrArg Over.Hom.left G.source_identity) M.module
  have hm : r ((appΓ M.alpha) (pullbackSection G.target.left M.module m)) = m :=
    sectionRetraction_alpha G M m
  rw [hc, Finsupp.sum, map_sum] at hm
  rw [← hm]
  refine Submodule.sum_mem _ fun i _ ↦ ?_
  rw [r.map_smulₛₗ, sectionRetraction_pullbackSection]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

/-- Expansion of a global section of a pullback along a morphism of affine schemes in a chosen
basis of the target ring, as an additive equivalence onto finitely supported families. -/
private noncomputable def pullbackCoefficients {X Y : Scheme.{u}}
    [IsAffine X] [IsAffine Y] (f : X ⟶ Y) (M : Y.Modules) [M.IsQuasicoherent]
    {ι : Type u}
    (b : letI := f.appTop.hom.toAlgebra; Module.Basis ι Γ(Y, ⊤) Γ(X, ⊤)) :
    Γ((Scheme.Modules.pullback f).obj M, ⊤) ≃+ (ι →₀ Γ(M, ⊤)) := by
  classical
  let := f.appTop.hom.toAlgebra
  exact (affinePullbackΓEquiv f M).symm.toAddEquiv.trans
    (TensorProduct.equivFinsuppOfBasisLeft b).toAddEquiv

private lemma pullbackCoefficients_smul_section {X Y : Scheme.{u}}
    [IsAffine X] [IsAffine Y] (f : X ⟶ Y) (M : Y.Modules) [M.IsQuasicoherent]
    {ι : Type u}
    (b : letI := f.appTop.hom.toAlgebra; Module.Basis ι Γ(Y, ⊤) Γ(X, ⊤))
    (r : Γ(X, ⊤)) (m : Γ(M, ⊤)) (i : ι) :
    letI := f.appTop.hom.toAlgebra
    pullbackCoefficients f M b (r • pullbackSection f M m) i = b.repr r i • m := by
  classical
  let := f.appTop.hom.toAlgebra
  rw [← affinePullbackΓEquiv_tmul f M r m]
  show TensorProduct.equivFinsuppOfBasisLeft b
    ((affinePullbackΓEquiv f M).symm
      (affinePullbackΓEquiv f M (r ⊗ₜ[Γ(Y, ⊤)] m))) i = _
  rw [LinearEquiv.symm_apply_apply]
  exact TensorProduct.equivFinsuppOfBasisLeft_apply_tmul_apply b r m i

private lemma pullbackCoefficients_basis_section {X Y : Scheme.{u}}
    [IsAffine X] [IsAffine Y] (f : X ⟶ Y) (M : Y.Modules) [M.IsQuasicoherent]
    {ι : Type u}
    (b : letI := f.appTop.hom.toAlgebra; Module.Basis ι Γ(Y, ⊤) Γ(X, ⊤))
    (j : ι) (m : Γ(M, ⊤)) :
    pullbackCoefficients f M b (b j • pullbackSection f M m) = Finsupp.single j m := by
  classical
  ext i
  rw [pullbackCoefficients_smul_section]
  simp only [Module.Basis.repr_self]
  by_cases h : j = i <;> simp [h]

private lemma pullbackCoefficients_sum {X Y : Scheme.{u}}
    [IsAffine X] [IsAffine Y] (f : X ⟶ Y) (M : Y.Modules) [M.IsQuasicoherent]
    {ι : Type u}
    (b : letI := f.appTop.hom.toAlgebra; Module.Basis ι Γ(Y, ⊤) Γ(X, ⊤))
    (c : ι →₀ Γ(M, ⊤)) :
    pullbackCoefficients f M b (c.sum (fun i m ↦ b i • pullbackSection f M m)) = c := by
  classical
  simp only [Finsupp.sum, map_sum, pullbackCoefficients_basis_section]
  exact Finsupp.sum_single c

private lemma pullbackCoefficients_expansion {X Y : Scheme.{u}}
    [IsAffine X] [IsAffine Y] (f : X ⟶ Y) (M : Y.Modules) [M.IsQuasicoherent]
    {ι : Type u}
    (b : letI := f.appTop.hom.toAlgebra; Module.Basis ι Γ(Y, ⊤) Γ(X, ⊤))
    (x : Γ((Scheme.Modules.pullback f).obj M, ⊤)) :
    (pullbackCoefficients f M b x).sum (fun i m ↦ b i • pullbackSection f M m) = x :=
  (pullbackCoefficients f M b).injective (pullbackCoefficients_sum f M b _)

/-- Evaluating at `i` a sum of singletons `single j (g (c j))` over the support of `c` gives
`g (c i)`. -/
private lemma sum_single_apply_support {ι : Type*} {N N' : Type*} [Zero N] [AddCommMonoid N']
    (c : ι →₀ N) (g : N → N') (hg : g 0 = 0) (i : ι) :
    ∑ j ∈ c.support, (Finsupp.single j (g (c j))) i = g (c i) := by
  classical
  simp only [Finsupp.single_apply]
  rw [Finset.sum_ite_eq']
  split_ifs with hi
  · rfl
  · simp only [Finsupp.notMem_support_iff.mp hi, hg]

private lemma pullbackCoefficients_naturality {X Y : Scheme.{u}}
    [IsAffine X] [IsAffine Y] (f : X ⟶ Y) {F H : Y.Modules}
    [F.IsQuasicoherent] [H.IsQuasicoherent] (k : F ⟶ H) {ι : Type u}
    (b : letI := f.appTop.hom.toAlgebra; Module.Basis ι Γ(Y, ⊤) Γ(X, ⊤))
    (x : Γ((Scheme.Modules.pullback f).obj F, ⊤)) (i : ι) :
    pullbackCoefficients f H b ((appΓ ((Scheme.Modules.pullback f).map k)) x) i =
      (appΓ k) (pullbackCoefficients f F b x i) := by
  classical
  obtain ⟨c, rfl⟩ := exists_pullbackSection_sum f F b x
  rw [pullbackCoefficients_sum]
  simp only [Finsupp.sum, map_sum, map_smul, pullbackSection_naturality,
    Finsupp.finsetSum_apply]
  exact (Finset.sum_congr rfl fun j _ ↦ congrArg (fun z : ι →₀ Γ(H, ⊤) ↦ z i)
    (pullbackCoefficients_basis_section f H b j ((appΓ k) (c j)))).trans
      (sum_single_apply_support c (appΓ k) (map_zero _) i)

private lemma pullbackCoefficients_smul_mem_span {X Y : Scheme.{u}}
    [IsAffine X] [IsAffine Y] (f : X ⟶ Y) (F : Y.Modules) [F.IsQuasicoherent]
    {ι : Type u}
    (b : letI := f.appTop.hom.toAlgebra; Module.Basis ι Γ(Y, ⊤) Γ(X, ⊤))
    (x : Γ((Scheme.Modules.pullback f).obj F, ⊤)) (r : Γ(X, ⊤)) (i : ι) :
    pullbackCoefficients f F b (r • x) i ∈
      Submodule.span Γ(Y, ⊤) (Set.range (pullbackCoefficients f F b x)) := by
  let c := pullbackCoefficients f F b x
  have hx : x = c.sum (fun j n ↦ b j • pullbackSection f F n) :=
    (pullbackCoefficients_expansion f F b x).symm
  show pullbackCoefficients f F b (r • x) i ∈ Submodule.span Γ(Y, ⊤) (Set.range c)
  rw [hx]
  simp only [Finsupp.sum, Finset.smul_sum, smul_smul, map_sum,
    Finsupp.finsetSum_apply, pullbackCoefficients_smul_section]
  exact Submodule.sum_mem _ (fun j _ ↦
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩))

private lemma pullback_injective_of_basis {X Y : Scheme.{u}}
    [IsAffine X] [IsAffine Y] (f : X ⟶ Y) {F H : Y.Modules}
    [F.IsQuasicoherent] [H.IsQuasicoherent] (k : F ⟶ H) {ι : Type u}
    (b : letI := f.appTop.hom.toAlgebra; Module.Basis ι Γ(Y, ⊤) Γ(X, ⊤))
    (hk : Function.Injective ((appΓ k))) :
    Function.Injective ((appΓ ((Scheme.Modules.pullback f).map k))) := by
  intro x y h
  apply (pullbackCoefficients f F b).injective
  ext i
  apply hk
  simpa only [pullbackCoefficients_naturality] using
    congrArg (fun z ↦ pullbackCoefficients f H b z i) h

private lemma mem_range_pullback_of_coefficients {X Y : Scheme.{u}}
    [IsAffine X] [IsAffine Y] (f : X ⟶ Y) {F H : Y.Modules}
    [F.IsQuasicoherent] [H.IsQuasicoherent] (k : F ⟶ H) {ι : Type u}
    (b : letI := f.appTop.hom.toAlgebra; Module.Basis ι Γ(Y, ⊤) Γ(X, ⊤))
    (x : Γ((Scheme.Modules.pullback f).obj H, ⊤))
    (hx : ∀ i, pullbackCoefficients f H b x i ∈
      LinearMap.range (appΓ k)) :
    x ∈ LinearMap.range (appΓ ((Scheme.Modules.pullback f).map k)) := by
  rw [← pullbackCoefficients_expansion f H b x]
  refine Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _ ?_
  obtain ⟨n, hn⟩ := hx i
  exact ⟨pullbackSection f F n, (pullbackSection_naturality f k n).trans
    (congrArg (pullbackSection f H) hn)⟩

/-- A morphism of modules over the ring of global sections of an affine scheme, realized as a
morphism of quasi-coherent modules. -/
private noncomputable def affineHom {X : Scheme.{u}} [IsAffine X]
    {F H : X.Modules} [F.IsQuasicoherent]
    (k : (moduleΓFunctor X).obj F ⟶ (moduleΓFunctor X).obj H) : F ⟶ H := by
  have := affineTilde_counit_app_isIso X F
  exact inv ((affineTildeAdjunction X).counit.app F) ≫
    (tilde.functor Γ(X, ⊤) ⋙ Scheme.Modules.pullback X.toSpecΓ).map k ≫
    (affineTildeAdjunction X).counit.app H

private lemma affineHom_sections {X : Scheme.{u}} [IsAffine X]
    {F H : X.Modules} [F.IsQuasicoherent]
    (k : (moduleΓFunctor X).obj F ⟶ (moduleΓFunctor X).obj H) :
    (moduleΓFunctor X).map (affineHom k) = k := by
  have := affineTilde_counit_app_isIso X F
  have hunit : (moduleΓFunctor X).map (inv ((affineTildeAdjunction X).counit.app F)) =
      (affineTildeAdjunction X).unit.app ((moduleΓFunctor X).obj F) := by
    apply (cancel_mono ((moduleΓFunctor X).map
      ((affineTildeAdjunction X).counit.app F))).mp
    rw [← Functor.map_comp, IsIso.inv_hom_id, CategoryTheory.Functor.map_id,
      (affineTildeAdjunction X).right_triangle_components]
    rfl
  simp only [affineHom, Functor.map_comp, hunit]
  have hn := (affineTildeAdjunction X).unit.naturality k
  simp only [CategoryTheory.Functor.id_map, CategoryTheory.Functor.comp_map] at hn
  simp only [CategoryTheory.Functor.comp_map]
  rw [← Category.assoc, ← hn, Category.assoc,
    (affineTildeAdjunction X).right_triangle_components]
  exact CategoryTheory.Category.comp_id k

private lemma affine_hom_ext {X : Scheme.{u}} [IsAffine X]
    {F H : X.Modules} [F.IsQuasicoherent] {f g : F ⟶ H}
    (h : (moduleΓFunctor X).map f = (moduleΓFunctor X).map g) : f = g := by
  have := affineTilde_counit_app_isIso X F
  apply (cancel_epi ((affineTildeAdjunction X).counit.app F)).mp
  exact ((affineTildeAdjunction X).counit.naturality f).symm.trans
    ((congrArg (fun k ↦
      (tilde.functor Γ(X, ⊤) ⋙ Scheme.Modules.pullback X.toSpecΓ).map k ≫
        (affineTildeAdjunction X).counit.app H) h).trans
      ((affineTildeAdjunction X).counit.naturality g))

private lemma isQuasicoherent_affineTilde (X : Scheme.{u}) [IsAffine X]
    (N : ModuleCat Γ(X, ⊤)) :
    ((tilde.functor Γ(X, ⊤) ⋙ Scheme.Modules.pullback X.toSpecΓ).obj N).IsQuasicoherent := by
  apply (SheafOfModules.isQuasicoherent X.ringCatSheaf).prop_of_iso
    ((Scheme.Modules.restrictFunctorIsoPullback X.toSpecΓ).app (tilde N))
  infer_instance

/-- The unit of `affineTildeAdjunction` at a module, as an isomorphism. -/
private noncomputable def affineTildeUnitIso (X : Scheme.{u}) [IsAffine X]
    (N : ModuleCat Γ(X, ⊤)) :
    N ≅ (moduleΓFunctor X).obj
      ((tilde.functor Γ(X, ⊤) ⋙ Scheme.Modules.pullback X.toSpecΓ).obj N) := by
  have := affineTilde_unit_isIso X
  exact asIso ((affineTildeAdjunction X).unit.app N)

/-- The counit of `affineTildeAdjunction` at a quasi-coherent module, as an isomorphism. -/
private noncomputable def affineTildeCounitIso (X : Scheme.{u}) [IsAffine X]
    (M : X.Modules) [M.IsQuasicoherent] :
    (tilde.functor Γ(X, ⊤) ⋙ Scheme.Modules.pullback X.toSpecΓ).obj
        ((moduleΓFunctor X).obj M) ≅ M := by
  have := affineTilde_counit_app_isIso X M
  exact asIso ((affineTildeAdjunction X).counit.app M)

/-- The quasi-coherent module on an affine scheme attached to a submodule of its module of
global sections. -/
private noncomputable abbrev affineSubmodule {X : Scheme.{u}} (M : X.Modules)
    (P : Submodule Γ(X, ⊤) Γ(M, ⊤)) : X.Modules :=
  (tilde.functor Γ(X, ⊤) ⋙ Scheme.Modules.pullback X.toSpecΓ).obj
    (ModuleCat.of Γ(X, ⊤) P)

/-- The inclusion of a submodule of the global sections, with codomain written as the value of
`moduleΓFunctor`.

`ModuleCat.ofHom P.subtype` has codomain `ModuleCat.of Γ(X, ⊤) Γ(M, ⊤)`; the right adjoint of
`affineTildeAdjunction` writes the same object as `(moduleΓFunctor X).obj M`.  The two agree
definitionally only, so an application of the hom-equivalence to the first spelling is accepted
at default transparency and is then not type-correct at the `implicit` transparency that `rw`
type-checks at.  Ascribing the type once here is what keeps those rewrites available. -/
private noncomputable def submoduleSubtypeΓ {X : Scheme.{u}} (M : X.Modules)
    (P : Submodule Γ(X, ⊤) Γ(M, ⊤)) :
    ModuleCat.of Γ(X, ⊤) P ⟶ (moduleΓFunctor X).obj M :=
  ModuleCat.ofHom P.subtype

/-- The inclusion of `affineSubmodule` into the given module. -/
private noncomputable def affineSubmoduleι {X : Scheme.{u}} (M : X.Modules)
    (P : Submodule Γ(X, ⊤) Γ(M, ⊤)) : affineSubmodule M P ⟶ M :=
  ((affineTildeAdjunction X).homEquiv (ModuleCat.of Γ(X, ⊤) P) M).symm
    (submoduleSubtypeΓ M P)

private lemma affineSubmoduleι_unit {X : Scheme.{u}} [IsAffine X] (M : X.Modules)
    (P : Submodule Γ(X, ⊤) Γ(M, ⊤)) (p : P) :
    (appΓ (affineSubmoduleι M P))
      ((affineTildeUnitIso X (ModuleCat.of Γ(X, ⊤) P)).hom p) = (p : Γ(M, ⊤)) := by
  have h := (affineTildeAdjunction X).homEquiv_unit (ModuleCat.of Γ(X, ⊤) P) M
    (affineSubmoduleι M P)
  rw [show (affineTildeAdjunction X).homEquiv (ModuleCat.of Γ(X, ⊤) P) M
      (affineSubmoduleι M P) = ModuleCat.ofHom P.subtype from
    ((affineTildeAdjunction X).homEquiv _ _).apply_symm_apply _] at h
  exact congr($(h.symm).hom p)

private lemma affineSubmoduleι_injective {X : Scheme.{u}} [IsAffine X] (M : X.Modules)
    (P : Submodule Γ(X, ⊤) Γ(M, ⊤)) :
    Function.Injective ((appΓ (affineSubmoduleι M P))) := by
  intro x y h
  obtain ⟨p, rfl⟩ :=
    (affineTildeUnitIso X (ModuleCat.of Γ(X, ⊤) P)).toLinearEquiv.surjective x
  obtain ⟨q, rfl⟩ :=
    (affineTildeUnitIso X (ModuleCat.of Γ(X, ⊤) P)).toLinearEquiv.surjective y
  have hpq : (p : Γ(M, ⊤)) = q := by
    change (appΓ (affineSubmoduleι M P))
      ((affineTildeUnitIso X (ModuleCat.of Γ(X, ⊤) P)).hom p) =
      (appΓ (affineSubmoduleι M P))
        ((affineTildeUnitIso X (ModuleCat.of Γ(X, ⊤) P)).hom q) at h
    rwa [affineSubmoduleι_unit M P p, affineSubmoduleι_unit M P q] at h
  exact congrArg (affineTildeUnitIso X (ModuleCat.of Γ(X, ⊤) P)).hom (Subtype.ext hpq)

private lemma affineSubmoduleι_range {X : Scheme.{u}} [IsAffine X] (M : X.Modules)
    (P : Submodule Γ(X, ⊤) Γ(M, ⊤)) :
    LinearMap.range (appΓ (affineSubmoduleι M P)) = P := by
  ext n
  refine ⟨?_, fun hn ↦ ⟨(affineTildeUnitIso X (ModuleCat.of Γ(X, ⊤) P)).hom ⟨n, hn⟩,
    affineSubmoduleι_unit M P ⟨n, hn⟩⟩⟩
  rintro ⟨x, rfl⟩
  obtain ⟨p, rfl⟩ :=
    (affineTildeUnitIso X (ModuleCat.of Γ(X, ⊤) P)).toLinearEquiv.surjective x
  show (appΓ (affineSubmoduleι M P))
    ((affineTildeUnitIso X (ModuleCat.of Γ(X, ⊤) P)).hom p) ∈ P
  rw [affineSubmoduleι_unit]
  exact p.property

private lemma affineSubmoduleι_naturality {X : Scheme.{u}} (M : X.Modules)
    (P Q : Submodule Γ(X, ⊤) Γ(M, ⊤)) (h : P ≤ Q) :
    (tilde.functor Γ(X, ⊤) ⋙ Scheme.Modules.pullback X.toSpecΓ).map
      (ModuleCat.ofHom (Submodule.inclusion h)) ≫ affineSubmoduleι M Q =
      affineSubmoduleι M P := by
  simp only [affineSubmoduleι]
  rw [← Adjunction.homEquiv_naturality_left_symm]
  congr 1

private lemma affineTilde_isFiniteType (X : Scheme.{u}) [IsAffine X]
    (N : ModuleCat Γ(X, ⊤)) [Module.Finite Γ(X, ⊤) N] :
    ((tilde.functor Γ(X, ⊤) ⋙ Scheme.Modules.pullback X.toSpecΓ).obj N).IsFiniteType := by
  have : (tilde N).IsFiniteType := (tilde_isFiniteType_iff N).2 inferInstance
  exact SheafOfModules.pullback_isFiniteType X.toSpecΓ.toLRSHom.toShHom (tilde N)

private lemma affine_cancel_right {X : Scheme.{u}} [IsAffine X]
    {F H K : X.Modules} [F.IsQuasicoherent] (k : H ⟶ K)
    (hk : Function.Injective ((appΓ k))) {f g : F ⟶ H}
    (h : f ≫ k = g ≫ k) : f = g := by
  apply affine_hom_ext
  ext x
  exact hk (congr((appΓ $(h)) x))

private lemma pullback_comp_injective {X Y Z : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ Z) {F H : Z.Modules} (k : F ⟶ H)
    (hk : Function.Injective
      ((appΓ ((Scheme.Modules.pullback f).map
        ((Scheme.Modules.pullback g).map k))))) :
    Function.Injective ((appΓ ((Scheme.Modules.pullback (f ≫ g)).map k))) := by
  intro x y h
  have hn := (Scheme.Modules.pullbackComp f g).inv.naturality k
  let e := ((moduleΓFunctor X).mapIso
    ((Scheme.Modules.pullbackComp f g).app F)).toLinearEquiv
  apply e.symm.injective
  apply hk
  exact (congr((appΓ $(hn)) x)).symm.trans
    ((congrArg (fun z ↦ (appΓ ((Scheme.Modules.pullbackComp f g).inv.app H)) z)
      h).trans (congr((appΓ $(hn)) y)))

/-- Given a quasi-coherent submodule of the underlying module of a groupoid module whose
descent coefficients stay inside it, the descent morphism restricts to it. -/
private lemma exists_descent_restriction {S : Scheme.{u}}
    (G : GroupoidScheme S) [IsAffine G.objects.left] [IsAffine G.arrows.left]
    (M : QuasicoherentModule G) (F : G.objects.left.Modules) [F.IsQuasicoherent]
    (k : F ⟶ M.module) (hk : Function.Injective ((appΓ k))) {ι : Type u}
    (b : letI := G.source.left.appTop.hom.toAlgebra
      Module.Basis ι Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤))
    (hstable : ∀ n : Γ(F, ⊤), ∀ i,
      pullbackCoefficients G.source.left M.module b
        ((appΓ M.alpha) (pullbackSection G.target.left M.module
          ((appΓ k) n))) i ∈ LinearMap.range (appΓ k)) :
    ∃ α : (Scheme.Modules.pullback G.target.left).obj F ⟶
        (Scheme.Modules.pullback G.source.left).obj F,
      α ≫ (Scheme.Modules.pullback G.source.left).map k =
        (Scheme.Modules.pullback G.target.left).map k ≫ M.alpha := by
  let a := (appΓ ((Scheme.Modules.pullback G.target.left).map k ≫ M.alpha))
  let j := (appΓ ((Scheme.Modules.pullback G.source.left).map k))
  have hj : Function.Injective j := pullback_injective_of_basis G.source.left k b hk
  have ha : ∀ x, a x ∈ j.range := by
    intro x
    let := G.target.left.appTop.hom.toAlgebra
    obtain ⟨z, rfl⟩ := (affinePullbackΓEquiv G.target.left F).surjective x
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero, zero_mem]
    | tmul r n =>
      show a (affinePullbackΓEquiv G.target.left F
        (r ⊗ₜ[Γ(G.objects.left, ⊤)] n)) ∈ j.range
      rw [affinePullbackΓEquiv_tmul G.target.left F r n, a.map_smul]
      apply Submodule.smul_mem
      show (appΓ M.alpha)
        ((appΓ ((Scheme.Modules.pullback G.target.left).map k))
          (pullbackSection G.target.left F n)) ∈ _
      rw [pullbackSection_naturality]
      exact mem_range_pullback_of_coefficients G.source.left k b _ (hstable n)
    | add z w hz hw =>
      rw [map_add, map_add]
      exact j.range.add_mem hz hw
  let l := (LinearEquiv.ofInjective j hj).symm.toLinearMap.comp (a.codRestrict j.range ha)
  have : ((Scheme.Modules.pullback G.target.left).obj F).IsQuasicoherent :=
    Stacks.AlgebraicGeometry.AffineBaseChange.isQuasicoherent_pullback_of_isAffine G.target.left F
  let κ : (moduleΓFunctor G.arrows.left).obj
        ((Scheme.Modules.pullback G.target.left).obj F) ⟶
      (moduleΓFunctor G.arrows.left).obj
        ((Scheme.Modules.pullback G.source.left).obj F) :=
    ModuleCat.ofHom l
  refine ⟨affineHom κ, ?_⟩
  apply affine_hom_ext
  rw [CategoryTheory.Functor.map_comp, affineHom_sections]
  ext x
  exact congrArg Subtype.val ((LinearEquiv.ofInjective j hj).apply_symm_apply
    (a.codRestrict j.range ha x))

private lemma exists_basis_of_isPullback {X Y Z P : Scheme.{u}}
    [IsAffine X] [IsAffine Y] [IsAffine Z]
    {f : X ⟶ Z} {g : Y ⟶ Z} {p : P ⟶ X} {q : P ⟶ Y}
    (h : IsPullback p q f g) {ι : Type u}
    (b : letI := f.appTop.hom.toAlgebra; Module.Basis ι Γ(Z, ⊤) Γ(X, ⊤)) :
    ∃ b' : (letI := q.appTop.hom.toAlgebra; Module.Basis ι Γ(Y, ⊤) Γ(P, ⊤)),
      ∀ i, b' i = p.appTop (b i) := by
  let := f.appTop.hom.toAlgebra
  let := g.appTop.hom.toAlgebra
  let := p.appTop.hom.toAlgebra
  let := q.appTop.hom.toAlgebra
  let := (p.appTop.hom.comp f.appTop.hom).toAlgebra
  let : IsScalarTower Γ(Z, ⊤) Γ(X, ⊤) Γ(P, ⊤) :=
    IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have heq : f.appTop ≫ p.appTop = g.appTop ≫ q.appTop :=
    (isPushout_appTop_of_isPullback h).w
  let : IsScalarTower Γ(Z, ⊤) Γ(Y, ⊤) Γ(P, ⊤) :=
    IsScalarTower.of_algebraMap_eq fun a ↦ congr($(heq).hom a)
  have hp : Algebra.IsPushout Γ(Z, ⊤) Γ(Y, ⊤) Γ(X, ⊤) Γ(P, ⊤) :=
    CommRingCat.isPushout_iff_isPushout.mp (isPushout_appTop_of_isPullback h).flip
  exact ⟨hp.out.basis b, fun i ↦ hp.out.basis_apply b i⟩

private lemma reindexHom_pullbackSection {X Y Z : Scheme.{u}} (f : X ⟶ Y)
    {g h : Y ⟶ Z} {M : Z.Modules}
    (α : (Scheme.Modules.pullback g).obj M ⟶ (Scheme.Modules.pullback h).obj M)
    (m : Γ(M, ⊤)) :
    (appΓ (reindexHom f α)) (pullbackSection (f ≫ g) M m) =
      reindexSection f h M ((appΓ α) (pullbackSection g M m)) := by
  show (appΓ ((Scheme.Modules.pullbackComp f h).hom.app M))
    ((appΓ ((Scheme.Modules.pullback f).map α))
      ((appΓ ((Scheme.Modules.pullbackComp f g).inv.app M))
        (pullbackSection (f ≫ g) M m))) = _
  rw [pullbackSection_comp f g M m]
  exact congrArg
    (fun x ↦ (appΓ ((Scheme.Modules.pullbackComp f h).hom.app M)) x)
    (pullbackSection_naturality f α (pullbackSection g M m))

private lemma pullbackCongr_cancel {X Y : Scheme.{u}} {f g : X ⟶ Y}
    (h : f = g) (M : Y.Modules) (x : Γ((Scheme.Modules.pullback g).obj M, ⊤)) :
    (appΓ ((Scheme.Modules.pullbackCongr h).hom.app M))
      ((appΓ ((Scheme.Modules.pullbackCongr h.symm).hom.app M)) x) = x := by
  subst g
  rfl

/-- The fibre product of source and target of a groupoid scheme, taken in the base, is a
pullback square of the underlying schemes. -/
private lemma isPullback_source_target {S : Scheme.{u}} (G : GroupoidScheme S) :
    IsPullback (Limits.pullback.fst G.source G.target).left
      (Limits.pullback.snd G.source G.target).left G.source.left G.target.left :=
  (IsPullback.of_hasPullback G.source G.target).map (Over.forget S)

private lemma isAffine_pullback_source_target {S : Scheme.{u}} (G : GroupoidScheme S)
    [IsAffine G.objects.left] [IsAffine G.arrows.left] :
    IsAffine (Limits.pullback G.source G.target).left :=
  .of_isIso (isPullback_source_target G).isoPullback.hom

/-- The cocycle condition, written out on the coefficients of a basis expansion. -/
private lemma descent_cocycle_expansion {S : Scheme.{u}} (G : GroupoidScheme S)
    (M : QuasicoherentModule G) {ι : Type u} (b : ι → Γ(G.arrows.left, ⊤))
    (m : Γ(M.module, ⊤)) (c : ι →₀ Γ(M.module, ⊤))
    (hc : (appΓ M.alpha) (pullbackSection G.target.left M.module m) =
      c.sum (fun i n ↦ b i • pullbackSection G.source.left M.module n)) :
    let p := (Limits.pullback.fst G.source G.target).left
    let q := (Limits.pullback.snd G.source G.target).left
    c.sum (fun i n ↦ p.appTop (b i) • pullbackSection q
      ((Scheme.Modules.pullback G.source.left).obj M.module)
      ((appΓ M.alpha) (pullbackSection G.target.left M.module n))) =
    c.sum (fun i n ↦ G.comp.left.appTop (b i) • pullbackSection q
      ((Scheme.Modules.pullback G.source.left).obj M.module)
      (pullbackSection G.source.left M.module n)) := by
  let p := (Limits.pullback.fst G.source G.target).left
  let q := (Limits.pullback.snd G.source G.target).left
  let hs : G.comp.left ≫ G.source.left = q ≫ G.source.left :=
    congrArg Over.Hom.left G.source_comp
  let ht : G.comp.left ≫ G.target.left = p ≫ G.target.left :=
    congrArg Over.Hom.left G.target_comp
  let hp : p ≫ G.source.left = q ≫ G.target.left :=
    congrArg Over.Hom.left
      (Limits.pullback.condition (f := G.source) (g := G.target))
  let E := (Scheme.Modules.pullbackCongr hs).app M.module ≪≫
    ((Scheme.Modules.pullbackComp q G.source.left).app M.module).symm
  have hE (n : Γ(M.module, ⊤)) :
      (appΓ E.hom)
          (pullbackSection (G.comp.left ≫ G.source.left) M.module n) =
        pullbackSection q _ (pullbackSection G.source.left M.module n) := by
    show (appΓ ((Scheme.Modules.pullbackComp q G.source.left).inv.app M.module))
      ((appΓ ((Scheme.Modules.pullbackCongr hs).hom.app M.module))
        (pullbackSection (G.comp.left ≫ G.source.left) M.module n)) = _
    rw [pullbackSection_congr hs, pullbackSection_comp]
  have hE' (x : Γ((Scheme.Modules.pullback G.source.left).obj M.module, ⊤)) :
      (appΓ E.hom)
        ((appΓ ((Scheme.Modules.pullbackCongr hs.symm).hom.app M.module))
          (reindexSection q G.source.left M.module x)) = pullbackSection q _ x := by
    show (appΓ ((Scheme.Modules.pullbackComp q G.source.left).inv.app M.module))
      ((appΓ ((Scheme.Modules.pullbackCongr hs).hom.app M.module))
        ((appΓ ((Scheme.Modules.pullbackCongr hs.symm).hom.app M.module))
          (reindexSection q G.source.left M.module x))) = _
    rw [pullbackCongr_cancel]
    exact congr((appΓ $( (Scheme.Modules.pullbackComp q G.source.left).hom_inv_id_app M.module
      )) (pullbackSection q _ x))
  -- The five factors of `successiveDescent`, named through the abbreviations above.  Unfolding
  -- the definition with `rw [successiveDescent]` instead leaves the composite spelled with the
  -- bodies of those abbreviations, and the later comparison with the step-by-step evaluation
  -- then has to unfold them underneath five nested applications of `appΓ`, which exhausts the
  -- elaborator's recursion budget.
  have hsucc : successiveDescent G M.alpha =
      (Scheme.Modules.pullbackCongr ht).hom.app M.module ≫
        reindexHom p M.alpha ≫
        (Scheme.Modules.pullbackCongr hp).hom.app M.module ≫
        reindexHom q M.alpha ≫
        (Scheme.Modules.pullbackCongr hs.symm).hom.app M.module :=
    rfl
  have h := congr((appΓ E.hom) ((appΓ $(M.cocycle))
    (pullbackSection (G.comp.left ≫ G.target.left) M.module m)))
  rw [hsucc] at h
  simp only [appΓ_comp] at h
  -- The five factors of `successiveDescent` are evaluated one at a time and the results
  -- composed with `congrArg`.  Rewriting inside the five-fold nesting instead is what the
  -- elaborator cannot do: `rw` type-checks its motive at `implicit` transparency, at which the
  -- nested applications of `appΓ` are not type-correct, and doing so exhausts the recursion
  -- budget.  Each step below is an equation between terms of one fixed type.
  have e1 := pullbackSection_congr ht M.module m
  have e2 := reindexHom_pullbackSection p M.alpha m
  have e3 (X : Scheme.{u}) (φ : X ⟶ G.arrows.left) :
      reindexSection φ G.source.left M.module
          ((appΓ M.alpha) (pullbackSection G.target.left M.module m)) =
        c.sum (fun i n ↦ φ.appTop (b i) • pullbackSection (φ ≫ G.source.left) M.module n) := by
    rw [hc]
    simp only [Finsupp.sum, map_sum, LinearMap.map_smulₛₗ, reindexSection_pullbackSection]
  have e4 : (appΓ ((Scheme.Modules.pullbackCongr hp).hom.app M.module))
        (c.sum (fun i n ↦ p.appTop (b i) •
          pullbackSection (p ≫ G.source.left) M.module n)) =
      c.sum (fun i n ↦ p.appTop (b i) •
        pullbackSection (q ≫ G.target.left) M.module n) := by
    simp only [Finsupp.sum, map_sum, map_smul, pullbackSection_congr]
  have e5 : (appΓ (reindexHom q M.alpha))
        (c.sum (fun i n ↦ p.appTop (b i) •
          pullbackSection (q ≫ G.target.left) M.module n)) =
      c.sum (fun i n ↦ p.appTop (b i) • reindexSection q G.source.left M.module
        ((appΓ M.alpha) (pullbackSection G.target.left M.module n))) := by
    simp only [Finsupp.sum, map_sum, map_smul, reindexHom_pullbackSection]
  have e6 : (appΓ ((Scheme.Modules.pullbackCongr hs.symm).hom.app M.module))
        (c.sum (fun i n ↦ p.appTop (b i) • reindexSection q G.source.left M.module
          ((appΓ M.alpha) (pullbackSection G.target.left M.module n)))) =
      c.sum (fun i n ↦ p.appTop (b i) •
        (appΓ ((Scheme.Modules.pullbackCongr hs.symm).hom.app M.module))
          (reindexSection q G.source.left M.module
            ((appΓ M.alpha) (pullbackSection G.target.left M.module n)))) := by
    simp only [Finsupp.sum, map_sum, map_smul]
  have e7 : (appΓ E.hom)
        (c.sum (fun i n ↦ p.appTop (b i) •
          (appΓ ((Scheme.Modules.pullbackCongr hs.symm).hom.app M.module))
            (reindexSection q G.source.left M.module
              ((appΓ M.alpha) (pullbackSection G.target.left M.module n))))) =
      c.sum (fun i n ↦ p.appTop (b i) • pullbackSection q
        ((Scheme.Modules.pullback G.source.left).obj M.module)
          ((appΓ M.alpha) (pullbackSection G.target.left M.module n))) := by
    simp only [Finsupp.sum, map_sum, map_smul, hE']
  have f1 := reindexHom_pullbackSection G.comp.left M.alpha m
  have f3 : (appΓ E.hom)
        (c.sum (fun i n ↦ G.comp.left.appTop (b i) •
          pullbackSection (G.comp.left ≫ G.source.left) M.module n)) =
      c.sum (fun i n ↦ G.comp.left.appTop (b i) • pullbackSection q
        ((Scheme.Modules.pullback G.source.left).obj M.module)
          (pullbackSection G.source.left M.module n)) := by
    simp only [Finsupp.sum, map_sum, map_smul, hE]
  have g2 := (congrArg (fun x ↦ (appΓ (reindexHom p M.alpha)) x) e1).trans (e2.trans (e3 _ p))
  have g3 := (congrArg
    (fun x ↦ (appΓ ((Scheme.Modules.pullbackCongr hp).hom.app M.module)) x) g2).trans e4
  have g4 := (congrArg (fun x ↦ (appΓ (reindexHom q M.alpha)) x) g3).trans e5
  have g5 := (congrArg
    (fun x ↦ (appΓ ((Scheme.Modules.pullbackCongr hs.symm).hom.app M.module)) x) g4).trans e6
  have g6 := (congrArg (fun x ↦ (appΓ E.hom) x) g5).trans e7
  have gR := (congrArg (fun x ↦ (appΓ E.hom) x) (f1.trans (e3 _ G.comp.left))).trans f3
  exact g6.symm.trans (h.trans gR)

/-- Coassociativity of the descent coefficients: the coefficients of a coefficient lie in the
span of the original coefficients. -/
private lemma descent_coefficients_coassoc_mem_span {S : Scheme.{u}}
    (G : GroupoidScheme S) [IsAffine G.objects.left] [IsAffine G.arrows.left]
    (M : QuasicoherentModule G) {ι : Type u}
    (b : letI := G.source.left.appTop.hom.toAlgebra
      Module.Basis ι Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤))
    (m : Γ(M.module, ⊤)) (j k : ι) :
    let d := pullbackCoefficients G.source.left M.module b
    let ρ := fun n ↦ (appΓ M.alpha) (pullbackSection G.target.left M.module n)
    d (ρ (d (ρ m) j)) k ∈ Submodule.span Γ(G.objects.left, ⊤) (Set.range (d (ρ m))) := by
  classical
  let d := pullbackCoefficients G.source.left M.module b
  let ρ := fun n ↦ (appΓ M.alpha) (pullbackSection G.target.left M.module n)
  let c := d (ρ m)
  let p := (Limits.pullback.fst G.source G.target).left
  let q := (Limits.pullback.snd G.source G.target).left
  have hpb := isPullback_source_target G
  have := isAffine_pullback_source_target G
  have : ((Scheme.Modules.pullback G.source.left).obj M.module).IsQuasicoherent :=
    Stacks.AlgebraicGeometry.AffineBaseChange.isQuasicoherent_pullback_of_isAffine
      G.source.left M.module
  obtain ⟨b', hb'⟩ := exists_basis_of_isPullback hpb b
  let := q.appTop.hom.toAlgebra
  let e := pullbackCoefficients q ((Scheme.Modules.pullback G.source.left).obj M.module) b'
  have he (i : ι) (n : Γ((Scheme.Modules.pullback G.source.left).obj M.module, ⊤)) :
      e (p.appTop (b i) • pullbackSection q _ n) = Finsupp.single i n := by
    rw [← hb' i]
    exact pullbackCoefficients_basis_section q _ b' i n
  have hc : ρ m = c.sum (fun i n ↦ b i • pullbackSection G.source.left M.module n) :=
    (pullbackCoefficients_expansion G.source.left M.module b (ρ m)).symm
  have h := descent_cocycle_expansion G M b m c hc
  have h' := congrArg (fun x ↦ e x j) h
  have hleft : e (c.sum (fun i n ↦ p.appTop (b i) • pullbackSection q _ (ρ n))) j =
      ρ (c j) := by
    simp only [Finsupp.sum, map_sum, he, Finsupp.finsetSum_apply]
    exact sum_single_apply_support c ρ (by simp only [ρ, map_zero]) j
  change e (c.sum (fun i n ↦ p.appTop (b i) • pullbackSection q _ (ρ n))) j = _ at h'
  rw [hleft] at h'
  have hright : ρ (c j) = c.sum (fun i n ↦ b'.repr (G.comp.left.appTop (b i)) j •
      pullbackSection G.source.left M.module n) := by
    rw [h']
    simp only [Finsupp.sum, map_sum, Finsupp.finsetSum_apply]
    exact Finset.sum_congr rfl fun i _ ↦ pullbackCoefficients_smul_section q _ b' _ _ j
  show d (ρ (c j)) k ∈ Submodule.span Γ(G.objects.left, ⊤) (Set.range c)
  rw [hright]
  simp only [Finsupp.sum, map_sum, Finsupp.finsetSum_apply, d,
    pullbackCoefficients_smul_section]
  exact Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

/-- A quasi-coherent submodule stable under taking descent coefficients carries a groupoid
module structure. -/
private noncomputable def groupoidModuleOfStable {S : Scheme.{u}}
    (G : GroupoidScheme S) [IsAffine G.objects.left] [IsAffine G.arrows.left]
    (M : QuasicoherentModule G) (F : G.objects.left.Modules) [F.IsQuasicoherent]
    (k : F ⟶ M.module) (hk : Function.Injective ((appΓ k))) {ι : Type u}
    (b : letI := G.source.left.appTop.hom.toAlgebra
      Module.Basis ι Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤))
    (hstable : ∀ n : Γ(F, ⊤), ∀ i,
      pullbackCoefficients G.source.left M.module b
        ((appΓ M.alpha) (pullbackSection G.target.left M.module
          ((appΓ k) n))) i ∈ LinearMap.range (appΓ k)) :
    QuasicoherentModule G := by
  let α := (exists_descent_restriction G M F k hk b hstable).choose
  have hα := (exists_descent_restriction G M F k hk b hstable).choose_spec
  refine ⟨F, inferInstance, α, ?_, ?_⟩
  · let p := (Limits.pullback.fst G.source G.target).left
    let q := (Limits.pullback.snd G.source G.target).left
    have hpb := isPullback_source_target G
    have := isAffine_pullback_source_target G
    have : ((Scheme.Modules.pullback G.source.left).obj F).IsQuasicoherent :=
      Stacks.AlgebraicGeometry.AffineBaseChange.isQuasicoherent_pullback_of_isAffine G.source.left F
    have : ((Scheme.Modules.pullback G.source.left).obj M.module).IsQuasicoherent :=
      Stacks.AlgebraicGeometry.AffineBaseChange.isQuasicoherent_pullback_of_isAffine
        G.source.left M.module
    have : ((Scheme.Modules.pullback (G.comp.left ≫ G.target.left)).obj F).IsQuasicoherent :=
      Stacks.AlgebraicGeometry.AffineBaseChange.isQuasicoherent_pullback_of_isAffine _ F
    obtain ⟨b', hb'⟩ := exists_basis_of_isPullback hpb b
    have hks := pullback_injective_of_basis G.source.left k b hk
    have hkc : Function.Injective
        (appΓ ((Scheme.Modules.pullback (G.comp.left ≫ G.source.left)).map k)) := by
      rw [show G.comp.left ≫ G.source.left = q ≫ G.source.left from
        congrArg Over.Hom.left G.source_comp]
      exact pullback_comp_injective q G.source.left k
        (pullback_injective_of_basis q ((Scheme.Modules.pullback G.source.left).map k) b' hks)
    apply affine_cancel_right _ hkc
    exact (successiveDescent_naturality G α M.alpha k hα).trans
      ((congrArg (fun a ↦
        (Scheme.Modules.pullback (G.comp.left ≫ G.target.left)).map k ≫ a)
        M.cocycle).trans (reindexHom_naturality G.comp.left α M.alpha k hα).symm)
  · apply affine_cancel_right k hk
    exact (identityDescent_naturality G α M.alpha k hα).trans (by rw [M.identity]; simp)

/-- The inclusion of `groupoidModuleOfStable` into the ambient groupoid module. -/
private noncomputable def groupoidModuleOfStableι {S : Scheme.{u}}
    (G : GroupoidScheme S) [IsAffine G.objects.left] [IsAffine G.arrows.left]
    (M : QuasicoherentModule G) (F : G.objects.left.Modules) [F.IsQuasicoherent]
    (k : F ⟶ M.module) (hk : Function.Injective ((appΓ k))) {ι : Type u}
    (b : letI := G.source.left.appTop.hom.toAlgebra
      Module.Basis ι Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤))
    (hstable : ∀ n : Γ(F, ⊤), ∀ i,
      pullbackCoefficients G.source.left M.module b
        ((appΓ M.alpha) (pullbackSection G.target.left M.module
          ((appΓ k) n))) i ∈ LinearMap.range (appΓ k)) :
    groupoidModuleOfStable G M F k hk b hstable ⟶ M where
  hom := k
  comm := (exists_descent_restriction G M F k hk b hstable).choose_spec

private lemma span_range_finsupp_eq_span_support
    {A : Type u} {N : Type v} {ι : Type w}
    [Semiring A] [AddCommMonoid N] [Module A N] (c : ι →₀ N) :
    Submodule.span A (Set.range c) =
      Submodule.span A ((c.support : Set ι).image c) := by
  classical
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    by_cases hi : i ∈ c.support
    · exact Submodule.subset_span (⟨i, hi, rfl⟩)
    · simp [Finsupp.notMem_support_iff.mp hi]
  · exact Submodule.span_mono (Set.image_subset_range _ _)

private lemma fg_span_range_finsupp
    {A : Type u} {N : Type v} {ι : Type w}
    [Semiring A] [AddCommMonoid N] [Module A N] (c : ι →₀ N) :
    (Submodule.span A (Set.range c)).FG := by
  classical
  rw [span_range_finsupp_eq_span_support]
  exact Submodule.fg_span ((Finset.finite_toSet _).image _)

private lemma coefficients_mem_span
    {A : Type u} {N : Type v} {ι : Type w}
    [Semiring A] [AddCommMonoid N] [Module A N]
    (c : N →+ ι →₀ N)
    (hsmul : ∀ (a : A) (n : N) (i : ι),
      c (a • n) i ∈ Submodule.span A (Set.range (c n)))
    (P : Submodule A N) {T : Set N}
    (hT : ∀ n ∈ T, ∀ i, c n i ∈ P) :
    ∀ n ∈ Submodule.span A T, ∀ i, c n i ∈ P := by
  intro n hn
  induction hn using Submodule.span_induction with
  | mem n hn => exact hT n hn
  | zero => simp
  | add n m _ _ hn hm => exact fun i ↦ by simpa using P.add_mem (hn i) (hm i)
  | smul a n _ hn => exact fun i ↦ Submodule.span_le.mpr (Set.range_subset_iff.2 hn) (hsmul a n i)

private lemma exists_fg_coefficient_stable_submodule
    {A : Type u} {N : Type v} {ι : Type w}
    [Semiring A] [AddCommMonoid N] [Module A N]
    (c : N →+ ι →₀ N)
    (hsmul : ∀ (a : A) (n : N) (i : ι),
      c (a • n) i ∈ Submodule.span A (Set.range (c n)))
    (hcoassoc : ∀ (n : N) (i j : ι),
      c (c n i) j ∈ Submodule.span A (Set.range (c n)))
    (hcounit : ∀ n, n ∈ Submodule.span A (Set.range (c n)))
    (n : N) :
    ∃ P : Submodule A N, P.FG ∧ n ∈ P ∧ ∀ m ∈ P, ∀ i, c m i ∈ P :=
  ⟨_, fg_span_range_finsupp (c n), hcounit n,
    coefficients_mem_span c hsmul _ (Set.forall_mem_range.2 (hcoassoc n))⟩

/-- The descent coefficients of a section of a groupoid module, as an additive map. -/
private noncomputable def descentCoefficients {S : Scheme.{u}}
    (G : GroupoidScheme S) [IsAffine G.objects.left] [IsAffine G.arrows.left]
    (M : QuasicoherentModule G) {ι : Type u}
    (b : letI := G.source.left.appTop.hom.toAlgebra
      Module.Basis ι Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤)) :
    Γ(M.module, ⊤) →+ (ι →₀ Γ(M.module, ⊤)) where
  toFun n := pullbackCoefficients G.source.left M.module b
    ((appΓ M.alpha) (pullbackSection G.target.left M.module n))
  map_zero' := by simp only [map_zero]
  map_add' n m := by simp only [map_add]

private lemma descentCoefficients_smul_mem_span {S : Scheme.{u}}
    (G : GroupoidScheme S) [IsAffine G.objects.left] [IsAffine G.arrows.left]
    (M : QuasicoherentModule G) {ι : Type u}
    (b : letI := G.source.left.appTop.hom.toAlgebra
      Module.Basis ι Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤))
    (a : Γ(G.objects.left, ⊤)) (m : Γ(M.module, ⊤)) (i : ι) :
    descentCoefficients G M b (a • m) i ∈
      Submodule.span Γ(G.objects.left, ⊤) (Set.range (descentCoefficients G M b m)) := by
  show pullbackCoefficients G.source.left M.module b
    ((appΓ M.alpha) (pullbackSection G.target.left M.module (a • m))) i ∈ _
  rw [(pullbackSection G.target.left M.module).map_smulₛₗ, map_smul]
  exact pullbackCoefficients_smul_mem_span G.source.left M.module b _ _ i

private lemma exists_fg_descent_stable_submodule {S : Scheme.{u}}
    (G : GroupoidScheme S) [IsAffine G.objects.left] [IsAffine G.arrows.left]
    (M : QuasicoherentModule G) {ι : Type u}
    (b : letI := G.source.left.appTop.hom.toAlgebra
      Module.Basis ι Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤))
    (m : Γ(M.module, ⊤)) :
    ∃ P : Submodule Γ(G.objects.left, ⊤) Γ(M.module, ⊤), P.FG ∧ m ∈ P ∧
      ∀ n ∈ P, ∀ i, descentCoefficients G M b n i ∈ P := by
  apply exists_fg_coefficient_stable_submodule (descentCoefficients G M b)
    (descentCoefficients_smul_mem_span G M b)
    (descent_coefficients_coassoc_mem_span G M b)
  intro n
  obtain ⟨c, hc, hn⟩ := exists_descent_coefficients_mem_span G M b n
  have he := congrArg (pullbackCoefficients G.source.left M.module b) hc
  rw [pullbackCoefficients_sum] at he
  show n ∈ Submodule.span Γ(G.objects.left, ⊤) (Set.range
    (pullbackCoefficients G.source.left M.module b
      ((appΓ M.alpha) (pullbackSection G.target.left M.module n))))
  rw [he]
  exact hn

/-- A cocone of groupoid modules is colimiting as soon as it is colimiting on underlying
modules. -/
private noncomputable def isColimit_of_forget
    {S : Scheme.{u}} {G : GroupoidScheme S}
    {I : Type u} [SmallCategory I] {D : I ⥤ QuasicoherentModule G}
    (c : Cocone D)
    (hc : IsColimit ((QuasicoherentModule.forget G).mapCocone c)) : IsColimit c where
  desc d := {
    hom := hc.desc ((QuasicoherentModule.forget G).mapCocone d)
    comm := by
      apply (isColimitOfPreserves (Scheme.Modules.pullback G.target.left) hc).hom_ext
      intro i
      change (Scheme.Modules.pullback G.target.left).map (c.ι.app i).hom ≫
          c.pt.alpha ≫ (Scheme.Modules.pullback G.source.left).map
            (hc.desc ((QuasicoherentModule.forget G).mapCocone d)) =
        (Scheme.Modules.pullback G.target.left).map (c.ι.app i).hom ≫
          (Scheme.Modules.pullback G.target.left).map
            (hc.desc ((QuasicoherentModule.forget G).mapCocone d)) ≫ d.pt.alpha
      have hiC := (c.ι.app i).comm
      dsimp only [Functor.const_obj_obj] at hiC
      rw [← Category.assoc, ← hiC, Category.assoc,
        ← Functor.map_comp, ← Functor.map_comp_assoc]
      have hi : (c.ι.app i).hom ≫ hc.desc ((QuasicoherentModule.forget G).mapCocone d) =
          (d.ι.app i).hom := hc.fac _ i
      rw [hi]
      exact (d.ι.app i).comm }
  fac d i := QuasicoherentModule.Hom.ext (hc.fac _ i)
  uniq d f hf := by
    apply QuasicoherentModule.Hom.ext
    refine hc.hom_ext fun i ↦ ?_
    exact (congrArg QuasicoherentModule.Hom.hom (hf i)).trans
      (hc.fac ((QuasicoherentModule.forget G).mapCocone d) i).symm

private lemma coefficient_stable_sup {A : Type u} {N : Type v} {ι : Type w}
    [Semiring A] [AddCommMonoid N] [Module A N] (c : N →+ (ι →₀ N))
    (P Q : Submodule A N)
    (hP : ∀ n ∈ P, ∀ i, c n i ∈ P) (hQ : ∀ n ∈ Q, ∀ i, c n i ∈ Q) :
    ∀ n ∈ P ⊔ Q, ∀ i, c n i ∈ P ⊔ Q := by
  intro n hn i
  obtain ⟨p, hp, q, hq, rfl⟩ := Submodule.mem_sup.mp hn
  simp only [map_add, Finsupp.add_apply]
  exact (P ⊔ Q).add_mem (Submodule.mem_sup_left (hP p hp i)) (Submodule.mem_sup_right (hQ q hq i))

private lemma affineSubmodule_stable {S : Scheme.{u}}
    (G : GroupoidScheme S) [IsAffine G.objects.left] [IsAffine G.arrows.left]
    (M : QuasicoherentModule G) {ι : Type u}
    (b : letI := G.source.left.appTop.hom.toAlgebra
      Module.Basis ι Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤))
    (P : Submodule Γ(G.objects.left, ⊤) Γ(M.module, ⊤))
    (hP : ∀ n ∈ P, ∀ i, descentCoefficients G M b n i ∈ P)
    (n : Γ(affineSubmodule M.module P, ⊤)) (i : ι) :
    pullbackCoefficients G.source.left M.module b
      ((appΓ M.alpha) (pullbackSection G.target.left M.module
        ((appΓ (affineSubmoduleι M.module P)) n))) i ∈
      LinearMap.range (appΓ (affineSubmoduleι M.module P)) := by
  rw [affineSubmoduleι_range]
  exact hP _ ((affineSubmoduleι_range M.module P).le ⟨n, rfl⟩) i

/-- The groupoid module attached to a coefficient-stable submodule of global sections. -/
private noncomputable def stableSubmoduleObj {S : Scheme.{u}}
    (G : GroupoidScheme S) [IsAffine G.objects.left] [IsAffine G.arrows.left]
    (M : QuasicoherentModule G) {ι : Type u}
    (b : letI := G.source.left.appTop.hom.toAlgebra
      Module.Basis ι Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤))
    (P : Submodule Γ(G.objects.left, ⊤) Γ(M.module, ⊤))
    (hP : ∀ n ∈ P, ∀ i, descentCoefficients G M b n i ∈ P) : QuasicoherentModule G := by
  have := isQuasicoherent_affineTilde G.objects.left (ModuleCat.of Γ(G.objects.left, ⊤) P)
  exact groupoidModuleOfStable G M (affineSubmodule M.module P) (affineSubmoduleι M.module P)
    (affineSubmoduleι_injective M.module P) b (affineSubmodule_stable G M b P hP)

/-- The inclusion of `stableSubmoduleObj` into the ambient groupoid module. -/
private noncomputable def stableSubmoduleι {S : Scheme.{u}}
    (G : GroupoidScheme S) [IsAffine G.objects.left] [IsAffine G.arrows.left]
    (M : QuasicoherentModule G) {ι : Type u}
    (b : letI := G.source.left.appTop.hom.toAlgebra
      Module.Basis ι Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤))
    (P : Submodule Γ(G.objects.left, ⊤) Γ(M.module, ⊤))
    (hP : ∀ n ∈ P, ∀ i, descentCoefficients G M b n i ∈ P) :
    stableSubmoduleObj G M b P hP ⟶ M := by
  have := isQuasicoherent_affineTilde G.objects.left (ModuleCat.of Γ(G.objects.left, ⊤) P)
  exact groupoidModuleOfStableι G M (affineSubmodule M.module P) (affineSubmoduleι M.module P)
    (affineSubmoduleι_injective M.module P) b (affineSubmodule_stable G M b P hP)

/-- A morphism of underlying modules compatible with the inclusions into a common groupoid
module is a morphism of groupoid modules. -/
private noncomputable def groupoidHomOfUnderlying {S : Scheme.{u}}
    (G : GroupoidScheme S) [IsAffine G.objects.left] [IsAffine G.arrows.left]
    {F H M : QuasicoherentModule G} (a : F ⟶ M) (b : H ⟶ M)
    (k : F.module ⟶ H.module) (h : k ≫ b.hom = a.hom)
    (hb : Function.Injective ((appΓ b.hom))) {ι : Type u}
    (e : letI := G.source.left.appTop.hom.toAlgebra
      Module.Basis ι Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤)) : F ⟶ H where
  hom := k
  comm := by
    have := Stacks.AlgebraicGeometry.AffineBaseChange.isQuasicoherent_pullback_of_isAffine
      G.target.left F.module
    apply affine_cancel_right ((Scheme.Modules.pullback G.source.left).map b.hom)
      (pullback_injective_of_basis G.source.left b.hom e hb)
    calc
      _ = F.alpha ≫ (Scheme.Modules.pullback G.source.left).map (k ≫ b.hom) := by
        simp only [CategoryTheory.Functor.map_comp, Category.assoc]
      _ = (Scheme.Modules.pullback G.target.left).map a.hom ≫ M.alpha := by rw [h, a.comm]
      _ = _ := by rw [← h, CategoryTheory.Functor.map_comp, Category.assoc, ← b.comm];
                  simp only [Category.assoc]

/-- The diagram of submodules of a module indexed by a preordered family. -/
private def submoduleDiagram {R : Type u} [Ring R] (N : ModuleCat.{u} R)
    {I : Type u} [Preorder I] (P : I →o Submodule R N) : I ⥤ ModuleCat R where
  obj i := ModuleCat.of R (P i)
  map f := ModuleCat.ofHom (Submodule.inclusion (P.monotone (leOfHom f)))
  map_id _ := by ext; rfl
  map_comp _ _ := by ext; rfl

/-- The cocone of `submoduleDiagram` with vertex the ambient module. -/
private def submoduleCocone {R : Type u} [Ring R] (N : ModuleCat.{u} R)
    {I : Type u} [Preorder I] (P : I →o Submodule R N) : Cocone (submoduleDiagram N P) where
  pt := N
  ι := { app := fun i ↦ ModuleCat.ofHom (P i).subtype
         naturality := fun _ _ _ ↦ by ext; rfl }

private noncomputable def isColimit_submoduleCocone {R : Type u} [Ring R]
    (N : ModuleCat.{u} R) {I : Type u} [Preorder I] [IsDirectedOrder I]
    (P : I →o Submodule R N) (hP : ∀ n : N, ∃ i, n ∈ P i) :
    IsColimit (submoduleCocone N P) := by
  classical
  choose σ hσ using hP
  have hex (d : Cocone (submoduleDiagram N P)) :
      ∃ f : N ⟶ d.pt, ∀ i, (submoduleCocone N P).ι.app i ≫ f = d.ι.app i := by
    let v (n : N) := d.ι.app (σ n) ⟨n, hσ n⟩
    have hw (i j : I) (hij : i ≤ j) (n : P i) :
        d.ι.app j ⟨n, P.monotone hij n.property⟩ = d.ι.app i n :=
      congr($(d.w (homOfLE hij)).hom n)
    have hv (i : I) (n : N) (hn : n ∈ P i) : v n = d.ι.app i ⟨n, hn⟩ := by
      obtain ⟨j, h₁, h₂⟩ := exists_ge_ge (σ n) i
      exact (hw (σ n) j h₁ ⟨n, hσ n⟩).symm.trans (hw i j h₂ ⟨n, hn⟩)
    let f : N ⟶ d.pt := ModuleCat.ofHom {
      toFun := v
      map_add' := by
        intro n m
        obtain ⟨i, hn, hm⟩ := exists_ge_ge (σ n) (σ m)
        have hn' := P.monotone hn (hσ n)
        have hm' := P.monotone hm (hσ m)
        rw [hv i (n + m) ((P i).add_mem hn' hm'), hv i n hn', hv i m hm']
        exact (d.ι.app i).hom.map_add ⟨n, hn'⟩ ⟨m, hm'⟩
      map_smul' := by
        intro r n
        rw [hv (σ n) (r • n) ((P (σ n)).smul_mem r (hσ n)), hv (σ n) n (hσ n)]
        exact (d.ι.app (σ n)).hom.map_smul r ⟨n, hσ n⟩ }
    refine ⟨f, fun i ↦ ?_⟩
    exact ModuleCat.hom_ext (LinearMap.ext fun n ↦ hv i (n : P i).val (n : P i).property)
  refine { desc := fun d ↦ (hex d).choose
           fac := fun d i ↦ (hex d).choose_spec i
           uniq := ?_ }
  intro d f hf
  ext n
  exact (congr($(hf (σ n)).hom ⟨n, hσ n⟩)).trans
    (congr($( (hex d).choose_spec (σ n) ).hom ⟨n, hσ n⟩)).symm

/-- A finite module of sections gives a finite-type associated sheaf on the affine spectrum. -/
private lemma tilde_isFiniteType_of_module_finite
    {R : CommRingCat.{u}} (N : ModuleCat.{u} R) [Module.Finite R N] :
    (tilde N).IsFiniteType :=
  tilde_isFiniteType_iff N |>.2 inferInstance

/-- **Stacks Project, Tag 07TV.** A quasi-coherent module on an affine groupoid scheme whose
arrow ring is free over its object ring via the source map is a filtered colimit of
finite-type groupoid modules. -/
@[stacks 07TV]
theorem exists_filtered_diagram_of_isFiniteType
    {S : Scheme.{u}} (G : GroupoidScheme S)
    [IsAffine G.objects.left] [IsAffine G.arrows.left]
    (hfree : letI : Algebra Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤) :=
      G.source.left.appTop.hom.toAlgebra
      Module.Free Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤))
    (M : QuasicoherentModule G) :
    ∃ (I : Type u) (inst : SmallCategory I),
      let _ := inst
      ∃ (_ : IsFiltered I)
        (D : I ⥤ QuasicoherentModule G)
        (φ : D ⟶ (Functor.const I).obj M),
        (∀ i, (D.obj i).module.IsFiniteType) ∧
          Nonempty (IsColimit (Cocone.mk M φ)) := by
  classical
  let := G.source.left.appTop.hom.toAlgebra
  let : Module.Free Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤) := hfree
  let b := Module.Free.chooseBasis Γ(G.objects.left, ⊤) Γ(G.arrows.left, ⊤)
  let c := descentCoefficients G M b
  let I := {P : Submodule Γ(G.objects.left, ⊤) Γ(M.module, ⊤) //
    P.FG ∧ ∀ n ∈ P, ∀ i, c n i ∈ P}
  let : Nonempty I := ⟨⟨⊥, Submodule.fg_bot, by
    intro n hn i
    rw [Submodule.mem_bot] at hn
    simp [hn]⟩⟩
  let : IsDirectedOrder I := ⟨fun P Q ↦
    ⟨⟨P.val ⊔ Q.val, P.property.1.sup Q.property.1,
      coefficient_stable_sup c P.val Q.val P.property.2 Q.property.2⟩,
      (show P.val ≤ P.val ⊔ Q.val from le_sup_left),
      (show Q.val ≤ P.val ⊔ Q.val from le_sup_right)⟩⟩
  let L := tilde.functor Γ(G.objects.left, ⊤) ⋙
    Scheme.Modules.pullback G.objects.left.toSpecΓ
  let D : I ⥤ QuasicoherentModule G := {
    obj P := stableSubmoduleObj G M b P.val P.property.2
    map {P Q} f := groupoidHomOfUnderlying G
      (stableSubmoduleι G M b P.val P.property.2)
      (stableSubmoduleι G M b Q.val Q.property.2)
      (L.map (ModuleCat.ofHom (Submodule.inclusion (leOfHom f))))
      (affineSubmoduleι_naturality M.module P.val Q.val (leOfHom f))
      (affineSubmoduleι_injective M.module Q.val) b
    map_id P := QuasicoherentModule.Hom.ext (L.map_id (ModuleCat.of Γ(G.objects.left, ⊤) P.val))
    map_comp {P Q T} f g := by
      apply QuasicoherentModule.Hom.ext
      show L.map _ = L.map _ ≫ L.map _
      rw [← L.map_comp]
      congr 1 }
  let φ : D ⟶ (Functor.const I).obj M := {
    app P := stableSubmoduleι G M b P.val P.property.2
    naturality {P Q} f := by
      apply QuasicoherentModule.Hom.ext
      show L.map (ModuleCat.ofHom (Submodule.inclusion (leOfHom f))) ≫
        affineSubmoduleι M.module Q.val = affineSubmoduleι M.module P.val ≫ 𝟙 _
      rw [Category.comp_id]
      exact affineSubmoduleι_naturality M.module P.val Q.val (leOfHom f) }
  refine ⟨I, inferInstance, inferInstance, D, φ, ?_, ?_⟩
  · intro P
    have : Module.Finite Γ(G.objects.left, ⊤) P.val := Module.Finite.of_fg P.property.1
    exact affineTilde_isFiniteType G.objects.left (ModuleCat.of Γ(G.objects.left, ⊤) P.val)
  · let P : I →o Submodule Γ(G.objects.left, ⊤) Γ(M.module, ⊤) :=
      ⟨Subtype.val, fun _ _ h ↦ h⟩
    have hP : ∀ n : Γ(M.module, ⊤), ∃ i, n ∈ P i := by
      intro n
      obtain ⟨Q, hQ, hn, hs⟩ := exists_fg_descent_stable_submodule G M b n
      exact ⟨⟨Q, hQ, hs⟩, hn⟩
    let h := isColimitOfPreserves L (isColimit_submoduleCocone
      ((moduleΓFunctor G.objects.left).obj M.module) P hP)
    let e : L.mapCocone (submoduleCocone ((moduleΓFunctor G.objects.left).obj M.module) P) ≅
        (QuasicoherentModule.forget G).mapCocone (Cocone.mk M φ) :=
      Cocone.ext (affineTildeCounitIso G.objects.left M.module)
        (fun i ↦ by
          show L.map (ModuleCat.ofHom i.val.subtype) ≫
            (affineTildeAdjunction G.objects.left).counit.app M.module =
              affineSubmoduleι M.module i.val
          exact ((affineTildeAdjunction G.objects.left).homEquiv_counit _ _ _).symm)
    exact ⟨isColimit_of_forget (Cocone.mk M φ) (IsColimit.ofIsoColimit h e)⟩

end AlgebraicGeometry.GroupoidScheme

