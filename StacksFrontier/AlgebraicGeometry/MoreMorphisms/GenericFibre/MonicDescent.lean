module

public import Mathlib.Algebra.Polynomial.Degree.Domain
public import Mathlib.Algebra.Polynomial.Degree.Lemmas
public import Mathlib.Algebra.Polynomial.Div
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.LastVariable

/-!
# Descending a principal kernel along a monic model

Let `A` be a subring of a domain `K`, let `L` be a commutative ring and let
`ψ : MvPolynomial (Fin (n + 1)) K →+* L` be a ring homomorphism whose kernel is generated by the
coefficientwise image of a polynomial `P : MvPolynomial (Fin (n + 1)) A`. If `P` is **monic in
the last variable**, then the kernel of the restriction of `ψ` to `MvPolynomial (Fin (n + 1)) A`
is generated by `P` itself.

This is the step that is missing from the text of Stacks Tag 0559. There, the model over the
domain `A` is obtained from the model over its fraction field `K` by clearing denominators, and
the resulting `P` is only *primitive*; the source then asserts without argument that
`A[x₁, …, x_{r+1}] ⧸ (P)` has fraction field `L`. That is false in general: for `A = ℤ` and
`Q = x` the polynomial `P = 2x` is a legitimate outcome of clearing denominators, and
`ℤ[x] ⧸ (2x)` is not even a domain. Over a mere domain `A` — not a unique factorization domain —
primitivity is not enough, and monicity is the replacement: a monic polynomial admits division
with remainder, which is all the descent needs.

## Main results

* `Polynomial.ker_comp_mapRingHom_eq_span_of_monic`: the one-variable statement, proved by
  division with remainder by the monic model.
* `MvPolynomial.map_finLastEquiv`: `MvPolynomial.finLastEquiv` is natural in the coefficient
  ring.
* `MvPolynomial.ker_comp_map_eq_span_of_monic`: **the descent**, for a polynomial which is monic
  in the last variable.

## Implementation notes

"Monic in the last variable" is spelled `((finLastEquiv A n) P).Monic`, using the identification
of `A[x₀, …, x_n]` with `(A[x₀, …, x_{n-1}])[T]` of
`StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.LastVariable`. That is the same
distinguished variable as the primitive element of Step B of Tag 0559, so the hypothesis is the
one the application produces.

The homomorphisms are `RingHom`s rather than `AlgHom`s: the two evaluations are algebra maps over
different base rings, and the kernel of a composite of ring maps is what both `RingHom.comap_ker`
and the application need.

No Stacks tag is attached: this is a repair of a step of a proof, not a statement of the source.

## References

* [Stacks Project, Tag 0559](https://stacks.math.columbia.edu/tag/0559), Step D of the first
  proof
-/

@[expose] public section

universe u v w

namespace Polynomial

/-- **Monic descent of a principal kernel, one variable.** Let `ι : A →+* R` be an injective
homomorphism into a domain, let `ψ : R[X] →+* L` have kernel generated by the coefficientwise
image of a monic `P : A[X]`, and let `ψ₀` be the restriction of `ψ` to `A[X]`. Then the kernel
of `ψ₀` is generated by `P`. -/
theorem ker_comp_mapRingHom_eq_span_of_monic {A : Type u} {R : Type v} {L : Type w} [CommRing A]
    [CommRing R] [CommRing L] [IsDomain R] (ι : A →+* R) (hι : Function.Injective ι)
    (ψ : Polynomial R →+* L) {P : Polynomial A} (hP : P.Monic)
    (hker : RingHom.ker ψ = Ideal.span {P.map ι}) :
    RingHom.ker (ψ.comp (mapRingHom ι)) = Ideal.span {P} := by
  have hnt : Nontrivial A := ι.domain_nontrivial
  have hmem : ∀ x, ψ x = 0 ↔ P.map ι ∣ x := fun x ↦ by
    rw [← RingHom.mem_ker, hker, Ideal.mem_span_singleton]
  have hPmem : P ∈ RingHom.ker (ψ.comp (mapRingHom ι)) := by
    simpa [RingHom.mem_ker] using (hmem _).2 dvd_rfl
  refine le_antisymm (fun f hf ↦ ?_) ((Ideal.span_le).2 (Set.singleton_subset_iff.2 hPmem))
  rw [RingHom.mem_ker, RingHom.comp_apply, coe_mapRingHom] at hf
  -- Divide `f` by the monic `P`; the remainder maps into the kernel as well.
  have hsplit : f %ₘ P + P * (f /ₘ P) = f := modByMonic_add_div f P
  -- A multiple of `P.map ι` of degree below that of `P.map ι` vanishes.
  have hdvd : P.map ι ∣ (f %ₘ P).map ι := by
    refine (dvd_add_left (dvd_mul_right (P.map ι) ((f /ₘ P).map ι))).1 ?_
    rw [← Polynomial.map_mul, ← Polynomial.map_add, hsplit]
    exact (hmem _).1 hf
  have hdeg : ((f %ₘ P).map ι).degree < (P.map ι).degree := by
    rw [degree_map_eq_of_injective hι, degree_map_eq_of_injective hι]
    exact degree_modByMonic_lt f hP
  have hzero : f %ₘ P = 0 :=
    Polynomial.map_injective ι hι (by
      simpa using Polynomial.eq_zero_of_dvd_of_degree_lt hdvd hdeg)
  rw [hzero, zero_add] at hsplit
  rw [Ideal.mem_span_singleton]
  exact ⟨f /ₘ P, hsplit.symm⟩

end Polynomial

namespace MvPolynomial

/-- `MvPolynomial.finLastEquiv` is natural in the coefficient ring: splitting off the last
variable commutes with a coefficientwise ring map. -/
theorem map_finLastEquiv {A : Type u} {R : Type v} [CommSemiring A] [CommSemiring R]
    (ι : A →+* R) (n : ℕ) (p : MvPolynomial (Fin (n + 1)) A) :
    finLastEquiv R n (map ι p) = (finLastEquiv A n p).map (map ι) := by
  have key : ((finLastEquiv R n).toRingHom.comp (map ι) :
      MvPolynomial (Fin (n + 1)) A →+* Polynomial (MvPolynomial (Fin n) R)) =
      (Polynomial.mapRingHom (map ι)).comp (finLastEquiv A n).toRingHom := by
    refine ringHom_ext (fun a ↦ ?_) (fun i ↦ ?_)
    · simp
    · induction i using Fin.lastCases with
      | last => simp
      | cast j => simp
  exact RingHom.congr_fun key p

/-- **Monic descent of a principal kernel.** Let `ι : A →+* K` be an injective homomorphism into
a domain, let `ψ : K[x₀, …, x_n] →+* L` have kernel generated by the coefficientwise image of a
`P : A[x₀, …, x_n]` which is monic in the last variable, and let `ψ₀` be the restriction of `ψ`
to `A[x₀, …, x_n]`. Then the kernel of `ψ₀` is generated by `P`.

This is the descent the text of Stacks Tag 0559 omits; see the module documentation. -/
theorem ker_comp_map_eq_span_of_monic {A : Type u} {K : Type v} {L : Type w} [CommRing A]
    [CommRing K] [CommRing L] [IsDomain K] (ι : A →+* K) (hι : Function.Injective ι) {n : ℕ}
    (ψ : MvPolynomial (Fin (n + 1)) K →+* L) {P : MvPolynomial (Fin (n + 1)) A}
    (hP : (finLastEquiv A n P).Monic)
    (hker : RingHom.ker ψ = Ideal.span {map ι P}) :
    RingHom.ker (ψ.comp (map ι)) = Ideal.span {P} := by
  -- The kernel of `ψ`, read through the splitting of the last variable.
  have hker₁ : RingHom.ker (ψ.comp ((finLastEquiv K n).toRingEquiv.symm :
        Polynomial (MvPolynomial (Fin n) K) →+* MvPolynomial (Fin (n + 1)) K)) =
      Ideal.span {(finLastEquiv A n P).map (map ι)} := by
    rw [MvPolynomial.ker_comp_ringEquiv (finLastEquiv K n).toRingEquiv.symm ψ hker,
      RingEquiv.symm_symm]
    exact congrArg (fun q ↦ Ideal.span {q}) (map_finLastEquiv ι n P)
  -- Apply the one-variable descent over the polynomial ring in the first `n` variables.
  have hone : RingHom.ker ((ψ.comp ((finLastEquiv K n).toRingEquiv.symm :
        Polynomial (MvPolynomial (Fin n) K) →+* MvPolynomial (Fin (n + 1)) K)).comp
        (Polynomial.mapRingHom (map ι))) = Ideal.span {finLastEquiv A n P} :=
    Polynomial.ker_comp_mapRingHom_eq_span_of_monic (map ι) (map_injective ι hι) _ hP hker₁
  -- Transport back along the splitting.
  have hcomp : ψ.comp (map ι) =
      ((ψ.comp ((finLastEquiv K n).toRingEquiv.symm :
        Polynomial (MvPolynomial (Fin n) K) →+* MvPolynomial (Fin (n + 1)) K)).comp
        (Polynomial.mapRingHom (map ι))).comp
        ((finLastEquiv A n).toRingEquiv : MvPolynomial (Fin (n + 1)) A →+*
          Polynomial (MvPolynomial (Fin n) A)) := by
    refine RingHom.ext fun p ↦ ?_
    simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, RingEquiv.coe_toRingHom,
      AlgEquiv.coe_toRingEquiv, AlgEquiv.toRingEquiv_symm]
    rw [← map_finLastEquiv ι n p, AlgEquiv.symm_apply_apply]
  rw [hcomp, MvPolynomial.ker_comp_ringEquiv (finLastEquiv A n).toRingEquiv _ hone]
  simp

end MvPolynomial

end
