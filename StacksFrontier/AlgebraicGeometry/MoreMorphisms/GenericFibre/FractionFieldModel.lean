/-!
# The function field as the fraction field of the standard model

Part of Step D of the proof of Stacks Tag 0559. Step C and the transport of
`StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.LastVariable` present the function
field `L` of the generic fibre as `K[x₁, …, x_{r+1}] ⧸ (q)` with its fractions taken: the
quotient `B` embeds into `L`, and `L` is generated over `K` by the images of the variables, so
`L` is a field of fractions of `B`. That identification is what Stacks Tag 0552 compares the
generic fibre with `Spec B` along, and this file supplies it in the shape the repackaged
Tag 0552 of
`AlgebraicGeometry.exists_nonempty_open_iso_of_residueFieldIso_of_appTop` asks for: an
isomorphism `e` of the two residue fields at the generic points together with the single
equation on global sections.

## Main results

* `IsFractionRing.of_intermediateField_adjoin_eq_top`: a domain embedded in a field whose image
  generates that field is a ring of fractions of it.
* `MvPolynomial.isFractionRing_quotient_of_adjoin_eq_top`: **`Frac(B) ≅ L` for the standard
  model**, for the quotient of a polynomial ring by the kernel of an evaluation whose values
  generate the field.
* `AlgebraicGeometry.Γevaluation_comp_specMap_appTop`: the structure map of `Spec S` over
  `Spec R` seen on the residue field at a point of `Spec S`.
* `AlgebraicGeometry.exists_residueFieldIso_appTop_of_isFractionRing`: **the `e` and the
  global-sections equation** of
  `AlgebraicGeometry.exists_nonempty_open_iso_of_residueFieldIso_of_appTop`, from the statement
  that the function field of `X` is a field of fractions of `S`.

## Implementation notes

The embedding of the quotient into the field is an argument rather than a construction, so no
proof term occurs in any statement: the caller supplies `φ` together with the equation
`φ ∘ mk = aeval v`, which is what `Ideal.Quotient.liftₐ` produces.

The two residue fields of
`AlgebraicGeometry.exists_residueFieldIso_appTop_of_isFractionRing` are localizations of `S` at
the same submonoid — one by hypothesis, one by
`AlgebraicGeometry.isFractionRing_specResidueField_genericPoint` — so `e` is
`IsLocalization.algEquiv`, and the global-sections equation is its `S`-linearity read through
`AlgebraicGeometry.Γevaluation_comp_specMap_appTop`. No transport along an equality of points
occurs, which is the point of the repackaged interface.

No Stacks tag is attached: Step D is not itself a tag of the source.

## References

* [Stacks Project, Tag 0559](https://stacks.math.columbia.edu/tag/0559), Step D of the first
  proof
* [Stacks Project, Tag 0552](https://stacks.math.columbia.edu/tag/0552)
-/

@[expose] public section

open CategoryTheory

universe u v w

/-- A domain embedded as a `K`-subalgebra of a field `L`, whose image generates `L` over `K` as
a field, is a ring of fractions of `L`: every element of the subfield generated by a subring is
a ratio of two elements of that subring. -/
theorem IsFractionRing.of_intermediateField_adjoin_eq_top {K L B : Type*} [Field K] [Field L]
    [Algebra K L] [CommRing B] [Algebra K B] (φ : B →ₐ[K] L) (hφ : Function.Injective φ)
    (S : Set L) (hS : IntermediateField.adjoin K S = ⊤) (hSr : S ⊆ Set.range φ) :
    letI := φ.toRingHom.toAlgebra
    IsFractionRing B L := by
  let _ := φ.toRingHom.toAlgebra
  have halg : ∀ b : B, algebraMap B L b = φ b := fun _ => rfl
  have : FaithfulSMul B L := (faithfulSMul_iff_algebraMap_injective B L).mpr hφ
  refine IsFractionRing.of_field _ _ fun z => ?_
  have hz : z ∈ IntermediateField.adjoin K S := by simp [hS]
  obtain ⟨x, hx, y, hy, hxy⟩ := IntermediateField.mem_adjoin_iff_div.mp hz
  have hle : Algebra.adjoin K S ≤ φ.range := Algebra.adjoin_le fun s hs => hSr hs
  obtain ⟨a, ha⟩ := hle hx
  obtain ⟨b, hb⟩ := hle hy
  have ha' : φ a = x := ha
  have hb' : φ b = y := hb
  exact ⟨a, b, by rw [halg, halg, ha', hb', hxy]⟩

namespace MvPolynomial

/-- A ring homomorphism out of a quotient is injective as soon as the ideal is the kernel of a
homomorphism it factors. -/
theorem injective_of_comp_quotientMk_eq {A L : Type*} [CommRing A] [CommRing L]
    {I : Ideal A} (φ : (A ⧸ I) →+* L) (ψ : A →+* L)
    (hφ : φ.comp (Ideal.Quotient.mk I) = ψ) (hI : I = RingHom.ker ψ) :
    Function.Injective φ := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [Ideal.Quotient.eq_zero_iff_mem, hI, RingHom.mem_ker, ← hφ]
  simpa using hx

/-- **`Frac(B) ≅ L` for the standard model, part of Step D of Stacks Tag 0559.** Let `L` be a
field extension of `K` generated by a family `v : ι → L`, and let `B` be the quotient of
`MvPolynomial ι K` by an ideal `I` embedded in `L` by a map `φ` factoring evaluation at `v`.
Then `L` is a field of fractions of `B`. -/
theorem isFractionRing_quotient_of_adjoin_eq_top {K : Type u} [Field K] {L : Type v} [Field L]
    [Algebra K L] {ι : Type w} (v : ι → L)
    (hv : IntermediateField.adjoin K (Set.range v) = ⊤) {I : Ideal (MvPolynomial ι K)}
    (φ : (MvPolynomial ι K ⧸ I) →ₐ[K] L) (hφinj : Function.Injective φ)
    (hφ : φ.comp (Ideal.Quotient.mkₐ K I) = (aeval v : MvPolynomial ι K →ₐ[K] L)) :
    letI := φ.toRingHom.toAlgebra
    IsFractionRing (MvPolynomial ι K ⧸ I) L := by
  refine IsFractionRing.of_intermediateField_adjoin_eq_top φ hφinj _ hv ?_
  rintro - ⟨i, rfl⟩
  refine ⟨Ideal.Quotient.mkₐ K I (X i), ?_⟩
  simpa using congrArg (fun ρ : MvPolynomial ι K →ₐ[K] L => ρ (X i)) hφ

end MvPolynomial

namespace AlgebraicGeometry

/-- The structure map of `Spec S` over `Spec R`, read on the residue field at a point of
`Spec S`: it is the ring map `f` followed by the canonical map of `S` into that residue
field. -/
theorem Γevaluation_comp_specMap_appTop {R S : CommRingCat.{u}} (f : R ⟶ S) (s : Spec S) :
    (Scheme.ΓSpecIso R).inv ≫ (Spec.map f).appTop ≫ (Spec S).Γevaluation s =
      f ≫ (Scheme.ΓSpecIso S).inv ≫ (Spec S).Γevaluation s := by
  rw [← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality, Category.assoc]

/-- **The residue field isomorphism of Step D of Stacks Tag 0559, with its global-sections
equation.** Let `S` be a domain, let `X` be an integral scheme over `Spec R` and suppose the
residue field of `X` at its generic point is a field of fractions of `S`, compatibly with the
structure morphism of `X`. Then that residue field is isomorphic to the residue field of
`Spec S` at its generic point, by an isomorphism satisfying the single global-sections equation
required by
`AlgebraicGeometry.exists_nonempty_open_iso_of_residueFieldIso_of_appTop`. -/
theorem exists_residueFieldIso_appTop_of_isFractionRing {R S : CommRingCat.{u}} [IsDomain S]
    (f : R ⟶ S) {X : Scheme.{u}} [IsIntegral X] (sX : X ⟶ Spec R)
    [Algebra S (X.residueField (genericPoint X))]
    (hfrac : IsFractionRing S (X.residueField (genericPoint X)))
    (hcompat : f ≫ CommRingCat.ofHom (algebraMap S (X.residueField (genericPoint X))) =
      (Scheme.ΓSpecIso R).inv ≫ sX.appTop ≫ X.Γevaluation (genericPoint X)) :
    ∃ e : X.residueField (genericPoint X) ≅ (Spec S).residueField (genericPoint (Spec S)),
      sX.appTop ≫ X.Γevaluation (genericPoint X) ≫ e.hom =
        (Spec.map f).appTop ≫ (Spec S).Γevaluation (genericPoint (Spec S)) := by
  let _ := specResidueFieldAlgebra S (genericPoint (Spec S))
  have _ : IsLocalization (nonZeroDivisors S)
      ((Spec S).residueField (genericPoint (Spec S))) :=
    isFractionRing_specResidueField_genericPoint S
  have _ : IsLocalization (nonZeroDivisors S) (X.residueField (genericPoint X)) := hfrac
  let ε : X.residueField (genericPoint X) ≃ₐ[S]
      (Spec S).residueField (genericPoint (Spec S)) :=
    IsLocalization.algEquiv (nonZeroDivisors S) _ _
  have key : ((Scheme.ΓSpecIso R).inv ≫ sX.appTop ≫ X.Γevaluation (genericPoint X)) ≫
      (ε.toRingEquiv.toCommRingCatIso (R := X.residueField (genericPoint X))
        (S := (Spec S).residueField (genericPoint (Spec S)))).hom =
      f ≫ (Scheme.ΓSpecIso S).inv ≫ (Spec S).Γevaluation (genericPoint (Spec S)) := by
    rw [← hcompat, Category.assoc]
    congr 1
    exact CommRingCat.hom_ext (RingHom.ext fun x => ε.commutes x)
  refine ⟨ε.toRingEquiv.toCommRingCatIso (R := X.residueField (genericPoint X))
    (S := (Spec S).residueField (genericPoint (Spec S))), ?_⟩
  rw [← Iso.cancel_iso_inv_left (Scheme.ΓSpecIso R), Γevaluation_comp_specMap_appTop]
  simpa using key

end AlgebraicGeometry

end
