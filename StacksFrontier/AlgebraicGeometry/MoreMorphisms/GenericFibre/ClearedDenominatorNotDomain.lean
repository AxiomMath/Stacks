module

public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.Algebra.Order.Field.Rat
public import Mathlib.RingTheory.Ideal.Quotient.Basic

/-!
# A cleared-denominator model which is not a domain

Step C of the first proof of Stacks Tag 0559 clears the denominators of a generator `Q` of a
finite separable extension `L` of `K(x₁, …, x_r)`, obtaining a polynomial `P` over the base
domain `A`, and then treats `B' = A[x₁, …, x_{r+1}]/(P)` as an integral model of `L` — it uses
`Frac(B') = L` with no further argument. Read as a statement about an arbitrary polynomial `P`
satisfying what clearing denominators records about it, that step is false: `B'` need not be a
domain, so it need not have a fraction field at all.

The witness is as small as a witness can be. Take `A = ℤ`, so `K = ℚ`, let `Q = x` be the monic
generator, and let `P = 2x`. Then `P` satisfies the whole conclusion of
`MvPolynomial.exists_map_eq_C_mul` with multiplier `a = 2`: its image in `ℚ[x]` is `C 2 * Q`.
But `ℤ[x]/(2x)` has zero divisors — the classes of `2` and of `x` are both nonzero and their
product is zero — so `(2x)` is not a prime ideal and `ℤ[x]/(2x)` is not a domain.

Tag 0559 is a true theorem and nothing here bears on it. What fails is one reading of one
intermediate step of the source's proof, which states less about `P` than the step needs. The
repair under way elsewhere in this development chooses `P` monic in the last variable rather
than merely denominator-cleared. Nothing in the proof of Tag 0559 imports this module.

## Main results

* `AlgebraicGeometry.GenericFibre.not_isPrime_span_two_mul_X`: the ideal `(2x)` of `ℤ[x]` is
  not prime.
* `AlgebraicGeometry.GenericFibre.exists_zeroDivisors_quotient_span_two_mul_X`: the explicit zero
  divisors in `ℤ[x]/(2x)`.
* `AlgebraicGeometry.GenericFibre.not_isDomain_quotient_span_two_mul_X`: `ℤ[x]/(2x)` is not a
  domain.
* `AlgebraicGeometry.GenericFibre.map_two_mul_X_eq_C_mul`: what the clearing step does give for
  this `P`.
* `AlgebraicGeometry.GenericFibre.not_forall_isPrime_span_of_map_eq_C_mul`: what it does not give —
  the conclusion of `MvPolynomial.exists_map_eq_C_mul` does not entail that `P` generates a
  prime ideal, even for the most favourable generator `Q = x`.

## Implementation notes

`ℤ[x]` is `MvPolynomial (Fin 1) ℤ`, which is the shape `MvPolynomial.exists_map_eq_C_mul`
produces, and `x` is `MvPolynomial.X 0`.

That `2 ∉ (2x)` is seen by evaluating at `x = 0`, and that `x ∉ (2x)` by reading the coefficient
of `x`: every coefficient of `2 * f` is even, while the coefficient of `x` in `x` is `1`.

`Ideal.Quotient.isDomain_iff_prime` turns the non-primeness of `(2x)` into the failure of
`IsDomain`; `exists_zeroDivisors_quotient_span_two_mul_X` records the same obstruction in the
quotient itself, where it is what a reader of the source would look for.

No `@[stacks]` attribute is placed anywhere in this module: a counterexample to a reading of an
intermediate step of a proof is not a statement of the source.

## References

* [Stacks Project, Tag 0559](https://stacks.math.columbia.edu/tag/0559), Step C of the first
  proof
* `MvPolynomial.exists_map_eq_C_mul` in
  `StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.ClearDenominators`
-/

@[expose] public section

open MvPolynomial

namespace AlgebraicGeometry.GenericFibre

/-- In `ℤ[x]`, the constant `2` does not lie in the principal ideal generated by `2x`: evaluating
at `x = 0` would force `2 = 0` in `ℤ`. -/
theorem two_notMem_span_two_mul_X :
    (2 : MvPolynomial (Fin 1) ℤ) ∉ Ideal.span {(2 * X 0 : MvPolynomial (Fin 1) ℤ)} := by
  rw [Ideal.mem_span_singleton]
  rintro ⟨q, hq⟩
  have hc := congrArg (eval fun _ ↦ (0 : ℤ)) hq
  simp [map_ofNat] at hc

/-- In `ℤ[x]`, the variable `x` does not lie in the principal ideal generated by `2x`: every
coefficient of a multiple of `2x` is even, while the coefficient of `x` in `x` is `1`. -/
theorem X_notMem_span_two_mul_X :
    (X 0 : MvPolynomial (Fin 1) ℤ) ∉ Ideal.span {(2 * X 0 : MvPolynomial (Fin 1) ℤ)} := by
  rw [Ideal.mem_span_singleton]
  rintro ⟨q, hq⟩
  have h2 : (2 : MvPolynomial (Fin 1) ℤ) = C 2 := by simp
  have hc := congrArg (coeff (Finsupp.single 0 1)) hq
  rw [h2, mul_assoc, coeff_C_mul, coeff_X_same] at hc
  omega

/-- The ideal `(2x)` of `ℤ[x]` is not prime: it contains `2 * x` but neither `2` nor `x`. -/
theorem not_isPrime_span_two_mul_X :
    ¬ (Ideal.span {(2 * X 0 : MvPolynomial (Fin 1) ℤ)}).IsPrime := by
  intro h
  rcases h.mem_or_mem (Ideal.mem_span_singleton_self _) with h2 | hX
  · exact two_notMem_span_two_mul_X h2
  · exact X_notMem_span_two_mul_X hX

/-- **The zero divisors.** The classes of `2` and of `x` in `ℤ[x]/(2x)` are both nonzero and
their product is zero. -/
theorem exists_zeroDivisors_quotient_span_two_mul_X :
    ∃ u v : MvPolynomial (Fin 1) ℤ ⧸ Ideal.span {(2 * X 0 : MvPolynomial (Fin 1) ℤ)},
      u ≠ 0 ∧ v ≠ 0 ∧ u * v = 0 := by
  refine ⟨Ideal.Quotient.mk _ 2, Ideal.Quotient.mk _ (X 0), ?_, ?_, ?_⟩
  · rw [Ne, Ideal.Quotient.eq_zero_iff_mem]
    exact two_notMem_span_two_mul_X
  · rw [Ne, Ideal.Quotient.eq_zero_iff_mem]
    exact X_notMem_span_two_mul_X
  · rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton_self _

/-- **The counterexample.** The ring `ℤ[x]/(2x)` is not a domain, so it has no fraction field. -/
theorem not_isDomain_quotient_span_two_mul_X :
    ¬ IsDomain (MvPolynomial (Fin 1) ℤ ⧸ Ideal.span {(2 * X 0 : MvPolynomial (Fin 1) ℤ)}) :=
  fun h ↦ not_isPrime_span_two_mul_X ((Ideal.Quotient.isDomain_iff_prime _).mp h)

/-- **What clearing denominators does give.** With `A = ℤ`, `K = ℚ` and `Q = x`, the polynomial
`P = 2x` over `ℤ` satisfies the conclusion of `MvPolynomial.exists_map_eq_C_mul` with the
nonzero multiplier `a = 2`. -/
theorem map_two_mul_X_eq_C_mul :
    (2 * X 0 : MvPolynomial (Fin 1) ℤ).map (algebraMap ℤ ℚ)
      = C (algebraMap ℤ ℚ 2) * X 0 := by
  rw [map_mul, MvPolynomial.map_X]
  congr 1
  simp [map_ofNat]

/-- **What clearing denominators does not give.** A polynomial `P` over `ℤ` whose image in `ℚ[x]`
is a nonzero constant multiple of `x` need not generate a prime ideal, so Step C of the source's
proof cannot pass from the conclusion of `MvPolynomial.exists_map_eq_C_mul` to the integrality of
`A[x₁, …, x_{r+1}]/(P)`. The generator `Q = x` here is monic of degree one, so no hypothesis on
`Q` short of one on `P` itself repairs the step; the repair elsewhere in this development
constrains `P`, by taking it monic in the last variable. -/
theorem not_forall_isPrime_span_of_map_eq_C_mul :
    ¬ ∀ (P : MvPolynomial (Fin 1) ℤ) (a : ℤ), a ≠ 0 →
        P.map (algebraMap ℤ ℚ) = C (algebraMap ℤ ℚ a) * X 0 →
        (Ideal.span {P}).IsPrime :=
  fun h ↦ not_isPrime_span_two_mul_X (h (2 * X 0) 2 two_ne_zero map_two_mul_X_eq_C_mul)

end AlgebraicGeometry.GenericFibre

end
