module

public import Mathlib.RingTheory.FiniteType
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.ModelComparison

/-!
# Comparing a variety with the spectrum of a model of its function field

The scheme-side inputs of Step D of the proof of Stacks Tag 0559 over a field. Tag 0552, in the
form `AlgebraicGeometry.exists_nonempty_open_iso_spec_of_isFractionRing`, compares an integral
scheme `X` of finite type over `Spec R` with the spectrum of a domain `S` whose field of
fractions is the residue field of `X` at its generic point. Two of its hypotheses are not
instances:

* that the structure morphism of `Spec S` over `Spec R` is locally of finite type, which for the
  standard model `MvPolynomial (Fin n) K ⧸ (Q)` of Step D is the statement that the model is a
  finitely generated algebra;
* that the generic point of `X` lies over the generic point of `Spec R`, which over a field base
  is automatic, the spectrum of a field being a single point.

## Main results

* `AlgebraicGeometry.locallyOfFiniteType_specMap_algebraMap`: the spectrum of a finitely
  generated algebra is locally of finite type over the spectrum of its base.
* `AlgebraicGeometry.exists_nonempty_open_iso_spec_of_isFractionRing_of_field`: **Tag 0552 over a
  field base**, with the hypothesis on the generic point discharged.

## Implementation notes

`AlgebraicGeometry.locallyOfFiniteType_specMap_algebraMap` is stated for an arbitrary
`Algebra.FiniteType` rather than for the model itself, because the model occurs in the
composition both as `MvPolynomial (Fin n) K ⧸ (Q)` and as the localization of such a quotient;
both are finitely generated by instance.

Injectivity of the ring map out of the base is not a hypothesis over a field base: a ring
homomorphism from a field to a nonzero ring is injective.

No Stacks tag is attached: Tag 0552 is already carried by the source of
`AlgebraicGeometry.exists_nonempty_open_iso_of_residueFieldIso`, and Step D of Tag 0559 is not
itself a tag of the source.

## References

* [Stacks Project, Tag 0559](https://stacks.math.columbia.edu/tag/0559), Step D of the first
  proof
* [Stacks Project, Tag 0552](https://stacks.math.columbia.edu/tag/0552)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

/-- The spectrum of a finitely generated algebra is locally of finite type over the spectrum of
its base. -/
theorem locallyOfFiniteType_specMap_algebraMap (A B : Type u) [CommRing A] [CommRing B]
    [Algebra A B] [Algebra.FiniteType A B] :
    LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap A B))) := by
  rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
  exact RingHom.finiteType_algebraMap.mpr ‹Algebra.FiniteType A B›

/-- The standard hypersurface model of Step D of Stacks Tag 0559 is a finitely generated
algebra, hence its spectrum is locally of finite type over the base. -/
theorem locallyOfFiniteType_specMap_mvPolynomialQuotient (A : Type u) [CommRing A] (n : ℕ)
    (I : Ideal (MvPolynomial (Fin n) A)) :
    LocallyOfFiniteType
      (Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin n) A ⧸ I)))) :=
  locallyOfFiniteType_specMap_algebraMap _ _

/-- **Stacks Project, Tag 0552 over a field base**, in the form Step D of Tag 0559 uses it. Let
`K` be a field, let `S` be a domain with a ring homomorphism `K ⟶ S`, and let `X` be an integral
scheme locally of finite type over `Spec K`. If the residue field of `X` at its generic point is
a field of fractions of `S`, compatibly with the structure morphism of `X`, then `X` and
`Spec S` have isomorphic nonempty open subschemes over `Spec K`.

The hypothesis of
`AlgebraicGeometry.exists_nonempty_open_iso_spec_of_isFractionRing` that the generic point of
`X` lies over the generic point of the base is absent: the spectrum of a field is a single
point. -/
theorem exists_nonempty_open_iso_spec_of_isFractionRing_of_field (K : Type u) [Field K]
    {S : CommRingCat.{u}} [IsDomain S] (f : CommRingCat.of K ⟶ S) {X : Scheme.{u}} [IsIntegral X]
    (sX : X ⟶ Spec (CommRingCat.of K)) [LocallyOfFiniteType sX]
    [LocallyOfFiniteType (Spec.map f)] [Algebra S (X.residueField (genericPoint X))]
    (hfrac : IsFractionRing S (X.residueField (genericPoint X)))
    (hcompat : f ≫ CommRingCat.ofHom (algebraMap S (X.residueField (genericPoint X))) =
      (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ sX.appTop ≫ X.Γevaluation (genericPoint X)) :
    ∃ (U : X.Opens) (V : (Spec S).Opens), (U : Set X).Nonempty ∧
      (V : Set (Spec S)).Nonempty ∧
      ∃ e' : U.toScheme ≅ V.toScheme, e'.hom ≫ V.ι ≫ Spec.map f = U.ι ≫ sX := by
  have hpt : Subsingleton (Spec (CommRingCat.of K)) :=
    inferInstanceAs (Subsingleton (PrimeSpectrum K))
  exact exists_nonempty_open_iso_spec_of_isFractionRing f f.hom.injective sX
    (Subsingleton.elim _ _) hfrac hcompat

end AlgebraicGeometry

end
