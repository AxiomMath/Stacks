module

public import Mathlib.FieldTheory.SeparablyGenerated
public import StacksFrontier.FieldTheory.Separable.TFAE
public import StacksFrontier.FieldTheory.TranscendentalSeparable
import StacksCore.Tactic.EgaSgaAttribute

/-!
# A primitive separating transcendence basis of a geometrically reduced extension

Step B of the proof of Stacks Tag 0559. Let `L/K` be a finitely generated field extension
which is geometrically reduced over `K` — in the application `K` is the function field of the
base and `L` the function field of the generic fibre, which is geometrically reduced and
geometrically irreducible by Step A. Then `L` is separably generated over `K`, and with
`r = trdeg K L` there are `x₁, …, x_{r+1} ∈ L` which generate `L` over `K` and such that
`x₁, …, x_r` is a transcendence basis over which `x_{r+1}` is separable.

This is the combination of [Stacks 030W] — geometric reducedness gives a separating
transcendence basis — with [Stacks 030Q], the primitive element theorem applied over the
subfield generated by that basis.

## Main results

* `Algebra.separablyGenerated_of_isGeometricallyReduced`: a finitely generated geometrically
  reduced field extension is separably generated.
* `Algebra.exists_primitive_separating_transcendence_basis`: the family `x₁, …, x_{r+1}` of the
  source, for a prescribed transcendence degree `r`.
* `Algebra.exists_trdeg_primitive_separating_transcendence_basis`: the same with the
  transcendence degree produced rather than prescribed.

## Implementation notes

`SeparablyGenerated` indexes its transcendence basis by a type in `Type`, so the finite basis
produced by [Stacks 030W] is reindexed by `Fin t.card` before it is fed to [Stacks 030Q]. The
transcendence degree is `Algebra.trdeg`, which is `Cardinal`-valued; the hypothesis `hr` of
[Stacks 030Q] is that it is the natural number `r`, and for a finitely generated extension such
an `r` exists because a transcendence basis is finite.

The route to separable generation duplicates the four lines of the private lemma
`exists_isTranscendenceBasis_and_isSeparable_of_isGeometricallyReduced` of the namespace
`Stacks.Separable.SeparablyGenerated` (`StacksFrontier/FieldTheory/Separable/Basic.lean`), which is
not exported; the public theorem of that file, Tag 030X, takes a separating transcendence basis
as its hypothesis rather than geometric reducedness, so it cannot be used here.

No Stacks tag is attached: Steps B and C of the proof of Tag 0559 are not themselves tags of
the source.

## References

* [Stacks Project, Tag 0559](https://stacks.math.columbia.edu/tag/0559), Step B of the first
  proof
* [Stacks Project, Tag 030W](https://stacks.math.columbia.edu/tag/030W)
* [Stacks Project, Tag 030Q](https://stacks.math.columbia.edu/tag/030Q)
-/

@[expose] public section

namespace Algebra

/-- A finitely generated geometrically reduced field extension has a finite separating
transcendence basis: for a prime exponential characteristic this is condition (2) of
[Stacks 030W] fed to Mathlib's transcendence-basis argument, and in characteristic zero the
base field is perfect. -/
@[sga "1 II 5.6" "(iv)⇒(i), K a field"]
private theorem exists_finite_separating_transcendence_basis (K L : Type*) [Field K] [Field L]
    [Algebra K L] [Algebra.EssFiniteType K L] [Algebra.IsGeometricallyReduced K L] :
    ∃ t : Finset L, IsTranscendenceBasis K ((↑) : t → L) ∧
      Algebra.IsSeparable (IntermediateField.adjoin K (t : Set L)) L := by
  obtain ⟨p, hp⟩ := ExpChar.exists K
  obtain hp' | rfl := expChar_is_prime_or_one (R := K) p
  · have H := ((Algebra.isSeparableExtension_tfae K L p).out 4 2).mp ‹_›
    exact exists_isTranscendenceBasis_and_isSeparable_of_linearIndepOn_pow_of_essFiniteType p hp'
      fun t ht ↦ H _ ht
  · have : CharZero K := charZero_of_expChar_one' K
    exact exists_isTranscendenceBasis_and_isSeparable_of_perfectField K L

/-- A finitely generated field extension which is geometrically reduced is separably generated:
it has a transcendence basis over which it is separable algebraic. This is the implication
(4) ⇒ (1) of [Stacks 030W] in the finitely generated case. -/
@[sga "1 II 5.6" "(iv) ⇒ (i) for fields"]
theorem separablyGenerated_of_isGeometricallyReduced (K L : Type*) [Field K] [Field L]
    [Algebra K L] [Algebra.EssFiniteType K L] [Algebra.IsGeometricallyReduced K L] :
    SeparablyGenerated K L := by
  classical
  obtain ⟨t, ht, hsep⟩ := exists_finite_separating_transcendence_basis K L
  refine ⟨Fin t.card, fun i ↦ ((t.equivFin.symm i : L)), ?_, ?_⟩
  · exact (isTranscendenceBasis_equiv t.equivFin.symm (f := ((↑) : t → L))).mpr ht
  · have hrange : Set.range (fun i : Fin t.card ↦ ((t.equivFin.symm i : L))) = (t : Set L) := by
      rw [show (fun i : Fin t.card ↦ ((t.equivFin.symm i : L))) =
        ((↑) : t → L) ∘ t.equivFin.symm from rfl, EquivLike.range_comp]
      exact Subtype.range_coe
    rw [hrange]
    exact hsep

/-- The transcendence degree of a finitely generated field extension is a natural number. -/
private theorem exists_trdeg_eq_natCast (K L : Type*) [Field K] [Field L] [Algebra K L]
    [Algebra.EssFiniteType K L] [Algebra.IsGeometricallyReduced K L] :
    ∃ r : ℕ, Algebra.trdeg K L = r := by
  obtain ⟨t, ht, -⟩ := exists_finite_separating_transcendence_basis K L
  refine ⟨t.card, ?_⟩
  rw [← ht.cardinalMk_eq_trdeg, Cardinal.mk_coe_finset]

/-- **Step B and the primitive element of Step C of Stacks Tag 0559.** Let `L/K` be a finitely
generated field extension which is geometrically reduced over `K`, of transcendence degree `r`.
Then there are `x₁, …, x_{r+1} ∈ L` such that `x₁, …, x_r` is a transcendence basis of `L/K`,
the whole family generates `L` over `K`, and `x_{r+1}` is separable over the subfield
`K(x₁, …, x_r)` generated by the basis. -/
@[sga "1 II 5.6" "(iv) ⇒ (i) for fields"]
theorem exists_primitive_separating_transcendence_basis (K L : Type*) [Field K] [Field L]
    [Algebra K L] [Algebra.EssFiniteType K L] [Algebra.IsGeometricallyReduced K L] (r : ℕ)
    (hr : Algebra.trdeg K L = r) :
    ∃ x : Fin (r + 1) → L,
      IsTranscendenceBasis K (fun i : Fin r ↦ x i.castSucc) ∧
      IntermediateField.adjoin K (Set.range x) = ⊤ ∧
      IsSeparable
        (↥(IntermediateField.adjoin K (Set.range (fun i : Fin r ↦ x i.castSucc))))
        (x (Fin.last r)) :=
  separablyGenerated_fg_exists_primitive_transcendence_basis K L
    (separablyGenerated_of_isGeometricallyReduced K L)
    (IntermediateField.fg_top_iff.mpr ‹_›) r hr

/-- `Algebra.exists_primitive_separating_transcendence_basis` with the transcendence degree
produced rather than prescribed. -/
@[sga "1 II 5.6" "(iv) ⇒ (i) for fields"]
theorem exists_trdeg_primitive_separating_transcendence_basis (K L : Type*) [Field K] [Field L]
    [Algebra K L] [Algebra.EssFiniteType K L] [Algebra.IsGeometricallyReduced K L] :
    ∃ (r : ℕ) (x : Fin (r + 1) → L),
      Algebra.trdeg K L = r ∧
      IsTranscendenceBasis K (fun i : Fin r ↦ x i.castSucc) ∧
      IntermediateField.adjoin K (Set.range x) = ⊤ ∧
      IsSeparable
        (↥(IntermediateField.adjoin K (Set.range (fun i : Fin r ↦ x i.castSucc))))
        (x (Fin.last r)) := by
  obtain ⟨r, hr⟩ := exists_trdeg_eq_natCast K L
  obtain ⟨x, hx⟩ := exists_primitive_separating_transcendence_basis K L r hr
  exact ⟨r, x, hr, hx⟩

end Algebra

end
