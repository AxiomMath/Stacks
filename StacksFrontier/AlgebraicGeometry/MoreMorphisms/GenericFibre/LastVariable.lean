module

public import Mathlib.Algebra.MvPolynomial.Equiv
public import Mathlib.Logic.Equiv.Fin.Rotate
public import Mathlib.RingTheory.Ideal.Maps

/-!
# Splitting off the last variable of a multivariate polynomial ring

Part of Step D of the proof of Stacks Tag 0559. Step C produces a polynomial `q` in the
one-variable polynomial ring `(K[x₁, …, x_r])[T]`, and Step D needs it as a polynomial in
`K[x₁, …, x_{r+1}]`, with `T` playing the role of the last variable: the separating
transcendence basis of Step B is indexed by `Fin.castSucc` and the primitive element by
`Fin.last`.

Mathlib's `MvPolynomial.finSuccEquiv` splits off the variable `0`, not the variable `Fin.last`,
so the identification needed here is that equivalence precomposed with the cyclic reindexing
`finRotate`, which sends `Fin.last r` to `0` and `i.castSucc` to `i.succ`.

## Main definitions

* `MvPolynomial.finLastEquiv`: the `R`-algebra equivalence
  `R[x₀, …, x_n] ≃ₐ[R] (R[x₀, …, x_{n-1}])[T]` carrying the last variable to `T`.

## Main results

* `MvPolynomial.aeval_toRingHom_eq_comp_finLastEquiv`: evaluating at a family
  `v : Fin (n + 1) → L` is evaluating the last variable at `v (Fin.last n)` over the base
  `R[x₀, …, x_{n-1}]`, whose own structure map evaluates `xᵢ` at `v i.castSucc`.
* `MvPolynomial.ker_aeval_eq_span_finLastEquiv_symm`: **the transport of Step C's polynomial.**
  If the kernel of the one-variable evaluation is generated by `q`, then the kernel of the
  multivariate evaluation is generated by the image of `q` under
  `MvPolynomial.finLastEquiv.symm`.

## Implementation notes

The hypotheses on the base `R[x₀, …, x_{n-1}]` are an algebra structure on `L` together with
`IsScalarTower` over `K` and the requirement that `xᵢ` act as `v i.castSucc`; this avoids having
to name the algebra structure in the statement.

The kernel transport is stated for the `RingHom` underlying each `AlgHom`, because the two
evaluations are algebra maps over different base rings.

## References

* [Stacks Project, Tag 0559](https://stacks.math.columbia.edu/tag/0559), Step D of the first
  proof
-/

@[expose] public section

universe u v

namespace MvPolynomial

variable (R : Type u) [CommSemiring R] (n : ℕ)

/-- The polynomial ring in `n + 1` variables, viewed as a polynomial ring in the **last**
variable over the polynomial ring in the first `n` variables. This is
`MvPolynomial.finSuccEquiv`, which splits off the variable `0`, precomposed with the cyclic
reindexing `finRotate`. -/
noncomputable def finLastEquiv :
    MvPolynomial (Fin (n + 1)) R ≃ₐ[R] Polynomial (MvPolynomial (Fin n) R) :=
  (renameEquiv R (finRotate (n + 1))).trans (finSuccEquiv R n)

/-- `MvPolynomial.finLastEquiv` sends the last variable to `Polynomial.X`. -/
@[simp]
theorem finLastEquiv_X_last : finLastEquiv R n (X (Fin.last n)) = Polynomial.X := by
  simp [finLastEquiv, finSuccEquiv_X_zero]

/-- `MvPolynomial.finLastEquiv` sends the variable `X i.castSucc` to the constant polynomial
`Polynomial.C (X i)`. -/
@[simp]
theorem finLastEquiv_X_castSucc (i : Fin n) :
    finLastEquiv R n (X i.castSucc) = Polynomial.C (X i) := by
  simp [finLastEquiv, Fin.coeSucc_eq_succ, finSuccEquiv_X_succ]

/-- `MvPolynomial.finLastEquiv` sends the constant `C c` to `Polynomial.C (C c)`. -/
@[simp]
theorem finLastEquiv_C (c : R) : finLastEquiv R n (C c) = Polynomial.C (C c) := by
  rw [← MvPolynomial.algebraMap_eq, AlgEquiv.commutes]
  simp [Polynomial.algebraMap_apply, MvPolynomial.algebraMap_eq]

variable {R n}

/-- A principal kernel transported along a ring equivalence of the source. -/
public theorem ker_comp_ringEquiv {A B L : Type*} [CommRing A] [CommRing B] [CommRing L]
    (e : A ≃+* B) (ψ : B →+* L) {q : B} (hq : RingHom.ker ψ = Ideal.span {q}) :
    RingHom.ker (ψ.comp (e : A →+* B)) = Ideal.span {e.symm q} := by
  rw [← RingHom.comap_ker, hq, Ideal.comap_coe, ← Ideal.map_symm e, Ideal.map_span,
    Set.image_singleton]

variable {K : Type u} [CommRing K] {L : Type v} [CommRing L] [Algebra K L]
  [Algebra (MvPolynomial (Fin n) K) L] [IsScalarTower K (MvPolynomial (Fin n) K) L]

/-- Multivariate evaluation at `v` is evaluation of the last variable at `v (Fin.last n)` over
the polynomial ring in the first `n` variables, whose structure map sends `xᵢ` to
`v i.castSucc`. -/
theorem aeval_toRingHom_eq_comp_finLastEquiv (v : Fin (n + 1) → L)
    (hv : ∀ i : Fin n, algebraMap (MvPolynomial (Fin n) K) L (X i) = v i.castSucc) :
    (Polynomial.aeval (v (Fin.last n)) :
        Polynomial (MvPolynomial (Fin n) K) →ₐ[MvPolynomial (Fin n) K] L).toRingHom.comp
        (finLastEquiv K n).toRingEquiv.toRingHom =
      (aeval v : MvPolynomial (Fin (n + 1)) K →ₐ[K] L).toRingHom := by
  refine MvPolynomial.ringHom_ext (fun c => ?_) (fun i => ?_) <;>
    change Polynomial.aeval _ (finLastEquiv K n _) = _
  · simp [IsScalarTower.algebraMap_eq K (MvPolynomial (Fin n) K) L, MvPolynomial.algebraMap_eq]
  · induction i using Fin.lastCases with
    | last => simp
    | cast j => simp [hv j]

/-- **The transport of Step C's polynomial, part of Step D of Stacks Tag 0559.** If the kernel
of evaluation at `v (Fin.last n)` over `K[x₀, …, x_{n-1}]` is generated by `q`, then the kernel
of the multivariate evaluation at `v` is generated by the image of `q` under
`MvPolynomial.finLastEquiv.symm`. -/
theorem ker_aeval_eq_span_finLastEquiv_symm (v : Fin (n + 1) → L)
    (hv : ∀ i : Fin n, algebraMap (MvPolynomial (Fin n) K) L (X i) = v i.castSucc)
    {q : Polynomial (MvPolynomial (Fin n) K)}
    (hq : RingHom.ker (Polynomial.aeval (v (Fin.last n)) :
        Polynomial (MvPolynomial (Fin n) K) →ₐ[MvPolynomial (Fin n) K] L).toRingHom =
      Ideal.span {q}) :
    RingHom.ker (aeval v : MvPolynomial (Fin (n + 1)) K →ₐ[K] L).toRingHom =
      Ideal.span {(finLastEquiv K n).symm q} := by
  rw [← aeval_toRingHom_eq_comp_finLastEquiv v hv]
  exact ker_comp_ringEquiv (finLastEquiv K n).toRingEquiv _ hq

end MvPolynomial

end
