module

public import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
public import Mathlib.RingTheory.Algebraic.Integral
public import Mathlib.RingTheory.AlgebraicIndependent.Adjoin
public import Mathlib.RingTheory.Localization.Integral
public import Mathlib.RingTheory.MvPolynomial.Localization
public import Mathlib.RingTheory.Polynomial.UniqueFactorization
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.SeparatingBasis
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.MonicDescent
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.ModelPresentation

/-!
# A hypersurface model of a geometrically integral function field, monic over a domain

Steps B, C and D(i) of the proof of Stacks Tag 0559, joined, with the primitive element replaced
by an integral multiple of itself chosen so that the resulting hypersurface equation has
coefficients in the base domain and is **monic in the last variable**.

Let `A` be a domain with fraction field `K`, let `L/K` be a finitely generated field extension
which is geometrically reduced over `K` and such that `L ⊗[K] K̄` is a domain for a field
extension `K̄` of `K`. Then there are a family `v : Fin (n + 1) → L` generating `L` over `K` and
a `P : MvPolynomial (Fin (n + 1)) A`, monic in the last variable, whose image in `K[xᵢ]`
generates the kernel of evaluation at `v`.

This is `Algebra.exists_mvPolynomial_model_of_isDomain_tensor` with two conclusions added: the
model is already defined over `A`, and it is monic. Both are needed to repair the step of the
source which asserts, of a model obtained by clearing denominators, that its fraction field is
`L`; see
`StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.MonicDescent` for why monicity is
the right substitute for the primitivity that clearing denominators produces.

## The two rescalings

Step B gives a transcendence basis `v ∘ Fin.castSucc` of `L/K` together with a primitive element
`θ = v (Fin.last r)`, which is algebraic over the fraction field of `R = K[x₁, …, x_r]`. Two
successive rescalings of `θ` by nonzero elements of `R` make the situation integral and then
integral over `A`:

* `IsAlgebraic.exists_integral_multiple` gives a nonzero `c : R` with `c • θ` integral over `R`.
  Since `R` is a unique factorization domain, hence integrally closed, the kernel of evaluation
  at `c • θ` is generated by the *monic* `minpoly R (c • θ)` (`minpoly.ker_eval`); the primitive
  polynomial of `IsFractionRing.exists_isPrimitive_irreducible_aeval_eq_zero_iff_dvd`, and the
  GCD structure it rests on, are not needed.
* `MvPolynomial R` over `K` is the localization of `MvPolynomial` over `A` at the nonzero
  constants (`MvPolynomial.isLocalization`), so
  `IsLocalization.scaleRoots_commonDenom_mem_lifts` provides a nonzero `a : A` after whose
  rescaling all coefficients of the minimal polynomial lie in `A[x₁, …, x_r]`. Rescaling the
  element rescales its minimal polynomial (`IsIntegrallyClosed.minpoly_smul`) and preserves
  monicity (`Polynomial.monic_scaleRoots_iff`), so the lift may be taken monic
  (`Polynomial.lifts_and_natDegree_eq_and_monic`).

Neither rescaling changes the generated extension: the multiplier is a nonzero element of the
subfield generated by the transcendence basis, so `θ` is recovered from the rescaled element by
one division.

## Main results

* `Algebra.exists_monic_mvPolynomial_model_of_isDomain_tensor`: the model over `A`, monic in the
  last variable, with its absolute irreducibility and the identification of `L` as the fraction
  field of the quotient over `K`.

## Implementation notes

The algebra structure on `L` over `R = K[x₁, …, x_r]` is set up as in
`Algebra.exists_mvPolynomial_model_of_isDomain_tensor`; the further structure over
`FractionRing R` is no longer needed, because `minpoly.ker_eval` works over `R` itself.
`MvPolynomial.algebraMvPolynomial` is made a local instance, as in
`Mathlib.RingTheory.MvPolynomial.Localization` and in
`StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.ClearDenominators`: it is the algebra
structure the localization instance is stated for, and it is deliberately not global.

Separability of the primitive element, which Step B also provides, is not used: absolute
irreducibility comes from the hypothesis that `L ⊗[K] K̄` is a domain.

No Stacks tag is attached: Steps B, C and D are not themselves tags of the source.

## References

* [Stacks Project, Tag 0559](https://stacks.math.columbia.edu/tag/0559), Steps B, C and D of the
  first proof
-/

@[expose] public section

open scoped TensorProduct nonZeroDivisors

open MvPolynomial

universe u v w

namespace Algebra

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- **Steps B, C and D(i) of Stacks Tag 0559, over a domain and with a monic generator.** Let `A`
be a domain with fraction field `K`, let `L` be a finitely generated field extension of `K` which
is geometrically reduced over `K`, and let `K̄` be a field extension of `K` such that `L ⊗[K] K̄`
is a domain. Then there are a natural number `n`, a family `v : Fin (n + 1) → L` generating `L`
over `K`, and a `P : MvPolynomial (Fin (n + 1)) A` which is monic in the last variable and whose
image in `K[xᵢ]` generates the kernel of evaluation at `v`, such that the coefficientwise image
of `P` in `K̄[xᵢ]` is irreducible and `L` is a field of fractions of
`MvPolynomial (Fin (n + 1)) K ⧸ (P)`. -/
theorem exists_monic_mvPolynomial_model_of_isDomain_tensor (A : Type u) [CommRing A] [IsDomain A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type v) [Field L]
    [Algebra K L] [Algebra.EssFiniteType K L] [Algebra.IsGeometricallyReduced K L]
    (Kbar : Type w) [Field Kbar] [Algebra K Kbar] (hL : IsDomain (L ⊗[K] Kbar)) :
    ∃ (n : ℕ) (v : Fin (n + 1) → L) (P : MvPolynomial (Fin (n + 1)) A),
      IntermediateField.adjoin K (Set.range v) = ⊤ ∧
      (finLastEquiv A n P).Monic ∧
      RingHom.ker (aeval v : MvPolynomial (Fin (n + 1)) K →ₐ[K] L).toRingHom =
          Ideal.span {P.map (algebraMap A K)} ∧
      Irreducible (P.map ((algebraMap K Kbar).comp (algebraMap A K))) ∧
      ∀ φ : (MvPolynomial (Fin (n + 1)) K ⧸ Ideal.span {P.map (algebraMap A K)}) →ₐ[K] L,
        φ.comp (Ideal.Quotient.mkₐ K (Ideal.span {P.map (algebraMap A K)})) =
            (aeval v : MvPolynomial (Fin (n + 1)) K →ₐ[K] L) →
          letI := φ.toRingHom.toAlgebra
          IsFractionRing (MvPolynomial (Fin (n + 1)) K ⧸
            Ideal.span {P.map (algebraMap A K)}) L := by
  classical
  obtain ⟨r, v, -, htr, hadj, -⟩ :=
    Algebra.exists_trdeg_primitive_separating_transcendence_basis K L
  have hind : AlgebraicIndependent K (fun i : Fin r ↦ v i.castSucc) := htr.1
  have hinj : Function.Injective (aeval (fun i : Fin r ↦ v i.castSucc) :
      MvPolynomial (Fin r) K →ₐ[K] L) := algebraicIndependent_iff_injective_aeval.2 hind
  let : Algebra (MvPolynomial (Fin r) K) L :=
    (aeval (fun i : Fin r ↦ v i.castSucc) :
      MvPolynomial (Fin r) K →ₐ[K] L).toRingHom.toAlgebra
  have : IsScalarTower K (MvPolynomial (Fin r) K) L :=
    IsScalarTower.of_algebraMap_eq fun c ↦ by
      change algebraMap K L c = aeval (fun i : Fin r ↦ v i.castSucc) (C c)
      simp
  have halg : ∀ p : MvPolynomial (Fin r) K,
      algebraMap (MvPolynomial (Fin r) K) L p = aeval (fun i : Fin r ↦ v i.castSucc) p :=
    fun _ ↦ rfl
  have hinj' : Function.Injective (algebraMap (MvPolynomial (Fin r) K) L) := hinj
  have : FaithfulSMul (MvPolynomial (Fin r) K) L :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj'
  have : Module.IsTorsionFree (MvPolynomial (Fin r) K) L :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr hinj'
  -- The primitive element is algebraic over the polynomial ring in the transcendence basis.
  have halgR : IsAlgebraic (MvPolynomial (Fin r) K) (v (Fin.last r)) := by
    obtain ⟨p, hp0, hp⟩ := htr.isAlgebraic.isAlgebraic (v (Fin.last r))
    refine ⟨p.map (hind.aevalEquiv.symm : _ →+* MvPolynomial (Fin r) K), ?_, ?_⟩
    · exact Polynomial.map_ne_zero_iff hind.aevalEquiv.symm.injective |>.mpr hp0
    · rw [Polynomial.aeval_def, Polynomial.eval₂_map, ← hp, Polynomial.aeval_def]
      congr 1
      refine RingHom.ext fun y ↦ ?_
      have h2 := hind.algebraMap_aevalEquiv (hind.aevalEquiv.symm y)
      rw [AlgEquiv.apply_symm_apply] at h2
      exact h2.symm
  -- First rescaling: make the primitive element integral over the polynomial ring.
  obtain ⟨c, hc0, hcint⟩ := halgR.exists_integral_multiple
  -- Second rescaling: clear the denominators of its minimal polynomial.
  have hlifts₀ := IsLocalization.scaleRoots_commonDenom_mem_lifts (A⁰.map (C (σ := Fin r)))
    (minpoly (MvPolynomial (Fin r) K) (c • v (Fin.last r)))
    (by rw [(minpoly.monic hcint).leadingCoeff]; exact one_mem _)
  obtain ⟨a, ha, haC⟩ := Submonoid.mem_map.mp
    (IsLocalization.commonDenom (A⁰.map (C (σ := Fin r)))
      (minpoly (MvPolynomial (Fin r) K) (c • v (Fin.last r))).support
      (minpoly (MvPolynomial (Fin r) K) (c • v (Fin.last r))).coeff).property
  have ha0 : algebraMap A K a ≠ 0 := by
    simpa [IsFractionRing.to_map_eq_zero_iff] using mem_nonZeroDivisors_iff_ne_zero.mp ha
  have hCa0 : (C (algebraMap A K a) : MvPolynomial (Fin r) K) ≠ 0 := by
    simpa using ha0
  rw [← haC, MvPolynomial.algebraMap_def, MvPolynomial.map_C] at hlifts₀
  -- The twice-rescaled primitive element.
  set ca : MvPolynomial (Fin r) K := C (algebraMap A K a) with hca
  set c' : MvPolynomial (Fin r) K := ca * c with hc'
  have hc'0 : c' ≠ 0 := mul_ne_zero hCa0 hc0
  set w : Fin (r + 1) → L := Fin.snoc (fun i : Fin r ↦ v i.castSucc) (c' • v (Fin.last r))
    with hwdef
  have hwc : ∀ i : Fin r, w i.castSucc = v i.castSucc := fun i ↦ by simp [hwdef]
  have hwl : w (Fin.last r) = ca • (c • v (Fin.last r)) := by
    rw [hwdef, Fin.snoc_last, hc', mul_smul]
  have hwint : IsIntegral (MvPolynomial (Fin r) K) (w (Fin.last r)) := by
    rw [hwl]; exact hcint.smul _
  have hwmin : minpoly (MvPolynomial (Fin r) K) (w (Fin.last r)) =
      (minpoly (MvPolynomial (Fin r) K) (c • v (Fin.last r))).scaleRoots ca := by
    rw [hwl]; exact IsIntegrallyClosed.minpoly_smul hCa0 hcint
  -- A monic model of the minimal polynomial over `A[x₁, …, x_r]`.
  have hlifts : minpoly (MvPolynomial (Fin r) K) (w (Fin.last r)) ∈
      Polynomial.lifts (algebraMap (MvPolynomial (Fin r) A) (MvPolynomial (Fin r) K)) := by
    rw [hwmin]; exact hlifts₀
  obtain ⟨PT, hPTmap, -, hPTmonic⟩ :=
    Polynomial.lifts_and_natDegree_eq_and_monic hlifts (minpoly.monic hwint)
  -- Step D(i): transport it to the multivariate polynomial ring.
  have hv : ∀ i : Fin r, algebraMap (MvPolynomial (Fin r) K) L (X i) = w i.castSucc := by
    intro i
    rw [hwc i, halg]
    simp
  have hker := MvPolynomial.ker_aeval_eq_span_finLastEquiv_symm w hv (minpoly.ker_eval hwint)
  set P : MvPolynomial (Fin (r + 1)) A := (finLastEquiv A r).symm PT with hP
  have hPmonic : (finLastEquiv A r P).Monic := by rw [hP, AlgEquiv.apply_symm_apply]; exact hPTmonic
  have hPmap : P.map (algebraMap A K) =
      (finLastEquiv K r).symm (minpoly (MvPolynomial (Fin r) K) (w (Fin.last r))) := by
    refine (finLastEquiv K r).injective ?_
    rw [AlgEquiv.apply_symm_apply, MvPolynomial.map_finLastEquiv, hP, AlgEquiv.apply_symm_apply,
      ← hPTmap, MvPolynomial.algebraMap_def]
  have hker' : RingHom.ker (aeval w : MvPolynomial (Fin (r + 1)) K →ₐ[K] L).toRingHom =
      Ideal.span {P.map (algebraMap A K)} := by rw [hker, hPmap]
  have hQ0 : P.map (algebraMap A K) ≠ 0 := by
    rw [hPmap]
    exact fun h ↦ (minpoly.monic hwint).ne_zero (by
      have := congrArg (finLastEquiv K r) h
      simpa using this)
  -- The new family still generates `L` over `K`.
  have hc'L : algebraMap (MvPolynomial (Fin r) K) L c' ≠ 0 :=
    fun h ↦ hc'0 (hinj' (by rw [h, map_zero]))
  have hadjw : IntermediateField.adjoin K (Set.range w) = ⊤ := by
    refine top_le_iff.mp ?_
    rw [← hadj, IntermediateField.adjoin_le_iff]
    have hmem : ∀ i : Fin r, v i.castSucc ∈ IntermediateField.adjoin K (Set.range w) :=
      fun i ↦ IntermediateField.subset_adjoin K _ ⟨i.castSucc, hwc i⟩
    have hle : Algebra.adjoin K (Set.range (fun i : Fin r ↦ v i.castSucc)) ≤
        (IntermediateField.adjoin K (Set.range w)).toSubalgebra :=
      Algebra.adjoin_le (Set.range_subset_iff.2 hmem)
    have hcmem : algebraMap (MvPolynomial (Fin r) K) L c' ∈
        IntermediateField.adjoin K (Set.range w) := by
      refine hle ?_
      rw [Algebra.adjoin_range_eq_range_aeval, halg]
      exact ⟨c', rfl⟩
    rintro - ⟨i, rfl⟩
    induction i using Fin.lastCases with
    | last =>
      have hdiv : v (Fin.last r) =
          w (Fin.last r) / algebraMap (MvPolynomial (Fin r) K) L c' := by
        rw [hwdef, Fin.snoc_last, Algebra.smul_def, mul_comm, mul_div_assoc, div_self hc'L,
          mul_one]
      rw [hdiv]
      exact div_mem (IntermediateField.subset_adjoin K _ ⟨Fin.last r, rfl⟩) hcmem
    | cast j => exact hmem j
  have key := fun φ hφ ↦ MvPolynomial.irreducible_map_and_isFractionRing_of_ker_eq_span
    (Kbar := Kbar) w hadjw hL hQ0 φ hφ hker'
  refine ⟨r, w, P, hadjw, hPmonic, hker', ?_, fun φ hφ ↦ (key φ hφ).2⟩
  rw [← MvPolynomial.map_map]
  exact (key (Ideal.Quotient.liftₐ _ (aeval w) fun x hx ↦ by
    rw [← hker', RingHom.mem_ker] at hx; exact hx) (Ideal.Quotient.liftₐ_comp _ _ _)).1

end Algebra

end
