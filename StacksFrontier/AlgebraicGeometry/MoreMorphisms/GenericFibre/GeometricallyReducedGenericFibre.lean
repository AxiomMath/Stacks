universe u

private theorem adjoin_pow_eq_top_of_generators
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (p : ℕ) [CharP S p] {s : Set S}
    (hs : ∀ x ∈ s, ∃ n > 0, x ^ p ^ n ∈ (algebraMap R S).range)
    (hgen : Algebra.adjoin R s = ⊤) :
    Algebra.adjoin R {x : S | ∃ n > 0, x ^ p ^ n ∈ (algebraMap R S).range ∧
      p ^ n • x ∈ (algebraMap R S).range} = ⊤ := by
  apply top_unique
  rw [← hgen]
  apply Algebra.adjoin_mono
  intro x hx
  obtain ⟨n, hn, hpow⟩ := hs x hx
  refine ⟨n, hn, hpow, ⟨0, ?_⟩⟩
  simp only [map_zero, nsmul_eq_mul, Nat.cast_pow, CharP.cast_eq_zero S p,
    zero_pow (Nat.ne_of_gt hn), zero_mul]

private theorem finite_adjoin_of_pow_mem_range
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] {s : Set S}
    (hs : s.Finite)
    (hpow : ∀ x ∈ s, ∃ n > 0, x ^ n ∈ (algebraMap R S).range) :
    Module.Finite R (Algebra.adjoin R s) := by
  refine Algebra.finite_adjoin_of_finite_of_isIntegral hs fun x hx => ?_
  obtain ⟨n, hn, r, hr⟩ := hpow x hx
  refine IsIntegral.of_pow hn ?_
  rw [← hr]
  exact isIntegral_algebraMap

private theorem exists_fin_adjoin_eq_top
    {K L : Type*} [Field K] [Field L] [Algebra K L] [Module.Finite K L] :
    ∃ (n : ℕ) (s : Fin n → L), Algebra.adjoin K (Set.range s) = ⊤ := by
  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := K) (M := L)
  have hle : Submodule.span K (Set.range s) ≤
      (Algebra.adjoin K (Set.range s)).toSubmodule :=
    Submodule.span_le.2 fun x hx => Algebra.subset_adjoin hx
  refine ⟨n, s, eq_top_iff.mpr fun x _ => hle ?_⟩
  rw [hs]
  exact Submodule.mem_top

private theorem algebraMap_tower_ne_zero_of_mem_nonZeroDivisors
    {R : Type*} (K : Type*) {L : Type*} [CommRing R] [IsDomain R] [Field K] [Field L]
    [Algebra R K] [Algebra K L] [Algebra R L] [IsScalarTower R K L] [IsFractionRing R K]
    {r : R} (hr : r ∈ nonZeroDivisors R) :
    algebraMap R L r ≠ 0 := by
  rw [IsScalarTower.algebraMap_apply R K L]
  exact (map_ne_zero _).mpr (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hr)

private theorem injective_algebraMap_subalgebra_of_isFractionRing
    {R : Type*} (K : Type*) {L : Type*} [CommRing R] [Field K] [Field L]
    [Algebra R K] [Algebra K L] [Algebra R L] [IsScalarTower R K L] [IsFractionRing R K]
    (S : Subalgebra R L) : Function.Injective (algebraMap R S) := by
  intro x y hxy
  apply IsFractionRing.injective R K
  apply FaithfulSMul.algebraMap_injective K L
  simpa [IsScalarTower.algebraMap_eq R K L] using congrArg (fun q : S => (q : L)) hxy

private theorem preimage_image_opens_eq_of_isHomeomorph {X Y : Scheme.{u}} (f : X ⟶ Y)
    (hf : IsHomeomorph f) (U : X.Opens) :
    f ⁻¹ᵁ ⟨f '' (U : Set X), hf.isOpenMap _ U.2⟩ = U := by
  apply SetLike.coe_injective
  show f ⁻¹' (f '' (U : Set X)) = U
  exact Set.preimage_image_eq _ hf.injective

private theorem isHomeomorph_of_universalHomeomorphism {X Y : Scheme.{u}} (f : X ⟶ Y)
    [UniversalHomeomorphism f] : IsHomeomorph f :=
  UniversalHomeomorphism.universally_isHomeomorph (f := f) _ _ _ IsPullback.of_id_snd

private theorem universalHomeomorphism_of_isPullback {P X Y Z : Scheme.{u}}
    {f' : P ⟶ Y} {g' : P ⟶ X} {g : Y ⟶ Z} {f : X ⟶ Z} (h : IsPullback f' g' g f)
    (hg : UniversalHomeomorphism g) : UniversalHomeomorphism g' :=
  ⟨(MorphismProperty.universally_isStableUnderBaseChange
    (topologically @IsHomeomorph)).of_isPullback h hg.universally_isHomeomorph⟩

private theorem algebraMap_eq_div_of_div_eq
    {R K L : Type*} [CommRing R] [Field K] [Field L]
    [Algebra R K] [Algebra K L] [Algebra R L] [IsScalarTower R K L]
    {a d : R} {c : K} (hfrac : algebraMap R K a / algebraMap R K d = c) :
    algebraMap K L c = algebraMap R L a / algebraMap R L d := by
  rw [← hfrac, map_div₀, IsScalarTower.algebraMap_apply R K L a,
    IsScalarTower.algebraMap_apply R K L d]

private theorem isFinite_specMap_algebraMap (R S : Type u) [CommRing R] [CommRing S]
    [Algebra R S] [Module.Finite R S] :
    IsFinite (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
  rw [IsFinite.SpecMap_iff]
  exact RingHom.finite_algebraMap.mpr inferInstance

private theorem mul_pow_eq_algebraMap_of_div_eq
    {R K L : Type*} [CommRing R] [IsDomain R] [Field K] [Field L]
    [Algebra R K] [Algebra K L] [Algebra R L] [IsScalarTower R K L] [IsFractionRing R K]
    {p m : ℕ} (hp : p.Prime) {a d : R} (hd : d ∈ nonZeroDivisors R) {b : L} {c : K}
    (hc : algebraMap K L c = b ^ p ^ m)
    (hfrac : algebraMap R K a / algebraMap R K d = c ^ p) :
    (algebraMap R L d * b) ^ (p ^ (m + 1)) = algebraMap R L (d ^ (p ^ (m + 1) - 1) * a) := by
  have hN : 1 ≤ p ^ (m + 1) := Nat.one_le_iff_ne_zero.mpr (pow_ne_zero _ hp.ne_zero)
  have hdneL : algebraMap R L d ≠ 0 := algebraMap_tower_ne_zero_of_mem_nonZeroDivisors K hd
  have hcL := algebraMap_eq_div_of_div_eq (L := L) hfrac
  have hcPlus : algebraMap K L (c ^ p) = b ^ (p ^ (m + 1)) := by
    rw [map_pow, hc, ← pow_mul, Nat.pow_succ]
  rw [mul_pow]
  calc
        algebraMap R L d ^ (p ^ (m + 1)) * b ^ (p ^ (m + 1)) =
        algebraMap R L d ^ (p ^ (m + 1)) * algebraMap K L (c ^ p) :=
          congrArg _ hcPlus.symm
    _ = algebraMap R L (d ^ (p ^ (m + 1))) * (algebraMap R L a / algebraMap R L d) := by
      rw [hcL, ← map_pow]
    _ = algebraMap R L (d ^ (p ^ (m + 1) - 1) * a) := by
      have hfield :
          algebraMap R L d ^ (p ^ (m + 1)) * (algebraMap R L a / algebraMap R L d) =
            algebraMap R L d ^ (p ^ (m + 1) - 1) * algebraMap R L a := by
        rw [← Nat.sub_add_cancel hN, pow_succ]
        field_simp [hdneL]
        rw [show p ^ (m + 1) - 1 + 1 - 1 = p ^ (m + 1) - 1 by omega]
        ring
      simpa only [map_mul, map_pow] using hfield

private theorem charP_subalgebra {R L : Type*} [CommRing R] [CommRing L] [Algebra R L]
    (S : Subalgebra R L) (p : ℕ) [CharP L p] : CharP S p := ⟨fun n => by
  constructor
  · intro hn
    apply (CharP.cast_eq_zero_iff L p n).mp
    simpa using congrArg (fun x : S => (x : L)) hn
  · intro hn
    apply Subtype.val_injective
    simpa using (CharP.cast_eq_zero_iff L p n).mpr hn⟩

private theorem exists_finite_adjoin_for_purelyInseparable
    {R K L : Type*} [CommRing R] [IsDomain R] [Field K] [Field L]
    [Algebra R K] [Algebra K L] [Algebra R L] [IsScalarTower R K L]
    [IsFractionRing R K] [Module.Finite K L]
    {p : ℕ} [Fact p.Prime] [CharP K p] [CharP L p]
    (hpi : IsPurelyInseparable K L) :
    ∃ (S : Subalgebra R L), Module.Finite R S ∧
      Algebra.adjoin R {x : S | ∃ n > 0,
        x ^ p ^ n ∈ (algebraMap R S).range ∧ p ^ n • x ∈ (algebraMap R S).range} = ⊤ ∧
      ∃ (n : ℕ) (z : Fin n → L),
        S = Algebra.adjoin R (Set.range z) ∧ Algebra.adjoin K (Set.range z) = ⊤ := by
  classical
  have hp : p.Prime := Fact.out
  have : IsPurelyInseparable K L := hpi
  obtain ⟨n, b, hb⟩ := exists_fin_adjoin_eq_top (K := K) (L := L)
  choose m hm using fun i : Fin n =>
    (IsPurelyInseparable.pow_mem (F := K) (E := L) (q := p) (x := b i))
  choose c hc using fun i : Fin n => hm i
  choose a d hd hfrac using fun i : Fin n => IsFractionRing.div_surjective R (c i ^ p)
  let z : Fin n → L := fun i => algebraMap R L (d i) * b i
  have hdneK (i : Fin n) : algebraMap R K (d i) ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (hd i)
  have hpow (i : Fin n) := mul_pow_eq_algebraMap_of_div_eq hp (hd i) (hc i) (hfrac i)
  let S : Subalgebra R L := Algebra.adjoin R (Set.range z)
  have hfinite : Module.Finite R S := by
    apply finite_adjoin_of_pow_mem_range (Set.finite_range z)
    rintro x ⟨i, rfl⟩
    exact ⟨p ^ (m i + 1), Nat.pow_pos hp.pos,
      ⟨d i ^ (p ^ (m i + 1) - 1) * a i, (hpow i).symm⟩⟩
  let e : Fin n → S := fun i => ⟨z i, Algebra.subset_adjoin ⟨i, rfl⟩⟩
  have hgenS : Algebra.adjoin R (Set.range e) = ⊤ := by
    have hrange : Set.range e = (Subtype.val : S → L) ⁻¹' Set.range z := by
      ext x
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨i, rfl⟩
      · rintro ⟨i, hi⟩
        exact ⟨i, Subtype.ext hi⟩
    rw [hrange]
    exact Algebra.adjoin_adjoin_coe_preimage
  have : CharP S p := charP_subalgebra S p
  have hpowGood : ∀ x ∈ Set.range e, ∃ k > 0, x ^ p ^ k ∈ (algebraMap R S).range := by
    rintro x ⟨i, rfl⟩
    exact ⟨m i + 1, Nat.succ_pos _, d i ^ (p ^ (m i + 1) - 1) * a i, Subtype.ext (hpow i).symm⟩
  have hgenK : Algebra.adjoin K (Set.range z) = ⊤ := by
    rw [eq_top_iff, ← hb]
    refine Algebra.adjoin_le ?_
    rintro y ⟨i, rfl⟩
    have : b i = algebraMap K L ((algebraMap R K (d i))⁻¹) * z i := by
      dsimp [z]
      rw [IsScalarTower.algebraMap_apply R K L (d i), map_inv₀]
      exact (inv_mul_cancel_left₀ ((map_ne_zero _).mpr (hdneK i)) _).symm
    rw [this]
    exact (Algebra.adjoin K (Set.range z)).mul_mem
      ((Algebra.adjoin K (Set.range z)).algebraMap_mem _) (Algebra.subset_adjoin ⟨i, rfl⟩)
  exact ⟨S, hfinite, adjoin_pow_eq_top_of_generators p hpowGood hgenS, n, z, rfl, hgenK⟩

private theorem isFractionRing_subalgebra_of_generators
    {R K L : Type u} [CommRing R] [IsDomain R] [Field K] [Field L]
    [Algebra R K] [Algebra K L] [Algebra R L] [IsScalarTower R K L]
    [IsFractionRing R K] {ι : Type*} (z : ι → L) (S : Subalgebra R L)
    (hz : ∀ i, z i ∈ S) (hgen : Algebra.adjoin K (Set.range z) = ⊤) :
    IsFractionRing S L := by
  classical
  let U : Subalgebra K L := {
    carrier := {x | ∃ r : R, r ≠ 0 ∧ algebraMap R L r * x ∈ S}
    zero_mem' := ⟨1, one_ne_zero, by simp⟩
    one_mem' := ⟨1, one_ne_zero, by simp⟩
    add_mem' := by
      intro x y hx hy
      obtain ⟨r, hr, hxr⟩ := hx
      obtain ⟨s, hs, hys⟩ := hy
      refine ⟨r * s, mul_ne_zero hr hs, ?_⟩
      have hrs : algebraMap R L (r * s) * (x + y) =
          algebraMap R L s * (algebraMap R L r * x) +
            algebraMap R L r * (algebraMap R L s * y) := by
        simp only [map_mul]
        ring
      rw [hrs]
      exact S.add_mem (S.mul_mem (S.algebraMap_mem s) hxr)
        (S.mul_mem (S.algebraMap_mem r) hys)
    mul_mem' := by
      intro x y hx hy
      obtain ⟨r, hr, hxr⟩ := hx
      obtain ⟨s, hs, hys⟩ := hy
      refine ⟨r * s, mul_ne_zero hr hs, ?_⟩
      rw [map_mul]
      convert S.mul_mem hxr hys using 1
      ring
    algebraMap_mem' := by
      intro k
      obtain ⟨a, d, hd, hfrac⟩ := IsFractionRing.div_surjective R k
      refine ⟨d, mem_nonZeroDivisors_iff_ne_zero.mp hd, ?_⟩
      rw [algebraMap_eq_div_of_div_eq hfrac,
        mul_div_cancel₀ _ (algebraMap_tower_ne_zero_of_mem_nonZeroDivisors K hd)]
      exact S.algebraMap_mem a
  }
  have hUgen : Algebra.adjoin K (Set.range z) ≤ U := by
    apply Algebra.adjoin_le
    rintro x ⟨i, rfl⟩
    exact ⟨1, one_ne_zero, by simpa using hz i⟩
  rw [hgen] at hUgen
  have hsurj : ∀ x : L, ∃ a b : S, x = algebraMap S L a / algebraMap S L b := by
    intro x
    have hx : x ∈ U := hUgen (Set.mem_univ x)
    obtain ⟨r, hr, hxr⟩ := hx
    let a : S := ⟨algebraMap R L r * x, hxr⟩
    let b : S := algebraMap R S r
    have hb : (b : L) = algebraMap R L r := rfl
    refine ⟨a, b, ?_⟩
    show x = (a : L) / (b : L)
    rw [hb]
    dsimp [a]
    exact (eq_div_iff (algebraMap_tower_ne_zero_of_mem_nonZeroDivisors K
      (mem_nonZeroDivisors_of_ne_zero hr))).2 (by ring)
  have : FaithfulSMul S L :=
    (faithfulSMul_iff_algebraMap_injective S L).mpr fun _ _ => Subtype.ext
  exact IsFractionRing.of_field S L hsurj

private theorem nilradical_comap_of_isOpenImmersion {X Y : Scheme.{u}}
    (f : X ⟶ Y) [IsOpenImmersion f] :
    Y.nilradical.comap f = X.nilradical := by
  let Q := pullback f Y.nilradical.subschemeι
  let i : Q ⟶ X := pullback.fst f Y.nilradical.subschemeι
  let j : Q ⟶ Y.nilradical.subscheme := pullback.snd f Y.nilradical.subschemeι
  have hpb : IsPullback i j f Y.nilradical.subschemeι := IsPullback.of_hasPullback f _
  have : IsReduced Y.nilradical.subscheme := isReduced_nilradical_subscheme Y
  have : IsOpenImmersion j := MorphismProperty.of_isPullback hpb (inferInstance : IsOpenImmersion f)
  have : IsReduced Q := isReduced_of_isOpenImmersion j
  have hsupp : i.ker.support = ⊤ := by
    apply SetLike.coe_injective
    rw [Scheme.Hom.support_ker, Scheme.Pullback.range_fst, Scheme.IdealSheafData.range_subschemeι,
      Scheme.support_nilradical]
    simp
  show i.ker = X.nilradical
  exact ker_eq_nilradical_of_support_eq_top i hsupp

private theorem isPurelyInseparable_residueFieldMap_specMap
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
    (h : ∀ (𝔭 : Ideal R) [𝔭.IsPrime] (𝔮 : Ideal S) [𝔮.IsPrime]
      (h : 𝔭 = 𝔮.comap (algebraMap R S)),
        (Ideal.ResidueField.map 𝔭 𝔮 (algebraMap R S) h).IsPurelyInseparable)
    (z : Spec (CommRingCat.of S)) :
    RingHom.IsPurelyInseparable
      ((Spec.map (CommRingCat.ofHom (algebraMap R S))).residueFieldMap z).hom := by
  set f := CommRingCat.ofHom (algebraMap R S)
  let pSpec := Spec.map f z
  let p₀ := pSpec.asIdeal
  let q₀ : Ideal S := (show PrimeSpectrum S from z).asIdeal
  have : p₀.IsPrime := pSpec.isPrime
  have : q₀.IsPrime := z.isPrime
  have hpq : p₀ = q₀.comap f.hom := by
    simpa [p₀, q₀, pSpec, Spec.map_apply] using
      (PrimeSpectrum.comap_asIdeal f.hom z)
  let idealMap := Ideal.ResidueField.map p₀ q₀ f.hom hpq
  have hIdealPure : idealMap.IsPurelyInseparable :=
    h p₀ q₀ (show p₀ = q₀.comap (algebraMap R S) by simpa [f] using hpq)
  let ePiso := Scheme.Spec.residueFieldIso (CommRingCat.of R) pSpec
  let eQiso := Scheme.Spec.residueFieldIso (CommRingCat.of S) z
  let eP := ePiso.commRingCatIsoToRingEquiv
  let eQ := eQiso.commRingCatIsoToRingEquiv
  have hP : eP.symm.toRingHom = ePiso.inv.hom := rfl
  have hQ : eQ.toRingHom = eQiso.hom.hom := rfl
  have hbridge := specResidueFieldMap_bridge f z
  have hbridge' : eQ.toRingHom.comp
      (((Spec.map f).residueFieldMap z).hom.comp eP.symm.toRingHom) = idealMap := by
    rw [← RingHom.comp_assoc, hQ, hP]
    have hcompOuter := CommRingCat.hom_comp
      (Scheme.Spec.residueFieldIso (CommRingCat.of R)
        (Spec.map f z)).inv
      ((Spec.map f).residueFieldMap z ≫
        (Scheme.Spec.residueFieldIso (CommRingCat.of S) z).hom)
    have hcompQ := CommRingCat.hom_comp ((Spec.map f).residueFieldMap z)
      (Scheme.Spec.residueFieldIso (CommRingCat.of S) z).hom
    rw [hcompOuter, hcompQ] at hbridge
    simpa [ePiso, eQiso, eP, eQ, pSpec, p₀, q₀, idealMap, Spec.map_apply,
      CommRingCat.hom_ofHom] using hbridge
  have htransport :
      (eQ.symm.toRingHom.comp (idealMap.comp eP.toRingHom)).IsPurelyInseparable := by
    simpa [p₀] using RingHom.isPurelyInseparable_congr eP eQ idealMap hIdealPure
  have hmap : ((Spec.map f).residueFieldMap z).hom =
      eQ.symm.toRingHom.comp (idealMap.comp eP.toRingHom) := by
    ext a
    apply eQ.injective
    have heval := congrArg (fun g => g (eP a)) hbridge'
    have heval' : eQ.toRingHom (((Spec.map f).residueFieldMap z).hom a) = idealMap (eP a) := by
      simpa only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingEquiv.coe_toRingHom, RingEquiv.symm_apply_apply] using heval
    show eQ.toRingHom (((Spec.map f).residueFieldMap z).hom a) =
      eQ.toRingHom (eQ.symm.toRingHom (idealMap (eP.toRingHom a)))
    exact heval'.trans (eQ.apply_symm_apply (idealMap (eP a))).symm
  rwa [hmap]

open _root_.PrimeSpectrum in
private theorem finite_universalHomeomorphism_specMap_of_adjoin_powNsmul
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
    [Module.Finite R S]
    (p : ℕ) (hp : p.Prime)
    (hker : RingHom.ker (algebraMap R S) ≤ nilradical R)
    (hgen : Algebra.adjoin R {x : S | ∃ n > 0,
      x ^ p ^ n ∈ (algebraMap R S).range ∧ p ^ n • x ∈ (algebraMap R S).range} = ⊤) :
    IsFinite (Spec.map (CommRingCat.ofHom (algebraMap R S))) ∧
      UniversalHomeomorphism (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
  classical
  let f := CommRingCat.ofHom (algebraMap R S)
  have hdata :=
    @isHomeomorph_comap_and_isPurelyInseparable_and_baseChange_of_adjoin_pow_eq_top.{u, u, u, u}
      R S _ _ _ p hp hker hgen
  have hfint : IsIntegralHom (Spec.map f) :=
    IsIntegralHom.SpecMap_iff.mpr (algebraMap_isIntegral_iff.mpr inferInstance)
  have hfinj : Function.Injective (Spec.map f) := by
    intro z w hzw
    change PrimeSpectrum.comap (algebraMap R S) z =
      PrimeSpectrum.comap (algebraMap R S) w at hzw
    exact hdata.1.bijective.injective hzw
  have hfui : UniversallyInjective (Spec.map f) := by
    apply ((tfae_universallyInjective (Spec.map f)).out 1 3).mpr
    exact ⟨hfinj, isPurelyInseparable_residueFieldMap_specMap fun 𝔭 _ 𝔮 _ h =>
      (hdata.2.1 𝔭 𝔮 h).elim (RingHom.isPurelyInseparable_of_surjective _) And.right⟩
  have hfsurj : Surjective (Spec.map f) := ⟨hdata.1.bijective.2⟩
  exact ⟨isFinite_specMap_algebraMap R S,
    (universalHomeomorphism_iff_integral_universallyInjective_surjective
      (Spec.map f)).mpr ⟨hfint, hfui, hfsurj⟩⟩

private theorem exists_finite_universalHomeomorphic_spec_extension
    {R K L : Type u} [CommRing R] [IsDomain R] [Field K] [Field L]
    [Algebra R K] [Algebra K L] [Algebra R L] [IsScalarTower R K L]
    [IsFractionRing R K] [Module.Finite K L]
    (hpi : IsPurelyInseparable K L) :
    ∃ (S : Subalgebra R L) (n : ℕ) (z : Fin n → L),
      Module.Finite R S ∧
      UniversalHomeomorphism
        (Spec.map (CommRingCat.ofHom (algebraMap R S))) ∧
      S = Algebra.adjoin R (Set.range z) ∧ Algebra.adjoin K (Set.range z) = ⊤ := by
  classical
  by_cases hchar : ringChar K = 0
  · have : CharZero K := (CharP.ringChar_zero_iff_CharZero (R := K)).mp hchar
    have : IsPurelyInseparable K L := hpi
    have : PerfectField K := PerfectField.ofCharZero
    have : Algebra.IsAlgebraic K L := IsPurelyInseparable.isAlgebraic K L
    have : Algebra.IsSeparable K L := inferInstance
    have hsurjKL := IsPurelyInseparable.surjective_algebraMap_of_isSeparable K L
    let S : Subalgebra R L := ⊥
    let z : Fin 0 → L := Fin.elim0
    have hsurj : Function.Surjective (algebraMap R S) := by
      intro x
      have hx : (x : L) ∈ (⊥ : Subalgebra R L) := x.2
      change (x : L) ∈ Set.range (algebraMap R L) at hx
      obtain ⟨r, hr⟩ := hx
      exact ⟨r, Subtype.ext hr⟩
    have : IsIso (CommRingCat.ofHom (algebraMap R S)) :=
      (ConcreteCategory.isIso_iff_bijective _).2
        ⟨injective_algebraMap_subalgebra_of_isFractionRing K S, hsurj⟩
    let f := Spec.map (CommRingCat.ofHom (algebraMap R S))
    have : IsIso f :=
      (Scheme.Spec.mapIso (asIso (CommRingCat.ofHom (algebraMap R S))).op).isIso_hom
    have hgenK : Algebra.adjoin K (Set.range z) = ⊤ := by
      refine eq_top_iff.mpr fun x _ => ?_
      obtain ⟨k, rfl⟩ := hsurjKL x
      exact (Algebra.adjoin K (Set.range z)).algebraMap_mem k
    exact ⟨S, 0, z, inferInstance, universalHomeomorphism_of_isIso f,
      by simp [S], hgenK⟩
  · let p : ℕ := ringChar K
    have hp : p.Prime := by
      dsimp [p]
      exact (CharP.char_is_prime_or_zero K _).resolve_right hchar
    have : Fact p.Prime := ⟨hp⟩
    have : CharP K p := by simpa [p] using (ringChar.charP K)
    have : CharP L p := charP_of_injective_algebraMap (algebraMap K L).injective p
    obtain ⟨S, hfinite, htop, n, z, hS, hgenK⟩ :=
      exists_finite_adjoin_for_purelyInseparable (R := R) (K := K) (L := L) hpi
    have hker : RingHom.ker (algebraMap R S) ≤ nilradical R := by
      rw [(RingHom.injective_iff_ker_eq_bot (algebraMap R S)).mp
        (injective_algebraMap_subalgebra_of_isFractionRing K S)]
      exact bot_le
    exact ⟨S, n, z, hfinite,
      (finite_universalHomeomorphism_specMap_of_adjoin_powNsmul
        (R := R) (S := S) p hp hker htop).2, hS, hgenK⟩

private theorem exists_finite_affine_extension_geometricallyReduced
    {R K : Type u} [CommRing R] [IsDomain R] [Field K] [Algebra R K]
    [IsFractionRing R K] {X : Scheme.{u}} (f : X ⟶ Spec (.of K))
    [LocallyOfFiniteType f] (hX : (irreducibleComponents X).Finite) :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L) (_ : Module.Finite K L)
      (_ : IsPurelyInseparable K L) (_ : Algebra R L)
      (_ : IsScalarTower R K L) (S : Subalgebra R L),
      Module.Finite R S ∧ IsFractionRing S L ∧
      IsFinite (Spec.map (CommRingCat.ofHom (algebraMap R S))) ∧
      UniversalHomeomorphism
        (Spec.map (CommRingCat.ofHom (algebraMap R S))) ∧
      let g : Spec (.of L) ⟶ Spec (.of K) :=
        Spec.map (CommRingCat.ofHom (algebraMap K L))
      let p : pullback f g ⟶ Spec (.of L) := pullback.snd f g
      let I := Scheme.IdealSheafData.vanishingIdeal
        (X := (pullback f g : Scheme.{u})) (⊤ : Closeds (pullback f g : Scheme.{u}))
      GeometricallyReduced (I.subschemeι ≫ p) := by
  obtain ⟨L, hL, hKL, hfinKL, hpi, hgeo⟩ :=
    exists_finite_purelyInseparable_extension_geometricallyReduced_reduction K f hX
  let : Field L := hL
  let : Algebra K L := hKL
  have : Module.Finite K L := hfinKL
  have : IsPurelyInseparable K L := hpi
  let : Algebra R L := (algebraMap K L).comp (algebraMap R K) |>.toAlgebra
  have : IsScalarTower R K L := IsScalarTower.of_algebraMap_eq' (by ext x; rfl)
  obtain ⟨S, n, z, hfinite, hUH, hS, hgenK⟩ :=
    exists_finite_universalHomeomorphic_spec_extension (R := R) (K := K) (L := L) hpi
  have hz : ∀ i : Fin n, z i ∈ S := fun i => hS ▸ Algebra.subset_adjoin ⟨i, rfl⟩
  exact ⟨L, hL, hKL, hfinKL, hpi, inferInstance, inferInstance,
    S, hfinite, isFractionRing_subalgebra_of_generators z S hz hgenK,
    isFinite_specMap_algebraMap R S, hUH, hgeo⟩

private theorem geometricallyReduced_of_arrowIso {X Y : Scheme.{u}}
    (f : X ⟶ Y) {X' Y' : Scheme.{u}} (f' : X' ⟶ Y')
    (e : Arrow.mk f ≅ Arrow.mk f') (hf : GeometricallyReduced f) :
    GeometricallyReduced f' := by
  have : MorphismProperty.RespectsIso (@GeometricallyReduced : MorphismProperty Scheme.{u}) := by
    rw [GeometricallyReduced.eq_geometrically]
    infer_instance
  exact (MorphismProperty.arrow_mk_iso_iff
    (P := @GeometricallyReduced) e).mp hf

private theorem subschemeι_eqToIso {X : Scheme.{u}} (I J : X.IdealSheafData) (h : I = J) :
    (eqToIso (congrArg Scheme.IdealSheafData.subscheme h)).hom ≫ J.subschemeι =
      I.subschemeι := by
  subst J
  simp

private theorem geometricallyReduced_reduction_of_iso
    {X Y X' Y' : Scheme.{u}} (f : X ⟶ Y) (f' : X' ⟶ Y')
    (e : X ≅ X') (eY : Y ≅ Y') (he : e.hom ≫ f' = f ≫ eY.hom)
    (hf : GeometricallyReduced (X.nilradical.subschemeι ≫ f)) :
    GeometricallyReduced (X'.nilradical.subschemeι ≫ f') := by
  have h : (reductionIso e).hom ≫ (X'.nilradical.subschemeι ≫ f') =
      (X.nilradical.subschemeι ≫ f) ≫ eY.hom := by
    rw [← Category.assoc, reductionIso_hom_comp_subschemeι]
    simp only [Category.assoc, he]
  exact geometricallyReduced_of_arrowIso _ _ (Arrow.isoMk (reductionIso e) eY h) hf

/-- The reduction of `X` is the pullback of the reduction of `Y` along an open immersion. -/
private noncomputable def nilradicalSubschemeIsoPullback {X Y : Scheme.{u}} (h : X ⟶ Y)
    (hnil : Y.nilradical.comap h = X.nilradical) :
    X.nilradical.subscheme ≅ pullback h Y.nilradical.subschemeι :=
  (eqToIso (congrArg Scheme.IdealSheafData.subscheme hnil)).symm ≪≫ Y.nilradical.comapIso h

private theorem nilradicalSubschemeIsoPullback_hom_fst {X Y : Scheme.{u}} (h : X ⟶ Y)
    (hnil : Y.nilradical.comap h = X.nilradical) :
    (nilradicalSubschemeIsoPullback h hnil).hom ≫ pullback.fst h Y.nilradical.subschemeι =
      X.nilradical.subschemeι := by
  simpa [nilradicalSubschemeIsoPullback] using subschemeι_eqToIso _ _ hnil.symm

private theorem geometricallyReduced_reduction_baseChange
    {X Y T : Scheme.{u}} (f : X ⟶ Y) (q : T ⟶ Y)
    (hnil : X.nilradical.comap (pullback.fst f q) = (pullback f q).nilradical)
    (hf : GeometricallyReduced ((pullback f q).nilradical.subschemeι ≫
      pullback.snd f q)) :
    GeometricallyReduced (pullback.snd (X.nilradical.subschemeι ≫ f) q) := by
  let r := X.nilradical.subschemeι
  let eRed : (pullback f q).nilradical.subscheme ≅ pullback (pullback.fst f q) r :=
    nilradicalSubschemeIsoPullback _ hnil
  have hred : eRed.hom ≫ pullback.fst (pullback.fst f q) r =
      (pullback f q).nilradical.subschemeι :=
    nilradicalSubschemeIsoPullback_hom_fst _ hnil
  let e := eRed ≪≫ pullbackSymmetry _ _ ≪≫ pullbackRightPullbackFstIso f q r
  have he : e.hom ≫ pullback.snd (r ≫ f) q =
      (pullback f q).nilradical.subschemeι ≫ pullback.snd f q := by
    simp only [e, Iso.trans_hom, Category.assoc, pullbackRightPullbackFstIso_hom_snd,
      pullbackSymmetry_hom_comp_snd_assoc]
    rw [← Category.assoc, hred]
  exact geometricallyReduced_of_arrowIso _ _
    (Arrow.isoMk e (Iso.refl T) (he.trans (Category.comp_id _).symm)) hf

private theorem exists_spec_fractionRing_iso
    (R L : Type u) [CommRing R] [IsDomain R] [Field L]
    [Algebra R L] [IsFractionRing R L] :
    ∃ e : Spec ((Spec (.of R)).residueField (genericPoint (Spec (.of R)))) ≅ Spec (.of L),
      e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap R L)) =
        (Spec (.of R)).fromSpecResidueField (genericPoint (Spec (.of R))) := by
  let η : Spec (.of R) := (⊥ : PrimeSpectrum R)
  have : IsFractionRing R η.asIdeal.ResidueField := by
    simpa [η] using (inferInstance : IsFractionRing R (⊥ : Ideal R).ResidueField)
  let a : L ≃+* η.asIdeal.ResidueField :=
    IsFractionRing.ringEquivOfRingEquiv (RingEquiv.refl R)
  let e := Scheme.Spec.mapIso
    (a.toCommRingCatIso ≪≫ (Scheme.Spec.residueFieldIso (.of R) η).symm).op
  have he : e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap R L)) =
      (Spec (.of R)).fromSpecResidueField η := by
    show Spec.map (CommRingCat.ofHom a.toRingHom ≫
      (Scheme.Spec.residueFieldIso (.of R) η).inv) ≫ _ = _
    rw [Spec.map_comp, Category.assoc, ← Spec.map_comp]
    have ha : CommRingCat.ofHom (algebraMap R L) ≫ CommRingCat.ofHom a.toRingHom =
        CommRingCat.ofHom (algebraMap R η.asIdeal.ResidueField) := by
      ext x
      exact IsFractionRing.ringEquivOfRingEquiv_algebraMap (RingEquiv.refl R) x
    rw [ha, Scheme.Spec.map_residueFieldIso_inv_eq_fromSpecResidueField]
  rw [genericPoint_eq_bot_of_affine]
  exact ⟨e, he⟩

private theorem geometricallyReduced_genericFiber_of_fractionRing
    {X : Scheme.{u}} (R L : Type u) [CommRing R] [IsDomain R] [Field L]
    [Algebra R L] [IsFractionRing R L] (f : X ⟶ Spec (.of R))
    (hf : GeometricallyReduced
      ((pullback f (Spec.map (CommRingCat.ofHom (algebraMap R L)))).nilradical.subschemeι ≫
        pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap R L))))) :
    ∀ η, IsGenericPoint η Set.univ →
      GeometricallyReduced ((X.nilradical.subschemeι ≫ f).fiberToSpecResidueField η) := by
  intro η hη
  have hηeq : η = genericPoint (Spec (.of R)) := hη.eq (genericPoint_spec _)
  subst η
  obtain ⟨e, he⟩ := exists_spec_fractionRing_iso R L
  let q := Spec.map (CommRingCat.ofHom (algebraMap R L))
  let η := genericPoint (Spec (.of R))
  let t := (Spec (.of R)).fromSpecResidueField η
  let m := pullback.map f t f q (𝟙 X) e.hom (𝟙 _) (by simp) (by simpa using he.symm)
  have : IsIso m := by
    dsimp [m]
    apply pullback.map_isIso
  have hm : m ≫ pullback.snd f q = pullback.snd f t ≫ e.hom := by
    dsimp [m]
    simp only [pullback.map, pullback.lift_snd]
  have hg := geometricallyReduced_reduction_of_iso (pullback.snd f q)
    (pullback.snd f t) (asIso m).symm e.symm (by
      apply (cancel_mono e.hom).mp
      simp only [Category.assoc]
      rw [← hm]
      simp) hf
  apply geometricallyReduced_reduction_baseChange f t _ hg
  exact comap_nilradical_fiberι f η
    (by
      show closure {η} ∈ irreducibleComponents _
      rw [show closure {η} = Set.univ from genericPoint_spec _]
      exact ⟨IrreducibleSpace.isIrreducible_univ _, fun _ _ _ => Set.subset_univ _⟩)

private theorem exists_opens_universalHomeomorphism_restrict {Y₀ Y : Scheme.{u}} (r : Y₀ ⟶ Y)
    [UniversalHomeomorphism r] [IsFinite r] (U : Y₀.Opens) [Nonempty U] :
    ∃ (V : Y.Opens) (t : U.toScheme ⟶ V.toScheme), (V : Set Y).Nonempty ∧ IsFinite t ∧
      UniversalHomeomorphism t ∧ t ≫ V.ι = U.ι ≫ r := by
  have hr := isHomeomorph_of_universalHomeomorphism r
  let V : Y.Opens := ⟨r '' (U : Set Y₀), hr.isOpenMap _ U.2⟩
  have hpre : r ⁻¹ᵁ V = U := preimage_image_opens_eq_of_isHomeomorph r hr U
  obtain ⟨x, hx⟩ := ‹Nonempty U›
  refine ⟨V, (Y₀.isoOfEq hpre).inv ≫ r ∣_ V, ⟨r x, x, hx, rfl⟩, inferInstance,
    universalHomeomorphism_comp _ _ (universalHomeomorphism_of_isIso _)
      (universalHomeomorphism_of_isPullback (isPullback_morphismRestrict r V).flip inferInstance),
    ?_⟩
  rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, Y₀.isoOfEq_inv_ι hpre]

private theorem geometricallyReduced_genericFiber_of_isPullback_spec
    {X Y XA : Scheme.{u}} {A K L : Type u} [CommRing A] [Field K] [Field L]
    [Algebra A K] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (S : Subalgebra A L) [IsFractionRing S L]
    {f : X ⟶ Y} {k : Spec (.of A) ⟶ Y} {fA : XA ⟶ Spec (.of A)} {xU : XA ⟶ X}
    (hA : IsPullback fA xU k f) {G : Spec (.of S) ⟶ Y}
    (hG : G = Spec.map (CommRingCat.ofHom (algebraMap A S)) ≫ k)
    (hgeo : GeometricallyReduced
      ((pullback (pullback.snd fA (Spec.map (CommRingCat.ofHom (algebraMap A K))))
        (Spec.map (CommRingCat.ofHom (algebraMap K L)))).nilradical.subschemeι ≫
        pullback.snd (pullback.snd fA (Spec.map (CommRingCat.ofHom (algebraMap A K))))
          (Spec.map (CommRingCat.ofHom (algebraMap K L))))) :
    ∀ η : Spec (.of S), IsGenericPoint η Set.univ →
      GeometricallyReduced
        (((pullback G f).nilradical.subschemeι ≫ pullback.fst G f).fiberToSpecResidueField η) := by
  let q := Spec.map (CommRingCat.ofHom (algebraMap A K))
  let q' := Spec.map (CommRingCat.ofHom (algebraMap K L))
  let p := pullback.snd fA q
  let p' : pullback p q' ⟶ Spec (.of L) := pullback.snd p q'
  have hK : IsPullback p (pullback.fst fA q ≫ xU) (q ≫ k) f :=
    (IsPullback.of_hasPullback fA q).flip.paste_vert hA
  have hLpb : IsPullback p' (pullback.fst p q' ≫ pullback.fst fA q ≫ xU)
      (q' ≫ q ≫ k) f := by
    simpa only [Category.assoc] using
      (IsPullback.of_hasPullback p q').flip.paste_vert hK
  let v := Spec.map (CommRingCat.ofHom (algebraMap S L))
  have hv : v ≫ G = q' ≫ q ≫ k := by
    rw [hG]
    dsimp [v, q', q]
    simp only [← Category.assoc, ← Spec.map_comp]
    congr 1
    congr 1
    ext a
    exact (IsScalarTower.algebraMap_apply A S L a).symm.trans
      (IsScalarTower.algebraMap_apply A K L a)
  let fP : pullback G f ⟶ Spec (.of S) := pullback.fst G f
  have hQ : IsPullback (pullback.snd fP v)
      (pullback.fst fP v ≫ pullback.snd G f) (q' ≫ q ≫ k) f := by
    rw [← hv]
    exact (IsPullback.of_hasPullback fP v).flip.paste_vert (IsPullback.of_hasPullback G f)
  let e := hLpb.isoPullback ≪≫ hQ.isoPullback.symm
  have he : e.hom ≫ pullback.snd fP v = p' := by
    simp only [e, Iso.trans_hom, Iso.symm_hom, Category.assoc,
      hQ.isoPullback_inv_fst, hLpb.isoPullback_hom_fst]
  exact geometricallyReduced_genericFiber_of_fractionRing S L fP
    (geometricallyReduced_reduction_of_iso p' (pullback.snd fP v) e (Iso.refl _)
      (by simpa using he) hgeo)

private theorem exists_finite_universalHomeomorphism_from_affine_field_extension
    {X Y₀ Y : Scheme.{u}} (r : Y₀ ⟶ Y)
    [UniversalHomeomorphism r] [IsFinite r] [IsIntegral Y₀]
    (f : X ⟶ Y) [LocallyOfFiniteType f] [QuasiCompact f]
    (U : Y₀.Opens) (hU : IsAffineOpen U) [Nonempty U] :
    ∃ (V : Y.Opens) (_ : (V : Set Y).Nonempty)
      (Y' : Scheme.{u}) (g : Y' ⟶ V.toScheme)
      (_ : IsFinite g) (_ : UniversalHomeomorphism g)
      (_ : IsIntegral Y') (_ : IsAffine Y'),
      let P := pullback (g ≫ V.ι) f
      let f' := P.nilradical.subschemeι ≫ pullback.fst (g ≫ V.ι) f
      ∀ η : Y', IsGenericPoint η Set.univ →
        GeometricallyReduced (f'.fiberToSpecResidueField η) := by
  classical
  let A := Γ(Y₀, U)
  let K := Y₀.functionField
  have : IsFractionRing A K := functionField_isFractionRing_of_isAffineOpen Y₀ U hU
  let f₀ := pullback.fst r f
  let fU := f₀ ∣_ U
  let fA : (f₀ ⁻¹ᵁ U).toScheme ⟶ Spec (.of A) := fU ≫ hU.isoSpec.hom
  let q : Spec (.of K) ⟶ Spec (.of A) :=
    Spec.map (CommRingCat.ofHom (algebraMap A K))
  let XK : Scheme.{u} := Limits.pullback fA q
  let p : XK ⟶ Spec (.of K) := Limits.pullback.snd fA q
  have : IsLocallyNoetherian XK := LocallyOfFiniteType.isLocallyNoetherian p
  have : IsNoetherian XK := AlgebraicGeometry.IsNoetherian.mk
  obtain ⟨L, hL, hKL, hfinKL, hpi, hRL, hRKL,
      S, hfinite, hfrac, hSpecFinite, hSpecUH, hgeo⟩ :=
    exists_finite_affine_extension_geometricallyReduced (R := A) (K := K) p
      finite_irreducibleComponents_of_isNoetherian
  let : Field L := hL
  let : Algebra K L := hKL
  let : Algebra A L := hRL
  have : IsScalarTower A K L := hRKL
  have : IsFractionRing S L := hfrac
  obtain ⟨V, t, hVne, htfin, htUH, ht⟩ := exists_opens_universalHomeomorphism_restrict r U
  let g : Spec (.of S) ⟶ V.toScheme :=
    Spec.map (CommRingCat.ofHom (algebraMap A S)) ≫ hU.isoSpec.inv ≫ t
  refine ⟨V, hVne, Spec (.of S), g, inferInstance,
    universalHomeomorphism_comp _ _ hSpecUH
      (universalHomeomorphism_comp _ _ (universalHomeomorphism_of_isIso _) htUH),
    inferInstance, inferInstance, ?_⟩
  let k : Spec (.of A) ⟶ Y := hU.isoSpec.inv ≫ U.ι ≫ r
  let xU : (f₀ ⁻¹ᵁ U).toScheme ⟶ X := (f₀ ⁻¹ᵁ U).ι ≫ pullback.snd r f
  have hA : IsPullback fA xU k f :=
    ((isPullback_morphismRestrict f₀ U).paste_vert (IsPullback.of_hasPullback r f)).of_iso
      (Iso.refl _) hU.isoSpec (Iso.refl _) (Iso.refl _)
      (by simp [fA, fU]) (by simp [xU]) (by simp [k]) (by simp)
  have hg : g ≫ V.ι = Spec.map (CommRingCat.ofHom (algebraMap A S)) ≫ k := by
    simp only [g, k, Category.assoc, ht]
  change GeometricallyReduced ((Scheme.IdealSheafData.vanishingIdeal (⊤ : Closeds
    (pullback p (Spec.map (CommRingCat.ofHom (algebraMap K L))) : Scheme))).subschemeι ≫
      pullback.snd p (Spec.map (CommRingCat.ofHom (algebraMap K L)))) at hgeo
  rw [Scheme.IdealSheafData.vanishingIdeal_top] at hgeo
  exact geometricallyReduced_genericFiber_of_isPullback_spec S hA hg hgeo

private theorem exists_dense_open_flat_finitePresentation_of_reduced
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsReduced Y]
    [LocallyOfFiniteType f] [QuasiCompact f] :
    ∃ U : Y.Opens,
      Dense (U : Set Y) ∧
      Flat (f.resLE U (f ⁻¹ᵁ U) le_rfl) ∧
      AlgebraicGeometry.FinitePresentation (f.resLE U (f ⁻¹ᵁ U) le_rfl) := by
  let F : X.Modules := SheafOfModules.unit X.ringCatSheaf
  have : F.IsQuasicoherent := Stacks.AlgebraicGeometry.AffineQcohPushforward.isQuasicoherent_unit X
  have : F.IsFiniteType := structureSheaf_isFiniteType X
  obtain ⟨U, hU, hflat, hfp, -, -⟩ :=
    exists_dense_open_flat_finitePresentation f F
  exact ⟨U, hU, hflat, hfp⟩

private theorem exists_affine_basic_open_le_dense
    {Y : Scheme.{u}} [IsAffine Y] [IrreducibleSpace Y]
    (W : Y.Opens) (hW : Dense (W : Set Y)) :
    ∃ U : Y.Opens, IsAffineOpen U ∧ (U : Set Y).Nonempty ∧ U ≤ W := by
  let η : Y := genericPoint Y
  have hη : IsGenericPoint η Set.univ := genericPoint_spec Y
  have hηW : η ∈ W := by
    apply (hη.mem_open_set_iff W.2).2
    obtain ⟨y, hy⟩ := hW.nonempty
    exact ⟨y, Set.mem_univ y, hy⟩
  obtain ⟨s, hsW, hηs⟩ :=
    (isAffineOpen_top Y).exists_basicOpen_le (V := W) ⟨η, hηW⟩ (by trivial)
  exact ⟨Y.basicOpen s, (isAffineOpen_top Y).basicOpen s, ⟨η, hηs⟩, hsW⟩

private noncomputable def reduced_openPullback_arrowIso
    {X Y Z U : Scheme.{u}} (f : X ⟶ Z) (q : Y ⟶ Z) (j : U ⟶ Y)
    (q₂ : U ⟶ Z) (hq : q₂ = j ≫ q) [IsOpenImmersion j] :
    let P₀ := pullback q f
    let p₀ : P₀ ⟶ Y := pullback.fst q f
    let red₀ : P₀.nilradical.subscheme ⟶ P₀ := P₀.nilradical.subschemeι
    let f₀' := red₀ ≫ p₀
    let P₂ := pullback q₂ f
    let r₂ : P₂.nilradical.subscheme ⟶ P₂ := P₂.nilradical.subschemeι
    let f₂' := r₂ ≫ pullback.fst q₂ f
    Arrow.mk f₂' ≅ Arrow.mk (pullback.fst j f₀') := by
  classical
  intro P₀ p₀ red₀ f₀' P₂ r₂ f₂'
  let ePull : pullback j p₀ ≅ P₂ :=
    pullbackRightPullbackFstIso q f j ≪≫ pullback.congrHom hq.symm rfl
  let h : P₂ ⟶ P₀ := ePull.inv ≫ pullback.snd j p₀
  have : IsOpenImmersion h := by
    dsimp [h]
    infer_instance
  have hnil : P₀.nilradical.comap h = P₂.nilradical :=
    nilradical_comap_of_isOpenImmersion h
  let eRed := nilradicalSubschemeIsoPullback h hnil
  let eHmap := pullback.map h red₀ (pullback.snd j p₀) red₀ ePull.inv
    (𝟙 _) (𝟙 _) (by simp [h]) (by simp)
  have : IsIso eHmap := by
    dsimp [eHmap]
    apply pullback.map_isIso
  let eH := asIso eHmap
  let eAssocRed := pullbackLeftPullbackSndIso j p₀ red₀
  let eTotal := eRed ≪≫ eH ≪≫ eAssocRed
  have hePullfst : ePull.inv ≫ pullback.fst j p₀ = pullback.fst q₂ f := by
    dsimp [ePull]
    simp only [Category.assoc]
    rw [pullbackRightPullbackFstIso_inv_fst]
    simp only [pullback.congrHom_inv, pullback.map, pullback.lift_fst, Category.comp_id]
  have heRedfst : eRed.hom ≫ pullback.fst h red₀ = r₂ :=
    nilradicalSubschemeIsoPullback_hom_fst h hnil
  have heHfst : eH.hom ≫ pullback.fst (pullback.snd j p₀) red₀ =
      pullback.fst h red₀ ≫ ePull.inv := by
    dsimp [eH, eHmap]
    simp only [pullback.map, pullback.lift_fst]
  have heTotalBase : eTotal.hom ≫ pullback.fst j f₀' = f₂' := by
    calc
      eTotal.hom ≫ pullback.fst j f₀' =
          eRed.hom ≫ eH.hom ≫ eAssocRed.hom ≫ pullback.fst j f₀' := by
            simp [eTotal]
      _ = eRed.hom ≫ eH.hom ≫
          (pullback.fst (pullback.snd j p₀) red₀ ≫ pullback.fst j p₀) := by
            rw [pullbackLeftPullbackSndIso_hom_fst]
      _ = eRed.hom ≫ (pullback.fst h red₀ ≫ ePull.inv) ≫ pullback.fst j p₀ := by
            simp only [← Category.assoc, heHfst]
      _ = r₂ ≫ ePull.inv ≫ pullback.fst j p₀ := by
            simp only [← Category.assoc, heRedfst]
      _ = r₂ ≫ pullback.fst q₂ f := by rw [hePullfst]
      _ = f₂' := rfl
  exact Arrow.isoMk eTotal (Iso.refl _) heTotalBase

private theorem exists_finite_universalHomeomorphism_geometricallyReduced_of_irreducible
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IrreducibleSpace Y]
    [LocallyOfFiniteType f] [QuasiCompact f] :
    ∃ (V : Y.Opens) (_ : (V : Set Y).Nonempty)
      (Y' : Scheme.{u}) (g : Y' ⟶ V.toScheme)
      (_ : IsFinite g) (_ : UniversalHomeomorphism g)
      (_ : IsIntegral Y') (_ : IsAffine Y'),
      let P := pullback (g ≫ V.ι) f
      let f' := P.nilradical.subschemeι ≫ pullback.fst (g ≫ V.ι) f
      ∀ η : Y', IsGenericPoint η Set.univ →
        GeometricallyReduced (f'.fiberToSpecResidueField η) := by
  let Y₀ := Y.nilradical.subscheme
  let rY : Y₀ ⟶ Y := Y.nilradical.subschemeι
  have : UniversalHomeomorphism rY :=
    universalHomeomorphism_nilradical_subschemeι Y
  have : IsFinite rY := inferInstance
  have : IsReduced Y₀ := isReduced_nilradical_subscheme Y
  let eY : Y₀ ≃ₜ Y := (isHomeomorph_of_universalHomeomorphism rY).homeomorph
  have : IrreducibleSpace Y₀ := eY.irreducibleSpace_iff.mpr inferInstance
  have : IsIntegral Y₀ := isIntegral_of_irreducibleSpace_of_isReduced Y₀
  let η₀ : Y₀ := genericPoint Y₀
  let U : Y₀.Opens := (Y₀.affineCover.f (Y₀.affineCover.idx η₀)).opensRange
  have hU : IsAffineOpen U := isAffineOpen_opensRange _
  have : IsAffine U := hU
  have hηU : η₀ ∈ U := Y₀.affineCover.covers η₀
  have : Nonempty U := ⟨η₀, hηU⟩
  exact exists_finite_universalHomeomorphism_from_affine_field_extension rY f U hU

private theorem isFinite_universalHomeomorphism_reduced_pullback_lift
    {X Y V Y'' : Scheme.{u}} (i : V ⟶ Y) (f : X ⟶ Y) (g : Y'' ⟶ V)
    [IsFinite g] [UniversalHomeomorphism g] :
    let P := pullback (g ≫ i) f
    let r : P.nilradical.subscheme ⟶ P := P.nilradical.subschemeι
    let f' := r ≫ pullback.fst (g ≫ i) f
    let g' : P.nilradical.subscheme ⟶ pullback i f :=
      pullback.lift (f' ≫ g) (r ≫ pullback.snd (g ≫ i) f) (by
        dsimp [f']
        rw [Category.assoc, Category.assoc, pullback.condition]
        rfl)
    IsFinite g' ∧ UniversalHomeomorphism g' := by
  intro P r f' g'
  let eAssoc := pullbackRightPullbackFstIso i f g
  let π : P ⟶ pullback i f := eAssoc.inv ≫ pullback.snd g (pullback.fst i f)
  have hUHπ : UniversalHomeomorphism π :=
    universalHomeomorphism_comp _ _ (universalHomeomorphism_of_isIso eAssoc.inv)
      (universalHomeomorphism_of_isPullback (IsPullback.of_hasPullback g (pullback.fst i f)) ‹_›)
  have hg' : g' = r ≫ π := by
    apply pullback.hom_ext
    · dsimp [g', f', π]
      rw [pullback.lift_fst]
      simp only [Category.assoc]
      rw [← pullbackRightPullbackFstIso_inv_fst, ← pullback.condition]
      rfl
    · dsimp [g', f', π]
      rw [pullback.lift_snd]
      simp only [Category.assoc]
      rw [← pullbackRightPullbackFstIso_inv_snd_snd]
  have : UniversalHomeomorphism r := universalHomeomorphism_nilradical_subschemeι P
  rw [hg']
  exact ⟨inferInstance, universalHomeomorphism_comp _ _ inferInstance hUHπ⟩

private theorem flat_finitePresentation_resLE {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens)
    (hflat : Flat f) (hfp : AlgebraicGeometry.FinitePresentation f) :
    Flat (f.resLE U (f ⁻¹ᵁ U) le_rfl) ∧
      AlgebraicGeometry.FinitePresentation (f.resLE U (f ⁻¹ᵁ U) le_rfl) := by
  have := hflat
  obtain ⟨_, _, _⟩ := hfp
  refine ⟨inferInstance, ?_⟩
  constructor
  · infer_instance
  · constructor
    · rw [Scheme.Hom.resLE_eq_morphismRestrict]
      infer_instance
    · infer_instance

private theorem geometricallyReduced_genericFiber_of_isPullback_openImmersion
    {Z X₀ U Y' : Scheme.{u}} [IsIntegral Y'] [IsIntegral U] {a : Z ⟶ X₀} {f₂' : Z ⟶ U}
    {f₀' : X₀ ⟶ Y'} {j : U ⟶ Y'} [IsOpenImmersion j] (hpb : IsPullback a f₂' f₀' j)
    (hgeo : ∀ η : Y', IsGenericPoint η Set.univ →
      GeometricallyReduced (f₀'.fiberToSpecResidueField η)) :
    ∀ η : U, IsGenericPoint η Set.univ →
      GeometricallyReduced (f₂'.fiberToSpecResidueField η) := by
  intro η hη
  have hjη : IsGenericPoint (j η) Set.univ := by
    have : η = genericPoint U := hη.eq (genericPoint_spec _)
    rw [this, genericPoint_eq_of_isOpenImmersion j]
    exact genericPoint_spec _
  exact MorphismProperty.of_isPullback
    (isPullback_fiberToSpecResidueField_of_isPullback hpb η) (hgeo (j η) hjη)

private theorem flat_finitePresentation_geometricallyReduced_of_arrowIso
    {X₀ Y' Z : Scheme.{u}} [IsIntegral Y'] (f₀' : X₀ ⟶ Y') (W : Y'.Opens)
    (U_W : W.toScheme.Opens) [IsIntegral U_W.toScheme] (f₂' : Z ⟶ U_W.toScheme)
    (e : Arrow.mk f₂' ≅ Arrow.mk (pullback.fst (U_W.ι ≫ W.ι) f₀')) (he : e.hom.right = 𝟙 _)
    (hflat : Flat (f₀'.resLE W (f₀' ⁻¹ᵁ W) le_rfl))
    (hfp : AlgebraicGeometry.FinitePresentation (f₀'.resLE W (f₀' ⁻¹ᵁ W) le_rfl))
    (hgeo : ∀ η : Y', IsGenericPoint η Set.univ →
      GeometricallyReduced (f₀'.fiberToSpecResidueField η)) :
    Flat f₂' ∧ AlgebraicGeometry.FinitePresentation f₂' ∧
      ∀ η : U_W.toScheme, IsGenericPoint η Set.univ →
        GeometricallyReduced (f₂'.fiberToSpecResidueField η) := by
  let j : U_W.toScheme ⟶ Y' := U_W.ι ≫ W.ι
  let fW := f₀'.resLE W (f₀' ⁻¹ᵁ W) le_rfl
  let fNested := fW.resLE U_W (fW ⁻¹ᵁ U_W) le_rfl
  obtain ⟨_, _, _, _⟩ := flat_finitePresentation_resLE fW U_W hflat hfp
  have hPullW : IsPullback fW (f₀' ⁻¹ᵁ W).ι W.ι f₀' := by
    simpa [fW, Scheme.Hom.resLE_eq_morphismRestrict] using
      (isPullback_morphismRestrict f₀' W)
  have hPullU : IsPullback fNested (fW ⁻¹ᵁ U_W).ι U_W.ι fW := by
    simpa [fNested, Scheme.Hom.resLE_eq_morphismRestrict] using
      (isPullback_morphismRestrict fW U_W)
  have hPullNested : IsPullback fNested
      ((fW ⁻¹ᵁ U_W).ι ≫ (f₀' ⁻¹ᵁ W).ι) j f₀' := by
    simpa [j, Category.assoc] using hPullU.paste_vert hPullW
  let eNested := hPullNested.isoPullback.symm
  let eNestedArrow : Arrow.mk (pullback.fst j f₀') ≅ Arrow.mk fNested :=
    Arrow.isoMk eNested (Iso.refl _) (by simp [eNested, fNested])
  let eAllArrow := e ≪≫ eNestedArrow
  let eLeft : Z ≅ (fW ⁻¹ᵁ U_W).toScheme :=
    ⟨eAllArrow.hom.left, eAllArrow.inv.left,
      Arrow.hom_inv_id_left eAllArrow, Arrow.inv_hom_id_left eAllArrow⟩
  have heRight : eAllArrow.hom.right = 𝟙 _ := by
    show e.hom.right ≫ 𝟙 _ = 𝟙 _
    rw [he, Category.comp_id]
  have heAll : eLeft.hom ≫ fNested = f₂' := by
    have h := eAllArrow.hom.w
    change eLeft.hom ≫ fNested = f₂' ≫ eAllArrow.hom.right at h
    rw [heRight] at h
    exact h.trans (Category.comp_id f₂')
  refine ⟨?_, ?_, ?_⟩
  · rw [← heAll]
    infer_instance
  · rw [← heAll]
    exact ⟨inferInstance, inferInstance, inferInstance⟩
  · have hpb : IsPullback
        (eAllArrow.hom.left ≫ (fW ⁻¹ᵁ U_W).ι ≫ (f₀' ⁻¹ᵁ W).ι)
        f₂' f₀' j :=
      hPullNested.flip.of_iso eLeft.symm (Iso.refl _)
        (Iso.refl _) (Iso.refl _) (by
          show _ = eAllArrow.inv.left ≫ eAllArrow.hom.left ≫ _
          simp) (by
          apply (cancel_epi eLeft.hom).mp
          simpa only [Iso.refl_hom, Iso.symm_hom, Category.comp_id,
            ← Category.assoc, Iso.hom_inv_id, Category.id_comp] using heAll) (by simp) (by simp)
    exact geometricallyReduced_genericFiber_of_isPullback_openImmersion hpb hgeo

/-- **Stacks Project, Tag 0550.** A finite type morphism over an irreducible
base admits, locally on the base, a finite universal homeomorphic cover whose
reduced pullback is flat and finitely presented with geometrically reduced
generic fibre. -/
@[stacks 0550]
public theorem exists_finiteUniversalHomeomorphism_geometricallyReduced_genericFiber
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IrreducibleSpace Y]
    [LocallyOfFiniteType f] [QuasiCompact f] :
    ∃ (V : Y.Opens) (_ : V.1.Nonempty)
      (Y' : Scheme.{u}) (g : Y' ⟶ V.toScheme)
      (_ : IsFinite g) (_ : UniversalHomeomorphism g)
      (_ : IsIntegral Y') (_ : IsAffine Y'),
      let X_V := pullback V.ι f
      let P := pullback (g ≫ V.ι) f
      let X' := P.nilradical.subscheme
      let r : X' ⟶ P := P.nilradical.subschemeι
      let f' : X' ⟶ Y' := r ≫ pullback.fst (g ≫ V.ι) f
      let g' : X' ⟶ X_V := pullback.lift
        (f' ≫ g) (r ≫ pullback.snd (g ≫ V.ι) f) (by
          dsimp [f']
          rw [Category.assoc, Category.assoc, pullback.condition]
          rfl)
      IsFinite g' ∧ UniversalHomeomorphism g' ∧ Flat f' ∧
        AlgebraicGeometry.FinitePresentation f' ∧
        ∀ η : Y', IsGenericPoint η Set.univ →
          GeometricallyReduced (f'.fiberToSpecResidueField η) := by
  classical
  obtain ⟨V, -, Y', g, _, _, _, _, hgeo⟩ :=
    exists_finite_universalHomeomorphism_geometricallyReduced_of_irreducible f
  let q := g ≫ V.ι
  let P₀ := pullback q f
  let p₀ : P₀ ⟶ Y' := pullback.fst q f
  let red₀ : P₀.nilradical.subscheme ⟶ P₀ := P₀.nilradical.subschemeι
  let f₀' := red₀ ≫ p₀
  obtain ⟨W, hW, hflat, hfp⟩ :=
    exists_dense_open_flat_finitePresentation_of_reduced f₀'
  obtain ⟨U', hU'aff, ⟨x, hx⟩, hU'W⟩ := exists_affine_basic_open_le_dense W hW
  have : Nonempty U' := ⟨⟨x, hx⟩⟩
  obtain ⟨W', t, ⟨y, hy⟩, htfin, htUH, ht⟩ := exists_opens_universalHomeomorphism_restrict g U'
  let iV := W'.ι ≫ V.ι
  let V₂ : Y.Opens := iV.opensRange
  let eV := IsOpenImmersion.isoOfRangeEq iV V₂.ι (by simp [V₂])
  let U_W : W.toScheme.Opens := W.ι ⁻¹ᵁ U'
  let eUW := Scheme.Opens.isoOfLE hU'W
  have : IsAffine U'.toScheme := hU'aff
  have : IsIntegral U'.toScheme := isIntegral_of_isOpenImmersion U'.ι
  have : IsAffine U_W.toScheme := IsAffine.of_isIso eUW.hom
  have : IsIntegral U_W.toScheme := IsIntegral.of_isIso eUW.inv
  let gFinal := eUW.hom ≫ t ≫ eV.hom
  have hUH : UniversalHomeomorphism gFinal :=
    universalHomeomorphism_comp _ _ (universalHomeomorphism_of_isIso eUW.hom)
      (universalHomeomorphism_comp _ _ htUH (universalHomeomorphism_of_isIso eV.hom))
  let q₂ := gFinal ≫ V₂.ι
  let P₂ := pullback q₂ f
  let r₂ : P₂.nilradical.subscheme ⟶ P₂ := P₂.nilradical.subschemeι
  let f₂' := r₂ ≫ pullback.fst q₂ f
  refine ⟨V₂, ⟨iV ⟨y, hy⟩, ⟨y, hy⟩, rfl⟩, U_W.toScheme, gFinal, inferInstance, hUH,
    inferInstance, inferInstance, ?_⟩
  have hlift := isFinite_universalHomeomorphism_reduced_pullback_lift V₂.ι f gFinal
  let j : U_W.toScheme ⟶ Y' := U_W.ι ≫ W.ι
  have hj : eUW.hom ≫ U'.ι = j := Scheme.Opens.isoOfLE_hom_ι hU'W
  have hq₂ : q₂ = j ≫ q := by
    simp only [q₂, gFinal, eV, iV, q, Category.assoc, IsOpenImmersion.isoOfRangeEq_hom_fac]
    rw [reassoc_of% ht, reassoc_of% hj]
  exact ⟨hlift.1, hlift.2,
    flat_finitePresentation_geometricallyReduced_of_arrowIso f₀' W U_W f₂'
      (reduced_openPullback_arrowIso f q j q₂ hq₂) rfl hflat hfp hgeo⟩

end AlgebraicGeometry

