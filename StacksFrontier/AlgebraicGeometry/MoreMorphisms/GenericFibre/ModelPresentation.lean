module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.AbsolutelyIrreducible
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.FractionFieldModel

/-!
# The standard model of a geometrically integral function field

Step D of the proof of Stacks Tag 0559 at the level of rings. A presentation
`L = Frac(K[xᵢ] ⧸ (q))` of the function field of the generic fibre, coming from Step C and the
transport of
`StacksFrontier.AlgebraicGeometry.MoreMorphisms.GenericFibre.LastVariable`, has the two properties
Steps E and F need: `q` stays irreducible over an algebraically closed extension of `K`, and `L`
really is the fraction field of the quotient.

## Main results

* `MvPolynomial.irreducible_map_and_isFractionRing_of_ker_eq_span`: **Step D of Stacks Tag 0559
  at the level of rings**, the two properties of the presentation at once.

## Implementation notes

The embedding of the quotient into `L` is an argument, supplied together with the equation
saying that it factors evaluation at `v`; this is what `Ideal.Quotient.liftₐ` returns, and
taking it as an argument keeps proof terms out of the statement. Its injectivity is not an
argument: it follows from the ideal being the kernel.

No Stacks tag is attached: Step D is not itself a tag of the source.

## References

* [Stacks Project, Tag 0559](https://stacks.math.columbia.edu/tag/0559), Step D of the first
  proof
-/

@[expose] public section

open scoped TensorProduct

universe u v w

namespace MvPolynomial

/-- **Step D of Stacks Tag 0559 at the level of rings.** Let `L` be a field extension of `K`
generated by a family `v : ι → L` with `L ⊗[K] K̄` a domain, and let `q : MvPolynomial ι K` be
nonzero and generate the kernel of evaluation at `v`. Then the coefficientwise image of `q` in
`K̄[xᵢ]` is irreducible, and `L` is a field of fractions of `MvPolynomial ι K ⧸ (q)`. -/
theorem irreducible_map_and_isFractionRing_of_ker_eq_span {K : Type u} [Field K] {L : Type v}
    [Field L] [Algebra K L] {Kbar : Type w} [Field Kbar] [Algebra K Kbar] {ι : Type*} (v : ι → L)
    (hadj : IntermediateField.adjoin K (Set.range v) = ⊤) (hL : IsDomain (L ⊗[K] Kbar))
    {q : MvPolynomial ι K} (hq : q ≠ 0)
    (φ : (MvPolynomial ι K ⧸ Ideal.span {q}) →ₐ[K] L)
    (hφ : φ.comp (Ideal.Quotient.mkₐ K (Ideal.span {q})) = (aeval v : MvPolynomial ι K →ₐ[K] L))
    (hker : RingHom.ker (aeval v : MvPolynomial ι K →ₐ[K] L).toRingHom = Ideal.span {q}) :
    letI := φ.toRingHom.toAlgebra
    Irreducible (q.map (algebraMap K Kbar)) ∧
      IsFractionRing (MvPolynomial ι K ⧸ Ideal.span {q}) L := by
  have hinj : Function.Injective φ :=
    injective_of_comp_quotientMk_eq φ.toRingHom (aeval v : MvPolynomial ι K →ₐ[K] L).toRingHom
      (RingHom.ext fun a => congrArg (fun ρ : MvPolynomial ι K →ₐ[K] L => ρ a) hφ) hker.symm
  exact ⟨irreducible_map_of_isDomain_tensor hL hq φ hinj,
    isFractionRing_quotient_of_adjoin_eq_top v hadj φ hinj hφ⟩

end MvPolynomial

end
