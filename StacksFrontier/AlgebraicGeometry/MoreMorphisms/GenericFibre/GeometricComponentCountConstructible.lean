/-!
# Constructibility of the number of geometric irreducible components

Stacks Tag 055B says that for a morphism of schemes of finite presentation, each level set of
the function counting the geometrically irreducible components of the fibres is locally
constructible in the target.

The proof goes through Stacks Tag 055A, which in turn needs Tags 0554 and 0559; none of the
three is available in the library, so the results below take the conclusions of Tags 0554 and
0559 as hypotheses, packaged as
`AlgebraicGeometry.IrreducibleComponentsLowerBoundAfterShrinking` and
`AlgebraicGeometry.GeometricallyIrreducibleAfterShrinking`.

## Main results

* `AlgebraicGeometry.isLocallyConstructible_geometricIrreducibleComponentCount_fiber` is
  Stacks Tag 055B granted those two hypotheses.
* `AlgebraicGeometry.exists_noetherian_model` descends a morphism of finite presentation over an
  affine base to one over a Noetherian affine base.

## Implementation notes

The number of components is `AlgebraicGeometry.geometricIrreducibleComponentCount` of Tag 0556,
valued in `ℕ∞`, so the statement also covers the level set at infinity; for a morphism of finite
presentation that level set is empty.

The argument is local on the target, so the target may be taken affine, `Spec R`. Writing `R`
as the filtered colimit of the subalgebras generated by its finite subsets, each of which is a
finite type `ℤ`-algebra and hence Noetherian, Tag 0EY1 descends the morphism to a model over a
Noetherian base, where Tag 055A plus the dichotomy criterion for constructibility in a
Noetherian space apply; Tag 0556 and Tag 054I carry the conclusion back.

## References

* [Stacks Project, Tag 055B](https://stacks.math.columbia.edu/tag/055B)
-/

public section

open CategoryTheory Topology

namespace AlgebraicGeometry

universe u

open TopologicalSpace Limits

noncomputable section

/-- A morphism of finite presentation to an affine scheme is the base change of a morphism of
finite presentation over a Noetherian affine base: write the ring as the filtered colimit of
the subalgebras generated over `ℤ` by its finite subsets, each of which is Noetherian, and
descend the morphism to a finite stage. -/
theorem exists_noetherian_model {X : Scheme.{u}} (R : CommRingCat.{u})
    (f : X ⟶ Spec R) (hf : AlgebraicGeometry.FinitePresentation f) :
    ∃ (Y₀ X₀ : Scheme.{u}) (g : Spec R ⟶ Y₀) (f₀ : X₀ ⟶ Y₀),
      TopologicalSpace.NoetherianSpace Y₀ ∧ AlgebraicGeometry.FinitePresentation f₀ ∧
      Nonempty (Over.mk f ≅ (Over.pullback g).obj (Over.mk f₀)) := by
  let D := R.finiteSubalgebras.op ⋙ Scheme.Spec
  let cBase := Scheme.Spec.mapCone R.finiteSubalgebrasCocone.op
  let c : Cone D := { pt := Spec R, π := cBase.π }
  have hc : IsLimit c := by
    show IsLimit cBase
    exact isLimitOfPreserves _ R.finiteSubalgebrasIsColimit.op
  let : ∀ i, IsAffine (D.obj i) := fun i => inferInstanceAs (IsAffine (Spec _))
  obtain ⟨i, Xi, hXi, e⟩ :=
    LimitDescent.exists_model_of_finitePresentation_of_essentiallySmall D c hc (Over.mk f) hf
  refine ⟨D.obj i, Xi.left, c.π.app i, Xi.hom, ?_, hXi, e⟩
  let : Algebra.FiniteType ℤ (Algebra.adjoin ℤ (i.unop : Set R)) :=
    (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset _)
  let := Algebra.FiniteType.isNoetherianRing ℤ (Algebra.adjoin ℤ (i.unop : Set R))
  show TopologicalSpace.NoetherianSpace
    (Spec (CommRingCat.of (Algebra.adjoin ℤ (i.unop : Set R))))
  infer_instance

private theorem componentCount_eq_of_iso {Y : Scheme.{u}} {X X' : Over Y} (e : X ≅ X') :
    geometricIrreducibleComponentCount X.hom =
      geometricIrreducibleComponentCount X'.hom := by
  funext y
  let K := SeparableClosure (Y.residueField y)
  let e₁ := (Over.pullback (Y.fromSpecResidueField y)).mapIso e
  let e₂ := (Over.pullback (Spec.map (CommRingCat.ofHom
    (algebraMap (Y.residueField y) K)))).mapIso e₁
  let e₃ : geometricFiber X.hom y K ≅ geometricFiber X'.hom y K :=
    (Over.forget _).mapIso e₂
  let h := Scheme.homeoOfIso e₃
  apply Set.encard_congr; apply Equiv.symm
  exact (irreducibleComponentsEquivOfIsPreirreducibleFiber h h.continuous h.isOpenMap
    (fun y => (Set.subsingleton_singleton.preimage h.injective).isPreirreducible)
    h.surjective).toEquiv

private theorem isLocallyConstructible_componentCount_spec
    (H0554 : IrreducibleComponentsLowerBoundAfterShrinking.{u})
    (H0559 : GeometricallyIrreducibleAfterShrinking.{u}) {X : Scheme.{u}}
    (R : CommRingCat.{u}) (f : X ⟶ Spec R) (hf : AlgebraicGeometry.FinitePresentation f) (n : ℕ∞) :
    IsLocallyConstructible {y | geometricIrreducibleComponentCount f y = n} := by
  obtain ⟨Y₀, X₀, g, f₀, hY₀, hf₀, ⟨e⟩⟩ := exists_noetherian_model R f hf
  have := hY₀
  have := hf₀.1
  have := hf₀.2.1
  have h := (isConstructible_of_constant_near_genericPoints (geometricIrreducibleComponentCount f₀)
    (exists_open_geometricIrreducibleComponentCount_eq H0554 H0559 f₀) n).isLocallyConstructible
  have he := componentCount_eq_of_iso e
  change geometricIrreducibleComponentCount f =
    geometricIrreducibleComponentCount (pullback.snd f₀ g) at he
  rw [he, geometricIrreducibleComponentCount_pullback]
  exact isLocallyConstructible_preimage g h

/-- **Stacks Project, Tag 055B**, granted Tags 0554 and 0559. Every level set of the number of
geometrically irreducible components of the fibres of a morphism of finite presentation is
locally constructible.

No tag is attached: the statement carries the hypotheses `H0554` and `H0559`, which the Stacks
statement does not have. Discharging both turns this into Tag 055B. -/
public theorem isLocallyConstructible_geometricIrreducibleComponentCount_fiber
    (H0554 : IrreducibleComponentsLowerBoundAfterShrinking.{u})
    (H0559 : GeometricallyIrreducibleAfterShrinking.{u})
    {X Y : Scheme.{u}} (f : X ⟶ Y) (hf : AlgebraicGeometry.FinitePresentation f) (n : ℕ∞) :
    IsLocallyConstructible {y : Y | geometricIrreducibleComponentCount f y = n} := by
  have := hf.1
  have := hf.2.1
  have := hf.2.2
  refine .of_isOpenCover Y.affineCover.isOpenCover_opensRange fun i => ?_
  have hp : AlgebraicGeometry.FinitePresentation (pullback.snd f (Y.affineCover.f i)) :=
    ⟨inferInstance, inferInstance, inferInstance⟩
  have h₀ := isLocallyConstructible_componentCount_spec H0554 H0559 _
    (pullback.snd f (Y.affineCover.f i)) hp n
  have hfun := geometricIrreducibleComponentCount_pullback f (Y.affineCover.f i)
  have hcount : {y | geometricIrreducibleComponentCount
        (pullback.snd f (Y.affineCover.f i)) y = n} =
      {y | (geometricIrreducibleComponentCount f ∘ (Y.affineCover.f i)) y = n} := by
    ext y
    show geometricIrreducibleComponentCount (pullback.snd f (Y.affineCover.f i)) y = n ↔
      (geometricIrreducibleComponentCount f ∘ (Y.affineCover.f i)) y = n
    rw [congrFun hfun y]
  have h : IsLocallyConstructible
      {y | (geometricIrreducibleComponentCount f ∘ (Y.affineCover.f i)) y = n} :=
    cast (congrArg (fun s => IsLocallyConstructible s) hcount) h₀
  have h' := h.preimage_of_isOpenEmbedding (Y.affineCover.f i).isoOpensRange.inv.isOpenEmbedding
  convert! h' using 1
  ext y
  show (geometricIrreducibleComponentCount f y.1 = n) ↔
    (geometricIrreducibleComponentCount f
      ((Y.affineCover.f i) ((Y.affineCover.f i).isoOpensRange.inv y)) = n)
  have he := congrArg (fun k : (Y.affineCover.f i).opensRange.toScheme ⟶ Y => k y)
    (Scheme.Hom.isoOpensRange_inv_comp (Y.affineCover.f i))
  rw [show (Y.affineCover.f i) ((Y.affineCover.f i).isoOpensRange.inv y) = y.1 from he]

end

end AlgebraicGeometry
