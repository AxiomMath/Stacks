/-!
# The slicing lemma: a Cohen-Macaulay point has a locally quasi-finite slice

This file proves `AlgebraicGeometry.HasQuasiFiniteSlices`, a weak form of [Stacks, Tag 0570]: a
point `x` which is closed in its fibre and at which a morphism `f : X ⟶ S` locally of finite
presentation is Cohen-Macaulay admits an immersion `i : Z ⟶ X` through `x` with `Z ⟶ S` flat,
locally of finite presentation and locally quasi-finite.

## Main results

* `AlgebraicGeometry.hasQuasiFiniteSlices`: the slicing lemma, in the weak form that
  [Stacks, Tag 0571] uses.
* `AlgebraicGeometry.exists_flat_locallyQuasiFinite_factorization_through`: [Stacks, Tag 0571].

## Implementation notes

`AlgebraicGeometry.HasQuasiFiniteSlice` omits the regular-immersion clause and the singleton-fibre
clause `Z_s = {x}` of Tag 0570, so neither is proved here; the complete Tag 0570 is proved in
`StacksFrontier.AlgebraicGeometry.MoreMorphisms.CohenMacaulaySlice.RegularSliceThroughPoint`.

## References

* [Stacks Project, Tag 0570](https://stacks.math.columbia.edu/tag/0570)
* [Stacks Project, Tag 0470](https://stacks.math.columbia.edu/tag/0470)
* [Stacks Project, Tag 0571](https://stacks.math.columbia.edu/tag/0571)
-/

@[expose] public section

open CategoryTheory

universe u

/-! ### Ring theory -/

/-- A surjection of rings induces a surjection of the localizations at corresponding primes, with
kernel the ideal generated by the image of the kernel. -/
theorem surjective_and_ker_of_surjective_of_isLocalization
    {A B : Type*} [CommRing A] [CommRing B] (φ : A →+* B) (hφ : Function.Surjective φ)
    (p : Ideal A) [p.IsPrime] (Q : Ideal B) [Q.IsPrime] (hQ : Ideal.comap φ Q = p)
    {T W : Type*} [CommRing T] [CommRing W] [Algebra A T] [IsLocalization.AtPrime T p]
    [Algebra B W] [IsLocalization.AtPrime W Q] (ψ : T →+* W)
    (hψ : ∀ a : A, ψ (algebraMap A T a) = algebraMap B W (φ a)) :
    Function.Surjective ψ ∧
      RingHom.ker ψ = Ideal.map (algebraMap A T) (RingHom.ker φ) := by
  have hmem : ∀ a : A, φ a ∈ Q ↔ a ∈ p := fun a => by rw [← hQ]; exact Iff.rfl
  have hcompl : ∀ a : A, φ a ∈ Q.primeCompl → a ∈ p.primeCompl := fun a h h' => h ((hmem a).2 h')
  have hmk' : ∀ (a : A) (s : p.primeCompl),
      ψ (IsLocalization.mk' T a s) =
        IsLocalization.mk' W (φ a) (⟨φ s.1, fun h => s.2 ((hmem _).1 h)⟩ : Q.primeCompl) := by
    intro a s
    rw [eq_comm, IsLocalization.mk'_eq_iff_eq_mul, ← hψ, ← hψ, ← map_mul,
      IsLocalization.mk'_spec]
  refine ⟨fun w => ?_, ?_⟩
  · obtain ⟨⟨b, t⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl w
    obtain ⟨a, rfl⟩ := hφ b
    obtain ⟨a', ha'⟩ := hφ t.1
    refine ⟨IsLocalization.mk' T a (⟨a', hcompl _ (ha' ▸ t.2)⟩ : p.primeCompl), ?_⟩
    rw [hmk']
    congr 1
    exact Subtype.ext ha'
  · apply le_antisymm
    · intro τ hτ
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl τ
      rw [RingHom.mem_ker, hmk', IsLocalization.mk'_eq_zero_iff] at hτ
      obtain ⟨t, ht⟩ := hτ
      obtain ⟨a'', ha''⟩ := hφ t.1
      have hker : a'' * a ∈ RingHom.ker φ := by
        rw [RingHom.mem_ker, map_mul, ha'']; exact ht
      have hane : a'' ∈ p.primeCompl := hcompl _ (ha'' ▸ t.2)
      obtain ⟨v, hv⟩ : IsUnit (algebraMap A T (a'' * s.1)) :=
        IsLocalization.map_units T (⟨a'' * s.1, mul_mem hane s.2⟩ : p.primeCompl)
      have hvinv : (↑v⁻¹ : T) * (algebraMap A T a'' * algebraMap A T s.1) = 1 := by
        rw [← map_mul, ← hv]; exact v.inv_val
      have key : IsLocalization.mk' T a s = algebraMap A T (a'' * a) * (↑v⁻¹ : T) := by
        rw [IsLocalization.mk'_eq_iff_eq_mul, map_mul,
          show algebraMap A T a'' * algebraMap A T a * (↑v⁻¹ : T) * algebraMap A T s.1
            = algebraMap A T a * ((↑v⁻¹ : T) * (algebraMap A T a'' * algebraMap A T s.1)) by ring,
          hvinv, mul_one]
      have hres : IsLocalization.mk' T a s ∈ Ideal.map (algebraMap A T) (RingHom.ker φ) := by
        rw [key]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hker)
      exact hres
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [RingHom.mem_ker] at ha
      simp only [Ideal.mem_comap, RingHom.mem_ker, hψ, ha, map_zero]

/-- In a Cohen-Macaulay Noetherian local ring there is a regular sequence inside the maximal ideal
whose quotient has dimension zero. -/
theorem exists_isRegular_ringKrullDim_quotient_ofList_eq_zero {R : Type*} [CommRing R]
    [IsNoetherianRing R] [IsLocalRing R] (hCM : IsCohenMacaulayLocalRing R) :
    ∃ ss : List R, (∀ r ∈ ss, r ∈ IsLocalRing.maximalIdeal R) ∧
      RingTheory.Sequence.IsRegular R ss ∧ ringKrullDim (R ⧸ Ideal.ofList ss) = 0 := by
  obtain ⟨ss, hmem, hreg, hlen⟩ := exists_isRegular_length_eq_depth_of_cohenMacaulay hCM
  refine ⟨ss, hmem, hreg, ?_⟩
  have hlen' : ((ss.length : ℕ) : WithBot ℕ∞) = ringKrullDim R := by
    have hsd : Module.supportDim R R = ringKrullDim R := Module.supportDim_self_eq_ringKrullDim R
    rw [Module.supportDim] at hsd
    unfold IsCohenMacaulayLocalRing IsCohenMacaulayModule at hCM
    rw [← hsd, ← hCM, ← hlen]
    rfl
  have heq := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular (R := R) ss hreg
  rw [← hlen'] at heq
  refine (ENat.WithBot.add_natCast_cancel (c := ss.length)).mp ?_
  rwa [zero_add]

namespace AlgebraicGeometry

/-! ### Germs of a list of stalk elements on a common affine open -/

/-- Every finite list of elements of a stalk is the list of germs of sections on a single affine
open neighbourhood. -/
theorem exists_isAffineOpen_germ_list_eq {X : Scheme.{u}} (x : X)
    (l : List (X.presheaf.stalk x)) :
    ∃ (U : X.Opens) (_ : IsAffineOpen U) (hxU : x ∈ U) (a : List Γ(X, U)),
      a.map (X.presheaf.germ U x hxU).hom = l := by
  induction l with
  | nil =>
    obtain ⟨U, hU, hxU, -⟩ :=
      exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := ⊤) trivial
    exact ⟨U, hU, hxU, [], rfl⟩
  | cons h t ih =>
    obtain ⟨U₁, hU₁, hx₁, b, hb⟩ := Stacks.Divisors.exists_isAffineOpen_germ_eq x h
    obtain ⟨U₂, hU₂, hx₂, a₂, ha₂⟩ := ih
    obtain ⟨V, hV, hxV, hVle⟩ :=
      exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := U₁ ⊓ U₂) ⟨hx₁, hx₂⟩
    have hV₁ : V ≤ U₁ := le_trans hVle inf_le_left
    have hV₂ : V ≤ U₂ := le_trans hVle inf_le_right
    refine ⟨V, hV, hxV,
      (X.presheaf.map (homOfLE hV₁).op).hom b ::
        a₂.map (X.presheaf.map (homOfLE hV₂).op).hom, ?_⟩
    rw [List.map_cons, List.map_map]
    refine congrArg₂ List.cons ?_ ?_
    · rw [← hb]
      exact X.presheaf.germ_res_apply (homOfLE hV₁) x hxV b
    · rw [← ha₂]
      exact List.map_congr_left fun c _ =>
        X.presheaf.germ_res_apply (homOfLE hV₂) x hxV c

/-! ### The stalk of a slice of an affine open -/

section Slice

variable {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U) {B : CommRingCat.{u}}
  (ρ : Γ(X, U) ⟶ B)

/-- A morphism `Spec B ⟶ Spec Γ(X, U) ⟶ X` lands inside `U`. -/
theorem preimage_fromSpec_comp : (Spec.map ρ ≫ hU.fromSpec) ⁻¹ᵁ U = ⊤ := by
  rw [Scheme.Hom.comp_preimage, hU.fromSpec_preimage_self]
  simp

/-- On global sections, `Spec.map ρ ≫ hU.fromSpec` is `ρ` followed by an isomorphism. -/
theorem appLE_fromSpec_comp :
    (Spec.map ρ ≫ hU.fromSpec).appLE U ⊤ (le_of_eq (preimage_fromSpec_comp hU ρ).symm) =
      ρ ≫ (Scheme.ΓSpecIso B).inv := by
  rw [Scheme.Hom.comp_appLE, hU.fromSpec_app_self, Category.assoc, Scheme.Hom.map_appLE',
    Scheme.ΓSpecIso_inv_naturality]
  · congr 1
  · simp

/-- **The stalk of a slice.** For a surjection `ρ : Γ(X, U) ⟶ B` with `U` an affine open of `X`,
the stalk map of `Spec B ⟶ Spec Γ(X, U) ⟶ X` at a point `z` of `Spec B` is surjective with kernel
the ideal generated by the germs of the kernel of `ρ`. -/
theorem stalkMap_surjective_and_ker_fromSpec (hρ : Function.Surjective ρ.hom) (z : Spec B) :
    Function.Surjective ((Spec.map ρ ≫ hU.fromSpec).stalkMap z).hom ∧
      ∀ h : (Spec.map ρ ≫ hU.fromSpec) z ∈ U,
        RingHom.ker ((Spec.map ρ ≫ hU.fromSpec).stalkMap z).hom =
          Ideal.map (X.presheaf.germ U _ h).hom (RingHom.ker ρ.hom) := by
  classical
  set i : Spec B ⟶ X := Spec.map ρ ≫ hU.fromSpec with hi
  have hle : (⊤ : (Spec B).Opens) ≤ i ⁻¹ᵁ U := le_of_eq (preimage_fromSpec_comp hU ρ).symm
  have hzU : i z ∈ U := hle (show z ∈ (⊤ : (Spec B).Opens) from trivial)
  have hV : IsAffineOpen (⊤ : (Spec B).Opens) := isAffineOpen_top (Spec B)
  have happ : i.appLE U ⊤ hle = ρ ≫ (Scheme.ΓSpecIso B).inv := appLE_fromSpec_comp hU ρ
  have hbij := (ConcreteCategory.isIso_iff_bijective ((Scheme.ΓSpecIso B).inv)).mp inferInstance
  have hsurjapp : Function.Surjective (i.appLE U ⊤ hle).hom := by
    rw [happ, CommRingCat.hom_comp]
    exact hbij.surjective.comp hρ
  have hkerapp : RingHom.ker (i.appLE U ⊤ hle).hom = RingHom.ker ρ.hom := by
    ext s
    simp only [RingHom.mem_ker, happ, CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply]
    exact ⟨fun h => hbij.injective (by rw [h, map_zero]), fun h => by rw [h, map_zero]⟩
  let _ : Algebra Γ(X, U) (X.presheaf.stalk (i z)) :=
    X.presheaf.algebra_section_stalk (⟨i z, hzU⟩ : U)
  let _ : Algebra Γ(Spec B, ⊤) ((Spec B).presheaf.stalk z) :=
    (Spec B).presheaf.algebra_section_stalk (⟨z, trivial⟩ : (⊤ : (Spec B).Opens))
  have _ := hU.isLocalization_stalk (⟨i z, hzU⟩ : U)
  have _ := hV.isLocalization_stalk (⟨z, trivial⟩ : (⊤ : (Spec B).Opens))
  have hQ := IsAffineOpen.comap_primeIdealOf_appLE (f := i) U hU ⊤ hV hle
    (show z ∈ (⊤ : (Spec B).Opens) from trivial)
  have key := surjective_and_ker_of_surjective_of_isLocalization
    (i.appLE U ⊤ hle).hom hsurjapp
    (hU.primeIdealOf (⟨i z, hzU⟩ : U)).asIdeal
    (hV.primeIdealOf (⟨z, trivial⟩ : (⊤ : (Spec B).Opens))).asIdeal
    (congrArg PrimeSpectrum.asIdeal hQ)
    (T := X.presheaf.stalk (i z)) (W := (Spec B).presheaf.stalk z)
    (i.stalkMap z).hom (fun s => by
      change (i.stalkMap z).hom ((X.presheaf.germ U (i z) hzU).hom s) =
        ((Spec B).presheaf.germ ⊤ z trivial).hom ((i.appLE U ⊤ hle).hom s)
      rw [Scheme.Hom.germ_stalkMap_apply i U z hzU s]
      change _ = ((Spec B).presheaf.germ ⊤ z trivial).hom
        (((Spec B).presheaf.map (homOfLE hle).op).hom ((i.app U).hom s))
      exact ((Spec B).presheaf.germ_res_apply (homOfLE hle) z trivial ((i.app U).hom s)).symm)
  exact ⟨key.1, fun h => by rw [key.2, hkerapp]; rfl⟩

end Slice

end AlgebraicGeometry

/-! ### Transporting a surjection with known kernel -/

/-- The isomorphism `T ⧸ p ≃+* W` attached to a surjection `ψ : T →+* W` with kernel `p`. -/
noncomputable def quotKerEquiv {T W : Type*} [CommRing T] [CommRing W] {p : Ideal T}
    (ψ : T →+* W) (hψ : Function.Surjective ψ) (hker : RingHom.ker ψ = p) : (T ⧸ p) ≃+* W :=
  (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hψ)

/-- The isomorphism of `quotKerEquiv` is induced by the surjection it is built from. -/
@[simp]
theorem quotKerEquiv_mk {T W : Type*} [CommRing T] [CommRing W] {p : Ideal T}
    (ψ : T →+* W) (hψ : Function.Surjective ψ) (hker : RingHom.ker ψ = p) (t : T) :
    quotKerEquiv ψ hψ hker (Ideal.Quotient.mk p t) = ψ t := by
  change (RingHom.quotientKerEquivOfSurjective hψ)
    (Ideal.quotEquivOfEq hker.symm (Ideal.Quotient.mk p t)) = ψ t
  rw [Ideal.quotEquivOfEq_mk, RingHom.quotientKerEquivOfSurjective_apply_mk]

/-- The surjection factors as the quotient map followed by `quotKerEquiv`. -/
theorem comp_quotKerEquiv {T W : Type*} [CommRing T] [CommRing W] {p : Ideal T}
    (ψ : T →+* W) (hψ : Function.Surjective ψ) (hker : RingHom.ker ψ = p) :
    ((quotKerEquiv ψ hψ hker : (T ⧸ p) →+* W)).comp (Ideal.Quotient.mk p) = ψ :=
  RingHom.ext (quotKerEquiv_mk ψ hψ hker)

/-- Flatness over `R` of the quotient of `T` by `p` is flatness over `R` of any ring presented as
`T` modulo `p`. -/
theorem ringHom_flat_comp_of_surjective {R T W : Type*} [CommRing R] [CommRing T] [CommRing W]
    (α : R →+* T) {p : Ideal T} (hflat : ((Ideal.Quotient.mk p).comp α).Flat)
    (ψ : T →+* W) (hψ : Function.Surjective ψ) (hker : RingHom.ker ψ = p) :
    (ψ.comp α).Flat := by
  rw [← comp_quotKerEquiv ψ hψ hker, RingHom.comp_assoc]
  exact RingHom.Flat.comp hflat (RingHom.Flat.of_bijective (quotKerEquiv ψ hψ hker).bijective)

/-- The `Module.Flat` form of flatness of a quotient, read as a property of the ring map. -/
theorem flat_mk_comp_algebraMap {R T : Type*} [CommRing R] [CommRing T] [Algebra R T]
    (p : Ideal T) (hflat : Module.Flat R (T ⧸ p)) :
    ((Ideal.Quotient.mk p).comp (algebraMap R T)).Flat :=
  RingHom.flat_algebraMap_iff.mpr hflat

/-- Let `ψ : T →+* W` be surjective with kernel `p` and `α : R →+* T`. If `T ⧸ (p ⊔ J T)` has
dimension zero, then so does `W ⧸ J W`. -/
theorem ringKrullDim_quotient_map_comp_eq_zero
    {R T W : Type*} [CommRing R] [CommRing T] [CommRing W] (α : R →+* T) {p : Ideal T}
    (J : Ideal R) (ψ : T →+* W) (hψ : Function.Surjective ψ) (hker : RingHom.ker ψ = p)
    (hdim : ringKrullDim (T ⧸ (p ⊔ Ideal.map α J)) = 0) :
    ringKrullDim (W ⧸ Ideal.map (ψ.comp α) J) = 0 := by
  have hmap : Ideal.map (ψ.comp α) J =
      Ideal.map ((quotKerEquiv ψ hψ hker : (T ⧸ p) →+* W))
        (Ideal.map (Ideal.Quotient.mk p) (Ideal.map α J)) := by
    rw [Ideal.map_map, Ideal.map_map, comp_quotKerEquiv]
  rwa [hmap, ← ringKrullDim_eq_of_ringEquiv
      (Ideal.quotientEquiv (Ideal.map (Ideal.Quotient.mk p) (Ideal.map α J)) _
        (quotKerEquiv ψ hψ hker) rfl),
    ringKrullDim_eq_of_ringEquiv (DoubleQuot.quotQuotEquivQuotSup p (Ideal.map α J))]

namespace AlgebraicGeometry

/-! ### Cutting the slice out of an affine open -/

/-- **The slice.** For an affine open `U ∋ x` and a list `a` of sections on `U` whose germs at `x`
lie in the maximal ideal, `Spec (Γ(X, U) ⧸ (a)) ⟶ Spec Γ(X, U) ⟶ X` is an immersion through `x`,
locally of finite presentation, whose stalk map at the corresponding point is surjective with
kernel the ideal generated by the germs of `a`. -/
theorem exists_isImmersion_slice {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U)
    (a : List Γ(X, U)) (x : X) (hxU : x ∈ U)
    (hIp : Ideal.ofList a ≤ (hU.primeIdealOf ⟨x, hxU⟩).asIdeal) :
    ∃ (Z : Scheme.{u}) (i : Z ⟶ X) (z : Z), IsImmersion i ∧
      LocallyOfFinitePresentation i ∧ i z = x ∧
      Function.Surjective (i.stalkMap z).hom ∧
      ∀ h : i z ∈ U, RingHom.ker (i.stalkMap z).hom =
        Ideal.map (X.presheaf.germ U (i z) h).hom (Ideal.ofList a) := by
  classical
  have hIfg : (Ideal.ofList a).FG := Submodule.fg_span a.finite_toSet
  set B : CommRingCat.{u} := CommRingCat.of (Γ(X, U) ⧸ Ideal.ofList a) with hB
  set ρ : Γ(X, U) ⟶ B := CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.ofList a)) with hρdef
  have hρsurj : Function.Surjective ρ.hom := Ideal.Quotient.mk_surjective
  have hkerρ : RingHom.ker ρ.hom = Ideal.ofList a := by
    rw [hρdef, CommRingCat.hom_ofHom, Ideal.mk_ker]
  have hqprime : ((hU.primeIdealOf ⟨x, hxU⟩).asIdeal.map
      (Ideal.Quotient.mk (Ideal.ofList a))).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [Ideal.mk_ker])
  refine ⟨Spec B, Spec.map ρ ≫ hU.fromSpec,
    ⟨(hU.primeIdealOf ⟨x, hxU⟩).asIdeal.map (Ideal.Quotient.mk (Ideal.ofList a)), hqprime⟩,
    ?_, ?_, ?_, ?_⟩
  · have : IsClosedImmersion (Spec.map ρ) := IsClosedImmersion.spec_of_surjective ρ hρsurj
    infer_instance
  · have : Algebra.FinitePresentation Γ(X, U) (Γ(X, U) ⧸ Ideal.ofList a) :=
      Algebra.FinitePresentation.quotient hIfg
    have : LocallyOfFinitePresentation (Spec.map ρ) :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)).mpr this
    infer_instance
  · have hpt : (Spec.map ρ).base
        ⟨(hU.primeIdealOf ⟨x, hxU⟩).asIdeal.map (Ideal.Quotient.mk (Ideal.ofList a)), hqprime⟩ =
        hU.primeIdealOf ⟨x, hxU⟩ := by
      apply PrimeSpectrum.ext
      change Ideal.comap (Ideal.Quotient.mk (Ideal.ofList a))
          ((hU.primeIdealOf ⟨x, hxU⟩).asIdeal.map (Ideal.Quotient.mk (Ideal.ofList a))) = _
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
      exact sup_eq_left.mpr hIp
    change hU.fromSpec ((Spec.map ρ) _) = x
    rw [hpt, hU.fromSpec_primeIdealOf]
  · obtain ⟨h1, h2⟩ := stalkMap_surjective_and_ker_fromSpec hU ρ hρsurj
      ⟨(hU.primeIdealOf ⟨x, hxU⟩).asIdeal.map (Ideal.Quotient.mk (Ideal.ofList a)), hqprime⟩
    exact ⟨h1, fun h => by rw [h2 h, hkerρ]⟩

/-! ### Closedness in the fibre passes to an immersion -/

/-- A point of the source of an immersion `i : Z ⟶ X` whose image is closed in its `f`-fibre is
closed in its own `i ≫ f`-fibre. -/
theorem isClosed_singleton_asFiber_comp {X S Z : Scheme.{u}} (f : X ⟶ S) (i : Z ⟶ X)
    [IsImmersion i] (z : Z)
    (hclosed : IsClosed ({f.asFiber (i z)} : Set (f.fiber (f (i z))))) :
    IsClosed ({(i ≫ f).asFiber z} : Set ((i ≫ f).fiber ((i ≫ f) z))) := by
  have hw : ((i ≫ f).fiberι ((i ≫ f) z) ≫ i) ≫ f =
      (i ≫ f).fiberToSpecResidueField ((i ≫ f) z) ≫ S.fromSpecResidueField (f (i z)) := by
    rw [Category.assoc]
    exact (i ≫ f).fiber_fac ((i ≫ f) z)
  let θ : (i ≫ f).fiber ((i ≫ f) z) ⟶ f.fiber (f (i z)) :=
    Limits.pullback.lift ((i ≫ f).fiberι ((i ≫ f) z) ≫ i)
      ((i ≫ f).fiberToSpecResidueField ((i ≫ f) z)) hw
  have hθ : θ ≫ f.fiberι (f (i z)) = (i ≫ f).fiberι ((i ≫ f) z) ≫ i :=
    Limits.pullback.lift_fst _ _ _
  have hθpt : ∀ w, f.fiberι (f (i z)) (θ w) = i ((i ≫ f).fiberι ((i ≫ f) z) w) := by
    intro w
    rw [← Scheme.Hom.comp_apply, hθ]
    rfl
  have hθinj : Function.Injective θ.base := by
    intro w w' hww
    refine ((i ≫ f).fiberι ((i ≫ f) z)).isEmbedding.injective ?_
    refine (IsPreimmersion.isEmbedding i).injective ?_
    rw [← hθpt, ← hθpt, hww]
  have hθz : θ ((i ≫ f).asFiber z) = f.asFiber (i z) := by
    refine (f.fiberι (f (i z))).isEmbedding.injective ?_
    rw [hθpt, Scheme.Hom.fiberι_asFiber (i ≫ f) z, Scheme.Hom.fiberι_asFiber f (i z)]
  have hset : (θ.base) ⁻¹' {f.asFiber (i z)} = {(i ≫ f).asFiber z} := by
    ext w
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    exact ⟨fun h => hθinj (h.trans hθz.symm), fun h => h ▸ hθz⟩
  rw [← hset]
  exact hclosed.preimage θ.continuous

/-! ### The slice has the required properties -/

/-- Given an affine open `U ∋ x` and a list of sections on it whose germs cut out a quotient of
`𝒪_{X,x}` that is flat over `𝒪_{S,f x}` and whose further reduction modulo the maximal ideal of
`𝒪_{S,f x}` is zero-dimensional, the point `x` has a locally quasi-finite slice. -/
theorem hasQuasiFiniteSlice_of_slice_data {X S : Scheme.{u}} (f : X ⟶ S)
    [LocallyOfFinitePresentation f] {U : X.Opens} (hU : IsAffineOpen U) (a : List Γ(X, U))
    (x : X) (hxU : x ∈ U)
    (hclosed : IsClosed ({f.asFiber x} : Set (f.fiber (f x))))
    (hle : ∀ h : x ∈ U, Ideal.ofList a ≤ (hU.primeIdealOf ⟨x, h⟩).asIdeal)
    (hflat : ∀ h : x ∈ U,
      ((Ideal.Quotient.mk (Ideal.map (X.presheaf.germ U x h).hom (Ideal.ofList a))).comp
        (f.stalkMap x).hom).Flat)
    (hdim : ∀ h : x ∈ U, ringKrullDim (X.presheaf.stalk x ⧸
      (Ideal.map (X.presheaf.germ U x h).hom (Ideal.ofList a) ⊔
        Ideal.map (f.stalkMap x).hom
          (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))))) = 0) :
    HasQuasiFiniteSlice f x := by
  obtain ⟨Z, i, z, hi, hilfp, hiz, hsurj, hker⟩ :=
    exists_isImmersion_slice hU a x hxU (hle hxU)
  have _ := hi
  have _ := hilfp
  rw [← hiz] at hxU hclosed hflat hdim ⊢
  have _ : LocallyOfFinitePresentation (i ≫ f) := inferInstance
  have hstalk : ((i ≫ f).stalkMap z).hom = (i.stalkMap z).hom.comp (f.stalkMap (i z)).hom := by
    rw [Scheme.Hom.stalkMap_comp]
    rfl
  have hflat' : IsFlatAt (i ≫ f).toLRSHom.toShHom z := by
    change ((i ≫ f).stalkMap z).hom.Flat
    rw [hstalk]
    exact ringHom_flat_comp_of_surjective _ (hflat hxU) _ hsurj (hker hxU)
  have hclosed' : IsClosed ({(i ≫ f).asFiber z} : Set ((i ≫ f).fiber ((i ≫ f) z))) :=
    isClosed_singleton_asFiber_comp f i z hclosed
  have hdim' : ringKrullDim
      (((i ≫ f).fiber ((i ≫ f) z)).presheaf.stalk ((i ≫ f).asFiber z)) = 0 := by
    rw [← ringKrullDim_eq_of_ringEquiv (quotientStalkEquivFiberStalk (i ≫ f) z), hstalk]
    exact ringKrullDim_quotient_map_comp_eq_zero _ _ _ hsurj (hker hxU) (hdim hxU)
  obtain ⟨V, j, v, hj, hjv, hjflat, hjlfp, hjqf⟩ :=
    hasQuasiFiniteSlice_of_fiberDimensionAt_eq_zero (i ≫ f) z hflat'
      ((topologicalKrullDimAt_fiber_eq_ringKrullDim_stalk (i ≫ f) z hclosed').trans hdim')
  have _ := hj
  refine ⟨V, j ≫ i, v, inferInstance, ?_, ?_, ?_, ?_⟩
  · change i (j v) = i z
    rw [hjv]
  · rwa [Category.assoc]
  · rwa [Category.assoc]
  · rwa [Category.assoc]

end AlgebraicGeometry

/-- **The algebraic core of the slicing lemma.** Let `R -> T` be a flat local homomorphism of
local rings which is essentially of finite presentation, and suppose the fibre `T/𝔪_R T` is a
Cohen-Macaulay Noetherian local ring. Then there is a sequence `l` of elements of the maximal
ideal of `T` such that `T/(l)` is flat over `R` and `T/((l) + 𝔪_R T)` is zero-dimensional. -/
theorem exists_isRegular_flat_quotient {R T : Type*} [CommRing R] [CommRing T] [IsLocalRing R]
    [IsLocalRing T] [Algebra R T] [IsLocalHom (algebraMap R T)] [Module.Flat R T]
    (hS : (algebraMap R T).EssentiallyOfFinitePresentation)
    (hNoe : IsNoetherianRing (T ⧸ Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R)))
    (hLoc : IsLocalRing (T ⧸ Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R)))
    (hCM : IsCohenMacaulayLocalRing
      (T ⧸ Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R))) :
    ∃ l : List T, (∀ t ∈ l, t ∈ IsLocalRing.maximalIdeal T) ∧
      Module.Flat R (T ⧸ Ideal.ofList l) ∧
      ringKrullDim (T ⧸ (Ideal.ofList l ⊔
        Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R))) = 0 := by
  classical
  have _ := hNoe
  have _ := hLoc
  obtain ⟨ss, hssmem, hssreg, hssdim⟩ := exists_isRegular_ringKrullDim_quotient_ofList_eq_zero hCM
  obtain ⟨l, hl⟩ : ∃ l : List T,
      l.map (Ideal.Quotient.mk
        (Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R))) = ss :=
    ⟨ss.map (fun s => Classical.choose (Ideal.Quotient.mk_surjective s)), by
      rw [List.map_map]
      exact (List.map_congr_left fun s _ =>
        Classical.choose_spec (Ideal.Quotient.mk_surjective s)).trans (List.map_id ss)⟩
  have hsmul_top : ∀ I : Ideal T, I • (⊤ : Submodule T T) = I := fun I => by simp
  have hmapIdeal : Ideal.ofList ss = (Ideal.ofList l).map
      (Ideal.Quotient.mk (Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R))) := by
    rw [Ideal.map_ofList, hl]
  have hregfib : RingTheory.Sequence.IsRegular
      (T ⧸ Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R)) l := by
    refine ⟨?_, ?_⟩
    · refine (RingTheory.Sequence.isWeaklyRegular_map_algebraMap_iff
        (S := T ⧸ Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R))
        (M := T ⧸ Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R)) l).mp ?_
      rw [show (algebraMap T
          (T ⧸ Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R))) =
        Ideal.Quotient.mk _ from rfl, hl]
      exact hssreg.toIsWeaklyRegular
    · intro htop
      refine hssreg.top_ne_smul ?_
      have heq : (Ideal.ofList ss •
            (⊤ : Submodule (T ⧸ Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R))
              (T ⧸ Ideal.map (algebraMap R T)
                (IsLocalRing.maximalIdeal R)))).restrictScalars T =
          Ideal.ofList l • (⊤ : Submodule T
            (T ⧸ Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R))) := by
        rw [hmapIdeal]
        exact (Ideal.smul_restrictScalars (Ideal.ofList l) _).trans (by simp)
      have hrestrict :
          (⊤ : Submodule (T ⧸ Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R))
            (T ⧸ Ideal.map (algebraMap R T)
              (IsLocalRing.maximalIdeal R))).restrictScalars T =
          (Ideal.ofList ss •
            (⊤ : Submodule (T ⧸ Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R))
              (T ⧸ Ideal.map (algebraMap R T)
                (IsLocalRing.maximalIdeal R)))).restrictScalars T := by
        rw [Submodule.restrictScalars_top, htop]
        exact heq.symm
      exact (Submodule.restrictScalars_inj T _ _).mp hrestrict
  obtain ⟨-, hflats⟩ :=
    Module.Flat.isRegular_and_flat_quotient_ofList_smul_of_isRegular_maximalIdeal
      (M := T) hS l (by rw [hsmul_top]; exact hregfib)
  refine ⟨l, ?_, ?_, ?_⟩
  · intro t ht
    have hmk : Ideal.Quotient.mk
        (Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R)) t ∈
        IsLocalRing.maximalIdeal
          (T ⧸ Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R)) := by
      rw [← hl] at hssmem
      exact hssmem _ (List.mem_map_of_mem ht)
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hmk ⊢
    exact fun hu => hmk (hu.map _)
  · have hfl := hflats l.length
    rwa [List.take_length, hsmul_top] at hfl
  · rw [sup_comm, ← ringKrullDim_eq_of_ringEquiv
      (DoubleQuot.quotQuotEquivQuotSup
        (Ideal.map (algebraMap R T) (IsLocalRing.maximalIdeal R)) (Ideal.ofList l)),
      ← hmapIdeal]
    exact hssdim

namespace AlgebraicGeometry

/-! ### The slicing lemma -/

/-- **The slicing lemma**, in the weak form `AlgebraicGeometry.HasQuasiFiniteSlices`: a point
which is closed in its fibre and at which a morphism locally of finite presentation is
Cohen-Macaulay admits an immersion through it which is flat, locally of finite presentation and
locally quasi-finite over the base.

This is not the statement of [Stacks, Tag 0570]: `AlgebraicGeometry.HasQuasiFiniteSlice` drops
the regular-immersion clause and the singleton-fibre clause `Z_s = {x}`, and the weaker statement
is what [Stacks, Tag 0571] uses. The complete Tag 0570, with both clauses, is the theorem
`exists_regularImmersion_flat_locallyQuasiFinite_singleton_fiber_of_isCohenMacaulayAt`
in the namespace `Stacks.AlgebraicGeometry`, which carries the tag. -/
theorem hasQuasiFiniteSlices : HasQuasiFiniteSlices.{u} := by
  intro X S f hlfp x hCMex hclosed
  obtain ⟨hf, hCM⟩ := hCMex
  have _ := hlfp
  have _ := hf (f x)
  have _ : IsLocalHom (f.stalkMap x).hom := f.toLRSHom.prop x
  let _ : Algebra (S.presheaf.stalk (f x)) (X.presheaf.stalk x) := (f.stalkMap x).hom.toAlgebra
  have _ : Module.Flat (S.presheaf.stalk (f x)) (X.presheaf.stalk x) :=
    RingHom.flat_algebraMap_iff.mp hCM.1
  have hfib := quotientStalkEquivFiberStalk f x
  have _ : IsNoetherianRing ((f.fiber (f x)).presheaf.stalk (f.asFiber x)) := inferInstance
  have hNoe : IsNoetherianRing (X.presheaf.stalk x ⧸
      Ideal.map (algebraMap (S.presheaf.stalk (f x)) (X.presheaf.stalk x))
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) :=
    isNoetherianRing_of_ringEquiv _ hfib.symm
  have hLoc : IsLocalRing (X.presheaf.stalk x ⧸
      Ideal.map (algebraMap (S.presheaf.stalk (f x)) (X.presheaf.stalk x))
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) := hfib.symm.isLocalRing
  have _ := hNoe
  have _ := hLoc
  have hCMQ : IsCohenMacaulayLocalRing (X.presheaf.stalk x ⧸
      Ideal.map (algebraMap (S.presheaf.stalk (f x)) (X.presheaf.stalk x))
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) :=
    (isCohenMacaulayLocalRing_iff_of_ringEquiv hfib).mpr hCM.2
  obtain ⟨l, hlmem, hlflat, hldim⟩ := exists_isRegular_flat_quotient
    (LocallyOfFinitePresentation.essentiallyOfFinitePresentation_stalkMap f x) hNoe hLoc hCMQ
  obtain ⟨U, hU, hxU, a, haa⟩ := exists_isAffineOpen_germ_list_eq x l
  have hIT (h : x ∈ U) :
      Ideal.map (X.presheaf.germ U x h).hom (Ideal.ofList a) = Ideal.ofList l := by
    rw [Ideal.map_ofList, haa]
  refine hasQuasiFiniteSlice_of_slice_data f hU a x hxU hclosed ?_ ?_ ?_
  · intro h
    let _ : Algebra Γ(X, U) (X.presheaf.stalk x) :=
      X.presheaf.algebra_section_stalk (⟨x, h⟩ : U)
    have _ := hU.isLocalization_stalk (⟨x, h⟩ : U)
    rw [Ideal.ofList, Ideal.span_le]
    intro c hc
    refine (IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk x)
      (hU.primeIdealOf (⟨x, h⟩ : U)).asIdeal c).mp ?_
    change (X.presheaf.germ U x h).hom c ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x)
    exact hlmem _ (haa ▸ List.mem_map_of_mem hc)
  · exact fun h => hIT h ▸
      flat_mk_comp_algebraMap (R := S.presheaf.stalk (f x)) (Ideal.ofList l) hlflat
  · exact fun h => hIT h ▸ hldim

/-! ### Locally quasi-finite flat neighbourhoods -/

/-- A point in the image of a flat morphism `f : X ⟶ S` locally of
finite presentation lies in the image of some `g : S' ⟶ S` which factors as `h ≫ f` through `f`
and is flat, locally of finite presentation and locally quasi-finite. -/
@[stacks 0571]
theorem exists_flat_locallyQuasiFinite_factorization_through
    {X S : Scheme.{u}} (f : X ⟶ S) [Flat f] [LocallyOfFinitePresentation f]
    (s : S) (hs : s ∈ Set.range f) :
    ∃ (S' : Scheme.{u}) (g : S' ⟶ S) (h : S' ⟶ X),
      h ≫ f = g ∧ Flat g ∧ LocallyOfFinitePresentation g ∧
        LocallyOfFiniteType g ∧ LocallyQuasiFinite g ∧ s ∈ Set.range g :=
  exists_flat_locallyQuasiFinite_factorization_through_of_hasQuasiFiniteSlices
    hasQuasiFiniteSlices f s hs

end AlgebraicGeometry

