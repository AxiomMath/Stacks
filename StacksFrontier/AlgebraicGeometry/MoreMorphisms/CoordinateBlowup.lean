module

public import Mathlib.RingTheory.Localization.Away.Basic
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.CoordinateSubspace
public import StacksFrontier.RingTheory.Blowup.Defs

/-!
# The blowup of affine space along a coordinate affine subspace

Fix a commutative ring `R` and integers `m, n ≥ 0`. Write affine `(m + n)`-space over `R` as
`Spec A` with `A = R[x₁, …, x_m, y₁, …, y_n]`, the polynomial ring on `Fin m ⊕ Fin n`, and let
`Z = 𝔸^m_R ⟶ 𝔸^{m+n}_R` be the closed immersion `Stacks.MoreMorphisms.coordinateEmbedding`,
which sets the last `n` coordinates to zero.

This file carries out the affine-chart computation of Stacks Tag 0H1H. Its content is the ring
theory: the centre `Z` is cut out by the ideal `(y₁, …, y_n)`, and the `i`-th standard affine
chart of the blowup — the affine blowup algebra `A[(y₁, …, y_n)/y_i]` of
`StacksFrontier.RingTheory.Blowup.Defs` — is again a polynomial ring over `R`, on the
variables `x₁, …, x_m`, the pivot `y_i`, and the ratios `t_j = y_j/y_i` for `j ≠ i`.

## Main definitions

* `Stacks.MoreMorphisms.coordinateRingIdeal` is the ideal `(y₁, …, y_n)` of the last `n`
  coordinates.
* `Stacks.MoreMorphisms.coordinateChartVariables` is the index type `Fin m ⊕ (Unit ⊕ {j // j ≠ i})`
  of the chart's variables: the first `m` coordinates, the pivot, and the ratios.
* `Stacks.MoreMorphisms.coordinateChartAlgebra` is the `i`-th standard affine blowup chart.

## Main results

* `Stacks.MoreMorphisms.coordinateEmbedding_ker_eq_span`: the scheme-theoretic centre is cut out
  by exactly the last `n` coordinates.
* `Stacks.MoreMorphisms.coordinateChart_equiv_polynomial`: the `i`-th standard affine blowup chart
  is a polynomial ring over `R`, with the original coordinates given by `x_k`, `y_i` and
  `y_j = y_i t_j`.
* `Stacks.MoreMorphisms.coordinateChart_exceptionalIdeal`: on that chart the exceptional ideal is
  principal, generated by the single coordinate `y_i`.

## Implementation notes

The variables are indexed by `Fin m ⊕ Fin n`, as in
`StacksFrontier.AlgebraicGeometry.MoreMorphisms.CoordinateSubspace`, so that the first and last
coordinates are distinguished without an index shift, and the chart's variables by
`Fin m ⊕ (Unit ⊕ {j // j ≠ i})`, which names the pivot separately from the ratios.

`coordinateEmbedding_ker_eq_span` is proved by exhibiting, for every `p : A`, the element
`p - rename Sum.inl (coordinateProjection p)` as a member of `(y₁, …, y_n)`: the substitution
`Sum.elim X 0` followed by the reindexing `Sum.inl` is an idempotent `R`-algebra endomorphism of
`A` with that ideal as the kernel of `1 - φ`, and the membership is a three-case induction on `p`.

`coordinateChart_equiv_polynomial` goes through the *localization*, not through the blowup
algebra's internal description. Injectivity of the comparison map `P → A_{y_i}` is proved by
composing with a retraction `A_{y_i} → P_u` built from the substitution `y_j ↦ u t_j` (with
`t_i = 1`) — the composite is the localization map `P → P_u`, which is injective because the
variable `u` is a non-zero-divisor in a polynomial ring over an arbitrary commutative ring.
Surjectivity is checked on the two kinds of generator of the blowup algebra, the image of `A` and
the fractions `y/y_i` with `y ∈ (y₁, …, y_n)`.

The equivalence is produced as an existential statement carrying the four substitution formulas,
as the source's chart description does, rather than as a named `def`: what the blowup computation
consumes is the formulas, and pinning the map itself would commit to one of the two mutually
inverse directions.

## References

* [Stacks Project, Tag 0H1H](https://stacks.math.columbia.edu/tag/0H1H)
* [Stacks Project, Tag 052Q](https://stacks.math.columbia.edu/tag/052Q)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory MvPolynomial

namespace Stacks.MoreMorphisms

variable (R : Type*) [CommRing R] (m n : ℕ)

/-- The ideal generated by the last `n` coordinates of affine `(m + n)`-space. -/
public noncomputable def coordinateRingIdeal : Ideal (MvPolynomial (Fin m ⊕ Fin n) R) :=
  Ideal.span (Set.range fun i : Fin n ↦ X (Sum.inr i))

/-- The last coordinates generate `coordinateRingIdeal`. -/
public theorem X_inr_mem_coordinateRingIdeal (j : Fin n) :
    (X (Sum.inr j) : MvPolynomial (Fin m ⊕ Fin n) R) ∈ coordinateRingIdeal R m n :=
  Ideal.subset_span ⟨j, rfl⟩

/-- Every element of `coordinateRingIdeal` is an `A`-linear combination of the last
coordinates. -/
public theorem mem_coordinateRingIdeal_iff {y : MvPolynomial (Fin m ⊕ Fin n) R} :
    y ∈ coordinateRingIdeal R m n ↔
      ∃ c : Fin n → MvPolynomial (Fin m ⊕ Fin n) R, ∑ j, c j * X (Sum.inr j) = y :=
  Ideal.mem_span_range_iff_exists_fun

section Kernel

/-- Reindexing the coordinate projection back into the ambient polynomial ring: the idempotent
`R`-algebra endomorphism of `A` fixing the first `m` coordinates and killing the last `n`. -/
private noncomputable def coordinateRetraction :
    MvPolynomial (Fin m ⊕ Fin n) R →ₐ[R] MvPolynomial (Fin m ⊕ Fin n) R :=
  (rename Sum.inl).comp (aeval fun i ↦ Sum.elim X (fun _ ↦ 0) i)

private theorem coordinateRetraction_apply (p : MvPolynomial (Fin m ⊕ Fin n) R) :
    coordinateRetraction R m n p = rename Sum.inl (coordinateProjection R m n p) := rfl

private theorem coordinateRetraction_X_inl (k : Fin m) :
    coordinateRetraction R m n (X (Sum.inl k)) = X (Sum.inl k) := by
  simp [coordinateRetraction]

private theorem coordinateRetraction_X_inr (j : Fin n) :
    coordinateRetraction R m n (X (Sum.inr j)) = 0 := by
  simp [coordinateRetraction]

/-- Every polynomial agrees with its coordinate retraction modulo the last `n` coordinates. -/
private theorem sub_coordinateRetraction_mem (p : MvPolynomial (Fin m ⊕ Fin n) R) :
    p - coordinateRetraction R m n p ∈ coordinateRingIdeal R m n := by
  induction p using MvPolynomial.induction_on with
  | C a => simp [coordinateRetraction]
  | add p q hp hq =>
    have : p + q - coordinateRetraction R m n (p + q) =
        (p - coordinateRetraction R m n p) + (q - coordinateRetraction R m n q) := by
      rw [map_add]; ring
    rw [this]
    exact add_mem hp hq
  | mul_X p j hp =>
    obtain k | l := j
    · have : p * X (Sum.inl k) - coordinateRetraction R m n (p * X (Sum.inl k)) =
          (p - coordinateRetraction R m n p) * X (Sum.inl k) := by
        rw [map_mul, coordinateRetraction_X_inl]; ring
      rw [this]
      exact Ideal.mul_mem_right _ _ hp
    · have : p * X (Sum.inr l) - coordinateRetraction R m n (p * X (Sum.inr l)) =
          p * X (Sum.inr l) := by
        rw [map_mul, coordinateRetraction_X_inr, mul_zero, sub_zero]
      rw [this]
      exact Ideal.mul_mem_left _ _ (X_inr_mem_coordinateRingIdeal R m n l)

/-- The scheme-theoretic centre is cut out by exactly the last `n` coordinates. -/
@[stacks 0H1H "ideal of the center"]
public theorem coordinateEmbedding_ker_eq_span :
    coordinateRingIdeal R m n = RingHom.ker (coordinateProjection R m n) := by
  refine le_antisymm (Ideal.span_le.2 ?_) fun p hp ↦ ?_
  · rintro _ ⟨j, rfl⟩
    simp [RingHom.mem_ker, coordinateProjection]
  · have h := sub_coordinateRetraction_mem R m n p
    rwa [coordinateRetraction_apply, RingHom.mem_ker.1 hp, map_zero, sub_zero] at h

end Kernel

/-- Variables of the `i`-th polynomial chart: the first `m` coordinates, the pivot `y_i`, and the
ratios `t_j` for `j ≠ i`. -/
public abbrev coordinateChartVariables (i : Fin n) := Fin m ⊕ (Unit ⊕ {j : Fin n // j ≠ i})

/-- The coordinate ring of the `i`-th affine blowup chart: the affine blowup algebra
`A[(y₁, …, y_n)/y_i]`. -/
public noncomputable abbrev coordinateChartAlgebra (i : Fin n) :=
  affineBlowupAlgebra (coordinateRingIdeal R m n) (X (Sum.inr i))
    (Localization.Away (X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin n) R))

section Chart

variable (i : Fin n)

/-- The localization of the chart's polynomial ring inverting the pivot variable `u`. It receives
the retraction of `A_{y_i}` that proves the comparison map injective. -/
private abbrev chartTarget :=
  Localization.Away (X (Sum.inr (Sum.inl ())) : MvPolynomial (coordinateChartVariables m n i) R)

/-- The images in the localization `A_{y_i}` of the chart's variables: the first `m` coordinates,
the pivot `y_i`, and the ratios `y_j/y_i`. -/
private noncomputable def chartGen :
    coordinateChartVariables m n i →
      Localization.Away (X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin n) R) :=
  Sum.elim (fun k ↦ algebraMap _ _ (X (Sum.inl k) : MvPolynomial (Fin m ⊕ Fin n) R))
    (Sum.elim (fun _ ↦ algebraMap _ _ (X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin n) R))
      fun j ↦ IsLocalization.mk' _ (X (Sum.inr j.1) : MvPolynomial (Fin m ⊕ Fin n) R)
        ⟨X (Sum.inr i), Submonoid.mem_powers _⟩)

/-- The comparison map of the `i`-th chart: the `R`-algebra map from the polynomial ring on the
chart's variables into the localization `A_{y_i}`. -/
private noncomputable def chartHom :
    MvPolynomial (coordinateChartVariables m n i) R →ₐ[R]
      Localization.Away (X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin n) R) :=
  aeval (chartGen R m n i)

private theorem chartHom_C (r : R) :
    chartHom R m n i (C r) =
      algebraMap _ _ (C r : MvPolynomial (Fin m ⊕ Fin n) R) := by
  rw [chartHom, aeval_C, IsScalarTower.algebraMap_apply R (MvPolynomial (Fin m ⊕ Fin n) R),
    algebraMap_eq]

private theorem chartHom_X_inl (k : Fin m) :
    chartHom R m n i (X (Sum.inl k)) =
      algebraMap _ _ (X (Sum.inl k) : MvPolynomial (Fin m ⊕ Fin n) R) := by
  rw [chartHom, aeval_X]; rfl

private theorem chartHom_X_pivot :
    chartHom R m n i (X (Sum.inr (Sum.inl ()))) =
      algebraMap _ _ (X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin n) R) := by
  rw [chartHom, aeval_X]; rfl

private theorem chartHom_X_ratio (j : {j : Fin n // j ≠ i}) :
    chartHom R m n i (X (Sum.inr (Sum.inr j))) =
      IsLocalization.mk' _ (X (Sum.inr j.1) : MvPolynomial (Fin m ⊕ Fin n) R)
        ⟨X (Sum.inr i), Submonoid.mem_powers _⟩ := by
  rw [chartHom, aeval_X]; rfl

/-- The relation `y_j = y_i t_j` of the source's chart description: the comparison map carries the
product of the pivot and the `j`-th ratio to `y_j`. -/
private theorem chartHom_pivot_mul_ratio {j : Fin n} (h : j ≠ i) :
    chartHom R m n i (X (Sum.inr (Sum.inl ())) * X (Sum.inr (Sum.inr ⟨j, h⟩))) =
      algebraMap _ _ (X (Sum.inr j) : MvPolynomial (Fin m ⊕ Fin n) R) := by
  have hmul : chartHom R m n i (X (Sum.inr (Sum.inl ())) * X (Sum.inr (Sum.inr ⟨j, h⟩))) =
      chartHom R m n i (X (Sum.inr (Sum.inl ()))) *
        chartHom R m n i (X (Sum.inr (Sum.inr ⟨j, h⟩))) := map_mul _ _ _
  rw [hmul, chartHom_X_pivot, chartHom_X_ratio]
  exact IsLocalization.mk'_spec'
    (Localization.Away (X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin n) R)) _ _

/-! ### Injectivity of the comparison map -/

/-- The ratio variable `t_j` of the `i`-th chart, extended by `1` at the pivot index, so that the
substitution `y_j ↦ u t_j` is uniform in `j`. -/
private noncomputable def chartRatio (j : Fin n) :
    MvPolynomial (coordinateChartVariables m n i) R :=
  if h : j = i then 1 else X (Sum.inr (Sum.inr ⟨j, h⟩))

/-- The substitution `x_k ↦ x_k`, `y_j ↦ u t_j` of the ambient polynomial ring into the chart's
polynomial ring. It sends the pivot `y_i` to the variable `u`. -/
private noncomputable def chartSubst :
    MvPolynomial (Fin m ⊕ Fin n) R →ₐ[R] MvPolynomial (coordinateChartVariables m n i) R :=
  aeval (Sum.elim (fun k ↦ X (Sum.inl k))
    fun j ↦ X (Sum.inr (Sum.inl ())) * chartRatio R m n i j)

private theorem chartSubst_C (r : R) : chartSubst R m n i (C r) = C r := by
  rw [chartSubst, aeval_C, algebraMap_eq]

private theorem chartSubst_X_inl (k : Fin m) :
    chartSubst R m n i (X (Sum.inl k)) = X (Sum.inl k) := by
  rw [chartSubst, aeval_X]; rfl

private theorem chartSubst_X_pivot :
    chartSubst R m n i (X (Sum.inr i)) = X (Sum.inr (Sum.inl ())) := by
  rw [chartSubst, aeval_X]
  simp [chartRatio]

private theorem chartSubst_X_ratio {j : Fin n} (h : j ≠ i) :
    chartSubst R m n i (X (Sum.inr j)) =
      X (Sum.inr (Sum.inl ())) * X (Sum.inr (Sum.inr ⟨j, h⟩)) := by
  rw [chartSubst, aeval_X]
  simp [chartRatio, h]

/-- The substitution `y_j ↦ u t_j`, followed by the localization inverting `u`. -/
private noncomputable def chartRetractHom :
    MvPolynomial (Fin m ⊕ Fin n) R →+* chartTarget R m n i :=
  (algebraMap (MvPolynomial (coordinateChartVariables m n i) R)
    (chartTarget R m n i)).comp (chartSubst R m n i).toRingHom

private theorem chartRetractHom_apply (p : MvPolynomial (Fin m ⊕ Fin n) R) :
    chartRetractHom R m n i p = algebraMap _ _ (chartSubst R m n i p) := rfl

private theorem isUnit_chartRetractHom
    (y : Submonoid.powers (X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin n) R)) :
    IsUnit (chartRetractHom R m n i (y : MvPolynomial (Fin m ⊕ Fin n) R)) := by
  obtain ⟨k, hk⟩ := y.2
  have hu : IsUnit (chartRetractHom R m n i (X (Sum.inr i))) := by
    rw [chartRetractHom_apply, chartSubst_X_pivot]
    exact IsLocalization.Away.algebraMap_isUnit _
  rw [← hk, map_pow]
  exact IsUnit.pow k hu

/-- The retraction of `A_{y_i}` to the localization of the chart's polynomial ring at the pivot,
induced by the substitution `y_j ↦ u t_j`. -/
private noncomputable def chartRetract :
    Localization.Away (X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin n) R) →+*
      chartTarget R m n i :=
  IsLocalization.lift (isUnit_chartRetractHom R m n i)

private theorem chartRetract_algebraMap (p : MvPolynomial (Fin m ⊕ Fin n) R) :
    chartRetract R m n i (algebraMap _ _ p) = algebraMap _ _ (chartSubst R m n i p) :=
  IsLocalization.lift_eq _ _

/-- The retraction undoes the comparison map: the composite is the localization map of the
chart's polynomial ring at the pivot. -/
private theorem chartRetract_chartHom (p : MvPolynomial (coordinateChartVariables m n i) R) :
    chartRetract R m n i (chartHom R m n i p) = algebraMap _ _ p := by
  have h : (chartRetract R m n i).comp (chartHom R m n i).toRingHom =
      algebraMap (MvPolynomial (coordinateChartVariables m n i) R) (chartTarget R m n i) := by
    refine MvPolynomial.ringHom_ext (fun r ↦ ?_) fun v ↦ ?_
    all_goals rw [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    · rw [chartHom_C, chartRetract_algebraMap, chartSubst_C]
    · obtain k | j | j := v
      · rw [chartHom_X_inl, chartRetract_algebraMap, chartSubst_X_inl]
      · obtain ⟨⟩ := j
        rw [chartHom_X_pivot, chartRetract_algebraMap, chartSubst_X_pivot]
      · rw [chartHom_X_ratio, chartRetract, IsLocalization.lift_mk'_spec,
          chartRetractHom_apply, chartRetractHom_apply, chartSubst_X_ratio R m n i j.2,
          chartSubst_X_pivot, map_mul]
  exact RingHom.congr_fun h p

/-- The pivot variable is a non-zero-divisor in the chart's polynomial ring, over an arbitrary
commutative ring. -/
private theorem chartPivot_mem_nonZeroDivisors :
    (X (Sum.inr (Sum.inl ())) : MvPolynomial (coordinateChartVariables m n i) R) ∈
      nonZeroDivisors (MvPolynomial (coordinateChartVariables m n i) R) := by
  have key : ∀ p : MvPolynomial (coordinateChartVariables m n i) R,
      p * X (Sum.inr (Sum.inl ())) = 0 → p = 0 := by
    intro p hp
    ext d
    have h := congrArg (fun q ↦ q.coeff (d + Finsupp.single (Sum.inr (Sum.inl ())) 1)) hp
    simpa only [coeff_mul_X, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply] using h
  rw [mem_nonZeroDivisors_iff]
  exact ⟨fun p hp ↦ key p (by rwa [mul_comm]), key⟩

private theorem chartHom_injective : Function.Injective (chartHom R m n i) := by
  have hinj : Function.Injective
      (algebraMap (MvPolynomial (coordinateChartVariables m n i) R) (chartTarget R m n i)) :=
    IsLocalization.injective _
      (Submonoid.powers_le.2 (chartPivot_mem_nonZeroDivisors R m n i))
  intro p q hpq
  refine hinj ?_
  rw [← chartRetract_chartHom R m n i p, ← chartRetract_chartHom R m n i q, hpq]

/-! ### The comparison map is onto the chart -/

private theorem chartHom_X_mem (v : coordinateChartVariables m n i) :
    chartHom R m n i (X v) ∈ coordinateChartAlgebra R m n i := by
  obtain k | j | j := v
  · rw [chartHom_X_inl]
    exact Subalgebra.algebraMap_mem _ _
  · obtain ⟨⟩ := j
    rw [chartHom_X_pivot]
    exact Subalgebra.algebraMap_mem _ _
  · rw [chartHom_X_ratio]
    exact Algebra.subset_adjoin ⟨X (Sum.inr j.1), X_inr_mem_coordinateRingIdeal R m n j.1, rfl⟩

private theorem chartHom_mem (p : MvPolynomial (coordinateChartVariables m n i) R) :
    chartHom R m n i p ∈ coordinateChartAlgebra R m n i := by
  induction p using MvPolynomial.induction_on with
  | C r => rw [chartHom_C]; exact Subalgebra.algebraMap_mem _ _
  | add p q hp hq => rw [map_add]; exact add_mem hp hq
  | mul_X p v hp => rw [map_mul]; exact mul_mem hp (chartHom_X_mem R m n i v)

private theorem algebraMap_mem_range_chartHom (p : MvPolynomial (Fin m ⊕ Fin n) R) :
    algebraMap _ (Localization.Away (X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin n) R)) p ∈
      (chartHom R m n i).range := by
  induction p using MvPolynomial.induction_on with
  | C r => exact ⟨C r, chartHom_C R m n i r⟩
  | add p q hp hq => rw [map_add]; exact add_mem hp hq
  | mul_X p v hp =>
    rw [map_mul]
    refine mul_mem hp ?_
    obtain k | j := v
    · exact ⟨X (Sum.inl k), chartHom_X_inl R m n i k⟩
    · rcases eq_or_ne j i with rfl | hj
      · exact ⟨X (Sum.inr (Sum.inl ())), chartHom_X_pivot R m n j⟩
      · refine ⟨X (Sum.inr (Sum.inl ())) * X (Sum.inr (Sum.inr ⟨j, hj⟩)), ?_⟩
        exact chartHom_pivot_mul_ratio R m n i hj

private theorem mk'_mem_range_chartHom {y : MvPolynomial (Fin m ⊕ Fin n) R}
    (hy : y ∈ coordinateRingIdeal R m n) :
    IsLocalization.mk' (Localization.Away (X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin n) R)) y
        ⟨X (Sum.inr i), Submonoid.mem_powers _⟩ ∈ (chartHom R m n i).range := by
  obtain ⟨c, hc⟩ := (mem_coordinateRingIdeal_iff R m n).1 hy
  have key : IsLocalization.mk'
        (Localization.Away (X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin n) R)) y
        ⟨X (Sum.inr i), Submonoid.mem_powers _⟩ =
      ∑ j, algebraMap _ _ (c j) *
        IsLocalization.mk' _ (X (Sum.inr j) : MvPolynomial (Fin m ⊕ Fin n) R)
          ⟨X (Sum.inr i), Submonoid.mem_powers _⟩ := by
    rw [IsLocalization.mk'_eq_iff_eq_mul, Finset.sum_mul, ← hc, map_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [map_mul, mul_assoc, IsLocalization.mk'_spec]
  rw [key]
  refine sum_mem fun j _ ↦ mul_mem (algebraMap_mem_range_chartHom R m n i (c j)) ?_
  rcases eq_or_ne j i with rfl | hj
  · refine ⟨1, ?_⟩
    rw [map_one]
    exact (IsLocalization.mk'_self _ (Submonoid.mem_powers _)).symm
  · exact ⟨X (Sum.inr (Sum.inr ⟨j, hj⟩)), chartHom_X_ratio R m n i ⟨j, hj⟩⟩

private theorem mem_range_chartHom_of_mem
    {z : Localization.Away (X (Sum.inr i) : MvPolynomial (Fin m ⊕ Fin n) R)}
    (hz : z ∈ coordinateChartAlgebra R m n i) : z ∈ (chartHom R m n i).range := by
  induction hz using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨y, hy, rfl⟩ := hx
    exact mk'_mem_range_chartHom R m n i hy
  | algebraMap x => exact algebraMap_mem_range_chartHom R m n i x
  | add x y _ _ hx hy => exact add_mem hx hy
  | mul x y _ _ hx hy => exact mul_mem hx hy

/-- The comparison map, restricted to the chart it is onto. -/
private noncomputable def chartRingHom :
    MvPolynomial (coordinateChartVariables m n i) R →+* coordinateChartAlgebra R m n i :=
  RingHom.codRestrict (chartHom R m n i).toRingHom (coordinateChartAlgebra R m n i)
    (chartHom_mem R m n i)

private theorem chartRingHom_bijective : Function.Bijective (chartRingHom R m n i) := by
  refine ⟨fun p q hpq ↦ chartHom_injective R m n i (congrArg Subtype.val hpq), fun z ↦ ?_⟩
  obtain ⟨q, hq⟩ := mem_range_chartHom_of_mem R m n i z.2
  exact ⟨q, Subtype.ext hq⟩

/-- The `i`-th standard blowup chart is polynomial affine space, with its original coordinates
given by `x_k`, `y_i`, and `y_j = y_i t_j`. -/
@[stacks 0H1H "polynomial affine blowup charts"]
public theorem coordinateChart_equiv_polynomial :
    ∃ e : coordinateChartAlgebra R m n i ≃+*
        MvPolynomial (coordinateChartVariables m n i) R,
      (∀ r : R,
        e (algebraMap R (coordinateChartAlgebra R m n i) r) = C r) ∧
      (∀ k : Fin m,
        e (algebraMap (MvPolynomial (Fin m ⊕ Fin n) R)
          (coordinateChartAlgebra R m n i) (X (Sum.inl k))) = X (Sum.inl k)) ∧
      (e (algebraMap (MvPolynomial (Fin m ⊕ Fin n) R)
          (coordinateChartAlgebra R m n i) (X (Sum.inr i))) = X (Sum.inr (Sum.inl ()))) ∧
      (∀ j : Fin n, ∀ h : j ≠ i,
        e (algebraMap (MvPolynomial (Fin m ⊕ Fin n) R)
          (coordinateChartAlgebra R m n i) (X (Sum.inr j))) =
          X (Sum.inr (Sum.inl ())) * X (Sum.inr (Sum.inr ⟨j, h⟩))) := by
  have key : ∀ q (z : coordinateChartAlgebra R m n i), (z : Localization.Away _) =
      chartHom R m n i q → (RingEquiv.ofBijective _ (chartRingHom_bijective R m n i)).symm z = q :=
    fun q z h ↦ (RingEquiv.symm_apply_eq _).2 (Subtype.ext h)
  refine ⟨(RingEquiv.ofBijective _ (chartRingHom_bijective R m n i)).symm, fun r ↦ key _ _ ?_,
    fun k ↦ key _ _ (chartHom_X_inl R m n i k).symm, key _ _ (chartHom_X_pivot R m n i).symm,
    fun j h ↦ key _ _ (chartHom_pivot_mul_ratio R m n i h).symm⟩
  rw [chartHom_C, IsScalarTower.algebraMap_apply R (MvPolynomial (Fin m ⊕ Fin n) R)
    (coordinateChartAlgebra R m n i)]
  rfl

end Chart

/-- On the `i`-th affine chart, the exceptional ideal is generated by the single coordinate
`y_i`. -/
@[stacks 0H1H "equation of the exceptional divisor in each chart"]
public theorem coordinateChart_exceptionalIdeal (i : Fin n) :
    Ideal.map (algebraMap (MvPolynomial (Fin m ⊕ Fin n) R) (coordinateChartAlgebra R m n i))
        (coordinateRingIdeal R m n) =
      Ideal.span {(algebraMap (MvPolynomial (Fin m ⊕ Fin n) R) (coordinateChartAlgebra R m n i)
        (X (Sum.inr i)))} := by
  refine le_antisymm ?_ ?_
  · rw [Ideal.map_le_iff_le_comap]
    intro y hy
    rw [Ideal.mem_comap, Ideal.mem_span_singleton]
    refine ⟨⟨IsLocalization.mk' _ y ⟨X (Sum.inr i), Submonoid.mem_powers _⟩,
      Algebra.subset_adjoin ⟨y, hy, rfl⟩⟩, Subtype.ext ?_⟩
    change algebraMap _ (Localization.Away _) y =
      algebraMap _ _ (X (Sum.inr i)) * IsLocalization.mk' _ y _
    simp [IsLocalization.mk'_spec' _ y ⟨X (Sum.inr i), Submonoid.mem_powers _⟩]
  · rw [Ideal.span_le]
    rintro _ rfl
    exact Ideal.mem_map_of_mem _ (X_inr_mem_coordinateRingIdeal R m n i)

end Stacks.MoreMorphisms

end
