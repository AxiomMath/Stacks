module

public import Mathlib.AlgebraicGeometry.Limits
public import Mathlib.AlgebraicGeometry.Morphisms.Integral
public import Mathlib.AlgebraicGeometry.Morphisms.QuasiCompact
public import Mathlib.AlgebraicGeometry.Normalization
public import StacksCore.Tactic.StacksAttribute

/-!
# Extending a surjective integral morphism from an open subscheme

A surjective integral morphism over a quasi-compact open subscheme `U` of a scheme `S` extends
to a surjective integral morphism over `S` whose base change along `U ↪ S` recovers the original
morphism. This is the geometric input needed to refine an fppf covering of `S` by a covering
coming from a single integral surjective morphism.

## Main results

* `AlgebraicGeometry.exists_integral_surjective_extension`: the extension exists, and the
  original morphism is recovered by base change along the open immersion.

## Implementation notes

The extension is the coproduct of the normalization of `V ⟶ U ↪ S` with the reduced closed
subscheme structure on the closed complement of `U`. The first summand is integral over `S` by
construction and covers `U`; the second covers the complement. That the base change of the
coproduct along `U ↪ S` is the given morphism uses the compatibility of normalization with
smooth base change, applied to the open immersion `U ↪ S`.

The isomorphism recovering the original morphism is stated in the category of schemes over `U`,
so it carries the compatibility with the structure maps to `U` and not merely an isomorphism of
underlying schemes.

Tag 0CNX is stated for an arbitrary open subscheme, and its proof goes through the relative
normalization of `S` in `V`, which Stacks (Tag 0BAK) and Mathlib alike define only for a
quasi-compact and quasi-separated morphism. Both
`AlgebraicGeometry.Scheme.Hom.fromNormalization_preimage` and the base-change comparison
`AlgebraicGeometry.Scheme.Hom.normalizationPullback` carry those hypotheses, and `V ⟶ S` is
quasi-compact exactly when `U` is retrocompact in `S`, so the statement below assumes
`[QuasiCompact U.ι]`.

The hypothesis cannot be dropped: the unrestricted statement of Tag 0CNX is false. An integral
`a : A ⟶ S` is affine, so for affine `S = Spec R` an extension of `f` is exactly a quasi-coherent
integral `O_S`-algebra restricting
on `U` to `f_* O_V`; and a quasi-coherent sheaf on an open subscheme of an affine scheme which
is the restriction of a quasi-coherent sheaf on that affine scheme is generated by its global
sections. Now take `R = ∏ (n : ℕ), ℤ` with `f = (2, 2, …)` and `eₙ` the standard idempotents,
and `U = D(f) ∪ ⋃ n, D(eₙ)`; this `U` is not quasi-compact, because `D(eₘ)` is disjoint from
`D(eₙ)` for `n ≠ m` and is not contained in `D(f)`. Let `I` be the invertible ideal sheaf on `U`
equal to `O` on `D(f)` and to `2 ^ n • ℤ` on `D(eₙ)` — consistent, since `2` is invertible on
`D(f * eₙ)` and the `D(eₙ)` are pairwise disjoint — and let `V = Spec_U (O_U ⊕ I)` with `I`
square-zero, which is integral and surjective over `U`. Then `Γ(U, I) = ∏ n, 2 ^ n • ℤ`, and an
element of that divided by `2 ^ N` has `n`-th entry in `2 ^ (n - N) • ℤ`, so the submodule of
`Γ(D(f), I) = R_f` generated by `Γ(U, I)` omits `1`: `I` is not globally generated, and this `f`
extends to no integral `A ⟶ S`. This counterexample is
`AlgebraicGeometry.exists_isIntegralHom_surjective_not_baseChange`, and
`AlgebraicGeometry.not_forall_exists_integral_surjective_extension` is the negation of Tag 0CNX
for an arbitrary open subscheme. Both are declared in the module
`StacksFrontier.AlgebraicGeometry.MoreMorphisms.FppfApplication.IntegralExtensionCounterexampleMain`

## References

* [Stacks Project, Tag 0CNX](https://stacks.math.columbia.edu/tag/0CNX)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace AlgebraicGeometry

/-- **Stacks Project, Tag 0CNX**, in corrected form, with `U` retrocompact in `S`: a surjective
integral morphism over a retrocompact open subscheme extends to a surjective integral morphism
over the whole scheme, without changing its restriction to the open subscheme. The general
statement of [Stacks, Tag 0CNX] is false;
`AlgebraicGeometry.exists_integral_surjective_extension_and_not_forall` pairs this theorem with
the failure of the statement for an arbitrary open subscheme. -/
@[stacks 0CNX "a surjective integral morphism over a retrocompact open of S extends to a \
  surjective integral morphism over S with the same restriction to the open"]
theorem exists_integral_surjective_extension
    {S : Scheme.{u}} (U : S.Opens) [QuasiCompact U.ι]
    {V : Scheme.{u}} (f : V ⟶ U.toScheme) [IsIntegralHom f] [Surjective f] :
    ∃ (W : Scheme.{u}) (g : W ⟶ S),
      IsIntegralHom g ∧ Surjective g ∧
        Nonempty (Over.mk f ≅ (Over.pullback U.ι).obj (Over.mk g)) := by
  let : MorphismProperty.RespectsIso @IsIntegralHom :=
    MorphismProperty.IsStableUnderBaseChange.respectsIso
  let q : V ⟶ S := f ≫ U.ι
  have hqCompact : QuasiCompact q := by infer_instance
  have hqSeparated : QuasiSeparated q := by infer_instance
  let T : Closeds S := ⟨(U : Set S)ᶜ, U.2.isClosed_compl⟩
  let I := Scheme.IdealSheafData.vanishingIdeal T
  let zι : I.subscheme ⟶ S := I.subschemeι
  have hzRange : Set.range zι = (U : Set S)ᶜ := by
    rw [Scheme.IdealSheafData.range_subschemeι,
      Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  let W := q.normalization ⨿ I.subscheme
  let g : W ⟶ S := coprod.desc q.fromNormalization zι
  have hgIntegral : IsIntegralHom g := by infer_instance
  have hgSurjective : Surjective g := by
    refine ⟨fun s => ?_⟩
    by_cases hs : s ∈ (U : Set S)
    · obtain ⟨v, hv⟩ := f.surjective ⟨s, hs⟩
      refine ⟨(coprod.inl : q.normalization ⟶ W) (q.toNormalization v), ?_⟩
      change coprod.desc q.fromNormalization zι
        ((coprod.inl : q.normalization ⟶ W) (q.toNormalization v)) = s
      rw [← Scheme.Hom.comp_apply, coprod.inl_desc, ← Scheme.Hom.comp_apply,
        Scheme.Hom.toNormalization_fromNormalization]
      change (f ≫ U.ι) v = s
      rw [Scheme.Hom.comp_apply, hv]
      rfl
    · obtain ⟨z, hz⟩ : s ∈ Set.range zι := by rwa [hzRange]
      refine ⟨(coprod.inr : I.subscheme ⟶ W) z, ?_⟩
      change coprod.desc q.fromNormalization zι ((coprod.inr : I.subscheme ⟶ W) z) = s
      rwa [← Scheme.Hom.comp_apply, coprod.inr_desc]
  let Q : q.normalization.Opens := q.fromNormalization ⁻¹ᵁ U
  let j : Q.toScheme ⟶ W := Q.ι ≫ (coprod.inl : q.normalization ⟶ W)
  have hcomm : j ≫ g = q.fromNormalization.resLE U Q (by simp [Q]) ≫ U.ι := by
    simp only [j, g, Category.assoc, coprod.inl_desc, Scheme.Hom.resLE_comp_ι]
  have hjRange : g ⁻¹ᵁ Scheme.Hom.opensRange U.ι = j.opensRange := by
    ext x
    change g x ∈ Set.range U.ι ↔ x ∈ Set.range j
    constructor
    · intro hx
      obtain ⟨a, rfl⟩ := (coprodMk _ _).surjective x
      cases a with
      | inl a =>
          rw [coprodMk_inl] at hx
          have hxU : q.fromNormalization a ∈ U := by
            have hx' : g ((coprod.inl : q.normalization ⟶ W) a) ∈ (U : Set S) := by
              simpa using hx
            change (coprod.desc q.fromNormalization zι)
              ((coprod.inl : q.normalization ⟶ W) a) ∈ (U : Set S) at hx'
            rwa [← Scheme.Hom.comp_apply, coprod.inl_desc] at hx'
          refine ⟨⟨a, hxU⟩, ?_⟩
          rw [coprodMk_inl]
          change (coprod.inl : q.normalization ⟶ W) (Q.ι ⟨a, hxU⟩) =
            (coprod.inl : q.normalization ⟶ W) a
          rw [Scheme.Opens.ι_apply]
      | inr z =>
          rw [coprodMk_inr] at hx
          have hxU : zι z ∈ U := by
            have hx' : g ((coprod.inr : I.subscheme ⟶ W) z) ∈ (U : Set S) := by
              simpa using hx
            change (coprod.desc q.fromNormalization zι)
              ((coprod.inr : I.subscheme ⟶ W) z) ∈ (U : Set S) at hx'
            rwa [← Scheme.Hom.comp_apply, coprod.inr_desc] at hx'
          have hz' : zι z ∈ (U : Set S)ᶜ := by
            rw [← hzRange]
            exact ⟨z, rfl⟩
          exact (hz' hxU).elim
    · rintro ⟨y, rfl⟩
      change g ((Q.ι ≫ (coprod.inl : q.normalization ⟶ W)) y) ∈ Set.range U.ι
      rw [← Scheme.Hom.comp_apply, hcomm]
      exact ⟨q.fromNormalization.resLE U Q (by simp [Q]) y, rfl⟩
  have hQPullback : IsPullback (q.fromNormalization.resLE U Q (by simp [Q])) j U.ι g :=
    IsOpenImmersion.isPullback _ _ _ _ hcomm hjRange
  let qPullIso := hQPullback.flip.isoPullback
  have hfPullback : IsPullback f (𝟙 V) U.ι q := by
    apply IsOpenImmersion.isPullback
    · simp [q]
    · ext x
      simp [q]
  let fPullIso := hfPullback.flip.isoPullback
  have hPullIntegral : IsIntegralHom (pullback.snd q U.ι) := by
    apply (MorphismProperty.cancel_left_of_respectsIso @IsIntegralHom fPullIso.hom _).mp
    rw [hfPullback.flip.isoPullback_hom_snd]
    infer_instance
  have hSmooth : Smooth U.ι := inferInstance
  have hNormPullIso : IsIso (q.normalizationPullback U.ι) := inferInstance
  let pNormIso := asIso (Scheme.Hom.toNormalization (pullback.snd q U.ι))
  let normBaseIso := asIso (q.normalizationPullback U.ι)
  let qRestr : Q.toScheme ⟶ U.toScheme :=
    q.fromNormalization.resLE U Q (by simp [Q])
  have hQBase : IsPullback qRestr Q.ι U.ι q.fromNormalization := by
    apply IsOpenImmersion.isPullback
    · simp [Q, qRestr, Scheme.Hom.resLE_comp_ι]
    · ext x
      simp [Q]
  let qRestrIso := hQBase.flip.isoPullback
  have hqRestrIso : qRestrIso.inv ≫ qRestr = pullback.snd q.fromNormalization U.ι := by
    rw [← hQBase.flip.isoPullback_hom_snd]
    simp [qRestrIso]
  let e : V ≅ Q.toScheme :=
    fPullIso ≪≫ pNormIso ≪≫ normBaseIso ≪≫ qRestrIso.symm
  have he : e.hom ≫ qRestr = f := by
    calc
      e.hom ≫ qRestr =
          fPullIso.hom ≫ pNormIso.hom ≫ normBaseIso.hom ≫
            (qRestrIso.inv ≫ qRestr) := by simp [e, Category.assoc]
      _ = fPullIso.hom ≫ pNormIso.hom ≫ normBaseIso.hom ≫
          pullback.snd q.fromNormalization U.ι := by rw [hqRestrIso]
      _ = f := by
        change fPullIso.hom ≫ Scheme.Hom.toNormalization (pullback.snd q U.ι) ≫
          Scheme.Hom.normalizationPullback q U.ι ≫ pullback.snd q.fromNormalization U.ι = f
        rw [← Category.assoc, Scheme.Hom.normalizationPullback_snd,
          Category.assoc, Scheme.Hom.toNormalization_fromNormalization,
          hfPullback.flip.isoPullback_hom_snd]
  refine ⟨W, g, hgIntegral, hgSurjective, ⟨Over.isoMk (e.trans qPullIso) ?_⟩⟩
  dsimp [qPullIso]
  rw [Category.assoc, hQPullback.flip.isoPullback_hom_snd, he]

end AlgebraicGeometry

end
