module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularIdealSheaf.StalkEquivalence
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularIdealSheaf.UnitMultiple
public import StacksFrontier.RingTheory.Sequence.Regular.Basic

/-!
# Spreading a regular sequence out of a local ring onto an affine open

Let `X` be a locally Noetherian scheme, let `J` be a quasi-coherent sheaf of ideals and let `x`
be a point of the support of `O_X / J` at which the ideal cut out in the local ring is generated
by a regular sequence.  Then some affine open neighbourhood of `x` carries a regular sequence of
sections generating the ideal of `J` there.

This is the implication `(1) ⇒ (5)` of Stacks tag 063I, and the only one of its twelve conditions
that is not reached from the others by a formal argument.  Two spreading-out steps are involved.
First the generators of the stalk ideal are fractions, so after multiplying by their denominators
— units of the local ring — they become germs of sections over an affine open `W`; they then
generate the stalk ideal, but only generate the ideal of `J` over `W` after `W` is shrunk, and the
element of `Γ(X, W)` to shrink by exists because the ideal of `J` over `W` is finitely generated.
Second, regularity of the germs is regularity of the sections only after a further shrinking, and
that is Stacks tag 061L.

## Main results

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_mem_forall_mul_mem`: a single element of the
localizing
  submonoid witnesses an inclusion of ideals that holds after localization.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.map_le_map_of_forall_mul_mem`: its converse.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_affineOpen_span_eq_ideal_isRegular_germ`: an
affine
  open on which `J` is generated by sections whose germs at `x` are a regular sequence.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_affineOpen_span_eq_ideal_isRegular`: the
implication
  `(1) ⇒ (5)`.

## Implementation notes

Stacks tag 061L is stated for the localizations `Localization.AtPrime` and `Localization.Away`
and for the module `LocalizedModule`, whereas the localizations at hand are the stalk and the
sections over a basic open.  The two are compared by
`RingTheory.Sequence.isWeaklyRegular_map_algebraMap_iff` and
`Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegular_map_algebraMap_iff`, which turn regularity of
the
image sequence over the localization into regularity of the original sequence acting through the
ring of sections, together with `IsLocalizedModule.linearEquiv`, which identifies any two
localizations of that ring as modules over it.

The properness clause of regularity over the final affine open is not transported: it is the
statement that the ideal of `J` there is proper, which holds because the point lies in the
support.

## References

* [Stacks Project, Lemma 31.20.6 (Tag 063I)](https://stacks.math.columbia.edu/tag/063I)
* [Stacks Project, Lemma 10.68.6 (Tag 061L)](https://stacks.math.columbia.edu/tag/061L)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace RingTheory.Sequence

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

section Localization

variable {A : Type*} [CommRing A] {M : Submonoid A} (S : Type*) [CommRing S] [Algebra A S]
  [IsLocalization M S]

/-- **A uniform multiplier.**  If an ideal of a Noetherian ring is carried into another one by the
extension to a localization, then a single element of the localizing submonoid already multiplies
it into that one. -/
theorem exists_mem_forall_mul_mem [IsNoetherianRing A] {I K : Ideal A}
    (h : I.map (algebraMap A S) ≤ K.map (algebraMap A S)) :
    ∃ c ∈ M, ∀ y ∈ I, c * y ∈ K := by
  have hpt : ∀ y ∈ I, ∃ c ∈ M, c * y ∈ K := fun y hyI =>
    (IsLocalization.algebraMap_mem_map_algebraMap_iff M S K y).mp
      (h (Ideal.mem_map_of_mem _ hyI))
  obtain ⟨T, hT⟩ := IsNoetherian.noetherian I
  choose! d hd hdK using hpt
  have hTI : ∀ y ∈ T, y ∈ I := fun y hyT => hT ▸ Ideal.subset_span hyT
  refine ⟨∏ y ∈ T, d y, Submonoid.prod_mem _ fun y hyT => hd y (hTI y hyT), fun z hz => ?_⟩
  have hsub : I ≤ Submodule.comap (LinearMap.lsmul A A (∏ y ∈ T, d y)) K := by
    rw [← hT]
    refine Ideal.span_le.mpr fun y hyT => ?_
    obtain ⟨w, hw⟩ := Finset.dvd_prod_of_mem d hyT
    refine Submodule.mem_comap.mpr ?_
    simp only [LinearMap.lsmul_apply, smul_eq_mul, hw]
    rw [mul_comm (d y) w, mul_assoc]
    exact K.mul_mem_left w (hdK y (hTI y hyT))
  simpa only [Submodule.mem_comap, LinearMap.lsmul_apply, smul_eq_mul] using hsub hz

end Localization

/-- An ideal extended to an algebra is contained in the extension of a second ideal as soon as
some element that becomes a unit multiplies the first into the second. -/
theorem map_le_map_of_forall_mul_mem {A : Type*} [CommRing A] (S : Type*) [CommRing S]
    [Algebra A S] {I K : Ideal A} {c : A} (hc : IsUnit (algebraMap A S c))
    (h : ∀ y ∈ I, c * y ∈ K) :
    I.map (algebraMap A S) ≤ K.map (algebraMap A S) := by
  rw [Ideal.map_le_iff_le_comap]
  intro y hy
  refine Ideal.mem_comap.mpr ((Ideal.unit_mul_mem_iff_mem _ hc).mp ?_)
  have hmem := Ideal.mem_map_of_mem (algebraMap A S) (h y hy)
  rwa [map_mul] at hmem

variable {X : Scheme.{u}}

/-- An element of `Γ(X, U)` that is a unit in the stalk at `x` is nonvanishing on a neighbourhood
of `x`. -/
private theorem mem_basicOpen_of_mem_primeCompl {U : X.affineOpens} {x : X} (hxU : x ∈ U.1)
    {e : Γ(X, U.1)} (he : e ∈ (U.2.primeIdealOf (⟨x, hxU⟩ : U.1)).asIdeal.primeCompl) :
    x ∈ X.basicOpen e := by
  let _ := X.presheaf.algebra_section_stalk (⟨x, hxU⟩ : U.1)
  have _ := U.2.isLocalization_stalk (⟨x, hxU⟩ : U.1)
  have _ : (U.2.primeIdealOf (⟨x, hxU⟩ : U.1)).asIdeal.IsPrime :=
    (U.2.primeIdealOf (⟨x, hxU⟩ : U.1)).isPrime
  refine (X.mem_basicOpen e x hxU).mpr ?_
  have hu : IsUnit (algebraMap Γ(X, U.1) (X.presheaf.stalk x) e) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff (X.presheaf.stalk x) _ e).mpr he
  rwa [show (algebraMap Γ(X, U.1) (X.presheaf.stalk x)) = (X.presheaf.germ U.1 x hxU).hom from
    RingHom.algebraMap_toAlgebra _] at hu

/-- The ideal of `J` over a basic open of an affine open is the extension of its ideal over the
affine open. -/
private theorem map_ideal_algebraMap_basicOpen (J : X.IdealSheafData) (U : X.affineOpens)
    (e : Γ(X, U.1)) :
    (J.ideal U).map (algebraMap Γ(X, U.1) Γ(X, X.basicOpen e)) =
      J.ideal ⟨X.basicOpen e, U.2.basicOpen e⟩ := by
  rw [show (algebraMap Γ(X, U.1) Γ(X, X.basicOpen e)) =
    (X.presheaf.map (homOfLE (X.basicOpen_le e)).op).hom from RingHom.algebraMap_toAlgebra _]
  exact J.map_ideal (U := ⟨X.basicOpen e, U.2.basicOpen e⟩) (V := U) (X.basicOpen_le e)

/-- **Lifting generators of the stalk ideal to an affine open.**  On a locally Noetherian scheme,
if the ideal that a quasi-coherent sheaf of ideals cuts out in the local ring at a point of the
support is generated by a regular sequence, then some affine open neighbourhood carries sections
generating the ideal of the sheaf there whose germs at the point are a regular sequence. -/
theorem exists_affineOpen_span_eq_ideal_isRegular_germ [IsLocallyNoetherian X]
    (J : X.IdealSheafData) (x : X) (hx : x ∈ J.support) {r : ℕ} (g : Fin r → X.presheaf.stalk x)
    (hspan : stalkIdeal J x hx = Ideal.span (Set.range g))
    (hreg : IsRegular (X.presheaf.stalk x) (List.ofFn g)) :
    ∃ (W : X.affineOpens) (hxW : x ∈ W.1) (a : Fin r → Γ(X, W.1)),
      J.ideal W = Ideal.span (Set.range a) ∧
        IsRegular (X.presheaf.stalk x)
          (List.ofFn fun i => X.presheaf.germ W.1 x hxW (a i)) := by
  obtain ⟨W₀, hW₀, hxW₀, -⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
    (show x ∈ (⊤ : X.Opens) from trivial)
  have hnoeth : IsNoetherianRing Γ(X, W₀) := IsLocallyNoetherian.component_noetherian ⟨W₀, hW₀⟩
  let _ := X.presheaf.algebra_section_stalk (⟨x, hxW₀⟩ : W₀)
  have _ := hW₀.isLocalization_stalk (⟨x, hxW₀⟩ : W₀)
  set p := (hW₀.primeIdealOf (⟨x, hxW₀⟩ : W₀)).asIdeal with hp
  have _ : p.IsPrime := (hW₀.primeIdealOf (⟨x, hxW₀⟩ : W₀)).isPrime
  have halg : (algebraMap Γ(X, W₀) (X.presheaf.stalk x)) =
      (X.presheaf.germ W₀ x hxW₀).hom := RingHom.algebraMap_toAlgebra _
  set I := J.ideal ⟨W₀, hW₀⟩ with hI
  have hIst : stalkIdeal J x hx = I.map (algebraMap Γ(X, W₀) (X.presheaf.stalk x)) := by
    rw [halg]; exact stalkIdeal_eq_map_germ J x hx hW₀ hxW₀
  -- lift each generator to a section, at the cost of a unit factor
  have hlift : ∀ i, ∃ (b : Γ(X, W₀)) (c : X.presheaf.stalk x), b ∈ I ∧ IsUnit c ∧
      algebraMap Γ(X, W₀) (X.presheaf.stalk x) b = c * g i := by
    intro i
    obtain ⟨⟨y, s⟩, hys0⟩ := IsLocalization.mk'_surjective p.primeCompl (g i)
    have hys : IsLocalization.mk' (X.presheaf.stalk x) y s = g i := hys0
    have hmem : IsLocalization.mk' (X.presheaf.stalk x) y s ∈
        I.map (algebraMap Γ(X, W₀) (X.presheaf.stalk x)) := by
      rw [hys, ← hIst, hspan]
      exact Ideal.subset_span (Set.mem_range_self i)
    obtain ⟨m, hm, hmy⟩ :=
      (IsLocalization.mk'_mem_map_algebraMap_iff p.primeCompl (X.presheaf.stalk x) I y s).mp hmem
    refine ⟨m * y, algebraMap Γ(X, W₀) (X.presheaf.stalk x) m *
      algebraMap Γ(X, W₀) (X.presheaf.stalk x) (s : Γ(X, W₀)), hmy,
      (IsLocalization.map_units _ (⟨m, hm⟩ : p.primeCompl)).mul
        (IsLocalization.map_units _ s), ?_⟩
    rw [map_mul, ← hys, mul_assoc, IsLocalization.mk'_spec']
  choose b c hbI hcu hbc using hlift
  -- the lifted family generates the stalk ideal and is regular there
  have hspanb : Ideal.span (Set.range fun i => algebraMap Γ(X, W₀) (X.presheaf.stalk x) (b i)) =
      stalkIdeal J x hx := by
    rw [show (fun i => algebraMap Γ(X, W₀) (X.presheaf.stalk x) (b i)) =
      fun i => c i * g i from funext hbc, span_range_unit_mul hcu g, hspan]
  have hregb : IsRegular (X.presheaf.stalk x)
      (List.ofFn fun i => algebraMap Γ(X, W₀) (X.presheaf.stalk x) (b i)) := by
    refine ⟨?_, ?_⟩
    · rw [show (fun i => algebraMap Γ(X, W₀) (X.presheaf.stalk x) (b i)) =
        fun i => c i * g i from funext hbc]
      exact isWeaklyRegular_ofFn_unit_mul hcu g hreg.toIsWeaklyRegular
    · rw [Ideal.smul_eq_mul, Ideal.mul_top, ofList_ofFn_eq_span_range, hspanb, hspan]
      have hne := hreg.top_ne_smul
      rwa [Ideal.smul_eq_mul, Ideal.mul_top, ofList_ofFn_eq_span_range] at hne
  -- shrink so that the lifted family generates the ideal of `J`
  have hKI : Ideal.span (Set.range b) ≤ I := Ideal.span_le.mpr (by rintro y ⟨i, rfl⟩; exact hbI i)
  have hmapeq : I.map (algebraMap Γ(X, W₀) (X.presheaf.stalk x)) ≤
      (Ideal.span (Set.range b)).map (algebraMap Γ(X, W₀) (X.presheaf.stalk x)) := by
    rw [Ideal.map_span, ← Set.range_comp, ← hIst, ← hspanb]
    exact le_rfl
  obtain ⟨e, he, heI⟩ := exists_mem_forall_mul_mem (M := p.primeCompl) (X.presheaf.stalk x) hmapeq
  have _ := hW₀.isLocalization_basicOpen e
  have hxV : x ∈ X.basicOpen e :=
    mem_basicOpen_of_mem_primeCompl (U := ⟨W₀, hW₀⟩) hxW₀ he
  have hres : (algebraMap Γ(X, W₀) Γ(X, X.basicOpen e)) =
      (X.presheaf.map (homOfLE (X.basicOpen_le e)).op).hom := RingHom.algebraMap_toAlgebra _
  refine ⟨⟨X.basicOpen e, hW₀.basicOpen e⟩, hxV,
    fun i => algebraMap Γ(X, W₀) Γ(X, X.basicOpen e) (b i), ?_, ?_⟩
  · have hKmap : (Ideal.span (Set.range b)).map (algebraMap Γ(X, W₀) Γ(X, X.basicOpen e)) =
        Ideal.span (Set.range fun i => algebraMap Γ(X, W₀) Γ(X, X.basicOpen e) (b i)) := by
      rw [Ideal.map_span, ← Set.range_comp]; rfl
    rw [← hKmap, ← map_ideal_algebraMap_basicOpen J ⟨W₀, hW₀⟩ e, ← hI]
    refine le_antisymm (map_le_map_of_forall_mul_mem _ ?_ heI) (Ideal.map_mono hKI)
    exact IsLocalization.map_units (M := Submonoid.powers e) Γ(X, X.basicOpen e)
      (⟨e, Submonoid.mem_powers e⟩ : Submonoid.powers e)
  · have hgerm : (fun i => X.presheaf.germ (X.basicOpen e) x hxV
          (algebraMap Γ(X, W₀) Γ(X, X.basicOpen e) (b i))) =
        fun i => algebraMap Γ(X, W₀) (X.presheaf.stalk x) (b i) := by
      funext i
      rw [hres, halg]
      exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (X.basicOpen_le e)) x hxV (b i)
    rw [hgerm]
    exact hregb

/-- **Spreading regularity of the germs to an affine open.**  If a quasi-coherent sheaf of ideals
on a locally Noetherian scheme is generated over an affine open by sections whose germs at a point
of the support form a regular sequence in the local ring, then the sections themselves form a
regular sequence over some smaller affine open containing the point.

This is Stacks tag 061L, read on the scheme: the smaller open is a basic open, which is the
standard open that the source's spreading-out produces. -/
theorem exists_affineOpen_isRegular_of_isRegular_germ [IsLocallyNoetherian X]
    (J : X.IdealSheafData) (x : X) (hx : x ∈ J.support) (W : X.affineOpens) (hxW : x ∈ W.1)
    {r : ℕ} (a : Fin r → Γ(X, W.1)) (hgen : J.ideal W = Ideal.span (Set.range a))
    (hreg : IsRegular (X.presheaf.stalk x)
      (List.ofFn fun i => X.presheaf.germ W.1 x hxW (a i))) :
    ∃ (V : X.affineOpens) (_ : x ∈ V.1) (f : Fin r → Γ(X, V.1)),
      J.ideal V = Ideal.span (Set.range f) ∧ IsRegular Γ(X, V.1) (List.ofFn f) := by
  have hnoeth : IsNoetherianRing Γ(X, W.1) := IsLocallyNoetherian.component_noetherian W
  let _ := X.presheaf.algebra_section_stalk (⟨x, hxW⟩ : W.1)
  have _ := W.2.isLocalization_stalk (⟨x, hxW⟩ : W.1)
  set p := (W.2.primeIdealOf (⟨x, hxW⟩ : W.1)).asIdeal with hp
  have _ : p.IsPrime := (W.2.primeIdealOf (⟨x, hxW⟩ : W.1)).isPrime
  have halg : (algebraMap Γ(X, W.1) (X.presheaf.stalk x)) =
      (X.presheaf.germ W.1 x hxW).hom := RingHom.algebraMap_toAlgebra _
  -- the hypothesis of Stacks tag 061L, over the pinned localizations it is stated for
  have hregP : IsRegular (LocalizedModule p.primeCompl Γ(X, W.1))
      ((List.ofFn a).map (algebraMap Γ(X, W.1) (Localization.AtPrime p))) := by
    rw [isRegular_map_algebraMap_iff]
    refine ((IsLocalizedModule.linearEquiv p.primeCompl
      (Algebra.linearMap Γ(X, W.1) (X.presheaf.stalk x))
      (LocalizedModule.mkLinearMap p.primeCompl Γ(X, W.1))).isRegular_congr (List.ofFn a)).mp ?_
    rw [← isRegular_map_algebraMap_iff (S := X.presheaf.stalk x), List.map_ofFn]
    simpa only [Function.comp_def, halg] using hreg
  obtain ⟨g₀, hg₀, hg₀reg⟩ :=
    regular_sequence_localize_away_of_atPrime (M := Γ(X, W.1)) p (List.ofFn a) hregP
  have _ := W.2.isLocalization_basicOpen g₀
  have hxV : x ∈ X.basicOpen g₀ := mem_basicOpen_of_mem_primeCompl (U := W) hxW hg₀
  have hgenV : J.ideal ⟨X.basicOpen g₀, W.2.basicOpen g₀⟩ =
      Ideal.span (Set.range fun i => algebraMap Γ(X, W.1) Γ(X, X.basicOpen g₀) (a i)) := by
    rw [← map_ideal_algebraMap_basicOpen J W g₀, hgen, Ideal.map_span, ← Set.range_comp]
    rfl
  have hVne : J.ideal ⟨X.basicOpen g₀, W.2.basicOpen g₀⟩ ≠ ⊤ := by
    intro htop
    refine stalkIdeal_ne_top J x hx ?_
    rw [stalkIdeal_eq_map_germ J x hx (W.2.basicOpen g₀) hxV, htop, Ideal.map_top]
  have hlist : (List.ofFn fun i => algebraMap Γ(X, W.1) Γ(X, X.basicOpen g₀) (a i)) =
      (List.ofFn a).map (algebraMap Γ(X, W.1) Γ(X, X.basicOpen g₀)) := by
    simp only [List.map_ofFn, Function.comp_def]
  refine ⟨⟨X.basicOpen g₀, W.2.basicOpen g₀⟩, hxV,
    fun i => algebraMap Γ(X, W.1) Γ(X, X.basicOpen g₀) (a i), hgenV, ⟨?_, ?_⟩⟩
  · rw [hlist, isWeaklyRegular_map_algebraMap_iff]
    refine ((IsLocalizedModule.linearEquiv (Submonoid.powers g₀)
      (LocalizedModule.mkLinearMap (Submonoid.powers g₀) Γ(X, W.1))
      (Algebra.linearMap Γ(X, W.1) Γ(X, X.basicOpen g₀))).isWeaklyRegular_congr
        (List.ofFn a)).mp ?_
    rw [← isWeaklyRegular_map_algebraMap_iff (S := Localization.Away g₀)]
    exact hg₀reg.toIsWeaklyRegular
  · rw [Ideal.smul_eq_mul, Ideal.mul_top, ofList_ofFn_eq_span_range, ← hgenV]
    exact fun h => hVne h.symm

/-- **The implication `(1) ⇒ (5)` of Stacks tag 063I.**  On a locally Noetherian scheme, if the
ideal that a quasi-coherent sheaf of ideals cuts out in the local ring at a point of the support
is generated by a regular sequence, then the ideal of the sheaf over some affine open
neighbourhood is generated by a regular sequence of sections. -/
theorem exists_affineOpen_span_eq_ideal_isRegular [IsLocallyNoetherian X] (J : X.IdealSheafData)
    (x : X) (hx : x ∈ J.support) {r : ℕ} (g : Fin r → X.presheaf.stalk x)
    (hspan : stalkIdeal J x hx = Ideal.span (Set.range g))
    (hreg : IsRegular (X.presheaf.stalk x) (List.ofFn g)) :
    ∃ (U : X.affineOpens) (_ : x ∈ U.1) (s : ℕ) (f : Fin s → Γ(X, U.1)),
      J.ideal U = Ideal.span (Set.range f) ∧ IsRegular Γ(X, U.1) (List.ofFn f) := by
  obtain ⟨W, hxW, a, hgen, hregg⟩ :=
    exists_affineOpen_span_eq_ideal_isRegular_germ J x hx g hspan hreg
  obtain ⟨V, hxV, f, hgenV, hregV⟩ :=
    exists_affineOpen_isRegular_of_isRegular_germ J x hx W hxW a hgen hregg
  exact ⟨V, hxV, r, f, hgenV, hregV⟩

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
