module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularIdealSheaf.StalkEquivalence
public import StacksFrontier.RingTheory.Koszul.Regular

/-!
# From generators on an affine open to generators in the local ring

Let `X` be a scheme, let `J` be a quasi-coherent sheaf of ideals and let `U` be an affine open on
which the ideal `J(U)` is generated by a finite family `f`.  If `f` is a regular sequence in
`Γ(X, U)` then it is Koszul-regular, hence `H₁`-regular, hence quasi-regular there; and the germs
of a quasi-regular family at a point of `U` generate the ideal cut out in the local ring by a
quasi-regular sequence, because the germ map of an affine open is a localization and therefore
flat.

These are the implications `(5) ⇒ (6) ⇒ (7) ⇒ (8)` and `(8) ⇒ (4)` of Stacks tag 063I.  No
Noetherian hypothesis is needed for any of them.

## Main results

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isKoszulRegular_of_isRegular_section`,
  `Stacks.AlgebraicGeometry.RegularIdealSheaf.isH1Regular_of_isKoszulRegular_section` and
  `Stacks.AlgebraicGeometry.RegularIdealSheaf.isQuasiRegular_of_isH1Regular_section`: the chain of
  ring-theoretic implications in the ring of sections of the affine open.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.germ_flat`: the germ map of an affine open is flat.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_span_eq_stalkIdeal_isQuasiRegular_of_affine`:
the
  implication `(8) ⇒ (4)`.

## References

* [Stacks Project, Lemma 31.20.6 (Tag 063I)](https://stacks.math.columbia.edu/tag/063I)
* [Stacks Project, Lemma 15.30.2 (Tag 062F)](https://stacks.math.columbia.edu/tag/062F)
* [Stacks Project, Lemma 15.30.5 (Tag 062I)](https://stacks.math.columbia.edu/tag/062I)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace RingTheory.Sequence

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

variable {X : Scheme.{u}}

section RingLevel

variable {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)

/-- **A regular sequence is Koszul-regular.**  Stacks tag 062F, in the family form used by the
affine conditions of Stacks tag 063I. -/
theorem isKoszulRegular_of_isRegular_section (h : IsRegular R (List.ofFn f)) :
    Koszul.IsKoszulRegular f :=
  (Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular (M := R) (f := f)).2.2 h

/-- **A Koszul-regular sequence is `H₁`-regular.**  Only the degree-one part of the vanishing is
retained. -/
theorem isH1Regular_of_isKoszulRegular_section (h : Koszul.IsKoszulRegular f) :
    Koszul.IsH1Regular f :=
  h 1 one_ne_zero

/-- **An `H₁`-regular sequence is quasi-regular.**  Stacks tag 062I, in the family form used by
the affine conditions of Stacks tag 063I. -/
theorem isQuasiRegular_of_isH1Regular_section (h : Koszul.IsH1Regular f) :
    IsQuasiRegular R (List.ofFn f) :=
  Koszul.isQuasiRegular_of_isH1RegularOn ((Koszul.isH1RegularOn_self_iff f).2 h)

end RingLevel

/-- **The germ map of an affine open is flat.**  The stalk at a point of an affine open is the
localization of the ring of sections at the corresponding prime. -/
theorem germ_flat (U : X.Opens) (hU : IsAffineOpen U) (x : X) (hxU : x ∈ U) :
    (X.presheaf.germ U x hxU).hom.Flat := by
  let _ := X.presheaf.algebra_section_stalk (⟨x, hxU⟩ : U)
  have _ := hU.isLocalization_stalk (⟨x, hxU⟩ : U)
  exact RingHom.flat_algebraMap_iff.mpr
    (IsLocalization.flat _ (hU.primeIdealOf (⟨x, hxU⟩ : U)).asIdeal.primeCompl)

/-- **The implication `(8) ⇒ (4)` of Stacks tag 063I.**  If the ideal of a quasi-coherent sheaf of
ideals over an affine open `U` is generated by a quasi-regular sequence of sections, then at every
point of `U` in the support the ideal cut out in the local ring is generated by the germs of that
sequence, which are again quasi-regular. -/
theorem exists_span_eq_stalkIdeal_isQuasiRegular_of_affine (J : X.IdealSheafData)
    (U : X.affineOpens) {r : ℕ} (f : Fin r → Γ(X, U.1))
    (hgen : J.ideal U = Ideal.span (Set.range f))
    (hqr : IsQuasiRegular Γ(X, U.1) (List.ofFn f)) (x : X) (hx : x ∈ J.support)
    (hxU : x ∈ U.1) :
    ∃ (s : ℕ) (g : Fin s → X.presheaf.stalk x),
      stalkIdeal J x hx = Ideal.span (Set.range g) ∧
        IsQuasiRegular (X.presheaf.stalk x) (List.ofFn g) := by
  refine ⟨r, fun i => X.presheaf.germ U.1 x hxU (f i), ?_, ?_⟩
  · rw [stalkIdeal_eq_map_germ J x hx U.2 hxU, hgen, Ideal.map_span, ← Set.range_comp]
    rfl
  · simpa only [List.map_ofFn, Function.comp_def] using
      Koszul.isQuasiRegular_map_of_flat (X.presheaf.germ U.1 x hxU).hom
        (germ_flat U.1 U.2 x hxU) hqr

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
