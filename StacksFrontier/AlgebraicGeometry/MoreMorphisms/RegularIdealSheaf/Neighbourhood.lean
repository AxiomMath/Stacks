module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularIdealSheaf.AffineGenerators
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularIdealSheaf.AffineZeroScheme

/-!
# Passing between an affine open and an open neighbourhood

Let `J` be a quasi-coherent sheaf of ideals on a scheme `X`.  For an open `U` the restriction of
`J` to `U` is the ideal sheaf `J.comap U.ι`, and its closed subscheme is a closed immersion into
`U`; the four regularity conditions on that closed immersion are the four conditions on `J|_U`.

If `J(U)` is generated by a weakly regular sequence on an affine open `U`, then the closed
immersion over `U` is a regular immersion.  Conversely, if the closed immersion over some open
neighbourhood of a point of the support is quasi-regular, then the ideal cut out in the local ring
at that point is generated by a quasi-regular sequence.

## Main results

* `ideal_comap_ι_top`: the ideal of the restriction of `J` to an affine open `U`, taken over the
  whole of `U`, is the ideal of `J` over `U`.
* `isRegularImmersion_comap_ι_of_isRegular`: if `J(U)` is generated by a weakly regular sequence
  on an affine open `U`, then the restriction of `J` to `U` is regular.
* `exists_span_eq_stalkIdeal_isQuasiRegular_of_nhd`: if the restriction of `J` to an open
  neighbourhood of a point `x` of the support is quasi-regular, then `J_x` is generated by a
  quasi-regular sequence.

## References

* [Stacks Project, Lemma 31.20.6 (Tag 063I)](https://stacks.math.columbia.edu/tag/063I)
* [Stacks Project, Lemma 31.20.3 (Tag 063G)](https://stacks.math.columbia.edu/tag/063G)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace RingTheory.Sequence
open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

variable {X : Scheme.{u}}

/-- Over the whole of an affine open `U` the restriction `J.comap U.ι` has the ideal of `J` over
`U`, transported along the restriction map `U.topIso.inv`. -/
theorem ideal_comap_ι_top (J : X.IdealSheafData) (U : X.affineOpens)
    (hUtop : IsAffineOpen (⊤ : (U.1).toScheme.Opens)) :
    (J.comap U.1.ι).ideal ⟨⊤, hUtop⟩ = (J.ideal U).map U.1.topIso.inv.hom := by
  have hV : (U.1.ι ''ᵁ (⊤ : (U.1).toScheme.Opens)) ∈ X.affineOpens :=
    hUtop.image_of_isOpenImmersion U.1.ι
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion, Scheme.Opens.ι_appIso, Iso.refl_inv]
  dsimp only
  refine (Ideal.comap_id _).trans ?_
  refine (J.map_ideal (U := ⟨_, hV⟩) (V := U)
    (le_of_eq (Subtype.ext U.1.ι_image_top))).symm.trans ?_
  congr 1

/-- If the ideal of a quasi-coherent sheaf of
ideals over an affine open `U` is generated by a weakly regular sequence of sections, then the
closed subscheme that it cuts out in `U` is a regular immersion, that is, the restriction of the
ideal sheaf to `U` is regular. -/
theorem isRegularImmersion_comap_ι_of_isRegular (J : X.IdealSheafData) (U : X.affineOpens)
    {r : ℕ} (f : Fin r → Γ(X, U.1)) (hgen : J.ideal U = Ideal.span (Set.range f))
    (hwr : IsWeaklyRegular Γ(X, U.1) (List.ofFn f)) :
    IsRegularImmersion (J.comap U.1.ι).subschemeι := by
  have hUtop : IsAffineOpen (⊤ : (U.1).toScheme.Opens) := @isAffineOpen_top U.1.toScheme U.2
  have hker : RingHom.ker ((J.comap U.1.ι).subschemeι.app ⊤).hom =
      Ideal.span (Set.range fun i => U.1.topIso.inv (f i)) := by
    rw [Scheme.IdealSheafData.ker_subschemeι_app (J.comap U.1.ι) ⟨⊤, hUtop⟩,
      ideal_comap_ι_top J U hUtop, hgen, Ideal.map_span, ← Set.range_comp]
    rfl
  refine isRegularImmersion_of_isRegularIdealSheaf _ ?_
  refine isRegularIdealSheaf_of_exists_affine_generators U.1.toScheme _ fun y _ => ?_
  refine ⟨⊤, hUtop, trivial, r, _,
    isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span _ hUtop _ hker, ?_⟩
  exact isWeaklyRegular_ofFn_map_of_flat U.1.topIso.inv.hom
    (RingHom.Flat.of_bijective U.1.topIso.symm.commRingCatIsoToRingEquiv.bijective) f hwr

/-- If the restriction of a quasi-coherent
sheaf of ideals to an open neighbourhood of a point of the support cuts out a quasi-regular closed
subscheme there, then the ideal cut out in the local ring at that point is generated by a
quasi-regular sequence. -/
theorem exists_span_eq_stalkIdeal_isQuasiRegular_of_nhd (J : X.IdealSheafData) (x : X)
    (hx : x ∈ J.support) (U : X.Opens) (hxU : x ∈ U)
    (h : IsQuasiRegularImmersion (J.comap U.ι).subschemeι) :
    ∃ (r : ℕ) (g : Fin r → X.presheaf.stalk x),
      stalkIdeal J x hx = Ideal.span (Set.range g) ∧
        IsQuasiRegular (X.presheaf.stalk x) (List.ofFn g) := by
  have hy : (⟨x, hxU⟩ : U) ∈ (J.comap U.ι).support := by
    rwa [Scheme.IdealSheafData.support_comap]
  exact exists_span_eq_stalkIdeal_of_isOpenImmersion J U.ι (⟨x, hxU⟩ : U) x rfl hy hx h

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
