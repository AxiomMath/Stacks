/-!
# The twelve equivalent conditions on a regular ideal sheaf at a point

Let `X` be a locally Noetherian scheme, let `J` be a quasi-coherent sheaf of ideals on `X` and
let `x` be a point of the support of `O_X / J`.  Twelve conditions on `J` at `x` are equivalent:
that the ideal `J_x` cut out in the local ring be generated by a regular, a Koszul-regular, an
`H₁`-regular or a quasi-regular sequence; that some affine neighbourhood `U` of `x` carry
generators of `J(U)` forming a sequence of one of those four kinds in `Γ(X, U)`; and that the
restriction of `J` to some neighbourhood of `x` be a regular, a Koszul-regular, an `H₁`-regular or
a quasi-regular ideal sheaf.  In particular the four notions of regularity for ideal sheaves agree
on a locally Noetherian scheme.

## Main results

* `regular_tfae`: the equivalence of the twelve conditions.
* `isRegularImmersion_nhd_iff_isQuasiRegularImmersion_nhd`: near a point of the support, `J` is a
  regular ideal sheaf on some neighbourhood if and only if it is a quasi-regular ideal sheaf on
  some neighbourhood.

## Implementation notes

The restriction of `J` to an open `U` is `J.comap U.ι`, and a regularity condition on it is the
corresponding regularity condition on the closed immersion `(J.comap U.ι).subschemeι` of its closed
subscheme into `U`.

## References

* [Stacks Project, Lemma 31.20.6 (Tag 063I)](https://stacks.math.columbia.edu/tag/063I)
* [Stacks Project, Lemma 31.21.2 (Tag 063K)](https://stacks.math.columbia.edu/tag/063K)
* [Stacks Project, Lemma 15.30.6 (Tag 09CC)](https://stacks.math.columbia.edu/tag/09CC)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace RingTheory.Sequence

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

variable {X : Scheme.{u}}

/-- Let `X` be a locally Noetherian scheme, let `J` be a quasi-coherent sheaf of ideals and let `x`
be a point of the support of `O_X / J`.  The following are equivalent:

1. `J_x` is generated by a regular sequence in `O_{X, x}`;
2. `J_x` is generated by a Koszul-regular sequence in `O_{X, x}`;
3. `J_x` is generated by an `H₁`-regular sequence in `O_{X, x}`;
4. `J_x` is generated by a quasi-regular sequence in `O_{X, x}`;
5. there is an affine neighbourhood `U` of `x` with `J(U)` generated by a regular sequence;
6. there is an affine neighbourhood `U` of `x` with `J(U)` generated by a Koszul-regular sequence;
7. there is an affine neighbourhood `U` of `x` with `J(U)` generated by an `H₁`-regular sequence;
8. there is an affine neighbourhood `U` of `x` with `J(U)` generated by a quasi-regular sequence;
9. there is a neighbourhood `U` of `x` on which `J` is a regular ideal sheaf;
10. there is a neighbourhood `U` of `x` on which `J` is a Koszul-regular ideal sheaf;
11. there is a neighbourhood `U` of `x` on which `J` is an `H₁`-regular ideal sheaf;
12. there is a neighbourhood `U` of `x` on which `J` is a quasi-regular ideal sheaf. -/
@[stacks 063I, ega "IV 16.9.10", ega "IV 16.9.11", sga "6 VII 1.4" "special case"]
theorem regular_tfae [IsLocallyNoetherian X] (J : X.IdealSheafData) (x : X)
    (hx : x ∈ J.support) :
    List.TFAE
      [∃ (s : ℕ) (g : Fin s → X.presheaf.stalk x),
          stalkIdeal J x hx = Ideal.span (Set.range g) ∧
            IsRegular (X.presheaf.stalk x) (List.ofFn g),
        ∃ (s : ℕ) (g : Fin s → X.presheaf.stalk x),
          stalkIdeal J x hx = Ideal.span (Set.range g) ∧ Koszul.IsKoszulRegular g,
        ∃ (s : ℕ) (g : Fin s → X.presheaf.stalk x),
          stalkIdeal J x hx = Ideal.span (Set.range g) ∧ Koszul.IsH1Regular g,
        ∃ (s : ℕ) (g : Fin s → X.presheaf.stalk x),
          stalkIdeal J x hx = Ideal.span (Set.range g) ∧
            IsQuasiRegular (X.presheaf.stalk x) (List.ofFn g),
        ∃ (U : X.affineOpens) (_ : x ∈ U.1) (s : ℕ) (f : Fin s → Γ(X, U.1)),
          J.ideal U = Ideal.span (Set.range f) ∧ IsRegular Γ(X, U.1) (List.ofFn f),
        ∃ (U : X.affineOpens) (_ : x ∈ U.1) (s : ℕ) (f : Fin s → Γ(X, U.1)),
          J.ideal U = Ideal.span (Set.range f) ∧ Koszul.IsKoszulRegular f,
        ∃ (U : X.affineOpens) (_ : x ∈ U.1) (s : ℕ) (f : Fin s → Γ(X, U.1)),
          J.ideal U = Ideal.span (Set.range f) ∧ Koszul.IsH1Regular f,
        ∃ (U : X.affineOpens) (_ : x ∈ U.1) (s : ℕ) (f : Fin s → Γ(X, U.1)),
          J.ideal U = Ideal.span (Set.range f) ∧ IsQuasiRegular Γ(X, U.1) (List.ofFn f),
        ∃ U : X.Opens, x ∈ U ∧ IsRegularImmersion (J.comap U.ι).subschemeι,
        ∃ U : X.Opens, x ∈ U ∧ IsKoszulRegularImmersion (J.comap U.ι).subschemeι,
        ∃ U : X.Opens, x ∈ U ∧ IsH1RegularImmersion (J.comap U.ι).subschemeι,
        ∃ U : X.Opens, x ∈ U ∧ IsQuasiRegularImmersion (J.comap U.ι).subschemeι] := by
  have hstalk := stalkGeneratedBy_tfae J x hx
  tfae_have 1 → 2 := (hstalk.out 1 2).mp
  tfae_have 2 → 3 := (hstalk.out 2 3).mp
  tfae_have 3 → 4 := (hstalk.out 3 4).mp
  tfae_have 1 → 5 := fun ⟨s, g, hspan, hreg⟩ =>
    exists_affineOpen_span_eq_ideal_isRegular J x hx g hspan hreg
  tfae_have 5 → 6 := fun ⟨U, hxU, s, f, hgen, hreg⟩ =>
    ⟨U, hxU, s, f, hgen, isKoszulRegular_of_isRegular_section f hreg⟩
  tfae_have 6 → 7 := fun ⟨U, hxU, s, f, hgen, hreg⟩ =>
    ⟨U, hxU, s, f, hgen, isH1Regular_of_isKoszulRegular_section f hreg⟩
  tfae_have 7 → 8 := fun ⟨U, hxU, s, f, hgen, hreg⟩ =>
    ⟨U, hxU, s, f, hgen, isQuasiRegular_of_isH1Regular_section f hreg⟩
  tfae_have 8 → 4 := fun ⟨U, hxU, s, f, hgen, hqr⟩ =>
    exists_span_eq_stalkIdeal_isQuasiRegular_of_affine J U f hgen hqr x hx hxU
  tfae_have 4 → 1 := (hstalk.out 4 1).mp
  tfae_have 5 → 9 := fun ⟨U, hxU, s, f, hgen, hreg⟩ =>
    ⟨U.1, hxU, isRegularImmersion_comap_ι_of_isRegular J U f hgen hreg.toIsWeaklyRegular⟩
  tfae_have 9 → 10 := fun ⟨U, hxU, h⟩ =>
    ⟨U, hxU, isKoszulRegularImmersion_of_isRegularImmersion _ h⟩
  tfae_have 10 → 11 := fun ⟨U, hxU, h⟩ =>
    ⟨U, hxU, isH1RegularImmersion_of_isKoszulRegularImmersion _ h⟩
  tfae_have 11 → 12 := fun ⟨U, hxU, h⟩ =>
    ⟨U, hxU, isQuasiRegularImmersion_of_isH1RegularImmersion _ h⟩
  tfae_have 12 → 4 := fun ⟨U, hxU, h⟩ =>
    exists_span_eq_stalkIdeal_isQuasiRegular_of_nhd J x hx U hxU h
  tfae_finish

/-- Let `X` be a locally Noetherian scheme, let `J` be a quasi-coherent sheaf of ideals and let `x`
be a point of the support of `O_X / J`.  Then `J` is a regular ideal sheaf on some neighbourhood
of `x` if and only if it is a quasi-regular ideal sheaf on some neighbourhood of `x`. -/
@[ega "IV 16.9.11" "more general"]
theorem isRegularImmersion_nhd_iff_isQuasiRegularImmersion_nhd [IsLocallyNoetherian X]
    (J : X.IdealSheafData) (x : X) (hx : x ∈ J.support) :
    (∃ U : X.Opens, x ∈ U ∧ IsRegularImmersion (J.comap U.ι).subschemeι) ↔
      ∃ U : X.Opens, x ∈ U ∧ IsQuasiRegularImmersion (J.comap U.ι).subschemeι :=
  (regular_tfae J x hx).out 9 12

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
