module

public import StacksFrontier.AlgebraicGeometry.RegularImmersion.BaseChange
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularIdealSheaf.ClosedBridge
public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial

/-!
# The zero scheme of a quasi-regular family on an affine open

Let `b` be a list of global sections of a scheme `Z` and let `V` be an affine open of `Z`.  The
closed subscheme of `V` cut out by `b` is the subscheme of the pullback along `V.ι` of the ideal
sheaf `Scheme.IdealSheafData.ofIdealTop (Ideal.ofList b)`, and its defining ideal over the whole
of `V` is generated by the restrictions of the members of `b`.  So if those restrictions form a
quasi-regular — respectively weakly regular — sequence in `Γ(V, ⊤)`, the closed immersion is a
quasi-regular — respectively regular — immersion.

## Main results

* `Stacks.AlgebraicGeometry.ideal_comap_ofIdealTop_top`: the ideal of the pulled back ideal sheaf
  over the whole of an affine open is the ideal generated by the restricted list.
* `Stacks.AlgebraicGeometry.isQuasiRegularImmersion_comap_ofIdealTop_of_isQuasiRegular`: the zero
  scheme of a quasi-regular family on an affine open is a quasi-regular immersion.
* `Stacks.AlgebraicGeometry.isRegularImmersion_comap_ofIdealTop_of_isWeaklyRegular`: the zero
  scheme of a weakly regular family on an affine open is a regular immersion.

## Implementation notes

The affine criterion of Stacks tag 063G asks, at every point of the support, for an affine open
carrying generators; here the single affine open `⊤` of `V` serves for every point, which is why
the whole of `V` has to carry the sequence.
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry RingTheory.Sequence
open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.AlgebraicGeometry

universe u

variable {Z : Scheme.{u}}

/-- The set of members of a list is the range of its indexing function. -/
theorem setOf_mem_eq_range_getElem {R : Type*} (l : List R) :
    {r | r ∈ l} = Set.range (fun i : Fin l.length => l[i]) := by
  ext x
  simp only [Set.mem_ofPred_eq, Set.mem_range, List.mem_iff_getElem, Fin.getElem_fin]
  exact ⟨fun ⟨i, hi, e⟩ => ⟨⟨i, hi⟩, e⟩, fun ⟨i, e⟩ => ⟨i.1, i.2, e⟩⟩

/-- An ideal generated by a list is generated by the range of its indexing function. -/
theorem ofList_eq_span_range_getElem {R : Type*} [CommRing R] (l : List R) :
    Ideal.ofList l = Ideal.span (Set.range (fun i : Fin l.length => l[i])) := by
  rw [Ideal.ofList, setOf_mem_eq_range_getElem]

/-- **The equations of the zero scheme over an affine open.**  The ideal of the pullback of
`Scheme.IdealSheafData.ofIdealTop (Ideal.ofList b)` along the inclusion of an affine open `V`,
taken over the whole of `V`, is the ideal generated by the restrictions of the members of `b`. -/
theorem ideal_comap_ofIdealTop_top (b : List Γ(Z, ⊤)) (V : Z.Opens)
    (hVtop : IsAffineOpen (⊤ : V.toScheme.Opens)) :
    ((Scheme.IdealSheafData.ofIdealTop (Ideal.ofList b)).comap V.ι).ideal ⟨⊤, hVtop⟩ =
      Ideal.ofList (b.map V.ι.appTop.hom) := by
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
    Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_ofList, Scheme.Opens.ι_appIso,
    Iso.refl_inv]
  exact Ideal.comap_id _

/-- The kernel of the global sections map of the zero scheme over an affine open is generated by
the restrictions of the members of `b`. -/
private theorem ker_subschemeι_app_comap_ofIdealTop_top (b : List Γ(Z, ⊤)) (V : Z.Opens)
    (hVtop : IsAffineOpen (⊤ : V.toScheme.Opens)) :
    RingHom.ker
      (((Scheme.IdealSheafData.ofIdealTop (Ideal.ofList b)).comap V.ι).subschemeι.app ⊤).hom =
      Ideal.span (Set.range (fun i : Fin (b.map V.ι.appTop.hom).length =>
        (b.map V.ι.appTop.hom)[i])) :=
  (Scheme.IdealSheafData.ker_subschemeι_app _ ⟨⊤, hVtop⟩).trans
    ((ideal_comap_ofIdealTop_top b V hVtop).trans (ofList_eq_span_range_getElem _))

/-- **The zero scheme of a quasi-regular family on an affine open is a quasi-regular
immersion.** -/
theorem isQuasiRegularImmersion_comap_ofIdealTop_of_isQuasiRegular (b : List Γ(Z, ⊤))
    (V : Z.Opens) (hV : IsAffineOpen V)
    (h : IsQuasiRegular Γ(V.toScheme, ⊤) (b.map V.ι.appTop.hom)) :
    IsQuasiRegularImmersion
      ((Scheme.IdealSheafData.ofIdealTop (Ideal.ofList b)).comap V.ι).subschemeι := by
  have hVtop : IsAffineOpen (⊤ : V.toScheme.Opens) := @isAffineOpen_top V.toScheme hV
  refine isQuasiRegularImmersion_of_isQuasiRegularIdealSheaf _ ?_
  refine (isQuasiRegularIdealSheaf_iff_exists_affine_generators V.toScheme _).mpr fun x _ => ?_
  refine ⟨⟨⊤, hVtop⟩, trivial, _, _,
    isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span _ hVtop _
      (ker_subschemeι_app_comap_ofIdealTop_top b V hVtop), ?_⟩
  simpa using h

/-- **The zero scheme of a weakly regular family on an affine open is a regular immersion.** -/
theorem isRegularImmersion_comap_ofIdealTop_of_isWeaklyRegular (b : List Γ(Z, ⊤))
    (V : Z.Opens) (hV : IsAffineOpen V)
    (h : IsWeaklyRegular Γ(V.toScheme, ⊤) (b.map V.ι.appTop.hom)) :
    IsRegularImmersion
      ((Scheme.IdealSheafData.ofIdealTop (Ideal.ofList b)).comap V.ι).subschemeι := by
  have hVtop : IsAffineOpen (⊤ : V.toScheme.Opens) := @isAffineOpen_top V.toScheme hV
  refine isRegularImmersion_of_isRegularIdealSheaf _ ?_
  refine isRegularIdealSheaf_of_exists_affine_generators V.toScheme _ fun x _ => ?_
  refine ⟨⊤, hVtop, trivial, _, _,
    isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span _ hVtop _
      (ker_subschemeι_app_comap_ofIdealTop_top b V hVtop), ?_⟩
  simpa using h

end Stacks.AlgebraicGeometry

end
