module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RelativeRegularImmersion.FibreDictionary
public import StacksFrontier.RingTheory.Koszul.Quasiregular
public import Mathlib.AlgebraicGeometry.Noetherian
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The four stalk conditions on an ideal sheaf agree at a point of the support

Let `X` be a locally Noetherian scheme, let `J` be a quasi-coherent sheaf of ideals on `X` and
let `x` be a point of the support of `O_X / J`.  The four conditions that the ideal `J_x` cut out
in the local ring `O_{X, x}` be generated by a regular, a Koszul-regular, an `H₁`-regular or a
quasi-regular sequence are equivalent.

These are conditions (1), (2), (3) and (4) of Stacks tag 063I.  The local ring at a point of a
locally Noetherian scheme is Noetherian and local, and the ideal cut out at a point of the
support is proper, hence contained in the maximal ideal, so its generators are; that is exactly
the hypothesis of Stacks tag 09CC, which equates the four notions for a sequence in the maximal
ideal of a Noetherian local ring.

## Main results

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.stalkGeneratedBy_tfae`: the equivalence of the four
  conditions.

## References

* [Stacks Project, Lemma 31.20.6 (Tag 063I)](https://stacks.math.columbia.edu/tag/063I)
* [Stacks Project, Lemma 15.30.6 (Tag 09CC)](https://stacks.math.columbia.edu/tag/09CC)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace RingTheory.Sequence

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

variable {X : Scheme.{u}}

/-- **The generators of the ideal cut out at a point of the support lie in the maximal ideal.**
The ideal is proper, and a proper ideal of a local ring is contained in the maximal ideal. -/
theorem mem_maximalIdeal_of_span_eq_stalkIdeal (J : X.IdealSheafData) (x : X)
    (hx : x ∈ J.support) {r : ℕ} {g : Fin r → X.presheaf.stalk x}
    (hspan : stalkIdeal J x hx = Ideal.span (Set.range g)) (i : Fin r) :
    g i ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
  IsLocalRing.le_maximalIdeal (hspan ▸ stalkIdeal_ne_top J x hx)
    (Ideal.subset_span (Set.mem_range_self i))

/-- **Conditions (1), (2), (3) and (4) of Stacks tag 063I are equivalent.**  On a locally
Noetherian scheme the ideal that a quasi-coherent sheaf of ideals cuts out in the local ring at a
point of the support of its quotient is generated by a regular sequence if and only if it is
generated by a Koszul-regular sequence, if and only if it is generated by an `H₁`-regular
sequence, if and only if it is generated by a quasi-regular sequence. -/
@[ega "IV 19.7.2" "(i)"]
theorem stalkGeneratedBy_tfae [IsLocallyNoetherian X] (J : X.IdealSheafData) (x : X)
    (hx : x ∈ J.support) :
    List.TFAE
      [∃ (r : ℕ) (g : Fin r → X.presheaf.stalk x),
          stalkIdeal J x hx = Ideal.span (Set.range g) ∧
            IsRegular (X.presheaf.stalk x) (List.ofFn g),
        ∃ (r : ℕ) (g : Fin r → X.presheaf.stalk x),
          stalkIdeal J x hx = Ideal.span (Set.range g) ∧ Koszul.IsKoszulRegular g,
        ∃ (r : ℕ) (g : Fin r → X.presheaf.stalk x),
          stalkIdeal J x hx = Ideal.span (Set.range g) ∧ Koszul.IsH1Regular g,
        ∃ (r : ℕ) (g : Fin r → X.presheaf.stalk x),
          stalkIdeal J x hx = Ideal.span (Set.range g) ∧
            IsQuasiRegular (X.presheaf.stalk x) (List.ofFn g)] := by
  have key : ∀ {r : ℕ} (g : Fin r → X.presheaf.stalk x),
      stalkIdeal J x hx = Ideal.span (Set.range g) →
      List.TFAE
        [IsRegular (X.presheaf.stalk x) (List.ofFn g), Koszul.IsKoszulRegular g,
          Koszul.IsH1Regular g, IsQuasiRegular (X.presheaf.stalk x) (List.ofFn g)] :=
    fun g hspan => (Koszul.regular_koszulRegular_h1Regular_quasiRegular_tfae
      (M := X.presheaf.stalk x) g
      (mem_maximalIdeal_of_span_eq_stalkIdeal J x hx hspan)).2
  tfae_have 1 → 2 := fun ⟨r, g, hspan, h⟩ =>
    ⟨r, g, hspan, (key g hspan).out 1 2 |>.mp h⟩
  tfae_have 2 → 3 := fun ⟨r, g, hspan, h⟩ =>
    ⟨r, g, hspan, (key g hspan).out 2 3 |>.mp h⟩
  tfae_have 3 → 4 := fun ⟨r, g, hspan, h⟩ =>
    ⟨r, g, hspan, (key g hspan).out 3 4 |>.mp h⟩
  tfae_have 4 → 1 := fun ⟨r, g, hspan, h⟩ =>
    ⟨r, g, hspan, (key g hspan).out 4 1 |>.mp h⟩
  tfae_finish

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
