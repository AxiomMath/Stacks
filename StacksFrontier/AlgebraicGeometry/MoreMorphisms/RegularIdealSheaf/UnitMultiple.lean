module

public import StacksFrontier.AlgebraicGeometry.RegularImmersion.Stalkwise
public import Mathlib.RingTheory.Regular.RegularSequence

/-!
# Replacing the members of a regular sequence by unit multiples

Multiplying each member of a finite family in a commutative ring by a unit changes neither the
ideal it generates nor its weak regularity.  Both are needed to lift a sequence generating an
ideal in a localization to a sequence of elements of the ring itself: a fraction becomes an
element of the ring only after multiplication by its denominator, which is a unit in the
localization.

A change-of-scalars statement for regular sequences is proved here as well: for a module over a
commutative algebra `S` over `R`, regularity of the image in `S` of a sequence in `R` is the same
as regularity of the original sequence acting through `R`.  Mathlib has this for weak regularity
(`RingTheory.Sequence.isWeaklyRegular_map_algebraMap_iff`) and the proof carries over verbatim.

## Main results

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.ofList_ofFn_eq_span_range`: the ideal generated by a
list is
  the ideal generated by the range of its indexing function.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.span_range_unit_mul`: the generated ideal is
unchanged.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isWeaklyRegular_ofFn_unit_mul`: weak regularity is
unchanged.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegular_map_algebraMap_iff`: the change-of-scalars
statement
  for regular sequences.
-/

@[expose] public section

open RingTheory.Sequence
open Stacks.RingTheory.QuasiRegular
open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

/-- The ideal generated by a finite list is the ideal generated by the range of its indexing
function. -/
theorem ofList_ofFn_eq_span_range {R : Type*} [CommRing R] {n : ℕ} (v : Fin n → R) :
    Ideal.ofList (List.ofFn v) = Ideal.span (Set.range v) :=
  congrArg Ideal.span (by ext y; simp [List.mem_ofFn])

/-- **A family and its unit multiples generate the same ideal.** -/
theorem span_range_unit_mul {R : Type*} [CommRing R] {r : ℕ} {c : Fin r → R}
    (hc : ∀ i, IsUnit (c i)) (g : Fin r → R) :
    Ideal.span (Set.range fun i => c i * g i) = Ideal.span (Set.range g) := by
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro y ⟨i, rfl⟩
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_range_self i))
  · rintro y ⟨i, rfl⟩
    exact (Ideal.unit_mul_mem_iff_mem _ (hc i)).mp
      (Ideal.subset_span (Set.mem_range_self i))

/-- **Weak regularity is unchanged by passing to unit multiples.**  The ideal generated by the
members preceding the `i`-th does not change, and multiplication by a unit is injective. -/
theorem isWeaklyRegular_ofFn_unit_mul {R : Type*} [CommRing R] {r : ℕ} {c : Fin r → R}
    (hc : ∀ i, IsUnit (c i)) (g : Fin r → R) (h : IsWeaklyRegular R (List.ofFn g)) :
    IsWeaklyRegular R (List.ofFn fun i => c i * g i) := by
  refine (isWeaklyRegular_iff _ _).mpr fun i hi => ?_
  have hir : i < r := by simpa using hi
  have key : ∀ f : Fin r → R, ∀ hf : i < (List.ofFn f).length,
      IsSMulRegular (R ⧸ (Ideal.ofList ((List.ofFn f).take i) • ⊤ : Submodule R R))
        (List.ofFn f)[i] ↔
      IsSMulRegular (R ⧸ Jid (precedingFamily f ⟨i, hir⟩)) (f ⟨i, hir⟩) := fun f hf => by
    rw [show (List.ofFn f)[i] = f ⟨i, hir⟩ from by simp, ofList_take_ofFn f ⟨i, hir⟩]
  have hg := (key g (by simpa using hir)).mp ((isWeaklyRegular_iff _ _).mp h i (by simpa using hir))
  refine (key _ hi).mpr ?_
  refine ((Submodule.quotEquivOfEq _ _
    (span_range_unit_mul (c := precedingFamily c ⟨i, hir⟩) (fun j => hc _)
      (precedingFamily g ⟨i, hir⟩))).isSMulRegular_congr _).mpr ?_
  exact ((hc ⟨i, hir⟩).isSMulRegular _).mul hg

/-- **Change of scalars for regular sequences.**  For an `S`-module that is also an `R`-module
compatibly, regularity of the image in `S` of a sequence in `R` is regularity of the sequence
itself. -/
theorem isRegular_map_algebraMap_iff {R S M : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M] (rs : List R) :
    IsRegular M (rs.map (algebraMap R S)) ↔ IsRegular M rs :=
  (AddEquiv.refl M).isRegular_congr <| List.forall₂_map_left_iff.mpr <|
    List.forall₂_same.mpr fun x _ => algebraMap_smul S x

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
