module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RelativeRegularImmersion.StalkIdeal
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.CohenMacaulaySlice.StalkSequence
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.CohenMacaulaySlice.FiberSequence
public import StacksFrontier.RingTheory.Sequence.QuasiRegular.Basic

/-!
# The ideal of a closed subscheme in a local ring, and quasi-regularity on the fibre

Let `f : X ⟶ S` be locally of finite type and let `T` be a closed subscheme of `X` which, near a
point `x` of `T`, is a quasi-regular closed subscheme on the fibre of `f` over `f x`. We show that
the ideal cut out by `T` in `𝒪_{X, x}` contains a finite family whose images form a regular
sequence in the quotient of `𝒪_{X, x}` by the ideal generated by the maximal ideal of
`𝒪_{S, f x}`, and which generates the ideal of `T` modulo that ideal.

## Main results

* `Stacks.AlgebraicGeometry.stalkIdeal_congr`: transport of the ideal cut out in a local ring
  along an equality of points.
* `Stacks.AlgebraicGeometry.stalkIdeal_ne_top`: the ideal cut out in a local ring at a point of
  the support is proper.
* `Stacks.AlgebraicGeometry.exists_span_eq_stalkIdeal_of_isOpenImmersion`: if the restriction of
  an ideal sheaf to an open subscheme is quasi-regular, the ideal it cuts out in the local ring of
  the ambient scheme at a point of that open is generated by a quasi-regular sequence.
* `Stacks.AlgebraicGeometry.exists_mem_stalkIdeal_isRegular_quotient`: the statement above on
  the fibre.

## References

* [Stacks Project, Lemma 31.22.8 (Tag 063W)](https://stacks.math.columbia.edu/tag/063W)
* [Stacks Project, Lemma 10.69.6 (Tag 061S)](https://stacks.math.columbia.edu/tag/061S)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry RingTheory.Sequence
open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.AlgebraicGeometry

universe u

variable {X Y S : Scheme.{u}}

/-- The ideal cut out in a local ring is transported along an equality of points by the
isomorphism of stalks it induces. -/
theorem stalkIdeal_congr (I : X.IdealSheafData) {x x' : X} (hxx' : x = x')
    (hx : x ∈ I.support) (hx' : x' ∈ I.support) :
    Ideal.map (X.presheaf.stalkCongr (Inseparable.of_eq hxx')).hom.hom (stalkIdeal I x hx)
      = stalkIdeal I x' hx' := by
  subst hxx'
  rw [stalkCongr_hom_self X.presheaf]
  exact Ideal.map_id _

/-- The ideal cut out in a local ring at a point of the support is proper. -/
theorem stalkIdeal_ne_top (I : X.IdealSheafData) (x : X) (hx : x ∈ I.support) :
    stalkIdeal I x hx ≠ ⊤ := by
  have key : ∀ z : I.subscheme, RingHom.ker (I.subschemeι.stalkMap z).hom ≠ ⊤ := by
    intro z h
    obtain ⟨a, ha⟩ := exists_ne (0 : I.subscheme.presheaf.stalk z)
    obtain ⟨b, rfl⟩ := I.subschemeι.stalkMap_surjective z a
    exact ha (RingHom.mem_ker.mp (h ▸ Submodule.mem_top))
  exact key ⟨x, hx⟩

/-- Mapping ideals along a bijective ring homomorphism is injective. -/
private theorem map_injective_of_bijective {R R' : Type*} [CommRing R] [CommRing R']
    (f : R →+* R') (hf : Function.Bijective f) : Function.Injective (Ideal.map f) :=
  fun J₁ J₂ h => by
    rw [← Ideal.comap_map_of_bijective f hf (I := J₁), h, Ideal.comap_map_of_bijective f hf]

/-- If the restriction of an ideal sheaf to an open subscheme is a quasi-regular closed subscheme,
then at each point of that open the ideal cut out in the local ring of the ambient scheme is
generated by a quasi-regular sequence. -/
theorem exists_span_eq_stalkIdeal_of_isOpenImmersion (I : X.IdealSheafData) (k : Y ⟶ X)
    [IsOpenImmersion k] (y : Y) (x : X) (hxy : k y = x)
    (hy : y ∈ (I.comap k).support) (hx : x ∈ I.support)
    (hI : IsQuasiRegularImmersion (I.comap k).subschemeι) :
    ∃ (r : ℕ) (d : Fin r → X.presheaf.stalk x),
      stalkIdeal I x hx = Ideal.span (Set.range d) ∧
        IsQuasiRegular (X.presheaf.stalk x) (List.ofFn d) := by
  subst hxy
  obtain ⟨r, d', hspan, hqr⟩ := exists_span_eq_stalkIdeal_isQuasiRegular (I.comap k) hI y hy
  have _ : IsIso (k.stalkMap y) := (IsOpenImmersion.iff_isIso_stalkMap.mp inferInstance).2 y
  set ε : X.presheaf.stalk (k y) ≃+* Y.presheaf.stalk y :=
    (asIso (k.stalkMap y)).commRingCatIsoToRingEquiv with hε
  set φ : X.presheaf.stalk (k y) →+* Y.presheaf.stalk y := ε.toRingHom with hφ
  have hφhom : φ = (k.stalkMap y).hom := rfl
  refine ⟨r, fun i => ε.symm.toRingHom (d' i), ?_, ?_⟩
  · have hmapped : Ideal.map φ (Ideal.span (Set.range fun i => ε.symm.toRingHom (d' i)))
        = Ideal.map φ (stalkIdeal I (k y) hx) := by
      have hcomp : (φ ∘ fun i => ε.symm.toRingHom (d' i)) = d' := by
        funext i
        simp [hφ]
      rw [Ideal.map_span, ← Set.range_comp, hcomp, hφhom,
        ← stalkIdeal_comap I k y hy hx, hspan]
    exact (map_injective_of_bijective φ ε.bijective hmapped).symm
  · have h := Koszul.isQuasiRegular_map_of_flat
      ε.symm.toRingHom
      (RingHom.Flat.of_bijective ε.symm.bijective) hqr
    simpa only [List.map_ofFn, Function.comp_def, RingEquiv.coe_toRingHom] using h

/-- Let `f : X ⟶ S` be locally of finite type, let `T` be a closed subscheme of `X` and let `x`
be a point of `T` such that the pullback of `T` to the fibre over `f x` is, near `x`, a
quasi-regular closed subscheme. Then the ideal cut out by `T` in `𝒪_{X, x}` contains a finite
family whose classes modulo the extended maximal ideal of `𝒪_{S, f x}` form a regular sequence
and generate the ideal modulo that extension. -/
theorem exists_mem_stalkIdeal_isRegular_quotient (f : X ⟶ S) [LocallyOfFiniteType f]
    (T : X.IdealSheafData) (x : X) (hx : x ∈ T.support)
    (hfib : ∃ V : (f.fiber (f x)).Opens, f.asFiber x ∈ V ∧ IsQuasiRegularImmersion
      (((T.comap (f.fiberι (f x))).comap V.ι).subschemeι)) :
    ∃ (r : ℕ) (d : Fin r → X.presheaf.stalk x), (∀ i, d i ∈ stalkIdeal T x hx) ∧
      IsRegular (X.presheaf.stalk x ⧸ Ideal.map (f.stalkMap x).hom
            (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))))
          (List.ofFn fun i => Ideal.Quotient.mk (Ideal.map (f.stalkMap x).hom
            (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) (d i)) ∧
        stalkIdeal T x hx ≤ Ideal.span (Set.range d) ⊔ Ideal.map (f.stalkMap x).hom
          (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))) := by
  obtain ⟨V, hφV, hIQR⟩ := hfib
  have hgφ : f.fiberι (f x) (f.asFiber x) = x := f.fiberι_asFiber x
  have hgφsupp : f.fiberι (f x) (f.asFiber x) ∈ T.support := by rwa [hgφ]
  have hφsupp : f.asFiber x ∈ (T.comap (f.fiberι (f x))).support := by
    rwa [Scheme.IdealSheafData.support_comap]
  have hVsupp : (⟨f.asFiber x, hφV⟩ : V.toScheme) ∈
      ((T.comap (f.fiberι (f x))).comap V.ι).support := by
    rwa [Scheme.IdealSheafData.support_comap]
  obtain ⟨r, dF, hspan, hqr⟩ := exists_span_eq_stalkIdeal_of_isOpenImmersion
    (T.comap (f.fiberι (f x))) V.ι ⟨f.asFiber x, hφV⟩ (f.asFiber x) rfl hVsupp hφsupp hIQR
  have _ : IsLocallyNoetherian (f.fiber (f x)) := isLocallyNoetherian_fiber f (f x)
  have hmem : ∀ a ∈ List.ofFn dF,
      a ∈ IsLocalRing.maximalIdeal ((f.fiber (f x)).presheaf.stalk (f.asFiber x)) := by
    intro a ha
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp ha
    refine IsLocalRing.le_maximalIdeal
      (stalkIdeal_ne_top (T.comap (f.fiberι (f x))) _ hφsupp) ?_
    rw [hspan]
    exact Ideal.subset_span ⟨i, rfl⟩
  have hregF : IsRegular ((f.fiber (f x)).presheaf.stalk (f.asFiber x)) (List.ofFn dF) :=
    IsRegular.of_isQuasiRegular_of_mem_maximalIdeal hmem hqr
  set P : Ideal (X.presheaf.stalk x) := Ideal.map (f.stalkMap x).hom
    (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))) with hP
  set ψ : (X.presheaf.stalk x ⧸ P) →+*
      (f.fiber (f x)).presheaf.stalk (f.asFiber x) :=
    (quotientStalkEquivFiberStalk f x).toRingHom with hψ
  have hψsurj : Function.Surjective ψ := (quotientStalkEquivFiberStalk f x).surjective
  have hψinj : Function.Injective ψ := (quotientStalkEquivFiberStalk f x).injective
  have hcomp : ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom.comp
        (X.presheaf.stalkCongr (Inseparable.of_eq hgφ.symm)).hom.hom
      = ψ.comp (Ideal.Quotient.mk P) :=
    RingHom.ext fun b => (quotientStalkEquivFiberStalk_mk f x b).symm
  have hkey : stalkIdeal (T.comap (f.fiberι (f x))) (f.asFiber x) hφsupp
      = Ideal.map (ψ.comp (Ideal.Quotient.mk P)) (stalkIdeal T x hx) := by
    rw [stalkIdeal_comap T (f.fiberι (f x)) (f.asFiber x) hφsupp hgφsupp,
      ← stalkIdeal_congr T hgφ.symm hx hgφsupp, Ideal.map_map, hcomp]
  have hsurj : Function.Surjective (ψ.comp (Ideal.Quotient.mk P)) :=
    hψsurj.comp Ideal.Quotient.mk_surjective
  have hlift : ∀ i : Fin r, ∃ a, a ∈ stalkIdeal T x hx ∧
      (ψ.comp (Ideal.Quotient.mk P)) a = dF i := by
    intro i
    refine (Ideal.mem_map_iff_of_surjective _ hsurj).mp ?_
    rw [← hkey, hspan]
    exact Ideal.subset_span ⟨i, rfl⟩
  choose d hd hde using hlift
  have hcast : ∀ i : Fin r,
      ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom (hgφ.symm ▸ d i) = dF i := by
    intro i
    rw [← stalkCongr_hom_apply_eq_cast X.presheaf hgφ.symm (d i)]
    have h1 := congrArg (fun θ : X.presheaf.stalk x →+*
      (f.fiber (f x)).presheaf.stalk (f.asFiber x) => θ (d i)) hcomp
    have h2 := hde i
    simp only [RingHom.comp_apply] at h1 h2
    exact h1.trans h2
  have hregQ := isRegular_quotient_stalk_of_isRegular_fiber f x d
    (by simpa only [hcast] using hregF)
  have hquot : Ideal.map (Ideal.Quotient.mk P) (stalkIdeal T x hx)
      = Ideal.map (Ideal.Quotient.mk P) (Ideal.span (Set.range d)) := by
    refine map_injective_of_bijective ψ ⟨hψinj, hψsurj⟩ ?_
    rw [Ideal.map_map, Ideal.map_map, ← hkey, hspan, Ideal.map_span, ← Set.range_comp]
    exact congrArg Ideal.span (congrArg Set.range (funext fun i => (hde i).symm))
  refine ⟨r, d, hd, hregQ, fun a ha => ?_⟩
  have hmema : Ideal.Quotient.mk P a ∈ Ideal.map (Ideal.Quotient.mk P)
      (Ideal.span (Set.range d)) := by
    rw [← hquot]
    exact Ideal.mem_map_of_mem _ ha
  have hcomapmk := Ideal.comap_map_of_surjective (Ideal.Quotient.mk P)
    Ideal.Quotient.mk_surjective (Ideal.span (Set.range d))
  rw [show Ideal.comap (Ideal.Quotient.mk P) (⊥ : Ideal (X.presheaf.stalk x ⧸ P)) = P from
    (RingHom.ker_eq_comap_bot _).symm.trans (Ideal.mk_ker)] at hcomapmk
  exact hcomapmk ▸ (Ideal.mem_comap.mpr hmema)

end Stacks.AlgebraicGeometry

end
