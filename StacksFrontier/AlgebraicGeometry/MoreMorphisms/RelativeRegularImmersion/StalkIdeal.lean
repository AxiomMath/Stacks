module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import StacksFrontier.AlgebraicGeometry.Flatness.StalkIdealSheaf
public import StacksFrontier.AlgebraicGeometry.RegularImmersion.BaseChange
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularIdealSheaf.ClosedBridge
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The ideal cut out by an ideal sheaf in a local ring

For an ideal sheaf `I` on a scheme `X` and a point `x` of its support, the closed immersion
`I.subschemeι` is surjective on sections, so its stalk map at `x` is a surjection of local rings
and its kernel is the ideal that `I` cuts out in `𝒪_{X, x}`. This ideal is the extension of the
ideal of sections over any affine open containing the point, it is compatible with pulling the
ideal sheaf back along an arbitrary morphism, and it is generated by a quasi-regular sequence when
`I.subschemeι` is a quasi-regular immersion.

## Main definitions

* `Stacks.AlgebraicGeometry.stalkIdeal`: the ideal cut out in the local ring.

## Main results

* `Stacks.AlgebraicGeometry.stalkIdeal_eq_map_germ`: the ideal is the extension of the ideal of
  sections over an affine open.
* `Stacks.AlgebraicGeometry.stalkIdeal_comap`: the ideal of a pulled back ideal sheaf is the
  extension of the ideal of the original along the stalk map.
* `Stacks.AlgebraicGeometry.isQuasiRegularIdealSheaf_of_isQuasiRegularImmersion`: a quasi-regular
  closed immersion has a quasi-regular defining ideal on its target.
* `Stacks.AlgebraicGeometry.exists_span_eq_stalkIdeal_isQuasiRegular`: a quasi-regular closed
  subscheme cuts out, in each local ring of its support, an ideal generated by a quasi-regular
  sequence.

## References

* [Stacks Project, Lemma 31.20.2 (Tag 063G)](https://stacks.math.columbia.edu/tag/063G)
* [Stacks Project, Lemma 31.21.2 (Tag 063J)](https://stacks.math.columbia.edu/tag/063J)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry RingTheory.Sequence
open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.AlgebraicGeometry

universe u

variable {X Y : Scheme.{u}}

/-- The comparison isomorphism of the stalks at two inseparable points is the identity when the
two points are the same;  the proof of inseparability is irrelevant. -/
theorem stalkCongr_hom_self {T : TopCat.{u}} (F : T.Presheaf CommRingCat.{u}) {x : T}
    (e : Inseparable x x) : (F.stalkCongr e).hom = 𝟙 (F.stalk x) := by
  rw [TopCat.Presheaf.stalkCongr_hom]
  exact F.stalkSpecializes_refl x

/-- The ideal cut out by an ideal sheaf `I` in the local ring at a point `x` of its support: the
kernel of the stalk map of the closed immersion `I.subschemeι` at the point of `I.subscheme` over
`x`. -/
def stalkIdeal (I : X.IdealSheafData) (x : X) (hx : x ∈ I.support) :
    Ideal (X.presheaf.stalk x) :=
  RingHom.ker (I.subschemeι.stalkMap (⟨x, hx⟩ : I.subscheme)).hom

/-- The ideal cut out in the local ring is the extension along the germ map of the kernel of the
map on sections over an affine open containing the point. -/
private theorem stalkIdeal_eq_map_ker_appLE (I : X.IdealSheafData) (x : X) (hx : x ∈ I.support)
    {U : X.Opens} (hU : IsAffineOpen U) (hxU : x ∈ U) :
    stalkIdeal I x hx = (RingHom.ker
      (I.subschemeι.appLE U (I.subschemeι ⁻¹ᵁ U) le_rfl).hom).map
        (X.presheaf.germ U x hxU).hom := by
  have hsurj : Function.Surjective
      (I.subschemeι.appLE U (I.subschemeι ⁻¹ᵁ U) le_rfl).hom := by
    rw [Scheme.Hom.appLE_eq_app]
    exact I.subschemeι_app_surjective ⟨U, hU⟩
  exact Stacks.Flatness.ker_stalkMap_eq_map_germ I.subschemeι hU
    (hU.preimage I.subschemeι) le_rfl (x := (⟨x, hx⟩ : I.subscheme)) hxU hxU hsurj

/-- Over an affine open containing the point, the ideal of sections of `I` extends along the germ
map to the ideal that `I` cuts out in the local ring. -/
theorem stalkIdeal_eq_map_germ (I : X.IdealSheafData) (x : X) (hx : x ∈ I.support)
    {U : X.Opens} (hU : IsAffineOpen U) (hxU : x ∈ U) :
    stalkIdeal I x hx = (I.ideal ⟨U, hU⟩).map (X.presheaf.germ U x hxU).hom := by
  rw [stalkIdeal_eq_map_ker_appLE I x hx hU hxU, Scheme.Hom.appLE_eq_app]
  exact congrArg _ (I.ker_subschemeι_app ⟨U, hU⟩)

/-- For a morphism `g : Y ⟶ X` and a point
`y` of `Y` over the support of `I`, the ideal that `I.comap g` cuts out in `𝒪_{Y, y}` is the
extension along the stalk map of the ideal that `I` cuts out in `𝒪_{X, g y}`. -/
theorem stalkIdeal_comap (I : X.IdealSheafData) (g : Y ⟶ X) (y : Y)
    (hy : y ∈ (I.comap g).support) (hgy : g y ∈ I.support) :
    stalkIdeal (I.comap g) y hy =
      (stalkIdeal I (g y) hgy).map (g.stalkMap y).hom := by
  set z : (I.comap g).subscheme := ⟨y, hy⟩ with hz
  have hsq : IsPullback (I.comap g).subschemeι
      ((I.comap g).subschemeMap I g (I.le_map_comap g)) g I.subschemeι :=
    IsPullback.of_iso_pullback
      ⟨(Scheme.IdealSheafData.subschemeMap_subschemeι (I.comap g) I g (I.le_map_comap g)).symm⟩
      (I.comapIso g) (I.comapIso_hom_fst g) (I.comapIso_hom_snd g)
  have hpt0 : I.subschemeι ((I.comap g).subschemeMap I g (I.le_map_comap g) z)
      = g ((I.comap g).subschemeι z) := by
    have hw := congrArg (fun F : (I.comap g).subscheme ⟶ X => F.base z) hsq.w
    simpa only [Scheme.Hom.comp_apply] using hw.symm
  have key : ∀ (t : I.subscheme) (hpt : I.subschemeι t = g y),
      RingHom.ker ((I.comap g).subschemeι.stalkMap z).hom =
        Ideal.map ((X.presheaf.stalkCongr (Inseparable.of_eq hpt)).hom ≫ g.stalkMap y).hom
          (RingHom.ker (I.subschemeι.stalkMap t).hom) := by
    intro t hpt
    obtain rfl : t = (I.comap g).subschemeMap I g (I.le_map_comap g) z :=
      Subtype.ext (hpt.trans hpt0.symm)
    exact Stacks.Flatness.ker_stalkMap_of_isPullback hsq z hpt0
  have h0 : (X.presheaf.stalkCongr (Inseparable.of_eq
      (rfl : I.subschemeι (⟨g y, hgy⟩ : I.subscheme) = g y))).hom
      = 𝟙 (X.presheaf.stalk (g y)) := stalkCongr_hom_self X.presheaf _
  have hmap : ((X.presheaf.stalkCongr (Inseparable.of_eq
      (rfl : I.subschemeι (⟨g y, hgy⟩ : I.subscheme) = g y))).hom ≫ g.stalkMap y)
      = g.stalkMap y :=
    (congrArg (fun θ : X.presheaf.stalk (g y) ⟶ X.presheaf.stalk (g y) =>
      θ ≫ g.stalkMap y) h0).trans (Category.id_comp _)
  exact (key ⟨g y, hgy⟩ rfl).trans
    (congrArg (fun θ : X.presheaf.stalk (g y) ⟶ Y.presheaf.stalk y =>
      Ideal.map θ.hom (RingHom.ker (I.subschemeι.stalkMap (⟨g y, hgy⟩ : I.subscheme)).hom)) hmap)

/-- The defining ideal sheaf on its target of a quasi-regular closed immersion is
quasi-regular. -/
@[ega "IV 16.9.2" "partial"]
theorem isQuasiRegularIdealSheaf_of_isQuasiRegularImmersion {Z : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] (h : IsQuasiRegularImmersion i) :
    IsQuasiRegularIdealSheaf X.toRingedSpace (definingIdealOfHom i) := by
  have hfac : i.liftCoborder ≫ i.coborderRange.ι = i := i.liftCoborder_ι
  have hci : IsClosedImmersion (i.liftCoborder ≫ i.coborderRange.ι) := by
    rw [hfac]; infer_instance
  have key : IsQuasiRegularIdealSheaf X.toRingedSpace
      (definingIdealOfHom (i.liftCoborder ≫ i.coborderRange.ι)) := by
    refine (isQuasiRegularIdealSheaf_iff_exists_affine_generators X _).mpr fun y hy => ?_
    rw [definingIdealQuotient_support_eq_range] at hy
    obtain ⟨z, rfl⟩ := hy
    have hz : i.liftCoborder z ∈ idealQuotientSupport
        i.coborderRange.toScheme.toRingedSpace (definingIdealOfHom i.liftCoborder) := by
      rw [definingIdealQuotient_support_eq_range]
      exact ⟨z, rfl⟩
    obtain ⟨U, hzU, r, s, hgen, hs⟩ :=
      (isQuasiRegularIdealSheaf_iff_exists_affine_generators i.coborderRange.toScheme _).mp h _ hz
    refine ⟨⟨i.coborderRange.ι ''ᵁ U.1, U.2.image_of_isOpenImmersion i.coborderRange.ι⟩,
      ⟨i.liftCoborder z, hzU, rfl⟩, r, fun k => (i.coborderRange.ι.appIso U.1).inv (s k), ?_, ?_⟩
    · refine (isGeneratedByOn_image_iff i.coborderRange.ι _ U.1 s).2 ?_
      rwa [definingIdealOfHom_comp_open]
    · have hflat := Koszul.isQuasiRegular_map_of_flat
        (i.coborderRange.ι.appIso U.1).inv.hom
        (RingHom.Flat.of_bijective
          (i.coborderRange.ι.appIso U.1).commRingCatIsoToRingEquiv.symm.bijective) hs
      simpa only [List.map_ofFn, Function.comp_def] using hflat
  rwa [hfac] at key

/-- If `I.subschemeι` is a quasi-regular immersion, then at each point of the support of `I` the
ideal cut out in the local ring is generated by a quasi-regular sequence of that local ring. -/
@[ega "IV 16.9.7" "more general"]
theorem exists_span_eq_stalkIdeal_isQuasiRegular (I : X.IdealSheafData)
    (hI : IsQuasiRegularImmersion I.subschemeι) (x : X) (hx : x ∈ I.support) :
    ∃ (r : ℕ) (d : Fin r → X.presheaf.stalk x),
      stalkIdeal I x hx = Ideal.span (Set.range d) ∧
        IsQuasiRegular (X.presheaf.stalk x) (List.ofFn d) := by
  have hqr := isQuasiRegularIdealSheaf_of_isQuasiRegularImmersion I.subschemeι hI
  have hsupp : x ∈ idealQuotientSupport X.toRingedSpace (definingIdealOfHom I.subschemeι) := by
    rw [definingIdealQuotient_support_eq_range]
    exact (I.range_subschemeι ▸ hx : x ∈ Set.range I.subschemeι.base)
  obtain ⟨U, hxU, r, s, hgen, hs⟩ :=
    (isQuasiRegularIdealSheaf_iff_exists_affine_generators X _).mp hqr x hsupp
  have hxU' : x ∈ U.1 := hxU
  refine ⟨r, fun k => X.presheaf.germ U.1 x hxU' (s k), ?_, ?_⟩
  · have h2 : RingHom.ker (I.subschemeι.appLE U.1 (I.subschemeι ⁻¹ᵁ U.1) le_rfl).hom
        = Ideal.span (Set.range s) := by
      rw [Scheme.Hom.appLE_eq_app]
      exact ker_app_eq_span_range I.subschemeι U.2 s hgen
    rw [stalkIdeal_eq_map_ker_appLE I x hx U.2 hxU']
    rw [h2, Ideal.map_span, ← Set.range_comp]
    rfl
  · let _ := X.presheaf.algebra_section_stalk (⟨x, hxU'⟩ : U.1)
    have _ := U.2.isLocalization_stalk (⟨x, hxU'⟩ : U.1)
    have hflatMod : Module.Flat Γ(X, U.1) (X.presheaf.stalk x) :=
      IsLocalization.flat _ (U.2.primeIdealOf (⟨x, hxU'⟩ : U.1)).asIdeal.primeCompl
    have hflat : (X.presheaf.germ U.1 x hxU').hom.Flat :=
      RingHom.flat_algebraMap_iff.mpr hflatMod
    have h' := Koszul.isQuasiRegular_map_of_flat (X.presheaf.germ U.1 x hxU').hom hflat hs
    simpa only [List.map_ofFn, Function.comp_def] using h'

end Stacks.AlgebraicGeometry

end
