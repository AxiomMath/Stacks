section Spread

variable {B : Type*} [CommRing B]

/-- **Spreading out an equality of extended ideals from a prime.**  Let `J ≤ I` be ideals of `B`
with `I` finitely generated.  If `I B_q = J B_q` for a prime `q`, then `I B_g = J B_g` for some
`g ∉ q`.

Each of finitely many generators of `I` lies in `J B_q`, hence is carried into `J` by an element
outside `q`, and the product of those elements is the `g` sought. -/
theorem exists_notMem_map_eq_map_away_of_map_atPrime_eq (q : Ideal B) [q.IsPrime] (J I : Ideal B)
    (hJI : J ≤ I) (hIfg : I.FG)
    (hstalk : I.map (algebraMap B (Localization.AtPrime q))
      = J.map (algebraMap B (Localization.AtPrime q))) :
    ∃ g ∉ q, I.map (algebraMap B (Localization.Away g))
      = J.map (algebraMap B (Localization.Away g)) := by
  classical
  obtain ⟨s, hs⟩ := hIfg
  -- every generator of `I` is carried into `J` by an element outside `q`
  have hgen : ∀ x ∈ (s : Set B), ∃ u ∈ q.primeCompl, u * x ∈ J := by
    intro x hx
    have hxI : x ∈ I := by rw [← hs]; exact Submodule.subset_span hx
    have hmem : algebraMap B (Localization.AtPrime q) x
        ∈ J.map (algebraMap B (Localization.AtPrime q)) := by
      rw [← hstalk]
      exact Ideal.mem_map_of_mem _ hxI
    exact (algebraMap_quotientMap_eq_zero_iff J q.primeCompl (Localization.AtPrime q) x).mp
      (Ideal.Quotient.eq_zero_iff_mem.mpr hmem)
  choose! u hu hu0 using hgen
  refine ⟨∏ x ∈ s, u x, q.primeCompl.prod_mem fun x hx => hu x hx,
    le_antisymm ?_ (Ideal.map_mono hJI)⟩
  rw [← hs, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨x, hx, rfl⟩
  have hxs : x ∈ s := Finset.mem_coe.mp hx
  have hunit : IsUnit (algebraMap B (Localization.Away (∏ x ∈ s, u x)) (u x)) :=
    isUnit_of_dvd_unit (map_dvd _ (Finset.dvd_prod_of_mem u hxs))
      (IsLocalization.Away.algebraMap_isUnit _)
  refine (Ideal.unit_mul_mem_iff_mem _ hunit).mp ?_
  rw [← map_mul]
  exact Ideal.mem_map_of_mem _ (hu0 x hxs)

end Spread

section Stalk

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]

/-- The submodule `m • (S ⧸ K)` is the ideal of `S ⧸ K` generated by the image of `m S`. -/
private theorem smul_top_quotient_eq_restrictScalars_map {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (m : Ideal R) (K : Ideal S) :
    m • (⊤ : Submodule R (S ⧸ K))
      = (Ideal.map (Ideal.Quotient.mk K) (m.map (algebraMap R S))).restrictScalars R := by
  rw [Ideal.smul_top_eq_map]
  congr 1
  rw [Ideal.map_map]
  rfl

/-- The quotient of a ring by a finitely generated ideal is finitely presented as a module. -/
private theorem finitePresentation_quotient_of_fg {R : Type*} [CommRing R] {K : Ideal R}
    (hK : K.FG) : Module.FinitePresentation R (R ⧸ K) :=
  Module.finitePresentation_of_surjective (Submodule.mkQ K) (Submodule.mkQ_surjective _)
    (by rwa [Submodule.ker_mkQ])

/-- **Part (2) of Stacks 062Y and of Stacks 063W, at the prime.**  Let `A → B` be of finite
presentation, let `q` be a prime of `B` with `p = A ∩ q`, and let `J ⊆ I` be finitely generated
ideals of `B` with `B_q/IB_q` flat over `A`.  If `I B_q ⊆ J B_q + p B_q`, then `I B_q = J B_q`.

This is the source's appeal to Algebra, Lemma 046Y: the surjection `B_q/JB_q → B_q/IB_q` is a map
of `B_q`-modules of finite presentation whose target is flat over `A_p`, and the hypothesis says
exactly that it is injective modulo the maximal ideal of `A_p`. -/
theorem map_eq_map_atPrime_of_le_sup_map_comap
    [Algebra.FinitePresentation A B] (q : Ideal B) [q.IsPrime] (J I : Ideal B) (hJI : J ≤ I)
    (hJfg : J.FG) (hIfg : I.FG)
    (hIflat : Module.Flat A
      (Localization.AtPrime q ⧸ I.map (algebraMap B (Localization.AtPrime q))))
    (hfib : I.map (algebraMap B (Localization.AtPrime q)) ≤
      J.map (algebraMap B (Localization.AtPrime q)) ⊔
        (q.comap (algebraMap A B)).map (algebraMap A (Localization.AtPrime q))) :
    I.map (algebraMap B (Localization.AtPrime q))
      = J.map (algebraMap B (Localization.AtPrime q)) := by
  classical
  let T := Localization.AtPrime q
  let p := q.comap (algebraMap A B)
  have : p.IsPrime := Ideal.comap_isPrime _ _
  have : q.LiesOver p := ⟨rfl⟩
  let P := Localization.AtPrime p
  let : Algebra P T := Localization.AtPrime.algebraOfLiesOver p q
  have : IsLocalHom (algebraMap P T) :=
    Localization.isLocalHom_localRingHom p q (algebraMap A B) rfl
  have hess : (algebraMap P T).EssentiallyOfFinitePresentation :=
    Koszul.essentiallyOfFinitePresentation_localization (S := B) p.primeCompl q.primeCompl
      (by rintro _ ⟨x, hx, rfl⟩; exact hx)
  have hJI' : J.map (algebraMap B T) ≤ I.map (algebraMap B T) := Ideal.map_mono hJI
  have := finitePresentation_quotient_of_fg (hJfg.map (algebraMap B T))
  have := finitePresentation_quotient_of_fg (hIfg.map (algebraMap B T))
  have : Module.Flat P (T ⧸ I.map (algebraMap B T)) :=
    (Module.flat_iff_of_isLocalization P p.primeCompl (T ⧸ I.map (algebraMap B T))).mpr hIflat
  have hmax : (maximalIdeal P).map (algebraMap P T) = p.map (algebraMap A T) :=
    map_maximalIdeal_eq_map_of_isLocalization p
  let u : (T ⧸ J.map (algebraMap B T)) →ₗ[T] (T ⧸ I.map (algebraMap B T)) :=
    Submodule.mapQ _ _ LinearMap.id (by simpa using hJI')
  have hu : Function.Injective (Submodule.mapQ
      (maximalIdeal P • (⊤ : Submodule P (T ⧸ J.map (algebraMap B T))))
      (maximalIdeal P • (⊤ : Submodule P (T ⧸ I.map (algebraMap B T))))
      (u.restrictScalars P) (Submodule.smul_top_le_comap_smul_top _ _)) := by
    refine (Stacks.Flatness.FibreNonZeroDivisor.mapQ_injective_iff _).2 fun z hz => ?_
    rw [Submodule.mem_comap, smul_top_quotient_eq_restrictScalars_map, hmax,
      Submodule.restrictScalars_mem] at hz
    rw [smul_top_quotient_eq_restrictScalars_map, hmax, Submodule.restrictScalars_mem]
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective (I := J.map (algebraMap B T)) z
    rw [show (u.restrictScalars P) (Ideal.Quotient.mk (J.map (algebraMap B T)) x)
        = Ideal.Quotient.mk (I.map (algebraMap B T)) x from rfl,
      Ideal.mem_quotient_iff_mem_sup] at hz
    rw [Ideal.mem_quotient_iff_mem_sup]
    exact sup_le le_sup_left (hfib.trans (sup_le le_sup_right le_sup_left)) hz
  refine le_antisymm (fun y hy => ?_) hJI'
  have h0 : u (Ideal.Quotient.mk (J.map (algebraMap B T)) y) = u 0 := by
    rw [map_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hy
  -- 046Y
  exact Ideal.Quotient.eq_zero_iff_mem.mp
    ((Module.Flat.injective_and_flat_quotient_range_of_injective_mapQ_maximalIdeal hess u hu).1 h0)

/-- **Part (2) of Stacks 062Y and of Stacks 063W, on a neighbourhood.**  Under the hypotheses of
`map_eq_map_atPrime_of_le_sup_map_comap` the two ideals already agree after localizing away from a
single element outside `q`.

Only the stalk equality and the finite generation of `I` are used: each of finitely many
generators of `I` lies in `J B_q`, hence is carried into `J` by an element outside `q`, and the
product of those elements is the `g` sought. -/
theorem exists_notMem_map_eq_map_away
    [Algebra.FinitePresentation A B] (q : Ideal B) [q.IsPrime] (J I : Ideal B) (hJI : J ≤ I)
    (hJfg : J.FG) (hIfg : I.FG)
    (hIflat : Module.Flat A
      (Localization.AtPrime q ⧸ I.map (algebraMap B (Localization.AtPrime q))))
    (hfib : I.map (algebraMap B (Localization.AtPrime q)) ≤
      J.map (algebraMap B (Localization.AtPrime q)) ⊔
        (q.comap (algebraMap A B)).map (algebraMap A (Localization.AtPrime q))) :
    ∃ g ∉ q, I.map (algebraMap B (Localization.Away g))
      = J.map (algebraMap B (Localization.Away g)) :=
  exists_notMem_map_eq_map_away_of_map_atPrime_eq q J I hJI hIfg
    (map_eq_map_atPrime_of_le_sup_map_comap q J I hJI hJfg hIfg hIflat hfib)

end Stalk

end Stacks.RingTheory.SpreadingOut

end
