module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RelativeRegularImmersion.FibreDictionary
public import StacksFrontier.AlgebraicGeometry.Morphisms.FibreDimension.SubschemeDimension
public import StacksFrontier.AlgebraicGeometry.Morphisms.Support.TestModuleStalk
public import StacksFrontier.RingTheory.Koszul.MinimalGenerators

/-!
# The equation count of item (3) of Stacks tag 063W

Item (3) of Stacks tag 063W assumes that the closed subscheme `T` is cut out near `x` by `c`
equations with `c = dim_x(X_s) - dim_x(T_s)`.  This file turns that numerical hypothesis into
the statement the proof uses:  any `c` elements of the local ring of the fibre `X_s` at `x`
generating the ideal of `T_s` there form a *regular* sequence.

## Main results

* `Stacks.AlgebraicGeometry.isRegular_of_span_eq_stalkIdeal_fiber_of_dim_eq`: the equation count
  of item (3) makes the generators a regular sequence in the local ring of the fibre.

## Implementation notes

The fibre hypothesis of the tag gives, by
`Stacks.AlgebraicGeometry.exists_span_eq_stalkIdeal_of_isOpenImmersion`, *some* quasi-regular —
hence regular, the fibre being locally Noetherian — generating family of that ideal, of some
length `r`.  The dimension formula reads `r` off the drop in local dimension
(`AlgebraicGeometry.length_eq_of_topologicalKrullDimAt_add`), so the hypothesis says exactly
`c = r`;  two generating families of the same length of an ideal generated by a regular
sequence are then both regular, which is `Koszul.isRegular_of_ofList_eq_of_length_eq`.

The ideal cut out in the local ring is spelled `Stacks.AlgebraicGeometry.stalkIdeal`, the kernel
of the map on stalks, and the dimension lemma is stated for
`AlgebraicGeometry.IdealSheafData.stalk`;  the two agree by
`AlgebraicGeometry.IdealSheafData.ker_stalkMap_subschemeι`.

## References

* [Stacks Project, Lemma 31.22.8 (Tag 063W)](https://stacks.math.columbia.edu/tag/063W)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry RingTheory.Sequence
open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.AlgebraicGeometry

universe u

variable {X S : Scheme.{u}}

/-- **The equation count of item (3) of Stacks tag 063W.**  If the fibre `T_s` is a quasi-regular
closed subscheme of `X_s` near `x`, and if the local dimension of `X_s` at `x` exceeds that of
`T_s` by `c`, then any `c` elements of `𝒪_{X_s, x}` generating the ideal of `T_s` there form a
regular sequence. -/
theorem isRegular_of_span_eq_stalkIdeal_fiber_of_dim_eq (f : X ⟶ S) [LocallyOfFiniteType f]
    (T : X.IdealSheafData) (x : X)
    (hfib : ∃ V : (f.fiber (f x)).Opens, f.asFiber x ∈ V ∧ IsQuasiRegularImmersion
      (((T.comap (f.fiberι (f x))).comap V.ι).subschemeι))
    (hxs : f.asFiber x ∈ (T.comap (f.fiberι (f x))).support) {c : ℕ}
    (hdim : topologicalKrullDimAt (T.comap (f.fiberι (f x))).subscheme ⟨f.asFiber x, hxs⟩
        + (c : WithBot ℕ∞) = topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x))
    (g : Fin c → (f.fiber (f x)).presheaf.stalk (f.asFiber x))
    (hg : stalkIdeal (T.comap (f.fiberι (f x))) (f.asFiber x) hxs = Ideal.span (Set.range g)) :
    IsRegular ((f.fiber (f x)).presheaf.stalk (f.asFiber x)) (List.ofFn g) := by
  classical
  set D : (f.fiber (f x)).IdealSheafData := T.comap (f.fiberι (f x))
  set z : D.subscheme := ⟨f.asFiber x, hxs⟩
  have _ : IsLocallyNoetherian (f.fiber (f x)) := isLocallyNoetherian_fiber f (f x)
  let k := S.residueField (f x)
  let q : f.fiber (f x) ⟶ Spec (.of k) := f.fiberToSpecResidueField (f x)
  have _ : LocallyOfFiniteType q := by
    change LocallyOfFiniteType (pullback.snd f (S.fromSpecResidueField (f x)))
    infer_instance
  -- a regular generating family of the ideal in the local ring of the fibre
  obtain ⟨V, hxV, hIQR⟩ := hfib
  have hVsupp : (⟨f.asFiber x, hxV⟩ : V.toScheme) ∈ (D.comap V.ι).support := by
    rwa [Scheme.IdealSheafData.support_comap]
  obtain ⟨r, d, hdspan, hdqr⟩ := exists_span_eq_stalkIdeal_of_isOpenImmersion D V.ι
    ⟨f.asFiber x, hxV⟩ (f.asFiber x) rfl hVsupp hxs hIQR
  have hdmem : ∀ a ∈ List.ofFn d,
      a ∈ IsLocalRing.maximalIdeal ((f.fiber (f x)).presheaf.stalk (f.asFiber x)) := by
    intro a ha
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp ha
    refine IsLocalRing.le_maximalIdeal (stalkIdeal_ne_top D _ hxs) ?_
    rw [hdspan]
    exact Ideal.subset_span ⟨i, rfl⟩
  have hdreg : IsRegular ((f.fiber (f x)).presheaf.stalk (f.asFiber x)) (List.ofFn d) :=
    IsRegular.of_isQuasiRegular_of_mem_maximalIdeal hdmem hdqr
  -- the ideal cut out in the local ring, in the spelling the dimension lemma uses
  have hstalk : IdealSheafData.stalk D (D.subschemeι z) = Ideal.ofList (List.ofFn d) := by
    rw [Ideal.ofList_ofFn, ← hdspan, ← IdealSheafData.ker_stalkMap_subschemeι D z]
    rfl
  -- the dimension drop names the length
  have hlen : c = (List.ofFn d).length :=
    length_eq_of_topologicalKrullDimAt_add k q D z (List.ofFn d) hdreg hstalk hdim
  -- two generating families of the same length of such an ideal are both regular
  refine Koszul.isRegular_of_ofList_eq_of_length_eq (List.ofFn g) (List.ofFn d)
    (by simpa using hlen) ?_ hdreg
  rw [Ideal.ofList_ofFn, Ideal.ofList_ofFn, ← hg, hdspan]

end Stacks.AlgebraicGeometry

end
