module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularIdealSheaf.Spreading
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RelativeRegularImmersion.StalkIdeal

/-!
# A closed subscheme cut out by a weakly regular family on an affine open

Let `T` be an ideal sheaf on a scheme `X` and let `V` be an affine open of `X` over which the
ideal of `T` is generated by a family of sections which is weakly regular in `Γ(X, V)`.  Then the
closed immersion of `T` restricted to `V` is a quasi-regular immersion.

## Main results

* `Stacks.AlgebraicGeometry.appIso_ι_inv_hom`: the comparison on sections of the inclusion of an
  open subscheme is the identity.
* `Stacks.AlgebraicGeometry.ideal_comap_ι_top`: the ideal of the restriction of an ideal sheaf to
  an affine open, taken over the whole of that open, is the image of the ideal of sections.
* `Stacks.AlgebraicGeometry.isQuasiRegularImmersion_comap_of_isWeaklyRegular`: the criterion.

## Implementation notes

`Γ(V.toScheme, ⊤)` is `Γ(X, V.ι ''ᵁ ⊤)` by definition and
`AlgebraicGeometry.Scheme.Opens.topIso` is the comparison with `Γ(X, V)`.  The ideal of a
restricted ideal sheaf over the whole of the open is computed by
`AlgebraicGeometry.Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion`, whose comparison
isomorphism is the identity for the inclusion of an open
(`AlgebraicGeometry.Scheme.Opens.ι_appIso`), followed by the quasi-coherence of an ideal sheaf
(`AlgebraicGeometry.Scheme.IdealSheafData.map_ideal'`) for the two equal affine opens
`V.ι ''ᵁ ⊤` and `V`.

The affine criterion of Stacks tag 063G asks, at every point of the support, for an affine open
carrying generators;  here the single affine open `⊤` of `V.toScheme` serves for every point, so
the whole of `V` has to carry the family.  Weak regularity is turned into quasi-regularity by
Stacks tags 062F and 062I before being transported, since the transport is along a ring
isomorphism and therefore flat.

## References

* [Stacks Project, Lemma 31.20.2 (Tag 063G)](https://stacks.math.columbia.edu/tag/063G)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry RingTheory.Sequence
open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.AlgebraicGeometry

universe u

variable {X : Scheme.{u}}

/-- The comparison isomorphism on sections of the inclusion of an open subscheme is the
identity. -/
theorem appIso_ι_inv_hom (V : X.Opens) (W : V.toScheme.Opens) :
    (V.ι.appIso W).inv.hom = RingHom.id Γ(X, V.ι ''ᵁ W) := by
  rw [Scheme.Opens.ι_appIso]
  rfl

/-- **The ideal of a restricted ideal sheaf over the whole of an affine open.** -/
theorem ideal_comap_ι_top (T : X.IdealSheafData) {V : X.Opens} (hV : IsAffineOpen V)
    (hVtop : IsAffineOpen (⊤ : V.toScheme.Opens)) :
    (T.comap V.ι).ideal ⟨⊤, hVtop⟩ = Ideal.map V.topIso.inv.hom (T.ideal ⟨V, hV⟩) := by
  refine (Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion T V.ι ⟨⊤, hVtop⟩).trans
    (Eq.trans ?_ (T.map_ideal' (U := ⟨V.ι ''ᵁ (⊤ : V.toScheme.Opens),
      hVtop.image_of_isOpenImmersion V.ι⟩) (V := ⟨V, hV⟩)
      ((eqToIso V.ι_image_top.symm).op).inv).symm)
  exact (congrArg (fun φ : Γ(X, V.ι ''ᵁ (⊤ : V.toScheme.Opens)) →+*
      Γ(X, V.ι ''ᵁ (⊤ : V.toScheme.Opens)) =>
    Ideal.comap φ (T.ideal ⟨V.ι ''ᵁ (⊤ : V.toScheme.Opens),
      hVtop.image_of_isOpenImmersion V.ι⟩)) (appIso_ι_inv_hom V ⊤)).trans (Ideal.comap_id _)

/-- **A closed subscheme cut out by a weakly regular family on an affine open is a quasi-regular
immersion.**  If the ideal of `T` over an affine open `V` is generated by a family which is weakly
regular in `Γ(X, V)`, then the closed immersion of `T` restricted to `V` is quasi-regular. -/
theorem isQuasiRegularImmersion_comap_of_isWeaklyRegular (T : X.IdealSheafData) {V : X.Opens}
    (hV : IsAffineOpen V) {r : ℕ} (c : Fin r → Γ(X, V))
    (hgen : T.ideal ⟨V, hV⟩ = Ideal.span (Set.range c))
    (hwr : IsWeaklyRegular Γ(X, V) (List.ofFn c)) :
    IsQuasiRegularImmersion (T.comap V.ι).subschemeι := by
  have _ : IsAffine V.toScheme := hV
  have hVtop : IsAffineOpen (⊤ : V.toScheme.Opens) := isAffineOpen_top V.toScheme
  have hker : RingHom.ker ((T.comap V.ι).subschemeι.app (⊤ : V.toScheme.Opens)).hom =
      Ideal.span (Set.range fun i => V.topIso.inv.hom (c i)) :=
    ((T.comap V.ι).ker_subschemeι_app ⟨⊤, hVtop⟩).trans
      ((ideal_comap_ι_top T hV hVtop).trans (by
        rw [hgen, Ideal.map_span, ← Set.range_comp]
        rfl))
  refine isQuasiRegularImmersion_of_isQuasiRegularIdealSheaf _ ?_
  refine (isQuasiRegularIdealSheaf_iff_exists_affine_generators V.toScheme _).mpr fun z _ => ?_
  refine ⟨⟨⊤, hVtop⟩, trivial, r, _,
    isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span _ hVtop _ hker, ?_⟩
  have hqr := Koszul.isQuasiRegular_map_of_flat V.topIso.inv.hom
    (RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso V.topIso.inv))
    (isQuasiRegular_of_isWeaklyRegular _ hwr)
  simpa only [List.map_ofFn, Function.comp_def] using hqr

end Stacks.AlgebraicGeometry

end
