module

public import Mathlib.RingTheory.TensorProduct.Quotient
public import StacksFrontier.AlgebraicGeometry.SyntomicLocus.Algebra
public import StacksFrontier.AlgebraicGeometry.RegularImmersion.Sequence
public import StacksFrontier.RingTheory.CompleteIntersection.LocalRing
public import StacksFrontier.RingTheory.Smooth.RegularRing
