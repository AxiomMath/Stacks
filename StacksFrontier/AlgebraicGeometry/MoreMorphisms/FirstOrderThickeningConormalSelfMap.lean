module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.MapDerivationActionDifference
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.MapDerivationActionGlobal
public import StacksFrontier.AlgebraicGeometry.Scheme.AffineOpenNeighborhood
public import StacksFrontier.AlgebraicGeometry.Scheme.AffineOpenSectionExt

/-!
# A self-map of a first-order thickening fixing the subscheme, on the conormal sheaf

Let `i : X ⟶ X'` be a first-order thickening — a closed immersion whose defining ideal is
square-zero — and let `σ : X' ⟶ X'` be a self-map of the ambient scheme with `i ≫ σ = i`, that is,
one restricting to the identity of the closed subscheme. Such a `σ` carries the defining ideal of
`i` into itself, and since for a first-order thickening the defining ideal *is* the conormal sheaf
`𝒞_{X/X'}` of [Stacks Project, Tag 01R2], it induces an endomorphism of the conormal sections.

No hypothesis is placed on `σ` beyond `i ≫ σ = i`: in particular `σ` is not assumed to lie over
anything, so it may cover a nontrivial self-map of a base scheme.

## Main definitions

* `Stacks.Thickenings.conormalSelfMap`: the endomorphism of the conormal sections induced by a
  self-map of the ambient scheme fixing the closed subscheme.

## Main results

* `Stacks.Thickenings.conormalSection_conormalClass`: the inclusion `𝒞_{X/X'} ⟶ 𝒪_{X'}` of a
  first-order thickening sends the conormal class of a section of the defining ideal to that
  section.
* `Stacks.Thickenings.range_conormalSection`: the conormal sections over `V` are exactly the
  defining ideal over `V`.
* `Stacks.Thickenings.app_app_eq_zero_of_comp_eq_self`: a self-map fixing the subscheme carries the
  defining ideal into the defining ideal over the preimage open.
* `Stacks.Thickenings.conormalSection_conormalSelfMap`: the image of the endomorphism in `𝒪_{X'}`
  over `σ⁻¹V` is `σ^♯` of the image of the section it is applied to.
* `Stacks.Thickenings.eq_conormalSelfMap`: that property determines the endomorphism.
* `Stacks.Thickenings.conormalSelfMap_add` and `Stacks.Thickenings.conormalSelfMap_zero`: it is
  additive.
* `Stacks.Thickenings.conormalSelfMap_smul`: it is semilinear over `σ^♯`.
* `Stacks.Thickenings.appLE_self_eq_mul_of_ker_eq_span`: if the defining ideal over an open is
  generated by one function and `σ^♯` scales that function by `c`, then `σ^♯` is multiplication by
  `c` on the whole ideal there.
* `Stacks.Thickenings.appLE_eq_mul_of_affineOpens_ker_eq_span`: the same conclusion over an
  arbitrary open from generation on the affine opens inside it.

## References

* [Stacks Project, Tag 01R2](https://stacks.math.columbia.edu/tag/01R2)
* [Stacks Project, Tag 01R4](https://stacks.math.columbia.edu/tag/01R4)
* [Stacks Project, Tag 0E3V](https://stacks.math.columbia.edu/tag/0E3V)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry
open RingedSpaceModuleAdjunction AlgebraicGeometry.RingedSpace

universe u

namespace Stacks.Thickenings

variable {X X' : Scheme.{u}} {i : X ⟶ X'} [IsClosedImmersion i]

/-! ### The conormal sections of a first-order thickening are the defining ideal -/

/-- For a first-order thickening, the inclusion `𝒞_{X/X'} ⟶ 𝒪_{X'}` sends the conormal class of a
section `g` of the defining ideal over `V` to `g`. -/
theorem conormalSection_conormalClass (hsq : i.ker ^ 2 = ⊥) (V : X'.Opens) (g : Γ(X', V))
    (hg : (i.app V).hom g = 0) :
    conormalSection hsq V (Stacks.Conormal.conormalClass i V le_rfl g hg) = g := by
  obtain ⟨y, hy⟩ := Stacks.ClosedImmersion.exists_idealSheaf_section_of_app_eq_zero
    i.toLRSHom.toShHom V g hg
  have hcl : Stacks.Conormal.conormalClass i V le_rfl g hg =
      (Stacks.Immersion.canonicalConormalQuotientMap i).val.app (op V) y :=
    (Stacks.Conormal.conormalClass_eq_canonicalConormalQuotientMap i V le_rfl g hg y hy).trans
      (Stacks.Conormal.conormalSheaf_map_self i le_rfl _)
  rw [hcl]
  have hpin := congrArg (fun φ ↦ φ.val.app (op V) y)
    (canonicalConormalQuotientMap_comp_firstOrderImmersionConormalSheafι i hsq)
  have hsplit := comp_val_app_apply (Stacks.Immersion.canonicalConormalQuotientMap i)
    (firstOrderImmersionConormalSheafι i hsq) (op V) y
  exact (hsplit.symm.trans hpin).trans hy

/-- Every section of the defining ideal of a first-order thickening is a conormal section. -/
theorem exists_conormalSection_eq (hsq : i.ker ^ 2 = ⊥) (V : X'.Opens) {g : Γ(X', V)}
    (hg : (i.app V).hom g = 0) :
    ∃ s : Γ(conormalModules i, i ⁻¹ᵁ V), conormalSection hsq V s = g :=
  ⟨_, conormalSection_conormalClass hsq V g hg⟩

/-- The conormal sections of a first-order thickening over `V` are exactly the defining ideal over
`V`. -/
theorem range_conormalSection (hsq : i.ker ^ 2 = ⊥) (V : X'.Opens) :
    Set.range (conormalSection hsq V) = (RingHom.ker (i.app V).hom : Set Γ(X', V)) := by
  ext g
  simp only [Set.mem_range, SetLike.mem_coe, RingHom.mem_ker]
  refine ⟨?_, fun hg ↦ exists_conormalSection_eq hsq V hg⟩
  rintro ⟨s, rfl⟩
  exact RingHom.mem_ker.mp (conormalSection_mem_ker hsq V s)

/-! ### A self-map of the ambient scheme fixing the subscheme, on the conormal sheaf -/

variable {σ : X' ⟶ X'}

omit [IsClosedImmersion i] in
/-- A self-map of the ambient scheme fixing the closed subscheme is the right arrow of a commuting
square of immersions whose left arrow is `i` and whose bottom arrow is the identity of `X`. -/
theorem comp_eq_id_comp_of_comp_eq_self (hσ : i ≫ σ = i) : i ≫ σ = 𝟙 X ≫ i :=
  hσ.trans (Category.id_comp i).symm

omit [IsClosedImmersion i] in
/-- A self-map of the ambient scheme fixing the subscheme carries the defining ideal into the
defining ideal: for `σ : X' ⟶ X'` with `i ≫ σ = i`, a section of `𝒪_{X'}` over `V` killed by `i^♯`
is carried by `σ^♯` to a section over `σ⁻¹V` killed by `i^♯`. -/
theorem app_app_eq_zero_of_comp_eq_self (hσ : i ≫ σ = i) (V : X'.Opens) {g : Γ(X', V)}
    (hg : (i.app V).hom g = 0) : (i.app (σ ⁻¹ᵁ V)).hom ((σ.app V).hom g) = 0 :=
  Stacks.Conormal.app_app_eq_zero_of_square (comp_eq_id_comp_of_comp_eq_self hσ) V g hg

/-- The endomorphism of the conormal sections of a first-order thickening induced by a self-map of
the ambient scheme fixing the closed subscheme. For `σ : X' ⟶ X'` with `i ≫ σ = i` and an open `V`
of `X'`, this is the composite

`Γ(𝒞_{X/X'}, i⁻¹V) --ι--> Γ(X', V) --σ^♯--> Γ(X', σ⁻¹V) --class--> Γ(𝒞_{X/X'}, i⁻¹V)`,

where the last map takes the conormal class, read over `i ⁻¹ᵁ (σ ⁻¹ᵁ V) = i ⁻¹ᵁ V`. -/
def conormalSelfMap (hsq : i.ker ^ 2 = ⊥) (hσ : i ≫ σ = i) (V : X'.Opens)
    (s : Γ(conormalModules i, i ⁻¹ᵁ V)) : Γ(conormalModules i, i ⁻¹ᵁ V) :=
  Stacks.Conormal.conormalClass i (σ ⁻¹ᵁ V) (preimage_preimage_of_comp_eq_self hσ V).ge
    ((σ.app V).hom (conormalSection hsq V s))
    (app_app_eq_zero_of_comp_eq_self hσ V
      (RingHom.mem_ker.mp (conormalSection_mem_ker hsq V s)))

/-- `σ^♯` of a conormal section, read in `𝒪_{X'}`, is killed by `i^♯` over `σ⁻¹V`. -/
private theorem app_app_conormalSection_eq_zero (hsq : i.ker ^ 2 = ⊥) (hσ : i ≫ σ = i)
    (V : X'.Opens) (s : Γ(conormalModules i, i ⁻¹ᵁ V)) :
    (i.app (σ ⁻¹ᵁ V)).hom ((σ.app V).hom (conormalSection hsq V s)) = 0 :=
  app_app_eq_zero_of_comp_eq_self hσ V (RingHom.mem_ker.mp (conormalSection_mem_ker hsq V s))

/-- If `σ^♯` of a conormal section is `x`, then `conormalSelfMap` is the conormal class of `x`. -/
private theorem conormalSelfMap_eq_conormalClass (hsq : i.ker ^ 2 = ⊥) (hσ : i ≫ σ = i)
    (V : X'.Opens) (s : Γ(conormalModules i, i ⁻¹ᵁ V)) {x : Γ(X', σ ⁻¹ᵁ V)}
    (h : (σ.app V).hom (conormalSection hsq V s) = x) (hx : (i.app (σ ⁻¹ᵁ V)).hom x = 0) :
    conormalSelfMap hsq hσ V s =
      Stacks.Conormal.conormalClass i (σ ⁻¹ᵁ V) (preimage_preimage_of_comp_eq_self hσ V).ge x
        hx := by
  subst h
  rfl

/-- Read inside `𝒪_{X'}` over `σ⁻¹V`, after restriction along the equality of opens
`i ⁻¹ᵁ (σ ⁻¹ᵁ V) ≤ i ⁻¹ᵁ V`, the endomorphism `Stacks.Thickenings.conormalSelfMap` is `σ^♯`. -/
theorem conormalSection_conormalSelfMap (hsq : i.ker ^ 2 = ⊥) (hσ : i ≫ σ = i) (V : X'.Opens)
    (s : Γ(conormalModules i, i ⁻¹ᵁ V)) :
    conormalSection hsq (σ ⁻¹ᵁ V)
        ((conormalModules i).presheaf.map
          (homOfLE (preimage_preimage_of_comp_eq_self hσ V).le).op
          (conormalSelfMap hsq hσ V s))
      = (σ.app V).hom (conormalSection hsq V s) := by
  have hker := app_app_conormalSection_eq_zero hsq hσ V s
  have hrestrict :
      (conormalModules i).presheaf.map
            (homOfLE (preimage_preimage_of_comp_eq_self hσ V).le).op
            (conormalSelfMap hsq hσ V s)
          = Stacks.Conormal.conormalClass i (σ ⁻¹ᵁ V) le_rfl
              ((σ.app V).hom (conormalSection hsq V s)) hker :=
    Stacks.Conormal.conormalClass_restrict_target i (σ ⁻¹ᵁ V)
      (preimage_preimage_of_comp_eq_self hσ V).ge le_rfl
      (preimage_preimage_of_comp_eq_self hσ V).le
      ((σ.app V).hom (conormalSection hsq V s)) hker
  rw [hrestrict]
  exact conormalSection_conormalClass hsq (σ ⁻¹ᵁ V)
    ((σ.app V).hom (conormalSection hsq V s)) hker

/-- Restriction of conormal sections along `i ⁻¹ᵁ (σ ⁻¹ᵁ V) ≤ i ⁻¹ᵁ V` is injective. -/
theorem injective_conormalModules_map_of_comp_eq_self (hσ : i ≫ σ = i) (V : X'.Opens) :
    Function.Injective fun s : Γ(conormalModules i, i ⁻¹ᵁ V) ↦
      (conormalModules i).presheaf.map
        (homOfLE (preimage_preimage_of_comp_eq_self hσ V).le).op s := by
  intro s t h
  have key : ∀ x : Γ(conormalModules i, i ⁻¹ᵁ V),
      (conormalModules i).val.map
          (homOfLE (preimage_preimage_of_comp_eq_self hσ V).ge).op
          ((conormalModules i).val.map
            (homOfLE (preimage_preimage_of_comp_eq_self hσ V).le).op x) = x := fun x =>
    (val_map_unique (conormalModules i)
      (homOfLE (preimage_preimage_of_comp_eq_self hσ V).le)
      (homOfLE (preimage_preimage_of_comp_eq_self hσ V).ge) (𝟙 _) x).trans
      (congr($((conormalModules i).val.map_id (op (i ⁻¹ᵁ V))) x))
  exact ((key s).symm.trans (congrArg ((conormalModules i).val.map
    (homOfLE (preimage_preimage_of_comp_eq_self hσ V).ge).op) h)).trans (key t)

/-- A conormal section `t` whose image inside `𝒪_{X'}` over `σ⁻¹V` is `σ^♯` of the image of `s` is
`Stacks.Thickenings.conormalSelfMap` applied to `s`. -/
theorem eq_conormalSelfMap (hsq : i.ker ^ 2 = ⊥) (hσ : i ≫ σ = i) (V : X'.Opens)
    (s t : Γ(conormalModules i, i ⁻¹ᵁ V))
    (h : conormalSection hsq (σ ⁻¹ᵁ V)
          ((conormalModules i).presheaf.map
            (homOfLE (preimage_preimage_of_comp_eq_self hσ V).le).op t)
        = (σ.app V).hom (conormalSection hsq V s)) :
    t = conormalSelfMap hsq hσ V s :=
  injective_conormalModules_map_of_comp_eq_self hσ V
    (injective_firstOrderImmersionConormalSheafι_val_app i hsq (σ ⁻¹ᵁ V)
      (h.trans (conormalSection_conormalSelfMap hsq hσ V s).symm))

/-- `Stacks.Thickenings.conormalSelfMap` is additive. -/
theorem conormalSelfMap_add (hsq : i.ker ^ 2 = ⊥) (hσ : i ≫ σ = i) (V : X'.Opens)
    (s t : Γ(conormalModules i, i ⁻¹ᵁ V)) :
    conormalSelfMap hsq hσ V (s + t)
      = conormalSelfMap hsq hσ V s + conormalSelfMap hsq hσ V t := by
  have hs := app_app_conormalSection_eq_zero hsq hσ V s
  have ht := app_app_conormalSection_eq_zero hsq hσ V t
  have hsum : (i.app (σ ⁻¹ᵁ V)).hom ((σ.app V).hom (conormalSection hsq V s)
      + (σ.app V).hom (conormalSection hsq V t)) = 0 := by
    rw [map_add, hs, ht, add_zero]
  rw [conormalSelfMap_eq_conormalClass hsq hσ V (s + t)
      (by rw [conormalSection_add, map_add]) hsum,
    conormalSelfMap_eq_conormalClass hsq hσ V s rfl hs,
    conormalSelfMap_eq_conormalClass hsq hσ V t rfl ht]
  exact Stacks.Conormal.conormalClass_add i (σ ⁻¹ᵁ V)
    (preimage_preimage_of_comp_eq_self hσ V).ge _ _ hs ht hsum

/-- `Stacks.Thickenings.conormalSelfMap` sends zero to zero. -/
theorem conormalSelfMap_zero (hsq : i.ker ^ 2 = ⊥) (hσ : i ≫ σ = i) (V : X'.Opens) :
    conormalSelfMap hsq hσ V (0 : Γ(conormalModules i, i ⁻¹ᵁ V)) = 0 := by
  have h0 : (i.app (σ ⁻¹ᵁ V)).hom (0 : Γ(X', σ ⁻¹ᵁ V)) = 0 := map_zero _
  rw [conormalSelfMap_eq_conormalClass hsq hσ V 0
    (by rw [conormalSection_zero, map_zero]) h0]
  exact Stacks.Conormal.conormalClass_zero i (σ ⁻¹ᵁ V)
    (preimage_preimage_of_comp_eq_self hσ V).ge h0

/-- `Stacks.Thickenings.conormalSelfMap` is semilinear over `σ^♯`: a scalar `ρ : Γ(X', V)` acting
on a conormal section through `i^♯` comes out as the restriction to `X` of `σ^♯ρ`. -/
theorem conormalSelfMap_smul (hsq : i.ker ^ 2 = ⊥) (hσ : i ≫ σ = i) (V : X'.Opens)
    (ρ : Γ(X', V)) (s : Γ(conormalModules i, i ⁻¹ᵁ V)) :
    conormalSelfMap hsq hσ V ((i.app V).hom ρ • s)
      = (i.appLE (σ ⁻¹ᵁ V) (i ⁻¹ᵁ V)
            (preimage_preimage_of_comp_eq_self hσ V).ge).hom ((σ.app V).hom ρ)
          • conormalSelfMap hsq hσ V s := by
  have hs := app_app_conormalSection_eq_zero hsq hσ V s
  have hsr : (i.app (σ ⁻¹ᵁ V)).hom ((σ.app V).hom ρ
      * (σ.app V).hom (conormalSection hsq V s)) = 0 := by
    rw [map_mul, hs, mul_zero]
  rw [conormalSelfMap_eq_conormalClass hsq hσ V _
      (by rw [conormalSection_smul, map_mul]) hsr,
    conormalSelfMap_eq_conormalClass hsq hσ V s rfl hs]
  exact Stacks.Conormal.conormalClass_mul_left i (σ ⁻¹ᵁ V)
    (preimage_preimage_of_comp_eq_self hσ V).ge _ _ hs hsr

/-! ### A self-map scaling a generator of the defining ideal scales the whole ideal -/

omit [IsClosedImmersion i] in
/-- For `σ : X' ⟶ X'` with `i ≫ σ = i` and an open `A` of `X'` with `A ≤ σ⁻¹A`, the composite

`Γ(X', A) --σ^♯--> Γ(X', A) --i^♯--> Γ(X, i⁻¹A)`

is `i^♯`. -/
theorem appLE_self_comp_app_of_comp_eq_self (hσ : i ≫ σ = i) {A : X'.Opens}
    (hA : A ≤ σ ⁻¹ᵁ A) : σ.appLE A A hA ≫ i.app A = i.app A := by
  rw [Scheme.Hom.appLE, Category.assoc, ← Scheme.Hom.appLE_eq_app (f := i) (U := A),
    Scheme.Hom.map_appLE, ← Scheme.Hom.appLE_eq_app (f := σ) (U := A),
    Scheme.Hom.appLE_comp_appLE]
  exact appLE_congr_hom hσ A (i ⁻¹ᵁ A) _ _

/-- Let `i : X ⟶ X'` be a first-order thickening, `σ : X' ⟶ X'` a self-map with `i ≫ σ = i`, and
`A` an open of `X'` carried into its own `σ`-preimage. Suppose the defining ideal over `A` is
generated by a single function `e` and that `σ^♯ e = c e`. Then `σ^♯ g = c g` for every section `g`
of the defining ideal over `A`. -/
theorem appLE_self_eq_mul_of_ker_eq_span (hsq : i.ker ^ 2 = ⊥) (hσ : i ≫ σ = i) {A : X'.Opens}
    (hA : A ≤ σ ⁻¹ᵁ A) {e c g : Γ(X', A)}
    (hgen : RingHom.ker (i.app A).hom = Ideal.span {e})
    (hscal : (σ.appLE A A hA).hom e = c * e) (hg : (i.app A).hom g = 0) :
    (σ.appLE A A hA).hom g = c * g := by
  obtain ⟨ρ, hρ⟩ :=
    Ideal.mem_span_singleton'.mp (hgen ▸ RingHom.mem_ker.mpr hg : g ∈ Ideal.span {e})
  have hd : (i.app A).hom ((σ.appLE A A hA).hom ρ - ρ) = 0 := by
    rw [map_sub, sub_eq_zero]
    exact congrArg (fun z : Γ(X', A) ⟶ Γ(X, i ⁻¹ᵁ A) => z.hom ρ)
      (appLE_self_comp_app_of_comp_eq_self hσ hA)
  have he : (i.app A).hom e = 0 := by
    rw [← RingHom.mem_ker, hgen]
    exact Ideal.mem_span_singleton_self e
  have h0 : ((σ.appLE A A hA).hom ρ - ρ) * e = 0 := by
    have hm : ((σ.appLE A A hA).hom ρ - ρ) * e ∈ RingHom.ker (i.app A).hom ^ 2 := by
      rw [pow_two]
      exact Ideal.mul_mem_mul (RingHom.mem_ker.mpr hd) (RingHom.mem_ker.mpr he)
    rw [ker_app_sq_eq_bot i hsq A] at hm
    simpa using hm
  subst hρ
  rw [map_mul, hscal]
  linear_combination c * h0

/-- Let `i : X ⟶ X'` be a first-order thickening, `σ : X' ⟶ X'` a self-map with `i ≫ σ = i`, and
`B ≤ A` opens of `X'` with `B ≤ σ⁻¹A`. Suppose that on every affine open `W ⊆ B` the defining ideal
is generated by the restriction of `e`, and that `σ^♯ e` is the restriction of `c e` to `B`. Then
for every section `g` of the defining ideal over `A`, `σ^♯ g` is the restriction of `c g` to `B`.
-/
theorem appLE_eq_mul_of_affineOpens_ker_eq_span (hsq : i.ker ^ 2 = ⊥) (hσ : i ≫ σ = i)
    {A B : X'.Opens} (hBσ : B ≤ σ ⁻¹ᵁ A) (hBA : B ≤ A) {e c g : Γ(X', A)}
    (hgen : ∀ (W : X'.affineOpens) (hW : W.1 ≤ B),
      RingHom.ker (i.app W.1).hom
        = Ideal.span {(X'.presheaf.map (homOfLE (hW.trans hBA)).op).hom e})
    (hscal : (σ.appLE A B hBσ).hom e = (X'.presheaf.map (homOfLE hBA).op).hom (c * e))
    (hg : (i.app A).hom g = 0) :
    (σ.appLE A B hBσ).hom g = (X'.presheaf.map (homOfLE hBA).op).hom (c * g) := by
  have hpre : ∀ W : X'.Opens, σ ⁻¹ᵁ W = W := fun W =>
    preimage_eq_of_comm (a' := 𝟙 X') (a := 𝟙 X) (j := i) hsq
      ((Category.comp_id i).trans (Category.id_comp i).symm)
      (hσ.trans (Category.id_comp i).symm) W
  have hfac : ∀ (W : X'.Opens) (hWB : W ≤ B),
      σ.appLE A B hBσ ≫ X'.presheaf.map (homOfLE hWB).op
        = X'.presheaf.map (homOfLE (hWB.trans hBA)).op ≫ σ.appLE W W (hpre W).ge := by
    intro W hWB
    rw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
  have hres : ∀ (W : X'.Opens) (hWB : W ≤ B) (y : Γ(X', A)),
      (X'.presheaf.map (homOfLE hWB).op).hom ((X'.presheaf.map (homOfLE hBA).op).hom y)
        = (X'.presheaf.map (homOfLE (hWB.trans hBA)).op).hom y := by
    intro W hWB y
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  refine AlgebraicGeometry.section_ext_of_affineOpens fun W hW => ?_
  rw [hres W.1 hW, ← ConcreteCategory.comp_apply, hfac W.1 hW, ConcreteCategory.comp_apply,
    map_mul]
  refine appLE_self_eq_mul_of_ker_eq_span hsq hσ _ (hgen W hW) ?_ ?_
  · have h := congrArg (X'.presheaf.map (homOfLE hW).op).hom hscal
    rwa [← ConcreteCategory.comp_apply, hfac W.1 hW, ConcreteCategory.comp_apply,
      hres W.1 hW, map_mul] at h
  · have h := congrArg (fun z : Γ(X', A) ⟶ Γ(X, i ⁻¹ᵁ W.1) => z.hom g)
      (Scheme.Hom.naturality i (homOfLE (hW.trans hBA)).op)
    simp only [ConcreteCategory.comp_apply] at h
    rw [h, hg, map_zero]

end Stacks.Thickenings

end
