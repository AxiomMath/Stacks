-/

@[expose] public section

open CategoryTheory IsLocalRing

universe u

namespace AlgebraicGeometry

/-- **The slicing sequence of the étale chart construction of Stacks 06N3.**  Let
`a, b : R ⟶ U` with `b` smooth, let `r₀ : R`, and suppose that the maximal ideal of
`𝒪_{U, a r₀}` generates, along `a`, the maximal ideal of the local ring of the fibre of `b`
through `r₀` — the source's `φ(𝔪_u) 𝒪_{V, v} = 𝔪_v` of **Stacks 02GF**.  Then there are `d`
elements of the maximal ideal of `𝒪_{U, a r₀}` whose germs, pulled back along `a` and restricted
to the fibre of `b`, form a regular sequence in `𝒪_{b.fiber (b r₀), r₀}` **generating its
maximal ideal**, with `d` the Krull dimension of that local ring.

The local ring of the fibre of the smooth `b` is a regular local ring
(`AlgebraicGeometry.isRegularLocalRing_fiberStalk_of_smooth`), so the hypothesis makes its
maximal ideal generated by the images of `(𝔪).spanFinrank` elements of `𝔪_{a r₀}`
(`IsLocalRing.exists_fn_mem_maximalIdeal_ofList_map_eq_maximalIdeal`), and a minimal generating
set of the maximal ideal of a regular local ring is a regular sequence (**Stacks 00NQ**), of
length the dimension.

Because the sequence generates the maximal ideal, the quotient of the fibre stalk by it is the
residue field `κ(r₀)` and not merely a zero-dimensional ring;  that is what distinguishes this
from `AlgebraicGeometry.exists_mem_maximalIdeal_isRegular_fiberStalk_of_smooth`, whose sequence
comes from **Stacks 06LC** and only cuts the dimension to zero. -/
theorem exists_mem_maximalIdeal_isRegular_ofList_eq_maximalIdeal_fiberStalk_of_smooth
    {R U : Scheme.{u}} (a b : R ⟶ U) [Smooth b] (r₀ : R)
    (hmap : Ideal.map ((b.fiberι (b r₀) ≫ a).stalkMap (b.asFiber r₀)).hom
          (maximalIdeal (U.presheaf.stalk ((b.fiberι (b r₀) ≫ a) (b.asFiber r₀))))
        = maximalIdeal ((b.fiber (b r₀)).presheaf.stalk (b.asFiber r₀))) :
    ∃ (d : ℕ) (t : Fin d → U.presheaf.stalk (a r₀)),
      (∀ i, t i ∈ maximalIdeal (U.presheaf.stalk (a r₀))) ∧
        ((d : ℕ) : WithBot ℕ∞) =
          ringKrullDim ((b.fiber (b r₀)).presheaf.stalk (b.asFiber r₀)) ∧
        RingTheory.Sequence.IsRegular ((b.fiber (b r₀)).presheaf.stalk (b.asFiber r₀))
          (List.ofFn fun i => ((b.fiberι (b r₀)).stalkMap (b.asFiber r₀)).hom
            ((b.fiberι_asFiber r₀).symm ▸ (a.stalkMap r₀).hom (t i))) ∧
        Ideal.ofList
            (List.ofFn fun i => ((b.fiberι (b r₀)).stalkMap (b.asFiber r₀)).hom
              ((b.fiberι_asFiber r₀).symm ▸ (a.stalkMap r₀).hom (t i)))
          = maximalIdeal ((b.fiber (b r₀)).presheaf.stalk (b.asFiber r₀)) := by
  classical
  have hreglocal := isRegularLocalRing_fiberStalk_of_smooth b r₀
  -- the minimal generating family of `𝔪_B` inside the image of `𝔪_{a r₀}`
  obtain ⟨t, htmem, htspan⟩ :=
    IsLocalRing.exists_fn_mem_maximalIdeal_ofList_map_eq_maximalIdeal
      ((b.fiberι (b r₀) ≫ a).stalkMap (b.asFiber r₀)).hom hmap
  -- Stacks 00NQ: a minimal generating family of the maximal ideal of a regular local ring is a
  -- regular sequence
  have hreg :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
        ((b.fiber (b r₀)).presheaf.stalk (b.asFiber r₀))).1
      (List.ofFn fun i => ((b.fiberι (b r₀) ≫ a).stalkMap (b.asFiber r₀)).hom (t i))
      htspan (by rw [List.length_ofFn])
  -- the length is the dimension, the maximal ideal being minimally generated
  have hdim : (((maximalIdeal
        ((b.fiber (b r₀)).presheaf.stalk (b.asFiber r₀))).spanFinrank : ℕ) : WithBot ℕ∞)
      = ringKrullDim ((b.fiber (b r₀)).presheaf.stalk (b.asFiber r₀)) :=
    IsRegularLocalRing.spanFinrank_maximalIdeal
  -- read the family at `r₀` rather than at the image of the point of the fibre
  have hlist : (List.ofFn fun i => ((b.fiberι (b r₀)).stalkMap (b.asFiber r₀)).hom
        ((b.fiberι_asFiber r₀).symm ▸ (a.stalkMap r₀).hom
          ((congrArg a (b.fiberι_asFiber r₀)) ▸ t i)))
      = List.ofFn fun i =>
          ((b.fiberι (b r₀) ≫ a).stalkMap (b.asFiber r₀)).hom (t i) :=
    congrArg List.ofFn (funext fun i =>
      comp_stalkMap_cast (b.fiberι (b r₀)) a (b.asFiber r₀) (b.fiberι_asFiber r₀) (t i))
  exact ⟨_, fun i => (congrArg a (b.fiberι_asFiber r₀)) ▸ t i,
    fun i => mem_maximalIdeal_stalk_cast _ (htmem i), hdim,
    hlist ▸ hreg.1, hlist ▸ htspan⟩

end AlgebraicGeometry

end
