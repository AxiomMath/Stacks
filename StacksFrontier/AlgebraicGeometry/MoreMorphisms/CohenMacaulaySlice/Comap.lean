module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
public import Mathlib.AlgebraicGeometry.Morphisms.Affine
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.FinitePresentation
import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.Groupoids.IdealSheafComap
public import StacksFrontier.AlgebraicGeometry.KerDetected.RingColimit

/-!
# Pulling back the ideal sheaf of a zero scheme

Let `X` be an affine scheme, `I` an ideal of its global sections and `f : Y ⟶ X` an arbitrary
morphism.  The pullback of the ideal sheaf `V(I)` along `f` is the ideal sheaf of the zero
scheme of the image of `I` in `Γ(Y, ⊤)`.

This is the geometric form of the statement that the ideal of a closed subscheme base changes
by extension of scalars: on global sections the ideal of the pullback is the ideal generated by
the image of the original ideal, which is `Stacks.IdealSheaf.ideal_comap_top_of_isAffine`.

## Main results

* `Stacks.AlgebraicGeometry.comap_ofIdealTop`: the pullback of the ideal sheaf of a zero scheme
  is the ideal sheaf of the zero scheme of the extended ideal.

## References

* [Stacks Project, Lemma 37.24.1 (Tag 06LI)](https://stacks.math.columbia.edu/tag/06LI)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite AlgebraicGeometry

namespace Stacks.AlgebraicGeometry

universe u

variable {X Y : Scheme.{u}}

/-- Transporting an ideal along an equality of rings transports its image under a ring
homomorphism. -/
theorem ideal_map_heq {A A' B B' : CommRingCat.{u}} {f : A ⟶ B} {g : A' ⟶ B'} {I : Ideal A}
    {J : Ideal A'} (hA : A = A') (hB : B = B') (hf : HEq f.hom g.hom) (hI : HEq I J) :
    HEq (Ideal.map f.hom I) (Ideal.map g.hom J) := by
  cases hA
  cases hB
  cases CommRingCat.hom_ext (eq_of_heq hf)
  cases eq_of_heq hI
  rfl

/-- Restriction of global sections to two equal opens gives the same composite. -/
theorem restriction_comp_heq {V W : Y.Opens} (h : V = W) {R : CommRingCat.{u}}
    (g : R ⟶ Γ(Y, ⊤)) :
    HEq ((g ≫ Y.presheaf.map (homOfLE (show V ≤ ⊤ from le_top)).op).hom)
      ((g ≫ Y.presheaf.map (homOfLE (show W ≤ ⊤ from le_top)).op).hom) := by
  subst h; rfl

/-- **The pullback of the ideal sheaf of a zero scheme.**  If `X` is affine and `I` is an ideal
of `Γ(X, ⊤)`, the pullback of `V(I)` along `f : Y ⟶ X` is the zero scheme of the image of `I` in
`Γ(Y, ⊤)`. -/
theorem comap_ofIdealTop [IsAffine X] (f : Y ⟶ X) (I : Ideal Γ(X, ⊤)) :
    (Scheme.IdealSheafData.ofIdealTop I).comap f =
      Scheme.IdealSheafData.ofIdealTop (Ideal.map f.appTop.hom I) := by
  set T := Scheme.IdealSheafData.ofIdealTop I with hT
  ext1
  funext U
  have : IsAffine U.1.toScheme := U.2
  have h := Stacks.IdealSheaf.ideal_comap_top_of_isAffine T (U.1.ι ≫ f)
  have hI : T.ideal ⟨⊤, isAffineOpen_top X⟩ = I := by simp [hT]
  rw [hI, Scheme.IdealSheafData.comap_comp] at h
  have heq := (Stacks.Divisors.ideal_comap_top_heq (T.comap f) U).symm.trans (heq_of_eq h)
  rw [Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_map]
  have happ : HEq (U.1.ι ≫ f).appTop.hom
      (f.appTop ≫ Y.presheaf.map (homOfLE (show U.1 ≤ ⊤ from le_top)).op).hom := by
    rw [Scheme.Hom.comp_appTop, Scheme.Opens.ι_appTop]
    exact restriction_comp_heq (Scheme.Opens.ι_image_top U.1) f.appTop
  have hB : Γ(U.1.toScheme, ⊤) = Γ(Y, U.1) := by
    change Γ(Y, U.1.ι ''ᵁ ⊤) = Γ(Y, U.1)
    rw [Scheme.Opens.ι_image_top]
  exact eq_of_heq (heq.trans (ideal_map_heq rfl hB happ HEq.rfl))

end Stacks.AlgebraicGeometry

end
