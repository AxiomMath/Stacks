module

public import StacksFrontier.AlgebraicGeometry.RegularImmersion.Affine
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularImmersion.Composition
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Immersion

/-!
# The inclusion of an open subscheme is a regular immersion

The inclusion `U.ι : U ⟶ X` of an open subscheme is a regular immersion: it factors through the
open `U` itself as the identity, whose defining ideal is zero, and the zero ideal sheaf is
generated on every affine open by the empty family, which is a regular sequence.

## Main results

* `Stacks.AlgebraicGeometry.isRegularImmersion_ι`: the inclusion of an open subscheme is a
  regular immersion.

## Implementation notes

Regularity of an immersion may be tested on any open through which it factors as a closed
immersion (`Stacks.AlgebraicGeometry.isRegularImmersion_iff_of_open`), so for `U.ι` it suffices
to treat the identity of `U`.  Its defining ideal is the sectionwise kernel of the identity map
of `𝒪_U`, hence zero; the empty family of sections therefore generates it on every open, and
`List.ofFn` of the empty family is the empty list, which is weakly regular.  The support of the
quotient plays no role: the witness produced is the same for every point.

The general statement that a smooth morphism between smooth schemes over a base is a regular
immersion (Stacks tag 067U) would also give this, but is not needed.

## References

* [Stacks Project, Tag 063J](https://stacks.math.columbia.edu/tag/063J)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry
open Stacks.AlgebraicGeometry.QuasiRegular Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.AlgebraicGeometry

/-- The defining ideal of the identity of a scheme is generated over any open by the empty
family of sections: both are zero. -/
private theorem isGeneratedByOn_definingIdealOfHom_id (Y : Scheme.{u}) (V : Y.Opens) :
    IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom (𝟙 Y)) V
      (Fin.elim0 : Fin 0 → Γ(Y, V)) := by
  intro W _
  refine le_antisymm (fun s hs => ?_) ?_
  · have h0 : s = 0 := (mem_definingIdealOfHom_iff_app (𝟙 Y) W s).mp hs
    rw [h0]
    exact zero_mem _
  · have hle : generatedIdealOn Y.toRingedSpace V (Fin.elim0 : Fin 0 → Γ(Y, V)) ≤
        definingIdealOfHom (𝟙 Y) :=
      generatedIdealOn_le Y.toRingedSpace V _ (definingIdealOfHom (𝟙 Y)) fun i => i.elim0
    exact PresheafOfModules.Submodule.le_iff.mp (SheafOfModules.Submodule.le_iff.mp hle) (op W)

/-- The defining ideal of the identity of a scheme is a regular ideal sheaf. -/
private theorem isRegularIdealSheaf_definingIdealOfHom_id (Y : Scheme.{u}) :
    IsRegularIdealSheaf Y.toRingedSpace (definingIdealOfHom (𝟙 Y)) := by
  refine isRegularIdealSheaf_of_exists_affine_generators Y _ fun y _ => ?_
  obtain ⟨_, ⟨V, hV, rfl⟩, hyV, -⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ y) isOpen_univ
  exact ⟨V, hV, hyV, 0, Fin.elim0, isGeneratedByOn_definingIdealOfHom_id Y V, by simp⟩

/-- **The inclusion of an open subscheme is a regular immersion.**  Its defining ideal, computed
on the open itself, is zero, hence generated by the empty regular sequence. -/
theorem isRegularImmersion_ι {X : Scheme.{u}} (U : X.Opens) :
    IsRegularImmersion U.ι :=
  (isRegularImmersion_iff_of_open U.ι U (𝟙 U.toScheme) (Category.id_comp _)).mpr
    (isRegularIdealSheaf_definingIdealOfHom_id U.toScheme)

end Stacks.AlgebraicGeometry

end
