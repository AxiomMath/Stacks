module

public import StacksFrontier.AlgebraicGeometry.DivisorFlatPullback.Basic
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.CohenMacaulaySlice.RegularSliceThroughPoint
public import StacksFrontier.RingTheory.Depth.Defs.Defs
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Immersion
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Slicing a flat morphism by an effective Cartier divisor

Let `f : X ⟶ S` be locally of finite presentation and flat at `x : X`, and let `h` be an element
of the maximal ideal of `𝒪_{X, x}` whose image in the local ring `𝒪_{X_{f x}, x}` of the fibre is
a nonzerodivisor.  Then `h` is the germ at `x` of a global section `a` of an affine open
neighbourhood `U` of `x`, the zero scheme `V(a) ⊆ U` is an effective Cartier divisor through `x`,
and `V(a)` is flat and locally of finite presentation over `S`.  This is Stacks tag 056Y.

Consequently a point at which `f` is flat and whose fibre local ring has depth at least one lies
on an effective Cartier divisor of an affine open neighbourhood which is flat and locally of
finite presentation over `S`:  this is Stacks tag 056Z.

## Main results

* `Stacks.AlgebraicGeometry.isRegular_of_isRegular_of_mem_span_singleton`: a generator of a
  principal ideal containing a nonzerodivisor is a nonzerodivisor.
* `Stacks.AlgebraicGeometry.isEffectiveCartierDivisor_ofIdealTop_span_singleton`: on an affine
  scheme the zero scheme of a nonzerodivisor is an effective Cartier divisor.
* `Stacks.AlgebraicGeometry.exists_open_affineOpen_isEffectiveCartierDivisor_of_isRegular_fiber`:
  on an affine scheme flat and locally of finite presentation over `S`, the zero scheme of a
  global section whose germ is a nonzerodivisor of the fibre is flat over `S` near the point and
  an effective Cartier divisor on an affine open neighbourhood of it.
* `Stacks.AlgebraicGeometry.exists_affineOpen_effectiveCartierDivisor_of_isRegular_fiber`: a
  germ in the maximal ideal which is a nonzerodivisor of the fibre cuts out, on an affine open
  neighbourhood, an effective Cartier divisor flat and locally of finite presentation over `S`.
* `Stacks.AlgebraicGeometry.exists_mem_maximalIdeal_isSMulRegular_of_one_le_depth`: a local ring
  of depth at least one has a nonzerodivisor in its maximal ideal.
* `Stacks.AlgebraicGeometry.exists_affineOpen_effectiveCartierDivisor_of_one_le_depth`: a point
  whose fibre local ring has depth at least one lies on such an effective Cartier divisor.

## References

* [Stacks Project, Lemma 37.21.1 (Tag 056Y)](https://stacks.math.columbia.edu/tag/056Y)
* [Stacks Project, Lemma 37.21.2 (Tag 056Z)](https://stacks.math.columbia.edu/tag/056Z)
-/

@[expose] public section

open CategoryTheory TopologicalSpace AlgebraicGeometry

open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.AlgebraicGeometry

universe u

variable {X S : Scheme.{u}}

/-! ### Principal ideals generated by a nonzerodivisor -/

/-- **A generator of a principal ideal containing a nonzerodivisor is a nonzerodivisor.**  If
`b` lies in the ideal generated by `a` and `b` is a nonzerodivisor, then so is `a`. -/
theorem isRegular_of_isRegular_of_mem_span_singleton {R : Type*} [CommRing R] {a b : R}
    (hb : IsRegular b) (hmem : b ∈ Ideal.span ({a} : Set R)) : IsRegular a := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
  subst hc
  exact (Commute.isRegular_iff (Commute.all _)).2 hb.left.of_mul

/-- On an affine scheme, the zero scheme of a nonzerodivisor is an effective Cartier divisor. -/
theorem isEffectiveCartierDivisor_ofIdealTop_span_singleton [IsAffine X] {a : Γ(X, ⊤)}
    (ha : IsRegular a) :
    Stacks.Divisors.IsEffectiveCartierDivisor
      (Scheme.IdealSheafData.ofIdealTop (Ideal.span {a})) :=
  Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen _ fun _ =>
    ⟨⊤, isAffineOpen_top X, trivial, a, ha, by simp⟩

/-- A regular sequence of length one is the same as a single regular element. -/
private theorem isRegular_ofFn_one_iff {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (g : Fin 1 → R) :
    RingTheory.Sequence.IsRegular M (List.ofFn g) ↔ RingTheory.Sequence.IsRegular M [g 0] := by
  simp only [List.ofFn_succ, List.ofFn_zero]

/-- Transport of a predicate on a dependent family along an equality of the index. -/
private theorem cast_mem {α : Sort*} {β : α → Sort*} {s t : α} (e : s = t)
    {P : ∀ r, β r → Prop} {z : β s} (hz : P s z) : P t (e ▸ z) := by
  cases e; exact hz

/-- Transport along an equality of the index and back is the identity. -/
private theorem cast_symm_cast {α : Sort*} {β : α → Sort*} {s t : α} (e : s = t) (z : β s) :
    e.symm ▸ (e ▸ z : β t) = z := by
  cases e; rfl

/-- Transport of the regularity of a restricted section along an equality of opens. -/
private theorem isRegular_res_of_eq {V W : X.Opens} (hVW : V = W) {a : Γ(X, ⊤)}
    (ha : IsRegular (X.presheaf.map (homOfLE (show V ≤ ⊤ from le_top)).op a)) :
    IsRegular (X.presheaf.map (homOfLE (show W ≤ ⊤ from le_top)).op a) := by
  subst hVW; exact ha

/-! ### The affine heart -/

/-- Let `X` be affine, flat and locally of finite presentation over `S`, let `a` be a global
section of `X` and let `x` be a point at which the germ of `a` is a nonzerodivisor of the local
ring of the fibre.  Then `x` lies on the zero scheme `V(a)`, some open neighbourhood of `x`
carries `V(a)` as a scheme flat over `S`, and some affine open neighbourhood inside it carries
`V(a)` as an effective Cartier divisor. -/
theorem exists_open_affineOpen_isEffectiveCartierDivisor_of_isRegular_fiber [IsAffine X]
    (f : X ⟶ S) [Flat f] [LocallyOfFinitePresentation f] (x : X) (a : Γ(X, ⊤))
    (hr : RingTheory.Sequence.IsRegular ((f.fiber (f x)).presheaf.stalk (f.asFiber x))
      [((f.fiberι (f x)).stalkMap (f.asFiber x)).hom
        ((f.fiberι_asFiber x).symm ▸ X.presheaf.germ ⊤ x trivial a)]) :
    x ∈ (Scheme.IdealSheafData.ofIdealTop (Ideal.span {a})).support ∧
      ∃ O : X.Opens, x ∈ O ∧
        Flat (((Scheme.IdealSheafData.ofIdealTop (Ideal.span {a})).comap O.ι).subschemeι ≫
            O.ι ≫ f) ∧
          ∃ V : X.Opens, IsAffineOpen V ∧ x ∈ V ∧ V ≤ O ∧
            Stacks.Divisors.IsEffectiveCartierDivisor
              ((Scheme.IdealSheafData.ofIdealTop (Ideal.span {a})).comap V.ι) := by
  classical
  rw [show (Ideal.span {a} : Ideal Γ(X, ⊤)) = Ideal.ofList [a] from
    (Ideal.ofList_singleton a).symm]
  set T := Scheme.IdealSheafData.ofIdealTop (Ideal.ofList [a]) with hT
  have hrFin : RingTheory.Sequence.IsRegular ((f.fiber (f x)).presheaf.stalk (f.asFiber x))
      (List.ofFn fun _ : Fin 1 => ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom
        ((f.fiberι_asFiber x).symm ▸ X.presheaf.germ ⊤ x trivial a)) := by
    exact (isRegular_ofFn_one_iff _).2 hr
  obtain ⟨hreg, hquot⟩ := isRegular_stalk_and_flatQuotients_of_isRegular_fiber f x
    (Flat.stalkMap f x) (fun _ : Fin 1 => X.presheaf.germ ⊤ x trivial a) hrFin
  have hlofFn : (List.ofFn fun _ : Fin 1 => X.presheaf.germ ⊤ x trivial a) =
      [a].map (X.presheaf.germ ⊤ x trivial) := by simp
  rw [hlofFn] at hreg
  have hx : x ∈ T.support := mem_support_ofIdealTop_of_isRegular_germ x [a] hreg
  have hsmul :
      Ideal.ofList ((List.ofFn fun _ : Fin 1 => X.presheaf.germ ⊤ x trivial a).take 1) •
      (⊤ : Submodule (X.presheaf.stalk x) (X.presheaf.stalk x)) =
      (Ideal.ofList ([a].map (X.presheaf.germ ⊤ x trivial)) :
        Submodule (X.presheaf.stalk x) (X.presheaf.stalk x)) := by
    rw [hlofFn, List.take_of_length_le (by simp), Ideal.smul_top_eq_map]
    exact Ideal.map_id _
  have hq := hquot 1
  rw [hsmul] at hq
  have hflatpt := flat_stalkMap_subschemeι_comp_of_flat_quotient f [a] x hx hq
  have hNoeth : IsLocallyNoetherian (f.fiber (f x)) := isLocallyNoetherian_fiber f (f x)
  have hregFib : RingTheory.Sequence.IsRegular
      ((f.fiber (f x)).presheaf.stalk (f.asFiber x))
      (([a].map (f.fiberι (f x)).appTop.hom).map
        ((f.fiber (f x)).presheaf.germ ⊤ (f.asFiber x) trivial)) := by
    simpa only [List.map_map, List.map_cons, List.map_nil, Function.comp_def,
      ← CommRingCat.comp_apply, germ_fiberι_appTop_apply] using hr
  obtain ⟨V₁, hxV₁, hqr⟩ := statement063I hNoeth ([a].map (f.fiberι (f x)).appTop.hom)
    (f.asFiber x) hregFib
  have hcomapFib : T.comap (f.fiberι (f x)) =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.ofList ([a].map (f.fiberι (f x)).appTop.hom)) := by
    rw [hT, comap_ofIdealTop, Ideal.map_ofList]
  have hquasi : ∃ W : (f.fiber (f x)).Opens, f.asFiber x ∈ W ∧ IsQuasiRegularImmersion
      (((T.comap (f.fiberι (f x))).comap W.ι).subschemeι) := by
    rw [hcomapFib]; exact ⟨V₁, hxV₁, hqr⟩
  have hlfpT : LocallyOfFinitePresentation T.subschemeι := by
    rw [hT]
    exact locallyOfFinitePresentation_subschemeι_ofIdealTop _
      (Submodule.fg_span (List.finite_toSet _))
  obtain ⟨O, hxO, hrel, -⟩ :=
    statement063W f inferInstance inferInstance T hlfpT x hx hquasi hflatpt
  obtain ⟨V, hV, hxV, hVO, r, c, hspan, hwr⟩ :=
    exists_affineOpen_isWeaklyRegular_ideal_of_fibre f T x hx hquasi hflatpt O hxO
  have hidealV : T.ideal ⟨V, hV⟩ =
      Ideal.span {X.presheaf.map (homOfLE (show V ≤ ⊤ from le_top)).op a} := by
    rw [hT]
    simp [Ideal.map_span]
  have hgermne : X.presheaf.germ ⊤ x trivial a ≠ 0 := by
    intro h0
    have hsm := (RingTheory.Sequence.isWeaklyRegular_singleton_iff _ _).mp
      (by simpa using hreg.1)
    rw [h0] at hsm
    exact one_ne_zero (hsm (show (0 : X.presheaf.stalk x) • (1 : X.presheaf.stalk x) =
      (0 : X.presheaf.stalk x) • (0 : X.presheaf.stalk x) by simp))
  have haV : IsRegular (X.presheaf.map (homOfLE (show V ≤ ⊤ from le_top)).op a) := by
    rcases r with _ | n
    · exfalso
      have hbot : Ideal.span
          {X.presheaf.map (homOfLE (show V ≤ ⊤ from le_top)).op a} = ⊥ := by
        rw [← hidealV, hspan]
        simp
      rw [Ideal.span_singleton_eq_bot] at hbot
      refine hgermne ?_
      have hgr := X.presheaf.germ_res_apply (homOfLE (show V ≤ ⊤ from le_top)) x hxV a
      rw [hbot, map_zero] at hgr
      exact hgr.symm
    · have hhead : IsSMulRegular Γ(X, V) (c 0) := by
        rw [List.ofFn_succ] at hwr
        exact ((RingTheory.Sequence.isWeaklyRegular_cons_iff _ _ _).mp hwr).1
      have hc0 : IsRegular (c 0) := by
        exact (Commute.isRegular_iff (Commute.all _)).2 hhead
      refine isRegular_of_isRegular_of_mem_span_singleton hc0 ?_
      rw [← hidealV, hspan]
      exact Ideal.subset_span ⟨0, rfl⟩
  have hEC : Stacks.Divisors.IsEffectiveCartierDivisor (T.comap V.ι) := by
    have : IsAffine V.toScheme := hV
    have hcomapV : T.comap V.ι =
        Scheme.IdealSheafData.ofIdealTop (Ideal.span {V.ι.appTop.hom a}) := by
      rw [hT, comap_ofIdealTop, Ideal.ofList_singleton, Ideal.map_span, Set.image_singleton]
    rw [hcomapV]
    exact isEffectiveCartierDivisor_ofIdealTop_span_singleton
      (isRegular_res_of_eq (V.ι_image_top).symm haV)
  exact ⟨hx, O, hxO, hrel.1, V, hV, hxV, hVO, hEC⟩

/-! ### Slicing by one equation -/

/-- Let `f : X ⟶ S` be locally of finite presentation and flat at `x : X`, and let `h` be an
element of the maximal ideal of `𝒪_{X, x}` whose image in the local ring of the fibre `X_{f x}`
at `x` is a nonzerodivisor.  Then there is an affine open `U ∋ x` and a global section `a` of `U`
whose germ at `x` is `h`, such that the zero scheme `V(a) ⊆ U` is an effective Cartier divisor
containing `x` which is flat and locally of finite presentation over `S`. -/
@[stacks 056Y]
theorem exists_affineOpen_effectiveCartierDivisor_of_isRegular_fiber (f : X ⟶ S)
    [LocallyOfFinitePresentation f] (x : X) (h : X.presheaf.stalk x)
    (hh : h ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x))
    (hflat : IsFlatAt f.toLRSHom.toShHom x)
    (hregular : IsRegular (((f.fiberι (f x)).stalkMap (f.asFiber x)).hom
      ((f.fiberι_asFiber x).symm ▸ h))) :
    ∃ (U : X.affineOpens) (hx : x ∈ U.1) (a : Γ(U.1.toScheme, ⊤)),
      let y : U.1.toScheme := ⟨x, hx⟩
      let I : U.1.toScheme.IdealSheafData :=
        Scheme.IdealSheafData.ofIdealTop (Ideal.span {a})
      (U.1.ι.stalkMap y).hom ((show U.1.ι y = x by rfl).symm ▸ h) =
          U.1.toScheme.presheaf.germ ⊤ y (by trivial) a ∧
        y ∈ I.support ∧
        Stacks.Divisors.IsEffectiveCartierDivisor I ∧
        Flat (I.subschemeι ≫ U.1.ι ≫ f) ∧
        LocallyOfFinitePresentation (I.subschemeι ≫ U.1.ι ≫ f) := by
  classical
  have hbarmem : ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom
      ((f.fiberι_asFiber x).symm ▸ h) ∈
      IsLocalRing.maximalIdeal ((f.fiber (f x)).presheaf.stalk (f.asFiber x)) := by
    have hcast : ((f.fiberι_asFiber x).symm ▸ h) ∈
        IsLocalRing.maximalIdeal
          (X.presheaf.stalk (f.fiberι (f x) (f.asFiber x))) :=
      cast_mem (f.fiberι_asFiber x).symm
        (P := fun z (r : X.presheaf.stalk z) =>
          r ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk z)) hh
    rwa [← IsLocalRing.maximalIdeal_comap
      ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom] at hcast
  have hwr : RingTheory.Sequence.IsWeaklyRegular
      ((f.fiber (f x)).presheaf.stalk (f.asFiber x))
      [((f.fiberι (f x)).stalkMap (f.asFiber x)).hom
        ((f.fiberι_asFiber x).symm ▸ h)] := by
    refine (RingTheory.Sequence.isWeaklyRegular_singleton_iff _ _).mpr ?_
    simpa only [IsSMulRegular, IsLeftRegular, smul_eq_mul] using hregular.left
  have hseq0 : RingTheory.Sequence.IsRegular
      ((f.fiber (f x)).presheaf.stalk (f.asFiber x))
      [((f.fiberι (f x)).stalkMap (f.asFiber x)).hom
        ((f.fiberι_asFiber x).symm ▸ h)] :=
    RingTheory.Sequence.IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal _
      (fun r hr => List.mem_singleton.mp hr ▸ hbarmem) hwr
  have hseq : RingTheory.Sequence.IsRegular
      ((f.fiber (f x)).presheaf.stalk (f.asFiber x))
      (List.ofFn fun _ : Fin 1 => ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom
        ((f.fiberι_asFiber x).symm ▸ h)) := by
    exact (isRegular_ofFn_one_iff _).2 hseq0
  obtain ⟨U, hxU, a, hUf, ha⟩ :=
    exists_affineOpen_lifts_of_isFlatAt f x (fun _ : Fin 1 => h) hflat
  have hUaff : IsAffine U.1.toScheme := U.2
  have hfUflat : Flat (U.1.ι ≫ f) := hUf
  have hrU := isRegular_fiber_comp_of_isOpenImmersion U.1.ι f (⟨x, hxU⟩ : U.1.toScheme)
    (fun _ : Fin 1 => h) hseq
  have hrUb : RingTheory.Sequence.IsRegular
      (((U.1.ι ≫ f).fiber ((U.1.ι ≫ f) (⟨x, hxU⟩ : U.1.toScheme))).presheaf.stalk
        ((U.1.ι ≫ f).asFiber (⟨x, hxU⟩ : U.1.toScheme)))
      (List.ofFn fun j : Fin 1 =>
        (((U.1.ι ≫ f).fiberι ((U.1.ι ≫ f) (⟨x, hxU⟩ : U.1.toScheme))).stalkMap
            ((U.1.ι ≫ f).asFiber (⟨x, hxU⟩ : U.1.toScheme))).hom
          (((U.1.ι ≫ f).fiberι_asFiber (⟨x, hxU⟩ : U.1.toScheme)).symm ▸
            U.1.toScheme.presheaf.germ ⊤ (⟨x, hxU⟩ : U.1.toScheme) trivial (a j))) := by
    simp only [← ha]
    exact hrU
  have hrUa : RingTheory.Sequence.IsRegular
      (((U.1.ι ≫ f).fiber ((U.1.ι ≫ f) (⟨x, hxU⟩ : U.1.toScheme))).presheaf.stalk
        ((U.1.ι ≫ f).asFiber (⟨x, hxU⟩ : U.1.toScheme)))
      [(((U.1.ι ≫ f).fiberι ((U.1.ι ≫ f) (⟨x, hxU⟩ : U.1.toScheme))).stalkMap
          ((U.1.ι ≫ f).asFiber (⟨x, hxU⟩ : U.1.toScheme))).hom
        (((U.1.ι ≫ f).fiberι_asFiber (⟨x, hxU⟩ : U.1.toScheme)).symm ▸
          U.1.toScheme.presheaf.germ ⊤ (⟨x, hxU⟩ : U.1.toScheme) trivial (a 0))] := by
    exact (isRegular_ofFn_one_iff _).1 hrUb
  obtain ⟨hyT, O, hyO, hflatO, V, hVaff, hyV, hVO, hECV⟩ :=
    exists_open_affineOpen_isEffectiveCartierDivisor_of_isRegular_fiber (U.1.ι ≫ f)
      (⟨x, hxU⟩ : U.1.toScheme) (a 0) hrUa
  set T := Scheme.IdealSheafData.ofIdealTop (Ideal.span {a 0}) with hT
  have hxW : x ∈ U.1.ι ''ᵁ V := ⟨⟨x, hxU⟩, hyV, rfl⟩
  obtain ⟨_, ⟨W, hW, rfl⟩, hxW', hWV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxW (U.1.ι ''ᵁ V).isOpen
  let Va : X.affineOpens := ⟨W, hW⟩
  have hVaaff : IsAffine Va.1.toScheme := hW
  have hVU : Va.1 ≤ U.1 := fun t ht => by
    obtain ⟨z, _, rfl⟩ := hWV ht
    exact z.property
  let jv := X.homOfLE hVU
  have hjι : jv ≫ U.1.ι = Va.1.ι := X.homOfLE_ι hVU
  have hjvV : Set.range jv ⊆ Set.range V.ι := by
    rintro _ ⟨z, rfl⟩
    obtain ⟨w, hw, hwz⟩ := hWV z.property
    refine ⟨⟨w, hw⟩, ?_⟩
    refine U.1.ι.isOpenEmbedding.injective ?_
    show w.val = (jv z).val
    rw [show (jv z).val = z.val from X.homOfLE_apply hVU z]
    exact hwz
  let kv := IsOpenImmersion.lift V.ι jv hjvV
  have hkV : kv ≫ V.ι = jv := IsOpenImmersion.lift_fac _ _ _
  have hkvI : IsOpenImmersion kv := by
    have : IsOpenImmersion (kv ≫ V.ι) := hkV.symm ▸ inferInstance
    exact IsOpenImmersion.of_comp kv V.ι
  let b : Γ(Va.1.toScheme, ⊤) := jv.appTop (a 0)
  set I := Scheme.IdealSheafData.ofIdealTop (Ideal.span {b}) with hI
  have hTj : T.comap jv = I := by
    rw [hT, hI, comap_ofIdealTop, Ideal.map_span, Set.image_singleton]
  have hECI : Stacks.Divisors.IsEffectiveCartierDivisor I := by
    have hTkV : (T.comap V.ι).comap kv = I := by
      rw [← Scheme.IdealSheafData.comap_comp, hkV, hTj]
    rw [← hTkV]
    exact Stacks.Divisors.isPullbackDefined_of_flat kv (T.comap V.ι) hECV
  let lv := U.1.toScheme.homOfLE hVO
  have hlO : lv ≫ O.ι = V.ι := U.1.toScheme.homOfLE_ι hVO
  have hkO : (kv ≫ lv) ≫ O.ι = jv := by rw [Category.assoc, hlO, hkV]
  have hTkO : (T.comap O.ι).comap (kv ≫ lv) = I := by
    rw [← Scheme.IdealSheafData.comap_comp, hkO, hTj]
  have hflatI : Flat (I.subschemeι ≫ Va.1.ι ≫ f) := by
    have hfl := flat_comap_of_isOpenImmersion (T.comap O.ι) (O.ι ≫ U.1.ι ≫ f) (kv ≫ lv)
    rw [hTkO] at hfl
    simpa only [← Category.assoc, hkO, hjι] using hfl
  have hlfpI : LocallyOfFinitePresentation I.subschemeι := by
    rw [hI]
    exact locallyOfFinitePresentation_subschemeι_ofIdealTop _
      (Submodule.fg_span (Set.finite_singleton _))
  have hjz : jv (⟨x, hxW'⟩ : Va.1.toScheme) = (⟨x, hxU⟩ : U.1.toScheme) :=
    Subtype.ext (X.homOfLE_apply hVU _)
  have hgerm : (Va.1.ι.stalkMap (⟨x, hxW'⟩ : Va.1.toScheme)).hom
      ((show Va.1.ι (⟨x, hxW'⟩ : Va.1.toScheme) = x by rfl).symm ▸ h) =
      Va.1.toScheme.presheaf.germ ⊤ (⟨x, hxW'⟩ : Va.1.toScheme) (by trivial) b :=
    germ_comp_of_lift_of_eq U.1.ι jv Va.1.ι hjι ⟨x, hxW'⟩ hjz rfl h (a 0) (ha 0)
  have hsupp : (⟨x, hxW'⟩ : Va.1.toScheme) ∈ I.support := by
    rw [← hTj, Scheme.IdealSheafData.support_comap]
    show jv (⟨x, hxW'⟩ : Va.1.toScheme) ∈ T.support
    rwa [hjz]
  exact ⟨Va, hxW', b, hgerm, hsupp, hECI, hflatI, inferInstance⟩

/-! ### Slicing a fibre of positive depth -/

/-- A local ring of depth at least one has a nonzerodivisor in its maximal ideal. -/
theorem exists_mem_maximalIdeal_isSMulRegular_of_one_le_depth {R : Type*} [CommRing R]
    [IsLocalRing R] (hdepth : (1 : ℕ∞) ≤ Module.depth R (IsLocalRing.maximalIdeal R) R) :
    ∃ a ∈ IsLocalRing.maximalIdeal R, IsSMulRegular R a := by
  by_contra hc
  push Not at hc
  rw [Module.depth_eq_iSup_isWeaklyRegular_length] at hdepth
  have hle : (⨆ rs ∈ {rs : List R | (∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal R) ∧
      RingTheory.Sequence.IsWeaklyRegular R rs}, (rs.length : ℕ∞)) ≤ 0 := by
    refine iSup₂_le ?_
    rintro (_ | ⟨b, t⟩) ⟨hmem, hreg⟩
    · simp
    · exact absurd ((RingTheory.Sequence.isWeaklyRegular_cons_iff R b t).mp hreg).1
        (hc b (hmem b List.mem_cons_self))
  exact absurd (hdepth.trans hle) (by simp)

/-- Let `f : X ⟶ S` be locally of finite presentation and flat at `x : X`, and assume the local
ring of the fibre `X_{f x}` at `x` has depth at least one.  Then some affine open neighbourhood
of `x` carries an effective Cartier divisor through `x` which is flat and locally of finite
presentation over `S`. -/
@[stacks 056Z, ega "IV 19.9.6" "n = 1, F = O_X"]
theorem exists_affineOpen_effectiveCartierDivisor_of_one_le_depth (f : X ⟶ S)
    [LocallyOfFinitePresentation f] (x : X) (hflat : IsFlatAt f.toLRSHom.toShHom x)
    (hdepth : (1 : ℕ∞) ≤
      Module.depth ((f.fiber (f x)).presheaf.stalk (f.asFiber x))
        (IsLocalRing.maximalIdeal ((f.fiber (f x)).presheaf.stalk (f.asFiber x)))
        ((f.fiber (f x)).presheaf.stalk (f.asFiber x))) :
    ∃ (U : X.affineOpens) (I : U.1.toScheme.IdealSheafData),
      x ∈ Set.range (I.subschemeι ≫ U.1.ι) ∧
        Stacks.Divisors.IsEffectiveCartierDivisor I ∧
        Flat (I.subschemeι ≫ U.1.ι ≫ f) ∧
        LocallyOfFinitePresentation (I.subschemeι ≫ U.1.ι ≫ f) := by
  obtain ⟨b, hb, hbreg⟩ := exists_mem_maximalIdeal_isSMulRegular_of_one_le_depth hdepth
  obtain ⟨h₀, hh₀⟩ := (f.fiberι (f x)).stalkMap_surjective (f.asFiber x) b
  have hh₀mem : h₀ ∈ IsLocalRing.maximalIdeal
      (X.presheaf.stalk (f.fiberι (f x) (f.asFiber x))) := by
    rw [← IsLocalRing.maximalIdeal_comap ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom]
    show ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom h₀ ∈
      IsLocalRing.maximalIdeal ((f.fiber (f x)).presheaf.stalk (f.asFiber x))
    rwa [hh₀]
  have hmem : (f.fiberι_asFiber x ▸ h₀ : X.presheaf.stalk x) ∈
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
    cast_mem (f.fiberι_asFiber x)
      (P := fun z (r : X.presheaf.stalk z) =>
        r ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk z)) hh₀mem
  have hcast : (f.fiberι_asFiber x).symm ▸ (f.fiberι_asFiber x ▸ h₀ : X.presheaf.stalk x) =
      h₀ :=
    cast_symm_cast (β := fun z => (X.presheaf.stalk z : Type u)) (f.fiberι_asFiber x) h₀
  have hregular : IsRegular (((f.fiberι (f x)).stalkMap (f.asFiber x)).hom
      ((f.fiberι_asFiber x).symm ▸ (f.fiberι_asFiber x ▸ h₀ : X.presheaf.stalk x))) := by
    rw [hcast, hh₀]
    exact (Commute.isRegular_iff (Commute.all _)).2 hbreg
  obtain ⟨U, hxU, a, hdata⟩ :=
    exists_affineOpen_effectiveCartierDivisor_of_isRegular_fiber f x
      (f.fiberι_asFiber x ▸ h₀) hmem hflat hregular
  dsimp only at hdata
  obtain ⟨-, hy, hEC, hflatD, hlfpD⟩ := hdata
  refine ⟨U, Scheme.IdealSheafData.ofIdealTop (Ideal.span {a}), ?_, hEC, hflatD, hlfpD⟩
  have hy' : (⟨x, hxU⟩ : U.1.toScheme) ∈
      Set.range (Scheme.IdealSheafData.ofIdealTop (Ideal.span {a})).subschemeι := by
    rwa [Scheme.IdealSheafData.range_subschemeι]
  obtain ⟨z, hz⟩ := hy'
  refine ⟨z, ?_⟩
  show U.1.ι ((Scheme.IdealSheafData.ofIdealTop (Ideal.span {a})).subschemeι z) = x
  rw [hz]
  rfl

end Stacks.AlgebraicGeometry

