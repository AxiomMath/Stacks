module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.CohenMacaulaySlice.UnramifiedMinimalGenerators

/-!
# The slicing sequence of Stacks 06N3 as global functions on an affine chart

When the chart `U` of the construction of **Stacks 06N3** is affine, the slicing sequence of
that construction can be taken to consist of global regular functions on `U`, rather than of
regular functions on an affine open of `U` as in
`AlgebraicGeometry.exists_isAffineOpen_isRegular_ofList_eq_maximalIdeal_stalk_of_unramifiedAt`.

## Main results

* `AlgebraicGeometry.span_image_preimage_germ_top_eq_maximalIdeal`: on an affine scheme the
  maximal ideal of a local ring is generated by the germs of the global functions lying in it.
* `AlgebraicGeometry.exists_global_isRegular_ofList_eq_maximalIdeal_stalk_of_unramifiedAt`: the
  slicing sequence as global regular functions on an affine `U`.

## References

* [Stacks Project, Tag 00NQ](https://stacks.math.columbia.edu/tag/00NQ)
* [Stacks Project, Tag 02GF](https://stacks.math.columbia.edu/tag/02GF)
* [Stacks Project, Tag 06N3](https://stacks.math.columbia.edu/tag/06N3)
-/

@[expose] public section

open CategoryTheory IsLocalRing

universe u

namespace AlgebraicGeometry

/-- On an affine scheme `U`, the maximal ideal of the stalk at `u` is generated by the germs at
`u` of the global functions whose germ lies in it. -/
theorem span_image_preimage_germ_top_eq_maximalIdeal (U : Scheme.{u}) [IsAffine U] (u : U) :
    Ideal.map (U.presheaf.germ ⊤ u trivial).hom
        (Ideal.comap (U.presheaf.germ ⊤ u trivial).hom
          (maximalIdeal (U.presheaf.stalk u))) =
      maximalIdeal (U.presheaf.stalk u) := by
  let : Algebra Γ(U, ⊤) (U.presheaf.stalk u) :=
    U.presheaf.algebra_section_stalk (⟨u, trivial⟩ : (⊤ : U.Opens))
  have := (isAffineOpen_top U).isLocalization_stalk (⟨u, trivial⟩ : (⊤ : U.Opens))
  refine le_antisymm Ideal.map_comap_le fun t ht => ?_
  obtain ⟨⟨a, s⟩, heq⟩ :=
    IsLocalization.surj ((isAffineOpen_top U).primeIdealOf ⟨u, trivial⟩).asIdeal.primeCompl t
  obtain ⟨b, hb⟩ := (IsLocalization.map_units (U.presheaf.stalk u) s).exists_right_inv
  have hg (a : Γ(U, ⊤)) : (U.presheaf.germ ⊤ u trivial).hom a =
      algebraMap Γ(U, ⊤) (U.presheaf.stalk u) a := rfl
  have hamem : a ∈ Ideal.comap (U.presheaf.germ ⊤ u trivial).hom
      (maximalIdeal (U.presheaf.stalk u)) := by
    refine Ideal.mem_comap.2 ?_
    rw [hg, ← heq]
    exact Ideal.mul_mem_right _ _ ht
  have ht' : t = b * ((U.presheaf.germ ⊤ u trivial).hom) a := by
    rw [hg, ← heq, mul_comm t _, ← mul_assoc, mul_comm b _, hb, one_mul]
  rw [ht']
  exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hamem)

/-- **The slicing sequence of the chart construction of Stacks 06N3 as global functions on an
affine chart.** Let `q : V ⟶ U` be a morphism of schemes locally of finite type with `U`
**affine**, let `v` be a point of `V` at which `q` is **unramified**, and suppose `𝒪_{V, v}` is a
regular local ring. Then there are `d = (𝔪_v).spanFinrank` **global** regular functions on `U`
whose germs at `u = q v` lie in `𝔪_u` and whose images in `𝒪_{V, v}` form a regular sequence
**generating** `𝔪_v`. -/
theorem exists_global_isRegular_ofList_eq_maximalIdeal_stalk_of_unramifiedAt
    {V U : Scheme.{u}} [IsAffine U] (q : V ⟶ U) [LocallyOfFiniteType q] (v : V)
    (hq : UnramifiedAt q v) (hreg : IsRegularLocalRing (V.presheaf.stalk v)) :
    ∃ g : Fin (maximalIdeal (V.presheaf.stalk v)).spanFinrank → Γ(U, ⊤),
      (∀ i, (U.presheaf.germ ⊤ (q v) trivial).hom (g i) ∈
        maximalIdeal (U.presheaf.stalk (q v))) ∧
        RingTheory.Sequence.IsRegular (V.presheaf.stalk v)
            (List.ofFn fun i => (q.stalkMap v).hom
              ((U.presheaf.germ ⊤ (q v) trivial).hom (g i))) ∧
          Ideal.ofList (List.ofFn fun i => (q.stalkMap v).hom
              ((U.presheaf.germ ⊤ (q v) trivial).hom (g i))) =
            maximalIdeal (V.presheaf.stalk v) := by
  classical
  -- Stacks 02GF: unramifiedness at `v` makes `𝔪_u` generate `𝔪_v`
  have hall := ((unramifiedAt_tfae q v).out 1 7).mp hq
  have hmap : Ideal.map (q.stalkMap v).hom (maximalIdeal (U.presheaf.stalk (q v))) =
      maximalIdeal (V.presheaf.stalk v) := hall.1
  have hspan : Ideal.span (((q.stalkMap v).hom.comp
      (U.presheaf.germ ⊤ (q v) trivial).hom) ''
        (Ideal.comap (U.presheaf.germ ⊤ (q v) trivial).hom
          (maximalIdeal (U.presheaf.stalk (q v))) : Set Γ(U, ⊤))) =
      maximalIdeal (V.presheaf.stalk v) := by
    change Ideal.map ((q.stalkMap v).hom.comp (U.presheaf.germ ⊤ (q v) trivial).hom) _ = _
    rw [← Ideal.map_map, span_image_preimage_germ_top_eq_maximalIdeal U (q v), hmap]
  obtain ⟨y, hys, hyspan⟩ := IsLocalRing.exists_fn_mem_ofList_eq_maximalIdeal_of_span_eq hspan
  choose g hgmem hgy using fun i => (Set.mem_image _ _ _).mp (hys i)
  have hlist : (List.ofFn fun i => (q.stalkMap v).hom
      ((U.presheaf.germ ⊤ (q v) trivial).hom (g i))) = List.ofFn y :=
    congrArg List.ofFn (funext fun i => hgy i)
  refine ⟨g, fun i => Ideal.mem_comap.1 (hgmem i), ?_⟩
  rw [hlist]
  -- Stacks 00NQ: a minimal generating family of the maximal ideal of a regular local ring is
  -- a regular sequence
  exact ⟨(IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
    (V.presheaf.stalk v)).1 _ hyspan (by rw [List.length_ofFn]) |>.1, hyspan⟩

end AlgebraicGeometry

end
