module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.CohenMacaulaySlice.StalkMap
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RelativeRegularImmersion.Localization
public import StacksFrontier.AlgebraicGeometry.Morphisms.CohenMacaulay.FibreStalk
public import StacksFrontier.RingTheory.Flat.RegularSequenceOverBase

/-!
# Lifting a regular sequence from the fibre to the local ring

Let `f : X ⟶ S` be locally of finite presentation and flat at `x : X`.  A family of elements of
the local ring `𝒪_{X, x}` whose image in the local ring `𝒪_{X_{f x}, x}` of the fibre through
`x` is a regular sequence is already a regular sequence in `𝒪_{X, x}`, and every partial
quotient `𝒪_{X, x} / (h₁, …, h_i)` is flat over `𝒪_{S, f x}`.

## Main results

* `Stacks.AlgebraicGeometry.isRegular_quotient_stalk_of_isRegular_fiber`: a family regular on
  the fibre is regular on the quotient of `𝒪_{X, x}` by the extended maximal ideal.
* `Stacks.AlgebraicGeometry.isRegular_and_flatQuotients_of_isRegular_quotient_stalk`: a family
  regular on that quotient is regular in `𝒪_{X, x}`, with flat partial quotients.
* `Stacks.AlgebraicGeometry.isRegular_stalk_and_flatQuotients_of_isRegular_fiber`: a family
  regular on the fibre is regular in `𝒪_{X, x}`, with flat partial quotients.

## References

* [Stacks Project, Lemma 37.24.1 (Tag 06LI)](https://stacks.math.columbia.edu/tag/06LI)
* [Stacks Project, Lemma 10.99.3 (Tag 0470)](https://stacks.math.columbia.edu/tag/0470)
* [Stacks Project, Lemma 37.13.8 (Tag 05I8)](https://stacks.math.columbia.edu/tag/05I8)
-/

@[expose] public section

open CategoryTheory TopologicalSpace AlgebraicGeometry RingTheory.Sequence

namespace Stacks.AlgebraicGeometry

universe u

variable {X S : Scheme.{u}}

/-- A `stalkCongr` isomorphism along an equality of points acts as transport along that
equality. -/
theorem stalkCongr_hom_apply_eq_cast {T : TopCat.{u}} (F : T.Presheaf CommRingCat.{u})
    {x y : T} (h : x = y) (a : F.stalk x) : (F.stalkCongr (.of_eq h)).hom a = h ▸ a := by
  subst h
  simp [TopCat.Presheaf.stalkCongr]

/-- A family of elements of `𝒪_{X, x}` whose image in the local ring of the fibre through `x` is a
regular sequence is a regular sequence in the quotient of `𝒪_{X, x}` by the ideal generated by the
maximal ideal of `𝒪_{S, f x}`. -/
theorem isRegular_quotient_stalk_of_isRegular_fiber (f : X ⟶ S) (x : X) {r : ℕ}
    (h : Fin r → X.presheaf.stalk x)
    (hregular : IsRegular ((f.fiber (f x)).presheaf.stalk (f.asFiber x))
      (List.ofFn fun i : Fin r =>
        ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom ((f.fiberι_asFiber x).symm ▸ h i))) :
    IsRegular
      (X.presheaf.stalk x ⧸
        Ideal.map (f.stalkMap x).hom (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))))
      (List.ofFn fun i : Fin r =>
        Ideal.Quotient.mk
          (Ideal.map (f.stalkMap x).hom
            (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) (h i)) := by
  let I : Ideal (X.presheaf.stalk x) :=
    Ideal.map (f.stalkMap x).hom (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))
  let e := quotientStalkEquivFiberStalk f x
  have hmk (i : Fin r) : e (Ideal.Quotient.mk I (h i)) =
      ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom ((f.fiberι_asFiber x).symm ▸ h i) := by
    rw [show e = quotientStalkEquivFiberStalk f x from rfl, quotientStalkEquivFiberStalk_mk]
    exact congrArg _ (stalkCongr_hom_apply_eq_cast X.presheaf (f.fiberι_asFiber x).symm (h i))
  refine (AddEquiv.isRegular_congr (e := e.toAddEquiv)
    (as := List.ofFn fun i : Fin r => Ideal.Quotient.mk I (h i))
    (bs := (List.ofFn fun i : Fin r => Ideal.Quotient.mk I (h i)).map e)
    (List.forall₂_map_right_iff.mpr (List.forall₂_same.mpr fun a _ z =>
      show e.toAddEquiv (a • z) = e a • e.toAddEquiv z from map_mul e a z))).mpr ?_
  rw [List.map_ofFn]
  simpa only [Function.comp_def, hmk] using hregular

/-- Let `f : X ⟶ S` be locally of finite presentation and flat at `x`. If a list `fs` of elements
of `𝒪_{X, x}` is a regular sequence on the quotient of `𝒪_{X, x}` by the ideal generated by the
maximal ideal of `𝒪_{S, f x}`, then `fs` is a regular sequence in `𝒪_{X, x}` and every partial
quotient `𝒪_{X, x} / (f₁, …, f_i)` is flat over `𝒪_{S, f x}`. -/
theorem isRegular_and_flatQuotients_of_isRegular_quotient_stalk (f : X ⟶ S)
    [LocallyOfFinitePresentation f] (x : X) (hflat : (f.stalkMap x).hom.Flat)
    (fs : List (X.presheaf.stalk x))
    (hfs : IsRegular
      (X.presheaf.stalk x ⧸
        Ideal.map (f.stalkMap x).hom
          (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) fs) :
    IsRegular (X.presheaf.stalk x) fs ∧
      ∀ i, @Module.Flat (S.presheaf.stalk (f x))
        (X.presheaf.stalk x ⧸
          (Ideal.ofList (fs.take i) •
            (⊤ : Submodule (X.presheaf.stalk x) (X.presheaf.stalk x)))) _ _
        (Module.compHom _ (f.stalkMap x).hom) := by
  let R := S.presheaf.stalk (f x)
  let A := X.presheaf.stalk x
  let I : Ideal A := Ideal.map (f.stalkMap x).hom (IsLocalRing.maximalIdeal R)
  let : Algebra R A := (f.stalkMap x).hom.toAlgebra
  have : IsScalarTower R A A := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have : IsLocalHom (algebraMap R A) := by
    change IsLocalHom (f.stalkMap x).hom
    infer_instance
  have : Module.Flat R A := hflat
  have hsmul : I • (⊤ : Submodule A A) = (I : Submodule A A) :=
    (Ideal.smul_top_eq_map I).trans (Ideal.map_id _)
  have hfs' : IsRegular (A ⧸ (I • (⊤ : Submodule A A))) fs :=
    ((Submodule.quotEquivOfEq _ (I : Submodule A A) hsmul).isRegular_congr fs).mpr hfs
  exact Module.Flat.isRegular_and_flat_quotient_ofList_smul_of_isRegular_maximalIdeal
    (essentiallyOfFinitePresentation_stalkMap f x) fs hfs'

/-- Let `f : X ⟶ S` be locally of finite presentation and flat at `x`, and let
`h : Fin r → 𝒪_{X, x}` be a family whose image in the local ring of the fibre `X_{f x}` at `x` is a
regular sequence. Then `h` is a regular sequence in `𝒪_{X, x}`, and every partial quotient
`𝒪_{X, x} / (h₁, …, h_i)` is flat over `𝒪_{S, f x}`. -/
theorem isRegular_stalk_and_flatQuotients_of_isRegular_fiber (f : X ⟶ S)
    [LocallyOfFinitePresentation f] (x : X) (hflat : (f.stalkMap x).hom.Flat) {r : ℕ}
    (h : Fin r → X.presheaf.stalk x)
    (hregular : IsRegular ((f.fiber (f x)).presheaf.stalk (f.asFiber x))
      (List.ofFn fun i : Fin r =>
        ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom ((f.fiberι_asFiber x).symm ▸ h i))) :
    IsRegular (X.presheaf.stalk x) (List.ofFn h) ∧
      ∀ i, @Module.Flat (S.presheaf.stalk (f x))
        (X.presheaf.stalk x ⧸
          (Ideal.ofList ((List.ofFn h).take i) •
            (⊤ : Submodule (X.presheaf.stalk x) (X.presheaf.stalk x)))) _ _
        (Module.compHom _ (f.stalkMap x).hom) := by
  refine isRegular_and_flatQuotients_of_isRegular_quotient_stalk f x hflat (List.ofFn h) ?_
  refine (isRegular_map_algebraMap_iff
    (X.presheaf.stalk x ⧸
      Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) (List.ofFn h)).mp ?_
  rw [List.map_ofFn]
  exact isRegular_quotient_stalk_of_isRegular_fiber f x h hregular

end Stacks.AlgebraicGeometry

end
