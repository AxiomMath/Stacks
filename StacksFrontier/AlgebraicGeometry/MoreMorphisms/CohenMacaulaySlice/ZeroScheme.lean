module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
public import Mathlib.AlgebraicGeometry.Morphisms.FinitePresentation
public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.RingTheory.RingHom.Flat
public import StacksFrontier.AlgebraicGeometry.Flatness.StalkIdealSheaf

/-!
# The zero scheme of a family of global sections

Let `X` be a scheme and `a` a list of global sections of `X`.  Its *zero scheme* is the closed
subscheme `V(a)` cut out by the ideal sheaf `Scheme.IdealSheafData.ofIdealTop (Ideal.ofList a)`.
This file records what is needed about it for the slicing lemma, Stacks tag 06LI: that a point
at which the germs of `a` form a regular sequence lies on `V(a)`, that `V(a) ⟶ X` is locally of
finite presentation when the ideal is finitely generated, and that flatness of `V(a)` over a
base at such a point is flatness of the corresponding quotient of the local ring.

## Main results

* `Stacks.AlgebraicGeometry.mem_maximalIdeal_of_mem_of_isRegular`: a member of a regular
  sequence in a local ring lies in the maximal ideal.
* `Stacks.AlgebraicGeometry.mem_support_ofIdealTop_of_isRegular_germ`: a point whose germs form
  a regular sequence lies on the zero scheme.
* `Stacks.AlgebraicGeometry.locallyOfFinitePresentation_subschemeι_ofIdealTop`: the zero scheme
  of a finitely generated ideal on an affine scheme is locally of finite presentation over it.
* `Stacks.AlgebraicGeometry.ker_stalkMap_subschemeι_ofIdealTop`: the kernel of the stalk map of
  the closed immersion is the ideal generated by the germs.
* `Stacks.AlgebraicGeometry.flat_stalkMap_subschemeι_comp_of_flat_quotient`: flatness of the
  zero scheme over a base at a point of it.

## Implementation notes

A point lies on the zero scheme exactly when every section in the list vanishes at it, which
`AlgebraicGeometry.Scheme.IdealSheafData.coe_support_ofIdealTop` expresses as membership of a
zero locus.  Regularity of the germs puts them in the maximal ideal of the local ring, which is
exactly the vanishing condition.

The kernel of the stalk map is computed with `Stacks.Flatness.ker_stalkMap_eq_map_germ`, which
identifies the stalk map of a morphism whose map on sections is surjective with the
localization of that map; the closed immersion of a closed subscheme of an affine scheme is of
that kind by `AlgebraicGeometry.IsClosedImmersion.isAffine_surjective_of_isAffine`, and its
kernel on sections is the ideal itself by
`AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι_app`.

## References

* [Stacks Project, Lemma 37.24.1 (Tag 06LI)](https://stacks.math.columbia.edu/tag/06LI)
-/

@[expose] public section

open CategoryTheory TopologicalSpace AlgebraicGeometry RingTheory.Sequence

namespace Stacks.AlgebraicGeometry

universe u

/-- **A member of a regular sequence in a local ring lies in the maximal ideal.**  A regular
sequence generates a proper ideal, since otherwise the whole ring would equal the ideal times
itself. -/
theorem mem_maximalIdeal_of_mem_of_isRegular {R : Type u} [CommRing R] [IsLocalRing R]
    {rs : List R} (h : IsRegular R rs) {a : R} (ha : a ∈ rs) :
    a ∈ IsLocalRing.maximalIdeal R := by
  have hproper : Ideal.ofList rs ≠ (⊤ : Ideal R) := by
    intro heq
    refine h.top_ne_smul ?_
    rw [heq]
    simp
  exact IsLocalRing.le_maximalIdeal hproper (Ideal.subset_span ha)

variable {X : Scheme.{u}}

/-- **A point at which the germs form a regular sequence lies on the zero scheme.**  Regularity
forces every germ into the maximal ideal, so every section of the list vanishes at the
point. -/
theorem mem_support_ofIdealTop_of_isRegular_germ (x : X) (a : List Γ(X, ⊤))
    (hr : IsRegular (X.presheaf.stalk x) (a.map (X.presheaf.germ ⊤ x trivial))) :
    x ∈ (Scheme.IdealSheafData.ofIdealTop (Ideal.ofList a)).support := by
  rw [← SetLike.mem_coe, Scheme.IdealSheafData.coe_support_ofIdealTop,
    Scheme.mem_zeroLocus_iff]
  intro s hs hx
  have hle : Ideal.map (X.presheaf.germ ⊤ x trivial).hom (Ideal.ofList a) ≤
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
    rw [Ideal.map_span]
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨b, hb, rfl⟩
    exact mem_maximalIdeal_of_mem_of_isRegular hr (List.mem_map.mpr ⟨b, hb, rfl⟩)
  exact (IsLocalRing.mem_maximalIdeal _).mp
    (hle (Ideal.mem_map_of_mem (X.presheaf.germ ⊤ x trivial).hom hs))
    ((X.mem_basicOpen_top s x).mp hx)

/-- **The ideal of the zero scheme on global sections.**  The closed immersion of the zero
scheme of `I` has `I` as the kernel of its map on global sections. -/
theorem ker_appTop_subschemeι_ofIdealTop [IsAffine X] (I : Ideal Γ(X, ⊤)) :
    RingHom.ker (Scheme.IdealSheafData.ofIdealTop I).subschemeι.appTop.hom = I := by
  have h := (Scheme.IdealSheafData.ofIdealTop I).ker_subschemeι_app ⟨⊤, isAffineOpen_top X⟩
  change RingHom.ker ((Scheme.IdealSheafData.ofIdealTop I).subschemeι.app ⊤).hom = I
  simpa [Scheme.IdealSheafData.ofIdealTop_ideal] using h

/-- **The zero scheme of a finitely generated ideal is locally of finite presentation.**  On an
affine scheme the closed immersion of the zero scheme is the spectrum of a quotient by a
finitely generated ideal. -/
theorem locallyOfFinitePresentation_subschemeι_ofIdealTop [IsAffine X] (I : Ideal Γ(X, ⊤))
    (hI : I.FG) :
    LocallyOfFinitePresentation (Scheme.IdealSheafData.ofIdealTop I).subschemeι := by
  obtain ⟨_, hsurj⟩ := IsClosedImmersion.isAffine_surjective_of_isAffine
    (Scheme.IdealSheafData.ofIdealTop I).subschemeι
  refine (HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFinitePresentation)).mpr ?_
  refine RingHom.FinitePresentation.of_surjective
    (Scheme.IdealSheafData.ofIdealTop I).subschemeι.appTop.hom hsurj ?_
  rwa [ker_appTop_subschemeι_ofIdealTop I]

/-- **The kernel of the stalk map of the zero scheme's closed immersion.**  At a point `x` of
the zero scheme of an ideal `I` on an affine scheme, the kernel of the induced map on local
rings is generated by the germs of `I`. -/
theorem ker_stalkMap_subschemeι_ofIdealTop [IsAffine X] (I : Ideal Γ(X, ⊤)) (x : X)
    (hx : x ∈ (Scheme.IdealSheafData.ofIdealTop I).support) :
    RingHom.ker
        (((Scheme.IdealSheafData.ofIdealTop I).subschemeι.stalkMap
          (⟨x, hx⟩ : (Scheme.IdealSheafData.ofIdealTop I).subscheme)).hom) =
      Ideal.map (X.presheaf.germ ⊤ x trivial).hom I := by
  obtain ⟨_, hsurj⟩ := IsClosedImmersion.isAffine_surjective_of_isAffine
    (Scheme.IdealSheafData.ofIdealTop I).subschemeι
  have hV : IsAffineOpen
      ((Scheme.IdealSheafData.ofIdealTop I).subschemeι ⁻¹ᵁ (⊤ : X.Opens)) := by
    simpa using isAffineOpen_top (Scheme.IdealSheafData.ofIdealTop I).subscheme
  rw [Stacks.Flatness.ker_stalkMap_eq_map_germ
      (Scheme.IdealSheafData.ofIdealTop I).subschemeι (x := ⟨x, hx⟩) (isAffineOpen_top X) hV
      le_rfl trivial trivial (by rwa [Scheme.Hom.appLE_eq_app]),
    Scheme.Hom.appLE_eq_app,
    show RingHom.ker ((Scheme.IdealSheafData.ofIdealTop I).subschemeι.app ⊤).hom = I from
      ker_appTop_subschemeι_ofIdealTop I]
  rfl

/-- **Flatness factors through a surjection with the right kernel.**  If `g` is surjective with
kernel `I` and the composite `R → A → A/I` is flat, then `R → B` is flat. -/
theorem flat_comp_of_flat_quotient {R A B : Type u} [CommRing R] [CommRing A] [CommRing B]
    (f : R →+* A) (g : A →+* B) (hg : Function.Surjective g) (I : Ideal A)
    (hI : I = RingHom.ker g) (hf : ((Ideal.Quotient.mk I).comp f).Flat) : (g.comp f).Flat := by
  subst hI
  let e := g.quotientKerEquivOfSurjective hg
  have h : e.toRingHom.comp ((Ideal.Quotient.mk (RingHom.ker g)).comp f) = g.comp f := by
    ext r
    exact RingHom.quotientKerEquivOfSurjective_apply_mk hg (f r)
  rw [← h]
  exact hf.comp (RingHom.Flat.of_bijective e.bijective)

/-- **The zero scheme is flat over the base where the quotient of the local ring is.**  Let
`f : X ⟶ S` with `X` affine, let `a` be a list of global sections of `X` and `x` a point of the
zero scheme `V(a)`.  If the quotient of `𝒪_{X, x}` by the ideal generated by the germs of `a`
is flat over `𝒪_{S, f x}`, then `V(a) ⟶ S` is flat at `x`. -/
theorem flat_stalkMap_subschemeι_comp_of_flat_quotient {S : Scheme.{u}} [IsAffine X]
    (f : X ⟶ S) (a : List Γ(X, ⊤)) (x : X)
    (hx : x ∈ (Scheme.IdealSheafData.ofIdealTop (Ideal.ofList a)).support)
    (hf : ((Ideal.Quotient.mk
      (Ideal.ofList (a.map (X.presheaf.germ ⊤ x trivial)))).comp (f.stalkMap x).hom).Flat) :
    ((((Scheme.IdealSheafData.ofIdealTop (Ideal.ofList a)).subschemeι ≫ f).stalkMap
      (⟨x, hx⟩ :
        (Scheme.IdealSheafData.ofIdealTop (Ideal.ofList a)).subscheme))).hom.Flat := by
  rw [Scheme.Hom.stalkMap_comp
    (Scheme.IdealSheafData.ofIdealTop (Ideal.ofList a)).subschemeι f ⟨x, hx⟩]
  refine flat_comp_of_flat_quotient _ _
    ((Scheme.IdealSheafData.ofIdealTop
      (Ideal.ofList a)).subschemeι.stalkMap_surjective ⟨x, hx⟩) _ ?_ hf
  change Ideal.ofList (a.map (X.presheaf.germ ⊤ x trivial)) =
    RingHom.ker ((Scheme.IdealSheafData.ofIdealTop (Ideal.ofList a)).subschemeι.stalkMap
      (⟨x, hx⟩ : (Scheme.IdealSheafData.ofIdealTop (Ideal.ofList a)).subscheme)).hom
  rw [ker_stalkMap_subschemeι_ofIdealTop (Ideal.ofList a) x hx, Ideal.map_ofList]

end Stacks.AlgebraicGeometry

end
