module

public import Mathlib.Algebra.Module.SpanRankOperations
public import Mathlib.LinearAlgebra.Dimension.OrzechProperty
public import StacksFrontier.AlgebraicGeometry.Conormal.SplitCotangentFibre
public import StacksFrontier.AlgebraicGeometry.Conormal.Stalk
public import StacksFrontier.AlgebraicGeometry.FreeStalkBasis.LocalRank
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularImmersion.SplitConormalToolkit
