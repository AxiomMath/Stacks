module

public import StacksFrontier.AlgebraicGeometry.TwistDataFromChart.Basic

/-!
# The chart section comparison is compatible with restriction and with scalars

`Stacks.AlgebraicGeometry.RelativeProjTwists.ChartData.mapSection` carries a section of the
absolute twist `𝒪_{Proj Γ(U, A)}(n)` over an open `V` of the chart to a section of the glued
twist over the image `chart ''ᵁ V`. The two structural compatibilities of that comparison are
proved here: it commutes with restriction to a smaller open of the chart, and it is linear over
the identification of rings of functions supplied by the chart being an open immersion.

Neither was available before, and both are needed to use a *local* statement about the absolute
twist on a chart — for instance that `𝒪(n)` is freely generated by a degree-one section on a
standard open — as a statement about the glued twist on the relative Proj. The existing
`Stacks.AlgebraicGeometry.TwistDataFromChart.mapSection_chartPull` handles only the target side
of the comparison, and `Stacks.AlgebraicGeometry.RelativeProjTwists.TwistData.ψ_chart` computes
the comparison only at the whole chart.

## Main results

* `Stacks.AlgebraicGeometry.TwistDataFromChart.mapSection_res`: **restriction compatibility.**
  The comparison of the restriction of a section to `V' ≤ V` is the restriction of the comparison
  to `chart ''ᵁ V' ≤ chart ''ᵁ V`.
* `Stacks.AlgebraicGeometry.TwistDataFromChart.mapSection_smul`: **scalar compatibility.** The
  comparison of `r • a` is `chartScalar r • ` the comparison of `a`, for
  `Stacks.AlgebraicGeometry.TwistDataFromChart.chartScalar` the chart's identification of rings
  of functions. The scalar has to be moved along `AlgebraicGeometry.Scheme.Hom.appIso`, because a
  section of the restriction of a module along an open immersion is a module over the ring of
  functions on the *source*, while the comparison's target is a module over the ring of functions
  on the image.

## Implementation notes

The comparison is `AlgebraicGeometry.Scheme.Modules.restrictAppIso` after the inverse of the
chart identification. The first factor is a morphism of sheaves of modules, so restriction
compatibility is its naturality and scalar compatibility is its linearity; the second factor is
the identity on underlying elements but not on module structures, and the two facts about it are
`AlgebraicGeometry.Scheme.Modules.map_restrictAppIso_hom_apply` and
`AlgebraicGeometry.Scheme.Modules.smul_restrictAppIso_hom_apply`.

**Linearity is applied as a term, not by rewriting.** The scalar `r` lives in the ring of
functions of the chart while the module of sections is spelled through the sheaf of rings of the
Proj scheme; the two are definitionally equal but `rw [map_smul]` does not find its pattern.
This is the same point recorded in the implementation notes of
`StacksFrontier.AlgebraicGeometry.ProjectiveBundleTwists.Epi`.

## References

* [Stacks Project, Tag 01NR](https://stacks.math.columbia.edu/tag/01NR)
* [Stacks Project, Tag 01O4](https://stacks.math.columbia.edu/tag/01O4)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite
open AlgebraicGeometry
open AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjTwistSections
open Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.AlgebraicGeometry.RelativeProj
open Stacks.AlgebraicGeometry.RelativeProjTwists

namespace Stacks.AlgebraicGeometry.TwistDataFromChart

universe u

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf
attribute [local instance_reducible] ProjectiveSpectrum.top

variable {S : Scheme.{u}} {A : SheafGradedAlgebra S}
  {algebra : SchemeGradedAlgebra (relativeProj A).scheme}

/-- **The chart section comparison commutes with restriction of the open.** The comparison of
the restriction of `a` to a smaller open `V'` of the chart is the restriction of the comparison
of `a` to the image of `V'`. -/
public theorem mapSection_res (D : ChartData A algebra) (U : S.Opens) (hU : IsAffineOpen U)
    (n : ℤ) {V V' : (AlgebraicGeometry.Proj (A.grading U)).Opens} (h : V' ≤ V)
    (a : (twistingSheaf (A.grading U) n).val.obj (op V)) :
    letI := D.chart_isOpenImmersion U hU
    D.mapSection U hU n V' ((twistingSheaf (A.grading U) n).val.map (homOfLE h).op a) =
      (algebra.piece n).val.map
        (homOfLE (Scheme.Hom.image_mono ((relativeProj A).chart U hU) h)).op
        (D.mapSection U hU n V a) := by
  let := D.chart_isOpenImmersion U hU
  refine Eq.trans (congrArg
    (Scheme.Modules.restrictAppIso ((relativeProj A).chart U hU) (algebra.piece n) V').hom
    (PresheafOfModules.naturality_apply (D.chartIso U hU n).inv.val (homOfLE h).op a)) ?_
  exact Scheme.Modules.map_restrictAppIso_hom_apply ((relativeProj A).chart U hU)
    (algebra.piece n) (homOfLE h).op _

/-- **The chart's identification of rings of functions**, in the spelling the module structures
on the sections of the twists use: `AlgebraicGeometry.Scheme.Hom.appIso` reads a function on an
open of the chart as a function on its image, and that is the ring over which the comparison of
`Stacks.AlgebraicGeometry.TwistDataFromChart.mapSection_smul` is linear. -/
public def chartScalar (D : ChartData A algebra) (U : S.Opens) (hU : IsAffineOpen U)
    (V : (AlgebraicGeometry.Proj (A.grading U)).Opens)
    (r : (ProjectiveSpectrum.Proj.structureSheaf (A.grading U)).obj.obj (op V)) :
    letI := D.chart_isOpenImmersion U hU
    (relativeProj A).scheme.ringCatSheaf.obj.obj
      (op ((relativeProj A).chart U hU ''ᵁ V)) :=
  let := D.chart_isOpenImmersion U hU
  (Scheme.Hom.appIso ((relativeProj A).chart U hU) V).inv r

/-- **The chart section comparison is linear over the chart's identification of rings of
functions.** A section of the absolute twist over `V` is a module over the functions on `V`,
while its comparison is a module over the functions on the image `chart ''ᵁ V`, and the scalar
crosses that by `Stacks.AlgebraicGeometry.TwistDataFromChart.chartScalar`. -/
public theorem mapSection_smul (D : ChartData A algebra) (U : S.Opens) (hU : IsAffineOpen U)
    (n : ℤ) (V : (AlgebraicGeometry.Proj (A.grading U)).Opens)
    (r : (ProjectiveSpectrum.Proj.structureSheaf (A.grading U)).obj.obj (op V))
    (a : (twistingSheaf (A.grading U) n).val.obj (op V)) :
    letI := D.chart_isOpenImmersion U hU
    D.mapSection U hU n V (r • a) =
      chartScalar D U hU V r • D.mapSection U hU n V a := by
  let := D.chart_isOpenImmersion U hU
  refine Eq.trans (congrArg
    (Scheme.Modules.restrictAppIso ((relativeProj A).chart U hU) (algebra.piece n) V).hom
    ((ConcreteCategory.hom ((D.chartIso U hU n).inv.val.app (op V))).map_smul r a)) ?_
  exact Scheme.Modules.smul_restrictAppIso_hom_apply ((relativeProj A).chart U hU)
    (algebra.piece n) V r _

end Stacks.AlgebraicGeometry.TwistDataFromChart

end
