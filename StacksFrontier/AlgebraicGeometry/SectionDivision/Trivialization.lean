module

public import StacksFrontier.AlgebraicGeometry.SectionDivision.Basic
public import StacksFrontier.AlgebraicGeometry.Chow.ZeroSchemePullback.LocalEquation
public import StacksFrontier.AlgebraicGeometry.SectionProduct.Tensor
public import StacksFrontier.AlgebraicGeometry.Segre.DivBySectionTensor

/-!
# The trivialization of an invertible module by a nonvanishing section

Let `L` be an invertible module on a scheme `X` and `s` a global section of `L`. On an open `V`
contained in the nonvanishing locus `X_s`, multiplication by `s` identifies `𝒪_X(V)` with
`L(V)` ([Stacks, Tag 01CY]); its inverse is division by `s`
(`Stacks.SheafOfModules.divBySection`). This file packages the pair as an isomorphism of
`𝒪_X(V)`-modules and reads off the local equation of a zero scheme: on an affine open `U ⊆ X_s`
the ideal of the zero scheme of a global section `σ` is generated by the function `σ / s`.

## Main definitions

* `Stacks.SheafOfModules.divBySectionEquiv`: the `𝒪_X(V)`-linear isomorphism `L(V) ≃ 𝒪_X(V)`,
  `t ↦ t / s`.

## Main results

* `Stacks.SheafOfModules.zeroScheme_ideal_eq_span_divBySection`: the ideal of the zero scheme of
  `σ` on an affine open `U ⊆ X_s` is `(σ / s)`.
* `Stacks.SheafOfModules.divBySection_tensorSectionsAt`: `(m ⊗ n) / (s ⊗ t) = (m / s) (n / t)`
  for arbitrary local sections `m`, `n`.

## References

* [Stacks Project, Tag 01CY](https://stacks.math.columbia.edu/tag/01CY)
* [Stacks Project, Tag 02OQ](https://stacks.math.columbia.edu/tag/02OQ)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry

universe u

namespace Stacks.SheafOfModules

variable {X : Scheme.{u}} (L : X.Modules)
  [IsInvertible X.presheaf (structureSheafRing X.toRingedSpace).property L]

/-- **The trivialization of `L` by a nonvanishing section**: on an open `V` contained in the
nonvanishing locus of the global section `s`, division by `s` is an isomorphism of
`𝒪_X(V)`-modules `L(V) ≃ 𝒪_X(V)`, with inverse `c ↦ c · s|_V`. -/
def divBySectionEquiv (s : L.sections) {V : X.Opens}
    (hV : V ≤ nonvanishingOpen (X := X.toRingedSpace) L s) : Γ(L, V) ≃ₗ[Γ(X, V)] Γ(X, V) where
  toFun := divBySection (X := X.toRingedSpace) L s hV
  invFun c := c • (show Γ(L, V) from s.eval (op V))
  map_add' := divBySection_add (X := X.toRingedSpace) L s hV
  map_smul' c t := divBySection_smul (X := X.toRingedSpace) L s hV c t
  left_inv t := smul_divBySection (X := X.toRingedSpace) L s hV t
  right_inv _ := divBySection_eq_of_smul_eq (X := X.toRingedSpace) L s hV rfl

/-- The isomorphism `divBySectionEquiv L s hV` sends a section `t` of `L` over `V` to `t / s`. -/
@[simp]
theorem divBySectionEquiv_apply (s : L.sections) {V : X.Opens}
    (hV : V ≤ nonvanishingOpen (X := X.toRingedSpace) L s) (t : Γ(L, V)) :
    divBySectionEquiv L s hV t = divBySection (X := X.toRingedSpace) L s hV t :=
  rfl

/-- **The local equation of a zero scheme on the nonvanishing locus of a section.** On an
affine open `U` on which the global section `s` of `L` does not vanish, the ideal of the zero
scheme of a global section `σ` is generated by the function `σ / s`. -/
theorem zeroScheme_ideal_eq_span_divBySection
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (σ : Γ(L, ⊤)) (s : L.sections) (U : X.affineOpens)
    (hU : U.1 ≤ nonvanishingOpen (X := X.toRingedSpace) L s) :
    (Stacks.Divisors.zeroScheme X L σ).ideal U =
      Ideal.span {(divBySection (X := X.toRingedSpace) L s hU
        (L.presheaf.map (homOfLE le_top).op σ))} :=
  Stacks.Divisors.zeroScheme_ideal_of_trivialization X L σ U (divBySectionEquiv L s hU) _ rfl

section Tensor

variable (F G : X.Modules)
  [IsInvertible X.presheaf (structureSheafRing X.toRingedSpace).property F]
  [IsInvertible X.presheaf (structureSheafRing X.toRingedSpace).property G]
  [IsInvertible X.presheaf (structureSheafRing X.toRingedSpace).property
    ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨X.toRingedSpace.presheaf,
      X.toRingedSpace.IsSheaf⟩).obj F).obj G))]

/-- **The ratio of a product of local sections by a product of global ones is the product of the
ratios**: `(m ⊗ n) / (s ⊗ t) = (m / s) · (n / t)` over an open on which `s` and `t` do not
vanish, for arbitrary sections `m`, `n` over that open. -/
theorem divBySection_tensorSectionsAt (sF : F.sections) (sG : G.sections) {V : X.Opens}
    (hVF : V ≤ nonvanishingOpen (X := X.toRingedSpace) F sF)
    (hVG : V ≤ nonvanishingOpen (X := X.toRingedSpace) G sG) (m : Γ(F, V)) (n : Γ(G, V)) :
    divBySection (X := X.toRingedSpace) ((((Stacks.SheafOfModules.Tensor.sheafTensor
        ⟨X.toRingedSpace.presheaf, X.toRingedSpace.IsSheaf⟩).obj F).obj G))
        (tensorSections F G sF sG) (le_nonvanishingOpen_tensorSections F G sF sG hVF hVG)
        (Stacks.SheafOfModules.tensorSectionsAt X.sheaf.obj X.ringCatSheaf.property (op V) F G
          m n) =
      divBySection (X := X.toRingedSpace) F sF hVF m *
        divBySection (X := X.toRingedSpace) G sG hVG n := by
  refine divBySection_eq_of_smul_eq _ _ _ ?_
  have h := Stacks.SectionProduct.tensorSectionsAt_smul_smul F G
    (divBySection (X := X.toRingedSpace) F sF hVF m)
    (divBySection (X := X.toRingedSpace) G sG hVG n) (sF.eval (op V)) (sG.eval (op V))
  exact h.symm.trans (congrArg₂ (fun a b => Stacks.SheafOfModules.tensorSectionsAt X.sheaf.obj
    X.ringCatSheaf.property (op V) F G a b) (smul_divBySection (X := X.toRingedSpace) F sF hVF m)
    (smul_divBySection (X := X.toRingedSpace) G sG hVG n))

end Tensor

end Stacks.SheafOfModules
