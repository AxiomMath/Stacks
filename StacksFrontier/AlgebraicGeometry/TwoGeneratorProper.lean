module

public import Mathlib.AlgebraicGeometry.Morphisms.Proper
public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Proper
public import StacksFrontier.AlgebraicGeometry.TwoGeneratorSquare

/-!
# The two-generator modification is proper over the base

The modification of the two-generator almost blowup square of
`StacksFrontier/AlgebraicGeometry/TwoGeneratorSquare.lean` is
`Proj (A[T₀,T₁]/(f₂T₀-f₁T₁))`, and this file proves that its structure morphism to `Spec A` is
proper.

## Main results

* `Stacks.AlmostBlowUp.baseRingEquiv` identifies `A` with the degree-zero part of
  `A[T₀,T₁]/(f₂T₀-f₁T₁)`.
* `Stacks.AlmostBlowUp.isProper_modificationToBase` is properness of the modification over
  `Spec A`.

## References

* [Stacks Project, Tag 0EVH](https://stacks.math.columbia.edu/tag/0EVH)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.AlmostBlowUp

variable (A : Type u) [CommRing A] (f₁ f₂ : A)

/-- The relation `f₂T₀-f₁T₁` has zero constant coefficient, so every element of the relation
ideal does. -/
theorem relationIdeal_le_ker_constantCoeff :
    relationIdeal A f₁ f₂ ≤
      RingHom.ker (MvPolynomial.constantCoeff (σ := Fin 2) (R := A)) := by
  rw [relationIdeal, Ideal.span_le]
  intro x hx
  rw [Set.mem_singleton_iff] at hx
  simp [hx, SetLike.mem_coe, RingHom.mem_ker]

/-- A homogeneous polynomial of degree zero is a constant. -/
theorem exists_C_of_mem_homogeneousSubmodule_zero {p : MvPolynomial (Fin 2) A}
    (hp : p ∈ MvPolynomial.homogeneousSubmodule (Fin 2) A 0) :
    ∃ a : A, p = MvPolynomial.C a := by
  rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hp
  obtain ⟨a, ha⟩ := hp
  exact ⟨a, ha.symm⟩

section Graded

variable [GradedRing (modificationGrading A f₁ f₂)]

/-- The coefficient map from `A` to the degree-zero part of `A[T₀,T₁]/(f₂T₀-f₁T₁)` is
injective. -/
theorem baseRingHom_injective : Function.Injective (baseRingHom A f₁ f₂) := by
  rw [injective_iff_map_eq_zero]
  intro a ha
  have h : Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.C a) = 0 :=
    congrArg Subtype.val ha
  have hmem : MvPolynomial.C a ∈ relationIdeal A f₁ f₂ :=
    Ideal.Quotient.eq_zero_iff_mem.mp h
  simpa using RingHom.mem_ker.mp (relationIdeal_le_ker_constantCoeff A f₁ f₂ hmem)

/-- The coefficient map from `A` to the degree-zero part of `A[T₀,T₁]/(f₂T₀-f₁T₁)` is
surjective. -/
theorem baseRingHom_surjective : Function.Surjective (baseRingHom A f₁ f₂) := by
  rintro ⟨x, hx⟩
  obtain ⟨p, hp, rfl⟩ := AddSubgroup.mem_map.mp hx
  obtain ⟨a, rfl⟩ :=
    exists_C_of_mem_homogeneousSubmodule_zero A (Submodule.mem_toAddSubgroup _ |>.mp hp)
  exact ⟨a, rfl⟩

/-- **The degree-zero part of `A[T₀,T₁]/(f₂T₀-f₁T₁)` is `A`.** The coefficient map is an
isomorphism onto it. -/
def baseRingEquiv : A ≃+* modificationGrading A f₁ f₂ 0 :=
  RingEquiv.ofBijective _ ⟨baseRingHom_injective A f₁ f₂, baseRingHom_surjective A f₁ f₂⟩

/-- The isomorphism `baseRingEquiv` sends `a` to its image under the coefficient map
`baseRingHom`. -/
@[simp]
theorem baseRingEquiv_apply (a : A) : baseRingEquiv A f₁ f₂ a = baseRingHom A f₁ f₂ a := rfl

/-- The two-variable polynomial ring over the degree-zero part evaluates onto
`A[T₀,T₁]/(f₂T₀-f₁T₁)`, sending the variables to the classes of the variables. -/
theorem modificationAeval_surjective :
    Function.Surjective (MvPolynomial.aeval (R := modificationGrading A f₁ f₂ 0)
      (fun i : Fin 2 ↦ Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.X i))) := by
  intro x
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  induction p using MvPolynomial.induction_on with
  | C a =>
    refine ⟨MvPolynomial.C (baseRingHom A f₁ f₂ a), ?_⟩
    rw [MvPolynomial.aeval_C]
    rfl
  | add p q hp hq =>
    obtain ⟨u, hu⟩ := hp
    obtain ⟨v, hv⟩ := hq
    exact ⟨u + v, by rw [map_add, hu, hv, map_add]⟩
  | mul_X p i hp =>
    obtain ⟨u, hu⟩ := hp
    exact ⟨u * MvPolynomial.X i, by rw [map_mul, hu, map_mul]; simp⟩

/-- `A[T₀,T₁]/(f₂T₀-f₁T₁)` is of finite type over its degree-zero part: it is generated by the
classes of the two variables. -/
instance finiteType_modificationRing :
    Algebra.FiniteType (modificationGrading A f₁ f₂ 0) (modificationRing A f₁ f₂) :=
  Algebra.FiniteType.iff_quotient_mvPolynomial''.mpr
    ⟨2, MvPolynomial.aeval _, modificationAeval_surjective A f₁ f₂⟩

/-- The lower edge `Spec A₀ ⟶ Spec A` of the factorization of the modification is an
isomorphism. -/
instance isIso_Spec_map_baseRingHom :
    IsIso (Spec.map (CommRingCat.ofHom (baseRingHom A f₁ f₂))) := by
  have : IsIso (CommRingCat.ofHom (baseRingHom A f₁ f₂)) :=
    (baseRingEquiv A f₁ f₂).toCommRingCatIso.isIso_hom
  infer_instance

end Graded

/-- **The two-generator modification is proper over `Spec A`**: the structure morphism of the
projective spectrum of `A[T₀,T₁]/(f₂T₀-f₁T₁)` to `Spec A` is proper. -/
theorem isProper_modificationToBase : IsProper (modificationToBase A f₁ f₂) := by
  let : GradedRing (modificationGrading A f₁ f₂) := modificationGradedRing A f₁ f₂
  have h₁ : IsProper (Proj.toSpecZero (modificationGrading A f₁ f₂)) := inferInstance
  have h₂ : IsProper (Spec.map (CommRingCat.ofHom (baseRingHom A f₁ f₂))) := inferInstance
  exact MorphismProperty.comp_mem _ _ _ h₁ h₂

end Stacks.AlmostBlowUp

end
