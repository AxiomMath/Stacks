module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Submodule
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.RingedSpace.IdealSheafGenerators
public import StacksFrontier.AlgebraicGeometry.QuasiRegular.Germs
public import StacksFrontier.AlgebraicGeometry.QuasiRegular.Presentation

/-!
# The quasi-regularity map on a ringed space

Let `X` be a ringed space and let `f₁, ..., f_r` be global sections of its structure sheaf.  They
generate an ideal sheaf `J ⊆ O_X`, and there is a canonical morphism of sheaves of rings

`(O_X / J)[T₁, ..., T_r] ⟶ ⨁_{d ≥ 0} J^d / J^{d+1}`

sending `Tᵢ` to the class of `fᵢ` modulo `J²`.  This is Stacks tag 063B; the sequence
`f₁, ..., f_r` is *quasi-regular* precisely when this morphism is an isomorphism.

Both sheaves are constructed from the same `StalkPresentation` machinery: the sections over `U` are
the families of elements of the stalks which are locally given by a polynomial with coefficients in
`O_X(U)`, the source stalk being `O_{X,x}/J_x[T]` and the target stalk being the quotient of
`O_{X,x}/J_x[T]` by the kernel of the ring-level quasi-regularity map, which is additively
`⨁_d J_x^d/J_x^{d+1}`.  The morphism between them is, on stalks, the quotient map.

## Main definitions

* `polynomialGerm X f U x hx`: reduce the coefficients of a polynomial over `O_X(U)` modulo `J_x`
  after taking germs at `x`.
* `generatedIdeal X f`: the ideal subsheaf of `O_X` generated by the global sections `f`.
* `polynomialPresentation X f`, `associatedGradedPresentation X f`: the two sheaves, as
  `StalkPresentation`s.
* `QuasiRegularMapData X f`: a bundle recording the two sheaves, their local polynomial
  presentations, the canonical morphism, and the identification of its stalks with the ring-level
  quasi-regularity map.
* `quasiRegularMap X f`: the canonical morphism of sheaves.

## References

* [Stacks Project, Tag 063B](https://stacks.math.columbia.edu/tag/063B)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.RingTheory.QuasiRegular
open Stacks.RingedSpace

universe u

namespace Stacks.AlgebraicGeometry.QuasiRegular

variable {X : RingedSpace.{u}} {r : ℕ} (f : Fin r → X.presheaf.obj (op (⊤ : Opens X)))

/-- Iterated restriction of a section is restriction. -/
theorem res_res {U V W : Opens X} (h₁ : V ≤ U) (h₂ : W ≤ V) (s : X.presheaf.obj (op U)) :
    X.presheaf.map (homOfLE h₂).op (X.presheaf.map (homOfLE h₁).op s)
      = X.presheaf.map (homOfLE (h₂.trans h₁)).op s := by
  rw [← ConcreteCategory.comp_apply, ← X.presheaf.map_comp]
  rfl

section PolynomialGerm

/-- Take the germs at `x` of the coefficients of a polynomial over `O_X(U)` and reduce them modulo
the ideal generated by the germs of `f`. -/
noncomputable def polynomialGerm (X : RingedSpace.{u}) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op (⊤ : Opens X)))
    (U : Opens X) (x : X) (hx : x ∈ U) :
    MvPolynomial (Fin r) (X.presheaf.obj (op U)) →+*
      MvPolynomial (Fin r) (qrRbar (germSequence X f x)) :=
  MvPolynomial.map ((Ideal.Quotient.mk (Jid (germSequence X f x))).comp
    (X.presheaf.germ U x hx).hom)

/-- `polynomialGerm` is the composite of taking germs of coefficients at `x` and reducing them
modulo the ideal generated by the germs of `f`. -/
theorem polynomialGerm_eq_map_map (U : Opens X) (x : X) (hx : x ∈ U)
    (p : MvPolynomial (Fin r) (X.presheaf.obj (op U))) :
    polynomialGerm X f U x hx p
      = MvPolynomial.map (Ideal.Quotient.mk (Jid (germSequence X f x)))
          (MvPolynomial.map (X.presheaf.germ U x hx).hom p) := by
  rw [polynomialGerm, MvPolynomial.map_map]

/-- `polynomialGerm` at `x ∈ U ⊆ V` of a polynomial over `O_X(V)` equals `polynomialGerm` of its
restriction to `U`. -/
theorem polynomialGerm_res {U V : Opens X} (hUV : U ≤ V) (x : X) (hx : x ∈ U)
    (p : MvPolynomial (Fin r) (X.presheaf.obj (op V))) :
    polynomialGerm X f V x (hUV hx) p
      = polynomialGerm X f U x hx
          (MvPolynomial.map (X.presheaf.map (homOfLE hUV).op).hom p) := by
  have hring : ((Ideal.Quotient.mk (Jid (germSequence X f x))).comp
        (X.presheaf.germ U x hx).hom).comp (X.presheaf.map (homOfLE hUV).op).hom
      = (Ideal.Quotient.mk (Jid (germSequence X f x))).comp
          (X.presheaf.germ V x (hUV hx)).hom :=
    RingHom.ext fun s => congrArg (Ideal.Quotient.mk (Jid (germSequence X f x)))
      (TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hUV) x hx s)
  rw [polynomialGerm, polynomialGerm, MvPolynomial.map_map, hring]

/-- `polynomialGerm X f U x hx p` vanishes exactly when the germ at `x` of every coefficient of
`p` lies in the ideal generated by the germs of `f`. -/
theorem polynomialGerm_eq_zero_iff (U : Opens X) (x : X) (hx : x ∈ U)
    (p : MvPolynomial (Fin r) (X.presheaf.obj (op U))) :
    polynomialGerm X f U x hx p = 0 ↔
      ∀ e : Fin r →₀ ℕ,
        X.presheaf.germ U x hx (p.coeff e) ∈ Jid (germSequence X f x) := by
  rw [MvPolynomial.ext_iff]
  refine forall_congr' fun e => ?_
  rw [polynomialGerm, MvPolynomial.coeff_map, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply,
    RingHom.comp_apply,
    Ideal.Quotient.eq_zero_iff_mem]

end PolynomialGerm

section Presentations

/-- The sheaf `(O_X/J)[T₁, ..., T_r]` of Stacks tag 063B, as a stalk presentation: its stalk at `x`
is the polynomial algebra over `O_{X,x}/J_x`, and a polynomial over `O_X(U)` presents the section
whose germ at each `x ∈ U` is the reduction of its coefficients. -/
noncomputable def polynomialPresentation (X : RingedSpace.{u}) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op (⊤ : Opens X))) : StalkPresentation X r where
  obj x := CommRingCat.of (MvPolynomial (Fin r) (qrRbar (germSequence X f x)))
  pres U x hx := polynomialGerm X f U x hx
  pres_res hUV x hx p := polynomialGerm_res f hUV x hx p
  pres_eq_zero_nhds U x hx p h := by
    classical
    have hco := (polynomialGerm_eq_zero_iff f U x hx p).mp h
    obtain ⟨V, hxV, hVU, hV⟩ := exists_nhds_forall_germ_mem_Jid_pow f p.support U
      (fun e => p.coeff e) (fun _ => 1) x hx
      (fun e _ => by simpa only [pow_one] using hco e)
    refine ⟨V, hxV, hVU, fun y hy => (polynomialGerm_eq_zero_iff f U y (hVU hy) p).mpr
      fun e => ?_⟩
    by_cases he : e ∈ p.support
    · simpa only [pow_one] using hV e he y hy
    · rw [MvPolynomial.notMem_support_iff.mp he, map_zero]
      exact Ideal.zero_mem _
  pres_surjective x q := by
    classical
    choose lift hlift using fun e : Fin r →₀ ℕ =>
      Ideal.Quotient.mk_surjective (I := Jid (germSequence X f x)) (q.coeff e)
    obtain ⟨V, hxV, b, hb⟩ := exists_nhds_germ_eq q.support x lift
    refine ⟨V, hxV, ∑ e ∈ q.support, MvPolynomial.monomial e (b e), ?_⟩
    rw [polynomialGerm, map_sum]
    conv_rhs => rw [MvPolynomial.as_sum q]
    refine Finset.sum_congr rfl fun e he => ?_
    rw [MvPolynomial.map_monomial, RingHom.comp_apply, hb e he, hlift e]

/-- The degree-`d` part, as a section over `U`, of a polynomial `p` over `O_X(U)` evaluated at the
family `f`: `∑_{e ∈ S, |e| = d} f^e · (coeff e p)`. -/
noncomputable def gradedPartSection (U : Opens X)
    (p : MvPolynomial (Fin r) (X.presheaf.obj (op U))) (S : Finset (Fin r →₀ ℕ)) (d : ℕ) :
    X.presheaf.obj (op U) :=
  ∑ e ∈ S with qrMdeg e = d, fpow (restrictFamily X f U) e * p.coeff e

/-- The germ at `x` of `gradedPartSection f U p S d` is the degree-`d` part `gradedPartOn` of the
polynomial obtained by taking germs of the coefficients of `p`. -/
theorem germ_gradedPartSection (U : Opens X)
    (p : MvPolynomial (Fin r) (X.presheaf.obj (op U))) (S : Finset (Fin r →₀ ℕ)) (d : ℕ)
    (x : X) (hx : x ∈ U) :
    X.presheaf.germ U x hx (gradedPartSection f U p S d)
      = gradedPartOn (germSequence X f x)
          (MvPolynomial.map (X.presheaf.germ U x hx).hom p) S d := by
  rw [gradedPartSection, map_sum, gradedPartOn_eq_sum]
  refine Finset.sum_congr rfl fun e _ => ?_
  rw [map_mul, germ_fpow, MvPolynomial.coeff_map]

/-- `gradedPartSection f U p S d` vanishes when no exponent in `S` has total degree `d`. -/
theorem gradedPartSection_eq_zero (U : Opens X)
    (p : MvPolynomial (Fin r) (X.presheaf.obj (op U))) (S : Finset (Fin r →₀ ℕ)) (d : ℕ)
    (hd : d ∉ S.image qrMdeg) : gradedPartSection f U p S d = 0 := by
  classical
  rw [gradedPartSection, Finset.sum_eq_zero]
  intro e he
  obtain ⟨heS, hde⟩ := Finset.mem_filter.mp he
  exact absurd (hde ▸ Finset.mem_image_of_mem qrMdeg heS) hd

/-- The relation imposed on a polynomial by the associated graded sheaf at a point: the reduction
of `p` modulo `J_x` lies in the kernel of the ring-level quasi-regularity map exactly when every
degree-`d` part of `p` has germ in `J_x^{d+1}`. -/
theorem mk_polynomialGerm_eq_zero_iff (U : Opens X) (x : X) (hx : x ∈ U)
    (p : MvPolynomial (Fin r) (X.presheaf.obj (op U))) :
    Ideal.Quotient.mk (associatedGradedIdeal (germSequence X f x))
        (polynomialGerm X f U x hx p) = 0
      ↔ ∀ d, X.presheaf.germ U x hx (gradedPartSection f U p p.support d)
          ∈ (Jid (germSequence X f x)) ^ (d + 1) := by
  rw [Ideal.Quotient.eq_zero_iff_mem, mem_associatedGradedIdeal,
    polynomialGerm_eq_map_map f U x hx p,
    associatedGradedMap_map_eq_zero_iff _ _ p.support (MvPolynomial.support_map_subset _ _)]
  exact forall_congr' fun d => by rw [germ_gradedPartSection]

/-- The sheaf `⨁_{d ≥ 0} J^d/J^{d+1}` of Stacks tag 063B, as a stalk presentation: its stalk at `x`
is the quotient of `O_{X,x}/J_x[T]` by the kernel of the ring-level quasi-regularity map, which is
additively the associated graded ring of `O_{X,x}` for the `J_x`-adic filtration. -/
noncomputable def associatedGradedPresentation (X : RingedSpace.{u}) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op (⊤ : Opens X))) : StalkPresentation X r where
  obj x := CommRingCat.of
    (MvPolynomial (Fin r) (qrRbar (germSequence X f x)) ⧸ associatedGradedIdeal
      (germSequence X f x))
  pres U x hx := (Ideal.Quotient.mk (associatedGradedIdeal (germSequence X f x))).comp
    (polynomialGerm X f U x hx)
  pres_res hUV x hx p := by
    rw [RingHom.comp_apply, RingHom.comp_apply, polynomialGerm_res f hUV x hx p]
  pres_eq_zero_nhds U x hx p h := by
    classical
    obtain ⟨V, hxV, hVU, hV⟩ := exists_nhds_forall_germ_mem_Jid_pow f
      (p.support.image qrMdeg) U (fun d => gradedPartSection f U p p.support d)
      (fun d => d + 1) x hx (fun d _ => (mk_polynomialGerm_eq_zero_iff f U x hx p).mp h d)
    refine ⟨V, hxV, hVU,
      fun y hy => (mk_polynomialGerm_eq_zero_iff f U y (hVU hy) p).mpr fun d => ?_⟩
    by_cases hd : d ∈ p.support.image qrMdeg
    · exact hV d hd y hy
    · rw [gradedPartSection_eq_zero f U p p.support d hd, map_zero]
      exact Ideal.zero_mem _
  pres_surjective x a := by
    obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective
      (I := associatedGradedIdeal (germSequence X f x)) a
    obtain ⟨V, hxV, p, hp⟩ := (polynomialPresentation X f).pres_surjective x q
    exact ⟨V, hxV, p, by
      rw [RingHom.comp_apply, show polynomialGerm X f V x hxV p = q from hp, hq]⟩

/-- The canonical morphism of the two presentations: on each stalk it is the quotient map from the
polynomial algebra to the associated graded ring. -/
noncomputable def gradedProjection (X : RingedSpace.{u}) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op (⊤ : Opens X))) :
    (polynomialPresentation X f).Hom (associatedGradedPresentation X f) where
  app x := CommRingCat.ofHom (Ideal.Quotient.mk (associatedGradedIdeal (germSequence X f x)))
  app_pres _ _ _ _ := rfl

/-- The additive identification of the stalk of the associated graded sheaf at `x` with
`⨁_d J_x^d / J_x^{d+1}`. -/
noncomputable def gradedStalkAddEquiv (x : X) :
    ((associatedGradedPresentation X f).presheaf.stalk x : Type u)
      ≃+ Target (X.presheaf.stalk x) (germSequence X f x) :=
  (AddEquiv.ofBijective ((associatedGradedPresentation X f).stalkDesc x).hom.toAddMonoidHom
    ((associatedGradedPresentation X f).stalkDesc_bijective x)).trans
    (gradedQuotEquiv (germSequence X f x))

/-- `gradedStalkAddEquiv f x` is `gradedQuotEquiv` applied after the stalk descent map of the
associated graded presentation. -/
theorem gradedStalkAddEquiv_apply (x : X)
    (t : (associatedGradedPresentation X f).presheaf.stalk x) :
    gradedStalkAddEquiv f x t
      = gradedQuotEquiv (germSequence X f x)
          ((associatedGradedPresentation X f).stalkDesc x t) := rfl

/-- Under the stalk identifications, the stalk of the canonical morphism is the ring-level
quasi-regularity map. -/
theorem gradedStalkAddEquiv_stalkFunctor (x : X)
    (p : (polynomialPresentation X f).presheaf.stalk x) :
    gradedStalkAddEquiv f x ((TopCat.Presheaf.stalkFunctor CommRingCat.{u} x).map
        (gradedProjection X f).sheafMap.hom p)
      = associatedGradedMap (germSequence X f x)
          (((polynomialPresentation X f).stalkIso x).hom p) :=
  congrArg (gradedQuotEquiv (germSequence X f x))
    ((gradedProjection X f).stalkIso_hom_stalkFunctor_map x p)

/-- The germ at `x` of the section of the associated graded sheaf presented by `p` is the value of
the ring-level quasi-regularity map on the reduction of `p`. -/
theorem gradedStalkAddEquiv_germ (U : Opens X) (x : X) (hx : x ∈ U)
    (p : MvPolynomial (Fin r) (X.presheaf.obj (op U))) :
    gradedStalkAddEquiv f x
        ((associatedGradedPresentation X f).presheaf.germ U x hx
          ((associatedGradedPresentation X f).ofSections U p))
      = associatedGradedMap (germSequence X f x) (polynomialGerm X f U x hx p) :=
  congrArg (gradedQuotEquiv (germSequence X f x))
    ((associatedGradedPresentation X f).stalkDesc_germ U x hx
      ((associatedGradedPresentation X f).ofSections U p))

/-- The germ at `x` of the associated graded section presented by the monomial `a T^e` is the
class of `a f^e` in degree `|e|`. -/
theorem gradedStalkAddEquiv_germ_monomial (U : Opens X) (x : X) (hx : x ∈ U)
    (e : Fin r →₀ ℕ) (a : X.presheaf.obj (op U)) :
    gradedStalkAddEquiv f x
        ((associatedGradedPresentation X f).presheaf.germ U x hx
          ((associatedGradedPresentation X f).ofSections U (MvPolynomial.monomial e a)))
      = imgTargetLin (germSequence X f x) e (X.presheaf.germ U x hx a) := by
  rw [gradedStalkAddEquiv_germ, polynomialGerm, MvPolynomial.map_monomial, RingHom.comp_apply,
    associatedGradedMap_monomial]

/-- A polynomial presents the zero section of the associated graded sheaf exactly when the
ring-level quasi-regularity map kills its reduction at every point. -/
theorem gradedOfSections_eq_zero_iff (U : Opens X)
    (p : MvPolynomial (Fin r) (X.presheaf.obj (op U))) :
    (associatedGradedPresentation X f).ofSections U p = 0 ↔
      ∀ (x : X) (hx : x ∈ U),
        associatedGradedMap (germSequence X f x) (polynomialGerm X f U x hx p) = 0 := by
  rw [(associatedGradedPresentation X f).ofSections_eq_zero_iff U p]
  refine forall₂_congr fun x hx => ?_
  exact (Ideal.Quotient.eq_zero_iff_mem (I := associatedGradedIdeal (germSequence X f x))
    (a := polynomialGerm X f U x hx p)).trans mem_associatedGradedIdeal

end Presentations

section IdealSheaf

/-- The ideal subsheaf of `O_X` generated by the global sections `fᵢ`. It is the infimum of all
ideal subsheaves containing those sections. -/
noncomputable def generatedIdeal (X : RingedSpace.{u}) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op (⊤ : Opens X))) :
    (structureSheafModule X).Submodule :=
  ⨅ (I : {I : (structureSheafModule X).Submodule //
    ∀ i, f i ∈ I.obj (op (⊤ : Opens X))}), I.1

/-- The ideal of `O_X(U)` consisting of sections whose germ at every point of `U` lies in the ideal
generated by the germs of `f`. -/
noncomputable def germIdealObj (U : Opens X) : Ideal (X.presheaf.obj (op U)) where
  carrier := {s | ∀ (y : X) (hy : y ∈ U),
    X.presheaf.germ U y hy s ∈ Jid (germSequence X f y)}
  zero_mem' y hy := by rw [map_zero]; exact Ideal.zero_mem _
  add_mem' {a b} ha hb y hy := by
    rw [map_add]; exact Ideal.add_mem _ (ha y hy) (hb y hy)
  smul_mem' c a ha y hy := by
    rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ (ha y hy)

/-- A section `s` over `U` lies in `germIdealObj f U` exactly when its germ at every point `y`
of `U` lies in the ideal generated by the germs of `f` at `y`. -/
theorem mem_germIdealObj {U : Opens X} {s : X.presheaf.obj (op U)} :
    s ∈ germIdealObj f U ↔
      ∀ (y : X) (hy : y ∈ U), X.presheaf.germ U y hy s ∈ Jid (germSequence X f y) := Iff.rfl

/-- The ideal subsheaf of `O_X` cut out pointwise by the condition that the germ lies in the ideal
generated by the germs of `f`. -/
noncomputable def germIdeal (X : RingedSpace.{u}) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op (⊤ : Opens X))) :
    (structureSheafModule X).Submodule where
  obj V := germIdealObj f V.unop
  map {V W} i s hs y hy := by
    have h : X.presheaf.germ W.unop y hy (X.presheaf.map i s)
        = X.presheaf.germ V.unop y (i.unop.le hy) s :=
      TopCat.Presheaf.germ_res_apply' X.presheaf i y hy s
    exact h ▸ hs y (i.unop.le hy)
  isSheaf {V} s hsieve y hy := by
    obtain ⟨W, g, hgs, hyW⟩ := (Opens.mem_grothendieckTopology _).mp hsieve y hy
    have h : X.presheaf.germ W y hyW (X.presheaf.map g.op s)
        = X.presheaf.germ V.unop y (g.le hyW) s :=
      TopCat.Presheaf.germ_res_apply X.presheaf g y hyW s
    exact h ▸ hgs y hyW

/-- Each global section `fᵢ` lies in the global sections of `germIdeal X f`. -/
theorem germIdeal_mem_generators :
    ∀ i, f i ∈ (germIdeal X f).obj (op (⊤ : Opens X)) :=
  fun i _ _ => Ideal.subset_span ⟨i, rfl⟩

/-- The ideal subsheaf generated by `f` equals the ideal subsheaf `germIdeal X f` cut out by the
germ condition. -/
theorem generatedIdeal_eq_germIdeal : generatedIdeal X f = germIdeal X f := by
  classical
  refine le_antisymm (iInf_le (fun I : {I : (structureSheafModule X).Submodule //
      ∀ i, f i ∈ I.obj (op (⊤ : Opens X))} => I.1)
      ⟨germIdeal X f, germIdeal_mem_generators f⟩) (le_iInf fun I => ?_)
  · intro V s hs
    refine I.1.isSheaf s ((Opens.mem_grothendieckTopology _).mpr fun x hx => ?_)
    obtain ⟨cc, hcc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp (hs x hx)
    obtain ⟨V₀, hxV₀, b, hb⟩ := exists_nhds_germ_eq (Finset.univ : Finset (Fin r)) x cc
    have hxW₀ : x ∈ V.unop ⊓ V₀ := ⟨hx, hxV₀⟩
    set W₀ : Opens X := V.unop ⊓ V₀
    set dd : X.presheaf.obj (op W₀) :=
      X.presheaf.map (homOfLE (inf_le_left (a := V.unop) (b := V₀))).op s
        - ∑ i, X.presheaf.map (homOfLE (inf_le_right (a := V.unop) (b := V₀))).op (b i)
            * restrictFamily X f W₀ i with hdd
    have hgerm : X.presheaf.germ W₀ x hxW₀ dd = 0 := by
      rw [hdd, map_sub, map_sum, sub_eq_zero,
        TopCat.Presheaf.germ_res_apply X.presheaf
          (homOfLE (inf_le_left (a := V.unop) (b := V₀))) x hxW₀ s,
        ← hcc]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, germ_restrictFamily,
        TopCat.Presheaf.germ_res_apply X.presheaf
          (homOfLE (inf_le_right (a := V.unop) (b := V₀))) x hxW₀ (b i),
        hb i (Finset.mem_univ i)]
    obtain ⟨W, hxW, hWW₀, hdW⟩ := exists_nhds_eq_zero_of_germ_eq_zero W₀ dd x hxW₀ hgerm
    refine ⟨W, homOfLE (le_trans hWW₀ (inf_le_left (a := V.unop) (b := V₀))), ?_, hxW⟩
    have hrel : X.presheaf.map
          (homOfLE (le_trans hWW₀ (inf_le_left (a := V.unop) (b := V₀)))).op s
        = ∑ i, X.presheaf.map
              (homOfLE (le_trans hWW₀ (inf_le_right (a := V.unop) (b := V₀)))).op (b i)
            * restrictFamily X f W i := by
      rw [hdd, map_sub, map_sum, sub_eq_zero] at hdW
      rw [← res_res (inf_le_left (a := V.unop) (b := V₀)) hWW₀ s, hdW]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, res_res, restrictFamily, restrictFamily, res_res]
    show X.presheaf.map _ s ∈ _
    rw [hrel]
    refine Submodule.sum_mem _ fun i _ => ?_
    have hfi : restrictFamily X f W i ∈ I.1.obj (op W) :=
      I.1.toSubmodule.map_mem (homOfLE (le_top (a := W))).op (I.2 i)
    exact Submodule.smul_mem _ _ hfi

/-- **The sections of the ideal sheaf generated by `f`.**  A section of `O_X` over `U` lies in the
ideal subsheaf generated by the global sections `fᵢ` exactly when each of its germs lies in the
ideal generated by the germs of the `fᵢ`. -/
theorem mem_generatedIdeal_iff (U : Opens X) (s : X.presheaf.obj (op U)) :
    s ∈ (generatedIdeal X f).obj (op U) ↔
      ∀ (x : X) (hx : x ∈ U), X.presheaf.germ U x hx s ∈ Jid (germSequence X f x) := by
  rw [generatedIdeal_eq_germIdeal]
  exact mem_germIdealObj f

end IdealSheaf

section Data

/-- Local presentations of the polynomial and associated graded ring sheaves of Stacks tag 063B,
and the canonical morphism between them. The presentation maps and their compatibility with germs
specify the topology of both sheaves, in addition to their stalks. In particular, the target is the
sheaf quotient of the polynomial source by the kernel of the canonical graded map, not an arbitrary
sheaf with the same stalk isomorphism types. -/
structure QuasiRegularMapData (X : RingedSpace.{u}) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op (⊤ : Opens X))) where
  /-- Sections of the generated ideal sheaf are characterized by membership of their germs
  in the ideals generated by the germs of `f`. -/
  ideal_sections (U : Opens X) (s : X.presheaf.obj (op U)) :
    s ∈ (generatedIdeal X f).obj (op U) ↔
      ∀ (x : X) (hx : x ∈ U), X.presheaf.germ U x hx s ∈ Jid (germSequence X f x)
  /-- The polynomial source sheaf `(O_X / J)[T₁, ..., Tᵣ]`. -/
  polynomialSheaf : TopCat.Sheaf CommRingCat.{u} X
  /-- The associated graded target sheaf `⨁ d, J^d / J^(d+1)`. -/
  associatedGradedSheaf : TopCat.Sheaf CommRingCat.{u} X
  /-- The local polynomial presentation of the source, reducing coefficients modulo `J`. -/
  polynomialOfSections (U : Opens X) :
    MvPolynomial (Fin r) (X.presheaf.obj (op U)) →+*
      polynomialSheaf.presheaf.obj (op U)
  /-- The local polynomial presentations commute with restriction. -/
  polynomialOfSections_naturality {U V : Opens X} (i : U ⟶ V)
      (p : MvPolynomial (Fin r) (X.presheaf.obj (op V))) :
    polynomialSheaf.presheaf.map i.op (polynomialOfSections V p) =
      polynomialOfSections U (MvPolynomial.map (X.presheaf.map i.op).hom p)
  /-- Every source section is locally represented by a polynomial with coefficients in
  the structure sheaf. -/
  polynomial_locallySurjective (U : Opens X) (s : polynomialSheaf.presheaf.obj (op U))
      (x : X) (hx : x ∈ U) :
    ∃ (V : Opens X) (_ : x ∈ V) (i : V ⟶ U)
      (p : MvPolynomial (Fin r) (X.presheaf.obj (op V))),
      polynomialOfSections V p = polynomialSheaf.presheaf.map i.op s
  /-- The canonical morphism from the polynomial sheaf to the associated graded sheaf. -/
  hom : polynomialSheaf ⟶ associatedGradedSheaf
  /-- Every associated graded section is locally a finite sum of classes `a f^e` in
  degree `|e|`. This is the local surjectivity of the target's polynomial presentation. -/
  associatedGraded_locallySurjective (U : Opens X)
      (s : associatedGradedSheaf.presheaf.obj (op U)) (x : X) (hx : x ∈ U) :
    ∃ (V : Opens X) (_ : x ∈ V) (i : V ⟶ U)
      (p : MvPolynomial (Fin r) (X.presheaf.obj (op V))),
      hom.hom.app (op V) (polynomialOfSections V p) =
        associatedGradedSheaf.presheaf.map i.op s
  /-- The canonical identification of a source stalk with the polynomial algebra over
  `O_{X,x} / (f₁, ..., fᵣ)`. -/
  polynomialStalkIso (x : X) :
    polynomialSheaf.presheaf.stalk x ≅
      CommRingCat.of (MvPolynomial (Fin r) (qrRbar (germSequence X f x)))
  /-- The source stalk identification is the one induced by the local polynomial
  presentation, rather than an arbitrary ring isomorphism. -/
  polynomialStalkIso_germ (U : Opens X) (x : X) (hx : x ∈ U)
      (p : MvPolynomial (Fin r) (X.presheaf.obj (op U))) :
    (polynomialStalkIso x).hom
        (polynomialSheaf.presheaf.germ U x hx (polynomialOfSections U p)) =
      polynomialGerm X f U x hx p
  /-- The relations in the source presentation are exactly coefficientwise membership
  in the generated ideal sheaf. -/
  polynomialOfSections_eq_zero_iff (U : Opens X)
      (p : MvPolynomial (Fin r) (X.presheaf.obj (op U))) :
    polynomialOfSections U p = 0 ↔
      ∀ (x : X) (hx : x ∈ U), polynomialGerm X f U x hx p = 0
  /-- The canonical identification of a target stalk with
  `⨁ d, J_x^d / J_x^(d+1)`. -/
  associatedGradedStalkIso (x : X) :
    AddCommGrpCat.of (associatedGradedSheaf.presheaf.stalk x) ≅
      AddCommGrpCat.of (Target (X.presheaf.stalk x) (germSequence X f x))
  /-- Under the canonical stalk identifications, the stalk of `hom` is the usual
  polynomial-to-associated-graded map. -/
  stalk_map (x : X) (p : polynomialSheaf.presheaf.stalk x) :
    (associatedGradedStalkIso x).hom
        ((TopCat.Presheaf.stalkFunctor CommRingCat.{u} x).map hom.hom p) =
      associatedGradedMap (germSequence X f x) ((polynomialStalkIso x).hom p)
  /-- The relations in the target presentation are exactly the associated graded
  relations: the homogeneous degree-`d` evaluation vanishes modulo `J^(d+1)`. -/
  associatedGradedOfSections_eq_zero_iff (U : Opens X)
      (p : MvPolynomial (Fin r) (X.presheaf.obj (op U))) :
    hom.hom.app (op U) (polynomialOfSections U p) = 0 ↔
      ∀ (x : X) (hx : x ∈ U),
        associatedGradedMap (germSequence X f x) (polynomialGerm X f U x hx p) = 0
  /-- The local target presentation sends `a T^e` to the class of `a f^e` in degree `|e|`.
  This also specifies the canonical quotient relations in the target. -/
  monomial_rule (U : Opens X) (x : X) (hx : x ∈ U) (e : Fin r →₀ ℕ)
      (a : X.presheaf.obj (op U)) :
    (associatedGradedStalkIso x).hom
        (associatedGradedSheaf.presheaf.germ U x hx
          (hom.hom.app (op U) (polynomialOfSections U (MvPolynomial.monomial e a)))) =
      imgTargetLin (germSequence X f x) e (X.presheaf.germ U x hx a)
  /-- On every stalk, the variable `Tᵢ` maps to the class of the germ of `fᵢ` modulo
  the square of the generated ideal, in degree one. -/
  generator_rule (x : X) (i : Fin r) :
    (associatedGradedStalkIso x).hom
      ((TopCat.Presheaf.stalkFunctor CommRingCat.{u} x).map hom.hom
        ((polynomialStalkIso x).inv (MvPolynomial.X i))) =
      imgTargetLin (germSequence X f x) (Finsupp.single i 1) 1

/-- The canonical morphism of sheaves `(O_X / J)[T₁, ..., Tᵣ] ⟶ ⨁ d, J^d / J^(d+1)` associated to
global sections `f₁, ..., fᵣ`, sending `Tᵢ` to `fᵢ mod J²`. -/
@[stacks 063B]
noncomputable def quasiRegularMap (X : RingedSpace.{u}) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op (⊤ : Opens X))) : QuasiRegularMapData X f where
  ideal_sections U s := mem_generatedIdeal_iff f U s
  polynomialSheaf := (polynomialPresentation X f).sheaf
  associatedGradedSheaf := (associatedGradedPresentation X f).sheaf
  polynomialOfSections U := (polynomialPresentation X f).ofSections U
  polynomialOfSections_naturality i p :=
    (polynomialPresentation X f).restrictHom_ofSections i.le p
  polynomial_locallySurjective U s x hx := by
    obtain ⟨V, hxV, hVU, p, hp⟩ := (polynomialPresentation X f).exists_ofSections U s x hx
    exact ⟨V, hxV, homOfLE hVU, p, hp⟩
  hom := (gradedProjection X f).sheafMap
  associatedGraded_locallySurjective U s x hx := by
    obtain ⟨V, hxV, hVU, p, hp⟩ :=
      (associatedGradedPresentation X f).exists_ofSections U s x hx
    exact ⟨V, hxV, homOfLE hVU, p,
      ((gradedProjection X f).sheafMap_hom_app_ofSections V p).trans hp⟩
  polynomialStalkIso x := (polynomialPresentation X f).stalkIso x
  polynomialStalkIso_germ U x hx p :=
    (polynomialPresentation X f).stalkIso_hom_germ U x hx _
  polynomialOfSections_eq_zero_iff U p :=
    (polynomialPresentation X f).ofSections_eq_zero_iff U p
  associatedGradedStalkIso x := AddEquiv.toAddCommGrpIso (gradedStalkAddEquiv f x)
  stalk_map x p := gradedStalkAddEquiv_stalkFunctor f x p
  associatedGradedOfSections_eq_zero_iff U p := by
    have h1 := (gradedProjection X f).sheafMap_hom_app_ofSections U p
    exact ⟨fun h => (gradedOfSections_eq_zero_iff f U p).mp (h1.symm.trans h),
      fun h => h1.trans ((gradedOfSections_eq_zero_iff f U p).mpr h)⟩
  monomial_rule U x hx e a :=
    (congrArg (fun t : (associatedGradedPresentation X f).presheaf.obj (op U) =>
        gradedStalkAddEquiv f x
          ((associatedGradedPresentation X f).presheaf.germ U x hx t))
      ((gradedProjection X f).sheafMap_hom_app_ofSections U
        (MvPolynomial.monomial e a))).trans
      (gradedStalkAddEquiv_germ_monomial f U x hx e a)
  generator_rule x i :=
    (gradedStalkAddEquiv_stalkFunctor f x
        (((polynomialPresentation X f).stalkIso x).inv (MvPolynomial.X i))).trans (by
      rw [(polynomialPresentation X f).stalkIso_hom_inv_apply x (MvPolynomial.X i),
        associatedGradedMap_X])

end Data

end Stacks.AlgebraicGeometry.QuasiRegular
