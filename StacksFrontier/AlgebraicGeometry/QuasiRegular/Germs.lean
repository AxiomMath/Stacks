module

public import Mathlib.Geometry.RingedSpace.Basic
public import Mathlib.Geometry.RingedSpace.Stalks
public import StacksFrontier.AlgebraicGeometry.QuasiRegular.Algebra

/-!
# Germs of a finite family of global sections, and openness of its relations

Let `X` be a ringed space and let `f₁, ..., f_r` be global sections of its structure sheaf.  For a
point `x` write `J_x = (f₁, ..., f_r) ⊆ O_{X,x}` for the ideal generated by the germs of the `f_i`.

If the germ at `x` of a section `a` over `U` lies in `J_x^n`, then the germ of `a` at `y` lies in
`J_y^n` for all `y` in some neighbourhood of `x`. In other words, the locus where a section lies in
a given power of the ideal generated by the `f_i` is open. The same holds for any finite family of
such conditions.

## Main definitions

* `germSequence X f x`: the germs at `x` of the family `f`.
* `restrictFamily X f U`: the restrictions of the family `f` to an open `U`.

## Main results

* `exists_nhds_germ_eq`: a finite family of elements of a stalk is simultaneously represented by
  sections over a single neighbourhood.
* `exists_nhds_germ_mem_Jid_pow`: openness of the locus `{y | germ_y a ∈ J_y^n}`.
* `exists_nhds_forall_germ_mem_Jid_pow`: the same for a finite family of conditions.
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.RingTheory.QuasiRegular

universe u

namespace Stacks.AlgebraicGeometry.QuasiRegular

/-- The germs at `x` of a finite family of global sections of the structure sheaf. -/
noncomputable def germSequence (X : RingedSpace.{u}) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op (⊤ : Opens X))) (x : X) :
    Fin r → X.presheaf.stalk x :=
  fun i ↦ X.presheaf.germ (⊤ : Opens X) x trivial (f i)

/-- The restrictions to an open `U` of a finite family of global sections. -/
noncomputable def restrictFamily (X : RingedSpace.{u}) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op (⊤ : Opens X))) (U : Opens X) :
    Fin r → X.presheaf.obj (op U) :=
  fun i ↦ X.presheaf.map (homOfLE (le_top (a := U))).op (f i)

variable {X : RingedSpace.{u}} {r : ℕ} (f : Fin r → X.presheaf.obj (op (⊤ : Opens X)))

/-- The germ at `x ∈ U` of the restriction of `f i` to `U` is the germ of `f i` at `x`. -/
@[simp]
theorem germ_restrictFamily (U : Opens X) (x : X) (hx : x ∈ U) (i : Fin r) :
    X.presheaf.germ U x hx (restrictFamily X f U i) = germSequence X f x i := by
  rw [restrictFamily, TopCat.Presheaf.germ_res_apply]
  rfl

/-- The germ at `x ∈ U` of the monomial with exponents `e` in the restrictions of the `f i` to `U`
is the monomial with exponents `e` in the germs of the `f i` at `x`. -/
@[simp]
theorem germ_fpow (U : Opens X) (x : X) (hx : x ∈ U) (e : Fin r →₀ ℕ) :
    X.presheaf.germ U x hx (fpow (restrictFamily X f U) e) = fpow (germSequence X f x) e := by
  rw [fpow, fpow, map_prod]
  exact Finset.prod_congr rfl fun i _ => by rw [map_pow, germ_restrictFamily]

/-- A finite family of elements of the stalk at `x` is represented by a family of sections over a
single neighbourhood of `x`. -/
theorem exists_nhds_germ_eq {ι : Type*} (t : Finset ι) (x : X)
    (g : ι → X.presheaf.stalk x) :
    ∃ (V : Opens X) (hxV : x ∈ V) (b : ι → X.presheaf.obj (op V)),
      ∀ i ∈ t, X.presheaf.germ V x hxV (b i) = g i := by
  classical
  induction t using Finset.induction with
  | empty => exact ⟨⊤, trivial, fun _ => 0, fun i hi => absurd hi (Finset.notMem_empty i)⟩
  | insert i t hit ih =>
    obtain ⟨V, hxV, b, hb⟩ := ih
    obtain ⟨V', hxV', s', hs'⟩ := X.presheaf.exists_germ_eq (g i)
    have hxVV' : x ∈ V ⊓ V' := ⟨hxV, hxV'⟩
    refine ⟨V ⊓ V', hxVV',
      Function.update (fun j => X.presheaf.map (homOfLE (inf_le_left (a := V) (b := V'))).op (b j))
        i (X.presheaf.map (homOfLE (inf_le_right (a := V) (b := V'))).op s'), fun j hj => ?_⟩
    by_cases hji : j = i
    · subst hji
      rw [Function.update_self, TopCat.Presheaf.germ_res_apply]
      exact hs'
    · rw [Function.update_of_ne hji, TopCat.Presheaf.germ_res_apply]
      exact hb j ((Finset.mem_insert.mp hj).resolve_left hji)

/-- If a section vanishes at `x` as a germ, it vanishes on a neighbourhood of `x`. -/
theorem exists_nhds_eq_zero_of_germ_eq_zero (U : Opens X) (a : X.presheaf.obj (op U))
    (x : X) (hx : x ∈ U) (h : X.presheaf.germ U x hx a = 0) :
    ∃ (V : Opens X) (_ : x ∈ V) (hVU : V ≤ U),
      X.presheaf.map (homOfLE hVU).op a = 0 := by
  have h' : X.presheaf.germ U x hx a = X.presheaf.germ U x hx 0 := by rw [h, map_zero]
  obtain ⟨W, hxW, iU, iV, he⟩ := X.presheaf.germ_eq x hx hx a 0 h'
  refine ⟨W, hxW, iU.le, ?_⟩
  rw [show (homOfLE iU.le : W ⟶ U) = iU from rfl, he, map_zero]

/-- **Openness of the locus where a section lies in a power of the ideal generated by `f`.**
If the germ of `a` at `x` lies in `J_x ^ n`, then the germ of `a` at `y` lies in `J_y ^ n` for all
`y` in a neighbourhood of `x`. -/
theorem exists_nhds_germ_mem_Jid_pow (U : Opens X) (a : X.presheaf.obj (op U)) (n : ℕ)
    (x : X) (hx : x ∈ U)
    (hmem : X.presheaf.germ U x hx a ∈ (Jid (germSequence X f x)) ^ n) :
    ∃ (V : Opens X) (_ : x ∈ V) (hVU : V ≤ U),
      ∀ (y : X) (hy : y ∈ V),
        X.presheaf.germ U y (hVU hy) a ∈ (Jid (germSequence X f y)) ^ n := by
  classical
  rw [Jid_pow_eq_span] at hmem
  obtain ⟨t, ht, hmem⟩ := Submodule.mem_span_finite_of_mem_span hmem
  obtain ⟨cf, -, hcf⟩ := Submodule.mem_span_finset.mp hmem
  choose! exps hexpdeg hexpeq using fun z (hz : z ∈ t) => ht hz
  obtain ⟨V₀, hxV₀, b, hb⟩ := exists_nhds_germ_eq t x cf
  set W : Opens X := U ⊓ V₀
  have hxW : x ∈ W := ⟨hx, hxV₀⟩
  set aW : X.presheaf.obj (op W) :=
    X.presheaf.map (homOfLE (inf_le_left (a := U) (b := V₀))).op a with haW
  set bW : t → X.presheaf.obj (op W) := fun z =>
    X.presheaf.map (homOfLE (inf_le_right (a := U) (b := V₀))).op (b z) with hbW
  set d : X.presheaf.obj (op W) :=
    aW - ∑ z ∈ t.attach, bW z * fpow (restrictFamily X f W) (exps z) with hd
  have h1 : ∀ (y : X) (hy : y ∈ W), X.presheaf.germ W y hy aW
      = X.presheaf.germ U y hy.1 a := fun y hy => by
    rw [haW, TopCat.Presheaf.germ_res_apply]
  have hgermd : X.presheaf.germ W x hxW d = 0 := by
    rw [hd, map_sub, map_sum]
    have h2 : ∀ z ∈ t.attach, X.presheaf.germ W x hxW
        (bW z * fpow (restrictFamily X f W) (exps z)) = cf z * (z : X.presheaf.stalk x) := by
      intro z _
      rw [map_mul, germ_fpow, hbW, TopCat.Presheaf.germ_res_apply, hb z z.2,
        ← hexpeq z z.2]
    rw [h1 x hxW, Finset.sum_congr rfl h2, ← hcf, Finset.sum_attach t (fun z => cf z * z)]
    simp
  obtain ⟨V, hxV, hVW, hdV⟩ := exists_nhds_eq_zero_of_germ_eq_zero W d x hxW hgermd
  refine ⟨V, hxV, le_trans hVW inf_le_left, fun y hy => ?_⟩
  have key : X.presheaf.germ W y (hVW hy) d = 0 := by
    rw [← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hVW) y hy, hdV, map_zero]
  rw [hd, map_sub, map_sum, sub_eq_zero] at key
  rw [h1 y (hVW hy)] at key
  rw [key, Jid_pow_eq_span]
  refine Submodule.sum_mem _ fun z _ => ?_
  rw [map_mul, germ_fpow]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨exps z, hexpdeg z z.2, rfl⟩)

/-- The simultaneous version of `exists_nhds_germ_mem_Jid_pow` for a finite family of sections and
exponents. -/
theorem exists_nhds_forall_germ_mem_Jid_pow {ι : Type*} (t : Finset ι) (U : Opens X)
    (a : ι → X.presheaf.obj (op U)) (n : ι → ℕ) (x : X) (hx : x ∈ U)
    (hmem : ∀ i ∈ t, X.presheaf.germ U x hx (a i) ∈ (Jid (germSequence X f x)) ^ (n i)) :
    ∃ (V : Opens X) (_ : x ∈ V) (hVU : V ≤ U),
      ∀ i ∈ t, ∀ (y : X) (hy : y ∈ V),
        X.presheaf.germ U y (hVU hy) (a i) ∈ (Jid (germSequence X f y)) ^ (n i) := by
  classical
  induction t using Finset.induction with
  | empty => exact ⟨U, hx, le_rfl, fun i hi => absurd hi (Finset.notMem_empty i)⟩
  | insert i t hit ih =>
    obtain ⟨V₁, hxV₁, hV₁, h₁⟩ := ih fun j hj => hmem j (Finset.mem_insert_of_mem hj)
    obtain ⟨V₂, hxV₂, hV₂, h₂⟩ := exists_nhds_germ_mem_Jid_pow f U (a i) (n i) x hx
      (hmem i (Finset.mem_insert_self i t))
    have hxV : x ∈ V₁ ⊓ V₂ := ⟨hxV₁, hxV₂⟩
    refine ⟨V₁ ⊓ V₂, hxV, le_trans inf_le_left hV₁, fun j hj y hy => ?_⟩
    rcases Finset.mem_insert.mp hj with rfl | hj
    · exact h₂ y hy.2
    · exact h₁ j hj y hy.1

end Stacks.AlgebraicGeometry.QuasiRegular
