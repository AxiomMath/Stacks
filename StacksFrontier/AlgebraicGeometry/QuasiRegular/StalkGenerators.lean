module

public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Basic
public import StacksFrontier.AlgebraicGeometry.RingedSpace.IdealSheafGenerators
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FiniteTypeLocallySurjective
public import StacksCore.RingTheory.Nakayama
public import StacksCore.Tactic.StacksAttribute

/-!
# Lifting generators of an ideal sheaf from a stalk

Let `X` be a locally ringed space and let `J ⊆ O_X` be a sheaf of ideals which near a point `x`
is generated by finitely many sections.  Sections `f₁, …, f_r` of `J` over a neighbourhood of
`x` whose classes generate `J_x / J_x²` already generate the stalk `J_x`, by Nakayama, and then
generate `J` on a smaller neighbourhood of `x`.

## Main results

* `stalkIdeal_eq_jid_of_isGeneratedByOn`: on an open set where a finite family generates the
  ideal sheaf, it generates every stalk.
* `isGeneratedByOn_of_forall_stalkIdeal_eq`: conversely, a family generating every stalk over an
  open set generates the ideal sheaf there.
* `stalkIdeal_eq_jid_of_le_sup_sq`: **Nakayama for the stalk of an ideal sheaf**, at a point
  where the stalk is a proper ideal.
* `exists_isGeneratedByOn_of_stalkIdeal_eq`: generators of a single stalk generate the ideal
  sheaf on a neighbourhood.
* `exists_isGeneratedByOn_of_le_sup_sq`: the two combined.
* `exists_isGeneratedByOn_of_isFiniteType`: a sheaf of ideals of finite type is generated near
  every point by finitely many sections.
* `exists_isGeneratedByOn_of_isFiniteType_of_le_sup_sq`: **the Nakayama and shrinking step in the
  proof of Stacks tag 063H**, with the finite-type hypothesis in the form the tag states it.

## References

* [Stacks Project, Lemma 31.20.5 (Tag 063H)](https://stacks.math.columbia.edu/tag/063H)
* [Stacks Project, Lemma 10.20.1 (Tag 00DV)](https://stacks.math.columbia.edu/tag/00DV)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.RingedSpace

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

section Vanishing

variable {X : RingedSpace.{u}}

/-- Finitely many sections whose germs at `x` all vanish restrict to zero on one common
neighbourhood of `x`. -/
theorem exists_nhds_forall_restrict_eq_zero {V : Opens X} (x : X) (hx : x ∈ V)
    {ι : Type*} (t : Finset ι) (d : ι → X.presheaf.obj (op V))
    (h : ∀ i ∈ t, X.presheaf.germ V x hx (d i) = 0) :
    ∃ (W : Opens X) (_ : x ∈ W) (hWV : W ≤ V),
      ∀ i ∈ t, X.presheaf.map (homOfLE hWV).op (d i) = 0 := by
  classical
  induction t using Finset.induction with
  | empty => exact ⟨V, hx, le_rfl, fun i hi => absurd hi (Finset.notMem_empty i)⟩
  | insert i t hit ih =>
    obtain ⟨W, hxW, hWV, hW⟩ := ih fun j hj => h j (Finset.mem_insert_of_mem hj)
    obtain ⟨W', hxW', hW'V, hW'⟩ :=
      Stacks.AlgebraicGeometry.QuasiRegular.exists_nhds_eq_zero_of_germ_eq_zero V (d i) x hx
        (h i (Finset.mem_insert_self i t))
    refine ⟨W ⊓ W', ⟨hxW, hxW'⟩, le_trans inf_le_left hWV, fun j hj => ?_⟩
    rcases Finset.mem_insert.mp hj with rfl | hj'
    · rw [← Stacks.AlgebraicGeometry.QuasiRegular.res_res hW'V
        (inf_le_right : W ⊓ W' ≤ W') (d j), hW', map_zero]
    · rw [← Stacks.AlgebraicGeometry.QuasiRegular.res_res hWV
        (inf_le_left : W ⊓ W' ≤ W) (d j), hW j hj', map_zero]

end Vanishing

section Stalkwise

variable {X : LocallyRingedSpace.{u}}
  (J : (Stacks.RingedSpace.structureSheafModule X.toRingedSpace).Submodule)

/-- A finite family of sections of `O_X` lying in `J` has all its germs in the stalk of `J`. -/
theorem jid_germFamily_le_stalkIdeal {U : Opens X} {r : ℕ}
    (f : Fin r → X.presheaf.obj (op U)) (hf : ∀ i, f i ∈ J.obj (op U))
    (y : X) (hy : y ∈ U) :
    Jid (germFamily X.toRingedSpace U f y hy) ≤ stalkIdeal J y := by
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨i, rfl⟩
  exact (mem_stalkIdeal_iff J).mpr ⟨U, hy, f i, hf i, rfl⟩

/-- A generator of the ideal sheaf over an open set is a section of the ideal sheaf. -/
private theorem apply_mem_of_isGeneratedByOn {W : Opens X} {s : ℕ}
    (g : Fin s → X.presheaf.obj (op W)) (hg : IsGeneratedByOn X.toRingedSpace J W g) (j : Fin s) :
    g j ∈ J.obj (op W) := by
  rw [hg W le_rfl]; exact mem_generatedIdealOn X.toRingedSpace W g j

/-- The germ of a product with a restricted section is the product of the germs. -/
private theorem germ_mul_map_restrict {U V : Opens X} (h : V ≤ U) (a : X.presheaf.obj (op V))
    (f : X.presheaf.obj (op U)) (y : X) (hy : y ∈ V) :
    X.presheaf.germ V y hy (a * X.presheaf.map (homOfLE h).op f)
      = X.presheaf.germ V y hy a * X.presheaf.germ U y (h hy) f := by
  rw [map_mul, TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE h) y hy f]

/-- **On an open set where a finite family generates the ideal sheaf, it generates every
stalk.** -/
theorem stalkIdeal_eq_jid_of_isGeneratedByOn {W : Opens X} {s : ℕ}
    (g : Fin s → X.presheaf.obj (op W)) (hg : IsGeneratedByOn X.toRingedSpace J W g)
    (y : X) (hy : y ∈ W) :
    stalkIdeal J y = Jid (germFamily X.toRingedSpace W g y hy) := by
  refine le_antisymm ?_
    (jid_germFamily_le_stalkIdeal J g (apply_mem_of_isGeneratedByOn J g hg) y hy)
  rintro a ha
  obtain ⟨V, hyV, t, ht, rfl⟩ := (mem_stalkIdeal_iff J).mp ha
  have hyVW : y ∈ V ⊓ W := ⟨hyV, hy⟩
  have ht' : X.presheaf.map (homOfLE (inf_le_left (a := V) (b := W))).op t
      ∈ (generatedIdealOn X.toRingedSpace W g).obj (op (V ⊓ W)) := by
    rw [← hg (V ⊓ W) inf_le_right]
    exact restrict_mem J _ ht
  have hgerm := (mem_generatedIdealOn_iff W g (V ⊓ W) inf_le_right _).mp ht' y hyVW
  rwa [TopCat.Presheaf.germ_res_apply X.presheaf
    (homOfLE (inf_le_left (a := V) (b := W))) y hyVW t] at hgerm

/-- **A family generating every stalk over an open set generates the ideal sheaf there.** -/
theorem isGeneratedByOn_of_forall_stalkIdeal_eq {V : Opens X} {r : ℕ}
    (f : Fin r → X.presheaf.obj (op V))
    (h : ∀ (y : X) (hy : y ∈ V),
      stalkIdeal J y = Jid (germFamily X.toRingedSpace V f y hy)) :
    IsGeneratedByOn X.toRingedSpace J V f := by
  intro V' hV'
  refine le_antisymm (fun t ht => ?_) (fun t ht => ?_)
  · refine (mem_generatedIdealOn_iff V f V' hV' t).mpr fun y hy => ?_
    rw [← h y (hV' hy)]
    exact (mem_stalkIdeal_iff J).mpr ⟨V', hy, t, ht, rfl⟩
  · refine Stacks.RingedSpace.mem_of_germ_mem J t fun y hy => ?_
    rw [h y (hV' hy)]
    exact (mem_generatedIdealOn_iff V f V' hV' t).mp ht y hy

end Stalkwise

section Nakayama

variable {X : LocallyRingedSpace.{u}}
  (J : (Stacks.RingedSpace.structureSheafModule X.toRingedSpace).Submodule)

/-- **Nakayama's lemma for the stalk of an ideal sheaf.**  At a point where the stalk `J_x` is a
proper finitely generated ideal, elements of `J_x` generating it modulo `J_x²` generate it. -/
theorem stalkIdeal_eq_jid_of_le_sup_sq {x : X} (hne : stalkIdeal J x ≠ ⊤)
    (hfg : (stalkIdeal J x).FG) {r : ℕ} (v : Fin r → X.presheaf.stalk x)
    (hv : ∀ i, v i ∈ stalkIdeal J x)
    (hle : stalkIdeal J x ≤ Jid v ⊔ stalkIdeal J x ^ 2) :
    stalkIdeal J x = Jid v := by
  refine le_antisymm ?_ (Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hv i))
  refine Submodule.le_of_le_smul_of_le_jacobson_bot (I := stalkIdeal J x) hfg ?_ ?_
  · rw [IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal (X.presheaf.stalk x)) bot_ne_top]
    exact IsLocalRing.le_maximalIdeal hne
  · refine hle.trans (sup_le_sup_left (le_of_eq ?_) _)
    rw [sq, ← Ideal.smul_eq_mul]

end Nakayama

section Shrinking

variable {X : LocallyRingedSpace.{u}}
  (J : (Stacks.RingedSpace.structureSheafModule X.toRingedSpace).Submodule)

/-- **Generators of one stalk generate the ideal sheaf on a neighbourhood.**  If `J` is
generated on `W` by finitely many sections and sections `f₁, …, f_r` of `J` over `U` generate
the stalk `J_x`, then they generate `J` on a neighbourhood of `x`. -/
theorem exists_isGeneratedByOn_of_stalkIdeal_eq {x : X} {W : Opens X} (hxW : x ∈ W) {s : ℕ}
    (g : Fin s → X.presheaf.obj (op W)) (hg : IsGeneratedByOn X.toRingedSpace J W g)
    {U : Opens X} (hxU : x ∈ U) {r : ℕ} (f : Fin r → X.presheaf.obj (op U))
    (hf : ∀ i, f i ∈ J.obj (op U))
    (hx : stalkIdeal J x = Jid (germFamily X.toRingedSpace U f x hxU)) :
    ∃ (V : Opens X) (_ : x ∈ V) (hVU : V ≤ U),
      IsGeneratedByOn X.toRingedSpace J V
        (fun i => X.presheaf.map (homOfLE hVU).op (f i)) := by
  classical
  -- Write each germ of `g` at `x` as a combination of the germs of `f`.
  have hcomb : ∀ j, ∃ c : Fin r → X.presheaf.stalk x,
      ∑ i, c i • germFamily X.toRingedSpace U f x hxU i
        = X.presheaf.germ W x hxW (g j) := fun j => by
    have hmem : X.presheaf.germ W x hxW (g j) ∈ stalkIdeal J x :=
      (mem_stalkIdeal_iff J).mpr ⟨W, hxW, g j, apply_mem_of_isGeneratedByOn J g hg j, rfl⟩
    rw [hx] at hmem
    exact Ideal.mem_span_range_iff_exists_fun.mp hmem
  choose c hc using hcomb
  -- Represent the coefficients by sections on a common neighbourhood.
  obtain ⟨U₁, hxU₁, σ, hσ⟩ :=
    exists_common_germ x (fun p : Fin s × Fin r => c p.1 p.2) Finset.univ
  set V₀ : Opens X := U ⊓ W ⊓ U₁ with hV₀
  have hxV₀ : x ∈ V₀ := ⟨⟨hxU, hxW⟩, hxU₁⟩
  have hV₀U : V₀ ≤ U := le_trans inf_le_left inf_le_left
  have hV₀W : V₀ ≤ W := le_trans inf_le_left inf_le_right
  have hV₀U₁ : V₀ ≤ U₁ := inf_le_right
  set a : Fin s → Fin r → X.presheaf.obj (op V₀) :=
    fun j i => X.presheaf.map (homOfLE hV₀U₁).op (σ (j, i)) with ha
  set d : Fin s → X.presheaf.obj (op V₀) :=
    fun j => X.presheaf.map (homOfLE hV₀W).op (g j)
      - ∑ i, a j i * X.presheaf.map (homOfLE hV₀U).op (f i) with hd
  have hgerma : ∀ j i, X.presheaf.germ V₀ x hxV₀ (a j i) = c j i := fun j i => by
    rw [ha, TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hV₀U₁) x hxV₀]
    exact hσ (j, i) (Finset.mem_univ _)
  have hdzero : ∀ j, X.presheaf.germ V₀ x hxV₀ (d j) = 0 := fun j => by
    rw [hd, map_sub, map_sum, sub_eq_zero,
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hV₀W) x hxV₀ (g j), ← hc j]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [germ_mul_map_restrict, hgerma j i]
    rfl
  obtain ⟨V, hxV, hVV₀, hV⟩ :=
    exists_nhds_forall_restrict_eq_zero x hxV₀ (Finset.univ : Finset (Fin s)) d
      fun j _ => hdzero j
  have hVU : V ≤ U := le_trans hVV₀ hV₀U
  have hVW : V ≤ W := le_trans hVV₀ hV₀W
  -- On `V` every `g j` is an `O_X`-combination of the `f i`.
  have hrel : ∀ j, X.presheaf.map (homOfLE hVW).op (g j)
      = ∑ i, X.presheaf.map (homOfLE hVV₀).op (a j i)
          * X.presheaf.map (homOfLE hVU).op (f i) := fun j => by
    have h0 := hV j (Finset.mem_univ j)
    rw [hd, map_sub, map_sum, sub_eq_zero] at h0
    rw [← Stacks.AlgebraicGeometry.QuasiRegular.res_res hV₀W hVV₀ (g j), h0]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, Stacks.AlgebraicGeometry.QuasiRegular.res_res hV₀U hVV₀ (f i)]
  refine ⟨V, hxV, hVU, isGeneratedByOn_of_forall_stalkIdeal_eq J _ fun y hy => ?_⟩
  have hfam : germFamily X.toRingedSpace V
      (fun i => X.presheaf.map (homOfLE hVU).op (f i)) y hy
      = germFamily X.toRingedSpace U f y (hVU hy) :=
    germFamily_res U V hVU f y hy
  rw [hfam, stalkIdeal_eq_jid_of_isGeneratedByOn J g hg y (hVW hy)]
  refine le_antisymm (Ideal.span_le.mpr ?_) ?_
  · rintro _ ⟨j, rfl⟩
    have hgy : germFamily X.toRingedSpace W g y (hVW hy) j
        = ∑ i, X.presheaf.germ V y hy (X.presheaf.map (homOfLE hVV₀).op (a j i))
            * germFamily X.toRingedSpace U f y (hVU hy) i := by
      have := congrArg (X.presheaf.germ V y hy) (hrel j)
      rw [map_sum, TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hVW) y hy (g j)] at this
      refine this.trans (Finset.sum_congr rfl fun i _ => ?_)
      rw [germ_mul_map_restrict]
      rfl
    rw [hgy]
    exact Ideal.sum_mem _ fun i _ =>
      Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    rw [← stalkIdeal_eq_jid_of_isGeneratedByOn J g hg y (hVW hy)]
    exact jid_germFamily_le_stalkIdeal J f hf y (hVU hy) (Ideal.subset_span ⟨i, rfl⟩)

/-- **Nakayama and shrinking, for an ideal sheaf generated near `x` by finitely many sections.**
Sections `f₁, …, f_r` of `J` over a neighbourhood `U` of a point `x` of the support of `O_X / J`
whose germs generate `J_x` modulo `J_x²` generate `J` on a neighbourhood of `x`. -/
theorem exists_isGeneratedByOn_of_le_sup_sq {x : X} (hne : stalkIdeal J x ≠ ⊤)
    {W : Opens X} (hxW : x ∈ W) {s : ℕ} (g : Fin s → X.presheaf.obj (op W))
    (hg : IsGeneratedByOn X.toRingedSpace J W g)
    {U : Opens X} (hxU : x ∈ U) {r : ℕ} (f : Fin r → X.presheaf.obj (op U))
    (hf : ∀ i, f i ∈ J.obj (op U))
    (hle : stalkIdeal J x
      ≤ Jid (germFamily X.toRingedSpace U f x hxU) ⊔ stalkIdeal J x ^ 2) :
    ∃ (V : Opens X) (_ : x ∈ V) (hVU : V ≤ U),
      IsGeneratedByOn X.toRingedSpace J V
        (fun i => X.presheaf.map (homOfLE hVU).op (f i)) := by
  have hfg : (stalkIdeal J x).FG := by
    rw [stalkIdeal_eq_jid_of_isGeneratedByOn J g hg x hxW]
    exact Submodule.fg_span (Set.finite_range _)
  exact exists_isGeneratedByOn_of_stalkIdeal_eq J hxW g hg hxU f hf
    (stalkIdeal_eq_jid_of_le_sup_sq J hne hfg _
      (fun i => jid_germFamily_le_stalkIdeal J f hf x hxU (Ideal.subset_span ⟨i, rfl⟩)) hle)

end Shrinking

section FiniteType

variable {X : LocallyRingedSpace.{u}}
  (J : (Stacks.RingedSpace.structureSheafModule X.toRingedSpace).Submodule)

/-- **A sheaf of ideals of finite type is generated near every point by finitely many
sections.**  This is condition (1) of Stacks tag 063H, read on a neighbourhood of a point. -/
theorem exists_isGeneratedByOn_of_isFiniteType
    (hJ : SheafOfModules.IsFiniteType.{u, u, u} J.toSheafOfModules) (x : X) :
    ∃ (V : Opens X) (_ : x ∈ V) (s : ℕ) (g : Fin s → X.presheaf.obj (op V)),
      IsGeneratedByOn X.toRingedSpace J V g := by
  classical
  obtain ⟨V, hxV, ι, hfin, sec, hs⟩ :=
    Stacks.SheafOfModules.LocallySurjective.exists_local_generators hJ x
  set e : ι ≃ Fin (Fintype.card ι) := Fintype.equivFin ι with he
  refine ⟨V, hxV, Fintype.card ι, fun i => (sec (e.symm i)).1, ?_⟩
  have hmemJ : ∀ i, ((sec (e.symm i)).1 : X.presheaf.obj (op V)) ∈ J.obj (op V) :=
    fun i => (sec (e.symm i)).2
  refine isGeneratedByOn_of_forall_stalkIdeal_eq J _ fun y hy => ?_
  refine le_antisymm ?_ (jid_germFamily_le_stalkIdeal J _ hmemJ y hy)
  rintro b hb
  obtain ⟨U₀, hyU₀, t, ht, rfl⟩ := (mem_stalkIdeal_iff J).mp hb
  have hyU : y ∈ U₀ ⊓ V := ⟨hyU₀, hy⟩
  have ht' : X.presheaf.map (homOfLE (inf_le_left (a := U₀) (b := V))).op t
      ∈ J.obj (op (U₀ ⊓ V)) := restrict_mem J _ ht
  obtain ⟨V', hV'U, hyV', a, hA⟩ :=
    hs (U₀ ⊓ V) inf_le_right
      (⟨_, ht'⟩ : J.toSheafOfModules.val.presheaf.obj (op (U₀ ⊓ V))) y hyU
  have hV'V : V' ≤ V := le_trans hV'U inf_le_right
  have hA' : X.presheaf.map (homOfLE hV'U).op
        (X.presheaf.map (homOfLE (inf_le_left (a := U₀) (b := V))).op t)
      = ∑ j, (show X.presheaf.obj (op V') from a j)
          * X.presheaf.map (homOfLE hV'V).op (sec j).1 := by
    refine Eq.trans (congrArg (fun z : J.toSheafOfModules.val.presheaf.obj (op V') =>
      (z.1 : X.presheaf.obj (op V'))) hA) ?_
    exact map_sum (J.obj (op V')).subtype _ Finset.univ
  have hgerm := congrArg (X.presheaf.germ V' y hyV') hA'
  rw [map_sum, Stacks.AlgebraicGeometry.QuasiRegular.res_res
    (inf_le_left (a := U₀) (b := V)) hV'U t,
    TopCat.Presheaf.germ_res_apply X.presheaf
      (homOfLE (le_trans hV'U (inf_le_left (a := U₀) (b := V)))) y hyV' t] at hgerm
  rw [hgerm]
  refine Ideal.sum_mem _ fun j _ => ?_
  rw [germ_mul_map_restrict hV'V (a j : X.presheaf.obj (op V')) (sec j).1 y hyV']
  refine Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨e j, ?_⟩)
  show X.presheaf.germ V y hy (sec (e.symm (e j))).1 = _
  rw [Equiv.symm_apply_apply]

/-- **The Nakayama and shrinking step in the proof of Stacks tag 063H.**  Let `J ⊆ O_X` be a
sheaf of ideals of finite type on a locally ringed space and let `x` be a point of the support
of `O_X / J`.  Sections `f₁, …, f_r` of `J` over a neighbourhood `U` of `x` whose germs generate
`J_x` modulo `J_x²` generate `J` on a neighbourhood of `x`. -/
@[stacks 063H "the Nakayama and shrinking step of the proof only: sections of a finite-type `J`
whose germs generate `J_x/J_x²` generate `J` near `x`. The characterization itself is
`Stacks.AlgebraicGeometry.RegularIdealSheaf.Conormal.isQuasiRegularIdealSheaf_iff`."]
theorem exists_isGeneratedByOn_of_isFiniteType_of_le_sup_sq
    (hJ : SheafOfModules.IsFiniteType.{u, u, u} J.toSheafOfModules) {x : X}
    (hne : stalkIdeal J x ≠ ⊤) {U : Opens X} (hxU : x ∈ U) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op U)) (hf : ∀ i, f i ∈ J.obj (op U))
    (hle : stalkIdeal J x
      ≤ Jid (germFamily X.toRingedSpace U f x hxU) ⊔ stalkIdeal J x ^ 2) :
    ∃ (V : Opens X) (_ : x ∈ V) (hVU : V ≤ U),
      IsGeneratedByOn X.toRingedSpace J V
        (fun i => X.presheaf.map (homOfLE hVU).op (f i)) := by
  obtain ⟨W, hxW, _, g, hg⟩ := exists_isGeneratedByOn_of_isFiniteType J hJ x
  exact exists_isGeneratedByOn_of_le_sup_sq J hne hxW g hg hxU f hf hle

end FiniteType

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
