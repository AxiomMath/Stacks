-/


@[expose] public section

open CategoryTheory AlgebraicGeometry Limits Opposite

universe w v₁ v₂ u₁ u₂ u

namespace Stacks.Sites

/-! ### Transport of a sheaf of types along a compatible-preserving functor -/

/-- The restriction of a sheaf of types along a compatible-preserving functor `G : C ⥤ D` is a
sheaf for the topology generated by a precoverage `K`, provided the sieve generated by the image
of each `K`-covering family is covering. -/
public theorem isSheaf_type_op_comp_of_precoverage {C : Type u₁} [Category.{v₁} C]
    {D : Type u₂} [Category.{v₂} D] (K : Precoverage C) [K.HasPullbacks]
    [K.IsStableUnderBaseChange] {G : C ⥤ D} {L : GrothendieckTopology D}
    (hG : CompatiblePreserving.{w} L G) (P : Dᵒᵖ ⥤ Type w) (hP : Presieve.IsSheaf L P)
    (h : ∀ ⦃Y : C⦄ (R : Presieve Y), R ∈ K Y →
      (Sieve.generate R).functorPushforward G ∈ L (G.obj Y)) :
    Presieve.IsSheaf K.toGrothendieck (G.op ⋙ P) := by
  rw [Precoverage.isSheaf_toGrothendieck_iff_of_isStableUnderBaseChange]
  intro Y R hR
  rw [Presieve.isSheafFor_iff_generate]
  exact isSheafFor_op_comp hG ⟨P, (isSheaf_iff_isSheaf_of_type _ _).2 hP⟩ _ (h R hR)

/-! ### A site of schemes whose coverings are fpqc coverings -/

section

variable {C : Type (u + 1)} [Category.{u} C] [HasPullbacks C] {S : Scheme.{u}}
  (K : Precoverage C) (toOver : C ⥤ Over S)
  [PreservesLimitsOfShape WalkingCospan (toOver ⋙ Over.forget S)]

/-- The canonical functor from a site of schemes over `S` to the schemes over `S` is
compatible-preserving for the fpqc topology induced on `Over S`. -/
public theorem compatiblePreserving_toOver :
    CompatiblePreserving.{u} (Scheme.fpqcTopology.{u}.over S) toOver := by
  have : PreservesLimitsOfShape WalkingCospan toOver :=
    preservesLimitsOfShape_of_reflects_of_preserves _ (Over.forget S)
  exact compatiblePreserving_of_preservesPullbacks _ _

variable (hfpqc : ∀ ⦃T : C⦄ (R : Presieve T), R ∈ K T →
  Presieve.map (toOver ⋙ Over.forget S) R ∈
    Scheme.fpqcPrecoverage.{u} ((toOver ⋙ Over.forget S).obj T))

include hfpqc

/-- A site of schemes over `S` whose covering families become fpqc covering families of schemes
is cover preserving into the fpqc topology on all schemes. -/
public theorem coverPreserving_toScheme_of_mem_fpqcPrecoverage :
    CoverPreserving K.toGrothendieck Scheme.fpqcTopology.{u} (toOver ⋙ Over.forget S) := by
  refine coverPreserving_of_generators _ K _ ?_
  intro X R hR
  rw [← Sieve.generate_map_eq_functorPushforward]
  exact Precoverage.generate_mem_toGrothendieck (hfpqc R hR)

/-- The sieve generated in the schemes over `S` by the image of a covering family of such a site
is covering for the fpqc topology induced on `Over S`. -/
public theorem functorPushforward_toOver_mem_fpqcOver ⦃T : C⦄ (R : Presieve T) (hR : R ∈ K T) :
    (Sieve.generate R).functorPushforward toOver ∈
      (Scheme.fpqcTopology.{u}.over S) (toOver.obj T) := by
  rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
  exact (coverPreserving_toScheme_of_mem_fpqcPrecoverage K toOver hfpqc).cover_preserve
    (Precoverage.generate_mem_toGrothendieck hR)

variable [K.HasPullbacks] [K.IsStableUnderBaseChange]

/-- **The presheaf `𝒪` is a sheaf on a site of schemes over `S` whose coverings are fpqc
coverings of schemes.** -/
@[stacks 03OJ "the structure presheaf is a sheaf"]
public theorem isSheaf_structurePresheaf_of_mem_fpqcPrecoverage :
    Presheaf.IsSheaf K.toGrothendieck (structurePresheaf S toOver) :=
  isSheaf_structurePresheaf S K.toGrothendieck toOver
    ((isSheaf_iff_isSheaf_of_type _ _).2
      (isSheaf_type_op_comp_of_precoverage K (compatiblePreserving_toOver toOver)
        (globalSectionsOver S)
        ((isSheaf_iff_isSheaf_of_type _ _).1 (isSheaf_fpqcOver_globalSections S))
        (functorPushforward_toOver_mem_fpqcOver K toOver hfpqc)))

/-- The presheaf of pullback sections of a quasi-coherent module `F` on `S` is a sheaf on a site
of schemes over `S` whose coverings are fpqc coverings of schemes. -/
public theorem isSheaf_associatedPresheaf_of_mem_fpqcPrecoverage (F : S.Modules)
    [F.IsQuasicoherent] :
    Presheaf.IsSheaf K.toGrothendieck (associatedPresheaf S F toOver) := by
  have htype : Presheaf.IsSheaf (Scheme.fpqcTopology.{u}.over S)
      (quasiCoherentPresheafFunctor S F ⋙ CategoryTheory.forget AddCommGrpCat) :=
    (Presheaf.isSheaf_of_iso_iff (quasiCoherentPresheafIsoPresheafHom F)).mpr
      (isSheaf_presheafHom' (Scheme.unitModule S) F)
  exact isSheaf_addCommGrpCat_op_comp_of_precoverage K (compatiblePreserving_toOver toOver)
    (quasiCoherentPresheafFunctor S F) ((isSheaf_iff_isSheaf_of_type _ _).1 htype)
    (functorPushforward_toOver_mem_fpqcOver K toOver hfpqc)

/-- **The presheaf of morphisms of pullbacks of two quasi-coherent modules is a sheaf on a site of
schemes over `S` whose coverings are fpqc coverings of schemes.**  Its value at an object `T` is
the module of morphisms `f_T⁺F ⟶ f_T⁺G` on the underlying scheme of `T`, which is *not* the
associated presheaf: the latter records the sections of `f_T⁺F`, while this one records morphisms
of sheaves of modules. -/
public theorem isSheaf_presheafHom_toOver_of_mem_fpqcPrecoverage (F G : S.Modules)
    [F.IsQuasicoherent] [G.IsQuasicoherent] :
    Presieve.IsSheaf K.toGrothendieck
      (toOver.op ⋙ modulePullbackPseudofunctor.presheafHom F G) :=
  isSheaf_type_op_comp_of_precoverage K (compatiblePreserving_toOver toOver)
    (modulePullbackPseudofunctor.presheafHom F G)
    ((isSheaf_iff_isSheaf_of_type _ _).1 (isSheaf_presheafHom' F G))
    (functorPushforward_toOver_mem_fpqcOver K toOver hfpqc)

/-- The structure sheaf of rings of a site of schemes over `S` whose coverings are fpqc
coverings of schemes.  Its sections over an object are the global functions on the underlying
scheme; no sheafification occurs. -/
public noncomputable def fpqcSiteStructureSheaf : Sheaf K.toGrothendieck RingCat.{u} :=
  siteStructureSheaf S toOver K.toGrothendieck
    (isSheaf_structurePresheaf_of_mem_fpqcPrecoverage K toOver hfpqc)

/-- The associated module `Fᵃ` of a quasi-coherent module `F` on `S`, as a sheaf of modules over
the structure sheaf of a site of schemes over `S` whose coverings are fpqc coverings of schemes.
Its sections over an object are the global sections of the pullback of `F` to the underlying
scheme. -/
public noncomputable def fpqcSiteAssociatedModule (F : S.Modules) [F.IsQuasicoherent] :
    SheafOfModules.{u} (fpqcSiteStructureSheaf K toOver hfpqc) :=
  siteAssociatedModule S F toOver K.toGrothendieck
    (isSheaf_structurePresheaf_of_mem_fpqcPrecoverage K toOver hfpqc)
    (isSheaf_associatedPresheaf_of_mem_fpqcPrecoverage K toOver hfpqc F)

/-- The sections of `Fᵃ` on such a site are the global sections of the pullback of `F`. -/
@[simp]
public theorem fpqcSiteAssociatedModule_presheaf (F : S.Modules) [F.IsQuasicoherent] :
    (fpqcSiteAssociatedModule K toOver hfpqc F).val.presheaf =
      associatedPresheaf S F toOver := rfl

end

end Stacks.Sites

end
