module

public import StacksFrontier.AlgebraicGeometry.Descent.FpqcHomSheafRefinement
public import StacksFrontier.AlgebraicGeometry.Descent.QuasiCoherent.RefinementTransport
public import StacksFrontier.CategoryTheory.Sites.Descent.OfRefinement

/-!
# The refinement transport of effectivity for fpqc coverings

`AlgebraicGeometry.QuasicoherentDescentData.isEffective_of_isEffective_pullFunctor_obj` carries
the effectivity of a quasi-coherent descent datum back from a refinement, under the hypothesis
that restriction along the refinement is fully faithful. This file proves that hypothesis when the
refining family is an fpqc covering, using the fpqc sheaf condition for the presheaf of morphisms
between quasi-coherent modules, `AlgebraicGeometry.isSheaf_presheafHom'`.

## Main results

All in the namespace `AlgebraicGeometry.QuasicoherentDescentData`.

* `isSheafFor_presheafHom_refSieve`: the fpqc sheaf condition for the presheaf of morphisms of two
  quasi-coherent modules, on the sieve obtained by pulling back the sieve generated by an fpqc
  covering family of the base.
* `bijective_pullFunctor_map_of_fpqc`: restriction along a refinement by an fpqc covering family
  is bijective on morphisms of quasi-coherent descent data.
* `nonempty_fullyFaithful_pullFunctor_of_fpqc` and
  `nonempty_fullyFaithful_pullFunctor_of_mem_fpqcPrecoverage`: restriction along such a
  refinement is fully faithful.
* `isEffective_of_isEffective_pullFunctor_obj_of_fpqc`, `isEffective_pullFunctor_obj_iff_of_fpqc`
  and `isEffective_of_isEffective_pullFunctor_obj_of_mem_fpqcPrecoverage`: a quasi-coherent
  descent datum is effective when its restriction to an fpqc covering refinement is.
* `isEffective_of_forall_isEffective_of_mem_fpqcPrecoverage` and
  `isEffective_of_forall_isEffective_of_hom`: effectivity for an fpqc covering from effectivity
  for a refining fpqc covering.

## References

* [Stacks Project, Tag 023C](https://stacks.math.columbia.edu/tag/023C)
* [Stacks Project, Tag 023T](https://stacks.math.columbia.edu/tag/023T)
-/

@[expose] public section

open CategoryTheory Limits Opposite

universe w' w u

namespace AlgebraicGeometry

namespace QuasicoherentDescentData

variable {S : Scheme.{u}} {𝒰 : PreZeroHypercover.{w} S} {𝒱 : PreZeroHypercover.{w'} S}

/-- Let `𝒱` be a family of morphisms with target `S` generating an fpqc covering sieve. For any
scheme `T`, any quasi-coherent modules `M` and `N` on `T` and any `a : W ⟶ T` and `q : W ⟶ S`,
the presheaf of morphisms from `M` to `N` on the schemes over `T` satisfies the sheaf condition
for the sieve on `Over.mk a` corresponding to the pullback along `q` of the sieve generated by
`𝒱`. -/
theorem isSheafFor_presheafHom_refSieve
    (h𝒱 : Sieve.ofArrows 𝒱.X 𝒱.f ∈ Scheme.fpqcTopology.{u} S) {T W : Scheme.{u}}
    (M N : T.Modules) [M.IsQuasicoherent] [N.IsQuasicoherent] (a : W ⟶ T) (q : W ⟶ S) :
    Presieve.IsSheafFor (modulePullbackPseudofunctor.presheafHom M N)
      (Pseudofunctor.DescentData.refSieve 𝒱.f a q).arrows :=
  (isSheaf_iff_isSheaf_of_type _ _).1 (isSheaf_presheafHom' M N) _
    (Scheme.fpqcTopology.overEquiv_symm_mem_over (Over.mk a) _
      (Scheme.fpqcTopology.pullback_stable q h𝒱))

/-- Restriction along a refinement is bijective on the morphisms between two quasi-coherent
descent data as soon as it is bijective on the morphisms between their underlying descent
data. -/
theorem bijective_pullFunctor_map_of_bijective (Φ : 𝒱.HomOver 𝒰 (𝟙 S))
    {A B : QuasicoherentDescentData 𝒰.f}
    (h : Function.Bijective ((Pseudofunctor.DescentData.pullFunctor modulePullbackPseudofunctor
      (f := 𝒰.f) (p := 𝟙 S) (f' := 𝒱.f) (α := Φ.s₀) (p' := Φ.h₀) Φ.w₀).map :
        (A.obj ⟶ B.obj) → _)) :
    Function.Bijective ((pullFunctor Φ).map : (A ⟶ B) → _) := by
  have hι := (ObjectProperty.fullyFaithfulι
    (fun D : modulePullbackPseudofunctor.DescentData 𝒰.f ↦
      ∀ i, (D.obj i).IsQuasicoherent)).map_bijective A B
  have hι' := (ObjectProperty.fullyFaithfulι
    (fun D : modulePullbackPseudofunctor.DescentData 𝒱.f ↦
      ∀ i, (D.obj i).IsQuasicoherent)).map_bijective
      ((pullFunctor Φ).obj A) ((pullFunctor Φ).obj B)
  exact (hι'.of_comp_iff' _).1 (h.comp hι)

/-- If `Φ : 𝒱 ⟶ 𝒰` is a refinement over `𝟙 S` and `𝒱` generates an fpqc covering sieve, then
restriction along `Φ` is a bijection from the morphisms `A ⟶ B` of quasi-coherent descent data
for `𝒰` to the morphisms between their restrictions. -/
theorem bijective_pullFunctor_map_of_fpqc (Φ : 𝒱.HomOver 𝒰 (𝟙 S))
    (h𝒱 : Sieve.ofArrows 𝒱.X 𝒱.f ∈ Scheme.fpqcTopology.{u} S)
    (A B : QuasicoherentDescentData 𝒰.f) :
    Function.Bijective ((pullFunctor Φ).map : (A ⟶ B) → _) :=
  bijective_pullFunctor_map_of_bijective Φ
    (Pseudofunctor.DescentData.bijective_pullFunctor_map
      (F := modulePullbackPseudofunctor) (f := 𝒰.f) (f' := 𝒱.f) (α := Φ.s₀) (p' := Φ.h₀)
      (D₁ := A.obj) (D₂ := B.obj) (fun j ↦ (Φ.w₀ j).trans (Category.comp_id _))
      (fun i ↦ isSheafFor_presheafHom_refSieve h𝒱 (A.component i) (B.component i) _ _)
      (fun _ _ ↦ .ofHasPullback _ _)
      (fun i₁ _ ↦ (isSheafFor_presheafHom_refSieve h𝒱
        (A.component i₁) (B.component i₁) _ _).isSeparatedFor))

/-- Restriction of quasi-coherent descent data along a refinement by a family generating an fpqc
covering sieve is fully faithful. -/
theorem nonempty_fullyFaithful_pullFunctor_of_fpqc (Φ : 𝒱.HomOver 𝒰 (𝟙 S))
    (h𝒱 : Sieve.ofArrows 𝒱.X 𝒱.f ∈ Scheme.fpqcTopology.{u} S) :
    Nonempty (pullFunctor Φ).FullyFaithful :=
  (Functor.FullyFaithful.nonempty_iff_map_bijective _).2
    (bijective_pullFunctor_map_of_fpqc Φ h𝒱)

/-- If `𝒱` refines `𝒰` over `𝟙 S` and generates an fpqc covering sieve, then a quasi-coherent
descent datum for `𝒰` whose restriction to `𝒱` is effective is itself effective. -/
theorem isEffective_of_isEffective_pullFunctor_obj_of_fpqc (Φ : 𝒱.HomOver 𝒰 (𝟙 S))
    (h𝒱 : Sieve.ofArrows 𝒱.X 𝒱.f ∈ Scheme.fpqcTopology.{u} S)
    {D : QuasicoherentDescentData 𝒰.f} (hD : ((pullFunctor Φ).obj D).IsEffective) :
    D.IsEffective :=
  isEffective_of_isEffective_pullFunctor_obj_of_bijective Φ
    (bijective_pullFunctor_map_of_fpqc Φ h𝒱) hD

/-- Along a refinement by a family generating an fpqc covering sieve, a quasi-coherent descent
datum is effective exactly when its restriction is. -/
theorem isEffective_pullFunctor_obj_iff_of_fpqc (Φ : 𝒱.HomOver 𝒰 (𝟙 S))
    (h𝒱 : Sieve.ofArrows 𝒱.X 𝒱.f ∈ Scheme.fpqcTopology.{u} S)
    {D : QuasicoherentDescentData 𝒰.f} :
    ((pullFunctor Φ).obj D).IsEffective ↔ D.IsEffective :=
  ⟨isEffective_of_isEffective_pullFunctor_obj_of_fpqc Φ h𝒱, isEffective_pullFunctor_obj Φ⟩

/-- The sieve generated by an fpqc covering family is an fpqc covering sieve. -/
theorem ofArrows_mem_fpqcTopology (h𝒱 : 𝒱.presieve₀ ∈ Scheme.fpqcPrecoverage.{u} S) :
    Sieve.ofArrows 𝒱.X 𝒱.f ∈ Scheme.fpqcTopology.{u} S :=
  Precoverage.generate_mem_toGrothendieck h𝒱

/-- Restriction of quasi-coherent descent data along a refinement by an fpqc covering family is
fully faithful. -/
theorem nonempty_fullyFaithful_pullFunctor_of_mem_fpqcPrecoverage (Φ : 𝒱.HomOver 𝒰 (𝟙 S))
    (h𝒱 : 𝒱.presieve₀ ∈ Scheme.fpqcPrecoverage.{u} S) :
    Nonempty (pullFunctor Φ).FullyFaithful :=
  nonempty_fullyFaithful_pullFunctor_of_fpqc Φ (ofArrows_mem_fpqcTopology h𝒱)

/-- If `𝒱` is an fpqc covering family refining `𝒰` over `𝟙 S`, then a quasi-coherent descent
datum for `𝒰` whose restriction to `𝒱` is effective is itself effective. -/
theorem isEffective_of_isEffective_pullFunctor_obj_of_mem_fpqcPrecoverage
    (Φ : 𝒱.HomOver 𝒰 (𝟙 S)) (h𝒱 : 𝒱.presieve₀ ∈ Scheme.fpqcPrecoverage.{u} S)
    {D : QuasicoherentDescentData 𝒰.f} (hD : ((pullFunctor Φ).obj D).IsEffective) :
    D.IsEffective :=
  isEffective_of_isEffective_pullFunctor_obj_of_fpqc Φ (ofArrows_mem_fpqcTopology h𝒱) hD

/-- If every quasi-coherent descent datum for `𝒱` is effective and `𝒱` is an fpqc covering
family refining `𝒰` over `𝟙 S`, then every quasi-coherent descent datum for `𝒰` is effective. -/
theorem isEffective_of_forall_isEffective_of_mem_fpqcPrecoverage (Φ : 𝒱.HomOver 𝒰 (𝟙 S))
    (h𝒱 : 𝒱.presieve₀ ∈ Scheme.fpqcPrecoverage.{u} S)
    (h : ∀ D : QuasicoherentDescentData 𝒱.f, D.IsEffective)
    (D : QuasicoherentDescentData 𝒰.f) : D.IsEffective :=
  isEffective_of_isEffective_pullFunctor_obj_of_mem_fpqcPrecoverage Φ h𝒱 (h _)

/-- If every quasi-coherent descent datum for `𝒱` is effective and `𝒱` is an fpqc covering
family refining `𝒰` in the sense of `CategoryTheory.PreZeroHypercover.Hom`, then every
quasi-coherent descent datum for `𝒰` is effective. -/
theorem isEffective_of_forall_isEffective_of_hom (Φ : 𝒱.Hom 𝒰)
    (h𝒱 : 𝒱.presieve₀ ∈ Scheme.fpqcPrecoverage.{u} S)
    (h : ∀ D : QuasicoherentDescentData 𝒱.f, D.IsEffective)
    (D : QuasicoherentDescentData 𝒰.f) : D.IsEffective :=
  isEffective_of_forall_isEffective_of_mem_fpqcPrecoverage
    ((PreZeroHypercover.homOverIdEquivHom 𝒱 𝒰).symm Φ) h𝒱 h D

end QuasicoherentDescentData

end AlgebraicGeometry

end
