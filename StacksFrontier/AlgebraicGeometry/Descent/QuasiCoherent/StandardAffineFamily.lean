      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₃) hw₁ hw₃
      (triplePreimageFactor₁_comp u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm)
      (triplePreimageFactor₃_comp u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm),
    localTransition_comp u hg N D eN
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p)
      (triplePreimageFactor₁ u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm)
      (triplePreimageFactor₂ u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm)
      (triplePreimageFactor₃ u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm)
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₁)
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₂)
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₃) hw₁ hw₂ hw₃
      (triplePreimageFactor₁_comp u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm)
      (triplePreimageFactor₂_comp u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm)
      (triplePreimageFactor₃_comp u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm)]

/-- **The descent datum for the single morphism `b`**, as a
`CategoryTheory.Pseudofunctor.DescentData'`: the quasi-coherent module `N` on `Z` with the
transition isomorphism `Stacks.Descent.transitionIso` over the chosen fibre square. -/
def transitionDescentData' (hu : ⨆ k, (u k).opensRange = ⊤)
    (sq₃ : ChosenPullback₃ sqb sqb sqb) :
    qcohPseudofunctor.{u}.DescentData' (X := fun _ : Unit ↦ Z) (f := fun _ ↦ b)
      (fun _ _ ↦ sqb) (fun _ _ _ ↦ sq₃) where
  obj _ := N
  hom _ _ := (transitionIso u sqb hg hu N D eN).hom
  pullHom'_hom_self _ := pullHom'_transitionIso_hom_self u sqb hg N D eN hu
  pullHom'_hom_comp _ _ _ := pullHom'_transitionIso_hom_comp u sqb hg N D eN hu sq₃

/-- **The descent datum for the single morphism `b`, as a
`CategoryTheory.Pseudofunctor.DescentData`.** -/
def transitionDescentData (hu : ⨆ k, (u k).opensRange = ⊤)
    (sq₃ : ChosenPullback₃ sqb sqb sqb) :
    qcohPseudofunctor.{u}.DescentData (fun _ : Unit ↦ b) :=
  (transitionDescentData' u sqb hg N D eN hu sq₃).descentData

/-- **The transition morphisms of `Stacks.Descent.transitionDescentData` are the local normal
forms.**  This is `Stacks.Descent.pullHom'_transitionIso_hom` read through
`CategoryTheory.Pseudofunctor.DescentData'.descentData`. -/
theorem transitionDescentData_hom (hu : ⨆ k, (u k).opensRange = ⊤)
    (sq₃ : ChosenPullback₃ sqb sqb sqb)
    {V : Scheme.{u}} (q : V ⟶ S) {k₁ k₂ : K}
    (w₁ : V ⟶ X k₁) (w₂ : V ⟶ X k₂) (c₁ c₂ : V ⟶ Z)
    (hw₁ : w₁ ≫ g k₁ = q) (hw₂ : w₂ ≫ g k₂ = q)
    (hc₁ : w₁ ≫ u k₁ = c₁) (hc₂ : w₂ ≫ u k₂ = c₂) :
    (transitionDescentData u sqb hg N D eN hu sq₃).hom q (i₁ := ()) (i₂ := ()) c₁ c₂
        (by rw [← hc₁, Category.assoc, hg, hw₁]) (by rw [← hc₂, Category.assoc, hg, hw₂]) =
      localTransition u hg N D eN q w₁ w₂ c₁ c₂ hw₁ hw₂ hc₁ hc₂ :=
  pullHom'_transitionIso_hom u sqb hg N D eN hu q w₁ w₂ c₁ c₂ hw₁ hw₂ hc₁ hc₂

end LocalForm

section Affine

variable {R : CommRingCat.{u}} {K : Type u} {A : K → CommRingCat.{u}}

/-- The spectrum of the projection onto a factor, followed by the spectrum of the product of a
family of ring maps, is the spectrum of that member of the family. -/
@[reassoc]
theorem specMap_piComponent_comp (ρ : ∀ k, R ⟶ A k) (k : K) :
    Spec.map (piComponent A k) ≫
        Spec.map (CommRingCat.ofHom (RingHom.pi fun k ↦ (ρ k).hom)) = Spec.map (ρ k) := by
  rw [← Spec.map_comp, piComponent_comp]

/-- **The family-to-singleton comparison functor is faithful for a finite family of ring maps.** -/
theorem faithful_familyPullFunctor_specMap [Finite K] (ρ : ∀ k, R ⟶ A k) :
    (familyPullFunctor (Spec.map (CommRingCat.ofHom (RingHom.pi fun k ↦ (ρ k).hom)))
      (fun k ↦ Spec.map (piComponent A k)) (fun k ↦ Spec.map (ρ k))
      (specMap_piComponent_comp ρ)).Faithful :=
  faithful_familyPullFunctor _ (iSup_opensRange_specMap_piComponent A)

/-- **The object half of the family-to-singleton reduction for a finite family of ring maps.**
The components of a descent datum for the family glue to a quasi-coherent module on
`Spec (∏ₖ A k)`. -/
theorem exists_iso_toDescentData_restrictFamilyFunctor_specMap [Finite K] (ρ : ∀ k, R ⟶ A k)
    (D : qcohPseudofunctor.{u}.DescentData (fun k ↦ Spec.map (ρ k))) :
    ∃ N : qcohPseudofunctor.{u}.obj
        (.mk (op (Spec (CommRingCat.of (∀ k, (A k : Type u)))))),
      Nonempty ((qcohPseudofunctor.toDescentData
          (fun k ↦ Spec.map (piComponent A k))).obj N ≅
        (restrictFamilyFunctor (Spec.map (CommRingCat.ofHom (RingHom.pi fun k ↦ (ρ k).hom)))
          (fun k ↦ Spec.map (piComponent A k)) (fun k ↦ Spec.map (ρ k))
          (specMap_piComponent_comp ρ)).obj D) :=
  exists_iso_toDescentData_restrictFamilyFunctor _
    (iSup_opensRange_specMap_piComponent A) D

/-- **The family-to-singleton reduction for a finite family of ring maps, essential
surjectivity.**  The single morphism is the spectrum of the product `R ⟶ ∏ₖ A k`. -/
theorem essSurj_qcohToDescentData_specMap_of_essSurj_familyPullFunctor (ρ : ∀ k, R ⟶ A k)
    (hb : (qcohPseudofunctor.toDescentData
      (fun _ : Unit ↦ Spec.map (CommRingCat.ofHom (RingHom.pi fun k ↦ (ρ k).hom)))).EssSurj)
    (hess : (familyPullFunctor (CommRingCat.ofHom (RingHom.pi fun k ↦ (ρ k).hom) |> Spec.map)
      (fun k ↦ Spec.map (piComponent A k)) (fun k ↦ Spec.map (ρ k))
      (specMap_piComponent_comp ρ)).EssSurj) :
    (qcohPseudofunctor.toDescentData (fun k ↦ Spec.map (ρ k))).EssSurj :=
  essSurj_qcohToDescentData_of_essSurj_familyPullFunctor (specMap_piComponent_comp ρ) hb hess

/-- **The family-to-singleton reduction for a finite family of ring maps.**  Given the fpqc
prestack condition and membership of the family in the fpqc precoverage, descent along the
spectrum of `R ⟶ ∏ₖ A k` together with essential surjectivity of
`Stacks.Descent.familyPullFunctor` gives descent along the family, which is Stacks 023S over
`Spec R`. -/
theorem isEquivalence_qcohToDescentData_specMap_of_essSurj_familyPullFunctor
    [qcohPseudofunctor.{u}.IsPrestack Scheme.fpqcTopology.{u}] (ρ : ∀ k, R ⟶ A k)
    (hmem : Presieve.ofArrows (fun k ↦ Spec (A k)) (fun k ↦ Spec.map (ρ k)) ∈
      Scheme.fpqcPrecoverage.{u} (Spec R))
    (hb : (qcohPseudofunctor.toDescentData
      (fun _ : Unit ↦ Spec.map (CommRingCat.ofHom (RingHom.pi fun k ↦ (ρ k).hom)))).EssSurj)
    (hess : (familyPullFunctor (CommRingCat.ofHom (RingHom.pi fun k ↦ (ρ k).hom) |> Spec.map)
      (fun k ↦ Spec.map (piComponent A k)) (fun k ↦ Spec.map (ρ k))
      (specMap_piComponent_comp ρ)).EssSurj) :
    (qcohPseudofunctor.toDescentData (fun k ↦ Spec.map (ρ k))).IsEquivalence :=
  isEquivalence_qcohToDescentData_of_essSurj_familyPullFunctor (specMap_piComponent_comp ρ)
    (Precoverage.generate_mem_toGrothendieck hmem) hb hess

end Affine

end Stacks.Descent

