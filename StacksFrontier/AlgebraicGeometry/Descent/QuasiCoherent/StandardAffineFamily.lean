@[expose] public section

noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Bicategory CategoryTheory.Limits Opposite
  TopologicalSpace
open Pseudofunctor.LocallyDiscreteOpToCat

universe t t' w v' v u' u

namespace Stacks.Descent

section PairwisePreimage

variable {Y Z : Scheme.{u}} {K : Type v} {X : K → Scheme.{u}} (u : ∀ k, X k ⟶ Z)
  [∀ k, IsOpenImmersion (u k)]

/-- Given two morphisms `f₁ f₂ : Y ⟶ Z` and a family of open immersions `u k : X k ⟶ Z`, this is
the open of `Y` on which `f₁` lands in the image of `u kl.1` and `f₂` lands in the image of
`u kl.2`.  As `kl` ranges over pairs these opens cover `Y`, by
`Stacks.Descent.iSup_opensRange_ι_pairwisePreimageOpen`. -/
def pairwisePreimageOpen (f₁ f₂ : Y ⟶ Z) (kl : K × K) : Y.Opens :=
  (f₁ ⁻¹ᵁ (u kl.1).opensRange) ⊓ (f₂ ⁻¹ᵁ (u kl.2).opensRange)

/-- A point of `Y` lies over the image of some `u k`, as soon as the images of the `u k` cover. -/
private theorem exists_mem_preimage_opensRange (hu : ⨆ k, (u k).opensRange = ⊤) (f : Y ⟶ Z)
    (y : Y) : ∃ k, y ∈ f ⁻¹ᵁ (u k).opensRange := by
  simpa [Opens.mem_iSup] using
    (show y ∈ ⨆ k, f ⁻¹ᵁ (u k).opensRange by rw [← Scheme.Hom.preimage_iSup, hu]; trivial)

variable (f₁ f₂ : Y ⟶ Z)

include u in
/-- The opens `Stacks.Descent.pairwisePreimageOpen` cover `Y` as soon as the images of the `u k`
cover `Z`. -/
theorem iSup_opensRange_ι_pairwisePreimageOpen (hu : ⨆ k, (u k).opensRange = ⊤) :
    ⨆ kl, (pairwisePreimageOpen u f₁ f₂ kl).ι.opensRange = ⊤ := by
  simp only [Scheme.Opens.opensRange_ι, pairwisePreimageOpen]
  rw [eq_top_iff]
  intro y _
  obtain ⟨k, hk⟩ := exists_mem_preimage_opensRange u hu f₁ y
  obtain ⟨l, hl⟩ := exists_mem_preimage_opensRange u hu f₂ y
  exact Opens.mem_iSup.2 ⟨(k, l), hk, hl⟩

/-- The factorisation of `f₁` through `u kl.1` over the open
`Stacks.Descent.pairwisePreimageOpen u f₁ f₂ kl`. -/
def pairwisePreimageFactor₁ (kl : K × K) :
    (pairwisePreimageOpen u f₁ f₂ kl).toScheme ⟶ X kl.1 :=
  IsOpenImmersion.lift (u kl.1) ((pairwisePreimageOpen u f₁ f₂ kl).ι ≫ f₁)
    (by rw [Set.range_subset_iff]; exact fun y ↦ y.2.1)

/-- The factorisation of `f₂` through `u kl.2` over the open
`Stacks.Descent.pairwisePreimageOpen u f₁ f₂ kl`. -/
def pairwisePreimageFactor₂ (kl : K × K) :
    (pairwisePreimageOpen u f₁ f₂ kl).toScheme ⟶ X kl.2 :=
  IsOpenImmersion.lift (u kl.2) ((pairwisePreimageOpen u f₁ f₂ kl).ι ≫ f₂)
    (by rw [Set.range_subset_iff]; exact fun y ↦ y.2.2)

/-- `Stacks.Descent.pairwisePreimageFactor₁` factors `f₁`. -/
@[reassoc]
theorem pairwisePreimageFactor₁_comp (kl : K × K) :
    pairwisePreimageFactor₁ u f₁ f₂ kl ≫ u kl.1 =
      (pairwisePreimageOpen u f₁ f₂ kl).ι ≫ f₁ :=
  IsOpenImmersion.lift_fac _ _ _

/-- `Stacks.Descent.pairwisePreimageFactor₂` factors `f₂`. -/
@[reassoc]
theorem pairwisePreimageFactor₂_comp (kl : K × K) :
    pairwisePreimageFactor₂ u f₁ f₂ kl ≫ u kl.2 =
      (pairwisePreimageOpen u f₁ f₂ kl).ι ≫ f₂ :=
  IsOpenImmersion.lift_fac _ _ _

end PairwisePreimage

section TriplePreimage

variable {Y Z : Scheme.{u}} {K : Type v} {X : K → Scheme.{u}} (u : ∀ k, X k ⟶ Z)
  [∀ k, IsOpenImmersion (u k)]

/-- Given three morphisms `f₁ f₂ f₃ : Y ⟶ Z` and a family of open immersions `u k : X k ⟶ Z`,
this is the open of `Y` on which `f₁` lands in the image of `u klm.1`, `f₂` in the image of
`u klm.2.1` and `f₃` in the image of `u klm.2.2`.  As `klm` ranges over triples these opens
cover `Y`, by `Stacks.Descent.iSup_opensRange_ι_triplePreimageOpen`. -/
def triplePreimageOpen (f₁ f₂ f₃ : Y ⟶ Z) (klm : K × K × K) : Y.Opens :=
  (f₁ ⁻¹ᵁ (u klm.1).opensRange) ⊓ (f₂ ⁻¹ᵁ (u klm.2.1).opensRange) ⊓
    (f₃ ⁻¹ᵁ (u klm.2.2).opensRange)

variable (f₁ f₂ f₃ : Y ⟶ Z)

include u in
/-- The opens `Stacks.Descent.triplePreimageOpen` cover `Y` as soon as the images of the `u k`
cover `Z`. -/
theorem iSup_opensRange_ι_triplePreimageOpen (hu : ⨆ k, (u k).opensRange = ⊤) :
    ⨆ klm, (triplePreimageOpen u f₁ f₂ f₃ klm).ι.opensRange = ⊤ := by
  simp only [Scheme.Opens.opensRange_ι, triplePreimageOpen]
  rw [eq_top_iff]
  intro y _
  obtain ⟨k, hk⟩ := exists_mem_preimage_opensRange u hu f₁ y
  obtain ⟨l, hl⟩ := exists_mem_preimage_opensRange u hu f₂ y
  obtain ⟨m, hm⟩ := exists_mem_preimage_opensRange u hu f₃ y
  exact Opens.mem_iSup.2 ⟨(k, l, m), ⟨hk, hl⟩, hm⟩

/-- The factorisation of `f₁` through `u klm.1` over the open
`Stacks.Descent.triplePreimageOpen u f₁ f₂ f₃ klm`. -/
def triplePreimageFactor₁ (klm : K × K × K) :
    (triplePreimageOpen u f₁ f₂ f₃ klm).toScheme ⟶ X klm.1 :=
  IsOpenImmersion.lift (u klm.1) ((triplePreimageOpen u f₁ f₂ f₃ klm).ι ≫ f₁)
    (by rw [Set.range_subset_iff]; exact fun y ↦ y.2.1.1)

/-- The factorisation of `f₂` through `u klm.2.1` over the open
`Stacks.Descent.triplePreimageOpen u f₁ f₂ f₃ klm`. -/
def triplePreimageFactor₂ (klm : K × K × K) :
    (triplePreimageOpen u f₁ f₂ f₃ klm).toScheme ⟶ X klm.2.1 :=
  IsOpenImmersion.lift (u klm.2.1) ((triplePreimageOpen u f₁ f₂ f₃ klm).ι ≫ f₂)
    (by rw [Set.range_subset_iff]; exact fun y ↦ y.2.1.2)

/-- The factorisation of `f₃` through `u klm.2.2` over the open
`Stacks.Descent.triplePreimageOpen u f₁ f₂ f₃ klm`. -/
def triplePreimageFactor₃ (klm : K × K × K) :
    (triplePreimageOpen u f₁ f₂ f₃ klm).toScheme ⟶ X klm.2.2 :=
  IsOpenImmersion.lift (u klm.2.2) ((triplePreimageOpen u f₁ f₂ f₃ klm).ι ≫ f₃)
    (by rw [Set.range_subset_iff]; exact fun y ↦ y.2.2)

/-- `Stacks.Descent.triplePreimageFactor₁` factors `f₁`. -/
@[reassoc]
theorem triplePreimageFactor₁_comp (klm : K × K × K) :
    triplePreimageFactor₁ u f₁ f₂ f₃ klm ≫ u klm.1 =
      (triplePreimageOpen u f₁ f₂ f₃ klm).ι ≫ f₁ :=
  IsOpenImmersion.lift_fac _ _ _

/-- `Stacks.Descent.triplePreimageFactor₂` factors `f₂`. -/
@[reassoc]
theorem triplePreimageFactor₂_comp (klm : K × K × K) :
    triplePreimageFactor₂ u f₁ f₂ f₃ klm ≫ u klm.2.1 =
      (triplePreimageOpen u f₁ f₂ f₃ klm).ι ≫ f₂ :=
  IsOpenImmersion.lift_fac _ _ _

/-- `Stacks.Descent.triplePreimageFactor₃` factors `f₃`. -/
@[reassoc]
theorem triplePreimageFactor₃_comp (klm : K × K × K) :
    triplePreimageFactor₃ u f₁ f₂ f₃ klm ≫ u klm.2.2 =
      (triplePreimageOpen u f₁ f₂ f₃ klm).ι ≫ f₃ :=
  IsOpenImmersion.lift_fac _ _ _

end TriplePreimage

section ChosenPullbacks

variable {C : Type u} [Category.{v} C]

/-- A `CategoryTheory.Limits.ChosenPullback` out of the mere existence of the pullback. -/
def chosenPullbackOfHasPullback {X₁ X₂ T : C} (f₁ : X₁ ⟶ T) (f₂ : X₂ ⟶ T) [HasPullback f₁ f₂] :
    ChosenPullback f₁ f₂ where
  pullback := Limits.pullback f₁ f₂
  p₁ := Limits.pullback.fst f₁ f₂
  p₂ := Limits.pullback.snd f₁ f₂
  condition := Limits.pullback.condition
  isLimit := (IsPullback.of_hasPullback f₁ f₂).isLimit

/-- A `CategoryTheory.Limits.ChosenPullback₃` compatible with three given chosen pullbacks, out of
the mere existence of the pullback of two of their projections. -/
def chosenPullback₃OfHasPullback {X₁ X₂ X₃ T : C} {f₁ : X₁ ⟶ T} {f₂ : X₂ ⟶ T} {f₃ : X₃ ⟶ T}
    (h₁₂ : ChosenPullback f₁ f₂) (h₂₃ : ChosenPullback f₂ f₃) (h₁₃ : ChosenPullback f₁ f₃)
    [HasPullback h₁₂.p₂ h₂₃.p₁] :
    ChosenPullback₃ h₁₂ h₂₃ h₁₃ where
  chosenPullback := chosenPullbackOfHasPullback h₁₂.p₂ h₂₃.p₁
  l := (ChosenPullback.LiftStruct.nonempty (h := h₁₃)
    (by
      dsimp [chosenPullbackOfHasPullback]
      rw [Category.assoc, Category.assoc, h₁₂.hp₁, h₂₃.hp₂, ← h₂₃.hp₁,
        ← Limits.pullback.condition_assoc, h₁₂.hp₂])
    (by
      dsimp [chosenPullbackOfHasPullback]
      rw [Category.assoc, h₁₂.hp₁])).some

end ChosenPullbacks

section Gluing

variable {C : Type u} [Category.{v} C] {F : Pseudofunctor (LocallyDiscrete Cᵒᵖ) Cat.{v', u'}}
  {ι : Type t} {T : C} {X : ι → C} {M N : F.obj (.mk (op T))}

/-- A family of morphisms between the pullbacks of `M` and `N` along a family `f i : X i ⟶ T`
which agree after any further pullback is a compatible family of sections of
`CategoryTheory.Pseudofunctor.presheafHom`. -/
theorem compatible_presheafHom (f : ∀ i, X i ⟶ T)
    (ψ : ∀ i, (F.presheafHom M N).obj (op (Over.mk (f i))))
    (h : ∀ ⦃Y : C⦄ (q : Y ⟶ T) ⦃i₁ i₂ : ι⦄ (f₁ : Y ⟶ X i₁) (f₂ : Y ⟶ X i₂)
      (hf₁ : f₁ ≫ f i₁ = q) (hf₂ : f₂ ≫ f i₂ = q),
      pullHom (ψ i₁) f₁ q q hf₁ hf₁ = pullHom (ψ i₂) f₂ q q hf₂ hf₂) :
    Presieve.Arrows.Compatible (F.presheafHom M N) (X := fun i ↦ Over.mk (f i))
      (B := Over.mk (𝟙 T)) (fun i ↦ Over.homMk (f i)) ψ := by
  intro i₁ i₂ Z g₁ g₂ _
  exact h Z.hom g₁.left g₂.left (by simpa using Over.w g₁) (by simpa using Over.w g₂)

/-- **Gluing of morphisms.**  If the descent functor of `F` for a family `f i : X i ⟶ T` is full,
then a family of morphisms between the pullbacks of `M` and `N` which agree after any further
pullback comes from a morphism `M ⟶ N`.  This is Mathlib's
`CategoryTheory.Pseudofunctor.DescentData.subtypeCompatibleHomEquiv` read through fullness; for
`Stacks.Descent.qcohPseudofunctor` and a Zariski covering family the hypothesis is
`Stacks.Descent.nonempty_fullyFaithful_qcohToDescentData`. -/
theorem exists_map_eq_of_pullHom_eq (f : ∀ i, X i ⟶ T) [(F.toDescentData f).Full]
    (ψ : ∀ i, (F.presheafHom M N).obj (op (Over.mk (f i))))
    (h : ∀ ⦃Y : C⦄ (q : Y ⟶ T) ⦃i₁ i₂ : ι⦄ (f₁ : Y ⟶ X i₁) (f₂ : Y ⟶ X i₂)
      (hf₁ : f₁ ≫ f i₁ = q) (hf₂ : f₂ ≫ f i₂ = q),
      pullHom (ψ i₁) f₁ q q hf₁ hf₁ = pullHom (ψ i₂) f₂ q q hf₂ hf₂) :
    ∃ φ : M ⟶ N, ∀ i, (F.map (f i).op.toLoc).toFunctor.map φ = ψ i := by
  obtain ⟨φ, hφ⟩ := (F.toDescentData f).map_surjective
    (Pseudofunctor.DescentData.subtypeCompatibleHomEquiv F f
      ⟨ψ, compatible_presheafHom f ψ h⟩)
  exact ⟨φ, fun i ↦ congrFun (congrArg Pseudofunctor.DescentData.Hom.hom hφ) i⟩

end Gluing

/-- **Zariski separatedness of morphisms, read inside `Stacks.Descent.qcohPseudofunctor`.**  A
morphism of quasi-coherent modules is determined by its images under the pullback functors of a
family of open immersions whose images cover the target.  This is
`Stacks.Descent.hom_ext_of_pullback_map_eq` transported through the full subcategory of
quasi-coherent modules. -/
theorem qcoh_hom_ext_of_map_eq {Y : Scheme.{u}} {I : Type w} {V : I → Scheme.{u}}
    (v : ∀ i, V i ⟶ Y) [∀ i, IsOpenImmersion (v i)] (hv : ⨆ i, (v i).opensRange = ⊤)
    {M N : qcohPseudofunctor.{u}.obj (.mk (op Y))} {φ ψ : M ⟶ N}
    (h : ∀ i, (qcohPseudofunctor.map (v i).op.toLoc).toFunctor.map φ =
      (qcohPseudofunctor.map (v i).op.toLoc).toFunctor.map ψ) :
    φ = ψ := by
  apply ObjectProperty.hom_ext
  refine hom_ext_of_pullback_map_eq v hv fun i ↦ ?_
  have h' := congrArg InducedCategory.Hom.hom (h i)
  exact h'

section Reduction

variable {S Z : Scheme.{u}} {K : Type v} {X : K → Scheme.{u}}

/-- **The family-to-singleton comparison functor.**  For a morphism `b : Z ⟶ S` and a family
`u k : X k ⟶ Z` with `u k ≫ b = g k`, this is the functor carrying a descent datum for the single
morphism `b` to a descent datum for the family `g`.  It is
`CategoryTheory.Pseudofunctor.DescentData.pullFunctor` at `p = 𝟙 S` and `p' = u`. -/
def familyPullFunctor (b : Z ⟶ S) (u : ∀ k, X k ⟶ Z) (g : ∀ k, X k ⟶ S)
    (hg : ∀ k, u k ≫ b = g k) :
    qcohPseudofunctor.{u}.DescentData (fun _ : Unit ↦ b) ⥤ qcohPseudofunctor.{u}.DescentData g :=
  Pseudofunctor.DescentData.pullFunctor qcohPseudofunctor (p := 𝟙 S)
    (α := fun _ ↦ (default : Unit)) (p' := u) (fun k ↦ by simpa using hg k)

/-- **A descent datum for the family, read as a Zariski descent datum on `Z`.**  This is
`CategoryTheory.Pseudofunctor.DescentData.pullFunctor` at `p = b` and `p' = 𝟙`; the transition
morphisms of the Zariski descent datum over `Y ⟶ Z` are the transition morphisms of the given
descent datum over the composite `Y ⟶ Z ⟶ S`. -/
def restrictFamilyFunctor (b : Z ⟶ S) (u : ∀ k, X k ⟶ Z) (g : ∀ k, X k ⟶ S)
    (hg : ∀ k, u k ≫ b = g k) :
    qcohPseudofunctor.{u}.DescentData g ⥤ qcohPseudofunctor.{u}.DescentData u :=
  Pseudofunctor.DescentData.pullFunctor qcohPseudofunctor (p := b)
    (α := fun k ↦ k) (p' := fun k ↦ 𝟙 (X k)) (fun k ↦ by simpa using (hg k).symm)

variable {b : Z ⟶ S} {u : ∀ k, X k ⟶ Z} {g : ∀ k, X k ⟶ S} (hg : ∀ k, u k ≫ b = g k)

/-- Pulling a quasi-coherent module back to `Z` and then restricting to the family is the same as
restricting it to the family directly.  This is Mathlib's
`CategoryTheory.Pseudofunctor.DescentData.toDescentDataCompPullFunctorIso` with the identity
pullback on `S` removed. -/
def toDescentDataCompFamilyPullFunctorIso :
    qcohPseudofunctor.toDescentData (fun _ : Unit ↦ b) ⋙ familyPullFunctor b u g hg ≅
      qcohPseudofunctor.toDescentData g :=
  Pseudofunctor.DescentData.toDescentDataCompPullFunctorIso _ _ ≪≫
    Functor.isoWhiskerRight (Cat.Hom.toNatIso (qcohPseudofunctor.mapId _)) _ ≪≫
      Functor.leftUnitor _

include hg in
/-- **The sieve generated by the family is contained in the sieve generated by the single
morphism.**  Every member of the family factors through `b`. -/
theorem sieve_ofArrows_le_sieve_ofArrows_singleton :
    Sieve.ofArrows X g ≤ Sieve.ofArrows (X := S) (fun _ : Unit ↦ Z) (fun _ ↦ b) := by
  rw [Sieve.ofArrows, Sieve.ofArrows, Sieve.generate_le_iff]
  rintro W q ⟨k⟩
  exact ⟨_, u k, b, ⟨default⟩, hg k⟩

/-- **The family-to-singleton comparison functor is faithful.**  A morphism of descent data for
`b` is a morphism of quasi-coherent modules on `Z`, and such a morphism is determined by its
pullbacks along the members of an open covering of `Z`. -/
theorem faithful_familyPullFunctor [∀ k, IsOpenImmersion (u k)]
    (hu : ⨆ k, (u k).opensRange = ⊤) : (familyPullFunctor b u g hg).Faithful where
  map_injective {_D₁ _D₂ _φ _ψ} h := by
    ext _
    refine qcoh_hom_ext_of_map_eq u hu fun k ↦ ?_
    exact congrFun (congrArg Pseudofunctor.DescentData.Hom.hom h) k

/-- **The family-to-singleton comparison functor is fully faithful.**  For a Grothendieck topology
for which quasi-coherent modules form a prestack and for which the family `g` is covering, this is
Mathlib's `CategoryTheory.Pseudofunctor.DescentData.fullyFaithfulPullFunctor`:
`Stacks.Descent.familyPullFunctor` is exactly the functor that lemma applies to, with `hg` as its
commutative square. -/
def fullyFaithfulFamilyPullFunctor {J : GrothendieckTopology Scheme.{u}}
    [qcohPseudofunctor.{u}.IsPrestack J] (hgJ : Sieve.ofArrows X g ∈ J S) :
    (familyPullFunctor b u g hg).FullyFaithful :=
  Pseudofunctor.DescentData.fullyFaithfulPullFunctor qcohPseudofunctor
    (α := fun _ ↦ default) hg hgJ

/-- **The object half of the family-to-singleton reduction.**  The components of a descent datum
for the family `g` carry, through `Stacks.Descent.restrictFamilyFunctor`, a Zariski descent datum
for the open covering `u` of `Z`, which is effective by the Zariski stack condition
`Stacks.Descent.isStack_qcohPseudofunctor`.  So they glue to a quasi-coherent module on `Z`. -/
theorem exists_iso_toDescentData_restrictFamilyFunctor [∀ k, IsOpenImmersion (u k)]
    (hu : ⨆ k, (u k).opensRange = ⊤) (D : qcohPseudofunctor.{u}.DescentData g) :
    ∃ N : qcohPseudofunctor.{u}.obj (.mk (op Z)),
      Nonempty ((qcohPseudofunctor.toDescentData u).obj N ≅
        (restrictFamilyFunctor b u g hg).obj D) :=
  have := isEquivalence_qcohToDescentData_zariski u hu
  ⟨_, ⟨(qcohPseudofunctor.toDescentData u).objObjPreimageIso _⟩⟩

/-- **The family-to-singleton reduction, essential surjectivity.**  If every descent datum for the
single morphism `b` is effective, and every descent datum for the family `g` extends to one for
`b`, then every descent datum for `g` is effective. -/
theorem essSurj_qcohToDescentData_of_essSurj_familyPullFunctor
    (hb : (qcohPseudofunctor.toDescentData (fun _ : Unit ↦ b)).EssSurj)
    (hess : (familyPullFunctor b u g hg).EssSurj) :
    (qcohPseudofunctor.toDescentData g).EssSurj :=
  have := hb
  have := hess
  Functor.essSurj_of_iso (toDescentDataCompFamilyPullFunctorIso hg)

/-- **The family-to-singleton reduction.**  For a Grothendieck topology for which quasi-coherent
modules form a prestack and for which the family `g` is covering, descent along the single
morphism `b` together with essential surjectivity of `Stacks.Descent.familyPullFunctor` gives
descent along `g`.  The full faithfulness half is Mathlib's
`CategoryTheory.Pseudofunctor.fullyFaithfulToDescentData` and needs nothing about `b`. -/
theorem isEquivalence_qcohToDescentData_of_essSurj_familyPullFunctor
    {J : GrothendieckTopology Scheme.{u}} [qcohPseudofunctor.{u}.IsPrestack J]
    (hgJ : Sieve.ofArrows X g ∈ J S)
    (hb : (qcohPseudofunctor.toDescentData (fun _ : Unit ↦ b)).EssSurj)
    (hess : (familyPullFunctor b u g hg).EssSurj) :
    (qcohPseudofunctor.toDescentData g).IsEquivalence := by
  have := essSurj_qcohToDescentData_of_essSurj_familyPullFunctor hg hb hess
  have hff := qcohPseudofunctor.fullyFaithfulToDescentData g hgJ
  have := hff.full
  have := hff.faithful
  exact { }

end Reduction

section Transition

variable {S Z : Scheme.{u}} {K : Type v} {X : K → Scheme.{u}} {b : Z ⟶ S}
  (u : ∀ k, X k ⟶ Z) [∀ k, IsOpenImmersion (u k)] (sqb : ChosenPullback b b)

/-- The members of the open covering of the chosen pullback `Z ×[S] Z` on which the transition
isomorphism of `Stacks.Descent.transitionIso` is described. -/
abbrev transitionOpen (kl : K × K) : sqb.pullback.Opens :=
  pairwisePreimageOpen u sqb.p₁ sqb.p₂ kl

/-- The factorisation of the first projection of `Z ×[S] Z` through `u kl.1` over
`Stacks.Descent.transitionOpen`. -/
abbrev transitionFactor₁ (kl : K × K) : (transitionOpen u sqb kl).toScheme ⟶ X kl.1 :=
  pairwisePreimageFactor₁ u sqb.p₁ sqb.p₂ kl

/-- The factorisation of the second projection of `Z ×[S] Z` through `u kl.2` over
`Stacks.Descent.transitionOpen`. -/
abbrev transitionFactor₂ (kl : K × K) : (transitionOpen u sqb kl).toScheme ⟶ X kl.2 :=
  pairwisePreimageFactor₂ u sqb.p₁ sqb.p₂ kl

variable {g : ∀ k, X k ⟶ S} (hg : ∀ k, u k ≫ b = g k)

omit [∀ k, IsOpenImmersion (u k)] in
include hg in
/-- The commutative square exhibiting `Stacks.Descent.restrictFamilyFunctor` as a
`CategoryTheory.Pseudofunctor.DescentData.pullFunctor`. -/
theorem restrictFamilyW (k : K) : 𝟙 (X k) ≫ g k = u k ≫ b := by simpa using (hg k).symm

/-- A factorisation through a member `m` of the family descends to a factorisation over the base. -/
private theorem comp_eq_of_factor {C : Type*} [Category C] {A B D E G : C} {a : A ⟶ B}
    {e : A ⟶ D} {f : D ⟶ E} {p : D ⟶ G} {m : B ⟶ E} {b : E ⟶ G} {gk : B ⟶ G}
    (hg : m ≫ b = gk) (ha : a ≫ m = e ≫ f) (hf : f ≫ b = p) : a ≫ gk = e ≫ p := by
  rw [← hg, ← Category.assoc, ha, Category.assoc, hf]

include hg in
/-- The first leg of `Stacks.Descent.transitionOpen` lies over `S`. -/
theorem transitionW₁ (kl : K × K) :
    transitionFactor₁ u sqb kl ≫ g kl.1 = (transitionOpen u sqb kl).ι ≫ sqb.p :=
  comp_eq_of_factor (hg _) (pairwisePreimageFactor₁_comp u sqb.p₁ sqb.p₂ kl) sqb.hp₁

include hg in
/-- The second leg of `Stacks.Descent.transitionOpen` lies over `S`. -/
theorem transitionW₂ (kl : K × K) :
    transitionFactor₂ u sqb kl ≫ g kl.2 = (transitionOpen u sqb kl).ι ≫ sqb.p :=
  comp_eq_of_factor (hg _) (pairwisePreimageFactor₂_comp u sqb.p₁ sqb.p₂ kl) sqb.hp₂

include hg in
/-- `Stacks.Descent.transitionW₁` with the index map spelled as the composite that
`CategoryTheory.Pseudofunctor.DescentData.pullFunctorCompIso` produces. -/
theorem transitionW₁' (kl : K × K) :
    transitionFactor₁ u sqb kl ≫ g (((fun k ↦ k) ∘ (fun (kl : K × K) ↦ kl.1)) kl) =
      (transitionOpen u sqb kl).ι ≫ sqb.p :=
  transitionW₁ u sqb hg kl

include hg in
/-- `Stacks.Descent.transitionW₂` with the index map spelled as the composite that
`CategoryTheory.Pseudofunctor.DescentData.pullFunctorCompIso` produces. -/
theorem transitionW₂' (kl : K × K) :
    transitionFactor₂ u sqb kl ≫ g (((fun k ↦ k) ∘ (fun (kl : K × K) ↦ kl.2)) kl) =
      (transitionOpen u sqb kl).ι ≫ sqb.p :=
  transitionW₂ u sqb hg kl

/-- Restricting a descent datum for `g` to the Zariski covering `u` of `Z` and then pulling it
back to the first legs of `Stacks.Descent.transitionOpen` is pulling it back to those legs
directly. -/
def transitionCompIso₁ := Pseudofunctor.DescentData.pullFunctorCompIso qcohPseudofunctor
  (restrictFamilyW u hg) (fun kl ↦ pairwisePreimageFactor₁_comp u sqb.p₁ sqb.p₂ kl)
  sqb.p (r' := transitionFactor₁ u sqb) sqb.hp₁ (fun _ ↦ Category.comp_id _)

/-- The second-leg counterpart of `Stacks.Descent.transitionCompIso₁`. -/
def transitionCompIso₂ := Pseudofunctor.DescentData.pullFunctorCompIso qcohPseudofunctor
  (restrictFamilyW u hg) (fun kl ↦ pairwisePreimageFactor₂_comp u sqb.p₁ sqb.p₂ kl)
  sqb.p (r' := transitionFactor₂ u sqb) sqb.hp₂ (fun _ ↦ Category.comp_id _)

/-- Pulling a quasi-coherent module on `Z` back to the first projection of `Z ×[S] Z` and then
restricting to `Stacks.Descent.transitionOpen` is restricting it along the first legs. -/
def transitionBaseIso₁ := Pseudofunctor.DescentData.toDescentDataCompPullFunctorIso
  qcohPseudofunctor (fun kl ↦ pairwisePreimageFactor₁_comp u sqb.p₁ sqb.p₂ kl)

/-- The second-projection counterpart of `Stacks.Descent.transitionBaseIso₁`. -/
def transitionBaseIso₂ := Pseudofunctor.DescentData.toDescentDataCompPullFunctorIso
  qcohPseudofunctor (fun kl ↦ pairwisePreimageFactor₂_comp u sqb.p₁ sqb.p₂ kl)

/-- **The transition isomorphism, read on the open covering `Stacks.Descent.transitionOpen` of
`Z ×[S] Z`.**  The two projections of `Z ×[S] Z` make that covering map to the family `g` over `S`
in two ways with the same morphism `Z ×[S] Z ⟶ S`, so Mathlib's
`CategoryTheory.Pseudofunctor.DescentData.pullFunctorIso` already supplies the isomorphism between
the two induced functors, with the transition morphisms of `D` as its components. -/
def transitionGluedIso (N : qcohPseudofunctor.{u}.obj (.mk (op Z)))
    (D : qcohPseudofunctor.{u}.DescentData g)
    (eN : (qcohPseudofunctor.toDescentData u).obj N ≅ (restrictFamilyFunctor b u g hg).obj D) :
    (qcohPseudofunctor.toDescentData (fun kl ↦ (transitionOpen u sqb kl).ι)).obj
        ((qcohPseudofunctor.map sqb.p₁.op.toLoc).toFunctor.obj N) ≅
      (qcohPseudofunctor.toDescentData (fun kl ↦ (transitionOpen u sqb kl).ι)).obj
        ((qcohPseudofunctor.map sqb.p₂.op.toLoc).toFunctor.obj N) :=
  ((transitionBaseIso₁ u sqb).app N).symm ≪≫
    (Pseudofunctor.DescentData.pullFunctor qcohPseudofunctor
      (fun kl ↦ pairwisePreimageFactor₁_comp u sqb.p₁ sqb.p₂ kl)).mapIso eN ≪≫
    (transitionCompIso₁ u sqb hg).app D ≪≫
    (Pseudofunctor.DescentData.pullFunctorIso qcohPseudofunctor
      (transitionW₁' u sqb hg) (transitionW₂' u sqb hg)).app D ≪≫
    ((transitionCompIso₂ u sqb hg).app D).symm ≪≫
    (Pseudofunctor.DescentData.pullFunctor qcohPseudofunctor
      (fun kl ↦ pairwisePreimageFactor₂_comp u sqb.p₁ sqb.p₂ kl)).mapIso eN.symm ≪≫
    (transitionBaseIso₂ u sqb).app N

/-- **The transition isomorphism over `Z ×[S] Z`.**  A descent datum `D` for the family `g`,
together with a quasi-coherent module `N` on `Z` whose restriction to the Zariski covering `u` is
the restriction of `D`, yields a canonical isomorphism between the two pullbacks of `N` to the
chosen fibre square of `b` with itself.  It is the preimage of
`Stacks.Descent.transitionGluedIso` under the fully faithful descent functor of the Zariski
covering `Stacks.Descent.transitionOpen` of `Z ×[S] Z`. -/
def transitionIso (hu : ⨆ k, (u k).opensRange = ⊤)
    (N : qcohPseudofunctor.{u}.obj (.mk (op Z)))
    (D : qcohPseudofunctor.{u}.DescentData g)
    (eN : (qcohPseudofunctor.toDescentData u).obj N ≅ (restrictFamilyFunctor b u g hg).obj D) :
    (qcohPseudofunctor.map sqb.p₁.op.toLoc).toFunctor.obj N ≅
      (qcohPseudofunctor.map sqb.p₂.op.toLoc).toFunctor.obj N :=
  (nonempty_fullyFaithful_qcohToDescentData
      (iSup_opensRange_ι_pairwisePreimageOpen u sqb.p₁ sqb.p₂ hu)).some.preimageIso
    (transitionGluedIso u sqb hg N D eN)

/-- **`Stacks.Descent.transitionIso` is characterised by its restrictions to the covering
`Stacks.Descent.transitionOpen`.**  This is stated at the level of morphisms of descent data;
the component form is `Stacks.Descent.map_transitionIso_hom_hom`. -/
theorem map_transitionIso_hom (hu : ⨆ k, (u k).opensRange = ⊤)
    (N : qcohPseudofunctor.{u}.obj (.mk (op Z)))
    (D : qcohPseudofunctor.{u}.DescentData g)
    (eN : (qcohPseudofunctor.toDescentData u).obj N ≅ (restrictFamilyFunctor b u g hg).obj D) :
    (qcohPseudofunctor.toDescentData (fun kl ↦ (transitionOpen u sqb kl).ι)).map
        (transitionIso u sqb hg hu N D eN).hom =
      (transitionGluedIso u sqb hg N D eN).hom :=
  Functor.FullyFaithful.map_preimage _ _

/-- The component form of `Stacks.Descent.map_transitionIso_hom`: the pullback of
`Stacks.Descent.transitionIso` to the member `kl` of the covering
`Stacks.Descent.transitionOpen` of `Z ×[S] Z` is the corresponding component of
`Stacks.Descent.transitionGluedIso`, hence the transition morphism
`D.hom _ (transitionFactor₁ _ _ kl) (transitionFactor₂ _ _ kl)` conjugated by the canonical
comparisons. -/
theorem map_transitionIso_hom_hom (hu : ⨆ k, (u k).opensRange = ⊤)
    (N : qcohPseudofunctor.{u}.obj (.mk (op Z)))
    (D : qcohPseudofunctor.{u}.DescentData g)
    (eN : (qcohPseudofunctor.toDescentData u).obj N ≅ (restrictFamilyFunctor b u g hg).obj D)
    (kl : K × K) :
    (qcohPseudofunctor.map (transitionOpen u sqb kl).ι.op.toLoc).toFunctor.map
        (transitionIso u sqb hg hu N D eN).hom =
      (transitionGluedIso u sqb hg N D eN).hom.hom kl :=
  congrFun (congrArg Pseudofunctor.DescentData.Hom.hom
    (map_transitionIso_hom u sqb hg hu N D eN)) kl

end Transition

section Composites

variable {Dc : Type u} [Category.{v} Dc]

/-- A sevenfold composite conjugated by two further morphisms, with each factor replaced by an
equal morphism. -/
theorem comp7_conj {P Y₁ Y₂ Y₃ Y₄ Y₅ Y₆ Y₇ Y₈ Q : Dc} (a : P ⟶ Y₁) (f₁ : Y₁ ⟶ Y₂)
    (f₂ : Y₂ ⟶ Y₃) (f₃ : Y₃ ⟶ Y₄) (f₄ : Y₄ ⟶ Y₅) (f₅ : Y₅ ⟶ Y₆) (f₆ : Y₆ ⟶ Y₇)
    (f₇ : Y₇ ⟶ Y₈) (z : Y₈ ⟶ Q) {A₁ : P ⟶ Y₂} {A₂ : Y₂ ⟶ Y₃} {A₃ : Y₃ ⟶ Y₄}
    {A₄ : Y₄ ⟶ Y₅} {A₅ : Y₅ ⟶ Y₆} {A₆ : Y₆ ⟶ Y₇} {A₇ : Y₇ ⟶ Q}
    (h₁ : a ≫ f₁ = A₁) (h₂ : f₂ = A₂) (h₃ : f₃ = A₃) (h₄ : f₄ = A₄) (h₅ : f₅ = A₅)
    (h₆ : f₆ = A₆) (h₇ : f₇ ≫ z = A₇) :
    a ≫ (f₁ ≫ f₂ ≫ f₃ ≫ f₄ ≫ f₅ ≫ f₆ ≫ f₇) ≫ z =
      (A₁ ≫ A₂ ≫ A₃) ≫ A₄ ≫ A₅ ≫ A₆ ≫ A₇ := by
  subst h₁ h₂ h₃ h₄ h₅ h₆ h₇
  simp only [Category.assoc]

end Composites

section PullHomCalculus

variable {C : Type u} [Category.{v} C] {F : Pseudofunctor (LocallyDiscrete Cᵒᵖ) Cat.{v', u'}}
  {X₁ X₂ X₃ : C} {M₁ : F.obj (.mk (op X₁))} {M₂ : F.obj (.mk (op X₂))}
  {M₃ : F.obj (.mk (op X₃))} {Y : C} {f₁ : Y ⟶ X₁} {f₂ : Y ⟶ X₂} {f₃ : Y ⟶ X₃}

/-- `CategoryTheory.Pseudofunctor.LocallyDiscreteOpToCat.pullHom` is compatible with
composition in the morphism being pulled back. -/
theorem pullHom_comp
    (φ : (F.map f₁.op.toLoc).toFunctor.obj M₁ ⟶ (F.map f₂.op.toLoc).toFunctor.obj M₂)
    (ψ : (F.map f₂.op.toLoc).toFunctor.obj M₂ ⟶ (F.map f₃.op.toLoc).toFunctor.obj M₃)
    {Y' : C} (g : Y' ⟶ Y) (gf₁ : Y' ⟶ X₁) (gf₂ : Y' ⟶ X₂) (gf₃ : Y' ⟶ X₃)
    (hgf₁ : g ≫ f₁ = gf₁) (hgf₂ : g ≫ f₂ = gf₂) (hgf₃ : g ≫ f₃ = gf₃) :
    pullHom (φ ≫ ψ) g gf₁ gf₃ hgf₁ hgf₃ =
      pullHom φ g gf₁ gf₂ hgf₁ hgf₂ ≫ pullHom ψ g gf₂ gf₃ hgf₂ hgf₃ := by
  simp [pullHom, Functor.map_comp, ← reassoc_of% Cat.Hom₂.comp_app, Iso.inv_hom_id]

/-- Pulling back an identity morphism gives an identity morphism. -/
theorem pullHom_id' {Y' : C} (g : Y' ⟶ Y) (gf₁ : Y' ⟶ X₁) (hgf₁ : g ≫ f₁ = gf₁) :
    pullHom (𝟙 ((F.map f₁.op.toLoc).toFunctor.obj M₁)) g gf₁ gf₁ hgf₁ hgf₁ = 𝟙 _ := by
  simp [pullHom]

/-- `CategoryTheory.Pseudofunctor.LocallyDiscreteOpToCat.pullHom_pullHom` with the composite of
the two pullback morphisms named. -/
theorem pullHom_pullHom_eq
    (φ : (F.map f₁.op.toLoc).toFunctor.obj M₁ ⟶ (F.map f₂.op.toLoc).toFunctor.obj M₂)
    {Y' : C} (g : Y' ⟶ Y) (gf₁ : Y' ⟶ X₁) (gf₂ : Y' ⟶ X₂)
    {Y'' : C} (g' : Y'' ⟶ Y') (g'f₁ : Y'' ⟶ X₁) (g'f₂ : Y'' ⟶ X₂) (g'' : Y'' ⟶ Y)
    (hgf₁ : g ≫ f₁ = gf₁) (hgf₂ : g ≫ f₂ = gf₂)
    (hg'f₁ : g' ≫ gf₁ = g'f₁) (hg'f₂ : g' ≫ gf₂ = g'f₂) (hg'' : g' ≫ g = g'') :
    pullHom (pullHom φ g gf₁ gf₂ hgf₁ hgf₂) g' g'f₁ g'f₂ hg'f₁ hg'f₂ =
      pullHom φ g'' g'f₁ g'f₂ (by rw [← hg'', Category.assoc, hgf₁, hg'f₁])
        (by rw [← hg'', Category.assoc, hgf₂, hg'f₂]) := by
  subst hg''
  exact pullHom_pullHom φ g gf₁ gf₂ g' g'f₁ g'f₂ hgf₁ hgf₂ hg'f₁ hg'f₂

/-- A threefold composite pulled back factor by factor. -/
theorem pullHom_comp3 {X₄ : C} {M₄ : F.obj (.mk (op X₄))} {f₄ : Y ⟶ X₄}
    (φ : (F.map f₁.op.toLoc).toFunctor.obj M₁ ⟶ (F.map f₂.op.toLoc).toFunctor.obj M₂)
    (ψ : (F.map f₂.op.toLoc).toFunctor.obj M₂ ⟶ (F.map f₃.op.toLoc).toFunctor.obj M₃)
    (χ : (F.map f₃.op.toLoc).toFunctor.obj M₃ ⟶ (F.map f₄.op.toLoc).toFunctor.obj M₄)
    {Y' : C} (v : Y' ⟶ Y) (d₁ : Y' ⟶ X₁) (d₂ : Y' ⟶ X₂) (d₃ : Y' ⟶ X₃) (d₄ : Y' ⟶ X₄)
    (h₁ : v ≫ f₁ = d₁) (h₂ : v ≫ f₂ = d₂) (h₃ : v ≫ f₃ = d₃) (h₄ : v ≫ f₄ = d₄)
    {A₁ : (F.map d₁.op.toLoc).toFunctor.obj M₁ ⟶ (F.map d₂.op.toLoc).toFunctor.obj M₂}
    {A₂ : (F.map d₂.op.toLoc).toFunctor.obj M₂ ⟶ (F.map d₃.op.toLoc).toFunctor.obj M₃}
    {A₃ : (F.map d₃.op.toLoc).toFunctor.obj M₃ ⟶ (F.map d₄.op.toLoc).toFunctor.obj M₄}
    (e₁ : pullHom φ v d₁ d₂ h₁ h₂ = A₁) (e₂ : pullHom ψ v d₂ d₃ h₂ h₃ = A₂)
    (e₃ : pullHom χ v d₃ d₄ h₃ h₄ = A₃) :
    pullHom (φ ≫ ψ ≫ χ) v d₁ d₄ h₁ h₄ = A₁ ≫ A₂ ≫ A₃ := by
  subst e₁ e₂ e₃
  rw [pullHom_comp φ (ψ ≫ χ) v d₁ d₂ d₄ h₁ h₂ h₄, pullHom_comp ψ χ v d₂ d₃ d₄ h₂ h₃ h₄]

/-- **An equation between composites, checked after a pullback.**  Restricting an equation
`A ≫ B = C` along `v` and transporting it through
`CategoryTheory.Pseudofunctor.LocallyDiscreteOpToCat.map_eq_pullHom` leaves exactly the
corresponding equation between the `pullHom`s, the middle comparison isomorphisms cancelling. -/
theorem map_comp_eq_of_pullHom_comp_eq
    (A : (F.map f₁.op.toLoc).toFunctor.obj M₁ ⟶ (F.map f₂.op.toLoc).toFunctor.obj M₂)
    (B : (F.map f₂.op.toLoc).toFunctor.obj M₂ ⟶ (F.map f₃.op.toLoc).toFunctor.obj M₃)
    (Cm : (F.map f₁.op.toLoc).toFunctor.obj M₁ ⟶ (F.map f₃.op.toLoc).toFunctor.obj M₃)
    {Y' : C} (v : Y' ⟶ Y) (d₁ : Y' ⟶ X₁) (d₂ : Y' ⟶ X₂) (d₃ : Y' ⟶ X₃)
    (h₁ : v ≫ f₁ = d₁) (h₂ : v ≫ f₂ = d₂) (h₃ : v ≫ f₃ = d₃)
    (hyp : pullHom A v d₁ d₂ h₁ h₂ ≫ pullHom B v d₂ d₃ h₂ h₃ = pullHom Cm v d₁ d₃ h₁ h₃) :
    (F.map v.op.toLoc).toFunctor.map (A ≫ B) = (F.map v.op.toLoc).toFunctor.map Cm := by
  rw [CategoryTheory.Functor.map_comp, map_eq_pullHom A v d₁ d₂ h₁ h₂,
    map_eq_pullHom B v d₂ d₃ h₂ h₃, map_eq_pullHom Cm v d₁ d₃ h₁ h₃, ← hyp]
  simp only [Category.assoc, Cat.Hom.hom_inv_id_toNatTrans_app_assoc]

end PullHomCalculus

section DescentDataCalculus

variable {C : Type u} [Category.{v} C] {F : Pseudofunctor (LocallyDiscrete Cᵒᵖ) Cat.{v', u'}}
  {ι : Type t} {S : C} {Xi : ι → C} {f : ∀ i, Xi i ⟶ S}

/-- The transition morphisms of a descent datum do not depend on the morphism to the base, which
appears only in the proof obligations. -/
theorem descentData_hom_base_congr (Dd : F.DescentData f) {Y : C} {q q' : Y ⟶ S} {i₁ i₂ : ι}
    (f₁ : Y ⟶ Xi i₁) (f₂ : Y ⟶ Xi i₂) (h₁ : f₁ ≫ f i₁ = q) (h₂ : f₂ ≫ f i₂ = q)
    (h₁' : f₁ ≫ f i₁ = q') (h₂' : f₂ ≫ f i₂ = q') :
    Dd.hom q f₁ f₂ h₁ h₂ = Dd.hom q' f₁ f₂ h₁' h₂' := by
  obtain rfl : q = q' := by rw [← h₁, h₁']
  rfl

/-- The components of a sevenfold composite of isomorphisms of descent data. -/
theorem trans7_hom_hom {D₁ D₂ D₃ D₄ D₅ D₆ D₇ D₈ : F.DescentData f}
    (e₁ : D₁ ≅ D₂) (e₂ : D₂ ≅ D₃) (e₃ : D₃ ≅ D₄) (e₄ : D₄ ≅ D₅) (e₅ : D₅ ≅ D₆)
    (e₆ : D₆ ≅ D₇) (e₇ : D₇ ≅ D₈) (i : ι) :
    (e₁ ≪≫ e₂ ≪≫ e₃ ≪≫ e₄ ≪≫ e₅ ≪≫ e₆ ≪≫ e₇).hom.hom i =
      e₁.hom.hom i ≫ e₂.hom.hom i ≫ e₃.hom.hom i ≫ e₄.hom.hom i ≫ e₅.hom.hom i ≫
        e₆.hom.hom i ≫ e₇.hom.hom i := rfl

section CommSq

variable {V W T P : C} {tt : V ⟶ P} {rr : P ⟶ T} {ll : V ⟶ W} {bb : W ⟶ T}
  (hsq : tt ≫ rr = ll ≫ bb) (c : V ⟶ T) (hc : ll ≫ bb = c) (M : F.obj (.mk (op T)))

/-- `CategoryTheory.Pseudofunctor.isoMapOfCommSq` is, by
`CategoryTheory.Pseudofunctor.isoMapOfCommSq_eq`, the comparison between the two factorisations
of the diagonal of the square through
`CategoryTheory.Pseudofunctor.mapComp'`; so precomposing it with one of them gives the other. -/
theorem mapComp'_hom_app_comp_isoMapOfCommSq_hom_app :
    (F.mapComp' bb.op.toLoc ll.op.toLoc c.op.toLoc
        (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, hc])).hom.toNatTrans.app M ≫
      (F.isoMapOfCommSq (CommSq.mk hsq).op.toLoc).hom.toNatTrans.app M =
    (F.mapComp' rr.op.toLoc tt.op.toLoc c.op.toLoc
        (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, hsq, hc])).hom.toNatTrans.app M := by
  rw [F.isoMapOfCommSq_eq _ c.op.toLoc (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, hc])]
  simp [← reassoc_of% Cat.Hom₂.comp_app]

/-- The inverse form of `Stacks.Descent.mapComp'_hom_app_comp_isoMapOfCommSq_hom_app`. -/
theorem isoMapOfCommSq_inv_app_comp_mapComp'_inv_app :
    (F.isoMapOfCommSq (CommSq.mk hsq).op.toLoc).inv.toNatTrans.app M ≫
      (F.mapComp' bb.op.toLoc ll.op.toLoc c.op.toLoc
        (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, hc])).inv.toNatTrans.app M =
    (F.mapComp' rr.op.toLoc tt.op.toLoc c.op.toLoc
        (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, hsq, hc])).inv.toNatTrans.app M := by
  rw [F.isoMapOfCommSq_eq _ c.op.toLoc (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, hc])]
  simp

end CommSq

variable {S' : C} {p : S' ⟶ S} {ι' : Type t'} {X' : ι' → C} {f' : ∀ j, X' j ⟶ S'}
  {α : ι' → ι} {p' : ∀ j, X' j ⟶ Xi (α j)}

/-- **The left-hand cancellation at the end of the local normal form.**  The component of
`CategoryTheory.Pseudofunctor.DescentData.toDescentDataCompPullFunctorIso` absorbs the
comparison isomorphism of one leg of the square into the comparison isomorphism of the other. -/
theorem mapComp'_hom_app_comp_tdcpfi_app_inv_hom
    (w : ∀ j, p' j ≫ f (α j) = f' j ≫ p) (M : F.obj (.mk (op S))) (j : ι')
    (c : X' j ⟶ S) (hc : f' j ≫ p = c) :
    (F.mapComp' p.op.toLoc (f' j).op.toLoc c.op.toLoc
        (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, hc])).hom.toNatTrans.app M ≫
      ((Pseudofunctor.DescentData.toDescentDataCompPullFunctorIso F w).app M).inv.hom j =
    (F.mapComp' (f (α j)).op.toLoc (p' j).op.toLoc c.op.toLoc
        (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, w j, hc])).hom.toNatTrans.app M :=
  mapComp'_hom_app_comp_isoMapOfCommSq_hom_app (w j) c hc M

/-- **The right-hand cancellation at the end of the local normal form**; the counterpart of
`Stacks.Descent.mapComp'_hom_app_comp_tdcpfi_app_inv_hom`. -/
theorem tdcpfi_app_hom_hom_comp_mapComp'_inv_app
    (w : ∀ j, p' j ≫ f (α j) = f' j ≫ p) (M : F.obj (.mk (op S))) (j : ι')
    (c : X' j ⟶ S) (hc : f' j ≫ p = c) :
    ((Pseudofunctor.DescentData.toDescentDataCompPullFunctorIso F w).app M).hom.hom j ≫
      (F.mapComp' p.op.toLoc (f' j).op.toLoc c.op.toLoc
        (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, hc])).inv.toNatTrans.app M =
    (F.mapComp' (f (α j)).op.toLoc (p' j).op.toLoc c.op.toLoc
        (by rw [← Quiver.Hom.comp_toLoc, ← op_comp, w j, hc])).inv.toNatTrans.app M :=
  isoMapOfCommSq_inv_app_comp_mapComp'_inv_app (w j) c hc M

end DescentDataCalculus

section AbstractNormalForm

variable {C : Type u} [Category.{v} C] {F : Pseudofunctor (LocallyDiscrete Cᵒᵖ) Cat.{v', u'}}
  {Sb Z W : C} {bm : Z ⟶ Sb} {p₁ p₂ : W ⟶ Z} {pb : W ⟶ Sb}
  {K : Type t} {Xk : K → C} {u : ∀ k, Xk k ⟶ Z} {g : ∀ k, Xk k ⟶ Sb}
  {L : Type t'} {Vl : L → C} {iv : ∀ l, Vl l ⟶ W} {a₁ a₂ : L → K}
  {t₁ : ∀ l, Vl l ⟶ Xk (a₁ l)} {t₂ : ∀ l, Vl l ⟶ Xk (a₂ l)}

/-- **The local normal form, over an arbitrary pseudofunctor.**  A morphism `Φ` between the two
pullbacks of `N` whose restriction to the member `l` of a covering of `W` is the sevenfold
canonical composite — the shape produced by `Stacks.Descent.transitionGluedIso` — has
`CategoryTheory.Pseudofunctor.LocallyDiscreteOpToCat.pullHom` along that member equal to the
transition morphism of `Dd` conjugated by the components of `eN`. -/
theorem pullHom_eq_of_map_eq (hp₁ : p₁ ≫ bm = pb) (hp₂ : p₂ ≫ bm = pb)
    (restrictW : ∀ k, 𝟙 (Xk k) ≫ g k = u k ≫ bm)
    (hw₁ : ∀ l, t₁ l ≫ u (a₁ l) = iv l ≫ p₁) (hw₂ : ∀ l, t₂ l ≫ u (a₂ l) = iv l ≫ p₂)
    (W₁ : ∀ l, t₁ l ≫ g (a₁ l) = iv l ≫ pb) (W₂ : ∀ l, t₂ l ≫ g (a₂ l) = iv l ≫ pb)
    (N : F.obj (.mk (op Z))) (Dd : F.DescentData g)
    (eN : (F.toDescentData u).obj N ≅
      (Pseudofunctor.DescentData.pullFunctor F restrictW).obj Dd)
    (Φ : (F.map p₁.op.toLoc).toFunctor.obj N ⟶ (F.map p₂.op.toLoc).toFunctor.obj N)
    (l : L)
    (hΦ : (F.map (iv l).op.toLoc).toFunctor.map Φ =
      ((Pseudofunctor.DescentData.toDescentDataCompPullFunctorIso F hw₁).app N).inv.hom l ≫
      ((Pseudofunctor.DescentData.pullFunctor F hw₁).mapIso eN).hom.hom l ≫
      ((Pseudofunctor.DescentData.pullFunctorCompIso F restrictW hw₁ pb (r' := t₁) hp₁
        (fun _ ↦ Category.comp_id _)).app Dd).hom.hom l ≫
      ((Pseudofunctor.DescentData.pullFunctorIso F W₁ W₂).app Dd).hom.hom l ≫
      (((Pseudofunctor.DescentData.pullFunctorCompIso F restrictW hw₂ pb (r' := t₂) hp₂
        (fun _ ↦ Category.comp_id _)).app Dd).symm).hom.hom l ≫
      ((Pseudofunctor.DescentData.pullFunctor F hw₂).mapIso eN.symm).hom.hom l ≫
      ((Pseudofunctor.DescentData.toDescentDataCompPullFunctorIso F hw₂).app N).hom.hom l) :
    pullHom Φ (iv l) (iv l ≫ p₁) (iv l ≫ p₂) rfl rfl =
      pullHom (eN.hom.hom (a₁ l)) (t₁ l) (iv l ≫ p₁) (t₁ l) (hw₁ l) (Category.comp_id _) ≫
        Dd.hom (iv l ≫ pb) (t₁ l) (t₂ l) (W₁ l) (W₂ l) ≫
        pullHom (eN.inv.hom (a₂ l)) (t₂ l) (t₂ l) (iv l ≫ p₂) (Category.comp_id _) (hw₂ l) := by
  dsimp only [pullHom]
  rw [hΦ]
  exact comp7_conj _ _ _ _ _ _ _ _ _
    (mapComp'_hom_app_comp_tdcpfi_app_inv_hom hw₁ N l (iv l ≫ p₁) rfl)
    (Pseudofunctor.DescentData.pullFunctor_map_hom F hw₁ eN.hom l)
    (Pseudofunctor.DescentData.pullFunctorCompIso_hom_app_hom F restrictW hw₁ pb
      (r' := t₁) hp₁ (fun _ ↦ Category.comp_id _) Dd l)
    ((Pseudofunctor.DescentData.pullFunctorIso_hom_app_hom F W₁ W₂ Dd l).trans
      (descentData_hom_base_congr Dd _ _ _ _ _ _))
    (Pseudofunctor.DescentData.pullFunctorCompIso_inv_app_hom F restrictW hw₂ pb
      (r' := t₂) hp₂ (fun _ ↦ Category.comp_id _) Dd l)
    (Pseudofunctor.DescentData.pullFunctor_map_hom F hw₂ eN.inv l)
    (tdcpfi_app_hom_hom_comp_mapComp'_inv_app hw₂ N l (iv l ≫ p₂) rfl)

end AbstractNormalForm

section LocalForm

variable {S Z : Scheme.{u}} {K : Type v} {X : K → Scheme.{u}} {b : Z ⟶ S}
  (u : ∀ k, X k ⟶ Z) [∀ k, IsOpenImmersion (u k)] (sqb : ChosenPullback b b)
  {g : ∀ k, X k ⟶ S} (hg : ∀ k, u k ≫ b = g k)
  (N : qcohPseudofunctor.{u}.obj (.mk (op Z)))
  (D : qcohPseudofunctor.{u}.DescentData g)
  (eN : (qcohPseudofunctor.toDescentData u).obj N ≅ (restrictFamilyFunctor b u g hg).obj D)

/-- The decomposition of `Stacks.Descent.transitionGluedIso` into its seven factors, read at the
member `kl` of the covering. -/
theorem transitionGluedIso_hom_hom (kl : K × K) :
    (transitionGluedIso u sqb hg N D eN).hom.hom kl =
      ((transitionBaseIso₁ u sqb).app N).symm.hom.hom kl ≫
      ((Pseudofunctor.DescentData.pullFunctor qcohPseudofunctor
        (fun kl ↦ pairwisePreimageFactor₁_comp u sqb.p₁ sqb.p₂ kl)).mapIso eN).hom.hom kl ≫
      ((transitionCompIso₁ u sqb hg).app D).hom.hom kl ≫
      ((Pseudofunctor.DescentData.pullFunctorIso qcohPseudofunctor
        (transitionW₁' u sqb hg) (transitionW₂' u sqb hg)).app D).hom.hom kl ≫
      (((transitionCompIso₂ u sqb hg).app D).symm).hom.hom kl ≫
      ((Pseudofunctor.DescentData.pullFunctor qcohPseudofunctor
        (fun kl ↦ pairwisePreimageFactor₂_comp u sqb.p₁ sqb.p₂ kl)).mapIso eN.symm).hom.hom kl ≫
      ((transitionBaseIso₂ u sqb).app N).hom.hom kl :=
  trans7_hom_hom _ _ _ _ _ _ _ kl

/-- **The local normal form of the transition morphism.**  Over a scheme `V` carrying two
morphisms to `Z` which factor through the members `u k₁` and `u k₂` of the family, the transition
morphism of `Stacks.Descent.transitionIso` is the transition morphism
`D.hom q w₁ w₂` of the given descent datum, conjugated by the components of `eN`.  See
`Stacks.Descent.pullHom'_transitionIso_hom`. -/
def localTransition {V : Scheme.{u}} (q : V ⟶ S) {k₁ k₂ : K} (w₁ : V ⟶ X k₁) (w₂ : V ⟶ X k₂)
    (c₁ : V ⟶ Z) (c₂ : V ⟶ Z) (hw₁ : w₁ ≫ g k₁ = q) (hw₂ : w₂ ≫ g k₂ = q)
    (hc₁ : w₁ ≫ u k₁ = c₁) (hc₂ : w₂ ≫ u k₂ = c₂) :
    (qcohPseudofunctor.map c₁.op.toLoc).toFunctor.obj N ⟶
      (qcohPseudofunctor.map c₂.op.toLoc).toFunctor.obj N :=
  pullHom (eN.hom.hom k₁) w₁ c₁ w₁ hc₁ (Category.comp_id _) ≫
    D.hom q w₁ w₂ hw₁ hw₂ ≫
    pullHom (eN.inv.hom k₂) w₂ w₂ c₂ (Category.comp_id _) hc₂

omit [∀ k, IsOpenImmersion (u k)] in
/-- **`Stacks.Descent.localTransition` is compatible with further pullbacks.**  This is the
`CategoryTheory.Pseudofunctor.DescentData.pullHom_hom` axiom for the local normal form. -/
theorem pullHom_localTransition {V V' : Scheme.{u}} (q : V ⟶ S) {k₁ k₂ : K}
    (w₁ : V ⟶ X k₁) (w₂ : V ⟶ X k₂) (c₁ c₂ : V ⟶ Z)
    (hw₁ : w₁ ≫ g k₁ = q) (hw₂ : w₂ ≫ g k₂ = q)
    (hc₁ : w₁ ≫ u k₁ = c₁) (hc₂ : w₂ ≫ u k₂ = c₂)
    (v : V' ⟶ V) (q' : V' ⟶ S) (w₁' : V' ⟶ X k₁) (w₂' : V' ⟶ X k₂) (c₁' c₂' : V' ⟶ Z)
    (hq' : v ≫ q = q') (hv₁ : v ≫ w₁ = w₁') (hv₂ : v ≫ w₂ = w₂')
    (hd₁ : v ≫ c₁ = c₁') (hd₂ : v ≫ c₂ = c₂') :
    pullHom (localTransition u hg N D eN q w₁ w₂ c₁ c₂ hw₁ hw₂ hc₁ hc₂) v c₁' c₂' hd₁ hd₂ =
      localTransition u hg N D eN q' w₁' w₂' c₁' c₂'
        (by rw [← hv₁, Category.assoc, hw₁, hq']) (by rw [← hv₂, Category.assoc, hw₂, hq'])
        (by rw [← hv₁, Category.assoc, hc₁, hd₁]) (by rw [← hv₂, Category.assoc, hc₂, hd₂]) := by
  dsimp only [localTransition]
  rw [pullHom_comp _ _ v c₁' w₁' c₂' hd₁ hv₁ hd₂,
    pullHom_comp _ _ v w₁' w₂' c₂' hv₁ hv₂ hd₂,
    pullHom_pullHom_eq (M₁ := N) (M₂ := D.obj k₁) (f₁ := u k₁) (f₂ := 𝟙 (X k₁))
      (eN.hom.hom k₁) w₁ c₁ w₁ v c₁' w₁' w₁' hc₁ (Category.comp_id w₁) hd₁ hv₁ hv₁,
    pullHom_pullHom_eq (M₁ := D.obj k₂) (M₂ := N) (f₁ := 𝟙 (X k₂)) (f₂ := u k₂)
      (eN.inv.hom k₂) w₂ w₂ c₂ v w₂' c₂' w₂' (Category.comp_id w₂) hc₂ hv₂ hd₂ hv₂,
    D.pullHom_hom v q q' hq' w₁ w₂ hw₁ hw₂ w₁' w₂' hv₁ hv₂]

/-- **`Stacks.Descent.transitionIso` has the local normal form on the covering member `kl`.** -/
theorem pullHom_transitionIso_hom (hu : ⨆ k, (u k).opensRange = ⊤) (kl : K × K) :
    pullHom (transitionIso u sqb hg hu N D eN).hom (transitionOpen u sqb kl).ι
        ((transitionOpen u sqb kl).ι ≫ sqb.p₁) ((transitionOpen u sqb kl).ι ≫ sqb.p₂) rfl rfl =
      localTransition u hg N D eN ((transitionOpen u sqb kl).ι ≫ sqb.p)
        (transitionFactor₁ u sqb kl) (transitionFactor₂ u sqb kl)
        ((transitionOpen u sqb kl).ι ≫ sqb.p₁) ((transitionOpen u sqb kl).ι ≫ sqb.p₂)
        (transitionW₁ u sqb hg kl) (transitionW₂ u sqb hg kl)
        (pairwisePreimageFactor₁_comp u sqb.p₁ sqb.p₂ kl)
        (pairwisePreimageFactor₂_comp u sqb.p₁ sqb.p₂ kl) :=
  pullHom_eq_of_map_eq sqb.hp₁ sqb.hp₂ (restrictFamilyW u hg)
    (fun kl ↦ pairwisePreimageFactor₁_comp u sqb.p₁ sqb.p₂ kl)
    (fun kl ↦ pairwisePreimageFactor₂_comp u sqb.p₁ sqb.p₂ kl)
    (transitionW₁' u sqb hg) (transitionW₂' u sqb hg) N D eN _ kl
    ((map_transitionIso_hom_hom u sqb hg hu N D eN kl).trans
      (transitionGluedIso_hom_hom u sqb hg N D eN kl))

/-- A morphism to the chosen fibre square whose two projections factor through `u k₁` and `u k₂`
lands in the member `(k₁, k₂)` of the covering `Stacks.Descent.transitionOpen`. -/
theorem range_le_transitionOpen {V : Scheme.{u}} {k₁ k₂ : K} (w₁ : V ⟶ X k₁) (w₂ : V ⟶ X k₂)
    (pv : V ⟶ sqb.pullback) (h₁ : pv ≫ sqb.p₁ = w₁ ≫ u k₁) (h₂ : pv ≫ sqb.p₂ = w₂ ≫ u k₂) :
    Set.range pv.base ⊆ Set.range (transitionOpen u sqb (k₁, k₂)).ι.base := by
  rw [Set.range_subset_iff]
  intro y
  rw [← Scheme.Hom.coe_opensRange, Scheme.Opens.opensRange_ι]
  exact ⟨(by rw [h₁]; exact ⟨w₁.base y, rfl⟩ : (pv ≫ sqb.p₁).base y ∈ Set.range (u k₁).base),
    (by rw [h₂]; exact ⟨w₂.base y, rfl⟩ : (pv ≫ sqb.p₂).base y ∈ Set.range (u k₂).base)⟩

/-- **The local normal form of `Stacks.Descent.transitionIso` in general position.**  For any
scheme `V` over `S` carrying morphisms `c₁ c₂ : V ⟶ Z` which factor through the members `u k₁`
and `u k₂` of the family, the pullback of the transition isomorphism to `V` is the transition
morphism `D.hom q w₁ w₂` of the given descent datum, conjugated by the components of `eN`. -/
theorem pullHom'_transitionIso_hom (hu : ⨆ k, (u k).opensRange = ⊤)
    {V : Scheme.{u}} (q : V ⟶ S) {k₁ k₂ : K}
    (w₁ : V ⟶ X k₁) (w₂ : V ⟶ X k₂) (c₁ c₂ : V ⟶ Z)
    (hw₁ : w₁ ≫ g k₁ = q) (hw₂ : w₂ ≫ g k₂ = q)
    (hc₁ : w₁ ≫ u k₁ = c₁) (hc₂ : w₂ ≫ u k₂ = c₂) :
    Pseudofunctor.DescentData'.pullHom' (F := qcohPseudofunctor.{u}) (ι := Unit)
        (X := fun _ ↦ Z) (f := fun _ ↦ b) (sq := fun _ _ ↦ sqb) (obj := fun _ ↦ N)
        (obj' := fun _ ↦ N) (fun _ _ ↦ (transitionIso u sqb hg hu N D eN).hom) q
        (i₁ := ()) (i₂ := ()) c₁ c₂
        (by rw [← hc₁, Category.assoc, hg, hw₁]) (by rw [← hc₂, Category.assoc, hg, hw₂]) =
      localTransition u hg N D eN q w₁ w₂ c₁ c₂ hw₁ hw₂ hc₁ hc₂ := by
  obtain ⟨pv, hpv₁, hpv₂⟩ := sqb.isPullback.exists_lift c₁ c₂ (by
    rw [← hc₁, ← hc₂, Category.assoc, Category.assoc, hg, hg, hw₁, hw₂])
  have hpt : IsOpenImmersion.lift (transitionOpen u sqb (k₁, k₂)).ι pv
      (range_le_transitionOpen u sqb w₁ w₂ pv (hpv₁.trans hc₁.symm) (hpv₂.trans hc₂.symm)) ≫
      (transitionOpen u sqb (k₁, k₂)).ι = pv := IsOpenImmersion.lift_fac _ _ _
  set pt := IsOpenImmersion.lift (transitionOpen u sqb (k₁, k₂)).ι pv
    (range_le_transitionOpen u sqb w₁ w₂ pv (hpv₁.trans hc₁.symm) (hpv₂.trans hc₂.symm)) with hptd
  have hd₁ : pt ≫ ((transitionOpen u sqb (k₁, k₂)).ι ≫ sqb.p₁) = c₁ := by
    rw [← Category.assoc, hpt, hpv₁]
  have hd₂ : pt ≫ ((transitionOpen u sqb (k₁, k₂)).ι ≫ sqb.p₂) = c₂ := by
    rw [← Category.assoc, hpt, hpv₂]
  have ht₁ : pt ≫ transitionFactor₁ u sqb (k₁, k₂) = w₁ := by
    rw [← cancel_mono (u k₁), Category.assoc, pairwisePreimageFactor₁_comp, hd₁, ← hc₁]
  have ht₂ : pt ≫ transitionFactor₂ u sqb (k₁, k₂) = w₂ := by
    rw [← cancel_mono (u k₂), Category.assoc, pairwisePreimageFactor₂_comp, hd₂, ← hc₂]
  have hq' : pt ≫ ((transitionOpen u sqb (k₁, k₂)).ι ≫ sqb.p) = q := by
    rw [← Category.assoc, hpt, ← sqb.hp₁, ← Category.assoc, hpv₁, ← hc₁, Category.assoc, hg,
      hw₁]
  rw [← Pseudofunctor.DescentData'.pullHom_pullHom'
    (fun _ _ ↦ (transitionIso u sqb hg hu N D eN).hom) pt
    ((transitionOpen u sqb (k₁, k₂)).ι ≫ sqb.p) q
    ((transitionOpen u sqb (k₁, k₂)).ι ≫ sqb.p₁) ((transitionOpen u sqb (k₁, k₂)).ι ≫ sqb.p₂)
    c₁ c₂ hq' (by rw [Category.assoc, sqb.hp₁]) (by rw [Category.assoc, sqb.hp₂]) hd₁ hd₂,
    Pseudofunctor.DescentData'.pullHom'_eq_pullHom
      (fun _ _ ↦ (transitionIso u sqb hg hu N D eN).hom)
      ((transitionOpen u sqb (k₁, k₂)).ι ≫ sqb.p)
      ((transitionOpen u sqb (k₁, k₂)).ι ≫ sqb.p₁)
      ((transitionOpen u sqb (k₁, k₂)).ι ≫ sqb.p₂) (transitionOpen u sqb (k₁, k₂)).ι
      (by rw [Category.assoc, sqb.hp₁]) (by rw [Category.assoc, sqb.hp₂]) rfl rfl,
    pullHom_transitionIso_hom u sqb hg N D eN hu (k₁, k₂),
    pullHom_localTransition u hg N D eN ((transitionOpen u sqb (k₁, k₂)).ι ≫ sqb.p)
      (transitionFactor₁ u sqb (k₁, k₂)) (transitionFactor₂ u sqb (k₁, k₂))
      ((transitionOpen u sqb (k₁, k₂)).ι ≫ sqb.p₁)
      ((transitionOpen u sqb (k₁, k₂)).ι ≫ sqb.p₂)
      (transitionW₁ u sqb hg (k₁, k₂)) (transitionW₂ u sqb hg (k₁, k₂))
      (pairwisePreimageFactor₁_comp u sqb.p₁ sqb.p₂ (k₁, k₂))
      (pairwisePreimageFactor₂_comp u sqb.p₁ sqb.p₂ (k₁, k₂))
      pt q w₁ w₂ c₁ c₂ hq' ht₁ ht₂ hd₁ hd₂]

omit [∀ k, IsOpenImmersion (u k)] in
/-- The components of `eN` compose to the identity. -/
theorem eN_hom_inv (k : K) : eN.hom.hom k ≫ eN.inv.hom k = 𝟙 _ :=
  congrFun (congrArg Pseudofunctor.DescentData.Hom.hom eN.hom_inv_id) k

omit [∀ k, IsOpenImmersion (u k)] in
/-- The components of `eN` compose to the identity, the other way round. -/
theorem eN_inv_hom (k : K) : eN.inv.hom k ≫ eN.hom.hom k = 𝟙 _ :=
  congrFun (congrArg Pseudofunctor.DescentData.Hom.hom eN.inv_hom_id) k

omit [∀ k, IsOpenImmersion (u k)] in
/-- **The local normal form is the identity on the diagonal.** -/
theorem localTransition_self (k : K) :
    localTransition u hg N D eN (g k) (𝟙 (X k)) (𝟙 (X k)) (u k) (u k)
      (Category.id_comp _) (Category.id_comp _) (Category.id_comp _) (Category.id_comp _) =
      𝟙 _ := by
  dsimp only [localTransition]
  rw [pullHom_id (M₁ := N) (M₂ := D.obj k) (f₁ := u k) (f₂ := 𝟙 (X k)) (eN.hom.hom k),
    pullHom_id (M₁ := D.obj k) (M₂ := N) (f₁ := 𝟙 (X k)) (f₂ := u k) (eN.inv.hom k),
    D.hom_self (g k) (𝟙 (X k)) (Category.id_comp _)]
  exact (congrArg (fun x ↦ eN.hom.hom k ≫ x) (Category.id_comp (eN.inv.hom k))).trans
    (eN_hom_inv u hg N D eN k)

omit [∀ k, IsOpenImmersion (u k)] in
/-- **The local normal forms compose.** -/
theorem localTransition_comp {V : Scheme.{u}} (q : V ⟶ S) {k₁ k₂ k₃ : K}
    (w₁ : V ⟶ X k₁) (w₂ : V ⟶ X k₂) (w₃ : V ⟶ X k₃) (c₁ c₂ c₃ : V ⟶ Z)
    (hw₁ : w₁ ≫ g k₁ = q) (hw₂ : w₂ ≫ g k₂ = q) (hw₃ : w₃ ≫ g k₃ = q)
    (hc₁ : w₁ ≫ u k₁ = c₁) (hc₂ : w₂ ≫ u k₂ = c₂) (hc₃ : w₃ ≫ u k₃ = c₃) :
    localTransition u hg N D eN q w₁ w₂ c₁ c₂ hw₁ hw₂ hc₁ hc₂ ≫
        localTransition u hg N D eN q w₂ w₃ c₂ c₃ hw₂ hw₃ hc₂ hc₃ =
      localTransition u hg N D eN q w₁ w₃ c₁ c₃ hw₁ hw₃ hc₁ hc₃ := by
  have h₂ : pullHom (M₁ := D.obj k₂) (M₂ := N) (f₁ := 𝟙 (X k₂)) (f₂ := u k₂)
        (eN.inv.hom k₂) w₂ w₂ c₂ (Category.comp_id w₂) hc₂ ≫
      pullHom (M₁ := N) (M₂ := D.obj k₂) (f₁ := u k₂) (f₂ := 𝟙 (X k₂))
        (eN.hom.hom k₂) w₂ c₂ w₂ hc₂ (Category.comp_id w₂) = 𝟙 _ :=
    (pullHom_comp (M₁ := D.obj k₂) (M₂ := N) (M₃ := D.obj k₂) (f₁ := 𝟙 (X k₂))
        (f₂ := u k₂) (f₃ := 𝟙 (X k₂)) (eN.inv.hom k₂) (eN.hom.hom k₂) w₂ w₂ c₂ w₂
        (Category.comp_id w₂) hc₂ (Category.comp_id w₂)).symm.trans
      ((congrArg (fun φ ↦ pullHom (M₁ := D.obj k₂) (M₂ := D.obj k₂) (f₁ := 𝟙 (X k₂))
            (f₂ := 𝟙 (X k₂)) φ w₂ w₂ w₂ (Category.comp_id w₂) (Category.comp_id w₂))
          (eN_inv_hom u hg N D eN k₂)).trans
        (pullHom_id' (M₁ := D.obj k₂) (f₁ := 𝟙 (X k₂)) w₂ w₂ (Category.comp_id w₂)))
  dsimp only [localTransition]
  simp only [Category.assoc]
  rw [reassoc_of% h₂, Pseudofunctor.DescentData.hom_comp_assoc D q w₁ w₂ w₃ hw₁ hw₂ hw₃]

/-- **The identity axiom for `Stacks.Descent.transitionIso`.**  The transition isomorphism
`Stacks.Descent.transitionIso` restricts to the identity on the diagonal of `Z ×[S] Z`. -/
theorem pullHom'_transitionIso_hom_self (hu : ⨆ k, (u k).opensRange = ⊤) :
    Pseudofunctor.DescentData'.pullHom' (F := qcohPseudofunctor.{u}) (ι := Unit)
        (X := fun _ ↦ Z) (f := fun _ ↦ b) (sq := fun _ _ ↦ sqb) (obj := fun _ ↦ N)
        (obj' := fun _ ↦ N) (fun _ _ ↦ (transitionIso u sqb hg hu N D eN).hom) b
        (i₁ := ()) (i₂ := ()) (𝟙 Z) (𝟙 Z) (Category.id_comp _) (Category.id_comp _) = 𝟙 _ := by
  refine qcoh_hom_ext_of_map_eq u hu fun k ↦ ?_
  rw [CategoryTheory.Functor.map_id, map_eq_pullHom _ (u k) (u k) (u k) (Category.comp_id _)
      (Category.comp_id _),
    Pseudofunctor.DescentData'.pullHom_pullHom'
      (fun _ _ ↦ (transitionIso u sqb hg hu N D eN).hom) (u k) b (g k) (𝟙 Z) (𝟙 Z) (u k) (u k)
      (hg k) (Category.id_comp _) (Category.id_comp _) (Category.comp_id _) (Category.comp_id _),
    pullHom'_transitionIso_hom u sqb hg N D eN hu (g k) (𝟙 (X k)) (𝟙 (X k)) (u k) (u k)
      (Category.id_comp _) (Category.id_comp _) (Category.id_comp _) (Category.id_comp _),
    localTransition_self u hg N D eN k]
  simp

/-- **The cocycle condition for `Stacks.Descent.transitionIso`.**  The transition isomorphism
`Stacks.Descent.transitionIso` satisfies the cocycle condition over a chosen threefold fibre
product of `b` with itself. -/
theorem pullHom'_transitionIso_hom_comp (hu : ⨆ k, (u k).opensRange = ⊤)
    (sq₃ : ChosenPullback₃ sqb sqb sqb) :
    Pseudofunctor.DescentData'.pullHom' (F := qcohPseudofunctor.{u}) (ι := Unit)
        (X := fun _ ↦ Z) (f := fun _ ↦ b) (sq := fun _ _ ↦ sqb) (obj := fun _ ↦ N)
        (obj' := fun _ ↦ N) (fun _ _ ↦ (transitionIso u sqb hg hu N D eN).hom) sq₃.p
        (i₁ := ()) (i₂ := ()) sq₃.p₁ sq₃.p₂ sq₃.w₁ sq₃.w₂ ≫
      Pseudofunctor.DescentData'.pullHom' (F := qcohPseudofunctor.{u}) (ι := Unit)
        (X := fun _ ↦ Z) (f := fun _ ↦ b) (sq := fun _ _ ↦ sqb) (obj := fun _ ↦ N)
        (obj' := fun _ ↦ N) (fun _ _ ↦ (transitionIso u sqb hg hu N D eN).hom) sq₃.p
        (i₁ := ()) (i₂ := ()) sq₃.p₂ sq₃.p₃ sq₃.w₂ sq₃.w₃ =
      Pseudofunctor.DescentData'.pullHom' (F := qcohPseudofunctor.{u}) (ι := Unit)
        (X := fun _ ↦ Z) (f := fun _ ↦ b) (sq := fun _ _ ↦ sqb) (obj := fun _ ↦ N)
        (obj' := fun _ ↦ N) (fun _ _ ↦ (transitionIso u sqb hg hu N D eN).hom) sq₃.p
        (i₁ := ()) (i₂ := ()) sq₃.p₁ sq₃.p₃ sq₃.w₁ sq₃.w₃ := by
  refine qcoh_hom_ext_of_map_eq
    (fun klm ↦ (triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι)
    (iSup_opensRange_ι_triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ hu) fun klm ↦ ?_
  have hw₁ : triplePreimageFactor₁ u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm ≫ g klm.1 =
      (triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p :=
    comp_eq_of_factor (hg _) (triplePreimageFactor₁_comp u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm) sq₃.w₁
  have hw₂ : triplePreimageFactor₂ u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm ≫ g klm.2.1 =
      (triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p :=
    comp_eq_of_factor (hg _) (triplePreimageFactor₂_comp u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm) sq₃.w₂
  have hw₃ : triplePreimageFactor₃ u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm ≫ g klm.2.2 =
      (triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p :=
    comp_eq_of_factor (hg _) (triplePreimageFactor₃_comp u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm) sq₃.w₃
  refine map_comp_eq_of_pullHom_comp_eq _ _ _
    (triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι
    ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₁)
    ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₂)
    ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₃) rfl rfl rfl ?_
  rw [Pseudofunctor.DescentData'.pullHom_pullHom'
      (fun _ _ ↦ (transitionIso u sqb hg hu N D eN).hom)
      (triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι sq₃.p
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p) sq₃.p₁ sq₃.p₂
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₁)
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₂) rfl sq₃.w₁ sq₃.w₂ rfl rfl,
    Pseudofunctor.DescentData'.pullHom_pullHom'
      (fun _ _ ↦ (transitionIso u sqb hg hu N D eN).hom)
      (triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι sq₃.p
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p) sq₃.p₂ sq₃.p₃
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₂)
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₃) rfl sq₃.w₂ sq₃.w₃ rfl rfl,
    Pseudofunctor.DescentData'.pullHom_pullHom'
      (fun _ _ ↦ (transitionIso u sqb hg hu N D eN).hom)
      (triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι sq₃.p
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p) sq₃.p₁ sq₃.p₃
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₁)
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₃) rfl sq₃.w₁ sq₃.w₃ rfl rfl,
    pullHom'_transitionIso_hom u sqb hg N D eN hu
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p)
      (triplePreimageFactor₁ u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm)
