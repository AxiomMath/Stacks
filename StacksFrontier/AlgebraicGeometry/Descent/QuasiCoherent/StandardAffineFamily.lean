      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p₂) hw₁ hw₂
      (triplePreimageFactor₁_comp u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm)
      (triplePreimageFactor₂_comp u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm),
    pullHom'_transitionIso_hom u sqb hg N D eN hu
      ((triplePreimageOpen u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm).ι ≫ sq₃.p)
      (triplePreimageFactor₂ u sq₃.p₁ sq₃.p₂ sq₃.p₃ klm)
