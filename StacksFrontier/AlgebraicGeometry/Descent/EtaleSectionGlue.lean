module

public import StacksFrontier.AlgebraicGeometry.Descent.FpqcHomSheafRefinement
public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.PullbackCompatibleTransport
public import Mathlib.AlgebraicGeometry.Sites.Etale
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Glueing global sections of a quasi-coherent module along an étale covering

Stacks 03DT says that the presheaf of Stacks 03DS of a quasi-coherent module `F` on a scheme
`S` — the presheaf on the schemes over `S` sending `g : T ⟶ S` to `Γ(T, g⁺F)` — is a sheaf for
the étale topology.  That statement is `AlgebraicGeometry.quasiCoherentPresheaf_isSheaf_etale'`;
this file turns it into the glueing statement a consumer wants: sections of the pullbacks of `F`
to the members of an étale cover of `S` which agree on the pairwise fibre products come from a
unique global section of `F`.

## Main results

* `AlgebraicGeometry.ofArrows_homMk_mem_etaleTopology_over`: the sieve on `Over.mk (𝟙 S)`
  generated by an étale covering family of `S` is a covering sieve for the étale topology on the
  schemes over `S`.  This is the étale twin of
  `AlgebraicGeometry.ofArrows_homMk_mem_fpqcTopology_over`.
* `AlgebraicGeometry.quasiCoherentPresheafForget_isSheaf_etale`: Stacks 03DT for the étale
  topology, read in the underlying types.
* `AlgebraicGeometry.coverSectionsMap`: the restriction `Γ(S, F) → Γ(T, g⁺F)` of a global
  section of `F` along a morphism `g : T ⟶ S`.
* `AlgebraicGeometry.existsUnique_glue_etale`: **the glueing theorem.** Given an étale cover
  `𝒰` of `S` and sections of `F` pulled back to each member which agree on the fibre products
  `𝒰.X i ×_S 𝒰.X j`, there is a unique global section of `F` restricting to each of them.
* `AlgebraicGeometry.section_eq_of_etale_cover`: the separatedness half, stated on its own: two
  global sections of `F` which agree after pullback along every member of an étale cover are
  equal.

## Implementation notes

The presheaf of Stacks 03DS is a presheaf on `Over S`, so its value at the terminal-like object
`Over.mk (𝟙 S)` is `Γ(S, (𝟙 S)⁺F)` rather than `Γ(S, F)`.
`AlgebraicGeometry.pullbackIdSectionsIso` is the identification of the two, obtained by taking
sections of `AlgebraicGeometry.Scheme.Modules.pullbackId`, and `coverSectionsMap` is the
restriction map read through it.  The glueing statement is therefore about honest global
sections of `F`.

`coverSectionsMap` is a function and not a morphism of `AddCommGrpCat`, which is what it would
be if its source and target were written as values of the presheaf.  Writing them instead as
`Γ(F, ⊤)` and `Γ((Scheme.Modules.pullback g).obj F, ⊤)` asks the elaborator to identify
`Scheme.Modules.pullback (Over.mk g).hom` with `Scheme.Modules.pullback g` inside a
`Quiver.Hom`, and that defeq check does not terminate within the heartbeat budget — it unfolds
`Scheme.Modules.pullback`, which is built from the sheafification adjunction.  Applied to an
element the same identification is cheap, so the restriction map is given elementwise; its
defining equation is `AlgebraicGeometry.coverSectionsMap_apply`, by `rfl`.

Compatibility is asked for in the form it occurs in practice — agreement of the two restrictions
to `CategoryTheory.Limits.pullback (𝒰.f i) (𝒰.f j)` — and is converted into the presieve
compatibility predicate by `CategoryTheory.Presieve.Arrows.compatible_of_isPullback`.  The
fibre product of `Over.mk (𝒰.f i)` and `Over.mk (𝒰.f j)` over `Over.mk (𝟙 S)` is computed in
`Over S` by `CategoryTheory.IsPullback.of_map` along `CategoryTheory.Over.forget`, which
reflects it from the fibre product of schemes.

The index universe of the cover is left free: `AlgebraicGeometry.Scheme.Cover.{v}` for any `v`,
since a presieve of `Scheme.{u}` is a predicate on morphisms and `CategoryTheory.Sieve.ofArrows`
puts no constraint on the index type.

## References

* [Stacks Project, Tag 03DS](https://stacks.math.columbia.edu/tag/03DS)
* [Stacks Project, Tag 03DT](https://stacks.math.columbia.edu/tag/03DT)
-/

@[expose] public section

open CategoryTheory Opposite Limits
open scoped AlgebraicGeometry

universe v u

namespace AlgebraicGeometry

/-- The sieve on `Over.mk (𝟙 S)` generated by an étale covering family of `S` is a covering
sieve for the étale topology on the schemes over `S`.  This is the étale twin of
`AlgebraicGeometry.ofArrows_homMk_mem_fpqcTopology_over`, with the same proof: the sieve is the
image under `CategoryTheory.Sieve.overEquiv` of the sieve the family generates on `S`, which is
covering because the family is. -/
lemma ofArrows_homMk_mem_etaleTopology_over {S : Scheme.{u}} {I : Type*}
    {X : I → Scheme.{u}} (f : ∀ i, X i ⟶ S)
    (hf : Presieve.ofArrows X f ∈ Scheme.etalePrecoverage.{u} S) :
    Sieve.ofArrows (fun i ↦ Over.mk (f i))
        (fun i ↦ (Over.homMk (f i) : Over.mk (f i) ⟶ Over.mk (𝟙 S))) ∈
      (Scheme.etaleTopology.{u}.over S) (Over.mk (𝟙 S)) := by
  rw [← overEquiv_symm_ofArrows f]
  refine GrothendieckTopology.overEquiv_symm_mem_over _ _ _ ?_
  exact Precoverage.generate_mem_toGrothendieck hf

/-- The sieve on `Over.mk (𝟙 S)` generated by an étale cover of `S` is a covering sieve for the
étale topology on the schemes over `S`. -/
lemma ofArrows_homMk_cover_mem_etaleTopology_over {S : Scheme.{u}}
    (𝒰 : S.Cover.{v} Scheme.etalePrecoverage.{u}) :
    Sieve.ofArrows (fun i ↦ Over.mk (𝒰.f i))
        (fun i ↦ (Over.homMk (𝒰.f i) : Over.mk (𝒰.f i) ⟶ Over.mk (𝟙 S))) ∈
      (Scheme.etaleTopology.{u}.over S) (Over.mk (𝟙 S)) :=
  ofArrows_homMk_mem_etaleTopology_over 𝒰.f 𝒰.mem₀

/-! ### The presheaf of Tag 03DS as an étale sheaf of types -/

/-- **Stacks 03DT, étale case, in the underlying types.**  The presheaf of Tag 03DS of a
quasi-coherent module on `S`, read in the underlying types, is a sheaf for the étale topology on
the schemes over `S`.  This is the étale twin of
`AlgebraicGeometry.quasiCoherentPresheafForget_isSheaf_fpqc`: the fpqc statement is
`AlgebraicGeometry.isSheaf_presheafHom'` transported along
`AlgebraicGeometry.quasiCoherentPresheafIsoPresheafHom`, and the étale topology on the schemes
over `S` is coarser. -/
@[sga "4 VII 2.1" "special case"]
theorem quasiCoherentPresheafForget_isSheaf_etale (S : Scheme.{u}) (F : S.Modules)
    [F.IsQuasicoherent] :
    Presieve.IsSheaf (Scheme.etaleTopology.{u}.over S)
      (quasiCoherentPresheafFunctor S F ⋙ CategoryTheory.forget AddCommGrpCat.{u}) := by
  have hfpqc : Presieve.IsSheaf (Scheme.fpqcTopology.{u}.over S)
      (quasiCoherentPresheafFunctor S F ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
    (CategoryTheory.isSheaf_iff_isSheaf_of_type _ _).1
      ((Presheaf.isSheaf_of_iso_iff (quasiCoherentPresheafIsoPresheafHom F)).mpr
        (isSheaf_presheafHom' (Scheme.unitModule S) F))
  intro T R hR
  exact hfpqc R
    (Precoverage.toGrothendieck_mono Scheme.etalePrecoverage_le_fpqcPrecoverage T.left hR)

/-- The presheaf of Tag 03DS of a quasi-coherent module, read in the underlying types, satisfies
the sheaf condition for the family an étale cover of `S` becomes in `Over S`. -/
theorem isSheafFor_ofArrows_homMk_etale {S : Scheme.{u}} (F : S.Modules) [F.IsQuasicoherent]
    (𝒰 : S.Cover.{v} Scheme.etalePrecoverage.{u}) :
    Presieve.IsSheafFor
      (quasiCoherentPresheafFunctor S F ⋙ CategoryTheory.forget AddCommGrpCat.{u})
      (Presieve.ofArrows (fun i ↦ Over.mk (𝒰.f i))
        (fun i ↦ (Over.homMk (𝒰.f i) : Over.mk (𝒰.f i) ⟶ Over.mk (𝟙 S)))) := by
  rw [Presieve.isSheafFor_iff_generate]
  exact quasiCoherentPresheafForget_isSheaf_etale S F _
    (ofArrows_homMk_cover_mem_etaleTopology_over 𝒰)

/-- The value of the presheaf of Tag 03DS on a morphism of `Over S`, read in the underlying
types, is `AlgebraicGeometry.pullbackSectionsMap`. -/
private lemma quasiCoherentPresheafForget_map_apply {S : Scheme.{u}} (F : S.Modules)
    [F.IsQuasicoherent] {T U : Over S} (g : T ⟶ U)
    (x : Γ((Scheme.Modules.pullback U.hom).obj F, ⊤)) :
    (quasiCoherentPresheafFunctor S F ⋙ CategoryTheory.forget AddCommGrpCat.{u}).map g.op x =
      pullbackSectionsMap F g x :=
  rfl

/-! ### Restriction of a global section along a morphism to the base -/

/-- Taking global sections of `AlgebraicGeometry.Scheme.Modules.pullbackId`: the sections of the
pullback of `F` along the identity of `S` are the sections of `F`.  This is the identification
needed because the presheaf of Tag 03DS takes its value at `Over.mk (𝟙 S)`, not at `S`. -/
noncomputable def pullbackIdSectionsIso (S : Scheme.{u}) (F : S.Modules) :
    Γ((Scheme.Modules.pullback (𝟙 S)).obj F, ⊤) ≅ Γ(F, ⊤) where
  hom := ((Scheme.Modules.pullbackId S).app F).hom.app ⊤
  inv := ((Scheme.Modules.pullbackId S).app F).inv.app ⊤
  hom_inv_id :=
    congrArg (fun φ : (Scheme.Modules.pullback (𝟙 S)).obj F ⟶ (Scheme.Modules.pullback (𝟙 S)).obj F
      ↦ φ.app ⊤) (Iso.hom_inv_id ((Scheme.Modules.pullbackId S).app F))
  inv_hom_id :=
    congrArg (fun φ : F ⟶ F ↦ φ.app ⊤)
      (Iso.inv_hom_id ((Scheme.Modules.pullbackId S).app F))

/-- `AlgebraicGeometry.pullbackIdSectionsIso` followed by its inverse is the identity on
sections. -/
@[simp]
lemma pullbackIdSectionsIso_inv_hom_apply (S : Scheme.{u}) (F : S.Modules)
    (x : Γ((Scheme.Modules.pullback (𝟙 S)).obj F, ⊤)) :
    (pullbackIdSectionsIso S F).inv ((pullbackIdSectionsIso S F).hom x) = x := by
  rw [← CategoryTheory.comp_apply, Iso.hom_inv_id, CategoryTheory.id_apply]

/-- The inverse of `AlgebraicGeometry.pullbackIdSectionsIso` followed by it is the identity on
sections. -/
@[simp]
lemma pullbackIdSectionsIso_hom_inv_apply (S : Scheme.{u}) (F : S.Modules) (x : Γ(F, ⊤)) :
    (pullbackIdSectionsIso S F).hom ((pullbackIdSectionsIso S F).inv x) = x := by
  rw [← CategoryTheory.comp_apply, Iso.inv_hom_id, CategoryTheory.id_apply]

/-- The inverse of `AlgebraicGeometry.pullbackIdSectionsIso` is injective on sections. -/
private lemma pullbackIdSectionsIso_inv_injective (S : Scheme.{u}) (F : S.Modules) :
    Function.Injective (pullbackIdSectionsIso S F).inv := fun x y h ↦ by
  simpa using congrArg (pullbackIdSectionsIso S F).hom h

/-- **Restriction of a global section of `F` along a morphism `g : T ⟶ S`.**  It is the value of
the presheaf of Tag 03DS on `Over.homMk g : Over.mk g ⟶ Over.mk (𝟙 S)`, read through
`AlgebraicGeometry.pullbackIdSectionsIso`. -/
noncomputable def coverSectionsMap {S T : Scheme.{u}} (F : S.Modules) (g : T ⟶ S)
    (t : Γ(F, ⊤)) : Γ((Scheme.Modules.pullback g).obj F, ⊤) :=
  pullbackSectionsMap F (Over.homMk g : Over.mk g ⟶ Over.mk (𝟙 S))
    ((pullbackIdSectionsIso S F).inv t)

/-- Unfolding `AlgebraicGeometry.coverSectionsMap`: it is
`AlgebraicGeometry.pullbackSectionsMap` along `Over.homMk g` applied to the section read through
`AlgebraicGeometry.pullbackIdSectionsIso`. -/
lemma coverSectionsMap_apply {S T : Scheme.{u}} (F : S.Modules) (g : T ⟶ S) (t : Γ(F, ⊤)) :
    coverSectionsMap F g t =
      pullbackSectionsMap F (Over.homMk g : Over.mk g ⟶ Over.mk (𝟙 S))
        ((pullbackIdSectionsIso S F).inv t) :=
  rfl

/-! ### The pairwise fibre products of a cover, in the schemes over the base -/

/-- The fibre product `𝒰.X i ×_S 𝒰.X j` of two members of a cover, as an object of `Over S`.
Its underlying scheme is `CategoryTheory.Limits.pullback (𝒰.f i) (𝒰.f j)`. -/
noncomputable abbrev coverPair {S : Scheme.{u}}
    (𝒰 : S.Cover.{v} Scheme.etalePrecoverage.{u}) (i j : 𝒰.I₀) : Over S :=
  Over.mk (pullback.fst (𝒰.f i) (𝒰.f j) ≫ 𝒰.f i)

/-- The first projection of `AlgebraicGeometry.coverPair`, as a morphism of `Over S`. -/
noncomputable abbrev coverPairFst {S : Scheme.{u}}
    (𝒰 : S.Cover.{v} Scheme.etalePrecoverage.{u}) (i j : 𝒰.I₀) :
    coverPair 𝒰 i j ⟶ Over.mk (𝒰.f i) :=
  Over.homMk (pullback.fst (𝒰.f i) (𝒰.f j))

/-- The second projection of `AlgebraicGeometry.coverPair`, as a morphism of `Over S`. -/
noncomputable abbrev coverPairSnd {S : Scheme.{u}}
    (𝒰 : S.Cover.{v} Scheme.etalePrecoverage.{u}) (i j : 𝒰.I₀) :
    coverPair 𝒰 i j ⟶ Over.mk (𝒰.f j) :=
  Over.homMk (pullback.snd (𝒰.f i) (𝒰.f j)) pullback.condition.symm

/-- `AlgebraicGeometry.coverPair` is the fibre product of `Over.mk (𝒰.f i)` and
`Over.mk (𝒰.f j)` over `Over.mk (𝟙 S)` *in `Over S`*.  `CategoryTheory.Over.forget` creates
connected limits, so the square is a pullback as soon as its image in the schemes is, which it
is by construction. -/
lemma isPullback_coverPair {S : Scheme.{u}}
    (𝒰 : S.Cover.{v} Scheme.etalePrecoverage.{u}) (i j : 𝒰.I₀) :
    IsPullback (coverPairFst 𝒰 i j) (coverPairSnd 𝒰 i j)
      (Over.homMk (𝒰.f i) : Over.mk (𝒰.f i) ⟶ Over.mk (𝟙 S))
      (Over.homMk (𝒰.f j) : Over.mk (𝒰.f j) ⟶ Over.mk (𝟙 S)) :=
  IsPullback.of_map (Over.forget S) (by ext; exact pullback.condition)
    (IsPullback.of_hasPullback (𝒰.f i) (𝒰.f j))

/-! ### Glueing -/

/-- **Glueing global sections of a quasi-coherent module along an étale covering.**  Let `F` be a
quasi-coherent module on a scheme `S` and let `𝒰` be an étale cover of `S`.  A family of sections
`s i` of the pullbacks of `F` to the members of `𝒰` whose two restrictions to each fibre product
`𝒰.X i ×_S 𝒰.X j` agree is the family of restrictions of a unique global section of `F`.

This is `AlgebraicGeometry.quasiCoherentPresheaf_isSheaf_etale'` — Stacks 03DT for the étale
topology — made elementwise: the sheaf condition is read in the underlying types, the covering
sieve is `AlgebraicGeometry.ofArrows_homMk_cover_mem_etaleTopology_over`, and the agreement
hypothesis becomes the presieve compatibility predicate by
`CategoryTheory.Presieve.Arrows.compatible_of_isPullback` fed with
`AlgebraicGeometry.isPullback_coverPair`. -/
theorem existsUnique_glue_etale {S : Scheme.{u}} (F : S.Modules) [F.IsQuasicoherent]
    (𝒰 : S.Cover.{v} Scheme.etalePrecoverage.{u})
    (s : ∀ i, Γ((Scheme.Modules.pullback (𝒰.f i)).obj F, ⊤))
    (hs : ∀ i j, pullbackSectionsMap F (coverPairFst 𝒰 i j) (s i) =
      pullbackSectionsMap F (coverPairSnd 𝒰 i j) (s j)) :
    ∃! t : Γ(F, ⊤), ∀ i, coverSectionsMap F (𝒰.f i) t = s i := by
  have hcompat : Presieve.Arrows.Compatible
      (quasiCoherentPresheafFunctor S F ⋙ CategoryTheory.forget AddCommGrpCat.{u})
      (fun i ↦ (Over.homMk (𝒰.f i) : Over.mk (𝒰.f i) ⟶ Over.mk (𝟙 S))) s := by
    refine Presieve.Arrows.compatible_of_isPullback
      (Q := quasiCoherentPresheafFunctor S F ⋙ CategoryTheory.forget AddCommGrpCat.{u})
      (fun i ↦ (Over.homMk (𝒰.f i) : Over.mk (𝒰.f i) ⟶ Over.mk (𝟙 S)))
      (coverPairFst 𝒰) (coverPairSnd 𝒰) (isPullback_coverPair 𝒰) s fun i j ↦ ?_
    exact hs i j
  obtain ⟨t₀, ht₀, huniq⟩ :=
    (Presieve.isSheafFor_arrows_iff _ _).1 (isSheafFor_ofArrows_homMk_etale F 𝒰) s hcompat
  refine ⟨(pullbackIdSectionsIso S F).hom t₀, fun i ↦ ?_, fun t ht ↦ ?_⟩
  · refine Eq.trans ?_ (ht₀ i)
    exact congrArg (fun x : Γ((Scheme.Modules.pullback (𝟙 S)).obj F, ⊤) ↦
        pullbackSectionsMap F (Over.homMk (𝒰.f i) : Over.mk (𝒰.f i) ⟶ Over.mk (𝟙 S)) x)
      (pullbackIdSectionsIso_inv_hom_apply S F t₀)
  · refine pullbackIdSectionsIso_inv_injective S F
      ((huniq _ fun i ↦ ht i).trans (pullbackIdSectionsIso_inv_hom_apply S F t₀).symm)

/-- **Two global sections of a quasi-coherent module which agree on an étale cover are equal.**
The separatedness half of `AlgebraicGeometry.existsUnique_glue_etale`, stated on its own: it
needs no compatibility hypothesis, only the sheaf condition for the covering family. -/
theorem section_eq_of_etale_cover {S : Scheme.{u}} (F : S.Modules) [F.IsQuasicoherent]
    (𝒰 : S.Cover.{v} Scheme.etalePrecoverage.{u}) {t₁ t₂ : Γ(F, ⊤)}
    (h : ∀ i, coverSectionsMap F (𝒰.f i) t₁ = coverSectionsMap F (𝒰.f i) t₂) : t₁ = t₂ := by
  refine pullbackIdSectionsIso_inv_injective S F ?_
  refine (isSheafFor_ofArrows_homMk_etale F 𝒰).isSeparatedFor.ext ?_
  rintro T g ⟨i⟩
  exact h i

end AlgebraicGeometry

end
