  ⟨fun τ ↦ BigFppfOver.exists_isGeneratedByGlobalSectionsOfCard_iff_baseAssociatedModule Bf S hf τ
        ⟨𝓕, h𝓕⟩,
    SmallZariski.exists_isGeneratedByGlobalSectionsOfCard_iff_associatedModule Bz S hz 𝓕,
    SmallEtale.exists_isGeneratedByGlobalSectionsOfCard_iff_associatedModule Be S he ⟨𝓕, h𝓕⟩,
    fun κ ↦ SmallFlatSite.exists_isGeneratedByGlobalSectionsOfCard_iff_associatedModule Bf S hf κ
        ⟨𝓕, h𝓕⟩⟩

