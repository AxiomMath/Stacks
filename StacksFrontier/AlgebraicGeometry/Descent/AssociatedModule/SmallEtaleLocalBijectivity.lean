-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.SmallEtale

variable (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Opens of an object as objects of the site -/

/-- An open of the underlying scheme of an object of the small étale site of `S`, as an object of
that site, whose structure morphism is the open immersion followed by the structure morphism of
the object. -/
@[implicit_reducible]
public def openSubObj (T : SmallEtale B S hS) (V : T.obj.left.obj.Opens) : SmallEtale B S hS :=
  ⟨Over.mk (ObjectProperty.homMk
      (X := B.obj (V : Scheme.{u}) (BigEtaleOver.contains_opens B T.obj.left.property V))
      (Y := B.obj S hS) (V.ι ≫ T.obj.hom.hom)),
    (by
      have : Etale T.obj.hom.hom := T.property
      exact inferInstanceAs (Etale (V.ι ≫ T.obj.hom.hom)))⟩

/-- The structure morphism of `openSubObj B S hS T V` is the open immersion `V.ι` followed by the
structure morphism of `T`. -/
@[simp]
public theorem openSubObj_hom_hom (T : SmallEtale B S hS) (V : T.obj.left.obj.Opens) :
    (openSubObj B S hS T V).obj.hom.hom = V.ι ≫ T.obj.hom.hom := rfl

/-- The open immersion of an open of the underlying scheme of an object of the small étale site
of `S`, as a morphism of that site. -/
@[implicit_reducible]
public noncomputable def openSubHom (T : SmallEtale B S hS) (V : T.obj.left.obj.Opens) :
    openSubObj B S hS T V ⟶ T :=
  ObjectProperty.homMk (Over.homMk (ObjectProperty.homMk
    (X := B.obj (V : Scheme.{u}) (BigEtaleOver.contains_opens B T.obj.left.property V)) V.ι)
    (by apply ObjectProperty.hom_ext; rw [ObjectProperty.FullSubcategory.comp_hom]; rfl))

/-- The underlying morphism of schemes of `openSubHom B S hS T V` is the open immersion `V.ι`. -/
@[simp]
public theorem openSubHom_hom_left_hom (T : SmallEtale B S hS) (V : T.obj.left.obj.Opens) :
    (openSubHom B S hS T V).hom.left.hom = V.ι := rfl

/-- **The covering of an object by its affine opens lying over affine opens of `S`.**  Its index
type is the pairs of an affine open `V` of the underlying scheme of `T` and an affine open `U` of
`S` with `V ≤ T.hom⁻¹U`, and its members are the open immersions of those `V`. -/
public noncomputable def affineSubordinateCover (T : SmallEtale B S hS) :
    PreZeroHypercover.{u + 1} T where
  I₀ := ULift.{u + 1} (Σ V : T.obj.left.obj.affineOpens,
    {U : S.affineOpens // V.1 ≤ T.obj.hom.hom ⁻¹ᵁ U.1})
  X i := openSubObj B S hS T i.down.1.1
  f i := openSubHom B S hS T i.down.1.1

/-- **The affine opens lying over affine opens of `S` cover, for the small étale topology.**  The
members are open immersions and they are jointly surjective, every point of the underlying scheme
of `T` having an affine open neighbourhood mapping into an affine open of `S`; so
`AlgebraicGeometry.SmallEtale.presieve₀_mem_precoverage_of_isOpenImmersion` makes the family a
covering family, and it generates a covering sieve. -/
public theorem mem_topology_sieve₀_affineSubordinateCover (T : SmallEtale B S hS) :
    (affineSubordinateCover B S hS T).sieve₀ ∈ topology B S hS T := by
  refine Precoverage.generate_mem_toGrothendieck
    (presieve₀_mem_precoverage_of_isOpenImmersion B S hS _ (fun x => ?_)
      (fun i => inferInstanceAs (IsOpenImmersion (i.down.1.1.ι))))
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset
    (X := S) (x := T.obj.hom.hom.base x) (U := (⊤ : S.Opens)) trivial
  obtain ⟨V, hV, hxV, hVU⟩ := exists_isAffineOpen_mem_and_subset
    (X := T.obj.left.obj) (x := x) (U := T.obj.hom.hom ⁻¹ᵁ U) hxU
  exact ⟨⟨⟨⟨V, hV⟩, ⟨U, hU⟩, hVU⟩⟩, ⟨⟨x, hxV⟩, rfl⟩⟩

/-! ### Local surjectivity -/

/-- **The comparison, on a pulled-back section over an open of `S`.**  The component of
`AlgebraicGeometry.SmallEtale.sectionsComparison` at the object `U → S` of the small étale site
carries the image of a section `a` of `F` over `U` under the unit of the pullback--pushforward
adjunction to the pullback of `a` to the open subscheme `U`.  This is
`AlgebraicGeometry.SmallEtale.unit_comp_map_sectionsComparison` evaluated at `U` and applied to
`a`. -/
public theorem sectionsComparison_unit_app (F : S.Modules) [F.IsQuasicoherent] (U : S.Opens)
    (a : ((SheafOfModules.forget S.ringCatSheaf).obj F).obj (op U)) :
    (sectionsComparison B S hS F).app (op ((opensToSmallEtale B S hS).obj U))
        (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
            (structureMap B S hS).hom).unit.app
          ((SheafOfModules.forget S.ringCatSheaf).obj F)).app (op U) a) =
      pullbackSectionHom U.ι F U ⊤ (Scheme.Opens.top_le_ι_preimage le_rfl) a := by
  have h := unit_comp_map_sectionsComparison B S hS F
  have h2 := congrArg (fun k : (SheafOfModules.forget S.ringCatSheaf).obj F ⟶
      (PresheafOfModules.pushforward.{u} (structureMap B S hS).hom).obj
        (sectionsPresheafOfModules B S hS F) => PresheafOfModules.Hom.app k (op U)) h
  rw [PresheafOfModules.comp_app] at h2
  exact ConcreteCategory.congr_hom h2 a

/-- **The comparison on a generator.**  Over an object `T` of the small étale site whose
structure morphism factors through an open `U` of `S`, the component of
`AlgebraicGeometry.SmallEtale.sectionsComparison` carries the restriction to `T` of the unit's
image of a section `a` of `F` over `U` to the pullback of `a` to `T`. -/
public theorem sectionsComparison_app_map_unit (F : S.Modules) [F.IsQuasicoherent]
    {T : SmallEtale B S hS} {U : S.Opens} (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (hX : (⊤ : ((toScheme B S hS).obj T).Opens) ≤ T.obj.hom.hom ⁻¹ᵁ U)
    (a : ((SheafOfModules.forget S.ringCatSheaf).obj F).obj (op U)) :
    ModuleCat.Hom.hom ((sectionsComparison B S hS F).app (op T))
        (((PresheafOfModules.pullback.{u} (structureMap B S hS).hom).obj
          ((SheafOfModules.forget S.ringCatSheaf).obj F)).map j.op
            (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
              (structureMap B S hS).hom).unit.app
                ((SheafOfModules.forget S.ringCatSheaf).obj F)).app (op U) a)) =
      (pullbackSectionHom T.obj.hom.hom F U ⊤ hX a :
        Γ((Scheme.Modules.pullback T.obj.hom.hom).obj F, ⊤)) := by
  refine Eq.trans
    (PresheafOfModules.naturality_apply (sectionsComparison B S hS F) j.op _) ?_
  refine Eq.trans (congrArg (fun z => (sectionsPresheafOfModules B S hS F).map j.op z)
    (sectionsComparison_unit_app B S hS F U a)) ?_
  exact pullbackSectionsMap_pullbackSectionHom F ((toOver B S hS).map j) U
    (Scheme.Opens.top_le_ι_preimage le_rfl) hX a

/-- **The comparison is surjective over an affine object lying over an affine open.**  If the
underlying scheme of an object `T` of the small étale site of `S` is affine and the structure
morphism of `T` factors through an affine open `U` of `S`, then the component of
`AlgebraicGeometry.SmallEtale.sectionsComparison` at `T` is surjective: its image is a submodule
containing the pullback to `T` of every section of `F` over `U`, and those pullbacks span. -/
public theorem surjective_app_sectionsComparison (F : S.Modules) [F.IsQuasicoherent]
    {T : SmallEtale B S hS} {U : S.Opens} (hU : IsAffineOpen U)
    (hT : IsAffineOpen (⊤ : ((toScheme B S hS).obj T).Opens))
    (j : T ⟶ (opensToSmallEtale B S hS).obj U) :
    Function.Surjective (ModuleCat.Hom.hom ((sectionsComparison B S hS F).app (op T))) := by
  have hX : (⊤ : ((toScheme B S hS).obj T).Opens) ≤ T.obj.hom.hom ⁻¹ᵁ U :=
    fun x _ => BigEtaleOver.range_le_of_hom B S hS j.hom ⟨x, rfl⟩
  have hmem : ∀ a : Γ(F, U), ∃ x, ModuleCat.Hom.hom
      ((sectionsComparison B S hS F).app (op T)) x =
      (pullbackSectionHom T.obj.hom.hom F U ⊤ hX a :
        Γ((Scheme.Modules.pullback T.obj.hom.hom).obj F, ⊤)) :=
    fun a => ⟨_, sectionsComparison_app_map_unit B S hS F j hX a⟩
  let Q : Submodule Γ((toScheme B S hS).obj T, ⊤)
      Γ((Scheme.Modules.pullback T.obj.hom.hom).obj F, ⊤) :=
    { carrier := {y | ∃ x, ModuleCat.Hom.hom
        ((sectionsComparison B S hS F).app (op T)) x = y}
      add_mem' := by
        rintro y z ⟨p, hp⟩ ⟨q, hq⟩
        exact ⟨p + q, by rw [map_add, hp, hq]; rfl⟩
      zero_mem' := ⟨0, map_zero _⟩
      smul_mem' := by
        rintro c y ⟨p, hp⟩
        refine ⟨(show (structureSheaf B S hS).obj.obj (op T) from c) • p, ?_⟩
        rw [map_smul, hp]
        rfl }
  have hle : Submodule.span Γ((toScheme B S hS).obj T, ⊤)
      (Set.range fun a : Γ(F, U) =>
        pullbackSectionHom T.obj.hom.hom F U ⊤ hX a) ≤ Q :=
    Submodule.span_le.2 (by rintro z ⟨a, rfl⟩; exact hmem a)
  exact fun _ => hle ((span_pullbackSection_eq_top T.obj.hom.hom F hU hT hX).ge Submodule.mem_top)

/-- **The comparison is surjective over an affine open lying over an affine open of `S`.**  The
case of `AlgebraicGeometry.SmallEtale.surjective_app_sectionsComparison` which the members of
`AlgebraicGeometry.SmallEtale.affineSubordinateCover` fall under. -/
public theorem surjective_app_sectionsComparison_openSubObj (F : S.Modules)
    [F.IsQuasicoherent] (T : SmallEtale B S hS) {V : T.obj.left.obj.Opens}
    (hV : IsAffineOpen V) {U : S.Opens} (hU : IsAffineOpen U)
    (hVU : V ≤ T.obj.hom.hom ⁻¹ᵁ U) :
    Function.Surjective (ModuleCat.Hom.hom
      ((sectionsComparison B S hS F).app (op (openSubObj B S hS T V)))) := by
  have : _root_.AlgebraicGeometry.IsAffine V.toScheme := hV
  refine surjective_app_sectionsComparison B S hS F hU (isAffineOpen_top V.toScheme)
    (homOfRangeLe B S hS U ?_)
  rintro x ⟨y, rfl⟩
  exact hVU y.2

/-- **The comparison of Stacks 070S (2) is locally surjective for the small étale topology.**
Every section of the pullback-sections presheaf is, locally on the small étale site, in the image
of `AlgebraicGeometry.SmallEtale.sectionsComparison`: the component is already surjective over an
affine object lying over an affine open of `S`, and those objects cover by
`AlgebraicGeometry.SmallEtale.mem_topology_sieve₀_affineSubordinateCover`.

This is half of Stacks 070S (2); the other half is
`AlgebraicGeometry.SmallEtale.isLocallyInjective_sectionsComparison`. -/
public instance isLocallySurjective_sectionsComparison (F : S.Modules) [F.IsQuasicoherent] :
    Presheaf.IsLocallySurjective (topology B S hS)
      ((PresheafOfModules.toPresheaf (structureSheaf B S hS).obj).map
        (sectionsComparison B S hS F)) where
  imageSieve_mem {T} s := by
    refine (topology B S hS).superset_covering ?_
      (mem_topology_sieve₀_affineSubordinateCover B S hS T)
    rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
    intro i
    exact surjective_app_sectionsComparison_openSubObj B S hS F T i.down.1.2 i.down.2.1.2
      i.down.2.2 _

/-! ### The generators of the source of the comparison -/

/-- **The source of the comparison of Stacks 070S (2).**  The pullback, as a presheaf of modules,
of a quasi-coherent module `F` on `S` along the structure-sheaf comparison of the small étale
site; `AlgebraicGeometry.SmallEtale.associatedModuleSheafificationIso` presents the associated
module of `F` as its sheafification. -/
public noncomputable abbrev pullbackPresheaf (F : S.Modules) [F.IsQuasicoherent] :
    PresheafOfModules.{u} (structureSheaf B S hS).obj :=
  (PresheafOfModules.pullback.{u} (structureMap B S hS).hom).obj
    ((SheafOfModules.forget S.ringCatSheaf).obj F)

/-- The unit of the pullback--pushforward adjunction at a quasi-coherent module `F` on `S`.  Over
an open `U` of `S` it sends a section of `F` to a section of
`AlgebraicGeometry.SmallEtale.pullbackPresheaf` over the object `U → S` of the small étale
site. -/
public noncomputable abbrev pullbackUnit (F : S.Modules) [F.IsQuasicoherent] :
    (SheafOfModules.forget S.ringCatSheaf).obj F ⟶
      (PresheafOfModules.pushforward.{u} (structureMap B S hS).hom).obj
        (pullbackPresheaf B S hS F) :=
  (PresheafOfModules.pullbackPushforwardAdjunction.{u} (structureMap B S hS).hom).unit.app
    ((SheafOfModules.forget S.ringCatSheaf).obj F)

/-- **A generator of the source of the comparison.**  Given an object `T` of the small étale site
factoring through an open `U` of `S` by `j`, the restriction along `j` of the image under the unit
of a section `a` of `F` over `U`.  These are the elements of
`PresheafOfModules.pullbackUnitGenerators`, so by
`PresheafOfModules.span_pullbackUnitGenerators_eq_top` they span the sections of
`AlgebraicGeometry.SmallEtale.pullbackPresheaf` over `T`. -/
public noncomputable abbrev pullbackUnitSection (F : S.Modules) [F.IsQuasicoherent]
    {T : SmallEtale B S hS} {U : S.Opens} (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (a : Γ(F, U)) :
    (pullbackPresheaf B S hS F).obj (op T) :=
  (pullbackPresheaf B S hS F).map j.op ((pullbackUnit B S hS F).app (op U) a)

/-- **The scalars along which a generator is semilinear.**  Over an object `T` of the small étale
site factoring through an open `U` of `S`, restricting a function on `U` to the global functions
of the open subscheme `U` and then along `j` agrees with
`AlgebraicGeometry.Scheme.Hom.appLE` of the structure morphism of `T`. -/
public theorem structureSheaf_map_structureMap_app {T : SmallEtale B S hS} {U : S.Opens}
    (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (hX : (⊤ : ((toScheme B S hS).obj T).Opens) ≤ T.obj.hom.hom ⁻¹ᵁ U) (r : Γ(S, U)) :
    (structureSheaf B S hS).obj.map j.op ((structureMap B S hS).hom.app (op U) r) =
      T.obj.hom.hom.appLE U ⊤ hX r := by
  have hLE : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (_ : (⊤ : X.Opens) ≤ f ⁻¹ᵁ (⊤ : Y.Opens)),
      f.appLE ⊤ ⊤ ‹_› = f.appTop := fun f _ => Scheme.Hom.appLE_eq_app f
  have e₁ : (⊤ : U.toScheme.Opens) ≤ U.ι ⁻¹ᵁ U := Scheme.Opens.top_le_ι_preimage le_rfl
  have e₂ : (⊤ : ((toScheme B S hS).obj T).Opens) ≤ j.hom.left.hom ⁻¹ᵁ ⊤ := le_rfl
  have hgen : ∀ (f : ((toScheme B S hS).obj T) ⟶ S) (_ : T.obj.hom.hom = f)
      (h : (⊤ : ((toScheme B S hS).obj T).Opens) ≤ f ⁻¹ᵁ U),
      f.appLE U ⊤ h = T.obj.hom.hom.appLE U ⊤ hX := by
    rintro f rfl h
    rfl
  have key : (Scheme.Opens.topIso U).inv ≫ (j.hom.left.hom).appTop =
      T.obj.hom.hom.appLE U ⊤ hX := by
    rw [← Scheme.Opens.ι_appLE_top U e₁, ← hLE (j.hom.left.hom) e₂]
    exact (Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _).trans
      (hgen _ (BigEtaleOver.hom_hom_eq B S hS j.hom) _)
  exact (CommRingCat.comp_apply _ _ r).symm.trans (ConcreteCategory.congr_hom key r)

/-- The sections of `AlgebraicGeometry.SmallEtale.pullbackPresheaf` over an object `T` as a
module over the *commutative* ring `Γ(T, 𝒪_T)`, rather than over the `RingCat` object
`(structureSheaf B S hS).obj.obj (op T)` which carries them.  The two rings and the two module
structures are definitionally equal, but instance search does not cross the identification, and
extension of scalars needs the commutative one. -/
public noncomputable instance module_gamma_pullbackPresheaf (F : S.Modules) [F.IsQuasicoherent]
    (T : SmallEtale B S hS) :
    Module ↥Γ(T.obj.left.obj, ⊤) ↥((pullbackPresheaf B S hS F).obj (op T)) :=
  inferInstanceAs (Module ((structureSheaf B S hS).obj.obj (op T)) _)

/-- **A generator is semilinear in its section.**  Scaling the section of `F` scales the generator
by the restriction of the scalar to the object, the unit being a morphism of presheaves of
modules and restriction being semilinear over the structure sheaf. -/
public theorem pullbackUnitSection_smul (F : S.Modules) [F.IsQuasicoherent]
    {T : SmallEtale B S hS} {U : S.Opens} (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (r : Γ(S, U)) (a : Γ(F, U)) :
    pullbackUnitSection B S hS F j (r • a) =
      (structureSheaf B S hS).obj.map j.op ((structureMap B S hS).hom.app (op U) r) •
        pullbackUnitSection B S hS F j a := by
  refine Eq.trans (congrArg (fun z => (pullbackPresheaf B S hS F).map j.op z)
    (((pullbackUnit B S hS F).app (op U)).hom.map_smul r a)) ?_
  exact PresheafOfModules.map_smul (pullbackPresheaf B S hS F) j.op
    ((structureMap B S hS).hom.app (op U) r) ((pullbackUnit B S hS F).app (op U) a)

/-- The component of `AlgebraicGeometry.SmallEtale.sectionsComparison` at an object `T`, read as
a map of modules over `Γ(T, 𝒪_T)` rather than over the `RingCat` object of the structure sheaf of
the small étale site.  This is the form in which
`AlgebraicGeometry.eq_zero_of_mem_span_of_app_eq_pullbackSection` consumes it; the two module
structures are definitionally equal, so the underlying function is unchanged. -/
public noncomputable def sectionsComparisonGamma (F : S.Modules) [F.IsQuasicoherent]
    (T : SmallEtale B S hS) :
    ModuleCat.of Γ(T.obj.left.obj, ⊤) ((pullbackPresheaf B S hS F).obj (op T)) ⟶
      ModuleCat.of Γ(T.obj.left.obj, ⊤)
        Γ((Scheme.Modules.pullback T.obj.hom.hom).obj F, ⊤) :=
  ModuleCat.homEquiv.symm
    { toFun := fun x => (sectionsComparison B S hS F).app (op T) x
      map_add' := fun x y => map_add ((sectionsComparison B S hS F).app (op T)).hom x y
      map_smul' := fun c x =>
        ((sectionsComparison B S hS F).app (op T)).hom.map_smul c x }

/-- A span over the `RingCat` object of the structure sheaf of the small étale site is a span
over `Γ(T, 𝒪_T)`.  The two rings carry the same action on the same elements, so the two spans
have the same members; but they are submodules over different rings, hence different types, and
membership has to be transported. -/
public theorem mem_span_gamma_of_mem_span (F : S.Modules) [F.IsQuasicoherent]
    (T : SmallEtale B S hS) (G : Set ((pullbackPresheaf B S hS F).obj (op T)))
    {x : (pullbackPresheaf B S hS F).obj (op T)}
    (hx : x ∈ Submodule.span ((structureSheaf B S hS).obj.obj (op T)) G) :
    x ∈ Submodule.span Γ(T.obj.left.obj, ⊤) G := by
  exact Submodule.span_induction (p := fun y _ => y ∈ Submodule.span Γ(T.obj.left.obj, ⊤) G)
    (fun y hy => Submodule.subset_span hy) (Submodule.zero_mem _)
    (fun _ _ _ _ hp hq => Submodule.add_mem _ hp hq) (fun c _ _ hp => Submodule.smul_mem _ c hp)
    hx

/-- **The comparison kills nothing in the span of the generators over an affine object lying over
an affine open.**  If the underlying scheme of `T` is affine and `T` factors through an affine
open `U` of `S`, then an element of the span of the generators indexed by `U` which the component
of `AlgebraicGeometry.SmallEtale.sectionsComparison` at `T` sends to `0` is itself `0`. -/
public theorem eq_zero_of_mem_span_pullbackUnitSection (F : S.Modules) [F.IsQuasicoherent]
    {T : SmallEtale B S hS} {U : S.Opens} (hU : IsAffineOpen U)
    (hT : IsAffineOpen (⊤ : ((toScheme B S hS).obj T).Opens))
    (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    {x : (pullbackPresheaf B S hS F).obj (op T)}
    (hx : x ∈ Submodule.span ((structureSheaf B S hS).obj.obj (op T))
      (Set.range fun a : Γ(F, U) => pullbackUnitSection B S hS F j a))
    (hθ : (sectionsComparison B S hS F).app (op T) x = 0) : x = 0 := by
  have hX : (⊤ : ((toScheme B S hS).obj T).Opens) ≤ T.obj.hom.hom ⁻¹ᵁ U :=
    fun y _ => BigEtaleOver.range_le_of_hom B S hS j.hom ⟨y, rfl⟩
  refine eq_zero_of_mem_span_of_app_eq_pullbackSection T.obj.hom.hom F hU hT hX
    (N := ModuleCat.of Γ(T.obj.left.obj, ⊤) ((pullbackPresheaf B S hS F).obj (op T)))
    (fun a => pullbackUnitSection B S hS F j a) ?_ ?_
    (sectionsComparisonGamma B S hS F T) ?_
    (mem_span_gamma_of_mem_span B S hS F T _ hx) hθ
  · intro a b
    exact Eq.trans
      (congrArg (fun z => (pullbackPresheaf B S hS F).map j.op z)
        (map_add ((pullbackUnit B S hS F).app (op U)).hom a b))
      (map_add ((pullbackPresheaf B S hS F).map j.op).hom _ _)
  · intro r a
    refine Eq.trans (pullbackUnitSection_smul B S hS F j r a) ?_
    exact congrArg (fun c => c • pullbackUnitSection B S hS F j a)
      (structureSheaf_map_structureMap_app B S hS j hX r)
  · intro a
    exact (sectionsComparison_app_map_unit B S hS F j hX a).trans
      (pullbackSectionHom_apply T.obj.hom.hom F U ⊤ hX a)

/-- Restricting a generator along a morphism of the small étale site gives the generator over the
same open of `S`: there is at most one morphism to the image of an open of `S`, so the two
factorings agree. -/
public theorem pullbackUnitSection_map (F : S.Modules) [F.IsQuasicoherent]
    {T T' : SmallEtale B S hS} (g : T' ⟶ T) {U : S.Opens}
    (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (j' : T' ⟶ (opensToSmallEtale B S hS).obj U) (a : Γ(F, U)) :
    (pullbackPresheaf B S hS F).map g.op (pullbackUnitSection B S hS F j a) =
      pullbackUnitSection B S hS F j' a := by
  have hj : g ≫ j = j' := Subsingleton.elim _ _
  refine Eq.trans
    (PresheafOfModules.map_comp_apply (pullbackPresheaf B S hS F) j.op g.op _).symm ?_
  exact congrArg (fun k : T' ⟶ (opensToSmallEtale B S hS).obj U =>
    (pullbackPresheaf B S hS F).map k.op ((pullbackUnit B S hS F).app (op U) a)) hj

/-- **Shrinking the open of `S`.**  The generator indexed by a section `a` over `U` is the
generator indexed by the restriction of `a` to a smaller open `U'`, as soon as the object still
factors through `U'`: this is naturality of the unit, and again the uniqueness of the
factoring. -/
public theorem pullbackUnitSection_map_le (F : S.Modules) [F.IsQuasicoherent]
    {T : SmallEtale B S hS} {U U' : S.Opens} (h : U' ≤ U)
    (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (j' : T ⟶ (opensToSmallEtale B S hS).obj U') (a : Γ(F, U)) :
    pullbackUnitSection B S hS F j'
        (((SheafOfModules.forget S.ringCatSheaf).obj F).map (homOfLE h).op a) =
      pullbackUnitSection B S hS F j a := by
  exact Eq.trans (congrArg (fun z => (pullbackPresheaf B S hS F).map j'.op z)
    (PresheafOfModules.naturality_apply (pullbackUnit B S hS F) (homOfLE h).op a))
    (pullbackUnitSection_map B S hS F j' ((opensToSmallEtale B S hS).map (homOfLE h)) j a)

/-- The span of the generators grows as the open of `S` indexing them shrinks, by
`AlgebraicGeometry.SmallEtale.pullbackUnitSection_map_le`. -/
public theorem span_pullbackUnitSection_mono (F : S.Modules) [F.IsQuasicoherent]
    {T : SmallEtale B S hS} {U U' : S.Opens} (h : U' ≤ U)
    (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (j' : T ⟶ (opensToSmallEtale B S hS).obj U') :
    Submodule.span ((structureSheaf B S hS).obj.obj (op T))
        (Set.range fun a : Γ(F, U) => pullbackUnitSection B S hS F j a) ≤
      Submodule.span ((structureSheaf B S hS).obj.obj (op T))
        (Set.range fun a : Γ(F, U') => pullbackUnitSection B S hS F j' a) := by
  refine Submodule.span_le.2 ?_
  rintro y ⟨a, rfl⟩
  exact Submodule.subset_span ⟨_, pullbackUnitSection_map_le B S hS F h j j' a⟩

/-- Restriction along a morphism of the small étale site carries the span of the generators
indexed by an open of `S` into the span of the generators indexed by the same open. -/
public theorem map_mem_span_pullbackUnitSection (F : S.Modules) [F.IsQuasicoherent]
    {T T' : SmallEtale B S hS} (g : T' ⟶ T) {U : S.Opens}
    (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (j' : T' ⟶ (opensToSmallEtale B S hS).obj U)
    {z : (pullbackPresheaf B S hS F).obj (op T)}
    (hz : z ∈ Submodule.span ((structureSheaf B S hS).obj.obj (op T))
      (Set.range fun a : Γ(F, U) => pullbackUnitSection B S hS F j a)) :
    (pullbackPresheaf B S hS F).map g.op z ∈
      Submodule.span ((structureSheaf B S hS).obj.obj (op T'))
        (Set.range fun a : Γ(F, U) => pullbackUnitSection B S hS F j' a) := by
  refine Submodule.span_induction
    (p := fun y _ => (pullbackPresheaf B S hS F).map g.op y ∈
      Submodule.span ((structureSheaf B S hS).obj.obj (op T'))
        (Set.range fun a : Γ(F, U) => pullbackUnitSection B S hS F j' a)) ?_ ?_ ?_ ?_ hz
  · rintro y ⟨a, rfl⟩
    exact Submodule.subset_span ⟨a, (pullbackUnitSection_map B S hS F g j j' a).symm⟩
  · rw [map_zero]
    exact Submodule.zero_mem _
  · intro p q _ _ hp hq
    rw [map_add]
    exact Submodule.add_mem _ hp hq
  · intro c p _ hp
    rw [PresheafOfModules.map_smul]
    exact Submodule.smul_mem _ _ hp

/-- **Every section of the pullback is a combination of generators over one open of `S`.**
`PresheafOfModules.span_pullbackUnitGenerators_eq_top` writes a section as a combination of
generators indexed by finitely many, possibly different, opens of `S`.  The opens through which
the object factors are closed under intersection — `AlgebraicGeometry.SmallEtale.homOfRangeLe`
provides the factoring through the intersection — and shrinking the open only enlarges the span,
by `AlgebraicGeometry.SmallEtale.span_pullbackUnitSection_mono`; so the sections admitting such a
description form a submodule, and one open suffices for all of them. -/
public theorem exists_mem_span_pullbackUnitSection (F : S.Modules) [F.IsQuasicoherent]
    (T : SmallEtale B S hS) (x : (pullbackPresheaf B S hS F).obj (op T)) :
    ∃ (W : S.Opens) (g : T ⟶ (opensToSmallEtale B S hS).obj W),
      x ∈ Submodule.span ((structureSheaf B S hS).obj.obj (op T))
        (Set.range fun a : Γ(F, W) => pullbackUnitSection B S hS F g a) := by
  have htop := PresheafOfModules.span_pullbackUnitGenerators_eq_top
    (structureMap B S hS).hom ((SheafOfModules.forget S.ringCatSheaf).obj F) (op T)
  refine Submodule.span_induction
    (p := fun y _ => ∃ (W : S.Opens) (g : T ⟶ (opensToSmallEtale B S hS).obj W),
      y ∈ Submodule.span ((structureSheaf B S hS).obj.obj (op T))
        (Set.range fun a : Γ(F, W) => pullbackUnitSection B S hS F g a))
    ?_ ?_ ?_ ?_ (htop.ge Submodule.mem_top)
  · rintro y ⟨W, g, a, rfl⟩
    exact ⟨W, g, Submodule.subset_span ⟨a, rfl⟩⟩
  · exact ⟨⊤, homOfRangeLe B S hS ⊤ (by simp), Submodule.zero_mem _⟩
  · rintro y z _ _ ⟨W₁, g₁, hy⟩ ⟨W₂, g₂, hz⟩
    have hr : Set.range ⇑T.obj.hom.hom ⊆ ((W₁ ⊓ W₂ : S.Opens) : Set S) :=
      Set.subset_inter (BigEtaleOver.range_le_of_hom B S hS g₁.hom)
        (BigEtaleOver.range_le_of_hom B S hS g₂.hom)
    exact ⟨W₁ ⊓ W₂, homOfRangeLe B S hS (W₁ ⊓ W₂) hr, Submodule.add_mem _
      (span_pullbackUnitSection_mono B S hS F inf_le_left g₁ _ hy)
      (span_pullbackUnitSection_mono B S hS F inf_le_right g₂ _ hz)⟩
  · rintro c y _ ⟨W, g, hy⟩
    exact ⟨W, g, Submodule.smul_mem _ c hy⟩

/-! ### Local injectivity -/

/-- **The covering of an object by its affine opens lying over affine opens inside a given open
of `S`.**  The refinement of `AlgebraicGeometry.SmallEtale.affineSubordinateCover` subordinate to
an open `W` of `S`: its index type is the pairs of an affine open `V` of the underlying scheme of
`T` and an affine open `U ≤ W` of `S` with `V ≤ T.hom⁻¹U`, and its members are the open
immersions of those `V`. -/
public noncomputable def affineSubordinateCoverOver (T : SmallEtale B S hS) (W : S.Opens) :
    PreZeroHypercover.{u + 1} T where
  I₀ := ULift.{u + 1} (Σ V : T.obj.left.obj.affineOpens,
    {U : S.affineOpens // U.1 ≤ W ∧ V.1 ≤ T.obj.hom.hom ⁻¹ᵁ U.1})
  X i := openSubObj B S hS T i.down.1.1
  f i := openSubHom B S hS T i.down.1.1

/-- **The affine opens lying over affine opens inside `W` cover, for the small étale topology**,
provided the structure morphism of `T` has range inside `W`.  As for
`AlgebraicGeometry.SmallEtale.mem_topology_sieve₀_affineSubordinateCover`: the members are open
immersions, and they are jointly surjective because a point of `T` maps into `W`, hence into an
affine open of `S` inside `W`, and then has an affine open neighbourhood in the preimage of that
one. -/
public theorem mem_topology_sieve₀_affineSubordinateCoverOver (T : SmallEtale B S hS)
    (W : S.Opens) (hW : Set.range ⇑T.obj.hom.hom ⊆ (W : Set S)) :
    (affineSubordinateCoverOver B S hS T W).sieve₀ ∈ topology B S hS T := by
  refine Precoverage.generate_mem_toGrothendieck
    (presieve₀_mem_precoverage_of_isOpenImmersion B S hS _ (fun x => ?_)
      (fun i => inferInstanceAs (IsOpenImmersion (i.down.1.1.ι))))
  obtain ⟨U, hU, hxU, hUW⟩ := exists_isAffineOpen_mem_and_subset
    (X := S) (x := T.obj.hom.hom.base x) (U := W) (hW ⟨x, rfl⟩)
  obtain ⟨V, hV, hxV, hVU⟩ := exists_isAffineOpen_mem_and_subset
    (X := T.obj.left.obj) (x := x) (U := T.obj.hom.hom ⁻¹ᵁ U) hxU
  exact ⟨⟨⟨⟨V, hV⟩, ⟨U, hU⟩, hUW, hVU⟩⟩, ⟨⟨x, hxV⟩, rfl⟩⟩

/-- **The comparison of Stacks 070S (2) is locally injective for the small étale topology.**  Two
sections of the pullback with the same image under
`AlgebraicGeometry.SmallEtale.sectionsComparison` agree locally on the small étale site.

This is the other half of Stacks 070S (2); the locally surjective half is
`AlgebraicGeometry.SmallEtale.isLocallySurjective_sectionsComparison`. -/
public instance isLocallyInjective_sectionsComparison (F : S.Modules) [F.IsQuasicoherent] :
    Presheaf.IsLocallyInjective (topology B S hS)
      ((PresheafOfModules.toPresheaf (structureSheaf B S hS).obj).map
        (sectionsComparison B S hS F)) where
  equalizerSieve_mem {Zop} x y h := by
    have h' : (sectionsComparison B S hS F).app Zop
          (x : (pullbackPresheaf B S hS F).obj Zop) =
        (sectionsComparison B S hS F).app Zop
          (y : (pullbackPresheaf B S hS F).obj Zop) := h
    have hxy : (sectionsComparison B S hS F).app Zop
        ((x : (pullbackPresheaf B S hS F).obj Zop) - y) = 0 :=
      (map_sub ((sectionsComparison B S hS F).app Zop).hom
        (x : (pullbackPresheaf B S hS F).obj Zop) y).trans (sub_eq_zero_of_eq h')
    obtain ⟨W, g, hp⟩ := exists_mem_span_pullbackUnitSection B S hS F Zop.unop
      ((x : (pullbackPresheaf B S hS F).obj Zop) - y)
    refine (topology B S hS).superset_covering ?_
      (mem_topology_sieve₀_affineSubordinateCoverOver B S hS Zop.unop W
        (BigEtaleOver.range_le_of_hom B S hS g.hom))
    rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
    intro i
    obtain ⟨⟨⟨V, hV⟩, ⟨U, hU⟩, hUW, hVU⟩⟩ := i
    have hVaff : _root_.AlgebraicGeometry.IsAffine V.toScheme := hV
    have hr : Set.range ⇑(openSubObj B S hS (unop Zop) V).obj.hom.hom ⊆ (U : Set S) := by
      rintro z ⟨w, rfl⟩
      exact hVU w.2
    have hzero : (pullbackPresheaf B S hS F).map
        (openSubHom B S hS (unop Zop) V).op
          ((x : (pullbackPresheaf B S hS F).obj Zop) - y) = 0 := by
      refine eq_zero_of_mem_span_pullbackUnitSection B S hS F hU
        (isAffineOpen_top V.toScheme) (homOfRangeLe B S hS U hr) ?_ ?_
      · refine span_pullbackUnitSection_mono B S hS F hUW
          (openSubHom B S hS (unop Zop) V ≫ g) _ ?_
        exact map_mem_span_pullbackUnitSection B S hS F
          (openSubHom B S hS (unop Zop) V) g _ hp
      · refine Eq.trans (PresheafOfModules.naturality_apply (sectionsComparison B S hS F)
          (openSubHom B S hS (unop Zop) V).op _) ?_
        exact (congrArg (fun z => (sectionsPresheafOfModules B S hS F).map
          (openSubHom B S hS (unop Zop) V).op z) hxy).trans (map_zero _)
    exact sub_eq_zero.1 ((map_sub ((pullbackPresheaf B S hS F).map
      (openSubHom B S hS (unop Zop) V).op).hom
      (x : (pullbackPresheaf B S hS F).obj Zop) y).symm.trans hzero)

/-! ### Stacks 070S (2), and the small étale half of Stacks 0GN7 -/

/-- **Stacks 070S part (2) for `S_étale`, with no hypothesis**: the sheafification, for the small
étale topology, of `AlgebraicGeometry.SmallEtale.sectionsComparison` is an isomorphism at every
quasi-coherent `𝓕`. -/
public theorem isIso_sheafification_map_sectionsComparison (F : S.Modules)
    [F.IsQuasicoherent] :
    IsIso ((PresheafOfModules.sheafification.{u} (𝟙 (structureSheaf B S hS).obj)).map
      (sectionsComparison B S hS F)) := by
  have hW : (topology B S hS).W
      ((PresheafOfModules.toPresheaf (structureSheaf B S hS).obj).map
        (sectionsComparison B S hS F)) :=
    GrothendieckTopology.W_of_isLocallyBijective _ _
  rw [GrothendieckTopology.W_iff] at hW
  exact (isIso_iff_of_reflects_iso
    ((PresheafOfModules.sheafification.{u} (𝟙 (structureSheaf B S hS).obj)).map
      (sectionsComparison B S hS F))
    (SheafOfModules.toSheaf (structureSheaf B S hS))).1 hW

/-- **Stacks 070S part (2) for `S_étale`**: the hypothesis
`AlgebraicGeometry.SmallEtale.SectionsComparisonSheafifiesToIso` holds. -/
@[stacks 070S "part (2), small site at τ = étale"]
public theorem sectionsComparisonSheafifiesToIso :
    SectionsComparisonSheafifiesToIso B S hS :=
  fun F _ => isIso_sheafification_map_sectionsComparison B S hS F

/-- **The unit of the associated-module adjunction of the small étale site is an isomorphism at
every quasi-coherent `𝒪_S`-module, with no hypothesis**: the hypothesis
`AlgebraicGeometry.SmallEtale.UnitIsoOnQuasicoherent` holds. -/
public theorem unitIsoOnQuasicoherent : UnitIsoOnQuasicoherent B S hS :=
  unitIsoOnQuasicoherent_of_sectionsComparison B S hS
    (sectionsComparisonSheafifiesToIso B S hS)

/-- **The small étale half of Stacks 0GN7 and of Stacks 06VE (1), the fullness half, with no
hypothesis.** -/
public instance full_associatedModuleQcoh' : (associatedModuleQcoh B S hS).Full :=
  full_associatedModuleQcoh B S hS (unitIsoOnQuasicoherent B S hS)

/-- **The small étale half of Stacks 0GN7 and of Stacks 06VE (1), the faithfulness half, with no
hypothesis.** -/
public instance faithful_associatedModuleQcoh' : (associatedModuleQcoh B S hS).Faithful :=
  faithful_associatedModuleQcoh B S hS (unitIsoOnQuasicoherent B S hS)

/-- **The small étale half of Stacks 0GN7 and of Stacks 06VE (1), with no hypothesis at all**:
the functor `𝓕 ↦ 𝓕^a` of Definition 03DU (4) at `τ = étale`, from the quasi-coherent
`𝒪_S`-modules to the `𝒪`-modules on `S_étale`, is fully faithful. -/
@[stacks 0GN7 "small site at τ = étale", stacks 06VE "part (1), small site at τ = étale"]
public noncomputable def fullyFaithfulAssociatedModuleQcoh' :
    (associatedModuleQcoh B S hS).FullyFaithful :=
  fullyFaithfulAssociatedModuleQcoh B S hS (unitIsoOnQuasicoherent B S hS)

/-! ### The sections description of `𝓕^a` -/

/-- The pullback-sections presheaf of Stacks 03DS on the small étale site of `S`, packaged as a
sheaf of modules: it is one by
`AlgebraicGeometry.SmallEtale.isSheaf_sectionsPresheafOfModules`, Stacks 03DT. -/
public noncomputable def sectionsSheafOfModules' (F : S.Modules) [F.IsQuasicoherent] :
    SheafOfModules.{u} (structureSheaf B S hS) where
  val := sectionsPresheafOfModules B S hS F
  isSheaf := isSheaf_sectionsPresheafOfModules B S hS F

/-- **The sections description of the associated module on the small étale site, with no
hypothesis**: for a quasi-coherent `𝒪_S`-module `𝓕`, the associated module `𝓕^a` of Stacks
Definition 03DU (4) *is* the sections sheaf `(f : T → S) ↦ Γ(T, f^*𝓕)` of Stacks 03DS. -/
public noncomputable def associatedModuleIsoSectionsSheafOfModules' (F : S.Modules)
    [F.IsQuasicoherent] :
    (associatedModule B S hS).obj F ≅ sectionsSheafOfModules' B S hS F :=
  (associatedModuleSheafificationIso B S hS).app F ≪≫
    @asIso _ _ _ _ ((PresheafOfModules.sheafification.{u}
        (𝟙 (structureSheaf B S hS).obj)).map (sectionsComparison B S hS F))
      (isIso_sheafification_map_sectionsComparison B S hS F) ≪≫
    (asIso (PresheafOfModules.sheafificationAdjunction.{u}
      (𝟙 (structureSheaf B S hS).obj)).counit).app (sectionsSheafOfModules' B S hS F)

/-- The sections of `𝓕^a` over an object `T ⟶ S` of the small étale site are the sections of the
pullback of `𝓕` to `T`, by
`AlgebraicGeometry.SmallEtale.associatedModuleIsoSectionsSheafOfModules'` read at `T`. -/
public noncomputable def associatedModuleObjIsoSections (F : S.Modules) [F.IsQuasicoherent]
    (T : (SmallEtale B S hS)ᵒᵖ) :
    ((associatedModule B S hS).obj F).val.obj T ≅
      (sectionsPresheafOfModules B S hS F).obj T :=
  ((SheafOfModules.forget (structureSheaf B S hS) ⋙
    PresheafOfModules.evaluation (structureSheaf B S hS).obj T).mapIso
      (associatedModuleIsoSectionsSheafOfModules' B S hS F))

end AlgebraicGeometry.SmallEtale

end
