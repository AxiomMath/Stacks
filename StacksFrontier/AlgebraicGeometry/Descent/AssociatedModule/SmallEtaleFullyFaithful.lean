@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.SmallEtale

variable (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Quasi-compact objects of the small étale site -/

/-! `AlgebraicGeometry.SmallEtale.etale_toScheme_map` — every morphism of the small étale site is
étale — is `StacksFrontier.AlgebraicGeometry.Etale.SupportSections`, where it is a theorem.  It is
registered as an instance here because `isQuasiCompactObject_of_compactSpace` below reaches it
only through the synthesis of `AlgebraicGeometry.UniversallyOpen`. -/
attribute [instance] etale_toScheme_map

/-- **A jointly surjective family of the small étale site of `S` is a covering family.**  Its
members are étale by `AlgebraicGeometry.SmallEtale.etale_toScheme_map`, so the family is an étale
covering family of the ambient category of schemes; it then has a combinatorially equivalent
*selected* representative, and combinatorially equivalent families generate the same presieve,
the representative being pulled back through the two full inclusions
`S_étale ⊆ (Sch/S)_étale ⊆ Sch_étale`.

This is `AlgebraicGeometry.SmallEtale.presieve₀_mem_precoverage_of_isOpenImmersion` with the
open-immersion hypothesis removed; see the implementation notes. -/
public theorem presieve₀_mem_precoverage_of_jointlySurjective {X : SmallEtale B S hS}
    (E : PreZeroHypercover.{u + 1} X)
    (hsurj : ∀ x : ↥((toScheme B S hS).obj X),
      ∃ i, x ∈ Set.range ⇑((E.map (toScheme B S hS)).f i)) :
    E.presieve₀ ∈ precoverage B S hS X := by
  have hsmall : precoverage B S hS
      = (BigEtaleOver.precoverage B S hS).comap (inclusion B S hS) :=
    smallEtale_precoverage_eq_comap B (B.obj S hS)
  have hbig : BigEtaleOver.precoverage B S hS
      = B.precoverage.comap (Over.forget (B.obj S hS)) :=
    bigEtaleOver_precoverage_eq_comap B S hS
  rw [hsmall, Precoverage.mem_comap_iff, hbig, Precoverage.mem_comap_iff,
    ← PreZeroHypercover.presieve₀_map, ← PreZeroHypercover.presieve₀_map,
    BigEtaleSite.mem_precoverage_iff]
  have het : IsEtaleCovering (κ := B.cutoff)
      ⟨_, (E.map (inclusion B S hS)).map (Over.forget (B.obj S hS))⟩ :=
    (Scheme.presieve₀_mem_precoverage_iff _).mpr
      ⟨fun x => hsurj x, fun i => etale_toScheme_map B S hS (E.f i)⟩
  obtain ⟨W, hW, hcomb⟩ := B.exists_covering_rep _ het
  obtain ⟨W₀, F⟩ := W
  obtain ⟨hobj, hce⟩ := hcomb
  cases hobj
  dsimp only at hce
  exact ⟨F, PreZeroHypercover.presieve₀_eq_of_combinatoriallyEquivalent hce, hW⟩

/-- **A covering sieve of the small étale site of `S` contains a covering family.**  The chosen
families satisfy the site axioms by `AlgebraicGeometry.SmallEtale.isSite`, and the topology is
generated by them, so this is the generic `exists_isCovering_sieve₀_le`. -/
public theorem exists_isCovering_sieve₀_le {X : SmallEtale B S hS} {R : Sieve X}
    (hR : R ∈ topology B S hS X) :
    ∃ E : PreZeroHypercover.{u + 1} X, IsCovering B S hS ⟨X, E⟩ ∧ E.sieve₀ ≤ R :=
  _root_.exists_isCovering_sieve₀_le (SmallEtale.isSite B S hS) (fun _ _ => Iff.rfl) hR

/-- The morphisms of a covering family of the small étale site of `S` are jointly surjective:
that is half of what membership in the étale precoverage of all schemes says. -/
public theorem jointlySurjective_of_isCovering {X : SmallEtale B S hS}
    {E : PreZeroHypercover.{u + 1} X} (hE : IsCovering B S hS ⟨X, E⟩) :
    ∀ x : ↥((toScheme B S hS).obj X),
      ∃ i, x ∈ Set.range ⇑((E.map (toScheme B S hS)).f i) :=
  ((Scheme.presieve₀_mem_precoverage_iff _).mp hE.1).1

/-- **Stacks 090H for the small étale site of `S`**: an object whose underlying scheme is
quasi-compact is a quasi-compact object of the site.

Every covering sieve of `X` contains a covering family; the members of that family are étale,
hence open maps, and jointly surjective, so finitely many of their images already cover the
quasi-compact `X`, and the finite subfamily they form is again a covering family and refines the
given covering through finitely many of its members.

Unlike `AlgebraicGeometry.BigFppfOver.isQuasiCompactObject_of_compactSpace` this is not the
localized case of a statement about the ambient category: the small étale site is not a
localization.  The cardinality bound on covering families, which is what the finite subfamily
need not satisfy as it stands, is absorbed by
`AlgebraicGeometry.SmallEtale.presieve₀_mem_precoverage_of_jointlySurjective`. -/
public theorem isQuasiCompactObject_of_compactSpace (X : SmallEtale B S hS)
    (hX : CompactSpace ((toScheme B S hS).obj X)) :
    (topology B S hS).IsQuasiCompactObject X := by
  classical
  intro 𝒰 h𝒰
  obtain ⟨E, hE, hle⟩ := exists_isCovering_sieve₀_le B S hS h𝒰
  have hsurj := jointlySurjective_of_isCovering B S hS hE
  obtain ⟨T, hT⟩ := (@isCompact_univ _ _ hX).elim_finite_subcover
    (fun i : E.I₀ => Set.range ⇑((toScheme B S hS).map (E.f i)))
    (fun i => (Scheme.Hom.isOpenMap ((toScheme B S hS).map (E.f i))).isOpen_range)
    (fun x _ => Set.mem_iUnion.mpr (hsurj x))
  choose s α hα using fun c : ↥T =>
    (Sieve.mem_ofArrows_iff _ _ _).1 (hle _ (E.sieve₀_f ↑c))
  refine ⟨{ I₀ := ↥T, X := fun i => E.X ↑i, f := fun i => E.f ↑i },
    { s₀ := s, h₀ := α, w₀ := fun c => (hα c).symm }, ?_, Set.finite_range s⟩
  refine Precoverage.generate_mem_toGrothendieck
    (presieve₀_mem_precoverage_of_jointlySurjective B S hS _ (fun x => ?_))
  obtain ⟨i, hi, hx⟩ := Set.mem_iUnion₂.mp (hT (Set.mem_univ x))
  exact ⟨⟨i, hi⟩, hx⟩

/-- An affine open of `S`, as an object of the small étale site of `S`, is a quasi-compact object
of that site: its underlying scheme is affine, hence a quasi-compact space. -/
public theorem isQuasiCompactObject_opensObj_affineOpen (U : S.affineOpens) :
    (topology B S hS).IsQuasiCompactObject ((opensToSmallEtale B S hS).obj U.1) :=
  isQuasiCompactObject_of_compactSpace B S hS _
    (inferInstanceAs (CompactSpace ↥((U.1 : Scheme.{u}))))

/-! ### The unit at a free module -/

/-- The comparison of structure sheaves along the inclusion of the small Zariski site of `S` into
the small étale site is an isomorphism at every open of `S`: over `U` it is the identification of
the sections of `𝒪_S` over `U` with the global functions of the open subscheme `U`. -/
public theorem isIso_structureMap_hom_app (U : (S.Opens)ᵒᵖ) :
    IsIso ((structureMap B S hS).hom.app U) := by
  rw [structureMap_hom_app]
  exact Functor.map_isIso _ _

/-- **The unit of the associated-module adjunction of the small étale site is an isomorphism at a
free module**, for an arbitrary scheme `S`.

Both sides are Zariski sheaves on `S`, and over an affine open `U` the unit is an isomorphism by
`SheafOfModules.isIso_toSheaf_map_unit_app_free_app`: `U` is a quasi-compact object of the small
Zariski site, `U` viewed in the small étale site is a quasi-compact object there, and the
comparison of structure sheaves is an isomorphism at `U`.  The affine opens are a basis, so the
unit is an isomorphism. -/
public theorem isIso_unit_app_free (I : Type u) :
    IsIso ((associatedModuleAdjunction B S hS).unit.app
      (SheafOfModules.free (R := S.ringCatSheaf) I)) :=
  Scheme.Modules.isIso_of_isIso_app_affineOpens _ fun U =>
    SheafOfModules.isIso_toSheaf_map_unit_app_free_app (structureMap B S hS) U.1
      (Stacks.SheafOfModules.isQuasiCompactObject_of_isCompact (X := TopCat.of ↥S) U.1
        (by simpa using U.2.isCompact))
      (isQuasiCompactObject_opensObj_affineOpen B S hS U)
      (isIso_structureMap_hom_app B S hS (op U.1)) I

/-- **Stacks 06VE (1) on the small étale site, with free target.**  For every `𝒪_S`-module `𝓕`
and every type `I`, the map `Hom(𝓕, ⊕_I 𝒪_S) ⟶ Hom(𝓕^a, ⊕_I 𝒪)` given by `β ↦ β^a` is bijective,
where `𝓕^a` is taken on the small étale site.

This is full faithfulness of the small-site functor at every pair whose second entry is free,
with no quasi-coherence or quasi-compactness hypothesis anywhere. -/
public theorem bijective_associatedModule_map_free (M : S.Modules) (I : Type u) :
    Function.Bijective (fun β : M ⟶ SheafOfModules.free (R := S.ringCatSheaf) I =>
      (associatedModule B S hS).map β) :=
  (associatedModuleAdjunction B S hS).bijective_map_of_isIso_unit_app M
    (isIso_unit_app_free B S hS I)

/-! ### Full faithfulness on the quasi-coherent modules -/

/-- **The small-site half of Stacks 0GN7 and of Stacks 06VE (1) at `τ = étale`**, as a
hypothesis: the unit `𝓕 ⟶ (𝓕^a)|_{S_Zar}` of the associated-module adjunction of the small étale
site is an isomorphism at every quasi-coherent `𝒪_S`-module.

By `AlgebraicGeometry.SmallEtale.isIso_unit_app_free` it holds at every free module; what it asks
for beyond that is the sections description of `𝓕^a` on `S_étale`, Stacks 070S (2).  It is named
here, in the style of `AlgebraicGeometry.BigFppfOver.UnitIsoOnQuasicoherent`, so that the results
below can be read against the source and so that the attributes can be placed with no change to
any proof as soon as it is discharged. -/
public abbrev UnitIsoOnQuasicoherent : Prop :=
  ∀ M : (SheafOfModules.isQuasicoherent S.ringCatSheaf).FullSubcategory,
    IsIso ((associatedModuleAdjunction B S hS).unit.app M.obj)

/-- **The fullness half of the small-site statement**, over
`AlgebraicGeometry.SmallEtale.UnitIsoOnQuasicoherent`. -/
public theorem full_associatedModuleQcoh (h : UnitIsoOnQuasicoherent B S hS) :
    (associatedModuleQcoh B S hS).Full :=
  (associatedModuleAdjunction B S hS).full_comp_L_of_isIso_unit_app
    (SheafOfModules.isQuasicoherent S.ringCatSheaf).ι (ObjectProperty.full_ι _) h

/-- **The faithfulness half of the small-site statement**, over
`AlgebraicGeometry.SmallEtale.UnitIsoOnQuasicoherent` — of which only the weaker statement that
the unit is a monomorphism at the quasi-coherent modules is used. -/
public theorem faithful_associatedModuleQcoh (h : UnitIsoOnQuasicoherent B S hS) :
    (associatedModuleQcoh B S hS).Faithful :=
  (associatedModuleAdjunction B S hS).faithful_comp_L_of_mono_unit_app
    (SheafOfModules.isQuasicoherent S.ringCatSheaf).ι (ObjectProperty.faithful_ι _) fun M => by
      have := h M
      exact inferInstanceAs
        (Mono ((associatedModuleAdjunction B S hS).unit.app M.obj))

/-- **Stacks 0GN7 and Stacks 06VE (1) for the small étale site**, over
`AlgebraicGeometry.SmallEtale.UnitIsoOnQuasicoherent`: the functor `𝓕 ↦ 𝓕^a` of Definition
03DU (4) at `τ = étale`, from the quasi-coherent `𝒪_S`-modules to the `𝒪`-modules on `S_étale`,
is fully faithful.

No attribute sits here, and that is not a judgement about the mathematics: the hypothesis is
part of the citation.  What discharges it is named in the implementation notes of
this module. -/
public noncomputable def fullyFaithfulAssociatedModuleQcoh (h : UnitIsoOnQuasicoherent B S hS) :
    (associatedModuleQcoh B S hS).FullyFaithful :=
  have := full_associatedModuleQcoh B S hS h
  have := faithful_associatedModuleQcoh B S hS h
  .ofFullyFaithful _

/-! ### The residue, as one statement -/

/-- **Stacks 070S part (2) for `S_étale`**, named: the sheafification, for the small étale
topology, of the comparison from the presheaf-level pullback of `𝓕` along
`AlgebraicGeometry.SmallEtale.structureMap` to the pullback-sections presheaf of Stacks 03DS is
an isomorphism at every quasi-coherent `𝓕`.

This is the *whole* of what the small-site halves of Stacks 0GN7 and of Stacks 06VE (1) need
beyond this file.  The big-site statement is Stacks 070S part (1), which is proved at every `τ`
and tagged, on `AlgebraicGeometry.BigFppfOver.baseAssociatedModuleIsoSections`; what makes it
true there is local bijectivity of the comparison,
`AlgebraicGeometry.BigFppfOver.isLocallySurjective_sectionsComparison_baseOverTopology` and
`AlgebraicGeometry.BigFppfOver.isLocallyInjective_sectionsComparison_baseOverTopology`.  The
small étale analogue of that pair is
`AlgebraicGeometry.SmallEtale.isLocallySurjective_sectionsComparison` and
`AlgebraicGeometry.SmallEtale.isLocallyInjective_sectionsComparison`, in
`StacksFrontier.AlgebraicGeometry.Descent.AssociatedModule.SmallEtaleLocalBijectivity`, where this
proposition is discharged as the theorem
`AlgebraicGeometry.SmallEtale.sectionsComparisonSheafifiesToIso`.  Everything else on the route
is upstream: `AlgebraicGeometry.SmallEtale.isIso_sectionsUnit` and
`AlgebraicGeometry.SmallEtale.isSheaf_sectionsPresheafOfModules`, the latter being Stacks 03DT on
the small étale site with no hypothesis.

This proposition quantifies over the quasi-coherent modules, which is all the full-faithfulness
chain needs; the clause of 070S (2) is proved at the source's generality, with no hypothesis on
`𝓕`, by `AlgebraicGeometry.SmallEtale.isIso_sheafification_map_sectionsComparison`, which is
where the tag sits. -/
public abbrev SectionsComparisonSheafifiesToIso : Prop :=
  ∀ (F : S.Modules) [F.IsQuasicoherent],
    IsIso ((PresheafOfModules.sheafification.{u}
      (𝟙 (structureSheaf B S hS).obj)).map (sectionsComparison B S hS F))

/-- **`AlgebraicGeometry.SmallEtale.UnitIsoOnQuasicoherent` follows from Stacks 070S (2) alone.**
The other two inputs of the unit argument are discharged in
`StacksFrontier.AlgebraicGeometry.Descent.AssociatedModule.SmallEtaleSectionsComparison`, so this is
`AlgebraicGeometry.SmallEtale.isIso_unit_app_of_isIso_sheafification_sectionsComparison` read at
each object of the full subcategory of quasi-coherent modules. -/
public theorem unitIsoOnQuasicoherent_of_sectionsComparison
    (h : SectionsComparisonSheafifiesToIso B S hS) : UnitIsoOnQuasicoherent B S hS := fun M => by
  have : M.obj.IsQuasicoherent := M.property
  exact isIso_unit_app_of_isIso_sheafification_sectionsComparison B S hS M.obj (h M.obj)

/-- **Stacks 0GN7 and Stacks 06VE (1) for the small étale site, over Stacks 070S (2) alone.**
The functor `𝓕 ↦ 𝓕^a` of Definition 03DU (4) at `τ = étale`, from the quasi-coherent
`𝒪_S`-modules to the `𝒪`-modules on `S_étale`, is fully faithful as soon as the sheafified
comparison of `AlgebraicGeometry.SmallEtale.SectionsComparisonSheafifiesToIso` is an isomorphism.

This is the sharpest hypothesis-carrying form of the small-site half of the two tags that the
library supports, and it is untagged for the same reason as everything above it: R56, a hypothesis
is part of a citation. -/
public noncomputable def fullyFaithfulAssociatedModuleQcoh_of_sectionsComparison
    (h : SectionsComparisonSheafifiesToIso B S hS) :
    (associatedModuleQcoh B S hS).FullyFaithful :=
  fullyFaithfulAssociatedModuleQcoh B S hS
    (unitIsoOnQuasicoherent_of_sectionsComparison B S hS h)

