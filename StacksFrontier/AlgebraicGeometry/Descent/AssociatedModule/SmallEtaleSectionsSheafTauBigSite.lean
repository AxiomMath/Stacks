section Kappa

variable (T : BigFppfOver B S hS)

/-- The functor presenting `i_T` of Stacks 021F, on the big `τ`-site. -/
public abbrev smallEtaleOverFunctor :
    SmallEtale B.toBigEtaleSite T.left.obj T.left.property ⥤ BigFppfOver B S hS :=
  SmallEtale.smallEtaleToBigOver B.toBigEtaleSite S hS T

/-- `i_T^{-1}𝒪 = 𝒪` on the big `τ`-site: the identity. -/
public def smallEtaleOverRingMap :
    (SmallEtale.structureSheaf B.toBigEtaleSite T.left.obj T.left.property).obj ⟶
      (smallEtaleOverFunctor B S hS T).op ⋙ (FibredSite.baseRingStructureSheaf B S hS τ).obj :=
  𝟙 _

/-- The projection `T ×_S V / S ⟶ V / S` of Stacks 021I (4), as a natural transformation
`i_T ∘ f_small ⟹ i_S` of the presenting functors. -/
public def nuNatTrans :
    smallEtaleBaseChange B.toBigEtaleSite T.hom ⋙ smallEtaleOverFunctor B S hS T ⟶
      smallEtaleToFppf B S hS where
  app V := SmallEtale.nuProj B.toBigEtaleSite S hS T V
  naturality _ _ k := SmallEtale.nuProj_naturality B.toBigEtaleSite S hS T k

/-- The structure map of `i_T ∘ f_small`, i.e. of the composite of the morphisms of ringed sites
`ε_f` and `i_T`. -/
public abbrev nuStructureMap :
    (SmallEtale.structureSheaf B.toBigEtaleSite S hS).obj ⟶
      (smallEtaleBaseChange B.toBigEtaleSite T.hom ⋙
        smallEtaleOverFunctor B S hS T).op ⋙ (FibredSite.baseRingStructureSheaf B S hS τ).obj :=
  (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom ≫
    Functor.whiskerLeft
      (smallEtaleBaseChange B.toBigEtaleSite T.hom).op
      (smallEtaleOverRingMap B S hS τ T)

/-- **The structure map of `i_T ∘ f_small` is restriction of functions along the projection.**
Both sides pull a global function on `V` back along `T ×_S V ⟶ V`: on the left through the
structure map of `ε_f` of Stacks 070R (2), on the right through the structure presheaf of the
big `τ`-site. -/
public theorem nuStructureMap_app (V : (SmallEtale B.toBigEtaleSite S hS)ᵒᵖ) :
    (smallEtaleToBaseStructureMap B S hS τ).hom.app V ≫
        (FibredSite.baseRingStructureSheaf B S hS τ).obj.map
          ((nuNatTrans B S hS T).app V.unop).op =
      (nuStructureMap B S hS τ T).app V := by
  simp only [nuStructureMap, smallEtaleToBaseStructureMap, smallEtaleOverRingMap,
    NatTrans.id_app, ObjectProperty.FullSubcategory.id_hom]
  rfl

/-- The presheaf-level inverse image of `𝓖` along the inclusion of the small étale site: the
presheaf whose `τ`-sheafification is `(id_{τ,étale})^*𝓖`, by
`CategoryTheory.SheafOfModules.pullbackIso`. -/
public abbrev smallEtalePresheafPullback :
    PresheafOfModules.{u} (FibredSite.baseRingStructureSheaf B S hS τ).obj :=
  (PresheafOfModules.pullback.{u} (smallEtaleToBaseStructureMap B S hS τ).hom).obj 𝓖.val

/-- **The comparison `κ`**: from the presheaf-level inverse image of `𝓖` along `ε_f` on the
small étale site of the scheme of `T`, to the restriction along `i_T` of the presheaf-level
inverse image along the inclusion of the small étale site of `S`.

It is the transpose, along `ε_f^{*,pre} ⊣ ε_{f,*}`, of the unit of the adjunction for the
inclusion followed by restriction along the projections `T ×_S V ⟶ V` — the latter being
`Stacks`' comparison `i_T ∘ f_small ⟹ i_S` of Stacks 021I (4), read on presheaves of modules by
`AlgebraicGeometry.SmallEtale.PushforwardNat.pushforwardNatTrans`. -/
public def smallEtaleSectionsKappa :
    (PresheafOfModules.pullback.{u}
        (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom).obj 𝓖.val ⟶
      (PresheafOfModules.pushforward.{u} (smallEtaleOverRingMap B S hS τ T)).obj
        (smallEtalePresheafPullback B S hS τ 𝓖) :=
  ((PresheafOfModules.pullbackPushforwardAdjunction.{u}
      (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom).homEquiv _ _).symm
    ((PresheafOfModules.pullbackPushforwardAdjunction.{u}
        (smallEtaleToBaseStructureMap B S hS τ).hom).unit.app 𝓖.val ≫
      SmallEtale.PushforwardNat.pushforwardNatTrans (ν := nuNatTrans B S hS T)
          (α := nuStructureMap B S hS τ T)
          (β := (smallEtaleToBaseStructureMap B S hS τ).hom)
          (h := nuStructureMap_app B S hS τ T)
          (M := smallEtalePresheafPullback B S hS τ 𝓖) ≫
        (PresheafOfModules.pushforwardComp.{u}
          (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom
          (smallEtaleOverRingMap B S hS τ T)).inv.app
            (smallEtalePresheafPullback B S hS τ 𝓖))

/-- The presheaf-level inverse image of `𝓖` along `ε_f`, on the small étale site of the scheme
of `T`.  This is `AlgebraicGeometry.SmallEtale.sectionsSheafTauPresheafPullback`, read over the
fppf presentation of the category of `S`-schemes. -/
public abbrev smallEtalePresheafPullbackOver :
    PresheafOfModules.{u}
      (SmallEtale.structureSheaf B.toBigEtaleSite T.left.obj T.left.property).obj :=
  SmallEtale.sectionsSheafTauPresheafPullback B.toBigEtaleSite S hS 𝓖 T

/-- **θ**: the comparison from the presheaf-level inverse image of `𝓖` along `ε_f` to the sheaf
`f_small^*𝓖`.  This is `AlgebraicGeometry.SmallEtale.sectionsSheafTauTheta`, read over the fppf
presentation of the category of `S`-schemes; by
`AlgebraicGeometry.SmallEtale.sectionsSheafTauTheta_eq` it is the sheafification unit of the
presheaf-level inverse image followed by an isomorphism, hence locally bijective. -/
public abbrev smallEtaleTheta :
    smallEtalePresheafPullbackOver B S hS 𝓖 T ⟶
      (SmallEtale.sectionsSheafTauPullback B.toBigEtaleSite S hS 𝓖 T).val :=
  SmallEtale.sectionsSheafTauTheta B.toBigEtaleSite S hS 𝓖 T


/-- **`κ`'s transpose**, which is how `κ` is defined: the unit of the adjunction for the
inclusion of the small étale site, followed by restriction along the projections of
Stacks 021I (4). -/
public theorem homEquiv_smallEtaleSectionsKappa :
    ((PresheafOfModules.pullbackPushforwardAdjunction.{u}
        (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom).homEquiv _ _)
        (smallEtaleSectionsKappa B S hS τ 𝓖 T) =
      ((PresheafOfModules.pullbackPushforwardAdjunction.{u}
          (smallEtaleToBaseStructureMap B S hS τ).hom).unit.app 𝓖.val ≫
        SmallEtale.PushforwardNat.pushforwardNatTrans (ν := nuNatTrans B S hS T)
            (α := nuStructureMap B S hS τ T)
            (β := (smallEtaleToBaseStructureMap B S hS τ).hom)
            (h := nuStructureMap_app B S hS τ T)
            (M := smallEtalePresheafPullback B S hS τ 𝓖) ≫
          (PresheafOfModules.pushforwardComp.{u}
            (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom
            (smallEtaleOverRingMap B S hS τ T)).inv.app
              (smallEtalePresheafPullback B S hS τ 𝓖)) :=
  Equiv.apply_symm_apply _ _

/-! ### The comparison `ρ'` as a morphism of presheaves of modules -/

/-- The comparison `AlgebraicGeometry.SmallEtale.sectionsSheafTauRho` as a natural
transformation of presheaves of abelian groups on the small étale site of the scheme of `T`:
at `W` it is `ρ'` for the factorization `w ≫ f`, and its naturality is
`AlgebraicGeometry.SmallEtale.sectionsSheafTauRho_naturality`.

The target is written as the restriction along `i_T` of the sections rule, which is the presheaf
underlying the pushforward of
`AlgebraicGeometry.BigFppfOver.smallEtaleSectionsPresheafOfModules` along
`AlgebraicGeometry.BigFppfOver.smallEtaleOverRingMap` — the two are definitionally the same
presheaf, by `CategoryTheory.PresheafOfModules.homToPushforwardPresheaf`, and this spelling is
the one at which the naturality elaborates.  Since that spelling does not mention `τ`, neither
does this declaration: the one natural transformation serves every `τ`, and
`AlgebraicGeometry.BigFppfOver.smallEtaleSectionsRho` transports it across the bridge. -/
public def smallEtaleSectionsRhoNat :
    (SmallEtale.sectionsSheafTauPullback B.toBigEtaleSite S hS 𝓖 T).val.presheaf ⟶
      (smallEtaleOverFunctor B S hS T).op ⋙
        SmallEtale.sectionsSheafTauPresheaf B.toBigEtaleSite S hS 𝓖 where
  app W := SmallEtale.sectionsSheafTauRho B.toBigEtaleSite S hS 𝓖 T W.unop
    (W.unop.obj.hom ≫ T.hom) rfl
  naturality _ _ k :=
    SmallEtale.sectionsSheafTauRho_naturality B.toBigEtaleSite S hS 𝓖 T k.unop
      _ rfl _ rfl
      (Over.w ((SmallEtale.smallEtaleToBigOver B.toBigEtaleSite S hS T).map k.unop))

/-- **The components of `AlgebraicGeometry.BigFppfOver.smallEtaleSectionsRhoNat` are linear.**
Both sides are `AlgebraicGeometry.SmallEtale.sectionsSheafTauRho` written out as its two
factors — the localization map of the small étale site of the scheme of `T`, linear by
`AlgebraicGeometry.SmallEtale.sectionsSheafTauLocApp_smul`, and the sections of a morphism of
sheaves of modules, linear by `AlgebraicGeometry.SmallEtale.smallEtaleSectionsApp_smul`.  Stated
here rather than inline in
`AlgebraicGeometry.BigFppfOver.smallEtaleSectionsRho`, each scalar is the one its own linearity
lemma names and the two factors meet at a spelling fixed in advance, so no metavariable is left
for the unifier to solve against the big site's structure presheaf — the solving in which
`CategoryTheory.SheafOfModules.pullback` and the schemes' pullback cones get unfolded.  The
crossing from here to the pushforward's restricted scalars is then one definitional step. -/
public theorem smallEtaleSectionsRho_smul
    (W : (SmallEtale B.toBigEtaleSite T.left.obj T.left.property)ᵒᵖ)
    (r : (SmallEtale.structureSheaf B.toBigEtaleSite T.left.obj T.left.property).obj.obj W)
    (m : (SmallEtale.sectionsSheafTauPullback B.toBigEtaleSite S hS 𝓖 T).val.obj W) :
    (SmallEtale.smallEtaleSectionsApp B.toBigEtaleSite
        ((SmallEtale.smallEtalePullbackFactoredCompIso B.toBigEtaleSite W.unop.obj.hom T.hom
          (W.unop.obj.hom ≫ T.hom) rfl).hom.app 𝓖)
        (SmallEtale.final B.toBigEtaleSite W.unop.obj.left.obj
          W.unop.obj.left.property)).hom
      ((SmallEtale.sectionsSheafTauLocApp B.toBigEtaleSite T.left.obj T.left.property
        (SmallEtale.sectionsSheafTauPullback B.toBigEtaleSite S hS 𝓖 T) W.unop).hom (r • m)) =
    SmallEtale.locScalar B.toBigEtaleSite T.left.obj T.left.property W.unop r •
      (SmallEtale.smallEtaleSectionsApp B.toBigEtaleSite
        ((SmallEtale.smallEtalePullbackFactoredCompIso B.toBigEtaleSite W.unop.obj.hom T.hom
          (W.unop.obj.hom ≫ T.hom) rfl).hom.app 𝓖)
        (SmallEtale.final B.toBigEtaleSite W.unop.obj.left.obj
          W.unop.obj.left.property)).hom
      ((SmallEtale.sectionsSheafTauLocApp B.toBigEtaleSite T.left.obj T.left.property
        (SmallEtale.sectionsSheafTauPullback B.toBigEtaleSite S hS 𝓖 T) W.unop).hom m) :=
  Eq.trans
    (congrArg (fun y => (SmallEtale.smallEtaleSectionsApp B.toBigEtaleSite
        ((SmallEtale.smallEtalePullbackFactoredCompIso B.toBigEtaleSite W.unop.obj.hom T.hom
          (W.unop.obj.hom ≫ T.hom) rfl).hom.app 𝓖)
        (SmallEtale.final B.toBigEtaleSite W.unop.obj.left.obj
          W.unop.obj.left.property)).hom y)
      (SmallEtale.sectionsSheafTauLocApp_smul B.toBigEtaleSite T.left.obj T.left.property
        (SmallEtale.sectionsSheafTauPullback B.toBigEtaleSite S hS 𝓖 T) W.unop r m))
    (SmallEtale.smallEtaleSectionsApp_smul _ _ _ _)

/-- **The comparison `ρ'` as a morphism of presheaves of `𝒪`-modules**, from the inverse image
`f_small^*𝓖` to the restriction along `i_T` of the sections rule.  It is linear because its two
factors are: the localization map of the small étale site of the scheme of `T` is linear by
`AlgebraicGeometry.SmallEtale.sectionsSheafTauLocApp_smul`, and sections of a morphism of
sheaves of modules are linear by
`AlgebraicGeometry.SmallEtale.smallEtaleSectionsApp_smul`. -/
public def smallEtaleSectionsRho :
    (SmallEtale.sectionsSheafTauPullback B.toBigEtaleSite S hS 𝓖 T).val ⟶
      (PresheafOfModules.pushforward.{u} (smallEtaleOverRingMap B S hS τ T)).obj
        (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖) :=
  PresheafOfModules.homMk
    (PresheafOfModules.homToPushforwardPresheaf (smallEtaleOverRingMap B S hS τ T)
      (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖) (smallEtaleSectionsRhoNat B S hS 𝓖 T))
    (smallEtaleSectionsRho_smul B S hS 𝓖 T)

/-- **The generator identity of Stacks 070S part (3), packaged.**  The localization map followed
by restriction along the projections `T ×_S V ⟶ V` of Stacks 021I (4) is the unit of
`ε_f^* ⊣ ε_{f,*}` followed by `ρ'`.

This is `AlgebraicGeometry.SmallEtale.sectionsSheafTauRho_unitSectionsApp` read as an equality of
morphisms of presheaves of `𝒪`-modules on the small étale site of `S`.

The left side is read through `CategoryTheory.PresheafOfModules.homToPushforwardComp`, which is
the identity function: both sides are then morphisms into the pushforward along `ε_f` of the
pushforward along `i_T`, the spelling the right side has anyway and the one the consumer
`AlgebraicGeometry.BigFppfOver.smallEtaleSectionsKappa_comp_gamma` is handed by the adjunction.
Without it the equation itself asks for the identification of that iterated pushforward with the
pushforward along the composite structure map, at these concrete presheaves. -/
public theorem smallEtaleSectionsLoc_comp_pushforwardNatTrans :
    PresheafOfModules.homToPushforwardComp
        (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom
        (smallEtaleOverRingMap B S hS τ T)
        (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖)
        (smallEtaleSectionsLoc B S hS τ 𝓖 ≫
          SmallEtale.PushforwardNat.pushforwardNatTrans (ν := nuNatTrans B S hS T)
            (α := nuStructureMap B S hS τ T) (β := (smallEtaleToBaseStructureMap B S hS τ).hom)
            (h := nuStructureMap_app B S hS τ T)
            (M := smallEtaleSectionsPresheafOfModules B S hS τ 𝓖)) =
      ((SheafOfModules.pullbackPushforwardAdjunction.{u}
          (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom)).unit.app 𝓖).val ≫
        (PresheafOfModules.pushforward.{u}
          (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom).map
            (smallEtaleSectionsRho B S hS τ 𝓖 T) := by
  ext V m
  exact (CategoryTheory.congr_fun
    (SmallEtale.sectionsSheafTauRho_unitSectionsApp B.toBigEtaleSite S hS 𝓖 T V.unop) m).symm

/-- **The key identity of Stacks 070S part (3): `κ ≫ i_T^{-1}γ = θ ≫ ρ'`.**

Both sides are morphisms out of the presheaf-level inverse image of `𝓖` along `ε_f`, so it is
enough to compare their transposes across `ε_f^{*,pre} ⊣ ε_{f,*}`, and then the two sides are
morphisms out of `𝓖` on the small étale site of `S`.  There
`AlgebraicGeometry.BigFppfOver.homEquiv_smallEtaleSectionsKappa` and
`AlgebraicGeometry.BigFppfOver.homEquiv_smallEtaleSectionsGamma` replace `κ` and `γ` by the unit
of the adjunction for the inclusion of the small étale site and by the localization map, and
what is left is
`AlgebraicGeometry.BigFppfOver.smallEtaleSectionsLoc_comp_pushforwardNatTrans`, the generator
identity. -/
public theorem smallEtaleSectionsKappa_comp_gamma :
    smallEtaleSectionsKappa B S hS τ 𝓖 T ≫
        (PresheafOfModules.pushforward.{u} (smallEtaleOverRingMap B S hS τ T)).map
          (smallEtaleSectionsGamma B S hS τ 𝓖) =
      smallEtaleTheta B S hS 𝓖 T ≫ smallEtaleSectionsRho B S hS τ 𝓖 T := by
  have hg := homEquiv_smallEtaleSectionsGamma B S hS τ 𝓖
  rw [Adjunction.homEquiv_unit] at hg
  have hmid := SmallEtale.PushforwardNat.pushforwardNatTrans_naturality
    (ν := nuNatTrans B S hS T) (α := nuStructureMap B S hS τ T)
    (β := (smallEtaleToBaseStructureMap B S hS τ).hom) (h := nuStructureMap_app B S hS τ T)
    (M := smallEtalePresheafPullback B S hS τ 𝓖)
    (M' := smallEtaleSectionsPresheafOfModules B S hS τ 𝓖)
    (smallEtaleSectionsGamma B S hS τ 𝓖)
  have hinner :
      (SmallEtale.PushforwardNat.pushforwardNatTrans (ν := nuNatTrans B S hS T)
            (α := nuStructureMap B S hS τ T)
            (β := (smallEtaleToBaseStructureMap B S hS τ).hom)
            (h := nuStructureMap_app B S hS τ T)
            (M := smallEtalePresheafPullback B S hS τ 𝓖) ≫
          (PresheafOfModules.pushforwardComp.{u}
            (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom
            (smallEtaleOverRingMap B S hS τ T)).inv.app
              (smallEtalePresheafPullback B S hS τ 𝓖)) ≫
        (PresheafOfModules.pushforward.{u}
          (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom).map
            ((PresheafOfModules.pushforward.{u} (smallEtaleOverRingMap B S hS τ T)).map
              (smallEtaleSectionsGamma B S hS τ 𝓖)) =
      PresheafOfModules.homToPushforwardComp
        (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom
        (smallEtaleOverRingMap B S hS τ T)
        (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖)
        ((PresheafOfModules.pushforward.{u}
            (smallEtaleToBaseStructureMap B S hS τ).hom).map
              (smallEtaleSectionsGamma B S hS τ 𝓖) ≫
          SmallEtale.PushforwardNat.pushforwardNatTrans (ν := nuNatTrans B S hS T)
            (α := nuStructureMap B S hS τ T)
            (β := (smallEtaleToBaseStructureMap B S hS τ).hom)
            (h := nuStructureMap_app B S hS τ T)
            (M := smallEtaleSectionsPresheafOfModules B S hS τ 𝓖)) :=
    Eq.trans
      (congrArg (fun t : _ ⟶ _ => t ≫ (PresheafOfModules.pushforward.{u}
          (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom).map
            ((PresheafOfModules.pushforward.{u} (smallEtaleOverRingMap B S hS τ T)).map
              (smallEtaleSectionsGamma B S hS τ 𝓖)))
        (PresheafOfModules.comp_pushforwardComp_inv_app _ _ _ _))
      (Eq.trans (PresheafOfModules.homToPushforwardComp_comp_map _ _ _ _).symm
        (congrArg (fun t : _ ⟶ _ => PresheafOfModules.homToPushforwardComp
            (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom
            (smallEtaleOverRingMap B S hS τ T)
            (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖) t) hmid))
  apply ((PresheafOfModules.pullbackPushforwardAdjunction.{u}
    (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom).homEquiv _ _).injective
  refine Eq.trans (Adjunction.homEquiv_naturality_right _ _ _) ?_
  refine Eq.trans (congrArg (fun t : _ ⟶ _ => t ≫ (PresheafOfModules.pushforward.{u}
      (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom).map
        ((PresheafOfModules.pushforward.{u} (smallEtaleOverRingMap B S hS τ T)).map
          (smallEtaleSectionsGamma B S hS τ 𝓖)))
    (homEquiv_smallEtaleSectionsKappa B S hS τ 𝓖 T)) ?_
  refine Eq.trans (Category.assoc _ _ _) ?_
  refine Eq.trans (congrArg (fun t : _ ⟶ _ =>
    ((PresheafOfModules.pullbackPushforwardAdjunction.{u}
      (smallEtaleToBaseStructureMap B S hS τ).hom).unit.app 𝓖.val) ≫ t) hinner) ?_
  refine Eq.trans (PresheafOfModules.comp_homToPushforwardComp _ _ _ _ _).symm ?_
  refine Eq.trans (congrArg (fun t : _ ⟶ _ => PresheafOfModules.homToPushforwardComp
      (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom
      (smallEtaleOverRingMap B S hS τ T)
      (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖) t) (Category.assoc _ _ _).symm) ?_
  refine Eq.trans (congrArg (fun t : _ ⟶ _ => PresheafOfModules.homToPushforwardComp
      (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom
      (smallEtaleOverRingMap B S hS τ T)
      (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖)
      (t ≫ SmallEtale.PushforwardNat.pushforwardNatTrans (ν := nuNatTrans B S hS T)
        (α := nuStructureMap B S hS τ T)
        (β := (smallEtaleToBaseStructureMap B S hS τ).hom)
        (h := nuStructureMap_app B S hS τ T)
        (M := smallEtaleSectionsPresheafOfModules B S hS τ 𝓖))) hg) ?_
  refine Eq.trans (smallEtaleSectionsLoc_comp_pushforwardNatTrans B S hS τ 𝓖 T) ?_
  refine Eq.trans (congrArg (fun t : _ ⟶ _ => t ≫ (PresheafOfModules.pushforward.{u}
      (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom).map
        (smallEtaleSectionsRho B S hS τ 𝓖 T))
    (SmallEtale.homEquiv_sectionsSheafTauTheta B.toBigEtaleSite S hS 𝓖 T).symm) ?_
  exact (Adjunction.homEquiv_naturality_right _ _ _).symm


omit [(smallEtaleToFppf B S hS).IsContinuous
  (SmallEtale.topology B.toBigEtaleSite S hS) (baseOverTopology B S hS τ)] in
/-- The component of `AlgebraicGeometry.BigFppfOver.smallEtaleSectionsRho` at an object of the
small étale site of the scheme of `T` is
`AlgebraicGeometry.SmallEtale.sectionsSheafTauRho` for the factorization `w ≫ f`.  This is a
reflexivity, but an expensive one — it crosses the étale and fppf spellings of the structure
presheaf of rings of the big site — so it is recorded once here rather than re-checked at every
use. -/
public theorem smallEtaleSectionsRho_app
    (W : SmallEtale B.toBigEtaleSite T.left.obj T.left.property)
    (y : (SmallEtale.sectionsSheafTauPullback B.toBigEtaleSite S hS 𝓖 T).val.obj (op W)) :
    (smallEtaleSectionsRho B S hS τ 𝓖 T).app (op W) y =
      SmallEtale.sectionsSheafTauRho B.toBigEtaleSite S hS 𝓖 T W (W.obj.hom ≫ T.hom) rfl y :=
  rfl

/-! ### `κ` is surjective -/

/-- **`κ` on the image of the unit.**  The image under `κ` of the image under the unit of
`ε_f^{*,pre} ⊣ ε_{f,*}` of a section of `𝓖` over an étale `V / S` is the restriction, along the
projection `T ×_S V / S ⟶ V / S` of Stacks 021I (4), of its image under the unit for the
inclusion of the small étale site. -/
public theorem smallEtaleSectionsKappa_unit_app (V : SmallEtale B.toBigEtaleSite S hS)
    (m : 𝓖.val.obj (op V)) :
    (smallEtaleSectionsKappa B S hS τ 𝓖 T).app
        (op ((smallEtaleBaseChange B.toBigEtaleSite T.hom).obj V))
        (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
          (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom).unit.app
            𝓖.val).app (op V) m) =
      (smallEtalePresheafPullback B S hS τ 𝓖).map ((nuNatTrans B S hS T).app V).op
        (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
          (smallEtaleToBaseStructureMap B S hS τ).hom).unit.app 𝓖.val).app (op V) m) := by
  have h := homEquiv_smallEtaleSectionsKappa B S hS τ 𝓖 T
  rw [Adjunction.homEquiv_unit] at h
  exact ConcreteCategory.congr_hom
    (congrArg (fun k : _ ⟶ _ => PresheafOfModules.Hom.app k (op V)) h) m

/-- **`κ` is surjective in every component.**  The presheaf-level inverse image of `𝓖` along the
inclusion of the small étale site is generated, over the object `W / S`, by the restrictions of
the images of the unit, by
`CategoryTheory.PresheafOfModules.mem_pullbackUnitSubmodule`; each such generator is indexed by
a morphism `W / S ⟶ V / S`, which by
`AlgebraicGeometry.SmallEtale.kappaLift` comes from a morphism `W ⟶ T ×_S V` of the
small étale site of the scheme of `T`, and
`AlgebraicGeometry.BigFppfOver.smallEtaleSectionsKappa_unit_app` then exhibits it as a value
of `κ`. -/
public theorem smallEtaleSectionsKappa_surjective
    (W : SmallEtale B.toBigEtaleSite T.left.obj T.left.property)
    (p : ((PresheafOfModules.pushforward.{u} (smallEtaleOverRingMap B S hS τ T)).obj
      (smallEtalePresheafPullback B S hS τ 𝓖)).obj (op W)) :
    ∃ t, (smallEtaleSectionsKappa B S hS τ 𝓖 T).app (op W) t = p := by
  have hmem : p ∈ Submodule.span _ (PresheafOfModules.pullbackUnitGenerators
      (smallEtaleToBaseStructureMap B S hS τ).hom 𝓖.val
      (op ((smallEtaleOverFunctor B S hS T).obj W))) :=
    PresheafOfModules.mem_pullbackUnitSubmodule (smallEtaleToBaseStructureMap B S hS τ).hom
      𝓖.val (op ((smallEtaleOverFunctor B S hS T).obj W)) p
  induction hmem using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨V, g, m, rfl⟩ := hx
      refine ⟨(smallEtalePresheafPullbackOver B S hS 𝓖 T).map
        (SmallEtale.kappaLift B.toBigEtaleSite S hS T V g).op
          (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
            (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom).hom).unit.app
              𝓖.val).app (op V) m), ?_⟩
      refine Eq.trans (PresheafOfModules.naturality_apply
        (smallEtaleSectionsKappa B S hS τ 𝓖 T)
        (SmallEtale.kappaLift B.toBigEtaleSite S hS T V g).op _) ?_
      refine Eq.trans (congrArg
        (fun y => (smallEtalePresheafPullback B S hS τ 𝓖).map
          ((smallEtaleOverFunctor B S hS T).map
            (SmallEtale.kappaLift B.toBigEtaleSite S hS T V g)).op y)
        (smallEtaleSectionsKappa_unit_app B S hS τ 𝓖 T V m)) ?_
      refine Eq.trans ((smallEtalePresheafPullback B S hS τ 𝓖).map_comp_apply
        ((nuNatTrans B S hS T).app V).op
        ((smallEtaleOverFunctor B S hS T).map
          (SmallEtale.kappaLift B.toBigEtaleSite S hS T V g)).op _).symm ?_
      exact congrArg (fun k : (smallEtaleOverFunctor B S hS T).obj W ⟶
          (smallEtaleToFppf B S hS).obj V =>
        (smallEtalePresheafPullback B S hS τ 𝓖).map k.op
          (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
            (smallEtaleToBaseStructureMap B S hS τ).hom).unit.app 𝓖.val).app (op V) m))
        (SmallEtale.kappaLift_spec B.toBigEtaleSite S hS T V g)
  | zero => exact ⟨0, map_zero _⟩
  | add x y _ _ hx hy =>
      obtain ⟨tx, hxt⟩ := hx
      obtain ⟨ty, hyt⟩ := hy
      refine ⟨tx + ty, ?_⟩
      refine Eq.trans (map_add _ tx ty) ?_
      rw [hxt, hyt]
      rfl
  | smul r x _ hx =>
      obtain ⟨t, ht⟩ := hx
      refine ⟨(show (SmallEtale.structureSheaf B.toBigEtaleSite T.left.obj
        T.left.property).obj.obj (op W) from r) • t, ?_⟩
      refine Eq.trans (map_smul _ _ t) ?_
      exact congrArg (fun y => (show (SmallEtale.structureSheaf B.toBigEtaleSite T.left.obj
        T.left.property).obj.obj (op W) from r) • y) ht


/-! ### Transfer of étale covering sieves to the big `τ`-site -/

omit [(smallEtaleToFppf B S hS).IsContinuous
  (SmallEtale.topology B.toBigEtaleSite S hS) (baseOverTopology B S hS τ)] in
/-- **An étale covering sieve of an object of the small étale site of the scheme of `T` is a
`τ`-covering sieve of the big site**, for `τ` finer than the étale topology.  Base change of
slices leaves the sieve on the underlying scheme untouched, by
`CategoryTheory.Sieve.functorPushforward_over_map`, so this is exactly the hypothesis on
`τ`. -/
public theorem coverPreserving_overMap (hτ : B.etaleTopology ≤ B.baseTopology τ) :
    CoverPreserving (baseOverTopology B T.left.obj T.left.property .etale)
      (baseOverTopology B S hS τ) (Over.map T.hom) where
  cover_preserve {Z} R hR := by
    rw [GrothendieckTopology.mem_over_iff] at hR ⊢
    have h := Sieve.functorPushforward_over_map T.hom Z (Sieve.overEquiv Z R)
    rw [OrderIso.symm_apply_apply] at h
    rw [h, OrderIso.apply_symm_apply]
    exact hτ _ hR

omit [(smallEtaleToFppf B S hS).IsContinuous
  (SmallEtale.topology B.toBigEtaleSite S hS) (baseOverTopology B S hS τ)] in
/-- **The functor presenting `i_T` is cover preserving**, from the étale topology of the small
étale site of the scheme of `T` to the localized `τ`-topology of the big site: it is the
inclusion of that small étale site, continuous by **Stacks 021G**, followed by base change of
slices. -/
public theorem coverPreserving_smallEtaleOverFunctor (hτ : B.etaleTopology ≤ B.baseTopology τ) :
    CoverPreserving (SmallEtale.topology B.toBigEtaleSite T.left.obj T.left.property)
      (baseOverTopology B S hS τ) (smallEtaleOverFunctor B S hS T) :=
  CoverPreserving.comp _ _
    (CoverPreserving.of_isContinuous (smallEtaleToFppf B T.left.obj T.left.property)
      (SmallEtale.topology B.toBigEtaleSite T.left.obj T.left.property)
      (baseOverTopology B T.left.obj T.left.property .etale))
    (coverPreserving_overMap B S hS τ T hτ)


/-! ### The comparison at the final object -/

/-- **`κ ≫ i_T^{-1}γ = θ ≫ ρ'` read on sections**, which is what the local bijectivity of the
comparison consumes. -/
public theorem smallEtaleSectionsGamma_kappa_app
    (W : SmallEtale B.toBigEtaleSite T.left.obj T.left.property)
    (t : (smallEtalePresheafPullbackOver B S hS 𝓖 T).obj (op W)) :
    (smallEtaleSectionsGamma B S hS τ 𝓖).app
        (op ((smallEtaleOverFunctor B S hS T).obj W))
        ((smallEtaleSectionsKappa B S hS τ 𝓖 T).app (op W) t) =
      (smallEtaleSectionsRho B S hS τ 𝓖 T).app (op W)
        ((smallEtaleTheta B S hS 𝓖 T).app (op W) t) :=
  ConcreteCategory.congr_hom
    (congrArg (fun k : _ ⟶ _ => PresheafOfModules.Hom.app k (op W))
      (smallEtaleSectionsKappa_comp_gamma B S hS τ 𝓖 T)) t

/-- **The restriction map of the sections rule along the canonical arrow `i_T W ⟶ T`**, for an
object `W` of the small étale site of the scheme of `T` and the canonical arrow `w : W ⟶ T / T`,
is the restriction map of `f_small^*𝓖` along `w` followed by `ρ'`.

This is `AlgebraicGeometry.SmallEtale.sectionsSheafTauMap_eq_rho` with the arrow presented as
`i_T w` followed by `AlgebraicGeometry.SmallEtale.finalOverIso`: the two agree because the
canonical arrow to a final object is unique. -/
public theorem sectionsSheafTauMap_smallEtaleOverFunctor_map
    {W : SmallEtale B.toBigEtaleSite T.left.obj T.left.property}
    (w : W ⟶ SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property) :
    SmallEtale.sectionsSheafTauMap B.toBigEtaleSite S hS 𝓖
        ((smallEtaleOverFunctor B S hS T).map w ≫
          (SmallEtale.finalOverIso B.toBigEtaleSite S hS T).hom) =
      (SmallEtale.sectionsSheafTauPullback B.toBigEtaleSite S hS 𝓖 T).val.presheaf.map w.op ≫
        SmallEtale.sectionsSheafTauRho B.toBigEtaleSite S hS 𝓖 T W
          (W.obj.hom ≫ T.hom) rfl := by
  have hw : (SmallEtale.finalIsTerminal B.toBigEtaleSite T.left.obj T.left.property).from W = w :=
    (SmallEtale.finalIsTerminal B.toBigEtaleSite T.left.obj T.left.property).hom_ext _ _
  have hmk : (smallEtaleOverFunctor B S hS T).map w ≫
        (SmallEtale.finalOverIso B.toBigEtaleSite S hS T).hom =
      (Over.homMk W.obj.hom rfl : (smallEtaleOverFunctor B S hS T).obj W ⟶ T) :=
    Over.OverMorphism.ext (Over.w w.hom)
  refine Eq.trans (congrArg (fun k : (smallEtaleOverFunctor B S hS T).obj W ⟶ T =>
    SmallEtale.sectionsSheafTauMap B.toBigEtaleSite S hS 𝓖 k) hmk) ?_
  refine Eq.trans (SmallEtale.sectionsSheafTauMap_eq_rho B.toBigEtaleSite S hS 𝓖 T W
    (W.obj.hom ≫ T.hom) rfl) ?_
  exact congrArg (fun k : W ⟶ SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property =>
    (SmallEtale.sectionsSheafTauPullback B.toBigEtaleSite S hS 𝓖 T).val.presheaf.map k.op ≫
      SmallEtale.sectionsSheafTauRho B.toBigEtaleSite S hS 𝓖 T W (W.obj.hom ≫ T.hom) rfl) hw

/-- **If `γ` kills the `κ`-image of a section over the final object, then `θ` kills it.**  By
the key identity `AlgebraicGeometry.BigFppfOver.smallEtaleSectionsGamma_kappa_app` the
hypothesis says that `ρ'` kills `θ` of the section, and at the final object `ρ'` is restriction
along the canonical isomorphism `i_T(T/T) ≅ T`
(`AlgebraicGeometry.SmallEtale.sectionsSheafTauRho_app_final`), which is invertible. -/
public theorem smallEtaleTheta_app_final_eq_zero
    (t : (smallEtalePresheafPullbackOver B S hS 𝓖 T).obj
      (op (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)))
    (hgam : (smallEtaleSectionsGamma B S hS τ 𝓖).app
        (op ((smallEtaleOverFunctor B S hS T).obj
          (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)))
        ((smallEtaleSectionsKappa B S hS τ 𝓖 T).app
          (op (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)) t) = 0) :
    (smallEtaleTheta B S hS 𝓖 T).app
      (op (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)) t = 0 := by
  have hrho0 : SmallEtale.sectionsSheafTauRho B.toBigEtaleSite S hS 𝓖 T
      (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)
      ((SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property).obj.hom ≫ T.hom) rfl
      ((smallEtaleTheta B S hS 𝓖 T).app
        (op (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)) t) = 0 :=
    (smallEtaleSectionsRho_app B S hS τ 𝓖 T
        (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property) _).symm.trans
      ((smallEtaleSectionsGamma_kappa_app B S hS τ 𝓖 T
        (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property) t).symm.trans hgam)
  have hrho : SmallEtale.sectionsSheafTauMap B.toBigEtaleSite S hS 𝓖
      (SmallEtale.finalOverIso B.toBigEtaleSite S hS T).hom
      ((smallEtaleTheta B S hS 𝓖 T).app
        (op (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)) t) = 0 :=
    (SmallEtale.sectionsSheafTauRho_app_final_apply B.toBigEtaleSite S hS 𝓖 T
      ((smallEtaleTheta B S hS 𝓖 T).app
        (op (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)) t)).symm.trans hrho0
  exact eq_zero_of_sectionsSheafTauMap_eq_zero B S hS τ 𝓖
    (SmallEtale.finalOverIso B.toBigEtaleSite S hS T)
    ((smallEtaleTheta B S hS 𝓖 T).app
      (op (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)) t) hrho

end Kappa


/-! ### Local bijectivity of the comparison -/

/-- A sieve of `T` containing every `a ≫ i_T w ≫ (i_T(T/T) ≅ T)`, for `w` in an étale covering
sieve `R` of the final object, is covering for any topology making `i_T` cover preserving. -/
private theorem mem_of_final_sieve_mem (T : BigFppfOver B S hS) (J : GrothendieckTopology _)
    (hJ : CoverPreserving (SmallEtale.topology B.toBigEtaleSite T.left.obj T.left.property) J
      (smallEtaleOverFunctor B S hS T))
    (R : Sieve (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property))
    (hR : R ∈ SmallEtale.topology B.toBigEtaleSite T.left.obj T.left.property
      (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)) (P : Sieve T)
    (hP : ∀ {W} (w : W ⟶ SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property), R w →
      ∀ {T'} (a : T' ⟶ (smallEtaleOverFunctor B S hS T).obj W),
        P (a ≫ (smallEtaleOverFunctor B S hS T).map w ≫
          (SmallEtale.finalOverIso B.toBigEtaleSite S hS T).hom)) :
    P ∈ J T := by
  refine J.superset_covering ?_
    (J.pullback_stable (SmallEtale.finalOverIso B.toBigEtaleSite S hS T).inv
      (hJ.cover_preserve hR))
  rintro T' g ⟨W, w, a, hw, hfac⟩
  rw [((Iso.comp_inv_eq _).1 hfac).trans (Category.assoc _ _ _)]
  exact hP w hw a

/-- **The comparison `γ` of Stacks 070S part (3) is locally surjective.**

A section of the sections rule over `T` *is* a global section of `f_small^*𝓖`, and `θ` is
locally surjective for the étale topology of the small étale site of the scheme of `T`
(`AlgebraicGeometry.SmallEtale.isLocallySurjective_sectionsSheafTauTheta`), so there is an étale
covering sieve of the final object on which that section comes from the presheaf-level inverse
image along `ε_f`.  That sieve is pushed forward to a `τ`-covering sieve of `T` by
`AlgebraicGeometry.BigFppfOver.coverPreserving_smallEtaleOverFunctor`, and on it the restriction
of the section is, by
`AlgebraicGeometry.BigFppfOver.sectionsSheafTauMap_smallEtaleOverFunctor_map` and the key
identity `AlgebraicGeometry.BigFppfOver.smallEtaleSectionsGamma_kappa_app`, the image under `γ`
of the `κ`-image of the local lift. -/
public theorem isLocallySurjective_smallEtaleSectionsGamma
    (hτ : B.etaleTopology ≤ B.baseTopology τ) :
    Presheaf.IsLocallySurjective (baseOverTopology B S hS τ)
      ((PresheafOfModules.toPresheaf (FibredSite.baseRingStructureSheaf B S hS τ).obj).map
        (smallEtaleSectionsGamma B S hS τ 𝓖)) where
  imageSieve_mem {T} s := by
    have hR := (SmallEtale.isLocallySurjective_sectionsSheafTauTheta
        B.toBigEtaleSite S hS 𝓖 T).imageSieve_mem
      (U := (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)) s
    refine mem_of_final_sieve_mem B S hS T _
      (coverPreserving_smallEtaleOverFunctor B S hS τ T hτ) _ hR _ ?_
    rintro W w ⟨t, ht⟩ T' a
    refine ⟨(smallEtalePresheafPullback B S hS τ 𝓖).map a.op
      ((smallEtaleSectionsKappa B S hS τ 𝓖 T).app (op W) t), ?_⟩
    refine Eq.trans (PresheafOfModules.naturality_apply
      (smallEtaleSectionsGamma B S hS τ 𝓖) a.op _) ?_
    refine Eq.trans (congrArg
      (fun y => (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖).map a.op y)
      (smallEtaleSectionsGamma_kappa_app B S hS τ 𝓖 T W t)) ?_
    refine Eq.trans (congrArg
      (fun y => (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖).map a.op
        ((smallEtaleSectionsRho B S hS τ 𝓖 T).app (op W) y)) ht) ?_
    refine Eq.trans (congrArg
      (fun y => (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖).map a.op y)
      (CategoryTheory.congr_fun
        (sectionsSheafTauMap_smallEtaleOverFunctor_map B S hS 𝓖 T w).symm s)) ?_
    exact ((smallEtaleSectionsPresheafOfModules B S hS τ 𝓖).map_comp_apply
      ((smallEtaleOverFunctor B S hS T).map w ≫
        (SmallEtale.finalOverIso B.toBigEtaleSite S hS T).hom).op a.op s).symm

/-- **The comparison `γ` of Stacks 070S part (3) is locally injective.**

A section of the presheaf-level inverse image over `T` is, by
`AlgebraicGeometry.BigFppfOver.smallEtaleSectionsKappa_surjective` and the canonical
isomorphism `i_T(T/T) ≅ T`, the `κ`-image of a section over the final object of the small étale
site of the scheme of `T`.  If `γ` kills it then so does `θ`
(`AlgebraicGeometry.BigFppfOver.smallEtaleTheta_app_final_eq_zero`); `θ` is locally injective
for the étale topology
(`AlgebraicGeometry.SmallEtale.isLocallyInjective_sectionsSheafTauTheta`), so an étale covering
sieve of the final object kills that section, and naturality of `κ` carries this to the
`τ`-covering sieve of `T` supplied by
`AlgebraicGeometry.BigFppfOver.coverPreserving_smallEtaleOverFunctor`. -/
public theorem isLocallyInjective_smallEtaleSectionsGamma
    (hτ : B.etaleTopology ≤ B.baseTopology τ) :
    Presheaf.IsLocallyInjective (baseOverTopology B S hS τ)
      ((PresheafOfModules.toPresheaf (FibredSite.baseRingStructureSheaf B S hS τ).obj).map
        (smallEtaleSectionsGamma B S hS τ 𝓖)) where
  equalizerSieve_mem {X} x y h := by
    obtain ⟨T⟩ := X
    have hp : (smallEtaleSectionsGamma B S hS τ 𝓖).app (op T) (x - y) = 0 :=
      (map_sub _ x y).trans (sub_eq_zero.mpr h)
    obtain ⟨t, ht⟩ := smallEtaleSectionsKappa_surjective B S hS τ 𝓖 T
      (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)
      ((smallEtalePresheafPullback B S hS τ 𝓖).map
        (SmallEtale.finalOverIso B.toBigEtaleSite S hS T).hom.op (x - y))
    have hgam : (smallEtaleSectionsGamma B S hS τ 𝓖).app
        (op ((smallEtaleOverFunctor B S hS T).obj
          (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)))
        ((smallEtaleSectionsKappa B S hS τ 𝓖 T).app
          (op (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)) t) = 0 := by
      rw [ht]
      refine Eq.trans (PresheafOfModules.naturality_apply
        (smallEtaleSectionsGamma B S hS τ 𝓖)
        (SmallEtale.finalOverIso B.toBigEtaleSite S hS T).hom.op (x - y)) ?_
      exact Eq.trans (congrArg (fun z =>
        (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖).map
          (SmallEtale.finalOverIso B.toBigEtaleSite S hS T).hom.op z) hp) (map_zero _)
    have hth := smallEtaleTheta_app_final_eq_zero B S hS τ 𝓖 T t hgam
    refine mem_of_final_sieve_mem B S hS T _
      (coverPreserving_smallEtaleOverFunctor B S hS τ T hτ) _
      ((SmallEtale.isLocallyInjective_sectionsSheafTauTheta B.toBigEtaleSite S hS 𝓖
        T).equalizerSieve_mem t 0 (hth.trans (map_zero _).symm)) _ ?_
    rintro W w hw T' a
    have hstep : (smallEtalePresheafPullback B S hS τ 𝓖).map
        (a ≫ ((smallEtaleOverFunctor B S hS T).map w ≫
          (SmallEtale.finalOverIso B.toBigEtaleSite S hS T).hom)).op (x - y) = 0 := by
      refine ((smallEtalePresheafPullback B S hS τ 𝓖).map_comp_apply
        ((smallEtaleOverFunctor B S hS T).map w ≫
          (SmallEtale.finalOverIso B.toBigEtaleSite S hS T).hom).op a.op (x - y)).trans ?_
      refine (congrArg (fun z => (smallEtalePresheafPullback B S hS τ 𝓖).map a.op z)
        ((smallEtalePresheafPullback B S hS τ 𝓖).map_comp_apply
          (SmallEtale.finalOverIso B.toBigEtaleSite S hS T).hom.op
          ((smallEtaleOverFunctor B S hS T).map w).op (x - y))).trans ?_
      refine (congrArg (fun z => (smallEtalePresheafPullback B S hS τ 𝓖).map a.op
        ((smallEtalePresheafPullback B S hS τ 𝓖).map ((smallEtaleOverFunctor B S hS T).map w).op z))
          ht.symm).trans ?_
      refine (congrArg (fun z => (smallEtalePresheafPullback B S hS τ 𝓖).map a.op z)
        (PresheafOfModules.naturality_apply (smallEtaleSectionsKappa B S hS τ 𝓖 T)
          w.op t).symm).trans ?_
      refine (congrArg (fun z => (smallEtalePresheafPullback B S hS τ 𝓖).map a.op
        ((smallEtaleSectionsKappa B S hS τ 𝓖 T).app (op W) z)) hw).trans ?_
      refine (congrArg (fun z => (smallEtalePresheafPullback B S hS τ 𝓖).map a.op
        ((smallEtaleSectionsKappa B S hS τ 𝓖 T).app (op W) z)) (map_zero _)).trans ?_
      exact (congrArg (fun z => (smallEtalePresheafPullback B S hS τ 𝓖).map a.op z)
        (map_zero _)).trans (map_zero _)
    exact sub_eq_zero.mp ((map_sub _ x y).symm.trans hstep)


/-! ### Stacks 070S part (3) -/

omit [(smallEtaleToFppf B S hS).IsContinuous
  (SmallEtale.topology B.toBigEtaleSite S hS) (baseOverTopology B S hS τ)] in
/-- The localized big étale topology is coarser than the localized `τ`-topology as soon as the
big étale topology is coarser than the big `τ`-topology. -/
public theorem bigEtaleOver_topology_le_baseOverTopology_of_le
    (hτ : B.etaleTopology ≤ B.baseTopology τ) :
    BigEtaleOver.topology B.toBigEtaleSite S hS ≤ baseOverTopology B S hS τ :=
  le_trans (bigEtaleOver_topology_le_baseOverTopology B S hS) (Stacks.Sites.over_mono hτ _)

omit [(smallEtaleToFppf B S hS).IsContinuous
  (SmallEtale.topology B.toBigEtaleSite S hS) (baseOverTopology B S hS τ)] in
/-- **For `τ` finer than the étale topology the inclusion of the small étale site is
continuous**, so the morphism of ringed sites `id_{τ,étale}` exists: by **Stacks 021G** the
inclusion is continuous into the localized big étale topology, which the localized
`τ`-topology refines. -/
@[sga "4 VII 4.0" "partial"]
public theorem isContinuous_smallEtaleToFppf_of_etaleTopology_le
    (hτ : B.etaleTopology ≤ B.baseTopology τ) :
    (smallEtaleToFppf B S hS).IsContinuous (SmallEtale.topology B.toBigEtaleSite S hS)
      (baseOverTopology B S hS τ) :=
  have _h0 : (smallEtaleToFppf B S hS).IsContinuous
      (SmallEtale.topology B.toBigEtaleSite S hS)
      (BigEtaleOver.topology B.toBigEtaleSite S hS) :=
    (smallEtaleInclusion_isMorphismOfSites B.toBigEtaleSite S hS).toIsContinuous
  Functor.isContinuous_of_le_target _ _
    (bigEtaleOver_topology_le_baseOverTopology_of_le B S hS τ hτ)

/-- **The comparison `γ` sheafifies to an isomorphism.**  A morphism of presheaves of modules
which is locally bijective becomes an isomorphism after sheafification; the two halves are
`AlgebraicGeometry.BigFppfOver.isLocallySurjective_smallEtaleSectionsGamma` and
`AlgebraicGeometry.BigFppfOver.isLocallyInjective_smallEtaleSectionsGamma`. -/
public theorem isIso_baseSheafification_map_smallEtaleSectionsGamma
    (hτ : B.etaleTopology ≤ B.baseTopology τ) :
    IsIso ((PresheafOfModules.sheafification.{u}
        (𝟙 (FibredSite.baseRingStructureSheaf B S hS τ).obj)).map
      (smallEtaleSectionsGamma B S hS τ 𝓖)) := by
  have h1 := isLocallySurjective_smallEtaleSectionsGamma B S hS τ 𝓖 hτ
  have h2 := isLocallyInjective_smallEtaleSectionsGamma B S hS τ 𝓖 hτ
  have hW : (baseOverTopology B S hS τ).W
      ((PresheafOfModules.toPresheaf (FibredSite.baseRingStructureSheaf B S hS τ).obj).map
        (smallEtaleSectionsGamma B S hS τ 𝓖)) :=
    GrothendieckTopology.W_of_isLocallyBijective _ _
  rw [GrothendieckTopology.W_iff] at hW
  exact (isIso_iff_of_reflects_iso
    ((PresheafOfModules.sheafification.{u}
        (𝟙 (FibredSite.baseRingStructureSheaf B S hS τ).obj)).map
      (smallEtaleSectionsGamma B S hS τ 𝓖))
    (SheafOfModules.toSheaf (FibredSite.baseRingStructureSheaf B S hS τ))).1 hW

/-- **Stacks 070S part (3).**  For an *arbitrary* sheaf of `𝒪`-modules `𝓖` on the small étale
site `S_étale`, the inverse image `(id_{τ,étale})^*𝓖` along the morphism of ringed sites
`id_{τ,étale} : ((Sch/S)_τ, 𝒪) ⟶ (S_étale, 𝒪)` is the `τ`-sheafification of the étale sheaf
`(f : T → S) ↦ Γ(T, f_small^*𝓖)` on `(Sch/S)_τ`, where `f_small : T_étale ⟶ S_étale` is the
morphism of ringed small étale sites of Stacks 070R (2).

Here `(id_{τ,étale})^*` is
`AlgebraicGeometry.BigFppfOver.smallEtaleToBaseModulePullback`, the sections rule is
`AlgebraicGeometry.BigFppfOver.smallEtaleSectionsPresheafOfModules`, and the identification is
`CategoryTheory.SheafOfModules.pullbackIso` — which presents `(id_{τ,étale})^*𝓖` as the
`τ`-sheafification of the presheaf-level inverse image — followed by the `τ`-sheafification of
the comparison `AlgebraicGeometry.BigFppfOver.smallEtaleSectionsGamma`, which is locally
bijective by `AlgebraicGeometry.BigFppfOver.isIso_baseSheafification_map_smallEtaleSectionsGamma`.

The topology `τ` is one refining the étale topology: that is the range `τ ∈ {étale, smooth,
syntomic, fppf}` over which the source states this clause, the Zariski topology being excluded
there.  By
`AlgebraicGeometry.BigFppfOver.isContinuous_smallEtaleToFppf_of_etaleTopology_le` that single
hypothesis also supplies the continuity of the inclusion of the small étale site, i.e. the
existence of `id_{τ,étale}`, so the instance argument below is never an extra assumption: it is
discharged at each of the four `τ`, and nothing discharges it at `τ = Zariski`, which is exactly
why the source excludes that one.  `AlgebraicGeometry.BigFppfOver.baseSmallEtaleIsoSectionsEtale`
and `AlgebraicGeometry.BigFppfOver.baseSmallEtaleIsoSectionsFppf` are the hypothesis-free
instances at `τ = étale` and `τ = fppf`; `.baseSmallEtaleIsoSectionsSmooth` and
`.baseSmallEtaleIsoSectionsSyntomic`, in
`StacksFrontier/AlgebraicGeometry/Descent/AssociatedModulePullbackBigToSmallEtale.lean`, are the
other two. -/
@[stacks 070S "part (3)"]
public noncomputable def baseSmallEtalePullbackIsoSectionsSheafification
    (hτ : B.etaleTopology ≤ B.baseTopology τ) :
    (smallEtaleToBaseModulePullback B S hS τ).obj 𝓖 ≅
      (PresheafOfModules.sheafification.{u}
          (𝟙 (FibredSite.baseRingStructureSheaf B S hS τ).obj)).obj
        (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖) :=
  (SheafOfModules.pullbackIso.{u} (smallEtaleToBaseStructureMap B S hS τ)).app 𝓖 ≪≫
    @asIso _ _ _ _ _ (isIso_baseSheafification_map_smallEtaleSectionsGamma B S hS τ 𝓖 hτ)

omit [(smallEtaleToFppf B S hS).IsContinuous
  (SmallEtale.topology B.toBigEtaleSite S hS) (baseOverTopology B S hS τ)] in
/-- **Stacks 070S part (3) at `τ = étale`**: the instance of
`AlgebraicGeometry.BigFppfOver.baseSmallEtalePullbackIsoSectionsSheafification` at the étale
member of the five topologies, where the hypothesis on `τ` is reflexivity. -/
public noncomputable def baseSmallEtaleIsoSectionsEtale :
    (smallEtaleToBaseModulePullback B S hS .etale).obj 𝓖 ≅
      (PresheafOfModules.sheafification.{u}
          (𝟙 (FibredSite.baseRingStructureSheaf B S hS .etale).obj)).obj
        (smallEtaleSectionsPresheafOfModules B S hS .etale 𝓖) :=
  baseSmallEtalePullbackIsoSectionsSheafification B S hS .etale 𝓖 le_rfl

omit [(smallEtaleToFppf B S hS).IsContinuous
  (SmallEtale.topology B.toBigEtaleSite S hS) (baseOverTopology B S hS τ)] in
/-- **Stacks 070S part (3) at `τ = fppf`**: the instance of
`AlgebraicGeometry.BigFppfOver.baseSmallEtalePullbackIsoSectionsSheafification` at the fppf
member of the five topologies, where the hypothesis on `τ` is
`AlgebraicGeometry.Stack.etaleTopology_le_topology`. -/
public noncomputable def baseSmallEtaleIsoSectionsFppf :
    (smallEtaleToBaseModulePullback B S hS .fppf).obj 𝓖 ≅
      (PresheafOfModules.sheafification.{u}
          (𝟙 (FibredSite.baseRingStructureSheaf B S hS .fppf).obj)).obj
        (smallEtaleSectionsPresheafOfModules B S hS .fppf 𝓖) :=
  baseSmallEtalePullbackIsoSectionsSheafification B S hS .fppf 𝓖
    (AlgebraicGeometry.Stack.etaleTopology_le_topology B)

end AlgebraicGeometry.BigFppfOver

end
