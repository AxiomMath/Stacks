universe u

universe v v₁ v₂ v₃ u₁ u₂ u₃ w

namespace PresheafOfModules

/-- **The underlying presheaf of a pushforward is the restriction of the underlying presheaf.**
So a morphism of presheaves of abelian groups into the restriction along `F` of the presheaf
underlying `M` is one into the presheaf underlying the pushforward of `M`.  The identification is
`CategoryTheory.PresheafOfModules.pushforwardCompToPresheaf`; recording it here, for an arbitrary
functor and an arbitrary presheaf of modules, checks it once in the generic setting rather than
at each of the concrete presheaves of modules below. -/
public def homToPushforwardPresheaf {C : Type u₁} [Category.{v₁} C] {D : Type u₂}
    [Category.{v₂} D] {F : C ⥤ D} {R : Dᵒᵖ ⥤ RingCat.{w}} {S : Cᵒᵖ ⥤ RingCat.{w}}
    (φ : S ⟶ F.op ⋙ R) (M : PresheafOfModules.{v} R) {N : Cᵒᵖ ⥤ Ab.{v}}
    (α : N ⟶ F.op ⋙ M.presheaf) :
    N ⟶ ((PresheafOfModules.pushforward.{v} φ).obj M).presheaf :=
  α

section Comp

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D] {E : Type u₃}
  [Category.{v₃} E] {F : C ⥤ D} {G : D ⥤ E} {R : Dᵒᵖ ⥤ RingCat.{w}} {S : Cᵒᵖ ⥤ RingCat.{w}}
  {T : Eᵒᵖ ⥤ RingCat.{w}} (φ : S ⟶ F.op ⋙ R) (ψ : R ⟶ G.op ⋙ T)

/-- **Pushing forward along `F` and then `G` is pushing forward along `F ⋙ G`.**  So a morphism
of presheaves of modules into the pushforward along the composite structure map is one into the
iterated pushforward.  The identification is
`CategoryTheory.PresheafOfModules.pushforwardComp`; recording it here, for arbitrary functors
and an arbitrary presheaf of modules, checks it once in the generic setting rather than at each
of the concrete presheaves of modules below, where deciding it unfolds
`CategoryTheory.SheafOfModules.pullback` and the schemes' pullback cones. -/
public def homToPushforwardComp (M : PresheafOfModules.{v} T) {N : PresheafOfModules.{v} S}
    (f : N ⟶ (PresheafOfModules.pushforward.{v} (F := F ⋙ G)
      (φ ≫ Functor.whiskerLeft F.op ψ)).obj M) :
    N ⟶ (PresheafOfModules.pushforward.{v} φ).obj
      ((PresheafOfModules.pushforward.{v} ψ).obj M) :=
  f

/-- `CategoryTheory.PresheafOfModules.pushforwardComp` is the identity, so composing with it is
`CategoryTheory.PresheafOfModules.homToPushforwardComp`. -/
public theorem comp_pushforwardComp_inv_app (M : PresheafOfModules.{v} T)
    {N : PresheafOfModules.{v} S}
    (f : N ⟶ (PresheafOfModules.pushforward.{v} (F := F ⋙ G)
      (φ ≫ Functor.whiskerLeft F.op ψ)).obj M) :
    f ≫ (PresheafOfModules.pushforwardComp.{v} φ ψ).inv.app M =
      homToPushforwardComp φ ψ M f :=
  rfl

/-- `CategoryTheory.PresheafOfModules.homToPushforwardComp` carries a restriction map along the
composite structure map to the iterated restriction map. -/
public theorem homToPushforwardComp_comp_map {M M' : PresheafOfModules.{v} T} (g : M ⟶ M')
    {N : PresheafOfModules.{v} S}
    (f : N ⟶ (PresheafOfModules.pushforward.{v} (F := F ⋙ G)
      (φ ≫ Functor.whiskerLeft F.op ψ)).obj M) :
    homToPushforwardComp φ ψ M' (f ≫ (PresheafOfModules.pushforward.{v} (F := F ⋙ G)
        (φ ≫ Functor.whiskerLeft F.op ψ)).map g) =
      homToPushforwardComp φ ψ M f ≫ (PresheafOfModules.pushforward.{v} φ).map
        ((PresheafOfModules.pushforward.{v} ψ).map g) :=
  rfl

/-- `CategoryTheory.PresheafOfModules.homToPushforwardComp` is applied to the last factor. -/
public theorem comp_homToPushforwardComp (M : PresheafOfModules.{v} T)
    {N N' : PresheafOfModules.{v} S} (h : N' ⟶ N)
    (f : N ⟶ (PresheafOfModules.pushforward.{v} (F := F ⋙ G)
      (φ ≫ Functor.whiskerLeft F.op ψ)).obj M) :
    homToPushforwardComp φ ψ M (h ≫ f) = h ≫ homToPushforwardComp φ ψ M f :=
  rfl

end Comp

end PresheafOfModules

namespace AlgebraicGeometry.BigFppfOver

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) (τ : SiteKind)
  (𝓖 : SheafOfModules.{u} (SmallEtale.structureSheaf B.toBigEtaleSite S hS))

/-- Base change along a morphism to the base object of the big fppf category over `S` is
continuous, restated for the fppf spelling `B.obj hS` of that base object. -/
public instance isContinuous_smallEtaleBaseChange_fppfBase {X : B.Schemes}
    (a : X ⟶ B.obj hS) :
    Functor.IsContinuous (smallEtaleBaseChange B.toBigEtaleSite a)
      (SmallEtale.topology B.toBigEtaleSite (B.obj hS).obj (B.obj hS).property)
      (SmallEtale.topology B.toBigEtaleSite X.obj X.property) :=
  smallEtaleBaseChange_isContinuous B.toBigEtaleSite a

/-- The sections of `AlgebraicGeometry.SmallEtale.sectionsSheafTauPresheaf` at an object
`f : T → S` of the big `τ`-site form a module over the structure sheaf of the big `τ`-site
there: the module structure of the sections of `f_small^*𝓖` over the final object of
`T_étale`, over the structure ring of `T_étale`. -/
public instance moduleSmallEtaleSectionsObj (T : (BigFppfOver B S hS)ᵒᵖ) :
    Module ((FibredSite.baseRingStructureSheaf B S hS τ).obj.obj T)
      ((SmallEtale.sectionsSheafTauPresheaf B.toBigEtaleSite S hS 𝓖).obj T) :=
  inferInstanceAs (Module ((SmallEtale.structureSheaf B.toBigEtaleSite T.unop.left.obj
        T.unop.left.property).obj.obj
      (op (SmallEtale.final B.toBigEtaleSite T.unop.left.obj T.unop.left.property)))
    ((SmallEtale.sectionsSheafTauPullback B.toBigEtaleSite S hS 𝓖 T.unop).val.obj
      (op (SmallEtale.final B.toBigEtaleSite T.unop.left.obj T.unop.left.property))))

/-- **The presheaf of `𝒪`-modules `(f : T → S) ↦ Γ(T, f_small^*𝓖)` on the big `τ`-site of
`S`**, for an arbitrary sheaf of `𝒪`-modules `𝓖` on `S_étale`.  This is
`AlgebraicGeometry.SmallEtale.sectionsSheafTauPresheafOfModules` read over the fppf presentation
of the category of `S`-schemes and over the structure sheaf of the big `τ`-site; the two
spellings of the category and of the structure presheaf of rings agree. -/
public def smallEtaleSectionsPresheafOfModules :
    PresheafOfModules.{u} (FibredSite.baseRingStructureSheaf B S hS τ).obj :=
  PresheafOfModules.ofPresheaf
    (SmallEtale.sectionsSheafTauPresheaf B.toBigEtaleSite S hS 𝓖)
    (fun {_ _} f r m =>
      SmallEtale.sectionsSheafTauMap_smul B.toBigEtaleSite S hS 𝓖 f.unop r m)

/-- The sections of `AlgebraicGeometry.BigFppfOver.smallEtaleSectionsPresheafOfModules` over an
object `f : T → S` of the big `τ`-site are the global sections of the inverse image `f_small^*𝓖`
along the morphism of ringed sites `ε_f` of Stacks 070R (2). -/
public theorem smallEtaleSectionsPresheafOfModules_obj (T : BigFppfOver B S hS) :
    (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖).presheaf.obj (op T) =
      ((SheafOfModules.pullback.{u}
            (SmallEtale.smallEtaleStructureMapRing B.toBigEtaleSite T.hom)).obj
          𝓖).val.presheaf.obj
        (op (SmallEtale.final B.toBigEtaleSite T.left.obj T.left.property)) :=
  rfl


include τ in
/-- **A section of `f_small^*𝓖` over the final object killed by restriction along an isomorphism
of the big `τ`-site is zero.**  Restriction along the inverse undoes it, by
`AlgebraicGeometry.SmallEtale.sectionsSheafTauMap_id` and
`AlgebraicGeometry.SmallEtale.sectionsSheafTauMap_comp`, read through
`AlgebraicGeometry.BigFppfOver.smallEtaleSectionsPresheafOfModules`.

The objects are left as parameters, which is the whole point of recording this separately: at a
concrete pair — the object `T` and the image `i_T(T/T)` of the final object — deciding that the
sections of the sections rule and the sections of `f_small^*𝓖` over the final object are the same
group unfolds `CategoryTheory.SheafOfModules.pullback` and the schemes' pullback cones, while
over parameters it is immediate and the concrete use is a syntactic instantiation. -/
public theorem eq_zero_of_sectionsSheafTauMap_eq_zero {T₁ T₂ : BigFppfOver B S hS} (e : T₂ ≅ T₁)
    (x : (SmallEtale.sectionsSheafTauPullback B.toBigEtaleSite S hS 𝓖 T₁).val.obj
      (op (SmallEtale.final B.toBigEtaleSite T₁.left.obj T₁.left.property)))
    (hx : SmallEtale.sectionsSheafTauMap B.toBigEtaleSite S hS 𝓖 e.hom x = 0) :
    x = 0 := by
  have hcomp : e.hom.op ≫ e.inv.op = 𝟙 (op T₁) :=
    (Eq.symm op_comp).trans (congrArg (fun k : T₁ ⟶ T₁ => k.op) (Iso.inv_hom_id e))
  have hmap : (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖).map e.hom.op x = 0 := hx
  refine Eq.trans (CategoryTheory.congr_fun
    ((smallEtaleSectionsPresheafOfModules B S hS τ 𝓖).map_id (op T₁)).symm _) ?_
  refine Eq.trans (congrArg (fun k : op T₁ ⟶ op T₁ =>
    (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖).map k x) hcomp.symm) ?_
  refine Eq.trans ((smallEtaleSectionsPresheafOfModules B S hS τ 𝓖).map_comp_apply
    e.hom.op e.inv.op x) ?_
  refine Eq.trans (congrArg
    (fun z => (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖).map e.inv.op z) hmap) ?_
  exact map_zero _


/-! ### The comparison with the presheaf-level inverse image -/

variable [(smallEtaleToFppf B S hS).IsContinuous
  (SmallEtale.topology B.toBigEtaleSite S hS) (baseOverTopology B S hS τ)]

/-- The localization map of the sections rule, as a natural transformation of presheaves of
abelian groups on the small étale site: at an étale `V / S` it is
`AlgebraicGeometry.SmallEtale.sectionsSheafTauLocApp`, and its naturality is
`AlgebraicGeometry.SmallEtale.sectionsSheafTauLocApp_naturality`. -/
public def smallEtaleSectionsLocNat :
    𝓖.val.presheaf ⟶
      ((PresheafOfModules.pushforward.{u}
          (smallEtaleToBaseStructureMap B S hS τ).hom).obj
        (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖)).presheaf :=
  PresheafOfModules.homToPushforwardPresheaf (smallEtaleToBaseStructureMap B S hS τ).hom
    (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖)
    (show 𝓖.val.presheaf ⟶ (smallEtaleToFppf B S hS).op ⋙
        SmallEtale.sectionsSheafTauPresheaf B.toBigEtaleSite S hS 𝓖 from
      { app := fun V => SmallEtale.sectionsSheafTauLocApp B.toBigEtaleSite S hS 𝓖 V.unop
        naturality := fun _ _ k =>
          SmallEtale.sectionsSheafTauLocApp_naturality B.toBigEtaleSite S hS 𝓖 k.unop })

/-- **The localization map `𝓖 ⟶ (id_{τ,étale})_*(sections rule)`.**  On sections over an étale
`V / S` it is the unit along `ε_v` followed by restriction along the diagonal; it is linear by
`AlgebraicGeometry.SmallEtale.sectionsSheafTauLocApp_smul`. -/
public def smallEtaleSectionsLoc :
    𝓖.val ⟶ (PresheafOfModules.pushforward.{u}
        (smallEtaleToBaseStructureMap B S hS τ).hom).obj
      (smallEtaleSectionsPresheafOfModules B S hS τ 𝓖) :=
  PresheafOfModules.homMk (smallEtaleSectionsLocNat B S hS τ 𝓖)
    (fun V r m => SmallEtale.sectionsSheafTauLocApp_smul B.toBigEtaleSite S hS 𝓖 V.unop r m)

/-- **The comparison `γ` of Stacks 070S part (3)**: the morphism from the presheaf-level inverse
image of `𝓖` along the inclusion of the small étale site to the sections rule, adjoint to the
localization map. -/
public def smallEtaleSectionsGamma :
    (PresheafOfModules.pullback.{u} (smallEtaleToBaseStructureMap B S hS τ).hom).obj 𝓖.val ⟶
      smallEtaleSectionsPresheafOfModules B S hS τ 𝓖 :=
  ((PresheafOfModules.pullbackPushforwardAdjunction.{u}
    (smallEtaleToBaseStructureMap B S hS τ).hom).homEquiv _ _).symm
      (smallEtaleSectionsLoc B S hS τ 𝓖)


/-- **`γ`'s transpose is the localization map**, which is how `γ` is defined. -/
public theorem homEquiv_smallEtaleSectionsGamma :
    ((PresheafOfModules.pullbackPushforwardAdjunction.{u}
        (smallEtaleToBaseStructureMap B S hS τ).hom).homEquiv _ _)
        (smallEtaleSectionsGamma B S hS τ 𝓖) =
      smallEtaleSectionsLoc B S hS τ 𝓖 :=
  Equiv.apply_symm_apply _ _

