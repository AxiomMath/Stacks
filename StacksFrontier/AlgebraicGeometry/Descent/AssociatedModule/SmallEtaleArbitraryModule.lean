module

public import StacksFrontier.AlgebraicGeometry.Descent.AssociatedModule.SmallEtaleLocalBijectivity
public import StacksFrontier.AlgebraicGeometry.Descent.SectionsPullbackComparison.ArbitraryModule

/-!
# Stacks 070S (2) for an arbitrary sheaf of modules

Let `S` be a scheme and `F` an arbitrary sheaf of `𝒪_S`-modules.  Stacks Lemma 070S (2) says
that the pullback of `F` along the morphism of ringed sites
`id_{small,étale,Zar} : (S_étale, 𝒪) → (S_Zar, 𝒪_S)` is the étale sheafification of the
presheaf `(f : T → S) ↦ Γ(T, f^*F)` on `S_étale`.  As for the big sites, the pullback is the
sheafification of the pullback of presheaves of modules, and the lemma is the local
bijectivity of the comparison morphism, the transpose under
`CategoryTheory.PresheafOfModules.pullbackPushforwardAdjunction` of the map pulling a section of
`F` over an open `U` of `S` back to the open subscheme `U`.

The argument is that of
`StacksFrontier.AlgebraicGeometry.Descent.SectionsPullbackComparison.ArbitraryModule` for the big
sites, run on the small étale site: an open subscheme of an étale `S`-scheme is étale over `S`,
so the opens of an object are objects of the site, and the inputs which see no site —
`AlgebraicGeometry.exists_span_pullbackSection`,
`PresheafOfModules.mem_pullbackUnitSubmodule` and
`AlgebraicGeometry.exists_eq_map_of_zariskiPullbackToSheaf_app_eq` — are used as they are.

## Main definitions

* `AlgebraicGeometry.SmallEtale.pullbackSectionsPresheaf`: the presheaf of modules
  `(f : T → S) ↦ Γ(T, f^*F)` on `S_étale`, for an arbitrary module.
* `AlgebraicGeometry.SmallEtale.pullbackSectionsComparison`: the comparison of Stacks 070S (2).
* `AlgebraicGeometry.SmallEtale.sectionSubordinateCover` and
  `AlgebraicGeometry.SmallEtale.zariskiEqualizerCover`: the coverings on which local
  surjectivity and local injectivity are witnessed.
* `AlgebraicGeometry.SmallEtale.openSubBeta`: the transpose of the generators of the
  presheaf-level pullback along the inclusion of the small Zariski site of an object.

## Main results

* `AlgebraicGeometry.SmallEtale.isLocallySurjective_pullbackSectionsComparison` and
  `AlgebraicGeometry.SmallEtale.isLocallyInjective_pullbackSectionsComparison`: the comparison is
  locally bijective for the étale topology.
* `AlgebraicGeometry.SmallEtale.isIso_sheafification_map_pullbackSectionsComparison`: its
  sheafification is an isomorphism.
* `AlgebraicGeometry.SmallEtale.associatedModuleIsoPullbackSections`: **Stacks 070S (2)** for an
  arbitrary sheaf of `𝒪_S`-modules.
* `AlgebraicGeometry.SmallEtale.sectionsPresheafOfModules_eq_pullbackSectionsPresheaf` and
  `AlgebraicGeometry.SmallEtale.sectionsComparison_eq_pullbackSectionsComparison`: for a
  quasi-coherent `F` these are the presheaf and comparison of
  `StacksFrontier.AlgebraicGeometry.Descent.AssociatedModule.SmallEtaleSectionsComparison`.

## Implementation notes

The quasi-coherent form, `AlgebraicGeometry.SmallEtale.associatedModuleIsoSections`, rests on
the affine base-change description of the sections of a pullback, which needs quasi-coherence;
the covering step here is instead the local generation statement and the transpose
`AlgebraicGeometry.SmallEtale.openSubBeta`.  The coverings are produced by
`AlgebraicGeometry.SmallEtale.presieve₀_mem_precoverage_of_isOpenImmersion`, the topology of the
small étale site being generated by its own covering families rather than localized from an
ambient site.

## References

* [Stacks Project, Tag 070S](https://stacks.math.columbia.edu/tag/070S)
* [Stacks Project, Tag 03DS](https://stacks.math.columbia.edu/tag/03DS)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.SmallEtale

variable (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The unit followed by the pushforward of the transpose of `g` is `g`. -/
private theorem unit_comp_map_homEquiv_symm {C D : Type*} [Category C] [Category D] {F : C ⥤ D}
    {R₁ : Cᵒᵖ ⥤ RingCat.{u}} {R₂ : Dᵒᵖ ⥤ RingCat.{u}} (φ : R₁ ⟶ F.op ⋙ R₂)
    [(PresheafOfModules.pushforward.{u} φ).IsRightAdjoint] {M : PresheafOfModules.{u} R₁}
    {N : PresheafOfModules.{u} R₂} (g : M ⟶ (PresheafOfModules.pushforward.{u} φ).obj N) :
    (PresheafOfModules.pullbackPushforwardAdjunction.{u} φ).unit.app M ≫
        (PresheafOfModules.pushforward.{u} φ).map
          (((PresheafOfModules.pullbackPushforwardAdjunction.{u} φ).homEquiv _ _).symm g) = g :=
  ((PresheafOfModules.pullbackPushforwardAdjunction.{u} φ).homEquiv_unit _ _ _).symm.trans
    (Equiv.apply_symm_apply _ _)

/-- The transpose of `g` sends the image under the unit of `a` to `g a`. -/
private theorem app_homEquiv_symm_unit_app {C D : Type*} [Category C] [Category D] {F : C ⥤ D}
    {R₁ : Cᵒᵖ ⥤ RingCat.{u}} {R₂ : Dᵒᵖ ⥤ RingCat.{u}} (φ : R₁ ⟶ F.op ⋙ R₂)
    [(PresheafOfModules.pushforward.{u} φ).IsRightAdjoint] {M : PresheafOfModules.{u} R₁}
    {N : PresheafOfModules.{u} R₂} (g : M ⟶ (PresheafOfModules.pushforward.{u} φ).obj N)
    (U : Cᵒᵖ) (a : M.obj U) :
    (((PresheafOfModules.pullbackPushforwardAdjunction.{u} φ).homEquiv _ _).symm g).app
        (F.op.obj U) (((PresheafOfModules.pullbackPushforwardAdjunction.{u} φ).unit.app M).app U
          a) = g.app U a := by
  have h := congrArg (fun k => PresheafOfModules.Hom.app k U)
    (unit_comp_map_homEquiv_symm φ g)
  rw [PresheafOfModules.comp_app] at h
  exact ConcreteCategory.congr_hom h a

/-- **Stacks 03DS on the small étale site, for an arbitrary module.**  For a module `F` on `S`,
the presheaf on the small étale site of `S` sending an object `T ⟶ S` to `Γ(T, T.hom^*F)`, as a
presheaf of modules over the structure sheaf of that site. -/
public noncomputable def pullbackSectionsPresheaf (F : S.Modules) :
    PresheafOfModules.{u} (structureSheaf B S hS).obj :=
  sitePullbackSectionsPresheafOfModules S F (toOver B S hS)

/-- For a quasi-coherent `F`, `AlgebraicGeometry.SmallEtale.pullbackSectionsPresheaf` is
`AlgebraicGeometry.SmallEtale.sectionsPresheafOfModules`. -/
public theorem sectionsPresheafOfModules_eq_pullbackSectionsPresheaf (F : S.Modules)
    [F.IsQuasicoherent] :
    SmallEtale.sectionsPresheafOfModules B S hS F = SmallEtale.pullbackSectionsPresheaf B S hS F :=
  rfl

/-- Pulling a section of `F` over an open `U` of `S` back to the open subscheme `U`, as a map
of sections over `U`.  This is the component of
`AlgebraicGeometry.SmallEtale.pullbackSectionsUnit`. -/
public noncomputable def pullbackSectionsUnitApp (F : S.Modules)
    (U : (S.Opens)ᵒᵖ) :
    ((SheafOfModules.forget S.ringCatSheaf).obj F).obj U ⟶
      ((PresheafOfModules.pushforward.{u} (SmallEtale.structureMap B S hS).hom).obj
        (SmallEtale.pullbackSectionsPresheaf B S hS F)).obj U :=
  ModuleCat.homEquiv.symm {
    toFun := fun a =>
      pullbackSectionHom U.unop.ι F U.unop ⊤ (Scheme.Opens.top_le_ι_preimage le_rfl) a
    map_add' := fun a b => map_add _ a b
    map_smul' := fun r a => by
      refine (pullbackSectionHom_smul U.unop.ι F U.unop ⊤
        (Scheme.Opens.top_le_ι_preimage le_rfl) r a).trans ?_
      exact congrArg
        (fun s : Γ(U.unop.toScheme, ⊤) => s • pullbackSectionHom U.unop.ι F U.unop ⊤
          (Scheme.Opens.top_le_ι_preimage le_rfl) a)
        (congrArg (fun g : Γ(S, U.unop) ⟶ Γ(U.unop, ⊤) => ConcreteCategory.hom g r)
          (Scheme.Opens.ι_appLE_top U.unop (Scheme.Opens.top_le_ι_preimage le_rfl))) }

/-- The value of `AlgebraicGeometry.SmallEtale.pullbackSectionsUnitApp` on a section is its
pullback to the open subscheme. -/
@[simp]
public theorem pullbackSectionsUnitApp_apply (F : S.Modules) (U : (S.Opens)ᵒᵖ)
    (a : ((SheafOfModules.forget S.ringCatSheaf).obj F).obj U) :
    SmallEtale.pullbackSectionsUnitApp B S hS F U a =
      pullbackSectionHom U.unop.ι F U.unop ⊤ (Scheme.Opens.top_le_ι_preimage le_rfl) a :=
  rfl

/-- **Pulling sections back, as a morphism out of `F`.**  A section of `F` over an open `U` of
`S` pulls back to a section of `U.ι^*F` over all of the open subscheme `U`, and this is natural
in `U`: it is a morphism from `F` to the restriction, along the inclusion of the small Zariski
site of `S`, of the pullback-sections presheaf of modules of the small étale site. -/
public noncomputable def pullbackSectionsUnit (F : S.Modules) :
    (SheafOfModules.forget S.ringCatSheaf).obj F ⟶
      (PresheafOfModules.pushforward.{u} (structureMap B S hS).hom).obj
        (pullbackSectionsPresheaf B S hS F) where
  app U := pullbackSectionsUnitApp B S hS F U
  naturality {U V} h := by
    ext a
    have hUV : V.unop ≤ U.unop := leOfHom h.unop
    refine Eq.trans (pullbackSectionHom_map (Scheme.Opens.ι V.unop) F U.unop V.unop hUV ⊤
      (Scheme.Opens.top_le_ι_preimage le_rfl) (Scheme.Opens.top_le_ι_preimage hUV) a) ?_
    exact (pullbackSectionsMap_pullbackSectionHom F
      ((toOver B S hS).map ((opensToSmallEtale B S hS).map h.unop))
      U.unop (Scheme.Opens.top_le_ι_preimage le_rfl)
      (Scheme.Opens.top_le_ι_preimage hUV) a).symm

/-- **The comparison of Stacks 070S (2).**  The canonical morphism from the pullback of
presheaves of modules along the structure-sheaf comparison of the small étale site of `S` to the
pullback-sections presheaf of Stacks 03DS: the transpose, under
`CategoryTheory.PresheafOfModules.pullbackPushforwardAdjunction`, of the map which pulls a
section of `F` over an open `U` of `S` back to the open subscheme `U`.

Stacks Lemma 070S part (2) is the statement that this morphism is locally bijective for the
small étale topology.  That statement is not proved in this file; granted it,
`CategoryTheory.PresheafOfModules.sheafification` turns the comparison into an isomorphism and
`AlgebraicGeometry.SmallEtale.associatedModuleSheafificationIso` identifies the
associated-module functor of the small étale site with the sheafification of the sections
description. -/
public noncomputable def pullbackSectionsComparison (F : S.Modules) :
    (PresheafOfModules.pullback.{u} (SmallEtale.structureMap B S hS).hom).obj
        ((SheafOfModules.forget S.ringCatSheaf).obj F) ⟶
      SmallEtale.pullbackSectionsPresheaf B S hS F :=
  ((PresheafOfModules.pullbackPushforwardAdjunction.{u} (structureMap B S hS).hom).homEquiv
    _ _).symm (pullbackSectionsUnit B S hS F)

/-- **The comparison is determined by pulling sections back.**  Transposing
`AlgebraicGeometry.SmallEtale.pullbackSectionsComparison` back across the adjunction returns the
map which pulls a section of `F` over an open `U` of `S` back to the open subscheme `U`.  This is
the only property of the comparison that is used below. -/
public theorem unit_comp_map_pullbackSectionsComparison (F : S.Modules) :
    (PresheafOfModules.pullbackPushforwardAdjunction.{u}
          (SmallEtale.structureMap B S hS).hom).unit.app
          ((SheafOfModules.forget S.ringCatSheaf).obj F) ≫
        (PresheafOfModules.pushforward.{u} (SmallEtale.structureMap B S hS).hom).map
          (SmallEtale.pullbackSectionsComparison B S hS F) =
      SmallEtale.pullbackSectionsUnit B S hS F :=
  unit_comp_map_homEquiv_symm _ _

/-- **The comparison, on a pulled-back section over an open of `S`.**  The component of
`AlgebraicGeometry.SmallEtale.pullbackSectionsComparison` at the object `U → S` of the small étale
site carries the image of a section `a` of `F` over `U` under the unit of the pullback--pushforward
adjunction to the pullback of `a` to the open subscheme `U`.  This is
`AlgebraicGeometry.SmallEtale.unit_comp_map_pullbackSectionsComparison` evaluated at `U` and
applied to `a`. -/
public theorem pullbackSectionsComparison_unit_app (F : S.Modules) (U : S.Opens)
    (a : ((SheafOfModules.forget S.ringCatSheaf).obj F).obj (op U)) :
    (pullbackSectionsComparison B S hS F).app (op ((opensToSmallEtale B S hS).obj U))
        (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
            (structureMap B S hS).hom).unit.app
          ((SheafOfModules.forget S.ringCatSheaf).obj F)).app (op U) a) =
      pullbackSectionHom U.ι F U ⊤ (Scheme.Opens.top_le_ι_preimage le_rfl) a :=
  app_homEquiv_symm_unit_app _ (pullbackSectionsUnit B S hS F) (op U) a

/-- **The comparison on a generator.**  Over an object `T` of the small étale site whose
structure morphism factors through an open `U` of `S`, the component of
`AlgebraicGeometry.SmallEtale.pullbackSectionsComparison` carries the restriction to `T` of the
unit's image of a section `a` of `F` over `U` to the pullback of `a` to `T`.

This is naturality of the comparison along `j`, then
`AlgebraicGeometry.SmallEtale.pullbackSectionsComparison_unit_app`, then
`AlgebraicGeometry.pullbackSectionsMap_pullbackSectionHom`. -/
public theorem pullbackSectionsComparison_app_map_unit (F : S.Modules)
    {T : SmallEtale B S hS} {U : S.Opens} (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (hX : (⊤ : ((toScheme B S hS).obj T).Opens) ≤ T.obj.hom.hom ⁻¹ᵁ U)
    (a : ((SheafOfModules.forget S.ringCatSheaf).obj F).obj (op U)) :
    ModuleCat.Hom.hom ((pullbackSectionsComparison B S hS F).app (op T))
        (((PresheafOfModules.pullback.{u} (structureMap B S hS).hom).obj
          ((SheafOfModules.forget S.ringCatSheaf).obj F)).map j.op
            (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
              (structureMap B S hS).hom).unit.app
                ((SheafOfModules.forget S.ringCatSheaf).obj F)).app (op U) a)) =
      (pullbackSectionHom T.obj.hom.hom F U ⊤ hX a :
        Γ((Scheme.Modules.pullback T.obj.hom.hom).obj F, ⊤)) := by
  refine Eq.trans
    (PresheafOfModules.naturality_apply (pullbackSectionsComparison B S hS F) j.op _) ?_
  refine Eq.trans (congrArg (fun z => (pullbackSectionsPresheaf B S hS F).map j.op z)
    (pullbackSectionsComparison_unit_app B S hS F U a)) ?_
  exact pullbackSectionsMap_pullbackSectionHom F ((toOver B S hS).map j) U
    (Scheme.Opens.top_le_ι_preimage le_rfl) hX a

/-- **The image of the comparison at an object is a submodule containing every pulled-back
section.**  If an object `T` of the small étale site of `S` factors through an open `U` of `S`,
then every element of the `Γ(T, 𝒪_T)`-span of the pullbacks to `T` of the sections of `F` over `U`
is in the image of the component of `AlgebraicGeometry.SmallEtale.pullbackSectionsComparison` at
`T`: the image contains each such pullback by
`AlgebraicGeometry.SmallEtale.pullbackSectionsComparison_app_map_unit`, and it is a submodule over
the global functions of `T` because the comparison is a morphism of presheaves *of modules*. -/
public theorem mem_range_app_pullbackSectionsComparison_of_mem_span (F : S.Modules)
    {T : SmallEtale B S hS} {U : S.Opens} (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (hX : (⊤ : ((toScheme B S hS).obj T).Opens) ≤ T.obj.hom.hom ⁻¹ᵁ U)
    {y : Γ((Scheme.Modules.pullback T.obj.hom.hom).obj F, ⊤)}
    (hy : y ∈ Submodule.span Γ((toScheme B S hS).obj T, ⊤)
      (Set.range fun a : Γ(F, U) => pullbackSectionHom T.obj.hom.hom F U ⊤ hX a)) :
    ∃ x, ModuleCat.Hom.hom ((pullbackSectionsComparison B S hS F).app (op T)) x = y := by
  have hmem : ∀ a : Γ(F, U), ∃ x, ModuleCat.Hom.hom
      ((pullbackSectionsComparison B S hS F).app (op T)) x =
      (pullbackSectionHom T.obj.hom.hom F U ⊤ hX a :
        Γ((Scheme.Modules.pullback T.obj.hom.hom).obj F, ⊤)) :=
    fun a => ⟨_, pullbackSectionsComparison_app_map_unit B S hS F j hX a⟩
  let Q : Submodule Γ((toScheme B S hS).obj T, ⊤)
      Γ((Scheme.Modules.pullback T.obj.hom.hom).obj F, ⊤) :=
    { carrier := {y | ∃ x, ModuleCat.Hom.hom
        ((pullbackSectionsComparison B S hS F).app (op T)) x = y}
      add_mem' := by
        rintro y z ⟨p, hp⟩ ⟨q, hq⟩
        exact ⟨p + q, by rw [map_add, hp, hq]; rfl⟩
      zero_mem' := ⟨0, map_zero _⟩
      smul_mem' := by
        rintro c y ⟨p, hp⟩
        refine ⟨(show (structureSheaf B S hS).obj.obj (op T) from c) • p, ?_⟩
        rw [map_smul, hp]
        rfl }
  have hle : Submodule.span Γ((toScheme B S hS).obj T, ⊤)
      (Set.range fun a : Γ(F, U) =>
        pullbackSectionHom T.obj.hom.hom F U ⊤ hX a) ≤ Q :=
    Submodule.span_le.2 (by rintro z ⟨a, rfl⟩; exact hmem a)
  exact hle hy

/-- **Restriction along the open immersion of an open of an object, in the pullback-sections
presheaf.**  It is `AlgebraicGeometry.openSubSections` of the restriction of the section to that
open, exactly as for the big sites. -/
public theorem pullbackSectionsPresheaf_map_openSubHom (F : S.Modules)
    (T : SmallEtale B S hS) (V : T.obj.left.obj.Opens)
    (s : Γ((Scheme.Modules.pullback T.obj.hom.hom).obj F, ⊤)) :
    (pullbackSectionsPresheaf B S hS F).map (openSubHom B S hS T V).op s =
      openSubSections T.obj.hom.hom F V
        (((Scheme.Modules.pullback T.obj.hom.hom).obj F).val.map
          (homOfLE (le_top (a := V))).op s) :=
  pullbackSectionsMap_eq_openSubSections T.obj.hom.hom F V
    ((toOver B S hS).map (openSubHom B S hS T V)) rfl s

/-- **The covering of an object by the opens over which a given section is a combination of
pulled-back sections.**  Its index type is the pairs of an open `V` of the underlying scheme of
`T` and an open `U` of `S` with `V ≤ T.hom⁻¹U` such that the restriction of `s` to `V` lies in the
span of the pullbacks of the sections of `F` over `U`; those opens cover by
`AlgebraicGeometry.exists_span_pullbackSection`, which needs no hypothesis on `F`. -/
public noncomputable def sectionSubordinateCover (F : S.Modules) (T : SmallEtale B S hS)
    (s : Γ((Scheme.Modules.pullback T.obj.hom.hom).obj F, ⊤)) : PreZeroHypercover.{u + 1} T where
  I₀ := ULift.{u + 1} (Σ V : T.obj.left.obj.Opens, {U : S.Opens //
    ∃ hVU : V ≤ T.obj.hom.hom ⁻¹ᵁ U,
      ((Scheme.Modules.pullback T.obj.hom.hom).obj F).val.map
          (homOfLE (le_top (a := V))).op s ∈
        Submodule.span Γ(T.obj.left.obj, V)
          (Set.range fun a : Γ(F, U) => pullbackSectionHom T.obj.hom.hom F U V hVU a)})
  X i := openSubObj B S hS T i.down.1
  f i := openSubHom B S hS T i.down.1

/-- **The opens of `AlgebraicGeometry.SmallEtale.sectionSubordinateCover` cover, for the small
étale topology.**  The members are open immersions and they are jointly surjective by
`AlgebraicGeometry.exists_span_pullbackSection`, so
`AlgebraicGeometry.SmallEtale.presieve₀_mem_precoverage_of_isOpenImmersion` makes the family a
covering family. -/
public theorem mem_topology_sieve₀_sectionSubordinateCover (F : S.Modules)
    (T : SmallEtale B S hS) (s : Γ((Scheme.Modules.pullback T.obj.hom.hom).obj F, ⊤)) :
    (sectionSubordinateCover B S hS F T s).sieve₀ ∈ topology B S hS T := by
  refine Precoverage.generate_mem_toGrothendieck
    (presieve₀_mem_precoverage_of_isOpenImmersion B S hS _ (fun x => ?_)
      (fun i => inferInstanceAs (IsOpenImmersion (i.down.1.ι))))
  obtain ⟨W, hWtop, U, hWU, hxW, hspan⟩ :=
    exists_span_pullbackSection T.obj.hom.hom F ⊤ s x trivial
  exact ⟨⟨⟨W, ⟨U, hWU, hspan⟩⟩⟩, ⟨⟨x, hxW⟩, rfl⟩⟩

/-- **The comparison of Stacks 070S (2) is locally surjective for the small étale topology, for
an arbitrary sheaf of `𝒪_S`-modules.**  Every section of the pullback-sections presheaf is,
locally on the small étale site, in the image of
`AlgebraicGeometry.SmallEtale.pullbackSectionsComparison`.

The opens of an object over which the section is a combination of pullbacks of sections of `F`
cover it, by `AlgebraicGeometry.SmallEtale.mem_topology_sieve₀_sectionSubordinateCover`, and over
each of those the image of the comparison contains the restricted section, by
`AlgebraicGeometry.SmallEtale.mem_range_app_pullbackSectionsComparison_of_mem_span` together with
the bridge `AlgebraicGeometry.SmallEtale.pullbackSectionsPresheaf_map_openSubHom`.  No affineness
and no hypothesis on `F` is used.

This is half of Stacks 070S (2); the other half is
`AlgebraicGeometry.SmallEtale.isLocallyInjective_pullbackSectionsComparison`. -/
public instance isLocallySurjective_pullbackSectionsComparison (F : S.Modules) :
    Presheaf.IsLocallySurjective (topology B S hS)
      ((PresheafOfModules.toPresheaf (structureSheaf B S hS).obj).map
        (pullbackSectionsComparison B S hS F)) where
  imageSieve_mem {T} s := by
    refine (topology B S hS).superset_covering ?_
      (mem_topology_sieve₀_sectionSubordinateCover B S hS F T s)
    rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
    intro i
    obtain ⟨⟨V, U, hVU, hspan⟩⟩ := i
    have hX : (⊤ : ((toScheme B S hS).obj (openSubObj B S hS T V)).Opens) ≤
        (openSubObj B S hS T V).obj.hom.hom ⁻¹ᵁ U := fun w _ => hVU w.2
    have hr : Set.range ⇑(openSubObj B S hS T V).obj.hom.hom ⊆ (U : Set S) := by
      rintro z ⟨w, rfl⟩
      exact hVU w.2
    obtain ⟨x, hx⟩ := mem_range_app_pullbackSectionsComparison_of_mem_span B S hS F
      (homOfRangeLe B S hS U hr) hX
      (openSubSections_mem_span T.obj.hom.hom F V U hVU hX hspan)
    exact ⟨x, hx.trans (pullbackSectionsPresheaf_map_openSubHom B S hS F T V s).symm⟩

/-- **The source of the comparison of Stacks 070S (2).**  The pullback, as a presheaf of modules,
of a module `F` on `S` along the structure-sheaf comparison of the small étale
site; `AlgebraicGeometry.SmallEtale.associatedModuleSheafificationIso` presents the associated
module of `F` as its sheafification. -/
public noncomputable abbrev presheafPullback (F : S.Modules) :
    PresheafOfModules.{u} (SmallEtale.structureSheaf B S hS).obj :=
  (PresheafOfModules.pullback.{u} (structureMap B S hS).hom).obj
    ((SheafOfModules.forget S.ringCatSheaf).obj F)

/-- The unit of the pullback--pushforward adjunction at a module `F` on `S`.  Over
an open `U` of `S` it sends a section of `F` to a section of
`AlgebraicGeometry.SmallEtale.presheafPullback` over the object `U → S` of the small étale
site. -/
public noncomputable abbrev presheafPullbackUnit (F : S.Modules) :
    (SheafOfModules.forget S.ringCatSheaf).obj F ⟶
      (PresheafOfModules.pushforward.{u} (SmallEtale.structureMap B S hS).hom).obj
        (SmallEtale.presheafPullback B S hS F) :=
  (PresheafOfModules.pullbackPushforwardAdjunction.{u} (structureMap B S hS).hom).unit.app
    ((SheafOfModules.forget S.ringCatSheaf).obj F)

/-- **A generator of the source of the comparison.**  Given an object `T` of the small étale site
factoring through an open `U` of `S` by `j`, the restriction along `j` of the image under the unit
of a section `a` of `F` over `U`.  These are the elements of
`PresheafOfModules.pullbackUnitGenerators`, so by
`PresheafOfModules.span_pullbackUnitGenerators_eq_top` they span the sections of
`AlgebraicGeometry.SmallEtale.presheafPullback` over `T`. -/
public noncomputable abbrev presheafPullbackGenerator (F : S.Modules)
    {T : SmallEtale B S hS} {U : S.Opens} (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (a : Γ(F, U)) :
    (presheafPullback B S hS F).obj (op T) :=
  (presheafPullback B S hS F).map j.op ((presheafPullbackUnit B S hS F).app (op U) a)

/-- The sections of `AlgebraicGeometry.SmallEtale.presheafPullback` over an object `T` as a
module over the *commutative* ring `Γ(T, 𝒪_T)`, rather than over the `RingCat` object
`(structureSheaf B S hS).obj.obj (op T)` which carries them.  The two rings and the two module
structures are definitionally equal, but instance search does not cross the identification, and
extension of scalars needs the commutative one. -/
public noncomputable instance module_gamma_presheafPullback (F : S.Modules)
    (T : SmallEtale B S hS) :
    Module ↥Γ(T.obj.left.obj, ⊤) ↥((presheafPullback B S hS F).obj (op T)) :=
  inferInstanceAs (Module ((structureSheaf B S hS).obj.obj (op T)) _)

/-- **A generator is semilinear in its section.**  Scaling the section of `F` scales the generator
by the restriction of the scalar to the object, the unit being a morphism of presheaves of
modules and restriction being semilinear over the structure sheaf. -/
public theorem presheafPullbackGenerator_smul (F : S.Modules)
    {T : SmallEtale B S hS} {U : S.Opens} (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (r : Γ(S, U)) (a : Γ(F, U)) :
    presheafPullbackGenerator B S hS F j (r • a) =
      (structureSheaf B S hS).obj.map j.op ((structureMap B S hS).hom.app (op U) r) •
        presheafPullbackGenerator B S hS F j a := by
  refine Eq.trans (congrArg (fun z => (presheafPullback B S hS F).map j.op z)
    (((presheafPullbackUnit B S hS F).app (op U)).hom.map_smul r a)) ?_
  exact PresheafOfModules.map_smul (presheafPullback B S hS F) j.op
    ((structureMap B S hS).hom.app (op U) r) ((presheafPullbackUnit B S hS F).app (op U) a)

/-- The component of `AlgebraicGeometry.SmallEtale.pullbackSectionsComparison` at an object `T`,
read as a map of modules over `Γ(T, 𝒪_T)` rather than over the `RingCat` object of the structure
sheaf of the small étale site.  This is the form in which
`AlgebraicGeometry.eq_zero_of_mem_span_of_app_eq_pullbackSection` consumes it; the two module
structures are definitionally equal, so the underlying function is unchanged. -/
public noncomputable def pullbackSectionsComparisonGamma (F : S.Modules)
    (T : SmallEtale B S hS) :
    ModuleCat.of Γ(T.obj.left.obj, ⊤) ((presheafPullback B S hS F).obj (op T)) ⟶
      ModuleCat.of Γ(T.obj.left.obj, ⊤)
        Γ((Scheme.Modules.pullback T.obj.hom.hom).obj F, ⊤) :=
  ModuleCat.homEquiv.symm
    { toFun := fun x => (pullbackSectionsComparison B S hS F).app (op T) x
      map_add' := fun x y => map_add ((pullbackSectionsComparison B S hS F).app (op T)).hom x y
      map_smul' := fun c x =>
        ((pullbackSectionsComparison B S hS F).app (op T)).hom.map_smul c x }

/-- A span over the `RingCat` object of the structure sheaf of the small étale site is a span
over `Γ(T, 𝒪_T)`.  The two rings carry the same action on the same elements, so the two spans
have the same members; but they are submodules over different rings, hence different types, and
membership has to be transported. -/
public theorem mem_span_gamma_of_mem_span_presheafPullbackGenerator (F : S.Modules)
    (T : SmallEtale B S hS) (G : Set ((presheafPullback B S hS F).obj (op T)))
    {x : (presheafPullback B S hS F).obj (op T)}
    (hx : x ∈ Submodule.span ((structureSheaf B S hS).obj.obj (op T)) G) :
    x ∈ Submodule.span Γ(T.obj.left.obj, ⊤) G := by
  refine Submodule.span_induction (p := fun y _ => y ∈ Submodule.span Γ(T.obj.left.obj, ⊤) G)
    (fun y hy => Submodule.subset_span hy) (Submodule.zero_mem _) ?_ ?_ hx
  · intro p q _ _ hp hq
    exact Submodule.add_mem _ hp hq
  · intro c p _ hp
    exact Submodule.smul_mem _ c hp

/-- Restricting a generator along a morphism of the small étale site gives the generator over the
same open of `S`: there is at most one morphism to the image of an open of `S`, so the two
factorings agree. -/
public theorem presheafPullbackGenerator_map (F : S.Modules)
    {T T' : SmallEtale B S hS} (g : T' ⟶ T) {U : S.Opens}
    (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (j' : T' ⟶ (opensToSmallEtale B S hS).obj U) (a : Γ(F, U)) :
    (presheafPullback B S hS F).map g.op (presheafPullbackGenerator B S hS F j a) =
      presheafPullbackGenerator B S hS F j' a := by
  have hj : g ≫ j = j' := Subsingleton.elim _ _
  refine Eq.trans
    (PresheafOfModules.map_comp_apply (presheafPullback B S hS F) j.op g.op _).symm ?_
  exact congrArg (fun k : T' ⟶ (opensToSmallEtale B S hS).obj U =>
    (presheafPullback B S hS F).map k.op ((presheafPullbackUnit B S hS F).app (op U) a)) hj

/-- **Shrinking the open of `S`.**  The generator indexed by a section `a` over `U` is the
generator indexed by the restriction of `a` to a smaller open `U'`, as soon as the object still
factors through `U'`: this is naturality of the unit, and again the uniqueness of the
factoring. -/
public theorem presheafPullbackGenerator_map_le (F : S.Modules)
    {T : SmallEtale B S hS} {U U' : S.Opens} (h : U' ≤ U)
    (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (j' : T ⟶ (opensToSmallEtale B S hS).obj U') (a : Γ(F, U)) :
    presheafPullbackGenerator B S hS F j'
        (((SheafOfModules.forget S.ringCatSheaf).obj F).map (homOfLE h).op a) =
      presheafPullbackGenerator B S hS F j a := by
  have hj : j' ≫ (opensToSmallEtale B S hS).map (homOfLE h) = j := Subsingleton.elim _ _
  refine Eq.trans (congrArg (fun z => (presheafPullback B S hS F).map j'.op z)
    (PresheafOfModules.naturality_apply (presheafPullbackUnit B S hS F) (homOfLE h).op a)) ?_
  refine Eq.trans (PresheafOfModules.map_comp_apply (presheafPullback B S hS F)
    ((opensToSmallEtale B S hS).map (homOfLE h)).op j'.op _).symm ?_
  exact congrArg (fun k : T ⟶ (opensToSmallEtale B S hS).obj U =>
    (presheafPullback B S hS F).map k.op ((presheafPullbackUnit B S hS F).app (op U) a)) hj

/-- The span of the generators grows as the open of `S` indexing them shrinks, by
`AlgebraicGeometry.SmallEtale.presheafPullbackGenerator_map_le`. -/
public theorem span_presheafPullbackGenerator_mono (F : S.Modules)
    {T : SmallEtale B S hS} {U U' : S.Opens} (h : U' ≤ U)
    (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (j' : T ⟶ (opensToSmallEtale B S hS).obj U') :
    Submodule.span ((structureSheaf B S hS).obj.obj (op T))
        (Set.range fun a : Γ(F, U) => presheafPullbackGenerator B S hS F j a) ≤
      Submodule.span ((structureSheaf B S hS).obj.obj (op T))
        (Set.range fun a : Γ(F, U') => presheafPullbackGenerator B S hS F j' a) := by
  refine Submodule.span_le.2 ?_
  rintro y ⟨a, rfl⟩
  exact Submodule.subset_span ⟨_, presheafPullbackGenerator_map_le B S hS F h j j' a⟩

/-- Restriction along a morphism of the small étale site carries the span of the generators
indexed by an open of `S` into the span of the generators indexed by the same open. -/
public theorem map_mem_span_presheafPullbackGenerator (F : S.Modules)
    {T T' : SmallEtale B S hS} (g : T' ⟶ T) {U : S.Opens}
    (j : T ⟶ (opensToSmallEtale B S hS).obj U)
    (j' : T' ⟶ (opensToSmallEtale B S hS).obj U)
    {z : (presheafPullback B S hS F).obj (op T)}
    (hz : z ∈ Submodule.span ((structureSheaf B S hS).obj.obj (op T))
      (Set.range fun a : Γ(F, U) => presheafPullbackGenerator B S hS F j a)) :
    (presheafPullback B S hS F).map g.op z ∈
      Submodule.span ((structureSheaf B S hS).obj.obj (op T'))
        (Set.range fun a : Γ(F, U) => presheafPullbackGenerator B S hS F j' a) := by
  refine Submodule.span_induction
    (p := fun y _ => (presheafPullback B S hS F).map g.op y ∈
      Submodule.span ((structureSheaf B S hS).obj.obj (op T'))
        (Set.range fun a : Γ(F, U) => presheafPullbackGenerator B S hS F j' a)) ?_ ?_ ?_ ?_ hz
  · rintro y ⟨a, rfl⟩
    exact Submodule.subset_span ⟨a, (presheafPullbackGenerator_map B S hS F g j j' a).symm⟩
  · rw [map_zero]
    exact Submodule.zero_mem _
  · intro p q _ _ hp hq
    rw [map_add]
    exact Submodule.add_mem _ hp hq
  · intro c p _ hp
    rw [PresheafOfModules.map_smul]
    exact Submodule.smul_mem _ _ hp

/-- **Every section of the pullback is a combination of generators over one open of `S`.**
`PresheafOfModules.span_pullbackUnitGenerators_eq_top` writes a section as a combination of
generators indexed by finitely many, possibly different, opens of `S`.  The opens through which
the object factors are closed under intersection — `AlgebraicGeometry.SmallEtale.homOfRangeLe`
provides the factoring through the intersection — and shrinking the open only enlarges the span,
by `AlgebraicGeometry.SmallEtale.span_presheafPullbackGenerator_mono`; so the sections admitting
such a description form a submodule, and one open suffices for all of them.

This is the step which makes the rest of local injectivity a single refinement: with one open `W`
in hand the whole argument happens over one covering sieve. -/
public theorem exists_mem_span_presheafPullbackGenerator (F : S.Modules)
    (T : SmallEtale B S hS) (x : (presheafPullback B S hS F).obj (op T)) :
    ∃ (W : S.Opens) (g : T ⟶ (opensToSmallEtale B S hS).obj W),
      x ∈ Submodule.span ((structureSheaf B S hS).obj.obj (op T))
        (Set.range fun a : Γ(F, W) => presheafPullbackGenerator B S hS F g a) := by
  have htop := PresheafOfModules.span_pullbackUnitGenerators_eq_top
    (structureMap B S hS).hom ((SheafOfModules.forget S.ringCatSheaf).obj F) (op T)
  refine Submodule.span_induction
    (p := fun y _ => ∃ (W : S.Opens) (g : T ⟶ (opensToSmallEtale B S hS).obj W),
      y ∈ Submodule.span ((structureSheaf B S hS).obj.obj (op T))
        (Set.range fun a : Γ(F, W) => presheafPullbackGenerator B S hS F g a))
    ?_ ?_ ?_ ?_ (htop.ge Submodule.mem_top)
  · rintro y ⟨W, g, a, rfl⟩
    exact ⟨W, g, Submodule.subset_span ⟨a, rfl⟩⟩
  · exact ⟨⊤, homOfRangeLe B S hS ⊤ (by simp), Submodule.zero_mem _⟩
  · rintro y z _ _ ⟨W₁, g₁, hy⟩ ⟨W₂, g₂, hz⟩
    have hr : Set.range ⇑T.obj.hom.hom ⊆ ((W₁ ⊓ W₂ : S.Opens) : Set S) :=
      Set.subset_inter (BigEtaleOver.range_le_of_hom B S hS g₁.hom)
        (BigEtaleOver.range_le_of_hom B S hS g₂.hom)
    exact ⟨W₁ ⊓ W₂, homOfRangeLe B S hS (W₁ ⊓ W₂) hr, Submodule.add_mem _
      (span_presheafPullbackGenerator_mono B S hS F inf_le_left g₁ _ hy)
      (span_presheafPullbackGenerator_mono B S hS F inf_le_right g₂ _ hz)⟩
  · rintro c y _ ⟨W, g, hy⟩
    exact ⟨W, g, Submodule.smul_mem _ c hy⟩

/-- The inclusion of one open of the underlying scheme of an object of the small étale site into
a larger one, as a morphism of that site. -/
@[implicit_reducible]
public noncomputable def openSubObjHom (T : SmallEtale B S hS) {V V' : T.obj.left.obj.Opens}
    (h : V ≤ V') : openSubObj B S hS T V ⟶ openSubObj B S hS T V' :=
  ObjectProperty.homMk (Over.homMk (ObjectProperty.homMk
      (X := B.obj (V : Scheme.{u}) (BigEtaleOver.contains_opens B T.obj.left.property V))
      (Y := B.obj (V' : Scheme.{u}) (BigEtaleOver.contains_opens B T.obj.left.property V'))
      (T.obj.left.obj.homOfLE h))
    (by
      apply ObjectProperty.hom_ext
      rw [ObjectProperty.FullSubcategory.comp_hom, openSubObj_hom_hom, openSubObj_hom_hom]
      exact congrArg (fun k : (V : Scheme.{u}) ⟶ T.obj.left.obj => k ≫ T.obj.hom.hom)
        (T.obj.left.obj.homOfLE_ι h)))

/-- The underlying morphism of schemes of `AlgebraicGeometry.SmallEtale.openSubObjHom` is the
inclusion of opens `homOfLE`. -/
@[simp]
public theorem openSubObjHom_hom_left_hom (T : SmallEtale B S hS)
    {V V' : T.obj.left.obj.Opens} (h : V ≤ V') :
    (openSubObjHom B S hS T h).hom.left.hom = T.obj.left.obj.homOfLE h := rfl

/-- **The opens of the underlying scheme of an object of the small étale site, as a functor into
that site.**  The small Zariski site of `AlgebraicGeometry.SmallEtale.toScheme` of the object,
sitting inside the small étale site of `S`, as
`AlgebraicGeometry.SmallEtale.opensToSmallEtale` places the small Zariski site of `S` there. -/
public noncomputable def openSubFunctor (T : SmallEtale B S hS) :
    T.obj.left.obj.Opens ⥤ SmallEtale B S hS where
  obj V := openSubObj B S hS T V
  map {_ _} h := openSubObjHom B S hS T (leOfHom h)
  map_id V := by
    apply ObjectProperty.hom_ext
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    rw [openSubObjHom_hom_left_hom, ObjectProperty.FullSubcategory.id_hom, Over.id_left,
      ObjectProperty.FullSubcategory.id_hom, Scheme.homOfLE_rfl]
    rfl
  map_comp f g := by
    apply ObjectProperty.hom_ext
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    rw [openSubObjHom_hom_left_hom, ObjectProperty.FullSubcategory.comp_hom, Over.comp_left,
      ObjectProperty.FullSubcategory.comp_hom, openSubObjHom_hom_left_hom,
      openSubObjHom_hom_left_hom, Scheme.homOfLE_homOfLE]

/-- **The structure sheaf of the small étale site, read on the opens of an object.**  Over an
open `V` it is `AlgebraicGeometry.Scheme.Opens.topIso`, the functions on `V` being the global
functions of the open subscheme.  Naturality is the naturality of
`AlgebraicGeometry.Scheme.restrictFunctorΓ`. -/
public noncomputable def openSubStructureMap (T : SmallEtale B S hS) :
    T.obj.left.obj.ringCatSheaf.obj ⟶
      (openSubFunctor B S hS T).op ⋙ (structureSheaf B S hS).obj where
  app V := (forget₂ CommRingCat.{u} RingCat.{u}).map
    (Scheme.Opens.topIso (X := T.obj.left.obj) V.unop).inv
  naturality {V V'} h := by
    have key : T.obj.left.obj.presheaf.map h ≫ (Scheme.Opens.topIso V'.unop).inv =
        (Scheme.Opens.topIso V.unop).inv ≫
          (T.obj.left.obj.homOfLE (leOfHom h.unop)).appTop := by
      simp only [Scheme.Opens.topIso_inv, Scheme.homOfLE_appTop]
      refine Eq.trans (T.obj.left.obj.presheaf.map_comp _ _).symm
        (Eq.trans ?_ (T.obj.left.obj.presheaf.map_comp _ _))
      exact congrArg T.obj.left.obj.presheaf.map (Subsingleton.elim _ _)
    exact (((forget₂ CommRingCat.{u} RingCat.{u}).map_comp _ _).symm.trans
      (congrArg ((forget₂ CommRingCat.{u} RingCat.{u}).map) key)).trans
      ((forget₂ CommRingCat.{u} RingCat.{u}).map_comp _ _)

/-- An open of the underlying scheme of `T` lying over an open `U` of `S` gives an object of the
small étale site whose structure morphism has range inside `U`. -/
public theorem range_openSubObj_hom_subset (T : SmallEtale B S hS)
    {V : T.obj.left.obj.Opens} {U : S.Opens} (hVU : V ≤ T.obj.hom.hom ⁻¹ᵁ U) :
    Set.range ⇑(openSubObj B S hS T V).obj.hom.hom ⊆ (U : Set S) := by
  rintro z ⟨w, rfl⟩
  exact hVU w.2

/-- **The source of the transpose.**  The pullback presheaf of the small étale site, read as a
presheaf of modules on the small Zariski site of the underlying scheme of `T`. -/
public noncomputable abbrev openSubPullbackPresheaf (F : S.Modules) (T : SmallEtale B S hS) :
    PresheafOfModules.{u} T.obj.left.obj.ringCatSheaf.obj :=
  (PresheafOfModules.pushforward.{u} (openSubStructureMap B S hS T)).obj
    (presheafPullback B S hS F)

/-- The unique factoring of the open subscheme over an open `U` of `S` through `U`. -/
public noncomputable abbrev openSubPreimageHom (T : SmallEtale B S hS) (U : S.Opens) :
    openSubObj B S hS T (T.obj.hom.hom ⁻¹ᵁ U) ⟶ (opensToSmallEtale B S hS).obj U :=
  homOfRangeLe B S hS U
    (range_openSubObj_hom_subset B S hS T (le_refl (T.obj.hom.hom ⁻¹ᵁ U)))

/-- **Restricting a function on `U` to the global functions of an open subscheme lying over
`U`.**  `AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE` together with
`AlgebraicGeometry.Scheme.Opens.ι_appLE_top`. -/
public theorem openSubObj_appLE_top (T : SmallEtale B S hS) {U : S.Opens}
    {V : T.obj.left.obj.Opens} (hVU : V ≤ T.obj.hom.hom ⁻¹ᵁ U)
    (hX : (⊤ : ((toScheme B S hS).obj (openSubObj B S hS T V)).Opens) ≤
      (openSubObj B S hS T V).obj.hom.hom ⁻¹ᵁ U) :
    (openSubObj B S hS T V).obj.hom.hom.appLE U ⊤ hX =
      T.obj.hom.hom.appLE U V hVU ≫ (Scheme.Opens.topIso V).inv := by
  rw [← Scheme.Opens.ι_appLE_top V (Scheme.Opens.top_le_ι_preimage le_rfl)]
  exact (Scheme.Hom.appLE_comp_appLE V.ι T.obj.hom.hom U V ⊤ hVU
    (Scheme.Opens.top_le_ι_preimage le_rfl)).symm

/-- **The scalars along which the transpose datum is semilinear.** -/
public theorem structureSheaf_map_openSubPreimageHom (T : SmallEtale B S hS) (U : S.Opens)
    (hX : (⊤ : ((toScheme B S hS).obj
        (openSubObj B S hS T (T.obj.hom.hom ⁻¹ᵁ U))).Opens) ≤
      (openSubObj B S hS T (T.obj.hom.hom ⁻¹ᵁ U)).obj.hom.hom ⁻¹ᵁ U)
    (r : Γ(S, U)) :
    (structureSheaf B S hS).obj.map (openSubPreimageHom B S hS T U).op
        ((structureMap B S hS).hom.app (op U) r) =
      (Scheme.Opens.topIso (T.obj.hom.hom ⁻¹ᵁ U)).inv (T.obj.hom.hom.app U r) := by
  refine Eq.trans (structureSheaf_map_structureMap_app B S hS
    (openSubPreimageHom B S hS T U) hX r) ?_
  refine Eq.trans (ConcreteCategory.congr_hom
    (openSubObj_appLE_top B S hS T (le_refl (T.obj.hom.hom ⁻¹ᵁ U)) hX) r) ?_
  refine Eq.trans (CommRingCat.comp_apply _ _ r) ?_
  exact congrArg (fun z => (Scheme.Opens.topIso (T.obj.hom.hom ⁻¹ᵁ U)).inv z)
    (ConcreteCategory.congr_hom (Scheme.Hom.appLE_eq_app T.obj.hom.hom) r)

/-- **The transpose datum.**  Over an open `U` of `S`, the map carrying a section `a` of `F` to
the generator `AlgebraicGeometry.SmallEtale.presheafPullbackGenerator` at the object
`openSubObj T (T.hom⁻¹U)`. -/
public noncomputable def openSubUnit (F : S.Modules) (T : SmallEtale B S hS) :
    (SheafOfModules.forget S.ringCatSheaf).obj F ⟶
      (PresheafOfModules.pushforward.{u} T.obj.hom.hom.toRingCatSheafHom.hom).obj
        (openSubPullbackPresheaf B S hS F T) where
  app U := ModuleCat.homEquiv.symm
    { toFun := fun a => presheafPullbackGenerator B S hS F (openSubPreimageHom B S hS T U.unop) a
      map_add' := fun a b => Eq.trans
        (congrArg (fun z => (presheafPullback B S hS F).map
          (openSubPreimageHom B S hS T U.unop).op z)
          (map_add ((presheafPullbackUnit B S hS F).app (op U.unop)).hom a b))
        (map_add ((presheafPullback B S hS F).map
          (openSubPreimageHom B S hS T U.unop).op).hom _ _)
      map_smul' := fun r a => by
        have hX : (⊤ : ((toScheme B S hS).obj
            (openSubObj B S hS T (T.obj.hom.hom ⁻¹ᵁ U.unop))).Opens) ≤
            (openSubObj B S hS T (T.obj.hom.hom ⁻¹ᵁ U.unop)).obj.hom.hom ⁻¹ᵁ U.unop :=
          fun w _ => range_openSubObj_hom_subset B S hS T
            (le_refl (T.obj.hom.hom ⁻¹ᵁ U.unop)) ⟨w, rfl⟩
        refine Eq.trans (presheafPullbackGenerator_smul B S hS F
          (openSubPreimageHom B S hS T U.unop) r a) ?_
        refine Eq.trans (congrArg (fun c => c • presheafPullbackGenerator B S hS F
          (openSubPreimageHom B S hS T U.unop) a)
          (structureSheaf_map_openSubPreimageHom B S hS T U.unop hX r)) ?_
        rfl }
  naturality {U U'} h := by
    ext a
    have hle : (T.obj.hom.hom ⁻¹ᵁ U'.unop) ≤ (T.obj.hom.hom ⁻¹ᵁ U.unop) :=
      fun z hz => (leOfHom h.unop) hz
    have hmap : (presheafPullback B S hS F).map
          (openSubObjHom B S hS T hle).op
          (presheafPullbackGenerator B S hS F (openSubPreimageHom B S hS T U.unop) a) =
        presheafPullbackGenerator B S hS F (homOfRangeLe B S hS U.unop
          (range_openSubObj_hom_subset B S hS T (hle.trans (le_refl _)))) a :=
      presheafPullbackGenerator_map B S hS F (openSubObjHom B S hS T hle) _ _ a
    refine Eq.trans ?_ hmap.symm
    refine Eq.trans (congrArg (fun z => presheafPullbackGenerator B S hS F
      (openSubPreimageHom B S hS T U'.unop) z)
      (congrArg (fun k : U'.unop ⟶ U.unop =>
        ((SheafOfModules.forget S.ringCatSheaf).obj F).map k.op a)
        (Subsingleton.elim h.unop (homOfLE (leOfHom h.unop))))) ?_
    exact presheafPullbackGenerator_map_le B S hS F (leOfHom h.unop) _ _ a

/-- **The transpose `β`.**  The transpose of `AlgebraicGeometry.SmallEtale.openSubUnit` across
`CategoryTheory.PresheafOfModules.pullbackPushforwardAdjunction`: the map *out* of the
presheaf-level pullback that local injectivity needs. -/
public noncomputable def openSubBeta (F : S.Modules) (T : SmallEtale B S hS) :
    zariskiPullbackPresheaf T.obj.hom.hom F ⟶ openSubPullbackPresheaf B S hS F T :=
  ((PresheafOfModules.pullbackPushforwardAdjunction.{u}
    T.obj.hom.hom.toRingCatSheafHom.hom).homEquiv _ _).symm (openSubUnit B S hS F T)

/-- `AlgebraicGeometry.SmallEtale.openSubBeta` transposes back to
`AlgebraicGeometry.SmallEtale.openSubUnit`. -/
public theorem unit_comp_map_openSubBeta (F : S.Modules) (T : SmallEtale B S hS) :
    (PresheafOfModules.pullbackPushforwardAdjunction.{u}
          T.obj.hom.hom.toRingCatSheafHom.hom).unit.app
        ((SheafOfModules.forget S.ringCatSheaf).obj F) ≫
        (PresheafOfModules.pushforward.{u} T.obj.hom.hom.toRingCatSheafHom.hom).map
          (openSubBeta B S hS F T) =
      openSubUnit B S hS F T :=
  unit_comp_map_homEquiv_symm _ _

/-- **`β` on the image of the unit.** -/
public theorem openSubBeta_unit_app (F : S.Modules) (T : SmallEtale B S hS) (U : S.Opens)
    (a : ((SheafOfModules.forget S.ringCatSheaf).obj F).obj (op U)) :
    (openSubBeta B S hS F T).app (op (T.obj.hom.hom ⁻¹ᵁ U))
        (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
          T.obj.hom.hom.toRingCatSheafHom.hom).unit.app
            ((SheafOfModules.forget S.ringCatSheaf).obj F)).app (op U) a) =
      presheafPullbackGenerator B S hS F (openSubPreimageHom B S hS T U) a :=
  app_homEquiv_symm_unit_app _ (openSubUnit B S hS F T) (op U) a

/-- **`β` on a generator.**  Compare `AlgebraicGeometry.zariskiPullbackToSheaf_generator`, which
evaluates the sheafification map on the same element. -/
public theorem openSubBeta_generator (F : S.Modules) (T : SmallEtale B S hS) (U : S.Opens)
    {V : T.obj.left.obj.Opens} (hVU : V ≤ T.obj.hom.hom ⁻¹ᵁ U)
    (a : ((SheafOfModules.forget S.ringCatSheaf).obj F).obj (op U)) :
    (openSubBeta B S hS F T).app (op V)
        ((zariskiPullbackPresheaf T.obj.hom.hom F).map (homOfLE hVU).op
          (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
            T.obj.hom.hom.toRingCatSheafHom.hom).unit.app
              ((SheafOfModules.forget S.ringCatSheaf).obj F)).app (op U) a)) =
      presheafPullbackGenerator B S hS F
        (homOfRangeLe B S hS U (range_openSubObj_hom_subset B S hS T hVU)) a := by
  refine Eq.trans (PresheafOfModules.naturality_apply (openSubBeta B S hS F T)
    (homOfLE hVU).op _) ?_
  refine Eq.trans (congrArg (fun z => (openSubPullbackPresheaf B S hS F T).map
    (homOfLE hVU).op z) (openSubBeta_unit_app B S hS F T U a)) ?_
  exact presheafPullbackGenerator_map B S hS F (openSubObjHom B S hS T hVU) _ _ a

/-- Restriction of a section of the presheaf-level pullback from the whole space to an open,
typed in the module of sections over that open; see
`AlgebraicGeometry.BigFppfOver.zariskiRestrictTop` for why the declared type matters. -/
public noncomputable def zariskiRestrictTop (F : S.Modules) (T : SmallEtale B S hS)
    (V : T.obj.left.obj.Opens) (t : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op ⊤)) :
    (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op V) :=
  (zariskiPullbackPresheaf T.obj.hom.hom F).map (homOfLE (le_top (a := V))).op t

/-- `AlgebraicGeometry.SmallEtale.zariskiRestrictTop` sends `0` to `0`. -/
public theorem zariskiRestrictTop_zero (F : S.Modules) (T : SmallEtale B S hS)
    (V : T.obj.left.obj.Opens) : zariskiRestrictTop B S hS F T V 0 = 0 :=
  map_zero ((zariskiPullbackPresheaf T.obj.hom.hom F).map (homOfLE (le_top (a := V))).op).hom

/-- `AlgebraicGeometry.SmallEtale.zariskiRestrictTop` is additive. -/
public theorem zariskiRestrictTop_add (F : S.Modules) (T : SmallEtale B S hS)
    (V : T.obj.left.obj.Opens) (t₁ t₂ : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op ⊤)) :
    zariskiRestrictTop B S hS F T V (t₁ + t₂) =
      zariskiRestrictTop B S hS F T V t₁ + zariskiRestrictTop B S hS F T V t₂ :=
  map_add ((zariskiPullbackPresheaf T.obj.hom.hom F).map
    (homOfLE (le_top (a := V))).op).hom t₁ t₂

/-- `AlgebraicGeometry.SmallEtale.zariskiRestrictTop` is semilinear along the restriction of
functions from the whole space to `V`. -/
public theorem zariskiRestrictTop_smul (F : S.Modules) (T : SmallEtale B S hS)
    (V : T.obj.left.obj.Opens) (c : T.obj.left.obj.ringCatSheaf.obj.obj (op ⊤))
    (t : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op ⊤)) :
    zariskiRestrictTop B S hS F T V (c • t) =
      T.obj.left.obj.ringCatSheaf.obj.map (homOfLE (le_top (a := V))).op c •
        zariskiRestrictTop B S hS F T V t :=
  PresheafOfModules.map_smul (zariskiPullbackPresheaf T.obj.hom.hom F)
    (homOfLE (le_top (a := V))).op c t

/-- Restricting from the whole space a generator already restricted from an open `U` of `S`
gives the generator restricted to the smaller open. -/
public theorem zariskiRestrictTop_unit (F : S.Modules) (T : SmallEtale B S hS) {U : S.Opens}
    (hUtop : (⊤ : T.obj.left.obj.Opens) ≤ T.obj.hom.hom ⁻¹ᵁ U)
    {V : T.obj.left.obj.Opens} (hVU : V ≤ T.obj.hom.hom ⁻¹ᵁ U)
    (a : ((SheafOfModules.forget S.ringCatSheaf).obj F).obj (op U)) :
    zariskiRestrictTop B S hS F T V
        ((zariskiPullbackPresheaf T.obj.hom.hom F).map (homOfLE hUtop).op
          (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
            T.obj.hom.hom.toRingCatSheafHom.hom).unit.app
              ((SheafOfModules.forget S.ringCatSheaf).obj F)).app (op U) a)) =
      (zariskiPullbackPresheaf T.obj.hom.hom F).map (homOfLE hVU).op
        (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
          T.obj.hom.hom.toRingCatSheafHom.hom).unit.app
            ((SheafOfModules.forget S.ringCatSheaf).obj F)).app (op U) a) :=
  ((zariskiPullbackPresheaf T.obj.hom.hom F).map_comp_apply (homOfLE hUtop).op
      (homOfLE (le_top (a := V))).op _).symm.trans
    (congrArg (fun k : V ⟶ T.obj.hom.hom ⁻¹ᵁ U =>
        (zariskiPullbackPresheaf T.obj.hom.hom F).map k.op
      (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
        T.obj.hom.hom.toRingCatSheafHom.hom).unit.app
          ((SheafOfModules.forget S.ringCatSheaf).obj F)).app (op U) a))
      (Subsingleton.elim _ (homOfLE hVU)))

/-- Restriction of a section of the small-étale pullback to an open subscheme of the object,
typed in the module of sections over `openSubObj T V`. -/
public noncomputable def openSubRestrict (F : S.Modules) (T : SmallEtale B S hS)
    (V : T.obj.left.obj.Opens) (z : (presheafPullback B S hS F).obj (op T)) :
    (presheafPullback B S hS F).obj (op (openSubObj B S hS T V)) :=
  (presheafPullback B S hS F).map (openSubHom B S hS T V).op z

/-- `AlgebraicGeometry.SmallEtale.openSubRestrict` sends `0` to `0`. -/
public theorem openSubRestrict_zero (F : S.Modules) (T : SmallEtale B S hS)
    (V : T.obj.left.obj.Opens) : openSubRestrict B S hS F T V 0 = 0 :=
  map_zero ((presheafPullback B S hS F).map (openSubHom B S hS T V).op).hom

/-- `AlgebraicGeometry.SmallEtale.openSubRestrict` is additive. -/
public theorem openSubRestrict_add (F : S.Modules) (T : SmallEtale B S hS)
    (V : T.obj.left.obj.Opens) (z₁ z₂ : (presheafPullback B S hS F).obj (op T)) :
    openSubRestrict B S hS F T V (z₁ + z₂) =
      openSubRestrict B S hS F T V z₁ + openSubRestrict B S hS F T V z₂ :=
  map_add ((presheafPullback B S hS F).map (openSubHom B S hS T V).op).hom z₁ z₂

/-- `AlgebraicGeometry.SmallEtale.openSubRestrict` is semilinear along the restriction of
functions of the structure sheaf to `openSubObj T V`. -/
public theorem openSubRestrict_smul (F : S.Modules) (T : SmallEtale B S hS)
    (V : T.obj.left.obj.Opens) (c : (structureSheaf B S hS).obj.obj (op T))
    (z : (presheafPullback B S hS F).obj (op T)) :
    openSubRestrict B S hS F T V (c • z) =
      (structureSheaf B S hS).obj.map (openSubHom B S hS T V).op c •
        openSubRestrict B S hS F T V z :=
  PresheafOfModules.map_smul (presheafPullback B S hS F) (openSubHom B S hS T V).op c z

/-- The component of `AlgebraicGeometry.SmallEtale.openSubBeta` at an open `V`, typed in the
module of sections of the small-étale pullback over `openSubObj T V`. -/
public noncomputable def openSubBetaApp (F : S.Modules) (T : SmallEtale B S hS)
    (V : T.obj.left.obj.Opens) (w : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op V)) :
    (presheafPullback B S hS F).obj (op (openSubObj B S hS T V)) :=
  (openSubBeta B S hS F T).app (op V) w

/-- `AlgebraicGeometry.SmallEtale.openSubBetaApp` sends `0` to `0`. -/
public theorem openSubBetaApp_zero (F : S.Modules) (T : SmallEtale B S hS)
    (V : T.obj.left.obj.Opens) : openSubBetaApp B S hS F T V 0 = 0 :=
  map_zero ((openSubBeta B S hS F T).app (op V)).hom

/-- `AlgebraicGeometry.SmallEtale.openSubBetaApp` is additive. -/
public theorem openSubBetaApp_add (F : S.Modules) (T : SmallEtale B S hS)
    (V : T.obj.left.obj.Opens)
    (w₁ w₂ : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op V)) :
    openSubBetaApp B S hS F T V (w₁ + w₂) =
      openSubBetaApp B S hS F T V w₁ + openSubBetaApp B S hS F T V w₂ :=
  map_add ((openSubBeta B S hS F T).app (op V)).hom w₁ w₂

/-- The component of `AlgebraicGeometry.SmallEtale.openSubStructureMap` at an open `V`, typed in
the ring of global functions of `openSubObj T V`. -/
public noncomputable def openSubScalar (T : SmallEtale B S hS) (V : T.obj.left.obj.Opens)
    (r : T.obj.left.obj.ringCatSheaf.obj.obj (op V)) :
    (structureSheaf B S hS).obj.obj (op (openSubObj B S hS T V)) :=
  (openSubStructureMap B S hS T).app (op V) r

/-- `AlgebraicGeometry.SmallEtale.openSubBetaApp` is semilinear along
`AlgebraicGeometry.SmallEtale.openSubScalar`. -/
public theorem openSubBetaApp_smul (F : S.Modules) (T : SmallEtale B S hS)
    (V : T.obj.left.obj.Opens) (r : T.obj.left.obj.ringCatSheaf.obj.obj (op V))
    (w : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op V)) :
    openSubBetaApp B S hS F T V (r • w) =
      openSubScalar B S hS T V r • openSubBetaApp B S hS F T V w :=
  ((openSubBeta B S hS F T).app (op V)).hom.map_smul r w

/-- **The two ring maps to the global functions of `V` agree**, by
`AlgebraicGeometry.ι_appTop_eq_topIso_inv`. -/
public theorem openSubStructureMap_app_map_top (T : SmallEtale B S hS)
    (V : T.obj.left.obj.Opens) (c : (structureSheaf B S hS).obj.obj (op T)) :
    openSubScalar B S hS T V
        (T.obj.left.obj.ringCatSheaf.obj.map (homOfLE (le_top (a := V))).op
          (show T.obj.left.obj.ringCatSheaf.obj.obj (op ⊤) from c)) =
      (structureSheaf B S hS).obj.map (openSubHom B S hS T V).op c :=
  ((ConcreteCategory.congr_hom (ι_appTop_eq_topIso_inv V) c).trans
    (CommRingCat.comp_apply _ _ c)).symm

/-- **`β` on a generator, typed over the global functions of `V`.** -/
public theorem openSubBetaApp_generator (F : S.Modules) (T : SmallEtale B S hS) (U : S.Opens)
    {V : T.obj.left.obj.Opens} (hVU : V ≤ T.obj.hom.hom ⁻¹ᵁ U)
    (a : ((SheafOfModules.forget S.ringCatSheaf).obj F).obj (op U)) :
    openSubBetaApp B S hS F T V
        ((zariskiPullbackPresheaf T.obj.hom.hom F).map (homOfLE hVU).op
          (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
            T.obj.hom.hom.toRingCatSheafHom.hom).unit.app
              ((SheafOfModules.forget S.ringCatSheaf).obj F)).app (op U) a)) =
      presheafPullbackGenerator B S hS F
        (homOfRangeLe B S hS U (range_openSubObj_hom_subset B S hS T hVU)) a :=
  openSubBeta_generator B S hS F T U hVU a

/-- **Every section of the small-étale pullback in the span of the generators over one open of
`S` comes from the small Zariski site of the object.**  The small étale mirror of
`AlgebraicGeometry.BigFppfOver.exists_openSubBeta_eq`: a span induction on
`PresheafOfModules.mem_pullbackUnitSubmodule`, with the semilinearities matched by
`AlgebraicGeometry.SmallEtale.openSubStructureMap_app_map_top`. -/
public theorem exists_openSubBeta_eq (F : S.Modules) (T : SmallEtale B S hS) {W : S.Opens}
    (g : T ⟶ (opensToSmallEtale B S hS).obj W)
    {x : (presheafPullback B S hS F).obj (op T)}
    (hx : x ∈ Submodule.span ((structureSheaf B S hS).obj.obj (op T))
      (Set.range fun a : Γ(F, W) => presheafPullbackGenerator B S hS F g a)) :
    ∃ t : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op ⊤),
      (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t =
          (pullbackSectionsComparison B S hS F).app (op T) x ∧
        ∀ V : T.obj.left.obj.Opens,
          openSubBetaApp B S hS F T V (zariskiRestrictTop B S hS F T V t) =
            openSubRestrict B S hS F T V x := by
  have hWtop : (⊤ : T.obj.left.obj.Opens) ≤ T.obj.hom.hom ⁻¹ᵁ W :=
    fun z _ => BigEtaleOver.range_le_of_hom B S hS g.hom ⟨z, rfl⟩
  refine Submodule.span_induction
    (p := fun z _ => ∃ t : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op ⊤),
      (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t =
          (pullbackSectionsComparison B S hS F).app (op T) z ∧
        ∀ V : T.obj.left.obj.Opens,
          openSubBetaApp B S hS F T V (zariskiRestrictTop B S hS F T V t) =
            openSubRestrict B S hS F T V z)
    ?_ ?_ ?_ ?_ hx
  · rintro z ⟨a, rfl⟩
    refine ⟨(zariskiPullbackPresheaf T.obj.hom.hom F).map (homOfLE hWtop).op
      (((PresheafOfModules.pullbackPushforwardAdjunction.{u}
        T.obj.hom.hom.toRingCatSheafHom.hom).unit.app
          ((SheafOfModules.forget S.ringCatSheaf).obj F)).app (op W) a), ?_, ?_⟩
    · refine Eq.trans (zariskiPullbackToSheaf_generator T.obj.hom.hom F W ⊤ hWtop a) ?_
      exact ((pullbackSectionsComparison_app_map_unit B S hS F g hWtop a).trans
        (pullbackSectionHom_apply T.obj.hom.hom F W ⊤ hWtop a)).symm
    · intro V
      have hVW : V ≤ T.obj.hom.hom ⁻¹ᵁ W := fun z _ => hWtop trivial
      refine Eq.trans (congrArg (fun z => openSubBetaApp B S hS F T V z)
        (zariskiRestrictTop_unit B S hS F T hWtop hVW a)) ?_
      refine Eq.trans (openSubBetaApp_generator B S hS F T W hVW a) ?_
      exact (presheafPullbackGenerator_map B S hS F (openSubHom B S hS T V) g _ a).symm
  · refine ⟨0, ?_, fun V => ?_⟩
    · exact (map_zero ((zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤)).hom).trans
        (map_zero ((pullbackSectionsComparison B S hS F).app (op T)).hom).symm
    · refine Eq.trans (congrArg (fun z => openSubBetaApp B S hS F T V z)
        (zariskiRestrictTop_zero B S hS F T V)) ?_
      exact (openSubBetaApp_zero B S hS F T V).trans
        (openSubRestrict_zero B S hS F T V).symm
  · rintro z₁ z₂ _ _ ⟨t₁, h₁, k₁⟩ ⟨t₂, h₂, k₂⟩
    refine ⟨t₁ + t₂, ?_, fun V => ?_⟩
    · refine Eq.trans (map_add ((zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤)).hom
        t₁ t₂) ?_
      refine Eq.trans (congrArg (fun p => p + (zariskiPullbackToSheaf T.obj.hom.hom F).app
        (op ⊤) t₂) h₁) ?_
      refine Eq.trans
        (congrArg (fun p => (pullbackSectionsComparison B S hS F).app (op T) z₁ + p) h₂) ?_
      exact (map_add ((pullbackSectionsComparison B S hS F).app (op T)).hom z₁ z₂).symm
    · refine Eq.trans (congrArg (fun z => openSubBetaApp B S hS F T V z)
        (zariskiRestrictTop_add B S hS F T V t₁ t₂)) ?_
      refine Eq.trans (openSubBetaApp_add B S hS F T V _ _) ?_
      refine Eq.trans (congrArg (fun p => p + openSubBetaApp B S hS F T V
        (zariskiRestrictTop B S hS F T V t₂)) (k₁ V)) ?_
      refine Eq.trans (congrArg (fun p => openSubRestrict B S hS F T V z₁ + p) (k₂ V)) ?_
      exact (openSubRestrict_add B S hS F T V z₁ z₂).symm
  · rintro c z _ ⟨t, ht, kt⟩
    refine ⟨(show T.obj.left.obj.ringCatSheaf.obj.obj (op ⊤) from c) • t, ?_, fun V => ?_⟩
    · refine Eq.trans
        (((zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤)).hom.map_smul _ t) ?_
      refine Eq.trans (congrArg (fun p =>
        (show T.obj.left.obj.ringCatSheaf.obj.obj (op ⊤) from c) • p) ht) ?_
      exact (((pullbackSectionsComparison B S hS F).app (op T)).hom.map_smul c z).symm
    · refine Eq.trans (congrArg (fun z' => openSubBetaApp B S hS F T V z')
        (zariskiRestrictTop_smul B S hS F T V
          (show T.obj.left.obj.ringCatSheaf.obj.obj (op ⊤) from c) t)) ?_
      refine Eq.trans (openSubBetaApp_smul B S hS F T V _ _) ?_
      refine Eq.trans (congrArg (fun p => openSubScalar B S hS T V
        (T.obj.left.obj.ringCatSheaf.obj.map (homOfLE (le_top (a := V))).op
          (show T.obj.left.obj.ringCatSheaf.obj.obj (op ⊤) from c)) • p) (kt V)) ?_
      refine Eq.trans (congrArg (fun r => r • openSubRestrict B S hS F T V z)
        (openSubStructureMap_app_map_top B S hS T V c)) ?_
      exact (openSubRestrict_smul B S hS F T V c z).symm

/-- **Two sections of the presheaf-level pullback with the same image in `f^*F` agree near every
point of the object.**  `AlgebraicGeometry.exists_eq_map_of_zariskiPullbackToSheaf_app_eq` at the
structure morphism of `T` and `V = ⊤`. -/
public theorem exists_zariskiEqualizerOpen (F : S.Modules) (T : SmallEtale B S hS)
    (t t' : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op ⊤))
    (heq : (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t =
      (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t') (z : ↥T.obj.left.obj) :
    ∃ V : T.obj.left.obj.Opens, z ∈ V ∧
      zariskiRestrictTop B S hS F T V t = zariskiRestrictTop B S hS F T V t' := by
  obtain ⟨V, hVtop, hzV, hVeq⟩ :=
    exists_eq_map_of_zariskiPullbackToSheaf_app_eq T.obj.hom.hom F ⊤ t t' heq z trivial
  exact ⟨V, hzV, hVeq⟩

/-- A chosen open around a point on which two sections with the same image in `f^*F` agree. -/
public noncomputable def zariskiEqualizerOpen (F : S.Modules) (T : SmallEtale B S hS)
    (t t' : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op ⊤))
    (heq : (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t =
      (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t') (z : ↥T.obj.left.obj) :
    T.obj.left.obj.Opens :=
  (exists_zariskiEqualizerOpen B S hS F T t t' heq z).choose

/-- The point `z` lies in `AlgebraicGeometry.SmallEtale.zariskiEqualizerOpen` at `z`. -/
public theorem mem_zariskiEqualizerOpen (F : S.Modules) (T : SmallEtale B S hS)
    (t t' : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op ⊤))
    (heq : (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t =
      (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t') (z : ↥T.obj.left.obj) :
    z ∈ zariskiEqualizerOpen B S hS F T t t' heq z :=
  (exists_zariskiEqualizerOpen B S hS F T t t' heq z).choose_spec.1

/-- The two sections agree on `AlgebraicGeometry.SmallEtale.zariskiEqualizerOpen`. -/
public theorem zariskiRestrictTop_zariskiEqualizerOpen (F : S.Modules) (T : SmallEtale B S hS)
    (t t' : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op ⊤))
    (heq : (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t =
      (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t') (z : ↥T.obj.left.obj) :
    zariskiRestrictTop B S hS F T (zariskiEqualizerOpen B S hS F T t t' heq z) t =
      zariskiRestrictTop B S hS F T (zariskiEqualizerOpen B S hS F T t t' heq z) t' :=
  (exists_zariskiEqualizerOpen B S hS F T t t' heq z).choose_spec.2

/-- **The covering of an object by the chosen opens on which two sections of the presheaf-level
pullback upstairs agree.**  Indexed by the points of the underlying scheme of `T`; indexing by
the opens with the agreement property would put the presheaf-level pullback, whose values have no
formula, into the index type. -/
public noncomputable def zariskiEqualizerCover (F : S.Modules) (T : SmallEtale B S hS)
    (t t' : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op ⊤))
    (heq : (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t =
      (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t') :
    PreZeroHypercover.{u + 1} T where
  I₀ := ULift.{u + 1} ↥T.obj.left.obj
  X i := openSubObj B S hS T (zariskiEqualizerOpen B S hS F T t t' heq i.down)
  f i := openSubHom B S hS T (zariskiEqualizerOpen B S hS F T t t' heq i.down)

/-- **The chosen opens of `AlgebraicGeometry.SmallEtale.zariskiEqualizerCover` cover for the
small étale topology.**  The members are open immersions and they are jointly surjective because
the chosen open at a point contains that point. -/
public theorem mem_topology_sieve₀_zariskiEqualizerCover (F : S.Modules)
    (T : SmallEtale B S hS) (t t' : (zariskiPullbackPresheaf T.obj.hom.hom F).obj (op ⊤))
    (heq : (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t =
      (zariskiPullbackToSheaf T.obj.hom.hom F).app (op ⊤) t') :
    (zariskiEqualizerCover B S hS F T t t' heq).sieve₀ ∈ topology B S hS T :=
  Precoverage.generate_mem_toGrothendieck
    (presieve₀_mem_precoverage_of_isOpenImmersion B S hS _
      (fun z => ⟨⟨z⟩, ⟨⟨z, mem_zariskiEqualizerOpen B S hS F T t t' heq z⟩, rfl⟩⟩)
      (fun i => inferInstanceAs (IsOpenImmersion
        (zariskiEqualizerOpen B S hS F T t t' heq i.down).ι)))

/-- **The comparison of Stacks 070S (2) is locally injective for the small étale topology, for an
arbitrary sheaf of `𝒪_S`-modules.**  Two sections of the pullback with the same image under
`AlgebraicGeometry.SmallEtale.pullbackSectionsComparison` agree locally on the small étale site.

Each of the two lies, by
`AlgebraicGeometry.SmallEtale.exists_mem_span_presheafPullbackGenerator`, in the span of the
generators indexed by a single open of `S` through which the object factors; replacing the two
opens by their intersection, one open serves both.  Over it,
`AlgebraicGeometry.SmallEtale.exists_openSubBeta_eq` produces two sections `tx`, `ty` of the
presheaf-level pullback on the small Zariski site of the object which
`AlgebraicGeometry.SmallEtale.openSubBeta` carries, open by open, to the restrictions of the two
given sections, and whose images under `AlgebraicGeometry.zariskiPullbackToSheaf` are the images
of the two given sections under the comparison — hence equal.  Local injectivity of that
sheafification map (`AlgebraicGeometry.exists_eq_map_of_zariskiPullbackToSheaf_app_eq`) makes
`tx` and `ty` agree on a Zariski covering family of opens, and `β` then makes the two given
sections agree on `AlgebraicGeometry.SmallEtale.zariskiEqualizerCover`.  Nothing is glued and no
transitivity is used.

This is the other half of Stacks 070S (2); the locally surjective half is
`AlgebraicGeometry.SmallEtale.isLocallySurjective_pullbackSectionsComparison`. -/
public instance isLocallyInjective_pullbackSectionsComparison (F : S.Modules) :
    Presheaf.IsLocallyInjective (topology B S hS)
      ((PresheafOfModules.toPresheaf (structureSheaf B S hS).obj).map
        (pullbackSectionsComparison B S hS F)) where
  equalizerSieve_mem {Zop} x y h := by
    have h' : (pullbackSectionsComparison B S hS F).app Zop
          (x : (presheafPullback B S hS F).obj Zop) =
        (pullbackSectionsComparison B S hS F).app Zop
          (y : (presheafPullback B S hS F).obj Zop) := h
    obtain ⟨W₁, g₁, hx⟩ := exists_mem_span_presheafPullbackGenerator B S hS F (unop Zop)
      (x : (presheafPullback B S hS F).obj Zop)
    obtain ⟨W₂, g₂, hy⟩ := exists_mem_span_presheafPullbackGenerator B S hS F (unop Zop)
      (y : (presheafPullback B S hS F).obj Zop)
    have hr : Set.range ⇑(unop Zop).obj.hom.hom ⊆ ((W₁ ⊓ W₂ : S.Opens) : Set S) :=
      Set.subset_inter (BigEtaleOver.range_le_of_hom B S hS g₁.hom)
        (BigEtaleOver.range_le_of_hom B S hS g₂.hom)
    obtain ⟨tx, htx, kx⟩ := exists_openSubBeta_eq B S hS F (unop Zop)
      (homOfRangeLe B S hS (W₁ ⊓ W₂) hr)
      (span_presheafPullbackGenerator_mono B S hS F inf_le_left g₁ _ hx)
    obtain ⟨ty, hty, ky⟩ := exists_openSubBeta_eq B S hS F (unop Zop)
      (homOfRangeLe B S hS (W₁ ⊓ W₂) hr)
      (span_presheafPullbackGenerator_mono B S hS F inf_le_right g₂ _ hy)
    have heq : (zariskiPullbackToSheaf (unop Zop).obj.hom.hom F).app (op ⊤) tx =
        (zariskiPullbackToSheaf (unop Zop).obj.hom.hom F).app (op ⊤) ty :=
      htx.trans (h'.trans hty.symm)
    refine (topology B S hS).superset_covering ?_
      (mem_topology_sieve₀_zariskiEqualizerCover B S hS F (unop Zop) tx ty heq)
    rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
    intro i
    refine Eq.trans (kx (zariskiEqualizerOpen B S hS F (unop Zop) tx ty heq i.down)).symm ?_
    refine Eq.trans (congrArg
      (fun w => openSubBetaApp B S hS F (unop Zop)
        (zariskiEqualizerOpen B S hS F (unop Zop) tx ty heq i.down) w)
      (zariskiRestrictTop_zariskiEqualizerOpen B S hS F (unop Zop) tx ty heq i.down)) ?_
    exact ky (zariskiEqualizerOpen B S hS F (unop Zop) tx ty heq i.down)

/-- **Stacks 070S part (2) for `S_étale`, for an arbitrary sheaf of `𝒪_S`-modules**: the
sheafification, for the small étale topology, of
`AlgebraicGeometry.SmallEtale.pullbackSectionsComparison` is an isomorphism at every `𝓕`, with no
hypothesis.

A morphism of presheaves of modules which is locally bijective becomes an isomorphism after
sheafification, and both halves of local bijectivity are above at that generality:
`AlgebraicGeometry.SmallEtale.isLocallySurjective_pullbackSectionsComparison` and
`AlgebraicGeometry.SmallEtale.isLocallyInjective_pullbackSectionsComparison`. -/
public theorem isIso_sheafification_map_pullbackSectionsComparison (F : S.Modules) :
    IsIso ((PresheafOfModules.sheafification.{u} (𝟙 (structureSheaf B S hS).obj)).map
      (pullbackSectionsComparison B S hS F)) := by
  have hW : (topology B S hS).W
      ((PresheafOfModules.toPresheaf (structureSheaf B S hS).obj).map
        (pullbackSectionsComparison B S hS F)) :=
    GrothendieckTopology.W_of_isLocallyBijective _ _
  rw [GrothendieckTopology.W_iff] at hW
  exact (isIso_iff_of_reflects_iso
    ((PresheafOfModules.sheafification.{u} (𝟙 (structureSheaf B S hS).obj)).map
      (pullbackSectionsComparison B S hS F))
    (SheafOfModules.toSheaf (structureSheaf B S hS))).1 hW

/-- **Stacks 070S (2).**  Let `F` be an arbitrary sheaf of `𝒪_S`-modules.  The pullback of `F`
along the morphism of ringed sites `id_{small,étale,Zar} : (S_étale, 𝒪) → (S_Zar, 𝒪_S)` is the
étale sheafification of the presheaf `(f : T → S) ↦ Γ(T, f^*F)` on `S_étale`.

The pullback is `AlgebraicGeometry.SmallEtale.associatedModule`, presented by
`AlgebraicGeometry.SmallEtale.associatedModuleSheafificationIso` as the sheafification of the
pullback of presheaves of modules, and the identification is the sheafification of the
comparison `AlgebraicGeometry.SmallEtale.pullbackSectionsComparison`, an isomorphism by
`AlgebraicGeometry.SmallEtale.isIso_sheafification_map_pullbackSectionsComparison`. -/
@[stacks 070S "part (2)"]
public noncomputable def associatedModuleIsoPullbackSections (F : S.Modules) :
    (associatedModule B S hS).obj F ≅
      (PresheafOfModules.sheafification.{u} (𝟙 (structureSheaf B S hS).obj)).obj
        (pullbackSectionsPresheaf B S hS F) :=
  (associatedModuleSheafificationIso B S hS).app F ≪≫
    @asIso _ _ _ _ _ (isIso_sheafification_map_pullbackSectionsComparison B S hS F)

/-- For a quasi-coherent `F`, the comparison `AlgebraicGeometry.SmallEtale.sectionsComparison`
is `AlgebraicGeometry.SmallEtale.pullbackSectionsComparison`. -/
public theorem sectionsComparison_eq_pullbackSectionsComparison (F : S.Modules)
    [F.IsQuasicoherent] :
    SmallEtale.sectionsComparison B S hS F = SmallEtale.pullbackSectionsComparison B S hS F :=
  rfl

end AlgebraicGeometry.SmallEtale

end
