module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Free
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent
public import StacksFrontier.AlgebraicGeometry.Descent.AssociatedModule.EssentialImage
public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.Descent.Smallness

/-!
# A global presentation by free modules forces generation by global sections

A sheaf of modules exhibited as a cokernel `⊕_{I₂} 𝒪 ⟶ ⊕_{I₁} 𝒪 ⟶ 𝒢 ⟶ 0` of a morphism of free
modules is a quotient of a free module, hence is generated by the `I₁` *global* sections that the
second map names — this is Mathlib's `SheafOfModules.generatorsOfIsCokernelFree`.  The results
below extract the consequence of that which obstructs such a presentation: if `𝒢` has no nonzero
global section then every morphism to `𝒢` from a free module is zero, and a module exhibited as a
cokernel along a zero morphism is a zero object.

## Main results

* `SheafOfModules.eq_zero_of_subsingleton_sections`: a morphism from a free sheaf of modules to a
  sheaf of modules with no nonzero global section is zero.
* `SheafOfModules.isZero_of_isColimit_cokernelCofork_free`: a sheaf of modules with no nonzero
  global section which is a cokernel of a morphism of free modules is a zero object.
* `AlgebraicGeometry.BigFppfOver.isZero_of_globalFreePresentation` and
  `AlgebraicGeometry.BigFppfOver.isZero_of_globalFreePresentation_of_restrictModule`: the same
  statement at the big fppf site of a scheme `S`, the second with the hypothesis read on the small
  Zariski site of `S` through `AlgebraicGeometry.BigFppfOver.sectionsEquivRestrictModule`.
* `AlgebraicGeometry.BigFppfOver.not_exists_globalFreePresentation`: consequently a nonzero module
  on the big fppf site of `S` with no nonzero global section admits **no** global presentation by
  free modules indexed at `Type u`.
* `AlgebraicGeometry.BigFppfOver.HasLocalFreePresentations`: the statement that replaces it —
  presentations by free modules indexed at `Type u` on the members of a covering of `S`, which is
  Mathlib's `SheafOfModules.QuasicoherentData`.  Stating it at this site needs sheafification and
  the local description of weak equivalences on every slice of the site, which
  `AlgebraicGeometry.BigFppfOver.hasWeakSheafify_over_topology` and
  `AlgebraicGeometry.BigFppfOver.wEqualsLocallyBijective_over_topology` record as instances.

## Implementation notes

The hypothesis of
`AlgebraicGeometry.BigFppfOver.exists_isQuasicoherent_iso_associatedModule_of_cokernelFree'` is a
global presentation by free modules indexed at `Type u`.  The last result above shows that this
hypothesis is not a consequence of quasi-coherence: a quasi-coherent module on the big fppf site
of a scheme need not be generated by its global sections.  Already for `S` a projective curve over
a field and `L` an invertible `𝒪_S`-module with `Γ(S, L) = 0`, the module `L^a` is quasi-coherent,
is not a zero object, and has `Γ(S^{big}, L^a) ≅ Γ(S, L) = 0` — the first isomorphism being
`AlgebraicGeometry.BigFppfOver.sectionsEquivRestrictModule` composed with Stacks 070S (1),
`AlgebraicGeometry.BigFppfOver.associatedModuleIsoSections`.  So the global presentation must be
produced over the *members of a covering* and then descended (Stacks 023T), which is what the
proof of Stacks 03DX (1) does; it cannot be produced over `S` itself.  Mathlib's own
`SheafOfModules.IsQuasicoherent` is phrased exactly that way: `SheafOfModules.QuasicoherentData`
carries a `Type u`-indexed `SheafOfModules.Presentation` of `M.over (X i)` for a family `X`
covering the terminal object, and never a presentation of `M`.

Nothing here is tagged: these are obstructions, not clauses of a source statement.

## References

* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
* [Stacks Project, Tag 023T](https://stacks.math.columbia.edu/tag/023T)
* [Stacks Project, Tag 01B4](https://stacks.math.columbia.edu/tag/01B4)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u w₁ w₂

namespace SheafOfModules

variable {D : Type w₁} [Category.{w₂} D] {K : GrothendieckTopology D} {A : Sheaf K RingCat.{u}}
  [HasWeakSheafify K AddCommGrpCat.{u}] [K.WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- **A morphism from a free module to a module with no global sections vanishes.**  A morphism
`free I ⟶ M` is the datum of a family `I → M.sections` of global sections of `M`, so if `M` has
only the zero global section there is only the zero morphism. -/
public theorem eq_zero_of_subsingleton_sections {I : Type u} {M : SheafOfModules.{u} A}
    (hs : Subsingleton M.sections) (f : free (R := A) I ⟶ M) : f = 0 :=
  M.freeHomEquiv.injective (funext fun _ ↦ hs.elim _ _)

/-- **A module with no global sections presented by free modules is zero.**  The second map of a
presentation `free I₂ ⟶ free I₁ ⟶ M` is an epimorphism, being a cokernel projection, and it is
zero by `SheafOfModules.eq_zero_of_subsingleton_sections`; an epimorphism which is zero has a
zero target. -/
public theorem isZero_of_isColimit_cokernelCofork_free {I₁ I₂ : Type u}
    (α : free (R := A) I₂ ⟶ free I₁) {M : SheafOfModules.{u} A}
    {π : free (R := A) I₁ ⟶ M} (hπ : α ≫ π = 0)
    (hc : IsColimit (CokernelCofork.ofπ π hπ)) (hs : Subsingleton M.sections) : IsZero M :=
  have : Epi π := by simpa using epi_of_isColimit_cofork hc
  IsZero.of_epi_eq_zero π (eq_zero_of_subsingleton_sections hs π)

end SheafOfModules

namespace AlgebraicGeometry.BigFppfOver

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {G : SheafOfModules.{u} (structureSheaf B S hS)}

/-- **A module on the big fppf site of `S` with no global sections presented by free modules is
zero.**  This is `SheafOfModules.isZero_of_isColimit_cokernelCofork_free` at the big fppf site of
`S`, where the presentation is the hypothesis of
`AlgebraicGeometry.BigFppfOver.exists_isQuasicoherent_iso_associatedModule_of_cokernelFree'`. -/
public theorem isZero_of_globalFreePresentation (hs : Subsingleton G.sections) {I₁ I₂ : Type u}
    (α : SheafOfModules.free (R := structureSheaf B S hS) I₂ ⟶ SheafOfModules.free I₁)
    {π : SheafOfModules.free (R := structureSheaf B S hS) I₁ ⟶ G} (hπ : α ≫ π = 0)
    (hc : IsColimit (CokernelCofork.ofπ π hπ)) : IsZero G :=
  SheafOfModules.isZero_of_isColimit_cokernelCofork_free α hπ hc hs

/-- **The vanishing hypothesis read on the small Zariski site of `S`.**  The global sections of a
module on the big fppf site of `S` are the global sections of its restriction to the small Zariski
site of `S`, by `AlgebraicGeometry.BigFppfOver.sectionsEquivRestrictModule`, so it is enough that
the restriction have no nonzero global section. -/
public theorem isZero_of_globalFreePresentation_of_restrictModule
    (hs : Subsingleton ((restrictModule B S hS).obj G).sections) {I₁ I₂ : Type u}
    (α : SheafOfModules.free (R := structureSheaf B S hS) I₂ ⟶ SheafOfModules.free I₁)
    {π : SheafOfModules.free (R := structureSheaf B S hS) I₁ ⟶ G} (hπ : α ≫ π = 0)
    (hc : IsColimit (CokernelCofork.ofπ π hπ)) : IsZero G :=
  isZero_of_globalFreePresentation B S hS
    (sectionsEquivRestrictModule B S hS G).subsingleton α hπ hc

/-- **A nonzero module with no global sections has no global presentation by free modules.**  This
is the obstruction to the hypothesis of
`AlgebraicGeometry.BigFppfOver.exists_isQuasicoherent_iso_associatedModule_of_cokernelFree'`: it
is not implied by quasi-coherence, since a quasi-coherent module on the big fppf site of a scheme
need not be generated by its global sections.  See the implementation notes of this file. -/
public theorem not_exists_globalFreePresentation (hG : ¬ IsZero G)
    (hs : Subsingleton G.sections) :
    ¬ ∃ (I₁ I₂ : Type u)
      (α : SheafOfModules.free (R := structureSheaf B S hS) I₂ ⟶ SheafOfModules.free I₁)
      (π : SheafOfModules.free (R := structureSheaf B S hS) I₁ ⟶ G) (hπ : α ≫ π = 0),
      Nonempty (IsColimit (CokernelCofork.ofπ π hπ)) := by
  rintro ⟨I₁, I₂, α, π, hπ, ⟨hc⟩⟩
  exact hG (isZero_of_globalFreePresentation B S hS hs α hπ hc)

/-- Sheafification into abelian groups exists on every localization of the big fppf site of `S`
at an object: this is `AlgebraicGeometry.BigFppfOver.hasWeakSheafify_over` at `τ = fppf`, recorded
as an instance because Mathlib's local presentation data asks for it on every slice. -/
public instance hasWeakSheafify_over_topology (X : BigFppfOver B S hS) :
    HasWeakSheafify ((topology B S hS).over X) AddCommGrpCat.{u} :=
  hasWeakSheafify_over B S hS .fppf X

/-- Weak equivalences of abelian presheaves on every localization of the big fppf site of `S` at
an object are the locally bijective maps: this is
`AlgebraicGeometry.BigFppfOver.wEqualsLocallyBijective_over` at `τ = fppf`, recorded as an
instance for the same reason. -/
public instance wEqualsLocallyBijective_over_topology (X : BigFppfOver B S hS) :
    ((topology B S hS).over X).WEqualsLocallyBijective AddCommGrpCat.{u} :=
  wEqualsLocallyBijective_over B S hS .fppf X

/-- **Local presentations by free modules indexed at `Type u`**, the statement that replaces the
global one obstructed above: a family of objects of the big fppf site of `S` covering the terminal
object, together with a `Type u`-indexed presentation by free modules of the restriction of `G` to
each member.  This is Mathlib's `SheafOfModules.QuasicoherentData` at the big fppf site of `S`,
with its covering index type at `Type u` as well; it is the hypothesis from which the proof of
Stacks 03DX (1) runs the local step on each member and then appeals to the effectivity of descent,
Stacks 023T. -/
public abbrev HasLocalFreePresentations (G : SheafOfModules.{u} (structureSheaf B S hS)) : Prop :=
  Nonempty (SheafOfModules.QuasicoherentData.{u} G)

end AlgebraicGeometry.BigFppfOver

end
