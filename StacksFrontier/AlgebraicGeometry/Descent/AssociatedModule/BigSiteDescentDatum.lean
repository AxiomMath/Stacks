@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u w

namespace AlgebraicGeometry

namespace BigFppfOver

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### A family of objects of the big site, read downstairs -/

/-- **A family of objects of `(Sch/S)_fppf`, read as a family of schemes over `S`.**  An object
of the big fppf category over `S` *is* a scheme over `S`, so a family of them is a family of
morphisms of schemes with target `S`; this is that family, in the shape in which
`AlgebraicGeometry.Scheme.fpqcPrecoverage` and
`AlgebraicGeometry.QuasicoherentDescentData` consume a covering family of `S`. -/
public abbrev objHypercover {I : Type w} (X : I → BigFppfOver B S hS) :
    PreZeroHypercover.{w} S :=
  ⟨I, fun i => objScheme B S hS (X i), fun i => objHom B S hS (X i)⟩

/-- **The local datum of Stacks 03DX (1) at an object of the big fppf site.**  The restriction of
`𝒢` to the big fppf site of the scheme `X` of an object `T` over `S` is the associated module
`𝓕^a` of a quasi-coherent `𝒪_X`-module `𝓕`.

This is what `AlgebraicGeometry.BigFppfOver`
`.exists_isQuasicoherent_iso_associatedModule_objRestrict` — Stacks 03DV together with the local
step, unconditionally — supplies at a member of a covering family, and the hypothesis from which
the gluing step of Stacks 03DX (1) starts. -/
public abbrev HasLocalAssociatedModule (G : SheafOfModules.{u} (structureSheaf B S hS))
    (T : BigFppfOver B S hS) : Prop :=
  ∃ F : (objScheme B S hS T).Modules, F.IsQuasicoherent ∧
    Nonempty ((associatedModule B (objScheme B S hS T)
      (contains_objScheme B S hS T)).obj F ≅ (objRestrict B S hS T).obj G)

/-! ### Refining a covering family of the final object -/

/-- **Every family covering the final object of `(Sch/S)_fppf` is refined by one whose structure
morphisms are an fpqc covering family of `S`.**  Given `X : I → (Sch/S)_fppf` covering the final
object, there is a family `Y : J → (Sch/S)_fppf`, indexed at the universe of the site's objects,
which again covers the final object, whose family of structure morphisms `Y j ⟶ S` is an fppf
covering family of the scheme `S`, and each of whose members admits a morphism to a member
of `X`.

The point of the statement is the second clause: a family of objects of the big fppf category
over `S` consists of arbitrary schemes over `S`, so its structure morphisms need not be flat,
and a covering family of the final object is in general *not* a covering family of `S` for any
topology on schemes.  The sieve `Sieve.ofObjects X` of the final object is covering, however, so
`AlgebraicGeometry.exists_family_of_mem_topology` — the content of Stacks 021R and 021S —
produces inside it a family of morphisms of schemes which is flat, locally of finite
presentation and jointly surjective, that is, an fppf covering family of `S`; being inside the
sieve is exactly the third clause, and generating a covering sieve of the final object is the
first. -/
public theorem exists_coversTop_fppf_refinement {I : Type w} (X : I → BigFppfOver B S hS)
    (hX : (topology B S hS).CoversTop X) :
    ∃ (J : Type (u + 1)) (Y : J → BigFppfOver B S hS),
      (topology B S hS).CoversTop Y ∧
        (objHypercover B S hS Y).presieve₀ ∈ Scheme.fppfPrecoverage.{u} S ∧
        ∀ j, ∃ i, Nonempty (Y j ⟶ X i) := by
  obtain ⟨J, W, m, hfac, hflat, hlfp, hsurj⟩ :=
    exists_family_of_mem_topology B S hS (hX (Over.mk (𝟙 (B.obj hS))))
  have hiso : ∀ j, (Over.mk (m j) : BigFppfOver B S hS) ≅
      Over.mk (m j ≫ (Over.mk (𝟙 (B.obj hS)) : BigFppfOver B S hS).hom) :=
    fun j => Over.isoMk (Iso.refl _) (by simp)
  refine ⟨J, fun j => Over.mk (m j), ?_, ?_, ?_⟩
  · rw [GrothendieckTopology.coversTop_iff_of_isTerminal (topology B S hS)
      (Over.mk (𝟙 (B.obj hS))) Over.mkIdTerminal]
    refine (topology B S hS).superset_covering ?_
      (mem_topology_of_family B S hS W m hflat hlfp hsurj)
    rintro V k ⟨T, a, b, ⟨j⟩, rfl⟩
    exact ⟨j, ⟨a ≫ (hiso j).inv⟩⟩
  · rw [Scheme.fppfPrecoverage, Scheme.ofArrows_mem_precoverage_iff]
    exact ⟨hsurj, fun j => ⟨hflat j, hlfp j⟩⟩
  · intro j
    obtain ⟨i, ⟨b⟩⟩ := hfac j
    exact ⟨i, ⟨(hiso j).hom ≫ b⟩⟩

/-- **Every family covering the final object of `(Sch/S)_fppf` is refined by one whose structure
morphisms are an fpqc covering family of `S`.**  This is
`AlgebraicGeometry.BigFppfOver.exists_coversTop_fppf_refinement` read through
`AlgebraicGeometry.Scheme.fppfPrecoverage_le_fpqcPrecoverage`, and it is the form in which
descent for quasi-coherent sheaves — Stacks 023T, stated for fpqc covering families — consumes
the refinement. -/
public theorem exists_coversTop_fpqc_refinement {I : Type w} (X : I → BigFppfOver B S hS)
    (hX : (topology B S hS).CoversTop X) :
    ∃ (J : Type (u + 1)) (Y : J → BigFppfOver B S hS),
      (topology B S hS).CoversTop Y ∧
        (objHypercover B S hS Y).presieve₀ ∈ Scheme.fpqcPrecoverage.{u} S ∧
        ∀ j, ∃ i, Nonempty (Y j ⟶ X i) := by
  obtain ⟨J, Y, hY, hfppf, hre⟩ := exists_coversTop_fppf_refinement B S hS X hX
  exact ⟨J, Y, hY, Scheme.fppfPrecoverage_le_fpqcPrecoverage _ hfppf, hre⟩

/-! ### The residue of the gluing step -/

/-- **The descent datum of Stacks 03DX (1) as a hypothesis, with the refinement of the covering
family already performed.**  Out of a sheaf of modules `𝒢` on `(Sch/S)_fppf` whose restriction
to the big fppf site of the scheme of each member of a covering family `X` of the final object is
an associated module, *and* a refinement `Y` of `X` whose structure morphisms already are an fpqc
covering family of `S`, it produces an fpqc covering family of `S` and a quasi-coherent descent
datum for it whose effectivity — the effectivity half of Stacks 023T — exhibits `𝒢` as an
associated module.

Compared with `AlgebraicGeometry.BigFppfOver.AssociatedModuleGlueDescentDatum` this is a weaker
hypothesis in two respects, both of them discharged in this file: the refinement `Y`, which
`AlgebraicGeometry.BigFppfOver.exists_coversTop_fpqc_refinement` supplies unconditionally, and
the conclusion, which here is a single global isomorphism rather than a compatible family of
local ones — the passage from the former to the latter being formal and the passage from the
latter to the former being the Stacks 03EM step, already proved as
`AlgebraicGeometry.BigFppfOver.essImage_associatedModuleQcoh_of_forall_memberProd`. -/
public abbrev AssociatedModuleDatumOfRefinement : Prop :=
  ∀ (G : SheafOfModules.{u} (structureSheaf B S hS)) (I : Type (u + 1))
      (X : I → BigFppfOver B S hS), (topology B S hS).CoversTop X →
      (∀ i, HasLocalAssociatedModule B S hS G (X i)) →
      ∀ (J : Type (u + 1)) (Y : J → BigFppfOver B S hS),
        (topology B S hS).CoversTop Y →
        (objHypercover B S hS Y).presieve₀ ∈ Scheme.fpqcPrecoverage.{u} S →
        (∀ j, ∃ i, Nonempty (Y j ⟶ X i)) →
    ∃ (𝒰 : PreZeroHypercover.{u + 1} S) (_ : 𝒰.presieve₀ ∈ Scheme.fpqcPrecoverage.{u} S)
      (D : QuasicoherentDescentData 𝒰.f), D.IsEffective →
        (associatedModuleQcoh B S hS).essImage G

/-- **The residue implies the descent datum of Stacks 03DX (1).**  The refinement that
`AlgebraicGeometry.BigFppfOver.AssociatedModuleDatumOfRefinement` asks for is supplied by
`AlgebraicGeometry.BigFppfOver.exists_coversTop_fpqc_refinement`, and the compatible family of
local isomorphisms that
`AlgebraicGeometry.BigFppfOver.AssociatedModuleGlueDescentDatum` asks for consists of the
restrictions of the global isomorphism `𝓕^a ≅ 𝒢`, which agree over the fibre products
`X i ×_S X j` because relocalizing the restriction of a global morphism returns its
restriction. -/
public theorem associatedModuleGlueDescentDatum_of_datumOfRefinement
    (h : AssociatedModuleDatumOfRefinement B S hS) :
    AssociatedModuleGlueDescentDatum B S hS := by
  intro G I X hX hF
  obtain ⟨J, Y, hY, hfpqc, hre⟩ := exists_coversTop_fpqc_refinement B S hS X hX
  obtain ⟨𝒰, h𝒰, D, hD⟩ := h G I X hX hF J Y hY hfpqc hre
  refine ⟨𝒰, h𝒰, D, fun heff => ?_⟩
  obtain ⟨⟨𝓕, h𝓕⟩, ⟨φ⟩⟩ := hD heff
  refine ⟨𝓕, h𝓕, fun i => (restrFun (commStructurePresheaf B S hS) (X i)).mapIso
    ((SheafOfModules.forget _).mapIso φ), fun i j => ?_⟩
  rfl

/-- **The descent datum of Stacks 03DX (1) implies the residue**, so assuming the latter is not a
strengthening.  The extra inputs the residue receives are simply discarded, and its weaker
conclusion is obtained from the stronger one by the Stacks 03EM step
`AlgebraicGeometry.BigFppfOver.essImage_associatedModuleQcoh_of_forall_memberProd`, which is
unconditional. -/
public theorem datumOfRefinement_of_associatedModuleGlueDescentDatum
    (h : AssociatedModuleGlueDescentDatum B S hS) :
    AssociatedModuleDatumOfRefinement B S hS := by
  intro G I X hX hF _ _ _ _ _
  obtain ⟨𝒰, h𝒰, D, hD⟩ := h G I X hX hF
  refine ⟨𝒰, h𝒰, D, fun heff => ?_⟩
  obtain ⟨𝓕, h𝓕, e, he⟩ := hD heff
  exact essImage_associatedModuleQcoh_of_forall_memberProd B S hS G X hX 𝓕 h𝓕 e he

/-- **The residue and the descent datum of Stacks 03DX (1) are equivalent.**  The refinement to
an fpqc covering family of `S` and the assembly of the local isomorphisms are therefore *not*
part of what the appeal to Stacks 023T supplies: what is left is exactly the construction of a
quasi-coherent descent datum out of the local associated-module data. -/
public theorem associatedModuleDatumOfRefinement_iff :
    AssociatedModuleDatumOfRefinement B S hS ↔ AssociatedModuleGlueDescentDatum B S hS :=
  ⟨associatedModuleGlueDescentDatum_of_datumOfRefinement B S hS,
    datumOfRefinement_of_associatedModuleGlueDescentDatum B S hS⟩

end BigFppfOver

end AlgebraicGeometry

end
