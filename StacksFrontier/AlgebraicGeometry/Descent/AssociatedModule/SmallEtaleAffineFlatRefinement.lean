module

public import StacksFrontier.AlgebraicGeometry.Descent.AssociatedModule.SmallEtaleCartesian
public import StacksFrontier.AlgebraicGeometry.Topologies.CartesianFlatSectionsDescent

/-!
# The small affine étale site has flat cartesian refinements

Every covering sieve of an object of the small affine étale site of a scheme `S` contains a
*finite* family whose underlying map of affine schemes is a flat covering, hence whose
restriction maps on rings of regular functions are jointly faithfully flat.  For a presheaf of
modules over the chart rings which is cartesian over every arrow of that site this is exactly
`Stacks.PresheafOfModules.HasFlatCartesianRefinement`, so the faithfully flat descent of spans of
sections applies there.

The finite flat refinement is `Stacks.Sites.exists_finite_flat_refinement` at the precoverage of
the small affine étale site, whose coverings are finite and flat over the schemes by
`AlgebraicGeometry.SmallEtale.smallAffineEtale_covering_finite_flat`; joint faithful flatness is
`AlgebraicGeometry.SmallEtale.faithfullyFlat_pi_affineChartRings`.  The one piece of work is
reindexing the refinement — produced indexed by a `Finite` type — onto `Fin n`.

## Main results

* `AlgebraicGeometry.SmallEtale.hasFlatCartesianRefinement_affineChartRings`: **a cartesian
  presheaf of modules over the chart rings of the small affine étale site has flat cartesian
  refinements at every object.**
* `AlgebraicGeometry.SmallEtale.module_finite_sections_affineChart_of_locally_generates`: hence
  finitely many sections generating such a module on the members of a covering of an object make
  its sections there a finite module over the chart ring.

## References

* [Stacks Project, Tag 021B](https://stacks.math.columbia.edu/tag/021B)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u m

namespace AlgebraicGeometry.SmallEtale

variable (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **A cartesian presheaf of modules over the chart rings of the small affine étale site of `S`
has flat cartesian refinements at every object.**  A covering sieve of an object is refined by a
finite family which is a flat covering of the underlying affine schemes, and such a family is
jointly faithfully flat on rings of regular functions. -/
theorem hasFlatCartesianRefinement_affineChartRings
    (M : PresheafOfModules.{max m u}
      (affineChartRings B S hS ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {X Y : (SmallAffineEtale B S hS)ᵒᵖ} (f : X ⟶ Y),
      Function.Bijective (Stacks.PresheafOfModules.restrictionBaseChange.{u + 1, u, u, m} M f))
    (W : SmallAffineEtale B S hS) :
    Stacks.PresheafOfModules.HasFlatCartesianRefinement.{u + 1, u, u, m}
      (SmallAffineEtale.topology B S hS) M (fun _ => True) W := by
  classical
  intro T hT
  obtain ⟨E, hfin, hE, hES⟩ := Stacks.Sites.exists_finite_flat_refinement
    (SmallAffineEtale.toScheme B S hS) (SmallAffineEtale.precoverage B S hS)
    (smallAffineEtale_covering_finite_flat B S hS) T hT
  have _ := hfin
  obtain ⟨cnt, ⟨e⟩⟩ := Finite.exists_equiv_fin E.I₀
  obtain ⟨hcov, hfl⟩ := (Scheme.presieve₀_mem_precoverage_iff
    (E.map (SmallAffineEtale.toScheme B S hS))).mp hE
  have hcov' : ∀ x : (SmallAffineEtale.toScheme B S hS).obj W, ∃ i : E.I₀,
      x ∈ Set.range ((SmallAffineEtale.toScheme B S hS).map (E.f i)) := hcov
  have hfl' : ∀ i : E.I₀,
      Flat ((SmallAffineEtale.toScheme B S hS).map (E.f i)) := hfl
  refine ⟨cnt, fun i => E.X (e.symm i), fun i => E.f (e.symm i), fun _ => trivial,
    fun i => hES _ (Sieve.le_generate E.presieve₀ _ _ (Presieve.ofArrows.mk (e.symm i))),
    ?_, fun i => hM _⟩
  refine faithfullyFlat_pi_affineChartRings B S hS (fun i => E.X (e.symm i))
    (fun i => E.f (e.symm i)) (fun x => ?_) (fun i => hfl' (e.symm i))
  obtain ⟨i, hi⟩ := hcov' x
  exact ⟨e i, by rwa [e.symm_apply_apply]⟩

/-- **The sections of a cartesian presheaf of modules over the chart rings which is locally
generated by finitely many sections over an object of the small affine étale site form a finite
module over the chart ring there.**  This is
`Stacks.PresheafOfModules.module_finite_sections_of_locally_generates` with its refinement
hypothesis discharged by
`AlgebraicGeometry.SmallEtale.hasFlatCartesianRefinement_affineChartRings`. -/
theorem module_finite_sections_affineChart_of_locally_generates
    (M : PresheafOfModules.{max m u}
      (affineChartRings B S hS ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {X Y : (SmallAffineEtale B S hS)ᵒᵖ} (f : X ⟶ Y),
      Function.Bijective (Stacks.PresheafOfModules.restrictionBaseChange.{u + 1, u, u, m} M f))
    {W : SmallAffineEtale B S hS} {I : Type*} {V : I → SmallAffineEtale B S hS}
    {f : ∀ i, V i ⟶ W} (hcov : Sieve.ofArrows V f ∈ SmallAffineEtale.topology B S hS W)
    (hgen : ∀ i, ∃ (k : ℕ) (s : Fin k → M.obj (op (V i))),
      PresheafOfModules.Generates (SmallAffineEtale.topology B S hS) M s) :
    Module.Finite ((affineChartRings B S hS).obj (op W)) (M.obj (op W)) :=
  Stacks.PresheafOfModules.module_finite_sections_of_locally_generates M
    (SmallAffineEtale.topology B S hS)
    (fun V _ => hasFlatCartesianRefinement_affineChartRings B S hS M hM V)
    (hasFlatCartesianRefinement_affineChartRings B S hS M hM W) hcov hgen

end AlgebraicGeometry.SmallEtale

end
