-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-- **A cardinal bound of `r` on the local generators of a module on a scheme is local
generation by `r` sections**, Modules on Sites, Definition 03DL (4).

`SheafOfModules.IsCardinalGenerated` bounds the index type of the generating family on each
member of the covering by the cardinal of `r`, where 03DL (4) asks for an index type equivalent
to `Fin r`.  The covering is the same and the generating family on a member is padded out by the
zero section along the embedding of its index type into `ULift (Fin r)` that the cardinal bound
provides.

This is the shape in which Stacks 082U,
`AlgebraicGeometry.isCardinalGenerated_of_pullback_fpqc`, delivers the descent of 03DL (4). -/
theorem isLocallyGeneratedByOnSite_of_isCardinalGenerated {X : Scheme.{u}} (M : X.Modules)
    (r : ℕ) (h : SheafOfModules.IsCardinalGenerated.{u} M (Cardinal.lift.{u, 0} r)) :
    SheafOfModules.IsLocallyGeneratedByOnSite M r := by
  classical
  obtain ⟨σ, hσ⟩ := h
  refine Stacks.SheafOfModules.isLocallyGeneratedByOnSite_of_coversTop M r σ.X σ.coversTop
    fun i ↦ ?_
  have hbound : Cardinal.mk (σ.generators i).I ≤ Cardinal.mk (ULift.{u, 0} (Fin r)) := by
    simpa using hσ i
  obtain ⟨e⟩ := (Cardinal.le_def _ _).mp hbound
  let s : ULift.{u, 0} (Fin r) → (M.over (σ.X i)).sections := fun j =>
    if hj : ∃ k, e k = j then (σ.generators i).s hj.choose
    else (M.over (σ.X i)).unitHomEquiv
      (0 : SheafOfModules.unit (X.ringCatSheaf.over (σ.X i)) ⟶ M.over (σ.X i))
  have hs (k : (σ.generators i).I) : s (e k) = (σ.generators i).s k := by
    have hex : ∃ j, e j = e k := ⟨k, rfl⟩
    have hchoose : hex.choose = k := e.injective hex.choose_spec
    dsimp only [s]
    rw [dite_eq_left hex, hchoose]
  refine ⟨{ I := ULift.{u, 0} (Fin r), s := s, epi := ?_ }, ⟨Equiv.ulift⟩⟩
  apply epi_of_epi_fac (f := SheafOfModules.freeMap (R := X.ringCatSheaf.over (σ.X i)) e)
    (h := (σ.generators i).π)
  apply (M.over (σ.X i)).freeHomEquiv.injective
  funext k
  rw [SheafOfModules.freeHomEquiv_comp_apply, SheafOfModules.freeHomEquiv_freeMap]
  calc
    _ = s (e k) :=
      SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection
        (R := X.ringCatSheaf.over (σ.X i)) s (e k)
    _ = (σ.generators i).s k := hs k
    _ = (M.over (σ.X i)).freeHomEquiv (σ.generators i).π k := by
      simp [SheafOfModules.GeneratingSections.π]

namespace SmallEtale

variable (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### The pullback direction -/

/-- **Generation by `r` sections of `𝓕|_V` over an open `V` of `S` is generation by `r` sections
of `(𝓕ᵃ)|_{V_étale}`.**

The associated-module functor of the localization at `V` preserves colimits and epimorphisms,
being a left adjoint, and carries the unit object to the unit object, so
`Stacks.Sheaves.QcohTypeComparison.generatingSectionsMap` carries the generating family across
without touching its index type; then
`AlgebraicGeometry.SmallEtale.associatedModuleOverObjIso` — Stacks 03DV at an open of `S` —
moves the result to the restriction of `𝓕ᵃ`. -/
theorem isGeneratedByGlobalSectionsOfCard_associatedModuleOver (V : S.Opens) (𝓕 : S.Modules)
    (r : ℕ)
    (h : SheafOfModules.IsGeneratedByGlobalSectionsOfCard
      (SheafOfModules.over.{u} (R := S.ringCatSheaf) 𝓕 V) r) :
    SheafOfModules.IsGeneratedByGlobalSectionsOfCard
      (((associatedModule B S hS).obj 𝓕).over ((opensToSmallEtale B S hS).obj V)) r := by
  have : PreservesColimitsOfSize.{u, u}
      (SheafOfModules.pullback.{u} (sliceStructureMap B S hS V)) :=
    (SheafOfModules.pullbackPushforwardAdjunction.{u}
      (sliceStructureMap B S hS V)).leftAdjoint_preservesColimits
  have : (SheafOfModules.pullback.{u} (sliceStructureMap B S hS V)).IsLeftAdjoint :=
    (SheafOfModules.pullbackPushforwardAdjunction.{u}
      (sliceStructureMap B S hS V)).isLeftAdjoint
  have : (SheafOfModules.pullback.{u} (sliceStructureMap B S hS V)).PreservesEpimorphisms :=
    Functor.preservesEpimorphisms_of_isLeftAdjoint _
  exact Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSectionsOfCard_of_iso
    (associatedModuleOverObjIso B S hS V 𝓕) r
    ⟨Stacks.Sheaves.QcohTypeComparison.generatingSectionsMap _
      (asIso (SheafOfModules.pullbackObjUnitToUnit.{u} (sliceStructureMap B S hS V)))
      h.choose, h.choose_spec⟩

/-- **Descent, Lemma 05VG for Modules on Sites, Definition 03DL (4): the pullback direction, at
the small étale site.**  If an `𝒪_S`-module `𝓕` is locally generated by `r` sections on the
small Zariski site of `S`, then `𝓕ᵃ` is locally generated by `r` sections as an `𝒪`-module on
`S_étale`.

The source's argument: Stacks 03DN at the small Zariski site produces a Zariski covering of `S`
on whose members `𝓕` is generated by `r` sections, its image covers the final object of
`S_étale`, on each member the restriction of `𝓕ᵃ` is generated by `r` sections by
`AlgebraicGeometry.SmallEtale.isGeneratedByGlobalSectionsOfCard_associatedModuleOver`, and
Stacks 03DN at `S_étale` assembles the conclusion.  No quasi-coherence enters this half.

No `stacks` attribute is carried: 05VG's clause for 03DL (4) asserts an equivalence, and this is
one implication of it.  The equivalence is
`AlgebraicGeometry.SmallEtale.isLocallyGeneratedByOnSite_associatedModule_iff`, below. -/
theorem isLocallyGeneratedByOnSite_associatedModule_of_isLocallyGeneratedByOnSite
    (𝓕 : S.Modules) (r : ℕ)
    (h : SheafOfModules.IsLocallyGeneratedByOnSite (R := S.ringCatSheaf) 𝓕 r) :
    SheafOfModules.IsLocallyGeneratedByOnSite ((associatedModule B S hS).obj 𝓕) r := by
  obtain ⟨I, V, hV, hgen⟩ :=
    (Stacks.SheafOfModules.isLocallyGeneratedByOnSite_iff_exists_cover_generators
      S.zariskiRingedSite 𝓕 r).1 h
  refine Stacks.SheafOfModules.isLocallyGeneratedByOnSite_of_coversTop _ r
    (fun i : ULift.{u + 1} I ↦ (opensToSmallEtale B S hS).obj (V i.down))
    (coversTop_opensToSmallEtale_ulift B S hS V hV) fun i ↦ ?_
  exact isGeneratedByGlobalSectionsOfCard_associatedModuleOver B S hS (V i.down) 𝓕 r
    (hgen i.down)

/-! ### The descent direction -/

section Object

variable (U : SmallEtale B S hS)

/-- **Generation by `r` sections of `(𝓕ᵃ)|_{S_étale/U}` is generation by `r` sections of
`f^*𝓕`**, where `f : Y ⟶ S` is the structure morphism of `U`.

Two steps, each an identification already in the library.  The crossover of Stacks 06WI,
`AlgebraicGeometry.SmallEtale.objRestrictFunctor`, is the functor of an equivalence of ringed
sites and carries the structure sheaf to the structure sheaf by
`AlgebraicGeometry.SmallEtale.objRestrictFunctorUnitIso`, so
`Stacks.Sheaves.QcohTypeComparison.generatingSectionsMap` carries the generating family to the
small étale site of the scheme of `U` without touching its index type; and Stacks 03DV at an
arbitrary object of the small étale site,
`AlgebraicGeometry.SmallEtale.associatedModuleObjRestrictObjIso`, moves the result to `(f^*𝓕)ᵃ`,
whence 05VG for Modules on Sites 03DE (4) — an `iff` — reflects it down to `f^*𝓕`.  The pullback
is quasi-coherent by Stacks 01BG. -/
theorem isGeneratedByGlobalSectionsOfCard_pullback_of_over (𝓕 : S.Modules)
    [h𝓕 : 𝓕.IsQuasicoherent] (r : ℕ)
    (h : SheafOfModules.IsGeneratedByGlobalSectionsOfCard
      (((associatedModule B S hS).obj 𝓕).over U) r) :
    SheafOfModules.IsGeneratedByGlobalSectionsOfCard
      ((Scheme.Modules.pullback (objHom B S hS U)).obj 𝓕) r := by
  have : PreservesColimitsOfSize.{u, u} (objRestrictFunctor B S hS U) :=
    (objRestrictEquivalence B S hS U).toAdjunction.leftAdjoint_preservesColimits
  have : (objRestrictFunctor B S hS U).IsLeftAdjoint :=
    (objRestrictEquivalence B S hS U).toAdjunction.isLeftAdjoint
  have : (objRestrictFunctor B S hS U).PreservesEpimorphisms :=
    Functor.preservesEpimorphisms_of_isLeftAdjoint _
  have hstep : SheafOfModules.IsGeneratedByGlobalSectionsOfCard
      ((objRestrict B S hS U).obj ((associatedModule B S hS).obj 𝓕)) r :=
    ⟨Stacks.Sheaves.QcohTypeComparison.generatingSectionsMap (objRestrictFunctor B S hS U)
      (objRestrictFunctorUnitIso B S hS U) h.choose, h.choose_spec⟩
  exact (isGeneratedByGlobalSectionsOfCard_iff_associatedModule B (objScheme B S hS U)
      (contains_objScheme B S hS U)
      ⟨(Scheme.Modules.pullback (objHom B S hS U)).obj 𝓕,
        Stacks.Modules.isQuasicoherent_pullback _ 𝓕 h𝓕⟩ r).2
    (Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSectionsOfCard_of_iso
      (associatedModuleObjRestrictObjIso B S hS U 𝓕).symm r hstep)

end Object

/-- **Descent, Lemma 05VG for Modules on Sites, Definition 03DL (4): the descent direction, at
the small étale site.**  If the associated module `𝓕ᵃ` of a quasi-coherent `𝒪_S`-module is
locally generated by `r` sections as an `𝒪`-module on `S_étale`, then `𝓕` is locally generated
by `r` sections on the small Zariski site of `S`.

This is the half that carries the mathematics, and it is the source's own argument.  Stacks 03DN
produces a family covering the final object of `S_étale` on whose members `𝓕ᵃ` is generated by
`r` sections; the members are étale over `S`, hence flat, locally of finite presentation and
jointly surjective, so their structure morphisms are an fpqc covering family of `S` on the nose
— `AlgebraicGeometry.SmallEtale.presieve₀_mem_fpqcPrecoverage_coveringHypercover`.  On each
member `AlgebraicGeometry.SmallEtale.isGeneratedByGlobalSectionsOfCard_pullback_of_over` turns
the verdict into generation of the pullback of `𝓕` by `r` global sections, hence into the
cardinal bound that Stacks 082U consumes
(`Stacks.AlgebraicGeometry.CardinalGeneration.isCardinalGenerated_of_generatingSections`); 082U,
`AlgebraicGeometry.isCardinalGenerated_of_pullback_fpqc`, descends the bound to `S`, and
`AlgebraicGeometry.isLocallyGeneratedByOnSite_of_isCardinalGenerated` returns it to the
covering-family form of Stacks 03DL (4).

No `stacks` attribute: this is one implication, and the equivalence is
`AlgebraicGeometry.SmallEtale.isLocallyGeneratedByOnSite_associatedModule_iff`. -/
theorem isLocallyGeneratedByOnSite_of_associatedModule (𝓕 : S.Modules) [h𝓕 : 𝓕.IsQuasicoherent]
    (r : ℕ)
    (h : SheafOfModules.IsLocallyGeneratedByOnSite ((associatedModule B S hS).obj 𝓕) r) :
    SheafOfModules.IsLocallyGeneratedByOnSite (R := S.ringCatSheaf) 𝓕 r := by
  classical
  obtain ⟨I, X, hX, hgen⟩ :=
    (Stacks.SheafOfModules.isLocallyGeneratedByOnSite_iff_exists_cover_generators
      (smallEtaleRingedSite B S hS) ((associatedModule B S hS).obj 𝓕) r).1 h
  refine isLocallyGeneratedByOnSite_of_isCardinalGenerated 𝓕 r
    (isCardinalGenerated_of_pullback_fpqc 𝓕 h𝓕 r (coveringHypercover B S hS X).X
      (coveringHypercover B S hS X).f
      (presieve₀_mem_fpqcPrecoverage_coveringHypercover B S hS X hX) fun i ↦ ?_)
  obtain ⟨τ, ⟨e⟩⟩ :=
    isGeneratedByGlobalSectionsOfCard_pullback_of_over B S hS (X i) 𝓕 r (hgen i)
  refine Stacks.AlgebraicGeometry.CardinalGeneration.isCardinalGenerated_of_generatingSections
    τ ?_
  rw [Cardinal.mk_congr (e.trans Equiv.ulift.symm)]
  simp

/-- **Descent, Lemma 05VG for Modules on Sites, Definition 03DL (4), at the small étale site, as
an equivalence.**  A quasi-coherent `𝒪_S`-module `𝓕` is locally generated by `r` sections on the
small Zariski site of `S` if and only if `𝓕ᵃ` is locally generated by `r` sections as an
`𝒪`-module on `S_étale`.

The `only if` half is `isLocallyGeneratedByOnSite_associatedModule_of_isLocallyGeneratedByOnSite`,
which needs no quasi-coherence; the `if` half is `isLocallyGeneratedByOnSite_of_associatedModule`,
which uses it, and quasi-coherence is the hypothesis the source's clause carries.

The clause string records the scope: this is clause 03DL (4) of 05VG at the **small** site for
`τ = étale`.  The small Zariski site is
`AlgebraicGeometry.SmallZariski.isLocallyGeneratedByOnSite_iff_associatedModule`, where the
comparison is an equivalence of ringed topoi and Stacks 03DM applies directly. -/
@[stacks 05VG "locally generated by r sections (03DL (4)), small site at τ = étale, at the \
comparison functor of 03DX itself"]
theorem isLocallyGeneratedByOnSite_associatedModule_iff (𝓕 : S.Modules)
    [h𝓕 : 𝓕.IsQuasicoherent] (r : ℕ) :
    SheafOfModules.IsLocallyGeneratedByOnSite (R := S.ringCatSheaf) 𝓕 r ↔
      SheafOfModules.IsLocallyGeneratedByOnSite ((associatedModule B S hS).obj 𝓕) r :=
  ⟨isLocallyGeneratedByOnSite_associatedModule_of_isLocallyGeneratedByOnSite B S hS 𝓕 r,
    isLocallyGeneratedByOnSite_of_associatedModule B S hS 𝓕 r⟩

end SmallEtale

end AlgebraicGeometry

end
