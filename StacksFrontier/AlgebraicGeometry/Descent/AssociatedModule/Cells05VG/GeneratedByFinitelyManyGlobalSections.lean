/-!
# Generation by finitely many global sections across `𝓕 ↦ 𝓕^a`, site by site

Let `S` be a scheme and `𝓕` a quasi-coherent `𝒪_S`-module.  Descent, Lemma 05VG says that the
equivalences `QCoh(𝒪_S) ⟶ QCoh((Sch/S)_τ, 𝒪)` and `QCoh(𝒪_S) ⟶ QCoh(S_τ, 𝒪)`, `𝓕 ↦ 𝓕^a`,
of Descent, Proposition 03DX preserve and reflect the properties of modules of Modules on Sites,
Definitions 03DE, 03DL and 03ER.  For the property "generated by finitely many global
sections", Definition 03DE (5), this reads: `𝓕` is generated by finitely many global sections if
and only if `𝓕^a` is generated by finitely many global sections as an `𝒪`-module.

Definition 03DE (5) on a ringed site `(𝒞, 𝒪)`: a sheaf of `𝒪`-modules `𝓖` is generated by
finitely many global sections if there exist `n` and global sections `s₁, …, sₙ` of `𝓖` such that
the associated map `⊕_{i=1..n} 𝒪 ⟶ 𝓖` is surjective.  The library records this as
`SheafOfModules.HasFiniteGlobalGenerators` (an epimorphism from a coproduct of finitely many
copies of the structure sheaf; `add_to_stacks 03DE "generated by finitely many global sections"`),
and that is the predicate used on both sides below: on the left for `𝓕` on the site of opens of
`S` with the structure sheaf `𝒪_S`, and on the right for `𝓕^a` on the site in question.

The functors are those of Proposition 03DX: `AlgebraicGeometry.BigFppfOver.baseAssociatedModule`
on the big sites, `AlgebraicGeometry.SmallZariski.associatedModule`,
`AlgebraicGeometry.SmallEtale.associatedModule`, and
`AlgebraicGeometry.SmallFlatSite.associatedModule` on the small sites.

## Main results

* `Stacks.SheafOfModules.hasFiniteGlobalGenerators_iff_exists_isGeneratedByGlobalSectionsOfCard`:
  on any site, `SheafOfModules.HasFiniteGlobalGenerators` holds if and only if the module admits
  Mathlib's generating sections indexed by a type with `r` elements for some `r`.

The ten cases of the lemma for this property, in the namespace `AlgebraicGeometry.Cells05VG`:

* `hasFiniteGlobalGenerators_iff_baseAssociatedModule_zariski`: the case of `(Sch/S)_Zar`.
* `hasFiniteGlobalGenerators_iff_baseAssociatedModule_etale`: the case of `(Sch/S)_étale`.
* `hasFiniteGlobalGenerators_iff_baseAssociatedModule_smooth`: the case of `(Sch/S)_smooth`.
* `hasFiniteGlobalGenerators_iff_baseAssociatedModule_syntomic`: the case of `(Sch/S)_syntomic`.
* `hasFiniteGlobalGenerators_iff_baseAssociatedModule_fppf`: the case of `(Sch/S)_fppf`.
* `hasFiniteGlobalGenerators_iff_smallZariskiAssociatedModule`: the case of `S_Zar`.
* `hasFiniteGlobalGenerators_iff_smallEtaleAssociatedModule`: the case of `S_étale`.
* `hasFiniteGlobalGenerators_iff_smallFlatSiteAssociatedModule_smooth`: the case of `S_smooth`.
* `hasFiniteGlobalGenerators_iff_smallFlatSiteAssociatedModule_syntomic`: the case of
  `S_syntomic`.
* `hasFiniteGlobalGenerators_iff_smallFlatSiteAssociatedModule_fppf`: the case of `S_fppf`.

## Implementation notes

The existing comparisons at the functors of Proposition 03DX
(`AlgebraicGeometry.BigFppfOver.exists_isGeneratedByGlobalSectionsOfCard_iff_baseAssociatedModule`
and its small-site counterparts) state the property as `∃ r, IsGeneratedByGlobalSectionsOfCard r`,
the sectionwise spelling.  Each case below is that comparison, read on both sides through
`Stacks.SheafOfModules.hasFiniteGlobalGenerators_iff_exists_isGeneratedByGlobalSectionsOfCard`.

The forward direction of that equivalence takes the finitely many locally spanning sections
produced by `Stacks.SheafOfModules.exists_sections_of_hasFiniteGlobalGenerators` and shows that the
map from the free module on them is locally surjective, hence an epimorphism; the backward
direction is `Stacks.SheafOfModules.hasFiniteGlobalGenerators_of_generatingSections`.

Quasi-coherence of `𝓕` is the hypothesis of the source.  On `S_Zar` the comparison used does not
need it.

## References

* [Stacks Project, Tag 05VG](https://stacks.math.columbia.edu/tag/05VG)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
* [Stacks Project, Tag 03DE](https://stacks.math.columbia.edu/tag/03DE)
-/

@[expose] public section

open CategoryTheory Opposite

universe u v w

namespace Stacks.SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
  [HasWeakSheafify J AddCommGrpCat.{w}] [J.WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- A sheaf of modules satisfying `SheafOfModules.HasFiniteGlobalGenerators` is, for some `r`,
generated by `r` global sections in the sense of
`SheafOfModules.IsGeneratedByGlobalSectionsOfCard`. -/
@[ega "0 5.1.1" "partial"]
theorem exists_isGeneratedByGlobalSectionsOfCard_of_hasFiniteGlobalGenerators
    (N : _root_.SheafOfModules.{w} R) (h : N.HasFiniteGlobalGenerators) :
    ∃ r : ℕ, N.IsGeneratedByGlobalSectionsOfCard r := by
  obtain ⟨n, σ, hgen⟩ := exists_sections_of_hasFiniteGlobalGenerators N h
  let t : ULift.{w} (Fin n) → N.sections := fun i ↦ σ i.down
  let p := N.freeHomEquiv.symm t
  have hp (V : Cᵒᵖ) (i : Fin n) :
      p.val.app V ((_root_.SheafOfModules.freeSection (R := R) (ULift.up i)).val V) =
        (σ i).val V :=
    congrArg (fun s : N.sections ↦ s.val V)
      (_root_.SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection t (ULift.up i))
  have hls : PresheafOfModules.IsLocallySurjective J p.val := by
    constructor
    intro V x
    obtain ⟨T, hT, hc⟩ := hgen V x
    apply J.superset_covering _ hT
    intro W f hf
    obtain ⟨c, hcx⟩ := hc f hf
    refine ⟨∑ i : Fin n, c i •
      (_root_.SheafOfModules.freeSection (R := R) (ULift.up i)).eval (op W), ?_⟩
    show (p.val.app (op W)).hom
      (∑ i : Fin n, c i •
        (_root_.SheafOfModules.freeSection (R := R) (ULift.up i)).eval (op W)) =
      N.val.map f.op x
    simp only [map_sum, map_smul]
    show (∑ i : Fin n, c i •
      p.val.app (op W) ((_root_.SheafOfModules.freeSection (R := R)
        (ULift.up i)).val (op W))) = _
    simpa only [hp] using hcx
  have hepi : Epi p := by
    have : (_root_.SheafOfModules.toSheaf R).ReflectsEpimorphisms :=
      Functor.reflectsEpimorphisms_of_faithful _
    apply (_root_.SheafOfModules.toSheaf R).epi_of_epi_map
    have : Sheaf.IsLocallySurjective ((_root_.SheafOfModules.toSheaf R).map p) := hls
    exact Sheaf.epi_of_isLocallySurjective _
  exact ⟨n, ⟨ULift.{w} (Fin n), t, hepi⟩, ⟨Equiv.ulift⟩⟩

/-- **Modules on Sites, Definition 03DE (5), in its two forms.**  A sheaf of modules is
generated by finitely many global sections in the sense of
`SheafOfModules.HasFiniteGlobalGenerators` (an epimorphism from a coproduct of finitely many
copies of the structure sheaf) if and only if, for some `r`, it is generated by `r` global
sections in the sense of `SheafOfModules.IsGeneratedByGlobalSectionsOfCard`. -/
theorem hasFiniteGlobalGenerators_iff_exists_isGeneratedByGlobalSectionsOfCard
    (N : _root_.SheafOfModules.{w} R) :
    N.HasFiniteGlobalGenerators ↔ ∃ r : ℕ, N.IsGeneratedByGlobalSectionsOfCard r := by
  refine ⟨exists_isGeneratedByGlobalSectionsOfCard_of_hasFiniteGlobalGenerators N, ?_⟩
  rintro ⟨r, σ, ⟨e⟩⟩
  exact hasFiniteGlobalGenerators_of_generatingSections N σ ⟨Finite.of_equiv (Fin r) e.symm⟩

end Stacks.SheafOfModules

namespace AlgebraicGeometry.Cells05VG

open Stacks.SheafOfModules (hasFiniteGlobalGenerators_iff_exists_isGeneratedByGlobalSectionsOfCard)

/-- Finite global generation of two modules is equivalent as soon as their sectionwise spellings
are. -/
private theorem hasFiniteGlobalGenerators_iff_of_exists_iff
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [HasWeakSheafify J AddCommGrpCat.{w}] [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    {C' : Type*} [Category C'] {J' : GrothendieckTopology C'} {R' : Sheaf J' RingCat.{w}}
    [HasWeakSheafify J' AddCommGrpCat.{w}] [J'.WEqualsLocallyBijective AddCommGrpCat.{w}]
    {N : SheafOfModules.{w} R} {N' : SheafOfModules.{w} R'}
    (h : (∃ r : ℕ, N.IsGeneratedByGlobalSectionsOfCard r) ↔
      ∃ r : ℕ, N'.IsGeneratedByGlobalSectionsOfCard r) :
    N.HasFiniteGlobalGenerators ↔ N'.HasFiniteGlobalGenerators :=
  (hasFiniteGlobalGenerators_iff_exists_isGeneratedByGlobalSectionsOfCard N).trans
    (h.trans (hasFiniteGlobalGenerators_iff_exists_isGeneratedByGlobalSectionsOfCard N').symm)

