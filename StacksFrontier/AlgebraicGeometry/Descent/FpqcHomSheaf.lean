module

public import StacksFrontier.AlgebraicGeometry.Descent.MorphismProperty.StandardFpqcRefinement
public import StacksFrontier.AlgebraicGeometry.Descent.PullbackSectionsSheaf.Basic
public import StacksFrontier.AlgebraicGeometry.Descent.QcohCoalgebraTransfer

/-!
# Descent of morphisms of quasi-coherent modules as one sheaf condition

`AlgebraicGeometry.FpqcDescentOfQuasicoherentHoms` asserts that for every fpqc covering family of
a scheme `S` and all quasi-coherent modules `M` and `N` on `S`, pulling morphisms `M ⟶ N` back
to the family is a bijection onto the morphisms of the associated descent data. This file
expresses it, and its one-element affine case, as sheaf conditions for the presheaf of morphisms
`CategoryTheory.Pseudofunctor.presheafHom` on the schemes over `S`.

## Main results

* `AlgebraicGeometry.fpqcDescentOfQuasicoherentHoms_iff_isSheaf_presheafHom`:
  `AlgebraicGeometry.FpqcDescentOfQuasicoherentHoms` holds if and only if, for every scheme `S`
  and all quasi-coherent modules `M` and `N` on `S`, the presheaf of morphisms
  `T ⟶ S ↦ (T^* M ⟶ T^* N)` is a sheaf for the fpqc topology on the schemes over `S`.
* `AlgebraicGeometry.isSheafFor_presheafHom_specMap`: that sheaf condition for the one-element
  presieve of a faithfully flat morphism of affine schemes.
* `AlgebraicGeometry.exists_standardFpqcCovering_sieve_le`: the standard fpqc covering of an
  affine open of the target of an fpqc covering generates a sieve contained in the sieve the
  covering generates.

## References

* [Stacks Project, Tag 023T](https://stacks.math.columbia.edu/tag/023T)
* [Stacks Project, Tag 03DT](https://stacks.math.columbia.edu/tag/03DT)
-/

@[expose] public section

open CategoryTheory Opposite
open scoped AlgebraicGeometry

universe u v

namespace AlgebraicGeometry

/-- The sieve on `Over.mk (𝟙 S)` generated by a family of morphisms to `S`, viewed as a family
of morphisms to `Over.mk (𝟙 S)`, corresponds under `CategoryTheory.Sieve.overEquiv` to the sieve
on `S` generated by the family. -/
lemma overEquiv_symm_ofArrows {S : Scheme.{u}} {I : Type*} {X : I → Scheme.{u}}
    (f : ∀ i, X i ⟶ S) :
    (Sieve.overEquiv (Over.mk (𝟙 S))).symm (Sieve.ofArrows X f) =
      Sieve.ofArrows (fun i ↦ Over.mk (f i))
        (fun i ↦ (Over.homMk (f i) : Over.mk (f i) ⟶ Over.mk (𝟙 S))) := by
  apply (Sieve.overEquiv (Over.mk (𝟙 S))).injective
  show (Sieve.overEquiv (Over.mk (𝟙 S)))
      ((Sieve.overEquiv (Over.mk (𝟙 S))).symm (Sieve.ofArrows X f)) =
    (Sieve.overEquiv (Over.mk (𝟙 S)))
      (Sieve.ofArrows (fun i ↦ Over.mk (f i))
        (fun i ↦ (Over.homMk (f i) : Over.mk (f i) ⟶ Over.mk (𝟙 S))))
  rw [OrderIso.apply_symm_apply, Sieve.overEquiv_ofArrows]
  rfl

/-- The sieve on `Over.mk (𝟙 S)` generated by an fpqc covering family of `S` is a covering sieve
for the fpqc topology on the schemes over `S`. -/
lemma ofArrows_homMk_mem_fpqcTopology_over {S : Scheme.{u}} {I : Type*}
    {X : I → Scheme.{u}} (f : ∀ i, X i ⟶ S)
    (hf : Presieve.ofArrows X f ∈ Scheme.fpqcPrecoverage.{u} S) :
    Sieve.ofArrows (fun i ↦ Over.mk (f i))
        (fun i ↦ (Over.homMk (f i) : Over.mk (f i) ⟶ Over.mk (𝟙 S))) ∈
      (Scheme.fpqcTopology.{u}.over S) (Over.mk (𝟙 S)) := by
  rw [← overEquiv_symm_ofArrows f]
  exact GrothendieckTopology.overEquiv_symm_mem_over _ _ _
    (Precoverage.generate_mem_toGrothendieck hf)

/-- If, for every scheme `S` and all quasi-coherent modules `M` and `N` on `S`, the presheaf of
morphisms between the inverse images of `M` and `N` is a sheaf for the fpqc topology on the
schemes over `S`, then morphisms of quasi-coherent modules descend along every fpqc covering
family. -/
theorem fpqcDescentOfQuasicoherentHoms_of_isSheaf_presheafHom
    (h : ∀ (S : Scheme.{u}) (M N : S.Modules), M.IsQuasicoherent → N.IsQuasicoherent →
      Presheaf.IsSheaf (Scheme.fpqcTopology.{u}.over S)
        (modulePullbackPseudofunctor.presheafHom M N)) :
    FpqcDescentOfQuasicoherentHoms.{u} := by
  intro S I X f hfpqc M N
  have hsheaf := h S M.obj N.obj inferInstance inferInstance
  rw [isSheaf_iff_isSheaf_of_type] at hsheaf
  have hb : Function.Bijective
      ((modulePullbackPseudofunctor.toDescentData f).map : (M.obj ⟶ N.obj) → _) := by
    refine (Pseudofunctor.bijective_toDescentData_map_iff
      (F := modulePullbackPseudofunctor) f M.obj N.obj).mpr ?_
    rw [Presieve.isSheafFor_iff_generate]
    exact hsheaf _ (ofArrows_homMk_mem_fpqcTopology_over f hfpqc)
  have hcomp : Function.Bijective
      ((modulePullbackPseudofunctor.toDescentData f).map ∘
        ((SheafOfModules.isQuasicoherent S.ringCatSheaf).ι.map : (M ⟶ N) → _)) :=
    hb.comp ((ObjectProperty.fullyFaithfulι
      (SheafOfModules.isQuasicoherent S.ringCatSheaf)).map_bijective M N)
  rwa [← ι_comp_toDescentData_map f M N] at hcomp

/-- Morphisms of quasi-coherent modules descend along every fpqc covering family if and only if,
for every scheme `S` and all quasi-coherent modules `M` and `N` on `S`, the presheaf on the
schemes over `S` sending `T ⟶ S` to the morphisms `T^* M ⟶ T^* N` is a sheaf for the fpqc
topology. -/
theorem fpqcDescentOfQuasicoherentHoms_iff_isSheaf_presheafHom :
    FpqcDescentOfQuasicoherentHoms.{u} ↔
      ∀ (S : Scheme.{u}) (M N : S.Modules), M.IsQuasicoherent → N.IsQuasicoherent →
        Presheaf.IsSheaf (Scheme.fpqcTopology.{u}.over S)
          (modulePullbackPseudofunctor.presheafHom M N) :=
  ⟨fun hd S M N hM hN ↦ @isSheaf_presheafHom S hd M N hM hN,
    fpqcDescentOfQuasicoherentHoms_of_isSheaf_presheafHom⟩

/-- For a faithfully flat morphism `φ : R ⟶ S` of commutative rings and quasi-coherent modules
`M` and `N` on `Spec R`, the presheaf of morphisms between the inverse images of `M` and `N` on
the schemes over `Spec R` satisfies the sheaf condition for the one-element presieve of
`Spec.map φ`. -/
theorem isSheafFor_presheafHom_specMap {R S : CommRingCat.{u}} (φ : R ⟶ S)
    (hφ : φ.hom.FaithfullyFlat) (M N : (Spec R).Modules)
    [M.IsQuasicoherent] [N.IsQuasicoherent] :
    Presieve.IsSheafFor (modulePullbackPseudofunctor.presheafHom M N)
      (Presieve.singleton
        (Over.homMk (Spec.map φ) : Over.mk (Spec.map φ) ⟶ Over.mk (𝟙 (Spec R)))) := by
  have h := (Pseudofunctor.bijective_toDescentData_map_iff
      (F := modulePullbackPseudofunctor) (fun _ : PUnit.{1} ↦ Spec.map φ) M N).mp
    (Stacks.Descent.bijective_toDescentData_map_specMap φ hφ M N)
  rwa [Presieve.ofArrows_of_unique] at h

/-- Over every affine open `V` of the target of an fpqc covering there is a standard fpqc
covering of `V` (finitely many affine schemes `Spec (A k)` jointly surjective onto `V`, with the
product of their coordinate rings faithfully flat over `Γ(V, ⊤)`) which, after composition with
the inclusion of `V`, generates a sieve contained in the sieve generated by the covering. -/
theorem exists_standardFpqcCovering_sieve_le {S : Scheme.{u}}
    (U : PreZeroHypercover.{v} S) (hU : U.presieve₀ ∈ Scheme.fpqcPrecoverage S)
    (V : S.affineOpens) :
    ∃ (n : ℕ) (A : Fin n → CommRingCat.{u}) (g : ∀ k, Spec (A k) ⟶ V.1.toScheme),
      (⋃ k, Set.range (g k)) = Set.univ ∧
      (RingHom.pi fun k ↦ (g k).appTop.hom).FaithfullyFlat ∧
      Sieve.ofArrows (fun k ↦ Spec (A k)) (fun k ↦ g k ≫ V.1.ι) ≤
        Sieve.generate U.presieve₀ := by
  obtain ⟨n, A, g, a, t, -, hcov, -, hw, hff⟩ :=
    exists_standardFpqcCovering_over_affineOpen U hU V
  refine ⟨n, A, g, hcov, hff, ?_⟩
  rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
  exact fun k ↦ ⟨U.X (a k), t k, U.f (a k), ⟨a k⟩, hw k⟩

end AlgebraicGeometry

end
