module

public import Mathlib.AlgebraicGeometry.Sites.Etale
public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import StacksFrontier.AlgebraicGeometry.Morphisms.Syntomic.OpenImmersion
public import StacksCore.Tactic.StacksAttribute

/-!
# Base change of a property local on the target

A property of morphisms of schemes which is local on the target for one of the six topologies
fpqc, fppf, syntomic, smooth, étale, Zariski is preserved by base change along a morphism of
the corresponding kind: flat, resp. flat and locally of finite presentation, resp. syntomic,
resp. smooth, resp. étale, resp. an open immersion.

## Main results

* `AlgebraicGeometry.pullbackSnd_of_flat` — the fpqc case.
* `AlgebraicGeometry.pullbackSnd_of_flat_locallyOfFinitePresentation` — the fppf case.
* `AlgebraicGeometry.pullbackSnd_of_syntomic` — the syntomic case.
* `AlgebraicGeometry.pullbackSnd_of_smooth` — the smooth case.
* `AlgebraicGeometry.pullbackSnd_of_etale` — the étale case.
* `AlgebraicGeometry.pullbackSnd_of_isOpenImmersion` — the Zariski case.

## References

* [Stacks Project, Tag 04QU](https://stacks.math.columbia.edu/tag/04QU)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-- A property local on the target for a precoverage `K` refining the one generated by a
morphism class `Q` containing the identities is preserved by base change along a morphism
in `Q`. -/
private theorem pullbackSnd_of_precoverage
    {Q : MorphismProperty Scheme.{u}} {K : Precoverage Scheme.{u}}
    (hK : Scheme.precoverage Q ≤ K)
    (hid : ∀ {Y : Scheme.{u}}, Q (𝟙 Y))
    (P : MorphismProperty Scheme.{u})
    [P.IsLocalAtTarget K]
    {X Y Y' : Scheme.{u}} (f : X ⟶ Y) (g : Y' ⟶ Y)
    (hf : P f) (hg : Q g) : P (pullback.snd f g) := by
  let Z : Bool → Scheme.{u} := fun | false => Y' | true => Y
  let m : ∀ b, Z b ⟶ Y | false => g | true => 𝟙 Y
  have hR : Presieve.ofArrows Z m ∈ Scheme.precoverage Q Y := by
    rw [Scheme.ofArrows_mem_precoverage_iff]
    refine ⟨fun y => ⟨true, y, by simp [m, Z]⟩, fun b => ?_⟩
    cases b <;> first | exact hg | exact hid
  exact (inferInstance : P.IsLocalAtTarget K).pullbackSnd (hK Y hR) ⟨false⟩ hf

/-- A property of morphisms of schemes which is fpqc local on the target is preserved by flat base
change. -/
@[stacks 04QU "fpqc case"]
theorem pullbackSnd_of_flat
    (P : MorphismProperty Scheme.{u}) [P.IsLocalAtTarget Scheme.fpqcPrecoverage]
    {X Y Y' : Scheme.{u}} (f : X ⟶ Y) (g : Y' ⟶ Y)
    (hf : P f) (hg : Flat g) : P (pullback.snd f g) := by
  let Z : Bool → Scheme.{u} := fun | false => Y' | true => Y
  let m : ∀ b, Z b ⟶ Y | false => g | true => 𝟙 Y
  let C : Scheme.Cover (Scheme.precoverage (@Flat : MorphismProperty Scheme.{u})) Y :=
    Scheme.Cover.mkOfCovers Bool Z m (fun y => ⟨true, y, by simp [m, Z]⟩)
      (fun b => by cases b <;> first | exact hg | infer_instance)
  have hqc : QuasiCompactCover C.toPreZeroHypercover := by
    refine ⟨fun {U} hU => ?_⟩
    change IsCompactOpenCovered (fun b x => (m b).base x) (U : Set Y)
    convert IsCompactOpenCovered.image (f := fun b x => (m b).base x)
      (i := true) U hU.isCompact using 1
    ext x
    exact ⟨fun hx ↦ ⟨x, hx, rfl⟩, fun ⟨y, hy, hxy⟩ ↦ (hxy : y = x) ▸ hy⟩
  have hcover : C.presieve₀ ∈ Scheme.fpqcPrecoverage Y := by
    change C.presieve₀ ∈ Scheme.qcPrecoverage Y ∧
      C.presieve₀ ∈ Scheme.precoverage (@Flat : MorphismProperty Scheme.{u}) Y
    exact ⟨by rwa [Scheme.presieve₀_mem_qcPrecoverage_iff], C.mem₀⟩
  exact (inferInstance : P.IsLocalAtTarget Scheme.fpqcPrecoverage).pullbackSnd
    hcover ⟨false⟩ hf

/-- A property of morphisms of schemes which is fppf local on the target is preserved by base
change along a flat morphism which is locally of finite presentation. -/
@[stacks 04QU "fppf case"]
theorem pullbackSnd_of_flat_locallyOfFinitePresentation
    (P : MorphismProperty Scheme.{u}) [P.IsLocalAtTarget Scheme.fppfPrecoverage]
    {X Y Y' : Scheme.{u}} (f : X ⟶ Y) (g : Y' ⟶ Y)
    (hf : P f) (hg : Flat g) (hlfp : LocallyOfFinitePresentation g) :
    P (pullback.snd f g) :=
  pullbackSnd_of_precoverage (P := P) (Q := @Flat ⊓ @LocallyOfFinitePresentation)
    (K := Scheme.fppfPrecoverage) le_rfl (fun {_} => ⟨inferInstance, inferInstance⟩)
    f g hf ⟨hg, hlfp⟩

/-- A property of morphisms of schemes which is syntomic local on the target is preserved by
syntomic base change. -/
@[stacks 04QU "syntomic case"]
theorem pullbackSnd_of_syntomic (P : MorphismProperty Scheme.{u})
    [P.IsLocalAtTarget (Scheme.precoverage (@Syntomic.{u}))]
    {X Y Y' : Scheme.{u}} (f : X ⟶ Y) (g : Y' ⟶ Y)
    (hf : P f) (hg : Syntomic g) : P (pullback.snd f g) :=
  pullbackSnd_of_precoverage (P := P) (Q := @Syntomic.{u})
    (K := Scheme.precoverage (@Syntomic.{u}))
    le_rfl (fun {Y} => syntomic_of_isOpenImmersion (𝟙 Y)) f g hf hg

/-- A property of morphisms of schemes which is smooth local on the target is preserved by smooth
base change. -/
@[stacks 04QU "smooth case"]
theorem pullbackSnd_of_smooth (P : MorphismProperty Scheme.{u})
    [P.IsLocalAtTarget (Scheme.precoverage (@Smooth))]
    {X Y Y' : Scheme.{u}} (f : X ⟶ Y) (g : Y' ⟶ Y)
    (hf : P f) (hg : Smooth g) : P (pullback.snd f g) :=
  pullbackSnd_of_precoverage (P := P) (Q := @Smooth) (K := Scheme.precoverage (@Smooth))
    le_rfl (fun {_} => inferInstance) f g hf hg

/-- A property of morphisms of schemes which is étale local on the target is preserved by étale
base change. -/
@[stacks 04QU "étale case"]
theorem pullbackSnd_of_etale (P : MorphismProperty Scheme.{u})
    [P.IsLocalAtTarget Scheme.etalePrecoverage]
    {X Y Y' : Scheme.{u}} (f : X ⟶ Y) (g : Y' ⟶ Y)
    (hf : P f) (hg : Etale g) : P (pullback.snd f g) :=
  pullbackSnd_of_precoverage (P := P) (Q := @Etale) (K := Scheme.etalePrecoverage)
    le_rfl (fun {_} => inferInstance) f g hf hg

/-- A property of morphisms of schemes which is Zariski local on the target is preserved by base
change along an open immersion. -/
@[stacks 04QU "Zariski case"]
theorem pullbackSnd_of_isOpenImmersion (P : MorphismProperty Scheme.{u})
    [P.IsLocalAtTarget Scheme.zariskiPrecoverage]
    {X Y Y' : Scheme.{u}} (f : X ⟶ Y) (g : Y' ⟶ Y)
    (hf : P f) (hg : IsOpenImmersion g) : P (pullback.snd f g) :=
  pullbackSnd_of_precoverage (P := P) (Q := @IsOpenImmersion)
    (K := Scheme.zariskiPrecoverage) le_rfl (fun {_} => inferInstance) f g hf hg

end AlgebraicGeometry
