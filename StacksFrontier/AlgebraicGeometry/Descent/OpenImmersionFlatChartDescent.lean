module

public import StacksFrontier.AlgebraicGeometry.Descent.FlatChartDescent
public import StacksFrontier.AlgebraicGeometry.Descent.OpenImmersionEtaleDescent

/-!
# Effective descent of open immersions along a surjective flat chart

`AlgebraicGeometry.Space.isEffectiveDescentAlongSurjectiveEtale_isOpenImmersion` discharges the
geometric input of Stacks 03I2 for open immersions along the surjective *étale* morphisms of the
big fppf site of `S`. This file does the same for a covering morphism which is surjective, flat
and locally of finite presentation, with no étaleness.

That is the shape a descent problem along a covering *sieve* produces — step 1 of Descent, Lemma
02W3 refines a covering sieve over an affine base to a single surjective flat morphism of finite
presentation of affines, never to an étale one — and the shape in which the fourth step of Stacks
02W8 consumes Stacks 0247.

## Main results

* `AlgebraicGeometry.Space.isLocallyInjective_pullback_snd_of_flat` and
  `AlgebraicGeometry.Space.presheaf_pullback_snd_isOpenImmersion_of_flatChart`: the two statements
  of `StacksFrontier.AlgebraicGeometry.Descent.OpenImmersionEtaleDescent` with
  `AlgebraicGeometry.Etale` on the covering morphism replaced by the pair
  `AlgebraicGeometry.Flat`, `AlgebraicGeometry.LocallyOfFinitePresentation`.

## Implementation notes

The proofs are those of the étale statements, with étaleness consumed in exactly three places and
each replaced by its flat counterpart: a one-element covering of the site is generated by a
surjective flat morphism locally of finite presentation
(`AlgebraicGeometry.Space.sieve_generate_singleton_mem_topology_over_of_flat` in place of
`AlgebraicGeometry.Space.sieve_generate_singleton_mem_topology_over`); the covering morphism is an
open map because it is universally open, `AlgebraicGeometry.UniversallyOpen.of_flat`, which is
Stacks 01UA and asks only for flatness and local finite presentation; and local injectivity of
the descended morphism is read on the covering generated by the base change of the chart, again
through the flat form of the sieve lemma.

Everything else in those proofs is independent of the covering morphism's properties: the
stability of the open piece under the datum
(`AlgebraicGeometry.Space.preimage_range_eq_preimage_range`), the fact that a section of the
descended fibre product lies over the image of the open piece
(`AlgebraicGeometry.Space.range_subset_image_range`, which asks only surjectivity), and the
identification of the descended fibre product with the open subscheme it produces.

## References

* [Stacks Project, Tag 03I2](https://stacks.math.columbia.edu/tag/03I2)
* [Stacks Project, Tag 02W8](https://stacks.math.columbia.edu/tag/02W8)
* [Stacks Project, Tag 02W3](https://stacks.math.columbia.edu/tag/02W3)
* [Stacks Project, Tag 01UA](https://stacks.math.columbia.edu/tag/01UA)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe v u

namespace AlgebraicGeometry.Space

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
variable {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {f : X ⟶ Y}
    {a c : BigFppfOver B S hS} {h : yoneda.obj a ⟶ Y} {q : c ⟶ a}
    {A : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {m : A ⟶ X} {r : A ⟶ yoneda.obj c}

/-- The sieve generated by the base change of a flat chart `q` along any `s : d ⟶ a` covers `d`. -/
private theorem generate_singleton_pullback_fst_mem_topology
    (hqs : Surjective ((BigFppfOver.toScheme B S hS).map q))
    (hqf : Flat ((BigFppfOver.toScheme B S hS).map q))
    (hqp : LocallyOfFinitePresentation ((BigFppfOver.toScheme B S hS).map q))
    {d : BigFppfOver B S hS} (s : d ⟶ a) :
    Sieve.generate (Presieve.singleton (pullback.fst s q)) ∈ BigFppfOver.topology B S hS d := by
  have sq := (IsPullback.of_hasPullback s q).map (BigFppfOver.toScheme B S hS)
  exact sieve_generate_singleton_mem_topology_over_of_flat B S hS (pullback.fst s q)
    (MorphismProperty.of_isPullback sq.flip hqs) (MorphismProperty.of_isPullback sq.flip hqf)
    (MorphismProperty.of_isPullback sq.flip hqp)

/-- **The descended morphism is locally injective, for a flat chart.** If the descent datum `r`
is a monomorphism, then the projection `X ×[Y] yoneda.obj a ⟶ yoneda.obj a` is locally injective
for the fppf topology: two sections with the same image agree after the base change of the chart,
because they then define the same section of `A`.

This is `AlgebraicGeometry.Space.isLocallyInjective_pullback_snd` with étaleness of the chart
replaced by flatness together with local finite presentation; the covering on which the two
sections are compared is generated by the base change of the chart, which is a one-element
covering of the site by
`AlgebraicGeometry.Space.sieve_generate_singleton_mem_topology_over_of_flat`. -/
theorem isLocallyInjective_pullback_snd_of_flat (sq : IsPullback m r f (yoneda.map q ≫ h))
    (hrmono : Mono r) (hqs : Surjective ((BigFppfOver.toScheme B S hS).map q))
    (hqf : Flat ((BigFppfOver.toScheme B S hS).map q))
    (hqp : LocallyOfFinitePresentation ((BigFppfOver.toScheme B S hS).map q)) :
    Presheaf.IsLocallyInjective (BigFppfOver.topology B S hS) (pullback.snd f h) := by
  constructor
  intro T x y hxy
  obtain ⟨s, hs⟩ : ∃ s : T.unop ⟶ a, (pullback.snd f h).app T x = s := ⟨_, rfl⟩
  have hx : yonedaEquiv.symm x ≫ pullback.snd f h = yoneda.map s := by
    rw [yonedaEquiv_symm_comp_pullback_snd, hs]
  have hy : yonedaEquiv.symm y ≫ pullback.snd f h = yoneda.map s := by
    rw [yonedaEquiv_symm_comp_pullback_snd, ← hxy, hs]
  obtain ⟨α, hα1, hα2⟩ := exists_lift_of_descentDatum sq (yonedaEquiv.symm x) hx
    (pullback.fst s q) (pullback.snd s q) pullback.condition
  obtain ⟨α', hα1', hα2'⟩ := exists_lift_of_descentDatum sq (yonedaEquiv.symm y) hy
    (pullback.fst s q) (pullback.snd s q) pullback.condition
  have hαα : α = α' := (cancel_mono r).1 (hα2.trans hα2'.symm)
  have key : yoneda.map (pullback.fst s q) ≫ yonedaEquiv.symm x =
      yoneda.map (pullback.fst s q) ≫ yonedaEquiv.symm y := by
    apply pullback.hom_ext
    · rw [Category.assoc, Category.assoc, ← hα1, ← hα1', hαα]
    · rw [Category.assoc, Category.assoc, hx, hy]
  have h1 : (pullback f h).map (pullback.fst s q).op x =
      (pullback f h).map (pullback.fst s q).op y :=
    calc (pullback f h).map (pullback.fst s q).op x
        = yonedaEquiv (yoneda.map (pullback.fst s q) ≫ yonedaEquiv.symm x) :=
          map_op_eq_yonedaEquiv (F := pullback f h) x _
      _ = yonedaEquiv (yoneda.map (pullback.fst s q) ≫ yonedaEquiv.symm y) := by rw [key]
      _ = (pullback f h).map (pullback.fst s q).op y :=
          (map_op_eq_yonedaEquiv (F := pullback f h) y _).symm
  refine (BigFppfOver.topology B S hS).superset_covering ?_
    (generate_singleton_pullback_fst_mem_topology hqs hqf hqp s)
  rintro Z k ⟨Z', u, bb, hbb, hfac⟩
  cases hbb
  change (pullback f h).map k.op x = (pullback f h).map k.op y
  rw [← hfac, op_comp, Functor.map_comp_apply, Functor.map_comp_apply, h1]

/-- **The geometric input of Stacks 03I2 for open immersions along a flat chart, outright.**
Whenever a morphism `f : X ⟶ Y` of sheaves on the big fppf site of `S` becomes representable by
an open immersion after base change along a morphism `q : c ⟶ a` of the site which is surjective,
flat and locally of finite presentation, its base change along `h : yoneda.obj a ⟶ Y` is already
representable by an open immersion.

This is `AlgebraicGeometry.Space.isEffectiveDescentAlongSurjectiveEtale_isOpenImmersion`, as the
body of the predicate rather than the predicate itself, with étaleness of the covering morphism
replaced by flatness together with local finite presentation. The descended object is again the
open subscheme of `a` on the image `V` of the open piece cut out on `c`: that image is open
because a surjective flat morphism locally of finite presentation is universally open, Stacks
01UA, it satisfies `q⁻¹(V) = A'` by
`AlgebraicGeometry.Space.preimage_range_eq_preimage_range`, and it is an object of the site by
`AlgebraicGeometry.exists_restrict_bigFppfOver`. -/
theorem presheaf_pullback_snd_isOpenImmersion_of_flatChart
    (hX : Presheaf.IsSheaf (BigFppfOver.topology B S hS) X)
    (hY : Presheaf.IsSheaf (BigFppfOver.topology B S hS) Y)
    (sq : IsPullback m r f (yoneda.map q ≫ h))
    (hqs : Surjective ((BigFppfOver.toScheme B S hS).map q))
    (hqf : Flat ((BigFppfOver.toScheme B S hS).map q))
    (hqp : LocallyOfFinitePresentation ((BigFppfOver.toScheme B S hS).map q))
    (hr : (MorphismProperty.inverseImage (@_root_.AlgebraicGeometry.IsOpenImmersion.{u})
      (BigFppfOver.toScheme B S hS)).presheaf r) :
    (MorphismProperty.inverseImage (@_root_.AlgebraicGeometry.IsOpenImmersion.{u})
      (BigFppfOver.toScheme B S hS)).presheaf (pullback.snd f h) := by
  have hRIoi : (MorphismProperty.inverseImage
      (@_root_.AlgebraicGeometry.IsOpenImmersion.{u})
      (BigFppfOver.toScheme B S hS)).RespectsIso :=
    MorphismProperty.RespectsIso.inverseImage _ _
  have hRIpre : (MorphismProperty.presheaf (MorphismProperty.inverseImage
      (@_root_.AlgebraicGeometry.IsOpenImmersion.{u})
      (BigFppfOver.toScheme B S hS))).RespectsIso :=
    (MorphismProperty.relative_isStableUnderBaseChange (F := yoneda) _).respectsIso
  have hmono : (@_root_.AlgebraicGeometry.IsOpenImmersion.{u}) ≤
      MorphismProperty.monomorphisms Scheme.{u} := fun _ _ g hg => by
    have := hg; exact (inferInstance : Mono g)
  have hrmono : Mono r := mono_of_presheaf hmono hr
  have hr'oi : _root_.AlgebraicGeometry.IsOpenImmersion
      ((BigFppfOver.toScheme B S hS).map (hr.rep.snd (𝟙 (yoneda.obj c)))) :=
    hr.property_snd (𝟙 (yoneda.obj c))
  obtain ⟨Vc, hVcdef⟩ : ∃ Vc : Set ((BigFppfOver.toScheme B S hS).obj c),
      Set.range ((BigFppfOver.toScheme B S hS).map
        (hr.rep.snd (𝟙 (yoneda.obj c)))).base = Vc := ⟨_, rfl⟩
  have hVopen : IsOpen (((BigFppfOver.toScheme B S hS).map q).base '' Vc) := by
    have := hqf
    have := hqp
    have : _root_.AlgebraicGeometry.UniversallyOpen ((BigFppfOver.toScheme B S hS).map q) :=
      UniversallyOpen.of_flat _
    exact ((BigFppfOver.toScheme B S hS).map q).isOpenMap _
      (hVcdef ▸ IsOpenImmersion.isOpen_range _)
  -- stability of the open piece: `q⁻¹(q(Vc)) = Vc`
  have hstab : ((BigFppfOver.toScheme B S hS).map q).base ⁻¹'
      (((BigFppfOver.toScheme B S hS).map q).base '' Vc) ⊆ Vc := by
    have sqD : IsPullback ((BigFppfOver.toScheme B S hS).map (pullback.fst q q))
        ((BigFppfOver.toScheme B S hS).map (pullback.snd q q))
        ((BigFppfOver.toScheme B S hS).map q) ((BigFppfOver.toScheme B S hS).map q) :=
      (IsPullback.of_hasPullback q q).map (BigFppfOver.toScheme B S hS)
    have hkey := preimage_range_eq_preimage_range sq hr.rep
    rw [hVcdef] at hkey
    have h1 := Scheme.image_preimage_eq_of_isPullback sqD Vc
    rw [hkey] at h1
    rw [← h1]
    exact Set.image_preimage_subset _ _
  -- the descended open subscheme of `a`
  obtain ⟨b, i, hioi, hirange, hiuniv⟩ := exists_restrict_bigFppfOver a
    ⟨((BigFppfOver.toScheme B S hS).map q).base '' Vc, hVopen⟩
  have hirange' : Set.range ((BigFppfOver.toScheme B S hS).map i).base =
      ((BigFppfOver.toScheme B S hS).map q).base '' Vc := hirange
  have hmonoi : Mono i := (BigFppfOver.toScheme B S hS).mono_of_mono_map
    (by have := hioi; exact (inferInstance : Mono ((BigFppfOver.toScheme B S hS).map i)))
  have hmonoyi : Mono (yoneda.map i) := inferInstance
  have hlr : Subfunctor.range (pullback.snd f h) ≤ Subfunctor.range (yoneda.map i) := by
    rintro T s ⟨x, rfl⟩
    have hsub := range_subset_image_range sq hr.rep hqs (yonedaEquiv.symm x)
      (yonedaEquiv_symm_comp_pullback_snd x)
    rw [hVcdef] at hsub
    obtain ⟨g, hg⟩ := hiuniv ((pullback.snd f h).app T x) hsub
    exact ⟨g, hg⟩
  obtain ⟨l, hlfac⟩ : ∃ l : pullback f h ⟶ yoneda.obj b,
      l ≫ yoneda.map i = pullback.snd f h := by
    have h1 : inv (Subfunctor.toRange (yoneda.map i)) ≫ yoneda.map i =
        (Subfunctor.range (yoneda.map i)).ι :=
      (IsIso.inv_comp_eq _).2 (Subfunctor.toRange_ι (yoneda.map i)).symm
    refine ⟨Subfunctor.lift (pullback.snd f h) hlr ≫
      inv (Subfunctor.toRange (yoneda.map i)), ?_⟩
    rw [Category.assoc, h1, Subfunctor.lift_ι]
  have hli : Presheaf.IsLocallyInjective (BigFppfOver.topology B S hS) l :=
    have := isLocallyInjective_pullback_snd_of_flat sq hrmono hqs hqf hqp
    Presheaf.isLocallyInjective_of_isLocallyInjective_fac _ hlfac
  have hls : Presheaf.IsLocallySurjective (BigFppfOver.topology B S hS) l := by
    constructor
    intro T w
    refine (BigFppfOver.topology B S hS).superset_covering ?_
      (generate_singleton_pullback_fst_mem_topology hqs hqf hqp (w ≫ i))
    rintro Z k ⟨Z', u, bb, hbb, hfac⟩
    cases hbb
    have heq : (u ≫ pullback.snd (w ≫ i) q) ≫ q = (k ≫ w) ≫ i := by
      rw [Category.assoc, ← pullback.condition, ← Category.assoc, hfac, Category.assoc]
    have hrangesub : Set.range ((BigFppfOver.toScheme B S hS).map
        (u ≫ pullback.snd (w ≫ i) q)).base ⊆ Vc := by
      rintro z ⟨z0, rfl⟩
      refine hstab ?_
      rw [Set.mem_preimage, ← Scheme.Hom.comp_apply, ← Functor.map_comp, heq,
        Functor.map_comp, Scheme.Hom.comp_apply, ← hirange']
      exact ⟨_, rfl⟩
    obtain ⟨vv, hvv⟩ := exists_comp_eq_of_isOpenImmersion (hr.rep.snd (𝟙 (yoneda.obj c)))
      hr'oi (u ≫ pullback.snd (w ≫ i) q) (by rw [hVcdef]; exact hrangesub)
    have hw0 : hr.rep.fst (𝟙 (yoneda.obj c)) ≫ r =
        yoneda.map (hr.rep.snd (𝟙 (yoneda.obj c))) := by
      have hw := hr.rep.w (𝟙 (yoneda.obj c))
      rwa [Category.comp_id] at hw
    have hsqw : m ≫ f = (r ≫ yoneda.map q) ≫ h := by rw [sq.w, Category.assoc]
    have hxisnd : (yoneda.map vv ≫ hr.rep.fst (𝟙 (yoneda.obj c)) ≫
          pullback.lift m (r ≫ yoneda.map q) hsqw) ≫ pullback.snd f h =
        yoneda.map ((k ≫ w) ≫ i) := by
      calc (yoneda.map vv ≫ hr.rep.fst (𝟙 (yoneda.obj c)) ≫
            pullback.lift m (r ≫ yoneda.map q) hsqw) ≫ pullback.snd f h
          = yoneda.map vv ≫ (hr.rep.fst (𝟙 (yoneda.obj c)) ≫ r) ≫ yoneda.map q := by
            simp only [Category.assoc, pullback.lift_snd]
        _ = yoneda.map ((vv ≫ hr.rep.snd (𝟙 (yoneda.obj c))) ≫ q) := by
            rw [hw0, Functor.map_comp, Functor.map_comp, Category.assoc]
        _ = yoneda.map ((k ≫ w) ≫ i) := by rw [hvv, heq]
    have hxil : (yoneda.map vv ≫ hr.rep.fst (𝟙 (yoneda.obj c)) ≫
        pullback.lift m (r ≫ yoneda.map q) hsqw) ≫ l = yoneda.map (k ≫ w) := by
      rw [← cancel_mono (yoneda.map i), Category.assoc, hlfac, hxisnd, ← Functor.map_comp]
    refine ⟨yonedaEquiv (yoneda.map vv ≫ hr.rep.fst (𝟙 (yoneda.obj c)) ≫
      pullback.lift m (r ≫ yoneda.map q) hsqw), ?_⟩
    rw [← yonedaEquiv_comp, hxil, yonedaEquiv_yoneda_map]
    rfl
  have hFsheaf : Presheaf.IsSheaf (BigFppfOver.topology B S hS) (pullback f h) :=
    BigFppfOver.isSheaf_pullback_yoneda_obj f h hX hY
  have hbsheaf : Presheaf.IsSheaf (BigFppfOver.topology B S hS) (yoneda.obj b) :=
    BigFppfOver.isSheaf_yoneda_obj B S hS b
  have hliso : IsIso l := by
    have hsh : IsIso ((⟨l⟩ :
        (⟨pullback f h, hFsheaf⟩ : Sheaf (BigFppfOver.topology B S hS) (Type u)) ⟶
          ⟨yoneda.obj b, hbsheaf⟩)) :=
      (Sheaf.isLocallyBijective_iff_isIso _).1 ⟨hli, hls⟩
    exact inferInstanceAs (IsIso ((sheafToPresheaf (BigFppfOver.topology B S hS) (Type u)).map
      ((⟨l⟩ : (⟨pullback f h, hFsheaf⟩ : Sheaf (BigFppfOver.topology B S hS) (Type u)) ⟶
          ⟨yoneda.obj b, hbsheaf⟩))))
  have hpi : (MorphismProperty.inverseImage
      (@_root_.AlgebraicGeometry.IsOpenImmersion.{u})
      (BigFppfOver.toScheme B S hS)).presheaf (yoneda.map i) :=
    presheaf_yoneda_map_of_inverseImage B S hS inferInstance i hioi
  rw [← hlfac]
  exact MorphismProperty.RespectsIso.precomp _ l _ hpi

end AlgebraicGeometry.Space

end
