module

public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.Algebra.TrivSqZeroExt.Ideal
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Localization.LocalizationLocalization
public import Mathlib.RingTheory.Localization.Submodule
public import Mathlib.RingTheory.Noetherian.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import StacksCore.Tactic.StacksAttribute

/-!
# A ring with countably many variables whose distinct products vanish

Let `k` be a field and let `R = k[x_n ; n ∈ ℤ]/(x_n x_m ; n ≠ m)`. Inverting one variable kills
all the others, so `R[1/x_n]` is generated over `k` by `x_n` and `1/x_n` and is therefore
Noetherian; every prime other than the ideal `(x_n ; n ∈ ℤ)` misses some variable, so every
local ring of `R` away from that one point is Noetherian. At that point the local ring is *not*
Noetherian: `R` maps onto the trivial square-zero extension of `k` by a free module of
countable rank, every element outside `(x_n ; n ∈ ℤ)` going to a unit, and the square-zero ideal
of that extension is not finitely generated.

This is the ring of the counterexample of Stacks Tag 04QY, taken over a general field.

## Main definitions

* `ManyVariable.relations` is the ideal `(x_n x_m ; n ≠ m)` of `k[x_n ; n ∈ ℤ]`.
* `ManyVariable.ring` is the quotient `R`.
* `ManyVariable.xx n` is the image of the variable `x_n` in `R`.
* `ManyVariable.constTerm` is the constant-term homomorphism `R → k`.
* `ManyVariable.originIdeal` is its kernel, the point all of whose coordinates vanish.

## Main results

* `ManyVariable.originIdeal_isMaximal`: the origin is a closed point.
* `ManyVariable.isNoetherianRing_away`: `R[1/x_n]` is Noetherian.
* `ManyVariable.isNoetherianRing_atPrime`: `R_p` is Noetherian for every prime `p` other than
  the origin.
* `ManyVariable.not_isNoetherianRing_atPrime_origin`: `R` localized at the origin is not
  Noetherian.
* `ManyVariable.coordIdeal_le_originIdeal` and `ManyVariable.xx_notMem_coordIdeal`: the origin is
  a specialization of a point other than itself, namely of the prime `(x_m ; m ≠ n)`.

## Implementation notes

No normal form for `R` is needed anywhere. The two statements that would seem to require one are
obtained by universal properties instead: that `R[1/x_n]` is generated by `x_n` and `1/x_n` is
proved by induction on a polynomial representative, every monomial involving a second variable
being sent to `0`; and the failure of Noetherianness at the origin is read off the square-zero
extension `TrivSqZeroExt k (ℤ →₀ k)`, which receives `R` by `MvPolynomial.aeval` because a
product of two elements of the square-zero ideal vanishes.

## References

* [Stacks Project, Tag 04QY](https://stacks.math.columbia.edu/tag/04QY)
-/

@[expose] public noncomputable section

open MvPolynomial

namespace ManyVariable

variable (k : Type*) [Field k]

/-- The ideal of `k[x_n ; n ∈ ℤ]` generated by the products `x_n x_m` of distinct variables. -/
def relations : Ideal (MvPolynomial ℤ k) :=
  Ideal.span {f | ∃ n m : ℤ, n ≠ m ∧ f = X n * X m}

/-- The ring `k[x_n ; n ∈ ℤ]/(x_n x_m ; n ≠ m)`. -/
abbrev ring := MvPolynomial ℤ k ⧸ relations k

/-- The image of the variable `x_n`. -/
def xx (n : ℤ) : ring k := Ideal.Quotient.mk _ (X n)

/-- The class of a constant polynomial `C c` is the image of `c` in `R`. -/
lemma mk_C (c : k) : Ideal.Quotient.mk (relations k) (C c) = algebraMap k (ring k) c := rfl

/-- The product of two distinct variables vanishes in `R`. -/
lemma xx_mul_xx {n m : ℤ} (h : n ≠ m) : xx k n * xx k m = 0 := by
  rw [xx, xx, ← map_mul]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨n, m, h, rfl⟩)

/-- A `k`-algebra map out of `k[x_n ; n ∈ ℤ]` killing the products of distinct variables kills
`relations k`. -/
lemma relations_apply_eq_zero {B : Type*} [CommRing B] [Algebra k B]
    (g : MvPolynomial ℤ k →ₐ[k] B) (hg : ∀ n m : ℤ, n ≠ m → g (X n) * g (X m) = 0) :
    ∀ a ∈ relations k, g a = 0 := by
  have hker : relations k ≤ RingHom.ker (g : MvPolynomial ℤ k →+* B) := by
    rw [relations, Ideal.span_le]
    rintro f ⟨n, m, hnm, rfl⟩
    simpa [RingHom.mem_ker] using hg n m hnm
  exact fun a ha ↦ hker ha

/-! ### The constant term and the origin -/

/-- The constant-term homomorphism `R → k`, evaluation at `x_n = 0`. -/
def constTerm : ring k →ₐ[k] k :=
  Ideal.Quotient.liftₐ _ (MvPolynomial.aeval fun _ ↦ (0 : k)) <|
    relations_apply_eq_zero k _ (by simp)

/-- The constant term of the class of `f` is the evaluation of `f` at `x_n = 0`. -/
@[simp] lemma constTerm_mk (f : MvPolynomial ℤ k) :
    constTerm k (Ideal.Quotient.mk _ f) = MvPolynomial.aeval (fun _ ↦ (0 : k)) f := rfl

/-- Each variable has constant term `0`. -/
@[simp] lemma constTerm_xx (n : ℤ) : constTerm k (xx k n) = 0 := by simp [xx]

/-- The point of `Spec R` all of whose coordinates `x_n` vanish. -/
def originIdeal : Ideal (ring k) := RingHom.ker (constTerm k)

/-- The constant-term homomorphism is surjective. -/
lemma constTerm_surjective : Function.Surjective (constTerm k) :=
  fun c ↦ ⟨algebraMap k (ring k) c, (constTerm k).commutes c⟩

/-- The origin is a maximal ideal of `R`. -/
instance originIdeal_isMaximal : (originIdeal k).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective (constTerm k).toRingHom (constTerm_surjective k)

/-- An element lies in the origin if and only if its constant term vanishes. -/
lemma mem_originIdeal_iff {r : ring k} : r ∈ originIdeal k ↔ constTerm k r = 0 :=
  RingHom.mem_ker

/-- Each variable lies in the origin. -/
lemma xx_mem_originIdeal (n : ℤ) : xx k n ∈ originIdeal k := by
  rw [mem_originIdeal_iff, constTerm_xx]

/-- The class of `f` minus its constant term lies in the ideal generated by the variables. -/
lemma mk_sub_const_mem_span (f : MvPolynomial ℤ k) :
    Ideal.Quotient.mk (relations k) f
        - algebraMap k (ring k) (MvPolynomial.aeval (fun _ ↦ (0 : k)) f)
      ∈ Ideal.span (Set.range (xx k)) := by
  induction f using MvPolynomial.induction_on with
  | C c => simp [mk_C]
  | add f g hf hg =>
      have : Ideal.Quotient.mk (relations k) (f + g)
            - algebraMap k (ring k) (MvPolynomial.aeval (fun _ ↦ (0 : k)) (f + g))
          = (Ideal.Quotient.mk (relations k) f
              - algebraMap k (ring k) (MvPolynomial.aeval (fun _ ↦ (0 : k)) f))
            + (Ideal.Quotient.mk (relations k) g
              - algebraMap k (ring k) (MvPolynomial.aeval (fun _ ↦ (0 : k)) g)) := by
        rw [map_add, map_add, map_add]; ring
      rw [this]
      exact Ideal.add_mem _ hf hg
  | mul_X f m _ =>
      have : Ideal.Quotient.mk (relations k) (f * X m)
            - algebraMap k (ring k) (MvPolynomial.aeval (fun _ ↦ (0 : k)) (f * X m))
          = Ideal.Quotient.mk (relations k) f * xx k m := by
        rw [map_mul, map_mul]
        simp [xx]
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨m, rfl⟩)

/-- The origin is the ideal generated by the variables. -/
lemma originIdeal_eq_span : originIdeal k = Ideal.span (Set.range (xx k)) := by
  refine le_antisymm (fun r hr ↦ ?_) ?_
  · obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
    have h0 : MvPolynomial.aeval (fun _ ↦ (0 : k)) f = 0 := by
      rw [mem_originIdeal_iff, constTerm_mk] at hr; exact hr
    have h := mk_sub_const_mem_span k f
    rwa [h0, map_zero, sub_zero] at h
  · rw [Ideal.span_le]
    rintro _ ⟨n, rfl⟩
    exact xx_mem_originIdeal k n

/-- Any prime other than the origin misses one of the variables. -/
lemma exists_xx_notMem {p : Ideal (ring k)} [hp : p.IsPrime] (h : p ≠ originIdeal k) :
    ∃ n : ℤ, xx k n ∉ p := by
  by_contra hcon
  push Not at hcon
  refine h (((originIdeal_isMaximal k).eq_of_le hp.ne_top ?_).symm)
  rw [originIdeal_eq_span, Ideal.span_le]
  rintro _ ⟨n, rfl⟩
  exact hcon n

/-! ### Localizing away from one variable -/

variable (n : ℤ)

/-- Inverting `x n` kills every other variable. -/
lemma algebraMap_xx_eq_zero {m : ℤ} (h : m ≠ n) :
    algebraMap (ring k) (Localization.Away (xx k n)) (xx k m) = 0 := by
  have hu : IsUnit (algebraMap (ring k) (Localization.Away (xx k n)) (xx k n)) :=
    IsLocalization.map_units _ (⟨xx k n, Submonoid.mem_powers _⟩ : Submonoid.powers (xx k n))
  refine (IsUnit.mul_right_eq_zero hu).mp ?_
  rw [← map_mul, xx_mul_xx k (Ne.symm h), map_zero]

/-- Every element of `R` becomes a polynomial in `x n` after inverting `x n`. -/
lemma exists_poly (r : ring k) :
    ∃ p : Polynomial k, algebraMap (ring k) (Localization.Away (xx k n)) r
      = algebraMap (ring k) (Localization.Away (xx k n)) (Polynomial.aeval (xx k n) p) := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
  induction f using MvPolynomial.induction_on with
  | C c => exact ⟨Polynomial.C c, by simp [mk_C]⟩
  | add f g hf hg =>
      obtain ⟨p, hp⟩ := hf
      obtain ⟨q, hq⟩ := hg
      exact ⟨p + q, by rw [map_add, map_add, hp, hq, map_add, map_add]⟩
  | mul_X f m hf =>
      obtain ⟨p, hp⟩ := hf
      rcases eq_or_ne m n with rfl | hm
      · refine ⟨p * Polynomial.X, ?_⟩
        rw [map_mul, map_mul, map_mul, hp, map_mul]
        simp [xx]
      · refine ⟨0, ?_⟩
        rw [map_mul, map_mul]
        have h0 : algebraMap (ring k) (Localization.Away (xx k n))
            (Ideal.Quotient.mk (relations k) (X m)) = 0 := algebraMap_xx_eq_zero k n hm
        rw [h0, mul_zero]
        simp

/-- **`R[1/x_n]` is Noetherian.** -/
theorem isNoetherianRing_away : IsNoetherianRing (Localization.Away (xx k n)) := by
  classical
  set S := Localization.Away (xx k n) with hS
  set u : S := algebraMap (ring k) S (xx k n) with hu
  set v : S := IsLocalization.Away.invSelf (xx k n) with hv
  have huv : u * v = 1 := IsLocalization.Away.mul_invSelf _
  have hFT : Algebra.FiniteType k S := by
    refine ⟨⟨{u, v}, ?_⟩⟩
    rw [eq_top_iff]
    intro z _
    have hum : u ∈ Algebra.adjoin k ((({u, v} : Finset S) : Set S)) :=
      Algebra.subset_adjoin (by simp)
    have hvm : v ∈ Algebra.adjoin k ((({u, v} : Finset S) : Set S)) :=
      Algebra.subset_adjoin (by simp)
    have hra : ∀ r : ring k, algebraMap (ring k) S r ∈
        Algebra.adjoin k ((({u, v} : Finset S) : Set S)) := by
      intro r
      obtain ⟨p, hp⟩ := exists_poly k n r
      rw [hp]
      have heq : algebraMap (ring k) S (Polynomial.aeval (xx k n) p) = Polynomial.aeval u p := by
        have h := DFunLike.congr_fun
          (Polynomial.algHom_ext
            (f := (IsScalarTower.toAlgHom k (ring k) S).comp (Polynomial.aeval (xx k n)))
            (g := Polynomial.aeval u) (by simp [hu])) p
        simpa using h
      rw [heq]
      exact Algebra.adjoin_mono (by simp [Set.singleton_subset_iff])
        (Polynomial.aeval_mem_adjoin_singleton k u)
    obtain ⟨⟨r, s⟩, hz⟩ := IsLocalization.surj (M := Submonoid.powers (xx k n)) z
    obtain ⟨j, hj⟩ := s.2
    have hsj : algebraMap (ring k) S (s : ring k) = u ^ j := by rw [← hj, map_pow]
    rw [show z = algebraMap (ring k) S r * v ^ j by
      rw [← hz, hsj, mul_assoc, ← mul_pow, huv, one_pow, mul_one]]
    exact mul_mem (hra r) (pow_mem hvm j)
  exact Algebra.FiniteType.isNoetherianRing k S

/-- **Every local ring of `R` away from the origin is Noetherian.** -/
theorem isNoetherianRing_atPrime {p : Ideal (ring k)} [p.IsPrime] (h : p ≠ originIdeal k) :
    IsNoetherianRing (Localization.AtPrime p) := by
  obtain ⟨n, hn⟩ := exists_xx_notMem k h
  have hle : Submonoid.powers (xx k n) ≤ p.primeCompl := by
    rintro y ⟨j, rfl⟩
    exact fun hmem ↦ hn (‹p.IsPrime›.mem_of_pow_mem j hmem)
  let : Algebra (Localization.Away (xx k n)) (Localization.AtPrime p) :=
    IsLocalization.localizationAlgebraOfSubmonoidLe _ _ _ _ hle
  have : IsScalarTower (ring k) (Localization.Away (xx k n)) (Localization.AtPrime p) :=
    IsLocalization.localization_isScalarTower_of_submonoid_le _ _ _ _ hle
  have := IsLocalization.isLocalization_of_submonoid_le
    (Localization.Away (xx k n)) (Localization.AtPrime p) _ _ hle
  exact IsLocalization.isNoetherianRing
    (p.primeCompl.map (algebraMap (ring k) (Localization.Away (xx k n))))
    (Localization.AtPrime p) (isNoetherianRing_away k n)

/-! ### A prime specializing to the origin -/

/-- An algebra map `φ : A → k` killing the images of all variables sends the image of `f` to the
evaluation of `f` at `x_n = 0`. -/
private theorem apply_eq_aeval_zero_of_apply_X_eq_zero {A : Type*} [CommRing A] [Algebra k A]
    (g : MvPolynomial ℤ k →ₐ[k] A) (φ : A →ₐ[k] k) (h : ∀ m, φ (g (X m)) = 0)
    (f : MvPolynomial ℤ k) : φ (g f) = MvPolynomial.aeval (fun _ ↦ (0 : k)) f := by
  have hcomp : φ.comp g = MvPolynomial.aeval fun _ ↦ (0 : k) :=
    MvPolynomial.algHom_ext fun m ↦ by simpa using h m
  exact DFunLike.congr_fun hcomp f

/-- The `k`-algebra map `k[x_m ; m ∈ ℤ] → k[t]` sending `x_n` to `t` and `x_m` to `0` for
`m ≠ n`. -/
def toPolyAux : MvPolynomial ℤ k →ₐ[k] Polynomial k :=
  MvPolynomial.aeval fun m ↦ if m = n then Polynomial.X else 0

/-- The induced map `R → k[t]`, whose kernel is the prime `(x_m ; m ≠ n)`. -/
def toPoly : ring k →ₐ[k] Polynomial k :=
  Ideal.Quotient.liftₐ _ (toPolyAux k n) <|
    relations_apply_eq_zero k _ <| by
      intro b c hbc
      rcases eq_or_ne b n with rfl | hb
      · have hcb : c ≠ b := Ne.symm hbc
        simp [toPolyAux, hcb]
      · simp [toPolyAux, hb]

/-- On the class of `f`, the map `R → k[t]` is the substitution `toPolyAux k n`. -/
@[simp] lemma toPoly_mk (f : MvPolynomial ℤ k) :
    toPoly k n (Ideal.Quotient.mk _ f) = toPolyAux k n f := rfl

/-- The prime `(x_m ; m ≠ n)` of `R`, the kernel of `R → k[t]`. -/
def coordIdeal : Ideal (ring k) := RingHom.ker (toPoly k n)

/-- The ideal `(x_m ; m ≠ n)` is prime. -/
instance coordIdeal_isPrime : (coordIdeal k n).IsPrime :=
  RingHom.ker_isPrime (toPoly k n).toRingHom

/-- The origin is a specialization of the prime `(x_m ; m ≠ n)`. -/
lemma coordIdeal_le_originIdeal : coordIdeal k n ≤ originIdeal k := by
  intro r hr
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
  have h1 : toPolyAux k n f = 0 := by
    rw [coordIdeal, RingHom.mem_ker, toPoly_mk] at hr; exact hr
  rw [mem_originIdeal_iff, constTerm_mk,
    ← apply_eq_aeval_zero_of_apply_X_eq_zero k (toPolyAux k n) (Polynomial.aeval (0 : k)) ?_ f]
  · simp [h1]
  · intro m
    by_cases hm : m = n <;> simp [toPolyAux, hm]

/-- The variable `x_n` does not lie in the prime `(x_m ; m ≠ n)`. -/
lemma xx_notMem_coordIdeal : xx k n ∉ coordIdeal k n := by
  rw [coordIdeal, RingHom.mem_ker]
  simp only [xx, toPoly_mk, toPolyAux, MvPolynomial.aeval_X]
  exact Polynomial.X_ne_zero

/-- The prime `(x_m ; m ≠ n)` is not the origin. -/
lemma coordIdeal_ne_originIdeal : coordIdeal k n ≠ originIdeal k :=
  fun h ↦ xx_notMem_coordIdeal k n (h ▸ xx_mem_originIdeal k n)

/-! ### The local ring at the origin is not Noetherian -/

/-- The trivial square-zero extension of `k` by a free module of countable rank. -/
abbrev sqz := TrivSqZeroExt k (ℤ →₀ k)

/-- The `k`-algebra map `k[x_n ; n ∈ ℤ] → k ⊕ (ℤ →₀ k)` sending `x_n` to `inr (single n 1)`. -/
def toSqzAux : MvPolynomial ℤ k →ₐ[k] sqz k :=
  MvPolynomial.aeval fun n ↦ TrivSqZeroExt.inr (Finsupp.single n 1)

/-- The induced surjection of `R` onto the square-zero extension. -/
def toSqz : ring k →ₐ[k] sqz k :=
  Ideal.Quotient.liftₐ _ (toSqzAux k) <|
    relations_apply_eq_zero k _ (by simp [toSqzAux, TrivSqZeroExt.inr_mul_inr])

/-- On the class of `f`, the map `R → k ⊕ (ℤ →₀ k)` is `toSqzAux k`. -/
@[simp] lemma toSqz_mk (f : MvPolynomial ℤ k) :
    toSqz k (Ideal.Quotient.mk _ f) = toSqzAux k f := rfl

/-- The map of `R` onto the square-zero extension is surjective. -/
lemma toSqz_surjective : Function.Surjective (toSqz k) := by
  have h2 : ∀ v : ℤ →₀ k, TrivSqZeroExt.inr v ∈ Set.range (toSqz k) := by
    intro v
    induction v using Finsupp.induction_linear with
    | zero => exact ⟨0, by simp⟩
    | add f g hf hg =>
        obtain ⟨a, ha⟩ := hf
        obtain ⟨b, hb⟩ := hg
        exact ⟨a + b, by rw [map_add, ha, hb, TrivSqZeroExt.inr_add]⟩
    | single a b =>
        refine ⟨Ideal.Quotient.mk _ (C b * X a), ?_⟩
        simp [toSqzAux, TrivSqZeroExt.algebraMap_eq_inl, TrivSqZeroExt.inl_mul_inr]
  intro z
  obtain ⟨q, hq⟩ := h2 z.snd
  refine ⟨algebraMap k _ z.fst + q, ?_⟩
  rw [map_add, hq, AlgHom.commutes, TrivSqZeroExt.algebraMap_eq_inl,
    TrivSqZeroExt.inl_fst_add_inr_snd_eq]

/-- The square-zero part of an element of an ideal generated by elements of the square-zero ideal
is supported in the union of their supports. -/
lemma snd_support_subset_of_mem_span {s : Set (sqz k)} (hs : ∀ z ∈ s, z.fst = 0)
    {F : Finset ℤ} (hF : ∀ z ∈ s, (TrivSqZeroExt.snd z).support ⊆ F)
    {z : sqz k} (hz : z ∈ Ideal.span s) :
    z.fst = 0 ∧ (TrivSqZeroExt.snd z).support ⊆ F := by
  induction hz using Submodule.span_induction with
  | mem x h => exact ⟨hs x h, hF x h⟩
  | zero => simp
  | add x y _ _ ih1 ih2 =>
      refine ⟨by simp [ih1.1, ih2.1], ?_⟩
      rw [TrivSqZeroExt.snd_add]
      exact Finsupp.support_add.trans (Finset.union_subset ih1.2 ih2.2)
  | smul a x _ ih =>
      rw [smul_eq_mul]
      refine ⟨by simp [ih.1], ?_⟩
      have hsnd : TrivSqZeroExt.snd (a * x) = TrivSqZeroExt.fst a • TrivSqZeroExt.snd x := by
        simp [TrivSqZeroExt.snd_mul, ih.1]
      rw [hsnd]
      exact fun i hi ↦ ih.2 (Finsupp.support_smul hi)

/-- The square-zero extension `k ⊕ (ℤ →₀ k)` is not Noetherian. -/
theorem not_isNoetherianRing_sqz : ¬ IsNoetherianRing (sqz k) := by
  rw [isNoetherianRing_iff_ideal_fg]
  intro h
  obtain ⟨s, hs⟩ := h (TrivSqZeroExt.kerIdeal k (ℤ →₀ k))
  obtain ⟨n, hn⟩ := (s.biUnion fun z ↦ (TrivSqZeroExt.snd z).support).exists_notMem
  have key := snd_support_subset_of_mem_span k (s := (↑s : Set (sqz k)))
    (F := s.biUnion fun z ↦ (TrivSqZeroExt.snd z).support)
    (fun z hz ↦ by
      have hz' : z ∈ TrivSqZeroExt.kerIdeal k (ℤ →₀ k) := hs ▸ Ideal.subset_span hz
      simpa [TrivSqZeroExt.kerIdeal, RingHom.mem_ker] using hz')
    (fun z hz ↦ Finset.subset_biUnion_of_mem
      (fun w ↦ (TrivSqZeroExt.snd w).support) (Finset.mem_coe.mp hz))
    (z := TrivSqZeroExt.inr (Finsupp.single n (1 : k)))
    (by rw [hs, TrivSqZeroExt.mem_kerIdeal_iff_inr]; simp)
  exact hn (key.2 (by simp))

/-- The `k`-component of the image of `r` in the square-zero extension is its constant term. -/
lemma fst_toSqz (r : ring k) : TrivSqZeroExt.fst (toSqz k r) = constTerm k r := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
  exact (apply_eq_aeval_zero_of_apply_X_eq_zero k (toSqzAux k) (TrivSqZeroExt.fstHom k k (ℤ →₀ k))
    (by simp [toSqzAux]) f)

/-- An element outside the origin has nonzero `k`-component in the square-zero extension. -/
lemma fst_toSqz_ne_zero {r : ring k} (hr : r ∉ originIdeal k) :
    TrivSqZeroExt.fst (toSqz k r) ≠ 0 := by
  rw [fst_toSqz]
  exact fun h ↦ hr ((mem_originIdeal_iff k).2 h)

/-- The homomorphism from the local ring of `R` at the origin to the square-zero extension
induced by `toSqz`. -/
def localizationToSqz : Localization.AtPrime (originIdeal k) →+* sqz k :=
  IsLocalization.lift (M := (originIdeal k).primeCompl)
    (g := (toSqz k : ring k →+* sqz k)) fun y ↦ by
      exact TrivSqZeroExt.isUnit_iff_isUnit_fst.2
        (isUnit_iff_ne_zero.2 (fst_toSqz_ne_zero k y.2))

/-- The map from the local ring at the origin to the square-zero extension is surjective. -/
lemma localizationToSqz_surjective : Function.Surjective (localizationToSqz k) := by
  intro z
  obtain ⟨r, hr⟩ := toSqz_surjective k z
  refine ⟨algebraMap (ring k) _ r, ?_⟩
  rw [localizationToSqz, IsLocalization.lift_eq]
  exact hr

/-- **The local ring of `R` at the origin is not Noetherian.** -/
theorem not_isNoetherianRing_atPrime_origin :
    ¬ IsNoetherianRing (Localization.AtPrime (originIdeal k)) := by
  intro h
  exact not_isNoetherianRing_sqz k
    (isNoetherianRing_of_surjective _ _ (localizationToSqz k) (localizationToSqz_surjective k))

end ManyVariable

end
