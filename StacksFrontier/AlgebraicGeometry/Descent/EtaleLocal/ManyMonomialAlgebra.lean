module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.Algebra.Polynomial.Laurent
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Localization.Ideal
public import Mathlib.RingTheory.Localization.Submodule
public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.RingTheory.Spectrum.Prime.Noetherian
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import Mathlib.Topology.NoetherianSpace
public import StacksCore.Tactic.StacksAttribute

/-!
# A non-Noetherian domain with Noetherian spectrum

Let `k` be a field and let `R` be the `k`-subalgebra of `k[X, Y]` generated by the monomials
`X Y^i` for all `i`. It is a domain whose prime spectrum is a Noetherian topological space,
yet `R` itself is not a Noetherian ring: the ideal generated by all the `X Y^i` is prime and
not finitely generated. This is the standard example separating "Noetherian spectrum" from
"Noetherian ring".

## Main definitions

* `ManyMonomial.subalgebra` is the subalgebra of `k[X, Y]` generated by the monomials `X Y^i`.
* `ManyMonomial.monomialIdeal` is the ideal of that subalgebra generated by those monomials.

## Main results

* `ManyMonomial.localization_away_x_equiv_laurentPolynomial` identifies the localization at
  `X` with a ring of Laurent polynomials.
* `ManyMonomial.monomialIdeal_isPrime` and `ManyMonomial.prime_eq_monomialIdeal_of_x_mem`
  show that the monomial ideal is the unique prime containing `X`.
* `ManyMonomial.noetherianSpace_primeSpectrum` shows the prime spectrum is a Noetherian space.
* `ManyMonomial.monomialIdeal_not_fg` shows the monomial ideal is not finitely generated, and
  `ManyMonomial.not_isNoetherianRing` concludes that the subalgebra is not Noetherian.

## Implementation notes

Inverting `X` makes every `Y^i` available, which is what identifies the localization with
Laurent polynomials over `k[Y]`; the spectrum is then covered by that localization together
with the single remaining point, giving the Noetherian space. Failure of finite generation is
detected by the linear part of an element, the coefficient extracted after evaluating `Y` and
discarding the constant term.

## References

* [Stacks Project, Tag 0G63](https://stacks.math.columbia.edu/tag/0G63)
-/

@[expose] public noncomputable section

namespace ManyMonomial

add_to_stacks 0G63 "prime correspondence" IsLocalization.primeSpectrumOrderIso
add_to_stacks 0G63 "domain" Subalgebra.isDomain

variable (k : Type*) [Field k]

/-- The monomial `x y^i` in two-variable polynomials. -/
def xyPow (i : ℕ) : MvPolynomial (Fin 2) k :=
  MvPolynomial.X 0 * MvPolynomial.X 1 ^ i

/-- The subalgebra generated over `k` by all `x y^i`. -/
@[stacks 0G63 "the algebra"]
def subalgebra : Subalgebra k (MvPolynomial (Fin 2) k) :=
  Algebra.adjoin k (Set.range (xyPow k))

/-- The element `x` of the generated subalgebra. -/
def x : subalgebra k :=
  ⟨MvPolynomial.X 0, by
    simpa [subalgebra, xyPow] using
      (Algebra.subset_adjoin (R := k) (s := Set.range (xyPow k))
        (Set.mem_range.mpr ⟨0, rfl⟩))⟩

/-- The element `x y^i` of the generated subalgebra. -/
def xyPowIn (i : ℕ) : subalgebra k :=
  ⟨xyPow k i, Algebra.subset_adjoin (Set.mem_range.mpr ⟨i, rfl⟩)⟩

/-- The ideal generated by all `x y^i`. -/
@[stacks 0G63 "the monomial ideal"]
def monomialIdeal : Ideal (subalgebra k) :=
  Ideal.span (Set.range (xyPowIn k))

variable {k} in
@[elab_as_elim]
private lemma subalgebra_induction {motive : subalgebra k → Prop}
    (hmem : ∀ i, motive (xyPowIn k i)) (halg : ∀ c : k, motive (algebraMap k _ c))
    (hadd : ∀ a b, motive a → motive b → motive (a + b))
    (hmul : ∀ a b, motive a → motive b → motive (a * b)) (a : subalgebra k) : motive a := by
  rcases a with ⟨z, hz⟩
  change z ∈ Algebra.adjoin k (Set.range (xyPow k)) at hz
  induction hz using Algebra.adjoin_induction with
  | mem z hz =>
      rcases hz with ⟨i, rfl⟩
      exact hmem i
  | algebraMap c => exact halg c
  | add a b _ _ iha ihb => exact hadd _ _ iha ihb
  | mul a b _ _ iha ihb => exact hmul _ _ iha ihb

private def evalZeroHom : subalgebra k →+* k :=
  (MvPolynomial.eval₂Hom (RingHom.id k) (fun _ : Fin 2 => 0)).comp
    (subalgebra k).val

private abbrev localization : Type _ := Localization.Away (x k)

private abbrev laurentRing : Type _ := LaurentPolynomial (Polynomial k)

private def localizationX : localization k :=
  algebraMap (subalgebra k) (localization k) (x k)

private theorem localizationXUnit : IsUnit (localizationX k) :=
  IsLocalization.Away.algebraMap_isUnit (x k)

private def localizationY : localization k :=
  algebraMap (subalgebra k) (localization k) (xyPowIn k 1) *
    (↑(((localizationXUnit k).unit)⁻¹) : localization k)

private def fromLaurentCoeff : Polynomial k →+* localization k :=
  Polynomial.eval₂RingHom (algebraMap k (localization k)) (localizationY k)

private def fromLaurentPoly : Polynomial (Polynomial k) →+* localization k :=
  Polynomial.eval₂RingHom (fromLaurentCoeff k) (localizationX k)

private def toLaurentHom : subalgebra k →+* laurentRing k :=
  (MvPolynomial.eval₂Hom (algebraMap k (laurentRing k))
    (fun i : Fin 2 => if i = 0 then LaurentPolynomial.T 1
      else LaurentPolynomial.C Polynomial.X)).comp (subalgebra k).val

private lemma toLaurentHom_xyPowIn (i : ℕ) :
    toLaurentHom k (xyPowIn k i) =
      LaurentPolynomial.T 1 * LaurentPolynomial.C (Polynomial.X ^ i) := by
  show (MvPolynomial.eval₂Hom (algebraMap k (laurentRing k))
    (fun j : Fin 2 => if j = 0 then LaurentPolynomial.T 1
      else LaurentPolynomial.C Polynomial.X)) (xyPow k i) = _
  simp [xyPow, MvPolynomial.eval₂_X]

private lemma toLaurentHom_algebraMap (c : k) :
    toLaurentHom k (algebraMap k (subalgebra k) c) = LaurentPolynomial.C (Polynomial.C c) := by
  show (MvPolynomial.eval₂Hom (algebraMap k (laurentRing k))
    (fun j : Fin 2 => if j = 0 then LaurentPolynomial.T 1
      else LaurentPolynomial.C Polynomial.X))
    (algebraMap k (MvPolynomial (Fin 2) k) c) = _
  simp

private lemma fromLaurentPoly_X_isUnit : IsUnit (fromLaurentPoly k Polynomial.X) := by
  simpa [fromLaurentPoly, Polynomial.eval₂_X] using localizationXUnit k

private noncomputable def fromLaurentHom : laurentRing k →+* localization k :=
  IsLocalization.Away.lift Polynomial.X (g := fromLaurentPoly k) (fromLaurentPoly_X_isUnit k)

private lemma toLaurent_eq_algebraMap :
    (Polynomial.toLaurent : Polynomial (Polynomial k) →+* laurentRing k) =
      algebraMap (Polynomial (Polynomial k)) (laurentRing k) :=
  RingHom.ext fun p => (LaurentPolynomial.algebraMap_eq_toLaurent (R := Polynomial k) p).symm

private lemma fromLaurentHom_comp_algebraMap :
    (fromLaurentHom k).comp
        (algebraMap (Polynomial (Polynomial k)) (laurentRing k)) = fromLaurentPoly k :=
  IsLocalization.Away.lift_comp Polynomial.X (g := fromLaurentPoly k) (fromLaurentPoly_X_isUnit k)

private lemma fromLaurentHom_comp_poly :
    (fromLaurentHom k).comp (Polynomial.toLaurent (R := Polynomial k)) =
      fromLaurentPoly k := by
  rw [toLaurent_eq_algebraMap]
  exact fromLaurentHom_comp_algebraMap k

private noncomputable def toLocalizationHom : localization k →+* laurentRing k :=
  IsLocalization.Away.lift (x k) (g := toLaurentHom k) (by
    simpa [toLaurentHom, x] using LaurentPolynomial.isUnit_T (R := Polynomial k) 1)

private lemma toLocalizationHom_comp_algebraMap :
    (toLocalizationHom k).comp
        (algebraMap (subalgebra k) (localization k)) = toLaurentHom k := by
  simp [toLocalizationHom]

private lemma toLocalizationHom_localizationX :
    toLocalizationHom k (localizationX k) = LaurentPolynomial.T 1 := by
  show toLocalizationHom k
    (algebraMap (subalgebra k) (localization k) (x k)) = _
  rw [← RingHom.comp_apply, toLocalizationHom_comp_algebraMap]
  simp [toLaurentHom, x]

private lemma fromLaurentHom_C_X_pow (i : ℕ) :
    fromLaurentHom k (LaurentPolynomial.C (Polynomial.X ^ i)) = localizationY k ^ i := by
  rw [← Polynomial.toLaurent_C (R := Polynomial k) (Polynomial.X ^ i), ← RingHom.comp_apply,
    fromLaurentHom_comp_poly]
  show (Polynomial.C (Polynomial.X ^ i)).eval₂
    (fromLaurentCoeff k) (localizationX k) = localizationY k ^ i
  rw [Polynomial.eval₂_C, (fromLaurentCoeff k).map_pow]
  show ((fromLaurentCoeff k) Polynomial.X) ^ i = localizationY k ^ i
  simp [fromLaurentCoeff, Polynomial.eval₂_X, localizationY]

private lemma fromLaurentHom_T_one :
    fromLaurentHom k (LaurentPolynomial.T 1) = localizationX k := by
  rw [← Polynomial.toLaurent_X (R := Polynomial k), ← RingHom.comp_apply,
    fromLaurentHom_comp_poly]
  simp [fromLaurentPoly, Polynomial.eval₂_X]

private lemma fromLaurentHom_toLaurentHom_xyPowIn (i : ℕ) :
    fromLaurentHom k (toLaurentHom k (xyPowIn k i)) =
      algebraMap (subalgebra k) (localization k) (xyPowIn k i) := by
  let xloc := localizationX k
  let ux := localizationXUnit k
  let yloc := localizationY k
  have hxy : xyPowIn k i * (x k) ^ i = (xyPowIn k 1) ^ i * x k := by
    apply Subtype.ext
    simp [xyPowIn, x, xyPow]
    ring
  have hxy' :
      algebraMap (subalgebra k) (localization k) (xyPowIn k i) * xloc ^ i =
        (algebraMap (subalgebra k) (localization k) (xyPowIn k 1)) ^ i * xloc := by
    simpa [map_mul, xloc, localizationX] using congrArg
      (algebraMap (subalgebra k) (localization k)) hxy
  rw [toLaurentHom_xyPowIn, map_mul, fromLaurentHom_T_one, fromLaurentHom_C_X_pow]
  calc
    xloc * yloc ^ i =
        (algebraMap (subalgebra k) (localization k) (xyPowIn k 1)) ^ i *
          (↑(ux.unit⁻¹) : localization k) ^ i * xloc := by
      simp [yloc, localizationY, mul_pow]
      ring
    _ = (algebraMap (subalgebra k) (localization k) (xyPowIn k i)) *
          xloc ^ i * (↑(ux.unit⁻¹) : localization k) ^ i := by
      rw [hxy']
      ac_rfl
    _ = algebraMap (subalgebra k) (localization k) (xyPowIn k i) := by
      rw [mul_assoc, ← mul_pow, ux.mul_val_inv, one_pow, mul_one]

private lemma fromLaurentHom_toLaurentHom_algebraMap (c : k) :
    fromLaurentHom k (toLaurentHom k (algebraMap k (subalgebra k) c)) =
      algebraMap (subalgebra k) (localization k) (algebraMap k (subalgebra k) c) := by
  rw [toLaurentHom_algebraMap, ← Polynomial.toLaurent_C (R := Polynomial k) (Polynomial.C c),
    ← RingHom.comp_apply, fromLaurentHom_comp_poly,
    ← IsScalarTower.algebraMap_apply k (subalgebra k) (localization k)]
  simp [fromLaurentPoly, fromLaurentCoeff, Polynomial.eval₂_C]

private lemma fromLaurentHom_toLocalizationHom_comp :
    (fromLaurentHom k).comp (toLocalizationHom k) = RingHom.id (localization k) := by
  apply IsLocalization.ringHom_ext (Submonoid.powers (x k))
  ext a
  rw [RingHom.comp_assoc, toLocalizationHom_comp_algebraMap]
  -- The algebra is generated by the monomials `x y^i` and the coefficient field.
  show fromLaurentHom k (toLaurentHom k a) = algebraMap (subalgebra k) (localization k) a
  induction a using subalgebra_induction with
  | hmem i => exact fromLaurentHom_toLaurentHom_xyPowIn k i
  | halg c => exact fromLaurentHom_toLaurentHom_algebraMap k c
  | hadd a b iha ihb => simp [iha, ihb]
  | hmul a b iha ihb => simp [iha, ihb]

private lemma toLocalizationHom_localizationY :
    toLocalizationHom k (localizationY k) = LaurentPolynomial.C Polynomial.X := by
  have hinv : LaurentPolynomial.T 1 *
      toLocalizationHom k (↑(((localizationXUnit k).unit)⁻¹) : localization k) = 1 := by
    rw [← toLocalizationHom_localizationX k, ← map_mul, (localizationXUnit k).mul_val_inv,
      map_one]
  rw [localizationY, map_mul, ← RingHom.comp_apply, toLocalizationHom_comp_algebraMap,
    toLaurentHom_xyPowIn, pow_one, mul_right_comm, hinv, one_mul]

private lemma toLocalizationHom_fromLaurentCoeff_comp :
    (toLocalizationHom k).comp (fromLaurentCoeff k) =
      LaurentPolynomial.C := by
  have hscalar (c : k) :
      toLocalizationHom k (algebraMap k (localization k) c) =
        LaurentPolynomial.C (Polynomial.C c) := by
    rw [IsScalarTower.algebraMap_apply k (subalgebra k) (localization k), ← RingHom.comp_apply,
      toLocalizationHom_comp_algebraMap]
    simp [toLaurentHom]
  refine Polynomial.ringHom_ext (fun c => ?_) ?_
  · simpa [fromLaurentCoeff] using hscalar c
  · simp [fromLaurentCoeff, toLocalizationHom_localizationY]

private lemma toLocalizationHom_fromLaurentPoly_comp :
    (toLocalizationHom k).comp (fromLaurentPoly k) =
      Polynomial.toLaurent (R := Polynomial k) := by
  refine Polynomial.ringHom_ext (fun c => ?_) ?_
  · simpa [fromLaurentPoly] using
      RingHom.congr_fun (toLocalizationHom_fromLaurentCoeff_comp k) c
  · simp [fromLaurentPoly, toLocalizationHom_localizationX]

private lemma toLocalizationHom_fromLaurentHom_comp :
    (toLocalizationHom k).comp (fromLaurentHom k) = RingHom.id (laurentRing k) := by
  apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial (Polynomial k)))
  rw [RingHom.comp_assoc, fromLaurentHom_comp_algebraMap,
    toLocalizationHom_fromLaurentPoly_comp]
  exact (toLaurent_eq_algebraMap k).symm

private lemma sub_eq_evalZero_mem_monomialIdeal (z : MvPolynomial (Fin 2) k)
    (hz : z ∈ subalgebra k) :
    (⟨z, hz⟩ : subalgebra k) -
      algebraMap k (subalgebra k) (evalZeroHom k ⟨z, hz⟩) ∈ monomialIdeal k := by
  generalize (⟨z, hz⟩ : subalgebra k) = a
  induction a using subalgebra_induction with
  | hmem i =>
      have hi : xyPowIn k i ∈ monomialIdeal k := Ideal.subset_span ⟨i, rfl⟩
      simpa [evalZeroHom, xyPowIn, xyPow] using hi
  | halg c => simp [evalZeroHom]
  | hadd a b iha ihb =>
      rw [map_add, map_add, add_sub_add_comm]
      exact (monomialIdeal k).add_mem iha ihb
  | hmul a b iha ihb =>
      have key : ∀ A B : subalgebra k, a * b - A * B = (a - A) * b + A * (b - B) :=
        fun A B => by ring
      rw [map_mul, map_mul, key]
      exact (monomialIdeal k).add_mem
        ((monomialIdeal k).mul_mem_right _ iha)
        ((monomialIdeal k).mul_mem_left _ ihb)

/-- Inverting `x` gives Laurent polynomials in `x` over `k[y]`. -/
@[stacks 0G63 "localization description"]
theorem localization_away_x_equiv_laurentPolynomial :
    ∃ e : Localization.Away (x k) ≃+* LaurentPolynomial (Polynomial k),
      (∀ c : k,
        e (algebraMap (subalgebra k) (Localization.Away (x k))
          (algebraMap k (subalgebra k) c)) =
        LaurentPolynomial.C (Polynomial.C c)) ∧
      e (algebraMap (subalgebra k) (Localization.Away (x k)) (x k)) =
        LaurentPolynomial.T 1 ∧
      (∀ i : ℕ,
        e (algebraMap (subalgebra k) (Localization.Away (x k))
          (xyPowIn k i)) =
        LaurentPolynomial.T 1 * LaurentPolynomial.C (Polynomial.X ^ i)) :=
  ⟨RingEquiv.ofRingHom (toLocalizationHom k) (fromLaurentHom k)
      (toLocalizationHom_fromLaurentHom_comp k) (fromLaurentHom_toLocalizationHom_comp k),
    fun c => (RingHom.congr_fun (toLocalizationHom_comp_algebraMap k) _).trans
      (toLaurentHom_algebraMap k c),
    toLocalizationHom_localizationX k,
    fun i => (RingHom.congr_fun (toLocalizationHom_comp_algebraMap k) _).trans
      (toLaurentHom_xyPowIn k i)⟩

private lemma monomialIdeal_le_ker : monomialIdeal k ≤ RingHom.ker (evalZeroHom k) := by
  apply Ideal.span_le.2
  rintro _ ⟨i, rfl⟩
  simp [evalZeroHom, xyPowIn, xyPow]

/-- The monomial ideal is prime. -/
@[stacks 0G63 "the prime containing x"]
theorem monomialIdeal_isPrime : (monomialIdeal k).IsPrime := by
  have hker : monomialIdeal k = RingHom.ker (evalZeroHom k) :=
    le_antisymm (monomialIdeal_le_ker k) fun a ha => by
      simpa [RingHom.mem_ker.mp ha] using sub_eq_evalZero_mem_monomialIdeal k a.1 a.2
  rw [hker]
  exact RingHom.ker_isPrime (evalZeroHom k)

/-- Each monomial `x y^i` belongs to a prime ideal containing `x`. -/
@[stacks 0G63 "monomials belong to primes containing x"]
theorem xyPowIn_mem_prime_of_x_mem
    (p : Ideal (subalgebra k)) [p.IsPrime] (h : x k ∈ p) (i : ℕ) :
    xyPowIn k i ∈ p := by
  have hpow : (xyPowIn k i) ^ 2 =
      x k * xyPowIn k (2 * i) := by
    apply Subtype.ext
    simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, xyPowIn, x, xyPow]
    rw [mul_pow, pow_mul]
    ring
  apply ‹p.IsPrime›.mem_of_pow_mem 2
  rw [hpow]
  exact p.mul_mem_right _ h

/-- Every prime containing `x` is the monomial ideal. -/
@[stacks 0G63 "uniqueness of the prime containing x"]
theorem prime_eq_monomialIdeal_of_x_mem
    (p : Ideal (subalgebra k)) [p.IsPrime] (h : x k ∈ p) :
    p = monomialIdeal k := by
  have hle : monomialIdeal k ≤ p :=
    Ideal.span_le.2 (Set.range_subset_iff.2 (xyPowIn_mem_prime_of_x_mem k p h))
  refine le_antisymm (fun a ha => ?_) hle
  have hdiff : a - algebraMap k (subalgebra k) (evalZeroHom k a) ∈ monomialIdeal k :=
    sub_eq_evalZero_mem_monomialIdeal k a.1 a.2
  have hc : algebraMap k (subalgebra k) (evalZeroHom k a) ∈ p := by
    simpa using p.sub_mem ha (hle hdiff)
  have hc0 : evalZeroHom k a = 0 := by
    by_contra hc0
    exact p.notMem_of_isUnit ((isUnit_iff_ne_zero.mpr hc0).map _) hc
  simpa [hc0] using hdiff

/-- The spectrum of the monomial algebra is Noetherian. -/
@[stacks 0G63 "Noetherian spectrum"]
theorem noetherianSpace_primeSpectrum :
    TopologicalSpace.NoetherianSpace (PrimeSpectrum (subalgebra k)) := by
  let L := localization k
  let P := PrimeSpectrum (subalgebra k)
  let f : PrimeSpectrum L → P := PrimeSpectrum.comap (algebraMap (subalgebra k) L)
  obtain ⟨e, -⟩ := localization_away_x_equiv_laurentPolynomial k
  have : IsNoetherianRing (laurentRing k) :=
    IsLocalization.isNoetherianRing
      (Submonoid.powers (Polynomial.X : Polynomial (Polynomial k))) _ inferInstance
  have : IsNoetherianRing L := isNoetherianRing_of_ringEquiv (laurentRing k) e.symm
  have hRange : TopologicalSpace.NoetherianSpace (Set.range f) :=
    (TopologicalSpace.noetherianSpace_iff_of_homeomorph
      (PrimeSpectrum.localization_comap_isEmbedding L
        (Submonoid.powers (x k))).toHomeomorph).mp inferInstance
  let m : P := ⟨monomialIdeal k, monomialIdeal_isPrime k⟩
  have hcover : Set.range f ∪ {m} = Set.univ := by
    refine Set.eq_univ_of_forall fun p => ?_
    by_cases hx : x k ∈ p.asIdeal
    · right
      exact Set.mem_singleton_iff.mpr
        (PrimeSpectrum.ext (prime_eq_monomialIdeal_of_x_mem k p.asIdeal hx))
    · left
      rw [PrimeSpectrum.localization_away_comap_range L (x k)]
      exact (PrimeSpectrum.mem_basicOpen (x k) p).2 hx
  let cover : Bool → Set P := fun b => if b then ({m} : Set P) else Set.range f
  have : ∀ b : Bool, TopologicalSpace.NoetherianSpace (cover b) := by
    rintro (_ | _)
    · simpa [cover] using hRange
    · show TopologicalSpace.NoetherianSpace ({m} : Set P)
      infer_instance
  have hUnion : TopologicalSpace.NoetherianSpace
      ((Set.range f ∪ ({m} : Set P)) : Set P) := by
    have hset : (Set.range f ∪ ({m} : Set P)) = ⋃ b : Bool, cover b := by
      ext p
      simp [cover, or_comm]
    rw [hset]
    exact TopologicalSpace.NoetherianSpace.iUnion cover
  exact TopologicalSpace.noetherian_univ_iff.mp (hcover ▸ hUnion)

private def evalAtYHom : MvPolynomial (Fin 2) k →+* Polynomial k :=
  MvPolynomial.eval₂Hom Polynomial.C (fun j : Fin 2 => if j = 0 then 0 else Polynomial.X)

private lemma evalAtYHom_eq_C_evalZero (a : subalgebra k) :
    evalAtYHom k a.1 = Polynomial.C (evalZeroHom k a) := by
  induction a using subalgebra_induction with
  | hmem i => simp [evalAtYHom, evalZeroHom, xyPowIn, xyPow]
  | halg c => simp [evalAtYHom, evalZeroHom]
  | hadd a b iha ihb => simp [iha, ihb]
  | hmul a b iha ihb => simp [iha, ihb]

private def linearPart (a : subalgebra k) : Polynomial k :=
  evalAtYHom k (MvPolynomial.pderiv 0 a.1)

private lemma linearPart_add (a b : subalgebra k) :
    linearPart k (a + b) = linearPart k a + linearPart k b := by
  simp [linearPart, MvPolynomial.pderiv_def]

private lemma linearPart_mul (a b : subalgebra k) :
    linearPart k (a * b) =
      linearPart k a * Polynomial.C (evalZeroHom k b) +
        Polynomial.C (evalZeroHom k a) * linearPart k b := by
  simp only [linearPart, Subalgebra.coe_mul, MvPolynomial.pderiv_mul, map_add, map_mul]
  rw [evalAtYHom_eq_C_evalZero k a, evalAtYHom_eq_C_evalZero k b]

private lemma linearPart_xyPowIn (i : ℕ) :
    linearPart k (xyPowIn k i) = Polynomial.X ^ i := by
  simp [linearPart, evalAtYHom, xyPowIn, xyPow]

private lemma linearPart_mem_span_of_mem_span {s : Set (subalgebra k)}
    (hs : Ideal.span s = monomialIdeal k) {a : subalgebra k}
    (ha : a ∈ Submodule.span (subalgebra k) s) :
    linearPart k a ∈ Submodule.span k (linearPart k '' s) ∧ evalZeroHom k a = 0 := by
  induction ha using Submodule.span_induction with
  | mem b hb =>
      refine ⟨Submodule.subset_span ⟨b, hb, rfl⟩, monomialIdeal_le_ker k ?_⟩
      rw [← hs]
      exact Ideal.subset_span hb
  | zero => simp [linearPart, evalZeroHom]
  | add a b ha hb iha ihb =>
      refine ⟨?_, by simp [iha.2, ihb.2]⟩
      rw [linearPart_add]
      exact Submodule.add_mem _ iha.1 ihb.1
  | smul r a ha iha =>
      have hD : linearPart k (r * a) =
          Polynomial.C (evalZeroHom k r) * linearPart k a := by
        rw [linearPart_mul, iha.2]
        simp
      refine ⟨?_, by simp [iha.2]⟩
      rw [smul_eq_mul, hD, ← Polynomial.smul_eq_C_mul]
      exact Submodule.smul_mem _ (evalZeroHom k r) iha.1

/-- The unique prime above `x` is not finitely generated. -/
@[stacks 0G63 "non-finitely generated ideal"]
theorem monomialIdeal_not_fg : ¬ (monomialIdeal k).FG := by
  rintro ⟨s, hs⟩
  classical
  let T : Finset ℕ := s.biUnion fun a => (linearPart k a).support
  obtain ⟨n, hn⟩ := T.exists_notMem
  have hcoeff_span : ∀ q ∈ Submodule.span k (linearPart k '' (s : Set (subalgebra k))),
      q.coeff n = 0 := by
    intro q hq
    induction hq using Submodule.span_induction with
    | mem q hq =>
        rcases hq with ⟨a, ha, rfl⟩
        exact Polynomial.notMem_support_iff.mp fun hmem =>
          hn (Finset.mem_biUnion.mpr ⟨a, ha, hmem⟩)
    | zero => simp
    | add q r hq hr ihq ihr => simp [ihq, ihr]
    | smul c q hq ih => simp [ih]
  have hgen : xyPowIn k n ∈ Ideal.span (s : Set (subalgebra k)) := by
    rw [hs]
    exact Ideal.subset_span ⟨n, rfl⟩
  simpa [linearPart_xyPowIn] using hcoeff_span _ (linearPart_mem_span_of_mem_span k hs hgen).1

/-- The monomial algebra is not a Noetherian ring. -/
@[stacks 0G63 "non-Noetherian ring"]
theorem not_isNoetherianRing : ¬ IsNoetherianRing (subalgebra k) :=
  fun _ => monomialIdeal_not_fg k (Ideal.fg_of_isNoetherianRing _)

end ManyMonomial

