@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v w

namespace Stacks.SheafOfModules

section CoproductInstances

universe w' v' u'

/-- Instance search for coproducts of presheaves of modules times out; supply it directly. -/
instance hasColimitsOfShape_discrete_bigSiteLocalGenerationFinitenessAgreement
    {C : Type u'} [Category.{v'} C] {L : GrothendieckTopology C} {R' : Sheaf L RingCat.{w'}}
    (I : Type w') : HasColimitsOfShape (Discrete I) (PresheafOfModules.{w'} R'.obj) :=
  PresheafOfModules.hasColimitsOfShape _ _

/-- Instance search for coproducts of sheaves of modules times out; supply it directly. -/
instance hasColimitsOfShape_discrete_sheaf_bigSiteLocalGenerationFinitenessAgreement
    {C : Type u'} [Category.{v'} C] {L : GrothendieckTopology C} {R' : Sheaf L RingCat.{w'}}
    [HasWeakSheafify L AddCommGrpCat.{w'}] [L.WEqualsLocallyBijective AddCommGrpCat.{w'}]
    (I : Type w') : HasColimitsOfShape (Discrete I) (_root_.SheafOfModules.{w'} R') :=
  @_root_.SheafOfModules.instHasColimitsOfShapeOfPresheafOfModulesObjFunctorOppositeRingCatIsSheaf
    _ _ _ R' _ _ _ _ (PresheafOfModules.hasColimitsOfShape _ _)

end CoproductInstances

section OfLe

variable {C : Type u} [Category.{v} C] {J K : GrothendieckTopology C} (h : K ≤ J)
  (R : Sheaf J RingCat.{w})
  [HasWeakSheafify J AddCommGrpCat.{w}] [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
  [HasWeakSheafify K AddCommGrpCat.{w}] [K.WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- **Sheafification for the finer topology fixes the structure sheaf.**  The structure sheaf of
the coarser topology *is* the structure sheaf of the finer one read for the coarser one
(`Stacks.SheafOfModules.comparisonPushforwardUnitIso`), and sheafification does nothing to a
module that is already a sheaf for the finer topology
(`Stacks.SheafOfModules.comparisonPullbackObjIso`).

This is the `u` of `Stacks.Sheaves.QcohTypeComparison.generatingSectionsMap` for the functor
`Stacks.SheafOfModules.comparisonPullback`. -/
public noncomputable def comparisonPullbackUnitIso :
    (comparisonPullback.{u, v, w, w} h R).obj (_root_.SheafOfModules.unit (ringOfLe h R)) ≅
      _root_.SheafOfModules.unit R :=
  (comparisonPullback.{u, v, w, w} h R).mapIso
      (comparisonPushforwardUnitIso.{u, v, w} h R).symm ≪≫
    comparisonPullbackObjIso.{u, v, w, w} h R (_root_.SheafOfModules.unit R)

/-- **Generating sections of the coarser reading of a module are generating sections of the
module**, with the same index type.

Sheafification for the finer topology is a left adjoint, so it preserves colimits and
epimorphisms and `Stacks.Sheaves.QcohTypeComparison.generatingSectionsMap` carries the family
across it without touching the index type; and it does nothing to the module, which is already a
sheaf for the finer topology, so the counit
`Stacks.SheafOfModules.comparisonPullbackObjIso` returns the family to the module itself rather
than to a sheafification.

Note that the free module on the index type is *not* the same on the two sides — it is a
sheafified coproduct — which is why this is not the mere observation that the sections and the
morphisms do not change. -/
public noncomputable def generatingSectionsOfComparisonPushforward
    (M : _root_.SheafOfModules.{w} R)
    (σ : ((comparisonPushforward.{u, v, w, w} h R).obj M).GeneratingSections) :
    M.GeneratingSections :=
  haveI : PreservesColimitsOfSize.{w, w} (comparisonPullback.{u, v, w, w} h R) :=
    preservesColimitsOfSize_comparisonPullback.{u, v, w, w} h R
  haveI : (comparisonPullback.{u, v, w, w} h R).IsLeftAdjoint :=
    (comparisonAdjunction.{u, v, w, w} h R).isLeftAdjoint
  haveI : (comparisonPullback.{u, v, w, w} h R).PreservesEpimorphisms :=
    Functor.preservesEpimorphisms_of_isLeftAdjoint _
  haveI : Epi (comparisonPullbackObjIso.{u, v, w, w} h R M).hom :=
    IsIso.epi_of_iso _
  (Stacks.Sheaves.QcohTypeComparison.generatingSectionsMap
      (comparisonPullback.{u, v, w, w} h R) (comparisonPullbackUnitIso h R) σ).ofEpi
    (comparisonPullbackObjIso.{u, v, w, w} h R M).hom

/-- The index type of the transported family is the given one, so every cardinality clause and
every finiteness clause survives. -/
@[simp]
public theorem generatingSectionsOfComparisonPushforward_I (M : _root_.SheafOfModules.{w} R)
    (σ : ((comparisonPushforward.{u, v, w, w} h R).obj M).GeneratingSections) :
    (generatingSectionsOfComparisonPushforward h R M σ).I = σ.I := rfl

section Slices

variable [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
  [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
  [∀ U : C, HasWeakSheafify (K.over U) AddCommGrpCat.{w}]
  [∀ U : C, (K.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]

omit [HasWeakSheafify J AddCommGrpCat.{w}] [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
  [HasWeakSheafify K AddCommGrpCat.{w}] [K.WEqualsLocallyBijective AddCommGrpCat.{w}] in
/-- **Local generation by `r` sections for a coarser topology implies local generation by `r`
sections for a finer one.**  For `K ≤ J` two topologies on one category and `M` a sheaf of
modules for `J`: if the reading of `M` for `K` is locally generated by `r` sections on `(C, K)`,
then `M` is locally generated by `r` sections on `(C, J)`.

Both ingredients are free of hypotheses.  A `K`-covering sieve of an object is a `J`-covering
sieve of it, since `K ≤ J`; and on the source of an arrow of that sieve the generating family of
the restriction of the reading is a generating family of the restriction of `M`, by
`Stacks.SheafOfModules.generatingSectionsOfComparisonPushforward` at the slice topologies
(`Stacks.SheafOfModules.over_le_over_of_le`), with the same index type and so with the same
bound `r`.  The two readings of the restriction are literally the same sheaf of modules.

This is the monotonicity that confines the mathematics of 05VG's clause for Modules on Sites,
Definition 03DL (4) at the big site to a single topology; it carries no `stacks` attribute, being
one implication of a clause whose equivalence is
`AlgebraicGeometry.BigFppfOver.isLocallyGeneratedByOnSite_baseAssociatedModule_iff`. -/
public theorem isLocallyGeneratedByOnSite_of_comparisonPushforward
    (M : _root_.SheafOfModules.{w} R) (r : ℕ)
    (hM : _root_.SheafOfModules.IsLocallyGeneratedByOnSite
      ((comparisonPushforward.{u, v, w, w} h R).obj M) r) :
    _root_.SheafOfModules.IsLocallyGeneratedByOnSite M r := by
  intro U
  obtain ⟨T, hT⟩ := hM U
  refine ⟨⟨T.1, h _ T.2⟩, fun V f hf => ?_⟩
  obtain ⟨σ, hσ⟩ := hT V f hf
  exact ⟨generatingSectionsOfComparisonPushforward (over_le_over_of_le h V) (R.over V)
    (M.over V) σ, hσ⟩

omit [HasWeakSheafify J AddCommGrpCat.{w}] [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
  [HasWeakSheafify K AddCommGrpCat.{w}] [K.WEqualsLocallyBijective AddCommGrpCat.{w}] in
/-- **Finite type for a coarser topology implies finite type for a finer one.**  For `K ≤ J` two
topologies on one category and `M` a sheaf of modules for `J`: if the reading of `M` for `K` is of
finite type on `(C, K)`, then `M` is of finite type on `(C, J)`.

The same covering family of the final object serves, a `K`-covering sieve being a `J`-covering
sieve; and the generating family on each member is carried to the module itself by
`Stacks.SheafOfModules.generatingSectionsOfComparisonPushforward`, which leaves the index type
alone and so preserves its finiteness.

It carries no `stacks` attribute, being one implication of a clause whose equivalence is
`AlgebraicGeometry.BigFppfOver.isFiniteType_baseAssociatedModule_iff`. -/
public theorem isFiniteType_of_comparisonPushforward (M : _root_.SheafOfModules.{w} R)
    (hM : ((comparisonPushforward.{u, v, w, w} h R).obj M).IsFiniteType) :
    M.IsFiniteType := by
  obtain ⟨σ, hσ⟩ := hM.exists_localGeneratorsData
  let σ' : M.LocalGeneratorsData :=
    { I := σ.I
      X := σ.X
      coversTop := fun W => h _ (σ.coversTop W)
      generators := fun i => generatingSectionsOfComparisonPushforward
        (over_le_over_of_le h (σ.X i)) (R.over (σ.X i)) (M.over (σ.X i)) (σ.generators i) }
  have hfin : ∀ i : σ'.I, (σ'.generators i).IsFiniteType := by
    intro i
    exact ⟨(hσ.isFiniteType i).finite⟩
  exact ⟨⟨σ', ⟨hfin⟩⟩⟩

end Slices

end OfLe

end Stacks.SheafOfModules

namespace AlgebraicGeometry.BigFppfOver

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### The pullback direction, at every `τ` -/

/-- **Generating sections of `𝓗|_V` over an open `V` of `S` give generating sections of
`(𝓗^a)|_{(Sch/V)_τ}`**, with the same index type, at every one of the five big sites.

The localized associated-module functor of the big `τ`-site preserves colimits and epimorphisms,
being a left adjoint, and carries the unit object to the unit object, so
`Stacks.Sheaves.QcohTypeComparison.generatingSectionsMap` carries the family across without
touching its index type; then
`AlgebraicGeometry.BigFppfOver.baseAssociatedModuleOverObjIso` — the step Stacks 03DV leaves
implicit — moves the result to the restriction of `𝓗^a`. -/
public noncomputable def generatingSectionsBaseAssociatedModuleOver (τ : SiteKind) (V : S.Opens)
    (𝓗 : S.Modules)
    (σ : (SheafOfModules.over.{u} (R := S.ringCatSheaf) 𝓗 V).GeneratingSections) :
    (((baseAssociatedModule B S hS τ).obj 𝓗).over
      ((opensToBig B S hS).obj V)).GeneratingSections :=
  haveI : PreservesColimitsOfSize.{u, u}
      (SheafOfModules.pullback.{u} (baseSliceStructureMap B S hS τ V)) :=
    (SheafOfModules.pullbackPushforwardAdjunction.{u}
      (baseSliceStructureMap B S hS τ V)).leftAdjoint_preservesColimits
  haveI : (SheafOfModules.pullback.{u} (baseSliceStructureMap B S hS τ V)).IsLeftAdjoint :=
    (SheafOfModules.pullbackPushforwardAdjunction.{u}
      (baseSliceStructureMap B S hS τ V)).isLeftAdjoint
  haveI :
      (SheafOfModules.pullback.{u} (baseSliceStructureMap B S hS τ V)).PreservesEpimorphisms :=
    Functor.preservesEpimorphisms_of_isLeftAdjoint _
  haveI : Epi (baseAssociatedModuleOverObjIso B S hS τ V 𝓗).hom := IsIso.epi_of_iso _
  (Stacks.Sheaves.QcohTypeComparison.generatingSectionsMap
      (SheafOfModules.pullback.{u} (baseSliceStructureMap B S hS τ V))
      (asIso (SheafOfModules.pullbackObjUnitToUnit.{u}
        (baseSliceStructureMap B S hS τ V))) σ).ofEpi
    (baseAssociatedModuleOverObjIso B S hS τ V 𝓗).hom

/-- The index type of the transported family is the given one, so both the bound of Modules on
Sites, Definition 03DL (4) and the finiteness of Definition 03DL (5) survive. -/
@[simp]
public theorem generatingSectionsBaseAssociatedModuleOver_I (τ : SiteKind) (V : S.Opens)
    (𝓗 : S.Modules)
    (σ : (SheafOfModules.over.{u} (R := S.ringCatSheaf) 𝓗 V).GeneratingSections) :
    (generatingSectionsBaseAssociatedModuleOver B S hS τ V 𝓗 σ).I = σ.I := rfl

/-- **Descent, Lemma 05VG for Modules on Sites, Definition 03DL (4): the pullback direction, at
the big site `(Sch/S)_τ` for every `τ ∈ {Zariski, étale, smooth, syntomic, fppf}`.**  If an
`𝒪_S`-module `𝓗` is locally generated by `r` sections on the small Zariski site of `S`, then
`𝓗^a` is locally generated by `r` sections as an `𝒪`-module on `(Sch/S)_τ`.

The source's argument, run at `τ` unchanged: Stacks 03DN at the small Zariski site produces a
Zariski covering of `S` on whose members `𝓗` is generated by `r` sections, its image covers the
final object of `(Sch/S)_τ` for every `τ`
(`AlgebraicGeometry.BigFppfOver.coversTop_baseOpensToBig_ulift`), on each member
`AlgebraicGeometry.BigFppfOver.generatingSectionsBaseAssociatedModuleOver` produces `r`
generating sections of the restriction of `𝓗^a`, and Stacks 03DN at the big `τ`-site assembles
the conclusion.  No quasi-coherence enters this half.

No `stacks` attribute: 05VG's clause for 03DL (4) asserts an equivalence, and this is one
implication of it.  The equivalence is
`AlgebraicGeometry.BigFppfOver.isLocallyGeneratedByOnSite_baseAssociatedModule_iff`. -/
public theorem isLocallyGeneratedByOnSite_baseAssociatedModule_of_isLocallyGeneratedByOnSite
    (τ : SiteKind) (𝓗 : S.Modules) (r : ℕ)
    (h : SheafOfModules.IsLocallyGeneratedByOnSite (R := S.ringCatSheaf) 𝓗 r) :
    SheafOfModules.IsLocallyGeneratedByOnSite ((baseAssociatedModule B S hS τ).obj 𝓗) r := by
  obtain ⟨I, V, hV, hgen⟩ :=
    (Stacks.SheafOfModules.isLocallyGeneratedByOnSite_iff_exists_cover_generators
      S.zariskiRingedSite 𝓗 r).1 h
  refine (Stacks.SheafOfModules.isLocallyGeneratedByOnSite_iff_exists_cover_generators
    (baseRingedSite B S hS τ) ((baseAssociatedModule B S hS τ).obj 𝓗) r).2
      ⟨ULift.{u + 1} I, fun i => (opensToBig B S hS).obj (V i.down),
        coversTop_baseOpensToBig_ulift B S hS τ V hV, fun i => ?_⟩
  obtain ⟨σ, hσ⟩ := hgen i.down
  exact ⟨generatingSectionsBaseAssociatedModuleOver B S hS τ (V i.down) 𝓗 σ, hσ⟩

/-- **Descent, Lemma 05VG for Modules on Sites, Definition 03DL (5): the pullback direction, at
the big site `(Sch/S)_τ` for every `τ ∈ {Zariski, étale, smooth, syntomic, fppf}`.**  If an
`𝒪_S`-module `𝓗` is of finite type, then `𝓗^a` is of finite type as an `𝒪`-module on
`(Sch/S)_τ`.

The covering family of opens of `S` carrying finitely many generating sections of `𝓗` is
Mathlib's `SheafOfModules.IsFiniteType.exists_localGeneratorsData`; its image covers the final
object of `(Sch/S)_τ`, and
`AlgebraicGeometry.BigFppfOver.generatingSectionsBaseAssociatedModuleOver` carries each family to
the restriction of `𝓗^a` without changing its index type, so finiteness is kept.  No
quasi-coherence enters this half.

No `stacks` attribute: this is one implication, and the equivalence is
`AlgebraicGeometry.BigFppfOver.isFiniteType_baseAssociatedModule_iff`. -/
public theorem isFiniteType_baseAssociatedModule_of_isFiniteType (τ : SiteKind)
    (𝓗 : S.Modules) (h : SheafOfModules.IsFiniteType (R := S.ringCatSheaf) 𝓗) :
    SheafOfModules.IsFiniteType ((baseAssociatedModule B S hS τ).obj 𝓗) := by
  obtain ⟨σ, hσ⟩ := h.exists_localGeneratorsData
  let σ' : ((baseAssociatedModule B S hS τ).obj 𝓗).LocalGeneratorsData :=
    { I := ULift.{u + 1} σ.I
      X := fun i => (opensToBig B S hS).obj (σ.X i.down)
      coversTop := coversTop_baseOpensToBig_ulift B S hS τ σ.X σ.coversTop
      generators := fun i => generatingSectionsBaseAssociatedModuleOver B S hS τ
        (σ.X i.down) 𝓗 (σ.generators i.down) }
  have hfin : ∀ i : σ'.I, (σ'.generators i).IsFiniteType := by
    intro i
    exact ⟨(hσ.isFiniteType i.down).finite⟩
  exact ⟨⟨σ', ⟨hfin⟩⟩⟩

/-! ### The descent direction, at `τ = fppf` -/

/-- **The pullback of `𝓗` along the structure morphism of `T` is generated by `r` global sections
as soon as the restriction of `𝓗^a` to the localization at `T` is.**

Three steps, each a statement of the library.  The reindexing of Stacks 06WI,
`AlgebraicGeometry.BigFppfOver.objRestrictFunctor`, is the functor of an equivalence of ringed
sites and carries the structure sheaf to the structure sheaf
(`AlgebraicGeometry.BigFppfOver.objRestrictFunctorUnitIso`), so
`Stacks.Sheaves.QcohTypeComparison.generatingSectionsMap` carries the generating family to the
big fppf site of the scheme of `T` without touching its index type; Stacks 03DV functorial in the
object, `AlgebraicGeometry.BigFppfOver.associatedModuleObjRestrictNatIso`, rewrites the result as
`(f^*𝓗)^a`; and `BigFppfOver.isGeneratedByGlobalSectionsOfCard_iff_baseAssociatedModule`, which
is 05VG for Modules on Sites 03DE (4) at the big site and is an *iff*, reflects the verdict down
to `f^*𝓗`.  The pullback is quasi-coherent by Stacks 01BG. -/
public theorem isGeneratedByGlobalSectionsOfCard_pullback_of_over (T : BigFppfOver B S hS)
    (𝓗 : S.Modules) [h𝓗 : 𝓗.IsQuasicoherent] (r : ℕ)
    (h : SheafOfModules.IsGeneratedByGlobalSectionsOfCard
      (((associatedModule B S hS).obj 𝓗).over T) r) :
    SheafOfModules.IsGeneratedByGlobalSectionsOfCard
      ((Scheme.Modules.pullback (objHom B S hS T)).obj 𝓗) r := by
  have : PreservesColimitsOfSize.{u, u} (objRestrictFunctor B S hS T) :=
    (objRestrictEquivalence B S hS T).toAdjunction.leftAdjoint_preservesColimits
  have : (objRestrictFunctor B S hS T).IsLeftAdjoint :=
    (objRestrictEquivalence B S hS T).toAdjunction.isLeftAdjoint
  have : (objRestrictFunctor B S hS T).PreservesEpimorphisms :=
    Functor.preservesEpimorphisms_of_isLeftAdjoint _
  have hstep : SheafOfModules.IsGeneratedByGlobalSectionsOfCard
      ((objRestrict B S hS T).obj ((associatedModule B S hS).obj 𝓗)) r :=
    ⟨Stacks.Sheaves.QcohTypeComparison.generatingSectionsMap (objRestrictFunctor B S hS T)
      (objRestrictFunctorUnitIso B S hS T) h.choose, h.choose_spec⟩
  exact (isGeneratedByGlobalSectionsOfCard_iff_baseAssociatedModule B (objScheme B S hS T)
      (contains_objScheme B S hS T) .fppf
      ⟨(Scheme.Modules.pullback (objHom B S hS T)).obj 𝓗,
        Stacks.Modules.isQuasicoherent_pullback _ 𝓗 h𝓗⟩ r).2
    (Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSectionsOfCard_of_iso
      ((associatedModuleObjRestrictNatIso B S hS T).app 𝓗).symm r hstep)

/-- **Descent, Lemma 05VG for Modules on Sites, Definition 03DL (4): the descent direction, at
the big fppf site.**  If the associated module `𝓗^a` of a quasi-coherent `𝒪_S`-module is locally
generated by `r` sections as an `𝒪`-module on `(Sch/S)_fppf`, then `𝓗` is locally generated by
`r` sections on the small Zariski site of `S`.

This is the half that carries the mathematics, and it is the source's own argument.  Stacks 03DN
produces a family covering the final object of `(Sch/S)_fppf` on whose members `𝓗^a` is generated
by `r` sections; the members are arbitrary schemes over `S`, so
`AlgebraicGeometry.BigFppfOver.exists_coversTop_fpqc_refinement` refines it to one whose
structure morphisms are an fpqc covering family of `S`, and generation by `r` sections follows the
refinement because `Stacks.SheafOfModules.generatingSectionsOverMap` restricts a generating family
along any arrow of the site without changing its index type.  On each member,
`AlgebraicGeometry.BigFppfOver.isGeneratedByGlobalSectionsOfCard_pullback_of_over` turns the
verdict into generation of the pullback of `𝓗` by `r` global sections, hence into the cardinal
bound that Stacks 082U consumes
(`Stacks.AlgebraicGeometry.CardinalGeneration.isCardinalGenerated_of_generatingSections`); 082U,
`AlgebraicGeometry.isCardinalGenerated_of_pullback_fpqc`, descends the bound to `S`, and
`AlgebraicGeometry.isLocallyGeneratedByOnSite_of_isCardinalGenerated` returns it to the
covering-family form of Stacks 03DL (4).

No `stacks` attribute: this is one implication, and the equivalence is
`AlgebraicGeometry.BigFppfOver.isLocallyGeneratedByOnSite_baseAssociatedModule_iff`. -/
public theorem isLocallyGeneratedByOnSite_of_associatedModule (𝓗 : S.Modules)
    [h𝓗 : 𝓗.IsQuasicoherent] (r : ℕ)
    (h : SheafOfModules.IsLocallyGeneratedByOnSite ((associatedModule B S hS).obj 𝓗) r) :
    SheafOfModules.IsLocallyGeneratedByOnSite (R := S.ringCatSheaf) 𝓗 r := by
  classical
  obtain ⟨I, X, hX, hgen⟩ :=
    (Stacks.SheafOfModules.isLocallyGeneratedByOnSite_iff_exists_cover_generators
      (baseRingedSite B S hS .fppf) ((associatedModule B S hS).obj 𝓗) r).1 h
  obtain ⟨I', Y, hY, hfpqc, hre⟩ := exists_coversTop_fpqc_refinement B S hS X hX
  refine isLocallyGeneratedByOnSite_of_isCardinalGenerated 𝓗 r
    (isCardinalGenerated_of_pullback_fpqc 𝓗 h𝓗 r (objHypercover B S hS Y).X
      (objHypercover B S hS Y).f hfpqc fun j => ?_)
  obtain ⟨i, ⟨g⟩⟩ := hre j
  obtain ⟨σ, hσ⟩ := hgen i
  obtain ⟨σ₀, ⟨e⟩⟩ := isGeneratedByGlobalSectionsOfCard_pullback_of_over B S hS (Y j) 𝓗 r
    ⟨Stacks.SheafOfModules.generatingSectionsOverMap
      ((associatedModule B S hS).obj 𝓗) g σ, hσ⟩
  refine Stacks.AlgebraicGeometry.CardinalGeneration.isCardinalGenerated_of_generatingSections
    σ₀ ?_
  rw [Cardinal.mk_congr (e.trans Equiv.ulift.symm)]
  simp

/-- **Descent, Lemma 05VG for Modules on Sites, Definition 03DL (5): the descent direction, at
the big fppf site.**  If the associated module `𝓗^a` of a quasi-coherent `𝒪_S`-module is of
finite type as an `𝒪`-module on `(Sch/S)_fppf`, then `𝓗` is of finite type.

The same route as for the bounded clause, with Stacks 05AZ in place of Stacks 082U: the family
covering the final object of `(Sch/S)_fppf` on whose members `𝓗^a` has finitely many generating
sections is refined to an fpqc covering family of `S` by
`AlgebraicGeometry.BigFppfOver.exists_coversTop_fpqc_refinement`, the generating families follow
the refinement by `Stacks.SheafOfModules.generatingSectionsOverMap` with their index types
intact, `AlgebraicGeometry.BigFppfOver.isGeneratedByGlobalSectionsOfCard_pullback_of_over` turns
each into finitely many global generators of the pullback of `𝓗` — hence into finite type of the
pullback, by `Stacks.SheafOfModules.isFiniteType_of_generatingSections` — and
`AlgebraicGeometry.isFiniteType_of_pullback_fpqc`, Stacks 05AZ, descends finite type to `S`.

The number of generators varies over the covering family, which is why the bound is produced
member by member from `Finite.exists_equiv_fin` rather than fixed in advance.

No `stacks` attribute: this is one implication, and the equivalence is
`AlgebraicGeometry.BigFppfOver.isFiniteType_baseAssociatedModule_iff`. -/
public theorem isFiniteType_of_associatedModule (𝓗 : S.Modules) [h𝓗 : 𝓗.IsQuasicoherent]
    (h : SheafOfModules.IsFiniteType ((associatedModule B S hS).obj 𝓗)) :
    SheafOfModules.IsFiniteType (R := S.ringCatSheaf) 𝓗 := by
  classical
  obtain ⟨σ, hσ⟩ := h.exists_localGeneratorsData
  obtain ⟨I', Y, hY, hfpqc, hre⟩ :=
    exists_coversTop_fpqc_refinement B S hS σ.X σ.coversTop
  refine isFiniteType_of_pullback_fpqc 𝓗 h𝓗 (objHypercover B S hS Y).X
    (objHypercover B S hS Y).f hfpqc fun j => ?_
  obtain ⟨i, ⟨g⟩⟩ := hre j
  have := hσ.isFiniteType i
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin (σ.generators i).I
  obtain ⟨σ₀, ⟨e₀⟩⟩ := isGeneratedByGlobalSectionsOfCard_pullback_of_over B S hS (Y j) 𝓗 n
    ⟨Stacks.SheafOfModules.generatingSectionsOverMap
      ((associatedModule B S hS).obj 𝓗) g (σ.generators i), ⟨e⟩⟩
  have : σ₀.IsFiniteType := ⟨Finite.of_equiv _ e₀.symm⟩
  exact Stacks.SheafOfModules.isFiniteType_of_generatingSections σ₀

/-! ### The two clauses, as equivalences, at every `τ` -/

/-- **Descent, Lemma 05VG for Modules on Sites, Definition 03DL (4), on the big site, as an
equivalence.**  A quasi-coherent `𝒪_S`-module `𝓗` is locally generated by `r` sections on the
small Zariski site of `S` if and only if `𝓗^a` is locally generated by `r` sections as an
`𝒪`-module on `(Sch/S)_τ`, for every `τ ∈ {Zariski, étale, smooth, syntomic, fppf}`.

The `only if` half is
`BigFppfOver.isLocallyGeneratedByOnSite_baseAssociatedModule_of_isLocallyGeneratedByOnSite`,
proved at every `τ` and needing no quasi-coherence.  The `if` half is proved at `τ = fppf` by
`AlgebraicGeometry.BigFppfOver.isLocallyGeneratedByOnSite_of_associatedModule`, and carried to the
four coarser topologies by the monotonicity
`Stacks.SheafOfModules.isLocallyGeneratedByOnSite_of_comparisonPushforward` through the key to
Stacks 0GNE, `AlgebraicGeometry.BigFppfOver.restrictTopologyAssociatedModuleIso`, which exhibits
`𝓗^a` on `(Sch/S)_τ` as `𝓗^a` on `(Sch/S)_fppf` read for the coarser topology.  Quasi-coherence
is used by that half alone, and it is the hypothesis the source's clause carries.

The clause string records the scope: this is clause 03DL (4) of 05VG, at the **big** site
`(Sch/S)_τ` and at every `τ`.  The small sites are
`AlgebraicGeometry.SmallEtale.isLocallyGeneratedByOnSite_associatedModule_iff` and
`AlgebraicGeometry.SmallZariski.isLocallyGeneratedByOnSite_iff_associatedModule`. -/
@[stacks 05VG "locally generated by r sections (03DL (4)), big site (Sch/S)_τ at every τ, at \
the comparison functor of 03DX itself"]
public theorem isLocallyGeneratedByOnSite_baseAssociatedModule_iff (τ : SiteKind)
    (𝓗 : S.Modules) [h𝓗 : 𝓗.IsQuasicoherent] (r : ℕ) :
    SheafOfModules.IsLocallyGeneratedByOnSite (R := S.ringCatSheaf) 𝓗 r ↔
      SheafOfModules.IsLocallyGeneratedByOnSite ((baseAssociatedModule B S hS τ).obj 𝓗) r := by
  refine ⟨isLocallyGeneratedByOnSite_baseAssociatedModule_of_isLocallyGeneratedByOnSite
    B S hS τ 𝓗 r, fun hh => ?_⟩
  refine isLocallyGeneratedByOnSite_of_associatedModule B S hS 𝓗 r
    (Stacks.SheafOfModules.isLocallyGeneratedByOnSite_of_comparisonPushforward
      (baseOverTopology_le_fppf B S hS τ) (structureSheaf B S hS)
      ((associatedModule B S hS).obj 𝓗) r ?_)
  exact Stacks.SheafOfModules.Intrinsic.isLocallyGeneratedByOnSite_of_iso
    (restrictTopologyAssociatedModuleIso B S hS τ 𝓗).symm r hh

/-- **Descent, Lemma 05VG for Modules on Sites, Definition 03DL (5), on the big site, as an
equivalence.**  A quasi-coherent `𝒪_S`-module `𝓗` is of finite type if and only if `𝓗^a` is of
finite type as an `𝒪`-module on `(Sch/S)_τ`, for every
`τ ∈ {Zariski, étale, smooth, syntomic, fppf}`.

The `only if` half is
`AlgebraicGeometry.BigFppfOver.isFiniteType_baseAssociatedModule_of_isFiniteType`, proved at every
`τ` and needing no quasi-coherence.  The `if` half is proved at `τ = fppf` by
`AlgebraicGeometry.BigFppfOver.isFiniteType_of_associatedModule`, and carried to the four coarser
topologies by the monotonicity
`Stacks.SheafOfModules.isFiniteType_of_comparisonPushforward` through
`AlgebraicGeometry.BigFppfOver.restrictTopologyAssociatedModuleIso`.  Quasi-coherence is used by
that half alone, and it is the hypothesis the source's clause carries.

The clause string records the scope: this is clause 03DL (5) of 05VG, at the **big** site
`(Sch/S)_τ` and at every `τ`.  The small sites are
`AlgebraicGeometry.SmallEtale.isFiniteType_associatedModule_iff` and
`AlgebraicGeometry.SmallZariski.isFiniteType_iff_associatedModule`, both of which hold without
quasi-coherence; at the big site the descent is fpqc descent of finite type, Stacks 05AZ, which
is stated for a quasi-coherent module. -/
@[stacks 05VG "finite type (03DL (5)), big site (Sch/S)_τ at every τ, at the comparison \
functor of 03DX itself"]
public theorem isFiniteType_baseAssociatedModule_iff (τ : SiteKind) (𝓗 : S.Modules)
    [h𝓗 : 𝓗.IsQuasicoherent] :
    SheafOfModules.IsFiniteType (R := S.ringCatSheaf) 𝓗 ↔
      SheafOfModules.IsFiniteType ((baseAssociatedModule B S hS τ).obj 𝓗) := by
  refine ⟨isFiniteType_baseAssociatedModule_of_isFiniteType B S hS τ 𝓗, fun hh => ?_⟩
  refine isFiniteType_of_associatedModule B S hS 𝓗
    (Stacks.SheafOfModules.isFiniteType_of_comparisonPushforward
      (baseOverTopology_le_fppf B S hS τ) (structureSheaf B S hS)
      ((associatedModule B S hS).obj 𝓗) ?_)
  exact Stacks.SheafOfModules.Intrinsic.isFiniteType_of_iso
    (restrictTopologyAssociatedModuleIso B S hS τ 𝓗).symm hh

end AlgebraicGeometry.BigFppfOver

