-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u m

namespace Stacks.PresheafOfModules

open AlgebraicGeometry

variable {C : Type (u + 1)} [Category.{u} C] [HasPullbacks C]

omit [HasPullbacks C] in
/-- **A finite flat covering family is faithfully flat on global functions.** The presheaf of
global functions of a functor to affine schemes, read on a finite family which is a flat
covering of schemes, gives a faithfully flat product map. -/
@[sga "3 VIB 11.9.1" "partial"]
public theorem faithfullyFlat_pi_schemeGamma (L : C ⥤ Scheme.{u}) [∀ X, IsAffine (L.obj X)]
    {U : C} (E : PreZeroHypercover.{u + 1} U) [Finite E.I₀]
    (hE : (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U)) :
    (RingHom.pi (fun k => ((L.op ⋙ Scheme.Γ).map (E.f k).op).hom)).FaithfullyFlat := by
  obtain ⟨hcover, hflat⟩ := (Scheme.presieve₀_mem_precoverage_iff (E.map L)).mp hE
  let _ (i : E.I₀) : Flat (L.map (E.f i)) := hflat i
  exact AlgebraicGeometry.Scheme.faithfullyFlat_pi_appTop (fun i => L.obj (E.X i))
    (fun i => L.map (E.f i)) hcover

omit [HasPullbacks C] in
/-- **The presheaf of global functions turns fibre products into pushouts of rings**, on a
functor to affine schemes preserving fibre products. -/
public theorem isPushout_schemeGamma (L : C ⥤ Scheme.{u})
    [PreservesLimitsOfShape WalkingCospan L] [∀ X, IsAffine (L.obj X)]
    {X Y Z P : C} {fst : P ⟶ X} {snd : P ⟶ Y} {a : X ⟶ Z} {b : Y ⟶ Z}
    (h : IsPullback fst snd a b) :
    IsPushout ((L.op ⋙ Scheme.Γ).map a.op) ((L.op ⋙ Scheme.Γ).map b.op)
      ((L.op ⋙ Scheme.Γ).map fst.op) ((L.op ⋙ Scheme.Γ).map snd.op) :=
  Stacks.Sites.isPushout_schemeRings_of_isPullback L (L.op ⋙ Scheme.Γ) rfl h

/-- **A cartesian presheaf of modules over the global functions of a site of affine schemes is a
sheaf**, for a topology generated by finite flat covering families. -/
public theorem isSheaf_of_cartesian_schemeGamma (L : C ⥤ Scheme.{u})
    [PreservesLimitsOfShape WalkingCospan L] [∀ X, IsAffine (L.obj X)]
    (M : PresheafOfModules.{max m u} ((L.op ⋙ Scheme.Γ) ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {X Y : Cᵒᵖ} (f : X ⟶ Y),
      IsIso (restrictionBaseChange.{u + 1, u, u, m} M f))
    (J : Precoverage C)
    (hJ : ∀ {U : C} {P : Presieve U}, P ∈ J U →
      ∃ E : PreZeroHypercover.{u + 1} U, P = E.presieve₀ ∧ Finite E.I₀ ∧
        (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U)) :
    Presheaf.IsSheaf J.toGrothendieck M.presheaf :=
  isSheaf_of_cartesian_of_flat_covers'.{u, u + 1, u, m, u, u + 1} L _
    (fun E hfin hE => have := hfin; faithfullyFlat_pi_schemeGamma L E hE)
    (fun h => isPushout_schemeGamma L h) M hM J hJ

end Stacks.PresheafOfModules

namespace AlgebraicGeometry

section Fppf

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- A covering family of `(Aff/S)_fppf` is finite and is a flat covering of the underlying
schemes: a standard fppf covering is finite, jointly surjective and flat. -/
public theorem bigAffineFppf_covering_flat {U : BigAffineFppf B S hS}
    (E : PreZeroHypercover.{u + 1} U) (hE : BigAffineFppf.IsCovering B S hS ⟨U, E⟩) :
    Finite E.I₀ ∧ (E.map (BigAffineFppf.toScheme B S hS)).presieve₀ ∈
      Scheme.precoverage @Flat ((BigAffineFppf.toScheme B S hS).obj U) := by
  refine ⟨hE.2.finite_index, ?_⟩
  refine (Scheme.presieve₀_mem_precoverage_iff _).mpr ⟨?_, ?_⟩
  · intro x
    have hx : x ∈ (⋃ i, Set.range ((BigAffineFppf.toScheme B S hS).map (E.f i))) := by
      rw [hE.2.jointly_surjective]; trivial
    obtain ⟨i, y, hy⟩ := Set.mem_iUnion.mp hx
    exact ⟨i, y, hy⟩
  · exact fun i => hE.2.flat i

/-- `AlgebraicGeometry.bigAffineFppf_covering_flat` in the form the finiteness refinement of
quasi-coherence asks for. -/
public theorem bigAffineFppf_covering_finite_flat {U : BigAffineFppf B S hS} (P : Presieve U)
    (hP : P ∈ BigAffineFppf.precoverage B S hS U) :
    P.uncurry.Finite ∧ P.map (BigAffineFppf.toScheme B S hS) ∈
      Scheme.precoverage @Flat ((BigAffineFppf.toScheme B S hS).obj U) := by
  obtain ⟨E, rfl, hE⟩ := hP
  obtain ⟨hfin, hflat⟩ := bigAffineFppf_covering_flat B S hS E hE
  let _ := hfin
  refine ⟨Precoverage.ofArrows_mem_finite _ _, ?_⟩
  rwa [← PreZeroHypercover.presieve₀_map]

/-- **Stacks 0GZV, condition (1) implies the sheaf conjunct of condition (6).** A presheaf of
`𝒪_Aff`-modules on `(Aff/S)_fppf` all of whose base-change comparisons
`𝓕(U') ⊗_{𝒪(U')} 𝒪(U) ⟶ 𝓕(U)` are isomorphisms satisfies the fppf sheaf axiom. The coverings of
`(Aff/S)_fppf` are finite flat coverings of affine schemes, so this is flat descent of modules,
Stacks 023M. -/
@[stacks 0GZV "(1) ⇒ the sheaf conjunct of (6), at τ = fppf"]
public theorem bigAffineFppf_isSheaf_of_cartesian
    (M : PresheafOfModules.{max m u}
      ((bigAffineFppfRingedSite B S hS).O.obj ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {X Y : (BigAffineFppf B S hS)ᵒᵖ} (f : X ⟶ Y),
      IsIso (Stacks.PresheafOfModules.restrictionBaseChange.{u + 1, u, u, m} M f)) :
    Presheaf.IsSheaf (BigAffineFppf.topology B S hS) M.presheaf :=
  Stacks.PresheafOfModules.isSheaf_of_cartesian_schemeGamma
    (BigAffineFppf.toScheme B S hS) M hM (BigAffineFppf.precoverage B S hS)
    (fun {U} {P} hP => by
      obtain ⟨E, rfl, hE⟩ := hP
      obtain ⟨hfin, hflat⟩ := bigAffineFppf_covering_flat B S hS E hE
      exact ⟨E, rfl, hfin, hflat⟩)

end Fppf

section Zariski

variable (B : BigZariskiSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- A covering family of `(Aff/S)_Zar` is finite and is a flat covering of the underlying
schemes: a standard Zariski covering is finite, and as a Zariski covering its members are
jointly surjective open immersions, which are flat. -/
public theorem bigAffineZariski_covering_flat {U : BigAffineZariski B S hS}
    (E : PreZeroHypercover.{u + 1} U) (hE : BigAffineZariski.IsCovering B S hS ⟨U, E⟩) :
    Finite E.I₀ ∧ (E.map (BigAffineZariski.toScheme B S hS)).presieve₀ ∈
      Scheme.precoverage @Flat ((BigAffineZariski.toScheme B S hS).obj U) := by
  obtain ⟨-, hmem, hfin, -⟩ := hE
  have hle : (@IsOpenImmersion : MorphismProperty Scheme.{u}) ≤ @Flat :=
    fun _ _ _ hf => have := hf; inferInstance
  exact ⟨hfin, Scheme.precoverage_mono hle _ hmem⟩

/-- **Stacks 0GZV, condition (1) implies the sheaf conjunct of condition (2).** A presheaf of
`𝒪_Aff`-modules on `(Aff/S)_Zar` all of whose base-change comparisons
`𝓕(U') ⊗_{𝒪(U')} 𝒪(U) ⟶ 𝓕(U)` are isomorphisms satisfies the Zariski sheaf axiom. The
coverings of `(Aff/S)_Zar` are finite flat coverings of affine schemes, so this is flat
descent of modules, Stacks 023M. -/
@[stacks 0GZV "(1) ⇒ the sheaf conjunct of (2), at τ = Zariski"]
public theorem bigAffineZariski_isSheaf_of_cartesian
    (M : PresheafOfModules.{max m u}
      ((bigAffineZariskiRingedSite B S hS).O.obj ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {X Y : (BigAffineZariski B S hS)ᵒᵖ} (f : X ⟶ Y),
      IsIso (Stacks.PresheafOfModules.restrictionBaseChange.{u + 1, u, u, m} M f)) :
    Presheaf.IsSheaf (BigAffineZariski.topology B S hS) M.presheaf :=
  Stacks.PresheafOfModules.isSheaf_of_cartesian_schemeGamma
    (BigAffineZariski.toScheme B S hS) M hM (BigAffineZariski.precoverage B S hS)
    (fun {U} {P} hP => by
      obtain ⟨E, rfl, hE⟩ := hP
      obtain ⟨hfin, hflat⟩ := bigAffineZariski_covering_flat B S hS E hE
      exact ⟨E, rfl, hfin, hflat⟩)

end Zariski

