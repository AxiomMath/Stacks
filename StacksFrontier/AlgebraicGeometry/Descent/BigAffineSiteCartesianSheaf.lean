variable (B : BigSyntomicSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- A covering family of `(Aff/S)_syntomic` is finite and is a flat covering of the underlying
schemes: a standard syntomic covering is finite, and as a syntomic covering its members are
jointly surjective syntomic morphisms, which are flat by Stacks 01UL. -/
public theorem bigAffineSyntomic_covering_flat {U : BigAffineSyntomic B S hS}
    (E : PreZeroHypercover.{u + 1} U) (hE : BigAffineSyntomic.IsCovering B S hS ⟨U, E⟩) :
