      rw [hstd.jointly_surjective]; trivial
    obtain ⟨i, y, hy⟩ := Set.mem_iUnion.mp hx
    exact ⟨i, y, hy⟩
  · exact fun i => AlgebraicGeometry.flat (hcov.1.1 i)

