module

public import Mathlib.AlgebraicGeometry.Sites.Etale
public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import StacksFrontier.AlgebraicGeometry.Topologies.Syntomic.Stability
public import StacksCore.Tactic.StacksAttribute

/-!
# Precomposition of a property local on the source

A property of morphisms of schemes which is local on the source for one of the six topologies
fpqc, fppf, syntomic, smooth, étale, Zariski is preserved by precomposition with a morphism of
the corresponding kind: flat, resp. flat and locally of finite presentation, resp. syntomic,
resp. smooth, resp. étale, resp. an open immersion.

## Main definitions

There are no new definitions.

## Main results

* `AlgebraicGeometry.precomp_of_flat` — the fpqc case.
* `AlgebraicGeometry.precomp_of_flat_locallyOfFinitePresentation` — the fppf case.
* `AlgebraicGeometry.precomp_of_syntomic` — the syntomic case.
* `AlgebraicGeometry.precomp_of_smooth` — the smooth case.
* `AlgebraicGeometry.precomp_of_etale` — the étale case.
* `AlgebraicGeometry.precomp_of_isOpenImmersion` — the Zariski case.
* `AlgebraicGeometry.precomp_of_precoverage` — the common form for the precoverage attached to a
  morphism class, from which all cases but fpqc are read off. It is the general statement other
  modules should use when they need Tag 04QV for an abstract class.

## Implementation notes

Locality on the source is Mathlib's `CategoryTheory.MorphismProperty.IsLocalAtSource` for the
precoverage of the topology in question. In all six cases the argument is the same: the two
morphisms `a : X' ⟶ X` and `𝟙 X` form a cover of `X` for the topology, because `𝟙 X` alone is
already jointly surjective and both members belong to the defining class; locality on the
source applied to that cover and to the member `a` gives the conclusion. This is
`AlgebraicGeometry.precomp_of_precoverage`, which handles the five topologies whose precoverage
is `AlgebraicGeometry.Scheme.precoverage` of a morphism class.

The fpqc topology is not of that form — it also demands quasi-compactness of the covering
family — so its case is proved separately, the quasi-compactness of the two-member cover being
transported from the singleton cover `{𝟙 X}` along the evident morphism of families.

In the fppf case the morphism is flat and locally of finite presentation; it is not required to
be quasi-compact.

## References

* [Stacks Project, Tag 04QV](https://stacks.math.columbia.edu/tag/04QV)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

/-- The cover of `X` by `a : X' ⟶ X` together with `𝟙 X`, for a morphism class `M` containing
both of them. The identity alone is jointly surjective, so this is a cover; its point is to
exhibit `a` as a member of a cover of its own target. -/
private def pairCover {M : MorphismProperty Scheme.{u}} {X' X : Scheme.{u}}
    (a : X' ⟶ X) (ha : M a) (hi : M (𝟙 X)) : X.Cover (Scheme.precoverage M) :=
  Scheme.Cover.mkOfCovers (Sum Unit Unit)
    (fun i ↦ match i with | .inl _ => X' | .inr _ => X)
    (fun i ↦ match i with | .inl _ => a | .inr _ => 𝟙 X)
    (fun x ↦ ⟨.inr (), x, rfl⟩)
    (by rintro (⟨⟩ | ⟨⟩) <;> assumption)

/-- A property local on the source for the topology generated by a morphism class `M` containing
the identities is preserved by precomposition with a morphism in `M`. -/
theorem precomp_of_precoverage (M P : MorphismProperty Scheme.{u})
    (hP : P.IsLocalAtSource (Scheme.precoverage M)) {X' X Y : Scheme.{u}}
    (a : X' ⟶ X) (f : X ⟶ Y) (ha : M a) (hi : M (𝟙 X)) (hf : P f) :
    P (a ≫ f) :=
  hP.comp (pairCover a ha hi).mem₀ a (Presieve.ofArrows.mk (Sum.inl ())) hf

/-- **Stacks Project, Tag 04QV, fpqc case.** A property of morphisms of schemes which is fpqc
local on the source is preserved by precomposition with a flat morphism. -/
@[stacks 04QV "fpqc case"]
theorem precomp_of_flat (P : MorphismProperty Scheme.{u})
    [P.IsLocalAtSource Scheme.fpqcPrecoverage]
    {X' X Y : Scheme.{u}} (a : X' ⟶ X) (f : X ⟶ Y)
    (ha : Flat a) (hf : P f) : P (a ≫ f) := by
  let 𝒰 := pairCover a ha (inferInstance : Flat (𝟙 X))
  have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
    QuasiCompactCover.of_hom (𝒱 := PreZeroHypercover.singleton.{0} (𝟙 X))
      (⟨fun _ ↦ Sum.inr (), fun _ ↦ 𝟙 X, by cat_disch⟩ :
        (PreZeroHypercover.singleton.{0} (𝟙 X)).Hom 𝒰.toPreZeroHypercover)
  let 𝒱 : X.Cover Scheme.fpqcPrecoverage :=
    ⟨𝒰.toPreZeroHypercover, by
      show 𝒰.presieve₀ ∈ Scheme.propQCPrecoverage (@Flat) X
      exact ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr hqc, 𝒰.mem₀⟩⟩
  exact ‹P.IsLocalAtSource Scheme.fpqcPrecoverage›.comp 𝒱.mem₀ a
    (Presieve.ofArrows.mk (Sum.inl ())) hf

/-- **Stacks Project, Tag 04QV, fppf case.** A property of morphisms of schemes which is fppf
local on the source is preserved by precomposition with a flat morphism which is locally of
finite presentation. -/
@[stacks 04QV "fppf case"]
theorem precomp_of_flat_locallyOfFinitePresentation
    (P : MorphismProperty Scheme.{u}) [P.IsLocalAtSource Scheme.fppfPrecoverage]
    {X' X Y : Scheme.{u}} (a : X' ⟶ X) (f : X ⟶ Y)
    (ha : Flat a) (ha' : LocallyOfFinitePresentation a) (hf : P f) :
    P (a ≫ f) :=
  precomp_of_precoverage _ P ‹P.IsLocalAtSource Scheme.fppfPrecoverage› a f ⟨ha, ha'⟩
    ⟨inferInstance, inferInstance⟩ hf

/-- **Stacks Project, Tag 04QV, syntomic case.** A property of morphisms of schemes which is
syntomic local on the source is preserved by precomposition with a syntomic morphism. -/
@[stacks 04QV "syntomic case"]
theorem precomp_of_syntomic (P : MorphismProperty Scheme.{u})
    [P.IsLocalAtSource (Scheme.precoverage (@Syntomic.{u}))]
    {X' X Y : Scheme.{u}} (a : X' ⟶ X) (f : X ⟶ Y)
    (ha : Syntomic a) (hf : P f) : P (a ≫ f) :=
  precomp_of_precoverage _ P inferInstance a f ha
    (fun x ↦ (isSyntomicCovering_singleton_of_isIso (𝟙 X)).1 () x) hf

/-- **Stacks Project, Tag 04QV, smooth case.** A property of morphisms of schemes which is
smooth local on the source is preserved by precomposition with a smooth morphism. -/
@[stacks 04QV "smooth case"]
theorem precomp_of_smooth (P : MorphismProperty Scheme.{u})
    [P.IsLocalAtSource (Scheme.precoverage @Smooth)]
    {X' X Y : Scheme.{u}} (a : X' ⟶ X) (f : X ⟶ Y)
    (ha : Smooth a) (hf : P f) : P (a ≫ f) :=
  precomp_of_precoverage _ P inferInstance a f ha inferInstance hf

/-- **Stacks Project, Tag 04QV, étale case.** A property of morphisms of schemes which is étale
local on the source is preserved by precomposition with an étale morphism. -/
@[stacks 04QV "étale case"]
theorem precomp_of_etale (P : MorphismProperty Scheme.{u})
    [P.IsLocalAtSource Scheme.etalePrecoverage]
    {X' X Y : Scheme.{u}} (a : X' ⟶ X) (f : X ⟶ Y)
    (ha : Etale a) (hf : P f) : P (a ≫ f) :=
  precomp_of_precoverage _ P ‹P.IsLocalAtSource Scheme.etalePrecoverage› a f ha
    inferInstance hf

/-- **Stacks Project, Tag 04QV, Zariski case.** A property of morphisms of schemes which is
Zariski local on the source is preserved by precomposition with an open immersion. -/
@[stacks 04QV "Zariski case"]
theorem precomp_of_isOpenImmersion (P : MorphismProperty Scheme.{u})
    [P.IsLocalAtSource Scheme.zariskiPrecoverage]
    {X' X Y : Scheme.{u}} (a : X' ⟶ X) (f : X ⟶ Y)
    (ha : IsOpenImmersion a) (hf : P f) : P (a ≫ f) :=
  precomp_of_precoverage _ P inferInstance a f ha inferInstance hf

end AlgebraicGeometry
