/-!
# Reindexing descent data along a bijection of index types

The index type of a family `f i : X i ⟶ S` enters a descent datum only as the domain of its
components, its gluing isomorphisms and its cocycle identities. Hence a descent datum relative
to `f` is, by precomposition with a bijection `e : J ≃ ι`, a descent datum relative to the
reindexed family `fun j ↦ f (e j)`, and the two carry the same information. The same holds for
the presieve generated by the family and for the canonical descent datum of a scheme over `S`,
so effectivity relative to a family is a property of the family up to reindexing.

As an application, a descent datum relative to a surjective flat quasi-compact morphism onto an
affine scheme whose structure morphism is affine is effective.

## Main definitions

* `AlgebraicGeometry.DescentData.reindex` reindexes a descent datum along a bijection of index
  types.
* `AlgebraicGeometry.DescentData.reindexFunctor` is that operation as a functor.
* `AlgebraicGeometry.DescentData.reindexCanonicalIso` identifies the reindexing of a canonical
  descent datum with the canonical descent datum of the same scheme.

## Main results

* `AlgebraicGeometry.DescentData.ofArrows_reindex`: a reindexed family generates the same
  presieve.
* `AlgebraicGeometry.DescentData.ofArrows_const_eq_singleton`: a constant nonempty family
  generates the singleton presieve on its one morphism.
* `AlgebraicGeometry.DescentData.isFamilyEffective_reindex` and
  `AlgebraicGeometry.DescentData.isFamilyEffective_of_reindex`: effectivity relative to a family
  is invariant under reindexing.
* `AlgebraicGeometry.DescentDatum.isEffective_of_isAffineHom_of_affineBase`: a descent datum
  relative to a surjective flat quasi-compact morphism onto an affine scheme, whose structure
  morphism is affine, is effective.

## Implementation notes

Every field of the reindexed datum is the corresponding field of the original one evaluated at
the image of the index, so all components match definitionally; likewise the reindexing of the
canonical descent datum of `W` is the canonical descent datum of `W`, whose identification is
therefore the identity isomorphism.

## References

* [Stacks Project, Tag 0245](https://stacks.math.columbia.edu/tag/0245)
* [Stacks Project, Tag 02VU](https://stacks.math.columbia.edu/tag/02VU)
-/

@[expose] public section

noncomputable section

universe u v w

namespace AlgebraicGeometry.DescentData

open CategoryTheory CategoryTheory.Limits

variable {ι : Type v} {J : Type w} {S : Scheme.{u}} {X : ι → Scheme.{u}} {f : ∀ i, X i ⟶ S}

/-- A descent datum relative to a family is a descent datum relative to the family reindexed
along a map of index types. -/
def reindex (e : J → ι) (D : DescentData f) : DescentData (fun j ↦ f (e j)) where
  obj j := D.obj (e j)
  gluing j j' := D.gluing (e j) (e j')
  cocycle j j' j'' := D.cocycle (e j) (e j') (e j'')

/-- The components of a reindexed descent datum are the components of the original descent datum
at the image indices. -/
@[simp]
lemma reindex_obj (e : J → ι) (D : DescentData f) (j : J) :
    (D.reindex e).obj j = D.obj (e j) := rfl

/-- The gluing isomorphisms of a reindexed descent datum are those of the original descent datum at
the image indices. -/
@[simp]
lemma reindex_gluing (e : J → ι) (D : DescentData f) (j j' : J) :
    (D.reindex e).gluing j j' = D.gluing (e j) (e j') := rfl

/-- Reindexing descent data along a map of index types, as a functor. -/
@[simps]
def reindexFunctor (e : J → ι) : DescentData f ⥤ DescentData (fun j ↦ f (e j)) where
  obj D := D.reindex e
  map φ := { hom := fun j ↦ φ.hom (e j), comm := fun j j' ↦ φ.comm (e j) (e j') }
  map_id _ := hom_ext fun _ ↦ rfl
  map_comp _ _ := hom_ext fun _ ↦ rfl

/-- Reindexing a family along a bijection does not change the presieve it generates. -/
lemma ofArrows_reindex (e : J ≃ ι) :
    CategoryTheory.Presieve.ofArrows (fun j ↦ X (e j)) (fun j ↦ f (e j)) =
      CategoryTheory.Presieve.ofArrows X f := by
  funext Y
  ext g
  constructor
  · rintro ⟨j⟩
    exact Presieve.ofArrows.mk (e j)
  · rintro ⟨i⟩
    obtain ⟨j, rfl⟩ := e.surjective i
    exact Presieve.ofArrows.mk j

/-- A constant one-member family generates the presieve consisting of that single morphism. -/
lemma ofArrows_const_eq_singleton {J : Type w} [Nonempty J] {S X : Scheme.{u}} (f : X ⟶ S) :
    CategoryTheory.Presieve.ofArrows (fun _ : J ↦ X) (fun _ ↦ f) =
      CategoryTheory.Presieve.singleton f := by
  funext Y
  ext g
  constructor
  · rintro ⟨_⟩
    exact Presieve.singleton.mk
  · rintro ⟨_⟩
    exact Presieve.ofArrows.mk (Classical.arbitrary J)

/-- Reindexing carries the canonical descent datum of a scheme over `S` to the canonical descent
datum of the same scheme. -/
def reindexCanonicalIso (e : J → ι) (W : Over S) :
    ((canonicalFamilyDescentFunctor f).functor.obj W).reindex e ≅
      (canonicalFamilyDescentFunctor (fun j ↦ f (e j))).functor.obj W :=
  Iso.refl _

/-- Effectivity of a descent datum relative to a family is unchanged by reindexing the family
along a map of index types. -/
theorem isFamilyEffective_reindex (e : J → ι) {D : DescentData f} (h : D.IsFamilyEffective) :
    (D.reindex e).IsFamilyEffective := by
  obtain ⟨W, ⟨i⟩⟩ := h
  exact ⟨W, ⟨(reindexCanonicalIso e W).symm ≪≫ (reindexFunctor e).mapIso i⟩⟩

/-- A descent datum whose reindexing along a bijection of index types is effective is itself
effective. -/
theorem isFamilyEffective_of_reindex (e : J ≃ ι) {D : DescentData f}
    (h : (D.reindex e).IsFamilyEffective) : D.IsFamilyEffective := by
  have key : ∀ g : ι ≃ ι, g = Equiv.refl ι →
      (D.reindex g).IsFamilyEffective → D.IsFamilyEffective := by
    rintro _ rfl
    exact id
  exact key (e.symm.trans e) e.symm_trans_self (isFamilyEffective_reindex e.symm h)

end AlgebraicGeometry.DescentData

namespace AlgebraicGeometry.DescentDatum

open CategoryTheory CategoryTheory.Limits

/-- **Effective descent for affine morphisms along a surjective flat quasi-compact morphism onto
an affine scheme.** A descent datum relative to such a morphism whose structure morphism is
affine is effective. -/
@[sga "3 X 5.4" "special case"]
theorem isEffective_of_isAffineHom_of_affineBase {S X : Scheme.{u}} [IsAffine S] {f : X ⟶ S}
    [Surjective f] [Flat f] [QuasiCompact f] (D : DescentDatum f)
    (haff : IsAffineHom D.over.hom) : DescentData.IsEffective D := by
  have hcov : Presieve.ofArrows (fun _ : ULift.{u} Unit ↦ X) (fun _ ↦ f) ∈
      Scheme.fpqcPrecoverage S := by
    rw [DescentData.ofArrows_const_eq_singleton]
    exact f.singleton_mem_fpqcPrecoverage
  have hfam := DescentData.isFamilyEffective_of_isAffineHom_of_affineBase
    (fun _ : ULift.{u} Unit ↦ f) hcov (D.reindex (Equiv.ulift (α := Unit)))
    fun _ ↦ haff
  exact DescentData.isEffective_of_isFamilyEffective
    (DescentData.isFamilyEffective_of_reindex (D := D) (Equiv.ulift (α := Unit)) hfam)

end AlgebraicGeometry.DescentDatum

end

end
