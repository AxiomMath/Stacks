module

public import StacksFrontier.AlgebraicGeometry.Descent.AffineBaseFamilyEffectivity
public import StacksFrontier.AlgebraicGeometry.Descent.FamilyEffectivityComparison
public import StacksFrontier.AlgebraicGeometry.Descent.Germs.EffectiveDescentData
