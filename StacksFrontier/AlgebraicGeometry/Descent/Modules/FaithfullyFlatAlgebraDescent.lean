* [Stacks Project, Tag 0245](https://stacks.math.columbia.edu/tag/0245)
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory TensorProduct

namespace ModuleCat

variable (R A : Type u) [CommRing R] [CommRing A] [Algebra R A]
    (B : Type u) [CommRing B] [Algebra R B] [Algebra A B] [IsScalarTower R A B]

/-- The underlying `R`-module of an `A`-algebra `B`, viewed through
`ModuleCat.restrictScalars`, is `B` with its own `R`-module structure. The map is the
identity; the two `R`-module structures agree because `R → A → B` is a tower. -/
def restrictModuleAlgebraEquiv :
    (restrictModule R A (ModuleCat.of A B)) ≃ₗ[R] B where
  toFun x := x
  map_add' _ _ := rfl
  map_smul' r x := IsScalarTower.algebraMap_smul A r (show B from x)
  invFun x := x
  left_inv _ := rfl
  right_inv _ := rfl

/-- `ModuleCat.restrictModuleAlgebraEquiv` is the identity on underlying elements. -/
@[simp]
lemma restrictModuleAlgebraEquiv_apply (x : restrictModule R A (ModuleCat.of A B)) :
    restrictModuleAlgebraEquiv R A B x = show B from x := rfl

/-- The inverse of `ModuleCat.restrictModuleAlgebraEquiv` is the identity on elements. -/
@[simp]
lemma restrictModuleAlgebraEquiv_symm_apply (x : B) :
    (restrictModuleAlgebraEquiv R A B).symm x = show restrictModule R A (ModuleCat.of A B) from x :=
  rfl

/-- The source of the transition map of a descent datum on `B`, compared with the honest
tensor product `B ⊗[R] A`. -/
def algebraSourceEquiv :
    (restrictModule R A (ModuleCat.of A B) ⊗[R] A) ≃ₗ[R] (B ⊗[R] A) :=
  TensorProduct.congr (restrictModuleAlgebraEquiv R A B) (LinearEquiv.refl R A)

/-- The target of the transition map of a descent datum on `B`, compared with the honest
tensor product `A ⊗[R] B`. -/
def algebraTargetEquiv :
    (A ⊗[R] restrictModule R A (ModuleCat.of A B)) ≃ₗ[R] (A ⊗[R] B) :=
  TensorProduct.congr (LinearEquiv.refl R A) (restrictModuleAlgebraEquiv R A B)

/-- `ModuleCat.algebraSourceEquiv` sends `x ⊗ a` to `x ⊗ a`, with `x` read as an element of `B`. -/
@[simp]
lemma algebraSourceEquiv_tmul (x : restrictModule R A (ModuleCat.of A B)) (a : A) :
    algebraSourceEquiv R A B (x ⊗ₜ[R] a) = (show B from x) ⊗ₜ[R] a := rfl

/-- The inverse of `ModuleCat.algebraSourceEquiv` sends `x ⊗ a` to `x ⊗ a`. -/
@[simp]
lemma algebraSourceEquiv_symm_tmul (x : B) (a : A) :
    (algebraSourceEquiv R A B).symm (x ⊗ₜ[R] a) =
      (show restrictModule R A (ModuleCat.of A B) from x) ⊗ₜ[R] a := rfl

/-- `ModuleCat.algebraTargetEquiv` sends `a ⊗ x` to `a ⊗ x`, with `x` read as an element of `B`. -/
@[simp]
lemma algebraTargetEquiv_tmul (a : A) (x : restrictModule R A (ModuleCat.of A B)) :
    algebraTargetEquiv R A B (a ⊗ₜ[R] x) = a ⊗ₜ[R] (show B from x) := rfl

/-- The inverse of `ModuleCat.algebraTargetEquiv` sends `a ⊗ x` to `a ⊗ x`. -/
@[simp]
lemma algebraTargetEquiv_symm_tmul (a : A) (x : B) :
    (algebraTargetEquiv R A B).symm (a ⊗ₜ[R] x) =
      a ⊗ₜ[R] (show restrictModule R A (ModuleCat.of A B) from x) := rfl

/-! ### The two `A ⊗[R] A`-actions are multiplication -/

/-- The `A ⊗[R] A`-action of `ModuleCat.sourceTensorModule` on `B ⊗[R] A` is multiplication by
the image of `A ⊗[R] A` under `algebraMap A B` in the left factor. -/
lemma algebraSourceEquiv_smul (a b : A)
    (x : restrictModule R A (ModuleCat.of A B) ⊗[R] A) :
    algebraSourceEquiv R A B ((a ⊗ₜ[R] b) • x) =
      (algebraMap A B a ⊗ₜ[R] b) * algebraSourceEquiv R A B x := by
  induction x with
  | zero => simp
  | add x y hx hy => rw [smul_add, map_add, hx, hy, map_add, mul_add]
  | tmul n c =>
    rw [sourceTensor_smul_tmul, algebraSourceEquiv_tmul, algebraSourceEquiv_tmul,
      Algebra.TensorProduct.tmul_mul_tmul]
    exact congrArg (· ⊗ₜ[R] (b * c))
      (Algebra.smul_def a (show B from n))

/-- The `A ⊗[R] A`-action of `ModuleCat.targetTensorModule` on `A ⊗[R] B` is multiplication by
the image of `A ⊗[R] A` under `algebraMap A B` in the right factor. -/
lemma algebraTargetEquiv_smul (a b : A)
    (y : A ⊗[R] restrictModule R A (ModuleCat.of A B)) :
    algebraTargetEquiv R A B ((a ⊗ₜ[R] b) • y) =
      (a ⊗ₜ[R] algebraMap A B b) * algebraTargetEquiv R A B y := by
  induction y with
  | zero => simp
  | add x y hx hy => rw [smul_add, map_add, hx, hy, map_add, mul_add]
  | tmul c n =>
    rw [targetTensor_smul_tmul, algebraTargetEquiv_tmul, algebraTargetEquiv_tmul,
      Algebra.TensorProduct.tmul_mul_tmul]
    exact congrArg ((a * c) ⊗ₜ[R] ·)
      (Algebra.smul_def b (show B from n))

/-- Through `ModuleCat.algebraTargetEquiv`, multiplication by `a ⊗ algebraMap A B b` on `A ⊗[R] B`
is the action of `a ⊗ b` on the target of the transition map. -/
lemma algebraTargetEquiv_symm_mul (a b : A) (z : A ⊗[R] B) :
    (algebraTargetEquiv R A B).symm ((a ⊗ₜ[R] algebraMap A B b) * z) =
      (a ⊗ₜ[R] b) • (algebraTargetEquiv R A B).symm z :=
  (algebraTargetEquiv R A B).injective <| by
    rw [LinearEquiv.apply_symm_apply, algebraTargetEquiv_smul, LinearEquiv.apply_symm_apply]

/-! ### The transition map of an algebra descent datum -/

/-- The map `x ↦ τ x` read through `ModuleCat.algebraSourceEquiv` and
`ModuleCat.algebraTargetEquiv` is `A ⊗[R] A`-linear, which is what packages `τ` as the
transition of a module descent datum. -/
lemma algebraTransition_smul (τ : (B ⊗[R] A) ≃ₐ[R] (A ⊗[R] B))
    (hτ : ∀ a b : A, τ (algebraMap A B a ⊗ₜ[R] b) = a ⊗ₜ[R] algebraMap A B b)
    (s : A ⊗[R] A) (x : restrictModule R A (ModuleCat.of A B) ⊗[R] A) :
    (algebraTargetEquiv R A B).symm (τ (algebraSourceEquiv R A B (s • x))) =
      s • (algebraTargetEquiv R A B).symm (τ (algebraSourceEquiv R A B x)) := by
  induction s with
  | zero => simp
  | add s t hs ht => simp only [add_smul, map_add, hs, ht]
  | tmul a b => rw [algebraSourceEquiv_smul, map_mul, hτ a b, algebraTargetEquiv_symm_mul]

/-- An isomorphism of `R`-algebras `B ⊗[R] A ≃ A ⊗[R] B` over `A ⊗[R] A`, in the sense that
it carries `algebraMap A B a ⊗ b` to `a ⊗ algebraMap A B b`, is an `A ⊗[R] A`-linear
isomorphism between the two pullbacks of `B` in the sense of `ModuleCat.DescentData`. -/
def algebraTransition (τ : (B ⊗[R] A) ≃ₐ[R] (A ⊗[R] B))
    (hτ : ∀ a b : A, τ (algebraMap A B a ⊗ₜ[R] b) = a ⊗ₜ[R] algebraMap A B b) :
    (restrictModule R A (ModuleCat.of A B) ⊗[R] A) ≃ₗ[A ⊗[R] A]
      (A ⊗[R] restrictModule R A (ModuleCat.of A B)) where
  toFun x := (algebraTargetEquiv R A B).symm (τ (algebraSourceEquiv R A B x))
  invFun y := (algebraSourceEquiv R A B).symm (τ.symm (algebraTargetEquiv R A B y))
  map_add' x y := by simp
  map_smul' s x := algebraTransition_smul R A B τ hτ s x
  left_inv x := by simp
  right_inv y := by simp

/-- `ModuleCat.algebraTransition` sends `x` to `τ x`, read through `ModuleCat.algebraSourceEquiv`
and `ModuleCat.algebraTargetEquiv`. -/
@[simp]
lemma algebraTransition_apply (τ : (B ⊗[R] A) ≃ₐ[R] (A ⊗[R] B))
    (hτ : ∀ a b : A, τ (algebraMap A B a ⊗ₜ[R] b) = a ⊗ₜ[R] algebraMap A B b)
    (x : restrictModule R A (ModuleCat.of A B) ⊗[R] A) :
    algebraTransition R A B τ hτ x =
      (algebraTargetEquiv R A B).symm (τ (algebraSourceEquiv R A B x)) := rfl

/-- A descent datum for modules along `R → A` out of an algebra descent datum: the underlying
module is `B` and the transition is `ModuleCat.algebraTransition`. The cocycle condition is the
hypothesis `hcoc`; it is the cocycle condition of the source for `τ`, transported along
`ModuleCat.algebraSourceEquiv` and `ModuleCat.algebraTargetEquiv`. -/
def descentDataOfAlgebra (τ : (B ⊗[R] A) ≃ₐ[R] (A ⊗[R] B))
    (hτ : ∀ a b : A, τ (algebraMap A B a ⊗ₜ[R] b) = a ⊗ₜ[R] algebraMap A B b)
    (hcoc : (transition12 R A (ModuleCat.of A B) (algebraTransition R A B τ hτ)).comp
        (transition01 R A (ModuleCat.of A B) (algebraTransition R A B τ hτ)) =
      transition02 R A (ModuleCat.of A B) (algebraTransition R A B τ hτ)) :
    DescentData.{u, u, u} R A where
  module := ModuleCat.of A B
  transition := algebraTransition R A B τ hτ
  cocycle := hcoc

/-! ### The invariant subalgebra -/

/-- The invariants of an algebra descent datum: the `R`-subalgebra of `B` of those `b` with
`τ (b ⊗ 1) = 1 ⊗ b`. It is a subalgebra, and not merely a submodule, exactly because `τ` is a
ring homomorphism. -/
@[sga "1 VIII 1.6" "partial"]
def descentInvariants (τ : (B ⊗[R] A) ≃ₐ[R] (A ⊗[R] B)) : Subalgebra R B where
  carrier := {b : B | τ (b ⊗ₜ[R] (1 : A)) = (1 : A) ⊗ₜ[R] b}
  mul_mem' {b b'} hb hb' := by
    simp only [Set.mem_ofPred_eq] at hb hb' ⊢
    rw [show (b * b') ⊗ₜ[R] (1 : A) = (b ⊗ₜ[R] (1 : A)) * (b' ⊗ₜ[R] (1 : A)) by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one], map_mul, hb, hb',
      Algebra.TensorProduct.tmul_mul_tmul, mul_one]
  one_mem' := by
    simp only [Set.mem_ofPred_eq]
    rw [← Algebra.TensorProduct.one_def, map_one, Algebra.TensorProduct.one_def]
  add_mem' {b b'} hb hb' := by
    simp only [Set.mem_ofPred_eq] at hb hb' ⊢
    rw [TensorProduct.add_tmul, map_add, hb, hb', TensorProduct.tmul_add]
  zero_mem' := by
    simp only [Set.mem_ofPred_eq]
    rw [TensorProduct.zero_tmul, map_zero, TensorProduct.tmul_zero]
  algebraMap_mem' r := by
    simp only [Set.mem_ofPred_eq]
    rw [← Algebra.TensorProduct.algebraMap_apply, AlgEquiv.commutes,
      Algebra.TensorProduct.algebraMap_apply']

omit [Algebra A B] [IsScalarTower R A B] in
/-- An element `b` of `B` lies in `ModuleCat.descentInvariants` exactly when
`τ (b ⊗ 1) = 1 ⊗ b`. -/
@[simp]
lemma mem_descentInvariants_iff (τ : (B ⊗[R] A) ≃ₐ[R] (A ⊗[R] B)) (b : B) :
    b ∈ descentInvariants R A B τ ↔ τ (b ⊗ₜ[R] (1 : A)) = (1 : A) ⊗ₜ[R] b := Iff.rfl

/-- The invariants of the module descent datum of an algebra descent datum are the invariant
subalgebra. -/
lemma mem_invariantSubmodule_descentDataOfAlgebra (τ : (B ⊗[R] A) ≃ₐ[R] (A ⊗[R] B))
    (hτ : ∀ a b : A, τ (algebraMap A B a ⊗ₜ[R] b) = a ⊗ₜ[R] algebraMap A B b)
    (hcoc : (transition12 R A (ModuleCat.of A B) (algebraTransition R A B τ hτ)).comp
        (transition01 R A (ModuleCat.of A B) (algebraTransition R A B τ hτ)) =
      transition02 R A (ModuleCat.of A B) (algebraTransition R A B τ hτ)) (b : B) :
    (show restrictModule R A (ModuleCat.of A B) from b) ∈
        invariantSubmodule R A (descentDataOfAlgebra R A B τ hτ hcoc) ↔
      b ∈ descentInvariants R A B τ := by
  rw [mem_descentInvariants_iff]
  exact (algebraTargetEquiv R A B).symm_apply_eq

omit [IsScalarTower R A B] in
/-- **The invariant subalgebra carries the descent datum.** For `c` in the invariants of `τ`
and `a b : A`, the transition `τ` sends `(a • c) ⊗ b` to `a ⊗ (b • c)`: that is, the canonical
map `A ⊗[R] C → B` carries the canonical descent datum of the base change of
`ModuleCat.descentInvariants` to `τ`.

Together with `ModuleCat.bijective_productMap_descentInvariants` this is effectivity of the
algebra descent datum: the descended algebra is `C`, and the identification of its base change
with `B` respects the descent data. Neither the cocycle condition nor faithful flatness is
needed here. -/
theorem transition_smul_descentInvariants (τ : (B ⊗[R] A) ≃ₐ[R] (A ⊗[R] B))
    (hτ : ∀ a b : A, τ (algebraMap A B a ⊗ₜ[R] b) = a ⊗ₜ[R] algebraMap A B b)
    (a b : A) (c : descentInvariants R A B τ) :
    τ ((a • (c : B)) ⊗ₜ[R] b) = a ⊗ₜ[R] (b • (c : B)) := by
  have hc : τ ((c : B) ⊗ₜ[R] (1 : A)) = (1 : A) ⊗ₜ[R] (c : B) := c.2
  rw [show (a • (c : B)) ⊗ₜ[R] b = (algebraMap A B a ⊗ₜ[R] b) * ((c : B) ⊗ₜ[R] (1 : A)) by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, Algebra.smul_def], map_mul, hτ, hc,
    Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← Algebra.smul_def]

/-! ### Effective descent for algebras -/

section FaithfullyFlat

variable [Module.FaithfullyFlat R A]

/-- The invariants of the module descent datum underlying an algebra descent datum are the
invariant subalgebra, as `R`-modules. -/
def descentInvariantsEquiv (τ : (B ⊗[R] A) ≃ₐ[R] (A ⊗[R] B))
    (hτ : ∀ a b : A, τ (algebraMap A B a ⊗ₜ[R] b) = a ⊗ₜ[R] algebraMap A B b)
    (hcoc : (transition12 R A (ModuleCat.of A B) (algebraTransition R A B τ hτ)).comp
        (transition01 R A (ModuleCat.of A B) (algebraTransition R A B τ hτ)) =
      transition02 R A (ModuleCat.of A B) (algebraTransition R A B τ hτ)) :
    (invariantSubmodule R A (descentDataOfAlgebra R A B τ hτ hcoc)) ≃ₗ[R]
      (descentInvariants R A B τ) where
  toFun x := ⟨show B from x.1,
    (mem_invariantSubmodule_descentDataOfAlgebra R A B τ hτ hcoc (show B from x.1)).1 x.2⟩
  invFun y := ⟨show restrictModule R A (ModuleCat.of A B) from y.1,
    (mem_invariantSubmodule_descentDataOfAlgebra R A B τ hτ hcoc y.1).2 y.2⟩
  map_add' _ _ := Subtype.ext rfl
  map_smul' r x := Subtype.ext (IsScalarTower.algebraMap_smul A r (show B from x.1))
  left_inv _ := Subtype.ext rfl
  right_inv _ := Subtype.ext rfl

/-- **Effective descent for algebras along a faithfully flat ring map.** Let `R → A` be
faithfully flat, let `B` be an `A`-algebra and let `τ : B ⊗[R] A ≃ A ⊗[R] B` be an isomorphism
of `A ⊗[R] A`-algebras satisfying the cocycle condition. Then the canonical map from
`A ⊗[R] C` to `B`, where `C` is the `R`-subalgebra `ModuleCat.descentInvariants` of invariants
of `τ`, is bijective.

This is the algebra step in the proof of Stacks 0245: the invariants of the underlying module
descent datum are closed under multiplication because `τ` is a ring homomorphism, and
`ModuleCat.DescentData.invariantsBaseChangeEquiv` (Stacks 023N, part (3)) identifies their base
change to `A` with `B`. -/
theorem bijective_productMap_descentInvariants (τ : (B ⊗[R] A) ≃ₐ[R] (A ⊗[R] B))
    (hτ : ∀ a b : A, τ (algebraMap A B a ⊗ₜ[R] b) = a ⊗ₜ[R] algebraMap A B b)
    (hcoc : (transition12 R A (ModuleCat.of A B) (algebraTransition R A B τ hτ)).comp
        (transition01 R A (ModuleCat.of A B) (algebraTransition R A B τ hτ)) =
      transition02 R A (ModuleCat.of A B) (algebraTransition R A B τ hτ)) :
    Function.Bijective (Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom R A B) (descentInvariants R A B τ).val) := by
  set D := descentDataOfAlgebra R A B τ hτ hcoc with hD
  set e := DescentData.invariantsBaseChangeEquiv R A D with he
  set g := TensorProduct.congr (LinearEquiv.refl R A)
    (descentInvariantsEquiv R A B τ hτ hcoc) with hg
  have key : ∀ x, Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R A B)
      (descentInvariants R A B τ).val (g x) = e x := by
    intro x
    induction x with
    | zero => simp only [map_zero]; rfl
    | add x y hx hy => simp only [map_add, hx, hy]; rfl
    | tmul a c =>
      rw [hg, TensorProduct.congr_tmul, LinearEquiv.refl_apply,
        Algebra.TensorProduct.productMap_apply_tmul, he,
        DescentData.invariantsBaseChangeEquiv_tmul]
      exact (Algebra.smul_def a (show B from c.1)).symm
  have hfe : ⇑(Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom R A B) (descentInvariants R A B τ).val) = e ∘ g.symm := by
    funext y
    have hy := key (g.symm y)
    rwa [LinearEquiv.apply_symm_apply] at hy
  rw [hfe]
  exact e.bijective.comp g.symm.bijective

end FaithfullyFlat

end ModuleCat

end
