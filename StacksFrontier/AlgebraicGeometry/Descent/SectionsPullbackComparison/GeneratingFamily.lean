module

public import StacksFrontier.AlgebraicGeometry.Descent.SectionsPullbackComparison.PullbackSection

/-!
# Pullbacks of sections generate the sections of a pullback over an affine pair

Let `f : Y ⟶ X` be a morphism of schemes and `F` a quasi-coherent `𝒪_X`-module.  Over a
compatible pair of affine opens `U ⊆ X` and `V ⊆ Y` with `V ≤ f⁻¹U`, the sections of `f^*F`
over `V` are `Γ(Y, V) ⊗_{Γ(X, U)} Γ(F, U)`, and the isomorphism sends `1 ⊗ a` to the pullback
of the section `a` (`AlgebraicGeometry.affinePullbackSectionsBaseChangeIso`). Consequently
`Γ(f^*F, V)` is generated, as a module over the functions on `V`, by the pullbacks of the sections
of `F` over `U`.

## Main results

* `AlgebraicGeometry.Scheme.Opens.ι_appLE_top`: restricting a section of `𝒪_X` over `U` to the
  global functions of the open subscheme `U` is the inverse of
  `AlgebraicGeometry.Scheme.Opens.topIso`.
* `CategoryTheory.ModuleCat.ExtendScalars.eq_top_of_tmul_mem` and
  `CategoryTheory.ModuleCat.ExtendScalars.eq_top_of_surjective`: an extension of scalars is
  generated by its pure tensors, and hence a submodule of the target of a surjection out of one
  which contains the images of the tensors `1 ⊗ m` is everything.
* `AlgebraicGeometry.span_pullbackSection_eq_top`: over a compatible pair of affine opens, the
  pullbacks of sections span the sections of the pullback.

## Implementation notes

In the proof of `CategoryTheory.ModuleCat.ExtendScalars.eq_top_of_surjective`, the identity
`s ⊗ m = s • (1 ⊗ m)` is transported on a membership in the *target* of the surjection rather than
rewritten in place: `CategoryTheory.ModuleCat.ExtendScalars.smul_tmul` is stated at an `S`-module
structure built by `Module.compHom`, which agrees with the one coming from
`CategoryTheory.ModuleCat.restrictScalars` only up to unfolding a semireducible definition, so a
`rewrite` whose motive abstracts a subterm of the tensor product is rejected. For the same reason
that lemma takes a morphism of `ModuleCat` rather than a bare linear map.

## References

* [Stacks Project, Tag 03DS](https://stacks.math.columbia.edu/tag/03DS)
* [Stacks Project, Tag 070S](https://stacks.math.columbia.edu/tag/070S)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open scoped AlgebraicGeometry ChangeOfRings

universe u

namespace CategoryTheory.ModuleCat.ExtendScalars

/-- **An extension of scalars is generated by its pure tensors.**  A submodule of `S ⊗_R M`
containing every `s ⊗ m` is everything. -/
public theorem eq_top_of_tmul_mem {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S)
    (M : ModuleCat.{u} R) (Q : Submodule S ↥((ModuleCat.extendScalars φ).obj M))
    (h : ∀ (s : S) (m : M), (s ⊗ₜ[R,φ] m : (ModuleCat.extendScalars φ).obj M) ∈ Q) :
    Q = ⊤ := by
  refine Submodule.eq_top_iff'.2 fun x => ?_
  induction x using TensorProduct.inductionOn with
  | tmul s m => exact h s m
  | add y z hy hz => exact Submodule.add_mem _ hy hz

/-- **A submodule hit by the pure tensors `1 ⊗ m` through a surjection is everything.**  If
`g : S ⊗_R M ⟶ N` is a surjective morphism of `S`-modules and `P` is a submodule of `N`
containing `g (1 ⊗ m)` for every `m`, then `P = ⊤`. -/
public theorem eq_top_of_surjective {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S)
    (M : ModuleCat.{u} R) {N : ModuleCat.{u} S} (g : (ModuleCat.extendScalars φ).obj M ⟶ N)
    (hg : Function.Surjective (ModuleCat.Hom.hom g)) (P : Submodule S N)
    (h : ∀ m : M, ModuleCat.Hom.hom g ((1 : S) ⊗ₜ[R,φ] m :
      (ModuleCat.extendScalars φ).obj M) ∈ P) :
    P = ⊤ := by
  have key : ∀ (s : S) (m : M),
      ModuleCat.Hom.hom g (s ⊗ₜ[R,φ] m : (ModuleCat.extendScalars φ).obj M) ∈ P := by
    intro s m
    have hst := ModuleCat.ExtendScalars.smul_tmul φ s (1 : S) m
    rw [mul_one] at hst
    have heq : ModuleCat.Hom.hom g (s ⊗ₜ[R,φ] m : (ModuleCat.extendScalars φ).obj M)
        = s • ModuleCat.Hom.hom g ((1 : S) ⊗ₜ[R,φ] m :
            (ModuleCat.extendScalars φ).obj M) :=
      (congrArg (ModuleCat.Hom.hom g) hst.symm).trans
        (LinearMap.map_smul (ModuleCat.Hom.hom g) s _)
    exact heq.symm ▸ Submodule.smul_mem P s (h m)
  have hQ := eq_top_of_tmul_mem φ M
    ((Submodule.comap (ModuleCat.Hom.hom g) P :
      Submodule S ↥((ModuleCat.extendScalars φ).obj M))) key
  refine Submodule.eq_top_iff'.2 fun x => ?_
  obtain ⟨t, rfl⟩ := hg x
  exact hQ.ge (Submodule.mem_top (R := S) (x := t))

end CategoryTheory.ModuleCat.ExtendScalars

namespace AlgebraicGeometry

/-- Restricting a section of the structure sheaf over an open `U` to the global functions of the
open subscheme `U` is the inverse of `AlgebraicGeometry.Scheme.Opens.topIso`. -/
public theorem Scheme.Opens.ι_appLE_top {X : Scheme.{u}} (U : X.Opens)
    (h : (⊤ : U.toScheme.Opens) ≤ U.ι ⁻¹ᵁ U) :
    U.ι.appLE U ⊤ h = (Scheme.Opens.topIso U).inv := by
  rw [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_inv]
  exact congrArg X.presheaf.map (Subsingleton.elim _ _)

/-- **Pullbacks of sections generate the sections of a pullback over an affine pair.**  For a
quasi-coherent module `F` on `X`, a morphism `f : Y ⟶ X` and affine opens `U ⊆ X`, `V ⊆ Y` with
`V ≤ f⁻¹U`, the sections of `f^*F` over `V` are generated, as a module over the functions on
`V`, by the pullbacks of the sections of `F` over `U`. -/
public theorem span_pullbackSection_eq_top {X Y : Scheme.{u}} (f : Y ⟶ X) (F : X.Modules)
    [F.IsQuasicoherent] {U : X.Opens} (hU : IsAffineOpen U) {V : Y.Opens} (hV : IsAffineOpen V)
    (hVU : V ≤ f ⁻¹ᵁ U) :
    Submodule.span Γ(Y, V)
        (Set.range fun a : Γ(F, U) => pullbackSectionHom f F U V hVU a) = ⊤ := by
  set P := Submodule.span Γ(Y, V)
    (Set.range fun a : Γ(F, U) => pullbackSectionHom f F U V hVU a)
  set e := affinePullbackSectionsBaseChangeIso f F hU hV hVU
  have hsurj : Function.Surjective (ModuleCat.Hom.hom e.hom) := fun x =>
    ⟨ModuleCat.Hom.hom e.inv x, by simp⟩
  refine ModuleCat.ExtendScalars.eq_top_of_surjective _ _ e.hom hsurj P
    fun a => Submodule.subset_span ⟨a, ?_⟩
  exact (affinePullbackSectionsBaseChangeIso_one_tmul f F hU hV hVU a).symm

end AlgebraicGeometry

end

