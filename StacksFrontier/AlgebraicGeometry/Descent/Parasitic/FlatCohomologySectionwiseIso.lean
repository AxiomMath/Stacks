    Function.Bijective
      (Stacks.Cohomology.LongExactSequence.map.{w}
        ((SheafOfModules.toSheaf 𝒪).map φ) p U) :=
  bigFppfCohomology_map_bijective_of_isParasiticFor B S hS φ
    (isParasiticFor_kernel_of_isIso_sections B S hS φ hφ)
    (isParasiticFor_cokernel_of_isIso_sections B S hS φ hφ) U hU p

