module

public import Mathlib.RingTheory.DualNumber
public import StacksCore.Tactic.StacksAttribute

/-!
# Images and kernels in the ring of dual numbers

Let `k` be a field and let `ε` denote the distinguished square-zero element of the dual-number
ring `k[ε]`. Multiplication by a nonzero scalar multiple of `ε` has both image and kernel equal
to the principal ideal generated by `ε`.

## Main definitions

* `DualNumber.unitMulT` is multiplication by `u ε`, for a unit `u` of `k`.

## Main results

* `DualNumber.range_unitMulT` computes the image of multiplication by `u ε`.
* `DualNumber.ker_unitMulT` computes its kernel.

## Implementation notes

Mathlib's `DualNumber k` represents `k[T]/(T²)`, and `DualNumber.eps` represents `T`. One
universally quantified unit `u` covers both of the maps denoted `φ` and `ψ` in the source.

## References

* [Stacks Project, Tag 02PP](https://stacks.math.columbia.edu/tag/02PP)
-/

@[expose] public section

namespace DualNumber

universe u

/-- Multiplication by `u ε` on the ring of dual numbers, for a unit `u` of the coefficient
field. -/
def unitMulT (k : Type u) [Field k] (u : kˣ) :
    Module.End (DualNumber k) (DualNumber k) :=
  LinearMap.mulLeft (DualNumber k) (algebraMap k (DualNumber k) (u : k) * DualNumber.eps)

/-- Multiplication by `u ε`, computed on components. -/
private lemma unitMulT_apply (k : Type u) [Field k] (u : kˣ) (x : DualNumber k) :
    unitMulT k u x = TrivSqZeroExt.inr ((u : k) * x.fst) := by
  simp [unitMulT, LinearMap.mulLeft_apply, TrivSqZeroExt.algebraMap_eq_inl',
    TrivSqZeroExt.ext_iff]

/-- The image of multiplication by a unit multiple of `ε` is the ideal generated by `ε`. -/
@[stacks 02PP "dual_images_kernels"]
theorem range_unitMulT (k : Type u) [Field k] (u : kˣ) :
    LinearMap.range (unitMulT k u) = Ideal.span {DualNumber.eps} := by
  ext x
  rw [LinearMap.mem_range, Ideal.mem_span_singleton, ← DualNumber.fst_eq_zero_iff_eps_dvd]
  constructor
  · rintro ⟨y, rfl⟩
    simp [unitMulT_apply]
  · intro hx
    refine ⟨TrivSqZeroExt.inl ((u : k)⁻¹ * x.snd), ?_⟩
    apply TrivSqZeroExt.ext <;> simp [unitMulT_apply, hx]

/-- The kernel of multiplication by a unit multiple of `ε` is the ideal generated by `ε`. -/
@[stacks 02PP "dual_images_kernels"]
theorem ker_unitMulT (k : Type u) [Field k] (u : kˣ) :
    LinearMap.ker (unitMulT k u) = Ideal.span {DualNumber.eps} := by
  ext x
  simp [LinearMap.mem_ker, Ideal.mem_span_singleton, ← DualNumber.fst_eq_zero_iff_eps_dvd,
    unitMulT_apply, TrivSqZeroExt.ext_iff, u.ne_zero]

end DualNumber
