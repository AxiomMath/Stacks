/-!
# Colength of an injection between modules filtered by a prime quotient

Let `q` be a prime of a Noetherian local ring with `R / q` of dimension one, and let `M` and `N`
be finite modules generated by sequences of the same length whose successive quotients are
copies of `R / q`. An injection `φ : M → N` has colength the order of the scalar comparing the
determinant symbol of the localized image sequence with that of the localized target sequence.

## Main results

* `Module.FiniteLength.exists_symbol_scalar_length_quotient_range_eq_order` produces the
  comparison scalar together with the symbol identity defining it, and identifies the colength
  of the image with its order.
* `Module.FiniteLength.localized_length_of_generating` computes the localized length of a
  module from the number of terms of such a generating sequence.
* `Module.FiniteLength.admissible_localized_map` and
  `Module.FiniteLength.span_localized_map_mk_eq_top` present the localized image of such a
  sequence as a generating admissible sequence.

## Implementation notes

Successive quotients use the subquotient presentation of Tags 02QB and 02QC. Localization is
represented by `LocalizedModule`, and the length formula of Tag 02QB expects the localized
sequences as explicit admissible sequences whose index type is `Fin` of the localized length;
reindexing along that length equality is what `Fin.cast` provides. The order of the resulting
nonzero scalar is expressed by `Ring.ordFrac`.

## References

* [Stacks Project, Tag 02QB](https://stacks.math.columbia.edu/tag/02QB)
-/

@[expose] public section

noncomputable section

namespace Module.FiniteLength

universe u v w

/-! ### Scalars moving an entry into the span of its predecessors -/

/-- When the quotient cut out by one entry over a submodule is `R / q`, every element of `q`
carries that entry into the submodule. -/
public theorem smul_mem_of_quotEquiv_quotient_prime
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
    (U : Submodule R M) (z : M) (q : Ideal R)
    (e : ((U ⊔ R ∙ z : Submodule R M) ⧸ U.submoduleOf (U ⊔ R ∙ z)) ≃ₗ[R] R ⧸ q)
    {a : R} (ha : a ∈ q) : a • z ∈ U := by
  have hann : Module.annihilator R ((U ⊔ R ∙ z : Submodule R M) ⧸
      U.submoduleOf (U ⊔ R ∙ z)) = q :=
    e.annihilator_eq.trans Ideal.annihilator_quotient
  have hz : z ∈ (U ⊔ R ∙ z : Submodule R M) :=
    Submodule.mem_sup_right (Submodule.mem_span_singleton_self z)
  have hsmul := Module.mem_annihilator.mp (hann.ge ha)
    ((U.submoduleOf (U ⊔ R ∙ z)).mkQ ⟨z, hz⟩)
  rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hsmul
  exact hsmul

/-- For a sequence whose successive quotients are `R / q`, every element of `q` carries each
entry into the span of its predecessors. -/
public theorem smul_mem_spanBefore_of_quotEquiv
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
    {l : ℕ} (q : Ideal R) (x : Fin l → M)
    (hxf : ∀ i : Fin l,
      Nonempty
        (((spanBefore (R := R) x i ⊔ R ∙ x i : Submodule R M) ⧸
            (spanBefore (R := R) x i).comap
              (spanBefore (R := R) x i ⊔ R ∙ x i : Submodule R M).subtype) ≃ₗ[R]
          R ⧸ q))
    (i : Fin l) {r : R} (hr : r ∈ q) : r • x i ∈ spanBefore (R := R) x i :=
  smul_mem_of_quotEquiv_quotient_prime _ _ q (hxf i).some hr

/-! ### Localized lengths of sequences with prime successive quotients -/

/-- A module generated by a sequence with successive quotients `R / q` has finite length after
localizing at `q`. -/
public theorem isFiniteLength_localized_of_span_eq_top
    {R : Type u} [CommRing R] (q : Ideal R) [q.IsPrime]
    {M : Type v} [AddCommGroup M] [Module R M] {l : ℕ} (x : Fin l → M)
    (hx : Submodule.span R (Set.range x) = ⊤)
    (hxf : ∀ i : Fin l,
      Nonempty
        (((spanBefore (R := R) x i ⊔ R ∙ x i : Submodule R M) ⧸
            (spanBefore (R := R) x i).comap
              (spanBefore (R := R) x i ⊔ R ∙ x i : Submodule R M).subtype) ≃ₗ[R]
          R ⧸ q)) :
    IsFiniteLength (Localization.AtPrime q) (LocalizedModule q.primeCompl M) :=
  Module.length_ne_top_iff.mp
    (by rw [localized_length_of_generating q x hx hxf]; exact ENat.natCast_ne_top _)

/-! ### Localized generating admissible sequences -/

/-- If a map is surjective after localizing, the localized images of a generating family
generate the localized target. -/
public theorem span_localized_map_mk_eq_top
    {R : Type u} [CommRing R] {M : Type v} {N : Type w}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (S : Submonoid R) {ι : Type*} (x : ι → M)
    (hx : Submodule.span R (Set.range x) = ⊤) (φ : M →ₗ[R] N)
    (hφ : Function.Surjective (LocalizedModule.map S φ)) :
    Submodule.span (Localization S)
      (Set.range (fun i ↦ LocalizedModule.mk (φ (x i)) (1 : S))) = ⊤ := by
  have h := congrArg (Submodule.map (LocalizedModule.map S φ))
    (span_localized_generators_eq_top S x hx)
  rw [Submodule.map_span, ← Set.range_comp, Submodule.map_top,
    LinearMap.range_eq_top.mpr hφ] at h
  simpa only [Function.comp_def, LocalizedModule.map_mk] using h

/-- The span of the terms of a sequence preceding an index is carried by a linear map to the
corresponding span for the image sequence. -/
public theorem spanBefore_comp
    {R : Type u} [CommRing R] {M : Type v} {N : Type w}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {l : ℕ} (x : Fin l → M) (φ : M →ₗ[R] N) (i : Fin l) :
    spanBefore (R := R) (φ ∘ x) i = Submodule.map φ (spanBefore (R := R) x i) := by
  rw [spanBefore, spanBefore, Submodule.map_span, Set.image_comp]

/-- Reindexing along an equality of lengths preserves admissibility of the localized sequence. -/
public theorem isAdmissibleSequence_localized_mk_cast
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    {l n : ℕ} (h : n = l) (q : Ideal R) [q.IsPrime] (x : Fin l → M)
    (hx : ∀ i r, r ∈ q → r • x i ∈ spanBefore (R := R) x i) :
    IsAdmissibleSequence (R := Localization.AtPrime q)
      (fun i : Fin n ↦ LocalizedModule.mk (x (Fin.cast h i)) (1 : q.primeCompl)) := by
  subst h
  exact admissible_localized q x hx

/-- Reindexing along an equality of lengths preserves admissibility of the localized image
sequence. -/
public theorem isAdmissibleSequence_localized_map_mk_cast
    {R : Type u} [CommRing R] {M : Type v} {N : Type w}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {l n : ℕ} (h : n = l) (q : Ideal R) [q.IsPrime] (x : Fin l → M)
    (hx : ∀ i r, r ∈ q → r • x i ∈ spanBefore (R := R) x i) (φ : M →ₗ[R] N) :
    IsAdmissibleSequence (R := Localization.AtPrime q)
      (fun i : Fin n ↦ LocalizedModule.mk (φ (x (Fin.cast h i))) (1 : q.primeCompl)) := by
  subst h
  exact admissible_localized_map q x hx φ

/-- Reindexing a generating sequence along an equality of lengths keeps its localized terms
generating. -/
public theorem span_localized_mk_cast_eq_top
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    {l n : ℕ} (h : n = l) (S : Submonoid R) (x : Fin l → M)
    (hx : Submodule.span R (Set.range x) = ⊤) :
    Submodule.span (Localization S)
      (Set.range (fun i : Fin n ↦ LocalizedModule.mk (x (Fin.cast h i)) (1 : S))) = ⊤ := by
  subst h
  exact span_localized_generators_eq_top S x hx

/-- Reindexing a generating sequence along an equality of lengths keeps the localized terms of
its image under a linear map generating. -/
public theorem span_localized_map_mk_cast_eq_top
    {R : Type u} [CommRing R] {M : Type v} {N : Type w}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {l n : ℕ} (h : n = l) (S : Submonoid R) (x : Fin l → M)
    (hx : Submodule.span R (Set.range x) = ⊤) (φ : M →ₗ[R] N)
    (hφ : Function.Surjective (LocalizedModule.map S φ)) :
    Submodule.span (Localization S)
      (Set.range (fun i : Fin n ↦ LocalizedModule.mk (φ (x (Fin.cast h i))) (1 : S))) = ⊤ := by
  subst h
  exact span_localized_map_mk_eq_top S x hx φ hφ

/-! ### The colength of an injection -/

/-- **Stacks Project, Tag 02QB.** For an injection between finite modules each generated by a
sequence of `l` terms with successive quotients `R / q`, there is a nonzero scalar comparing the
determinant symbols of the two localized sequences at `q`, and the colength of the image is the
order of that scalar. -/
@[stacks 02QB "colength of an injection"]
public theorem exists_symbol_scalar_length_quotient_range_eq_order
    {R : Type u} {M : Type v} {N : Type w} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N]
    (q : Ideal R) [q.IsPrime] (hdim : ringKrullDim (R ⧸ q) = 1)
    (l : ℕ) (x : Fin l → M) (y : Fin l → N)
    (hx : Submodule.span R (Set.range x) = ⊤)
    (hxf : ∀ i : Fin l,
      Nonempty
        (((spanBefore (R := R) x i ⊔ R ∙ x i : Submodule R M) ⧸
            (spanBefore (R := R) x i).comap
              (spanBefore (R := R) x i ⊔ R ∙ x i : Submodule R M).subtype) ≃ₗ[R]
          R ⧸ q))
    (hy : Submodule.span R (Set.range y) = ⊤)
    (hyf : ∀ i : Fin l,
      Nonempty
        (((spanBefore (R := R) y i ⊔ R ∙ y i : Submodule R N) ⧸
            (spanBefore (R := R) y i).comap
              (spanBefore (R := R) y i ⊔ R ∙ y i : Submodule R N).subtype) ≃ₗ[R]
          R ⧸ q))
    (φ : M →ₗ[R] N) (hφ : Function.Injective φ) :
    letI : Ring.KrullDimLE 1 (R ⧸ q) := Ring.krullDimLE_iff.mpr hdim.le
    ∃ hlen : moduleLength (Localization.AtPrime q) (LocalizedModule q.primeCompl N) = l,
      ∃ hadmφ : IsAdmissibleSequence (R := Localization.AtPrime q)
          (fun i ↦ LocalizedModule.mk (φ (x (Fin.cast hlen i))) (1 : q.primeCompl)),
        ∃ hadmy : IsAdmissibleSequence (R := Localization.AtPrime q)
            (fun i ↦ LocalizedModule.mk (y (Fin.cast hlen i)) (1 : q.primeCompl)),
          ∃ f : IsLocalRing.ResidueField (Localization.AtPrime q), ∃ hf : f ≠ 0,
            symbol (⟨_, hadmφ⟩ :
                AdmissibleSequence (Localization.AtPrime q)
                  (LocalizedModule q.primeCompl N)) =
                f • symbol (⟨_, hadmy⟩ :
                  AdmissibleSequence (Localization.AtPrime q)
                    (LocalizedModule q.primeCompl N)) ∧
              ((Module.length R (N ⧸ LinearMap.range φ)).toNat : ℤ) =
                Multiplicative.toAdd (WithZero.unzero
                  (x := Ring.ordFrac (R ⧸ q) f)
                  ((hf.isUnit.map (Ring.ordFrac (R ⧸ q))).ne_zero)) := by
  classical
  let : Ring.KrullDimLE 1 (R ⧸ q) := Ring.krullDimLE_iff.mpr hdim.le
  have hlen : moduleLength (Localization.AtPrime q) (LocalizedModule q.primeCompl N) = l := by
    change (Module.length (Localization.AtPrime q) (LocalizedModule q.primeCompl N)).toNat = l
    rw [localized_length_of_generating q y hy hyf]
    simp
  have hbij := (injective_iff_localizedMap_bijective_of_prime_filtrations
    q l x y hx hxf hy hyf φ).mp hφ
  have hadmφ : IsAdmissibleSequence (R := Localization.AtPrime q)
      (fun i ↦ LocalizedModule.mk (φ (x (Fin.cast hlen i))) (1 : q.primeCompl)) :=
    isAdmissibleSequence_localized_map_mk_cast hlen q x
      (fun i _ hr ↦ smul_mem_spanBefore_of_quotEquiv q x hxf i hr) φ
  have hadmy : IsAdmissibleSequence (R := Localization.AtPrime q)
      (fun i ↦ LocalizedModule.mk (y (Fin.cast hlen i)) (1 : q.primeCompl)) :=
    isAdmissibleSequence_localized_mk_cast hlen q y
      (fun i _ hr ↦ smul_mem_spanBefore_of_quotEquiv q y hyf i hr)
  have hfinN : IsFiniteLength (Localization.AtPrime q) (LocalizedModule q.primeCompl N) :=
    isFiniteLength_localized_of_span_eq_top q y hy hyf
  have hspanN : Submodule.span (Localization.AtPrime q)
      (Set.range (⟨_, hadmy⟩ : AdmissibleSequence (Localization.AtPrime q)
        (LocalizedModule q.primeCompl N)).1) = ⊤ :=
    span_localized_mk_cast_eq_top hlen q.primeCompl y hy
  have hspanφ : Submodule.span (Localization.AtPrime q)
      (Set.range (⟨_, hadmφ⟩ : AdmissibleSequence (Localization.AtPrime q)
        (LocalizedModule q.primeCompl N)).1) = ⊤ :=
    span_localized_map_mk_cast_eq_top hlen q.primeCompl x hx φ hbij.2
  have hmem := (span_symbol_eq_top hfinN
    (⟨_, hadmy⟩ : AdmissibleSequence (Localization.AtPrime q)
      (LocalizedModule q.primeCompl N)) hspanN).ge
    (Submodule.mem_top (x := symbol (⟨_, hadmφ⟩ :
      AdmissibleSequence (Localization.AtPrime q) (LocalizedModule q.primeCompl N))))
  obtain ⟨f, hfeq⟩ := Submodule.mem_span_singleton.mp hmem
  have hf : f ≠ 0 := by
    rintro rfl
    exact symbol_ne_zero_of_generating hfinN ⟨_, hadmφ⟩ hspanφ
      (by rw [← hfeq, zero_smul])
  exact ⟨hlen, hadmφ, hadmy, f, hf, hfeq.symm,
    length_coker_eq_order_determinant_scalar q hdim l x y hx hxf hy hyf φ hφ
      ⟨_, hadmφ⟩ ⟨_, hadmy⟩ hlen (fun _ ↦ rfl) (fun _ ↦ rfl) f hf hfeq.symm⟩

end Module.FiniteLength
