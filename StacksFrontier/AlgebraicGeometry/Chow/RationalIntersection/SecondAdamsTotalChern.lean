module

public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.ChernCommutation
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.TotalChernWhitney
public import StacksFrontier.AlgebraicGeometry.Chow.RationalIntersection.SecondAdamsChernCharacter
public import StacksCore.Tactic.StacksAttribute

/-!
# The total Chern class on `K_0(Vect(X))` and the second Adams operation

Let `(S, δ)` be the base situation of chapter 42 of the Stacks Project and let `X` be locally of
finite type over `S`. Remark 0FEL: the total Chern class `c(ℰ) = 1 + c_1(ℰ) + c_2(ℰ) + ⋯ ∈
∏_{i ≥ 0} A^i(X)` extends multiplicatively to a map `c : K_0(Vect(X)) ⟶ ∏_{i ≥ 0} A^i(X)`, well
defined by the Whitney sum formula (Stacks 02UI). Lemma 0FEN, first equation:
`c_i(ψ²(α)) = 2^i c_i(α)` for every `α ∈ K_0(Vect(X))`.

This file constructs `c` on `K_0(Vect(X))`, for finite locally free modules of arbitrary rank,
and proves the first equation of Stacks 0FEN.

## The construction

The total Chern classes `c(ℰ)` of finite locally free modules are units of the ring
`∏_{i ≥ 0} A^i(X)` (`Stacks.Chow.isUnit_totalChernOfFiniteLocallyFree`) which commute with each
other (on the loci where both ranks are constant this is Stacks 0FDZ / 02UI). So the subgroup of
units they generate is commutative, and the Whitney sum formula for modules of arbitrary rank
(`Stacks.Chow.totalChernOfFiniteLocallyFree_eq_mul_of_shortExact`) makes `ℰ ↦ c(ℰ)` descend to
`K_0(Vect(X))`.

## The proof of the first equation of Stacks 0FEN

The scaling `s` multiplying `A^i(X)` by `2^i` is a ring endomorphism of `∏_{i ≥ 0} A^i(X)`, and
both `α ↦ c(ψ²(α))` and `α ↦ s(c(α))` are multiplicative, so it suffices to treat the class of a
finite locally free module `ℰ`. Restriction commutes with `c`, with `s` and (through pullback)
with `ψ²`; over the rank loci of `ℰ` and along the splitting morphisms of Stacks 02UL the module
is filtered with invertible quotients `ℒ_j`, and `c(ℰ) = ∏ c(ℒ_j)`, `ψ²[ℰ] = ∑ [ℒ_j ⊗ ℒ_j]`. For
an invertible `ℒ`, `c(ℒ) = 1 + c_1(ℒ)` and `c_1(ℒ ⊗ ℒ) = 2c_1(ℒ)`, i.e. `c(ℒ ⊗ ℒ) = s(c(ℒ))`.

## Main definitions

* `Stacks.Chow.totalChernKClass` — `c : K_0(Vect(X)) ⟶ ∏_{i ≥ 0} A^i(X)`.
* `Stacks.Chow.TotalChowClass.twoScale` — the ring endomorphism scaling `A^i(X)` by `2^i`.

## Main results

* `Stacks.Chow.totalChernKClass_classOf`, `Stacks.Chow.totalChernKClass_add` — Remark 0FEL.
* `Stacks.Chow.totalChernKClass_secondAdams` — **Stacks 0FEN, the first equation**.

## References

* [Stacks Project, Tag 0FEL](https://stacks.math.columbia.edu/tag/0FEL)
* [Stacks Project, Tag 0FEN](https://stacks.math.columbia.edu/tag/0FEN)
* [Stacks Project, Tag 02UI](https://stacks.math.columbia.edu/tag/02UI)
* [Stacks Project, Tag 02UL](https://stacks.math.columbia.edu/tag/02UL)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Finset
open AlgebraicGeometry.VectorBundleKZero

universe u

namespace Stacks.Chow

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

/-! ### Total Chern classes of modules of arbitrary rank commute -/

/-- **The total Chern classes of two finite locally free modules commute**, the ranks being
arbitrary: on the loci where both ranks are constant this is `Stacks.Chow.commute_totalChern`. -/
theorem commute_totalChernOfFiniteLocallyFree (E F : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} F] :
    Commute (totalChernOfFiniteLocallyFree C sX E) (totalChernOfFiniteLocallyFree C sX F) := by
  refine TotalChowClass.eq_of_res_eq_of_constantRank₂ C sX E F
    fun {T sT _} g _ hs r s hr hs' ↦ ?_
  have := hr
  have := hs'
  rw [map_mul, map_mul, res_totalChernOfFiniteLocallyFree_of_rank C sX E g hs r,
    res_totalChernOfFiniteLocallyFree_of_rank C sX F g hs s]
  exact (commute_totalChern C sT _ _ r s).eq

/-! ### The total Chern class on `K_0(Vect(X))` -/

/-- The total Chern class of a finite locally free module, as a unit. -/
def totalChernUnitOf (E : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] :
    (TotalChowClass C sX)ˣ :=
  (isUnit_totalChernOfFiniteLocallyFree C sX E).unit

/-- The total Chern classes of the finite locally free modules, as units. -/
def totalChernUnits : Set (TotalChowClass C sX)ˣ :=
  {u | ∃ (E : X.Modules) (_ : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E),
    u = totalChernUnitOf C sX E}

/-- The subgroup of units generated by the total Chern classes of finite locally free modules;
it is commutative. -/
abbrev totalChernUnitsSubgroup : Subgroup (TotalChowClass C sX)ˣ :=
  Subgroup.closure (totalChernUnits C sX)

/-- The subgroup generated by the total Chern classes of finite locally free modules is a
commutative group. -/
instance : CommGroup (totalChernUnitsSubgroup C sX) :=
  have h : IsMulCommutative (totalChernUnitsSubgroup C sX) :=
    Subgroup.isMulCommutative_closure fun x hx y hy _ => by
      obtain ⟨E, hE, rfl⟩ := hx
      obtain ⟨F, hF, rfl⟩ := hy
      exact Units.ext (commute_totalChernOfFiniteLocallyFree C sX E F).eq
  { (inferInstance : Group (totalChernUnitsSubgroup C sX)) with
    mul_comm := h.is_comm.comm }

open Classical in
/-- `ℰ ↦ c(ℰ)` on modules, `1` off the finite locally free ones, in additive notation. -/
def totalChernUnitsKFun (M : X.Modules) : Additive (totalChernUnitsSubgroup C sX) :=
  if _h : Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M then
    Additive.ofMul ⟨totalChernUnitOf C sX M, Subgroup.subset_closure ⟨M, inferInstance, rfl⟩⟩
  else 0

/-- On a finite locally free module `M`, `totalChernUnitsKFun` is the unit `c(M)`. -/
theorem totalChernKFun_eq (M : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} M] :
    ((Additive.toMul (totalChernUnitsKFun C sX M) : totalChernUnitsSubgroup C sX) :
      (TotalChowClass C sX)ˣ) = totalChernUnitOf C sX M := by
  rw [totalChernUnitsKFun, dite_eq_left
    (AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.toFiniteLocallyFree M inferInstance)]
  rfl

/-- **Remark 0FEL: the total Chern class on `K_0(Vect(X))`**, as a homomorphism to the
commutative group of units generated by the total Chern classes; well defined by the Whitney sum
formula. -/
def totalChernUnitsKHom : VectorBundleKZero X →+ Additive (totalChernUnitsSubgroup C sX) :=
  liftAddHom (totalChernUnitsKFun C sX) (fun M hM => dite_eq_right hM)
    (fun {E F G} f g w hE hF hG _ _ hex => by
      apply Additive.toMul.injective
      refine Subtype.ext (Units.ext ?_)
      rw [toMul_add, Subgroup.coe_mul, Units.val_mul, totalChernKFun_eq, totalChernKFun_eq,
        totalChernKFun_eq]
      exact totalChernOfFiniteLocallyFree_eq_mul_of_shortExact C sX (ShortComplex.mk f g w)
        { exact := hex })

/-- **The total Chern class `c(α) ∈ ∏_{i ≥ 0} A^i(X)` of `α ∈ K_0(Vect(X))`** (Remark 0FEL). -/
def totalChernKClass (a : VectorBundleKZero X) : TotalChowClass C sX :=
  ((Additive.toMul (totalChernUnitsKHom C sX a) : totalChernUnitsSubgroup C sX) :
    (TotalChowClass C sX)ˣ)

/-- `c([ℰ]) = c(ℰ)`. -/
theorem totalChernKClass_classOf (E : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] :
    totalChernKClass C sX (classOf X E) = totalChernOfFiniteLocallyFree C sX E := by
  rw [totalChernKClass,
    show totalChernUnitsKHom C sX (classOf X E) = totalChernUnitsKFun C sX E from
      liftAddHom_classOf _ _ _ E, totalChernKFun_eq]
  rfl

/-- `c(α + β) = c(α) c(β)`. -/
theorem totalChernKClass_add (a b : VectorBundleKZero X) :
    totalChernKClass C sX (a + b) = totalChernKClass C sX a * totalChernKClass C sX b := by
  rw [totalChernKClass, map_add, toMul_add, Subgroup.coe_mul, Units.val_mul]
  rfl

/-- `c(0) = 1`. -/
theorem totalChernKClass_zero : totalChernKClass C sX 0 = 1 := by
  rw [totalChernKClass, map_zero, toMul_zero, OneMemClass.coe_one, Units.val_one]

/-- The total Chern class `c(α)` is a unit. -/
theorem isUnit_totalChernKClass (a : VectorBundleKZero X) : IsUnit (totalChernKClass C sX a) :=
  Units.isUnit _

/-- `c(-α) c(α) = 1`. -/
theorem totalChernKClass_neg_mul (a : VectorBundleKZero X) :
    totalChernKClass C sX (-a) * totalChernKClass C sX a = 1 := by
  rw [← totalChernKClass_add, neg_add_cancel, totalChernKClass_zero]

/-- An identity between multiplicative invariants of classes may be checked on the classes of
finite locally free modules. -/
theorem induction_on_classOf {P : VectorBundleKZero X → Prop} (a : VectorBundleKZero X)
    (hclass : ∀ (M : X.Modules), AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} M →
      P (classOf X M))
    (hzero : P 0) (hadd : ∀ a b, P a → P b → P (a + b)) (hneg : ∀ a, P a → P (-a)) : P a := by
  induction a using QuotientAddGroup.induction_on with
  | H z =>
    induction z using FreeAbelianGroup.induction_on with
    | zero => exact hzero
    | of M =>
      by_cases hM : Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M
      · exact hclass M hM
      · change P (classOf X M)
        rw [classOf_eq_zero_of_not_isFiniteLocallyFree M hM]
        exact hzero
    | neg z hz =>
      rw [QuotientAddGroup.mk_neg]
      exact hneg _ hz
    | add z z' hz hz' =>
      rw [QuotientAddGroup.mk_add]
      exact hadd _ _ hz hz'

/-- Two inverses of the same unit (on the right) agree. -/
private theorem eq_of_mul_eq_one_of_isUnit {M : Type*} [Monoid M] {x y z : M} (hz : IsUnit z)
    (hx : x * z = 1) (hy : y * z = 1) : x = y :=
  hz.mul_left_injective (hx.trans hy.symm)

/-- **Restriction commutes with `c`**: `res_h c(α) = c(h^*α)`. -/
theorem res_totalChernKClass {T : Scheme.{u}} {sT : T ⟶ C.S} [LocallyOfFiniteType sT]
    (h : T ⟶ X) [LocallyOfFiniteType h] (hs : h ≫ sX = sT) (a : VectorBundleKZero X) :
    TotalChowClass.res h hs (totalChernKClass C sX a) =
      totalChernKClass C sT (VectorBundleKZero.pullback h a) := by
  refine induction_on_classOf (P := fun a => TotalChowClass.res h hs (totalChernKClass C sX a) =
      totalChernKClass C sT (VectorBundleKZero.pullback h a)) a (fun M hM => ?_) ?_
    (fun a b ha hb => ?_) (fun a ha => ?_)
  · have := isFiniteLocallyFree_pullbackObj M h
    rw [totalChernKClass_classOf, pullback_classOf, totalChernKClass_classOf,
      res_totalChernOfFiniteLocallyFree]
  · rw [totalChernKClass_zero, map_one, map_zero, totalChernKClass_zero]
  · rw [totalChernKClass_add, map_mul, ha, hb, map_add, totalChernKClass_add]
  · have h1 := congrArg (TotalChowClass.res h hs) (totalChernKClass_neg_mul C sX a)
    rw [map_mul, map_one, ha] at h1
    have h2 := totalChernKClass_neg_mul C sT (VectorBundleKZero.pullback h a)
    rw [map_neg]
    exact eq_of_mul_eq_one_of_isUnit (isUnit_totalChernKClass C sT _) h1 h2

/-! ### The scaling of `∏_{i ≥ 0} A^i(X)` -/

namespace TotalChowClass

variable {C sX}

/-- **The scaling `s` of `∏_{i ≥ 0} A^i(X)`**, multiplying `A^i(X)` by `2^i`, the map of the
source's proof of Stacks 0FEN, as an additive map; `Stacks.Chow.TotalChowClass.twoScale` is the
ring endomorphism. -/
def twoScaleHom : TotalChowClass C sX →+ TotalChowClass C sX where
  toFun c := (show TotalChowClass C sX from fun p => (2 ^ p : ℤ) • c p)
  map_zero' := ext fun p => by
    change (2 ^ p : ℤ) • (0 : TotalChowClass C sX) p = 0
    rw [zero_apply, smul_zero]
  map_add' c d := ext fun p => by
    change (2 ^ p : ℤ) • (c + d) p = (2 ^ p : ℤ) • c p + (2 ^ p : ℤ) • d p
    rw [add_apply, smul_add]

/-- The degree-`p` component of `s(c)` is `2^p c_p`. -/
theorem twoScaleHom_apply (c : TotalChowClass C sX) (p : ℕ) :
    twoScaleHom c p = (2 ^ p : ℤ) • c p :=
  rfl

/-- The degree-`m` homogeneous component of `s(c)` is `2^m` times that of `c`. -/
theorem homComponent_twoScaleHom (m : ℕ) (c : TotalChowClass C sX) :
    homComponent m (twoScaleHom c) = (2 ^ m : ℤ) • homComponent m c := by
  refine ext fun p => ?_
  change homComponent m (twoScaleHom c) p = (2 ^ m : ℤ) • homComponent m c p
  rw [homComponent_apply, homComponent_apply, twoScaleHom_apply]
  split_ifs with hp
  · rw [hp]
  · rw [smul_zero]

/-- A total class is determined by its homogeneous components. -/
theorem ext_homComponent {c d : TotalChowClass C sX}
    (h : ∀ m, homComponent m c = homComponent m d) :
    c = d := ext fun p => by
  simpa [homComponent_apply] using
    congrFun (congrArg (fun x : TotalChowClass C sX => (x : ∀ q, _)) (h p)) p

/-- **The scaling of `∏_{i ≥ 0} A^i(X)` is a ring endomorphism**: in degree `m` of a product the
summands `c_{m-j} d_j` acquire `2^{m-j} 2^j = 2^m`. -/
def twoScale : TotalChowClass C sX →+* TotalChowClass C sX where
  __ := twoScaleHom
  map_one' := ext fun p => by
    change (2 ^ p : ℤ) • (1 : TotalChowClass C sX) p = (1 : TotalChowClass C sX) p
    rcases eq_or_ne p 0 with rfl | hp
    · rw [pow_zero, one_smul]
    · rw [one_apply_of_ne hp, smul_zero]
  map_mul' c d := ext_homComponent fun m => by
    change homComponent m (twoScaleHom (c * d)) =
      homComponent m (twoScaleHom c * twoScaleHom d)
    rw [homComponent_twoScaleHom, homComponent_mul, homComponent_mul, Finset.smul_sum]
    refine Finset.sum_congr rfl fun j hj => ?_
    have hjm : j ≤ m := Nat.lt_succ_iff.mp (mem_range.mp hj)
    rw [homComponent_twoScaleHom, homComponent_twoScaleHom, smul_mul_smul_comm, ← pow_add,
      Nat.sub_add_cancel hjm]

/-- The degree-`p` component of `s(c)` is `2^p c_p`. -/
theorem twoScale_apply (c : TotalChowClass C sX) (p : ℕ) : twoScale c p = (2 ^ p : ℤ) • c p :=
  rfl

/-- On a class homogeneous of degree one the scaling is multiplication by `2`. -/
theorem twoScale_of_isHomogeneous_one {c : TotalChowClass C sX} (hc : IsHomogeneous 1 c) :
    twoScale c = (2 : ℤ) • c := ext fun p => by
  rw [twoScale_apply]
  change (2 ^ p : ℤ) • c p = (2 : ℤ) • c p
  rcases eq_or_ne p 1 with rfl | hp
  · rw [pow_one]
  · rw [hc p hp, smul_zero, smul_zero]

/-- **Restriction commutes with the scaling.** -/
theorem res_twoScale {T : Scheme.{u}} {sT : T ⟶ C.S} [LocallyOfFiniteType sT] (h : T ⟶ X)
    [LocallyOfFiniteType h] (hs : h ≫ sX = sT) (c : TotalChowClass C sX) :
    res h hs (twoScale c) = twoScale (res h hs c) := ext fun p => by
  rw [twoScale_apply, res_apply_eq_chowCohomologyRestrictionOfEq, twoScale_apply,
    res_apply_eq_chowCohomologyRestrictionOfEq, map_zsmul]

/-- A total class with vanishing components above degree one and degree-`0` component `1` is
`1 + c_1`. -/
theorem eq_one_add_homComponent_one {c : TotalChowClass C sX} (h0 : homComponent 0 c = 1)
    (h2 : ∀ j, 1 < j → homComponent j c = 0) : c = 1 + homComponent 1 c :=
  ext_homComponent fun m => by
    rw [map_add, homComponent_one]
    rcases Nat.lt_or_ge m 2 with hm | hm
    · interval_cases m
      · rw [h0, ite_eq_left rfl, homComponent_apply_self_zero, add_zero]
      · rw [ite_eq_right one_ne_zero, zero_add]
        exact (homComponent_homComponent_self 1 c).symm
    · rw [h2 m (by omega), ite_eq_right (by omega), zero_add,
        homComponent_homComponent_of_ne (by omega)]
where
  homComponent_apply_self_zero : homComponent 0 (homComponent 1 c) = 0 :=
    homComponent_homComponent_of_ne (by omega)
  homComponent_homComponent_self (i : ℕ) (c : TotalChowClass C sX) :
      homComponent i (homComponent i c) = homComponent i c :=
    ext fun p => by
      rw [homComponent_apply, homComponent_apply]
      split_ifs <;> rfl
  homComponent_homComponent_of_ne {i j : ℕ} (hij : i ≠ j) :
      homComponent i (homComponent j c) = 0 :=
    ext fun p => by
      rw [homComponent_apply, homComponent_apply, zero_apply]
      split_ifs with h1 h2
      · exact absurd (h1.symm.trans h2) hij
      · rfl
      · rfl

end TotalChowClass

open TotalChowClass

/-! ### Stacks 0FEN, the first equation -/

variable {C sX}

/-- **The total Chern class of a module of rank one is `1 + c_1`**, with `c_1 = P_1`. -/
theorem totalChernOfFiniteLocallyFree_eq_one_add_of_rank_one (M : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M 1]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} M] :
    totalChernOfFiniteLocallyFree C sX M = 1 + powerSumOfFiniteLocallyFree C sX M 1 := by
  rw [totalChernOfFiniteLocallyFree_eq_totalChern C sX M 1,
    powerSumOfFiniteLocallyFree_eq_powerSumTotal C sX M 1, powerSumTotal_of_rank_one, pow_one]
  exact TotalChowClass.eq_one_add_homComponent_one (homPart_zero_totalChern C sX M 1)
    fun j hj => homPart_totalChern_of_lt C sX M 1 hj

/-- The identity `c(ψ²(α)) = s(c(α))` for one class `α`. -/
def SecondAdamsTotalChern (a : VectorBundleKZero X) : Prop :=
  totalChernKClass C sX (secondAdamsRingHom (squarePowersData X) a) =
    twoScale (totalChernKClass C sX a)

/-- If `c(ψ²(α)) = s(c(α))` and `c(ψ²(β)) = s(c(β))`, then `c(ψ²(α + β)) = s(c(α + β))`. -/
theorem SecondAdamsTotalChern.add {a b : VectorBundleKZero X}
    (ha : SecondAdamsTotalChern (C := C) (sX := sX) a)
    (hb : SecondAdamsTotalChern (C := C) (sX := sX) b) :
    SecondAdamsTotalChern (C := C) (sX := sX) (a + b) := by
  unfold SecondAdamsTotalChern at *
  rw [map_add, totalChernKClass_add, ha, hb, totalChernKClass_add, map_mul]

/-- `c(ψ²(0)) = s(c(0))`. -/
theorem secondAdamsTotalChern_zero : SecondAdamsTotalChern (C := C) (sX := sX) 0 := by
  unfold SecondAdamsTotalChern
  rw [map_zero, totalChernKClass_zero, map_one]

/-- If `c(ψ²(α)) = s(c(α))`, then `c(ψ²(-α)) = s(c(-α))`. -/
theorem SecondAdamsTotalChern.neg {a : VectorBundleKZero X}
    (ha : SecondAdamsTotalChern (C := C) (sX := sX) a) :
    SecondAdamsTotalChern (C := C) (sX := sX) (-a) := by
  unfold SecondAdamsTotalChern at *
  have h1 := totalChernKClass_neg_mul C sX (secondAdamsRingHom (squarePowersData X) a)
  have h2 := congrArg twoScale (totalChernKClass_neg_mul C sX a)
  rw [map_mul, map_one, ← ha] at h2
  rw [map_neg]
  exact eq_of_mul_eq_one_of_isUnit (isUnit_totalChernKClass C sX _) h1 h2

/-- Restriction transports the identity for the class of a finite locally free module. -/
theorem SecondAdamsTotalChern.of_res {T : Scheme.{u}} {sT : T ⟶ C.S} [LocallyOfFiniteType sT]
    (h : T ⟶ X) [LocallyOfFiniteType h] (hs : h ≫ sX = sT) (M : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} M]
    (hM : SecondAdamsTotalChern (C := C) (sX := sT)
      (classOf T ((Scheme.Modules.pullback h).obj M))) :
    res h hs (totalChernKClass C sX (secondAdamsRingHom (squarePowersData X) (classOf X M))) =
      res h hs (twoScale (totalChernKClass C sX (classOf X M))) := by
  rw [res_totalChernKClass, pullback_secondAdamsRingHom, pullback_classOf, res_twoScale,
    res_totalChernKClass, pullback_classOf]
  exact hM

/-- **The base case**: `c(ℒ ⊗ ℒ) = 1 + 2c_1(ℒ) = s(c(ℒ))` for an invertible `ℒ`. -/
theorem secondAdamsTotalChern_classOf_of_isInvertible (L : X.Modules)
    [hL : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] :
    SecondAdamsTotalChern (C := C) (sX := sX) (classOf X L) := by
  have h1 : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L 1 :=
    isFiniteLocallyFreeOfRank_one_of_isInvertible L
  have hF : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} L :=
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree L 1
  have : Stacks.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L :=
    (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry _ _ L).mpr hL
  have hT1 : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (Scheme.Modules.tensorObjRingedSpace X L L) 1 :=
    isFiniteLocallyFreeOfRank_tensor h1 h1
  have hT : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
      (Scheme.Modules.tensorObjRingedSpace X L L) :=
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree _ 1
  have hP := secondAdamsScales_classOf_of_isInvertible (C := C) (sX := sX) L 1
  unfold SecondAdamsScales at hP
  rw [secondAdamsRingHom_apply, secondAdamsAddHom_classOf_isInvertible, powerSumKHom_classOf,
    powerSumKHom_classOf, pow_one] at hP
  unfold SecondAdamsTotalChern
  rw [secondAdamsRingHom_apply, secondAdamsAddHom_classOf_isInvertible, totalChernKClass_classOf,
    totalChernKClass_classOf, totalChernOfFiniteLocallyFree_eq_one_add_of_rank_one,
    totalChernOfFiniteLocallyFree_eq_one_add_of_rank_one, hP, map_add, map_one,
    twoScale_of_isHomogeneous_one (isHomogeneous_powerSumOfFiniteLocallyFree C sX L 1)]

/-- **A module filtered by invertible modules.** -/
theorem secondAdamsTotalChern_classOf_of_hasInvertibleFiltration {F : X.Modules} {r : ℕ}
    (hF : Stacks.WeilCohomology.HasInvertibleFiltration X F r) :
    SecondAdamsTotalChern (C := C) (sX := sX) (classOf X F) := by
  induction hF with
  | nil E hE =>
    rw [← classOf_eq_of_iso hE.isoZero.symm (VectorBundleKZero.isFiniteLocallyFree_zero X),
      classOf_zero]
    exact secondAdamsTotalChern_zero
  | @step E F L r f g w hS hL hE hF ih =>
    have hFr := hF.isFiniteLocallyFreeOfRank
    have hEr : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E (r + 1) :=
      (Stacks.WeilCohomology.HasInvertibleFiltration.step f g w hS hL hE
        hF).isFiniteLocallyFreeOfRank
    have hL' : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj
        X.ringCatSheaf.property L := hL
    have hL1 : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L 1 :=
      isFiniteLocallyFreeOfRank_one_of_isInvertible L
    have hstk : ∀ (M : X.Modules) (n : ℕ),
        AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M n →
          Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M :=
      fun M n hM => AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.toFiniteLocallyFree M
        (AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree M n)
    have : Mono f := hS.mono_f
    have : Epi g := hS.epi_g
    rw [classOf_shortExact f g w (hstk F r hFr) (hstk E (r + 1) hEr) (hstk L 1 hL1) hS.exact]
    exact ih.add (secondAdamsTotalChern_classOf_of_isInvertible L)

/-- **Stacks Project, Tag 0FEN, the first equation, as an identity of total classes**:
`c(ψ²(α)) = s(c(α))`, `s` multiplying `A^i(X)` by `2^i`. -/
theorem totalChernKClass_secondAdams_eq_twoScale (a : VectorBundleKZero X) :
    totalChernKClass C sX (secondAdamsRingHom (squarePowersData X) a) =
      twoScale (totalChernKClass C sX a) := by
  refine induction_on_classOf (P := SecondAdamsTotalChern (C := C) (sX := sX)) a
    (fun M hM => ?_) secondAdamsTotalChern_zero (fun a b ha hb => ha.add hb) (fun a ha => ha.neg)
  have := hM
  -- the rank loci of `ℰ`
  refine TotalChowClass.eq_of_res_eq (isClopenDecomposition_rankLociFamily M) fun r => ?_
  let := isFiniteLocallyFreeOfRank_pullback_rankLociFamily M r
  refine SecondAdamsTotalChern.of_res _ rfl M ?_
  -- the splitting principle over a rank locus
  set N := (Scheme.Modules.pullback (rankLociFamily M r).ι).obj M
  have hN : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} N :=
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree N r.down
  refine TotalChowClass.eq_of_res_eq_of_hasInvertibleFiltration (I := Unit) (fun _ => N)
    (fun _ => r.down) (fun _ => inferInstance) fun {T} sT _ h _ hs hfil => ?_
  exact SecondAdamsTotalChern.of_res h hs N
    (secondAdamsTotalChern_classOf_of_hasInvertibleFiltration (hfil ()))

/-- **Stacks Project, Tag 0FEN, the first equation.** Let `(S, δ)` be as in Situation 42.7.1 and
let `X` be locally of finite type over `S`. For every `α ∈ K_0(Vect(X))` and every `i ≥ 0`,

  `c_i(ψ²(α)) = 2^i c_i(α)`   in `A^i(X)`,

where `ψ²` is the second Adams operation of Stacks 0FEJ and `c` the total Chern class of
Remark 0FEL (`Stacks.Chow.totalChernKClass`). -/
@[stacks 0FEN "the c_i equation: c_i(ψ²(α)) = 2^i c_i(α) in A^i(X), for every α ∈ K_0(Vect(X)) \
and every X locally of finite type over S, with no further hypothesis: ψ² is \
AlgebraicGeometry.VectorBundleKZero.secondAdamsRingHom (Stacks 0FEJ) and c is the total Chern \
class map of Remark 0FEL, Stacks.Chow.totalChernKClass, constructed here for modules of arbitrary \
rank"]
theorem totalChernKClass_secondAdams (a : VectorBundleKZero X) (i : ℕ) :
    totalChernKClass C sX (secondAdamsRingHom (squarePowersData X) a) i =
      (2 ^ i : ℤ) • totalChernKClass C sX a i := by
  rw [totalChernKClass_secondAdams_eq_twoScale, twoScale_apply]

end Stacks.Chow

