/-! ### Capping a pushed-forward class with the fundamental class -/

section PushforwardCap

variable (C : ChowSituation.{u}) {W X Y : Scheme.{u}} (sW : W ⟶ C.S) [LocallyOfFiniteType sW]
  (sX : X ⟶ C.S) [LocallyOfFiniteType sX] (sY : Y ⟶ C.S) [LocallyOfFiniteType sY] (f : W ⟶ X)
  [IsProper f] (g : X ⟶ Y) [LocallyOfFiniteType g] (hf : f ≫ sX = sW) (hg : g ≫ sY = sX) (p : ℤ)

/-- **`(f_* ∘ c) ∩ [Y]_n = f_*(c ∩ [Y]_n)`**, for `f : W ⟶ X` proper, `g : X ⟶ Y` and
`c ∈ A^p(W ⟶ Y)`: capping the proper pushforward `f_* ∘ c ∈ A^p(X ⟶ Y)` (Stacks 0EPK) with the
fundamental class of `Y` is pushing forward along `f` the cap product of `c`, both read on `X`,
resp. `W`, through `X ×_Y Y ≅ X`, `W ×_Y Y ≅ W`. -/
theorem capFundamentalClassAt_bivariantProperPushforward (n : ℤ)
    (c : BivariantClass C (gysinSystemOfInvertible C) sW sY (f ≫ g)
      (comp_comp_structureMorphism_eq hf hg) p) :
    capFundamentalClassAt C (gysinSystemOfInvertible C) sX sY g hg p n
        (bivariantProperPushforwardOfInvertible C sW sX sY f g hf hg p c) =
      properChowPushforward C sW sX f hf (n - p) (properPushforwardDescends C _ _ _ _ _)
        (capFundamentalClassAt C (gysinSystemOfInvertible C) sW sY (f ≫ g)
          (comp_comp_structureMorphism_eq hf hg) p n c) := by
  rw [capFundamentalClassAt_apply, capFundamentalClassAt_apply,
    bivariantProperPushforwardOfInvertible_cap,
    bivariantProperPushforwardCap_apply, chowGroupPullbackIdEquiv, chowGroupPullbackIdEquiv,
    chowGroupEquivOfIso_apply, chowGroupEquivOfIso_apply, chowPushforwardOfIso,
    chowPushforwardOfIso,
    ← properChowPushforward_comp_apply C _ _ _ (bivariantPushforwardBaseChange f g (𝟙 Y))
      (pullback.fst g (𝟙 Y)) (pullback.fst (f ≫ g) (𝟙 Y) ≫ f)
      (bivariantPushforwardBaseChange_fst f g (𝟙 Y)) _ rfl (by rw [Category.assoc, hf])
      (hfacw := properPushforwardDescends C _ _ _ _ _),
    ← properChowPushforward_comp_apply C _ _ _ (pullback.fst (f ≫ g) (𝟙 Y)) f
      (pullback.fst (f ≫ g) (𝟙 Y) ≫ f) rfl rfl hf
      (hfacw := properPushforwardDescends C _ _ _ _ _)]

end PushforwardCap

/-! ### Classes pushed forward from a closed subscheme -/

section Span

variable (C : ChowSituation.{u}) {W X : Scheme.{u}} (sW : W ⟶ C.S) [LocallyOfFiniteType sW]
  (sX : X ⟶ C.S) [LocallyOfFiniteType sX] (h : W ⟶ X) [IsClosedImmersion h] (hh : h ≫ sX = sW)

/-- **The pushforward of `[Z_w]` along a closed immersion `h : W ⟶ X` is `[Z_{h(w)}]`**: the
integral closed subscheme of `W` through `w`, read in `X`, is the integral closed subscheme of `X`
through `h(w)`. -/
theorem properChowPushforward_integralComponentAt (j : ℤ) (w : W) :
    properChowPushforward C sW sX h hh j (properPushforwardDescends C _ _ _ _ _)
        (QuotientAddGroup.mk' (rationalEquivalences C sW j)
          (cycleAssociatedToClosedSubscheme C sW (integralComponentAt w).subschemeι j)) =
      QuotientAddGroup.mk' (rationalEquivalences C sX j)
        (cycleAssociatedToClosedSubscheme C sX (integralComponentAt (h w)).subschemeι j) := by
  subst hh
  obtain ⟨e, he⟩ := Stacks.ChernCap42.exists_iso_integralComponentAt h w
  rw [properChowPushforward_mk,
    properPushforward_cycleAssociatedToClosedSubscheme_of_isClosedImmersion_comp,
    cycleAssociatedToClosedSubscheme_eq_of_iso C sX _ _ e he]

variable [IsNoetherian X]

omit [LocallyOfFiniteType sW] [IsClosedImmersion h] [AlgebraicGeometry.IsNoetherian X] in
/-- The class `[Z_x] ∈ CH_*(X) ⊗ 𝐐` of the integral closed subscheme through a point `x` of
`δ`-dimension `j`, in degree `j`. -/
theorem integralComponentRationalClass_eq {x : X} {j : ℤ}
    (hx : relativeDimension C.dimensionFunction sX x = j) :
    integralComponentRationalClass C sX x =
      DirectSum.of (fun j => ℚ ⊗[ℤ] chowGroup C sX j) j ((1 : ℚ) ⊗ₜ[ℤ]
        QuotientAddGroup.mk' (rationalEquivalences C sX j)
          (cycleAssociatedToClosedSubscheme C sX (integralComponentAt x).subschemeι j)) := by
  subst hx
  rfl

omit [AlgebraicGeometry.IsNoetherian X] in
/-- **A class pushed forward from a closed subscheme is a combination of the classes of its
integral closed subschemes.** Let `h : W ⟶ X` be a closed immersion with `W` quasi-compact, and
let `T ⊆ X` contain the image of every point of `W` of `δ`-dimension `j`. Then the pushforward of
any element of `CH_j(W) ⊗ 𝐐`, placed in degree `j` of `CH_*(X) ⊗ 𝐐`, is a rational combination of
the classes `[Z_x]` of the integral closed subschemes of `X` with generic point `x ∈ T`. -/
theorem of_lTensor_properChowPushforward_mem_span [CompactSpace W] (j : ℤ) (T : Set X)
    (hT : ∀ w : W, relativeDimension C.dimensionFunction sW w = j → h w ∈ T)
    (d : ℚ ⊗[ℤ] chowGroup C sW j) :
    DirectSum.of (fun j => ℚ ⊗[ℤ] chowGroup C sX j) j
        ((properChowPushforward C sW sX h hh j
          (properPushforwardDescends C _ _ _ _ _)).toIntLinearMap.lTensor ℚ d) ∈
      Submodule.span ℚ (integralComponentRationalClass C sX '' T) := by
  set S := Submodule.span ℚ (integralComponentRationalClass C sX '' T)
  have h1 : ∀ α : chowGroup C sW j, DirectSum.of (fun j => ℚ ⊗[ℤ] chowGroup C sX j) j
      ((1 : ℚ) ⊗ₜ[ℤ] properChowPushforward C sW sX h hh j
        (properPushforwardDescends C _ _ _ _ _) α) ∈ S := by
    intro α
    obtain ⟨c, rfl⟩ := QuotientAddGroup.mk'_surjective (rationalEquivalences C sW j) α
    let φ : CycleGroup C sW j →+ (DirectSum ℤ fun j => ℚ ⊗[ℤ] chowGroup C sX j) ⧸ S :=
      (S.mkQ.toAddMonoidHom).comp
        ((DirectSum.of (fun j => ℚ ⊗[ℤ] chowGroup C sX j) j).comp
        ((TensorProduct.mk ℤ ℚ (chowGroup C sX j) 1).toAddMonoidHom.comp
          ((properChowPushforward C sW sX h hh j (properPushforwardDescends C _ _ _ _ _)).comp
            (QuotientAddGroup.mk' (rationalEquivalences C sW j)))))
    have : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian sW
    have hφ : φ = 0 := cycleGroup_hom_ext C sW j fun w hw => by
      change S.mkQ (DirectSum.of (fun j => ℚ ⊗[ℤ] chowGroup C sX j) j ((1 : ℚ) ⊗ₜ[ℤ]
        properChowPushforward C sW sX h hh j (properPushforwardDescends C _ _ _ _ _)
          (QuotientAddGroup.mk' (rationalEquivalences C sW j)
            (cycleAssociatedToClosedSubscheme C sW (integralComponentAt w).subschemeι j)))) = 0
      rw [properChowPushforward_integralComponentAt, Submodule.mkQ_apply,
        Submodule.Quotient.mk_eq_zero]
      have hwj : relativeDimension C.dimensionFunction sX (h w) = j := by
        rw [← hw, ← hh, relativeDimension_comp_closedImmersion]
      exact Submodule.subset_span ⟨h w, hT w hw, integralComponentRationalClass_eq C sX hwj⟩
    exact (Submodule.Quotient.mk_eq_zero S).1 (DFunLike.congr_fun hφ c)
  induction d using TensorProduct.inductionOn with
  | tmul q α =>
    have h2 := S.smul_mem q (h1 α)
    rw [← DirectSum.of_smul, TensorProduct.smul_tmul', smul_eq_mul, mul_one] at h2
    rwa [LinearMap.lTensor_tmul, AddMonoidHom.coe_toIntLinearMap]
  | add a b ha hb => rw [map_add, map_add]; exact S.add_mem ha hb

end Span

/-! ### The leading term gives the diagonal condition -/

section Diagonal

variable {C : ChowSituation.{u}} {X : Scheme.{u}} {f : X ⟶ C.S} [LocallyOfFiniteType f]
  [IsNoetherian X] {ch : CoherentKZero X →+ DirectSum ℤ fun j => ℚ ⊗[ℤ] chowGroup C f j}

omit [AlgebraicGeometry.IsNoetherian X] in
/-- **The leading-term form of the two conditions of the proof of Stacks 0FEW gives
condition (2).** If the image of `[𝒪_Z]` is `[Z]` plus classes of integral closed subschemes of
`Z` other than `Z`, its degree `dim_δ Z` part is `[Z]`: the other classes live in lower degrees. -/
theorem HasLeadingTermOnIntegral.isDiagonalOnIntegral (h : HasLeadingTermOnIntegral C f ch) :
    IsDiagonalOnIntegral C f ch := by
  intro k x hx
  subst hx
  have hspan : ∀ v ∈ Submodule.span ℚ (integralComponentRationalClass C f '' (closure {x} \ {x})),
      v (relativeDimension C.dimensionFunction f x) = 0 := by
    intro v hv
    induction hv using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨y, ⟨hy, hyx⟩, rfl⟩ := hv
      exact DirectSum.of_eq_of_ne _ _ _ (relativeDimension_lt_of_mem_closure_of_ne C f hy hyx).ne'
    | zero => rfl
    | add a b _ _ ha hb => rw [DirectSum.add_apply, ha, hb, add_zero]
    | smul q a _ ha => rw [DirectSum.smul_apply, ha, smul_zero]
  have h0 := hspan _ (h x)
  rw [DirectSum.sub_apply, sub_eq_zero, integralComponentRationalClass, DirectSum.of_eq_same] at h0
  exact h0

end Diagonal

/-! ### The composition of Stacks 0FEW on the class of an integral closed subscheme -/

section Composite

variable (C : ChowSituation.{u}) {X Y : Scheme.{u}} (a : Y ⟶ C.S) [LocallyOfFiniteType a]
  (i : X ⟶ Y) [IsClosedImmersion i] (hY : IsRegular Y) [CompactSpace Y]

/-- **The degree `j` part of the composition of Stacks 0FEW on `[ℱ]`, as a pushforward from a
closed subscheme `Z` carrying `ℱ[0]`.** Let `g : Z ⟶ X` be a closed immersion and `E` the object
`ℱ[0]` of `D_{Z, perf}(𝒪_Y)`. By Stacks 0FB7, `ch(X ⟶ Y, ℱ[0]) = (Z ⟶ X)_* ∘ ch(Z ⟶ Y, ℱ[0])`, so
the degree `j` part of `ch(X ⟶ Y, ℱ[0]) ∩ [Y]` is the pushforward along `Z ×_Y Y ≅ Z ⟶ X` of the
degree `j` part of `∑_{p ≤ N} P_p(Z ⟶ Y, ℱ[0]) ∩ [Y] / p!`, for any `N` beyond which the localized
classes vanish. -/
theorem coherentChowCharacter_mk_apply_eq_lTensor {Z : Scheme.{u}} {iZ : Z ⟶ Y}
    [IsClosedImmersion iZ] (g : Z ⟶ X) [IsClosedImmersion g] (hg : g ≫ i = iZ)
    (F : Stacks.SheafOfModules.CoherentModules X.ringCatSheaf)
    (E : supportedPerfectDerivedCategory iZ)
    (hE : (singlePushforwardSupportedPerfectGeneral i hY F).obj = E.obj) (N : ℕ)
    (hN : ∀ p ≥ N + 1, supportedLocalizedChernChar C a isCompact_of_mem_irreducibleComponents
      (singlePushforwardSupportedPerfectGeneral i hY F) p = 0) (j : ℤ) :
    haveI := isNoetherian_of_compactSpace C a
    coherentChowCharacter C a i hY (KZero.mk _ F) j =
      ((properChowPushforward C (iZ ≫ a) (i ≫ a) g (by rw [← hg, Category.assoc]) j
          (properPushforwardDescends C _ _ _ _ _)).comp
        (chowGroupPullbackIdEquiv C (iZ ≫ a) iZ j).toAddMonoidHom).toIntLinearMap.lTensor ℚ
      (capFundamentalClassDegreePart C (gysinSystemOfInvertible C) (iZ ≫ a) a iZ rfl
        (Finset.range (N + 1)) (fun p => ((Nat.factorial p : ℚ)⁻¹))
        (fun p => (supportedPerfectData C a iZ E).localizedPowerSum
          (hasDefinedChernClasses_of_isCompact_irreducibleComponents C a
            isCompact_of_mem_irreducibleComponents E.obj E.property.1)
          (supportedPerfectData_isZeroOnComplement C a E) p) (𝟙 Y) j) := by
  have := isNoetherian_of_compactSpace C a
  subst hg
  rw [coherentChowCharacter_mk C a i hY F (N + 1) hN, DFinsupp.finsetSum_apply,
    capFundamentalClassDegreePart, map_sum]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [supportedLocalizedChernChar_apply,
    supportedLocalizedPowerSum_eq_bivariantProperPushforward C a (j := g) rfl
      isCompact_of_mem_irreducibleComponents E (singlePushforwardSupportedPerfectGeneral i hY F)
      hE p,
    rationalCapFundamentalClass_tmul_apply, capFundamentalClassAt_bivariantProperPushforward,
    LinearMap.lTensor_tmul, capFundamentalClassAt_apply]
  congr 1
  have key : ∀ (m : ℤ) (hm : m = j)
      (y : chowGroup C (pullback.fst (g ≫ i) (𝟙 Y) ≫ ((g ≫ i) ≫ a)) m),
      chowGroupDegreeEquiv C (i ≫ a) hm (properChowPushforward C ((g ≫ i) ≫ a) (i ≫ a) g
        (by rw [Category.assoc]) m (properPushforwardDescends C _ _ _ _ _)
        (chowGroupPullbackIdEquiv C ((g ≫ i) ≫ a) (g ≫ i) m y)) =
      ((properChowPushforward C ((g ≫ i) ≫ a) (i ≫ a) g (by rw [Category.assoc]) j
          (properPushforwardDescends C _ _ _ _ _)).comp
        (chowGroupPullbackIdEquiv C ((g ≫ i) ≫ a) (g ≫ i) j).toAddMonoidHom).toIntLinearMap
        (chowGroupDegreeEquiv C _ hm y) := by
    intro m hm y
    subst hm
    rfl
  exact key _ _ _

/-- `𝒪_{Z_x}`, pushed forward along the closed immersion `i : X ⟶ Y`, is `𝒪_{Z_{i(x)}}`: the
integral closed subscheme of `X` through `x`, read in `Y`, is the integral closed subscheme of `Y`
through `i(x)`. -/
def pushforwardIntegralComponentModuleIso (x : X) :
    (Scheme.Modules.pushforward i).obj (integralComponentModule x) ≅
      integralComponentModule (i x) :=
  haveI := isIntegral_integralComponentAt x
  (Scheme.Modules.pushforwardComp (integralComponentAt x).subschemeι i).app _ ≪≫
    pushforwardUnitIsoIntegralComponent ((integralComponentAt x).subschemeι ≫ i) ≪≫
    eqToIso (congrArg integralComponentStructureSheaf (by
      rw [Scheme.Hom.comp_apply]
      exact congrArg i (genericPointOf_integralComponentAt x)))

/-- **The composition of Stacks 0FEW satisfies condition (2) of its proof, in the leading-term
form.** For a closed immersion `i : X ⟶ Y` with `Y` regular and quasi-compact and an integral
closed subscheme `Z ⊆ X`, the image of `[𝒪_Z]` under `ℱ ↦ ch(X ⟶ Y, ℱ[0]) ∩ [Y]` is `[Z]` plus a
rational combination of classes of integral closed subschemes of `Z` other than `Z`.

Stacks 0FEG enters through `Stacks.Chow.isRegularImmersionChernFormula_of_compactSpace`.

By Stacks 0FB7 the image of `[𝒪_Z]` is pushed forward from `ch(Z ⟶ Y, 𝒪_Z[0]) ∩ [Y]` in
`CH_*(Z) ⊗ 𝐐` (`Stacks.Chow.coherentChowCharacter_mk_apply_eq_lTensor`). Its parts of degree
`j ≠ dim_δ Z` live in degrees `j < dim_δ Z` and are combinations of classes of integral closed
subschemes of `Z` of `δ`-dimension `j`
(`Stacks.Chow.of_lTensor_properChowPushforward_mem_span`). Its part of degree `dim_δ Z` is `[Z]`:
since `CH_k(Z) = 𝐙`, this may be checked over an open neighbourhood `V` of the generic point of `Z`
(`Stacks.Chow.LocalizedSituation.hasFundamentalDegreePart_of_pullback`), where the ideal of
`Z` is generated by a regular sequence (Stacks 00NQ, 063I) and Stacks 0FEH applies
(`Stacks.Chow.isDiagonalOnIntegralNear_of_isRegularImmersionChernFormula`). -/
theorem hasLeadingTermOnIntegral_coherentChowCharacter :
    haveI := isNoetherian_of_isClosedImmersion_of_compactSpace C a i
    HasLeadingTermOnIntegral C (i ≫ a) (coherentChowCharacter C a i hY) := by
  have := isNoetherian_of_compactSpace C a
  have := isNoetherian_of_isClosedImmersion_of_compactSpace C a i
  intro x
  set F := (integralComponentDimLE C (i ≫ a) _ x rfl).obj with hFdef
  have : _root_.SheafOfModules.IsCoherent (F.obj : X.Modules) :=
    CoherentAbelian.isCoherent_of_stacksIsCoherent F.property
  obtain ⟨g, hgci, hg, e, he⟩ := Stacks.ChernCap42.exists_restrictionMorphism i x
  have := hgci
  have hι : ∀ w, i ((integralComponentAt x).subschemeι w) ∈
      Set.range (integralComponentAt (i x)).subschemeι.base := fun w => by
    have h1 : e.hom ≫ g ≫ i = (integralComponentAt x).subschemeι ≫ i := by
      rw [← he, Category.assoc, Iso.hom_inv_id_assoc]
    refine ⟨e.hom w, ?_⟩
    rw [← hg, ← Scheme.Hom.comp_apply, h1, Scheme.Hom.comp_apply]
  have hsupp : ∀ n : ℤ, _root_.SheafOfModules.supp
      ((DerivedCategory.homologyFunctor (StrictlyPerfect.OXMod.{u, u} Y.toRingedSpace) n).obj
        (singlePushforwardSupportedPerfectGeneral i hY F).obj) ⊆
        Set.range (integralComponentAt (i x)).subschemeι.base := by
    intro n y hy
    obtain ⟨z, rfl⟩ := supp_homology_singlePushforwardSupportedPerfect_subset i hY F n hy
    have hz : (reducedSupport (F.obj : X.Modules)).subschemeι z ∈
        Set.range (integralComponentAt x).subschemeι.base := by
      have h2 : (reducedSupport (F.obj : X.Modules)).subschemeι z ∈
          ((reducedSupport (F.obj : X.Modules)).support : Set X) := by
        rw [← Scheme.IdealSheafData.range_subschemeι]
        exact ⟨z, rfl⟩
      exact (supp_integralComponentModule x).subset
        ((Set.ext_iff.1 (coe_support_reducedSupport (F.obj : X.Modules)) _).1 h2)
    obtain ⟨w, hw⟩ := hz
    rw [Scheme.Hom.comp_apply, ← hw]
    exact hι w
  let E : supportedPerfectDerivedCategory (integralComponentAt (i x)).subschemeι :=
    ⟨(singlePushforwardSupportedPerfectGeneral i hY F).obj,
      (singlePushforwardSupportedPerfectGeneral i hY F).2.1, hsupp⟩
  let K : Stacks.Perfect.BoundedLocallyFreeComplexes.PerfectDerivedCategory Y :=
    ⟨E.obj, E.property.1⟩
  let eK : K.obj ≅
      (DerivedCategory.singleFunctor Y.Modules 0).obj (integralComponentModule (i x)) :=
    (DerivedCategory.singleFunctor Y.Modules 0).mapIso (pushforwardIntegralComponentModuleIso i x)
  -- the degree `δ(x)` part, near the generic point
  obtain ⟨V, hξV, hV⟩ :=
    isDiagonalOnIntegralNear_of_isRegularImmersionChernFormula C a hY
      (isRegularImmersionChernFormula_of_compactSpace C) (i x) K eK
  obtain ⟨N₀, hN₀⟩ := exists_supportedLocalizedChernChar_eq_zero C a
    isCompact_of_mem_irreducibleComponents (singlePushforwardSupportedPerfectGeneral i hY F)
  obtain ⟨hi, hhi⟩ := exists_relativeDimension_le C a
  have hkξ : relativeDimension C.dimensionFunction a (i x) =
      relativeDimension C.dimensionFunction (i ≫ a) x :=
    (relativeDimension_comp_closedImmersion _ i a x).symm
  set k := relativeDimension C.dimensionFunction (i ≫ a) x with hk
  set N := max N₀ (hi - k).toNat with hNdef
  have hN : ∀ p ≥ N + 1, supportedLocalizedChernChar C a isCompact_of_mem_irreducibleComponents
      (singlePushforwardSupportedPerfectGeneral i hY F) p = 0 := fun p hp => hN₀ p (by omega)
  have hbound : ∀ y : Y, relativeDimension C.dimensionFunction a y ≤
      relativeDimension C.dimensionFunction a (i x) + N := fun y => by
    have := hhi y
    have : (hi - k).toNat ≤ N := le_max_right _ _
    omega
  set S := integralComponentLocalizedSituation C a (i x) K eK
  have hS := isZeroOnComplement_integralComponentLocalizedSituation C a (i x) K eK
  have hloc := hV N hbound
  rw [hkξ] at hloc
  have hdeg := S.hasFundamentalDegreePart_of_pullback hS N k (fun z => by
      rw [relativeDimension_comp_closedImmersion, ← hkξ]
      exact relativeDimension_le_of_mem_closure C a (subschemeι_mem_closure _ z)) V (fun z hz => by
      rw [relativeDimension_comp_closedImmersion, ← hkξ] at hz
      by_cases hzξ : (integralComponentAt (i x)).subschemeι z = i x
      · rw [hzξ]
        exact hξV
      · exact absurd hz (relativeDimension_lt_of_mem_closure_of_ne C a
          (subschemeι_mem_closure _ z) hzξ).ne) hloc
  unfold LocalizedSituation.HasFundamentalDegreePart at hdeg
  have hcore := coherentChowCharacter_mk_apply_eq_lTensor C a i hY g hg F E rfl N hN
  have hfam : (fun p =>
      (supportedPerfectData C a (integralComponentAt (i x)).subschemeι E).localizedPowerSum
      (hasDefinedChernClasses_of_isCompact_irreducibleComponents C a
        isCompact_of_mem_irreducibleComponents E.obj E.property.1)
      (supportedPerfectData_isZeroOnComplement C a E) p) = fun p => S.localizedPowerSum hS p :=
    funext fun p => S.localizedPowerSum_toLocalizedChernData hS p
  have htop : coherentChowCharacter C a i hY (KZero.mk _ F) k =
      (1 : ℚ) ⊗ₜ[ℤ] QuotientAddGroup.mk' (rationalEquivalences C (i ≫ a) k)
        (cycleAssociatedToClosedSubscheme C (i ≫ a) (integralComponentAt x).subschemeι k) := by
    rw [hcore k, hfam, hdeg, LinearMap.lTensor_tmul, AddMonoidHom.coe_toIntLinearMap,
      AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom, chowGroupPullbackIdEquiv,
      chowGroupEquivOfIso_apply, chowPushforwardOfIso_fundamentalChowClass, fundamentalChowClass,
      properChowPushforward_mk, properPushforward_fundamentalCycle_of_isClosedImmersion,
      cycleAssociatedToClosedSubscheme_eq_of_iso C (i ≫ a) g (integralComponentAt x).subschemeι
        e.symm he]
  -- the parts of the other degrees
  have : CompactSpace (integralComponentAt (i x)).subscheme :=
    (integralComponentAt (i x)).subschemeι.isClosedEmbedding.compactSpace
  have hlow : ∀ j ≠ k, DirectSum.of (fun j => ℚ ⊗[ℤ] chowGroup C (i ≫ a) j) j
      (coherentChowCharacter C a i hY (KZero.mk _ F) j) ∈
      Submodule.span ℚ (integralComponentRationalClass C (i ≫ a) '' (closure {x} \ {x})) := by
    intro j hj
    have hT : ∀ w : (integralComponentAt (i x)).subscheme,
        relativeDimension C.dimensionFunction ((integralComponentAt (i x)).subschemeι ≫ a) w = j →
          g w ∈ closure {x} \ {x} := by
      intro w hw
      have hgw : g w = (integralComponentAt x).subschemeι (e.inv w) := by
        rw [← he, Scheme.Hom.comp_apply]
      refine ⟨hgw ▸ subschemeι_mem_closure x _, fun hgx => hj ?_⟩
      rw [← hw, ← hg, Category.assoc, relativeDimension_comp_closedImmersion]
      exact congrArg _ hgx
    have hmain := of_lTensor_properChowPushforward_mem_span C
      ((integralComponentAt (i x)).subschemeι ≫ a) (i ≫ a) g (by rw [← hg, Category.assoc]) j
      (closure {x} \ {x}) hT
      ((chowGroupPullbackIdEquiv C ((integralComponentAt (i x)).subschemeι ≫ a)
        (integralComponentAt (i x)).subschemeι j).toAddMonoidHom.toIntLinearMap.lTensor ℚ
        (capFundamentalClassDegreePart C (gysinSystemOfInvertible C)
          ((integralComponentAt (i x)).subschemeι ≫ a) a (integralComponentAt (i x)).subschemeι rfl
          (Finset.range (N + 1)) (fun p => ((Nat.factorial p : ℚ)⁻¹))
          (fun p =>
            (supportedPerfectData C a (integralComponentAt (i x)).subschemeι E).localizedPowerSum
            (hasDefinedChernClasses_of_isCompact_irreducibleComponents C a
              isCompact_of_mem_irreducibleComponents E.obj E.property.1)
            (supportedPerfectData_isZeroOnComplement C a E) p) (𝟙 Y) j))
    rw [hcore j]
    rw [← LinearMap.lTensor_comp_apply] at hmain
    exact hmain
  classical
  rw [← DirectSum.sum_support_of (coherentChowCharacter C a i hY (KZero.mk _ F) -
    integralComponentRationalClass C (i ≫ a) x)]
  refine Submodule.sum_mem _ fun j _ => ?_
  by_cases hjk : j = k
  · rw [hjk, DirectSum.sub_apply, htop, integralComponentRationalClass, DirectSum.of_eq_same,
      sub_self, map_zero]
    exact Submodule.zero_mem _
  · rw [DirectSum.sub_apply, integralComponentRationalClass,
      DirectSum.of_eq_of_ne _ _ _ hjk, sub_zero]
    exact hlow j hjk

/-- **Surjectivity in Stacks 0FEW, given Stacks 0FEG.** For a closed immersion `i : X ⟶ Y` with
`Y` regular and quasi-compact, the composition `ℱ ↦ ch(X ⟶ Y, ℱ[0]) ∩ [Y]` induces a surjection
`K'₀(X) ⊗ 𝐐 ⟶ CH_*(X) ⊗ 𝐐`. No bound on `δ_{X/S}` is
needed (`Stacks.Chow.surjective_liftBaseChange_of_hasLeadingTermOnIntegral`). -/
theorem surjective_liftBaseChange_coherentChowCharacter :
    Function.Surjective
      ((coherentChowCharacter C a i hY).toIntLinearMap.liftBaseChange ℚ) := by
  have := isNoetherian_of_isClosedImmersion_of_compactSpace C a i
  exact surjective_liftBaseChange_of_hasLeadingTermOnIntegral _
    (hasLeadingTermOnIntegral_coherentChowCharacter C a i hY)

include hY in
/-- **The "moreover" of Stacks 0FEW, given Stacks 0FEG.** For a closed immersion `i : X ⟶ Y` with
`Y` regular and quasi-compact, the canonical map `CH_k(X) ⊗ 𝐐 ⟶ gr_k K'₀(X) ⊗ 𝐐` is bijective for
every `k`: the degree `k` part of the composition `ℱ ↦ ch(X ⟶ Y, ℱ[0]) ∩ [Y]`, which satisfies
conditions (1) and (2) of the proof, descends to a left
inverse (`Stacks.Chow.bijective_rTensor_chowToGradedCoherentKZero`). -/
theorem bijective_rTensor_chowToGradedCoherentKZero_of_isClosedImmersion (k : ℤ) :
    haveI := isNoetherian_of_isClosedImmersion_of_compactSpace C a i
    Function.Bijective (TensorProduct.map (LinearMap.id : ℚ →ₗ[ℤ] ℚ)
      (chowToGradedCoherentKZero C (i ≫ a) k).toIntLinearMap) :=
  have := isNoetherian_of_isClosedImmersion_of_compactSpace C a i
  bijective_rTensor_chowToGradedCoherentKZero _
    (isDimensionTriangular_coherentChowCharacter C a i hY)
    (hasLeadingTermOnIntegral_coherentChowCharacter C a i hY).isDiagonalOnIntegral k

/-- **Injectivity in Stacks 0FEW reduces to separation.** For a closed immersion `i : X ⟶ Y`
with `Y` regular and quasi-compact, the composition `ℱ ↦ ch(X ⟶ Y, ℱ[0]) ∩ [Y]` induces an
injection `K'₀(X) ⊗ 𝐐 ⟶ CH_*(X) ⊗ 𝐐` as soon as the filtration by dimension of supports of
`K'₀(X) ⊗ 𝐐` is separated (`Stacks.Chow.injective_liftBaseChange_of_separated`); conversely the
kernel lies in `⋂_k F_k K'₀(X) ⊗ 𝐐`
(`Stacks.Chow.exists_zsmul_mem_coherentKZeroFiltration_of_apply_eq_zero`). No bound on `δ_{X/S}`
is assumed. -/
theorem injective_liftBaseChange_coherentChowCharacter_of_separated
    (hsep : haveI := isNoetherian_of_isClosedImmersion_of_compactSpace C a i
      ∀ b : CoherentKZero X,
        (∀ k : ℤ, ∃ m : ℤ, m ≠ 0 ∧ m • b ∈ coherentKZeroFiltration C (i ≫ a) k) →
          ∃ m : ℤ, m ≠ 0 ∧ m • b = 0) :
    Function.Injective ((coherentChowCharacter C a i hY).toIntLinearMap.liftBaseChange ℚ) := by
  have := isNoetherian_of_isClosedImmersion_of_compactSpace C a i
  exact injective_liftBaseChange_of_separated _
    (isDimensionTriangular_coherentChowCharacter C a i hY)
    (hasLeadingTermOnIntegral_coherentChowCharacter C a i hY).isDiagonalOnIntegral hsep

