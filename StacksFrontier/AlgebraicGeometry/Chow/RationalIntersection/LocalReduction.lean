/-! ### A regular sequence cutting out `Z_ξ` near `ξ` -/

section RegularImmersion

variable {Y : Scheme.{u}}

/-- **Near its generic point, the integral closed subscheme of a regular scheme is cut out by a
regular sequence of length `dim 𝒪_{Y, ξ}`.** Let `Y` be regular, `ξ ∈ Y` with
`dim 𝒪_{Y, ξ} = r`, and `Z_ξ` the reduced closed subscheme on `\overline{\{ξ\}}`. Then there is an
affine open `V ∋ ξ` such that `Z_ξ ×_Y V ⟶ V` (any fibre product) is a regular closed immersion of
codimension `r`.

The ideal of `Z_ξ` in `𝒪_{Y, ξ}` is the maximal ideal, generated by a regular sequence of length
`r` (Stacks 00NQ), which spreads out to an open neighbourhood (Stacks 063I); the neighbourhood is
then shrunk to an affine one, regularity of codimension `r` being stable under flat base change. -/
@[sga "6 VII 4.11" "Proof step of 4.11"]
theorem exists_isAffineOpen_isRegularClosedImmersionOfCodim_integralComponentAt
    (hY : AlgebraicGeometry.IsRegular Y) (ξ : Y) (r : ℕ)
    (hr : ringKrullDim (Y.presheaf.stalk ξ) = r) :
    ∃ V : Y.Opens, IsAffineOpen V ∧ ξ ∈ V ∧
      ∀ {W' : Scheme.{u}} (j' : W' ⟶ V) (h' : W' ⟶ (integralComponentAt ξ).subscheme),
        IsPullback j' h' V.ι (integralComponentAt ξ).subschemeι →
          Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularClosedImmersionOfCodim j' r := by
  obtain ⟨hNoeth, hstalk⟩ := ((AlgebraicGeometry.isRegular_tfae Y).out 1 2).mp hY
  have := isIntegral_integralComponentAt ξ
  set j := (integralComponentAt ξ).subschemeι
  set w := genericPoint (integralComponentAt ξ).subscheme
  have hw : j w = ξ := genericPointOf_integralComponentAt ξ
  have _ : IsRegularLocalRing (Y.presheaf.stalk (j w)) := hstalk (j w)
  obtain ⟨s, hcard, hspan⟩ := (IsNoetherian.noetherian
    (IsLocalRing.maximalIdeal (Y.presheaf.stalk (j w)))).exists_span_finset_card_eq_spanFinrank
  have hgen : Ideal.ofList s.toList = IsLocalRing.maximalIdeal (Y.presheaf.stalk (j w)) := by
    rw [← hspan]
    simp [Ideal.ofList]
  have hlen : s.toList.length = (IsLocalRing.maximalIdeal (Y.presheaf.stalk (j w))).spanFinrank :=
    by simp [hcard]
  have hreg : RingTheory.Sequence.IsRegular (Y.presheaf.stalk (j w)) s.toList :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      _).1 s.toList hgen hlen |>.1
  have hlenr : s.toList.length = r := by
    have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := Y.presheaf.stalk (j w))
    have h2 : ringKrullDim (Y.presheaf.stalk (j w)) = r := by rw [hw]; exact hr
    rw [hlen]
    exact_mod_cast h1.trans h2
  obtain ⟨V, hwV, hV⟩ := exists_isRegularClosedImmersionOfCodim_of_isRegular_stalk j w s.toList
    hlenr (hgen.trans (ker_stalkMap_genericPoint_eq_maximalIdeal j).symm) hreg
  obtain ⟨V', hV', hξV', hle⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens
    (show ξ ∈ V from hw ▸ hwV)
  change Y.Opens at V'
  refine ⟨V', hV', hξV', fun {W'} j' h' H => ?_⟩
  set ι : (V' : Y.Opens).toScheme ⟶ (V : Y.Opens).toScheme := Y.homOfLE hle
  have hι : ι ≫ V.ι = V'.ι := Y.homOfLE_ι hle
  have hP := IsPullback.of_hasPullback V.ι j
  have hreg₀ := hV (pullback.fst V.ι j) (pullback.snd V.ι j) hP
  set a : W' ⟶ pullback V.ι j := pullback.lift (j' ≫ ι) h' (by
    rw [Category.assoc, hι]; exact H.w)
  have sq : IsPullback a j' (pullback.fst V.ι j) ι := by
    refine IsPullback.of_right (h₁₂ := pullback.snd V.ι j) (v₁₃ := j) (h₂₂ := V.ι) ?_
      (pullback.lift_fst _ _ _) hP.flip
    rw [pullback.lift_snd, hι]
    exact H.flip
  exact Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularClosedImmersionOfCodim.of_isPullback
    sq hreg₀

end RegularImmersion

/-! ### Chow groups of a scheme in its top degree -/

section TopDegree

variable (C : ChowSituation.{u}) {W U : Scheme.{u}} (sW : W ⟶ C.S) [LocallyOfFiniteType sW]
  (sU : U ⟶ C.S) [LocallyOfFiniteType sU] (v : U ⟶ W) [IsOpenImmersion v] (hv : v ≫ sW = sU)

/-- **Restriction to an open containing the points of top dimension is injective on `CH_k ⊗ 𝐐`.**
If `dim_δ(W) ≤ k` and every point of `W` of `δ`-dimension `k` lies in the image of the open
immersion `v : U ⟶ W`, then `CH_k(W) ⊗ 𝐐 ⟶ CH_k(U) ⊗ 𝐐` is injective. -/
theorem injective_lTensor_chowGroupRestrict (k : ℤ)
    (hdim : ∀ w : W, relativeDimension C.dimensionFunction sW w ≤ k)
    (hcov : ∀ w : W, relativeDimension C.dimensionFunction sW w = k → w ∈ Set.range v.base) :
    Function.Injective ((chowGroupRestrict C sW sU v hv k).toIntLinearMap.lTensor ℚ) := by
  refine Module.Flat.lTensor_preserves_injective_linearMap _ fun α β hαβ => ?_
  exact eq_of_forall_chowGroupRestrict_eq C sW k hdim fun w hw =>
    ⟨U, sU, inferInstance, v, inferInstance, hv, hcov w hw, hαβ⟩

end TopDegree

/-! ### The degree `k` part of `∑_p q_p (c_p ∩ [T])` and restriction to opens -/

/-- The base change of a morphism along an open immersion of test schemes is an open immersion. -/
instance isOpenImmersion_baseChangeMapOfEq {X Y T T' : Scheme.{u}} (f : X ⟶ Y) (g : T ⟶ Y)
    (h : T' ⟶ T) [IsOpenImmersion h] (m : T' ⟶ Y) (hm : h ≫ g = m) :
    IsOpenImmersion (baseChangeMapOfEq f g h m hm) :=
  MorphismProperty.of_isPullback (isPullback_baseChangeMapOfEq f g h m hm)
    (P := @IsOpenImmersion) inferInstance

section DegreePart

variable (C : ChowSituation.{u}) (G : GysinSystem C) {Z Y : Scheme.{u}} (sZ : Z ⟶ C.S)
  [LocallyOfFiniteType sZ] (sY : Y ⟶ C.S) [LocallyOfFiniteType sY] (i : Z ⟶ Y)
  [LocallyOfFiniteType i] (hi : i ≫ sY = sZ)

/-- **The degree `k` part of `∑_{p ∈ P} q_p (c_p ∩ [T])`** for a family of bivariant classes
`c_p ∈ A^p(Z ⟶ Y)`, rational coefficients `q_p` and a test scheme `t : T ⟶ Y`: the sum of the
`q_p ⊗ (c_p ∩ [T]_{k+p})` in `CH_k(Z ×_Y T) ⊗ 𝐐`. For `c_p = P_p(Z ⟶ Y, E)` and `q_p = 1/p!` it is
the degree `k` part of `ch(Z ⟶ Y, E) ∩ [T]`. -/
def capFundamentalClassDegreePart (P : Finset ℕ) (q : ℕ → ℚ)
    (c : ∀ p : ℕ, BivariantClass C G sZ sY i hi p) {T : Scheme.{u}} (t : T ⟶ Y)
    [LocallyOfFiniteType t] (k : ℤ) : ℚ ⊗[ℤ] chowGroup C (pullback.fst i t ≫ sZ) k :=
  ∑ p ∈ P, q p ⊗ₜ[ℤ] chowGroupDegreeEquiv C _ (by ring : k + (p : ℤ) - p = k)
    ((c p).cap t (k + p) (fundamentalChowClass C (t ≫ sY) (k + p)))

/-- An additive map `f` applied to `∑_{p ∈ P} q_p ⊗ x_p` in `ℚ ⊗ A` is `∑_{p ∈ P} q_p ⊗ y_p` as
soon as `f x_p = y_p` for all `p ∈ P`. -/
private theorem lTensor_sum_tmul_of_forall_eq {A B : Type*} [AddCommGroup A] [AddCommGroup B]
    (f : A →+ B) (P : Finset ℕ) (q : ℕ → ℚ) (x : ℕ → A) (y : ℕ → B)
    (h : ∀ p ∈ P, f (x p) = y p) :
    f.toIntLinearMap.lTensor ℚ (∑ p ∈ P, q p ⊗ₜ[ℤ] x p) = ∑ p ∈ P, q p ⊗ₜ[ℤ] y p := by
  simp only [map_sum, LinearMap.lTensor_tmul, AddMonoidHom.coe_toIntLinearMap]
  exact Finset.sum_congr rfl fun p hp => by rw [h p hp]

/-- **The degree `k` part of `∑_p q_p (c_p ∩ [T])` is compatible with restriction to opens of the
test scheme**: for an open immersion `v : T' ⟶ T`, restricting it along `Z ×_Y T' ⟶ Z ×_Y T` gives
the same sum for `T'`. This is the flat-pullback axiom of bivariant classes along an open
immersion (Stacks 0B76 (2)), together with `[T]_n|_{T'} = [T']_n`. -/
theorem lTensor_chowGroupRestrict_capFundamentalClassDegreePart (P : Finset ℕ) (q : ℕ → ℚ)
    (c : ∀ p : ℕ, BivariantClass C G sZ sY i hi p) {T T' : Scheme.{u}} (t : T ⟶ Y)
    [LocallyOfFiniteType t] (v : T' ⟶ T) [IsOpenImmersion v] (m : T' ⟶ Y)
    [LocallyOfFiniteType m] (hm : v ≫ t = m) (k : ℤ) :
    (chowGroupRestrict C (pullback.fst i t ≫ sZ) (pullback.fst i m ≫ sZ)
        (baseChangeMapOfEq i t v m hm) (baseChangeMapOfEq_comp_structure sZ i t v m hm)
          k).toIntLinearMap.lTensor ℚ
        (capFundamentalClassDegreePart C G sZ sY i hi P q c t k) =
      capFundamentalClassDegreePart C G sZ sY i hi P q c m k := by
  refine lTensor_sum_tmul_of_forall_eq _ _ _ _ _ fun p _ => ?_
  have hvY : v ≫ (t ≫ sY) = m ≫ sY := by rw [← Category.assoc, hm]
  rw [chowGroupRestrict_chowGroupDegreeEquiv,
    BivariantClass.cap_chowGroupRestrict C G sZ sY i hi p (c p) t v m hm _
      (isPullback_baseChangeMapOfEq i t v m hm) (baseChangeMapOfEq_fst i t v m hm) (k + p) hvY,
    chowGroupRestrict_fundamentalChowClass_of_isOpenImmersion]

/-- **The local reduction of condition (2) of the proof of Stacks 0FEW, for bivariant classes.**
Let `c_p ∈ A^p(Z ⟶ Y)` be bivariant classes and `q_p` rational numbers. Suppose every point of `Z`
has `δ`-dimension at most `k`, and that the points of `δ`-dimension `k` lie over an open `V ⊆ Y`;
for instance `Z` integral of `δ`-dimension `k` with generic point over `V`. If the degree `k` part
of `∑_p q_p (c_p ∩ [V])` is `[Z ×_Y V]`, then the degree `k` part of `∑_p q_p (c_p ∩ [Y])` is
`[Z ×_Y Y]`.

Both sides live in `CH_k(Z ×_Y Y) ⊗ 𝐐`, in which no `k`-cycle is rationally equivalent to zero, and
restricting to the open `Z ×_Y V`, which contains every point of `δ`-dimension `k`, is injective
there (`Stacks.Chow.injective_lTensor_chowGroupRestrict`); it carries the two sides to the two
sides of the hypothesis (`Stacks.Chow.lTensor_chowGroupRestrict_capFundamentalClassDegreePart`). -/
theorem capFundamentalClassDegreePart_id_eq_of_opens (P : Finset ℕ) (q : ℕ → ℚ)
    (c : ∀ p : ℕ, BivariantClass C G sZ sY i hi p) (k : ℤ)
    (hdim : ∀ z : Z, relativeDimension C.dimensionFunction sZ z ≤ k) (V : Y.Opens)
    (hV : ∀ z : Z, relativeDimension C.dimensionFunction sZ z = k → i z ∈ V)
    (h : capFundamentalClassDegreePart C G sZ sY i hi P q c V.ι k =
      (1 : ℚ) ⊗ₜ[ℤ] fundamentalChowClass C (pullback.fst i V.ι ≫ sZ) k) :
    capFundamentalClassDegreePart C G sZ sY i hi P q c (𝟙 Y) k =
      (1 : ℚ) ⊗ₜ[ℤ] fundamentalChowClass C (pullback.fst i (𝟙 Y) ≫ sZ) k := by
  have hm : V.ι ≫ 𝟙 Y = V.ι := Category.comp_id _
  have hδ : ∀ w : (pullback i (𝟙 Y) : Scheme.{u}),
      relativeDimension C.dimensionFunction (pullback.fst i (𝟙 Y) ≫ sZ) w =
        relativeDimension C.dimensionFunction sZ (pullback.fst i (𝟙 Y) w) :=
    fun w => relativeDimension_comp_isOpenImmersion _ _ _ w
  refine injective_lTensor_chowGroupRestrict C _ _ (baseChangeMapOfEq i (𝟙 Y) V.ι V.ι hm)
    (baseChangeMapOfEq_comp_structure sZ i (𝟙 Y) V.ι V.ι hm) k
    (fun w => (hδ w).trans_le (hdim _)) (fun w hw => ?_) ?_
  · have hc : i (pullback.fst i (𝟙 Y) w) = pullback.snd i (𝟙 Y) w := by
      rw [← Scheme.Hom.comp_apply, pullback.condition, Category.comp_id]
    have sq := (isPullback_baseChangeMapOfEq i (𝟙 Y) V.ι V.ι hm).flip
    obtain ⟨y, hy⟩ : w ∈ Set.range (pullback.fst (pullback.snd i (𝟙 Y)) V.ι).base := by
      rw [Scheme.Pullback.range_fst, Set.mem_preimage, V.range_ι, ← hc]
      exact hV _ ((hδ w).symm.trans hw)
    exact ⟨sq.isoPullback.inv y, by rw [← hy, ← Scheme.Hom.comp_apply, sq.isoPullback_inv_fst]⟩
  · rw [lTensor_chowGroupRestrict_capFundamentalClassDegreePart C G sZ sY i hi P q c (𝟙 Y) V.ι
      V.ι hm k, h, LinearMap.lTensor_tmul, AddMonoidHom.coe_toIntLinearMap,
      chowGroupRestrict_fundamentalChowClass_of_isOpenImmersion]

omit [LocallyOfFiniteType sZ] [LocallyOfFiniteType sY] [LocallyOfFiniteType i] in
include hi in
/-- The comparison `Z ×_Y Y' ≅ (Z ×_Y Y') ×_{Y'} Y'` lies over the base, the target being read
through the base change `Z ×_Y Y' ⟶ Y'`. -/
theorem restrictionComparison_comp_structure {Y' : Scheme.{u}} (h : Y' ⟶ Y) :
    ((pullback.congrHom (rfl : i = i) (Category.id_comp h).symm).hom ≫
        (pullbackLeftPullbackSndIso i h (𝟙 Y')).inv) ≫
      (pullback.fst (pullback.snd i h) (𝟙 Y') ≫ (pullback.snd i h ≫ (h ≫ sY))) =
      pullback.fst i h ≫ sZ := by
  rw [pullbackSnd_comp_structureMorphism_eq C sZ sY i hi h]
  simp

/-- **The degree `k` part of `∑_p q_p (c_p ∩ [Y'])` for the restrictions of the `c_p`** along
`h : Y' ⟶ Y` (Remark 0F9Z), read on `Y'` itself, is the degree `k` part of `∑_p q_p (c_p ∩ [Y'])`
for the classes `c_p` at the test scheme `h`, carried along `Z ×_Y Y' ≅ (Z ×_Y Y') ×_{Y'} Y'`. -/
theorem capFundamentalClassDegreePart_bivariantRestriction
    (hgys : G.IsNaturalUnderBaseChangeIso) (P : Finset ℕ) (q : ℕ → ℚ)
    (c : ∀ p : ℕ, BivariantClass C G sZ sY i hi p) {Y' : Scheme.{u}} (h : Y' ⟶ Y)
    [LocallyOfFiniteType h] (k : ℤ) :
    capFundamentalClassDegreePart C G (pullback.snd i h ≫ (h ≫ sY)) (h ≫ sY) (pullback.snd i h)
        rfl P q (fun p => bivariantClassCongrBase C G (pullback.snd i h)
          (pullbackSnd_comp_structureMorphism_eq C sZ sY i hi h).symm rfl
          (hv := pullbackSnd_comp_structureMorphism_eq C sZ sY i hi h) (hv' := rfl) p
          (bivariantRestriction C G sZ sY i hi h p hgys (c p))) (𝟙 Y') k =
      (chowPushforwardOfIso C (pullback.fst i h ≫ sZ)
        (pullback.fst (pullback.snd i h) (𝟙 Y') ≫ (pullback.snd i h ≫ (h ≫ sY)))
        ((pullback.congrHom (rfl : i = i) (Category.id_comp h).symm).hom ≫
          (pullbackLeftPullbackSndIso i h (𝟙 Y')).inv)
        (restrictionComparison_comp_structure C sZ sY i hi h) k).toIntLinearMap.lTensor ℚ
        (capFundamentalClassDegreePart C G sZ sY i hi P q c h k) := by
  refine (lTensor_sum_tmul_of_forall_eq _ _ _ _ _ fun p _ => ?_).symm
  symm
  have hstr : pullback.fst (pullback.snd i h) (𝟙 Y') ≫ (pullback.snd i h ≫ (h ≫ sY)) =
      pullback.fst (pullback.snd i h) (𝟙 Y') ≫ (pullback.fst i h ≫ sZ) := by
    rw [pullbackSnd_comp_structureMorphism_eq C sZ sY i hi h]
  refine eq_of_heq ((chowGroupDegreeEquiv_heq C _ _ _).trans
    (((heq_of_eq (bivariantClassCongrBase_cap_eq (C := C) (G := G) _ _ _ _ _ _)).trans
      (chowGroupCongr_heq C _ _ _)).trans
    ((bivariantRestriction_cap_id_heq hgys (c p) h (k + p) _
      (fundamentalChowClass C (h ≫ sY) (k + p))
      (fundamentalChowClass_heq_of_hom_eq C (Category.id_comp _) _)).trans
    (chowPushforwardOfIso_heq _ _ _ rfl hstr.symm (by ring)
      (chowGroupDegreeEquiv_heq C _ _ _).symm))))

variable [IsNoetherian Y]

/-- **The degree `j` part of `q (c ∩ [Y])`** for `c ∈ A^p(Z ⟶ Y)` is `q (c ∩ [Y]_{j+p})`. -/
theorem rationalCapFundamentalClass_tmul_apply (p : ℤ) (q : ℚ)
    (c : BivariantClass C G sZ sY i hi p) (j : ℤ) :
    rationalCapFundamentalClass C G sZ sY i hi p (q ⊗ₜ[ℤ] c) j =
      q ⊗ₜ[ℤ] chowGroupDegreeEquiv C sZ (by ring : j + p - p = j)
        (capFundamentalClassAt C G sZ sY i hi p (j + p) c) := by
  classical
  rw [rationalCapFundamentalClass_tmul, DFinsupp.finset_sum_apply]
  by_cases hn : j + p ∈ (fundamentalClassDegrees_finite C sY).toFinset
  · rw [Finset.sum_eq_single_of_mem (j + p) hn fun n _ hne =>
      DirectSum.of_eq_of_ne _ _ _ (by omega),
      of_tmul_eq_of_tmul_of_heq C sZ (by ring : j + p - p = j) q
        (chowGroupDegreeEquiv_heq C sZ (by ring : j + p - p = j) _).symm, DirectSum.of_eq_same]
  · rw [Finset.sum_eq_zero fun n hn' => DirectSum.of_eq_of_ne _ _ _ fun h => hn (by
      obtain rfl : n = j + p := by omega
      exact hn')]
    have h0 : fundamentalChowClass C (𝟙 Y ≫ sY) (j + p) = 0 := by
      rw [fundamentalChowClass, fundamentalCycle_eq_zero_of_notMem_fundamentalClassDegrees,
        map_zero]
      rw [Set.Finite.mem_toFinset] at hn
      simpa [fundamentalClassDegrees] using hn
    rw [capFundamentalClassAt_apply, h0, map_zero, map_zero, map_zero, TensorProduct.tmul_zero]

end DegreePart

/-! ### Capping a pushed-forward class with the fundamental class -/

section PushforwardCap

variable (C : ChowSituation.{u}) {Z X : Scheme.{u}} (sZ : Z ⟶ C.S) [LocallyOfFiniteType sZ]
  (sX : X ⟶ C.S) [LocallyOfFiniteType sX] (i : Z ⟶ X) [IsProper i] (hi : i ≫ sX = sZ)

/-- **`(i_* ∘ c) ∩ α = i_*(c ∩ α)`**, for `c ∈ A^p(Z ⟶ X)`, `i` proper and `α ∈ CH_n(X)`: the cap
operation of `i_* ∘ c ∈ A^p(X)` (Stacks 0EPK) on `X` itself is the pushforward along `i` of that of
`c`, both read on `X`, resp. `Z`, through the identifications `X ×_X X ≅ X`, `Z ×_X X ≅ Z`. -/
theorem chowGroupPullbackIdEquiv_cap_properPushforwardChowCohomology {p : ℤ}
    (c : BivariantClass C (gysinSystemOfInvertible C) sZ sX i hi p) (n : ℤ)
    (α : chowGroup C (𝟙 X ≫ sX) n) :
    chowGroupPullbackIdEquiv C sX (𝟙 X) (n - p)
        ((properPushforwardChowCohomology C sX sZ i hi c).cap (𝟙 X) n α) =
      properChowPushforward C sZ sX i hi (n - p) (properPushforwardDescends C _ _ _ _ _)
        (chowGroupPullbackIdEquiv C sZ i (n - p) (c.cap (𝟙 X) n α)) := by
  subst hi
  simp only [chowGroupPullbackIdEquiv, chowGroupEquivOfIso_apply,
    bivariantProperPushforwardOfInvertible_cap, bivariantProperPushforwardCap_apply,
    BivariantClass.congrHom_cap]
  set e := (pullback.congrHom (Category.comp_id i).symm (rfl : 𝟙 X = 𝟙 X)).hom
  set b := bivariantPushforwardBaseChange i (𝟙 X) (𝟙 X)
  have hw : (e ≫ b ≫ pullback.fst (𝟙 X) (𝟙 X)) = pullback.fst i (𝟙 X) ≫ i := by
    simp [e, b]
  have key : ∀ (w w' : pullback i (𝟙 X) ⟶ X) [IsProper w] [IsProper w'] (h : w = w')
      (hw : w ≫ sX = pullback.fst i (𝟙 X) ≫ i ≫ sX)
      (hw' : w' ≫ sX = pullback.fst i (𝟙 X) ≫ i ≫ sX)
      (x : chowGroup C (pullback.fst i (𝟙 X) ≫ i ≫ sX) (n - p)),
      properChowPushforward C _ sX w hw (n - p) (properPushforwardDescends C _ _ _ _ _) x =
        properChowPushforward C _ sX w' hw' (n - p) (properPushforwardDescends C _ _ _ _ _) x := by
    intro w w' _ _ h _ _ x
    subst h
    rfl
  simp only [chowPushforwardOfIso]
  rw [← properChowPushforward_comp_apply C _ _ _ b (pullback.fst (𝟙 X) (𝟙 X)) _ rfl _ _
      (by simp [b])
      (n - p) _ _ (properPushforwardDescends C _ _ _ _ _),
    ← properChowPushforward_comp_apply C _ _ _ e _ _ rfl _ _ (by rw [hw, Category.assoc])
      (n - p) _ _ (properPushforwardDescends C _ _ _ _ _),
    ← properChowPushforward_comp_apply C _ _ _ (pullback.fst i (𝟙 X)) i _ rfl _ _ (by simp)
      (n - p) _ _ (properPushforwardDescends C _ _ _ _ _)]
  exact key _ _ hw _ _ _

/-- **The degree `k` part of `ch(α) ∩ [X]` for `α` whose power sums are pushed forward from a
proper `i : Z ⟶ X`.** If `P_p(α) = i_* ∘ d_p` with `d_p ∈ A^p(Z ⟶ X)` for `p ≤ N`, and `δ_{X/S}`
lies between `lo` and `lo + N`, then the degree `k` part of `ch(α) ∩ [X]` is the pushforward along
`Z ×_X X ≅ Z ⟶ X` of the degree `k` part of `∑_{p ≤ N} (d_p ∩ [X])/p!`. For `d_p` the localized
classes `P_p(Z ⟶ X, E)` this is `ch(α) ∩ [X] = i_*(ch(Z ⟶ X, E) ∩ [X])`. -/
theorem chernCharacterCapFundamentalClass_apply_eq_lTensor [IsNoetherian X]
    (a : VectorBundleKZero X) (lo : ℤ)
    (hlo : ∀ x : X, lo ≤ relativeDimension C.dimensionFunction sX x) (N : ℕ)
    (hN : ∀ x : X, relativeDimension C.dimensionFunction sX x - lo ≤ N)
    (d : ∀ p : ℕ, BivariantClass C (gysinSystemOfInvertible C) sZ sX i hi p)
    (hd : ∀ p ∈ Finset.range (N + 1),
      powerSumKHom C sX p a p = properPushforwardChowCohomology C sX sZ i hi (d p)) (k : ℤ) :
    chernCharacterCapFundamentalClass C sX a k =
      ((properChowPushforward C sZ sX i hi k (properPushforwardDescends C _ _ _ _ _)).comp
        (chowGroupPullbackIdEquiv C sZ i k).toAddMonoidHom).toIntLinearMap.lTensor ℚ
        (capFundamentalClassDegreePart C (gysinSystemOfInvertible C) sZ sX i hi
          (Finset.range (N + 1)) (fun p => ((Nat.factorial p : ℚ)⁻¹)) d (𝟙 X) k) := by
  rw [chernCharacterCapFundamentalClass_eq_sum C sX lo hlo N hN a, DFinsupp.finset_sum_apply,
    capFundamentalClassDegreePart, map_sum]
  refine Finset.sum_congr rfl fun p hp => ?_
  rw [chernCharacterVectorBundle_apply, rationalCapFundamentalClass_tmul_apply, hd p hp,
    LinearMap.lTensor_tmul, capFundamentalClassAt_apply,
    chowGroupPullbackIdEquiv_cap_properPushforwardChowCohomology]
  congr 1
  have key : ∀ (m : ℤ) (hm : m = k) (x : chowGroup C (pullback.fst i (𝟙 X) ≫ sZ) m),
      chowGroupDegreeEquiv C sX hm (properChowPushforward C sZ sX i hi m
        (properPushforwardDescends C _ _ _ _ _) (chowGroupPullbackIdEquiv C sZ i m x)) =
      ((properChowPushforward C sZ sX i hi k (properPushforwardDescends C _ _ _ _ _)).comp
        (chowGroupPullbackIdEquiv C sZ i k).toAddMonoidHom).toIntLinearMap
        (chowGroupDegreeEquiv C _ hm x) := by
    intro m hm x
    subst hm
    rfl
  exact key _ _ _

end PushforwardCap

/-! ### The localized classes of a base change of Situation 0GUJ -/

section LocalizedBaseChange

/-- **The degree `k` part of `ch(Z ⟶ X, E) ∩ [X]` is `[Z]`**, in Situation 0GUJ with `E|_{X ∖ Z}`
zero: the degree `k` part of `∑_{p ≤ N} P_p(Z ⟶ X, E) ∩ [X] / p!`, the localized Chern character of
Stacks 0FB5 capped with `[X]` and read in `CH_k(Z ×_X X) ⊗ 𝐐`, is the fundamental class of
`Z ×_X X ≅ Z` in degree `k`. For `Z ⟶ X` regular of codimension `r` and `X` of pure
`δ`-dimension `k + r` this is the content of Stacks 0FEH (3), (4). -/
def LocalizedSituation.HasFundamentalDegreePart (S : LocalizedSituation.{u})
    (h : S.IsZeroOnComplement) (N : ℕ) (k : ℤ) : Prop :=
  capFundamentalClassDegreePart S.base (gysinSystemOfInvertible S.base) (S.i ≫ S.a) S.a S.i rfl
      (Finset.range (N + 1)) (fun p => ((Nat.factorial p : ℚ)⁻¹))
      (fun p => S.localizedPowerSum h p) (𝟙 S.X) k =
    (1 : ℚ) ⊗ₜ[ℤ] fundamentalChowClass S.base (pullback.fst S.i (𝟙 S.X) ≫ (S.i ≫ S.a)) k

/-- **The degree `k` part of `ch(Z ⟶ X, E) ∩ -` on a test scheme, from the base-changed
situation.** In Situation 0GUJ with `E|_{X ∖ Z}` zero, let `f : X' ⟶ X` be locally of finite type.
If for the base-changed situation `X'`, `Z' = Z ×_X X'`, `Lf^*E` the degree `k` part of
`∑_p q_p (P_p(Z' ⟶ X', Lf^*E) ∩ [X'])` is `[Z']`, then the degree `k` part of
`∑_p q_p (P_p(Z ⟶ X, E) ∩ [X'])`, the classes of `X` capped on the test scheme `f`, is
`[Z ×_X X']`.

By Stacks 0FB3 the classes of the base change are the restrictions of those of `X`, and the
restriction caps on `X'` itself as the original class caps on `f`
(`Stacks.Chow.capFundamentalClassDegreePart_bivariantRestriction`), up to an isomorphism of the
fibre products carrying fundamental class to fundamental class. -/
theorem LocalizedSituation.capFundamentalClassDegreePart_of_pullback
    (S : LocalizedSituation.{u}) (h : S.IsZeroOnComplement) {X' : Scheme.{u}}
    (f : X' ⟶ S.X) [LocallyOfFiniteType f] (N : ℕ) (k : ℤ)
    (hloc : (S.pullback f).HasFundamentalDegreePart h.pullback N k) :
    capFundamentalClassDegreePart S.base (gysinSystemOfInvertible S.base) (S.i ≫ S.a) S.a S.i rfl
        (Finset.range (N + 1)) (fun p => ((Nat.factorial p : ℚ)⁻¹))
        (fun p => S.localizedPowerSum h p) f k =
      (1 : ℚ) ⊗ₜ[ℤ] fundamentalChowClass S.base (pullback.fst S.i f ≫ (S.i ≫ S.a)) k := by
  have hfam : (fun p : ℕ => (S.pullback f).localizedPowerSum h.pullback p) = fun p : ℕ =>
      bivariantClassCongrBase S.base (gysinSystemOfInvertible S.base) (Limits.pullback.snd S.i f)
        (pullbackSnd_comp_structureMorphism_eq S.base (S.i ≫ S.a) S.a S.i rfl f).symm rfl
        (hv := pullbackSnd_comp_structureMorphism_eq S.base (S.i ≫ S.a) S.a S.i rfl f)
        (hv' := rfl) (p : ℤ)
        (bivariantRestriction S.base (gysinSystemOfInvertible S.base) (S.i ≫ S.a) S.a S.i rfl f
          (p : ℤ) (gysinSystemOfInvertible_isNaturalUnderBaseChangeIso S.base)
          (S.localizedPowerSum h p)) :=
    funext fun p => (S.bivariantRestriction_localizedPowerSum f h p).symm
  unfold LocalizedSituation.HasFundamentalDegreePart at hloc
  rw [hfam, capFundamentalClassDegreePart_bivariantRestriction] at hloc
  set θ := (pullback.congrHom (rfl : S.i = S.i) (Category.id_comp f).symm).hom ≫
    (pullbackLeftPullbackSndIso S.i f (𝟙 X')).inv
  have hθ := restrictionComparison_comp_structure S.base (S.i ≫ S.a) S.a S.i rfl f
  have hfund : (1 : ℚ) ⊗ₜ[ℤ] fundamentalChowClass S.base
      (pullback.fst (Limits.pullback.snd S.i f) (𝟙 X') ≫
        (Limits.pullback.snd S.i f ≫ (f ≫ S.a))) k =
      (chowPushforwardOfIso S.base (pullback.fst S.i f ≫ (S.i ≫ S.a)) _ θ hθ
        k).toIntLinearMap.lTensor ℚ
        ((1 : ℚ) ⊗ₜ[ℤ] fundamentalChowClass S.base (pullback.fst S.i f ≫ (S.i ≫ S.a)) k) := by
    rw [LinearMap.lTensor_tmul, AddMonoidHom.coe_toIntLinearMap,
      chowPushforwardOfIso_fundamentalChowClass]
  rw [hfund] at hloc
  refine Module.Flat.lTensor_preserves_injective_linearMap _ ?_ hloc
  exact (chowGroupEquivOfIso S.base _ _ θ hθ k).injective

/-- **Condition (2) of the proof of Stacks 0FEW may be checked over an open neighbourhood.** In
Situation 0GUJ with `E|_{X ∖ Z}` zero, suppose every point of `Z` has `δ`-dimension at most `k`
and those of `δ`-dimension `k` lie over an open `V ⊆ X`; for instance `Z` integral of
`δ`-dimension `k` with generic point in `V`. If the degree `k` part of `ch(Z ∩ V ⟶ V, E|_V) ∩ [V]`
is `[Z ∩ V]`, then the degree `k` part of `ch(Z ⟶ X, E) ∩ [X]` is `[Z]`.

This is the source's "since `CH_k(Z) = 𝐙`, we may replace `Y` by an open neighbourhood of the
generic point of `Z`": `Stacks.Chow.capFundamentalClassDegreePart_id_eq_of_opens` and
`Stacks.Chow.LocalizedSituation.capFundamentalClassDegreePart_of_pullback`. -/
theorem LocalizedSituation.hasFundamentalDegreePart_of_pullback
    (S : LocalizedSituation.{u}) (h : S.IsZeroOnComplement) (N : ℕ) (k : ℤ)
    (hdim : ∀ z : S.Z, relativeDimension S.base.dimensionFunction (S.i ≫ S.a) z ≤ k)
    (V : S.X.Opens)
    (hV : ∀ z : S.Z, relativeDimension S.base.dimensionFunction (S.i ≫ S.a) z = k → S.i z ∈ V)
    (hloc : (S.pullback V.ι).HasFundamentalDegreePart h.pullback N k) :
    S.HasFundamentalDegreePart h N k :=
  capFundamentalClassDegreePart_id_eq_of_opens S.base _ _ _ _ rfl _ _ _ k hdim V hV
    (S.capFundamentalClassDegreePart_of_pullback h V.ι N k hloc)

end LocalizedBaseChange

/-! ### The reduction of condition (2) for `α ↦ ch(α) ∩ [X]` to a neighbourhood -/

section Diagonal

open Stacks.Perfect.BoundedLocallyFreeComplexes

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

/-- The support of `𝒪_{Z_ξ}`, read as a module on `X`, is `Z_ξ`. -/
theorem supp_integralComponentModule (ξ : X) :
    SheafOfModules.supp (integralComponentModule ξ) =
      Set.range (integralComponentAt ξ).subschemeι.base :=
  supp_pushforwardStructureSheaf _

/-- **Situation 0GUJ for `𝒪_{Z_ξ}[0]`.** For a quasi-compact `X`, a point `ξ` with integral
closed subscheme `Z_ξ` and a perfect object `K ≅ 𝒪_{Z_ξ}[0]`, the data `X`, `Z_ξ`, `K`, `p = 0`
with the finiteness alternative "`X` is quasi-compact": `K` vanishes off `Z_ξ`. -/
abbrev integralComponentLocalizedSituation [CompactSpace X] (ξ : X)
    (K : PerfectDerivedCategory X)
    (eK : K.obj ≅ (DerivedCategory.singleFunctor X.Modules 0).obj (integralComponentModule ξ)) :
    LocalizedSituation.{u} where
  base := C
  X := X
  a := sX
  Z := (integralComponentAt ξ).subscheme
  i := (integralComponentAt ξ).subschemeι
  E := K.obj
  p := 0
  perfect := K.property
  restriction := Or.inl (isZero_derivedPullback_ofRestrict_compl _ _
    (integralComponentAt ξ).subschemeι.isClosedEmbedding.isClosed_range
    (supp_integralComponentModule ξ).subset K.obj eK)
  finiteness := Or.inl inferInstance

/-- `𝒪_{Z_ξ}[0]` vanishes off `Z_ξ`: the first alternative of condition (2) of Situation 0GUJ. -/
theorem isZeroOnComplement_integralComponentLocalizedSituation [CompactSpace X] (ξ : X)
    (K : PerfectDerivedCategory X)
    (eK : K.obj ≅ (DerivedCategory.singleFunctor X.Modules 0).obj (integralComponentModule ξ)) :
    (integralComponentLocalizedSituation C sX ξ K eK).IsZeroOnComplement :=
  isZero_derivedPullback_ofRestrict_compl _ _
    (integralComponentAt ξ).subschemeι.isClosedEmbedding.isClosed_range
    (supp_integralComponentModule ξ).subset K.obj eK

/-- **The local form of condition (2) of the proof of Stacks 0FEW for `α ↦ ch(α) ∩ [X]`, at a
point `ξ`.** For every perfect `K ≅ 𝒪_{Z_ξ}[0]` there is an open `V ∋ ξ` over which the following
holds for the base change `Z_ξ ∩ V ⟶ V`, `K|_V` of Situation 0GUJ: the degree `δ(ξ)` part of
`ch(Z_ξ ∩ V ⟶ V, K|_V) ∩ [V] = ∑_p P_p(Z_ξ ∩ V ⟶ V, K|_V) ∩ [V] / p!`, the localized Chern
character of Stacks 0FB5 capped with `[V]`, is `[Z_ξ ∩ V]` in `CH_{δ(ξ)}(Z_ξ ∩ V) ⊗ 𝐐`, the sum
running over any range `p ≤ N` of degrees large enough for `X`. When `Z_ξ ∩ V ⟶ V` is a regular
immersion (`Stacks.Chow.exists_isAffineOpen_isRegularClosedImmersionOfCodim_integralComponentAt`)
and `V` is irreducible, this is the content of Stacks 0FEH. -/
def IsDiagonalOnIntegralNear [IsNoetherian X] (ξ : X) : Prop :=
  ∀ (K : PerfectDerivedCategory X)
    (eK : K.obj ≅ (DerivedCategory.singleFunctor X.Modules 0).obj (integralComponentModule ξ)),
    ∃ V : X.Opens, ξ ∈ V ∧ ∀ N : ℕ,
      (∀ x : X, relativeDimension C.dimensionFunction sX x ≤
        relativeDimension C.dimensionFunction sX ξ + N) →
      ((integralComponentLocalizedSituation C sX ξ K eK).pullback V.ι).HasFundamentalDegreePart
        (isZeroOnComplement_integralComponentLocalizedSituation C sX ξ K eK).pullback N
        (relativeDimension C.dimensionFunction sX ξ)

/-- **Condition (2) of the proof of Stacks 0FEW for `α ↦ ch(α) ∩ [X]` reduces to a neighbourhood
of each point.** Let `X` be regular Noetherian with affine diagonal and `δ_{X/S}` bounded below.
If at every point `ξ` the degree `δ(ξ)` part of `ch(Z_ξ ⟶ X, 𝒪_{Z_ξ}[0]) ∩ [V]` is `[Z_ξ ∩ V]` for
some open `V ∋ ξ` (`Stacks.Chow.IsDiagonalOnIntegralNear`), then `α ↦ ch(α) ∩ [X]` on `K'_0(X)`
satisfies condition (2): the degree `δ(ξ)` part of the image of `[𝒪_{Z_ξ}]` is `[Z_ξ]`.

This is the source's "since `CH_k(Z) = 𝐙` we may replace `Y` by an open neighbourhood of the
generic point of `Z`". The class of `𝒪_{Z_ξ}` in `K_0(Vect(X))` has power sums
`P_p = i_* ∘ P_p(Z_ξ ⟶ X, 𝒪_{Z_ξ}[0])` (Stacks 0FB2, Remark 0FEU), so the degree `k = δ(ξ)` part
of `ch([𝒪_{Z_ξ}]) ∩ [X]` is the pushforward of the degree `k` part of
`ch(Z_ξ ⟶ X, 𝒪_{Z_ξ}[0]) ∩ [X] ∈ CH_k(Z_ξ) ⊗ 𝐐`
(`Stacks.Chow.chernCharacterCapFundamentalClass_apply_eq_lTensor`). In `CH_k(Z_ξ) = 𝐙 [Z_ξ]` that
class is determined by its restriction to `Z_ξ ∩ V`, which is the hypothesis
(`Stacks.Chow.capFundamentalClassDegreePart_id_eq_of_opens`). -/
theorem isDiagonalOnIntegral_coherentChernCharacterCapFundamentalClass_of_near [IsNoetherian X]
    [IsAffineHom (pullback.diagonal (terminal.from X))] (hX : IsRegular X) (lo : ℤ)
    (hlo : ∀ x : X, lo ≤ relativeDimension C.dimensionFunction sX x)
    (hnear : ∀ ξ : X, IsDiagonalOnIntegralNear C sX ξ) :
    IsDiagonalOnIntegral C sX (coherentChernCharacterCapFundamentalClass C sX hX) := by
  intro k ξ hξ
  subst hξ
  obtain ⟨K, E, ⟨eK⟩, hE, ⟨eE⟩, heq⟩ :=
    exists_regularVectorBundleKZeroAddEquiv_symm_mk X hX
      (integralComponentDimLE C sX _ ξ rfl).obj
  have heq' : (regularVectorBundleKZeroAddEquiv X hX).symm
      (KZero.mk _ (integralComponentDimLE C sX _ ξ rfl).obj) = eulerCharComplex X E := heq
  show chernCharacterCapFundamentalClass C sX ((regularVectorBundleKZeroAddEquiv X hX).symm
    (KZero.mk _ (integralComponentDimLE C sX _ ξ rfl).obj)) _ = _
  rw [heq']
  obtain ⟨hi, hhi⟩ := exists_relativeDimension_le C sX
  set N := (hi - lo).toNat
  have hN : ∀ x : X, relativeDimension C.dimensionFunction sX x - lo ≤ N := fun x => by
    have := hhi x
    omega
  set I := integralComponentAt ξ
  set S := integralComponentLocalizedSituation C sX ξ K eK
  have hS := isZeroOnComplement_integralComponentLocalizedSituation C sX ξ K eK
  have h1 : ∀ p ∈ Finset.range (N + 1), powerSumKHom C sX p (eulerCharComplex X E) p =
      properPushforwardChowCohomology C sX (I.subschemeι ≫ sX) I.subschemeι rfl
        (S.localizedPowerSum hS p) := fun p _ => by
    rw [← perfectPowerSum_eq_powerSumKHom_eulerCharComplex C sX S.hasDefinedChernClasses_E hE eE]
    exact (S.properPushforwardChowCohomology_localizedPowerSum hS p).symm
  rw [chernCharacterCapFundamentalClass_apply_eq_lTensor C (I.subschemeι ≫ sX) sX I.subschemeι
    rfl (eulerCharComplex X E) lo hlo N hN (fun p => S.localizedPowerSum hS p) h1]
  obtain ⟨V, hξV, hV⟩ := hnear ξ K eK
  have hclos : ∀ z : I.subscheme, I.subschemeι z ∈ closure {ξ} := fun z => by
    rw [← coe_support_integralComponentAt, ← I.range_subschemeι]
    exact ⟨z, rfl⟩
  have hdeg := S.hasFundamentalDegreePart_of_pullback hS N _ (fun z => by
      rw [relativeDimension_comp_closedImmersion]
