* [Stacks Project, Tag 02RW](https://stacks.math.columbia.edu/tag/02RW)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Chow

/-! ### The zero scheme of a section of a finite locally free module -/

/-- **The zero scheme of a global section, for a module of any rank.** This is the standing
construction of the section [Stacks, Tag 0FA8]: the closed subscheme of `X` whose quasi-coherent
sheaf of ideals is the image of `s : ℰ^∨ ⟶ 𝒪_X`, written on an affine open `U` as the ideal
generated by the values `φ (s|_U)` of the `Γ(X, U)`-linear functionals `φ` on `Γ(ℰ, U)`.

For an invertible module this is the zero scheme of [Stacks, Tag 02OQ],
`Stacks.Divisors.zeroScheme`; see `Stacks.Chow.zeroSchemeOfSection_eq_zeroScheme`. -/
def zeroSchemeOfSection (X : Scheme.{u}) (E : X.Modules) (s : Γ(E, ⊤)) : X.IdealSheafData :=
  Scheme.IdealSheafData.ofIdeals (fun U =>
    Ideal.span {a : Γ(X, U.1) | ∃ φ : Γ(E, U.1) →ₗ[Γ(X, U.1)] Γ(X, U.1),
      a = φ (E.presheaf.map (homOfLE le_top).op s)})

/-- For an invertible module the zero scheme of a section is the one of [Stacks, Tag 02OQ]: the
two ideal sheaves are given by the same formula, the invertibility playing no part in it. -/
theorem zeroSchemeOfSection_eq_zeroScheme (X : Scheme.{u}) (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : Γ(L, ⊤)) :
    zeroSchemeOfSection X L s = Stacks.Divisors.zeroScheme X L s :=
  rfl

/-! ### The hypotheses of Stacks 0FA9 -/

/-- **The regular-sequence hypothesis of [Stacks, Tag 0FA9].** For every generic point `ξ` of
the zero scheme `Z(s)` at which the relative dimension over the base is `m`, the ideal that
`Z(s)` cuts out in the local ring `𝒪_{X', ξ}` is generated by a regular sequence of length `r`.

The ideal cut out in the local ring is the kernel of the stalk map of the closed immersion
`Z(s) ⟶ X'`; this is `Stacks.AlgebraicGeometry.stalkIdeal` written out. -/
def IsRegularZeroSchemeSequence (C : ChowSituation.{u}) {X' : Scheme.{u}} (q : X' ⟶ C.S)
    [LocallyOfFiniteType q] (E : X'.Modules) (s : Γ(E, ⊤)) (r : ℕ) (m : ℤ) : Prop :=
  ∀ ξ : genericPoints (zeroSchemeOfSection X' E s).subscheme,
    relativeDimension C.dimensionFunction q ((zeroSchemeOfSection X' E s).subschemeι ξ.1) = m →
      ∃ rs : List (X'.presheaf.stalk ((zeroSchemeOfSection X' E s).subschemeι ξ.1)),
        rs.length = r ∧
        RingTheory.Sequence.IsRegular
          (X'.presheaf.stalk ((zeroSchemeOfSection X' E s).subschemeι ξ.1)) rs ∧
        Ideal.span {a | a ∈ rs} =
          RingHom.ker ((zeroSchemeOfSection X' E s).subschemeι.stalkMap ξ.1).hom

/-- **The statement of [Stacks, Tag 0FA9] in the case `X = X'`, for a cap product rule `cap`**,
the case the source reduces to with Stacks 0B7H: if `dim_δ(X') = n`, `dim_δ(Z(s)) ≤ n - r` and the
regular-sequence condition holds at the generic points of `Z(s)` of `δ`-dimension `n - r`, then
the cap product `cap` at the top index for a module `F` of constant rank `r` on `X'` carries the
fundamental cycle `[X']_n` to `[Z(s)]_{n - r}`.

This is a property of the rule `cap`, which is arbitrary. For the Chern classes of the library
the case `X = X'` is proved, in every rank, as `Stacks.Chow.SectionZeroScheme.reducedTopChernCap`
and `Stacks.Chow.chernCap_cap_fundamentalCycle_eq_zeroScheme`. -/
def TopChernCapEqZeroScheme (C : ChowSituation.{u}) {X' : Scheme.{u}} (q : X' ⟶ C.S)
    [LocallyOfFiniteType q] (r : ℕ) (cap : HigherChernCapRule C r) (F : X'.Modules)
    (hF : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r)
    (s : Γ(F, ⊤)) (n : ℤ) : Prop :=
  letI : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r := hF
  schemeDeltaDimension C q = (n : EInt) →
  schemeDeltaDimension C ((zeroSchemeOfSection X' F s).subschemeι ≫ q) ≤
      ((n - (r : ℤ) : ℤ) : EInt) →
  IsRegularZeroSchemeSequence C q F s r (n - (r : ℤ)) →
  cap q F n (Fin.last r)
      (QuotientAddGroup.mk' (rationalEquivalences C q n)
        (cycleAssociatedToClosedSubscheme C q (𝟙 X') n)) =
    QuotientAddGroup.mk' (rationalEquivalences C q (n - (r : ℤ)))
      (cycleAssociatedToClosedSubscheme C q
        (zeroSchemeOfSection X' F s).subschemeι (n - (r : ℤ)))

/-! ### Stacks 0FA9 -/

/-- **The reduction step of the proof of [Stacks, Tag 0FA9], for an abstract cap product rule.**
Let `ℰ` be finite locally free of constant rank `r` on `X`, `f : X' ⟶ X` locally of finite type
and `s ∈ Γ(X', f^*ℰ)`, and let `c` be a bivariant class for `𝟙 X` satisfying the characterization
`Stacks.Chow.IsChernClassBivariant` of Stacks 0B7H against the cap product rule `cap`. If the case
`X = X'` of the tag holds for `cap` and `f^*ℰ` (`hreduced`), then `c ∩ [X']_n = [Z(s)]_{n - r}`
in `CH_{n - r}(X')`, the cap product of `c` being transported from `X ×_X X'` to `X'` along the
base-change isomorphism.

The tag itself, for the Chern class of Stacks 0ESW, is
`Stacks.Chow.SectionZeroScheme.chernClassOfLocallyFree_cap_fundamental_eq_zeroSchemeCycle`. -/
theorem cap_fundamentalCycle_eq_zeroSchemeCycle_of_isChernClassBivariant
    (C : ChowSituation.{u}) {X X' : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
    (E : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    (G : GysinSystem C) (cap : HigherChernCapRule C r)
    (c : BivariantClass C G sX sX (𝟙 X) (Category.id_comp sX) ((Fin.last r : Fin (r + 1)) : ℤ))
    (hc : IsChernClassBivariant C sX E r G cap
      (pullbackPreservesRank_of_isFiniteLocallyFreeOfRank E r) (Fin.last r) c)
    (f : X' ⟶ X) [LocallyOfFiniteType f]
    (s : Γ((Scheme.Modules.pullback f).obj E, ⊤)) (n : ℤ)
    (hX' : schemeDeltaDimension C (f ≫ sX) = (n : EInt))
    (hZ : schemeDeltaDimension C
        ((zeroSchemeOfSection X' ((Scheme.Modules.pullback f).obj E) s).subschemeι ≫ (f ≫ sX)) ≤
      ((n - (r : ℤ) : ℤ) : EInt))
    (hreg : IsRegularZeroSchemeSequence C (f ≫ sX) ((Scheme.Modules.pullback f).obj E) s r
      (n - (r : ℤ)))
    (hreduced : TopChernCapEqZeroScheme C (f ≫ sX) r cap ((Scheme.Modules.pullback f).obj E)
      (AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback f E r) s n) :
    chowPushforwardOfIso C (pullback.fst (𝟙 X) f ≫ sX) (f ≫ sX) (identityBaseChangeIso f).hom
        (identityBaseChangeIso_hom_comp_base C sX f) (n - ((Fin.last r : Fin (r + 1)) : ℤ))
        (c.cap f n (QuotientAddGroup.mk' (rationalEquivalences C (f ≫ sX) n)
          (cycleAssociatedToClosedSubscheme C (f ≫ sX) (𝟙 X') n))) =
      QuotientAddGroup.mk' (rationalEquivalences C (f ≫ sX) (n - (r : ℤ)))
        (cycleAssociatedToClosedSubscheme C (f ≫ sX)
          (zeroSchemeOfSection X' ((Scheme.Modules.pullback f).obj E) s).subschemeι
          (n - (r : ℤ))) :=
  (hc f n (QuotientAddGroup.mk' (rationalEquivalences C (f ≫ sX) n)
    (cycleAssociatedToClosedSubscheme C (f ≫ sX) (𝟙 X') n))).trans (hreduced hX' hZ hreg)

/-! ### The reduced case at `r = 1`

The case `r = 1` of `Stacks.Chow.TopChernCapEqZeroScheme` is Stacks 02SQ, proved in this
repository as `Stacks.ChernCap42.firstChernClassCapOfInvertible_closedSubscheme_eq_zeroScheme`.
This section derives it from that theorem for a cap product rule identified with the first Chern
class cap product, and specialises the reduction step above to a module of rank one. -/

/-- Transport of a Chow class along an equality of degrees. This is the local form of
`Stacks.Chow.chowGroupCast`, which
`StacksFrontier.AlgebraicGeometry.Chow.ChernClassHigher.ProjectiveBundleRelation` keeps; it is
restated here so that this file depends only on the modules it already imports.

Some such transport is unavoidable: the cap product of degree `j` lands in `A_{k-j}`, while the
first Chern class cap product of Stacks 02SO is stated as a map out of `Z_{k+1}` into `A_k`, and
`k + 1 - 1` and `k` are the same integer but not the same term. -/
def chowClassOfDegreeEq {C : ChowSituation.{u}} {Y : Scheme.{u}} {q : Y ⟶ C.S}
    [LocallyOfFiniteType q] {d e : ℤ} (h : d = e) (x : chowGroup C q d) : chowGroup C q e :=
  h ▸ x

/-- Equal quasi-coherent ideal sheaves and equal structure morphisms give closed subschemes of
equal `δ`-dimension. Both substitutions have to be made at once, because the scheme a closed
immersion comes out of depends on the ideal sheaf. -/
theorem schemeDeltaDimension_subschemeι_comp_of_eq (C : ChowSituation.{u}) {Y : Scheme.{u}}
    {I J : Y.IdealSheafData} (hIJ : I = J) {g h : Y ⟶ C.S}
    [LocallyOfFiniteType g] [LocallyOfFiniteType h] (e : g = h) :
    schemeDeltaDimension C (I.subschemeι ≫ g) = schemeDeltaDimension C (J.subschemeι ≫ h) := by
  subst hIJ
  subst e
  rfl

/-- Equal closed immersions have equal associated cycles, in each degree. -/
theorem cycleAssociatedToClosedSubscheme_of_hom_eq (C : ChowSituation.{u}) {Y Z : Scheme.{u}}
    (p : Y ⟶ C.S) [LocallyOfFiniteType p] {a b : Z ⟶ Y} [IsClosedImmersion a]
    [IsClosedImmersion b] (hab : a = b) (d : ℤ) [LocallyOfFiniteType (a ≫ p)]
    [LocallyOfFiniteType (b ≫ p)] :
    cycleAssociatedToClosedSubscheme C p a d = cycleAssociatedToClosedSubscheme C p b d := by
  subst hab
  rfl

/-- Equal quasi-coherent ideal sheaves have equal fundamental classes, after transport along an
equality of degrees. -/
theorem mk_cycleAssociatedToClosedSubscheme_of_eq (C : ChowSituation.{u}) {Y : Scheme.{u}}
    (p : Y ⟶ C.S) [LocallyOfFiniteType p] {I J : Y.IdealSheafData} (hIJ : I = J) {d e : ℤ}
    (hde : d = e) :
    chowClassOfDegreeEq hde (QuotientAddGroup.mk' (rationalEquivalences C p d)
        (cycleAssociatedToClosedSubscheme C p I.subschemeι d)) =
      QuotientAddGroup.mk' (rationalEquivalences C p e)
        (cycleAssociatedToClosedSubscheme C p J.subschemeι e) := by
  subst hIJ
  subst hde
  rfl

/-- **[Stacks, Tag 02U5] at `j = 1` for a module of rank one.** The identification of the cap
product parameter `cap` at rank one and `j = 1` with `Stacks.Chow.firstChernClassCapOfInvertible`,
the first Chern class cap product of Stacks 02SO of an invertible module, which is available.

`Stacks.Chow.HigherChernCapRule` is an *arbitrary* family of additive maps, so nothing about it
relates it to the first Chern class cap product, and this property of a rule `cap` says that it
agrees with it at `j = 1`. The cap products with the Chern classes of the library,
`Stacks.Chow.GenuineChern.chernCap` (descended to Chow groups by Stacks 02U7, commuting with Gysin
maps by Stacks 0B7G), are one such rule; the same property is used by
`StacksFrontier.AlgebraicGeometry.Chow.ChernClassTwist` and
`StacksFrontier.AlgebraicGeometry.Chow.ChernWhitney.FilteredAdditivity`. -/
def IsFirstChernCapAtRankOne (C : ChowSituation.{u}) {X' : Scheme.{u}} (q : X' ⟶ C.S)
    [LocallyOfFiniteType q] (cap : HigherChernCapRule C 1) (F : X'.Modules)
    (hF : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F 1)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible X'.sheaf.obj
      X'.ringCatSheaf.property F) (k : ℤ) : Prop :=
  letI : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F 1 := hF
  letI : AlgebraicGeometry.SheafOfModules.IsInvertible X'.sheaf.obj
    X'.ringCatSheaf.property F := hinv
  ∀ α : CycleGroup C q (k + 1),
    cap q F (k + 1) (Fin.last 1)
        (QuotientAddGroup.mk' (rationalEquivalences C q (k + 1)) α) =
      chowClassOfDegreeEq (show k = k + 1 - ((Fin.last 1 : Fin 2) : ℤ) from by norm_num)
        (firstChernClassCapOfInvertible C q k F α)

/-- **The case `X = X'`, `r = 1` of [Stacks, Tag 0FA9], for an abstract cap product rule.** The
hypothesis `hreduced` of
`Stacks.Chow.cap_fundamentalCycle_eq_zeroSchemeCycle_of_isChernClassBivariant` at a module `F`
of rank one on `X'`, for a cap product rule `cap` identified with the first Chern class cap
product (`hcap`), from Stacks 02SQ.

Stacks 02SQ is stated for a closed immersion `i : Y ⟶ X` with the invertible module on the
*ambient* scheme `X` and the section taken in `Γ(Y, i^*L)`, so using it at `i = 𝟙 X'` means
transporting the section across `AlgebraicGeometry.Scheme.Modules.pullbackId`: `t` is the section
of `(𝟙 X')^*F` corresponding to `s` under that isomorphism, and `ht` says so. The zero schemes of
`s` and of `t` then agree by `AlgebraicGeometry.zeroScheme_eq_of_iso`, and `Z(s)` of this file is
the zero scheme of Stacks 02OQ by `Stacks.Chow.zeroSchemeOfSection_eq_zeroScheme`.

`hs` is the third hypothesis of Stacks 02SQ, injectivity of multiplication by `t` on the stalk at
the generic point of every component of `Z(t)` of `δ`-dimension `k`; in this form of the
statement it is taken as stated in Stacks 02SQ, and the regular-sequence hypothesis is not used.
The derivation of `hs` from the regular-sequence hypothesis, and the tag for the Chern classes of
the library, are in `StacksDraft.AlgebraicGeometry.Chow.SectionZeroScheme`. -/
theorem topChernCapEqZeroScheme_rank_one
    (C : ChowSituation.{u}) {X' : Scheme.{u}} (q : X' ⟶ C.S) [LocallyOfFiniteType q]
    (cap : HigherChernCapRule C 1) (F : X'.Modules)
    (hF : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F 1)
    (hinv : AlgebraicGeometry.SheafOfModules.IsInvertible X'.sheaf.obj
      X'.ringCatSheaf.property F)
    (hinv' : AlgebraicGeometry.SheafOfModules.IsInvertible X'.sheaf.obj
      X'.ringCatSheaf.property ((Scheme.Modules.pullback (𝟙 X')).obj F))
    (s : Γ(F, ⊤)) (k : ℤ)
    (t : ((Scheme.Modules.pullback (𝟙 X')).obj F).sections)
    (ht : Scheme.Modules.Hom.app ((Scheme.Modules.pullbackId X').app F).hom ⊤
      (t.eval (Opposite.op ⊤)) = s)
    (hs : ∀ ξ : genericPoints (Stacks.Divisors.zeroScheme X'
        ((Scheme.Modules.pullback (𝟙 X')).obj F) (t.eval (Opposite.op ⊤))).subscheme,
      relativeDimension C.dimensionFunction (𝟙 X' ≫ q)
          ((Stacks.Divisors.zeroScheme X' ((Scheme.Modules.pullback (𝟙 X')).obj F)
            (t.eval (Opposite.op ⊤))).subschemeι ξ.1) = k →
        Function.Injective (ConcreteCategory.hom
          ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u}
            ((Stacks.Divisors.zeroScheme X' ((Scheme.Modules.pullback (𝟙 X')).obj F)
              (t.eval (Opposite.op ⊤))).subschemeι ξ.1)).map
            ((Scheme.Modules.toPresheaf X').map
              (((Scheme.Modules.pullback (𝟙 X')).obj F).unitHomEquiv.symm t)))))
    (hcap : IsFirstChernCapAtRankOne C q cap F hF hinv k) :
    TopChernCapEqZeroScheme C q 1 cap F hF s (k + 1) := by
  let _ : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F 1 := hF
  let _ : AlgebraicGeometry.SheafOfModules.IsInvertible X'.sheaf.obj
    X'.ringCatSheaf.property F := hinv
  let _ : AlgebraicGeometry.SheafOfModules.IsInvertible X'.sheaf.obj
    X'.ringCatSheaf.property ((Scheme.Modules.pullback (𝟙 X')).obj F) := hinv'
  -- the zero scheme of `t` is the zero scheme of this file's construction at `s`
  have hZeq : Stacks.Divisors.zeroScheme X' ((Scheme.Modules.pullback (𝟙 X')).obj F)
      (t.eval (Opposite.op ⊤)) = zeroSchemeOfSection X' F s :=
    (AlgebraicGeometry.zeroScheme_eq_of_iso (M := F) ((Scheme.Modules.pullbackId X').app F)
      ht).trans (zeroSchemeOfSection_eq_zeroScheme X' F s).symm
  intro hdim hZ _hreg
  have hY : schemeDeltaDimension C (𝟙 X' ≫ q) ≤ ((k + 1 : ℤ) : EInt) :=
    le_of_eq ((schemeDeltaDimension_congr C (Category.id_comp q)).trans hdim)
  have hD : schemeDeltaDimension C
      ((Stacks.Divisors.zeroScheme X' ((Scheme.Modules.pullback (𝟙 X')).obj F)
        (t.eval (Opposite.op ⊤))).subschemeι ≫ (𝟙 X' ≫ q)) ≤ (k : EInt) := by
    refine le_trans (le_of_eq (schemeDeltaDimension_subschemeι_comp_of_eq C hZeq
      (Category.id_comp q))) (le_trans hZ (le_of_eq ?_))
    norm_num
  have h02SQ := Stacks.ChernCap42.firstChernClassCapOfInvertible_closedSubscheme_eq_zeroScheme
    C q (𝟙 X') k F t hY hD hs
  rw [hcap (cycleAssociatedToClosedSubscheme C q (𝟙 X') (k + 1)), h02SQ,
    cycleAssociatedToClosedSubscheme_of_hom_eq C q (Category.comp_id
      (Stacks.Divisors.zeroScheme X' ((Scheme.Modules.pullback (𝟙 X')).obj F)
        (t.eval (Opposite.op ⊤))).subschemeι) k]
  exact mk_cycleAssociatedToClosedSubscheme_of_eq C q hZeq (by norm_num)

/-- **The reduction step of [Stacks, Tag 0FA9] at rank one, for an abstract cap product rule.**
`Stacks.Chow.cap_fundamentalCycle_eq_zeroSchemeCycle_of_isChernClassBivariant` at a module `E` of
rank one, with its hypothesis `hreduced` supplied by `Stacks.Chow.topChernCapEqZeroScheme_rank_one`
under that theorem's hypotheses. -/
theorem cap_fundamentalCycle_eq_zeroSchemeCycle_rank_one
    (C : ChowSituation.{u}) {X X' : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
    (E : X.Modules)
