-/

@[expose] public section

noncomputable section

namespace AlgebraicGeometry

universe u v

/-! ### Descending the tame symbol to Milnor K₂ -/

variable {A : Type u} [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsLocalRing A]
  {K : Type v} [Field K] [Algebra A K] [IsFractionRing A K]

/-- The tame symbol of a one-dimensional Noetherian local domain in its second variable, as a
homomorphism from the units of the fraction field to the units of the residue field. -/
def tameSymbolRight (hdim : ringKrullDim A = 1) (x : Kˣ) :
    Kˣ →* (IsLocalRing.ResidueField A)ˣ where
  toFun := (tameSymbol (K := K) hdim).toFun x
  map_one' := (tameSymbol (K := K) hdim).one_right x
  map_mul' := (tameSymbol (K := K) hdim).map_mul_right x

/-- The tame symbol read as a pairing additive in each variable, on the unit group of the
fraction field regarded additively. -/
def tameSymbolPairing (hdim : ringKrullDim A = 1) :
    Additive Kˣ →+ Additive Kˣ →+ Additive (IsLocalRing.ResidueField A)ˣ where
  toFun x := (tameSymbolRight (K := K) hdim (Additive.toMul x)).toAdditive
  map_zero' := AddMonoidHom.ext fun y =>
    congrArg Additive.ofMul ((tameSymbol (K := K) hdim).one_left (Additive.toMul y))
  map_add' x x' := AddMonoidHom.ext fun y =>
    congrArg Additive.ofMul ((tameSymbol (K := K) hdim).map_mul_left
      (Additive.toMul x) (Additive.toMul x') (Additive.toMul y))

/-- The additive tame-symbol pairing is `ℤ`-balanced, so it lifts over the tensor square. -/
theorem tameSymbolPairing_balanced (hdim : ringKrullDim A = 1) (r : ℤ) (x y : Additive Kˣ) :
    tameSymbolPairing (K := K) hdim (r • x) y = tameSymbolPairing (K := K) hdim x (r • y) := by
  rw [map_zsmul, map_zsmul, AddMonoidHom.coe_smul, Pi.smul_apply]

/-- The tame symbol as a `ℤ`-linear map on the tensor square of the unit group of the fraction
field regarded additively. -/
def tameSymbolTensor (hdim : ringKrullDim A = 1) :
    TensorProduct ℤ (Additive Kˣ) (Additive Kˣ) →ₗ[ℤ]
      Additive (IsLocalRing.ResidueField A)ˣ :=
  AddMonoidHom.toIntLinearMap
    (TensorProduct.liftAddHom (tameSymbolPairing (K := K) hdim)
      (tameSymbolPairing_balanced hdim))

/-- On a pure tensor the linear tame symbol is the tame symbol. -/
theorem tameSymbolTensor_tmul (hdim : ringKrullDim A = 1) (f g : Kˣ) :
    tameSymbolTensor (K := K) hdim (Additive.ofMul f ⊗ₜ[ℤ] Additive.ofMul g) =
      Additive.ofMul (tameSymbol (K := K) hdim f g) := rfl

/-- **Stacks Project, Tag 02Q9.** The linear tame symbol kills the Steinberg submodule of the
tensor square, so it factors through the presentation of the degree-two Milnor K-group. -/
theorem milnorKTwoSteinbergSubmodule_le_ker (hdim : ringKrullDim A = 1) :
    milnorKTwoSteinbergSubmodule K ≤ LinearMap.ker (tameSymbolTensor (K := K) hdim) := by
  rw [milnorKTwoSteinbergSubmodule, Submodule.span_le]
  rintro _ ⟨x, rfl⟩
  refine LinearMap.mem_ker.2 ?_
  rw [tameSymbolTensor_tmul]
  exact congrArg Additive.ofMul (tameSymbol_one_sub_mk0 hdim x.1 x.2.1 x.2.2)

/-- **Stacks Project, Tag 0GU9.** The tame symbol `∂_A` of a one-dimensional Noetherian local
domain `A` with fraction field `K`, descended along the presentation of Milnor K-theory to a
homomorphism `K₂ᴹ(K) ⟶ K₁ᴹ(κ(A))`. This is the local component of the first differential of the
complex of the tag, the one written `∂_{𝒪_{W_x, x'}}` there. -/
@[stacks 0GU9 "the construction of the local component of the first differential: the tame \
symbol of a one-dimensional Noetherian local domain, descended to a homomorphism from the \
degree-two Milnor K-group of its fraction field to the degree-one Milnor K-group of its residue \
field"]
def milnorKTwoTameSymbol (hdim : ringKrullDim A = 1) :
    MilnorKTheory K 2 →+ MilnorKTheory (IsLocalRing.ResidueField A) 1 :=
  (milnorKTheoryOneAddEquiv (IsLocalRing.ResidueField A)).symm.toAddMonoidHom.comp
    (((milnorKTwoSteinbergSubmodule K).liftQ (tameSymbolTensor (K := K) hdim)
        (milnorKTwoSteinbergSubmodule_le_ker hdim)).toAddMonoidHom.comp
      (milnorKTwoEquivTensorProductQuotient K).toLinearMap.toAddMonoidHom)

/-- The pure symbol `{f, g}` in the degree-two Milnor K-group of a field, read through the
presentation of that group as the tensor square of the unit group modulo the Steinberg
relations. -/
def milnorKTwoPureSymbol (k : Type u) [Field k] (f g : kˣ) : MilnorKTheory k 2 :=
  (milnorKTwoEquivTensorProductQuotient k).symm
    (Submodule.Quotient.mk (Additive.ofMul f ⊗ₜ[ℤ] Additive.ofMul g))

/-- The Milnor K₂ tame symbol sends the pure symbol `{f, g}` to the tame symbol of `f` and
`g`, read in the degree-one Milnor K-group of the residue field. -/
theorem milnorKTwoTameSymbol_pureSymbol (hdim : ringKrullDim A = 1) (f g : Kˣ) :
    milnorKTwoTameSymbol (K := K) hdim (milnorKTwoPureSymbol K f g) =
      (milnorKTheoryOneAddEquiv (IsLocalRing.ResidueField A)).symm
        (Additive.ofMul (tameSymbol (K := K) hdim f g)) := by
  simp only [milnorKTwoTameSymbol, milnorKTwoPureSymbol, AddMonoidHom.coe_comp,
    Function.comp_apply, LinearMap.toAddMonoidHom_coe, LinearEquiv.coe_coe,
    LinearEquiv.apply_symm_apply, AddEquiv.coe_toAddMonoidHom, Submodule.liftQ_apply,
    tameSymbolTensor_tmul]

/-- The degree-two Milnor K-group of a field is generated by the pure symbols: a property
holding of every pure symbol and of sums holds of every class. This is the source's
reduction "by additivity, by linearity" to a class of the form `f ⊗ g`. -/
theorem milnorKTwo_induction {k : Type u} [Field k] {P : MilnorKTheory k 2 → Prop}
    (hsymb : ∀ f g : kˣ, P (milnorKTwoPureSymbol k f g))
    (hadd : ∀ a b, P a → P b → P (a + b)) (α : MilnorKTheory k 2) : P α := by
  suffices h : ∀ t : TensorProduct ℤ (Additive kˣ) (Additive kˣ),
      P ((milnorKTwoEquivTensorProductQuotient k).symm (Submodule.Quotient.mk t)) by
    obtain ⟨t, ht⟩ := Submodule.Quotient.mk_surjective (milnorKTwoSteinbergSubmodule k)
      (milnorKTwoEquivTensorProductQuotient k α)
    rw [← (milnorKTwoEquivTensorProductQuotient k).symm_apply_apply α, ← ht]
    exact h t
  intro t
  induction t using TensorProduct.inductionOn with
  | tmul x y => exact hsymb (Additive.toMul x) (Additive.toMul y)
  | add t t' iht iht' =>
      rw [Submodule.Quotient.mk_add, map_add]
      exact hadd _ _ iht iht'

/-! ### The two-dimensional case: the composite vanishes on all of Milnor K₂ -/

section TwoDimensional

variable {A : Type u} [CommRing A] [IsDomain A] [IsNoetherianRing A]

omit [IsDomain A] [IsNoetherianRing A] in
/-- The localization of a ring at a height-one prime is one-dimensional. -/
theorem ringKrullDim_localizationAtPrime_heightOne
    (q : {q : Ideal A // q.IsPrime ∧ q.height = 1}) [q.1.IsPrime] :
    ringKrullDim (Localization.AtPrime q.1) = 1 :=
  (IsLocalization.AtPrime.ringKrullDim_eq_height q.1 (Localization.AtPrime q.1)).trans
    (congrArg (fun x : ℕ∞ => (x : WithBot ℕ∞)) q.2.2)

omit [IsDomain A] [IsNoetherianRing A] in
/-- The canonical algebra equivalence of `FractionRing A` with itself is the identity: an
`A`-algebra endomorphism of a localization of `A` is determined by its restriction to `A`. -/
theorem fractionRing_algEquiv_self_symm_toRingHom :
    ((FractionRing.algEquiv A (FractionRing A)).symm : FractionRing A →+* FractionRing A) =
      RingHom.id (FractionRing A) := by
  refine IsLocalization.ringHom_ext (nonZeroDivisors A) ?_
  ext a
  exact (FractionRing.algEquiv A (FractionRing A)).symm.commutes a

/-- Over the canonical fraction ring, the local tame symbol at a height-one prime is the tame
symbol of the localization there: the transport of the arguments built into the former is the
identity. -/
theorem localTameSymbol_fractionRing (q : {q : Ideal A // q.IsPrime ∧ q.height = 1})
    [q.1.IsPrime] (f g : (FractionRing A)ˣ) :
    localTameSymbol (K := FractionRing A) q f g =
      tameSymbol (A := Localization.AtPrime q.1) (K := FractionRing A)
        (ringKrullDim_localizationAtPrime_heightOne q) f g := by
  have hu : ∀ u : (FractionRing A)ˣ,
      Units.map ((FractionRing.algEquiv A (FractionRing A)).symm.toRingHom.toMonoidHom) u = u :=
    fun u => Units.ext <|
      DFunLike.congr_fun (fractionRing_algEquiv_self_symm_toRingHom (A := A)) (u : FractionRing A)
  simp only [localTameSymbol, hu]

/-- The order of vanishing along `A / 𝔮` of a unit of the residue field of a height-one prime
`𝔮`, as an integer. -/
def residueUnitOrder {q : {q : Ideal A // q.IsPrime ∧ q.height = 1}} [q.1.IsPrime]
    (hquot : Ring.KrullDimLE 1 (A ⧸ q.1)) (d : q.1.ResidueFieldˣ) : ℤ :=
  letI := hquot
  Multiplicative.toAdd (WithZero.unzero
    (x := Ring.ordFrac (A ⧸ q.1) (d : q.1.ResidueField))
    ((Units.isUnit d).map (Ring.ordFrac (A ⧸ q.1))).ne_zero)

omit [IsDomain A] in
/-- The trivial residue-field unit has order zero. -/
theorem residueUnitOrder_one {q : {q : Ideal A // q.IsPrime ∧ q.height = 1}} [q.1.IsPrime]
    (hquot : Ring.KrullDimLE 1 (A ⧸ q.1)) : residueUnitOrder (q := q) hquot 1 = 0 := by
  simp only [residueUnitOrder, Ring.ordFrac, Units.val_one, map_one]
  rfl

omit [IsDomain A] in
/-- The order of a product of residue-field units is the sum of their orders. -/
theorem residueUnitOrder_mul {q : {q : Ideal A // q.IsPrime ∧ q.height = 1}} [q.1.IsPrime]
    (hquot : Ring.KrullDimLE 1 (A ⧸ q.1)) (x y : q.1.ResidueFieldˣ) :
    residueUnitOrder (q := q) hquot (x * y) =
      residueUnitOrder (q := q) hquot x + residueUnitOrder (q := q) hquot y := by
  simp [residueUnitOrder, map_mul, Units.val_mul, WithZero.unzero_mul]

variable [IsLocalRing A]

/-- For a two-dimensional Noetherian local domain, the quotient by a height-one prime has Krull
dimension at most one, so orders of vanishing along it are defined. -/
theorem krullDimLE_one_quotient_heightOne (hdim : ringKrullDim A = 2)
    (q : {q : Ideal A // q.IsPrime ∧ q.height = 1}) : Ring.KrullDimLE 1 (A ⧸ q.1) :=
  (sum_ord_localTameSymbol_eq_zero (K := FractionRing A) hdim 1 1).1 q

/-- The Milnor K₂ tame-symbol boundary at a height-one prime `𝔮` of `A`, formed from the
one-dimensional local domain `A_𝔮` and landing in the degree-one Milnor K-group of the residue
field of `𝔮`. -/
def localMilnorBoundary (q : {q : Ideal A // q.IsPrime ∧ q.height = 1}) [q.1.IsPrime] :
    MilnorKTheory (FractionRing A) 2 →+ MilnorKTheory q.1.ResidueField 1 :=
  milnorKTwoTameSymbol (A := Localization.AtPrime q.1) (K := FractionRing A)
    (ringKrullDim_localizationAtPrime_heightOne q)

/-- The contribution of a height-one prime `𝔮` to the composite: the order along `A / 𝔮` of the
Milnor K₂ boundary at `𝔮`, read as a unit of the residue field of `𝔮`. -/
def localMilnorBoundaryOrder (hdim : ringKrullDim A = 2)
    (q : {q : Ideal A // q.IsPrime ∧ q.height = 1})
    (α : MilnorKTheory (FractionRing A) 2) : ℤ :=
  letI : q.1.IsPrime := q.2.1
  residueUnitOrder (q := q) (krullDimLE_one_quotient_heightOne hdim q)
    (Additive.toMul (milnorKTheoryOneAddEquiv q.1.ResidueField (localMilnorBoundary q α)))

/-- The zero class contributes nothing at every height-one prime. -/
theorem localMilnorBoundaryOrder_zero (hdim : ringKrullDim A = 2)
    (q : {q : Ideal A // q.IsPrime ∧ q.height = 1}) :
    localMilnorBoundaryOrder hdim q 0 = 0 := by
  let : q.1.IsPrime := q.2.1
  rw [localMilnorBoundaryOrder, show (Additive.toMul (milnorKTheoryOneAddEquiv q.1.ResidueField
      (localMilnorBoundary q 0))) = 1 by simp]
  exact residueUnitOrder_one _

/-- The contribution at a height-one prime is additive in the Milnor K₂ class. -/
theorem localMilnorBoundaryOrder_add (hdim : ringKrullDim A = 2)
    (q : {q : Ideal A // q.IsPrime ∧ q.height = 1})
    (α β : MilnorKTheory (FractionRing A) 2) :
    localMilnorBoundaryOrder hdim q (α + β) =
      localMilnorBoundaryOrder hdim q α + localMilnorBoundaryOrder hdim q β := by
  let : q.1.IsPrime := q.2.1
  simp only [localMilnorBoundaryOrder, map_add]
  exact residueUnitOrder_mul _ _ _

/-- On a pure symbol the contribution at a height-one prime is the order of the local tame
symbol, which is the quantity summed in the reciprocity formula of Stacks 0EAX. -/
theorem localMilnorBoundaryOrder_pureSymbol (hdim : ringKrullDim A = 2)
    (q : {q : Ideal A // q.IsPrime ∧ q.height = 1}) (f g : (FractionRing A)ˣ) :
    localMilnorBoundaryOrder hdim q (milnorKTwoPureSymbol (FractionRing A) f g) =
      letI : q.1.IsPrime := q.2.1
      residueUnitOrder (q := q) (krullDimLE_one_quotient_heightOne hdim q)
        (localTameSymbol q f g) := by
  let : q.1.IsPrime := q.2.1
  simp only [localMilnorBoundaryOrder, localMilnorBoundary, milnorKTwoTameSymbol_pureSymbol,
    AddEquiv.apply_symm_apply, localTameSymbol_fractionRing]
  rfl

/-- Where the local tame symbol is trivial, a pure symbol contributes nothing. -/
theorem localMilnorBoundaryOrder_pureSymbol_eq_zero (hdim : ringKrullDim A = 2)
    (q : {q : Ideal A // q.IsPrime ∧ q.height = 1}) (f g : (FractionRing A)ˣ)
    (h : localTameSymbol (K := FractionRing A) q f g = 1) :
    localMilnorBoundaryOrder hdim q (milnorKTwoPureSymbol (FractionRing A) f g) = 0 := by
  let : q.1.IsPrime := q.2.1
  rw [localMilnorBoundaryOrder_pureSymbol]
  change residueUnitOrder (q := q) (krullDimLE_one_quotient_heightOne hdim q)
    (localTameSymbol q f g) = 0
  rw [h]
  exact residueUnitOrder_one _

/-- The contributions of a Milnor K₂ class are nonzero at only finitely many height-one primes,
and they sum to zero. Both halves are proved together by induction over the pure symbols,
because the sum is only additive where the supports are finite. -/
private theorem localMilnorBoundaryOrder_support_and_sum (hdim : ringKrullDim A = 2)
    (α : MilnorKTheory (FractionRing A) 2) :
    (Function.support fun q : {q : Ideal A // q.IsPrime ∧ q.height = 1} =>
        localMilnorBoundaryOrder hdim q α).Finite ∧
      (∑ᶠ q : {q : Ideal A // q.IsPrime ∧ q.height = 1},
        localMilnorBoundaryOrder hdim q α) = 0 := by
  induction α using milnorKTwo_induction with
  | hsymb f g =>
      obtain ⟨hquot, hsum⟩ := sum_ord_localTameSymbol_eq_zero (K := FractionRing A) hdim f g
      refine ⟨?_, ?_⟩
      · refine (localTameSymbol_ne_one_finite (A := A) (K := FractionRing A) f g).subset ?_
        intro q hq
        exact fun hone => hq (localMilnorBoundaryOrder_pureSymbol_eq_zero hdim q f g hone)
      · rw [finsum_congr fun q => localMilnorBoundaryOrder_pureSymbol hdim q f g]
        exact hsum
  | hadd a b ha hb =>
      refine ⟨(ha.1.union hb.1).subset ?_, ?_⟩
      · intro q hq
        simp only [Function.mem_support, Set.mem_union, localMilnorBoundaryOrder_add] at hq ⊢
        omega
      · rw [finsum_congr (fun q => localMilnorBoundaryOrder_add hdim q a b),
          finsum_add_distrib ha.1 hb.1, ha.2, hb.2, add_zero]

/-- **Stacks Project, Tag 0GU9.** Let `A` be a two-dimensional Noetherian local domain with
fraction field `K` and let `α` be a class in the degree-two Milnor K-group of `K`. Summing, over
the height-one primes `𝔮` of `A`, the order along `A / 𝔮` of the tame-symbol boundary of `α` at
`𝔮` gives zero.

This is the vanishing which the tag's argument reduces the composite of its two differentials to:
at a point `x''` of `δ`-dimension `k` lying on the integral closed subscheme `W` with generic
point `x` of `δ`-dimension `k + 2`, the ring `A` is `𝒪_{W, x''}`, its height-one primes are the
intermediate points `x'` of `δ`-dimension `k + 1`, and the summand at `𝔮` is the coefficient
`ord_{𝒪_{closure {x'}, x''}}(∂_{𝒪_{W, x'}}(α))`. The source reduces to a pure symbol by
additivity and linearity before appealing to Stacks 0EAX; here the reduction is carried out, so
the statement holds for every class of the Milnor K-group and not only for a pure symbol. -/
@[stacks 0GU9 "the vanishing of the composite of the two differentials in its local algebraic \
form: for a two-dimensional Noetherian local domain, the orders along the quotients of the \
tame-symbol boundaries of an arbitrary degree-two Milnor K-class of the fraction field, summed \
over the height-one primes, give zero -- this is the displayed sum of the tag's proof, with the \
reduction to a pure symbol discharged; the fraction field is realized as `FractionRing A`, and \
the geometric indexing of that sum by the intermediate points, the locally finite chain groups \
and the three-term complex itself are not formalized here"]
theorem sum_localMilnorBoundaryOrder_eq_zero (hdim : ringKrullDim A = 2)
    (α : MilnorKTheory (FractionRing A) 2) :
    (∑ᶠ q : {q : Ideal A // q.IsPrime ∧ q.height = 1},
      localMilnorBoundaryOrder hdim q α) = 0 :=
  (localMilnorBoundaryOrder_support_and_sum hdim α).2

end TwoDimensional

end AlgebraicGeometry

end

end
