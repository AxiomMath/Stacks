/-!
# Localized ideals and two-periodic complexes of an exact pair

Two ingredients shared by the proofs of the reciprocity law for tame symbols.

The first is the behaviour of a localization `A → A_p` on ideals: the localization of an ideal
is its image in the localized ring, a localized quotient is the quotient by that image, and the
ideal generated by a product `a * b` is the image of the composite of the two multiplications.

The second concerns a pair of endomorphisms `f, g` of a module with `range f = ker g` and
`range g = ker f`: the composites vanish, and the resulting two-periodic complex is acyclic, so
it has finite length and multiplicity zero.
-/

@[expose] public section

noncomputable section

namespace AlgebraicGeometry

universe u v

/-- A localization of a ring, viewed as a localization of it as a module over itself. -/
noncomputable def localizedRingModuleEquiv
    {A : Type u} [CommRing A] (p : Submonoid A) :
    LocalizedModule p A ≃ₗ[Localization p] Localization p := by
  let e₀ := LocalizedModule.equivTensorProduct p A
  let e₁₀ := TensorProduct.rid A (Localization p)
  let f : TensorProduct A (Localization p) A →ₗ[Localization p] Localization p :=
    { toFun := e₁₀
      map_add' := e₁₀.map_add
      map_smul' := by
        intro r z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | add x y hx hy =>
          simp [hx, hy, smul_add]
          ring
        | tmul x y =>
          change TensorProduct.rid A (Localization p)
              ((r • x) ⊗ₜ[A] y) = r • TensorProduct.rid A (Localization p) (x ⊗ₜ[A] y)
          rw [TensorProduct.rid_tmul, TensorProduct.rid_tmul]
          exact smul_comm y r x }
  exact e₀.trans (LinearEquiv.ofBijective f e₁₀.bijective)

/-- Under that identification the localization of an ideal is its image in the localized ring. -/
theorem localizedIdeal_map_eq
    {A : Type u} [CommRing A] (p : Submonoid A) (I : Ideal A) :
    (I.localized p).map (localizedRingModuleEquiv p).toLinearMap =
      I.map (algebraMap A (Localization p)) := by
  let e := localizedRingModuleEquiv p
  have hcomp : (e.restrictScalars A).toLinearMap.comp (LocalizedModule.mkLinearMap p A) =
      Algebra.linearMap A (Localization p) := by
    ext
    simp [e, localizedRingModuleEquiv, TensorProduct.rid_tmul, Algebra.smul_def,
      Localization.mk_one_eq_algebraMap]
  have hcomp_fun : (fun x : A => e (LocalizedModule.mkLinearMap p A x)) =
      algebraMap A (Localization p) := by
    funext x
    simpa using congrArg (fun f : A →ₗ[A] Localization p => f x) hcomp
  rw [show I.localized p = I.localized' (Localization p) p
      (LocalizedModule.mkLinearMap p A) by rfl,
    Submodule.localized'_eq_span, LinearMap.map_span, Ideal.map, Ideal.span]
  congr 1
  calc
    e '' (LocalizedModule.mkLinearMap p A '' (I : Set A)) =
        (fun x : A => e (LocalizedModule.mkLinearMap p A x)) '' I := by
          rw [Set.image_image]
    _ = (algebraMap A (Localization p)) '' I := by rw [hcomp_fun]

/-- A localization of a quotient by an ideal is the quotient of the localized ring by the image
of that ideal. -/
noncomputable def localizedQuotientIdealEquiv
    {A : Type u} [CommRing A] (p : Submonoid A) (I : Ideal A) :
    LocalizedModule p (A ⧸ I) ≃ₗ[Localization p]
      Localization p ⧸ I.map (algebraMap A (Localization p)) := by
  let e := localizedRingModuleEquiv p
  let eQ : (LocalizedModule p A ⧸ I.localized p) ≃ₗ[Localization p]
      Localization p ⧸ I.map (algebraMap A (Localization p)) :=
    Submodule.Quotient.equiv _ _ e (localizedIdeal_map_eq p I)
  exact (localizedQuotientEquiv p I).symm.trans eQ

/-- The image of multiplication by `a` composed with multiplication by `b` is the ideal
generated by `a * b`. -/
theorem range_mul_lsmul_eq_span
    {R : Type u} [CommRing R] (a b : R) :
    LinearMap.range ((LinearMap.lsmul R R a).comp (LinearMap.lsmul R R b)) =
      Ideal.span {a * b} := by
  ext x
  rw [LinearMap.mem_range, Ideal.mem_span_singleton]
  constructor <;> rintro ⟨y, hy⟩ <;>
    exact ⟨y, by simpa [LinearMap.comp_apply, LinearMap.lsmul_apply, mul_assoc] using hy.symm⟩

/-- The composite of the two maps of an exact pair of endomorphisms vanishes. -/
theorem exact_comp_zero
    {R : Type u} {M : Type v} [Ring R] [AddCommGroup M] [Module R M]
    {f g : M →ₗ[R] M} (h : Function.Exact f g) : g.comp f = 0 :=
  h.linearMap_comp_eq_zero

/-- The homology of the two-periodic complex of an exact pair of endomorphisms vanishes. -/
private theorem subsingleton_homology_of_exact
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
    (φ ψ : Module.End R M) (hφψ : Function.Exact φ ψ)
    (hψφ : Function.Exact ψ φ) (i : ZMod 2) :
    Subsingleton ((twoPeriodicComplex φ ψ (exact_comp_zero hψφ)
      (exact_comp_zero hφψ)).homology i) := by
  let C := twoPeriodicComplex φ ψ (exact_comp_zero hψφ) (exact_comp_zero hφψ)
  have hp0 : (ComplexShape.up (ZMod 2)).prev 0 = 1 := by
    rw [CochainComplex.prev]
    decide
  have hn0 : (ComplexShape.up (ZMod 2)).next 0 = 1 := by
    rw [CochainComplex.next]
    rfl
  have hp1 : (ComplexShape.up (ZMod 2)).prev 1 = 0 := by
    rw [CochainComplex.prev]
    decide
  have hn1 : (ComplexShape.up (ZMod 2)).next 1 = 0 := by
    rw [CochainComplex.next]
    decide
  have h0 : C.ExactAt 0 := by
    rw [HomologicalComplex.exactAt_iff' C 1 0 1 hp0 hn0]
    apply ModuleCat.shortComplex_exact
    show Function.Exact ψ φ
    exact hψφ
  have h1 : C.ExactAt 1 := by
    rw [HomologicalComplex.exactAt_iff' C 0 1 0 hp1 hn1]
    apply ModuleCat.shortComplex_exact
    show Function.Exact φ ψ
    exact hφψ
  exact ModuleCat.isZero_iff_subsingleton.mp
    ((HomologicalComplex.exactAt_iff_isZero_homology C i).mp (by
      fin_cases i <;> simpa using (show C.ExactAt _ from by assumption)))

/-- An exact pair of endomorphisms gives a two-periodic complex with vanishing, hence
finite-length, cohomology. -/
theorem periodic_homology_finite_of_exact
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
    (φ ψ : Module.End R M) (hφψ : Function.Exact φ ψ)
    (hψφ : Function.Exact ψ φ) :
    ∀ i : ZMod 2, IsFiniteLength R
      ((twoPeriodicComplex φ ψ (exact_comp_zero hψφ)
        (exact_comp_zero hφψ)).homology i) := by
  intro i
  have := subsingleton_homology_of_exact φ ψ hφψ hψφ i
  exact IsFiniteLength.of_subsingleton

/-- The two-periodic complex of an exact pair of endomorphisms has multiplicity zero. -/
theorem periodicLength_zero_of_exact
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
    (φ ψ : Module.End R M) (hφψ : Function.Exact φ ψ)
    (hψφ : Function.Exact ψ φ) :
    periodicLength
      (twoPeriodicComplex φ ψ (exact_comp_zero hψφ)
        (exact_comp_zero hφψ)) = 0 := by
  have hzero := subsingleton_homology_of_exact φ ψ hφψ hψφ
  simp [periodicLength]

