module

public import Mathlib.FieldTheory.RatFunc.Basic
public import Mathlib.RingTheory.DedekindDomain.Dvr
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
public import Mathlib.RingTheory.Localization.LocalizationLocalization
public import Mathlib.RingTheory.PrincipalIdealDomain
public import StacksFrontier.AlgebraicGeometry.Chow.DvrTameSymbol.MilnorTameSymbol
public import StacksFrontier.AlgebraicGeometry.Chow.KeyLemma.MilnorKTransport

/-!
# The tame symbols of the affine line, in every degree

Let `k` be a field and let `F = RatFunc k` be the field of rational functions over `k`. For every
closed point of `A¹_k` — that is, for every maximal ideal `P`
of `k[X]`, equivalently for every irreducible polynomial `p`, by
`Stacks.Chow.isMaximal_span_singleton_of_irreducible_polynomial` — the local ring of `A¹_k` at
`P` is a discrete valuation ring with fraction field `F` and residue field `k[X]/P`. So the
tame symbol of
`Stacks.Chow.dvrMilnorTameSymbol'` applies, and gives the residue map

`∂_P : K^M_{i+1}(F) ⟶ K^M_i(k[X]/P)`

in every degree. This file constructs it.

Nothing here is new mathematics: `k[X]` is a principal ideal domain, hence a Dedekind domain, so
`IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain` gives the discrete valuation
ring, `Mathlib`'s `Ideal.bijective_algebraMap_quotient_residueField` identifies its residue field
with `k[X]/P`, and the tame symbol in every degree is already in the tree. The file exists because
this family of residue maps is the input to Milnor's exact sequence for a rational function field,
which is in turn the input to the norm maps on Milnor K-theory.

## Main definitions

* `Stacks.Chow.quotientRingEquivResidueField` — the residue field at `P` is `k[X]/P`.
* `Stacks.Chow.affineLineResidue` — the residue `∂_P` with values in the residue field of the
  local ring at `P`.
* `Stacks.Chow.affineLineResidueQuot` — the same, with values in `K^M_i(k[X]/P)`.

## Main results

* `Stacks.Chow.ne_bot_of_isMaximal_polynomial` — a maximal ideal of `k[X]` is nonzero.
* `Stacks.Chow.isDiscreteValuationRing_localizationAtPrime_polynomial` — the local ring of `A¹_k`
  at a closed point is a discrete valuation ring.
* `Stacks.Chow.isMaximal_span_singleton_of_irreducible_polynomial` — the closed points of `A¹_k`
  are the ideals generated by the irreducible polynomials.

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
-/

@[expose] public noncomputable section

open IsLocalRing Polynomial

universe u

namespace Stacks.Chow

/- The quotient of a commutative ring by a maximal ideal is a field. In `Mathlib` this is a
definition rather than a global instance, and the Milnor K-theory of `k[X]/P` appears in the
statements below, so it is needed here as an instance. -/
attribute [local instance] Ideal.Quotient.field

variable {k : Type u} [Field k]

/-! ### The closed points of the affine line -/

/-- A maximal ideal of `k[X]` is nonzero: were the zero ideal maximal, the ideal generated by `X`
would be either zero or the whole ring, and `X` is neither zero nor a unit. -/
theorem ne_bot_of_isMaximal_polynomial (P : Ideal (Polynomial k)) [hP : P.IsMaximal] : P ≠ ⊥ := by
  rintro rfl
  by_cases htop : Ideal.span {(X : Polynomial k)} = ⊤
  · exact not_isUnit_X (Ideal.span_singleton_eq_top.mp htop)
  · exact X_ne_zero (Ideal.mem_bot.mp
      ((hP.eq_of_le htop bot_le) ▸ Ideal.mem_span_singleton_self (X : Polynomial k)))

/-- **The local ring of `A¹_k` at a closed point is a discrete valuation ring.** The ring `k[X]`
is a principal ideal domain, hence a Dedekind domain, and the ideal is nonzero. -/
theorem isDiscreteValuationRing_localizationAtPrime_polynomial (P : Ideal (Polynomial k))
    [P.IsMaximal] : IsDiscreteValuationRing (Localization.AtPrime P) :=
  IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain (Polynomial k)
    (ne_bot_of_isMaximal_polynomial P) _

/-- The closed points of `A¹_k` are the ideals generated by the irreducible polynomials. -/
theorem isMaximal_span_singleton_of_irreducible_polynomial {p : Polynomial k} (hp : Irreducible p) :
    (Ideal.span {p}).IsMaximal :=
  PrincipalIdealRing.isMaximal_of_irreducible hp

/-! ### The local rings of the affine line inside the rational function field -/

/-- **The local ring of `A¹_k` at a prime sits inside `RatFunc k`.** The complement of a prime is
contained in the nonzerodivisors of the domain `k[X]`, so the localization there maps canonically
to the localization at all nonzerodivisors.

The scalar multiplication is the one `RatFunc` already carries, rather than the one a ring
homomorphism would define: `Mathlib` gives `K⟮X⟯` a `SMul R` for every `R` acting on
`FractionRing K[X]`, so a second one coming from `RingHom.toAlgebra` would not be the scalar
multiplication `IsScalarTower` is stated about. -/
instance algebraLocalizationAtPrimeRatFunc (P : Ideal (Polynomial k)) [P.IsPrime] :
    Algebra (Localization.AtPrime P) (RatFunc k) where
  algebraMap :=
    { toFun c := RatFunc.ofFractionRing
        (algebraMap (Localization.AtPrime P) (FractionRing (Polynomial k)) c)
      map_one' := by rw [map_one, RatFunc.ofFractionRing_one]
      map_mul' a b := by rw [map_mul, RatFunc.ofFractionRing_mul]
      map_zero' := by rw [map_zero, RatFunc.ofFractionRing_zero]
      map_add' a b := by rw [map_add, RatFunc.ofFractionRing_add] }
  smul_def' c x := by
    obtain ⟨p⟩ := x
    rw [← RatFunc.ofFractionRing_smul, Algebra.smul_def, RatFunc.ofFractionRing_mul]
    rfl
  commutes' _ _ := mul_comm _ _

/-- The polynomials, the local ring at `P` and the rational functions form a tower. -/
instance isScalarTowerLocalizationAtPrimeRatFunc (P : Ideal (Polynomial k)) [P.IsPrime] :
    IsScalarTower (Polynomial k) (Localization.AtPrime P) (RatFunc k) :=
  IsScalarTower.of_algebraMap_eq fun x ↦ by
    rw [show algebraMap (Localization.AtPrime P) (RatFunc k)
          (algebraMap (Polynomial k) (Localization.AtPrime P) x) =
        RatFunc.ofFractionRing (algebraMap (Localization.AtPrime P) (FractionRing (Polynomial k))
          (algebraMap (Polynomial k) (Localization.AtPrime P) x)) from rfl,
      ← IsScalarTower.algebraMap_apply (Polynomial k) (Localization.AtPrime P)
        (FractionRing (Polynomial k)) x, RatFunc.ofFractionRing_algebraMap]

/-- **The fraction field of the local ring of `A¹_k` at a prime is `RatFunc k`.** -/
instance isFractionRingLocalizationAtPrimeRatFunc (P : Ideal (Polynomial k)) [P.IsPrime] :
    IsFractionRing (Localization.AtPrime P) (RatFunc k) :=
  IsFractionRing.isFractionRing_of_isDomain_of_isLocalization P.primeCompl
    (Localization.AtPrime P) (RatFunc k)

/-- **A generator of a maximal ideal of `k[X]` is a uniformizer of the local ring there.** The
maximal ideal of the localization is the image of `P`, which `p` generates. -/
theorem irreducible_algebraMap_self {p : Polynomial k} [(Ideal.span {p}).IsMaximal] :
    Irreducible (algebraMap (Polynomial k) (Localization.AtPrime (Ideal.span {p})) p) := by
  have := isDiscreteValuationRing_localizationAtPrime_polynomial (Ideal.span {p} : Ideal
    (Polynomial k))
  rw [IsDiscreteValuationRing.irreducible_iff_uniformizer,
    ← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_span, Set.image_singleton]

/-! ### The residue field at a closed point -/

/-- **The residue field of `A¹_k` at a closed point `P` is `k[X]/P`.** For a maximal ideal the
quotient is already a field, so the canonical map to the residue field of the local ring is an
isomorphism. -/
def quotientRingEquivResidueField (P : Ideal (Polynomial k)) [P.IsMaximal] :
    (Polynomial k ⧸ P) ≃+* P.ResidueField :=
  RingEquiv.ofBijective (algebraMap (Polynomial k ⧸ P) P.ResidueField)
    P.bijective_algebraMap_quotient_residueField

/-- The isomorphism `quotientRingEquivResidueField P` is the canonical map from `k[X] ⧸ P` to the
residue field at `P`. -/
@[simp]
theorem quotientRingEquivResidueField_apply (P : Ideal (Polynomial k)) [P.IsMaximal]
    (x : Polynomial k ⧸ P) :
    quotientRingEquivResidueField P x = algebraMap (Polynomial k ⧸ P) P.ResidueField x :=
  rfl

/-- **The dictionary between the two readings of the residue field at `P`:** the residue of a
polynomial in the local ring at `P` is the class of that polynomial in `k[X] ⧸ P`. -/
theorem residue_algebraMap_eq_quotientRingEquivResidueField (P : Ideal (Polynomial k))
    [P.IsMaximal] (f : Polynomial k) :
    residue (Localization.AtPrime P) (algebraMap (Polynomial k) (Localization.AtPrime P) f) =
      quotientRingEquivResidueField P (Ideal.Quotient.mk P f) := by
  rw [quotientRingEquivResidueField_apply, Ideal.algebraMap_quotient_residueField_mk,
    IsScalarTower.algebraMap_apply (Polynomial k) (Localization.AtPrime P) P.ResidueField,
    IsLocalRing.ResidueField.algebraMap_eq]

/-! ### The residue map at a closed point -/

/-- **The tame symbol `∂_P : K^M_{i+1}(k(X)) ⟶ K^M_i(κ(P))` of the affine line at a closed point,
in every degree.** The local ring at `P` is a discrete valuation ring whose fraction field is the
field of rational functions, so this is the tame symbol of Stacks 0EAY at that ring. -/
def affineLineResidue (P : Ideal (Polynomial k)) [P.IsMaximal] (i : ℕ) :
    MilnorKTheory (RatFunc k) (i + 1) →+ MilnorKTheory P.ResidueField i :=
  haveI := isDiscreteValuationRing_localizationAtPrime_polynomial P
  dvrMilnorTameSymbol' (Localization.AtPrime P) (RatFunc k) i

/-- **The tame symbol at a closed point, read in the Milnor K-theory of `k[X]/P`.** -/
def affineLineResidueQuot (P : Ideal (Polynomial k)) [P.IsMaximal] (i : ℕ) :
    MilnorKTheory (RatFunc k) (i + 1) →+ MilnorKTheory (Polynomial k ⧸ P) i :=
  ((milnorKTransportEquiv (quotientRingEquivResidueField P) i).symm.toAddMonoidHom).comp
    (affineLineResidue P i)

/-- The value of `affineLineResidueQuot P i` at `y` is the tame symbol `affineLineResidue P i y`
transported back along the isomorphism of `k[X] ⧸ P` with the residue field. -/
theorem affineLineResidueQuot_apply (P : Ideal (Polynomial k)) [P.IsMaximal] (i : ℕ)
    (y : MilnorKTheory (RatFunc k) (i + 1)) :
    affineLineResidueQuot P i y =
      (milnorKTransportEquiv (quotientRingEquivResidueField P) i).symm
        (affineLineResidue P i y) :=
  rfl

/-- The residue map at a closed point is determined by the tame symbol of the local ring there:
transporting its value along the identification of `k[X]/P` with the residue field returns the
tame symbol. -/
theorem milnorKTransport_affineLineResidueQuot (P : Ideal (Polynomial k)) [P.IsMaximal] (i : ℕ)
    (y : MilnorKTheory (RatFunc k) (i + 1)) :
    milnorKTransport (quotientRingEquivResidueField P : (Polynomial k ⧸ P) →+* P.ResidueField) i
        (affineLineResidueQuot P i y) =
      affineLineResidue P i y :=
  (milnorKTransportEquiv (quotientRingEquivResidueField P) i).apply_symm_apply _

end Stacks.Chow

end
