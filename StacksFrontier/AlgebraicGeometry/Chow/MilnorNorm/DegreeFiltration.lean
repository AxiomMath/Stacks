module

public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.AffineLineResidue

/-!
# The degree filtration on the Milnor K-theory of a rational function field

Let `k` be a field. Milnor's computation of `K^M_*(RatFunc k)` runs along the filtration

`L_0 ⊆ L_1 ⊆ L_2 ⊆ ⋯ ⊆ K^M_*(RatFunc k)`,

where `L_d` is the subgroup generated by the symbols `{f_1, …, f_r}` of nonzero polynomials of
degree at most `d`. This file introduces that filtration and proves the two statements about it
that need no induction on the degree:

* **the filtration is exhaustive**: every class lies in some `L_d`, because every rational
  function is a ratio of two polynomials;
* **the tame symbol at a closed point of `A¹_k` of degree above `d` kills `L_d`.**

The second is immediate once stated: a nonzero polynomial of degree below `deg p` is not
divisible by `p`, hence is a unit of the local ring at `p`, and
`Stacks.Chow.dvrMilnorTameSymbol_eq_zero_of_units` says the tame symbol of a discrete valuation
ring kills a symbol of units. The work is the bookkeeping: turning a list of units of
`RatFunc k` that happen to be low-degree polynomials into a list of units of the local ring, so
that the symbol is literally a `Stacks.Chow.unitSymbolProd`.

Together the two say that a given class of `K^M_*(RatFunc k)` has a vanishing residue at every
closed point of degree above some bound. What is **not** here is the description of the
successive quotients `L_d / L_{d-1}`, which is the inductive heart of Milnor's exact sequence.

## Main definitions

* `Stacks.Chow.polyUnit` — a nonzero polynomial, as a unit of `RatFunc k`.
* `Stacks.Chow.polyUnitsOfDegreeLE` — the units of `RatFunc k` that are nonzero polynomials of
  degree at most `d`.
* `Stacks.Chow.milnorKPolyFiltration` — the subgroup `L_d` of `K^M_*(RatFunc k)`.

## Main results

* `Stacks.Chow.milnorKPolyFiltration_mono` — the filtration is increasing.
* `Stacks.Chow.milnorKSymbol_mul_mem_milnorKPolyFiltration` — multiplying by a low-degree symbol
  respects it.
* `Stacks.Chow.exists_mem_milnorKPolyFiltration` — **the filtration is exhaustive.**
* `Stacks.Chow.milnorKPolyFiltration_eq_iSup_inf_milnorKGrading` — **each step is the sum of its
  homogeneous pieces**, its generators being homogeneous.
* `Stacks.Chow.notMem_span_singleton_of_natDegree_lt` — a nonzero polynomial of degree below
  `deg p` is not a multiple of `p`.
* `Stacks.Chow.exists_unit_localization_of_mem_polyUnitsOfDegreeLE` — such a polynomial is a unit
  of the local ring at `p`.
* `Stacks.Chow.affineLineResidue_eq_zero_of_mem_milnorKPolyFiltration` — **`∂_p` kills `L_d` when
  `d < deg p`.**

## Implementation notes

`L_d` is a subgroup of the whole Milnor K-ring rather than of one graded piece: that is the shape
in which the generation principle
`milnorKGrading_le_of_forall_milnorKSymbolProd_mem` is stated, and the statements below are
applied to a homogeneous class by asking that its image in the ring lie in `L_d`.

The filtration is indexed by `Polynomial.natDegree`, so `L_0` is generated by the symbols of the
nonzero constants: `natDegree` of a nonzero constant is `0`.

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
-/

@[expose] public noncomputable section

open IsLocalRing IsDiscreteValuationRing Polynomial

universe u

namespace Stacks.Chow

variable {k : Type u} [Field k]

/-! ### Polynomials as units of the rational function field -/

/-- A nonzero polynomial is nonzero as a rational function. -/
theorem algebraMap_polynomial_ratFunc_ne_zero {f : Polynomial k} (hf : f ≠ 0) :
    algebraMap (Polynomial k) (RatFunc k) f ≠ 0 :=
  (map_ne_zero_iff _ (IsFractionRing.injective (Polynomial k) (RatFunc k))).mpr hf

/-- A nonzero polynomial, as a unit of the rational function field. -/
def polyUnit {f : Polynomial k} (hf : f ≠ 0) : (RatFunc k)ˣ :=
  Units.mk0 _ (algebraMap_polynomial_ratFunc_ne_zero hf)

/-- The rational function underlying `polyUnit hf` is the image of `f`. -/
@[simp]
theorem coe_polyUnit {f : Polynomial k} (hf : f ≠ 0) :
    (polyUnit hf : RatFunc k) = algebraMap (Polynomial k) (RatFunc k) f := rfl

/-- The units of `RatFunc k` which are nonzero polynomials of degree at most `d`. -/
def polyUnitsOfDegreeLE (k : Type u) [Field k] (d : ℕ) : Set (RatFunc k)ˣ :=
  {u | ∃ f : Polynomial k, ∃ hf : f ≠ 0, f.natDegree ≤ d ∧ polyUnit hf = u}

/-- The unit of a nonzero polynomial of degree at most `d` lies in `polyUnitsOfDegreeLE k d`. -/
theorem polyUnit_mem_polyUnitsOfDegreeLE {f : Polynomial k} (hf : f ≠ 0) {d : ℕ}
    (hd : f.natDegree ≤ d) : polyUnit hf ∈ polyUnitsOfDegreeLE k d :=
  ⟨f, hf, hd, rfl⟩

/-- The sets `polyUnitsOfDegreeLE k d` are increasing in `d`. -/
theorem polyUnitsOfDegreeLE_mono {d e : ℕ} (hde : d ≤ e) :
    polyUnitsOfDegreeLE k d ⊆ polyUnitsOfDegreeLE k e := by
  rintro u ⟨f, hf, hfd, rfl⟩
  exact ⟨f, hf, hfd.trans hde, rfl⟩

/-! ### The filtration -/

/-- **The degree filtration on the Milnor K-theory of `RatFunc k`.** `L_d` is the subgroup
generated by the symbols `{f_1, …, f_r}` of nonzero polynomials of degree at most `d`. -/
def milnorKPolyFiltration (k : Type u) [Field k] (d : ℕ) :
    AddSubgroup (MilnorKRing (RatFunc k)) :=
  AddSubgroup.closure {x | ∃ l : List (RatFunc k)ˣ,
    (∀ u ∈ l, u ∈ polyUnitsOfDegreeLE k d) ∧ milnorKSymbolProd (RatFunc k) l = x}

/-- The symbol of a list of nonzero polynomials of degree at most `d` lies in
`milnorKPolyFiltration k d`. -/
theorem milnorKSymbolProd_mem_milnorKPolyFiltration {d : ℕ} {l : List (RatFunc k)ˣ}
    (hl : ∀ u ∈ l, u ∈ polyUnitsOfDegreeLE k d) :
    milnorKSymbolProd (RatFunc k) l ∈ milnorKPolyFiltration k d :=
  AddSubgroup.subset_closure ⟨l, hl, rfl⟩

/-- The filtration is increasing. -/
theorem milnorKPolyFiltration_mono {d e : ℕ} (hde : d ≤ e) :
    milnorKPolyFiltration k d ≤ milnorKPolyFiltration k e := by
  refine AddSubgroup.closure_le _ |>.mpr ?_
  rintro x ⟨l, hl, rfl⟩
  exact milnorKSymbolProd_mem_milnorKPolyFiltration
    fun u hu ↦ polyUnitsOfDegreeLE_mono hde (hl u hu)

/-- A subgroup containing every symbol of nonzero polynomials of degree at most `d` contains
`L_d`. -/
theorem milnorKPolyFiltration_le {d : ℕ} {H : AddSubgroup (MilnorKRing (RatFunc k))}
    (hH : ∀ l : List (RatFunc k)ˣ, (∀ u ∈ l, u ∈ polyUnitsOfDegreeLE k d) →
      milnorKSymbolProd (RatFunc k) l ∈ H) :
    milnorKPolyFiltration k d ≤ H := by
  refine AddSubgroup.closure_le _ |>.mpr ?_
  rintro x ⟨l, hl, rfl⟩
  exact hH l hl

/-- **Multiplying by a low-degree symbol respects the filtration.** -/
theorem milnorKSymbol_mul_mem_milnorKPolyFiltration {d e : ℕ} {v : (RatFunc k)ˣ}
    (hv : v ∈ polyUnitsOfDegreeLE k e) {x : MilnorKRing (RatFunc k)}
    (hx : x ∈ milnorKPolyFiltration k d) :
    milnorKSymbol (RatFunc k) v * x ∈ milnorKPolyFiltration k (max e d) := by
  refine milnorKPolyFiltration_le (H := AddSubgroup.comap
    (AddMonoidHom.mulLeft (milnorKSymbol (RatFunc k) v))
      (milnorKPolyFiltration k (max e d))) ?_ hx
  intro l hl
  change milnorKSymbol (RatFunc k) v * milnorKSymbolProd (RatFunc k) l ∈
    milnorKPolyFiltration k (max e d)
  rw [← milnorKSymbolProd_cons]
  refine milnorKSymbolProd_mem_milnorKPolyFiltration fun w hw ↦ ?_
  rcases List.mem_cons.mp hw with rfl | hwl
  · exact polyUnitsOfDegreeLE_mono (le_max_left e d) hv
  · exact polyUnitsOfDegreeLE_mono (le_max_right e d) (hl w hwl)

/-! ### The filtration is exhaustive -/

/-- A unit of `RatFunc k` is a ratio of two nonzero polynomials: its numerator and its
denominator. -/
theorem exists_polyUnitsOfDegreeLE_div (u : (RatFunc k)ˣ) :
    ∃ (e : ℕ) (a b : (RatFunc k)ˣ), a ∈ polyUnitsOfDegreeLE k e ∧
      b ∈ polyUnitsOfDegreeLE k e ∧ u = a / b := by
  have hnum : (u : RatFunc k).num ≠ 0 := RatFunc.num_ne_zero u.ne_zero
  have hden : (u : RatFunc k).denom ≠ 0 := RatFunc.denom_ne_zero (u : RatFunc k)
  refine ⟨max (u : RatFunc k).num.natDegree (u : RatFunc k).denom.natDegree,
    polyUnit hnum, polyUnit hden,
    polyUnit_mem_polyUnitsOfDegreeLE hnum (le_max_left _ _),
    polyUnit_mem_polyUnitsOfDegreeLE hden (le_max_right _ _), Units.ext ?_⟩
  rw [Units.val_div_eq_div_val, coe_polyUnit, coe_polyUnit, RatFunc.num_div_denom]

/-- **Every symbol product of `K^M_*(RatFunc k)` lies in some step of the filtration.** Each
entry is a ratio of two polynomials, so its symbol is a difference of two symbols of
polynomials, and multiplying by those respects the filtration. -/
theorem exists_mem_milnorKPolyFiltration_milnorKSymbolProd (l : List (RatFunc k)ˣ) :
    ∃ d, milnorKSymbolProd (RatFunc k) l ∈ milnorKPolyFiltration k d := by
  induction l with
  | nil => exact ⟨0, milnorKSymbolProd_mem_milnorKPolyFiltration (by simp)⟩
  | cons u l ih =>
      obtain ⟨d, hd⟩ := ih
      obtain ⟨e, a, b, ha, hb, rfl⟩ := exists_polyUnitsOfDegreeLE_div u
      refine ⟨max e d, ?_⟩
      rw [milnorKSymbolProd_cons, milnorKSymbol_div, sub_mul]
      exact sub_mem (milnorKSymbol_mul_mem_milnorKPolyFiltration ha hd)
        (milnorKSymbol_mul_mem_milnorKPolyFiltration hb hd)

/-- **The degree filtration exhausts `K^M_*(RatFunc k)`:** every homogeneous class lies in some
`L_d`. Together with
`Stacks.Chow.affineLineResidue_eq_zero_of_mem_milnorKPolyFiltration` this says that only finitely
many closed points of `A¹_k` have a nonvanishing residue on a given class. -/
theorem exists_mem_milnorKPolyFiltration {n : ℕ} (y : MilnorKTheory (RatFunc k) n) :
    ∃ d, (y : MilnorKRing (RatFunc k)) ∈ milnorKPolyFiltration k d := by
  have hdir : Directed (· ≤ ·) (milnorKPolyFiltration k) :=
    (monotone_nat_of_le_succ fun d ↦ milnorKPolyFiltration_mono (Nat.le_succ d)).directed_le
  refine (AddSubgroup.mem_iSup_of_directed hdir).mp
    (coe_mem_of_forall_milnorKSymbolProd_mem (H := ⨆ d, milnorKPolyFiltration k d)
      (fun l ↦ ?_) y)
  obtain ⟨d, hd⟩ := exists_mem_milnorKPolyFiltration_milnorKSymbolProd l
  exact (AddSubgroup.mem_iSup_of_directed hdir).mpr ⟨d, hd⟩

/-! ### The filtration is homogeneous -/

/-- **Each step of the filtration is the sum of its homogeneous pieces.** The generators are the
symbol products, and a symbol product of `r` entries is homogeneous of degree `r`, so `L_d` is
generated by homogeneous elements of `L_d`. -/
theorem milnorKPolyFiltration_eq_iSup_inf_milnorKGrading (d : ℕ) :
    milnorKPolyFiltration k d =
      ⨆ n : ℕ, milnorKPolyFiltration k d ⊓ milnorKGrading (RatFunc k) n := by
  refine le_antisymm (milnorKPolyFiltration_le fun l hl ↦ ?_)
    (iSup_le fun _ ↦ inf_le_left)
  exact le_iSup (fun n : ℕ ↦ milnorKPolyFiltration k d ⊓ milnorKGrading (RatFunc k) n) l.length
    ⟨milnorKSymbolProd_mem_milnorKPolyFiltration hl, milnorKSymbolProd_mem_milnorKGrading l⟩

/-! ### The local ring at a closed point of large degree -/

/-- A nonzero polynomial of degree below that of `p` is not a multiple of `p`. -/
theorem notMem_span_singleton_of_natDegree_lt {p f : Polynomial k} (hf : f ≠ 0)
    (hdeg : f.natDegree < p.natDegree) : f ∉ Ideal.span {p} := fun hmem ↦
  absurd (Polynomial.natDegree_le_of_dvd (Ideal.mem_span_singleton.mp hmem) hf)
    (by omega)

/-- Such a polynomial is a unit of the local ring of `A¹_k` at `p`. -/
theorem isUnit_algebraMap_localizationAtPrime {p f : Polynomial k}
    [(Ideal.span {p}).IsPrime] (hf : f ≠ 0) (hdeg : f.natDegree < p.natDegree) :
    IsUnit (algebraMap (Polynomial k) (Localization.AtPrime (Ideal.span {p})) f) :=
  IsLocalization.map_units (M := (Ideal.span {p}).primeCompl) _
    ⟨f, Ideal.mem_primeCompl_iff.mpr (notMem_span_singleton_of_natDegree_lt hf hdeg)⟩

/-- **A unit of `RatFunc k` of polynomial degree below `deg p` comes from a unit of the local
ring at `p`.** -/
theorem exists_unit_localization_of_mem_polyUnitsOfDegreeLE {p : Polynomial k}
    [(Ideal.span {p}).IsPrime] {d : ℕ} (hd : d < p.natDegree) {u : (RatFunc k)ˣ}
    (hu : u ∈ polyUnitsOfDegreeLE k d) :
    ∃ w : (Localization.AtPrime (Ideal.span {p}))ˣ,
      Units.map (algebraMap (Localization.AtPrime (Ideal.span {p})) (RatFunc k) :
        Localization.AtPrime (Ideal.span {p}) →* RatFunc k) w = u := by
  obtain ⟨f, hf, hfd, rfl⟩ := hu
  obtain ⟨w, hw⟩ := isUnit_algebraMap_localizationAtPrime (p := p) hf (hfd.trans_lt hd)
  refine ⟨w, Units.ext ?_⟩
  change algebraMap (Localization.AtPrime (Ideal.span {p})) (RatFunc k) (w : _) =
    algebraMap (Polynomial k) (RatFunc k) f
  rw [hw, ← IsScalarTower.algebraMap_apply]

/-- A list of such units comes from a list of units of the local ring at `p`. -/
theorem exists_unitList_localization {p : Polynomial k} [(Ideal.span {p}).IsPrime] {d : ℕ}
    (hd : d < p.natDegree) {l : List (RatFunc k)ˣ}
    (hl : ∀ u ∈ l, u ∈ polyUnitsOfDegreeLE k d) :
    ∃ l' : List (Localization.AtPrime (Ideal.span {p}))ˣ,
      l'.map (Units.map (algebraMap (Localization.AtPrime (Ideal.span {p})) (RatFunc k) :
        Localization.AtPrime (Ideal.span {p}) →* RatFunc k)) = l := by
  induction l with
  | nil => exact ⟨[], rfl⟩
  | cons u l ih =>
      obtain ⟨w, hw⟩ := exists_unit_localization_of_mem_polyUnitsOfDegreeLE hd
        (hl u List.mem_cons_self)
      obtain ⟨l', hl'⟩ := ih fun v hv ↦ hl v (List.mem_cons_of_mem u hv)
      exact ⟨w :: l', by rw [List.map_cons, hw, hl']⟩

/-! ### The tame symbol at a closed point of large degree kills the filtration -/

/-- **The ring-level form: the tame symbol of the local ring at `p` kills `L_d` for
`d < deg p`.** The `ξ`-coefficient of the image of such a symbol vanishes, because the symbol is
one of units of the local ring. -/
theorem shift_dvrMilnorShiftMap_eq_zero_of_mem_milnorKPolyFiltration {p : Polynomial k}
    [(Ideal.span {p}).IsPrime]
    [IsDiscreteValuationRing (Localization.AtPrime (Ideal.span {p}))]
    {ϖ : Localization.AtPrime (Ideal.span {p})} (hϖ : Irreducible ϖ) {d : ℕ}
    (hd : d < p.natDegree) {x : MilnorKRing (RatFunc k)}
    (hx : x ∈ milnorKPolyFiltration k d) :
    MilnorKShift.shift (dvrMilnorShiftMap (F := RatFunc k) hϖ x) = 0 := by
  refine milnorKPolyFiltration_le (H := AddMonoidHom.ker
    ((MilnorKShift.shiftHom (ResidueField (Localization.AtPrime (Ideal.span {p})))).comp
      (dvrMilnorShiftMap (F := RatFunc k) hϖ).toAddMonoidHom)) ?_ hx
  intro l hl
  obtain ⟨l', rfl⟩ := exists_unitList_localization hd hl
  rw [AddMonoidHom.mem_ker]
  change MilnorKShift.shift (dvrMilnorShiftMap (F := RatFunc k) hϖ
    (unitSymbolProd (RatFunc k) l')) = 0
  rw [dvrMilnorShiftMap_unitSymbolProd, MilnorKShift.shift_mk]

/-- **Stacks 0EAY, Milnor's lemma, the easy half: the tame symbol of `A¹_k` at a closed point of
degree above `d` kills the degree-`d` part of the filtration.** A nonzero polynomial of degree at
most `d` is not divisible by `p`, so it is a unit of the local ring at `p`, and the tame symbol
of a discrete valuation ring kills a symbol of units. -/
theorem affineLineResidue_eq_zero_of_mem_milnorKPolyFiltration {p : Polynomial k}
    [(Ideal.span {p}).IsMaximal] {d : ℕ} (hd : d < p.natDegree) (i : ℕ)
    {y : MilnorKTheory (RatFunc k) (i + 1)}
    (hy : (y : MilnorKRing (RatFunc k)) ∈ milnorKPolyFiltration k d) :
    affineLineResidue (Ideal.span {p}) i y = 0 := by
  have := isDiscreteValuationRing_localizationAtPrime_polynomial (Ideal.span {p} : Ideal
    (Polynomial k))
  refine Subtype.ext ?_
  change MilnorKShift.shift (dvrMilnorShiftMap (F := RatFunc k)
    (exists_irreducible (Localization.AtPrime (Ideal.span {p}))).choose_spec
      (y : MilnorKRing (RatFunc k))) = 0
  exact shift_dvrMilnorShiftMap_eq_zero_of_mem_milnorKPolyFiltration _ hd hy

/-- The same, read in the Milnor K-theory of `k[X] ⧸ p`. -/
theorem affineLineResidueQuot_eq_zero_of_mem_milnorKPolyFiltration {p : Polynomial k}
    [(Ideal.span {p}).IsMaximal] {d : ℕ} (hd : d < p.natDegree) (i : ℕ)
    {y : MilnorKTheory (RatFunc k) (i + 1)}
    (hy : (y : MilnorKRing (RatFunc k)) ∈ milnorKPolyFiltration k d) :
    affineLineResidueQuot (Ideal.span {p}) i y = 0 := by
  rw [affineLineResidueQuot_apply,
    affineLineResidue_eq_zero_of_mem_milnorKPolyFiltration hd i hy, map_zero]

end Stacks.Chow

end
