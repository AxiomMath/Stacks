module

public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.InfinityResidue
public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.MiddleExactness

/-!
# The joint kernel of the residues of `A¹_k` is killed by the residue at infinity

Let `k` be a field. The injectivity statement of
`StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.MiddleExactness` compares two consecutive steps of
the degree filtration. Iterating it down to the bottom gives Milnor's exactness in the middle:

**a class of `K^M_*(RatFunc k)` whose residue vanishes at every closed point of `A¹_k` lies in
`L_0`** (`Stacks.Chow.mem_milnorKPolyFiltration_zero_of_forall_monicIrreducibleResidue_eq_zero`),

the filtration being exhaustive. Since `L_0` is generated by the symbols of nonzero *constants*,
and the substitution `X ↦ 1/X` fixes the constants, such a class is also killed by the residue at
infinity (`Stacks.Chow.infinityResidueRing_eq_zero_of_mem_milnorKPolyFiltration_zero`).

That conjunction is exactly what makes the norm map of a simple extension well defined: a class
with prescribed residues at the closed points of `A¹_k` is determined up to `L_0`, and the recipe
`-∂_∞` does not see the ambiguity.

## What is needed to iterate

Two statements about the whole Milnor K-ring, rather than one graded piece:

* every element is in the subgroup generated by the symbol products
  (`Stacks.Chow.mem_of_forall_milnorKSymbolProd_mem`) — the graded decomposition of the tensor
  algebra, followed by the generation principle
  `milnorKGrading_le_of_forall_milnorKSymbolProd_mem` in each degree;
* hence the degree filtration exhausts the ring
  (`Stacks.Chow.exists_mem_milnorKPolyFiltration_ring`), which is the ring-level form of
  `Stacks.Chow.exists_mem_milnorKPolyFiltration`.

The residue at infinity likewise has to be read on the whole ring
(`Stacks.Chow.infinityResidueRing`); `Stacks.Chow.coe_infinityResidue` says it agrees with
`Stacks.Chow.infinityResidue` in each degree.

## Main definitions

* `Stacks.Chow.infinityResidueRing` — `∂_∞` on the whole Milnor K-ring.

## Main results

* `Stacks.Chow.mem_of_forall_milnorKSymbolProd_mem` — the symbol products generate the ring
  additively.
* `Stacks.Chow.exists_mem_milnorKPolyFiltration_ring` — the filtration is exhaustive.
* `Stacks.Chow.exists_constantUnitList` — a list of symbols of constants comes from a list of
  units of `k`.
* `Stacks.Chow.coe_infinityResidue` — the two readings of `∂_∞` agree.
* `Stacks.Chow.mem_milnorKPolyFiltration_zero_of_forall_monicIrreducibleResidue_eq_zero` —
  **exactness in the middle.**
* `Stacks.Chow.infinityResidueRing_eq_zero_of_mem_milnorKPolyFiltration_zero` — **`∂_∞` kills
  `L_0`.**

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
-/

@[expose] public noncomputable section

open IsLocalRing Polynomial

universe u

namespace Stacks.Chow

variable {k : Type u} [Field k]

/-! ### The symbol products generate the whole ring -/

/-- **Every element of the Milnor K-ring lies in a subgroup containing all the symbol
products.** Decompose a preimage in the tensor algebra into its homogeneous pieces and apply the
generation principle in each degree. -/
theorem mem_of_forall_milnorKSymbolProd_mem {H : AddSubgroup (MilnorKRing k)}
    (hH : ∀ l : List kˣ, milnorKSymbolProd k l ∈ H) (x : MilnorKRing k) : x ∈ H := by
  classical
  obtain ⟨t, rfl⟩ := milnorKRing_mk'_surjective k x
  rw [← DirectSum.sum_support_decompose (milnorKTensorGrading k) t, map_sum]
  refine sum_mem fun n _ ↦ ?_
  refine milnorKGrading_le_of_forall_milnorKSymbolProd_mem hH n ?_
  exact ⟨(DirectSum.decompose (milnorKTensorGrading k) t n : MilnorKTensorAlgebra k),
    (DirectSum.decompose (milnorKTensorGrading k) t n).2, rfl⟩

/-- **The degree filtration exhausts the whole Milnor K-ring of `RatFunc k`.** -/
theorem exists_mem_milnorKPolyFiltration_ring (x : MilnorKRing (RatFunc k)) :
    ∃ d, x ∈ milnorKPolyFiltration k d := by
  have hdir : Directed (· ≤ ·) (milnorKPolyFiltration k) :=
    (monotone_nat_of_le_succ fun d ↦ milnorKPolyFiltration_mono (Nat.le_succ d)).directed_le
  refine (AddSubgroup.mem_iSup_of_directed hdir).mp
    (mem_of_forall_milnorKSymbolProd_mem (H := ⨆ d, milnorKPolyFiltration k d) (fun l ↦ ?_) x)
  obtain ⟨d, hd⟩ := exists_mem_milnorKPolyFiltration_milnorKSymbolProd l
  exact (AddSubgroup.mem_iSup_of_directed hdir).mpr ⟨d, hd⟩

/-! ### Exactness in the middle -/

/-- The descent through the filtration: an element of `L_d` all of whose residues vanish lies in
`L_0`. -/
theorem mem_milnorKPolyFiltration_zero_of_forall_of_mem {x : MilnorKRing (RatFunc k)}
    (hres : ∀ (e : ℕ) (ψ : MonicIrreducibleOfDegree k (e + 1)),
      monicIrreducibleResidue ψ x = 0) :
    ∀ d : ℕ, x ∈ milnorKPolyFiltration k d → x ∈ milnorKPolyFiltration k 0 := by
  intro d
  induction d with
  | zero => exact fun hx ↦ hx
  | succ e ih =>
      exact fun hx ↦ ih (mem_milnorKPolyFiltration_of_forall_monicIrreducibleResidue_eq_zero hx
        (hres e))

/-- **Stacks 0EAY, Milnor's exact sequence, exactness in the middle: a class of
`K^M_*(RatFunc k)` whose residue vanishes at every closed point of `A¹_k` lies in `L_0`**, the
subgroup generated by the symbols of nonzero constants. -/
theorem mem_milnorKPolyFiltration_zero_of_forall_monicIrreducibleResidue_eq_zero
    {x : MilnorKRing (RatFunc k)}
    (hres : ∀ (e : ℕ) (ψ : MonicIrreducibleOfDegree k (e + 1)),
      monicIrreducibleResidue ψ x = 0) :
    x ∈ milnorKPolyFiltration k 0 := by
  obtain ⟨d, hd⟩ := exists_mem_milnorKPolyFiltration_ring x
  exact mem_milnorKPolyFiltration_zero_of_forall_of_mem hres d hd

/-! ### Degree-zero entries are constants -/

/-- A unit of `RatFunc k` which is a nonzero polynomial of degree zero is a nonzero constant. -/
theorem exists_constantUnit_of_mem_polyUnitsOfDegreeLE_zero {u : (RatFunc k)ˣ}
    (hu : u ∈ polyUnitsOfDegreeLE k 0) :
    ∃ c : kˣ, Units.map (constantsHom k).toMonoidHom c = u := by
  obtain ⟨f, hf0, hfd, rfl⟩ := hu
  have hc : f.coeff 0 ≠ 0 := fun h ↦ hf0 (by
    rw [Polynomial.eq_C_of_natDegree_eq_zero (Nat.le_zero.mp hfd), h, map_zero])
  refine ⟨Units.mk0 (f.coeff 0) hc, Units.ext ?_⟩
  change constantsHom k (f.coeff 0) = algebraMap (Polynomial k) (RatFunc k) f
  rw [constantsHom, RingHom.comp_apply,
    ← Polynomial.eq_C_of_natDegree_eq_zero (Nat.le_zero.mp hfd)]

/-- **A list of symbols of degree-zero polynomials comes from a list of units of `k`.** -/
theorem exists_constantUnitList {l : List (RatFunc k)ˣ}
    (hl : ∀ u ∈ l, u ∈ polyUnitsOfDegreeLE k 0) :
    ∃ l₀ : List kˣ, l₀.map (Units.map (constantsHom k).toMonoidHom) = l := by
  induction l with
  | nil => exact ⟨[], rfl⟩
  | cons u l ih =>
      obtain ⟨c, hc⟩ := exists_constantUnit_of_mem_polyUnitsOfDegreeLE_zero
        (hl u List.mem_cons_self)
      obtain ⟨l₀, hl₀⟩ := ih fun v hv ↦ hl v (List.mem_cons_of_mem u hv)
      exact ⟨c :: l₀, by rw [List.map_cons, hc, hl₀]⟩

/-! ### The residue at infinity on the whole ring -/

/-- **The residue at infinity `∂_∞ : K^M_*(RatFunc k) ⟶ K^M_*(k)` on the whole Milnor K-ring.**
As for `Stacks.Chow.infinityResidue`, it is the residue at the origin precomposed with the
substitution `X ↦ 1/X`; the subgroup arguments about the degree filtration need it in this
reading. -/
def infinityResidueRing (k : Type u) [Field k] : MilnorKRing (RatFunc k) →+ MilnorKRing k :=
  ((milnorKRingMap ((residueFieldAtOriginEquiv k).symm :
          ResidueField (localRingAtOrigin k) →+* k)).toAddMonoidHom.comp
      ((MilnorKShift.shiftHom (ResidueField (localRingAtOrigin k))).comp
        (dvrMilnorShiftMap (F := RatFunc k)
          (irreducible_algebraMap_X (k := k))).toAddMonoidHom)).comp
    (milnorKRingMap
      (AlgebraicGeometry.projectiveLineChartInversion k).toRingHom).toAddMonoidHom

/-- **The two readings of the residue at infinity agree.** -/
theorem coe_infinityResidue (i : ℕ) (y : MilnorKTheory (RatFunc k) (i + 1)) :
    (infinityResidue i y : MilnorKRing k) =
      infinityResidueRing k (y : MilnorKRing (RatFunc k)) :=
  rfl

/-- **The residue at infinity kills `L_0`.** Every entry of a generator of `L_0` is a nonzero
constant, the substitution `X ↦ 1/X` fixes it, and a constant is a unit of the local ring at the
origin, so the symbol has no `ξ`-coefficient. -/
theorem infinityResidueRing_eq_zero_of_mem_milnorKPolyFiltration_zero
    {x : MilnorKRing (RatFunc k)} (hx : x ∈ milnorKPolyFiltration k 0) :
    infinityResidueRing k x = 0 := by
  refine milnorKPolyFiltration_le (H := AddMonoidHom.ker (infinityResidueRing k)) ?_ hx
  intro l hl
  obtain ⟨l₀, rfl⟩ := exists_constantUnitList hl
  refine AddMonoidHom.mem_ker.mpr ?_
  have hcoe : milnorKRingMap
        (AlgebraicGeometry.projectiveLineChartInversion k).toRingHom
        (milnorKSymbolProd (RatFunc k)
          (l₀.map (Units.map (constantsHom k).toMonoidHom))) =
      unitSymbolProd (RatFunc k) (l₀.map constantUnit) := by
    rw [milnorKRingMap_milnorKSymbolProd]
    refine Eq.trans ?_ (milnorKSymbolProd_constants_eq_unitSymbolProd l₀)
    refine congrArg (milnorKSymbolProd (RatFunc k)) ?_
    rw [List.map_map]
    exact List.map_congr_left fun c _ ↦
      Units.ext (projectiveLineChartInversion_constantsHom (c : k))
  change milnorKRingMap ((residueFieldAtOriginEquiv k).symm :
      ResidueField (localRingAtOrigin k) →+* k)
      (MilnorKShift.shift (dvrMilnorShiftMap (F := RatFunc k)
        (irreducible_algebraMap_X (k := k))
        (milnorKRingMap (AlgebraicGeometry.projectiveLineChartInversion k).toRingHom
          (milnorKSymbolProd (RatFunc k)
            (l₀.map (Units.map (constantsHom k).toMonoidHom)))))) = 0
  rw [hcoe, dvrMilnorShiftMap_unitSymbolProd, MilnorKShift.shift_mk, map_zero]

end Stacks.Chow

end
