module

public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.LowDegreeRepresentative
public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.RepresentativeDefect

/-!
# The inverse of the residue map on a step of the degree filtration

Let `k` be a field and let `φ ∈ k[X]` be monic irreducible of degree `e + 1`, so that
`κ = k[X] ⧸ φ` is a simple extension of `k`. This file constructs the homomorphism

`s_φ : K^M_*(κ) ⟶ L_{e+1} / L_e`,

`s_φ {ū_1, …, ū_m} = {rep ū_1, …, rep ū_m, φ}`,

which is the inverse of the residue `∂_φ` on `L_{e+1} / L_e` and the heart of Milnor's exact
sequence for a rational function field. Its construction is the only place where the relations of
`κ` have to be lifted to `k[X]`, and the point of the file is that **the lift goes through
without any choice**: by
`StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.LowDegreeRepresentative` the Steinberg relations
of `κ` lift exactly, and by
`StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.RepresentativeDefect` the one relation that does
not lift — multiplicativity of the representative — dies modulo `L_e`.

## Implementation notes

A map *out of* `K^M_m(κ)` cannot be written down on symbols: the degree-`m` part of the Milnor
K-ring is a quotient, and the relations between its symbols would have to be presented. The way
round that, used here, is to produce a **ring** homomorphism out of the whole Milnor K-ring and
then evaluate it. Write `Q = K^M_*(RatFunc k) / L_e` and let

`C₀ = image in Q of {φ} · L_e`

(`Stacks.Chow.uniformizerMulQuotient`). Then:

* left multiplication by a sum of symbols of polynomials of degree at most `e` acts on `C₀`
  (`Stacks.Chow.uniformizerMulLeft`), because `{φ}` anticommutes with a single symbol and `L_e` is
  a subring;
* **the multiplicative defect of the representative acts as zero on `C₀`**
  (`Stacks.Chow.uniformizerMulLeftHom_polyRepDegreeOne_mul`), which is exactly
  `Stacks.Chow.milnorKSymbol_representativeDefect_mul_mem`; so `ū ↦ ` left multiplication by
  `{rep ū}` is additive;
* it kills the Steinberg relations, because `rep ū + rep (1 - ū) = 1` on the nose
  (`Stacks.Chow.polyRep_add_polyRep_eq_one`).

So it is a ring homomorphism `ρ : K^M_*(κ) ⟶ End(C₀)` (`Stacks.Chow.polySectionRingMap`), and
`s_φ(α) = ρ(α) [{φ}]` (`Stacks.Chow.polyResidueSection`). Evaluating at `[{φ}]` is what turns a
ring homomorphism into the degree-shifting map wanted, and
`Stacks.Chow.polyResidueSection_milnorKSymbolProd` reads off its value on a symbol.

## Main definitions

* `Stacks.Chow.milnorKPolyQuotient`, `Stacks.Chow.milnorKPolyQuotientMk` — the quotient `Q` and
  its projection.
* `Stacks.Chow.milnorKDegreeOneFiltration` — the subgroup generated by the single symbols of
  polynomials of degree at most `e`.
* `Stacks.Chow.uniformizerMulFiltration`, `Stacks.Chow.uniformizerMulQuotient` — `{φ} · L_e` and
  its image `C₀` in `Q`.
* `Stacks.Chow.uniformizerMulLeft`, `Stacks.Chow.uniformizerMulLeftHom` — the action on `C₀`.
* `Stacks.Chow.polyRepDegreeOne` — `{rep ū}`, as a degree-one element.
* `Stacks.Chow.polySectionTheta`, `Stacks.Chow.polySectionRingMap` — the degree-one map and the
  ring homomorphism it generates.
* `Stacks.Chow.uniformizerClass` — the class `[{φ}] ∈ C₀`.
* `Stacks.Chow.polyResidueSection` — **the map `s_φ`.**

## Main results

* `Stacks.Chow.mul_milnorKSymbol_eq_neg` — a degree-one element anticommutes with a symbol.
* `Stacks.Chow.uniformizerMulLeft_eq_zero` — the vanishing criterion for the action.
* `Stacks.Chow.uniformizerMulLeftHom_polyRepDegreeOne_mul` — **additivity, the defect being
  killed.**
* `Stacks.Chow.uniformizerMulLeftHom_polyRepDegreeOne_steinberg` — **the Steinberg relations are
  killed.**
* `Stacks.Chow.polyResidueSection_milnorKSymbolProd` — **`s_φ {ū_1, …, ū_m}` is the class of
  `{rep ū_1, …, rep ū_m, φ}`.**

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
-/

@[expose] public noncomputable section

open Polynomial

universe u

namespace Stacks.Chow

/- The quotient of `k[X]` by a maximal ideal is a field, and its Milnor K-ring is the source of
the map built here. In `Mathlib` this is a definition rather than a global instance. -/
attribute [local instance] Ideal.Quotient.field

variable {k : Type u} [Field k]

/-! ### The quotient by a step of the filtration -/

/-- The quotient `K^M_*(RatFunc k) / L_e` of the Milnor K-ring by a step of the degree
filtration, as an additive group. -/
abbrev milnorKPolyQuotient (k : Type u) [Field k] (e : ℕ) : Type u :=
  MilnorKRing (RatFunc k) ⧸ milnorKPolyFiltration k e

/-- The projection onto `K^M_*(RatFunc k) / L_e`. -/
abbrev milnorKPolyQuotientMk (k : Type u) [Field k] (e : ℕ) :
    MilnorKRing (RatFunc k) →+ milnorKPolyQuotient k e :=
  QuotientAddGroup.mk' (milnorKPolyFiltration k e)

/-- An element maps to zero in `K^M_*(RatFunc k) / L_e` if and only if it lies in `L_e`. -/
theorem milnorKPolyQuotientMk_eq_zero_iff {e : ℕ} (x : MilnorKRing (RatFunc k)) :
    milnorKPolyQuotientMk k e x = 0 ↔ x ∈ milnorKPolyFiltration k e :=
  QuotientAddGroup.eq_zero_iff x

/-! ### The degree-one part of a step -/

/-- The subgroup of `K^M_*(RatFunc k)` generated by the symbols of single nonzero polynomials of
degree at most `e`. It is the set of elements which act on the quotient below. -/
def milnorKDegreeOneFiltration (k : Type u) [Field k] (e : ℕ) :
    AddSubgroup (MilnorKRing (RatFunc k)) :=
  AddSubgroup.closure (milnorKSymbol (RatFunc k) '' polyUnitsOfDegreeLE k e)

/-- The symbol of a nonzero polynomial of degree at most `e` lies in
`Stacks.Chow.milnorKDegreeOneFiltration`. -/
theorem milnorKSymbol_mem_milnorKDegreeOneFiltration {e : ℕ} {v : (RatFunc k)ˣ}
    (hv : v ∈ polyUnitsOfDegreeLE k e) :
    milnorKSymbol (RatFunc k) v ∈ milnorKDegreeOneFiltration k e :=
  AddSubgroup.subset_closure ⟨v, hv, rfl⟩

/-- The degree-one subgroup `Stacks.Chow.milnorKDegreeOneFiltration` is contained in `L_e`. -/
theorem milnorKDegreeOneFiltration_le (e : ℕ) :
    milnorKDegreeOneFiltration k e ≤ milnorKPolyFiltration k e := by
  refine (AddSubgroup.closure_le _).mpr ?_
  rintro _ ⟨v, hv, rfl⟩
  exact milnorKSymbol_mem_milnorKPolyFiltration hv

/-- **A degree-one element anticommutes with a single symbol:** `b {w} = -({w} b)` for every
`b ∈ Stacks.Chow.milnorKDegreeOneFiltration`. The elements with this property form a subgroup,
and the generators of `Stacks.Chow.milnorKDegreeOneFiltration` have it by
`milnorKSymbol_mul_add_mul_comm`. -/
theorem mul_milnorKSymbol_eq_neg {e : ℕ} (w : (RatFunc k)ˣ)
    {b : MilnorKRing (RatFunc k)} (hb : b ∈ milnorKDegreeOneFiltration k e) :
    b * milnorKSymbol (RatFunc k) w = -(milnorKSymbol (RatFunc k) w * b) := by
  refine (AddSubgroup.closure_le (AddMonoidHom.eqLocus
    (AddMonoidHom.mulRight (milnorKSymbol (RatFunc k) w))
    (-(AddMonoidHom.mulLeft (milnorKSymbol (RatFunc k) w)))) ).mpr ?_ hb
  rintro _ ⟨v, -, rfl⟩
  exact eq_neg_of_add_eq_zero_left (milnorKSymbol_mul_add_mul_comm (k := RatFunc k) v w)

/-! ### The uniformizer subgroup and its class in the quotient -/

/-- The subgroup `{φ} · L_e` of `K^M_*(RatFunc k)`. -/
def uniformizerMulFiltration {φ : Polynomial k} (hφ0 : φ ≠ 0) (e : ℕ) :
    AddSubgroup (MilnorKRing (RatFunc k)) :=
  AddSubgroup.map (AddMonoidHom.mulLeft (milnorKSymbol (RatFunc k) (polyUnit hφ0)))
    (milnorKPolyFiltration k e)

/-- For `a ∈ L_e`, the product `{φ} a` lies in `{φ} · L_e`. -/
theorem mem_uniformizerMulFiltration {φ : Polynomial k} (hφ0 : φ ≠ 0) {e : ℕ}
    {a : MilnorKRing (RatFunc k)} (ha : a ∈ milnorKPolyFiltration k e) :
    milnorKSymbol (RatFunc k) (polyUnit hφ0) * a ∈ uniformizerMulFiltration hφ0 e :=
  ⟨a, ha, rfl⟩

/-- **The subgroup `C₀` of `K^M_*(RatFunc k) / L_e`:** the image of `{φ} · L_e`. -/
def uniformizerMulQuotient {φ : Polynomial k} (hφ0 : φ ≠ 0) (e : ℕ) :
    AddSubgroup (milnorKPolyQuotient k e) :=
  AddSubgroup.map (milnorKPolyQuotientMk k e) (uniformizerMulFiltration hφ0 e)

/-- Every element of `C₀` is the class of `{φ} a` for some `a ∈ L_e`. -/
theorem exists_of_mem_uniformizerMulQuotient {φ : Polynomial k} (hφ0 : φ ≠ 0) {e : ℕ}
    {c : milnorKPolyQuotient k e} (hc : c ∈ uniformizerMulQuotient hφ0 e) :
    ∃ a ∈ milnorKPolyFiltration k e,
      milnorKPolyQuotientMk k e (milnorKSymbol (RatFunc k) (polyUnit hφ0) * a) = c := by
  obtain ⟨y, ⟨a, ha, rfl⟩, hy⟩ := hc
  exact ⟨a, ha, hy⟩

/-- The class `[{φ}]` of the uniformizer in `C₀`. Evaluating the ring homomorphism below at it is
what produces the degree-shifting map. -/
def uniformizerClass {φ : Polynomial k} (hφ0 : φ ≠ 0) (e : ℕ) :
    ↥(uniformizerMulQuotient hφ0 e) :=
  ⟨milnorKPolyQuotientMk k e (milnorKSymbol (RatFunc k) (polyUnit hφ0)),
    ⟨milnorKSymbol (RatFunc k) (polyUnit hφ0),
      ⟨1, one_mem_milnorKPolyFiltration e, mul_one _⟩, rfl⟩⟩

/-! ### The action of a degree-one element -/

/-- Left multiplication by a degree-one element of `L_e`, descended to `K^M_*(RatFunc k) / L_e`:
it is well defined because `L_e` is closed under multiplication. -/
def milnorKQuotientMulLeft {e : ℕ} (b : ↥(milnorKDegreeOneFiltration k e)) :
    milnorKPolyQuotient k e →+ milnorKPolyQuotient k e :=
  QuotientAddGroup.lift (milnorKPolyFiltration k e)
    ((milnorKPolyQuotientMk k e).comp
      (AddMonoidHom.mulLeft (b : MilnorKRing (RatFunc k))))
    fun _ hx ↦ AddMonoidHom.mem_ker.mpr ((milnorKPolyQuotientMk_eq_zero_iff _).mpr
      (mul_mem_milnorKPolyFiltration_self (milnorKDegreeOneFiltration_le e b.2) hx))

/-- Left multiplication by `b` sends the class of `x` to the class of `b x`. -/
@[simp]
theorem milnorKQuotientMulLeft_mk {e : ℕ} (b : ↥(milnorKDegreeOneFiltration k e))
    (x : MilnorKRing (RatFunc k)) :
    milnorKQuotientMulLeft b (milnorKPolyQuotientMk k e x) =
      milnorKPolyQuotientMk k e ((b : MilnorKRing (RatFunc k)) * x) := rfl

/-- Every element of `K^M_*(RatFunc k) / L_e` is the class of an element of the ring. -/
private theorem exists_mk_eq {e : ℕ} (c : milnorKPolyQuotient k e) :
    ∃ x, milnorKPolyQuotientMk k e x = c :=
  QuotientAddGroup.mk_surjective c

/-- Left multiplication on `K^M_*(RatFunc k) / L_e` is additive in the acting element. -/
theorem milnorKQuotientMulLeft_add {e : ℕ} (b₁ b₂ : ↥(milnorKDegreeOneFiltration k e)) :
    milnorKQuotientMulLeft (b₁ + b₂) =
      milnorKQuotientMulLeft b₁ + milnorKQuotientMulLeft b₂ :=
  AddMonoidHom.ext fun c ↦ by
    obtain ⟨x, rfl⟩ := exists_mk_eq c
    rw [milnorKQuotientMulLeft_mk, AddSubgroup.coe_add, add_mul, map_add]
    rfl

/-- Left multiplication by a degree-one element of `L_e` preserves `C₀`:
`{v} ({φ} a) = -({φ} ({v} a))`, and `{v} a` is again in `L_e`. -/
theorem milnorKQuotientMulLeft_mem_uniformizerMulQuotient {φ : Polynomial k} (hφ0 : φ ≠ 0)
    {e : ℕ} (b : ↥(milnorKDegreeOneFiltration k e))
    {c : milnorKPolyQuotient k e} (hc : c ∈ uniformizerMulQuotient hφ0 e) :
    milnorKQuotientMulLeft b c ∈ uniformizerMulQuotient hφ0 e := by
  obtain ⟨a, ha, rfl⟩ := exists_of_mem_uniformizerMulQuotient hφ0 hc
  rw [milnorKQuotientMulLeft_mk, ← mul_assoc, mul_milnorKSymbol_eq_neg (polyUnit hφ0) b.2,
    neg_mul, map_neg]
  refine neg_mem ⟨milnorKSymbol (RatFunc k) (polyUnit hφ0) *
    ((b : MilnorKRing (RatFunc k)) * a), ?_, ?_⟩
  · exact mem_uniformizerMulFiltration hφ0 (mul_mem_milnorKPolyFiltration_self
      (milnorKDegreeOneFiltration_le e b.2) ha)
  · exact congrArg (milnorKPolyQuotientMk k e) (mul_assoc _ _ _).symm

/-- **The action of a degree-one element of `L_e` on `C₀`.** -/
def uniformizerMulLeft {φ : Polynomial k} (hφ0 : φ ≠ 0) {e : ℕ}
    (b : ↥(milnorKDegreeOneFiltration k e)) :
    Module.End ℤ ↥(uniformizerMulQuotient hφ0 e) :=
  AddMonoidHom.toIntLinearMap
    (AddMonoidHom.codRestrict ((milnorKQuotientMulLeft b).comp
        (uniformizerMulQuotient hφ0 e).subtype) (uniformizerMulQuotient hφ0 e)
      fun c ↦ milnorKQuotientMulLeft_mem_uniformizerMulQuotient hφ0 b c.2)

/-- The action on `C₀` is the restriction of left multiplication on `K^M_*(RatFunc k) / L_e`. -/
@[simp]
theorem uniformizerMulLeft_coe {φ : Polynomial k} (hφ0 : φ ≠ 0) {e : ℕ}
    (b : ↥(milnorKDegreeOneFiltration k e)) (c : ↥(uniformizerMulQuotient hφ0 e)) :
    (uniformizerMulLeft hφ0 b c : milnorKPolyQuotient k e) =
      milnorKQuotientMulLeft b (c : milnorKPolyQuotient k e) := rfl

/-- **The vanishing criterion for the action:** a degree-one element whose product with `{φ}`
already lies in `L_e` acts as zero on `C₀`. -/
theorem uniformizerMulLeft_eq_zero {φ : Polynomial k} (hφ0 : φ ≠ 0) {e : ℕ}
    {b : ↥(milnorKDegreeOneFiltration k e)}
    (hb : (b : MilnorKRing (RatFunc k)) * milnorKSymbol (RatFunc k) (polyUnit hφ0) ∈
      milnorKPolyFiltration k e) :
    uniformizerMulLeft hφ0 b = 0 := by
  refine LinearMap.ext fun c ↦ Subtype.ext ?_
  obtain ⟨a, ha, hca⟩ := exists_of_mem_uniformizerMulQuotient hφ0 c.2
  change milnorKQuotientMulLeft b (c : milnorKPolyQuotient k e) = 0
  rw [← hca, milnorKQuotientMulLeft_mk, ← mul_assoc]
  exact (milnorKPolyQuotientMk_eq_zero_iff _).mpr (mul_mem_milnorKPolyFiltration_self hb ha)

/-- If two degree-one elements have product zero, the composite of their actions on `C₀` is
zero. -/
theorem uniformizerMulLeft_mul_eq_zero {φ : Polynomial k} (hφ0 : φ ≠ 0) {e : ℕ}
    {b₁ b₂ : ↥(milnorKDegreeOneFiltration k e)}
    (hb : (b₁ : MilnorKRing (RatFunc k)) * (b₂ : MilnorKRing (RatFunc k)) = 0) :
    uniformizerMulLeft hφ0 b₁ * uniformizerMulLeft hφ0 b₂ = 0 := by
  refine LinearMap.ext fun c ↦ Subtype.ext ?_
  obtain ⟨x, hx⟩ := exists_mk_eq (c : milnorKPolyQuotient k e)
  change milnorKQuotientMulLeft b₁ (milnorKQuotientMulLeft b₂
    (c : milnorKPolyQuotient k e)) = 0
  rw [← hx, milnorKQuotientMulLeft_mk, milnorKQuotientMulLeft_mk, ← mul_assoc, hb, zero_mul,
    map_zero]

/-- The action on `C₀`, as an additive homomorphism in the acting element. -/
def uniformizerMulLeftHom {φ : Polynomial k} (hφ0 : φ ≠ 0) (e : ℕ) :
    ↥(milnorKDegreeOneFiltration k e) →+ Module.End ℤ ↥(uniformizerMulQuotient hφ0 e) where
  toFun := uniformizerMulLeft hφ0
  map_zero' := by
    refine LinearMap.ext fun c ↦ Subtype.ext ?_
    change milnorKQuotientMulLeft (0 : ↥(milnorKDegreeOneFiltration k e))
      (c : milnorKPolyQuotient k e) = 0
    obtain ⟨x, hx⟩ := QuotientAddGroup.mk_surjective (c : milnorKPolyQuotient k e)
    rw [← hx]
    change milnorKQuotientMulLeft (0 : ↥(milnorKDegreeOneFiltration k e))
      (milnorKPolyQuotientMk k e x) = 0
    rw [milnorKQuotientMulLeft_mk, ZeroMemClass.coe_zero, zero_mul, map_zero]
  map_add' b₁ b₂ := by
    refine LinearMap.ext fun c ↦ Subtype.ext ?_
    change milnorKQuotientMulLeft (b₁ + b₂) (c : milnorKPolyQuotient k e) =
      milnorKQuotientMulLeft b₁ (c : milnorKPolyQuotient k e) +
        milnorKQuotientMulLeft b₂ (c : milnorKPolyQuotient k e)
    rw [milnorKQuotientMulLeft_add]
    rfl

/-- `Stacks.Chow.uniformizerMulLeftHom` evaluated at `b` is the action of `b`. -/
@[simp]
theorem uniformizerMulLeftHom_apply {φ : Polynomial k} (hφ0 : φ ≠ 0) {e : ℕ}
    (b : ↥(milnorKDegreeOneFiltration k e)) :
    uniformizerMulLeftHom hφ0 e b = uniformizerMulLeft hφ0 b := rfl

/-! ### The representative as a degree-one element -/

variable {φ : Polynomial k} (hφm : φ.Monic) (hφ1 : φ ≠ 1) [(Ideal.span {φ}).IsMaximal]

/-- If `φ` has degree `e + 1`, the low-degree representative of a unit of `k[X] ⧸ φ` has degree
at most `e`. -/
theorem natDegree_polyRep_le {e : ℕ} (hφd : φ.natDegree = e + 1)
    (u : (Polynomial k ⧸ Ideal.span {φ})ˣ) : (polyRep hφm hφ1 u).natDegree ≤ e := by
  have h := natDegree_polyRep_lt hφm hφ1 u
  omega

/-- The symbol `{rep ū}` of the low-degree representative, as a degree-one element of `L_e`. -/
def polyRepDegreeOne {e : ℕ} (hφd : φ.natDegree = e + 1)
    (u : (Polynomial k ⧸ Ideal.span {φ})ˣ) : ↥(milnorKDegreeOneFiltration k e) :=
  ⟨milnorKSymbol (RatFunc k) (polyUnit (polyRep_ne_zero hφm hφ1 u)),
    milnorKSymbol_mem_milnorKDegreeOneFiltration
      (polyUnit_mem_polyUnitsOfDegreeLE _ (natDegree_polyRep_le hφm hφ1 hφd u))⟩

/-- The underlying element of `Stacks.Chow.polyRepDegreeOne` is the symbol `{rep ū}`. -/
@[simp]
theorem polyRepDegreeOne_coe {e : ℕ} (hφd : φ.natDegree = e + 1)
    (u : (Polynomial k ⧸ Ideal.span {φ})ˣ) :
    (polyRepDegreeOne hφm hφ1 hφd u : MilnorKRing (RatFunc k)) =
      milnorKSymbol (RatFunc k) (polyUnit (polyRep_ne_zero hφm hφ1 u)) := rfl

/-- The degree-one element attached to the unit `1` is zero. -/
theorem polyRepDegreeOne_one {e : ℕ} (hφd : φ.natDegree = e + 1) :
    polyRepDegreeOne hφm hφ1 hφd (1 : (Polynomial k ⧸ Ideal.span {φ})ˣ) = 0 := by
  refine Subtype.ext ?_
  rw [polyRepDegreeOne_coe, show polyUnit (polyRep_ne_zero hφm hφ1
      (1 : (Polynomial k ⧸ Ideal.span {φ})ˣ)) = (1 : (RatFunc k)ˣ) from
    Units.ext (by rw [coe_polyUnit, polyRep_one hφm hφ1, map_one, Units.val_one]),
    milnorKSymbol_one, ZeroMemClass.coe_zero]

/-! ### The two relations -/

/-- **The action of the representative is additive:** the action of `{rep (ū v̄)}` on `C₀` is
the sum of the actions of `{rep ū}` and `{rep v̄}`: the multiplicative defect acts as zero. This is
`Stacks.Chow.milnorKSymbol_representativeDefect_mul_mem` read through the vanishing criterion. -/
theorem uniformizerMulLeftHom_polyRepDegreeOne_mul (hφ0 : φ ≠ 0) {e : ℕ}
    (hφd : φ.natDegree = e + 1) (u v : (Polynomial k ⧸ Ideal.span {φ})ˣ) :
    uniformizerMulLeftHom hφ0 e (polyRepDegreeOne hφm hφ1 hφd (u * v)) =
      uniformizerMulLeftHom hφ0 e (polyRepDegreeOne hφm hφ1 hφd u) +
        uniformizerMulLeftHom hφ0 e (polyRepDegreeOne hφm hφ1 hφd v) := by
  have hdef := milnorKSymbol_representativeDefect_mul_mem hφ0 hφd
    (polyRep_ne_zero hφm hφ1 u) (polyRep_ne_zero hφm hφ1 v)
    (polyRep_ne_zero hφm hφ1 (u * v)) (natDegree_polyRep_le hφm hφ1 hφd u)
    (natDegree_polyRep_le hφm hφ1 hφd v) (natDegree_polyRep_le hφm hφ1 hφd (u * v))
    (dvd_polyRep_mul_sub_polyRep_mul hφm hφ1 u v)
  have hcoe : ((polyRepDegreeOne hφm hφ1 hφd (u * v) - polyRepDegreeOne hφm hφ1 hφd u -
        polyRepDegreeOne hφm hφ1 hφd v : ↥(milnorKDegreeOneFiltration k e)) :
          MilnorKRing (RatFunc k)) =
      -(milnorKSymbol (RatFunc k) (polyUnit (polyRep_ne_zero hφm hφ1 u)) +
        milnorKSymbol (RatFunc k) (polyUnit (polyRep_ne_zero hφm hφ1 v)) -
        milnorKSymbol (RatFunc k) (polyUnit (polyRep_ne_zero hφm hφ1 (u * v)))) := by
    rw [AddSubgroup.coe_sub, AddSubgroup.coe_sub, polyRepDegreeOne_coe, polyRepDegreeOne_coe,
      polyRepDegreeOne_coe]
    abel
  have hzero : uniformizerMulLeftHom hφ0 e (polyRepDegreeOne hφm hφ1 hφd (u * v) -
      polyRepDegreeOne hφm hφ1 hφd u - polyRepDegreeOne hφm hφ1 hφd v) = 0 := by
    refine uniformizerMulLeft_eq_zero hφ0 ?_
    rw [hcoe, neg_mul]
    exact neg_mem hdef
  rw [map_sub, map_sub, sub_sub, sub_eq_zero] at hzero
  exact hzero

/-- **The action of the representative kills the Steinberg relations:** if `ū + v̄ = 1`, the
composite of the actions of `{rep ū}` and `{rep v̄}` on `C₀` is zero. The representatives of
`ū` and of `v̄` sum to `1` in `k[X]`, so their symbols multiply to zero already in
`K^M_*(RatFunc k)`. -/
theorem uniformizerMulLeftHom_polyRepDegreeOne_steinberg (hφ0 : φ ≠ 0) {e : ℕ}
    (hφd : φ.natDegree = e + 1) {u v : (Polynomial k ⧸ Ideal.span {φ})ˣ}
    (huv : (u : Polynomial k ⧸ Ideal.span {φ}) + (v : Polynomial k ⧸ Ideal.span {φ}) = 1) :
    uniformizerMulLeftHom hφ0 e (polyRepDegreeOne hφm hφ1 hφd u) *
      uniformizerMulLeftHom hφ0 e (polyRepDegreeOne hφm hφ1 hφd v) = 0 := by
  refine uniformizerMulLeft_mul_eq_zero hφ0 ?_
  rw [polyRepDegreeOne_coe, polyRepDegreeOne_coe]
  refine milnorKSymbol_mul_steinberg ?_
  rw [coe_polyUnit, coe_polyUnit, ← map_add, polyRep_add_polyRep_eq_one hφm hφ1 huv, map_one]

/-! ### The ring homomorphism -/

/-- The degree-one map `ū ↦ ` left multiplication by `{rep ū}` on `C₀`. -/
def polySectionTheta (hφ0 : φ ≠ 0) {e : ℕ} (hφd : φ.natDegree = e + 1) :
    Additive (Polynomial k ⧸ Ideal.span {φ})ˣ →+
      Module.End ℤ ↥(uniformizerMulQuotient hφ0 e) where
  toFun x := uniformizerMulLeftHom hφ0 e
    (polyRepDegreeOne hφm hφ1 hφd (Additive.toMul x))
  map_zero' := by
    rw [show Additive.toMul (0 : Additive (Polynomial k ⧸ Ideal.span {φ})ˣ) = 1 from rfl,
      polyRepDegreeOne_one hφm hφ1 hφd, map_zero]
  map_add' x y := uniformizerMulLeftHom_polyRepDegreeOne_mul hφm hφ1 hφ0 hφd _ _

/-- `Stacks.Chow.polySectionTheta` sends `ū` to the action of `{rep ū}`. -/
@[simp]
theorem polySectionTheta_ofMul (hφ0 : φ ≠ 0) {e : ℕ} (hφd : φ.natDegree = e + 1)
    (u : (Polynomial k ⧸ Ideal.span {φ})ˣ) :
    polySectionTheta hφm hφ1 hφ0 hφd (Additive.ofMul u) =
      uniformizerMulLeftHom hφ0 e (polyRepDegreeOne hφm hφ1 hφd u) := rfl

/-- The map of the Milnor tensor algebra of `κ` into the endomorphisms of `C₀`. -/
def polySectionTensorMap (hφ0 : φ ≠ 0) {e : ℕ} (hφd : φ.natDegree = e + 1) :
    MilnorKTensorAlgebra (Polynomial k ⧸ Ideal.span {φ}) →ₐ[ℤ]
      Module.End ℤ ↥(uniformizerMulQuotient hφ0 e) :=
  TensorAlgebra.lift ℤ (AddMonoidHom.toIntLinearMap (polySectionTheta hφm hφ1 hφ0 hφd))

/-- `Stacks.Chow.polySectionTensorMap` restricts to `Stacks.Chow.polySectionTheta` on
generators. -/
@[simp]
theorem polySectionTensorMap_ι (hφ0 : φ ≠ 0) {e : ℕ} (hφd : φ.natDegree = e + 1)
    (a : Additive (Polynomial k ⧸ Ideal.span {φ})ˣ) :
    polySectionTensorMap hφm hφ1 hφ0 hφd (TensorAlgebra.ι ℤ a) =
      polySectionTheta hφm hφ1 hφ0 hφd a := by
  rw [polySectionTensorMap, TensorAlgebra.lift_ι_apply]
  rfl

/-- `Stacks.Chow.polySectionTensorMap` vanishes on the Steinberg relations of `κ`. -/
theorem polySectionTensorMap_of_mem_milnorKSteinbergRelations (hφ0 : φ ≠ 0) {e : ℕ}
    (hφd : φ.natDegree = e + 1)
    {x : MilnorKTensorAlgebra (Polynomial k ⧸ Ideal.span {φ})}
    (hx : x ∈ milnorKSteinbergRelations (Polynomial k ⧸ Ideal.span {φ})) :
    polySectionTensorMap hφm hφ1 hφ0 hφd x = 0 := by
  obtain ⟨a, rfl⟩ := hx
  rw [map_mul, polySectionTensorMap_ι, polySectionTensorMap_ι, polySectionTheta_ofMul,
    polySectionTheta_ofMul]
  refine uniformizerMulLeftHom_polyRepDegreeOne_steinberg hφm hφ1 hφ0 hφd ?_
  rw [Units.val_mk0, Units.val_mk0, add_sub_cancel]

/-- `Stacks.Chow.polySectionTensorMap` vanishes on the Steinberg ideal of `κ`. -/
theorem polySectionTensorMap_eq_zero_of_mem_milnorKSteinbergIdeal (hφ0 : φ ≠ 0) {e : ℕ}
    (hφd : φ.natDegree = e + 1)
    {x : MilnorKTensorAlgebra (Polynomial k ⧸ Ideal.span {φ})}
    (hx : x ∈ milnorKSteinbergIdeal (Polynomial k ⧸ Ideal.span {φ})) :
    polySectionTensorMap hφm hφ1 hφ0 hφd x = 0 := by
  induction hx using TwoSidedIdeal.span_induction with
  | mem x hx =>
      exact polySectionTensorMap_of_mem_milnorKSteinbergRelations hφm hφ1 hφ0 hφd hx
  | zero => exact map_zero _
  | add x y _ _ ihx ihy => rw [map_add, ihx, ihy, add_zero]
  | neg x _ ihx => rw [map_neg, ihx, neg_zero]
  | left_absorb a x _ ihx => rw [map_mul, ihx, mul_zero]
  | right_absorb b x _ ihx => rw [map_mul, ihx, zero_mul]

/-- **The ring homomorphism `K^M_*(κ) ⟶ End(C₀)`** sending `{ū}` to the action of `{rep ū}`. Its
value at `[{φ}]` is the inverse of the residue map. -/
def polySectionRingMap (hφ0 : φ ≠ 0) {e : ℕ} (hφd : φ.natDegree = e + 1) :
    MilnorKRing (Polynomial k ⧸ Ideal.span {φ}) →+*
      Module.End ℤ ↥(uniformizerMulQuotient hφ0 e) :=
  (milnorKSteinbergIdeal (Polynomial k ⧸ Ideal.span {φ})).ringCon.lift
    (polySectionTensorMap hφm hφ1 hφ0 hφd).toRingHom
    (by
      intro x y hxy
      rw [RingCon.ker_apply]
      have hmem : x - y ∈ milnorKSteinbergIdeal (Polynomial k ⧸ Ideal.span {φ}) :=
        ((milnorKSteinbergIdeal (Polynomial k ⧸ Ideal.span {φ})).rel_iff x y).mp hxy
      have hzero := polySectionTensorMap_eq_zero_of_mem_milnorKSteinbergIdeal hφm hφ1 hφ0 hφd hmem
      rw [map_sub, sub_eq_zero] at hzero
      exact hzero)

/-- `Stacks.Chow.polySectionRingMap` on the class of a tensor is `Stacks.Chow.polySectionTensorMap`
of that tensor. -/
@[simp]
theorem polySectionRingMap_mk' (hφ0 : φ ≠ 0) {e : ℕ} (hφd : φ.natDegree = e + 1)
    (x : MilnorKTensorAlgebra (Polynomial k ⧸ Ideal.span {φ})) :
    polySectionRingMap hφm hφ1 hφ0 hφd
        ((milnorKSteinbergIdeal (Polynomial k ⧸ Ideal.span {φ})).ringCon.mk' x) =
      polySectionTensorMap hφm hφ1 hφ0 hφd x := rfl

/-- `Stacks.Chow.polySectionRingMap` sends the symbol `{ū}` to the action of `{rep ū}`. -/
@[simp]
theorem polySectionRingMap_milnorKSymbol (hφ0 : φ ≠ 0) {e : ℕ} (hφd : φ.natDegree = e + 1)
    (u : (Polynomial k ⧸ Ideal.span {φ})ˣ) :
    polySectionRingMap hφm hφ1 hφ0 hφd
        (milnorKSymbol (Polynomial k ⧸ Ideal.span {φ}) u) =
      uniformizerMulLeftHom hφ0 e (polyRepDegreeOne hφm hφ1 hφd u) := by
  rw [milnorKSymbol_eq_mk', polySectionRingMap_mk', polySectionTensorMap_ι,
    polySectionTheta_ofMul]

/-! ### The section -/

/-- **The inverse of the residue map on `L_{e+1} / L_e`:** the homomorphism
`K^M_*(κ) ⟶ C₀ ⊆ K^M_*(RatFunc k) / L_e` sending `{ū_1, …, ū_m}` to the class of
`{rep ū_1, …, rep ū_m, φ}`. -/
def polyResidueSection (hφ0 : φ ≠ 0) {e : ℕ} (hφd : φ.natDegree = e + 1) :
    MilnorKRing (Polynomial k ⧸ Ideal.span {φ}) →+ ↥(uniformizerMulQuotient hφ0 e) where
  toFun α := polySectionRingMap hφm hφ1 hφ0 hφd α (uniformizerClass hφ0 e)
  map_zero' := by rw [map_zero]; rfl
  map_add' α β := by rw [map_add]; rfl

/-- `Stacks.Chow.polyResidueSection α` is `Stacks.Chow.polySectionRingMap α` applied to `[{φ}]`. -/
theorem polyResidueSection_apply (hφ0 : φ ≠ 0) {e : ℕ} (hφd : φ.natDegree = e + 1)
    (α : MilnorKRing (Polynomial k ⧸ Ideal.span {φ})) :
    polyResidueSection hφm hφ1 hφ0 hφd α =
      polySectionRingMap hφm hφ1 hφ0 hφd α (uniformizerClass hφ0 e) := rfl

/-- **`s_φ {ū_1, …, ū_m}` is the class of `{rep ū_1, …, rep ū_m, φ}`.** -/
theorem polyResidueSection_milnorKSymbolProd (hφ0 : φ ≠ 0) {e : ℕ}
    (hφd : φ.natDegree = e + 1) (l : List (Polynomial k ⧸ Ideal.span {φ})ˣ) :
    (polyResidueSection hφm hφ1 hφ0 hφd
          (milnorKSymbolProd (Polynomial k ⧸ Ideal.span {φ}) l) :
        milnorKPolyQuotient k e) =
      milnorKPolyQuotientMk k e (milnorKSymbolProd (RatFunc k)
        (l.map fun u ↦ polyUnit (polyRep_ne_zero hφm hφ1 u)) *
          milnorKSymbol (RatFunc k) (polyUnit hφ0)) := by
  induction l with
  | nil =>
      rw [milnorKSymbolProd_nil, polyResidueSection_apply, map_one, List.map_nil,
        milnorKSymbolProd_nil, one_mul]
      rfl
  | cons u l ih =>
      rw [milnorKSymbolProd_cons, polyResidueSection_apply, map_mul,
        polySectionRingMap_milnorKSymbol, uniformizerMulLeftHom_apply, Module.End.mul_apply,
        uniformizerMulLeft_coe]
      rw [show (polySectionRingMap hφm hφ1 hφ0 hφd
            (milnorKSymbolProd (Polynomial k ⧸ Ideal.span {φ}) l) (uniformizerClass hφ0 e) :
          ↥(uniformizerMulQuotient hφ0 e)) =
          polyResidueSection hφm hφ1 hφ0 hφd
            (milnorKSymbolProd (Polynomial k ⧸ Ideal.span {φ}) l) from rfl, ih,
        milnorKQuotientMulLeft_mk, polyRepDegreeOne_coe, List.map_cons, milnorKSymbolProd_cons,
        mul_assoc]

end Stacks.Chow

end
