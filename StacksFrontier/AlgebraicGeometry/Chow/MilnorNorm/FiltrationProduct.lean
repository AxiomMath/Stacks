module

public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.DegreeFiltration

/-!
# Each step of the degree filtration is a subring

Let `k` be a field. The step `L_d` of the degree filtration of
`StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.DegreeFiltration` is the subgroup of
`K^M_*(RatFunc k)` generated by the symbols of nonzero polynomials of degree at most `d`. This
file records that it contains `1` and is closed under multiplication, and more precisely that

`L_d · L_e ⊆ L_{max d e}`

(`Stacks.Chow.mul_mem_milnorKPolyFiltration`). The reason is the one-sided statement already
available, `Stacks.Chow.milnorKSymbol_mul_mem_milnorKPolyFiltration`: multiplying by a single
low-degree symbol respects the filtration, and a generator of `L_d` is a product of such symbols.

This is what makes `L_e` act on the quotient `K^M_*(RatFunc k) / L_e` used to build the inverse
of the residue map on `L_d / L_{d-1}`: the action of a low-degree symbol on that quotient is
well defined exactly because `L_e` is stable under multiplication by one.

## Main results

* `Stacks.Chow.one_mem_milnorKPolyFiltration` — `1 ∈ L_d`, the empty symbol.
* `Stacks.Chow.milnorKSymbolProd_mul_mem_milnorKPolyFiltration` — a generator of `L_d` times an
  element of `L_e`.
* `Stacks.Chow.mul_mem_milnorKPolyFiltration` — **`L_d · L_e ⊆ L_{max d e}`.**
* `Stacks.Chow.mul_mem_milnorKPolyFiltration_self` — in particular `L_d` is closed under
  multiplication.

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
-/

@[expose] public noncomputable section

open Polynomial

universe u

namespace Stacks.Chow

variable {k : Type u} [Field k]

/-- **`1 ∈ L_d`**: the unit of the Milnor K-ring is the symbol of the empty list. -/
theorem one_mem_milnorKPolyFiltration (d : ℕ) :
    (1 : MilnorKRing (RatFunc k)) ∈ milnorKPolyFiltration k d := by
  rw [← milnorKSymbolProd_nil (k := RatFunc k)]
  exact milnorKSymbolProd_mem_milnorKPolyFiltration (by simp)

/-- A generator of `L_d` times an element of `L_e` lies in `L_{max d e}`: peel off the entries of
the generator one at a time, each costing one application of
`Stacks.Chow.milnorKSymbol_mul_mem_milnorKPolyFiltration`. -/
theorem milnorKSymbolProd_mul_mem_milnorKPolyFiltration {d e : ℕ} (l : List (RatFunc k)ˣ)
    (hl : ∀ u ∈ l, u ∈ polyUnitsOfDegreeLE k d) {y : MilnorKRing (RatFunc k)}
    (hy : y ∈ milnorKPolyFiltration k e) :
    milnorKSymbolProd (RatFunc k) l * y ∈ milnorKPolyFiltration k (max d e) := by
  induction l with
  | nil =>
      rw [milnorKSymbolProd_nil, one_mul]
      exact milnorKPolyFiltration_mono (le_max_right d e) hy
  | cons u l ih =>
      rw [milnorKSymbolProd_cons, mul_assoc]
      have hrest := ih fun v hv ↦ hl v (List.mem_cons_of_mem u hv)
      have hmul := milnorKSymbol_mul_mem_milnorKPolyFiltration (e := d)
        (hl u List.mem_cons_self) hrest
      rwa [show max d (max d e) = max d e from by omega] at hmul

/-- **The steps of the degree filtration multiply: `L_d · L_e ⊆ L_{max d e}`.** -/
theorem mul_mem_milnorKPolyFiltration {d e : ℕ} {x y : MilnorKRing (RatFunc k)}
    (hx : x ∈ milnorKPolyFiltration k d) (hy : y ∈ milnorKPolyFiltration k e) :
    x * y ∈ milnorKPolyFiltration k (max d e) :=
  milnorKPolyFiltration_le (H := AddSubgroup.comap (AddMonoidHom.mulRight y)
    (milnorKPolyFiltration k (max d e)))
    (fun l hl ↦ milnorKSymbolProd_mul_mem_milnorKPolyFiltration l hl hy) hx

/-- **Each step of the degree filtration is closed under multiplication.** -/
theorem mul_mem_milnorKPolyFiltration_self {d : ℕ} {x y : MilnorKRing (RatFunc k)}
    (hx : x ∈ milnorKPolyFiltration k d) (hy : y ∈ milnorKPolyFiltration k d) :
    x * y ∈ milnorKPolyFiltration k d := by
  have h := mul_mem_milnorKPolyFiltration hx hy
  rwa [max_self] at h

end Stacks.Chow

end
