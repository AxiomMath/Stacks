module

public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.PolyResidueRing

/-!
# The residues of degree `d` detect `L_d` modulo `L_{d-1}`

Let `k` be a field and `d = e + 1 ≥ 1`. This file proves the inductive heart of Milnor's exact
sequence for the rational function field:

**if `x ∈ L_{e+1}` and `∂_ψ x = 0` for every monic irreducible `ψ` of degree `e + 1`, then
`x ∈ L_e`** (`Stacks.Chow.mem_milnorKPolyFiltration_of_forall_monicIrreducibleResidue_eq_zero`).

Equivalently, the family of residues of degree `e + 1` is injective on `L_{e+1} / L_e`. Together
with `Stacks.Chow.exists_mem_milnorKPolyFiltration_dvrMilnorTameSymbol_eq_of_monic`, which says
the same family is surjective, this identifies `L_{e+1} / L_e` with the sum of the
`K^M_{*-1}(k[X] ⧸ ψ)`.

## The argument

By `Stacks.Chow.milnorKPolyFiltration_le_milnorKOneTopFiltration`, `L_{e+1}` is generated by the
symbols whose entries are constants and monic irreducibles of degree at most `e + 1`, with **at
most one** entry of degree exactly `e + 1`. On such a generator `{l}` the family of residues is
diagonal:

* no entry of degree `e + 1`: then `{l} ∈ L_e`, so its class modulo `L_e` vanishes, and every
  `∂_ψ` kills it;
* one entry of degree `e + 1`, equal to `ψ`: then, after moving that entry to the end at the cost
  of a sign, `{l} = ±{g_1, …, g_m, ψ}` with the `g_i` of degree at most `e`, so `∂_χ {l} = 0` for
  every `χ ≠ ψ` of degree `e + 1`, while `∂_ψ {l}` is the symbol of the residues and
  `s_ψ (∂_ψ {l})` is the class of `{l}` itself — that is
  `Stacks.Chow.monicIrreducibleTerm_milnorKSymbolProd_mul_uniformizer`, which combines the
  residue computation of `Stacks.Chow.dvrMilnorTameSymbol_uniformizer` with
  `Stacks.Chow.polyResidueSection_milnorKSymbolProd` and the fact that the low-degree
  representative of the class of a polynomial of degree at most `e` is that polynomial.

So every generator `x` satisfies `[x] = Σ_ψ s_ψ (∂_ψ x)` with only one term, hence — the
condition being closed under sums, which is why it is phrased with a finite index set
(`Stacks.Chow.polyResidueDecomposition`) — so does every element of `L_{e+1}`. If all the
residues vanish, the right-hand side is zero.

## Main definitions

* `Stacks.Chow.monicIrreducibleTerm` — `s_ψ ∘ ∂_ψ`, valued in `K^M_*(RatFunc k) / L_e`.
* `Stacks.Chow.polyResidueDecomposition` — the subgroup of elements whose class modulo `L_e` is
  the finite sum of those terms.

## Main results

* `Stacks.Chow.milnorKOneTopFiltration_le` — the generation principle for the Bass–Tate subgroup.
* `Stacks.Chow.exists_perm_one_top` — the single entry of top degree can be moved to the end.
* `Stacks.Chow.monicIrreducibleTerm_milnorKSymbolProd_mul_uniformizer` — **`s_ψ (∂_ψ x) = [x]` on
  a generator naming `ψ`.**
* `Stacks.Chow.milnorKPolyFiltration_le_polyResidueDecomposition` — every element of `L_{e+1}`
  decomposes.
* `Stacks.Chow.mem_milnorKPolyFiltration_of_forall_monicIrreducibleResidue_eq_zero` — **the
  injectivity.**

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
-/

@[expose] public noncomputable section

open IsLocalRing Polynomial

universe u

namespace Stacks.Chow

attribute [local instance] Ideal.Quotient.field
  isDiscreteValuationRing_localizationAtPrime_polynomial

open MonicIrreducibleOfDegree

variable {k : Type u} [Field k]

/-! ### Generation by Bass–Tate generators -/

/-- A subgroup containing every symbol of constants and monic irreducibles of degree at most `d`
with at most one entry of degree exactly `d` contains the whole Bass–Tate subgroup. -/
theorem milnorKOneTopFiltration_le {d : ℕ} {H : AddSubgroup (MilnorKRing (RatFunc k))}
    (hH : ∀ l : List (RatFunc k)ˣ, (∀ u ∈ l, u ∈ polyFactorUnits k d) →
      topDegreeCount k d l ≤ 1 → milnorKSymbolProd (RatFunc k) l ∈ H) :
    milnorKOneTopFiltration k d ≤ H := by
  refine AddSubgroup.closure_le _ |>.mpr ?_
  rintro x ⟨l, hl, hcount, rfl⟩
  exact hH l hl hcount

/-- **A symbol with exactly one entry of degree `e + 1` can be rewritten with that entry last.**
-/
theorem exists_perm_one_top {e : ℕ} {l : List (RatFunc k)ˣ}
    (hl : ∀ u ∈ l, u ∈ polyFactorUnits k (e + 1))
    (h1 : topDegreeCount k (e + 1) l = 1) :
    ∃ (ψ : MonicIrreducibleOfDegree k (e + 1)) (rest : List (RatFunc k)ˣ),
      (∀ u ∈ rest, u ∈ polyUnitsOfDegreeLE k e) ∧
        l.Perm (rest ++ [polyUnit (ne_zero ψ)]) := by
  classical
  have hlen : (l.filter fun u ↦ decide (u ∈ topDegreeUnits k (e + 1))).length = 1 := by
    rw [← List.countP_eq_length_filter]
    exact h1
  obtain ⟨a, ha⟩ := List.length_eq_one_iff.mp hlen
  have hamem : a ∈ l.filter fun u ↦ decide (u ∈ topDegreeUnits k (e + 1)) := by
    rw [ha]; exact List.mem_cons_self
  obtain ⟨f, hf0, ⟨hfm, hfi, hfd⟩, rfl⟩ : a ∈ topDegreeUnits k (e + 1) := by
    simpa using (List.mem_filter.mp hamem).2
  refine ⟨⟨f, hfm, hfi, hfd⟩, l.filter fun u ↦ !decide (u ∈ topDegreeUnits k (e + 1)), ?_, ?_⟩
  · intro u hu
    exact mem_polyUnitsOfDegreeLE_of_notMem_topDegreeUnits
      (hl u (List.mem_of_mem_filter hu)) (by simpa using (List.mem_filter.mp hu).2)
  · refine ((List.filter_append_perm
      (fun u ↦ decide (u ∈ topDegreeUnits k (e + 1))) l).symm.trans ?_)
    rw [ha]
    exact List.perm_append_comm

/-! ### The residue term -/

/-- **`s_ψ ∘ ∂_ψ`, the `ψ`-term of the decomposition**, valued in `K^M_*(RatFunc k) / L_e`. -/
def monicIrreducibleTerm {e : ℕ} (ψ : MonicIrreducibleOfDegree k (e + 1)) :
    MilnorKRing (RatFunc k) →+ milnorKPolyQuotient k e :=
  ((uniformizerMulQuotient (ne_zero ψ) e).subtype).comp
    ((polyResidueSection (monic ψ) (ne_one ψ) (ne_zero ψ) (natDegree_eq ψ)).comp
      (monicIrreducibleResidue ψ))

/-- The `ψ`-term of `x` is the class of `s_ψ (∂_ψ x)` modulo `L_e`. -/
theorem monicIrreducibleTerm_apply {e : ℕ} (ψ : MonicIrreducibleOfDegree k (e + 1))
    (x : MilnorKRing (RatFunc k)) :
    monicIrreducibleTerm ψ x =
      (polyResidueSection (monic ψ) (ne_one ψ) (ne_zero ψ) (natDegree_eq ψ)
        (monicIrreducibleResidue ψ x) : milnorKPolyQuotient k e) :=
  rfl

/-- The `ψ`-term of `x` vanishes whenever the residue `∂_ψ x` vanishes. -/
theorem monicIrreducibleTerm_eq_zero_of_monicIrreducibleResidue_eq_zero {e : ℕ}
    (ψ : MonicIrreducibleOfDegree k (e + 1)) {x : MilnorKRing (RatFunc k)}
    (hx : monicIrreducibleResidue ψ x = 0) : monicIrreducibleTerm ψ x = 0 := by
  rw [monicIrreducibleTerm_apply, hx, map_zero]
  rfl

/-! ### The residue of a generator naming `ψ` -/

/-- **`s_ψ (∂_ψ x) = [x]` for `x = {g_1, …, g_m, ψ}` with the `g_i` of degree at most `e`.**

The `g_i` are units of the local ring at `ψ`, so `∂_ψ x` is the symbol of their residues
(`Stacks.Chow.dvrMilnorTameSymbol_uniformizer`); the low-degree representative of the class of
`g_i` is `g_i` itself, so `s_ψ` of that symbol is the class of `x`
(`Stacks.Chow.polyResidueSection_milnorKSymbolProd`). -/
theorem monicIrreducibleTerm_milnorKSymbolProd_mul_uniformizer {e : ℕ}
    (ψ : MonicIrreducibleOfDegree k (e + 1)) {l : List (RatFunc k)ˣ}
    (hl : ∀ u ∈ l, u ∈ polyUnitsOfDegreeLE k e) :
    monicIrreducibleTerm ψ (milnorKSymbolProd (RatFunc k) l *
        milnorKSymbol (RatFunc k) (polyUnit (ne_zero ψ))) =
      milnorKPolyQuotientMk k e (milnorKSymbolProd (RatFunc k) l *
        milnorKSymbol (RatFunc k) (polyUnit (ne_zero ψ))) := by
  have hdlt : e < (poly ψ).natDegree := by rw [natDegree_eq ψ]; omega
  obtain ⟨l', hl'⟩ := exists_unitList_localization (p := poly ψ) hdlt hl
  -- the symbol is a symbol of units of the local ring times the uniformizer
  have hsymb : milnorKSymbolProd (RatFunc k) l = unitSymbolProd (RatFunc k) l' := by
    rw [unitSymbolProd, hl']
  have huni : milnorKSymbol (RatFunc k) (polyUnit (ne_zero ψ)) =
      milnorKSymbol (RatFunc k) (dvrFracUniformizer (RatFunc k)
        (irreducible_algebraMap_self (p := poly ψ))) := by
    rw [dvrFracUniformizer_irreducible_algebraMap_self (ne_zero ψ)]
  set x := unitSymbolProd (RatFunc k) l' *
    milnorKSymbol (RatFunc k) (dvrFracUniformizer (RatFunc k)
      (irreducible_algebraMap_self (p := poly ψ))) with hxdef
  -- the residue of an entry, as a unit of the quotient `k[X] ⧸ (ψ)`
  set ρ : (Localization.AtPrime (Ideal.span {poly ψ}))ˣ → (Polynomial k ⧸ Ideal.span {poly ψ})ˣ :=
    fun w ↦ Units.map
      ((quotientRingEquivResidueField (Ideal.span {poly ψ})).symm :
        (Ideal.span {poly ψ}).ResidueField →* (Polynomial k ⧸ Ideal.span {poly ψ}))
      (Units.map (residue (Localization.AtPrime (Ideal.span {poly ψ}))).toMonoidHom w)
  -- the residue is the symbol of the residues of the entries
  have hres : monicIrreducibleResidue ψ x =
      milnorKSymbolProd (Polynomial k ⧸ Ideal.span {poly ψ}) (l'.map ρ) := by
    rw [hxdef]
    exact monicIrreducibleResidue_unitSymbolProd_mul_uniformizer ψ l'
  -- the low-degree representatives of those residues are the original entries
  have hrep : (l'.map ρ).map (fun u ↦ polyUnit (polyRep_ne_zero (monic ψ) (ne_one ψ) u)) = l := by
    rw [List.map_map, ← hl']
    refine List.map_congr_left fun w hw ↦ ?_
    simp only [Function.comp_apply]
    obtain ⟨f, hf0, hfd, hfu⟩ := hl _ (hl' ▸ List.mem_map.mpr ⟨w, hw, rfl⟩)
    have hwval : (w : Localization.AtPrime (Ideal.span {poly ψ})) =
        algebraMap (Polynomial k) (Localization.AtPrime (Ideal.span {poly ψ})) f := by
      refine IsFractionRing.injective (Localization.AtPrime (Ideal.span {poly ψ}))
        (RatFunc k) ?_
      rw [← IsScalarTower.algebraMap_apply]
      exact congrArg Units.val hfu.symm
    have hclass : ((ρ w : (Polynomial k ⧸ Ideal.span {poly ψ})ˣ) :
        Polynomial k ⧸ Ideal.span {poly ψ}) = Ideal.Quotient.mk (Ideal.span {poly ψ}) f := by
      change (quotientRingEquivResidueField (Ideal.span {poly ψ})).symm
        (residue (Localization.AtPrime (Ideal.span {poly ψ}))
          (w : Localization.AtPrime (Ideal.span {poly ψ}))) = _
      rw [hwval, residue_algebraMap_eq_quotientRingEquivResidueField,
        RingEquiv.symm_apply_apply]
    have hpolyRep : polyRep (monic ψ) (ne_one ψ) (ρ w) = f :=
      polyRep_eq_of_mk_eq (monic ψ) (ne_one ψ) (lt_of_le_of_lt hfd hdlt) hclass.symm
    refine Eq.trans (Units.ext ?_) hfu
    rw [coe_polyUnit, coe_polyUnit, hpolyRep]
  rw [hsymb, huni, ← hxdef, monicIrreducibleTerm_apply, hres,
    polyResidueSection_milnorKSymbolProd, hrep, hxdef, hsymb.symm, huni.symm]

/-! ### The decomposition -/

open Classical in
/-- **The subgroup of elements whose class modulo `L_e` is the sum of the terms `s_ψ ∘ ∂_ψ`.**
The index set is finite and carried in the statement, which is what makes the condition closed
under addition: a term whose residue already vanishes contributes nothing, so two decompositions
can be merged over the union of their index sets. -/
def polyResidueDecomposition (k : Type u) [Field k] (e : ℕ) :
    AddSubgroup (MilnorKRing (RatFunc k)) where
  carrier := {x | ∃ S : Finset (MonicIrreducibleOfDegree k (e + 1)),
    (∀ ψ ∉ S, monicIrreducibleTerm ψ x = 0) ∧
      milnorKPolyQuotientMk k e x = ∑ ψ ∈ S, monicIrreducibleTerm ψ x}
  zero_mem' := ⟨∅, fun ψ _ ↦ map_zero _, by rw [map_zero, Finset.sum_empty]⟩
  add_mem' := by
    classical
    rintro x y ⟨S, hS, hxS⟩ ⟨T, hT, hyT⟩
    refine ⟨S ∪ T, fun ψ hψ ↦ ?_, ?_⟩
    · rw [map_add, hS ψ fun h ↦ hψ (Finset.mem_union_left T h),
        hT ψ fun h ↦ hψ (Finset.mem_union_right S h), add_zero]
    · have hxsum : ∑ ψ ∈ S ∪ T, monicIrreducibleTerm ψ x = ∑ ψ ∈ S, monicIrreducibleTerm ψ x :=
        (Finset.sum_subset Finset.subset_union_left fun ψ _ hψ ↦ hS ψ hψ).symm
      have hysum : ∑ ψ ∈ S ∪ T, monicIrreducibleTerm ψ y = ∑ ψ ∈ T, monicIrreducibleTerm ψ y :=
        (Finset.sum_subset Finset.subset_union_right fun ψ _ hψ ↦ hT ψ hψ).symm
      rw [map_add, hxS, hyT, ← hxsum, ← hysum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun ψ _ ↦ (map_add _ x y).symm
  neg_mem' := by
    rintro x ⟨S, hS, hxS⟩
    refine ⟨S, fun ψ hψ ↦ ?_, ?_⟩
    · rw [map_neg, hS ψ hψ, neg_zero]
    · rw [map_neg, hxS, ← Finset.sum_neg_distrib]
      exact Finset.sum_congr rfl fun ψ _ ↦ (map_neg _ x).symm

/-- Every element of `L_e` lies in `polyResidueDecomposition k e`, with the empty index set. -/
theorem mem_polyResidueDecomposition_of_mem_milnorKPolyFiltration {e : ℕ}
    {x : MilnorKRing (RatFunc k)} (hx : x ∈ milnorKPolyFiltration k e) :
    x ∈ polyResidueDecomposition k e :=
  ⟨∅, fun ψ _ ↦ monicIrreducibleTerm_eq_zero_of_monicIrreducibleResidue_eq_zero ψ
      (monicIrreducibleResidue_eq_zero_of_mem_milnorKPolyFiltration ψ hx),
    by rw [Finset.sum_empty, (milnorKPolyQuotientMk_eq_zero_iff x).mpr hx]⟩

/-- **Every element of `L_{e+1}` decomposes as the sum of the terms `s_ψ (∂_ψ ·)`.** -/
theorem milnorKPolyFiltration_le_polyResidueDecomposition (e : ℕ) :
    milnorKPolyFiltration k (e + 1) ≤ polyResidueDecomposition k e := by
  classical
  refine (milnorKPolyFiltration_le_milnorKOneTopFiltration (d := e + 1)
    (Nat.succ_pos e)).trans (milnorKOneTopFiltration_le fun l hl hcount ↦ ?_)
  rcases Nat.lt_or_ge (topDegreeCount k (e + 1) l) 1 with hzero | hone
  · -- no entry of degree `e + 1`: the symbol already lies in `L_e`
    refine mem_polyResidueDecomposition_of_mem_milnorKPolyFiltration
      (milnorKSymbolProd_mem_milnorKPolyFiltration fun u hu ↦ ?_)
    refine mem_polyUnitsOfDegreeLE_of_notMem_topDegreeUnits (hl u hu) ?_
    have hc : topDegreeCount k (e + 1) l = 0 := by omega
    simpa using (List.countP_eq_zero.mp hc) u hu
  · -- exactly one entry of degree `e + 1`
    have hcount1 : topDegreeCount k (e + 1) l = 1 := le_antisymm hcount hone
    obtain ⟨ψ, rest, hrest, hperm⟩ := exists_perm_one_top hl hcount1
    refine milnorKSymbolProd_mem_of_perm hperm ?_
    rw [milnorKSymbolProd_append, milnorKSymbolProd_singleton]
    refine ⟨{ψ}, fun χ hχ ↦ ?_, ?_⟩
    · -- the other closed points of degree `e + 1` see nothing: no entry is divisible by `χ`
      refine monicIrreducibleTerm_eq_zero_of_monicIrreducibleResidue_eq_zero χ ?_
      rw [← milnorKSymbolProd_singleton (polyUnit (ne_zero ψ)), ← milnorKSymbolProd_append]
      refine monicIrreducibleResidue_eq_zero_of_mem_milnorKNotDvdFiltration χ
        (milnorKSymbolProd_mem_milnorKNotDvdFiltration fun u hu ↦ ?_)
      rcases List.mem_append.mp hu with hu' | hu'
      · obtain ⟨f, hf0, hfd, rfl⟩ := hrest u hu'
        refine ⟨f, hf0, fun hdvd ↦ ?_, rfl⟩
        have hle := Polynomial.natDegree_le_of_dvd hdvd hf0
        have hdeg := natDegree_eq χ
        omega
      · rw [List.mem_singleton.mp hu']
        refine ⟨poly ψ, ne_zero ψ, fun hdvd ↦ ?_, rfl⟩
        exact hχ (Finset.mem_singleton.mpr (poly_injective
          (Polynomial.eq_of_monic_of_associated (monic χ) (monic ψ)
            ((irreducible χ).associated_of_dvd (irreducible ψ) hdvd))))
    · rw [Finset.sum_singleton]
      exact (monicIrreducibleTerm_milnorKSymbolProd_mul_uniformizer ψ hrest).symm

/-! ### The injectivity -/

/-- **Stacks 0EAY, the inductive step of Milnor's exact sequence: the residues of degree `e + 1`
are injective on `L_{e+1} / L_e`.** -/
theorem mem_milnorKPolyFiltration_of_forall_monicIrreducibleResidue_eq_zero {e : ℕ}
    {x : MilnorKRing (RatFunc k)} (hx : x ∈ milnorKPolyFiltration k (e + 1))
    (hres : ∀ ψ : MonicIrreducibleOfDegree k (e + 1), monicIrreducibleResidue ψ x = 0) :
    x ∈ milnorKPolyFiltration k e := by
  obtain ⟨S, -, hsum⟩ := milnorKPolyFiltration_le_polyResidueDecomposition e hx
  refine (milnorKPolyQuotientMk_eq_zero_iff x).mp ?_
  rw [hsum, Finset.sum_congr rfl fun ψ _ ↦
    monicIrreducibleTerm_eq_zero_of_monicIrreducibleResidue_eq_zero ψ (hres ψ)]
  exact Finset.sum_const_zero

end Stacks.Chow

end
