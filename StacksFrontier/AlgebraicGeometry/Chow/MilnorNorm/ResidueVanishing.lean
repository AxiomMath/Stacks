module

public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.TopDegreeReduction

/-!
# The residue at a closed point kills everything away from that point

Let `k` be a field and `p ∈ k[X]` generating a maximal ideal. A nonzero polynomial not divisible
by `p` is a unit of the local ring of `A¹_k` at `p`, so the tame symbol there kills any symbol
all of whose entries are such polynomials
(`Stacks.Chow.shift_dvrMilnorShiftMap_eq_zero_of_mem_milnorKNotDvdFiltration`). This file proves
that, and draws the consequence Milnor's lemma needs:

**for `φ` monic irreducible of degree `d`, the residue `∂_φ` kills every generator of
`L_d` in which `φ` does not occur** (`Stacks.Chow.dvrMilnorTameSymbol_eq_zero_of_forall_ne`).

Every entry of such a generator is a nonzero constant, or a monic irreducible of degree below
`d`, or a monic irreducible of degree `d` different from `φ`; `p = φ` divides none of these — the
first two for degree reasons, the third because distinct monic irreducibles are not associates.

Together with
`StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.ResidueOnGenerators`, which says `∂_φ` carries the
generators in which `φ` *does* occur onto all of `K^M_*(k[X] ⧸ φ)`, this is the diagonal
structure of the family of residues on `L_d`: at a closed point of degree `d`, only the
generators naming that point contribute.

## Main definitions

* `Stacks.Chow.polyUnitsNotDvd` — the units of `RatFunc k` which are nonzero polynomials not
  divisible by `p`.
* `Stacks.Chow.milnorKNotDvdFiltration` — the subgroup their symbols generate.

## Main results

* `Stacks.Chow.exists_unit_localization_of_mem_polyUnitsNotDvd` — such a polynomial is a unit of
  the local ring at `p`.
* `Stacks.Chow.shift_dvrMilnorShiftMap_eq_zero_of_mem_milnorKNotDvdFiltration` — the ring-level
  vanishing.
* `Stacks.Chow.notDvd_of_mem_polyFactorUnits_of_ne` — `φ` divides no entry of a generator of
  `L_d` other than `φ` itself.
* `Stacks.Chow.dvrMilnorTameSymbol_eq_zero_of_forall_ne` — **`∂_φ` kills a symbol in which `φ`
  does not occur.**

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
-/

@[expose] public noncomputable section

open IsLocalRing IsDiscreteValuationRing Polynomial

universe u

namespace Stacks.Chow

/- The local ring of `A¹_k` at a closed point is a discrete valuation ring. In `Mathlib` style
this is a definition rather than a global instance, and the statements below name the tame symbol
of that ring, so it is needed here as an instance. -/
attribute [local instance] isDiscreteValuationRing_localizationAtPrime_polynomial

variable {k : Type u} [Field k]

/-! ### Polynomials not divisible by `p` -/

/-- The units of `RatFunc k` which are nonzero polynomials not divisible by `p`. -/
def polyUnitsNotDvd (k : Type u) [Field k] (p : Polynomial k) : Set (RatFunc k)ˣ :=
  {u | ∃ f : Polynomial k, ∃ hf : f ≠ 0, ¬p ∣ f ∧ polyUnit hf = u}

/-- **A polynomial not divisible by `p` is a unit of the local ring at `p`**, and comes from one
in `RatFunc k`. -/
theorem exists_unit_localization_of_mem_polyUnitsNotDvd {p : Polynomial k}
    [(Ideal.span {p}).IsPrime] {u : (RatFunc k)ˣ} (hu : u ∈ polyUnitsNotDvd k p) :
    ∃ w : (Localization.AtPrime (Ideal.span {p}))ˣ,
      Units.map (algebraMap (Localization.AtPrime (Ideal.span {p})) (RatFunc k) :
        Localization.AtPrime (Ideal.span {p}) →* RatFunc k) w = u := by
  obtain ⟨f, hf, hnd, rfl⟩ := hu
  obtain ⟨w, hw⟩ := IsLocalization.map_units (M := (Ideal.span {p}).primeCompl)
    (Localization.AtPrime (Ideal.span {p}))
    ⟨f, Ideal.mem_primeCompl_iff.mpr fun hmem ↦ hnd (Ideal.mem_span_singleton.mp hmem)⟩
  refine ⟨w, Units.ext ?_⟩
  change algebraMap (Localization.AtPrime (Ideal.span {p})) (RatFunc k) (w : _) =
    algebraMap (Polynomial k) (RatFunc k) f
  rw [hw, ← IsScalarTower.algebraMap_apply]

/-- A list of such units comes from a list of units of the local ring at `p`. -/
theorem exists_unitList_localization_notDvd {p : Polynomial k} [(Ideal.span {p}).IsPrime]
    {l : List (RatFunc k)ˣ} (hl : ∀ u ∈ l, u ∈ polyUnitsNotDvd k p) :
    ∃ l' : List (Localization.AtPrime (Ideal.span {p}))ˣ,
      l'.map (Units.map (algebraMap (Localization.AtPrime (Ideal.span {p})) (RatFunc k) :
        Localization.AtPrime (Ideal.span {p}) →* RatFunc k)) = l := by
  induction l with
  | nil => exact ⟨[], rfl⟩
  | cons u l ih =>
      obtain ⟨w, hw⟩ := exists_unit_localization_of_mem_polyUnitsNotDvd (hl u List.mem_cons_self)
      obtain ⟨l', hl'⟩ := ih fun v hv ↦ hl v (List.mem_cons_of_mem u hv)
      exact ⟨w :: l', by rw [List.map_cons, hw, hl']⟩

/-! ### The subgroup generated away from `p` -/

/-- **The subgroup of `K^M_*(RatFunc k)` generated by the symbols of nonzero polynomials not
divisible by `p`.** -/
def milnorKNotDvdFiltration (k : Type u) [Field k] (p : Polynomial k) :
    AddSubgroup (MilnorKRing (RatFunc k)) :=
  AddSubgroup.closure {x | ∃ l : List (RatFunc k)ˣ,
    (∀ u ∈ l, u ∈ polyUnitsNotDvd k p) ∧ milnorKSymbolProd (RatFunc k) l = x}

/-- The product of the symbols of a list of nonzero polynomials not divisible by `p` lies in
`milnorKNotDvdFiltration k p`. -/
theorem milnorKSymbolProd_mem_milnorKNotDvdFiltration {p : Polynomial k}
    {l : List (RatFunc k)ˣ} (hl : ∀ u ∈ l, u ∈ polyUnitsNotDvd k p) :
    milnorKSymbolProd (RatFunc k) l ∈ milnorKNotDvdFiltration k p :=
  AddSubgroup.subset_closure ⟨l, hl, rfl⟩

/-- `milnorKNotDvdFiltration k p` is contained in any additive subgroup containing the products
of symbols of all lists of nonzero polynomials not divisible by `p`. -/
theorem milnorKNotDvdFiltration_le {p : Polynomial k}
    {H : AddSubgroup (MilnorKRing (RatFunc k))}
    (hH : ∀ l : List (RatFunc k)ˣ, (∀ u ∈ l, u ∈ polyUnitsNotDvd k p) →
      milnorKSymbolProd (RatFunc k) l ∈ H) :
    milnorKNotDvdFiltration k p ≤ H := by
  refine AddSubgroup.closure_le _ |>.mpr ?_
  rintro x ⟨l, hl, rfl⟩
  exact hH l hl

/-- **The ring-level vanishing: the tame symbol at `p` kills everything generated away from
`p`.** -/
theorem shift_dvrMilnorShiftMap_eq_zero_of_mem_milnorKNotDvdFiltration {p : Polynomial k}
    [(Ideal.span {p}).IsPrime]
    [IsDiscreteValuationRing (Localization.AtPrime (Ideal.span {p}))]
    {ϖ : Localization.AtPrime (Ideal.span {p})} (hϖ : Irreducible ϖ)
    {x : MilnorKRing (RatFunc k)} (hx : x ∈ milnorKNotDvdFiltration k p) :
    MilnorKShift.shift (dvrMilnorShiftMap (F := RatFunc k) hϖ x) = 0 := by
  refine milnorKNotDvdFiltration_le (H := AddMonoidHom.ker
    ((MilnorKShift.shiftHom (ResidueField (Localization.AtPrime (Ideal.span {p})))).comp
      (dvrMilnorShiftMap (F := RatFunc k) hϖ).toAddMonoidHom)) ?_ hx
  intro l hl
  obtain ⟨l', rfl⟩ := exists_unitList_localization_notDvd hl
  rw [AddMonoidHom.mem_ker]
  change MilnorKShift.shift (dvrMilnorShiftMap (F := RatFunc k) hϖ
    (unitSymbolProd (RatFunc k) l')) = 0
  rw [dvrMilnorShiftMap_unitSymbolProd, MilnorKShift.shift_mk]

/-! ### The entries of a generator of `L_d` other than `φ` -/

/-- **A monic irreducible `φ` of degree `d` divides no entry of a generator of `L_d` other than
`φ` itself.** An entry is a nonzero constant, or a monic irreducible of degree at most `d`; in
the first two cases its degree is below `deg φ`, and in the last two a division would make the
entry an associate of `φ`, hence equal to it, both being monic. -/
theorem notDvd_of_mem_polyFactorUnits_of_ne {φ : Polynomial k} (hφm : φ.Monic)
    (hφi : Irreducible φ) (hφ0 : φ ≠ 0) {d : ℕ} (hφd : φ.natDegree = d) {u : (RatFunc k)ˣ}
    (hu : u ∈ polyFactorUnits k d) (hne : u ≠ polyUnit hφ0) : u ∈ polyUnitsNotDvd k φ := by
  obtain ⟨f, hf, hcase, rfl⟩ := hu
  refine ⟨f, hf, fun hdvd ↦ ?_, rfl⟩
  have hdle : φ.natDegree ≤ f.natDegree := Polynomial.natDegree_le_of_dvd hdvd hf
  have hφpos : 0 < φ.natDegree := by
    refine Nat.pos_of_ne_zero fun h ↦ hφi.not_isUnit ?_
    have hc : φ.coeff 0 ≠ 0 := fun hc ↦
      hφ0 (by rw [eq_C_of_natDegree_eq_zero h, hc, map_zero])
    rw [eq_C_of_natDegree_eq_zero h]
    exact isUnit_C.mpr (IsUnit.mk0 _ hc)
  rcases hcase with h0 | ⟨hfm, hfi, -⟩
  · omega
  · have hfe : f = φ :=
      Polynomial.eq_of_monic_of_associated hfm hφm (hφi.associated_of_dvd hfi hdvd).symm
    exact hne (Units.ext (by rw [coe_polyUnit, coe_polyUnit, hfe]))

/-- **`∂_φ` kills a symbol of `L_d` in which `φ` does not occur.** -/
theorem dvrMilnorTameSymbol_eq_zero_of_forall_ne {φ : Polynomial k} (hφm : φ.Monic)
    (hφi : Irreducible φ) (hφ0 : φ ≠ 0) [(Ideal.span {φ}).IsMaximal] {d : ℕ}
    (hφd : φ.natDegree = d)
    {ϖ : Localization.AtPrime (Ideal.span {φ})} (hϖ : Irreducible ϖ) (i : ℕ)
    {y : MilnorKTheory (RatFunc k) (i + 1)} {l : List (RatFunc k)ˣ}
    (hl : ∀ u ∈ l, u ∈ polyFactorUnits k d) (hne : ∀ u ∈ l, u ≠ polyUnit hφ0)
    (hy : (y : MilnorKRing (RatFunc k)) = milnorKSymbolProd (RatFunc k) l) :
    dvrMilnorTameSymbol (F := RatFunc k) hϖ i y = 0 := by
  refine Subtype.ext ?_
  rw [dvrMilnorTameSymbol_coe, hy]
  exact shift_dvrMilnorShiftMap_eq_zero_of_mem_milnorKNotDvdFiltration hϖ
    (milnorKSymbolProd_mem_milnorKNotDvdFiltration fun u hu ↦
      notDvd_of_mem_polyFactorUnits_of_ne hφm hφi hφ0 hφd (hl u hu) (hne u hu))

end Stacks.Chow

end
