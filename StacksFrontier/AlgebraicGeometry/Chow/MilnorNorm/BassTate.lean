module

public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.DegreeFiltration

/-!
# Bass–Tate: the Milnor K-theory of a simple extension, and the identity that lowers degrees

Let `k` be a field and `p ∈ k[X]` monic irreducible of degree `d`, so that `k[X] ⧸ p` is the
simple extension `k(θ)` with `θ` the class of `X`. The Bass–Tate lemma describes `K^M_n(k(θ))` by
generators coming from `k[X]`. This file proves the two ingredients that do not need the
double induction of the full lemma:

**Representation.** Every nonzero class of `k[X] ⧸ p` is the class of a *nonzero polynomial of
degree below `d`* — division with remainder by the monic `p` — and therefore `K^M_n(k(θ))` is
generated by the symbols `{f_1(θ), …, f_r(θ)}` of such polynomials
(`Stacks.Chow.milnorKGrading_quotient_le_of_forall_lowDegree_symbolProd`).

**The degree-lowering identity.** For units `φ, f, ψ` of any field with `φ + f = ψ`,

`{φ} {ψ} = {φ} {f} - {ψ} {f} - {ψ} {-1}`.

This is the Steinberg relation at `φ/ψ`, whose complement to one is `f/ψ`. It is the engine of
the Bass–Tate reduction: if `φ` and `ψ` are *monic of the same degree*, then `f = ψ - φ` has
strictly smaller degree, so the right-hand side trades a symbol in which two entries have equal
degree for symbols in which one entry has dropped.

## Main definitions

* `Stacks.Chow.quotUnitsOfLowDegree` — the units of `k[X] ⧸ p` that are classes of nonzero
  polynomials of degree below `deg p`.

## Main results

* `Stacks.Chow.exists_natDegree_lt_of_quotient_ne_zero` — division with remainder: a nonzero
  class has a nonzero representative of degree below `deg p`.
* `Stacks.Chow.quotUnitsOfLowDegree_eq_univ` — **every** unit of `k[X] ⧸ p` is such a class.
* `Stacks.Chow.milnorKGrading_quotient_le_of_forall_lowDegree_symbolProd` — **the Bass–Tate
  generation statement in its degree form.**
* `Stacks.Chow.milnorKSymbol_mul_of_add_eq`, `Stacks.Chow.milnorKSymbol_mul_of_add_eq'` — **the
  degree-lowering identity.**

## Implementation notes

The generation statement is phrased, like
`milnorKGrading_le_of_forall_milnorKSymbolProd_mem`, as a statement about an additive subgroup
rather than as a span: that is the form in which it is used, and it avoids having to name the
subgroup generated by a set of symbols.

What is *not* proved here is the refinement of Bass–Tate which makes the degrees of the
generators strictly increasing. That refinement is what the injectivity half of Milnor's exact
sequence needs, and it is a double induction — on `deg p` and on the number of non-strict
inequalities — whose single step is `Stacks.Chow.milnorKSymbol_mul_of_add_eq'` above. Nothing in
this file asserts it.

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
-/

@[expose] public noncomputable section

open IsLocalRing Polynomial

universe u

namespace Stacks.Chow

variable {k : Type u} [Field k]

/-! ### The degree-lowering identity -/

/-- **The identity driving the Bass–Tate reduction of degrees.** For units `φ, f, ψ` of a field
with `φ + f = ψ`,

`{φ} {ψ} = {φ} {f} - {ψ} {f} + {ψ} {ψ}`.

It is the Steinberg relation at `φ/ψ`, whose complement to one is `f/ψ`: expanding
`({φ} - {ψ}) ({f} - {ψ}) = 0` gives the identity. -/
theorem milnorKSymbol_mul_of_add_eq {φ f ψ : kˣ} (h : (φ : k) + (f : k) = (ψ : k)) :
    milnorKSymbol k φ * milnorKSymbol k ψ =
      milnorKSymbol k φ * milnorKSymbol k f - milnorKSymbol k ψ * milnorKSymbol k f +
        milnorKSymbol k ψ * milnorKSymbol k ψ := by
  have hψ : (ψ : k) ≠ 0 := ψ.ne_zero
  have hst : milnorKSymbol k (φ / ψ) * milnorKSymbol k (f / ψ) = 0 := by
    refine milnorKSymbol_mul_steinberg ?_
    rw [Units.val_div_eq_div_val, Units.val_div_eq_div_val, ← add_div, h, div_self hψ]
  rw [milnorKSymbol_div, milnorKSymbol_div] at hst
  have expand : milnorKSymbol k φ * milnorKSymbol k ψ =
      milnorKSymbol k φ * milnorKSymbol k f - milnorKSymbol k ψ * milnorKSymbol k f +
        milnorKSymbol k ψ * milnorKSymbol k ψ -
      (milnorKSymbol k φ - milnorKSymbol k ψ) * (milnorKSymbol k f - milnorKSymbol k ψ) := by
    noncomm_ring
  rw [expand, hst, sub_zero]

/-- The degree-lowering identity in the form the source writes it, with `{ψ} {ψ}` replaced by
`-{ψ} {-1}`:

`{φ} {ψ} = {φ} {f} - {ψ} {f} - {ψ} {-1}`. -/
theorem milnorKSymbol_mul_of_add_eq' {φ f ψ : kˣ} (h : (φ : k) + (f : k) = (ψ : k)) :
    milnorKSymbol k φ * milnorKSymbol k ψ =
      milnorKSymbol k φ * milnorKSymbol k f - milnorKSymbol k ψ * milnorKSymbol k f -
        milnorKSymbol k ψ * milnorKNegOne k := by
  rw [milnorKSymbol_mul_of_add_eq h,
    eq_neg_of_add_eq_zero_left (milnorKSymbol_mul_self_add_mul_negOne (k := k) ψ),
    ← sub_eq_add_neg]

/-! ### Division with remainder in a simple extension -/

/- The quotient of `k[X]` by a maximal ideal is a field, and the Milnor K-theory of that field is
what the generation statement below is about. In `Mathlib` this is a definition rather than a
global instance. -/
attribute [local instance] Ideal.Quotient.field

/-- **Every nonzero class of `k[X] ⧸ p` is the class of a nonzero polynomial of degree below
`deg p`.** Division with remainder by the monic polynomial `p`. -/
theorem exists_natDegree_lt_of_quotient_ne_zero {p : Polynomial k} (hp : p.Monic) (hp1 : p ≠ 1)
    {a : Polynomial k ⧸ Ideal.span {p}} (ha : a ≠ 0) :
    ∃ f : Polynomial k, f ≠ 0 ∧ f.natDegree < p.natDegree ∧
      Ideal.Quotient.mk (Ideal.span {p}) f = a := by
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective a
  have hmk : Ideal.Quotient.mk (Ideal.span {p}) (g %ₘ p) =
      Ideal.Quotient.mk (Ideal.span {p}) g := by
    rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem,
      show g %ₘ p - g = -(p * (g /ₘ p)) by
        rw [Polynomial.modByMonic_eq_sub_mul_div g p]; ring,
      neg_mem_iff]
    exact Ideal.mem_span_singleton.mpr ⟨g /ₘ p, rfl⟩
  exact ⟨g %ₘ p, fun hzero ↦ ha (by rw [← hmk, hzero, map_zero]),
    Polynomial.natDegree_modByMonic_lt g hp hp1, hmk⟩

/-- The units of `k[X] ⧸ p` which are classes of nonzero polynomials of degree below `deg p`. -/
def quotUnitsOfLowDegree (p : Polynomial k) : Set (Polynomial k ⧸ Ideal.span {p})ˣ :=
  {u | ∃ f : Polynomial k, f ≠ 0 ∧ f.natDegree < p.natDegree ∧
    Ideal.Quotient.mk (Ideal.span {p}) f = (u : Polynomial k ⧸ Ideal.span {p})}

/-- **Every unit of `k[X] ⧸ p` is the class of a nonzero polynomial of degree below `deg p`.**
This is the representation statement Bass–Tate starts from. -/
theorem quotUnitsOfLowDegree_eq_univ {p : Polynomial k} (hp : p.Monic) (hp1 : p ≠ 1)
    [(Ideal.span {p}).IsMaximal] :
    quotUnitsOfLowDegree p = (Set.univ : Set (Polynomial k ⧸ Ideal.span {p})ˣ) :=
  Set.eq_univ_of_forall fun u ↦
    exists_natDegree_lt_of_quotient_ne_zero hp hp1 (Units.ne_zero u)

/-- **Bass–Tate generation, degree form: `K^M_n(k[X] ⧸ p)` is generated by the symbols of classes
of nonzero polynomials of degree below `deg p`.** An additive subgroup of the Milnor K-ring of
the simple extension which contains every such symbol contains every homogeneous component. -/
theorem milnorKGrading_quotient_le_of_forall_lowDegree_symbolProd {p : Polynomial k}
    (hp : p.Monic) (hp1 : p ≠ 1) [(Ideal.span {p}).IsMaximal]
    {H : AddSubgroup (MilnorKRing (Polynomial k ⧸ Ideal.span {p}))}
    (hH : ∀ l : List (Polynomial k ⧸ Ideal.span {p})ˣ,
      (∀ u ∈ l, u ∈ quotUnitsOfLowDegree p) →
        milnorKSymbolProd (Polynomial k ⧸ Ideal.span {p}) l ∈ H) (n : ℕ) :
    milnorKGrading (Polynomial k ⧸ Ideal.span {p}) n ≤ H :=
  milnorKGrading_le_of_forall_milnorKSymbolProd_mem
    (fun l ↦ hH l fun u _ ↦ by
      rw [quotUnitsOfLowDegree_eq_univ hp hp1]
      exact Set.mem_univ u) n

/-- The class of an element of `K^M_n(k[X] ⧸ p)` lies in any additive subgroup containing the
symbols of classes of nonzero polynomials of degree below `deg p`. -/
theorem coe_mem_of_forall_lowDegree_symbolProd_mem {p : Polynomial k} (hp : p.Monic)
    (hp1 : p ≠ 1) [(Ideal.span {p}).IsMaximal]
    {H : AddSubgroup (MilnorKRing (Polynomial k ⧸ Ideal.span {p}))}
    (hH : ∀ l : List (Polynomial k ⧸ Ideal.span {p})ˣ,
      (∀ u ∈ l, u ∈ quotUnitsOfLowDegree p) →
        milnorKSymbolProd (Polynomial k ⧸ Ideal.span {p}) l ∈ H) {n : ℕ}
    (α : MilnorKTheory (Polynomial k ⧸ Ideal.span {p}) n) :
    (α : MilnorKRing (Polynomial k ⧸ Ideal.span {p})) ∈ H :=
  milnorKGrading_quotient_le_of_forall_lowDegree_symbolProd hp hp1 hH n α.2

end Stacks.Chow

end
