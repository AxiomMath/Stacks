module

public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.DegreeFiltration

/-!
# The degree filtration is generated by symbols of constants and monic irreducibles

Let `k` be a field. The step `L_d` of the degree filtration of
`StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.DegreeFiltration` is generated by the symbols
`{f_1, …, f_r}` of nonzero polynomials of degree at most `d`. This file refines the generating
set: **`L_d` is already generated by the symbols whose every entry is a nonzero constant or a
monic irreducible polynomial of degree at most `d`**
(`Stacks.Chow.milnorKPolyFiltration_eq_milnorKIrrFiltration`).

The reason is that a symbol is additive in each slot. A nonzero polynomial `f` of degree at most
`d` factors as a nonzero constant times monic irreducible polynomials, each of degree at most
`deg f`, so `{f}` is the sum of their symbols; multiplying out a product of such sums expresses
`{f_1, …, f_r}` as a sum of symbols of the refined kind.

This is the generating set Milnor's induction on the degree is run over: the Bass–Tate
degree-lowering identity `Stacks.Chow.milnorKSymbol_mul_of_add_eq'` applies to two *monic*
entries of the same degree, their difference then having smaller degree, and that is what the
refinement here makes available.

## Main definitions

* `Stacks.Chow.polyFactorUnits` — the units of `RatFunc k` which are nonzero constants or monic
  irreducible polynomials of degree at most `d`.
* `Stacks.Chow.milnorKIrrFiltration` — the subgroup they generate.

## Main results

* `Stacks.Chow.milnorKSymbol_polyUnit_mem_closure` — the symbol of a nonzero polynomial of degree
  at most `d` is a sum of symbols of constants and monic irreducibles of degree at most `d`.
* `Stacks.Chow.milnorKPolyFiltration_eq_milnorKIrrFiltration` — **the two filtrations agree.**

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
-/

@[expose] public noncomputable section

open Polynomial

universe u

namespace Stacks.Chow

variable {k : Type u} [Field k]

/-! ### Constants and monic irreducibles -/

/-- The units of `RatFunc k` which are nonzero constants or monic irreducible polynomials of
degree at most `d`. -/
def polyFactorUnits (k : Type u) [Field k] (d : ℕ) : Set (RatFunc k)ˣ :=
  {u | ∃ f : Polynomial k, ∃ hf : f ≠ 0,
    (f.natDegree = 0 ∨ (f.Monic ∧ Irreducible f ∧ f.natDegree ≤ d)) ∧ polyUnit hf = u}

/-- The unit of a constant or of a monic irreducible polynomial of degree at most `d` is the unit
of a nonzero polynomial of degree at most `d`. -/
theorem polyFactorUnits_subset_polyUnitsOfDegreeLE (d : ℕ) :
    polyFactorUnits k d ⊆ polyUnitsOfDegreeLE k d := by
  rintro u ⟨f, hf, hcase | ⟨-, -, hle⟩, rfl⟩
  · exact polyUnit_mem_polyUnitsOfDegreeLE hf (hcase ▸ Nat.zero_le d)
  · exact polyUnit_mem_polyUnitsOfDegreeLE hf hle

/-- `polyFactorUnits k d` is monotone in `d`. -/
theorem polyFactorUnits_mono {d e : ℕ} (hde : d ≤ e) :
    polyFactorUnits k d ⊆ polyFactorUnits k e := by
  rintro u ⟨f, hf, hcase | ⟨hm, hi, hle⟩, rfl⟩
  · exact ⟨f, hf, Or.inl hcase, rfl⟩
  · exact ⟨f, hf, Or.inr ⟨hm, hi, hle.trans hde⟩, rfl⟩

/-! ### The refined filtration -/

/-- **The subgroup of `K^M_*(RatFunc k)` generated by the symbols of constants and monic
irreducible polynomials of degree at most `d`.** -/
def milnorKIrrFiltration (k : Type u) [Field k] (d : ℕ) :
    AddSubgroup (MilnorKRing (RatFunc k)) :=
  AddSubgroup.closure {x | ∃ l : List (RatFunc k)ˣ,
    (∀ u ∈ l, u ∈ polyFactorUnits k d) ∧ milnorKSymbolProd (RatFunc k) l = x}

/-- A product of symbols of elements of `polyFactorUnits k d` lies in
`milnorKIrrFiltration k d`. -/
theorem milnorKSymbolProd_mem_milnorKIrrFiltration {d : ℕ} {l : List (RatFunc k)ˣ}
    (hl : ∀ u ∈ l, u ∈ polyFactorUnits k d) :
    milnorKSymbolProd (RatFunc k) l ∈ milnorKIrrFiltration k d :=
  AddSubgroup.subset_closure ⟨l, hl, rfl⟩

/-- `milnorKIrrFiltration k d` is contained in any additive subgroup containing every product of
symbols of elements of `polyFactorUnits k d`. -/
theorem milnorKIrrFiltration_le {d : ℕ} {H : AddSubgroup (MilnorKRing (RatFunc k))}
    (hH : ∀ l : List (RatFunc k)ˣ, (∀ u ∈ l, u ∈ polyFactorUnits k d) →
      milnorKSymbolProd (RatFunc k) l ∈ H) :
    milnorKIrrFiltration k d ≤ H := by
  refine AddSubgroup.closure_le _ |>.mpr ?_
  rintro x ⟨l, hl, rfl⟩
  exact hH l hl

/-- The refined filtration sits inside the degree filtration. -/
theorem milnorKIrrFiltration_le_milnorKPolyFiltration (d : ℕ) :
    milnorKIrrFiltration k d ≤ milnorKPolyFiltration k d :=
  milnorKIrrFiltration_le fun _ hl ↦ milnorKSymbolProd_mem_milnorKPolyFiltration
    fun u hu ↦ polyFactorUnits_subset_polyUnitsOfDegreeLE d (hl u hu)

/-- Multiplying by the symbol of a constant or a monic irreducible respects the refined
filtration. -/
theorem milnorKSymbol_mul_mem_milnorKIrrFiltration {d : ℕ} {v : (RatFunc k)ˣ}
    (hv : v ∈ polyFactorUnits k d) {x : MilnorKRing (RatFunc k)}
    (hx : x ∈ milnorKIrrFiltration k d) :
    milnorKSymbol (RatFunc k) v * x ∈ milnorKIrrFiltration k d := by
  refine milnorKIrrFiltration_le (H := AddSubgroup.comap
    (AddMonoidHom.mulLeft (milnorKSymbol (RatFunc k) v)) (milnorKIrrFiltration k d)) ?_ hx
  intro l hl
  change milnorKSymbol (RatFunc k) v * milnorKSymbolProd (RatFunc k) l ∈
    milnorKIrrFiltration k d
  rw [← milnorKSymbolProd_cons]
  refine milnorKSymbolProd_mem_milnorKIrrFiltration fun w hw ↦ ?_
  rcases List.mem_cons.mp hw with rfl | hwl
  · exact hv
  · exact hl w hwl

/-! ### Factoring a polynomial out of its symbol -/

/-- The symbol of a product of nonzero polynomials is the sum of their symbols. -/
theorem milnorKSymbol_polyUnit_mul {f g : Polynomial k} (hf : f ≠ 0) (hg : g ≠ 0)
    (hfg : f * g ≠ 0) :
    milnorKSymbol (RatFunc k) (polyUnit hfg) =
      milnorKSymbol (RatFunc k) (polyUnit hf) + milnorKSymbol (RatFunc k) (polyUnit hg) := by
  rw [← milnorKSymbol_mul]
  exact congrArg _ (Units.ext (by rw [coe_polyUnit, Units.val_mul, coe_polyUnit, coe_polyUnit,
    map_mul]))

/-- A nonzero polynomial which is not a constant has a monic irreducible factor. -/
theorem exists_monic_irreducible_factor {f : Polynomial k} (hf : f ≠ 0)
    (hdeg : f.natDegree ≠ 0) :
    ∃ q : Polynomial k, q.Monic ∧ Irreducible q ∧ q ∣ f := by
  have hnu : ¬IsUnit f := fun h ↦ hdeg (natDegree_eq_zero_of_isUnit h)
  obtain ⟨q, hq, hqdvd⟩ := WfDvdMonoid.exists_irreducible_factor hnu hf
  have hassoc := associated_mul_unit_right q (C (leadingCoeff q)⁻¹ : Polynomial k)
    (isUnit_C.mpr (leadingCoeff_ne_zero.mpr hq.ne_zero).isUnit.inv)
  exact ⟨q * C (leadingCoeff q)⁻¹, monic_mul_leadingCoeff_inv hq.ne_zero,
    hassoc.irreducible hq, hassoc.dvd_iff_dvd_left.1 hqdvd⟩

/-- **The symbol of a nonzero polynomial of degree at most `d` is a sum of symbols of nonzero
constants and monic irreducible polynomials of degree at most `d`.** -/
theorem milnorKSymbol_polyUnit_mem_closure (d : ℕ) :
    ∀ (n : ℕ) (f : Polynomial k) (hf : f ≠ 0), f.natDegree ≤ n → f.natDegree ≤ d →
      milnorKSymbol (RatFunc k) (polyUnit hf) ∈
        AddSubgroup.closure (milnorKSymbol (RatFunc k) '' polyFactorUnits k d) := by
  have hmem : ∀ (f : Polynomial k) (hf : f ≠ 0),
      (f.natDegree = 0 ∨ (f.Monic ∧ Irreducible f ∧ f.natDegree ≤ d)) →
        milnorKSymbol (RatFunc k) (polyUnit hf) ∈
          AddSubgroup.closure (milnorKSymbol (RatFunc k) '' polyFactorUnits k d) :=
    fun f hf h ↦ AddSubgroup.subset_closure ⟨polyUnit hf, ⟨f, hf, h, rfl⟩, rfl⟩
  intro n
  induction n with
  | zero => exact fun f hf hfn _ ↦ hmem f hf (Or.inl (Nat.le_zero.mp hfn))
  | succ n ih =>
      intro f hf hfn hfd
      by_cases h0 : f.natDegree = 0
      · exact hmem f hf (Or.inl h0)
      obtain ⟨q, hqm, hqi, g, rfl⟩ := exists_monic_irreducible_factor hf h0
      have hq0 : q ≠ 0 := hqm.ne_zero
      have hg0 : g ≠ 0 := fun h ↦ hf (by rw [h, mul_zero])
      have hqpos : 0 < q.natDegree :=
        natDegree_pos_iff_degree_pos.mpr (degree_pos_of_irreducible hqi)
      have hsum : q.natDegree + g.natDegree = (q * g).natDegree :=
        (Polynomial.natDegree_mul hq0 hg0).symm
      rw [milnorKSymbol_polyUnit_mul hq0 hg0 hf]
      refine add_mem (hmem q hq0 (Or.inr ⟨hqm, hqi, le_trans (by omega) hfd⟩)) ?_
      exact ih g hg0 (by omega) (by omega)

/-! ### The two filtrations agree -/

/-- **`L_d` is generated by the symbols of constants and monic irreducibles of degree at most
`d`.** -/
theorem milnorKPolyFiltration_le_milnorKIrrFiltration (d : ℕ) :
    milnorKPolyFiltration k d ≤ milnorKIrrFiltration k d := by
  refine milnorKPolyFiltration_le fun l ↦ ?_
  induction l with
  | nil => exact fun _ ↦ milnorKSymbolProd_mem_milnorKIrrFiltration (by simp)
  | cons u l ih =>
      intro hl
      have hrest := ih fun v hv ↦ hl v (List.mem_cons_of_mem u hv)
      obtain ⟨f, hf, hfd, rfl⟩ := hl u List.mem_cons_self
      have key : milnorKSymbol (RatFunc k) (polyUnit hf) ∈
          AddSubgroup.comap (AddMonoidHom.mulRight (milnorKSymbolProd (RatFunc k) l))
            (milnorKIrrFiltration k d) := by
        refine (AddSubgroup.closure_le _).mpr ?_
          (milnorKSymbol_polyUnit_mem_closure d f.natDegree f hf le_rfl hfd)
        rintro _ ⟨v, hv, rfl⟩
        exact milnorKSymbol_mul_mem_milnorKIrrFiltration hv hrest
      rw [milnorKSymbolProd_cons]
      exact key

/-- The degree filtration and its refinement by constants and monic irreducibles are the same
subgroup. -/
theorem milnorKPolyFiltration_eq_milnorKIrrFiltration (d : ℕ) :
    milnorKPolyFiltration k d = milnorKIrrFiltration k d :=
  le_antisymm (milnorKPolyFiltration_le_milnorKIrrFiltration d)
    (milnorKIrrFiltration_le_milnorKPolyFiltration d)

end Stacks.Chow

end
