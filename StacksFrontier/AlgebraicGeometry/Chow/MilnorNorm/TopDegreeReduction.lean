module

public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.BassTate
public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.IrreducibleGenerators
public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.SymbolReorder

/-!
# Bass–Tate: a symbol in `L_d` needs only one entry of degree `d`

Let `k` be a field and `d ≥ 1`. By
`StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.IrreducibleGenerators` the step `L_d` of the
degree filtration is generated by the symbols whose entries are nonzero constants and monic
irreducible polynomials of degree at most `d`. This file proves the Bass–Tate reduction:

**`L_d` is generated by the symbols with AT MOST ONE entry of degree exactly `d`**
(`Stacks.Chow.milnorKPolyFiltration_le_milnorKOneTopFiltration`).

That is the statement Milnor's description of `L_d / L_{d-1}` is read off from: modulo `L_{d-1}`,
whose generators have no entry of degree `d` at all, the group `L_d` is generated by the symbols
`{φ, g_1, …, g_{n-1}}` with `φ` monic irreducible of degree `d` and the `g_i` of degree below
`d`.

## The reduction

Induction on the number of entries of degree exactly `d`. If two entries have that degree, bring
them to the front — which costs at most a sign, by
`StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.SymbolReorder` — and call them `φ` and `ψ`.

* If `φ = ψ`, then `{φ} {φ} = -{φ} {-1}` and the second entry has become a constant.
* Otherwise `f = ψ - φ` is nonzero of degree below `d`, the two being monic of degree `d`, and
  the degree-lowering identity `Stacks.Chow.milnorKSymbol_mul_of_add_eq'` gives

  `{φ} {ψ} = {φ} {f} - {ψ} {f} - {ψ} {-1}`.

  Each term has one entry of degree `d` where there were two: `f` factors into constants and
  monic irreducibles of degree below `d`, by
  `Stacks.Chow.milnorKSymbol_polyUnit_mem_closure`, and `-1` is a constant.

Either way the count drops by one, so the induction closes.

## Main definitions

* `Stacks.Chow.topDegreeUnits` — the units of `RatFunc k` which are monic irreducible of degree
  exactly `d`.
* `Stacks.Chow.topDegreeCount` — how many entries of a symbol are of that kind.
* `Stacks.Chow.milnorKOneTopFiltration` — the subgroup generated by the symbols with at most one.

## Main results

* `Stacks.Chow.polyUnit_inj` — a polynomial is determined by its unit in `RatFunc k`.
* `Stacks.Chow.notMem_topDegreeUnits_of_natDegree_lt` — an entry of degree below `d` is not of
  top degree.
* `Stacks.Chow.exists_perm_two_top` — two entries of top degree can be brought to the front.
* `Stacks.Chow.milnorKPolyFiltration_le_milnorKOneTopFiltration` — **the reduction.**

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
-/

@[expose] public noncomputable section

open Polynomial

universe u

namespace Stacks.Chow

variable {k : Type u} [Field k]

/-! ### Polynomials of top degree -/

/-- A polynomial is determined by the unit of `RatFunc k` it gives. -/
theorem polyUnit_inj {f g : Polynomial k} (hf : f ≠ 0) (hg : g ≠ 0)
    (h : polyUnit hf = polyUnit hg) : f = g :=
  IsFractionRing.injective (Polynomial k) (RatFunc k) (by
    rw [← coe_polyUnit hf, ← coe_polyUnit hg, h])

/-- The units of `RatFunc k` which are monic irreducible polynomials of degree exactly `d`. -/
def topDegreeUnits (k : Type u) [Field k] (d : ℕ) : Set (RatFunc k)ˣ :=
  {u | ∃ f : Polynomial k, ∃ hf : f ≠ 0,
    (f.Monic ∧ Irreducible f ∧ f.natDegree = d) ∧ polyUnit hf = u}

/-- A monic irreducible polynomial of degree exactly `d` is among the generators of degree at
most `d`. -/
theorem topDegreeUnits_subset_polyFactorUnits (d : ℕ) :
    topDegreeUnits k d ⊆ polyFactorUnits k d := by
  rintro u ⟨f, hf, ⟨hm, hi, hdeg⟩, rfl⟩
  exact ⟨f, hf, Or.inr ⟨hm, hi, hdeg.le⟩, rfl⟩

/-- **An entry of degree below `d` is not of top degree.** -/
theorem notMem_topDegreeUnits_of_natDegree_lt {d e : ℕ} (hed : e < d) {v : (RatFunc k)ˣ}
    (hv : v ∈ polyFactorUnits k e) : v ∉ topDegreeUnits k d := by
  rintro ⟨g, hg, ⟨-, -, hgdeg⟩, hgv⟩
  obtain ⟨f, hf, hcase, rfl⟩ := hv
  have hle : f.natDegree ≤ e := by
    rcases hcase with h | ⟨-, -, h⟩
    · exact h ▸ Nat.zero_le e
    · exact h
  rw [polyUnit_inj hg hf hgv] at hgdeg
  omega

/-- The constant `-1`, as a unit of `RatFunc k`, is the polynomial `-1`. -/
theorem polyUnit_neg_one (h : (C (-1 : k) : Polynomial k) ≠ 0) :
    polyUnit h = (-1 : (RatFunc k)ˣ) :=
  Units.ext (by rw [coe_polyUnit, C_neg, C_1, map_neg, map_one, Units.val_neg, Units.val_one])

/-- The constant polynomial `-1` is nonzero. -/
theorem C_neg_one_ne_zero : (C (-1 : k) : Polynomial k) ≠ 0 := by
  rw [C_neg, C_1]
  exact neg_ne_zero.mpr one_ne_zero

/-- The unit `-1` of `RatFunc k` lies in `polyFactorUnits k d`. -/
theorem neg_one_mem_polyFactorUnits (d : ℕ) :
    (-1 : (RatFunc k)ˣ) ∈ polyFactorUnits k d :=
  ⟨C (-1 : k), C_neg_one_ne_zero, Or.inl (by rw [C_neg, C_1, natDegree_neg, natDegree_one]),
    polyUnit_neg_one C_neg_one_ne_zero⟩

/-- For `0 < d`, the unit `-1` of `RatFunc k` is not monic irreducible of degree `d`. -/
theorem neg_one_notMem_topDegreeUnits {d : ℕ} (hd : 0 < d) :
    (-1 : (RatFunc k)ˣ) ∉ topDegreeUnits k d :=
  notMem_topDegreeUnits_of_natDegree_lt hd (neg_one_mem_polyFactorUnits 0)

/-! ### Counting the entries of top degree -/

open Classical in
/-- The number of entries of a symbol which are monic irreducible of degree exactly `d`. -/
def topDegreeCount (k : Type u) [Field k] (d : ℕ) (l : List (RatFunc k)ˣ) : ℕ :=
  l.countP fun u ↦ decide (u ∈ topDegreeUnits k d)

/-- Prepending an entry of top degree raises `topDegreeCount` by one. -/
theorem topDegreeCount_cons_of_mem {d : ℕ} {u : (RatFunc k)ˣ} (hu : u ∈ topDegreeUnits k d)
    (l : List (RatFunc k)ˣ) : topDegreeCount k d (u :: l) = topDegreeCount k d l + 1 := by
  classical
  simp [topDegreeCount, hu]

/-- Prepending an entry not of top degree leaves `topDegreeCount` unchanged. -/
theorem topDegreeCount_cons_of_notMem {d : ℕ} {u : (RatFunc k)ˣ} (hu : u ∉ topDegreeUnits k d)
    (l : List (RatFunc k)ˣ) : topDegreeCount k d (u :: l) = topDegreeCount k d l := by
  classical
  simp [topDegreeCount, hu]

/-- `topDegreeCount` is invariant under permutation of the entries. -/
theorem topDegreeCount_perm {d : ℕ} {l l' : List (RatFunc k)ˣ} (h : l.Perm l') :
    topDegreeCount k d l = topDegreeCount k d l' :=
  h.countP_eq _

/-- **Two entries of top degree can be brought to the front of a symbol.** -/
theorem exists_perm_two_top {d : ℕ} {l : List (RatFunc k)ˣ} (h2 : 2 ≤ topDegreeCount k d l) :
    ∃ (a b : (RatFunc k)ˣ) (rest : List (RatFunc k)ˣ),
      a ∈ topDegreeUnits k d ∧ b ∈ topDegreeUnits k d ∧ (∀ u ∈ rest, u ∈ l) ∧
        a ∈ l ∧ b ∈ l ∧ l.Perm (a :: b :: rest) := by
  classical
  have hlen : 2 ≤ (l.filter fun u ↦ decide (u ∈ topDegreeUnits k d)).length := by
    rw [← List.countP_eq_length_filter]
    exact h2
  obtain ⟨a, b, t, ht⟩ : ∃ a b t, (l.filter fun u ↦ decide (u ∈ topDegreeUnits k d)) =
      a :: b :: t := by
    revert hlen
    generalize (l.filter fun u ↦ decide (u ∈ topDegreeUnits k d)) = L
    rcases L with _ | ⟨x, xs⟩
    · intro h; simp at h
    · rcases xs with _ | ⟨y, ys⟩
      · intro h; simp at h
      · exact fun _ ↦ ⟨x, y, ys, rfl⟩
  have hamem : a ∈ l.filter fun u ↦ decide (u ∈ topDegreeUnits k d) := by
    rw [ht]; exact List.mem_cons_self
  have hbmem : b ∈ l.filter fun u ↦ decide (u ∈ topDegreeUnits k d) := by
    rw [ht]; exact List.mem_cons_of_mem a List.mem_cons_self
  refine ⟨a, b, t ++ l.filter fun u ↦ !decide (u ∈ topDegreeUnits k d),
    by simpa using (List.mem_filter.mp hamem).2, by simpa using (List.mem_filter.mp hbmem).2,
    ?_, List.mem_of_mem_filter hamem, List.mem_of_mem_filter hbmem, ?_⟩
  · intro u hu
    rcases List.mem_append.mp hu with hut | huf
    · exact List.mem_of_mem_filter (ht ▸ List.mem_cons_of_mem a (List.mem_cons_of_mem b hut))
    · exact List.mem_of_mem_filter huf
  · refine (List.filter_append_perm (fun u ↦ decide (u ∈ topDegreeUnits k d)) l).symm.trans ?_
    rw [ht, List.cons_append, List.cons_append]

/-! ### The subgroup with at most one entry of top degree -/

/-- **The subgroup of `K^M_*(RatFunc k)` generated by the symbols of constants and monic
irreducible polynomials of degree at most `d` with at most one entry of degree exactly `d`.** -/
def milnorKOneTopFiltration (k : Type u) [Field k] (d : ℕ) :
    AddSubgroup (MilnorKRing (RatFunc k)) :=
  AddSubgroup.closure {x | ∃ l : List (RatFunc k)ˣ,
    (∀ u ∈ l, u ∈ polyFactorUnits k d) ∧ topDegreeCount k d l ≤ 1 ∧
      milnorKSymbolProd (RatFunc k) l = x}

/-- A symbol whose entries lie in `polyFactorUnits k d`, at most one of them of degree exactly
`d`, lies in `milnorKOneTopFiltration k d`. -/
theorem milnorKSymbolProd_mem_milnorKOneTopFiltration {d : ℕ} {l : List (RatFunc k)ˣ}
    (hl : ∀ u ∈ l, u ∈ polyFactorUnits k d) (hcount : topDegreeCount k d l ≤ 1) :
    milnorKSymbolProd (RatFunc k) l ∈ milnorKOneTopFiltration k d :=
  AddSubgroup.subset_closure ⟨l, hl, hcount, rfl⟩

/-! ### The reduction -/

/-- For `0 < d`, a symbol whose entries lie in `polyFactorUnits k d`, with at most `n` of them of
degree exactly `d`, lies in `milnorKOneTopFiltration k d`. -/
theorem milnorKSymbolProd_mem_milnorKOneTopFiltration_of_count {d : ℕ} (hd : 0 < d) :
    ∀ (n : ℕ) (l : List (RatFunc k)ˣ), (∀ u ∈ l, u ∈ polyFactorUnits k d) →
      topDegreeCount k d l ≤ n →
      milnorKSymbolProd (RatFunc k) l ∈ milnorKOneTopFiltration k d := by
  intro n
  induction n with
  | zero =>
      exact fun l hl hc ↦
        milnorKSymbolProd_mem_milnorKOneTopFiltration hl (hc.trans (Nat.zero_le 1))
  | succ n ih =>
      intro l hl hc
      by_cases hle : topDegreeCount k d l ≤ 1
      · exact milnorKSymbolProd_mem_milnorKOneTopFiltration hl hle
      obtain ⟨a, b, rest, ha, hb, hrest, hal, hbl, hperm⟩ :=
        exists_perm_two_top (Nat.not_lt.mp (fun h ↦ hle (Nat.lt_succ_iff.mp h)))
      have hrestfac : ∀ u ∈ rest, u ∈ polyFactorUnits k d := fun u hu ↦ hl u (hrest u hu)
      have hcrest : topDegreeCount k d rest + 1 ≤ n := by
        have := topDegreeCount_perm (k := k) (d := d) hperm
        rw [topDegreeCount_cons_of_mem ha, topDegreeCount_cons_of_mem hb] at this
        omega
      -- a symbol `c, v, rest` with `c` of top degree and `v` of lower degree: one fewer top entry
      have hcons : ∀ c v : (RatFunc k)ˣ, c ∈ topDegreeUnits k d → c ∈ l →
          v ∈ polyFactorUnits k d → v ∉ topDegreeUnits k d →
          milnorKSymbol (RatFunc k) c * (milnorKSymbol (RatFunc k) v *
            milnorKSymbolProd (RatFunc k) rest) ∈ milnorKOneTopFiltration k d := by
        intro c v hc hcl hv hvt
        rw [← milnorKSymbolProd_cons, ← milnorKSymbolProd_cons]
        refine ih _ (fun u hu ↦ ?_) ?_
        · rcases List.mem_cons.mp hu with rfl | hu'
          · exact hl _ hcl
          rcases List.mem_cons.mp hu' with rfl | hu''
          · exact hv
          · exact hrestfac u hu''
        · rw [topDegreeCount_cons_of_mem hc, topDegreeCount_cons_of_notMem hvt]
          omega
      refine milnorKSymbolProd_mem_of_perm hperm ?_
      obtain ⟨φ, hφ0, ⟨hφm, hφi, hφdeg⟩, rfl⟩ := id ha
      obtain ⟨ψ, hψ0, ⟨hψm, hψi, hψdeg⟩, rfl⟩ := id hb
      set R := milnorKSymbolProd (RatFunc k) rest with hR
      -- the symbol with `-1` in the second slot
      have hnegone := hcons _ _ hb hbl (neg_one_mem_polyFactorUnits d)
        (neg_one_notMem_topDegreeUnits hd)
      by_cases hsame : φ = ψ
      · subst hsame
        rw [milnorKSymbolProd_cons, milnorKSymbolProd_cons, ← hR, ← mul_assoc,
          eq_neg_of_add_eq_zero_left
            (milnorKSymbol_mul_self_add_mul_negOne (k := RatFunc k) (polyUnit hφ0)),
          milnorKNegOne_eq, neg_mul, mul_assoc]
        exact neg_mem hnegone
      · have hsub0 : ψ - φ ≠ 0 := sub_ne_zero.mpr fun h ↦ hsame h.symm
        have hdeglt : (ψ - φ).natDegree < d := by
          refine hψdeg ▸ Polynomial.natDegree_lt_natDegree hsub0 ?_
          refine Polynomial.degree_sub_lt_left ?_ hψ0 ?_
          · rw [Polynomial.degree_eq_natDegree hψ0, Polynomial.degree_eq_natDegree hφ0,
              hψdeg, hφdeg]
          · rw [hψm.leadingCoeff, hφm.leadingCoeff]
        have hexp := milnorKSymbol_polyUnit_mem_closure (k := k) (ψ - φ).natDegree
          (ψ - φ).natDegree (ψ - φ) hsub0 le_rfl le_rfl
        -- multiplying a low-degree entry into either top-degree slot stays in the subgroup
        have hslot : ∀ c : (RatFunc k)ˣ, c ∈ topDegreeUnits k d → c ∈ l →
            milnorKSymbol (RatFunc k) (polyUnit hsub0) ∈ AddSubgroup.comap
              (((AddMonoidHom.mulLeft (milnorKSymbol (RatFunc k) c)).comp
                (AddMonoidHom.mulRight R))) (milnorKOneTopFiltration k d) := by
          intro c hc hcl
          refine (AddSubgroup.closure_le _).mpr ?_ hexp
          rintro _ ⟨v, hv, rfl⟩
          exact hcons c v hc hcl (polyFactorUnits_mono hdeglt.le hv)
            (notMem_topDegreeUnits_of_natDegree_lt hdeglt hv)
        have hφslot := hslot _ ha hal
        have hψslot := hslot _ hb hbl
        rw [milnorKSymbolProd_cons, milnorKSymbolProd_cons, ← hR, ← mul_assoc,
          milnorKSymbol_mul_of_add_eq' (φ := polyUnit hφ0) (f := polyUnit hsub0)
            (ψ := polyUnit hψ0) (by rw [coe_polyUnit, coe_polyUnit, coe_polyUnit, ← map_add,
              add_sub_cancel]),
          sub_mul, sub_mul, mul_assoc, mul_assoc, mul_assoc, milnorKNegOne_eq]
        exact sub_mem (sub_mem hφslot hψslot) hnegone

/-- **Bass–Tate: `L_d` is generated by the symbols with at most one entry of degree exactly
`d`.** -/
theorem milnorKPolyFiltration_le_milnorKOneTopFiltration {d : ℕ} (hd : 0 < d) :
    milnorKPolyFiltration k d ≤ milnorKOneTopFiltration k d :=
  (milnorKPolyFiltration_le_milnorKIrrFiltration d).trans
    (milnorKIrrFiltration_le fun l hl ↦
      milnorKSymbolProd_mem_milnorKOneTopFiltration_of_count hd (topDegreeCount k d l) l hl le_rfl)

end Stacks.Chow

end
