module

public import Mathlib.RingTheory.Nakayama
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import StacksFrontier.AlgebraicGeometry.AmplePowers.ModuleStalk
public import StacksFrontier.AlgebraicGeometry.Chow.ZeroCyclesIsolatedPoint
public import StacksFrontier.AlgebraicGeometry.Modules.InvertibleStalkFree

/-!
# Cutting out a closed point by sections generating the cotangent space

Let `X` be a scheme, `ℒ` an invertible `𝒪_X`-module, `x ∈ X` a point and `s_1, …, s_d` global
sections of `ℒ`, cutting out the closed subschemes `H_i = Z(s_i)`. This file proves Step 4 of the
proof of [Stacks, Tag 0FH5]: the condition

`(s_1, …, s_d) ∈ U ⟺ s_1, …, s_d generate 𝔪_x ℒ_x/𝔪_x^2 ℒ_x over κ(x)`,

its nonemptiness when `𝒪_{X,x}` is a regular local ring of dimension `d`, and the passage, by
Nakayama, to generation of `𝔪_x ℒ_x`. A tuple whose germs generate `𝔪_x ℒ_x` cuts out a closed
subscheme `H_1 ∩ … ∩ H_d = ⨆ i, Z(s_i)` whose ideal sheaf has stalk `𝔪_x` at `x`, and hence
`H_1 ∩ … ∩ H_d = x ⊔ Z` scheme theoretically.

## Main definitions

* `Stacks.Chow.GeneratesCotangentAt`: the germs of the `s_i` at `x`, together with `𝔪_x^2 ℒ_x`,
  generate `𝔪_x ℒ_x`.

## Main results

* `AlgebraicGeometry.IdealSheafData.stalk_iSup`: the stalk of a supremum of quasi-coherent
  sheaves of ideals is the supremum of the stalks.
* `Stacks.Divisors.IsStalkBasis.map_maximalIdeal` and
  `Stacks.Divisors.IsStalkBasis.map_span`: a stalk basis carries `𝔪_x` onto `𝔪_x ℒ_x` and an
  ideal's generators onto their multiples by the basis.
* `Stacks.Chow.exists_affineOpen_linearEquiv_isStalkBasis`: an invertible module is trivialized
  on the sections over some affine open neighbourhood of a point, by a trivialization whose
  basis section has a stalk basis for its germ.
* `Stacks.Chow.stalk_iSup_zeroScheme_eq_maximalIdeal`: if the germs of the `s_i` generate
  `𝔪_x ℒ_x` then the stalk at `x` of the ideal sheaf of `⨆ i, Z(s_i) = H_1 ∩ … ∩ H_d` is the
  maximal ideal `𝔪_x`.
* `Stacks.Chow.span_Γgerm_eq_maximalSmul_of_generatesCotangentAt`: on a locally Noetherian
  scheme a tuple in `U` has germs generating `𝔪_x ℒ_x`.
* `Stacks.Chow.exists_generatesCotangentAt_of_span_eq_maximalIdeal`,
  `Stacks.Chow.exists_generatesCotangentAt_of_finrank_cotangentSpace` and
  `Stacks.Chow.exists_generatesCotangentAt_of_isRegularLocalRing`: the nonemptiness of `U`, given
  the surjectivity of `V → 𝔪_x ℒ_x/𝔪_x^2 ℒ_x`, when `𝔪_x` is generated by `d` elements, when
  `dim_{κ(x)} 𝔪_x/𝔪_x^2 = d`, and when `𝒪_{X,x}` is a regular local ring of dimension `d`.
* `Stacks.Chow.exists_cycleAssociatedToClosedSubscheme_eq_add_of_generatesCotangentAt` and
  `Stacks.Chow.exists_mk_cycleAssociatedToClosedSubscheme_eq_add_of_generatesCotangentAt`: for a
  tuple in `U` at a closed point of a Noetherian scheme, `[H_1 ∩ … ∩ H_d]_k = [x]_k + [Z]_k`, with
  `[x]` of multiplicity one and `Z` supported on `Supp(H_1 ∩ … ∩ H_d) ∖ {x}`.

## Implementation notes

The quotient `𝔪_x ℒ_x/𝔪_x^2 ℒ_x` is annihilated by `𝔪_x`, so its `𝒪_{X,x}`-submodules and its
`κ(x)`-subspaces are the same sets, and generation over `κ(x)` is generation over `𝒪_{X,x}`.
`GeneratesCotangentAt` is stated over `𝒪_{X,x}`, as `span ⊔ 𝔪_x^2 ℒ_x = 𝔪_x ℒ_x`, which is the
quotient statement with the quotient eliminated; it contains the vanishing of the `s_i` at `x`.

Here `U` is a predicate on tuples rather than an open subscheme of `V^d`.

## References

* [Stacks Project, Tag 0FH5](https://stacks.math.columbia.edu/tag/0FH5)
* [Stacks Project, Tag 0FD6](https://stacks.math.columbia.edu/tag/0FD6)
* [Stacks Project, Tag 00DV](https://stacks.math.columbia.edu/tag/00DV)
* [Stacks Project, Tag 00KU](https://stacks.math.columbia.edu/tag/00KU)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open scoped Stacks.ModuleStalk

universe u

namespace AlgebraicGeometry.IdealSheafData

/-- **The stalk of a supremum of quasi-coherent sheaves of ideals is the supremum of the
stalks.** Geometrically, the local ring of a scheme-theoretic intersection of a family of closed
subschemes at a point is the quotient of the local ring of the ambient scheme by the supremum of
the local ideals. -/
theorem stalk_iSup {X : Scheme.{u}} {ι : Type*} (J : ι → X.IdealSheafData) (x : X) :
    IdealSheafData.stalk (⨆ i, J i) x = ⨆ i, IdealSheafData.stalk (J i) x := by
  obtain ⟨U, hxU⟩ := Stacks.Divisors.exists_affineOpens_mem x
  rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ _ x U hxU]
  simp only [Scheme.IdealSheafData.ideal_iSup, iSup_apply, Ideal.map_iSup]
  exact iSup_congr fun i =>
    (AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ (J i) x U hxU).symm

end AlgebraicGeometry.IdealSheafData

namespace Stacks.Divisors

variable {X : Scheme.{u}} {L : X.Modules} {x : X} {β : L.presheaf.stalk x}

/-- **A stalk basis carries `𝔪_x` onto `𝔪_x ℒ_x`.** Multiplication by a stalk basis is an
isomorphism `𝒪_{X,x} ≅ ℒ_x`, and it carries an ideal `I` to `I ℒ_x`. -/
theorem IsStalkBasis.map_maximalIdeal (hβ : IsStalkBasis L x β) :
    Submodule.map (hβ.linearEquiv : X.presheaf.stalk x →ₗ[X.presheaf.stalk x] L.presheaf.stalk x)
        (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) =
      Stacks.ModuleStalk.maximalSmul L x := by
  have h : Submodule.map
      (hβ.linearEquiv : X.presheaf.stalk x →ₗ[X.presheaf.stalk x] L.presheaf.stalk x)
      (IsLocalRing.maximalIdeal (X.presheaf.stalk x) •
        (⊤ : Submodule (X.presheaf.stalk x) (X.presheaf.stalk x))) =
      Stacks.ModuleStalk.maximalSmul L x := by
    rw [Submodule.map_smul'', Submodule.map_top,
      LinearMap.range_eq_top.mpr hβ.linearEquiv.surjective, Stacks.ModuleStalk.maximalSmul]
  rwa [Ideal.smul_eq_mul, Ideal.mul_top] at h

/-- **A stalk basis carries the span of a family onto the span of its multiples by the basis.** -/
theorem IsStalkBasis.map_span (hβ : IsStalkBasis L x β) {ι : Type*}
    (c : ι → X.presheaf.stalk x) :
    Submodule.map (hβ.linearEquiv : X.presheaf.stalk x →ₗ[X.presheaf.stalk x] L.presheaf.stalk x)
        (Ideal.span (Set.range c)) =
      Submodule.span (X.presheaf.stalk x) (Set.range fun i => c i • β) := by
  rw [Submodule.map_span, ← Set.range_comp]
  rfl

end Stacks.Divisors

namespace Stacks.Chow

variable {X : Scheme.{u}} (L : X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]

/-! ### An affine trivializing open whose basis section has a stalk basis for its germ -/

/-- **An invertible module is trivialized on the sections over an affine open neighbourhood of any
point, by a trivialization whose basis section germinates to a stalk basis.** The converse half of
[Stacks, Tag 0B8M] produces a section `g` over some open `W ∋ x` such that `c ↦ c · g|_V` is
bijective on the sections over every `V ≤ W`; an affine open `U` with `x ∈ U ≤ W` inherits both
the bijectivity, whose inverse is the trivialization `e`, and — at `x` — the stalk basis. -/
theorem exists_affineOpen_linearEquiv_isStalkBasis (x : X) :
    ∃ (U : X.affineOpens) (hxU : x ∈ U.1) (e : Γ(L, U.1) ≃ₗ[Γ(X, U.1)] Γ(X, U.1)),
      Stacks.Divisors.IsStalkBasis L x (L.presheaf.germ U.1 x hxU (e.symm 1)) := by
  have hinv : Stacks.SheafOfModules.IsInvertible X.toRingedSpace.presheaf
      (structureSheafRing X.toRingedSpace).property L :=
    (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry _ _ L).mpr ‹_›
  obtain ⟨W, hxW, g, hbij⟩ := Stacks.SheafOfModules.exists_bijective_smul_of_isInvertible
    (X := X.toRingedSpace) L x
  obtain ⟨-, ⟨U, hUaff, rfl⟩, hxU, hUW⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxW W.isOpen
  have hUW' : (U : X.Opens) ≤ W := hUW
  have hbijU : Function.Bijective
      (LinearMap.toSpanSingleton Γ(X, U) Γ(L, U) (L.presheaf.map (homOfLE hUW').op g)) :=
    hbij U hUW'
  refine ⟨⟨U, hUaff⟩, hxU, (LinearEquiv.ofBijective _ hbijU).symm, ?_⟩
  show Stacks.Divisors.IsStalkBasis L x (L.presheaf.germ (U : X.Opens) x hxU _)
  simp only [LinearEquiv.symm_symm, LinearEquiv.ofBijective_apply,
    LinearMap.toSpanSingleton_apply, one_smul]
  rw [L.presheaf.germ_res_apply (homOfLE hUW') x hxU g]
  exact Stacks.Divisors.isStalkBasis_germ_of_bijective_smul g (fun V hV => hbij V hV) x hxW

/-! ### The stalk bridge of Step 5 -/

/-- If the germs at `x` of the global sections
`s_i` of an invertible `ℒ` generate `𝔪_x ℒ_x`, then the stalk at `x` of the quasi-coherent sheaf
of ideals of the scheme-theoretic intersection `⨆ i, Z(s_i) = H_1 ∩ … ∩ H_d` is the whole maximal
ideal `𝔪_x`. -/
theorem stalk_iSup_zeroScheme_eq_maximalIdeal {ι : Type*} (s : ι → Γ(L, ⊤)) (x : X)
    (hgen : Submodule.span (X.presheaf.stalk x)
        (Set.range fun i => (L.presheaf.Γgerm x).hom (s i)) =
      Stacks.ModuleStalk.maximalSmul L x) :
    AlgebraicGeometry.IdealSheafData.stalk (⨆ i, zeroScheme X L (s i)) x =
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
  obtain ⟨U, hxU, e, hβ⟩ := exists_affineOpen_linearEquiv_isStalkBasis L x
  set β : L.presheaf.stalk x := L.presheaf.germ U.1 x hxU (e.symm 1) with hβdef
  set c : ι → X.presheaf.stalk x := fun i =>
    (X.presheaf.germ U.1 x hxU).hom (e (L.presheaf.map (homOfLE le_top).op (s i))) with hcdef
  have h1 : AlgebraicGeometry.IdealSheafData.stalk (⨆ i, zeroScheme X L (s i)) x =
      Ideal.span (Set.range c) := by
    rw [AlgebraicGeometry.IdealSheafData.stalk_iSup]
    have hi : ∀ i, AlgebraicGeometry.IdealSheafData.stalk (zeroScheme X L (s i)) x =
        Ideal.span {c i} := fun i =>
      Stacks.Divisors.stalk_zeroScheme_eq_span_germ L (s i) U e _ rfl x hxU
    simp only [hi]
    rw [Submodule.iSup_span, Set.iUnion_singleton_eq_range]
  have h2 : ∀ i, (L.presheaf.Γgerm x).hom (s i) = c i • β := fun i => by
    have hres : L.presheaf.map (homOfLE (le_top : (U : X.Opens) ≤ ⊤)).op (s i) =
        e (L.presheaf.map (homOfLE le_top).op (s i)) • e.symm 1 := by
      conv_lhs => rw [← e.symm_apply_apply (L.presheaf.map (homOfLE le_top).op (s i))]
      simpa using
        e.symm.map_smul (e (L.presheaf.map (homOfLE le_top).op (s i))) (1 : Γ(X, U.1))
    rw [← TopCat.Presheaf.Γgerm_res_apply (i := homOfLE (le_top : (U : X.Opens) ≤ ⊤))
      L.presheaf x hxU (s i), hres, hβdef, hcdef]
    exact Stacks.ModuleStalk.germ_smul L x U.1 hxU _ _
  rw [h1]
  refine Submodule.map_injective_of_injective hβ.linearEquiv.injective ?_
  rw [hβ.map_span c, hβ.map_maximalIdeal, ← hgen]
  exact congrArg _ (congrArg Set.range (funext fun i => (h2 i).symm))

/-! ### Step 4: the open `U` and the passage to generation of `𝔪_x ℒ_x` -/

/-- **The condition defining the open `U ⊂ V^d` of Step 4 of [Stacks, Tag 0FH5]**: the germs of
the sections `s_i` at `x`, together with `𝔪_x^2 ℒ_x`, generate `𝔪_x ℒ_x`.

That is the condition "the `s_i` generate `𝔪_x ℒ_x/𝔪_x^2 ℒ_x`" with the quotient eliminated: the
images of the germs generate the quotient exactly when their span and the kernel `𝔪_x^2 ℒ_x`
together generate `𝔪_x ℒ_x`. Generation over `𝒪_{X,x}` is generation over `κ(x)`, the quotient
being annihilated by `𝔪_x`.

The membership of the germs in `𝔪_x ℒ_x` — the source's `s_i ∈ V`, i.e. `s_i(x) = 0` — is a
consequence of the condition and not a separate hypothesis. -/
def GeneratesCotangentAt {ι : Type*} (s : ι → Γ(L, ⊤)) (x : X) : Prop :=
  Submodule.span (X.presheaf.stalk x) (Set.range fun i => (L.presheaf.Γgerm x).hom (s i)) ⊔
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ 2 •
        (⊤ : Submodule (X.presheaf.stalk x) (L.presheaf.stalk x)) =
    Stacks.ModuleStalk.maximalSmul L x

omit [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] in
/-- `𝔪_x^2 ℒ_x` is `𝔪_x · (𝔪_x ℒ_x)`. -/
theorem sq_maximalIdeal_smul_top (x : X) :
    IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ 2 •
        (⊤ : Submodule (X.presheaf.stalk x) (L.presheaf.stalk x)) =
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) • Stacks.ModuleStalk.maximalSmul L x := by
  rw [Stacks.ModuleStalk.maximalSmul, pow_two, Submodule.mul_smul]

/-- `𝔪_x ℒ_x` is a finitely generated `𝒪_{X,x}`-module on a locally Noetherian scheme: the stalk
`ℒ_x` is free of rank one on a stalk basis, hence a finite module over the Noetherian local
ring `𝒪_{X,x}`. -/
theorem fg_maximalSmul [IsLocallyNoetherian X] (x : X) :
    (Stacks.ModuleStalk.maximalSmul L x).FG := by
  obtain ⟨U, hxU, e, hβ⟩ := exists_affineOpen_linearEquiv_isStalkBasis L x
  have : Module.Finite (X.presheaf.stalk x) (L.presheaf.stalk x) :=
    Module.Finite.of_basis hβ.basis
  exact IsNoetherian.noetherian _

/-- **Nakayama.** On a locally Noetherian scheme, if the sections `s_i` generate
`𝔪_x ℒ_x/𝔪_x^2 ℒ_x` then their germs generate `𝔪_x ℒ_x` ([Stacks, Tag 00DV] (4)). -/
theorem span_Γgerm_eq_maximalSmul_of_generatesCotangentAt [IsLocallyNoetherian X] {ι : Type*}
    (s : ι → Γ(L, ⊤)) (x : X) (h : GeneratesCotangentAt L s x) :
    Submodule.span (X.presheaf.stalk x)
        (Set.range fun i => (L.presheaf.Γgerm x).hom (s i)) =
      Stacks.ModuleStalk.maximalSmul L x := by
  rw [GeneratesCotangentAt, sq_maximalIdeal_smul_top L x] at h
  refine le_antisymm (h ▸ le_sup_left) ?_
  exact Submodule.le_of_le_smul_of_le_jacobson_bot (fg_maximalSmul L x)
    (IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal (X.presheaf.stalk x)) bot_ne_top).ge h.ge

/-! ### Step 4: the nonemptiness of `U` -/

/-- **The nonemptiness of the open `U` of Step 4 of [Stacks, Tag 0FH5]**, from a generating family
of `𝔪_x` of the right size.

Let `V` be a set of global sections of `ℒ` — in the source, those vanishing at `x` — and suppose

* `hsurj`: **the map `V → 𝔪_x ℒ_x/𝔪_x^2 ℒ_x` is surjective**, and
* `ht`: `𝔪_x` is generated by `d` elements `t_1, …, t_d` of `𝒪_{X,x}`.

Then some `d`-tuple of members of `V` lies in `U`. -/
theorem exists_generatesCotangentAt_of_span_eq_maximalIdeal (x : X) {d : ℕ}
    (t : Fin d → X.presheaf.stalk x)
    (ht : Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (X.presheaf.stalk x))
    (V : Set Γ(L, ⊤))
    (hsurj : ∀ m ∈ Stacks.ModuleStalk.maximalSmul L x, ∃ v ∈ V,
      (L.presheaf.Γgerm x).hom v - m ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ 2 •
          (⊤ : Submodule (X.presheaf.stalk x) (L.presheaf.stalk x))) :
    ∃ s : Fin d → Γ(L, ⊤), (∀ i, s i ∈ V) ∧ GeneratesCotangentAt L s x := by
  classical
  obtain ⟨U, hxU, e, hβ⟩ := exists_affineOpen_linearEquiv_isStalkBasis L x
  set β : L.presheaf.stalk x := L.presheaf.germ U.1 x hxU (e.symm 1) with hβdef
  set K : Submodule (X.presheaf.stalk x) (L.presheaf.stalk x) :=
    IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ 2 • ⊤ with hKdef
  have hspan : Submodule.span (X.presheaf.stalk x) (Set.range fun i => t i • β) =
      Stacks.ModuleStalk.maximalSmul L x := by
    rw [← hβ.map_span t, ht, hβ.map_maximalIdeal]
  have hKle : K ≤ Stacks.ModuleStalk.maximalSmul L x := by
    rw [hKdef, sq_maximalIdeal_smul_top]
    exact Submodule.smul_le_right
  have hmem : ∀ i, t i • β ∈ Stacks.ModuleStalk.maximalSmul L x := fun i => by
    rw [← hspan]
    exact Submodule.subset_span ⟨i, rfl⟩
  choose v hvV hv using fun i => hsurj (t i • β) (hmem i)
  refine ⟨v, hvV, le_antisymm (sup_le ?_ hKle) ?_⟩
  · refine Submodule.span_le.2 ?_
    rintro - ⟨i, rfl⟩
    simpa using Submodule.add_mem _ (hKle (hv i)) (hmem i)
  · rw [← hspan]
    refine Submodule.span_le.2 ?_
    rintro - ⟨i, rfl⟩
    set N : Submodule (X.presheaf.stalk x) (L.presheaf.stalk x) :=
      Submodule.span (X.presheaf.stalk x)
        (Set.range fun j => (L.presheaf.Γgerm x).hom (v j)) ⊔ K with hNdef
    have h1 : (L.presheaf.Γgerm x).hom (v i) ∈ N :=
      Submodule.mem_sup_left (Submodule.subset_span (Set.mem_range_self i))
    have h2 : (L.presheaf.Γgerm x).hom (v i) - t i • β ∈ N := Submodule.mem_sup_right (hv i)
    simpa using Submodule.sub_mem N h1 h2

/-- **The nonemptiness of the open `U` of Step 4 of [Stacks, Tag 0FH5]**, when
`dim_{κ(x)}(𝔪_x/𝔪_x^2) = d`: if the map `V → 𝔪_x ℒ_x/𝔪_x^2 ℒ_x` is surjective, some `d`-tuple of
members of `V` lies in `U`. -/
theorem exists_generatesCotangentAt_of_finrank_cotangentSpace [IsLocallyNoetherian X] (x : X)
    {d : ℕ}
    (hd : Module.finrank (IsLocalRing.ResidueField (X.presheaf.stalk x))
      (IsLocalRing.CotangentSpace (X.presheaf.stalk x)) = d)
    (V : Set Γ(L, ⊤))
    (hsurj : ∀ m ∈ Stacks.ModuleStalk.maximalSmul L x, ∃ v ∈ V,
      (L.presheaf.Γgerm x).hom v - m ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ 2 •
          (⊤ : Submodule (X.presheaf.stalk x) (L.presheaf.stalk x))) :
    ∃ s : Fin d → Γ(L, ⊤), (∀ i, s i ∈ V) ∧ GeneratesCotangentAt L s x := by
  classical
  obtain ⟨σ, hcard, hσ⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank
      (IsLocalRing.maximalIdeal (X.presheaf.stalk x)).fg_of_isNoetherianRing
  rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace, hd] at hcard
  refine exists_generatesCotangentAt_of_span_eq_maximalIdeal L x
    (fun i => (σ.equivFin.symm (Fin.cast hcard.symm i) : X.presheaf.stalk x)) ?_ V hsurj
  rw [← hσ]
  congr 1
  refine Set.Subset.antisymm ?_ ?_
  · rintro - ⟨i, rfl⟩
    exact (σ.equivFin.symm (Fin.cast hcard.symm i)).2
  · intro z hz
    exact ⟨Fin.cast hcard (σ.equivFin ⟨z, hz⟩), by simp⟩

/-- **The nonemptiness of the open `U` of Step 4 of [Stacks, Tag 0FH5]**, when `𝒪_{X,x}` is a
regular local ring of dimension `d`: if the map `V → 𝔪_x ℒ_x/𝔪_x^2 ℒ_x` is surjective, some
`d`-tuple of members of `V` lies in `U`. -/
theorem exists_generatesCotangentAt_of_isRegularLocalRing [IsLocallyNoetherian X] (x : X)
    [IsRegularLocalRing (X.presheaf.stalk x)] {d : ℕ}
    (hdim : ringKrullDim (X.presheaf.stalk x) = (d : WithBot ℕ∞))
    (V : Set Γ(L, ⊤))
    (hsurj : ∀ m ∈ Stacks.ModuleStalk.maximalSmul L x, ∃ v ∈ V,
      (L.presheaf.Γgerm x).hom v - m ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ 2 •
          (⊤ : Submodule (X.presheaf.stalk x) (L.presheaf.stalk x))) :
    ∃ s : Fin d → Γ(L, ⊤), (∀ i, s i ∈ V) ∧ GeneratesCotangentAt L s x :=
  exists_generatesCotangentAt_of_finrank_cotangentSpace L x
    (by
      have h := (IsRegularLocalRing.iff_finrank_cotangentSpace (X.presheaf.stalk x)).mp ‹_›
      rw [hdim] at h
      exact_mod_cast h) V hsurj

/-! ### Step 4 composed with Step 5 -/

/-- **`[H_1 ∩ … ∩ H_d]_k = [x]_k + [Z]_k` for a tuple in the open `U` of Step 4 of
[Stacks, Tag 0FH5].** At a closed point of a Noetherian scheme, a family of global sections of an
invertible `ℒ` generating `𝔪_x ℒ_x/𝔪_x^2 ℒ_x` cuts out a closed subscheme whose fundamental
cycle is the prime cycle of the reduced point `x`, with multiplicity one, plus the cycle of a
residual closed subscheme supported away from `x`. -/
theorem exists_cycleAssociatedToClosedSubscheme_eq_add_of_generatesCotangentAt
    (C : ChowSituation.{u}) (p : X ⟶ C.S) [LocallyOfFiniteType p] [IsNoetherian X] {ι : Type*}
    (s : ι → Γ(L, ⊤)) (x : X) (hx : IsClosed ({x} : Set X))
    (hU : GeneratesCotangentAt L s x) (k : ℤ) :
    ∃ (Z : Scheme.{u}) (ι₂ : Z ⟶ X) (_ : IsClosedImmersion ι₂),
      Set.range ι₂.base = ((⨆ i, zeroScheme X L (s i)).support : Set X) \ {x} ∧
        cycleAssociatedToClosedSubscheme C p (⨆ i, zeroScheme X L (s i)).subschemeι k =
          cycleAssociatedToClosedSubscheme C p (integralComponentAt x).subschemeι k +
            cycleAssociatedToClosedSubscheme C p ι₂ k :=
  exists_cycleAssociatedToClosedSubscheme_eq_add_integralComponentAt C p _ x hx
    (stalk_iSup_zeroScheme_eq_maximalIdeal L s x
      (span_Γgerm_eq_maximalSmul_of_generatesCotangentAt L s x hU)) k

/-- **`[H_1 ∩ … ∩ H_d]_k = [x]_k + [Z]_k` in the Chow group `A_k(X)`** for a tuple in the open `U`
of Step 4 of [Stacks, Tag 0FH5]. -/
theorem exists_mk_cycleAssociatedToClosedSubscheme_eq_add_of_generatesCotangentAt
    (C : ChowSituation.{u}) (p : X ⟶ C.S) [LocallyOfFiniteType p] [IsNoetherian X] {ι : Type*}
    (s : ι → Γ(L, ⊤)) (x : X) (hx : IsClosed ({x} : Set X))
    (hU : GeneratesCotangentAt L s x) (k : ℤ) :
    ∃ (Z : Scheme.{u}) (ι₂ : Z ⟶ X) (_ : IsClosedImmersion ι₂),
      Set.range ι₂.base = ((⨆ i, zeroScheme X L (s i)).support : Set X) \ {x} ∧
        QuotientAddGroup.mk' (rationalEquivalences C p k)
            (cycleAssociatedToClosedSubscheme C p (⨆ i, zeroScheme X L (s i)).subschemeι k) =
          QuotientAddGroup.mk' (rationalEquivalences C p k)
              (cycleAssociatedToClosedSubscheme C p (integralComponentAt x).subschemeι k) +
            QuotientAddGroup.mk' (rationalEquivalences C p k)
              (cycleAssociatedToClosedSubscheme C p ι₂ k) :=
  exists_mk_cycleAssociatedToClosedSubscheme_eq_add_integralComponentAt C p _ x hx
    (stalk_iSup_zeroScheme_eq_maximalIdeal L s x
      (span_Γgerm_eq_maximalSmul_of_generatesCotangentAt L s x hU)) k

end Stacks.Chow

end
