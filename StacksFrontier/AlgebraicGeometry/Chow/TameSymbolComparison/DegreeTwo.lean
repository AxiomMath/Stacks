module

public import StacksFrontier.AlgebraicGeometry.Chow.TameSymbolComparison.SymbolOnNormalization
public import StacksFrontier.AlgebraicGeometry.Chow.TameSymbolGeneral.DegreeOne
public import StacksFrontier.AlgebraicGeometry.Chow.Symbols.MilnorBoundary
public import StacksFrontier.AlgebraicGeometry.Chow.RationalEquivalence.MilnorKSymbolTransport

/-!
# In degree two the general tame symbol is the tame symbol of Stacks 02Q1

Let `A` be a Noetherian local domain of dimension one with fraction field `F` and residue field
`κ`, whose normalization `A'` is a finite `A`-module (for instance `A` Nagata, in particular
excellent). Stacks 0EAY extends the tame symbol from discrete valuation rings to `A` by
normalization and norm, `∂_A = ∑_𝔫 N_{κ(𝔫)/κ} ∘ ∂_{A'_𝔫}` (`Stacks.Chow.oneDimTameSymbol`).
Section 42.5 and Stacks 02Q1 define a tame symbol `d_A : F^* × F^* → κ^*` directly, as a periodic
determinant. This file proves that the two agree in degree two:

`∂_A {f, g} = {d_A(f, g)}` (`Stacks.Chow.oneDimTameSymbol_one_milnorKTwoPureSymbol`),

that is, `d_A(f, g) = ∏_𝔫 N_{κ(𝔫)/κ}(∂_{A'_𝔫}(f, g))`; equivalently `∂_A : K^M_2(F) → K^M_1(κ)`
is the descent `Stacks.Chow.milnorKTwoTameSymbol` of `d_A` to Milnor K-theory
(`Stacks.Chow.oneDimTameSymbol_one_eq_milnorKTwoTameSymbol`).

## The argument

Both sides are bimultiplicative on `F^*`, so it suffices to compare them on generators. The group
`F^*` is generated by the units of `A'` and the elements `t_𝔪` of
`Stacks.Chow.normalizationUniformizer` (`Stacks.Chow.mem_closure_normalizationGenerators`,
together with `F = Frac(A)`). On the nonzero elements of `A'`, `d_A` is the finite-algebra symbol
`d^A_{A'}` (`Stacks.Chow.tameSymbol_eq_normalizationSymbol`, from Stacks 02Q4), whose values on
the generators are norms from the residue fields `κ(𝔪) = A'/t_𝔪 A'`
(`Stacks.Chow.normalizationSymbol_unit_uniformizer` and its companions). On the other side the
tame symbol of the discrete valuation ring `A'_𝔪` is
`(-1)^{v(f)v(g)} f^{v(g)}/g^{v(f)} mod 𝔪` (`Stacks.Chow.dvrMilnorTameSymbol_degree_two`), and the
norm in degree one is the field norm (`Stacks.Chow.milnorKNormRing_milnorKSymbol`); the two sets
of values agree.

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
* [Stacks Project, Tag 02Q1](https://stacks.math.columbia.edu/tag/02Q1)
-/

@[expose] public noncomputable section

open IsLocalRing IsDiscreteValuationRing Stacks.Normalization AlgebraicGeometry

universe u

namespace Stacks.Chow

/-! ### Milnor K-theory in degrees one and two -/

/-- A finite sum of degree-one symbols is the symbol of the product. -/
theorem sum_milnorKSymbol {k : Type u} [Field k] {ι : Type*} (s : Finset ι) (c : ι → kˣ) :
    ∑ i ∈ s, milnorKSymbol k (c i) = milnorKSymbol k (∏ i ∈ s, c i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.prod_insert ha, ih, milnorKSymbol_mul]

/-- A class of `K^M_1(k)` whose image in the Milnor K-ring is the symbol `{c}` corresponds to
`c ∈ k^*`. -/
theorem milnorKTheoryOneAddEquiv_of_coe_eq {k : Type u} [Field k] (z : MilnorKTheory k 1)
    (c : kˣ) (hz : (z : MilnorKRing k) = milnorKSymbol k c) :
    milnorKTheoryOneAddEquiv k z = Additive.ofMul c := by
  rw [← AddEquiv.eq_symm_apply]
  exact Subtype.ext (hz.trans (coe_milnorKTheoryOneAddEquiv_symm_ofMul k c).symm)

/-- The pure symbol `{f, g}` is additive in its first entry. -/
theorem milnorKTwoPureSymbol_mul_left (k : Type u) [Field k] (f f' g : kˣ) :
    milnorKTwoPureSymbol k (f * f') g =
      milnorKTwoPureSymbol k f g + milnorKTwoPureSymbol k f' g := by
  simp only [milnorKTwoPureSymbol, ofMul_mul, TensorProduct.add_tmul, Submodule.Quotient.mk_add,
    map_add]

/-- The pure symbol `{f, g}` is additive in its second entry. -/
theorem milnorKTwoPureSymbol_mul_right (k : Type u) [Field k] (f g g' : kˣ) :
    milnorKTwoPureSymbol k f (g * g') =
      milnorKTwoPureSymbol k f g + milnorKTwoPureSymbol k f g' := by
  simp only [milnorKTwoPureSymbol, ofMul_mul, TensorProduct.tmul_add, Submodule.Quotient.mk_add,
    map_add]

/-- The class of the pure symbol in the Milnor K-ring is the product of the two symbols. -/
theorem coe_milnorKTwoPureSymbol_eq_mul (k : Type u) [Field k] (f g : kˣ) :
    ((milnorKTwoPureSymbol k f g : MilnorKTheory k 2) : MilnorKRing k) =
      milnorKSymbol k f * milnorKSymbol k g := by
  rw [coe_milnorKTwoPureSymbol, map_mul, milnorKSymbol_eq_mk', milnorKSymbol_eq_mk']

/-! ### The general tame symbol in degree two -/

attribute [local instance] SemilocalDvrFamily.finite_index SemilocalDvrFamily.commRing
  SemilocalDvrFamily.isDomain SemilocalDvrFamily.isDiscreteValuationRing
  SemilocalDvrFamily.algebraBase SemilocalDvrFamily.isLocalHom
  SemilocalDvrFamily.algebraFractionField SemilocalDvrFamily.isScalarTower
  SemilocalDvrFamily.isFractionRing SemilocalDvrFamily.moduleFiniteResidueField

variable {A : Type u} [CommRing A] [IsDomain A] [IsLocalRing A] [IsNoetherianRing A]
  {F : Type u} [Field F] [Algebra A F] [IsFractionRing A F]

/-- The tame symbol `(-1)^{v(f)v(g)} f^{v(g)}/g^{v(f)} mod 𝔪` of the discrete valuation ring
`A'_𝔪` of the normalization, at the uniformizer the general tame symbol uses. -/
def normalizationDvrSymbol [Ring.DimensionLEOne A] (hA : maximalIdeal A ≠ ⊥)
    (m : MaximalSpectrum ↥(integralClosure A F)) (f g : Fˣ) :
    (ResidueField (Localization.AtPrime m.asIdeal))ˣ :=
  letI := localizationAlgebra A F m.asIdeal
  haveI := isFractionRing_localization A F m.asIdeal
  haveI := isDiscreteValuationRing_localization A F hA m.asIdeal
  letI hϖ := (exists_irreducible (Localization.AtPrime m.asIdeal)).choose_spec
  (-1) ^ (dvrFracOrd hϖ f * dvrFracOrd hϖ g) * dvrFracUnitPart hϖ f ^ dvrFracOrd hϖ g *
    (dvrFracUnitPart hϖ g ^ dvrFracOrd hϖ f)⁻¹

/-- The norm to `κ` of the tame symbol of `A'_𝔪`. -/
def normalizationNormFactor [Ring.DimensionLEOne A] (hA : maximalIdeal A ≠ ⊥)
    (m : MaximalSpectrum ↥(integralClosure A F)) (f g : Fˣ) : (ResidueField A)ˣ :=
  haveI := isLocalHom_algebraMap_localization A F m.asIdeal
  Units.map (Algebra.norm (ResidueField A) (S := ResidueField (Localization.AtPrime m.asIdeal)))
    (normalizationDvrSymbol hA m f g)

/-- The product over the maximal ideals of the normalization of the norms of the tame symbols of
the `A'_𝔪`. -/
def normalizationNormProduct [Ring.DimensionLEOne A] (hA : maximalIdeal A ≠ ⊥) (f g : Fˣ) :
    (ResidueField A)ˣ :=
  haveI := finite_maximalSpectrum_integralClosure A F
  letI := Fintype.ofFinite (MaximalSpectrum ↥(integralClosure A F))
  ∏ m, normalizationNormFactor hA m f g

/-- **The general tame symbol on a pure symbol `{f, g}`**: the symbol of the product over the
maximal ideals of the normalization of the norms of the tame symbols of the `A'_𝔪`. -/
theorem coe_oneDimTameSymbol_one_milnorKTwoPureSymbol [Ring.DimensionLEOne A]
    (hdim : ringKrullDim A = 1) (f g : Fˣ) :
    (oneDimTameSymbol A F hdim 1 (milnorKTwoPureSymbol F f g) :
        MilnorKRing (ResidueField A)) =
      milnorKSymbol (ResidueField A)
        (normalizationNormProduct (maximalIdeal_ne_bot_of_ringKrullDim_eq_one A hdim) f g) := by
  let := Fintype.ofFinite (normalizationDvrFamily A F hdim).Index
  rw [oneDimTameSymbol, SemilocalDvrFamily.coe_tameSymbol, coe_milnorKTwoPureSymbol_eq_mul,
    SemilocalDvrFamily.tameShift_apply, normalizationNormProduct, ← sum_milnorKSymbol]
  refine Finset.sum_congr rfl fun m _ ↦ ?_
  rw [SemilocalDvrFamily.tameShiftAt_apply, dvrMilnorTameSymbol_degree_two]
  exact milnorKNormRing_milnorKSymbol _

/-- The general tame symbol in degree two, read as a pairing `F^* × F^* → κ^*`. -/
def oneDimTamePairing (hdim : ringKrullDim A = 1) : Fˣ →* Fˣ →* (ResidueField A)ˣ where
  toFun f :=
    { toFun := fun g ↦ Additive.toMul (milnorKTheoryOneAddEquiv (ResidueField A)
        (oneDimTameSymbol A F hdim 1 (milnorKTwoPureSymbol F f g)))
      map_one' := by
        rw [show milnorKTwoPureSymbol F f 1 = 0 from by
          have h := milnorKTwoPureSymbol_mul_right F f 1 1
          rw [mul_one] at h
          exact (add_eq_left.mp h.symm)]
        simp
      map_mul' := fun g g' ↦ by
        rw [milnorKTwoPureSymbol_mul_right, map_add, map_add]
        rfl }
  map_one' := by
    refine MonoidHom.ext fun g ↦ ?_
    change Additive.toMul (milnorKTheoryOneAddEquiv (ResidueField A)
      (oneDimTameSymbol A F hdim 1 (milnorKTwoPureSymbol F 1 g))) = 1
    rw [show milnorKTwoPureSymbol F 1 g = 0 from by
      have h := milnorKTwoPureSymbol_mul_left F 1 1 g
      rw [mul_one] at h
      exact (add_eq_left.mp h.symm)]
    simp
  map_mul' f f' := by
    refine MonoidHom.ext fun g ↦ ?_
    change Additive.toMul (milnorKTheoryOneAddEquiv (ResidueField A)
      (oneDimTameSymbol A F hdim 1 (milnorKTwoPureSymbol F (f * f') g))) = _
    rw [milnorKTwoPureSymbol_mul_left, map_add, map_add]
    rfl

/-- The pairing `oneDimTamePairing` is the product over the maximal ideals of the normalization of
the norms of the tame symbols of the `A'_𝔪`. -/
theorem oneDimTamePairing_apply [Ring.DimensionLEOne A] (hdim : ringKrullDim A = 1) (f g : Fˣ) :
    oneDimTamePairing hdim f g =
      normalizationNormProduct (maximalIdeal_ne_bot_of_ringKrullDim_eq_one A hdim) f g := by
  change Additive.toMul (milnorKTheoryOneAddEquiv (ResidueField A) _) = _
  rw [milnorKTheoryOneAddEquiv_of_coe_eq _ _
    (coe_oneDimTameSymbol_one_milnorKTwoPureSymbol hdim f g)]
  rfl

/-- The tame symbol of Stacks 02Q1, read as a pairing `F^* × F^* → κ^*`. -/
def tameSymbolPairingHom (hdim : ringKrullDim A = 1) : Fˣ →* Fˣ →* (ResidueField A)ˣ :=
  MonoidHom.mk' (fun f ↦ MonoidHom.mk' (fun g ↦ tameSymbol (K := F) hdim f g)
    fun g g' ↦ (tameSymbol (K := F) hdim).map_mul_right f g g')
    fun f f' ↦ MonoidHom.ext fun g ↦ (tameSymbol (K := F) hdim).map_mul_left f f' g

/-- The pairing `tameSymbolPairingHom` evaluates to the tame symbol `d_A(f, g)`. -/
theorem tameSymbolPairingHom_apply (hdim : ringKrullDim A = 1) (f g : Fˣ) :
    tameSymbolPairingHom hdim f g = tameSymbol (K := F) hdim f g := rfl


/-! ### The values on the generators -/

section Generators

variable [Ring.DimensionLEOne A] (hA : maximalIdeal A ≠ ⊥)

/-- The valuation at `𝔪` used by the tame symbol of `A'_𝔪`. -/
abbrev normalizationVal (m : MaximalSpectrum ↥(integralClosure A F)) (f : Fˣ) : ℤ :=
  normalizationOrd A F hA m f

/-- The unit part at `𝔪` used by the tame symbol of `A'_𝔪`. -/
def normalizationUnitPart (m : MaximalSpectrum ↥(integralClosure A F)) (f : Fˣ) :
    (ResidueField (Localization.AtPrime m.asIdeal))ˣ :=
  letI := localizationAlgebra A F m.asIdeal
  haveI := isFractionRing_localization A F m.asIdeal
  haveI := isDiscreteValuationRing_localization A F hA m.asIdeal
  dvrFracUnitPart (exists_irreducible (Localization.AtPrime m.asIdeal)).choose_spec f

/-- The tame symbol of `A'_𝔪` in terms of `normalizationVal` and `normalizationUnitPart`. -/
theorem normalizationDvrSymbol_eq (m : MaximalSpectrum ↥(integralClosure A F)) (f g : Fˣ) :
    normalizationDvrSymbol hA m f g =
      (-1) ^ (normalizationVal hA m f * normalizationVal hA m g) *
        normalizationUnitPart hA m f ^ normalizationVal hA m g *
        (normalizationUnitPart hA m g ^ normalizationVal hA m f)⁻¹ := rfl

/-- The tame symbol of `A'_𝔪` of two elements of valuation zero is `1`. -/
theorem normalizationDvrSymbol_of_zero_zero (m : MaximalSpectrum ↥(integralClosure A F))
    {f g : Fˣ} (hf : normalizationVal hA m f = 0) (hg : normalizationVal hA m g = 0) :
    normalizationDvrSymbol hA m f g = 1 := by
  rw [normalizationDvrSymbol_eq, hf, hg]
  simp

/-- The tame symbol of `A'_𝔪` of `f` of valuation zero and `g` of valuation one is the unit part
of `f`. -/
theorem normalizationDvrSymbol_of_zero_one (m : MaximalSpectrum ↥(integralClosure A F))
    {f g : Fˣ} (hf : normalizationVal hA m f = 0) (hg : normalizationVal hA m g = 1) :
    normalizationDvrSymbol hA m f g = normalizationUnitPart hA m f := by
  rw [normalizationDvrSymbol_eq, hf, hg]
  simp

/-- The tame symbol of `A'_𝔪` of `f` of valuation one and `g` of valuation zero is the inverse of
the unit part of `g`. -/
theorem normalizationDvrSymbol_of_one_zero (m : MaximalSpectrum ↥(integralClosure A F))
    {f g : Fˣ} (hf : normalizationVal hA m f = 1) (hg : normalizationVal hA m g = 0) :
    normalizationDvrSymbol hA m f g = (normalizationUnitPart hA m g)⁻¹ := by
  rw [normalizationDvrSymbol_eq, hf, hg]
  simp

/-- The tame symbol of `A'_𝔪` of an element of valuation one with itself is `-1`. -/
theorem normalizationDvrSymbol_self_of_one (m : MaximalSpectrum ↥(integralClosure A F))
    {f : Fˣ} (hf : normalizationVal hA m f = 1) :
    normalizationDvrSymbol hA m f f = -1 := by
  rw [normalizationDvrSymbol_eq, hf]
  simp

/-- An element of the normalization which is a unit of `A'_𝔪` has valuation zero there, and unit
part its residue. -/
theorem normalizationVal_of_isUnit (m : MaximalSpectrum ↥(integralClosure A F))
    (x : nonZeroDivisors ↥(integralClosure A F))
    (hx : IsUnit (algebraMap _ (Localization.AtPrime m.asIdeal) (x : ↥(integralClosure A F)))) :
    normalizationVal hA m (normalizationFractionUnit x) = 0 ∧
      (normalizationUnitPart hA m (normalizationFractionUnit x) :
        ResidueField (Localization.AtPrime m.asIdeal)) =
        residue _ (algebraMap _ (Localization.AtPrime m.asIdeal) (x : ↥(integralClosure A F))) := by
  let := localizationAlgebra A F m.asIdeal
  have := isFractionRing_localization A F m.asIdeal
  have := isDiscreteValuationRing_localization A F hA m.asIdeal
  have := isScalarTower_localization A F m.asIdeal
  have hval : (normalizationFractionUnit x : F) =
      algebraMap (Localization.AtPrime m.asIdeal) F (hx.unit : Localization.AtPrime m.asIdeal) *
        (algebraMap (Localization.AtPrime m.asIdeal) F
          (exists_irreducible (Localization.AtPrime m.asIdeal)).choose) ^ (0 : ℤ) := by
    rw [zpow_zero, mul_one, IsUnit.unit_spec, ← IsScalarTower.algebraMap_apply,
      coe_normalizationFractionUnit]
    rfl
  exact ⟨dvrFracOrd_eq_of_eq _ hval, by
    rw [normalizationUnitPart, dvrFracUnitPart_eq_of_eq _ hval]; rfl⟩

/-- The valuation of `t_𝔪` at `𝔪'` is `1` if `𝔪' = 𝔪` and `0` otherwise. -/
theorem normalizationVal_normalizationUniformizer (m m' : MaximalSpectrum ↥(integralClosure A F)) :
    open Classical in
    normalizationVal hA m' (normalizationFractionUnit (normalizationUniformizerNZD hA m)) =
      if m' = m then 1 else 0 := by
  have he : normalizationFractionUnit (normalizationUniformizerNZD hA m) =
      normalizationUniformizerUnit A F hA m :=
    Units.ext (coe_normalizationFractionUnit _)
  rw [normalizationVal, he]
  exact normalizationOrd_normalizationUniformizerUnit A F hA m m'

/-- `t_𝔪` is a unit of `A'_𝔪'` for `𝔪' ≠ 𝔪`. -/
theorem isUnit_algebraMap_normalizationUniformizer
    {m m' : MaximalSpectrum ↥(integralClosure A F)} (h : m' ≠ m) :
    IsUnit (algebraMap _ (Localization.AtPrime m'.asIdeal) (normalizationUniformizer A F hA m)) :=
  IsLocalization.map_units (Localization.AtPrime m'.asIdeal)
    (⟨_, (exists_normalizationUniformizer A F hA m).choose_spec.2 m' h⟩ : m'.asIdeal.primeCompl)

omit [IsDomain A] [IsLocalRing A] [IsNoetherianRing A] [IsFractionRing A F]
  [Ring.DimensionLEOne A] in
/-- A unit of the normalization is a unit of every `A'_𝔪`. -/
theorem isUnit_algebraMap_of_isUnit (m : MaximalSpectrum ↥(integralClosure A F))
    {x : ↥(integralClosure A F)} (hx : IsUnit x) :
    IsUnit (algebraMap _ (Localization.AtPrime m.asIdeal) x) :=
  hx.map _

/-- The norm of the tame symbol of `A'_𝔪` of two elements of valuation zero is `1`. -/
private theorem normalizationNormFactor_eq_one_of_val_eq_zero
    (m : MaximalSpectrum ↥(integralClosure A F)) {f g : Fˣ}
    (hf : normalizationVal hA m f = 0) (hg : normalizationVal hA m g = 0) :
    normalizationNormFactor hA m f g = 1 := by
  rw [normalizationNormFactor, normalizationDvrSymbol_of_zero_zero hA m hf hg, map_one]

/-- A unit of the normalization has valuation zero at every `𝔪`, and unit part its residue. -/
private theorem normalizationVal_of_isUnit_nzd (m : MaximalSpectrum ↥(integralClosure A F))
    {u : nonZeroDivisors ↥(integralClosure A F)} (hu : IsUnit (u : ↥(integralClosure A F))) :
    normalizationVal hA m (normalizationFractionUnit u) = 0 ∧
      (normalizationUnitPart hA m (normalizationFractionUnit u) :
        ResidueField (Localization.AtPrime m.asIdeal)) =
        residue _ (algebraMap _ (Localization.AtPrime m.asIdeal) (u : ↥(integralClosure A F))) :=
  normalizationVal_of_isUnit hA m u (isUnit_algebraMap_of_isUnit m hu)

/-- The valuation of `t_𝔫` at `𝔫` is `1`. -/
private theorem normalizationVal_uniformizer_self (n : MaximalSpectrum ↥(integralClosure A F)) :
    normalizationVal hA n (normalizationFractionUnit (normalizationUniformizerNZD hA n)) = 1 := by
  rw [normalizationVal_normalizationUniformizer, ite_eq_left rfl]

/-- The valuation of `t_𝔫` at `𝔪 ≠ 𝔫` is `0`. -/
private theorem normalizationVal_uniformizer_of_ne {m n : MaximalSpectrum ↥(integralClosure A F)}
    (h : m ≠ n) :
    normalizationVal hA m (normalizationFractionUnit (normalizationUniformizerNZD hA n)) = 0 := by
  rw [normalizationVal_normalizationUniformizer, ite_eq_right h]

/-- If all other factors are `1`, the norm product is the factor at `𝔫`. -/
private theorem normalizationNormProduct_eq_factor (n : MaximalSpectrum ↥(integralClosure A F))
    (f g : Fˣ) (h : ∀ m, m ≠ n → normalizationNormFactor hA m f g = 1) :
    normalizationNormProduct hA f g = normalizationNormFactor hA n f g := by
  classical
  have := finite_maximalSpectrum_integralClosure A F
  let := Fintype.ofFinite (MaximalSpectrum ↥(integralClosure A F))
  exact Finset.prod_eq_single n (fun m _ hm ↦ h m hm) fun h ↦ absurd (Finset.mem_univ n) h

end Generators


/-! ### Comparison on generators -/

/-- **Two bimultiplicative pairings agreeing on a generating set agree.** -/
theorem pairing_eq_of_closure_eq_top {M N : Type*} [CommMonoid M] [CommGroup N]
    (P Q : M → M → N) (hPl : ∀ x y z, P (x * y) z = P x z * P y z)
    (hPr : ∀ x y z, P x (y * z) = P x y * P x z)
    (hQl : ∀ x y z, Q (x * y) z = Q x z * Q y z)
    (hQr : ∀ x y z, Q x (y * z) = Q x y * Q x z)
    (s : Set M) (hs : ∀ x, x ∈ Submonoid.closure s) (h : ∀ a ∈ s, ∀ b ∈ s, P a b = Q a b)
    (x y : M) : P x y = Q x y := by
  have one_of : ∀ c : N, c = c * c → c = 1 := fun c h ↦ left_eq_mul.mp h
  have hP1 : ∀ a, P a 1 = 1 := fun a ↦ one_of _ (by simpa using hPr a 1 1)
  have hQ1 : ∀ a, Q a 1 = 1 := fun a ↦ one_of _ (by simpa using hQr a 1 1)
  have hP1' : ∀ a, P 1 a = 1 := fun a ↦ one_of _ (by simpa using hPl 1 1 a)
  have hQ1' : ∀ a, Q 1 a = 1 := fun a ↦ one_of _ (by simpa using hQl 1 1 a)
  have hgen : ∀ a ∈ s, ∀ y, P a y = Q a y := fun a ha y ↦ by
    induction (hs y) using Submonoid.closure_induction with
    | mem b hb => exact h a ha b hb
    | one => rw [hP1, hQ1]
    | mul b c _ _ hb hc => rw [hPr, hQr, hb, hc]
  induction (hs x) using Submonoid.closure_induction with
  | mem a ha => exact hgen a ha y
  | one => rw [hP1', hQ1']
  | mul b c _ _ hb hc => rw [hPl, hQl, hb, hc]

section Comparison

variable [Ring.DimensionLEOne A] [Module.Finite A ↥(integralClosure A F)]

/-- The generators of the nonzero elements of the normalization: its units and the `t_𝔪`. -/
def normalizationGenerators (hA : maximalIdeal A ≠ ⊥) :
    Set (nonZeroDivisors ↥(integralClosure A F)) :=
  {x | IsUnit (x : ↥(integralClosure A F))} ∪ Set.range (normalizationUniformizerNZD hA)

omit [Module.Finite A ↥(integralClosure A F)] in
/-- Every nonzero element of the normalization lies in the submonoid generated by its units and
the `t_𝔪`. -/
theorem mem_closure_normalizationGenerators' (hA : maximalIdeal A ≠ ⊥)
    (x : nonZeroDivisors ↥(integralClosure A F)) :
    x ∈ Submonoid.closure (normalizationGenerators (F := F) hA) := by
  obtain ⟨x, hx⟩ := x
  have key := mem_closure_normalizationGenerators A F hA x (nonZeroDivisors.ne_zero hx)
  induction key using Submonoid.closure_induction with
  | mem s hs =>
    refine Submonoid.subset_closure ?_
    rcases hs with hs | ⟨m, rfl⟩
    · exact Or.inl hs
    · exact Or.inr ⟨m, rfl⟩
  | one => exact one_mem _
  | mul a b _ _ ha hb =>
    have ha0 : a ∈ nonZeroDivisors ↥(integralClosure A F) :=
      mem_nonZeroDivisors_of_ne_zero (left_ne_zero_of_mul (nonZeroDivisors.ne_zero hx))
    have hb0 : b ∈ nonZeroDivisors ↥(integralClosure A F) :=
      mem_nonZeroDivisors_of_ne_zero (right_ne_zero_of_mul (nonZeroDivisors.ne_zero hx))
    exact mul_mem (ha ha0) (hb hb0)

variable (hdim : ringKrullDim A = 1)

local notation "hA₀" => maximalIdeal_ne_bot_of_ringKrullDim_eq_one A hdim

omit [Module.Finite A ↥(integralClosure A F)] in
/-- The norm of the tame symbol of `A'_𝔪` of two units of the normalization is `1`. -/
theorem normalizationNormFactor_unit_unit (m : MaximalSpectrum ↥(integralClosure A F))
    (u v : nonZeroDivisors ↥(integralClosure A F)) (hu : IsUnit (u : ↥(integralClosure A F)))
    (hv : IsUnit (v : ↥(integralClosure A F))) :
    normalizationNormFactor hA₀ m (normalizationFractionUnit u)
      (normalizationFractionUnit v) = 1 :=
  normalizationNormFactor_eq_one_of_val_eq_zero hA₀ m
    (normalizationVal_of_isUnit hA₀ m u (isUnit_algebraMap_of_isUnit m hu)).1
    (normalizationVal_of_isUnit hA₀ m v (isUnit_algebraMap_of_isUnit m hv)).1

omit [Module.Finite A ↥(integralClosure A F)] in
/-- The norm of the residue of a unit. -/
theorem coe_normalizationNormFactor (m : MaximalSpectrum ↥(integralClosure A F)) (f g : Fˣ) :
    haveI := isLocalHom_algebraMap_localization A F m.asIdeal
    (normalizationNormFactor hA₀ m f g : ResidueField A) =
      Algebra.norm (ResidueField A) (normalizationDvrSymbol hA₀ m f g :
        ResidueField (Localization.AtPrime m.asIdeal)) := rfl

omit [Module.Finite A ↥(integralClosure A F)] in
/-- `normalizationNormProduct` unfolded as a product over the maximal ideals of the
normalization. -/
theorem normalizationNormProduct_eq (f g : Fˣ) :
    haveI := finite_maximalSpectrum_integralClosure A F
    letI := Fintype.ofFinite (MaximalSpectrum ↥(integralClosure A F))
    normalizationNormProduct hA₀ f g = ∏ m, normalizationNormFactor hA₀ m f g := rfl

/-- `P = Q` on two units. -/
theorem normalizationSymbol_eq_normProduct_unit_unit (u v : nonZeroDivisors ↥(integralClosure A F))
    (hu : IsUnit (u : ↥(integralClosure A F))) (hv : IsUnit (v : ↥(integralClosure A F))) :
    normalizationSymbol hdim u v =
      normalizationNormProduct hA₀ (normalizationFractionUnit u) (normalizationFractionUnit v) := by
  classical
  have := finite_maximalSpectrum_integralClosure A F
  let := Fintype.ofFinite (MaximalSpectrum ↥(integralClosure A F))
  rw [normalizationSymbol_unit_unit hdim u v hu hv, normalizationNormProduct_eq hdim]
  exact (Finset.prod_eq_one fun m _ ↦ normalizationNormFactor_unit_unit hdim m u v hu hv).symm

/-- `P = Q` on a unit and `t_𝔫`. -/
theorem normalizationSymbol_eq_normProduct_unit_uniformizer
    (u : nonZeroDivisors ↥(integralClosure A F)) (hu : IsUnit (u : ↥(integralClosure A F)))
    (n : MaximalSpectrum ↥(integralClosure A F)) :
    normalizationSymbol hdim u (normalizationUniformizerNZD hA₀ n) =
      normalizationNormProduct hA₀ (normalizationFractionUnit u)
        (normalizationFractionUnit (normalizationUniformizerNZD hA₀ n)) := by
  rw [normalizationNormProduct_eq_factor hA₀ n _ _ fun m hmn ↦
    normalizationNormFactor_eq_one_of_val_eq_zero hA₀ m
      (normalizationVal_of_isUnit_nzd hA₀ m hu).1 (normalizationVal_uniformizer_of_ne hA₀ hmn)]
  refine Units.ext ?_
  rw [normalizationSymbol_unit_uniformizer hA₀ hdim n u hu, coe_normalizationNormFactor hdim,
    normalizationDvrSymbol_of_zero_one hA₀ n (normalizationVal_of_isUnit_nzd hA₀ n hu).1
      (normalizationVal_uniformizer_self hA₀ n),
    (normalizationVal_of_isUnit_nzd hA₀ n hu).2]

/-- `P = Q` on `t_𝔫` and a unit. -/
theorem normalizationSymbol_eq_normProduct_uniformizer_unit
    (n : MaximalSpectrum ↥(integralClosure A F))
    (u : nonZeroDivisors ↥(integralClosure A F)) (hu : IsUnit (u : ↥(integralClosure A F))) :
    normalizationSymbol hdim (normalizationUniformizerNZD hA₀ n) u =
      normalizationNormProduct hA₀ (normalizationFractionUnit (normalizationUniformizerNZD hA₀ n))
        (normalizationFractionUnit u) := by
  rw [normalizationNormProduct_eq_factor hA₀ n _ _ fun m hmn ↦
    normalizationNormFactor_eq_one_of_val_eq_zero hA₀ m
      (normalizationVal_uniformizer_of_ne hA₀ hmn) (normalizationVal_of_isUnit_nzd hA₀ m hu).1]
  refine Units.ext ?_
  rw [normalizationSymbol_uniformizer_unit hA₀ hdim n u hu, normalizationNormFactor,
    normalizationDvrSymbol_of_one_zero hA₀ n (normalizationVal_uniformizer_self hA₀ n)
      (normalizationVal_of_isUnit_nzd hA₀ n hu).1,
    map_inv, Units.val_inv_eq_inv_val, Units.coe_map,
    (normalizationVal_of_isUnit_nzd hA₀ n hu).2]

/-- `P = Q` on `t_𝔫` and itself. -/
theorem normalizationSymbol_eq_normProduct_uniformizer_self
    (n : MaximalSpectrum ↥(integralClosure A F)) :
    normalizationSymbol hdim (normalizationUniformizerNZD hA₀ n)
        (normalizationUniformizerNZD hA₀ n) =
      normalizationNormProduct hA₀ (normalizationFractionUnit (normalizationUniformizerNZD hA₀ n))
        (normalizationFractionUnit (normalizationUniformizerNZD hA₀ n)) := by
  have := isLocalHom_algebraMap_localization A F n.asIdeal
  have := module_finite_residueField_localization A F n.asIdeal
  have : Module.Free (ResidueField A) (ResidueField (Localization.AtPrime n.asIdeal)) :=
    Module.Free.of_divisionRing _ _
  rw [normalizationNormProduct_eq_factor hA₀ n _ _ fun m hmn ↦
    normalizationNormFactor_eq_one_of_val_eq_zero hA₀ m
      (normalizationVal_uniformizer_of_ne hA₀ hmn) (normalizationVal_uniformizer_of_ne hA₀ hmn)]
  refine Units.ext ?_
  rw [normalizationSymbol_uniformizer_self hA₀ hdim n, coe_normalizationNormFactor hdim,
    normalizationDvrSymbol_self_of_one hA₀ n (normalizationVal_uniformizer_self hA₀ n),
    Units.val_neg, Units.val_one,
    show (-1 : ResidueField (Localization.AtPrime n.asIdeal)) =
      algebraMap (ResidueField A) _ (-1) by simp,
    Algebra.norm_algebraMap, Units.val_pow_eq_pow_val, Units.val_neg, Units.val_one]

/-- `P = Q` on `t_𝔫` and `t_𝔨` for `𝔫 ≠ 𝔨`. -/
theorem normalizationSymbol_eq_normProduct_uniformizer_of_ne
    {n k : MaximalSpectrum ↥(integralClosure A F)} (hnk : n ≠ k) :
    normalizationSymbol hdim (normalizationUniformizerNZD hA₀ n)
        (normalizationUniformizerNZD hA₀ k) =
      normalizationNormProduct hA₀ (normalizationFractionUnit (normalizationUniformizerNZD hA₀ n))
        (normalizationFractionUnit (normalizationUniformizerNZD hA₀ k)) := by
  classical
  have := finite_maximalSpectrum_integralClosure A F
  let := Fintype.ofFinite (MaximalSpectrum ↥(integralClosure A F))
  rw [normalizationNormProduct_eq hdim, Finset.prod_eq_mul n k hnk
    (fun m _ hm ↦ normalizationNormFactor_eq_one_of_val_eq_zero hA₀ m
      (normalizationVal_uniformizer_of_ne hA₀ hm.1) (normalizationVal_uniformizer_of_ne hA₀ hm.2))
    (fun h ↦ absurd (Finset.mem_univ n) h) fun h ↦ absurd (Finset.mem_univ k) h]
  have hkn : IsUnit (algebraMap _ (Localization.AtPrime n.asIdeal)
      (normalizationUniformizer A F hA₀ k)) := isUnit_algebraMap_normalizationUniformizer hA₀ hnk
  have hnk' : IsUnit (algebraMap _ (Localization.AtPrime k.asIdeal)
      (normalizationUniformizer A F hA₀ n)) :=
    isUnit_algebraMap_normalizationUniformizer hA₀ hnk.symm
  refine Units.ext ?_
  rw [normalizationSymbol_uniformizer_of_ne hA₀ hdim hnk, Units.val_mul,
    normalizationNormFactor, normalizationNormFactor,
    normalizationDvrSymbol_of_one_zero hA₀ n (normalizationVal_uniformizer_self hA₀ n)
      (normalizationVal_of_isUnit hA₀ n _ hkn).1,
    normalizationDvrSymbol_of_zero_one hA₀ k (normalizationVal_of_isUnit hA₀ k _ hnk').1
      (normalizationVal_uniformizer_self hA₀ k),
    map_inv, Units.val_inv_eq_inv_val, Units.coe_map, Units.coe_map,
    (normalizationVal_of_isUnit hA₀ n _ hkn).2,
    (normalizationVal_of_isUnit hA₀ k _ hnk').2]
  rfl


/-- **`d^A_{A'} = ∏_𝔪 N ∘ ∂_{A'_𝔪}` on the nonzero elements of the normalization.** -/
theorem normalizationSymbol_eq_normProduct (x y : nonZeroDivisors ↥(integralClosure A F)) :
    normalizationSymbol hdim x y =
      normalizationNormProduct hA₀ (normalizationFractionUnit x) (normalizationFractionUnit y) := by
  have hQl : ∀ x y z : nonZeroDivisors ↥(integralClosure A F),
      normalizationNormProduct hA₀ (normalizationFractionUnit (x * y))
        (normalizationFractionUnit z) =
      normalizationNormProduct hA₀ (normalizationFractionUnit x) (normalizationFractionUnit z) *
        normalizationNormProduct hA₀ (normalizationFractionUnit y)
          (normalizationFractionUnit z) := fun x y z ↦ by
    rw [← oneDimTamePairing_apply hdim, ← oneDimTamePairing_apply hdim,
      ← oneDimTamePairing_apply hdim, map_mul, map_mul, MonoidHom.mul_apply]
  have hQr : ∀ x y z : nonZeroDivisors ↥(integralClosure A F),
      normalizationNormProduct hA₀ (normalizationFractionUnit x)
        (normalizationFractionUnit (y * z)) =
      normalizationNormProduct hA₀ (normalizationFractionUnit x) (normalizationFractionUnit y) *
        normalizationNormProduct hA₀ (normalizationFractionUnit x)
          (normalizationFractionUnit z) := fun x y z ↦ by
    rw [← oneDimTamePairing_apply hdim, ← oneDimTamePairing_apply hdim,
      ← oneDimTamePairing_apply hdim, map_mul, map_mul]
  refine pairing_eq_of_closure_eq_top (M := nonZeroDivisors ↥(integralClosure A F))
    (N := (ResidueField A)ˣ) (normalizationSymbol hdim)
    (fun x y ↦ normalizationNormProduct hA₀ (normalizationFractionUnit x)
      (normalizationFractionUnit y))
    (normalizationSymbol_mul_left hdim) (normalizationSymbol_mul_right hdim) hQl hQr
    (normalizationGenerators hA₀) (mem_closure_normalizationGenerators' hA₀) ?_ x y
  · rintro a (ha | ⟨n, rfl⟩) b (hb | ⟨k, rfl⟩)
    · exact normalizationSymbol_eq_normProduct_unit_unit hdim a b ha hb
    · exact normalizationSymbol_eq_normProduct_unit_uniformizer hdim a ha k
    · exact normalizationSymbol_eq_normProduct_uniformizer_unit hdim n b hb
    · by_cases hnk : n = k
      · subst hnk; exact normalizationSymbol_eq_normProduct_uniformizer_self hdim n
      · exact normalizationSymbol_eq_normProduct_uniformizer_of_ne hdim hnk

omit [IsNoetherianRing A] [Ring.DimensionLEOne A] [Module.Finite A ↥(integralClosure A F)] in
/-- The units of `F` are quotients of images of nonzero elements of `A`. -/
theorem exists_eq_normalizationFractionUnit_div (f : Fˣ) :
    ∃ a b : nonZeroDivisors A, f = normalizationFractionUnit (toNormalizationNonZeroDivisors a) /
      normalizationFractionUnit (toNormalizationNonZeroDivisors (F := F) b) := by
  obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := A) (f : F)
  have ha : a ∈ nonZeroDivisors A := mem_nonZeroDivisors_of_ne_zero fun h ↦ f.ne_zero (by
    rw [← hab, h, map_zero, zero_div])
  refine ⟨⟨a, ha⟩, ⟨b, hb⟩, Units.ext ?_⟩
  rw [Units.val_div_eq_div_val, normalizationFractionUnit_toNormalizationNonZeroDivisors,
    normalizationFractionUnit_toNormalizationNonZeroDivisors, IsUnit.unit_spec, IsUnit.unit_spec]
  exact hab.symm

end Comparison

/-- **The general tame symbol in degree two is the tame symbol of Stacks 02Q1.** For a
one-dimensional Noetherian local domain `A` whose normalization is a finite `A`-module, and units
`f, g` of its fraction field,
`d_A(f, g) = ∏_𝔫 N_{κ(𝔫)/κ}(∂_{A'_𝔫}(f, g))`. -/
theorem oneDimTamePairing_eq_tameSymbol (hdim : ringKrullDim A = 1)
    [Module.Finite A ↥(integralClosure A F)] (f g : Fˣ) :
    oneDimTamePairing hdim f g = tameSymbol (K := F) hdim f g := by
  let := dimensionLEOne_of_ringKrullDim_eq_one A hdim
  have key : ∀ x y : nonZeroDivisors A,
      oneDimTamePairing hdim (normalizationFractionUnit (toNormalizationNonZeroDivisors x))
        (normalizationFractionUnit (toNormalizationNonZeroDivisors (F := F) y)) =
      tameSymbolPairingHom hdim (normalizationFractionUnit (toNormalizationNonZeroDivisors x))
        (normalizationFractionUnit (toNormalizationNonZeroDivisors (F := F) y)) := fun x y ↦ by
    rw [oneDimTamePairing_apply, tameSymbolPairingHom_apply, tameSymbol_eq_normalizationSymbol,
      normalizationSymbol_eq_normProduct hdim]
  obtain ⟨a, b, rfl⟩ := exists_eq_normalizationFractionUnit_div (A := A) f
  obtain ⟨c, d, rfl⟩ := exists_eq_normalizationFractionUnit_div (A := A) g
  rw [← tameSymbolPairingHom_apply]
  simp only [map_div, MonoidHom.div_apply, key]

/-- **Stacks 0EAY in degree two: the general tame symbol on a pure symbol.** For a
one-dimensional Noetherian local domain `A` whose normalization is a finite `A`-module,
`∂_A {f, g} = {d_A(f, g)}`, where `∂_A` is the tame symbol of Stacks 0EAY obtained by
normalization and norm and `d_A` the tame symbol of Stacks 02Q1. -/
theorem oneDimTameSymbol_one_milnorKTwoPureSymbol (hdim : ringKrullDim A = 1)
    [Module.Finite A ↥(integralClosure A F)] (f g : Fˣ) :
    oneDimTameSymbol A F hdim 1 (milnorKTwoPureSymbol F f g) =
      (milnorKTheoryOneAddEquiv (ResidueField A)).symm
        (Additive.ofMul (tameSymbol (K := F) hdim f g)) := by
  rw [AddEquiv.eq_symm_apply, ← oneDimTamePairing_eq_tameSymbol hdim f g]
  rfl

/-- **Stacks 0EAY in degree two.** For a one-dimensional Noetherian local domain `A` whose
normalization is a finite `A`-module, the tame symbol `∂_A : K^M_2(F) → K^M_1(κ)` obtained by
normalization and norm is the tame symbol `d_A` of Stacks 02Q1 descended to Milnor K-theory. -/
theorem oneDimTameSymbol_one_eq_milnorKTwoTameSymbol (hdim : ringKrullDim A = 1)
    [Module.Finite A ↥(integralClosure A F)] :
    oneDimTameSymbol A F hdim 1 = milnorKTwoTameSymbol (A := A) (K := F) hdim := by
  refine AddMonoidHom.ext fun α ↦ ?_
  induction α using milnorKTwo_induction with
  | hsymb f g =>
    rw [oneDimTameSymbol_one_milnorKTwoPureSymbol, milnorKTwoTameSymbol_pureSymbol]
  | hadd a b ha hb => rw [map_add, map_add, ha, hb]

/-- **Stacks 0EAY in degree two, for a Nagata local domain**, in particular an excellent one. -/
theorem oneDimTameSymbol_one_eq_milnorKTwoTameSymbol_of_isNagataRing
    (hdim : ringKrullDim A = 1) (hN : IsNagataRing A) :
    oneDimTameSymbol A F hdim 1 = milnorKTwoTameSymbol (A := A) (K := F) hdim :=
  let := dimensionLEOne_of_ringKrullDim_eq_one A hdim
  have := module_finite_integralClosure_of_isNagataRing A F hN
  oneDimTameSymbol_one_eq_milnorKTwoTameSymbol hdim

/-- **Stacks 0EAY: in degree two the tame symbol of a discrete valuation ring is the tame symbol of
Section 42.5.** For a discrete valuation ring `A` with fraction field `F` and any uniformizer `ϖ`,
the tame symbol `∂_A : K^M_2(F) → K^M_1(κ)` of the remark is the tame symbol `d_A` of Stacks 02Q1
descended to Milnor K-theory, as maps. -/
@[stacks 0EAY "the tame symbol ∂_A : K^M_{i+1}(F) → K^M_i(κ) of a discrete valuation ring is \
defined as in Section 42.5: in degree i = 1 it is, as a map K^M_2(F) → K^M_1(κ) = κ^*, the tame \
symbol d_A of Section 42.5 (Stacks 02Q1) descended along the presentation of K^M_2, for every \
choice of uniformizer"]
theorem dvrMilnorTameSymbol_one_eq_milnorKTwoTameSymbol {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] {F : Type u} [Field F] [Algebra A F] [IsFractionRing A F]
    {ϖ : A} (hϖ : Irreducible ϖ) :
    dvrMilnorTameSymbol (F := F) hϖ 1 =
      milnorKTwoTameSymbol (A := A) (K := F) (IsDiscreteValuationRing.ringKrullDim_eq_one A) := by
  have : Module.Finite A ↥(integralClosure A F) := by
    rw [IsIntegrallyClosed.integralClosure_eq_bot A F]
    infer_instance
  rw [← dvrMilnorTameSymbol'_eq, ← oneDimTameSymbol_eq_dvrMilnorTameSymbol']
  exact oneDimTameSymbol_one_eq_milnorKTwoTameSymbol _

end Stacks.Chow

