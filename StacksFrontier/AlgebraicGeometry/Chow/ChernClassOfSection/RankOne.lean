/-!
# Chern classes and sections: the hypothesis, and rank one

Let `(S, δ)` be the base situation of chapter 42, let `X` be locally of finite type over `S`,
let `ℰ` be a finite locally free `𝒪_X`-module of constant rank `r` and let `s ∈ Γ(X, ℰ)`, with
zero scheme `Z(s) ⊆ X` ([Stacks, Tag 0FA8]). [Stacks, Tag 0FA9] asks that at every generic point
`ξ` of `Z(s)` with `δ(ξ) = n - r` the ideal of `Z(s)` in `𝒪_{X, ξ}` be generated by a regular
sequence of length `r`; this file names that hypothesis and proves the tag in the case `X = X'`
of rank one, which is [Stacks, Tag 02SQ]:

  `c_1(ℒ) ∩ [X]_n = [Z(s)]_{n-1}`

for an invertible `ℒ`, when `dim_δ X ≤ n`, `dim_δ Z(s) ≤ n - 1` and the ideal of `Z(s)` is
generated by a nonzerodivisor at the generic points of `Z(s)` of `δ`-dimension `n - 1`.

## Main definitions

* `Stacks.Chow.IsRegularSequenceOnZeroScheme` — the regular-sequence hypothesis of
  [Stacks, Tag 0FA9].

## Main results

* `Stacks.Chow.chernCap_one_cap_fundamentalCycle_eq_zeroScheme` — the rank-one case.

## Implementation notes

The cap product is `Stacks.Chow.GenuineChern.chernCap`, the cap product of [Stacks, Tag 02U6];
at rank one it is the first Chern class cap of [Stacks, Tag 02SO]
(`Stacks.Chow.GenuineChern.chernCap_one_eq_invCap`). The hypothesis on the dimension of `X` is
`dim_δ X ≤ n`, which is weaker than the `dim_δ X = n` of the source and is what the source's
induction actually uses.

## References

* [Stacks Project, Tag 0FA9](https://stacks.math.columbia.edu/tag/0FA9)
* [Stacks Project, Tag 0FA8](https://stacks.math.columbia.edu/tag/0FA8)
* [Stacks Project, Tag 02SQ](https://stacks.math.columbia.edu/tag/02SQ)
* [Stacks Project, Tag 02U6](https://stacks.math.columbia.edu/tag/02U6)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace Stacks.Chow

/-- **The regular-sequence hypothesis of [Stacks, Tag 0FA9].** For every generic point `ξ` of
the zero scheme `Z(s)` at which the relative dimension over the base is `m`, the ideal that
`Z(s)` cuts out in the local ring `𝒪_{X, ξ}` — the kernel of the stalk map of the closed immersion
`Z(s) ⟶ X` — is generated by a regular sequence of length `r`. -/
def IsRegularSequenceOnZeroScheme (C : ChowSituation.{u}) {X : Scheme.{u}} (q : X ⟶ C.S)
    [LocallyOfFiniteType q] (E : X.Modules) (s : Γ(E, ⊤)) (r : ℕ) (m : ℤ) : Prop :=
  ∀ ξ : genericPoints (RegularSectionSequence.zeroScheme X E s).subscheme,
    relativeDimension C.dimensionFunction q
        ((RegularSectionSequence.zeroScheme X E s).subschemeι ξ.1) = m →
      ∃ rs : List (X.presheaf.stalk
          ((RegularSectionSequence.zeroScheme X E s).subschemeι ξ.1)),
        rs.length = r ∧
        RingTheory.Sequence.IsRegular
          (X.presheaf.stalk ((RegularSectionSequence.zeroScheme X E s).subschemeι ξ.1))
          rs ∧
        Ideal.ofList rs =
          RingHom.ker ((RegularSectionSequence.zeroScheme X E s).subschemeι.stalkMap ξ.1).hom

/-- The fundamental classes of a closed immersion in two degrees known to be equal are
heterogeneously equal. -/
theorem mk_cycleAssociatedToClosedSubscheme_heq (C : ChowSituation.{u}) {X Z : Scheme.{u}}
    (q : X ⟶ C.S) [LocallyOfFiniteType q] (i : Z ⟶ X) [IsClosedImmersion i] {d e : ℤ}
    (h : d = e) :
    QuotientAddGroup.mk' (rationalEquivalences C q d) (cycleAssociatedToClosedSubscheme C q i d) ≍
      QuotientAddGroup.mk' (rationalEquivalences C q e)
        (cycleAssociatedToClosedSubscheme C q i e) := by
  subst h; rfl

open GenuineChern in
/-- **[Stacks, Tag 0FA9] in rank one, for `X = X'`**, from [Stacks, Tag 02SQ]. Let `ℒ` be
finite locally free of rank one on `X` and `s ∈ Γ(X, ℒ)`. If `dim_δ X ≤ n`,
`dim_δ Z(s) ≤ n - 1`, and at every generic point of `Z(s)` of `δ`-dimension `n - 1` the ideal of
`Z(s)` is generated by a nonzerodivisor, then `c_1(ℒ) ∩ [X]_n = [Z(s)]_{n-1}`. -/
theorem chernCap_one_cap_fundamentalCycle_eq_zeroScheme (C : ChowSituation.{u}) {X : Scheme.{u}}
    (q : X ⟶ C.S) [LocallyOfFiniteType q] (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L 1] (s : Γ(L, ⊤))
    (n : ℤ) (hX : schemeDeltaDimension C q ≤ (n : EInt))
    (hZ : schemeDeltaDimension C
        ((RegularSectionSequence.zeroScheme X L s).subschemeι ≫ q) ≤
      ((n - 1 : ℤ) : EInt))
    (hreg : IsRegularSequenceOnZeroScheme C q L s 1 (n - 1)) :
    chernCap C 1 q L n (Fin.last 1)
        (QuotientAddGroup.mk' (rationalEquivalences C q n)
          (cycleAssociatedToClosedSubscheme C q (𝟙 X) n)) =
      QuotientAddGroup.mk' (rationalEquivalences C q (n - 1))
        (cycleAssociatedToClosedSubscheme C q
          (RegularSectionSequence.zeroScheme X L s).subschemeι (n - 1)) := by
  have := isInvertible_of_rank_one L
  set k : ℤ := n - 1 with hk
  have hnk : n = k + 1 := by omega
  -- the section read on the pullback of `ℒ` along the identity, as 02SQ wants it
  set t : ((Scheme.Modules.pullback (𝟙 X)).obj L).sections :=
    Stacks.SheafOfModules.sectionsOfTopOfRingSheaf _
      (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackId X).inv.app L) ⊤ s) with ht
  have hteval : Scheme.Modules.Hom.app ((Scheme.Modules.pullbackId X).hom.app L) ⊤
      (t.eval (op ⊤)) = s := by
    have h1 : t.eval (op ⊤) =
        Scheme.Modules.Hom.app ((Scheme.Modules.pullbackId X).inv.app L) ⊤ s :=
      Stacks.SheafOfModules.sectionsOfTopOfRingSheaf_eval_top _ _
    exact (congrArg (fun m => Scheme.Modules.Hom.app ((Scheme.Modules.pullbackId X).hom.app L) ⊤
      m) h1).trans (congrArg (fun φ : L ⟶ L => Scheme.Modules.Hom.app φ ⊤ s)
        ((Scheme.Modules.pullbackId X).inv_hom_id_app L))
  have hZeq : Stacks.Divisors.zeroScheme X ((Scheme.Modules.pullback (𝟙 X)).obj L)
      (t.eval (op ⊤)) = RegularSectionSequence.zeroScheme X L s :=
    AlgebraicGeometry.zeroScheme_eq_of_iso ((Scheme.Modules.pullbackId X).app L) hteval
  -- the three hypotheses of 02SQ
  have hY : schemeDeltaDimension C (𝟙 X ≫ q) ≤ ((k + 1 : ℤ) : EInt) := by
    rw [schemeDeltaDimension_congr C (Category.id_comp q), ← hnk]; exact hX
  have hD : schemeDeltaDimension C
      ((Stacks.Divisors.zeroScheme X ((Scheme.Modules.pullback (𝟙 X)).obj L)
        (t.eval (op ⊤))).subschemeι ≫ (𝟙 X ≫ q)) ≤ (k : EInt) := by
    rw [schemeDeltaDimension_subschemeι_comp_of_eq C hZeq (Category.id_comp q)]
    exact hZ
  -- the regularity hypothesis, for any presentation of the zero scheme
  have hkey : ∀ (D : X.IdealSheafData), D = RegularSectionSequence.zeroScheme X L s →
      ∀ ξ : genericPoints D.subscheme,
        relativeDimension C.dimensionFunction q (D.subschemeι ξ.1) = k →
        ∃ a : X.presheaf.stalk (D.subschemeι ξ.1),
          IsSMulRegular (X.presheaf.stalk (D.subschemeι ξ.1)) a ∧
          RingHom.ker (D.subschemeι.stalkMap ξ.1).hom = Ideal.span {a} := by
    intro D hD
    subst hD
    intro ξ hξ
    obtain ⟨rs, hlen, hrs, hspan⟩ := hreg ξ hξ
    match rs, hlen with
    | [a], _ =>
      refine ⟨a, ?_, ?_⟩
      · have h := hrs.toIsWeaklyRegular
        rw [RingTheory.Sequence.isWeaklyRegular_singleton_iff] at h
        exact h
      · rw [← hspan, Ideal.ofList_singleton]
  have hs : ∀ ξ : genericPoints (Stacks.Divisors.zeroScheme X
        ((Scheme.Modules.pullback (𝟙 X)).obj L) (t.eval (op ⊤))).subscheme,
      relativeDimension C.dimensionFunction (𝟙 X ≫ q)
          ((Stacks.Divisors.zeroScheme X ((Scheme.Modules.pullback (𝟙 X)).obj L)
            (t.eval (op ⊤))).subschemeι ξ.1) = k →
        Function.Injective (ConcreteCategory.hom
          ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u}
            ((Stacks.Divisors.zeroScheme X ((Scheme.Modules.pullback (𝟙 X)).obj L)
              (t.eval (op ⊤))).subschemeι ξ.1)).map
            ((Scheme.Modules.toPresheaf X).map
              (((Scheme.Modules.pullback (𝟙 X)).obj L).unitHomEquiv.symm t)))) := by
    intro ξ hξ
    have hξ' : relativeDimension C.dimensionFunction q
        ((Stacks.Divisors.zeroScheme X ((Scheme.Modules.pullback (𝟙 X)).obj L)
          (t.eval (op ⊤))).subschemeι ξ.1) = k := by
      simpa only [Category.id_comp] using hξ
    obtain ⟨a, ha, hker⟩ := hkey _ hZeq ξ hξ'
    exact injective_stalk_unitHomEquiv_symm_of_ker_eq_span _ t ξ.1 a ha hker
  have h02SQ := Stacks.ChernCap42.firstChernClassCapOfInvertible_closedSubscheme_eq_zeroScheme
    C q (𝟙 X) k L t hY hD hs
  -- assemble
  refine eq_of_heq ?_
  have hcap := chernCap_one_eq_invCap C q L (k + 1)
    (QuotientAddGroup.mk' (rationalEquivalences C q (k + 1))
      (cycleAssociatedToClosedSubscheme C q (𝟙 X) (k + 1)))
  refine (heq_apply_of_degree C q q (fun d => d) (fun d => d - 1)
    (fun d => chernCap C 1 q L d (Fin.last 1)) hnk
    (mk_cycleAssociatedToClosedSubscheme_heq C q (𝟙 X) hnk)).trans ?_
  refine (heq_of_eq hcap).trans ?_
  refine (capOnChow_heq C q (invCap C q L) (show k + 1 - 1 = k by omega)
    (chowGroupCast_heq C q _ _)).trans ?_
  rw [invCap_capOnChow_mk, h02SQ]
  refine heq_of_eq ?_
  congr 1
  exact (cycleAssociatedToClosedSubscheme_congr C q _ _ (Category.comp_id _) k).trans
    (congrArg (fun D : X.IdealSheafData => cycleAssociatedToClosedSubscheme C q D.subschemeι k)
      hZeq)

end Stacks.Chow

end
