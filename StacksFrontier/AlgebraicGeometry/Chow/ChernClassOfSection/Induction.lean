/-!
# Chern classes and sections: the induction on the rank

Let `(S, δ)` be the base situation of chapter 42, let `X` be locally of finite type over `S`,
let `ℰ` be finite locally free of constant rank `r` on `X` and `s ∈ Γ(X, ℰ)`. This file proves
the case `X = X'` of [Stacks, Tag 0FA9]: if `dim_δ X ≤ n`, `dim_δ Z(s) ≤ n - r`, and at every
generic point `ξ` of `Z(s)` with `δ(ξ) = n - r` the ideal of `Z(s)` in `𝒪_{X, ξ}` is generated by
a regular sequence of length `r`, then

  `c_r(ℰ) ∩ [X]_n = [Z(s)]_{n - r}`.

The proof is the induction on `r` of Stacks 0FA9. For `r = 0` the zero scheme is `X`; for `r = 1`
it is [Stacks, Tag 02SQ] (`Stacks.Chow.chernCap_one_cap_fundamentalCycle_eq_zeroScheme`). For
`r ≥ 2` let `π : P ⟶ X` be the projective bundle of `ℰ`, with tautological sequence
`0 ⟶ ℰ' ⟶ π^*ℰ ⟶ 𝒪_P(1) ⟶ 0`, and `t ∈ Γ(P, 𝒪_P(1))` the image of `π^*s`. Then:

* `c_1(𝒪_P(1)) ∩ [P] = [Z(t)]`, by Stacks 02SQ: off `π⁻¹ Z(s)` the hyperplane `Z(t)` is an
  effective Cartier divisor (`Stacks.Chow.exists_isSMulRegular_stalk_bundleHyperplane`), and
  over `Z(s)` the dimension is too small to matter;
* on `Z(t)` the section `π^*s` comes from a section `s'` of `ℰ'|_{Z(t)}`, whose zero scheme is
  `π⁻¹ Z(s)`, and the regular-sequence hypothesis passes to `s'`
  (`RingTheory.Sequence.exists_isRegular_ofList_eq_map_of_ker_eq_span_singleton`); so by
  induction `c_{r-1}(ℰ') ∩ [Z(t)] = [π⁻¹ Z(s)]`;
* by the Whitney formula `c_r(π^*ℰ) = c_{r-1}(ℰ') c_1(𝒪_P(1))` ([Stacks, Tag 02UI]), and since
  Chern classes commute with flat pullback ([Stacks, Tag 02U8]) and `π^*` is injective
  ([Stacks, Tag 02TX]), the equality on `X` follows.

## Main results

* `Stacks.Chow.chernCap_cap_fundamentalCycle_eq_zeroScheme` — the case `X = X'` of
  [Stacks, Tag 0FA9], for a scheme of `δ`-dimension at most `n`.

## Implementation notes

The induction is run with `dim_δ X ≤ n` rather than `dim_δ X = n` as in Stacks 0FA9: this is a
stronger statement, and the inequality is what the inductive step can verify on `Z(t)`.

## References

* [Stacks Project, Tag 0FA9](https://stacks.math.columbia.edu/tag/0FA9)
* [Stacks Project, Tag 02SQ](https://stacks.math.columbia.edu/tag/02SQ)
* [Stacks Project, Tag 02TX](https://stacks.math.columbia.edu/tag/02TX)
* [Stacks Project, Tag 02UI](https://stacks.math.columbia.edu/tag/02UI)
* [Stacks Project, Tag 02U8](https://stacks.math.columbia.edu/tag/02U8)
* [Stacks Project, Tag 00LM](https://stacks.math.columbia.edu/tag/00LM)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace Stacks.Chow

/-! ### Dimension estimates -/

/-- Along a morphism of relative dimension `d` the relative dimension over the base grows by at
most `d`. -/
theorem relativeDimension_comp_le_of_relativeDimension (C : ChowSituation.{u})
    {X Y : Scheme.{u}} (q : X ⟶ C.S) [LocallyOfFiniteType q] (f : Y ⟶ X)
    [LocallyOfFiniteType f] (d : ℕ) (hf : AlgebraicGeometry.RelativeDimension f d) (y : Y) :
    relativeDimension C.dimensionFunction (f ≫ q) y ≤
      relativeDimension C.dimensionFunction q (f y) + d := by
  rw [relativeDimension_comp_eq_add_trdeg C.dimensionFunction q f y]
  have := toNat_residueTrdeg_le_of_relativeDimension f d hf y
  omega

/-- **A point at which the local ring has a nonzerodivisor in its maximal ideal is not a generic
point**, so its relative dimension is at most `k - 1` on a scheme of `δ`-dimension at most `k`. -/
theorem relativeDimension_lt_of_isSMulRegular (C : ChowSituation.{u}) {X : Scheme.{u}}
    (f : X ⟶ C.S) [LocallyOfFiniteType f] {k : ℤ} (hX : schemeDeltaDimension C f ≤ (k : EInt))
    (x : X) (a : X.presheaf.stalk x) (ha : IsSMulRegular (X.presheaf.stalk x) a)
    (ham : a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x)) :
    relativeDimension C.dimensionFunction f x < k := by
  obtain ⟨W, hW, hsub⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
    (closure ({x} : Set X)) isIrreducible_singleton.closure
  have hxW : x ∈ W := hsub (subset_closure rfl)
  obtain ⟨p, hp, hpW⟩ := exists_mem_minimalPrimes_fromSpecStalk_eq x ⟨W, hW⟩ hxW
  have hηne : (genericPoints.ofComponent (⟨W, hW⟩ : irreducibleComponents X) : X) ≠ x := by
    intro heq
    have hpclosed : p = IsLocalRing.closedPoint (X.presheaf.stalk x) :=
      (X.fromSpecStalk x).isEmbedding.injective
        ((hpW.trans heq).trans Scheme.fromSpecStalk_closedPoint.symm)
    refine ha.notMem_of_mem_minimalPrimes (p := p.asIdeal)
      (by rw [Module.annihilator_eq_bot.mpr inferInstance]; exact hp) ?_
    exact hpclosed ▸ ham
  have hlt := (deltaDimensionFunction C f).strictAnti_specializes
    ((genericPoints.isGenericPoint_ofComponent (⟨W, hW⟩ : irreducibleComponents X)).specializes
      hxW) hηne
  rw [deltaDimensionFunction_apply, deltaDimensionFunction_apply] at hlt
  have hη := relativeDimension_le_of_schemeDeltaDimension_le C f (𝟙 X) (k := k)
    (by simpa using hX) (genericPoints.ofComponent (⟨W, hW⟩ : irreducibleComponents X) : X)
  have hid : (𝟙 X : X ⟶ X) (genericPoints.ofComponent (⟨W, hW⟩ : irreducibleComponents X) : X) =
      (genericPoints.ofComponent (⟨W, hW⟩ : irreducibleComponents X) : X) := rfl
  rw [hid] at hη
  omega

/-! ### The Whitney formula against an invertible quotient -/

open GenuineChern in
/-- **The top Chern class of an extension by an invertible quotient.** For a short exact sequence
`0 ⟶ ℰ₁ ⟶ ℰ ⟶ ℒ ⟶ 0` with `ℰ₁` of rank `r₁` and `ℒ` of rank one,
`c_{r₁ + 1}(ℰ) ∩ α = c_{r₁}(ℰ₁) ∩ (c_1(ℒ) ∩ α)`. This is the top-degree part of the Whitney
formula `c(ℰ) = c(ℰ₁) c(ℒ)` of [Stacks, Tag 02UI]. -/
theorem chernCap_last_heq_of_shortExact (C : ChowSituation.{u}) {T : Scheme.{u}}
    (q : T ⟶ C.S) [LocallyOfFiniteType q] (S : ShortComplex T.Modules) (hS : S.ShortExact)
    (r₁ : ℕ) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₂ (r₁ + 1)]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₃ 1] (k : ℤ)
    (y : chowGroup C q k) :
    chernCap C (r₁ + 1) q S.X₂ k (Fin.last (r₁ + 1)) y ≍
      chernCap C r₁ q S.X₁ (k - ((Fin.last 1 : Fin 2) : ℤ)) (Fin.last r₁)
        (chernCap C 1 q S.X₃ k (Fin.last 1) y) := by
  have h := chernFamily_eq_mul_of_shortExact C q S hS r₁ 1
  have hy : chernFamily C q S.X₂ (r₁ + 1) k (r₁ + 1) y =
      (chernFamily C q S.X₁ r₁ * chernFamily C q S.X₃ 1) k (r₁ + 1) y :=
    congrArg (fun a : GradedCapFamily (chowGroup C q) => a k (r₁ + 1) y) h
  rw [gradedCap_mul_apply, Finset.sum_eq_single 1] at hy
  · rw [convolveTerm_of_le _ _ _ (by omega), capTo_def] at hy
    dsimp only [chernFamily] at hy
    rw [chernCapFamilyOnChow_of_le C (chernCap C) q S.X₂ (r₁ + 1) k le_rfl,
      chernCapFamilyOnChow_of_le C (chernCap C) q S.X₃ 1 k le_rfl,
      chernCapFamilyOnChow_of_le C (chernCap C) q S.X₁ r₁ (k - ((1 : ℕ) : ℤ))
        (show r₁ + 1 - 1 ≤ r₁ by omega)] at hy
    exact (heq_of_eq hy).trans (gradedDegreeCast_heq _ _)
  · intro j _ hj
    rcases Nat.lt_or_gt_of_ne hj with hj0 | hj2
    · obtain rfl : j = 0 := by omega
      rw [convolveTerm_of_le _ _ _ (by omega), capTo_def]
      dsimp only [chernFamily]
      rw [chernCapFamilyOnChow_of_gt C (chernCap C) q S.X₁ r₁ (k - ((0 : ℕ) : ℤ))
        (show ¬ r₁ + 1 - 0 ≤ r₁ by omega)]
      simp
    · by_cases hjm : j ≤ r₁ + 1
      · rw [convolveTerm_of_le _ _ _ hjm, capTo_def]
        dsimp only [chernFamily]
        rw [chernCapFamilyOnChow_of_gt C (chernCap C) q S.X₃ 1 k (show ¬ j ≤ 1 by omega)]
        simp
      · exact convolveTerm_of_gt _ _ _ hjm y
  · intro h1
    exact absurd (Finset.mem_range.mpr (by omega)) h1

/-! ### Rank zero -/

/-- The cycle of the identity is the cycle of the zero ideal sheaf. -/
theorem cycleAssociatedToClosedSubscheme_id_eq_bot (C : ChowSituation.{u}) {X : Scheme.{u}}
    (q : X ⟶ C.S) [LocallyOfFiniteType q] (n : ℤ) :
    cycleAssociatedToClosedSubscheme C q (𝟙 X) n =
      cycleAssociatedToClosedSubscheme C q (⊥ : X.IdealSheafData).subschemeι n := by
  rw [cycleAssociatedToClosedSubscheme_ker C q (𝟙 X) n]
  exact congrArg (fun I : X.IdealSheafData => cycleAssociatedToClosedSubscheme C q I.subschemeι n)
    (Scheme.Hom.ker_eq_bot_of_isIso (𝟙 X))

open GenuineChern in
/-- **[Stacks, Tag 0FA9] in rank zero.** The only Chern class is `c_0 = 1`, and the zero scheme
of a section of a module of rank zero is the whole scheme. -/
theorem chernCap_zero_cap_fundamentalCycle_eq_zeroScheme (C : ChowSituation.{u})
    {X : Scheme.{u}} (q : X ⟶ C.S) [LocallyOfFiniteType q] (F : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F 0] (s : Γ(F, ⊤))
    (n : ℤ) :
    chernCap C 0 q F n (Fin.last 0)
        (QuotientAddGroup.mk' (rationalEquivalences C q n)
          (cycleAssociatedToClosedSubscheme C q (𝟙 X) n)) =
      QuotientAddGroup.mk' (rationalEquivalences C q (n - ((0 : ℕ) : ℤ)))
        (cycleAssociatedToClosedSubscheme C q (RegularSectionSequence.zeroScheme X F s).subschemeι
          (n - ((0 : ℕ) : ℤ))) := by
  refine eq_of_heq ?_
  rw [chernCap_zero]
  refine (chowGroupCast_heq C q _ _).trans ?_
  rw [cycleAssociatedToClosedSubscheme_id_eq_bot,
    ← Stacks.RegularSectionSequence.zeroScheme_eq_bot_of_rank_zero F s]
  exact mk_cycleAssociatedToClosedSubscheme_heq C q _ (by simp)

/-! ### The ideal of a closed subscheme at a point, as the kernel of the stalk map -/

/-- The stalk of an ideal sheaf at a point of its support is the kernel of the stalk map of its
closed immersion. -/
theorem ker_stalkMap_subschemeι_eq_stalk {Y : Scheme.{u}} (I : Y.IdealSheafData)
    (z : I.subscheme) :
    RingHom.ker (I.subschemeι.stalkMap z).hom = IdealSheafData.stalk I (I.subschemeι z) := by
  have h := IdealSheafData.stalk_ker_of_isClosedImmersion I.subschemeι z
  rw [Scheme.IdealSheafData.ker_subschemeι] at h
  exact h.symm

/-! ### The inductive step: the regular-sequence hypothesis on the hyperplane -/

section Step

variable {X : Scheme.{u}} (E : X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]

/-- The point over which a point of the hyperplane lies is in `Z(s)` when the point lies in the
zero scheme of `s'`. -/
theorem bundleProj_mem_support_of_bundleRestrictedSection (m : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E (m + 1 + 1)]
    (s : Γ(E, ⊤))
    (z : (RegularSectionSequence.zeroScheme (bundleHyperplane E s).subscheme _
      (bundleRestrictedSection E s)).subscheme) :
    bundleProj E ((bundleHyperplane E s).subschemeι
        ((RegularSectionSequence.zeroScheme (bundleHyperplane E s).subscheme _
          (bundleRestrictedSection E s)).subschemeι z)) ∈
      (RegularSectionSequence.zeroScheme X E s).support := by
  have hmem : ((RegularSectionSequence.zeroScheme (bundleHyperplane E s).subscheme _
      (bundleRestrictedSection E s)).subschemeι ≫ (bundleHyperplane E s).subschemeι) z ∈
      ((RegularSectionSequence.zeroScheme X E s).comap (bundleProj E)).support := by
    rw [← ker_zeroScheme_bundleRestrictedSection E m s]
    exact Scheme.Hom.range_subset_ker_support _ ⟨z, rfl⟩
  rwa [Scheme.IdealSheafData.support_comap] at hmem

/-- The stalk of a zero scheme of a section of a module of rank `r` is generated by `r`
elements. -/
theorem exists_stalk_zeroScheme_eq_span {Y : Scheme.{u}} (L : Y.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L r] (σ : Γ(L, ⊤))
    (y : Y) : ∃ c : Fin r → Y.presheaf.stalk y,
      IdealSheafData.stalk (RegularSectionSequence.zeroScheme Y L σ) y =
        Ideal.span (Set.range c) := by
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} L :=
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree L r
  have : L.IsQuasicoherent :=
    Stacks.AlgebraicGeometry.CoherenceCriteria.isQuasicoherent_of_isFiniteLocallyFree L
  have : L.IsFinitePresentation :=
    AlgebraicGeometry.SheafOfModules.isFinitePresentation_of_isFiniteLocallyFree L inferInstance
  obtain ⟨W, hW, hyW, -, ⟨b⟩⟩ := exists_isAffineOpen_basis_sections_le L r
    (show y ∈ (⊤ : Y.Opens) from trivial)
  refine ⟨fun i => (Y.presheaf.germ W y hyW).hom (b.coord i (L.presheaf.map (homOfLE le_top).op σ)),
    ?_⟩
  rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ _ y ⟨W, hW⟩ hyW,
    Stacks.RegularSectionSequence.zeroScheme_ideal_eq_span_coord L σ ⟨W, hW⟩ b, Ideal.map_span,
    ← Set.range_comp]
  rfl

/-- **The regular-sequence hypothesis passes to the hyperplane.** If at every generic point of
`Z(s)` of `δ`-dimension `n - r` the ideal of `Z(s)` is generated by a regular sequence of length
`r = m + 2`, then at every generic point of `Z(s') ⊆ Z(t)` of `δ`-dimension `n - 1` the ideal of
`Z(s')` in the local ring of `Z(t)` is generated by a regular sequence of length `m + 1`.

At such a point `x`, lying over `y ∈ Z(s)`, the dimension count forces `δ(y) = n - r`, so `y` is a
generic point of `Z(s)`; the regular sequence at `y` pulls back to one generating the ideal of
`π⁻¹ Z(s)` at `x` ([Stacks, Tag 00LM]). That ideal contains the local equation of `Z(t)`, and
modulo it is the ideal of `Z(s')`, which a frame of `ℰ'` generates by `m + 1` elements; so
`RingTheory.Sequence.exists_isRegular_ofList_eq_map_of_ker_eq_span_singleton` applies. -/
theorem isRegularZeroSchemeSequence_bundleRestrictedSection (C : ChowSituation.{u})
    (q : X ⟶ C.S) [LocallyOfFiniteType q] (m : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E (m + 1 + 1)]
    (s : Γ(E, ⊤)) (n : ℤ)
    (hZ : schemeDeltaDimension C ((RegularSectionSequence.zeroScheme X E s).subschemeι ≫ q) ≤
      ((n - ((m + 1 + 1 : ℕ) : ℤ) : ℤ) : EInt))
    (hreg : IsRegularSequenceOnZeroScheme C q E s (m + 1 + 1) (n - ((m + 1 + 1 : ℕ) : ℤ))) :
    haveI := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
    haveI := isFiniteLocallyFreeOfRank_kernel_bundleTautological E (m + 1) inferInstance
    IsRegularSequenceOnZeroScheme C ((bundleHyperplane E s).subschemeι ≫ (bundleProj E ≫ q))
      ((Scheme.Modules.pullback (bundleHyperplane E s).subschemeι).obj
        ((bundleTautologicalSequence E).X₁)) (bundleRestrictedSection E s) (m + 1) (n - 1) := by
  have := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
  have := GenuineChern.flat_bundleProj E (m + 1)
  have hK : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((bundleTautologicalSequence E).X₁) (m + 1) :=
    isFiniteLocallyFreeOfRank_kernel_bundleTautological E (m + 1) inferInstance
  have hK' : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback (bundleHyperplane E s).subschemeι).obj
        ((bundleTautologicalSequence E).X₁)) (m + 1) :=
    @AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback _ _ (bundleHyperplane E s).subschemeι
      ((bundleTautologicalSequence E).X₁) (m + 1) hK
  have : IsLocallyNoetherian (bundle E) :=
    LocallyOfFiniteType.isLocallyNoetherian (bundleProj E ≫ q)
  set D := bundleHyperplane E s with hD
  set Z := RegularSectionSequence.zeroScheme X E s with hZdef
  set Zπ := Z.comap (bundleProj E) with hZπ
  set Z'' := RegularSectionSequence.zeroScheme D.subscheme _ (bundleRestrictedSection E s) with hZ''
  intro ξ hξ
  set pt := Z''.subschemeι ξ.1 with hpt
  set x := D.subschemeι pt with hx
  -- dimensions
  have hδx : relativeDimension C.dimensionFunction (bundleProj E ≫ q) x = n - 1 := by
    rw [← relativeDimension_comp_closedImmersion]; exact hξ
  have hyZ : bundleProj E x ∈ Z.support :=
    bundleProj_mem_support_of_bundleRestrictedSection E m s ξ.1
  set y : Z.subscheme := ⟨bundleProj E x, hyZ⟩ with hy
  have hδy_le : relativeDimension C.dimensionFunction q (bundleProj E x) ≤
      n - ((m + 1 + 1 : ℕ) : ℤ) :=
    relativeDimension_le_of_schemeDeltaDimension_le C q Z.subschemeι hZ y
  have hδy : relativeDimension C.dimensionFunction q (Z.subschemeι y) =
      n - ((m + 1 + 1 : ℕ) : ℤ) := by
    have h := relativeDimension_comp_le_of_relativeDimension C q (bundleProj E) (m + 1)
      (Stacks.Chow.relativeDimension_bundleProj E (m + 1)) x
    change relativeDimension C.dimensionFunction q (bundleProj E x) = _
    push_cast at h hδy_le ⊢
    omega
  obtain ⟨W, hW⟩ := isGenericPoint_component_of_relativeDimension_eq C q Z.subschemeι hZ y hδy
  have hygen : y ∈ genericPoints Z.subscheme := by
    change closure {y} ∈ irreducibleComponents Z.subscheme
    rw [hW.def]; exact W.2
  obtain ⟨rs, hlen, hrs, hspan⟩ := hreg ⟨y, hygen⟩ hδy
  rw [ker_stalkMap_subschemeι_eq_stalk] at hspan
  -- the regular sequence pulled back to `𝒪_{P, x}`
  obtain ⟨rs', hlen', hrs', hspan'⟩ :=
    exists_isRegular_stalk_comap_of_flat Z (bundleProj E) x rs hrs hspan
  have hlen'' : rs'.length = m + 1 + 1 := hlen'.trans hlen
  -- the local equation of the hyperplane
  have : AlgebraicGeometry.SheafOfModules.IsInvertible (bundle E).sheaf.obj
      (bundle E).ringCatSheaf.property (bundleTwist E) := isInvertible_bundleTwist E
  obtain ⟨U, -, e, hxU, -⟩ := Stacks.Chow.exists_affine_frame_subset (bundle E) (bundleTwist E)
    x ⊤ trivial
  set g := (bundle E).presheaf.germ U.1 x hxU
    (e ((bundleTwist E).presheaf.map (homOfLE le_top).op (bundleHyperplaneSection E s))) with hg
  have hstD : IdealSheafData.stalk D x = Ideal.span {g} :=
    Stacks.Divisors.stalk_zeroScheme_eq_span_germ (bundleTwist E) (bundleHyperplaneSection E s)
      U e _ rfl x hxU
  set φ := (D.subschemeι.stalkMap pt).hom with hφ
  have hkerφ : RingHom.ker φ = Ideal.span {g} := (ker_stalkMap_subschemeι_eq_stalk D pt).trans hstD
  have hsurj : Function.Surjective φ := D.subschemeι.stalkMap_surjective pt
  set ψ := (Z''.subschemeι.stalkMap ξ.1).hom with hψ
  -- the ideal of `π⁻¹ Z(s)` at `x` is the kernel of the composite
  have hJ : IdealSheafData.stalk Zπ x = RingHom.ker (ψ.comp φ) := by
    have h1 := IdealSheafData.stalk_ker_of_isClosedImmersion
      (Z''.subschemeι ≫ D.subschemeι) ξ.1
    rwa [ker_zeroScheme_bundleRestrictedSection E m s, Scheme.Hom.stalkMap_comp] at h1
  -- the ideal of `Z(s')` at `pt` is generated by `m + 1` elements
  obtain ⟨c, hc⟩ := exists_stalk_zeroScheme_eq_span _ (m + 1) (bundleRestrictedSection E s) pt
  have hker'' : RingHom.ker ψ = Ideal.span (Set.range c) :=
    (ker_stalkMap_subschemeι_eq_stalk Z'' ξ.1).trans hc
  exact RingTheory.Sequence.exists_isRegular_ofList_eq_ker_of_comp φ ψ hsurj g hkerφ c hker''
    rs' hlen'' hrs' (hspan'.trans hJ)

/-- The projective bundle of a module of rank `m + 2` over a scheme of `δ`-dimension at most `n`
has `δ`-dimension at most `n + m + 1`. -/
theorem schemeDeltaDimension_bundle_le (C : ChowSituation.{u}) (q : X ⟶ C.S)
    [LocallyOfFiniteType q] (m : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E (m + 1 + 1)] (n : ℤ)
    (hX : schemeDeltaDimension C q ≤ (n : EInt)) :
    haveI := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
    schemeDeltaDimension C (bundleProj E ≫ q) ≤ ((n + ((m + 1 : ℕ) : ℤ) : ℤ) : EInt) := by
  have := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
  have h := schemeDeltaDimension_le_of_forall_point C (bundleProj E ≫ q) (𝟙 (bundle E))
    (k := n + ((m + 1 : ℕ) : ℤ)) fun z => by
      have h1 := relativeDimension_comp_le_of_relativeDimension C q (bundleProj E) (m + 1)
        (Stacks.Chow.relativeDimension_bundleProj E (m + 1)) z
      have h2 := relativeDimension_le_of_schemeDeltaDimension_le C q (𝟙 X) (k := n)
        (by simpa using hX) (bundleProj E z)
      change relativeDimension C.dimensionFunction (bundleProj E ≫ q) z ≤ _
      change relativeDimension C.dimensionFunction q (bundleProj E z) ≤ n at h2
      omega
  rwa [schemeDeltaDimension_congr C (Category.id_comp (bundleProj E ≫ q))] at h

/-- Points of the hyperplane over `Z(s)` have `δ`-dimension at most `n - 1`. -/
theorem relativeDimension_bundle_le_of_mem_support (C : ChowSituation.{u}) (q : X ⟶ C.S)
    [LocallyOfFiniteType q] (m : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E (m + 1 + 1)]
    (s : Γ(E, ⊤)) (n : ℤ)
    (hZ : schemeDeltaDimension C ((RegularSectionSequence.zeroScheme X E s).subschemeι ≫ q) ≤
      ((n - ((m + 1 + 1 : ℕ) : ℤ) : ℤ) : EInt)) (x : bundle E)
    (hx : bundleProj E x ∈ (RegularSectionSequence.zeroScheme X E s).support) :
    haveI := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
    relativeDimension C.dimensionFunction (bundleProj E ≫ q) x ≤ n - 1 := by
  have := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
  have h1 := relativeDimension_comp_le_of_relativeDimension C q (bundleProj E) (m + 1)
    (Stacks.Chow.relativeDimension_bundleProj E (m + 1)) x
  have h2 := relativeDimension_le_of_schemeDeltaDimension_le C q
    (RegularSectionSequence.zeroScheme X E s).subschemeι hZ ⟨bundleProj E x, hx⟩
  change relativeDimension C.dimensionFunction q (bundleProj E x) ≤ _ at h2
  push_cast at h1 h2 ⊢
  omega

/-- A nonzerodivisor generating the stalk of an ideal sheaf at a point of its support lies in
the maximal ideal. -/
theorem mem_maximalIdeal_of_stalk_eq_span {Y : Scheme.{u}} (I : Y.IdealSheafData) (y : Y)
    (hy : y ∈ I.support) (a : Y.presheaf.stalk y) (ha : IdealSheafData.stalk I y = Ideal.span {a}) :
    a ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y) := by
  have hne : IdealSheafData.stalk I y ≠ ⊤ := fun h =>
    ((IdealSheafData.stalk_eq_top_iff_not_mem_support I y).mp h) hy
  exact IsLocalRing.le_maximalIdeal hne (ha ▸ Ideal.mem_span_singleton_self a)

/-- A point of the hyperplane not over `Z(s)` has a nonzerodivisor in its maximal ideal generating
the stalk of the hyperplane. -/
private theorem exists_isSMulRegular_of_not_mem_support_bundleHyperplane (s : Γ(E, ⊤))
    (z : (bundleHyperplane E s).subscheme)
    (hx : bundleProj E ((bundleHyperplane E s).subschemeι z) ∉
      (RegularSectionSequence.zeroScheme X E s).support) :
    ∃ a : (bundle E).presheaf.stalk ((bundleHyperplane E s).subschemeι z),
      IsSMulRegular ((bundle E).presheaf.stalk ((bundleHyperplane E s).subschemeι z)) a ∧
        IdealSheafData.stalk (bundleHyperplane E s) ((bundleHyperplane E s).subschemeι z) =
          Ideal.span {a} ∧ a ∈ IsLocalRing.maximalIdeal _ := by
  obtain ⟨a, ha, hstalk⟩ := exists_isSMulRegular_stalk_bundleHyperplane E s _ hx
  have hxD : (bundleHyperplane E s).subschemeι z ∈ (bundleHyperplane E s).support := by
    change _ ∈ ((bundleHyperplane E s).support : Set (bundle E))
    rw [← Scheme.IdealSheafData.range_subschemeι]; exact ⟨z, rfl⟩
  exact ⟨a, ha, hstalk, mem_maximalIdeal_of_stalk_eq_span _ _ hxD a hstalk⟩

/-- **The hyperplane has `δ`-dimension at most `n + m`.** Over `Z(s)` this is the dimension
count, and off `Z(s)` the hyperplane is cut out by a nonzerodivisor
(`Stacks.Chow.exists_isSMulRegular_stalk_bundleHyperplane`). -/
theorem schemeDeltaDimension_bundleHyperplane_le (C : ChowSituation.{u}) (q : X ⟶ C.S)
    [LocallyOfFiniteType q] (m : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E (m + 1 + 1)]
    (s : Γ(E, ⊤)) (n : ℤ) (hX : schemeDeltaDimension C q ≤ (n : EInt))
    (hZ : schemeDeltaDimension C ((RegularSectionSequence.zeroScheme X E s).subschemeι ≫ q) ≤
      ((n - ((m + 1 + 1 : ℕ) : ℤ) : ℤ) : EInt)) :
    haveI := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
    schemeDeltaDimension C ((bundleHyperplane E s).subschemeι ≫ (bundleProj E ≫ q)) ≤
      ((n + ((m + 1 : ℕ) : ℤ) - 1 : ℤ) : EInt) := by
  have := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
  refine schemeDeltaDimension_le_of_forall_point C _ _ fun z => ?_
  set x := (bundleHyperplane E s).subschemeι z
  by_cases hx : bundleProj E x ∈ (RegularSectionSequence.zeroScheme X E s).support
  · have h := relativeDimension_bundle_le_of_mem_support E C q m s n hZ x hx
    change relativeDimension C.dimensionFunction (bundleProj E ≫ q) x ≤ _
    push_cast; omega
  · obtain ⟨a, ha, -, ham⟩ := exists_isSMulRegular_of_not_mem_support_bundleHyperplane E s z hx
    have h := relativeDimension_lt_of_isSMulRegular C (bundleProj E ≫ q)
      (schemeDeltaDimension_bundle_le E C q m n hX) x a ha ham
    change relativeDimension C.dimensionFunction (bundleProj E ≫ q) x ≤ _
    omega

/-- **The regular-sequence hypothesis for the hyperplane, at rank one.** At every generic point
of `Z(t)` of `δ`-dimension `n + m` the ideal of `Z(t)` is generated by a nonzerodivisor: such a
point does not lie over `Z(s)`, by the dimension count. -/
theorem isRegularZeroSchemeSequence_bundleHyperplane (C : ChowSituation.{u}) (q : X ⟶ C.S)
    [LocallyOfFiniteType q] (m : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E (m + 1 + 1)]
    (s : Γ(E, ⊤)) (n : ℤ)
    (hZ : schemeDeltaDimension C ((RegularSectionSequence.zeroScheme X E s).subschemeι ≫ q) ≤
      ((n - ((m + 1 + 1 : ℕ) : ℤ) : ℤ) : EInt)) :
    haveI := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
    IsRegularSequenceOnZeroScheme C (bundleProj E ≫ q) (bundleTwist E) (bundleHyperplaneSection E s)
      1 (n + ((m + 1 : ℕ) : ℤ) - 1) := by
  have := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
  intro ξ hξ
  set x := (bundleHyperplane E s).subschemeι ξ.1
  by_cases hx : bundleProj E x ∈ (RegularSectionSequence.zeroScheme X E s).support
  · have h := relativeDimension_bundle_le_of_mem_support E C q m s n hZ x hx
    change relativeDimension C.dimensionFunction (bundleProj E ≫ q) x = _ at hξ
    push_cast at hξ
    omega
  · obtain ⟨a, ha, hstalk, ham⟩ :=
      exists_isSMulRegular_of_not_mem_support_bundleHyperplane E s ξ.1 hx
    refine ⟨[a], rfl, ?_, ?_⟩
    · rw [IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal
        (by simpa using ham), RingTheory.Sequence.isWeaklyRegular_singleton_iff]
      exact ha
    · rw [Ideal.ofList_singleton, ker_stalkMap_subschemeι_eq_stalk]
      exact hstalk.symm

/-- The zero scheme of `s'` has `δ`-dimension at most `n - 1`: it lies over `Z(s)`. -/
theorem schemeDeltaDimension_bundleRestrictedSection_le (C : ChowSituation.{u}) (q : X ⟶ C.S)
    [LocallyOfFiniteType q] (m : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E (m + 1 + 1)]
    (s : Γ(E, ⊤)) (n : ℤ)
    (hZ : schemeDeltaDimension C ((RegularSectionSequence.zeroScheme X E s).subschemeι ≫ q) ≤
      ((n - ((m + 1 + 1 : ℕ) : ℤ) : ℤ) : EInt)) :
    haveI := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
    schemeDeltaDimension C ((RegularSectionSequence.zeroScheme (bundleHyperplane E s).subscheme _
        (bundleRestrictedSection E s)).subschemeι ≫
          ((bundleHyperplane E s).subschemeι ≫ (bundleProj E ≫ q))) ≤ ((n - 1 : ℤ) : EInt) := by
  have := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
  refine schemeDeltaDimension_le_of_forall_point C _ _ fun z => ?_
  have h := relativeDimension_bundle_le_of_mem_support E C q m s n hZ _
    (bundleProj_mem_support_of_bundleRestrictedSection E m s z)
  rwa [← relativeDimension_comp_closedImmersion] at h

end Step

/-! ### The inductive step on Chow groups -/

section ChowStep

open GenuineChern

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (q : X ⟶ C.S) [LocallyOfFiniteType q]
  (E : X.Modules) (m : ℕ)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E (m + 1 + 1)]

/-- The flat pullback of a fundamental class is the fundamental class. -/
theorem flatPullback_cycleAssociatedToClosedSubscheme_id {X' : Scheme.{u}} (sX' : X' ⟶ C.S)
    [LocallyOfFiniteType sX'] (f : X' ⟶ X) [LocallyOfFiniteType f] [Flat f]
    (hbase : f ≫ q = sX') (d : ℕ) (hf : AlgebraicGeometry.RelativeDimension f d) (n : ℤ)
    (hX : schemeDeltaDimension C q ≤ (n : EInt)) :
    flatPullback C sX' q f hbase d hf n (cycleAssociatedToClosedSubscheme C q (𝟙 X) n) =
      cycleAssociatedToClosedSubscheme C sX' (𝟙 X') (n + (d : ℤ)) := by
  rw [flatPullback_cycleAssociatedToClosedSubscheme_of_le C sX' q f hbase d hf (𝟙 X) n
    (by rwa [schemeDeltaDimension_congr C (Category.id_comp q)])]
  exact cycleAssociatedToClosedSubscheme_eq_of_iso C sX' _ _ (asIso (pullback.fst f (𝟙 X)))
    (Category.comp_id _) _

variable [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]

/-- **The pullback of `c_r(ℰ) ∩ [X]_n` to the projective bundle** is `c_{r-1}(ℰ') ∩ [Z(t)]`: Chern
classes commute with flat pullback ([Stacks, Tag 02U8]), the fundamental class pulls back to the
fundamental class, the Whitney formula splits off `c_1(𝒪_P(1))` ([Stacks, Tag 02UI]), and
`c_1(𝒪_P(1)) ∩ [P] = [Z(t)]` is the rank-one case. -/
theorem flatPullback_chernCap_heq_bundleHyperplane (s : Γ(E, ⊤)) (n : ℤ)
    (hX : schemeDeltaDimension C q ≤ (n : EInt))
    (hZ : schemeDeltaDimension C ((RegularSectionSequence.zeroScheme X E s).subschemeι ≫ q) ≤
      ((n - ((m + 1 + 1 : ℕ) : ℤ) : ℤ) : EInt)) :
    haveI := GenuineChern.flat_bundleProj E (m + 1)
    haveI := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
    haveI : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        ((bundleTautologicalSequence E).X₁) (m + 1) :=
      isFiniteLocallyFreeOfRank_kernel_bundleTautological E (m + 1) inferInstance
    flatPullbackChow C (bundleProj E ≫ q) q (bundleProj E) rfl (m + 1)
        (Stacks.Chow.relativeDimension_bundleProj E (m + 1)) (n - ((m + 1 + 1 : ℕ) : ℤ))
        (flatPullbackFactorsThroughRationalEquivalence_general C _ q _ rfl _ _ _)
        (chernCap C (m + 1 + 1) q E n (Fin.last (m + 1 + 1))
          (QuotientAddGroup.mk' (rationalEquivalences C q n)
            (cycleAssociatedToClosedSubscheme C q (𝟙 X) n))) ≍
      chernCap C (m + 1) (bundleProj E ≫ q) ((bundleTautologicalSequence E).X₁)
        (n + ((m + 1 : ℕ) : ℤ) - 1) (Fin.last (m + 1))
        (QuotientAddGroup.mk' (rationalEquivalences C (bundleProj E ≫ q)
            (n + ((m + 1 : ℕ) : ℤ) - 1))
          (cycleAssociatedToClosedSubscheme C (bundleProj E ≫ q) (bundleHyperplane E s).subschemeι
            (n + ((m + 1 : ℕ) : ℤ) - 1))) := by
  have := GenuineChern.flat_bundleProj E (m + 1)
  have := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
  have hK : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((bundleTautologicalSequence E).X₁) (m + 1) :=
    isFiniteLocallyFreeOfRank_kernel_bundleTautological E (m + 1) inferInstance
  have hπE : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback (bundleProj E)).obj E) (m + 1 + 1) :=
    AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback _ E _
  have hO : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (bundleTwist E) 1 := isFiniteLocallyFreeOfRank_bundleTwist E
  have := epi_bundleTautological E
  have hπ := Stacks.Chow.relativeDimension_bundleProj E (m + 1)
  have hfac := fun k : ℤ =>
    flatPullbackFactorsThroughRationalEquivalence_general C (bundleProj E ≫ q) q
      (bundleProj E) rfl (m + 1) hπ k
  -- Chern classes commute with flat pullback
  have hA := chernCap_flatPullback_heq_general C q (bundleProj E ≫ q) (bundleProj E) rfl (m + 1)
    hπ E (m + 1 + 1) ((Scheme.Modules.pullback (bundleProj E)).obj E) (Iso.refl _) n
    (Fin.last (m + 1 + 1))
    (QuotientAddGroup.mk' (rationalEquivalences C q n)
      (cycleAssociatedToClosedSubscheme C q (𝟙 X) n))
  refine hA.symm.trans ?_
  -- the fundamental class pulls back to the fundamental class
  rw [flatPullbackChow_mk, flatPullback_cycleAssociatedToClosedSubscheme_id C q _ _ rfl _ hπ n hX]
  -- the Whitney formula
  have hW := @chernCap_last_heq_of_shortExact C _ (bundleProj E ≫ q) _
    (bundleTautologicalSequence E) (shortExact_bundleTautologicalSequence E) (m + 1) hK hπE hO
    (n + ((m + 1 : ℕ) : ℤ))
    (QuotientAddGroup.mk' (rationalEquivalences C (bundleProj E ≫ q) (n + ((m + 1 : ℕ) : ℤ)))
      (cycleAssociatedToClosedSubscheme C (bundleProj E ≫ q) (𝟙 (bundle E))
        (n + ((m + 1 : ℕ) : ℤ))))
  refine hW.trans ?_
  -- the rank-one case on the bundle
  have h1 := chernCap_one_cap_fundamentalCycle_eq_zeroScheme C (bundleProj E ≫ q) (bundleTwist E)
    (bundleHyperplaneSection E s) (n + ((m + 1 : ℕ) : ℤ))
    (schemeDeltaDimension_bundle_le E C q m n hX)
    (schemeDeltaDimension_bundleHyperplane_le E C q m s n hX hZ)
    (isRegularZeroSchemeSequence_bundleHyperplane E C q m s n hZ)
  refine heq_apply_of_degree C (bundleProj E ≫ q) (bundleProj E ≫ q) (fun d => d)
    (fun d => d - ((Fin.last (m + 1) : Fin (m + 1 + 1)) : ℤ))
    (fun d => chernCap C (m + 1) (bundleProj E ≫ q) ((bundleTautologicalSequence E).X₁) d
      (Fin.last (m + 1))) rfl ?_
  exact heq_of_eq h1

/-- **The cap product on the hyperplane, read in the projective bundle.** Granted the case of
rank `r - 1`, `c_{r-1}(ℰ') ∩ [Z(t)] = [π⁻¹ Z(s)]` in the Chow group of `P`: the cap product
commutes with the proper pushforward along `Z(t) ⟶ P` ([Stacks, Tag 02U9]), and on `Z(t)` the
case of rank `r - 1` applies to the section `s'` of `ℰ'|_{Z(t)}`, whose zero scheme is `π⁻¹ Z(s)`
(`Stacks.Chow.ker_zeroScheme_bundleRestrictedSection`). -/
theorem chernCap_bundleHyperplane_eq
    (ih : ∀ {Y : Scheme.{u}} (qY : Y ⟶ C.S) [LocallyOfFiniteType qY] (F : Y.Modules)
      [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F (m + 1)]
      (σ : Γ(F, ⊤)) (k : ℤ), schemeDeltaDimension C qY ≤ (k : EInt) →
      schemeDeltaDimension C ((RegularSectionSequence.zeroScheme Y F σ).subschemeι ≫ qY) ≤
        ((k - ((m + 1 : ℕ) : ℤ) : ℤ) : EInt) →
      IsRegularSequenceOnZeroScheme C qY F σ (m + 1) (k - ((m + 1 : ℕ) : ℤ)) →
      chernCap C (m + 1) qY F k (Fin.last (m + 1))
          (QuotientAddGroup.mk' (rationalEquivalences C qY k)
            (cycleAssociatedToClosedSubscheme C qY (𝟙 Y) k)) =
        QuotientAddGroup.mk' (rationalEquivalences C qY (k - ((m + 1 : ℕ) : ℤ)))
          (cycleAssociatedToClosedSubscheme C qY
            (RegularSectionSequence.zeroScheme Y F σ).subschemeι (k - ((m + 1 : ℕ) : ℤ))))
    (s : Γ(E, ⊤)) (n : ℤ) (hX : schemeDeltaDimension C q ≤ (n : EInt))
    (hZ : schemeDeltaDimension C ((RegularSectionSequence.zeroScheme X E s).subschemeι ≫ q) ≤
      ((n - ((m + 1 + 1 : ℕ) : ℤ) : ℤ) : EInt))
    (hreg : IsRegularSequenceOnZeroScheme C q E s (m + 1 + 1) (n - ((m + 1 + 1 : ℕ) : ℤ))) :
    haveI := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
    haveI : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        ((bundleTautologicalSequence E).X₁) (m + 1) :=
      isFiniteLocallyFreeOfRank_kernel_bundleTautological E (m + 1) inferInstance
    chernCap C (m + 1) (bundleProj E ≫ q) ((bundleTautologicalSequence E).X₁)
        (n + ((m + 1 : ℕ) : ℤ) - 1) (Fin.last (m + 1))
        (QuotientAddGroup.mk' (rationalEquivalences C (bundleProj E ≫ q)
            (n + ((m + 1 : ℕ) : ℤ) - 1))
          (cycleAssociatedToClosedSubscheme C (bundleProj E ≫ q) (bundleHyperplane E s).subschemeι
            (n + ((m + 1 : ℕ) : ℤ) - 1))) =
      QuotientAddGroup.mk' (rationalEquivalences C (bundleProj E ≫ q)
          (n + ((m + 1 : ℕ) : ℤ) - 1 - ((m + 1 : ℕ) : ℤ)))
        (cycleAssociatedToClosedSubscheme C (bundleProj E ≫ q)
          ((RegularSectionSequence.zeroScheme X E s).comap (bundleProj E)).subschemeι
          (n + ((m + 1 : ℕ) : ℤ) - 1 - ((m + 1 : ℕ) : ℤ))) := by
  have := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
  have hK : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((bundleTautologicalSequence E).X₁) (m + 1) :=
    isFiniteLocallyFreeOfRank_kernel_bundleTautological E (m + 1) inferInstance
  have hKι : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback (bundleHyperplane E s).subschemeι).obj
        ((bundleTautologicalSequence E).X₁)) (m + 1) :=
    @AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback _ _ (bundleHyperplane E s).subschemeι
      ((bundleTautologicalSequence E).X₁) (m + 1) hK
  have hfac := fun k : ℤ => properPushforwardFactorsThroughRationalEquivalence C
    ((bundleHyperplane E s).subschemeι ≫ (bundleProj E ≫ q)) (bundleProj E ≫ q)
    (bundleHyperplane E s).subschemeι rfl k
  have e : n + ((m + 1 : ℕ) : ℤ) - 1 - ((m + 1 : ℕ) : ℤ) = n - 1 := by omega
  have hdimZ := schemeDeltaDimension_bundleRestrictedSection_le E C q m s n hZ
  have hreg' := isRegularZeroSchemeSequence_bundleRestrictedSection E C q m s n hZ hreg
  rw [← e] at hdimZ hreg'
  have hIH := ih ((bundleHyperplane E s).subschemeι ≫ (bundleProj E ≫ q))
    ((Scheme.Modules.pullback (bundleHyperplane E s).subschemeι).obj
      ((bundleTautologicalSequence E).X₁)) (bundleRestrictedSection E s)
    (n + ((m + 1 : ℕ) : ℤ) - 1) (schemeDeltaDimension_bundleHyperplane_le E C q m s n hX hZ)
    hdimZ hreg'
  have hH : QuotientAddGroup.mk' (rationalEquivalences C (bundleProj E ≫ q)
        (n + ((m + 1 : ℕ) : ℤ) - 1))
        (cycleAssociatedToClosedSubscheme C (bundleProj E ≫ q) (bundleHyperplane E s).subschemeι
          (n + ((m + 1 : ℕ) : ℤ) - 1)) =
      properChowPushforward C _ _ (bundleHyperplane E s).subschemeι rfl _ (hfac _)
        (QuotientAddGroup.mk' (rationalEquivalences C _ (n + ((m + 1 : ℕ) : ℤ) - 1))
          (cycleAssociatedToClosedSubscheme C _ (𝟙 _) (n + ((m + 1 : ℕ) : ℤ) - 1))) := by
    rw [properChowPushforward_mk,
      properPushforward_cycleAssociatedToClosedSubscheme_of_isClosedImmersion_comp]
    exact congrArg _ (cycleAssociatedToClosedSubscheme_congr C _ _ _
      (Category.id_comp _).symm _)
  rw [hH, chernCap_properPushforward C _ _ (bundleHyperplane E s).subschemeι rfl
    ((bundleTautologicalSequence E).X₁) (m + 1) _ (Iso.refl _) _ (Fin.last (m + 1)) (hfac _)
    (hfac _)]
  refine (congrArg (properChowPushforward C _ _ (bundleHyperplane E s).subschemeι rfl
    (n + ((m + 1 : ℕ) : ℤ) - 1 - ((m + 1 : ℕ) : ℤ)) (hfac _)) hIH).trans ?_
  rw [properChowPushforward_mk,
    properPushforward_cycleAssociatedToClosedSubscheme_of_isClosedImmersion_comp,
    cycleAssociatedToClosedSubscheme_ker, ker_zeroScheme_bundleRestrictedSection E m s]

/-- The flat pullback of the class of `Z(s)` to the projective bundle is the class of
`π⁻¹ Z(s)`. -/
theorem flatPullbackChow_zeroScheme (s : Γ(E, ⊤)) (n : ℤ)
    (hZ : schemeDeltaDimension C ((RegularSectionSequence.zeroScheme X E s).subschemeι ≫ q) ≤
      ((n - ((m + 1 + 1 : ℕ) : ℤ) : ℤ) : EInt)) :
    haveI := GenuineChern.flat_bundleProj E (m + 1)
    haveI := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
    flatPullbackChow C (bundleProj E ≫ q) q (bundleProj E) rfl (m + 1)
        (Stacks.Chow.relativeDimension_bundleProj E (m + 1)) (n - ((m + 1 + 1 : ℕ) : ℤ))
        (flatPullbackFactorsThroughRationalEquivalence_general C _ q _ rfl _ _ _)
        (QuotientAddGroup.mk' (rationalEquivalences C q (n - ((m + 1 + 1 : ℕ) : ℤ)))
          (cycleAssociatedToClosedSubscheme C q (RegularSectionSequence.zeroScheme X E s).subschemeι
            (n - ((m + 1 + 1 : ℕ) : ℤ)))) =
      QuotientAddGroup.mk' (rationalEquivalences C (bundleProj E ≫ q)
          (n - ((m + 1 + 1 : ℕ) : ℤ) + ((m + 1 : ℕ) : ℤ)))
        (cycleAssociatedToClosedSubscheme C (bundleProj E ≫ q)
          ((RegularSectionSequence.zeroScheme X E s).comap (bundleProj E)).subschemeι
          (n - ((m + 1 + 1 : ℕ) : ℤ) + ((m + 1 : ℕ) : ℤ))) := by
  have := GenuineChern.flat_bundleProj E (m + 1)
  have := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
  rw [flatPullbackChow_mk, flatPullback_cycleAssociatedToClosedSubscheme_of_le C _ q _ rfl _ _ _ _
    hZ, cycleAssociatedToClosedSubscheme_pullbackFst_eq_comap]

/-- **The inductive step of [Stacks, Tag 0FA9]**, for `X = X'`: the case of rank `r - 1 ≥ 1`
gives the case of rank `r`. Both sides pull back to the same class on the projective bundle
(`Stacks.Chow.flatPullback_chernCap_heq_bundleHyperplane`,
`Stacks.Chow.chernCap_bundleHyperplane_eq`, `Stacks.Chow.flatPullbackChow_zeroScheme`), and the
pullback is injective ([Stacks, Tag 02TX]). -/
theorem chernCap_cap_fundamentalCycle_eq_zeroScheme_of_succ
    (ih : ∀ {Y : Scheme.{u}} (qY : Y ⟶ C.S) [LocallyOfFiniteType qY] (F : Y.Modules)
      [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F (m + 1)]
      (σ : Γ(F, ⊤)) (k : ℤ), schemeDeltaDimension C qY ≤ (k : EInt) →
      schemeDeltaDimension C ((RegularSectionSequence.zeroScheme Y F σ).subschemeι ≫ qY) ≤
        ((k - ((m + 1 : ℕ) : ℤ) : ℤ) : EInt) →
      IsRegularSequenceOnZeroScheme C qY F σ (m + 1) (k - ((m + 1 : ℕ) : ℤ)) →
      chernCap C (m + 1) qY F k (Fin.last (m + 1))
          (QuotientAddGroup.mk' (rationalEquivalences C qY k)
            (cycleAssociatedToClosedSubscheme C qY (𝟙 Y) k)) =
        QuotientAddGroup.mk' (rationalEquivalences C qY (k - ((m + 1 : ℕ) : ℤ)))
          (cycleAssociatedToClosedSubscheme C qY
            (RegularSectionSequence.zeroScheme Y F σ).subschemeι (k - ((m + 1 : ℕ) : ℤ))))
    (s : Γ(E, ⊤)) (n : ℤ) (hX : schemeDeltaDimension C q ≤ (n : EInt))
    (hZ : schemeDeltaDimension C ((RegularSectionSequence.zeroScheme X E s).subschemeι ≫ q) ≤
      ((n - ((m + 1 + 1 : ℕ) : ℤ) : ℤ) : EInt))
    (hreg : IsRegularSequenceOnZeroScheme C q E s (m + 1 + 1) (n - ((m + 1 + 1 : ℕ) : ℤ))) :
    chernCap C (m + 1 + 1) q E n (Fin.last (m + 1 + 1))
        (QuotientAddGroup.mk' (rationalEquivalences C q n)
          (cycleAssociatedToClosedSubscheme C q (𝟙 X) n)) =
      QuotientAddGroup.mk' (rationalEquivalences C q (n - ((m + 1 + 1 : ℕ) : ℤ)))
        (cycleAssociatedToClosedSubscheme C q (RegularSectionSequence.zeroScheme X E s).subschemeι
          (n - ((m + 1 + 1 : ℕ) : ℤ))) := by
  have := GenuineChern.flat_bundleProj E (m + 1)
  have := GenuineChern.locallyOfFiniteType_bundleProj E (m + 1)
  refine pullback_injective q E (topHalf C) (m + 1) (n - ((m + 1 + 1 : ℕ) : ℤ)) ?_
  refine eq_of_heq ?_
  refine (flatPullback_chernCap_heq_bundleHyperplane C q E m s n hX hZ).trans ?_
  rw [chernCap_bundleHyperplane_eq C q E m ih s n hX hZ hreg]
  refine HEq.trans ?_ (heq_of_eq (flatPullbackChow_zeroScheme C q E m s n hZ).symm)
  exact mk_cycleAssociatedToClosedSubscheme_heq C _ _ (by push_cast; omega)

end ChowStep

/-! ### The case `X = X'` of [Stacks, Tag 0FA9] -/

open GenuineChern in
/-- **[Stacks, Tag 0FA9], for `X = X'`.** Let `ℰ` be finite locally free of rank `r` on `X`,
locally of finite type over the base, and `s ∈ Γ(X, ℰ)`. If `dim_δ X ≤ n`, `dim_δ Z(s) ≤ n - r`,
and at every generic point of `Z(s)` of `δ`-dimension `n - r` the ideal of `Z(s)` is generated by
a regular sequence of length `r`, then

  `c_r(ℰ) ∩ [X]_n = [Z(s)]_{n-r}`. -/
theorem chernCap_cap_fundamentalCycle_eq_zeroScheme (C : ChowSituation.{u}) {X : Scheme.{u}}
    (q : X ⟶ C.S) [LocallyOfFiniteType q] (E : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] (s : Γ(E, ⊤))
    (n : ℤ) (hX : schemeDeltaDimension C q ≤ (n : EInt))
    (hZ : schemeDeltaDimension C ((RegularSectionSequence.zeroScheme X E s).subschemeι ≫ q) ≤
      ((n - (r : ℤ) : ℤ) : EInt))
    (hreg : IsRegularSequenceOnZeroScheme C q E s r (n - (r : ℤ))) :
    chernCap C r q E n (Fin.last r)
        (QuotientAddGroup.mk' (rationalEquivalences C q n)
          (cycleAssociatedToClosedSubscheme C q (𝟙 X) n)) =
      QuotientAddGroup.mk' (rationalEquivalences C q (n - (r : ℤ)))
        (cycleAssociatedToClosedSubscheme C q (RegularSectionSequence.zeroScheme X E s).subschemeι
          (n - (r : ℤ))) := by
  suffices key : ∀ (r : ℕ) {X : Scheme.{u}} (q : X ⟶ C.S) [LocallyOfFiniteType q]
      (E : X.Modules) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
      (s : Γ(E, ⊤)) (n : ℤ), schemeDeltaDimension C q ≤ (n : EInt) →
      schemeDeltaDimension C ((RegularSectionSequence.zeroScheme X E s).subschemeι ≫ q) ≤
        ((n - (r : ℤ) : ℤ) : EInt) →
      IsRegularSequenceOnZeroScheme C q E s r (n - (r : ℤ)) →
      chernCap C r q E n (Fin.last r)
          (QuotientAddGroup.mk' (rationalEquivalences C q n)
            (cycleAssociatedToClosedSubscheme C q (𝟙 X) n)) =
        QuotientAddGroup.mk' (rationalEquivalences C q (n - (r : ℤ)))
          (cycleAssociatedToClosedSubscheme C q (RegularSectionSequence.zeroScheme X E s).subschemeι
            (n - (r : ℤ))) from
    key r q E s n hX hZ hreg
  intro r
  induction r with
  | zero =>
    intro X q _ E _ s n _ _ _
    exact chernCap_zero_cap_fundamentalCycle_eq_zeroScheme C q E s n
  | succ k ih =>
    cases k with
    | zero =>
      intro X q _ E _ s n hX hZ hreg
      exact chernCap_one_cap_fundamentalCycle_eq_zeroScheme C q E s n hX hZ hreg
    | succ m =>
      intro X q _ E _ s n hX hZ hreg
      have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E :=
        SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree E (m + 1 + 1)
      exact chernCap_cap_fundamentalCycle_eq_zeroScheme_of_succ C q E m ih s n hX hZ hreg

end Stacks.Chow

