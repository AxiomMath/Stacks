module

public import StacksFrontier.AlgebraicGeometry.Chow.RationalEquivalence.IntersectionInvertibleSheaf
public import StacksFrontier.AlgebraicGeometry.Chow.ChernCap42.DivisorOfSectionCycle
public import StacksFrontier.AlgebraicGeometry.Chow.GysinCartierIntersection
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartier.UFDExtension
public import StacksFrontier.RingTheory.Sequence.BaseChange

/-!
# Regularity conditions on stalks for the zero scheme of a section

Two local facts used in the proof of [Stacks, Tag 0FA9].

* Let `ℒ` be an invertible module and `σ` a section of it. If the ideal that the zero scheme
  `Z(σ)` cuts out in the local ring at a point `x` is generated by a nonzerodivisor, then
  multiplication by `σ` is injective on the stalk at `x`. This is the form in which the third
  hypothesis of [Stacks, Tag 02SQ] is checked: at `r = 1` it is the regular-sequence hypothesis of
  Tag 0FA9, read at length one.
* Regular sequences generating the ideal of a closed subscheme at a point pull back along a flat
  morphism to regular sequences generating the ideal of its inverse image ([Stacks, Tag 00LM]).

## Main results

* `Stacks.Chow.injective_stalk_unitHomEquiv_symm_of_ker_eq_span` — the first fact.
* `Stacks.Chow.exists_isRegular_stalk_comap_of_flat` — the second fact.

## References

* [Stacks Project, Tag 0FA9](https://stacks.math.columbia.edu/tag/0FA9)
* [Stacks Project, Tag 02SQ](https://stacks.math.columbia.edu/tag/02SQ)
* [Stacks Project, Tag 00LM](https://stacks.math.columbia.edu/tag/00LM)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

universe u

namespace Stacks.Chow

/-- In a commutative ring two generators of the same principal ideal, one of them a
nonzerodivisor, differ by a unit; in particular the other one is a nonzerodivisor too. -/
theorem isSMulRegular_of_span_singleton_eq {R : Type*} [CommRing R] {a b : R}
    (ha : IsSMulRegular R a) (h : Ideal.span {b} = Ideal.span {a}) : IsSMulRegular R b := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (h ▸ Ideal.mem_span_singleton_self b)
  obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp (h.symm ▸ Ideal.mem_span_singleton_self a)
  have hdc : d * c = 1 := by
    refine ha (show a • (d * c) = a • (1 : R) by
      simp only [smul_eq_mul]
      rw [mul_one, mul_comm, mul_assoc, hc, hd])
  have hunit : IsUnit c := ⟨⟨c, d, by rw [mul_comm]; exact hdc, hdc⟩, rfl⟩
  rw [← hc]
  exact (hunit.isSMulRegular R).mul ha

/-- **Multiplication by a section is injective at a point where its zero scheme is cut out by a
nonzerodivisor.** Let `ℒ` be invertible, `σ` a section of `ℒ` and `z` a point of the zero scheme
`Z(σ)`. If the kernel of `𝒪_{X, z} ⟶ 𝒪_{Z(σ), z}` is generated by a nonzerodivisor `a`, then
`r ↦ r σ` is injective on the stalk at `z`.

Over a trivializing affine open the section is `b · e` for a frame `e`, and the kernel is
generated by the germ of `b`; so that germ is a unit multiple of `a`, hence a nonzerodivisor, and
the germ of `e` is a basis of the stalk of `ℒ`. -/
theorem injective_stalk_unitHomEquiv_symm_of_ker_eq_span {X : Scheme.{u}} (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (σ : L.sections) (z : (Stacks.Divisors.zeroScheme X L (σ.eval (op ⊤))).subscheme)
    (a : X.presheaf.stalk ((Stacks.Divisors.zeroScheme X L (σ.eval (op ⊤))).subschemeι z))
    (ha : IsSMulRegular (X.presheaf.stalk
      ((Stacks.Divisors.zeroScheme X L (σ.eval (op ⊤))).subschemeι z)) a)
    (hker : RingHom.ker
      ((Stacks.Divisors.zeroScheme X L (σ.eval (op ⊤))).subschemeι.stalkMap z).hom =
        Ideal.span {a}) :
    Function.Injective (ConcreteCategory.hom
      ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u}
        ((Stacks.Divisors.zeroScheme X L (σ.eval (op ⊤))).subschemeι z)).map
        ((Scheme.Modules.toPresheaf X).map (L.unitHomEquiv.symm σ)))) := by
  set x := (Stacks.Divisors.zeroScheme X L (σ.eval (op ⊤))).subschemeι z with hx
  obtain ⟨U, eU, -, hxU, -⟩ := Stacks.Chow.exists_affine_frame_subset X L x ⊤ trivial
  set eΓ := Stacks.Divisors.frameSections X L eU with heΓ
  set b : Γ(X, U.1) := eΓ (L.presheaf.map (homOfLE le_top).op (σ.eval (op ⊤))) with hb
  have hkerb := Stacks.Chow.ker_zeroScheme_stalkMap_of_frame X L σ U eU z hxU
  have hbreg : IsSMulRegular (X.presheaf.stalk x) ((X.presheaf.germ U.1 x hxU).hom b) :=
    isSMulRegular_of_span_singleton_eq ha (hkerb.symm.trans hker)
  have hbasis := Stacks.ChernCap42.isStalkBasis_germ_frameSections L eU x hxU
  have hσx : TopCat.Presheaf.germ (C := AddCommGrpCat.{u}) L.val.presheaf ⊤ x trivial
      (σ.eval (op ⊤)) =
      (X.presheaf.germ U.1 x hxU).hom b •
        L.presheaf.germ U.1 x hxU (eΓ.symm 1) := by
    rw [← TopCat.Presheaf.germ_res_apply L.val.presheaf
      (homOfLE (show U.1 ≤ ⊤ from le_top)) x hxU (σ.eval (op ⊤))]
    exact Stacks.ChernCap42.germ_restrict_eq_smul L (σ.eval (op ⊤)) hxU eΓ
  change Function.Injective (LocallyFreeRank.stalkLMap (L.unitHomEquiv.symm σ).val x)
  intro r t hrt
  rw [stalkLMap_unitHomEquiv_symm_apply L σ x r, stalkLMap_unitHomEquiv_symm_apply L σ x t,
    hσx] at hrt
  have h1 : (structureSheafStalkLinearEquiv X x r * (X.presheaf.germ U.1 x hxU).hom b) •
        L.presheaf.germ U.1 x hxU (eΓ.symm 1) =
      (structureSheafStalkLinearEquiv X x t * (X.presheaf.germ U.1 x hxU).hom b) •
        L.presheaf.germ U.1 x hxU (eΓ.symm 1) := by
    rw [mul_smul, mul_smul]
    exact hrt
  replace h1 := hbasis.injective h1
  have h2 : structureSheafStalkLinearEquiv X x r = structureSheafStalkLinearEquiv X x t := by
    refine hbreg ?_
    change (X.presheaf.germ U.1 x hxU).hom b * structureSheafStalkLinearEquiv X x r =
      (X.presheaf.germ U.1 x hxU).hom b * structureSheafStalkLinearEquiv X x t
    rw [mul_comm _ (structureSheafStalkLinearEquiv X x r),
      mul_comm _ (structureSheafStalkLinearEquiv X x t)]
    exact h1
  exact (structureSheafStalkLinearEquiv X x).injective h2

/-! ### Regular sequences along a flat morphism -/

/-- **Regular sequences generating the ideal of a closed subscheme pull back along flat
morphisms** ([Stacks, Tag 00LM]). Let `g : Y ⟶ X` be flat, `I` an ideal sheaf on `X` and `y` a
point of `Y`. If the stalk of `I` at `g y` is generated by a regular sequence of length `r`, so is
the stalk of `g⁻¹ I` at `y`: the images of the members of the sequence. -/
theorem exists_isRegular_stalk_comap_of_flat {X Y : Scheme.{u}} (I : X.IdealSheafData)
    (g : Y ⟶ X) [Flat g] (y : Y) (rs : List (X.presheaf.stalk (g y)))
    (hreg : RingTheory.Sequence.IsRegular (X.presheaf.stalk (g y)) rs)
    (hspan : Ideal.ofList rs = IdealSheafData.stalk I (g y)) :
    ∃ rs' : List (Y.presheaf.stalk y), rs'.length = rs.length ∧
      RingTheory.Sequence.IsRegular (Y.presheaf.stalk y) rs' ∧
      Ideal.ofList rs' = IdealSheafData.stalk (I.comap g) y := by
  let : Algebra (X.presheaf.stalk (g y)) (Y.presheaf.stalk y) := (g.stalkMap y).hom.toAlgebra
  have : Module.Flat (X.presheaf.stalk (g y)) (Y.presheaf.stalk y) :=
    AlgebraicGeometry.Flat.stalkMap g y
  have : IsLocalHom (algebraMap (X.presheaf.stalk (g y)) (Y.presheaf.stalk y)) :=
    inferInstanceAs (IsLocalHom (g.stalkMap y).hom)
  have : Module.FaithfullyFlat (X.presheaf.stalk (g y)) (Y.presheaf.stalk y) :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom
  refine ⟨rs.map (g.stalkMap y).hom, by simp, ?_, ?_⟩
  · exact (RingTheory.Sequence.isRegular_map_algebraMap_iff_of_faithfullyFlat_of_isBaseChange
      (IsBaseChange.linearMap _ _) rs).mpr hreg
  · rw [AlgebraicGeometry.stalk_comap I g y, ← hspan, Ideal.map_ofList]

end Stacks.Chow

end
