/-!
# The hyperplane section of the projective bundle cut out by a section

Let `ℰ` be a finite locally free module on a scheme `X`, `π : P = 𝐏(ℰ) ⟶ X` its projective bundle
with tautological quotient `π^*ℰ ⟶ 𝒪_P(1)`, and `s ∈ Γ(X, ℰ)`. The image `t` of `π^* s` in
`Γ(P, 𝒪_P(1))` cuts out a closed subscheme `Z(t) ⊆ P` containing `π⁻¹ Z(s)`. Over the open
`X ∖ Z(s)` the section `s` is nowhere zero, and there `Z(t)` is the projective bundle of the
quotient `ℰ / 𝒪 s`, an effective Cartier divisor. This is the input the proof of
[Stacks, Tag 0FA9] needs about `Z(t)`: at every point of `Z(t)` not lying over `Z(s)` the ideal
of `Z(t)` in the local ring is generated by a nonzerodivisor.

The computation is made chart by chart. Over an affine open `V ⊆ X` the bundle is
`Proj Γ(V, Sym ℰ)`, and `Z(t)` is the hyperplane of the degree-one element `s|_V`
(`Stacks.Chow.GenuineChern.comap_chart_zeroScheme_bundleSection`, read for the morphism
`𝒪_X ⟶ ℰ` defined by `s`); if a linear functional takes the value `1` at `s|_V`, then `s|_V` is
a nonzerodivisor of `Sym Γ(V, ℰ)` (`Stacks.Chow.GenuineChern.isRegular_ι_of_eq_one`), and its
hyperplane is an effective Cartier divisor.

## Main definitions

* `Stacks.Chow.bundleHyperplaneSection` — the section `t` of `𝒪_P(1)`.

## Main results

* `Stacks.Chow.zeroScheme_homSection_eq_bundleHyperplaneSection` — the zero scheme of `t` is the
  zero scheme of the section attached to `π^*𝒪_X ⟶ 𝒪_P(1)`.
* `Stacks.Chow.exists_isSMulRegular_ker_stalkMap_bundleHyperplane` — off `π⁻¹ Z(s)`, the ideal
  of `Z(t)` in the local ring is generated by a nonzerodivisor.

## References

* [Stacks Project, Tag 0FA9](https://stacks.math.columbia.edu/tag/0FA9)
* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.SymGraded Stacks.AlgebraicGeometry.RelativeProj
open Stacks.AlgebraicGeometry.RelativeProjDegreeOne

universe u

namespace Stacks.Chow

variable {X : Scheme.{u}} (E : X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]

/-- **The section `t ∈ Γ(𝐏(ℰ), 𝒪(1))` of a section `s ∈ Γ(X, ℰ)`**: the image of `π^* s` under
the tautological quotient `π^*ℰ ⟶ 𝒪(1)`. -/
def bundleHyperplaneSection (s : Γ(E, ⊤)) : Γ(bundleTwist E, ⊤) :=
  Scheme.Modules.Hom.app (bundleTautological E) ⊤ (pullbackGlobalSections (bundleProj E) E s)

/-- The structure sheaf of `X`, as an `𝒪_X`-module. -/
abbrev unitModuleOf (X : Scheme.{u}) : X.Modules :=
  _root_.SheafOfModules.unit (structureSheaf X.sheaf)

/-- The structure sheaf of `X` is an invertible `𝒪_X`-module. -/
instance isInvertible_unitModuleOf (X : Scheme.{u}) :
    AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property
      (unitModuleOf X) :=
  AlgebraicGeometry.SheafOfModules.isInvertible_unit X.presheaf X.ringCatSheaf.2

/-- The morphism `𝒪_X ⟶ ℰ` defined by a global section. -/
def sectionHom (s : Γ(E, ⊤)) : unitModuleOf X ⟶ E :=
  E.unitHomEquiv.symm (Stacks.SheafOfModules.sectionsOfTopOfRingSheaf E s)

/-- Restriction along an equality of opens that holds by definition is the identity. -/
theorem map_homOfLE_self {Y : Scheme.{u}} (M : Y.Modules) {U : Y.Opens} (h : U ≤ U)
    (y : Γ(M, U)) : M.presheaf.map (homOfLE h).op y = y :=
  (ConcreteCategory.congr_hom (M.presheaf.map_id (op U)) y).trans (CategoryTheory.id_apply y)

omit [SheafOfModules.IsFiniteLocallyFree E] in
/-- The morphism `𝒪_X ⟶ ℰ` defined by a global section sends `1` to the section. -/
theorem sectionHom_app_one (s : Γ(E, ⊤)) :
    Scheme.Modules.Hom.app (sectionHom E s) ⊤ (1 : Γ(X, ⊤)) = s := by
  have h := congrArg (fun σ : E.sections => σ.eval (op ⊤))
    (E.unitHomEquiv.apply_symm_apply (Stacks.SheafOfModules.sectionsOfTopOfRingSheaf E s))
  exact h.trans (Stacks.SheafOfModules.sectionsOfTopOfRingSheaf_eval_top E s)

/-- A finite locally free module is quasi-coherent. -/
private theorem isQuasicoherent_aux : E.IsQuasicoherent :=
  Stacks.AlgebraicGeometry.CoherenceCriteria.isQuasicoherent_of_isFiniteLocallyFree E

/-- The three invertible modules on `𝐏(ℰ)` involved in the section `π^*s ≫ τ`. -/
private theorem isInvertible_triple_aux (s : Γ(E, ⊤)) :
    ∃ (_ : AlgebraicGeometry.SheafOfModules.IsInvertible (bundle E).sheaf.obj
      (bundle E).ringCatSheaf.property ((Scheme.Modules.pullback
        (relativeProj (schemeSheafGradedAlgebra E (bundlePieces E))).toBase).obj
          (unitModuleOf X)))
    (_ : AlgebraicGeometry.SheafOfModules.IsInvertible (bundle E).sheaf.obj
      (bundle E).ringCatSheaf.property
        (Stacks.ProjectiveBundleSplitting.tautologicalTwist E (bundlePieces E))),
    AlgebraicGeometry.SheafOfModules.IsInvertible (bundle E).sheaf.obj
      (bundle E).ringCatSheaf.property (GenuineChern.homSectionModule _ _
        (GenuineChern.bundleSectionHom E (bundlePieces E) (unitModuleOf X)
          (sectionHom E s))) := by
  have h₁ : AlgebraicGeometry.SheafOfModules.IsInvertible (bundle E).sheaf.obj
      (bundle E).ringCatSheaf.property _ :=
    Stacks.Chow.isInvertible_presheaf_modulePullback (unitModuleOf X)
    (relativeProj (schemeSheafGradedAlgebra E (bundlePieces E))).toBase
  have h₂ : AlgebraicGeometry.SheafOfModules.IsInvertible (bundle E).sheaf.obj
      (bundle E).ringCatSheaf.property
        (Stacks.ProjectiveBundleSplitting.tautologicalTwist E (bundlePieces E)) :=
    isInvertible_bundleTwist E
  exact ⟨h₁, h₂, GenuineChern.isInvertible_homSectionModule _ _ _⟩

/-- **The hyperplane section is the section attached to `π^*𝒪_X ⟶ 𝒪(1)`.** The zero scheme of
`t` is the zero scheme of the section of `𝒪(1) ⊗ π^*𝒪_X^{-1}` attached to `π^*s ≫ τ`, the form in
which the chart description of `Stacks.Chow.GenuineChern.comap_chart_zeroScheme_bundleSection`
is stated. -/
theorem zeroScheme_homSection_eq_bundleHyperplaneSection (s : Γ(E, ⊤)) :
    letI : AlgebraicGeometry.SheafOfModules.IsInvertible (bundle E).sheaf.obj
        (bundle E).ringCatSheaf.property ((Scheme.Modules.pullback
          (relativeProj (schemeSheafGradedAlgebra E (bundlePieces E))).toBase).obj
            (unitModuleOf X)) :=
      Stacks.Chow.isInvertible_presheaf_modulePullback (unitModuleOf X) _
    letI : AlgebraicGeometry.SheafOfModules.IsInvertible (bundle E).sheaf.obj
        (bundle E).ringCatSheaf.property
          (Stacks.ProjectiveBundleSplitting.tautologicalTwist E (bundlePieces E)) :=
      isInvertible_bundleTwist E
    letI : AlgebraicGeometry.SheafOfModules.IsInvertible (bundle E).sheaf.obj
        (bundle E).ringCatSheaf.property (GenuineChern.homSectionModule _ _
          (GenuineChern.bundleSectionHom E (bundlePieces E) (unitModuleOf X) (sectionHom E s))) :=
      GenuineChern.isInvertible_homSectionModule _ _ _
    Stacks.Divisors.zeroScheme (bundle E)
        (GenuineChern.homSectionModule _ _
          (GenuineChern.bundleSectionHom E (bundlePieces E) (unitModuleOf X) (sectionHom E s)))
        ((GenuineChern.homSection _ _
          (GenuineChern.bundleSectionHom E (bundlePieces E) (unitModuleOf X)
            (sectionHom E s))).eval (op ⊤)) =
      Stacks.Divisors.zeroScheme (bundle E) (bundleTwist E) (bundleHyperplaneSection E s) := by
  obtain ⟨_, _, _⟩ := isInvertible_triple_aux E s
  have := isQuasicoherent_aux E
  have : AlgebraicGeometry.SheafOfModules.IsInvertible (bundle E).sheaf.obj
      (bundle E).ringCatSheaf.property ((𝟭 (bundle E).Modules).obj (bundleTwist E)) :=
    isInvertible_bundleTwist E
  set φ := GenuineChern.bundleSectionHom E (bundlePieces E) (unitModuleOf X) (sectionHom E s)
    with hφ
  have hj : (⊤ : (bundle E).Opens) ≤ 𝟙 (bundle E) ⁻¹ᵁ bundleProj E ⁻¹ᵁ ⊤ := le_top
  have h := GenuineChern.comap_zeroScheme_homSection_of_generator (bundleTwist E) (bundleProj E)
    (unitModuleOf X) ⊤
    (Stacks.SheafOfModules.generatorOfIso (unitModuleOf X) (Iso.refl _)) (𝟙 _) hj φ
  rw [Scheme.IdealSheafData.comap_id] at h
  refine h.trans (AlgebraicGeometry.zeroScheme_eq_of_iso
    ((Scheme.Modules.pullbackId (bundle E)).app (bundleTwist E)) ?_)
  set N := (Scheme.Modules.pullback (bundleProj E)).obj (unitModuleOf X) with hN
  set x := unitSection (bundleProj E) (unitModuleOf X) ⊤
    (Stacks.SheafOfModules.generatorOfIso (unitModuleOf X) (Iso.refl _) (U := ⊤)).val with hx
  set y := ((Scheme.Modules.pullback (𝟙 (bundle E))).obj N).val.map (homOfLE hj).op
      (unitSection (𝟙 (bundle E)) N (bundleProj E ⁻¹ᵁ ⊤) x) with hy
  -- move the identification with the pullback along the identity past `φ`
  have h1 : Scheme.Modules.Hom.app ((Scheme.Modules.pullbackId (bundle E)).hom.app
        (bundleTwist E)) ⊤ (Scheme.Modules.Hom.app ((Scheme.Modules.pullback (𝟙 (bundle E))).map φ)
          ⊤ y) =
      Scheme.Modules.Hom.app φ ⊤
        (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackId (bundle E)).hom.app N) ⊤ y) := by
    have hnat : (Scheme.Modules.pullback (𝟙 (bundle E))).map φ ≫
        (Scheme.Modules.pullbackId (bundle E)).hom.app (bundleTwist E) =
          (Scheme.Modules.pullbackId (bundle E)).hom.app N ≫ φ :=
      (Scheme.Modules.pullbackId (bundle E)).hom.naturality φ
    have h := congrArg (fun ψ : (Scheme.Modules.pullback (𝟙 (bundle E))).obj N ⟶ bundleTwist E =>
      Scheme.Modules.Hom.app ψ ⊤ y) hnat
    exact h
  -- the identification on the restricted pulled-back section
  have h2 : Scheme.Modules.Hom.app ((Scheme.Modules.pullbackId (bundle E)).hom.app N) ⊤ y =
      N.val.map (homOfLE hj).op x := by
    refine (PresheafOfModules.naturality_apply
      ((Scheme.Modules.pullbackId (bundle E)).hom.app N).val (homOfLE hj).op _).trans ?_
    exact congrArg _ (GenuineChern.pullbackId_hom_unitSection (bundle E) N _ x)
  -- through `φ = π^* f ≫ τ`
  have h3 : Scheme.Modules.Hom.app φ ⊤ (N.val.map (homOfLE hj).op x) =
      Scheme.Modules.Hom.app (Stacks.ProjectiveBundleSplitting.tautologicalMap E (bundlePieces E))
        ⊤ (((Scheme.Modules.pullback (bundleProj E)).obj E).val.map (homOfLE hj).op
          (unitSection (bundleProj E) E ⊤ s)) := by
    change Scheme.Modules.Hom.app (Stacks.ProjectiveBundleSplitting.tautologicalMap E
      (bundlePieces E)) ⊤ (Scheme.Modules.Hom.app ((Scheme.Modules.pullback (bundleProj E)).map
        (sectionHom E s)) ⊤ (N.val.map (homOfLE hj).op x)) = _
    congr 1
    refine (PresheafOfModules.naturality_apply
      ((Scheme.Modules.pullback (bundleProj E)).map (sectionHom E s)).val (homOfLE hj).op x).trans
        ?_
    refine congrArg _ ((GenuineChern.unitSection_pullback_map (bundleProj E) (sectionHom E s) ⊤
      _).trans ?_)
    congr 1
    exact sectionHom_app_one E s
  refine h1.trans ((congrArg _ h2).trans (h3.trans ?_))
  change _ = Scheme.Modules.Hom.app
    (Stacks.ProjectiveBundleSplitting.tautologicalMap E (bundlePieces E)) ⊤
      (pullbackGlobalSections (bundleProj E) E s)
  congr 1

/-- **The hyperplane section on a chart.** Over an affine open `V` of `X`, the inverse image of
`Z(t)` along the chart `Proj Γ(V, Sym ℰ) ⟶ 𝐏(ℰ)` is the hyperplane of the degree-one element
`s|_V` of `Γ(V, Sym ℰ)`. -/
theorem comap_chart_zeroScheme_bundleHyperplaneSection (s : Γ(E, ⊤)) (V : X.Opens)
    (hV : IsAffineOpen V) :
    haveI : E.IsQuasicoherent :=
      Stacks.AlgebraicGeometry.CoherenceCriteria.isQuasicoherent_of_isFiniteLocallyFree E
    letI := Stacks.AlgebraicGeometry.RelativeProjTwistGlue.isOpenImmersion_chart
      (relativeProj (schemeSheafGradedAlgebra E (bundlePieces E))) V hV
    haveI := algebraicGeometry_isInvertible_twistingSheaf
      ((schemeSheafGradedAlgebra E (bundlePieces E)).grading V)
      (adjoin_grading_one_eq_top E V (bundlePieces E) hV) ((1 : ℕ) : ℤ)
    (Stacks.Divisors.zeroScheme (bundle E) (bundleTwist E) (bundleHyperplaneSection E s)).comap
        ((relativeProj (schemeSheafGradedAlgebra E (bundlePieces E))).chart V hV) =
      Stacks.Divisors.zeroScheme (Proj ((schemeSheafGradedAlgebra E (bundlePieces E)).grading V))
        (twistingSheafModule ((schemeSheafGradedAlgebra E (bundlePieces E)).grading V)
          ((1 : ℕ) : ℤ))
        (degreeSection ((schemeSheafGradedAlgebra E (bundlePieces E)).grading V) 1
          ⟨DirectSum.of ((schemeSheafGradedAlgebra E (bundlePieces E)).sectionPieces V) 1
            ((Scheme.Modules.symmetricAlgebraGen X E).val.app (op V)
              (E.presheaf.map (homOfLE le_top).op s)),
            (schemeSheafGradedAlgebra E (bundlePieces E)).of_mem_grading V _⟩) := by
  have := isQuasicoherent_aux E
  obtain ⟨_, _, _⟩ := isInvertible_triple_aux E s
  rw [← zeroScheme_homSection_eq_bundleHyperplaneSection E s]
  have h := GenuineChern.comap_chart_zeroScheme_bundleSection E (bundlePieces E) (unitModuleOf X)
    (sectionHom E s) V hV (Stacks.SheafOfModules.generatorOfIso (unitModuleOf X) (Iso.refl _))
  refine h.trans ?_
  congr 5
  have h1 := PresheafOfModules.naturality_apply (sectionHom E s).val
    (homOfLE (le_top : V ≤ ⊤)).op (1 : Γ(X, ⊤))
  refine Eq.trans ?_ (h1.trans (congrArg _ (sectionHom_app_one E s)))
  congr 1
  exact (map_one (X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom).symm


/-- **Off `π⁻¹ Z(s)`, the hyperplane section is cut out by a nonzerodivisor.** At every point `x`
of `𝐏(ℰ)` not lying over the zero scheme of `s`, the stalk at `x` of the ideal of `Z(t)` is
generated by a nonzerodivisor of `𝒪_{𝐏(ℰ), x}`.

Over an affine open `V ∋ π x` on which a linear functional takes the value `1` at `s|_V`
(`Stacks.RegularSectionSequence.exists_linearMap_eq_one_of_notMem_support`), the degree-one
element `s|_V` of `Γ(V, Sym ℰ)` is a nonzerodivisor
(`Stacks.Chow.GenuineChern.isRegular_ι_of_eq_one`), so the hyperplane it cuts out on the chart
over `V` is an effective Cartier divisor, and the chart is an open immersion. -/
theorem exists_isSMulRegular_stalk_bundleHyperplane (s : Γ(E, ⊤)) (x : bundle E)
    (hx : bundleProj E x ∉ (Stacks.RegularSectionSequence.zeroScheme X E s).support) :
    ∃ a : (bundle E).presheaf.stalk x, IsSMulRegular ((bundle E).presheaf.stalk x) a ∧
      IdealSheafData.stalk
        (Stacks.Divisors.zeroScheme (bundle E) (bundleTwist E) (bundleHyperplaneSection E s)) x =
        Ideal.span {a} := by
  have := isQuasicoherent_aux E
  have : E.IsFinitePresentation :=
    AlgebraicGeometry.SheafOfModules.isFinitePresentation_of_isFiniteLocallyFree E inferInstance
  obtain ⟨V, hyV, l, hl⟩ :=
    Stacks.RegularSectionSequence.exists_linearMap_eq_one_of_notMem_support E s hx
  let := Stacks.AlgebraicGeometry.RelativeProjTwistGlue.isOpenImmersion_chart
    (relativeProj (schemeSheafGradedAlgebra E (bundlePieces E))) V.1 V.2
  have := algebraicGeometry_isInvertible_twistingSheaf
    ((schemeSheafGradedAlgebra E (bundlePieces E)).grading V.1)
    (adjoin_grading_one_eq_top E V.1 (bundlePieces E) V.2) ((1 : ℕ) : ℤ)
  set c := (relativeProj (schemeSheafGradedAlgebra E (bundlePieces E))).chart V.1 V.2 with hc
  set D := Stacks.Divisors.zeroScheme (bundle E) (bundleTwist E) (bundleHyperplaneSection E s)
    with hD
  -- the point lies in the image of the chart over `V`
  have hxc : x ∈ c ''ᵁ ⊤ := by
    have h := Stacks.AlgebraicGeometry.RelativeProjTwistGlue.chart_image_top
      (relativeProj (schemeSheafGradedAlgebra E (bundlePieces E))) V.1 V.2
    have hmem : x ∈ (relativeProj (schemeSheafGradedAlgebra E (bundlePieces E))).toBase ⁻¹ᵁ V.1 :=
      hyV
    rw [← h] at hmem
    exact hmem
  obtain ⟨w, -, rfl⟩ := hxc
  -- the hyperplane of a nonzerodivisor is an effective Cartier divisor on the chart
  set t' : (schemeSheafGradedAlgebra E (bundlePieces E)).grading V.1 1 :=
    ⟨DirectSum.of ((schemeSheafGradedAlgebra E (bundlePieces E)).sectionPieces V.1) 1
      ((Scheme.Modules.symmetricAlgebraGen X E).val.app (op V.1)
        (E.presheaf.map (homOfLE le_top).op s)),
      (schemeSheafGradedAlgebra E (bundlePieces E)).of_mem_grading V.1 _⟩ with ht'
  have hreg : IsRegular
      (t' : (schemeSheafGradedAlgebra E (bundlePieces E)).sectionRing V.1) := by
    have h := Stacks.SymGraded.AffinePieces.symSectionRingEquiv_of_symmetricAlgebraGen E V.2
      (bundlePieces E) (E.presheaf.map (homOfLE le_top).op s)
    have hι := GenuineChern.isRegular_ι_of_eq_one (E.presheaf.map (homOfLE le_top).op s) l hl
    rw [← h] at hι
    have h2 := GenuineChern.isRegular_ringEquiv
      (Stacks.SymGraded.AffinePieces.symSectionRingEquiv E V.2 (bundlePieces E)).symm hι
    rwa [RingEquiv.symm_apply_apply] at h2
  have hEff := GenuineChern.isEffectiveCartierDivisor_zeroScheme_degreeSection
    ((schemeSheafGradedAlgebra E (bundlePieces E)).grading V.1)
    (adjoin_grading_one_eq_top E V.1 (bundlePieces E) V.2) t' hreg
  rw [← comap_chart_zeroScheme_bundleHyperplaneSection E s V.1 V.2] at hEff
  obtain ⟨a', ha', hstalk⟩ :=
    AlgebraicGeometry.exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor _ hEff w
  rw [AlgebraicGeometry.stalk_comap D c w] at hstalk
  -- transport along the isomorphism of local rings of the open immersion
  have hbij : Function.Bijective (c.stalkMap w).hom := ConcreteCategory.bijective_of_isIso _
  obtain ⟨b, hb⟩ := hbij.2 a'
  refine ⟨b, (GenuineChern.isRegular_of_injective _ hbij.1 (hb ▸ ha')).left.isSMulRegular, ?_⟩
  have h1 : (IdealSheafData.stalk D (c w)).map (c.stalkMap w).hom = Ideal.span {a'} := hstalk
  have h2 : (Ideal.span {b}).map (c.stalkMap w).hom = Ideal.span {a'} := by
    rw [Ideal.map_span, Set.image_singleton, hb]
  exact (Ideal.comap_map_of_bijective _ hbij).symm.trans
    ((congrArg (Ideal.comap (c.stalkMap w).hom) (h1.trans h2.symm)).trans
      (Ideal.comap_map_of_bijective _ hbij))

end Stacks.Chow

end
