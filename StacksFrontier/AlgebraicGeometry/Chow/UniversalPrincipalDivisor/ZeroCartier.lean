module

public import StacksFrontier.AlgebraicGeometry.Chow.UniversalPrincipalDivisor.ZeroIdeal
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.Divisors.RegularImmersion.FibrePrincipalDictionary
public import Mathlib.AlgebraicGeometry.AffineSpace
public import Mathlib.Algebra.MvPolynomial.Equiv

/-!
# The zero divisor of `ℙ¹_S` is an effective Cartier divisor

Let `S` be a scheme and `D₀ ⊆ ℙ¹_S` the zero divisor, the closed subscheme cut out by the
kernel ideal sheaf of the zero section. `Stacks.Chow.zeroDivisor_ideal_comap_affineChart` says
that on every affine open of the chart `𝔸¹_S` the ideal of `D₀` is generated by the coordinate
`T`, and the affine-local criterion for an effective Cartier divisor, Tag 01WS
(`Stacks.Divisors.isEffectiveCartierDivisor_iff_affineLocal`), asks for a generator that is a
*nonzerodivisor*. This file supplies that missing half and concludes that `D₀` is an effective
Cartier divisor, which is the part of Tag 02RQ (3) about the zero divisor.

`T` is a nonzerodivisor for the reason one expects: over an affine open `W ⊆ S` the inverse
image of `W` in `𝔸¹_S` is `Spec Γ(S, W)[T]`, and `T` is a nonzerodivisor in a polynomial ring.
Rather than proving that identification from scratch, this file crosses to Mathlib's
`AlgebraicGeometry.AffineSpace`, which is literally the same pullback with
`MvPolynomial PUnit (ULift ℤ)` in place of `Polynomial (ULift ℤ)`, and already carries the
affine charts (`AffineSpace.isPullback_map`, `AffineSpace.isoOfIsAffine`) and the coordinate
calculus (`AffineSpace.map_appTop_coord`).

## Main definitions

* `Stacks.Chow.mvPolyPUnitIso`: the crossing `ℤ[PUnit] ≅ ℤ[T]` of integral models, built from
  `MvPolynomial.uniqueAlgEquiv`.
* `Stacks.Chow.affineLineToAffineSpace`: the comparison `𝔸¹_S ⟶ 𝔸(PUnit; S)`, defined by
  `AffineSpace.homOfVector` from the projection and the coordinate `T`, and therefore compatible
  with both by construction.

## Main results

* `Stacks.Chow.isIso_affineLineToAffineSpace`: **the affine line of this chapter is Mathlib's
  one-dimensional affine space.** Both are pullbacks of the same cospan up to the crossing of
  integral models.
* `Stacks.Chow.isRegular_coord`: over an affine base the coordinates of `𝔸(n; S)` are
  nonzerodivisors.
* `Stacks.Chow.exists_affineOpens_isRegular_affineCoordinate`: every point of `𝔸¹_S` has an
  affine open neighbourhood on which `T` is a nonzerodivisor.
* `Stacks.Chow.lineZeroDivisor_isEffectiveCartierDivisor`: **`D₀` is an effective Cartier
  divisor.**

## Implementation notes

The criterion is applied in the form
`Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen`, which asks for a
principal-on-a-nonzerodivisor presentation around *every* point of `ℙ¹_S`, not only the points
of the support. Away from the chart there is nothing to do: the support of `D₀` is the image of
the zero section, which factors through the chart, so
`Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_notMem_support` applies there.

The crossing is used only through `AffineSpace.homOfVector`, whose two characterizing
equations (`homOfVector_over` and `homOfVector_appTop_coord`) are exactly the compatibility
with the projection and with `Stacks.Chow.affineCoordinate`; the isomorphism property is then a
comparison of two pullback squares. No transport of the divisor itself is needed.

What this file does **not** supply is the companion statement for `D_∞`. That needs the second
chart of `ℙ¹_S` — the base change of `AlgebraicGeometry.projectiveLineYChart` — together with its
coordinate and the analogue of `Stacks.Chow.zeroDivisor_ideal_comap_affineChart` on it; on the
first chart `D_∞` is the unit ideal
(`Stacks.Chow.lineInfinityDivisor_ideal_comap_affineChart`) and carries no information about
its own support.

## References

* [Stacks Project, Tag 02RQ](https://stacks.math.columbia.edu/tag/02RQ)
* [Stacks Project, Tag 01WR](https://stacks.math.columbia.edu/tag/01WR)
* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Chow

/-! ### Nonzerodivisors transport along ring isomorphisms -/

private theorem isRegular_of_iso {A B : CommRingCat.{u}} (e : A ≅ B) {x : A}
    (hx : IsRegular x) : IsRegular (e.hom x) :=
  Stacks.Divisors.isRegular_ringEquiv e.commRingCatIsoToRingEquiv hx

private theorem isRegular_of_isIso_apply {A B : CommRingCat.{u}} (f : A ⟶ B) [IsIso f] {x : A}
    (hx : IsRegular (f x)) : IsRegular x := by
  have h := isRegular_of_iso (asIso f).symm hx
  simpa [← CommRingCat.comp_apply] using h

/-! ### Two computations with rings of sections -/

/-- Restricting a global section to the image of an open immersion and then reading it on the
source is the same as pulling it back. -/
private theorem appIso_top_hom_map_le_top {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f]
    (t : Γ(Y, ⊤)) :
    ((f.appIso (⊤ : X.Opens)).hom)
      (Y.presheaf.map (homOfLE (le_top (a := f ''ᵁ (⊤ : X.Opens)))).op t) = f.appTop t := by
  rw [← CommRingCat.comp_apply, Scheme.Hom.appIso_hom', Scheme.Hom.map_appLE,
    Scheme.Hom.appLE, show (homOfLE (le_top (a := (⊤ : X.Opens))) :
      (⊤ : X.Opens) ⟶ f ⁻¹ᵁ (⊤ : Y.Opens)) = 𝟙 _ from rfl]
  simp
  rfl

/-- Pulling a global section back and restricting is the same as restricting and pulling
back. -/
private theorem map_le_top_appTop {X Y : Scheme.{u}} (φ : X ⟶ Y) (V : Y.Opens) (t : Γ(Y, ⊤)) :
    X.presheaf.map (homOfLE (le_top (a := φ ⁻¹ᵁ V))).op (φ.appTop t) =
      (φ.app V) (Y.presheaf.map (homOfLE (le_top (a := V))).op t) := by
  rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.Hom.naturality]
  rfl

/-! ### The affine line as Mathlib's affine space -/

/-- The identification `ℤ[PUnit] ≅ ℤ[T]` of the one-variable multivariate polynomial ring
used by `AlgebraicGeometry.AffineSpace` with the integral model of the affine line. -/
def mvPolyPUnitIso :
    CommRingCat.of (MvPolynomial PUnit.{u + 1} (ULift.{u} ℤ)) ≅
      CommRingCat.of (Polynomial (ULift.{u} ℤ)) :=
  (MvPolynomial.uniqueAlgEquiv (ULift.{u} ℤ) PUnit.{u + 1}).toRingEquiv.toCommRingCatIso

/-- The comparison `𝔸¹_S ⟶ 𝔸(PUnit; S)` of the affine line of this chapter with Mathlib's
affine space, determined by sending the coordinate of the latter to `T`. -/
def affineLineToAffineSpace (S : Scheme.{u}) :
    affineLineOver S ⟶ 𝔸(PUnit.{u + 1}; S) :=
  AffineSpace.homOfVector (pullback.fst _ _) (fun _ => affineCoordinate S)

/-- The comparison carries the coordinate of `𝔸(PUnit; S)` to the coordinate `T`. -/
theorem affineLineToAffineSpace_appTop_coord (S : Scheme.{u}) (i : PUnit.{u + 1}) :
    (affineLineToAffineSpace S).appTop (AffineSpace.coord S i) = affineCoordinate S :=
  AffineSpace.homOfVector_appTop_coord _ _ _

/-- The comparison lies over `S`. -/
theorem affineLineToAffineSpace_over (S : Scheme.{u}) :
    affineLineToAffineSpace S ≫ (𝔸(PUnit.{u + 1}; S) ↘ S) = pullback.fst _ _ :=
  AffineSpace.homOfVector_over _ _

/-- On the integral models, the comparison is the crossing `ℤ[T] ≅ ℤ[PUnit]`. -/
theorem affineLineToAffineSpace_toSpecMvPoly (S : Scheme.{u}) :
    affineLineToAffineSpace S ≫ AffineSpace.toSpecMvPoly PUnit.{u + 1} S =
      pullback.snd (terminal.from S)
        (terminal.from (Spec (.of (Polynomial (ULift.{u} ℤ))))) ≫
          Spec.map mvPolyPUnitIso.hom := by
  rw [affineLineToAffineSpace, AffineSpace.homOfVector_toSpecMvPoly]
  apply (AffineSpace.toSpecMvPolyIntEquiv PUnit.{u + 1}).injective
  ext i
  have key : (Spec.map mvPolyPUnitIso.{u}.hom).appTop
      ((Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial PUnit.{u + 1} (ULift.{u} ℤ)))).inv
        (MvPolynomial.X i)) =
      (Scheme.ΓSpecIso (CommRingCat.of (Polynomial (ULift.{u} ℤ)))).inv Polynomial.X := by
    rw [← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.comp_apply]
    exact congrArg _ (MvPolynomial.eval₂_X _ _ _)
  rw [Equiv.apply_symm_apply, AffineSpace.toSpecMvPolyIntEquiv_comp,
    AffineSpace.toSpecMvPolyIntEquiv_apply, key]
  rfl

/-- **The affine line of this chapter is Mathlib's one-dimensional affine space.** -/
instance isIso_affineLineToAffineSpace (S : Scheme.{u}) :
    IsIso (affineLineToAffineSpace S) := by
  have h2 : IsPullback (Spec.map mvPolyPUnitIso.{u}.hom)
      (terminal.from (Spec (.of (Polynomial (ULift.{u} ℤ)))))
      (terminal.from (Spec (.of (MvPolynomial PUnit.{u + 1} (ULift.{u} ℤ)))))
      (𝟙 (⊤_ Scheme.{u})) :=
    IsPullback.of_horiz_isIso ⟨terminal.hom_ext _ _⟩
  have hA := ((IsPullback.of_hasPullback (terminal.from S)
    (terminal.from (Spec (.of (Polynomial (ULift.{u} ℤ)))))).flip.paste_horiz h2).flip
  rw [Category.comp_id] at hA
  have hB := IsPullback.of_hasPullback (terminal.from S)
    (terminal.from (Spec (.of (MvPolynomial PUnit.{u + 1} (ULift.{u} ℤ)))))
  have heq : affineLineToAffineSpace S = (hA.isoIsPullback _ _ hB).hom := by
    refine hB.hom_ext ?_ ?_
    · rw [IsPullback.isoIsPullback_hom_fst]
      exact affineLineToAffineSpace_over S
    · rw [IsPullback.isoIsPullback_hom_snd]
      exact affineLineToAffineSpace_toSpecMvPoly S
  rw [heq]
  exact Iso.isIso_hom _

/-! ### The coordinates of affine space are nonzerodivisors -/

/-- Over an affine base the coordinates of `𝔸(n; S)` are nonzerodivisors, because the ring of
global sections is then a polynomial ring. -/
theorem isRegular_coord {n : Type u} (W : Scheme.{u}) [IsAffine W] (i : n) :
    IsRegular (AffineSpace.coord W i) := by
  have : IsIso ((AffineSpace.isoOfIsAffine n W).inv.appTop) := by
    show IsIso ((AffineSpace.isoOfIsAffine n W).inv.app ⊤)
    infer_instance
  refine isRegular_of_isIso_apply ((AffineSpace.isoOfIsAffine n W).inv.appTop) ?_
  rw [AffineSpace.isoOfIsAffine_inv_appTop_coord]
  exact isRegular_of_iso (Scheme.ΓSpecIso _).symm MvPolynomial.isRegular_X

/-- The image of `𝔸(n; S) ⟶ 𝔸(n; T)` is the inverse image of the image of `S ⟶ T`. -/
theorem range_affineSpaceMap {n : Type u} {S T : Scheme.{u}} (f : S ⟶ T) :
    Set.range (AffineSpace.map n f) = (𝔸(n; T) ↘ T) ⁻¹' Set.range f := by
  have h := AffineSpace.isPullback_map (n := n) f
  rw [show AffineSpace.map n f = h.isoPullback.hom ≫ pullback.fst (𝔸(n; T) ↘ T) f from
      h.isoPullback_hom_fst.symm,
    range_comp_scheme, (surjective_of_isIso h.isoPullback.hom).range_eq, Set.image_univ,
    Scheme.Pullback.range_fst]

/-- **Every point of `𝔸(n; S)` has an affine neighbourhood on which a coordinate is a
nonzerodivisor**: the inverse image of an affine open of `S`, whose ring of sections is a
polynomial ring. -/
theorem exists_affineOpens_isRegular_coord {n : Type u} (S : Scheme.{u}) (i : n)
    (w : 𝔸(n; S)) :
    ∃ V : (𝔸(n; S)).affineOpens, w ∈ (V : Set 𝔸(n; S)) ∧
      IsRegular ((𝔸(n; S)).presheaf.map (homOfLE (le_top (a := V.1))).op
        (AffineSpace.coord S i)) := by
  obtain ⟨W, hwW⟩ := Stacks.Divisors.exists_affineOpens_mem ((𝔸(n; S) ↘ S) w)
  have : IsAffine W.1.toScheme := W.2
  have : IsOpenImmersion (AffineSpace.map n W.1.ι) :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @IsOpenImmersion)
      (AffineSpace.isPullback_map W.1.ι).flip inferInstance
  refine ⟨⟨AffineSpace.map n W.1.ι ''ᵁ ⊤,
    (isAffineOpen_top _).image_of_isOpenImmersion _⟩, ?_, ?_⟩
  · show w ∈ (AffineSpace.map n W.1.ι) '' (⊤ : Set _)
    rw [Set.top_eq_univ, Set.image_univ, range_affineSpaceMap, Scheme.Opens.range_ι]
    exact hwW
  · refine isRegular_of_isIso_apply (((AffineSpace.map n W.1.ι).appIso ⊤).hom) ?_
    rw [appIso_top_hom_map_le_top, AffineSpace.map_appTop_coord]
    exact isRegular_coord _ i

/-- Transport of "some affine neighbourhood on which a section is a nonzerodivisor" along an
isomorphism of schemes. -/
private theorem exists_affineOpens_isRegular_of_isIso {X Y : Scheme.{u}} (φ : X ⟶ Y) [IsIso φ]
    (t : Γ(Y, ⊤)) (x : X)
    (h : ∃ V : Y.affineOpens, φ x ∈ (V : Set Y) ∧
      IsRegular (Y.presheaf.map (homOfLE (le_top (a := V.1))).op t)) :
    ∃ V : X.affineOpens, x ∈ (V : Set X) ∧
      IsRegular (X.presheaf.map (homOfLE (le_top (a := V.1))).op (φ.appTop t)) := by
  obtain ⟨V, hxV, hreg⟩ := h
  refine ⟨⟨φ ⁻¹ᵁ V.1, V.2.preimage_of_isIso φ⟩, hxV, ?_⟩
  rw [map_le_top_appTop]
  exact isRegular_of_iso (asIso (φ.app V.1)) hreg

/-- **Every point of `𝔸¹_S` has an affine neighbourhood on which `T` is a nonzerodivisor.** -/
theorem exists_affineOpens_isRegular_affineCoordinate (S : Scheme.{u})
    (v : affineLineOver S) :
    ∃ V : (affineLineOver S).affineOpens, v ∈ (V : Set (affineLineOver S)) ∧
      IsRegular ((affineLineOver S).presheaf.map (homOfLE (le_top (a := V.1))).op
        (affineCoordinate S)) := by
  have h := exists_affineOpens_isRegular_of_isIso (affineLineToAffineSpace S)
    (AffineSpace.coord S PUnit.unit) v
    (exists_affineOpens_isRegular_coord S PUnit.unit (affineLineToAffineSpace S v))
  rwa [affineLineToAffineSpace_appTop_coord] at h

/-! ### `D₀` is an effective Cartier divisor -/

/-- The zero section of `ℙ¹_S` factors through the affine chart. -/
theorem lineZeroSection_eq (S : Scheme.{u}) :
    affineLineConstantSection S integralAffineZeroSection ≫ affineChart S =
      lineZeroSection S := by
  rw [affineLineConstantSection_comp_affineChart,
    integralAffineZeroSection_comp_projectiveLineXChart]

/-- The support of `D₀` lies in the affine chart. -/
theorem range_lineZeroSection_subset_range_affineChart (S : Scheme.{u}) :
    Set.range (lineZeroSection S) ⊆ Set.range (affineChart S) := by
  rw [← lineZeroSection_eq, range_comp_scheme]
  exact Set.image_subset_range _ _

/-- **Stacks Project, Tag 02RQ part (3), the zero divisor.** `D₀ ⊆ ℙ¹_S` is an effective
Cartier divisor: on the affine chart it is cut out by the coordinate `T`, which is a
nonzerodivisor on the inverse image of any affine open of `S`, and away from the chart it is
the unit ideal. -/
theorem lineZeroDivisor_isEffectiveCartierDivisor (S : Scheme.{u}) :
    Stacks.Divisors.IsEffectiveCartierDivisor (lineZeroDivisor S) := by
  refine Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen _ fun p => ?_
  by_cases hp : p ∈ Set.range (affineChart S)
  · obtain ⟨v, rfl⟩ := hp
    obtain ⟨V, hvV, hreg⟩ := exists_affineOpens_isRegular_affineCoordinate S v
    refine ⟨affineChart S ''ᵁ V.1, V.2.image_of_isOpenImmersion _, ⟨v, hvV, rfl⟩,
      ((affineChart S).appIso V.1).inv
        ((affineLineOver S).presheaf.map (homOfLE (le_top (a := V.1))).op
          (affineCoordinate S)), isRegular_of_iso ((affineChart S).appIso V.1).symm hreg, ?_⟩
    have h1 := zeroDivisor_ideal_comap_affineChart S V
    rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion] at h1
    have hsurj : Function.Surjective ((affineChart S).appIso V.1).inv.hom :=
      (ConcreteCategory.bijective_of_isIso _).2
    rw [← Ideal.map_comap_of_surjective _ hsurj
      ((lineZeroDivisor S).ideal ⟨affineChart S ''ᵁ V.1, V.2.image_of_isOpenImmersion _⟩),
      h1, Ideal.map_span, Set.image_singleton]
  · refine Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_notMem_support _ p
      (fun hps => hp ?_)
    exact range_lineZeroSection_subset_range_affineChart S
      ((coe_support_lineZeroDivisor S).le hps)

end Stacks.Chow

end
