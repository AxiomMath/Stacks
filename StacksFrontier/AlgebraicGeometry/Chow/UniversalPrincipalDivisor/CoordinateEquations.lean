module

public import StacksFrontier.AlgebraicGeometry.Chow.UniversalPrincipalDivisor.InfinityCartier
public import StacksFrontier.AlgebraicGeometry.Chow.ProperPushforwardPrincipal.ProjectiveLineIntegral
public import StacksFrontier.AlgebraicGeometry.Chow.FibreCycles.FibreDivisorPrincipal

/-!
# The divisors `D₀ = V(T₁)` and `D_∞ = V(T₀)` of `ℙ¹_S`

Stacks 0F93 defines `D₀, D_∞ ⊆ ℙ¹_S = Proj_S(𝒪_S[T₀, T₁])` as the closed subschemes cut out by
the sections `T₁`, resp. `T₀`, of `𝒪(1)`, and notes that they are effective Cartier divisors.

In this development `ℙ¹_S` is the base change of the two-chart gluing of `ℙ¹_ℤ` along
`S ⟶ Spec ℤ`, with two charts `𝔸¹_S ⟶ ℙ¹_S`: `Stacks.Chow.affineChart`, the open `T₀ ≠ 0` with
coordinate `T₁/T₀`, and `Stacks.Chow.affineYChart`, the open `T₁ ≠ 0` with coordinate `T₀/T₁`
(the gluing identifies the two coordinates by inversion). Both have the coordinate
`Stacks.Chow.affineCoordinate S`. The closed subscheme cut out by `T₁` is therefore the one whose
ideal is generated by `T₁/T₀` on the chart `T₀ ≠ 0` and is the unit ideal on the chart
`T₁ ≠ 0`, where `T₁` is invertible; symmetrically for `T₀`. Since the two charts cover `ℙ¹_S`,
these local equations determine a closed subscheme.

## Main results

* `Stacks.Chow.eq_lineZeroDivisor_iff`: a closed subscheme of `ℙ¹_S` is `D₀` if and only if it
  is cut out by `T₁` in the above sense.
* `Stacks.Chow.eq_lineInfinityDivisor_iff`: a closed subscheme of `ℙ¹_S` is `D_∞` if and only if
  it is cut out by `T₀`.
* `Stacks.Chow.comap_lineZeroDivisor_affineYChart`: `D₀` does not meet the chart `T₁ ≠ 0`.
* `Stacks.Chow.ext_of_comap_eq_of_range_union`: an ideal sheaf is determined by its inverse
  images along two open immersions that cover the scheme.

That `D₀` and `D_∞` are effective Cartier divisors is
`Stacks.Chow.lineZeroDivisor_isEffectiveCartierDivisor` and
`Stacks.Chow.lineInfinityDivisor_isEffectiveCartierDivisor`.

## Implementation notes

The library has no `𝒪(1)` on the glued `ℙ¹_S`, so `T₀` and `T₁` are not global sections here.
The statements describe `V(T₁)` and `V(T₀)` by their equations on the two standard charts.
These are the trivializations of `T₁` and `T₀` there: `T₁` reads as `T₁/T₀` on `T₀ ≠ 0` and as
the unit `1` on `T₁ ≠ 0`.

## References

* [Stacks Project, Tag 0F93](https://stacks.math.columbia.edu/tag/0F93)
* [Stacks Project, Tag 01WR](https://stacks.math.columbia.edu/tag/01WR)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Chow

/-- Two ideal sheaves with the same inverse image along an open immersion have the same ideal on
the image of every affine open. -/
private theorem ideal_image_eq_of_comap_eq {X A : Scheme.{u}} (a : A ⟶ X) [IsOpenImmersion a]
    {I J : X.IdealSheafData} (h : I.comap a = J.comap a) (V : A.affineOpens) :
    I.ideal ⟨a ''ᵁ V.1, V.2.image_of_isOpenImmersion a⟩ =
      J.ideal ⟨a ''ᵁ V.1, V.2.image_of_isOpenImmersion a⟩ := by
  have h1 := Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion I a V
  have h2 := Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion J a V
  rw [h, h2] at h1
  exact (Ideal.comap_injective_of_surjective _ (ConcreteCategory.bijective_of_isIso _).2 h1).symm

/-- **An ideal sheaf is determined on a cover by two open immersions.** If the images of `a` and
`b` cover `X` and two ideal sheaves have the same inverse images along `a` and along `b`, they
are equal. -/
theorem ext_of_comap_eq_of_range_union {X A B : Scheme.{u}} (a : A ⟶ X) (b : B ⟶ X)
    [IsOpenImmersion a] [IsOpenImmersion b] (hab : Set.range a ∪ Set.range b = Set.univ)
    {I J : X.IdealSheafData} (ha : I.comap a = J.comap a) (hb : I.comap b = J.comap b) :
    I = J := by
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top (ι := A.affineOpens ⊕ B.affineOpens)
    (Sum.elim (fun V => ⟨a ''ᵁ V.1, V.2.image_of_isOpenImmersion a⟩)
      (fun V => ⟨b ''ᵁ V.1, V.2.image_of_isOpenImmersion b⟩)) ?_ ?_
  · refine eq_top_iff.mpr fun x _ => ?_
    have hx : x ∈ Set.range a ∪ Set.range b := hab ▸ Set.mem_univ x
    rcases hx with ⟨y, rfl⟩ | ⟨y, rfl⟩
    · obtain ⟨V, hV⟩ := TopologicalSpace.Opens.mem_iSup.mp
        ((iSup_affineOpens_eq_top A).ge (Set.mem_univ y))
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨Sum.inl V, ⟨y, hV, rfl⟩⟩
    · obtain ⟨V, hV⟩ := TopologicalSpace.Opens.mem_iSup.mp
        ((iSup_affineOpens_eq_top B).ge (Set.mem_univ y))
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨Sum.inr V, ⟨y, hV, rfl⟩⟩
  · rintro (V | V)
    · exact ideal_image_eq_of_comap_eq a ha V
    · exact ideal_image_eq_of_comap_eq b hb V

/-- `D₀` does not meet the chart `T₁ ≠ 0`: it pulls back to the empty closed subscheme of the
second chart, because the zero section misses that chart. -/
theorem comap_lineZeroDivisor_affineYChart (S : Scheme.{u}) :
    (lineZeroDivisor S).comap (affineYChart S) = ⊤ := by
  rw [← Scheme.IdealSheafData.support_eq_bot_iff]
  apply SetLike.coe_injective
  rw [Scheme.IdealSheafData.support_comap, TopologicalSpace.Closeds.coe_preimage,
    coe_support_lineZeroDivisor, ← compl_range_affineYChart S]
  refine (Set.eq_empty_iff_forall_notMem.2 fun x hx => ?_).trans rfl
  rw [Set.mem_preimage, Set.mem_compl_iff] at hx
  exact hx ⟨x, rfl⟩

/-- **Stacks 0F93, `D₀ = V(T₁)`.** A closed subscheme `D` of `ℙ¹_S` is the zero divisor `D₀` if
and only if it is the closed subscheme cut out by `T₁`: on the chart `T₀ ≠ 0`, with coordinate
`T₁/T₀`, its ideal on every affine open is generated by the coordinate, and on the chart
`T₁ ≠ 0`, where `T₁` is a unit, it is the unit ideal. -/
@[stacks 0F93 "D₀ is the closed subscheme cut out by T₁: generated by T₁/T₀ on the chart \
T₀ ≠ 0 and the unit ideal on the chart T₁ ≠ 0"]
theorem eq_lineZeroDivisor_iff (S : Scheme.{u}) (D : (relativeProjectiveLine S).IdealSheafData) :
    D = lineZeroDivisor S ↔
      (∀ V : (affineLineOver S).affineOpens, (D.comap (affineChart S)).ideal V =
        Ideal.span {(affineLineOver S).presheaf.map (homOfLE le_top).op (affineCoordinate S)}) ∧
      D.comap (affineYChart S) = ⊤ := by
  refine ⟨?_, fun ⟨h₁, h₂⟩ => ?_⟩
  · rintro rfl
    exact ⟨zeroDivisor_ideal_comap_affineChart S, comap_lineZeroDivisor_affineYChart S⟩
  · refine ext_of_comap_eq_of_range_union (affineChart S) (affineYChart S)
      (range_affineChart_union_range_affineYChart S) ?_ ?_
    · exact Scheme.IdealSheafData.ext (funext fun V => by
        rw [h₁ V, zeroDivisor_ideal_comap_affineChart])
    · rw [h₂, comap_lineZeroDivisor_affineYChart]

/-- **Stacks 0F93, `D_∞ = V(T₀)`.** A closed subscheme `D` of `ℙ¹_S` is the infinity divisor
`D_∞` if and only if it is the closed subscheme cut out by `T₀`: on the chart `T₁ ≠ 0`, with
coordinate `T₀/T₁`, its ideal on every affine open is generated by the coordinate, and on the
chart `T₀ ≠ 0`, where `T₀` is a unit, it is the unit ideal. -/
@[stacks 0F93 "D_∞ is the closed subscheme cut out by T₀: generated by T₀/T₁ on the chart \
T₁ ≠ 0 and the unit ideal on the chart T₀ ≠ 0"]
theorem eq_lineInfinityDivisor_iff (S : Scheme.{u})
    (D : (relativeProjectiveLine S).IdealSheafData) :
    D = lineInfinityDivisor S ↔
      (∀ V : (affineLineOver S).affineOpens, (D.comap (affineYChart S)).ideal V =
        Ideal.span {(affineLineOver S).presheaf.map (homOfLE le_top).op (affineCoordinate S)}) ∧
      D.comap (affineChart S) = ⊤ := by
  refine ⟨?_, fun ⟨h₁, h₂⟩ => ?_⟩
  · rintro rfl
    exact ⟨infinityDivisor_ideal_comap_affineYChart S, comap_lineInfinityDivisor_affineChart S⟩
  · refine ext_of_comap_eq_of_range_union (affineYChart S) (affineChart S)
      (by rw [Set.union_comm]; exact range_affineChart_union_range_affineYChart S) ?_ ?_
    · exact Scheme.IdealSheafData.ext (funext fun V => by
        rw [h₁ V, infinityDivisor_ideal_comap_affineYChart])
    · rw [h₂, comap_lineInfinityDivisor_affineChart]

end Stacks.Chow

end
