module

public import StacksFrontier.AlgebraicGeometry.Chow.UniversalPrincipalDivisor
public import StacksFrontier.AlgebraicGeometry.DivisorFlatPullback.Basic
public import Mathlib.RingTheory.Polynomial.Ideal

/-!
# The local equation of the zero divisor of `ℙ¹_S`, and the fibres over `X`

Let `S` be a scheme, `ℙ¹_S` its relative projective line and `𝔸¹_S ⟶ ℙ¹_S` the first affine
chart, with coordinate `T`. The zero divisor `D₀ ⊆ ℙ¹_S` is the kernel ideal sheaf of the zero
section, and this file computes it on the chart: on every affine open `V ⊆ 𝔸¹_S` the inverse
image of `D₀` is the principal ideal generated by `T|_V`. This is the companion of
`Stacks.Chow.lineInfinityDivisor_ideal_comap_affineChart`, which says that `D_∞` is the unit
ideal there, and together the two are the local equations Tag 02RQ part (3) is about.

The computation is a base change in two steps. The zero section of `ℙ¹_S` factors through the
chart, by a constant section `S ⟶ 𝔸¹_S`; since the chart is a monomorphism, that exhibits the
constant section as the inverse image of the zero section, so the inverse image of `D₀` on the
chart is the kernel ideal sheaf of the constant section. The constant section is in turn the base
change of the point `0` of `𝔸¹_ℤ = Spec ℤ[T]` along the projection `𝔸¹_S ⟶ 𝔸¹_ℤ`, and over
`Spec ℤ[T]` the point `0` is cut out by `T` because `RingHom.ker (Polynomial.evalRingHom 0)` is
`Ideal.span {Polynomial.X}`.

The same base change, applied to the sections of `X ×_S ℙ¹_S ⟶ X` rather than to the chart,
shows that the two distinguished fibres of a closed subscheme of `X ×_S ℙ¹_S` are closed
subschemes *of `X`*: cutting with `D₀` or `D_∞` lands in `X ×_S D₀ ≅ X` resp. `X ×_S D_∞ ≅ X`.

## Main definitions

* `Stacks.Chow.integralAffineZeroSection`: the point `0` of `𝔸¹_ℤ = Spec ℤ[T]`, the point whose
  image in `ℙ¹_ℤ` is `Stacks.Chow.integralZeroSection`.
* `Stacks.Chow.affineLineConstantSection`: the constant section `S ⟶ 𝔸¹_S` determined by a point
  of `𝔸¹_ℤ`; the affine-chart counterpart of `Stacks.Chow.lineConstantSection`.

## Main results

* `Stacks.Chow.zeroDivisor_ideal_comap_affineChart`: **in the affine coordinate, `D₀` is cut out
  by the coordinate itself.**
* `Stacks.Chow.ker_ideal_top_integralAffineZeroSection`: the point `0` of `Spec ℤ[T]` is cut out
  by `T`.
* `Stacks.Chow.comap_lineZeroDivisor_affineChart`: `D₀` meets the chart in the zero section of
  `𝔸¹_S`.
* `Stacks.Chow.isClosedImmersion_graphZeroFiber_comp` and
  `Stacks.Chow.isClosedImmersion_graphInfinityFiber_comp`: `Y₀ ⟶ X` and `Y_∞ ⟶ X` are closed
  immersions.
* `AlgebraicGeometry.ker_eq_comap_ker_of_isPullback`: the kernel ideal sheaf of a base change of
  a closed immersion is the inverse image of its kernel ideal sheaf. This is the general form of
  `AlgebraicGeometry.Scheme.IdealSheafData.ker_fst_of_isClosedImmersion`, which Mathlib states
  only for the chosen pullback.

## Implementation notes

The step from `Spec ℤ[T]` to an arbitrary affine open `V` of `𝔸¹_S` is
`Stacks.IdealSheaf.ideal_comap_appLE`: `𝔸¹_S` is not affine, but `V` *is* contained in the
preimage of the affine open `⊤` of `Spec ℤ[T]`, which is all that lemma asks for. So no
affine-cover argument is needed here, and in particular Mathlib's
`AlgebraicGeometry.Scheme.IdealSheafData.ext_of_iSup_eq_top` is not used.

What this file does **not** supply is the effective Cartier property of `D₀`, i.e. part (3) of
Tag 02RQ. The affine-local criterion Tag 01WS
(`Stacks.Divisors.isEffectiveCartierDivisor_iff_affineLocal`) asks for a generator that is a
*nonzerodivisor*, and the generator produced here is a nonzerodivisor only because
`Γ(𝔸¹_S, q⁻¹W) ≅ Γ(S, W)[T]` for an affine open `W ⊆ S`, with `T` going to `Polynomial.X`. That
identification is absent from this repository; the route to it is Mathlib's
`AlgebraicGeometry.AffineSpace` — `AffineSpace.isoOfIsAffine`, `AffineSpace.isPullback_map` and
`AffineSpace.map_appTop_coord` — after crossing `MvPolynomial PUnit (ULift ℤ)` to
`Polynomial (ULift ℤ)`, and the algebra that then finishes it is `Polynomial.isRegular_X`.

## References

* [Stacks Project, Tag 02RQ](https://stacks.math.columbia.edu/tag/02RQ)
* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

/-- The kernel ideal sheaf of a base change of a closed immersion is the inverse image of the
kernel ideal sheaf of that closed immersion. -/
theorem AlgebraicGeometry.ker_eq_comap_ker_of_isPullback {W X Y Z : Scheme.{u}}
    {a : W ⟶ X} {b : W ⟶ Z} {f : X ⟶ Y} {i : Z ⟶ Y} [IsClosedImmersion i]
    (h : IsPullback a b f i) : a.ker = i.ker.comap f := by
  rw [← Scheme.IdealSheafData.ker_fst_of_isClosedImmersion i f, ← h.isoPullback_hom_fst,
    Scheme.Hom.ker_comp_of_isIso]

namespace Stacks.Chow

/-- Postcomposing with an injective ring map does not change a kernel. -/
private theorem ker_comp_right {A B C : CommRingCat.{u}} (f : A ⟶ B) (g : B ⟶ C)
    (hg : Function.Injective g.hom) :
    RingHom.ker (f ≫ g).hom = RingHom.ker f.hom := by
  ext x
  simp only [CommRingCat.hom_comp, RingHom.mem_ker, RingHom.coe_comp, Function.comp_apply]
  exact ⟨fun h => hg (h.trans (map_zero g.hom).symm), fun h => by rw [h, map_zero]⟩

/-! ### The zero point of the affine line over the integers -/

/-- The point `0` of `𝔸¹_ℤ = Spec ℤ[T]`. -/
def integralAffineZeroSection :
    (⊤_ Scheme.{u}) ⟶ Spec (.of (Polynomial (ULift.{u} ℤ))) :=
  (AlgebraicGeometry.specULiftZIsTerminal.from (⊤_ Scheme.{u})) ≫
    Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : ULift.{u} ℤ)))

/-- The point `0` of `ℙ¹_ℤ` is the point `0` of `𝔸¹_ℤ`, read in the first chart. -/
theorem integralAffineZeroSection_comp_projectiveLineXChart :
    integralAffineZeroSection.{u} ≫ projectiveLineXChart (ULift.{u} ℤ) =
      integralZeroSection.{u} := by
  rw [integralAffineZeroSection, integralZeroSection, Category.assoc]

/-- The unique morphism from the terminal scheme to `Spec ℤ` is an isomorphism. -/
instance isIso_specULiftZIsTerminal_from_terminal :
    IsIso (AlgebraicGeometry.specULiftZIsTerminal.from (⊤_ Scheme.{u})) :=
  isIso_of_isTerminal terminalIsTerminal AlgebraicGeometry.specULiftZIsTerminal _

/-- The point `0` of `𝔸¹_ℤ`, as a morphism from the terminal scheme, is a closed immersion. -/
instance isClosedImmersion_integralAffineZeroSection :
    IsClosedImmersion integralAffineZeroSection.{u} := by
  rw [integralAffineZeroSection]
  have : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (Polynomial.evalRingHom (0 : ULift.{u} ℤ)))) :=
    IsClosedImmersion.spec_of_surjective _ (fun x => ⟨Polynomial.C x, by simp⟩)
  infer_instance

/-- **The point `0` of `𝔸¹_ℤ` is cut out by the coordinate.** -/
theorem ker_ideal_top_integralAffineZeroSection :
    integralAffineZeroSection.{u}.ker.ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.span {(Scheme.ΓSpecIso (.of (Polynomial (ULift.{u} ℤ)))).inv Polynomial.X} := by
  have hinj : Function.Injective
      ((AlgebraicGeometry.specULiftZIsTerminal.from (⊤_ Scheme.{u})).appTop).hom := by
    show Function.Injective
      ((AlgebraicGeometry.specULiftZIsTerminal.from (⊤_ Scheme.{u})).app ⊤).hom
    exact (ConcreteCategory.bijective_of_isIso _).1
  have hinj' : Function.Injective
      ((Scheme.ΓSpecIso (.of (ULift.{u} ℤ))).hom).hom :=
    (ConcreteCategory.bijective_of_isIso _).1
  have hcomap := Stacks.IdealSheaf.ideal_map_hom_eq_comap_inv
    (Scheme.ΓSpecIso (.of (Polynomial (ULift.{u} ℤ)))).symm (Ideal.span {Polynomial.X})
  simp only [Iso.symm_hom, Iso.symm_inv] at hcomap
  rw [Scheme.Hom.ker_apply]
  show RingHom.ker (integralAffineZeroSection.{u}.appTop).hom = _
  rw [integralAffineZeroSection, Scheme.Hom.comp_appTop, ker_comp_right _ _ hinj,
    ← ker_comp_right _ (Scheme.ΓSpecIso (.of (ULift.{u} ℤ))).hom hinj',
    Scheme.ΓSpecIso_naturality, CommRingCat.hom_comp, ← RingHom.comap_ker]
  show Ideal.comap _ (RingHom.ker (Polynomial.evalRingHom (0 : ULift.{u} ℤ))) = _
  rw [Polynomial.ker_evalRingHom, map_zero, sub_zero, ← hcomap, Ideal.map_span,
    Set.image_singleton]

/-! ### The constant sections of the affine line over a base -/

/-- The constant section `S ⟶ 𝔸¹_S` determined by a point of `𝔸¹_ℤ`. -/
def affineLineConstantSection (S : Scheme.{u})
    (e : (⊤_ Scheme.{u}) ⟶ Spec (.of (Polynomial (ULift.{u} ℤ)))) :
    S ⟶ affineLineOver S :=
  pullback.lift (𝟙 S) (terminal.from S ≫ e) (by simp)

/-- A constant section of `𝔸¹_S` becomes, in the chart, the corresponding constant section of
`ℙ¹_S`. -/
theorem affineLineConstantSection_comp_affineChart (S : Scheme.{u})
    (e : (⊤_ Scheme.{u}) ⟶ Spec (.of (Polynomial (ULift.{u} ℤ)))) :
    affineLineConstantSection S e ≫ affineChart S =
      lineConstantSection S (e ≫ projectiveLineXChart (ULift.{u} ℤ)) := by
  refine pullback.hom_ext ?_ ?_
  · rw [Category.assoc, affineChart, pullback.lift_fst, affineLineConstantSection,
      pullback.lift_fst, lineConstantSection, pullback.lift_fst]
  · rw [Category.assoc, affineChart, pullback.lift_snd, ← Category.assoc,
      affineLineConstantSection, pullback.lift_snd, lineConstantSection, pullback.lift_snd,
      Category.assoc]

/-- A constant section of `𝔸¹_S` is the base change of the corresponding point of `𝔸¹_ℤ` along
the projection of `𝔸¹_S` to `𝔸¹_ℤ`. -/
theorem isPullback_affineLineConstantSection (S : Scheme.{u})
    (e : (⊤_ Scheme.{u}) ⟶ Spec (.of (Polynomial (ULift.{u} ℤ)))) :
    IsPullback (affineLineConstantSection S e) (terminal.from S)
      (pullback.snd (terminal.from S)
        (terminal.from (Spec (.of (Polynomial (ULift.{u} ℤ)))))) e := by
  refine IsPullback.of_right (h₁₂ := pullback.fst (terminal.from S)
      (terminal.from (Spec (.of (Polynomial (ULift.{u} ℤ)))))) ?_
    (pullback.lift_snd _ _ _) (IsPullback.of_hasPullback _ _)
  rw [show affineLineConstantSection S e ≫ pullback.fst (terminal.from S)
      (terminal.from (Spec (.of (Polynomial (ULift.{u} ℤ))))) = 𝟙 S from
      pullback.lift_fst _ _ _,
    show e ≫ terminal.from (Spec (.of (Polynomial (ULift.{u} ℤ)))) = 𝟙 (⊤_ Scheme.{u}) from
      terminal.hom_ext _ _]
  exact IsPullback.of_horiz_isIso ⟨terminal.hom_ext _ _⟩

/-- The closed subscheme cut out by a constant section of `𝔸¹_S` is the inverse image of the
corresponding point of `𝔸¹_ℤ`. -/
theorem ker_affineLineConstantSection (S : Scheme.{u})
    (e : (⊤_ Scheme.{u}) ⟶ Spec (.of (Polynomial (ULift.{u} ℤ)))) [IsClosedImmersion e] :
    (affineLineConstantSection S e).ker =
      e.ker.comap (pullback.snd (terminal.from S)
        (terminal.from (Spec (.of (Polynomial (ULift.{u} ℤ)))))) :=
  AlgebraicGeometry.ker_eq_comap_ker_of_isPullback (isPullback_affineLineConstantSection S e)

/-! ### The zero divisor on the affine chart -/

/-- `D₀` meets the affine chart in the zero section of `𝔸¹_S`. -/
theorem comap_lineZeroDivisor_affineChart (S : Scheme.{u}) :
    (lineZeroDivisor S).comap (affineChart S) =
      (affineLineConstantSection S integralAffineZeroSection).ker := by
  have hpb : IsPullback (affineLineConstantSection S integralAffineZeroSection) (𝟙 S)
      (affineChart S) (lineZeroSection S) := by
    refine IsPullback.of_vert_isIso_mono ⟨?_⟩
    rw [Category.id_comp, affineLineConstantSection_comp_affineChart,
      integralAffineZeroSection_comp_projectiveLineXChart]
  rw [lineZeroDivisor, ← AlgebraicGeometry.ker_eq_comap_ker_of_isPullback hpb]

/-- **In the affine coordinate, `D₀` is cut out by the coordinate itself.** -/
theorem zeroDivisor_ideal_comap_affineChart (S : Scheme.{u})
    (V : (affineLineOver S).affineOpens) :
    ((lineZeroDivisor S).comap (affineChart S)).ideal V =
      Ideal.span {(affineLineOver S).presheaf.map (homOfLE le_top).op (affineCoordinate S)} := by
  rw [comap_lineZeroDivisor_affineChart, ker_affineLineConstantSection,
    Stacks.IdealSheaf.ideal_comap_appLE _ _ ⟨⊤, isAffineOpen_top _⟩ V le_top,
    ker_ideal_top_integralAffineZeroSection, Ideal.map_span, Set.image_singleton]
  rfl

/-! ### The two distinguished fibres are closed subschemes of `X` -/

/-- Cutting `X ×_S ℙ¹_S` with the image of a constant section of `ℙ¹_S ⟶ S` gives a closed
subscheme of `X`: that image is isomorphic to `S`, so the intersection is `X ×_S S = X`. -/
theorem isClosedImmersion_comap_lineConstantSection_ker_comp_fst {X S : Scheme.{u}}
    (sX : X ⟶ S) (e : (⊤_ Scheme.{u}) ⟶ projectiveLine (ULift.{u} ℤ)) :
    IsClosedImmersion
      (((lineConstantSection S e).ker.comap
            (pullback.snd sX (relativeProjectiveLine S ↘ S))).subschemeι ≫
          pullback.fst sX (relativeProjectiveLine S ↘ S)) := by
  have hiso := isIso_lineConstantSection_ker_over S e
  have hci : IsClosedImmersion
      ((lineConstantSection S e).ker.subschemeι ≫ (relativeProjectiveLine S ↘ S)) :=
    inferInstance
  have hbase : IsClosedImmersion
      (pullback.fst (pullback.snd sX (relativeProjectiveLine S ↘ S))
          (lineConstantSection S e).ker.subschemeι ≫
        pullback.fst sX (relativeProjectiveLine S ↘ S)) :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @IsClosedImmersion)
      ((IsPullback.of_hasPullback (pullback.snd sX (relativeProjectiveLine S ↘ S))
        (lineConstantSection S e).ker.subschemeι).paste_horiz
        (IsPullback.of_hasPullback sX (relativeProjectiveLine S ↘ S))).flip hci
  rw [← Scheme.IdealSheafData.comapIso_hom_fst (lineConstantSection S e).ker
    (pullback.snd sX (relativeProjectiveLine S ↘ S)), Category.assoc]
  infer_instance

/-- Cutting a closed subscheme of `X ×_S ℙ¹_S` with the image of a constant section of
`ℙ¹_S ⟶ S` gives a closed subscheme of `X`. -/
theorem isClosedImmersion_comap_lineConstantSection_ker_comp {X S Z : Scheme.{u}}
    (sX : X ⟶ S) (e : (⊤_ Scheme.{u}) ⟶ projectiveLine (ULift.{u} ℤ))
    (i : Z ⟶ projectiveLineProduct sX) [IsClosedImmersion i] :
    IsClosedImmersion
      (((lineConstantSection S e).ker.comap
            (i ≫ pullback.snd sX (relativeProjectiveLine S ↘ S))).subschemeι ≫
          i ≫ pullback.fst sX (relativeProjectiveLine S ↘ S)) := by
  have hA := isClosedImmersion_comap_lineConstantSection_ker_comp_fst sX e
  rw [Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comapIso_hom_fst
      ((lineConstantSection S e).ker.comap
        (pullback.snd sX (relativeProjectiveLine S ↘ S))) i,
    Category.assoc, ← Category.assoc (pullback.fst i _) i, pullback.condition, Category.assoc]
  infer_instance

/-- `Y₀ ⟶ X` is a closed immersion. -/
theorem isClosedImmersion_graphZeroFiber_comp {X S : Scheme.{u}} (sX : X ⟶ S) (U : X.Opens)
    (s : Γ(X, U)) :
    IsClosedImmersion ((graphZeroFiber sX U s).subschemeι ≫ graphProjection sX U s) :=
  isClosedImmersion_comap_lineConstantSection_ker_comp sX _ (graphClosureι sX U s)

/-- `Y_∞ ⟶ X` is a closed immersion. -/
theorem isClosedImmersion_graphInfinityFiber_comp {X S : Scheme.{u}} (sX : X ⟶ S) (U : X.Opens)
    (s : Γ(X, U)) :
    IsClosedImmersion ((graphInfinityFiber sX U s).subschemeι ≫ graphProjection sX U s) :=
  isClosedImmersion_comap_lineConstantSection_ker_comp sX _ (graphClosureι sX U s)

end Stacks.Chow

end
