module

public import StacksFrontier.AlgebraicGeometry.Chow.DeterminantsFiniteLength.Dimension
public import StacksFrontier.AlgebraicGeometry.Chow.DeterminantsFiniteLength.ExactSequence

/-!
# Compatibility of determinant maps in a three-by-three diagram

The determinant isomorphisms attached to the rows and the columns of a commutative
three-by-three diagram of finite-length modules with exact rows and columns agree, after
the middle two determinant factors are interchanged with the Koszul sign.

## Main definitions

* `Module.FiniteLength.signedTensorInterchange` interchanges the middle factors of a
  fourfold tensor product and applies the prescribed sign.

## Main results

* `Module.FiniteLength.determinantExactSequenceMap_three_by_three` is the compatibility of
  the determinant maps for a commutative exact three-by-three diagram.
* `Module.FiniteLength.append_spans_of_exact` says that an admissible sequence spanning the
  submodule concatenated with lifts of one spanning the quotient spans the middle module.
* `Module.FiniteLength.determinant_induction` is the induction principle on a determinant
  generated by symbols.

## Implementation notes

The fourfold source is parenthesized as `(A ⊗ C) ⊗ (G ⊗ I)`. The map called `epsilon` in
the source is expressed using the associativity and symmetry equivalences for tensor
products together with multiplication by `(-1) ^ (length C * length G)`.

Both composites are linear maps out of a fourfold tensor product, so they agree as soon as
they agree on tensors of four symbols; `linearMap_eq_of_symbol_fourfold` reduces to that
case. The sign then comes from `block_swap_aux`, which moves a block of `c` entries past a
block of `g` entries of an admissible sequence one adjacent transposition at a time.

## References

* [Stacks Project, Tag 02PA](https://stacks.math.columbia.edu/tag/02PA)
-/

@[expose] public section

noncomputable section

open scoped TensorProduct

namespace Module.FiniteLength

universe u vA vB vC vD vE vF vG vH vI

variable {R : Type u} {M : Type vA} [CommRing R] [IsLocalRing R]
  [AddCommGroup M] [Module R M]

/-- Move the entry at `i` left to position `j` by adjacent transpositions, recording the
resulting sign and where every other entry went. -/
private lemma move_entry_exact (e : AdmissibleSequence R M)
    (j i : Fin (moduleLength R M)) (hji : j.val ≤ i.val)
    (hi : ∀ r, r ∈ IsLocalRing.maximalIdeal R →
      r • e.1 i ∈ initialSpan (R := R) e.1 j.val) :
    ∃ f : AdmissibleSequence R M,
      (∀ k, k.val < j.val → f.1 k = e.1 k) ∧ f.1 j = e.1 i ∧
        (∀ k, ∀ (_hjk : j.val ≤ k.val) (hki : k.val < i.val),
          f.1 ⟨k.val + 1, (Nat.succ_le_of_lt hki).trans_lt i.isLt⟩ = e.1 k) ∧
        (∀ k, i.val < k.val → f.1 k = e.1 k) ∧
        symbol e = ((-1 : IsLocalRing.ResidueField R) ^ (i.val - j.val)) • symbol f := by
  classical
  by_cases h : j = i
  · subst i
    exact ⟨e, fun _ _ ↦ rfl, rfl, fun _ _ _ ↦ by omega, fun _ _ ↦ rfl, by simp⟩
  have hlt : j.val < i.val := Nat.lt_of_le_of_ne hji fun heq ↦ h (Fin.ext heq)
  let b : Fin (moduleLength R M) := ⟨i.val - 1, by omega⟩
  have hbi : b.val + 1 = i.val := by dsimp [b]; omega
  have hjb : j.val ≤ b.val := by dsimp [b]; omega
  have ha : ∀ r, r ∈ IsLocalRing.maximalIdeal R →
      r • e.1 i ∈ initialSpan (R := R) e.1 b.val :=
    fun r hr ↦ initialSpan_mono e.1 hjb (hi r hr)
  let g : AdmissibleSequence R M := ⟨swapEntries e.1 i b, admissible_swap e i b hbi ha⟩
  have hg (r : R) (hr : r ∈ IsLocalRing.maximalIdeal R) :
      r • g.1 b ∈ initialSpan (R := R) g.1 j.val := by
    rw [show g.1 b = e.1 i by simp [g, swapEntries]]
    rw [initialSpan_swap _ _ _ (by constructor <;> omega)]
    exact hi r hr
  obtain ⟨f, hfprev, hfj, hfshift, hfsuffix, hfsym⟩ := move_entry_exact g j b hjb hg
  refine ⟨f, ?_, ?_, ?_, ?_, ?_⟩
  · intro k hk
    rw [hfprev k hk]
    change swapEntries e.1 i b k = e.1 k
    have hki : k ≠ i := Fin.ne_of_val_ne (by omega)
    have hkb : k ≠ b := Fin.ne_of_val_ne (by omega)
    simp [swapEntries, Equiv.swap_apply_of_ne_of_ne hki hkb]
  · simpa [g, swapEntries] using hfj
  · intro k hjk hki
    by_cases hkb : k.val = b.val
    · have hs := hfsuffix i (by omega)
      have heq : (⟨k.val + 1, by omega⟩ : Fin (moduleLength R M)) = i := by
        apply Fin.ext
        dsimp [b] at hkb ⊢
        omega
      rw [heq, hs]
      obtain rfl : k = b := Fin.ext hkb
      simp [g, swapEntries]
    · have hklt : k.val < b.val := by dsimp [b] at *; omega
      rw [hfshift k hjk hklt]
      change swapEntries e.1 i b k = e.1 k
      have hki : k ≠ i := Fin.ne_of_val_ne (by omega)
      have hkb' : k ≠ b := Fin.ne_of_val_ne (by omega)
      simp [swapEntries, Equiv.swap_apply_of_ne_of_ne hki hkb']
  · intro k hki
    rw [hfsuffix k (by omega)]
    change swapEntries e.1 i b k = e.1 k
    have hki' : k ≠ i := Fin.ne_of_val_ne (by omega)
    have hkb' : k ≠ b := Fin.ne_of_val_ne (by omega)
    simp [swapEntries, Equiv.swap_apply_of_ne_of_ne hki' hkb']
  · calc
      symbol e = -symbol g := symbol_swap_entries e i b hbi ha
      _ = ((-1 : IsLocalRing.ResidueField R) ^ (i.val - j.val)) • symbol f := by
        rw [← (neg_one_smul (R := IsLocalRing.ResidueField R) (symbol g)), hfsym,
          smul_smul]
        have hd : i.val - j.val = (b.val - j.val) + 1 := by
          dsimp [b]
          omega
        congr 1
        rw [hd, pow_succ]
        ring
termination_by i.val - j.val

/-- An admissible sequence of a finite-length module that spans has a nonzero symbol, since
the determinant is one-dimensional and the symbol generates it. -/
private lemma symbol_ne_zero_of_span {X : Type vA} [AddCommGroup X] [Module R X]
    (hX : IsFiniteLength R X) (e : AdmissibleSequence R X)
    (he : Submodule.span R (Set.range e.1) = ⊤) : symbol e ≠ 0 := by
  intro hz
  have hbot : (⊥ : Submodule (IsLocalRing.ResidueField R) (determinant R X)) = ⊤ := by
    simpa [hz] using span_symbol_eq_top hX e he
  have hone := finrank_determinant_eq_one hX
  rw [← finrank_top, ← hbot, finrank_bot] at hone
  omega

omit [IsLocalRing R] in
/-- An admissible sequence spanning the submodule, concatenated with lifts of one spanning the
quotient, spans the middle module of a short exact sequence. -/
public lemma append_spans_of_exact
    {K : Type vA} {L : Type vB} {Q : Type vC}
    [AddCommGroup K] [Module R K] [AddCommGroup L] [Module R L]
    [AddCommGroup Q] [Module R Q]
    {n m : ℕ} (i : K →ₗ[R] L) (p : L →ₗ[R] Q)
    (_hi : Function.Injective i) (_hp : Function.Surjective p)
    (hex : Function.Exact i p) (e : Fin n → K) (f : Fin m → Q)
    (lift : Fin m → L) (hlift : ∀ j, p (lift j) = f j)
    (he : Submodule.span R (Set.range e) = ⊤)
    (hf : Submodule.span R (Set.range f) = ⊤) :
    Submodule.span R (Set.range (Fin.append (fun j ↦ i (e j)) lift)) = ⊤ := by
  let W : Submodule R L :=
    Submodule.span R (Set.range (Fin.append (fun j ↦ i (e j)) lift))
  have hfirst (j : Fin n) : i (e j) ∈ W :=
    Submodule.subset_span ⟨Fin.castAdd m j, by simp⟩
  have hliftW (j : Fin m) : lift j ∈ W :=
    Submodule.subset_span ⟨Fin.natAdd n j, by simp⟩
  have hmap : W.map p = ⊤ := by
    apply top_unique
    rw [← hf]
    apply Submodule.span_le.mpr
    rintro y ⟨j, rfl⟩
    exact Submodule.mem_map.mpr ⟨lift j, hliftW j, hlift j⟩
  apply top_unique
  intro x _
  have hpx : p x ∈ W.map p := by simp [hmap]
  obtain ⟨y, hyW, hpy⟩ := Submodule.mem_map.mp hpx
  obtain ⟨z, hzi⟩ := (hex (x - y)).mp (by simp [hpy])
  have hmapfirst : (Submodule.span R (Set.range e)).map i ≤ W := by
    rw [Submodule.map_span]
    apply Submodule.span_le.mpr
    rintro _ ⟨z, hz, rfl⟩
    obtain ⟨j, rfl⟩ := hz
    exact hfirst j
  have hiz : i z ∈ W := hmapfirst ⟨z, by simp [he], rfl⟩
  rw [show x = y + i z by rw [hzi]; abel]
  exact W.add_mem hyW hiz

omit [IsLocalRing R] in
/-- The length of the middle term of a short exact sequence of finite-length modules is the
sum of the lengths of the outer terms. -/
private lemma moduleLength_add_of_exact
    {K : Type vA} {L : Type vB} {Q : Type vC}
    [AddCommGroup K] [Module R K] [AddCommGroup L] [Module R L]
    [AddCommGroup Q] [Module R Q]
    (i : K →ₗ[R] L) (p : L →ₗ[R] Q)
    (hi : Function.Injective i) (hp : Function.Surjective p)
    (hex : Function.Exact i p)
    (hK : IsFiniteLength R K) (_hL : IsFiniteLength R L) (hQ : IsFiniteLength R Q) :
    moduleLength R L = moduleLength R K + moduleLength R Q := by
  exact exactSequence_moduleLength i p hi hp hex hK hQ

omit [IsLocalRing R] in
/-- Reindexing a sequence along an equality of lengths does not change the span of its
range. -/
private lemma span_range_comp_finCast {X : Type vB} [AddCommGroup X] [Module R X]
    {n m : ℕ} (h : n = m) (f : Fin m → X) :
    Submodule.span R (Set.range (f ∘ Fin.cast h)) =
      Submodule.span R (Set.range f) := by
  congr 1
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨Fin.cast h i, rfl⟩
  · rintro ⟨i, rfl⟩
    exact ⟨Fin.cast h.symm i, by simp⟩

omit [IsLocalRing R] in
/-- A linear map applied to a concatenation is the concatenation of its values. -/
private lemma linearMap_append_apply
    {L Q : Type*} [AddCommGroup L] [Module R L] [AddCommGroup Q] [Module R Q]
    {n m : ℕ} (p : L →ₗ[R] Q) (f : Fin n → L) (g : Fin m → L)
    (j : Fin (n + m)) :
    p (Fin.append f g j) = Fin.append (fun k ↦ p (f k)) (fun k ↦ p (g k)) j :=
  Fin.addCases (fun k ↦ by simp) (fun k ↦ by simp) j

/-- The value of a concatenation at an index of the left block, reached through a cast. -/
private lemma finAppendCast_at_left {X : Type*} {N n m : ℕ} (h : N = n + m)
    (f : Fin n → X) (g : Fin m → X) (k : Fin N) (j : Fin n) (hk : k.val = j.val) :
    Fin.append f g (Fin.cast h k) = f j := by
  rw [show Fin.cast h k = Fin.castAdd m j from Fin.ext hk, Fin.append_left]

/-- The value of a concatenation at an index of the right block, reached through a cast. -/
private lemma finAppendCast_at_right {X : Type*} {N n m : ℕ} (h : N = n + m)
    (f : Fin n → X) (g : Fin m → X) (k : Fin N) (j : Fin m) (hk : k.val = n + j.val) :
    Fin.append f g (Fin.cast h k) = g j := by
  rw [show Fin.cast h k = Fin.natAdd n j from Fin.ext hk, Fin.append_right]

/-- Concatenating a spanning admissible sequence of the submodule with lifts of one of the
quotient gives an admissible sequence of the middle module, with the expected determinant
map value and entries. -/
private lemma exists_concat_sequence
    {K : Type vA} {L : Type vB} {Q : Type vC}
    [AddCommGroup K] [Module R K] [AddCommGroup L] [Module R L]
    [AddCommGroup Q] [Module R Q]
    (i : K →ₗ[R] L) (p : L →ₗ[R] Q)
    (hi : Function.Injective i) (hp : Function.Surjective p) (hex : Function.Exact i p)
    (hK : IsFiniteLength R K) (hL : IsFiniteLength R L) (hQ : IsFiniteLength R Q)
    (hlen : moduleLength R L = moduleLength R K + moduleLength R Q)
    (ea : AdmissibleSequence R K) (ec : AdmissibleSequence R Q)
    (ha0 : symbol ea ≠ 0) (hc0 : symbol ec ≠ 0)
    (lift : Fin (moduleLength R Q) → L) (hlift : ∀ j, p (lift j) = ec.1 j) :
    ∃ eb : AdmissibleSequence R L, symbol eb ≠ 0 ∧
      determinantExactSequenceMap i p hi hp hex hK hL hQ
        (symbol ea ⊗ₜ[IsLocalRing.ResidueField R] symbol ec) = symbol eb ∧
      (∀ (j : Fin (moduleLength R K)) (k : Fin (moduleLength R L)),
        k.val = j.val → eb.1 k = i (ea.1 j)) ∧
      (∀ (j : Fin (moduleLength R Q)) (k : Fin (moduleLength R L)),
        k.val = moduleLength R K + j.val → eb.1 k = lift j) ∧
      ∀ k, eb.1 k = Fin.append (fun j ↦ i (ea.1 j)) lift (Fin.cast hlen k) := by
  obtain ⟨_, hadm, heval⟩ :=
    determinantExactSequenceMap_spec i p hi hp hex hK hL hQ ea ec ha0 hc0 lift hlift
  let eb : AdmissibleSequence R L :=
    ⟨fun k ↦ Fin.append (fun j ↦ i (ea.1 j)) lift (Fin.cast hlen k), hadm⟩
  have hspan : Submodule.span R (Set.range eb.1) = ⊤ := by
    change Submodule.span R (Set.range ((Fin.append (fun j ↦ i (ea.1 j)) lift) ∘ Fin.cast hlen))
      = ⊤
    rw [span_range_comp_finCast hlen]
    exact append_spans_of_exact i p hi hp hex ea.1 ec.1 lift hlift
      (span_eq_top_of_symbol_ne_zero hK ea ha0) (span_eq_top_of_symbol_ne_zero hQ ec hc0)
  exact ⟨eb, symbol_ne_zero_of_span hL eb hspan, heval,
    fun j k hk ↦ finAppendCast_at_left hlen (fun j ↦ i (ea.1 j)) lift k j hk,
    fun j k hk ↦ finAppendCast_at_right hlen (fun j ↦ i (ea.1 j)) lift k j hk, fun _ ↦ rfl⟩

/-- The combinatorial shape of an admissible sequence in the middle of a three-by-three
diagram: a prefix matching a fixed sequence, then a block coming from `C`, then the tail of
the block coming from `G`, then a suffix coming from `I`. The parameter `t` records how far
the `G` block has already been moved past the `C` block. -/
private structure BlockArrangement
    (a c g s t : ℕ)
    (htotal : a + c + g + s = moduleLength R M)
    (ht : t ≤ g)
    (base : Fin (a + g) → M) (C : Fin c → M) (G : Fin g → M) (I : Fin s → M)
    (e : AdmissibleSequence R M) : Prop where
  prefixMatches : ∀ (k : Fin (moduleLength R M)) (hk : k.val < a + t),
    e.1 k = base ⟨k.val, by omega⟩
  cBlock : ∀ k : Fin c,
    e.1 ⟨a + t + k.val, by omega⟩ = C k
  gTail : ∀ k : Fin (g - t),
    e.1 ⟨a + t + c + k.val, by omega⟩ = G ⟨t + k.val, by omega⟩
  suffix : ∀ k : Fin s,
    e.1 ⟨a + c + g + k.val, by omega⟩ = I k

/-- Moving a block of `c` entries past a block of `g` entries of an admissible sequence, one
adjacent transposition at a time, multiplies the symbol by `(-1) ^ (c * g)`. -/
private lemma block_swap_aux
    (a c g s : ℕ) (htotal : a + c + g + s = moduleLength R M)
    (base : Fin (a + g) → M) (C : Fin c → M) (G : Fin g → M) (I : Fin s → M)
    (hstrong : ∀ j : Fin g, ∀ r, r ∈ IsLocalRing.maximalIdeal R →
      r • G j ∈ initialSpan (R := R) base (a + j.val))
    (hbaseG : ∀ j : Fin g, base ⟨a + j.val, by omega⟩ = G j)
    (t : ℕ) (ht : t ≤ g) (e : AdmissibleSequence R M)
    (ha : BlockArrangement (R := R) (M := M) a c g s t htotal ht base C G I e) :
    ∃ f : AdmissibleSequence R M,
      BlockArrangement (R := R) (M := M) a c g s g htotal (Nat.le_refl _) base C G I f ∧
        symbol e = ((-1 : IsLocalRing.ResidueField R) ^ (c * (g - t))) • symbol f := by
  classical
  by_cases htg : t = g
  · subst t
    exact ⟨e, ha, by simp⟩
  have hlt : t < g := by omega
  let j : Fin (moduleLength R M) := ⟨a + t, by omega⟩
  let i : Fin (moduleLength R M) := ⟨a + t + c, by omega⟩
  let gj : Fin g := ⟨t, by omega⟩
  have hpref : ∀ k (hk : k < a + t),
      e.1 ⟨k, by omega⟩ = base ⟨k, by omega⟩ :=
    fun k hk ↦ ha.prefixMatches ⟨k, by omega⟩ hk
  have hspan := initialSpan_eq_of_prefix (R := R) (e := e.1) (f := base) (a + t)
    (by omega) (by omega) hpref
  have hnext : e.1 i = G gj := by simpa [i, gj] using ha.gTail ⟨0, by omega⟩
  have hmove : ∀ r, r ∈ IsLocalRing.maximalIdeal R →
      r • e.1 i ∈ initialSpan (R := R) e.1 j.val := by
    intro r hr
    rw [hnext, hspan]
    exact hstrong gj r hr
  obtain ⟨e', hprev, hentry, hshift, hsuffix, hsymbol⟩ :=
    move_entry_exact e j i (by dsimp [j, i]; omega) hmove
  have ha' : BlockArrangement (R := R) (M := M) a c g s (t + 1) htotal (by omega)
      base C G I e' := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro k hk
      by_cases hkold : k.val < a + t
      · exact (hprev k hkold).trans (ha.prefixMatches k hkold)
      · have hkEq : k.val = a + t := by omega
        calc
          e'.1 k = e'.1 j := congrArg e'.1 (Fin.ext (by dsimp [j]; omega))
          _ = e.1 i := hentry
          _ = G gj := hnext
          _ = base ⟨a + t, by omega⟩ := (hbaseG gj).symm
          _ = base ⟨k.val, by omega⟩ := congrArg base (Fin.ext hkEq.symm)
    · intro k
      have hklt : k.val < c := k.isLt
      let posC : Fin (moduleLength R M) := ⟨a + t + k.val, by rw [← htotal]; omega⟩
      calc
        e'.1 ⟨a + (t + 1) + k.val, by omega⟩
            = e'.1 ⟨posC.val + 1, by dsimp [posC]; omega⟩ :=
          congrArg e'.1 (Fin.ext (by dsimp [posC]; omega))
        _ = e.1 posC := hshift posC (by dsimp [posC, j]; omega) (by dsimp [i, posC]; omega)
        _ = C k := ha.cBlock k
    · intro k
      have hklt : k.val < g - (t + 1) := k.isLt
      let kold : Fin (g - t) := ⟨k.val + 1, by omega⟩
      have hkG : t + 1 + k.val < g := by omega
      let pos : Fin (moduleLength R M) := ⟨a + t + c + (k.val + 1), by
        rw [← htotal]
        omega⟩
      let newpos : Fin (moduleLength R M) := ⟨a + (t + 1) + c + k.val, by
        rw [← htotal]
        omega⟩
      calc
        e'.1 newpos = e'.1 pos := congrArg e'.1 (Fin.ext (by dsimp [newpos, pos]; omega))
        _ = e.1 pos := hsuffix pos (by dsimp [pos, i]; omega)
        _ = G ⟨t + kold.val, by omega⟩ := ha.gTail kold
        _ = G ⟨(t + 1) + k.val, by omega⟩ := congrArg G (Fin.ext (by dsimp [kold]; omega))
    · exact fun k ↦
        (hsuffix ⟨a + c + g + k.val, by omega⟩ (by dsimp [i]; omega)).trans (ha.suffix k)
  obtain ⟨f, haf, hrest⟩ :=
    block_swap_aux a c g s htotal base C G I hstrong hbaseG (t + 1) (by omega) e' ha'
  refine ⟨f, haf, ?_⟩
  calc
    symbol e = ((-1 : IsLocalRing.ResidueField R) ^ c) • symbol e' := by
      have hc : i.val - j.val = c := by dsimp [i, j]; omega
      simpa [hc] using hsymbol
    _ = ((-1 : IsLocalRing.ResidueField R) ^ (c * (g - t))) • symbol f := by
      rw [hrest, smul_smul, ← pow_add, show g - t = g - (t + 1) + 1 by omega]
      congr 2
      ring
termination_by g - t

/-- Induction on an element of a determinant: it is enough to treat zero, sums, scalar
multiples and symbols, since the symbols generate the determinant. -/
public lemma determinant_induction {X : Type vA} [AddCommGroup X] [Module R X]
    (P : determinant R X → Prop)
    (hzero : P 0)
    (hadd : ∀ x y, P x → P y → P (x + y))
    (hsmul : ∀ (r : IsLocalRing.ResidueField R) x, P x → P (r • x))
    (hsymbol : ∀ e : AdmissibleSequence R X, P (symbol e))
    (x : determinant R X) : P x := by
  induction x using Submodule.Quotient.induction_on with
  | H z =>
    induction z using Finsupp.induction_linear with
    | zero => simpa using hzero
    | add z w hz hw =>
      rw [Submodule.Quotient.mk_add]
      exact hadd _ _ hz hw
    | single e r =>
      rw [show Finsupp.single e r = r • Finsupp.single e (1 : IsLocalRing.ResidueField R)
        by simp, Submodule.Quotient.mk_smul]
      exact hsmul r (symbol e) (hsymbol e)

/-- A scalar may be moved out of the left factor of a tensor. -/
private lemma tensor_smul_left {k : Type u} [CommSemiring k]
    {X : Type vA} {Y : Type vC} [AddCommMonoid X] [Module k X]
    [AddCommMonoid Y] [Module k Y]
    (r : k) (x : X) (y : Y) :
    (r • x) ⊗ₜ[k] y = r • (x ⊗ₜ[k] y) := by
  calc
    (r • x) ⊗ₜ[k] y = x ⊗ₜ[k] (r • y) := TensorProduct.smul_tmul r x y
    _ = r • (x ⊗ₜ[k] y) := TensorProduct.tmul_smul r x y

/-- Two linear maps out of a fourfold tensor product of determinants that agree on tensors of
four symbols are equal. -/
private lemma linearMap_eq_of_symbol_fourfold
    {A : Type vA} {C : Type vC} {G : Type vG} {I : Type vI} {E : Type vE}
    [AddCommGroup A] [Module R A] [AddCommGroup C] [Module R C]
    [AddCommGroup G] [Module R G] [AddCommGroup I] [Module R I]
    [AddCommGroup E] [Module R E]
    (f g : (determinant R A ⊗[IsLocalRing.ResidueField R] determinant R C) ⊗
        (determinant R G ⊗[IsLocalRing.ResidueField R] determinant R I)
      →ₗ[IsLocalRing.ResidueField R] determinant R E)
    (hsymbol : ∀ (a : AdmissibleSequence R A) (c : AdmissibleSequence R C)
      (g' : AdmissibleSequence R G) (i : AdmissibleSequence R I),
      f ((symbol a ⊗ₜ[IsLocalRing.ResidueField R] symbol c) ⊗ₜ[IsLocalRing.ResidueField R]
        (symbol g' ⊗ₜ[IsLocalRing.ResidueField R] symbol i)) =
      g ((symbol a ⊗ₜ[IsLocalRing.ResidueField R] symbol c) ⊗ₜ[IsLocalRing.ResidueField R]
        (symbol g' ⊗ₜ[IsLocalRing.ResidueField R] symbol i))) : f = g := by
  apply TensorProduct.ext_fourfold'
  intro a c g' i
  have hA : ∀ (xA : determinant R A) (xC : determinant R C)
      (xG : determinant R G) (xI : determinant R I),
      f ((xA ⊗ₜ[IsLocalRing.ResidueField R] xC) ⊗ₜ[IsLocalRing.ResidueField R]
        (xG ⊗ₜ[IsLocalRing.ResidueField R] xI)) =
        g ((xA ⊗ₜ[IsLocalRing.ResidueField R] xC) ⊗ₜ[IsLocalRing.ResidueField R]
          (xG ⊗ₜ[IsLocalRing.ResidueField R] xI)) := by
    intro xA
    refine determinant_induction (R := R) (X := A)
      (fun xA => ∀ xC xG xI,
        f ((xA ⊗ₜ[IsLocalRing.ResidueField R] xC) ⊗ₜ[IsLocalRing.ResidueField R]
          (xG ⊗ₜ[IsLocalRing.ResidueField R] xI)) =
        g ((xA ⊗ₜ[IsLocalRing.ResidueField R] xC) ⊗ₜ[IsLocalRing.ResidueField R]
          (xG ⊗ₜ[IsLocalRing.ResidueField R] xI))) ?_ ?_ ?_ ?_ xA
    · intro xC xG xI
      simp
    · intro x y hx hy xC xG xI
      simp [TensorProduct.add_tmul, hx xC xG xI, hy xC xG xI]
    · intro r x hx xC xG xI
      rw [tensor_smul_left, tensor_smul_left, map_smul, map_smul, hx xC xG xI]
    · intro ea xC xG xI
      refine determinant_induction (R := R) (X := C)
        (fun xC =>
          f ((symbol ea ⊗ₜ[IsLocalRing.ResidueField R] xC) ⊗ₜ[IsLocalRing.ResidueField R]
            (xG ⊗ₜ[IsLocalRing.ResidueField R] xI)) =
          g ((symbol ea ⊗ₜ[IsLocalRing.ResidueField R] xC) ⊗ₜ[IsLocalRing.ResidueField R]
            (xG ⊗ₜ[IsLocalRing.ResidueField R] xI))) ?_ ?_ ?_ ?_ xC
      · simp
      · intro x y hx hy
        simp [TensorProduct.tmul_add, TensorProduct.add_tmul, hx, hy]
      · intro r x hx
        rw [TensorProduct.tmul_smul, tensor_smul_left, map_smul, map_smul, hx]
      · intro ec
        refine determinant_induction (R := R) (X := G)
          (fun xG =>
            f ((symbol ea ⊗ₜ[IsLocalRing.ResidueField R] symbol ec) ⊗ₜ[
                IsLocalRing.ResidueField R] (xG ⊗ₜ[IsLocalRing.ResidueField R] xI)) =
            g ((symbol ea ⊗ₜ[IsLocalRing.ResidueField R] symbol ec) ⊗ₜ[
                IsLocalRing.ResidueField R] (xG ⊗ₜ[IsLocalRing.ResidueField R] xI))) ?_ ?_ ?_ ?_ xG
        · simp
        · intro x y hx hy
          simp [TensorProduct.add_tmul, TensorProduct.tmul_add, hx, hy]
        · intro r x hx
          rw [tensor_smul_left, TensorProduct.tmul_smul, map_smul, map_smul, hx]
        · intro eg
          refine determinant_induction (R := R) (X := I)
            (fun xI =>
              f ((symbol ea ⊗ₜ[IsLocalRing.ResidueField R] symbol ec) ⊗ₜ[
                  IsLocalRing.ResidueField R] (symbol eg ⊗ₜ[IsLocalRing.ResidueField R] xI)) =
              g ((symbol ea ⊗ₜ[IsLocalRing.ResidueField R] symbol ec) ⊗ₜ[
                  IsLocalRing.ResidueField R] (symbol eg ⊗ₜ[IsLocalRing.ResidueField R] xI)))
            ?_ ?_ ?_ ?_ xI
          · simp
          · intro x y hx hy
            simp [TensorProduct.tmul_add, hx, hy]
          · intro r x hx
            rw [TensorProduct.tmul_smul, TensorProduct.tmul_smul, map_smul, map_smul, hx]
          · intro ei
            exact hsymbol ea ec eg ei
  exact hA a c g' i

/-- The signed interchange of the middle two factors of a fourfold tensor product. -/
public def signedTensorInterchange
    (k : Type u) [CommRing k]
    (A : Type vA) (C : Type vC) (G : Type vG) (I : Type vI)
    [AddCommGroup A] [Module k A] [AddCommGroup C] [Module k C]
    [AddCommGroup G] [Module k G] [AddCommGroup I] [Module k I]
    (c g : ℕ) :
    (A ⊗[k] C) ⊗[k] (G ⊗[k] I) →ₗ[k] (A ⊗[k] G) ⊗[k] (C ⊗[k] I) :=
  ((-1 : k) ^ (c * g)) •
    ((TensorProduct.assoc k A C (G ⊗[k] I)).trans
      ((LinearEquiv.lTensor A (TensorProduct.assoc k C G I).symm).trans
        ((LinearEquiv.lTensor A ((TensorProduct.comm k C G).rTensor I)).trans
          ((LinearEquiv.lTensor A (TensorProduct.assoc k G C I)).trans
            (TensorProduct.assoc k A G (C ⊗[k] I)).symm)))).toLinearMap

/-- **Stacks Project, Tag 02PA (`gamma_three_by_three`).** In a commutative
three-by-three diagram with exact rows and columns, the two composites of determinant maps
coincide after the middle determinant factors are interchanged with the Koszul sign. -/
@[stacks 02PA "gamma_three_by_three"]
public theorem determinantExactSequenceMap_three_by_three
    {R : Type u} [CommRing R] [IsLocalRing R]
    {A : Type vA} {B : Type vB} {C : Type vC}
    {D : Type vD} {E : Type vE} {F : Type vF}
    {G : Type vG} {H : Type vH} {I : Type vI}
    [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B]
    [AddCommGroup C] [Module R C] [AddCommGroup D] [Module R D]
    [AddCommGroup E] [Module R E] [AddCommGroup F] [Module R F]
    [AddCommGroup G] [Module R G] [AddCommGroup H] [Module R H]
    [AddCommGroup I] [Module R I]
    (iAB : A →ₗ[R] B) (pBC : B →ₗ[R] C)
    (iDE : D →ₗ[R] E) (pEF : E →ₗ[R] F)
    (iGH : G →ₗ[R] H) (pHI : H →ₗ[R] I)
    (iAD : A →ₗ[R] D) (iBE : B →ₗ[R] E) (iCF : C →ₗ[R] F)
    (pDG : D →ₗ[R] G) (pEH : E →ₗ[R] H) (pFI : F →ₗ[R] I)
    (hAB : Function.Injective iAB) (hBC : Function.Surjective pBC)
    (hexABC : Function.Exact iAB pBC)
    (hDE : Function.Injective iDE) (hEF : Function.Surjective pEF)
    (hexDEF : Function.Exact iDE pEF)
    (hGH : Function.Injective iGH) (hHI : Function.Surjective pHI)
    (hexGHI : Function.Exact iGH pHI)
    (hAD : Function.Injective iAD) (hDG : Function.Surjective pDG)
    (hexADG : Function.Exact iAD pDG)
    (hBE : Function.Injective iBE) (hEH : Function.Surjective pEH)
    (hexBEH : Function.Exact iBE pEH)
    (hCF : Function.Injective iCF) (hFI : Function.Surjective pFI)
    (hexCFI : Function.Exact iCF pFI)
    (commADEB : iDE.comp iAD = iBE.comp iAB)
    (commBEFC : pEF.comp iBE = iCF.comp pBC)
    (commDGEH : iGH.comp pDG = pEH.comp iDE)
    (commEHIF : pHI.comp pEH = pFI.comp pEF)
    (hA : IsFiniteLength R A) (hB : IsFiniteLength R B) (hC : IsFiniteLength R C)
    (hD : IsFiniteLength R D) (hE : IsFiniteLength R E) (hF : IsFiniteLength R F)
    (hG : IsFiniteLength R G) (hH : IsFiniteLength R H) (hI : IsFiniteLength R I) :
    (determinantExactSequenceMap iBE pEH hBE hEH hexBEH hB hE hH).comp
        (TensorProduct.map
          (determinantExactSequenceMap iAB pBC hAB hBC hexABC hA hB hC)
          (determinantExactSequenceMap iGH pHI hGH hHI hexGHI hG hH hI)) =
      (determinantExactSequenceMap iDE pEF hDE hEF hexDEF hD hE hF).comp
        ((TensorProduct.map
          (determinantExactSequenceMap iAD pDG hAD hDG hexADG hA hD hG)
          (determinantExactSequenceMap iCF pFI hCF hFI hexCFI hC hF hI)).comp
            (signedTensorInterchange (IsLocalRing.ResidueField R)
              (determinant R A) (determinant R C) (determinant R G) (determinant R I)
              (moduleLength R C) (moduleLength R G))) := by
  classical
  let γAB := determinantExactSequenceMap iAB pBC hAB hBC hexABC hA hB hC
  let γGH := determinantExactSequenceMap iGH pHI hGH hHI hexGHI hG hH hI
  let γBEH := determinantExactSequenceMap iBE pEH hBE hEH hexBEH hB hE hH
  let γADG := determinantExactSequenceMap iAD pDG hAD hDG hexADG hA hD hG
  let γCFI := determinantExactSequenceMap iCF pFI hCF hFI hexCFI hC hF hI
  let γDEF := determinantExactSequenceMap iDE pEF hDE hEF hexDEF hD hE hF
  let lhs := γBEH.comp (TensorProduct.map γAB γGH)
  let rhs := γDEF.comp ((TensorProduct.map γADG γCFI).comp
    (signedTensorInterchange (IsLocalRing.ResidueField R)
      (determinant R A) (determinant R C) (determinant R G) (determinant R I)
      (moduleLength R C) (moduleLength R G)))
  refine linearMap_eq_of_symbol_fourfold lhs rhs fun ea ec eg ei ↦ ?_
  by_cases ha0 : symbol ea = 0
  · simp [lhs, rhs, ha0]
  by_cases hc0 : symbol ec = 0
  · simp [lhs, rhs, hc0]
  by_cases hg0 : symbol eg = 0
  · simp [lhs, rhs, hg0]
  by_cases hi0 : symbol ei = 0
  · simp [lhs, rhs, hi0]
  have hAspan := span_eq_top_of_symbol_ne_zero hA ea ha0
  have hCspan := span_eq_top_of_symbol_ne_zero hC ec hc0
  have hGspan := span_eq_top_of_symbol_ne_zero hG eg hg0
  have hIspan := span_eq_top_of_symbol_ne_zero hI ei hi0
  let liftC : Fin (moduleLength R C) → B := fun j ↦ Classical.choose (hBC (ec.1 j))
  have hliftC (j : Fin (moduleLength R C)) : pBC (liftC j) = ec.1 j :=
    Classical.choose_spec (hBC (ec.1 j))
  let liftG : Fin (moduleLength R G) → D := fun j ↦ Classical.choose (hDG (eg.1 j))
  have hliftG (j : Fin (moduleLength R G)) : pDG (liftG j) = eg.1 j :=
    Classical.choose_spec (hDG (eg.1 j))
  let liftI_H : Fin (moduleLength R I) → H := fun j ↦ Classical.choose (hHI (ei.1 j))
  have hliftI_H (j : Fin (moduleLength R I)) : pHI (liftI_H j) = ei.1 j :=
    Classical.choose_spec (hHI (ei.1 j))
  let liftI_E : Fin (moduleLength R I) → E := fun j ↦
    Classical.choose (hEH (liftI_H j))
  have hliftI_E (j : Fin (moduleLength R I)) : pEH (liftI_E j) = liftI_H j :=
    Classical.choose_spec (hEH (liftI_H j))
  let liftI_F : Fin (moduleLength R I) → F := fun j ↦ pEF (liftI_E j)
  have hIcomm (j : Fin (moduleLength R I)) :
      pHI (pEH (liftI_E j)) = pFI (pEF (liftI_E j)) :=
    LinearMap.congr_fun commEHIF (liftI_E j)
  have hLiftIF (j : Fin (moduleLength R I)) : pFI (liftI_F j) = ei.1 j := by
    rw [← hIcomm, hliftI_E, hliftI_H]
  have hABlen := moduleLength_add_of_exact iAB pBC hAB hBC hexABC hA hB hC
  have hGHlen := moduleLength_add_of_exact iGH pHI hGH hHI hexGHI hG hH hI
  have hADlen := moduleLength_add_of_exact iAD pDG hAD hDG hexADG hA hD hG
  have hCFlen := moduleLength_add_of_exact iCF pFI hCF hFI hexCFI hC hF hI
  have hBEHlen := moduleLength_add_of_exact iBE pEH hBE hEH hexBEH hB hE hH
  have hDEFlen := moduleLength_add_of_exact iDE pEF hDE hEF hexDEF hD hE hF
  obtain ⟨eb, hbne, hbEval, ebA, ebC, -⟩ := exists_concat_sequence iAB pBC hAB hBC hexABC
    hA hB hC hABlen ea ec ha0 hc0 liftC hliftC
  obtain ⟨eh, hhne, hhEval, -, -, ehform⟩ := exists_concat_sequence iGH pHI hGH hHI hexGHI
    hG hH hI hGHlen eg ei hg0 hi0 liftI_H hliftI_H
  obtain ⟨ed, hdne, hdEval, edA, edG, -⟩ := exists_concat_sequence iAD pDG hAD hDG hexADG
    hA hD hG hADlen ea eg ha0 hg0 liftG hliftG
  obtain ⟨ef, hfne, hfEval, -, -, efform⟩ := exists_concat_sequence iCF pFI hCF hFI hexCFI
    hC hF hI hCFlen ec ei hc0 hi0 liftI_F hLiftIF
  let liftH : Fin (moduleLength R H) → E := fun j ↦
    Fin.append (fun k ↦ iDE (liftG k)) liftI_E (Fin.cast hGHlen j)
  have hGmap :
      (fun k : Fin (moduleLength R G) ↦ pEH (iDE (liftG k))) =
        (fun k ↦ iGH (eg.1 k)) := by
    funext k
    have hcomm := congrArg (fun q : D →ₗ[R] H ↦ q (liftG k)) commDGEH
    simpa [LinearMap.comp_apply, hliftG] using hcomm.symm
  have hImap : (fun k : Fin (moduleLength R I) ↦ pEH (liftI_E k)) = liftI_H :=
    funext hliftI_E
  have hLiftH (j : Fin (moduleLength R H)) : pEH (liftH j) = eh.1 j := by
    rw [ehform]
    dsimp [liftH]
    rw [linearMap_append_apply, hGmap, hImap]
  obtain ⟨eLeft, -, hLeftEval, eLeftL, eLeftR, -⟩ := exists_concat_sequence iBE pEH hBE hEH
    hexBEH hB hE hH hBEHlen eb eh hbne hhne liftH hLiftH
  let liftF_E : Fin (moduleLength R F) → E := fun j ↦
    Fin.append (fun k ↦ iBE (liftC k)) liftI_E (Fin.cast hCFlen j)
  have hCmap :
      (fun k : Fin (moduleLength R C) ↦ pEF (iBE (liftC k))) =
        (fun k ↦ iCF (ec.1 k)) := by
    funext k
    have hcomm := congrArg (fun q : B →ₗ[R] F ↦ q (liftC k)) commBEFC
    simpa [LinearMap.comp_apply, hliftC] using hcomm
  have hLiftF (j : Fin (moduleLength R F)) : pEF (liftF_E j) = ef.1 j := by
    rw [efform]
    dsimp [liftF_E]
    rw [linearMap_append_apply, hCmap]
  obtain ⟨eRight, -, hRightEval, eRightL, eRightR, -⟩ := exists_concat_sequence iDE pEF hDE hEF
    hexDEF hD hE hF hDEFlen ed ef hdne hfne liftF_E hLiftF
  let aN := moduleLength R A
  let cN := moduleLength R C
  let gN := moduleLength R G
  let sN := moduleLength R I
  let eN := moduleLength R E
  have hABN : moduleLength R B = aN + cN := hABlen
  have hGHN : moduleLength R H = gN + sN := hGHlen
  have hADN : moduleLength R D = aN + gN := hADlen
  have hCFN : moduleLength R F = cN + sN := hCFlen
  have heTotal : aN + cN + gN + sN = eN := by
    dsimp [aN, cN, gN, sN, eN]
    omega
  have hbaseLen : aN + gN ≤ eN := by
    dsimp [aN, gN, eN]
    omega
  let base : Fin (aN + gN) → E := fun j ↦
    eRight.1 ⟨j.val, Nat.lt_of_lt_of_le j.isLt hbaseLen⟩
  let Cblock : Fin cN → E := fun j ↦
    eRight.1 ⟨aN + gN + j.val, by dsimp [aN, cN, gN, eN]; omega⟩
  let Gblock : Fin gN → E := fun j ↦ base ⟨aN + j.val, by dsimp [aN, gN]; omega⟩
  let Iblock : Fin sN → E := fun j ↦
    eRight.1 ⟨aN + cN + gN + j.val, by dsimp [aN, cN, gN, sN, eN]; omega⟩
  have hbasePrefix (k : ℕ) (hk : k < aN + gN) :
      eRight.1 ⟨k, by omega⟩ =
        base ⟨k, hk⟩ := rfl
  have hstrong : ∀ j : Fin gN, ∀ r, r ∈ IsLocalRing.maximalIdeal R →
      r • Gblock j ∈ initialSpan (R := R) base (aN + j.val) := by
    intro j r hr
    let pos : Fin eN := ⟨aN + j.val, by dsimp [aN, gN, eN]; omega⟩
    have hspan := initialSpan_eq_of_prefix (R := R) (e := eRight.1) (f := base)
      (aN + j.val) (by dsimp [aN, gN, eN]; omega) (by dsimp [aN, gN]; omega)
      (by
        intro k hk
        exact hbasePrefix k (lt_trans hk (by omega)))
    have hadm := eRight.2 pos r hr
    change r • eRight.1 pos ∈ initialSpan (R := R) eRight.1 (aN + j.val) at hadm
    rw [hspan] at hadm
    change r • Gblock j ∈ initialSpan (R := R) base (aN + j.val)
    simpa [Gblock, base, pos]
      using hadm
  have hbaseG (j : Fin gN) : base ⟨aN + j.val, by dsimp [aN, gN]; omega⟩ =
      Gblock j := rfl
  have hRightArrangement :
      BlockArrangement (R := R) (M := E) aN cN gN sN gN heTotal (Nat.le_refl _)
        base Cblock Gblock Iblock eRight := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro k hk
      rfl
    · intro k
      rfl
    · intro k
      have hk : k.val < 0 := by simpa using k.isLt
      omega
    · intro k
      rfl
  have hLeftA (j : Fin aN) :
      eLeft.1 ⟨j.val, by omega⟩ = iBE (iAB (ea.1 j)) :=
    (eLeftL ⟨j.val, by omega⟩ _ rfl).trans (congrArg iBE (ebA j _ rfl))
  have hLeftC (j : Fin cN) :
      eLeft.1 ⟨aN + j.val, by omega⟩ = iBE (liftC j) :=
    (eLeftL ⟨aN + j.val, by omega⟩ _ rfl).trans (congrArg iBE (ebC j _ rfl))
  have hLeftG (j : Fin gN) :
      eLeft.1 ⟨aN + cN + j.val, by omega⟩ = iDE (liftG j) :=
    (eLeftR ⟨j.val, by omega⟩ _ (by dsimp; omega)).trans
      (finAppendCast_at_left hGHlen _ _ _ j rfl)
  have hLeftI (j : Fin sN) :
      eLeft.1 ⟨aN + cN + gN + j.val, by omega⟩ = liftI_E j :=
    (eLeftR ⟨gN + j.val, by omega⟩ _ (by dsimp; omega)).trans
      (finAppendCast_at_right hGHlen _ _ _ j rfl)
  have hRightA (j : Fin aN) :
      eRight.1 ⟨j.val, by omega⟩ = iDE (iAD (ea.1 j)) :=
    (eRightL ⟨j.val, by omega⟩ _ rfl).trans (congrArg iDE (edA j _ rfl))
  have hRightG (j : Fin gN) :
      eRight.1 ⟨aN + j.val, by omega⟩ = iDE (liftG j) :=
    (eRightL ⟨aN + j.val, by omega⟩ _ rfl).trans (congrArg iDE (edG j _ rfl))
  have hRightC (j : Fin cN) :
      eRight.1 ⟨aN + gN + j.val, by omega⟩ = iBE (liftC j) :=
    (eRightR ⟨j.val, by omega⟩ _ (by dsimp; omega)).trans
      (finAppendCast_at_left hCFlen _ _ _ j rfl)
  have hRightI (j : Fin sN) :
      eRight.1 ⟨aN + gN + cN + j.val, by omega⟩ = liftI_E j :=
    (eRightR ⟨cN + j.val, by omega⟩ _ (by dsimp; omega)).trans
      (finAppendCast_at_right hCFlen _ _ _ j rfl)
  have hADEB_apply (x : A) : iDE (iAD x) = iBE (iAB x) := by
    have h := congrArg (fun q : A →ₗ[R] E ↦ q x) commADEB
    simpa [LinearMap.comp_apply] using h
  have hLeftArrangement :
      BlockArrangement (R := R) (M := E) aN cN gN sN 0 heTotal (Nat.zero_le _)
        base Cblock Gblock Iblock eLeft := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro k hk
      let j : Fin aN := ⟨k.val, by omega⟩
      have hkj : k = ⟨j.val, by omega⟩ := Fin.ext rfl
      calc
        eLeft.1 k = iBE (iAB (ea.1 j)) := by rw [hkj, hLeftA j]
        _ = iDE (iAD (ea.1 j)) := (hADEB_apply _).symm
        _ = eRight.1 ⟨j.val, by omega⟩ := (hRightA j).symm
        _ = base ⟨k.val, by omega⟩ := by
          simp only [base]
          apply congrArg eRight.1
          apply Fin.ext
          simp [j]
    · intro j
      calc
        eLeft.1 ⟨aN + j.val, by omega⟩ = iBE (liftC j) := hLeftC j
        _ = eRight.1 ⟨aN + gN + j.val, by omega⟩ := (hRightC j).symm
        _ = Cblock j := rfl
    · intro j
      calc
        eLeft.1 ⟨aN + cN + j.val, by omega⟩ = iDE (liftG j) := hLeftG j
        _ = eRight.1 ⟨aN + j.val, by omega⟩ := (hRightG j).symm
        _ = Gblock ⟨0 + j.val, by omega⟩ := by
          simp [Gblock, base]
    · intro j
      calc
        eLeft.1 ⟨aN + cN + gN + j.val, by omega⟩ = liftI_E j := hLeftI j
        _ = eRight.1 ⟨aN + gN + cN + j.val, by omega⟩ := (hRightI j).symm
        _ = Iblock j := by
          change eRight.1 ⟨aN + gN + cN + j.val, by omega⟩ =
            eRight.1 ⟨aN + cN + gN + j.val, by omega⟩
          exact congrArg eRight.1 (Fin.ext (by ring))
  obtain ⟨eSwap, hSwapArrangement, hSwapSymbol⟩ :=
    block_swap_aux aN cN gN sN heTotal base Cblock Gblock Iblock hstrong hbaseG
      0 (Nat.zero_le _) eLeft hLeftArrangement
  have heSwap_eq : eSwap = eRight := by
    apply Subtype.ext
    funext k
    by_cases hk : k.val < aN + gN
    · exact (hSwapArrangement.prefixMatches k hk).trans
        (hRightArrangement.prefixMatches k hk).symm
    · by_cases hc : k.val < aN + gN + cN
      · let j : Fin cN := ⟨k.val - (aN + gN), by omega⟩
        have hidx : k = ⟨aN + gN + j.val, by omega⟩ := Fin.ext (by dsimp [j]; omega)
        rw [hidx]
        exact (hSwapArrangement.cBlock j).trans (hRightArrangement.cBlock j).symm
      · let j : Fin sN := ⟨k.val - (aN + cN + gN), by omega⟩
        have hidx : k = ⟨aN + cN + gN + j.val, by omega⟩ :=
          Fin.ext (by dsimp [j]; omega)
        rw [hidx]
        exact (hSwapArrangement.suffix j).trans (hRightArrangement.suffix j).symm
  have hSymbolInterchange :
      symbol eLeft = ((-1 : IsLocalRing.ResidueField R) ^ (cN * gN)) • symbol eRight := by
    simpa [heSwap_eq] using hSwapSymbol
  let x0 := ((symbol ea ⊗ₜ[IsLocalRing.ResidueField R] symbol ec) ⊗ₜ[
      IsLocalRing.ResidueField R] (symbol eg ⊗ₜ[IsLocalRing.ResidueField R] symbol ei))
  let sign : IsLocalRing.ResidueField R := (-1) ^ (cN * gN)
  have hInterchange :
      signedTensorInterchange (IsLocalRing.ResidueField R)
        (determinant R A) (determinant R C) (determinant R G) (determinant R I)
        cN gN x0 = sign •
          ((symbol ea ⊗ₜ[IsLocalRing.ResidueField R] symbol eg) ⊗ₜ[
            IsLocalRing.ResidueField R]
            (symbol ec ⊗ₜ[IsLocalRing.ResidueField R] symbol ei)) := by
    simp [signedTensorInterchange, x0, sign]
  have hLhs : lhs x0 = symbol eLeft := by
    change γBEH ((TensorProduct.map γAB γGH)
      ((symbol ea ⊗ₜ[IsLocalRing.ResidueField R] symbol ec) ⊗ₜ[
        IsLocalRing.ResidueField R] (symbol eg ⊗ₜ[IsLocalRing.ResidueField R] symbol ei))) =
      symbol eLeft
    rw [TensorProduct.map_tmul, hbEval, hhEval, hLeftEval]
  have hRhs : rhs x0 = sign • symbol eRight := by
    simp only [rhs, LinearMap.comp_apply]
    rw [hInterchange, map_smul, map_smul, TensorProduct.map_tmul, hdEval, hfEval, hRightEval]
  calc
    lhs x0 = symbol eLeft := hLhs
    _ = sign • symbol eRight := by simpa [sign] using hSymbolInterchange
    _ = rhs x0 := hRhs.symm

end Module.FiniteLength
end
