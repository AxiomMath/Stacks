module

public import Mathlib.LinearAlgebra.Dimension.Constructions
public import StacksFrontier.AlgebraicGeometry.Chow.DeterminantsFiniteLength.DimensionLeOne
public import StacksFrontier.AlgebraicGeometry.Chow.DeterminantsFiniteLength.Spanning

/-!
# The determinant of a finite length module is generated by one symbol

Let `R` be a local ring with residue field `κ` and let `M` be a finite-length `R`-module.
There is an admissible sequence of `M` spanning `M`, the symbol of such a sequence generates
the determinant over `κ`, and consequently the rank of the determinant over `κ` is at most
one.

## Main results

* `Module.FiniteLength.exists_span_eq_top_and_span_symbol_eq_top` produces an admissible
  sequence that spans `M` and whose symbol generates the determinant.
* `Module.FiniteLength.rank_determinant_le_one` bounds the rank of the determinant by one.

## Implementation notes

The bound is stated with `Module.rank`, a cardinal, so it is a genuine bound on the
dimension and does not presuppose that the determinant is finite-dimensional. The spanning
admissible sequence is produced from the finite-length hypothesis alone, by
`exists_admissible_generator`, and is not an input.

## References

* [Stacks Project, Tag 02P7](https://stacks.math.columbia.edu/tag/02P7)
-/

@[expose] public section

noncomputable section

namespace Module.FiniteLength

universe u v

/-- **Stacks Project, Tag 02P7.** A finite-length module over a local ring has an
admissible sequence that spans it, and the symbol of that sequence generates the
determinant over the residue field. -/
@[stacks 02P7 "generator"]
public theorem exists_span_eq_top_and_span_symbol_eq_top
    {R : Type u} {M : Type v} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] (hM : IsFiniteLength R M) :
    ∃ e : AdmissibleSequence R M, Submodule.span R (Set.range e.1) = ⊤ ∧
      (IsLocalRing.ResidueField R) ∙ symbol e = ⊤ := by
  obtain ⟨e, he⟩ := exists_admissible_generator hM
  exact ⟨e, he, span_symbol_eq_top hM e he⟩

/-- **Stacks Project, Tag 02P7.** The determinant of a finite-length module over a local
ring has dimension at most one over the residue field. -/
@[stacks 02P7]
public theorem rank_determinant_le_one
    (R : Type u) (M : Type v) [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] (hM : IsFiniteLength R M) :
    Module.rank (IsLocalRing.ResidueField R) (determinant R M) ≤ 1 := by
  obtain ⟨e, -, he⟩ := exists_span_eq_top_and_span_symbol_eq_top hM
  rw [← rank_top, ← he]
  exact (rank_span_le _).trans_eq (by simp)

end Module.FiniteLength

end
