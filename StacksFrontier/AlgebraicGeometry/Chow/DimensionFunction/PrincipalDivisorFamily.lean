module

public import StacksFrontier.AlgebraicGeometry.Chow.DimensionFunction.PrincipalDivisor
public import StacksFrontier.AlgebraicGeometry.Chow.RationalEquivalenceDefs

/-!
# Locally finite sums of principal divisors

Rational equivalence on the cycles of delta-dimension `k` is generated by the cycles

  `∑_j (i_j)_* div(g_j)`,

where `(W_j)_j` is a locally finite family of integral closed subschemes of `X` of
delta-dimension `k + 1`, `g_j` is a nonzero rational function on `W_j`, and `i_j : W_j → X` is
the inclusion. Stacks 02RW asks that such a sum really be an element of `Z_k(X)`: the sum of a
locally finite family of cycles has locally finite support, and each summand is a `k`-cycle
because `div(g_j)` is a cycle of delta-dimension `(k + 1) - 1` on `W_j` (Stacks 02RO) and proper
pushforward preserves the grading (Stacks 02R4).

The coefficient function of the sum is `Stacks.Chow.principalDivisorFamilyCoefficient`, which is
what `Stacks.Chow.IsRationallyEquivalentToZero` is phrased against; the content of this file is
that it is the coefficient function of an actual `k`-cycle.

## Main results

* `Stacks.Chow.locallyFiniteSupport_finsum_of_locallyFinite` — the pointwise sum of a family of
  functions supported on a locally finite family of sets, each with locally finite support, has
  locally finite support.
* `Stacks.Chow.principalDivisorPushforward_mem_cyclesOfDimension` — the pushforward of a
  principal divisor from an integral closed subscheme of delta-dimension `k + 1` is a
  `k`-cycle.
* `Stacks.Chow.exists_principalDivisorFamilySum` — Stacks 02RW: a locally finite family of
  principal divisors has a sum in `Z_k(X)`.

## Implementation notes

Local finiteness of a family of sets is `LocallyFinite`, and local finiteness of the support of
a coefficient function is `LocallyFiniteSupport`; the first is used for the family of supports
`(W_j)_j` and the second for each summand, as in
`Stacks.Chow.principalDivisorFamilyCoefficient_sum`. The sum over the index type is the
unconditional `finsum`, which is zero unless the summand family has finite support; the
neighbourhood witnessing local finiteness of the sum is the intersection of one witnessing local
finiteness of the family with the finitely many witnesses belonging to the members that meet it.

## References

* [Stacks Project, Tag 02R4](https://stacks.math.columbia.edu/tag/02R4)
* [Stacks Project, Tag 02RO](https://stacks.math.columbia.edu/tag/02RO)
* [Stacks Project, Tag 02RW](https://stacks.math.columbia.edu/tag/02RW)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Order TopologicalSpace

universe u

namespace Stacks.Chow

/-- A nonzero `finsum` has a nonzero summand. -/
private theorem exists_ne_zero_of_finsum_ne_zero' {ι : Type*} {f : ι → ℤ}
    (h : ∑ᶠ i, f i ≠ 0) : ∃ i, f i ≠ 0 := by
  contrapose! h
  exact finsum_eq_zero_of_forall_eq_zero h

/-- The pointwise sum of a family `c` of integer-valued functions has locally finite support, as
soon as the supports are contained in a locally finite family of sets `E` and each summand has
locally finite support: near a point only the finitely many members of `E` meeting a
neighbourhood contribute, and their supports are locally finite there. -/
theorem locallyFiniteSupport_finsum_of_locallyFinite {ι : Type*} {Z : Type*}
    [TopologicalSpace Z] (E : ι → Set Z) (hE : LocallyFinite E) (c : ι → Z → ℤ)
    (hsub : ∀ i, Function.support (c i) ⊆ E i) (hloc : ∀ i, LocallyFiniteSupport (c i)) :
    LocallyFiniteSupport fun z ↦ ∑ᶠ i, c i z := by
  classical
  intro z
  obtain ⟨U, hU, hUfin⟩ := hE z
  choose t ht htfin using fun i ↦ hloc i z
  refine ⟨U ∩ ⋂ i ∈ hUfin.toFinset, t i,
    Filter.inter_mem hU ((Filter.biInter_finset_mem _).2 fun i _ ↦ ht i), ?_⟩
  refine Set.Finite.subset (hUfin.toFinset.finite_toSet.biUnion fun i _ ↦ htfin i) ?_
  rintro x ⟨⟨hxU, hxt⟩, hxs⟩
  obtain ⟨i, hi⟩ := exists_ne_zero_of_finsum_ne_zero' hxs
  have hiI : i ∈ hUfin.toFinset := (Set.Finite.mem_toFinset _).mpr ⟨x, hsub i hi, hxU⟩
  exact Set.mem_biUnion hiI ⟨Set.mem_iInter₂.mp hxt i hiI, hi⟩

/-- The pushforward along the inclusion of an integral closed subscheme `V ⊆ X` of
delta-dimension `k + 1` of the principal divisor of a nonzero rational function on `V` is a
cycle of delta-dimension `k` on `X`: the principal divisor is a cycle of delta-dimension
`(k + 1) - 1` on `V` by Stacks 02RO, and proper pushforward preserves the grading. -/
theorem principalDivisorPushforward_mem_cyclesOfDimension (C : ChowSituation.{u})
    {X : Scheme.{u}} (p : X ⟶ C.S) [LocallyOfFiniteType p] (k : ℤ) (V : X.IdealSheafData)
    (hV : IsIntegral V.subscheme)
    (hDim : schemeDeltaDimension C (V.subschemeι ≫ p) = ((k + 1 : ℤ) : EInt))
    (g : (rationalFunctions V.subscheme)ˣ) :
    principalDivisorPushforward C p V hV g ∈ cyclesOfDimension C p k := by
  have : IsLocallyNoetherian V.subscheme :=
    LocallyOfFiniteType.isLocallyNoetherian (V.subschemeι ≫ p)
  have hc : principalCycle V.subscheme
      ((rationalFunctionsEquivFunctionField V.subscheme).1 (g : rationalFunctions V.subscheme))
      ∈ cyclesOfDimension C (V.subschemeι ≫ p) k := by
    simpa only [add_sub_cancel_right] using
      principalCycle_mem_cyclesOfDimension C (V.subschemeι ≫ p) hDim _
  exact map_mem_cyclesOfDimension C (V.subschemeι ≫ p) p V.subschemeι rfl k ⟨_, hc⟩

/-- **Stacks 02RW.** A locally finite family of integral closed subschemes of `X` of
delta-dimension `k + 1`, each carrying a nonzero rational function, determines a cycle of
delta-dimension `k` on `X`, whose coefficients are the locally finite sums of the coefficients
of the pushed-forward principal divisors. -/
@[stacks 02RW "locally finite sums of principal divisors"]
theorem exists_principalDivisorFamilySum (C : ChowSituation.{u}) {X : Scheme.{u}}
    (p : X ⟶ C.S) [LocallyOfFiniteType p] (k : ℤ) {J : Type u} (W : J → X.IdealSheafData)
    (hW : ∀ j, IsIntegral (W j).subscheme)
    (hDim : ∀ j, schemeDeltaDimension C ((W j).subschemeι ≫ p) = ((k + 1 : ℤ) : EInt))
    (hLocal : LocallyFinite fun j ↦ ((W j).support : Set X))
    (g : ∀ j, (rationalFunctions (W j).subscheme)ˣ) :
    ∃ α : CycleGroup C p k,
      ∀ x : X, α.1 x = principalDivisorFamilyCoefficient C p W hW g x := by
  have hloc := locallyFiniteSupport_finsum_of_locallyFinite
    (fun j ↦ ((W j).support : Set X)) hLocal
    (fun j x ↦ principalDivisorPushforward C p (W j) (hW j) (g j) x)
    (fun j ↦ support_principalDivisorPushforward_subset C p (W j) (hW j) (g j))
    (fun j ↦ (principalDivisorPushforward C p (W j) (hW j) (g j)).locallyFiniteSupport)
  refine ⟨⟨⟨principalDivisorFamilyCoefficient C p W hW g, by simp, fun z _ ↦ hloc z⟩, ?_⟩,
    fun x ↦ rfl⟩
  intro Z hZ
  obtain ⟨j, hj⟩ := exists_ne_zero_of_finsum_ne_zero' hZ
  exact principalDivisorPushforward_mem_cyclesOfDimension C p k (W j) (hW j) (hDim j) (g j) Z hj

end Stacks.Chow

end
