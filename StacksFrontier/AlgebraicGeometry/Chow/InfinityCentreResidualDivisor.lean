* [Stacks Project, Tag 0809](https://stacks.math.columbia.edu/tag/0809)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

/-- An ideal sheaf is the unit ideal on any open disjoint from its support. -/
theorem comap_ι_eq_top_of_le_support_compl {X : Scheme.{u}} (I : X.IdealSheafData) {U : X.Opens}
    (hU : U ≤ I.support.compl) : I.comap U.ι = ⊤ := by
  rw [← support_eq_bot_iff]
  apply SetLike.coe_injective
  rw [support_comap, TopologicalSpace.Closeds.coe_preimage]
  exact Set.eq_empty_iff_forall_notMem.2 fun x hx => hU x.2 hx

end AlgebraicGeometry.Scheme.IdealSheafData

namespace Stacks.Chow

variable {X : Scheme.{u}}

section Residual

variable {ℐY ℐZ : X.IdealSheafData} (h : ℐY ≤ ℐZ)

include h in
/-- `ℐ_Y · 𝒪_{W_Z} ⊆ ℐ_{E_Z}`: the ideal `ℐ_Y · 𝒪_{𝐏¹_X} ⊆ ℐ_Z · 𝒪_{𝐏¹_X}` is contained in the
ideal of the centre `∞(Z)`. -/
theorem comap_blowupAtInfinityToBase_le_exceptionalIdealAtInfinity :
    ℐY.comap (blowupAtInfinityToBase ℐZ) ≤ exceptionalIdealAtInfinity ℐZ := by
  rw [blowupAtInfinityToBase, Scheme.IdealSheafData.comap_comp]
  refine Scheme.IdealSheafData.comap_mono (blowupAtInfinityToLine ℐZ) ?_
  rw [infinityCentreIdeal_eq_sup]
  exact (Scheme.IdealSheafData.comap_mono _ h).trans le_sup_left

/-- **The residual ideal `𝒟_Z = (ℐ_Y · 𝒪_{W_Z} : ℐ_{E_Z})`** on the blowup at infinity `W_Z`
in the centre `∞(Z)`. For `ℐ_Y ≤ ℐ_Z` it is the ideal sheaf with
`ℐ_Y · 𝒪_{W_Z} = ℐ_{E_Z} · 𝒟_Z`
(`Stacks.Chow.comap_blowupAtInfinityToBase_eq_mul_residualIdealAtInfinity`), and on the chart
`Spec A[s][I/s]` over an affine open `Spec A ⊆ X` it is generated by `ℐ_Y(Spec A)/s`. -/
def residualIdealAtInfinity (ℐY ℐZ : X.IdealSheafData) : (blowupAtInfinity ℐZ).IdealSheafData :=
  (ℐY.comap (blowupAtInfinityToBase ℐZ)).colon (exceptionalIdealAtInfinity ℐZ)
    (fg_ideal_of_isEffectiveCartierDivisor _
      (isEffectiveCartierDivisor_exceptionalIdealAtInfinity ℐZ))

include h in
/-- **`ℐ_Y · 𝒪_{W_Z} = ℐ_{E_Z} · 𝒟_Z`**: the inverse image of `ℐ_Y` on the blowup at infinity is
the exceptional divisor plus the residual ideal. -/
theorem comap_blowupAtInfinityToBase_eq_mul_residualIdealAtInfinity :
    ℐY.comap (blowupAtInfinityToBase ℐZ) =
      exceptionalIdealAtInfinity ℐZ * residualIdealAtInfinity ℐY ℐZ :=
  (mul_colon_eq_of_isEffectiveCartierDivisor _ _
    (isEffectiveCartierDivisor_exceptionalIdealAtInfinity ℐZ)
    (comap_blowupAtInfinityToBase_le_exceptionalIdealAtInfinity h)).symm

include h in
/-- **Uniqueness of the residual ideal.** Any ideal sheaf `𝒟` with `ℐ_Y · 𝒪_{W_Z} = ℐ_{E_Z} · 𝒟`
is the residual ideal, since the effective Cartier divisor `E_Z` can be cancelled. -/
theorem eq_residualIdealAtInfinity_of_mul_eq {𝒟 : (blowupAtInfinity ℐZ).IdealSheafData}
    (h𝒟 : ℐY.comap (blowupAtInfinityToBase ℐZ) = exceptionalIdealAtInfinity ℐZ * 𝒟) :
    𝒟 = residualIdealAtInfinity ℐY ℐZ :=
  Stacks.Divisors.eq_of_mul_eq_mul_of_isEffectiveCartierDivisor
    (isEffectiveCartierDivisor_exceptionalIdealAtInfinity ℐZ)
    (h𝒟.symm.trans (comap_blowupAtInfinityToBase_eq_mul_residualIdealAtInfinity h))

include h in
/-- `ℐ_Y · 𝒪_{W_Z} ⊆ 𝒟_Z`: the closed subscheme `V(𝒟_Z)` lies over `Y`. -/
theorem comap_blowupAtInfinityToBase_le_residualIdealAtInfinity :
    ℐY.comap (blowupAtInfinityToBase ℐZ) ≤ residualIdealAtInfinity ℐY ℐZ := by
  rw [comap_blowupAtInfinityToBase_eq_mul_residualIdealAtInfinity h]
  exact fun U => (Ideal.mul_le_left : (residualIdealAtInfinity ℐY ℐZ).ideal U *
    (exceptionalIdealAtInfinity ℐZ).ideal U ≤ _).trans_eq' (mul_comm _ _)

/-- **`ℐ_Y · 𝒪_{W_Z}` is an effective Cartier divisor when `ℐ_Y` is one**, for any `ℐ_Z`: it is
the pullback of `ℐ_Y` along the flat morphism `𝐏¹_X ⟶ X` followed by the blowup `W_Z ⟶ 𝐏¹_X`,
and an effective Cartier divisor pulls back to one along a blowup (Stacks 0809). -/
theorem isEffectiveCartierDivisor_comap_blowupAtInfinityToBase (ℐZ : X.IdealSheafData)
    (hY : Stacks.Divisors.IsEffectiveCartierDivisor ℐY) :
    Stacks.Divisors.IsEffectiveCartierDivisor (ℐY.comap (blowupAtInfinityToBase ℐZ)) := by
  rw [blowupAtInfinityToBase, Scheme.IdealSheafData.comap_comp]
  exact AlgebraicGeometry.isPullbackDefined_blowUpToBase (infinityCentreIdeal ℐZ) _
    (Stacks.Divisors.isPullbackDefined_of_flat _ _ hY)

include h in
/-- **The residual ideal is an effective Cartier divisor when `ℐ_Y` is one**: it is the
difference of the effective Cartier divisors `ℐ_Y · 𝒪_{W_Z} ⊆ E_Z` (Stacks 02ON). -/
theorem isEffectiveCartierDivisor_residualIdealAtInfinity
    (hY : Stacks.Divisors.IsEffectiveCartierDivisor ℐY) :
    Stacks.Divisors.IsEffectiveCartierDivisor (residualIdealAtInfinity ℐY ℐZ) := by
  obtain ⟨𝒟, h𝒟, heq⟩ := exists_isEffectiveCartierDivisor_mul_eq_of_le
    (exceptionalIdealAtInfinity ℐZ) (ℐY.comap (blowupAtInfinityToBase ℐZ))
    (isEffectiveCartierDivisor_exceptionalIdealAtInfinity ℐZ)
    (isEffectiveCartierDivisor_comap_blowupAtInfinityToBase ℐZ hY)
    (comap_blowupAtInfinityToBase_le_exceptionalIdealAtInfinity h)
  rwa [← eq_residualIdealAtInfinity_of_mul_eq h heq]

end Residual

/-! ### The zero section of the normal cone -/

section NormalCone

variable {Y : Scheme.{u}} (iY : Y ⟶ X) [IsClosedImmersion iY]

/-- **The ideal of the zero section of the normal cone `C_YX`**: the residual ideal
`𝒟_Y = (ℐ_Y · 𝒪_{W_Y} : ℐ_{E_Y})` of the blowup at infinity in the centre `∞(Y)`, restricted to
the normal cone along the open immersion `C_YX ⟶ E_Y ⟶ W_Y` of Stacks 0FBH. It cuts out the
zero section (the vertex) of the cone: on the chart over an affine open `Spec A ⊆ X`, with
`I = ℐ_Y(Spec A)`, it is the ideal of `Gr_I(A)` generated by the elements of positive degree. -/
def normalConeZeroSectionIdeal :
    (Stacks.Conormal.normalCone iY).IdealSheafData :=
  (residualIdealAtInfinity iY.ker iY.ker).comap
    (normalConeToExceptionalDivisor iY ≫ (exceptionalIdealAtInfinity iY.ker).subschemeι)

/-- The ideal of the zero section of `C_YX` is the residual ideal restricted along
`j : C_YX ⟶ W_{Y,∞}` followed by the inclusion of the fibre at infinity, for any `X ⟶ S`. -/
theorem comap_residualIdealAtInfinity_normalConeToFibreAtInfinity {S : Scheme.{u}}
    (sX : X ⟶ S) :
    (residualIdealAtInfinity iY.ker iY.ker).comap
        (normalConeToFibreAtInfinity iY sX ≫
          modificationInclusionAtInfinity sX (blowupAtInfinityToProjectiveLineProduct iY.ker sX)) =
      normalConeZeroSectionIdeal iY := by
  rw [normalConeToFibreAtInfinity_inclusion]
  rfl

/-- The ideal of the zero section of `C_YX` is the residual ideal restricted to `W_Y ∖ X'_Y` and
then along the closed immersion `C_YX ⟶ W_Y ∖ X'_Y`. -/
theorem comap_residualIdealAtInfinity_normalConeToStrictTransformComplAtInfinity :
    ((residualIdealAtInfinity iY.ker iY.ker).comap
        (strictTransformComplAtInfinity iY.ker).ι).comap
        (normalConeToStrictTransformComplAtInfinity iY) =
      normalConeZeroSectionIdeal iY := by
  rw [← Scheme.IdealSheafData.comap_comp, normalConeToStrictTransformComplAtInfinity_ι]
  rfl

end NormalCone

/-! ### Compatibility with the change of centre -/

section ChangeOfCentre

variable {ℐY ℐZ : X.IdealSheafData} (h : ℐY ≤ ℐZ)

include h in
/-- **The residual ideals are compatible with the change of centre `ρ : W_Z ∖ X'_Z ⟶ W_Y`**: the
residual ideal `𝒟_Y` of `ℐ_Y · 𝒪_{W_Y}` pulls back along `ρ` to the residual ideal `𝒟_Z` of
`ℐ_Y · 𝒪_{W_Z}` restricted to `W_Z ∖ X'_Z`. Both, multiplied by the effective Cartier divisor
`W_{Z,∞} ∩ (W_Z ∖ X'_Z)`, give `ℐ_Y · 𝒪_{W_Z ∖ X'_Z}`, and that divisor can be cancelled. -/
theorem comap_residualIdealAtInfinity_changeOfCentre :
    (residualIdealAtInfinity ℐY ℐY).comap (blowupAtInfinityChangeOfCentre h) =
      (residualIdealAtInfinity ℐY ℐZ).comap (strictTransformComplAtInfinity ℐZ).ι := by
  refine Stacks.Divisors.eq_of_mul_eq_mul_of_isEffectiveCartierDivisor
    (Stacks.Blowup.isEffectiveCartierDivisor_comap_of_isOpenImmersion _
      (isEffectiveCartierDivisor_fibreIdealAtInfinity ℐZ) (strictTransformComplAtInfinity ℐZ).ι)
    ?_
  calc (fibreIdealAtInfinity ℐZ).comap (strictTransformComplAtInfinity ℐZ).ι *
        (residualIdealAtInfinity ℐY ℐY).comap (blowupAtInfinityChangeOfCentre h)
      = (exceptionalIdealAtInfinity ℐY * residualIdealAtInfinity ℐY ℐY).comap
          (blowupAtInfinityChangeOfCentre h) := by
        rw [Stacks.IdealSheaf.comap_mul, comap_exceptionalIdealAtInfinity_changeOfCentre h]
    _ = ℐY.comap ((strictTransformComplAtInfinity ℐZ).ι ≫ blowupAtInfinityToBase ℐZ) := by
        rw [← comap_blowupAtInfinityToBase_eq_mul_residualIdealAtInfinity le_rfl,
          ← Scheme.IdealSheafData.comap_comp, blowupAtInfinityChangeOfCentre_toBase]
    _ = (exceptionalIdealAtInfinity ℐZ * residualIdealAtInfinity ℐY ℐZ).comap
          (strictTransformComplAtInfinity ℐZ).ι := by
        rw [Scheme.IdealSheafData.comap_comp,
          comap_blowupAtInfinityToBase_eq_mul_residualIdealAtInfinity h]
    _ = (fibreIdealAtInfinity ℐZ).comap (strictTransformComplAtInfinity ℐZ).ι *
          (residualIdealAtInfinity ℐY ℐZ).comap (strictTransformComplAtInfinity ℐZ).ι := by
        rw [Stacks.IdealSheaf.comap_mul, comap_fibreIdealAtInfinity_ι_compl]

end ChangeOfCentre

/-! ### The strict transform -/

section StrictTransform

variable {ℐY ℐZ : X.IdealSheafData} (h : ℐY ≤ ℐZ) {X' : Scheme.{u}} (f : X' ⟶ X)
  (ℐ' : X'.IdealSheafData) (hℐ' : ℐ' = ℐZ.comap f)

include h in
/-- **The residual ideal pulls back to zero along `W'_{Z'} ⟶ W_Z`** when `X' ⟶ X` factors
through `Y`, i.e. `ℐ_Y · 𝒪_{X'} = 0`: pulling back `ℐ_Y · 𝒪_{W_Z} = ℐ_{E_Z} · 𝒟_Z` gives
`0 = ℐ_{E'} · (𝒟_Z · 𝒪_{W'})`, and the exceptional divisor `E'` of `W'` can be cancelled. For the
closed immersion `Y ⟶ X` this says that the strict transform `W_{Z ∩ Y}` of `𝐏¹_Y` lies in
`V(𝒟_Z)`. -/
theorem comap_residualIdealAtInfinity_blowupAtInfinityComap (hf : ℐY.comap f = ⊥) :
    (residualIdealAtInfinity ℐY ℐZ).comap (blowupAtInfinityComap f ℐZ ℐ' hℐ') = ⊥ := by
  refine Stacks.Divisors.eq_of_mul_eq_mul_of_isEffectiveCartierDivisor
    (isEffectiveCartierDivisor_exceptionalIdealAtInfinity ℐ') ?_
  rw [Scheme.IdealSheafData.mul_bot,
    ← comap_exceptionalIdealAtInfinity_blowupAtInfinityComap f ℐZ ℐ' hℐ',
    ← Stacks.IdealSheaf.comap_mul, ← comap_blowupAtInfinityToBase_eq_mul_residualIdealAtInfinity h,
    ← Scheme.IdealSheafData.comap_comp, blowupAtInfinityComap_toBase,
    Scheme.IdealSheafData.comap_comp, hf, Scheme.IdealSheafData.comap_bot]

/-- **The comparison `W'_{Z'} ⟶ W_Z` factors through `V(𝒟_Z)`** when `X' ⟶ X` factors through
`Y`. -/
def blowupAtInfinityComapToResidual (hf : ℐY.comap f = ⊥) :
    blowupAtInfinity ℐ' ⟶ (residualIdealAtInfinity ℐY ℐZ).subscheme :=
  IsClosedImmersion.lift (residualIdealAtInfinity ℐY ℐZ).subschemeι
    (blowupAtInfinityComap f ℐZ ℐ' hℐ') (by
      rw [Scheme.IdealSheafData.ker_subschemeι, le_ker_iff_comap_eq_bot]
      exact comap_residualIdealAtInfinity_blowupAtInfinityComap h f ℐ' hℐ' hf)

/-- The factorisation `W'_{Z'} ⟶ V(𝒟_Z)` composed with the inclusion `V(𝒟_Z) ⟶ W_Z` is the
comparison `W'_{Z'} ⟶ W_Z`. -/
@[reassoc (attr := simp)]
theorem blowupAtInfinityComapToResidual_subschemeι (hf : ℐY.comap f = ⊥) :
    blowupAtInfinityComapToResidual h f ℐ' hℐ' hf ≫ (residualIdealAtInfinity ℐY ℐZ).subschemeι =
      blowupAtInfinityComap f ℐZ ℐ' hℐ' :=
  IsClosedImmersion.lift_fac _ _ _

include h in
/-- `𝒟_Z` is contained in the ideal of `W'_{Z'} ⟶ W_Z` when `X' ⟶ X` factors through `Y`. -/
theorem residualIdealAtInfinity_le_ker_blowupAtInfinityComap (hf : ℐY.comap f = ⊥) :
    residualIdealAtInfinity ℐY ℐZ ≤ (blowupAtInfinityComap f ℐZ ℐ' hℐ').ker :=
  (le_ker_iff_comap_eq_bot _ _).2
    (comap_residualIdealAtInfinity_blowupAtInfinityComap h f ℐ' hℐ' hf)

/-- **The comparison `W'_{Z'} ⟶ W_Z` is a closed immersion along a closed immersion `X' ⟶ X`**
(Stacks 080E): it is the strict transform of the closed immersion `𝐏¹_{X'} ⟶ 𝐏¹_X`. -/
theorem isClosedImmersion_blowupAtInfinityComap [IsClosedImmersion f] :
    IsClosedImmersion (blowupAtInfinityComap f ℐZ ℐ' hℐ') :=
  isClosedImmersion_blowUpLift_comp (projectiveLineBaseChange f) (infinityCentreIdeal ℐZ)
    (infinityCentreIdeal ℐ')
    (by rw [comap_infinityCentreIdeal_projectiveLineBaseChange_eq, hℐ'])
    (isCartierOver_infinityCentreIdeal_blowupAtInfinityComap f ℐZ ℐ' hℐ')

/-- The comparison `W'_{Z'} ⟶ W_Z` is a closed immersion when `X' ⟶ X` is. -/
instance [IsClosedImmersion f] : IsClosedImmersion (blowupAtInfinityComap f ℐZ ℐ' hℐ') :=
  isClosedImmersion_blowupAtInfinityComap f ℐ' hℐ'

/-- The factorisation `W'_{Z'} ⟶ V(𝒟_Z)` is a closed immersion when `X' ⟶ X` is a closed
immersion factoring through `Y`. -/
instance [IsClosedImmersion f] (hf : ℐY.comap f = ⊥) :
    IsClosedImmersion (blowupAtInfinityComapToResidual h f ℐ' hℐ' hf) := by
  have : IsClosedImmersion (blowupAtInfinityComapToResidual h f ℐ' hℐ' hf ≫
      (residualIdealAtInfinity ℐY ℐZ).subschemeι) := by
    rw [blowupAtInfinityComapToResidual_subschemeι]
    infer_instance
  exact IsClosedImmersion.of_comp_isClosedImmersion _ (residualIdealAtInfinity ℐY ℐZ).subschemeι

end StrictTransform

/-! ### Off the fibre at infinity -/

section ComplFibre

/-- The open complement `W ∖ W_∞` of the fibre at infinity in the blowup at infinity. -/
abbrev fibreComplAtInfinity (ℐ : X.IdealSheafData) : (blowupAtInfinity ℐ).Opens :=
  (fibreIdealAtInfinity ℐ).support.compl

/-- `W ∖ W_∞` is the inverse image of `𝐏¹_X ∖ (𝐏¹_X)_∞`. -/
theorem fibreComplAtInfinity_eq_preimage (ℐ : X.IdealSheafData) :
    fibreComplAtInfinity ℐ =
      blowupAtInfinityToLine ℐ ⁻¹ᵁ (lineInfinityDivisor X).support.compl := by
  refine TopologicalSpace.Opens.ext ?_
  change ((fibreIdealAtInfinity ℐ).support : Set (blowupAtInfinity ℐ))ᶜ =
    (blowupAtInfinityToLine ℐ).base ⁻¹' ((lineInfinityDivisor X).support : Set _)ᶜ
  rw [fibreIdealAtInfinity, Scheme.IdealSheafData.support_comap]
  rfl

variable {ℐY ℐZ : X.IdealSheafData} (h : ℐY ≤ ℐZ)

include h in
/-- **Off the fibre at infinity the residual ideal is `ℐ_Y · 𝒪`**: on `W_Z ∖ W_{Z,∞}` the
exceptional divisor is the unit ideal, as `E_Z ⊆ W_{Z,∞}`. -/
theorem comap_residualIdealAtInfinity_compl_fibre :
    (residualIdealAtInfinity ℐY ℐZ).comap (fibreComplAtInfinity ℐZ).ι =
      ℐY.comap ((fibreComplAtInfinity ℐZ).ι ≫ blowupAtInfinityToBase ℐZ) := by
  have hE : (exceptionalIdealAtInfinity ℐZ).comap (fibreComplAtInfinity ℐZ).ι = ⊤ :=
    top_le_iff.1 ((Scheme.IdealSheafData.comap_ι_eq_top_of_le_support_compl _ le_rfl).ge.trans
      (Scheme.IdealSheafData.comap_mono _ (fibreIdealAtInfinity_le_exceptionalIdealAtInfinity ℐZ)))
  rw [Scheme.IdealSheafData.comap_comp,
    comap_blowupAtInfinityToBase_eq_mul_residualIdealAtInfinity h, Stacks.IdealSheaf.comap_mul,
    hE, Scheme.IdealSheafData.top_mul]

/-- The blowup at infinity is an isomorphism over any open disjoint from the line at infinity. -/
private theorem isIso_blowupAtInfinityToLine_restrict_of_le (ℐ : X.IdealSheafData)
    {V : (relativeProjectiveLine X).Opens} (hV : V ≤ (lineInfinityDivisor X).support.compl) :
    IsIso (blowupAtInfinityToLine ℐ ∣_ V) :=
  AlgebraicGeometry.isIso_blowUpToBase_restrict_of_subset_compl_support _ _
    fun _ hx hx' => hV hx (Scheme.IdealSheafData.support_antitone
      (lineInfinityDivisor_le_infinityCentreIdeal ℐ) hx')

/-- **Off the fibre at infinity the strict transform `W_{Z ∩ Y} ⟶ W_Z` is cut out by
`ℐ_Y · 𝒪`**, for a closed immersion `Y ⟶ X` and any `ℐ_Z`. Over `𝐏¹_X ∖ (𝐏¹_X)_∞` both blowups
are isomorphisms, so there `W_{Z ∩ Y} ⟶ W_Z` is the closed immersion `𝐏¹_Y ⟶ 𝐏¹_X`, the base
change of `Y ⟶ X`, whose ideal is `ℐ_Y · 𝒪_{𝐏¹_X}`. -/
theorem comap_ker_blowupAtInfinityComap_compl_fibre {Y : Scheme.{u}} (iY : Y ⟶ X)
    [IsClosedImmersion iY] (ℐZ : X.IdealSheafData) (ℐ' : Y.IdealSheafData)
    (hℐ' : ℐ' = ℐZ.comap iY) :
    (blowupAtInfinityComap iY ℐZ ℐ' hℐ').ker.comap (fibreComplAtInfinity ℐZ).ι =
      iY.ker.comap ((fibreComplAtInfinity ℐZ).ι ≫ blowupAtInfinityToBase ℐZ) := by
  have hV'le : projectiveLineBaseChange iY ⁻¹ᵁ (lineInfinityDivisor X).support.compl ≤
      (lineInfinityDivisor Y).support.compl := by
    intro _ hx hx'
    rw [← comap_lineInfinityDivisor_projectiveLineBaseChange iY,
      Scheme.IdealSheafData.support_comap] at hx'
    exact hx hx'
  have : IsIso (blowupAtInfinityToLine ℐZ ∣_ (lineInfinityDivisor X).support.compl) :=
    isIso_blowupAtInfinityToLine_restrict_of_le ℐZ le_rfl
  have : IsIso (blowupAtInfinityToLine ℐ' ∣_
      (projectiveLineBaseChange iY ⁻¹ᵁ (lineInfinityDivisor X).support.compl)) :=
    isIso_blowupAtInfinityToLine_restrict_of_le ℐ' hV'le
  have hker : (projectiveLineBaseChange iY).ker = iY.ker.comap (relativeProjectiveLine X ↘ X) :=
    AlgebraicGeometry.ker_eq_comap_ker_of_isPullback (isPullback_projectiveLineBaseChange iY).flip
  rw [fibreComplAtInfinity_eq_preimage, ← ker_morphismRestrict_eq_comap]
  set V := (lineInfinityDivisor X).support.compl
  set β := blowupAtInfinityComap iY ℐZ ℐ' hℐ'
  set e := blowupAtInfinityToLine ℐZ ∣_ V
  calc (β ∣_ blowupAtInfinityToLine ℐZ ⁻¹ᵁ V).ker
      = ((β ∣_ blowupAtInfinityToLine ℐZ ⁻¹ᵁ V).ker.map e).comap e :=
        (Scheme.IdealSheafData.comap_map_of_isClosedImmersion _ e).symm
    _ = ((β ∣_ blowupAtInfinityToLine ℐZ ⁻¹ᵁ V ≫ e).ker).comap e := by
        rw [Scheme.IdealSheafData.map_ker]
    _ = (((β ≫ blowupAtInfinityToLine ℐZ) ∣_ V).ker).comap e := by
        rw [morphismRestrict_comp]
        rfl
    _ = (((blowupAtInfinityToLine ℐ' ≫ projectiveLineBaseChange iY) ∣_ V).ker).comap e :=
        congrArg (fun φ => ((φ ∣_ V).ker).comap e) (blowupAtInfinityComap_comp iY ℐZ ℐ' hℐ')
    _ = ((blowupAtInfinityToLine ℐ' ∣_ projectiveLineBaseChange iY ⁻¹ᵁ V ≫
          projectiveLineBaseChange iY ∣_ V).ker).comap e := by
        rw [morphismRestrict_comp]
        rfl
    _ = iY.ker.comap ((blowupAtInfinityToLine ℐZ ⁻¹ᵁ V).ι ≫ blowupAtInfinityToBase ℐZ) := by
        rw [Scheme.Hom.ker_comp_of_isIso, ker_morphismRestrict_eq_comap, hker,
          ← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp,
          show e ≫ Scheme.Opens.ι V = _ from morphismRestrict_ι _ _, Category.assoc,
          blowupAtInfinityToBase]

/-- **Off the fibre at infinity `V(𝒟_Z)` is the strict transform of `𝐏¹_Y`**: for a closed
immersion `Y ⟶ X` with ideal `ℐ_Y ⊆ ℐ_Z`, the residual ideal and the ideal of
`W_{Z ∩ Y} ⟶ W_Z` agree on `W_Z ∖ W_{Z,∞}`, both being `ℐ_Y · 𝒪` there. -/
theorem comap_residualIdealAtInfinity_compl_fibre_eq_ker {Y : Scheme.{u}} (iY : Y ⟶ X)
    [IsClosedImmersion iY] {ℐZ : X.IdealSheafData} (h : iY.ker ≤ ℐZ) (ℐ' : Y.IdealSheafData)
    (hℐ' : ℐ' = ℐZ.comap iY) :
    (residualIdealAtInfinity iY.ker ℐZ).comap (fibreComplAtInfinity ℐZ).ι =
      (blowupAtInfinityComap iY ℐZ ℐ' hℐ').ker.comap (fibreComplAtInfinity ℐZ).ι := by
  rw [comap_residualIdealAtInfinity_compl_fibre h, comap_ker_blowupAtInfinityComap_compl_fibre]

end ComplFibre

end Stacks.Chow

end
