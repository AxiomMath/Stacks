module

public import StacksFrontier.AlgebraicGeometry.Chow.ProperPushforwardPrincipal.OrdPreimmersion
public import StacksFrontier.AlgebraicGeometry.Etale.StalkOrderOfVanishing

/-!
# The order of vanishing is unchanged along an étale morphism

Let `i : Z ⟶ X` be a dominant étale morphism of locally Noetherian integral schemes. Restricting
a rational function on `X` along `i` changes neither the codimension of a point nor the order of
vanishing there: the stalk map at a point is a flat local homomorphism whose target's maximal
ideal is generated by the image of the source's, by Stacks 00UW, and
`Stacks.Etale.ord_stalkMap` and `Stacks.Etale.coheight_eq` are exactly those two invariances for
the local ring.

This is `Stacks.Chow.ord_functionFieldEquiv_openImmersion` with the open immersion replaced by an
étale morphism, and the point of having it is that an étale morphism is a general morphism of the
small étale site: the order of vanishing is an étale-local notion, which is what makes the second
map of the fundamental exact sequence of Stacks 03RI — the order of vanishing at the closed
points — a morphism of étale sheaves rather than merely a family of maps on sections.

The passage from `Ring.ord` on the local ring to `AlgebraicGeometry.Scheme.ord` on the function
field is the extension of the order of vanishing from a Noetherian one-dimensional domain to its
fraction field, `Ring.ordFrac`, and the lemma that carries the invariance across it is
`Stacks.Chow.ordFrac_algebraMap_of_ord_eq`, the analogue of `Stacks.Chow.ordFrac_congr` for a ring
homomorphism which is not an isomorphism.

## Main results

* `Stacks.Chow.ordFrac_algebraMap_of_ord_eq`: `Ring.ordFrac` is unchanged along a ring
  homomorphism of one-dimensional Noetherian domains which preserves `Ring.ord` and is compatible
  with a map of fraction fields.
* `Stacks.Chow.ord_dominantFunctionFieldMap_eq_ord_base_of_etale`: **the order of vanishing of a
  rational function at a point of an étale `X`-scheme is its order of vanishing at the image
  point.**

## Implementation notes

Injectivity of the ring homomorphism is not assumed: it follows from compatibility with the map
of fraction fields, since a homomorphism out of a field is injective and a Noetherian domain
injects into its fraction field.

Dominance of `i` is carried as an instance because `AlgebraicGeometry.dominantFunctionFieldMap`,
whose invariance is the statement, is only defined for a dominant morphism; for an étale morphism
of integral schemes it holds automatically, the generic point of the source lying over the
generic point of the target by flatness.

## References

* [Stacks Project, Tag 02MD](https://stacks.math.columbia.edu/tag/02MD): the order of vanishing
  on the fraction field.
* [Stacks Project, Tag 03RI](https://stacks.math.columbia.edu/tag/03RI): the fundamental exact
  sequence, whose second map is the order of vanishing.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Order TopologicalSpace
open scoped nonZeroDivisors

universe u

namespace Stacks.Chow

/-- **`Ring.ordFrac` is unchanged along a ring homomorphism preserving `Ring.ord`.** For
`e : R → S` a homomorphism of one-dimensional Noetherian domains which preserves the order of
vanishing, and `E : K → L` a homomorphism of their fraction fields compatible with it, the order of
vanishing of a fraction is unchanged.

This is `Stacks.Chow.ordFrac_congr` with the pair of isomorphisms replaced by a pair of
homomorphisms and the invariance of `Ring.ord` carried as a hypothesis rather than deduced from an
isomorphism. -/
theorem ordFrac_algebraMap_of_ord_eq {R S K L : Type u} [CommRing R] [IsDomain R]
    [IsNoetherianRing R] [Ring.KrullDimLE 1 R] [CommRing S] [IsDomain S] [IsNoetherianRing S]
    [Ring.KrullDimLE 1 S] [Field K] [Algebra R K] [IsFractionRing R K] [Field L] [Algebra S L]
    [IsFractionRing S L] (e : R →+* S) (E : K →+* L)
    (h : ∀ r : R, E (algebraMap R K r) = algebraMap S L (e r))
    (hord : ∀ r : R, Ring.ord S (e r) = Ring.ord R r) (f : K) :
    Ring.ordFrac S (E f) = Ring.ordFrac R f := by
  have he : Function.Injective e := by
    intro x y hxy
    refine FaithfulSMul.algebraMap_injective R K (E.injective ?_)
    rw [h x, h y, hxy]
  obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective R f
  rw [map_div₀]
  simp only [h]
  have hne : ∀ x : R, x ≠ 0 → e x ∈ nonZeroDivisors S := fun x hx ↦
    mem_nonZeroDivisors_iff_ne_zero.mpr fun hzero ↦ hx (he (by simpa using hzero))
  have hb' := hne b (mem_nonZeroDivisors_iff_ne_zero.mp hb)
  by_cases ha : a = 0
  · simp [ha]
  have ha' := hne a ha
  rw [← IsFractionRing.mk'_mk_eq_div hb, ← IsFractionRing.mk'_mk_eq_div hb',
    Ring.ordFrac_eq_div S ⟨e a, ha'⟩ ⟨e b, hb'⟩,
    Ring.ordFrac_eq_div R ⟨a, mem_nonZeroDivisors_iff_ne_zero.mpr ha⟩ ⟨b, hb⟩,
    Ring.ordMonoidWithZeroHom_eq_ord ha',
    Ring.ordMonoidWithZeroHom_eq_ord (mem_nonZeroDivisors_iff_ne_zero.mpr ha),
    Ring.ordMonoidWithZeroHom_eq_ord hb', Ring.ordMonoidWithZeroHom_eq_ord hb, hord a, hord b]

/-- **The order of vanishing of a rational function is unchanged along a dominant étale morphism of
locally Noetherian integral schemes.** The order of vanishing at `z ∈ Z` of the restriction of a
rational function on `X` is its order of vanishing at `i z`: the stalk map at `z` preserves both
the codimension of the point and the order of vanishing of a germ, by `Stacks.Etale.coheight_eq`
and `Stacks.Etale.ord_stalkMap`, and `AlgebraicGeometry.Scheme.ord` depends on nothing else.

This is the compatibility that makes the second map of the fundamental exact sequence of
Stacks 03RI natural in the étale `X`-scheme. -/
theorem ord_dominantFunctionFieldMap_eq_ord_base_of_etale {X Z : Scheme.{u}} (i : Z ⟶ X)
    [AlgebraicGeometry.Etale i] [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral Z]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Z] [IsDominant i]
    (f : X.functionField) (z : Z) :
    Z.ord (dominantFunctionFieldMap i f) z = X.ord f (i.base z) := by
  have hcoh : coheight (i.base z) = coheight z := Stacks.Etale.coheight_eq i z
  by_cases hz : coheight z = 1
  · have hiz : coheight (i.base z) = 1 := hcoh.trans hz
    have : Ring.KrullDimLE 1 (X.presheaf.stalk (i.base z)) := krullDimLE_of_coheight_le hiz.le
    have : Ring.KrullDimLE 1 (Z.presheaf.stalk z) := krullDimLE_of_coheight_le hz.le
    rw [Scheme.ord_eq_ordHom_of_coheight_eq_one hz, Scheme.ord_eq_ordHom_of_coheight_eq_one hiz]
    exact congrArg (fun v ↦ Multiplicative.toAdd (WithZero.unzeroD 1 v))
      (ordFrac_algebraMap_of_ord_eq (i.stalkMap z).hom (dominantFunctionFieldMap i)
        (dominantFunctionFieldMap_algebraMap i z) (Stacks.Etale.ord_stalkMap i z) f)
  · have hiz : coheight (i.base z) ≠ 1 := fun h ↦ hz (hcoh.symm.trans h)
    simp [hz, hiz]

end Stacks.Chow

end
