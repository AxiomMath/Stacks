* [Stacks Project, Tag 00ES](https://stacks.math.columbia.edu/tag/00ES)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.Chow

variable {X : Scheme.{u}}

/-! ### The support of an ideal sheaf, pulled back to the spectrum of a local ring -/

/-- On an affine open `U` containing `ξ`, `X.fromSpecStalk ξ` factors through `U.fromSpec`. -/
private theorem fromSpecStalk_eq_fromSpec_comap_germ {U : X.affineOpens} {ξ : X}
    (hξU : ξ ∈ (U : X.Opens)) (r : PrimeSpectrum (X.presheaf.stalk ξ)) :
    X.fromSpecStalk ξ r =
      U.2.fromSpec (PrimeSpectrum.comap (X.presheaf.germ (U : X.Opens) ξ hξU).hom r) := by
  conv_lhs => rw [← U.2.fromSpecStalk_eq_fromSpecStalk hξU]
  rfl

/-- The preimage of the support of an ideal sheaf `Z` under the canonical morphism from the
spectrum of the local ring at `ξ` is the zero locus of the stalk of `Z` at `ξ`.

Both sides are computed on an affine open `U` containing `ξ`, through the factorization of
`X.fromSpecStalk ξ` as `Spec.map (germ) ≫ hU.fromSpec`. -/
@[ega "IV 5.1.12" "S ∩ Spec(O_{X"]
theorem preimage_fromSpecStalk_support_eq_zeroLocus (Z : X.IdealSheafData) (ξ : X) :
    X.fromSpecStalk ξ ⁻¹' (Z.support : Set X) =
      PrimeSpectrum.zeroLocus (IdealSheafData.stalk Z ξ : Set (X.presheaf.stalk ξ)) := by
  obtain ⟨U, hξU⟩ := Stacks.Divisors.exists_affineOpens_mem ξ
  set g := (X.presheaf.germ (U : X.Opens) ξ hξU).hom with hg
  have haff : ⇑U.2.fromSpec ⁻¹' (Z.support : Set X) =
      PrimeSpectrum.zeroLocus (Z.ideal U : Set Γ(X, (U : X.Opens))) := by
    rw [← Set.preimage_inter_range (f := ⇑U.2.fromSpec) (s := (Z.support : Set X)),
      U.2.range_fromSpec, Z.coe_support_inter U, ← U.2.range_fromSpec,
      Set.preimage_inter_range, U.2.fromSpec_preimage_zeroLocus]
  have hstalk : PrimeSpectrum.comap g ⁻¹'
        PrimeSpectrum.zeroLocus (Z.ideal U : Set Γ(X, (U : X.Opens))) =
      PrimeSpectrum.zeroLocus (IdealSheafData.stalk Z ξ : Set (X.presheaf.stalk ξ)) := by
    rw [PrimeSpectrum.preimage_comap_zeroLocus,
      IdealSheafData.stalk_eq_map_germ Z ξ U hξU, hg, Ideal.map,
      PrimeSpectrum.zeroLocus_span]
  ext q
  rw [Set.mem_preimage, fromSpecStalk_eq_fromSpec_comap_germ hξU q, ← hstalk]
  exact Set.ext_iff.mp haff (PrimeSpectrum.comap g q)

/-- Specialization between points of `Spec 𝒪_{X, ξ}` is the order on primes, as seen in `X`. -/
private theorem fromSpecStalk_specializes_iff {ξ : X}
    (q₁ q₂ : PrimeSpectrum (X.presheaf.stalk ξ)) :
    X.fromSpecStalk ξ q₁ ⤳ X.fromSpecStalk ξ q₂ ↔ q₁.asIdeal ≤ q₂.asIdeal :=
  (X.fromSpecStalk ξ).isEmbedding.isInducing.specializes_iff.trans
    (PrimeSpectrum.le_iff_specializes q₁ q₂).symm

/-- A prime of the local ring at `ξ` contains the stalk of `Z` at `ξ` exactly when the
corresponding point of `X` lies in the support of `Z`. -/
theorem le_iff_fromSpecStalk_mem_support (Z : X.IdealSheafData) (ξ : X)
    (q : PrimeSpectrum (X.presheaf.stalk ξ)) :
    IdealSheafData.stalk Z ξ ≤ q.asIdeal ↔ X.fromSpecStalk ξ q ∈ (Z.support : Set X) :=
  (Set.ext_iff.mp (preimage_fromSpecStalk_support_eq_zeroLocus Z ξ) q).symm

/-! ### Minimal primes and maximal points of the support -/

/-- The maximal points of the support of an ideal sheaf `Z` that specialize to `ξ`: the generic
points of the irreducible components of the support of `Z` passing through `ξ`, read as points of
the ambient scheme. -/
def componentGenericPointsThrough (Z : X.IdealSheafData) (ξ : X) : Set X :=
  {η | η ∈ (Z.support : Set X) ∧ η ⤳ ξ ∧ ∀ η' ∈ (Z.support : Set X), η' ⤳ η → η' = η}

/-- **The index correspondence of Stacks Tag 02S5.** A prime of the local ring at `ξ` is minimal
over the stalk of an ideal sheaf `Z` at `ξ` exactly when the corresponding point of `X` is a
maximal point of the support of `Z`.

Both directions use that `X.fromSpecStalk ξ` is injective and reflects specialization, being a
topological embedding, and that under it the order on primes is the specialization order. -/
theorem fromSpecStalk_mem_componentGenericPointsThrough_iff (Z : X.IdealSheafData) (ξ : X)
    (q : PrimeSpectrum (X.presheaf.stalk ξ)) :
    X.fromSpecStalk ξ q ∈ componentGenericPointsThrough Z ξ ↔
      q.asIdeal ∈ (IdealSheafData.stalk Z ξ).minimalPrimes := by
  have hgen : X.fromSpecStalk ξ q ⤳ ξ := X.range_fromSpecStalk.subset ⟨q, rfl⟩
  constructor
  · rintro ⟨hqZ, -, hmax⟩
    refine ⟨⟨q.2, (le_iff_fromSpecStalk_mem_support Z ξ q).mpr hqZ⟩, fun p hp hple => ?_⟩
    have heq : X.fromSpecStalk ξ ⟨p, hp.1⟩ = X.fromSpecStalk ξ q :=
      hmax _ ((le_iff_fromSpecStalk_mem_support Z ξ ⟨p, hp.1⟩).mp hp.2)
        ((fromSpecStalk_specializes_iff ⟨p, hp.1⟩ q).mpr hple)
    exact (congrArg PrimeSpectrum.asIdeal ((X.fromSpecStalk ξ).isEmbedding.injective heq)).ge
  · intro hmin
    refine ⟨(le_iff_fromSpecStalk_mem_support Z ξ q).mp hmin.1.2, hgen, fun η' hη' hη'q => ?_⟩
    obtain ⟨q', rfl⟩ : η' ∈ Set.range ⇑(X.fromSpecStalk ξ) := by
      rw [Scheme.range_fromSpecStalk]
      exact hη'q.trans hgen
    have hle : q'.asIdeal ≤ q.asIdeal := (fromSpecStalk_specializes_iff q' q).mp hη'q
    exact congrArg ⇑(X.fromSpecStalk ξ) (PrimeSpectrum.ext (hle.antisymm
        (hmin.2 ⟨q'.2, (le_iff_fromSpecStalk_mem_support Z ξ q').mpr hη'⟩ hle)))

/-- **The index correspondence of Stacks Tag 02S5, as a bijection.** The canonical morphism from
the spectrum of the local ring at `ξ` restricts to a bijection from the minimal primes over the
stalk of `Z` at `ξ` onto the maximal points of the support of `Z` specializing to `ξ`. -/
@[ega "IV 5.1.12"]
theorem bijOn_fromSpecStalk_minimalPrimes (Z : X.IdealSheafData) (ξ : X) :
    Set.BijOn ⇑(X.fromSpecStalk ξ)
      {q : PrimeSpectrum (X.presheaf.stalk ξ) |
        q.asIdeal ∈ (IdealSheafData.stalk Z ξ).minimalPrimes}
      (componentGenericPointsThrough Z ξ) := by
  refine ⟨fun q hq => (fromSpecStalk_mem_componentGenericPointsThrough_iff Z ξ q).mpr hq,
    (X.fromSpecStalk ξ).isEmbedding.injective.injOn, fun η hη => ?_⟩
  obtain ⟨q, rfl⟩ : η ∈ Set.range ⇑(X.fromSpecStalk ξ) := by
    rw [Scheme.range_fromSpecStalk]
    exact hη.2.1
  exact ⟨q, (fromSpecStalk_mem_componentGenericPointsThrough_iff Z ξ q).mp hη, rfl⟩

/-- The correspondence is between nonempty sets whenever `ξ` lies in the support of `Z`: the
stalk of `Z` at `ξ` is then a proper ideal of the local ring, so it has a minimal prime. -/
theorem componentGenericPointsThrough_nonempty (Z : X.IdealSheafData) (ξ : X)
    (hξ : ξ ∈ (Z.support : Set X)) :
    (componentGenericPointsThrough Z ξ).Nonempty ∧
      {q : PrimeSpectrum (X.presheaf.stalk ξ) |
        q.asIdeal ∈ (IdealSheafData.stalk Z ξ).minimalPrimes}.Nonempty := by
  have hmax : IdealSheafData.stalk Z ξ ≤ IsLocalRing.maximalIdeal (X.presheaf.stalk ξ) := by
    refine (le_iff_fromSpecStalk_mem_support Z ξ
      (IsLocalRing.closedPoint (X.presheaf.stalk ξ))).mpr ?_
    rwa [Scheme.fromSpecStalk_closedPoint]
  obtain ⟨p, hp, -⟩ := Ideal.exists_minimalPrimes_le
    (J := IsLocalRing.maximalIdeal (X.presheaf.stalk ξ)) hmax
  exact ⟨⟨X.fromSpecStalk ξ ⟨p, hp.1.1⟩,
    (fromSpecStalk_mem_componentGenericPointsThrough_iff Z ξ ⟨p, hp.1.1⟩).mpr hp⟩,
    ⟨⟨p, hp.1.1⟩, hp⟩⟩

/-- A maximal point of the support of `Z` is the generic point of an irreducible component of the
support: its closure is maximal among the irreducible subsets of the support.

A scheme is a sober space, so any irreducible subset of the support containing `η` has a generic
point, which lies in the support and specializes to `η`, hence equals `η` by maximality. -/
theorem maximal_isIrreducible_closure_of_mem_componentGenericPointsThrough
    {Z : X.IdealSheafData} {ξ η : X} (hη : η ∈ componentGenericPointsThrough Z ξ) :
    Maximal (fun T : Set X => IsIrreducible T ∧ T ⊆ (Z.support : Set X))
      (closure ({η} : Set X)) := by
  obtain ⟨hηZ, -, hmax⟩ := hη
  have hsub : closure ({η} : Set X) ⊆ (Z.support : Set X) :=
    Z.support.2.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hηZ)
  refine ⟨⟨isIrreducible_singleton.closure, hsub⟩, fun T hT hTle => ?_⟩
  obtain ⟨w, hw⟩ := QuasiSober.sober hT.1.closure isClosed_closure
  obtain rfl : w = η := hmax w (Z.support.2.closure_subset_iff.mpr hT.2 hw.mem)
    (hw.specializes (subset_closure (hTle (subset_closure rfl))))
  exact subset_closure.trans hw.symm.subset

/-- A prime of the local ring at `ξ` containing the stalk of `Z` at `ξ` comes from a point of the
closed subscheme cut out by `Z`. -/
theorem exists_subschemeι_eq_fromSpecStalk (Z : X.IdealSheafData) (ξ : X)
    (q : PrimeSpectrum (X.presheaf.stalk ξ)) (hq : IdealSheafData.stalk Z ξ ≤ q.asIdeal) :
    ∃ y : Z.subscheme, Z.subschemeι y = X.fromSpecStalk ξ q := by
  have h := (le_iff_fromSpecStalk_mem_support Z ξ q).mp hq
  rwa [← Z.range_subschemeι] at h

/-! ### The local ring at a generalization is a localization of the local ring -/

/-- **The local ring at a point specializing to `ξ` is a localization of the local ring at `ξ`.**
If `η ⤳ ξ` and `q` is the prime of `𝒪_{X, ξ}` corresponding to `η` under
`AlgebraicGeometry.Scheme.fromSpecStalk`, then `TopCat.Presheaf.stalkSpecializes` makes
`𝒪_{X, η}` the localization of `𝒪_{X, ξ}` at `q`.

On an affine open `U` containing `ξ` — hence containing `η`, as `η ⤳ ξ` — both local rings are
localizations of `Γ(X, U)`, the second at the smaller prime `q ∩ Γ(X, U)`, so
`IsLocalization.isLocalization_of_submonoid_le` makes `𝒪_{X, η}` a localization of `𝒪_{X, ξ}` at
the image of the smaller prime's complement; `IsLocalization.of_le` then enlarges that
multiplicative set to the whole complement of `q`, every element of which becomes invertible
because it is a fraction of two sections outside `q ∩ Γ(X, U)`. -/
theorem isLocalization_stalk_of_specializes {ξ η : X} (h : η ⤳ ξ)
    (q : PrimeSpectrum (X.presheaf.stalk ξ)) (hq : X.fromSpecStalk ξ q = η) :
    letI : Algebra (X.presheaf.stalk ξ) (X.presheaf.stalk η) :=
      (X.presheaf.stalkSpecializes h).hom.toAlgebra
    IsLocalization.AtPrime (X.presheaf.stalk η) q.asIdeal := by
  let _ : Algebra (X.presheaf.stalk ξ) (X.presheaf.stalk η) :=
    (X.presheaf.stalkSpecializes h).hom.toAlgebra
  obtain ⟨U, hξU⟩ := Stacks.Divisors.exists_affineOpens_mem ξ
  have hηU : η ∈ (U : X.Opens) := h.mem_open (U : X.Opens).2 hξU
  let _ : Algebra Γ(X, (U : X.Opens)) (X.presheaf.stalk ξ) :=
    X.presheaf.algebra_section_stalk ⟨ξ, hξU⟩
  let _ : Algebra Γ(X, (U : X.Opens)) (X.presheaf.stalk η) :=
    X.presheaf.algebra_section_stalk ⟨η, hηU⟩
  have := U.2.isLocalization_stalk ⟨ξ, hξU⟩
  have := U.2.isLocalization_stalk ⟨η, hηU⟩
  have := U.2.isOpenImmersion_fromSpec
  have hcomap : Ideal.comap (X.presheaf.germ (U : X.Opens) ξ hξU).hom q.asIdeal =
      (U.2.primeIdealOf ⟨η, hηU⟩).asIdeal :=
    congrArg PrimeSpectrum.asIdeal (U.2.fromSpec.isOpenEmbedding.injective
      ((fromSpecStalk_eq_fromSpec_comap_germ hξU q).symm.trans
        (hq.trans (U.2.fromSpec_primeIdealOf ⟨η, hηU⟩).symm)))
  have hpp : (U.2.primeIdealOf ⟨η, hηU⟩).asIdeal ≤ (U.2.primeIdealOf ⟨ξ, hξU⟩).asIdeal := by
    rw [← hcomap, U.2.primeIdealOf_eq_map_closedPoint ⟨ξ, hξU⟩]
    exact Ideal.comap_mono (IsLocalRing.le_maximalIdeal q.2.ne_top)
  have : IsScalarTower Γ(X, (U : X.Opens)) (X.presheaf.stalk ξ) (X.presheaf.stalk η) := by
    refine IsScalarTower.of_algebraMap_eq' ?_
    show (X.presheaf.germ (U : X.Opens) η hηU).hom =
      (X.presheaf.stalkSpecializes h).hom.comp (X.presheaf.germ (U : X.Opens) ξ hξU).hom
    rw [← CommRingCat.hom_comp, X.presheaf.germ_stalkSpecializes hξU h]
  have := IsLocalization.isLocalization_of_submonoid_le
    (R := Γ(X, (U : X.Opens))) (X.presheaf.stalk ξ) (X.presheaf.stalk η)
    (U.2.primeIdealOf ⟨ξ, hξU⟩).asIdeal.primeCompl
    (U.2.primeIdealOf ⟨η, hηU⟩).asIdeal.primeCompl fun x hx hx' => hx (hpp hx')
  refine IsLocalization.of_le
    (Submonoid.map (algebraMap Γ(X, (U : X.Opens)) (X.presheaf.stalk ξ))
      (U.2.primeIdealOf ⟨η, hηU⟩).asIdeal.primeCompl) q.asIdeal.primeCompl ?_ ?_
  · rintro x ⟨r, hr, rfl⟩
    show (X.presheaf.germ (U : X.Opens) ξ hξU).hom r ∉ q.asIdeal
    exact fun hmem => hr (hcomap ▸ (Ideal.mem_comap.mpr hmem))
  · intro a ha
    obtain ⟨⟨r, s⟩, hrs⟩ :=
      IsLocalization.surj (M := (U.2.primeIdealOf ⟨ξ, hξU⟩).asIdeal.primeCompl) a
    have hsA : algebraMap Γ(X, (U : X.Opens)) (X.presheaf.stalk ξ) (s : _) ∉ q.asIdeal :=
      fun hmem => q.2.ne_top (q.asIdeal.eq_top_of_isUnit_mem hmem (IsLocalization.map_units _ s))
    have hrA : algebraMap Γ(X, (U : X.Opens)) (X.presheaf.stalk ξ) r ∉ q.asIdeal := fun hmem =>
      (q.2.mem_or_mem (by rwa [← hrs] at hmem)).elim ha hsA
    have hrp : r ∈ (U.2.primeIdealOf ⟨η, hηU⟩).asIdeal.primeCompl := fun hmem =>
      hrA (hcomap ▸ hmem : r ∈ Ideal.comap _ q.asIdeal)
    have hrunit : IsUnit (algebraMap Γ(X, (U : X.Opens)) (X.presheaf.stalk η) r) :=
      IsLocalization.map_units _ ⟨r, hrp⟩
    have key : algebraMap (X.presheaf.stalk ξ) (X.presheaf.stalk η) a *
        algebraMap Γ(X, (U : X.Opens)) (X.presheaf.stalk η) (s : _) =
        algebraMap Γ(X, (U : X.Opens)) (X.presheaf.stalk η) r := by
      rw [IsScalarTower.algebraMap_apply Γ(X, (U : X.Opens)) (X.presheaf.stalk ξ)
        (X.presheaf.stalk η) r, ← hrs, map_mul, ← IsScalarTower.algebraMap_apply]
    exact isUnit_of_mul_isUnit_left (key ▸ hrunit)

/-- The stalk of an ideal sheaf at a point specializing to `ξ` is generated by the image of its
stalk at `ξ`: both are read on one affine open, where the two germ maps differ by
`TopCat.Presheaf.stalkSpecializes`. -/
theorem idealStalk_eq_map_stalkSpecializes (Z : X.IdealSheafData) {ξ η : X} (h : η ⤳ ξ) :
    IdealSheafData.stalk Z η =
      (IdealSheafData.stalk Z ξ).map (X.presheaf.stalkSpecializes h).hom := by
  obtain ⟨U, hξU⟩ := Stacks.Divisors.exists_affineOpens_mem ξ
  have hηU : η ∈ (U : X.Opens) := h.mem_open (U : X.Opens).2 hξU
  rw [IdealSheafData.stalk_eq_map_germ Z η U hηU, IdealSheafData.stalk_eq_map_germ Z ξ U hξU,
    Ideal.map_map]
  congr 1
  rw [← CommRingCat.hom_comp, X.presheaf.germ_stalkSpecializes hξU h]

/-! ### The localized length is the multiplicity of the component -/

/-- The kernel of the map on stalks of `Z.subschemeι` at `y` is the stalk of `Z` there. -/
private theorem ker_stalkMap_subschemeι_eq_idealStalk (Z : X.IdealSheafData) (y : Z.subscheme) :
    RingHom.ker (Z.subschemeι.stalkMap y).hom = IdealSheafData.stalk Z (Z.subschemeι y) := by
  rw [ker_stalkMap_eq_idealStalk_ker, Scheme.IdealSheafData.ker_subschemeι]

/-- Localizing `A ⧸ I` at a prime `q` gives the quotient of the localization of `A` at `q` by the
ideal generated by `I`, so the length of the localized module over the localization is the length
of that quotient ring over itself.

The localization of a quotient module is the quotient of the localization
(`IsLocalizedModule.toLocalizedQuotient'`), and `Submodule.localized'_eq_span` identifies the
localized submodule with `Ideal.map`. -/
private theorem length_localizedModule_quotient_eq {A : Type*} [CommRing A] (I : Ideal A)
    (q : Ideal A) [q.IsPrime] :
    Module.length (Localization.AtPrime q) (LocalizedModule q.primeCompl (A ⧸ I)) =
      Module.length (Localization.AtPrime q ⧸ I.map (algebraMap A (Localization.AtPrime q)))
        (Localization.AtPrime q ⧸ I.map (algebraMap A (Localization.AtPrime q))) := by
  have hloc : I.localized' (Localization.AtPrime q) q.primeCompl
      (Algebra.linearMap A (Localization.AtPrime q)) =
      I.map (algebraMap A (Localization.AtPrime q)) := by
    rw [Submodule.localized'_eq_span, Ideal.map]
    rfl
  have e : (Localization.AtPrime q ⧸ I.localized' (Localization.AtPrime q) q.primeCompl
        (Algebra.linearMap A (Localization.AtPrime q))) ≃ₗ[A]
      LocalizedModule q.primeCompl (A ⧸ I) :=
    IsLocalizedModule.linearEquiv q.primeCompl
      (I.toLocalizedQuotient' (Localization.AtPrime q) q.primeCompl
        (Algebra.linearMap A (Localization.AtPrime q)))
      (LocalizedModule.mkLinearMap q.primeCompl (A ⧸ I))
  rw [← (e.extendScalarsOfIsLocalization q.primeCompl (Localization.AtPrime q)).length_eq, hloc]
  exact Module.length_eq_of_surjective
    (R := Localization.AtPrime q ⧸ I.map (algebraMap A (Localization.AtPrime q)))
    Ideal.Quotient.mk_surjective

/-- **The third ingredient of Stacks Tag 02S5.** The length, over the localization of
`A = 𝒪_{X, ξ}` at a prime `q`, of the localization of `A ⧸ I` there — the factor appearing in
`Stacks.Chow.length_quotient_span_sup_eq_sum_minimalPrimes_of_notMem_associatedPrimes` — is the
length of the local ring of the closed subscheme cut out by `Z` at the point corresponding to
`q`.

The chain is three ring isomorphisms: `A_q` is the local ring at `η = X.fromSpecStalk ξ q`
(`Stacks.Chow.isLocalization_stalk_of_specializes`), the ideal generated there by the stalk of
`Z` at `ξ` is the stalk of `Z` at `η`
(`Stacks.Chow.idealStalk_eq_map_stalkSpecializes`), and the quotient of the local ring of `X` at
`η` by that stalk is the local ring of the subscheme
(`Stacks.Chow.ker_stalkMap_eq_idealStalk_ker`). -/
theorem length_localizedModule_quotient_idealStalk_eq_length_stalk (Z : X.IdealSheafData)
    {ξ : X} (q : PrimeSpectrum (X.presheaf.stalk ξ)) (y : Z.subscheme)
    (hq : X.fromSpecStalk ξ q = Z.subschemeι y) :
    Module.length (Localization.AtPrime q.asIdeal)
        (LocalizedModule q.asIdeal.primeCompl
          (X.presheaf.stalk ξ ⧸ IdealSheafData.stalk Z ξ)) =
      Module.length (Z.subscheme.presheaf.stalk y) (Z.subscheme.presheaf.stalk y) := by
  have h : Z.subschemeι y ⤳ ξ := X.range_fromSpecStalk.subset ⟨q, hq⟩
  let _ : Algebra (X.presheaf.stalk ξ) (X.presheaf.stalk (Z.subschemeι y)) :=
    (X.presheaf.stalkSpecializes h).hom.toAlgebra
  have : IsLocalization.AtPrime (X.presheaf.stalk (Z.subschemeι y)) q.asIdeal :=
    isLocalization_stalk_of_specializes h q hq
  -- the localization of `A` at `q` is the local ring at the corresponding point
  let E := IsLocalization.algEquiv q.asIdeal.primeCompl (Localization.AtPrime q.asIdeal)
    (X.presheaf.stalk (Z.subschemeι y))
  have hmapE : (IdealSheafData.stalk Z ξ).map
        (algebraMap (X.presheaf.stalk ξ) (X.presheaf.stalk (Z.subschemeι y))) =
      Ideal.map (E : Localization.AtPrime q.asIdeal →+* _)
        ((IdealSheafData.stalk Z ξ).map
          (algebraMap (X.presheaf.stalk ξ) (Localization.AtPrime q.asIdeal))) := by
    rw [Ideal.map_map]
    congr 1
    exact (E.toAlgHom.comp_algebraMap).symm
  -- the ideal generated by the stalk at `ξ` is the stalk at the corresponding point
  have hstalk : IdealSheafData.stalk Z (Z.subschemeι y) =
      (IdealSheafData.stalk Z ξ).map
        (algebraMap (X.presheaf.stalk ξ) (X.presheaf.stalk (Z.subschemeι y))) :=
    idealStalk_eq_map_stalkSpecializes Z h
  -- the quotient by that stalk is the local ring of the subscheme
  rw [length_localizedModule_quotient_eq (IdealSheafData.stalk Z ξ) q.asIdeal,
    Module.length_eq_of_ringEquiv (Ideal.quotientEquiv _ _ E.toRingEquiv hmapE),
    ← hstalk, ← ker_stalkMap_subschemeι_eq_idealStalk Z y,
    Module.length_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective
      (SurjectiveOnStalks.stalkMap_surjective Z.subschemeι y))]

/-- The same identity with the right-hand side written as the multiplicity of the irreducible
component of `Z` through the point, which is how Stacks Tag 02S5 states its comparison. -/
theorem length_localizedModule_quotient_idealStalk_eq_componentMultiplicity
    (Z : X.IdealSheafData) {ξ : X} (q : PrimeSpectrum (X.presheaf.stalk ξ))
    (y : genericPoints Z.subscheme) (hq : X.fromSpecStalk ξ q = Z.subschemeι y.1) :
    ((Module.length (Localization.AtPrime q.asIdeal)
          (LocalizedModule q.asIdeal.primeCompl
            (X.presheaf.stalk ξ ⧸ IdealSheafData.stalk Z ξ))).toNat : ℤ) =
      componentMultiplicity Z.subschemeι y := by
  rw [componentMultiplicity_eq_length_stalk,
    length_localizedModule_quotient_idealStalk_eq_length_stalk Z q y.1 hq]

/-! ### The component through a prime, as a closed subscheme -/

/-- The stalk of an ideal sheaf with integral subscheme is a prime ideal at every point of the
subscheme: the quotient of the local ring of `X` by that stalk is the local ring of the
subscheme, which is a domain. -/
private theorem isPrime_idealStalk_of_isIntegral (W : X.IdealSheafData)
    [IsIntegral W.subscheme] (y : W.subscheme) :
    (IdealSheafData.stalk W (W.subschemeι y)).IsPrime := by
  have hsurj : Function.Surjective (W.subschemeι.stalkMap y).hom :=
    SurjectiveOnStalks.stalkMap_surjective W.subschemeι y
  rw [← ker_stalkMap_subschemeι_eq_idealStalk W y, ← Ideal.Quotient.isDomain_iff_prime]
  exact Function.Injective.isDomain (RingHom.quotientKerEquivOfSurjective hsurj).toRingHom
    (RingHom.quotientKerEquivOfSurjective hsurj).injective

/-- **The component of a minimal prime, as an ideal sheaf.** The stalk at `ξ` of the reduced
closed subscheme supported on the closure of `η = X.fromSpecStalk ξ q` is `q` itself.

This is what lets Stacks Tag 02S5 read the factor `length_A A/(t, q)` of its local identity as
the coefficient of the zero fibre of the component `W_η`: that coefficient is computed from
`IdealSheafData.stalk W_η ξ`, which is `q`.

Both ideals have the same zero locus, by
`Stacks.Chow.preimage_fromSpecStalk_support_eq_zeroLocus` applied to `W_η` together with the
fact that `X.fromSpecStalk ξ` reflects specialization, so they have the same radical; and the
stalk is prime because `W_η` has integral subscheme
(`AlgebraicGeometry.Scheme.IdealSheafData.isIntegral_subscheme_vanishingIdeal_closure`). -/
theorem idealStalk_vanishingIdeal_closure_fromSpecStalk (ξ : X)
    (q : PrimeSpectrum (X.presheaf.stalk ξ)) :
    IdealSheafData.stalk (Scheme.IdealSheafData.vanishingIdeal
        (Closeds.closure ({X.fromSpecStalk ξ q} : Set X))) ξ = q.asIdeal := by
  have hint := Scheme.IdealSheafData.isIntegral_subscheme_vanishingIdeal_closure
    (X.fromSpecStalk ξ q)
  set W := Scheme.IdealSheafData.vanishingIdeal
    (Closeds.closure ({X.fromSpecStalk ξ q} : Set X)) with hW
  have hsupp : (W.support : Set X) = closure ({X.fromSpecStalk ξ q} : Set X) := by
    rw [hW, Scheme.IdealSheafData.coe_support_vanishingIdeal, Closeds.coe_closure]
  have hzl : PrimeSpectrum.zeroLocus (IdealSheafData.stalk W ξ : Set (X.presheaf.stalk ξ)) =
      PrimeSpectrum.zeroLocus (q.asIdeal : Set (X.presheaf.stalk ξ)) := by
    rw [← preimage_fromSpecStalk_support_eq_zeroLocus W ξ, hsupp]
    exact Set.Subset.antisymm
      (fun r hr => (fromSpecStalk_specializes_iff q r).mp (specializes_iff_mem_closure.mpr hr))
      fun r hr => specializes_iff_mem_closure.mp ((fromSpecStalk_specializes_iff q r).mpr hr)
  obtain ⟨y, hy⟩ : ∃ y : W.subscheme, W.subschemeι y = ξ := by
    rw [← Set.mem_range, W.range_subschemeι, hsupp]
    exact (X.range_fromSpecStalk.subset ⟨q, rfl⟩ : X.fromSpecStalk ξ q ⤳ ξ).mem_closure
  have hprime : (IdealSheafData.stalk W ξ).IsPrime :=
    hy ▸ isPrime_idealStalk_of_isIntegral W y
  have hrad : (IdealSheafData.stalk W ξ).radical = q.asIdeal.radical := by
    rw [← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
      ← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical, hzl]
  rwa [hprime.radical, q.2.radical] at hrad

end Stacks.Chow

