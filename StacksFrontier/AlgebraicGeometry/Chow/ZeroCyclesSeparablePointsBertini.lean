universe u

namespace Stacks.Chow.BertiniChain

attribute [local instance] Stacks.SectionsVanishingOnSubscheme.isInvertible_of_isInvertibleModule

/-- The relative dimension over a field is nonnegative. -/
theorem relativeDimension_nonneg_of_field (k : Type u) [Field k] {X : Scheme.{u}}
    (p : X ⟶ (fieldChowSituation k).S) (y : X) :
    0 ≤ relativeDimension (fieldChowSituation k).dimensionFunction p y := by
  rw [relativeDimension, fieldChowSituation_dimensionFunction, zero_add]
  exact Int.natCast_nonneg _

/-- **Closed points with separable residue field off `Z`.** If the trace of `T` off `Z` is smooth
over `k` and its points have `δ`-dimension at most `0`, every point of `T` off `Z` is closed with
residue field separable over `k`. -/
theorem isClosed_and_hasSeparableResidueField_of_smoothOffSupport (k : Type u) [Field k]
    {X : Scheme.{u}} (p : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType p]
    (I T : X.IdealSheafData) (hT : SmoothOffSupport p I T) (hdim : DimBoundOff p I T 0)
    (y : X) (hy : y ∈ T.support) (hyI : y ∉ I.support) :
    IsClosed ({y} : Set X) ∧ HasSeparableResidueField k p y := by
  set U := openComplement I
  set T' := T.comap U.ι
  have : Smooth (T'.subschemeι ≫ (U.ι ≫ p)) := hT
  have hyU : y ∈ U := hyI
  have hy' : (⟨y, hyU⟩ : U.toScheme) ∈ (T'.support : Set U.toScheme) := by
    rw [Scheme.IdealSheafData.support_comap]
    exact hy
  rw [← Scheme.IdealSheafData.range_subschemeι] at hy'
  obtain ⟨t, ht⟩ := hy'
  have hrel : ∀ t', relativeDimension (fieldChowSituation k).dimensionFunction
      (T'.subschemeι ≫ (U.ι ≫ p)) t' ≤ 0 := by
    intro t'
    rw [relativeDimension_comp_closedImmersion, relativeDimension_opensι_comp]
    have hmem : T'.subschemeι t' ∈ (T'.support : Set U.toScheme) := by
      rw [← Scheme.IdealSheafData.range_subschemeι]; exact ⟨t', rfl⟩
    rw [Scheme.IdealSheafData.support_comap] at hmem
    exact hdim _ hmem (T'.subschemeι t').2
  have hsep := hasSeparableResidueField_of_smooth_of_relativeDimension_le_zero k
    (T'.subschemeι ≫ (U.ι ≫ p)) hrel t
  rw [← Category.assoc, hasSeparableResidueField_comp_iff] at hsep
  have hgt : (T'.subschemeι ≫ U.ι) t = y := by
    rw [Scheme.Hom.comp_apply, ht]
    rfl
  rw [hgt] at hsep
  refine ⟨isClosed_singleton_of_relativeDimension_eq_zero k p ?_, hsep⟩
  exact le_antisymm (hdim y hy hyI) (relativeDimension_nonneg_of_field k p y)

/-- On an integral scheme over `k` every point has `δ`-dimension at most that of the generic
point. -/
theorem dimBoundOff_bot (k : Type u) [Field k] {X : Scheme.{u}} [IsIntegral X]
    (p : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType p] (I : X.IdealSheafData) (d : ℕ)
    (hd : relativeDimension (fieldChowSituation k).dimensionFunction p (genericPoint X) = d) :
    DimBoundOff p I ⊥ d := by
  intro y _ _
  rw [← hd]
  by_cases hy : y = genericPoint X
  · rw [hy]
  · refine (relativeDimension_lt_of_mem_closure_of_ne (fieldChowSituation k) p ?_ hy).le
    exact specializes_iff_mem_closure.mp ((genericPoint_spec X).specializes (Set.mem_univ y))

end Stacks.Chow.BertiniChain

namespace Stacks.Chow

open BertiniChain

attribute [local instance] Stacks.SectionsVanishingOnSubscheme.isInvertible_of_isInvertibleModule

/-- **The Bertini argument of Stacks 0FH5**, Steps 3 to 8 of the source: on an integral smooth
proper `k`-scheme with an ample invertible module, every closed point `x` admits zero cycles `Z`,
`Z'` supported on closed points with separable residue field such that `[x] + [Z] = [Z']`. -/
theorem integralComplementaryCycles (k : Type u) [Field k] : IntegralComplementaryCycles.{u} k := by
  intro X p _ _ _ L _ hL x hx
  -- a closed point with separable residue field is its own complementary cycle
  by_cases hsepx : HasSeparableResidueField k p x
  · refine ⟨0, cycleAssociatedToClosedSubscheme (fieldChowSituation k) p
      (integralComponentAt x).subschemeι 0,
      fun y hy => absurd rfl hy, fun y hy => ?_, by simp⟩
    have hyr : y ∈ Set.range (integralComponentAt x).subschemeι.base := by
      by_contra hn
      exact hy (cycleAssociatedToClosedSubscheme_apply_eq_zero_of_notMem_range
        (fieldChowSituation k) p _ 0 hn)
    rw [Scheme.IdealSheafData.range_subschemeι, coe_support_integralComponentAt,
      hx.closure_eq] at hyr
    obtain rfl : y = x := hyr
    exact ⟨hx, hsepx⟩
  -- otherwise `k` is not perfect, hence infinite
  have : Infinite k := by
    by_contra hfin
    rw [not_infinite_iff_finite] at hfin
    exact hsepx (hasSeparableResidueField_of_isClosed_of_perfectField k p hx)
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian p
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace p
  have : IsNoetherian X := {}
  -- the dimension `d` of `X`, and the regular local ring at `x`
  obtain ⟨d, hd⟩ : ∃ d : ℕ,
      relativeDimension (fieldChowSituation k).dimensionFunction p (genericPoint X) = d :=
    ⟨_, (Int.toNat_of_nonneg (relativeDimension_nonneg_of_field k p _)).symm⟩
  have hdimx := ringKrullDim_stalk_eq_of_isClosed k p x hx d hd
  have := isRegularLocalRing_stalk_of_smooth p x
  have hcot : Module.finrank (IsLocalRing.ResidueField (X.presheaf.stalk x))
      (IsLocalRing.CotangentSpace (X.presheaf.stalk x)) = d := by
    have h := (IsRegularLocalRing.iff_finrank_cotangentSpace (X.presheaf.stalk x)).mp ‹_›
    rw [hdimx] at h
    exact_mod_cast h
  -- the reduced point `x` as a closed subscheme
  set I := Scheme.IdealSheafData.vanishingIdeal ⟨{x}, hx⟩
  have hIsupp : (I.support : Set X) = {x} := by
    rw [Stacks.GenericFlatness.support_vanishingIdeal]
    rfl
  have hxI : x ∈ I.support := by
    change x ∈ (I.support : Set X)
    rw [hIsupp]; rfl
  have hIstalk := AlgebraicGeometry.IdealSheafData.stalk_vanishingIdeal_singleton x hx
  -- Stacks 0FD5 for `x` and for the empty subscheme, and Step 3 (d)
  obtain ⟨n₁, hn₁⟩ := exists_bound_generatesOffSupport_and_isImmersion k p I hL
  obtain ⟨n₂, hn₂⟩ := exists_bound_generatesOffSupport_and_isImmersion k p ⊤ hL
  obtain ⟨n₃, hn₃⟩ := exists_bound_span_germ_vanishingSections_eq_maximalSmul k p L hL I x hIstalk
  set n := max (max n₁ n₂) n₃
  obtain ⟨hgen, himm⟩ := hn₁ n (le_max_of_le_left (le_max_left _ _))
  obtain ⟨hgen', himm'⟩ := hn₂ n (le_max_of_le_left (le_max_right _ _))
  have hspan := hn₃ n (le_max_right _ _)
  set M := tensorPowModule X L n
  have := finiteDimensional_vanishingSections k p I L n
  have := finiteDimensional_vanishingSections k p ⊤ L n
  obtain ⟨U, hxU, e, hβ⟩ := exists_affineOpen_linearEquiv_isStalkBasis M x
  have hvan : ∀ v ∈ vanishingSections k p I L n, (M.presheaf.Γgerm x).hom
      ((v : Stacks.Bertini.globalSections k p M) : Γ(M, ⊤)) ∈
        Stacks.ModuleStalk.maximalSmul M x :=
    fun v hv => Γgerm_mem_maximalSmul_of_mem_vanishingSections k p I L n x hxI ⟨v, hv⟩
  -- the cut through `x`
  obtain ⟨s, hQs, hsm, hdimc, hnv⟩ := exists_chain p I L n hgen (fun N b => (himm N b).1) d
    (dimBoundOff_bot k p I d hd)
    (fun j s => LinearIndependent (IsLocalRing.ResidueField (X.presheaf.stalk x))
      (cotangentOf p M x hβ (vanishingSections k p I L n) hvan ∘ s))
    (linearIndependent_empty_type)
    (fun j hj s hs => exists_submodule_linearIndependent_snoc p M x hβ _ hvan hspan s hs
      (by omega))
  set σ := secs p I L n s
  have hstalkT : AlgebraicGeometry.IdealSheafData.stalk (familyCut M σ) x =
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
    stalk_iSup_zeroScheme_eq_maximalIdeal M σ x
      (span_germ_eq_maximalSmul_of_linearIndependent p M x hβ _ hvan s hQs hcot)
  have hcut : IsIteratedDivisorCut (fieldChowSituation k) p M d 0 (familyCut M σ).subscheme
      (familyCut M σ).subschemeι := by
    refine isIteratedDivisorCut_familyCut p I M d σ ?_ hdimc ?_
    · intro y hy
      have hyx : y = x := by
        have : y ∈ (I.support : Set X) := hy
        rwa [hIsupp] at this
      rw [hyx, relativeDimension_eq_zero_of_isClosed (fieldChowSituation k) (fun _ _ => rfl) p x hx]
    · intro j hj ξ hrel
      by_cases hy : (familyCut M (prefixFamily σ j hj.le)).subschemeι
          ((cutIdeal (familyCut M (prefixFamily σ j hj.le)).subschemeι M
            (restrictedSection (familyCut M (prefixFamily σ j hj.le)) M
              (σ ⟨j, hj⟩))).subschemeι ξ.1) ∈ I.support
      · have hyx : (familyCut M (prefixFamily σ j hj.le)).subschemeι
            ((cutIdeal (familyCut M (prefixFamily σ j hj.le)).subschemeι M
              (restrictedSection (familyCut M (prefixFamily σ j hj.le)) M
                (σ ⟨j, hj⟩))).subschemeι ξ.1) = x := by
          have : _ ∈ (I.support : Set X) := hy
          rwa [hIsupp] at this
        rw [relativeDimension_comp_closedImmersion, hyx,
          relativeDimension_eq_zero_of_isClosed (fieldChowSituation k) (fun _ _ => rfl) p x hx]
          at hrel
        obtain rfl : d = j + 1 := by omega
        exact injective_restrictedSection_at_point M x σ hdimx hstalkT ξ.1 hyx
      · exact injective_restrictedSection_of_notMem_support p I _ M (σ ⟨j, hj⟩)
          (hsm j hj.le) (hnv j hj) ξ.1 hy
  -- the general complete intersection
  have hnot : ∀ y : X, y ∉ (⊤ : X.IdealSheafData).support := fun y h => by
    rw [Scheme.IdealSheafData.support_top] at h
    change y ∈ ((⊥ : TopologicalSpace.Closeds X) : Set X) at h
    simp at h
  obtain ⟨s', -, hsm', hdimc', hnv'⟩ := exists_chain p ⊤ L n hgen' (fun N b => (himm' N b).1) d
    (dimBoundOff_bot k p ⊤ d hd) (fun _ _ => True) trivial
    (fun j _ _ _ => ⟨vanishingAtSubmodule k p ⊤ L n x,
      vanishingAtSubmodule_ne_top k p ⊤ L n hgen' (hnot x), fun _ _ => trivial⟩)
  set σ' := secs p ⊤ L n s'
  have hcut' : IsIteratedDivisorCut (fieldChowSituation k) p M d 0 (familyCut M σ').subscheme
      (familyCut M σ').subschemeι := by
    refine isIteratedDivisorCut_familyCut p ⊤ M d σ' (fun y hy => absurd hy (hnot y)) hdimc' ?_
    intro j hj ξ _
    exact injective_restrictedSection_of_notMem_support p ⊤ _ M (σ' ⟨j, hj⟩)
      (hsm' j hj.le) (hnv' j hj) ξ.1 (hnot _)
  -- Step 5 and Steps 7, 8
  obtain ⟨Z, ι₂, hι₂, hrange, hsplit⟩ :=
    exists_mk_cycleAssociatedToClosedSubscheme_eq_add_integralComponentAt (fieldChowSituation k) p
      (familyCut M σ) x hx
      hstalkT 0
  have hcomp := mk_eq_mk_of_isIteratedDivisorCut (fieldChowSituation k) p M d 0 _ _ hcut hcut'
  refine ⟨cycleAssociatedToClosedSubscheme (fieldChowSituation k) p ι₂ 0,
    cycleAssociatedToClosedSubscheme (fieldChowSituation k) p (familyCut M σ').subschemeι 0,
    ?_, ?_, ?_⟩
  · intro y hy
    have hyr : y ∈ Set.range ι₂.base := by
      by_contra hn
      exact hy (cycleAssociatedToClosedSubscheme_apply_eq_zero_of_notMem_range
        (fieldChowSituation k) p ι₂ 0 hn)
    rw [hrange] at hyr
    have hdim0 := hdimc d le_rfl
    have hsm0 := hsm d le_rfl
    rw [prefixFamily_self] at hdim0 hsm0
    refine isClosed_and_hasSeparableResidueField_of_smoothOffSupport k p I _ hsm0
      (by simpa using hdim0) y hyr.1 ?_
    intro hyI
    exact hyr.2 (by
      have : y ∈ (I.support : Set X) := hyI
      rwa [hIsupp] at this)
  · intro y hy
    have hyr : y ∈ Set.range (familyCut M σ').subschemeι.base := by
      by_contra hn
      exact hy (cycleAssociatedToClosedSubscheme_apply_eq_zero_of_notMem_range
        (fieldChowSituation k) p _ 0 hn)
    rw [Scheme.IdealSheafData.range_subschemeι] at hyr
    have hdim0 := hdimc' d le_rfl
    have hsm0 := hsm' d le_rfl
    rw [prefixFamily_self] at hdim0 hsm0
    exact isClosed_and_hasSeparableResidueField_of_smoothOffSupport k p ⊤ _ hsm0
      (by simpa using hdim0) y hyr (hnot y)
  · rw [← hsplit, hcomp]

/-- **The output of the Bertini half of the proof of Stacks 0FH5, over every field**: for every
closed point `x` of a smooth projective `k`-scheme there are zero cycles `Z`, `Z'` supported on
closed points with separable residue field such that `[x] + [Z] = [Z']` in `A_0(X)`. -/
theorem separablePointComplementaryCycles (k : Type u) [Field k] :
    SeparablePointComplementaryCycles.{u} k :=
  separablePointComplementaryCycles_of_integralComplementaryCycles k
    (integralComplementaryCycles k)

/-- **Stacks 0FH5.** Let `k` be a field and let `X` be a smooth projective scheme over `k`. Then
`CH_0(X)` is generated by the classes of the closed points of `X` whose residue fields are
separable over `k`. -/
@[stacks 0FH5]
theorem mem_closure_separablePointClasses_of_isProjectiveMorphism (k : Type u) [Field k]
    {X : Scheme.{u}} (p : X ⟶ (fieldChowSituation k).S) [Smooth p]
    (hproj : IsProjectiveMorphism p) (α : chowGroup (fieldChowSituation k) p 0) :
    α ∈ AddSubgroup.closure (separablePointClasses k p) :=
  have : IsProper p := isProper_of_isProjectiveMorphism p hproj
  mem_closure_separablePointClasses k p hproj (separablePointComplementaryCycles k) α

end Stacks.Chow

