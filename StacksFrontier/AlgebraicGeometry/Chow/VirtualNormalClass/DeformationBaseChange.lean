/-!
# The deformation space under base change

Let `h : U' ⟶ U` be a morphism of schemes, `ℐ` a quasi-coherent ideal sheaf on `U` and
`ℐ' = h⁻¹ℐ · 𝒪_{U'}` its inverse image. The morphism of deformation spaces
`φ : D(ℐ') ⟶ D(ℐ)` over `h` (`Stacks.Deformation.deformationMap`) is, chart by chart, the map of
extended Rees algebras `A[t⁻¹, It] ⟶ A'[t⁻¹, IA't]` over the ring map `A ⟶ A'` of an affine open
`Spec A' ⊆ h⁻¹(Spec A)`. This file proves that the target ring is generated over `A'` by the image
of the source, which is what makes `D(ℐ') ⟶ D(ℐ) ×_U U'` a closed immersion.

## Main results

* `Stacks.Deformation.chartIncl_restrict` — the chart sections are compatible with restriction.
* `Stacks.Deformation.adjoin_range_deformationMap_appLE` — over affine opens
  `Spec A' ⊆ h⁻¹(Spec A)` the functions on the chart of `D(ℐ')` are generated over `A'` by the
  image of the functions on the chart of `D(ℐ)`.

## References

* [Stacks Project, Tag 0FBK](https://stacks.math.columbia.edu/tag/0FBK)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.AffineAlgebraEquivalence Stacks.RelativeSpec Stacks.Blowup

universe u

namespace Stacks.Deformation

section Restrict

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- **The chart sections `x t^k` are compatible with restriction.** -/
theorem chartIncl_restrict (k : ℤ) {W W' : X.Opens} (hle : W' ≤ W)
    (x : ((extReesGradedAlgebra I).piece k).val.obj (op W)) :
    (deformationSpace I).presheaf.map
        (homOfLE (Scheme.Hom.preimage_mono (deformationSpaceToBase I) hle)).op
        (chartIncl I k W x) =
      chartIncl I k W' (((extReesGradedAlgebra I).piece k).val.map (homOfLE hle).op x) := by
  have h1 := ConcreteCategory.congr_hom
    ((universalAlgebraMap (extReesSituation I)).right.naturality (homOfLE hle).op)
    (((ungradedAlgebraSheafIsoGradedAlgebraSheaf X (extReesGradedAlgebra I)
      (extReesGradedAlgebra_mul_comm I)).hom.right.hom.app (op W)).hom
      (ungradedAlgebraSheafIncl X (extReesGradedAlgebra I) (extReesGradedAlgebra_mul_comm I) k W x))
  have h2 := ConcreteCategory.congr_hom
    ((ungradedAlgebraSheafIsoGradedAlgebraSheaf X (extReesGradedAlgebra I)
      (extReesGradedAlgebra_mul_comm I)).hom.right.hom.naturality (homOfLE hle).op)
    (ungradedAlgebraSheafIncl X (extReesGradedAlgebra I) (extReesGradedAlgebra_mul_comm I) k W x)
  have h3 := Stacks.RelativeSpec.ungradedAlgebraSheafIncl_restrict X (extReesGradedAlgebra I)
    (extReesGradedAlgebra_mul_comm I) k hle x
  refine h1.symm.trans ?_
  refine congrArg _ (h2.symm.trans ?_)
  exact congrArg _ h3

end Restrict

section Generation

variable {U U' : Scheme.{u}} (h : U' ⟶ U) (J : U.IdealSheafData) (J' : U'.IdealSheafData)
  (hJ : J.comap h = J')

include hJ in
/-- The inverse image ideal on an affine open `W' ⊆ h⁻¹(W)` is generated by the image of the
ideal on `W`. -/
theorem ideal_comap_eq_span (W : U.affineOpens) (W' : U'.affineOpens) (hW' : W'.1 ≤ h ⁻¹ᵁ W.1) :
    J'.ideal W' = Ideal.span ((h.appLE W.1 W'.1 hW').hom '' (J.ideal W : Set Γ(U, W.1))) := by
  rw [← hJ, Stacks.IdealSheaf.ideal_comap_appLE J h W W' hW', Ideal.map]

include hJ in
/-- **The morphism of deformation spaces on the sections `a t`**: over affine opens
`W' ⊆ h⁻¹(W)` it sends `a t` to `h^♯(a) t`. -/
theorem deformationMap_appLE_chartIncl_one (W : U.affineOpens) (W' : U'.affineOpens)
    (hW' : W'.1 ≤ h ⁻¹ᵁ W.1) (b : Γ(U, W.1)) (hb : b ∈ J.ideal W)
    (hle : deformationSpaceToBase J' ⁻¹ᵁ W'.1 ≤
      deformationMap h J J' hJ.le ⁻¹ᵁ (deformationSpaceToBase J ⁻¹ᵁ W.1)) :
    ((deformationMap h J J' hJ.le).appLE (deformationSpaceToBase J ⁻¹ᵁ W.1)
        (deformationSpaceToBase J' ⁻¹ᵁ W'.1) hle).hom
        (chartIncl J 1 W.1 (extReesOfMem J W 1 b (by rwa [pow_one]))) =
      chartIncl J' 1 W'.1 (extReesOfMem J' W' 1 ((h.appLE W.1 W'.1 hW').hom b) (by
        rw [pow_one, ideal_comap_eq_span h J J' hJ W W' hW']
        exact Ideal.subset_span ⟨b, hb, rfl⟩)) := by
  have hle₀ : deformationSpaceToBase J' ⁻¹ᵁ (h ⁻¹ᵁ W.1) ≤
      deformationMap h J J' hJ.le ⁻¹ᵁ (deformationSpaceToBase J ⁻¹ᵁ W.1) := by
    rw [← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage, deformationMap_toBase]
  have hres : deformationSpaceToBase J' ⁻¹ᵁ W'.1 ≤ deformationSpaceToBase J' ⁻¹ᵁ (h ⁻¹ᵁ W.1) :=
    Scheme.Hom.preimage_mono _ hW'
  have hcomp := Scheme.Hom.appLE_map (deformationMap h J J' hJ.le) hle₀ (homOfLE hres).op
  rw [← hcomp]
  refine (congrArg ((deformationSpace J').presheaf.map (homOfLE hres).op).hom
    (deformationMap_appLE_chartIncl' h J J' hJ.le W 1 _ hle₀)).trans ?_
  refine (chartIncl_restrict J' 1 hW' _).trans ?_
  congr 1
  refine extReesAmbient_injective J' 1 W'.1 ?_
  refine (extReesAmbient_restrict J' 1 W'.1 _ hW' _).trans ?_
  refine (congrArg _ (extReesAmbient_extReesPullback h J J' hJ.le 1 W.1 _)).trans ?_
  refine Eq.trans ?_ (extReesAmbient_extReesOfMem J' W' 1 _ _).symm
  have hb' := extReesAmbient_extReesOfMem J W 1 b (by rwa [pow_one])
  refine (congrArg (fun z => (U'.presheaf.map (homOfLE hW').op).hom ((h.app W.1).hom z))
    hb').trans ?_
  rw [Scheme.Hom.appLE]
  rfl

include hJ in
/-- **Generation of the chart of `D(ℐ')`**: over affine opens `W' ⊆ h⁻¹(W)` the functions on the
chart of `D(ℐ')` are generated over `Γ(U', W')` by the image of the functions on the chart of
`D(ℐ)`. -/
theorem adjoin_range_deformationMap_appLE (W : U.affineOpens) (W' : U'.affineOpens)
    (hW' : W'.1 ≤ h ⁻¹ᵁ W.1)
    (hle : deformationSpaceToBase J' ⁻¹ᵁ W'.1 ≤
      deformationMap h J J' hJ.le ⁻¹ᵁ (deformationSpaceToBase J ⁻¹ᵁ W.1)) :
    letI : Algebra Γ(U', W'.1) Γ(deformationSpace J', deformationSpaceToBase J' ⁻¹ᵁ W'.1) :=
      ((deformationSpaceToBase J').appLE W'.1 (deformationSpaceToBase J' ⁻¹ᵁ W'.1)
        le_rfl).hom.toAlgebra
    Algebra.adjoin Γ(U', W'.1)
      (Set.range ((deformationMap h J J' hJ.le).appLE (deformationSpaceToBase J ⁻¹ᵁ W.1)
        (deformationSpaceToBase J' ⁻¹ᵁ W'.1) hle).hom) = ⊤ := by
  let : Algebra Γ(U', W'.1) Γ(deformationSpace J', deformationSpaceToBase J' ⁻¹ᵁ W'.1) :=
    ((deformationSpaceToBase J').appLE W'.1 (deformationSpaceToBase J' ⁻¹ᵁ W'.1)
      le_rfl).hom.toAlgebra
  have hgen := adjoin_param_gens_eq_top J' W'
    ((h.appLE W.1 W'.1 hW').hom '' (J.ideal W : Set Γ(U, W.1)))
    (ideal_comap_eq_span h J J' hJ W W' hW')
  rw [eq_top_iff, ← hgen, Algebra.adjoin_le_iff]
  rintro y (rfl | ⟨⟨a, ⟨b, hb, rfl⟩⟩, -, rfl⟩)
  · exact Algebra.subset_adjoin ⟨paramChartOf J W.1,
      deformationMap_appLE_paramChartOf h J J' hJ.le W W'.1 hW' hle⟩
  · exact Algebra.subset_adjoin ⟨_, deformationMap_appLE_chartIncl_one h J J' hJ W W' hW' b hb hle⟩

end Generation

section ClosedImmersion

variable {D D' X X' : Scheme.{u}} (π : D ⟶ X) (π' : D' ⟶ X') (h : X' ⟶ X) (φ : D' ⟶ D)
  (hφ : φ ≫ π = π' ≫ h)

/-- The open `π⁻¹(W) ×_W W'` of `D ×_X X'` over affine opens `W ⊆ X`, `W' ⊆ h⁻¹(W)`. -/
abbrev pullbackChart (W : X.Opens) (W' : X'.Opens) : (pullback π h).Opens :=
  pullback.fst π h ⁻¹ᵁ (π ⁻¹ᵁ W) ⊓ pullback.snd π h ⁻¹ᵁ W'

/-- If `π` is affine and `W ⊆ X`, `W' ⊆ h⁻¹(W)` are affine opens, then `pullbackChart π h W W'` is
an affine open of `D ×_X X'`. -/
theorem isAffineOpen_pullbackChart [IsAffineHom π] (W : X.affineOpens) (W' : X'.affineOpens)
    (hW' : W'.1 ≤ h ⁻¹ᵁ W.1) : IsAffineOpen (pullbackChart π h W.1 W'.1) := by
  have hsq := Scheme.Hom.isPullback_resLE (IsPullback.of_hasPullback π h) hW'
    (le_refl (π ⁻¹ᵁ W.1)) (UY := pullbackChart π h W.1 W'.1) rfl
  have : IsAffine (π ⁻¹ᵁ W.1) := W.2.preimage π
  have : IsAffine W'.1 := W'.2
  have : IsAffine W.1 := W.2
  exact IsAffine.of_isPullback hsq

include hφ in
/-- For `W' ⊆ h⁻¹(W)`, the inverse image of `pullbackChart π h W W'` under the induced morphism
`D' ⟶ D ×_X X'` is `π'⁻¹(W')`. -/
theorem preimage_pullbackChart (W : X.Opens) (W' : X'.Opens) (hW' : W' ≤ h ⁻¹ᵁ W) :
    pullback.lift φ π' hφ ⁻¹ᵁ pullbackChart π h W W' = π' ⁻¹ᵁ W' := by
  simp only [pullbackChart, Scheme.Hom.preimage_inf, ← Scheme.Hom.comp_preimage, pullback.lift_snd]
  rw [pullback.lift_fst_assoc, hφ, Scheme.Hom.comp_preimage]
  exact inf_eq_right.2 (Scheme.Hom.preimage_mono _ hW')

/-- If `π` is affine, the opens `pullbackChart π h W W'`, over affine opens `W ⊆ X` and
`W' ⊆ h⁻¹(W)`, cover `D ×_X X'`. -/
theorem iSup_pullbackChart [IsAffineHom π] :
    ⨆ P : Σ W : X.affineOpens, {W' : X'.affineOpens // W'.1 ≤ h ⁻¹ᵁ W.1},
      pullbackChart π h P.1.1 P.2.1.1 = ⊤ := by
  refine eq_top_iff.2 fun z _ => ?_
  obtain ⟨W, hW⟩ := Stacks.Divisors.exists_affineOpens_mem (π (pullback.fst π h z))
  have hz : h (pullback.snd π h z) ∈ W.1 := by
    have := congrArg (fun q : pullback π h ⟶ X => q z) (pullback.condition (f := π) (g := h))
    simp only [Scheme.Hom.comp_apply] at this
    rw [← this]
    exact hW
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVle⟩ := X'.isBasis_affineOpens.exists_subset_of_mem_open
    (show pullback.snd π h z ∈ (h ⁻¹ᵁ W.1 : X'.Opens) from hz) (h ⁻¹ᵁ W.1).isOpen
  exact TopologicalSpace.Opens.mem_iSup.2 ⟨⟨W, ⟨⟨V, hV⟩, hVle⟩⟩, ⟨hW, hxV⟩⟩

include hφ in
/-- If the functions on `π'⁻¹(W')` are generated over `Γ(X', W')` by the image of the functions on
`π⁻¹(W)`, then the map on sections of `D' ⟶ D ×_X X'` from `pullbackChart π h W W'` to
`π'⁻¹(W')` is surjective. -/
theorem surjective_appLE_pullbackChart (W : X.Opens) (W' : X'.Opens) (_hW' : W' ≤ h ⁻¹ᵁ W)
    (hle : π' ⁻¹ᵁ W' ≤ φ ⁻¹ᵁ (π ⁻¹ᵁ W))
    (hle' : π' ⁻¹ᵁ W' ≤ pullback.lift φ π' hφ ⁻¹ᵁ pullbackChart π h W W')
    (hgen : letI : Algebra Γ(X', W') Γ(D', π' ⁻¹ᵁ W') :=
        (π'.appLE W' (π' ⁻¹ᵁ W') le_rfl).hom.toAlgebra
      Algebra.adjoin Γ(X', W') (Set.range (φ.appLE (π ⁻¹ᵁ W) (π' ⁻¹ᵁ W') hle).hom) = ⊤) :
    Function.Surjective
      ((pullback.lift φ π' hφ).appLE (pullbackChart π h W W') (π' ⁻¹ᵁ W') hle').hom := by
  let : Algebra Γ(X', W') Γ(D', π' ⁻¹ᵁ W') := (π'.appLE W' (π' ⁻¹ᵁ W') le_rfl).hom.toAlgebra
  have key : ∀ {Z : Scheme.{u}} (g : pullback π h ⟶ Z) (q : D' ⟶ Z)
      (_ : pullback.lift φ π' hφ ≫ g = q) (A : Z.Opens) (hA : pullbackChart π h W W' ≤ g ⁻¹ᵁ A)
      (hq : π' ⁻¹ᵁ W' ≤ q ⁻¹ᵁ A) (y : Γ(Z, A)),
      ((pullback.lift φ π' hφ).appLE (pullbackChart π h W W') (π' ⁻¹ᵁ W') hle').hom
        ((g.appLE A (pullbackChart π h W W') hA).hom y) = (q.appLE A (π' ⁻¹ᵁ W') hq).hom y := by
    rintro Z g q rfl A hA hq y
    exact congrArg (fun m => m.hom y) (Scheme.Hom.appLE_comp_appLE _ g A _ _ hA hle')
  have hfst := key (pullback.fst π h) φ (pullback.lift_fst φ π' hφ) (π ⁻¹ᵁ W) inf_le_left hle
  have hsnd := key (pullback.snd π h) π' (pullback.lift_snd φ π' hφ) W' inf_le_right le_rfl
  intro z
  have hz : z ∈ Algebra.adjoin Γ(X', W') (Set.range (φ.appLE (π ⁻¹ᵁ W) (π' ⁻¹ᵁ W') hle).hom) := by
    rw [hgen]; trivial
  induction hz using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨y, rfl⟩ := hx
    exact ⟨_, hfst y⟩
  | algebraMap a => exact ⟨_, hsnd a⟩
  | add x y _ _ hx hy =>
    obtain ⟨x', rfl⟩ := hx
    obtain ⟨y', rfl⟩ := hy
    exact ⟨x' + y', map_add _ _ _⟩
  | mul x y _ _ hx hy =>
    obtain ⟨x', rfl⟩ := hx
    obtain ⟨y', rfl⟩ := hy
    exact ⟨x' * y', map_mul _ _ _⟩

/-- Surjectivity of `f.appLE V V'` transfers to `f.app A` followed by restriction along the
equality `B = f⁻¹(A)`, whenever `A = V` and `f⁻¹(V) = V'`. -/
theorem surjective_app_eqToHom {Y T : Scheme.{u}} (f : Y ⟶ T) (A V : T.Opens) (hA : A = V)
    (B : Y.Opens) (hB : B = f ⁻¹ᵁ A) (V' : Y.Opens) (hV' : f ⁻¹ᵁ V = V')
    (hs : Function.Surjective (f.appLE V V' hV'.ge).hom) :
    Function.Surjective (f.app A ≫ Y.presheaf.map (eqToHom hB).op).hom := by
  subst hA hV' hB
  have : f.appLE A (f ⁻¹ᵁ A) le_rfl = f.app A := (Scheme.Hom.app_eq_appLE f).symm
  rw [this] at hs
  simpa using hs

include hφ in
/-- **A criterion for `D' ⟶ D ×_X X'` to be a closed immersion**: when `π` and `π'` are affine and
over affine opens `W' ⊆ h⁻¹(W)` the functions on `π'⁻¹W'` are generated over `Γ(X', W')` by the
image of the functions on `π⁻¹W`. -/
theorem isClosedImmersion_lift_of_adjoin [IsAffineHom π] [IsAffineHom π']
    (hgen : ∀ (W : X.affineOpens) (W' : X'.affineOpens) (_ : W'.1 ≤ h ⁻¹ᵁ W.1)
      (hle : π' ⁻¹ᵁ W'.1 ≤ φ ⁻¹ᵁ (π ⁻¹ᵁ W.1)),
      letI : Algebra Γ(X', W'.1) Γ(D', π' ⁻¹ᵁ W'.1) :=
        (π'.appLE W'.1 (π' ⁻¹ᵁ W'.1) le_rfl).hom.toAlgebra
      Algebra.adjoin Γ(X', W'.1) (Set.range (φ.appLE (π ⁻¹ᵁ W.1) (π' ⁻¹ᵁ W'.1) hle).hom) = ⊤) :
    IsClosedImmersion (pullback.lift φ π' hφ) := by
  refine IsZariskiLocalAtTarget.of_iSup_eq_top _ (iSup_pullbackChart π h) fun P => ?_
  obtain ⟨W, W', hW'⟩ := P
  have hpre := preimage_pullbackChart π π' h φ hφ W.1 W'.1 hW'
  have hle : π' ⁻¹ᵁ W'.1 ≤ φ ⁻¹ᵁ (π ⁻¹ᵁ W.1) := by
    rw [← Scheme.Hom.comp_preimage, hφ, Scheme.Hom.comp_preimage]
    exact Scheme.Hom.preimage_mono _ hW'
  have : IsAffine (pullbackChart π h W.1 W'.1) := isAffineOpen_pullbackChart π h W W' hW'
  have : IsAffine (pullback.lift φ π' hφ ⁻¹ᵁ pullbackChart π h W.1 W'.1) := by
    have : IsAffineOpen (pullback.lift φ π' hφ ⁻¹ᵁ pullbackChart π h W.1 W'.1) := by
      rw [hpre]
      exact W'.2.preimage π'
    exact this
  refine IsClosedImmersion.of_surjective_of_isAffine _ ?_
  rw [morphismRestrict_appTop]
  exact surjective_app_eqToHom _ _ _ (Scheme.Opens.ι_image_top _) _ _ _ hpre
    (surjective_appLE_pullbackChart π π' h φ hφ W.1 W'.1 hW' hle hpre.ge (hgen W W' hW' hle))

end ClosedImmersion

section Deformation

variable {U U' : Scheme.{u}} (h : U' ⟶ U) (J : U.IdealSheafData)

/-- The structure morphism `D(ℐ) ⟶ U` of the deformation space is affine. -/
instance isAffineHom_deformationSpaceToBase (I : U.IdealSheafData) :
    IsAffineHom (deformationSpaceToBase I) :=
  inferInstanceAs (IsAffineHom (relativeSpecToBase (extReesAlgebraSheaf I)))

/-- The morphism of deformation spaces `D(h⁻¹ℐ) ⟶ D(ℐ)` over `h`. -/
abbrev deformationBaseChangeMap : deformationSpace (J.comap h) ⟶ deformationSpace J :=
  deformationMap h J (J.comap h) le_rfl

/-- The morphism `D(h⁻¹ℐ) ⟶ D(ℐ)` lies over `h : U' ⟶ U`. -/
theorem deformationBaseChangeMap_toBase :
    deformationBaseChangeMap h J ≫ deformationSpaceToBase J =
      deformationSpaceToBase (J.comap h) ≫ h :=
  deformationMap_toBase h J (J.comap h) le_rfl

/-- **`D(h⁻¹ℐ) ⟶ D(ℐ) ×_U U'` is a closed immersion.** -/
instance isClosedImmersion_deformationBaseChangeLift :
    IsClosedImmersion (pullback.lift (deformationBaseChangeMap h J)
      (deformationSpaceToBase (J.comap h)) (deformationBaseChangeMap_toBase h J)) :=
  isClosedImmersion_lift_of_adjoin _ _ h _ _ fun W W' hW' hle =>
    adjoin_range_deformationMap_appLE h J (J.comap h) rfl W W' hW' hle

/-- A point of `D(ℐ)` lies in the complement of the special fibre if and only if it is not in the
support of the zero scheme of the parameter `t⁻¹`. -/
theorem mem_complementOpen_iff (I : U.IdealSheafData) (x : deformationSpace I) :
    x ∈ complementOpen I ↔
      x ∉ (Stacks.Divisors.zeroScheme (deformationSpace I) (Scheme.unitModule (deformationSpace I))
        (paramGlobal I)).support := by
  have h := congrArg (fun S : Set (deformationSpace I) => x ∈ S) (range_zeroScheme_paramGlobal I)
  simp only [Scheme.IdealSheafData.range_subschemeι, Scheme.Opens.range_ι, Set.mem_compl_iff] at h
  change x ∈ (complementOpen I : Set (deformationSpace I)) ↔ ¬ x ∈
    ((Stacks.Divisors.zeroScheme (deformationSpace I) (Scheme.unitModule (deformationSpace I))
      (paramGlobal I)).support : Set (deformationSpace I))
  rw [h, not_not]

/-- **The complement of the special fibre is the inverse image of the complement of the special
fibre.** -/
theorem preimage_complementOpen :
    deformationBaseChangeMap h J ⁻¹ᵁ complementOpen J = complementOpen (J.comap h) := by
  ext x
  change deformationBaseChangeMap h J x ∈ complementOpen J ↔ x ∈ complementOpen (J.comap h)
  rw [mem_complementOpen_iff, mem_complementOpen_iff,
    ← comap_zeroScheme_paramGlobal h J (J.comap h) le_rfl, Scheme.IdealSheafData.support_comap]
  rfl

end Deformation

end Stacks.Deformation

end
