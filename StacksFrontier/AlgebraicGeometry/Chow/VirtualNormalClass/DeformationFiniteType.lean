module

public import StacksFrontier.AlgebraicGeometry.DeformationNormalCone.ChartGeneration
public import StacksFrontier.AlgebraicGeometry.DeformationNormalCone.ConormalNaturality

/-!
# The deformation space of a finitely generated ideal is of finite type

Let `ℐ` be a quasi-coherent ideal sheaf on a scheme `X` and `D = Spec_X(𝒪_X[t⁻¹, ℐt])` its
deformation space. If over an affine open `W` the ideal `ℐ(W)` is generated by `a₁, …, aₙ`, then
the functions on the chart `π⁻¹W` are generated over `Γ(X, W)` by `t⁻¹` and `a₁t, …, aₙt`: a
section of degree `k < 0` is a function times `(t⁻¹)^{-k}`, and a section of degree `k ≥ 0` is a
sum of functions times monomials of degree `k` in the `aᵢt`. In particular, over a locally
Noetherian base the deformation space is locally of finite type.

## Main results

* `Stacks.Deformation.adjoin_param_gens_eq_top` — the generation statement.
* `Stacks.Deformation.locallyOfFiniteType_deformationSpaceToBase_of_isLocallyNoetherian`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace

universe u

namespace Stacks.Deformation

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- **The functions on the chart `π⁻¹W` are generated over `Γ(X, W)` by `t⁻¹` and `a t` for `a`
ranging over a generating set of `ℐ(W)`.** -/
theorem adjoin_param_gens_eq_top (W : X.affineOpens) (T : Set Γ(X, W.1))
    (hspan : I.ideal W = Ideal.span T) :
    letI : Algebra Γ(X, W.1) Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ W.1) :=
      ((deformationSpaceToBase I).appLE W.1 (deformationSpaceToBase I ⁻¹ᵁ W.1) le_rfl).hom.toAlgebra
    Algebra.adjoin Γ(X, W.1) (insert (paramChartOf I W.1)
      ((fun a : T => chartIncl I 1 W.1 (extReesOfMem I W 1 a
        (by rw [pow_one, hspan]; exact Ideal.subset_span a.2))) '' Set.univ)) = ⊤ := by
  let : Algebra Γ(X, W.1) Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ W.1) :=
    ((deformationSpaceToBase I).appLE W.1 (deformationSpaceToBase I ⁻¹ᵁ W.1) le_rfl).hom.toAlgebra
  set S := Algebra.adjoin Γ(X, W.1) (insert (paramChartOf I W.1)
      ((fun a : T => chartIncl I 1 W.1 (extReesOfMem I W 1 a
        (by rw [pow_one, hspan]; exact Ideal.subset_span a.2))) '' Set.univ))
  have hs : paramChartOf I W.1 ∈ S := Algebra.subset_adjoin (Set.mem_insert _ _)
  have halg : ∀ r : Γ(X, W.1), chartIncl I 0 W.1 (extReesOfMem I W 0 r (by simp)) ∈ S :=
    fun r => (toBase_appLE_eq_chartIncl I W r) ▸ S.algebraMap_mem r
  -- closure of the generated subalgebra under sums and products of homogeneous sections
  have hadd : ∀ (n : ℕ) (a b : Γ(X, W.1)) (ha : a ∈ I.ideal W ^ n) (hb : b ∈ I.ideal W ^ n)
      (hab : a + b ∈ I.ideal W ^ n), chartIncl I n W.1 (extReesOfMem I W n a ha) ∈ S →
      chartIncl I n W.1 (extReesOfMem I W n b hb) ∈ S →
      chartIncl I n W.1 (extReesOfMem I W n (a + b) hab) ∈ S := by
    intro n a b ha hb hab h₁ h₂
    have hsplit : chartIncl I n W.1 (extReesOfMem I W n (a + b) hab) =
        chartIncl I n W.1 (extReesOfMem I W n a ha) +
          chartIncl I n W.1 (extReesOfMem I W n b hb) := by
      rw [← chartRingHom_incl, ← chartRingHom_incl, ← chartRingHom_incl, ← map_add,
        ← Stacks.GradedAlgebra.incl_add]
      congr 2
      exact extReesAmbient_injective I _ W.1 ((extReesAmbient_extReesOfMem I W n _ hab).trans
        ((congrArg₂ (· + ·) (extReesAmbient_extReesOfMem I W n a ha).symm
          (extReesAmbient_extReesOfMem I W n b hb).symm).trans
          (extReesAmbient_add I _ W.1 _ _).symm))
    rw [hsplit]
    exact S.add_mem h₁ h₂
  have hmul : ∀ (m n : ℕ) (x y : Γ(X, W.1)) (hx : x ∈ I.ideal W ^ m) (hy : y ∈ I.ideal W ^ n)
      (hxy : x * y ∈ I.ideal W ^ (m + n)), chartIncl I m W.1 (extReesOfMem I W m x hx) ∈ S →
      chartIncl I n W.1 (extReesOfMem I W n y hy) ∈ S →
      chartIncl I ((m + n : ℕ) : ℤ) W.1 (extReesOfMem I W (m + n) (x * y) hxy) ∈ S := by
    intro m n x y hx hy hxy h₁ h₂
    have hprod : chartIncl I ((m + n : ℕ) : ℤ) W.1 (extReesOfMem I W (m + n) (x * y) hxy) =
        chartIncl I m W.1 (extReesOfMem I W m x hx) *
          chartIncl I n W.1 (extReesOfMem I W n y hy) := by
      rw [chartIncl_mul]
      refine chartIncl_congr I (Nat.cast_add m n) W.1 _ _ ?_
      exact (extReesAmbient_extReesOfMem I W (m + n) _ hxy).trans
        ((congrArg₂ (· * ·) (extReesAmbient_extReesOfMem I W m x hx).symm
          (extReesAmbient_extReesOfMem I W n y hy).symm).trans
          (extReesAmbient_extReesMul I m n W.1 _ _).symm)
    rw [hprod]
    exact S.mul_mem h₁ h₂
  -- degree one
  have hone : ∀ (g : Γ(X, W.1)) (hg : g ∈ I.ideal W ^ 1),
      chartIncl I 1 W.1 (extReesOfMem I W 1 g hg) ∈ S := by
    intro g hg
    have hpow : ∀ c ∈ Ideal.span T, c ∈ I.ideal W ^ 1 := fun c hc => by
      rw [pow_one, hspan]; exact hc
    have hg' : g ∈ Ideal.span T := by rw [← hspan, ← pow_one (I.ideal W)]; exact hg
    induction hg' using Submodule.span_induction with
    | mem a ha =>
      exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ ⟨⟨a, ha⟩, Set.mem_univ _, rfl⟩)
    | zero =>
      have : extReesOfMem I W 1 0 hg = 0 := extReesAmbient_injective I 1 W.1
        ((extReesAmbient_extReesOfMem I W 1 0 hg).trans (extReesAmbient_zero I 1 W.1).symm)
      rw [this, ← chartRingHom_incl, Stacks.GradedAlgebra.incl_zero, map_zero]
      exact S.zero_mem
    | add a b ha hb iha ihb =>
      exact hadd 1 a b (hpow a ha) (hpow b hb) hg (iha _) (ihb _)
    | smul r a ha iha =>
      exact hmul 0 1 r a (by simp) (hpow a ha) hg (halg r) (iha _)
  -- all nonnegative degrees
  have hpos : ∀ (n : ℕ) (g : Γ(X, W.1)) (hg : g ∈ I.ideal W ^ n),
      chartIncl I n W.1 (extReesOfMem I W n g hg) ∈ S := by
    intro n
    induction n with
    | zero => intro g hg; exact halg g
    | succ n ih =>
      intro g hg
      have hg' : g ∈ I.ideal W ^ n * I.ideal W := by rw [← pow_succ]; exact hg
      suffices key : g ∈ I.ideal W ^ (n + 1) ∧ ∀ hr : g ∈ I.ideal W ^ (n + 1),
          chartIncl I ((n + 1 : ℕ) : ℤ) W.1 (extReesOfMem I W (n + 1) g hr) ∈ S from key.2 hg
      refine Submodule.mul_induction_on (C := fun r => r ∈ I.ideal W ^ (n + 1) ∧
        ∀ hr : r ∈ I.ideal W ^ (n + 1),
          chartIncl I ((n + 1 : ℕ) : ℤ) W.1 (extReesOfMem I W (n + 1) r hr) ∈ S) hg' ?_ ?_
      · intro x hx y hy
        have hxy : x * y ∈ I.ideal W ^ (n + 1) := by
          rw [pow_succ]; exact Submodule.mul_mem_mul hx hy
        have hy1 : y ∈ I.ideal W ^ 1 := by rw [pow_one]; exact hy
        exact ⟨hxy, fun hr => hmul n 1 x y hx hy1 hr (ih x hx) (hone y hy1)⟩
      · rintro a b ⟨ha', iha⟩ ⟨hb', ihb⟩
        exact ⟨add_mem ha' hb', fun hr => hadd (n + 1) a b ha' hb' hr (iha ha') (ihb hb')⟩
  suffices hall : ∀ y, y ∈ S from eq_top_iff.2 fun y _ => hall y
  intro y
  induction y using chartIncl_induction I W with
  | h0 => exact S.zero_mem
  | hadd a b ha hb => exact S.add_mem ha hb
  | hincl k x =>
    rcases lt_or_ge k 0 with hk | hk
    · obtain ⟨z, hz, hza⟩ := pow_chartIncl_eq I W (-1) (paramPiece I W.1) (-k).toNat
      have : chartIncl I k W.1 x = algebraMap Γ(X, W.1) _ (extReesAmbient I k W.1 x) *
          paramChartOf I W.1 ^ (-k).toNat := by
        rw [paramChartOf_eq_chartIncl, hz]
        change _ = ((deformationSpaceToBase I).appLE W.1 _ le_rfl).hom _ * _
        rw [toBase_appLE_eq_chartIncl, chartIncl_mul]
        refine chartIncl_congr I (by omega) W.1 _ _ ?_
        refine Eq.trans ?_ (extReesAmbient_extReesMul I 0 _ W.1 _ z).symm
        refine Eq.trans ?_ (congrArg₂ (· * ·) (extReesAmbient_extReesOfMem I W 0 _ _).symm hza.symm)
        rw [extReesAmbient_paramPiece, one_pow, mul_one]
      rw [this]
      exact S.mul_mem (S.algebraMap_mem _) (S.pow_mem hs _)
    · obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hk
      have hmem := Stacks.Blowup.reesPieceAmbient_mem_affine I (n : ℤ) (Int.natCast_nonneg n) W x
      rw [Int.toNat_natCast] at hmem
      have hx : x = extReesOfMem I W n _ hmem :=
        extReesAmbient_injective I n W.1 (extReesAmbient_extReesOfMem I W n _ hmem).symm
      rw [hx]
      exact hpos n _ hmem

variable {I} in
/-- **The deformation space of an ideal which is finitely generated over every affine open is
locally of finite type over the base.** -/
theorem locallyOfFiniteType_deformationSpaceToBase_of_fg
    (hI : ∀ W : X.affineOpens, (I.ideal W).FG) :
    LocallyOfFiniteType (deformationSpaceToBase I) := by
  classical
  refine (HasRingHomProperty.iff_exists_appLE (P := @LocallyOfFiniteType)
    (RingHom.finiteType_stableUnderComposition.stableUnderCompositionWithLocalizationAway
      RingHom.finiteType_holdsForLocalizationAway).left).2 fun x => ?_
  obtain ⟨W, hW⟩ := Stacks.Divisors.exists_affineOpens_mem (deformationSpaceToBase I x)
  obtain ⟨T, hT⟩ := hI W
  refine ⟨W, ⟨deformationSpaceToBase I ⁻¹ᵁ W.1,
    Stacks.RelativeSpec.isAffineOpen_toBase_preimage (extReesSituation I) W⟩, hW, le_rfl, ?_⟩
  let : Algebra Γ(X, W.1) Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ W.1) :=
    ((deformationSpaceToBase I).appLE W.1 (deformationSpaceToBase I ⁻¹ᵁ W.1) le_rfl).hom.toAlgebra
  have hspan : I.ideal W = Ideal.span (T : Set Γ(X, W.1)) := hT.symm
  have hfin : (insert (paramChartOf I W.1)
      ((fun a : (T : Set Γ(X, W.1)) => chartIncl I 1 W.1 (extReesOfMem I W 1 a
        (by rw [pow_one, hspan]; exact Ideal.subset_span a.2))) '' Set.univ)).Finite :=
    (Set.finite_univ.image _).insert _
  exact ⟨⟨hfin.toFinset, by
    rw [Set.Finite.coe_toFinset]; exact adjoin_param_gens_eq_top I W _ hspan⟩⟩

/-- **Over a locally Noetherian base, the deformation space is locally of finite type.** -/
theorem locallyOfFiniteType_deformationSpaceToBase_of_isLocallyNoetherian [IsLocallyNoetherian X] :
    LocallyOfFiniteType (deformationSpaceToBase I) :=
  locallyOfFiniteType_deformationSpaceToBase_of_fg fun W =>
    have := IsLocallyNoetherian.component_noetherian W
    (IsNoetherian.noetherian (I.ideal W))

end Stacks.Deformation

end
