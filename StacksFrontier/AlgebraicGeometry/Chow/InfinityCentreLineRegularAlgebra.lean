module

public import StacksFrontier.AlgebraicGeometry.Chow.NormalConeZeroSection
public import StacksFrontier.AlgebraicGeometry.Crystalline.DividedPowerEnvelope.SingleRelation
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularIdealSheaf.RegularToQuasiRegular
public import StacksFrontier.RingTheory.Sequence.QuasiRegular.MonomialComparison
public import StacksFrontier.RingTheory.Sequence.Regular.Basic

/-!
# The ratios `fᵢ/s` on the chart `D₊(S)` of the blowup at infinity

Let `A` be a commutative ring, `f₁, …, f_r ∈ A` and `I = (f₁, …, f_r)`. On the chart
`B = A[s][J/s]`, `J = (I, s)`, of the blowup at infinity (`Stacks.Chow.infinityChartAlgebra`) the
ratios `yᵢ = fᵢ/s` are defined, and `s yᵢ = fᵢ`. This file proves:

* the ideal `(y₁, …, y_r)` of `B` is the kernel of every ring map `φ : B ⟶ C` along which
  `A[s] ⟶ B ⟶ C` is surjective with kernel `I · A[s]`; that is, `(y)` cuts out `(A/I)[s]`;
* if `f₁, …, f_r` is a regular sequence, so is `y₁, …, y_r`.

Both rest on the description of `(y₁, …, y_k)` inside `B ⊆ A[s, 1/s]` as the trace of
`(f₁, …, f_k) · A[s, 1/s]`, valid when `f` is quasi-regular.

## Main results

* `Stacks.Chow.pow_succ_inf_span_image_le`: for a quasi-regular sequence `f` and any subfamily
  `f_S`, `I^{m+1} ∩ (f_S) ⊆ (f_S) · I^m` (the reverse inclusion being clear).
* `Stacks.Chow.mem_infinityChartResidualIdeal_iff`: the description of the ideal generated by the
  ratios `a/s`, `a ∈ I'`, as the trace on `B` of `I' · A[s, 1/s]`.
* `Stacks.Chow.ker_eq_span_infinityChartRatio`: the ratios cut out `(A/I)[s]`.
* `Stacks.Chow.isWeaklyRegular_infinityChartRatio`: the ratios of a regular sequence form a
  regular sequence.

## References

* [Stacks Project, Tag 0FEG](https://stacks.math.columbia.edu/tag/0FEG)
* [Stacks Project, Tag 0BIQ](https://stacks.math.columbia.edu/tag/0BIQ)
* [Stacks Project, Tag 061M](https://stacks.math.columbia.edu/tag/061M)
-/

@[expose] public noncomputable section

open Polynomial RingTheory.Sequence

namespace Stacks.Chow

variable {A : Type*} [CommRing A]

/-! ### Powers of the ideal of a quasi-regular sequence -/

section QuasiRegular

variable {r : ℕ} (f : Fin r → A)

/-- Let `f₁, …, f_r` be a quasi-regular sequence generating `I` and `S` a set of indices. An
element of `(f_i, i ∈ S)` lying in `I^{m+1}` lies in `(f_i, i ∈ S) · I^m`. -/
theorem pow_succ_inf_span_image_le
    (hf : Function.Injective (quasiRegularCanonicalMap (M := A) f)) (S : Set (Fin r)) (m : ℕ) :
    Ideal.span (Set.range f) ^ (m + 1) ⊓ Ideal.span (f '' S) ≤
      Ideal.span (f '' S) * Ideal.span (Set.range f) ^ m := by
  classical
  rintro x ⟨hxm, hxS⟩
  have hJ : Ideal.span (Set.range f) = Jid f := rfl
  suffices h : ∀ d, d ≤ m → x ∈ Ideal.span (f '' S) * Ideal.span (Set.range f) ^ d from
    h m le_rfl
  intro d
  induction d with
  | zero => intro _; simpa using hxS
  | succ d ih =>
    intro hd
    have hx := ih (by omega)
    rw [hJ, Jid_pow_eq_span, Ideal.span_mul_span] at hx
    obtain ⟨n, c, g, hsum⟩ := (Submodule.mem_span_set' (R := A)).mp hx
    have hg : ∀ t, ∃ i ∈ S, ∃ e : Fin r →₀ ℕ, qrMdeg e = d ∧
        (g t : A) = fpow f (e + Finsupp.single i 1) := by
      intro t
      obtain ⟨a, ⟨i, hi, rfl⟩, b, ⟨e, he, rfl⟩, hab⟩ := Set.mem_mul.mp (g t).2
      exact ⟨i, hi, e, he, by rw [fpow_add_single, ← hab]⟩
    choose i hi e he hge using hg
    let D : Fin n → (Fin r →₀ ℕ) := fun t => e t + Finsupp.single (i t) 1
    have hdeg : ∀ t ∈ (Finset.univ : Finset (Fin n)), qrMdeg (D t) = d + 1 := fun t _ => by
      simp only [D, qrMdeg_addSingle, he]
    have hxsum : x = ∑ t, fpow f (D t) • c t := by
      rw [← hsum]
      refine Finset.sum_congr rfl fun t _ => ?_
      rw [hge t, smul_eq_mul, smul_eq_mul, mul_comm]
    have hrel : (∑ t, fpow f (D t) • c t) ∈ JpowM A f (d + 1 + 1) := by
      rw [← hxsum, JpowM, Ideal.smul_eq_mul, Ideal.mul_top, ← hJ]
      exact Ideal.pow_le_pow_right (by omega) hxm
    have hfib := sum_filter_mem_of_injective hf (d + 1) Finset.univ D c hdeg hrel
    have hfib' : ∀ e', (∑ t with D t = e', c t) ∈ Ideal.span (Set.range f) := fun e' => by
      have := hfib e'
      rwa [Ideal.smul_eq_mul, Ideal.mul_top] at this
    rw [hxsum, ← Finset.sum_fiberwise_of_maps_to (g := D) (t := Finset.univ.image D)
      (fun t _ => Finset.mem_image_of_mem D (Finset.mem_univ t))]
    refine Ideal.sum_mem _ fun e' he' => ?_
    obtain ⟨t₀, -, ht₀⟩ := Finset.mem_image.mp he'
    have hsplit : (∑ t with D t = e', fpow f (D t) • c t) =
        fpow f e' * ∑ t with D t = e', c t := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun t ht => ?_
      rw [(Finset.mem_filter.mp ht).2, smul_eq_mul]
    rw [hsplit, pow_succ, ← mul_assoc]
    refine Ideal.mul_mem_mul ?_ (hfib' e')
    rw [← ht₀]
    change fpow f (e t₀ + Finsupp.single (i t₀) 1) ∈ _
    rw [fpow_add_single]
    have h2 : fpow f (e t₀) ∈ Jid f ^ d := he t₀ ▸ fpow_mem f (e t₀)
    exact Ideal.mul_mem_mul (Ideal.subset_span ⟨i t₀, hi t₀, rfl⟩) h2

/-- For a regular sequence, the canonical map of the quasi-regularity condition is injective:
a regular sequence is quasi-regular. -/
theorem injective_quasiRegularCanonicalMap_of_isWeaklyRegular
    (hf : IsWeaklyRegular A (List.ofFn f)) :
    Function.Injective (quasiRegularCanonicalMap (M := A) f) :=
  ((Quasiregular.bijective_quasiRegularCanonicalMap_iff_isQuasiRegular (M := A) f).mpr
    (Stacks.AlgebraicGeometry.RegularIdealSheaf.isQuasiRegular_ofFn_of_isWeaklyRegular f hf)).1

end QuasiRegular

/-! ### Ideals of `A[s]` and of `A[s, 1/s]` extended from `A` -/

section Extended

/-- A polynomial whose image in `A[s, 1/s]` lies in `K · A[s, 1/s]`, `K ⊆ A` an ideal, lies in
`K · A[s]`. -/
theorem mem_map_C_of_algebraMap_mem {K : Ideal A} {p : A[X]}
    (h : algebraMap A[X] (Localization.Away (X : A[X])) p ∈
      (K.map (C : A →+* A[X])).map (algebraMap A[X] (Localization.Away (X : A[X])))) :
    p ∈ K.map (C : A →+* A[X]) := by
  obtain ⟨⟨⟨a, ha⟩, ⟨m, hm⟩⟩, hpm⟩ :=
    (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers (X : A[X])) _).mp h
  dsimp only at hpm
  rw [← map_mul] at hpm
  obtain ⟨⟨c, hc⟩, hcm⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers (X : A[X])) _).mp hpm
  obtain ⟨k, rfl⟩ := hc
  obtain ⟨l, rfl⟩ := hm
  refine Crystalline.mem_map_C_of_mul_monic K (monic_X_pow (k + l)) ?_
  dsimp only at hcm
  have hkl : p * (X : A[X]) ^ (k + l) = (X : A[X]) ^ k * a := by rw [← hcm]; ring
  rw [hkl]
  exact Ideal.mul_mem_left _ _ ha

/-- An element `a` of `A` which is a nonzerodivisor modulo an ideal `K` of `A` stays one modulo
`K · A[s, 1/s]`. -/
theorem mem_map_of_algebraMap_C_mul_mem {K : Ideal A} {a : A}
    (ha : ∀ x : A, a * x ∈ K → x ∈ K) {z : Localization.Away (X : A[X])}
    (hz : algebraMap A[X] _ (C a) * z ∈
      (K.map (C : A →+* A[X])).map (algebraMap A[X] (Localization.Away (X : A[X])))) :
    z ∈ (K.map (C : A →+* A[X])).map (algebraMap A[X] (Localization.Away (X : A[X]))) := by
  obtain ⟨⟨q, m⟩, hzq⟩ := IsLocalization.surj (Submonoid.powers (X : A[X])) z
  have hz' : z = IsLocalization.mk' (Localization.Away (X : A[X])) q m :=
    IsLocalization.eq_mk'_iff_mul_eq.mpr hzq
  have hq : C a * q ∈ K.map (C : A →+* A[X]) := by
    refine mem_map_C_of_algebraMap_mem ?_
    have := Ideal.mul_mem_right (algebraMap A[X] (Localization.Away (X : A[X])) (m : A[X])) _ hz
    rwa [mul_assoc, hzq, ← map_mul] at this
  have hq' : q ∈ K.map (C : A →+* A[X]) := by
    rw [Ideal.mem_map_C_iff] at hq ⊢
    intro j
    exact ha _ (by simpa [coeff_C_mul] using hq j)
  rw [hz', IsLocalization.mk'_eq_mul_mk'_one]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hq')

end Extended

/-! ### The ideal of the ratios on the chart -/

section Chart

variable {I I' : Ideal A}

/-- Every element of the chart `A[s][J/s]` is a fraction `p/sⁿ` with `p ∈ Jⁿ`. -/
theorem exists_eq_infinityChartMk (b : infinityChartAlgebra I) :
    ∃ (n : ℕ) (p : A[X]) (hp : p ∈ infinityChartIdeal I ^ n), b = infinityChartMk I n p hp := by
  obtain ⟨n, p, hp, hb⟩ := (affineBlowup_mem_iff (infinityChartIdeal I) (X : A[X])
    (X_mem_infinityChartIdeal _) b.1).mp b.2
  exact ⟨n, p, hp, Subtype.ext hb⟩

/-- The ideal `I' · A[s] ⊆ A[s]`, `I' ⊆ I`, is contained in `J = (I, s)`. -/
theorem map_C_le_infinityChartIdeal_pow_one (h : I' ≤ I) :
    I'.map (C : A →+* A[X]) ≤ infinityChartIdeal I ^ 1 := by
  rw [pow_one]
  exact (Ideal.map_mono h).trans le_sup_left

/-- For an ideal `𝔞` of the chart containing the ratios `t/s` of a set `T` with `(T) ⊆ I`, the
ratio `a/s` of every `a ∈ (T) · A[s]` lies in `𝔞`. -/
theorem infinityChartMk_one_mem_of_mem_map_span {T : Set A} (hT : Ideal.span T ≤ I)
    (𝔞 : Ideal (infinityChartAlgebra I))
    (h𝔞 : ∀ t ∈ T, ∀ ht, infinityChartMk I 1 (C t) ht ∈ 𝔞) {a : A[X]}
    (ha : a ∈ (Ideal.span T).map (C : A →+* A[X])) (ha1 : a ∈ infinityChartIdeal I ^ 1) :
    infinityChartMk I 1 a ha1 ∈ 𝔞 := by
  have hle := map_C_le_infinityChartIdeal_pow_one hT
  rw [Ideal.map_span] at ha
  induction ha using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨t, ht, rfl⟩ := hx
    exact h𝔞 t ht ha1
  | zero => rw [infinityChartMk_zero]; exact zero_mem _
  | add x y hx hy ihx ihy =>
    have hx' : x ∈ infinityChartIdeal I ^ 1 := hle (by rwa [Ideal.map_span])
    have hy' : y ∈ infinityChartIdeal I ^ 1 := hle (by rwa [Ideal.map_span])
    rw [← infinityChartMk_add hx' hy']
    exact add_mem (ihx hx') (ihy hy')
  | smul c x hx ihx =>
    have hx' : x ∈ infinityChartIdeal I ^ 1 := hle (by rwa [Ideal.map_span])
    have heq : infinityChartMk I 1 (c • x) ha1 =
        algebraMap A[X] (infinityChartAlgebra I) c * infinityChartMk I 1 x hx' := by
      rw [algebraMap_eq_infinityChartMk, infinityChartMk_mul]
      exact infinityChartMk_congr (by omega) (smul_eq_mul c x)
    rw [heq]
    exact Ideal.mul_mem_left _ _ (ihx hx')

/-- The ratios `q/s^{n+1}` with `q ∈ (I' · A[s]) · Jⁿ` lie in the ideal generated by the ratios
`a/s`, `a ∈ I'`. -/
theorem infinityChartMk_succ_mem_infinityChartResidualIdeal (h : I' ≤ I) {n : ℕ} {q : A[X]}
    (hq : q ∈ I'.map (C : A →+* A[X]) * infinityChartIdeal I ^ n)
    (hq' : q ∈ infinityChartIdeal I ^ (n + 1)) :
    infinityChartMk I (n + 1) q hq' ∈ infinityChartResidualIdeal I I' h := by
  have hle := map_C_le_infinityChartIdeal_pow_one h
  induction hq using Submodule.mul_induction_on' with
  | mem_mul_mem a ha z hz =>
    have heq : infinityChartMk I (n + 1) (a * z) hq' =
        infinityChartMk I 1 a (hle ha) * infinityChartMk I n z hz := by
      rw [infinityChartMk_mul]
      exact infinityChartMk_congr (by omega) rfl
    rw [heq]
    refine Ideal.mul_mem_right _ _ ?_
    refine infinityChartMk_one_mem_of_mem_map_span (T := I') (by rw [Ideal.span_eq]; exact h) _
      (by intro t ht ht1; exact Ideal.subset_span ⟨⟨t, ht⟩, rfl⟩) (by rwa [Ideal.span_eq]) _
  | add x hx y hy ihx ihy =>
    have hx' : x ∈ infinityChartIdeal I ^ (n + 1) := by
      rw [pow_succ']; exact Ideal.mul_mono_left (hle.trans (pow_one _).le) hx
    have hy' : y ∈ infinityChartIdeal I ^ (n + 1) := by
      rw [pow_succ']; exact Ideal.mul_mono_left (hle.trans (pow_one _).le) hy
    rw [← infinityChartMk_add hx' hy']
    exact add_mem (ihx hx') (ihy hy')

/-- If `I^{m+1} ∩ I' ⊆ I' I^m` for all `m`, a polynomial `p ∈ Jⁿ ∩ I' · A[s]` has
`p s ∈ (I' · A[s]) · Jⁿ`. -/
theorem mul_X_mem_map_C_mul_pow (hF : ∀ m, I ^ (m + 1) ⊓ I' ≤ I' * I ^ m) {n : ℕ} {p : A[X]}
    (hp : p ∈ infinityChartIdeal I ^ n) (hpI : p ∈ I'.map (C : A →+* A[X])) :
    p * (X : A[X]) ∈ I'.map (C : A →+* A[X]) * infinityChartIdeal I ^ n := by
  rw [as_sum_support_C_mul_X_pow p, Finset.sum_mul]
  refine Ideal.sum_mem _ fun j _ => ?_
  have hc1 : p.coeff j ∈ I ^ (n - j) := mem_pow_infinityChartIdeal_iff.mp hp j
  have hc2 : p.coeff j ∈ I' := Ideal.mem_map_C_iff.mp hpI j
  have hc : p.coeff j ∈ I' * I ^ (n - (j + 1)) := by
    by_cases hj : j + 1 ≤ n
    · refine hF _ ⟨?_, hc2⟩
      rwa [show n - (j + 1) + 1 = n - j by omega]
    · rw [show n - (j + 1) = 0 by omega, pow_zero, Ideal.one_eq_top, Ideal.mul_top]
      exact hc2
  have hC : (C (p.coeff j) : A[X]) ∈
      I'.map (C : A →+* A[X]) * infinityChartIdeal I ^ (n - (j + 1)) := by
    have h1 := Ideal.mem_map_of_mem (C : A →+* A[X]) hc
    rw [Ideal.map_mul, Ideal.map_pow] at h1
    exact Ideal.mul_mono_right (Ideal.pow_right_mono le_sup_left _) h1
  have hX : (X : A[X]) ^ j * (X : A[X]) ∈ infinityChartIdeal I ^ (j + 1) := by
    rw [← pow_succ]; exact X_pow_mem_pow_infinityChartIdeal I (j + 1)
  have h2 := Ideal.mul_mem_mul hC hX
  rw [mul_assoc, ← pow_add] at h2
  rw [mul_assoc]
  exact Ideal.mul_mono_right (Ideal.pow_le_pow_right (by omega)) h2

/-- Let `I' ⊆ I` with `I^{m+1} ∩ I' ⊆ I' I^m` for every `m`. An element of the chart
`A[s][J/s] ⊆ A[s, 1/s]` lies in the ideal generated by the ratios `a/s`, `a ∈ I'`, exactly when it
lies in `I' · A[s, 1/s]`. -/
theorem mem_infinityChartResidualIdeal_iff (h : I' ≤ I)
    (hF : ∀ m, I ^ (m + 1) ⊓ I' ≤ I' * I ^ m) (b : infinityChartAlgebra I) :
    b ∈ infinityChartResidualIdeal I I' h ↔
      (b : Localization.Away (X : A[X])) ∈
        (I'.map (C : A →+* A[X])).map (algebraMap A[X] (Localization.Away (X : A[X]))) := by
  constructor
  · intro hb
    have hle : infinityChartResidualIdeal I I' h ≤
        ((I'.map (C : A →+* A[X])).map (algebraMap A[X] (Localization.Away (X : A[X])))).comap
          (infinityChartAlgebra I).val.toRingHom := by
      rw [infinityChartResidualIdeal, Ideal.span_le]
      rintro _ ⟨⟨a, ha⟩, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_comap]
      change (infinityChartMk I 1 (C a) (C_mem_infinityChartIdeal_pow_one (h ha)) :
        Localization.Away (X : A[X])) ∈ _
      rw [infinityChartMk_val, Localization.mk_eq_mk', IsLocalization.mk'_eq_mul_mk'_one]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ ha))
    exact hle hb
  · intro hb
    obtain ⟨n, p, hp, rfl⟩ := exists_eq_infinityChartMk b
    have hpI : p ∈ I'.map (C : A →+* A[X]) := by
      refine mem_map_C_of_algebraMap_mem ?_
      have := Ideal.mul_mem_right
        (algebraMap A[X] (Localization.Away (X : A[X])) ((X : A[X]) ^ n)) _ hb
      rwa [infinityChartMk_val, Localization.mk_eq_mk', IsLocalization.mk'_spec] at this
    have hq := mul_X_mem_map_C_mul_pow hF hp hpI
    rw [infinityChartMk_shift hp 1]
    exact infinityChartMk_succ_mem_infinityChartResidualIdeal h (by rwa [pow_one]) _

end Chart

/-! ### The ratios of a sequence -/

section Ratio

variable {r : ℕ} (f : Fin r → A) {I : Ideal A} (hf : ∀ i, f i ∈ I)

/-- The ratio `fᵢ/s` on the chart `A[s][J/s]`, `J = (I, s)`, for `fᵢ ∈ I`. -/
abbrev infinityChartRatio (i : Fin r) : infinityChartAlgebra I :=
  infinityChartMk I 1 (C (f i)) (C_mem_infinityChartIdeal_pow_one (hf i))

/-- `s · (fᵢ/s) = fᵢ` on the chart. -/
theorem algebraMap_X_mul_infinityChartRatio (i : Fin r) :
    algebraMap A[X] (infinityChartAlgebra I) (X : A[X]) * infinityChartRatio f hf i =
      algebraMap A[X] (infinityChartAlgebra I) (C (f i)) :=
  (algebraMap_C_eq_X_mul_infinityChartMk (hf i)).symm

include hf in
/-- The ideal `(fᵢ, i ∈ S)` is contained in `I`. -/
theorem span_image_le_of_forall_mem (S : Set (Fin r)) : Ideal.span (f '' S) ≤ I :=
  Ideal.span_le.mpr (by rintro _ ⟨i, -, rfl⟩; exact hf i)

/-- The ratios `fᵢ/s`, `i ∈ S`, generate the ideal of the ratios `a/s`, `a ∈ (f_i, i ∈ S)`. -/
theorem span_image_infinityChartRatio (S : Set (Fin r)) :
    Ideal.span (infinityChartRatio f hf '' S) =
      infinityChartResidualIdeal I (Ideal.span (f '' S)) (span_image_le_of_forall_mem f hf S) := by
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨i, hi, rfl⟩
    rw [SetLike.mem_coe, infinityChartResidualIdeal]
    exact Ideal.subset_span ⟨⟨f i, Ideal.subset_span ⟨i, hi, rfl⟩⟩, rfl⟩
  · rintro _ ⟨⟨a, ha⟩, rfl⟩
    refine infinityChartMk_one_mem_of_mem_map_span (T := f '' S)
      (span_image_le_of_forall_mem f hf S) _ ?_ (Ideal.mem_map_of_mem _ ha) _
    rintro _ ⟨i, hi, rfl⟩ _
    exact Ideal.subset_span ⟨i, hi, rfl⟩

/-- Let `φ : A[s][J/s] ⟶ C` be a ring map such that the
composite `A[s] ⟶ A[s][J/s] ⟶ C` is surjective with kernel `I · A[s]`. Then the kernel of `φ` is
generated by the ratios `a/s`, `a ∈ I`. -/
theorem ker_eq_infinityChartResidualIdeal {C' : Type*} [CommRing C'] (I : Ideal A)
    (φ : infinityChartAlgebra I →+* C')
    (hsurj : Function.Surjective (φ.comp (algebraMap A[X] _)))
    (hker : RingHom.ker (φ.comp (algebraMap A[X] _)) = I.map (C : A →+* A[X])) :
    RingHom.ker φ = infinityChartResidualIdeal I I le_rfl := by
  have hF : ∀ m, I ^ (m + 1) ⊓ I ≤ I * I ^ m := fun m => by rw [pow_succ']; exact inf_le_left
  have hreg : ∀ c : C', φ (algebraMap A[X] _ (X : A[X])) * c = 0 → c = 0 := by
    intro c hc
    obtain ⟨q, rfl⟩ := hsurj c
    have hq : q * (X : A[X]) ∈ RingHom.ker (φ.comp (algebraMap A[X] _)) := by
      rw [RingHom.mem_ker, RingHom.comp_apply, map_mul, map_mul, mul_comm]; exact hc
    rw [hker] at hq
    have := Crystalline.mem_map_C_of_mul_monic I monic_X hq
    rwa [← hker, RingHom.mem_ker] at this
  refine le_antisymm (fun b hb => ?_) ?_
  · rw [mem_infinityChartResidualIdeal_iff le_rfl hF]
    obtain ⟨n, p, hp, rfl⟩ := exists_eq_infinityChartMk b
    have hpk : p ∈ RingHom.ker (φ.comp (algebraMap A[X] _)) := by
      rw [RingHom.mem_ker, RingHom.comp_apply]
      have h1 : algebraMap A[X] (infinityChartAlgebra I) p =
          algebraMap A[X] _ ((X : A[X]) ^ n) * infinityChartMk I n p hp := by
        rw [algebraMap_eq_infinityChartMk, algebraMap_eq_infinityChartMk, infinityChartMk_mul,
          infinityChartMk_eq_iff]
        ring
      rw [h1, map_mul, RingHom.mem_ker.mp hb, mul_zero]
    rw [hker] at hpk
    rw [infinityChartMk_val, Localization.mk_eq_mk', IsLocalization.mk'_eq_mul_mk'_one]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hpk)
  · rw [infinityChartResidualIdeal, Ideal.span_le]
    rintro _ ⟨⟨a, ha⟩, rfl⟩
    refine hreg _ ?_
    rw [← map_mul, ← algebraMap_C_eq_X_mul_infinityChartMk ha, ← RingHom.comp_apply,
      ← RingHom.mem_ker, hker]
    exact Ideal.mem_map_of_mem _ ha

/-- For `I = (f₁, …, f_r)`, the ratios `f₁/s, …, f_r/s` generate the kernel of every ring map
`φ : A[s][J/s] ⟶ C` along which `A[s] ⟶ C` is surjective with kernel `I · A[s]`. -/
theorem ker_eq_span_infinityChartRatio (hI : I = Ideal.span (Set.range f)) {C' : Type*}
    [CommRing C'] (φ : infinityChartAlgebra I →+* C')
    (hsurj : Function.Surjective (φ.comp (algebraMap A[X] _)))
    (hker : RingHom.ker (φ.comp (algebraMap A[X] _)) = I.map (C : A →+* A[X])) :
    RingHom.ker φ = Ideal.span (Set.range (infinityChartRatio f hf)) := by
  have h := span_image_infinityChartRatio f hf Set.univ
  simp only [Set.image_univ, ← hI] at h
  rw [ker_eq_infinityChartResidualIdeal _ φ hsurj hker, h]

/-- If `f₁, …, f_r` is a regular sequence in `A` generating `I`, then `f₁/s, …, f_r/s` is a
regular sequence on the chart `A[s][J/s]`, `J = (I, s)`. -/
theorem isWeaklyRegular_infinityChartRatio (hI : I = Ideal.span (Set.range f))
    (hreg : IsWeaklyRegular A (List.ofFn f)) :
    IsWeaklyRegular (infinityChartAlgebra I) (List.ofFn (infinityChartRatio f hf)) := by
  have hinj := injective_quasiRegularCanonicalMap_of_isWeaklyRegular f hreg
  rw [isWeaklyRegular_iff_Fin]
  intro k
  have hk : (k : ℕ) < r := by simpa using k.2
  rw [isWeaklyRegular_iff_Fin] at hreg
  have hfk := hreg ⟨k, by simpa using hk⟩
  simp only [Fin.getElem_fin, List.getElem_ofFn, Ideal.ofList_take_ofFn, Ideal.mul_top,
    isSMulRegular_quotient_iff_mem_of_smul_mem, smul_eq_mul] at hfk ⊢
  rw [span_image_infinityChartRatio]
  set S : Set (Fin r) := ↑(Finset.univ.filter fun j : Fin r => (j : ℕ) < k)
  have hF : ∀ m, I ^ (m + 1) ⊓ Ideal.span (f '' S) ≤ Ideal.span (f '' S) * I ^ m := by
    rw [hI]; exact pow_succ_inf_span_image_le f hinj S
  intro b hb
  rw [mem_infinityChartResidualIdeal_iff _ hF] at hb ⊢
  refine mem_map_of_algebraMap_C_mul_mem (a := f ⟨k, hk⟩) (fun x hx => hfk x hx) ?_
  have := Ideal.mul_mem_left _
    (algebraMap A[X] (Localization.Away (X : A[X])) (X : A[X])) hb
  convert this using 1
  have h1 := congrArg (fun z : infinityChartAlgebra I => (z : Localization.Away (X : A[X])))
    (algebraMap_X_mul_infinityChartRatio f hf ⟨k, hk⟩)
  simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap] at h1
  rw [Subalgebra.coe_mul, ← mul_assoc, h1]

end Ratio

