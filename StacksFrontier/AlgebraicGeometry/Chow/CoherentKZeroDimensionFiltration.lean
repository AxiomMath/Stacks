module

public import StacksFrontier.AlgebraicGeometry.Chow.Degrees.CoherentSupportDimension
public import StacksFrontier.AlgebraicGeometry.Perfect.GrothendieckGroup
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The filtration of `K'₀(X)` by dimension of supports

Let `(S, δ)` be the base situation of chapter 42 of the Stacks Project and let `X` be a scheme
locally of finite type over `S`. Section 42.57 equips the Grothendieck group
`K'₀(X) = K₀(Coh(X))` of coherent `𝒪_X`-modules with the increasing filtration

  `F_k K'₀(X) = Im(K₀(Coh_{≤k}(X)) ⟶ K₀(Coh(X)))`,

the *filtration by dimension of supports*, and considers its graded pieces
`gr_k K'₀(X) = F_k K'₀(X) / F_{k-1} K'₀(X)`.

## Main definitions

* `Stacks.Chow.coherentKZeroFiltration` — the subgroup `F_k K'₀(X)`.
* `Stacks.Chow.gradedCoherentKZero` — the graded piece `gr_k K'₀(X)`.
* `Stacks.Chow.toGradedCoherentKZero` — the projection `F_k K'₀(X) ⟶ gr_k K'₀(X)`.
* `Stacks.Chow.gradedCoherentKZeroLift` — the descent of a homomorphism out of `F_k K'₀(X)`
  which vanishes on `F_{k-1} K'₀(X)`.

## Main results

* `Stacks.Chow.coherentKZeroFiltration_mono` — the filtration is increasing.
* `Stacks.Chow.coherentKZeroFiltration_le_ker` — a homomorphism out of `K'₀(X)` vanishes on
  `F_k K'₀(X)` as soon as it vanishes on the class of every coherent module whose support has
  delta-dimension at most `k`.

## Implementation notes

`F_k K'₀(X)` is defined as the subgroup generated by the classes of the coherent modules whose
support has delta-dimension at most `k` (those of `Stacks.Chow.coherentModulesDimLE`), which is
the image of `K₀(Coh_{≤k}(X))` because a Grothendieck group is generated by the classes of
objects. This avoids constructing the abelian structure on the Serre subcategory `Coh_{≤k}(X)`
and the induced map of Grothendieck groups.

## References

* [Stacks Project, Tag 0FEV](https://stacks.math.columbia.edu/tag/0FEV)
* [Stacks Project, Tag 0FDG](https://stacks.math.columbia.edu/tag/0FDG)
* [Stacks Project, Tag 02S8](https://stacks.math.columbia.edu/tag/02S8)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.Chow

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (f : X ⟶ C.S) [LocallyOfFiniteType f]
  [IsLocallyNoetherian X]

/-- The subgroup `F_k K'₀(X)` of the Grothendieck group of coherent `𝒪_X`-modules generated by
the classes of those whose support has delta-dimension at most `k`. This is the degree `k` step
of the filtration by dimension of supports of Section 42.57, the image of
`K₀(Coh_{≤k}(X))` in `K₀(Coh(X))`. -/
@[sga "6 X 1.1.1" "(X), special case"]
def coherentKZeroFiltration (k : ℤ) : AddSubgroup (CoherentKZero X) :=
  AddSubgroup.closure {x | ∃ F : CoherentModulesDimLE C f k, x = KZero.mk _ F.obj}

/-- The class of a coherent module whose support has delta-dimension at most `k` lies in
`F_k K'₀(X)`. -/
theorem mk_mem_coherentKZeroFiltration (k : ℤ) (F : CoherentModulesDimLE C f k) :
    KZero.mk _ F.obj ∈ coherentKZeroFiltration C f k :=
  AddSubgroup.subset_closure ⟨F, rfl⟩

/-- A homomorphism out of `K'₀(X)` vanishes on `F_k K'₀(X)` as soon as it vanishes on the class
of every coherent module whose support has delta-dimension at most `k`. -/
theorem coherentKZeroFiltration_le_ker {A : Type*} [AddCommGroup A]
    (θ : CoherentKZero X →+ A) (k : ℤ)
    (hθ : ∀ F : CoherentModulesDimLE C f k, θ (KZero.mk _ F.obj) = 0) :
    coherentKZeroFiltration C f k ≤ θ.ker := by
  refine (AddSubgroup.closure_le _).2 ?_
  rintro x ⟨F, rfl⟩
  exact hθ F

/-- The filtration by dimension of supports is increasing. -/
@[sga "6 X 1.1.1" "partial"]
theorem coherentKZeroFiltration_mono {k l : ℤ} (hkl : k ≤ l) :
    coherentKZeroFiltration C f k ≤ coherentKZeroFiltration C f l := by
  refine (AddSubgroup.closure_le _).2 ?_
  rintro x ⟨F, rfl⟩
  exact mk_mem_coherentKZeroFiltration C f l
    ⟨F.obj, coherentModulesDimLE_le_coherentModulesDimLE C f hkl _ F.property⟩

/-- `F_{k-1} K'₀(X)`, read as a subgroup of `F_k K'₀(X)`. -/
abbrev coherentKZeroFiltrationPred (k : ℤ) : AddSubgroup (coherentKZeroFiltration C f k) :=
  (coherentKZeroFiltration C f (k - 1)).addSubgroupOf (coherentKZeroFiltration C f k)

/-- The graded piece `gr_k K'₀(X) = F_k K'₀(X) / F_{k-1} K'₀(X)` of the filtration by dimension
of supports of Section 42.57. -/
abbrev gradedCoherentKZero (k : ℤ) : Type (u + 1) :=
  (coherentKZeroFiltration C f k) ⧸ coherentKZeroFiltrationPred C f k

/-- The projection of `F_k K'₀(X)` onto the graded piece `gr_k K'₀(X)`. -/
def toGradedCoherentKZero (k : ℤ) :
    coherentKZeroFiltration C f k →+ gradedCoherentKZero C f k :=
  QuotientAddGroup.mk' _

omit [IsLocallyNoetherian X] in
/-- Every element of `gr_k K'₀(X)` is the class of an element of `F_k K'₀(X)`. -/
theorem toGradedCoherentKZero_surjective (k : ℤ) :
    Function.Surjective (toGradedCoherentKZero C f k) :=
  QuotientAddGroup.mk'_surjective _

/-- A homomorphism out of `F_k K'₀(X)` which vanishes on `F_{k-1} K'₀(X)` descends to the graded
piece `gr_k K'₀(X)`. -/
def gradedCoherentKZeroLift {A : Type*} [AddCommGroup A] (k : ℤ)
    (ψ : coherentKZeroFiltration C f k →+ A)
    (hψ : ∀ x : coherentKZeroFiltration C f k,
      (x : CoherentKZero X) ∈ coherentKZeroFiltration C f (k - 1) → ψ x = 0) :
    gradedCoherentKZero C f k →+ A :=
  QuotientAddGroup.lift _ ψ fun x hx => hψ x hx

omit [IsLocallyNoetherian X] in
/-- The descent `gradedCoherentKZeroLift` of `ψ` sends the class of `x` to `ψ x`. -/
@[simp]
theorem gradedCoherentKZeroLift_toGradedCoherentKZero {A : Type*} [AddCommGroup A] (k : ℤ)
    (ψ : coherentKZeroFiltration C f k →+ A)
    (hψ : ∀ x : coherentKZeroFiltration C f k,
      (x : CoherentKZero X) ∈ coherentKZeroFiltration C f (k - 1) → ψ x = 0)
    (x : coherentKZeroFiltration C f k) :
    gradedCoherentKZeroLift C f k ψ hψ (toGradedCoherentKZero C f k x) = ψ x :=
  rfl

end Stacks.Chow

end
