module

public import StacksFrontier.AlgebraicGeometry.Chow.ChangeBaseScheme.GenuineChernClasses
public import StacksFrontier.AlgebraicGeometry.Chow.ChernWhitney.GradedIntertwining
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.PowerSumComplex
public import StacksFrontier.AlgebraicGeometry.Chow.RationalIntersection.GysinChernCharacter

/-!
# Base change of Chow groups commutes with the power sums of a module of constant rank

Let `B` be a flat base change of Chow situations `g : S' ⟶ S` with dimension shift `c`
([Stacks, Tag 0FVG]), let `X` be locally of finite type over `S`, with base change
`X' = X ×_S S'`, and let `g^* : CH_k(X) ⟶ CH_{k+c}(X')` be the base-change map of
[Stacks, Tag 0FVJ]. [Stacks, Tag 0FVN] says that `g^*` commutes with capping with the Chern
classes `c_j(ℰ)` of a finite locally free module `ℰ` of rank `r`, against `c_j(ℰ')` of its base
change `ℰ'`. This file extends this to the ring generated by these classes, and in particular to
the power sums `P_p(ℰ)` of [Stacks, Tag 0F9B].

A total Chow cohomology class `c = (c_p)_p` of `X` acts on `CH_*(X)` by the family of caps
`c_p ∩ - : CH_k(X) ⟶ CH_{k-p}(X)` (`Stacks.Chow.TotalChowClass.capFamily`), and this is a ring
homomorphism to the graded cap families on `CH_*(X)`. Two classes `c` on `X` and `c'` on `X'`
are *compatible with base change* when `g^*` intertwines their cap families
(`Stacks.Chow.TotalChowClass.BaseChangeCompatible`); compatible pairs are closed under the ring
operations (`Stacks.Chow.GradedCapFamily.Intertwines`).

## Main results

* `Stacks.Chow.TotalChowClass.capFamilyRingHom` — the cap families form a ring homomorphism.
* `Stacks.Chow.TotalChowClass.baseChangeCompatible_totalChern` — [Stacks, Tag 0FVN] for the total
  Chern class.
* `Stacks.Chow.TotalChowClass.baseChangeCompatible_powerSumTotal` — the same for the power sums
  `P_p(ℰ)` of a module of constant rank.

## References

* [Stacks Project, Tag 0FVN](https://stacks.math.columbia.edu/tag/0FVN)
* [Stacks Project, Tag 0F9B](https://stacks.math.columbia.edu/tag/0F9B)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Finset

universe u

namespace Stacks.Chow

namespace TotalChowClass

/-! ### The cap families of total classes -/

section CapFamily

variable {C : ChowSituation.{u}} {X : Scheme.{u}} {sX : X ⟶ C.S} [LocallyOfFiniteType sX]

/-- **The cap family of a total class** `c = (c_p)_p` on `CH_*(X)`: in degree `k` and index `p`,
the cap product `c_p ∩ - : CH_k(X) ⟶ CH_{k-p}(X)` on `X` itself. -/
def capFamily (c : TotalChowClass C sX) : GradedCapFamily (fun k : ℤ => chowGroup C sX k) :=
  fun k p => chowCohomologyCap C (gysinSystemOfInvertible C) sX (p : ℤ) (c p) k

/-- In degree `k` and index `p`, the cap family of `c` is the cap product with `c_p`. -/
theorem capFamily_apply (c : TotalChowClass C sX) (k : ℤ) (p : ℕ) (α : chowGroup C sX k) :
    c.capFamily k p α = chowCohomologyCap C (gysinSystemOfInvertible C) sX (p : ℤ) (c p) k α :=
  rfl

/-- The cap product with the zero class is zero. -/
private theorem chowCohomologyCap_zero_apply (p : ℤ) (k : ℤ) (α : chowGroup C sX k) :
    chowCohomologyCap C (gysinSystemOfInvertible C) sX p 0 k α = 0 := by
  have h := chowCohomologyCap_add_apply C (gysinSystemOfInvertible C) sX p 0 0 k α
  rw [add_zero] at h
  exact left_eq_add.mp h

/-- The identification of `CH_k(X)` over `sX` with `CH_{k-0}(X)` over `𝟙 X ≫ sX`, on which the
operations of total classes on the test scheme `𝟙 X` act. -/
def idTestEquiv (k : ℤ) : chowGroup C sX k ≃+ chowGroup C (𝟙 X ≫ sX) (k - (0 : ℤ)) :=
  (chowGroupCast C sX (sub_zero k).symm).trans
    (chowGroupCongr C (Category.id_comp sX).symm (k - (0 : ℤ)))

/-- The identification `Stacks.Chow.TotalChowClass.idTestEquiv` sends a cycle class to a
heterogeneously equal one. -/
theorem idTestEquiv_heq (k : ℤ) (α : chowGroup C sX k) : idTestEquiv k α ≍ α := by
  rw [idTestEquiv, AddEquiv.trans_apply]
  exact (chowGroupCongr_heq C _ _ _).trans (chowGroupCast_heq C sX _ α)

/-- The cap family of `c` and the operation of `c` on the test scheme `𝟙 X` are intertwined by
the identification `Stacks.Chow.TotalChowClass.idTestEquiv`. -/
theorem capFamily_intertwines_op (c : TotalChowClass C sX) :
    c.capFamily.Intertwines 0 (fun k => (idTestEquiv (C := C) (sX := sX) k).toAddMonoidHom)
      (c.op (𝟙 X)) := by
  refine GradedCapFamily.Intertwines.iff_heq.2 fun k i α => ?_
  refine (idTestEquiv_heq _ _).trans ?_
  refine (chowCohomologyCap_heq_idRule C sX (c i) k α).trans ?_
  exact (c.op (𝟙 X)).apply_heq (sub_zero k).symm i
    ((chowGroupCongr_heq C _ _ _).trans (idTestEquiv_heq k α).symm)

/-- The identification `Stacks.Chow.TotalChowClass.idTestEquiv` is injective. -/
theorem idTestEquiv_injective (k : ℤ) :
    Function.Injective ((idTestEquiv (C := C) (sX := sX) k).toAddMonoidHom) :=
  (idTestEquiv (C := C) (sX := sX) k).injective

/-- Two graded cap families on `CH_*(X)` intertwined with the same operation on `𝟙 X` agree. -/
theorem eq_of_intertwines_op {a b : GradedCapFamily (fun k : ℤ => chowGroup C sX k)}
    {o : GradedCapFamily (fun k : ℤ => chowGroup C (𝟙 X ≫ sX) k)}
    (ha : a.Intertwines 0 (fun k => (idTestEquiv (C := C) (sX := sX) k).toAddMonoidHom) o)
    (hb : b.Intertwines 0 (fun k => (idTestEquiv (C := C) (sX := sX) k).toAddMonoidHom) o) :
    a = b := by
  funext k i
  refine AddMonoidHom.ext fun α => idTestEquiv_injective (k - i) ?_
  rw [ha k i α, hb k i α]

/-- The cap family of a product of total classes is the product of their cap families. -/
theorem capFamily_mul (c d : TotalChowClass C sX) :
    (c * d).capFamily = c.capFamily * d.capFamily := by
  refine eq_of_intertwines_op (o := (c * d).op (𝟙 X)) (capFamily_intertwines_op _) ?_
  rw [op_mul]
  exact (capFamily_intertwines_op c).mul (capFamily_intertwines_op d)

/-- The cap family of the unit total class is the identity cap family. -/
theorem capFamily_one : (1 : TotalChowClass C sX).capFamily = 1 := by
  refine eq_of_intertwines_op (o := (1 : TotalChowClass C sX).op (𝟙 X))
    (capFamily_intertwines_op _) ?_
  rw [op_one]
  exact GradedCapFamily.Intertwines.one

/-- The cap family of a sum of total classes is the sum of their cap families. -/
theorem capFamily_add (c d : TotalChowClass C sX) :
    (c + d).capFamily = c.capFamily + d.capFamily := by
  funext k i
  refine AddMonoidHom.ext fun α => ?_
  simp only [capFamily_apply, add_apply, Pi.add_apply, AddMonoidHom.add_apply,
    chowCohomologyCap_add_apply]

/-- The cap family of the zero total class is zero. -/
theorem capFamily_zero : (0 : TotalChowClass C sX).capFamily = 0 := by
  funext k i
  exact AddMonoidHom.ext fun α => chowCohomologyCap_zero_apply _ k α

/-- **The cap families form a ring homomorphism** from the total classes of `X` to the graded
cap families on `CH_*(X)`. -/
def capFamilyRingHom : TotalChowClass C sX →+* GradedCapFamily (fun k : ℤ => chowGroup C sX k)
    where
  toFun c := c.capFamily
  map_one' := capFamily_one
  map_mul' := capFamily_mul
  map_zero' := capFamily_zero
  map_add' := capFamily_add

/-- The ring homomorphism `Stacks.Chow.TotalChowClass.capFamilyRingHom` sends `c` to its cap
family. -/
@[simp]
theorem capFamilyRingHom_apply (c : TotalChowClass C sX) : capFamilyRingHom c = c.capFamily :=
  rfl

/-- The cap family of a homogeneous component is the homogeneous component of the cap
family. -/
theorem capFamily_homComponent (i : ℕ) (c : TotalChowClass C sX) :
    (homComponent i c).capFamily = Stacks.Chow.homComponent i c.capFamily := by
  funext k j
  refine AddMonoidHom.ext fun α => ?_
  rw [capFamily_apply, homComponent_apply, Stacks.Chow.homComponent_apply]
  split_ifs
  · rfl
  · exact chowCohomologyCap_zero_apply _ k α

end CapFamily

/-! ### Compatibility with base change -/

section BaseChange

variable (B : FlatBaseChangeSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ B.base.S)
  [LocallyOfFiniteType sX]

/-- **The base-change map of Stacks 0FVJ as a degree-lowering family**:
`g^* : CH_k(X) ⟶ CH_{k+c}(X') = CH_{k-(-c)}(X')`. -/
def baseChangeFamily (k : ℤ) :
    chowGroup B.base sX k →+ chowGroup B.baseChange (pullback.snd sX B.g) (k - -B.c) :=
  (chowGroupCast B.baseChange (pullback.snd sX B.g)
    (show k + B.c = k - -B.c by ring)).toAddMonoidHom.comp
    (baseChangeChowPullback B sX k)

/-- The family `Stacks.Chow.TotalChowClass.baseChangeFamily` agrees, up to heterogeneous
equality, with the base-change map `g^* : CH_k(X) ⟶ CH_{k+c}(X')`. -/
theorem baseChangeFamily_heq (k : ℤ) (α : chowGroup B.base sX k) :
    baseChangeFamily B sX k α ≍ baseChangeChowPullback B sX k α :=
  chowGroupCast_heq _ _ (show k + B.c = k - -B.c by ring) _

variable {B sX}

/-- **A total class `c` of `X` and a total class `c'` of `X' = X ×_S S'` are compatible with base
change** when `g^*(c_p ∩ α) = c'_p ∩ g^*α` for all `p`, `k` and `α ∈ CH_k(X)`. -/
def BaseChangeCompatible (c : TotalChowClass B.base sX)
    (c' : TotalChowClass B.baseChange (pullback.snd sX B.g)) : Prop :=
  c.capFamily.Intertwines (-B.c) (baseChangeFamily B sX) c'.capFamily

namespace BaseChangeCompatible

/-- If `c` and `c'` are compatible with base change, then `g^*(c_p ∩ α)` and `c'_p ∩ g^*α` are
heterogeneously equal for all `p`, `k` and `α ∈ CH_k(X)`. -/
theorem heq {c : TotalChowClass B.base sX} {c' : TotalChowClass B.baseChange (pullback.snd sX B.g)}
    (h : BaseChangeCompatible c c') (k : ℤ) (p : ℕ) (α : chowGroup B.base sX k) :
    baseChangeChowPullback B sX (k - p)
        (chowCohomologyCap B.base (gysinSystemOfInvertible B.base) sX (p : ℤ) (c p) k α) ≍
      chowCohomologyCap B.baseChange (gysinSystemOfInvertible B.baseChange)
        (pullback.snd sX B.g) (p : ℤ) (c' p) (k + B.c) (baseChangeChowPullback B sX k α) := by
  refine (baseChangeFamily_heq B sX _ _).symm.trans ((GradedCapFamily.Intertwines.heq h k p α).trans
    ?_)
  exact c'.capFamily.apply_heq (by ring) p (baseChangeFamily_heq B sX k α)

/-- If `g^*(c_p ∩ α)` and `c'_p ∩ g^*α` are heterogeneously equal for all `p`, `k` and
`α ∈ CH_k(X)`, then `c` and `c'` are compatible with base change. -/
theorem of_heq {c : TotalChowClass B.base sX}
    {c' : TotalChowClass B.baseChange (pullback.snd sX B.g)}
    (h : ∀ (k : ℤ) (p : ℕ) (α : chowGroup B.base sX k),
      baseChangeChowPullback B sX (k - p)
          (chowCohomologyCap B.base (gysinSystemOfInvertible B.base) sX (p : ℤ) (c p) k α) ≍
        chowCohomologyCap B.baseChange (gysinSystemOfInvertible B.baseChange)
          (pullback.snd sX B.g) (p : ℤ) (c' p) (k + B.c) (baseChangeChowPullback B sX k α)) :
    BaseChangeCompatible c c' := by
  refine GradedCapFamily.Intertwines.iff_heq.2 fun k p α => ?_
  refine (baseChangeFamily_heq B sX _ _).trans ((h k p α).trans ?_)
  exact c'.capFamily.apply_heq (by ring) p (baseChangeFamily_heq B sX k α).symm

/-- The unit total classes of `X` and `X'` are compatible with base change. -/
theorem one : BaseChangeCompatible (1 : TotalChowClass B.base sX) 1 := by
  unfold BaseChangeCompatible
  rw [capFamily_one, capFamily_one]
  exact GradedCapFamily.Intertwines.one

/-- The zero total classes of `X` and `X'` are compatible with base change. -/
theorem zero : BaseChangeCompatible (0 : TotalChowClass B.base sX) 0 := by
  unfold BaseChangeCompatible
  rw [capFamily_zero, capFamily_zero]
  exact GradedCapFamily.Intertwines.zero

variable {c d : TotalChowClass B.base sX}
  {c' d' : TotalChowClass B.baseChange (pullback.snd sX B.g)}

/-- Sums of pairs compatible with base change are compatible with base change. -/
theorem add (h : BaseChangeCompatible c c') (h' : BaseChangeCompatible d d') :
    BaseChangeCompatible (c + d) (c' + d') := by
  unfold BaseChangeCompatible at *
  rw [capFamily_add, capFamily_add]
  exact h.add h'

/-- Products of pairs compatible with base change are compatible with base change. -/
theorem mul (h : BaseChangeCompatible c c') (h' : BaseChangeCompatible d d') :
    BaseChangeCompatible (c * d) (c' * d') := by
  unfold BaseChangeCompatible at *
  rw [capFamily_mul, capFamily_mul]
  exact h.mul h'

/-- If `c` and `c'` are compatible with base change, so are `-c` and `-c'`. -/
theorem neg (h : BaseChangeCompatible c c') : BaseChangeCompatible (-c) (-c') := by
  unfold BaseChangeCompatible at *
  rw [← capFamilyRingHom_apply, ← capFamilyRingHom_apply, map_neg, map_neg]
  exact h.neg

/-- If `c` and `c'` are compatible with base change, so are `c ^ n` and `c' ^ n`. -/
theorem pow (h : BaseChangeCompatible c c') (n : ℕ) : BaseChangeCompatible (c ^ n) (c' ^ n) := by
  induction n with
  | zero => simpa using one
  | succ n ih => simpa [pow_succ] using ih.mul h

/-- The total classes `n` of `X` and `X'`, for a natural number `n`, are compatible with base
change. -/
theorem natCast (n : ℕ) :
    BaseChangeCompatible (n : TotalChowClass B.base sX) (n : TotalChowClass _ _) := by
  induction n with
  | zero => simpa using zero
  | succ n ih => simpa using ih.add one

/-- The total classes `n` of `X` and `X'`, for an integer `n`, are compatible with base
change. -/
theorem intCast (n : ℤ) :
    BaseChangeCompatible (n : TotalChowClass B.base sX) (n : TotalChowClass _ _) := by
  rcases Int.eq_nat_or_neg n with ⟨m, rfl | rfl⟩
  · simpa using natCast m
  · simpa using (natCast m).neg

/-- A finite sum of pairs compatible with base change is compatible with base change. -/
theorem sum {ι : Type*} (s : Finset ι) {c : ι → TotalChowClass B.base sX}
    {c' : ι → TotalChowClass B.baseChange (pullback.snd sX B.g)}
    (h : ∀ t ∈ s, BaseChangeCompatible (c t) (c' t)) :
    BaseChangeCompatible (∑ t ∈ s, c t) (∑ t ∈ s, c' t) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using zero
  | insert t s ht ih =>
    rw [Finset.sum_insert ht, Finset.sum_insert ht]
    exact (h t (Finset.mem_insert_self t s)).add
      (ih fun t' ht' => h t' (Finset.mem_insert_of_mem ht'))

/-- If `c` and `c'` are compatible with base change, so are their homogeneous components of
degree `i`. -/
theorem homComponent (h : BaseChangeCompatible c c') (i : ℕ) :
    BaseChangeCompatible (TotalChowClass.homComponent i c) (TotalChowClass.homComponent i c') := by
  unfold BaseChangeCompatible at *
  rw [capFamily_homComponent, capFamily_homComponent]
  exact h.homComponent i

end BaseChangeCompatible

/-! ### Chern classes and power sums -/

/-- The cap product with the bivariant Chern class `c_j(ℰ)` of Stacks 0B7H on `X` itself is the
cap product `c_j(ℰ) ∩ -` of Stacks 02U6. -/
theorem chowCohomologyCap_chernClass {C : ChowSituation.{u}} {Y : Scheme.{u}} (sY : Y ⟶ C.S)
    [LocallyOfFiniteType sY] (E : Y.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] (p : ℕ)
    (hp : p < r + 1) (k : ℤ) (α : chowGroup C sY k) :
    chowCohomologyCap C (gysinSystemOfInvertible C) sY (p : ℤ)
        (GenuineChern.chernClass C sY E r ⟨p, hp⟩) k α =
      GenuineChern.chernCap C r sY E k ⟨p, hp⟩ α := by
  let := pullbackPreservesRank_of_isFiniteLocallyFreeOfRank E r (𝟙 Y)
  refine eq_of_heq ((chowCohomologyCap_heq_idRule C sY _ k α).trans ?_)
  rw [GenuineChern.idRule_chernClass]
  exact chernCap_heq_of_iso C (Category.id_comp sY) (F' := E) r
    ((Scheme.Modules.pullbackId Y).app E) k _ (chowGroupCongr_heq C _ k α)

variable (E : X.Modules) (r : ℕ)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
  (E' : (pullback sX B.g : Scheme.{u}).Modules)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E' r]
  (eE : E' ≅ (Scheme.Modules.pullback (pullback.fst sX B.g)).obj E)

include eE in
/-- **[Stacks, Tag 0FVN] for the total Chern class**: `c(ℰ)` on `X` and `c(ℰ')` on `X'` are
compatible with base change, `ℰ'` being identified with the base change of `ℰ`. -/
theorem baseChangeCompatible_totalChern :
    BaseChangeCompatible (totalChern B.base sX E r) (totalChern B.baseChange _ E' r) := by
  refine BaseChangeCompatible.of_heq fun k p α => ?_
  by_cases hp : p < r + 1
  · rw [show totalChern B.base sX E r p = totalChern B.base sX E r (⟨p, hp⟩ : Fin (r + 1)) from rfl,
      show totalChern B.baseChange _ E' r p = totalChern B.baseChange _ E' r
        (⟨p, hp⟩ : Fin (r + 1)) from rfl, totalChern_apply, totalChern_apply,
      chowCohomologyCap_chernClass sX E r p hp, chowCohomologyCap_chernClass _ E' r p hp,
      baseChange_chernCap_of_iso B sX E r E' eE k ⟨p, hp⟩ α]
    exact (chowGroupCast_heq _ _ _ _).symm
  · rw [totalChern_apply_of_lt B.base sX E r (by omega),
      totalChern_apply_of_lt B.baseChange _ E' r (by omega)]
    rw [chowCohomologyCap_zero_apply, chowCohomologyCap_zero_apply, map_zero]
    have h1 := chowGroupCast_heq B.baseChange (pullback.snd sX B.g)
      (show k - (p : ℤ) + B.c = k + B.c - (p : ℤ) by ring) 0
    rw [map_zero] at h1
    exact h1.symm

/-- **Polynomials in compatible Chern classes are compatible**: if `s n` and `s' n` are compatible
with base change for every `n`, so are the values `Q(s)` and `Q(s')` of a polynomial `Q` with
integer coefficients, evaluated in the commutative rings of Chern classes. -/
theorem baseChangeCompatible_aeval {s : ℕ+ → chernRing B.base sX}
    {s' : ℕ+ → chernRing B.baseChange (pullback.snd sX B.g)}
    (hs : ∀ n, BaseChangeCompatible (s n : TotalChowClass B.base sX)
      (s' n : TotalChowClass B.baseChange (pullback.snd sX B.g)))
    (Q : MvPolynomial ℕ+ ℤ) :
    BaseChangeCompatible ((MvPolynomial.aeval s Q : chernRing B.base sX) :
        TotalChowClass B.base sX)
      ((MvPolynomial.aeval s' Q : chernRing B.baseChange (pullback.snd sX B.g)) :
        TotalChowClass B.baseChange (pullback.snd sX B.g)) := by
  induction Q using MvPolynomial.induction_on with
  | C a =>
    rw [MvPolynomial.aeval_C, MvPolynomial.aeval_C, eq_intCast, eq_intCast, Subring.coe_intCast,
      Subring.coe_intCast]
    exact BaseChangeCompatible.intCast a
  | add Q R hQ hR =>
    rw [map_add, map_add, Subring.coe_add, Subring.coe_add]
    exact hQ.add hR
  | mul_X Q n hQ =>
    rw [map_mul, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X, Subring.coe_mul,
      Subring.coe_mul]
    exact hQ.mul (hs n)

include eE in
/-- **The power sums commute with base change**: `P_p(ℰ)` on `X` and `P_p(ℰ')` on `X'` are
compatible with base change, for `ℰ` of constant rank `r` and `ℰ'` identified with its base
change. `P_0 = r` is an integer, and for `p ≥ 1` `P_p` is a polynomial in the Chern classes. -/
theorem baseChangeCompatible_powerSumTotal (p : ℕ) :
    BaseChangeCompatible (powerSumTotal B.base sX E r p) (powerSumTotal B.baseChange _ E' r p) := by
  rcases p with _ | p
  · rw [powerSumTotal_zero, powerSumTotal_zero]
    exact BaseChangeCompatible.natCast r
  · rw [powerSumTotal_of_ne_zero B.base sX E r (Nat.succ_ne_zero p),
      powerSumTotal_of_ne_zero B.baseChange _ E' r (Nat.succ_ne_zero p)]
    have hs : ∀ n : ℕ+, BaseChangeCompatible (chernSeq B.base sX E r n : TotalChowClass B.base sX)
        (chernSeq B.baseChange (pullback.snd sX B.g) E' r n :
          TotalChowClass B.baseChange (pullback.snd sX B.g)) := fun n =>
      (baseChangeCompatible_totalChern E r E' eE).homComponent (n : ℕ)
    unfold AlgebraicGeometry.powerSumEval
    exact baseChangeCompatible_aeval (s := fun n : ℕ+ => chernSeq B.base sX E r n)
      (s' := fun n : ℕ+ => chernSeq B.baseChange (pullback.snd sX B.g) E' r n) hs _

end BaseChange

end TotalChowClass

end Stacks.Chow

end
