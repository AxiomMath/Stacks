module

public import StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.ExteriorPowerAlternating
public import StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.ChernPowerSumDescent
public import StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.FlagBundleUnconditional
public import StacksFrontier.AlgebraicGeometry.WeilCohomology.LambdaOperations

/-!
# Stacks 0FEE without a filtration

Let `Y` be locally of finite type over the base of chapter 42 and let `ℰ` be finite locally free
of rank `r ≥ 1`. With `c_± = ∏_{n even/odd} c(⋀ⁿ ℰ)` the products of
`Stacks.Chow.altChernEven` and `Stacks.Chow.altChernOdd`, the difference `c_+ - c_-` vanishes in
the degrees below `r` and its degree-`r` component is `-(r - 1)! c_r(ℰ)`.

The identity follows by the splitting principle of [Stacks, Tag 02UL] from the case of a module
filtered with invertible quotients: over a test scheme `g : T ⟶ Y`, flat pullback along the
splitting morphism `π : P ⟶ T` of `g^*ℰ` carries the Chern classes of `⋀ⁿ g^*ℰ` to those of
`⋀ⁿ π^*g^*ℰ` (Stacks 02U8 together with Stacks 01CI).

## Main definitions

* `Stacks.Chow.opSub`: the operation of the commutative subring of total classes generated by the
  Chern classes on a test scheme, as a ring homomorphism to the commutative subring of graded cap
  families generated by the Chern classes.

## Main results

* `Stacks.Chow.homComponent_altChern_sub_of_lt`: `c_+ - c_-` vanishes in degrees below the rank.
* `Stacks.Chow.homComponent_altChern_sub_rank`: its degree-`r` component is `-(r - 1)! c_r(ℰ)`.

## References

* [Stacks Project, Tag 0FEE](https://stacks.math.columbia.edu/tag/0FEE)
* [Stacks Project, Tag 02UL](https://stacks.math.columbia.edu/tag/02UL)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Finset

universe u

namespace Stacks.Chow

variable (C : ChowSituation.{u}) {Y : Scheme.{u}} (sY : Y ⟶ C.S) [LocallyOfFiniteType sY]

/-! ### The operation of the commutative subring -/

/-- The operation on a test scheme carries the generators of the commutative subring of total
classes into the commutative subring of graded cap families generated by the Chern classes. -/
theorem chernTotalSubring_le_comap {T : Scheme.{u}} (g : T ⟶ Y) [LocallyOfFiniteType g] :
    chernTotalSubring C sY ≤
      (chernSubring C (g ≫ sY)).comap (TotalChowClass.opRingHom (C := C) (sY := sY) g) := by
  refine (Subring.closure_le).2 ?_
  rintro _ ⟨F, r, hF, i, rfl⟩
  let := pullbackPreservesRank_of_isFiniteLocallyFreeOfRank F r g
  change (TotalChowClass.homComponent i (totalChern C sY F r)).op g ∈ chernSubring C (g ≫ sY)
  rw [TotalChowClass.op_homComponent, op_totalChern]
  exact homComponent_chernFamily_mem_chernSubring C (g ≫ sY) _ r i

/-- **The operation of the commutative subring on a test scheme**, as a ring homomorphism into
the commutative subring of graded cap families. -/
def opSub {T : Scheme.{u}} (g : T ⟶ Y) [LocallyOfFiniteType g] :
    chernTotalSubring C sY →+* chernSubring C (g ≫ sY) :=
  ((TotalChowClass.opRingHom (C := C) (sY := sY) g).comp
    (chernTotalSubring C sY).subtype).codRestrict _ fun x => chernTotalSubring_le_comap C sY g x.2

/-- The graded cap family underlying `opSub C sY g x` is the operation of `x` on `g`. -/
theorem coe_opSub {T : Scheme.{u}} (g : T ⟶ Y) [LocallyOfFiniteType g]
    (x : chernTotalSubring C sY) :
    ((opSub C sY g x : chernSubring C (g ≫ sY)) : GradedCapFamily (chowGroup C (g ≫ sY))) =
      (x : TotalChowClass C sY).op g :=
  rfl

/-- The operation of a total Chern class is the total Chern class of the pullback. -/
theorem coe_opSub_chernTotal {T : Scheme.{u}} (g : T ⟶ Y) [LocallyOfFiniteType g]
    (F : Y.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] :
    letI := pullbackPreservesRank_of_isFiniteLocallyFreeOfRank F r g
    ((opSub C sY g (chernTotal C sY F r) : chernSubring C (g ≫ sY)) :
      GradedCapFamily (chowGroup C (g ≫ sY))) =
        GenuineChern.chernFamily C (g ≫ sY) ((Scheme.Modules.pullback g).obj F) r :=
  op_totalChern C sY F r g

/-! ### Transport of injectivity along an equality of structure morphisms -/

/-- Injectivity of flat pullback on Chow groups is unchanged when the structure morphism of the
source is replaced by an equal one. -/
theorem injective_flatPullbackChow_of_eq {X P : Scheme.{u}} (sX : X ⟶ C.S)
    [LocallyOfFiniteType sX] (sP sP' : P ⟶ C.S) [LocallyOfFiniteType sP]
    [LocallyOfFiniteType sP'] (h : sP = sP') (π : P ⟶ X) [LocallyOfFiniteType π] [Flat π]
    (hsP : π ≫ sX = sP) (hsP' : π ≫ sX = sP') (d : ℕ)
    (hd : AlgebraicGeometry.RelativeDimension π d) (k : ℤ)
    (hfac : FlatPullbackFactorsThroughRationalEquivalence C sP sX π hsP d hd k)
    (hfac' : FlatPullbackFactorsThroughRationalEquivalence C sP' sX π hsP' d hd k)
    (hinj : Function.Injective (flatPullbackChow C sP sX π hsP d hd k hfac)) :
    Function.Injective (flatPullbackChow C sP' sX π hsP' d hd k hfac') := by
  subst h
  exact hinj

/-! ### The descent -/

section Descent

variable (V : Y.Modules) (r : ℕ)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} V r]

open scoped IsMulCommutative in
/-- Over a test scheme `g : T ⟶ Y`, take the splitting morphism `π : P ⟶ T` of `g^*ℰ` and write
`q` for the structure morphism of `P`. Then flat pullback along `π` intertwines the operation of
`c_+ - c_-` on `T` with the operation of the corresponding difference for `π^*g^*ℰ` on `P`, and is
injective. -/
theorem exists_intertwines_altChern {T : Scheme.{u}} (g : T ⟶ Y) [LocallyOfFiniteType g] :
    ∃ (P : Scheme.{u}) (sP : P ⟶ C.S) (_ : LocallyOfFiniteType sP) (π : P ⟶ T)
      (_ : LocallyOfFiniteType π) (_ : Flat π) (d : ℕ)
      (hd : AlgebraicGeometry.RelativeDimension π d) (hf : π ≫ (g ≫ sY) = 𝟙 P ≫ sP)
      (W : P.Modules) (_ : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        W r)
      (L : Fin r → P.Modules)
      (_ : ∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (L i) 1)
      (_ : HasQuotients P r W L),
      (∀ k, Function.Injective (flatPullbackChow C (𝟙 P ≫ sP) (g ≫ sY) π hf d hd k
        (flatPullbackFactorsThroughRationalEquivalence_general C (𝟙 P ≫ sP) (g ≫ sY) π hf d hd
          k))) ∧
      Intertwines (fun k => flatPullbackChow C (𝟙 P ≫ sP) (g ≫ sY) π hf d hd k
          (flatPullbackFactorsThroughRationalEquivalence_general C (𝟙 P ≫ sP) (g ≫ sY) π hf d hd
            k))
        (((altChernEven C sY V r - altChernOdd C sY V r : chernTotalSubring C sY) :
          TotalChowClass C sY).op g)
        (((altChernEven C sP W r - altChernOdd C sP W r : chernTotalSubring C sP) :
          TotalChowClass C sP).op (𝟙 P)) ∧
      Intertwines (fun k => flatPullbackChow C (𝟙 P ≫ sP) (g ≫ sY) π hf d hd k
          (flatPullbackFactorsThroughRationalEquivalence_general C (𝟙 P ≫ sP) (g ≫ sY) π hf d hd
            k))
        ((totalChern C sY V r).op g) ((totalChern C sP W r).op (𝟙 P)) := by
  classical
  obtain ⟨S, hS⟩ := exists_splittingMorphism_basechange_unconditional C sY (Fin 1)
    (fun _ => V) (fun _ => r) (fun _ => inferInstance) (g ≫ sY) g
  obtain ⟨L, hLinv, hL⟩ := exists_hasQuotients_of_hasInvertibleFiltration (hS 0)
  have : ∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (L i) 1 :=
    fun i => (have := hLinv i; isFiniteLocallyFreeOfRank_one_of_isInvertible (L i))
  set W := (Scheme.Modules.pullback S.π).obj ((Scheme.Modules.pullback g).obj V) with hW
  have hWr := isFiniteLocallyFreeOfRank_of_hasQuotients r W L hL
  have hf : S.π ≫ (g ≫ sY) = 𝟙 S.P ≫ S.sP := S.hsP.trans (Category.id_comp _).symm
  set pull := fun k => flatPullbackChow C (𝟙 S.P ≫ S.sP) (g ≫ sY) S.π hf _ S.relDim k
    (flatPullbackFactorsThroughRationalEquivalence_general C (𝟙 S.P ≫ S.sP) (g ≫ sY) S.π hf _
      S.relDim k) with hpull
  have hfactor : ∀ (F : Y.Modules) (n : ℕ)
      [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F n]
      (F' : S.P.Modules)
      [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F' n]
      (e : F' ≅ (Scheme.Modules.pullback S.π).obj ((Scheme.Modules.pullback g).obj F)),
      Intertwines pull ((totalChern C sY F n).op g) ((totalChern C S.sP F' n).op (𝟙 S.P)) := by
    intro F n _ F' _ e
    let := pullbackPreservesRank_of_isFiniteLocallyFreeOfRank F n g
    let := pullbackPreservesRank_of_isFiniteLocallyFreeOfRank F' n (𝟙 S.P)
    rw [op_totalChern, op_totalChern]
    exact GenuineChern.intertwines_chernFamily C (g ≫ sY) ((Scheme.Modules.pullback g).obj F) n
      (𝟙 S.P ≫ S.sP) S.π hf _ S.relDim _ ((Scheme.Modules.pullbackId S.P).app F' ≪≫ e)
  have hwedge : ∀ n : ℕ,
      let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V r n
      let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower W r n
      ((opSub C sY g (chernTotal C sY (Scheme.Modules.exteriorPower V (n : ℤ)) (r.choose n)),
        opSub C S.sP (𝟙 S.P) (chernTotal C S.sP (Scheme.Modules.exteriorPower W (n : ℤ))
          (r.choose n))) : chernSubring C (g ≫ sY) × chernSubring C (𝟙 S.P ≫ S.sP)) ∈
        intertwinedChernPairs C (g ≫ sY) (𝟙 S.P ≫ S.sP) pull := by
    intro n
    let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V r n
    let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower W r n
    exact hfactor _ _ _
      ((AlgebraicGeometry.VectorBundleKZero.pullbackExteriorPowerIso S.π
        ((Scheme.Modules.pullback g).obj V)
        (n : ℤ)).symm ≪≫ (Scheme.Modules.pullback S.π).mapIso
          (AlgebraicGeometry.VectorBundleKZero.pullbackExteriorPowerIso g V (n : ℤ)).symm)
  have hprod : ∀ (p : ℕ → Prop) [DecidablePred p],
      ((opSub C sY g (∏ n ∈ (range (r + 1)).filter p,
          let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V r n
          chernTotal C sY (Scheme.Modules.exteriorPower V (n : ℤ)) (r.choose n)),
        opSub C S.sP (𝟙 S.P) (∏ n ∈ (range (r + 1)).filter p,
          let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower W r n
          chernTotal C S.sP (Scheme.Modules.exteriorPower W (n : ℤ)) (r.choose n))) :
          chernSubring C (g ≫ sY) × chernSubring C (𝟙 S.P ≫ S.sP)) ∈
        intertwinedChernPairs C (g ≫ sY) (𝟙 S.P ≫ S.sP) pull := by
    intro p _
    rw [map_prod, map_prod, prod_mk_prod]
    exact Subring.prod_mem _ fun n _ => hwedge n
  have hsub := Subring.sub_mem _ (hprod Even) (hprod fun n => ¬ Even n)
  refine ⟨S.P, S.sP, inferInstance, S.π, inferInstance, inferInstance, _, S.relDim, hf, W, hWr,
    L, inferInstance, hL, fun k => ?_, ?_, ?_⟩
  · exact injective_flatPullbackChow_of_eq C (g ≫ sY) S.sP (𝟙 S.P ≫ S.sP)
      (Category.id_comp _).symm S.π S.hsP hf _ S.relDim k (S.hfac k) _ (S.injective_pullbackChow k)
  · rwa [Prod.mk_sub_mk, ← map_sub, ← map_sub] at hsub
  · exact hfactor V r W (Iso.refl _)

/-- **`c_+ - c_-` vanishes below the rank**: for `ℰ` finite locally free of rank `r` and `t < r`,
the degree-`t` component of `∏_{n even} c(⋀ⁿ ℰ) - ∏_{n odd} c(⋀ⁿ ℰ)` is `0`. -/
theorem homComponent_altChern_sub_of_lt {t : ℕ} (ht : t < r) :
    TotalChowClass.homComponent t
      ((altChernEven C sY V r - altChernOdd C sY V r : chernTotalSubring C sY) :
        TotalChowClass C sY) = 0 := by
  refine TotalChowClass.ext_op fun {T} g _ => ?_
  obtain ⟨P, sP, _, π, _, _, d, hd, hf, W, _, L, _, hL, hinj, hint, -⟩ :=
    exists_intertwines_altChern C sY V r g
  have hup := homComponent_altChern_sub_of_lt_of_hasQuotients C sP hL ht
  rw [TotalChowClass.op_homComponent, TotalChowClass.op_zero]
  refine eq_of_intertwines _ hinj (hint.homComponent t) Intertwines.zero ?_
  rw [← TotalChowClass.op_homComponent, hup, TotalChowClass.op_zero]

/-- **The degree-`r` component of `c_+ - c_-` is `-(r - 1)! c_r(ℰ)`**, for `ℰ` finite locally free
of rank `r ≥ 1`. -/
theorem homComponent_altChern_sub_rank (hr : r ≠ 0) :
    TotalChowClass.homComponent r
      ((altChernEven C sY V r - altChernOdd C sY V r : chernTotalSubring C sY) :
        TotalChowClass C sY) =
      -((r - 1).factorial • TotalChowClass.homComponent r (totalChern C sY V r)) := by
  refine TotalChowClass.ext_op fun {T} g _ => ?_
  obtain ⟨P, sP, _, π, _, _, d, hd, hf, W, _, L, _, hL, hinj, hint, hintV⟩ :=
    exists_intertwines_altChern C sY V r g
  have hup := homComponent_altChern_sub_rank_of_hasQuotients C sP hL hr
  have hrhs := ((Intertwines.natCast (r - 1).factorial).mul
    (hintV.homComponent r)).neg
  have hop : ∀ {Z : Scheme.{u}} {sZ : Z ⟶ C.S} [LocallyOfFiniteType sZ] {Z' : Scheme.{u}}
      (u : Z' ⟶ Z) [LocallyOfFiniteType u] (x : TotalChowClass C sZ),
      (-((r - 1).factorial • x)).op u =
        -((((r - 1).factorial : ℕ) : GradedCapFamily (chowGroup C (u ≫ sZ))) * x.op u) := by
    intro Z sZ _ Z' u _ x
    rw [TotalChowClass.op_neg, nsmul_eq_mul, TotalChowClass.op_mul]
    exact congrArg (fun a => -(a * x.op u)) (map_natCast (TotalChowClass.opRingHom u) _)
  rw [TotalChowClass.op_homComponent, hop, TotalChowClass.op_homComponent]
  refine eq_of_intertwines _ hinj (hint.homComponent r) hrhs ?_
  rw [← TotalChowClass.op_homComponent, hup, hop, TotalChowClass.op_homComponent]

end Descent

end Stacks.Chow
