module

public import StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.ExteriorPowerTotalChern
public import StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.AlternatingSubsetSums

/-!
# The alternating product of the Chern classes of the exterior powers

Let `Y` be locally of finite type over the base of chapter 42 and let `ℰ` be finite locally free
of rank `r ≥ 1`. Write

  `c_+ = ∏_{n even} c(⋀ⁿ ℰ)`,  `c_- = ∏_{n odd} c(⋀ⁿ ℰ)`

for the products over `0 ≤ n ≤ r`, formed in the commutative subring of total classes generated by
the Chern classes. Then `c_+ - c_-` vanishes in the degrees `0, …, r - 1` and its degree-`r`
component is `-(r - 1)! c_r(ℰ)`. Since `∏_{n} c(⋀ⁿ ℰ)^{(-1)ⁿ} = c_+ c_-⁻¹ = 1 + (c_+ - c_-) c_-⁻¹`,
this is [Stacks, Tag 0FEE]:

  `∏_{n = 0, …, r} c(⋀ⁿ ℰ)^{(-1)ⁿ} = 1 - (r - 1)! c_r(ℰ) + …`.

When `ℰ` has a filtration with invertible successive quotients of first Chern classes
`x₁, …, xᵣ`, the Chern roots of `⋀ⁿ ℰ` are the sums `∑_{i ∈ I} xᵢ` over the subsets `I` with
`n` elements (`Stacks.Chow.totalChern_exteriorPower_of_hasQuotients`), so `c_±` is the product of
`1 + ∑_{i ∈ I} xᵢ` over the subsets of even, respectively odd, cardinality, and the claim is the
comparison of elementary symmetric functions `AlgebraicGeometry.subsetSumEsymm_even_eq_odd` and
`AlgebraicGeometry.subsetSumEsymm_even_sub_odd`.

## Main definitions

* `Stacks.Chow.altChernEven`, `Stacks.Chow.altChernOdd`: the products `c_+` and `c_-`.

## Main results

* `Stacks.Chow.TotalChowClass.IsHomogeneous.mul`: products of homogeneous total classes.
* `Stacks.Chow.homComponent_prod_one_add`: the components of a product of linear factors are the
  elementary symmetric functions.
* `Stacks.Chow.homComponent_altChern_sub_of_lt_of_hasQuotients`,
  `Stacks.Chow.homComponent_altChern_sub_rank_of_hasQuotients`: the filtered case.

## References

* [Stacks Project, Tag 0FEE](https://stacks.math.columbia.edu/tag/0FEE)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Finset

universe u

namespace Stacks.Chow

namespace TotalChowClass

variable {C : ChowSituation.{u}} {Y : Scheme.{u}} {sY : Y ⟶ C.S} [LocallyOfFiniteType sY]

/-- The homogeneous components of a homogeneous total class. -/
theorem IsHomogeneous.homComponent_eq_ite {i : ℕ} {c : TotalChowClass C sY}
    (hc : c.IsHomogeneous i) (m : ℕ) : homComponent m c = if m = i then c else 0 := by
  by_cases hm : m = i
  · subst hm
    rw [if_pos rfl]
    refine ext fun p => ?_
    rw [homComponent_apply]
    split_ifs with hp
    · rfl
    · exact (hc p hp).symm
  · rw [if_neg hm]
    refine ext fun p => ?_
    rw [homComponent_apply, zero_apply]
    split_ifs with hp
    · subst hp
      exact hc _ hm
    · rfl

/-- **A product of homogeneous total classes is homogeneous**, of the sum of the degrees. -/
theorem IsHomogeneous.mul {i j : ℕ} {a b : TotalChowClass C sY} (ha : a.IsHomogeneous i)
    (hb : b.IsHomogeneous j) : (a * b).IsHomogeneous (i + j) := by
  intro p hp
  have h : (a * b) p = homComponent p (a * b) p := by rw [homComponent_apply, if_pos rfl]
  rw [h, homComponent_mul, sum_apply]
  refine Finset.sum_eq_zero fun k hk => ?_
  have hk' : k ≤ p := Nat.lt_succ_iff.mp (mem_range.mp hk)
  rw [ha.homComponent_eq_ite, hb.homComponent_eq_ite]
  by_cases h1 : p - k = i
  · by_cases h2 : k = j
    · exact absurd (by omega : p = i + j) hp
    · rw [if_neg h2, mul_zero, zero_apply]
  · rw [if_neg h1, zero_mul, zero_apply]

end TotalChowClass

/-! ### Products of linear factors -/

section Linear

variable (C : ChowSituation.{u}) {Y : Scheme.{u}} (sY : Y ⟶ C.S) [LocallyOfFiniteType sY]

open scoped IsMulCommutative in
/-- A product of `#T` total classes of degree one is homogeneous of degree `#T`. -/
theorem isHomogeneous_prod {ι : Type*} (T : Finset ι) (y : ι → chernTotalSubring C sY)
    (hy : ∀ I, (y I : TotalChowClass C sY).IsHomogeneous 1) :
    ((∏ I ∈ T, y I : chernTotalSubring C sY) : TotalChowClass C sY).IsHomogeneous T.card := by
  classical
  induction T using Finset.induction_on with
  | empty =>
      rw [prod_empty, Subring.coe_one, card_empty]
      exact fun _ hp => TotalChowClass.one_apply_of_ne hp
  | insert a s ha ih =>
      rw [prod_insert ha, Subring.coe_mul, card_insert_of_notMem ha, add_comm]
      exact (hy a).mul ih

open scoped IsMulCommutative in
/-- **The components of a product of linear factors**: for `y_I` of degree one, the degree-`t`
component of `∏_{I ∈ p} (1 + y_I)` is the `t`-th elementary symmetric function of the `y_I`. -/
theorem homComponent_prod_one_add {ι : Type*} (p : Finset ι) (y : ι → chernTotalSubring C sY)
    (hy : ∀ I, (y I : TotalChowClass C sY).IsHomogeneous 1) (t : ℕ) :
    TotalChowClass.homComponent t
        ((∏ I ∈ p, (1 + y I) : chernTotalSubring C sY) : TotalChowClass C sY) =
      ((∑ T ∈ p.powersetCard t, ∏ I ∈ T, y I : chernTotalSubring C sY) :
        TotalChowClass C sY) := by
  classical
  rw [prod_one_add, AddSubmonoidClass.coe_finset_sum, map_sum,
    AddSubmonoidClass.coe_finset_sum, powersetCard_eq_filter, sum_filter]
  refine sum_congr rfl fun T _ => ?_
  rw [(isHomogeneous_prod C sY T y hy).homComponent_eq_ite]
  by_cases hT : T.card = t
  · rw [if_pos hT.symm, if_pos hT]
  · rw [if_neg (Ne.symm hT), if_neg hT]

end Linear

/-! ### The even and the odd products -/

section Alternating

variable (C : ChowSituation.{u}) {Y : Scheme.{u}} (sY : Y ⟶ C.S) [LocallyOfFiniteType sY]

open scoped IsMulCommutative in
/-- **The product `c_+ = ∏_{n even} c(⋀ⁿ ℰ)`** over `0 ≤ n ≤ r`, for `ℰ` of rank `r`. -/
def altChernEven (V : Y.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} V r] :
    chernTotalSubring C sY :=
  ∏ n ∈ (range (r + 1)).filter Even,
    letI := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V r n
    chernTotal C sY (Scheme.Modules.exteriorPower V (n : ℤ)) (r.choose n)

open scoped IsMulCommutative in
/-- **The product `c_- = ∏_{n odd} c(⋀ⁿ ℰ)`** over `0 ≤ n ≤ r`, for `ℰ` of rank `r`. -/
def altChernOdd (V : Y.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} V r] :
    chernTotalSubring C sY :=
  ∏ n ∈ (range (r + 1)).filter (fun n => ¬ Even n),
    letI := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V r n
    chernTotal C sY (Scheme.Modules.exteriorPower V (n : ℤ)) (r.choose n)

/-- `c(⋀⁰ ℰ) = 1`. -/
theorem chernTotal_exteriorPower_zero (V : Y.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} V r] :
    letI := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V r 0
    chernTotal C sY (Scheme.Modules.exteriorPower V ((0 : ℕ) : ℤ)) (r.choose 0) = 1 := by
  let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V r 0
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (Scheme.Modules.exteriorPower V ((0 : ℕ) : ℤ)) 1 :=
    Nat.choose_zero_right r ▸ Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V r 0
  rw [chernTotal_congr C sY (Iso.refl _) (Nat.choose_zero_right r)]
  exact Subtype.ext (totalChern_eq_one_of_iso_unit C sY _
    (_root_.SheafOfModules.algebras _ V).exteriorPieceIso_zero)

variable {r : ℕ} {V : Y.Modules} {L : Fin r → Y.Modules}
  [∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (L i) 1]

open scoped IsMulCommutative in
/-- The Chern roots of every exterior power, the zeroth one included. -/
theorem chernTotal_exteriorPower_eq_prod (h : HasQuotients Y r V L) (n : ℕ) :
    letI := isFiniteLocallyFreeOfRank_of_hasQuotients r V L h
    letI := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V r n
    chernTotal C sY (Scheme.Modules.exteriorPower V (n : ℤ)) (r.choose n) =
      ∏ I ∈ powersetCard n (univ : Finset (Fin r)), (1 + ∑ i ∈ I, firstChernTot C sY (L i)) := by
  let := isFiniteLocallyFreeOfRank_of_hasQuotients r V L h
  rcases n with _ | k
  · rw [chernTotal_exteriorPower_zero, powersetCard_zero, prod_singleton, sum_empty, add_zero]
  · exact totalChern_exteriorPower_of_hasQuotients C sY r V L h k

/-- The product of the Chern classes of the exterior powers `⋀ⁿ ℰ`, over the `n ≤ r` satisfying
`P`, is the product of `1 + ∑_{i ∈ I} xᵢ` over the subsets `I` whose cardinality satisfies `P`. -/
private theorem prod_chernTotal_filter_eq_prod (h : HasQuotients Y r V L) (P : ℕ → Prop)
    [DecidablePred P] :
    letI := isFiniteLocallyFreeOfRank_of_hasQuotients r V L h
    (∏ n ∈ (range (r + 1)).filter P,
      letI := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V r n
      chernTotal C sY (Scheme.Modules.exteriorPower V (n : ℤ)) (r.choose n)) =
      ∏ I ∈ (univ : Finset (Finset (Fin r))).filter (fun I => P #I),
        (1 + ∑ i ∈ I, firstChernTot C sY (L i)) := by
  classical
  let := isFiniteLocallyFreeOfRank_of_hasQuotients r V L h
  rw [← prod_fiberwise_of_maps_to (g := Finset.card) (t := (range (r + 1)).filter P)]
  · refine prod_congr rfl fun n hn => ?_
    rw [chernTotal_exteriorPower_eq_prod C sY h n]
    refine prod_congr ?_ fun _ _ => rfl
    ext I
    simp only [mem_filter, mem_univ, true_and, mem_powersetCard, subset_univ]
    exact ⟨fun hI => ⟨hI ▸ (mem_filter.1 hn).2, hI⟩, fun hI => hI.2⟩
  · intro I hI
    exact mem_filter.2
      ⟨mem_range.2 (Nat.lt_succ_of_le ((card_le_univ I).trans_eq (Fintype.card_fin r))),
        (mem_filter.1 hI).2⟩

open scoped IsMulCommutative in
/-- **`c_+` in terms of the Chern roots**: the product of `1 + ∑_{i ∈ I} xᵢ` over the subsets `I`
of even cardinality. -/
theorem altChernEven_eq_prod (h : HasQuotients Y r V L) :
    letI := isFiniteLocallyFreeOfRank_of_hasQuotients r V L h
    altChernEven C sY V r =
      ∏ I ∈ AlgebraicGeometry.evenCardSubsets r, (1 + ∑ i ∈ I, firstChernTot C sY (L i)) :=
  prod_chernTotal_filter_eq_prod C sY h Even

open scoped IsMulCommutative in
/-- **`c_-` in terms of the Chern roots**: the product of `1 + ∑_{i ∈ I} xᵢ` over the subsets `I`
of odd cardinality. -/
theorem altChernOdd_eq_prod (h : HasQuotients Y r V L) :
    letI := isFiniteLocallyFreeOfRank_of_hasQuotients r V L h
    altChernOdd C sY V r =
      ∏ I ∈ AlgebraicGeometry.oddCardSubsets r, (1 + ∑ i ∈ I, firstChernTot C sY (L i)) :=
  prod_chernTotal_filter_eq_prod C sY h (fun n => ¬ Even n)

/-- The subset sums of degree-one classes are of degree one. -/
theorem isHomogeneous_subsetSum (x : Fin r → chernTotalSubring C sY)
    (hx : ∀ i, (x i : TotalChowClass C sY).IsHomogeneous 1) (I : Finset (Fin r)) :
    ((∑ i ∈ I, x i : chernTotalSubring C sY) : TotalChowClass C sY).IsHomogeneous 1 := by
  rw [AddSubmonoidClass.coe_finset_sum]
  exact isHomogeneous_sum C sY _ _ fun i _ => hx i

/-- The components of `c_+ - c_-` are the differences of the elementary symmetric functions of the
subset sums of the Chern roots, over the even and the odd subsets. -/
private theorem homComponent_altChern_sub_eq (h : HasQuotients Y r V L) (t : ℕ) :
    letI := isFiniteLocallyFreeOfRank_of_hasQuotients r V L h
    TotalChowClass.homComponent t
      ((altChernEven C sY V r - altChernOdd C sY V r : chernTotalSubring C sY) :
        TotalChowClass C sY) =
      ((AlgebraicGeometry.subsetSumEsymm (fun i => firstChernTot C sY (L i))
          (AlgebraicGeometry.evenCardSubsets r) t -
        AlgebraicGeometry.subsetSumEsymm (fun i => firstChernTot C sY (L i))
          (AlgebraicGeometry.oddCardSubsets r) t : chernTotalSubring C sY) :
        TotalChowClass C sY) := by
  let := isFiniteLocallyFreeOfRank_of_hasQuotients r V L h
  have hx : ∀ i, ((firstChernTot C sY (L i) : chernTotalSubring C sY) :
      TotalChowClass C sY).IsHomogeneous 1 := fun i => isHomogeneous_firstChernTot C sY (L i)
  rw [AddSubgroupClass.coe_sub, map_sub, altChernEven_eq_prod C sY h, altChernOdd_eq_prod C sY h,
    homComponent_prod_one_add C sY _ _ (isHomogeneous_subsetSum C sY _ hx),
    homComponent_prod_one_add C sY _ _ (isHomogeneous_subsetSum C sY _ hx),
    ← AddSubgroupClass.coe_sub]
  rfl

open scoped IsMulCommutative in
/-- **`c_+ - c_-` vanishes below the rank**, for a filtered module. -/
theorem homComponent_altChern_sub_of_lt_of_hasQuotients (h : HasQuotients Y r V L) {t : ℕ}
    (ht : t < r) :
    letI := isFiniteLocallyFreeOfRank_of_hasQuotients r V L h
    TotalChowClass.homComponent t
      ((altChernEven C sY V r - altChernOdd C sY V r : chernTotalSubring C sY) :
        TotalChowClass C sY) = 0 := by
  have he := AlgebraicGeometry.subsetSumEsymm_even_eq_odd
    (fun i => firstChernTot C sY (L i)) ht
  rw [homComponent_altChern_sub_eq C sY h, he, sub_self]
  rfl

open scoped IsMulCommutative in
/-- The top Chern class of a filtered module is the product of its Chern roots. -/
theorem homComponent_totalChern_rank_of_hasQuotients (h : HasQuotients Y r V L) :
    letI := isFiniteLocallyFreeOfRank_of_hasQuotients r V L h
    TotalChowClass.homComponent r (totalChern C sY V r) =
      ((∏ i, firstChernTot C sY (L i) : chernTotalSubring C sY) : TotalChowClass C sY) := by
  classical
  let := isFiniteLocallyFreeOfRank_of_hasQuotients r V L h
  let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V r 1
  have hx : ∀ i, ((firstChernTot C sY (L i) : chernTotalSubring C sY) :
      TotalChowClass C sY).IsHomogeneous 1 := fun i => isHomogeneous_firstChernTot C sY (L i)
  have h1 : chernTotal C sY V r =
      chernTotal C sY (Scheme.Modules.exteriorPower V ((1 : ℕ) : ℤ)) (r.choose 1) :=
    chernTotal_congr C sY (_root_.SheafOfModules.algebras _ V).exteriorPowerOneIso.symm
      (Nat.choose_one_right r).symm
  rw [chernTotal_exteriorPower_eq_prod C sY h 1] at h1
  have h2 : totalChern C sY V r = _ := congrArg Subtype.val h1
  have hcard : (powersetCard 1 (univ : Finset (Fin r))).card = r := by
    rw [card_powersetCard, card_univ, Fintype.card_fin, Nat.choose_one_right]
  rw [h2, homComponent_prod_one_add C sY _ _ (isHomogeneous_subsetSum C sY _ hx)]
  have hself := powersetCard_self (powersetCard 1 (univ : Finset (Fin r)))
  rw [hcard] at hself
  rw [hself, sum_singleton, powersetCard_one, prod_map]
  simp only [Function.Embedding.coeFn_mk, sum_singleton]

open scoped IsMulCommutative in
/-- **The degree-`r` component of `c_+ - c_-` is `-(r-1)! c_r(ℰ)`**, for a filtered module of
rank `r ≥ 1`. -/
theorem homComponent_altChern_sub_rank_of_hasQuotients (h : HasQuotients Y r V L)
    (hr : r ≠ 0) :
    letI := isFiniteLocallyFreeOfRank_of_hasQuotients r V L h
    TotalChowClass.homComponent r
      ((altChernEven C sY V r - altChernOdd C sY V r : chernTotalSubring C sY) :
        TotalChowClass C sY) =
      -((r - 1).factorial • TotalChowClass.homComponent r (totalChern C sY V r)) := by
  have he := AlgebraicGeometry.subsetSumEsymm_even_sub_odd
    (fun i => firstChernTot C sY (L i)) hr
  simp only [AlgebraicGeometry.subsetSumEsymm] at he
  rw [homComponent_altChern_sub_eq C sY h, homComponent_totalChern_rank_of_hasQuotients C sY h]
  simp only [AlgebraicGeometry.subsetSumEsymm, he, Subring.coe_neg, AddSubmonoidClass.coe_nsmul]

end Alternating

end Stacks.Chow
