module

public import StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.ExteriorPowerChernRoots
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.PerfectTwist
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.TotalChernWhitney
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.ChernCommutation
public import StacksFrontier.AlgebraicGeometry.Chow.ChernWhitney.InvertibleSubsheaf
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ExteriorPowerDegreeOne

/-!
# The total Chern class of an exterior power of a filtered module

Let `Y` be locally of finite type over the base of chapter 42 and let `ℰ` be finite locally free
of rank `r` with a filtration whose successive quotients are invertible modules `ℒ₁, …, ℒᵣ`, of
first Chern classes `x₁, …, xᵣ`. Then for every `n ≥ 1`

  `c(⋀ⁿ ℰ) = ∏_{#I = n} (1 + ∑_{i ∈ I} xᵢ)`

in the ring of total classes `∏_{p ≥ 0} A^p(Y)`, the product being taken in the commutative
subring generated by the homogeneous components of total Chern classes. This is the display of
the proof of [Stacks, Tag 0FEE]: the Chern roots of `⋀ⁿ ℰ` are the sums of `n` distinct Chern
roots of `ℰ`.

The induction peels off the bottom step `ℒᵣ ⊆ ℰ` of the filtration, with quotient `𝒬`: the short
exact sequence `0 → ⋀¹ ℒᵣ ⊗ ⋀ⁿ⁻¹ 𝒬 → ⋀ⁿ ℰ → ⋀ⁿ 𝒬 → 0`
(`AlgebraicGeometry.Scheme.Modules.shortExact_exteriorPower_of_rankOne`), the Whitney formula of
[Stacks, Tag 02UI] and the twist formula of [Stacks, Tag 02UD] reduce the claim to the one for
`𝒬`.

## Main definitions

* `Stacks.Chow.chernTotalSubring`: the commutative subring of total classes generated by the
  homogeneous components of total Chern classes.

## Main results

* `Stacks.Chow.prod_powersetCard_fin_succ`: the subsets of `Fin (m + 1)` with or without the last
  element.
* `Stacks.Chow.TotalChowClass.twist_one_add`: `T_{1,x}(1 + y) = 1 + y + x`.
* `Stacks.Chow.totalChern_exteriorPower_of_hasQuotients`: **the Chern roots of the exterior
  powers.**

## References

* [Stacks Project, Tag 0FEE](https://stacks.math.columbia.edu/tag/0FEE)
* [Stacks Project, Tag 02UI](https://stacks.math.columbia.edu/tag/02UI)
* [Stacks Project, Tag 02UD](https://stacks.math.columbia.edu/tag/02UD)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Finset

universe u

namespace Stacks.Chow

/-! ### Subsets of `Fin (m + 1)` -/

/-- The last element of `Fin (m + 1)` is not in the image of a subset of `Fin m`. -/
private theorem last_notMem_map_castSuccEmb {m : ℕ} (K : Finset (Fin m)) :
    Fin.last m ∉ K.map Fin.castSuccEmb := by
  simp [Fin.castSucc_ne_last]

/-- **The subsets of `Fin (m + 1)` of a given size**, sorted by whether they contain the last
element. -/
theorem prod_powersetCard_fin_succ {M : Type*} [CommMonoid M] (m n : ℕ)
    (f : Finset (Fin (m + 1)) → M) :
    ∏ I ∈ powersetCard (n + 1) (univ : Finset (Fin (m + 1))), f I =
      (∏ I ∈ powersetCard (n + 1) (univ : Finset (Fin m)), f (I.map Fin.castSuccEmb)) *
        ∏ J ∈ powersetCard n (univ : Finset (Fin m)),
          f (insert (Fin.last m) (J.map Fin.castSuccEmb)) := by
  classical
  have huniv : (univ : Finset (Fin (m + 1))) =
      insert (Fin.last m) ((univ : Finset (Fin m)).map Fin.castSuccEmb) := by
    ext i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simp
    · simp [Fin.castSucc_ne_last]
  have hnot := last_notMem_map_castSuccEmb (univ : Finset (Fin m))
  rw [huniv, powersetCard_succ_insert hnot, prod_union, powersetCard_map, prod_map,
    powersetCard_map, prod_image, prod_map]
  · rfl
  · intro J hJ J' hJ' h
    obtain ⟨K, -, rfl⟩ := mem_map.1 (mem_coe.1 hJ)
    obtain ⟨K', -, rfl⟩ := mem_map.1 (mem_coe.1 hJ')
    exact (erase_insert (last_notMem_map_castSuccEmb K)).symm.trans
      ((congrArg (fun S => S.erase (Fin.last m)) h).trans
        (erase_insert (last_notMem_map_castSuccEmb K')))
  · rw [disjoint_left]
    intro I hI hI'
    obtain ⟨J, -, rfl⟩ := mem_image.1 hI'
    have hsub := (mem_powersetCard.1 hI).1
    exact hnot (hsub (mem_insert_self _ _))

/-! ### The commutative subring of total classes generated by the Chern classes -/

section Subring

variable (C : ChowSituation.{u}) {Y : Scheme.{u}} (sY : Y ⟶ C.S) [LocallyOfFiniteType sY]

/-- The homogeneous components of the total Chern classes of the finite locally free modules of
constant rank. -/
def chernTotalComponents : Set (TotalChowClass C sY) :=
  {a | ∃ (F : Y.Modules) (r : ℕ)
    (_ : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r) (i : ℕ),
      a = TotalChowClass.homComponent i (totalChern C sY F r)}

/-- **The commutative subring of total classes generated by the Chern classes.** -/
abbrev chernTotalSubring : Subring (TotalChowClass C sY) :=
  Subring.closure (chernTotalComponents C sY)

/-- The subring generated by the Chern classes is commutative (Stacks 02UA). -/
instance isMulCommutative_chernTotalSubring : IsMulCommutative (chernTotalSubring C sY) :=
  Subring.isMulCommutative_closure fun a ha b hb => by
    obtain ⟨E, r, hE, i, rfl⟩ := ha
    obtain ⟨F, s, hF, j, rfl⟩ := hb
    exact fun _ => commute_homComponent_totalChern C sY E F r s i j

open scoped IsMulCommutative in
/-- The commutative ring structure on the subring generated by the Chern classes. -/
instance : CommRing (chernTotalSubring C sY) := inferInstance

/-- **A total Chern class lies in the subring.** -/
theorem totalChern_mem_chernTotalSubring (F : Y.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] :
    totalChern C sY F r ∈ chernTotalSubring C sY := by
  have h : totalChern C sY F r =
      ∑ i ∈ range (r + 1), TotalChowClass.homComponent i (totalChern C sY F r) := by
    refine TotalChowClass.ext fun p => ?_
    rw [TotalChowClass.sum_apply]
    by_cases hp : p < r + 1
    · rw [Finset.sum_eq_single_of_mem p (mem_range.2 hp), TotalChowClass.homComponent_apply,
        if_pos rfl]
      intro b _ hb
      rw [TotalChowClass.homComponent_apply, if_neg (Ne.symm hb)]
    · rw [totalChern_apply_of_lt C sY F r (by omega)]
      refine (Finset.sum_eq_zero fun b hb => ?_).symm
      rw [TotalChowClass.homComponent_apply, if_neg (by have := mem_range.1 hb; omega)]
  rw [h]
  exact Subring.sum_mem _ fun i _ => Subring.subset_closure ⟨F, r, inferInstance, i, rfl⟩

/-- The total Chern class, as an element of the commutative subring. -/
def chernTotal (F : Y.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] :
    chernTotalSubring C sY :=
  ⟨totalChern C sY F r, totalChern_mem_chernTotalSubring C sY F r⟩

/-- The first Chern class of a module of rank one, as an element of the commutative subring. -/
def firstChernTot (L : Y.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L 1] :
    chernTotalSubring C sY :=
  ⟨TotalChowClass.homComponent 1 (totalChern C sY L 1),
    Subring.subset_closure ⟨L, 1, inferInstance, 1, rfl⟩⟩

/-- `c(ℒ) = 1 + c₁(ℒ)` for a module of rank one. -/
theorem chernTotal_rank_one (L : Y.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L 1] :
    chernTotal C sY L 1 = 1 + firstChernTot C sY L := by
  refine Subtype.ext (TotalChowClass.ext fun p => ?_)
  show totalChern C sY L 1 p = (1 : TotalChowClass C sY) p +
    TotalChowClass.homComponent 1 (totalChern C sY L 1) p
  rw [TotalChowClass.homComponent_apply]
  rcases p with _ | _ | p
  · rw [if_neg (by omega), add_zero, totalChern_apply_zero]
  · rw [if_pos rfl, TotalChowClass.one_apply_of_ne (by omega)]
    exact (zero_add _).symm
  · rw [if_neg (by omega), add_zero, TotalChowClass.one_apply_of_ne (by omega),
      totalChern_apply_of_lt C sY L 1 (by omega)]

/-- The first Chern class in the subring is homogeneous of degree one. -/
theorem isHomogeneous_firstChernTot (L : Y.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L 1] :
    ((firstChernTot C sY L : chernTotalSubring C sY) : TotalChowClass C sY).IsHomogeneous 1 :=
  TotalChowClass.isHomogeneous_homComponent 1 _

end Subring

/-! ### The twist of a product of linear factors -/

section Twist

variable {C : ChowSituation.{u}} {Y : Scheme.{u}} {sY : Y ⟶ C.S} [LocallyOfFiniteType sY]

/-- The binomial series `(1 + x)¹` is `1 + x` for `x` of index one. -/
theorem binomialFamily_one {G : ℤ → Type*} [∀ k, AddCommGroup (G k)] {x : GradedCapFamily G}
    (hx : x.IsHomogeneous 1) : binomialFamily 1 x = 1 + x := by
  funext k m
  rw [binomialFamily, gradedSeries_apply]
  show (Ring.choose (1 : ℤ) m • x ^ m) k m = (1 : GradedCapFamily G) k m + x k m
  rcases m with _ | _ | m
  · rw [hx k 0 (by omega), add_zero, pow_zero, Ring.choose_zero_right, one_smul]
  · rw [gradedCap_one_of_ne (by omega), zero_add]
    simp only [zero_add, pow_one, Ring.choose_one_right, one_smul]
  · rw [gradedCap_one_of_ne (by omega), hx k (m + 2) (by omega), add_zero,
      show (1 : ℤ) = ((1 : ℕ) : ℤ) from rfl, Ring.choose_natCast,
      Nat.choose_eq_zero_of_lt (by omega), Nat.cast_zero, zero_smul]
    rfl

/-- **`T_{1,x}(1 + y) = 1 + y + x`** for total classes `x`, `y` of degree one. -/
theorem TotalChowClass.twist_one_add {x y : TotalChowClass C sY} (hx : x.IsHomogeneous 1)
    (hy : y.IsHomogeneous 1) : TotalChowClass.twist 1 x (1 + y) = 1 + y + x := by
  refine TotalChowClass.ext_op fun g _ => ?_
  rw [TotalChowClass.op_twist, TotalChowClass.op_add, TotalChowClass.op_one, map_add,
    gradedTwist_of_isHomogeneous (hx.op g) 1 GradedCapFamily.IsHomogeneous.one,
    gradedTwist_of_isHomogeneous (hx.op g) 1 (hy.op g), TotalChowClass.op_add,
    TotalChowClass.op_add, TotalChowClass.op_one,
    show (1 : ℤ) - ((0 : ℕ) : ℤ) = 1 by simp, show (1 : ℤ) - ((1 : ℕ) : ℤ) = 0 by simp,
    binomialFamily_one (hx.op g), binomialFamily_zero, one_mul, mul_one]
  abel

variable (C sY)

open scoped IsMulCommutative in
/-- **The twist of a product of linear factors**: for degree-one elements `x` and `y_J` of the
commutative subring, `T_{#s, x}(∏_J (1 + y_J)) = ∏_J (1 + y_J + x)`. -/
theorem twist_prod_one_add {ι : Type*} (s : Finset ι) (x : chernTotalSubring C sY)
    (hx : (x : TotalChowClass C sY).IsHomogeneous 1) (y : ι → chernTotalSubring C sY)
    (hy : ∀ J, (y J : TotalChowClass C sY).IsHomogeneous 1) :
    TotalChowClass.twist (s.card : ℤ) (x : TotalChowClass C sY)
        ((∏ J ∈ s, (1 + y J) : chernTotalSubring C sY) : TotalChowClass C sY) =
      ((∏ J ∈ s, (1 + y J + x) : chernTotalSubring C sY) : TotalChowClass C sY) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      simp only [card_empty, Nat.cast_zero, prod_empty, Subring.coe_one]
      exact TotalChowClass.twist_zero_one hx
  | insert a s ha ih =>
      have hc : Commute (x : TotalChowClass C sY)
          ((∏ J ∈ s, (1 + y J) : chernTotalSubring C sY) : TotalChowClass C sY) :=
        (Commute.all x _).map (chernTotalSubring C sY).subtype
      rw [prod_insert ha, prod_insert ha, card_insert_of_notMem ha, Subring.coe_mul,
        Subring.coe_mul, Nat.cast_succ, add_comm ((s.card : ℕ) : ℤ) 1,
        TotalChowClass.twist_mul hx 1 _ _ hc, ih, Subring.coe_add, Subring.coe_one,
        TotalChowClass.twist_one_add hx (hy a)]
      rfl

end Twist

/-! ### The Chern roots of the exterior powers -/

section Roots

variable (C : ChowSituation.{u}) {Y : Scheme.{u}} (sY : Y ⟶ C.S) [LocallyOfFiniteType sY]

/-- Isomorphic modules of equal ranks have equal total Chern classes in the subring. -/
theorem chernTotal_congr {F F' : Y.Modules} {r r' : ℕ}
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F' r'] (e : F ≅ F')
    (h : r = r') : chernTotal C sY F r = chernTotal C sY F' r' :=
  Subtype.ext (totalChern_congr C sY e h)

/-- **The Whitney formula in the subring**, Stacks 02UI. -/
theorem chernTotal_shortExact {A B D : Y.Modules} (f : A ⟶ B) (g : B ⟶ D) (w : f ≫ g = 0)
    (hS : (ShortComplex.mk f g w).ShortExact) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} A r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} D s]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} B (r + s)] :
    chernTotal C sY B (r + s) = chernTotal C sY A r * chernTotal C sY D s :=
  Subtype.ext (totalChern_shortExact C sY (ShortComplex.mk f g w) hS r s)

open scoped IsMulCommutative in
/-- **The Chern roots of an invertible twist**: if `c(ℰ) = ∏_{J ∈ s} (1 + y_J)` with `#s` the rank
of `ℰ` and the `y_J` of degree one, then `c(ℰ ⊗ ℒ) = ∏_{J ∈ s} (1 + y_J + c₁(ℒ))`
(Stacks 02UD). -/
theorem chernTotal_tensorObj_of_eq_prod {ι : Type*} (E Lr : Y.Modules) (s : Finset ι)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E s.card]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} Lr 1]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (Scheme.Modules.tensorObj E Lr) s.card]
    (y : ι → chernTotalSubring C sY) (hy : ∀ J, (y J : TotalChowClass C sY).IsHomogeneous 1)
    (hE : chernTotal C sY E s.card = ∏ J ∈ s, (1 + y J)) :
    chernTotal C sY (Scheme.Modules.tensorObj E Lr) s.card =
      ∏ J ∈ s, (1 + y J + firstChernTot C sY Lr) := by
  have := Stacks.ModuleDescent.isInvertible_of_isFiniteLocallyFreeOfRank_one Y Lr ‹_›
  refine Subtype.ext ?_
  have h1 := TotalChowClass.totalChern_sheafTensor C sY Lr E s.card
  have h2 := TotalChowClass.firstChernTotal_eq_homComponent_totalChern C sY Lr
  have h3 : totalChern C sY E s.card =
      ((∏ J ∈ s, (1 + y J) : chernTotalSubring C sY) : TotalChowClass C sY) :=
    congrArg Subtype.val hE
  show totalChern C sY (Scheme.Modules.tensorObj E Lr) s.card = _
  refine h1.trans ?_
  rw [h2, h3]
  exact twist_prod_one_add C sY s (firstChernTot C sY Lr) (isHomogeneous_firstChernTot C sY Lr)
    y hy

/-- A finite sum of total classes homogeneous of degree `i` is homogeneous of degree `i`. -/
theorem isHomogeneous_sum {ι : Type*} (s : Finset ι) (c : ι → TotalChowClass C sY) {i : ℕ}
    (hc : ∀ j ∈ s, (c j).IsHomogeneous i) : (∑ j ∈ s, c j).IsHomogeneous i := fun p hp => by
  rw [TotalChowClass.sum_apply]
  exact Finset.sum_eq_zero fun j hj => hc j hj p hp

/-- Isomorphic modules of rank one have equal first Chern classes in the subring. -/
theorem firstChernTot_congr {L L' : Y.Modules}
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L 1]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L' 1] (e : L ≅ L') :
    firstChernTot C sY L = firstChernTot C sY L' :=
  Subtype.ext (congrArg (TotalChowClass.homComponent 1) (totalChern_congr C sY e rfl))

open scoped IsMulCommutative in
/-- **The Chern roots of the exterior powers**, the display of the proof of Stacks 0FEE: if `ℰ`
carries a filtration with successive quotients `ℒ₀, …, ℒ_{r-1}` of rank one, then for `n ≥ 1`

  `c(⋀ⁿ ℰ) = ∏_{#I = n} (1 + ∑_{i ∈ I} c₁(ℒᵢ))`. -/
theorem totalChern_exteriorPower_of_hasQuotients : ∀ (r : ℕ) (V : Y.Modules)
    (L : Fin r → Y.Modules)
    [∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (L i) 1]
    (h : HasQuotients Y r V L) (k : ℕ),
    letI := isFiniteLocallyFreeOfRank_of_hasQuotients r V L h
    letI := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V r (k + 1)
    chernTotal C sY (Scheme.Modules.exteriorPower V ((k + 1 : ℕ) : ℤ)) (r.choose (k + 1)) =
      ∏ I ∈ powersetCard (k + 1) (univ : Finset (Fin r)),
        (1 + ∑ i ∈ I, firstChernTot C sY (L i)) := by
  classical
  intro r
  induction r with
  | zero =>
      intro V L _ h k
      let := isFiniteLocallyFreeOfRank_of_hasQuotients 0 V L h
      let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V 0 (k + 1)
      have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
          (Scheme.Modules.exteriorPower V ((k + 1 : ℕ) : ℤ)) 0 :=
        Nat.choose_zero_succ k ▸ Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V 0 (k + 1)
      rw [chernTotal_congr C sY (Iso.refl _) (Nat.choose_zero_succ k),
        powersetCard_eq_empty.2 (by simp), prod_empty]
      exact Subtype.ext (totalChern_of_rank_zero C sY _)
  | succ r ih =>
      intro V L _ h k
      obtain ⟨N, eN, Q, f, g, w, hS, hQ⟩ := exists_bottom_of_hasQuotients r V L h
      have hQr := isFiniteLocallyFreeOfRank_of_hasQuotients r Q _ hQ
      have hVr := isFiniteLocallyFreeOfRank_of_hasQuotients (r + 1) V L h
      have hN : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} N 1 :=
        AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso eN.symm inferInstance
      set x : Fin (r + 1) → chernTotalSubring C sY := fun i => firstChernTot C sY (L i) with hx
      have hlast : chernTotal C sY N 1 = 1 + x (Fin.last r) := by
        rw [chernTotal_congr C sY eN rfl, chernTotal_rank_one]
      have hsplit : ∀ n : ℕ, ∏ I ∈ powersetCard (n + 1) (univ : Finset (Fin (r + 1))),
          (1 + ∑ i ∈ I, x i) =
            (∏ I ∈ powersetCard (n + 1) (univ : Finset (Fin r)),
              (1 + ∑ i ∈ I, x i.castSucc)) *
            ∏ J ∈ powersetCard n (univ : Finset (Fin r)),
              (1 + ∑ i ∈ J, x i.castSucc + x (Fin.last r)) := by
        intro n
        rw [prod_powersetCard_fin_succ r n]
        congr 1
        · refine prod_congr rfl fun I _ => ?_
          rw [sum_map]
          rfl
        · refine prod_congr rfl fun J _ => ?_
          rw [sum_insert (last_notMem_map_castSuccEmb J), sum_map, add_comm (x (Fin.last r)),
            add_assoc]
          rfl
      cases k with
      | zero =>
          let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V (r + 1) (0 + 1)
          let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower Q r (0 + 1)
          have hQ1 := ih Q (fun i => L i.castSucc) hQ 0
          have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} V (1 + r) :=
            add_comm r 1 ▸ hVr
          have e1 : chernTotal C sY (Scheme.Modules.exteriorPower V ((0 + 1 : ℕ) : ℤ))
              ((r + 1).choose (0 + 1)) = chernTotal C sY V (1 + r) :=
            chernTotal_congr C sY (_root_.SheafOfModules.algebras _ V).exteriorPowerOneIso
              (by rw [zero_add, Nat.choose_one_right, add_comm])
          have e2 : chernTotal C sY (Scheme.Modules.exteriorPower Q ((0 + 1 : ℕ) : ℤ))
              (r.choose (0 + 1)) = chernTotal C sY Q r :=
            chernTotal_congr C sY (_root_.SheafOfModules.algebras _ Q).exteriorPowerOneIso
              (by rw [zero_add, Nat.choose_one_right])
          rw [e1, chernTotal_shortExact C sY f g w hS 1 r, hlast, ← e2, hQ1, hsplit 0,
            powersetCard_zero, prod_singleton, sum_empty, zero_add, mul_comm, add_zero]
      | succ k =>
          have hd : k + 1 + 1 = 1 + (k + 1) := by omega
          have h1N : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
              (Scheme.Modules.exteriorPower N 1) 1 :=
            AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso
              (_root_.SheafOfModules.algebras _ N).exteriorPowerOneIso.symm inferInstance
          obtain ⟨φ, w', hS'⟩ := Scheme.Modules.shortExact_exteriorPower_of_rankOne f g w hS r k
          set s : Finset (Finset (Fin r)) := powersetCard (k + 1) univ with hs
          have hcard : s.card = r.choose (k + 1) := by
            rw [hs, card_powersetCard, card_univ, Fintype.card_fin]
          let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V (r + 1) (k + 1 + 1)
          let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower Q r (k + 1 + 1)
          have iQ : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
              (Scheme.Modules.exteriorPower Q ((k + 1 : ℕ) : ℤ)) s.card :=
            hcard ▸ Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower Q r (k + 1)
          have iQ' : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
              (Scheme.Modules.exteriorPower Q ((1 + (k + 1) : ℕ) : ℤ)) (r.choose (k + 1 + 1)) :=
            hd ▸ Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower Q r (k + 1 + 1)
          have iT : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
              (Scheme.Modules.tensorObj (Scheme.Modules.exteriorPower N 1)
                (Scheme.Modules.exteriorPower Q ((k + 1 : ℕ) : ℤ))) s.card :=
            isFiniteLocallyFreeOfRank_tensorObj_rankOneLeft _ _ _
          have iT' : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
              (Scheme.Modules.tensorObj (Scheme.Modules.exteriorPower Q ((k + 1 : ℕ) : ℤ))
                (Scheme.Modules.exteriorPower N 1)) s.card :=
            isFiniteLocallyFreeOfRank_tensorObj_rankOne _ _ _
          have iV : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
              (Scheme.Modules.exteriorPower V ((1 + (k + 1) : ℕ) : ℤ))
                (s.card + r.choose (k + 1 + 1)) :=
            hcard ▸ hd ▸ Nat.choose_succ_succ' r (k + 1) ▸
              Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower V (r + 1) (k + 1 + 1)
          have eV : chernTotal C sY (Scheme.Modules.exteriorPower V ((k + 1 + 1 : ℕ) : ℤ))
              ((r + 1).choose (k + 1 + 1)) =
                chernTotal C sY (Scheme.Modules.exteriorPower V ((1 + (k + 1) : ℕ) : ℤ))
                  (s.card + r.choose (k + 1 + 1)) :=
            chernTotal_congr C sY (eqToIso (by rw [hd]))
              (by rw [hcard, Nat.choose_succ_succ'])
          have eQ : chernTotal C sY (Scheme.Modules.exteriorPower Q ((1 + (k + 1) : ℕ) : ℤ))
              (r.choose (k + 1 + 1)) =
                chernTotal C sY (Scheme.Modules.exteriorPower Q ((k + 1 + 1 : ℕ) : ℤ))
                  (r.choose (k + 1 + 1)) :=
            chernTotal_congr C sY (eqToIso (by rw [hd])) rfl
          have eT : chernTotal C sY (Scheme.Modules.tensorObj (Scheme.Modules.exteriorPower N 1)
                (Scheme.Modules.exteriorPower Q ((k + 1 : ℕ) : ℤ))) s.card =
              chernTotal C sY (Scheme.Modules.tensorObj
                (Scheme.Modules.exteriorPower Q ((k + 1 : ℕ) : ℤ))
                (Scheme.Modules.exteriorPower N 1)) s.card :=
            chernTotal_congr C sY (tensorObjSwap _ _) rfl
          have hQk : chernTotal C sY (Scheme.Modules.exteriorPower Q ((k + 1 : ℕ) : ℤ)) s.card =
              ∏ J ∈ s, (1 + ∑ i ∈ J, x i.castSucc) :=
            let := Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower Q r (k + 1)
            (chernTotal_congr C sY (Iso.refl _) hcard).trans (ih Q (fun i => L i.castSucc) hQ k)
          have hroots := chernTotal_tensorObj_of_eq_prod C sY
            (Scheme.Modules.exteriorPower Q ((k + 1 : ℕ) : ℤ)) (Scheme.Modules.exteriorPower N 1)
            s (fun J => ∑ i ∈ J, x i.castSucc)
            (fun J => by
              rw [AddSubmonoidClass.coe_finset_sum]
              exact isHomogeneous_sum C sY _ _ fun i _ => isHomogeneous_firstChernTot C sY _)
            hQk
          rw [firstChernTot_congr C sY (show Scheme.Modules.exteriorPower N 1 ≅ L (Fin.last r) from
            (_root_.SheafOfModules.algebras _ N).exteriorPowerOneIso ≪≫ eN)] at hroots
          rw [eV, chernTotal_shortExact C sY φ _ w' hS' s.card (r.choose (k + 1 + 1)), eT,
            hroots, eQ, ih Q (fun i => L i.castSucc) hQ (k + 1), hsplit (k + 1), mul_comm]

end Roots

