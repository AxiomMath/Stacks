-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.Chow

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

attribute [local instance] isFiniteLocallyFreeOfRank_one_of_isInvertible
  isFiniteLocallyFreeOfRank_tensorObj_mul

set_option synthInstance.maxHeartbeats 200000 in
/-- **The constant-rank step of Stacks 0F9D, in the ring of graded cap families.** Let `(S, δ)`
be the situation of Stacks 02QL, let `X` be locally of finite type over `S` and let `ℰ₁` and `ℰ₂`
be finite locally free `𝒪_X`-modules of constant ranks `r` and `s`. Then for every `p ≥ 0`

  `P_p(ℰ₁ ⊗_{𝒪_X} ℰ₂) = ∑_{p₁ + p₂ = p} C(p, p₁) P_{p₁}(ℰ₁) P_{p₂}(ℰ₂)`

in the ring of graded cap families on the Chow groups of `X`, whence
`ch(ℰ₁ ⊗ ℰ₂) = ch(ℰ₁) ch(ℰ₂)` after dividing by `p!`. In degree zero the identity reads
`r · s = r · s` and in degree one `c₁(ℰ₁ ⊗ ℰ₂) = s · c₁(ℰ₁) + r · c₁(ℰ₂)`.

Stacks 0F9D itself is `Stacks.Chow.modulePowerSumArbitraryRank_tensorObj`, which reads this
identity on every test scheme at once — making it an identity of bivariant classes — and removes
the constant-rank hypothesis by the rank decomposition. -/
theorem powerSumChernElem_tensorObj (E₁ E₂ : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₂ s] (p : ℕ) :
    powerSumChernElem C sX (Scheme.Modules.tensorObj E₁ E₂) (r * s) p
      = ∑ q ∈ Finset.HasAntidiagonal.antidiagonal p,
          (p.choose q.1 : GradedCapFamily (chowGroup C sX)) *
            (powerSumChernElem C sX E₁ r q.1 * powerSumChernElem C sX E₂ s q.2) := by
  classical
  -- Stacks 02UL for the pair `ℰ₁`, `ℰ₂`.
  obtain ⟨T, hT⟩ := exists_splittingMorphism_unconditional C sX (Fin 2)
    (fun i => if i = 0 then E₁ else E₂) (fun i => if i = 0 then r else s)
    (by
      intro i
      by_cases hi : i = 0
      · simp only [hi, reduceIte]
        infer_instance
      · simp only [if_neg hi]
        infer_instance)
  have hT1 : Stacks.WeilCohomology.HasInvertibleFiltration T.P
      ((Scheme.Modules.pullback T.π).obj E₁) r := hT 0
  have hT2 : Stacks.WeilCohomology.HasInvertibleFiltration T.P
      ((Scheme.Modules.pullback T.π).obj E₂) s := hT 1
  obtain ⟨L, hLinv, hL⟩ := exists_hasQuotients_of_hasInvertibleFiltration hT1
  obtain ⟨N, hNinv, hN⟩ := exists_hasQuotients_of_hasInvertibleFiltration hT2
  have : ∀ i, AlgebraicGeometry.SheafOfModules.IsInvertible T.P.sheaf.obj
    T.P.ringCatSheaf.property (L i) := hLinv
  have : ∀ j, AlgebraicGeometry.SheafOfModules.IsInvertible T.P.sheaf.obj
    T.P.ringCatSheaf.property (N j) := hNinv
  have : ∀ (F : X.Modules) (n : ℕ)
      [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F n],
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        ((Scheme.Modules.pullback T.π).obj F) n :=
    fun F n _ => AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback T.π F n
  -- The Chern roots of the two pullbacks and of their tensor product.
  have hr1 := hasChernRoots_of_hasQuotients C T.sP r
    ((Scheme.Modules.pullback T.π).obj E₁) L hL
  have hr2 := hasChernRoots_of_hasQuotients C T.sP s
    ((Scheme.Modules.pullback T.π).obj E₂) N hN
  have hcc : (fun i : ℕ+ => chernClassSub C T.sP
        ((Scheme.Modules.pullback T.π).obj (Scheme.Modules.tensorObj E₁ E₂)) (r * s) (i : ℕ))
      = fun i : ℕ+ => chernClassSub C T.sP
        (Scheme.Modules.tensorObj ((Scheme.Modules.pullback T.π).obj E₁)
          ((Scheme.Modules.pullback T.π).obj E₂)) (r * s) (i : ℕ) := by
    funext i
    exact chernClassSub_congr C T.sP (pullbackTensorObjIso T.π E₁ E₂) rfl (i : ℕ)
  have hrT : AlgebraicGeometry.HasChernRoots (r * s)
      (fun i : ℕ+ => chernClassSub C T.sP
        ((Scheme.Modules.pullback T.π).obj (Scheme.Modules.tensorObj E₁ E₂)) (r * s) (i : ℕ))
      (fun ij : Fin r × Fin s =>
        firstChernSub C T.sP (L ij.1) + firstChernSub C T.sP (N ij.2)) := by
    rw [hcc]
    exact hasChernRoots_tensorObj_of_hasQuotients C T.sP r s (r * s)
      ((Scheme.Modules.pullback T.π).obj E₁) ((Scheme.Modules.pullback T.π).obj E₂) L N hL hN rfl
  -- The identity upstairs, in the commutative subring and then in the ambient ring.
  have hup := AlgebraicGeometry.powerSumOfChernClasses_tensor_of_hasChernRoots hrT hr1 hr2 p
  have hupamb : powerSumChernElem C T.sP
        ((Scheme.Modules.pullback T.π).obj (Scheme.Modules.tensorObj E₁ E₂)) (r * s) p
      = ∑ q ∈ Finset.HasAntidiagonal.antidiagonal p,
          (p.choose q.1 : GradedCapFamily (chowGroup C T.sP)) *
            (powerSumChernElem C T.sP ((Scheme.Modules.pullback T.π).obj E₁) r q.1 *
              powerSumChernElem C T.sP ((Scheme.Modules.pullback T.π).obj E₂) s q.2) := by
    have h := congrArg (Subring.subtype (chernSubring C T.sP)) hup
    rw [map_sum (Subring.subtype (chernSubring C T.sP))] at h
    simp only [map_mul, map_natCast] at h
    exact h
  -- Stacks 02U8 for the total Chern classes, hence for `P_p`.
  have hint : ∀ (F : X.Modules) (n : ℕ)
      [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F n],
      Intertwines T.pullbackChow (GenuineChern.chernFamily C sX F n)
        (GenuineChern.chernFamily C T.sP ((Scheme.Modules.pullback T.π).obj F) n) :=
    fun F n _ =>
      GenuineChern.intertwines_chernFamily C sX F n T.sP T.π T.hsP _ T.relDim _ (Iso.refl _)
  -- Descent along `π^*`, which is injective by clause (1) of Stacks 02UL.
  refine eq_of_intertwines T.pullbackChow T.injective_pullbackChow
    (intertwines_powerSumChernElem C sX T.sP T.pullbackChow
      (Scheme.Modules.tensorObj E₁ E₂) _ (r * s) (hint _ _) p)
    (Intertwines.sum _ fun q _ => (Intertwines.natCast _).mul
      ((intertwines_powerSumChernElem C sX T.sP T.pullbackChow E₁ _ r (hint _ _) q.1).mul
        (intertwines_powerSumChernElem C sX T.sP T.pullbackChow E₂ _ s (hint _ _) q.2))) hupamb

/-- **Stacks 0F9D read against a fixed cycle.** For every `n`-cycle `α` on `X` and every `p ≥ 0`

  `P_p(ℰ₁ ⊗ ℰ₂) ∩ α = ∑_{p₁ + p₂ = p} C(p, p₁) · (P_{p₁}(ℰ₁) ∘ P_{p₂}(ℰ₂)) ∩ α`

in `A_{n-p}(X)`: `Stacks.Chow.powerSumChernElem_tensorObj` evaluated in degree `n` at index `p`,
which is the shape in which Stacks 0FA6 is stated in this repository. -/
theorem powerSumChernElem_tensorObj_apply (E₁ E₂ : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₂ s] (p : ℕ) (n : ℤ)
    (α : chowGroup C sX n) :
    powerSumChernElem C sX (Scheme.Modules.tensorObj E₁ E₂) (r * s) p n p α
      = ∑ q ∈ Finset.HasAntidiagonal.antidiagonal p,
          ((p.choose q.1 : GradedCapFamily (chowGroup C sX)) *
            (powerSumChernElem C sX E₁ r q.1 * powerSumChernElem C sX E₂ s q.2)) n p α := by
  rw [powerSumChernElem_tensorObj C sX E₁ E₂ r s p, gradedCap_sum_apply]

/-! ### The Chern character, and `ch(ℰ₁ ⊗ ℰ₂) = ch(ℰ₁) ch(ℰ₂)` -/

/-- `P_p` of the Chern classes of `ℱ` read in the commutative subring the Chern classes generate,
before `Stacks.Chow.powerSumChernElem` pushes it into the ambient ring of graded cap families.
Dividing by `p!` needs the value where the multiplication is commutative, so that the division
can be performed by tensoring the subring with `𝐐`. -/
def powerSumChernSub (F : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] (p : ℕ) :
    chernSubring C sX :=
  AlgebraicGeometry.powerSumOfChernClasses (A := chernSubring C sX) r
    (fun i : ℕ+ => chernClassSub C sX F r (i : ℕ)) p

/-- The image of `Stacks.Chow.powerSumChernSub` in the ring of graded cap families is
`Stacks.Chow.powerSumChernElem`. -/
@[simp]
theorem coe_powerSumChernSub (F : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] (p : ℕ) :
    ((powerSumChernSub C sX F r p : chernSubring C sX) : GradedCapFamily (chowGroup C sX))
      = powerSumChernElem C sX F r p :=
  rfl

/-- The commutative subring generated by the Chern classes, with rational coefficients: the ring
`Stacks.Chow.chernSubring ⊗_𝐙 𝐐`, in which the factorials `p!` are invertible and so the Chern
character `ch_p(ℱ) = P_p(ℱ)/p!` can be formed. The rational factor is written first, matching
`Stacks.Chow.rationalChowCohomologyComponent`. -/
abbrev rationalChernSubring := TensorProduct ℤ ℚ (chernSubring C sX)

/-- **The degree-`p` piece `ch_p(ℱ) = P_p(c_1(ℱ), …, c_p(ℱ))/p!` of the Chern character** of a
finite locally free `𝒪_X`-module of constant rank `r`, as an element of the commutative ring
`Stacks.Chow.rationalChernSubring`. -/
def rationalChernCharacter (F : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] (p : ℕ) :
    rationalChernSubring C sX :=
  ((Nat.factorial p : ℚ)⁻¹) ⊗ₜ[ℤ] powerSumChernSub C sX F r p

/-- **The Chern character `ch(ℱ) = ∑_{p ≥ 0} ch_p(ℱ)`** of a finite locally free `𝒪_X`-module of
constant rank `r`, as a formal power series over `Stacks.Chow.rationalChernSubring` whose
coefficient in degree `p` is `ch_p(ℱ)`.

The variable is bookkeeping for the grading: `PowerSeries A` is the product `∏_{p ≥ 0} A` with
the convolution multiplication, which is the home the source's Chern character has — Stacks 0ESX
places `ch(ℱ)` in `∏_{p ≥ 0} (A^p(X) ⊗ 𝐐)` and multiplies two such families degree by degree. So
an identity between two of these power series is exactly an identity between two Chern
characters. -/
def totalRationalChernCharacter (F : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] :
    PowerSeries (rationalChernSubring C sX) :=
  PowerSeries.mk fun p => rationalChernCharacter C sX F r p

/-- The degree-`p` coefficient of `ch(ℱ)` is `ch_p(ℱ)`. -/
@[simp]
theorem coeff_totalRationalChernCharacter (F : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] (p : ℕ) :
    PowerSeries.coeff p (totalRationalChernCharacter C sX F r)
      = rationalChernCharacter C sX F r p :=
  PowerSeries.coeff_mk p _

set_option synthInstance.maxHeartbeats 200000 in
/-- **Stacks 0F9D in the commutative subring.** `Stacks.Chow.powerSumChernElem_tensorObj` read
back inside `Stacks.Chow.chernSubring`, where the identity was proved before being pushed into
the ambient ring: the inclusion of the subring is injective, so the two statements are
equivalent. -/
theorem powerSumChernSub_tensorObj (E₁ E₂ : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₂ s] (p : ℕ) :
    powerSumChernSub C sX (Scheme.Modules.tensorObj E₁ E₂) (r * s) p
      = ∑ q ∈ Finset.HasAntidiagonal.antidiagonal p,
          (p.choose q.1 : chernSubring C sX) *
            (powerSumChernSub C sX E₁ r q.1 * powerSumChernSub C sX E₂ s q.2) := by
  refine Subtype.ext ?_
  simpa using powerSumChernElem_tensorObj C sX E₁ E₂ r s p

/-- **Stacks 0F9D, the headline identity in each degree.** For `ℰ₁` and `ℰ₂` finite locally free
of constant ranks `r` and `s` and every `p ≥ 0`,

  `ch_p(ℰ₁ ⊗_{𝒪_X} ℰ₂) = ∑_{p₁ + p₂ = p} ch_{p₁}(ℰ₁) ch_{p₂}(ℰ₂)`.

This is `Stacks.Chow.powerSumChernElem_tensorObj` divided by `p!`. The source's binomial
coefficient disappears exactly because

  `C(p, p₁)/p! = 1/(p₁! p₂!)` whenever `p₁ + p₂ = p`,

which is `Nat.add_choose_mul_factorial_mul_factorial`: from `C(p, p₁) · p₂! · p₁! = p!` one gets
`C(p, p₁)/p! = 1/(p₁! p₂!)` in `𝐐`, so the `p₁`-th summand
`C(p, p₁) · P_{p₁}(ℰ₁) P_{p₂}(ℰ₂)/p!` is `(P_{p₁}(ℰ₁)/p₁!) · (P_{p₂}(ℰ₂)/p₂!)`. -/
theorem rationalChernCharacter_tensorObj (E₁ E₂ : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₂ s] (p : ℕ) :
    rationalChernCharacter C sX (Scheme.Modules.tensorObj E₁ E₂) (r * s) p
      = ∑ q ∈ Finset.HasAntidiagonal.antidiagonal p,
          rationalChernCharacter C sX E₁ r q.1 * rationalChernCharacter C sX E₂ s q.2 := by
  have hns : ∀ (k : ℕ) (a : ℚ) (x : chernSubring C sX),
      a ⊗ₜ[ℤ] (k • x) = k • (a ⊗ₜ[ℤ] x) := fun k a x =>
    map_nsmul (TensorProduct.mk ℤ ℚ (chernSubring C sX) a) k x
  have hns' : ∀ (k : ℕ) (a : ℚ) (x : chernSubring C sX),
      (k • a) ⊗ₜ[ℤ] x = k • (a ⊗ₜ[ℤ] x) := fun k a x =>
    map_nsmul ((TensorProduct.mk ℤ ℚ (chernSubring C sX)).flip x) k a
  rw [rationalChernCharacter, powerSumChernSub_tensorObj C sX E₁ E₂ r s p,
    TensorProduct.tmul_sum]
  refine Finset.sum_congr rfl fun q hq => ?_
  have hq' : q.1 + q.2 = p := Finset.HasAntidiagonal.mem_antidiagonal.mp hq
  rw [rationalChernCharacter, rationalChernCharacter, Algebra.TensorProduct.tmul_mul_tmul,
    ← nsmul_eq_mul, hns, ← hns', nsmul_eq_mul]
  have hfac : p.choose q.1 * Nat.factorial q.2 * Nat.factorial q.1 = Nat.factorial p := by
    have h := Nat.add_choose_mul_factorial_mul_factorial q.2 q.1
    rwa [Nat.add_comm q.2 q.1, hq'] at h
  have hfacQ : (p.choose q.1 : ℚ) * (Nat.factorial q.2 : ℚ) * (Nat.factorial q.1 : ℚ)
      = (Nat.factorial p : ℚ) := by exact_mod_cast congrArg (fun n : ℕ => (n : ℚ)) hfac
  congr 1
  field_simp
  linear_combination hfacQ

/-- **The headline identity of Stacks 0F9D in the cap-operator ring, for constant ranks.** Let
`(S, δ)` be the situation of Stacks 02QL, let `X` be locally of finite type over `S` and let `ℰ₁`
and `ℰ₂` be finite locally free `𝒪_X`-modules of constant ranks `r` and `s`. Then

  `ch(ℰ₁ ⊗_{𝒪_X} ℰ₂) = ch(ℰ₁) ch(ℰ₂)`.

Both sides are power series over `Stacks.Chow.rationalChernSubring`, whose degree-`p`
coefficient is `ch_p = P_p/p!`; multiplying two such series convolves their coefficients, so this
single identity is `Stacks.Chow.rationalChernCharacter_tensorObj` in every degree at once, and
that in turn is `Stacks.Chow.powerSumChernElem_tensorObj` divided by `p!`.

Stacks 0F9D itself is `Stacks.Chow.totalChernCharacterArbitraryRank_tensorObj`, which reads `ch`
in `A^*(X) ⊗ 𝐐` and assumes no rank. -/
theorem totalRationalChernCharacter_tensorObj (E₁ E₂ : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₂ s] :
    totalRationalChernCharacter C sX (Scheme.Modules.tensorObj E₁ E₂) (r * s)
      = totalRationalChernCharacter C sX E₁ r * totalRationalChernCharacter C sX E₂ s := by
  refine PowerSeries.ext fun p => ?_
  rw [PowerSeries.coeff_mul, coeff_totalRationalChernCharacter]
  simp only [coeff_totalRationalChernCharacter]
  exact rationalChernCharacter_tensorObj C sX E₁ E₂ r s p

/-! ### The Chern character is additive on a short exact sequence -/

/-- **`P_p` of the Chern classes is the logarithmic-derivative power sum in positive degrees.**
`Stacks.Chow.powerSumChernElem` is Newton's recursion of Stacks 0F9B started at the rank, so
`P_0(ℱ) = r`, while `Stacks.Chow.powerSumFamily` is the signed index-`p` component of the
logarithmic derivative of the total Chern class, which follows the convention `P_0 = 0`. For
`p ≥ 1` the degree-zero term never enters the recursion
(`AlgebraicGeometry.newtonPowerSum_eq_of_pos`), so the two spellings of `P_p` agree. This is the
bridge between the additivity proved in
`Stacks.Chow.GenuineChern.powerSumFamily_chernFamily_eq_add_of_shortExact` and the form the
Chern character is built from. -/
theorem powerSumChernElem_eq_powerSumFamily_of_pos (F : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] {p : ℕ}
    (hp : 0 < p) :
    powerSumChernElem C sX F r p = powerSumFamily (GenuineChern.chernFamily C sX F r) p := by
  have hmap := AlgebraicGeometry.map_newtonPowerSum (Subring.subtype (chernSubring C sX))
    ((r : ℕ) : chernSubring C sX) (fun i : ℕ+ => chernClassSub C sX F r (i : ℕ)) p
  simp only [Subring.coe_subtype, map_natCast, coe_chernClassSub] at hmap
  have h0 : powerSumChernElem C sX F r p
      = ((AlgebraicGeometry.newtonPowerSum ((r : ℕ) : chernSubring C sX)
          (fun i : ℕ+ => chernClassSub C sX F r (i : ℕ)) p : chernSubring C sX) :
            GradedCapFamily (chowGroup C sX)) := by
    rw [AlgebraicGeometry.newtonPowerSum_eq_powerSumOfChernClasses]
    rfl
  rw [h0, hmap, AlgebraicGeometry.newtonPowerSum_eq_of_pos _
      (0 : GradedCapFamily (chowGroup C sX)) _ p hp,
    ← powerSumFamily_eq_newtonPowerSum (GenuineChern.chernFamily_apply_zero C sX F r)]

/-- **The additivity for `Stacks.Chow.powerSumChernElem`.** For a short exact sequence
`0 ⟶ ℰ₁ ⟶ ℰ ⟶ ℰ₂ ⟶ 0` of finite locally free modules, with `ℰ₁` of rank `r₁` and `ℰ₂` of rank
`r₂`, `P_p(ℰ) = P_p(ℰ₁) + P_p(ℰ₂)` for the spelling of `P_p` that starts Newton's recursion at
the rank. In degree zero this is the additivity `r₁ + r₂ = r₁ + r₂` of the ranks and in positive
degrees it is
`Stacks.Chow.GenuineChern.powerSumFamily_chernFamily_eq_add_of_shortExact` read through
`Stacks.Chow.powerSumChernElem_eq_powerSumFamily_of_pos`. -/
theorem powerSumChernElem_eq_add_of_shortExact (S : ShortComplex X.Modules)
    (exact_S : S.ShortExact) (r₁ r₂ : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₃ r₂] (p : ℕ) :
    haveI := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S exact_S r₁ r₂ ‹_› ‹_›
    powerSumChernElem C sX S.X₂ (r₁ + r₂) p
      = powerSumChernElem C sX S.X₁ r₁ p + powerSumChernElem C sX S.X₃ r₂ p := by
  have := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S exact_S r₁ r₂ ‹_› ‹_›
  rcases Nat.eq_zero_or_pos p with hp | hp
  · subst hp
    rw [powerSumChernElem_zero, powerSumChernElem_zero, powerSumChernElem_zero, Nat.cast_add]
  · rw [powerSumChernElem_eq_powerSumFamily_of_pos C sX S.X₂ (r₁ + r₂) hp,
      powerSumChernElem_eq_powerSumFamily_of_pos C sX S.X₁ r₁ hp,
      powerSumChernElem_eq_powerSumFamily_of_pos C sX S.X₃ r₂ hp,
      GenuineChern.powerSumFamily_chernFamily_eq_add_of_shortExact C sX S exact_S r₁ r₂ p]

set_option synthInstance.maxHeartbeats 200000 in
/-- **The additivity in the commutative subring.**
`Stacks.Chow.powerSumChernElem_eq_add_of_shortExact`
read back inside `Stacks.Chow.chernSubring`, where dividing by `p!` is possible: the inclusion of
the subring is injective, so the two statements are equivalent. -/
theorem powerSumChernSub_eq_add_of_shortExact (S : ShortComplex X.Modules)
    (exact_S : S.ShortExact) (r₁ r₂ : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₃ r₂] (p : ℕ) :
    haveI := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S exact_S r₁ r₂ ‹_› ‹_›
    powerSumChernSub C sX S.X₂ (r₁ + r₂) p
      = powerSumChernSub C sX S.X₁ r₁ p + powerSumChernSub C sX S.X₃ r₂ p := by
  have := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S exact_S r₁ r₂ ‹_› ‹_›
  refine Subtype.ext ?_
  simpa using powerSumChernElem_eq_add_of_shortExact C sX S exact_S r₁ r₂ p

/-- **The headline additivity in each degree.** For a short exact sequence
`0 ⟶ ℰ₁ ⟶ ℰ ⟶ ℰ₂ ⟶ 0` of finite locally free `𝒪_X`-modules, with `ℰ₁` of rank `r₁` and `ℰ₂` of
rank `r₂`, and every `p ≥ 0`,

  `ch_p(ℰ) = ch_p(ℰ₁) + ch_p(ℰ₂)`.

This is `Stacks.Chow.powerSumChernSub_eq_add_of_shortExact` divided by `p!`: no binomial
coefficient intervenes, the division of a sum by a scalar being term by term. -/
theorem rationalChernCharacter_eq_add_of_shortExact (S : ShortComplex X.Modules)
    (exact_S : S.ShortExact) (r₁ r₂ : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₃ r₂] (p : ℕ) :
    haveI := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S exact_S r₁ r₂ ‹_› ‹_›
    rationalChernCharacter C sX S.X₂ (r₁ + r₂) p
      = rationalChernCharacter C sX S.X₁ r₁ p + rationalChernCharacter C sX S.X₃ r₂ p := by
  have := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S exact_S r₁ r₂ ‹_› ‹_›
  rw [rationalChernCharacter, rationalChernCharacter, rationalChernCharacter,
    powerSumChernSub_eq_add_of_shortExact C sX S exact_S r₁ r₂ p, TensorProduct.tmul_add]

/-- **The headline additivity for the cap-family Chern character.** Let `(S, δ)` be the situation
of Stacks 02QL, let `X` be locally of finite type over `S` and let

  `0 ⟶ ℰ₁ ⟶ ℰ ⟶ ℰ₂ ⟶ 0`

be a short exact sequence of finite locally free `𝒪_X`-modules, with `ℰ₁` of rank `r₁` and `ℰ₂`
of rank `r₂`. Then

  `ch(ℰ) = ch(ℰ₁) + ch(ℰ₂)`.

Both sides are power series over `Stacks.Chow.rationalChernSubring`, whose degree-`p` coefficient
is `ch_p = P_p/p!`; addition of power series is coefficientwise, so this single identity is
`Stacks.Chow.rationalChernCharacter_eq_add_of_shortExact` in every degree at once, and that in
turn is `Stacks.Chow.GenuineChern.powerSumFamily_chernFamily_eq_add_of_shortExact` divided by
`p!`.

This is the constant-rank form of the headline equality of Stacks 0F9C, in the ring where the
constant-rank multiplicative identity of Stacks 0F9D is also formed. The tag is registered on
`Stacks.Chow.moduleChernCharacter_eq_add_of_shortExact`, which states the equality in the
rational Chow cohomology `A^p(X) ⊗ 𝐐` with no constancy of the ranks assumed. -/
theorem totalRationalChernCharacter_eq_add_of_shortExact (S : ShortComplex X.Modules)
    (exact_S : S.ShortExact) (r₁ r₂ : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₃ r₂] :
    haveI := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S exact_S r₁ r₂ ‹_› ‹_›
    totalRationalChernCharacter C sX S.X₂ (r₁ + r₂)
      = totalRationalChernCharacter C sX S.X₁ r₁ + totalRationalChernCharacter C sX S.X₃ r₂ := by
  have := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S exact_S r₁ r₂ ‹_› ‹_›
  refine PowerSeries.ext fun p => ?_
  rw [map_add, coeff_totalRationalChernCharacter, coeff_totalRationalChernCharacter,
    coeff_totalRationalChernCharacter]
  exact rationalChernCharacter_eq_add_of_shortExact C sX S exact_S r₁ r₂ p

end Stacks.Chow

