module

public import StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.TensorChernClassesTotal
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.TwistFormula
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.TotalClassRestriction
public import StacksFrontier.AlgebraicGeometry.Chow.ChernWhitney.WhitneyChowCohomology
public import StacksCore.Tactic.StacksAttribute

/-!
# The Chern classes of a tensor product in the Chow cohomology ring

Let `(S, δ)` be as in Situation 02QL, let `X` be locally of finite type over `S`, and let `ℰ`,
`ℱ` be finite locally free `𝒪_X`-modules of ranks `r` and `s`.
[Stacks, Tag 0FA6](https://stacks.math.columbia.edu/tag/0FA6) states

  `c₁(ℰ ⊗ ℱ) = r c₁(ℱ) + s c₁(ℰ)`,

  `c₂(ℰ ⊗ ℱ) = r c₂(ℱ) + s c₂(ℰ) + C(r,2) c₁(ℱ)² + (rs − 1) c₁(ℱ) c₁(ℰ) + C(s,2) c₁(ℰ)²`

in the Chow cohomology ring `A^*(X)`. Here `c_i(ℱ) ∈ A^i(X)` is the bivariant Chern class of
[Stacks, Tag 0B7H] (zero for `i` above the rank), and the products are those of
[Stacks, Tag 0B75].

Both identities are proved here in two rings: in the ring `∏_{p ≥ 0} A^p(X)` of total classes
(`Stacks.Chow.TotalChowClass`), and in the graded ring `A^*(X) = ⨁_p A^p(X)` of [Stacks, Tag 0B7E]
(`Stacks.Chow.chowCohomology` with `Stacks.Chow.chowCohomologyRingOfInvertible`).

## The proof

A total class is determined by its operations on the Chow groups of the schemes `g : T ⟶ X`
locally of finite type over `X` (`Stacks.Chow.TotalChowClass.ext_op`), and the operation is a ring
homomorphism to the graded cap families on `T`. The class `c(ℱ)` operates on `T` as the total
Chern class of `g^*ℱ` (`Stacks.Chow.op_totalChern`), and `g^*(ℰ ⊗ ℱ) ≅ g^*ℰ ⊗ g^*ℱ`. So the
identity on total classes is the identity of graded cap families on every `T`, which is
`Stacks.Chow.chernClassSub_tensorObj_one` and `Stacks.Chow.chernClassSub_tensorObj_two`: the
splitting principle of [Stacks, Tag 02UL] reduces them to modules with invertible quotients,
whose Chern roots `x_i + y_j` give the identities by the formal computation the source omits.

The identity in `A^*(X)` follows by truncating to the degrees `≤ 2`: truncation is additive and
multiplicative on classes of bounded degree
(`Stacks.Chow.TotalChowClass.toChowCohomology_mul`).

## Main definitions

* `Stacks.Chow.chernClassChowCohomology` — the class `c_i(ℱ) ∈ A^i(X) ⊆ A^*(X)`.

## Main results

* `Stacks.Chow.totalChern_tensorObj_homComponent_one`,
  `Stacks.Chow.totalChern_tensorObj_homComponent_two` — the two identities in `∏_p A^p(X)`.
* `Stacks.Chow.chernClass_tensorObj_one_chowCohomology`,
  `Stacks.Chow.chernClass_tensorObj_two_chowCohomology` — **Stacks 0FA6**, the two identities in
  `A^*(X)`.

## References

* [Stacks Project, Tag 0FA6](https://stacks.math.columbia.edu/tag/0FA6)
* [Stacks Project, Tag 02UL](https://stacks.math.columbia.edu/tag/02UL)
* [Stacks Project, Tag 0B7E](https://stacks.math.columbia.edu/tag/0B7E)
* [Stacks Project, Tag 0B7H](https://stacks.math.columbia.edu/tag/0B7H)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Finset

universe u

namespace Stacks.Chow

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

attribute [local instance] isFiniteLocallyFreeOfRank_tensorObj_mul

/-! ### The identities on graded cap families -/

section CapFamily

open scoped IsMulCommutative

/-- The second identity of Stacks 0FA6 in the commutative ring generated by the Chern classes,
in the order and with the coefficients of the source. -/
theorem chernClassSub_tensorObj_two_source (E F : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s] :
    chernClassSub C sX (Scheme.Modules.tensorObj E F) (r * s) 2
      = r • chernClassSub C sX F s 2 + s • chernClassSub C sX E r 2
        + r.choose 2 • (chernClassSub C sX F s 1 * chernClassSub C sX F s 1)
        + ((r * s : ℤ) - 1) • (chernClassSub C sX F s 1 * chernClassSub C sX E r 1)
        + s.choose 2 • (chernClassSub C sX E r 1 * chernClassSub C sX E r 1) := by
  rw [chernClassSub_tensorObj_two C sX E F r s]
  simp only [nsmul_eq_mul, zsmul_eq_mul]
  push_cast
  ring

set_option synthInstance.maxHeartbeats 100000 in
-- instance search in the `simpa` over the Chern subring and graded cap families is slow
/-- **The first identity of Stacks 0FA6 on graded cap families**: on every scheme locally of
finite type over the base, `c₁(ℰ ⊗ ℱ) = r c₁(ℱ) + s c₁(ℰ)` for the total Chern classes of
Stacks 02U6 in the ring of graded cap families. -/
theorem homComponent_chernFamily_tensorObj_one (E F : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s] :
    homComponent 1 (GenuineChern.chernFamily C sX (Scheme.Modules.tensorObj E F) (r * s))
      = r • homComponent 1 (GenuineChern.chernFamily C sX F s)
        + s • homComponent 1 (GenuineChern.chernFamily C sX E r) := by
  rw [add_comm]
  simpa only [map_add, map_mul, map_natCast, nsmul_eq_mul, Subring.coe_subtype,
    coe_chernClassSub] using
    congrArg (Subring.subtype (chernSubring C sX)) (chernClassSub_tensorObj_one C sX E F r s)

set_option synthInstance.maxHeartbeats 100000 in
-- instance search in the `simpa` over the Chern subring and graded cap families is slow
/-- **The second identity of Stacks 0FA6 on graded cap families**: on every scheme locally of
finite type over the base,
`c₂(ℰ ⊗ ℱ) = r c₂(ℱ) + s c₂(ℰ) + C(r,2) c₁(ℱ)² + (rs − 1) c₁(ℱ) c₁(ℰ) + C(s,2) c₁(ℰ)²` for the
total Chern classes of Stacks 02U6 in the ring of graded cap families. -/
theorem homComponent_chernFamily_tensorObj_two (E F : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s] :
    homComponent 2 (GenuineChern.chernFamily C sX (Scheme.Modules.tensorObj E F) (r * s))
      = r • homComponent 2 (GenuineChern.chernFamily C sX F s)
        + s • homComponent 2 (GenuineChern.chernFamily C sX E r)
        + r.choose 2 • (homComponent 1 (GenuineChern.chernFamily C sX F s) *
            homComponent 1 (GenuineChern.chernFamily C sX F s))
        + ((r * s : ℤ) - 1) • (homComponent 1 (GenuineChern.chernFamily C sX F s) *
            homComponent 1 (GenuineChern.chernFamily C sX E r))
        + s.choose 2 • (homComponent 1 (GenuineChern.chernFamily C sX E r) *
            homComponent 1 (GenuineChern.chernFamily C sX E r)) := by
  simpa only [map_add, map_mul, map_nsmul, map_zsmul, Subring.coe_subtype,
    coe_chernClassSub] using
    congrArg (Subring.subtype (chernSubring C sX)) (chernClassSub_tensorObj_two_source C sX E F r s)

end CapFamily

/-! ### The identities in the ring of total classes -/

section Total

/-- The operation of a total class commutes with natural multiples. -/
theorem TotalChowClass.op_nsmul (n : ℕ) (c : TotalChowClass C sX) {T : Scheme.{u}}
    (g : T ⟶ X) [LocallyOfFiniteType g] : (n • c).op g = n • c.op g :=
  map_nsmul (TotalChowClass.opHom g) n c

/-- On a test scheme `g : T ⟶ X`, the degree-`i` component of the total Chern class of `ℰ ⊗ ℱ`
operates as that of `g^*ℰ ⊗ g^*ℱ`. -/
theorem op_homComponent_totalChern_tensorObj (E F : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s] (i : ℕ)
    {T : Scheme.{u}} (g : T ⟶ X) [LocallyOfFiniteType g] :
    haveI := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback g E r
    haveI := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback g F s
    haveI := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback g
      (Scheme.Modules.tensorObj E F) (r * s)
    (TotalChowClass.homComponent i (totalChern C sX (Scheme.Modules.tensorObj E F) (r * s))).op g
      = homComponent i (GenuineChern.chernFamily C (g ≫ sX)
          (Scheme.Modules.tensorObj ((Scheme.Modules.pullback g).obj E)
            ((Scheme.Modules.pullback g).obj F)) (r * s)) := by
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback g E r
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback g F s
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback g
    (Scheme.Modules.tensorObj E F) (r * s)
  rw [TotalChowClass.op_homComponent, op_totalChern,
    GenuineChern.chernFamily_congr C (g ≫ sX) _ _ (pullbackTensorObjIso g E F) rfl]

/-- On a test scheme `g : T ⟶ X`, the degree-`i` component of `c(ℱ)` operates as that of
`c(g^*ℱ)`. -/
theorem op_homComponent_totalChern (F : X.Modules) (s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s] (i : ℕ)
    {T : Scheme.{u}} (g : T ⟶ X) [LocallyOfFiniteType g] :
    haveI := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback g F s
    (TotalChowClass.homComponent i (totalChern C sX F s)).op g
      = homComponent i (GenuineChern.chernFamily C (g ≫ sX)
          ((Scheme.Modules.pullback g).obj F) s) := by
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback g F s
  rw [TotalChowClass.op_homComponent, op_totalChern]

/-- **The first identity of Stacks 0FA6 in `∏_{p ≥ 0} A^p(X)`**: for `ℰ`, `ℱ` finite locally free
of ranks `r` and `s`, `c₁(ℰ ⊗ ℱ) = r c₁(ℱ) + s c₁(ℰ)` for the degree-`1` components of the total
Chern classes. -/
theorem totalChern_tensorObj_homComponent_one (E F : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s] :
    TotalChowClass.homComponent 1 (totalChern C sX (Scheme.Modules.tensorObj E F) (r * s))
      = r • TotalChowClass.homComponent 1 (totalChern C sX F s)
        + s • TotalChowClass.homComponent 1 (totalChern C sX E r) := by
  refine TotalChowClass.ext_op fun g _ ↦ ?_
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback g E r
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback g F s
  rw [TotalChowClass.op_add, TotalChowClass.op_nsmul, TotalChowClass.op_nsmul,
    op_homComponent_totalChern_tensorObj, op_homComponent_totalChern,
    op_homComponent_totalChern]
  exact homComponent_chernFamily_tensorObj_one C (g ≫ sX) _ _ r s

/-- **The second identity of Stacks 0FA6 in `∏_{p ≥ 0} A^p(X)`**: for `ℰ`, `ℱ` finite locally
free of ranks `r` and `s`,
`c₂(ℰ ⊗ ℱ) = r c₂(ℱ) + s c₂(ℰ) + C(r,2) c₁(ℱ)² + (rs − 1) c₁(ℱ) c₁(ℰ) + C(s,2) c₁(ℰ)²` for the
homogeneous components of the total Chern classes, the products being those of the ring of total
classes. -/
theorem totalChern_tensorObj_homComponent_two (E F : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s] :
    TotalChowClass.homComponent 2 (totalChern C sX (Scheme.Modules.tensorObj E F) (r * s))
      = r • TotalChowClass.homComponent 2 (totalChern C sX F s)
        + s • TotalChowClass.homComponent 2 (totalChern C sX E r)
        + r.choose 2 • (TotalChowClass.homComponent 1 (totalChern C sX F s) *
            TotalChowClass.homComponent 1 (totalChern C sX F s))
        + ((r * s : ℤ) - 1) • (TotalChowClass.homComponent 1 (totalChern C sX F s) *
            TotalChowClass.homComponent 1 (totalChern C sX E r))
        + s.choose 2 • (TotalChowClass.homComponent 1 (totalChern C sX E r) *
            TotalChowClass.homComponent 1 (totalChern C sX E r)) := by
  refine TotalChowClass.ext_op fun g _ ↦ ?_
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback g E r
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback g F s
  simp only [TotalChowClass.op_add, TotalChowClass.op_nsmul, TotalChowClass.op_zsmul,
    TotalChowClass.op_mul]
  rw [op_homComponent_totalChern_tensorObj, op_homComponent_totalChern C sX F s 2,
    op_homComponent_totalChern C sX E r 2, op_homComponent_totalChern C sX F s 1,
    op_homComponent_totalChern C sX E r 1]
  exact homComponent_chernFamily_tensorObj_two C (g ≫ sX) _ _ r s

end Total

/-! ### The identities in the Chow cohomology ring `A^*(X)` -/

section ChowCohomology

namespace TotalChowClass

/-- Truncation of total classes to the degrees `< N`, as an additive map. -/
def toChowCohomologyHom (N : ℕ) :
    TotalChowClass C sX →+ chowCohomology C (gysinSystemOfInvertible C) sX where
  toFun := toChowCohomology C sX N
  map_zero' := toChowCohomology_zero N
  map_add' c d := by
    simp only [toChowCohomology, add_apply, map_add, sum_add_distrib]

/-- The additive map `Stacks.Chow.TotalChowClass.toChowCohomologyHom` evaluates to the
truncation. -/
theorem toChowCohomologyHom_apply (N : ℕ) (c : TotalChowClass C sX) :
    toChowCohomologyHom C sX N c = toChowCohomology C sX N c :=
  rfl

/-- The truncation below `N` of a homogeneous component of degree `i < N` is that component,
placed in `A^*(X)`. -/
theorem toChowCohomology_homComponent {N i : ℕ} (hi : i < N) (c : TotalChowClass C sX) :
    toChowCohomology C sX N (homComponent i c) = DirectSum.of _ (i : ℤ) (c i) := by
  rw [toChowCohomology, Finset.sum_eq_single_of_mem i (mem_range.mpr hi)]
  · rw [homComponent_apply, ite_eq_left rfl]
  · intro m _ hm
    rw [homComponent_apply, ite_eq_right hm, map_zero]

/-- The truncation below `3` of a product of two degree-`1` components is the product in `A^*(X)`
of the two components. -/
theorem toChowCohomology_three_homComponent_one_mul (c d : TotalChowClass C sX) :
    letI := chowCohomologyRingOfInvertible C sX
    toChowCohomology C sX 3 (homComponent 1 c * homComponent 1 d) =
      DirectSum.of _ ((1 : ℕ) : ℤ) (c 1) * DirectSum.of _ ((1 : ℕ) : ℤ) (d 1) := by
  let := chowCohomologyRingOfInvertible C sX
  have h := toChowCohomology_mul (homComponent 1 c) (homComponent 1 d) 1 1
    (fun i hi ↦ by rw [homComponent_apply, ite_eq_right (by omega)])
    (fun i hi ↦ by rw [homComponent_apply, ite_eq_right (by omega)])
  refine h.trans ?_
  rw [toChowCohomology_homComponent C sX (by omega), toChowCohomology_homComponent C sX (by omega)]

end TotalChowClass

/-- **The `i`-th Chern class in `A^*(X)`.** For `𝒢` finite locally free of rank `t`, the class
`c_i(𝒢) ∈ A^i(X) ⊆ A^*(X)`: the bivariant Chern class of Stacks 0B7H for `i ≤ t`, and `0` for
`i > t`, placed in degree `i` of the Chow cohomology ring of Stacks 0B7E. -/
def chernClassChowCohomology (G : X.Modules) (t : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} G t] (i : ℕ) :
    chowCohomology C (gysinSystemOfInvertible C) sX :=
  DirectSum.of _ (i : ℤ) (totalChern C sX G t i)

/-- In degrees `i ≤ t` the class `c_i(𝒢) ∈ A^*(X)` is the bivariant Chern class `c_i(𝒢)` of
Stacks 0B7H. -/
theorem chernClassChowCohomology_eq (G : X.Modules) (t : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} G t] (i : Fin (t + 1)) :
    chernClassChowCohomology C sX G t i =
      DirectSum.of _ (i : ℤ) (GenuineChern.chernClass C sX G t i) := by
  rw [chernClassChowCohomology, totalChern_apply]

/-- In degrees `i > t` the class `c_i(𝒢) ∈ A^*(X)` vanishes. -/
theorem chernClassChowCohomology_of_lt (G : X.Modules) (t : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} G t] {i : ℕ}
    (hi : t < i) : chernClassChowCohomology C sX G t i = 0 := by
  rw [chernClassChowCohomology, totalChern_apply_of_lt C sX G t hi, map_zero]

/-- The total Chern class `c(𝒢) ∈ A^*(X)` is the sum of the classes `c_i(𝒢)`, `i ≤ t`. -/
theorem totalChernClassCohomology_eq_sum (G : X.Modules) (t : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} G t] :
    totalChernClassCohomology C sX G t =
      ∑ i : Fin (t + 1), chernClassChowCohomology C sX G t i :=
  Finset.sum_congr rfl fun i _ ↦ (chernClassChowCohomology_eq C sX G t i).symm

/-- **Stacks 0FA6, the first displayed identity.** Let `X` be locally of finite type over the base
and `ℰ`, `ℱ` finite locally free `𝒪_X`-modules of ranks `r` and `s`. Then

  `c₁(ℰ ⊗ ℱ) = r c₁(ℱ) + s c₁(ℰ)`

in the Chow cohomology ring `A^*(X)` of Stacks 0B7E, `c₁` being the bivariant Chern class of
Stacks 0B7H. -/
@[stacks 0FA6 "first displayed identity: for X locally of finite type over the base and \
finite locally free E, F of ranks r and s, c_1(E ⊗ F) = r c_1(F) + s c_1(E) in the Chow \
cohomology ring A^*(X) (Stacks 0B7E), c_1 the bivariant Chern class of Stacks 0B7H and E ⊗ F \
the module Scheme.Modules.tensorObj E F of rank r*s (Stacks 02U9)"]
theorem chernClass_tensorObj_one_chowCohomology (E F : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s] :
    chernClassChowCohomology C sX (Scheme.Modules.tensorObj E F) (r * s) 1
      = r • chernClassChowCohomology C sX F s 1 + s • chernClassChowCohomology C sX E r 1 := by
  simpa only [chernClassChowCohomology, map_add, map_nsmul,
    TotalChowClass.toChowCohomologyHom_apply,
    TotalChowClass.toChowCohomology_homComponent C sX (show 1 < 2 by omega)] using
    congrArg (TotalChowClass.toChowCohomologyHom C sX 2)
      (totalChern_tensorObj_homComponent_one C sX E F r s)

/-- **Stacks 0FA6, the second displayed identity.** Let `X` be locally of finite type over the
base and `ℰ`, `ℱ` finite locally free `𝒪_X`-modules of ranks `r` and `s`. Then

  `c₂(ℰ ⊗ ℱ) = r c₂(ℱ) + s c₂(ℰ) + C(r,2) c₁(ℱ)² + (rs − 1) c₁(ℱ) c₁(ℰ) + C(s,2) c₁(ℰ)²`

in the Chow cohomology ring `A^*(X)` of Stacks 0B7E, `c_i` being the bivariant Chern classes of
Stacks 0B7H and the products those of the ring `A^*(X)`. -/
@[stacks 0FA6 "second displayed identity: for X locally of finite type over the base and \
finite locally free E, F of ranks r and s, c_2(E ⊗ F) = r c_2(F) + s c_2(E) + \
binom(r,2) c_1(F)^2 + (rs - 1) c_1(F) c_1(E) + binom(s,2) c_1(E)^2 in the Chow cohomology \
ring A^*(X) (Stacks 0B7E), with its multiplication, c_i the bivariant Chern classes of \
Stacks 0B7H, rs - 1 taken in ℤ, and E ⊗ F the module Scheme.Modules.tensorObj E F"]
theorem chernClass_tensorObj_two_chowCohomology (E F : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s] :
    letI := chowCohomologyRingOfInvertible C sX
    chernClassChowCohomology C sX (Scheme.Modules.tensorObj E F) (r * s) 2
      = r • chernClassChowCohomology C sX F s 2 + s • chernClassChowCohomology C sX E r 2
        + r.choose 2 • chernClassChowCohomology C sX F s 1 ^ 2
        + ((r * s : ℤ) - 1) •
            (chernClassChowCohomology C sX F s 1 * chernClassChowCohomology C sX E r 1)
        + s.choose 2 • chernClassChowCohomology C sX E r 1 ^ 2 := by
  let := chowCohomologyRingOfInvertible C sX
  have h := congrArg (TotalChowClass.toChowCohomologyHom C sX 3)
    (totalChern_tensorObj_homComponent_two C sX E F r s)
  simp only [map_add, map_nsmul, map_zsmul, TotalChowClass.toChowCohomologyHom_apply,
    TotalChowClass.toChowCohomology_homComponent C sX (show 2 < 3 by omega),
    TotalChowClass.toChowCohomology_three_homComponent_one_mul] at h
  simpa only [chernClassChowCohomology, pow_two] using h

end ChowCohomology

end Stacks.Chow

end
