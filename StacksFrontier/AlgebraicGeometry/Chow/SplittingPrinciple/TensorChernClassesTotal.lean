module

public import StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.ChernPowerSumDescent
public import StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.TensorChernClasses
public import StacksCore.Tactic.StacksAttribute

/-!
# Stacks 0FA6 for arbitrary finite locally free modules

Let `(S, δ)` be the base situation of chapter 42 of the Stacks Project, Stacks 02QL, let `X` be
locally of finite type over `S` and let `ℰ` and `ℱ` be finite locally free `𝒪_X`-modules of
constant ranks `r` and `s`. [Stacks, Tag 0FA6](https://stacks.math.columbia.edu/tag/0FA6) is the
pair of identities

  `c₁(ℰ ⊗_{𝒪_X} ℱ) = r·c₁(ℱ) + s·c₁(ℰ)`,

  `c₂(ℰ ⊗_{𝒪_X} ℱ) = r·c₂(ℱ) + s·c₂(ℰ) + C(r,2)·c₁(ℱ)² + (r·s − 1)·c₁(ℱ)·c₁(ℰ)
      + C(s,2)·c₁(ℰ)²`,

together with the remark "and so on". Both are proved here with no hypothesis beyond the two
ranks, as identities in the commutative ring `Stacks.Chow.chernSubring` generated by the Chern
classes, where `Stacks.Chow.chernClassSub C sX ℰ r i` is `c_i(ℰ)` and the squares and the cross
term are honest products. The trailing "and so on" is not a precise assertion and nothing is
claimed for it.

## The proof

The source argues as in [Stacks, Tag 0FA5](https://stacks.math.columbia.edu/tag/0FA5): choose
`π : P ⟶ X` as in [Stacks, Tag 02UL](https://stacks.math.columbia.edu/tag/02UL), use injectivity
of `π^*` to reduce to the case where `ℰ` and `ℱ` carry filtrations with invertible successive
quotients `ℒ_i` and `𝒩_j`, order the pairs `(i, j)` lexicographically to get a filtration of
`ℰ ⊗ ℱ` with successive quotients `ℒ_i ⊗ 𝒩_j`, so that the Chern roots of `ℰ ⊗ ℱ` are the
`x_i + y_j`, and finish by "a formal computation which we omit".

Every step of that is available in this repository and none of it is assumed. Stacks 02UL is
`Stacks.Chow.exists_splittingMorphism_unconditional`, proved from the flag bundle; the Chern
roots of the three modules upstairs are `Stacks.Chow.hasChernRoots_of_hasQuotients` and
`Stacks.Chow.hasChernRoots_tensorObj_of_hasQuotients`; and the descent along `π^*` is
`Stacks.Chow.eq_of_intertwines`, which Stacks 02U8
(`Stacks.Chow.GenuineChern.intertwines_chernFamily`) feeds. The formal computation the source
omits is `Stacks.Chow.esymRec_two_tensor` of
`StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.TensorChernClasses`, an identity between
elementary symmetric functions of `r + s` commuting variables; the bridge from the elementary
symmetric functions of an unordered family of roots to the Pascal recursion that identity is
stated at is `Stacks.Chow.esymmOfRoots_eq_esymRec`.

## Main results

* `Stacks.Chow.esymmOfRoots_eq_esymRec` — the elementary symmetric functions of a finite family
  of roots, enumerated by a sequence, are `Stacks.Chow.esymRec` of that sequence.
* `Stacks.Chow.esymmOfRoots_lex_one`, `Stacks.Chow.esymmOfRoots_lex_two` — the formal computation
  the source omits, read on the elementary symmetric functions of the family `x_i + y_j`.
* `Stacks.Chow.chernClassSub_tensorObj_one`, `Stacks.Chow.chernClassSub_tensorObj_two` —
  **Stacks 0FA6**, the two displayed identities.

## References

* [Stacks Project, Tag 0FA6](https://stacks.math.columbia.edu/tag/0FA6)
* [Stacks Project, Tag 0FA5](https://stacks.math.columbia.edu/tag/0FA5)
* [Stacks Project, Tag 02UL](https://stacks.math.columbia.edu/tag/02UL)
* [Stacks Project, Tag 02U8](https://stacks.math.columbia.edu/tag/02U8)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Finset

universe u

namespace Stacks.Chow

/-! ### Elementary symmetric functions of a family of roots, by the Pascal recursion -/

section Algebra

variable {A : Type*} [CommRing A]

/-- The Pascal recursion for `Multiset.esymm`. -/
theorem multiset_esymm_cons (a : A) (m : Multiset A) (k : ℕ) :
    (a ::ₘ m).esymm (k + 1) = m.esymm (k + 1) + a * m.esymm k := by
  simp only [Multiset.esymm, Multiset.powersetCard_cons, Multiset.map_add, Multiset.sum_add,
    Multiset.map_map, Function.comp_apply, Multiset.prod_cons]
  rw [Multiset.sum_map_mul_left]

/-- `Stacks.Chow.esymRec` of a sequence is the elementary symmetric function of its first `m`
terms. -/
theorem esymm_range_map_eq_esymRec (w : ℕ → A) (m k : ℕ) :
    ((Multiset.range m).map w).esymm k = esymRec w m k := by
  induction m generalizing k with
  | zero =>
      cases k with
      | zero => simp [esymRec_degree_zero]
      | succ k => rw [esymRec_zero_succ]; exact Multiset.esymm_of_card_lt (by simp)
  | succ m ih =>
      cases k with
      | zero => simp [esymRec_degree_zero]
      | succ k =>
          rw [Multiset.range_succ, Multiset.map_cons, multiset_esymm_cons, ih, ih, esymRec_succ]

/-- **The elementary symmetric functions of a finite family of roots, enumerated by a sequence.**
If `e` numbers the index type `ι` by `0, …, m-1` and the sequence `w` takes the value of the
family at the index with number `k` at `k`, then the `k`-th elementary symmetric function of the
family is `Stacks.Chow.esymRec w m k`. This is the bridge between the unordered families of
`AlgebraicGeometry.HasChernRoots` and the Pascal recursion the formal computation of Stacks 0FA6
is stated at. -/
theorem esymmOfRoots_eq_esymRec {ι : Type*} [Fintype ι] {m : ℕ} (e : ι ≃ Fin m) (z : ι → A)
    (w : ℕ → A) (hw : ∀ a : ι, w ((e a : Fin m) : ℕ) = z a) (k : ℕ) :
    esymmOfRoots z k = esymRec w m k := by
  rw [← esymm_range_map_eq_esymRec w m k]
  have hw' : ∀ i : Fin m, w (i : ℕ) = z (e.symm i) := by
    intro i
    have h := hw (e.symm i)
    rwa [e.apply_symm_apply] at h
  have huniv : (Finset.univ : Finset ι).val
      = (Finset.univ : Finset (Fin m)).val.map e.symm := by
    conv_lhs => rw [← Finset.map_univ_equiv e.symm]
    rw [Finset.map_val]
    rfl
  have hrange : (Finset.univ : Finset (Fin m)).val.map (Fin.val) = Multiset.range m := by
    have h := congrArg Finset.val (Fin.map_valEmbedding_univ (n := m))
    rw [Finset.map_val, Nat.Iio_eq_range, Finset.range_val] at h
    exact h
  change (Multiset.map z Finset.univ.val).esymm k = _
  rw [huniv, ← hrange, Multiset.map_map, Multiset.map_map]
  exact congrArg (fun t => Multiset.esymm t k)
    (Multiset.map_congr rfl fun i _ => (hw' i).symm)

/-- The elementary symmetric functions of a family indexed by `Fin m`. -/
theorem esymmOfRoots_fin_eq_esymRec {m : ℕ} (x : Fin m → A) (w : ℕ → A)
    (hw : ∀ i : Fin m, w (i : ℕ) = x i) (k : ℕ) :
    esymmOfRoots x k = esymRec w m k :=
  esymmOfRoots_eq_esymRec (Equiv.refl _) x w hw k

/-- The elementary symmetric functions of a family indexed by `Fin r × Fin s`, enumerated
lexicographically: the pair `(i, j)` gets the number `i·s + j`. -/
theorem esymmOfRoots_finProd_eq_esymRec {r s : ℕ} (z : Fin r × Fin s → A) (w : ℕ → A)
    (hw : ∀ (i : Fin r) (j : Fin s), w ((i : ℕ) * s + (j : ℕ)) = z (i, j)) (k : ℕ) :
    esymmOfRoots z k = esymRec w (r * s) k := by
  refine esymmOfRoots_eq_esymRec finProdFinEquiv z w (fun a => ?_) k
  have hval : ((finProdFinEquiv a : Fin (r * s)) : ℕ) = (a.1 : ℕ) * s + (a.2 : ℕ) := by
    change (a.2 : ℕ) + s * (a.1 : ℕ) = (a.1 : ℕ) * s + (a.2 : ℕ)
    rw [Nat.mul_comm]
    exact Nat.add_comm _ _
  rw [hval, hw a.1 a.2]

/-- The sequence enumerating the family `x_i + y_j` lexicographically. -/
theorem lexSeq_apply {s : ℕ} (wx wy : ℕ → A) (i j : ℕ) (hj : j < s) :
    wx ((i * s + j) / s) + wy ((i * s + j) % s) = wx i + wy j := by
  have hs : 0 < s := Nat.lt_of_le_of_lt (Nat.zero_le j) hj
  have hdiv : (i * s + j) / s = i := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hs, Nat.div_eq_of_lt hj, Nat.zero_add]
  have hmod : (i * s + j) % s = j := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hj]
  rw [hdiv, hmod]

/-- Sequences enumerating `x`, `y` and the family `x_i + y_j` lexicographically, with the
elementary symmetric functions of the three families as `Stacks.Chow.esymRec`. -/
private theorem exists_esymRec_lex {r s : ℕ} (x : Fin r → A) (y : Fin s → A) :
    ∃ wx wy : ℕ → A, (∀ k, esymmOfRoots x k = esymRec wx r k) ∧
      (∀ k, esymmOfRoots y k = esymRec wy s k) ∧
      (∀ k, esymmOfRoots (fun ij : Fin r × Fin s => x ij.1 + y ij.2) k
        = esymRec (fun k => wx (k / s) + wy (k % s)) (r * s) k) ∧
      ∀ i, i < r → ∀ j, j < s →
        (fun k => wx (k / s) + wy (k % s)) (i * s + j) = wx i + wy j := by
  classical
  obtain ⟨wx, hwx⟩ : ∃ w : ℕ → A, ∀ i : Fin r, w (i : ℕ) = x i :=
    ⟨fun k => if h : k < r then x ⟨k, h⟩ else 0, fun i => dite_eq_left i.isLt⟩
  obtain ⟨wy, hwy⟩ : ∃ w : ℕ → A, ∀ j : Fin s, w (j : ℕ) = y j :=
    ⟨fun k => if h : k < s then y ⟨k, h⟩ else 0, fun j => dite_eq_left j.isLt⟩
  exact ⟨wx, wy, esymmOfRoots_fin_eq_esymRec x wx hwx, esymmOfRoots_fin_eq_esymRec y wy hwy,
    esymmOfRoots_finProd_eq_esymRec _ _
      fun i j => by rw [lexSeq_apply wx wy (i : ℕ) (j : ℕ) j.isLt, hwx i, hwy j],
    fun i _ j hj => lexSeq_apply wx wy i j hj⟩

/-- **The degree-one half of the formal computation the proof of Stacks 0FA6 omits**, read on the
elementary symmetric functions of the family `x_i + y_j`. -/
theorem esymmOfRoots_lex_one {r s : ℕ} (x : Fin r → A) (y : Fin s → A) :
    esymmOfRoots (fun ij : Fin r × Fin s => x ij.1 + y ij.2) 1
      = (s : A) * esymmOfRoots x 1 + (r : A) * esymmOfRoots y 1 := by
  obtain ⟨wx, wy, hx, hy, hxy, hw⟩ := exists_esymRec_lex x y
  rw [hx, hy, hxy, esymRec_one, esymRec_one, esymRec_one]
  exact sum_range_lexFamily wx wy _ r s hw r le_rfl

/-- **The degree-two half of the formal computation the proof of Stacks 0FA6 omits**, read on the
elementary symmetric functions of the family `x_i + y_j`. The cross-term coefficient is
`r·s − 1`. -/
theorem esymmOfRoots_lex_two {r s : ℕ} (x : Fin r → A) (y : Fin s → A) :
    esymmOfRoots (fun ij : Fin r × Fin s => x ij.1 + y ij.2) 2
      = (s : A) * esymmOfRoots x 2 + (r : A) * esymmOfRoots y 2
        + (r.choose 2 : A) * esymmOfRoots y 1 ^ 2
        + ((r : A) * s - 1) * (esymmOfRoots x 1 * esymmOfRoots y 1)
        + (s.choose 2 : A) * esymmOfRoots x 1 ^ 2 := by
  obtain ⟨wx, wy, hx, hy, hxy, hw⟩ := exists_esymRec_lex x y
  rw [hx 1, hx 2, hy 1, hy 2, hxy, esymRec_one, esymRec_one, esymRec_two, esymRec_two,
    esymRec_two]
  exact esymRec_two_tensor wx wy _ r s hw

end Algebra

/-! ### The intertwining relation is closed under subtraction -/

section Descent

universe v

variable {G H : ℤ → Type v} [∀ k, AddCommGroup (G k)] [∀ k, AddCommGroup (H k)] {d : ℤ}
  {pull : ∀ k : ℤ, G k →+ H (k + d)}

/-- An intertwiner of two pairs intertwines their differences. -/
theorem Intertwines.sub {a b : GradedCapFamily G} {a' b' : GradedCapFamily H}
    (ha : Intertwines pull a a') (hb : Intertwines pull b b') :
    Intertwines pull (a - b) (a' - b') := by
  rw [sub_eq_add_neg, sub_eq_add_neg]
  exact ha.add hb.neg

end Descent

/-! ### Stacks 0FA6 -/

section Main

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

attribute [local instance] isFiniteLocallyFreeOfRank_one_of_isInvertible
  isFiniteLocallyFreeOfRank_tensorObj_mul

/-! #### The filtered case the source reduces to -/

/-- **The first displayed identity of Stacks 0FA6 for a pair of filtered modules.** If `ℰ` and
`ℱ` are finite locally free of ranks `r` and `s` and carry filtrations with invertible successive
quotients `ℒ_i` and `𝒩_j`, then `c₁(ℰ ⊗ ℱ) = s·c₁(ℰ) + r·c₁(ℱ)`: the Chern roots of the tensor
product are the `r·s` sums `x_i + y_j`, and
`Stacks.Chow.esymmOfRoots_lex_one` is their first elementary symmetric function. -/
theorem chernClassSub_tensorObj_one_of_hasQuotients (r s : ℕ) (E F : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s]
    (L : Fin r → X.Modules)
    [∀ i, AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property (L i)]
    (N : Fin s → X.Modules)
    [∀ j, AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property (N j)]
    (h₁ : HasQuotients X r E L) (h₂ : HasQuotients X s F N) :
    chernClassSub C sX (Scheme.Modules.tensorObj E F) (r * s) 1
      = (s : chernSubring C sX) * chernClassSub C sX E r 1
        + (r : chernSubring C sX) * chernClassSub C sX F s 1 := by
  have hr1 := hasChernRoots_of_hasQuotients C sX r E L h₁
  have hr2 := hasChernRoots_of_hasQuotients C sX s F N h₂
  have hrT := hasChernRoots_tensorObj_of_hasQuotients C sX r s (r * s) E F L N h₁ h₂ rfl
  have hT1 : chernClassSub C sX (Scheme.Modules.tensorObj E F) (r * s) 1
      = esymmOfRoots (fun ij : Fin r × Fin s =>
          firstChernSub C sX (L ij.1) + firstChernSub C sX (N ij.2)) 1 := hrT.chernClass 1
  have h11 : chernClassSub C sX E r 1
      = esymmOfRoots (fun i : Fin r => firstChernSub C sX (L i)) 1 := hr1.chernClass 1
  have h21 : chernClassSub C sX F s 1
      = esymmOfRoots (fun j : Fin s => firstChernSub C sX (N j)) 1 := hr2.chernClass 1
  rw [hT1, h11, h21]
  exact esymmOfRoots_lex_one (fun i : Fin r => firstChernSub C sX (L i))
    (fun j : Fin s => firstChernSub C sX (N j))

/-- **The second displayed identity of Stacks 0FA6 for a pair of filtered modules.** In the
situation of `Stacks.Chow.chernClassSub_tensorObj_one_of_hasQuotients`,

  `c₂(ℰ ⊗ ℱ) = s·c₂(ℰ) + r·c₂(ℱ) + C(r,2)·c₁(ℱ)² + (r·s − 1)·c₁(ℰ)·c₁(ℱ) + C(s,2)·c₁(ℰ)²`,

which is `Stacks.Chow.esymmOfRoots_lex_two` read on the roots `x_i + y_j`. -/
theorem chernClassSub_tensorObj_two_of_hasQuotients (r s : ℕ) (E F : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s]
    (L : Fin r → X.Modules)
    [∀ i, AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property (L i)]
    (N : Fin s → X.Modules)
    [∀ j, AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property (N j)]
    (h₁ : HasQuotients X r E L) (h₂ : HasQuotients X s F N) :
    chernClassSub C sX (Scheme.Modules.tensorObj E F) (r * s) 2
      = (s : chernSubring C sX) * chernClassSub C sX E r 2
        + (r : chernSubring C sX) * chernClassSub C sX F s 2
        + (r.choose 2 : chernSubring C sX) * chernClassSub C sX F s 1 ^ 2
        + ((r : chernSubring C sX) * s - 1) *
            (chernClassSub C sX E r 1 * chernClassSub C sX F s 1)
        + (s.choose 2 : chernSubring C sX) * chernClassSub C sX E r 1 ^ 2 := by
  have hr1 := hasChernRoots_of_hasQuotients C sX r E L h₁
  have hr2 := hasChernRoots_of_hasQuotients C sX s F N h₂
  have hrT := hasChernRoots_tensorObj_of_hasQuotients C sX r s (r * s) E F L N h₁ h₂ rfl
  have hT2 : chernClassSub C sX (Scheme.Modules.tensorObj E F) (r * s) 2
      = esymmOfRoots (fun ij : Fin r × Fin s =>
          firstChernSub C sX (L ij.1) + firstChernSub C sX (N ij.2)) 2 := hrT.chernClass 2
  have h11 : chernClassSub C sX E r 1
      = esymmOfRoots (fun i : Fin r => firstChernSub C sX (L i)) 1 := hr1.chernClass 1
  have h12 : chernClassSub C sX E r 2
      = esymmOfRoots (fun i : Fin r => firstChernSub C sX (L i)) 2 := hr1.chernClass 2
  have h21 : chernClassSub C sX F s 1
      = esymmOfRoots (fun j : Fin s => firstChernSub C sX (N j)) 1 := hr2.chernClass 1
  have h22 : chernClassSub C sX F s 2
      = esymmOfRoots (fun j : Fin s => firstChernSub C sX (N j)) 2 := hr2.chernClass 2
  rw [hT2, h11, h12, h21, h22]
  exact esymmOfRoots_lex_two (fun i : Fin r => firstChernSub C sX (L i))
    (fun j : Fin s => firstChernSub C sX (N j))

/-! #### The two identities, with nothing beyond the two ranks -/

/-- **Stacks 0FA6, the first displayed identity.** For `ℰ` and `ℱ` finite locally free of
constant ranks `r` and `s`,

  `c₁(ℰ ⊗_{𝒪_X} ℱ) = r·c₁(ℱ) + s·c₁(ℰ)`

in the commutative ring `Stacks.Chow.chernSubring` generated by the Chern classes. Nothing is
assumed beyond the two ranks: the source's reduction to a pair of filtrations with invertible
quotients is performed, by the flag bundle of Stacks 02UL and the injectivity of the flat
pullback it provides. -/
@[stacks 0FA6 "the first displayed identity, with nothing assumed beyond the two ranks.  \
CORRECTION OF FORM: the source states c_1(E tensor F) = r c_1(F) + s c_1(E) in the bivariant \
ring A^*(X).  Here the identity is stated in Stacks.Chow.chernSubring, the commutative ring \
generated by the Chern classes inside the ring of graded cap families, in which \
Stacks.Chow.chernClassSub C sX E r i is c_i(E); it is the same identity read in that \
realisation, and both sides are elements of one commutative ring, so the coefficients r and s \
are ring elements and not scalar actions.  The module on the left is the library's canonical \
tensor product AlgebraicGeometry.Scheme.Modules.tensorObj.  The source's reduction to the \
filtered case is PERFORMED, not assumed: Stacks 02UL is \
Stacks.Chow.exists_splittingMorphism_unconditional, proved from the flag bundle of \
StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.FlagBundle; the Chern roots of the three \
modules on the bundle are Stacks.Chow.hasChernRoots_of_hasQuotients and \
Stacks.Chow.hasChernRoots_tensorObj_of_hasQuotients, which get their filtrations from \
Stacks.Chow.exists_hasQuotients_of_hasInvertibleFiltration; and the descent along the flat \
pullback, injective by clause (1) of Stacks 02UL, is Stacks.Chow.eq_of_intertwines, fed by \
Stacks 02U8 in the form Stacks.Chow.GenuineChern.intertwines_chernFamily.  The formal \
computation the source omits is proved in full, for every r and every s, as \
Stacks.Chow.esymmOfRoots_lex_one, via the bridge Stacks.Chow.esymmOfRoots_eq_esymRec from the \
unordered families of AlgebraicGeometry.HasChernRoots to the Pascal recursion \
Stacks.Chow.esymRec.  Stacks 02TJ is not needed in degree one: \
Stacks.Chow.sum_range_lexFamily is proved for an arbitrary ring"]
theorem chernClassSub_tensorObj_one (E F : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s] :
    chernClassSub C sX (Scheme.Modules.tensorObj E F) (r * s) 1
      = (s : chernSubring C sX) * chernClassSub C sX E r 1
        + (r : chernSubring C sX) * chernClassSub C sX F s 1 := by
  classical
  obtain ⟨T, hT⟩ := exists_splittingMorphism_unconditional C sX (Fin 2)
    (fun i => if i = 0 then E else F) (fun i => if i = 0 then r else s)
    (by
      intro i
      by_cases hi : i = 0
      · simp only [hi, reduceIte]
        infer_instance
      · simp only [ite_eq_right hi]
        infer_instance)
  obtain ⟨L, hLinv, hL⟩ := exists_hasQuotients_of_hasInvertibleFiltration
    (show Stacks.WeilCohomology.HasInvertibleFiltration T.P
      ((Scheme.Modules.pullback T.π).obj E) r from hT 0)
  obtain ⟨N, hNinv, hN⟩ := exists_hasQuotients_of_hasInvertibleFiltration
    (show Stacks.WeilCohomology.HasInvertibleFiltration T.P
      ((Scheme.Modules.pullback T.π).obj F) s from hT 1)
  have : ∀ i, AlgebraicGeometry.SheafOfModules.IsInvertible T.P.sheaf.obj
    T.P.ringCatSheaf.property (L i) := hLinv
  have : ∀ j, AlgebraicGeometry.SheafOfModules.IsInvertible T.P.sheaf.obj
    T.P.ringCatSheaf.property (N j) := hNinv
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback T.π).obj E) r :=
    AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback T.π E r
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback T.π).obj F) s :=
    AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback T.π F s
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback T.π).obj (Scheme.Modules.tensorObj E F)) (r * s) :=
    AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback T.π (Scheme.Modules.tensorObj E F) (r * s)
  have hup := chernClassSub_tensorObj_one_of_hasQuotients C T.sP r s
    ((Scheme.Modules.pullback T.π).obj E) ((Scheme.Modules.pullback T.π).obj F) L N hL hN
  rw [← chernClassSub_congr C T.sP (pullbackTensorObjIso T.π E F) (r' := r * s) rfl 1] at hup
  have hupamb : homComponent 1 (GenuineChern.chernFamily C T.sP
        ((Scheme.Modules.pullback T.π).obj (Scheme.Modules.tensorObj E F)) (r * s))
      = (s : GradedCapFamily (chowGroup C T.sP)) *
          homComponent 1 (GenuineChern.chernFamily C T.sP
            ((Scheme.Modules.pullback T.π).obj E) r)
        + (r : GradedCapFamily (chowGroup C T.sP)) *
          homComponent 1 (GenuineChern.chernFamily C T.sP
            ((Scheme.Modules.pullback T.π).obj F) s) := by
    have h := congrArg (Subring.subtype (chernSubring C T.sP)) hup
    simpa only [Subring.coe_add, Subring.coe_mul, Subring.coe_natCast, Subring.coe_subtype,
      coe_chernClassSub] using h
  have hint1 : Intertwines T.pullbackChow (GenuineChern.chernFamily C sX E r)
      (GenuineChern.chernFamily C T.sP ((Scheme.Modules.pullback T.π).obj E) r) :=
    GenuineChern.intertwines_chernFamily C sX E r T.sP T.π T.hsP _ T.relDim _ (Iso.refl _)
  have hint2 : Intertwines T.pullbackChow (GenuineChern.chernFamily C sX F s)
      (GenuineChern.chernFamily C T.sP ((Scheme.Modules.pullback T.π).obj F) s) :=
    GenuineChern.intertwines_chernFamily C sX F s T.sP T.π T.hsP _ T.relDim _ (Iso.refl _)
  have hintT : Intertwines T.pullbackChow
      (GenuineChern.chernFamily C sX (Scheme.Modules.tensorObj E F) (r * s))
      (GenuineChern.chernFamily C T.sP
        ((Scheme.Modules.pullback T.π).obj (Scheme.Modules.tensorObj E F)) (r * s)) :=
    GenuineChern.intertwines_chernFamily C sX (Scheme.Modules.tensorObj E F) (r * s) T.sP T.π
      T.hsP _ T.relDim _ (Iso.refl _)
  refine Subtype.ext ?_
  have hcoe : (Subring.subtype (chernSubring C sX))
        ((s : chernSubring C sX) * chernClassSub C sX E r 1
          + (r : chernSubring C sX) * chernClassSub C sX F s 1)
      = (s : GradedCapFamily (chowGroup C sX)) *
          homComponent 1 (GenuineChern.chernFamily C sX E r)
        + (r : GradedCapFamily (chowGroup C sX)) *
          homComponent 1 (GenuineChern.chernFamily C sX F s) := by
    simp only [Subring.coe_add, Subring.coe_mul, Subring.coe_natCast, Subring.coe_subtype,
      coe_chernClassSub]
  have hrhs := ((Intertwines.natCast (pull := T.pullbackChow) s).mul
      (hint1.homComponent 1)).add
    ((Intertwines.natCast (pull := T.pullbackChow) r).mul (hint2.homComponent 1))
  exact (eq_of_intertwines T.pullbackChow T.injective_pullbackChow (hintT.homComponent 1)
    hrhs hupamb).trans hcoe.symm

/-- **Stacks 0FA6, the second displayed identity.** For `ℰ` and `ℱ` finite locally free of
constant ranks `r` and `s`,

  `c₂(ℰ ⊗_{𝒪_X} ℱ) = r·c₂(ℱ) + s·c₂(ℰ) + C(r,2)·c₁(ℱ)² + (r·s − 1)·c₁(ℰ)·c₁(ℱ)
      + C(s,2)·c₁(ℰ)²`

in the commutative ring `Stacks.Chow.chernSubring` generated by the Chern classes, the squares
and the cross term being honest products there. The cross-term coefficient is `r·s − 1`. Nothing
is assumed beyond the two ranks. -/
@[stacks 0FA6 "the second displayed identity, with nothing assumed beyond the two ranks.  \
CORRECTION OF FORM: the source states c_2(E tensor F) = r c_2(F) + s c_2(E) + binom(r,2) \
c_1(F)^2 + (r*s - 1) c_1(F) c_1(E) + binom(s,2) c_1(E)^2 in the bivariant ring A^*(X).  Here the \
identity is stated in Stacks.Chow.chernSubring, the commutative ring generated by the Chern \
classes inside the ring of graded cap families, in which Stacks.Chow.chernClassSub C sX E r i is \
c_i(E); it is the same identity read in that realisation, and because that ring is commutative \
the two squares and the cross term are honest products of classes rather than composites of \
operations.  The cross-term coefficient is r*s - 1, as in the source, and NOT r*s; the five \
summands appear in a different order from the source's, and addition is commutative.  The module \
on the left is the library's canonical tensor product \
AlgebraicGeometry.Scheme.Modules.tensorObj.  The source's reduction to the filtered case is \
PERFORMED, not assumed, by exactly the route recorded on \
Stacks.Chow.chernClassSub_tensorObj_one: the flag bundle of Stacks 02UL as \
Stacks.Chow.exists_splittingMorphism_unconditional, the Chern roots on the bundle as \
Stacks.Chow.hasChernRoots_tensorObj_of_hasQuotients, and the descent along the injective flat \
pullback as Stacks.Chow.eq_of_intertwines fed by Stacks 02U8.  Stacks 02TJ, the commutativity \
the degree-two collapse needs -- the cancellation turning the block-dependent coefficient \
s*(i+1) - 1 into the constant r*s - 1 -- comes from the ring Stacks.Chow.chernSubring being \
commutative, which is Stacks.Chow.isMulCommutative_chernSubring, and is not an input here.  The \
formal computation the source omits is proved in full, for every r and every s, as \
Stacks.Chow.esymmOfRoots_lex_two, which reads Stacks.Chow.esymRec_two_tensor through the bridge \
Stacks.Chow.esymmOfRoots_eq_esymRec"]
theorem chernClassSub_tensorObj_two (E F : X.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s] :
    chernClassSub C sX (Scheme.Modules.tensorObj E F) (r * s) 2
      = (s : chernSubring C sX) * chernClassSub C sX E r 2
        + (r : chernSubring C sX) * chernClassSub C sX F s 2
        + (r.choose 2 : chernSubring C sX) * chernClassSub C sX F s 1 ^ 2
        + ((r : chernSubring C sX) * s - 1) *
            (chernClassSub C sX E r 1 * chernClassSub C sX F s 1)
        + (s.choose 2 : chernSubring C sX) * chernClassSub C sX E r 1 ^ 2 := by
  classical
  obtain ⟨T, hT⟩ := exists_splittingMorphism_unconditional C sX (Fin 2)
    (fun i => if i = 0 then E else F) (fun i => if i = 0 then r else s)
    (by
      intro i
      by_cases hi : i = 0
      · simp only [hi, reduceIte]
        infer_instance
      · simp only [ite_eq_right hi]
        infer_instance)
  obtain ⟨L, hLinv, hL⟩ := exists_hasQuotients_of_hasInvertibleFiltration
    (show Stacks.WeilCohomology.HasInvertibleFiltration T.P
      ((Scheme.Modules.pullback T.π).obj E) r from hT 0)
  obtain ⟨N, hNinv, hN⟩ := exists_hasQuotients_of_hasInvertibleFiltration
    (show Stacks.WeilCohomology.HasInvertibleFiltration T.P
      ((Scheme.Modules.pullback T.π).obj F) s from hT 1)
  have : ∀ i, AlgebraicGeometry.SheafOfModules.IsInvertible T.P.sheaf.obj
    T.P.ringCatSheaf.property (L i) := hLinv
  have : ∀ j, AlgebraicGeometry.SheafOfModules.IsInvertible T.P.sheaf.obj
    T.P.ringCatSheaf.property (N j) := hNinv
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback T.π).obj E) r :=
    AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback T.π E r
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback T.π).obj F) s :=
    AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback T.π F s
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback T.π).obj (Scheme.Modules.tensorObj E F)) (r * s) :=
    AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback T.π (Scheme.Modules.tensorObj E F) (r * s)
  have hup := chernClassSub_tensorObj_two_of_hasQuotients C T.sP r s
    ((Scheme.Modules.pullback T.π).obj E) ((Scheme.Modules.pullback T.π).obj F) L N hL hN
  rw [← chernClassSub_congr C T.sP (pullbackTensorObjIso T.π E F) (r' := r * s) rfl 2] at hup
  have hupamb : homComponent 2 (GenuineChern.chernFamily C T.sP
        ((Scheme.Modules.pullback T.π).obj (Scheme.Modules.tensorObj E F)) (r * s))
      = (s : GradedCapFamily (chowGroup C T.sP)) *
          homComponent 2 (GenuineChern.chernFamily C T.sP
            ((Scheme.Modules.pullback T.π).obj E) r)
        + (r : GradedCapFamily (chowGroup C T.sP)) *
          homComponent 2 (GenuineChern.chernFamily C T.sP
            ((Scheme.Modules.pullback T.π).obj F) s)
        + (r.choose 2 : GradedCapFamily (chowGroup C T.sP)) *
          (homComponent 1 (GenuineChern.chernFamily C T.sP
              ((Scheme.Modules.pullback T.π).obj F) s) *
            homComponent 1 (GenuineChern.chernFamily C T.sP
              ((Scheme.Modules.pullback T.π).obj F) s))
        + ((r : GradedCapFamily (chowGroup C T.sP)) * s - 1) *
          (homComponent 1 (GenuineChern.chernFamily C T.sP
              ((Scheme.Modules.pullback T.π).obj E) r) *
            homComponent 1 (GenuineChern.chernFamily C T.sP
              ((Scheme.Modules.pullback T.π).obj F) s))
        + (s.choose 2 : GradedCapFamily (chowGroup C T.sP)) *
          (homComponent 1 (GenuineChern.chernFamily C T.sP
              ((Scheme.Modules.pullback T.π).obj E) r) *
            homComponent 1 (GenuineChern.chernFamily C T.sP
              ((Scheme.Modules.pullback T.π).obj E) r)) := by
    have h := congrArg (Subring.subtype (chernSubring C T.sP)) hup
    simpa only [Subring.coe_add, AddSubgroupClass.coe_sub, Subring.coe_mul, Subring.coe_one,
      Subring.coe_pow, Subring.coe_natCast, Subring.coe_subtype,
      coe_chernClassSub, pow_two] using h
  have hint1 : Intertwines T.pullbackChow (GenuineChern.chernFamily C sX E r)
      (GenuineChern.chernFamily C T.sP ((Scheme.Modules.pullback T.π).obj E) r) :=
    GenuineChern.intertwines_chernFamily C sX E r T.sP T.π T.hsP _ T.relDim _ (Iso.refl _)
  have hint2 : Intertwines T.pullbackChow (GenuineChern.chernFamily C sX F s)
      (GenuineChern.chernFamily C T.sP ((Scheme.Modules.pullback T.π).obj F) s) :=
    GenuineChern.intertwines_chernFamily C sX F s T.sP T.π T.hsP _ T.relDim _ (Iso.refl _)
  have hintT : Intertwines T.pullbackChow
      (GenuineChern.chernFamily C sX (Scheme.Modules.tensorObj E F) (r * s))
      (GenuineChern.chernFamily C T.sP
        ((Scheme.Modules.pullback T.π).obj (Scheme.Modules.tensorObj E F)) (r * s)) :=
    GenuineChern.intertwines_chernFamily C sX (Scheme.Modules.tensorObj E F) (r * s) T.sP T.π
      T.hsP _ T.relDim _ (Iso.refl _)
  refine Subtype.ext ?_
  have hcoe : (Subring.subtype (chernSubring C sX))
        ((s : chernSubring C sX) * chernClassSub C sX E r 2
          + (r : chernSubring C sX) * chernClassSub C sX F s 2
          + (r.choose 2 : chernSubring C sX) * chernClassSub C sX F s 1 ^ 2
          + ((r : chernSubring C sX) * s - 1) *
              (chernClassSub C sX E r 1 * chernClassSub C sX F s 1)
          + (s.choose 2 : chernSubring C sX) * chernClassSub C sX E r 1 ^ 2)
      = (s : GradedCapFamily (chowGroup C sX)) *
          homComponent 2 (GenuineChern.chernFamily C sX E r)
        + (r : GradedCapFamily (chowGroup C sX)) *
          homComponent 2 (GenuineChern.chernFamily C sX F s)
        + (r.choose 2 : GradedCapFamily (chowGroup C sX)) *
          (homComponent 1 (GenuineChern.chernFamily C sX F s) *
            homComponent 1 (GenuineChern.chernFamily C sX F s))
        + ((r : GradedCapFamily (chowGroup C sX)) * s - 1) *
          (homComponent 1 (GenuineChern.chernFamily C sX E r) *
            homComponent 1 (GenuineChern.chernFamily C sX F s))
        + (s.choose 2 : GradedCapFamily (chowGroup C sX)) *
          (homComponent 1 (GenuineChern.chernFamily C sX E r) *
            homComponent 1 (GenuineChern.chernFamily C sX E r)) := by
    simp only [Subring.coe_add, AddSubgroupClass.coe_sub, Subring.coe_mul, Subring.coe_one,
      Subring.coe_natCast, Subring.coe_subtype,
      coe_chernClassSub, pow_two]
  have hrhs1 := ((Intertwines.natCast (pull := T.pullbackChow) s).mul
      (hint1.homComponent 2)).add
    ((Intertwines.natCast (pull := T.pullbackChow) r).mul (hint2.homComponent 2))
  have hrhs2 := hrhs1.add ((Intertwines.natCast (pull := T.pullbackChow) (r.choose 2)).mul
    ((hint2.homComponent 1).mul (hint2.homComponent 1)))
  have hrhs3 := hrhs2.add
    ((((Intertwines.natCast (pull := T.pullbackChow) r).mul
        (Intertwines.natCast (pull := T.pullbackChow) s)).sub
      (Intertwines.one (pull := T.pullbackChow))).mul
      ((hint1.homComponent 1).mul (hint2.homComponent 1)))
  have hrhs := hrhs3.add ((Intertwines.natCast (pull := T.pullbackChow) (s.choose 2)).mul
    ((hint1.homComponent 1).mul (hint1.homComponent 1)))
  exact (eq_of_intertwines T.pullbackChow T.injective_pullbackChow (hintT.homComponent 2)
    hrhs hupamb).trans hcoe.symm

end Main

end Stacks.Chow

