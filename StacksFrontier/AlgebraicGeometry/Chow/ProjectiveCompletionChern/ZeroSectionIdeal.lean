module

public import StacksFrontier.AlgebraicGeometry.Chow.ProjectiveCompletionChern.ZeroSection

/-!
# The ideal of the zero section on the chart `D₊(T)`

Over an affine open `V` of `X` on which `Γ(𝒞, V)` is free with basis `b`, the functions on the
chart `W = D₊(T)` killed by the zero section are the multiples of the coordinates `y_{b_j}`:
`Γ(E, W) = Sym_R(M)` is `R` plus the ideal generated by `M`, and the zero section is the
identity on `R` and kills `M`.

## Main results

* `SymmetricAlgebra.exists_sub_algebraMap_mem_span`: `Sym_R(M) = R + (M)`.
* `Stacks.Chow.ProjectiveCompletion.mem_span_coordY_of_zeta_eq_zero`: a function on `W` killed by
  the zero section lies in the ideal generated by the coordinates `y_{b_j}`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

universe u

/-- **`Sym_R(M) = R + (M)`**: every element of the symmetric algebra differs from a scalar by an
element of the ideal generated by a basis of `M`. -/
theorem SymmetricAlgebra.exists_sub_algebraMap_mem_span {R M ι : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] [Finite ι] (b : Module.Basis ι R M) (a : SymmetricAlgebra R M) :
    ∃ c : R, a - algebraMap R _ c ∈
      Ideal.span (Set.range fun j => SymmetricAlgebra.ι R M (b j)) := by
  classical
  cases nonempty_fintype ι
  induction a using SymmetricAlgebra.induction with
  | algebraMap r => exact ⟨r, by simp⟩
  | ι m =>
    refine ⟨0, ?_⟩
    rw [map_zero, sub_zero, ← b.sum_repr m, map_sum]
    refine Ideal.sum_mem _ fun j _ => ?_
    rw [map_smul, Algebra.smul_def]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
  | mul a a' ha ha' =>
    obtain ⟨c, hc⟩ := ha
    obtain ⟨c', hc'⟩ := ha'
    refine ⟨c * c', ?_⟩
    have : a * a' - algebraMap R _ (c * c') =
        (a - algebraMap R _ c) * a' + algebraMap R _ c * (a' - algebraMap R _ c') := by
      rw [map_mul]; ring
    rw [this]
    exact add_mem (Ideal.mul_mem_right _ _ hc) (Ideal.mul_mem_left _ _ hc')
  | add a a' ha ha' =>
    obtain ⟨c, hc⟩ := ha
    obtain ⟨c', hc'⟩ := ha'
    refine ⟨c + c', ?_⟩
    have : a + a' - algebraMap R _ (c + c') =
        (a - algebraMap R _ c) + (a' - algebraMap R _ c') := by
      rw [map_add]; ring
    rw [this]
    exact add_mem hc hc'

namespace Stacks.Chow.ProjectiveCompletion

variable {X : Scheme.{u}} (𝒞 : X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} 𝒞]
  (r : ℕ) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} 𝒞 r]
  {V : X.Opens} (hV : IsAffineOpen V) {ι : Type*} [Finite ι]
  (b : Module.Basis ι Γ(X, V) Γ(𝒞, V))

/-- **`Γ(E, W) = R + (y_{b_j})`**: every function on the chart differs from the pullback of a
function on `V` by a multiple of the coordinates. -/
theorem exists_sub_proj_app_mem_span (g : Γ(space 𝒞, openW 𝒞 hV)) :
    ∃ c : Γ(X, V), g - (space 𝒞).presheaf.map (homOfLE (openW_le 𝒞 hV)).op ((proj 𝒞).app V c) ∈
      Ideal.span (Set.range fun j => coordY 𝒞 hV (b j)) := by
  obtain ⟨c, hc⟩ := SymmetricAlgebra.exists_sub_algebraMap_mem_span b (coordRingEquiv 𝒞 hV g)
  refine ⟨c, ?_⟩
  have hmap := Ideal.mem_map_of_mem (coordRingEquiv 𝒞 hV).symm.toRingHom hc
  rw [Ideal.map_span] at hmap
  have hset : (coordRingEquiv 𝒞 hV).symm.toRingHom ''
      Set.range (fun j => SymmetricAlgebra.ι Γ(X, V) Γ(𝒞, V) (b j)) =
      Set.range fun j => coordY 𝒞 hV (b j) := by
    rw [← Set.range_comp]
    congr 1
    funext j
    change (coordRingEquiv 𝒞 hV).symm (SymmetricAlgebra.ι Γ(X, V) Γ(𝒞, V) (b j)) = _
    rw [RingEquiv.symm_apply_eq, coordRingEquiv_coordY]
  rw [hset, map_sub] at hmap
  have h1 : (coordRingEquiv 𝒞 hV).symm.toRingHom (coordRingEquiv 𝒞 hV g) = g :=
    (coordRingEquiv 𝒞 hV).symm_apply_apply g
  have h2 : (coordRingEquiv 𝒞 hV).symm.toRingHom
      (algebraMap Γ(X, V) (SymmetricAlgebra Γ(X, V) Γ(𝒞, V)) c) =
      (space 𝒞).presheaf.map (homOfLE (openW_le 𝒞 hV)).op ((proj 𝒞).app V c) := by
    change (coordRingEquiv 𝒞 hV).symm _ = _
    rw [RingEquiv.symm_apply_eq, coordRingEquiv_proj_app]
  rwa [h1, h2] at hmap

/-- **The zero section cuts out the coordinates on `W`**: a function on `W` killed by the zero
section is a multiple of the coordinates `y_{b_j}`. -/
theorem mem_span_coordY_of_zeta_eq_zero (g : Γ(space 𝒞, openW 𝒞 hV))
    (hg : zeta 𝒞 r hV g = 0) :
    g ∈ Ideal.span (Set.range fun j => coordY 𝒞 hV (b j)) := by
  obtain ⟨c, hc⟩ := exists_sub_proj_app_mem_span 𝒞 hV b g
  have hz : zeta 𝒞 r hV (g - (space 𝒞).presheaf.map (homOfLE (openW_le 𝒞 hV)).op
      ((proj 𝒞).app V c)) = 0 := by
    refine (Ideal.span_le.2 ?_ : Ideal.span _ ≤ RingHom.ker (zeta 𝒞 r hV).hom) hc
    rintro _ ⟨j, rfl⟩
    exact zeta_coordY 𝒞 r hV (b j)
  rw [map_sub, hg, zeta_proj_app, zero_sub, neg_eq_zero] at hz
  rwa [hz, map_zero, map_zero, sub_zero] at hc

end Stacks.Chow.ProjectiveCompletion
