module

public import StacksFrontier.AlgebraicGeometry.Chow.ProjectiveCompletionChern.ZeroSectionIdeal
public import StacksFrontier.AlgebraicGeometry.ClosedImmersionCoherentImage.Basic
public import StacksFrontier.AlgebraicGeometry.Scheme.Points.ModuleStalkSpecialization
public import StacksFrontier.AlgebraicGeometry.ProjEulerSequence.WedgeFiltrationArrow

/-!
# The stalks of `i_* 𝒪_X` for the zero section of the projective completion

Let `i : X ⟶ E` be the zero section of `E = Proj_X(Sym^*(𝒞)[T])` and `ε : 𝒪_E ⟶ i_* 𝒪_X` the
canonical map. At a point `ξ` of the chart `W = D₊(T)` over an affine open `V` on which
`Γ(𝒞, V)` is free with basis `b`, the kernel of `ε_ξ : 𝒪_{E, ξ} ⟶ (i_* 𝒪_X)_ξ` is the ideal
generated by the germs of the coordinates `y_{b_j}`. At a point outside `C = {T ≠ 0}`, the stalk
of `i_* 𝒪_X` vanishes.

## Main results

* `Stacks.Chow.ProjectiveCompletion.mem_span_of_epsStalk_eq_zero`: the kernel of `ε_ξ` at a
  point of `W` is contained in the ideal generated by the germs of the coordinates.
* `Stacks.Chow.ProjectiveCompletion.epsStalk_eq_zero_of_mem_span`: the germs of the coordinates
  lie in the kernel of `ε_ξ`.
* `Stacks.Chow.ProjectiveCompletion.eq_zero_of_notMem_openT`: off `C = {T ≠ 0}` the stalk of
  `i_* 𝒪_X` vanishes.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

universe u

namespace Stacks.Chow.ProjectiveCompletion

variable {X : Scheme.{u}} (𝒞 : X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} 𝒞]
  (r : ℕ) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} 𝒞 r]

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose

/-- The canonical map `ε : 𝒪_E ⟶ i_* 𝒪_X` of the zero section. -/
abbrev unitToZeroSec :
    SheafOfModules.unit (space 𝒞).ringCatSheaf ⟶
      (Scheme.Modules.pushforward (zeroSec 𝒞 r)).obj (SheafOfModules.unit X.ringCatSheaf) :=
  ClosedImmersionCoherentImage.unitToPushforwardUnit (zeroSec 𝒞 r)

/-- `ε_ξ`, read on the stalk ring `𝒪_{E, ξ}`. -/
def epsStalk (ξ : space 𝒞) :
    ↑(TopCat.Presheaf.stalk (space 𝒞).sheaf.obj ξ)
      →ₗ[↑(TopCat.Presheaf.stalk (space 𝒞).sheaf.obj ξ)]
        ↑(TopCat.Presheaf.stalk ((Scheme.Modules.pushforward (zeroSec 𝒞 r)).obj
          (SheafOfModules.unit X.ringCatSheaf)).val.presheaf ξ) :=
  (PresheafOfModules.stalkMapL (R := (space 𝒞).sheaf.obj) ξ (unitToZeroSec 𝒞 r).val) ∘ₗ
    (Stacks.AlgebraicGeometry.ProjEulerSequence.unitStalkCommEquiv (space 𝒞).sheaf
      ξ).symm.toLinearMap

/-- `ε_ξ` sends the germ at `ξ` of a section `s` over `U` to the germ at `ξ` of its image
`i^♯(s)`. -/
theorem epsStalk_germ (ξ : space 𝒞) (U : (space 𝒞).Opens) (hξ : ξ ∈ U) (s : Γ(space 𝒞, U)) :
    epsStalk 𝒞 r ξ ((space 𝒞).presheaf.germ U ξ hξ s) =
      ((Scheme.Modules.pushforward (zeroSec 𝒞 r)).obj
        (SheafOfModules.unit X.ringCatSheaf)).presheaf.germ U ξ hξ ((zeroSec 𝒞 r).app U s) := by
  have h := Stacks.AlgebraicGeometry.ProjEulerSequence.unitStalkCommEquiv_germ (space 𝒞).sheaf ξ
    U hξ s
  change PresheafOfModules.stalkMapL ξ (unitToZeroSec 𝒞 r).val
    ((Stacks.AlgebraicGeometry.ProjEulerSequence.unitStalkCommEquiv (space 𝒞).sheaf ξ).symm
      ((space 𝒞).presheaf.germ U ξ hξ s)) = _
  have h' : (Stacks.AlgebraicGeometry.ProjEulerSequence.unitStalkCommEquiv (space 𝒞).sheaf ξ).symm
      ((space 𝒞).presheaf.germ U ξ hξ s) =
      TopCat.Presheaf.germ (SheafOfModules.unit (space 𝒞).ringCatSheaf).val.presheaf U ξ hξ s :=
    (LinearEquiv.symm_apply_eq _).2 h.symm
  rw [h']
  exact PresheafOfModules.stalkMapL_germ ξ (unitToZeroSec 𝒞 r).val U hξ s

/-- The preimage of the chart `W` under the zero section is contained in `V`. -/
theorem le_preimage_zeroSec_openW' {V : X.Opens} (hV : IsAffineOpen V) :
    zeroSec 𝒞 r ⁻¹ᵁ openW 𝒞 hV ≤ V := by
  intro x hx
  have hx' : zeroSec 𝒞 r x ∈ proj 𝒞 ⁻¹ᵁ V := openW_le 𝒞 hV hx
  change (zeroSec 𝒞 r ≫ proj 𝒞) x ∈ V at hx'
  rwa [zeroSec_proj] at hx'

/-- **The kernel of `ε_ξ` at a point of `W`** is contained in the ideal generated by the germs of
the coordinates. -/
theorem mem_span_of_epsStalk_eq_zero {V : X.Opens} (hV : IsAffineOpen V)
    (b : Module.Basis (Fin r) Γ(X, V) Γ(𝒞, V)) (ξ : space 𝒞) (hξ : ξ ∈ openW 𝒞 hV)
    (f : (space 𝒞).presheaf.stalk ξ) (hf : epsStalk 𝒞 r ξ f = 0) :
    f ∈ Ideal.span (Set.range fun j =>
      (space 𝒞).presheaf.germ (openW 𝒞 hV) ξ hξ (coordY 𝒞 hV (b j))) := by
  let : Algebra Γ(space 𝒞, openW 𝒞 hV) ((space 𝒞).presheaf.stalk ξ) :=
    ((space 𝒞).presheaf.germ (openW 𝒞 hV) ξ hξ).hom.toAlgebra
  have := (isAffineOpen_openW 𝒞 hV).isLocalization_stalk ⟨ξ, hξ⟩
  set P := ((isAffineOpen_openW 𝒞 hV).primeIdealOf ⟨ξ, hξ⟩).asIdeal.primeCompl with hP
  obtain ⟨⟨s, c⟩, hsc⟩ := IsLocalization.mk'_surjective P f
  have hspec : f * algebraMap Γ(space 𝒞, openW 𝒞 hV) ((space 𝒞).presheaf.stalk ξ)
      (c : Γ(space 𝒞, openW 𝒞 hV)) = algebraMap _ _ s := by
    have h := IsLocalization.mk'_spec ((space 𝒞).presheaf.stalk ξ) s c
    have hsc' : IsLocalization.mk' ((space 𝒞).presheaf.stalk ξ) s c = f := hsc
    rwa [hsc'] at h
  have h1 : epsStalk 𝒞 r ξ ((space 𝒞).presheaf.germ (openW 𝒞 hV) ξ hξ s) = 0 := by
    change epsStalk 𝒞 r ξ (algebraMap Γ(space 𝒞, openW 𝒞 hV) ((space 𝒞).presheaf.stalk ξ) s) = 0
    rw [← hspec, mul_comm]
    have h2 := (epsStalk 𝒞 r ξ).map_smul (algebraMap Γ(space 𝒞, openW 𝒞 hV)
      ((space 𝒞).presheaf.stalk ξ) (c : Γ(space 𝒞, openW 𝒞 hV))) f
    rw [hf] at h2
    exact h2.trans (smul_zero _)
  rw [epsStalk_germ] at h1
  have : ((Scheme.Modules.pushforward (zeroSec 𝒞 r)).obj
      (SheafOfModules.unit X.ringCatSheaf)).IsQuasicoherent :=
    ClosedImmersionCoherentImage.isQuasicoherent_pushforward_unit (zeroSec 𝒞 r)
  obtain ⟨d, hd, hds⟩ := Stacks.ModuleStalkSpecialization.exists_smul_eq_of_germ_eq
    ((Scheme.Modules.pushforward (zeroSec 𝒞 r)).obj (SheafOfModules.unit X.ringCatSheaf))
    (isAffineOpen_openW 𝒞 hV) hξ ((zeroSec 𝒞 r).app (openW 𝒞 hV) s) 0 (h1.trans (map_zero _).symm)
  rw [smul_zero] at hds
  have hz : zeta 𝒞 r hV (d * s) = 0 := by
    change X.presheaf.map _ ((zeroSec 𝒞 r).app (openW 𝒞 hV) (d * s)) = 0
    rw [map_mul]
    have hds' : (zeroSec 𝒞 r).app (openW 𝒞 hV) d * (zeroSec 𝒞 r).app (openW 𝒞 hV) s = 0 := hds
    rw [hds', map_zero]
  have hmem := Ideal.mem_map_of_mem ((space 𝒞).presheaf.germ (openW 𝒞 hV) ξ hξ).hom
    (mem_span_coordY_of_zeta_eq_zero 𝒞 r hV b (d * s) hz)
  rw [Ideal.map_span, ← Set.range_comp] at hmem
  have hu1 : IsUnit (algebraMap Γ(space 𝒞, openW 𝒞 hV) ((space 𝒞).presheaf.stalk ξ) d) :=
    IsLocalization.map_units _ (⟨d, hd⟩ : P)
  have hu2 : IsUnit (algebraMap Γ(space 𝒞, openW 𝒞 hV) ((space 𝒞).presheaf.stalk ξ)
      (c : Γ(space 𝒞, openW 𝒞 hV))) :=
    IsLocalization.map_units _ c
  have hdsf : ((space 𝒞).presheaf.germ (openW 𝒞 hV) ξ hξ).hom (d * s) =
      (hu1.unit * hu2.unit : (((space 𝒞).presheaf.stalk ξ))ˣ) * f := by
    rw [map_mul, Units.val_mul, IsUnit.unit_spec, IsUnit.unit_spec, mul_assoc]
    change algebraMap _ _ d * algebraMap _ _ s = _
    rw [← hspec, mul_comm f]
  rw [hdsf] at hmem
  have := Ideal.mul_mem_left _ (((hu1.unit * hu2.unit)⁻¹ : (((space 𝒞).presheaf.stalk ξ))ˣ) :
    (space 𝒞).presheaf.stalk ξ) hmem
  rwa [← mul_assoc, Units.inv_mul, one_mul] at this

/-- The zero section pulls back each coordinate `y_m` on the chart `W` to zero. -/
theorem zeroSec_app_coordY {V : X.Opens} (hV : IsAffineOpen V) (m : Γ(𝒞, V)) :
    (zeroSec 𝒞 r).app (openW 𝒞 hV) (coordY 𝒞 hV m) = 0 := by
  have h := zeta_coordY 𝒞 r hV m
  have he : zeroSec 𝒞 r ⁻¹ᵁ openW 𝒞 hV = V :=
    le_antisymm (le_preimage_zeroSec_openW' 𝒞 r hV) (le_preimage_zeroSec_openW 𝒞 r hV)
  change X.presheaf.map (homOfLE (le_preimage_zeroSec_openW 𝒞 r hV)).op
    ((zeroSec 𝒞 r).app (openW 𝒞 hV) (coordY 𝒞 hV m)) = 0 at h
  have hinj := (ConcreteCategory.bijective_of_isIso
    (X.presheaf.map (eqToHom he.symm).op)).1
  exact hinj (h.trans (map_zero _).symm)

/-- The germs of the coordinates lie in the kernel of `ε_ξ`. -/
theorem epsStalk_eq_zero_of_mem_span {V : X.Opens} (hV : IsAffineOpen V)
    (b : Module.Basis (Fin r) Γ(X, V) Γ(𝒞, V)) (ξ : space 𝒞) (hξ : ξ ∈ openW 𝒞 hV)
    (f : (space 𝒞).presheaf.stalk ξ)
    (hf : f ∈ Ideal.span (Set.range fun j =>
      (space 𝒞).presheaf.germ (openW 𝒞 hV) ξ hξ (coordY 𝒞 hV (b j)))) :
    epsStalk 𝒞 r ξ f = 0 := by
  refine (Ideal.span_le.2 ?_ : _ ≤ (LinearMap.ker (epsStalk 𝒞 r ξ) : Ideal _)) hf
  rintro _ ⟨j, rfl⟩
  change epsStalk 𝒞 r ξ ((space 𝒞).presheaf.germ (openW 𝒞 hV) ξ hξ (coordY 𝒞 hV (b j))) = 0
  rw [epsStalk_germ, zeroSec_app_coordY]
  exact map_zero _

/-- **Off `C = {T ≠ 0}` the stalk of `i_* 𝒪_X` vanishes.** -/
theorem eq_zero_of_notMem_openT (ξ : space 𝒞) (hξ : ξ ∉ openT 𝒞)
    (m : ↑(TopCat.Presheaf.stalk ((Scheme.Modules.pushforward (zeroSec 𝒞 r)).obj
      (SheafOfModules.unit X.ringCatSheaf)).val.presheaf ξ)) : m = 0 := by
  obtain ⟨U, hξU, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq _ m
  have hcl : IsClosed (Set.range (zeroSec 𝒞 r)) :=
    (zeroSec 𝒞 r).isClosedEmbedding.isClosed_range
  set U' : (space 𝒞).Opens := U ⊓ ⟨(Set.range (zeroSec 𝒞 r))ᶜ, hcl.isOpen_compl⟩ with hU'
  have hξU' : ξ ∈ U' := ⟨hξU, fun ⟨x, hx⟩ => hξ (hx ▸ range_zeroSec_le_openT 𝒞 r x)⟩
  have hbot : zeroSec 𝒞 r ⁻¹ᵁ U' = ⊥ := by
    ext x
    simp only [hU']
    exact ⟨fun h => (h.2 ⟨x, rfl⟩).elim, fun h => h.elim⟩
  rw [← TopCat.Presheaf.germ_res_apply _ (homOfLE (inf_le_left : U' ≤ U)) ξ hξU']
  have hs : ((Scheme.Modules.pushforward (zeroSec 𝒞 r)).obj
      (SheafOfModules.unit X.ringCatSheaf)).val.presheaf.map (homOfLE (inf_le_left : U' ≤ U)).op s
      = 0 := by
    have : Subsingleton Γ(X, zeroSec 𝒞 r ⁻¹ᵁ U') := by rw [hbot]; infer_instance
    exact Subsingleton.elim (α := Γ(X, zeroSec 𝒞 r ⁻¹ᵁ U')) _ _
  rw [hs, map_zero]

end Stacks.Chow.ProjectiveCompletion
