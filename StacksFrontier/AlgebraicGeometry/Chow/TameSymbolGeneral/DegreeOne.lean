module

public import StacksFrontier.AlgebraicGeometry.Chow.TameSymbol.NormalModification
public import StacksFrontier.AlgebraicGeometry.Chow.TameSymbolGeneral.MilnorNorm
public import StacksFrontier.AlgebraicGeometry.Chow.TameSymbolGeneral.OrderFormula

/-!
# In degree one the general tame symbol is the order of vanishing

Let `A` be a Noetherian local domain of dimension one with fraction field `F` whose normalization
`A'` is a finite `A`-module (for instance `A` Nagata, in particular excellent). On
`K^M_1(F) = F^*` the tame symbol `∂_A : K^M_1(F) → K^M_0(κ) = ℤ` of Stacks 0EAY, built by
normalization and norm, is the order of vanishing `ord_A`
(`Stacks.Chow.oneDimTameSymbol_zero_eq_ordInt`).

Indeed on `{f}` the symbol is `∑_𝔫 N_{κ(𝔫)/κ}(v_𝔫(f) · 1) = ∑_𝔫 [κ(𝔫) : κ] v_𝔫(f)`, and for
`f ∈ A` this is `length_A(A / fA)` by Stacks 02MJ for the finite extension `A ⊆ A'`
(`Stacks.Chow.ord_toNat_eq_sum_finrank_mul_ord_toNat`); both sides are homomorphisms on `F^*`,
which is generated by the nonzero elements of `A`.

## Main results

* `Stacks.Chow.tameShift_normalizationDvrFamily_milnorKSymbol` — the value on `{f}`.
* `Stacks.Chow.oneDimTameSymbol_zero_eq_ordInt` — `∂_A = ord_A` on `F^*`.
* `Stacks.Chow.oneDimTameSymbol_zero_eq_ordInt_of_isNagataRing` — the same for `A` Nagata.

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
* [Stacks Project, Tag 02MJ](https://stacks.math.columbia.edu/tag/02MJ)
-/

@[expose] public noncomputable section

open IsLocalRing IsDiscreteValuationRing Stacks.Normalization

universe u

namespace Stacks.Chow

attribute [local instance] SemilocalDvrFamily.finite_index SemilocalDvrFamily.commRing
  SemilocalDvrFamily.isDomain SemilocalDvrFamily.isDiscreteValuationRing
  SemilocalDvrFamily.algebraBase SemilocalDvrFamily.isLocalHom
  SemilocalDvrFamily.algebraFractionField SemilocalDvrFamily.isScalarTower
  SemilocalDvrFamily.isFractionRing SemilocalDvrFamily.moduleFiniteResidueField

variable (A : Type u) [CommRing A] [IsDomain A] [IsLocalRing A] [IsNoetherianRing A]
  (F : Type u) [Field F] [Algebra A F] [IsFractionRing A F]

/-- **The general tame symbol on a degree-one symbol** `{f}`: the sum over the maximal ideals of
the normalization of the residue degree times the valuation. -/
theorem tameShift_normalizationDvrFamily_milnorKSymbol (hdim : ringKrullDim A = 1) (f : Fˣ) :
    letI 𝓕 := normalizationDvrFamily A F hdim
    letI := Fintype.ofFinite 𝓕.Index
    𝓕.tameShift milnorKNormFamily (milnorKSymbol F f) =
      (∑ m : 𝓕.Index, (Module.finrank (ResidueField A) (ResidueField (𝓕.Dvr m)) : ℤ) *
        dvrFracOrd (F := F) (exists_irreducible (𝓕.Dvr m)).choose_spec f) •
          (1 : MilnorKRing (ResidueField A)) := by
  let 𝓕 := normalizationDvrFamily A F hdim
  let := Fintype.ofFinite 𝓕.Index
  rw [SemilocalDvrFamily.tameShift_apply, Finset.sum_smul]
  refine Finset.sum_congr rfl fun m _ ↦ ?_
  rw [SemilocalDvrFamily.tameShiftAt_apply, dvrMilnorShiftMap_milnorKSymbol,
    shift_dvrMilnorThetaHom, map_zsmul]
  show dvrFracOrd _ f • milnorKNormRing (ResidueField A) (ResidueField (𝓕.Dvr m)) 1 = _
  rw [milnorKNormRing_one, smul_smul, mul_comm]

/-- The valuation of the image of a nonzero element `a` of a discrete valuation ring `R` in its
fraction field is the order of vanishing of `a`. -/
theorem dvrFracOrd_algebraMap_eq_ord {R : Type u} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] [Algebra R F] [IsFractionRing R F] {ϖ : R} (hϖ : Irreducible ϖ)
    {a : R} (ha : a ≠ 0) (haF : algebraMap R F a ≠ 0) :
    dvrFracOrd hϖ (Units.mk0 _ haF) = ((Ring.ord R a).toNat : ℤ) := by
  obtain ⟨n, u, hn⟩ := eq_unit_mul_pow_irreducible ha hϖ
  have hord : Ring.ord R a = n := by rw [hn, ord_unit_mul_pow hϖ u n]
  rw [hord, ENat.toNat_natCast]
  refine dvrFracOrd_eq_of_eq (u := u) hϖ ?_
  rw [Units.val_mk0, zpow_natCast, ← map_pow, ← map_mul, ← hn]

/-- The class in `K^M_1(F)` of a unit `f` is the symbol `{f}`. -/
theorem coe_milnorKTheoryOneAddEquiv_symm_ofMul (f : Fˣ) :
    ((milnorKTheoryOneAddEquiv F).symm (Additive.ofMul f) : MilnorKRing F) =
      milnorKSymbol F f := by
  rw [coe_milnorKTheoryOneAddEquiv_symm, milnorKSymbol_eq_mk']

variable {A F}

/-- **In degree one the general tame symbol is the order of vanishing**, on the nonzero elements
of `A`, when the normalization is a finite `A`-module. -/
theorem sum_finrank_mul_dvrFracOrd_algebraMap (hdim : ringKrullDim A = 1)
    [Module.Finite A ↥(integralClosure A F)] {a : A} (ha : a ≠ 0)
    (haF : algebraMap A F a ≠ 0) :
    letI 𝓕 := normalizationDvrFamily A F hdim
    letI := Fintype.ofFinite 𝓕.Index
    (∑ m : 𝓕.Index, (Module.finrank (ResidueField A) (ResidueField (𝓕.Dvr m)) : ℤ) *
        dvrFracOrd (F := F) (exists_irreducible (𝓕.Dvr m)).choose_spec (Units.mk0 _ haF)) =
      ((Ring.ord A a).toNat : ℤ) := by
  classical
  have hK1 : Ring.KrullDimLE 1 A := Ring.krullDimLE_iff.2 (by rw [hdim]; exact_mod_cast le_rfl)
  have hfield : ¬ IsField A := fun h ↦ by
    rw [ringKrullDim_eq_zero_of_isField h] at hdim
    exact zero_ne_one hdim
  let := dimensionLEOne_of_ringKrullDim_eq_one A hdim
  let 𝓕 := normalizationDvrFamily A F hdim
  let hfin := Fintype.ofFinite 𝓕.Index
  let : Fintype (MaximalSpectrum ↥(integralClosure A F)) := hfin
  have hinj : Function.Injective (algebraMap A ↥(integralClosure A F)) := fun x y h =>
    IsFractionRing.injective A F (congrArg Subtype.val h)
  have hass := not_isAssociatedPrime_maximalIdeal (B := ↥(integralClosure A F)) hinj hfield
  have hquot : ∃ n : ℕ, maximalIdeal A ^ n • (⊤ : Submodule A ↥(integralClosure A F)) ≤
      LinearMap.range (Algebra.linearMap A ↥(integralClosure A F)) := by
    obtain ⟨d, hd, hdB⟩ := exists_nonZeroDivisor_smul_mem_range A (integralClosure A F)
      (K := F) Subtype.val_injective
    exact exists_maximalIdeal_pow_smul_le hd hdB
  let : ∀ q : MaximalSpectrum ↥(integralClosure A F),
      IsLocalHom (algebraMap A (Localization.AtPrime q.asIdeal)) := fun q ↦
    isLocalHom_algebraMap_localization A F q.asIdeal
  rw [ord_toNat_eq_sum_finrank_mul_ord_toNat hass hinj hquot (mem_nonZeroDivisors_of_ne_zero ha),
    Nat.cast_sum]
  refine Finset.sum_congr rfl fun m _ ↦ ?_
  rw [Nat.cast_mul]
  congr 1
  show _ = ((Ring.ord (𝓕.Dvr m) (algebraMap A (𝓕.Dvr m) a)).toNat : ℤ)
  have ham : algebraMap A (𝓕.Dvr m) a ≠ 0 := fun h ↦
    haF (by rw [IsScalarTower.algebraMap_apply A (𝓕.Dvr m) F, h, map_zero])
  have hF : algebraMap (𝓕.Dvr m) F (algebraMap A (𝓕.Dvr m) a) ≠ 0 := by
    rwa [← IsScalarTower.algebraMap_apply]
  rw [← dvrFracOrd_algebraMap_eq_ord F (exists_irreducible (𝓕.Dvr m)).choose_spec ham hF]
  congr 1
  ext
  simp [← IsScalarTower.algebraMap_apply]

variable (A F)

/-- **In degree one the tame symbol `∂_A` of Stacks 0EAY is the order of vanishing** `ord_A`, on
`K^M_1(F) = F^*` with `K^M_0(κ) = ℤ`, when the normalization of `A` is a finite `A`-module. -/
theorem oneDimTameSymbol_zero_eq_ordInt (hdim : ringKrullDim A = 1)
    [Module.Finite A ↥(integralClosure A F)] (f : Fˣ) :
    milnorKTheoryZeroAddEquiv (ResidueField A)
        (oneDimTameSymbol A F hdim 0 ((milnorKTheoryOneAddEquiv F).symm (Additive.ofMul f))) =
      haveI := (Ring.krullDimLE_iff.2 (by rw [hdim]; exact_mod_cast le_rfl) : Ring.KrullDimLE 1 A)
      ordInt A (f : F) f.ne_zero := by
  have := (Ring.krullDimLE_iff.2 (by rw [hdim]; exact_mod_cast le_rfl) : Ring.KrullDimLE 1 A)
  let 𝓕 := normalizationDvrFamily A F hdim
  let := Fintype.ofFinite 𝓕.Index
  let φ : Fˣ →* Multiplicative ℤ :=
    { toFun := fun f ↦ Multiplicative.ofAdd (milnorKTheoryZeroAddEquiv (ResidueField A)
        (oneDimTameSymbol A F hdim 0 ((milnorKTheoryOneAddEquiv F).symm (Additive.ofMul f))))
      map_one' := by simp
      map_mul' := fun f g ↦ by simp [ofMul_mul, ← ofAdd_add] }
  have hval : ∀ f : Fˣ, (oneDimTameSymbol A F hdim 0
      ((milnorKTheoryOneAddEquiv F).symm (Additive.ofMul f)) : MilnorKRing (ResidueField A)) =
      (∑ m : 𝓕.Index, (Module.finrank (ResidueField A) (ResidueField (𝓕.Dvr m)) : ℤ) *
        dvrFracOrd (F := F) (exists_irreducible (𝓕.Dvr m)).choose_spec f) • 1 := by
    intro f
    rw [oneDimTameSymbol, SemilocalDvrFamily.coe_tameSymbol,
      ← tameShift_normalizationDvrFamily_milnorKSymbol A F hdim f,
      coe_milnorKTheoryOneAddEquiv_symm_ofMul]
  have hzero : ∀ (n : ℤ) (y : MilnorKTheory (ResidueField A) 0),
      (y : MilnorKRing (ResidueField A)) = n • 1 → milnorKTheoryZeroAddEquiv _ y = n := by
    intro n y hy
    have : y = milnorKZeroMap (ResidueField A) n := Subtype.ext <| by
      rw [hy]
      show _ = ((n : MilnorKRing (ResidueField A)))
      rw [zsmul_one]
    rw [this, milnorKTheoryZeroAddEquiv_milnorKZeroMap]
  have hA : ∀ (a : A) (ha : a ≠ 0) (haF : algebraMap A F a ≠ 0),
      Multiplicative.toAdd (φ (Units.mk0 _ haF)) =
        Multiplicative.toAdd (ordIntHom A F (Units.mk0 _ haF)) := by
    intro a ha haF
    rw [ordIntHom_apply]
    show milnorKTheoryZeroAddEquiv _ _ = _
    rw [hzero _ _ (hval _), sum_finrank_mul_dvrFracOrd_algebraMap hdim ha haF]
    exact (ordInt_algebraMap A a ha haF).symm
  have hext : φ = ordIntHom A F := by
    refine MonoidHom.ext fun x ↦ ?_
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := A) (x : F)
    have hbF : algebraMap A F b ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
    have ha0 : a ≠ 0 := fun h ↦ x.ne_zero (by rw [← hab, h, map_zero, zero_div])
    have haF : algebraMap A F a ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero ha0)
    rw [show x = Units.mk0 _ haF / Units.mk0 _ hbF from Units.ext (by simp [hab]), map_div,
      map_div]
    congr 1
    · exact congrArg Multiplicative.ofAdd (hA a ha0 haF)
    · exact congrArg Multiplicative.ofAdd (hA b (nonZeroDivisors.ne_zero hb) hbF)
  exact congrArg Multiplicative.toAdd (DFunLike.congr_fun hext f)

/-- **`∂_A = ord_A` in degree one for a Nagata local domain of dimension one**, in particular for
an excellent one. -/
theorem oneDimTameSymbol_zero_eq_ordInt_of_isNagataRing (hdim : ringKrullDim A = 1)
    (hN : IsNagataRing A) (f : Fˣ) :
    milnorKTheoryZeroAddEquiv (ResidueField A)
        (oneDimTameSymbol A F hdim 0 ((milnorKTheoryOneAddEquiv F).symm (Additive.ofMul f))) =
      haveI := (Ring.krullDimLE_iff.2 (by rw [hdim]; exact_mod_cast le_rfl) : Ring.KrullDimLE 1 A)
      ordInt A (f : F) f.ne_zero :=
  let := dimensionLEOne_of_ringKrullDim_eq_one A hdim
  have := module_finite_integralClosure_of_isNagataRing A F hN
  oneDimTameSymbol_zero_eq_ordInt A F hdim f

end Stacks.Chow

end
