@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.Chow

/-! ### Separable residue fields -/

/-- The residue field at a point of a scheme over `k` is separable over `k`, for the `k`-algebra
structure induced by the structure morphism followed by evaluation at the point. -/
def HasSeparableResidueField (k : Type u) [Field k] {X : Scheme.{u}}
    (p : X ⟶ (fieldChowSituation k).S) (x : X) : Prop :=
  letI := ((Scheme.ΓSpecIso (.of k)).inv ≫ p.appTop ≫ X.Γevaluation x).hom.toAlgebra
  Algebra.IsSeparable k (X.residueField x)

/-- **Stacks 01TE at a field base.** The residue field at a closed point of a scheme locally of
finite type over `k` is algebraic over `k`: it has finite transcendence degree, and that degree
vanishes at a closed point. -/
theorem isAlgebraic_residueField_of_isClosed (k : Type u) [Field k] {X : Scheme.{u}}
    (p : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType p] {x : X}
    (hx : IsClosed ({x} : Set X)) :
    letI := ((Scheme.ΓSpecIso (.of k)).inv ≫ p.appTop ≫ X.Γevaluation x).hom.toAlgebra
    Algebra.IsAlgebraic k (X.residueField x) := by
  let : Algebra k (X.residueField x) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ p.appTop ≫ X.Γevaluation x).hom.toAlgebra
  let : FinTrdeg k (X.residueField x) := residueField_finTrdeg k p x
  have h : Cardinal.toNat (Algebra.trdeg k (X.residueField x)) = 0 :=
    natTrdegResidueField_eq_zero_of_isClosed k X p x hx
  refine trdeg_eq_zero_iff.mp ?_
  rcases Cardinal.toNat_eq_zero.mp h with h0 | hinf
  · exact h0
  · exact absurd hinf (not_le_of_gt (trdeg_lt_aleph0 k (X.residueField x)))

/-- The residue field at a closed point of a scheme locally of finite type over a perfect field
is separable over it, since it is algebraic. -/
theorem hasSeparableResidueField_of_isClosed_of_perfectField (k : Type u) [Field k]
    [PerfectField k] {X : Scheme.{u}} (p : X ⟶ (fieldChowSituation k).S)
    [LocallyOfFiniteType p] {x : X} (hx : IsClosed ({x} : Set X)) :
    HasSeparableResidueField k p x := by
  let : Algebra k (X.residueField x) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ p.appTop ≫ X.Γevaluation x).hom.toAlgebra
  have : Algebra.IsAlgebraic k (X.residueField x) :=
    isAlgebraic_residueField_of_isClosed k p hx
  exact inferInstanceAs (Algebra.IsSeparable k (X.residueField x))

/-! ### Points of delta-dimension zero -/

/-- A point of delta-dimension zero of a scheme locally of finite type over a field is closed:
the integral closed subscheme it generates has a single point, so the closure of the point is the
point itself. -/
theorem isClosed_singleton_of_relativeDimension_eq_zero (k : Type u) [Field k] {X : Scheme.{u}}
    (p : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType p] {x : X}
    (hx : relativeDimension (fieldChowSituation k).dimensionFunction p x = 0) :
    IsClosed ({x} : Set X) := by
  have hW : IsIntegral (integralComponentAt x).subscheme := isIntegral_integralComponentAt x
  have : Subsingleton (integralComponentAt x).subscheme :=
    subsingleton_subscheme_of_schemeDeltaDimension_eq_zero k p (integralComponentAt x) hW
      (schemeDeltaDimension_integralComponentAt_of_relativeDimension_eq (fieldChowSituation k) p
        x hx)
  have hsub : (closure ({x} : Set X)).Subsingleton := by
    rw [← coe_support_integralComponentAt x,
      ← Scheme.IdealSheafData.range_subschemeι (I := integralComponentAt x), ← Set.image_univ]
    exact Set.subsingleton_univ.image _
  have hcl : closure ({x} : Set X) = {x} :=
    hsub.eq_singleton_of_mem (subset_closure (Set.mem_singleton x))
  exact hcl ▸ isClosed_closure

/-! ### The generating set of Stacks 0FH5 -/

/-- The classes in `A_0(X)` of the closed points of `X` whose residue fields are separable over
`k`: the generating set of Stacks 0FH5. -/
def separablePointClasses (k : Type u) [Field k] {X : Scheme.{u}}
    (p : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType p] :
    Set (chowGroup (fieldChowSituation k) p 0) :=
  {α | ∃ x : X, IsClosed ({x} : Set X) ∧ HasSeparableResidueField k p x ∧
    α = QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) p 0)
      (cycleAssociatedToClosedSubscheme (fieldChowSituation k) p
        (integralComponentAt x).subschemeι 0)}

/-- The class of a closed point with separable residue field is one of the generators. -/
theorem mk_mem_separablePointClasses (k : Type u) [Field k] {X : Scheme.{u}}
    (p : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType p] {x : X}
    (hx : IsClosed ({x} : Set X)) (hsep : HasSeparableResidueField k p x) :
    QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) p 0)
      (cycleAssociatedToClosedSubscheme (fieldChowSituation k) p
        (integralComponentAt x).subschemeι 0) ∈ separablePointClasses k p :=
  ⟨x, hx, hsep, rfl⟩

/-- A zero cycle on a quasi-compact scheme over `k` has class in an additive subgroup as soon as
the prime cycle of each of its support points does: the cycle is the finite sum of its prime
cycles weighted by its coefficients. -/
private theorem mk_mem_of_forall_mem_support (k : Type u) [Field k] {X : Scheme.{u}}
    (p : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType p] [CompactSpace X]
    (β : CycleGroup (fieldChowSituation k) p 0)
    (S : AddSubgroup (chowGroup (fieldChowSituation k) p 0))
    (h : ∀ y : X, β.1 y ≠ 0 →
      QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) p 0)
        (cycleAssociatedToClosedSubscheme (fieldChowSituation k) p
          (integralComponentAt y).subschemeι 0) ∈ S) :
    QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) p 0) β ∈ S := by
  have hfin := finite_support_of_compactSpace (fieldChowSituation k) p 0 β
  rw [eq_finsetSum_cycleAssociatedToIntegralComponentAt (fieldChowSituation k) p 0 β hfin,
    map_sum]
  refine AddSubgroup.sum_mem _ fun y hy ↦ ?_
  rw [map_zsmul]
  exact AddSubgroup.zsmul_mem _ (h y (hfin.mem_toFinset.mp hy)) _

/-- A zero cycle on a quasi-compact scheme over `k` each of whose support points is a closed
point with separable residue field has class in the subgroup generated by the classes of such
points. -/
theorem mk_mem_closure_separablePointClasses (k : Type u) [Field k] {X : Scheme.{u}}
    (p : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType p] [CompactSpace X]
    (β : CycleGroup (fieldChowSituation k) p 0)
    (hβ : ∀ y : X, β.1 y ≠ 0 → IsClosed ({y} : Set X) ∧ HasSeparableResidueField k p y) :
    QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) p 0) β ∈
      AddSubgroup.closure (separablePointClasses k p) :=
  mk_mem_of_forall_mem_support k p β _ fun y hy ↦
    AddSubgroup.subset_closure (mk_mem_separablePointClasses k p (hβ y hy).1 (hβ y hy).2)

/-! ### The Bertini step of the source proof -/

/-- **The output of Steps 3 to 8 of the proof of Stacks 0FH5.** For every closed point `x` of a
smooth projective scheme over `k` there are two zero cycles `Z` and `Z'`, each supported on
closed points with separable residue fields, such that `[x] + [Z] = [Z']` in `A_0(X)`.

In the source `Z` and `Z'` are the non-`x` parts of two general complete intersections of
divisors of sections of a very ample sheaf, both étale over `k`. It is proved for every field as
`Stacks.Chow.separablePointComplementaryCycles` in
`StacksFrontier.AlgebraicGeometry.Chow.ZeroCyclesSeparablePointsBertini`. -/
def SeparablePointComplementaryCycles (k : Type u) [Field k] : Prop :=
  ∀ {X : Scheme.{u}} (p : X ⟶ (fieldChowSituation k).S) [Smooth p] [IsProper p],
    IsProjectiveMorphism p → ∀ x : X, IsClosed ({x} : Set X) →
      ∃ Z Z' : CycleGroup (fieldChowSituation k) p 0,
        (∀ y : X, Z.1 y ≠ 0 → IsClosed ({y} : Set X) ∧ HasSeparableResidueField k p y) ∧
        (∀ y : X, Z'.1 y ≠ 0 → IsClosed ({y} : Set X) ∧ HasSeparableResidueField k p y) ∧
        QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) p 0)
              (cycleAssociatedToClosedSubscheme (fieldChowSituation k) p
                (integralComponentAt x).subschemeι 0) +
            QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) p 0) Z =
          QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) p 0) Z'

/-- Over a perfect field the Bertini step is unnecessary: every closed point already has
separable residue field, so `Z = 0` and `Z' = [x]` will do. -/
theorem separablePointComplementaryCycles_of_perfectField (k : Type u) [Field k]
    [PerfectField k] : SeparablePointComplementaryCycles.{u} k := by
  intro X p _ _ _ x hx
  refine ⟨0, cycleAssociatedToClosedSubscheme (fieldChowSituation k) p
    (integralComponentAt x).subschemeι 0, by simp, fun y hy ↦ ?_, by simp⟩
  obtain rfl : y = x := by
    by_contra hne
    exact hy (cycleAssociatedToIntegralComponentAt_apply_of_ne (fieldChowSituation k) p 0 x hne)
  exact ⟨hx, hasSeparableResidueField_of_isClosed_of_perfectField k p hx⟩

/-! ### From one closed point to all of `A_0(X)` -/

/-- **The reduction of Stacks 0FH5 to one closed point.** Let `k` be a field and let `X` be a
smooth projective scheme over `k`. Given `Stacks.Chow.SeparablePointComplementaryCycles k`,
`CH_0(X) = A_0(X)` is generated by the classes of the closed points of `X` whose residue fields
are separable over `k`. A class in `A_0(X)` is the class of a zero cycle, which has finite support
because `X` is proper over `k` and hence quasi-compact, so the cycle is a finite integral
combination of the prime cycles of its support points; each of those has delta-dimension zero and
is therefore a closed point, and the per-point statement replaces its class by the difference of
two classes of cycles supported on closed points with separable residue fields.

The per-point statement is proved for every field as
`Stacks.Chow.separablePointComplementaryCycles`, and Stacks 0FH5 itself is
`Stacks.Chow.mem_closure_separablePointClasses_of_isProjectiveMorphism`,
both in `StacksFrontier.AlgebraicGeometry.Chow.ZeroCyclesSeparablePointsBertini`. -/
theorem mem_closure_separablePointClasses (k : Type u) [Field k] {X : Scheme.{u}}
    (p : X ⟶ (fieldChowSituation k).S) [Smooth p] [IsProper p]
    (hproj : IsProjectiveMorphism p) (h0FH5 : SeparablePointComplementaryCycles.{u} k)
    (α : chowGroup (fieldChowSituation k) p 0) :
    α ∈ AddSubgroup.closure (separablePointClasses k p) := by
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace p
  induction α using QuotientAddGroup.induction_on with
  | H β =>
    rw [show QuotientAddGroup.mk β =
      QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) p 0) β from rfl]
    refine mk_mem_of_forall_mem_support k p β _ fun y hy ↦ ?_
    have hdim := (mem_cyclesOfDimension_iff_forall_point (fieldChowSituation k) p 0 β.1).mp β.2 y
      hy
    obtain ⟨Z, Z', hZ, hZ', heq⟩ :=
      h0FH5 p hproj y (isClosed_singleton_of_relativeDimension_eq_zero k p hdim)
    rw [show QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) p 0)
        (cycleAssociatedToClosedSubscheme (fieldChowSituation k) p
          (integralComponentAt y).subschemeι 0) =
        QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) p 0) Z' -
          QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) p 0) Z from
      eq_sub_of_add_eq heq]
    exact AddSubgroup.sub_mem _ (mk_mem_closure_separablePointClasses k p Z' hZ')
      (mk_mem_closure_separablePointClasses k p Z hZ)

/-- **Stacks 0FH5 over a perfect field**: for `k` perfect — in particular in characteristic zero
and for `k` finite — `A_0(X)` of a smooth projective `k`-scheme is generated by the classes of its
closed points, all of which have separable residue field. This is a special case of
`Stacks.Chow.mem_closure_separablePointClasses_of_isProjectiveMorphism`. -/
theorem mem_closure_separablePointClasses_of_perfectField (k : Type u) [Field k] [PerfectField k]
    {X : Scheme.{u}} (p : X ⟶ (fieldChowSituation k).S) [Smooth p] [IsProper p]
    (hproj : IsProjectiveMorphism p) (α : chowGroup (fieldChowSituation k) p 0) :
    α ∈ AddSubgroup.closure (separablePointClasses k p) :=
  mem_closure_separablePointClasses k p hproj
    (separablePointComplementaryCycles_of_perfectField k) α

end Stacks.Chow

end
