module

public import StacksFrontier.AlgebraicGeometry.Chow.DimensionFunction.PrincipalDivisorFamily
public import StacksFrontier.AlgebraicGeometry.Chow.FibreCycles.FamilyFibreDifferenceExistence
public import
  StacksFrontier.AlgebraicGeometry.Chow.ProperPushforwardPrincipal.DimensionDropApplications
public import StacksFrontier.AlgebraicGeometry.Variety.Defs.Basic

/-!
# Rational equivalence and rational functions on a variety

On a variety `X` over an algebraically closed field, the group of `k`-cycles rationally
equivalent to zero can be described in two ways. Geometrically it is generated by the
differences `[W₀]ₖ - [W_∞]ₖ` of the two distinguished scheme-theoretic fibres of a
`(k + 1)`-dimensional integral closed subscheme `W ⊆ X ×_S 𝐏¹_S` meeting both of them
properly. In Chow homology it is the group of locally finite sums of pushforwards of
principal divisors `div_V(f)` of nonzero rational functions on `(k + 1)`-dimensional integral
closed subschemes `V ⊆ X`. This file proves that the two agree.

## Main definitions

* `Stacks.Chow.fibreDifferences` — the set of basic rational equivalences `[W₀]ₖ - [W_∞]ₖ`.
* `Stacks.Chow.rationalEquivalencesByFibres` — the group of `k`-cycles they generate.

## Main results

* `Stacks.Chow.rationalEquivalences_eq_rationalEquivalencesByFibres` — **Stacks 0AZI.** The
  two groups coincide, so the geometric rational equivalence agrees with the one of Chow
  homology.
* `Stacks.Chow.principalDivisorPushforward_mem_rationalEquivalencesByFibres` — **Stacks
  0AZI.** The principal divisor of a nonzero rational function on a `(k + 1)`-dimensional
  integral closed subscheme of `X`, read as a `k`-cycle on `X`, is one of the cycles the
  basic rational equivalences generate.

## Implementation notes

The basic rational equivalences are built from the family `Stacks.Chow.projectiveLineProduct`
with its two distinguished sections, so no second model of `X ×_S 𝐏¹_S` and no second notion
of scheme-theoretic fibre appear. That a subvariety meets both fibres properly is expressed,
as in `Stacks.Chow.fibreCycles_rationallyEquivalent`, by asking that it be contained in
neither section; for an integral `W` of relative dimension `k + 1` this is exactly the
condition that both intersections have dimension at most `k`.

Taking the subgroup generated by the basic differences admits only finite sums of them,
whereas `Stacks.Chow.rationalEquivalences` admits locally finite families. The two agree here
because a variety is quasi-compact and `X ×_S 𝐏¹_S ⟶ X` is proper, so the total space is
quasi-compact and a locally finite family of nonempty closed subsets of it is finite.

The field is written `K` and the dimension of a cycle `k`, since the chapter's `k` is used
for both.

## References

* [Stacks Project, Tag 0AZI](https://stacks.math.columbia.edu/tag/0AZI)
* [Stacks Project, Tag 0AZG](https://stacks.math.columbia.edu/tag/0AZG), the geometric
  definition of rational equivalence by fibre differences.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Chow

/-! ### Finiteness of locally finite families on a variety's projective line family -/

/-- The family of projective lines over a variety is quasi-compact: the variety is
quasi-compact over the spectrum of the field, and `X ×_S 𝐏¹_S ⟶ X` is proper. -/
theorem compactSpace_projectiveLineProduct (K : Type u) [Field K]
    (C : ChowSituation.{u}) (hC : C.S = AlgebraicGeometry.Spec (CommRingCat.of K))
    {X : Scheme.{u}} (p : X ⟶ C.S)
    [AlgebraicGeometry.IsVariety K (p ≫ eqToHom hC)] :
    CompactSpace (projectiveLineProduct p) := by
  have : CompactSpace X :=
    QuasiCompact.compactSpace_of_compactSpace (p ≫ eqToHom hC)
  exact QuasiCompact.compactSpace_of_compactSpace
    (pullback.fst p (relativeProjectiveLine C.S ↘ C.S))

/-- A locally finite family of nonempty sets in a quasi-compact space is indexed by a finite
type: every index contributes a point, so every index meets the whole space. -/
theorem finite_of_locallyFinite_of_nonempty {J : Type*} {T : Type*} [TopologicalSpace T]
    [CompactSpace T] (E : J → Set T) (hE : LocallyFinite E)
    (hne : ∀ j, (E j).Nonempty) : Finite J := by
  have hindices : {j : J | (E j ∩ (Set.univ : Set T)).Nonempty}.Finite :=
    hE.finite_nonempty_inter_compact isCompact_univ
  have hsubset : (Set.univ : Set J) ⊆ {j : J | (E j ∩ (Set.univ : Set T)).Nonempty} := by
    intro j _
    obtain ⟨x, hx⟩ := hne j
    exact ⟨x, hx, Set.mem_univ x⟩
  have hJ : (Set.univ : Set J).Finite := hindices.subset hsubset
  have : Finite (↥(Set.univ : Set J)) := hJ.to_subtype
  exact Finite.of_injective (Equiv.Set.univ J).symm (Equiv.injective _)

/-- The support of an integral closed subscheme is nonempty: it is the image of the closed
immersion, which contains the image of the generic point. -/
theorem nonempty_support_of_isIntegral {T : Scheme.{u}} (W : T.IdealSheafData)
    [IsIntegral W.subscheme] : (W.support : Set T).Nonempty := by
  refine ⟨W.subschemeι (genericPoint W.subscheme), ?_⟩
  rw [← W.range_subschemeι]
  exact Set.mem_range_self _

/-! ### The geometric rational equivalence -/

/-- The basic rational equivalences: the differences `[W₀]ₖ - [W_∞]ₖ` of the cycles of the two
distinguished fibres of an integral closed subscheme `W ⊆ X ×_S 𝐏¹_S` of relative dimension
`k + 1` which is contained in neither distinguished section. -/
@[stacks 0AZG "the basic rational equivalence `[W_a]_k - [W_b]_k` of Section 43.8, with the \
pair of distinct closed points taken to be `a = 0` and `b = ∞`. That choice is the one the \
source itself makes (`A traditional choice is to choose a = 0 and b = ∞`); that an arbitrary \
pair of distinct closed points may be moved to it is the 2-transitivity of the automorphism \
group of the projective line, Tag 0B2U, which is not invoked here. Proper intersection of `W` \
with the two fibres is expressed, for an integral `W` of relative dimension `k + 1`, by asking \
that `W` be contained in neither section."]
def fibreDifferences (C : ChowSituation.{u}) {X : Scheme.{u}} (p : X ⟶ C.S)
    [LocallyOfFiniteType p] (k : ℤ) : Set (CycleGroup C p k) :=
  {γ | ∃ W : (projectiveLineProduct p).IdealSheafData,
    IsIntegral W.subscheme ∧
    (∀ ξ : genericPoints W.subscheme,
      relativeDimension C.dimensionFunction (familyBase p W) ξ.1 = k + 1) ∧
    (¬ Set.range W.subschemeι ⊆ Set.range (zeroSection p)) ∧
    (¬ Set.range W.subschemeι ⊆ Set.range (infinitySection p)) ∧
    γ = cycleAssociatedToClosedSubscheme C p (zeroFiber p W).subschemeι k -
      cycleAssociatedToClosedSubscheme C p (infinityFiber p W).subschemeι k}

/-- The group of `k`-cycles rationally equivalent to zero in the geometric sense: the subgroup
of `Zₖ(X)` generated by the basic rational equivalences. -/
@[stacks 0AZG "the group of `k`-cycles rationally equivalent to zero of Section 43.8, the cycles \
`∑ nᵢ([W_{i, aᵢ}]_k - [W_{i, bᵢ}]_k)`, with every pair of closed points taken to be `0` and `∞` \
as in `Stacks.Chow.fibreDifferences`. The identification of the scheme-theoretic fibre `W_a` \
with the scheme-theoretic intersection `W ∩ X × a` inside `X × P¹`, also part of Section 43.8, \
is NOT carried: the fibre here is the scheme-theoretic preimage along the section, which is how \
the source views it as a closed subscheme of `X`, and no comparison with the intersection in \
`X × P¹` is proved."]
def rationalEquivalencesByFibres (C : ChowSituation.{u}) {X : Scheme.{u}} (p : X ⟶ C.S)
    [LocallyOfFiniteType p] (k : ℤ) : AddSubgroup (CycleGroup C p k) :=
  AddSubgroup.closure (fibreDifferences C p k)

/-- A basic rational equivalence generates: the difference of the two fibre cycles of an
integral closed subscheme of relative dimension `k + 1` contained in neither distinguished
section lies in the geometric rational equivalence group. -/
theorem sub_cycleAssociatedToFibres_mem_rationalEquivalencesByFibres (C : ChowSituation.{u})
    {X : Scheme.{u}} (p : X ⟶ C.S) [LocallyOfFiniteType p] (k : ℤ)
    (W : (projectiveLineProduct p).IdealSheafData) (hW : IsIntegral W.subscheme)
    (hDim : ∀ ξ : genericPoints W.subscheme,
      relativeDimension C.dimensionFunction (familyBase p W) ξ.1 = k + 1)
    (h₀ : ¬ Set.range W.subschemeι ⊆ Set.range (zeroSection p))
    (hInf : ¬ Set.range W.subschemeι ⊆ Set.range (infinitySection p)) :
    cycleAssociatedToClosedSubscheme C p (zeroFiber p W).subschemeι k -
        cycleAssociatedToClosedSubscheme C p (infinityFiber p W).subschemeι k ∈
      rationalEquivalencesByFibres C p k :=
  AddSubgroup.subset_closure ⟨W, hW, hDim, h₀, hInf, rfl⟩

/-- **Stacks Project, Tag 0AZI.** On a variety over an algebraically closed field the
principal divisors of nonzero rational functions on the `(k + 1)`-dimensional integral closed
subschemes generate exactly the group of `k`-cycles rationally equivalent to zero in the
geometric sense: the rational equivalence of Chow homology agrees with the geometric one. -/
@[stacks 0AZI "principal divisors generate the cycles rationally equivalent to zero"]
theorem rationalEquivalences_eq_rationalEquivalencesByFibres (K : Type u) [Field K]
    [IsAlgClosed K] (C : ChowSituation.{u})
    (hC : C.S = AlgebraicGeometry.Spec (CommRingCat.of K)) {X : Scheme.{u}}
    (p : X ⟶ C.S) [LocallyOfFiniteType p]
    [AlgebraicGeometry.IsVariety K (p ≫ eqToHom hC)] (k : ℤ) :
    rationalEquivalences C p k = rationalEquivalencesByFibres C p k := by
  refine le_antisymm (fun α hα ↦ ?_) ?_
  · rw [mem_rationalEquivalences] at hα
    obtain ⟨J, W, hInt, hDim, h₀, hInf, hLocal, hCoeff⟩ :=
      exists_familyFibreDifferences C p k α hα
    have : CompactSpace (projectiveLineProduct p) :=
      compactSpace_projectiveLineProduct K C hC p
    have : Finite J := finite_of_locallyFinite_of_nonempty
      (fun j ↦ ((W j).support : Set (projectiveLineProduct p))) hLocal
      (fun j ↦ @nonempty_support_of_isIntegral _ (W j) (hInt j))
    let _ : Fintype J := Fintype.ofFinite J
    set γ : J → CycleGroup C p k := fun j ↦
      cycleAssociatedToClosedSubscheme C p (zeroFiber p (W j)).subschemeι k -
        cycleAssociatedToClosedSubscheme C p (infinityFiber p (W j)).subschemeι k with hγdef
    have hsum : (∑ j, γ j) ∈ rationalEquivalencesByFibres C p k :=
      AddSubmonoid.sum_mem (rationalEquivalencesByFibres C p k).toAddSubmonoid
        fun j _ ↦ sub_cycleAssociatedToFibres_mem_rationalEquivalencesByFibres C p k (W j)
          (hInt j) (hDim j) (h₀ j) (hInf j)
    have hval : α = ∑ j, γ j := by
      refine Subtype.ext (Function.locallyFinsuppWithin.ext fun x ↦ ?_)
      have hrhs : ((∑ j, γ j : CycleGroup C p k) : AlgebraicCycle X ℤ) x =
          ∑ j, ((cycleAssociatedToClosedSubscheme C p (zeroFiber p (W j)).subschemeι k).1 x -
            (cycleAssociatedToClosedSubscheme C p (infinityFiber p (W j)).subschemeι k).1 x) := by
        simp [hγdef]
      rw [hrhs, hCoeff x, familyFibreDifferenceCoefficient,
        finsum_eq_sum_of_support_subset _ (s := Finset.univ) (by intro j _; simp)]
    rw [hval]
    exact hsum
  · refine (AddSubgroup.closure_le (rationalEquivalences C p k)).2 ?_
    rintro γ ⟨W, hW, hDim, h₀, hInf, rfl⟩
    have := hW
    exact fibreCycles_rationallyEquivalent C p k W hDim h₀ hInf

/-- **Stacks Project, Tag 0AZI.** On a variety over an algebraically closed field the
principal divisor of a nonzero rational function on an integral closed subscheme of
delta-dimension `k + 1`, pushed forward to a `k`-cycle on the variety, is rationally
equivalent to zero in the geometric sense. -/
@[stacks 0AZI "principal divisors are rationally equivalent to zero"]
theorem principalDivisorPushforward_mem_rationalEquivalencesByFibres (K : Type u) [Field K]
    [IsAlgClosed K] (C : ChowSituation.{u})
    (hC : C.S = AlgebraicGeometry.Spec (CommRingCat.of K)) {X : Scheme.{u}}
    (p : X ⟶ C.S) [LocallyOfFiniteType p]
    [AlgebraicGeometry.IsVariety K (p ≫ eqToHom hC)] (k : ℤ) (V : X.IdealSheafData)
    (hV : IsIntegral V.subscheme)
    (hDim : schemeDeltaDimension C (V.subschemeι ≫ p) = ((k + 1 : ℤ) : EInt))
    (f : (rationalFunctions V.subscheme)ˣ) :
    (⟨principalDivisorPushforward C p V hV f,
        principalDivisorPushforward_mem_cyclesOfDimension C p k V hV hDim f⟩ :
      CycleGroup C p k) ∈ rationalEquivalencesByFibres C p k := by
  rw [← rationalEquivalences_eq_rationalEquivalencesByFibres K C hC p k,
    mem_rationalEquivalences]
  refine ⟨PUnit.{u + 1}, fun _ ↦ V, fun _ ↦ hV, fun _ ↦ hDim, ?_, fun _ ↦ f, fun x ↦ ?_⟩
  · exact fun x ↦ ⟨Set.univ, Filter.univ_mem, Set.finite_univ.subset (fun j _ ↦ trivial)⟩
  · rw [principalDivisorFamilyCoefficient, finsum_unique]

end Stacks.Chow

end
