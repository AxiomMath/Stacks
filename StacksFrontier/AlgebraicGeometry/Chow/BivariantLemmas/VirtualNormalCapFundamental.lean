-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Chow

/-! ### The dimension of a local ring on a `δ`-equidimensional scheme -/

/-- A scheme is sober in the unbundled sense used by the catenarity criterion: every irreducible
closed subset has a unique generic point. -/
@[ega "I 1.1.14" "more general", ega "I 2.1.5", sga "4 IV 4.2.1" "partial", sga "4 VIII 7.9.3"]
private alias isSoberSpace_scheme := scheme_stacksSober

/-- A bundled dimension function is a dimension function in the sense used by the catenarity
criterion: the two notions of immediate specialization are the same conjunction, written in a
different order. -/
private theorem isDimensionFunctionForCatenary_dimensionFunction {T : Type*}
    [TopologicalSpace T] (d : DimensionFunction T) : IsDimensionFunctionForCatenary d := by
  constructor
  · intro x y hxy hne
    exact d.strictAnti_specializes hxy hne
  · intro x y hxy
    exact d.step_immediate hxy

/-- Proper inclusion of closures of points is the strict order on points of a scheme:
specialization of points is reverse inclusion of singleton closures. -/
private theorem closure_singleton_ssubset_iff_lt {X : Scheme.{u}} {x y : X} :
    closure ({x} : Set X) ⊂ closure ({y} : Set X) ↔ x < y := by
  simp only [lt_iff_le_not_ge, Scheme.le_iff_specializes,
    specializes_iff_closure_subset]

/-- **The `δ`-dimension computes the coheight.** On a scheme locally of finite type over the
base of a Chow situation all of whose irreducible components have `δ`-dimension `n`, the
coheight of a point is `n` minus its `δ`-dimension.

This is the step "by assumption (2) we see that `dim(𝒪_{Y, ξ}) = r`" of the proof of Stacks
0FEA, in its topological form; see `Stacks.Chow.ringKrullDim_stalk_eq_toNat_sub_relativeDimension`
for the statement about the local ring. -/
theorem coheight_eq_toNat_sub_relativeDimension (C : ChowSituation.{u}) {X : Scheme.{u}}
    (sX : X ⟶ C.S) [LocallyOfFiniteType sX] {n : ℤ}
    (hgen : ∀ W : irreducibleComponents X,
      relativeDimension C.dimensionFunction sX W.2.1.genericPoint = n)
    (x : X) :
    Order.coheight x =
      (((n - relativeDimension C.dimensionFunction sX x).toNat : ℕ) : ℕ∞) := by
  have hsober : StacksSober X := isSoberSpace_scheme X
  set d := deltaDimensionFunction C sX with hdset
  have hdapp : ∀ y : X, d y = relativeDimension C.dimensionFunction sX y := fun y => by
    rw [hdset, deltaDimensionFunction_apply]
  have hcat : IsDimensionFunctionForCatenary d :=
    isDimensionFunctionForCatenary_dimensionFunction d
  have hub : ∀ y : X, d y ≤ n := fun y =>
    (hdapp y).trans_le (relativeDimension_le_of_forall_genericPoint C sX hgen y)
  have hdx : d x = relativeDimension C.dimensionFunction sX x := hdapp x
  refine le_antisymm (Order.coheight_le_iff'.mpr fun p hp => ?_) ?_
  · -- Every upward chain of points yields a chain of closures, whose length the codimension
    -- formula bounds by the drop of `d`.
    have hchain : IsClosedIrreducibleChain p.length
        (fun k : Fin (p.length + 1) => closure ({p k} : Set X))
        (closure ({x} : Set X)) (closure ({p.last} : Set X)) :=
      { first := congrArg (fun y : X => closure ({y} : Set X)) hp
        last := rfl
        isClosed := fun _ => isClosed_closure
        isIrreducible := fun _ => isIrreducible_singleton.closure
        strictMono := fun _ _ h => closure_singleton_ssubset_iff_lt.mpr (p.strictMono h) }
    have hbound : (p.length : ℤ) ≤ d p.last - d x :=
      chain_length_le_delta_diff hsober d hcat p.last x p.length _ hchain
    have hlast := hub p.last
    have : p.length ≤ (n - relativeDimension C.dimensionFunction sX x).toNat := by
      rw [← hdx]; omega
    exact_mod_cast this
  · -- The extremal chain of the codimension formula, taken from the generic point of a
    -- component through `x` down to `x`, has length exactly `n - δ(x)`.
    obtain ⟨W, hxW⟩ := exists_mem_irreducibleComponents x
    have hη : IsGenericPoint W.2.1.genericPoint (W : Set X) :=
      W.2.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents (W : Set X) W.2)
    have hdη : d W.2.1.genericPoint = n := by rw [hdapp, hgen W]
    obtain ⟨f, hf⟩ := exists_chain_of_length_delta_diff hsober d hcat
      W.2.1.genericPoint x (hη.specializes hxW)
    obtain ⟨w, hw⟩ := exists_generic_point_function hsober _ f _ _ hf
    have hwmono : StrictMono w := fun k l hkl =>
      closure_singleton_ssubset_iff_lt.mp (by rw [hw k, hw l]; exact hf.strictMono hkl)
    have hw0 : w 0 = x :=
      eq_of_closure_singleton_eq hsober x (w 0) (by rw [hw 0, hf.first])
    have heq : (d W.2.1.genericPoint - d x).toNat
        = (n - relativeDimension C.dimensionFunction sX x).toNat := by rw [hdη, hdx]
    rw [← heq]
    exact_mod_cast Order.length_le_coheight (x := x)
      (p := LTSeries.mk (d W.2.1.genericPoint - d x).toNat w hwmono) (le_of_eq hw0.symm)

/-- **The `δ`-dimension computes the dimension of the local ring.** On a scheme locally of
finite type over the base of a Chow situation all of whose irreducible components have
`δ`-dimension `n`, the local ring at a point of `δ`-dimension `m` has Krull dimension `n - m`.

This is the step "by assumption (2) we see that `dim(𝒪_{Y, ξ}) = r`" of the proof of Stacks
0FEA. -/
theorem ringKrullDim_stalk_eq_toNat_sub_relativeDimension (C : ChowSituation.{u})
    {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX] {n : ℤ}
    (hgen : ∀ W : irreducibleComponents X,
      relativeDimension C.dimensionFunction sX W.2.1.genericPoint = n)
    (x : X) :
    ringKrullDim (X.presheaf.stalk x) =
      ((((n - relativeDimension C.dimensionFunction sX x).toNat : ℕ) : ℕ∞) : WithBot ℕ∞) := by
  rw [AlgebraicGeometry.ringKrullDim_stalk_eq_coheight x,
    coheight_eq_toNat_sub_relativeDimension C sX hgen x]

/-! ### The regular sequence cutting out `Z ×_X Y` in `Y` -/

/-- **Stacks 0FEA, the regular sequence of the proof.** Let `(S, δ)` be as in Stacks 02QL, let
`X` be locally of finite type over `S`, let `i : Z ⟶ X` be a closed subscheme and let
`g : Y ⟶ X` be locally of finite type. Assume

* every irreducible component of `Y` has `δ`-dimension `n` (hypothesis (2)),
* `dim_δ(Z ×_X Y) ≤ n - r` (hypothesis (3)),
* `ξ ∈ Z ×_X Y` has `δ(ξ) = n - r` and `𝒪_{Y, ξ}` is Cohen–Macaulay (hypothesis (4)), and
* the ideal of `Z ×_X Y` in `𝒪_{Y, ξ}` is generated by a list `xs` of `r` elements, which is
  what hypothesis (1) provides.

Then `xs` is a regular sequence. Equivalently: `Z ×_X Y` is cut out of `Y` by a regular sequence
of length `r` at every point of `δ`-dimension `n - r`, which is what the source establishes
before invoking the excess intersection formula of Stacks 0FBM to conclude
`c(Z ⟶ X, 𝒩) ∩ [Y]_n = [Z ×_X Y]_{n - r}`. See the implementation notes for why that
conclusion is not stated. -/
@[stacks 0FEA "the regular sequence of the proof: hypotheses (1)-(4) force the ideal of \
`Z ×_X Y` in `𝒪_{Y, ξ}` to be generated by a regular sequence of length `r` at every point of \
`Z ×_X Y` of `δ`-dimension `n - r`. The cap product `c(Z ⟶ X, 𝒩) ∩ [Y]_n` is NOT stated, \
Stacks 0FBK having no carrier here. See the implementation notes"]
theorem isRegular_of_isCohenMacaulayLocalRing_stalk (C : ChowSituation.{u})
    {X Y Z : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
    (i : Z ⟶ X) [IsClosedImmersion i] (g : Y ⟶ X) [LocallyOfFiniteType g] {n : ℤ} {r : ℕ}
    (hY : ∀ W : irreducibleComponents Y,
      deltaDimension C (g ≫ sX)
        ⟨W, W.2.1, isClosed_of_mem_irreducibleComponents (W : Set Y) W.2⟩ = n)
    (hZY : schemeDeltaDimension C (pullback.snd i g ≫ (g ≫ sX)) ≤ ((n - r : ℤ) : EInt))
    (ξ : (pullback i g : Scheme.{u}))
    (hξ : relativeDimension C.dimensionFunction (g ≫ sX) ((pullback.snd i g).base ξ) = n - r)
    (hCM : letI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (g ≫ sX)
      IsCohenMacaulayLocalRing (Y.presheaf.stalk ((pullback.snd i g).base ξ)))
    (xs : List (Y.presheaf.stalk ((pullback.snd i g).base ξ))) (hlen : xs.length = r)
    (hxs : Ideal.ofList xs = RingHom.ker ((pullback.snd i g).stalkMap ξ).hom) :
    RingTheory.Sequence.IsRegular (Y.presheaf.stalk ((pullback.snd i g).base ξ)) xs := by
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (g ≫ sX)
  -- The local ring of `Y` at `ξ` has dimension `r`, by hypotheses (2) and `δ(ξ) = n - r`.
  have hdimY : ringKrullDim (Y.presheaf.stalk ((pullback.snd i g).base ξ)) =
      (((r : ℕ) : ℕ∞) : WithBot ℕ∞) := by
    rw [ringKrullDim_stalk_eq_toNat_sub_relativeDimension C (g ≫ sX)
      hY ((pullback.snd i g).base ξ), hξ]
    norm_num
  -- Hypothesis (3) makes `ξ` a generic point of `Z ×_X Y`, so its local ring has dimension zero.
  have hgp : ξ ∈ genericPoints (pullback i g : Scheme.{u}) := by
    obtain ⟨W, hW⟩ :=
      isGenericPoint_component_of_relativeDimension_eq C (g ≫ sX) (pullback.snd i g) hZY ξ hξ
    show closure ({ξ} : Set (pullback i g : Scheme.{u})) ∈
      irreducibleComponents (pullback i g : Scheme.{u})
    rw [hW.def]
    exact W.2
  -- The stalk of `Z ×_X Y` at `ξ` is the quotient of `𝒪_{Y, ξ}` by the ideal.
  have hquot : ringKrullDim (Y.presheaf.stalk ((pullback.snd i g).base ξ) ⧸
      RingHom.ker ((pullback.snd i g).stalkMap ξ).hom) = 0 := by
    rw [ringKrullDim_eq_of_ringEquiv
      (RingHom.quotientKerEquivOfSurjective ((pullback.snd i g).stalkMap_surjective ξ))]
    exact ringKrullDim_stalk_eq_zero_of_mem_genericPoints ⟨ξ, hgp⟩
  -- Stacks 02JN: in a Cohen–Macaulay local ring an ideal of definition generated by
  -- `dim` many elements is generated by a regular sequence.
  refine Module.IsMaximalCohenMacaulay.isRegular_of_ofList_eq
    ((isCohenMacaulayLocalRing_iff_isMaximalCohenMacaulay _).mp hCM)
    (RingHom.ker_ne_top _) ?_ hxs hlen
  rw [hquot, hdimY, zero_add]
  norm_cast

end Stacks.Chow

end
