* [Stacks Project, Tag 0FBK](https://stacks.math.columbia.edu/tag/0FBK)
* [Stacks Project, Tag 0FBM](https://stacks.math.columbia.edu/tag/0FBM)
* [Stacks Project, Tag 063I](https://stacks.math.columbia.edu/tag/063I)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Chow

/-! ### Spreading the regular sequence to a neighbourhood -/

/-- The ideal that the kernel ideal sheaf of a closed immersion `j : W ⟶ Y` cuts out in the local
ring at `j w` is the kernel of the map of local rings `𝒪_{Y, j w} ⟶ 𝒪_{W, w}`. Both are the
extension of the kernel of `j` on the sections over an affine neighbourhood of `j w`. -/
theorem stalkIdeal_ker_eq_ker_stalkMap {W Y : Scheme.{u}} (j : W ⟶ Y) [IsClosedImmersion j]
    (w : W) (hw : j w ∈ j.ker.support) :
    Stacks.AlgebraicGeometry.stalkIdeal j.ker (j w) hw = RingHom.ker (j.stalkMap w).hom := by
  obtain ⟨U, hU, hwU, -⟩ := Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens
    (show j w ∈ (⊤ : Y.Opens) from trivial)
  have hsurj : Function.Surjective (j.appLE U (j ⁻¹ᵁ U) le_rfl).hom := by
    rw [Scheme.Hom.appLE_eq_app]
    exact j.app_surjective U hU
  rw [Stacks.AlgebraicGeometry.stalkIdeal_eq_map_germ j.ker (j w) hw hU hwU,
    Scheme.Hom.ker_apply j ⟨U, hU⟩,
    Stacks.Flatness.ker_stalkMap_eq_map_germ j hU (hU.preimage j) le_rfl (x := w) hwU hwU hsurj,
    Scheme.Hom.appLE_eq_app]

/-- **Stacks 063I, spread to a regular closed immersion of fixed codimension.** Let `Y` be
locally Noetherian, let `j : W ⟶ Y` be a closed immersion and let `w ∈ W` be a point at which the
kernel of `𝒪_{Y, j w} ⟶ 𝒪_{W, w}` is generated by a regular sequence of length `r`. Then there is
an open neighbourhood `V` of `j w` such that the base change of `j` to `V` is a regular closed
immersion of codimension `r`.

The source's step is "by Divisors, Lemma 31.20.6 we see that `𝓘` is generated by a regular
sequence over an open neighbourhood `V ⊂ Y` of `ξ`". The neighbourhood is the affine open of the
implication `(1) ⇒ (5)` of Stacks 063I, which keeps the length of the sequence, and over it the
defining ideal of the base change is generated by the restrictions of the sequence. -/
@[ega "IV 16.9.10" "(i)"]
theorem exists_isRegularClosedImmersionOfCodim_of_isRegular_stalk {W Y : Scheme.{u}}
    [IsLocallyNoetherian Y] (j : W ⟶ Y) [IsClosedImmersion j] (w : W) {r : ℕ}
    (xs : List (Y.presheaf.stalk (j w))) (hlen : xs.length = r)
    (hxs : Ideal.ofList xs = RingHom.ker (j.stalkMap w).hom)
    (hreg : RingTheory.Sequence.IsRegular (Y.presheaf.stalk (j w)) xs) :
    ∃ V : Y.Opens, j w ∈ V ∧ ∀ {W' : Scheme.{u}} (j' : W' ⟶ V) (h' : W' ⟶ W),
      IsPullback j' h' V.ι j →
        Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularClosedImmersionOfCodim j' r := by
  subst hlen
  have hw : j w ∈ j.ker.support := by
    have hsupp : (j.ker.support : Set Y) = closure (Set.range j.base) := by
      rw [Scheme.Hom.support_ker]
    change j w ∈ (j.ker.support : Set Y)
    rw [hsupp]
    exact subset_closure ⟨w, rfl⟩
  have hofFn : List.ofFn (fun k : Fin xs.length => xs[k]) = xs := List.ofFn_getElem
  have hspan : Stacks.AlgebraicGeometry.stalkIdeal j.ker (j w) hw =
      Ideal.span (Set.range fun k : Fin xs.length => xs[k]) := by
    rw [stalkIdeal_ker_eq_ker_stalkMap, ← hxs,
      Stacks.AlgebraicGeometry.ofList_eq_span_range_getElem]
  obtain ⟨W₀, hwW₀, a, hgen₀, hreg₀⟩ :=
    Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_affineOpen_span_eq_ideal_isRegular_germ
      j.ker (j w) hw _ hspan (by rw [hofFn]; exact hreg)
  obtain ⟨V, hwV, f, hgen, hregV⟩ :=
    Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_affineOpen_isRegular_of_isRegular_germ
      j.ker (j w) hw W₀ hwW₀ a hgen₀ hreg₀
  refine ⟨V.1, hwV, fun {W'} j' h' H => ?_⟩
  have : IsClosedImmersion j' := MorphismProperty.of_isPullback H.flip inferInstance
  have hVtop : IsAffineOpen (⊤ : V.1.toScheme.Opens) := @isAffineOpen_top V.1.toScheme V.2
  have hker' : j'.ker = j.ker.comap V.1.ι := by
    rw [← H.isoPullback_hom_fst, Scheme.Hom.ker_comp_of_isIso,
      Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]
  have hker : RingHom.ker (j'.app ⊤).hom =
      Ideal.span (Set.range fun k => V.1.topIso.inv (f k)) := by
    rw [← Scheme.Hom.ker_apply j' ⟨⊤, hVtop⟩, hker',
      Stacks.AlgebraicGeometry.RegularIdealSheaf.ideal_comap_ι_top j.ker V hVtop, hgen,
      Ideal.map_span, ← Set.range_comp]
    rfl
  intro x _
  refine ⟨⊤, trivial, fun k => V.1.topIso.inv (f k), ?_,
    Stacks.AlgebraicGeometry.isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span j' hVtop _
      hker⟩
  exact Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularSequenceOn_of_isWeaklyRegular
    V.1.toScheme ⊤ hVtop _
    (Stacks.AlgebraicGeometry.isWeaklyRegular_ofFn_map_of_flat V.1.topIso.inv.hom
      (RingHom.Flat.of_bijective V.1.topIso.symm.commRingCatIsoToRingEquiv.bijective) f
      hregV.toIsWeaklyRegular)

/-! ### Open subschemes of a `δ`-equidimensional scheme -/

/-- **A scheme open in a scheme pure of `δ`-dimension `n` is pure of `δ`-dimension `n`.** If
every irreducible component of `Y` has `δ`-dimension `n` and `j : V ⟶ Y` is an open immersion,
every irreducible component of `V` has `δ`-dimension `n`: the generic point of a component of
`V` maps to the generic point of a component of `Y`, and an open immersion does not change
`δ`. -/
theorem deltaDimension_irreducibleComponents_of_isOpenImmersion (C : ChowSituation.{u})
    {Y V : Scheme.{u}} (sY : Y ⟶ C.S) [LocallyOfFiniteType sY] {n : ℤ}
    (hY : ∀ T : irreducibleComponents Y,
      deltaDimension C sY ⟨T, T.2.1, isClosed_of_mem_irreducibleComponents (T : Set Y) T.2⟩ = n)
    (j : V ⟶ Y) [IsOpenImmersion j] (T : irreducibleComponents V) :
    deltaDimension C (j ≫ sY)
      ⟨T, T.2.1, isClosed_of_mem_irreducibleComponents (T : Set V) T.2⟩ = n := by
  have hη : IsGenericPoint T.2.1.genericPoint (T : Set V) :=
    T.2.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents (T : Set V) T.2)
  have hηgen : T.2.1.genericPoint ∈ genericPoints V := by
    change closure {T.2.1.genericPoint} ∈ irreducibleComponents V
    rw [hη.def]
    exact T.2
  have hgen : j T.2.1.genericPoint ∈ genericPoints Y :=
    j.isOpenEmbedding.mem_genericPoints hηgen
  have h := hY ⟨closure {j T.2.1.genericPoint}, hgen⟩
  rw [deltaDimension_eq_of_isGenericPoint C sY _ (j T.2.1.genericPoint) isGenericPoint_closure]
    at h
  rw [deltaDimension_eq_of_isGenericPoint C (j ≫ sY) _ T.2.1.genericPoint hη,
    relativeDimension_comp_isOpenImmersion]
  exact h

/-- **An open subscheme of a scheme pure of `δ`-dimension `n` is pure of `δ`-dimension `n`.** The
case of `Stacks.Chow.deltaDimension_irreducibleComponents_of_isOpenImmersion` for the inclusion
of an open subscheme. -/
theorem deltaDimension_irreducibleComponents_opens (C : ChowSituation.{u}) {Y : Scheme.{u}}
    (sY : Y ⟶ C.S) [LocallyOfFiniteType sY] {n : ℤ}
    (hY : ∀ T : irreducibleComponents Y,
      deltaDimension C sY ⟨T, T.2.1, isClosed_of_mem_irreducibleComponents (T : Set Y) T.2⟩ = n)
    (V : Y.Opens) (T : irreducibleComponents V) :
    deltaDimension C (V.ι ≫ sY)
      ⟨T, T.2.1, isClosed_of_mem_irreducibleComponents (T : Set V) T.2⟩ = n :=
  deltaDimension_irreducibleComponents_of_isOpenImmersion C sY hY V.ι T

/-- **A bound on relative dimension bounds the `δ`-dimension.** If `δ(w) ≤ m` at every point
`w` of `W`, then `dim_δ(W) ≤ m`. -/
theorem schemeDeltaDimension_le_of_relativeDimension_le (C : ChowSituation.{u}) {W : Scheme.{u}}
    (s : W ⟶ C.S) [LocallyOfFiniteType s] {m : ℤ}
    (h : ∀ w, relativeDimension C.dimensionFunction s w ≤ m) :
    schemeDeltaDimension C s ≤ (m : EInt) := by
  simpa using schemeDeltaDimension_le_of_forall_relativeDimension_le C s (𝟙 _) (by simpa using h)

/-- **A point of `Z ×_X Y` over an open `V ⊆ Y` comes from `Z ×_X V`.** -/
theorem mem_range_bivariantBaseChangeMap_ι {Z X Y : Scheme.{u}} (i : Z ⟶ X) (g : Y ⟶ X)
    (V : Y.Opens) {w : (pullback i g : Scheme.{u})} (hw : pullback.snd i g w ∈ V) :
    w ∈ Set.range (bivariantBaseChangeMap i g V.ι).base := by
  have sq := isPullback_bivariantBaseChangeMap i g V.ι
  obtain ⟨p, hp⟩ : w ∈ Set.range (pullback.fst (pullback.snd i g) V.ι).base := by
    rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι]
    exact hw
  refine ⟨sq.flip.isoPullback.inv p, ?_⟩
  have h : (sq.flip.isoPullback.hom ≫ pullback.fst (pullback.snd i g) V.ι)
      (sq.flip.isoPullback.inv p) = w := by
    rw [Scheme.Hom.comp_apply, Scheme.inv_hom_apply, hp]
  rwa [sq.flip.isoPullback_hom_fst] at h

/-! ### The cap product with the fundamental class -/

section CapFundamental

variable (C : ChowSituation.{u}) (G : GysinSystem C) {Z X : Scheme.{u}} (sZ : Z ⟶ C.S)
  [LocallyOfFiniteType sZ] (sX : X ⟶ C.S) [LocallyOfFiniteType sX] (i : Z ⟶ X)
  [IsClosedImmersion i] [LocallyOfFiniteType i] (hi : i ≫ sX = sZ) (r : ℕ)

/-- **The formula `c ∩ [V]_n = [Z ×_X V]_{n - r}` over regular base changes.** A bivariant class
`c ∈ A^r(Z ⟶ X)` satisfies the formula in degree `n` when, for every `g : V ⟶ X` locally of
finite type such that

* every irreducible component of `V` has `δ`-dimension `n`,
* `dim_δ(Z ×_X V) ≤ n - r`, and
* `Z ×_X V ⟶ V` is a regular closed immersion of codimension `r`,

the cap product of `c` with the fundamental class of `V` is the fundamental class of
`Z ×_X V`.

For the class `c(Z ⟶ X, 𝒩)` of a virtual normal sheaf of constant rank `r` (Stacks 0FBK) this is
**the excess intersection formula of Stacks 0FBM at vanishing excess**: when `Z ×_X V ⟶ V` is
regular of codimension `r` the conormal sheaf has rank `r`, so the excess normal sheaf `ℰ` is
zero and `c_top(ℰ) ∩ [Z ×_X V]_{n-r} = [Z ×_X V]_{n-r}`. The bound on `dim_δ(Z ×_X V)` is a
consequence of the other two hypotheses in the source; it is recorded because it is the form in
which `Stacks.Chow.virtualNormalBundleClass_cap_fundamentalChowClass` consumes it. -/
def BivariantClass.CapRegularFormula (c : BivariantClass C G sZ sX i hi (r : ℤ)) (n : ℤ) :
    Prop :=
  ∀ ⦃V : Scheme.{u}⦄ (gV : V ⟶ X) [LocallyOfFiniteType gV],
    (∀ T : irreducibleComponents V,
      deltaDimension C (gV ≫ sX)
        ⟨T, T.2.1, isClosed_of_mem_irreducibleComponents (T : Set V) T.2⟩ = n) →
    schemeDeltaDimension C (pullback.fst i gV ≫ sZ) ≤ ((n - r : ℤ) : EInt) →
    Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularClosedImmersionOfCodim
      (pullback.snd i gV) r →
    c.cap gV n (fundamentalChowClass C (gV ≫ sX) n) =
      fundamentalChowClass C (pullback.fst i gV ≫ sZ) (n - r)

/-- **Stacks 0FEA, from local generators.** Let `c ∈ A^r(Z ⟶ X)` satisfy the formula
`Stacks.Chow.BivariantClass.CapRegularFormula` in degree `n`, and let `g : Y ⟶ X` be locally of
finite type with

* every irreducible component of `Y` of `δ`-dimension `n` (hypothesis (2)),
* `dim_δ(Z ×_X Y) ≤ n - r` (hypothesis (3)),
* `𝒪_{Y, ξ}` Cohen–Macaulay for `ξ ∈ Z ×_X Y` with `δ(ξ) = n - r` (hypothesis (4)), and
* the ideal of `Z ×_X Y` in `𝒪_{Y, ξ}` generated by `r` elements at those points, which is what
  hypothesis (1) provides.

Then `c ∩ [Y]_n = [Z ×_X Y]_{n - r}` in `CH_{n - r}(Z ×_X Y)`.

This is the source's proof. `CH_{n-r}(Z ×_X Y)` is the group of `(n-r)`-cycles, so it suffices to
compare the two classes near each point `ξ` of `δ`-dimension `n - r`
(`Stacks.Chow.eq_of_forall_chowGroupRestrict_eq`); at `ξ` the generators form a regular sequence
(`Stacks.Chow.isRegular_of_isCohenMacaulayLocalRing_stalk`, Stacks 02JN), which cuts out
`Z ×_X Y` over a neighbourhood `V` of `ξ` (Stacks 063I); restriction to `V` commutes with `c`
(Stacks 0B76) and carries fundamental classes to fundamental classes, and over `V` the formula
holds. -/
theorem BivariantClass.cap_fundamentalChowClass_eq_of_generators
    (c : BivariantClass C G sZ sX i hi (r : ℤ)) {n : ℤ}
    (hc : c.CapRegularFormula C G sZ sX i hi r n)
    {Y : Scheme.{u}} (g : Y ⟶ X) [LocallyOfFiniteType g]
    (hY : ∀ W : irreducibleComponents Y,
      deltaDimension C (g ≫ sX)
        ⟨W, W.2.1, isClosed_of_mem_irreducibleComponents (W : Set Y) W.2⟩ = n)
    (hZY : schemeDeltaDimension C (pullback.snd i g ≫ (g ≫ sX)) ≤ ((n - r : ℤ) : EInt))
    (hCM : ∀ ξ : (pullback i g : Scheme.{u}),
      relativeDimension C.dimensionFunction (g ≫ sX) ((pullback.snd i g).base ξ) = n - r →
      letI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (g ≫ sX)
      IsCohenMacaulayLocalRing (Y.presheaf.stalk ((pullback.snd i g).base ξ)))
    (hgen : ∀ ξ : (pullback i g : Scheme.{u}),
      relativeDimension C.dimensionFunction (g ≫ sX) ((pullback.snd i g).base ξ) = n - r →
      ∃ xs : List (Y.presheaf.stalk ((pullback.snd i g).base ξ)), xs.length = r ∧
        Ideal.ofList xs = RingHom.ker ((pullback.snd i g).stalkMap ξ).hom) :
    c.cap g n (fundamentalChowClass C (g ≫ sX) n) =
      fundamentalChowClass C (pullback.fst i g ≫ sZ) (n - r) := by
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (g ≫ sX)
  have hrelW : ∀ w : (pullback i g : Scheme.{u}),
      relativeDimension C.dimensionFunction (pullback.fst i g ≫ sZ) w =
        relativeDimension C.dimensionFunction (g ≫ sX) ((pullback.snd i g).base w) := fun w => by
    rw [← hi, pullback.condition_assoc, relativeDimension_comp_closedImmersion]
  have hdimW : ∀ w : (pullback i g : Scheme.{u}),
      relativeDimension C.dimensionFunction (pullback.fst i g ≫ sZ) w ≤ n - r := fun w => by
    rw [hrelW]
    exact relativeDimension_le_of_schemeDeltaDimension_le C (g ≫ sX) (pullback.snd i g) hZY w
  have hdimY : schemeDeltaDimension C (g ≫ sX) ≤ (n : EInt) :=
    schemeDeltaDimension_le_of_relativeDimension_le C (g ≫ sX)
      (by simpa using relativeDimension_le_of_forall_genericPoint C (g ≫ sX) fun W => hY W)
  refine eq_of_forall_chowGroupRestrict_eq C (pullback.fst i g ≫ sZ) (n - r) hdimW
    fun w hw => ?_
  have hξ : relativeDimension C.dimensionFunction (g ≫ sX) ((pullback.snd i g).base w) =
      n - r := (hrelW w).symm.trans hw
  obtain ⟨xs, hlen, hxs⟩ := hgen w hξ
  obtain ⟨V, hwV, hV⟩ :=
    exists_isRegularClosedImmersionOfCodim_of_isRegular_stalk (pullback.snd i g) w xs hlen hxs
      (isRegular_of_isCohenMacaulayLocalRing_stalk C sX i g hY hZY w hξ (hCM w hξ) xs hlen hxs)
  -- the base change of `Z ×_X Y ⟶ Y` to the open `V`
  have sq : IsPullback (pullback.snd i (V.ι ≫ g)) (bivariantBaseChangeMap i g V.ι) V.ι
      (pullback.snd i g) := isPullback_bivariantBaseChangeMap i g V.ι
  have : IsOpenImmersion (bivariantBaseChangeMap i g V.ι) :=
    MorphismProperty.of_isPullback sq inferInstance
  have hbase : bivariantBaseChangeMap i g V.ι ≫ (pullback.fst i g ≫ sZ) =
      pullback.fst i (V.ι ≫ g) ≫ sZ := by
    rw [← Category.assoc, bivariantBaseChangeMap_fst]
  refine ⟨pullback i (V.ι ≫ g), pullback.fst i (V.ι ≫ g) ≫ sZ, inferInstance,
    bivariantBaseChangeMap i g V.ι, inferInstance, hbase, ?_, ?_⟩
  · -- `ξ` lies over `V`
    exact mem_range_bivariantBaseChangeMap_ι i g V hwV
  · -- over `V` both sides restrict to the fundamental class of `Z ×_X V`
    have hvY : V.ι ≫ (g ≫ sX) = (V.ι ≫ g) ≫ sX := (Category.assoc _ _ _).symm
    rw [BivariantClass.cap_chowGroupRestrict C G sZ sX i hi (r : ℤ) c g V.ι (V.ι ≫ g) rfl
        (bivariantBaseChangeMap i g V.ι) sq (bivariantBaseChangeMap_fst i g V.ι) n hvY hbase,
      chowGroupRestrict_fundamentalChowClass C (g ≫ sX) ((V.ι ≫ g) ≫ sX) V.ι hvY n hdimY,
      chowGroupRestrict_fundamentalChowClass C (pullback.fst i g ≫ sZ) _
        (bivariantBaseChangeMap i g V.ι) hbase (n - r)
        (schemeDeltaDimension_le_of_relativeDimension_le C _ hdimW)]
    refine hc (V.ι ≫ g) (fun T => ?_) ?_ (hV _ _ sq)
    · simpa only [Category.assoc] using deltaDimension_irreducibleComponents_opens C (g ≫ sX) hY V T
    · refine schemeDeltaDimension_le_of_relativeDimension_le C _ fun u => ?_
      rw [← hbase, relativeDimension_comp_isOpenImmersion]
      exact hdimW _

/-- **Equations for `Z ×_X Y` in `Y` from equations for `Z` in `X`.** If the kernel of
`𝒪_{X, i z} ⟶ 𝒪_{Z, z}` is generated by `r` elements, so is the kernel of
`𝒪_{Y, y} ⟶ 𝒪_{Z ×_X Y, ξ}` at every point `ξ` of `Z ×_X Y` over `z` and `y`: the latter is the
extension of the former along `𝒪_{X, i z} ⟶ 𝒪_{Y, y}`. -/
theorem exists_ofList_eq_ker_stalkMap_pullback_snd {Z X Y : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] (g : Y ⟶ X) (ξ : (pullback i g : Scheme.{u})) {r : ℕ}
    (h : ∃ xs : List (X.presheaf.stalk (i (pullback.fst i g ξ))), xs.length = r ∧
      Ideal.ofList xs = RingHom.ker (i.stalkMap (pullback.fst i g ξ)).hom) :
    ∃ ys : List (Y.presheaf.stalk (pullback.snd i g ξ)), ys.length = r ∧
      Ideal.ofList ys = RingHom.ker ((pullback.snd i g).stalkMap ξ).hom := by
  obtain ⟨xs, hlen, hxs⟩ := h
  have hpt : i (pullback.fst i g ξ) = g (pullback.snd i g ξ) := by
    rw [← Scheme.Hom.comp_apply, pullback.condition, Scheme.Hom.comp_apply]
  rw [Stacks.Flatness.ker_stalkMap_of_isPullback (IsPullback.of_hasPullback i g).flip ξ hpt,
    ← hxs, Ideal.map_ofList]
  exact ⟨_, by rw [List.length_map, hlen], rfl⟩

/-- **Stacks 0FEA, for a bivariant class satisfying the formula over regular base changes.** Let
`(S, δ)` be as in Stacks 02QL, let `i : Z ⟶ X` be a closed immersion of schemes locally of finite
type over `S` with a virtual normal sheaf `𝒩` (Stacks 0FBQ), and let `g : Y ⟶ X` be locally of
finite type. Given integers `r` and `n`, assume

1. `𝒩` is locally free of rank `r`,
2. every irreducible component of `Y` has `δ`-dimension `n`,
3. `dim_δ(Z ×_X Y) ≤ n - r`, and
4. `𝒪_{Y, ξ}` is Cohen–Macaulay for every `ξ ∈ Z ×_X Y` with `δ(ξ) = n - r`.

Then every `c ∈ A^r(Z ⟶ X)` satisfying `Stacks.Chow.BivariantClass.CapRegularFormula` in degree
`n` — for the class `c(Z ⟶ X, 𝒩)` of Stacks 0FBK this is the excess intersection formula of
Stacks 0FBM at vanishing excess (`Stacks.Chow.virtualNormalGysinClass_capRegularFormula`) — has
`c ∩ [Y]_n = [Z ×_X Y]_{n - r}` in `CH_{n - r}(Z ×_X Y)`. For `c(Z ⟶ X, 𝒩)` itself this is
`Stacks.Chow.virtualNormalGysinClass_cap_fundamentalChowClass_of_isCohenMacaulayLocalRing`.

Hypothesis (1) enters as the source says: the surjection `𝒩^∨ ⟶ 𝒞_{Z/X}` makes the ideal of `Z`
locally cut out by `r` equations
(`Stacks.Chow.VirtualNormalBundle.exists_ofList_eq_ker_stalkMap`), hence so is the ideal of
`Z ×_X Y` in `Y`; the rest is
`Stacks.Chow.BivariantClass.cap_fundamentalChowClass_eq_of_generators`. -/
theorem BivariantClass.cap_fundamentalChowClass_eq_of_capRegularFormula
    (N : VirtualNormalBundle i)
    (hN : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} N.bundle r)
    (c : BivariantClass C G sZ sX i hi (r : ℤ)) {n : ℤ}
    (hc : c.CapRegularFormula C G sZ sX i hi r n)
    {Y : Scheme.{u}} (g : Y ⟶ X) [LocallyOfFiniteType g]
    (hY : ∀ W : irreducibleComponents Y,
      deltaDimension C (g ≫ sX)
        ⟨W, W.2.1, isClosed_of_mem_irreducibleComponents (W : Set Y) W.2⟩ = n)
    (hZY : schemeDeltaDimension C (pullback.snd i g ≫ (g ≫ sX)) ≤ ((n - r : ℤ) : EInt))
    (hCM : ∀ ξ : (pullback i g : Scheme.{u}),
      relativeDimension C.dimensionFunction (g ≫ sX) ((pullback.snd i g).base ξ) = n - r →
      letI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (g ≫ sX)
      IsCohenMacaulayLocalRing (Y.presheaf.stalk ((pullback.snd i g).base ξ))) :
    c.cap g n (fundamentalChowClass C (g ≫ sX) n) =
      fundamentalChowClass C (pullback.fst i g ≫ sZ) (n - r) := by
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  exact c.cap_fundamentalChowClass_eq_of_generators C G sZ sX i hi r hc g hY hZY hCM
    fun ξ _ => exists_ofList_eq_ker_stalkMap_pullback_snd i g ξ
      (N.exists_ofList_eq_ker_stalkMap i hN (pullback.fst i g ξ))

end CapFundamental

/-! ### The conclusion of Stacks 0FEA as a property of a class -/

section CapCohenMacaulay

variable (C : ChowSituation.{u}) (G : GysinSystem C) {Z X : Scheme.{u}} (sZ : Z ⟶ C.S)
  [LocallyOfFiniteType sZ] (sX : X ⟶ C.S) [LocallyOfFiniteType sX] (i : Z ⟶ X)
  [LocallyOfFiniteType i] (hi : i ≫ sX = sZ) (r : ℕ)

/-- **The formula `c ∩ [Y]_n = [Z ×_X Y]_{n - r}` over Cohen–Macaulay base changes.** A bivariant
class `c ∈ A^r(Z ⟶ X)` satisfies the formula in degree `n` when, for every `g : Y ⟶ X` locally of
finite type such that

* every irreducible component of `Y` has `δ`-dimension `n` (hypothesis (2) of Stacks 0FEA),
* `dim_δ(Z ×_X Y) ≤ n - r` (hypothesis (3)), and
* `𝒪_{Y, ξ}` is Cohen–Macaulay at every `ξ ∈ Z ×_X Y` with `δ(ξ) = n - r` (hypothesis (4)),

the cap product of `c` with the fundamental class of `Y` is the fundamental class of `Z ×_X Y`.
This is the conclusion of Stacks 0FEA, recorded as a property of the class; unlike
`Stacks.Chow.BivariantClass.CapRegularFormula` it does not require `Z ⟶ X` to be a closed
immersion, so that it applies to the Gysin class of the diagonal of a smooth morphism which is not
separated. For a closed immersion with a virtual normal sheaf of rank `r`, it follows from
`Stacks.Chow.BivariantClass.CapRegularFormula` by Stacks 0FEA
(`Stacks.Chow.BivariantClass.capCohenMacaulayFormula_of_capRegularFormula`). -/
def BivariantClass.CapCohenMacaulayFormula (c : BivariantClass C G sZ sX i hi (r : ℤ))
    (n : ℤ) : Prop :=
  ∀ ⦃Y : Scheme.{u}⦄ (g : Y ⟶ X) [LocallyOfFiniteType g],
    (∀ W : irreducibleComponents Y,
      deltaDimension C (g ≫ sX)
        ⟨W, W.2.1, isClosed_of_mem_irreducibleComponents (W : Set Y) W.2⟩ = n) →
    schemeDeltaDimension C (pullback.snd i g ≫ (g ≫ sX)) ≤ ((n - r : ℤ) : EInt) →
    (∀ ξ : (pullback i g : Scheme.{u}),
      relativeDimension C.dimensionFunction (g ≫ sX) ((pullback.snd i g).base ξ) = n - r →
      letI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (g ≫ sX)
      IsCohenMacaulayLocalRing (Y.presheaf.stalk ((pullback.snd i g).base ξ))) →
    c.cap g n (fundamentalChowClass C (g ≫ sX) n) =
      fundamentalChowClass C (pullback.fst i g ≫ sZ) (n - r)

/-- **Stacks 0FEA as a property of the class.** For a closed immersion `i` with a virtual normal
sheaf locally free of rank `r`, a class satisfying the formula over regular base changes
(`Stacks.Chow.BivariantClass.CapRegularFormula`) satisfies it over Cohen–Macaulay base changes. -/
theorem BivariantClass.capCohenMacaulayFormula_of_capRegularFormula [IsClosedImmersion i]
    (N : VirtualNormalBundle i)
    (hN : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} N.bundle r)
    (c : BivariantClass C G sZ sX i hi (r : ℤ)) {n : ℤ}
    (hc : c.CapRegularFormula C G sZ sX i hi r n) :
    c.CapCohenMacaulayFormula C G sZ sX i hi r n :=
  fun _ g _ hY hZY hCM =>
    c.cap_fundamentalChowClass_eq_of_capRegularFormula C G sZ sX i hi r N hN hc g hY hZY hCM

end CapCohenMacaulay

end Stacks.Chow

