module

public import StacksFrontier.AlgebraicGeometry.Chow.Intersection.DiagonalGysinCapRegular

/-!
# Stacks 0FEA: the class of a virtual normal sheaf on a Cohen–Macaulay fundamental class

Let `(S, δ)` be the base situation of chapter 42 of the Stacks Project, let `i : Z ⟶ X` be a closed
immersion of schemes locally of finite type over `S` with a virtual normal sheaf `𝒩` of constant
rank `r`, and let `g : Y ⟶ X` be locally of finite type. **Stacks 0FEA**: if every irreducible
component of `Y` has `δ`-dimension `n`, `dim_δ(Z ×_X Y) ≤ n - r`, and `𝒪_{Y, ξ}` is Cohen–Macaulay
at the points `ξ ∈ Z ×_X Y` of `δ`-dimension `n - r`, then

  `c(Z ⟶ X, 𝒩) ∩ [Y]_n = [Z ×_X Y]_{n - r}`.

The proof is `Stacks.Chow.BivariantClass.cap_fundamentalChowClass_eq_of_capRegularFormula`
(the regular sequence of the source's proof, in
`StacksFrontier.AlgebraicGeometry.Chow.BivariantLemmas.VirtualNormalCapFundamental`) applied to the
formula `Stacks.Chow.virtualNormalGysinClass_capRegularFormula`, which is Stacks 0FBM at
vanishing excess.

## Main results

* `Stacks.Chow.virtualNormalGysinClass_cap_fundamentalChowClass_of_isCohenMacaulayLocalRing` —
  **Stacks 0FEA**.
* `Stacks.Chow.virtualNormalGysinClass_capCohenMacaulayFormula` — the same, as a property of the
  class.

## References

* [Stacks Project, Tag 0FEA](https://stacks.math.columbia.edu/tag/0FEA)
* [Stacks Project, Tag 0FBM](https://stacks.math.columbia.edu/tag/0FBM)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace Stacks.Chow

section VirtualNormalGysinClass

variable (C : ChowSituation.{u}) {Z X : Scheme.{u}} (sZ : Z ⟶ C.S) [LocallyOfFiniteType sZ]
  (sX : X ⟶ C.S) [LocallyOfFiniteType sX] (i : Z ⟶ X) [IsClosedImmersion i]
  (hi : i ≫ sX = sZ) (𝒩 : VirtualNormalBundle i) (r : ℕ)
  [SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} 𝒩.bundle r]

/-- **Stacks 0FEA.** Let `(S, δ)` be as in Stacks 02QL, let `X` be locally of finite type over
`S`, let `𝒩` be a virtual normal sheaf for a closed subscheme `i : Z ⟶ X` (Stacks 0FBQ), and let
`g : Y ⟶ X` be locally of finite type. Given integers `r` and `n`, assume

1. `𝒩` is locally free of rank `r`,
2. every irreducible component of `Y` has `δ`-dimension `n`,
3. `dim_δ(Z ×_X Y) ≤ n - r`, and
4. `𝒪_{Y, ξ}` is Cohen–Macaulay for every `ξ ∈ Z ×_X Y` with `δ(ξ) = n - r`.

Then `c(Z ⟶ X, 𝒩) ∩ [Y]_n = [Z ×_X Y]_{n - r}` in `CH_{n - r}(Z ×_X Y)`.

The proof is the source's: at the points of `Z ×_X Y` of `δ`-dimension `n - r` the ideal of
`Z ×_X Y` is generated by a regular sequence of length `r`, so `Z ×_X Y ⟶ Y` is a regular closed
immersion of codimension `r` near them, where the excess normal sheaf vanishes and Stacks 0FBM
(`Stacks.Chow.virtualNormalGysinClass_capRegularFormula`) applies; this is
`Stacks.Chow.BivariantClass.cap_fundamentalChowClass_eq_of_capRegularFormula`. -/
@[stacks 0FEA]
theorem virtualNormalGysinClass_cap_fundamentalChowClass_of_isCohenMacaulayLocalRing
    [LocallyOfFiniteType i] {n : ℤ} {Y : Scheme.{u}} (g : Y ⟶ X) [LocallyOfFiniteType g]
    (hY : ∀ W : irreducibleComponents Y,
      deltaDimension C (g ≫ sX)
        ⟨W, W.2.1, isClosed_of_mem_irreducibleComponents (W : Set Y) W.2⟩ = n)
    (hZY : schemeDeltaDimension C (pullback.snd i g ≫ (g ≫ sX)) ≤ ((n - r : ℤ) : EInt))
    (hCM : ∀ ξ : (pullback i g : Scheme.{u}),
      relativeDimension C.dimensionFunction (g ≫ sX) ((pullback.snd i g).base ξ) = n - r →
      letI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (g ≫ sX)
      IsCohenMacaulayLocalRing (Y.presheaf.stalk ((pullback.snd i g).base ξ))) :
    (virtualNormalBundleClass C sZ sX i hi 𝒩 r).cap g n (fundamentalChowClass C (g ≫ sX) n) =
      fundamentalChowClass C (pullback.fst i g ≫ sZ) (n - r) :=
  (virtualNormalBundleClass C sZ sX i hi 𝒩 r).cap_fundamentalChowClass_eq_of_capRegularFormula C
    (gysinSystemOfInvertible C) sZ sX i hi r 𝒩 inferInstance
    (virtualNormalGysinClass_capRegularFormula C sZ sX i hi 𝒩 r n) g hY hZY hCM

/-- **Stacks 0FEA as a property of the class `c(Z ⟶ X, 𝒩)`.** The class of a virtual normal sheaf
of constant rank `r` satisfies `Stacks.Chow.BivariantClass.CapCohenMacaulayFormula` in every
degree `n`. -/
theorem virtualNormalGysinClass_capCohenMacaulayFormula (n : ℤ) :
    (virtualNormalBundleClass C sZ sX i hi 𝒩 r).CapCohenMacaulayFormula C
      (gysinSystemOfInvertible C) sZ sX i hi r n :=
  (virtualNormalBundleClass C sZ sX i hi 𝒩 r).capCohenMacaulayFormula_of_capRegularFormula C
    (gysinSystemOfInvertible C) sZ sX i hi r 𝒩 inferInstance
    (virtualNormalGysinClass_capRegularFormula C sZ sX i hi 𝒩 r n)

end VirtualNormalGysinClass

end Stacks.Chow

end
