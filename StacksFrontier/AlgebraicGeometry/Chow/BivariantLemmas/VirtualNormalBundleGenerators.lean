/-!
# A virtual normal bundle of rank `r` cuts out its subscheme by `r` equations

Let `i : Z ⟶ X` be an immersion of schemes with `X` locally Noetherian and let `𝒩` be a virtual
normal bundle for `i` in the sense of Stacks 0FBQ, finite locally free of constant rank `r`. Then
at every point `z ∈ Z` the kernel of the map of local rings `𝒪_{X, i z} ⟶ 𝒪_{Z, z}` is generated
by `r` elements.

This is the step "since `𝒩` has rank `r` and since `𝒩^∨ ⟶ 𝒞_{Z/X}` is surjective, we see that the
ideal sheaf of `Z` is locally cut out by `r` equations" of the proof of Stacks 0FEA. On stalks:
the stalk of `𝒩^∨` is free of rank `r` over `𝒪_{Z, z}` and surjects onto the stalk of the
conormal sheaf, which is `𝒪_{Z, z} ⊗ J` for `J` the kernel; so the conormal module `J/J²` is
generated by `r` elements, and by Nakayama's lemma so is `J`.

## Main results

* `Stacks.Chow.spanFinrank_ker_le_of_surjective_tensor` — for a surjection of local rings
  `A ⟶ B` with kernel `J`, `A` Noetherian, a surjection `B^r ⟶ B ⊗_A J` forces `J` to be generated
  by `r` elements.
* `Ideal.exists_ofList_eq_of_spanFinrank_le` — a finitely generated ideal needing at most `r`
  generators is generated by a list of exactly `r` elements.
* `Stacks.Chow.VirtualNormalBundle.exists_ofList_eq_ker_stalkMap` — the kernel of
  `𝒪_{X, i z} ⟶ 𝒪_{Z, z}` is generated by a list of `r` elements.

## Implementation notes

The conormal sheaf is computed through the closed factor `i.liftCoborder` of the immersion, the
canonical open `i.coborderRange` being where `𝒞_{Z/X}` is defined; its stalk is the base change of
the stalk of the sectionwise defining ideal sheaf
(`RingedSpaceModuleAdjunction.exists_modulePullbackStalkLinearEquiv`), and that stalk is the
kernel of the map of local rings (`Stacks.ConormalSequenceRight.definingIdealStalkEquiv`). The
target of the surjection of the virtual normal bundle is the pullback of the categorical kernel,
which is identified with the pullback of the sectionwise one by
`Stacks.ConormalSequenceUnramifiedPair.conormalSheafComparisonIso`. Finally the kernel for
`i.liftCoborder` is moved to the kernel for `i` along the isomorphism of local rings induced by
the open immersion `i.coborderRange ⟶ X`.

## References

* [Stacks Project, Tag 0FEA](https://stacks.math.columbia.edu/tag/0FEA)
* [Stacks Project, Tag 0FBQ](https://stacks.math.columbia.edu/tag/0FBQ)
* [Stacks Project, Tag 01R2](https://stacks.math.columbia.edu/tag/01R2)
* [Stacks Project, Tag 00DV](https://stacks.math.columbia.edu/tag/00DV)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace
open scoped TensorProduct

universe u

/-- **A finitely generated ideal needing at most `r` generators is generated by `r` elements**,
listed: pad a minimal generating set with zeros. -/
theorem Ideal.exists_ofList_eq_of_spanFinrank_le {A : Type*} [CommRing A] {I : Ideal A}
    (hI : I.FG) {r : ℕ} (h : I.spanFinrank ≤ r) :
    ∃ xs : List A, xs.length = r ∧ Ideal.ofList xs = I := by
  classical
  obtain ⟨u, hcard, hspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank hI
  refine ⟨u.toList ++ List.replicate (r - u.card) 0, ?_, ?_⟩
  · simp only [List.length_append, Finset.length_toList, List.length_replicate]
    omega
  · apply le_antisymm
    · rw [Ideal.ofList, Ideal.span_le]
      intro x hx
      simp only [Set.mem_ofPred_eq, List.mem_append, Finset.mem_toList, List.mem_replicate] at hx
      rcases hx with hx | ⟨-, rfl⟩
      · rw [← hspan]
        exact Submodule.subset_span hx
      · exact zero_mem I
    · rw [← hspan, Ideal.ofList]
      exact Submodule.span_mono fun x hx => by simp_all

namespace Stacks.Chow

/-- **Generators of a kernel from a surjection onto its base change.** Let `A ⟶ B` be a
surjection of commutative rings with kernel `J`, `A` local and Noetherian and `B` nonzero. If
`B ⊗_A J` is the image of a `B`-linear map from `B^r`, then `J` is generated by `r` elements.

`B ⊗_A J` is the conormal module `J/J²`, and over a Noetherian local ring a proper ideal and its
conormal module need the same number of generators
(`Ideal.spanFinrank_top_cotangent_eq_spanFinrank`, Nakayama's lemma). -/
theorem spanFinrank_ker_le_of_surjective_tensor {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B] [IsLocalRing A] [IsNoetherianRing A] [Nontrivial B]
    (hB : Function.Surjective (algebraMap A B)) (r : ℕ)
    (q : (Fin r →₀ B) →ₗ[B] B ⊗[A] RingHom.ker (algebraMap A B)) (hq : Function.Surjective q) :
    (RingHom.ker (algebraMap A B)).spanFinrank ≤ r := by
  have hqrank := Submodule.spanFinrank_map_le_of_fg q Module.Finite.fg_top
  rw [Submodule.map_top, LinearMap.range_eq_top.mpr hq,
    ← Module.finrank_eq_spanFinrank_of_free (R := B) (M := Fin r →₀ B),
    Module.finrank_finsupp_self, Fintype.card_fin] at hqrank
  set I := RingHom.ker (algebraMap A B)
  rw [← Ideal.spanFinrank_top_cotangent_eq_spanFinrank I (RingHom.ker_ne_top _)]
  let e : (A ⧸ I) ≃ₐ[A] B :=
    Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId A B) hB
  let t : (B ⊗[A] I) ≃ₗ[A] I.Cotangent :=
    (TensorProduct.congr e.symm.toLinearEquiv (LinearEquiv.refl A I)).trans
      (TensorProduct.quotTensorEquivQuotSMul I I)
  have hrestrict : (⊤ : Submodule A (B ⊗[A] I)).spanFinrank =
      (⊤ : Submodule B (B ⊗[A] I)).spanFinrank :=
    congrArg Cardinal.toNat (Submodule.spanRank_restrictScalars_eq (R := A) hB ⊤)
  have ht : (⊤ : Submodule A I.Cotangent).spanFinrank =
      (⊤ : Submodule A (B ⊗[A] I)).spanFinrank := by
    simpa only [Submodule.map_top, LinearMap.range_eq_top.mpr t.surjective] using
      (Submodule.spanFinrank_map_eq_of_injective t.toLinearMap t.injective (p := ⊤))
  have hquot : (⊤ : Submodule A I.Cotangent).spanFinrank =
      (⊤ : Submodule (A ⧸ I) I.Cotangent).spanFinrank :=
    congrArg Cardinal.toNat (Submodule.spanRank_restrictScalars_eq (R := A)
      Ideal.Quotient.mk_surjective ⊤)
  rwa [← hquot, ht, hrestrict]

/-- **The stalks of a finite locally free module of rank `r` are free of rank `r`.** -/
theorem nonempty_basis_stalk_of_isFiniteLocallyFreeOfRank {Z : Scheme.{u}} (E : Z.Modules)
    {r : ℕ} (hE : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (R := Z.ringCatSheaf) E r)
    (z : Z) :
    letI : Module (Z.presheaf.stalk z) (E.presheaf.stalk z) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
        (R := Z.presheaf) E.val z
    Nonempty (Module.Basis (Fin r) (Z.presheaf.stalk z) (E.presheaf.stalk z)) := by
  let : Module (Z.presheaf.stalk z) (E.presheaf.stalk z) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := Z.presheaf) E.val z
  obtain ⟨q, hq, hr⟩ := hE.exists_isFiniteLocallyFreeOfRankData
  have hflf : Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := Z.ringCatSheaf) E :=
    { exists_isFiniteLocallyFreeData :=
        ⟨q, hq, { isFiniteType := fun k => ⟨Finite.of_equiv (Fin r) (hr k).some.symm⟩ }⟩ }
  obtain ⟨hft, hfree, -⟩ :=
    @Scheme.Modules.isFiniteType_and_free_stalks_and_isLocallyConstant_fiberRank Z E hflf
  have : Module.Free (Z.presheaf.stalk z) (E.presheaf.stalk z) := hfree z
  have : _root_.SheafOfModules.IsFiniteType.{u, u, u} E := hft
  have : Module.Finite (Z.presheaf.stalk z) (E.presheaf.stalk z) :=
    _root_.SheafOfModules.finite_stalk Z.sheaf E z
  exact ⟨Module.finBasisOfFinrankEq _ _
    ((@Scheme.Modules.fiberRank_eq_finrank_stalk Z E z hft (hfree z)).symm.trans
      (@Scheme.Modules.fiberRank_eq_rank_of_isFiniteLocallyFreeOfRank Z E r hE z))⟩

/-- **The conormal stalk of a virtual normal bundle of rank `r` is generated by `r` elements.**
For a virtual normal bundle `𝒩` of rank `r` of an immersion `i : Z ⟶ X` with `X` locally
Noetherian, the kernel of the map of local rings of the closed factor `i.liftCoborder` at `z` is
generated by `r` elements.

The stalk of `𝒩^∨` is free of rank `r` and surjects onto the stalk of the conormal sheaf, which
is `𝒪_{Z, z} ⊗ J` for that kernel `J`; conclude by
`Stacks.Chow.spanFinrank_ker_le_of_surjective_tensor`. -/
theorem VirtualNormalBundle.spanFinrank_ker_stalkMap_liftCoborder_le {Z X : Scheme.{u}}
    [IsLocallyNoetherian X] (i : Z ⟶ X) [IsImmersion i] (N : VirtualNormalBundle i) {r : ℕ}
    (hN : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} N.bundle r) (z : Z) :
    (RingHom.ker (i.liftCoborder.stalkMap z).hom).spanFinrank ≤ r := by
  -- the stalk of `𝒩^∨` is free of rank `r`
  let E := Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf N.bundle
  let : Module (Z.presheaf.stalk z) (E.presheaf.stalk z) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := Z.presheaf) E.val z
  obtain ⟨bE⟩ := nonempty_basis_stalk_of_isFiniteLocallyFreeOfRank E
    (@Stacks.AlgebraicGeometry.ReflexiveModules.isFiniteLocallyFreeOfRank_dualSheaf Z N.bundle r hN)
    z
  -- the surjection onto the sectionwise conormal sheaf
  let φ := N.surjection ≫ (Stacks.ConormalSequenceUnramifiedPair.conormalSheafComparisonIso i).inv
  have : Epi φ := @epi_comp _ _ _ _ _ _ N.epi _
    (@IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_inv _))
  let σ := RingedSpaceModuleAdjunction.moduleStalkMap Z.presheaf φ.val z
  have hσ : Function.Surjective σ :=
    @Stacks.SheafOfModules.StalkEpiMono.stalk_surjective_of_epi _ _ _ _ φ
      ⟨fun g₁ g₂ h => this.left_cancellation g₁ g₂ h⟩ z
  -- the stalk of the conormal sheaf
  let : Algebra (i.coborderRange.toScheme.presheaf.stalk (i.liftCoborder.base z))
      (Z.presheaf.stalk z) := (i.liftCoborder.stalkMap z).hom.toAlgebra
  obtain ⟨e₀, -⟩ := RingedSpaceModuleAdjunction.exists_modulePullbackStalkLinearEquiv
    i.liftCoborder.toLRSHom.toShHom
    (Stacks.AlgebraicGeometry.RegularIdealSheaf.definingIdeal i).toSheafOfModules z
  let : Module (i.coborderRange.toScheme.presheaf.stalk (i.liftCoborder.base z))
      (TopCat.Presheaf.stalk (C := Ab.{u}) (Stacks.ConormalSequenceRight.idealPresheaf
        (Stacks.AlgebraicGeometry.RegularIdealSheaf.definingIdealOfHom i.liftCoborder)).presheaf
        (i.liftCoborder.base z)) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := i.coborderRange.toScheme.presheaf) _ _
  let : Module (Z.presheaf.stalk z) (TopCat.Presheaf.stalk (C := Ab.{u})
      (Stacks.AlgebraicGeometry.RegularIdealSheaf.conormalSheaf i).val.presheaf z) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := Z.presheaf) _ _
  let dI := Stacks.ConormalSequenceRight.definingIdealStalkEquiv i.liftCoborder z
  let Q : (Fin r →₀ Z.presheaf.stalk z) →ₗ[Z.presheaf.stalk z]
      Z.presheaf.stalk z ⊗[i.coborderRange.toScheme.presheaf.stalk (i.liftCoborder.base z)]
        RingHom.ker (algebraMap (i.coborderRange.toScheme.presheaf.stalk (i.liftCoborder.base z))
          (Z.presheaf.stalk z)) :=
    (dI.toLinearMap.baseChange (Z.presheaf.stalk z)).comp
      (e₀.toLinearMap.comp (σ.comp bE.repr.symm.toLinearMap))
  have hQ : Function.Surjective Q :=
    (LinearMap.baseChange_surjective _ dI.surjective).comp
      (e₀.surjective.comp (hσ.comp bE.repr.symm.surjective))
  exact spanFinrank_ker_le_of_surjective_tensor (i.liftCoborder.stalkMap_surjective z) r Q hQ

/-- **A virtual normal bundle of rank `r` cuts out its subscheme by `r` equations.** For a
virtual normal bundle `𝒩` of constant rank `r` of an immersion `i : Z ⟶ X` with `X` locally
Noetherian, the kernel of `𝒪_{X, i z} ⟶ 𝒪_{Z, z}` is generated by a list of `r` elements at every
point `z` of `Z`.

This is the step of the proof of Stacks 0FEA that turns its hypothesis (1) into equations. -/
theorem VirtualNormalBundle.exists_ofList_eq_ker_stalkMap {Z X : Scheme.{u}}
    [IsLocallyNoetherian X] (i : Z ⟶ X) [IsImmersion i] (N : VirtualNormalBundle i) {r : ℕ}
    (hN : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} N.bundle r) (z : Z) :
    ∃ xs : List (X.presheaf.stalk (i z)), xs.length = r ∧
      Ideal.ofList xs = RingHom.ker (i.stalkMap z).hom := by
  -- generators for the closed factor `i.liftCoborder`
  obtain ⟨ys, hlen, hys⟩ := Ideal.exists_ofList_eq_of_spanFinrank_le
    (IsNoetherian.noetherian _) (N.spanFinrank_ker_stalkMap_liftCoborder_le i hN z)
  -- the open immersion `i.coborderRange ⟶ X` is an isomorphism on local rings
  let e := asIso (i.coborderRange.ι.stalkMap (i.liftCoborder.base z))
  have hcomp : ∀ f : Z ⟶ X, f = i.liftCoborder ≫ i.coborderRange.ι →
      ∃ xs : List (X.presheaf.stalk (f z)), xs.length = r ∧
        Ideal.ofList xs = RingHom.ker (f.stalkMap z).hom := by
    rintro f rfl
    refine ⟨ys.map e.inv.hom, by simpa using hlen, ?_⟩
    have h1 : RingHom.ker ((i.liftCoborder ≫ i.coborderRange.ι).stalkMap z).hom =
        Ideal.comap e.hom.hom (RingHom.ker (i.liftCoborder.stalkMap z).hom) := by
      rw [Scheme.Hom.stalkMap_comp, RingHom.comap_ker]
      rfl
    refine Eq.trans ?_ h1.symm
    refine (Ideal.map_ofList e.inv.hom ys).symm.trans ?_
    rw [hys]
    exact Ideal.map_symm e.commRingCatIsoToRingEquiv
  exact hcomp i i.liftCoborder_ι.symm

end Stacks.Chow

end
