module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.StalkEpiMono
public import StacksFrontier.AlgebraicGeometry.Chow.BivariantLemmas.VirtualNormalBundle
public import StacksFrontier.AlgebraicGeometry.Chow.GysinConstruction.ZeroScheme
public import StacksFrontier.AlgebraicGeometry.ClosedImmersionEuler.Basic
public import StacksFrontier.AlgebraicGeometry.Divisors.NormalSheaf
public import StacksFrontier.AlgebraicGeometry.Divisors.ZeroSchemeIdealSheaf
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.DualSectionsInfinitesimal
public import StacksFrontier.AlgebraicGeometry.ProjectiveBundleSplitting.KernelRank

/-!
# The virtual normal bundle of the zero scheme of a section of an invertible module

Let `L` be an invertible `𝒪_X`-module on a scheme `X`, let `s ∈ Γ(X, L)` be a global section and
let `i : D ⟶ X` be the closed immersion of its zero scheme `D = Z(s)` ([Stacks, Tag 02OQ]); this
is the triple `(L, s, i : D ⟶ X)` of [Stacks, Tag 02T8]. Evaluation at `s` is a map
`s^∨ : L^∨ ⟶ 𝒪_X` whose image is the ideal sheaf `ℐ_D`, so it factors as a surjection
`L^∨ ⟶ ℐ_D`. Pulling back along `i`, and using that the conormal sheaf of a closed immersion is
the restriction of its ideal sheaf, `𝒞_{D/X} = i^*ℐ_D` ([Stacks, Tag 0B3P]), gives the surjection

`(i^*L)^∨ = i^*(L^∨) ⟶ i^*ℐ_D = 𝒞_{D/X}`.

Since `i^*L` is invertible, hence finite locally free of rank one, this makes `i^*L` a virtual
normal bundle for `D` in `X` in the sense of [Stacks, Tag 0FBQ] (2); this is the virtual normal
bundle [Stacks, Tag 0FBN] attaches to the triple. No hypothesis on `s` is needed: `s` need not be
a regular section, and the map `L^∨ ⟶ ℐ_D` is then surjective but not injective.

## Main definitions

* `Stacks.Chow.zeroSchemeConormalSurjection`: the canonical map `(i^*L)^∨ ⟶ 𝒞_{D/X}`.
* `Stacks.Chow.zeroSchemeVirtualNormalBundle`: the virtual normal bundle `i^*L` of `D` in `X`.

## Main results

* `AlgebraicGeometry.epi_zeroSchemeIdealModuleHom`: evaluation at an arbitrary global section of an
  invertible module maps the dual onto the ideal sheaf of the zero scheme.
* `Stacks.Chow.epi_zeroSchemeConormalSurjection`: the canonical map onto the conormal sheaf is
  surjective.
* `Stacks.Chow.isFiniteLocallyFreeOfRank_zeroSchemeVirtualNormalBundle`: the virtual normal
  bundle has rank one.

## Implementation notes

The canonical map is the composite of three maps: the inverse of the dual base-change isomorphism
`i^*(L^∨) ≅ (i^*L)^∨` of a finite locally free module, the pullback along `i` of the factorization
`AlgebraicGeometry.zeroSchemeIdealModuleHom` of evaluation at `s` through the ideal sheaf, and the
inverse of the identification `Stacks.Divisors.conormalSheafIsoNegativeTwist` of the conormal
sheaf with the restricted ideal sheaf.

Surjectivity of `L^∨ ⟶ ℐ_D` is proved locally: on an affine open over which `L` has a rank-one
dual basis with coordinate `λ`, the ideal of `D` is generated by `c = λ(s)`, so a section `d c` of
the ideal is the image of `d λ`. The pullback functor is a left adjoint, so it preserves
epimorphisms.

## References

* [Stacks Project, Tag 0FBN](https://stacks.math.columbia.edu/tag/0FBN)
* [Stacks Project, Tag 0FBQ](https://stacks.math.columbia.edu/tag/0FBQ)
* [Stacks Project, Tag 0B3P](https://stacks.math.columbia.edu/tag/0B3P)
* [Stacks Project, Tag 02OQ](https://stacks.math.columbia.edu/tag/02OQ)
* [Stacks Project, Tag 02T8](https://stacks.math.columbia.edu/tag/02T8)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite
open Stacks.AlgebraicGeometry.ReflexiveModules

universe u

namespace AlgebraicGeometry

variable {X : Scheme.{u}} (L : X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
  (s : Γ(L, ⊤))

/-- **Evaluation at a global section of an invertible module maps the dual onto the ideal sheaf
of the zero scheme**, with no hypothesis on the section. On an affine open carrying a rank-one
dual basis of `L` the ideal of `Z(s)` is generated by the coordinate `c` of `s`
(`AlgebraicGeometry.zeroScheme_ideal_eq_span_evalAt`), and a section `d c` of the ideal sheaf
there is the image of `d` times the dual coordinate. -/
instance epi_zeroSchemeIdealModuleHom : Epi (zeroSchemeIdealModuleHom L s) := by
  refine Stacks.SheafOfModules.StalkEpiMono.epi_of_exists_sections _ fun U y x hx => ?_
  obtain ⟨⟨V, hV⟩, hxV, hVU, ⟨b⟩⟩ := exists_affineOpen_dualBasisOne_of_isInvertible L x hx
  refine ⟨V, hVU, hxV, ?_⟩
  have hmem : Stacks.Divisors.idealSheafSection (zeroScheme X L s)
      ((Stacks.Divisors.idealSheafOfModules (zeroScheme X L s)).val.resLE hVU y) ∈
        (zeroScheme X L s).ideal ⟨V, hV⟩ :=
    (Stacks.Divisors.mem_ideal_iff_exists_idealSheafSection _ ⟨V, hV⟩ _).2 ⟨_, rfl⟩
  obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.1
    ((zeroScheme_ideal_eq_span_evalAt L s ⟨V, hV⟩ b) ▸ hmem)
  refine ⟨d • (dualBasisCoord L b), Stacks.Divisors.idealSheafSection_injective _ ?_⟩
  refine (idealSheafSection_zeroSchemeIdealModuleHom L s V (d • (dualBasisCoord L b))).trans ?_
  refine Eq.trans ?_ hd.symm
  rw [evalAt_smul, smul_eq_mul, mul_comm]

end AlgebraicGeometry

namespace Stacks.Chow

variable {X : Scheme.{u}} (L : X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
  (s : Γ(L, ⊤))

/-- **The canonical map `(i^*L)^∨ ⟶ 𝒞_{D/X}` attached to the zero scheme `i : D ⟶ X` of `s`**
([Stacks, Tag 0FBN]). It is the composite
`(i^*L)^∨ ≅ i^*(L^∨) ⟶ i^*ℐ_D ≅ 𝒞_{D/X}` of the inverse of the dual base-change isomorphism,
the pullback of the factorization `L^∨ ⟶ ℐ_D` of evaluation at `s`, and the inverse of the
identification of the conormal sheaf of a closed immersion with its restricted ideal sheaf
([Stacks, Tag 0B3P]). -/
def zeroSchemeConormalSurjection :
    dualSheaf ((Scheme.Modules.pullback (Stacks.Divisors.zeroScheme X L s).subschemeι).obj L) ⟶
      Stacks.Thickenings.immersionConormalSheaf (Stacks.Divisors.zeroScheme X L s).subschemeι :=
  (Stacks.FundamentalGroup.pullbackDualSheafIso (Stacks.Divisors.zeroScheme X L s).subschemeι L
      (AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree L 1
        (hM := Stacks.ProjectiveBundleSplitting.isFiniteLocallyFreeOfRank_one_of_isInvertible L
          ‹_›))).inv ≫
    (Scheme.Modules.pullback (Stacks.Divisors.zeroScheme X L s).subschemeι).map
      (zeroSchemeIdealModuleHom L s) ≫
    (Stacks.Divisors.conormalSheafIsoNegativeTwist (Stacks.Divisors.zeroScheme X L s)).inv

/-- **The canonical map onto the conormal sheaf of the zero scheme is surjective**, for an
arbitrary global section `s`. The two outer factors are isomorphisms, and the middle one is the
pullback of the epimorphism `AlgebraicGeometry.epi_zeroSchemeIdealModuleHom` by a left adjoint. -/
instance epi_zeroSchemeConormalSurjection : Epi (zeroSchemeConormalSurjection L s) := by
  refine @epi_comp _ _ _ _ _ _ inferInstance _ (@epi_comp _ _ _ _ _ _ inferInstance _ ?_)
  exact @IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_inv _)

/-- **The virtual normal bundle `i^*L` of the zero scheme `i : D ⟶ X` of `s`**
([Stacks, Tag 0FBN]), with the canonical surjection `zeroSchemeConormalSurjection` onto the
conormal sheaf ([Stacks, Tag 0FBQ] (2)). -/
def zeroSchemeVirtualNormalBundle :
    VirtualNormalBundle (Stacks.Divisors.zeroScheme X L s).subschemeι where
  bundle := (Scheme.Modules.pullback (Stacks.Divisors.zeroScheme X L s).subschemeι).obj L
  isFiniteLocallyFree :=
    have := Stacks.ProjectiveBundleSplitting.isFiniteLocallyFreeOfRank_one_of_isInvertible L ‹_›
    have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback
      (Stacks.Divisors.zeroScheme X L s).subschemeι L 1
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree _ 1
  surjection := zeroSchemeConormalSurjection L s

/-- The module of the virtual normal bundle of the zero scheme is the pullback `i^*L`. -/
@[simp]
theorem zeroSchemeVirtualNormalBundle_bundle :
    (zeroSchemeVirtualNormalBundle L s).bundle =
      (Scheme.Modules.pullback (Stacks.Divisors.zeroScheme X L s).subschemeι).obj L :=
  rfl

/-- The surjection of the virtual normal bundle of the zero scheme is the canonical map
`zeroSchemeConormalSurjection`. -/
@[simp]
theorem zeroSchemeVirtualNormalBundle_surjection :
    (zeroSchemeVirtualNormalBundle L s).surjection = zeroSchemeConormalSurjection L s :=
  rfl

/-- **The virtual normal bundle of the zero scheme has rank one**: it is the pullback of an
invertible module. -/
instance isFiniteLocallyFreeOfRank_zeroSchemeVirtualNormalBundle :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (zeroSchemeVirtualNormalBundle L s).bundle 1 :=
  have := Stacks.ProjectiveBundleSplitting.isFiniteLocallyFreeOfRank_one_of_isInvertible L ‹_›
  AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback
    (Stacks.Divisors.zeroScheme X L s).subschemeι L 1

end Stacks.Chow

end
