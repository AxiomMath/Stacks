module

public import Mathlib.LinearAlgebra.Isomorphisms
public import Mathlib.LinearAlgebra.Quotient.Defs
public import Mathlib.LinearAlgebra.TensorAlgebra.ToTensorPower
public import StacksFrontier.AlgebraicGeometry.Chow.KeyLemma.MilnorKTheory
public import StacksCore.Tactic.StacksAttribute

/-!
# The second Milnor K-group of a field

For a field `k`, the second Milnor K-group is the tensor square of the group of units, modulo
the Steinberg relations `x ⊗ (1 - x)`.

## Main definitions

* `milnorKTwoSteinbergSubmodule` is the submodule of the tensor square generated by the
  Steinberg relations.
* `milnorKTwoTensorMap` is the canonical map from the tensor square into the tensor algebra,
  and `milnorKTwoToKGroup` the induced map to the degree-two Milnor K-group.

## Main results

* `milnorKTwoEquivTensorProductQuotient` identifies the second Milnor K-group with the
  quotient of the tensor square by those relations.
* `milnorKTwoToKGroup_surjective` and `milnorKTwoToKGroup_ker` compute the comparison map.

## Implementation notes

Multiplicative groups of units are converted to additive groups before tensoring over `ℤ`.
The displayed equality in the source is expressed as a linear equivalence, retaining the
canonical abelian-group structure on both sides.

The comparison map is built from the identification of `kˣ ⊗ kˣ` with the second tensor power
of `Additive kˣ`, which embeds into the tensor algebra as the degree-two homogeneous component
`milnorKTensorGrading k 2`. Its kernel is computed from the fact that the Steinberg ideal is
generated in degree two, so its own degree-two part is the plain span of the generators.

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
-/

@[expose] public section

open scoped TensorProduct DirectSum

universe u

/-- The subgroup of `kˣ ⊗_ℤ kˣ` generated by the Steinberg tensors
`x ⊗ (1 - x)` for `x ≠ 0, 1`. -/
def milnorKTwoSteinbergSubmodule (k : Type u) [Field k] :
    Submodule ℤ (TensorProduct ℤ (Additive kˣ) (Additive kˣ)) :=
  Submodule.span ℤ <| Set.range fun x : { x : k // x ≠ 0 ∧ x ≠ 1 } ↦
    TensorProduct.tmul ℤ
      (Additive.ofMul (Units.mk0 x.1 x.2.1))
      (Additive.ofMul
        (Units.mk0 (1 - x.1) (sub_ne_zero.mpr (Ne.symm x.2.2))))

/-- The tensor square of `Additive kˣ` is the second tensor power of `Additive kˣ`. -/
def milnorKTwoTensorEquiv (k : Type u) [Field k] :
    TensorProduct ℤ (Additive kˣ) (Additive kˣ) ≃ₗ[ℤ]
      TensorPower ℤ 2 (Additive kˣ) :=
  (TensorProduct.congr
    (PiTensorProduct.subsingletonEquiv (0 : Fin 1)).symm
    (PiTensorProduct.subsingletonEquiv (0 : Fin 1)).symm).trans
      (TensorPower.mulEquiv (R := ℤ) (M := Additive kˣ) (n := 1) (m := 1))

/-- The canonical map from the tensor square of `Additive kˣ` into the tensor algebra, with
image the degree-two homogeneous component. -/
def milnorKTwoTensorMap (k : Type u) [Field k] :
    TensorProduct ℤ (Additive kˣ) (Additive kˣ) →ₗ[ℤ]
      MilnorKTensorAlgebra k :=
  TensorPower.toTensorAlgebra ∘ₗ (milnorKTwoTensorEquiv k).toLinearMap

/-- The canonical map sends a tensor of two units to the product of their images in the tensor
algebra. -/
lemma milnorKTwoTensorMap_tmul (k : Type u) [Field k]
    (x y : Additive kˣ) :
    milnorKTwoTensorMap k (x ⊗ₜ[ℤ] y) =
      TensorAlgebra.ι ℤ x * TensorAlgebra.ι ℤ y := by
  change TensorPower.toTensorAlgebra
    (((TensorProduct.congr (PiTensorProduct.subsingletonEquiv (0 : Fin 1)).symm
        (PiTensorProduct.subsingletonEquiv (0 : Fin 1)).symm).trans
      (TensorPower.mulEquiv (R := ℤ) (M := Additive kˣ) (n := 1) (m := 1)))
      (x ⊗ₜ[ℤ] y)) = _
  rw [LinearEquiv.trans_apply, TensorProduct.congr_tmul,
    PiTensorProduct.subsingletonEquiv_symm_apply', PiTensorProduct.subsingletonEquiv_symm_apply',
    TensorPower.mulEquiv, LinearEquiv.trans_apply, PiTensorProduct.tmulEquiv_apply,
    PiTensorProduct.reindex_tprod, TensorPower.toTensorAlgebra_tprod, TensorAlgebra.tprod_apply]
  simp [finSumFinEquiv, Fin.addCases]

/-- Assembling a single tensor power into the direct sum and then into the tensor algebra is
the canonical map out of that tensor power. -/
private lemma ofDirectSum_of_tensorPower
    {R M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M] {n : ℕ}
    (x : TensorPower R n M) :
    TensorAlgebra.ofDirectSum (DirectSum.of (fun i => TensorPower R i M) n x) =
      TensorPower.toTensorAlgebra x := by
  change TensorAlgebra.ofDirectSum (DirectSum.of (fun i => ⨂[R]^i M) n x) =
      PiTensorProduct.lift (TensorAlgebra.tprod R M n) x
  refine PiTensorProduct.induction_on' x (fun r f ↦ ?_) fun x y hx hy ↦ by simp [hx, hy]
  rw [PiTensorProduct.tprodCoeff_eq_smul_tprod, DirectSum.of_smul, map_smul,
    TensorAlgebra.ofDirectSum_of_tprod, map_smul, PiTensorProduct.lift.tprod]

/-- Each tensor power embeds into the tensor algebra. -/
private lemma tensorPower_toTensorAlgebra_injective
    {R M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M] (n : ℕ) :
    Function.Injective (TensorPower.toTensorAlgebra (R := R) (M := M) (n := n)) := by
  intro x y h
  apply DirectSum.of_injective (β := fun i => TensorPower R i M) n
  simpa only [← ofDirectSum_of_tensorPower, TensorAlgebra.toDirectSum_ofDirectSum]
    using congrArg TensorAlgebra.toDirectSum h

/-- The canonical map from the tensor square into the tensor algebra is injective. -/
private lemma milnorKTwoTensorMap_injective (k : Type u) [Field k] :
    Function.Injective (milnorKTwoTensorMap k) := fun _ _ h ↦
  (milnorKTwoTensorEquiv k).injective (tensorPower_toTensorAlgebra_injective 2 h)

/-- The image of the tensor square is exactly the degree-two homogeneous component. -/
private lemma milnorKTwoTensorMap_range (k : Type u) [Field k] :
    LinearMap.range (milnorKTwoTensorMap k) = milnorKTensorGrading k 2 := by
  let A := MilnorKTensorAlgebra k
  let ι : Additive kˣ →ₗ[ℤ] A := TensorAlgebra.ι ℤ
  let M : Submodule ℤ A := LinearMap.range ι
  change LinearMap.range (milnorKTwoTensorMap k) = M ^ 2
  rw [pow_two]
  apply le_antisymm
  · rintro z ⟨w, rfl⟩
    induction w with
    | tmul x y =>
      rw [milnorKTwoTensorMap_tmul]
      exact Submodule.mul_mem_mul (LinearMap.mem_range_self ι x) (LinearMap.mem_range_self ι y)
    | add x y hx hy =>
      simpa only [map_add] using add_mem hx hy
  · refine Submodule.mul_le.2 ?_
    rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    exact ⟨a ⊗ₜ[ℤ] b, milnorKTwoTensorMap_tmul k a b⟩

/-- The `ℤ`-span, inside the tensor algebra, of the Steinberg elements; this is the degree-two
part of the Steinberg ideal. -/
private def milnorKTwoRelationSpanInAlgebra (k : Type u) [Field k] :
    Submodule ℤ (MilnorKTensorAlgebra k) :=
  Submodule.span ℤ (milnorKSteinbergRelations k)

/-- A degree-two element of the Steinberg ideal is already a `ℤ`-combination of Steinberg
elements: the ideal is generated in degree two, so the two-sided multiples contribute only in
higher degrees. -/
private lemma milnorKTwoIdeal_degree_two (k : Type u) [Field k]
    {x : MilnorKTensorAlgebra k}
    (hx : x ∈ milnorKSteinbergIdeal k)
    (h₂ : x ∈ milnorKTensorGrading k 2) : x ∈ milnorKTwoRelationSpanInAlgebra k := by
  have h₀ (a : MilnorKTensorAlgebra k) : ∃ r : ℤ, algebraMap ℤ _ r =
      ((DirectSum.decompose (milnorKTensorGrading k) a 0 : milnorKTensorGrading k 0) :
        MilnorKTensorAlgebra k) :=
    Submodule.mem_one.mp (DirectSum.decompose (milnorKTensorGrading k) a 0).property
  have hprop : ∀ {z : MilnorKTensorAlgebra k}, z ∈ milnorKSteinbergIdeal k →
      (∀ n < 2, ((DirectSum.decompose (milnorKTensorGrading k) z n : milnorKTensorGrading k n) :
          MilnorKTensorAlgebra k) = 0) ∧
        ((DirectSum.decompose (milnorKTensorGrading k) z 2 : milnorKTensorGrading k 2) :
          MilnorKTensorAlgebra k) ∈ milnorKTwoRelationSpanInAlgebra k := by
    intro z hz
    induction hz using TwoSidedIdeal.span_induction with
    | mem z hz =>
        have hD₂ := steinbergRelation_mem_degree_two k hz
        refine ⟨fun n hn ↦ DirectSum.decompose_of_mem_ne (milnorKTensorGrading k) hD₂ (by omega),
          ?_⟩
        rw [DirectSum.decompose_of_mem_same (milnorKTensorGrading k) hD₂]
        exact Submodule.subset_span hz
    | zero =>
        refine ⟨fun _ _ ↦ by simp, ?_⟩
        rw [DirectSum.decompose_zero, DirectSum.zero_apply]
        exact Submodule.zero_mem _
    | add z w hz hw ihz ihw =>
        refine ⟨fun n hn ↦ ?_, ?_⟩
        · rw [DirectSum.decompose_add]
          simp [ihz.1 n hn, ihw.1 n hn]
        · rw [DirectSum.decompose_add, DirectSum.add_apply]
          exact Submodule.add_mem _ ihz.2 ihw.2
    | neg z hz ih =>
        refine ⟨fun n hn ↦ ?_, ?_⟩
        · rw [DirectSum.decompose_neg]
          change -((DirectSum.decompose (milnorKTensorGrading k) z n : milnorKTensorGrading k n) :
            MilnorKTensorAlgebra k) = 0
          rw [ih.1 n hn, neg_zero]
        · rw [DirectSum.decompose_neg]
          exact Submodule.neg_mem _ ih.2
    | left_absorb a z hz ih =>
        rw [DirectSum.decompose_mul]
        refine ⟨fun n hn ↦ ?_, ?_⟩
        · rw [DirectSum.coe_mul_apply_eq_sum_antidiagonal (milnorKTensorGrading k)]
          refine Finset.sum_eq_zero fun ij hij ↦ ?_
          have hp := Finset.mem_antidiagonal.mp hij
          simp [ih.1 ij.2 (by omega)]
        · rw [DirectSum.coe_mul_apply_eq_sum_antidiagonal (milnorKTensorGrading k)]
          refine Submodule.sum_mem _ fun ⟨i, j⟩ hij ↦ ?_
          have hp : i + j = 2 := Finset.mem_antidiagonal.mp hij
          by_cases hj : j < 2
          · simp [ih.1 j hj]
          · obtain rfl : j = 2 := by omega
            obtain rfl : i = 0 := by omega
            obtain ⟨r, hr⟩ := h₀ a
            change ((DirectSum.decompose (milnorKTensorGrading k) a 0 : milnorKTensorGrading k 0) :
                MilnorKTensorAlgebra k) *
              ((DirectSum.decompose (milnorKTensorGrading k) z 2 : milnorKTensorGrading k 2) :
                MilnorKTensorAlgebra k) ∈ milnorKTwoRelationSpanInAlgebra k
            rw [← hr, ← Algebra.smul_def]
            exact Submodule.smul_mem _ r ih.2
    | right_absorb b z hz ih =>
        rw [DirectSum.decompose_mul]
        refine ⟨fun n hn ↦ ?_, ?_⟩
        · rw [DirectSum.coe_mul_apply_eq_sum_antidiagonal (milnorKTensorGrading k)]
          refine Finset.sum_eq_zero fun ij hij ↦ ?_
          have hp := Finset.mem_antidiagonal.mp hij
          simp [ih.1 ij.1 (by omega)]
        · rw [DirectSum.coe_mul_apply_eq_sum_antidiagonal (milnorKTensorGrading k)]
          refine Submodule.sum_mem _ fun ⟨i, j⟩ hij ↦ ?_
          have hp : i + j = 2 := Finset.mem_antidiagonal.mp hij
          by_cases hi : i < 2
          · simp [ih.1 i hi]
          · obtain rfl : i = 2 := by omega
            obtain rfl : j = 0 := by omega
            obtain ⟨r, hr⟩ := h₀ b
            change ((DirectSum.decompose (milnorKTensorGrading k) z 2 : milnorKTensorGrading k 2) :
                MilnorKTensorAlgebra k) *
              ((DirectSum.decompose (milnorKTensorGrading k) b 0 : milnorKTensorGrading k 0) :
                MilnorKTensorAlgebra k) ∈ milnorKTwoRelationSpanInAlgebra k
            rw [← hr, ← Algebra.commutes r, ← Algebra.smul_def]
            exact Submodule.smul_mem _ r ih.2
  have hx₂ := (hprop hx).2
  rwa [DirectSum.decompose_of_mem_same (milnorKTensorGrading k) h₂] at hx₂

/-- The canonical map carries the Steinberg submodule of the tensor square onto the span of the
Steinberg elements in the tensor algebra. -/
private lemma milnorKTwoTensorMap_map_relations (k : Type u) [Field k] :
    Submodule.map (milnorKTwoTensorMap k) (milnorKTwoSteinbergSubmodule k) =
      milnorKTwoRelationSpanInAlgebra k := by
  rw [milnorKTwoSteinbergSubmodule, Submodule.map_span, ← Set.range_comp]
  simp only [Function.comp_def, milnorKTwoTensorMap_tmul]
  rfl

/-- The Steinberg ideal, read as a `ℤ`-submodule of the tensor algebra. -/
private def milnorKTwoIdealAsSubmodule (k : Type u) [Field k] :
    Submodule ℤ (MilnorKTensorAlgebra k) where
  carrier := milnorKSteinbergIdeal k
  zero_mem' := TwoSidedIdeal.zero_mem _
  add_mem' hx hy := (milnorKSteinbergIdeal k).add_mem hx hy
  smul_mem' r x hx := by
    rw [Algebra.smul_def]
    exact TwoSidedIdeal.mul_mem_left _ _ _ hx

/-- The span of the Steinberg elements is contained in the Steinberg ideal. -/
private lemma milnorKTwoRelationSpan_le_ideal (k : Type u) [Field k] :
    milnorKTwoRelationSpanInAlgebra k ≤ milnorKTwoIdealAsSubmodule k :=
  Submodule.span_le.2 fun _ hx ↦ TwoSidedIdeal.subset_span hx

/-- The degree-two homogeneous component of the Milnor K-ring, as an additive subgroup. -/
def milnorKTwoSubgroup (k : Type u) [Field k] :
    AddSubgroup (MilnorKRing k) :=
  AddSubgroup.map
    (milnorKSteinbergIdeal k).ringCon.mk'.toAddMonoidHom
    (milnorKTensorGrading k 2).toAddSubgroup

/-- The comparison map from the tensor square of `Additive kˣ` to the degree-two Milnor
K-group, induced by the canonical map into the tensor algebra. -/
def milnorKTwoToKGroup (k : Type u) [Field k] :
    TensorProduct ℤ (Additive kˣ) (Additive kˣ) →ₗ[ℤ]
      AddSubgroup.toIntSubmodule (milnorKTwoSubgroup k) :=
  LinearMap.codRestrict _
    (((milnorKSteinbergIdeal k).ringCon.mk'.toAddMonoidHom.toIntLinearMap)
      ∘ₗ milnorKTwoTensorMap k)
    fun z => ⟨milnorKTwoTensorMap k z, by rw [← milnorKTwoTensorMap_range]; exact ⟨z, rfl⟩, rfl⟩

/-- The comparison map is surjective. -/
lemma milnorKTwoToKGroup_surjective (k : Type u) [Field k] :
    Function.Surjective (milnorKTwoToKGroup k) := by
  intro y
  obtain ⟨x, hx, hq⟩ := y.property
  obtain ⟨z, rfl⟩ := (milnorKTwoTensorMap_range k).ge hx
  exact ⟨z, Subtype.ext hq⟩

/-- The kernel of the comparison map is exactly the Steinberg submodule of the tensor
square. -/
lemma milnorKTwoToKGroup_ker (k : Type u) [Field k] :
    LinearMap.ker (milnorKTwoToKGroup k) = milnorKTwoSteinbergSubmodule k := by
  ext z
  rw [LinearMap.mem_ker, Subtype.ext_iff]
  change (milnorKSteinbergIdeal k).ringCon.mk' (milnorKTwoTensorMap k z) = 0 ↔ _
  rw [← TwoSidedIdeal.mem_ker, TwoSidedIdeal.ker_ringCon_mk']
  refine ⟨fun hz ↦ ?_, fun hz ↦ milnorKTwoRelationSpan_le_ideal k ?_⟩
  · obtain ⟨w, hw, hwz⟩ : milnorKTwoTensorMap k z ∈
        (milnorKTwoSteinbergSubmodule k).map (milnorKTwoTensorMap k) := by
      rw [milnorKTwoTensorMap_map_relations]
      exact milnorKTwoIdeal_degree_two k hz ((milnorKTwoTensorMap_range k).le ⟨z, rfl⟩)
    rwa [← milnorKTwoTensorMap_injective k hwz]
  · rw [← milnorKTwoTensorMap_map_relations]
    exact ⟨z, hz, rfl⟩

/-- The second Milnor K-group is the tensor square of the group of units modulo the
Steinberg relations. -/
@[stacks 0EAY "milnor_k_two"]
noncomputable def milnorKTwoEquivTensorProductQuotient (k : Type u) [Field k] :
    MilnorKTheory k 2 ≃ₗ[ℤ]
      (TensorProduct ℤ (Additive kˣ) (Additive kˣ) ⧸
        milnorKTwoSteinbergSubmodule k) := by
  let F := milnorKTwoToKGroup k
  let eker :
      (TensorProduct ℤ (Additive kˣ) (Additive kˣ) ⧸ LinearMap.ker F) ≃ₗ[ℤ]
        (TensorProduct ℤ (Additive kˣ) (Additive kˣ) ⧸
          milnorKTwoSteinbergSubmodule k) :=
    Submodule.quotEquivOfEq _ _ (milnorKTwoToKGroup_ker k)
  let e :
      (TensorProduct ℤ (Additive kˣ) (Additive kˣ) ⧸
        milnorKTwoSteinbergSubmodule k) ≃ₗ[ℤ]
        AddSubgroup.toIntSubmodule (milnorKTwoSubgroup k) :=
    eker.symm.trans (F.quotKerEquivOfSurjective (milnorKTwoToKGroup_surjective k))
  let coeEquiv :
      (milnorKTwoSubgroup k) ≃ₗ[ℤ]
        AddSubgroup.toIntSubmodule (milnorKTwoSubgroup k) :=
    { toFun := fun x => ⟨x.1, x.2⟩
      invFun := fun x => ⟨x.1, x.2⟩
      left_inv _ := rfl
      right_inv _ := rfl
      map_add' _ _ := rfl
      map_smul' _ _ := rfl }
  exact coeEquiv.trans e.symm

/-- The degree-two identification sends the class of a tensor to its class modulo
Steinberg relations. This fixes the identification on generators. -/
@[simp]
theorem milnorKTwoEquivTensorProductQuotient_toKGroup (k : Type u) [Field k]
    (z : TensorProduct ℤ (Additive kˣ) (Additive kˣ)) :
    milnorKTwoEquivTensorProductQuotient k (milnorKTwoToKGroup k z) =
      Submodule.Quotient.mk z :=
  (milnorKTwoEquivTensorProductQuotient k).symm.injective
    ((milnorKTwoEquivTensorProductQuotient k).symm_apply_apply _)
