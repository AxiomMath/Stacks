module

public import Mathlib.Data.Finset.NatAntidiagonal
public import Mathlib.LinearAlgebra.TensorAlgebra.Grading
public import Mathlib.RingTheory.TwoSidedIdeal.Kernel
public import Mathlib.RingTheory.TwoSidedIdeal.Operations
public import StacksCore.Tactic.StacksAttribute

/-!
# Milnor K-theory of a field

For a field `k`, Milnor K-theory is the graded quotient of the tensor algebra over `ℤ` on the
multiplicative group `kˣ` by the Steinberg relations `x ⊗ (1 - x)`.

## Main definitions

* `MilnorKTensorAlgebra` is the tensor algebra the construction starts from.
* `milnorKSteinbergRelations` and `milnorKSteinbergIdeal` are the Steinberg relations and the
  two-sided ideal they generate.
* `MilnorKRing` is the quotient ring, and `milnorKGrading` its family of homogeneous
  subgroups.
* `MilnorKTheory` is the degree-`n` part of the Milnor K-theory of a field.

## Main results

* `milnorKGrading_isInternal` identifies the quotient ring with the direct sum of its
  homogeneous components.
* `milnorKGradedMonoid` and `milnorKGradedRing` equip the quotient with that grading.

## Implementation notes

The multiplicative abelian group `kˣ` is regarded as the additive group `Additive kˣ` when
forming its tensor algebra. The full quotient ring is `MilnorKRing`; `MilnorKTheory k n` is the
image in that quotient of the degree-`n` homogeneous component of the tensor algebra, which is
exactly the subgroup `milnorKGrading k n` read as a type. The Steinberg ideal is homogeneous,
and `milnorKGradedRing` equips these images with their canonical internal grading. Thus all
degrees live canonically in one quotient ring, retaining the graded-quotient construction.

Since the subject is a field rather than a scheme, these declarations are placed in the root
namespace, where every name already carries the `milnorK` prefix.

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
-/

@[expose] public section

universe u

/-- The tensor algebra used to construct the Milnor K-theory of a field. -/
abbrev MilnorKTensorAlgebra (k : Type u) [Field k] :=
  TensorAlgebra ℤ (Additive kˣ)

/-- The degree-two Steinberg elements `x ⊗ (1 - x)` in the tensor algebra on `kˣ`. -/
def milnorKSteinbergRelations (k : Type u) [Field k] :
    Set (MilnorKTensorAlgebra k) :=
  Set.range fun x : { x : k // x ≠ 0 ∧ x ≠ 1 } ↦
    TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 x.1 x.2.1)) *
      TensorAlgebra.ι ℤ
        (Additive.ofMul (Units.mk0 (1 - x.1) (sub_ne_zero.mpr (Ne.symm x.2.2))))

/-- The two-sided ideal generated by the Steinberg elements. -/
def milnorKSteinbergIdeal (k : Type u) [Field k] :
    TwoSidedIdeal (MilnorKTensorAlgebra k) :=
  TwoSidedIdeal.span (milnorKSteinbergRelations k)

/-- The underlying quotient ring of the graded Milnor K-theory of `k`. -/
abbrev MilnorKRing (k : Type u) [Field k] :=
  (milnorKSteinbergIdeal k).ringCon.Quotient

/-- The homogeneous additive subgroups of the Milnor K-ring. -/
abbrev milnorKGrading (k : Type u) [Field k] (n : ℕ) :
    AddSubgroup (MilnorKRing k) :=
  AddSubgroup.map (milnorKSteinbergIdeal k).ringCon.mk'.toAddMonoidHom
    ((LinearMap.range
      (TensorAlgebra.ι ℤ : Additive kˣ →ₗ[ℤ] MilnorKTensorAlgebra k) ^ n).toAddSubgroup)

/-- The `n`th Milnor K-group of a field `k`, realized as the image of the degree-`n`
homogeneous component of the tensor algebra in its quotient by the Steinberg ideal. -/
@[stacks 0EAY "milnor_k_theory_of_a_field"]
abbrev MilnorKTheory (k : Type u) [Field k] (n : ℕ) : Type u :=
  milnorKGrading k n

/-- The degree-`n` homogeneous component of the tensor algebra on `kˣ`, before passing to the
Steinberg quotient. -/
abbrev milnorKTensorGrading (k : Type u) [Field k] (n : ℕ) :
    Submodule ℤ (MilnorKTensorAlgebra k) :=
  LinearMap.range
    (TensorAlgebra.ι ℤ : Additive kˣ →ₗ[ℤ] MilnorKTensorAlgebra k) ^ n

/-- A Steinberg element is homogeneous of degree two in the tensor algebra. -/
lemma steinbergRelation_mem_degree_two (k : Type u) [Field k]
    {x : MilnorKTensorAlgebra k} (hx : x ∈ milnorKSteinbergRelations k) :
    x ∈ milnorKTensorGrading k 2 := by
  obtain ⟨a, rfl⟩ := hx
  have h₁ : TensorAlgebra.ι ℤ (Additive.ofMul (Units.mk0 a.1 a.2.1)) ∈
      milnorKTensorGrading k 1 := by simp [milnorKTensorGrading]
  have h₂ : TensorAlgebra.ι ℤ
      (Additive.ofMul (Units.mk0 (1 - a.1) (sub_ne_zero.mpr (Ne.symm a.2.2)))) ∈
      milnorKTensorGrading k 1 := by simp [milnorKTensorGrading]
  simpa using (SetLike.mul_mem_graded (A := milnorKTensorGrading k) h₁ h₂)

/-- The Steinberg ideal is homogeneous: every graded piece of one of its elements again lies
in it. -/
private lemma milnorKSteinbergIdeal_isHomogeneous (k : Type u) [Field k]
    {x : MilnorKTensorAlgebra k} (hx : x ∈ milnorKSteinbergIdeal k) : ∀ n : ℕ,
    ((DirectSum.decompose (milnorKTensorGrading k) x n : milnorKTensorGrading k n) :
      MilnorKTensorAlgebra k) ∈ milnorKSteinbergIdeal k := by
  induction hx using TwoSidedIdeal.span_induction with
  | mem x hx =>
      intro n
      have hx₂ := steinbergRelation_mem_degree_two k hx
      by_cases h : n = 2
      · subst n
        rw [DirectSum.decompose_of_mem_same (milnorKTensorGrading k) hx₂]
        change x ∈ TwoSidedIdeal.span (milnorKSteinbergRelations k)
        exact TwoSidedIdeal.subset_span hx
      · rw [DirectSum.decompose_of_mem_ne (milnorKTensorGrading k) hx₂ (Ne.symm h)]
        exact (milnorKSteinbergIdeal k).zero_mem
  | zero => simp
  | add x y hx hy ihx ihy =>
      intro n
      rw [DirectSum.decompose_add]
      exact (milnorKSteinbergIdeal k).add_mem (ihx n) (ihy n)
  | neg x hx ih =>
      intro n
      rw [DirectSum.decompose_neg]
      exact (milnorKSteinbergIdeal k).neg_mem (ih n)
  | left_absorb a x hx ih =>
      intro n
      rw [DirectSum.decompose_mul,
        DirectSum.coe_mul_apply_eq_sum_antidiagonal (milnorKTensorGrading k)]
      exact sum_mem fun ij _ ↦ (milnorKSteinbergIdeal k).mul_mem_left _ _ (ih ij.2)
  | right_absorb b x hx ih =>
      intro n
      rw [DirectSum.decompose_mul,
        DirectSum.coe_mul_apply_eq_sum_antidiagonal (milnorKTensorGrading k)]
      exact sum_mem fun ij _ ↦ (milnorKSteinbergIdeal k).mul_mem_right _ _ (ih ij.1)

/-- The quotient map, restricted to one homogeneous component of the tensor algebra. -/
private def milnorKComponentMap (k : Type u) [Field k] (n : ℕ) :
    milnorKTensorGrading k n →+ milnorKGrading k n where
  toFun x := ⟨(milnorKSteinbergIdeal k).ringCon.mk' x, ⟨x, x.2, rfl⟩⟩
  map_zero' := Subtype.ext (map_zero _)
  map_add' _ _ := Subtype.ext (map_add _ _ _)

/-- Each homogeneous component of the quotient is, by construction, the image of the
corresponding component of the tensor algebra. -/
private lemma milnorKComponentMap_surjective (k : Type u) [Field k] (n : ℕ) :
    Function.Surjective (milnorKComponentMap k n) := by
  rintro ⟨y, x, hx, rfl⟩
  exact ⟨⟨x, hx⟩, rfl⟩

/-- Reassembling the homogeneous components commutes with passing to the quotient. -/
private lemma milnorK_recompose_map (k : Type u) [Field k]
    (w : DirectSum ℕ fun n ↦ milnorKTensorGrading k n) :
    DirectSum.coeAddMonoidHom (milnorKGrading k) (DirectSum.map (milnorKComponentMap k) w) =
      (milnorKSteinbergIdeal k).ringCon.mk'
        (DirectSum.coeAddMonoidHom (milnorKTensorGrading k) w) := by
  induction w using DirectSum.induction_on with
  | zero => simp
  | of i x => rfl
  | add x y hx hy => simp only [map_add, hx, hy]

/-- The homogeneous images in the Steinberg quotient form an internal direct sum. -/
lemma milnorKGrading_isInternal (k : Type u) [Field k] :
    DirectSum.IsInternal (milnorKGrading k) := by
  constructor
  · intro z z' hz
    rw [← sub_eq_zero]
    obtain ⟨w, hw⟩ :=
      (DirectSum.map_surjective (milnorKComponentMap k)).2
        (milnorKComponentMap_surjective k) (z - z')
    rw [← hw]
    apply DirectSum.ext
    intro n
    apply Subtype.ext
    change (milnorKSteinbergIdeal k).ringCon.mk' (w n : MilnorKTensorAlgebra k) = 0
    rw [← TwoSidedIdeal.mem_ker, TwoSidedIdeal.ker_ringCon_mk',
      ← DFunLike.congr_fun ((DirectSum.decompose (milnorKTensorGrading k)).right_inv w) n]
    apply milnorKSteinbergIdeal_isHomogeneous k
    rw [← TwoSidedIdeal.ker_ringCon_mk' (milnorKSteinbergIdeal k), TwoSidedIdeal.mem_ker]
    change (milnorKSteinbergIdeal k).ringCon.mk'
      ((DirectSum.coeAddMonoidHom (milnorKTensorGrading k)) w) = 0
    rw [← milnorK_recompose_map, hw]
    simp [hz]
  · rintro ⟨x⟩
    refine ⟨DirectSum.map (milnorKComponentMap k)
      (DirectSum.decompose (milnorKTensorGrading k) x), ?_⟩
    rw [milnorK_recompose_map]
    exact congr_arg _ ((DirectSum.decompose (milnorKTensorGrading k)).left_inv x)

/-- The homogeneous subgroups of the Milnor K-ring contain the unit and are closed under
multiplication. -/
instance milnorKGradedMonoid (k : Type u) [Field k] :
    SetLike.GradedMonoid (milnorKGrading k) where
  one_mem := ⟨1, SetLike.one_mem_graded (milnorKTensorGrading k),
    (milnorKSteinbergIdeal k).ringCon.mk'.map_one⟩
  mul_mem i j x y := by
    rintro ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
    exact ⟨a * b, SetLike.mul_mem_graded (A := milnorKTensorGrading k) ha hb,
      (milnorKSteinbergIdeal k).ringCon.mk'.map_mul a b⟩

/-- The quotient by the Steinberg relations has the canonical grading whose degree-`n`
component is `MilnorKTheory k n`. -/
noncomputable instance milnorKGradedRing (k : Type u) [Field k] :
    GradedRing (milnorKGrading k) := by
  letI := DirectSum.IsInternal.chooseDecomposition (milnorKGrading k)
    (milnorKGrading_isInternal k)
  exact GradedRing.mk
