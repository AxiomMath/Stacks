module

public import StacksFrontier.AlgebraicGeometry.Chow.KeyLemma.TameSymbolPrepared
public import StacksFrontier.AlgebraicGeometry.Chow.KeyLemma.TameSymbolReciprocityNonzero

/-!
# The reciprocity sum vanishing by cancellation

Every case of the reciprocity relation Stacks 0EAW proved in
`StacksFrontier.AlgebraicGeometry.Chow.KeyLemma.TameSymbolReciprocity` and in
`StacksFrontier.AlgebraicGeometry.Chow.KeyLemma.TameSymbolPrepared` is proved by showing that each
summand vanishes on its own: either one argument is a unit of `A`, or the two arguments admit at
each height-one prime a simultaneous power factorization whose unit parts have proportional orders
of vanishing. The source reaches a prepared case only after the finite modification of Stacks
0EAG, and there the unit parts are units of the localizations, whose orders of vanishing need not
vanish — so the sum is zero only because the summands *cancel*.

This file closes an instance of the relation in that regime. Over `k[X₀, X₁]`, with the canonical
tame symbols of `Stacks.Chow.normalHeightOneSymbol`, the pair `X₁`, `X₀` has summand `1` at the
height-one prime `(X₀)` and summand `-1` at the height-one prime `(X₁)`, by
`Stacks.Chow.tameSymbolOrderAt_mvPolynomialX_eq_one` and
`Stacks.Chow.tameSymbolOrderAt_mvPolynomialX_eq_neg_one`; every other height-one prime contributes
zero, because a height-one prime containing a variable *is* the prime generated by that variable.
So the reciprocity sum is `1 + (-1) = 0`: two nonzero summands cancelling.

The same prime also carries a factorization of exactly the shape the finite modification of Stacks
0EAG supplies — `X₁ = u · X₀ ^ 0` and `X₀ = 1 · X₀ ^ 1` in `k[X₀, X₁]_{(X₀)}`, with `u` the image
of `X₁`, a unit of the localization and not of `k[X₀, X₁]` — and for it the termwise hypothesis of
`Stacks.Chow.tameSymbolOrderAt_eq_zero_of_factorization_order` *fails*, its two sides being `1`
and `0`. So that hypothesis is not automatic in the prepared case, and this instance of Stacks
0EAW is not an instance of any of the termwise results.

## Main results

* `Stacks.Chow.heightOnePrime_eq_of_asIdeal_le` — two height-one primes, one contained in the
  other, are equal.
* `Stacks.Chow.heightOneOrd_unit_mvPolynomialX_eq_one` — the unit part above has order of vanishing
  `1` along `k[X₀, X₁] / (X₀)`, not `0`.
* `Stacks.Chow.exists_factorization_order_ne_mvPolynomialX` — **the termwise hypothesis of the
  prepared case genuinely fails**: prepared data at `(X₀)` for which the two sides differ.
* `Stacks.Chow.tameSymbolOrderAt_finsum_mvPolynomialX_eq_zero` — **the vanishing sum of Stacks
  0EAW for a pair whose summands do not vanish individually**: the sum is `1 + (-1)`.

## Implementation notes

That a height-one prime containing `X_i` is `(X_i)` is the strict monotonicity of height along a
strict inclusion of primes, `Order.height_strictMono`, transported through
`PrimeSpectrum.height_eq_orderHeight`; `Ideal.height_mono` is not enough, since it is not strict.

`k[X₀, X₁]` is not local, so this is not an instance of the hypotheses of Stacks 0EAW as the
source states them; it is an instance of the conclusion in the spelling the library uses, which
does not need locality. What it witnesses is the regime, not the source's reduction.

The coercion of a `Units.map` of a residue is written out as a hypothesis rather than reached by
`simp` at the definition of `Stacks.Chow.toLocalizationNonZeroDivisor`, so that no equation lemma
for that definition is generated in this module.

## References

* [Stacks Project, Tag 0EAW](https://stacks.math.columbia.edu/tag/0EAW)
* [Stacks Project, Tag 0EAG](https://stacks.math.columbia.edu/tag/0EAG)
* [Stacks Project, Tag 0EAN](https://stacks.math.columbia.edu/tag/0EAN)
-/

@[expose] public section

open IsLocalRing

universe u

namespace Stacks.Chow

/-- **Two height-one primes, one contained in the other, are equal.** A strict inclusion of primes
raises the height, and both heights are `1`. -/
theorem heightOnePrime_eq_of_asIdeal_le {A : Type u} [CommRing A] (p q : HeightOnePrime A)
    (h : p.1.asIdeal ≤ q.1.asIdeal) : p = q := by
  rcases eq_or_lt_of_le ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mp h) with heq | hlt
  · exact Subtype.ext heq
  · exfalso
    have hfin : Order.height p.1 < ⊤ := by
      rw [← PrimeSpectrum.height_eq_orderHeight, p.2]
      exact ENat.natCast_lt_top 1
    have hlt' : Order.height p.1 < Order.height q.1 := Order.height_strictMono hlt hfin
    rw [← PrimeSpectrum.height_eq_orderHeight, ← PrimeSpectrum.height_eq_orderHeight,
      p.2, q.2] at hlt'
    exact lt_irrefl _ hlt'

variable (k : Type u) [Field k]

/-- **A height-one prime of `k[X₀, X₁]` containing a variable is the prime that variable
generates.** -/
theorem eq_mvPolynomialHeightOnePrimeX_of_mem (i : Fin 2)
    (p : HeightOnePrime (MvPolynomial (Fin 2) k))
    (hp : (MvPolynomial.X i : MvPolynomial (Fin 2) k) ∈ p.1.asIdeal) :
    p = mvPolynomialHeightOnePrimeX k i :=
  (heightOnePrime_eq_of_asIdeal_le (mvPolynomialHeightOnePrimeX k i) p
    (by
      rw [asIdeal_mvPolynomialHeightOnePrimeX, Ideal.span_singleton_le_iff_mem]
      exact hp)).symm

/-- The two height-one primes generated by the two variables of `k[X₀, X₁]` are distinct: one
variable does not lie in the ideal generated by the other. -/
theorem mvPolynomialHeightOnePrimeX_ne {i j : Fin 2} (hij : i ≠ j) :
    mvPolynomialHeightOnePrimeX k i ≠ mvPolynomialHeightOnePrimeX k j := by
  intro h
  refine notMem_span_mvPolynomialX k hij ?_
  rw [h, asIdeal_mvPolynomialHeightOnePrimeX]
  exact Ideal.mem_span_singleton_self _

/-- **The unit part of the prepared factorization at `(X_i)` has order of vanishing one.** The
image of `X_j` in `k[X₀, X₁]_{(X_i)}` is a unit of that localization, and its residue generates a
maximal ideal of `k[X₀, X₁] / (X_i)`, so its order of vanishing there is `1` rather than `0`. This
is why a unit of the localization cannot be treated like a unit of `k[X₀, X₁]`, whose order of
vanishing is `0` by `Stacks.Chow.heightOneOrd_eq_zero_of_isUnit`. -/
theorem heightOneOrd_unit_mvPolynomialX_eq_one {i j : Fin 2} (hij : i ≠ j)
    (hau : IsUnit ((toLocalizationNonZeroDivisor (mvPolynomialHeightOnePrimeX k i).1.asIdeal
      (mvPolynomialX k j) : Localization.AtPrime
        (mvPolynomialHeightOnePrimeX k i).1.asIdeal))) :
    heightOneOrd (MvPolynomial.ringKrullDim_fin_two k) (mvPolynomialHeightOnePrimeX k i)
        (Units.map (residue (Localization.AtPrime
          (mvPolynomialHeightOnePrimeX k i).1.asIdeal)).toMonoidHom hau.unit) = 1 := by
  have hcoe : ((Units.map (residue (Localization.AtPrime
        (mvPolynomialHeightOnePrimeX k i).1.asIdeal)).toMonoidHom hau.unit :
      (ResidueField (Localization.AtPrime
        (mvPolynomialHeightOnePrimeX k i).1.asIdeal))ˣ) :
        ResidueField (Localization.AtPrime
          (mvPolynomialHeightOnePrimeX k i).1.asIdeal)) =
      residue (Localization.AtPrime (mvPolynomialHeightOnePrimeX k i).1.asIdeal)
        (algebraMap (MvPolynomial (Fin 2) k)
          (Localization.AtPrime (mvPolynomialHeightOnePrimeX k i).1.asIdeal)
          (MvPolynomial.X j)) := by
    rw [Units.coe_map, hau.unit_spec]
    rfl
  have hquot : Ring.ord
      (MvPolynomial (Fin 2) k ⧸ (mvPolynomialHeightOnePrimeX k i).1.asIdeal)
      (Ideal.Quotient.mk (mvPolynomialHeightOnePrimeX k i).1.asIdeal
        (MvPolynomial.X j)) = 1 :=
    ord_eq_one_of_isMaximal (isMaximal_span_quotientMk_mvPolynomialX k hij)
  rw [heightOneOrd_eq_ord_quotient (MvPolynomial.ringKrullDim_fin_two k)
      (mvPolynomialHeightOnePrimeX k i) _ (notMem_span_mvPolynomialX k hij) hcoe, hquot]
  rfl

/-- **The termwise hypothesis of the prepared case is not automatic.** At the height-one prime
`(X_i)` of `k[X₀, X₁]` the pair `X_j`, `X_i` admits a simultaneous power factorization of exactly
the shape the finite modification of Stacks 0EAG supplies, with unit parts in the localization:
`X_j = u · X_i ^ 0` and `X_i = 1 · X_i ^ 1`, with `u` the image of `X_j`. For that data the two
sides of the hypothesis of `Stacks.Chow.tameSymbolOrderAt_eq_zero_of_factorization_order` are `1`
and `0`.

So the summand at that prime is not zero, and the reciprocity relation for this pair is not an
instance of any result which makes the summands vanish individually. -/
theorem exists_factorization_order_ne_mvPolynomialX {i j : Fin 2} (hij : i ≠ j) :
    ∃ (π : nonZeroDivisors
        (Localization.AtPrime (mvPolynomialHeightOnePrimeX k i).1.asIdeal))
      (u v : (Localization.AtPrime (mvPolynomialHeightOnePrimeX k i).1.asIdeal)ˣ)
      (e f : ℕ),
      (toLocalizationNonZeroDivisor (mvPolynomialHeightOnePrimeX k i).1.asIdeal
            (mvPolynomialX k j) :
          Localization.AtPrime (mvPolynomialHeightOnePrimeX k i).1.asIdeal) =
        u * (π : Localization.AtPrime (mvPolynomialHeightOnePrimeX k i).1.asIdeal) ^ e ∧
      (toLocalizationNonZeroDivisor (mvPolynomialHeightOnePrimeX k i).1.asIdeal
            (mvPolynomialX k i) :
          Localization.AtPrime (mvPolynomialHeightOnePrimeX k i).1.asIdeal) =
        v * (π : Localization.AtPrime (mvPolynomialHeightOnePrimeX k i).1.asIdeal) ^ f ∧
      (f : ℤ) * heightOneOrd (MvPolynomial.ringKrullDim_fin_two k)
            (mvPolynomialHeightOnePrimeX k i)
            (Units.map (residue (Localization.AtPrime
              (mvPolynomialHeightOnePrimeX k i).1.asIdeal)).toMonoidHom u) ≠
        (e : ℤ) * heightOneOrd (MvPolynomial.ringKrullDim_fin_two k)
            (mvPolynomialHeightOnePrimeX k i)
            (Units.map (residue (Localization.AtPrime
              (mvPolynomialHeightOnePrimeX k i).1.asIdeal)).toMonoidHom v) := by
  have hau : IsUnit ((toLocalizationNonZeroDivisor
      (mvPolynomialHeightOnePrimeX k i).1.asIdeal (mvPolynomialX k j) :
        Localization.AtPrime (mvPolynomialHeightOnePrimeX k i).1.asIdeal)) :=
    isUnit_toLocalizationNonZeroDivisor (mvPolynomialHeightOnePrimeX k i).1.asIdeal
      (mvPolynomialX k j) (notMem_span_mvPolynomialX k hij)
  refine ⟨toLocalizationNonZeroDivisor (mvPolynomialHeightOnePrimeX k i).1.asIdeal
      (mvPolynomialX k i), hau.unit, 1, 0, 1, ?_, ?_, ?_⟩
  · rw [pow_zero, mul_one, hau.unit_spec]
  · rw [pow_one, Units.val_one, one_mul]
  · rw [heightOneOrd_unit_mvPolynomialX_eq_one k hij hau]
    norm_num

/-- **THE VANISHING SUM OF STACKS 0EAW FOR A PAIR WHOSE SUMMANDS DO NOT VANISH INDIVIDUALLY.**
Over `k[X₀, X₁]`, with the canonical tame symbol at each height-one prime, the orders of
`∂(X_j, X_i)` sum to zero — and they do so by cancellation: the summand is `1` at the height-one
prime `(X_i)` and `-1` at the height-one prime `(X_j)`.

Only those two primes contribute, because a height-one prime with a nonzero summand must contain
one of the two variables, and a height-one prime containing a variable is the prime that variable
generates.

This is the regime the proof of Stacks 0EAW enters after the finite modification of Stacks 0EAG:
by `Stacks.Chow.exists_factorization_order_ne_mvPolynomialX` the pair is prepared at `(X_i)` with
a unit part of the localization whose order of vanishing is `1`, so no result making the summands
vanish term by term applies to it. -/
theorem tameSymbolOrderAt_finsum_mvPolynomialX_eq_zero {i j : Fin 2} (hij : i ≠ j) :
    ∑ᶠ p : HeightOnePrime (MvPolynomial (Fin 2) k),
        tameSymbolOrderAt (MvPolynomial.ringKrullDim_fin_two k) p (normalHeightOneSymbol p)
          (mvPolynomialX k j) (mvPolynomialX k i) = 0 := by
  classical
  have hs : ∀ p : HeightOnePrime (MvPolynomial (Fin 2) k),
      tameSymbolOrderAt (MvPolynomial.ringKrullDim_fin_two k) p (normalHeightOneSymbol p)
          (mvPolynomialX k j) (mvPolynomialX k i) ≠ 0 →
      p ∈ ({mvPolynomialHeightOnePrimeX k i, mvPolynomialHeightOnePrimeX k j} :
        Finset (HeightOnePrime (MvPolynomial (Fin 2) k))) := by
    intro p hp
    by_cases hj : (MvPolynomial.X j : MvPolynomial (Fin 2) k) ∈ p.1.asIdeal
    · exact Finset.mem_insert_of_mem
        (Finset.mem_singleton.mpr (eq_mvPolynomialHeightOnePrimeX_of_mem k j p hj))
    · by_cases hi : (MvPolynomial.X i : MvPolynomial (Fin 2) k) ∈ p.1.asIdeal
      · rw [eq_mvPolynomialHeightOnePrimeX_of_mem k i p hi]
        exact Finset.mem_insert_self _ _
      · exact absurd (tameSymbolOrderAt_eq_zero (MvPolynomial.ringKrullDim_fin_two k) p
          (normalHeightOneSymbol p) (mvPolynomialX k j) (mvPolynomialX k i) hj hi) hp
  rw [tameSymbolOrderAt_finsum_eq_sum (MvPolynomial.ringKrullDim_fin_two k)
      normalHeightOneSymbol (mvPolynomialX k j) (mvPolynomialX k i) _ hs,
    Finset.sum_pair (mvPolynomialHeightOnePrimeX_ne k hij),
    tameSymbolOrderAt_mvPolynomialX_eq_one k hij,
    tameSymbolOrderAt_mvPolynomialX_eq_neg_one k hij]
  ring

end Stacks.Chow

end
