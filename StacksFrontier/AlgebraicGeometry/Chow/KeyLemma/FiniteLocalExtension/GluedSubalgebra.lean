module

public import StacksFrontier.AlgebraicGeometry.Chow.KeyLemma.FiniteLocalExtension.BoundedDenominator

/-!
# Gluing a finite local subalgebra

Auxiliary steps for `exists_finite_local_extension_with_prescribed_localizations`: enlarging a
finite subalgebra of the bounded-denominator algebra until it is local with the same residue
field and localizes correctly at each prime above `t`.
-/

@[expose] public section

open scoped Pointwise

universe u v w

/-- If multiplying the larger module by an ideal returns to the smaller module, then
the base ring plus the ideal times the smaller module is closed under multiplication. -/
private def subalgebraOfIdealSmul (R C : Type*) [CommRing R] [CommRing C]
    [Algebra R C] (I : Ideal R) (M M' : Submodule R C)
    (hMM : ∀ x ∈ M, ∀ y ∈ M, x * y ∈ M')
    (hIM' : I • M' ≤ M) : Subalgebra R C := by
  let N : Submodule R C := (1 : Submodule R C) ⊔ I • M
  have hsq : (I • M) * (I • M) ≤ I • M := by
    refine Submodule.mul_le.mpr ?_
    intro x hx y hy
    refine Submodule.smul_induction_on hx ?_ ?_
    · intro r hr x hx
      refine Submodule.smul_induction_on hy ?_ ?_
      · intro s hs y hy
        have hxy : x * y ∈ M' := hMM x hx y hy
        have hsy : s • (x * y) ∈ M := hIM' (Submodule.smul_mem_smul hs hxy)
        convert Submodule.smul_mem_smul hr hsy using 1;
          simp [Algebra.smul_def, mul_assoc, mul_left_comm, mul_comm]
      · intro y z ihy ihz
        simpa [mul_add] using (I • M).add_mem ihy ihz
    · intro x z ihx ihz
      simpa [add_mul] using (I • M).add_mem ihx ihz
  have hN : N * N ≤ N := by
    dsimp [N]
    rw [Submodule.sup_mul, Submodule.mul_sup, Submodule.mul_sup,
      Submodule.one_mul, Submodule.one_mul, Submodule.mul_one]
    exact sup_le (sup_le le_sup_left le_sup_right)
      (sup_le le_sup_right (hsq.trans le_sup_right))
  exact N.toSubalgebra (Submodule.mem_sup_left (by
    rw [Submodule.mem_one]
    exact ⟨1, by simp⟩))
    (fun x y hx hy => hN (Submodule.mul_mem_mul hx hy))

/-- The underlying submodule of the subalgebra generated by an ideal multiple of a module. -/
private lemma subalgebraOfIdealSmul_toSubmodule (R C : Type*) [CommRing R] [CommRing C]
    [Algebra R C] (I : Ideal R) (M M' : Submodule R C)
    (hMM : ∀ x ∈ M, ∀ y ∈ M, x * y ∈ M')
    (hIM' : I • M' ≤ M) :
    (subalgebraOfIdealSmul R C I M M' hMM hIM').toSubmodule =
      (1 : Submodule R C) ⊔ I • M := by
  unfold subalgebraOfIdealSmul
  simp

/-- Elements of the ideal shrink are sums of a base element and an ideal multiple. -/
private lemma mem_subalgebraOfIdealSmul_iff (R C : Type*) [CommRing R] [CommRing C]
    [Algebra R C] (I : Ideal R) (M M' : Submodule R C)
    (hMM : ∀ x ∈ M, ∀ y ∈ M, x * y ∈ M')
    (hIM' : I • M' ≤ M) (x : C) :
    x ∈ subalgebraOfIdealSmul R C I M M' hMM hIM' ↔
      ∃ a : R, ∃ y : C, y ∈ I • M ∧ x = algebraMap R C a + y := by
  rw [← Subalgebra.mem_toSubmodule, subalgebraOfIdealSmul_toSubmodule]
  constructor
  · intro hx
    obtain ⟨z, hz, y, hy, rfl⟩ := Submodule.mem_sup.mp hx
    obtain ⟨a, rfl⟩ := Submodule.mem_one.mp hz
    exact ⟨a, y, hy, rfl⟩
  · rintro ⟨a, y, hy, rfl⟩
    exact Submodule.mem_sup.mpr ⟨algebraMap R C a,
      Submodule.mem_one.mpr ⟨a, rfl⟩, y, hy, rfl⟩

/-- The ideal shrink of a finite submodule is finitely generated over the base ring. -/
private lemma subalgebraOfIdealSmul_toSubmodule_fg (R C : Type*) [CommRing R] [CommRing C]
    [Algebra R C] [IsNoetherianRing R] (I : Ideal R) (M M' : Submodule R C)
    (hMM : ∀ x ∈ M, ∀ y ∈ M, x * y ∈ M')
    (hIM' : I • M' ≤ M) (hM : M.FG) :
    ((subalgebraOfIdealSmul R C I M M' hMM hIM').toSubmodule).FG := by
  rw [subalgebraOfIdealSmul_toSubmodule]
  have hbase : (1 : Submodule R C).FG := by
    rw [Submodule.one_eq_range]
    exact Submodule.fg_range _
  exact hbase.sup (Submodule.FG.smul (Ideal.fg_of_isNoetherianRing I) hM)

/-- The ideal shrink of a finite submodule is finite over the base ring. -/
private lemma subalgebraOfIdealSmul_finite (R C : Type*) [CommRing R] [CommRing C]
    [Algebra R C] [IsNoetherianRing R] (I : Ideal R) (M M' : Submodule R C)
    (hMM : ∀ x ∈ M, ∀ y ∈ M, x * y ∈ M')
    (hIM' : I • M' ≤ M) (hM : M.FG) :
    Module.Finite R (subalgebraOfIdealSmul R C I M M' hMM hIM') :=
  Module.Finite.of_fg (subalgebraOfIdealSmul_toSubmodule_fg R C I M M' hMM hIM' hM)

/-- A maximal ideal of a finite algebra over a local ring contracts to the maximal ideal. -/
private lemma comap_eq_maximalIdeal_of_isMaximal (R C : Type*) [CommRing R] [IsLocalRing R]
    [CommRing C] [Algebra R C] [Module.Finite R C] (p : Ideal C) (hp : p.IsMaximal) :
    p.comap (algebraMap R C) = IsLocalRing.maximalIdeal R :=
  IsLocalRing.eq_maximalIdeal (Ideal.isMaximal_under_of_isIntegral_of_isMaximal (R := R) p)

/-- An ideal whose square lies over the maximal ideal of the base lies in every maximal ideal. -/
private lemma le_of_mul_self_le_map_maximalIdeal (R C : Type*) [CommRing R] [IsLocalRing R]
    [CommRing C] [Algebra R C] [Module.Finite R C] (J : Ideal C)
    (hJ : J * J ≤ Ideal.map (algebraMap R C) (IsLocalRing.maximalIdeal R))
    (p : Ideal C) (hp : p.IsMaximal) : J ≤ p := by
  have hpmap : Ideal.map (algebraMap R C) (IsLocalRing.maximalIdeal R) ≤ p := by
    rw [Ideal.map_le_iff_le_comap, comap_eq_maximalIdeal_of_isMaximal R C p hp]
  intro x hx
  exact (hp.isPrime.mem_or_mem (hpmap (hJ (Ideal.mul_mem_mul hx hx)))).elim id id

/-- A finite algebra is local if it is generated modulo an ideal whose square lies over the
maximal ideal of the base. -/
private lemma isLocalRing_of_square_le_maximal (R C : Type*) [CommRing R] [IsLocalRing R]
    [CommRing C] [Algebra R C] [Module.Finite R C] (J : Ideal C)
    (hJ : J * J ≤ Ideal.map (algebraMap R C) (IsLocalRing.maximalIdeal R))
    (hcover : ∀ c : C, ∃ a : R, ∃ j : C, j ∈ J ∧ c = algebraMap R C a + j)
    (hne : J ≠ ⊤) : IsLocalRing C := by
  have hJle := le_of_mul_self_le_map_maximalIdeal R C J hJ
  obtain ⟨p, hp, _⟩ := Ideal.exists_le_maximal J hne
  refine IsLocalRing.of_unique_max_ideal ⟨p, hp, fun q hq => hq.eq_of_le hp.ne_top ?_⟩
  intro x hx
  obtain ⟨a, j, hj, rfl⟩ := hcover x
  have ha : algebraMap R C a ∈ q := by
    simpa using q.sub_mem hx (hJle q hq hj)
  have hap : algebraMap R C a ∈ p := by
    show a ∈ p.comap (algebraMap R C)
    rwa [comap_eq_maximalIdeal_of_isMaximal R C p hp,
      ← comap_eq_maximalIdeal_of_isMaximal R C q hq]
  exact p.add_mem hap (hJle p hp hj)

/-- Under the same square condition, the canonical map identifies the two residue fields. -/
private lemma residueField_bijective_of_square_le_maximal (R C : Type*)
    [CommRing R] [IsLocalRing R] [CommRing C] [Algebra R C] [Module.Finite R C]
    (J : Ideal C)
    (hJ : J * J ≤ Ideal.map (algebraMap R C) (IsLocalRing.maximalIdeal R))
    (hcover : ∀ c : C, ∃ a : R, ∃ j : C, j ∈ J ∧ c = algebraMap R C a + j)
    (hne : J ≠ ⊤) :
    ∃ (_ : IsLocalRing C) (_ : IsLocalHom (algebraMap R C)),
      Function.Bijective (IsLocalRing.ResidueField.map (algebraMap R C)) := by
  have : IsLocalRing C := isLocalRing_of_square_le_maximal R C J hJ hcover hne
  have : IsLocalHom (algebraMap R C) :=
    ((IsLocalRing.local_hom_TFAE (algebraMap R C)).out 5 1).mp
      (comap_eq_maximalIdeal_of_isMaximal R C _ (IsLocalRing.maximalIdeal.isMaximal C))
  have hJmax := le_of_mul_self_le_map_maximalIdeal R C J hJ _
    (IsLocalRing.maximalIdeal.isMaximal C)
  refine ⟨inferInstance, inferInstance, ?_, ?_⟩
  · exact (IsLocalRing.ResidueField.map (algebraMap R C)).injective
  · intro z
    obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective z
    obtain ⟨a, j, hj, rfl⟩ := hcover c
    refine ⟨IsLocalRing.residue R a, ?_⟩
    rw [IsLocalRing.ResidueField.map_residue, map_add,
      (IsLocalRing.residue_eq_zero_iff j).mpr (hJmax hj), add_zero]

/-- Elements outside a prime become units in any algebra over the localization at that prime. -/
private lemma isUnit_algebraMap_primeCompl (R C : Type*) [CommRing R] [CommRing C]
    (q : Ideal R) [q.IsPrime] [Algebra (Localization.AtPrime q) C] [Algebra R C]
    [IsScalarTower R (Localization.AtPrime q) C] (s : q.primeCompl) :
    IsUnit (algebraMap R C s) := by
  rw [IsScalarTower.algebraMap_apply R (Localization.AtPrime q) C]
  exact (IsLocalization.map_units (Localization.AtPrime q) s).map _

/-- A subalgebra localizes to the ambient algebra when its denominators are units and every
ambient element acquires a numerator in the subalgebra. -/
private lemma isLocalization_of_subalgebra_denominator (R C : Type*) [CommRing R]
    [CommRing C] [Algebra R C] (S : Submonoid R) (T : Subalgebra R C)
    (hunit : ∀ s : S, IsUnit (algebraMap R C s))
    (hden : ∀ c : C, ∃ s : S, algebraMap R C s * c ∈ T) :
    IsLocalization (S.map (algebraMap R T)) C := by
  apply (isLocalization_iff (S.map (algebraMap R T)) C).mpr
  constructor
  · rintro ⟨s, hs⟩
    obtain ⟨r, hr, rfl⟩ := hs
    show IsUnit ((algebraMap R C) r)
    exact hunit ⟨r, hr⟩
  constructor
  · intro c
    obtain ⟨s, hs⟩ := hden c
    refine ⟨⟨⟨algebraMap R C s * c, hs⟩, ⟨algebraMap R T s, ⟨s, s.property, rfl⟩⟩⟩, ?_⟩
    show c * algebraMap R C s = algebraMap R C s * c
    exact mul_comm _ _
  · intro x y hxy
    have heq : x = y := Subtype.ext hxy
    subst y
    exact ⟨1, rfl⟩

/-- A finite algebra over a prime localization is the localization of a finite subalgebra over
the original ring. -/
private lemma exists_finite_subalgebra_localizing_to_finite_algebra
    (R C : Type*) [CommRing R] [CommRing C]
    (q : Ideal R) [q.IsPrime]
    [Algebra (Localization.AtPrime q) C] [Algebra R C]
    [IsScalarTower R (Localization.AtPrime q) C]
    [Module.Finite (Localization.AtPrime q) C] :
    ∃ T : Subalgebra R C, Module.Finite R T ∧
      IsLocalization (q.primeCompl.map (algebraMap R T)) C := by
  classical
  obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin
    (R := Localization.AtPrime q) (M := C)
  choose s hs using fun i : Fin n => exists_integral_multiple_atPrime R C q (g i)
  let S : Set C := Set.range (fun i : Fin n => (s i : R) • g i)
  let T : Subalgebra R C := Algebra.adjoin R S
  have hfinite : Module.Finite R T := by
    apply Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range _)
    rintro x ⟨i, rfl⟩
    exact hs i
  have hD : denominatorSubmodule R C q T = ⊤ := by
    apply top_unique
    rw [← hg]
    apply Submodule.span_le.mpr
    rintro x ⟨i, rfl⟩
    apply (mem_denominatorSubmodule_iff R C q T (g i)).mpr
    refine ⟨s i, ?_⟩
    simpa [T, Algebra.smul_def] using (Algebra.subset_adjoin (R := R) (s := S)
      ⟨i, rfl⟩)
  have hden (c : C) : ∃ s : q.primeCompl, algebraMap R C s * c ∈ T :=
    (mem_denominatorSubmodule_iff R C q T c).mp (hD.symm ▸ Submodule.mem_top)
  exact ⟨T, hfinite, isLocalization_of_subalgebra_denominator R C q.primeCompl T
    (isUnit_algebraMap_primeCompl R C q) hden⟩

/-- The bounded-denominator algebra recovers each prescribed local algebra at its prime. -/
private lemma boundedDenominatorProjection_isLocalization
    {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (t : A) {ι : Type*} [Finite ι] (q : ι → Ideal A)
    (hq : ∀ i, (q i).IsPrime)
    (hq_ne : ∀ i, q i ≠ IsLocalRing.maximalIdeal A)
    (hq_inj : Function.Injective q)
    (hV : ∀ p : Ideal A, p.IsPrime →
      (t ∈ p ↔ p = IsLocalRing.maximalIdeal A ∨ ∃ i, p = q i))
    (Bᵢ : ι → Type*) [∀ i, CommRing (Bᵢ i)]
    [∀ i, Algebra (Localization.AtPrime (q i)) (Bᵢ i)]
    [∀ i, Algebra A (Bᵢ i)]
    [∀ i, IsScalarTower A (Localization.AtPrime (q i)) (Bᵢ i)]
    (hinj : ∀ i, Function.Injective
      (algebraMap (Localization.AtPrime (q i)) (Bᵢ i)))
    (htorsion : ∀ i, ∃ n : ℕ, ∀ b : Bᵢ i, ∃ a : Localization.AtPrime (q i),
      algebraMap (Localization.AtPrime (q i)) (Bᵢ i) a =
        algebraMap A (Bᵢ i) (t ^ n) * b)
    (i : ι) :
    let D := boundedDenominatorAlgebra A
      (Localization.Away t × (∀ j, Bᵢ j)) t
    letI := (boundedDenominatorProjection A t Bᵢ i).toRingHom.toAlgebra
    IsLocalization ((q i).primeCompl.map (algebraMap A D)) (Bᵢ i) := by
  classical
  dsimp only
  let D := boundedDenominatorAlgebra A (Localization.Away t × (∀ j, Bᵢ j)) t
  let f := boundedDenominatorProjection A t Bᵢ i
  let : Algebra D (Bᵢ i) := f.toRingHom.toAlgebra
  apply (isLocalization_iff ((q i).primeCompl.map (algebraMap A D)) (Bᵢ i)).mpr
  constructor
  · rintro ⟨s, hs⟩
    obtain ⟨r, hr, rfl⟩ := hs
    exact isUnit_algebraMap_primeCompl A (Bᵢ i) (q i) ⟨r, hr⟩
  constructor
  · intro b
    obtain ⟨n, x, v, hx, hv⟩ :=
      exists_boundedDenominator_lift t q hq hq_ne hq_inj hV Bᵢ htorsion i b
    let z : D := ⟨x, n, hx⟩
    refine ⟨⟨z, ⟨algebraMap A D v, ⟨v, v.property, rfl⟩⟩⟩, ?_⟩
    show b * algebraMap A (Bᵢ i) v = f z
    rw [boundedDenominatorProjection_apply]
    simpa [ambientProjection_apply, z, f, mul_comm] using hv.symm
  · intro x y hxy
    have hz : f (x - y) = 0 := by
      change f x = f y at hxy
      rw [map_sub, hxy, sub_self]
    obtain ⟨n, hn⟩ := (x - y).property
    obtain ⟨v, hv⟩ := boundedDenominator_projection_kernel_torsion
      t q hq hq_ne hq_inj hV Bᵢ hinj i n (x - y).1 hn
      (by simpa [ambientProjection_apply, boundedDenominatorProjection_apply, f] using hz)
    refine ⟨⟨algebraMap A D v, ⟨v, v.property, rfl⟩⟩, ?_⟩
    apply sub_eq_zero.mp
    apply Subtype.ext
    simpa only [Subalgebra.coe_zero, Subalgebra.coe_sub, Subalgebra.coe_mul,
      Subalgebra.coe_algebraMap, mul_sub] using hv

/-- Pointwise denominators for a finite module can be replaced by one denominator. -/
private lemma common_denominator_of_fg
    {R C : Type*} [CommRing R] [AddCommGroup C] [Module R C]
    (S : Submonoid R) (M N : Submodule R C) (hN : N.FG)
    (h : ∀ x ∈ N, ∃ s : S, (s : R) • x ∈ M) :
    ∃ s : S, ∀ x ∈ N, (s : R) • x ∈ M := by
  classical
  obtain ⟨E, hE, hspan⟩ := Submodule.fg_def.mp hN
  let : Fintype E := hE.fintype
  choose s hs using fun x : E => h x.1 (hspan ▸ Submodule.subset_span x.property)
  let z : S := ∏ x : E, s x
  refine ⟨z, fun x hx => ?_⟩
  rw [← hspan] at hx
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
  · intro y hy
    let yy : E := ⟨y, hy⟩
    have hprod : (∏ w ∈ (Finset.univ : Finset E).erase yy, s w) * s yy = z :=
      Finset.prod_erase_mul Finset.univ s (Finset.mem_univ yy)
    rw [← hprod, Submonoid.coe_mul, mul_smul]
    exact M.smul_mem _ (hs yy)
  · simp
  · intro y w _ _ hy hw
    simpa [smul_add] using M.add_mem hy hw
  · intro a y _ hy
    rw [smul_comm (z : R) a y]
    exact M.smul_mem a hy

/-- The colon ideal records the scalars carrying the larger module back into the smaller one. -/
private lemma colon_mem_iff
    {R C : Type*} [CommRing R] [AddCommGroup C] [Module R C]
    (M N : Submodule R C) (a : R) :
    a ∈ M.colon (N : Set C) ↔ ∀ x ∈ N, a • x ∈ M := Submodule.mem_colon

/-- If a finite module quotient vanishes away from `t` and at every nonmaximal prime above
`t`, a power of the maximal ideal annihilates it. -/
private lemma maximal_pow_smul_le_of_local_denominators
    {A C : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    [AddCommGroup C] [Module A C]
    (t : A) {ι : Type*} (q : ι → Ideal A) (hqprime : ∀ i, (q i).IsPrime)
    (hV : ∀ p : Ideal A, p.IsPrime →
      (t ∈ p ↔ p = IsLocalRing.maximalIdeal A ∨ ∃ i, p = q i))
    (M N : Submodule A C) (hN : N.FG)
    (ht : ∀ x ∈ N, ∃ n : ℕ, t ^ n • x ∈ M)
    (hq : ∀ i, ∀ x ∈ N, ∃ s : A, s ∉ q i ∧ s • x ∈ M) :
    ∃ c : ℕ, (IsLocalRing.maximalIdeal A) ^ c • N ≤ M := by
  classical
  let I : Ideal A := M.colon (N : Set C)
  obtain ⟨r, hr⟩ := common_denominator_of_fg (Submonoid.powers t) M N hN
    (fun x hx => by
      obtain ⟨n, hn⟩ := ht x hx
      exact ⟨⟨t ^ n, ⟨n, rfl⟩⟩, hn⟩)
  obtain ⟨n, hn⟩ := r.property
  change t ^ n = (r : A) at hn
  have htI : t ^ n ∈ I := by
    rw [hn]
    exact (colon_mem_iff M N _).mpr hr
  have hsI (i : ι) : ∃ s : A, s ∉ q i ∧ s ∈ I := by
    let : (q i).IsPrime := hqprime i
    obtain ⟨s, hs⟩ := common_denominator_of_fg (q i).primeCompl M N hN
      (fun x hx => by
        obtain ⟨s, hsi, hs⟩ := hq i x hx
        exact ⟨⟨s, hsi⟩, hs⟩)
    exact ⟨s, s.property, (colon_mem_iff M N _).mpr hs⟩
  have hmrad : IsLocalRing.maximalIdeal A ≤ I.radical := by
    rw [Ideal.radical_eq_sInf]
    apply le_sInf
    intro p hp
    have hpt : t ∈ p := hp.2.mem_of_pow_mem n (hp.1 htI)
    rcases (hV p hp.2).mp hpt with hpm | ⟨i, hpi⟩
    · rw [hpm]
    · obtain ⟨s, hsi, hs⟩ := hsI i
      exact False.elim (hsi (hpi ▸ hp.1 hs))
  obtain ⟨c, hc⟩ := I.exists_radical_pow_le_of_fg I.radical.fg_of_isNoetherianRing
  refine ⟨c, ?_⟩
  have hmc : (IsLocalRing.maximalIdeal A) ^ c ≤ I :=
    (Ideal.pow_right_mono hmrad c).trans hc
  refine Submodule.smul_le.mpr ?_
  intro a ha x hx
  exact (colon_mem_iff M N a).mp (hmc ha) x hx

/-- A finite localized module is generated, after localization, by a finite submodule of its
source. Every source element can then be moved into that submodule by one denominator. -/
private lemma exists_fg_submodule_clearing_localization
    {R Rₛ C B : Type*} [CommRing R] [CommRing Rₛ] [Algebra R Rₛ]
    [AddCommGroup C] [Module R C]
    [AddCommGroup B] [Module R B] [Module Rₛ B] [IsScalarTower R Rₛ B]
    (S : Submonoid R) [IsLocalization S Rₛ]
    (f : C →ₗ[R] B) [IsLocalizedModule S f] [Module.Finite Rₛ B] :
    ∃ M : Submodule R C, M.FG ∧ ∀ c : C, ∃ s : S, (s : R) • c ∈ M := by
  classical
  obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin (R := Rₛ) (M := B)
  choose p hp using fun i : Fin n => IsLocalizedModule.surj S f (g i)
  let E : Set C := Set.range (fun i : Fin n => (p i).1)
  let M : Submodule R C := Submodule.span R E
  have hfg : M.FG := Submodule.fg_def.mpr ⟨E, Set.finite_range _, rfl⟩
  have htop : M.localized' Rₛ S f = ⊤ := by
    apply top_unique
    rw [← hg]
    apply Submodule.span_le.mpr
    rintro b ⟨i, rfl⟩
    apply (Submodule.mem_localized' Rₛ S f M (g i)).mpr
    refine ⟨(p i).1, Submodule.subset_span ⟨i, rfl⟩, (p i).2, ?_⟩
    exact IsLocalizedModule.mk'_eq_iff.mpr (hp i).symm
  refine ⟨M, hfg, fun c => ?_⟩
  have hc : f c ∈ M.localized' Rₛ S f := htop.symm ▸ Submodule.mem_top
  obtain ⟨m, hm, s, hms⟩ := (Submodule.mem_localized' Rₛ S f M (f c)).mp hc
  have heq : f m = f ((s : R) • c) := by
    rw [f.map_smul]
    exact IsLocalizedModule.mk'_eq_iff.mp hms
  obtain ⟨u, hu⟩ := (IsLocalizedModule.eq_iff_exists S f).mp heq
  change (u : R) • m = (u : R) • ((s : R) • c) at hu
  refine ⟨u * s, ?_⟩
  show ((u : R) * (s : R)) • c ∈ M
  rw [mul_smul, ← hu]
  exact M.smul_mem _ hm

/-- One finite submodule of the bounded-denominator algebra has all the prescribed
localizations. -/
private lemma exists_global_fg_submodule
    {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (t : A) {ι : Type*} [Finite ι] (q : ι → Ideal A)
    (hq : ∀ i, (q i).IsPrime)
    (hq_ne : ∀ i, q i ≠ IsLocalRing.maximalIdeal A)
    (hq_inj : Function.Injective q)
    (hV : ∀ p : Ideal A, p.IsPrime →
      (t ∈ p ↔ p = IsLocalRing.maximalIdeal A ∨ ∃ i, p = q i))
    (Bᵢ : ι → Type*) [∀ i, CommRing (Bᵢ i)]
    [∀ i, Algebra (Localization.AtPrime (q i)) (Bᵢ i)]
    [∀ i, Algebra A (Bᵢ i)]
    [∀ i, IsScalarTower A (Localization.AtPrime (q i)) (Bᵢ i)]
    (hinj : ∀ i, Function.Injective
      (algebraMap (Localization.AtPrime (q i)) (Bᵢ i)))
    (hfinite : ∀ i, Module.Finite (Localization.AtPrime (q i)) (Bᵢ i))
    (htorsion : ∀ i, ∃ n : ℕ, ∀ b : Bᵢ i, ∃ a : Localization.AtPrime (q i),
      algebraMap (Localization.AtPrime (q i)) (Bᵢ i) a =
        algebraMap A (Bᵢ i) (t ^ n) * b) :
    ∃ M : Submodule A (boundedDenominatorAlgebra A
      (Localization.Away t × (∀ j, Bᵢ j)) t),
      M.FG ∧
      (∀ a : A, algebraMap A _ a ∈ M) ∧
      ∀ i, ∀ x, ∃ s : A, s ∉ q i ∧ s • x ∈ M := by
  classical
  let D := boundedDenominatorAlgebra A (Localization.Away t × (∀ j, Bᵢ j)) t
  have hi (i : ι) : ∃ M : Submodule A D, M.FG ∧
      ∀ x : D, ∃ s : A, s ∉ q i ∧ s • x ∈ M := by
    let : (q i).IsPrime := hq i
    let f : D →ₐ[A] Bᵢ i := boundedDenominatorProjection A t Bᵢ i
    let : Algebra D (Bᵢ i) := f.toRingHom.toAlgebra
    have : IsLocalization ((q i).primeCompl.map (algebraMap A D)) (Bᵢ i) :=
      boundedDenominatorProjection_isLocalization t q hq hq_ne hq_inj hV Bᵢ
        hinj htorsion i
    have : Module.Finite (Localization.AtPrime (q i)) (Bᵢ i) := hfinite i
    have : IsLocalizedModule (q i).primeCompl f.toLinearMap := by
      apply isLocalizedModule_iff_isLocalization.mpr
      simpa only [Algebra.algebraMapSubmonoid] using
        (inferInstance : IsLocalization ((q i).primeCompl.map (algebraMap A D)) (Bᵢ i))
    obtain ⟨M, hM, hden⟩ := exists_fg_submodule_clearing_localization
      (Rₛ := Localization.AtPrime (q i)) (q i).primeCompl f.toLinearMap
    exact ⟨M, hM, fun x => by
      obtain ⟨s, hs⟩ := hden x
      exact ⟨s, s.property, hs⟩⟩
  choose M₀ hM₀ hden using hi
  let _ : Fintype ι := Fintype.ofFinite ι
  let M : Submodule A D := (1 : Submodule A D) ⊔ Finset.univ.sup M₀
  have hfin (s : Finset ι) : (s.sup M₀).FG := by
    induction s using Finset.induction_on with
    | empty => simpa using (Submodule.fg_bot : (⊥ : Submodule A D).FG)
    | @insert i s his ih =>
      simpa [Finset.sup_insert] using (hM₀ i).sup ih
  have hbase : (1 : Submodule A D).FG := by
    rw [Submodule.one_eq_range]
    exact Submodule.fg_range _
  refine ⟨M, hbase.sup (hfin Finset.univ), ?_, ?_⟩
  · intro a
    exact (show (1 : Submodule A D) ≤ M from le_sup_left)
      (Submodule.mem_one.mpr ⟨a, rfl⟩)
  · intro i x
    obtain ⟨s, hsi, hs⟩ := hden i x
    exact ⟨s, hsi, (show (Finset.univ.sup M₀ : Submodule A D) ≤ M from le_sup_right)
      ((Finset.le_sup (f := M₀) (Finset.mem_univ i)) hs)⟩

/-- Multiplying a bounded-denominator tuple by some power of `t` puts it in the base ring. -/
private lemma boundedDenominatorAlgebra_pow_mem_base
    (A : Type*) [CommRing A] (t : A)
    (C : Type*) [CommRing C] [Algebra A C]
    (x : boundedDenominatorAlgebra A C t) :
    ∃ n : ℕ, ∃ a : A,
      t ^ n • x = algebraMap A (boundedDenominatorAlgebra A C t) a := by
  obtain ⟨n, a, ha⟩ := x.property
  refine ⟨n, a, ?_⟩
  apply Subtype.ext
  simpa only [Algebra.smul_def, Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
    using ha.symm

/-- The product of two finitely generated submodules of an algebra is finitely generated. -/
private lemma submodule_mul_fg
    (R C : Type*) [CommRing R] [CommRing C] [Algebra R C]
    (M N : Submodule R C) (hM : M.FG) (hN : N.FG) : (M * N).FG := by
  obtain ⟨E, hE, hME⟩ := Submodule.fg_def.mp hM
  obtain ⟨F, hF, hNF⟩ := Submodule.fg_def.mp hN
  apply Submodule.fg_def.mpr
  refine ⟨E * F, hE.mul hF, ?_⟩
  rw [← hME, ← hNF, Submodule.span_mul_span]

/-- Enlarge a finite module by its pairwise products; the enlargement remains finite. -/
private lemma product_enlargement
    (R C : Type*) [CommRing R] [CommRing C] [Algebra R C]
    (M : Submodule R C) (hM : M.FG) :
    ∃ N : Submodule R C, N.FG ∧ M ≤ N ∧
      ∀ x ∈ M, ∀ y ∈ M, x * y ∈ N := by
  refine ⟨M ⊔ M * M, hM.sup (submodule_mul_fg R C M M hM hM),
    le_sup_left, ?_⟩
  exact fun x hx y hy => Submodule.mem_sup_right (Submodule.mul_mem_mul hx hy)

/-- A subalgebra with enough denominators has the same localization as its ambient algebra. -/
private lemma localization_restrict_subalgebra
    (R C B : Type*) [CommRing R] [CommRing C] [CommRing B]
    [Algebra R C] [Algebra R B]
    (S : Submonoid R) (T : Subalgebra R C) (f : C →ₐ[R] B)
    (hlocal : letI := f.toRingHom.toAlgebra
      IsLocalization (S.map (algebraMap R C)) B)
    (hden : ∀ c : C, ∃ s : S, algebraMap R C s * c ∈ T) :
    letI := ((f.comp T.val).toRingHom.toAlgebra)
    IsLocalization (S.map (algebraMap R T)) B := by
  classical
  let : Algebra C B := f.toRingHom.toAlgebra
  let : IsLocalization (S.map (algebraMap R C)) B := hlocal
  let g : T →ₐ[R] B := f.comp T.val
  let : Algebra T B := g.toRingHom.toAlgebra
  apply (isLocalization_iff (S.map (algebraMap R T)) B).mpr
  constructor
  · rintro ⟨s, hs⟩
    obtain ⟨r, hr, rfl⟩ := hs
    show IsUnit (f (algebraMap R C r))
    exact IsLocalization.map_units B
      (⟨algebraMap R C r, ⟨r, hr, rfl⟩⟩ : S.map (algebraMap R C))
  constructor
  · intro b
    obtain ⟨⟨c, s⟩, hs⟩ := IsLocalization.surj (S.map (algebraMap R C)) b
    obtain ⟨r, hr, hsr⟩ := s.property
    obtain ⟨u, hu⟩ := hden c
    let z : T := ⟨algebraMap R C u * c, hu⟩
    refine ⟨⟨z, ⟨algebraMap R T (r * u), ⟨r * u, S.mul_mem hr u.property, rfl⟩⟩⟩, ?_⟩
    show b * f (algebraMap R C (r * u)) = f (algebraMap R C u * c)
    rw [map_mul, map_mul, map_mul]
    have hs' : b * f (algebraMap R C r) = f c := by
      change b * f (s : C) = f c at hs
      rwa [← hsr] at hs
    rw [← hs']
    ring
  · intro x y hxy
    have hxyC : f (x : C) = f (y : C) := hxy
    obtain ⟨s, hs⟩ := (IsLocalization.eq_iff_exists (S.map (algebraMap R C)) B).mp hxyC
    obtain ⟨r, hr, hsr⟩ := s.property
    refine ⟨⟨algebraMap R T r, ⟨r, hr, rfl⟩⟩, ?_⟩
    apply Subtype.ext
    simpa only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, hsr] using hs

/-- Transport a localization along an algebra equivalence of its source. -/
lemma localization_equiv_source
    (R B T C : Type*) [CommRing R] [CommRing B] [CommRing T] [CommRing C]
    [Algebra R B] [Algebra R T] [Algebra R C]
    (S : Submonoid R) (e : B ≃ₐ[R] T) (f : T →ₐ[R] C)
    (hloc : letI := f.toRingHom.toAlgebra
      IsLocalization (S.map (algebraMap R T)) C) :
    letI := ((f.comp e.toAlgHom).toRingHom.toAlgebra)
    IsLocalization (S.map (algebraMap R B)) C := by
  classical
  let : Algebra T C := f.toRingHom.toAlgebra
  let : IsLocalization (S.map (algebraMap R T)) C := hloc
  let g : B →ₐ[R] C := f.comp e.toAlgHom
  let : Algebra B C := g.toRingHom.toAlgebra
  apply (isLocalization_iff (S.map (algebraMap R B)) C).mpr
  constructor
  · rintro ⟨s, hs⟩
    obtain ⟨r, hr, rfl⟩ := hs
    show IsUnit (g (algebraMap R B r))
    show IsUnit (f (e (algebraMap R B r)))
    rw [e.commutes]
    exact IsLocalization.map_units C
      (⟨algebraMap R T r, ⟨r, hr, rfl⟩⟩ : S.map (algebraMap R T))
  constructor
  · intro z
    obtain ⟨⟨x, s⟩, hs⟩ := IsLocalization.surj (S.map (algebraMap R T)) z
    obtain ⟨r, hr, hsr⟩ := s.property
    refine ⟨⟨e.symm x, ⟨algebraMap R B r, ⟨r, hr, rfl⟩⟩⟩, ?_⟩
    show z * g (algebraMap R B r) = g (e.symm x)
    show z * f (e (algebraMap R B r)) = f (e (e.symm x))
    rw [e.commutes, e.apply_symm_apply]
    change z * f (s : T) = f x at hs
    rwa [← hsr] at hs
  · intro x y hxy
    have hxyT : f (e x) = f (e y) := hxy
    obtain ⟨s, hs⟩ := (IsLocalization.eq_iff_exists (S.map (algebraMap R T)) C).mp hxyT
    obtain ⟨r, hr, hsr⟩ := s.property
    refine ⟨⟨algebraMap R B r, ⟨r, hr, rfl⟩⟩, ?_⟩
    show (algebraMap R B r) * x = (algebraMap R B r) * y
    apply e.injective
    simpa only [map_mul, e.commutes, hsr] using hs

/-- Products of two elements in the shrunken module lie in the maximal ideal times the
shrunken algebra. -/
private lemma shrink_square_le_maximal_smul
    (R C : Type*) [CommRing R] [IsLocalRing R] [CommRing C] [Algebra R C]
    (c : ℕ) (M N : Submodule R C)
    (hMM : ∀ x ∈ M, ∀ y ∈ M, x * y ∈ N)
    (hpow : (IsLocalRing.maximalIdeal R) ^ c • N ≤ M) :
    let I : Ideal R := (IsLocalRing.maximalIdeal R) ^ (c + 1)
    let hIN : I • N ≤ M :=
      (Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ c))).trans hpow
    let T := subalgebraOfIdealSmul R C I M N hMM hIN
    (I • M) * (I • M) ≤ (IsLocalRing.maximalIdeal R) • T.toSubmodule := by
  dsimp only
  let m : Ideal R := IsLocalRing.maximalIdeal R
  let I : Ideal R := m ^ (c + 1)
  let hIN : I • N ≤ M :=
    (Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ c))).trans hpow
  let T := subalgebraOfIdealSmul R C I M N hMM hIN
  have hK : I • M ≤ T.toSubmodule := by
    rw [subalgebraOfIdealSmul_toSubmodule]
    exact le_sup_right
  apply Submodule.mul_le.mpr
  intro x hx y hy
  refine Submodule.smul_induction_on hx ?_ ?_
  · intro a ha x hx
    refine Submodule.smul_induction_on hy ?_ ?_
    · intro b hb y hy
      have hxy : x * y ∈ N := hMM x hx y hy
      have ha' : a ∈ m ^ c * m := by simpa [I, pow_succ] using ha
      refine Submodule.mul_induction_on ha' ?_ ?_
      · intro r hr s hs
        have hsmall : r • (x * y) ∈ M := hpow (Submodule.smul_mem_smul hr hxy)
        have hT : b • (r • (x * y)) ∈ T.toSubmodule :=
          hK (Submodule.smul_mem_smul hb hsmall)
        have hfinal : s • (b • (r • (x * y))) ∈ m • T.toSubmodule :=
          Submodule.smul_mem_smul hs hT
        convert hfinal using 1
        simp [Algebra.smul_def]
        ring
      · intro a₁ a₂ h₁ h₂
        simpa [add_smul, add_mul] using
          (m • T.toSubmodule).add_mem h₁ h₂
    · intro y₁ y₂ h₁ h₂
      simpa [mul_add] using (m • T.toSubmodule).add_mem h₁ h₂
  · intro x₁ x₂ h₁ h₂
    simpa [add_mul] using (m • T.toSubmodule).add_mem h₁ h₂

/-- The ideal shrink is local and has the same residue field as the base. -/
private lemma shrink_local_residue
    (R C : Type*) [CommRing R] [IsLocalRing R] [CommRing C] [Algebra R C]
    (c : ℕ) (M N : Submodule R C)
    (hMM : ∀ x ∈ M, ∀ y ∈ M, x * y ∈ N)
    (hpow : (IsLocalRing.maximalIdeal R) ^ c • N ≤ M)
    (hfinite : Module.Finite R
      (subalgebraOfIdealSmul R C ((IsLocalRing.maximalIdeal R) ^ (c + 1)) M N hMM
        ((Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ c))).trans hpow)))
    (hinj : Function.Injective (algebraMap R
      (subalgebraOfIdealSmul R C ((IsLocalRing.maximalIdeal R) ^ (c + 1)) M N hMM
        ((Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ c))).trans hpow)))) :
    let T := subalgebraOfIdealSmul R C ((IsLocalRing.maximalIdeal R) ^ (c + 1))
      M N hMM ((Submodule.smul_mono_left
        (Ideal.pow_le_pow_right (Nat.le_succ c))).trans hpow)
    ∃ (_ : IsLocalRing T) (_ : IsLocalHom (algebraMap R T)),
      Function.Bijective (IsLocalRing.ResidueField.map (algebraMap R T)) := by
  classical
  dsimp only
  let m : Ideal R := IsLocalRing.maximalIdeal R
  let I : Ideal R := m ^ (c + 1)
  let hIN : I • N ≤ M :=
    (Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ c))).trans hpow
  let T := subalgebraOfIdealSmul R C I M N hMM hIN
  let K : Submodule R C := I • M
  have hK : K ≤ T.toSubmodule := by
    rw [subalgebraOfIdealSmul_toSubmodule]
    exact le_sup_right
  let J : Ideal T := Ideal.span {x : T | (x : C) ∈ K}
  have hcover : ∀ b : T, ∃ a : R, ∃ j : T,
      j ∈ J ∧ b = algebraMap R T a + j := by
    intro b
    obtain ⟨a, y, hy, hby⟩ :=
      (mem_subalgebraOfIdealSmul_iff R C I M N hMM hIN b).mp b.property
    let j : T := ⟨y, hK hy⟩
    exact ⟨a, j, Ideal.subset_span (show (j : C) ∈ K from hy), Subtype.ext hby⟩
  have hmap (z : T) (hz : (z : C) ∈ m • T.toSubmodule) :
      z ∈ Ideal.map (algebraMap R T) m := by
    have hz' : z ∈ m • (⊤ : Submodule R T) :=
      (Submodule.mem_smul_top_iff m T.toSubmodule z).mpr hz
    refine Submodule.smul_induction_on hz' ?_ ?_
    · intro a ha b _
      rw [Algebra.smul_def]
      exact Ideal.mul_mem_right b _ (Ideal.mem_map_of_mem _ ha)
    · exact fun x y hx hy => Ideal.add_mem _ hx hy
  have hJ : J * J ≤ Ideal.map (algebraMap R T) m := by
    rw [Ideal.span_mul_span]
    apply Ideal.span_le.mpr
    rintro z ⟨x, hx, y, hy, rfl⟩
    exact hmap (x * y)
      (shrink_square_le_maximal_smul R C c M N hMM hpow (Submodule.mul_mem_mul hx hy))
  have hmnot : Ideal.map (algebraMap R T) m ≠ ⊤ := by
    intro hm
    let : Module.Finite R T := hfinite
    have hmint : (algebraMap R T).IsIntegral := fun x => IsIntegral.of_finite R x
    have hmR : m = ⊤ :=
      (Ideal.map_eq_top_iff (algebraMap R T) hinj hmint).mp hm
    exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top hmR
  have hJnot : J ≠ ⊤ := by
    intro htop
    apply hmnot
    apply top_le_iff.mp
    simpa [htop] using hJ
  exact residueField_bijective_of_square_le_maximal R T J hJ hcover hJnot

/-- A subalgebra of the bounded-denominator algebra that is finite as a module has a common
`t`-power denominator. -/
private lemma exists_pow_torsion_of_fg {A C : Type*} [CommRing A] [CommRing C] [Algebra A C]
    (t : A) (T : Subalgebra A (boundedDenominatorAlgebra A C t)) (hTfg : T.toSubmodule.FG) :
    ∃ n : ℕ, ∀ b : T, ∃ a : A, algebraMap A T a = algebraMap A T (t ^ n) * b := by
  obtain ⟨r, hr⟩ := common_denominator_of_fg (Submonoid.powers t)
    (1 : Submodule A (boundedDenominatorAlgebra A C t)) T.toSubmodule hTfg
    (fun x _ => by
      obtain ⟨n, a, ha⟩ := boundedDenominatorAlgebra_pow_mem_base A t C x
      exact ⟨⟨t ^ n, ⟨n, rfl⟩⟩, Submodule.mem_one.mpr ⟨a, ha.symm⟩⟩)
  obtain ⟨n, hn⟩ := r.property
  change t ^ n = (r : A) at hn
  refine ⟨n, fun b => ?_⟩
  obtain ⟨a, ha⟩ := Submodule.mem_one.mp (hr b b.property)
  refine ⟨a, Subtype.ext ?_⟩
  show algebraMap A (boundedDenominatorAlgebra A C t) a =
    algebraMap A (boundedDenominatorAlgebra A C t) (t ^ n) *
      (b : boundedDenominatorAlgebra A C t)
  rw [hn]
  simpa only [Algebra.smul_def] using ha

/-- A prime of a local ring other than the maximal ideal misses every power of the maximal
ideal. -/
private lemma exists_mem_maximalIdeal_pow_notMem {A : Type*} [CommRing A] [IsLocalRing A]
    (p : Ideal A) (hp : p.IsPrime) (hne : p ≠ IsLocalRing.maximalIdeal A) (c : ℕ) :
    ∃ a ∈ IsLocalRing.maximalIdeal A ^ c, a ∉ p := by
  obtain ⟨a, ham, hap⟩ := SetLike.not_le_iff_exists.mp fun h =>
    hne (le_antisymm (IsLocalRing.le_maximalIdeal hp.ne_top) h)
  exact ⟨a ^ c, Ideal.pow_mem_pow ham _, fun h => hap (hp.mem_of_pow_mem _ h)⟩

/-- The finite module and colon ideal construction produces a finite algebra carrying all
prescribed localizations. -/
lemma exists_finite_glued_subalgebra
    {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (t : A) (ht : IsSMulRegular A t)
    {ι : Type*} [Finite ι] (q : ι → Ideal A) (hq : ∀ i, (q i).IsPrime)
    (hq_ne : ∀ i, q i ≠ IsLocalRing.maximalIdeal A) (hq_inj : Function.Injective q)
    (hV : ∀ p : Ideal A, p.IsPrime →
      (t ∈ p ↔ p = IsLocalRing.maximalIdeal A ∨ ∃ i, p = q i))
    (Bᵢ : ι → Type*) [∀ i, CommRing (Bᵢ i)]
    [∀ i, Algebra (Localization.AtPrime (q i)) (Bᵢ i)]
    [∀ i, Algebra A (Bᵢ i)]
    [∀ i, IsScalarTower A (Localization.AtPrime (q i)) (Bᵢ i)]
    (hinj : ∀ i, Function.Injective
      (algebraMap (Localization.AtPrime (q i)) (Bᵢ i)))
    (hfinite : ∀ i, Module.Finite (Localization.AtPrime (q i)) (Bᵢ i))
    (htorsion : ∀ i, ∃ n : ℕ, ∀ b : Bᵢ i, ∃ a : Localization.AtPrime (q i),
      algebraMap (Localization.AtPrime (q i)) (Bᵢ i) a =
        algebraMap A (Bᵢ i) (t ^ n) * b) :
    ∃ T : Subalgebra A (boundedDenominatorAlgebra A
      (Localization.Away t × (∀ j, Bᵢ j)) t),
      Module.Finite A T ∧ Function.Injective (algebraMap A T) ∧
      ∃ (_ : IsLocalRing T) (_ : IsLocalHom (algebraMap A T)),
        Function.Bijective (IsLocalRing.ResidueField.map (algebraMap A T)) ∧
        (∃ n : ℕ, ∀ b : T, ∃ a : A,
          algebraMap A T a = algebraMap A T (t ^ n) * b) ∧
        ∃ ℓ : ∀ i, T →ₐ[A] Bᵢ i, ∀ i,
          letI := (ℓ i).toRingHom.toAlgebra
          IsLocalization ((q i).primeCompl.map (algebraMap A T)) (Bᵢ i) := by
  classical
  let D := boundedDenominatorAlgebra A (Localization.Away t × (∀ j, Bᵢ j)) t
  obtain ⟨M, hMfg, hMbase, hMden⟩ :=
    exists_global_fg_submodule t q hq hq_ne hq_inj hV Bᵢ hinj hfinite htorsion
  obtain ⟨N, hNfg, hMN, hMM⟩ := product_enlargement A D M hMfg
  have htden (x : D) : ∃ n : ℕ, t ^ n • x ∈ M := by
    obtain ⟨n, a, ha⟩ := boundedDenominatorAlgebra_pow_mem_base A t
      (Localization.Away t × (∀ j, Bᵢ j)) x
    exact ⟨n, ha ▸ hMbase a⟩
  obtain ⟨c, hc⟩ := maximal_pow_smul_le_of_local_denominators t q hq hV M N hNfg
    (fun x _ => htden x) (fun i x _ => hMden i x)
  let I : Ideal A := (IsLocalRing.maximalIdeal A) ^ (c + 1)
  have hIN : I • N ≤ M :=
    (Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ c))).trans hc
  let T : Subalgebra A D := subalgebraOfIdealSmul A D I M N hMM hIN
  have hTfinite : Module.Finite A T :=
    subalgebraOfIdealSmul_finite A D I M N hMM hIN hMfg
  have hTfg : T.toSubmodule.FG :=
    subalgebraOfIdealSmul_toSubmodule_fg A D I M N hMM hIN hMfg
  have hTinj : Function.Injective (algebraMap A T) := fun a b hab =>
    ambient_algebraMap_injective t ht Bᵢ
      (congrArg (fun x : T => (x : Localization.Away t × (∀ j, Bᵢ j))) hab)
  let ℓ (i : ι) : T →ₐ[A] Bᵢ i :=
    (boundedDenominatorProjection A t Bᵢ i).comp T.val
  have hloc (i : ι) :
      let := (ℓ i).toRingHom.toAlgebra
      IsLocalization ((q i).primeCompl.map (algebraMap A T)) (Bᵢ i) := by
    let : (q i).IsPrime := hq i
    have hDloc := boundedDenominatorProjection_isLocalization
      t q hq hq_ne hq_inj hV Bᵢ hinj htorsion i
    apply localization_restrict_subalgebra A D (Bᵢ i) (q i).primeCompl T
      (boundedDenominatorProjection A t Bᵢ i) hDloc
    intro x
    obtain ⟨s, hsi, hs⟩ := hMden i x
    obtain ⟨a, haI, hai⟩ := exists_mem_maximalIdeal_pow_notMem (q i) (hq i) (hq_ne i) (c + 1)
    refine ⟨⟨a * s, (hq i).mul_notMem hai hsi⟩, ?_⟩
    have hmem : algebraMap A D (a * s) * x ∈ I • M := by
      convert Submodule.smul_mem_smul haI hs using 1
      simp only [Algebra.smul_def, map_mul]
      ring
    show algebraMap A D (a * s) * x ∈ T
    rw [← Subalgebra.mem_toSubmodule, subalgebraOfIdealSmul_toSubmodule]
    exact (show I • M ≤ (1 : Submodule A D) ⊔ I • M from le_sup_right) hmem
  obtain ⟨hTlocal, hTlocalHom, hTresidue⟩ :=
    shrink_local_residue A D c M N hMM hc hTfinite hTinj
  exact ⟨T, hTfinite, hTinj, hTlocal, hTlocalHom, hTresidue,
    exists_pow_torsion_of_fg t T hTfg, ℓ, hloc⟩
