/-!
# Good sequences at a minimal point of the support

For a finite module over a Noetherian commutative ring and a minimal point of its support,
there is a finite sequence whose successive spans have factors isomorphic to the corresponding
prime quotient. After quotienting by the whole span, that point is no longer in the support,
and the number of terms is the length of the localized module.

The sequence is produced one entry at a time: at a minimal point of the support the prime is
associated, so the prime quotient embeds into the module, and the image of a generator of that
copy provides the next entry. Each step drops the localized length by exactly one, which is
what bounds the number of steps.

## Main results

* `Module.FiniteLength.exists_sequence_with_successive_quotients_at_minimal_support`
  constructs the required sequence and identifies its length.

## Implementation notes

The span before an index is `Module.FiniteLength.spanBefore`. The numerator of the
corresponding successive factor is its supremum with the cyclic submodule generated by the
current entry. Its quotient by the preceding span is expressed by restricting that span to the
numerator. Isomorphism of modules is recorded by nonemptiness of the type of linear
equivalences.

## References

* [Stacks Project, Tag 02QC](https://stacks.math.columbia.edu/tag/02QC)
-/

public section

namespace Module.FiniteLength

universe u v

/-- At a minimal point of the support, the prime quotient embeds into the module: the prime is
then an associated prime. -/
private theorem exists_inj_quotient_of_minimal
    {R : Type u} {M : Type v} [CommRing R] [IsNoetherianRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (q : PrimeSpectrum R) (hq : Minimal (· ∈ Module.support R M) q) :
    ∃ f : R ⧸ q.asIdeal →ₗ[R] M, Function.Injective f :=
  ((isAssociatedPrime_iff_exists_injective_linearMap (I := q.asIdeal) (M := M)).mp
    (Module.mem_associatedPrimes_of_minimal_mem_support hq)).2

/-- The localization of a prime quotient at that prime is the residue field, of length one. -/
public theorem localized_length_quotient_at_prime_one
    {R : Type u} [CommRing R] (q : Ideal R) [q.IsPrime] :
    Module.length (Localization.AtPrime q) (LocalizedModule q.primeCompl (R ⧸ q)) = 1 := by
  have e := IsLocalizedModule.linearEquiv q.primeCompl
    (LocalizedModule.mkLinearMap q.primeCompl (R ⧸ q))
    (Submodule.toLocalizedQuotient' (Localization.AtPrime q) q.primeCompl
      (Algebra.linearMap R (Localization.AtPrime q)) q)
  have hmax : Submodule.localized' (Localization.AtPrime q) q.primeCompl
      (Algebra.linearMap R (Localization.AtPrime q)) q
      = IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
    rw [Ideal.localized'_eq_map, IsLocalization.AtPrime.map_eq_maximalIdeal]
  have hsimple : IsSimpleModule (Localization.AtPrime q)
      (Localization.AtPrime q ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime q)) :=
    isSimpleModule_iff_quot_maximal.mpr
      ⟨_, IsLocalRing.maximalIdeal.isMaximal _, ⟨LinearEquiv.refl _ _⟩⟩
  have hs : IsSimpleModule (Localization.AtPrime q)
      (LocalizedModule q.primeCompl (R ⧸ q)) :=
    IsSimpleModule.congr
      ((LinearEquiv.extendScalarsOfIsLocalization q.primeCompl (Localization.AtPrime q) e).trans
        (Submodule.quotEquivOfEq _ _ hmax))
  exact Module.length_eq_one _ _

/-- Localization is exact, so localized length is additive along a short exact sequence. -/
private theorem length_localized_add_of_exact
    {R : Type u} [CommRing R] (S : Submonoid R) {A B C : Type*}
    [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B] [AddCommGroup C] [Module R C]
    (f : A →ₗ[R] B) (g : B →ₗ[R] C) (hf : Function.Injective f)
    (hg : Function.Surjective g) (H : Function.Exact f g) :
    Module.length (Localization S) (LocalizedModule S B) =
      Module.length (Localization S) (LocalizedModule S A) +
        Module.length (Localization S) (LocalizedModule S C) :=
  Module.length_eq_add_of_exact (LocalizedModule.map S f) (LocalizedModule.map S g)
    (LocalizedModule.map_injective S _ hf) (LocalizedModule.map_surjective S _ hg)
    (LocalizedModule.map_exact S _ _ H)

/-- Localized length is invariant under a linear equivalence. -/
private theorem length_localized_congr
    {R : Type u} [CommRing R] (S : Submonoid R) {A B : Type*}
    [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B] (e : A ≃ₗ[R] B) :
    Module.length (Localization S) (LocalizedModule S A) =
      Module.length (Localization S) (LocalizedModule S B) :=
  (LinearEquiv.ofBijective (LocalizedModule.map S e.toLinearMap)
    ⟨LocalizedModule.map_injective S _ e.injective,
      LocalizedModule.map_surjective S _ e.surjective⟩).length_eq

/-- The successive factor cut out by one entry is isomorphic to the prime quotient, and also
to the image of the enlarged submodule in the quotient. -/
private theorem factor_equiv_of_injective
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
    (q : Ideal R) [q.IsPrime] (N : Submodule R M)
    (f : R ⧸ q →ₗ[R] M ⧸ N) (hf : Function.Injective f)
    (x : M) (hx : N.mkQ x = f (Ideal.Quotient.mk q 1)) :
    Nonempty (((N ⊔ (Submodule.span R {x} : Submodule R M) : Submodule R M) ⧸
        N.submoduleOf (N ⊔ (Submodule.span R {x} : Submodule R M))) ≃ₗ[R] R ⧸ q) ∧
      Nonempty (((N ⊔ (Submodule.span R {x} : Submodule R M) : Submodule R M) ⧸
        N.submoduleOf (N ⊔ (Submodule.span R {x} : Submodule R M))) ≃ₗ[R]
        (N ⊔ (Submodule.span R {x} : Submodule R M)).map N.mkQ) := by
  let N' : Submodule R M := N ⊔ (Submodule.span R {x} : Submodule R M)
  let g : N' →ₗ[R] M ⧸ N := N.mkQ.comp N'.subtype
  have hker : LinearMap.ker g = N.submoduleOf N' := by
    ext z
    simp [g, N', Submodule.submoduleOf]
  have hmap : LinearMap.range g = N'.map N.mkQ := by
    simpa [g] using LinearMap.range_comp N'.subtype N.mkQ
  have hrange : LinearMap.range g = LinearMap.range f := by
    calc
      LinearMap.range g = N'.map N.mkQ := hmap
      _ = Submodule.span R {N.mkQ x} := by
        simp [N', Submodule.map_sup, Submodule.map_span]
      _ = LinearMap.range f := by
        rw [← Submodule.map_top f, ← Ideal.Quotient.span_singleton_one q,
          Submodule.map_span, Set.image_singleton]
        simpa using congrArg (fun y => (R ∙ y : Submodule R (M ⧸ N))) hx
  let e0 : (N' ⧸ N.submoduleOf N') ≃ₗ[R] LinearMap.range g :=
    (Submodule.quotEquivOfEq _ _ hker).symm.trans g.quotKerEquivRange
  let eF : LinearMap.range f ≃ₗ[R] R ⧸ q :=
    ((Submodule.equivMapOfInjective f hf ⊤).trans
      (LinearEquiv.ofEq _ _ (Submodule.map_top f))).symm.trans Submodule.topEquiv
  exact ⟨⟨(e0.trans (LinearEquiv.ofEq _ _ hrange)).trans eF⟩,
    ⟨e0.trans (LinearEquiv.ofEq _ _ hmap)⟩⟩

/-- At a minimal point of the support, the localized module has finite length: a prime
filtration counts it. -/
@[ega "IV 3.1.4" "partial"]
private theorem localized_length_ne_top_at_minimal
    {R : Type u} {M : Type v} [CommRing R] [IsNoetherianRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (q : PrimeSpectrum R) (hq : Minimal (· ∈ Module.support R M) q) :
    Module.length (Localization.AtPrime q.asIdeal)
      (LocalizedModule q.asIdeal.primeCompl M) ≠ ⊤ := by
  obtain ⟨s, hbot, htop⟩ :=
    IsNoetherianRing.exists_relSeries_isQuotientEquivQuotientPrime R M
  choose p hp using fun i => (s.step i).2
  have h := (Module.setOf_minimal_range_eq_setOf_minimal_support_and_ncard_eq_length
    s p (fun i => (s.step i).1) hp hbot htop).2 q hq
  rw [← h]
  exact ENat.natCast_ne_top _

/-- Nothing precedes the first entry of a sequence built by `Fin.cons`. -/
private theorem spanBefore_cons_zero
    {R : Type u} {M : Type v} [Ring R] [AddCommGroup M] [Module R M]
    {n : ℕ} (x : M) (y : Fin n → M) :
    spanBefore (R := R) (Fin.cons x y) 0 = ⊥ := by
  simp [spanBefore]

/-- The span before a later entry of a sequence built by `Fin.cons` adds the first entry. -/
private theorem spanBefore_cons_succ
    {R : Type u} {M : Type v} [Ring R] [AddCommGroup M] [Module R M]
    {n : ℕ} (x : M) (y : Fin n → M) (i : Fin n) :
    spanBefore (R := R) (Fin.cons x y) i.succ =
      (R ∙ x : Submodule R M) ⊔ spanBefore (R := R) y i := by
  classical
  unfold spanBefore
  have himage : Fin.cons x y '' Set.Iio i.succ = insert x (y '' Set.Iio i) := by
    ext z
    simp [Fin.exists_fin_succ, eq_comm]
  rw [himage, Submodule.span_insert]

/-- The inductive construction: starting from a submodule whose quotient has localized length
`n` at a minimal point of its support, one can peel off `n` copies of the prime quotient. -/
private theorem exists_sequence_from_submodule
    {R : Type u} {M : Type v} [CommRing R] [IsNoetherianRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (q : PrimeSpectrum R) (N : Submodule R M) (n : ℕ)
    (hlen : Module.length (Localization.AtPrime q.asIdeal)
      (LocalizedModule q.asIdeal.primeCompl (M ⧸ N)) = n)
    (hmin : 0 < n → Minimal (· ∈ Module.support R (M ⧸ N)) q) :
    ∃ x : Fin n → M,
      (∀ i : Fin n,
        Nonempty
          ((((N ⊔ spanBefore (R := R) x i) ⊔
              (R ∙ x i : Submodule R M) : Submodule R M) ⧸
            (N ⊔ spanBefore (R := R) x i).comap
              (((N ⊔ spanBefore (R := R) x i) ⊔
                  (R ∙ x i : Submodule R M) : Submodule R M)).subtype) ≃ₗ[R]
            R ⧸ q.asIdeal)) ∧
      q ∉ Module.support R (M ⧸ (N ⊔ Submodule.span R (Set.range x))) := by
  classical
  induction n generalizing N with
  | zero =>
      refine ⟨Fin.elim0, fun i => i.elim0, ?_⟩
      rw [show Submodule.span R (Set.range (Fin.elim0 : Fin 0 → M)) = ⊥ by simp, sup_bot_eq]
      exact Module.notMem_support_iff.mpr (Module.length_eq_zero_iff.mp (by simpa using hlen))
  | succ n ih =>
      have hq := hmin (Nat.succ_pos _)
      obtain ⟨x, eFactor, hlen', hsupp⟩ : ∃ x : M,
          Nonempty (((N ⊔ (R ∙ x : Submodule R M) : Submodule R M) ⧸
            N.submoduleOf (N ⊔ (R ∙ x : Submodule R M))) ≃ₗ[R] R ⧸ q.asIdeal) ∧
          Module.length (Localization.AtPrime q.asIdeal)
            (LocalizedModule q.asIdeal.primeCompl (M ⧸ (N ⊔ (R ∙ x : Submodule R M)))) = n ∧
          Module.support R (M ⧸ (N ⊔ (R ∙ x : Submodule R M))) ⊆ Module.support R (M ⧸ N) := by
        obtain ⟨f, hf⟩ := exists_inj_quotient_of_minimal q hq
        obtain ⟨x, hx⟩ := Submodule.mkQ_surjective N (f (Ideal.Quotient.mk q.asIdeal 1))
        let N' : Submodule R M := N ⊔ (R ∙ x : Submodule R M)
        obtain ⟨eFactor, eU⟩ := factor_equiv_of_injective q.asIdeal N f hf x hx
        let U : Submodule R (M ⧸ N) := N'.map N.mkQ
        have hUlen : Module.length (Localization.AtPrime q.asIdeal)
              (LocalizedModule q.asIdeal.primeCompl U) = 1 := by
          rw [length_localized_congr q.asIdeal.primeCompl (eU.some.symm.trans eFactor.some)]
          exact localized_length_quotient_at_prime_one q.asIdeal
        have eQ : ((M ⧸ N) ⧸ U) ≃ₗ[R] M ⧸ N' := by
          simpa [U, N'] using (Submodule.quotientQuotientEquivQuotient N N' le_sup_left)
        have hsum : (n : ℕ∞) + 1 =
            Module.length (Localization.AtPrime q.asIdeal)
              (LocalizedModule q.asIdeal.primeCompl (M ⧸ N')) + 1 := by
          calc
            (n : ℕ∞) + 1 = Module.length (Localization.AtPrime q.asIdeal)
                (LocalizedModule q.asIdeal.primeCompl (M ⧸ N)) := by
                  simpa [Nat.cast_add] using hlen.symm
            _ = Module.length (Localization.AtPrime q.asIdeal)
                  (LocalizedModule q.asIdeal.primeCompl U) +
                Module.length (Localization.AtPrime q.asIdeal)
                  (LocalizedModule q.asIdeal.primeCompl ((M ⧸ N) ⧸ U)) :=
              length_localized_add_of_exact q.asIdeal.primeCompl U.subtype U.mkQ
                (Submodule.subtype_injective _) (Submodule.mkQ_surjective U)
                (LinearMap.exact_subtype_mkQ U)
            _ = _ := by rw [hUlen, length_localized_congr q.asIdeal.primeCompl eQ, add_comm]
        have hsupp : Module.support R (M ⧸ N') ⊆ Module.support R (M ⧸ N) := by
          rw [← LinearEquiv.support_eq eQ]
          exact Module.support_subset_of_surjective U.mkQ (Submodule.mkQ_surjective U)
        exact ⟨x, eFactor, (ENat.add_left_injective_of_ne_top (ENat.natCast_ne_top 1) hsum).symm,
          hsupp⟩
      set N' : Submodule R M := N ⊔ (R ∙ x : Submodule R M)
      have hmin' : 0 < n → Minimal (· ∈ Module.support R (M ⧸ N')) q := by
        intro hn
        have hlen_ne_zero : Module.length (Localization.AtPrime q.asIdeal)
              (LocalizedModule q.asIdeal.primeCompl (M ⧸ N')) ≠ 0 := by
          rw [hlen']
          exact Nat.cast_ne_zero.mpr (Nat.ne_of_gt hn)
        have hnontriv : Nontrivial (LocalizedModule q.asIdeal.primeCompl (M ⧸ N')) :=
          not_subsingleton_iff_nontrivial.mp fun hsub =>
            hlen_ne_zero (Module.length_eq_zero_iff.mpr hsub)
        exact ⟨Module.mem_support_iff.mpr hnontriv, fun p hp hpq => hq.2 (hsupp hp) hpq⟩
      obtain ⟨y, hyfac, hysupp⟩ := ih N' hlen' hmin'
      refine ⟨Fin.cons x y, fun i => ?_, ?_⟩
      · refine Fin.cases ?_ (fun j => ?_) i
        · rw [spanBefore_cons_zero, sup_bot_eq, Fin.cons_zero]
          simpa [N', Submodule.submoduleOf] using eFactor
        · rw [Fin.cons_succ, spanBefore_cons_succ, ← sup_assoc]
          simpa [N'] using hyfac j
      · rw [Fin.range_cons, Submodule.span_insert, ← sup_assoc]
        exact hysupp

/-- **Stacks Project, Tag 02QC.** At a minimal point `q` of the support of a finite module
`M`, one can successively remove copies of `R / q` until `q` is absent from the support. The
number of copies is the length of the localization of `M` at `q`. -/
@[stacks 02QC]
theorem exists_sequence_with_successive_quotients_at_minimal_support
    {R : Type u} {M : Type v} [CommRing R] [IsNoetherianRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (q : PrimeSpectrum R) (hq : Minimal (· ∈ Module.support R M) q) :
    ∃ (l : ℕ) (x : Fin l → M),
      q ∉ Module.support R (M ⧸ Submodule.span R (Set.range x)) ∧
      (∀ i : Fin l,
        Nonempty
          (((spanBefore (R := R) x i ⊔ R ∙ x i : Submodule R M) ⧸
              (spanBefore (R := R) x i).comap
                (spanBefore (R := R) x i ⊔ R ∙ x i : Submodule R M).subtype) ≃ₗ[R]
            R ⧸ q.asIdeal)) ∧
      l = (Module.length (Localization.AtPrime q.asIdeal)
        (LocalizedModule q.asIdeal.primeCompl M)).toNat := by
  classical
  let l := (Module.length (Localization.AtPrime q.asIdeal)
    (LocalizedModule q.asIdeal.primeCompl M)).toNat
  let e : (M ⧸ (⊥ : Submodule R M)) ≃ₗ[R] M := (⊥ : Submodule R M).quotEquivOfEqBot rfl
  have hlen : Module.length (Localization.AtPrime q.asIdeal)
        (LocalizedModule q.asIdeal.primeCompl (M ⧸ (⊥ : Submodule R M))) = l :=
    (length_localized_congr q.asIdeal.primeCompl e).trans
      (ENat.natCast_toNat (localized_length_ne_top_at_minimal q hq)).symm
  have hqbot : Minimal (· ∈ Module.support R (M ⧸ (⊥ : Submodule R M))) q := by
    simpa only [LinearEquiv.support_eq e] using hq
  obtain ⟨x, hfac, hsupp⟩ := exists_sequence_from_submodule q ⊥ l hlen (fun _ => hqbot)
  refine ⟨l, x, by rwa [bot_sup_eq] at hsupp, fun i => ?_, rfl⟩
  have hi := hfac i
  rw [bot_sup_eq] at hi
  simpa [Submodule.submoduleOf] using hi

end Module.FiniteLength
