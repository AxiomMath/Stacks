/-!
# Factors `R / q` under operations, maps and quotients

Let `q` be a prime of a Noetherian local ring. For a sequence in a module, the property that the
scalars carrying each entry into the span of its predecessors are exactly the elements of `q`
says that its successive factors are `R / q`. This file shows that the property is preserved
by the elementary operations on the sequence, along injective linear maps and on passing to the
quotient by the first entry; it relates admissibility and generation before and after
localization at `q`; and it produces pivots: for a filtration by copies of `R / q`, every
nonzero element is, modulo an earlier span, a multiple of one entry by a scalar outside `q`.

## Main results

* `Module.FiniteLength.span_localized_generators_eq_top`: a generating family localizes to a
  generating family.
* `Module.FiniteLength.symbol_ne_zero_of_generating`: the symbol of a generating admissible
  sequence of a finite-length module is nonzero.
* `Module.FiniteLength.admissible_localized`: a sequence whose entries are killed into the span
  of their predecessors by every element of `q` localizes to an admissible sequence.

## References

* [Stacks Project, Tag 02QB](https://stacks.math.columbia.edu/tag/02QB)
-/

@[expose] public section

noncomputable section

namespace Module.FiniteLength

universe u v w

/-- A generating family localizes to a generating family. -/
public theorem span_localized_generators_eq_top
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    (S : Submonoid R) {ι : Type*} (x : ι → M)
    (hx : Submodule.span R (Set.range x) = ⊤) :
    Submodule.span (Localization S) (Set.range (fun i => LocalizedModule.mk (x i) (1 : S))) =
      ⊤ := by
  have h := congrArg
    (Submodule.localized' (Localization S) S (LocalizedModule.mkLinearMap S M)) hx
  rw [Submodule.localized'_span, Submodule.localized'_top] at h
  simpa only [← Set.range_comp, Function.comp_def, LocalizedModule.mkLinearMap_apply] using h

/-- The symbol of a generating admissible sequence of a finite-length module is nonzero. -/
public theorem symbol_ne_zero_of_generating
    {R : Type*} [CommRing R] [IsLocalRing R] {M : Type*}
    [AddCommGroup M] [Module R M] (hM : IsFiniteLength R M)
    (e : AdmissibleSequence R M) (he : Submodule.span R (Set.range e.1) = ⊤) :
    symbol e ≠ 0 := by
  have hn : Nontrivial (determinant R M) :=
    Module.nontrivial_of_finrank_pos (by rw [finrank_determinant_eq_one hM]; decide)
  intro hz
  have h := span_symbol_eq_top hM e he
  rw [hz, Submodule.span_zero_singleton] at h
  exact bot_ne_top h

/-- For a cyclic module with annihilator `q`, the colength of the submodule generated by a
scalar multiple of the generator is the colength of that scalar together with `q`. -/
private theorem length_quotient_span_smul
    {R : Type*} [CommRing R] {N : Type*} [AddCommGroup N] [Module R N]
    (q : Ideal R) (y : N) (hy : R ∙ y = ⊤)
    (hann : Module.annihilator R N = q) (a : R) :
    Module.length R (N ⧸ (R ∙ (a • y))) =
      Module.length R (R ⧸ (Ideal.span {a} ⊔ q)) := by
  let g : R →ₗ[R] N := LinearMap.toSpanSingleton R N y
  have hg : Function.Surjective g := (Submodule.span_singleton_eq_top_iff R y).mp hy
  have hk : LinearMap.ker g = q := by
    rw [← Submodule.annihilator_span_singleton, hy, Submodule.annihilator_top, hann]
  have hmap : Submodule.map g (Ideal.span {a}) = R ∙ (a • y) := by
    rw [Submodule.map_span, Set.image_singleton]
    rfl
  let f := (R ∙ (a • y) : Submodule R N).mkQ.comp g
  have hf : Function.Surjective f := (Submodule.mkQ_surjective _).comp hg
  have hker : LinearMap.ker f = Ideal.span {a} ⊔ q := by
    rw [LinearMap.ker_comp, Submodule.ker_mkQ, ← hmap, Submodule.comap_map_eq, hk]
  rw [← (f.quotKerEquivOfSurjective hf).length_eq, hker]

/-- A cyclic module whose single factor is `R / q` has annihilator `q`. -/
private theorem annihilator_eq_of_singleton_factor
    {R : Type*} [CommRing R] {N : Type*} [AddCommGroup N] [Module R N]
    (q : Ideal R) (y : N) (hy : R ∙ y = ⊤)
    (he : Nonempty (((R ∙ y : Submodule R N) ⧸
      (⊥ : Submodule R (R ∙ y : Submodule R N))) ≃ₗ[R] R ⧸ q)) :
    Module.annihilator R N = q := by
  rw [hy] at he
  let e : N ≃ₗ[R] R ⧸ q := Submodule.topEquiv.symm.trans
    (((⊥ : Submodule R (⊤ : Submodule R N)).quotEquivOfEqBot rfl).symm.trans he.some)
  rw [e.annihilator_eq, Ideal.annihilator_quotient]

/-- A scalar annihilates a cyclic module exactly when it kills the generator. -/
private theorem scalar_mem_annihilator_iff_of_generator
    {R : Type*} [CommRing R] {N : Type*} [AddCommGroup N] [Module R N]
    (y : N) (hy : R ∙ y = ⊤) (a : R) :
    a ∈ Module.annihilator R N ↔ a • y = 0 := by
  rw [← Submodule.annihilator_top, ← hy, Submodule.mem_annihilator_span_singleton]

/-- Every element of the quotient of `U ⊔ R ∙ x` by `U` is a scalar multiple of the class of `x`. -/
private theorem surjective_mkQ_comp_toSpanSingleton
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    (U : Submodule R M) (x : M) :
    Function.Surjective ((U.submoduleOf (U ⊔ R ∙ x)).mkQ.comp
      (LinearMap.toSpanSingleton R (U ⊔ R ∙ x : Submodule R M)
        ⟨x, Submodule.mem_sup_right (Submodule.mem_span_singleton_self x)⟩)) := by
  intro z
  obtain ⟨b, rfl⟩ := Submodule.mkQ_surjective (U.submoduleOf (U ⊔ R ∙ x)) z
  obtain ⟨y, hy, t, ht, hyt⟩ := Submodule.mem_sup.mp b.property
  obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.mp ht
  refine ⟨r, ?_⟩
  apply (Submodule.Quotient.eq _).mpr
  change r • x - b.1 ∈ U
  rw [← hyt, show r • x - (y + r • x) = -y by abel]
  exact U.neg_mem hy

/-- When the factor cut out by one entry is `R / q`, the scalars carrying that entry into the
span of its predecessors are exactly the elements of `q`. -/
private theorem smul_mem_iff_of_cyclic_factor
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    (U : Submodule R M) (x : M) (q : Ideal R)
    (he : Nonempty (((U ⊔ R ∙ x : Submodule R M) ⧸
      U.submoduleOf (U ⊔ R ∙ x)) ≃ₗ[R] R ⧸ q)) (a : R) :
    a • x ∈ U ↔ a ∈ q := by
  let V := U ⊔ R ∙ x
  let Q := V ⧸ U.submoduleOf V
  let v : V := ⟨x, Submodule.mem_sup_right (Submodule.mem_span_singleton_self x)⟩
  let z : Q := (U.submoduleOf V).mkQ v
  have hgen : R ∙ z = ⊤ :=
    (Submodule.span_singleton_eq_top_iff R z).mpr (surjective_mkQ_comp_toSpanSingleton U x)
  have hann : Module.annihilator R Q = q :=
    he.some.annihilator_eq.trans Ideal.annihilator_quotient
  have hzero : a • z = 0 ↔ a • x ∈ U := by
    change (U.submoduleOf V).mkQ (a • v) = 0 ↔ _
    exact Submodule.Quotient.mk_eq_zero _
  rw [← hzero, ← scalar_mem_annihilator_iff_of_generator z hgen, hann]

/-- Conversely, if the scalars carrying an entry into a submodule are exactly `q`, the factor
is isomorphic to `R / q`. -/
private theorem cyclic_factor_equiv_of_smul_mem_iff
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    (U : Submodule R M) (x : M) (q : Ideal R)
    (h : ∀ a : R, a • x ∈ U ↔ a ∈ q) :
    Nonempty (((U ⊔ R ∙ x : Submodule R M) ⧸
      U.submoduleOf (U ⊔ R ∙ x)) ≃ₗ[R] R ⧸ q) := by
  let V := U ⊔ R ∙ x
  let v : V := ⟨x, Submodule.mem_sup_right (Submodule.mem_span_singleton_self x)⟩
  let g : R →ₗ[R] V ⧸ U.submoduleOf V :=
    (U.submoduleOf V).mkQ.comp (LinearMap.toSpanSingleton R V v)
  have hg : Function.Surjective g := surjective_mkQ_comp_toSpanSingleton U x
  have hk : LinearMap.ker g = q := by
    ext r
    change (U.submoduleOf V).mkQ (r • v) = 0 ↔ r ∈ q
    exact (Submodule.Quotient.mk_eq_zero _).trans (h r)
  exact ⟨(g.quotKerEquivOfSurjective hg).symm.trans (Submodule.quotEquivOfEq _ _ hk)⟩

/-- Below the cut-off, scaling the tail does not change the prefix span. -/
private theorem spanPrefix_scale_suffix_of_le
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    {l : ℕ} (x : Fin l → M) (a : R) {k n : ℕ} (hn : n ≤ k) :
    spanPrefix (R := R) (fun i => if i.val < k then x i else a • x i) n =
      spanPrefix (R := R) x n := by
  unfold spanPrefix
  congr 1
  apply Set.image_congr
  intro i hi
  exact ite_eq_left (hi.trans_le hn)

/-- Scaling the tail of a sequence preserves the property that the scalars carrying each entry
into the span of its predecessors are exactly `q`. -/
private theorem prime_factors_scale_suffix
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    {l : ℕ} (q : Ideal R) [q.IsPrime] (x : Fin l → M)
    (hx : ∀ i r, r • x i ∈ spanBefore (R := R) x i ↔ r ∈ q)
    (a : R) (ha : a ∉ q) (k : ℕ) :
    ∀ i r, r • (if i.val < k then x i else a • x i) ∈
      spanBefore (R := R) (fun j => if j.val < k then x j else a • x j) i ↔ r ∈ q := by
  intro i r
  by_cases hi : i.val < k
  · rw [ite_eq_left hi, spanBefore_eq_spanPrefix, spanPrefix_scale_suffix_of_le x a hi.le]
    exact hx i r
  · rw [ite_eq_right hi]
    constructor
    · intro hr
      have h := spanPrefix_scale_suffix_le (R := R) x a k i.val hr
      rw [smul_smul] at h
      exact (Ideal.IsPrime.mem_or_mem ‹q.IsPrime› ((hx i (r * a)).mp h)).resolve_right ha
    · intro hr
      rw [smul_comm]
      exact smul_mem_spanPrefix_scale_suffix x a k i.val ((hx i r).mpr hr)

/-- The same property is preserved by adding to one entry an element of the span of its
predecessors. -/
private theorem prime_factors_update_add
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    {l : ℕ} (q : Ideal R) (x : Fin l → M)
    (hx : ∀ i r, r • x i ∈ spanBefore (R := R) x i ↔ r ∈ q)
    (i : Fin l) (t : M) (ht : t ∈ spanBefore (R := R) x i) :
    ∀ j r, r • Function.update x i (x i + t) j ∈
      spanBefore (R := R) (Function.update x i (x i + t)) j ↔ r ∈ q := by
  classical
  intro j r
  rw [spanBefore_eq_spanPrefix, spanPrefix_update_add x i t ht]
  by_cases hji : j = i
  · subst j
    rw [Function.update_self, smul_add]
    change r • x i + r • t ∈ spanBefore (R := R) x i ↔ r ∈ q
    rw [Submodule.add_mem_iff_left _ (Submodule.smul_mem _ r ht)]
    exact hx i r
  · rw [Function.update_of_ne hji]
    exact hx j r

/-- The same property is preserved by transposing two adjacent entries. -/
private theorem prime_factors_swap_adjacent
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    {l : ℕ} (q : Ideal R) (x : Fin l → M)
    (hx : ∀ i r, r • x i ∈ spanBefore (R := R) x i ↔ r ∈ q)
    (a b : Fin l) (hba : b.val + 1 = a.val)
    (ha : ∀ r ∈ q, r • x a ∈ spanBefore (R := R) x b) :
    ∀ i r, r • (x ∘ Equiv.swap a b) i ∈
      spanBefore (R := R) (x ∘ Equiv.swap a b) i ↔ r ∈ q := by
  classical
  have hab : a ≠ b := by intro h; subst a; omega
  have hbefore : spanPrefix (R := R) (x ∘ Equiv.swap a b) b.val =
      spanPrefix (R := R) x b.val := spanPrefix_swap x a b b.val (by omega)
  intro i r
  rw [spanBefore_eq_spanPrefix]
  by_cases hib : i = b
  · subst i
    rw [Function.comp_apply, Equiv.swap_apply_right, hbefore]
    exact ⟨fun h => (hx a r).mp (spanPrefix_mono x (by omega : b.val ≤ a.val) h), ha r⟩
  by_cases hia : i = a
  · subst i
    rw [Function.comp_apply, Equiv.swap_apply_left, ← hba,
      spanPrefix_succ _ _ b.isLt, hbefore, Function.comp_apply, Equiv.swap_apply_right]
    constructor
    · intro hr
      obtain ⟨t, ht, z, hz, htz⟩ := Submodule.mem_sup.mp hr
      obtain ⟨s, rfl⟩ := Submodule.mem_span_singleton.mp hz
      have hs : s • x a ∈ spanBefore (R := R) x a := by
        rw [spanBefore_eq_spanPrefix, ← hba, spanPrefix_succ x b.val b.isLt]
        have h := (spanPrefix (R := R) x b.val ⊔ R ∙ x b).sub_mem
          (Submodule.mem_sup_right (Submodule.smul_mem _ r (Submodule.mem_span_singleton_self _)))
          (Submodule.mem_sup_left ht)
        simpa only [← htz, add_sub_cancel_left] using h
      have hs' := ha s ((hx a s).mp hs)
      apply (hx b r).mp
      rw [← htz]
      exact Submodule.add_mem _ ht hs'
    · intro hr
      exact Submodule.mem_sup_left ((hx b r).mpr hr)
  · have hval : i.val ≠ a.val := fun h => hia (Fin.ext h)
    rw [Function.comp_apply, Equiv.swap_apply_of_ne_of_ne hia hib,
      spanPrefix_swap x a b i.val (by omega)]
    exact hx i r

/-- A linear map sends prefix spans to prefix spans of the image sequence. -/
private theorem spanPrefix_map
    {R : Type*} [Ring R] {M N : Type*} [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] {l : ℕ} (x : Fin l → M) (g : M →ₗ[R] N) (n : ℕ) :
    (spanPrefix (R := R) x n).map g = spanPrefix (R := R) (g ∘ x) n := by
  simp only [spanPrefix, Submodule.map_span, Set.image_image, Function.comp_def]

/-- Along an injective linear map, the scalars carrying an entry into the span of its
predecessors are unchanged. -/
private theorem prime_factors_map_iff
    {R : Type*} [Ring R] {M N : Type*} [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] {l : ℕ} (x : Fin l → M)
    (g : M →ₗ[R] N) (hg : Function.Injective g) (i : Fin l) (r : R) :
    r • (g ∘ x) i ∈ spanBefore (R := R) (g ∘ x) i ↔
      r • x i ∈ spanBefore (R := R) x i := by
  rw [spanBefore_eq_spanPrefix, ← spanPrefix_map]
  rw [Function.comp_apply, ← map_smul]
  change g (r • x i) ∈ (spanPrefix (R := R) x i.val).map g ↔ _
  change r • x i ∈ ((spanPrefix (R := R) x i.val).map g).comap g ↔ _
  rw [Submodule.comap_map_eq_of_injective hg]
  rfl

/-- A linear map killing the first entry turns a prefix span into the prefix span of the image
of the tail. -/
private theorem spanPrefix_map_tail
    {R : Type*} [Ring R] {M N : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {l : ℕ} (x : Fin (l + 1) → M) (g : M →ₗ[R] N) (hg : g (x 0) = 0)
    (n : ℕ) (hn : n ≤ l) :
    (spanPrefix (R := R) x (n + 1)).map g =
      spanPrefix (R := R) (fun i : Fin l => g (x i.succ)) n := by
  induction n with
  | zero =>
    rw [spanPrefix_succ x 0 (by omega)]
    simp [spanPrefix, Submodule.map_span, hg]
  | succ n ih =>
    rw [spanPrefix_succ x (n + 1) (by omega), Submodule.map_sup, ih (by omega),
      spanPrefix_succ _ n (by omega), Submodule.map_span, Set.image_singleton]
    rfl

/-- Quotienting by the first entry turns a prefix span into the prefix span of the tail. -/
private theorem spanPrefix_quotient_tail
    {R : Type*} [Ring R] {M : Type*} [AddCommGroup M] [Module R M]
    {l : ℕ} (x : Fin (l + 1) → M) (n : ℕ) (hn : n ≤ l) :
    (spanPrefix (R := R) x (n + 1)).map (R ∙ x 0).mkQ =
      spanPrefix (R := R) (fun i : Fin l => (R ∙ x 0).mkQ (x i.succ)) n :=
  spanPrefix_map_tail x _ ((Submodule.Quotient.mk_eq_zero _).mpr
    (Submodule.mem_span_singleton_self _)) n hn

/-- The first entry lies in every nonempty prefix span. -/
private theorem span_singleton_le_spanPrefix
    {R : Type*} [Ring R] {M : Type*} [AddCommGroup M] [Module R M]
    {l : ℕ} (x : Fin (l + 1) → M) {n : ℕ} (hn : 0 < n) :
    R ∙ x 0 ≤ spanPrefix (R := R) x n :=
  Submodule.span_le.mpr (Set.singleton_subset_iff.mpr (Submodule.subset_span ⟨0, hn, rfl⟩))

/-- The tail of a sequence, read in the quotient by the first entry, again has all its factors
cut out by `q`. -/
private theorem prime_factors_quotient_tail
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    {l : ℕ} (q : Ideal R) (x : Fin (l + 1) → M)
    (hx : ∀ i r, r • x i ∈ spanBefore (R := R) x i ↔ r ∈ q) :
    ∀ (i : Fin l) r,
      r • (R ∙ x 0).mkQ (x i.succ) ∈
        spanBefore (R := R) (fun j : Fin l => (R ∙ x 0).mkQ (x j.succ)) i ↔ r ∈ q := by
  intro i r
  rw [spanBefore_eq_spanPrefix, ← spanPrefix_quotient_tail x i.val (by omega)]
  change (R ∙ x 0).mkQ (r • x i.succ) ∈
    (spanPrefix (R := R) x (i.val + 1)).map (R ∙ x 0).mkQ ↔ r ∈ q
  change r • x i.succ ∈ ((spanPrefix (R := R) x (i.val + 1)).map
    (R ∙ x 0).mkQ).comap (R ∙ x 0).mkQ ↔ _
  rw [Submodule.comap_map_eq, Submodule.ker_mkQ,
    sup_eq_left.mpr (span_singleton_le_spanPrefix x (Nat.succ_pos _))]
  exact hx i.succ r

/-- The tail of a generating sequence generates the quotient by the first entry. -/
private theorem span_quotient_tail_eq_top
    {R : Type*} [Ring R] {M : Type*} [AddCommGroup M] [Module R M]
    {l : ℕ} (x : Fin (l + 1) → M) (hx : Submodule.span R (Set.range x) = ⊤) :
    Submodule.span R (Set.range (fun i : Fin l => (R ∙ x 0).mkQ (x i.succ))) = ⊤ := by
  have h := spanPrefix_quotient_tail (R := R) x l le_rfl
  rw [spanPrefix_eq_top_of_generating x hx, Submodule.map_top,
    LinearMap.range_eq_top.mpr (Submodule.mkQ_surjective _)] at h
  have ht : spanPrefix (R := R) (fun i : Fin l => (R ∙ x 0).mkQ (x i.succ)) l =
      Submodule.span R (Set.range (fun i : Fin l => (R ∙ x 0).mkQ (x i.succ))) := by
    unfold spanPrefix
    congr 1
    simp only [show {i : Fin l | i.val < l} = Set.univ from Set.eq_univ_of_forall Fin.isLt,
      Set.image_univ]
  exact ht ▸ h.symm

/-- The image of an admissible sequence under a linear map is admissible. -/
private theorem admissible_map
    {R : Type*} [CommRing R] [IsLocalRing R] {M N : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {l : ℕ} (x : Fin l → M) (hx : IsAdmissibleSequence (R := R) x) (g : M →ₗ[R] N) :
    IsAdmissibleSequence (R := R) (g ∘ x) := by
  intro i r hr
  rw [spanBefore_eq_spanPrefix, ← spanPrefix_map, Function.comp_apply, ← map_smul]
  exact Submodule.mem_map_of_mem (hx i r hr)

/-- A sequence whose entries are killed into the span of their predecessors by every element of
`q` localizes to an admissible sequence at `q`. -/
public theorem admissible_localized
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    {l : ℕ} (q : Ideal R) [q.IsPrime] (x : Fin l → M)
    (hx : ∀ i r, r ∈ q → r • x i ∈ spanBefore (R := R) x i) :
    IsAdmissibleSequence (R := Localization.AtPrime q)
      (fun i => LocalizedModule.mk (x i) (1 : q.primeCompl)) := by
  let S := Localization.AtPrime q
  let f := LocalizedModule.mkLinearMap q.primeCompl M
  let e : Fin l → LocalizedModule q.primeCompl M := fun i => LocalizedModule.mk (x i) 1
  intro i r hr
  let P := spanBefore (R := S) e i
  let J : Ideal S := P.comap (LinearMap.toSpanSingleton S _ (e i))
  have hle : q.map (algebraMap R S) ≤ J := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    change algebraMap R S a • e i ∈ P
    rw [IsScalarTower.algebraMap_smul]
    change a • f (x i) ∈ P
    rw [← map_smul]
    have hmem : a • x i ∈ spanBefore (R := R) x i := hx i a ha
    have hspan : (spanBefore (R := R) x i).localized' S q.primeCompl f = P := by
      simp only [P, e, spanBefore, Submodule.localized'_span, Set.image_image,
        f, LocalizedModule.mkLinearMap_apply]
    rw [← hspan]
    exact (Submodule.mem_localized' S q.primeCompl f _ _).mpr
      ⟨a • x i, hmem, 1, by simp⟩
  have hmax : q.map (algebraMap R S) = IsLocalRing.maximalIdeal S :=
    IsLocalization.AtPrime.map_eq_maximalIdeal _ _
  exact hle (hmax.symm ▸ hr)

/-- The same, for the image of such a sequence under a linear map. -/
public theorem admissible_localized_map
    {R : Type*} [CommRing R] {M N : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {l : ℕ} (q : Ideal R) [q.IsPrime] (x : Fin l → M)
    (hx : ∀ i r, r ∈ q → r • x i ∈ spanBefore (R := R) x i) (φ : M →ₗ[R] N) :
    IsAdmissibleSequence (R := Localization.AtPrime q)
      (fun i => LocalizedModule.mk (φ (x i)) (1 : q.primeCompl)) := by
  apply admissible_localized q (φ ∘ x)
  intro i r hr
  rw [spanBefore_eq_spanPrefix, ← spanPrefix_map, Function.comp_apply, ← map_smul]
  exact Submodule.mem_map_of_mem (hx i r hr)

/-- Reindexing a generating sequence along an equality of lengths keeps it generating. -/
private theorem span_cast_eq_top
    {R : Type*} [Ring R] {M : Type*} [AddCommGroup M] [Module R M]
    {l n : ℕ} (x : Fin l → M) (h : n = l) (hx : Submodule.span R (Set.range x) = ⊤) :
    Submodule.span R (Set.range (x ∘ Fin.cast h)) = ⊤ := by
  subst n
  exact hx

/-- If a map is surjective after localization, the localized images of a generating sequence
generate the localized target. -/
private theorem span_localized_map_eq_top
    {R : Type*} [CommRing R] {M N : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {l : ℕ} (S : Submonoid R) (x : Fin l → M)
    (hx : Submodule.span R (Set.range x) = ⊤) (φ : M →ₗ[R] N)
    (hφ : Function.Surjective (LocalizedModule.map S φ)) :
    Submodule.span (Localization S)
      (Set.range (fun i => LocalizedModule.mk (φ (x i)) (1 : S))) = ⊤ := by
  have h := congrArg (Submodule.map (LocalizedModule.map S φ))
    (span_localized_generators_eq_top S x hx)
  rw [Submodule.map_span, ← Set.range_comp, Submodule.map_top,
    LinearMap.range_eq_top.mpr hφ] at h
  simpa only [Function.comp_def, LocalizedModule.map_mk] using h

/-- A product that is `1` below a cut-off and `a` above it is a power of `a`. -/
private theorem prod_fin_suffix
    {A : Type*} [CommMonoid A] (a : A) (l k : ℕ) :
    (∏ i : Fin l, if i.val < k then 1 else a) = a ^ (l - k) := by
  induction l with
  | zero => simp
  | succ l ih =>
    rw [Fin.prod_univ_castSucc]
    simp only [Fin.val_castSucc, Fin.val_last, ih]
    by_cases h : l < k
    · simp [h, show l - k = 0 by omega, show l + 1 - k = 0 by omega]
    · rw [ite_eq_right h, show l + 1 - k = (l - k) + 1 by omega, pow_succ]

/-- Scaling the tail of an admissible sequence by a unit multiplies its symbol by the
corresponding power of the residue of that unit. -/
private theorem symbol_scale_suffix
    {R : Type*} [CommRing R] [IsLocalRing R] {M : Type*}
    [AddCommGroup M] [Module R M] (e e' : AdmissibleSequence R M)
    (a : Rˣ) (k : ℕ)
    (he' : ∀ i, e'.1 i = if i.val < k then e.1 i else (a : R) • e.1 i) :
    symbol e' = IsLocalRing.residue R a ^ (moduleLength R M - k) • symbol e := by
  classical
  let u : Fin (moduleLength R M) → Rˣ := fun i => if i.val < k then 1 else a
  have heq : e' = ⟨fun i => (u i : R) • e.1 i, admissible_units_smul e.1 e.2 u⟩ := by
    apply Subtype.ext
    funext i
    rw [he']
    dsimp [u]
    split_ifs <;> simp
  rw [heq, symbol_units_smul]
  have hu (i) : IsLocalRing.residue R (u i) =
      if i.val < k then 1 else IsLocalRing.residue R a := by
    dsimp [u]
    split_ifs <;> simp
  simp_rw [hu]
  rw [prod_fin_suffix]

/-- If `q` kills an element, the maximal ideal of the localization kills its image in the
localized module. -/
private theorem maximalIdeal_smul_localized_eq_zero
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    (q : Ideal R) [q.IsPrime] (x : M) (hx : ∀ a ∈ q, a • x = 0)
    (r : Localization.AtPrime q) (hr : r ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q)) :
    r • LocalizedModule.mk x (1 : q.primeCompl) = 0 := by
  have h := admissible_localized q (fun _ : Fin 1 => x)
    (fun _ a ha => by rw [hx a ha]; exact Submodule.zero_mem _) 0 r hr
  have hb : spanBefore (R := Localization.AtPrime q)
      (fun _ : Fin 1 => LocalizedModule.mk x (1 : q.primeCompl)) 0 = ⊥ := by
    rw [spanBefore_eq_spanPrefix]
    simp [spanPrefix]
  rwa [hb, Submodule.mem_bot] at h

/-- A pivot equation `φ (x 0) = t + a • y i` places the image of the first entry inside the
prefix span of the sequence whose tail beyond `i` is scaled by `a`. -/
private theorem map_span_scale_suffix_le
    {R : Type*} [CommRing R] {M N : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {l : ℕ} (x : Fin (l + 1) → M) (y : Fin (l + 1) → N)
    (hy : Submodule.span R (Set.range y) = ⊤) (φ : M →ₗ[R] N)
    (i : Fin (l + 1)) (a : R) (t : N)
    (ht : t ∈ spanBefore (R := R) y i) (hφx : φ (x 0) = t + a • y i) :
    (Submodule.span R (Set.range (fun j => if j.val < 1 then x j else a • x j))).map φ ≤
      Submodule.span R (Set.range (fun j => if j.val < i.val then y j else a • y j)) := by
  let ys : Fin (l + 1) → N := fun j => if j.val < i.val then y j else a • y j
  rw [Submodule.map_span]
  apply Submodule.span_le.mpr
  rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
  change φ (if j.val < 1 then x j else a • x j) ∈ Submodule.span R (Set.range ys)
  by_cases hj : j.val < 1
  · have hj0 : j = 0 := by
      apply Fin.ext
      change j.val = 0
      omega
    subst j
    rw [ite_eq_left hj, hφx]
    apply Submodule.add_mem
    · have ht' : t ∈ spanPrefix (R := R) ys i.val := by
        rw [spanPrefix_scale_suffix_of_le y a le_rfl]
        exact ht
      rw [← spanPrefix_length (R := R) ys]
      exact spanPrefix_mono ys i.isLt.le ht'
    · exact Submodule.subset_span ⟨i, by simp [ys]⟩
  · rw [ite_eq_right hj, map_smul]
    have h := smul_mem_spanPrefix_scale_suffix y a i.val (l + 1)
      (z := φ (x j)) (by rw [spanPrefix_eq_top_of_generating y hy]; trivial)
    rwa [spanPrefix_length] at h

/-- A linear equivalence transports a relation between two symbols to the corresponding
relation between the transported symbols. -/
private theorem symbol_relation_iff_of_equiv
    {R : Type*} [CommRing R] [IsLocalRing R] {M N : Type v}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (E : M ≃ₗ[R] N) (h : moduleLength R M = moduleLength R N)
    (x y : AdmissibleSequence R M) (x' y' : AdmissibleSequence R N)
    (hx : ∀ j, E (x.1 (Fin.cast h.symm j)) = x'.1 j)
    (hy : ∀ j, E (y.1 (Fin.cast h.symm j)) = y'.1 j)
    (a : IsLocalRing.ResidueField R) :
    symbol x = a • symbol y ↔ symbol x' = a • symbol y' := by
  have hex : admissibleSequenceMap E h x = x' := Subtype.ext (funext hx)
  have hey : admissibleSequenceMap E h y = y' := Subtype.ext (funext hy)
  rw [← (determinantEquiv E h).injective.eq_iff, map_smul,
    determinantEquiv_symbol, determinantEquiv_symbol, hex, hey]

/-- Reindexing commutes with a transposition of the two reindexed positions. -/
private theorem fin_cast_swap {m n : ℕ} (h : m = n) (a b : Fin n) (j : Fin m) :
    Fin.cast h (Equiv.swap (Fin.cast h.symm a) (Fin.cast h.symm b) j) =
      Equiv.swap a b (Fin.cast h j) := by
  subst n
  rfl

/-- Transposing two adjacent entries of a localized sequence negates its symbol, when `q` kills
the later entry. -/
private theorem symbol_localized_swap_adjacent
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    (q : Ideal R) [q.IsPrime] {l : ℕ} (x : Fin l → M)
    (e e' : AdmissibleSequence (Localization.AtPrime q) (LocalizedModule q.primeCompl M))
    (h : moduleLength (Localization.AtPrime q) (LocalizedModule q.primeCompl M) = l)
    (he : ∀ j, e.1 j = LocalizedModule.mk (x (Fin.cast h j)) 1)
    (a b : Fin l) (hba : b.val + 1 = a.val) (ha : ∀ r ∈ q, r • x a = 0)
    (he' : ∀ j, e'.1 j = LocalizedModule.mk (x (Equiv.swap a b (Fin.cast h j))) 1) :
    symbol e = -symbol e' := by
  classical
  let a' := Fin.cast h.symm a
  let b' := Fin.cast h.symm b
  have hba' : b'.val + 1 = a'.val := hba
  have hha : ∀ r, r ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) →
      r • e.1 a' ∈ spanBefore (R := Localization.AtPrime q) e.1 b' := by
    intro r hr
    rw [he]
    change r • LocalizedModule.mk (x a) 1 ∈ _
    rw [maximalIdeal_smul_localized_eq_zero q (x a) ha r hr]
    exact Submodule.zero_mem _
  have hs := symbol_swap_adjacent e a' b' hba' hha
  have heq : (⟨e.1 ∘ Equiv.swap a' b', admissible_swap_adjacent e a' b' hba' hha⟩ :
      AdmissibleSequence (Localization.AtPrime q) (LocalizedModule q.primeCompl M)) = e' := by
    apply Subtype.ext
    funext j
    change e.1 (Equiv.swap a' b' j) = e'.1 j
    rw [he, he', fin_cast_swap]
  rwa [heq] at hs

/-- The image of the tail of an admissible sequence under a map killing the first entry is
admissible. -/
private theorem admissible_map_tail
    {R : Type*} [CommRing R] [IsLocalRing R] {M N : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {l : ℕ} (x : Fin (l + 1) → M) (hx : IsAdmissibleSequence (R := R) x)
    (g : M →ₗ[R] N) (hg : g (x 0) = 0) :
    IsAdmissibleSequence (R := R) (fun i : Fin l => g (x i.succ)) := by
  intro i r hr
  rw [spanBefore_eq_spanPrefix, ← spanPrefix_map_tail x g hg i.val (by omega), ← map_smul]
  exact Submodule.mem_map_of_mem (hx i.succ r hr)

/-- For a short exact sequence, a sequence obtained by appending lifts of a sequence for the
quotient to the image of one for the submodule has symbol the product of the two scalars. -/
private theorem symbol_append_eq_mul_smul_of_exact
    {R : Type*} [CommRing R] [IsLocalRing R] {K L M : Type*}
    [AddCommGroup K] [Module R K] [AddCommGroup L] [Module R L]
    [AddCommGroup M] [Module R M]
    (i : K →ₗ[R] L) (p : L →ₗ[R] M)
    (hi : Function.Injective i) (hp : Function.Surjective p) (hip : Function.Exact i p)
    (hK : IsFiniteLength R K) (hL : IsFiniteLength R L) (hM : IsFiniteLength R M)
    (xK yK : AdmissibleSequence R K) (xM yM : AdmissibleSequence R M)
    (hxK : symbol xK ≠ 0) (hyK : symbol yK ≠ 0)
    (hxM : symbol xM ≠ 0) (hyM : symbol yM ≠ 0)
    (x y : AdmissibleSequence R L)
    (tx ty : Fin (moduleLength R M) → L)
    (htx : ∀ j, p (tx j) = xM.1 j) (hty : ∀ j, p (ty j) = yM.1 j)
    (hlen : moduleLength R L = moduleLength R K + moduleLength R M)
    (hx : ∀ j, x.1 j = Fin.append (i ∘ xK.1) tx (Fin.cast hlen j))
    (hy : ∀ j, y.1 j = Fin.append (i ∘ yK.1) ty (Fin.cast hlen j))
    (a b : IsLocalRing.ResidueField R)
    (hfirst : symbol xK = a • symbol yK) (htail : symbol xM = b • symbol yM) :
    symbol x = (a * b) • symbol y := by
  have hgamma := determinantExactSequenceMap_spec
    i p hi hp hip hK hL hM
  obtain ⟨h₁, hxadm, hγx⟩ := hgamma xK xM hxK hxM tx htx
  obtain ⟨h₂, hyadm, hγy⟩ := hgamma yK yM hyK hyM ty hty
  have hex : (⟨fun j => Fin.append (fun k => i (xK.1 k)) tx (Fin.cast h₁ j), hxadm⟩ :
      AdmissibleSequence R L) = x := Subtype.ext (funext fun j => (hx j).symm)
  have hey : (⟨fun j => Fin.append (fun k => i (yK.1 k)) ty (Fin.cast h₂ j), hyadm⟩ :
      AdmissibleSequence R L) = y := Subtype.ext (funext fun j => (hy j).symm)
  rw [hex] at hγx
  rw [hey] at hγy
  rw [← hγx, hfirst, htail, TensorProduct.smul_tmul_smul, map_smul, hγy]

/-- An element of the span up to and including one entry is, modulo the span of the
predecessors, a scalar multiple of that entry, with the scalar outside `q` unless the element
already lies in the earlier span. -/
private theorem exists_coefficient_notMem_prime_of_mem_span_succ
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    {l : ℕ} (q : Ideal R) (x : Fin l → M) (i : Fin l)
    (hfactor : Nonempty (((spanBefore (R := R) x i ⊔ R ∙ x i : Submodule R M) ⧸
      (spanBefore (R := R) x i).submoduleOf (spanBefore (R := R) x i ⊔ R ∙ x i))
      ≃ₗ[R] R ⧸ q))
    (z : M) (hz : z ∈ spanBefore (R := R) x i ⊔ R ∙ x i)
    (hz' : z ∉ spanBefore (R := R) x i) :
    ∃ (a : R) (t : M), a ∉ q ∧ t ∈ spanBefore (R := R) x i ∧ z = t + a • x i := by
  obtain ⟨t, ht, w, hw, htw⟩ := Submodule.mem_sup.mp hz
  obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hw
  refine ⟨a, t, ?_, ht, htw.symm⟩
  intro ha
  apply hz'
  rw [← htw]
  exact Submodule.add_mem _ ht ((smul_mem_iff_of_cyclic_factor _ _ q hfactor a).mpr ha)

/-- Every nonzero element of a module filtered by copies of `R / q` has a pivot: an index, a
scalar outside `q` and an element of the earlier span presenting it. -/
private theorem exists_pivot_of_prime_filtration
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    {l : ℕ} (q : Ideal R) (x : Fin l → M)
    (hx : Submodule.span R (Set.range x) = ⊤)
    (hxf : ∀ i : Fin l, Nonempty
      (((spanBefore (R := R) x i ⊔ R ∙ x i : Submodule R M) ⧸
        (spanBefore (R := R) x i).comap
          (spanBefore (R := R) x i ⊔ R ∙ x i : Submodule R M).subtype) ≃ₗ[R] R ⧸ q))
    (z : M) (hz : z ≠ 0) :
    ∃ (i : Fin l) (a : R) (t : M),
      z ∉ spanBefore (R := R) x i ∧ a ∉ q ∧
        t ∈ spanBefore (R := R) x i ∧ z = t + a • x i := by
  classical
  have hex : ∃ n, z ∈ spanPrefix (R := R) x n :=
    ⟨l, by rw [spanPrefix_eq_top_of_generating x hx]; trivial⟩
  let n := Nat.find hex
  have hmem : z ∈ spanPrefix (R := R) x n := Nat.find_spec hex
  have hnl : n ≤ l := Nat.find_min' hex (by
    rw [spanPrefix_eq_top_of_generating x hx]
    trivial)
  have hn : 0 < n := by
    by_contra hn
    have hn0 : n = 0 := by omega
    have hzero : spanPrefix (R := R) x n = ⊥ := by simp [hn0, spanPrefix]
    rw [hzero] at hmem
    exact hz hmem
  let i : Fin l := ⟨n - 1, by omega⟩
  have hip : i.val + 1 = n := by dsimp [i]; omega
  have hnot : z ∉ spanBefore (R := R) x i :=
    Nat.find_min hex (by dsimp [i]; omega)
  have hsup : z ∈ spanBefore (R := R) x i ⊔ R ∙ x i := by
    rw [spanBefore_eq_spanPrefix, ← spanPrefix_succ x i.val i.isLt, hip]
    exact hmem
  obtain ⟨a, t, haq, ht, hzt⟩ := exists_coefficient_notMem_prime_of_mem_span_succ
    q x i (hxf i) z hsup hnot
  exact ⟨i, a, t, hnot, haq, ht, hzt⟩

/-- For a filtration by copies of `R / q`, the scalars carrying a prefix span into an earlier
one are exactly those in `q`. -/
private theorem smul_mem_spanPrefix_iff
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    {l : ℕ} (q : Ideal R) [q.IsPrime] (x : Fin l → M)
    (hx : Submodule.span R (Set.range x) = ⊤)
    (hxf : ∀ i r, r • x i ∈ spanBefore (R := R) x i ↔ r ∈ q)
    (a : R) (ha : a ∉ q) (n : ℕ) (z : M) :
    a • z ∈ spanPrefix (R := R) x n ↔ z ∈ spanPrefix (R := R) x n := by
  refine ⟨fun hz => ?_, fun hz => Submodule.smul_mem _ a hz⟩
  by_contra hnot
  have hz0 : z ≠ 0 := fun h => hnot (h.symm ▸ Submodule.zero_mem _)
  obtain ⟨i, c, t, _, hc, ht, hzt⟩ := exists_pivot_of_prime_filtration q x hx
    (fun i => cyclic_factor_equiv_of_smul_mem_iff _ _ q (hxf i)) z hz0
  have hni : n ≤ i.val := by
    by_contra hni
    apply hnot
    rw [hzt]
    exact Submodule.add_mem _ (spanPrefix_mono x (by omega : i.val ≤ n) ht)
      (Submodule.smul_mem _ c (Submodule.subset_span ⟨i, by change i.val < n; omega, rfl⟩))
  have hac : (a * c) • x i ∈ spanBefore (R := R) x i := by
    have h := (spanPrefix (R := R) x i.val).sub_mem
      (spanPrefix_mono x hni hz) (Submodule.smul_mem _ a ht)
    simpa only [hzt, smul_add, add_sub_cancel_left, smul_smul, spanBefore_eq_spanPrefix] using h
  exact hc ((Ideal.IsPrime.mem_or_mem ‹q.IsPrime› ((hxf i (a * c)).mp hac)).resolve_left ha)

/-- A map sending the first entry to a scalar multiple of a generator with scalar outside `q`
induces an injection on the quotient by the first entry. -/
private theorem injective_quotient_map_of_first_scalar
    {R : Type*} [CommRing R] {M N : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {l : ℕ} (q : Ideal R) [q.IsPrime] (x : Fin (l + 1) → M) (y : N)
    (hx : Submodule.span R (Set.range x) = ⊤)
    (hxf : ∀ i r, r • x i ∈ spanBefore (R := R) x i ↔ r ∈ q)
    (φ : M →ₗ[R] N) (hφ : Function.Injective φ)
    (a : R) (ha : a ∉ q) (hφx : φ (x 0) = a • y)
    (hUV : R ∙ x 0 ≤ (R ∙ y).comap φ) :
    Function.Injective ((R ∙ x 0).mapQ (R ∙ y) φ hUV) := by
  apply LinearMap.ker_eq_bot.mp
  rw [Submodule.eq_bot_iff]
  intro z hz
  obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective (R ∙ x 0) z
  change (R ∙ y).mkQ (φ m) = 0 at hz
  obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp ((Submodule.Quotient.mk_eq_zero _).mp hz)
  have hm : a • m = r • x 0 := hφ (by
    rw [map_smul, map_smul, hφx, ← hr, smul_comm])
  apply (Submodule.Quotient.mk_eq_zero _).mpr
  have hprefix : spanPrefix (R := R) x 1 = R ∙ x 0 := by
    rw [spanPrefix_succ x 0 (Nat.succ_pos _)]
    simp [spanPrefix]
  rw [← hprefix]
  apply (smul_mem_spanPrefix_iff q x hx hxf a ha 1 m).mp
  rw [hm, hprefix]
  exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

/-- The generator of a cyclic submodule generates it, read inside that submodule. -/
private theorem span_cyclic_submodule_generator
    {R : Type*} [Ring R] {M : Type*} [AddCommGroup M] [Module R M] (x : M) :
    R ∙ (⟨x, Submodule.mem_span_singleton_self x⟩ : R ∙ x) = ⊤ := by
  apply (Submodule.span_singleton_eq_top_iff _ _).mpr
  intro z
  obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp z.property
  exact ⟨r, Subtype.ext hr⟩

/-- The annihilator of the submodule generated by the first entry is `q`. -/
private theorem annihilator_first_span
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    {l : ℕ} (q : Ideal R) (x : Fin (l + 1) → M)
    (hx : ∀ i r, r • x i ∈ spanBefore (R := R) x i ↔ r ∈ q) :
    Module.annihilator R (R ∙ x 0) = q := by
  ext r
  rw [scalar_mem_annihilator_iff_of_generator _ (span_cyclic_submodule_generator (x 0))]
  change (⟨r • x 0, _⟩ : R ∙ x 0) = 0 ↔ r ∈ q
  rw [Subtype.ext_iff]
  have hb : spanBefore (R := R) x 0 = ⊥ := by
    rw [spanBefore_eq_spanPrefix]
    simp [spanPrefix]
  simpa only [hb, Submodule.mem_bot, Submodule.coe_zero] using hx 0 r

end Module.FiniteLength
