/-!
# The determinant at a one-dimensional prime

Let `q` be a prime of a Noetherian local ring such that `R / q` has dimension one. For an
injective map between finite modules equipped with filtrations whose successive factors are
`R / q`, the length of its cokernel is the order of the scalar comparing the determinant
symbols.

## Main results

* `Module.FiniteLength.length_coker_eq_order_determinant_scalar` computes the cokernel length
  from the determinant scalar.

## Implementation notes

In the length formula, admissible localized sequences representing the displayed lists are
supplied explicitly; their existence follows from the filtration assumptions. The order of the
nonzero fraction is expressed by `Ring.ordFrac`.

## References

* [Stacks Project, Tag 02QB](https://stacks.math.columbia.edu/tag/02QB)
-/

@[expose] public section

noncomputable section

namespace Module.FiniteLength

universe u v w

/-- The image of `a` in the residue field of `q` is the residue of its image in the
localization at `q`. -/
private theorem algebraMap_quotient_residueField_mk_eq_residue
    {R : Type*} [CommRing R] (q : Ideal R) [q.IsPrime] (a : R) :
    algebraMap (R ⧸ q) q.ResidueField (Ideal.Quotient.mk q a) =
      IsLocalRing.residue (Localization.AtPrime q) (algebraMap R (Localization.AtPrime q) a) := by
  rw [Ideal.algebraMap_quotient_residueField_mk,
    IsScalarTower.algebraMap_apply R (Localization.AtPrime q),
    IsLocalRing.ResidueField.algebraMap_eq]

/-- The span of the elements before an index of value zero is trivial. -/
private theorem spanBefore_eq_bot_of_val_eq_zero
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M] {l : ℕ}
    (e : Fin l → M) (i : Fin l) (hi : i.val = 0) : spanBefore (R := R) e i = ⊥ := by
  have : Set.Iio i = ∅ := Set.eq_empty_of_forall_notMem fun j hj => by
    have := Fin.lt_def.mp hj
    omega
  rw [spanBefore, this, Set.image_empty, Submodule.span_empty]

/-- A module generated by its first filtration element, with factor `R / q`, has annihilator
`q`. -/
private theorem annihilator_eq_of_first_factor
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M] {l : ℕ}
    (q : Ideal R) (e : Fin l → M) (i : Fin l) (hi : i.val = 0) (hg : R ∙ e i = ⊤)
    (hf : Nonempty
      (((spanBefore (R := R) e i ⊔ R ∙ e i : Submodule R M) ⧸
          (spanBefore (R := R) e i).comap
            (spanBefore (R := R) e i ⊔ R ∙ e i : Submodule R M).subtype) ≃ₗ[R] R ⧸ q)) :
    Module.annihilator R M = q := by
  refine annihilator_eq_of_singleton_factor q (e i) hg ?_
  rwa [spanBefore_eq_bot_of_val_eq_zero e i hi, bot_sup_eq, Submodule.comap_bot,
    Submodule.ker_subtype] at hf

/-- A module with a prime filtration with factors `R / q` has finite length after localizing
at `q`. -/
private theorem finiteLength_localized_of_prime_filtration
    {R : Type*} [CommRing R] {N : Type*} [AddCommGroup N] [Module R N]
    (q : Ideal R) [q.IsPrime] {l : ℕ} (y : Fin l → N)
    (hy : Submodule.span R (Set.range y) = ⊤)
    (hyf : ∀ i : Fin l,
      Nonempty
        (((spanBefore (R := R) y i ⊔ R ∙ y i : Submodule R N) ⧸
            (spanBefore (R := R) y i).comap
              (spanBefore (R := R) y i ⊔ R ∙ y i : Submodule R N).subtype) ≃ₗ[R]
          R ⧸ q)) :
    IsFiniteLength (Localization.AtPrime q) (LocalizedModule q.primeCompl N) :=
  Module.length_ne_top_iff.mp (by
    rw [localized_length_of_generating q y hy hyf]
    exact ENat.natCast_ne_top _)

/-- The localized sequence indexed through a cast generates the localization. -/
private theorem span_localized_sequence_eq_top
    {R : Type*} [CommRing R] {N : Type*} [AddCommGroup N] [Module R N]
    (q : Ideal R) [q.IsPrime] {l : ℕ} (y : Fin l → N)
    (hy : Submodule.span R (Set.range y) = ⊤)
    (e : AdmissibleSequence (Localization.AtPrime q) (LocalizedModule q.primeCompl N))
    (hl : moduleLength (Localization.AtPrime q) (LocalizedModule q.primeCompl N) = l)
    (he : ∀ i, e.1 i = LocalizedModule.mk (y (Fin.cast hl i)) 1) :
    Submodule.span (Localization.AtPrime q) (Set.range e.1) = ⊤ := by
  rw [show e.1 = (fun j => LocalizedModule.mk (y j) (1 : q.primeCompl)) ∘ Fin.cast hl from
    funext he]
  exact span_cast_eq_top _ hl (span_localized_generators_eq_top q.primeCompl y hy)

/-- An injective map between modules with prime filtrations with factors `R / q` gives localized
admissible sequences of the target whose symbols differ by a nonzero scalar. -/
private theorem exists_symbol_eq_smul_of_prime_filtration
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] {M N : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    [Module.Finite R M] [Module.Finite R N]
    (q : Ideal R) [q.IsPrime] {n : ℕ} (x : Fin n → M) (y : Fin n → N)
    (hx : Submodule.span R (Set.range x) = ⊤)
    (hX : ∀ i r, r • x i ∈ spanBefore (R := R) x i ↔ r ∈ q)
    (hy : Submodule.span R (Set.range y) = ⊤)
    (hY : ∀ i r, r • y i ∈ spanBefore (R := R) y i ↔ r ∈ q)
    (φ : M →ₗ[R] N) (hφ : Function.Injective φ) :
    ∃ (hl : moduleLength (Localization.AtPrime q) (LocalizedModule q.primeCompl N) = n)
      (eX eY : AdmissibleSequence (Localization.AtPrime q) (LocalizedModule q.primeCompl N))
      (g : IsLocalRing.ResidueField (Localization.AtPrime q)), g ≠ 0 ∧
      (∀ i, eX.1 i = LocalizedModule.mk (φ (x (Fin.cast hl i))) 1) ∧
      (∀ i, eY.1 i = LocalizedModule.mk (y (Fin.cast hl i)) 1) ∧
      symbol eX = g • symbol eY := by
  have hxf := fun i => cyclic_factor_equiv_of_smul_mem_iff _ _ q (hX i)
  have hyf := fun i => cyclic_factor_equiv_of_smul_mem_iff _ _ q (hY i)
  have hloc := (injective_iff_localizedMap_bijective_of_prime_filtrations
    q n x y hx hxf hy hyf φ).mp hφ
  have hl : moduleLength (Localization.AtPrime q) (LocalizedModule q.primeCompl N) = n := by
    unfold moduleLength
    rw [localized_length_of_generating q y hy hyf]
    simp
  let eY : AdmissibleSequence (Localization.AtPrime q) (LocalizedModule q.primeCompl N) :=
    ⟨fun i => LocalizedModule.mk (y (Fin.cast hl i)) 1,
      admissible_cast hl (fun j => LocalizedModule.mk (y j) (1 : q.primeCompl))
        (admissible_localized q y (fun i r hr => (hY i r).mpr hr))⟩
  let eX : AdmissibleSequence (Localization.AtPrime q) (LocalizedModule q.primeCompl N) :=
    ⟨fun i => LocalizedModule.mk (φ (x (Fin.cast hl i))) 1,
      admissible_cast hl (fun j => LocalizedModule.mk (φ (x j)) (1 : q.primeCompl))
        (admissible_localized_map q x (fun i r hr => (hX i r).mpr hr) φ)⟩
  have hfin := finiteLength_localized_of_prime_filtration q y hy hyf
  have hYgen := span_localized_sequence_eq_top q y hy eY hl fun _ => rfl
  have hXne := symbol_ne_zero_of_generating hfin eX
    (span_cast_eq_top (fun j => LocalizedModule.mk (φ (x j)) (1 : q.primeCompl)) hl
      (span_localized_map_eq_top q.primeCompl x hx φ hloc.2))
  obtain ⟨g, hg⟩ := Submodule.mem_span_singleton.mp
    (show symbol eX ∈ (IsLocalRing.ResidueField (Localization.AtPrime q)) ∙ symbol eY from by
      rw [span_symbol_eq_top hfin eY hYgen]
      trivial)
  exact ⟨hl, eX, eY, g, by rintro rfl; exact hXne (by rw [← hg, zero_smul]), fun _ => rfl,
    fun _ => rfl, hg.symm⟩

/-- For an injective map as above, the length of its cokernel is the order of the nonzero
scalar comparing the determinant symbols of the localized filtrations. -/
@[stacks 02QB "length formula"]
theorem length_coker_eq_order_determinant_scalar
    {R : Type u} {M : Type v} {N : Type w} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N]
    (q : Ideal R) [q.IsPrime] (hdim : ringKrullDim (R ⧸ q) = 1)
    (l : ℕ) (x : Fin l → M) (y : Fin l → N)
    (hx : Submodule.span R (Set.range x) = ⊤)
    (hxf : ∀ i : Fin l,
      Nonempty
        (((spanBefore (R := R) x i ⊔ R ∙ x i : Submodule R M) ⧸
            (spanBefore (R := R) x i).comap
              (spanBefore (R := R) x i ⊔ R ∙ x i : Submodule R M).subtype) ≃ₗ[R]
          R ⧸ q))
    (hy : Submodule.span R (Set.range y) = ⊤)
    (hyf : ∀ i : Fin l,
      Nonempty
        (((spanBefore (R := R) y i ⊔ R ∙ y i : Submodule R N) ⧸
            (spanBefore (R := R) y i).comap
              (spanBefore (R := R) y i ⊔ R ∙ y i : Submodule R N).subtype) ≃ₗ[R]
          R ⧸ q))
    (φ : M →ₗ[R] N) (hφ : Function.Injective φ)
    (eφ eN : AdmissibleSequence (Localization.AtPrime q)
      (LocalizedModule q.primeCompl N))
    (hφl : moduleLength (Localization.AtPrime q) (LocalizedModule q.primeCompl N) = l)
    (heφ : ∀ i, eφ.1 i = LocalizedModule.mk (φ (x (Fin.cast hφl i))) 1)
    (heN : ∀ i, eN.1 i = LocalizedModule.mk (y (Fin.cast hφl i)) 1)
    (f : IsLocalRing.ResidueField (Localization.AtPrime q)) (hf : f ≠ 0)
    (hdet : symbol eφ = f • symbol eN) :
    letI : Ring.KrullDimLE 1 (R ⧸ q) := Ring.krullDimLE_iff.mpr hdim.le
    ((Module.length R (N ⧸ LinearMap.range φ)).toNat : ℤ) =
      Multiplicative.toAdd (WithZero.unzero (x := Ring.ordFrac (R ⧸ q) f)
        ((hf.isUnit.map (Ring.ordFrac (R ⧸ q))).ne_zero)) := by
  classical
  let : Ring.KrullDimLE 1 (R ⧸ q) := Ring.krullDimLE_iff.mpr hdim.le
  induction l using Nat.strong_induction_on generalizing M N f with
  | h l ih =>
      by_cases hl : l = 0
      · have hyl : Set.range y = ∅ := by
          apply Set.eq_empty_iff_forall_notMem.mpr
          rintro z ⟨i, rfl⟩
          have hi := i.isLt
          omega
        have hbot : (⊥ : Submodule R N) = ⊤ := by simpa only [hyl, Submodule.span_empty] using hy
        have : Subsingleton N := (Submodule.subsingleton_iff R).mp
          (subsingleton_of_bot_eq_top hbot)
        have heq : eφ = eN := by
          apply Subtype.ext
          funext i
          exact Subsingleton.elim _ _
        have hsym : symbol eN ≠ 0 := symbol_ne_zero_of_generating
          (IsFiniteLength.of_subsingleton) eN (Subsingleton.elim _ _)
        have hf1 : f = 1 := smul_left_injective _ hsym (by
          change f • symbol eN = 1 • symbol eN
          rw [← hdet, heq, one_smul])
        subst f
        simp
        rfl
      · by_cases hl1 : l = 1
        · let i0 : Fin l := ⟨0, by omega⟩
          have hi0 (i : Fin l) : i = i0 := by
            apply Fin.ext
            have := i.isLt
            dsimp [i0]
            omega
          have : Nonempty (Fin l) := ⟨i0⟩
          have hxg : R ∙ x i0 = ⊤ := by
            simpa only [Set.range_eq_singleton_iff.mpr fun i => congrArg x (hi0 i)] using hx
          have hyg : R ∙ y i0 = ⊤ := by
            simpa only [Set.range_eq_singleton_iff.mpr fun i => congrArg y (hi0 i)] using hy
          have hxann := annihilator_eq_of_first_factor q x i0 rfl hxg (hxf i0)
          have hyann := annihilator_eq_of_first_factor q y i0 rfl hyg (hyf i0)
          obtain ⟨a, ha⟩ :=
            (Submodule.span_singleton_eq_top_iff R (y i0)).mp hyg (φ (x i0))
          have haq : a ∉ q := by
            intro haq
            have ha0 : a • y i0 = 0 := Module.mem_annihilator.mp (hyann.symm ▸ haq) _
            have hx0 : x i0 = 0 := hφ (by rw [← ha, ha0, map_zero])
            have h1 : (1 : R) ∈ Module.annihilator R M :=
              (scalar_mem_annihilator_iff_of_generator (x i0) hxg 1).mpr (by simp [hx0])
            exact q.one_notMem (hxann ▸ h1)
          have hau : IsUnit (algebraMap R (Localization.AtPrime q) a) :=
            (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime q) q a).mpr haq
          obtain ⟨au, hau⟩ := hau
          have hn1 : moduleLength (Localization.AtPrime q) (LocalizedModule q.primeCompl N) = 1 :=
            hφl.trans hl1
          have heq : eφ =
              ⟨fun i => (au : Localization.AtPrime q) • eN.1 i,
                admissible_units_smul eN.1 eN.2 (fun _ => au)⟩ := by
            apply Subtype.ext
            funext i
            change eφ.1 i = (au : Localization.AtPrime q) • eN.1 i
            rw [heφ, heN, hau, IsScalarTower.algebraMap_smul, LocalizedModule.smul'_mk,
              hi0 (Fin.cast hφl i), ha]
          have hsymbols : symbol eφ =
              IsLocalRing.residue (Localization.AtPrime q)
                  (algebraMap R (Localization.AtPrime q) a) •
                symbol eN := by
            rw [heq, symbol_units_smul]
            simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin, hn1, pow_one, hau]
          have hsymN := symbol_ne_zero_of_generating
            (finiteLength_localized_of_prime_filtration q y hy hyf) eN
            (span_localized_sequence_eq_top q y hy eN hφl heN)
          have hfval : f = algebraMap (R ⧸ q) q.ResidueField (Ideal.Quotient.mk q a) := by
            apply smul_left_injective _ hsymN
            change f • symbol eN = _ • symbol eN
            rw [algebraMap_quotient_residueField_mk_eq_residue, ← hdet, hsymbols]
          have hrange : LinearMap.range φ = R ∙ (a • y i0) := by
            rw [← Submodule.map_top, ← hxg, Submodule.map_span, Set.image_singleton, ← ha]
          have hqane : Ideal.Quotient.mk q a ≠ 0 :=
            fun hz => haq (Ideal.Quotient.eq_zero_iff_mem.mp hz)
          have hfmap : algebraMap (R ⧸ q) q.ResidueField (Ideal.Quotient.mk q a) ≠ 0 := hfval ▸ hf
          have hord := ordFrac_algebraMap_eq_length (Ideal.Quotient.mk q a) hqane hfmap
          subst f
          rw [hord, hrange, length_quotient_span_smul q (y i0) hyg hyann,
            length_quotient_sup_eq_ord_quotient]
          rfl
        · obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hl
          let i0 : Fin (n + 1) := ⟨0, by omega⟩
          have hx0 : x i0 ≠ 0 := by
            intro hx0
            have h1 : (1 : R) ∈ q := (smul_mem_iff_of_cyclic_factor
              (spanBefore (R := R) x i0) (x i0) q (hxf i0) 1).mp (by simp [hx0])
            exact q.one_notMem h1
          have hφx0 : φ (x i0) ≠ 0 := fun h => hx0 (hφ (h.trans (map_zero φ).symm))
          obtain ⟨i, a, t, hnot, haq, ht, hφx⟩ :=
            exists_pivot_of_prime_filtration q y hy hyf (φ (x i0)) hφx0
          clear hx0 hφx0
          induction i using Fin.induction generalizing M N f a with
          | zero =>
            have ht0 : t = 0 := by
              rwa [spanBefore_eq_bot_of_val_eq_zero y 0 rfl, Submodule.mem_bot] at ht
            have hφfirst : φ (x 0) = a • y 0 := by
              change φ (x 0) = t + a • y 0 at hφx
              simpa only [ht0, zero_add] using hφx
            let S := Localization.AtPrime q
            let U := R ∙ x 0
            let V := R ∙ y 0
            have hX : ∀ i r, r • x i ∈ spanBefore (R := R) x i ↔ r ∈ q :=
              fun i => smul_mem_iff_of_cyclic_factor _ _ q (hxf i)
            have hY : ∀ i r, r • y i ∈ spanBefore (R := R) y i ↔ r ∈ q :=
              fun i => smul_mem_iff_of_cyclic_factor _ _ q (hyf i)
            have hUV : U ≤ V.comap φ := by
              apply Submodule.span_le.mpr
              rintro z (rfl : z = x 0)
              change φ (x 0) ∈ V
              rw [hφfirst]
              exact V.smul_mem _ (Submodule.mem_span_singleton_self _)
            let ψ := U.mapQ V φ hUV
            have hψ : Function.Injective ψ :=
              injective_quotient_map_of_first_scalar q x (y 0) hx hX φ hφ a haq hφfirst hUV
            let xb : Fin n → M ⧸ U := fun i => U.mkQ (x i.succ)
            let yb : Fin n → N ⧸ V := fun i => V.mkQ (y i.succ)
            have hxb := span_quotient_tail_eq_top x hx
            have hyb := span_quotient_tail_eq_top y hy
            have hXb := prime_factors_quotient_tail q x hX
            have hYb := prime_factors_quotient_tail q y hY
            have hxbf := fun i => cyclic_factor_equiv_of_smul_mem_iff _ _ q (hXb i)
            have hybf := fun i => cyclic_factor_equiv_of_smul_mem_iff _ _ q (hYb i)
            have hψloc := (injective_iff_localizedMap_bijective_of_prime_filtrations
              q n xb yb hxb hxbf hyb hybf ψ).mp hψ
            obtain ⟨hQ, eQX, eQY, g, hg, hQX, hQY, hgdet⟩ :=
              exists_symbol_eq_smul_of_prime_filtration q xb yb hxb hXb hyb hYb ψ hψ
            have htail := ih n (Nat.lt_succ_self _) xb yb hxb hxbf hyb hybf ψ hψ
              eQX eQY hQ hQX hQY g hg hgdet
            have hfull := symbol_localized_eq_residue_mul_smul q (φ ∘ x) y hy hY a haq
              hφfirst eφ eN hφl heφ heN eQX eQY hQ hQX hQY g hg hgdet
            have hNne := symbol_ne_zero_of_generating
              (finiteLength_localized_of_prime_filtration q y hy hyf) eN
              (span_localized_sequence_eq_top q y hy eN hφl heN)
            have hres := algebraMap_quotient_residueField_mk_eq_residue q a
            have hfval : f = algebraMap (R ⧸ q) q.ResidueField (Ideal.Quotient.mk q a) * g := by
              apply smul_left_injective _ hNne
              rw [← hres] at hfull
              exact hdet.symm.trans hfull
            have ha0 : Ideal.Quotient.mk q a ≠ 0 := Ideal.Quotient.eq_zero_iff_mem.not.mpr haq
            have hamap : algebraMap (R ⧸ q) q.ResidueField (Ideal.Quotient.mk q a) ≠ 0 :=
              (mul_ne_zero_iff.mp (hfval ▸ hf)).1
            have hord := ordFrac_algebraMap_eq_length (Ideal.Quotient.mk q a) ha0 hamap
            have hlen := length_coker_eq_add_of_quotient_injective U V φ hUV hψ
            have hfirstlen := length_coker_eq_ord_of_scalar_generators q
              (⟨x 0, Submodule.mem_span_singleton_self _⟩ : U)
              (⟨y 0, Submodule.mem_span_singleton_self _⟩ : V)
              (span_cyclic_submodule_generator _) (span_cyclic_submodule_generator _)
              (annihilator_first_span q y hY)
              ((φ.domRestrict U).codRestrict V (fun z => hUV z.property)) a (Subtype.ext hφfirst)
            rw [hfirstlen] at hlen
            have hfirstfin : Ring.ord (R ⧸ q) (Ideal.Quotient.mk q a) ≠ ⊤ :=
              Ring.ord_ne_top (mem_nonZeroDivisors_of_ne_zero ha0)
            have htailfin := length_coker_ne_top_of_localized_surjective q yb hyb hYb ψ hψloc.2
            rw [hlen, ENat.toNat_add hfirstfin htailfin, Nat.cast_add, htail]
            subst f
            rw [order_fraction_mul _ _ hamap hg, hord]
            rfl
          | succ i hi =>
            let k : Fin (n + 1) := i.succ
            have hX : ∀ i r, r • x i ∈ spanBefore (R := R) x i ↔ r ∈ q :=
              fun i => smul_mem_iff_of_cyclic_factor _ _ q (hxf i)
            have hY : ∀ i r, r • y i ∈ spanBefore (R := R) y i ↔ r ∈ q :=
              fun i => smul_mem_iff_of_cyclic_factor _ _ q (hyf i)
            let xs : Fin (n + 1) → M := fun j => if j.val < 1 then x j else a • x j
            let ys : Fin (n + 1) → N := fun j => if j.val < k.val then y j else a • y j
            let PM := Submodule.span R (Set.range xs)
            let PN := Submodule.span R (Set.range ys)
            have hxmem (j) : xs j ∈ PM := Submodule.subset_span ⟨j, rfl⟩
            have hymem (j) : ys j ∈ PN := Submodule.subset_span ⟨j, rfl⟩
            let xp : Fin (n + 1) → PM := fun j => ⟨xs j, hxmem j⟩
            let yp : Fin (n + 1) → PN := fun j => ⟨ys j, hymem j⟩
            have hxpg : Submodule.span R (Set.range xp) = ⊤ :=
              (Submodule.span_range_subtype_eq_top_iff PM hxmem).mpr rfl
            have hypg : Submodule.span R (Set.range yp) = ⊤ :=
              (Submodule.span_range_subtype_eq_top_iff PN hymem).mpr rfl
            have hxp : ∀ j r, r • xp j ∈ spanBefore (R := R) xp j ↔ r ∈ q := by
              intro j r
              rw [← prime_factors_map_iff xp PM.subtype (Submodule.subtype_injective _) j r]
              exact prime_factors_scale_suffix q x hX a haq 1 j r
            have hyp : ∀ j r, r • yp j ∈ spanBefore (R := R) yp j ↔ r ∈ q := by
              intro j r
              rw [← prime_factors_map_iff yp PN.subtype (Submodule.subtype_injective _) j r]
              exact prime_factors_scale_suffix q y hY a haq k.val j r
            have hφx' : φ (x 0) = t + a • y k := hφx
            have hbound : PM ≤ PN.comap φ :=
              Submodule.map_le_iff_le_comap.mp (map_span_scale_suffix_le x y hy φ k a t ht hφx')
            let φ' : PM →ₗ[R] PN := (φ.domRestrict PM).codRestrict PN (fun z => hbound z.property)
            have hφ' : Function.Injective φ' := by
              intro z w h
              exact Subtype.ext (hφ (congrArg Subtype.val h))
            have hcomm : PN.subtype.comp φ' = φ.comp PM.subtype := rfl
            have ht' : t ∈ spanBefore (R := R) ys k := by
              rw [spanBefore_eq_spanPrefix, spanPrefix_scale_suffix_of_le y a le_rfl]
              exact ht
            have htPN : t ∈ PN := by
              change t ∈ Submodule.span R (Set.range ys)
              rw [← spanPrefix_length ys]
              exact spanPrefix_mono ys k.isLt.le ht'
            let tp : PN := ⟨t, htPN⟩
            have htp : tp ∈ spanBefore (R := R) yp k := by
              have hmap : (spanBefore (R := R) yp k).map PN.subtype =
                  spanBefore (R := R) ys k := spanPrefix_map yp PN.subtype k.val
              have hm : tp ∈ ((spanBefore (R := R) yp k).map PN.subtype).comap PN.subtype := by
                change t ∈ (spanBefore (R := R) yp k).map PN.subtype
                rw [hmap]
                exact ht'
              rwa [Submodule.comap_map_eq_of_injective (Submodule.subtype_injective _)] at hm
            let ya := Function.update yp k (yp k + tp)
            have hya : ∀ j r, r • ya j ∈ spanBefore (R := R) ya j ↔ r ∈ q :=
              prime_factors_update_add q yp hyp k tp htp
            have hφa : φ' (xp 0) = ya k := by
              apply Subtype.ext
              change φ (xs 0) = (Function.update yp k (yp k + tp) k).val
              rw [Function.update_self]
              change φ (if (0 : Fin (n + 1)).val < 1 then x 0 else a • x 0) =
                (if k.val < k.val then y k else a • y k) + t
              simp only [Fin.val_zero, Nat.zero_lt_one, ite_eq_left, lt_self_iff_false, ite_false]
              rw [hφx', add_comm]
            have hkill : ∀ r ∈ q, r • ya k = 0 := by
              intro r hr
              rw [← hφa, ← map_smul]
              have hzero : r • xp 0 = 0 := by
                have h := (hxp 0 r).mpr hr
                rwa [spanBefore_eq_bot_of_val_eq_zero xp 0 rfl, Submodule.mem_bot] at h
              rw [hzero, map_zero]
            let yf := ya ∘ Equiv.swap k i.castSucc
            have hyf' : ∀ j r, r • yf j ∈ spanBefore (R := R) yf j ↔ r ∈ q :=
              prime_factors_swap_adjacent q ya hya k i.castSucc (by simp [k])
                (fun r hr => by rw [hkill r hr]; exact Submodule.zero_mem _)
            have hyfg : Submodule.span R (Set.range yf) = ⊤ := by
              rw [← spanPrefix_length yf, spanPrefix_swap ya k i.castSucc (n + 1)
                (by constructor <;> intro _ <;> exact Fin.isLt _),
                spanPrefix_update_add yp k tp htp, spanPrefix_length]
              exact hypg
            have hφf : φ' (xp 0) = yf i.castSucc := by
              change φ' (xp 0) = ya (Equiv.swap k i.castSucc i.castSucc)
              rw [Equiv.swap_apply_right]
              exact hφa
            have hxf' := fun j => cyclic_factor_equiv_of_smul_mem_iff _ _ q (hxp j)
            have hyf'' := fun j => cyclic_factor_equiv_of_smul_mem_iff _ _ q (hyf' j)
            have hnewloc := (injective_iff_localizedMap_bijective_of_prime_filtrations
              q (n + 1) xp yf hxpg hxf' hyfg hyf'' φ').mp hφ'
            have hnewfin := length_coker_ne_top_of_localized_surjective q yf hyfg hyf' φ' hnewloc.2
            have hPMlen : Module.length R (M ⧸ PM) =
                n • Ring.ord (R ⧸ q) (Ideal.Quotient.mk q a) := by
              have h := length_quotient_scale_suffix q x hx hX a haq 1
              change Module.length R (M ⧸ PM) = (n + 1 - 1) •
                Ring.ord (R ⧸ q) (Ideal.Quotient.mk q a) at h
              simpa only [Nat.add_sub_cancel] using h
            have hPNlen : Module.length R (N ⧸ PN) =
                (n + 1 - k.val) • Ring.ord (R ⧸ q) (Ideal.Quotient.mk q a) :=
              length_quotient_scale_suffix q y hy hY a haq k.val
            have hsquare := length_coker_commutative_square PM.subtype PN.subtype φ' φ
              (Submodule.subtype_injective _) hφ hcomm
            rw [Submodule.range_subtype, Submodule.range_subtype, hPMlen, hPNlen] at hsquare
            let S := Localization.AtPrime q
            have hPNloclen := localized_length_of_generating q yf hyfg hyf''
            obtain ⟨hPNn, eNewX, eNewY, f', hf', hXe, hYe, hf'det⟩ :=
              exists_symbol_eq_smul_of_prime_filtration q xp yf hxpg hxp hyfg hyf' φ' hφ'
            have hone : (1 : R) ∉ q := q.one_notMem
            have hnotnew : φ' (xp 0) ∉ spanBefore (R := R) yf i.castSucc := by
              intro h
              apply hone
              apply (hyf' i.castSucc 1).mp
              simpa only [one_smul, ← hφf] using h
            have hnext := hi φ' hφ' eNewX eNewY f' hf' hf'det xp yf hxpg hxf' hyfg hyf''
              hPNn hXe hYe 1 0 hnotnew hone (Submodule.zero_mem _)
              (by
                change φ' (xp 0) = 0 + 1 • yf i.castSucc
                simpa only [zero_add, one_smul] using hφf)
            have hNloclen := localized_length_of_generating q y hy hyf
            have hPinj := LocalizedModule.map_injective q.primeCompl PN.subtype
              (Submodule.subtype_injective PN)
            have hPsurj := surjective_of_injective_of_length_eq
              (LocalizedModule.map q.primeCompl PN.subtype) (n + 1) hPinj
              hPNloclen hNloclen
            let E : LocalizedModule q.primeCompl PN ≃ₗ[S]
                LocalizedModule q.primeCompl N :=
              LinearEquiv.ofBijective (LocalizedModule.map q.primeCompl PN.subtype)
                ⟨hPinj, hPsurj⟩
            have hlenE : moduleLength S (LocalizedModule q.primeCompl PN) =
                moduleLength S (LocalizedModule q.primeCompl N) := hPNn.trans hφl.symm
            let eNX := admissibleSequenceMap E hlenE eNewX
            let eNY := admissibleSequenceMap E hlenE eNewY
            have hrel : symbol eNX = f' • symbol eNY :=
              (symbol_relation_iff_of_equiv E hlenE eNewX eNewY eNX eNY
                (fun _ => rfl) (fun _ => rfl) f').mp hf'det
            obtain ⟨au, hau⟩ :=
              (IsLocalization.AtPrime.isUnit_to_map_iff S q a).mpr haq
            let ux : Fin (moduleLength S (LocalizedModule q.primeCompl N)) → Sˣ :=
              fun j => if j.val < 1 then 1 else au
            let exs : AdmissibleSequence S (LocalizedModule q.primeCompl N) :=
              ⟨fun j => (ux j : S) • eφ.1 j,
                admissible_units_smul eφ.1 eφ.2 ux⟩
            have hscaleX : symbol exs =
                IsLocalRing.residue S au ^ n • symbol eφ := by
              have h := symbol_scale_suffix eφ exs au 1 (by
                intro j
                change ((if j.val < 1 then 1 else au : Sˣ) : S) • eφ.1 j = _
                split_ifs <;> simp)
              simpa only [hφl, Nat.succ_eq_add_one, Nat.add_sub_cancel_right] using h
            let uy : Fin (moduleLength S (LocalizedModule q.primeCompl N)) → Sˣ :=
              fun j => if j.val < k.val then 1 else au
            let eys : AdmissibleSequence S (LocalizedModule q.primeCompl N) :=
              ⟨fun j => (uy j : S) • eN.1 j,
                admissible_units_smul eN.1 eN.2 uy⟩
            have hscaleY : symbol eys =
                IsLocalRing.residue S au ^ (n + 1 - k.val) • symbol eN := by
              have h := symbol_scale_suffix eN eys au k.val (by
                intro j
                change ((if j.val < k.val then 1 else au : Sˣ) : S) • eN.1 j = _
                split_ifs <;> simp)
              simpa only [hφl] using h
            have hidx (j : Fin (moduleLength S (LocalizedModule q.primeCompl N))) :
                Fin.cast hPNn (Fin.cast hlenE.symm j) = Fin.cast hφl j := Fin.ext rfl
            have hex (j) : eNX.1 j = exs.1 j := by
              change E (eNewX.1 (Fin.cast hlenE.symm j)) = _
              rw [hXe, hidx, show E (LocalizedModule.mk (φ' (xp (Fin.cast hφl j))) 1) =
                  LocalizedModule.mk (φ (xs (Fin.cast hφl j))) 1 from by
                    change LocalizedModule.map q.primeCompl PN.subtype _ = _
                    rw [LocalizedModule.map_mk]
                    rfl]
              by_cases hj : j.val < 1
              · change LocalizedModule.mk
                    (φ (if (Fin.cast hφl j).val < 1 then x (Fin.cast hφl j)
                      else a • x (Fin.cast hφl j))) 1 =
                    ((if j.val < 1 then 1 else au : Sˣ) : S) • eφ.1 j
                simp only [Fin.val_cast]
                simp only [ite_eq_left hj, heφ j]
                simp
              · change LocalizedModule.mk
                    (φ (if (Fin.cast hφl j).val < 1 then x (Fin.cast hφl j)
                      else a • x (Fin.cast hφl j))) 1 =
                    ((if j.val < 1 then 1 else au : Sˣ) : S) • eφ.1 j
                simp only [Fin.val_cast]
                simp only [ite_eq_right hj, heφ j, map_smul, hau,
                  IsScalarTower.algebraMap_smul, LocalizedModule.smul'_mk]
            have hey (j) : eys.1 j =
                LocalizedModule.mk (ys (Fin.cast hφl j)) 1 := by
              by_cases hj : j.val < k.val
              · change ((if j.val < k.val then 1 else au : Sˣ) : S) • eN.1 j =
                    LocalizedModule.mk
                      (if (Fin.cast hφl j).val < k.val then y (Fin.cast hφl j)
                        else a • y (Fin.cast hφl j)) 1
                simp only [Fin.val_cast]
                simp only [ite_eq_left hj, heN j]
                simp
              · change ((if j.val < k.val then 1 else au : Sˣ) : S) • eN.1 j =
                    LocalizedModule.mk
                      (if (Fin.cast hφl j).val < k.val then y (Fin.cast hφl j)
                        else a • y (Fin.cast hφl j)) 1
                simp only [Fin.val_cast]
                simp only [ite_eq_right hj, heN j, hau,
                  IsScalarTower.algebraMap_smul, LocalizedModule.smul'_mk]
            let yA := Function.update ys k (ys k + t)
            have hyaN (j) : (ya j).val = yA j := by
              by_cases hj : j = k <;> simp [ya, yA, yp, tp, hj]
            have hYA : ∀ j r, r • yA j ∈ spanBefore (R := R) yA j ↔ r ∈ q := by
              have heq : yA = PN.subtype ∘ ya := by
                funext j
                exact (hyaN j).symm
              intro j r
              rw [heq]
              exact (prime_factors_map_iff ya PN.subtype
                (Submodule.subtype_injective _) j r).trans (hya j r)
            have hkillN : ∀ r ∈ q, r • yA k = 0 := by
              intro r hr
              rw [← hyaN]
              exact congrArg Subtype.val (hkill r hr)
            let eAY : AdmissibleSequence S (LocalizedModule q.primeCompl N) :=
              ⟨fun j => LocalizedModule.mk (yA (Fin.cast hφl j)) 1,
                admissible_cast hφl (fun j => LocalizedModule.mk (yA j) (1 : q.primeCompl))
                  (admissible_localized q yA (fun j r hr => (hYA j r).mpr hr))⟩
            have heNY (j) : eNY.1 j =
                LocalizedModule.mk (yA (Equiv.swap k i.castSucc (Fin.cast hφl j))) 1 := by
              change E (eNewY.1 (Fin.cast hlenE.symm j)) = _
              rw [hYe, hidx]
              change LocalizedModule.map q.primeCompl PN.subtype _ = _
              rw [LocalizedModule.map_mk]
              exact congrArg (fun z : N => LocalizedModule.mk z 1)
                (hyaN (Equiv.swap k i.castSucc (Fin.cast hφl j)))
            have hswap : symbol eAY = -symbol eNY :=
              symbol_localized_swap_adjacent q yA eAY eNY hφl
                (fun _ => rfl) k i.castSucc (by simp [k]) hkillN heNY
            let kk : Fin (moduleLength S (LocalizedModule q.primeCompl N)) :=
              Fin.cast hφl.symm k
            have hbefore : LocalizedModule.mk t (1 : q.primeCompl) ∈
                spanBefore (R := S) eys.1 kk := by
              have hspan : (spanBefore (R := R) ys k).localized' S q.primeCompl
                  (LocalizedModule.mkLinearMap q.primeCompl N) =
                  spanBefore (R := S) eys.1 kk := by
                have heys : eys.1 = fun j =>
                    (fun j' : Fin (n + 1) =>
                      LocalizedModule.mk (ys j') (1 : q.primeCompl)) (Fin.cast hφl j) :=
                  funext hey
                rw [heys, spanBefore_cast hφl
                  (fun j' : Fin (n + 1) => LocalizedModule.mk (ys j') (1 : q.primeCompl)) kk]
                simp only [spanBefore, Submodule.localized'_span, Set.image_image,
                  LocalizedModule.mkLinearMap_apply]
                have hk : Fin.cast hφl kk = k := Fin.ext rfl
                rw [hk]
              rw [← hspan]
              exact (Submodule.mem_localized' S q.primeCompl
                (LocalizedModule.mkLinearMap q.primeCompl N) _ _).mpr
                  ⟨t, ht', 1, by simp⟩
            have hupdate : symbol eAY = symbol eys := by
              have heq : eAY = ⟨Function.update eys.1 kk
                  (eys.1 kk + LocalizedModule.mk t (1 : q.primeCompl)),
                  admissible_update_add eys kk _ hbefore⟩ := by
                apply Subtype.ext
                funext j
                change LocalizedModule.mk (yA (Fin.cast hφl j)) 1 =
                  Function.update eys.1 kk (eys.1 kk + LocalizedModule.mk t 1) j
                by_cases hj : j = kk
                · subst j
                  rw [Function.update_self]
                  have hk : Fin.cast hφl kk = k := Fin.ext rfl
                  rw [hey kk, hk]
                  change LocalizedModule.mk (yA k) 1 =
                    LocalizedModule.mk (ys k) 1 + LocalizedModule.mk t 1
                  simp [yA]
                · rw [Function.update_of_ne hj, hey j]
                  have hjk : Fin.cast hφl j ≠ k := by
                    intro h
                    apply hj
                    apply Fin.ext
                    change j.val = k.val
                    exact congrArg Fin.val h
                  change LocalizedModule.mk (yA (Fin.cast hφl j)) 1 =
                    LocalizedModule.mk (ys (Fin.cast hφl j)) 1
                  simp [yA, hjk]
              exact (congrArg symbol heq).trans (symbol_update_add eys kk _ hbefore)
            have hNne := symbol_ne_zero_of_generating
              (finiteLength_localized_of_prime_filtration q y hy hyf) eN
              (span_localized_sequence_eq_top q y hy eN hφl heN)
            let A := IsLocalRing.residue S au
            have hA : A ≠ 0 := (Units.isUnit au |>.map (IsLocalRing.residue S)).ne_zero
            have hsym : A ^ n • (f • symbol eN) =
                f' • (-(A ^ (n + 1 - k.val) • symbol eN)) := by
              calc
                A ^ n • (f • symbol eN) = symbol exs := by rw [hscaleX, hdet]
                _ = symbol eNX := by congr 1; exact Subtype.ext (funext hex) |>.symm
                _ = f' • symbol eNY := hrel
                _ = f' • (-(symbol eAY)) := by rw [hswap]; simp
                _ = f' • (-(symbol eys)) := by rw [hupdate]
                _ = f' • (-(A ^ (n + 1 - k.val) • symbol eN)) := by rw [hscaleY]
            have hscalar : A ^ n * f = -(f' * A ^ (n + 1 - k.val)) := by
              apply smul_left_injective _ hNne
              simpa only [mul_smul, smul_neg, neg_smul] using hsym
            have hpow : A ^ n = A ^ i.val * A ^ (n + 1 - k.val) := by
              rw [← pow_add]
              congr 1
              have := i.isLt
              simp only [k, Fin.val_succ]
              omega
            have hf'val : f' = -(A ^ i.val) * f := by
              apply mul_right_cancel₀ (pow_ne_zero _ hA)
              calc
                f' * A ^ (n + 1 - k.val) = -(A ^ n * f) := by linear_combination hscalar
                _ = -(A ^ i.val) * f * A ^ (n + 1 - k.val) := by rw [hpow]; ring
            let b : R ⧸ q := Ideal.Quotient.mk q a
            have hb : b ≠ 0 := Ideal.Quotient.eq_zero_iff_mem.not.mpr haq
            have hAeq : A = algebraMap (R ⧸ q) q.ResidueField b := by
              exact ((algebraMap_quotient_residueField_mk_eq_residue q a).trans
                (by rw [← hau])).symm
            have hbmap : algebraMap (R ⧸ q) q.ResidueField b ≠ 0 := hAeq ▸ hA
            have hbpow : -(b ^ i.val) ≠ 0 :=
              neg_ne_zero.mpr (pow_ne_zero _ hb)
            have hbpowmap : algebraMap (R ⧸ q) q.ResidueField (-(b ^ i.val)) ≠ 0 := by
              rw [map_neg, map_pow]
              exact neg_ne_zero.mpr (pow_ne_zero _ hbmap)
            have hf'form : f' =
                algebraMap (R ⧸ q) q.ResidueField (-(b ^ i.val)) * f := by
              rw [hf'val, map_neg, map_pow, ← hAeq]
            let B : ℤ := ((Ring.ord (R ⧸ q) b).toNat : ℤ)
            have hordA : Multiplicative.toAdd
                (WithZero.unzero (x := Ring.ordFrac (R ⧸ q) A)
                  ((hA.isUnit.map (Ring.ordFrac (R ⧸ q))).ne_zero)) = B := by
              have h := ordFrac_algebraMap_eq_length b hb hbmap
              change _ = B at h
              have heq : WithZero.unzero
                    ((hA.isUnit.map (Ring.ordFrac (R ⧸ q))).ne_zero) =
                  WithZero.unzero
                    ((hbmap.isUnit.map (Ring.ordFrac (R ⧸ q))).ne_zero) := by
                rw [← WithZero.coe_inj]
                simpa only [WithZero.coe_unzero] using
                  congrArg (Ring.ordFrac (R ⧸ q)) hAeq
              exact (congrArg Multiplicative.toAdd heq).trans h
            have hordPow : Multiplicative.toAdd
                (WithZero.unzero (x := Ring.ordFrac (R ⧸ q)
                    (algebraMap (R ⧸ q) q.ResidueField (-(b ^ i.val))))
                  ((hbpowmap.isUnit.map (Ring.ordFrac (R ⧸ q))).ne_zero)) =
                (i.val : ℤ) * B := by
              have h := ordFrac_algebraMap_eq_length (-(b ^ i.val)) hbpow hbpowmap
              change _ = ((Ring.ord (R ⧸ q) (-(b ^ i.val))).toNat : ℤ) at h
              rw [h]
              change ((Ring.ord (R ⧸ q) (-(b ^ i.val))).toNat : ℤ) =
                (i.val : ℤ) * ((Ring.ord (R ⧸ q) b).toNat : ℤ)
              rw [Ring.ord_neg, Ring.ord_pow (mem_nonZeroDivisors_of_ne_zero hb),
                nsmul_eq_mul, ENat.toNat_mul]
              simp
            have hF'ord : Multiplicative.toAdd
                (WithZero.unzero (x := Ring.ordFrac (R ⧸ q) f')
                  ((hf'.isUnit.map (Ring.ordFrac (R ⧸ q))).ne_zero)) =
                (i.val : ℤ) * B +
                  Multiplicative.toAdd
                    (WithZero.unzero (x := Ring.ordFrac (R ⧸ q) f)
                      ((hf.isUnit.map (Ring.ordFrac (R ⧸ q))).ne_zero)) := by
              have h := order_fraction_mul (D := R ⧸ q) (K := q.ResidueField)
                (algebraMap (R ⧸ q) q.ResidueField (-(b ^ i.val))) f hbpowmap hf
              rw [hordPow] at h
              simpa only [hf'form] using h
            have hordfinite : Ring.ord (R ⧸ q) b ≠ ⊤ :=
              Ring.ord_ne_top (mem_nonZeroDivisors_of_ne_zero hb)
            have hPMfinite : Module.length R (M ⧸ PM) ≠ ⊤ := by
              rw [hPMlen, nsmul_eq_mul]
              exact WithTop.mul_ne_top (ENat.natCast_ne_top _) hordfinite
            have hPNfinite : Module.length R (N ⧸ PN) ≠ ⊤ := by
              rw [hPNlen, nsmul_eq_mul]
              exact WithTop.mul_ne_top (ENat.natCast_ne_top _) hordfinite
            have hfullLoc := (injective_iff_localizedMap_bijective_of_prime_filtrations
              q (n + 1) x y hx hxf hy hyf φ).mp hφ
            have hfullfinite :=
              length_coker_ne_top_of_localized_surjective q y hy hY φ hfullLoc.2
            have hPMvalue : ((Module.length R (M ⧸ PM)).toNat : ℤ) = (n : ℤ) * B := by
              rw [hPMlen, nsmul_eq_mul, ENat.toNat_mul]
              simp only [ENat.toNat_natCast]
              change (((n * (Ring.ord (R ⧸ q) b).toNat : ℕ) : ℤ)) =
                (n : ℤ) * ((Ring.ord (R ⧸ q) b).toNat : ℤ)
              norm_cast
            have hPNvalue : ((Module.length R (N ⧸ PN)).toNat : ℤ) =
                ((n + 1 - k.val : ℕ) : ℤ) * B := by
              rw [hPNlen, nsmul_eq_mul, ENat.toNat_mul]
              simp only [ENat.toNat_natCast]
              change ((((n + 1 - k.val) * (Ring.ord (R ⧸ q) b).toNat : ℕ) : ℤ)) =
                ((n + 1 - k.val : ℕ) : ℤ) * ((Ring.ord (R ⧸ q) b).toNat : ℤ)
              norm_cast
            have hsquareZ :
                ((Module.length R (PN ⧸ LinearMap.range φ')).toNat : ℤ) +
                  ((Module.length R (N ⧸ PN)).toNat : ℤ) =
                ((Module.length R (M ⧸ PM)).toNat : ℤ) +
                  ((Module.length R (N ⧸ LinearMap.range φ)).toNat : ℤ) := by
              have hsquare' : Module.length R (PN ⧸ LinearMap.range φ') +
                  Module.length R (N ⧸ PN) =
                    Module.length R (M ⧸ PM) +
                      Module.length R (N ⧸ LinearMap.range φ) := by
                simpa only [hPMlen, hPNlen] using hsquare
              have h := congrArg ENat.toNat hsquare'
              rw [ENat.toNat_add hnewfin hPNfinite,
                ENat.toNat_add hPMfinite hfullfinite] at h
              exact_mod_cast h
            have hcoeff : (i.val : ℤ) + ((n + 1 - k.val : ℕ) : ℤ) = n := by
              have hi := i.isLt
              simp only [k, Fin.val_succ]
              omega
            rw [hnext, hF'ord, hPNvalue, hPMvalue] at hsquareZ
            linear_combination -hsquareZ + hcoeff * B

end Module.FiniteLength
