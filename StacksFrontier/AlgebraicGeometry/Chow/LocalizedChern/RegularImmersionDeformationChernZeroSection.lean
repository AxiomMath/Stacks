/-!
# The vertex of the normal cone is the zero section of the projective completion

Let `ℰ` be a finite locally free module on a scheme `X`, `P = 𝐏(ℰ ⊕ 𝒪_X)` its projective
completion and `𝐕(ℰ) ⊆ P` the vector bundle, the complement of the divisor at infinity. There are
two zero sections: the closed immersion `𝐏(𝒪_X) ⟶ P` induced by the projection
`ℰ ⊕ 𝒪_X ⟶ 𝒪_X` (`Stacks.ProjectiveCompletion.zeroSection`, the one of Stacks 0FEF), and the
zero section `X ⟶ 𝐕(ℰ)` of the vector bundle followed by `𝐕(ℰ) ⊆ P`. This file proves that they
cut out the same closed subscheme of `P`, when `X` is locally Noetherian and `ℰ` has constant
rank. Over an affine open `U` on which `ℰ` is free on `c₁, …, c_r`, `P` is covered by the images
of the standard opens `D₊(T)` and `D₊(c_k)` of `Proj Γ(U, Sym(ℰ ⊕ 𝒪_X))`; on `D₊(T) = 𝐕(ℰ|_U)`
both ideals are generated by the functions `c_j / T`, and both closed immersions miss the
complement of `𝐕(ℰ)`.

In the proof of Stacks 0FEG this identifies the vertex `Z ⟶ C_ZX ⟶ E` of the normal cone inside
the exceptional divisor `E ≅ 𝐏(𝒞 ⊕ 𝒪_Z)` of the blowup of `𝐏¹_X` in `∞(Z)`, `𝒞` the conormal
sheaf of a regular immersion `Z ⟶ X`, with the zero section of Stacks 0FEF.

## Main results

* `Stacks.ProjectiveCompletion.ker_vectorBundleZeroSection_comp_toCompletion` — the two zero
  sections of `𝐏(ℰ ⊕ 𝒪_X)` have the same ideal sheaf.
* `Stacks.ProjectiveCompletion.ideal_ker_vectorBundleZeroSection_comp_toCompletion` — the ideal of
  the zero section of `𝐕(ℰ) ⊆ P` on a chart.
* `Stacks.ProjectiveCompletion.range_zeroSection_subset_range_toCompletion` — the zero section of
  `P` lies in `𝐕(ℰ)`.
* `Stacks.Chow.vertex_comp_exceptionalDivisorIsoProjectiveCompletion_hom` — under
  `E ≅ 𝐏(𝒞 ⊕ 𝒪_Z)` the vertex of the normal cone is the zero section of the normal bundle.
* `Stacks.Chow.ker_vertex_comp_exceptionalDivisorIsoProjectiveCompletion_hom` — the vertex and
  the zero section of `𝐏(𝒞 ⊕ 𝒪_Z)` have the same ideal sheaf.

## Implementation notes

The two zero sections have different sources, `X` and `𝐏(𝒪_X)`; comparing their ideal sheaves
avoids identifying `𝐏(𝒪_X)` with `X`. Two closed immersions with the same ideal sheaf are
isomorphic over their target (`Stacks.AlgebraicGeometry.KerChart.isoOfKerEq`), which is how the
comparison is used.

## References

* [Stacks Project, Tag 0FEG](https://stacks.math.columbia.edu/tag/0FEG)
* [Stacks Project, Tag 0FEF](https://stacks.math.columbia.edu/tag/0FEF)
* [Stacks Project, Tag 02TY](https://stacks.math.columbia.edu/tag/02TY)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open Stacks.AffineAlgebraEquivalence HomogeneousLocalization Stacks.AlgebraicGeometry.RelativeProj

universe u

namespace Stacks.ProjectiveCompletion

variable {X : Scheme.{u}} {E : X.Modules}
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]

/-- The open immersion `D₊(T) ⟶ Proj` of the completion algebra over `U` lands in `D₊(T)`. -/
private theorem top_le_preimage_awayι_basicOpen_infinitySection (E : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] (U : X.Opens) :
    ⊤ ≤ Proj.awayι ((completionAlgebra E).grading U) (infinitySection E U)
      (infinitySection_mem E U) one_pos ⁻¹ᵁ
        Proj.basicOpen ((completionAlgebra E).grading U) (infinitySection E U) := by
  intro x _
  change x ∈ Proj.awayι ((completionAlgebra E).grading U) (infinitySection E U)
    (infinitySection_mem E U) one_pos ⁻¹ᵁ
      Proj.basicOpen ((completionAlgebra E).grading U) (infinitySection E U)
  rw [Scheme.Hom.mem_preimage, ← Proj.opensRange_awayι ((completionAlgebra E).grading U)
    (infinitySection E U) (infinitySection_mem E U) one_pos]
  exact ⟨x, rfl⟩

/-- **The chart `Spec Γ(U, Sym(ℰ)) ⟶ D₊(T)` on the functions `n / T`.** Pulled back along the
chart `Spec Γ(U, Sym(ℰ)) ⟶ P` of `Stacks.ProjectiveCompletion.chartToCompletion`, the function
`n / T` on the image of `D₊(T)` is the dehomogenization of the degree-one element `n`. -/
theorem chartToCompletion_appLE_chartFractionOn {U : X.Opens} (hU : IsAffineOpen U)
    (n : Γ(completionModule E, U))
    (h : ⊤ ≤ chartToCompletion (E := E) hU ⁻¹ᵁ chartBasicOpen hU (sectionsSplitting E U).t₀) :
    ((chartToCompletion (E := E) hU).appLE (chartBasicOpen hU (sectionsSplitting E U).t₀) ⊤
        h).hom (chartFractionOn hU (sectionsSplitting E U).t₀ n) =
      (Scheme.ΓSpecIso _).inv.hom (sectionsDehomogenize hU (completionDegreeOne E U n)) := by
  have hD := top_le_preimage_awayι_basicOpen_infinitySection E U
  set ch := (relativeProj (completionAlgebra E)).chart U hU
  set aw := Proj.awayι ((completionAlgebra E).grading U) (infinitySection E U)
    (infinitySection_mem E U) one_pos
  set φ := CommRingCat.ofHom
    (R := Away ((completionAlgebra E).grading U) (infinitySection E U))
    (S := ((Scheme.Modules.symmetricAlgebraSheaf X E).right.obj.obj (op U) : CommRingCat))
    (chartRingEquiv hU).symm.toRingHom
  have e1 : ch.appLE (chartBasicOpen hU (sectionsSplitting E U).t₀)
        (Proj.basicOpen ((completionAlgebra E).grading U) (infinitySection E U))
        (by rw [Scheme.Hom.preimage_image_eq]; exact le_rfl) ≫
      aw.appLE _ ⊤ hD ≫ (Spec.map φ).appLE ⊤ ⊤ le_top =
      (Spec.map φ ≫ aw ≫ ch).appLE (chartBasicOpen hU (sectionsSplitting E U).t₀) ⊤ h :=
    (congrArg (_ ≫ ·) (Scheme.Hom.appLE_comp_appLE (Spec.map φ) aw _ ⊤ ⊤ hD le_top)).trans
      (Scheme.Hom.appLE_comp_appLE _ ch _ _ _ _ _)
  change ((Spec.map φ ≫ aw ≫ ch).appLE (chartBasicOpen hU (sectionsSplitting E U).t₀) ⊤ h).hom
    (chartFractionOn hU (sectionsSplitting E U).t₀ n) = _
  rw [← e1, CommRingCat.comp_apply, CommRingCat.comp_apply]
  have s1 : (ch.appLE (chartBasicOpen hU (sectionsSplitting E U).t₀)
        (Proj.basicOpen ((completionAlgebra E).grading U) (infinitySection E U))
        (by rw [Scheme.Hom.preimage_image_eq]; exact le_rfl)).hom
        (chartFractionOn hU (sectionsSplitting E U).t₀ n) =
      Stacks.ProjectiveSpace.degreeOneChartFraction _ (completionDegreeOne_mem E U _)
        (completionDegreeOne_mem E U n) := by
    have := congrArg (fun g => g.hom (Stacks.ProjectiveSpace.degreeOneChartFraction _
        (completionDegreeOne_mem E U (sectionsSplitting E U).t₀) (completionDegreeOne_mem E U n)))
      (Scheme.Hom.appIso_inv_appLE ch (U := Proj.basicOpen ((completionAlgebra E).grading U)
        (infinitySection E U)) (V := Proj.basicOpen ((completionAlgebra E).grading U)
        (infinitySection E U)) (by rw [Scheme.Hom.preimage_image_eq]))
    simp only [CommRingCat.comp_apply, homOfLE_refl, op_id, CategoryTheory.Functor.map_id,
      CommRingCat.id_apply] at this
    exact this
  rw [s1]
  have s2 := Stacks.AlgebraicGeometry.ProjTwistChain.appLE_awayι_awayToSection one_pos
    (infinitySection_mem E U) hD (Away.mk _ (infinitySection_mem E U) 1
      (completionDegreeOne E U n) (by simpa using completionDegreeOne_mem E U n))
  refine (congrArg _ s2).trans ?_
  have s3 : (Spec.map φ).appLE ⊤ ⊤ le_top = (Spec.map φ).appTop := by
    rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
    rfl
  rw [s3, ← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.comp_apply]
  congr 1
  exact chartRingEquiv_symm_mk hU 1 _ _

/-- **The zero section of `𝐕(ℰ)` kills the generators of `Sym(ℰ)`**: over an affine open `U`,
the function on `𝐕(ℰ)|_U` given by a section `m` of `ℰ` pulls back to `0` along the zero section,
whose classifying map is `0`. -/
theorem vectorBundleZeroSection_appLE_symGenSection (U : X.affineOpens) (m : Γ(E, U.1))
    (hle : U.1 ≤ Scheme.Modules.vectorBundleLiftZero E ⁻¹ᵁ
      ((relativeSpecGluingData (Scheme.Modules.symmetricAlgebraSheaf X E)).toBase ⁻¹ᵁ U.1)) :
    ((Scheme.Modules.vectorBundleLiftZero E).appLE
        ((relativeSpecGluingData (Scheme.Modules.symmetricAlgebraSheaf X E)).toBase ⁻¹ᵁ U.1) U.1
        hle).hom
      ((pushforwardAlgebraIso (Scheme.Modules.symmetricAlgebraSheaf X E)).inv.right.hom.app
        (op U.1) (symGenSection E U.1 m)) = 0 := by
  have h := congrArg (fun φ => (φ.val.app (op U.1)).hom m)
    (Scheme.Modules.vectorBundleClassifyingMap_vectorBundleLiftZeroOver E)
  simp only [Scheme.Modules.vectorBundleClassifyingMap] at h
  have e1 : (SymAlgSheaf.symmetricAlgebraSheafι E).val.app (op U.1) m = symGenSection E U.1 m := rfl
  have e2 := pushforwardAlgebraMap_app (Scheme.Modules.vectorBundleLiftZeroOver E) U.1
    (preimage_le_preimage_preimage _ _)
  have e3 : ((SymAlgSheaf.symmetricAlgebraSheafι E ≫
      RelativeSpec.AlgebraSheaf.underlyingModuleMap
        ((Scheme.Modules.vectorBundlePushforwardIso X).inv ≫
          pushforwardAlgebraMap (Scheme.Modules.vectorBundleLiftZeroOver E))).val.app
            (op U.1)).hom m =
      ((pushforwardAlgebraMap (Scheme.Modules.vectorBundleLiftZeroOver E)).right.hom.app
        (op U.1)).hom
      (((Scheme.Modules.vectorBundlePushforwardIso X (F := E)).inv.right.hom.app (op U.1)).hom
        ((SymAlgSheaf.symmetricAlgebraSheafι E).val.app (op U.1) m)) := rfl
  rwa [e3, e2, e1] at h

/-- **The open immersion `𝐕(ℰ) ⟶ P` on the functions `n / T`.** Over an affine open `U`, the
function `n / T` on the image of `D₊(T)` pulls back along `𝐕(ℰ) ⟶ P` to the function on `𝐕(ℰ)|_U`
given by the dehomogenization of `n`. -/
theorem toCompletion_appLE_chartFractionOn (U : X.affineOpens) (n : Γ(completionModule E, U.1))
    (h : (relativeSpecGluingData (Scheme.Modules.symmetricAlgebraSheaf X E)).toBase ⁻¹ᵁ U.1 ≤
      toCompletion E ⁻¹ᵁ chartBasicOpen U.2 (sectionsSplitting E U.1).t₀) :
    ((toCompletion E).appLE (chartBasicOpen U.2 (sectionsSplitting E U.1).t₀) _ h).hom
        (chartFractionOn U.2 (sectionsSplitting E U.1).t₀ n) =
      (pushforwardAlgebraIso (Scheme.Modules.symmetricAlgebraSheaf X E)).inv.right.hom.app (op U.1)
        (sectionsDehomogenize U.2 (completionDegreeOne E U.1 n)) := by
  set A := Scheme.Modules.symmetricAlgebraSheaf X E
  set ι := colimit.ι (relativeSpecGluingData A).functor U
  have hι := le_ι_preimage (relativeSpecGluingData A) U
  have key := ι_appLE_pushforwardAlgebraIso_inv A U
  have hsurj : Function.Surjective ((pushforwardAlgebraIso A).inv.right.hom.app (op U.1)).hom :=
    fun a => ⟨((pushforwardAlgebraIso A).hom.right.hom.app (op U.1)).hom a,
      congrArg (fun φ : pushforwardAlgebra (relativeSpecToBase A) ⟶
        pushforwardAlgebra (relativeSpecToBase A) => (φ.right.hom.app (op U.1)).hom a)
        (pushforwardAlgebraIso A).hom_inv_id⟩
  have hinj :
      Function.Injective (ι.appLE ((relativeSpecGluingData A).toBase ⁻¹ᵁ U.1) ⊤ hι).hom := by
    intro a b hab
    obtain ⟨a', rfl⟩ := hsurj a
    obtain ⟨b', rfl⟩ := hsurj b
    rw [key, key] at hab
    rw [(ConcreteCategory.bijective_of_isIso
      (Scheme.ΓSpecIso (A.right.obj.obj (op U.1))).inv).1 hab]
  apply hinj
  rw [key]
  refine (congrArg (fun g => g.hom (chartFractionOn U.2 (sectionsSplitting E U.1).t₀ n))
    (Scheme.Hom.appLE_comp_appLE ι (toCompletion E) _ _ ⊤ h hι)).trans ?_
  have hc : ∀ (g : Spec (A.right.obj.obj (op U.1)) ⟶ projectiveCompletion E)
      (hg : g = chartToCompletion (E := E) U.2) (e : ⊤ ≤ g ⁻¹ᵁ chartBasicOpen U.2
        (sectionsSplitting E U.1).t₀),
      (g.appLE (chartBasicOpen U.2 (sectionsSplitting E U.1).t₀) ⊤ e).hom
        (chartFractionOn U.2 (sectionsSplitting E U.1).t₀ n) =
      (Scheme.ΓSpecIso _).inv.hom (sectionsDehomogenize U.2 (completionDegreeOne E U.1 n)) := by
    rintro g rfl e
    exact chartToCompletion_appLE_chartFractionOn U.2 n e
  exact hc _ (ι_toCompletion E U) _

/-- The dehomogenization of the degree-one element of a section `(c, 0)` of `ℰ ⊕ 𝒪_X` is the
degree-one generator `c` of `Sym(ℰ)`. -/
theorem sectionsDehomogenize_completionDegreeOne_inl {U : X.Opens} (hU : IsAffineOpen U)
    (c : Γ(E, U)) :
    sectionsDehomogenize hU (completionDegreeOne E U ((completionInl E).app U c)) =
      symGenSection E U c := by
  refine (sectionsDehomogenize_gen hU _).trans ?_
  have hp : (sectionsSplitting E U).p ((completionInl E).app U c) = c :=
    (sectionsSplitting E U).p_j c
  have hq : (sectionsSplitting E U).q ((completionInl E).app U c) = 0 :=
    (sectionsSplitting E U).q_j c
  exact (congrArg₂ (· + ·) (congrArg (symGenSection E U) hp)
    ((congrArg _ hq).trans (map_zero _))).trans (add_zero _)

/-- The chart `Spec Γ(U, Sym(ℰ)) ⟶ P` lands in the image of `D₊(T)`. -/
theorem top_le_preimage_chartToCompletion_chartBasicOpen {U : X.Opens} (hU : IsAffineOpen U) :
    ⊤ ≤ chartToCompletion (E := E) hU ⁻¹ᵁ chartBasicOpen hU (sectionsSplitting E U).t₀ := by
  intro z _
  change (chartToCompletion (E := E) hU).base z ∈ chartBasicOpen hU (sectionsSplitting E U).t₀
  rw [chartToCompletion_eq E ⟨U, hU⟩]
  exact ⟨_, top_le_preimage_awayι_basicOpen_infinitySection E U (Set.mem_univ z), rfl⟩

/-- `𝐕(ℰ) ⟶ P` maps the part of `𝐕(ℰ)` over an affine open `U` into the image of `D₊(T)`. -/
theorem toBase_preimage_le_preimage_toCompletion_chartBasicOpen (U : X.affineOpens) :
    (relativeSpecGluingData (Scheme.Modules.symmetricAlgebraSheaf X E)).toBase ⁻¹ᵁ U.1 ≤
      toCompletion E ⁻¹ᵁ chartBasicOpen U.2 (sectionsSplitting E U.1).t₀ := by
  rw [toBase_preimage_eq_opensRange (relativeSpecGluingData _) U]
  rintro _ ⟨z, rfl⟩
  have hz := top_le_preimage_chartToCompletion_chartBasicOpen (E := E) U.2 (Set.mem_univ z)
  rwa [← ι_toCompletion E U] at hz

/-- The zero section of `𝐕(ℰ)` maps the open `U` of `X` into the part of `𝐕(ℰ)` over `U`. -/
private theorem le_vectorBundleLiftZero_preimage_toBase_preimage (U : X.Opens) :
    U ≤ Scheme.Modules.vectorBundleLiftZero E ⁻¹ᵁ
      ((relativeSpecGluingData (Scheme.Modules.symmetricAlgebraSheaf X E)).toBase ⁻¹ᵁ U) := by
  intro x hx
  have e : Scheme.Modules.vectorBundleLiftZero E ≫
      (relativeSpecGluingData (Scheme.Modules.symmetricAlgebraSheaf X E)).toBase = 𝟙 X :=
    Scheme.Modules.vectorBundleLiftZero_toBase E
  change (Scheme.Modules.vectorBundleLiftZero E ≫
    (relativeSpecGluingData (Scheme.Modules.symmetricAlgebraSheaf X E)).toBase).base x ∈ U
  rw [e]
  exact hx

/-- **The zero section of `𝐕(ℰ) ⊆ P` kills the functions `c / T`**, for `c` a section of `ℰ`
over an affine open `U`: it kills the generators of `Sym(ℰ)`. -/
theorem vectorBundleZeroSection_comp_toCompletion_appLE_chartFractionOn (U : X.affineOpens)
    (c : Γ(E, U.1))
    (h : U.1 ≤ (Scheme.Modules.vectorBundleLiftZero E ≫ toCompletion E) ⁻¹ᵁ
      chartBasicOpen U.2 (sectionsSplitting E U.1).t₀) :
    ((Scheme.Modules.vectorBundleLiftZero E ≫ toCompletion E).appLE
        (chartBasicOpen U.2 (sectionsSplitting E U.1).t₀) U.1 h).hom
      (chartFractionOn U.2 (sectionsSplitting E U.1).t₀ ((completionInl E).app U.1 c)) = 0 := by
  have hle := le_vectorBundleLiftZero_preimage_toBase_preimage (E := E) U.1
  refine (congrArg (fun g => g.hom (chartFractionOn U.2 (sectionsSplitting E U.1).t₀
    ((completionInl E).app U.1 c))) (Scheme.Hom.appLE_comp_appLE _ _ _ _ _
      (toBase_preimage_le_preimage_toCompletion_chartBasicOpen U) hle).symm).trans ?_
  exact (congrArg ((Scheme.Modules.vectorBundleLiftZero E).appLE _ U.1 hle).hom
    (toCompletion_appLE_chartFractionOn U _
      (toBase_preimage_le_preimage_toCompletion_chartBasicOpen U))).trans
    ((congrArg (fun y => ((Scheme.Modules.vectorBundleLiftZero E).appLE _ U.1 hle).hom
      ((pushforwardAlgebraIso (Scheme.Modules.symmetricAlgebraSheaf X E)).inv.right.hom.app
        (op U.1) y)) (sectionsDehomogenize_completionDegreeOne_inl U.2 c)).trans
      (vectorBundleZeroSection_appLE_symGenSection U c hle))

/-- The zero section of `𝐕(ℰ) ⊆ P` is a section of `P ⟶ X`. -/
@[sga "5 VII 9.1" "(ii)"]
theorem vectorBundleZeroSection_comp_toCompletion_comp_projectiveCompletionProj :
    Scheme.Modules.vectorBundleLiftZero E ≫ toCompletion E ≫ projectiveCompletionProj E =
      𝟙 X := by
  rw [toCompletion_comp_projectiveCompletionProj]
  exact Scheme.Modules.vectorBundleLiftZero_toBase E

/-- The zero section of `𝐕(ℰ) ⊆ P` is a closed immersion, being a section of the separated
morphism `P ⟶ X`. -/
instance isClosedImmersion_vectorBundleZeroSection_comp_toCompletion :
    IsClosedImmersion (Scheme.Modules.vectorBundleLiftZero E ≫ toCompletion E) := by
  have : IsClosedImmersion ((Scheme.Modules.vectorBundleLiftZero E ≫ toCompletion E) ≫
      projectiveCompletionProj E) := by
    rw [Category.assoc, vectorBundleZeroSection_comp_toCompletion_comp_projectiveCompletionProj]
    infer_instance
  exact IsClosedImmersion.of_comp _ (projectiveCompletionProj E)

/-- The inverse image of the image of `D₊(T)` over an affine open `U` under the zero section of
`𝐕(ℰ) ⊆ P` is `U`. -/
theorem preimage_chartBasicOpen_vectorBundleZeroSection_comp_toCompletion (U : X.affineOpens) :
    (Scheme.Modules.vectorBundleLiftZero E ≫ toCompletion E) ⁻¹ᵁ
      chartBasicOpen U.2 (sectionsSplitting E U.1).t₀ = U.1 := by
  refine le_antisymm (fun x hx => ?_) (fun x hx => ?_)
  · have h1 := chartBasicOpen_le U.2 (sectionsSplitting E U.1).t₀ hx
    have h2 : ((Scheme.Modules.vectorBundleLiftZero E ≫ toCompletion E) ≫
        projectiveCompletionProj E).base x ∈ U.1 := h1
    rwa [Category.assoc, vectorBundleZeroSection_comp_toCompletion_comp_projectiveCompletionProj]
      at h2
  · exact toBase_preimage_le_preimage_toCompletion_chartBasicOpen U
      (le_vectorBundleLiftZero_preimage_toBase_preimage U.1 hx)

/-- **The ideal of the zero section of `𝐕(ℰ) ⊆ P` on a chart.** Over an affine open `U` on which
`ℰ` is free on `c`, the ideal of the zero section of `𝐕(ℰ) ⊆ P` on the image of `D₊(T)` is
generated by the functions `c_j / T`. That ring is the polynomial ring over `Γ(X, U)` in the
`c_j / T` (`Stacks.ProjectiveCompletion.exists_ringEquiv_mvPolynomial_chartBasicOpen`), the zero
section kills the variables, and the induced endomorphism of `Γ(X, U)` is surjective, the zero
section being a section of `P ⟶ X`, hence injective, `Γ(X, U)` being Noetherian. -/
theorem ideal_ker_vectorBundleZeroSection_comp_toCompletion [IsLocallyNoetherian X]
    (U : X.affineOpens) {r : ℕ} (c : Module.Basis (Fin r) Γ(X, U.1) Γ(E, U.1)) :
    (Scheme.Modules.vectorBundleLiftZero E ≫ toCompletion E).ker.ideal
        ⟨chartBasicOpen U.2 (sectionsSplitting E U.1).t₀, isAffineOpen_chartBasicOpen U.2 _⟩ =
      Ideal.span (Set.range fun j =>
        chartFractionOn U.2 (sectionsSplitting E U.1).t₀ ((completionInl E).app U.1 (c j))) := by
  set v := Scheme.Modules.vectorBundleLiftZero E ≫ toCompletion E
  set W : (projectiveCompletion E).Opens := chartBasicOpen U.2 (sectionsSplitting E U.1).t₀
  have hPre : v ⁻¹ᵁ W = U.1 :=
    preimage_chartBasicOpen_vectorBundleZeroSection_comp_toCompletion (E := E) U
  have hle : U.1 ≤ v ⁻¹ᵁ W := hPre.ge
  set ρ := v.appLE W U.1 hle
  have hρ : ρ = v.app W ≫ X.presheaf.map (homOfLE hle).op := rfl
  have : IsIso (homOfLE hle).op :=
    ⟨⟨(homOfLE hPre.le).op, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
  have hbij := ConcreteCategory.bijective_of_isIso (X.presheaf.map (homOfLE hle).op)
  have hker : RingHom.ker (v.app W).hom = RingHom.ker ρ.hom := by
    ext x
    rw [RingHom.mem_ker, RingHom.mem_ker, hρ, CommRingCat.comp_apply]
    exact ⟨fun h => by rw [h, map_zero], fun h => hbij.1 (h.trans (map_zero _).symm)⟩
  have hsurj : Function.Surjective ρ.hom := by
    rw [hρ, CommRingCat.hom_comp]
    exact hbij.2.comp (v.app_surjective W (isAffineOpen_chartBasicOpen U.2 _))
  have hzero : ∀ j, ρ.hom (chartFractionOn U.2 (sectionsSplitting E U.1).t₀
      ((completionInl E).app U.1 (c j))) = 0 := fun j =>
    vectorBundleZeroSection_comp_toCompletion_appLE_chartFractionOn U (c j) hle
  obtain ⟨Φ, hΦ⟩ := exists_ringEquiv_mvPolynomial_chartBasicOpen U.2 c
  set ψ : MvPolynomial (Fin r) Γ(X, U.1) →+* Γ(X, U.1) := ρ.hom.comp Φ.toRingHom
  have hψX : ∀ j, ψ (MvPolynomial.X j) = 0 := fun j => by
    change ρ.hom (Φ (MvPolynomial.X j)) = 0
    rw [hΦ]
    exact hzero j
  have hψ : ψ = (ψ.comp MvPolynomial.C).comp MvPolynomial.constantCoeff := by
    refine MvPolynomial.ringHom_ext (fun a => ?_) (fun j => ?_)
    · simp
    · rw [hψX, RingHom.comp_apply, MvPolynomial.constantCoeff_X, RingHom.comp_apply, map_zero,
        map_zero]
  have hψsurj : Function.Surjective ψ := hsurj.comp Φ.surjective
  have hCsurj : Function.Surjective (ψ.comp MvPolynomial.C) := fun y => by
    obtain ⟨p, rfl⟩ := hψsurj y
    exact ⟨MvPolynomial.constantCoeff p, (congrArg (fun g => g p) hψ).symm⟩
  have := IsLocallyNoetherian.component_noetherian U
  have hCinj := surjective_endomorphism_noetherian_injective _ _ hCsurj
  have hkerψ : RingHom.ker ψ = Ideal.span (Set.range MvPolynomial.X) := by
    ext p
    have e1 : ψ p = 0 ↔ MvPolynomial.constantCoeff p = 0 := by
      rw [show ψ p = (ψ.comp MvPolynomial.C) (MvPolynomial.constantCoeff p) from
        congrArg (fun g => g p) hψ]
      exact ⟨fun h => hCinj (h.trans (map_zero _).symm), fun h => by rw [h, map_zero]⟩
    rw [RingHom.mem_ker, e1, ← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    change p.coeff 0 = 0 ↔ _
    constructor
    · intro hp m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) hp
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨i, Set.mem_univ _, hi⟩
    · intro h
      by_contra hp
      obtain ⟨i, -, hi⟩ := h 0 (MvPolynomial.mem_support_iff.mpr hp)
      exact hi rfl
  rw [Scheme.Hom.ker_apply]
  change RingHom.ker (v.app W).hom = _
  rw [hker]
  refine le_antisymm (fun x hx => ?_) (Ideal.span_le.2 ?_)
  · have hp : Φ.symm x ∈ RingHom.ker ψ := by
      rw [RingHom.mem_ker]
      change ρ.hom (Φ (Φ.symm x)) = 0
      exact (congrArg ρ.hom (Φ.apply_symm_apply x)).trans hx
    rw [hkerψ] at hp
    have hx' := Ideal.mem_map_of_mem Φ.toRingHom hp
    rw [Ideal.map_span, ← Set.range_comp] at hx'
    have hr : Set.range (⇑Φ.toRingHom ∘ MvPolynomial.X) = Set.range fun j =>
        chartFractionOn U.2 (sectionsSplitting E U.1).t₀ ((completionInl E).app U.1 (c j)) := by
      ext y
      exact ⟨fun ⟨j, hj⟩ => ⟨j, (hΦ j).symm.trans hj⟩, fun ⟨j, hj⟩ => ⟨j, (hΦ j).trans hj⟩⟩
    rw [hr] at hx'
    exact (Φ.apply_symm_apply x) ▸ hx'
  · rintro _ ⟨j, rfl⟩
    exact hzero j

/-- The image of `D₊(T)` lies in the image of `𝐕(ℰ) ⟶ P`. -/
theorem mem_range_toCompletion_of_mem_chartBasicOpen {U : X.Opens} (hU : IsAffineOpen U)
    {x : projectiveCompletion E} (hx : x ∈ chartBasicOpen hU (sectionsSplitting E U).t₀) :
    x ∈ Set.range (toCompletion E).base := by
  obtain ⟨z, hz, rfl⟩ := hx
  exact (chart_mem_range_toCompletion_iff E ⟨U, hU⟩ z).2 hz

/-- A point of the image of `𝐕(ℰ) ⟶ P` over an affine open `U` lies in the image of `D₊(T)`. -/
theorem mem_chartBasicOpen_t₀_of_mem_range_toCompletion {U : X.Opens} (hU : IsAffineOpen U)
    {x : projectiveCompletion E} (hx : x ∈ Set.range (toCompletion E).base)
    (hxU : x ∈ (relativeProj (completionAlgebra E)).toBase ⁻¹ᵁ U) :
    x ∈ chartBasicOpen hU (sectionsSplitting E U).t₀ := by
  rw [← Stacks.AlgebraicGeometry.RelativeProjTwistGlue.chart_image_top _ U hU] at hxU
  obtain ⟨z, -, rfl⟩ := hxU
  exact ⟨z, (chart_mem_range_toCompletion_iff E ⟨U, hU⟩ z).1 hx, rfl⟩

/-- **The zero section of `P` misses `D₊(c_k)`**: its ideal there contains `c_k / c_k = 1`. -/
theorem notMem_preimage_zeroSection_chartBasicOpen_inl {U : X.Opens} (hU : IsAffineOpen U)
    {r : ℕ} (c : Module.Basis (Fin r) Γ(X, U) Γ(E, U)) (k : Fin r)
    (b : Stacks.Chow.bundle (Stacks.Ample.unitModule X))
    (hb : b ∈ zeroSection E ⁻¹ᵁ chartBasicOpen hU ((completionInl E).app U (c k))) : False := by
  have hone : (1 : Γ(projectiveCompletion E, chartBasicOpen hU ((completionInl E).app U (c k))))
      ∈ RingHom.ker
        ((zeroSection E).app (chartBasicOpen hU ((completionInl E).app U (c k)))).hom := by
    rw [ker_app_zeroSection_chartBasicOpen hU c]
    have hmem : chartFractionOn hU ((completionInl E).app U (c k))
        ((completionInl E).app U (c k)) ∈ Ideal.span (Set.range fun j =>
          chartFractionOn hU ((completionInl E).app U (c k)) ((completionInl E).app U (c j))) :=
      Ideal.subset_span ⟨k, rfl⟩
    rwa [chartFractionOn_self] at hmem
  rw [RingHom.mem_ker, map_one] at hone
  have := congrArg ((Stacks.Chow.bundle (Stacks.Ample.unitModule X)).presheaf.germ _ b hb).hom
    hone
  rw [map_one, map_zero] at this
  exact one_ne_zero this

/-- **The zero section of `P = 𝐏(ℰ ⊕ 𝒪_X)` lies in `𝐕(ℰ)`**: over an affine open on which `ℰ`
is free on `c`, `P` is covered by the images of `D₊(T)` and of the `D₊(c_k)`, and the zero section
misses the latter. -/
theorem range_zeroSection_subset_range_toCompletion (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] :
    Set.range (zeroSection E).base ⊆ Set.range (toCompletion E).base := by
  have : E.IsQuasicoherent :=
    Stacks.AlgebraicGeometry.CoherenceCriteria.isQuasicoherent_of_isFiniteLocallyFree E
  rintro x ⟨b, hb⟩
  obtain ⟨U, hU, hxU, ⟨c⟩⟩ := Stacks.Chow.exists_isAffineOpen_basis_sections E r
    ((projectiveCompletionProj E).base x)
  rcases mem_chartBasicOpen_or hU c (x := x) hxU with hT | ⟨k, hk⟩
  · exact mem_range_toCompletion_of_mem_chartBasicOpen hU hT
  · exact (notMem_preimage_zeroSection_chartBasicOpen_inl hU c k b (by
      change (zeroSection E).base b ∈ chartBasicOpen hU ((completionInl E).app U (c k))
      rwa [hb])).elim

/-- **The zero section of `P = 𝐏(ℰ ⊕ 𝒪_X)` is that of the vector bundle `𝐕(ℰ) ⊆ P`**: the closed
immersions `𝐏(𝒪_X) ⟶ P` induced by `ℰ ⊕ 𝒪_X ⟶ 𝒪_X` and `X ⟶ 𝐕(ℰ) ⟶ P` have the same ideal sheaf.
On the image of `D₊(T)` over an affine open on which `ℰ` is free on `c` both ideals are generated
by the functions `c_j / T`, and both closed immersions miss the complement of `𝐕(ℰ)`. -/
theorem ker_vectorBundleZeroSection_comp_toCompletion [IsLocallyNoetherian X] (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] :
    (Scheme.Modules.vectorBundleLiftZero E ≫ toCompletion E).ker = (zeroSection E).ker := by
  have : E.IsQuasicoherent :=
    Stacks.AlgebraicGeometry.CoherenceCriteria.isQuasicoherent_of_isFiniteLocallyFree E
  set v := Scheme.Modules.vectorBundleLiftZero E ≫ toCompletion E
  let ι := (Σ U : X.affineOpens, Module.Basis (Fin r) Γ(X, U.1) Γ(E, U.1)) ⊕
    {W : (projectiveCompletion E).affineOpens // v ⁻¹ᵁ W.1 = ⊥ ∧ zeroSection E ⁻¹ᵁ W.1 = ⊥}
  let F : ι → (projectiveCompletion E).affineOpens := fun
    | .inl U => ⟨chartBasicOpen U.1.2 (sectionsSplitting E U.1.1).t₀,
        isAffineOpen_chartBasicOpen U.1.2 _⟩
    | .inr W => W.1
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top F ?_ ?_
  · refine top_le_iff.1 fun y _ => ?_
    rw [TopologicalSpace.Opens.mem_iSup]
    by_cases hy : y ∈ Set.range v.base ∪ Set.range (zeroSection E).base
    · rcases hy with ⟨x, rfl⟩ | hy
      · obtain ⟨U, hU, hxU, ⟨c⟩⟩ := Stacks.Chow.exists_isAffineOpen_basis_sections E r x
        exact ⟨.inl ⟨⟨U, hU⟩, c⟩,
          (preimage_chartBasicOpen_vectorBundleZeroSection_comp_toCompletion (E := E) ⟨U, hU⟩).ge
            hxU⟩
      · obtain ⟨U, hU, hxU, ⟨c⟩⟩ := Stacks.Chow.exists_isAffineOpen_basis_sections E r
          ((relativeProj (completionAlgebra E)).toBase.base y)
        exact ⟨.inl ⟨⟨U, hU⟩, c⟩, mem_chartBasicOpen_t₀_of_mem_range_toCompletion hU
          (range_zeroSection_subset_range_toCompletion r hy) hxU⟩
    · have hS : IsClosed (Set.range v.base ∪ Set.range (zeroSection E).base) :=
        v.isClosedEmbedding.isClosed_range.union (zeroSection E).isClosedEmbedding.isClosed_range
      obtain ⟨_, ⟨W, hW, rfl⟩, hyW, hWS⟩ :=
        (projectiveCompletion E).isBasis_affineOpens.exists_subset_of_mem_open hy hS.isOpen_compl
      refine ⟨.inr ⟨⟨W, hW⟩, ?_, ?_⟩, hyW⟩
      · exact eq_bot_iff.2 fun x hx => (hWS hx (Or.inl ⟨x, rfl⟩)).elim
      · exact eq_bot_iff.2 fun x hx => (hWS hx (Or.inr ⟨x, rfl⟩)).elim
  · rintro (⟨U, c⟩ | ⟨W, hv, hz⟩)
    · refine (ideal_ker_vectorBundleZeroSection_comp_toCompletion U c).trans ?_
      rw [Scheme.Hom.ker_apply]
      exact (ker_app_zeroSection_chartBasicOpen U.2 c _).symm
    · exact (Stacks.IdealSheafData.ker_ideal_eq_top_of_preimage_eq_bot v W hv).trans
        (Stacks.IdealSheafData.ker_ideal_eq_top_of_preimage_eq_bot _ W hz).symm

end Stacks.ProjectiveCompletion

namespace Stacks.Chow

open Stacks.AlgebraicGeometry.ReflexiveModules

variable {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] [IsLocallyNoetherian Z]
  (hi : Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularImmersion i)

/-- **The vertex of the normal cone is the zero section of the vector bundle** (the proof of
Stacks 0FEG): under `E ≅ 𝐏(𝒞 ⊕ 𝒪_Z)` the vertex `Z ⟶ C_ZX ⟶ E` is the zero section of the
normal bundle `N = 𝐕(𝒞) ⊆ 𝐏(𝒞 ⊕ 𝒪_Z)`, `𝒞` the conormal sheaf: the open immersion `C_ZX ⟶ E`
corresponds to `C_ZX ⟶ N ⟶ 𝐏(𝒞 ⊕ 𝒪_Z)`
(`Stacks.Chow.normalConeToExceptionalDivisor_comp_exceptionalDivisorIsoProjectiveCompletion_hom`),
and the vertex of `C_ZX` is the zero section of `N`
(`Stacks.Chow.normalConeZeroSectionOver_comp_normalConeEmbedding`). -/
theorem vertex_comp_exceptionalDivisorIsoProjectiveCompletion_hom :
    (normalConeZeroSection i ≫ normalConeToExceptionalDivisor i) ≫
        (exceptionalDivisorIsoProjectiveCompletion i hi).hom =
      Scheme.Modules.vectorBundleLiftZero
          (dualSheaf (VirtualNormalBundle.ofIsRegularImmersion i hi).bundle) ≫
        Stacks.ProjectiveCompletion.toCompletion
          (dualSheaf (VirtualNormalBundle.ofIsRegularImmersion i hi).bundle) := by
  have h1 := normalConeToExceptionalDivisor_comp_exceptionalDivisorIsoProjectiveCompletion_hom i hi
  have h2 : normalConeZeroSection i ≫
      (VirtualNormalBundle.ofIsRegularImmersion i hi).normalConeEmbedding =
      Scheme.Modules.vectorBundleLiftZero
        (dualSheaf (VirtualNormalBundle.ofIsRegularImmersion i hi).bundle) :=
    congrArg Over.Hom.left (normalConeZeroSectionOver_comp_normalConeEmbedding i
      (VirtualNormalBundle.ofIsRegularImmersion i hi))
  refine (Category.assoc _ _ _).trans ((congrArg (normalConeZeroSection i ≫ ·) h1).trans ?_)
  exact (Category.assoc _ _ _).symm.trans (congrArg (· ≫ _) h2)

/-- **The vertex of the normal cone is the zero section of `𝐏(𝒞 ⊕ 𝒪_Z)`** (the proof of
Stacks 0FEG): under `E ≅ 𝐏(𝒞 ⊕ 𝒪_Z)` the vertex `Z ⟶ C_ZX ⟶ E` and the zero section
`𝐏(𝒪_Z) ⟶ 𝐏(𝒞 ⊕ 𝒪_Z)` are closed immersions with the same ideal sheaf, so they are the same
closed subscheme. -/
theorem ker_vertex_comp_exceptionalDivisorIsoProjectiveCompletion_hom (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (conormalModule i) r] :
    ((normalConeZeroSection i ≫ normalConeToExceptionalDivisor i) ≫
        (exceptionalDivisorIsoProjectiveCompletion i hi).hom).ker =
      (Stacks.ProjectiveCompletion.zeroSection
        (dualSheaf (VirtualNormalBundle.ofIsRegularImmersion i hi).bundle)).ker := by
  rw [vertex_comp_exceptionalDivisorIsoProjectiveCompletion_hom]
  exact Stacks.ProjectiveCompletion.ker_vectorBundleZeroSection_comp_toCompletion r

end Stacks.Chow

