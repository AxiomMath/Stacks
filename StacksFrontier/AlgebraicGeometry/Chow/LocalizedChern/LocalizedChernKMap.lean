module

public import StacksFrontier.AlgebraicGeometry.Chow.LocalizedChern.LocalizedGradingRing
public import StacksFrontier.AlgebraicGeometry.Chow.LocalizedChern.Localized
public import StacksFrontier.CategoryTheory.Triangulated.KGroup.Basic

/-!
# Multiplicative maps out of `K₀` and the localized Chern class map

Let `D` be a pretriangulated category and `M` a monoid. A function `c` from the objects of `D` to
`M` is *multiplicative along distinguished triangles* if `c(Y) = c(X) c(Z)` for every
distinguished triangle `X ⟶ Y ⟶ Z ⟶ X[1]`. If its values are units, it extends multiplicatively
to `K₀(D)` (Stacks 0FCN): the values commute pairwise, both `c(X) c(Y)` and `c(Y) c(X)` being
`c(X ⊕ Y)`, so they generate a commutative subgroup of the units of `M`, and the relation
`[Y] - [X] - [Z]` of a distinguished triangle goes to `1` there. This gives a homomorphism
`K₀(D) ⟶ M`, written multiplicatively on the source, with `[X] ↦ c(X)`, and it is the only one.

This is the construction of the map of Stacks 0FES,

  `c(Z ⟶ X, -) : K₀(D_{Z,perf}(𝒪_X)) ⟶ A⁽¹⁾(Z ⟶ X)`,
  `[E] ↦ c(Z ⟶ X, E) = 1 + c₁(Z ⟶ X, E) + c₂(Z ⟶ X, E) + ⋯`,

"extended multiplicatively", into the ring `A⁽¹⁾(Z ⟶ X)`
(`Stacks.Chow.instRingLocalizedGradingOne`): its values have degree-`0` component `1`, so they are
units (`Stacks.Chow.localizedGrading_isUnit_of_fst_zero`), and the identity along distinguished
triangles is Stacks 0FBD; the map itself is `Stacks.Chow.localizedChernClassKMap`
(LocalizedChernClassKMap.lean). A perfect object supported on `Z`
vanishes on `X ∖ Z`, the hypothesis under which its localized Chern classes are defined
(`Stacks.Chow.LocalizedChernData.isZeroOnComplement_of_supportedPerfect`).

## Main definitions

* `CategoryTheory.Pretriangulated.K0.unitGroupOfMulTriangle` — the commutative group generated by
  the values of `c`.
* `CategoryTheory.Pretriangulated.K0.addHomOfMulTriangle` — `K₀(D) ⟶ ⟨c(X)⟩`, additively.
* `CategoryTheory.Pretriangulated.K0.monoidHomOfMulTriangle` — `K₀(D) ⟶ M`, `[X] ↦ c(X)`.

## Main results

* `CategoryTheory.Pretriangulated.K0.commute_of_mul_triangle` — the values commute.
* `CategoryTheory.Pretriangulated.K0.monoidHomOfMulTriangle_cls`,
  `CategoryTheory.Pretriangulated.K0.monoidHomOfMulTriangle_add` — `[X] ↦ c(X)` and
  `α + β ↦ c(α) c(β)`.
* `CategoryTheory.Pretriangulated.K0.monoidHom_ext` — uniqueness.

## References

* [Stacks Project, Tag 0FES](https://stacks.math.columbia.edu/tag/0FES)
* [Stacks Project, Tag 0FCN](https://stacks.math.columbia.edu/tag/0FCN)
* [Stacks Project, Tag 0FBD](https://stacks.math.columbia.edu/tag/0FBD)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open scoped ZeroObject

namespace CategoryTheory.Pretriangulated.K0

universe v u w

variable {D : Type u} [Category.{v} D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D] {M : Type w} [Monoid M]
  {c : D → M}

section

variable (hc : ∀ T ∈ distTriang D, c T.obj₂ = c T.obj₁ * c T.obj₃) (hu : ∀ X : D, IsUnit (c X))

include hc hu in
/-- A function multiplicative along distinguished triangles, with values units, sends `0` to `1`:
the contractible triangle on `0` gives `c(0) = c(0) c(0)`. -/
theorem apply_zero_eq_one_of_mul_triangle : c (0 : D) = 1 := by
  have h : c (0 : D) = c 0 * c 0 := hc _ (contractible_distinguished (0 : D))
  exact (hu (0 : D)).mul_left_cancel (by rw [← h, mul_one])

include hc hu in
/-- A function multiplicative along distinguished triangles, with values units, takes the same
value on isomorphic objects: an isomorphism `e : Y ≅ Z` extends to a distinguished triangle
`Y ⟶ Z ⟶ 0`, whence `c(Z) = c(Y) c(0) = c(Y)`. -/
theorem apply_eq_of_iso_of_mul_triangle {Y Z : D} (e : Y ≅ Z) : c Y = c Z := by
  have h : c Z = c Y * c 0 := hc (Triangle.mk e.hom (0 : Z ⟶ 0) 0)
    ((Triangle.distinguished_iff_of_isZero₃ _ (isZero_zero D)).2 (by dsimp; infer_instance))
  rw [h, apply_zero_eq_one_of_mul_triangle hc hu, mul_one]

include hc hu in
/-- **The values of a function multiplicative along distinguished triangles commute**, if they
are units: both `c(X) c(Y)` and `c(Y) c(X)` are `c(X ⊕ Y)`, by the split triangles
`X ⟶ X ⊕ Y ⟶ Y` and `Y ⟶ Y ⊕ X ⟶ X`. -/
theorem commute_of_mul_triangle (X Y : D) : Commute (c X) (c Y) := by
  have h₁ : c (X ⊞ Y) = c X * c Y := hc _ (binaryBiproductTriangle_distinguished X Y)
  have h₂ : c (Y ⊞ X) = c Y * c X := hc _ (binaryBiproductTriangle_distinguished Y X)
  change c X * c Y = c Y * c X
  rw [← h₁, ← h₂]
  exact apply_eq_of_iso_of_mul_triangle hc hu (biprod.braiding X Y)

/-- **The group generated by the values `c(X)` of a function `c` multiplicative along
distinguished triangles, with values units**: the subgroup of `Mˣ` they generate. It is
commutative, by `CategoryTheory.Pretriangulated.K0.commute_of_mul_triangle`. -/
def unitGroupOfMulTriangle (_hc : ∀ T ∈ distTriang D, c T.obj₂ = c T.obj₁ * c T.obj₃)
    (hu : ∀ X : D, IsUnit (c X)) : Subgroup Mˣ :=
  Subgroup.closure (Set.range fun X : D ↦ (hu X).unit)

/-- The group generated by the values of a function multiplicative along distinguished triangles
is commutative. -/
instance : CommGroup (unitGroupOfMulTriangle hc hu) :=
  Subgroup.closureCommGroupOfComm (by
    rintro _ ⟨X, rfl⟩ _ ⟨Y, rfl⟩
    exact Units.ext (commute_of_mul_triangle hc hu X Y))

/-- `c(X)` as an element of the group generated by the values. -/
def unitGroupOfMulTriangle.elem (X : D) : unitGroupOfMulTriangle hc hu :=
  ⟨(hu X).unit, Subgroup.subset_closure ⟨X, rfl⟩⟩

/-- **The homomorphism `K₀(D) ⟶ ⟨c(X)⟩` of a function `c` multiplicative along distinguished
triangles**, with values units, written additively: `[X] ↦ c(X)`. It is well defined since the
relation `[Y] - [X] - [Z]` of a distinguished triangle goes to `c(Y) (c(X) c(Z))⁻¹ = 1`. -/
def addHomOfMulTriangle : K0 D →+ Additive (unitGroupOfMulTriangle hc hu) :=
  QuotientAddGroup.lift _ (FreeAbelianGroup.lift fun X ↦
      Additive.ofMul (unitGroupOfMulTriangle.elem hc hu X)) fun x hx ↦ by
    refine (AddSubgroup.closure_le _).2 ?_ hx
    rintro _ ⟨T, hT, rfl⟩
    change (FreeAbelianGroup.lift fun X ↦ Additive.ofMul (unitGroupOfMulTriangle.elem hc hu X))
      (FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ - FreeAbelianGroup.of T.obj₃) = 0
    rw [map_sub, map_sub, FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of,
      FreeAbelianGroup.lift_apply_of, sub_sub]
    exact sub_eq_zero_of_eq (congrArg Additive.ofMul (Subtype.ext (Units.ext (hc T hT))))

/-- The homomorphism `CategoryTheory.Pretriangulated.K0.addHomOfMulTriangle` on a class. -/
theorem addHomOfMulTriangle_cls (X : D) :
    addHomOfMulTriangle hc hu (cls X) = Additive.ofMul (unitGroupOfMulTriangle.elem hc hu X) :=
  FreeAbelianGroup.lift_apply_of _ _

/-- **The monoid homomorphism `K₀(D) ⟶ M` of a function `c` multiplicative along distinguished
triangles, with values units**: the homomorphism from `K₀(D)`, written multiplicatively, with
`[X] ↦ c(X)` — "extending `c` multiplicatively". It is the unique one
(`CategoryTheory.Pretriangulated.K0.monoidHom_ext`). -/
def monoidHomOfMulTriangle : Multiplicative (K0 D) →* M :=
  (Units.coeHom M).comp ((unitGroupOfMulTriangle hc hu).subtype.comp
    (AddMonoidHom.toMultiplicativeLeft (addHomOfMulTriangle hc hu)))

/-- The value on a class: `[X] ↦ c(X)`. -/
theorem monoidHomOfMulTriangle_cls (X : D) :
    monoidHomOfMulTriangle hc hu (Multiplicative.ofAdd (cls X)) = c X := by
  change ((addHomOfMulTriangle hc hu (cls X)).toMul : unitGroupOfMulTriangle hc hu).1.1 = c X
  rw [addHomOfMulTriangle_cls]
  rfl

/-- The map is multiplicative: `c(α + β) = c(α) c(β)`. -/
theorem monoidHomOfMulTriangle_add (α β : K0 D) :
    monoidHomOfMulTriangle hc hu (Multiplicative.ofAdd (α + β)) =
      monoidHomOfMulTriangle hc hu (Multiplicative.ofAdd α) *
        monoidHomOfMulTriangle hc hu (Multiplicative.ofAdd β) := by
  rw [ofAdd_add, map_mul]

/-- The values of the map commute. -/
theorem commute_monoidHomOfMulTriangle (α β : Multiplicative (K0 D)) :
    Commute (monoidHomOfMulTriangle hc hu α) (monoidHomOfMulTriangle hc hu β) :=
  (Commute.all α β).map _

/-- The values of the map are units. -/
theorem isUnit_monoidHomOfMulTriangle (α : Multiplicative (K0 D)) :
    IsUnit (monoidHomOfMulTriangle hc hu α) :=
  (Group.isUnit α).map (monoidHomOfMulTriangle hc hu)

end

/-- **Uniqueness**: a monoid homomorphism from `K₀(D)`, written multiplicatively, is determined by
its values on the classes. -/
theorem monoidHom_ext {φ ψ : Multiplicative (K0 D) →* M}
    (h : ∀ X : D, φ (Multiplicative.ofAdd (cls X)) = ψ (Multiplicative.ofAdd (cls X))) :
    φ = ψ := by
  refine MonoidHom.ext fun x ↦ ?_
  induction x using Multiplicative.rec with | ofAdd x => ?_
  induction x using QuotientAddGroup.induction_on with | H w => ?_
  induction w using FreeAbelianGroup.induction_on with
  | zero => exact (map_one φ).trans (map_one ψ).symm
  | of X => exact h X
  | neg X _ =>
    have key (θ : Multiplicative (K0 D) →* M) :
        θ (Multiplicative.ofAdd (-cls X)) * θ (Multiplicative.ofAdd (cls X)) = 1 := by
      rw [← map_mul, ← ofAdd_add, neg_add_cancel, ofAdd_zero, map_one]
    change φ (Multiplicative.ofAdd (-cls X)) = ψ (Multiplicative.ofAdd (-cls X))
    exact left_inv_eq_right_inv (key φ)
      (by rw [h X]; exact ((Commute.all _ _).map ψ).eq.trans (key ψ))
  | add x y hx hy =>
    change φ (Multiplicative.ofAdd (QuotientAddGroup.mk x + QuotientAddGroup.mk y)) =
      ψ (Multiplicative.ofAdd (QuotientAddGroup.mk x + QuotientAddGroup.mk y))
    rw [ofAdd_add, map_mul, map_mul, hx, hy]

end CategoryTheory.Pretriangulated.K0

open AlgebraicGeometry

namespace Stacks.Chow

universe u v w

attribute [local instance 10000] HasDerivedCategory.standard

/-- **A perfect object supported on `Z` is zero on `X ∖ Z`**: the first alternative of condition
(2) of Situation 0GUJ holds for data whose object is a perfect object supported on the closed
subscheme. -/
theorem LocalizedChernData.isZeroOnComplement_of_supportedPerfect (D : LocalizedChernData.{u})
    (E : supportedPerfectDerivedCategory D.i) (h : D.E = E.1) : D.IsZeroOnComplement := by
  unfold LocalizedChernData.IsZeroOnComplement
  rw [h]
  exact supportedPerfect_isZero_derivedPullback_compl D.i E

end Stacks.Chow
