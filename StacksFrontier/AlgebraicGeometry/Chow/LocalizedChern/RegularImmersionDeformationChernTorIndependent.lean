import StacksCore.Tactic.EgaSgaAttribute

/-!
# Tor independence of an effective Cartier divisor whose pullback is one

Let `D ⊆ S` be an effective Cartier divisor and `g : X ⟶ S` a morphism such that the inverse
image `g⁻¹(D)` is again an effective Cartier divisor. Then `X` and `D` are Tor independent over
`S`. At a point `s` of `S` the local ring of `D` is `𝒪_{S,s}/(a)` for a nonzerodivisor `a`, and
`Tor_*^{𝒪_{S,s}}(𝒪_{S,s}/(a), 𝒪_{X,x})` is the homology of `𝒪_{X,x} --a--> 𝒪_{X,x}`, which
vanishes in positive degree because the image of `a` generates the ideal of `g⁻¹(D)` at `x`,
and so is a nonzerodivisor.

In the proof of Stacks 0FEG this applies to the closed immersion `𝐏¹_Z ⟶ W` of Stacks 0FE9 and
the exceptional divisor `E` of the blowup `W` of `𝐏¹_X` in `∞(Z)`: `E` pulls back to the divisor
at infinity of `𝐏¹_Z`.

## Main results

* `Stacks.Chow.torIndependent_of_isEffectiveCartierDivisor_ker` — `X` and `D` are Tor independent
  over `S` when `D ⟶ S` is a closed immersion cutting out an effective Cartier divisor whose
  inverse image in `X` is an effective Cartier divisor; and
  `Stacks.Chow.torIndependent_subschemeι_of_isEffectiveCartierDivisor`, the same for `D ⊆ S`.
* `Stacks.Chow.torIndependent_lineToBlowupAtInfinity_exceptionalIdealAtInfinity` — `𝐏¹_Z` and
  the exceptional divisor `E` are Tor independent over `W`.

## References

* [Stacks Project, Tag 0FEG](https://stacks.math.columbia.edu/tag/0FEG)
* [Stacks Project, Tag 08IA](https://stacks.math.columbia.edu/tag/08IA)
* [Stacks Project, Tag 0660](https://stacks.math.columbia.edu/tag/0660)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.Chow

section Stalks

variable {S D : Scheme.{u}} (k : D ⟶ S) [IsClosedImmersion k] (y : D)

/-- The map of local rings of a closed immersion, read at a point equal to the image of `y`, is
surjective. -/
theorem surjective_eqToHom_comp_stalkMap_of_isClosedImmersion {s : S} (h : s = k.base y) :
    Function.Surjective
      (eqToHom (congrArg (fun z ↦ S.presheaf.stalk z) h) ≫ k.stalkMap y).hom := by
  subst h
  simpa using k.stalkMap_surjective y

/-- The kernel of the map of local rings of a closed immersion, read at a point `s` equal to the
image of `y`, is the stalk at `s` of its kernel ideal sheaf. -/
theorem ker_eqToHom_comp_stalkMap_of_isClosedImmersion {s : S} (h : s = k.base y) :
    RingHom.ker (eqToHom (congrArg (fun z ↦ S.presheaf.stalk z) h) ≫ k.stalkMap y).hom =
      IdealSheafData.stalk k.ker s := by
  subst h
  rw [eqToHom_refl, Category.id_comp, ← IdealSheafData.stalk_ker_of_isClosedImmersion k y]

end Stalks

/-- A single nonzerodivisor is a Koszul-regular sequence. -/
theorem isKoszulRegular_of_isRegular {R : Type*} [CommRing R] {a : R} (ha : IsRegular a) :
    Koszul.IsKoszulRegular ![a] :=
  (Koszul.isKoszulRegularOn_self_iff _).mp
    (Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular.1
      ((RingTheory.Sequence.isWeaklyRegular_singleton_iff R a).mpr ha.left.isSMulRegular))

/-- **Tor independence of an effective Cartier divisor whose pullback is one.** Let `k : D ⟶ S`
be a closed immersion whose ideal sheaf is an effective Cartier divisor, and let `g : X ⟶ S` be a
morphism such that the inverse image of that divisor is an effective Cartier divisor of `X`.
Then `X` and `D` are Tor independent over `S`: at a point the ideal of `D` is generated by a
nonzerodivisor `a` of the local ring of `S`, whose image in the local ring of `X` generates the
ideal of `g⁻¹(D)` and so is a nonzerodivisor too, and a quotient by a Koszul-regular sequence
staying Koszul-regular is Tor independent (Tag 0660). -/
@[sga "7 X 1.5" "special case"]
theorem torIndependent_of_isEffectiveCartierDivisor_ker {S X D : Scheme.{u}} (g : X ⟶ S)
    (k : D ⟶ S) [IsClosedImmersion k] (hD : Stacks.Divisors.IsEffectiveCartierDivisor k.ker)
    (hD' : Stacks.Divisors.IsEffectiveCartierDivisor (k.ker.comap g)) :
    TorIndependent g k := by
  intro x y h
  let : Algebra (S.presheaf.stalk (g.base x)) (X.presheaf.stalk x) :=
    (g.stalkMap x).hom.toAlgebra
  let : Algebra (S.presheaf.stalk (g.base x)) (D.presheaf.stalk y) :=
    (eqToHom (congrArg (fun z ↦ S.presheaf.stalk z) h) ≫ k.stalkMap y).hom.toAlgebra
  obtain ⟨a, ha, hDa⟩ :=
    Stacks.Divisors.exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor _ hD (g.base x)
  obtain ⟨b, hb, hDb⟩ :=
    Stacks.Divisors.exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor _ hD' x
  have hspan : IdealSheafData.stalk (k.ker.comap g) x = Ideal.span {(g.stalkMap x).hom a} := by
    rw [IdealSheafData.stalk_comap, hDa, Ideal.map_span, Set.image_singleton]
  have hga : IsRegular (algebraMap (S.presheaf.stalk (g.base x)) (X.presheaf.stalk x) a) := by
    refine isRegular_iff_mem_nonZeroDivisors.mpr
      (Stacks.Divisors.mem_nonZeroDivisors_of_mem_span_singleton
        (isRegular_iff_mem_nonZeroDivisors.mp hb) ?_)
    show b ∈ Ideal.span {(g.stalkMap x).hom a}
    rw [← hspan, hDb]
    exact Ideal.mem_span_singleton_self b
  have htor := (Koszul.torIndependent_of_isKoszulRegular_map
    (R := S.presheaf.stalk (g.base x)) (C := D.presheaf.stalk y)
    (S := X.presheaf.stalk x) (surjective_eqToHom_comp_stalkMap_of_isClosedImmersion k y h) ![a]
    (isKoszulRegular_of_isRegular ha)
    (by
      rw [Matrix.range_cons, Matrix.range_empty, Set.union_empty, ← hDa]
      exact ker_eqToHom_comp_stalkMap_of_isClosedImmersion k y h)
    (by
      have : (fun i => algebraMap (S.presheaf.stalk (g.base x)) (X.presheaf.stalk x)
          (![a] i)) = ![algebraMap _ _ a] := by
        ext i
        fin_cases i
        rfl
      rw [this]
      exact isKoszulRegular_of_isRegular hga)).symm
  exact (RingTheory.TorIndependence.torIndependent_iff_isZero_tor _ _ _).mp htor

/-- **Tor independence of an effective Cartier divisor whose pullback is one**, for the closed
subscheme `D ⊆ S` itself: if `D` and `g⁻¹(D)` are effective Cartier divisors then `X` and `D`
are Tor independent over `S`. -/
@[sga "7 X 1.5" "special case"]
theorem torIndependent_subschemeι_of_isEffectiveCartierDivisor {S X : Scheme.{u}} (g : X ⟶ S)
    (D : S.IdealSheafData) (hD : Stacks.Divisors.IsEffectiveCartierDivisor D)
    (hD' : Stacks.Divisors.IsEffectiveCartierDivisor (D.comap g)) :
    TorIndependent g D.subschemeι :=
  torIndependent_of_isEffectiveCartierDivisor_ker g D.subschemeι
    (by rwa [Scheme.IdealSheafData.ker_subschemeι])
    (by rwa [Scheme.IdealSheafData.ker_subschemeι])

/-- **`𝐏¹_Z` and the exceptional divisor are Tor independent over `W`** (the proof of
Stacks 0FEG): the exceptional divisor `E` of the blowup `W` of `𝐏¹_X` in `∞(Z)` is an effective
Cartier divisor and pulls back along `𝐏¹_Z ⟶ W` to the divisor at infinity of `𝐏¹_Z`, again an
effective Cartier divisor. -/
theorem torIndependent_lineToBlowupAtInfinity_exceptionalIdealAtInfinity {X : Scheme.{u}}
    (ℐ : X.IdealSheafData) :
    TorIndependent (lineToBlowupAtInfinity ℐ) (exceptionalIdealAtInfinity ℐ).subschemeι :=
  torIndependent_subschemeι_of_isEffectiveCartierDivisor _ _
    (isEffectiveCartierDivisor_exceptionalIdealAtInfinity ℐ)
    (by
      rw [comap_exceptionalIdealAtInfinity_lineToBlowupAtInfinity]
      exact lineInfinityDivisor_isEffectiveCartierDivisor _)

end Stacks.Chow

end
