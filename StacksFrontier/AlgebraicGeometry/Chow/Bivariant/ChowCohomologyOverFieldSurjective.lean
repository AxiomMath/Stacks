module

public import StacksFrontier.AlgebraicGeometry.Chow.Bivariant.ChowCohomologyOverField
public import StacksFrontier.AlgebraicGeometry.Chow.Bivariant.FlatPullbackClass
public import StacksFrontier.AlgebraicGeometry.Chow.Bivariant.ProperPushforwardClass
public import StacksCore.Tactic.StacksAttribute

/-!
# Surjectivity of the canonical map from bivariant classes to Chow homology

Let `k` be a field and let `X` be a scheme locally of finite type over `k`. Cap product with the
fundamental class of the point identifies `A^p(X ⟶ Spec k)` with `CH_{-p}(X)`. Injectivity is
`Stacks.Chow.bivariantToBaseEval_injective`; this file proves surjectivity and assembles the two
halves into the identification.

## Main definitions

* `Stacks.Chow.BivariantProperPushforwardExists`: the proper pushforward `f_* ∘ c` of a bivariant
  class exists (Stacks 0EPK).
* `Stacks.Chow.flatPullbackBaseClass`: the flat pullback of the fundamental class of the base along
  the structure morphism of a scheme flat over the base, read through the collapse of
  `W ×_{Spec k} Spec k` onto `W`.
* `Stacks.Chow.ChowClassesGeneratedByBaseFlatPullbacks`: the Chow groups of `X` are generated by
  proper pushforwards to `X` of those classes.

## Main results

* `Stacks.Chow.bivariantToBaseEval_surjective`: the canonical map `A^p(X ⟶ Spec k) ⟶ CH_{-p}(X)` is
  surjective.
* `Stacks.Chow.bivariantToBaseEval_bijective`, `Stacks.Chow.bivariantToBaseEquiv`: the
  identification, as a bijection and as an isomorphism of groups.
* `Stacks.Chow.bivariantToBaseEval_flatPullbackProperPushforward`: the proper pushforward along
  `g : W ⟶ X` of the bivariant class of Stacks 0B78 for `W` evaluates to the proper pushforward of
  `Stacks.Chow.flatPullbackBaseClass`.

## References

* [Stacks Project, Tag 0FBW](https://stacks.math.columbia.edu/tag/0FBW)
* [Stacks Project, Tag 0EPK](https://stacks.math.columbia.edu/tag/0EPK)
* [Stacks Project, Tag 0B78](https://stacks.math.columbia.edu/tag/0B78)
* [Stacks Project, Tag 0B76](https://stacks.math.columbia.edu/tag/0B76)
* [Stacks Project, Tag 02UC](https://stacks.math.columbia.edu/tag/02UC)
* [Stacks Project, Tag 02R4](https://stacks.math.columbia.edu/tag/02R4)
* [Stacks Project, Tag 02R5](https://stacks.math.columbia.edu/tag/02R5)
* [Stacks Project, Tag 02S1](https://stacks.math.columbia.edu/tag/02S1)
* [Stacks Project, Tag 02S2](https://stacks.math.columbia.edu/tag/02S2)
* [Stacks Project, Tag 0B71](https://stacks.math.columbia.edu/tag/0B71)
* [Stacks Project, Tag 0GU8](https://stacks.math.columbia.edu/tag/0GU8)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace Stacks.Chow

/-! ### Existence of proper pushforwards of bivariant classes -/

/-- For every proper `f : X ⟶ Y`, every `g : Y ⟶ Z` and every bivariant class `c` of degree `p` for
`f ≫ g`, the proper pushforward `f_* ∘ c` exists as a bivariant class of degree `p` for `g` (Stacks
0EPK). -/
def BivariantProperPushforwardExists (C : ChowSituation.{u}) (G : GysinSystem C) : Prop :=
  ∀ {X Y Z : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX] (sY : Y ⟶ C.S)
      [LocallyOfFiniteType sY] (sZ : Z ⟶ C.S) [LocallyOfFiniteType sZ] (f : X ⟶ Y) [IsProper f]
      (g : Y ⟶ Z) [LocallyOfFiniteType g] (hf : f ≫ sY = sX) (hg : g ≫ sZ = sY)
      (hpp : ProperPushforwardDescends C) (p : ℤ)
      (c : BivariantClass C G sX sZ (f ≫ g) (comp_comp_structureMorphism_eq hf hg) p),
    ∃ d : BivariantClass C G sY sZ g hg p,
      IsBivariantProperPushforward C G sX sY sZ f g hf hg hpp p c d

/-- `Stacks.Chow.BivariantProperPushforwardExists` holds, given Stacks 02RG on Chow groups (`hRG`)
and Stacks 02TA for the Gysin system (`hgysP`, `hgysc`). -/
theorem bivariantProperPushforwardExists (C : ChowSituation.{u}) (G : GysinSystem C)
    (hRG : ProperPushforwardFlatPullbackBaseChange C)
    (hgysP : G.IsNaturalUnderProperPushforward)
    (hgysc : G.IsNaturalUnderPullbackCompPushforward) :
    BivariantProperPushforwardExists C G :=
  fun sX _ sY _ sZ _ f _ g _ hf hg hpp pp c ↦
    exists_isBivariantProperPushforward C G sX sY sZ f g hf hg hpp pp c hRG hgysP hgysc

/-! ### Transport of a proper pushforward along an equality of degrees -/

/-- Proper pushforward on Chow groups commutes with the transport of
`Stacks.Chow.chowGroupDegreeEquiv` between two degrees that are the same integer written two
ways. -/
theorem properChowPushforward_chowGroupDegreeEquiv (C : ChowSituation.{u}) {A B : Scheme.{u}}
    (sA : A ⟶ C.S) [LocallyOfFiniteType sA] (sB : B ⟶ C.S) [LocallyOfFiniteType sB] (u : A ⟶ B)
    [IsProper u] (hu : u ≫ sB = sA) {k l : ℤ} (hkl : k = l)
    (hfack : ProperPushforwardFactorsThroughRationalEquivalence C sA sB u hu k)
    (hfacl : ProperPushforwardFactorsThroughRationalEquivalence C sA sB u hu l)
    (α : chowGroup C sA k) :
    properChowPushforward C sA sB u hu l hfacl (chowGroupDegreeEquiv C sA hkl α) =
      chowGroupDegreeEquiv C sB hkl (properChowPushforward C sA sB u hu k hfack α) := by
  cases hkl
  rfl

/-! ### The collapse of `W ×_{Spec k} Spec k` commutes with proper pushforward -/

section Collapse

variable (C : ChowSituation.{u}) {X W : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
  (g : W ⟶ X) [IsProper g] [LocallyOfFiniteType (g ≫ sX)]

/-- Pushing a Chow class of `W ×_{Spec k} Spec k` forward along the base change of `g : W ⟶ X` and
then along the first projection of `X ×_{Spec k} Spec k` is the same as pushing it forward along
the first projection of `W ×_{Spec k} Spec k` and then along `g`, up to the transport of
`Stacks.Chow.chowGroupDegreeEquiv` along `hmn : m = n`. -/
theorem chowPushforwardOfIso_properChowPushforward_baseChange
    (hpp : ProperPushforwardDescends C) {m n : ℤ} (hmn : m = n)
    (z : chowGroup C (pullback.fst (g ≫ sX) (𝟙 C.S) ≫ (g ≫ sX)) m) :
    chowPushforwardOfIso C (pullback.fst sX (𝟙 C.S) ≫ sX) sX (pullback.fst sX (𝟙 C.S)) rfl n
        (chowGroupDegreeEquiv C (pullback.fst sX (𝟙 C.S) ≫ sX) hmn
          (properChowPushforward C (pullback.fst (g ≫ sX) (𝟙 C.S) ≫ (g ≫ sX))
            (pullback.fst sX (𝟙 C.S) ≫ sX) (bivariantPushforwardBaseChange g sX (𝟙 C.S))
            (bivariantPushforwardBaseChange_comp_structure (rfl : g ≫ sX = g ≫ sX) sX (𝟙 C.S)) m
            (hpp _ _ _ _ _) z)) =
      properChowPushforward C (g ≫ sX) sX g rfl n (hpp _ _ g rfl _)
        (chowPushforwardOfIso C (pullback.fst (g ≫ sX) (𝟙 C.S) ≫ (g ≫ sX)) (g ≫ sX)
          (pullback.fst (g ≫ sX) (𝟙 C.S)) rfl n
          (chowGroupDegreeEquiv C (pullback.fst (g ≫ sX) (𝟙 C.S) ≫ (g ≫ sX)) hmn z)) := by
  cases hmn
  exact properChowPushforward_comp_eq C (pullback.fst (g ≫ sX) (𝟙 C.S) ≫ (g ≫ sX))
    (pullback.fst sX (𝟙 C.S) ≫ sX) (g ≫ sX) sX
    (bivariantPushforwardBaseChange g sX (𝟙 C.S)) (pullback.fst sX (𝟙 C.S))
    (pullback.fst (g ≫ sX) (𝟙 C.S)) g (bivariantPushforwardBaseChange_fst g sX (𝟙 C.S))
    (bivariantPushforwardBaseChange_comp_structure (rfl : g ≫ sX = g ≫ sX) sX (𝟙 C.S))
    rfl rfl rfl m (hpp _ _ _ _ _)
    (properPushforwardFactorsThroughRationalEquivalence_of_isIso C _ _ _ _ _)
    (properPushforwardFactorsThroughRationalEquivalence_of_isIso C _ _ _ _ _)
    (hpp _ _ g rfl _) z

/-- The collapse `CH_{0-p}(W ×_{Spec k} Spec k) ≃ CH_{-p}(W)` of
`Stacks.Chow.chowGroupBaseUnitCollapse` carries proper pushforward along the base change of
`g : W ⟶ X` to proper pushforward along `g`. -/
theorem chowGroupBaseUnitCollapse_properChowPushforward
    (hpp : ProperPushforwardDescends C) (p : ℤ)
    (z : chowGroup C (pullback.fst (g ≫ sX) (𝟙 C.S) ≫ (g ≫ sX)) (0 - p)) :
    chowGroupBaseUnitCollapse C sX p
        (properChowPushforward C (pullback.fst (g ≫ sX) (𝟙 C.S) ≫ (g ≫ sX))
          (pullback.fst sX (𝟙 C.S) ≫ sX) (bivariantPushforwardBaseChange g sX (𝟙 C.S))
          (bivariantPushforwardBaseChange_comp_structure (rfl : g ≫ sX = g ≫ sX) sX (𝟙 C.S))
          (0 - p) (hpp _ _ _ _ _) z) =
      properChowPushforward C (g ≫ sX) sX g rfl (-p) (hpp _ _ g rfl _)
        (chowGroupBaseUnitCollapse C (g ≫ sX) p z) :=
  chowPushforwardOfIso_properChowPushforward_baseChange C sX g hpp (zero_sub p) z

end Collapse

/-! ### The flat pullback of the fundamental class of the base -/

/-- The flat pullback of the fundamental class `[Spec k]` of the base along the base change
`W ×_{Spec k} Spec k ⟶ Spec k` of the structure morphism of a scheme `W` flat of relative dimension
`r` over the base, read on `W` itself through the collapse of `W ×_{Spec k} Spec k` along its first
projection. -/
def flatPullbackBaseClass (C : ChowSituation.{u}) {W : Scheme.{u}} (sW : W ⟶ C.S)
    [LocallyOfFiniteType sW] [Flat sW] (r : ℕ)
    (hr : AlgebraicGeometry.RelativeDimension sW r) (hS1 : FlatPullbackDescends C) :
    chowGroup C sW (-(-(r : ℤ))) :=
  chowGroupBaseUnitCollapse C sW (-(r : ℤ))
    (chowGroupDegreeEquiv C (pullback.fst sW (𝟙 C.S) ≫ sW)
      (by ring : (0 : ℤ) + (r : ℤ) = 0 - -(r : ℤ))
      (flatPullbackChow C (pullback.fst sW (𝟙 C.S) ≫ sW) (𝟙 C.S ≫ 𝟙 C.S)
        (pullback.snd sW (𝟙 C.S))
        (pullbackSnd_comp_structureMorphism (Category.comp_id sW) (𝟙 C.S)) r
        (relativeDimension_pullbackSnd sW hr (𝟙 C.S)) 0
        (hS1 (pullback.fst sW (𝟙 C.S) ≫ sW) (𝟙 C.S ≫ 𝟙 C.S) (pullback.snd sW (𝟙 C.S))
          (pullbackSnd_comp_structureMorphism (Category.comp_id sW) (𝟙 C.S)) r
          (relativeDimension_pullbackSnd sW hr (𝟙 C.S)) 0)
        (baseFundamentalClass C)))

/-- The class of Stacks 0B78 for the structure morphism of `W` evaluates, under the canonical map
`Stacks.Chow.bivariantToBaseEval` for `W`, to `Stacks.Chow.flatPullbackBaseClass`. -/
theorem bivariantToBaseEval_flatPullbackBivariantClass (C : ChowSituation.{u}) (G : GysinSystem C)
    {W : Scheme.{u}} (sW : W ⟶ C.S) [LocallyOfFiniteType sW] [Flat sW] (r : ℕ)
    (hr : AlgebraicGeometry.RelativeDimension sW r) (hS1 : FlatPullbackDescends C)
    (hRG : ProperPushforwardFlatPullbackBaseChange C) (h71 : G.FlatPullbackNaturality r) :
    bivariantToBaseEval C G sW (-(r : ℤ))
        (flatPullbackBivariantClass C G sW (𝟙 C.S) sW (Category.comp_id sW) r hr hS1 hRG h71) =
      flatPullbackBaseClass C sW r hr hS1 :=
  rfl

/-! ### The generating hypothesis -/

/-- Every Chow class of a scheme locally of finite type over the base is a sum of proper
pushforwards, and negatives of proper pushforwards, of flat pullbacks of the fundamental class of
the base: the Chow group `CH_{-p}(X)` is generated by the classes
`g_*(Stacks.Chow.flatPullbackBaseClass)` for `g : W ⟶ X` proper with `W` flat over the base of
relative dimension `r` satisfying `-r = p`. A generator is compared with such a class, which lives
in degree `-(-r)`, by a heterogeneous equality. -/
def ChowClassesGeneratedByBaseFlatPullbacks (C : ChowSituation.{u})
    (hS1 : FlatPullbackDescends C) (hpp : ProperPushforwardDescends C) : Prop :=
  ∀ {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX] (p : ℤ)
      (α : chowGroup C sX (-p)),
    α ∈ AddSubgroup.closure
      {β : chowGroup C sX (-p) |
        ∃ (W : Scheme.{u}) (g : W ⟶ X) (hgp : IsProper g)
          (hgt : LocallyOfFiniteType (g ≫ sX)) (hgf : Flat (g ≫ sX)) (r : ℕ)
          (hr : AlgebraicGeometry.RelativeDimension (g ≫ sX) r), -(r : ℤ) = p ∧
          letI := hgp
          letI := hgt
          letI := hgf
          β ≍ properChowPushforward C (g ≫ sX) sX g rfl (-(-(r : ℤ))) (hpp _ _ g rfl _)
            (flatPullbackBaseClass C (g ≫ sX) r hr hS1)}

/-! ### Surjectivity -/

section Surjective

variable (C : ChowSituation.{u}) (G : GysinSystem C) {X : Scheme.{u}} (sX : X ⟶ C.S)
  [LocallyOfFiniteType sX] (p : ℤ)

/-- Let `g : W ⟶ X` be proper, with `W` flat of relative dimension `r` over the base, and let `d`
be a proper pushforward along `g` of the bivariant class of Stacks 0B78 for the structure morphism
of `W`. The image of `d` under `Stacks.Chow.bivariantToBaseEval` is the proper pushforward along
`g` of `Stacks.Chow.flatPullbackBaseClass`. -/
theorem bivariantToBaseEval_flatPullbackProperPushforward
    (hS1 : FlatPullbackDescends C) (hRG : ProperPushforwardFlatPullbackBaseChange C)
    (hpp : ProperPushforwardDescends C) {W : Scheme.{u}} (g : W ⟶ X) [IsProper g]
    [LocallyOfFiniteType (g ≫ sX)] [Flat (g ≫ sX)] (r : ℕ)
    (hr : AlgebraicGeometry.RelativeDimension (g ≫ sX) r) (h71 : G.FlatPullbackNaturality r)
    {d : bivariantToBase C G sX (-(r : ℤ))}
    (hd : IsBivariantProperPushforward C G (g ≫ sX) sX (𝟙 C.S) g sX rfl (Category.comp_id sX) hpp
      (-(r : ℤ))
      (flatPullbackBivariantClass C G (g ≫ sX) (𝟙 C.S) (g ≫ sX)
        (comp_comp_structureMorphism_eq (rfl : g ≫ sX = g ≫ sX) (Category.comp_id sX)) r hr hS1
        hRG h71)
      d) :
    bivariantToBaseEval C G sX (-(r : ℤ)) d =
      properChowPushforward C (g ≫ sX) sX g rfl (-(-(r : ℤ))) (hpp _ _ g rfl _)
        (flatPullbackBaseClass C (g ≫ sX) r hr hS1) := by
  rw [bivariantToBaseEval_apply, hd (𝟙 C.S) 0 (baseFundamentalClass C),
    bivariantProperPushforwardCap_apply]
  exact chowGroupBaseUnitCollapse_properChowPushforward C sX g hpp (-(r : ℤ)) _

/-- The canonical map `A^p(X ⟶ Spec k) ⟶ CH_{-p}(X)`, cap product with the fundamental class of the
point, is surjective. The hypotheses are the existence of proper pushforwards of bivariant classes
(`hEPK`, Stacks 0EPK), the generation of `CH_{-p}(X)` by proper pushforwards of flat pullbacks of
`[Spec k]` (`hgen`), the descent of flat pullback and proper pushforward to Chow groups (`hS1`,
`hpp`), Stacks 02RG (`hRG`) and Stacks 0B71 in every relative dimension (`h71`). -/
@[stacks 0FBW "surjectivity of the canonical identification; hEPK is Stacks 0EPK, hgen is the \
generation of Chow homology by proper pushforwards of flat pullbacks of the class of the point \
(Stacks 02UC with Stacks 02R4), hS1 is Stacks 02S1, hpp is Stacks 02S2, hRG is Stacks 02RG and \
h71 is Stacks 0B71 in every relative dimension"]
theorem bivariantToBaseEval_surjective (hS1 : FlatPullbackDescends C)
    (hRG : ProperPushforwardFlatPullbackBaseChange C) (hpp : ProperPushforwardDescends C)
    (h71 : ∀ r : ℕ, G.FlatPullbackNaturality r)
    (hEPK : BivariantProperPushforwardExists C G)
    (hgen : ChowClassesGeneratedByBaseFlatPullbacks C hS1 hpp) :
    Function.Surjective (bivariantToBaseEval C G sX p) := by
  intro α
  refine (AddSubgroup.closure_le (K := (bivariantToBaseEval C G sX p).range)).2 ?_ (hgen sX p α)
  rintro β ⟨W, g, hgp, hgt, hgf, r, hr, rfl, hβ⟩
  obtain ⟨d, hd⟩ := hEPK (g ≫ sX) sX (𝟙 C.S) g sX rfl (Category.comp_id sX) hpp (-(r : ℤ))
    (flatPullbackBivariantClass C G (g ≫ sX) (𝟙 C.S) (g ≫ sX)
      (comp_comp_structureMorphism_eq (rfl : g ≫ sX = g ≫ sX) (Category.comp_id sX)) r hr hS1
      hRG (h71 r))
  exact ⟨d, (bivariantToBaseEval_flatPullbackProperPushforward C G sX hS1 hRG hpp g r hr (h71 r)
    hd).trans (eq_of_heq hβ).symm⟩

/-- The canonical map `A^p(X ⟶ Spec k) ⟶ CH_{-p}(X)` is bijective when the base has one point and
is integral, that is, is the spectrum of a field: cap product with the fundamental class of the
point identifies the bivariant classes of degree `p` for the structure morphism of `X` with the
Chow homology of `X` in degree `-p`. The hypotheses are those of
`Stacks.Chow.bivariantToBaseEval_injective` and `Stacks.Chow.bivariantToBaseEval_surjective`. -/
@[stacks 0FBW "the canonical identification A^p(X → Spec k) = CH_{-p}(X), for the base being the \
spectrum of a field; hEPK is Stacks 0EPK, hgen is Stacks 02R4, hS1 is Stacks 02S1, hpp is \
Stacks 02S2, hRG is Stacks 02RG, h71 is Stacks 0B71 and hfund is Stacks 02NK with Stacks 02R4"]
theorem bivariantToBaseEval_bijective
    [Subsingleton C.S] [IsIntegral C.S] (hS1 : FlatPullbackDescends C)
    (hfund : IntegralFundamentalClassIsFlatPullback C hS1)
    (hRG : ProperPushforwardFlatPullbackBaseChange C) (hpp : ProperPushforwardDescends C)
    (h71 : ∀ r : ℕ, G.FlatPullbackNaturality r)
    (hEPK : BivariantProperPushforwardExists C G)
    (hgen : ChowClassesGeneratedByBaseFlatPullbacks C hS1 hpp) :
    Function.Bijective (bivariantToBaseEval C G sX p) :=
  ⟨bivariantToBaseEval_injective C G sX p hS1 hfund,
    bivariantToBaseEval_surjective C G sX p hS1 hRG hpp h71 hEPK hgen⟩

/-- The identification `A^p(X ⟶ Spec k) ≃+ CH_{-p}(X)` of abelian groups given by cap product with
the fundamental class of the point, when the base is the spectrum of a field. -/
def bivariantToBaseEquiv
    [Subsingleton C.S] [IsIntegral C.S] (hS1 : FlatPullbackDescends C)
    (hfund : IntegralFundamentalClassIsFlatPullback C hS1)
    (hRG : ProperPushforwardFlatPullbackBaseChange C) (hpp : ProperPushforwardDescends C)
    (h71 : ∀ r : ℕ, G.FlatPullbackNaturality r)
    (hEPK : BivariantProperPushforwardExists C G)
    (hgen : ChowClassesGeneratedByBaseFlatPullbacks C hS1 hpp) :
    bivariantToBase C G sX p ≃+ chowGroup C sX (-p) :=
  AddEquiv.ofBijective (bivariantToBaseEval C G sX p)
    (bivariantToBaseEval_bijective C G sX p hS1 hfund hRG hpp h71 hEPK hgen)

end Surjective

end Stacks.Chow

end
