module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Chow.Bivariant.Commuting
public import StacksFrontier.AlgebraicGeometry.Chow.Bivariant.ProperPushforward
public import StacksFrontier.AlgebraicGeometry.Chow.FlatPullback.IsomorphismBaseChange

/-!
# Bivariant classes towards the base commute with bivariant classes over the base

Let `(S, δ)` be the base situation of chapter 42 of the Stacks Project, let `X` be a scheme
locally of finite type over `S`, let `c ∈ A^p(X ⟶ S)` and let `c' ∈ A^q(Y ⟶ Z)` for a morphism
`Y ⟶ Z` of schemes locally of finite type over `S`. Capping with `c` and capping with `c'` are
two operations that can be performed in either order on a class `α ∈ CH_k(T)` of a test scheme
`t : T ⟶ Z`, giving classes on `Y ×_Z (X ×_S T)` and on `X ×_S (Y ×_Z T)`, and the assertion that
they agree is `Stacks.Chow.BivariantCommuteOverBase`.

## Main definitions

* `Stacks.Chow.mixedCommuteHom` — the canonical isomorphism
  `X ×_S (Y ×_Z T) ≅ Y ×_Z (X ×_S T)` on which the two iterated cap operations land.
* `Stacks.Chow.mixedIteratedCapBaseFirst`, `Stacks.Chow.mixedIteratedCapBaseLast` — the two
  iterated cap operations `α ↦ c' ∩ (c ∩ α)` and `α ↦ c ∩ (c' ∩ α)`.
* `Stacks.Chow.BivariantCommuteOverBase` — the assertion that the two agree, which is the
  equality `c ∘ c' = c' ∘ c` read on the cap operations of the two composites.
* `Stacks.Chow.IsFlatPullbackOverBase` — the assertion that `c` is the flat-pullback class of a
  structure morphism `X ⟶ S` which is flat of relative dimension `r`.
* `Stacks.Chow.chowOperationGenerators`, `Stacks.Chow.IsChowOperationGenerated` — the
  flat-pullback classes towards the base, and the subgroup of `A^p(X ⟶ S)` they generate.

## Main results

* `Stacks.Chow.bivariantCommuteOverBase_of_isFlatPullbackOverBase` — a flat-pullback class
  towards the base commutes with every bivariant class over the base. This is the flat-pullback
  compatibility required of a bivariant class in Stacks 0B76, applied to `c'` and read through
  the comparison isomorphism.
* `Stacks.Chow.bivariantCommuteOverBase_zero`, `_add`, `_neg` — commuting with a fixed class over
  the base is preserved by the group operations, so the classes commuting with `c'` form a
  subgroup of `A^p(X ⟶ S)`.
* `Stacks.Chow.bivariantCommuteOverBase_of_isChowOperationGenerated` — **Stacks 0FC6** for a class
  `c` generated by those operations.

## Implementation notes

The equality of the two composites is read on their cap operations, which by the characterization
`Stacks.Chow.IsBivariantClassComposition` of Stacks 0FE0 determine them; this is the convention of
`Stacks.Chow.BivariantCommute` for Stacks 0FA2. The composite class itself is
`Stacks.Chow.bivariantComposite`. Reading the equality on cap operations instead keeps this file
clear of the two cases of Stacks 02TA for the Gysin system that assembling that class needs, and
of the heterogeneous equality that the two readings `k - q - p` and `k - (p + q)` of its degree
force.

The structural input the source proof takes from Stacks 0FC5 is that `c` is a combination of
proper pushforward, integral multiples over connected components, flat pullback and Gysin maps.
The generators treated here are the flat pullbacks, and `Stacks.Chow.IsChowOperationGenerated` is
the subgroup they generate under integral combinations. The Gysin generators, the Gysin bivariant
classes of Stacks 0B79 (`Stacks.Chow.gysinBivariantClass`), are not among them.

Stacks 02S1 is carried as a hypothesis, spelled out rather than abbreviated, in the shape of
`Stacks.Chow.FlatPullbackDescends`.

## References

* [Stacks Project, Tag 0FC6](https://stacks.math.columbia.edu/tag/0FC6)
* [Stacks Project, Tag 0FC5](https://stacks.math.columbia.edu/tag/0FC5)
* [Stacks Project, Tag 0B76](https://stacks.math.columbia.edu/tag/0B76)
* [Stacks Project, Tag 0B78](https://stacks.math.columbia.edu/tag/0B78)
* [Stacks Project, Tag 02S1](https://stacks.math.columbia.edu/tag/02S1)
* [Stacks Project, Tag 02RG](https://stacks.math.columbia.edu/tag/02RG)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace Stacks.Chow

/-! ### The comparison isomorphism of the two iterated fibre products -/

section Comparison

variable {C : ChowSituation.{u}} {X Y Z : Scheme.{u}} (sX : X ⟶ C.S) (sZ : Z ⟶ C.S) (w : Y ⟶ Z)

/-- The projection `X ×_S (Y ×_Z T) ⟶ X ×_S T` forgetting the point of `Y`. -/
def mixedCommuteSnd {T : Scheme.{u}} (t : T ⟶ Z) :
    pullback sX (pullback.fst w t ≫ (w ≫ sZ)) ⟶ pullback sX (t ≫ sZ) :=
  pullback.lift (pullback.fst sX (pullback.fst w t ≫ (w ≫ sZ)))
    (pullback.snd sX (pullback.fst w t ≫ (w ≫ sZ)) ≫ pullback.snd w t)
    (by
      rw [pullback.condition (f := sX) (g := pullback.fst w t ≫ (w ≫ sZ))]
      simp only [Category.assoc]
      rw [← Category.assoc (pullback.fst w t) w sZ, pullback.condition (f := w) (g := t),
        Category.assoc])

/-- `mixedCommuteSnd` followed by the first projection is the first projection. -/
@[reassoc (attr := simp)]
theorem mixedCommuteSnd_fst {T : Scheme.{u}} (t : T ⟶ Z) :
    mixedCommuteSnd sX sZ w t ≫ pullback.fst sX (t ≫ sZ) =
      pullback.fst sX (pullback.fst w t ≫ (w ≫ sZ)) :=
  pullback.lift_fst _ _ _

/-- `mixedCommuteSnd` followed by the second projection is the projection to `T`. -/
@[reassoc (attr := simp)]
theorem mixedCommuteSnd_snd {T : Scheme.{u}} (t : T ⟶ Z) :
    mixedCommuteSnd sX sZ w t ≫ pullback.snd sX (t ≫ sZ) =
      pullback.snd sX (pullback.fst w t ≫ (w ≫ sZ)) ≫ pullback.snd w t :=
  pullback.lift_snd _ _ _

/-- The canonical morphism `X ×_S (Y ×_Z T) ⟶ Y ×_Z (X ×_S T)` over a test scheme `t : T ⟶ Z`:
it reads the same triple of points of `X`, `Y` and `T` in the other order. -/
def mixedCommuteHom {T : Scheme.{u}} (t : T ⟶ Z) :
    pullback sX (pullback.fst w t ≫ (w ≫ sZ)) ⟶ pullback w (pullback.snd sX (t ≫ sZ) ≫ t) :=
  pullback.lift (pullback.snd sX (pullback.fst w t ≫ (w ≫ sZ)) ≫ pullback.fst w t)
    (mixedCommuteSnd sX sZ w t)
    (by
      rw [mixedCommuteSnd_snd_assoc]
      simp only [Category.assoc, pullback.condition])

/-- `mixedCommuteHom` followed by the first projection is the projection to `Y`. -/
@[reassoc (attr := simp)]
theorem mixedCommuteHom_fst {T : Scheme.{u}} (t : T ⟶ Z) :
    mixedCommuteHom sX sZ w t ≫ pullback.fst w (pullback.snd sX (t ≫ sZ) ≫ t) =
      pullback.snd sX (pullback.fst w t ≫ (w ≫ sZ)) ≫ pullback.fst w t :=
  pullback.lift_fst _ _ _

/-- `mixedCommuteHom` followed by the second projection is `mixedCommuteSnd`. -/
@[reassoc (attr := simp)]
theorem mixedCommuteHom_snd {T : Scheme.{u}} (t : T ⟶ Z) :
    mixedCommuteHom sX sZ w t ≫ pullback.snd w (pullback.snd sX (t ≫ sZ) ≫ t) =
      mixedCommuteSnd sX sZ w t :=
  pullback.lift_snd _ _ _

/-- The projection `Y ×_Z (X ×_S T) ⟶ Y ×_Z T` forgetting the point of `X`. -/
def mixedCommuteInvSnd {T : Scheme.{u}} (t : T ⟶ Z) :
    pullback w (pullback.snd sX (t ≫ sZ) ≫ t) ⟶ pullback w t :=
  pullback.lift (pullback.fst w (pullback.snd sX (t ≫ sZ) ≫ t))
    (pullback.snd w (pullback.snd sX (t ≫ sZ) ≫ t) ≫ pullback.snd sX (t ≫ sZ))
    (by simp only [Category.assoc, pullback.condition])

/-- `mixedCommuteInvSnd` followed by the first projection is the first projection. -/
@[reassoc (attr := simp)]
theorem mixedCommuteInvSnd_fst {T : Scheme.{u}} (t : T ⟶ Z) :
    mixedCommuteInvSnd sX sZ w t ≫ pullback.fst w t =
      pullback.fst w (pullback.snd sX (t ≫ sZ) ≫ t) :=
  pullback.lift_fst _ _ _

/-- `mixedCommuteInvSnd` followed by the second projection is the projection to `T`. -/
@[reassoc (attr := simp)]
theorem mixedCommuteInvSnd_snd {T : Scheme.{u}} (t : T ⟶ Z) :
    mixedCommuteInvSnd sX sZ w t ≫ pullback.snd w t =
      pullback.snd w (pullback.snd sX (t ≫ sZ) ≫ t) ≫ pullback.snd sX (t ≫ sZ) :=
  pullback.lift_snd _ _ _

/-- The canonical morphism `Y ×_Z (X ×_S T) ⟶ X ×_S (Y ×_Z T)` over a test scheme `t : T ⟶ Z`,
inverse to `Stacks.Chow.mixedCommuteHom`. -/
def mixedCommuteInv {T : Scheme.{u}} (t : T ⟶ Z) :
    pullback w (pullback.snd sX (t ≫ sZ) ≫ t) ⟶ pullback sX (pullback.fst w t ≫ (w ≫ sZ)) :=
  pullback.lift
    (pullback.snd w (pullback.snd sX (t ≫ sZ) ≫ t) ≫ pullback.fst sX (t ≫ sZ))
    (mixedCommuteInvSnd sX sZ w t)
    (by
      rw [mixedCommuteInvSnd_fst_assoc]
      simp only [Category.assoc, pullback.condition, pullback.condition_assoc])

/-- `mixedCommuteInv` followed by the first projection is the projection to `X`. -/
@[reassoc (attr := simp)]
theorem mixedCommuteInv_fst {T : Scheme.{u}} (t : T ⟶ Z) :
    mixedCommuteInv sX sZ w t ≫ pullback.fst sX (pullback.fst w t ≫ (w ≫ sZ)) =
      pullback.snd w (pullback.snd sX (t ≫ sZ) ≫ t) ≫ pullback.fst sX (t ≫ sZ) :=
  pullback.lift_fst _ _ _

/-- `mixedCommuteInv` followed by the second projection is `mixedCommuteInvSnd`. -/
@[reassoc (attr := simp)]
theorem mixedCommuteInv_snd {T : Scheme.{u}} (t : T ⟶ Z) :
    mixedCommuteInv sX sZ w t ≫ pullback.snd sX (pullback.fst w t ≫ (w ≫ sZ)) =
      mixedCommuteInvSnd sX sZ w t :=
  pullback.lift_snd _ _ _

/-- `mixedCommuteInv` is a left inverse of `mixedCommuteHom`. -/
@[simp]
theorem mixedCommuteHom_comp_mixedCommuteInv {T : Scheme.{u}} (t : T ⟶ Z) :
    mixedCommuteHom sX sZ w t ≫ mixedCommuteInv sX sZ w t =
      𝟙 (pullback sX (pullback.fst w t ≫ (w ≫ sZ))) := by
  refine pullback.hom_ext ?_ (pullback.hom_ext ?_ ?_) <;> simp

/-- `mixedCommuteInv` is a right inverse of `mixedCommuteHom`. -/
@[simp]
theorem mixedCommuteInv_comp_mixedCommuteHom {T : Scheme.{u}} (t : T ⟶ Z) :
    mixedCommuteInv sX sZ w t ≫ mixedCommuteHom sX sZ w t =
      𝟙 (pullback w (pullback.snd sX (t ≫ sZ) ≫ t)) := by
  refine pullback.hom_ext ?_ (pullback.hom_ext ?_ ?_) <;> simp

/-- The comparison morphism `mixedCommuteHom` is an isomorphism, with inverse
`mixedCommuteInv`. -/
instance isIso_mixedCommuteHom {T : Scheme.{u}} (t : T ⟶ Z) :
    IsIso (mixedCommuteHom sX sZ w t) :=
  ⟨⟨mixedCommuteInv sX sZ w t, mixedCommuteHom_comp_mixedCommuteInv sX sZ w t,
    mixedCommuteInv_comp_mixedCommuteHom sX sZ w t⟩⟩

/-- The comparison isomorphism is compatible with the structure morphisms of the two iterated
fibre products over the base. -/
theorem mixedCommuteHom_comp_structureMorphism {T : Scheme.{u}} (t : T ⟶ Z) :
    mixedCommuteHom sX sZ w t ≫
        (pullback.fst w (pullback.snd sX (t ≫ sZ) ≫ t) ≫ (w ≫ sZ)) =
      pullback.fst sX (pullback.fst w t ≫ (w ≫ sZ)) ≫ sX := by
  rw [mixedCommuteHom_fst_assoc,
    pullback.condition (f := sX) (g := pullback.fst w t ≫ (w ≫ sZ))]

/-- The comparison isomorphism carries the projection to `Y ×_Z T` to the base-change map of test
schemes along `X ×_S T ⟶ T`. -/
theorem mixedCommuteHom_comp_bivariantBaseChangeMap {T : Scheme.{u}} (t : T ⟶ Z) :
    mixedCommuteHom sX sZ w t ≫
        bivariantBaseChangeMap w t (pullback.snd sX (t ≫ sZ)) =
      pullback.snd sX (pullback.fst w t ≫ (w ≫ sZ)) := by
  refine pullback.hom_ext ?_ ?_ <;> simp [bivariantBaseChangeMap]

end Comparison

/-! ### The two iterated cap operations -/

section Iterated

variable (C : ChowSituation.{u}) (G : GysinSystem C) {X Y Z : Scheme.{u}} (sX : X ⟶ C.S)
  [LocallyOfFiniteType sX] (sZ : Z ⟶ C.S) [LocallyOfFiniteType sZ] (w : Y ⟶ Z)
  [LocallyOfFiniteType w] (p q : ℤ)
  (c : BivariantClass C G sX (𝟙 C.S) sX (Category.comp_id sX) p)
  (c' : BivariantClass C G (w ≫ sZ) sZ w rfl q)

/-- The iterated cap operation `α ↦ c' ∩ (c ∩ α)` at a test scheme `t : T ⟶ Z`: capping with `c`
produces a class on `X ×_S T`, which is a test scheme over `Z`, and capping that with `c'`
produces a class on `Y ×_Z (X ×_S T)`. -/
def mixedIteratedCapBaseFirst {T : Scheme.{u}} (t : T ⟶ Z) [LocallyOfFiniteType t] (k : ℤ) :
    chowGroup C (t ≫ sZ) k →+
      chowGroup C (pullback.fst w (pullback.snd sX (t ≫ sZ) ≫ t) ≫ (w ≫ sZ)) ((k - p) - q) :=
  (c'.cap (pullback.snd sX (t ≫ sZ) ≫ t) (k - p)).comp
    (((chowGroupCongr C
      (by rw [Category.assoc]; exact pullback.condition (f := sX) (g := t ≫ sZ))
        (k - p)).toAddMonoidHom).comp
      ((c.cap (t ≫ sZ) k).comp
        (chowGroupCongr C (Category.comp_id (t ≫ sZ)).symm k).toAddMonoidHom))

/-- The iterated cap operation `α ↦ c ∩ (c' ∩ α)` at a test scheme `t : T ⟶ Z`: capping with `c'`
produces a class on `Y ×_Z T`, which is a scheme locally of finite type over the base, and
capping that with `c` produces a class on `X ×_S (Y ×_Z T)`. -/
def mixedIteratedCapBaseLast {T : Scheme.{u}} (t : T ⟶ Z) [LocallyOfFiniteType t] (k : ℤ) :
    chowGroup C (t ≫ sZ) k →+
      chowGroup C (pullback.fst sX (pullback.fst w t ≫ (w ≫ sZ)) ≫ sX) ((k - q) - p) :=
  (c.cap (pullback.fst w t ≫ (w ≫ sZ)) (k - q)).comp
    (((chowGroupCongr C (Category.comp_id (pullback.fst w t ≫ (w ≫ sZ))).symm
      (k - q)).toAddMonoidHom).comp (c'.cap t k))

/-- Unfolding `mixedIteratedCapBaseFirst` on a class: cap with `c`, then with `c'`. -/
@[simp]
theorem mixedIteratedCapBaseFirst_apply {T : Scheme.{u}} (t : T ⟶ Z) [LocallyOfFiniteType t]
    (k : ℤ) (α : chowGroup C (t ≫ sZ) k) :
    mixedIteratedCapBaseFirst C G sX sZ w p q c c' t k α =
      c'.cap (pullback.snd sX (t ≫ sZ) ≫ t) (k - p)
        (chowGroupCongr C
          (by rw [Category.assoc]; exact pullback.condition (f := sX) (g := t ≫ sZ)) (k - p)
          (c.cap (t ≫ sZ) k (chowGroupCongr C (Category.comp_id (t ≫ sZ)).symm k α))) :=
  rfl

/-- Unfolding `mixedIteratedCapBaseLast` on a class: cap with `c'`, then with `c`. -/
@[simp]
theorem mixedIteratedCapBaseLast_apply {T : Scheme.{u}} (t : T ⟶ Z) [LocallyOfFiniteType t]
    (k : ℤ) (α : chowGroup C (t ≫ sZ) k) :
    mixedIteratedCapBaseLast C G sX sZ w p q c c' t k α =
      c.cap (pullback.fst w t ≫ (w ≫ sZ)) (k - q)
        (chowGroupCongr C (Category.comp_id (pullback.fst w t ≫ (w ≫ sZ))).symm (k - q)
          (c'.cap t k α)) :=
  rfl

/-! ### Commuting over the base -/

/-- The assertion that capping with `c ∈ A^p(X ⟶ S)` and capping with `c' ∈ A^q(Y ⟶ Z)` may be
performed in either order: for every test scheme `t : T ⟶ Z` locally of finite type and every
`α ∈ CH_k(T)`,

  `c ∩ (c' ∩ α) = c' ∩ (c ∩ α)`   in   `CH_{k - p - q}(X ×_S Y ×_Z T)`,

the two sides being read on the two iterated fibre products `X ×_S (Y ×_Z T)` and
`Y ×_Z (X ×_S T)` through `Stacks.Chow.mixedCommuteHom` and in the two degrees `(k - q) - p` and
`(k - p) - q`. This is the content of the equality `c ∘ c' = c' ∘ c` of Stacks 0FC6: the cap
operation of either composite at `t` is the corresponding iterated cap operation. -/
def BivariantCommuteOverBase : Prop :=
  ∀ {T : Scheme.{u}} (t : T ⟶ Z) [LocallyOfFiniteType t] (k : ℤ)
    (α : chowGroup C (t ≫ sZ) k),
    chowPushforwardOfIso C (pullback.fst sX (pullback.fst w t ≫ (w ≫ sZ)) ≫ sX)
        (pullback.fst w (pullback.snd sX (t ≫ sZ) ≫ t) ≫ (w ≫ sZ))
        (mixedCommuteHom sX sZ w t) (mixedCommuteHom_comp_structureMorphism sX sZ w t)
        ((k - q) - p) (mixedIteratedCapBaseLast C G sX sZ w p q c c' t k α) =
      chowGroupDegreeEquiv C (pullback.fst w (pullback.snd sX (t ≫ sZ) ≫ t) ≫ (w ≫ sZ))
        (by ring : (k - p) - q = (k - q) - p)
        (mixedIteratedCapBaseFirst C G sX sZ w p q c c' t k α)

end Iterated

/-! ### Heterogeneous congruences -/

section Congruence

variable {C : ChowSituation.{u}}

/-- Capping with a bivariant class respects heterogeneous equality of its argument. -/
theorem BivariantClass.cap_heq {G : GysinSystem C} {X Y : Scheme.{u}} {sX : X ⟶ C.S}
    [LocallyOfFiniteType sX] {sY : Y ⟶ C.S} [LocallyOfFiniteType sY] {f : X ⟶ Y}
    [LocallyOfFiniteType f] {hf : f ≫ sY = sX} {p : ℤ}
    (c : BivariantClass C G sX sY f hf p) {T : Scheme.{u}} (g : T ⟶ Y) [LocallyOfFiniteType g]
    {k l : ℤ} (hkl : k = l) {x : chowGroup C (g ≫ sY) k} {y : chowGroup C (g ≫ sY) l}
    (hxy : x ≍ y) : c.cap g k x ≍ c.cap g l y := by
  subst hkl
  rw [eq_of_heq hxy]

/-- Pushforward along an isomorphism over the base respects heterogeneous equality, in the
structure morphisms, the degree and the argument. -/
theorem chowPushforwardOfIso_heq {A B : Scheme.{u}} {sA sA' : A ⟶ C.S} [LocallyOfFiniteType sA]
    [LocallyOfFiniteType sA'] {sB sB' : B ⟶ C.S} [LocallyOfFiniteType sB]
    [LocallyOfFiniteType sB'] (v : A ⟶ B) [IsIso v] (hv : v ≫ sB = sA) (hv' : v ≫ sB' = sA')
    {k l : ℤ} (hsA : sA = sA') (hsB : sB = sB') (hkl : k = l) {x : chowGroup C sA k}
    {y : chowGroup C sA' l} (hxy : x ≍ y) :
    chowPushforwardOfIso C sA sB v hv k x ≍ chowPushforwardOfIso C sA' sB' v hv' l y := by
  subst hsA
  subst hsB
  subst hkl
  rw [eq_of_heq hxy]

end Congruence

/-! ### The flat-pullback class towards the base -/

section Flat

variable (C : ChowSituation.{u}) (G : GysinSystem C) {X Y Z : Scheme.{u}} (sX : X ⟶ C.S)
  [LocallyOfFiniteType sX] (sZ : Z ⟶ C.S) [LocallyOfFiniteType sZ] (w : Y ⟶ Z)
  [LocallyOfFiniteType w] (r : ℕ) (p q : ℤ)
  (c : BivariantClass C G sX (𝟙 C.S) sX (Category.comp_id sX) p)
  (c' : BivariantClass C G (w ≫ sZ) sZ w rfl q)

/-- The assertion that `c ∈ A^{-r}(X ⟶ S)` is the flat-pullback class of a structure morphism
`X ⟶ S` which is flat of relative dimension `r`: capping with `c` at a test scheme `u : U ⟶ S` is
flat pullback along the base change `X ×_S U ⟶ U`. This is the class of Stacks 0B78 for the
structure morphism of `X`. -/
def IsFlatPullbackOverBase : Prop :=
  ∀ {U : Scheme.{u}} (u : U ⟶ C.S) [LocallyOfFiniteType u] (sU' : pullback sX u ⟶ C.S)
    [LocallyOfFiniteType sU'] [LocallyOfFiniteType (pullback.snd sX u)]
    [Flat (pullback.snd sX u)] (hsU' : pullback.snd sX u ≫ u = sU')
    (hr : AlgebraicGeometry.RelativeDimension (pullback.snd sX u) r) (k : ℤ)
    (hfac : FlatPullbackFactorsThroughRationalEquivalence C sU' u (pullback.snd sX u) hsU' r hr k)
    (α : chowGroup C u k),
    c.cap u k (chowGroupCongr C (Category.comp_id u).symm k α) ≍
      flatPullbackChow C sU' u (pullback.snd sX u) hsU' r hr k hfac α

/-- The base change of a flat morphism locally of finite type and of relative dimension `r` has
the same three properties. -/
private theorem lft_flat_relativeDimension_of_isPullback {A B P Q : Scheme.{u}} {fst : P ⟶ A}
    {snd : P ⟶ B} {f : A ⟶ Q} {g : B ⟶ Q} (hsq : IsPullback fst snd f g)
    [LocallyOfFiniteType f] [Flat f] {r : ℕ} (hr : AlgebraicGeometry.RelativeDimension f r) :
    ∃ (_ : LocallyOfFiniteType snd) (_ : Flat snd),
      AlgebraicGeometry.RelativeDimension snd r := by
  have h₁ : LocallyOfFiniteType snd :=
    MorphismProperty.of_isPullback hsq (P := @LocallyOfFiniteType) inferInstance
  have h₂ : Flat snd := MorphismProperty.of_isPullback hsq (P := @Flat) inferInstance
  exact ⟨h₁, h₂, AlgebraicGeometry.RelativeDimension.of_isPullback hsq hr⟩

/-- A flat-pullback class towards the base commutes with every bivariant class over the base.
This is the flat-pullback case of the proof of Stacks 0FC6: the identity to be proved is exactly
the flat-pullback compatibility required of a bivariant class in Stacks 0B76, applied to `c'` and
read through the comparison isomorphism of the two iterated fibre products. -/
theorem bivariantCommuteOverBase_of_isFlatPullbackOverBase
    (hfd : ∀ {A B : Scheme.{u}} (sA : A ⟶ C.S) [LocallyOfFiniteType sA]
      (sB : B ⟶ C.S) [LocallyOfFiniteType sB] (v : A ⟶ B) [LocallyOfFiniteType v] [Flat v]
      (hv : v ≫ sB = sA) (r : ℕ) (hr : AlgebraicGeometry.RelativeDimension v r) (k : ℤ),
      FlatPullbackFactorsThroughRationalEquivalence C sA sB v hv r hr k)
    [Flat sX] (hp : p = -(r : ℤ)) (hrX : AlgebraicGeometry.RelativeDimension sX r)
    (hc : IsFlatPullbackOverBase C G sX r p c) :
    BivariantCommuteOverBase C G sX sZ w p q c c' := by
  intro T t _ k α
  have hsqT : IsPullback (pullback.fst sX (t ≫ sZ)) (pullback.snd sX (t ≫ sZ)) sX (t ≫ sZ) :=
    IsPullback.of_hasPullback sX (t ≫ sZ)
  obtain ⟨_, _, hrT⟩ := lft_flat_relativeDimension_of_isPullback hsqT hrX
  have hsqW : IsPullback (pullback.fst sX (pullback.fst w t ≫ (w ≫ sZ)))
      (pullback.snd sX (pullback.fst w t ≫ (w ≫ sZ))) sX (pullback.fst w t ≫ (w ≫ sZ)) :=
    IsPullback.of_hasPullback sX (pullback.fst w t ≫ (w ≫ sZ))
  obtain ⟨_, _, hrW⟩ := lft_flat_relativeDimension_of_isPullback hsqW hrX
  have hsq' : IsPullback (pullback.snd w (pullback.snd sX (t ≫ sZ) ≫ t))
      (bivariantBaseChangeMap w t (pullback.snd sX (t ≫ sZ))) (pullback.snd sX (t ≫ sZ))
      (pullback.snd w t) :=
    isPullback_bivariantBaseChangeMap w t (pullback.snd sX (t ≫ sZ))
  have hfst : bivariantBaseChangeMap w t (pullback.snd sX (t ≫ sZ)) ≫ pullback.fst w t =
      pullback.fst w (pullback.snd sX (t ≫ sZ) ≫ t) := by simp [bivariantBaseChangeMap]
  obtain ⟨_, _, hr'⟩ := lft_flat_relativeDimension_of_isPullback hsq' hrT
  have hbaseT : pullback.snd sX (t ≫ sZ) ≫ (t ≫ sZ) = (pullback.snd sX (t ≫ sZ) ≫ t) ≫ sZ :=
    (Category.assoc _ t sZ).symm
  have hbase' : bivariantBaseChangeMap w t (pullback.snd sX (t ≫ sZ)) ≫
      (pullback.fst w t ≫ (w ≫ sZ)) =
      pullback.fst w (pullback.snd sX (t ≫ sZ) ≫ t) ≫ (w ≫ sZ) := by
    rw [← Category.assoc, hfst]
  have hdW : pullback.snd sX (pullback.fst w t ≫ (w ≫ sZ)) ≫ (pullback.fst w t ≫ (w ≫ sZ)) =
      pullback.fst sX (pullback.fst w t ≫ (w ≫ sZ)) ≫ sX := hsqW.w.symm
  have hfacT := hfd ((pullback.snd sX (t ≫ sZ) ≫ t) ≫ sZ) (t ≫ sZ) (pullback.snd sX (t ≫ sZ))
    hbaseT r hrT k
  have hfac' := hfd (pullback.fst w (pullback.snd sX (t ≫ sZ) ≫ t) ≫ (w ≫ sZ))
    (pullback.fst w t ≫ (w ≫ sZ)) (bivariantBaseChangeMap w t (pullback.snd sX (t ≫ sZ)))
    hbase' r hr' (k - q)
  have hfacW := hfd (pullback.fst sX (pullback.fst w t ≫ (w ≫ sZ)) ≫ sX)
    (pullback.fst w t ≫ (w ≫ sZ)) (pullback.snd sX (pullback.fst w t ≫ (w ≫ sZ))) hdW r hrW
    (k - q)
  have hnat := c'.flat_naturality t (pullback.snd sX (t ≫ sZ)) r hrT
    (bivariantBaseChangeMap w t (pullback.snd sX (t ≫ sZ))) hsq' hfst k hr' hfacT hfac' α
  have hcapT := hc (t ≫ sZ) ((pullback.snd sX (t ≫ sZ) ≫ t) ≫ sZ) hbaseT hrT k hfacT α
  have hcapW := hc (pullback.fst w t ≫ (w ≫ sZ))
    (pullback.fst sX (pullback.fst w t ≫ (w ≫ sZ)) ≫ sX) hdW hrW (k - q) hfacW (c'.cap t k α)
  have h02RG := flatPullbackChow_chowPushforwardOfIso C
    (pullback.fst w t ≫ (w ≫ sZ)) (pullback.fst sX (pullback.fst w t ≫ (w ≫ sZ)) ≫ sX)
    (pullback.fst w t ≫ (w ≫ sZ)) (pullback.fst w (pullback.snd sX (t ≫ sZ) ≫ t) ≫ (w ≫ sZ))
    (𝟙 (pullback w t)) (Category.id_comp _) (mixedCommuteHom sX sZ w t)
    (mixedCommuteHom_comp_structureMorphism sX sZ w t)
    (pullback.snd sX (pullback.fst w t ≫ (w ≫ sZ))) hdW
    (bivariantBaseChangeMap w t (pullback.snd sX (t ≫ sZ))) hbase'
    (by rw [Category.comp_id, ← mixedCommuteHom_comp_bivariantBaseChangeMap sX sZ w t]) r hrW hr'
    (k - q) hfacW hfac' (c'.cap t k α)
  simp only [chowPushforwardOfIso_id] at h02RG
  simp only [mixedIteratedCapBaseFirst_apply, mixedIteratedCapBaseLast_apply]
  refine eq_of_heq (HEq.trans ?_ (HEq.symm (chowGroupDegreeEquiv_heq C
    (pullback.fst w (pullback.snd sX (t ≫ sZ) ≫ t) ≫ (w ≫ sZ)) _ _)))
  refine HEq.trans (chowPushforwardOfIso_heq (mixedCommuteHom sX sZ w t)
    (mixedCommuteHom_comp_structureMorphism sX sZ w t)
    (mixedCommuteHom_comp_structureMorphism sX sZ w t) rfl rfl (by subst hp; ring) hcapW) ?_
  refine HEq.trans (heq_of_eq h02RG.symm) (HEq.trans hnat.symm ?_)
  exact BivariantClass.cap_heq c' (pullback.snd sX (t ≫ sZ) ≫ t) (by subst hp; ring)
    (HEq.symm ((chowGroupCongr_heq C _ _ _).trans hcapT))

end Flat

/-! ### Closure under the group operations -/

section Closure

variable (C : ChowSituation.{u}) (G : GysinSystem C) {X Y Z : Scheme.{u}} (sX : X ⟶ C.S)
  [LocallyOfFiniteType sX] (sZ : Z ⟶ C.S) [LocallyOfFiniteType sZ] (w : Y ⟶ Z)
  [LocallyOfFiniteType w] (p q : ℤ) (c' : BivariantClass C G (w ≫ sZ) sZ w rfl q)

/-- The zero class commutes with every bivariant class over the base. -/
theorem bivariantCommuteOverBase_zero :
    BivariantCommuteOverBase C G sX sZ w p q 0 c' := by
  intro T t _ k α
  simp only [mixedIteratedCapBaseFirst_apply, mixedIteratedCapBaseLast_apply,
    BivariantClass.zero_cap, map_zero]

variable {c₁ c₂ : BivariantClass C G sX (𝟙 C.S) sX (Category.comp_id sX) p}

/-- Commuting with a bivariant class over the base is preserved by sums. -/
theorem bivariantCommuteOverBase_add
    (h₁ : BivariantCommuteOverBase C G sX sZ w p q c₁ c')
    (h₂ : BivariantCommuteOverBase C G sX sZ w p q c₂ c') :
    BivariantCommuteOverBase C G sX sZ w p q (c₁ + c₂) c' := by
  intro T t _ k α
  have e₁ := h₁ t k α
  have e₂ := h₂ t k α
  simp only [mixedIteratedCapBaseFirst_apply, mixedIteratedCapBaseLast_apply,
    BivariantClass.add_cap, map_add] at e₁ e₂ ⊢
  rw [e₁, e₂]

/-- Commuting with a bivariant class over the base is preserved by negation. -/
theorem bivariantCommuteOverBase_neg
    (h₁ : BivariantCommuteOverBase C G sX sZ w p q c₁ c') :
    BivariantCommuteOverBase C G sX sZ w p q (-c₁) c' := by
  intro T t _ k α
  have e₁ := h₁ t k α
  simp only [mixedIteratedCapBaseFirst_apply, mixedIteratedCapBaseLast_apply,
    BivariantClass.neg_cap, map_neg] at e₁ ⊢
  rw [e₁]

end Closure

/-! ### Classes generated by the operations of chapter 42 -/

/-- The flat-pullback classes towards the base: the flat-pullback generators of the presentation
of a bivariant class towards a Dedekind base established in the proof of Stacks 0FC5. That
presentation also uses Gysin maps, whose bivariant classes (`Stacks.Chow.gysinBivariantClass`,
Stacks 0B79) are not among these generators. -/
def chowOperationGenerators (C : ChowSituation.{u}) (G : GysinSystem C) {X : Scheme.{u}}
    (sX : X ⟶ C.S) [LocallyOfFiniteType sX] (p : ℤ) :
    Set (BivariantClass C G sX (𝟙 C.S) sX (Category.comp_id sX) p) :=
  {c | ∃ (r : ℕ) (_ : Flat sX) (_ : p = -(r : ℤ))
    (_ : AlgebraicGeometry.RelativeDimension sX r), IsFlatPullbackOverBase C G sX r p c}

/-- The assertion that `c ∈ A^p(X ⟶ S)` is a `ℤ`-linear combination of flat-pullback classes
towards the base, that is, lies in the subgroup generated by `chowOperationGenerators`. -/
def IsChowOperationGenerated (C : ChowSituation.{u}) (G : GysinSystem C) {X : Scheme.{u}}
    (sX : X ⟶ C.S) [LocallyOfFiniteType sX] (p : ℤ)
    (c : BivariantClass C G sX (𝟙 C.S) sX (Category.comp_id sX) p) : Prop :=
  c ∈ AddSubgroup.closure (chowOperationGenerators C G sX p)

section Main

variable (C : ChowSituation.{u}) (G : GysinSystem C) {X Y Z : Scheme.{u}} (sX : X ⟶ C.S)
  [LocallyOfFiniteType sX] (sZ : Z ⟶ C.S) [LocallyOfFiniteType sZ] (w : Y ⟶ Z)
  [LocallyOfFiniteType w] (p q : ℤ)
  (c : BivariantClass C G sX (𝟙 C.S) sX (Category.comp_id sX) p)
  (c' : BivariantClass C G (w ≫ sZ) sZ w rfl q)

/-- **Stacks 0FC6.** Let `(S, δ)` be as in Stacks section 42.63, let `X` be a scheme locally of
finite type over `S` and let `c ∈ A^p(X ⟶ S)`. Let `Y ⟶ Z` be a morphism of schemes locally of
finite type over `S` and let `c' ∈ A^q(Y ⟶ Z)`. Then `c ∘ c' = c' ∘ c`: capping with `c` and
capping with `c'` may be performed in either order, the two results being read on the two
iterated fibre products `X ×_S (Y ×_Z T)` and `Y ×_Z (X ×_S T)` of a test scheme through the
canonical comparison isomorphism. -/
@[stacks 0FC6 "the commutation c ∘ c' = c' ∘ c, read on the cap operations of the two \
composites, for c an integral combination of flat pullbacks towards the base, the generators of \
the presentation in the proof of Stacks 0FC5 other than proper pushforwards and Gysin maps; \
given Stacks 02S1 for every flat morphism over the base"]
theorem bivariantCommuteOverBase_of_isChowOperationGenerated
    (hfd : ∀ {A B : Scheme.{u}} (sA : A ⟶ C.S) [LocallyOfFiniteType sA]
      (sB : B ⟶ C.S) [LocallyOfFiniteType sB] (v : A ⟶ B) [LocallyOfFiniteType v] [Flat v]
      (hv : v ≫ sB = sA) (r : ℕ) (hr : AlgebraicGeometry.RelativeDimension v r) (k : ℤ),
      FlatPullbackFactorsThroughRationalEquivalence C sA sB v hv r hr k)
    (hgen : IsChowOperationGenerated C G sX p c) :
    BivariantCommuteOverBase C G sX sZ w p q c c' := by
  refine AddSubgroup.closure_induction
    (p := fun x _ ↦ BivariantCommuteOverBase C G sX sZ w p q x c') ?_ ?_ ?_ ?_ hgen
  · rintro x ⟨r, hflat, hp, hrX, hx⟩
    exact bivariantCommuteOverBase_of_isFlatPullbackOverBase C G sX sZ w r p q x c' hfd hp hrX hx
  · exact bivariantCommuteOverBase_zero C G sX sZ w p q c'
  · exact fun x y _ _ hx hy ↦ bivariantCommuteOverBase_add C G sX sZ w p q c' hx hy
  · exact fun x _ hx ↦ bivariantCommuteOverBase_neg C G sX sZ w p q c' hx

end Main

end Stacks.Chow

