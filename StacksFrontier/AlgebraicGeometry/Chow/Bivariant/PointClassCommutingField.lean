module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Chow.Bivariant.ChowCohomologyOverFieldIso
public import StacksFrontier.AlgebraicGeometry.Chow.Bivariant.ChowRestriction
public import StacksFrontier.AlgebraicGeometry.Chow.Bivariant.FlatPullbackCommuting
public import StacksFrontier.AlgebraicGeometry.Chow.Bivariant.PointClassCommuting

/-!
# Over a field, bivariant classes towards the point commute with every bivariant class

Let `k` be a field, let `X` be a scheme locally of finite type over `k`, let `c ∈ A^p(X ⟶ Spec k)`,
let `f : Y ⟶ Z` be a morphism of schemes locally of finite type over `k` and let
`c' ∈ A^q(Y ⟶ Z)`. **Stacks 0FBX**: `c ∘ c' = c' ∘ c` in `A^{p+q}(X ×_k Y ⟶ Z)`.

Here, as in Stacks 0FA2, `c ∘ c'` is `res(c) ∘ c'` for the restriction
`res(c) ∈ A^p(X ×_k Y ⟶ Y)` of `c` along `Y ⟶ Spec k` (Stacks 0F9Z), and `c' ∘ c` is
`res(c') ∘ res(c)` for the restriction `res(c) ∈ A^p(X ×_k Z ⟶ Z)` of `c` along `Z ⟶ Spec k`
and the restriction `res(c') ∈ A^q(Y ×_Z (X ×_k Z) ⟶ X ×_k Z)` of `c'` along
`X ×_k Z ⟶ Z`; it is read on `X ×_k Y` through the canonical isomorphism
`Y ×_Z (X ×_k Z) ≅ X ×_k Y`.

The bivariant groups are those of Stacks 0B76, `Stacks.Chow.BivariantChowClass`, over the base
situation `Stacks.Chow.fieldChowSituation k`; nothing is assumed.

## Main results

* `Stacks.Chow.bivariantCommute_of_isBivariantFlatPullback` — a class that caps by flat pullback
  (Stacks 0B78) commutes with every bivariant class, by the flat law of Stacks 0B76.
* `Stacks.Chow.chowClassesGeneratedByBaseFlatPullbacks_field` — over a field, `CH_{-p}(X)` is
  generated by the classes `g_*[W] = g_*(W ⟶ Spec k)^*[Spec k]` for `g : W ⟶ X` proper and `W`
  flat of relative dimension `-p` over `k`.
* `Stacks.Chow.bivariantCommute_bivariantToBase_field` — **Stacks 0FBX** in the form of
  Stacks 0FA2: the base change of `c` to `Z` commutes with `c'`.
* `Stacks.Chow.BivariantChowClass.comp_comm_of_bivariantCommute` — Stacks 0FA2 for these classes:
  commuting of `res(c)` and `c'` gives the equality of the two composites.
* `Stacks.Chow.BivariantChowClass.comp_comm_of_field` — **Stacks 0FBX**: `c ∘ c' = c' ∘ c` in
  `A^{p+q}(X ×_k Y ⟶ Z)`.

## Main definitions

* `Stacks.Chow.BivariantChowClass.degreeCongr` — a class of degree `p` as one of degree `p'`, for
  `p = p'`.
* `Stacks.Chow.pointClassCompositeIso` — the canonical isomorphism `Y ×_Z (X ×_k Z) ≅ X ×_k Y`.

## Implementation notes

The proof is the source's. By Stacks 0FBW (`Stacks.Chow.bivariantToBaseEval_injective` and the
generation statement above) `c` is a `ℤ`-combination of classes `g_* ∘ f^*` with `g` proper and
`f^*` the class of Stacks 0B78 of a flat morphism `W ⟶ Spec k`. Commuting with `c'` is preserved by
`ℤ`-combinations and by proper pushforward (`Stacks.Chow.commutingWith`,
`Stacks.Chow.bivariantCommute_of_isBivariantProperPushforward`), and the base change of `f^*` to
`Z` caps by flat pullback, hence commutes with `c'` by the flat law of Stacks 0B76.

The flat-pullback classes are those of `Stacks.Chow.flatPullbackBivariantClassOfInvertible`, built
at the Gysin system of the first Chern class with nothing assumed. The steps of the argument are
therefore stated for any class satisfying `Stacks.Chow.IsBivariantFlatPullback`, which is all they
use.

## References

* [Stacks Project, Tag 0FBX](https://stacks.math.columbia.edu/tag/0FBX)
* [Stacks Project, Tag 0FBW](https://stacks.math.columbia.edu/tag/0FBW)
* [Stacks Project, Tag 0FA2](https://stacks.math.columbia.edu/tag/0FA2)
* [Stacks Project, Tag 0F9Z](https://stacks.math.columbia.edu/tag/0F9Z)
* [Stacks Project, Tag 0B78](https://stacks.math.columbia.edu/tag/0B78)
* [Stacks Project, Tag 0EPK](https://stacks.math.columbia.edu/tag/0EPK)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace Stacks.Chow

/-! ### Classes that cap by flat pullback -/

section FlatClass

variable {C : ChowSituation.{u}} {G : GysinSystem C} {X Y : Scheme.{u}} {sX : X ⟶ C.S}
  [LocallyOfFiniteType sX] {sY : Y ⟶ C.S} [LocallyOfFiniteType sY] {f : X ⟶ Y}
  [LocallyOfFiniteType f] [Flat f] {hf : f ≫ sY = sX} {r : ℕ}
  {hfr : AlgebraicGeometry.RelativeDimension f r} {hS1 : FlatPullbackDescends C}
  {c : BivariantClass C G sX sY f hf (-(r : ℤ))}

/-- A class that caps by flat pullback caps, on each test scheme, by flat pullback along the base
change of `f`, up to the transport of degrees. -/
theorem IsBivariantFlatPullback.cap_heq (hc : IsBivariantFlatPullback C G sX sY f hf r hfr hS1 c)
    {T : Scheme.{u}} (g : T ⟶ Y) [LocallyOfFiniteType g] (k : ℤ) (α : chowGroup C (g ≫ sY) k) :
    c.cap g k α ≍
      flatPullbackChow C (pullback.fst f g ≫ sX) (g ≫ sY) (pullback.snd f g)
        (pullbackSnd_comp_structureMorphism hf g) r (relativeDimension_pullbackSnd f hfr g) k
        (hS1 (pullback.fst f g ≫ sX) (g ≫ sY) (pullback.snd f g)
          (pullbackSnd_comp_structureMorphism hf g) r (relativeDimension_pullbackSnd f hfr g) k)
        α :=
  (heq_of_eq (hc g k α)).trans (flatPullbackBivariantCap_heq C sX sY f hf r hfr hS1 g k α)

end FlatClass

/-- The base change of a flat morphism of finite type and relative dimension `r` is again so. -/
private theorem lft_flat_relativeDimension_of_isPullback {P X' Y' Z' : Scheme.{u}}
    {fst : P ⟶ X'} {snd : P ⟶ Y'} {f : X' ⟶ Z'} {g : Y' ⟶ Z'} [LocallyOfFiniteType f] [Flat f]
    {r : ℕ} (h : IsPullback fst snd f g) (hr : AlgebraicGeometry.RelativeDimension f r) :
    ∃ (_ : LocallyOfFiniteType snd) (_ : Flat snd), AlgebraicGeometry.RelativeDimension snd r :=
  have := MorphismProperty.of_isPullback h (P := @LocallyOfFiniteType) inferInstance
  ⟨this, MorphismProperty.of_isPullback h (P := @Flat) inferInstance,
    AlgebraicGeometry.RelativeDimension.of_isPullback h hr⟩

/-! ### A class capping by flat pullback commutes with every class -/

section Smooth

variable (C : ChowSituation.{u}) (G : GysinSystem C) {X Z₁ Z₂ : Scheme.{u}} (sX : X ⟶ C.S)
  [LocallyOfFiniteType sX] (f₁ : Z₁ ⟶ X) [LocallyOfFiniteType f₁] [Flat f₁] (f₂ : Z₂ ⟶ X)
  [LocallyOfFiniteType f₂] (r : ℕ) (hfr : AlgebraicGeometry.RelativeDimension f₁ r)
  (hS1 : FlatPullbackDescends C) (p₂ : ℤ)
  (c₂ : BivariantClass C G (f₂ ≫ sX) sX f₂ rfl p₂)
  (c₁ : BivariantClass C G (f₁ ≫ sX) sX f₁ rfl (-(r : ℤ)))

/-- A bivariant class `c₁ ∈ A^{-r}(Z₁ ⟶ X)` which caps by flat pullback along the base changes of
the flat morphism `f₁` of relative dimension `r` (the class of Stacks 0B78) commutes, in the sense
of Stacks 0FA2, with every bivariant class `c₂ ∈ A^{p₂}(Z₂ ⟶ X)`. This is the flat law of
Stacks 0B76 (2) for `c₂`, read at the base change of `f₁` along the test scheme. -/
theorem bivariantCommute_of_isBivariantFlatPullback
    (hc₁ : IsBivariantFlatPullback C G (f₁ ≫ sX) sX f₁ rfl r hfr hS1 c₁) :
    BivariantCommute C G sX f₁ f₂ (-(r : ℤ)) p₂ c₁ c₂ := by
  intro T t _ k α
  -- the test morphism `Z₁ ×_X T ⟶ X` in the two shapes the two sides present it in
  have e : pullback.snd f₁ t ≫ t = pullback.fst f₁ t ≫ f₁ :=
    (pullback.condition (f := f₁) (g := t)).symm
  -- the base change of `f₁` along the test scheme, and the base change of that along `c₂`
  have hrQ : AlgebraicGeometry.RelativeDimension (pullback.snd f₁ t) r :=
    relativeDimension_pullbackSnd f₁ hfr t
  have sqh' : IsPullback (pullback.snd f₂ (pullback.snd f₁ t ≫ t))
      (bivariantBaseChangeMap f₂ t (pullback.snd f₁ t)) (pullback.snd f₁ t)
      (pullback.snd f₂ t) :=
    isPullback_bivariantBaseChangeMap f₂ t (pullback.snd f₁ t)
  obtain ⟨_, _, hr'⟩ := lft_flat_relativeDimension_of_isPullback sqh' hrQ
  have hfsth' : bivariantBaseChangeMap f₂ t (pullback.snd f₁ t) ≫ pullback.fst f₂ t =
      pullback.fst f₂ (pullback.snd f₁ t ≫ t) := by
    simp [bivariantBaseChangeMap]
  -- the two projections of the inverse of the comparison of the two test morphisms
  have hinv_fst : (pullback.congrHom (rfl : f₂ = f₂) e).inv ≫
      pullback.fst f₂ (pullback.snd f₁ t ≫ t) = pullback.fst f₂ (pullback.fst f₁ t ≫ f₁) := by
    simp
  have hinv_snd : (pullback.congrHom (rfl : f₂ = f₂) e).inv ≫
      pullback.snd f₂ (pullback.snd f₁ t ≫ t) = pullback.snd f₂ (pullback.fst f₁ t ≫ f₁) := by
    simp
  have hsnd : bivariantBaseChangeMap f₂ t (pullback.snd f₁ t) ≫ pullback.snd f₂ t =
      pullback.snd f₂ (pullback.snd f₁ t ≫ t) ≫ pullback.snd f₁ t := by
    simp [bivariantBaseChangeMap]
  -- the comparison isomorphism of the goal, factored through the third fibre product
  have hcomp : (commuteComparisonHom f₁ f₂ t ≫ (pullback.congrHom (rfl : f₂ = f₂) e).inv) ≫
      (pullback.congrHom (rfl : f₂ = f₂) e).hom = commuteComparisonHom f₁ f₂ t := by
    rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have hu₁ : (commuteComparisonHom f₁ f₂ t ≫ (pullback.congrHom (rfl : f₂ = f₂) e).inv) ≫
      (pullback.fst f₂ (pullback.snd f₁ t ≫ t) ≫ (f₂ ≫ sX)) =
      pullback.fst f₁ (pullback.fst f₂ t ≫ f₂) ≫ (f₁ ≫ sX) := by
    rw [Category.assoc, ← Category.assoc ((pullback.congrHom (rfl : f₂ = f₂) e).inv), hinv_fst]
    exact commuteComparisonHom_comp_structureMorphism C sX f₁ f₂ t
  have hsq : pullback.snd f₁ (pullback.fst f₂ t ≫ f₂) ≫ 𝟙 (pullback f₂ t) =
      (commuteComparisonHom f₁ f₂ t ≫ (pullback.congrHom (rfl : f₂ = f₂) e).inv) ≫
        bivariantBaseChangeMap f₂ t (pullback.snd f₁ t) := by
    refine pullback.hom_ext ?_ ?_
    · simp only [Category.assoc, Category.id_comp, hfsth', hinv_fst]
      exact (commuteComparisonHom_fst f₁ f₂ t).symm
    · simp only [Category.assoc, Category.id_comp, hsnd]
      rw [← Category.assoc (pullback.congrHom (rfl : f₂ = f₂) e).inv, hinv_snd]
      exact (commuteComparisonHom_snd_snd f₁ f₂ t).symm
  -- the structure morphisms the three flat pullbacks are taken over
  have hv : bivariantBaseChangeMap f₂ t (pullback.snd f₁ t) ≫
      ((pullback.fst f₂ t ≫ f₂) ≫ sX) =
      pullback.fst f₂ (pullback.snd f₁ t ≫ t) ≫ (f₂ ≫ sX) := by
    simp only [← Category.assoc]
    rw [hfsth']
  have hd : pullback.snd f₁ (pullback.fst f₂ t ≫ f₂) ≫ ((pullback.fst f₂ t ≫ f₂) ≫ sX) =
      pullback.fst f₁ (pullback.fst f₂ t ≫ f₂) ≫ (f₁ ≫ sX) :=
    pullbackSnd_comp_structureMorphism (rfl : f₁ ≫ sX = f₁ ≫ sX) (pullback.fst f₂ t ≫ f₂)
  have hdr : AlgebraicGeometry.RelativeDimension
      (pullback.snd f₁ (pullback.fst f₂ t ≫ f₂)) r :=
    relativeDimension_pullbackSnd f₁ hfr (pullback.fst f₂ t ≫ f₂)
  have hQ : pullback.fst f₁ t ≫ (f₁ ≫ sX) = (pullback.snd f₁ t ≫ t) ≫ sX := by
    rw [← Category.assoc, pullback.condition]
  have hvP : bivariantBaseChangeMap f₂ t (pullback.snd f₁ t) ≫
      (pullback.fst f₂ t ≫ (f₂ ≫ sX)) =
      pullback.fst f₂ (pullback.snd f₁ t ≫ t) ≫ (f₂ ≫ sX) := by
    rw [← Category.assoc, hfsth']
  have hpsQ : pullback.snd f₁ t ≫ (t ≫ sX) = (pullback.snd f₁ t ≫ t) ≫ sX :=
    (Category.assoc _ _ _).symm
  -- the comparison isomorphism of the two test morphisms, over the base
  have hcongrbase : (pullback.congrHom (rfl : f₂ = f₂) e).hom ≫
      (pullback.fst f₂ (pullback.fst f₁ t ≫ f₁) ≫ (f₂ ≫ sX)) =
      pullback.fst f₂ (pullback.snd f₁ t ≫ t) ≫ (f₂ ≫ sX) := by
    simp
  -- the instances of Stacks 02S1 that the three flat pullbacks are read against
  have hfacN : FlatPullbackFactorsThroughRationalEquivalence C
      ((pullback.snd f₁ t ≫ t) ≫ sX) (t ≫ sX) (pullback.snd f₁ t) hpsQ r hrQ k :=
    hS1 _ _ _ hpsQ r hrQ k
  have hfacL : FlatPullbackFactorsThroughRationalEquivalence C
      (pullback.fst f₁ t ≫ (f₁ ≫ sX)) (t ≫ sX) (pullback.snd f₁ t)
      (pullbackSnd_comp_structureMorphism (rfl : f₁ ≫ sX = f₁ ≫ sX) t) r hrQ k :=
    hS1 _ _ _ (pullbackSnd_comp_structureMorphism (rfl : f₁ ≫ sX = f₁ ≫ sX) t) r hrQ k
  have hfacP : FlatPullbackFactorsThroughRationalEquivalence C
      (pullback.fst f₂ (pullback.snd f₁ t ≫ t) ≫ (f₂ ≫ sX))
      (pullback.fst f₂ t ≫ (f₂ ≫ sX))
      (bivariantBaseChangeMap f₂ t (pullback.snd f₁ t)) hvP r hr' (k - p₂) :=
    hS1 _ _ _ hvP r hr' (k - p₂)
  have hfacv : FlatPullbackFactorsThroughRationalEquivalence C
      (pullback.fst f₂ (pullback.snd f₁ t ≫ t) ≫ (f₂ ≫ sX)) ((pullback.fst f₂ t ≫ f₂) ≫ sX)
      (bivariantBaseChangeMap f₂ t (pullback.snd f₁ t)) hv r hr' (k - p₂) :=
    hS1 _ _ _ hv r hr' (k - p₂)
  have hfacd : FlatPullbackFactorsThroughRationalEquivalence C
      (pullback.fst f₁ (pullback.fst f₂ t ≫ f₂) ≫ (f₁ ≫ sX)) ((pullback.fst f₂ t ≫ f₂) ≫ sX)
      (pullback.snd f₁ (pullback.fst f₂ t ≫ f₂)) hd r hdr (k - p₂) :=
    hS1 _ _ _ hd r hdr (k - p₂)
  -- degrees
  have hk₁ : k - -(r : ℤ) = k + (r : ℤ) := by ring
  have hdeg : (k - p₂) - -(r : ℤ) = (k - p₂) + (r : ℤ) := by ring
  have hdeg₂ : k - -(r : ℤ) - p₂ = k + (r : ℤ) - p₂ := by ring
  have hdeg₃ : k + (r : ℤ) - p₂ = (k - p₂) + (r : ℤ) := by ring
  -- the right-hand side, with the test morphism rewritten through the comparison isomorphism
  have hIV := chowPushforwardOfIso_congrHom_cap C G (f₂ ≫ sX) sX f₂ rfl p₂ c₂ e
    hcongrbase (k - -(r : ℤ))
    (c₁.cap t k α)
    hQ (Category.assoc (pullback.fst f₁ t) f₁ sX).symm
  -- the flat-pullback law of `c₂` at the base change of `f₁` along the test scheme
  have hIII : c₂.cap (pullback.snd f₁ t ≫ t) (k + (r : ℤ))
        (flatPullbackChow C ((pullback.snd f₁ t ≫ t) ≫ sX) (t ≫ sX) (pullback.snd f₁ t) hpsQ r
          hrQ k hfacN α) ≍
      flatPullbackChow C (pullback.fst f₂ (pullback.snd f₁ t ≫ t) ≫ (f₂ ≫ sX))
        (pullback.fst f₂ t ≫ (f₂ ≫ sX)) (bivariantBaseChangeMap f₂ t (pullback.snd f₁ t)) hvP r
        hr' (k - p₂) hfacP (c₂.cap t k α) :=
    c₂.flat_naturality t (pullback.snd f₁ t) r hrQ
      (bivariantBaseChangeMap f₂ t (pullback.snd f₁ t)) sqh' hfsth' k hr' hfacN hfacP α
  -- the isomorphism case of Stacks 02RG, moving that flat pullback onto `Z₁ ×_X (Z₂ ×_X T)`
  have hII := flatPullbackChow_chowPushforwardOfIso C ((pullback.fst f₂ t ≫ f₂) ≫ sX)
    (pullback.fst f₁ (pullback.fst f₂ t ≫ f₂) ≫ (f₁ ≫ sX)) ((pullback.fst f₂ t ≫ f₂) ≫ sX)
    (pullback.fst f₂ (pullback.snd f₁ t ≫ t) ≫ (f₂ ≫ sX)) (𝟙 (pullback f₂ t))
    (Category.id_comp _)
    (commuteComparisonHom f₁ f₂ t ≫ (pullback.congrHom (rfl : f₂ = f₂) e).inv) hu₁
    (pullback.snd f₁ (pullback.fst f₂ t ≫ f₂)) hd
    (bivariantBaseChangeMap f₂ t (pullback.snd f₁ t)) hv hsq r hdr hr' (k - p₂) hfacd hfacv
    (chowGroupCongr C (Category.assoc (pullback.fst f₂ t) f₂ sX).symm (k - p₂) (c₂.cap t k α))
  rw [chowPushforwardOfIso_id] at hII
  -- `c₁ ∩ α` is the flat pullback of `α`, read over the other shape of the test morphism
  have hcapt : chowGroupCongr C hQ (k - -(r : ℤ))
        (c₁.cap t k α) ≍
      flatPullbackChow C ((pullback.snd f₁ t ≫ t) ≫ sX) (t ≫ sX) (pullback.snd f₁ t) hpsQ r hrQ
        k hfacN α :=
    (chowGroupCongr_heq C hQ (k - -(r : ℤ)) _).trans
      ((hc₁.cap_heq t k α).trans
        (flatPullbackChow_heq_congr_base C hQ rfl rfl
          (pullbackSnd_comp_structureMorphism (rfl : f₁ ≫ sX = f₁ ≫ sX) t) hpsQ rfl hrQ hrQ rfl
          hfacL hfacN α α HEq.rfl))
  -- the flat pullback of `c₂ ∩ α`, read over the two shapes of the structure morphism of `P`
  have hbase : flatPullbackChow C (pullback.fst f₂ (pullback.snd f₁ t ≫ t) ≫ (f₂ ≫ sX))
        (pullback.fst f₂ t ≫ (f₂ ≫ sX)) (bivariantBaseChangeMap f₂ t (pullback.snd f₁ t)) hvP r
        hr' (k - p₂) hfacP (c₂.cap t k α) ≍
      flatPullbackChow C (pullback.fst f₂ (pullback.snd f₁ t ≫ t) ≫ (f₂ ≫ sX))
        ((pullback.fst f₂ t ≫ f₂) ≫ sX) (bivariantBaseChangeMap f₂ t (pullback.snd f₁ t)) hv r
        hr' (k - p₂) hfacv
        (chowGroupCongr C (Category.assoc (pullback.fst f₂ t) f₂ sX).symm (k - p₂)
          (c₂.cap t k α)) :=
    flatPullbackChow_heq_congr_base C rfl (Category.assoc (pullback.fst f₂ t) f₂ sX).symm rfl
      hvP hv rfl hr' hr' rfl hfacP hfacv _ _
      (chowGroupCongr_heq C (Category.assoc (pullback.fst f₂ t) f₂ sX).symm (k - p₂)
        (c₂.cap t k α)).symm
  -- the two pushforwards compose to the comparison isomorphism of the goal
  have hstep : ∀ x : chowGroup C (pullback.fst f₁ (pullback.fst f₂ t ≫ f₂) ≫ (f₁ ≫ sX))
        ((k - p₂) + (r : ℤ)),
      chowPushforwardOfIso C (pullback.fst f₂ (pullback.snd f₁ t ≫ t) ≫ (f₂ ≫ sX))
          (pullback.fst f₂ (pullback.fst f₁ t ≫ f₁) ≫ (f₂ ≫ sX))
          (pullback.congrHom (rfl : f₂ = f₂) e).hom hcongrbase ((k - p₂) + (r : ℤ))
          (chowPushforwardOfIso C (pullback.fst f₁ (pullback.fst f₂ t ≫ f₂) ≫ (f₁ ≫ sX))
            (pullback.fst f₂ (pullback.snd f₁ t ≫ t) ≫ (f₂ ≫ sX))
            (commuteComparisonHom f₁ f₂ t ≫ (pullback.congrHom (rfl : f₂ = f₂) e).inv) hu₁
            ((k - p₂) + (r : ℤ)) x) =
        chowPushforwardOfIso C (pullback.fst f₁ (pullback.fst f₂ t ≫ f₂) ≫ (f₁ ≫ sX))
          (pullback.fst f₂ (pullback.fst f₁ t ≫ f₁) ≫ (f₂ ≫ sX)) (commuteComparisonHom f₁ f₂ t)
          (commuteComparisonHom_comp_structureMorphism C sX f₁ f₂ t) ((k - p₂) + (r : ℤ)) x := by
    intro x
    rw [chowPushforwardOfIso_comp_apply]
    exact chowPushforwardOfIso_congr_apply C _ _ _ _ hcomp _ _ _ _
  rw [bivariantIteratedCap_apply, bivariantIteratedCap_apply]
  refine eq_of_heq ?_
  -- assemble: start from the right-hand side and work back to the left
  refine HEq.symm (HEq.trans (chowGroupDegreeEquiv_heq C _ _ _) ?_)
  refine HEq.trans (heq_of_eq hIV.symm) ?_
  refine HEq.trans (chowPushforwardOfIso_heq_congr C _ _ _ hcongrbase hdeg₂ _ _
    (c₂.cap_heq_congr (pullback.snd f₁ t ≫ t) hk₁ _ _ hcapt)) ?_
  refine HEq.trans (chowPushforwardOfIso_heq_congr C _ _ _ hcongrbase hdeg₃ _ _ hIII) ?_
  refine HEq.trans (chowPushforwardOfIso_heq_congr C _ _ _ hcongrbase rfl _ _ hbase) ?_
  refine HEq.trans (chowPushforwardOfIso_heq_congr C _ _ _ hcongrbase rfl _ _
    (heq_of_eq hII)) ?_
  refine HEq.trans (heq_of_eq (hstep _)) ?_
  exact chowPushforwardOfIso_heq_congr C _ _ _
    (commuteComparisonHom_comp_structureMorphism C sX f₁ f₂ t) hdeg.symm _ _
    (hc₁.cap_heq
      (pullback.fst f₂ t ≫ f₂) (k - p₂) _).symm

end Smooth

/-! ### The base change of `g_* ∘ f^*` to `Z` -/

section BaseChange

variable (C : ChowSituation.{u}) (G : GysinSystem C) {X Z : Scheme.{u}}
  (sX : X ⟶ C.S) [LocallyOfFiniteType sX] (sZ : Z ⟶ C.S) [LocallyOfFiniteType sZ]
  (hgys : G.IsNaturalUnderBaseChangeIso)

/-- The base change to `Z` of a class towards the point caps as the restriction along `Z ⟶ S`. -/
private theorem bivariantToBaseRestrictionHom_cap_heq {p : ℤ} (d : bivariantToBase C G sX p)
    {T : Scheme.{u}} (t : T ⟶ Z) [LocallyOfFiniteType t] (k : ℤ) (α : chowGroup C (t ≫ sZ) k) :
    (bivariantToBaseRestrictionHom C G sX sZ p hgys d).cap t k α ≍
      (bivariantRestriction C G sX (𝟙 C.S) sX (Category.comp_id sX) sZ p hgys d).cap t k
        (chowGroupCongr C (by rw [Category.comp_id]) k α) :=
  bivariantClassCongrBase_cap C G (pullback.snd sX sZ) (pullback.condition (f := sX) (g := sZ))
    (Category.comp_id sZ) p _ t k _ α (chowGroupCongr_heq C _ k α) (hv' := rfl)

/-- Let `g : W ⟶ X` be proper with `W` flat of relative dimension `r` over the base, let
`f₀ ∈ A^{-r}(W ⟶ S)` cap by flat pullback and let `d = g_* ∘ f₀ ∈ A^{-r}(X ⟶ S)` (Stacks 0EPK).
Then the base change of `d` to `Z` is the proper pushforward along the base change of `g` of any
class `e₀ ∈ A^{-r}(W ×_S Z ⟶ Z)` capping by flat pullback. -/
theorem isBivariantProperPushforward_bivariantToBaseRestriction_of_isBivariantFlatPullback
    {W : Scheme.{u}} (g : W ⟶ X) [IsProper g] [LocallyOfFiniteType (g ≫ sX)] [Flat (g ≫ sX)] (r : ℕ)
    (hr : AlgebraicGeometry.RelativeDimension (g ≫ sX) r) (hS1 : FlatPullbackDescends C)
    (hpp : ProperPushforwardDescends C)
    [hflatbc : Flat (bivariantPushforwardBaseChange g sX sZ ≫ pullback.snd sX sZ)]
    [hloftbc : LocallyOfFiniteType
      (bivariantPushforwardBaseChange g sX sZ ≫ pullback.snd sX sZ)]
    (hrbc : AlgebraicGeometry.RelativeDimension
      (bivariantPushforwardBaseChange g sX sZ ≫ pullback.snd sX sZ) r)
    (f₀ : BivariantClass C G (g ≫ sX) (𝟙 C.S) (g ≫ sX)
      (comp_comp_structureMorphism_eq (rfl : g ≫ sX = g ≫ sX) (Category.comp_id sX)) (-(r : ℤ)))
    (hf₀ : IsBivariantFlatPullback C G (g ≫ sX) (𝟙 C.S) (g ≫ sX)
      (comp_comp_structureMorphism_eq (rfl : g ≫ sX = g ≫ sX) (Category.comp_id sX)) r hr hS1 f₀)
    (e₀ : BivariantClass C G ((bivariantPushforwardBaseChange g sX sZ ≫ pullback.snd sX sZ) ≫ sZ)
      sZ (bivariantPushforwardBaseChange g sX sZ ≫ pullback.snd sX sZ) rfl (-(r : ℤ)))
    (he₀ : IsBivariantFlatPullback C G
      ((bivariantPushforwardBaseChange g sX sZ ≫ pullback.snd sX sZ) ≫ sZ) sZ
      (bivariantPushforwardBaseChange g sX sZ ≫ pullback.snd sX sZ) rfl r hrbc hS1 e₀)
    {d : bivariantToBase C G sX (-(r : ℤ))}
    (hd : IsBivariantProperPushforward C G (g ≫ sX) sX (𝟙 C.S) g sX rfl (Category.comp_id sX) hpp
      (-(r : ℤ))
      f₀
      d) :
    IsBivariantProperPushforward C G
      ((bivariantPushforwardBaseChange g sX sZ ≫ pullback.snd sX sZ) ≫ sZ)
      (pullback.snd sX sZ ≫ sZ) sZ (bivariantPushforwardBaseChange g sX sZ)
      (pullback.snd sX sZ)
      (Category.assoc (bivariantPushforwardBaseChange g sX sZ) (pullback.snd sX sZ) sZ).symm rfl
      hpp (-(r : ℤ))
      e₀
      (bivariantToBaseRestrictionHom C G sX sZ (-(r : ℤ)) hgys d) := by
  intro T t _ k α
  have hWbase : pullback.snd (g ≫ sX) (t ≫ sZ) ≫ (t ≫ sZ) =
      pullback.fst (g ≫ sX) (t ≫ sZ) ≫ (g ≫ sX) := pullback.condition.symm
  have hT : t ≫ sZ = t ≫ (sZ ≫ 𝟙 C.S) := by rw [Category.comp_id]
  have hbasecap : f₀.cap (t ≫ sZ) k
      (chowGroupCongr C (Category.assoc t sZ (𝟙 C.S)).symm k (chowGroupCongr C hT k α)) ≍
      flatPullbackChow C (pullback.fst (g ≫ sX) (t ≫ sZ) ≫ (g ≫ sX)) (t ≫ sZ)
        (pullback.snd (g ≫ sX) (t ≫ sZ)) hWbase r
        (relativeDimension_pullbackSnd (g ≫ sX) hr (t ≫ sZ)) k (hS1 _ _ _ hWbase r _ k) α :=
    (hf₀.cap_heq (t ≫ sZ) k _).trans
      (flatPullbackChow_heq_congr_base C rfl (Category.assoc t sZ (𝟙 C.S)).symm rfl _ hWbase rfl
        _ _ rfl _ _ _ _
        (((chowGroupCongr_heq C (Category.assoc t sZ (𝟙 C.S)).symm k _).trans
          (chowGroupCongr_heq C hT k α)))).symm
  rw [bivariantProperPushforwardCap_apply]
  refine eq_of_heq (HEq.trans (bivariantToBaseRestrictionHom_cap_heq C G sX sZ hgys d t k α) ?_)
  rw [bivariantRestriction_cap, bivariantRestrictionCap_apply, hd,
    bivariantProperPushforwardCap_apply]
  refine HEq.trans (chowPushforwardOfIso_heq_congr C (pullback.fst sX (t ≫ sZ) ≫ sX)
    (pullback.fst (pullback.snd sX sZ) t ≫ (pullback.fst sX sZ ≫ sX))
    (pullbackLeftPullbackSndIso sX sZ t).inv
    (pullbackLeftPullbackSndIso_inv_comp_structureMorphism sX sZ t)
    (by ring : k - -(r : ℤ) = k + (r : ℤ)) _ _
    (properChowPushforward_heq_congr C (pullback.fst (g ≫ sX) (t ≫ sZ) ≫ (g ≫ sX))
      (pullback.fst sX (t ≫ sZ) ≫ sX) (bivariantPushforwardBaseChange g sX (t ≫ sZ))
      (bivariantPushforwardBaseChange_comp_structure (rfl : g ≫ sX = g ≫ sX) sX (t ≫ sZ))
      (by ring : k - -(r : ℤ) = k + (r : ℤ)) (hpp _ _ _ _ _) (hpp _ _ _ _ _) _ _
      hbasecap)) ?_
  rw [properChowPushforward_pointClassBaseChangeIso_square C sX sZ g t hpp (k + (r : ℤ)),
    ← flatPullbackChow_pointClassBaseChangeIso C sX sZ g t r hr hrbc hS1 k α]
  exact properChowPushforward_heq_congr_base C
    (bivariantPushforwardBaseChange (bivariantPushforwardBaseChange g sX sZ)
      (pullback.snd sX sZ) t) rfl
    (congrArg (pullback.fst (pullback.snd sX sZ) t ≫ ·) (pullback.condition (f := sX) (g := sZ)))
    _ _ (by ring : k + (r : ℤ) = k - -(r : ℤ)) (hpp _ _ _ _ _) (hpp _ _ _ _ _) _ _
    (he₀.cap_heq t k α).symm

end BaseChange

/-! ### Over a field -/

section Field

variable (k : Type u) [Field k]

/-- **Stacks 02UC, 02R4 and 0FBW over a field.** Over a field, every Chow class of `X` in degree
`-p` lies in the subgroup generated by the classes `g_*((W ⟶ Spec k)^*[Spec k])` for `g : W ⟶ X`
proper with `W` flat of relative dimension `r = -p` over `k`. A cycle with non-negative
coefficients is `g_*[W]` for `W` a coproduct of integral closed subschemes
(`Stacks.Chow.exists_properPushforward_fundamentalCycle_eq`), `[W]` is the flat pullback of
`[Spec k]`, and every cycle is the difference of its positive and negative parts. -/
theorem chowClassesGeneratedByBaseFlatPullbacks_field :
    ChowClassesGeneratedByBaseFlatPullbacks (fieldChowSituation k)
      (flatPullbackDescends (fieldChowSituation k))
      (properPushforwardDescends (fieldChowSituation k)) := by
  intro X sX _ p α
  set H := AddSubgroup.closure
      {β : chowGroup (fieldChowSituation k) sX (-p) |
        ∃ (W : Scheme.{u}) (g : W ⟶ X) (hgp : IsProper g)
          (hgt : LocallyOfFiniteType (g ≫ sX)) (hgf : Flat (g ≫ sX)) (r : ℕ)
          (hr : AlgebraicGeometry.RelativeDimension (g ≫ sX) r), -(r : ℤ) = p ∧
          let := hgp
          let := hgt
          let := hgf
          β ≍ properChowPushforward (fieldChowSituation k) (g ≫ sX) sX g rfl (-(-(r : ℤ)))
            (properPushforwardDescends (fieldChowSituation k) _ _ g rfl _)
            (flatPullbackBaseClass (fieldChowSituation k) (g ≫ sX) r hr
              (flatPullbackDescends (fieldChowSituation k)))} with hH
  -- a cycle with non-negative coefficients is a generator
  have hpos : ∀ b : CycleGroup (fieldChowSituation k) sX (-p), (∀ x, 0 ≤ b.1 x) →
      QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) sX (-p)) b ∈ H := by
    intro b hb
    by_cases hp : 0 ≤ -p
    · obtain ⟨r, hr⟩ := Int.eq_ofNat_of_zero_le hp
      obtain rfl : p = -(r : ℤ) := by omega
      obtain ⟨W, g, hgp, hgt, hrel, hpush⟩ :=
        exists_properPushforward_fundamentalCycle_eq k sX (-(-(r : ℤ))) r (by ring) b hb
      have hgf : Flat (g ≫ sX) := inferInstance
      refine AddSubgroup.subset_closure ⟨W, g, hgp, hgt, hgf, r, hrel, rfl, heq_of_eq ?_⟩
      rw [flatPullbackBaseClass_eq_fundamentalChowClass, fundamentalChowClass,
        properChowPushforward_mk, hpush]
    · have hb0 : b = 0 := by
        refine Subtype.ext (Function.locallyFinsuppWithin.ext fun x ↦ ?_)
        by_contra hx
        have h1 :=
          (mem_cyclesOfDimension_iff_forall_point (fieldChowSituation k) sX (-p) b.1).1 b.2 x hx
        have h2 := relativeDimension_fieldChowSituation_nonneg k sX x
        exact hp (h1 ▸ h2)
      rw [hb0, map_zero]
      exact zero_mem _
  induction α using QuotientAddGroup.induction_on with
  | H a =>
    have hmem : ∀ c : AlgebraicCycle X ℤ, c ∈ cyclesOfDimension (fieldChowSituation k) sX (-p) →
        ∀ c' : AlgebraicCycle X ℤ, (∀ x, c' x ≠ 0 → c x ≠ 0) →
          c' ∈ cyclesOfDimension (fieldChowSituation k) sX (-p) := fun c hc c' hc' ↦
      (mem_cyclesOfDimension_iff_forall_point (fieldChowSituation k) sX (-p) c').2 fun x hx ↦
        (mem_cyclesOfDimension_iff_forall_point (fieldChowSituation k) sX (-p) c).1 hc x (hc' x hx)
    let P : CycleGroup (fieldChowSituation k) sX (-p) := ⟨a.1⁺, hmem a.1 a.2 _ fun x hx h ↦ hx (by
      rw [Function.locallyFinsuppWithin.posPart_apply, h, posPart_zero])⟩
    let N : CycleGroup (fieldChowSituation k) sX (-p) := ⟨a.1⁻, hmem a.1 a.2 _ fun x hx h ↦ hx (by
      rw [Function.locallyFinsuppWithin.negPart_apply, h, negPart_zero])⟩
    have ha : a = P - N := by
      refine Subtype.ext (Function.locallyFinsuppWithin.ext fun x ↦ ?_)
      change a.1 x = (a.1 x)⁺ - (a.1 x)⁻
      exact (posPart_sub_negPart (a.1 x)).symm
    have hmk :
        QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) sX (-p)) a ∈ H := by
      rw [ha, map_sub]
      exact sub_mem (hpos P fun x ↦ posPart_nonneg (a.1 x)) (hpos N fun x ↦ negPart_nonneg (a.1 x))
    exact hmk

end Field

/-! ### Stacks 0FBX in the form of Stacks 0FA2 -/

section Commute

variable (C : ChowSituation.{u}) {X Y Z : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
  (sZ : Z ⟶ C.S) [LocallyOfFiniteType sZ] (f : Y ⟶ Z) [LocallyOfFiniteType f] (p q : ℤ)

local notation "𝔾" => gysinSystemOfInvertible C

/-- Over a base where `CH_*` is generated by proper pushforwards of flat pullbacks of the
fundamental class of the base and where the canonical map of Stacks 0FBW is injective, the base
change `res(c) ∈ A^p(X ×_S Z ⟶ Z)` of a class `c ∈ A^p(X ⟶ S)` commutes with every class
`c' ∈ A^q(Y ⟶ Z)`. Over a field both inputs are theorems, see
`Stacks.Chow.bivariantCommute_bivariantToBase_field`. -/
theorem bivariantCommute_bivariantToBase_ofInvertible [Subsingleton C.S] [IsIntegral C.S]
    (hgen : ChowClassesGeneratedByBaseFlatPullbacks C (flatPullbackDescends C)
      (properPushforwardDescends C))
    (hfund : IntegralFundamentalClassIsFlatPullback C (flatPullbackDescends C))
    (c : bivariantToBase C 𝔾 sX p) (c' : BivariantClass C 𝔾 (f ≫ sZ) sZ f rfl q) :
    BivariantCommute C 𝔾 sZ (pullback.snd sX sZ) f p q
      (bivariantToBaseRestrictionHom C 𝔾 sX sZ p
        (gysinSystemOfInvertible_isNaturalUnderBaseChangeIso C) c) c' := by
  have hgys : (𝔾).IsNaturalUnderBaseChangeIso :=
    gysinSystemOfInvertible_isNaturalUnderBaseChangeIso C
  have hS1 : FlatPullbackDescends C := flatPullbackDescends C
  have hpp : ProperPushforwardDescends C := properPushforwardDescends C
  have hle : AddSubgroup.closure
        {β : chowGroup C sX (-p) |
          ∃ (W : Scheme.{u}) (g : W ⟶ X) (hgp : IsProper g)
            (hgt : LocallyOfFiniteType (g ≫ sX)) (hgf : Flat (g ≫ sX)) (r : ℕ)
            (hr : AlgebraicGeometry.RelativeDimension (g ≫ sX) r), -(r : ℤ) = p ∧
            let := hgp
            let := hgt
            let := hgf
            β ≍ properChowPushforward C (g ≫ sX) sX g rfl (-(-(r : ℤ)))
              (properPushforwardDescends C _ _ g rfl _)
              (flatPullbackBaseClass C (g ≫ sX) r hr (flatPullbackDescends C))} ≤
        AddSubgroup.map (bivariantToBaseEval C 𝔾 sX p)
          (((commutingWith C 𝔾 sZ (pullback.snd sX sZ) f p q c').comap
            (bivariantToBaseRestrictionHom C 𝔾 sX sZ p
              (gysinSystemOfInvertible_isNaturalUnderBaseChangeIso C)))) := by
    rw [AddSubgroup.closure_le]
    rintro β ⟨W, g, hgp, hgt, hgf, r, hr, hrp, hβ⟩
    let _ := hgp
    let _ := hgt
    let _ := hgf
    subst hrp
    let f₀ := flatPullbackBivariantClassOfInvertible C (g ≫ sX) (𝟙 C.S) (g ≫ sX)
      (comp_comp_structureMorphism_eq (rfl : g ≫ sX = g ≫ sX) (Category.comp_id sX)) r hr
    let d := bivariantProperPushforwardOfNaturality C 𝔾 (g ≫ sX) sX (𝟙 C.S) g sX rfl
      (Category.comp_id sX) hpp (-(r : ℤ))
      (gysinSystemOfInvertible_isNaturalUnderProperPushforward C)
      (gysinSystemOfInvertible_isNaturalUnderPullbackCompPushforward C) f₀
    have hdd : IsBivariantProperPushforward C 𝔾 (g ≫ sX) sX (𝟙 C.S) g sX rfl
        (Category.comp_id sX) hpp (-(r : ℤ)) f₀ d :=
      isBivariantProperPushforward_bivariantProperPushforwardOfNaturality C 𝔾 (g ≫ sX) sX (𝟙 C.S) g
        sX rfl (Category.comp_id sX) hpp (-(r : ℤ))
        (gysinSystemOfInvertible_isNaturalUnderProperPushforward C)
        (gysinSystemOfInvertible_isNaturalUnderPullbackCompPushforward C) f₀
    have hsq : IsPullback (pullback.fst (g ≫ sX) sZ)
        (bivariantPushforwardBaseChange g sX sZ ≫ pullback.snd sX sZ) (g ≫ sX) sZ := by
      rw [bivariantPushforwardBaseChange_snd]
      exact IsPullback.of_hasPullback (g ≫ sX) sZ
    obtain ⟨hloftbc, hflatbc, hrbc⟩ := lft_flat_relativeDimension_of_isPullback hsq hr
    let e₀ := flatPullbackBivariantClassOfInvertible C
      ((bivariantPushforwardBaseChange g sX sZ ≫ pullback.snd sX sZ) ≫ sZ) sZ
      (bivariantPushforwardBaseChange g sX sZ ≫ pullback.snd sX sZ) rfl r hrbc
    refine ⟨d, ?_, ?_⟩
    · exact bivariantCommute_of_isBivariantProperPushforward C 𝔾 sZ (pullback.snd sX sZ)
        (bivariantPushforwardBaseChange g sX sZ) f hpp (-(r : ℤ)) q e₀ c' _
        (isBivariantProperPushforward_bivariantToBaseRestriction_of_isBivariantFlatPullback C 𝔾
          sX sZ hgys g r hr hS1 hpp hrbc f₀ (fun _ _ _ _ ↦ rfl) e₀ (fun _ _ _ _ ↦ rfl) hdd)
        (bivariantCommute_of_isBivariantFlatPullback C 𝔾 sZ
          (bivariantPushforwardBaseChange g sX sZ ≫ pullback.snd sX sZ) f r hrbc hS1 q c' e₀
          (fun _ _ _ _ ↦ rfl))
    · rw [bivariantToBaseEval_bivariantProperPushforward]
      exact (eq_of_heq hβ).symm
  obtain ⟨c₀, hc₀, hc₀eval⟩ := hle (hgen sX p (bivariantToBaseEval C 𝔾 sX p c))
  obtain rfl : c₀ = c := bivariantToBaseEval_injective C 𝔾 sX p hS1 hfund hc₀eval
  intro T t _ n α
  exact hc₀ t n α

end Commute

section FieldCommute

variable (k : Type u) [Field k] {X Y Z : Scheme.{u}} (sX : X ⟶ (fieldChowSituation k).S)
  [LocallyOfFiniteType sX] (sZ : Z ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType sZ]
  (f : Y ⟶ Z) [LocallyOfFiniteType f] (p q : ℤ)

/-- **Stacks 0FBX, in the form of Stacks 0FA2.** Over a field `k`, let `c ∈ A^p(X ⟶ Spec k)` and
let `c' ∈ A^q(Y ⟶ Z)` for a morphism `f : Y ⟶ Z` of schemes locally of finite type over `k`. Then
the base change `res(c) ∈ A^p(X ×_k Z ⟶ Z)` of `c` and `c'` commute.

By Stacks 0FBW `c` is a `ℤ`-combination of classes `g_* ∘ f^*`; commuting with `c'` is preserved
by `ℤ`-combinations; the base change of `g_* ∘ f^*` to `Z` is a proper pushforward of a class
capping by flat pullback; such a class commutes with `c'` by the flat law of Stacks 0B76, and
proper pushforward preserves commuting. -/
theorem bivariantCommute_bivariantToBase_field
    (c : bivariantToBase (fieldChowSituation k) (gysinSystemOfInvertible (fieldChowSituation k))
      sX p)
    (c' : BivariantClass (fieldChowSituation k) (gysinSystemOfInvertible (fieldChowSituation k))
      (f ≫ sZ) sZ f rfl q) :
    BivariantCommute (fieldChowSituation k) (gysinSystemOfInvertible (fieldChowSituation k)) sZ
      (pullback.snd sX sZ) f p q
      (bivariantToBaseRestrictionHom (fieldChowSituation k)
        (gysinSystemOfInvertible (fieldChowSituation k)) sX sZ p
        (gysinSystemOfInvertible_isNaturalUnderBaseChangeIso (fieldChowSituation k)) c) c' :=
  bivariantCommute_bivariantToBase_ofInvertible (fieldChowSituation k) sX sZ f p q
    (chowClassesGeneratedByBaseFlatPullbacks_field k)
    (integralFundamentalClassIsFlatPullback_field k) c c'

end FieldCommute

/-! ### Stacks 0FBX as an equality of composites -/

section Composite

/-- Pushforward along isomorphisms, up to heterogeneous equality: if `β` is `u_* α`, then `v_* β`
is `(u ≫ v)_* α`, for any presentation of the structure morphisms and degrees. -/
theorem chowPushforwardOfIso_heq_comp (C : ChowSituation.{u}) {A B D : Scheme.{u}}
    {sA : A ⟶ C.S} [LocallyOfFiniteType sA] {sB sB' : B ⟶ C.S} [LocallyOfFiniteType sB]
    [LocallyOfFiniteType sB'] {sD : D ⟶ C.S} [LocallyOfFiniteType sD] (u : A ⟶ B) [IsIso u]
    (v : B ⟶ D) [IsIso v] (hu : u ≫ sB = sA) (hv : v ≫ sD = sB') (hB : sB = sB') {k k' : ℤ}
    (hk : k = k') (α : chowGroup C sA k) (β : chowGroup C sB' k')
    (hβ : β ≍ chowPushforwardOfIso C sA sB u hu k α) :
    chowPushforwardOfIso C sB' sD v hv k' β ≍
      chowPushforwardOfIso C sA sD (u ≫ v) (by subst hB; rw [Category.assoc, hv, hu]) k α := by
  subst hB hk
  obtain rfl := eq_of_heq hβ
  rw [chowPushforwardOfIso_comp_apply]

/-- Pushforward along an isomorphism depends on the isomorphism, the structure morphisms, the
degree and the argument only up to equality and heterogeneous equality. -/
theorem chowPushforwardOfIso_heq_congr_base (C : ChowSituation.{u}) {A B : Scheme.{u}}
    {sA sA' : A ⟶ C.S} [LocallyOfFiniteType sA] [LocallyOfFiniteType sA'] {sB sB' : B ⟶ C.S}
    [LocallyOfFiniteType sB] [LocallyOfFiniteType sB'] (u u' : A ⟶ B) [IsIso u] [IsIso u']
    (huu' : u = u') (hu : u ≫ sB = sA) (hu' : u' ≫ sB' = sA') (hA : sA = sA') (hB : sB = sB')
    {k k' : ℤ} (hk : k = k') (α : chowGroup C sA k) (α' : chowGroup C sA' k') (hα : α ≍ α') :
    chowPushforwardOfIso C sA sB u hu k α ≍ chowPushforwardOfIso C sA' sB' u' hu' k' α' := by
  subst huu' hA hB hk
  obtain rfl := eq_of_heq hα
  rfl

namespace BivariantChowClass

variable {C : ChowSituation.{u}} {X Y : Scheme.{u}} {sX : X ⟶ C.S} [LocallyOfFiniteType sX]
  {sY : Y ⟶ C.S} [LocallyOfFiniteType sY] {f : X ⟶ Y} {hf : f ≫ sY = sX}

/-- A bivariant class of degree `p` is one of degree `p'` whenever `p = p'`. -/
def degreeCongr {p p' : ℤ} (h : p = p') (c : BivariantChowClass C sX sY f hf p) :
    BivariantChowClass C sX sY f hf p' :=
  h ▸ c

/-- The transport of a class along an equality of degrees caps the way the class does. -/
theorem degreeCongr_cap {p p' : ℤ} (h : p = p') (c : BivariantChowClass C sX sY f hf p)
    {T : Scheme.{u}} (g : T ⟶ Y) [LocallyOfFiniteType g] (k : ℤ) (α : chowGroup C (g ≫ sY) k) :
    (c.degreeCongr h).cap g k α ≍ c.cap g k α := by
  subst h
  rfl

end BivariantChowClass

variable (C : ChowSituation.{u}) {X Y Z : Scheme.{u}} (sX : X ⟶ C.S) (sZ : Z ⟶ C.S) (f : Y ⟶ Z)

/-- The canonical isomorphism `Y ×_Z (X ×_S Z) ≅ X ×_S Y` over `Z`, for `Y` over `S` through
`sY = f ≫ sZ`. -/
def pointClassCompositeIso {sY : Y ⟶ C.S} (hf : f ≫ sZ = sY) :
    pullback f (pullback.snd sX sZ) ≅ pullback sX sY :=
  pullbackSymmetry f (pullback.snd sX sZ) ≪≫ pullbackLeftPullbackSndIso sX sZ f ≪≫
    pullback.congrHom rfl hf

/-- The canonical isomorphism `Y ×_Z (X ×_S Z) ≅ X ×_S Y` followed by the projection to `X` is
the projection to `X ×_S Z` followed by the projection to `X`. -/
@[reassoc (attr := simp)]
theorem pointClassCompositeIso_hom_fst {sY : Y ⟶ C.S} (hf : f ≫ sZ = sY) :
    (pointClassCompositeIso C sX sZ f hf).hom ≫ pullback.fst sX sY =
      pullback.snd f (pullback.snd sX sZ) ≫ pullback.fst sX sZ := by
  simp [pointClassCompositeIso]

/-- The canonical isomorphism `Y ×_Z (X ×_S Z) ≅ X ×_S Y` followed by the projection to `Y` is
the projection to `Y`. -/
@[reassoc (attr := simp)]
theorem pointClassCompositeIso_hom_snd {sY : Y ⟶ C.S} (hf : f ≫ sZ = sY) :
    (pointClassCompositeIso C sX sZ f hf).hom ≫ pullback.snd sX sY =
      pullback.fst f (pullback.snd sX sZ) := by
  simp [pointClassCompositeIso]

/-- The canonical isomorphism `Y ×_Z (X ×_S Z) ≅ X ×_S Y` is a morphism over `Z`. -/
theorem pointClassCompositeIso_hom_comp {sY : Y ⟶ C.S} (hf : f ≫ sZ = sY) :
    (pointClassCompositeIso C sX sZ f hf).hom ≫ (pullback.snd sX sY ≫ f) =
      pullback.snd f (pullback.snd sX sZ) ≫ pullback.snd sX sZ := by
  rw [pointClassCompositeIso_hom_snd_assoc, pullback.condition]

variable [LocallyOfFiniteType sX] [LocallyOfFiniteType sZ] [LocallyOfFiniteType f] (p q : ℤ)

local notation "𝔾" => gysinSystemOfInvertible C

/-- The composite `c ∘ c' = res(c) ∘ c'` and the composite `c' ∘ c = res(c') ∘ res(c)` agree,
given that the base change of `c` to `Z` commutes with `c'` in the sense of Stacks 0FA2. -/
theorem BivariantChowClass.comp_comm_of_bivariantCommute
    (c : BivariantChowClass C sX (𝟙 C.S) sX (Category.comp_id sX) p)
    (c' : BivariantChowClass C (f ≫ sZ) sZ f rfl q)
    (hcomm : BivariantCommute C 𝔾 sZ (pullback.snd sX sZ) f p q
      (bivariantToBaseRestrictionHom C 𝔾 sX sZ p
        (gysinSystemOfInvertible_isNaturalUnderBaseChangeIso C)
        (BivariantChowClass.equivBivariantClass c))
      (BivariantChowClass.equivBivariantClass c')) :
    (c.restrict (f ≫ sZ) (Category.comp_id _)).comp c' =
      (((c'.restrict (pullback.snd sX sZ)
          (BivariantChowClass.restrict_structure_eq (Category.comp_id sX) sZ
            (Category.comp_id sZ))).comp
        (c.restrict sZ (Category.comp_id sZ))).degreeCongr (add_comm q p)).transport
        (comp_comp_structureMorphism_eq
          (BivariantChowClass.restrict_structure_eq (Category.comp_id sX) (f ≫ sZ)
            (Category.comp_id _)) rfl)
        (pointClassCompositeIso C sX sZ f rfl) (pointClassCompositeIso_hom_comp C sX sZ f rfl) := by
  have hgys : (𝔾).IsNaturalUnderBaseChangeIso :=
    gysinSystemOfInvertible_isNaturalUnderBaseChangeIso C
  -- the base change of `c` to `Z` caps the way the restriction of `c` along `Z ⟶ S` does
  have hc₁ : ∀ {T' : Scheme.{u}} (g : T' ⟶ Z) [LocallyOfFiniteType g] (m : ℤ)
      (x : chowGroup C (g ≫ sZ) m),
      (bivariantToBaseRestrictionHom C 𝔾 sX sZ p hgys
        (BivariantChowClass.equivBivariantClass c)).cap g m x ≍
        (c.restrict sZ (Category.comp_id sZ)).cap g m x := by
    intro T' g _ m x
    refine HEq.trans (bivariantToBaseRestrictionHom_cap_heq C 𝔾 sX sZ hgys
      (BivariantChowClass.equivBivariantClass c) g m x) ?_
    rw [bivariantRestriction_cap, bivariantRestrictionCap_apply, BivariantChowClass.restrict_cap]
    refine heq_of_eq ?_
    congr 2
  ext T t _ n α
  have H := hcomm t n α
  rw [bivariantIteratedCap_apply, bivariantIteratedCap_apply] at H
  rw [BivariantChowClass.comp_cap, BivariantChowClass.restrict_cap,
    BivariantChowClass.transport_cap]
  have e : (pullback.fst f t ≫ f) ≫ sZ = pullback.fst f t ≫ f ≫ sZ := Category.assoc _ _ _
  have h₁ : pullback.fst f t ≫ f ≫ sZ = ((pullback.fst f t ≫ f) ≫ sZ) ≫ 𝟙 C.S := by simp
  rw [BivariantChowClass.cap_congr_test c e (by simp) (n - q) (c'.cap t n α) h₁ (by simp),
    chowPushforwardOfIso_comp_apply, chowPushforwardOfIso_comp_apply]
  set Y₁ := c.cap ((pullback.fst f t ≫ f) ≫ sZ) (n - q) (chowGroupCongr C h₁ (n - q) (c'.cap t n α))
  -- the first iterated cap, read through the restriction of `c` along `Z ⟶ S`
  have hE1 := (hc₁ (pullback.fst f t ≫ f) (n - q)
    (chowGroupCongr C (Category.assoc (pullback.fst f t) f sZ).symm (n - q) (c'.cap t n α))).trans
    (heq_of_eq (BivariantChowClass.restrict_cap sZ (Category.comp_id sZ) c (pullback.fst f t ≫ f)
      (n - q) _))
  have hE1' : (bivariantToBaseRestrictionHom C 𝔾 sX sZ p hgys
        (BivariantChowClass.equivBivariantClass c)).cap (pullback.fst f t ≫ f) (n - q)
        (chowGroupCongr C (Category.assoc (pullback.fst f t) f sZ).symm (n - q) (c'.cap t n α)) ≍
      chowPushforwardOfIso C (pullback.fst sX ((pullback.fst f t ≫ f) ≫ sZ) ≫ sX)
        (pullback.fst (pullback.snd sX sZ) (pullback.fst f t ≫ f) ≫ pullback.fst sX sZ ≫ sX)
        (pullbackLeftPullbackSndIso sX sZ (pullback.fst f t ≫ f)).inv (by simp) (n - q - p)
        Y₁ := by
    refine hE1.trans (heq_of_eq ?_)
    congr 2
  -- the second iterated cap
  have hE2 := (chowGroupDegreeEquiv_heq C _ _ _).symm.trans ((heq_of_eq H.symm).trans
    (chowPushforwardOfIso_heq_comp C _ (commuteComparisonHom (pullback.snd sX sZ) f t) (by simp)
      (commuteComparisonHom_comp_structureMorphism C sZ (pullback.snd sX sZ) f t)
      (by rw [pullback.condition (f := sX) (g := sZ)]) rfl Y₁ _ hE1'))
  have h2 : c'.cap (pullback.fst (pullback.snd sX sZ) t ≫ pullback.snd sX sZ) (n - p)
      (chowGroupCongr C (by rw [Category.assoc, pullback.condition (f := sX) (g := sZ)]) (n - p)
        ((c.restrict sZ (Category.comp_id sZ)).cap t n α)) ≍ _ :=
    HEq.trans (heq_of_eq (congrArg (c'.cap _ (n - p)) (eq_of_heq ((chowGroupCongr_heq C _ _ _).trans
      ((hc₁ t n α).symm.trans (chowGroupCongr_heq C _ _ _).symm))))) hE2
  have h3 := (heq_of_eq (BivariantChowClass.restrict_cap (pullback.snd sX sZ)
      (BivariantChowClass.restrict_structure_eq (Category.comp_id sX) sZ (Category.comp_id sZ)) c'
      (pullback.fst (pullback.snd sX sZ) t) (n - p)
      ((c.restrict sZ (Category.comp_id sZ)).cap t n α))).trans
    (chowPushforwardOfIso_heq_comp C _ _ _ (by simp) rfl (by ring) Y₁ _ h2)
  have h4 := (heq_of_eq (BivariantChowClass.comp_cap (c'.restrict (pullback.snd sX sZ)
      (BivariantChowClass.restrict_structure_eq (Category.comp_id sX) sZ (Category.comp_id sZ)))
      (c.restrict sZ (Category.comp_id sZ)) t n α)).trans
    ((chowGroupDegreeEquiv_heq C _ _ _).trans
      (chowPushforwardOfIso_heq_comp C _ _ _ _ rfl (by ring) Y₁ _ h3))
  have h5 := (BivariantChowClass.degreeCongr_cap (add_comm q p) ((c'.restrict (pullback.snd sX sZ)
      (BivariantChowClass.restrict_structure_eq (Category.comp_id sX) sZ
        (Category.comp_id sZ))).comp (c.restrict sZ (Category.comp_id sZ))) t n α).trans h4
  refine eq_of_heq ((chowGroupDegreeEquiv_heq C _ _ _).trans
    (HEq.trans (heq_of_eq (chowPushforwardOfIso_congr_apply C _ _ _ _ ?_ _ _ _ _))
      (HEq.symm (chowPushforwardOfIso_heq_comp C _ _ _ _ rfl (by ring) Y₁ _ h5))))
  refine pullback.hom_ext (pullback.hom_ext ?_ ?_) ?_ <;> simp

end Composite

section FieldComposite

variable (k : Type u) [Field k] {X Y Z : Scheme.{u}} (sX : X ⟶ (fieldChowSituation k).S)
  [LocallyOfFiniteType sX] (sY : Y ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType sY]
  (sZ : Z ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType sZ] (f : Y ⟶ Z) (hf : f ≫ sZ = sY)
  (p q : ℤ)

/-- **Stacks 0FBX.** Let `k` be a field and let `X` be a scheme locally of finite type over `k`.
Let `c ∈ A^p(X ⟶ Spec k)`. Let `f : Y ⟶ Z` be a morphism of schemes locally of finite type over
`k` and let `c' ∈ A^q(Y ⟶ Z)`. Then `c ∘ c' = c' ∘ c` in `A^{p+q}(X ×_k Y ⟶ Z)`.

Here `c ∘ c' = res(c) ∘ c'` with `res(c) ∈ A^p(X ×_k Y ⟶ Y)` the restriction of `c` along
`Y ⟶ Spec k`, and `c' ∘ c = res(c') ∘ res(c)` with `res(c) ∈ A^p(X ×_k Z ⟶ Z)` the restriction of
`c` along `Z ⟶ Spec k` and `res(c') ∈ A^q(Y ×_Z (X ×_k Z) ⟶ X ×_k Z)` the restriction of `c'`
along `X ×_k Z ⟶ Z` (Stacks 0F9Z, 0FA2). The second composite lives on `Y ×_Z (X ×_k Z)` and in
degree `q + p`; it is read on `X ×_k Y` through the canonical isomorphism and in degree `p + q`. -/
@[stacks 0FBX "c ∘ c' = c' ∘ c in A^{p+q}(X ×_k Y → Z) for c ∈ A^p(X → Spec k) and \
c' ∈ A^q(Y → Z), the composites read as in Stacks 0FA2"]
theorem BivariantChowClass.comp_comm_of_field
    (c : BivariantChowClass (fieldChowSituation k) sX (𝟙 (fieldChowSituation k).S) sX
      (Category.comp_id sX) p)
    (c' : BivariantChowClass (fieldChowSituation k) sY sZ f hf q) :
    (c.restrict sY (Category.comp_id sY)).comp c' =
      (((c'.restrict (pullback.snd sX sZ)
          (BivariantChowClass.restrict_structure_eq (Category.comp_id sX) sZ
            (Category.comp_id sZ))).comp
        (c.restrict sZ (Category.comp_id sZ))).degreeCongr (add_comm q p)).transport
        (comp_comp_structureMorphism_eq
          (BivariantChowClass.restrict_structure_eq (Category.comp_id sX) sY
            (Category.comp_id sY)) hf)
        (pointClassCompositeIso (fieldChowSituation k) sX sZ f hf)
        (pointClassCompositeIso_hom_comp (fieldChowSituation k) sX sZ f hf) := by
  subst hf
  have := BivariantChowClass.locallyOfFiniteType_of_structure sZ f rfl
  exact BivariantChowClass.comp_comm_of_bivariantCommute (fieldChowSituation k) sX sZ f p q c c'
    (bivariantCommute_bivariantToBase_field k sX sZ f p q
      (BivariantChowClass.equivBivariantClass c) (BivariantChowClass.equivBivariantClass c'))

end FieldComposite

end Stacks.Chow

