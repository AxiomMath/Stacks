/-!
# Rules of Stacks 0H6G have no components over proper closed subsets

Let `c` be a rule as in Stacks 0H6G (`Stacks.Chow.CompatibleCycleCapRule`) and let `g : T ⟶ Y` be
an integral test scheme. This file proves that `c ∩ [T]` has no component lying over a proper
closed subset of `T`: its coefficients vanish at the points of `T ×_Y X` over points of `T` other
than the generic point.

The proof is a Gysin computation on the affine line `Spec R[X] ⟶ Spec R` over an affine open
`Spec R` of `T`, with the divisor of `X · φ` for a function `φ` vanishing at the point in question:
see `Stacks.Chow.CompatibleCycleCapRule.cap_fundamentalCycle_apply_eq_zero_of_spec`.

## References

* [Stacks Project, Tag 0H6G](https://stacks.math.columbia.edu/tag/0H6G)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite Order

universe u

namespace Stacks.Chow

attribute [local instance] isInvertible_unitModule isDominant_of_flat

/-- On an affine scheme, the stalk of the zero scheme of a global function at `x` is the ideal
generated by the germ of the function. -/
private theorem stalk_zeroScheme_unitModule_eq_span {X : Scheme.{u}} [IsAffine X] (F : Γ(X, ⊤))
    (x : X) :
    IdealSheafData.stalk (Stacks.Divisors.zeroScheme X (Scheme.unitModule X) F) x =
      Ideal.span {(X.presheaf.germ ⊤ x trivial).hom F} := by
  let U : X.affineOpens := ⟨⊤, isAffineOpen_top X⟩
  have hres : (Scheme.unitModule X).presheaf.map (homOfLE le_top).op F = F := by
    change X.presheaf.map (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)).op F = F
    simp
  exact IdealSheafData.stalk_eq_span_germ_of_ideal_eq_span (U := U) trivial
    (Stacks.Divisors.zeroScheme_ideal_of_trivialization X (Scheme.unitModule X) F U
      (LinearEquiv.refl _ _) F hres)

/-- **The cycle of the zero scheme of a function.** On an affine integral scheme of
delta-dimension `n`, the coefficient of `[Z(F)]_{n-1}` at a point is the order of vanishing of the
nonzero global function `F` there. -/
theorem cycleAssociatedToClosedSubscheme_zeroScheme_unitModule_apply (C : ChowSituation.{u})
    {X : Scheme.{u}} (q : X ⟶ C.S) [LocallyOfFiniteType q] [IsIntegral X] [IsAffine X]
    [IsLocallyNoetherian X] {n : ℤ}
    (hn : schemeDeltaDimension C q = (n : EInt)) (F : Γ(X, ⊤)) (hF : F ≠ 0) (x : X) :
    (cycleAssociatedToClosedSubscheme C q
        (Stacks.Divisors.zeroScheme X (Scheme.unitModule X) F).subschemeι (n - 1)).1 x =
      X.ord (X.germToFunctionField ⊤ F) x := by
  set D := Stacks.Divisors.zeroScheme X (Scheme.unitModule X) F with hD
  by_cases hco : coheight x = 1
  · have : Nonempty (⊤ : X.Opens) := ⟨⟨x, trivial⟩⟩
    have hstalk := stalk_zeroScheme_unitModule_eq_span F x
    by_cases hmem : x ∈ Set.range D.subschemeι.base
    · have hkey := principalDivisorCycle_apply_eq_cycleAssociatedToClosedSubscheme_apply C q hn D
        (Stacks.ChernCap42.genericPoint_notMem_range_subschemeι_zeroScheme
          (Scheme.unitModule X) F hF) hco hmem (show x ∈ (⊤ : X.Opens) from trivial) F hF
          hstalk
      rw [← hkey, principalDivisorCycle_apply]
    · rw [cycleAssociatedToClosedSubscheme_apply_eq_zero_of_notMem_range C q _ (n - 1) hmem]
      have hnot : x ∉ D.support := fun hc =>
        hmem (by rw [Scheme.IdealSheafData.range_subschemeι]; exact hc)
      have htop := (IdealSheafData.stalk_eq_top_iff_notMem_support _ _).mpr hnot
      rw [hstalk] at htop
      rw [← Scheme.algebraMap_germ_eq_germToFunctionField X (show x ∈ (⊤ : X.Opens) from trivial)
          F, Scheme.ord_algebraMap_of_isUnit hco (Ideal.span_singleton_eq_top.mp htop)]
  · rw [Scheme.ord_eq_zero_of_coheight_neq_one hco]
    by_contra hne
    exact hco ((relativeDimension_eq_sub_one_iff_coheight_eq_one C q hn x).mp
      ((mem_cyclesOfDimension_iff_forall_point C q (n - 1) _).mp
        (cycleAssociatedToClosedSubscheme C q D.subschemeι (n - 1)).2 x hne))

/-! ### The affine line over an affine integral scheme -/

section AffineLine

variable (R : CommRingCat.{u})

/-- The projection `Spec R[X] ⟶ Spec R` of the affine line. -/
abbrev lineProj : Spec (CommRingCat.of (Polynomial R)) ⟶ Spec R :=
  Spec.map (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R))

/-- The zero section `Spec R ⟶ Spec R[X]` of the affine line. -/
abbrev lineZero : Spec R ⟶ Spec (CommRingCat.of (Polynomial R)) :=
  Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : R)))

/-- The zero section is a section of the projection of the affine line. -/
@[reassoc (attr := simp)]
theorem lineZero_lineProj : lineZero R ≫ lineProj R = 𝟙 _ := by
  rw [← Spec.map_comp, ← Spec.map_id]
  congr 1
  ext a
  simp

/-- The zero section of the affine line is a closed immersion. -/
instance : IsClosedImmersion (lineZero R) :=
  IsClosedImmersion.spec_of_surjective _ fun a ↦ ⟨Polynomial.C a, by simp⟩

/-- The point of the zero section over a point `t` of `Spec R` is the prime `t[X] + (X)`. -/
theorem lineZero_apply_asIdeal (t : Spec R) :
    (lineZero R t).asIdeal = Ideal.comap (Polynomial.evalRingHom (0 : R)) t.asIdeal :=
  rfl

/-- The point of the affine line over `t` is the inverse image of `t` along `C`. -/
theorem lineProj_apply_asIdeal (z : Spec (CommRingCat.of (Polynomial R))) :
    (lineProj R z).asIdeal = Ideal.comap (Polynomial.C : R →+* Polynomial R) z.asIdeal :=
  rfl

variable [IsDomain R]

open Polynomial Classical in
/-- The coordinate `X` of the affine line vanishes to order one along the zero section and to order
zero along every other prime divisor. -/
theorem ord_lineCoordinate [IsNoetherianRing R] (z : Spec (CommRingCat.of R[X])) :
    (Spec (CommRingCat.of R[X])).ord ((Spec (CommRingCat.of R[X])).germToFunctionField ⊤
      ((Scheme.ΓSpecIso (CommRingCat.of R[X])).inv X)) z =
      if z = lineZero R (genericPoint (Spec R)) then 1 else 0 := by
  have : Nonempty (⊤ : (Spec (CommRingCat.of R[X])).Opens) := ⟨⟨z, trivial⟩⟩
  set q := lineZero R (genericPoint (Spec R)) with hqdef
  have hmemq : ∀ g : R[X], g ∈ q.asIdeal ↔ g.eval 0 = 0 := fun g ↦ by
    rw [hqdef, lineZero_apply_asIdeal, genericPoint_eq_bot_of_affine]
    simp
  have hq : q.asIdeal.comap (C : R →+* R[X]) = ⊥ := by
    ext a
    simp [hmemq]
  have hXq : (X : R[X]) ∈ q.asIdeal := (hmemq X).2 (by simp)
  have hq0 : q.asIdeal ≠ ⊥ := fun h ↦ X_ne_zero ((Submodule.mem_bot _).mp (h ▸ hXq))
  have hmin : ∀ g ∈ q.asIdeal, g ≠ 0 → (X : R[X]).natDegree ≤ g.natDegree := by
    intro g hg hg0
    rw [natDegree_X]
    by_contra h
    have h0 : g.natDegree = 0 := by omega
    rw [eq_C_of_natDegree_eq_zero h0] at hg hg0
    have := (hmemq _).1 hg
    simp only [eval_C] at this
    exact hg0 (by rw [this, map_zero])
  have hz : C (X : R[X]).leadingCoeff ∉ z.asIdeal := by
    rw [leadingCoeff_X, map_one]
    exact z.2.ne_top ∘ (Ideal.eq_top_iff_one _).mpr
  exact ord_germToFunctionField_spec_eq q hq hq0 hXq X_ne_zero hmin z hz

/-- A nonzero element of `A` is a nonzero global function on `Spec A`. -/
theorem ΓSpecIso_inv_ne_zero {A : CommRingCat.{u}} {a : A} (ha : a ≠ 0) :
    (Scheme.ΓSpecIso A).inv a ≠ 0 := by
  intro h
  apply ha
  simpa using congrArg (Scheme.ΓSpecIso A).hom h

/-- The germ of a nonzero function on `Spec R`, as a rational function, is nonzero. -/
theorem germToFunctionField_ΓSpecIso_inv_ne_zero {A : CommRingCat.{u}} [IsDomain A] {a : A}
    (ha : a ≠ 0) :
    (Spec A).germToFunctionField ⊤ ((Scheme.ΓSpecIso A).inv a) ≠ 0 := by
  have : Nonempty (⊤ : (Spec A).Opens) := ⟨⟨genericPoint _, trivial⟩⟩
  intro h
  exact ΓSpecIso_inv_ne_zero ha
    (Scheme.germToFunctionField_injective (Spec A) ⊤ (h.trans (map_zero _).symm))

open Classical in
/-- **The cycle of `X · φ` on the affine line.** Let `R` be a Noetherian domain with `Spec R` of
delta-dimension `n` and `φ ∈ R` nonzero. On `Spec (Polynomial R)` the cycle of the zero scheme of
`X · φ` is
the zero section plus the flat pullback of the principal divisor of `φ`. -/
theorem cycleAssociatedToClosedSubscheme_zeroScheme_lineCoordinate_mul_apply
    (C : ChowSituation.{u}) [IsNoetherianRing R] (q : Spec R ⟶ C.S) [LocallyOfFiniteType q]
    (q'' : Spec (CommRingCat.of (Polynomial R)) ⟶ C.S) [LocallyOfFiniteType q'']
    (hq : lineProj R ≫ q = q'')
    {n : ℤ} (hn : schemeDeltaDimension C q = (n : EInt)) {φ : R} (hφ : φ ≠ 0)
    (z : Spec (CommRingCat.of (Polynomial R))) :
    (cycleAssociatedToClosedSubscheme C q''
        (Stacks.Divisors.zeroScheme (Spec (CommRingCat.of (Polynomial R)))
          (Scheme.unitModule (Spec (CommRingCat.of (Polynomial R))))
          ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial R))).inv
            (Polynomial.X * Polynomial.C φ))).subschemeι n).1 z =
      (if z = lineZero R (genericPoint (Spec R)) then 1 else 0) +
        (flatPullback C q'' q (lineProj R) hq 1 (relativeDimension_specMap_C R)
          (n - 1) (principalDivisorCycle C q hn
            ((Spec R).germToFunctionField ⊤ ((Scheme.ΓSpecIso R).inv φ)))).1 z := by
  subst hq
  have : Nonempty (⊤ : (Spec (CommRingCat.of (Polynomial R))).Opens) := ⟨⟨z, trivial⟩⟩
  have hn'' := schemeDeltaDimension_eq_add_of_flat C (lineProj R ≫ q) q (lineProj R) rfl 1
    (relativeDimension_specMap_C R) hn
  have hX0 : (Polynomial.X * Polynomial.C φ : Polynomial R) ≠ 0 :=
    mul_ne_zero Polynomial.X_ne_zero (Polynomial.C_ne_zero.mpr hφ)
  have hcyc := cycleAssociatedToClosedSubscheme_zeroScheme_unitModule_apply C (lineProj R ≫ q)
    hn'' ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial R))).inv
      (Polynomial.X * Polynomial.C φ)) (ΓSpecIso_inv_ne_zero hX0) z
  rw [show n + ((1 : ℕ) : ℤ) - 1 = n by push_cast; ring] at hcyc
  rw [hcyc, map_mul, map_mul, Scheme.ord_mul
    (germToFunctionField_ΓSpecIso_inv_ne_zero Polynomial.X_ne_zero)
    (germToFunctionField_ΓSpecIso_inv_ne_zero (Polynomial.C_ne_zero.mpr hφ)), ord_lineCoordinate]
  congr 1
  have h02RR := congrArg (fun c : AlgebraicCycle (Spec (CommRingCat.of (Polynomial R))) ℤ ↦ c z)
    (flatPullback_principalDivisorCycle C (lineProj R ≫ q) q (lineProj R) rfl 1
      (relativeDimension_specMap_C R) hn _
      (germToFunctionField_ΓSpecIso_inv_ne_zero hφ))
  simp only at h02RR
  rw [h02RR, principalDivisorCycle_apply]
  congr 1
  symm
  rw [dominantFunctionFieldMap_germToFunctionField_of_mem (lineProj R) z ⊤ trivial ⊤ trivial
    le_top]
  congr 1
  change ((Scheme.ΓSpecIso R).inv ≫ (lineProj R).appTop).hom φ = _
  rw [← Scheme.ΓSpecIso_inv_naturality]
  rfl

end AffineLine

/-! ### The zero scheme of a function -/

/-- **The zero scheme of a function contains the primes containing it.** On `Spec A`, a point
whose prime contains `a` lies in the zero scheme of `a`, read as a global section of the structure
sheaf. -/
theorem mem_support_zeroScheme_unitModule_spec {A : CommRingCat.{u}} (a : A) (y : Spec A)
    (ha : a ∈ y.asIdeal) :
    y ∈ (Stacks.Divisors.zeroScheme (Spec A) (Scheme.unitModule (Spec A))
      ((Scheme.ΓSpecIso A).inv a)).support := by
  by_contra hy
  have htop := (IdealSheafData.stalk_eq_top_iff_notMem_support _ _).mpr hy
  rw [stalk_zeroScheme_unitModule_eq_span] at htop
  have hu := Ideal.span_singleton_eq_top.mp htop
  have h1 : ((Spec A).presheaf.germ ⊤ y trivial).hom ((Scheme.ΓSpecIso A).inv a) =
      (Spec.stalkIso A y).inv (algebraMap A (Localization.AtPrime y.asIdeal) a) :=
    (ConcreteCategory.congr_hom (Spec.algebraMap_stalkIso_inv (R := A) y) a).symm
  rw [h1] at hu
  have hu' : IsUnit (algebraMap A (Localization.AtPrime y.asIdeal) a) := by
    simpa using hu.map (Spec.stalkIso A y).hom.hom
  exact (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime y.asIdeal) y.asIdeal
    a).mp hu' ha

/-- **The Gysin map of the fundamental cycle.** On an integral scheme of delta-dimension `n`, for a
nonzero section `s` of an invertible module, `i_* i^*[X] = [Z(s)]_{n-1}`. -/
theorem gysinCycleMapPushforward_fundamentalCycle (C : ChowSituation.{u}) {X : Scheme.{u}}
    (q : X ⟶ C.S) [LocallyOfFiniteType q] [IsIntegral X] {k : ℤ}
    (hk : schemeDeltaDimension C q = ((k + 1 : ℤ) : EInt)) (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : Γ(L, ⊤)) (hs : s ≠ 0)
    (htriv : AlgebraicGeometry.SheafOfModules.IsTrivial
      (Stacks.Divisors.zeroScheme X L s).subscheme.sheaf.obj
      (Stacks.Divisors.zeroScheme X L s).subscheme.ringCatSheaf.property
      ((Scheme.Modules.pullback (Stacks.Divisors.zeroScheme X L s).subschemeι).obj L)) :
    gysinCycleMapPushforward C q k L s htriv (fundamentalCycle C q (k + 1)) =
      cycleAssociatedToClosedSubscheme C q (Stacks.Divisors.zeroScheme X L s).subschemeι k := by
  have hIntW : IsIntegral (⊥ : X.IdealSheafData).subscheme :=
    IsIntegral.of_isIso (asIso (⊥ : X.IdealSheafData).subschemeι).inv
  have hnW : schemeDeltaDimension C ((⊥ : X.IdealSheafData).subschemeι ≫ q) =
      ((k + 1 : ℤ) : EInt) :=
    (schemeDeltaDimension_of_iso C ((⊥ : X.IdealSheafData).subschemeι ≫ q) q
      (asIso (⊥ : X.IdealSheafData).subschemeι) rfl).symm.trans hk
  have hDZ : Stacks.Divisors.IsEffectiveCartierDivisor
      ((Stacks.Divisors.zeroScheme X L s).comap (⊥ : X.IdealSheafData).subschemeι) := by
    rw [← Stacks.Divisors.zeroScheme_pullback]
    exact isEffectiveCartierDivisor_zeroScheme_of_ne_zero _ _
      (Stacks.ChernCap42.pullbackGlobalSections_ne_zero_of_isIso L s hs _)
  have : IsIso ((⊥ : X.IdealSheafData).comap
      (Stacks.Divisors.zeroScheme X L s).subschemeι).subschemeι :=
    (Scheme.isIso_subschemeι_iff_eq_bot _).mpr (Scheme.IdealSheafData.comap_bot _)
  rw [fundamentalCycle, cycleAssociatedToClosedSubscheme_eq_of_iso C q (𝟙 X)
      (⊥ : X.IdealSheafData).subschemeι (asIso (⊥ : X.IdealSheafData).subschemeι).symm (by simp)
      (k + 1),
    gysinCycleMapPushforward_cycleAssociatedToClosedSubscheme C q k L s htriv ⊥ hnW.le hDZ]
  exact cycleAssociatedToClosedSubscheme_eq_of_iso C q _
    (Stacks.Divisors.zeroScheme X L s).subschemeι
    (asIso ((⊥ : X.IdealSheafData).comap (Stacks.Divisors.zeroScheme X L s).subschemeι).subschemeι)
    rfl k

/-- **`i_* i^* ζ` vanishes at a point that only components inside the divisor reach.** If every
point carrying a coefficient of `ζ` and specializing to `v` lies in the zero scheme `D` of `s`,
then `i_* i^* ζ` has coefficient zero at `v`: each component reaching `v` lies in `D` and is
killed by the Gysin map. -/
theorem gysinCycleMapPushforward_apply_eq_zero_of_forall_specializes (C : ChowSituation.{u})
    {P : Scheme.{u}} (q : P ⟶ C.S) [LocallyOfFiniteType q] (k : ℤ) (L : P.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible P.sheaf.obj P.ringCatSheaf.property L]
    (s : Γ(L, ⊤))
    (htriv : AlgebraicGeometry.SheafOfModules.IsTrivial
      (Stacks.Divisors.zeroScheme P L s).subscheme.sheaf.obj
      (Stacks.Divisors.zeroScheme P L s).subscheme.ringCatSheaf.property
      ((Scheme.Modules.pullback (Stacks.Divisors.zeroScheme P L s).subschemeι).obj L))
    (ζ : CycleGroup C q (k + 1)) (v : P)
    (hv : ∀ x : P, ζ.1 x ≠ 0 → x ⤳ v → x ∈ (Stacks.Divisors.zeroScheme P L s).support) :
    (gysinCycleMapPushforward C q k L s htriv ζ).1 v = 0 := by
  rw [gysinCycleMapPushforward_apply, properPushforward_apply_of_isClosedImmersion]
  refine finsum_mem_eq_zero_of_forall_eq_zero fun y hy ↦ ?_
  rw [isGysinCycleMap_gysinCycleMap C q k L s htriv
      (fun x : cycleSupportIndex ζ ↦ integralComponentAt x.1)
      (fun x ↦ isIntegral_integralComponentAt x.1)
      (fun x ↦ schemeDeltaDimension_cycleSupportIndex ζ x)
      (locallyFinite_support_integralComponentAt ζ) (fun x ↦ ζ.1 x.1) ζ
      (cycle_eq_finsum_primeCycles ζ) y]
  refine finsum_eq_zero_of_forall_eq_zero fun x ↦ ?_
  by_cases hle : Stacks.Divisors.zeroScheme P L s ≤ integralComponentAt x.1
  · rw [gysinCycleMapComponent_of_le C q k L s _ (isIntegral_integralComponentAt x.1)
      (schemeDeltaDimension_cycleSupportIndex ζ x) hle]
    simp
  · rw [gysinCycleMapComponent_of_not_le C q k L s _ (isIntegral_integralComponentAt x.1)
      (schemeDeltaDimension_cycleSupportIndex ζ x) hle]
    by_contra hne
    have hmem := support_cycleAssociatedToClosedSubscheme_subset C _ _ k
      (right_ne_zero_of_mul hne)
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_comap] at hmem
    have hsp : x.1 ⤳ v := by
      have h1 : (Stacks.Divisors.zeroScheme P L s).subschemeι.base y ∈ closure {x.1} := by
        rw [← coe_support_integralComponentAt]
        exact hmem
      rw [hy] at h1
      exact specializes_iff_mem_closure.mpr h1
    exact hle ((le_integralComponentAt_iff_mem_support _ _).mpr (hv x.1 x.2 hsp))

/-- The fundamental cycle does not see how the structure morphism to the base is written. -/
theorem fundamentalCycle_val_congr (C : ChowSituation.{u}) {T : Scheme.{u}} {q q' : T ⟶ C.S}
    [LocallyOfFiniteType q] [LocallyOfFiniteType q'] (h : q = q') (k : ℤ) :
    (fundamentalCycle C q k).1 = (fundamentalCycle C q' k).1 := by
  subst h
  rfl

open Classical in
/-- The fundamental cycle of an integral scheme of delta-dimension `k` is the prime cycle of its
generic point. -/
theorem fundamentalCycle_apply_of_isIntegral (C : ChowSituation.{u}) {T : Scheme.{u}}
    (q : T ⟶ C.S) [LocallyOfFiniteType q] [IsIntegral T] {k : ℤ}
    (hk : schemeDeltaDimension C q = (k : EInt)) (x : T) :
    (fundamentalCycle C q k).1 x = if x = genericPoint T then 1 else 0 := by
  split_ifs with hx
  · subst hx
    exact cycleAssociatedToClosedSubscheme_isIntegral_apply_genericPoint C q (𝟙 T) k
      (WithBotTop.coe_injective ((schemeDeltaDimension_eq_genericPoint C q).symm.trans hk))
  · exact cycleAssociatedToClosedSubscheme_isIntegral_apply_of_ne C q (𝟙 T) k hx

open Classical in
/-- The pushforward of the fundamental cycle of an integral scheme along a closed immersion is the
prime cycle of the image of its generic point. -/
theorem properPushforward_fundamentalCycle_apply (C : ChowSituation.{u}) {T T' : Scheme.{u}}
    (q : T ⟶ C.S) [LocallyOfFiniteType q] (q' : T' ⟶ C.S) [LocallyOfFiniteType q']
    [IsIntegral T] (i : T ⟶ T') [IsClosedImmersion i] (hi : i ≫ q' = q) {k : ℤ}
    (hk : schemeDeltaDimension C q = (k : EInt)) (z : T') :
    (properPushforward C q q' i hi k (fundamentalCycle C q k)).1 z =
      if z = i (genericPoint T) then 1 else 0 := by
  rw [properPushforward_apply_of_isClosedImmersion]
  split_ifs with hz
  · subst hz
    have hfib : i.base ⁻¹' {i.base (genericPoint T)} = {genericPoint T} := by
      ext w
      simp [i.isClosedEmbedding.injective.eq_iff]
    rw [hfib, finsum_mem_singleton, fundamentalCycle_apply_of_isIntegral C q hk, ite_eq_left rfl]
  · refine finsum_mem_eq_zero_of_forall_eq_zero fun w hw ↦ ?_
    rw [fundamentalCycle_apply_of_isIntegral C q hk, ite_eq_right]
    rintro rfl
    exact hz hw.symm

/-- A point of `T ×_Y X` lies in the zero scheme of a pulled-back section exactly when its image in
`T` lies in the zero scheme of the section (Stacks 0B6Y). -/
theorem mem_support_bivariantPullbackZeroScheme {X Y T : Scheme.{u}} (p : X ⟶ Y) (g : T ⟶ Y)
    (L : T.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible T.sheaf.obj T.ringCatSheaf.property L]
    (s : Γ(L, ⊤)) (x : ↥(pullback p g)) :
    x ∈ (bivariantPullbackZeroScheme p g L s).support ↔
      (pullback.snd p g).base x ∈ (Stacks.Divisors.zeroScheme T L s).support := by
  change x ∈ (Stacks.Divisors.zeroScheme (pullback p g)
      ((Scheme.Modules.pullback (pullback.snd p g)).obj L)
      (pullbackGlobalSections (pullback.snd p g) L s)).support ↔ _
  rw [Stacks.Divisors.zeroScheme_pullback, Scheme.IdealSheafData.support_comap]
  rfl

section NoBadComponents

variable {C : ChowSituation.{u}} {X Y : Scheme.{u}} {sY : Y ⟶ C.S} [LocallyOfFiniteType sY]
  {p : X ⟶ Y} [LocallyOfFiniteType p] {r : ℕ}

/-- The zero section of the affine line over a test scheme `g : Spec R ⟶ Y`, read on the base
changes of `X`. -/
def lineZeroBaseChange (R : CommRingCat.{u}) (g : Spec R ⟶ Y) :
    pullback p g ⟶ pullback p (lineProj R ≫ g) :=
  pullback.map p g p (lineProj R ≫ g) (𝟙 X) (lineZero R) (𝟙 Y) (by simp) (by simp)

omit [LocallyOfFiniteType p] in
/-- The zero section read on base changes is a section of the base change of the projection. -/
@[reassoc (attr := simp)]
theorem lineZeroBaseChange_bivariantBaseChangeMap (R : CommRingCat.{u}) (g : Spec R ⟶ Y) :
    lineZeroBaseChange (p := p) R g ≫ bivariantBaseChangeMap p g (lineProj R) = 𝟙 _ := by
  apply pullback.hom_ext
  · simp [lineZeroBaseChange, bivariantBaseChangeMap]
  · simp [lineZeroBaseChange, bivariantBaseChangeMap]

omit [LocallyOfFiniteType p] in
/-- The zero section read on base changes lies over the zero section `lineZero R`. -/
@[reassoc (attr := simp)]
theorem lineZeroBaseChange_snd (R : CommRingCat.{u}) (g : Spec R ⟶ Y) :
    lineZeroBaseChange (p := p) R g ≫ pullback.snd p (lineProj R ≫ g) =
      pullback.snd p g ≫ lineZero R := by
  simp [lineZeroBaseChange]

omit [LocallyOfFiniteType p] in
/-- The zero section read on base changes is the canonical map of the zero section, up to the
identification of the base change along `lineZero R ≫ lineProj R ≫ g = g`. -/
theorem congrHom_inv_bivariantBaseChangeMap_lineZero (R : CommRingCat.{u}) (g : Spec R ⟶ Y)
    (h : lineZero R ≫ lineProj R ≫ g = g) :
    (pullback.congrHom (rfl : p = p) h).inv ≫
        bivariantBaseChangeMap p (lineProj R ≫ g) (lineZero R) =
      lineZeroBaseChange (p := p) R g := by
  apply pullback.hom_ext
  · simp [lineZeroBaseChange, bivariantBaseChangeMap]
  · simp [lineZeroBaseChange, bivariantBaseChangeMap]

open Classical in
/-- **No components over proper closed subsets, on an affine integral test scheme.** Let `c` be a
rule as in Stacks 0H6G and let `g : Spec R ⟶ Y` be a test scheme with `R` a domain. Then
`c ∩ [Spec R]` has no coefficient at a point of `Spec R ×_Y X` lying over a point other than the
generic point of `Spec R`.

Say `w` lies over `t ≠ η`, and choose `φ ≠ 0` vanishing at `t`. On the affine line
`Spec R[X] ⟶ Spec R` the divisor of `X · φ` is the zero section plus the inverse image of the
divisor of `φ`. The Gysin compatibility for `X · φ`, read at the point of the zero section over
`w`, gives on one side `c ∩ [Spec R]` at `w` — the term of the zero section, the term of the
inverse image vanishing for dimension reasons — and on the other side zero: by the flat
compatibility `c ∩ [Spec R[X]]` is the flat pullback of `c ∩ [Spec R]`, and a component of it
through that point which does not lie in the divisor would have to be the closure of `w` itself,
which lies over `t ∈ V(φ)`. -/
theorem CompatibleCycleCapRule.cap_fundamentalCycle_apply_eq_zero_of_spec
    (c : CompatibleCycleCapRule C sY p r) (R : CommRingCat.{u}) [IsDomain R]
    (g : Spec R ⟶ Y) [LocallyOfFiniteType g] {k : ℤ}
    (hk : schemeDeltaDimension C (g ≫ sY) = (k : EInt)) (w : ↥(pullback p g))
    (hw : (pullback.snd p g).base w ≠ genericPoint (Spec R)) :
    (c.cap g k (fundamentalCycle C (g ≫ sY) k)).1 w = 0 := by
  have : IsLocallyNoetherian (Spec R) := LocallyOfFiniteType.isLocallyNoetherian (g ≫ sY)
  have : IsNoetherianRing R := isLocallyNoetherian_Spec.mp inferInstance
  by_contra hne
  have hδw : relativeDimension C.dimensionFunction (pullback.fst p g ≫ p ≫ sY) w =
      (r : ℤ) + k :=
    relativeDimension_eq_of_cycleGroup_apply_ne_zero C _ _ w hne
  obtain ⟨φ, hφt, hφ0⟩ : ∃ φ : R, φ ∈ ((pullback.snd p g).base w).asIdeal ∧ φ ≠ 0 := by
    refine Submodule.exists_mem_ne_zero_of_ne_bot fun h ↦ hw ?_
    rw [genericPoint_eq_bot_of_affine]
    exact PrimeSpectrum.ext h
  have hrel := relativeDimension_specMap_C R
  have hk'' : schemeDeltaDimension C ((lineProj R ≫ g) ≫ sY) = ((k + 1 : ℤ) : EInt) := by
    simpa using schemeDeltaDimension_eq_add_of_flat C ((lineProj R ≫ g) ≫ sY) (g ≫ sY)
      (lineProj R) (Category.assoc _ _ _).symm 1 hrel hk
  have hXφ : (Polynomial.X * Polynomial.C φ : Polynomial R) ≠ 0 :=
    mul_ne_zero Polynomial.X_ne_zero (Polynomial.C_ne_zero.mpr hφ0)
  have htriv : AlgebraicGeometry.SheafOfModules.IsTrivial
      (Stacks.Divisors.zeroScheme (Spec (CommRingCat.of (Polynomial R)))
        (Scheme.unitModule (Spec (CommRingCat.of (Polynomial R))))
        ((Scheme.ΓSpecIso _).inv (Polynomial.X * Polynomial.C φ))).subscheme.sheaf.obj
      (Stacks.Divisors.zeroScheme (Spec (CommRingCat.of (Polynomial R)))
        (Scheme.unitModule (Spec (CommRingCat.of (Polynomial R))))
        ((Scheme.ΓSpecIso _).inv (Polynomial.X * Polynomial.C φ))).subscheme.ringCatSheaf.property
      ((Scheme.Modules.pullback (Stacks.Divisors.zeroScheme (Spec (CommRingCat.of (Polynomial R)))
        (Scheme.unitModule (Spec (CommRingCat.of (Polynomial R))))
        ((Scheme.ΓSpecIso _).inv (Polynomial.X * Polynomial.C φ))).subschemeι).obj
          (Scheme.unitModule (Spec (CommRingCat.of (Polynomial R))))) :=
    ⟨Scheme.Modules.pullbackUnitIso _⟩
  -- the structure morphisms involved
  have hσ : lineZero R ≫ lineProj R ≫ g = g := by simp
  have hkσ : schemeDeltaDimension C ((lineZero R ≫ lineProj R ≫ g) ≫ sY) = (k : EInt) := by
    have key : ∀ q' : Spec R ⟶ C.S, ∀ [LocallyOfFiniteType q'], q' = g ≫ sY →
        schemeDeltaDimension C q' = (k : EInt) := by
      rintro _ _ rfl
      exact hk
    exact key _ (by rw [hσ])
  -- the cycle of the divisor of `X · φ`
  set A := properPushforward C ((lineZero R ≫ lineProj R ≫ g) ≫ sY) ((lineProj R ≫ g) ≫ sY)
    (lineZero R) (Category.assoc _ _ _).symm k
    (fundamentalCycle C ((lineZero R ≫ lineProj R ≫ g) ≫ sY) k) with hA
  set Dφ := principalDivisorCycle C (g ≫ sY) hk
    ((Spec R).germToFunctionField ⊤ ((Scheme.ΓSpecIso R).inv φ)) with hDφ
  set B := cycleGroupCongr C ((lineProj R ≫ g) ≫ sY) (by push_cast; ring :
      k - 1 + ((1 : ℕ) : ℤ) = k)
    (flatPullback C ((lineProj R ≫ g) ≫ sY) (g ≫ sY) (lineProj R) (Category.assoc _ _ _).symm 1
      hrel (k - 1) Dφ) with hB
  have hdecomp : cycleAssociatedToClosedSubscheme C ((lineProj R ≫ g) ≫ sY)
      (Stacks.Divisors.zeroScheme (Spec (CommRingCat.of (Polynomial R)))
        (Scheme.unitModule (Spec (CommRingCat.of (Polynomial R))))
        ((Scheme.ΓSpecIso _).inv (Polynomial.X * Polynomial.C φ))).subschemeι k = A + B := by
    refine Subtype.ext (Function.locallyFinsuppWithin.ext fun z ↦ ?_)
    rw [cycleAssociatedToClosedSubscheme_zeroScheme_lineCoordinate_mul_apply R C (g ≫ sY)
      ((lineProj R ≫ g) ≫ sY) (Category.assoc _ _ _).symm hk hφ0 z]
    change _ = A.1 z + B.1 z
    rw [hA, properPushforward_fundamentalCycle_apply C _ _ (lineZero R) _ hkσ z]
    rfl
  -- the Gysin compatibility, read at the point of the zero section over `w`
  set w₀ := (lineZeroBaseChange (p := p) R g).base w with hw₀
  have hG := congrArg (fun ζ ↦ ζ.1 w₀) (c.cap_gysinCycleMapPushforward (lineProj R ≫ g)
    (Scheme.unitModule _) ((Scheme.ΓSpecIso _).inv (Polynomial.X * Polynomial.C φ)) htriv k
    (fundamentalCycle C ((lineProj R ≫ g) ≫ sY) (k + 1)))
  simp only at hG
  rw [gysinCycleMapPushforward_fundamentalCycle C _ hk'' _ _ (ΓSpecIso_inv_ne_zero hXφ) htriv,
    hdecomp, map_add] at hG
  -- the point of the zero section over `w` lies over `w`
  have hpt : (bivariantBaseChangeMap p g (lineProj R)).base w₀ = w := by
    rw [hw₀]
    change (lineZeroBaseChange (p := p) R g ≫ bivariantBaseChangeMap p g (lineProj R)).base w = w
    rw [lineZeroBaseChange_bivariantBaseChangeMap]
    rfl
  -- the term of the zero section is `c ∩ [Spec R]` at `w`
  have hAterm : (c.cap (lineProj R ≫ g) k A).1 w₀ =
      (c.cap g k (fundamentalCycle C (g ≫ sY) k)).1 w := by
    have hpt : w₀ = (bivariantBaseChangeMap p (lineProj R ≫ g) (lineZero R)).base
        ((pullback.congrHom (rfl : p = p) hσ).inv.base w) := by
      rw [hw₀, ← congrHom_inv_bivariantBaseChangeMap_lineZero R g hσ]
      rfl
    rw [hpt, hA, CycleCapRule.cap_properPushforward_apply,
      CycleCapRule.cap_congr_hom _ hσ k _ (fundamentalCycle C (g ≫ sY) k)
        (fundamentalCycle_val_congr C (by rw [hσ]) k)]
    congr 1
    change ((pullback.congrHom (rfl : p = p) hσ).inv ≫
      (pullback.congrHom (rfl : p = p) hσ).hom).base w = w
    rw [Iso.inv_hom_id]
    rfl
  -- the term of the inverse image of `div φ` vanishes for dimension reasons
  have hBterm : (c.cap (lineProj R ≫ g) k B).1 w₀ = 0 := by
    have h1 := c.cap_flatPullback g (lineProj R) 1 hrel (k - 1) Dφ
    rw [c.cap_val_congr (lineProj R ≫ g) (by push_cast; ring : k = k - 1 + ((1 : ℕ) : ℤ)) B _
      rfl, h1, flatPullback_apply]
    rw [hpt]
    by_cases h0 : (c.cap g (k - 1) Dφ).1 w = 0
    · rw [h0, zero_mul]
    · have := relativeDimension_eq_of_cycleGroup_apply_ne_zero C _ _ w h0
      omega
  -- the other side vanishes: a component through `w₀` off the divisor would be over `t ∈ V(φ)`
  have hflat := c.cap_flatPullback g (lineProj R) 1 hrel k (fundamentalCycle C (g ≫ sY) k)
  rw [flatPullback_fundamentalCycle C _ _ (lineProj R) (Category.assoc _ _ _).symm 1 hrel k
    hk.le] at hflat
  have hRHS : (gysinCycleMapPushforward C (pullback.fst p (lineProj R ≫ g) ≫ p ≫ sY)
      ((r : ℤ) + k) (bivariantPullbackModule p (lineProj R ≫ g) (Scheme.unitModule _))
      (bivariantPullbackSection p (lineProj R ≫ g) (Scheme.unitModule _)
        ((Scheme.ΓSpecIso _).inv (Polynomial.X * Polynomial.C φ)))
      (Stacks.Divisors.isTrivial_pullback_zeroScheme_pullbackGlobalSections
        (pullback.snd p (lineProj R ≫ g)) _ _ htriv)
      (cycleGroupCongr C _ (add_assoc (r : ℤ) k 1).symm
        (c.cap (lineProj R ≫ g) (k + 1)
          (fundamentalCycle C ((lineProj R ≫ g) ≫ sY) (k + 1))))).1 w₀ = 0 := by
    refine gysinCycleMapPushforward_apply_eq_zero_of_forall_specializes C _ _ _ _ _ _ w₀ ?_
    intro x hx hxw
    have hx' : (c.cap (lineProj R ≫ g) (k + ((1 : ℕ) : ℤ))
        (fundamentalCycle C ((lineProj R ≫ g) ≫ sY) (k + ((1 : ℕ) : ℤ)))).1 x ≠ 0 := by
      rw [c.cap_val_congr (lineProj R ≫ g) (by push_cast; ring : k + ((1 : ℕ) : ℤ) = k + 1) _
        (fundamentalCycle C ((lineProj R ≫ g) ≫ sY) (k + 1)) (by congr 1)]
      exact hx
    rw [hflat, flatPullback_apply] at hx'
    have hcx := left_ne_zero_of_mul hx'
    have hδx := relativeDimension_eq_of_cycleGroup_apply_ne_zero C _ _ _ hcx
    have hsp : (bivariantBaseChangeMap p g (lineProj R)).base x ⤳ w :=
      hpt ▸ hxw.map (bivariantBaseChangeMap p g (lineProj R)).base.hom.continuous
    have heq : (bivariantBaseChangeMap p g (lineProj R)).base x = w := by
      by_contra hne'
      have := relativeDimension_lt_of_specializes C (pullback.fst p g ≫ p ≫ sY) hsp hne'
      omega
    have hπ : lineProj R ((pullback.snd p (lineProj R ≫ g)).base x) =
        (pullback.snd p g).base w := by
      rw [← heq]
      change (pullback.snd p (lineProj R ≫ g) ≫ lineProj R).base x =
        (bivariantBaseChangeMap p g (lineProj R) ≫ pullback.snd p g).base x
      rw [(isPullback_bivariantBaseChangeMap p g (lineProj R)).w]
    have hCφ : Polynomial.C φ ∈ ((pullback.snd p (lineProj R ≫ g)).base x).asIdeal := by
      have : φ ∈ (lineProj R ((pullback.snd p (lineProj R ≫ g)).base x)).asIdeal := by
        rw [hπ]
        exact hφt
      rwa [lineProj_apply_asIdeal, Ideal.mem_comap] at this
    have hmemD := mem_support_zeroScheme_unitModule_spec (Polynomial.X * Polynomial.C φ) _
      (Ideal.mul_mem_left _ _ hCφ)
    exact (mem_support_bivariantPullbackZeroScheme p (lineProj R ≫ g) _ _ x).mpr hmemD
  have hsum : (c.cap (lineProj R ≫ g) k (A + B)).1 w₀ =
      (c.cap (lineProj R ≫ g) k A).1 w₀ + (c.cap (lineProj R ≫ g) k B).1 w₀ := by
    rw [map_add]
    rfl
  rw [← map_add, hsum, hAterm, hBterm, add_zero, hRHS] at hG
  exact hne hG

/-- A schematic open of an integral scheme has the delta-dimension of the scheme. -/
theorem schemeDeltaDimension_opensι_comp (C : ChowSituation.{u}) {T : Scheme.{u}} [IsIntegral T]
    (q : T ⟶ C.S) [LocallyOfFiniteType q] (V : T.Opens) [Nonempty V] {k : ℤ}
    (hk : schemeDeltaDimension C q = (k : EInt)) :
    schemeDeltaDimension C (V.ι ≫ q) = (k : EInt) := by
  have : IsIntegral V := isIntegral_of_isOpenImmersion V.ι
  rw [schemeDeltaDimension_eq_genericPoint, relativeDimension_comp_isOpenImmersion,
    genericPoint_eq_of_isOpenImmersion V.ι, ← schemeDeltaDimension_eq_genericPoint, hk]

/-- **No components over proper closed subsets (Stacks 0H6G).** Let `c` be a rule as in
Stacks 0H6G and let `g : T ⟶ Y` be a test scheme with `T` integral. Then `c ∩ [T]` has no
coefficient at a point of `T ×_Y X` lying over a point of `T` other than its generic point.

Around the image of the point choose an affine open `V ≅ Spec R`; restriction to `V` is the flat
compatibility along an open immersion and the identification with `Spec R` the proper one along an
isomorphism, so this is
`Stacks.Chow.CompatibleCycleCapRule.cap_fundamentalCycle_apply_eq_zero_of_spec`. -/
theorem CompatibleCycleCapRule.cap_fundamentalCycle_apply_eq_zero
    (c : CompatibleCycleCapRule C sY p r) {T : Scheme.{u}} [IsIntegral T] (g : T ⟶ Y)
    [LocallyOfFiniteType g] {k : ℤ} (hk : schemeDeltaDimension C (g ≫ sY) = (k : EInt))
    (w : ↥(pullback p g)) (hw : (pullback.snd p g).base w ≠ genericPoint T) :
    (c.cap g k (fundamentalCycle C (g ≫ sY) k)).1 w = 0 := by
  obtain ⟨V, hV, htV⟩ : ∃ V : T.Opens, IsAffineOpen V ∧ (pullback.snd p g).base w ∈ V := by
    obtain ⟨_, ⟨V, hV, rfl⟩, htV, -⟩ := T.isBasis_affineOpens.exists_subset_of_mem_open
      (Set.mem_univ ((pullback.snd p g).base w)) isOpen_univ
    exact ⟨V, hV, htV⟩
  have : Nonempty V := ⟨⟨_, htV⟩⟩
  have : IsIntegral V := isIntegral_of_isOpenImmersion V.ι
  have hkV := schemeDeltaDimension_opensι_comp C (g ≫ sY) V hk
  -- restriction to `V`
  obtain ⟨w', hw'⟩ : w ∈ Set.range (bivariantBaseChangeMap p g V.ι).base := by
    rw [range_fst_of_isPullback (isPullback_bivariantBaseChangeMap p g V.ι).flip]
    exact ⟨⟨_, htV⟩, rfl⟩
  have hres := c.cap_cycleGroupRestrict_apply g V.ι k (fundamentalCycle C (g ≫ sY) k) w'
  rw [hw'] at hres
  rw [← hres, c.cap_val_congr (V.ι ≫ g) rfl _ (fundamentalCycle C ((V.ι ≫ g) ≫ sY) k) ?_]
  swap
  · refine Function.locallyFinsuppWithin.ext fun v ↦ ?_
    rw [cycleGroupRestrict_apply, fundamentalCycle_apply_of_isIntegral C _ hk,
      fundamentalCycle_apply_of_isIntegral C _ (by simpa [Category.assoc] using hkV),
      ← genericPoint_eq_of_isOpenImmersion V.ι]
    by_cases h : v = genericPoint V
    · rw [ite_eq_left h, ite_eq_left (congrArg _ h)]
    · rw [ite_eq_right h, ite_eq_right (fun h' ↦ h (V.ι.isOpenEmbedding.injective h'))]
  -- identification of `V` with the spectrum of its ring of sections
  set e := hV.isoSpec with he
  obtain ⟨z, hz⟩ : w' ∈ Set.range (bivariantBaseChangeMap p (V.ι ≫ g) e.inv).base := by
    have : IsIso (bivariantBaseChangeMap p (V.ι ≫ g) e.inv) :=
      MorphismProperty.of_isPullback (isPullback_bivariantBaseChangeMap p (V.ι ≫ g) e.inv)
        (P := MorphismProperty.isomorphisms _) (inferInstanceAs (IsIso e.inv))
    exact ⟨(inv (bivariantBaseChangeMap p (V.ι ≫ g) e.inv)).base w', by
      rw [← Scheme.Hom.comp_apply, IsIso.inv_hom_id]; rfl⟩
  have hkS : schemeDeltaDimension C ((e.inv ≫ V.ι ≫ g) ≫ sY) = (k : EInt) := by
    rw [← hkV]
    exact (schemeDeltaDimension_of_iso C _ _ e.symm (by simp)).symm
  rw [← hz, c.cap_val_congr (V.ι ≫ g) rfl _
    (properPushforward C ((e.inv ≫ V.ι ≫ g) ≫ sY) ((V.ι ≫ g) ≫ sY) e.inv
      (Category.assoc _ _ _).symm k (fundamentalCycle C ((e.inv ≫ V.ι ≫ g) ≫ sY) k)) ?_,
    CycleCapRule.cap_properPushforward_apply]
  · refine c.cap_fundamentalCycle_apply_eq_zero_of_spec _ _ hkS z fun hzη ↦ hw ?_
    have hsnd : (pullback.snd p (V.ι ≫ g)).base w' =
        e.inv.base ((pullback.snd p (e.inv ≫ V.ι ≫ g)).base z) := by
      rw [← hz]
      change (bivariantBaseChangeMap p (V.ι ≫ g) e.inv ≫ pullback.snd p (V.ι ≫ g)).base z =
        (pullback.snd p (e.inv ≫ V.ι ≫ g) ≫ e.inv).base z
      rw [(isPullback_bivariantBaseChangeMap p (V.ι ≫ g) e.inv).w]
    rw [← hw']
    change (bivariantBaseChangeMap p g V.ι ≫ pullback.snd p g).base w' = _
    rw [← (isPullback_bivariantBaseChangeMap p g V.ι).w, Scheme.Hom.comp_apply, hsnd, hzη,
      genericPoint_eq_of_isOpenImmersion e.inv, genericPoint_eq_of_isOpenImmersion V.ι]
  · refine Function.locallyFinsuppWithin.ext fun v ↦ ?_
    rw [fundamentalCycle_apply_of_isIntegral C _ (by simpa [Category.assoc] using hkV),
      properPushforward_fundamentalCycle_apply C _ _ e.inv _ hkS,
      genericPoint_eq_of_isOpenImmersion e.inv]

end NoBadComponents

end Stacks.Chow

