module

public import Mathlib.Algebra.CharP.Two
public import Mathlib.Algebra.MvPolynomial.Division
public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.Polynomial.Basic
public import Mathlib.Tactic.LinearCombination
public import Mathlib.Tactic.FinCases
public import StacksCore.Tactic.StacksAttribute

/-!
# The invariants of the swap of the two factors of the affine plane squared

Let `k` be a field of characteristic `2` and let `R = k[u₁, u₂, v₁, v₂]` be the coordinate ring of
`A² × A²`, the two copies of the plane having coordinates `(u₁, v₁)` and `(u₂, v₂)`. The involution
`σ` of `R` exchanging the two factors fixes exactly the subalgebra

  `k[u₁ + u₂, u₁u₂, v₁ + v₂, v₁v₂, u₁v₁ + u₂v₂] ⊆ k[u₁, u₂, v₁, v₂]`,

which is the description of the coordinate ring of `Sym²(A²)` that Stacks Remark 0H5Y uses.

## Main definitions

* `Stacks.Chow.SymPlane.ring` — the polynomial ring `k[u₁, u₂, v₁, v₂]`, as
  `MvPolynomial (Fin 2 × Fin 2) k`: the variable `X (i, j)` is the coordinate `i` (`u` or `v`) of
  the factor `j`.
* `Stacks.Chow.SymPlane.swap` — the involution exchanging the two factors.
* `Stacks.Chow.SymPlane.sym` — the subalgebra generated by `u₁ + u₂, u₁u₂, v₁ + v₂, v₁v₂` and
  `u₁v₁ + u₂v₂`.

## Main results

* `Stacks.Chow.SymPlane.mem_sym_iff` — in characteristic `2`, an element of `R` is fixed by the
  involution exactly when it lies in that subalgebra.

## Implementation notes

The ring `R` is free over the subalgebra `B₀ = k[u₁ + u₂, u₁u₂, v₁ + v₂, v₁v₂]` of polynomials
symmetric in each pair of variables separately, with basis `1, u₁, v₁, u₁v₁`; spanning is an
induction on polynomials and independence is checked with the two partial swaps, which fix `B₀`.
Writing an invariant as `a + b u₁ + c v₁ + d u₁v₁` the invariance forces, in characteristic `2`,
`d = 0` and `b (u₁ + u₂) = c (v₁ + v₂)`. Since `v₁ + v₂` is prime and does not divide `u₁ + u₂`
this gives `b = t (v₁ + v₂)`, `c = t (u₁ + u₂)` for some `t ∈ B₀`, and the invariant is
`a + t (u₁v₂ + u₂v₁)` with `u₁v₂ + u₂v₁ = (u₁ + u₂)(v₁ + v₂) + (u₁v₁ + u₂v₂)`.

## References

* [Stacks Project, Remark 0H5Y](https://stacks.math.columbia.edu/tag/0H5Y)
-/

@[expose] public noncomputable section

open MvPolynomial

universe u

namespace Stacks.Chow.SymPlane

variable (k : Type u) [Field k]

/-- The polynomial ring `k[u₁, u₂, v₁, v₂]` of `A² × A²`: the variable `X (i, j)` is the
coordinate `i` (`0` for `u`, `1` for `v`) of the factor `j`. -/
abbrev ring : Type u := MvPolynomial (Fin 2 × Fin 2) k

/-- The coordinate `u₁`. -/
abbrev u₁ : ring k := X (0, 0)
/-- The coordinate `u₂`. -/
abbrev u₂ : ring k := X (0, 1)
/-- The coordinate `v₁`. -/
abbrev v₁ : ring k := X (1, 0)
/-- The coordinate `v₂`. -/
abbrev v₂ : ring k := X (1, 1)

/-- The involution of `k[u₁, u₂, v₁, v₂]` exchanging the two factors. -/
def swap : ring k ≃ₐ[k] ring k :=
  renameEquiv k (Equiv.prodCongr (Equiv.refl _) (Equiv.swap 0 1))

/-- The involution exchanging `u₁` and `u₂` only. -/
def swapU : ring k →ₐ[k] ring k :=
  rename fun ij => (ij.1, if ij.1 = 0 then Equiv.swap 0 1 ij.2 else ij.2)

/-- The involution exchanging `v₁` and `v₂` only. -/
def swapV : ring k →ₐ[k] ring k :=
  rename fun ij => (ij.1, if ij.1 = 1 then Equiv.swap 0 1 ij.2 else ij.2)

/-- The involution `swap` sends `u₁` to `u₂`. -/
@[simp] theorem swap_u₁ : swap k (u₁ k) = u₂ k := by simp [swap]
/-- The involution `swap` sends `u₂` to `u₁`. -/
@[simp] theorem swap_u₂ : swap k (u₂ k) = u₁ k := by simp [swap]
/-- The involution `swap` sends `v₁` to `v₂`. -/
@[simp] theorem swap_v₁ : swap k (v₁ k) = v₂ k := by simp [swap]
/-- The involution `swap` sends `v₂` to `v₁`. -/
@[simp] theorem swap_v₂ : swap k (v₂ k) = v₁ k := by simp [swap]
/-- The map `swapU` sends `u₁` to `u₂`. -/
@[simp] theorem swapU_u₁ : swapU k (u₁ k) = u₂ k := by simp [swapU]
/-- The map `swapU` sends `u₂` to `u₁`. -/
@[simp] theorem swapU_u₂ : swapU k (u₂ k) = u₁ k := by simp [swapU]
/-- The map `swapU` fixes `v₁`. -/
@[simp] theorem swapU_v₁ : swapU k (v₁ k) = v₁ k := by simp [swapU]
/-- The map `swapU` fixes `v₂`. -/
@[simp] theorem swapU_v₂ : swapU k (v₂ k) = v₂ k := by simp [swapU]
/-- The map `swapV` fixes `u₁`. -/
@[simp] theorem swapV_u₁ : swapV k (u₁ k) = u₁ k := by simp [swapV]
/-- The map `swapV` fixes `u₂`. -/
@[simp] theorem swapV_u₂ : swapV k (u₂ k) = u₂ k := by simp [swapV]
/-- The map `swapV` sends `v₁` to `v₂`. -/
@[simp] theorem swapV_v₁ : swapV k (v₁ k) = v₂ k := by simp [swapV]
/-- The map `swapV` sends `v₂` to `v₁`. -/
@[simp] theorem swapV_v₂ : swapV k (v₂ k) = v₁ k := by simp [swapV]

/-- The subalgebra `B₀ = k[u₁ + u₂, u₁u₂, v₁ + v₂, v₁v₂]` of polynomials symmetric in each pair of
variables. -/
def bisym : Subalgebra k (ring k) :=
  Algebra.adjoin k {u₁ k + u₂ k, u₁ k * u₂ k, v₁ k + v₂ k, v₁ k * v₂ k}

/-- **The coordinate ring of `Sym²(A²)`**: the subalgebra
`k[u₁ + u₂, u₁u₂, v₁ + v₂, v₁v₂, u₁v₁ + u₂v₂]` of `k[u₁, u₂, v₁, v₂]`. -/
def sym : Subalgebra k (ring k) :=
  Algebra.adjoin k {u₁ k + u₂ k, u₁ k * u₂ k, v₁ k + v₂ k, v₁ k * v₂ k, u₁ k * v₁ k + u₂ k * v₂ k}

/-- The subalgebra `B₀` is contained in `k[u₁ + u₂, u₁u₂, v₁ + v₂, v₁v₂, u₁v₁ + u₂v₂]`. -/
theorem bisym_le_sym : bisym k ≤ sym k := by
  apply Algebra.adjoin_mono
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢
  tauto

variable {k}

/-- The element `u₁ + u₂` lies in `B₀`. -/
theorem p_mem_bisym : u₁ k + u₂ k ∈ bisym k := Algebra.subset_adjoin (by simp)
/-- The element `u₁u₂` lies in `B₀`. -/
theorem e_mem_bisym : u₁ k * u₂ k ∈ bisym k := Algebra.subset_adjoin (by simp)
/-- The element `v₁ + v₂` lies in `B₀`. -/
theorem q_mem_bisym : v₁ k + v₂ k ∈ bisym k := Algebra.subset_adjoin (by simp)
/-- The element `v₁v₂` lies in `B₀`. -/
theorem f_mem_bisym : v₁ k * v₂ k ∈ bisym k := Algebra.subset_adjoin (by simp)
/-- The element `u₁v₁ + u₂v₂` lies in `sym k`. -/
theorem h_mem_sym : u₁ k * v₁ k + u₂ k * v₂ k ∈ sym k := Algebra.subset_adjoin (by simp)

/-- An algebra map fixing the generators of a subalgebra fixes the subalgebra. -/
theorem eq_self_of_mem_adjoin {s : Set (ring k)} (φ : ring k →ₐ[k] ring k)
    (hs : ∀ x ∈ s, φ x = x) {x : ring k} (hx : x ∈ Algebra.adjoin k s) : φ x = x := by
  induction hx using Algebra.adjoin_induction with
  | mem x h => exact hs x h
  | algebraMap r => exact φ.commutes r
  | add x y _ _ hx hy => rw [map_add, hx, hy]
  | mul x y _ _ hx hy => rw [map_mul, hx, hy]

/-- The map `swapU` fixes every element of `B₀`. -/
theorem swapU_bisym {x : ring k} (hx : x ∈ bisym k) : swapU k x = x := by
  refine eq_self_of_mem_adjoin _ ?_ hx
  intro y hy
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
  rcases hy with rfl | rfl | rfl | rfl <;> simp [add_comm, mul_comm]

/-- The map `swapV` fixes every element of `B₀`. -/
theorem swapV_bisym {x : ring k} (hx : x ∈ bisym k) : swapV k x = x := by
  refine eq_self_of_mem_adjoin _ ?_ hx
  intro y hy
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
  rcases hy with rfl | rfl | rfl | rfl <;> simp [add_comm, mul_comm]

/-- The involution `swap` fixes every element of `sym k`. -/
theorem swap_sym {x : ring k} (hx : x ∈ sym k) : swap k x = x := by
  refine eq_self_of_mem_adjoin (swap k).toAlgHom ?_ hx
  intro y hy
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
  rcases hy with rfl | rfl | rfl | rfl | rfl <;> simp [add_comm, mul_comm]

/-! ### `R` is spanned over `B₀` by `1, u₁, v₁, u₁v₁` -/

/-- The elements `a + b u₁ + c v₁ + d u₁v₁` with coefficients in `B₀`. -/
def IsSpanned (x : ring k) : Prop :=
  ∃ a ∈ bisym k, ∃ b ∈ bisym k, ∃ c ∈ bisym k, ∃ d ∈ bisym k,
    x = a + b * u₁ k + c * v₁ k + d * (u₁ k * v₁ k)

/-- Every element of `B₀` is of the form `a + b u₁ + c v₁ + d u₁v₁` with `a, b, c, d ∈ B₀`. -/
theorem isSpanned_of_mem {a : ring k} (ha : a ∈ bisym k) : IsSpanned a :=
  ⟨a, ha, 0, zero_mem _, 0, zero_mem _, 0, zero_mem _, by ring⟩

/-- The elements satisfying `IsSpanned` are closed under addition. -/
theorem IsSpanned.add {x y : ring k} (hx : IsSpanned x) (hy : IsSpanned y) :
    IsSpanned (x + y) := by
  obtain ⟨a, ha, b, hb, c, hc, d, hd, rfl⟩ := hx
  obtain ⟨a', ha', b', hb', c', hc', d', hd', rfl⟩ := hy
  exact ⟨a + a', add_mem ha ha', b + b', add_mem hb hb', c + c', add_mem hc hc', d + d',
    add_mem hd hd', by ring⟩

/-- The elements satisfying `IsSpanned` are closed under multiplication by elements of `B₀`. -/
theorem IsSpanned.smul {x : ring k} (hx : IsSpanned x) {r : ring k} (hr : r ∈ bisym k) :
    IsSpanned (r * x) := by
  obtain ⟨a, ha, b, hb, c, hc, d, hd, rfl⟩ := hx
  exact ⟨r * a, mul_mem hr ha, r * b, mul_mem hr hb, r * c, mul_mem hr hc, r * d,
    mul_mem hr hd, by ring⟩

/-- The elements satisfying `IsSpanned` are closed under negation. -/
theorem IsSpanned.neg {x : ring k} (hx : IsSpanned x) : IsSpanned (-x) := by
  have h := hx.smul (r := -1) (neg_mem (one_mem _))
  simpa using h

/-- The elements satisfying `IsSpanned` are closed under multiplication by `u₁`. -/
theorem IsSpanned.mul_u₁ {x : ring k} (hx : IsSpanned x) : IsSpanned (x * u₁ k) := by
  obtain ⟨a, ha, b, hb, c, hc, d, hd, rfl⟩ := hx
  refine ⟨-(b * (u₁ k * u₂ k)), neg_mem (mul_mem hb e_mem_bisym), a + b * (u₁ k + u₂ k),
    add_mem ha (mul_mem hb p_mem_bisym), -(d * (u₁ k * u₂ k)), neg_mem (mul_mem hd e_mem_bisym),
    c + d * (u₁ k + u₂ k), add_mem hc (mul_mem hd p_mem_bisym), by ring⟩

/-- The elements satisfying `IsSpanned` are closed under multiplication by `v₁`. -/
theorem IsSpanned.mul_v₁ {x : ring k} (hx : IsSpanned x) : IsSpanned (x * v₁ k) := by
  obtain ⟨a, ha, b, hb, c, hc, d, hd, rfl⟩ := hx
  refine ⟨-(c * (v₁ k * v₂ k)), neg_mem (mul_mem hc f_mem_bisym), -(d * (v₁ k * v₂ k)),
    neg_mem (mul_mem hd f_mem_bisym), a + c * (v₁ k + v₂ k), add_mem ha (mul_mem hc q_mem_bisym),
    b + d * (v₁ k + v₂ k), add_mem hb (mul_mem hd q_mem_bisym), by ring⟩

/-- If `z + w ∈ B₀` and `x * z` is spanned, then so is `x * w`. -/
private theorem IsSpanned.mul_of_add_mem {x z w s : ring k} (hx : IsSpanned x)
    (hs : s ∈ bisym k) (hsum : z + w = s) (hz : IsSpanned (x * z)) : IsSpanned (x * w) := by
  have h : x * w = s * x + -(x * z) := by rw [← hsum]; ring
  rw [h]
  exact (hx.smul hs).add hz.neg

/-- The elements satisfying `IsSpanned` are closed under multiplication by `u₂`. -/
theorem IsSpanned.mul_u₂ {x : ring k} (hx : IsSpanned x) : IsSpanned (x * u₂ k) :=
  hx.mul_of_add_mem p_mem_bisym rfl hx.mul_u₁

/-- The elements satisfying `IsSpanned` are closed under multiplication by `v₂`. -/
theorem IsSpanned.mul_v₂ {x : ring k} (hx : IsSpanned x) : IsSpanned (x * v₂ k) :=
  hx.mul_of_add_mem q_mem_bisym rfl hx.mul_v₁

/-- Every element of `k[u₁, u₂, v₁, v₂]` is `a + b u₁ + c v₁ + d u₁v₁` with `a, b, c, d ∈ B₀`. -/
theorem isSpanned (x : ring k) : IsSpanned x := by
  induction x using MvPolynomial.induction_on with
  | C a => exact isSpanned_of_mem (Subalgebra.algebraMap_mem _ a)
  | add p q hp hq => exact hp.add hq
  | mul_X p ij hp =>
    obtain ⟨i, j⟩ := ij
    fin_cases i <;> fin_cases j
    · exact hp.mul_u₁
    · exact hp.mul_u₂
    · exact hp.mul_v₁
    · exact hp.mul_v₂

/-! ### Independence of `1, u₁, v₁, u₁v₁` over `B₀` -/

/-- The element `u₁ - u₂` is nonzero. -/
theorem u₁_sub_u₂_ne_zero : u₁ k - u₂ k ≠ 0 := by
  rw [sub_ne_zero]
  intro h
  have := X_injective (σ := Fin 2 × Fin 2) (R := k) h
  simp at this

/-- The element `v₁ - v₂` is nonzero. -/
theorem v₁_sub_v₂_ne_zero : v₁ k - v₂ k ≠ 0 := by
  rw [sub_ne_zero]
  intro h
  have := X_injective (σ := Fin 2 × Fin 2) (R := k) h
  simp at this

/-- If `swapV` fixes `a + c v₁` with `a, c ∈ B₀`, then `c = 0`. -/
private theorem eq_zero_of_swapV_eq {a c : ring k} (ha : a ∈ bisym k) (hc : c ∈ bisym k)
    (h : swapV k (a + c * v₁ k) = a + c * v₁ k) : c = 0 := by
  simp only [map_add, map_mul, swapV_bisym ha, swapV_bisym hc, swapV_v₁] at h
  have h2 : c * (v₁ k - v₂ k) = 0 := by linear_combination -h
  exact (mul_eq_zero.mp h2).resolve_right v₁_sub_v₂_ne_zero

/-- If `swapU` fixes `a + b u₁ + c v₁ + d u₁v₁` with `a, b, c, d ∈ B₀`, then `b = d = 0`. -/
private theorem eq_zero_of_swapU_eq {a b c d : ring k} (ha : a ∈ bisym k) (hb : b ∈ bisym k)
    (hc : c ∈ bisym k) (hd : d ∈ bisym k)
    (h : swapU k (a + b * u₁ k + c * v₁ k + d * (u₁ k * v₁ k)) =
      a + b * u₁ k + c * v₁ k + d * (u₁ k * v₁ k)) : b = 0 ∧ d = 0 := by
  simp only [map_add, map_mul, swapU_bisym ha, swapU_bisym hb, swapU_bisym hc, swapU_bisym hd,
    swapU_u₁, swapU_v₁] at h
  have h1 : (b + d * v₁ k) * (u₁ k - u₂ k) = 0 := by linear_combination -h
  have h2 := (mul_eq_zero.mp h1).resolve_right u₁_sub_u₂_ne_zero
  have hd0 := eq_zero_of_swapV_eq hb hd (by rw [h2, map_zero])
  exact ⟨by simpa [hd0] using h2, hd0⟩

/-- `b + d v₁ = 0` with `b, d ∈ B₀` forces `b = d = 0`. -/
theorem eq_zero_of_add_mul_v₁ {b d : ring k} (hb : b ∈ bisym k) (hd : d ∈ bisym k)
    (h : b + d * v₁ k = 0) : b = 0 ∧ d = 0 := by
  have hd' : d = 0 := eq_zero_of_swapV_eq hb hd (by rw [h, map_zero])
  exact ⟨by simpa [hd'] using h, hd'⟩

/-- **Independence.** `a + b u₁ + c v₁ + d u₁v₁ = 0` with `a, b, c, d ∈ B₀` forces
`a = b = c = d = 0`. -/
theorem eq_zero_of_span_eq_zero {a b c d : ring k} (ha : a ∈ bisym k) (hb : b ∈ bisym k)
    (hc : c ∈ bisym k) (hd : d ∈ bisym k)
    (h : a + b * u₁ k + c * v₁ k + d * (u₁ k * v₁ k) = 0) :
    a = 0 ∧ b = 0 ∧ c = 0 ∧ d = 0 := by
  obtain ⟨rfl, rfl⟩ := eq_zero_of_swapU_eq ha hb hc hd (by rw [h, map_zero])
  have h2 : a + c * v₁ k = 0 := by linear_combination h
  obtain ⟨rfl, rfl⟩ := eq_zero_of_add_mul_v₁ ha hc h2
  exact ⟨rfl, rfl, rfl, rfl⟩

/-- An element fixed by both partial swaps lies in `B₀`. -/
theorem mem_bisym_of_swap {t : ring k} (hU : swapU k t = t) (hV : swapV k t = t) :
    t ∈ bisym k := by
  obtain ⟨a, ha, b, hb, c, hc, d, hd, rfl⟩ := isSpanned t
  obtain ⟨rfl, rfl⟩ := eq_zero_of_swapU_eq ha hb hc hd hU
  have hc0 := eq_zero_of_swapV_eq ha hc (by simpa only [zero_mul, add_zero] using hV)
  rw [hc0]
  simpa using ha

/-! ### Primality of `v₁ + v₂` -/

/-- `v₁ + v₂` is a prime element of `k[u₁, u₂, v₁, v₂]`. -/
theorem prime_q : Prime (v₁ k + v₂ k) := by
  classical
  let φ : ring k →ₐ[k] ring k := aeval fun ij => if ij = (1, 0) then X (1, 0) + X (1, 1) else X ij
  let ψ : ring k →ₐ[k] ring k := aeval fun ij => if ij = (1, 0) then X (1, 0) - X (1, 1) else X ij
  have hcomp : φ.comp ψ = AlgHom.id k _ ∧ ψ.comp φ = AlgHom.id k _ := by
    constructor <;>
    · apply MvPolynomial.algHom_ext
      intro ij
      by_cases h : ij = (1, 0)
      · subst h; simp [φ, ψ]
      · simp [φ, ψ, h]
  let e : ring k ≃ₐ[k] ring k := AlgEquiv.ofAlgHom φ ψ hcomp.1 hcomp.2
  exact (show e (X (1, 0)) = v₁ k + v₂ k by simp [e, φ]) ▸ (MulEquiv.prime_iff e).2 X_prime

/-- `v₁ + v₂` does not divide `u₁ + u₂`. -/
theorem q_not_dvd_p : ¬ (v₁ k + v₂ k ∣ u₁ k + u₂ k) := by
  classical
  rintro ⟨r, hr⟩
  have h := congrArg (eval fun ij : Fin 2 × Fin 2 => if ij = (0, 0) then (1 : k) else 0) hr
  simp at h

/-! ### The invariants -/

variable [CharP k 2]

/-- **The invariants of the swap.** In characteristic `2`, an element of `k[u₁, u₂, v₁, v₂]` is
fixed by the involution exchanging the two factors exactly when it lies in
`k[u₁ + u₂, u₁u₂, v₁ + v₂, v₁v₂, u₁v₁ + u₂v₂]`. -/
@[stacks 0H5Y "Sym²(X) = W/⟨σ⟩ is the spectrum of k[u₁ + u₂, u₁u₂, v₁ + v₂, v₁v₂, u₁v₁ + u₂v₂]"]
theorem mem_sym_iff (x : ring k) : x ∈ sym k ↔ swap k x = x := by
  refine ⟨swap_sym, fun hx => ?_⟩
  have h2 : (2 : ring k) = 0 := by
    have h := congrArg (algebraMap k (ring k)) (CharTwo.two_eq_zero (R := k))
    rwa [map_ofNat, map_zero] at h
  obtain ⟨a, ha, b, hb, c, hc, d, hd, rfl⟩ := isSpanned x
  have hsw : ∀ {y : ring k}, y ∈ bisym k → swap k y = y := fun hy => swap_sym (bisym_le_sym k hy)
  have hx' := hx
  simp only [map_add, map_mul, hsw ha, hsw hb, hsw hc, hsw hd, swap_u₁, swap_v₁] at hx'
  have key : (b * (u₁ k + u₂ k) + c * (v₁ k + v₂ k) + d * ((u₁ k + u₂ k) * (v₁ k + v₂ k))) +
      (-(2 * b) - d * (v₁ k + v₂ k)) * u₁ k + (-(2 * c) - d * (u₁ k + u₂ k)) * v₁ k +
      0 * (u₁ k * v₁ k) = 0 := by linear_combination hx'
  have hmem2 : (2 : ring k) ∈ bisym k := by
    rw [h2]
    exact zero_mem _
  obtain ⟨hA, hB, -, -⟩ := eq_zero_of_span_eq_zero
    (add_mem (add_mem (mul_mem hb p_mem_bisym) (mul_mem hc q_mem_bisym))
      (mul_mem hd (mul_mem p_mem_bisym q_mem_bisym)))
    (sub_mem (neg_mem (mul_mem hmem2 hb)) (mul_mem hd q_mem_bisym))
    (sub_mem (neg_mem (mul_mem hmem2 hc)) (mul_mem hd p_mem_bisym)) (zero_mem _) key
  have hq0 : v₁ k + v₂ k ≠ 0 := prime_q.ne_zero
  have hd0 : d = 0 := by
    have : d * (v₁ k + v₂ k) = 0 := by linear_combination -hB - b * h2
    exact (mul_eq_zero.mp this).resolve_right hq0
  subst hd0
  have hdvd : v₁ k + v₂ k ∣ b * (u₁ k + u₂ k) := ⟨-c, by linear_combination hA⟩
  obtain ⟨t, rfl⟩ := (prime_q.dvd_or_dvd hdvd).resolve_right q_not_dvd_p
  have hct : c = -(t * (u₁ k + u₂ k)) := by
    have : (v₁ k + v₂ k) * (c + t * (u₁ k + u₂ k)) = 0 := by linear_combination hA
    linear_combination (mul_eq_zero.mp this).resolve_left hq0
  subst hct
  have htU : swapU k t = t := by
    have h := swapU_bisym hb
    rw [map_mul, map_add, swapU_v₁, swapU_v₂] at h
    exact mul_left_cancel₀ hq0 h
  have htV : swapV k t = t := by
    have h := swapV_bisym hb
    rw [map_mul, map_add, swapV_v₁, swapV_v₂, add_comm (v₂ k)] at h
    exact mul_left_cancel₀ hq0 h
  have ht := mem_bisym_of_swap htU htV
  have heq : a + (v₁ k + v₂ k) * t * u₁ k + -(t * (u₁ k + u₂ k)) * v₁ k + 0 * (u₁ k * v₁ k) =
      a + t * ((u₁ k + u₂ k) * (v₁ k + v₂ k) + (u₁ k * v₁ k + u₂ k * v₂ k)) := by
    linear_combination (-(t * (u₁ k * v₁ k + u₂ k * v₁ k + u₂ k * v₂ k))) * h2
  rw [heq]
  exact add_mem (bisym_le_sym k ha) (mul_mem (bisym_le_sym k ht)
    (add_mem (mul_mem (bisym_le_sym k p_mem_bisym) (bisym_le_sym k q_mem_bisym)) h_mem_sym))

end Stacks.Chow.SymPlane

