module

public import Mathlib.Algebra.CharP.Algebra
public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.RingTheory.Localization.FractionRing
public import StacksFrontier.AlgebraicGeometry.Chow.RelativeCycles.SymmetricSquarePlaneRing

/-!
# The function field of the plane over the field of squares of its coordinates

Let `k` be a field of characteristic `2`, let `L = k(u, v)` be the function field of `A²` and let
`K₀ = k(u², v²) ⊆ L`. The extension `L/K₀` is finite, generated by `u` and `v`, and of degree at
least `3`, the elements `1, u, v` being independent over `K₀`: in characteristic `2` the partial
derivatives `∂/∂u` and `∂/∂v` vanish on `k[u², v²]`. The ring map `k[u₁, u₂, v₁, v₂] → L` sending
both copies of the coordinates to `(u, v)`, which is the generic point of the diagonal of
`A² × A²`, carries the coordinate ring of `Sym²(A²)` into `K₀`.

This is the field theory behind the characteristic `2` example of Stacks Remark 0H5Y: the generic
point of the image of the diagonal in `Sym²(A²)` has residue field `k(u², v²)`, over which the
generic point of the diagonal has residue field `k(u, v)`, purely inseparable of degree `4`.

## Main definitions

* `Stacks.Chow.SymPlane.funField` — the field `L = k(u, v)`.
* `Stacks.Chow.SymPlane.squareField` — the subfield `K₀ = k(u², v²)`.
* `Stacks.Chow.SymPlane.diagonalPoint` — the ring map `k[u₁, u₂, v₁, v₂] → L`, `uᵢ ↦ u`,
  `vᵢ ↦ v`.

## Main results

* `Stacks.Chow.SymPlane.adjoin_squareField_eq_top` — `L = K₀(u, v)`.
* `Stacks.Chow.SymPlane.three_le_finrank_squareField` — `[L : K₀] ≥ 3`.
* `Stacks.Chow.SymPlane.diagonalPoint_mem_squareField` — the image of `Sym²(A²)` lies in `K₀`.

## References

* [Stacks Project, Remark 0H5Y](https://stacks.math.columbia.edu/tag/0H5Y)
-/

@[expose] public noncomputable section

open MvPolynomial

universe u

namespace Stacks.Chow.SymPlane

variable (k : Type u) [Field k]

/-- The function field `k(u, v)` of the plane. -/
abbrev funField : Type u := FractionRing (MvPolynomial (Fin 2) k)

/-- The coordinate `u` of the plane, in its function field. -/
abbrev fu : funField k := algebraMap (MvPolynomial (Fin 2) k) (funField k) (X 0)

/-- The coordinate `v` of the plane, in its function field. -/
abbrev fv : funField k := algebraMap (MvPolynomial (Fin 2) k) (funField k) (X 1)

/-- The field `k(u², v²)` of rational functions in the squares of the coordinates. -/
def squareField : IntermediateField k (funField k) :=
  IntermediateField.adjoin k {fu k ^ 2, fv k ^ 2}

/-- The square `u²` lies in `k(u², v²)`. -/
theorem fu_sq_mem : fu k ^ 2 ∈ squareField k := IntermediateField.subset_adjoin _ _ (by simp)

/-- The square `v²` lies in `k(u², v²)`. -/
theorem fv_sq_mem : fv k ^ 2 ∈ squareField k := IntermediateField.subset_adjoin _ _ (by simp)

/-- The function field is generated over `k(u², v²)` by `u` and `v`. -/
theorem adjoin_squareField_eq_top :
    IntermediateField.adjoin (squareField k) {fu k, fv k} = ⊤ := by
  rw [eq_top_iff]
  intro x _
  set F := IntermediateField.adjoin (squareField k) {fu k, fv k}
  have hA : ∀ p : MvPolynomial (Fin 2) k,
      algebraMap (MvPolynomial (Fin 2) k) (funField k) p ∈ F := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
      have : algebraMap (MvPolynomial (Fin 2) k) (funField k) (C a) =
          algebraMap (squareField k) (funField k) (algebraMap k (squareField k) a) := by
        rw [← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply,
          ← IsScalarTower.algebraMap_apply]
      rw [this]
      exact F.algebraMap_mem _
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | mul_X p i hp =>
      rw [map_mul]
      refine mul_mem hp ?_
      fin_cases i
      all_goals exact IntermediateField.subset_adjoin _ _ (by simp)
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := MvPolynomial (Fin 2) k) x
  exact div_mem (hA a) (hA b)

/-- The function field is finite over `k(u², v²)`. -/
instance finiteDimensional_squareField : FiniteDimensional (squareField k) (funField k) := by
  have hint : ∀ x ∈ ({fu k, fv k} : Set (funField k)), IsIntegral (squareField k) x := by
    intro x hx
    have hsq : ∀ y : funField k, y ^ 2 ∈ squareField k → IsIntegral (squareField k) y := by
      intro y hy
      refine ⟨Polynomial.X ^ 2 - Polynomial.C ⟨y ^ 2, hy⟩, ?_, ?_⟩
      · exact Polynomial.monic_X_pow_sub_C _ two_ne_zero
      · simp
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact hsq _ (fu_sq_mem k)
    · exact hsq _ (fv_sq_mem k)
  have hfin := IntermediateField.finiteDimensional_adjoin hint
  rw [adjoin_squareField_eq_top] at hfin
  exact (IntermediateField.topEquiv (F := squareField k)
    (E := funField k)).toLinearEquiv.finiteDimensional


/-! ### Independence of `1, u, v` over `k(u², v²)` in characteristic `2` -/

variable [CharP k 2]

/-- If `k` has characteristic `2`, so does the function field `k(u, v)`. -/
instance charP_funField : CharP (funField k) 2 :=
  charP_of_injective_algebraMap (algebraMap k (funField k)).injective 2

/-- In characteristic `2` the partial derivatives vanish on `k[u², v²]`. -/
theorem pderiv_eq_zero_of_mem_adjoin_sq (i : Fin 2) {P : MvPolynomial (Fin 2) k}
    (hP : P ∈ Algebra.adjoin k {(X 0 : MvPolynomial (Fin 2) k) ^ 2, X 1 ^ 2}) :
    pderiv i P = 0 := by
  have h2 : (2 : MvPolynomial (Fin 2) k) = 0 := by
    have h := congrArg (algebraMap k (MvPolynomial (Fin 2) k)) (CharTwo.two_eq_zero (R := k))
    rwa [map_ofNat, map_zero] at h
  induction hP using Algebra.adjoin_induction with
  | mem x hx =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl <;>
    · rw [Derivation.leibniz_pow]
      simp [nsmul_eq_mul, h2]
  | algebraMap r => exact (pderiv i).map_algebraMap r
  | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
  | mul x y _ _ hx hy => rw [Derivation.leibniz, hx, hy, smul_zero, smul_zero, add_zero]

omit [CharP k 2] in
/-- `k[u², v²] ⊆ L` is the image of `k[X₀², X₁²]`. -/
theorem adjoin_sq_eq_map :
    Algebra.adjoin k {fu k ^ 2, fv k ^ 2} =
      (Algebra.adjoin k {(X 0 : MvPolynomial (Fin 2) k) ^ 2, X 1 ^ 2}).map
        (IsScalarTower.toAlgHom k (MvPolynomial (Fin 2) k) (funField k)) := by
  rw [AlgHom.map_adjoin]
  congr 1
  simp [Set.image_insert_eq]

omit [CharP k 2] in
/-- Every element of `k(u², v²)` becomes an element of `k[u², v²]` after multiplication by a
nonzero element of `k[u², v²]`. -/
theorem exists_mul_mem_adjoin_sq {x : funField k} (hx : x ∈ squareField k) :
    ∃ s ∈ Algebra.adjoin k {fu k ^ 2, fv k ^ 2}, s ≠ 0 ∧
      s * x ∈ Algebra.adjoin k {fu k ^ 2, fv k ^ 2} := by
  obtain ⟨r, hr, s, hs, rfl⟩ := (IntermediateField.mem_adjoin_iff_div).mp hx
  by_cases h0 : s = 0
  · exact ⟨1, one_mem _, one_ne_zero, by simp [h0]⟩
  · exact ⟨s, hs, h0, by rwa [mul_div_cancel₀ _ h0]⟩

/-- **`1, u, v` are independent over `k(u², v²)`** in characteristic `2`. -/
theorem eq_zero_of_add_mul_fu_add_mul_fv {c₀ c₁ c₂ : funField k} (h₀ : c₀ ∈ squareField k)
    (h₁ : c₁ ∈ squareField k) (h₂ : c₂ ∈ squareField k)
    (h : c₀ + c₁ * fu k + c₂ * fv k = 0) : c₀ = 0 ∧ c₁ = 0 ∧ c₂ = 0 := by
  obtain ⟨s₀, hs₀, hs₀0, hm₀⟩ := exists_mul_mem_adjoin_sq k h₀
  obtain ⟨s₁, hs₁, hs₁0, hm₁⟩ := exists_mul_mem_adjoin_sq k h₁
  obtain ⟨s₂, hs₂, hs₂0, hm₂⟩ := exists_mul_mem_adjoin_sq k h₂
  set D := s₀ * s₁ * s₂
  have hD0 : D ≠ 0 := mul_ne_zero (mul_ne_zero hs₀0 hs₁0) hs₂0
  have lift : ∀ {a s c : funField k}, a ∈ Algebra.adjoin k {fu k ^ 2, fv k ^ 2} →
      s ∈ Algebra.adjoin k {fu k ^ 2, fv k ^ 2} →
      s * c ∈ Algebra.adjoin k {fu k ^ 2, fv k ^ 2} → a * s = D →
      ∃ P ∈ Algebra.adjoin k {(X 0 : MvPolynomial (Fin 2) k) ^ 2, X 1 ^ 2},
        algebraMap _ (funField k) P = D * c := by
    intro a s c ha hs hsc hD
    obtain ⟨P, hP, e⟩ := (adjoin_sq_eq_map k ▸ mul_mem ha hsc : _ ∈ Subalgebra.map _ _)
    exact ⟨P, hP, by rw [← hD, mul_assoc]; exact e⟩
  obtain ⟨P₀, hP₀, hP₀e⟩ := lift (mul_mem hs₁ hs₂) hs₀ hm₀ (by ring)
  obtain ⟨P₁, hP₁, hP₁e⟩ := lift (mul_mem hs₀ hs₂) hs₁ hm₁ (by ring)
  obtain ⟨P₂, hP₂, hP₂e⟩ := lift (mul_mem hs₀ hs₁) hs₂ hm₂ (by ring)
  have hinj := IsFractionRing.injective (MvPolynomial (Fin 2) k) (funField k)
  have hP : P₀ + P₁ * X 0 + P₂ * X 1 = 0 := by
    apply hinj
    rw [map_add, map_add, map_mul, map_mul, hP₀e, hP₁e, hP₂e, map_zero]
    linear_combination D * h
  have hd₀ := congrArg (pderiv 0) hP
  have hd₁ := congrArg (pderiv 1) hP
  simp only [map_add, Derivation.leibniz, pderiv_eq_zero_of_mem_adjoin_sq k _ hP₀,
    pderiv_eq_zero_of_mem_adjoin_sq k _ hP₁, pderiv_eq_zero_of_mem_adjoin_sq k _ hP₂,
    pderiv_X_self, map_zero, smul_eq_mul, mul_one] at hd₀ hd₁
  rw [pderiv_X_of_ne (by decide)] at hd₀
  rw [pderiv_X_of_ne (by decide)] at hd₁
  simp only [mul_zero, zero_add, add_zero] at hd₀ hd₁
  subst hd₀ hd₁
  have hP₀0 : P₀ = 0 := by simpa using hP
  subst hP₀0
  have z : ∀ {P : MvPolynomial (Fin 2) k} {c : funField k}, P = 0 →
      algebraMap _ (funField k) P = D * c → c = 0 := by
    rintro P c rfl e
    simpa [hD0] using e.symm
  exact ⟨z rfl hP₀e, z rfl hP₁e, z rfl hP₂e⟩

/-- **`[k(u, v) : k(u², v²)] ≥ 3`** in characteristic `2`. -/
theorem three_le_finrank_squareField : 3 ≤ Module.finrank (squareField k) (funField k) := by
  have hli : LinearIndependent (squareField k) ![(1 : funField k), fu k, fv k] := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    simp only [Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons] at hg
    rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, mul_one] at hg
    obtain ⟨e₀, e₁, e₂⟩ := eq_zero_of_add_mul_fu_add_mul_fv k (g 0).2 (g 1).2 (g 2).2 hg
    intro i
    fin_cases i
    · exact Subtype.ext e₀
    · exact Subtype.ext e₁
    · exact Subtype.ext e₂
  simpa using hli.fintype_card_le_finrank

/-! ### The generic point of the diagonal of `A² × A²` -/

/-- The ring map `k[u₁, u₂, v₁, v₂] → k(u, v)`, `uᵢ ↦ u`, `vᵢ ↦ v`: the generic point of the
diagonal of `A² × A²`. -/
def diagonalPoint : ring k →ₐ[k] funField k :=
  aeval fun ij => if ij.1 = 0 then fu k else fv k

omit [CharP k 2] in
/-- The generic point of the diagonal is fixed by the involution exchanging the factors. -/
theorem diagonalPoint_comp_swap :
    (diagonalPoint k).comp (swap k).toAlgHom = diagonalPoint k := by
  apply MvPolynomial.algHom_ext
  intro ij
  simp [diagonalPoint, swap]

/-- **The coordinate ring of `Sym²(A²)` is carried into `k(u², v²)`** by the generic point of the
diagonal: its generators go to `2u = 0`, `u²`, `2v = 0`, `v²` and `2uv = 0`. -/
theorem diagonalPoint_mem_squareField {x : ring k} (hx : x ∈ sym k) :
    diagonalPoint k x ∈ squareField k := by
  have h2 : (2 : funField k) = 0 := CharTwo.two_eq_zero
  have hle : sym k ≤ (squareField k).toSubalgebra.comap (diagonalPoint k) := by
    apply Algebra.adjoin_le
    intro y hy
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
    simp only [Subalgebra.coe_comap, Set.mem_preimage]
    rcases hy with rfl | rfl | rfl | rfl | rfl
    · have : diagonalPoint k (u₁ k + u₂ k) = 0 := by
        simp [diagonalPoint]; linear_combination fu k * h2
      rw [this]; exact zero_mem _
    · have : diagonalPoint k (u₁ k * u₂ k) = fu k ^ 2 := by simp [diagonalPoint, sq]
      rw [this]; exact fu_sq_mem k
    · have : diagonalPoint k (v₁ k + v₂ k) = 0 := by
        simp [diagonalPoint]; linear_combination fv k * h2
      rw [this]; exact zero_mem _
    · have : diagonalPoint k (v₁ k * v₂ k) = fv k ^ 2 := by simp [diagonalPoint, sq]
      rw [this]; exact fv_sq_mem k
    · have : diagonalPoint k (u₁ k * v₁ k + u₂ k * v₂ k) = 0 := by
        simp [diagonalPoint]; linear_combination fu k * fv k * h2
      rw [this]; exact zero_mem _
  exact hle hx

end Stacks.Chow.SymPlane

end
