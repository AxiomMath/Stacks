/-!
# Families of cycles on the fibres of a morphism

Let `f : X ⟶ S` be a morphism of schemes locally of finite type and let `r ≥ 0`. Each
scheme-theoretic fibre `X_s` is locally of finite type over the residue field `κ(s)`, so it
carries the group `Z_r(X_s)` of `r`-cycles of Chow homology for the Chow situation on
`Spec κ(s)`. A *family of `r`-cycles on the fibres of `X/S`* is a choice of an element of
`Z_r(X_s)` for every point `s` of `S`, and its *support* is the union in `X` of the images of
the supports of its members.

The support of such a family is rarely closed in `X`.

## Main definitions

* `Stacks.Chow.FiberCycleGroup` — the group of `r`-cycles on a scheme-theoretic fibre.
* `Stacks.Chow.FamilyOfCycles` — a family of `r`-cycles on the fibres of `f`.
* `Stacks.Chow.supportOfFamily` — the support of such a family, as a subset of `X`.

## Main results

* `Stacks.Chow.fieldChowSituation_dimensionFunction_eq_zero` — the dimension function of the
  Chow situation on a field spectrum is zero.
* `Stacks.Chow.mem_supportOfFamily` — a point lies in the support exactly when it is the image
  of a point of the support of the cycle on its fibre.

## Implementation notes

The Chow situation on the spectrum of a field is `Stacks.Chow.fieldChowSituation`, and cycles on
a fibre are `Stacks.Chow.CycleGroup` for that situation. The dimension `r` of a family is a
natural number, cast to `ℤ` where the Chow vocabulary expects an integer grading.

## References

* [Stacks Project, Tag 0H4U](https://stacks.math.columbia.edu/tag/0H4U)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Chow

/-! ### The Chow situation attached to a field -/

/-- The dimension function of the Chow situation on the spectrum of a field vanishes. -/
@[simp]
theorem fieldChowSituation_dimensionFunction_eq_zero (k : Type u) [Field k]
    (x : Spec (.of k)) : (fieldChowSituation k).dimensionFunction x = 0 :=
  rfl

/-- A field extension generated by the image of the base field has transcendence degree zero. -/
theorem trdeg_zero_of_surjective_algebraMap (K L : Type u) [Field K] [Field L] [Algebra K L]
    (h : Function.Surjective (algebraMap K L)) : Algebra.trdeg K L = 0 := by
  rw [trdeg_eq_zero_iff, Algebra.isAlgebraic_def]
  intro x
  obtain ⟨a, ha⟩ := h x
  exact ⟨Polynomial.X - Polynomial.C a, Polynomial.X_sub_C_ne_zero a, by simp [ha]⟩

/-! ### Families of cycles on fibres -/

/-- The group of `r`-cycles on the scheme-theoretic fibre of `f` over `s`, taken for the Chow
situation on the spectrum of the residue field `κ(s)`. -/
abbrev FiberCycleGroup {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f] (s : S)
    (r : ℕ) : Type u :=
  letI : LocallyOfFiniteType (f.fiberToSpecResidueField s) := by
    change LocallyOfFiniteType (pullback.snd f (S.fromSpecResidueField s))
    infer_instance
  CycleGroup (fieldChowSituation (S.residueField s)) (f.fiberToSpecResidueField s) (r : ℤ)

/-- A family of `r`-cycles on the fibres of `f`: an `r`-cycle on the scheme-theoretic fibre
over each point of the base. -/
abbrev FamilyOfCycles {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f] (r : ℕ) : Type u :=
  ∀ s : S, FiberCycleGroup f s r

/-- The support of a family of cycles on the fibres of `f`: the union in `X` of the images of the
supports of its members. -/
@[stacks 0H4U "support_of_a_family_of_cycles"]
def supportOfFamily {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f] {r : ℕ}
    (α : FamilyOfCycles f r) : Set X :=
  ⋃ s : S, (f.fiberι s) '' tsupport (α s : AlgebraicCycle (f.fiber s) ℤ)

/-- A point lies in the support of a family of cycles exactly when it is the image of a point
of the support of the cycle on the fibre through it. -/
@[simp]
theorem mem_supportOfFamily {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f] {r : ℕ}
    (α : FamilyOfCycles f r) (x : X) :
    x ∈ supportOfFamily f α ↔
      ∃ (s : S) (y : f.fiber s),
        y ∈ tsupport (α s : AlgebraicCycle (f.fiber s) ℤ) ∧ f.fiberι s y = x := by
  simp [supportOfFamily]

end Stacks.Chow
