module

public import Mathlib.Algebra.Module.LocalizedModule.AtPrime
public import Mathlib.LinearAlgebra.Isomorphisms
public import Mathlib.RingTheory.KrullDimension.Module
public import Mathlib.RingTheory.Length
public import Mathlib.RingTheory.OrderOfVanishing.Basic
public import Mathlib.RingTheory.QuotSMulTop
public import StacksFrontier.RingTheory.Length.Additivity
public import StacksFrontier.RingTheory.Support.Finite

/-!
# Supports, lengths and orders of vanishing in low dimension

Facts about the support of a finite module over a Noetherian local ring that are needed to
compute multiplicities: which points of the support are minimal, when there are finitely many
of them, when the module has finite length, and the identification of the order of vanishing of
a ring element with the length of a quotient.

## Main results

* `AlgebraicGeometry.minimal_support_iff` and `AlgebraicGeometry.minimal_support_eq_nonclosed`
  describe the minimal points of a support.
* `AlgebraicGeometry.finite_minimal_support` and `AlgebraicGeometry.finite_nonclosed_support`
  are the two finiteness statements.
* `AlgebraicGeometry.finite_length_of_supportDim_le_zero` and
  `AlgebraicGeometry.localized_length_ne_top` are the two finite-length statements.
* `AlgebraicGeometry.ord_quotient_eq_length` identifies an order of vanishing with a length.

## Implementation notes

The dimension of a module's support is `Module.supportDim`, the Krull dimension of the support
viewed as an ordered subset of the prime spectrum; `Module.quotSMulTop` writes `M / xM`.
Localization at a point `q` is `Localization.AtPrime q.asIdeal` acting on
`LocalizedModule q.asIdeal.primeCompl M`.

## References

* [Stacks Project, Tag 02QF](https://stacks.math.columbia.edu/tag/02QF)
* [Stacks Project, Tag 02QG](https://stacks.math.columbia.edu/tag/02QG)
-/

@[expose] public section

open scoped Pointwise

namespace AlgebraicGeometry

/-- The quotient of `R ⧸ I` by `x` is the quotient of `R` by the ideal generated by `x`
together with `I`. -/
public noncomputable def quotSMulTopQuotientEquiv {R : Type*} [CommRing R] (x : R) (I : Ideal R) :
    QuotSMulTop x (R ⧸ I) ≃ₗ[R] R ⧸ (Ideal.span {x} ⊔ I) := by
  refine (Submodule.quotEquivOfEq _ (Submodule.map I.mkQ (Ideal.span {x})) ?_).trans
    ((Submodule.quotientQuotientEquivQuotientSup I (Ideal.span {x})).trans
      (Submodule.quotEquivOfEq _ _ (sup_comm _ _)))
  rw [Submodule.map_span, Set.image_singleton]
  ext y
  simp only [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top, true_and,
    Submodule.mem_span_singleton]
  constructor
  · rintro ⟨b, rfl⟩
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
    exact ⟨a, by simp [Algebra.smul_def, mul_comm]⟩
  · rintro ⟨a, rfl⟩
    exact ⟨Ideal.Quotient.mk I a, by simp [Algebra.smul_def, mul_comm]⟩

/-- A point is minimal in the support of a finite module exactly when its prime is a
minimal prime over the annihilator. -/
public lemma minimal_support_iff {R M : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] [Module.Finite R M] (q : PrimeSpectrum R) :
    Minimal (· ∈ Module.support R M) q ↔ q.asIdeal ∈ (Module.annihilator R M).minimalPrimes := by
  rw [Module.support_eq_zeroLocus]
  show Minimal (fun p : PrimeSpectrum R ↦ Module.annihilator R M ≤ p.asIdeal) q ↔
    Minimal (fun J : Ideal R ↦ J.IsPrime ∧ Module.annihilator R M ≤ J) q.asIdeal
  exact ⟨fun hq ↦ ⟨⟨q.isPrime, hq.1⟩, fun p hp hpq ↦ hq.2 (y := ⟨p, hp.1⟩) hp.2 hpq⟩,
    fun hq ↦ ⟨hq.1.2, fun r hr hrq ↦ hq.2 ⟨r.isPrime, hr⟩ hrq⟩⟩

/-- A finite module over a Noetherian ring has finitely many minimal points in its support. -/
public lemma finite_minimal_support {R M : Type*} [CommRing R] [IsNoetherianRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M] :
    {q : PrimeSpectrum R | Minimal (· ∈ Module.support R M) q}.Finite := by
  simp_rw [minimal_support_iff]
  exact (Ideal.finite_minimalPrimes_of_isNoetherianRing R _).preimage
    (fun _ _ _ _ h => PrimeSpectrum.ext h)

/-- At a minimal point of its support, a finite module over a Noetherian ring localizes to
a module of finite length. -/
public lemma localized_length_ne_top {R M : Type*} [CommRing R] [IsNoetherianRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (q : PrimeSpectrum R) (hq : Minimal (· ∈ Module.support R M) q) :
    Module.length (Localization.AtPrime q.asIdeal)
      (LocalizedModule q.asIdeal.primeCompl M) ≠ ⊤ := by
  obtain ⟨s, hbot, htop⟩ := IsNoetherianRing.exists_relSeries_isQuotientEquivQuotientPrime R M
  choose p hp using fun i => (s.step i).2
  rw [← (Module.setOf_minimal_range_eq_setOf_minimal_support_and_ncard_eq_length
    s p (fun i => (s.step i).1) hp hbot htop).2 q hq]
  exact ENat.natCast_ne_top _

/-- Over a local ring, a nonclosed point of the support of a module lies strictly below the
closed point, which is also in the support. -/
private theorem support_lt_closedPoint {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] {q : PrimeSpectrum R} (hq : q ∈ Module.support R M)
    (hne : q ≠ IsLocalRing.closedPoint R) :
    (⟨q, hq⟩ : Module.support R M) < ⟨IsLocalRing.closedPoint R, Module.mem_support_mono
      (IsLocalRing.le_maximalIdeal q.isPrime.ne_top) hq⟩ :=
  lt_of_le_of_ne (IsLocalRing.le_maximalIdeal q.isPrime.ne_top)
    fun he => hne (congrArg Subtype.val he)

/-- Over a local ring, a nonclosed point of a module whose support has dimension at most
one is minimal in that support. -/
public lemma minimal_of_mem_support_ne_closed
    {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] (hM : Module.supportDim R M ≤ 1)
    (q : PrimeSpectrum R) (hq : q ∈ Module.support R M)
    (hne : q ≠ IsLocalRing.closedPoint R) :
    Minimal (· ∈ Module.support R M) q := by
  rcases Order.krullDim_le_one_iff.mp hM (⟨q, hq⟩ : Module.support R M) with
    hmin | hmax
  · exact ⟨hq, fun p hp hpq =>
      hmin (show (⟨p, hp⟩ : Module.support R M) ≤ ⟨q, hq⟩ from hpq)⟩
  · exact (not_isMax_of_lt (support_lt_closedPoint hq hne) hmax).elim

/-- A finite module over a Noetherian local ring whose support has dimension at most one
has finitely many nonclosed points in its support. -/
public lemma finite_nonclosed_support
    {R M : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (hM : Module.supportDim R M ≤ 1) :
    {q : PrimeSpectrum R | q ∈ Module.support R M ∧
      q ≠ IsLocalRing.closedPoint R}.Finite :=
  (finite_minimal_support (R := R) (M := M)).subset fun q hq =>
    minimal_of_mem_support_ne_closed hM q hq.1 hq.2

/-- Over a local ring, the support of a module of support dimension zero consists of the
closed point alone. -/
public lemma eq_closed_of_mem_supportDim_le_zero
    {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M]
    (hM : Module.supportDim R M ≤ 0)
    (q : PrimeSpectrum R) (hq : q ∈ Module.support R M) :
    q = IsLocalRing.closedPoint R := by
  by_contra hne
  exact (not_lt_of_ge hM) (Order.krullDim_pos_iff.mpr ⟨_, _, support_lt_closedPoint hq hne⟩)

/-- A finite module over a Noetherian local ring whose support has dimension at most zero
has finite length. -/
public lemma finite_length_of_supportDim_le_zero {R M : Type*} [CommRing R]
    [IsNoetherianRing R] [IsLocalRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]
    (hM : Module.supportDim R M ≤ 0) : IsFiniteLength R M := by
  cases subsingleton_or_nontrivial M with
  | inl _ => exact IsFiniteLength.of_subsingleton
  | inr _ =>
    apply isFiniteLength_of_support
    ext q
    refine ⟨eq_closed_of_mem_supportDim_le_zero hM q, ?_⟩
    rintro rfl
    exact IsLocalRing.closedPoint_mem_support R M

/-- The order of vanishing of `x` on `R ⧸ I` is the length of `R ⧸ (x, I)`. -/
public lemma ord_quotient_eq_length {R : Type*} [CommRing R] (x : R) (I : Ideal R) :
    Ring.ord (R ⧸ I) (Ideal.Quotient.mk I x) =
      Module.length R (R ⧸ (Ideal.span {x} ⊔ I)) := by
  unfold Ring.ord
  rw [← Module.length_eq_of_surjective (S := R) Ideal.Quotient.mk_surjective]
  have he : Ideal.map (Ideal.Quotient.mkₐ R I) (Ideal.span {x}) =
      Ideal.span {Ideal.Quotient.mk I x} := by simp [Ideal.map_span]
  rw [← he, (DoubleQuot.quotQuotEquivQuotSupₐ R I (Ideal.span {x})).toLinearEquiv.length_eq]
  exact (Submodule.quotEquivOfEq _ _ (sup_comm I (Ideal.span {x}))).length_eq

/-- Passing to the quotient by `x` is monotone for support dimension along an inclusion of
supports. -/
public lemma supportDim_quotSMulTop_le_of_support_subset
    {R A B : Type*} [CommRing R] [AddCommGroup A] [Module R A]
    [AddCommGroup B] [Module R B] [Module.Finite R A] [Module.Finite R B]
    (x : R) (h : Module.support R A ⊆ Module.support R B) :
    Module.supportDim R (QuotSMulTop x A) ≤
      Module.supportDim R (QuotSMulTop x B) := by
  have h' : Module.support R (QuotSMulTop x A) ⊆
      Module.support R (QuotSMulTop x B) := by
    intro p hp
    rw [Module.support_quotSMulTop] at hp ⊢
    exact ⟨h hp.1, hp.2⟩
  exact Order.krullDim_le_of_strictMono
    (fun p : Module.support R (QuotSMulTop x A) =>
      (⟨p.val, h' p.property⟩ : Module.support R (QuotSMulTop x B)))
    (fun _ _ h => h)

/-- Support dimension is monotone along an inclusion of supports. -/
public lemma supportDim_le_of_support_subset {R : Type*} [CommRing R]
    {M N : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (h : Module.support R M ⊆ Module.support R N) :
    Module.supportDim R M ≤ Module.supportDim R N :=
  Order.krullDim_le_of_strictMono (fun p : Module.support R M => ⟨p.1, h p.2⟩) fun _ _ hp => hp

/-- The image of multiplication by `x` on a module is the pointwise scalar multiple of the
whole module. -/
public lemma range_lsmul_eq_smul_top {R M : Type*} [CommSemiring R]
    [AddCommMonoid M] [Module R M] (x : R) :
    LinearMap.range (LinearMap.lsmul R M x) = x • (⊤ : Submodule R M) := by
  ext y
  constructor
  · rintro ⟨z, rfl⟩
    exact Submodule.smul_mem_pointwise_smul z x ⊤ Submodule.mem_top
  · intro hy
    obtain ⟨z, hz, rfl⟩ :=
      (Submodule.mem_smul_pointwise_iff_exists y x (⊤ : Submodule R M)).mp hy
    exact ⟨z, by simp [LinearMap.lsmul_apply]⟩

/-- Over a local ring, the minimal points in the support of a module whose support has
dimension exactly one are the nonclosed points of that support. -/
public lemma minimal_support_eq_nonclosed {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] (hM : Module.supportDim R M = 1) :
    {q : PrimeSpectrum R | Minimal (· ∈ Module.support R M) q} =
      {q : PrimeSpectrum R | q ∈ Module.support R M ∧ q ≠ IsLocalRing.closedPoint R} := by
  have hle (q : PrimeSpectrum R) : q ≤ IsLocalRing.closedPoint R :=
    IsLocalRing.le_maximalIdeal q.isPrime.ne_top
  ext q
  refine ⟨fun ⟨hq, hmin⟩ => ⟨hq, fun heq => ?_⟩,
    fun h => minimal_of_mem_support_ne_closed hM.le q h.1 h.2⟩
  have hpos : 0 < Order.krullDim (Module.support R M) := by
    show 0 < Module.supportDim R M
    rw [hM]
    norm_num
  obtain ⟨a, b, hab⟩ := Order.krullDim_pos_iff.mp hpos
  have hqa := hmin a.property (heq ▸ hle a.val)
  exact (not_lt_of_ge (show b ≤ a from (hle b.val).trans (heq ▸ hqa))) hab

end AlgebraicGeometry
