/-!
# Power sums of Chern classes

Let `X` be locally of finite type over the base of chapter 42. For a finite locally free
`𝒪_X`-module `ℰ` of constant rank `r` the *power sums* of [Stacks, Tag 0F9B] are

  `P_p(ℰ) = P_p(c_1(ℰ), …, c_p(ℰ)) ∈ A^p(X)`,

for the universal polynomials `P_p ∈ ℤ[c_1, c_2, …]` of Newton
(`AlgebraicGeometry.powerSumPolynomial`), and `P_0(ℰ) = r`. The Chern classes of `X` do not
obviously lie in a commutative ring, but they commute with each other degree by degree — the
displayed identity of [Stacks, Tag 02UA], `Stacks.Chow.GenuineChern.chernCap_chernCap_comm` — so
the subring of `∏_p A^p(X)` they generate is commutative (`Stacks.Chow.chernRing`), and `P_p` is
evaluated there. The value is homogeneous of degree `p`
(`Stacks.Chow.isHomogeneous_powerSumTotal`).

The Whitney sum formula `c(ℰ) = c(ℰ₁) c(ℰ₂)` says that the Chern sequence of `ℰ` is the Cauchy
product of those of `ℰ₁` and `ℰ₂` in that commutative ring, and the power sums are additive under
Cauchy products (`AlgebraicGeometry.powerSumEval_convolution`): this is
**[Stacks, Tag 0F9C]** for modules of constant rank
(`Stacks.Chow.powerSumTotal_eq_add_of_shortExact`).

## Main definitions

* `TotalChowClass.homComponent` — the homogeneous component of a total class.
* `Stacks.Chow.chernRing` — the commutative ring generated by the Chern classes.
* `Stacks.Chow.powerSumTotal`, `Stacks.Chow.powerSumClass` — `P_p(ℰ)`.

## Main results

* `Stacks.Chow.commute_homComponent_chernFamily`, `Stacks.Chow.chernSet_commute` — the Chern
  classes of two modules commute degree by degree.
* `Stacks.Chow.powerSumTotal_eq_add_of_shortExact` — Stacks 0F9C for modules of constant rank.
* `Stacks.Chow.res_powerSumTotal` — `res_h P_p(ℰ) = P_p(h^*ℰ)`.

## References

* [Stacks Project, Tag 0F9B](https://stacks.math.columbia.edu/tag/0F9B)
* [Stacks Project, Tag 0F9C](https://stacks.math.columbia.edu/tag/0F9C)
* [Stacks Project, Tag 02UA](https://stacks.math.columbia.edu/tag/02UA)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Finset

universe u

namespace Stacks.Chow

/-! ### The Euler derivation of graded cap families -/

section Graded

variable {G : ℤ → Type*} [∀ k, AddCommGroup (G k)]

/-- The component of index `m = i + j` of a product of homogeneous elements of indices `i` and
`j`. -/
theorem gradedCap_mul_apply_of_isHomogeneous {u v : GradedCapFamily G} {i j : ℕ}
    (_hu : u.IsHomogeneous i) (hv : v.IsHomogeneous j) (k : ℤ) {m : ℕ} (hm : m = i + j)
    (x : G k) :
    (u * v) k m x = capTo u i (show k - (j : ℤ) - (i : ℤ) = k - (m : ℤ) by omega) (v k j x) := by
  subst hm
  rw [gradedCap_mul_apply, Finset.sum_eq_single j]
  · rw [convolveTerm_of_le _ _ _ (by omega), capTo_congr_index u (show i + j - j = i by omega)]
  · intro l hl hlj
    have hlm : l ≤ i + j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hl)
    rw [convolveTerm_of_le _ _ _ hlm, hv k l hlj]
    exact capTo_zero _ _ _
  · intro h
    exact absurd (Finset.mem_range.mpr (by omega)) h

end Graded

/-! ### The Chern classes of two modules commute degree by degree -/

section ChernCommute

variable (C : ChowSituation.{u}) {T : Scheme.{u}} (q : T ⟶ C.S) [LocallyOfFiniteType q]

/-- Above the rank, the homogeneous components of the total Chern class vanish. -/
theorem homComponent_chernFamily_of_lt (E : T.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] {i : ℕ}
    (hi : r < i) : homComponent i (GenuineChern.chernFamily C q E r) = 0 := by
  funext k l
  by_cases hl : l = i
  · subst hl
    rw [homComponent_apply_self]
    exact chernCapFamilyOnChow_of_gt C (GenuineChern.chernCap C) q E r k (by omega)
  · rw [homComponent_apply_of_ne hl]
    rfl

end ChernCommute

/-! ### Homogeneous components of graded cap families and of products -/

section GradedHom

variable {G : ℤ → Type*} [∀ k, AddCommGroup (G k)]

end GradedHom

namespace TotalChowClass

variable {C : ChowSituation.{u}} {X : Scheme.{u}} {sX : X ⟶ C.S} [LocallyOfFiniteType sX]

/-- Commutation of total classes, read on the operations. -/
theorem commute_of_op {c d : TotalChowClass C sX}
    (h : ∀ {T : Scheme.{u}} (g : T ⟶ X) [LocallyOfFiniteType g], Commute (c.op g) (d.op g)) :
    Commute c d :=
  ext_op fun g _ => by rw [op_mul, op_mul]; exact (h g).eq

/-- **The homogeneous component of a product**: `(a b)_n = ∑_{j ≤ n} a_{n-j} b_j`, each
summand a product of homogeneous total classes. -/
theorem homComponent_mul_sum (n : ℕ) (a b : TotalChowClass C sX) :
    TotalChowClass.homComponent n (a * b) =
      ∑ j ∈ range (n + 1),
        TotalChowClass.homComponent (n - j) a * TotalChowClass.homComponent j b :=
  ext_op fun g _ => by
    rw [TotalChowClass.op_homComponent, op_mul, op_sum, Stacks.Chow.homComponent_mul]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [op_mul, TotalChowClass.op_homComponent, TotalChowClass.op_homComponent]

/-- A total class is homogeneous of degree `i` if all of its operations are. -/
theorem isHomogeneous_of_op {i : ℕ} {c : TotalChowClass C sX}
    (h : ∀ {T : Scheme.{u}} (g : T ⟶ X) [LocallyOfFiniteType g], (c.op g).IsHomogeneous i) :
    IsHomogeneous i c :=
  fun p hp => BivariantClass.eq_of_idRule_eq C sX _ (c p) 0 fun g _ k α => by
    rw [← op_apply, h g k p hp, BivariantClass.idRule_zero]
    rfl

/-- A finite sum of total classes homogeneous of degree `i` is homogeneous of degree `i`. -/
theorem IsHomogeneous.sum {i : ℕ} {ι : Type*} {s : Finset ι} {f : ι → TotalChowClass C sX}
    (hf : ∀ t ∈ s, IsHomogeneous i (f t)) : IsHomogeneous i (∑ t ∈ s, f t) :=
  fun p hp => by
    rw [sum_apply]
    exact Finset.sum_eq_zero fun t ht => hf t ht p hp

/-- An integer multiple `n a` of a class `a` homogeneous of degree `i` is homogeneous of degree
`i`. -/
theorem isHomogeneous_intCast_mul {i : ℕ} {a : TotalChowClass C sX} (ha : IsHomogeneous i a)
    (n : ℤ) : IsHomogeneous i ((n : TotalChowClass C sX) * a) := by
  rw [← zsmul_eq_mul]
  exact ha.zsmul n

/-- A homogeneous class is its own homogeneous component. -/
theorem IsHomogeneous.homComponent_self {i : ℕ} {c : TotalChowClass C sX} (h : IsHomogeneous i c) :
    TotalChowClass.homComponent i c = c :=
  ext fun p => by
    rw [TotalChowClass.homComponent_apply]
    split_ifs with hp
    · rfl
    · exact (h p hp).symm

end TotalChowClass

/-! ### The commutative ring generated by the Chern classes -/

section ChernRing

open TotalChowClass

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

/-- The homogeneous Chern classes `c_i(ℰ) ∈ A^i(X) ⊆ ∏_p A^p(X)` of all finite locally free
modules `ℰ` of constant rank on `X`. -/
def chernSet : Set (TotalChowClass C sX) :=
  {x | ∃ (E : X.Modules) (r : ℕ)
    (_ : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r) (i : ℕ),
    x = TotalChowClass.homComponent i (totalChern C sX E r)}

/-- The homogeneous component `c_i(ℰ)` of the total Chern class of a module of constant rank
lies in `Stacks.Chow.chernSet`. -/
theorem homPart_totalChern_mem_chernSet (E : X.Modules) (r : ℕ)
    [h : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] (i : ℕ) :
    TotalChowClass.homComponent i (totalChern C sX E r) ∈ chernSet C sX :=
  ⟨E, r, h, i, rfl⟩

/-- **The Chern classes of finite locally free modules commute with each other**, degree by
degree: Stacks 02UA, `Stacks.Chow.commute_homComponent_chernFamily`, read on the operations. -/
theorem chernSet_commute : ∀ x ∈ chernSet C sX, ∀ y ∈ chernSet C sX, x * y = y * x := by
  rintro _ ⟨E, r, hE, i, rfl⟩ _ ⟨F, s, hF, j, rfl⟩
  refine (commute_of_op fun {T} g _ => ?_).eq
  let := pullbackPreservesRank_of_isFiniteLocallyFreeOfRank E r g
  let := pullbackPreservesRank_of_isFiniteLocallyFreeOfRank F s g
  rw [TotalChowClass.op_homComponent, TotalChowClass.op_homComponent, op_totalChern, op_totalChern]
  exact commute_homComponent_chernFamily C (g ≫ sX) _ r _ s i j

/-- **The ring of Chern classes of `X`**: the subring of `∏_p A^p(X)` generated by the
homogeneous Chern classes of all finite locally free modules of constant rank. It is
commutative by `Stacks.Chow.chernSet_commute`. -/
abbrev chernRing : Subring (TotalChowClass C sX) :=
  Subring.closure (chernSet C sX)

/-- The ring of Chern classes of `X` is commutative. -/
instance : CommRing (chernRing C sX) :=
  Subring.closureCommRingOfComm (chernSet_commute C sX)

/-- The sequence `1, c_1(ℰ), c_2(ℰ), …` of a module of constant rank, in the ring of Chern
classes. -/
def chernSeq (E : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] (i : ℕ) :
    chernRing C sX :=
  ⟨TotalChowClass.homComponent i (totalChern C sX E r),
    Subring.subset_closure (homPart_totalChern_mem_chernSet C sX E r i)⟩

/-- The degree-`0` part of a total Chern class is `1`. -/
theorem homPart_zero_totalChern (E : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] :
    TotalChowClass.homComponent 0 (totalChern C sX E r) = 1 :=
  ext_op fun g _ => by
    let := pullbackPreservesRank_of_isFiniteLocallyFreeOfRank E r g
    rw [TotalChowClass.op_homComponent, op_totalChern, op_one,
      homComponent_congr fun k => GenuineChern.chernFamily_apply_zero C (g ≫ sX) _ r k]
    exact GradedCapFamily.IsHomogeneous.one.homComponent_self

/-- The degree-`0` term of the Chern sequence is `1`. -/
theorem chernSeq_zero (E : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] :
    chernSeq C sX E r 0 = 1 :=
  Subtype.ext (homPart_zero_totalChern C sX E r)

end ChernRing

/-! ### Power sums of a module of constant rank -/

section PowerSum

open TotalChowClass

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

/-- **The power sum `P_p(ℰ)` of Stacks 0F9B**, as a total class, for a module of constant rank
`r`: the rank `P_0 = r` for `p = 0`, and for `p ≥ 1` the universal polynomial
`P_p(c_1(ℰ), …, c_p(ℰ))` of Stacks 0F9B (`AlgebraicGeometry.powerSumPolynomial`) evaluated in the
commutative ring of Chern classes of `X`. It is homogeneous of degree `p`
(`Stacks.Chow.isHomogeneous_powerSumTotal`). -/
def powerSumTotal (E : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] (p : ℕ) :
    TotalChowClass C sX :=
  if p = 0 then (r : TotalChowClass C sX)
  else ((AlgebraicGeometry.powerSumEval (chernSeq C sX E r) p : chernRing C sX) :
    TotalChowClass C sX)

/-- **`P_p(ℰ) ∈ A^p(X)`**, the power sum of Stacks 0F9B of a finite locally free module of
constant rank `r`: the degree-`p` component of `Stacks.Chow.powerSumTotal`. -/
def powerSumClass (E : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] (p : ℕ) :
    chowCohomologyComponent C (gysinSystemOfInvertible C) sX p :=
  powerSumTotal C sX E r p p

variable (E : X.Modules) (r : ℕ)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]

/-- **`P_0 = r`**: the degree-zero power sum is the rank. -/
theorem powerSumTotal_zero : powerSumTotal C sX E r 0 = (r : TotalChowClass C sX) :=
  if_pos rfl

/-- For `p ≠ 0`, `P_p(ℰ)` is the universal polynomial `P_p` evaluated at the Chern sequence of
`ℰ` in the ring of Chern classes. -/
theorem powerSumTotal_of_ne_zero {p : ℕ} (hp : p ≠ 0) :
    powerSumTotal C sX E r p =
      ((AlgebraicGeometry.powerSumEval (chernSeq C sX E r) p : chernRing C sX) :
        TotalChowClass C sX) :=
  if_neg hp

/-- **`P_p(ℰ)` is homogeneous of degree `p`**: the polynomial `P_p` is weighted homogeneous of
degree `p` and `c_i(ℰ)` has degree `i`. -/
theorem isHomogeneous_powerSumTotal (p : ℕ) : IsHomogeneous p (powerSumTotal C sX E r p) := by
  induction p using Nat.strong_induction_on with
  | _ p ih =>
    rcases p with _ | p
    · rw [powerSumTotal_zero]; exact isHomogeneous_natCast r
    · rw [powerSumTotal_of_ne_zero C sX E r (Nat.succ_ne_zero p),
        AlgebraicGeometry.powerSumEval_succ]
      push_cast
      have h1 : ∀ i, IsHomogeneous i (TotalChowClass.homComponent i (totalChern C sX E r)) :=
        fun i => TotalChowClass.isHomogeneous_homComponent _ _
      refine IsHomogeneous.add (IsHomogeneous.sum fun j hj => ?_) ?_
      · have hjp : j < p := Finset.mem_range.mp hj
        have h2 := ih (p - j) (by omega)
        rw [powerSumTotal_of_ne_zero C sX E r (by omega)] at h2
        have h3 := (h1 (j + 1)).mul h2
        rw [show j + 1 + (p - j) = p + 1 by omega] at h3
        have h4 := isHomogeneous_intCast_mul h3 ((-1) ^ j)
        push_cast at h4
        simpa only [chernSeq, mul_assoc] using h4
      · have h4 := isHomogeneous_intCast_mul (h1 (p + 1)) ((-1) ^ p * ((p : ℤ) + 1))
        push_cast at h4
        simpa only [chernSeq, mul_assoc] using h4

/-- **The power sum as the total class of its degree-`p` component**: `P_p(ℰ)`, a class of
`A^p(X)`, read in `∏_q A^q(X)`, is `Stacks.Chow.powerSumTotal`. -/
theorem homPart_powerSumTotal (p : ℕ) :
    TotalChowClass.homComponent p (powerSumTotal C sX E r p) = powerSumTotal C sX E r p :=
  (isHomogeneous_powerSumTotal C sX E r p).homComponent_self

end PowerSum

/-! ### Stacks 0F9C, and restriction, for modules of constant rank -/

section Additivity

open TotalChowClass

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

/-- **The Chern classes of the middle term of a short exact sequence**, in the ring of Chern
classes: `c_n(ℰ) = ∑_{j ≤ n} c_{n-j}(ℰ₁) c_j(ℰ₂)`, the Whitney sum formula
`Stacks.Chow.totalChern_eq_mul_of_shortExact` read degree by degree. -/
theorem chernSeq_eq_sum_of_shortExact (S : ShortComplex X.Modules) (hS : S.ShortExact)
    (r₁ r₂ : ℕ) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₃ r₂] (n : ℕ) :
    haveI := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S hS r₁ r₂ ‹_› ‹_›
    chernSeq C sX S.X₂ (r₁ + r₂) n =
      ∑ j ∈ range (n + 1), chernSeq C sX S.X₁ r₁ (n - j) * chernSeq C sX S.X₃ r₂ j := by
  have := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S hS r₁ r₂ ‹_› ‹_›
  refine Subtype.ext ?_
  rw [show ((∑ j ∈ range (n + 1), chernSeq C sX S.X₁ r₁ (n - j) * chernSeq C sX S.X₃ r₂ j :
      chernRing C sX) : TotalChowClass C sX) = ∑ j ∈ range (n + 1),
        ((chernSeq C sX S.X₁ r₁ (n - j) : TotalChowClass C sX) * chernSeq C sX S.X₃ r₂ j) from
      map_sum (chernRing C sX).subtype _ _]
  show TotalChowClass.homComponent n (totalChern C sX S.X₂ (r₁ + r₂)) = _
  rw [totalChern_eq_mul_of_shortExact C sX S hS r₁ r₂, TotalChowClass.homComponent_mul_sum]
  rfl

/-- **Stacks 0F9C, for modules of constant rank.** For a short exact sequence
`0 ⟶ ℰ₁ ⟶ ℰ ⟶ ℰ₂ ⟶ 0` of `𝒪_X`-modules with `ℰ₁`, `ℰ₂` finite locally free of ranks `r₁`,
`r₂`, the power sums satisfy `P_p(ℰ) = P_p(ℰ₁) + P_p(ℰ₂)` for every `p ≥ 0`. -/
theorem powerSumTotal_eq_add_of_shortExact (S : ShortComplex X.Modules) (hS : S.ShortExact)
    (r₁ r₂ : ℕ) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₃ r₂] (p : ℕ) :
    haveI := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S hS r₁ r₂ ‹_› ‹_›
    powerSumTotal C sX S.X₂ (r₁ + r₂) p =
      powerSumTotal C sX S.X₁ r₁ p + powerSumTotal C sX S.X₃ r₂ p := by
  have := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S hS r₁ r₂ ‹_› ‹_›
  rcases eq_or_ne p 0 with rfl | hp
  · rw [powerSumTotal_zero, powerSumTotal_zero, powerSumTotal_zero, Nat.cast_add]
  · rw [powerSumTotal_of_ne_zero C sX _ _ hp, powerSumTotal_of_ne_zero C sX _ _ hp,
      powerSumTotal_of_ne_zero C sX _ _ hp, ← Subring.coe_add]
    congr 1
    have h := AlgebraicGeometry.powerSumEval_convolution (chernSeq C sX S.X₁ r₁)
      (chernSeq C sX S.X₃ r₂) (chernSeq_zero C sX _ _) (chernSeq_zero C sX _ _) p
    rw [← h]
    exact congrArg (fun a => AlgebraicGeometry.powerSumEval a p)
      (funext fun n => chernSeq_eq_sum_of_shortExact C sX S hS r₁ r₂ n)

/-- **Stacks 0F9C, for the classes `P_p ∈ A^p(X)` of modules of constant rank.** -/
theorem powerSumClass_eq_add_of_shortExact (S : ShortComplex X.Modules) (hS : S.ShortExact)
    (r₁ r₂ : ℕ) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₃ r₂] (p : ℕ) :
    haveI := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S hS r₁ r₂ ‹_› ‹_›
    powerSumClass C sX S.X₂ (r₁ + r₂) p =
      powerSumClass C sX S.X₁ r₁ p + powerSumClass C sX S.X₃ r₂ p :=
  congrArg (fun c : TotalChowClass C sX => c p)
    (powerSumTotal_eq_add_of_shortExact C sX S hS r₁ r₂ p)

/-- **Restriction of the power sums**: for `h : X' ⟶ X` locally of finite type,
`res_h P_p(ℰ) = P_p(h^*ℰ)`. -/
theorem res_powerSumTotal {X' : Scheme.{u}} {sX' : X' ⟶ C.S} [LocallyOfFiniteType sX']
    (h : X' ⟶ X) [LocallyOfFiniteType h] (hs : h ≫ sX = sX') (E : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] (p : ℕ) :
    letI := pullbackPreservesRank_of_isFiniteLocallyFreeOfRank E r h
    res h hs (powerSumTotal C sX E r p) =
      powerSumTotal C sX' ((Scheme.Modules.pullback h).obj E) r p := by
  let := pullbackPreservesRank_of_isFiniteLocallyFreeOfRank E r h
  rcases eq_or_ne p 0 with rfl | hp
  · rw [powerSumTotal_zero, powerSumTotal_zero, map_natCast]
  · rw [powerSumTotal_of_ne_zero C sX _ _ hp, powerSumTotal_of_ne_zero C sX' _ _ hp]
    refine AlgebraicGeometry.map_coe_powerSumEval_closure (res h hs) (chernSet_commute C sX)
      (chernSet_commute C sX') _ (homPart_totalChern_mem_chernSet C sX E r) _
      (homPart_totalChern_mem_chernSet C sX' _ r) (fun i => ?_) ?_ p
    · rw [TotalChowClass.res_homComponent, res_totalChern]
    · rintro _ ⟨F, s, hF, i, rfl⟩
      let := pullbackPreservesRank_of_isFiniteLocallyFreeOfRank F s h
      rw [TotalChowClass.res_homComponent, res_totalChern]
      exact Subring.subset_closure (homPart_totalChern_mem_chernSet C sX' _ s i)

/-- **Invariance of the power sums under isomorphism.** -/
theorem powerSumTotal_congr {E E' : X.Modules} {r r' : ℕ}
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E' r'] (e : E ≅ E')
    (h : r = r') (p : ℕ) : powerSumTotal C sX E r p = powerSumTotal C sX E' r' p := by
  subst h
  have hc : chernSeq C sX E r = chernSeq C sX E' r :=
    funext fun i => Subtype.ext
      (congrArg (TotalChowClass.homComponent i) (totalChern_congr C sX e rfl))
  simp only [powerSumTotal, hc]

/-- On an empty scheme, or for the rank function of a module on a nonempty scheme, the power
sums do not depend on the rank the module is presented with. -/
theorem powerSumTotal_congr_rank (E : X.Modules) {r r' : ℕ}
    (hr : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r)
    (hr' : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r') (p : ℕ) :
    powerSumTotal C sX E r p = powerSumTotal C sX E r' p := by
  rcases isEmpty_or_nonempty X with hX | ⟨⟨x⟩⟩
  · exact (TotalChowClass.subsingleton_of_isEmpty sX).elim _ _
  · obtain rfl := Scheme.Modules.isFiniteLocallyFreeOfRank_unique E hr hr' x
    rfl

end Additivity

end Stacks.Chow

end
