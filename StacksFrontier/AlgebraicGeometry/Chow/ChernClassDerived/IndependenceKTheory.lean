module

public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.WhitneySum
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.CohomologyComparison
public import StacksFrontier.AlgebraicGeometry.Divisors.Reflexive.ConstantRank
public import StacksFrontier.AlgebraicGeometry.FiberRank.ConstantRank
public import StacksFrontier.AlgebraicGeometry.InvertibleLocallyFree.Basic

/-!
# The total Chern class of a module through `K_0(Vect(T))`

Let `T` be a scheme locally of finite type over the base of chapter 42 of the Stacks Project.
The total Chern classes `c(ℰ)` of the finite locally free `𝒪_T`-modules of constant rank, as
graded cap families on the Chow groups of `T` (`Stacks.Chow.GenuineChern.chernFamily`), commute
with each other: by the Whitney sum formula, Stacks 02UI, both `c(ℰ) c(ℱ)` and `c(ℱ) c(ℰ)` are
`c(ℰ ⊕ ℱ)`. So the subgroup of units they generate is commutative, and when every finite locally
free module has constant rank — on an integral `T` — the Whitney sum formula says exactly that
`ℰ ↦ c(ℰ)` descends to a homomorphism

  `K_0(Vect(T)) ⟶ ⟨c(ℰ)⟩`.

This is the factorization through `K_0` used in the proof of Stacks 0ESZ: an alternating product
`∏_n c(ℰ^n)^{(-1)^n}` over the terms of a bounded complex, in any order, is the image of the
alternating class `∑_n (-1)^n [ℰ^n]`, so it depends only on that class.

## Main definitions

* `Stacks.Chow.GenuineChern.chernFamilyUnit` — `c(ℰ)` as a unit.
* `Stacks.Chow.GenuineChern.chernUnitGroup` — the subgroup generated by the total Chern classes,
  with its commutative group structure.
* `Stacks.Chow.GenuineChern.chernKHom` — on an integral scheme, the homomorphism
  `K_0(Vect(T)) ⟶ ⟨c(ℰ)⟩` sending `[ℰ]` to `c(ℰ)`.

## Main results

* `Stacks.Chow.GenuineChern.chernFamily_commute` — total Chern classes commute.
* `Stacks.Chow.GenuineChern.chernKHom_classOf` — the value on the class of a module.
* `Stacks.Chow.GenuineChern.list_prod_chernFamilyUnit_zpow` — an ordered alternating product of
  total Chern classes is the image of the corresponding alternating sum of classes.

## References

* [Stacks Project, Tag 02UI](https://stacks.math.columbia.edu/tag/02UI)
* [Stacks Project, Tag 0ESZ](https://stacks.math.columbia.edu/tag/0ESZ)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open Stacks.Cohomology.PerfectComplexes Stacks.Cohomology.TorAmplitude

universe u

namespace Stacks.Chow.GenuineChern

attribute [local instance 10000] HasDerivedCategory.standard

variable (C : ChowSituation.{u}) {T : Scheme.{u}} (q : T ⟶ C.S) [LocallyOfFiniteType q]

/-- The total Chern class `c(ℰ)` of a finite locally free module of rank `r`, as a unit of the
ring of graded cap families on the Chow groups. -/
def chernFamilyUnit (F : T.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] :
    (GradedCapFamily (chowGroup C q))ˣ :=
  (isUnit_chernFamily C q F r).unit

/-- The underlying element of the unit `c(ℰ)` is the total Chern class `c(ℰ)`. -/
@[simp]
theorem val_chernFamilyUnit (F : T.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] :
    (chernFamilyUnit C q F r : GradedCapFamily (chowGroup C q)) = chernFamily C q F r :=
  rfl

/-- **The Whitney sum formula for a direct sum**: `c(ℰ ⊕ ℱ) = c(ℰ) c(ℱ)`. -/
theorem chernFamily_biprod (F G : T.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} G s] :
    haveI := isFiniteLocallyFreeOfRank_of_shortExact
      (ShortComplex.mk (biprod.inl : F ⟶ F ⊞ G) (biprod.snd : F ⊞ G ⟶ G) (by simp))
      (ShortComplex.Splitting.ofHasBinaryBiproduct F G).shortExact r s ‹_› ‹_›
    chernFamily C q (F ⊞ G) (r + s) = chernFamily C q F r * chernFamily C q G s :=
  chernFamily_eq_mul_of_shortExact C q
    (ShortComplex.mk (biprod.inl : F ⟶ F ⊞ G) (biprod.snd : F ⊞ G ⟶ G) (by simp))
    (ShortComplex.Splitting.ofHasBinaryBiproduct F G).shortExact r s

/-- A direct sum of finite locally free modules of ranks `r` and `s` is finite locally free of rank
`r + s`. -/
private theorem isFiniteLocallyFreeOfRank_biprod (F G : T.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} G s] :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (F ⊞ G : T.Modules) (r + s) :=
  isFiniteLocallyFreeOfRank_of_shortExact
    (ShortComplex.mk (biprod.inl : F ⟶ F ⊞ G) (biprod.snd : F ⊞ G ⟶ G) (by simp))
    (ShortComplex.Splitting.ofHasBinaryBiproduct F G).shortExact r s ‹_› ‹_›

/-- **Total Chern classes commute**: `c(ℰ) c(ℱ) = c(ℱ) c(ℰ)`, both being `c(ℰ ⊕ ℱ)` by the
Whitney sum formula, Stacks 02UI. -/
theorem chernFamily_commute (F G : T.Modules) (r s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} G s] :
    Commute (chernFamily C q F r) (chernFamily C q G s) := by
  have := isFiniteLocallyFreeOfRank_biprod F G r s
  have := isFiniteLocallyFreeOfRank_biprod G F s r
  show chernFamily C q F r * chernFamily C q G s = chernFamily C q G s * chernFamily C q F r
  rw [← chernFamily_biprod C q F G r s, ← chernFamily_biprod C q G F s r]
  exact chernFamily_congr C q (G ⊞ F) (s + r) (biprod.braiding F G) (Nat.add_comm r s)

/-- The total Chern classes of the finite locally free modules of constant rank, as units. -/
def chernUnitSet : Set (GradedCapFamily (chowGroup C q))ˣ :=
  {v | ∃ (F : T.Modules) (r : ℕ)
    (_ : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r),
    v = chernFamilyUnit C q F r}

/-- The unit `c(ℰ)` of a finite locally free module of constant rank lies in the set of total
Chern classes. -/
theorem chernFamilyUnit_mem_chernUnitSet (F : T.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] :
    chernFamilyUnit C q F r ∈ chernUnitSet C q :=
  ⟨F, r, ‹_›, rfl⟩

/-- Any two total Chern classes, as units, commute. -/
theorem chernUnitSet_commute :
    ∀ v ∈ chernUnitSet C q, ∀ w ∈ chernUnitSet C q, v * w = w * v := by
  rintro _ ⟨F, r, _, rfl⟩ _ ⟨G, s, _, rfl⟩
  exact Units.ext (chernFamily_commute C q F G r s)

/-- **The group generated by the total Chern classes**, the subgroup of the units of the ring of
graded cap families generated by the classes `c(ℰ)`. It is commutative
(`Stacks.Chow.GenuineChern.chernFamily_commute`). -/
def chernUnitGroup : Subgroup (GradedCapFamily (chowGroup C q))ˣ :=
  Subgroup.closure (chernUnitSet C q)

/-- The group generated by the total Chern classes is commutative. -/
instance : CommGroup (chernUnitGroup C q) :=
  Subgroup.closureCommGroupOfComm (chernUnitSet_commute C q)

/-- `c(ℰ)` as an element of the group generated by the total Chern classes. -/
def chernUnitGroupElem (F : T.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] :
    chernUnitGroup C q :=
  ⟨chernFamilyUnit C q F r, Subgroup.subset_closure (chernFamilyUnit_mem_chernUnitSet C q F r)⟩

/-- The underlying unit of `c(ℰ)` in the group generated by the total Chern classes is the unit
`c(ℰ)`. -/
@[simp]
theorem coe_chernUnitGroupElem (F : T.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] :
    (chernUnitGroupElem C q F r : (GradedCapFamily (chowGroup C q))ˣ) = chernFamilyUnit C q F r :=
  rfl

/-- The element `c(ℰ)` does not depend on how the module and its rank are spelled. -/
theorem chernUnitGroupElem_congr {F F' : T.Modules} {r r' : ℕ}
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F' r'] (e : F' ≅ F)
    (h : r' = r) : chernUnitGroupElem C q F' r' = chernUnitGroupElem C q F r :=
  Subtype.ext (Units.ext (chernFamily_congr C q F r e h))

section KTheory

variable [IsIntegral T]

/-- On an integral scheme a finite locally free module has a constant rank, its fibre rank at
any point. -/
theorem exists_isFiniteLocallyFreeOfRank_of_isIntegral (M : T.Modules)
    (hM : Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := T.ringCatSheaf) M) :
    ∃ r : ℕ, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r := by
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} (R := T.ringCatSheaf) M :=
    ⟨hM.exists_isFiniteLocallyFreeData⟩
  obtain ⟨x⟩ : Nonempty T := inferInstance
  exact ⟨_, Scheme.Modules.isFiniteLocallyFreeOfRank_of_fiberRank_eq M _ x rfl⟩

open Classical in
/-- The function `ℰ ↦ c(ℰ)` on modules, with value `1` off the modules of constant rank, written
additively. -/
def chernKFun (M : T.Modules) : Additive (chernUnitGroup C q) :=
  if h : ∃ r : ℕ, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r then
    have := h.choose_spec
    Additive.ofMul (chernUnitGroupElem C q M h.choose)
  else 0

/-- On a finite locally free module of rank `r`, the function `ℰ ↦ c(ℰ)` takes the value `c(ℰ)`
computed with the rank `r`. -/
theorem chernKFun_eq (M : T.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r] :
    chernKFun C q M = Additive.ofMul (chernUnitGroupElem C q M r) := by
  have h : ∃ r : ℕ, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r :=
    ⟨r, ‹_›⟩
  rw [chernKFun, dif_pos h]
  obtain ⟨x⟩ : Nonempty T := inferInstance
  have := h.choose_spec
  exact congrArg Additive.ofMul (chernUnitGroupElem_congr C q (Iso.refl M)
    (Scheme.Modules.isFiniteLocallyFreeOfRank_unique M h.choose_spec ‹_› x))

/-- A module which is finite locally free of rank `r` is finite locally free, for the class
`Stacks.FiniteLocallyFree.IsFiniteLocallyFree` that `K_0(Vect(T))` is defined with. -/
theorem isFiniteLocallyFree_of_isFiniteLocallyFreeOfRank {X : Scheme.{u}} (M : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r] :
    Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M :=
  ⟨(AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree M r
    ).exists_isFiniteLocallyFreeData⟩

omit [IsIntegral T] in
/-- Off the finite locally free modules the function `ℰ ↦ c(ℰ)` takes the value `1`. -/
theorem chernKFun_eq_zero (M : T.Modules)
    (hM : ¬ Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := T.ringCatSheaf) M) :
    chernKFun C q M = 0 :=
  dif_neg fun ⟨r, hr⟩ ↦ hM (have := hr; isFiniteLocallyFree_of_isFiniteLocallyFreeOfRank M r)

/-- **The total Chern class through `K_0(Vect(T))`.** On an integral scheme `T`, the
homomorphism `K_0(Vect(T)) ⟶ ⟨c(ℰ)⟩` sending the class of a finite locally free module `ℰ` to
its total Chern class `c(ℰ)`. It is well defined by the Whitney sum formula, Stacks 02UI. -/
def chernKHom : AlgebraicGeometry.VectorBundleKZero T →+ Additive (chernUnitGroup C q) :=
  AlgebraicGeometry.VectorBundleKZero.liftAddHom (chernKFun C q)
    (chernKFun_eq_zero C q)
    (fun {E F G} f g w hE _ hG hmono hepi hex ↦ by
      obtain ⟨r, hr⟩ := exists_isFiniteLocallyFreeOfRank_of_isIntegral (M := E) hE
      obtain ⟨s, hs⟩ := exists_isFiniteLocallyFreeOfRank_of_isIntegral (M := G) hG
      let S := ShortComplex.mk f g w
      have hS : S.ShortExact := { exact := hex }
      have := isFiniteLocallyFreeOfRank_of_shortExact S hS r s hr hs
      rw [chernKFun_eq C q E r, chernKFun_eq C q G s, chernKFun_eq C q F (r + s),
        ← ofMul_mul]
      exact congrArg Additive.ofMul
        (Subtype.ext (Units.ext (chernFamily_eq_mul_of_shortExact C q S hS r s))))

/-- The value of `Stacks.Chow.GenuineChern.chernKHom` on the class of a finite locally free module
of rank `r` is its total Chern class. -/
theorem chernKHom_classOf (F : T.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] :
    chernKHom C q (AlgebraicGeometry.VectorBundleKZero.classOf T F) =
      Additive.ofMul (chernUnitGroupElem C q F r) :=
  (AlgebraicGeometry.VectorBundleKZero.liftAddHom_classOf _ _ _ F).trans (chernKFun_eq C q F r)

/-- **An alternating product of total Chern classes is the image of the alternating sum of the
classes**, in any order: for modules `ℰ_n` of ranks `r_n`, signs `ε_n` and a list `l` of indices,
`∏_{n ∈ l} c(ℰ_n)^{ε_n}` is the image under `Stacks.Chow.GenuineChern.chernKHom` of
`∑_{n ∈ l} ε_n [ℰ_n]`. -/
theorem list_prod_chernFamilyUnit_zpow {ι : Type*} (F : ι → T.Modules) (r : ι → ℕ)
    (hF : ∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (F i) (r i))
    (ε : ι → ℤ) (l : List ι) :
    (l.map fun i ↦ (haveI := hF i; chernFamilyUnit C q (F i) (r i)) ^ ε i).prod =
      ((Additive.toMul (chernKHom C q
        (l.map fun i ↦ ε i • AlgebraicGeometry.VectorBundleKZero.classOf T (F i)).sum) :
          chernUnitGroup C q) : (GradedCapFamily (chowGroup C q))ˣ) := by
  induction l with
  | nil => simp
  | cons i l ih =>
    have := hF i
    rw [List.map_cons, List.prod_cons, ih, List.map_cons, List.sum_cons, map_add, map_zsmul,
      chernKHom_classOf C q (F i) (r i), toMul_add, toMul_zsmul, toMul_ofMul,
      Subgroup.coe_mul, Subgroup.coe_zpow, coe_chernUnitGroupElem]

/-- **The alternating product of the total Chern classes of the terms of a complex is the image
of its alternating class.** For a complex `P` whose `n`-th term is finite locally free of rank
`ρ n`, with `ρ n = 0` outside the window `a, …, a + k`, the product
`∏_{n = a}^{a + k} c(P^n)^{(-1)^n}`, taken in increasing order of `n`, is the image under
`Stacks.Chow.GenuineChern.chernKHom` of the alternating class `∑_n (-1)^n [P^n]`. -/
theorem prod_Icc_chernFamilyUnit_eq_chernKHom (P : CochainComplex T.Modules ℤ) (ρ : ℤ → ℕ)
    (hP : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (P.X n) (ρ n))
    (a : ℤ) (k : ℕ) :
    (((Finset.Icc a (a + (k : ℤ))).sort (· ≤ ·)).map fun n ↦
        (haveI := hP n; chernFamilyUnit C q (P.X n) (ρ n)) ^ ((n.negOnePow : ℤˣ) : ℤ)).prod =
      ((Additive.toMul (chernKHom C q (alternatingKClass T P a k)) : chernUnitGroup C q) :
        (GradedCapFamily (chowGroup C q))ˣ) := by
  classical
  rw [list_prod_chernFamilyUnit_zpow C q (fun n ↦ P.X n) ρ hP, alternatingKClass_eq_sum_Icc,
    ← List.sum_toFinset _ (Finset.sort_nodup _ _), Finset.sort_toFinset]

/-- **Stacks 0ESZ on an integral scheme whose cohomology is perfect of Tor dimension at most
one.** Let `T` be integral and locally Noetherian, and let `P`, `Q` be complexes whose terms are
finite locally free of ranks `ρ n`, `σ n`, vanishing outside the window `a, …, a + k`. If `P` and
`Q` represent the same object of `D(𝒪_T)` and the cohomology modules of that object are perfect
of Tor dimension at most one, then

  `∏_n c(P^n)^{(-1)^n} = ∏_n c(Q^n)^{(-1)^n}`,

both products taken over the window in increasing order. The two sides are the images of the
alternating classes in `K_0(Vect(T))` (`Stacks.Chow.GenuineChern.chernKHom`), and these agree by
Stacks 0F8J and Schanuel's lemma (`Stacks.Chow.alternatingKClass_eq_of_iso_derivedCategory`). -/
theorem prod_Icc_chernFamilyUnit_eq_of_iso [IsLocallyNoetherian T]
    (P Q : CochainComplex T.Modules ℤ) (ρ σ : ℤ → ℕ)
    (hP : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (P.X n) (ρ n))
    (hQ : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (Q.X n) (σ n))
    (a : ℤ) (k : ℕ) (hρ : ∀ n, (n < a ∨ a + (k : ℤ) < n) → ρ n = 0)
    (hσ : ∀ n, (n < a ∨ a + (k : ℤ) < n) → σ n = 0)
    (e : DerivedCategory.Q.obj P ≅ DerivedCategory.Q.obj Q)
    (hE : ∀ i : ℤ,
      IsPerfect.{u, u, u + 1} ((DerivedCategory.singleFunctor T.Modules 0).obj
        ((DerivedCategory.homologyFunctor T.Modules i).obj (DerivedCategory.Q.obj P))) ∧
      HasTorAmplitude T.toRingedSpace ((DerivedCategory.singleFunctor T.Modules 0).obj
        ((DerivedCategory.homologyFunctor T.Modules i).obj (DerivedCategory.Q.obj P))) (-1) 0) :
    (((Finset.Icc a (a + (k : ℤ))).sort (· ≤ ·)).map fun n ↦
        (haveI := hP n; chernFamilyUnit C q (P.X n) (ρ n)) ^ ((n.negOnePow : ℤˣ) : ℤ)).prod =
      (((Finset.Icc a (a + (k : ℤ))).sort (· ≤ ·)).map fun n ↦
        (haveI := hQ n; chernFamilyUnit C q (Q.X n) (σ n)) ^ ((n.negOnePow : ℤˣ) : ℤ)).prod := by
  rw [prod_Icc_chernFamilyUnit_eq_chernKHom C q P ρ hP a k,
    prod_Icc_chernFamilyUnit_eq_chernKHom C q Q σ hQ a k,
    alternatingKClass_eq_of_iso_derivedCategory P Q a k
      (fun n ↦ have := hP n; isFiniteLocallyFree_of_isFiniteLocallyFreeOfRank (P.X n) (ρ n))
      (fun n ↦ have := hQ n; isFiniteLocallyFree_of_isFiniteLocallyFreeOfRank (Q.X n) (σ n))
      (fun n hn ↦ @Stacks.Chow.isZero_of_isFiniteLocallyFreeOfRank_zero _ _ ((hρ n hn) ▸ hP n))
      (fun n hn ↦ @Stacks.Chow.isZero_of_isFiniteLocallyFreeOfRank_zero _ _ ((hσ n hn) ▸ hQ n))
      (DerivedCategory.Q.obj P) ⟨Iso.refl _⟩ ⟨e⟩ hE]

end KTheory

end Stacks.Chow.GenuineChern

end
