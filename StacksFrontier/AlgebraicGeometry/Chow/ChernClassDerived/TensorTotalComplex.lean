module

public import StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.TensorPowerSums
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.DirectSum
public import StacksFrontier.AlgebraicGeometry.PseudoCoherent.PseudoCoherentBiproduct

/-!
# The Chern classes of the total tensor complex of two complexes of finite locally free modules

Let `(S, δ)` be the base situation of chapter 42 of the Stacks Project, let `Y` be locally of
finite type over `S` and let `𝓔^•`, `𝓕^•` be locally bounded complexes of finite locally free
`𝒪_Y`-modules. The total tensor complex `Tot(𝓔^• ⊗ 𝓕^•)`, whose degree-`n` term is
`⨁_{a + b = n} 𝓔^a ⊗ 𝓕^b`, is again such a complex, and this file computes its Chern classes and
power sums from those of the two factors: these are the formal computations behind Stacks 0FAG.

On a test scheme `g : T ⟶ Y` along which both complexes have constant ranks `ρ` and `σ`, the
complexes are bounded, the degree-`n` term of the pulled back total complex is the finite direct
sum of the `g^*𝓔^a ⊗ g^*𝓕^{n-a}`, and

* the power sums satisfy `P_p(Tot) = ∑_{p₁ + p₂ = p} C(p, p₁) P_{p₁}(𝓔^•) P_{p₂}(𝓕^•)`, by the
  identity of Stacks 0F9D for each pair of terms (`Stacks.Chow.powerSumTotal_sheafTensor`) and
  additivity;
* the first two Chern classes satisfy the relations of Stacks 0FA6 with the ranks `r` and `s`
  replaced by the alternating ranks `∑ (-1)^a ρ(a)` and `∑ (-1)^b σ(b)`: those relations are
  bilinear in the sense of `Stacks.Chow.ChernPair.tensorHom`, so they pass from the pairs of terms,
  where they are Stacks 0FA6, to the alternating products.

## Main definitions

* `Stacks.Chow.tensorTotal` — the total tensor complex `Tot(K ⊗ L)` of two complexes of
  `𝒪_T`-modules.
* `Stacks.Chow.ChernPair` — the pairs `(c₁, c₂)` with the group law of the Whitney formula, and
  `Stacks.Chow.ChernPair.tensor`, the pairing of Stacks 0FA6, which is bilinear.
* `Stacks.Chow.chernPairOf`, `Stacks.Chow.moduleChernPair` — the pair of first two Chern classes
  of a total class, and of a finite locally free module.
* `Stacks.Chow.alternatingRank`, `Stacks.Chow.tensorRank` — the alternating rank of a complex of
  constant ranks, and the ranks of the terms of a total tensor complex.

## Main results

* `Stacks.Chow.cofanPtIsoBiproduct` — a coproduct all of whose summands but finitely many vanish
  is the finite biproduct of the remaining ones.
* `Stacks.Chow.isFiniteLocallyFreeOfRank_biproduct`, `Stacks.Chow.powerSumTotal_biproduct`,
  `Stacks.Chow.moduleChernPair_biproduct` — rank, power sums and first two Chern classes of a
  finite direct sum.
* `Stacks.Chow.moduleChernPair_sheafTensor` — Stacks 0FA6 as an identity of pairs.
* `Stacks.Chow.isLocallyBoundedFiniteLocallyFree_tensorTotal` — the total tensor complex of two
  locally bounded complexes of finite locally free modules is one again.
* `Stacks.Chow.powerSumComplex_tensorTotal`, `Stacks.Chow.homPart_one_complexChern_tensorTotal`,
  `Stacks.Chow.homPart_two_complexChern_tensorTotal` — power sums and first two Chern classes of
  the total tensor complex.

## Implementation notes

The first two Chern classes are handled through the group `Stacks.Chow.ChernPair` of the
commutative ring `Stacks.Chow.chernUnitRing` generated by the Chern classes of modules and their
inverses: the alternating product `∏ c(ℰ^n)^{(-1)^n}` becomes the alternating sum of the pairs,
and the relations of Stacks 0FA6 become the bilinearity of the pairing, so that they pass from
the pairs of terms to the complexes by expanding two sums. The binomial coefficients `C(r, 2)`
are those of the integers, the alternating rank of a complex being any integer.

## References

* [Stacks Project, Tag 0FAG](https://stacks.math.columbia.edu/tag/0FAG)
* [Stacks Project, Tag 0FA6](https://stacks.math.columbia.edu/tag/0FA6)
* [Stacks Project, Tag 0F9D](https://stacks.math.columbia.edu/tag/0F9D)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Finset
open Stacks.SheafOfModules.Tensor (sheafTensor)
open scoped Stacks.Topology.SheafTensorAdditiveOnOpens

universe u

namespace Stacks.Chow

attribute [local instance 10000] HasDerivedCategory.standard


/-! ### Coproducts with finitely many nonzero summands -/

section Cofan

variable {D : Type*} [Category D] [Preadditive D] [HasFiniteBiproducts D]

open Classical in
/-- **A coproduct all of whose summands but finitely many vanish is a finite biproduct.** If the
summands `f j` of a colimit cofan vanish for `j` outside a finite set `S`, its point is the
biproduct of the `f j`, `j ∈ S`. -/
def cofanPtIsoBiproduct {J : Type} {f : J → D} {c : Cofan f} (hc : IsColimit c) (S : Finset J)
    (hz : ∀ j ∉ S, IsZero (f j)) : c.pt ≅ ⨁ fun j : S ↦ f j := by
  let ι : ∀ j, f j ⟶ ⨁ fun j : S ↦ f j := fun j ↦
    if h : j ∈ S then biproduct.ι (fun j : S ↦ f j) ⟨j, h⟩ else 0
  have hι : ∀ j : S, ι j = biproduct.ι (fun j : S ↦ f j) j := fun j ↦ dif_pos j.2
  have hs : IsColimit (Cofan.mk _ ι) := by
    refine Cofan.IsColimit.mk _ (fun t ↦ biproduct.desc fun j ↦ t.inj j) ?_ ?_
    · intro t j
      by_cases h : j ∈ S
      · exact (congrArg (· ≫ _) (hι ⟨j, h⟩)).trans (biproduct.ι_desc _ _)
      · rw [cofan_mk_inj, show ι j = 0 from dif_neg h, zero_comp]
        exact (hz j h).eq_of_src _ _
    · intro t m hm
      refine biproduct.hom_ext' _ _ fun j ↦ ?_
      rw [biproduct.ι_desc, ← hm j.1, cofan_mk_inj, hι j]
  exact hc.coconePointUniqueUpToIso hs

end Cofan

/-! ### Finite direct sums of finite locally free modules -/

section Biproduct

variable {T : Scheme.{u}}

/-- The biproduct of a family indexed by `ι` is an extension of the biproduct of the family
restricted to `ι ∖ {i}` by its `i`-th member. -/
theorem shortExact_biproduct_ι {ι : Type} [Finite ι] (f : ι → T.Modules) (i : ι) :
    (ShortComplex.mk (biproduct.ι f i) (cokernel.π (biproduct.ι f i))
      (cokernel.condition _)).ShortExact :=
  { exact := ShortComplex.exact_cokernel _ }

/-- The complement of a point in a finite type has one member less. -/
theorem card_subtype_ne {ι : Type} [Fintype ι] [DecidableEq ι] (i : ι) :
    Fintype.card {j // j ≠ i} + 1 = Fintype.card ι := by
  rw [← Fintype.card_option, Fintype.card_congr (Equiv.optionSubtypeNe i)]

/-- **A finite direct sum of finite locally free modules is finite locally free.** -/
theorem isFiniteLocallyFree_biproduct (n : ℕ) {ι : Type} [Fintype ι]
    (hn : Fintype.card ι = n) (f : ι → T.Modules)
    (hf : ∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} (f i)) :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} (⨁ f : T.Modules) := by
  classical
  induction n generalizing ι with
  | zero =>
    have : IsEmpty ι := Fintype.card_eq_zero_iff.1 hn
    exact @AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree _ _ _ _
      _ _ _ 0 (AlgebraicGeometry.isFiniteLocallyFreeOfRank_zero_of_isZero
        (isZero_biproduct_of_isEmpty f))
  | succ n ih =>
    obtain ⟨i⟩ : Nonempty ι := Fintype.card_pos_iff.1 (by omega)
    have h₃ := ih (ι := {j // j ≠ i}) (by have := card_subtype_ne i; omega)
      (Subtype.restrict _ f) fun j ↦ hf j
    have h₃' : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
        (cokernel (biproduct.ι f i)) :=
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.of_iso
        (cokernelBiproductιIso f i).symm (h := h₃)
    exact GenuineChern.isFiniteLocallyFree_of_shortExact _ (shortExact_biproduct_ι f i) (hf i) h₃'

/-- **A finite direct sum of finite locally free modules of ranks `r i` is finite locally free of
rank `∑ r i`.** -/
theorem isFiniteLocallyFreeOfRank_biproduct (n : ℕ) {ι : Type} [Fintype ι]
    (hn : Fintype.card ι = n) (f : ι → T.Modules) (r : ι → ℕ)
    (hf : ∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (f i) (r i)) :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (⨁ f : T.Modules)
      (∑ i, r i) := by
  classical
  induction n generalizing ι with
  | zero =>
    have : IsEmpty ι := Fintype.card_eq_zero_iff.1 hn
    exact GenuineChern.rank_of_iso (Iso.refl _) (by simp)
      (AlgebraicGeometry.isFiniteLocallyFreeOfRank_zero_of_isZero (isZero_biproduct_of_isEmpty f))
  | succ n ih =>
    obtain ⟨i⟩ : Nonempty ι := Fintype.card_pos_iff.1 (by omega)
    have h₃ := ih (ι := {j // j ≠ i}) (by have := card_subtype_ne i; omega)
      (Subtype.restrict _ f) (Subtype.restrict _ r) fun j ↦ hf j
    have h₃' : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        (cokernel (biproduct.ι f i)) (∑ j : {j // j ≠ i}, r j) :=
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u}
        (cokernelBiproductιIso f i).symm h₃
    exact GenuineChern.rank_of_iso (Iso.refl _) (Fintype.sum_eq_add_sum_subtype_ne r i).symm
      (GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact _ (shortExact_biproduct_ι f i) _ _
        (hf i) h₃')

/-- An additive invariant of finite locally free modules which is invariant under isomorphisms and
vanishes on zero modules has the value of a finite direct sum the sum of the values of the
summands. -/
private theorem sum_biproduct_of_additive {A : Type*} [AddCommMonoid A]
    (Φ : ∀ (M : T.Modules) (r : ℕ),
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r → A)
    (hiso : ∀ {M M' : T.Modules} {r r' : ℕ}
      (hM : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r)
      (hM' : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M' r'),
      (M ≅ M') → Φ M r hM = Φ M' r' hM')
    (hzero : ∀ {M : T.Modules} {r : ℕ}
      (hM : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r),
      IsZero M → Φ M r hM = 0)
    (hadd : ∀ (S : ShortComplex T.Modules) (hS : S.ShortExact) (r₁ r₂ : ℕ)
      (h₁ : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₁ r₁)
      (h₃ : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₃ r₂),
      Φ S.X₂ (r₁ + r₂) (GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S hS r₁ r₂ h₁ h₃) =
        Φ S.X₁ r₁ h₁ + Φ S.X₃ r₂ h₃)
    (n : ℕ) {ι : Type} [Fintype ι] (hn : Fintype.card ι = n) (f : ι → T.Modules) (r : ι → ℕ)
    (hf : ∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (f i) (r i))
    (t : ℕ)
    (ht : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (⨁ f : T.Modules) t) :
    Φ (⨁ f : T.Modules) t ht = ∑ i, Φ (f i) (r i) (hf i) := by
  classical
  induction n generalizing ι t with
  | zero =>
    have : IsEmpty ι := Fintype.card_eq_zero_iff.1 hn
    rw [hzero ht (isZero_biproduct_of_isEmpty f), Finset.univ_eq_empty, Finset.sum_empty]
  | succ n ih =>
    obtain ⟨i⟩ : Nonempty ι := Fintype.card_pos_iff.1 (by omega)
    have h₃ := isFiniteLocallyFreeOfRank_biproduct _ rfl (fun j : {j // j ≠ i} ↦ f j)
      (fun j ↦ r j) fun j ↦ hf j
    have h₃' : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        (cokernel (biproduct.ι f i)) (∑ j : {j // j ≠ i}, r j) :=
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u}
        (cokernelBiproductιIso f i).symm h₃
    have hadd' := hadd _ (shortExact_biproduct_ι f i) (r i) _ (hf i) h₃'
    dsimp only at hadd'
    refine (hiso ht _ (Iso.refl _)).trans (hadd'.trans ?_)
    rw [Fintype.sum_eq_add_sum_subtype_ne _ i]
    refine congrArg (_ + ·) ((hiso h₃' h₃ (cokernelBiproductιIso f i)).trans ?_)
    exact ih (ι := {j // j ≠ i}) (by have := card_subtype_ne i; omega) (fun j ↦ f j) (fun j ↦ r j)
      (fun j ↦ hf j) _ h₃

variable (C : ChowSituation.{u}) (sT : T ⟶ C.S) [LocallyOfFiniteType sT]

/-- **The power sums of a finite direct sum** are the sums of the power sums, Stacks 0F9C. -/
theorem powerSumTotal_biproduct (n : ℕ) {ι : Type} [Fintype ι]
    (hn : Fintype.card ι = n) (f : ι → T.Modules) (r : ι → ℕ)
    (hf : ∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (f i) (r i))
    (t : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (⨁ f : T.Modules) t]
    (p : ℕ) :
    powerSumTotal C sT (⨁ f : T.Modules) t p =
      ∑ i, (letI := hf i; powerSumTotal C sT (f i) (r i) p) :=
  sum_biproduct_of_additive (fun M r _ ↦ powerSumTotal C sT M r p)
    (fun _ _ e ↦ powerSumTotal_eq_of_iso C sT e p)
    (fun _ hz ↦ powerSumTotal_of_isZero C sT hz p)
    (fun S hS r₁ r₂ _ _ ↦ powerSumTotal_eq_add_of_shortExact C sT S hS r₁ r₂ p)
    n hn f r hf t inferInstance

end Biproduct

/-! ### The first two Chern classes under the Whitney formula -/

section ChernPair

/-- **The first two Chern classes, with the group law of the Whitney formula.** A pair
`(c₁, c₂)` of elements of a commutative ring; pairs are added by
`(c₁, c₂) + (c₁', c₂') = (c₁ + c₁', c₂ + c₁c₁' + c₂')`, which is the degree `≤ 2` part of the
product of `1 + c₁ + c₂ + ⋯` and `1 + c₁' + c₂' + ⋯`. -/
@[ext]
structure ChernPair (A : Type*) where
  /-- The degree-one component. -/
  fst : A
  /-- The degree-two component. -/
  snd : A

namespace ChernPair

variable {A : Type*} [CommRing A]

/-- Pairs are added by the Whitney formula
`(c₁, c₂) + (c₁', c₂') = (c₁ + c₁', c₂ + c₁c₁' + c₂')`. -/
instance : Add (ChernPair A) := ⟨fun x y ↦ ⟨x.fst + y.fst, x.snd + y.snd + x.fst * y.fst⟩⟩

/-- The pair of the unit `1`. -/
instance : Zero (ChernPair A) := ⟨⟨0, 0⟩⟩

/-- The pair of an inverse: `-(c₁, c₂) = (-c₁, c₁² - c₂)`. -/
instance : Neg (ChernPair A) := ⟨fun x ↦ ⟨-x.fst, x.fst * x.fst - x.snd⟩⟩

/-- The degree-one component of a sum. -/
@[simp] theorem add_fst (x y : ChernPair A) : (x + y).fst = x.fst + y.fst := rfl

/-- The degree-two component of a sum. -/
@[simp] theorem add_snd (x y : ChernPair A) : (x + y).snd = x.snd + y.snd + x.fst * y.fst := rfl

/-- The degree-one component of `0`. -/
@[simp] theorem zero_fst : (0 : ChernPair A).fst = 0 := rfl

/-- The degree-two component of `0`. -/
@[simp] theorem zero_snd : (0 : ChernPair A).snd = 0 := rfl

/-- The degree-one component of a negative. -/
@[simp] theorem neg_fst (x : ChernPair A) : (-x).fst = -x.fst := rfl

/-- The degree-two component of a negative. -/
@[simp] theorem neg_snd (x : ChernPair A) : (-x).snd = x.fst * x.fst - x.snd := rfl

/-- The pairs form a commutative group: the group of units `1 + c₁ + c₂` of `A[t]/(t³)`. -/
instance : AddCommGroup (ChernPair A) where
  add_assoc _ _ _ := by ext <;> simp <;> ring
  zero_add _ := by ext <;> simp
  add_zero _ := by ext <;> simp
  add_comm _ _ := by ext <;> simp <;> ring
  neg_add_cancel _ := by ext <;> simp
  nsmul := nsmulRec
  zsmul := zsmulRec

/-- The pairs `(c₁, c₂)` of `ℰ`, `ℱ` and of `ℰ ⊗ ℱ` for `ℰ`, `ℱ` of ranks `r`, `s`, by the formulas
of Stacks 0FA6: `c₁ = r c₁(ℱ) + s c₁(ℰ)` and
`c₂ = r c₂(ℱ) + s c₂(ℰ) + C(r,2) c₁(ℱ)² + (rs - 1) c₁(ℱ) c₁(ℰ) + C(s,2) c₁(ℰ)²`, the binomial
coefficients being those of the integers. -/
def tensor (x y : ℤ × ChernPair A) : ChernPair A :=
  ⟨x.1 • y.2.fst + y.1 • x.2.fst,
    x.1 • y.2.snd + y.1 • x.2.snd + Ring.choose x.1 2 • y.2.fst ^ 2 +
      (x.1 * y.1 - 1) • (y.2.fst * x.2.fst) + Ring.choose y.1 2 • x.2.fst ^ 2⟩

/-- `C(r + r', 2) = C(r, 2) + r r' + C(r', 2)` for integers. -/
theorem choose_two_add (r r' : ℤ) :
    Ring.choose (r + r') 2 = Ring.choose r 2 + r * r' + Ring.choose r' 2 := by
  rw [Ring.add_choose_eq 2 (Commute.all r r')]
  simp [Finset.Nat.antidiagonal_succ]
  ring

/-- `2 C(r, 2) = r (r - 1)` for integers. -/
theorem two_mul_choose_two (r : ℤ) : 2 * Ring.choose r 2 = r * (r - 1) := by
  induction r using Int.induction_on with
  | zero => simp [Ring.choose_zero_succ]
  | succ n ih =>
    rw [show (2 : ℕ) = 1 + 1 from rfl, Ring.choose_succ_succ, Ring.choose_one_right]
    linear_combination ih
  | pred n ih =>
    have h := Ring.choose_succ_succ (-(n : ℤ) - 1) 1
    rw [sub_add_cancel, Ring.choose_one_right] at h
    rw [show ((2 : ℕ)) = 1 + 1 from rfl] at ih ⊢
    rw [h] at ih
    linear_combination ih

/-- The pairing is additive in its first variable. -/
theorem tensor_add_left (x x' y : ℤ × ChernPair A) :
    tensor (x + x') y = tensor x y + tensor x' y := by
  obtain ⟨r, a, b⟩ := x
  obtain ⟨r', a', b'⟩ := x'
  obtain ⟨s, c, d⟩ := y
  ext
  · simp [tensor, zsmul_eq_mul]
    ring
  · have hs := congrArg (Int.cast : ℤ → A) (two_mul_choose_two s)
    push_cast at hs
    simp only [tensor, Prod.mk_add_mk, add_fst, add_snd, choose_two_add, zsmul_eq_mul]
    push_cast
    linear_combination (a * a') * hs

/-- The pairing is symmetric. -/
theorem tensor_comm (x y : ℤ × ChernPair A) : tensor x y = tensor y x := by
  ext
  · simp [tensor, add_comm]
  · simp only [tensor, zsmul_eq_mul]
    push_cast
    ring

/-- The pairing is additive in its second variable. -/
theorem tensor_add_right (x y y' : ℤ × ChernPair A) :
    tensor x (y + y') = tensor x y + tensor x y' := by
  rw [tensor_comm, tensor_add_left, tensor_comm y, tensor_comm y']

/-- The pairing of Stacks 0FA6 is biadditive: it is a bilinear map of commutative groups. -/
def tensorHom : (ℤ × ChernPair A) →+ (ℤ × ChernPair A) →+ ChernPair A :=
  AddMonoidHom.mk' (fun x ↦ AddMonoidHom.mk' (tensor x) (tensor_add_right x)) fun x x' ↦
    AddMonoidHom.ext fun y ↦ tensor_add_left x x' y

/-- The bilinear map evaluates to the pairing. -/
@[simp] theorem tensorHom_apply (x y : ℤ × ChernPair A) : tensorHom x y = tensor x y := rfl

end ChernPair

end ChernPair


/-! ### The first two Chern classes of total classes, modules and bounded complexes -/

section ChernPairOf

open TotalChowClass

variable (C : ChowSituation.{u}) {T : Scheme.{u}} (sT : T ⟶ C.S) [LocallyOfFiniteType sT]

/-- The pair `(c₁, c₂)` of homogeneous parts of degrees one and two of a total class whose
homogeneous parts lie in the commutative ring `Stacks.Chow.chernUnitRing`. -/
def chernPairOf (x : TotalChowClass C sT) (hx : HasChernUnitParts C sT x) :
    ChernPair (chernUnitRing C sT) :=
  ⟨⟨TotalChowClass.homComponent 1 x, hx 1⟩, ⟨TotalChowClass.homComponent 2 x, hx 2⟩⟩

/-- The degree-one component of the pair of a class is its degree-one part. -/
@[simp] theorem chernPairOf_fst (x : TotalChowClass C sT) (hx : HasChernUnitParts C sT x) :
    ((chernPairOf C sT x hx).fst : TotalChowClass C sT) = TotalChowClass.homComponent 1 x := rfl

/-- The degree-two component of the pair of a class is its degree-two part. -/
@[simp] theorem chernPairOf_snd (x : TotalChowClass C sT) (hx : HasChernUnitParts C sT x) :
    ((chernPairOf C sT x hx).snd : TotalChowClass C sT) = TotalChowClass.homComponent 2 x := rfl

/-- The pair of a class does not depend on the proof that its parts are Chern classes. -/
theorem chernPairOf_congr {x y : TotalChowClass C sT} (h : x = y) (hx : HasChernUnitParts C sT x)
    (hy : HasChernUnitParts C sT y) : chernPairOf C sT x hx = chernPairOf C sT y hy := by
  subst h
  rfl

/-- **The pairs of a product add**, for classes of degree-zero part `1`: the degree `≤ 2` part of
the Whitney formula. -/
theorem chernPairOf_mul {x y : TotalChowClass C sT} (hx : HasChernUnitParts C sT x)
    (hy : HasChernUnitParts C sT y) (hx0 : TotalChowClass.homComponent 0 x = 1)
    (hy0 : TotalChowClass.homComponent 0 y = 1) :
    chernPairOf C sT (x * y) (hx.mul C sT hy) = chernPairOf C sT x hx + chernPairOf C sT y hy := by
  refine ChernPair.ext (Subtype.ext ?_) (Subtype.ext ?_)
  · show TotalChowClass.homComponent 1 (x * y) =
      TotalChowClass.homComponent 1 x + TotalChowClass.homComponent 1 y
    simp [TotalChowClass.homComponent_mul_sum, Finset.sum_range_succ, hx0, hy0]
  · show TotalChowClass.homComponent 2 (x * y) =
      TotalChowClass.homComponent 2 x + TotalChowClass.homComponent 2 y +
        TotalChowClass.homComponent 1 x * TotalChowClass.homComponent 1 y
    simp [TotalChowClass.homComponent_mul_sum, Finset.sum_range_succ, hx0, hy0]
    abel

/-- The pair of `1` is zero. -/
theorem chernPairOf_one : chernPairOf C sT 1 (hasChernUnitParts_one C sT) = 0 := by
  refine ChernPair.ext (Subtype.ext ?_) (Subtype.ext ?_)
  · exact isHomogeneous_one.homPart_of_ne one_ne_zero
  · exact isHomogeneous_one.homPart_of_ne two_ne_zero

/-- **The pair of an inverse is the negative.** -/
theorem chernPairOf_inv (u : (TotalChowClass C sT)ˣ)
    (hu : HasChernUnitParts C sT (u : TotalChowClass C sT))
    (hu' : HasChernUnitParts C sT ((u⁻¹ : (TotalChowClass C sT)ˣ) : TotalChowClass C sT))
    (hu0 : TotalChowClass.homComponent 0 (u : TotalChowClass C sT) = 1) :
    chernPairOf C sT _ hu' = -chernPairOf C sT _ hu := by
  have h := chernPairOf_mul C sT hu hu' hu0 (homPart_zero_inv u hu0)
  rw [chernPairOf_congr C sT u.mul_inv _ (hasChernUnitParts_one C sT), chernPairOf_one] at h
  exact (neg_eq_of_add_eq_zero_right h.symm).symm

/-- The pair `(c₁(ℰ), c₂(ℰ))` of a finite locally free module of constant rank. -/
def moduleChernPair (M : T.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r] :
    ChernPair (chernUnitRing C sT) :=
  chernPairOf C sT (totalChern C sT M r) (hasChernUnitParts_totalChern C sT M r)

/-- The pair of a module does not depend on how the module or its rank is presented. -/
theorem moduleChernPair_congr {M M' : T.Modules} {r r' : ℕ}
    [hM : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r]
    [hM' : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M' r']
    (e : M ≅ M') : moduleChernPair C sT M r = moduleChernPair C sT M' r' := by
  rcases isEmpty_or_nonempty T with hT | ⟨⟨y⟩⟩
  · have := TotalChowClass.subsingleton_of_isEmpty sT
    exact ChernPair.ext (Subtype.ext (Subsingleton.elim _ _)) (Subtype.ext (Subsingleton.elim _ _))
  · obtain rfl : r = r' := Scheme.Modules.isFiniteLocallyFreeOfRank_unique M'
      (AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u} e hM) hM' y
    exact chernPairOf_congr C sT (totalChern_congr C sT e rfl) _ _

/-- **The Whitney formula for the pairs.** -/
theorem moduleChernPair_of_shortExact (S : ShortComplex T.Modules) (hS : S.ShortExact)
    (r₁ r₂ : ℕ) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₃ r₂] :
    haveI := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S hS r₁ r₂ ‹_› ‹_›
    moduleChernPair C sT S.X₂ (r₁ + r₂) =
      moduleChernPair C sT S.X₁ r₁ + moduleChernPair C sT S.X₃ r₂ := by
  have := GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact S hS r₁ r₂ ‹_› ‹_›
  rw [moduleChernPair, chernPairOf_congr C sT (totalChern_eq_mul_of_shortExact C sT S hS r₁ r₂) _
    ((hasChernUnitParts_totalChern C sT _ r₁).mul C sT (hasChernUnitParts_totalChern C sT _ r₂)),
    chernPairOf_mul C sT _ _ (homPart_zero_totalChern C sT _ _) (homPart_zero_totalChern C sT _ _)]
  rfl

/-- **The pair of a finite direct sum** is the sum of the pairs. -/
theorem moduleChernPair_biproduct (n : ℕ) {ι : Type} [Fintype ι]
    (hn : Fintype.card ι = n) (f : ι → T.Modules) (r : ι → ℕ)
    (hf : ∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (f i) (r i))
    (t : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (⨁ f : T.Modules) t] :
    moduleChernPair C sT (⨁ f : T.Modules) t =
      ∑ i, (letI := hf i; moduleChernPair C sT (f i) (r i)) :=
  sum_biproduct_of_additive (fun M r _ ↦ moduleChernPair C sT M r)
    (fun _ _ e ↦ moduleChernPair_congr C sT e)
    (fun _ hz ↦ by
      rw [moduleChernPair, chernPairOf_congr C sT (totalChern_of_isZero C sT hz) _
        (hasChernUnitParts_one C sT), chernPairOf_one])
    (fun S hS r₁ r₂ _ _ ↦ moduleChernPair_of_shortExact C sT S hS r₁ r₂)
    n hn f r hf t inferInstance

/-- **Stacks 0FA6 for the pairs**: the pair of `ℰ ⊗ ℱ` is the pairing of those of `ℰ` and `ℱ`
with their ranks. -/
theorem moduleChernPair_sheafTensor (M N : T.Modules) (r s : ℕ)
    [hM : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r]
    [hN : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} N s] :
    letI : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        (R := T.ringCatSheaf) _ _ :=
        isFiniteLocallyFreeOfRank_tensor hM hN
    moduleChernPair C sT (((sheafTensor T.sheaf).obj M).obj N) (r * s) =
      ChernPair.tensor ((r : ℤ), moduleChernPair C sT M r) ((s : ℤ), moduleChernPair C sT N s) := by
  let : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (R := T.ringCatSheaf) _ _ :=
      isFiniteLocallyFreeOfRank_tensor hM hN
  obtain ⟨h₁, h₂⟩ := tensorChernRelations_totalChern C r s sT M N
  refine ChernPair.ext (Subtype.ext ?_) (Subtype.ext ?_)
  · show TotalChowClass.homComponent 1 (totalChern C sT _ (r * s)) = _
    rw [h₁]
    simp [ChernPair.tensor, moduleChernPair, chernPairOf]
  · show TotalChowClass.homComponent 2 (totalChern C sT _ (r * s)) = _
    rw [h₂]
    simp [ChernPair.tensor, moduleChernPair, chernPairOf, Ring.choose_natCast]

variable (P : CochainComplex T.Modules ℤ) (ρ : ℤ →₀ ℕ)
  (hP : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (P.X n) (ρ n))

/-- The ordered product `∏_{n ∈ l} c(P^n)^{(-1)^n}` has its homogeneous parts in
`Stacks.Chow.chernUnitRing`, its degree-`0` part is `1`, and its pair is
`∑_{n ∈ l} (-1)^n (c₁(P^n), c₂(P^n))`. -/
theorem chernPairOf_complexChernFactor_list_prod (l : List ℤ) :
    ∃ h : HasChernUnitParts C sT ((l.map (complexChernFactor C sT P ρ hP)).prod :
        TotalChowClass C sT),
      TotalChowClass.homComponent 0
          ((l.map (complexChernFactor C sT P ρ hP)).prod : TotalChowClass C sT) = 1 ∧
      chernPairOf C sT _ h =
        (l.map fun n ↦ (n.negOnePow : ℤ) • (letI := hP n; moduleChernPair C sT (P.X n) (ρ n))).sum
    := by
  induction l with
  | nil =>
    have he : (([] : List ℤ).map (complexChernFactor C sT P ρ hP)).prod.val = 1 := by simp
    refine ⟨he ▸ hasChernUnitParts_one C sT, he ▸ isHomogeneous_one.homComponent_self, ?_⟩
    rw [chernPairOf_congr C sT he _ (hasChernUnitParts_one C sT), chernPairOf_one]
    simp
  | cons a l ih =>
    obtain ⟨h, h0, hl⟩ := ih
    let := hP a
    have h0a := homPart_zero_totalChern C sT (P.X a) (ρ a)
    have key : ∃ ha : HasChernUnitParts C sT (complexChernFactor C sT P ρ hP a :
          TotalChowClass C sT), TotalChowClass.homComponent 0 (complexChernFactor C sT P ρ hP a :
          TotalChowClass C sT) = 1 ∧ chernPairOf C sT _ ha =
          (a.negOnePow : ℤ) • moduleChernPair C sT (P.X a) (ρ a) := by
      rcases Int.units_eq_one_or a.negOnePow with he | he
      · have hf : (complexChernFactor C sT P ρ hP a : TotalChowClass C sT) =
            totalChern C sT (P.X a) (ρ a) := by
          rw [complexChernFactor, he, Units.val_one, zpow_one, val_totalChernUnit]
        refine ⟨hf ▸ hasChernUnitParts_totalChern C sT (P.X a) (ρ a), hf ▸ h0a, ?_⟩
        rw [chernPairOf_congr C sT hf _ (hasChernUnitParts_totalChern C sT (P.X a) (ρ a)), he,
          Units.val_one, one_smul]
        rfl
      · have hf : (complexChernFactor C sT P ρ hP a : TotalChowClass C sT) =
            (((totalChernUnit C sT (P.X a) (ρ a))⁻¹ : (TotalChowClass C sT)ˣ) :
              TotalChowClass C sT) := by
          rw [complexChernFactor, he, Units.val_neg, Units.val_one, zpow_neg_one]
        refine ⟨hf ▸ hasChernUnitParts_totalChernUnit_inv C sT (P.X a) (ρ a),
          hf ▸ homPart_zero_inv _ h0a, ?_⟩
        rw [chernPairOf_congr C sT hf _ (hasChernUnitParts_totalChernUnit_inv C sT (P.X a) (ρ a)),
          chernPairOf_inv C sT _ (hasChernUnitParts_totalChern C sT (P.X a) (ρ a)) _ h0a, he,
          Units.val_neg, Units.val_one, neg_one_smul]
        rfl
    obtain ⟨ha, ha0, hpa⟩ := key
    have he : ((a :: l).map (complexChernFactor C sT P ρ hP)).prod.val =
        (complexChernFactor C sT P ρ hP a : TotalChowClass C sT) *
          ((l.map (complexChernFactor C sT P ρ hP)).prod : TotalChowClass C sT) := by
      rw [List.map_cons, List.prod_cons, Units.val_mul]
    refine ⟨he ▸ ha.mul C sT h, he ▸ homPart_zero_mul ha0 h0, ?_⟩
    rw [chernPairOf_congr C sT he _ (ha.mul C sT h), chernPairOf_mul C sT ha h ha0 h0, hpa, hl,
      List.map_cons, List.sum_cons]

/-- **The pair of a bounded complex of constant ranks**: `c(P) = ∏_n c(P^n)^{(-1)^n}` has
degree-`0` part `1`, homogeneous parts in `Stacks.Chow.chernUnitRing`, and pair
`∑_n (-1)^n (c₁(P^n), c₂(P^n))`, over any finite set of degrees outside of which the ranks
vanish. -/
theorem chernPairOf_complexChernBounded (s : Finset ℤ) (hs : ∀ n ∉ s, ρ n = 0) :
    ∃ h : HasChernUnitParts C sT (complexChernBounded C sT P ρ hP),
      TotalChowClass.homComponent 0 (complexChernBounded C sT P ρ hP) = 1 ∧
      chernPairOf C sT _ h =
        ∑ n ∈ s, (n.negOnePow : ℤ) • (letI := hP n; moduleChernPair C sT (P.X n) (ρ n)) := by
  obtain ⟨h, h0, hl⟩ := chernPairOf_complexChernFactor_list_prod C sT P ρ hP (s.sort (· ≤ ·))
  have hb : complexChernBounded C sT P ρ hP =
      ((s.sort (· ≤ ·)).map (complexChernFactor C sT P ρ hP)).prod.val := by
    rw [complexChernBounded_eq_prod C sT P ρ hP s hs]
    rfl
  refine ⟨hb ▸ h, hb ▸ h0, ?_⟩
  rw [chernPairOf_congr C sT hb _ h, hl, ← List.sum_toFinset _ (s.sort_nodup _),
    Finset.sort_toFinset]

/-- The pair of a bounded complex of constant ranks, summed over the support of the ranks. -/
private theorem chernPairOf_complexChernBounded_support :
    ∃ h : HasChernUnitParts C sT (complexChernBounded C sT P ρ hP),
      TotalChowClass.homComponent 0 (complexChernBounded C sT P ρ hP) = 1 ∧
      chernPairOf C sT _ h =
        ∑ n ∈ ρ.support, (n.negOnePow : ℤ) •
          (letI := hP n; moduleChernPair C sT (P.X n) (ρ n)) :=
  chernPairOf_complexChernBounded C sT P ρ hP ρ.support fun _ hn ↦ Finsupp.notMem_support_iff.1 hn

end ChernPairOf

/-! ### The total tensor complex -/

section TotalComplex

variable {T : Scheme.{u}}

/-- **The total tensor complex** `Tot(K ⊗_{𝒪_T} L)` of two complexes of `𝒪_T`-modules, whose
degree-`n` term is `⨁_{a + b = n} K^a ⊗ L^b`. -/
abbrev tensorTotal (K L : CochainComplex T.Modules ℤ) : CochainComplex T.Modules ℤ :=
  ((Stacks.SheafOfModules.Tensor.tensorComplex T.sheaf).obj K).obj L

/-- A tensor product with a zero factor is zero. -/
theorem isZero_sheafTensor {M N : T.Modules} (h : IsZero M ∨ IsZero N) :
    IsZero (((sheafTensor T.sheaf).obj M).obj N) := by
  rcases h with h | h
  · exact CochainComplex.KFlatBifunctor.isZero_obj_obj_of_isZero (sheafTensor T.sheaf) h N
  · exact (CochainComplex.KFlatBifunctor.isZero_obj_obj_of_isZero (sheafTensor T.sheaf) h M).of_iso
      (((Stacks.SheafOfModules.Tensor.sheafTensorBraiding T.sheaf).app M).app N)

/-- The degree-`n` term of `Tot(K ⊗ L)` is the coproduct of the `K^a ⊗ L^b`, `a + b = n`. -/
def isColimitTensorTotalX (K L : CochainComplex T.Modules ℤ) (n : ℤ) :
    IsColimit (Cofan.mk ((tensorTotal K L).X n) fun j :
      ((ComplexShape.up ℤ).π (ComplexShape.up ℤ) (ComplexShape.up ℤ) ⁻¹' {n}) ↦
        (show (show T.Modules from ((sheafTensor T.sheaf).obj (K.X j.1.1)).obj (L.X j.1.2)) ⟶
          (tensorTotal K L).X n from
        (GradedObject.cofanMapObj ((((sheafTensor T.sheaf).mapBifunctorHomologicalComplex
          (ComplexShape.up ℤ) (ComplexShape.up ℤ)).obj K).obj L).toGradedObject
          ((ComplexShape.up ℤ).π (ComplexShape.up ℤ) (ComplexShape.up ℤ)) n).inj j)) :=
  have hc := GradedObject.isColimitCofanMapObj
      ((((sheafTensor T.sheaf).mapBifunctorHomologicalComplex (ComplexShape.up ℤ)
        (ComplexShape.up ℤ)).obj K).obj L).toGradedObject
      ((ComplexShape.up ℤ).π (ComplexShape.up ℤ) (ComplexShape.up ℤ)) n
  Cofan.IsColimit.mk _ (fun t ↦ hc.desc (Cofan.mk t.pt t.inj))
    (fun t j ↦ hc.fac (Cofan.mk t.pt t.inj) ⟨j⟩)
    (fun t m hm ↦ hc.uniq (Cofan.mk t.pt t.inj) m fun j ↦ hm j.as)

/-- The fibre `{(a, b) | a + b = n}` of the total degree. -/
abbrev TotalFiber (n : ℤ) : Type :=
  ((ComplexShape.up ℤ).π (ComplexShape.up ℤ) (ComplexShape.up ℤ) ⁻¹' {n})

/-- The summand `K^a ⊗ L^b` of the total tensor complex indexed by `(a, b)`. -/
abbrev tensorSummand (K L : CochainComplex T.Modules ℤ) {n : ℤ} (j : TotalFiber n) : T.Modules :=
  show T.Modules from ((sheafTensor T.sheaf).obj (K.X j.1.1)).obj (L.X j.1.2)

/-- **The pullback of a term of a total tensor complex with finitely many nonzero summands.** If
the pullback along `g` of the summand `K^a ⊗ L^b` of `Tot(K ⊗ L)^n` vanishes for `(a, b)` outside
a finite set `S`, then the pullback of `Tot(K ⊗ L)^n` is the finite direct sum of the pullbacks
of the summands indexed by `S`: pullback is a left adjoint, so it preserves coproducts. -/
def pullbackTensorTotalXIso {T' : Scheme.{u}} (g : T' ⟶ T) (K L : CochainComplex T.Modules ℤ)
    (n : ℤ) (S : Finset (TotalFiber n))
    (hz : ∀ j ∉ S, IsZero ((Scheme.Modules.pullback g).obj (tensorSummand K L j))) :
    (Scheme.Modules.pullback g).obj ((tensorTotal K L).X n) ≅
      ⨁ fun j : S ↦ (Scheme.Modules.pullback g).obj (tensorSummand K L j.1) :=
  have : PreservesColimitsOfSize.{0, 0} (Scheme.Modules.pullback g) :=
    (Scheme.Modules.pullbackPushforwardAdjunction g).leftAdjoint_preservesColimits
  cofanPtIsoBiproduct ((Cofan.isColimitMapCoconeEquiv _ _ _)
    (isColimitOfPreserves (Scheme.Modules.pullback g) (isColimitTensorTotalX K L n))) S hz

end TotalComplex

/-! ### The total tensor complex on a piece of constant ranks -/

section Piece

variable (ρ σ : ℤ →₀ ℕ)

open Classical in
/-- The pairs `(a, b)` with `a + b = n` at which both rank functions are nonzero. -/
def tensorSupport (n : ℤ) : Finset (TotalFiber n) :=
  (ρ.support ×ˢ σ.support).subtype
    (· ∈ (ComplexShape.up ℤ).π (ComplexShape.up ℤ) (ComplexShape.up ℤ) ⁻¹' {n})

/-- A pair of degrees indexes a summand of nonzero rank exactly when both ranks are nonzero. -/
theorem mem_tensorSupport {n : ℤ} (j : TotalFiber n) :
    j ∈ tensorSupport ρ σ n ↔ j.1.1 ∈ ρ.support ∧ j.1.2 ∈ σ.support := by
  simp [tensorSupport, Finset.mem_subtype, Finset.mem_product]

/-- The rank `∑_{a + b = n} ρ(a) σ(b)` of the degree-`n` term of a total tensor complex. -/
def tensorRankFun (n : ℤ) : ℕ :=
  ∑ j : tensorSupport ρ σ n, ρ j.1.1.1 * σ j.1.1.2

/-- The ranks of the terms of a total tensor complex, as a finitely supported function. -/
def tensorRank : ℤ →₀ ℕ :=
  Finsupp.onFinset ((ρ.support ×ˢ σ.support).image fun x ↦ x.1 + x.2) (tensorRankFun ρ σ)
    fun n hn ↦ by
      obtain ⟨j, -, -⟩ := Finset.exists_ne_zero_of_sum_ne_zero hn
      rw [Finset.mem_image]
      exact ⟨j.1.1, Finset.mem_product.2 ((mem_tensorSupport ρ σ j.1).1 j.2), j.1.2⟩

/-- The rank function of the total complex evaluates to `∑_{a + b = n} ρ(a) σ(b)`. -/
theorem tensorRank_apply (n : ℤ) : tensorRank ρ σ n = tensorRankFun ρ σ n :=
  Finsupp.onFinset_apply

/-- A sum of two degrees of nonzero ranks lies in the window of the total complex. -/
theorem mem_image_add_of_mem_support (a b : ℤ) (ha : a ∈ ρ.support) (hb : b ∈ σ.support) :
    a + b ∈ (ρ.support ×ˢ σ.support).image fun x ↦ x.1 + x.2 :=
  Finset.mem_image.2 ⟨(a, b), Finset.mem_product.2 ⟨ha, hb⟩, rfl⟩

/-- Outside the window the total complex has rank zero. -/
theorem tensorRank_eq_zero_of_notMem (n : ℤ)
    (hn : n ∉ (ρ.support ×ˢ σ.support).image fun x ↦ x.1 + x.2) : tensorRank ρ σ n = 0 :=
  Finsupp.notMem_support_iff.1 fun h ↦ hn (Finsupp.support_onFinset_subset h)

/-- The alternating rank `∑_a (-1)^a ρ(a)` of a complex of constant ranks `ρ`. -/
def alternatingRank : ℤ :=
  ∑ a ∈ ρ.support, (a.negOnePow : ℤ) * (ρ a : ℤ)

/-- **The alternating double sum over the pieces of a total tensor complex.** Summing over the
degrees `n` the terms indexed by the pairs `(a, b)` with `a + b = n`, with the sign `(-1)^n`, is
summing over all pairs `(a, b)` with the sign `(-1)^a (-1)^b`. -/
theorem sum_tensorSupport {M : Type*} [AddCommGroup M] (F : ℤ → ℤ → M) (N : Finset ℤ)
    (hN : ∀ a ∈ ρ.support, ∀ b ∈ σ.support, a + b ∈ N) :
    ∑ n ∈ N, (n.negOnePow : ℤ) • ∑ j : tensorSupport ρ σ n, F j.1.1.1 j.1.1.2 =
      ∑ a ∈ ρ.support, ∑ b ∈ σ.support, ((a.negOnePow : ℤ) * (b.negOnePow : ℤ)) • F a b := by
  classical
  have h₁ : ∀ n, ∑ j : tensorSupport ρ σ n, F j.1.1.1 j.1.1.2 =
      ∑ x ∈ (ρ.support ×ˢ σ.support).filter (fun x ↦ x.1 + x.2 = n), F x.1 x.2 := by
    intro n
    rw [Finset.sum_coe_sort (tensorSupport ρ σ n) (fun j ↦ F j.1.1 j.1.2), tensorSupport,
      Finset.sum_subtype_eq_sum_filter (fun x : ℤ × ℤ ↦ F x.1 x.2)]
    refine Finset.sum_congr (Finset.filter_congr fun x _ ↦ ?_) fun _ _ ↦ rfl
    exact Iff.rfl
  simp_rw [h₁, Finset.smul_sum]
  rw [← Finset.sum_product']
  rw [← Finset.sum_fiberwise_of_maps_to (s := ρ.support ×ˢ σ.support) (t := N)
    (g := fun x ↦ x.1 + x.2) (fun x hx ↦ hN _ (Finset.mem_product.1 hx).1 _
      (Finset.mem_product.1 hx).2)
    (fun x ↦ ((x.1.negOnePow : ℤ) * (x.2.negOnePow : ℤ)) • F x.1 x.2)]
  refine Finset.sum_congr rfl fun n _ ↦ Finset.sum_congr rfl fun x hx ↦ ?_
  rw [(Finset.mem_filter.1 hx).2.symm, Int.negOnePow_add, Units.val_mul]

end Piece

/-! ### Power sums and Chern classes of the total tensor complex on a piece of constant ranks -/

section PieceClasses

open TotalChowClass

variable (C : ChowSituation.{u}) {Y T : Scheme.{u}} (sT : T ⟶ C.S) [LocallyOfFiniteType sT]
  (g : T ⟶ Y) (P Q : CochainComplex Y.Modules ℤ) (ρ σ : ℤ →₀ ℕ)
  (hρ : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
    ((pullbackComplex g P).X n) (ρ n))
  (hσ : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
    ((pullbackComplex g Q).X n) (σ n))

include hρ hσ

/-- The pullback of the summand `P^a ⊗ Q^b` is finite locally free of rank `ρ(a) σ(b)`. -/
theorem isFiniteLocallyFreeOfRank_pullback_tensorSummand {n : ℤ} (j : TotalFiber n) :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback g).obj (tensorSummand P Q j)) (ρ j.1.1 * σ j.1.2) :=
  AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u}
    (sheafTensorPullbackIso g _ _).symm (isFiniteLocallyFreeOfRank_tensor (hρ _) (hσ _))

/-- Outside the pairs of nonzero ranks the pullback of the summand `P^a ⊗ Q^b` vanishes. -/
theorem isZero_pullback_tensorSummand {n : ℤ} (j : TotalFiber n)
    (hj : j ∉ tensorSupport ρ σ n) :
    IsZero ((Scheme.Modules.pullback g).obj (tensorSummand P Q j)) := by
  have h0 : ρ j.1.1 = 0 ∨ σ j.1.2 = 0 := by
    rw [mem_tensorSupport, Finsupp.mem_support_iff, Finsupp.mem_support_iff] at hj
    tauto
  have hz : IsZero ((pullbackComplex g P).X j.1.1) ∨ IsZero ((pullbackComplex g Q).X j.1.2) := by
    rcases h0 with h0 | h0
    · have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
          ((pullbackComplex g P).X j.1.1) 0 := by rw [← h0]; exact hρ _
      exact Or.inl (isZero_of_isFiniteLocallyFreeOfRank_zero _)
    · have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
          ((pullbackComplex g Q).X j.1.2) 0 := by rw [← h0]; exact hσ _
      exact Or.inr (isZero_of_isFiniteLocallyFreeOfRank_zero _)
  exact (isZero_sheafTensor hz).of_iso (sheafTensorPullbackIso g _ _)

/-- **The pulled back terms of the total tensor complex are finite direct sums**:
`g^*Tot(P ⊗ Q)^n ≅ ⨁_{a + b = n} g^*(P^a ⊗ Q^b)`, over the pairs of nonzero ranks. -/
def pullbackTensorTotalPieceIso (n : ℤ) :
    (pullbackComplex g (tensorTotal P Q)).X n ≅
      ⨁ fun j : tensorSupport ρ σ n ↦ (Scheme.Modules.pullback g).obj (tensorSummand P Q j.1) :=
  pullbackTensorTotalXIso g P Q n (tensorSupport ρ σ n)
    (isZero_pullback_tensorSummand g P Q ρ σ hρ hσ)

/-- The pulled back total tensor complex has terms of the constant ranks
`∑_{a + b = n} ρ(a) σ(b)`. -/
theorem isFiniteLocallyFreeOfRank_pullbackComplex_tensorTotal (n : ℤ) :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((pullbackComplex g (tensorTotal P Q)).X n) (tensorRank ρ σ n) := by
  rw [tensorRank_apply]
  exact AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u}
    (pullbackTensorTotalPieceIso g P Q ρ σ hρ hσ n).symm
    (isFiniteLocallyFreeOfRank_biproduct _ rfl _ _ fun j ↦
      isFiniteLocallyFreeOfRank_pullback_tensorSummand g P Q ρ σ hρ hσ j.1)

/-- **The power sums of the total tensor complex on a piece of constant ranks**:
`P_p(Tot) = ∑_{p₁ + p₂ = p} C(p, p₁) P_{p₁}(P) P_{p₂}(Q)`, by Stacks 0F9D for each pair of terms
(`Stacks.Chow.powerSumTotal_sheafTensor`) and additivity. -/
theorem powerSumComplexBounded_tensorTotal (τ : ℤ →₀ ℕ)
    (hτ : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((pullbackComplex g (tensorTotal P Q)).X n) (τ n)) (p : ℕ) :
    powerSumComplexBounded C sT (pullbackComplex g (tensorTotal P Q)) τ hτ p =
      ∑ q ∈ antidiagonal p, (p.choose q.1 : ℤ) •
        (powerSumComplexBounded C sT (pullbackComplex g P) ρ hρ q.1 *
          powerSumComplexBounded C sT (pullbackComplex g Q) σ hσ q.2) := by
  have hT := isFiniteLocallyFreeOfRank_pullbackComplex_tensorTotal g P Q ρ σ hρ hσ
  rw [powerSumComplexBounded_congr C sT _ (fun n ↦ Iso.refl _) τ (tensorRank ρ σ) hτ hT p,
    powerSumComplexBounded_eq_sum C sT _ _ hT p _ (tensorRank_eq_zero_of_notMem ρ σ)]
  have hterm : ∀ n, (let := hT n; powerSumTotal C sT ((pullbackComplex g (tensorTotal P Q)).X n)
      (tensorRank ρ σ n) p) = ∑ j : tensorSupport ρ σ n, ∑ q ∈ antidiagonal p,
        (p.choose q.1 : ℤ) • ((let := hρ j.1.1.1; powerSumTotal C sT
          ((pullbackComplex g P).X j.1.1.1) (ρ j.1.1.1) q.1) *
          (let := hσ j.1.1.2; powerSumTotal C sT ((pullbackComplex g Q).X j.1.1.2)
            (σ j.1.1.2) q.2)) := by
    intro n
    let := hT n
    let hS := fun j : tensorSupport ρ σ n ↦
      isFiniteLocallyFreeOfRank_pullback_tensorSummand g P Q ρ σ hρ hσ j.1
    let := isFiniteLocallyFreeOfRank_biproduct _ rfl _ _ hS
    rw [powerSumTotal_eq_of_iso C sT (r' := ∑ j : tensorSupport ρ σ n, ρ j.1.1.1 * σ j.1.1.2)
        (pullbackTensorTotalPieceIso g P Q ρ σ hρ hσ n) p,
      powerSumTotal_biproduct C sT _ rfl _ _ hS]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    exact (@powerSumTotal_eq_of_iso C T sT _ _ _ _ _ (hS j)
      (isFiniteLocallyFreeOfRank_tensor (hρ j.1.1.1) (hσ j.1.1.2))
      (sheafTensorPullbackIso g _ _) p).trans
      (@powerSumTotal_sheafTensor C T sT _ _ _ (ρ j.1.1.1) (σ j.1.1.2) (hρ j.1.1.1) (hσ j.1.1.2) p)
  simp_rw [hterm]
  rw [sum_tensorSupport ρ σ (fun a b ↦ ∑ q ∈ antidiagonal p, (p.choose q.1 : ℤ) •
      ((let := hρ a; powerSumTotal C sT ((pullbackComplex g P).X a) (ρ a) q.1) *
        (let := hσ b; powerSumTotal C sT ((pullbackComplex g Q).X b) (σ b) q.2))) _
      fun a ha b hb ↦ mem_image_add_of_mem_support ρ σ a b ha hb]
  simp only [powerSumComplexBounded, Finset.sum_mul, Finset.mul_sum, Finset.smul_sum,
    smul_mul_smul_comm, smul_smul]
  rw [Finset.sum_comm]
  refine (Finset.sum_congr rfl fun b _ ↦ Finset.sum_comm).trans (Finset.sum_comm.trans ?_)
  refine Finset.sum_congr rfl fun q _ ↦ Finset.sum_congr rfl fun b _ ↦
    Finset.sum_congr rfl fun a _ ↦ ?_
  congr 1
  ring

/-- **The first two Chern classes of the total tensor complex on a piece of constant ranks**:
the pair `(c₁, c₂)` of `Tot(P ⊗ Q)` is the pairing of Stacks 0FA6 of the pairs of `P` and `Q`,
with their alternating ranks. -/
theorem chernPairOf_complexChernBounded_tensorTotal (τ : ℤ →₀ ℕ)
    (hτ : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((pullbackComplex g (tensorTotal P Q)).X n) (τ n))
    (h : HasChernUnitParts C sT
      (complexChernBounded C sT (pullbackComplex g (tensorTotal P Q)) τ hτ))
    (h₁ : HasChernUnitParts C sT (complexChernBounded C sT (pullbackComplex g P) ρ hρ))
    (h₂ : HasChernUnitParts C sT (complexChernBounded C sT (pullbackComplex g Q) σ hσ)) :
    chernPairOf C sT _ h = ChernPair.tensor
      (alternatingRank ρ, chernPairOf C sT _ h₁) (alternatingRank σ, chernPairOf C sT _ h₂) := by
  have hT := isFiniteLocallyFreeOfRank_pullbackComplex_tensorTotal g P Q ρ σ hρ hσ
  obtain ⟨hT', -, hTe⟩ := chernPairOf_complexChernBounded C sT _ _ hT _
    (tensorRank_eq_zero_of_notMem ρ σ)
  obtain ⟨hP', -, hPe⟩ := chernPairOf_complexChernBounded_support C sT _ ρ hρ
  obtain ⟨hQ', -, hQe⟩ := chernPairOf_complexChernBounded_support C sT _ σ hσ
  rw [chernPairOf_congr C sT (complexChernBounded_congr C sT _ (fun n ↦ Iso.refl _) τ
      (tensorRank ρ σ) hτ hT) h hT', hTe, chernPairOf_congr C sT rfl h₁ hP', hPe,
    chernPairOf_congr C sT rfl h₂ hQ', hQe]
  have hterm : ∀ n, (let := hT n; moduleChernPair C sT
      ((pullbackComplex g (tensorTotal P Q)).X n) (tensorRank ρ σ n)) =
      ∑ j : tensorSupport ρ σ n, ChernPair.tensor
        ((ρ j.1.1.1 : ℤ), (let := hρ j.1.1.1; moduleChernPair C sT
          ((pullbackComplex g P).X j.1.1.1) (ρ j.1.1.1)))
        ((σ j.1.1.2 : ℤ), (let := hσ j.1.1.2; moduleChernPair C sT
          ((pullbackComplex g Q).X j.1.1.2) (σ j.1.1.2))) := by
    intro n
    let := hT n
    let hS := fun j : tensorSupport ρ σ n ↦
      isFiniteLocallyFreeOfRank_pullback_tensorSummand g P Q ρ σ hρ hσ j.1
    let := isFiniteLocallyFreeOfRank_biproduct _ rfl _ _ hS
    rw [moduleChernPair_congr C sT (r' := ∑ j : tensorSupport ρ σ n, ρ j.1.1.1 * σ j.1.1.2)
        (pullbackTensorTotalPieceIso g P Q ρ σ hρ hσ n),
      moduleChernPair_biproduct C sT _ rfl _ _ hS]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    exact (@moduleChernPair_congr C T sT _ _ _ _ _ (hS j)
      (isFiniteLocallyFreeOfRank_tensor (hρ j.1.1.1) (hσ j.1.1.2))
      (sheafTensorPullbackIso g _ _)).trans
      (@moduleChernPair_sheafTensor C T sT _ _ _ (ρ j.1.1.1) (σ j.1.1.2) (hρ j.1.1.1)
        (hσ j.1.1.2))
  simp_rw [hterm]
  rw [sum_tensorSupport ρ σ (fun a b ↦ ChernPair.tensor
      ((ρ a : ℤ), (let := hρ a; moduleChernPair C sT ((pullbackComplex g P).X a) (ρ a)))
      ((σ b : ℤ), (let := hσ b; moduleChernPair C sT ((pullbackComplex g Q).X b) (σ b)))) _
      fun a ha b hb ↦ mem_image_add_of_mem_support ρ σ a b ha hb]
  have hx : ∀ (ρ' : ℤ →₀ ℕ) (F : ℤ → ChernPair (chernUnitRing C sT)),
      (alternatingRank ρ', ∑ a ∈ ρ'.support, (a.negOnePow : ℤ) • F a) =
        ∑ a ∈ ρ'.support, (a.negOnePow : ℤ) • ((ρ' a : ℤ), F a) := fun ρ' F ↦ by
    refine Prod.ext ?_ ?_ <;> simp [alternatingRank, Prod.fst_sum, Prod.snd_sum]
  rw [hx ρ, hx σ, ← ChernPair.tensorHom_apply]
  simp only [map_sum, map_zsmul, AddMonoidHom.finset_sum_apply, AddMonoidHom.smul_apply,
    Finset.smul_sum, smul_smul, ChernPair.tensorHom_apply]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun b _ ↦ Finset.sum_congr rfl fun a _ ↦ ?_
  rw [mul_comm]

end PieceClasses

/-! ### The total tensor complex of two locally bounded complexes of finite locally free modules -/

section LocallyBounded

variable {Y T : Scheme.{u}}

open Classical in
/-- **The pullback of the total tensor complex of two bounded complexes.** If the pullbacks along
`g` of `P` and `Q` are finite locally free and vanish outside `[lo, hi]` and `[lo', hi']`, the
pullbacks of the terms of `Tot(P ⊗ Q)` are finite locally free and vanish outside
`[lo + lo', hi + hi']`. -/
theorem pullback_tensorTotal_X (g : T ⟶ Y) (P Q : CochainComplex Y.Modules ℤ) (lo hi lo' hi' : ℤ)
    (hPf : ∀ a, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
      ((Scheme.Modules.pullback g).obj (P.X a)))
    (hQf : ∀ b, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
      ((Scheme.Modules.pullback g).obj (Q.X b)))
    (hP0 : ∀ a, a < lo ∨ hi < a → IsZero ((Scheme.Modules.pullback g).obj (P.X a)))
    (hQ0 : ∀ b, b < lo' ∨ hi' < b → IsZero ((Scheme.Modules.pullback g).obj (Q.X b))) (n : ℤ) :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
      ((Scheme.Modules.pullback g).obj ((tensorTotal P Q).X n)) ∧
      (n < lo + lo' ∨ hi + hi' < n →
        IsZero ((Scheme.Modules.pullback g).obj ((tensorTotal P Q).X n))) := by
  let S : Finset (TotalFiber n) := (Finset.Icc lo hi ×ˢ Finset.Icc lo' hi').subtype
    (· ∈ (ComplexShape.up ℤ).π (ComplexShape.up ℤ) (ComplexShape.up ℤ) ⁻¹' {n})
  have hS : ∀ j : TotalFiber n, j ∈ S ↔ j.1.1 ∈ Finset.Icc lo hi ∧ j.1.2 ∈ Finset.Icc lo' hi' :=
    fun j ↦ by simp [S, Finset.mem_subtype, Finset.mem_product]
  have hz : ∀ j ∉ S, IsZero ((Scheme.Modules.pullback g).obj (tensorSummand P Q j)) := by
    intro j hj
    rw [hS, Finset.mem_Icc, Finset.mem_Icc] at hj
    refine (isZero_sheafTensor ?_).of_iso (sheafTensorPullbackIso g _ _)
    by_cases ha : lo ≤ j.1.1 ∧ j.1.1 ≤ hi
    · exact Or.inr (hQ0 _ (by omega))
    · exact Or.inl (hP0 _ (by omega))
  let e := pullbackTensorTotalXIso g P Q n S hz
  refine ⟨?_, fun hn ↦ ?_⟩
  · exact AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.of_iso e.symm
      (h := isFiniteLocallyFree_biproduct _ rfl _ fun j ↦
        AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.of_iso
          (sheafTensorPullbackIso g _ _).symm (h := isFiniteLocallyFree_tensor (hPf _) (hQf _)))
  · have : IsEmpty S := ⟨fun j ↦ by
      have := (hS j.1).1 j.2
      rw [Finset.mem_Icc, Finset.mem_Icc] at this
      have h := j.1.2
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at h
      change j.1.1.1 + j.1.1.2 = n at h
      omega⟩
    exact (isZero_biproduct_of_isEmpty _).of_iso e

/-- **The total tensor complex of two locally bounded complexes of finite locally free modules is
one again.** Near a point both complexes are bounded, and there the terms of the total complex
are finite direct sums of tensor products of finite locally free modules. -/
theorem isLocallyBoundedFiniteLocallyFree_tensorTotal {P Q : CochainComplex Y.Modules ℤ}
    (hP : IsLocallyBoundedFiniteLocallyFree P) (hQ : IsLocallyBoundedFiniteLocallyFree Q) :
    IsLocallyBoundedFiniteLocallyFree (tensorTotal P Q) := by
  choose U hyU lo hi hU using hP.2
  choose V hyV lo' hi' hV using hQ.2
  let W : Y → Y.Opens := fun y ↦ U y ⊓ V y
  let e : ∀ (y : Y) (M : Y.Modules), (RingedSpace.restrictModules Y.toRingedSpace (W y)).obj M ≅
      (Scheme.Modules.pullback (W y).ι).obj M := fun y M ↦
    (Stacks.AlgebraicGeometry.PerfectCohomology.restrictModulesIsoRestrict Y (W y)).app M ≪≫
      (Scheme.Modules.restrictFunctorIsoPullback (W y).ι).app M
  have key := fun y ↦ pullback_tensorTotal_X (W y).ι P Q (lo y) (hi y) (lo' y) (hi' y)
    (fun a ↦ AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.pullback_scheme _ _ (hP.1 a))
    (fun b ↦ AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.pullback_scheme _ _ (hQ.1 b))
    (fun a ha ↦ (Stacks.BlowUpComplexes.isZero_restrictModules_of_le (V := W y) inf_le_left _
      (hU y a ha)).of_iso (e y _).symm)
    (fun b hb ↦ (Stacks.BlowUpComplexes.isZero_restrictModules_of_le (V := W y) inf_le_right _
      (hV y b hb)).of_iso (e y _).symm)
  refine ⟨fun n ↦ ?_, fun y ↦ ⟨W y, ⟨hyU y, hyV y⟩, lo y + lo' y, hi y + hi' y, fun n hn ↦
    ((key y n).2 hn).of_iso (e y _)⟩⟩
  refine Stacks.Modules.isFiniteLocallyFree_localGenerators_of_iSup_eq_top _ W
    (top_unique fun y _ ↦ TopologicalSpace.Opens.mem_iSup.2 ⟨y, hyU y, hyV y⟩) fun y ↦ ?_
  exact AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.of_iso
    ((Scheme.Modules.restrictFunctorIsoPullback (W y).ι).app _).symm (h := (key y n).1)

end LocallyBounded

/-! ### Power sums and Chern classes of the total tensor complex -/

section Classes

open TotalChowClass

variable (C : ChowSituation.{u}) {Y : Scheme.{u}} (sY : Y ⟶ C.S) [LocallyOfFiniteType sY]
  {P Q : CochainComplex Y.Modules ℤ} (hP : IsLocallyBoundedFiniteLocallyFree P)
  (hQ : IsLocallyBoundedFiniteLocallyFree Q)

omit [LocallyOfFiniteType sY] in
/-- The alternating rank is the finite sum `∑ᶠ a, (-1)^a ρ(a)`. -/
theorem alternatingRank_eq_finsum (ρ : ℤ →₀ ℕ) :
    alternatingRank ρ = ∑ᶠ a : ℤ, (a.negOnePow : ℤ) * (ρ a : ℤ) :=
  (finsum_eq_sum_of_support_subset _ fun a ha ↦ by
    rw [Finset.mem_coe, Finsupp.mem_support_iff]
    intro h0
    exact ha (by simp [h0])).symm

/-- **The rank of a bounded complex of constant ranks** is its alternating rank:
`P_0(ℰ^•) = ∑_a (-1)^a ρ(a)`. -/
theorem powerSumComplexBounded_zero {T : Scheme.{u}} (sT : T ⟶ C.S) [LocallyOfFiniteType sT]
    (K : CochainComplex T.Modules ℤ) (ρ : ℤ →₀ ℕ)
    (hK : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (K.X n) (ρ n)) :
    powerSumComplexBounded C sT K ρ hK 0 = ((alternatingRank ρ : ℤ) : TotalChowClass C sT) := by
  simp only [powerSumComplexBounded, powerSumTotal_zero, alternatingRank, Int.cast_sum,
    Int.cast_mul, Int.cast_natCast, zsmul_eq_mul]

/-- **Stacks 0F9D for complexes**: the power sums of the total tensor complex of two locally
bounded complexes of finite locally free modules are
`P_p(Tot(P ⊗ Q)) = ∑_{p₁ + p₂ = p} C(p, p₁) P_{p₁}(P) P_{p₂}(Q)`. -/
theorem powerSumComplex_tensorTotal (p : ℕ) :
    powerSumComplex C sY (isLocallyBoundedFiniteLocallyFree_tensorTotal hP hQ) p =
      ∑ q ∈ antidiagonal p, (p.choose q.1 : ℤ) •
        (powerSumComplex C sY hP q.1 * powerSumComplex C sY hQ q.2) := by
  refine TotalChowClass.eq_of_res_eq_of_complexRank₂ C sY hP hQ
    fun {T sT _} g _ hs ρ σ hρ hσ ↦ ?_
  rw [res_powerSumComplex_eq_powerSumComplexBounded C sY _ g hs (tensorRank ρ σ)
    (isFiniteLocallyFreeOfRank_pullbackComplex_tensorTotal g P Q ρ σ hρ hσ), map_sum,
    powerSumComplexBounded_tensorTotal C sT g P Q ρ σ hρ hσ]
  refine Finset.sum_congr rfl fun q _ ↦ ?_
  rw [map_zsmul, map_mul, res_powerSumComplex_eq_powerSumComplexBounded C sY hP g hs ρ hρ,
    res_powerSumComplex_eq_powerSumComplexBounded C sY hQ g hs σ hσ]

/-- On a piece of constant ranks, the first two Chern classes of the three complexes satisfy the
relations of Stacks 0FA6 with the alternating ranks. -/
theorem homPart_complexChernBounded_tensorTotal {T : Scheme.{u}} (sT : T ⟶ C.S)
    [LocallyOfFiniteType sT] (g : T ⟶ Y) (ρ σ : ℤ →₀ ℕ)
    (hρ : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((pullbackComplex g P).X n) (ρ n))
    (hσ : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((pullbackComplex g Q).X n) (σ n)) (τ : ℤ →₀ ℕ)
    (hτ : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((pullbackComplex g (tensorTotal P Q)).X n) (τ n)) :
    TotalChowClass.homComponent 1 (complexChernBounded C sT _ τ hτ) =
        alternatingRank ρ • TotalChowClass.homComponent 1 (complexChernBounded C sT _ σ hσ) +
          alternatingRank σ • TotalChowClass.homComponent 1 (complexChernBounded C sT _ ρ hρ) ∧
      TotalChowClass.homComponent 2 (complexChernBounded C sT _ τ hτ) =
        alternatingRank ρ • TotalChowClass.homComponent 2 (complexChernBounded C sT _ σ hσ) +
          alternatingRank σ • TotalChowClass.homComponent 2 (complexChernBounded C sT _ ρ hρ) +
          Ring.choose (alternatingRank ρ) 2 •
            TotalChowClass.homComponent 1 (complexChernBounded C sT _ σ hσ) ^ 2 +
          (alternatingRank ρ * alternatingRank σ - 1) •
            (TotalChowClass.homComponent 1 (complexChernBounded C sT _ σ hσ) *
              TotalChowClass.homComponent 1 (complexChernBounded C sT _ ρ hρ)) +
          Ring.choose (alternatingRank σ) 2 •
            TotalChowClass.homComponent 1 (complexChernBounded C sT _ ρ hρ) ^ 2 := by
  obtain ⟨h, -, -⟩ := chernPairOf_complexChernBounded_support C sT _ τ hτ
  obtain ⟨h₁, -, -⟩ := chernPairOf_complexChernBounded_support C sT _ ρ hρ
  obtain ⟨h₂, -, -⟩ := chernPairOf_complexChernBounded_support C sT _ σ hσ
  have e := chernPairOf_complexChernBounded_tensorTotal C sT g P Q ρ σ hρ hσ τ hτ h h₁ h₂
  have e₁ := congrArg (fun x : ChernPair (chernUnitRing C sT) ↦ (x.fst : TotalChowClass C sT)) e
  have e₂ := congrArg (fun x : ChernPair (chernUnitRing C sT) ↦ (x.snd : TotalChowClass C sT)) e
  simp only [ChernPair.tensor] at e₁ e₂
  push_cast at e₁ e₂
  exact ⟨e₁, e₂⟩

/-- **The first Chern class of the total tensor complex**: `c₁(Tot(P ⊗ Q)) = P_0(P) c₁(Q) +
P_0(Q) c₁(P)`, where the ranks `P_0` are locally constant integers. -/
theorem homPart_one_complexChern_tensorTotal :
    TotalChowClass.homComponent 1
        (complexChern C sY (isLocallyBoundedFiniteLocallyFree_tensorTotal hP hQ)) =
      powerSumComplex C sY hP 0 * TotalChowClass.homComponent 1 (complexChern C sY hQ) +
        powerSumComplex C sY hQ 0 * TotalChowClass.homComponent 1 (complexChern C sY hP) := by
  refine TotalChowClass.eq_of_res_eq_of_complexRank₂ C sY hP hQ
    fun {T sT _} g _ hs ρ σ hρ hσ ↦ ?_
  have hT := isFiniteLocallyFreeOfRank_pullbackComplex_tensorTotal g P Q ρ σ hρ hσ
  rw [TotalChowClass.res_homComponent,
    res_complexChern_eq_complexChernBounded C sY _ g hs (tensorRank ρ σ) hT,
    (homPart_complexChernBounded_tensorTotal C sT g ρ σ hρ hσ _ hT).1, map_add, map_mul, map_mul,
    res_powerSumComplex_eq_powerSumComplexBounded C sY hP g hs ρ hρ,
    res_powerSumComplex_eq_powerSumComplexBounded C sY hQ g hs σ hσ,
    TotalChowClass.res_homComponent, TotalChowClass.res_homComponent,
    res_complexChern_eq_complexChernBounded C sY hP g hs ρ hρ,
    res_complexChern_eq_complexChernBounded C sY hQ g hs σ hσ, powerSumComplexBounded_zero,
    powerSumComplexBounded_zero, zsmul_eq_mul, zsmul_eq_mul]

/-- **The second Chern class of the total tensor complex**, for complexes of constant alternating
ranks `r` and `s`:
`c₂(Tot(P ⊗ Q)) = r c₂(Q) + s c₂(P) + C(r,2) c₁(Q)² + (rs - 1) c₁(Q) c₁(P) + C(s,2) c₁(P)²`.
The alternating ranks are taken on every nonempty test scheme along which the complexes have
constant ranks. -/
theorem homPart_two_complexChern_tensorTotal (r s : ℤ)
    (hr : ∀ {T : Scheme.{u}} (g : T ⟶ Y) (ρ : ℤ →₀ ℕ),
      (∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        ((pullbackComplex g P).X n) (ρ n)) → Nonempty T → alternatingRank ρ = r)
    (hs : ∀ {T : Scheme.{u}} (g : T ⟶ Y) (σ : ℤ →₀ ℕ),
      (∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        ((pullbackComplex g Q).X n) (σ n)) → Nonempty T → alternatingRank σ = s) :
    TotalChowClass.homComponent 2
        (complexChern C sY (isLocallyBoundedFiniteLocallyFree_tensorTotal hP hQ)) =
      r • TotalChowClass.homComponent 2 (complexChern C sY hQ) +
          s • TotalChowClass.homComponent 2 (complexChern C sY hP) +
        Ring.choose r 2 • TotalChowClass.homComponent 1 (complexChern C sY hQ) ^ 2 +
        (r * s - 1) • (TotalChowClass.homComponent 1 (complexChern C sY hQ) *
          TotalChowClass.homComponent 1 (complexChern C sY hP)) +
        Ring.choose s 2 • TotalChowClass.homComponent 1 (complexChern C sY hP) ^ 2 := by
  refine TotalChowClass.eq_of_res_eq_of_complexRank₂ C sY hP hQ
    fun {T sT _} g _ hgs ρ σ hρ hσ ↦ ?_
  rcases isEmpty_or_nonempty T with hT | hT
  · exact (TotalChowClass.subsingleton_of_isEmpty sT).elim _ _
  have hTt := isFiniteLocallyFreeOfRank_pullbackComplex_tensorTotal g P Q ρ σ hρ hσ
  rw [TotalChowClass.res_homComponent,
    res_complexChern_eq_complexChernBounded C sY _ g hgs (tensorRank ρ σ) hTt,
    (homPart_complexChernBounded_tensorTotal C sT g ρ σ hρ hσ _ hTt).2, hr g ρ hρ hT,
    hs g σ hσ hT]
  simp only [map_add, map_zsmul, map_mul, map_pow, TotalChowClass.res_homComponent,
    res_complexChern_eq_complexChernBounded C sY hP g hgs ρ hρ,
    res_complexChern_eq_complexChernBounded C sY hQ g hgs σ hσ]

end Classes

