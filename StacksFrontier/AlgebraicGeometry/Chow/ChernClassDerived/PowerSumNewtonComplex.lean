module

public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.PowerSumIndependence
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.PerfectChernProperties

/-!
# Newton's identities for the power sums of a complex

Let `X` be locally of finite type over the base of chapter 42 and let `ℰ^•` be a locally bounded
complex of finite locally free `𝒪_X`-modules. Remark 0FAD of the Stacks Project says that the
power sums `P_p(ℰ^•)` are the same polynomials in the Chern classes `c_i(ℰ^•)` as for a vector
bundle:

  `P_1 = c_1`, `P_2 = c_1² - 2c_2`, `P_3 = c_1³ - 3c_1c_2 + 3c_3`, …,

that is, they satisfy Newton's recursion

  `P_{p+1} = ∑_{j < p} (-1)^j c_{j+1} P_{p-j} + (-1)^p (p + 1) c_{p+1}`

(the recursion defining the universal polynomials of Stacks 0F9B,
`AlgebraicGeometry.powerSumPolynomial`). This file proves it.

On a rank locus the complex is bounded with constant ranks, `c(ℰ^•) = ∏_n c(ℰ^n)^{(-1)^n}` and
`P_p(ℰ^•) = ∑_n (-1)^n P_p(ℰ^n)`. The homogeneous parts of the total Chern classes of finite
locally free modules and of their inverses commute with each other (Stacks 02UA), so they generate
a commutative subring of `∏_p A^p(X)`; there `P_p` is additive on Cauchy products
(`AlgebraicGeometry.powerSumEval_convolution`, the algebraic content of Stacks 0F9C), hence takes
inverses to negatives, and `P_p(ℰ^•)` is the universal polynomial evaluated at the Chern classes
of `ℰ^•`. Newton's recursion is then the recursion defining the universal polynomials.

## Main definitions

* `Stacks.Chow.TotalChowClass.IsNewtonPowerSums` — Newton's recursion between a total class and a
  sequence of total classes.
* `Stacks.Chow.chernUnitRing` — the commutative subring of `∏_p A^p(X)` generated by the
  homogeneous parts of the total Chern classes of finite locally free modules and of their
  inverses.

## Main results

* `Stacks.Chow.TotalChowClass.homPart_mul_of_isHomogeneous_left`,
  `Stacks.Chow.TotalChowClass.homPart_mul_of_isHomogeneous_right` — products with a homogeneous
  class, degree by degree.
* `Stacks.Chow.chernUnitSet_commute` — those homogeneous parts commute (Stacks 02UA).
* `Stacks.Chow.powerSumEval_chernUnitSeq_mul`, `Stacks.Chow.powerSumEval_chernUnitSeq_inv` — the
  universal power sums are additive on products and change sign on inverses.
* `Stacks.Chow.commute_homPart_complexChern` — the Chern classes of a complex commute.
* `Stacks.Chow.isNewtonPowerSums_powerSumComplex` — **Newton's identities for complexes**.
* `Stacks.Chow.powerSumComplex_eq_complexPowerSum` — the power sums `P_p(ℰ^•)`, glued from the
  alternating sums over the rank loci, are the classes `Stacks.Chow.complexPowerSum` defined by
  Newton's recursion.

## References

* [Stacks Project, Tag 0FAD](https://stacks.math.columbia.edu/tag/0FAD)
* [Stacks Project, Tag 0F9B](https://stacks.math.columbia.edu/tag/0F9B)
* [Stacks Project, Tag 0F9C](https://stacks.math.columbia.edu/tag/0F9C)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Finset

universe u

namespace Stacks.Chow

namespace TotalChowClass

variable {C : ChowSituation.{u}} {X : Scheme.{u}} {sX : X ⟶ C.S} [LocallyOfFiniteType sX]

/-! ### Homogeneous parts -/

/-- The homogeneous parts of a homogeneous class. -/
theorem IsHomogeneous.homPart_of_ne {i n : ℕ} {x : TotalChowClass C sX} (hx : IsHomogeneous i x)
    (hn : n ≠ i) : TotalChowClass.homComponent n x = 0 :=
  ext fun p => by
    rw [TotalChowClass.homComponent_apply]
    split_ifs with hp
    · subst hp
      exact hx _ hn
    · rfl

/-- Two total classes with the same homogeneous parts are equal. -/
theorem ext_homPart {c d : TotalChowClass C sX}
    (h : ∀ n, TotalChowClass.homComponent n c = TotalChowClass.homComponent n d) : c = d :=
  ext fun p => by
    simpa [TotalChowClass.homComponent_apply] using
      congrArg (fun x : TotalChowClass C sX => x p) (h p)

/-- **Left multiplication by a homogeneous class, degree by degree.** -/
theorem homPart_mul_of_isHomogeneous_left {i : ℕ} {x : TotalChowClass C sX}
    (hx : IsHomogeneous i x) (c : TotalChowClass C sX) (m : ℕ) :
    TotalChowClass.homComponent m (x * c) =
      if i ≤ m then x * TotalChowClass.homComponent (m - i) c else 0 := by
  rw [TotalChowClass.homComponent_mul_sum]
  split_ifs with him
  · rw [Finset.sum_eq_single (m - i)]
    · rw [show m - (m - i) = i by omega, hx.homComponent_self]
    · intro j hj hj'
      rw [hx.homPart_of_ne (by have := mem_range.mp hj; omega), zero_mul]
    · intro h
      exact absurd (mem_range.mpr (by omega)) h
  · refine Finset.sum_eq_zero fun j hj => ?_
    rw [hx.homPart_of_ne (by have := mem_range.mp hj; omega), zero_mul]

/-- **Right multiplication by a homogeneous class, degree by degree.** -/
theorem homPart_mul_of_isHomogeneous_right {i : ℕ} {x : TotalChowClass C sX}
    (hx : IsHomogeneous i x) (c : TotalChowClass C sX) (m : ℕ) :
    TotalChowClass.homComponent m (c * x) =
      if i ≤ m then TotalChowClass.homComponent (m - i) c * x else 0 := by
  rw [TotalChowClass.homComponent_mul_sum]
  split_ifs with him
  · rw [Finset.sum_eq_single i]
    · rw [hx.homComponent_self]
    · intro j _ hj
      rw [hx.homPart_of_ne hj, mul_zero]
    · intro h
      exact absurd (mem_range.mpr (by omega)) h
  · refine Finset.sum_eq_zero fun j hj => ?_
    rw [hx.homPart_of_ne (by have := mem_range.mp hj; omega), mul_zero]

/-- A homogeneous class commutes with a total class exactly when it commutes with each of its
homogeneous parts. -/
theorem IsHomogeneous.commute_iff {i : ℕ} {x : TotalChowClass C sX} (hx : IsHomogeneous i x)
    (c : TotalChowClass C sX) : Commute x c ↔ ∀ n, Commute x (TotalChowClass.homComponent n c) := by
  refine ⟨fun h n => ?_, fun h => ext_homPart fun m => ?_⟩
  · have h1 := homPart_mul_of_isHomogeneous_left hx c (n + i)
    have h2 := homPart_mul_of_isHomogeneous_right hx c (n + i)
    rw [if_pos (by omega), Nat.add_sub_cancel] at h1 h2
    rw [Commute, SemiconjBy, ← h1, ← h2, h.eq]
  · rw [homPart_mul_of_isHomogeneous_left hx, homPart_mul_of_isHomogeneous_right hx]
    split_ifs
    · exact (h _).eq
    · rfl

/-- The degree-`0` part of a product of two classes whose degree-`0` parts are `1` is `1`. -/
theorem homPart_zero_mul {c d : TotalChowClass C sX} (hc : TotalChowClass.homComponent 0 c = 1)
    (hd : TotalChowClass.homComponent 0 d = 1) : TotalChowClass.homComponent 0 (c * d) = 1 := by
  rw [TotalChowClass.homComponent_mul_sum, Finset.sum_range_one, hc, hd, mul_one]

/-- The degree-`0` part of the inverse of a unit whose degree-`0` part is `1` is `1`. -/
theorem homPart_zero_inv (u : (TotalChowClass C sX)ˣ)
    (hu : TotalChowClass.homComponent 0 (u : TotalChowClass C sX) = 1) :
    TotalChowClass.homComponent 0 ((u⁻¹ : (TotalChowClass C sX)ˣ) : TotalChowClass C sX) = 1 := by
  have h := congrArg (TotalChowClass.homComponent 0) u.mul_inv
  rwa [TotalChowClass.homComponent_mul_sum, Finset.sum_range_one, hu, one_mul,
    isHomogeneous_one.homComponent_self] at h

/-! ### Newton's recursion -/

/-- **Newton's recursion** between a total class `c` and a sequence `P` of total classes:
`P_{p+1} = ∑_{j < p} (-1)^j c_{j+1} P_{p-j} + (-1)^p (p + 1) c_{p+1}` for every `p ≥ 0`, with
`c_i` the homogeneous part of degree `i` of `c`. This is the recursion defining the universal
power-sum polynomials of Stacks 0F9B; for `c` the total Chern class it says that `P` is the
sequence of power sums `P_1, P_2, …` of the Chern roots. -/
def IsNewtonPowerSums (c : TotalChowClass C sX) (P : ℕ → TotalChowClass C sX) : Prop :=
  ∀ p : ℕ, P (p + 1) =
    ∑ j ∈ range p, ((-1 : ℤ) ^ j) • (TotalChowClass.homComponent (j + 1) c * P (p - j)) +
    ((-1 : ℤ) ^ p * ((p : ℤ) + 1)) • TotalChowClass.homComponent (p + 1) c

/-- Newton's recursion holds for the universal power sums evaluated at the homogeneous parts of a
class, computed in a commutative subring containing them. -/
theorem isNewtonPowerSums_of_powerSumEval {s : Set (TotalChowClass C sX)}
    (hs : ∀ x ∈ s, ∀ y ∈ s, x * y = y * x) (c : TotalChowClass C sX)
    (hc : ∀ i, TotalChowClass.homComponent i c ∈ Subring.closure s) (P : ℕ → TotalChowClass C sX)
    (hP : ∀ p, p ≠ 0 → P p = ((@powerSumEval (Subring.closure s) (Subring.closureCommRingOfComm hs)
      (fun i => ⟨TotalChowClass.homComponent i c, hc i⟩) p : Subring.closure s) :
        TotalChowClass C sX)) :
    IsNewtonPowerSums c P := by
  let := Subring.closureCommRingOfComm hs
  intro p
  rw [hP (p + 1) (Nat.succ_ne_zero p), powerSumEval_succ]
  push_cast
  congr 1
  · refine Finset.sum_congr rfl fun j hj => ?_
    rw [hP (p - j) (by have := mem_range.mp hj; omega), zsmul_eq_mul, mul_assoc]
    push_cast
    rfl
  · rw [zsmul_eq_mul]
    push_cast
    rfl

/-- Restriction maps the right side of Newton's recursion to the right side for the restrictions. -/
private theorem res_newton_rhs {Y : Scheme.{u}} {sY : Y ⟶ C.S} [LocallyOfFiniteType sY]
    (c : TotalChowClass C sX) (P : ℕ → TotalChowClass C sX) (f : Y ⟶ X) [LocallyOfFiniteType f]
    (hs : f ≫ sX = sY) (p : ℕ) :
    TotalChowClass.res f hs
        (∑ j ∈ range p, ((-1 : ℤ) ^ j) • (TotalChowClass.homComponent (j + 1) c * P (p - j)) +
          ((-1 : ℤ) ^ p * ((p : ℤ) + 1)) • TotalChowClass.homComponent (p + 1) c) =
      ∑ j ∈ range p, ((-1 : ℤ) ^ j) • (TotalChowClass.homComponent (j + 1)
          (TotalChowClass.res f hs c) * TotalChowClass.res f hs (P (p - j))) +
        ((-1 : ℤ) ^ p * ((p : ℤ) + 1)) •
          TotalChowClass.homComponent (p + 1) (TotalChowClass.res f hs c) := by
  rw [map_add, map_sum, map_zsmul, TotalChowClass.res_homComponent]
  congr 1
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [map_zsmul, map_mul, TotalChowClass.res_homComponent]

/-- Newton's recursion is preserved by restriction. -/
theorem IsNewtonPowerSums.res {Y : Scheme.{u}} {sY : Y ⟶ C.S} [LocallyOfFiniteType sY]
    {c : TotalChowClass C sX} {P : ℕ → TotalChowClass C sX} (h : IsNewtonPowerSums c P)
    (f : Y ⟶ X) [LocallyOfFiniteType f] (hs : f ≫ sX = sY) :
    IsNewtonPowerSums (TotalChowClass.res f hs c) fun p => TotalChowClass.res f hs (P p) := by
  intro p
  dsimp only
  rw [h p, res_newton_rhs]

/-- Newton's recursion can be checked after restriction along a morphism on which restriction is
injective. -/
theorem IsNewtonPowerSums.of_res {Y : Scheme.{u}} {sY : Y ⟶ C.S} [LocallyOfFiniteType sY]
    {c : TotalChowClass C sX} {P : ℕ → TotalChowClass C sX} (f : Y ⟶ X) [LocallyOfFiniteType f]
    (hs : f ≫ sX = sY) (hinj : Function.Injective (TotalChowClass.res f hs))
    (h : IsNewtonPowerSums (TotalChowClass.res f hs c) fun p => TotalChowClass.res f hs (P p)) :
    IsNewtonPowerSums c P := fun p =>
  hinj <| by rw [res_newton_rhs c P f hs]; exact h p

/-- **The first four Newton identities.** If `P` satisfies Newton's recursion in `c` and the
homogeneous parts `x_i` of `c` commute, then `P_1 = x_1`, `P_2 = x_1² - 2x_2`,
`P_3 = x_1³ - 3x_1x_2 + 3x_3` and `P_4 = x_1⁴ - 4x_1²x_2 + 4x_1x_3 + 2x_2² - 4x_4`, the products
bracketed to the right. -/
theorem IsNewtonPowerSums.first_four {c : TotalChowClass C sX} {P : ℕ → TotalChowClass C sX}
    (N : IsNewtonPowerSums c P)
    (hc : ∀ i j, Commute (TotalChowClass.homComponent i c) (TotalChowClass.homComponent j c)) :
    P 1 = TotalChowClass.homComponent 1 c ∧
      P 2 = TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 1 c -
        (2 : ℤ) • TotalChowClass.homComponent 2 c ∧
      P 3 = TotalChowClass.homComponent 1 c *
          (TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 1 c) -
        (3 : ℤ) • (TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 2 c) +
        (3 : ℤ) • TotalChowClass.homComponent 3 c ∧
      P 4 = TotalChowClass.homComponent 1 c * (TotalChowClass.homComponent 1 c *
          (TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 1 c)) -
        (4 : ℤ) • (TotalChowClass.homComponent 1 c *
          (TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 2 c)) +
        (4 : ℤ) • (TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 3 c) +
        (2 : ℤ) • (TotalChowClass.homComponent 2 c * TotalChowClass.homComponent 2 c) -
        (4 : ℤ) • TotalChowClass.homComponent 4 c := by
  have h1 : P 1 = TotalChowClass.homComponent 1 c := by simpa using N 0
  have N1 := N 1
  have N2 := N 2
  have N3 := N 3
  simp only [Finset.sum_range_succ, Finset.range_zero, Finset.sum_empty, zero_add,
    Nat.reduceAdd, Nat.reduceSub, Nat.sub_zero, pow_zero, pow_one, one_smul] at N1 N2 N3
  have h2 : P 2 = TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 1 c -
      (2 : ℤ) • TotalChowClass.homComponent 2 c := by
    rw [N1, h1]
    simp only [zsmul_eq_mul]
    push_cast
    noncomm_ring
  have h3 : P 3 = TotalChowClass.homComponent 1 c *
        (TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 1 c) -
      (3 : ℤ) • (TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 2 c) +
      (3 : ℤ) • TotalChowClass.homComponent 3 c := by
    rw [N2, h1, h2, ← sub_eq_zero]
    simp only [zsmul_eq_mul]
    push_cast
    calc _ = TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 2 c -
          TotalChowClass.homComponent 2 c * TotalChowClass.homComponent 1 c := by noncomm_ring
      _ = 0 := sub_eq_zero.2 (hc 1 2).eq
  refine ⟨h1, h2, h3, ?_⟩
  rw [N3, h1, h2, h3, ← sub_eq_zero]
  have k211 : TotalChowClass.homComponent 2 c *
        (TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 1 c) =
      TotalChowClass.homComponent 1 c *
        (TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 2 c) := by
    rw [← mul_assoc, (hc 2 1).eq, mul_assoc, (hc 2 1).eq, ← mul_assoc]
  simp only [zsmul_eq_mul]
  push_cast
  calc _ = TotalChowClass.homComponent 1 c *
          (TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 2 c) -
        TotalChowClass.homComponent 2 c *
          (TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 1 c) +
        (TotalChowClass.homComponent 3 c * TotalChowClass.homComponent 1 c -
          TotalChowClass.homComponent 1 c * TotalChowClass.homComponent 3 c) := by noncomm_ring
    _ = 0 := by rw [(hc 3 1).eq, k211, sub_self, sub_self, add_zero]

end TotalChowClass

/-! ### A commutative subring containing the Chern classes and their inverses -/

section ChernUnits

open TotalChowClass

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

/-- The homogeneous parts of the total Chern classes `c(ℰ)` of the finite locally free modules of
constant rank on `X`, and of their inverses `c(ℰ)^{-1}`. -/
def chernUnitSet : Set (TotalChowClass C sX) :=
  chernSet C sX ∪ {x | ∃ (E : X.Modules) (r : ℕ)
    (_ : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r) (i : ℕ),
    x = TotalChowClass.homComponent i
      (((totalChernUnit C sX E r)⁻¹ : (TotalChowClass C sX)ˣ) : TotalChowClass C sX)}

/-- Every member of `Stacks.Chow.chernUnitSet` is homogeneous. -/
theorem exists_isHomogeneous_of_mem_chernUnitSet {x : TotalChowClass C sX}
    (hx : x ∈ chernUnitSet C sX) : ∃ i, IsHomogeneous i x := by
  rcases hx with ⟨E, r, _, i, rfl⟩ | ⟨E, r, _, i, rfl⟩ <;>
    exact ⟨i, TotalChowClass.isHomogeneous_homComponent _ _⟩

/-- A homogeneous class commuting with the total Chern class of a module commutes with every
homogeneous part of it and of its inverse. -/
theorem commute_homPart_totalChernUnit_inv {i : ℕ} {x : TotalChowClass C sX}
    (hx : IsHomogeneous i x) (E : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    (h : ∀ j, Commute x (TotalChowClass.homComponent j (totalChern C sX E r))) (j : ℕ) :
    Commute x (TotalChowClass.homComponent j
      (((totalChernUnit C sX E r)⁻¹ : (TotalChowClass C sX)ˣ) : TotalChowClass C sX)) :=
  (hx.commute_iff _).1
    (Commute.units_inv_right (u := totalChernUnit C sX E r) ((hx.commute_iff _).2 h)) j

/-- The homogeneous parts of the total Chern classes of finite locally free modules of constant
rank and of their inverses commute with each other (Stacks 02UA). -/
theorem chernUnitSet_commute :
    ∀ x ∈ chernUnitSet C sX, ∀ y ∈ chernUnitSet C sX, x * y = y * x := by
  have hc : ∀ x ∈ chernSet C sX, ∀ (F : X.Modules) (s : ℕ)
      (_ : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s) (j : ℕ),
      Commute x (TotalChowClass.homComponent j
        (((totalChernUnit C sX F s)⁻¹ : (TotalChowClass C sX)ˣ) : TotalChowClass C sX)) := by
    rintro x hx F s hF j
    obtain ⟨i, hi⟩ := exists_isHomogeneous_of_mem_chernUnitSet C sX (Or.inl hx)
    exact commute_homPart_totalChernUnit_inv C sX hi F s
      (fun j => chernSet_commute C sX x hx _ (homPart_totalChern_mem_chernSet C sX F s j)) j
  rintro x (hx | ⟨E, r, hE, i, rfl⟩) y (hy | ⟨F, s, hF, j, rfl⟩)
  · exact chernSet_commute C sX x hx y hy
  · exact (hc x hx F s hF j).eq
  · exact (hc y hy E r hE i).eq.symm
  · have hi := TotalChowClass.isHomogeneous_homComponent i
      (((totalChernUnit C sX E r)⁻¹ : (TotalChowClass C sX)ˣ) : TotalChowClass C sX)
    refine (commute_homPart_totalChernUnit_inv C sX hi F s (fun j => ?_) j).eq
    exact (hc _ (homPart_totalChern_mem_chernSet C sX F s j) E r hE i).symm

/-- The commutative subring generated by `Stacks.Chow.chernUnitSet`. -/
abbrev chernUnitRing : Subring (TotalChowClass C sX) :=
  Subring.closure (chernUnitSet C sX)

/-- The subring `Stacks.Chow.chernUnitRing` is commutative. -/
instance : CommRing (chernUnitRing C sX) :=
  Subring.closureCommRingOfComm (chernUnitSet_commute C sX)

/-- A total class all of whose homogeneous parts lie in `Stacks.Chow.chernUnitRing`. -/
def HasChernUnitParts (x : TotalChowClass C sX) : Prop :=
  ∀ i, TotalChowClass.homComponent i x ∈ chernUnitRing C sX

/-- The sequence of homogeneous parts of such a class, in `Stacks.Chow.chernUnitRing`. -/
def chernUnitSeq {x : TotalChowClass C sX} (hx : HasChernUnitParts C sX x) (i : ℕ) :
    chernUnitRing C sX :=
  ⟨TotalChowClass.homComponent i x, hx i⟩

/-- The product of two classes with homogeneous parts in `Stacks.Chow.chernUnitRing` again has
homogeneous parts in `Stacks.Chow.chernUnitRing`. -/
theorem HasChernUnitParts.mul {x y : TotalChowClass C sX} (hx : HasChernUnitParts C sX x)
    (hy : HasChernUnitParts C sX y) : HasChernUnitParts C sX (x * y) := fun n => by
  rw [TotalChowClass.homComponent_mul_sum]
  exact Subring.sum_mem _ fun j _ => Subring.mul_mem _ (hx _) (hy _)

/-- The homogeneous parts of `1` lie in `Stacks.Chow.chernUnitRing`. -/
theorem hasChernUnitParts_one : HasChernUnitParts C sX 1 := fun n => by
  rcases eq_or_ne n 0 with rfl | hn
  · rw [isHomogeneous_one.homComponent_self]
    exact Subring.one_mem _
  · rw [isHomogeneous_one.homPart_of_ne hn]
    exact Subring.zero_mem _

/-- The homogeneous parts of the total Chern class of a finite locally free module of constant
rank lie in `Stacks.Chow.chernUnitRing`. -/
theorem hasChernUnitParts_totalChern (E : X.Modules) (r : ℕ)
    [h : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] :
    HasChernUnitParts C sX (totalChern C sX E r) := fun i =>
  Subring.subset_closure (Or.inl (homPart_totalChern_mem_chernSet C sX E r i))

/-- The homogeneous parts of the inverse of the total Chern class of a finite locally free module
of constant rank lie in `Stacks.Chow.chernUnitRing`. -/
theorem hasChernUnitParts_totalChernUnit_inv (E : X.Modules) (r : ℕ)
    [h : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] :
    HasChernUnitParts C sX
      (((totalChernUnit C sX E r)⁻¹ : (TotalChowClass C sX)ˣ) : TotalChowClass C sX) := fun i =>
  Subring.subset_closure (Or.inr ⟨E, r, h, i, rfl⟩)

/-- **`P_p` is additive on products**: the universal power sums of the homogeneous parts of a
product of two classes whose degree-`0` parts are `1` are the sums of those of the factors. -/
theorem powerSumEval_chernUnitSeq_mul {x y : TotalChowClass C sX} (hx : HasChernUnitParts C sX x)
    (hy : HasChernUnitParts C sX y) (hx0 : TotalChowClass.homComponent 0 x = 1)
    (hy0 : TotalChowClass.homComponent 0 y = 1) (p : ℕ) :
    powerSumEval (chernUnitSeq C sX (hx.mul C sX hy)) p =
      powerSumEval (chernUnitSeq C sX hx) p + powerSumEval (chernUnitSeq C sX hy) p := by
  have h : chernUnitSeq C sX (hx.mul C sX hy) =
      fun n => ∑ j ∈ range (n + 1), chernUnitSeq C sX hx (n - j) * chernUnitSeq C sX hy j := by
    funext n
    refine Subtype.ext ?_
    simp only [chernUnitSeq]
    push_cast
    exact TotalChowClass.homComponent_mul_sum n x y
  rw [h]
  exact powerSumEval_convolution _ _ (Subtype.ext hx0) (Subtype.ext hy0) p

/-- The universal power sums of the homogeneous parts of `1` vanish. -/
theorem powerSumEval_chernUnitSeq_one (p : ℕ) :
    powerSumEval (chernUnitSeq C sX (hasChernUnitParts_one C sX)) p = 0 := by
  have h := powerSumEval_chernUnitSeq_mul C sX (hasChernUnitParts_one C sX)
    (hasChernUnitParts_one C sX) (isHomogeneous_one.homComponent_self)
    (isHomogeneous_one.homComponent_self) p
  have he : chernUnitSeq C sX ((hasChernUnitParts_one C sX).mul C sX (hasChernUnitParts_one C sX)) =
      chernUnitSeq C sX (hasChernUnitParts_one C sX) := by
    funext n
    exact Subtype.ext (by simp [chernUnitSeq])
  rw [he] at h
  exact left_eq_add.mp h

/-- Equal classes have equal sequences of homogeneous parts in `Stacks.Chow.chernUnitRing`. -/
theorem chernUnitSeq_congr {x y : TotalChowClass C sX} (hxy : x = y) (hx : HasChernUnitParts C sX x)
    (hy : HasChernUnitParts C sX y) : chernUnitSeq C sX hx = chernUnitSeq C sX hy := by
  subst hxy
  rfl

/-- **`P_p` of an inverse is the negative**: for a unit `u` whose degree-`0` part is `1`, the
universal power sums of the homogeneous parts of `u⁻¹` are the negatives of those of `u`. -/
theorem powerSumEval_chernUnitSeq_inv (u : (TotalChowClass C sX)ˣ)
    (hu : HasChernUnitParts C sX (u : TotalChowClass C sX))
    (hu' : HasChernUnitParts C sX ((u⁻¹ : (TotalChowClass C sX)ˣ) : TotalChowClass C sX))
    (hu0 : TotalChowClass.homComponent 0 (u : TotalChowClass C sX) = 1) (p : ℕ) :
    powerSumEval (chernUnitSeq C sX hu') p = -powerSumEval (chernUnitSeq C sX hu) p := by
  have h := powerSumEval_chernUnitSeq_mul C sX hu hu' hu0 (homPart_zero_inv u hu0) p
  rw [chernUnitSeq_congr C sX u.mul_inv _ (hasChernUnitParts_one C sX),
    powerSumEval_chernUnitSeq_one] at h
  exact (neg_eq_of_add_eq_zero_right h.symm).symm

/-- `P_p(ℰ)`, computed in the ring of Chern classes, is computed in `Stacks.Chow.chernUnitRing`
as well. -/
theorem powerSumTotal_eq_powerSumEval_chernUnitSeq (E : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] {p : ℕ}
    (hp : p ≠ 0) :
    powerSumTotal C sX E r p =
      ((powerSumEval (chernUnitSeq C sX (hasChernUnitParts_totalChern C sX E r)) p :
        chernUnitRing C sX) : TotalChowClass C sX) := by
  rw [powerSumTotal_of_ne_zero C sX E r hp]
  exact map_coe_powerSumEval_closure (RingHom.id _) (chernSet_commute C sX)
    (chernUnitSet_commute C sX) _ (homPart_totalChern_mem_chernSet C sX E r) _
    (fun i => Or.inl (homPart_totalChern_mem_chernSet C sX E r i)) (fun _ => rfl)
    (fun x hx => Subring.subset_closure (Or.inl hx)) p

end ChernUnits

/-! ### Bounded complexes of constant ranks -/

section Bounded

open TotalChowClass

variable (C : ChowSituation.{u}) {Y : Scheme.{u}} (sY : Y ⟶ C.S) [LocallyOfFiniteType sY]
  (P : CochainComplex Y.Modules ℤ) (ρ : ℤ →₀ ℕ)
  (hP : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (P.X n) (ρ n))

/-- The factor `c(P^n)^{(-1)^n}` has its homogeneous parts in `Stacks.Chow.chernUnitRing`, its
degree-`0` part is `1`, and its universal power sums are `(-1)^n P_p(P^n)`. -/
theorem complexChernFactor_spec (n : ℤ) :
    ∃ h : HasChernUnitParts C sY (complexChernFactor C sY P ρ hP n : TotalChowClass C sY),
      TotalChowClass.homComponent 0 (complexChernFactor C sY P ρ hP n : TotalChowClass C sY) = 1 ∧
      ∀ p, p ≠ 0 → ((powerSumEval (chernUnitSeq C sY h) p : chernUnitRing C sY) :
        TotalChowClass C sY) =
          (n.negOnePow : ℤ) • (letI := hP n; powerSumTotal C sY (P.X n) (ρ n) p) := by
  let := hP n
  have h0 := homPart_zero_totalChern C sY (P.X n) (ρ n)
  rcases Int.units_eq_one_or n.negOnePow with he | he
  · have hf : (complexChernFactor C sY P ρ hP n : TotalChowClass C sY) =
        totalChern C sY (P.X n) (ρ n) := by
      rw [complexChernFactor, he, Units.val_one, zpow_one, val_totalChernUnit]
    refine ⟨hf ▸ hasChernUnitParts_totalChern C sY (P.X n) (ρ n), hf ▸ h0, fun p hp => ?_⟩
    rw [chernUnitSeq_congr C sY hf _ (hasChernUnitParts_totalChern C sY (P.X n) (ρ n)), he,
      Units.val_one, one_smul, powerSumTotal_eq_powerSumEval_chernUnitSeq C sY (P.X n) (ρ n) hp]
  · have hf : (complexChernFactor C sY P ρ hP n : TotalChowClass C sY) =
        (((totalChernUnit C sY (P.X n) (ρ n))⁻¹ : (TotalChowClass C sY)ˣ) :
          TotalChowClass C sY) := by
      rw [complexChernFactor, he, Units.val_neg, Units.val_one, zpow_neg_one]
    refine ⟨hf ▸ hasChernUnitParts_totalChernUnit_inv C sY (P.X n) (ρ n),
      hf ▸ homPart_zero_inv _ h0, fun p hp => ?_⟩
    rw [chernUnitSeq_congr C sY hf _ (hasChernUnitParts_totalChernUnit_inv C sY (P.X n) (ρ n)),
      powerSumEval_chernUnitSeq_inv C sY _ (hasChernUnitParts_totalChern C sY (P.X n) (ρ n)) _ h0,
      he, Units.val_neg, Units.val_one, neg_one_smul,
      powerSumTotal_eq_powerSumEval_chernUnitSeq C sY (P.X n) (ρ n) hp]
    push_cast
    rfl

/-- The ordered product `∏_{n ∈ l} c(P^n)^{(-1)^n}` over a list of degrees has its homogeneous
parts in `Stacks.Chow.chernUnitRing`, its degree-`0` part is `1`, and its universal power sums are
`∑_{n ∈ l} (-1)^n P_p(P^n)`. -/
theorem complexChernFactor_list_prod_spec (l : List ℤ) :
    ∃ h : HasChernUnitParts C sY ((l.map (complexChernFactor C sY P ρ hP)).prod :
        TotalChowClass C sY),
      TotalChowClass.homComponent 0
        ((l.map (complexChernFactor C sY P ρ hP)).prod : TotalChowClass C sY) = 1 ∧
      ∀ p, p ≠ 0 → ((powerSumEval (chernUnitSeq C sY h) p : chernUnitRing C sY) :
        TotalChowClass C sY) =
          (l.map fun n => (n.negOnePow : ℤ) •
            (letI := hP n; powerSumTotal C sY (P.X n) (ρ n) p)).sum := by
  induction l with
  | nil =>
    have he : (([] : List ℤ).map (complexChernFactor C sY P ρ hP)).prod.val = 1 := by simp
    refine ⟨he ▸ hasChernUnitParts_one C sY, he ▸ isHomogeneous_one.homComponent_self,
      fun p _ => ?_⟩
    rw [chernUnitSeq_congr C sY he _ (hasChernUnitParts_one C sY), powerSumEval_chernUnitSeq_one]
    simp
  | cons a l ih =>
    obtain ⟨h, h0, hP'⟩ := ih
    obtain ⟨ha, ha0, haP⟩ := complexChernFactor_spec C sY P ρ hP a
    have he : (((a :: l).map (complexChernFactor C sY P ρ hP)).prod : TotalChowClass C sY) =
        (complexChernFactor C sY P ρ hP a : TotalChowClass C sY) *
          ((l.map (complexChernFactor C sY P ρ hP)).prod : TotalChowClass C sY) := by
      rw [List.map_cons, List.prod_cons, Units.val_mul]
    refine ⟨he ▸ ha.mul C sY h, he ▸ homPart_zero_mul ha0 h0, fun p hp => ?_⟩
    rw [chernUnitSeq_congr C sY he _ (ha.mul C sY h),
      powerSumEval_chernUnitSeq_mul C sY ha h ha0 h0, Subring.coe_add, haP p hp, hP' p hp,
      List.map_cons, List.sum_cons]

/-- **`c(P)` of a bounded complex of constant ranks**: its homogeneous parts lie in
`Stacks.Chow.chernUnitRing`, its degree-`0` part is `1`, and the universal power sums of its
homogeneous parts are the power sums `P_p(P) = ∑_n (-1)^n P_p(P^n)`, for `p ≥ 1`. -/
theorem complexChernBounded_spec :
    ∃ h : HasChernUnitParts C sY (complexChernBounded C sY P ρ hP),
      TotalChowClass.homComponent 0 (complexChernBounded C sY P ρ hP) = 1 ∧
      ∀ p, p ≠ 0 → ((powerSumEval (chernUnitSeq C sY h) p : chernUnitRing C sY) :
        TotalChowClass C sY) = powerSumComplexBounded C sY P ρ hP p := by
  obtain ⟨h, h0, hP'⟩ := complexChernFactor_list_prod_spec C sY P ρ hP (ρ.support.sort (· ≤ ·))
  have hb : complexChernBounded C sY P ρ hP =
      ((ρ.support.sort (· ≤ ·)).map (complexChernFactor C sY P ρ hP)).prod.val := rfl
  refine ⟨hb ▸ h, hb ▸ h0, fun p hp => ?_⟩
  rw [chernUnitSeq_congr C sY hb _ h, hP' p hp, powerSumComplexBounded,
    ← List.sum_toFinset _ (ρ.support.sort_nodup _), Finset.sort_toFinset]

/-- The homogeneous parts of `c(P)` commute with each other. -/
theorem commute_homPart_complexChernBounded (i j : ℕ) :
    Commute (TotalChowClass.homComponent i (complexChernBounded C sY P ρ hP))
      (TotalChowClass.homComponent j (complexChernBounded C sY P ρ hP)) := by
  obtain ⟨h, _, _⟩ := complexChernBounded_spec C sY P ρ hP
  exact congrArg Subtype.val (mul_comm (chernUnitSeq C sY h i) (chernUnitSeq C sY h j))

/-- **Newton's identities for a bounded complex of constant ranks.** -/
theorem isNewtonPowerSums_powerSumComplexBounded :
    IsNewtonPowerSums (complexChernBounded C sY P ρ hP)
      (powerSumComplexBounded C sY P ρ hP) := by
  obtain ⟨h, _, hP'⟩ := complexChernBounded_spec C sY P ρ hP
  exact isNewtonPowerSums_of_powerSumEval (chernUnitSet_commute C sY) _ h _
    fun p hp => (hP' p hp).symm

end Bounded

/-! ### Locally bounded complexes -/

section Complex

open TotalChowClass

variable (C : ChowSituation.{u}) {Y : Scheme.{u}} (sY : Y ⟶ C.S) [LocallyOfFiniteType sY]
  {P : CochainComplex Y.Modules ℤ} (hP : IsLocallyBoundedFiniteLocallyFree P)

/-- **The Chern classes of a complex commute** with each other, degree by degree. -/
theorem commute_homPart_complexChern (i j : ℕ) :
    Commute (TotalChowClass.homComponent i (complexChern C sY hP))
      (TotalChowClass.homComponent j (complexChern C sY hP)) := by
  refine eq_of_res_eq (isClopenDecomposition_complexRankLoci hP) fun ρ => ?_
  rw [map_mul, map_mul, TotalChowClass.res_homComponent, TotalChowClass.res_homComponent,
    res_complexChern_complexRankLocus]
  exact (commute_homPart_complexChernBounded C ((complexRankLocus hP ρ.down).ι ≫ sY)
    (pullbackComplex (complexRankLocus hP ρ.down).ι P) ρ.down
    (isFiniteLocallyFreeOfRank_complexRankLocus hP ρ.down) i j).eq

/-- **Newton's identities for complexes (Stacks 0FAD).** For a locally bounded complex `ℰ^•` of
finite locally free modules, the power sums satisfy Newton's recursion in the Chern classes:
`P_{p+1}(ℰ^•) = ∑_{j < p} (-1)^j c_{j+1}(ℰ^•) P_{p-j}(ℰ^•) + (-1)^p (p + 1) c_{p+1}(ℰ^•)`. So
`P_p(ℰ^•)` is the universal polynomial of Stacks 0F9B in the Chern classes of `ℰ^•`, as for a
vector bundle: `P_1 = c_1`, `P_2 = c_1² - 2c_2`, and so on. -/
theorem isNewtonPowerSums_powerSumComplex :
    IsNewtonPowerSums (complexChern C sY hP) (powerSumComplex C sY hP) := by
  intro p
  refine eq_of_res_eq (isClopenDecomposition_complexRankLoci hP) fun ρ => ?_
  have h := (isNewtonPowerSums_powerSumComplexBounded C ((complexRankLocus hP ρ.down).ι ≫ sY)
    (pullbackComplex (complexRankLocus hP ρ.down).ι P) ρ.down
    (isFiniteLocallyFreeOfRank_complexRankLocus hP ρ.down)) p
  rw [res_newton_rhs]
  simp only [res_powerSumComplex_complexRankLocus, res_complexChern_complexRankLocus]
  exact h

/-- **The power sums of a complex are Newton's recursion in its Chern classes.** The class
`P_p(ℰ^•)` glued from the alternating sums `∑_n (-1)^n P_p(ℰ^n)` over the rank loci is the class
`Stacks.Chow.complexPowerSum` defined by Newton's recursion of Stacks 0F9B in the Chern classes of
`ℰ^•`, with the alternating rank class as its degree-zero term. In degree zero both are the
alternating rank on every rank locus; in positive degree both satisfy Newton's recursion
(`Stacks.Chow.isNewtonPowerSums_powerSumComplex`), which determines them from the lower
degrees. -/
theorem powerSumComplex_eq_complexPowerSum (p : ℕ) :
    powerSumComplex C sY hP p = complexPowerSum C sY hP p := by
  induction p using Nat.strong_induction_on with
  | _ p ih =>
    rcases p with _ | p
    · rw [complexPowerSum_zero]
      refine eq_of_res_eq (isClopenDecomposition_complexRankLoci hP) fun ρ => ?_
      rw [res_powerSumComplex_complexRankLocus, res_complexRankClass_complexRankLocus]
      have hsupp : (Function.support fun n : ℤ ↦ (n.negOnePow : ℤ) * (ρ.down n : ℤ)) ⊆
          (ρ.down.support : Set ℤ) := by
        intro n hn
        by_contra hns
        have h0 : ρ.down n = 0 := Finsupp.notMem_support_iff.1 (by simpa using hns)
        exact hn (by simp [h0])
      rw [finsum_eq_finsetSum_of_support_subset _ hsupp, Finset.sum_smul, powerSumComplexBounded]
      refine Finset.sum_congr rfl fun n _ => ?_
      rw [powerSumTotal_zero, mul_smul, natCast_zsmul, nsmul_one]
    · rw [isNewtonPowerSums_powerSumComplex C sY hP p, complexPowerSum,
        AlgebraicGeometry.newtonPowerSum_succ]
      congr 1
      · refine Finset.sum_congr rfl fun j _ => ?_
        rw [ih (p - j) (by omega), complexPowerSum, zsmul_eq_mul, Int.cast_pow, Int.cast_neg,
          Int.cast_one, Nat.succPNat_coe, mul_assoc]
      · rw [zsmul_eq_mul, Int.cast_mul, Int.cast_pow, Int.cast_neg, Int.cast_one, Int.cast_add,
          Int.cast_natCast, Int.cast_one, Nat.succPNat_coe]

end Complex

/-! ### Objects whose Chern classes are defined -/

section Perfect

open TotalChowClass

attribute [local instance 10000] HasDerivedCategory.standard

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
  {E : DerivedCategory X.Modules} (hE : HasDefinedChernClasses E)

/-- **The Chern classes of an object whose Chern classes are defined commute** with each other,
degree by degree: by Stacks 0GUD it suffices to check this after restriction along the envelope of
a presentation, where it is `Stacks.Chow.commute_homPart_complexChern`. -/
theorem commute_homPart_perfectChernClass (i j : ℕ) :
    Commute (TotalChowClass.homComponent i (perfectChernClass C sX hE))
      (TotalChowClass.homComponent j (perfectChernClass C sX hE)) := by
  obtain ⟨H⟩ := hE
  refine res_injective_of_isEnvelope H.f H.envelope rfl ?_
  rw [map_mul, map_mul, TotalChowClass.res_homComponent, TotalChowClass.res_homComponent,
    res_perfectChernClass C sX ⟨H⟩ H]
  exact (commute_homPart_complexChern C (H.f ≫ sX) H.locallyBounded i j).eq

/-- **Newton's identities for an object whose Chern classes are defined (Stacks 0FAD).** The power
sums `P_p(E)` of Stacks 0GUD satisfy Newton's recursion in the Chern classes:
`P_{p+1}(E) = ∑_{j < p} (-1)^j c_{j+1}(E) P_{p-j}(E) + (-1)^p (p + 1) c_{p+1}(E)`, so that
`P_1(E) = c_1(E)`, `P_2(E) = c_1(E)² - 2c_2(E)`, and so on, as for a vector bundle. By the
uniqueness in Stacks 0GUD it suffices to check this after restriction along the envelope of a
presentation, where it is `Stacks.Chow.isNewtonPowerSums_powerSumComplex`. -/
theorem isNewtonPowerSums_perfectPowerSum :
    IsNewtonPowerSums (perfectChernClass C sX hE) (perfectPowerSum C sX hE) := by
  obtain ⟨H⟩ := hE
  refine IsNewtonPowerSums.of_res H.f rfl (res_injective_of_isEnvelope H.f H.envelope rfl) ?_
  rw [res_perfectChernClass C sX ⟨H⟩ H]
  simp only [res_perfectPowerSum C sX ⟨H⟩ H, ← powerSumComplex_eq_complexPowerSum]
  exact isNewtonPowerSums_powerSumComplex C (H.f ≫ sX) H.locallyBounded

end Perfect

end Stacks.Chow

