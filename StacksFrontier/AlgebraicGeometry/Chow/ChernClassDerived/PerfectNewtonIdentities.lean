module

public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.PerfectPowerSumChernCharacter
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.SplittingPrinciplePerfect
public import StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.FirstFourPowerSums
public import StacksFrontier.Topology.Sheaves.Cohomology.PerfectComplexes.IsPerfectComparison
public import StacksCore.Tactic.StacksAttribute

/-!
# The power sums of a perfect object in terms of its Chern classes

Let `(S, δ)`, `X` and `E` be as in Definition 0F9E, the Chern classes of `E` being defined.
**Remark 0FAD** draws three consequences from the splitting principle (for which see
`StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.SplittingPrinciplePerfect`):

* formally taking the logarithm of `c(E)`, `log c(E) = ∑_{p ≥ 1} (-1)^{p-1} P_p(E)/p`;
* `P_p(E)` is the same expression in the Chern classes of `E` as for a vector bundle — the
  power-sum polynomial `P_p` of Stacks 0F9B — so that `P_1(E) = c_1(E)`,
  `P_2(E) = c_1(E)^2 - 2c_2(E)`, `P_3(E) = c_1(E)^3 - 3c_1(E)c_2(E) + 3c_3(E)` and
  `P_4(E) = c_1(E)^4 - 4c_1(E)^2c_2(E) + 4c_1(E)c_3(E) + 2c_2(E)^2 - 4c_4(E)`;
* `P_0(E) = r(E) = ch_0(E)`, and this class cannot be recovered from `c(E)`.

All three are proved here, for the classes `c(E)`, `P_p(E)`, `ch_p(E)` and `r(E)` of
Definition 0F9E (2).

## Main results

* `Stacks.Chow.newton_identities_of_res_eq_powerSumComplex` — Remark 0FAD for the power sums as
  Stacks defines them: classes `P_p` restricting along the envelope of a presentation `𝓔^•` of `E`
  to the alternating sums `∑_n (-1)^n P_p(𝓔^n)` satisfy Newton's recursion in the `c_i(E)`, are
  the polynomials of 0F9B in them (in particular the four displayed formulas), have `P_0 = r(E)`,
  and satisfy the logarithmic identity.
* `Stacks.Chow.log_perfectChernClass` — the logarithmic identity, degree by degree in
  `A^p(X) ⊗ 𝐐`.
* `Stacks.Chow.perfectPowerSum_eq_aeval` — Newton's identities: `P_p(E)` is the polynomial `P_p`
  evaluated at the Chern classes of `E`, in the commutative subring of `A^*(X)` they generate;
  `Stacks.Chow.perfectPowerSum_one` to `Stacks.Chow.perfectPowerSum_four` are the displayed cases.
* `Stacks.Chow.perfectPowerSum_zero_and_perfectChernCharacterComponent_zero` —
  `P_0(E) = r(E) = ch_0(E)`.
* `Stacks.Chow.exists_perfectChernClass_eq_perfectPowerSum_zero_ne` — on every nonempty `X` the
  rank is not determined by the total Chern class: `c(𝒪_X[0]) = c(0) = 1` while the ranks are `1`
  and `0`.

## Implementation notes

The ring `A^*(X)` is not known to be commutative, so the logarithm and the polynomial `P_p` are
evaluated in the commutative subring generated by the Chern classes of `E`
(`Stacks.Chow.perfectChernSubring`), which is commutative because these classes commute
(`Stacks.Chow.commute_homComponent_perfectChernClass`). The logarithm is read degree by degree:
the degree-`p` part of `log(1 + u) = ∑_{k ≥ 1} (-1)^{k-1} u^k/k`, for `u = c(E) - 1` of
positive degree, is the finite sum over `k ≤ p`. Its identification with `(-1)^{p-1} P_p(E)/p`
is the logarithmic derivative: with the Euler operator `D = t d/dt`, the truncation
`∑_{k < p} (-u)^k` of `1/c(E)` gives `[t^p] D(c(E))/c(E)`, which is `(-1)^{p-1} P_p(E)` by
Newton's recursion (`Stacks.Chow.mul_newtonSeries`), and `[t^p] D(u^k)/k = [t^p] u^{k-1} D(u)`.

## References

* [Stacks Project, Tag 0FAD](https://stacks.math.columbia.edu/tag/0FAD)
* [Stacks Project, Tag 0F9B](https://stacks.math.columbia.edu/tag/0F9B)
* [Stacks Project, Tag 0F9E](https://stacks.math.columbia.edu/tag/0F9E)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Finset

open scoped ZeroObject

universe u

namespace Stacks.Chow

attribute [local instance 10000] HasDerivedCategory.standard

/-! ### The logarithmic derivative over a commutative ring -/

section LogDeriv

open PowerSeries

variable {R : Type*} [CommRing R]

/-- The Euler operator kills the constants. -/
theorem eulerOperator_sub_one (f : R⟦X⟧) : eulerOperator (f - 1) = eulerOperator f := by
  ext n
  rw [coeff_eulerOperator, coeff_eulerOperator, map_sub, coeff_one]
  split_ifs with h
  · subst h; simp
  · rw [sub_zero]

/-- **The Euler operator on a power**: `D(y^{k+1}) = (k + 1) y^k D(y)`. -/
theorem eulerOperator_pow_succ (y : R⟦X⟧) (k : ℕ) :
    eulerOperator (y ^ (k + 1)) = (k + 1) • (y ^ k * eulerOperator y) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ, eulerOperator_mul, ih]
    simp only [nsmul_eq_mul]
    push_cast
    ring

/-- `p · [t^p] y^{k+1} = (k + 1) · [t^p] (y^k D(y))`. -/
theorem nsmul_coeff_pow_succ (y : R⟦X⟧) (k p : ℕ) :
    p • coeff p (y ^ (k + 1)) = (k + 1) • coeff p (y ^ k * eulerOperator y) := by
  rw [← coeff_eulerOperator, eulerOperator_pow_succ, map_nsmul]

/-- **The logarithmic derivative of `σ = 1 + y`, truncated**: for `σ` with constant coefficient
`1` and `y = σ - 1`,

  `∑_{k < p} (-1)^k [t^p] (y^k D(y)) = (-1)^{p+1} P_p(σ)`,

`P_p` being Newton's power sums of the coefficients of `σ`. The left hand side is the coefficient
of `t^p` in `D(σ)/σ`, the series `1/σ` being replaced by its truncation `∑_{k < p} (-y)^k`. -/
theorem sum_coeff_pow_mul_eulerOperator {f : R⟦X⟧} (hf : constantCoeff f = 1) (p : ℕ) :
    ∑ k ∈ range p, ((-1 : ℤ) ^ k) • coeff p ((f - 1) ^ k * eulerOperator (f - 1)) =
      ((-1 : ℤ) ^ (p + 1)) • newtonPowerSum 0 (fun i : ℕ+ ↦ coeff (i : ℕ) f) p := by
  set g : R⟦X⟧ := ∑ i ∈ range p, (-(f - 1)) ^ i with hg
  have hgf : f * g = 1 - (-(f - 1)) ^ p := by
    have := mul_neg_geom_sum (-(f - 1)) p
    rwa [sub_neg_eq_add, add_sub_cancel] at this
  have hsum : ∑ k ∈ range p, ((-1 : ℤ) ^ k) • coeff p ((f - 1) ^ k * eulerOperator (f - 1)) =
      coeff p (g * eulerOperator f) := by
    rw [hg, Finset.sum_mul, map_sum, eulerOperator_sub_one]
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    rw [← map_zsmul, neg_pow (f - 1) k, zsmul_eq_mul, mul_assoc]
    push_cast
    rfl
  have hX : (X : R⟦X⟧) ^ (p + 1) ∣ (-(f - 1)) ^ p * newtonSeries f := by
    rw [pow_succ]
    refine mul_dvd_mul (pow_dvd_pow_of_dvd (X_dvd_iff.mpr (by simp [hf])) p)
      (X_dvd_iff.mpr ?_)
    rw [← coeff_zero_eq_constantCoeff_apply, coeff_newtonSeries, newtonPowerSum_zero, smul_zero]
  rw [hsum, ← mul_newtonSeries hf, ← mul_assoc, mul_comm g f, hgf, sub_mul, one_mul, map_sub,
    X_pow_dvd_iff.mp hX p (Nat.lt_succ_self p), sub_zero, coeff_newtonSeries]

end LogDeriv

/-! ### Rational classes -/

/-- In `ℚ ⊗ M`: if `m a = n b` with `m, n ≠ 0`, then `a / n = b / m`. -/
theorem one_div_tmul_eq_of_zsmul_eq {M : Type*} [AddCommGroup M] {m n : ℕ} (hm : m ≠ 0)
    (hn : n ≠ 0) {a b : M} (h : (m : ℤ) • a = (n : ℤ) • b) :
    ((1 : ℚ) / n) ⊗ₜ[ℤ] a = ((1 : ℚ) / m) ⊗ₜ[ℤ] b := by
  have h1 : ((1 : ℚ) / n) = (m : ℤ) • ((1 : ℚ) / (n * m)) := by
    rw [zsmul_eq_mul, Int.cast_natCast]
    field_simp
  have h2 : ((1 : ℚ) / m) = (n : ℤ) • ((1 : ℚ) / (n * m)) := by
    rw [zsmul_eq_mul, Int.cast_natCast]
    field_simp
  rw [h1, h2, TensorProduct.smul_tmul, TensorProduct.smul_tmul, h]

section Newton

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
  {E : DerivedCategory X.Modules} (hE : HasDefinedChernClasses E)

/-- **The Chern classes `c_i(E)`, `i ≥ 1`, of an object whose Chern classes are defined**, as
total classes: the homogeneous components of `c(E)`. -/
abbrev perfectChernComponent (i : ℕ+) : TotalChowClass C sX :=
  TotalChowClass.homComponent (i : ℕ) (perfectChernClass C sX hE)

/-- **The subring of `A^*(X)` generated by the Chern classes of `E`.** The ring `A^*(X)` is not
known to be commutative, but the Chern classes of `E` commute with one another, so the universal
polynomials of Stacks 0F9B can be evaluated at them in this subring. -/
abbrev perfectChernSubring : Subring (TotalChowClass C sX) :=
  Subring.closure (Set.range (perfectChernComponent C sX hE))

/-- The subring generated by the Chern classes of `E` is commutative. -/
instance isMulCommutative_perfectChernSubring : IsMulCommutative (perfectChernSubring C sX hE) :=
  Subring.isMulCommutative_closure fun a ha b hb _ => by
    obtain ⟨i, rfl⟩ := ha
    obtain ⟨j, rfl⟩ := hb
    exact commute_homComponent_perfectChernClass C sX hE hE i j

open scoped IsMulCommutative in
/-- The subring generated by the Chern classes of `E`, as a commutative ring. -/
instance instCommRingPerfectChernSubring : CommRing (perfectChernSubring C sX hE) :=
  inferInstance

/-- **The Chern class `c_i(E)` as an element of the commutative subring** it generates with the
other Chern classes of `E`. -/
def perfectChernSub (i : ℕ+) : perfectChernSubring C sX hE :=
  ⟨perfectChernComponent C sX hE i, Subring.subset_closure ⟨i, rfl⟩⟩

/-- The element `perfectChernSub C sX hE i` of the subring is the Chern class `c_i(E)`. -/
@[simp]
theorem coe_perfectChernSub (i : ℕ+) :
    (perfectChernSub C sX hE i : TotalChowClass C sX) = perfectChernComponent C sX hE i :=
  rfl

/-- For `p ≥ 1` the class `Stacks.Chow.perfectPowerSum C sX hE p` is the universal power-sum
polynomial `P_p` of Stacks 0F9B evaluated at the Chern classes of `E`, in the commutative subring of
`A^*(X)` they generate. Since `Stacks.Chow.perfectPowerSum` is itself defined by Newton's recursion
in the components of `c(E)`, this is the identification of that recursion with the polynomial;
Remark 0FAD, for the power sums characterized by the alternating sums `∑_n (-1)^n P_p(𝓔^n)`, is
`Stacks.Chow.newton_identities_of_res_eq_powerSumComplex`. -/
theorem perfectPowerSum_eq_aeval (p : ℕ) (hp : 0 < p) :
    perfectPowerSum C sX hE p =
      (MvPolynomial.aeval (perfectChernSub C sX hE)
        (powerSumPolynomial p : MvPolynomial ℕ+ ℤ) : TotalChowClass C sX) := by
  have haeval : MvPolynomial.aeval (perfectChernSub C sX hE)
      (powerSumPolynomial p : MvPolynomial ℕ+ ℤ) =
        chernClassEval (perfectChernSub C sX hE) (powerSumPolynomial p : MvPolynomial ℕ+ ℤ) := by
    rw [MvPolynomial.aeval_def, algebraMap_int_eq]
    rfl
  rw [haeval, ← newtonPowerSum_eq_chernClassEval 0 _ p hp, ← Subring.coe_subtype,
    map_newtonPowerSum, map_zero, perfectPowerSum, newtonPowerSum_eq_of_pos _ 0 _ p hp]
  rfl

/-- `P_1(E) = c_1(E)`, Remark 0FAD. -/
theorem perfectPowerSum_one :
    perfectPowerSum C sX hE 1 = perfectChernComponent C sX hE 1 := by
  rw [perfectPowerSum_eq_aeval C sX hE 1 (by omega), coe_powerSumPolynomial_one]
  simp

/-- `P_2(E) = c_1(E)^2 - 2 c_2(E)`, Remark 0FAD. -/
theorem perfectPowerSum_two :
    perfectPowerSum C sX hE 2 =
      perfectChernComponent C sX hE 1 ^ 2 - 2 * perfectChernComponent C sX hE 2 := by
  rw [perfectPowerSum_eq_aeval C sX hE 2 (by omega), coe_powerSumPolynomial_two]
  simp
  norm_cast

/-- `P_3(E) = c_1(E)^3 - 3 c_1(E) c_2(E) + 3 c_3(E)`, Remark 0FAD. -/
theorem perfectPowerSum_three :
    perfectPowerSum C sX hE 3 =
      perfectChernComponent C sX hE 1 ^ 3 -
        3 * perfectChernComponent C sX hE 1 * perfectChernComponent C sX hE 2 +
        3 * perfectChernComponent C sX hE 3 := by
  rw [perfectPowerSum_eq_aeval C sX hE 3 (by omega), coe_powerSumPolynomial_three]
  simp
  norm_cast

/-- `P_4(E) = c_1(E)^4 - 4 c_1(E)^2 c_2(E) + 4 c_1(E) c_3(E) + 2 c_2(E)^2 - 4 c_4(E)`,
Remark 0FAD. -/
theorem perfectPowerSum_four :
    perfectPowerSum C sX hE 4 =
      perfectChernComponent C sX hE 1 ^ 4 -
        4 * perfectChernComponent C sX hE 1 ^ 2 * perfectChernComponent C sX hE 2 +
        4 * perfectChernComponent C sX hE 1 * perfectChernComponent C sX hE 3 +
        2 * perfectChernComponent C sX hE 2 ^ 2 - 4 * perfectChernComponent C sX hE 4 := by
  rw [perfectPowerSum_eq_aeval C sX hE 4 (by omega), coe_powerSumPolynomial_four]
  simp
  norm_cast

/-- **`P_0(E) = r(E) = ch_0(E)`**, Remark 0FAD: the degree-zero power sum and the degree-zero
component of the Chern character are the rank of `E`. -/
theorem perfectPowerSum_zero_and_perfectChernCharacterComponent_zero :
    perfectPowerSum C sX hE 0 = perfectRankClass C sX hE ∧
      perfectChernCharacterComponent C sX hE 0 = (1 : ℚ) ⊗ₜ[ℤ] perfectRankClass C sX hE 0 := by
  refine ⟨perfectPowerSum_zero C sX hE, ?_⟩
  rw [perfectChernCharacterComponent, perfectPowerSumComponent, perfectPowerSum_zero]
  simp

/-! ### The logarithm of the total Chern class -/

/-- The Chern classes `c_i(E)`, `i ≥ 0`, as elements of the commutative subring they generate;
`c_0(E) = 1`. -/
def perfectChernSubAll (i : ℕ) : perfectChernSubring C sX hE :=
  if h : i = 0 then 1 else perfectChernSub C sX hE ⟨i, Nat.pos_of_ne_zero h⟩

/-- The element `perfectChernSubAll C sX hE i` of the subring is the degree-`i` component of
the total Chern class `c(E)`. -/
theorem coe_perfectChernSubAll (i : ℕ) :
    (perfectChernSubAll C sX hE i : TotalChowClass C sX) =
      TotalChowClass.homComponent i (perfectChernClass C sX hE) := by
  unfold perfectChernSubAll
  split_ifs with h
  · subst h
    exact (TotalChowClass.homComponent_zero_of_apply_zero
      (perfectChernClass_apply_zero C sX hE)).symm
  · rfl

/-- **The total Chern class `c(E) = ∑_i c_i(E) t^i`** as a power series over the commutative
subring generated by the Chern classes of `E`. -/
def perfectChernSeries : PowerSeries (perfectChernSubring C sX hE) :=
  PowerSeries.mk (perfectChernSubAll C sX hE)

/-- The constant coefficient of the power series `c(E)` is `1`. -/
theorem constantCoeff_perfectChernSeries :
    PowerSeries.constantCoeff (perfectChernSeries C sX hE) = 1 := by
  rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, perfectChernSeries, PowerSeries.coeff_mk]
  exact dite_eq_left rfl

/-- Mapping `perfectChernSeries C sX hE` into `A^*(X)` gives the power series of homogeneous
components of the total Chern class `c(E)`. -/
theorem map_perfectChernSeries :
    PowerSeries.map (perfectChernSubring C sX hE).subtype (perfectChernSeries C sX hE) =
      TotalChowClass.homSeries (perfectChernClass C sX hE) := by
  refine PowerSeries.ext fun i ↦ ?_
  rw [PowerSeries.coeff_map, perfectChernSeries, PowerSeries.coeff_mk,
    TotalChowClass.coeff_homSeries]
  exact coe_perfectChernSubAll C sX hE i

/-- The homogeneous components of the powers of `c(E) - 1` are computed in the commutative
subring. -/
theorem homComponent_pow_perfectChernClass_sub_one (k p : ℕ) :
    TotalChowClass.homComponent p ((perfectChernClass C sX hE - 1) ^ k) =
      ((PowerSeries.coeff p ((perfectChernSeries C sX hE - 1) ^ k) :
        perfectChernSubring C sX hE) : TotalChowClass C sX) := by
  have hmap : PowerSeries.map (perfectChernSubring C sX hE).subtype
      ((perfectChernSeries C sX hE - 1) ^ k) =
      (PowerSeries.map (perfectChernSubring C sX hE).subtype (perfectChernSeries C sX hE) -
        1) ^ k := by
    rw [map_pow, map_sub, map_one]
  rw [← TotalChowClass.coeff_homSeries, map_pow, map_sub, map_one, ← map_perfectChernSeries,
    ← hmap, PowerSeries.coeff_map]
  rfl

/-- The degree-`p` part of `(c(E) - 1)^k` is computed in the commutative subring. -/
private theorem pow_perfectChernClass_sub_one_apply (k p : ℕ) :
    ((perfectChernClass C sX hE - 1) ^ k) p =
      ((PowerSeries.coeff p ((perfectChernSeries C sX hE - 1) ^ k) :
        perfectChernSubring C sX hE) : TotalChowClass C sX) p := by
  rw [← homComponent_pow_perfectChernClass_sub_one, TotalChowClass.homComponent_apply,
    ite_eq_left rfl]

/-- The degree-`p` part of `log c(E) = ∑_{k ≥ 1} (-1)^{k-1} (c(E) - 1)^k / k` only involves
`k ≤ p`: the class `(c(E) - 1)^k` vanishes in degrees `< k`. -/
theorem pow_perfectChernClass_sub_one_apply_of_lt {k p : ℕ} (h : p < k) :
    ((perfectChernClass C sX hE - 1) ^ k) p = 0 := by
  rw [pow_perfectChernClass_sub_one_apply]
  have hX : (PowerSeries.X : PowerSeries (perfectChernSubring C sX hE)) ^ k ∣
      (perfectChernSeries C sX hE - 1) ^ k :=
    pow_dvd_pow_of_dvd (PowerSeries.X_dvd_iff.mpr (by
      rw [map_sub, constantCoeff_perfectChernSeries, map_one, sub_self])) k
  rw [PowerSeries.X_pow_dvd_iff.mp hX p h]
  rfl

/-- **The logarithmic identity for a perfect object.** In `A^p(X) ⊗ 𝐐`,

  `∑_{k = 1}^{p} (-1)^{k-1} (c(E) - 1)^k / k = (-1)^{p-1} P_p(E) / p`,

the left hand side being the degree-`p` part of `log c(E)` (the terms with `k > p` vanish in
degree `p`: `Stacks.Chow.pow_perfectChernClass_sub_one_apply_of_lt`). So
`log c(E) = ∑_p (-1)^{p-1} P_p(E) / p`, Remark 0FAD. -/
theorem log_perfectChernClass (p : ℕ) :
    ∑ k ∈ Finset.Icc 1 p, ((-1 : ℚ) ^ (k - 1) / k) ⊗ₜ[ℤ]
        ((perfectChernClass C sX hE - 1) ^ k) p =
      ((-1 : ℚ) ^ (p - 1) / p) ⊗ₜ[ℤ] perfectPowerSumComponent C sX hE p := by
  rcases Nat.eq_zero_or_pos p with rfl | hp
  · simp
  set S := perfectChernSubring C sX hE
  set σ := perfectChernSeries C sX hE
  let ψ : S →+ chowCohomologyComponent C (gysinSystemOfInvertible C) sX (p : ℤ) :=
    { toFun := fun r ↦ (r : TotalChowClass C sX) p
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }
  have ha : ∀ k, ((perfectChernClass C sX hE - 1) ^ k) p =
      ψ (PowerSeries.coeff p ((σ - 1) ^ k)) := fun k ↦
    pow_perfectChernClass_sub_one_apply C sX hE k p
  have hb : ∀ k : ℕ, (p : ℤ) • ψ (PowerSeries.coeff p ((σ - 1) ^ (k + 1))) =
      ((k + 1 : ℕ) : ℤ) • ψ (PowerSeries.coeff p ((σ - 1) ^ k * eulerOperator (σ - 1))) := by
    intro k
    rw [natCast_zsmul, natCast_zsmul, ← map_nsmul ψ p, ← map_nsmul ψ (k + 1),
      nsmul_coeff_pow_succ]
  have hP : ψ (newtonPowerSum 0 (fun i : ℕ+ ↦ PowerSeries.coeff (i : ℕ) σ) p) =
      perfectPowerSumComponent C sX hE p := by
    change ((S.subtype (newtonPowerSum 0 (fun i : ℕ+ ↦ PowerSeries.coeff (i : ℕ) σ) p)) :
      TotalChowClass C sX) p = _
    have hfun : (fun i : ℕ+ ↦ S.subtype (PowerSeries.coeff (i : ℕ) σ)) =
        fun i : ℕ+ ↦ TotalChowClass.homComponent (i : ℕ) (perfectChernClass C sX hE) := by
      funext i
      rw [Subring.coe_subtype]
      change ((PowerSeries.coeff (i : ℕ) (PowerSeries.mk (perfectChernSubAll C sX hE)) : S) :
        TotalChowClass C sX) = _
      rw [PowerSeries.coeff_mk, coe_perfectChernSubAll]
    rw [map_newtonPowerSum, map_zero, hfun, perfectPowerSumComponent, perfectPowerSum,
      newtonPowerSum_eq_of_pos (perfectRankClass C sX hE) 0 _ p hp]
  have hsum := congrArg ψ (sum_coeff_pow_mul_eulerOperator
    (constantCoeff_perfectChernSeries C sX hE) p)
  rw [map_sum, map_zsmul, hP] at hsum
  simp_rw [map_zsmul] at hsum
  rw [← Finset.Ico_add_one_right_eq_Icc, Finset.sum_Ico_eq_sum_range, Nat.add_sub_cancel]
  have hterm : ∀ k ∈ range p, ((-1 : ℚ) ^ (1 + k - 1) / ((1 + k : ℕ) : ℚ)) ⊗ₜ[ℤ]
      ((perfectChernClass C sX hE - 1) ^ (1 + k)) p =
      ((1 : ℚ) / p) ⊗ₜ[ℤ] (((-1 : ℤ) ^ k) •
        ψ (PowerSeries.coeff p ((σ - 1) ^ k * eulerOperator (σ - 1)))) := by
    intro k _
    rw [ha, add_comm 1 k, TensorProduct.tmul_smul,
      ← one_div_tmul_eq_of_zsmul_eq (m := p) (n := k + 1) hp.ne' (by omega) (hb k),
      TensorProduct.smul_tmul']
    congr 1
    rw [zsmul_eq_mul, Nat.add_sub_cancel]
    push_cast
    ring
  rw [Finset.sum_congr rfl hterm, ← TensorProduct.tmul_sum, hsum, TensorProduct.tmul_smul,
    TensorProduct.smul_tmul']
  congr 1
  rw [zsmul_eq_mul]
  push_cast
  rw [show p + 1 = (p - 1) + 2 by omega, pow_add]
  ring

/-! ### The power sums characterized by the alternating sum -/

/-- **A class restricting to the alternating sums is `P_p(E)`.** If, along the envelope of one
presentation `𝓔^•` of `E`, the classes `P p` restrict to the power sums
`P_p(𝓔^•) = ∑_n (-1)^n P_p(𝓔^n)` of the complex (glued over its rank loci), then `P` is the
sequence `P_p(E)` of Stacks 0F9E (2), by the uniqueness of Stacks 0GUD. -/
theorem eq_perfectPowerSum_of_res_eq_powerSumComplex (H : EnvelopePresentation E)
    {P : ℕ → TotalChowClass C sX}
    (hP : ∀ p, TotalChowClass.res H.f rfl (P p) = powerSumComplex C (H.f ≫ sX) H.locallyBounded p) :
    P = perfectPowerSum C sX hE :=
  funext fun p ↦ eq_perfectPowerSum C sX hE H p (hP p)

/-- **Newton's identities for a perfect object**, Remark 0FAD, for the power sums as Stacks
defines them. Let `P_p` be classes on `X` restricting, along the envelope `f : Y ⟶ X` of a
presentation of `E` by a locally bounded complex `𝓔^•` of finite locally free modules, to the
alternating sums `P_p(𝓔^•) = ∑_n (-1)^n P_p(𝓔^n)` (this characterizes `P_p(E)`, Stacks 0GUD).
Then, with `c_i = c_i(E)` the Chern classes of `E`:

* `P` satisfies Newton's recursion
  `P_{p+1} = ∑_{j < p} (-1)^j c_{j+1} P_{p-j} + (-1)^p (p + 1) c_{p+1}`;
* for `p ≥ 1`, `P_p` is the power-sum polynomial `P_p` of Stacks 0F9B evaluated at
  `c_1(E), c_2(E), …` — the same expression as for a vector bundle — computed in the commutative
  subring of `A^*(X)` the Chern classes generate;
* `P_1 = c_1`, `P_2 = c_1² - 2c_2`, `P_3 = c_1³ - 3c_1c_2 + 3c_3` and
  `P_4 = c_1⁴ - 4c_1²c_2 + 4c_1c_3 + 2c_2² - 4c_4`;
* `P_0 = r(E)`, the alternating rank class;
* `log c(E) = ∑_p (-1)^{p-1} P_p/p`, degree by degree in `A^p(X) ⊗ 𝐐`.

The content is that the alternating sums of the power sums of the terms satisfy Newton's
recursion in the Chern classes of the complex (`Stacks.Chow.isNewtonPowerSums_powerSumComplex`,
`Stacks.Chow.powerSumComplex_eq_complexPowerSum`). -/
@[stacks 0FAD "for classes P_p restricting along the envelope of a presentation E^bullet of E to \
the alternating sums P_p(E^bullet) = sum_n (-1)^n P_p(E^n), i.e. P_p = P_p(E): Newton's \
recursion in the c_i(E); P_p = the 0F9B polynomial in c_1(E), c_2(E), ... for p >= 1; the four \
displayed formulas P_1 to P_4; P_0 = r(E); and log c(E) = sum_p (-1)^{p-1} P_p/p degree by \
degree in A^p(X) tensor Q"]
theorem newton_identities_of_res_eq_powerSumComplex (H : EnvelopePresentation E)
    {P : ℕ → TotalChowClass C sX}
    (hP : ∀ p, TotalChowClass.res H.f rfl (P p) = powerSumComplex C (H.f ≫ sX) H.locallyBounded p) :
    TotalChowClass.IsNewtonPowerSums (perfectChernClass C sX hE) P ∧
    (∀ p, 0 < p → P p = (MvPolynomial.aeval (perfectChernSub C sX hE)
        (powerSumPolynomial p : MvPolynomial ℕ+ ℤ) : TotalChowClass C sX)) ∧
    P 1 = perfectChernComponent C sX hE 1 ∧
    P 2 = perfectChernComponent C sX hE 1 ^ 2 - 2 * perfectChernComponent C sX hE 2 ∧
    P 3 = perfectChernComponent C sX hE 1 ^ 3 -
        3 * perfectChernComponent C sX hE 1 * perfectChernComponent C sX hE 2 +
        3 * perfectChernComponent C sX hE 3 ∧
    P 4 = perfectChernComponent C sX hE 1 ^ 4 -
        4 * perfectChernComponent C sX hE 1 ^ 2 * perfectChernComponent C sX hE 2 +
        4 * perfectChernComponent C sX hE 1 * perfectChernComponent C sX hE 3 +
        2 * perfectChernComponent C sX hE 2 ^ 2 - 4 * perfectChernComponent C sX hE 4 ∧
    P 0 = perfectRankClass C sX hE ∧
    ∀ p : ℕ, ∑ k ∈ Finset.Icc 1 p, ((-1 : ℚ) ^ (k - 1) / k) ⊗ₜ[ℤ]
        ((perfectChernClass C sX hE - 1) ^ k) p =
      ((-1 : ℚ) ^ (p - 1) / p) ⊗ₜ[ℤ] P p p := by
  obtain rfl := eq_perfectPowerSum_of_res_eq_powerSumComplex C sX hE H hP
  exact ⟨isNewtonPowerSums_perfectPowerSum C sX hE, perfectPowerSum_eq_aeval C sX hE,
    perfectPowerSum_one C sX hE, perfectPowerSum_two C sX hE, perfectPowerSum_three C sX hE,
    perfectPowerSum_four C sX hE, perfectPowerSum_zero C sX hE, log_perfectChernClass C sX hE⟩

end Newton

/-! ### The rank is not determined by the total Chern class -/

section Rank

variable (C : ChowSituation.{u})

/-- **On a nonempty scheme the unit of `A^*` is not zero.** Some test scheme, the spectrum of the
residue field at a closed point of an affine open, has a nonzero Chow group: a one-point scheme
carries no rational equivalences in the degree of its point. -/
theorem TotalChowClass.one_ne_zero {Y : Scheme.{u}} (sY : Y ⟶ C.S) [LocallyOfFiniteType sY]
    [Nonempty Y] : (1 : TotalChowClass C sY) ≠ 0 := by
  classical
  intro h1
  obtain ⟨i, y, -⟩ := Y.affineCover.exists_eq (Classical.choice ‹Nonempty Y›)
  obtain ⟨z, -, hz⟩ := IsClosed.exists_closed_singleton
    (isClosed_univ : IsClosed (Set.univ : Set (Y.affineCover.X i))) ⟨y, Set.mem_univ y⟩
  have : IsClosedImmersion ((Y.affineCover.X i).fromSpecResidueField z) :=
    isClosed_singleton_iff_isClosedImmersion.mp hz
  let g : Spec ((Y.affineCover.X i).residueField z) ⟶ Y :=
    (Y.affineCover.X i).fromSpecResidueField z ≫ Y.affineCover.f i
  obtain ⟨t⟩ : Nonempty (Spec ((Y.affineCover.X i).residueField z)) := inferInstance
  set k := relativeDimension C.dimensionFunction (g ≫ sY) t
  have hbot : rationalEquivalences C (g ≫ sY) k = ⊥ :=
    rationalEquivalences_eq_bot_of_relativeDimension_le C _ k fun t' ↦ by
      rw [Subsingleton.elim t' t]
  let a : CycleGroup C (g ≫ sY) k :=
    ⟨Function.locallyFinsuppWithin.single t 1,
      (mem_cyclesOfDimension_iff_forall_point C _ k _).mpr fun x _ ↦ by
        rw [Subsingleton.elim x t]⟩
  have ha : (QuotientAddGroup.mk' (rationalEquivalences C (g ≫ sY) k) a) ≠ 0 := by
    intro h0
    have hmem := (QuotientAddGroup.eq_zero_iff a).mp h0
    rw [hbot, AddSubgroup.mem_bot] at hmem
    have := congrArg (fun b : CycleGroup C (g ≫ sY) k ↦ b.1 t) hmem
    simp [a] at this
  apply ha
  have h2 : (1 : TotalChowClass C sY).op g = (0 : TotalChowClass C sY).op g := by rw [h1]
  rw [TotalChowClass.op_one, TotalChowClass.op_zero] at h2
  have h3 := congrArg (fun F : GradedCapFamily (fun k ↦ chowGroup C (g ≫ sY) k) ↦
    F k 0 (QuotientAddGroup.mk' _ a)) h2
  simp only [gradedCap_one_apply_zero] at h3
  exact (gradedDegreeCast _ _).injective (h3.trans (by simp))

variable {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

/-- **`c(𝒪_X) = 1`**: the first Chern class of the trivial invertible module vanishes. -/
theorem totalChern_unit :
    haveI : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property
        (SheafOfModules.unit X.ringCatSheaf) :=
      AlgebraicGeometry.SheafOfModules.isInvertible_unit X.presheaf X.ringCatSheaf.2
    letI := isFiniteLocallyFreeOfRank_one_of_isInvertible (SheafOfModules.unit X.ringCatSheaf)
    totalChern C sX (SheafOfModules.unit X.ringCatSheaf) 1 = 1 := by
  have : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property
      (SheafOfModules.unit X.ringCatSheaf) :=
    AlgebraicGeometry.SheafOfModules.isInvertible_unit X.presheaf X.ringCatSheaf.2
  let := isFiniteLocallyFreeOfRank_one_of_isInvertible (SheafOfModules.unit X.ringCatSheaf)
  refine TotalChowClass.ext_op fun g _ ↦ (op_totalChern C sX _ 1 g).trans ?_
  rw [TotalChowClass.op_one]
  let := pullbackPreservesRank_of_isFiniteLocallyFreeOfRank
    (SheafOfModules.unit X.ringCatSheaf) 1 g
  exact GenuineChern.chernFamily_eq_one_of_iso_unit C (g ≫ sX) _ (Scheme.Modules.pullbackUnitIso g)

/-- The complex `M[0]` of a finite locally free module of rank `r` has the constant ranks
`r` in degree `0` and `0` elsewhere. -/
theorem isFiniteLocallyFreeOfRank_singleZero (M : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r] (n : ℤ) :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} ((singleZero M).X n)
      (Finsupp.single 0 r n) := by
  by_cases hn : n = 0
  · subst hn
    have key : ∀ m : ℕ, m = r → AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        ((singleZero M).X 0) m := fun m hm ↦ hm ▸
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u}
        (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).symm inferInstance
    exact key _ (by simp)
  · have key : ∀ m : ℕ, m = 0 → AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        ((singleZero M).X n) m := fun m hm ↦ hm ▸ isFiniteLocallyFreeOfRank_zero_of_isZero
      (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 M n hn)
    exact key _ (by simp [Ne.symm hn])

/-- `M[0]` is a locally bounded complex of finite locally free modules. -/
theorem isLocallyBoundedFiniteLocallyFree_singleZero_of_rank (M : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r] :
    IsLocallyBoundedFiniteLocallyFree (singleZero M) :=
  isLocallyBoundedFiniteLocallyFree_singleZero M
    (SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree (r := r) M)

/-- The presentation of `M[0]` by itself, along the identity of `X`. -/
abbrev singleZeroPresentation (M : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r] :
    EnvelopePresentation (DerivedCategory.Q.obj (singleZero M)) :=
  ⟨X, 𝟙 X, ⟨inferInstance, isCompletelyDecomposed_id X⟩, singleZero M,
    isLocallyBoundedFiniteLocallyFree_singleZero_of_rank M r,
    ⟨(Cohomology.DerivedPullbackAlongIso.derivedPullbackIdIso X.toRingedSpace).app _⟩⟩

/-- The Chern classes of `M[0]` are defined. -/
theorem hasDefinedChernClasses_singleZero (M : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r] :
    HasDefinedChernClasses (DerivedCategory.Q.obj (singleZero M)) :=
  ⟨singleZeroPresentation M r⟩

/-- **The total Chern class of `M[0]`** is the total Chern class of `M`. -/
theorem perfectChernClass_singleZero (M : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r] :
    perfectChernClass C sX (hasDefinedChernClasses_singleZero M r) = totalChern C sX M r := by
  refine (perfectChernClass_eq_complexChern C sX _
    (isLocallyBoundedFiniteLocallyFree_singleZero_of_rank M r) (Iso.refl _)).trans ?_
  rw [complexChern_eq_complexChernBounded C sX _ (Finsupp.single 0 r)
    (isFiniteLocallyFreeOfRank_singleZero M r),
    complexChernBounded_eq_prod C sX _ _ _ {0} fun n hn ↦
      Finsupp.single_eq_of_ne (by simpa using hn)]
  let := isFiniteLocallyFreeOfRank_singleZero M r 0
  simp only [complexChernProd, Finset.sort_singleton, List.map_cons, List.map_nil,
    List.prod_cons, List.prod_nil, mul_one, complexChernFactor, Int.negOnePow_zero,
    Units.val_one, zpow_one, val_totalChernUnit]
  exact totalChern_congr C sX (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M)
    (Finsupp.single_eq_same)

/-- **The rank of `M[0]`**, restricted along the identity, is the rank of `M`. -/
theorem res_perfectRankClass_singleZero [Nonempty X] (M : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r] :
    TotalChowClass.res (𝟙 X) rfl (TotalChowClass.res (𝟙 X) rfl
      (perfectRankClass C sX (hasDefinedChernClasses_singleZero M r))) = (r : ℤ) • 1 := by
  have h := res_perfectRankClass C sX (hasDefinedChernClasses_singleZero M r)
    (singleZeroPresentation M r)
  change TotalChowClass.res (𝟙 X) rfl (TotalChowClass.res (singleZeroPresentation M r).f rfl
    (perfectRankClass C sX (hasDefinedChernClasses_singleZero M r))) = _
  rw [h, res_complexRankClass_of_constant_rank C _ _ (𝟙 X) rfl (Finsupp.single 0 r) fun n ↦
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u}
        ((Scheme.Modules.pullbackId X).app ((singleZero M).X n)).symm
        (isFiniteLocallyFreeOfRank_singleZero M r n),
    finsum_eq_single _ 0 fun n hn ↦ by rw [Finsupp.single_eq_of_ne hn]; simp]
  simp

/-- **The rank of a perfect object is not determined by its total Chern class**, Remark 0FAD: on
every nonempty `X` there are perfect objects `E` and `F` whose Chern classes are defined, with
`c(E) = c(F)` but `P_0(E) = r(E) ≠ r(F) = P_0(F)`. Namely `E = 𝒪_X[0]` and `F = 0[0]`: both
have total Chern class `1`, and their ranks are `1` and `0`. -/
@[stacks 0FAD "the bivariant class P_0(E) = r(E) cannot be recovered from the Chern class c(E): \
on every nonempty X, c(O_X[0]) = c(0) = 1 while r(O_X[0]) = 1 differs from r(0) = 0"]
theorem exists_perfectChernClass_eq_perfectPowerSum_zero_ne [Nonempty X] :
    ∃ (E F : DerivedCategory X.Modules)
      (_ : RingedSpace.IsPerfect.{u, u + 1} (X := X.toRingedSpace) E)
      (_ : RingedSpace.IsPerfect.{u, u + 1} (X := X.toRingedSpace) F)
      (hE : HasDefinedChernClasses E) (hF : HasDefinedChernClasses F),
      perfectChernClass C sX hE = perfectChernClass C sX hF ∧
        perfectPowerSum C sX hE 0 ≠ perfectPowerSum C sX hF 0 := by
  have : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property
      (SheafOfModules.unit X.ringCatSheaf) :=
    AlgebraicGeometry.SheafOfModules.isInvertible_unit X.presheaf X.ringCatSheaf.2
  let := isFiniteLocallyFreeOfRank_one_of_isInvertible (SheafOfModules.unit X.ringCatSheaf)
  let : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (0 : X.Modules) 0 := isFiniteLocallyFreeOfRank_zero_of_isZero (isZero_zero _)
  have hperf₁ : RingedSpace.IsPerfect.{u, u + 1} (X := X.toRingedSpace)
      (DerivedCategory.Q.obj (singleZero (SheafOfModules.unit X.ringCatSheaf))) :=
    (RingedSpace.isPerfect_iff_perfectComplexes_isPerfect.{u, u + 1} (X := X.toRingedSpace)
      _).mpr (isPerfect_singleZero (SheafOfModules.unit X.ringCatSheaf))
  have hperf₀ : RingedSpace.IsPerfect.{u, u + 1} (X := X.toRingedSpace)
      (DerivedCategory.Q.obj (singleZero (0 : X.Modules))) :=
    RingedSpace.isPerfect_Q_obj_of_isStrictlyPerfect.{u, u + 1} (X := X.toRingedSpace)
      (StrictlyPerfect.isStrictlyPerfect_of_forall_isZero fun i ↦ by
        by_cases hi : i = 0
        · subst hi
          exact (isZero_zero X.Modules).of_iso
            (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (0 : X.Modules))
        · exact HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 _ i hi)
  have hc : perfectChernClass C sX
      (hasDefinedChernClasses_singleZero (SheafOfModules.unit X.ringCatSheaf) 1) =
      perfectChernClass C sX (hasDefinedChernClasses_singleZero (0 : X.Modules) 0) := by
    refine (perfectChernClass_singleZero C sX (SheafOfModules.unit X.ringCatSheaf) 1).trans
      (((totalChern_unit C sX).trans (totalChern_of_rank_zero C sX (0 : X.Modules)).symm).trans
        (perfectChernClass_singleZero C sX (0 : X.Modules) 0).symm)
  have hr : perfectPowerSum C sX
      (hasDefinedChernClasses_singleZero (SheafOfModules.unit X.ringCatSheaf) 1) 0 ≠
      perfectPowerSum C sX (hasDefinedChernClasses_singleZero (0 : X.Modules) 0) 0 := by
    rw [perfectPowerSum_zero, perfectPowerSum_zero]
    intro h
    have h₁ := res_perfectRankClass_singleZero C sX (SheafOfModules.unit X.ringCatSheaf) 1
    have h₀ := res_perfectRankClass_singleZero C sX (0 : X.Modules) 0
    rw [h] at h₁
    rw [h₁, Nat.cast_one, one_smul, Nat.cast_zero, zero_smul] at h₀
    exact TotalChowClass.one_ne_zero C _ h₀
  exact ⟨_, _, hperf₁, hperf₀, _, _, hc, hr⟩

end Rank

end Stacks.Chow

end
