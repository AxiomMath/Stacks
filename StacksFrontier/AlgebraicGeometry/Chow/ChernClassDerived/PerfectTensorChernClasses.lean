module

public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.TensorChernRoots
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.PerfectPowerSum
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassArbitraryRank.BivariantChernCharacter
public import StacksCore.Tactic.StacksAttribute

/-!
# The Chern classes of the derived tensor product of two perfect objects

Let `(S, δ)` be as in Situation 02QL, let `X` be locally of finite type over `S` and let `E`, `F`
be perfect objects of `D(𝒪_X)` whose Chern classes are defined. [Stacks, Tag 0FAG] states

  `c₁(E ⊗^𝐋 F) = r(E) c₁(F) + r(F) c₁(E)`,

  `c₂(E ⊗^𝐋 F) = r(E) c₂(F) + r(F) c₂(E) + C(r(E), 2) c₁(F)² + (r(E) r(F) - 1) c₁(F) c₁(E)
     + C(r(F), 2) c₁(E)²`,

"and so on for higher Chern classes in `A^*(X)`", and similarly `ch(E ⊗^𝐋 F) = ch(E) ch(F)` in
`A^*(X) ⊗ 𝐐`, more precisely `P_p(E ⊗^𝐋 F) = ∑_{p₁ + p₂ = p} C(p, p₁) P_{p₁}(E) P_{p₂}(F)` in
`A^p(X)`.

## The proof

The source proves the lemma by the splitting principle of Remark 0FAD, reducing it to
computations in polynomial rings. This is what is done here.

* The Chern classes of `E ⊗^𝐋 F` are defined: on a common envelope of presentations of `E` and
  `F` the total tensor complex presents `E ⊗^𝐋 F`
  (`Stacks.Chow.hasDefinedChernClasses_derivedTensor`).
* On a tensor split chart (`Stacks.Chow.TensorSplitChart`) all three objects have Chern roots:
  `x_{n,j}` for `E`, `y_{m,k}` for `F` and `x_{n,j} + y_{m,k}` for `E ⊗^𝐋 F`, with the signs
  `(-1)^n`, `(-1)^m` and `(-1)^{n+m}`; restriction to the charts is injective
  (`Stacks.Chow.exists_tensorSplitCharts`, the general statement behind "and so on").
* The formulas are then the formal computations of
  `StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.ChernRootJets` in the commutative subring
  generated by the roots: `Stacks.Chow.rootSum_rootTensor_of_commute`,
  `Stacks.Chow.rootSumTwo_rootTensor_of_commute` and
  `Stacks.Chow.rootPow_rootTensor_of_commute`.

## Conventions

The ring `A^*(X)` is `Stacks.Chow.TotalChowClass C sX`, the product of the Chow cohomology groups
`A^p(X)` under composition of bivariant classes; `c_i(E)` is the homogeneous component of degree
`i` of the total Chern class `c(E)` (`Stacks.Chow.perfectChernClass`), and its component in
`A^i(X)` is `perfectChernClass C sX hE i`. The rank `r(E) = P₀(E)` is
`Stacks.Chow.perfectRankClass`, a locally constant class of degree zero, and `C(r(E), k)` is the
class `Stacks.Chow.perfectRankChooseClass` which is `C(n, k)` on the open and closed locus where
the rank of `E` is `n`. The ring `A^*(X) ⊗ 𝐐` is `Stacks.Chow.rationalTotalChowClass C sX`, and
`ch(E)` is the power series over it whose coefficient of degree `p` is `P_p(E)/p!`
(`Stacks.Chow.perfectTotalChernCharacter`).

## References

* [Stacks Project, Tag 0FAG](https://stacks.math.columbia.edu/tag/0FAG)
* [Stacks Project, Tag 0FAD](https://stacks.math.columbia.edu/tag/0FAD)
* [Stacks Project, Tag 0F9E](https://stacks.math.columbia.edu/tag/0F9E)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Finset
open Stacks.DerivedTensor.RingedSite (derivedTensorProductFunctor)

universe u

namespace Stacks.Chow

attribute [local instance 10000] HasDerivedCategory.standard

/-! ### The binomial coefficients of the rank -/

section RankChoose

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
  {E : DerivedCategory X.Modules}
  (perfect : RingedSpace.IsPerfect.{u, u + 1} (X := X.toRingedSpace) E)

/-- **The class `C(r(E), k)`** of a perfect object `E`: the class of degree zero which is
`C(n, k)` times the unit on the open and closed locus where the rank of `E` (the Euler
characteristic of its derived fibres, Stacks 0BDJ) is `n`. -/
def perfectRankChooseClass (k : ℕ) : TotalChowClass C sX :=
  TotalChowClass.glue (C := C) (sY := sX) (isClopenDecomposition_eulerLoci perfect)
    fun n ↦ (Ring.choose (n.down : ℤ) k) • 1

/-- A class glued from integer multiples of the unit over the Euler loci restricts, along a
morphism landing in one Euler locus, to the corresponding multiple of the unit. -/
theorem res_glue_eulerLoci_zsmul_of_range (f : ℤ → ℤ) {Z : Scheme.{u}} (h : Z ⟶ X)
    [LocallyOfFiniteType h] {sZ : Z ⟶ C.S} [LocallyOfFiniteType sZ] (hs : h ≫ sX = sZ) (m : ℤ)
    (hrange : Set.range h.base ⊆ (eulerLocus perfect m : Set X)) :
    TotalChowClass.res h hs (TotalChowClass.glue (C := C) (sY := sX)
      (isClopenDecomposition_eulerLoci perfect) fun n ↦ f n.down • 1) = f m • 1 := by
  subst hs
  set h' := IsOpenImmersion.lift (eulerLocus perfect m).ι h
    (by rw [Scheme.Opens.range_ι]; exact hrange)
  have hh : h' ≫ (eulerLocus perfect m).ι = h := IsOpenImmersion.lift_fac _ _ _
  have : LocallyOfFiniteType (h' ≫ (eulerLocus perfect m).ι) := by rw [hh]; infer_instance
  have : LocallyOfFiniteType h' := locallyOfFiniteType_of_comp h' (eulerLocus perfect m).ι
  rw [TotalChowClass.res_congr hh.symm rfl (by rw [hh]), ← TotalChowClass.res_res
    (eulerLocus perfect m).ι rfl h' (by rw [← Category.assoc, hh]),
    TotalChowClass.res_glue (isClopenDecomposition_eulerLoci perfect) _ (ULift.up m), map_zsmul,
    map_one]

/-- The class `C(r(E), k)` restricts, along a morphism landing in the locus where the rank of
`E` is `m`, to `C(m, k)` times the unit. -/
theorem res_perfectRankChooseClass_of_range (k : ℕ) {Z : Scheme.{u}} (h : Z ⟶ X)
    [LocallyOfFiniteType h] {sZ : Z ⟶ C.S} [LocallyOfFiniteType sZ] (hs : h ≫ sX = sZ) (m : ℤ)
    (hrange : Set.range h.base ⊆ (eulerLocus perfect m : Set X)) :
    TotalChowClass.res h hs (perfectRankChooseClass C sX perfect k) = Ring.choose m k • 1 :=
  res_glue_eulerLoci_zsmul_of_range C sX perfect (fun n ↦ Ring.choose n k) h hs m hrange

/-- In degree one the class `C(r(E), 1)` is the rank `r(E)` itself. -/
theorem perfectRankChooseClass_one (hE : HasDefinedChernClasses E) :
    perfectRankChooseClass C sX perfect 1 = perfectRankClass C sX hE := by
  rw [perfectRankClass_eq_glue_eulerLoci perfect C sX hE, perfectRankChooseClass]
  simp only [Ring.choose_one_right]

/-- **`C(r(E), 2)` is the binomial coefficient of the rank**: `2 C(r(E), 2) = r(E) (r(E) - 1)`, as
classes of degree zero. -/
theorem two_mul_perfectRankChooseClass_two (hE : HasDefinedChernClasses E) :
    2 * perfectRankChooseClass C sX perfect 2 =
      perfectRankClass C sX hE * (perfectRankClass C sX hE - 1) := by
  refine TotalChowClass.eq_of_res_eq (isClopenDecomposition_eulerLoci perfect) fun n ↦ ?_
  have hr : TotalChowClass.res (eulerLoci perfect n).ι rfl (perfectRankClass C sX hE) =
      (n.down : ℤ) • 1 := by
    rw [perfectRankClass_eq_glue_eulerLoci perfect C sX hE, TotalChowClass.res_glue]
  have hc : TotalChowClass.res (eulerLoci perfect n).ι rfl
      (perfectRankChooseClass C sX perfect 2) = Ring.choose (n.down : ℤ) 2 • 1 := by
    rw [perfectRankChooseClass, TotalChowClass.res_glue]
  rw [map_mul, map_mul, map_sub, map_one, map_ofNat, hr, hc, zsmul_one, zsmul_one]
  have h := congrArg (Int.cast : ℤ → TotalChowClass C ((eulerLoci perfect n).ι ≫ sX))
    (two_mul_ringChoose_two n.down)
  push_cast at h
  exact h

end RankChoose

/-! ### Restriction to a split chart -/

section ChartRestriction

variable {C : ChowSituation.{u}} {X : Scheme.{u}} {sX : X ⟶ C.S} [LocallyOfFiniteType sX]
  {E' : DerivedCategory X.Modules} {H₁ : EnvelopePresentation E'} {y : H₁.Y}

/-- Restriction to a split chart commutes with taking the component of degree `i`. -/
theorem SplitChart.res_homComponent (χ : SplitChart C sX H₁ y) (i : ℕ) (c : TotalChowClass C sX) :
    χ.res (TotalChowClass.homComponent i c) = TotalChowClass.homComponent i (χ.res c) :=
  TotalChowClass.res_homComponent _ _ _ _

/-- **The rank on a split chart** is the rank of the signed roots. -/
theorem SplitChart.res_perfectRankClass (χ : SplitChart C sX H₁ y)
    (hE : HasDefinedChernClasses E') :
    χ.res (perfectRankClass C sX hE) = ((rootRank χ.roots : ℤ) : TotalChowClass C χ.T.sP) := by
  rw [← perfectPowerSum_zero, χ.res_perfectPowerSum_eq_rootPow hE 0, rootPow_zero]

/-- A split chart maps into the locus where the rank of the object is the rank of the signed
roots. -/
theorem SplitChart.range_subset_eulerLocus (χ : SplitChart C sX H₁ y)
    (perfect : RingedSpace.IsPerfect.{u, u + 1} (X := X.toRingedSpace) E') :
    Set.range χ.map.base ⊆ (eulerLocus perfect (rootRank χ.roots) : Set X) := by
  rintro _ ⟨t, rfl⟩
  set v := ((H₁.componentOpens sX y).ι.base (χ.T.π.base t))
  have hv : v ∈ complexRankLocus H₁.locallyBounded (complexRank H₁.locallyBounded y) :=
    H₁.complexRank_eq_of_mem_componentOpens sX (χ.T.π.base t).2
  have h := chiDerivedFibre_eq_sum_of_mem_complexRankLocus perfect H₁
    (complexRank H₁.locallyBounded y) ⟨v, hv⟩
  refine (mem_eulerLocus perfect).mpr ?_
  rw [SplitChart.rootRank_roots, ← finsum_eq_sum_of_support_subset _ (fun n hn ↦ by
    rw [Function.mem_support] at hn
    rw [Finset.mem_coe, Finsupp.mem_support_iff]
    intro h0
    exact hn (by rw [h0]; simp))]
  exact h

/-- **The class `C(r(E), k)` on a split chart** is `C(m, k)`, where `m` is the rank of the signed
roots. -/
theorem SplitChart.res_perfectRankChooseClass (χ : SplitChart C sX H₁ y)
    (perfect : RingedSpace.IsPerfect.{u, u + 1} (X := X.toRingedSpace) E') (k : ℕ) :
    χ.res (perfectRankChooseClass C sX perfect k) =
      ((Ring.choose (rootRank χ.roots) k : ℤ) : TotalChowClass C χ.T.sP) := by
  rw [SplitChart.res, res_perfectRankChooseClass_of_range C sX perfect k χ.map χ.map_comp _
    (χ.range_subset_eulerLocus perfect), zsmul_one]

end ChartRestriction

/-! ### Stacks 0FAG -/

section Tensor

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
  {E F : DerivedCategory X.Modules}

/-- Two classes agree if their restrictions to every tensor split chart do, where the restriction
of the ranks of `E` and `F` is known. -/
private theorem eq_of_forall_tensorSplitChart_res_eq_of_rank (hE : HasDefinedChernClasses E)
    (hF : HasDefinedChernClasses F) {a b : TotalChowClass C sX}
    (h : ∀ {H : EnvelopePresentation E} {H' : EnvelopePresentation F} {y : (H.tensorLeft H').Y}
      (χ : TensorSplitChart C sX H H' y),
      χ.left.res (perfectRankClass C sX hE) =
        ((rootRank χ.rootsLeft : ℤ) : TotalChowClass C χ.T.sP) →
      χ.left.res (perfectRankClass C sX hF) =
        ((rootRank χ.rootsRight : ℤ) : TotalChowClass C χ.T.sP) →
      χ.left.res a = χ.left.res b) :
    a = b := by
  obtain ⟨H⟩ : Nonempty (EnvelopePresentation E) := id hE
  obtain ⟨H'⟩ : Nonempty (EnvelopePresentation F) := id hF
  refine eq_of_forall_tensorSplitChart_res_eq (fun y ↦
    (nonempty_tensorSplitChart (C := C) (sX := sX) (H := H) (H' := H') y).some) fun y ↦ ?_
  set χ := (nonempty_tensorSplitChart (C := C) (sX := sX) (H := H) (H' := H') y).some
  exact h χ (χ.left.res_perfectRankClass hE) (χ.right.res_perfectRankClass hF)

/-- The Chern roots of `E ⊗^𝐋 F` are the sums of the Chern roots of `E` and `F`. For
presentations of `E` and `F` on envelopes there are tensor split charts at every point of their
common envelope, restriction to all of them is injective on `A^*(X)`, and on each of them, with
`x_{n,j}` the Chern roots of `E` and `y_{m,k}` those of `F`,

  `c(E) = ∏ (1 + x_{n,j})^{(-1)^n}`,  `c(F) = ∏ (1 + y_{m,k})^{(-1)^m}`,
  `c(E ⊗^𝐋 F) = ∏ (1 + x_{n,j} + y_{m,k})^{(-1)^n (-1)^m}`,

so every Chern class of `E ⊗^𝐋 F` is the universal expression in the Chern roots of `E` and `F`. -/
@[stacks 0FAG "and so on for higher Chern classes: the splitting-principle statement the proof \
reduces the lemma to.  On tensor split charts of any two envelope presentations of E and F -- the \
connected component of a point of the common envelope followed by one splitting morphism of 02UL \
for the terms of both presenting complexes -- restriction is injective on A^*(X), c(E) and c(F) \
are the products of (1 + x)^{(-1)^n} and (1 + y)^{(-1)^m} over their Chern roots, and \
c(E tensor^L F) is the product of (1 + x + y)^{(-1)^n (-1)^m} over all pairs of roots, as \
lists of signed roots via Stacks.Chow.TotalChowClass.rootProd and Stacks.Chow.rootTensor"]
theorem exists_tensorSplitCharts (hE : HasDefinedChernClasses E) (hF : HasDefinedChernClasses F)
    (H : EnvelopePresentation E) (H' : EnvelopePresentation F) :
    ∃ χ : ∀ y : (H.tensorLeft H').Y, TensorSplitChart C sX H H' y,
      Function.Injective
        (fun (c : TotalChowClass C sX) (y : (H.tensorLeft H').Y) ↦ (χ y).left.res c) ∧
      (∀ y, (χ y).left.res (perfectChernClass C sX hE) =
        ((TotalChowClass.rootProd (χ y).rootsLeft : (TotalChowClass C (χ y).T.sP)ˣ) :
          TotalChowClass C (χ y).T.sP)) ∧
      (∀ y, (χ y).left.res (perfectChernClass C sX hF) =
        ((TotalChowClass.rootProd (χ y).rootsRight : (TotalChowClass C (χ y).T.sP)ˣ) :
          TotalChowClass C (χ y).T.sP)) ∧
      ∀ y, (χ y).left.res (perfectChernClass C sX (hasDefinedChernClasses_derivedTensor hE hF)) =
        ((TotalChowClass.rootProd (rootTensor (χ y).rootsLeft (χ y).rootsRight) :
          (TotalChowClass C (χ y).T.sP)ˣ) : TotalChowClass C (χ y).T.sP) := by
  let χ : ∀ y : (H.tensorLeft H').Y, TensorSplitChart C sX H H' y := fun y ↦
    (nonempty_tensorSplitChart (C := C) (sX := sX) (H := H) (H' := H') y).some
  exact ⟨χ, fun a b hab ↦ eq_of_forall_tensorSplitChart_res_eq χ fun y ↦ congrFun hab y,
    fun y ↦ (χ y).res_perfectChernClass_left hE, fun y ↦ (χ y).res_perfectChernClass_right hF,
    fun y ↦ (χ y).res_perfectChernClass_derivedTensor hE hF⟩

/-- `c₁(E ⊗^𝐋 F) = r(E) c₁(F) + r(F) c₁(E)` in `A^*(X)`. -/
@[stacks 0FAG "the first displayed formula c_1(E tensor^L F) = r(E) c_1(F) + r(F) c_1(E), as \
classes homogeneous of degree one in the bivariant ring A^*(X) = Stacks.Chow.TotalChowClass, \
with r = Stacks.Chow.perfectRankClass and c_1 the degree-one homogeneous component of \
Stacks.Chow.perfectChernClass; the Chern classes of E tensor^L F are defined by \
Stacks.Chow.hasDefinedChernClasses_derivedTensor.  Perfectness of E and F is not used"]
theorem homComponent_one_perfectChernClass_derivedTensor (hE : HasDefinedChernClasses E)
    (hF : HasDefinedChernClasses F) :
    TotalChowClass.homComponent 1
        (perfectChernClass C sX (hasDefinedChernClasses_derivedTensor hE hF)) =
      perfectRankClass C sX hE * TotalChowClass.homComponent 1 (perfectChernClass C sX hF) +
        perfectRankClass C sX hF * TotalChowClass.homComponent 1 (perfectChernClass C sX hE) := by
  refine eq_of_forall_tensorSplitChart_res_eq_of_rank C sX hE hF fun χ hrE hrF ↦ ?_
  rw [map_add, map_mul, map_mul, SplitChart.res_homComponent, SplitChart.res_homComponent,
    SplitChart.res_homComponent, χ.res_perfectChernClass_derivedTensor hE hF,
    χ.res_perfectChernClass_left hE, χ.res_perfectChernClass_right hF, hrE, hrF,
    (TotalChowClass.homComponent_rootProd _ χ.isHomogeneous_rootTensor).2.1,
    (TotalChowClass.homComponent_rootProd _ χ.isHomogeneous_rootsLeft).2.1,
    (TotalChowClass.homComponent_rootProd _ χ.isHomogeneous_rootsRight).2.1,
    rootSum_rootTensor_of_commute χ.commute_roots, add_comm]

/-- `c₂(E ⊗^𝐋 F) = r(E) c₂(F) + r(F) c₂(E) + C(r(E), 2) c₁(F)² + (r(E) r(F) - 1) c₁(F) c₁(E)
  + C(r(F), 2) c₁(E)²` in `A^*(X)`. -/
@[stacks 0FAG "the second displayed formula c_2(E tensor^L F) = r(E) c_2(F) + r(F) c_2(E) + \
binom(r(E), 2) c_1(F)^2 + (r(E) r(F) - 1) c_1(F) c_1(E) + binom(r(F), 2) c_1(E)^2, as classes \
homogeneous of degree two in the bivariant ring A^*(X) = Stacks.Chow.TotalChowClass, the \
products being compositions of bivariant classes, in the order of the source.  r is \
Stacks.Chow.perfectRankClass and binom(r, 2) is Stacks.Chow.perfectRankChooseClass ... 2, the \
class which is binom(n, 2) on the open and closed locus where the rank of the perfect object is \
n; E and F perfect as in the source"]
theorem homComponent_two_perfectChernClass_derivedTensor
    (perfectE : RingedSpace.IsPerfect.{u, u + 1} (X := X.toRingedSpace) E)
    (perfectF : RingedSpace.IsPerfect.{u, u + 1} (X := X.toRingedSpace) F)
    (hE : HasDefinedChernClasses E) (hF : HasDefinedChernClasses F) :
    TotalChowClass.homComponent 2
        (perfectChernClass C sX (hasDefinedChernClasses_derivedTensor hE hF)) =
      perfectRankClass C sX hE * TotalChowClass.homComponent 2 (perfectChernClass C sX hF) +
        perfectRankClass C sX hF * TotalChowClass.homComponent 2 (perfectChernClass C sX hE) +
        perfectRankChooseClass C sX perfectE 2 *
          TotalChowClass.homComponent 1 (perfectChernClass C sX hF) ^ 2 +
        (perfectRankClass C sX hE * perfectRankClass C sX hF - 1) *
          (TotalChowClass.homComponent 1 (perfectChernClass C sX hF) *
            TotalChowClass.homComponent 1 (perfectChernClass C sX hE)) +
        perfectRankChooseClass C sX perfectF 2 *
          TotalChowClass.homComponent 1 (perfectChernClass C sX hE) ^ 2 := by
  refine eq_of_forall_tensorSplitChart_res_eq_of_rank C sX hE hF fun χ hrE hrF ↦ ?_
  have hcE : χ.left.res (perfectRankChooseClass C sX perfectE 2) =
      ((Ring.choose (rootRank χ.rootsLeft) 2 : ℤ) : TotalChowClass C χ.T.sP) :=
    χ.left.res_perfectRankChooseClass perfectE 2
  have hcF : χ.left.res (perfectRankChooseClass C sX perfectF 2) =
      ((Ring.choose (rootRank χ.rootsRight) 2 : ℤ) : TotalChowClass C χ.T.sP) :=
    χ.right.res_perfectRankChooseClass perfectF 2
  simp only [map_add, map_mul, map_sub, map_one, map_pow]
  rw [SplitChart.res_homComponent, SplitChart.res_homComponent, SplitChart.res_homComponent,
    SplitChart.res_homComponent, SplitChart.res_homComponent,
    χ.res_perfectChernClass_derivedTensor hE hF, χ.res_perfectChernClass_left hE,
    χ.res_perfectChernClass_right hF, hrE, hrF, hcE, hcF,
    (TotalChowClass.homComponent_rootProd _ χ.isHomogeneous_rootTensor).2.2,
    (TotalChowClass.homComponent_rootProd _ χ.isHomogeneous_rootsLeft).2.1,
    (TotalChowClass.homComponent_rootProd _ χ.isHomogeneous_rootsRight).2.1,
    (TotalChowClass.homComponent_rootProd _ χ.isHomogeneous_rootsLeft).2.2,
    (TotalChowClass.homComponent_rootProd _ χ.isHomogeneous_rootsRight).2.2,
    rootSumTwo_rootTensor_of_commute χ.commute_roots]

/-- The class `c₁(E ⊗^𝐋 F) ∈ A¹(X)` is the degree-one component of
`r(E) c₁(F) + r(F) c₁(E)`. -/
@[stacks 0FAG "the first displayed formula read in the single group A^1(X): c_1(E tensor^L F) \
in A^1(X), the degree-one component of Stacks.Chow.perfectChernClass, is the degree-one \
component of r(E) c_1(F) + r(F) c_1(E)"]
theorem perfectChernClass_derivedTensor_apply_one (hE : HasDefinedChernClasses E)
    (hF : HasDefinedChernClasses F) :
    perfectChernClass C sX (hasDefinedChernClasses_derivedTensor hE hF) 1 =
      (perfectRankClass C sX hE * TotalChowClass.homComponent 1 (perfectChernClass C sX hF) +
        perfectRankClass C sX hF * TotalChowClass.homComponent 1 (perfectChernClass C sX hE))
        1 := by
  rw [← homComponent_one_perfectChernClass_derivedTensor, TotalChowClass.homComponent_apply,
    if_pos rfl]

/-- The class `c₂(E ⊗^𝐋 F) ∈ A²(X)` is the degree-two component of
`r(E) c₂(F) + r(F) c₂(E) + C(r(E), 2) c₁(F)² + (r(E) r(F) - 1) c₁(F) c₁(E) + C(r(F), 2) c₁(E)²`.
-/
@[stacks 0FAG "the second displayed formula read in the single group A^2(X): c_2(E tensor^L F) \
in A^2(X), the degree-two component of Stacks.Chow.perfectChernClass, is the degree-two \
component of r(E) c_2(F) + r(F) c_2(E) + binom(r(E), 2) c_1(F)^2 + (r(E) r(F) - 1) c_1(F) \
c_1(E) + binom(r(F), 2) c_1(E)^2; E and F perfect as in the source"]
theorem perfectChernClass_derivedTensor_apply_two
    (perfectE : RingedSpace.IsPerfect.{u, u + 1} (X := X.toRingedSpace) E)
    (perfectF : RingedSpace.IsPerfect.{u, u + 1} (X := X.toRingedSpace) F)
    (hE : HasDefinedChernClasses E) (hF : HasDefinedChernClasses F) :
    perfectChernClass C sX (hasDefinedChernClasses_derivedTensor hE hF) 2 =
      (perfectRankClass C sX hE * TotalChowClass.homComponent 2 (perfectChernClass C sX hF) +
        perfectRankClass C sX hF * TotalChowClass.homComponent 2 (perfectChernClass C sX hE) +
        perfectRankChooseClass C sX perfectE 2 *
          TotalChowClass.homComponent 1 (perfectChernClass C sX hF) ^ 2 +
        (perfectRankClass C sX hE * perfectRankClass C sX hF - 1) *
          (TotalChowClass.homComponent 1 (perfectChernClass C sX hF) *
            TotalChowClass.homComponent 1 (perfectChernClass C sX hE)) +
        perfectRankChooseClass C sX perfectF 2 *
          TotalChowClass.homComponent 1 (perfectChernClass C sX hE) ^ 2 : TotalChowClass C sX)
        2 := by
  rw [← homComponent_two_perfectChernClass_derivedTensor C sX perfectE perfectF hE hF,
    TotalChowClass.homComponent_apply, if_pos rfl]

/-- `P_p(E ⊗^𝐋 F) ∈ A^p(X)` is the degree-`p` component of
`∑_{p₁ + p₂ = p} C(p, p₁) P_{p₁}(E) P_{p₂}(F)`. -/
@[stacks 0FAG "the more precise statement read in the single group A^p(X), which is where the \
source states it: P_p(E tensor^L F) in A^p(X) (Stacks.Chow.perfectPowerSumComponent) is the \
degree-p component of the sum over p_1 + p_2 = p of binom(p, p_1) P_{p_1}(E) P_{p_2}(F)"]
theorem perfectPowerSumComponent_derivedTensor (hE : HasDefinedChernClasses E)
    (hF : HasDefinedChernClasses F) (p : ℕ) :
    perfectPowerSumComponent C sX (hasDefinedChernClasses_derivedTensor hE hF) p =
      ∑ q ∈ antidiagonal p, ((p.choose q.1 : TotalChowClass C sX) *
        (perfectPowerSum C sX hE q.1 * perfectPowerSum C sX hF q.2)) p := by
  show perfectPowerSum C sX (hasDefinedChernClasses_derivedTensor hE hF) p p = _
  rw [perfectPowerSum_derivedTensor C sX hE hF _ p, TotalChowClass.sum_apply]
  simp only [zsmul_eq_mul, Int.cast_natCast]

end Tensor

/-! ### The Chern character -/

section ChernCharacter

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
  {E F : DerivedCategory X.Modules}

/-- **The Chern character `ch(E) = ∑_{p ≥ 0} P_p(E)/p!` of an object whose Chern classes are
defined**, as a formal power series over `A^*(X) ⊗ 𝐐` whose coefficient of degree `p` is
`P_p(E)/p!`. The power series ring is the product `∏_{p ≥ 0}` with the convolution product, which
is how the infinite sum is read; its coefficient of degree `p`, read in `A^p(X) ⊗ 𝐐`, is the
class `ch_p(E)` of Stacks 0F9E (2) (`Stacks.Chow.map_coeff_perfectTotalChernCharacter`). -/
def perfectTotalChernCharacter (hE : HasDefinedChernClasses E) :
    PowerSeries (rationalTotalChowClass C sX) :=
  PowerSeries.mk fun p ↦ ((Nat.factorial p : ℚ)⁻¹) ⊗ₜ[ℤ] perfectPowerSum C sX hE p

/-- The coefficient of degree `p` of the Chern character `ch(E)` is `P_p(E)/p!`. -/
@[simp]
theorem coeff_perfectTotalChernCharacter (hE : HasDefinedChernClasses E) (p : ℕ) :
    PowerSeries.coeff p (perfectTotalChernCharacter C sX hE) =
      ((Nat.factorial p : ℚ)⁻¹) ⊗ₜ[ℤ] perfectPowerSum C sX hE p :=
  PowerSeries.coeff_mk p _

/-- The component of degree `p` of a total class, as an additive map to `A^p(X)`. -/
def TotalChowClass.componentAddHom (p : ℕ) :
    TotalChowClass C sX →+ chowCohomologyComponent C (gysinSystemOfInvertible C) sX (p : ℤ) :=
  AddMonoidHom.mk' (fun c ↦ c p) fun c d ↦ TotalChowClass.add_apply c d p

/-- The coefficient of degree `p` of `ch(E)`, read in `A^p(X) ⊗ 𝐐`, is the class
`ch_p(E) = P_p(E)/p!` of Stacks 0F9E (2). -/
theorem map_coeff_perfectTotalChernCharacter (hE : HasDefinedChernClasses E) (p : ℕ) :
    TensorProduct.map (LinearMap.id : ℚ →ₗ[ℤ] ℚ)
        (TotalChowClass.componentAddHom C sX p).toIntLinearMap
        (PowerSeries.coeff p (perfectTotalChernCharacter C sX hE)) =
      perfectChernCharacterComponent C sX hE p := by
  rw [coeff_perfectTotalChernCharacter, TensorProduct.map_tmul]
  rfl

/-- **The Chern character of a class whose power sums are the binomial convolutions of those of
`E` and `F`** is the product of the Chern characters of `E` and `F`. -/
theorem perfectTotalChernCharacter_eq_mul_of_perfectPowerSum {E' : DerivedCategory X.Modules}
    (hE' : HasDefinedChernClasses E') (hE : HasDefinedChernClasses E)
    (hF : HasDefinedChernClasses F)
    (h : ∀ p, perfectPowerSum C sX hE' p = ∑ q ∈ antidiagonal p,
      (p.choose q.1 : TotalChowClass C sX) *
        (perfectPowerSum C sX hE q.1 * perfectPowerSum C sX hF q.2)) :
    perfectTotalChernCharacter C sX hE' =
      perfectTotalChernCharacter C sX hE * perfectTotalChernCharacter C sX hF := by
  refine PowerSeries.ext fun p ↦ ?_
  rw [PowerSeries.coeff_mul, coeff_perfectTotalChernCharacter]
  simp only [coeff_perfectTotalChernCharacter]
  have hns : ∀ (k : ℕ) (a : ℚ) (x : TotalChowClass C sX),
      a ⊗ₜ[ℤ] (k • x) = k • (a ⊗ₜ[ℤ] x) := fun k a x =>
    map_nsmul (TensorProduct.mk ℤ ℚ (TotalChowClass C sX) a) k x
  have hns' : ∀ (k : ℕ) (a : ℚ) (x : TotalChowClass C sX),
      (k • a) ⊗ₜ[ℤ] x = k • (a ⊗ₜ[ℤ] x) := fun k a x =>
    map_nsmul ((TensorProduct.mk ℤ ℚ (TotalChowClass C sX)).flip x) k a
  rw [h p, TensorProduct.tmul_sum]
  refine Finset.sum_congr rfl fun q hq => ?_
  have hq' : q.1 + q.2 = p := Finset.HasAntidiagonal.mem_antidiagonal.mp hq
  rw [Algebra.TensorProduct.tmul_mul_tmul, ← nsmul_eq_mul, hns, ← hns', nsmul_eq_mul]
  have hfac : p.choose q.1 * Nat.factorial q.2 * Nat.factorial q.1 = Nat.factorial p := by
    have h := Nat.add_choose_mul_factorial_mul_factorial q.2 q.1
    rwa [Nat.add_comm q.2 q.1, hq'] at h
  have h1 : (Nat.factorial q.1 : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  have h2 : (Nat.factorial q.2 : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  have h3 : (Nat.factorial p : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  have hfacQ : (p.choose q.1 : ℚ) * (Nat.factorial q.2 : ℚ) * (Nat.factorial q.1 : ℚ)
      = (Nat.factorial p : ℚ) := by exact_mod_cast congrArg (fun n : ℕ => (n : ℚ)) hfac
  congr 1
  field_simp
  linear_combination hfacQ

/-- The Chern character is multiplicative: `ch(E ⊗^𝐋 F) = ch(E) ch(F)` in `A^*(X) ⊗ 𝐐`. -/
@[stacks 0FAG "similarly, ch(E tensor^L F) = ch(E) ch(F) in A^*(X) tensor Q: \
Stacks.Chow.rationalTotalChowClass is the bivariant ring A^*(X) tensored over Z with Q, and ch \
is the power series over it whose coefficient of degree p is P_p/p!, which read in A^p(X) \
tensor Q is ch_p of Tag 0F9E (Stacks.Chow.map_coeff_perfectTotalChernCharacter); the identity \
is the more precise one for P_p divided by p!.  Perfectness of E and F is not used"]
theorem perfectTotalChernCharacter_derivedTensor (hE : HasDefinedChernClasses E)
    (hF : HasDefinedChernClasses F) :
    perfectTotalChernCharacter C sX (hasDefinedChernClasses_derivedTensor hE hF) =
      perfectTotalChernCharacter C sX hE * perfectTotalChernCharacter C sX hF :=
  perfectTotalChernCharacter_eq_mul_of_perfectPowerSum C sX _ hE hF fun p ↦ by
    rw [perfectPowerSum_derivedTensor C sX hE hF _ p]
    simp only [zsmul_eq_mul, Int.cast_natCast]

end ChernCharacter

/-! ### The whole statement -/

section Whole

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
  {E F : DerivedCategory X.Modules}

/-- In Situation 02QL let `X` be locally of finite type over `S` and let `E`,
`F` be perfect objects of `D(𝒪_X)` whose Chern classes are defined. Then the Chern classes of
`E ⊗^𝐋 F` are defined, and in `A^*(X)`

* `c₁(E ⊗^𝐋 F) = r(E) c₁(F) + r(F) c₁(E)`;
* `c₂(E ⊗^𝐋 F) = r(E) c₂(F) + r(F) c₂(E) + C(r(E), 2) c₁(F)² + (r(E) r(F) - 1) c₁(F) c₁(E)
  + C(r(F), 2) c₁(E)²`;
* "and so on for higher Chern classes": on tensor split charts of any presentations, on which
  restriction is injective, the Chern roots of `E ⊗^𝐋 F` are the sums `x + y` of those of `E` and
  `F`, with the product signs;
* `ch(E ⊗^𝐋 F) = ch(E) ch(F)` in `A^*(X) ⊗ 𝐐`;
* more precisely `P_p(E ⊗^𝐋 F) = ∑_{p₁ + p₂ = p} C(p, p₁) P_{p₁}(E) P_{p₂}(F)` in `A^p(X)`. -/
@[stacks 0FAG "the whole statement, as one conjunction of the parts registered separately in \
this module: the Chern classes of E tensor^L F are defined; the formulas for c_1 and c_2 in \
A^*(X); the splitting-principle form of 'and so on for higher Chern classes' (Chern roots x + y \
with product signs on injective tensor split charts of any presentations); ch(E tensor^L F) = \
ch(E) ch(F) in A^*(X) tensor Q; and P_p(E tensor^L F) = sum of binom(p, p_1) P_{p_1}(E) \
P_{p_2}(F) in A^p(X) for every p, under exactly the source's hypotheses"]
theorem perfectChernClasses_derivedTensor
    (perfectE : RingedSpace.IsPerfect.{u, u + 1} (X := X.toRingedSpace) E)
    (perfectF : RingedSpace.IsPerfect.{u, u + 1} (X := X.toRingedSpace) F)
    (hE : HasDefinedChernClasses E) (hF : HasDefinedChernClasses F) :
    HasDefinedChernClasses (((derivedTensorProductFunctor X.sheaf).obj E).obj F) ∧
    TotalChowClass.homComponent 1
        (perfectChernClass C sX (hasDefinedChernClasses_derivedTensor hE hF)) =
      perfectRankClass C sX hE * TotalChowClass.homComponent 1 (perfectChernClass C sX hF) +
        perfectRankClass C sX hF * TotalChowClass.homComponent 1 (perfectChernClass C sX hE) ∧
    TotalChowClass.homComponent 2
        (perfectChernClass C sX (hasDefinedChernClasses_derivedTensor hE hF)) =
      perfectRankClass C sX hE * TotalChowClass.homComponent 2 (perfectChernClass C sX hF) +
        perfectRankClass C sX hF * TotalChowClass.homComponent 2 (perfectChernClass C sX hE) +
        perfectRankChooseClass C sX perfectE 2 *
          TotalChowClass.homComponent 1 (perfectChernClass C sX hF) ^ 2 +
        (perfectRankClass C sX hE * perfectRankClass C sX hF - 1) *
          (TotalChowClass.homComponent 1 (perfectChernClass C sX hF) *
            TotalChowClass.homComponent 1 (perfectChernClass C sX hE)) +
        perfectRankChooseClass C sX perfectF 2 *
          TotalChowClass.homComponent 1 (perfectChernClass C sX hE) ^ 2 ∧
    (∀ (H : EnvelopePresentation E) (H' : EnvelopePresentation F),
      ∃ χ : ∀ y : (H.tensorLeft H').Y, TensorSplitChart C sX H H' y,
        Function.Injective (fun (c : TotalChowClass C sX) (y : (H.tensorLeft H').Y) ↦
          (χ y).left.res c) ∧
        (∀ y, (χ y).left.res (perfectChernClass C sX hE) =
          ((TotalChowClass.rootProd (χ y).rootsLeft : (TotalChowClass C (χ y).T.sP)ˣ) :
            TotalChowClass C (χ y).T.sP)) ∧
        (∀ y, (χ y).left.res (perfectChernClass C sX hF) =
          ((TotalChowClass.rootProd (χ y).rootsRight : (TotalChowClass C (χ y).T.sP)ˣ) :
            TotalChowClass C (χ y).T.sP)) ∧
        ∀ y, (χ y).left.res (perfectChernClass C sX (hasDefinedChernClasses_derivedTensor hE hF)) =
          ((TotalChowClass.rootProd (rootTensor (χ y).rootsLeft (χ y).rootsRight) :
            (TotalChowClass C (χ y).T.sP)ˣ) : TotalChowClass C (χ y).T.sP)) ∧
    perfectTotalChernCharacter C sX (hasDefinedChernClasses_derivedTensor hE hF) =
      perfectTotalChernCharacter C sX hE * perfectTotalChernCharacter C sX hF ∧
    ∀ p : ℕ, perfectPowerSumComponent C sX (hasDefinedChernClasses_derivedTensor hE hF) p =
      ∑ q ∈ antidiagonal p, ((p.choose q.1 : TotalChowClass C sX) *
        (perfectPowerSum C sX hE q.1 * perfectPowerSum C sX hF q.2)) p :=
  ⟨hasDefinedChernClasses_derivedTensor hE hF,
    homComponent_one_perfectChernClass_derivedTensor C sX hE hF,
    homComponent_two_perfectChernClass_derivedTensor C sX perfectE perfectF hE hF,
    exists_tensorSplitCharts C sX hE hF,
    perfectTotalChernCharacter_derivedTensor C sX hE hF,
    perfectPowerSumComponent_derivedTensor C sX hE hF⟩

end Whole

end Stacks.Chow

