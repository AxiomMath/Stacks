module

public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.ChernRootJets
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.DerivedTensor
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.EnvelopeChern
public import StacksFrontier.AlgebraicGeometry.Chow.ChowGroupsEnvelopes.Stability
public import StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.ChernRootsTotal
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassArbitraryRank.InvertibleChernScaling

/-!
# The Chern roots of the derived tensor product of two perfect objects

Let `(S, δ)` be the base situation of chapter 42 of the Stacks Project, let `X` be locally of
finite type over `S` and let `E`, `F` be objects of `D(𝒪_X)` whose Chern classes are defined.
The proof of [Stacks, Tag 0FAG] says to "use the splitting principle as in Remark 0FAD and reduce
the lemma to computations in polynomial rings". This file performs that reduction.

On the common envelope `Y` of presentations `𝓔^•` of `E` and `𝓕^•` of `F`
(`Stacks.Chow.EnvelopePresentation.tensor`), a **tensor
split chart** at a point `y ∈ Y` is the connected component `V` of `y`, where both complexes are
bounded with constant ranks, followed by a single splitting morphism `π : P ⟶ V` of Stacks 02UL
along which every term of both complexes acquires a filtration with invertible successive
quotients. With `x_{n,j}` the Chern roots of `𝓔^n` and `y_{m,k}` those of `𝓕^m`:

  `c(E)|_P = ∏ (1 + x_{n,j})^{(-1)^n}`,  `c(F)|_P = ∏ (1 + y_{m,k})^{(-1)^m}`,

  `c(E ⊗^L F)|_P = ∏ (1 + x_{n,j} + y_{m,k})^{(-1)^{n+m}}`,

and restriction to all the charts is injective. So `E ⊗^L F` has the Chern roots `x + y` with the
product signs, which is the general statement behind "and so on for higher Chern classes" of
Stacks 0FAG.

## Main definitions

* `Stacks.Chow.chernUnitGroup` — the commutative group generated by the total Chern classes of
  finite locally free modules of constant rank.
* `Stacks.Chow.TensorSplitChart` — a tensor split chart, with its signed Chern roots
  `Stacks.Chow.TensorSplitChart.rootsLeft` and `Stacks.Chow.TensorSplitChart.rootsRight`.

## Main results

* `Stacks.Chow.totalChernElem_biproduct` — the Whitney formula for finite biproducts.
* `Stacks.Chow.totalChern_tensorObj_eq_prod_prod` — the Chern roots of a tensor product of
  filtered modules, on total classes.
* `Stacks.Chow.nonempty_tensorSplitChart`, `Stacks.Chow.eq_of_forall_tensorSplitChart_res_eq` —
  tensor split charts exist and detect classes.
* `Stacks.Chow.TensorSplitChart.res_perfectChernClass_derivedTensor` — the Chern roots of
  `E ⊗^𝐋 F` on a chart.
* `Stacks.Chow.TensorSplitChart.res_perfectRankClass_derivedTensor`,
  `Stacks.Chow.TensorSplitChart.res_perfectPowerSum_derivedTensor` — its rank and power sums.

## References

* [Stacks Project, Tag 0FAG](https://stacks.math.columbia.edu/tag/0FAG)
* [Stacks Project, Tag 0FAD](https://stacks.math.columbia.edu/tag/0FAD)
* [Stacks Project, Tag 02UL](https://stacks.math.columbia.edu/tag/02UL)
* [Stacks Project, Tag 02UJ](https://stacks.math.columbia.edu/tag/02UJ)
* [Stacks Project, Tag 02UI](https://stacks.math.columbia.edu/tag/02UI)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Finset

universe u

namespace Stacks.Chow

attribute [local instance 10000] HasDerivedCategory.standard

/-! ### The group generated by total Chern classes -/

section ChernUnitGroup

variable (C : ChowSituation.{u}) {Y : Scheme.{u}} (sY : Y ⟶ C.S) [LocallyOfFiniteType sY]

/-- The total Chern classes of finite locally free modules of constant rank, as units. -/
def totalChernUnitSet : Set (TotalChowClass C sY)ˣ :=
  {v | ∃ (M : Y.Modules) (r : ℕ)
    (_ : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r),
    v = totalChernUnit C sY M r}

/-- Any two elements of `Stacks.Chow.totalChernUnitSet` commute. -/
theorem totalChernUnitSet_comm :
    ∀ a ∈ totalChernUnitSet C sY, ∀ b ∈ totalChernUnitSet C sY, a * b = b * a := by
  rintro a ⟨M, r, hM, rfl⟩ b ⟨N, s, hN, rfl⟩
  exact Units.ext (commute_totalChern C sY M N r s).eq

/-- **The group generated by the total Chern classes** of finite locally free modules of constant
rank. It is commutative, by Stacks 02UA. -/
def chernUnitGroup : Subgroup (TotalChowClass C sY)ˣ := Subgroup.closure (totalChernUnitSet C sY)

/-- The group generated by the total Chern classes is commutative. -/
instance : CommGroup (chernUnitGroup C sY) :=
  { (inferInstance : Group (chernUnitGroup C sY)) with
    mul_comm := (Subgroup.isMulCommutative_closure
      fun a ha b hb _ => totalChernUnitSet_comm C sY a ha b hb).is_comm.comm }

/-- The inclusion of the group of Chern classes into the units of the ring of total classes. -/
def chernUnitGroupCoe : chernUnitGroup C sY →* (TotalChowClass C sY)ˣ where
  toFun := Subtype.val
  map_one' := rfl
  map_mul' _ _ := rfl

/-- `Stacks.Chow.chernUnitGroupCoe` sends an element to its underlying unit. -/
@[simp]
theorem chernUnitGroupCoe_apply (g : chernUnitGroup C sY) :
    chernUnitGroupCoe C sY g = (g : (TotalChowClass C sY)ˣ) :=
  rfl

/-- The total Chern class of a finite locally free module of constant rank, as an element of the
commutative group `Stacks.Chow.chernUnitGroup`. -/
def totalChernElem (M : Y.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r] :
    chernUnitGroup C sY :=
  ⟨totalChernUnit C sY M r, Subgroup.subset_closure ⟨M, r, inferInstance, rfl⟩⟩

/-- The underlying total class of `Stacks.Chow.totalChernElem` is the total Chern class. -/
@[simp]
theorem val_val_totalChernElem (M : Y.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r] :
    ((totalChernElem C sY M r : (TotalChowClass C sY)ˣ) : TotalChowClass C sY) =
      totalChern C sY M r :=
  rfl

/-- A factor `c(P^n)^{(-1)^n}` of the total Chern class of a complex is the image of the
corresponding power in the group of Chern classes. -/
private theorem complexChernFactor_eq_coe_zpow_totalChernElem (P : CochainComplex Y.Modules ℤ)
    (ρ : ℤ → ℕ)
    (hP : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (P.X n) (ρ n))
    (n : ℤ) :
    complexChernFactor C sY P ρ hP n =
      (((haveI := hP n; totalChernElem C sY (P.X n) (ρ n)) ^ ((n.negOnePow : ℤˣ) : ℤ) :
        chernUnitGroup C sY) : (TotalChowClass C sY)ˣ) := by
  have := hP n
  rw [complexChernFactor]
  exact (map_zpow (chernUnitGroupCoe C sY) (totalChernElem C sY _ _) _).symm

/-- Isomorphic finite locally free modules of equal rank have the same total Chern class in the
group of Chern classes. -/
theorem totalChernElem_congr {M M' : Y.Modules} {r r' : ℕ}
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M' r'] (e : M ≅ M')
    (h : r = r') : totalChernElem C sY M r = totalChernElem C sY M' r' :=
  Subtype.ext (Units.ext (totalChern_congr C sY e h))

/-- **The Whitney formula for a finite biproduct**: `c(⨁_i M_i) = ∏_i c(M_i)`. -/
theorem totalChernElem_biproduct {ι : Type} [Fintype ι] (M : ι → Y.Modules) (r : ι → ℕ)
    (hM : ∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (M i) (r i)) :
    haveI := isFiniteLocallyFreeOfRank_biproduct _ rfl M r hM
    totalChernElem C sY (⨁ M : Y.Modules) (∑ i, r i) =
      ∏ i, (haveI := hM i; totalChernElem C sY (M i) (r i)) := by
  classical
  suffices key : ∀ (n : ℕ) {ι : Type} [Fintype ι] (M : ι → Y.Modules) (r : ι → ℕ)
      (hM : ∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (M i) (r i)),
      Fintype.card ι = n →
      have := isFiniteLocallyFreeOfRank_biproduct _ rfl M r hM
      totalChernElem C sY (⨁ M : Y.Modules) (∑ i, r i) =
        ∏ i, (have := hM i; totalChernElem C sY (M i) (r i)) from key _ M r hM rfl
  intro n
  induction n with
  | zero =>
    intro ι _ M r hM h
    have : IsEmpty ι := Fintype.card_eq_zero_iff.1 h
    have := isFiniteLocallyFreeOfRank_biproduct _ rfl M r hM
    rw [Fintype.prod_empty]
    exact Subtype.ext (Units.ext (totalChern_of_isZero C sY (isZero_biproduct_of_isEmpty M)))
  | succ n ih =>
    intro ι _ M r hM h
    obtain ⟨i⟩ : Nonempty ι := Fintype.card_pos_iff.1 (by omega)
    have := hM i
    have h₃ := isFiniteLocallyFreeOfRank_biproduct _ rfl (fun j : {j // j ≠ i} ↦ M j)
      (fun j ↦ r j) fun j ↦ hM j
    have h₃' : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        (cokernel (biproduct.ι M i)) (∑ j : {j // j ≠ i}, r j) :=
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u}
        (cokernelBiproductιIso M i).symm h₃
    have := isFiniteLocallyFreeOfRank_biproduct _ rfl M r hM
    have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        (⨁ M : Y.Modules) (r i + ∑ j : {j // j ≠ i}, r j) :=
      GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact _ (shortExact_biproduct_ι M i) _ _
        (hM i) h₃'
    have hW := @totalChern_shortExact C _ sY _ _ (shortExact_biproduct_ι M i) (r i)
      (∑ j : {j // j ≠ i}, r j) (hM i) h₃'
    rw [Fintype.prod_eq_mul_prod_subtype_ne _ i,
      ← ih (fun j : {j // j ≠ i} ↦ M j) (fun j ↦ r j) (fun j ↦ hM j)
        (by have := card_subtype_ne i; omega)]
    refine Subtype.ext (Units.ext ?_)
    show totalChern C sY _ _ = totalChern C sY _ _ * totalChern C sY _ _
    exact (totalChern_congr C sY (Iso.refl _) (Fintype.sum_eq_add_sum_subtype_ne r i)).trans
      (hW.trans (congrArg (_ * ·)
        (@totalChern_congr C _ sY _ _ _ _ _ h₃' h₃ (cokernelBiproductιIso M i) rfl)))

end ChernUnitGroup

/-! ### The Chern roots of a tensor product, on total classes -/

section TensorRoots

variable (C : ChowSituation.{u}) {Y : Scheme.{u}} (sY : Y ⟶ C.S) [LocallyOfFiniteType sY]

attribute [local instance] isFiniteLocallyFreeOfRank_tensorObj_rankOneLeft
  isFiniteLocallyFreeOfRank_tensorObj_mul isFiniteLocallyFreeOfRank_tensorObj_rankOne

/-- **The Chern roots of an invertible twist, on total classes.** If `ℰ` is filtered with
invertible successive quotients `𝒩_j` and `ℒ` is invertible, then
`c(ℰ ⊗ ℒ) = ∏_j (1 + c₁(𝒩_j) + c₁(ℒ))`. -/
theorem totalChern_tensorObj_invertible_eq_prod (L : Y.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property L]
    (s : ℕ) (E : Y.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E s]
    (N : Fin s → Y.Modules)
    [∀ j, AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property
      (N j)] (h : HasQuotients Y s E N) :
    haveI := isFiniteLocallyFreeOfRank_one_of_isInvertible L
    totalChern C sY (Scheme.Modules.tensorObj E L) s =
      (List.ofFn fun j ↦ 1 + (TotalChowClass.firstChernTotal C sY (N j) +
        TotalChowClass.firstChernTotal C sY L)).prod := by
  have := isFiniteLocallyFreeOfRank_one_of_isInvertible L
  have : ∀ j, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (N j) 1 :=
    fun j ↦ isFiniteLocallyFreeOfRank_one_of_isInvertible (N j)
  rw [totalChern_eq_prod_of_hasQuotients C sY s (Scheme.Modules.tensorObj E L)
    (fun j ↦ Scheme.Modules.tensorObj (N j) L)
    (hasQuotients_tensorObj_invertible L inferInstance s E N h)]
  congr 1
  refine List.ofFn_inj.mpr (funext fun j ↦ ?_)
  rw [totalChern_eq_one_add_firstChernTotal, TotalChowClass.firstChernTotal_tensorObj]

/-- **The outer stage of the lexicographic filtration, on total classes**: if `ℰ` is filtered with
invertible successive quotients `ℒ_i` and `ℱ` is finite locally free of rank `s`, then
`c(ℰ ⊗ ℱ) = ∏_i c(ℒ_i ⊗ ℱ)`. -/
theorem totalChern_tensorObj_eq_prod :
    ∀ (r : ℕ) (E : Y.Modules)
      [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
      (L : Fin r → Y.Modules)
      [∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (L i) 1],
      HasQuotients Y r E L →
      ∀ (s t : ℕ) (F : Y.Modules)
        [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s]
        [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
          (Scheme.Modules.tensorObj E F) t],
        t = r * s →
        totalChern C sY (Scheme.Modules.tensorObj E F) t =
          (List.ofFn fun i ↦ totalChern C sY (Scheme.Modules.tensorObj (L i) F) s).prod := by
  intro r
  induction r with
  | zero =>
      intro E _ L _ _ s t F _ _ ht
      have ht' : t = 0 := by simpa using ht
      subst ht'
      rw [totalChern_of_rank_zero]
      simp
  | succ r ih =>
      intro E _ L _ h s t F _ _ ht
      have ht' : t = r * s + s := by rw [ht]; ring
      subst ht'
      obtain ⟨Fst, hFst, f, g, w, hS, hrec⟩ := h
      have := hFst
      obtain ⟨f', g', w', hS'⟩ := exists_shortExact_tensorModules_of_isFiniteLocallyFree F
        (AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree F s)
        f g w hS
      have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
          (CategoryTheory.ShortComplex.mk f' g' w').X₁ (r * s) :=
        isFiniteLocallyFreeOfRank_tensorObj_mul Fst F r s
      have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
          (CategoryTheory.ShortComplex.mk f' g' w').X₃ s :=
        isFiniteLocallyFreeOfRank_tensorObj_rankOneLeft (L 0) F s
      have hw : totalChern C sY (Scheme.Modules.tensorObj E F) (r * s + s) =
          totalChern C sY (Scheme.Modules.tensorObj Fst F) (r * s) *
            totalChern C sY (Scheme.Modules.tensorObj (L 0) F) s :=
        totalChern_shortExact C sY (CategoryTheory.ShortComplex.mk f' g' w') hS' (r * s) s
      rw [hw, (commute_totalChern C sY (Scheme.Modules.tensorObj Fst F)
          (Scheme.Modules.tensorObj (L 0) F) (r * s) s).eq,
        ih Fst (fun i ↦ L i.succ) hrec s (r * s) F rfl, List.ofFn_succ, List.prod_cons]

/-- **The Chern roots of a tensor product are the sums of the Chern roots, on total classes.** If
`ℰ₁` is filtered with invertible successive quotients `ℒ_i` and `ℰ₂` with invertible successive
quotients `𝒩_j`, then `c(ℰ₁ ⊗ ℰ₂) = ∏_i ∏_j (1 + c₁(𝒩_j) + c₁(ℒ_i))`. -/
theorem totalChern_tensorObj_eq_prod_prod (r s t : ℕ) (E₁ E₂ : Y.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₂ s]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (Scheme.Modules.tensorObj E₁ E₂) t]
    (L : Fin r → Y.Modules)
    [∀ i, AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property
      (L i)]
    (N : Fin s → Y.Modules)
    [∀ j, AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property
      (N j)]
    (h₁ : HasQuotients Y r E₁ L) (h₂ : HasQuotients Y s E₂ N) (ht : t = r * s) :
    totalChern C sY (Scheme.Modules.tensorObj E₁ E₂) t =
      (List.ofFn fun i ↦ (List.ofFn fun j ↦ 1 + (TotalChowClass.firstChernTotal C sY (N j) +
        TotalChowClass.firstChernTotal C sY (L i))).prod).prod := by
  have : ∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (L i) 1 :=
    fun i ↦ isFiniteLocallyFreeOfRank_one_of_isInvertible (L i)
  rw [totalChern_tensorObj_eq_prod C sY r E₁ L h₁ s t E₂ ht]
  congr 1
  refine List.ofFn_inj.mpr (funext fun i ↦ ?_)
  rw [totalChern_congr C sY (tensorObjSwap (L i) E₂) rfl]
  exact totalChern_tensorObj_invertible_eq_prod C sY (L i) s E₂ N h₂

end TensorRoots

/-! ### Tensor split charts -/

section Chart

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
  {E F : DerivedCategory X.Modules} (H : EnvelopePresentation E) (H' : EnvelopePresentation F)

/-- **A tensor split chart** of two envelope presentations `(f₁, 𝓔^•)` of `E` and `(f₂, 𝓕^•)`
of `F`, at a point `y` of the source `Y` of their common envelope: on the connected component `V`
of `y`, where the pullbacks of `𝓔^•` and `𝓕^•` are bounded complexes of fixed ranks, a single
splitting morphism `π : P ⟶ V` of Stacks 02UL along which every term of both complexes acquires
a filtration with invertible successive quotients, and along which restriction of total classes
is injective. -/
structure TensorSplitChart (y : (H.tensorLeft H').Y) where
  /-- The relative dimension of the splitting morphism. -/
  d : ℕ
  /-- The splitting morphism `π : P ⟶ V` over the connected component `V` of `y`. -/
  T : SplittingMorphism C (((H.tensorLeft H').componentOpens sX y).ι ≫
    (H.tensorLeft H').f ≫ sX) d
  /-- The successive quotients of the filtrations of the terms of `𝓔^•`. -/
  L : ∀ n : ℤ, Fin (complexRank (H.tensorLeft H').locallyBounded y n) → T.P.Modules
  /-- They are invertible. -/
  isInvertible : ∀ n j, AlgebraicGeometry.SheafOfModules.IsInvertible T.P.sheaf.obj
    T.P.ringCatSheaf.property (L n j)
  /-- The filtrations of the terms of `𝓔^•`. -/
  hasQuotients : ∀ n, HasQuotients T.P (complexRank (H.tensorLeft H').locallyBounded y n)
    ((Scheme.Modules.pullback T.π).obj
      ((pullbackComplex ((H.tensorLeft H').componentOpens sX y).ι (H.tensorLeft H').P).X n))
    (L n)
  /-- The successive quotients of the filtrations of the terms of `𝓕^•`. -/
  N : ∀ m : ℤ, Fin (complexRank (H.tensorRight H').locallyBounded y m) → T.P.Modules
  /-- They are invertible. -/
  isInvertible' : ∀ m k, AlgebraicGeometry.SheafOfModules.IsInvertible T.P.sheaf.obj
    T.P.ringCatSheaf.property (N m k)
  /-- The filtrations of the terms of `𝓕^•`. -/
  hasQuotients' : ∀ m, HasQuotients T.P (complexRank (H.tensorRight H').locallyBounded y m)
    ((Scheme.Modules.pullback T.π).obj
      ((pullbackComplex ((H.tensorRight H').componentOpens sX y).ι (H.tensorRight H').P).X m))
    (N m)
  /-- Restriction of total classes along `π` is injective. -/
  injective : Function.Injective (TotalChowClass.res (C := C) T.π T.hsP)

variable {C sX H H'}

namespace TensorSplitChart

variable {y : (H.tensorLeft H').Y} (χ : TensorSplitChart C sX H H' y)

/-- The split chart of the presentation of `E` underlying a tensor split chart. -/
abbrev left : SplitChart C sX (H.tensorLeft H') y :=
  ⟨χ.d, χ.T, χ.L, χ.isInvertible, χ.hasQuotients, χ.injective⟩

/-- The split chart of the presentation of `F` underlying a tensor split chart. -/
abbrev right : SplitChart C sX (H.tensorRight H') y :=
  ⟨χ.d, χ.T, χ.N, χ.isInvertible', χ.hasQuotients', χ.injective⟩

/-- The split chart of `E` has the splitting datum of the tensor split chart. -/
theorem left_T : χ.left.T = χ.T := rfl

/-- The split chart of `F` has the splitting datum of the tensor split chart. -/
theorem right_T : χ.right.T = χ.T := rfl

/-- The split charts of `E` and of `F` have the same morphism to `X`. -/
theorem left_map : χ.left.map = χ.right.map := rfl

/-- Restriction to the split chart of `E` agrees with restriction to the split chart of `F`. -/
theorem left_res : χ.left.res = χ.right.res := rfl

end TensorSplitChart

/-- **Tensor split charts exist at every point** of the source of the common envelope: Stacks
02UL applied to the terms of nonzero rank of both complexes at once, on the connected component
of the point. -/
theorem nonempty_tensorSplitChart (y : (H.tensorLeft H').Y) :
    Nonempty (TensorSplitChart C sX H H' y) := by
  set V := (H.tensorLeft H').componentOpens sX y
  set ρ := complexRank (H.tensorLeft H').locallyBounded y
  set σ := complexRank (H.tensorRight H').locallyBounded y
  have hρ := (H.tensorLeft H').isFiniteLocallyFreeOfRank_componentOpens sX y
  have hσ := (H.tensorRight H').isFiniteLocallyFreeOfRank_componentOpens sX y
  let M : {n // n ∈ ρ.support} ⊕ {m // m ∈ σ.support} → V.toScheme.Modules := fun i ↦
    Sum.elim (fun n ↦ (pullbackComplex V.ι (H.tensorLeft H').P).X n.1)
      (fun m ↦ (pullbackComplex V.ι (H.tensorRight H').P).X m.1) i
  let r : {n // n ∈ ρ.support} ⊕ {m // m ∈ σ.support} → ℕ := Sum.elim (fun n ↦ ρ n.1)
    (fun m ↦ σ m.1)
  have hM : ∀ i, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (M i)
      (r i) := by
    rintro (n | m)
    · exact hρ n.1
    · exact hσ m.1
  obtain ⟨T, -, -, -, -, hfilt, hinj⟩ := exists_splittingMorphism_isProjective C
    (V.ι ≫ (H.tensorLeft H').f ≫ sX) _ M r hM
  have hq : ∀ (n : ℤ) (P : CochainComplex V.toScheme.Modules ℤ) (τ : ℤ →₀ ℕ)
      (hτ : ∀ n, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (P.X n)
        (τ n))
      (hfil : ∀ n ∈ τ.support, Stacks.WeilCohomology.HasInvertibleFiltration T.P
        ((Scheme.Modules.pullback T.π).obj (P.X n)) (τ n)),
      ∃ L : Fin (τ n) → T.P.Modules,
        (∀ j, AlgebraicGeometry.SheafOfModules.IsInvertible T.P.sheaf.obj
          T.P.ringCatSheaf.property (L j)) ∧
        HasQuotients T.P (τ n) ((Scheme.Modules.pullback T.π).obj (P.X n)) L := by
    intro n P τ hτ hfil
    by_cases hn : n ∈ τ.support
    · exact exists_hasQuotients_of_hasInvertibleFiltration (hfil n hn)
    · have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
          ((Scheme.Modules.pullback T.π).obj (P.X n)) (τ n) :=
        let := hτ n
        AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback T.π _ (τ n)
      exact exists_hasQuotients_of_rank_eq_zero _ (τ n) (Finsupp.notMem_support_iff.mp hn)
  choose L hL hLq using fun n ↦ hq n (pullbackComplex V.ι (H.tensorLeft H').P) ρ hρ
    (fun n hn ↦ hfilt (Sum.inl ⟨n, hn⟩))
  choose N hN hNq using fun m ↦ hq m (pullbackComplex V.ι (H.tensorRight H').P) σ hσ
    (fun m hm ↦ hfilt (Sum.inr ⟨m, hm⟩))
  refine ⟨⟨_, T, L, hL, hLq, N, hN, hNq, TotalChowClass.res_injective_of_forall_injective T.π
    T.hsP fun p a b hab ↦ ?_⟩⟩
  have h := hinj (gysinSystemOfInvertible C) (gysinSystemOfInvertible_isNaturalUnderBaseChangeIso C)
    (a₁ := DirectSum.of _ (p : ℤ) a) (a₂ := DirectSum.of _ (p : ℤ) b)
  simp only [chowCohomologyTotalRestriction, DirectSum.map_of, hab] at h
  exact DirectSum.of_injective (p : ℤ) (h trivial)

/-- **Classes on `X` are detected on tensor split charts**: two total classes whose restrictions
to a tensor split chart at every point of the common envelope agree are equal. -/
theorem eq_of_forall_tensorSplitChart_res_eq
    (χ : ∀ y : (H.tensorLeft H').Y, TensorSplitChart C sX H H' y)
    {a b : TotalChowClass C sX} (h : ∀ y, (χ y).left.res a = (χ y).left.res b) : a = b :=
  eq_of_forall_splitChart_res_eq (H.tensorLeft H') (fun y ↦ (χ y).left) h

end Chart

/-! ### Products of pairwise commuting units -/

/-- The product of a `flatMap` is the product of the products. -/
@[to_additive /-- The sum of a `flatMap` is the sum of the sums. -/]
theorem list_prod_flatMap {α M : Type*} [Monoid M] (l : List α) (f : α → List M) :
    (l.flatMap f).prod = (l.map fun a ↦ (f a).prod).prod := by
  induction l with
  | nil => simp
  | cons a l ih => rw [List.flatMap_cons, List.prod_append, ih, List.map_cons, List.prod_cons]

/-- In a group, a power of the product of a list of pairwise commuting elements is the product of
the powers. -/
theorem list_prod_zpow_of_commute {M : Type*} [Group M] (n : ℤ) :
    ∀ l : List M, (∀ a ∈ l, ∀ b ∈ l, Commute a b) → l.prod ^ n = (l.map (· ^ n)).prod
  | [], _ => by simp
  | a :: l, h => by
    rw [List.prod_cons, (Commute.list_prod_right _ _ fun b hb ↦
        h a List.mem_cons_self b (List.mem_cons_of_mem _ hb)).mul_zpow, List.map_cons,
      List.prod_cons, list_prod_zpow_of_commute n l fun a ha b hb ↦
        h a (List.mem_cons_of_mem _ ha) b (List.mem_cons_of_mem _ hb)]

/-! ### The Chern roots on a tensor split chart -/

section ChartRoots

variable {C : ChowSituation.{u}} {X : Scheme.{u}} {sX : X ⟶ C.S} [LocallyOfFiniteType sX]
  {E F : DerivedCategory X.Modules} {H : EnvelopePresentation E} {H' : EnvelopePresentation F}

/-- The signed Chern roots `((-1)^n, x_{n,j})` of a presentation on a split chart, listed by the
degrees `n` in increasing order. -/
def SplitChart.roots {E' : DerivedCategory X.Modules} {H₁ : EnvelopePresentation E'} {y : H₁.Y}
    (χ : SplitChart C sX H₁ y) : List (ℤˣ × TotalChowClass C χ.T.sP) :=
  ((complexRank H₁.locallyBounded y).support.sort (· ≤ ·)).flatMap fun n ↦
    List.ofFn fun j ↦ (n.negOnePow, χ.root n j)

section SplitChartRoots

variable {E' : DerivedCategory X.Modules} {H₁ : EnvelopePresentation E'} {y : H₁.Y}
  (χ : SplitChart C sX H₁ y)

/-- Each Chern root `x_{n,j}` of a split chart is homogeneous of degree one. -/
theorem SplitChart.isHomogeneous_root (n : ℤ) (j : Fin (complexRank H₁.locallyBounded y n)) :
    (χ.root n j).IsHomogeneous 1 :=
  let := χ.isInvertible n j
  TotalChowClass.isHomogeneous_firstChernTotal C χ.T.sP (χ.L n j)

/-- Every signed Chern root of a split chart is `((-1)^n, x_{n,j})` for some `n` and `j`. -/
theorem SplitChart.exists_of_mem_roots {t : ℤˣ × TotalChowClass C χ.T.sP} (ht : t ∈ χ.roots) :
    ∃ n j, t = (n.negOnePow, χ.root n j) := by
  simp only [SplitChart.roots, List.mem_flatMap, List.mem_ofFn] at ht
  obtain ⟨n, -, j, rfl⟩ := ht
  exact ⟨n, j, rfl⟩

/-- The signed Chern roots of a split chart are homogeneous of degree one. -/
theorem SplitChart.isHomogeneous_roots : ∀ t ∈ χ.roots, t.2.IsHomogeneous 1 := by
  intro t ht
  simp only [SplitChart.roots, List.mem_flatMap, List.mem_ofFn] at ht
  obtain ⟨n, -, j, rfl⟩ := ht
  exact χ.isHomogeneous_root n j

/-- The unit `1 + x_{n,j}` is the root factor `Stacks.Chow.SplitChart.rootFactor`. -/
theorem SplitChart.oneAddUnit_root (n : ℤ) (j : Fin (complexRank H₁.locallyBounded y n)) :
    TotalChowClass.oneAddUnit (χ.root n j) = χ.rootFactor n j :=
  Units.ext (by rw [TotalChowClass.val_oneAddUnit (χ.isHomogeneous_root n j), χ.val_rootFactor])

/-- Any two root factors of a split chart commute. -/
theorem SplitChart.commute_rootFactor (n m : ℤ) (j : Fin (complexRank H₁.locallyBounded y n))
    (k : Fin (complexRank H₁.locallyBounded y m)) :
    Commute (χ.rootFactor n j) (χ.rootFactor m k) := by
  let := χ.isInvertible n j
  let := χ.isInvertible m k
  let := isFiniteLocallyFreeOfRank_one_of_isInvertible (χ.L n j)
  let := isFiniteLocallyFreeOfRank_one_of_isInvertible (χ.L m k)
  exact Units.ext (commute_totalChern C χ.T.sP (χ.L n j) (χ.L m k) 1 1).eq

/-- **The total Chern class on a split chart, as a product over the signed Chern roots**:
`c(E)|_P = ∏ (1 + x_{n,j})^{(-1)^n}`. -/
theorem SplitChart.res_perfectChernClass_eq_rootProd (hE : HasDefinedChernClasses E') :
    χ.res (perfectChernClass C sX hE) =
      ((TotalChowClass.rootProd χ.roots : (TotalChowClass C χ.T.sP)ˣ) :
        TotalChowClass C χ.T.sP) := by
  rw [χ.res_perfectChernClass_eq_complexChernBounded, complexChernBounded, complexChernProd]
  congr 1
  have hfac : complexChernFactor C χ.T.sP
      (pullbackComplex χ.T.π (pullbackComplex (H₁.componentOpens sX y).ι H₁.P))
      (complexRank H₁.locallyBounded y)
      (isFiniteLocallyFreeOfRank_pullbackComplex_X _ χ.T.π _
        (H₁.isFiniteLocallyFreeOfRank_componentOpens sX y)) =
      fun n ↦ (List.ofFn (χ.rootFactor n)).prod ^ ((n.negOnePow : ℤˣ) : ℤ) := by
    funext n
    rw [χ.list_prod_rootFactor]
    rfl
  rw [hfac, TotalChowClass.rootProd, SplitChart.roots, List.map_flatMap, list_prod_flatMap]
  congr 1
  refine List.map_congr_left fun n _ ↦ ?_
  rw [list_prod_zpow_of_commute _ _ (fun a ha b hb ↦ by
      obtain ⟨j, rfl⟩ := List.mem_ofFn.mp ha
      obtain ⟨k, rfl⟩ := List.mem_ofFn.mp hb
      exact χ.commute_rootFactor n n j k),
    List.map_ofFn, List.map_ofFn]
  congr 2
  funext j
  simp only [Function.comp_apply, χ.oneAddUnit_root]

/-- **The power sums on a split chart, as power sums of the signed Chern roots**:
`P_p(E)|_P = ∑ (-1)^n x_{n,j}^p` for every `p ≥ 0`. -/
theorem SplitChart.res_perfectPowerSum_eq_rootPow (hE : HasDefinedChernClasses E') (p : ℕ) :
    χ.res (perfectPowerSum C sX hE p) = rootPow χ.roots p := by
  rw [χ.res_perfectPowerSum_eq_sum hE p, rootPow, SplitChart.roots, List.map_flatMap,
    list_sum_flatMap, ← List.sum_toFinset _ (Finset.sort_nodup _ _), Finset.sort_toFinset]
  refine Finset.sum_congr rfl fun n _ ↦ ?_
  rw [List.map_ofFn, List.sum_ofFn, Finset.smul_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  simp [zsmul_eq_mul]

/-- The rank of the signed roots of a split chart is the alternating sum of the ranks. -/
theorem SplitChart.rootRank_roots :
    rootRank χ.roots = ∑ n ∈ (complexRank H₁.locallyBounded y).support,
      ((n.negOnePow : ℤˣ) : ℤ) * (complexRank H₁.locallyBounded y n : ℤ) := by
  rw [rootRank, SplitChart.roots, List.map_flatMap, list_sum_flatMap,
    ← List.sum_toFinset _ (Finset.sort_nodup _ _), Finset.sort_toFinset]
  refine Finset.sum_congr rfl fun n _ ↦ ?_
  rw [List.map_ofFn, List.sum_ofFn]
  simp [mul_comm]

end SplitChartRoots

end ChartRoots

/-! ### Regrouping products of signed roots in the group of Chern classes -/

section Regroup

variable {C : ChowSituation.{u}} {Y : Scheme.{u}} {sY : Y ⟶ C.S} [LocallyOfFiniteType sY]

/-- A product over a sorted finite set of integers, in a commutative monoid, is the product over
the set. -/
theorem list_prod_map_sort {M : Type*} [CommMonoid M] (S : Finset ℤ) (f : ℤ → M) :
    ((S.sort (· ≤ ·)).map f).prod = ∏ p ∈ S, f p := by
  rw [← List.prod_toFinset _ (Finset.sort_nodup _ _), Finset.sort_toFinset]

/-- The coercion of a product over a finite set of integers in the group of Chern classes is the
ordered product of the coercions. -/
private theorem coe_prod_eq_list_prod_sort_aux (S : Finset ℤ) (f : ℤ → chernUnitGroup C sY) :
    ((∏ p ∈ S, f p : chernUnitGroup C sY) : (TotalChowClass C sY)ˣ) =
      ((S.sort (· ≤ ·)).map fun p ↦ (f p : (TotalChowClass C sY)ˣ)).prod := by
  rw [← list_prod_map_sort S f]
  exact (map_list_prod (chernUnitGroupCoe C sY) _).trans (by rw [List.map_map]; rfl)

/-- The coercion of a product over `Fin n` in the group of Chern classes is the ordered product of
the coercions. -/
private theorem coe_prod_fin_eq_list_prod_aux (n : ℕ) (f : Fin n → chernUnitGroup C sY) :
    ((∏ j, f j : chernUnitGroup C sY) : (TotalChowClass C sY)ˣ) =
      (List.ofFn fun j ↦ (f j : (TotalChowClass C sY)ˣ)).prod := by
  rw [← List.prod_ofFn]
  exact (map_list_prod (chernUnitGroupCoe C sY) _).trans (by rw [List.map_ofFn]; rfl)

/-- **The total Chern class of the tensor product of two lists of signed roots, regrouped**: if
the units `1 + x_{p,j} + y_{q,k}` lie in the group of Chern classes, then
`∏ (1 + x + y)^{(-1)^p (-1)^q}` is the product of their powers there, over `p, j, q, k`. -/
theorem rootProd_rootTensor_eq_prod (S₁ S₂ : Finset ℤ) (ρ σ : ℤ → ℕ)
    (x : (p : ℤ) → Fin (ρ p) → TotalChowClass C sY) (y : (q : ℤ) → Fin (σ q) → TotalChowClass C sY)
    (W : (p : ℤ) → Fin (ρ p) → (q : ℤ) → Fin (σ q) → chernUnitGroup C sY)
    (hW : ∀ p j q k,
      TotalChowClass.oneAddUnit (x p j + y q k) = (W p j q k : (TotalChowClass C sY)ˣ)) :
    TotalChowClass.rootProd (rootTensor
        ((S₁.sort (· ≤ ·)).flatMap fun p ↦ List.ofFn fun j ↦ (p.negOnePow, x p j))
        ((S₂.sort (· ≤ ·)).flatMap fun q ↦ List.ofFn fun k ↦ (q.negOnePow, y q k))) =
      ((∏ p ∈ S₁, ∏ j, ∏ q ∈ S₂, ∏ k,
        W p j q k ^ ((p.negOnePow * q.negOnePow : ℤˣ) : ℤ) : chernUnitGroup C sY) :
          (TotalChowClass C sY)ˣ) := by
  simp only [TotalChowClass.rootProd, rootTensor, List.map_flatMap, list_prod_flatMap,
    List.map_ofFn, Function.comp_def, hW]
  rw [coe_prod_eq_list_prod_sort_aux]
  refine congrArg List.prod (List.map_congr_left fun p _ ↦ ?_)
  rw [coe_prod_fin_eq_list_prod_aux]
  refine congrArg List.prod (congrArg List.ofFn (funext fun j ↦ ?_))
  rw [coe_prod_eq_list_prod_sort_aux]
  refine congrArg List.prod (List.map_congr_left fun q _ ↦ ?_)
  rw [coe_prod_fin_eq_list_prod_aux]
  refine congrArg List.prod (congrArg List.ofFn (funext fun k ↦ ?_))
  exact (map_zpow (chernUnitGroupCoe C sY) _ _).symm

/-- **Regrouping a product over the pairs of degrees of nonzero ranks by total degree.** -/
@[to_additive /-- Regrouping a sum over the pairs of degrees of nonzero ranks by total degree. -/]
theorem prod_tensorSupport_fiberwise {M : Type*} [CommMonoid M] (ρ σ : ℤ →₀ ℕ) (T : Finset ℤ)
    (hT : ∀ p ∈ ρ.support, ∀ q ∈ σ.support, p + q ∈ T) (f : ℤ × ℤ → M) :
    ∏ N ∈ T, ∏ x ∈ tensorSupport ρ σ N, f x.1 = ∏ y ∈ ρ.support ×ˢ σ.support, f y := by
  classical
  have h : ∀ N, ∏ x ∈ tensorSupport ρ σ N, f x.1 =
      ∏ y ∈ ρ.support ×ˢ σ.support with y.1 + y.2 = N, f y := by
    intro N
    rw [tensorSupport, Finset.prod_subtype_eq_prod_filter f]
    exact Finset.prod_congr (Finset.filter_congr fun y _ ↦ Iff.rfl) fun _ _ ↦ rfl
  simp only [h]
  exact Finset.prod_fiberwise_of_maps_to (fun y hy ↦ by
    rw [Finset.mem_product] at hy
    exact hT y.1 hy.1 y.2 hy.2) f

/-- The coercion of a product over a finite set of integers in the group of Chern classes is the
ordered product of the coercions. -/
theorem coe_prod_eq_list_prod_sort (S : Finset ℤ) (f : ℤ → chernUnitGroup C sY) :
    ((∏ p ∈ S, f p : chernUnitGroup C sY) : (TotalChowClass C sY)ˣ) =
      ((S.sort (· ≤ ·)).map fun p ↦ (f p : (TotalChowClass C sY)ˣ)).prod := by
  exact coe_prod_eq_list_prod_sort_aux S f

/-- The coercion of a product over `Fin n` in the group of Chern classes is the ordered product of
the coercions. -/
theorem coe_prod_fin_eq_list_prod (n : ℕ) (f : Fin n → chernUnitGroup C sY) :
    ((∏ j, f j : chernUnitGroup C sY) : (TotalChowClass C sY)ˣ) =
      (List.ofFn fun j ↦ (f j : (TotalChowClass C sY)ˣ)).prod := by
  exact coe_prod_fin_eq_list_prod_aux n f

end Regroup

/-! ### The Chern roots of the derived tensor product on a tensor split chart -/

section TensorChart

variable {C : ChowSituation.{u}} {X : Scheme.{u}} {sX : X ⟶ C.S} [LocallyOfFiniteType sX]
  {E F : DerivedCategory X.Modules} {H : EnvelopePresentation E} {H' : EnvelopePresentation F}

namespace TensorSplitChart

variable {y : (H.tensorLeft H').Y} (χ : TensorSplitChart C sX H H' y)

/-- The Chern roots `x_{p,j}` of the presentation of `E`, on the chart. -/
abbrev rootL (p : ℤ) (j : Fin (complexRank (H.tensorLeft H').locallyBounded y p)) :
    TotalChowClass C χ.T.sP :=
  χ.left.root p j

/-- The Chern roots `y_{q,k}` of the presentation of `F`, on the chart. -/
abbrev rootR (q : ℤ) (k : Fin (complexRank (H.tensorRight H').locallyBounded y q)) :
    TotalChowClass C χ.T.sP :=
  χ.right.root q k

/-- Each Chern root `x_{p,j}` of `E` on the chart is homogeneous of degree one. -/
theorem isHomogeneous_rootL (p : ℤ) (j : Fin (complexRank (H.tensorLeft H').locallyBounded y p)) :
    (χ.rootL p j).IsHomogeneous 1 :=
  χ.left.isHomogeneous_root p j

/-- Each Chern root `y_{q,k}` of `F` on the chart is homogeneous of degree one. -/
theorem isHomogeneous_rootR (q : ℤ)
    (k : Fin (complexRank (H.tensorRight H').locallyBounded y q)) :
    (χ.rootR q k).IsHomogeneous 1 :=
  χ.right.isHomogeneous_root q k

/-- The signed Chern roots of `E` on the chart. -/
abbrev rootsLeft : List (ℤˣ × TotalChowClass C χ.T.sP) := χ.left.roots

/-- The signed Chern roots of `F` on the chart. -/
abbrev rootsRight : List (ℤˣ × TotalChowClass C χ.T.sP) := χ.right.roots

/-- The tensor product `𝒩_{q,k} ⊗ ℒ_{p,j}` of the invertible quotients is invertible. -/
theorem isInvertible_tensorObj (p : ℤ) (j : Fin (complexRank (H.tensorLeft H').locallyBounded y p))
    (q : ℤ) (k : Fin (complexRank (H.tensorRight H').locallyBounded y q)) :
    AlgebraicGeometry.SheafOfModules.IsInvertible χ.T.P.sheaf.obj χ.T.P.ringCatSheaf.property
      (Scheme.Modules.tensorObj (χ.N q k) (χ.L p j)) := by
  have := χ.isInvertible p j
  have := χ.isInvertible' q k
  infer_instance

/-- **The Chern root `1 + x_{p,j} + y_{q,k}` of the tensor product**, the total Chern class of
`𝒩_{q,k} ⊗ ℒ_{p,j}`, as an element of the group of Chern classes. -/
def tensorRootElem (p : ℤ) (j : Fin (complexRank (H.tensorLeft H').locallyBounded y p))
    (q : ℤ) (k : Fin (complexRank (H.tensorRight H').locallyBounded y q)) :
    chernUnitGroup C χ.T.sP :=
  haveI := χ.isInvertible_tensorObj p j q k
  haveI := isFiniteLocallyFreeOfRank_one_of_isInvertible
    (Scheme.Modules.tensorObj (χ.N q k) (χ.L p j))
  totalChernElem C χ.T.sP (Scheme.Modules.tensorObj (χ.N q k) (χ.L p j)) 1

/-- The underlying total class of `Stacks.Chow.TensorSplitChart.tensorRootElem` is
`1 + (y_{q,k} + x_{p,j})`. -/
theorem val_tensorRootElem (p : ℤ) (j : Fin (complexRank (H.tensorLeft H').locallyBounded y p))
    (q : ℤ) (k : Fin (complexRank (H.tensorRight H').locallyBounded y q)) :
    (((χ.tensorRootElem p j q k : chernUnitGroup C χ.T.sP) : (TotalChowClass C χ.T.sP)ˣ) :
      TotalChowClass C χ.T.sP) = 1 + (χ.rootR q k + χ.rootL p j) := by
  have := χ.isInvertible p j
  have := χ.isInvertible' q k
  have := χ.isInvertible_tensorObj p j q k
  have := isFiniteLocallyFreeOfRank_one_of_isInvertible
    (Scheme.Modules.tensorObj (χ.N q k) (χ.L p j))
  rw [tensorRootElem, val_val_totalChernElem, totalChern_eq_one_add_firstChernTotal,
    TotalChowClass.firstChernTotal_tensorObj]
  rfl

/-- The unit `1 + (x_{p,j} + y_{q,k})` is the Chern root of the tensor product. -/
theorem oneAddUnit_tensorRoot (p : ℤ) (j : Fin (complexRank (H.tensorLeft H').locallyBounded y p))
    (q : ℤ) (k : Fin (complexRank (H.tensorRight H').locallyBounded y q)) :
    TotalChowClass.oneAddUnit (χ.rootL p j + χ.rootR q k) =
      (χ.tensorRootElem p j q k : (TotalChowClass C χ.T.sP)ˣ) :=
  Units.ext (by
    rw [TotalChowClass.val_oneAddUnit (TotalChowClass.IsHomogeneous.add
      (χ.isHomogeneous_rootL p j) (χ.isHomogeneous_rootR q k)), val_tensorRootElem,
      add_comm (χ.rootR q k)])

/-- The pullback to the chart of the `p`-th term of the presentation of `E` is finite locally
free of its rank at the point. -/
theorem isFiniteLocallyFreeOfRank_left (p : ℤ) :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι)).obj
        ((H.tensorLeft H').P.X p))
      (complexRank (H.tensorLeft H').locallyBounded y p) :=
  AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u}
    ((Scheme.Modules.pullbackComp χ.T.π _).app _) (χ.left.isFiniteLocallyFreeOfRank_pullback p)

/-- The pullback to the chart of the `q`-th term of the presentation of `F` is finite locally
free of its rank at the point. -/
theorem isFiniteLocallyFreeOfRank_right (q : ℤ) :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι)).obj
        ((H.tensorRight H').P.X q))
      (complexRank (H.tensorRight H').locallyBounded y q) :=
  AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u}
    ((Scheme.Modules.pullbackComp χ.T.π _).app _) (χ.right.isFiniteLocallyFreeOfRank_pullback q)

attribute [local instance] isFiniteLocallyFreeOfRank_tensorObj_mul in
/-- **The Chern roots of a term of the tensor product on the chart**: the total Chern class of
`g^*𝓔^p ⊗ g^*𝓕^q` is `∏_{j, k} (1 + x_{p,j} + y_{q,k})`. -/
theorem totalChernElem_tensorObj_pullback (p q : ℤ) :
    haveI := χ.isFiniteLocallyFreeOfRank_left p
    haveI := χ.isFiniteLocallyFreeOfRank_right q
    totalChernElem C χ.T.sP (Scheme.Modules.tensorObj
        ((Scheme.Modules.pullback (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι)).obj
          ((H.tensorLeft H').P.X p))
        ((Scheme.Modules.pullback (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι)).obj
          ((H.tensorRight H').P.X q)))
      (complexRank (H.tensorLeft H').locallyBounded y p *
        complexRank (H.tensorRight H').locallyBounded y q) =
      ∏ j, ∏ k, χ.tensorRootElem p j q k := by
  have := χ.isFiniteLocallyFreeOfRank_left p
  have := χ.isFiniteLocallyFreeOfRank_right q
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback χ.T.π).obj
        ((pullbackComplex ((H.tensorLeft H').componentOpens sX y).ι (H.tensorLeft H').P).X p))
      (complexRank (H.tensorLeft H').locallyBounded y p) :=
    χ.left.isFiniteLocallyFreeOfRank_pullback p
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback χ.T.π).obj
        ((pullbackComplex ((H.tensorRight H').componentOpens sX y).ι (H.tensorRight H').P).X q))
      (complexRank (H.tensorRight H').locallyBounded y q) :=
    χ.right.isFiniteLocallyFreeOfRank_pullback q
  have := χ.isInvertible
  have := χ.isInvertible'
  have e : Scheme.Modules.tensorObj
        ((Scheme.Modules.pullback (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι)).obj
          ((H.tensorLeft H').P.X p))
        ((Scheme.Modules.pullback (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι)).obj
          ((H.tensorRight H').P.X q)) ≅
      Scheme.Modules.tensorObj
        ((Scheme.Modules.pullback χ.T.π).obj
          ((pullbackComplex ((H.tensorLeft H').componentOpens sX y).ι (H.tensorLeft H').P).X p))
        ((Scheme.Modules.pullback χ.T.π).obj
          ((pullbackComplex ((H.tensorRight H').componentOpens sX y).ι
            (H.tensorRight H').P).X q)) :=
    sheafTensorMapIso ((Scheme.Modules.pullbackComp χ.T.π _).app _).symm
      ((Scheme.Modules.pullbackComp χ.T.π _).app _).symm
  rw [totalChernElem_congr C χ.T.sP e rfl]
  refine Subtype.ext (Units.ext ?_)
  rw [val_val_totalChernElem, totalChern_tensorObj_eq_prod_prod C χ.T.sP _ _ _ _ _ (χ.L p)
    (χ.N q) (χ.hasQuotients p) (χ.hasQuotients' q) rfl, coe_prod_fin_eq_list_prod,
    ← Units.coeHom_apply, map_list_prod, List.map_ofFn]
  congr 1
  refine List.ofFn_inj.mpr (funext fun j ↦ ?_)
  rw [Function.comp_apply, Units.coeHom_apply, coe_prod_fin_eq_list_prod, ← Units.coeHom_apply,
    map_list_prod, List.map_ofFn]
  congr 1
  refine List.ofFn_inj.mpr (funext fun k ↦ ?_)
  rw [Function.comp_apply, Units.coeHom_apply, val_tensorRootElem]
  rfl

/-- Every pair of degrees of nonzero ranks contributes to the rank of the total tensor complex in
its total degree. -/
theorem add_mem_support_tensorRank (ρ σ : ℤ →₀ ℕ) {p q : ℤ} (hp : p ∈ ρ.support)
    (hq : q ∈ σ.support) : p + q ∈ (tensorRank ρ σ).support := by
  rw [Finsupp.mem_support_iff, tensorRank_apply, tensorRankFun]
  intro h
  have hx : (⟨(p, q), rfl⟩ : TotalFiber (p + q)) ∈ tensorSupport ρ σ (p + q) :=
    (mem_tensorSupport ρ σ _).2 ⟨hp, hq⟩
  exact Nat.mul_ne_zero (Finsupp.mem_support_iff.mp hp) (Finsupp.mem_support_iff.mp hq)
    (Finset.sum_eq_zero_iff.1 h ⟨_, hx⟩ (Finset.mem_univ _))

attribute [local instance] isFiniteLocallyFreeOfRank_tensorObj_mul in
/-- **The total Chern class of a term of the total tensor complex on the chart**: by the Whitney
formula, the product of the total Chern classes of the summands `g^*(𝓔^p ⊗ 𝓕^q)`. -/
theorem totalChernElem_pullback_tensorTotal_X (N : ℤ) :
    haveI := isFiniteLocallyFreeOfRank_pullbackComplex_tensorTotal
      (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι) (H.tensorLeft H').P
      (H.tensorRight H').P (complexRank (H.tensorLeft H').locallyBounded y)
      (complexRank (H.tensorRight H').locallyBounded y) χ.isFiniteLocallyFreeOfRank_left
      χ.isFiniteLocallyFreeOfRank_right N
    totalChernElem C χ.T.sP ((pullbackComplex (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι)
        (tensorTotal (H.tensorLeft H').P (H.tensorRight H').P)).X N)
      (tensorRank (complexRank (H.tensorLeft H').locallyBounded y)
        (complexRank (H.tensorRight H').locallyBounded y) N) =
      ∏ x ∈ tensorSupport (complexRank (H.tensorLeft H').locallyBounded y)
        (complexRank (H.tensorRight H').locallyBounded y) N,
        ∏ j, ∏ k, χ.tensorRootElem x.1.1 j x.1.2 k := by
  set g := χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι
  set ρ := complexRank (H.tensorLeft H').locallyBounded y
  set σ := complexRank (H.tensorRight H').locallyBounded y
  set K := (H.tensorLeft H').P
  set L := (H.tensorRight H').P
  have := isFiniteLocallyFreeOfRank_pullbackComplex_tensorTotal g K L ρ σ
    χ.isFiniteLocallyFreeOfRank_left χ.isFiniteLocallyFreeOfRank_right N
  have := χ.isFiniteLocallyFreeOfRank_left
  have := χ.isFiniteLocallyFreeOfRank_right
  let M : tensorSupport ρ σ N → χ.T.P.Modules := fun x ↦
    (Scheme.Modules.pullback g).obj (tensorSummand K L x.1)
  let r : tensorSupport ρ σ N → ℕ := fun x ↦ ρ x.1.1.1 * σ x.1.1.2
  have hM : ∀ x, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (M x)
      (r x) := fun x ↦ isFiniteLocallyFreeOfRank_pullback_tensorSummand g K L ρ σ
    χ.isFiniteLocallyFreeOfRank_left χ.isFiniteLocallyFreeOfRank_right x.1
  have := isFiniteLocallyFreeOfRank_biproduct _ rfl M r hM
  refine (totalChernElem_congr C χ.T.sP (pullbackTensorTotalPieceIso g K L ρ σ
    χ.isFiniteLocallyFreeOfRank_left χ.isFiniteLocallyFreeOfRank_right N)
    ((tensorRank_apply ρ σ N).trans rfl : tensorRank ρ σ N = ∑ x, r x)).trans ?_
  rw [totalChernElem_biproduct C χ.T.sP M r hM, ← Finset.prod_coe_sort (tensorSupport ρ σ N)
    (fun x : TotalFiber N ↦ ∏ j, ∏ k, χ.tensorRootElem x.1.1 j x.1.2 k)]
  refine Finset.prod_congr rfl fun x _ ↦ ?_
  have hT : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (Scheme.Modules.tensorObj ((Scheme.Modules.pullback g).obj (K.X x.1.1.1))
        ((Scheme.Modules.pullback g).obj (L.X x.1.1.2))) (r x) :=
    isFiniteLocallyFreeOfRank_tensorObj_mul _ _ _ _
  exact (@totalChernElem_congr C _ χ.T.sP _ _ _ _ _ (hM x) hT
    (sheafTensorPullbackIso g (K.X x.1.1.1) (L.X x.1.1.2)) rfl).trans
    (χ.totalChernElem_tensorObj_pullback x.1.1.1 x.1.1.2)

/-- The chart morphism followed by the structure maps is the structure map of the chart. -/
private theorem comp_hs :
    (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι) ≫ ((H.tensorLeft H').f ≫ sX) =
      χ.T.sP := by
  rw [← χ.T.hsP]
  simp only [Category.assoc]

/-- Restriction to the chart is restriction along the chart morphism after restriction to the
presentation. -/
private theorem left_res_eq_res_res (a : TotalChowClass C sX) :
    χ.left.res a = TotalChowClass.res (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι)
      χ.comp_hs (TotalChowClass.res (H.tensorLeft H').f rfl a) :=
  (χ.left.res_eq _).trans (TotalChowClass.res_res _ _ _ _ _)

/-- On a tensor split chart, the total Chern class of `E ⊗^L F` restricts to the total Chern
class of the pulled-back total tensor complex. -/
private theorem res_perfectChernClass_derivedTensor_eq_complexChernBounded
    (hE : HasDefinedChernClasses E) (hF : HasDefinedChernClasses F) :
    χ.left.res (perfectChernClass C sX (hasDefinedChernClasses_derivedTensor hE hF)) =
      complexChernBounded C χ.T.sP (pullbackComplex
        (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι)
        (tensorTotal (H.tensorLeft H').P (H.tensorRight H').P))
        (tensorRank (complexRank (H.tensorLeft H').locallyBounded y)
          (complexRank (H.tensorRight H').locallyBounded y))
        (isFiniteLocallyFreeOfRank_pullbackComplex_tensorTotal
          (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι) (H.tensorLeft H').P
          (H.tensorRight H').P (complexRank (H.tensorLeft H').locallyBounded y)
          (complexRank (H.tensorRight H').locallyBounded y) χ.isFiniteLocallyFreeOfRank_left
          χ.isFiniteLocallyFreeOfRank_right) := by
  have h2 : TotalChowClass.res (H.tensorLeft H').f rfl
      (perfectChernClass C sX (hasDefinedChernClasses_derivedTensor hE hF)) =
      complexChern C ((H.tensorLeft H').f ≫ sX)
        (isLocallyBoundedFiniteLocallyFree_tensorTotal (H.tensorLeft H').locallyBounded
          (H.tensorRight H').locallyBounded) :=
    res_perfectChernClass C sX _ (H.tensor H')
  rw [χ.left_res_eq_res_res, h2]
  exact res_complexChern_eq_complexChernBounded C _ _ _ χ.comp_hs _ _

/-- **The Chern roots of `E ⊗^L F` on a tensor split chart.** With `x_{p,j}` the Chern roots of
`E` and `y_{q,k}` those of `F` on the chart,

  `c(E ⊗^L F)|_P = ∏ (1 + x_{p,j} + y_{q,k})^{(-1)^p (-1)^q}`,

the total Chern class of the tensor product of the two lists of signed roots. -/
theorem res_perfectChernClass_derivedTensor (hE : HasDefinedChernClasses E)
    (hF : HasDefinedChernClasses F) :
    χ.left.res (perfectChernClass C sX (hasDefinedChernClasses_derivedTensor hE hF)) =
      ((TotalChowClass.rootProd (rootTensor χ.rootsLeft χ.rootsRight) :
        (TotalChowClass C χ.T.sP)ˣ) : TotalChowClass C χ.T.sP) := by
  have hτ := isFiniteLocallyFreeOfRank_pullbackComplex_tensorTotal
    (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι) (H.tensorLeft H').P (H.tensorRight H').P
    (complexRank (H.tensorLeft H').locallyBounded y)
    (complexRank (H.tensorRight H').locallyBounded y) χ.isFiniteLocallyFreeOfRank_left
    χ.isFiniteLocallyFreeOfRank_right
  have hres := χ.res_perfectChernClass_derivedTensor_eq_complexChernBounded hE hF
  have hRHS := rootProd_rootTensor_eq_prod (sY := χ.T.sP)
    (complexRank (H.tensorLeft H').locallyBounded y).support
    (complexRank (H.tensorRight H').locallyBounded y).support _ _ χ.rootL χ.rootR
    χ.tensorRootElem χ.oneAddUnit_tensorRoot
  rw [show rootTensor χ.rootsLeft χ.rootsRight = rootTensor
      (((complexRank (H.tensorLeft H').locallyBounded y).support.sort (· ≤ ·)).flatMap
        fun p ↦ List.ofFn fun j ↦ (p.negOnePow, χ.rootL p j))
      (((complexRank (H.tensorRight H').locallyBounded y).support.sort (· ≤ ·)).flatMap
        fun q ↦ List.ofFn fun k ↦ (q.negOnePow, χ.rootR q k)) from rfl, hRHS, hres,
    complexChernBounded, complexChernProd]
  congr 1
  rw [List.map_congr_left fun N _ ↦
    complexChernFactor_eq_coe_zpow_totalChernElem C χ.T.sP _ _ hτ N,
    ← coe_prod_eq_list_prod_sort]
  congr 1
  calc _ = ∏ N ∈ (tensorRank (complexRank (H.tensorLeft H').locallyBounded y)
          (complexRank (H.tensorRight H').locallyBounded y)).support,
        ∏ x ∈ tensorSupport (complexRank (H.tensorLeft H').locallyBounded y)
          (complexRank (H.tensorRight H').locallyBounded y) N,
          (∏ j, ∏ k, χ.tensorRootElem x.1.1 j x.1.2 k) ^
            ((x.1.1.negOnePow * x.1.2.negOnePow : ℤˣ) : ℤ) := by
        refine Finset.prod_congr rfl fun N _ ↦ ?_
        rw [χ.totalChernElem_pullback_tensorTotal_X N, ← Finset.prod_zpow]
        refine Finset.prod_congr rfl fun x _ ↦ ?_
        have hx : x.1.1 + x.1.2 = N := x.2
        rw [show N.negOnePow = x.1.1.negOnePow * x.1.2.negOnePow by
          rw [← Int.negOnePow_add, hx]]
    _ = ∏ z ∈ (complexRank (H.tensorLeft H').locallyBounded y).support ×ˢ
          (complexRank (H.tensorRight H').locallyBounded y).support,
          (∏ j, ∏ k, χ.tensorRootElem z.1 j z.2 k) ^
            ((z.1.negOnePow * z.2.negOnePow : ℤˣ) : ℤ) :=
        prod_tensorSupport_fiberwise _ _ _ (fun p hp q hq ↦ add_mem_support_tensorRank _ _ hp hq)
          (fun z ↦ (∏ j, ∏ k, χ.tensorRootElem z.1 j z.2 k) ^
            ((z.1.negOnePow * z.2.negOnePow : ℤˣ) : ℤ))
    _ = _ := by
        rw [Finset.prod_product]
        refine Finset.prod_congr rfl fun p _ ↦ ?_
        simp only [← Finset.prod_zpow]
        rw [Finset.prod_comm]

/-- All the Chern roots on a tensor split chart commute pairwise. -/
theorem commute_roots :
    ∀ t ∈ χ.rootsLeft ++ χ.rootsRight, ∀ t' ∈ χ.rootsLeft ++ χ.rootsRight, Commute t.2 t'.2 := by
  have key : ∀ t ∈ χ.rootsLeft ++ χ.rootsRight, ∃ (M : χ.T.P.Modules)
      (_ : AlgebraicGeometry.SheafOfModules.IsInvertible χ.T.P.sheaf.obj
        χ.T.P.ringCatSheaf.property M), t.2 = TotalChowClass.firstChernTotal C χ.T.sP M := by
    intro t ht
    rcases List.mem_append.mp ht with ht | ht
    · obtain ⟨n, j, rfl⟩ := χ.left.exists_of_mem_roots ht
      exact ⟨χ.L n j, χ.isInvertible n j, rfl⟩
    · obtain ⟨n, j, rfl⟩ := χ.right.exists_of_mem_roots ht
      exact ⟨χ.N n j, χ.isInvertible' n j, rfl⟩
  intro t ht t' ht'
  obtain ⟨M, hM, h⟩ := key t ht
  obtain ⟨M', hM', h'⟩ := key t' ht'
  rw [h, h']
  exact commute_firstChernTotal C χ.T.sP M M'

/-- The signed Chern roots of `E` on the chart are homogeneous of degree one. -/
theorem isHomogeneous_rootsLeft : ∀ t ∈ χ.rootsLeft, t.2.IsHomogeneous 1 :=
  χ.left.isHomogeneous_roots

/-- The signed Chern roots of `F` on the chart are homogeneous of degree one. -/
theorem isHomogeneous_rootsRight : ∀ t ∈ χ.rootsRight, t.2.IsHomogeneous 1 :=
  χ.right.isHomogeneous_roots

/-- The roots of the tensor product are homogeneous of degree one. -/
theorem isHomogeneous_rootTensor : ∀ t ∈ rootTensor χ.rootsLeft χ.rootsRight,
    t.2.IsHomogeneous 1 := by
  intro t ht
  simp only [rootTensor, List.mem_flatMap, List.mem_map] at ht
  obtain ⟨a, ha, b, hb, rfl⟩ := ht
  exact TotalChowClass.IsHomogeneous.add (χ.isHomogeneous_rootsLeft a ha)
    (χ.isHomogeneous_rootsRight b hb)

/-- The roots of the tensor product commute pairwise. -/
theorem commute_rootTensor : ∀ t ∈ rootTensor χ.rootsLeft χ.rootsRight,
    ∀ t' ∈ rootTensor χ.rootsLeft χ.rootsRight, Commute t.2 t'.2 := by
  intro t ht t' ht'
  simp only [rootTensor, List.mem_flatMap, List.mem_map] at ht ht'
  obtain ⟨a, ha, b, hb, rfl⟩ := ht
  obtain ⟨a', ha', b', hb', rfl⟩ := ht'
  have h := χ.commute_roots
  have m1 := List.mem_append_left χ.rootsRight ha
  have m2 := List.mem_append_right χ.rootsLeft hb
  have m3 := List.mem_append_left χ.rootsRight ha'
  have m4 := List.mem_append_right χ.rootsLeft hb'
  exact ((h a m1 a' m3).add_right (h a m1 b' m4)).add_left
    ((h b m2 a' m3).add_right (h b m2 b' m4))

/-- **The total Chern class of `E` on the chart**, by its signed roots. -/
theorem res_perfectChernClass_left (hE : HasDefinedChernClasses E) :
    χ.left.res (perfectChernClass C sX hE) =
      ((TotalChowClass.rootProd χ.rootsLeft : (TotalChowClass C χ.T.sP)ˣ) :
        TotalChowClass C χ.T.sP) :=
  χ.left.res_perfectChernClass_eq_rootProd hE

/-- **The total Chern class of `F` on the chart**, by its signed roots. -/
theorem res_perfectChernClass_right (hF : HasDefinedChernClasses F) :
    χ.left.res (perfectChernClass C sX hF) =
      ((TotalChowClass.rootProd χ.rootsRight : (TotalChowClass C χ.T.sP)ˣ) :
        TotalChowClass C χ.T.sP) :=
  χ.right.res_perfectChernClass_eq_rootProd hF

/-- **The power sums of `E` on the chart.** -/
theorem res_perfectPowerSum_left (hE : HasDefinedChernClasses E) (p : ℕ) :
    χ.left.res (perfectPowerSum C sX hE p) = rootPow χ.rootsLeft p :=
  χ.left.res_perfectPowerSum_eq_rootPow hE p

/-- **The power sums of `F` on the chart.** -/
theorem res_perfectPowerSum_right (hF : HasDefinedChernClasses F) (p : ℕ) :
    χ.left.res (perfectPowerSum C sX hF p) = rootPow χ.rootsRight p :=
  χ.right.res_perfectPowerSum_eq_rootPow hF p

/-- The power sums of positive degree of a class whose total Chern class restricts to a product
of signed roots are the power sums of the roots. -/
theorem res_perfectPowerSum_of_res_perfectChernClass {E' : DerivedCategory X.Modules}
    (hE' : HasDefinedChernClasses E') (l : List (ℤˣ × TotalChowClass C χ.T.sP))
    (hl : ∀ t ∈ l, t.2.IsHomogeneous 1) (hcomm : ∀ t ∈ l, ∀ t' ∈ l, Commute t.2 t'.2)
    (hc : χ.left.res (perfectChernClass C sX hE') =
      ((TotalChowClass.rootProd l : (TotalChowClass C χ.T.sP)ˣ) : TotalChowClass C χ.T.sP))
    (p : ℕ) (hp : 0 < p) :
    χ.left.res (perfectPowerSum C sX hE' p) = rootPow l p := by
  rw [perfectPowerSum, AlgebraicGeometry.map_newtonPowerSum χ.left.res,
    AlgebraicGeometry.newtonPowerSum_eq_of_pos _ 0 _ p hp]
  have hcomp : (fun i : ℕ+ ↦ χ.left.res (TotalChowClass.homComponent (i : ℕ)
      (perfectChernClass C sX hE'))) =
      fun i : ℕ+ ↦ TotalChowClass.homComponent (i : ℕ) (χ.left.res (perfectChernClass C sX hE')) :=
    funext fun i ↦ TotalChowClass.res_homComponent _ _ _ _
  rw [hcomp]
  show TotalChowClass.newtonComponents (χ.left.res (perfectChernClass C sX hE')) p = _
  rw [hc]
  exact TotalChowClass.newtonComponents_rootProd l hl hcomm p hp

/-- **The rank of `E ⊗^L F` on the chart** is the product of the ranks. -/
theorem res_perfectRankClass_derivedTensor (hE : HasDefinedChernClasses E)
    (hF : HasDefinedChernClasses F) :
    χ.left.res (perfectRankClass C sX (hasDefinedChernClasses_derivedTensor hE hF)) =
      ((rootRank χ.rootsLeft * rootRank χ.rootsRight : ℤ) : TotalChowClass C χ.T.sP) := by
  rcases isEmpty_or_nonempty χ.T.P with hP | hP
  · have : Subsingleton (TotalChowClass C χ.left.T.sP) :=
      @TotalChowClass.subsingleton_of_isEmpty C χ.T.P hP χ.T.sP _
    exact Subsingleton.elim _ _
  have hl : rootRank χ.rootsLeft = ∑ n ∈ (complexRank (H.tensorLeft H').locallyBounded y).support,
      ((n.negOnePow : ℤˣ) : ℤ) * (complexRank (H.tensorLeft H').locallyBounded y n : ℤ) :=
    χ.left.rootRank_roots
  have hr : rootRank χ.rootsRight =
      ∑ n ∈ (complexRank (H.tensorRight H').locallyBounded y).support,
      ((n.negOnePow : ℤˣ) : ℤ) * (complexRank (H.tensorRight H').locallyBounded y n : ℤ) :=
    χ.right.rootRank_roots
  have hτ := isFiniteLocallyFreeOfRank_pullbackComplex_tensorTotal
    (χ.T.π ≫ ((H.tensorLeft H').componentOpens sX y).ι) (H.tensorLeft H').P (H.tensorRight H').P
    (complexRank (H.tensorLeft H').locallyBounded y)
    (complexRank (H.tensorRight H').locallyBounded y) χ.isFiniteLocallyFreeOfRank_left
    χ.isFiniteLocallyFreeOfRank_right
  have h2 : TotalChowClass.res (H.tensorLeft H').f rfl
      (perfectRankClass C sX (hasDefinedChernClasses_derivedTensor hE hF)) =
      complexRankClass C ((H.tensorLeft H').f ≫ sX)
        (isLocallyBoundedFiniteLocallyFree_tensorTotal (H.tensorLeft H').locallyBounded
          (H.tensorRight H').locallyBounded) :=
    res_perfectRankClass C sX _ (H.tensor H')
  rw [χ.left_res_eq_res_res, h2, res_complexRankClass_of_constant_rank C _ _ _ χ.comp_hs _ hτ,
    zsmul_one]
  congr 1
  rw [finsum_eq_sum_of_support_subset
      (s := (tensorRank (complexRank (H.tensorLeft H').locallyBounded y)
        (complexRank (H.tensorRight H').locallyBounded y)).support) _ (fun n hn ↦ by
        rw [Function.mem_support] at hn
        rw [Finset.mem_coe, Finsupp.mem_support_iff]
        intro h0
        exact hn (by rw [h0]; simp)),
    hl, hr, Finset.sum_mul_sum,
    ← Finset.sum_product']
  rw [← sum_tensorSupport_fiberwise _ _ _ (fun p hp q hq ↦ add_mem_support_tensorRank _ _ hp hq)]
  refine Finset.sum_congr rfl fun N _ ↦ ?_
  rw [tensorRank_apply, tensorRankFun,
    Finset.sum_coe_sort (tensorSupport _ _ N) (fun x : TotalFiber N ↦
      complexRank (H.tensorLeft H').locallyBounded y x.1.1 *
        complexRank (H.tensorRight H').locallyBounded y x.1.2), Nat.cast_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun x _ ↦ ?_
  have hx : x.1.1 + x.1.2 = N := x.2
  rw [show N.negOnePow = x.1.1.negOnePow * x.1.2.negOnePow by rw [← Int.negOnePow_add, hx]]
  push_cast
  ring

/-- **The power sums of `E ⊗^L F` on the chart** are the power sums of the roots `x + y`. -/
theorem res_perfectPowerSum_derivedTensor (hE : HasDefinedChernClasses E)
    (hF : HasDefinedChernClasses F) (p : ℕ) :
    χ.left.res (perfectPowerSum C sX (hasDefinedChernClasses_derivedTensor hE hF) p) =
      rootPow (rootTensor χ.rootsLeft χ.rootsRight) p := by
  rcases Nat.eq_zero_or_pos p with rfl | hp
  · exact (congrArg χ.left.res (perfectPowerSum_zero C sX _)).trans
      ((χ.res_perfectRankClass_derivedTensor hE hF).trans
        (by rw [rootPow_zero, rootRank_rootTensor]))
  · exact χ.res_perfectPowerSum_of_res_perfectChernClass _ _ χ.isHomogeneous_rootTensor
      χ.commute_rootTensor (χ.res_perfectChernClass_derivedTensor hE hF) p hp

