module

public import StacksFrontier.AlgebraicGeometry.ProjectiveSpace.HyperplaneIsProjectiveSpace
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.SymRegular
public import StacksFrontier.AlgebraicGeometry.Chow.GysinConstruction.ZeroScheme

/-!
# The hyperplane of a degree-one element of a graded ring, and two locality principles

Let `S = ⨁_{n ≥ 0} 𝒮 n` be a graded ring generated in degree one over `𝒮 0`, and `t ∈ 𝒮 1`. The
global section of `𝒪_{Proj 𝒮}(1)` attached to `t` has a zero scheme `Z(t) ⊆ Proj 𝒮`. This file
proves:

* if `φ : 𝒮 ⟶ ℬ` is a surjective homomorphism of graded rings whose kernel is the ideal `(t)`,
  then `Z(t)` is the closed subscheme cut out by the closed immersion `Proj φ : Proj ℬ ⟶ Proj 𝒮`
  (on the standard chart `D₊(g)` of a degree-one `g` both ideals are generated by `t / g`;
  this is `Stacks.ProjectiveSpace.ker_projMap_eq_zeroScheme`, restated here for the zero scheme
  of [Stacks, Tag 02OQ]);
* if `t` is a nonzerodivisor of `S`, then `Z(t)` is an effective Cartier divisor: on `D₊(g)` its
  ideal is generated by `t / g`, which is a nonzerodivisor of the degree-zero part of `S_g`,
  since `t` stays one in `S_g` and `g` is a unit there ([Stacks, Tag 01WS]).

It also proves that an ideal sheaf is determined by its inverse images along a family of open
immersions covering the scheme, and that it is an effective Cartier divisor as soon as each of
those inverse images is one.

## Main results

* `Stacks.Chow.GenuineChern.eq_of_comap_eq_of_iSup_opensRange_eq_top`: an ideal sheaf is
  determined by its inverse images along a covering family of open immersions.
* `Stacks.Chow.GenuineChern.isEffectiveCartierDivisor_of_comap`: being an effective Cartier
  divisor is local along a covering family of open immersions.
* `Stacks.Chow.GenuineChern.zeroScheme_degreeSection_eq_ker_projMap`: `Z(t) = Ker(Proj φ)`.
* `Stacks.Chow.GenuineChern.isEffectiveCartierDivisor_zeroScheme_degreeSection`: `Z(t)` is an
  effective Cartier divisor when `t` is a nonzerodivisor.

## References

* [Stacks Project, Tag 02OQ](https://stacks.math.columbia.edu/tag/02OQ)
* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
* [Stacks Project, Tag 01N1](https://stacks.math.columbia.edu/tag/01N1)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace HomogeneousLocalization
open AlgebraicGeometry.ProjectiveSpectrum.Proj

universe u

namespace Stacks.Chow.GenuineChern

/-! ### Regularity along ring homomorphisms -/

section Regular

variable {A B : Type*} [CommRing A] [CommRing B]

/-- A ring isomorphism carries nonzerodivisors to nonzerodivisors. -/
theorem isRegular_ringEquiv (e : A ≃+* B) {a : A} (ha : IsRegular a) : IsRegular (e a) := by
  refine ⟨fun x y hxy => e.symm.injective (ha.1 ?_), fun x y hxy => e.symm.injective (ha.2 ?_)⟩ <;>
    simpa using congrArg e.symm hxy

/-- An element whose image under an injective ring homomorphism is a nonzerodivisor is a
nonzerodivisor. -/
theorem isRegular_of_injective (φ : A →+* B) (hφ : Function.Injective φ) {a : A}
    (h : IsRegular (φ a)) : IsRegular a := by
  refine ⟨fun x y hxy => hφ (h.1 ?_), fun x y hxy => hφ (h.2 ?_)⟩ <;>
    simpa only [map_mul] using congrArg φ hxy

end Regular

/-! ### Locality of ideal sheaves along open immersions -/

section Locality

variable {P : Scheme.{u}} {ι : Type*} {Z : ι → Scheme.{u}} (j : ∀ i, Z i ⟶ P)
  [∀ i, IsOpenImmersion (j i)] (hj : ⨆ i, (j i).opensRange = ⊤)

include hj in
/-- Every point of `P` is the image of a point of some member of the covering family. -/
theorem exists_eq_of_iSup_opensRange_eq_top (x : P) : ∃ i, ∃ z : Z i, j i z = x := by
  have hx : x ∈ ⨆ i, (j i).opensRange := by rw [hj]; trivial
  obtain ⟨i, hi⟩ := Opens.mem_iSup.1 hx
  exact ⟨i, Scheme.Hom.mem_opensRange.1 hi⟩

include hj in
/-- **An ideal sheaf is determined by its inverse images along a covering family of open
immersions.** -/
theorem eq_of_comap_eq_of_iSup_opensRange_eq_top {I J : P.IdealSheafData}
    (h : ∀ i, I.comap (j i) = J.comap (j i)) : I = J := by
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top (ι := Σ i, (Z i).affineOpens)
    (fun p => ⟨j p.1 ''ᵁ p.2.1, p.2.2.image_of_isOpenImmersion (j p.1)⟩)
    (eq_top_iff.2 fun x _ => ?_) fun p => ?_
  · obtain ⟨i, z, rfl⟩ := exists_eq_of_iSup_opensRange_eq_top j hj x
    obtain ⟨V, hzV⟩ := Stacks.Divisors.exists_affineOpens_mem z
    exact Opens.mem_iSup.2 ⟨⟨i, V⟩, ⟨z, hzV, rfl⟩⟩
  · have hi := congrArg (fun K : (Z p.1).IdealSheafData => K.ideal p.2) (h p.1)
    simp only [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion] at hi
    exact Ideal.comap_injective_of_surjective _
      (ConcreteCategory.bijective_of_isIso ((j p.1).appIso p.2).inv).2 hi

include hj in
/-- **Being an effective Cartier divisor is local along a covering family of open immersions.**
If the inverse image of `I` along each member of the family is an effective Cartier divisor, then
so is `I`: around a point, the ideal of the inverse image is generated on an affine open by a
nonzerodivisor, and the open immersion identifies that affine open and its ring of sections with
an affine open of `P` and its ring of sections ([Stacks, Tag 01WS]). -/
theorem isEffectiveCartierDivisor_of_comap (I : P.IdealSheafData)
    (h : ∀ i, Stacks.Divisors.IsEffectiveCartierDivisor (I.comap (j i))) :
    Stacks.Divisors.IsEffectiveCartierDivisor I := by
  refine Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen I fun x => ?_
  obtain ⟨i, z, rfl⟩ := exists_eq_of_iSup_opensRange_eq_top j hj x
  obtain ⟨U, hU, hzU, f, hf, hgen⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor _ (h i) z
  set e := ((j i).appIso U).commRingCatIsoToRingEquiv with he
  refine ⟨j i ''ᵁ U, hU.image_of_isOpenImmersion (j i), ⟨z, hzU, rfl⟩, e.symm f,
    isRegular_ringEquiv e.symm hf, ?_⟩
  have hgen' := hgen
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion I (j i) ⟨U, hU⟩] at hgen'
  rw [← Ideal.map_comap_of_surjective ((j i).appIso U).inv.hom
    (ConcreteCategory.bijective_of_isIso ((j i).appIso U).inv).2
    (I.ideal ⟨j i ''ᵁ U, hU.image_of_isOpenImmersion (j i)⟩), hgen', Ideal.map_span,
    Set.image_singleton]
  rfl

end Locality

/-! ### The hyperplane of a degree-one element -/

section Hyperplane

variable {S B σ τ : Type u} [CommRing S] [CommRing B] [SetLike σ S] [AddSubgroupClass σ S]
  [SetLike τ B] [AddSubgroupClass τ B] (𝒮 : ℕ → σ) (ℬ : ℕ → τ) [GradedRing 𝒮] [GradedRing ℬ]

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf
attribute [local instance_reducible] ProjectiveSpectrum.top

/-- **The zero scheme of a degree-one section is the kernel of `Proj φ`.** For `𝒮` generated in
degree one, a surjective homomorphism of graded rings `φ : 𝒮 ⟶ ℬ` whose kernel is generated by
`t ∈ 𝒮 1`, the zero scheme of the global section of `𝒪_{Proj 𝒮}(1)` attached to `t` is the ideal
sheaf of the closed immersion `Proj φ`. -/
theorem zeroScheme_degreeSection_eq_ker_projMap (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤)
    (φ : 𝒮 →+*ᵍ ℬ)
    (hφ : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒮).map φ)
    (hsurj : Function.Surjective φ) (t : 𝒮 1)
    (hker : RingHom.ker (φ : S →+* B) = Ideal.span {(t : S)}) :
    haveI := algebraicGeometry_isInvertible_twistingSheaf 𝒮 hgen ((1 : ℕ) : ℤ)
    Stacks.Divisors.zeroScheme (Proj 𝒮) (twistingSheafModule 𝒮 ((1 : ℕ) : ℤ))
        (degreeSection 𝒮 1 t) =
      (Proj.map φ hφ).ker :=
  have := algebraicGeometry_isInvertible_twistingSheaf 𝒮 hgen ((1 : ℕ) : ℤ)
  (Stacks.ProjectiveSpace.ker_projMap_eq_zeroScheme 𝒮 ℬ φ hφ hsurj hgen t hker).symm

/-- The chart function `t / g` of a nonzerodivisor `t` of degree one is a nonzerodivisor of the
ring of sections over `D₊(g)`, for `g` of degree one. -/
theorem isRegular_chartFraction {g : S} (hg : g ∈ 𝒮 1) (t : 𝒮 (1 • 1)) (ht : IsRegular (t : S)) :
    IsRegular (chartFraction 𝒮 hg 1 t) := by
  have hiso : IsIso (Proj.awayToSection 𝒮 g) :=
    Stacks.ProjQuotientChartIdeal.isIso_awayToSection hg Nat.one_pos
  refine isRegular_ringEquiv (asIso (Proj.awayToSection 𝒮 g)).commRingCatIsoToRingEquiv ?_
  refine isRegular_of_injective (algebraMap (Away 𝒮 g) (Localization.Away g))
    (fun a b h => HomogeneousLocalization.val_injective _ h) ?_
  show IsRegular (Away.mk 𝒮 hg 1 (t : S) t.2).val
  rw [Away.val_mk, Localization.mk_eq_mk']
  have hreg : IsRegular (algebraMap S (Localization.Away g) t) :=
    isRegular_iff_mem_nonZeroDivisors.2 (IsLocalization.map_nonZeroDivisors_le
      (Submonoid.powers g) (Localization.Away g)
      (Submonoid.mem_map_of_mem _ (isRegular_iff_mem_nonZeroDivisors.1 ht)))
  have key : ∀ y : Submonoid.powers g,
      IsRegular (IsLocalization.mk' (Localization.Away g) (t : S) y) := fun y => by
    rw [← IsLocalization.mk'_spec (Localization.Away g) (t : S) y] at hreg
    exact hreg.of_mul_left
  exact key _

/-- **The zero scheme of a degree-one nonzerodivisor is an effective Cartier divisor.** For `𝒮`
generated in degree one and `t ∈ 𝒮 1` a nonzerodivisor of `S`, the zero scheme of the global
section of `𝒪_{Proj 𝒮}(1)` attached to `t` is an effective Cartier divisor: on the standard open
of a degree-one `g` its ideal is generated by the nonzerodivisor `t / g`. -/
theorem isEffectiveCartierDivisor_zeroScheme_degreeSection
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤) (t : 𝒮 1) (ht : IsRegular (t : S)) :
    haveI := algebraicGeometry_isInvertible_twistingSheaf 𝒮 hgen ((1 : ℕ) : ℤ)
    Stacks.Divisors.IsEffectiveCartierDivisor
      (Stacks.Divisors.zeroScheme (Proj 𝒮) (twistingSheafModule 𝒮 ((1 : ℕ) : ℤ))
        (degreeSection 𝒮 1 t)) := by
  have := algebraicGeometry_isInvertible_twistingSheaf 𝒮 hgen ((1 : ℕ) : ℤ)
  refine Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen _ fun x => ?_
  have hcover : ⨆ g : 𝒮 1, Proj.basicOpen 𝒮 (g : S) = ⊤ := by
    refine Proj.iSup_basicOpen_eq_top' 𝒮 (fun g : 𝒮 1 => (g : S)) (fun g => ⟨1, g.2⟩) ?_
    rw [show Set.range (fun g : 𝒮 1 => (g : S)) = (𝒮 1 : Set S) from Subtype.range_coe]
    exact hgen
  have hx : x ∈ ⨆ g : 𝒮 1, Proj.basicOpen 𝒮 (g : S) := by rw [hcover]; trivial
  obtain ⟨g, hxg⟩ := Opens.mem_iSup.1 hx
  have ht' : (t : S) ∈ 𝒮 (1 • 1) := by simp [t.2]
  exact ⟨Proj.basicOpen 𝒮 (g : S), Proj.isAffineOpen_basicOpen 𝒮 (g : S) g.2 Nat.one_pos, hxg,
    chartFraction 𝒮 g.2 1 ⟨t, ht'⟩, isRegular_chartFraction 𝒮 g.2 ⟨t, ht'⟩ ht,
    zeroScheme_degreeSection_ideal_basicOpen_of_degree_eq 𝒮 g.2 Nat.one_pos 1 (by simp) t ht'⟩

end Hyperplane

end Stacks.Chow.GenuineChern

end
