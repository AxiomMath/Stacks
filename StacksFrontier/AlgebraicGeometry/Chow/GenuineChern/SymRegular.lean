module

public import StacksFrontier.LinearAlgebra.SymmetricPower.Presentation
public import Mathlib.Algebra.Polynomial.AlgebraMap

/-!
# Two facts about symmetric algebras: a split vector is regular, and the kernel of `Sym(f)`

Let `R` be a commutative ring.

* If `t ∈ N` admits a linear functional `l : N →ₗ[R] R` with `l t = 1`, then `t`, as an element
  of degree one of the symmetric algebra `Sym_R(N)`, is a nonzerodivisor. Writing
  `N = R t ⊕ ker l`, the symmetric algebra is a polynomial ring in `t` over `Sym(ker l)`. The
  proof uses only half of this: the algebra map `Sym(N) ⟶ Sym(N)[X]`,
  `n ↦ ι(n - l(n) t) + l(n) X`, has the left inverse `X ↦ ι t`, and it carries `ι t` to `X`, a
  nonzerodivisor of a polynomial ring.
* If `f : N →ₗ[R] N'` is surjective, the kernel of `Sym(f) : Sym(N) ⟶ Sym(N')` is the ideal
  generated by `ι(ker f)`. The inclusion `⊆` is
  `SymPow.ker_symAlgMap_le_rangeIdeal`; the other one holds because `Sym(f)` kills `ι(ker f)`.

## Main results

* `Stacks.Chow.GenuineChern.isRegular_ι_of_eq_one`: `ι t` is a nonzerodivisor of `Sym(N)` when
  `l t = 1` for some linear functional `l`.
* `Stacks.Chow.GenuineChern.ker_symAlgMap_eq_span`: the kernel of `Sym(f)` for `f` surjective.
* `Stacks.Chow.GenuineChern.ker_symAlgMap_eq_span_singleton_of_exact`: for
  `0 ⟶ R ⟶ N ⟶ N' ⟶ 0` exact with `N'` projective, the kernel of `Sym(N) ⟶ Sym(N')` is
  generated by the image `t` of `1`, and `t` is a nonzerodivisor of `Sym(N)`.
-/

@[expose] public noncomputable section

open Polynomial

namespace Stacks.Chow.GenuineChern

variable {R : Type*} [CommRing R] {N N' : Type*} [AddCommGroup N] [Module R N] [AddCommGroup N']
  [Module R N']

/-- The linear map `N ⟶ Sym(N)[X]`, `n ↦ ι(n - l(n) t) + l(n) X`. -/
def splitLinearMap (t : N) (l : N →ₗ[R] R) : N →ₗ[R] (SymmetricAlgebra R N)[X] :=
  ((Algebra.linearMap (SymmetricAlgebra R N) (SymmetricAlgebra R N)[X]).restrictScalars R ∘ₗ
      SymmetricAlgebra.ι R N ∘ₗ (LinearMap.id - l.smulRight t)) +
    l.smulRight (X : (SymmetricAlgebra R N)[X])

/-- The algebra map `Sym(N) ⟶ Sym(N)[X]` attached to a vector `t` and a functional `l`. -/
def splitHom (t : N) (l : N →ₗ[R] R) : SymmetricAlgebra R N →ₐ[R] (SymmetricAlgebra R N)[X] :=
  SymmetricAlgebra.lift (splitLinearMap t l)

/-- `splitHom t l` sends `ι n` to `C (ι (n - l(n) t)) + l(n) X`. -/
theorem splitHom_ι (t : N) (l : N →ₗ[R] R) (n : N) :
    splitHom t l (SymmetricAlgebra.ι R N n) =
      C (SymmetricAlgebra.ι R N (n - l n • t)) + l n • X := by
  simp [splitHom, splitLinearMap, SymmetricAlgebra.lift_ι_apply]

/-- Evaluation at `ι t` is a left inverse of `splitHom t l`. -/
theorem aeval_splitHom (t : N) (l : N →ₗ[R] R) (x : SymmetricAlgebra R N) :
    aeval (SymmetricAlgebra.ι R N t) (splitHom t l x) = x := by
  have h : ((aeval (SymmetricAlgebra.ι R N t)).restrictScalars R).comp (splitHom t l) =
      AlgHom.id R (SymmetricAlgebra R N) := by
    refine SymmetricAlgebra.algHom_ext (LinearMap.ext fun n => ?_)
    show aeval (SymmetricAlgebra.ι R N t) (splitHom t l (SymmetricAlgebra.ι R N n)) =
      SymmetricAlgebra.ι R N n
    rw [splitHom_ι, map_add, aeval_C, Algebra.algebraMap_self, RingHom.id_apply,
      ← algebraMap_smul (SymmetricAlgebra R N) (l n) X, map_smul, aeval_X, map_sub,
      algebraMap_smul, map_smul, sub_add_cancel]
  exact congrArg (fun φ : SymmetricAlgebra R N →ₐ[R] SymmetricAlgebra R N => φ x) h

/-- If `l t = 1`, then `splitHom t l` sends `ι t` to `X`. -/
theorem splitHom_ι_self (t : N) (l : N →ₗ[R] R) (ht : l t = 1) :
    splitHom t l (SymmetricAlgebra.ι R N t) = X := by
  simp [splitHom_ι, ht]

/-- **A split vector is a nonzerodivisor of the symmetric algebra.** If `l t = 1` for a linear
functional `l`, then `ι t` is regular in `Sym_R(N)`. -/
theorem isRegular_ι_of_eq_one (t : N) (l : N →ₗ[R] R) (ht : l t = 1) :
    IsRegular (SymmetricAlgebra.ι R N t) := by
  have hinj : Function.Injective (splitHom t l) :=
    Function.LeftInverse.injective (aeval_splitHom t l)
  have hX : IsRegular (splitHom t l (SymmetricAlgebra.ι R N t)) := by
    rw [splitHom_ι_self t l ht]
    exact isRegular_X
  refine ⟨fun x y hxy => hinj (hX.1 ?_), fun x y hxy => hinj (hX.2 ?_)⟩
  · simpa only [map_mul] using congrArg (splitHom t l) hxy
  · simpa only [map_mul] using congrArg (splitHom t l) hxy

/-- **The kernel of `Sym(f)` for a surjection `f`** is the ideal generated by `ι(ker f)`. -/
theorem ker_symAlgMap_eq_span (f : N →ₗ[R] N') (hf : Function.Surjective f) :
    RingHom.ker (SymPow.symAlgMap f) =
      Ideal.span (SymmetricAlgebra.ι R N '' (LinearMap.ker f : Set N)) := by
  refine le_antisymm (fun z hz => ?_) (Ideal.span_le.2 ?_)
  · have h := SymPow.ker_symAlgMap_le_rangeIdeal (LinearMap.ker f).subtype f hf
      (by rw [Submodule.range_subtype]) hz
    have hset : Set.range (fun a : LinearMap.ker f => SymmetricAlgebra.ι R N
        ((LinearMap.ker f).subtype a)) = SymmetricAlgebra.ι R N '' (LinearMap.ker f : Set N) := by
      ext y
      simp
    rwa [SymPow.rangeIdeal, hset] at h
  · rintro _ ⟨n, hn, rfl⟩
    simp only [SetLike.mem_coe, RingHom.mem_ker, SymPow.symAlgMap_ι]
    rw [LinearMap.mem_ker.1 hn, map_zero]

/-- **A free rank-one submodule with projective quotient is split.** If `0 ⟶ R ⟶ G ⟶ Q ⟶ 0` is
exact with `Q` projective, then a linear functional on `G` takes the value `1` on the image of
`1`: a section `s` of `G ⟶ Q` exists, and `x ↦ i⁻¹(x - s(g x))` is a retraction of `i`. -/
theorem exists_eq_one_of_exact [Module.Projective R N'] (i : R →ₗ[R] N) (g : N →ₗ[R] N')
    (hi : Function.Injective i) (hg : Function.Surjective g)
    (hexact : LinearMap.range i = LinearMap.ker g) : ∃ l : N →ₗ[R] R, l (i 1) = 1 := by
  obtain ⟨s, hs⟩ := Module.projective_lifting_property g LinearMap.id hg
  set ρ : N →ₗ[R] N := LinearMap.id - s ∘ₗ g with hρ
  have hmem : ∀ x : N, ρ x ∈ LinearMap.range i := fun x => by
    rw [hexact, LinearMap.mem_ker]
    have := LinearMap.congr_fun hs (g x)
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.id_coe, id_eq] at this
    simp [hρ, this]
  refine ⟨(LinearEquiv.ofInjective i hi).symm ∘ₗ ρ.codRestrict (LinearMap.range i) hmem, ?_⟩
  have hgi : g (i 1) = 0 := by
    rw [← LinearMap.mem_ker, ← hexact]
    exact LinearMap.mem_range_self i 1
  have h : ρ.codRestrict (LinearMap.range i) hmem (i 1) = LinearEquiv.ofInjective i hi 1 := by
    ext
    simp [hρ, hgi]
  rw [LinearMap.comp_apply, h]
  exact (LinearEquiv.ofInjective i hi).symm_apply_apply 1

/-- If `range i = ker g` for `i : R ⟶ N` and `g` is surjective, then `ker Sym(g)` is generated
by `ι (i 1)`. -/
private theorem ker_symAlgMap_eq_span_singleton (i : R →ₗ[R] N) (g : N →ₗ[R] N')
    (hg : Function.Surjective g) (hexact : LinearMap.range i = LinearMap.ker g) :
    RingHom.ker (SymPow.symAlgMap g) = Ideal.span {SymmetricAlgebra.ι R N (i 1)} := by
  rw [ker_symAlgMap_eq_span g hg, ← hexact]
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
  · rintro _ ⟨_, ⟨r, rfl⟩, rfl⟩
    refine Ideal.mem_span_singleton'.2 ⟨algebraMap R _ r, ?_⟩
    rw [← Algebra.smul_def, ← map_smul, ← map_smul, smul_eq_mul, mul_one]
  · rintro _ rfl
    exact Ideal.subset_span ⟨i 1, LinearMap.mem_range_self i 1, rfl⟩

/-- **The symmetric algebra of an extension by a free module of rank one.** If
`0 ⟶ R ⟶ N ⟶ N' ⟶ 0` is exact with `N'` projective and `t` is the image of `1`, then `Sym(g)`
is a surjection `Sym(N) ⟶ Sym(N')` whose kernel is generated by the nonzerodivisor `ι t`. -/
theorem ker_symAlgMap_eq_span_singleton_of_exact [Module.Projective R N'] (i : R →ₗ[R] N)
    (g : N →ₗ[R] N') (hi : Function.Injective i) (hg : Function.Surjective g)
    (hexact : LinearMap.range i = LinearMap.ker g) :
    RingHom.ker (SymPow.symAlgMap g) = Ideal.span {SymmetricAlgebra.ι R N (i 1)} ∧
      IsRegular (SymmetricAlgebra.ι R N (i 1)) := by
  refine ⟨ker_symAlgMap_eq_span_singleton i g hg hexact, ?_⟩
  obtain ⟨l, hl⟩ := exists_eq_one_of_exact i g hi hg hexact
  exact isRegular_ι_of_eq_one (i 1) l hl

/-- `ker_symAlgMap_eq_span_singleton_of_exact` with the splitting supplied as a functional
`l` with `l (i 1) = 1` instead of being derived from projectivity of the quotient. -/
theorem ker_symAlgMap_eq_span_singleton_of_exact' (i : R →ₗ[R] N) (g : N →ₗ[R] N')
    (hi : Function.Injective i) (hg : Function.Surjective g)
    (hexact : LinearMap.range i = LinearMap.ker g) (l : N →ₗ[R] R) (hl : l (i 1) = 1) :
    RingHom.ker (SymPow.symAlgMap g) = Ideal.span {SymmetricAlgebra.ι R N (i 1)} ∧
      IsRegular (SymmetricAlgebra.ι R N (i 1)) :=
  ⟨ker_symAlgMap_eq_span_singleton i g hg hexact, isRegular_ι_of_eq_one (i 1) l hl⟩

end Stacks.Chow.GenuineChern

end
