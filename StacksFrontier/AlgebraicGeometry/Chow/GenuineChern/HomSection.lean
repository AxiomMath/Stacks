/-!
# The section of `ℬ ⊗ 𝒩^{-1}` attached to a morphism `𝒩 ⟶ ℬ` of invertible modules

Let `𝒩` and `ℬ` be invertible modules on a scheme `Y` and `φ : 𝒩 ⟶ ℬ` a morphism. Then `φ` is a
tensor product: there are an invertible module `ℒ` (namely `𝒩^{⊗ -1} ⊗ ℬ`), a global section `σ`
of `ℒ` and an isomorphism `𝒩 ⊗ ℒ ≅ ℬ` carrying `x ⊗ σ` to `φ(x)`
(`Stacks.SheafOfModules.TensorFactorization.exists_tensorFactorization`). This file names that
datum and computes the zero scheme of `σ` locally: wherever `𝒩` pulls back to a module generated
by one section `n`, the zero scheme of `σ` pulls back to the zero scheme of `φ(n)`.

## Main definitions

* `Stacks.Chow.GenuineChern.homSectionModule` — the invertible module `ℒ`.
* `Stacks.Chow.GenuineChern.homSection` — its section `σ`.
* `Stacks.Chow.GenuineChern.homSectionTensorIso` — the isomorphism `𝒩 ⊗ ℒ ≅ ℬ`.
* `Stacks.Chow.GenuineChern.unitIsoOfGenerator` — the isomorphism `𝒪 ≅ 𝒫` given by a global
  section `n` generating `𝒫`, `c ↦ c • n`.
* `Stacks.Chow.GenuineChern.pullbackTrivializationIso` — for `f^*𝒩 ≅ 𝒪`, the isomorphism
  `f^*ℒ ≅ f^*ℬ`.

## Main results

* `Stacks.Chow.GenuineChern.homSectionTensorIso_hom_toTensorSheafSection` — the isomorphism
  `𝒩 ⊗ ℒ ≅ ℬ` carries `x ⊗ σ` to `φ(x)`.
* `Stacks.Chow.GenuineChern.pullback_tensorFactorization` — a tensor factorization pulls back to
  one, through the comparison `f^*(𝒩 ⊗ ℒ) ≅ f^*𝒩 ⊗ f^*ℒ` of [Stacks, Tag 01CD].
* `Stacks.Chow.GenuineChern.comap_zeroScheme_homSection_of_iso` and
  `Stacks.Chow.GenuineChern.comap_zeroScheme_homSection` — the zero scheme of `σ` pulled back
  along `j` is the zero scheme of `(j^*φ)(n)` wherever `j^*𝒩` is generated by `n`.
* `Stacks.Chow.GenuineChern.comap_zeroScheme_homSection_of_generator` — the same for
  `𝒩 = π^*ℳ` and `n` the pullback along `π` and then `j` of a generator `m₀` of `ℳ` over an open
  `U` into whose preimage `j` maps.

## References

* [Stacks Project, Tag 01CS](https://stacks.math.columbia.edu/tag/01CS)
* [Stacks Project, Tag 02OQ](https://stacks.math.columbia.edu/tag/02OQ)
* [Stacks Project, Tag 01CD](https://stacks.math.columbia.edu/tag/01CD)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace AlgebraicGeometry Opposite
open Stacks.SheafOfModules.TensorStalkRingedSpace
open scoped TensorProduct

universe u

namespace Stacks.Chow.GenuineChern

section Factorization

variable {Y : Scheme.{u}} (N B : Y.Modules)
  [hN : AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property N]
  [hB : AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property B]
  (φ : N ⟶ B)

/-- The tensor factorization of `φ`. -/
theorem exists_homSection :
    ∃ (M : SheafOfModules.{u} (Stacks.RingedSpace.structureRingSheaf Y.toRingedSpace))
      (σ : M.sections)
      (e : (((Stacks.SheafOfModules.Tensor.sheafTensor
          ⟨(Y.toRingedSpace).presheaf, (Y.toRingedSpace).IsSheaf⟩).obj (N)).obj (M)) ≅ B),
      Stacks.SheafOfModules.IsInvertible Y.toRingedSpace.presheaf
          (_root_.structureSheafRing Y.toRingedSpace).property M ∧
        ∀ (U : (Opens Y.carrier)ᵒᵖ) (x : N.val.obj U),
          e.hom.val.app U (toTensorSheafSection Y.toRingedSpace N M U
            (x ⊗ₜ[Y.toRingedSpace.presheaf.obj U] σ.eval U)) = φ.val.app U x :=
  have : Stacks.SheafOfModules.IsInvertible Y.toRingedSpace.presheaf
      (_root_.structureSheafRing Y.toRingedSpace).property N :=
    Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ N hN
  have : Stacks.SheafOfModules.IsInvertible Y.toRingedSpace.presheaf
      (_root_.structureSheafRing Y.toRingedSpace).property B :=
    Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ B hB
  Stacks.SheafOfModules.TensorFactorization.exists_tensorFactorization Y.toRingedSpace N B φ

/-- **The invertible module `ℒ = 𝒩^{⊗ -1} ⊗ ℬ`** of the tensor factorization of `φ`. -/
def homSectionModule : Y.Modules := (exists_homSection N B φ).choose

/-- **The section `σ` of `ℒ`** attached to `φ`. -/
def homSection : (homSectionModule N B φ).sections :=
  (exists_homSection N B φ).choose_spec.choose

/-- **The isomorphism `𝒩 ⊗ ℒ ≅ ℬ`** of the tensor factorization of `φ`. -/
def homSectionTensorIso :
    (((Stacks.SheafOfModules.Tensor.sheafTensor
        ⟨(Y.toRingedSpace).presheaf, (Y.toRingedSpace).IsSheaf⟩).obj (N)).obj
      ((homSectionModule N B φ))) ≅ B :=
  (exists_homSection N B φ).choose_spec.choose_spec.choose

/-- The module `ℒ` of the tensor factorization of `φ` is invertible. -/
instance isInvertible_homSectionModule :
    AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property
      (homSectionModule N B φ) :=
  Stacks.SheafOfModules.IsInvertible.toAlgebraicGeometry _ _ _
    (exists_homSection N B φ).choose_spec.choose_spec.choose_spec.1

/-- **The tensor factorization on local pure tensors**: `x ⊗ σ ↦ φ(x)`. -/
theorem homSectionTensorIso_hom_toTensorSheafSection (U : (Opens Y.carrier)ᵒᵖ)
    (x : N.val.obj U) :
    (homSectionTensorIso N B φ).hom.val.app U
        (toTensorSheafSection Y.toRingedSpace N (homSectionModule N B φ) U
          (x ⊗ₜ[Y.toRingedSpace.presheaf.obj U] (homSection N B φ).eval U)) =
      φ.val.app U x :=
  (exists_homSection N B φ).choose_spec.choose_spec.choose_spec.2 U x

end Factorization

/-! ### A module generated by one global section -/

section Generator

variable {X : RingedSpace.{u, u}} (P : SheafOfModules.{u} (structureSheafRing X))
  (n : P.val.obj (op ⊤))
  (hn : ∀ W : Opens X.carrier,
    Function.Bijective fun c : X.presheaf.obj (op W) ↦
      c • P.val.map (homOfLE (le_top : W ≤ ⊤)).op n)

/-- **A module generated by one global section is the structure sheaf**: if every section of `P`
over every open is uniquely a multiple of the restriction of `n`, then `c ↦ c • n` is an
isomorphism `𝒪_X ≅ P`. -/
def unitIsoOfGenerator : SheafOfModules.unit (structureSheafRing X) ≅ P :=
  ((SheafOfModules.fullyFaithfulForget _).preimageIso <|
    PresheafOfModules.isoMk (fun W ↦
      (LinearEquiv.ofBijective
        (LinearMap.toSpanSingleton _ _ (P.val.map (homOfLE (le_top : W.unop ≤ ⊤)).op n))
        (hn W.unop)).toModuleIso)
      (fun A B f ↦ by
        ext
        simp only [ModuleCat.hom_comp]
        change (((Stacks.SheafOfModules.TensorStalkRingedSpace.O X).map f).hom
              (1 : X.presheaf.obj A)) • (P.val.map (homOfLE (le_top : B.unop ≤ ⊤)).op).hom n
            = (P.val.map f).hom ((1 : X.presheaf.obj A) •
              (P.val.map (homOfLE (le_top : A.unop ≤ ⊤)).op).hom n)
        rw [map_one, one_smul, one_smul, ← PresheafOfModules.map_comp_apply]
        exact P.val.congr_map_apply (Subsingleton.elim _ _) n))

/-- `unitIsoOfGenerator` sends a section `c` of `𝒪_X` over `W` to `c` times the restriction of
`n` to `W`. -/
theorem unitIsoOfGenerator_hom_app (W : Opens X.carrier) (c : X.presheaf.obj (op W)) :
    (unitIsoOfGenerator P n hn).hom.val.app (op W) c =
      c • P.val.map (homOfLE (le_top : W ≤ ⊤)).op n := by
  simp only [unitIsoOfGenerator, op_unop, homOfLE_leOfHom, Functor.FullyFaithful.preimageIso_hom,
    SheafOfModules.fullyFaithfulForget_preimage_val]
  rfl

/-- `unitIsoOfGenerator` sends the unit global section to `n`. -/
theorem unitIsoOfGenerator_hom_one :
    (unitIsoOfGenerator P n hn).hom.val.app (op ⊤) (1 : X.presheaf.obj (op ⊤)) = n := by
  rw [unitIsoOfGenerator_hom_app]
  refine (one_smul _ _).trans ?_
  rw [show homOfLE (le_top : (⊤ : Opens X.carrier) ≤ ⊤) = 𝟙 _ from rfl, op_id,
    PresheafOfModules.map_id]
  rfl

end Generator

/-! ### Pulling a tensor factorization back -/

section Pullback

attribute [local instance] Stacks.PullbackGradedAlgebra.monoidalCategory

open Stacks.PullbackTensorCoherence Stacks.RingedSpace RingedSpaceModuleAdjunction
open MonoidalCategory

variable {X Z : RingedSpace.{u, u}} (f : X ⟶ Z)
  {N L B : SheafOfModules.{u} (Stacks.RingedSpace.structureRingSheaf Z)}
  (e : N ⊗ L ≅ B) (σ : L.sections) (φ : N ⟶ B)

/-- The section `σ` of `L`, pulled back to `f^*L` and read as a morphism out of the unit. -/
def pullbackSectionHom : 𝟙_ (SheafOfModules.{u} (Stacks.RingedSpace.structureRingSheaf X)) ⟶
    (pullbackFunctor f).obj L :=
  inv (pullbackUnitComparison f) ≫ (pullbackFunctor f).map (L.unitHomEquiv.symm σ)

/-- `pullbackSectionHom` sends the unit section over `f⁻¹U` to the pullback of `σ` over `U`. -/
theorem pullbackSectionHom_oneSec (U : (Opens Z.carrier)ᵒᵖ) :
    (pullbackSectionHom f σ).val.app ((opensMap f).op.obj U) (oneSec X ((opensMap f).op.obj U)) =
      pullbackUnit f L U (σ.eval U) := by
  rw [pullbackSectionHom, SheafOfModules.comp_val_app_apply, ← pullbackUnitComparison_oneSec f U,
    inv_val_app_apply]
  refine (pullbackUnit_naturality f (L.unitHomEquiv.symm σ) U (oneSec Z U)).trans ?_
  refine congrArg (pullbackUnit f L U) ?_
  exact (unitHomEquiv_eval L (L.unitHomEquiv.symm σ) U).symm.trans
    (congrArg (fun τ : L.sections ↦ τ.eval U) (Equiv.apply_symm_apply L.unitHomEquiv σ))

/-- `pullbackSectionHom` over an open contained in `f⁻¹U`: the restriction of the pullback of
`σ` over `U`. -/
theorem pullbackSectionHom_restrict (U : (Opens Z.carrier)ᵒᵖ) (W : (Opens X.carrier)ᵒᵖ)
    (g : (opensMap f).op.obj U ⟶ W) :
    (pullbackSectionHom f σ).val.app W (oneSec X W) =
      ((pullbackFunctor f).obj L).val.map g (pullbackUnit f L U (σ.eval U)) := by
  have hnat := PresheafOfModules.naturality_apply (pullbackSectionHom f σ).val g
    (oneSec X ((opensMap f).op.obj U))
  rw [pullbackSectionHom_oneSec] at hnat
  rw [← hnat]
  congr 1
  exact (map_one ((Stacks.RingedSpace.structureRingSheaf X).obj.map g).hom).symm

/-- The inverse right unitor sends `a` to `a ⊗ 1`. -/
private theorem rightUnitor_inv_apply_eq_tmul_oneSec
    (A : SheafOfModules.{u} (Stacks.RingedSpace.structureRingSheaf X))
    (W : (Opens X.carrier)ᵒᵖ) (a : A.val.obj W) :
    (ρ_ A).inv.val.app W a =
      tmul X A (𝟙_ (SheafOfModules.{u} (Stacks.RingedSpace.structureRingSheaf X))) W a
        (oneSec X W) := by
  have h := rightUnitor_hom_tmul (A := A) W a
    (1 : (Stacks.RingedSpace.structureRingSheaf X).obj.obj W)
  rw [one_smul] at h
  exact (congrArg ((ρ_ A).inv.val.app W) h).symm.trans
    (Stacks.SheafOfModules.inv_val_app_hom_val_app (ρ_ A) _ _)

/-- The inverse left unitor sends `b` to `1 ⊗ b`. -/
private theorem leftUnitor_inv_apply_eq_tmul_oneSec
    (B : SheafOfModules.{u} (Stacks.RingedSpace.structureRingSheaf X))
    (W : (Opens X.carrier)ᵒᵖ) (b : B.val.obj W) :
    (λ_ B).inv.val.app W b =
      tmul X (𝟙_ (SheafOfModules.{u} (Stacks.RingedSpace.structureRingSheaf X))) B W
        (oneSec X W) b := by
  have h := leftUnitor_hom_tmul (B := B) W
    (1 : (Stacks.RingedSpace.structureRingSheaf X).obj.obj W) b
  rw [one_smul] at h
  exact (congrArg ((λ_ B).inv.val.app W) h).symm.trans
    (Stacks.SheafOfModules.inv_val_app_hom_val_app (λ_ B) _ _)

include φ in
/-- **A tensor factorization pulls back to one.** If `e : N ⊗ L ≅ B` carries `x ⊗ σ` to `φ(x)`,
then on `f^*N` the morphism `x ↦ (f^*e)(c⁻¹(x ⊗ f^*σ))`, with `c` the comparison of Stacks
01CD, is `f^*φ`. -/
theorem pullback_tensorFactorization
    (he : ∀ (U : (Opens Z.carrier)ᵒᵖ) (x : N.val.obj U),
      e.hom.val.app U (tmul Z N L U x (σ.eval U)) = φ.val.app U x) :
    (ρ_ ((pullbackFunctor f).obj N)).inv ≫ ((pullbackFunctor f).obj N ◁ pullbackSectionHom f σ) ≫
        inv (pullbackTensorComparison f N L) ≫ (pullbackFunctor f).map e.hom =
      (pullbackFunctor f).map φ := by
  refine pullback_hom_ext f fun U x ↦ ?_
  rw [SheafOfModules.comp_val_app_apply, SheafOfModules.comp_val_app_apply,
    SheafOfModules.comp_val_app_apply, rightUnitor_inv_apply_eq_tmul_oneSec, whiskerLeft_tmul,
    pullbackSectionHom_oneSec,
    ← pullbackTensorComparison_pullbackUnit, inv_val_app_apply, pullbackUnit_naturality,
    pullbackUnit_naturality]
  exact congrArg (pullbackUnit f B U) (he U x)

/-- **The isomorphism `f^*L ≅ f^*B` of a trivialization `ν : 𝒪 ≅ f^*N`**:
`l ↦ (f^*e)(c⁻¹(ν(1) ⊗ l))`. -/
def pullbackTrivializationIso
    (ν : 𝟙_ (SheafOfModules.{u} (Stacks.RingedSpace.structureRingSheaf X)) ≅
      (pullbackFunctor f).obj N) :
    (pullbackFunctor f).obj L ≅ (pullbackFunctor f).obj B :=
  (λ_ ((pullbackFunctor f).obj L)).symm ≪≫ whiskerRightIso ν ((pullbackFunctor f).obj L) ≪≫
    (asIso (pullbackTensorComparison f N L)).symm ≪≫ (pullbackFunctor f).mapIso e

include φ in
/-- **The trivialization isomorphism carries the pulled-back section to `φ(ν(1))`.** -/
theorem pullbackTrivializationIso_hom_pullbackSectionHom
    (he : ∀ (U : (Opens Z.carrier)ᵒᵖ) (x : N.val.obj U),
      e.hom.val.app U (tmul Z N L U x (σ.eval U)) = φ.val.app U x)
    (ν : 𝟙_ (SheafOfModules.{u} (Stacks.RingedSpace.structureRingSheaf X)) ≅
      (pullbackFunctor f).obj N) (W : (Opens X.carrier)ᵒᵖ) :
    (pullbackTrivializationIso f e ν).hom.val.app W
        ((pullbackSectionHom f σ).val.app W (oneSec X W)) =
      ((pullbackFunctor f).map φ).val.app W (ν.hom.val.app W (oneSec X W)) := by
  have hT := congrArg (fun θ : (pullbackFunctor f).obj N ⟶ (pullbackFunctor f).obj B ↦
    θ.val.app W (ν.hom.val.app W (oneSec X W)))
    (pullback_tensorFactorization f e σ φ he)
  simp only at hT
  rw [← hT]
  simp only [pullbackTrivializationIso, Iso.trans_hom, Iso.symm_hom, whiskerRightIso_hom,
    asIso_inv, Functor.mapIso_hom]
  rw [SheafOfModules.comp_val_app_apply, SheafOfModules.comp_val_app_apply,
    SheafOfModules.comp_val_app_apply, leftUnitor_inv_apply_eq_tmul_oneSec, whiskerRight_tmul,
    SheafOfModules.comp_val_app_apply, SheafOfModules.comp_val_app_apply,
    SheafOfModules.comp_val_app_apply, rightUnitor_inv_apply_eq_tmul_oneSec, whiskerLeft_tmul]

end Pullback

/-! ### The zero scheme of the section, locally -/

section ZeroScheme

attribute [local instance] Stacks.PullbackGradedAlgebra.monoidalCategory

open Stacks.PullbackTensorCoherence Stacks.RingedSpace RingedSpaceModuleAdjunction
open MonoidalCategory

variable {Y : Scheme.{u}} (N B : Y.Modules)
  [AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property N]
  [AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property B]
  (φ : N ⟶ B)

/-- **The zero scheme of the section attached to `φ`, pulled back along a trivialization.** For
`j : V ⟶ Y` and an isomorphism `ν : 𝒪_V ≅ j^*𝒩`, the inverse image along `j` of the zero scheme
of `σ` is the zero scheme of `(j^*φ)(ν(1))`. -/
theorem comap_zeroScheme_homSection_of_iso {V : Scheme.{u}} (j : V ⟶ Y)
    (ν : 𝟙_ (SheafOfModules.{u} (Stacks.RingedSpace.structureRingSheaf V.toRingedSpace)) ≅
      (Scheme.Modules.pullback j).obj N) :
    (Stacks.Divisors.zeroScheme Y (homSectionModule N B φ)
        ((homSection N B φ).eval (op ⊤))).comap j =
      Stacks.Divisors.zeroScheme V ((Scheme.Modules.pullback j).obj B)
        (Scheme.Modules.Hom.app ((Scheme.Modules.pullback j).map φ) ⊤
          (ν.hom.val.app (op ⊤) (oneSec V.toRingedSpace (op ⊤)))) := by
  set f : V.toRingedSpace ⟶ Y.toRingedSpace := j.toLRSHom.toShHom
  set L := homSectionModule N B φ
  set σ := homSection N B φ
  rw [← Stacks.Divisors.zeroScheme_pullback j L (σ.eval (op ⊤))]
  refine AlgebraicGeometry.zeroScheme_eq_of_iso
    (pullbackTrivializationIso f (homSectionTensorIso N B φ) ν) ?_
  have h := pullbackTrivializationIso_hom_pullbackSectionHom f (homSectionTensorIso N B φ) σ φ
    (homSectionTensorIso_hom_toTensorSheafSection N B φ) ν (op ⊤)
  refine Eq.trans ?_ h
  refine congrArg (fun z ↦
    ((pullbackTrivializationIso f (homSectionTensorIso N B φ) ν).hom.val.app (op ⊤)) z) ?_
  exact (pullbackSectionHom_restrict f σ (op ⊤) (op ⊤) (eqToHom (by simp)).op).symm

/-- **The zero scheme of the section attached to `φ`, pulled back to where `j^*𝒩` is generated
by one global section.** For `j : V ⟶ Y` and a global section `n` of `j^*𝒩` of which every
section over every open is uniquely a multiple, the inverse image along `j` of the zero scheme of
`σ` is the zero scheme of `(j^*φ)(n)`. -/
theorem comap_zeroScheme_homSection {V : Scheme.{u}} (j : V ⟶ Y)
    (n : ((Scheme.Modules.pullback j).obj N).val.obj (op ⊤))
    (hn : ∀ W : Opens V.carrier, Function.Bijective fun c : V.toRingedSpace.presheaf.obj (op W) ↦
      c • (show SheafOfModules.{u} (structureSheafRing V.toRingedSpace) from
        (Scheme.Modules.pullback j).obj N).val.map (homOfLE (le_top : W ≤ ⊤)).op n) :
    (Stacks.Divisors.zeroScheme Y (homSectionModule N B φ)
        ((homSection N B φ).eval (op ⊤))).comap j =
      Stacks.Divisors.zeroScheme V ((Scheme.Modules.pullback j).obj B)
        (Scheme.Modules.Hom.app ((Scheme.Modules.pullback j).map φ) ⊤ n) := by
  rw [comap_zeroScheme_homSection_of_iso N B φ j (unitIsoOfGenerator _ n hn)]
  congr 2
  exact unitIsoOfGenerator_hom_one _ n hn

/-- **The zero scheme of the section attached to `φ : π^*ℳ ⟶ ℬ`, pulled back along a morphism
into the part of `Y` over an open `U` on which `ℳ` is generated by `m₀`.** For `π : Y ⟶ X`,
`m₀` generating `ℳ` over `U ⊆ X` and `j : V ⟶ Y` landing in `π⁻¹(U)`, the inverse image along
`j` of the zero scheme of `σ` is the zero scheme of `(j^*φ)(n)`, where `n` is `m₀` pulled back
along `π` and then along `j`. The pulled-back sections generate by
`Stacks.SheafOfModules.pullbackGenerator`. -/
theorem comap_zeroScheme_homSection_of_generator {X V : Scheme.{u}} (π : Y ⟶ X)
    (M : X.Modules)
    [hM : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property M]
    (U : X.Opens) (m₀ : Stacks.SheafOfModules.GeneratorSections X.toRingedSpace M U)
    (j : V ⟶ Y) (hj : ⊤ ≤ j ⁻¹ᵁ π ⁻¹ᵁ U)
    (φ : (Scheme.Modules.pullback π).obj M ⟶ B) :
    letI := Stacks.Chow.isInvertible_presheaf_modulePullback M π
    (Stacks.Divisors.zeroScheme Y (homSectionModule ((Scheme.Modules.pullback π).obj M) B φ)
        ((homSection ((Scheme.Modules.pullback π).obj M) B φ).eval (op ⊤))).comap j =
      Stacks.Divisors.zeroScheme V ((Scheme.Modules.pullback j).obj B)
        (Scheme.Modules.Hom.app ((Scheme.Modules.pullback j).map φ) ⊤
          (((Scheme.Modules.pullback j).obj ((Scheme.Modules.pullback π).obj M)).val.map
            (homOfLE hj).op
            (Stacks.AlgebraicGeometry.RelativeProjDegreeOne.unitSection j
              ((Scheme.Modules.pullback π).obj M) (π ⁻¹ᵁ U)
              (Stacks.AlgebraicGeometry.RelativeProjDegreeOne.unitSection π M U m₀.val)))) := by
  let := Stacks.Chow.isInvertible_presheaf_modulePullback M π
  have hM' : Stacks.SheafOfModules.IsInvertible X.presheaf
      (_root_.structureSheafRing X.toRingedSpace).property M :=
    Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ M hM
  have hN' : Stacks.SheafOfModules.IsInvertible Y.presheaf
      (_root_.structureSheafRing Y.toRingedSpace).property ((Scheme.Modules.pullback π).obj M) :=
    Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _
      (Stacks.Chow.isInvertible_presheaf_modulePullback M π)
  let s₁ := Stacks.SheafOfModules.pullbackGenerator π M hM' U m₀
  let s₂ := Stacks.SheafOfModules.pullbackGenerator j ((Scheme.Modules.pullback π).obj M) hN'
    (π ⁻¹ᵁ U) s₁
  let s₃ := Stacks.SheafOfModules.generatorRestrict _ hj s₂
  exact comap_zeroScheme_homSection ((Scheme.Modules.pullback π).obj M) B φ j s₃.val
    fun W ↦ s₃.property W le_top

end ZeroScheme

end Stacks.Chow.GenuineChern

end
