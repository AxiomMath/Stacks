module

public import StacksFrontier.AlgebraicGeometry.SymSectionsBaseChange.SectionRing
public import StacksFrontier.AlgebraicGeometry.SheafSymmetricAlgebra.Functoriality
public import StacksFrontier.AlgebraicGeometry.ProjBundleSurjection.Chart
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.ProjHyperplane

/-!
# The homomorphism `Sym(u)` on the sections over an affine open

Let `u : ℰ₁ ⟶ ℰ₂` be a morphism of quasi-coherent modules on a scheme `X` and `V` an affine open
of `X`. The graded rings of sections `Γ(V, Sym ℰᵢ)` are the symmetric algebras
`Sym_{Γ(X, V)}(Γ(ℰᵢ, V))` (`Stacks.SymGraded.AffinePieces.symSectionRingEquiv`). This file proves
that under these identifications the homomorphism of sections induced by
`Stacks.SymGraded.schemeSheafGradedAlgebraHom u` is `Sym(Γ(u))`.

If over `V` the sections form a split exact sequence `0 ⟶ Γ(X, V) ⟶ Γ(ℰ₁, V) ⟶ Γ(ℰ₂, V) ⟶ 0`
with `1 ↦ t₀`, the kernel of `Γ(V, Sym ℰ₁) ⟶ Γ(V, Sym ℰ₂)` is generated by the degree-one
element attached to `t₀`, and that element is a nonzerodivisor.

## Main definitions

* `Stacks.SymGraded.AffinePieces.sectionsLinearMap`: the map of sections over `V` induced by
  `u`, as a `Γ(X, V)`-linear map.

## Main results

* `Stacks.SymGraded.AffinePieces.symSectionRingEquiv_sectionHom`: `Sym(u)` on sections.
* `Stacks.SymGraded.AffinePieces.ker_sectionHom_eq_span_of_split`: the kernel and the
  regularity of its generator.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace Opposite
open Stacks.AlgebraicGeometry.RelativeProjBridge Stacks.AlgebraicGeometry.RelativeProjMapDomain

universe u

namespace Stacks.SymGraded.AffinePieces

/-- `SymmetricAlgebra.mapₛₗ` along the identity is `SymPow.symAlgMap`. -/
theorem mapₛₗ_id_eq_symAlgMap {R : Type*} [CommRing R] {M N : Type*} [AddCommGroup M]
    [Module R M] [AddCommGroup N] [Module R N] (w : M →ₗ[R] N) (x : SymmetricAlgebra R M) :
    SymmetricAlgebra.mapₛₗ (RingHom.id R) w x = SymPow.symAlgMap w x := by
  have h : SymmetricAlgebra.mapₛₗ (RingHom.id R) w = (SymPow.symAlgMap w).toRingHom :=
    SymmetricAlgebra.ringHom_ext (fun r => by simp) (fun m => by
      simp [SymPow.symAlgMap_ι])
  exact congrArg (fun φ : SymmetricAlgebra R M →+* SymmetricAlgebra R N => φ x) h

variable {X : Scheme.{u}} {E₁ E₂ : X.Modules} (u : E₁ ⟶ E₂) [E₁.IsQuasicoherent]
  [E₂.IsQuasicoherent] (hqc₁ : IsQuasicoherentPieces E₁) (hqc₂ : IsQuasicoherentPieces E₂)
  {V : X.Opens} (hV : IsAffineOpen V)

/-- The map of sections over `V` induced by `u`, as a `Γ(X, V)`-linear map. -/
def sectionsLinearMap (V : X.Opens) : Γ(E₁, V) →ₗ[Γ(X, V)] Γ(E₂, V) where
  toFun x := u.app V x
  map_add' := map_add _
  map_smul' r x := Scheme.Modules.Hom.app_smul u r x

omit [E₁.IsQuasicoherent] [E₂.IsQuasicoherent] in
/-- `sectionsLinearMap u V` sends a section `x` over `V` to `u.app V x`. -/
theorem sectionsLinearMap_apply (V : X.Opens) (x : Γ(E₁, V)) :
    sectionsLinearMap u V x = u.app V x := rfl

/-- The homomorphism of degree-`n` sections induced by `u` is `Symⁿ(Γ(u))`, read through the
sheafification unit. -/
theorem schemeSymAlgebraHom_app_pieceSectionsEquiv (n : ℤ)
    (y : gradedPiece (R := Γ(X, V)) Γ(E₁, V) n) :
    ((schemeSymAlgebraHom u).app n).val.app (op V) (pieceSectionsEquiv E₁ hV n y) =
      pieceSectionsEquiv E₂ hV n
        (gradedMapₛₗ n (RingHom.id Γ(X, V)) (sectionsLinearMap u V) y) := by
  rw [pieceSectionsEquiv_apply, pieceSectionsEquiv_apply, schemeSymAlgebraHom_app]
  exact PresheafOfModules.unit_naturality_apply (R := X.ringCatSheaf)
    (α := 𝟙 X.ringCatSheaf.obj) (siteGradedPieceMap u.val n) (op V) y

/-- `Sym(u)` on a homogeneous section over an affine open. -/
theorem symSectionRingEquiv_sectionHom_of (n : ℕ)
    (a : (schemeSheafGradedAlgebra E₁ hqc₁).sectionPieces V n) :
    symSectionRingEquiv E₂ hV hqc₂ ((schemeSheafGradedAlgebraHom u hqc₁ hqc₂).sectionHom V
        (DirectSum.of ((schemeSheafGradedAlgebra E₁ hqc₁).sectionPieces V) n a)) =
      SymPow.symAlgMap (sectionsLinearMap u V) (symSectionRingEquiv E₁ hV hqc₁
        (DirectSum.of ((schemeSheafGradedAlgebra E₁ hqc₁).sectionPieces V) n a)) := by
  rw [SheafGradedAlgebraHom.sectionHom_of, symSectionRingEquiv_of, symSectionRingEquiv_of,
    SheafGradedAlgebraHom.sectionPieceHom_apply]
  have key : ∀ y : gradedPiece (R := Γ(X, V)) Γ(E₁, V) (n : ℤ),
      ((pieceSectionsEquiv E₂ hV (n : ℤ)).symm (((schemeSymAlgebraHom u).app (n : ℤ)).val.app
          (op V) (pieceSectionsEquiv E₁ hV (n : ℤ) y)) : SymmetricAlgebra Γ(X, V) Γ(E₂, V)) =
        SymPow.symAlgMap (sectionsLinearMap u V) (y : SymmetricAlgebra Γ(X, V) Γ(E₁, V)) := by
    intro y
    rw [schemeSymAlgebraHom_app_pieceSectionsEquiv, AddEquiv.symm_apply_apply, gradedMapₛₗ_coe,
      mapₛₗ_id_eq_symAlgMap]
  have h := key ((pieceSectionsEquiv E₁ hV (n : ℤ)).symm a)
  have h2 : pieceSectionsEquiv E₁ hV (n : ℤ) ((pieceSectionsEquiv E₁ hV (n : ℤ)).symm a) = a :=
    AddEquiv.apply_symm_apply _ a
  exact (congrArg (fun z => ((pieceSectionsEquiv E₂ hV (n : ℤ)).symm
    (((schemeSymAlgebraHom u).app (n : ℤ)).val.app (op V) z) :
      SymmetricAlgebra Γ(X, V) Γ(E₂, V))) h2).symm.trans h

/-- **`Sym(u)` on the sections over an affine open is `Sym(Γ(u))`.** -/
theorem symSectionRingEquiv_sectionHom
    (x : (schemeSheafGradedAlgebra E₁ hqc₁).sectionRing V) :
    symSectionRingEquiv E₂ hV hqc₂ ((schemeSheafGradedAlgebraHom u hqc₁ hqc₂).sectionHom V x) =
      SymPow.symAlgMap (sectionsLinearMap u V) (symSectionRingEquiv E₁ hV hqc₁ x) := by
  induction x using DirectSum.induction_on with
  | zero => simp only [map_zero]
  | of n a => exact symSectionRingEquiv_sectionHom_of u hqc₁ hqc₂ hV n a
  | add x y hx hy => simp only [map_add, hx, hy]

/-- **The kernel of `Sym(u)` on the sections over an affine open, for a split extension by a
free module of rank one.** If over `V` the section `t₀` of `ℰ₁` spans the kernel of `Γ(u)`,
`Γ(u)` is surjective and a linear functional takes the value `1` on `t₀`, then the kernel of
`Γ(V, Sym ℰ₁) ⟶ Γ(V, Sym ℰ₂)` is generated by the degree-one element `t` attached to `t₀`, and
`t` is a nonzerodivisor. -/
theorem ker_sectionHom_eq_span_of_split (t₀ : Γ(E₁, V))
    (hsurj : Function.Surjective (sectionsLinearMap u V))
    (hexact : LinearMap.ker (sectionsLinearMap u V) = Submodule.span Γ(X, V) {t₀})
    (l : Γ(E₁, V) →ₗ[Γ(X, V)] Γ(X, V)) (hl : l t₀ = 1) :
    RingHom.ker ((schemeSheafGradedAlgebraHom u hqc₁ hqc₂).sectionHom V :
        (schemeSheafGradedAlgebra E₁ hqc₁).sectionRing V →+*
          (schemeSheafGradedAlgebra E₂ hqc₂).sectionRing V) =
      Ideal.span {(symSectionRingEquiv E₁ hV hqc₁).symm (SymmetricAlgebra.ι _ _ t₀)} ∧
      IsRegular ((symSectionRingEquiv E₁ hV hqc₁).symm (SymmetricAlgebra.ι _ _ t₀)) ∧
      (symSectionRingEquiv E₁ hV hqc₁).symm (SymmetricAlgebra.ι _ _ t₀) ∈
        (schemeSheafGradedAlgebra E₁ hqc₁).grading V 1 := by
  set e₁ := symSectionRingEquiv E₁ hV hqc₁
  set e₂ := symSectionRingEquiv E₂ hV hqc₂
  set i : Γ(X, V) →ₗ[Γ(X, V)] Γ(E₁, V) := LinearMap.toSpanSingleton _ _ t₀ with hi
  have hi1 : i 1 = t₀ := by simp [hi]
  have hrange : LinearMap.range i = LinearMap.ker (sectionsLinearMap u V) := by
    rw [hexact, hi, LinearMap.span_singleton_eq_range]
  have hinj : Function.Injective i := by
    refine (injective_iff_map_eq_zero i).2 fun r hr => ?_
    simpa [hi, hl] using congrArg l hr
  obtain ⟨hker, hreg⟩ := Stacks.Chow.GenuineChern.ker_symAlgMap_eq_span_singleton_of_exact'
    i (sectionsLinearMap u V) hinj hsurj hrange l (by rw [hi1, hl])
  rw [hi1] at hker hreg
  refine ⟨?_, ?_, ?_⟩
  · have hcomp : ∀ x, ((schemeSheafGradedAlgebraHom u hqc₁ hqc₂).sectionHom V) x =
        e₂.symm (SymPow.symAlgMap (sectionsLinearMap u V) (e₁ x)) := fun x => by
      rw [← symSectionRingEquiv_sectionHom, RingEquiv.symm_apply_apply]
    ext x
    rw [RingHom.mem_ker]
    show ((schemeSheafGradedAlgebraHom u hqc₁ hqc₂).sectionHom V) x = 0 ↔ _
    rw [hcomp, map_eq_zero_iff _ e₂.symm.injective, ← RingHom.mem_ker, hker,
      Ideal.mem_span_singleton', Ideal.mem_span_singleton', e₁.symm.surjective.exists]
    simp only [← map_mul, RingEquiv.symm_apply_eq]
  · exact Stacks.Chow.GenuineChern.isRegular_ringEquiv e₁.symm hreg
  · rw [← mem_symmetricPower_symSectionRingEquiv E₁ hV hqc₁ 1, RingEquiv.apply_symm_apply]
    show _ ∈ LinearMap.range (SymmetricAlgebra.ι Γ(X, V) Γ(E₁, V)) ^ 1
    rw [pow_one]
    exact LinearMap.mem_range_self _ t₀

end Stacks.SymGraded.AffinePieces

end
