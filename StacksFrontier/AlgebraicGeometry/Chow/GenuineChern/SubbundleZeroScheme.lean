module

public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.HomSection
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.ChartTautological
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.RelativeHyperplane
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.SplitSections
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.TwistPullback
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.SymGenSections
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.BundleEmbedding
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.Datum
public import StacksFrontier.AlgebraicGeometry.Divisors.RegularSectionCorrespondence
public import StacksFrontier.AlgebraicGeometry.SymGenDegreeOne.Basic

/-!
# The sub-bundle `𝐏(𝒬) ⊂ 𝐏(𝒢)` as the zero scheme of a section

Let `f : ℳ ⟶ 𝒢` be a morphism from an invertible module to a quasi-coherent one on a scheme `X`,
and `π : 𝐏(𝒢) ⟶ X` the projective bundle with its tautological map `τ : π^*𝒢 ⟶ 𝒪(1)`. The
composite `π^*f ≫ τ : π^*ℳ ⟶ 𝒪(1)` is a global section `s` of the invertible module
`ℒ = 𝒪(1) ⊗ π^*ℳ^{-1}` (`Stacks.Chow.GenuineChern.homSection`). This file computes the zero
scheme of `s` on the standard charts of `𝐏(𝒢)`: over an affine open `V` of `X` on which `ℳ` is
generated by `m₀`, it is the zero scheme of the global section of `𝒪(1)` on
`Proj Γ(V, Sym 𝒢)` attached to the degree-one element `f(m₀)`.

## Main results

* `Stacks.Chow.GenuineChern.comap_chart_zeroScheme_bundleSection`.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace Opposite
open AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.SymGraded Stacks.AlgebraicGeometry.RelativeProj
open Stacks.AlgebraicGeometry.RelativeProjDegreeOne

universe u

namespace Stacks.Chow.GenuineChern

section Restrict

variable {X Y : Scheme.{u}}

/-- **Restriction to an open immersion, read on pulled-back sections**: the comparison of
`Scheme.Modules.restrictFunctorIsoPullback` carries the pulled-back section to the restriction of
the section. -/
theorem restrictFunctorIsoPullback_inv_unitSection' (c : X ⟶ Y) [IsOpenImmersion c]
    (M : Y.Modules) (V : Y.Opens) (s : Γ(M, V)) :
    ((Scheme.Modules.restrictFunctorIsoPullback c).inv.app M).val.app (op (c ⁻¹ᵁ V))
        (unitSection c M V s) =
      M.val.map (homOfLE (c.image_preimage_le V)).op s := by
  have h := Adjunction.unit_leftAdjointUniq_hom_app (Scheme.Modules.restrictAdjunction c)
    (Scheme.Modules.pullbackPushforwardAdjunction c) M
  have h' : (Scheme.Modules.pullbackPushforwardAdjunction c).unit.app M ≫
      (Scheme.Modules.pushforward c).map
        ((Scheme.Modules.restrictFunctorIsoPullback c).inv.app M) =
      (Scheme.Modules.restrictAdjunction c).unit.app M := by
    rw [← h, Category.assoc, ← Functor.map_comp]
    change _ ≫ (Scheme.Modules.pushforward c).map
      (((Scheme.Modules.restrictFunctorIsoPullback c).hom ≫
        (Scheme.Modules.restrictFunctorIsoPullback c).inv).app M) = _
    rw [Iso.hom_inv_id]
    exact (congrArg (fun k => _ ≫ k) (CategoryTheory.Functor.map_id _ _)).trans
      (Category.comp_id _)
  exact congrArg (fun ρ : M ⟶ (Scheme.Modules.pushforward c).obj
    ((Scheme.Modules.restrictFunctor c).obj M) => ρ.val.app (op V) s) h'

/-- The restriction maps of a restriction along an open immersion. -/
alias restrict_map_apply' := Stacks.Chow.GenuineChern.restrict_map_apply

/-- Two restrictions of a section compose to one. -/
alias map_map_homOfLE' := Stacks.Chow.GenuineChern.map_map_homOfLE

end Restrict

section Chart

variable {X : Scheme.{u}} (G : X.Modules) [G.IsQuasicoherent] (hqc : IsQuasicoherentPieces G)
  (M : X.Modules)
  [hM : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property M]
  (f : M ⟶ G)

/-- The pulled-back module `π^*ℳ` on the projective bundle is invertible. -/
instance isInvertible_pullback_bundle :
    AlgebraicGeometry.SheafOfModules.IsInvertible
      (relativeProj (schemeSheafGradedAlgebra G hqc)).scheme.sheaf.obj
      (relativeProj (schemeSheafGradedAlgebra G hqc)).scheme.ringCatSheaf.property
      ((Scheme.Modules.pullback (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase).obj M) :=
  Stacks.Chow.isInvertible_presheaf_modulePullback M _

/-- The twist `𝒪(1)` of the projective bundle is invertible. -/
instance isInvertible_tautologicalTwist' :
    AlgebraicGeometry.SheafOfModules.IsInvertible
      (relativeProj (schemeSheafGradedAlgebra G hqc)).scheme.sheaf.obj
      (relativeProj (schemeSheafGradedAlgebra G hqc)).scheme.ringCatSheaf.property
      (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc) :=
  Stacks.ProjectiveBundleSplitting.isInvertible_tautologicalTwist G hqc

/-- **The morphism `π^*ℳ ⟶ 𝒪(1)`**: the pullback of `f` followed by the tautological map. -/
def bundleSectionHom :
    (Scheme.Modules.pullback (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase).obj M ⟶
      Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc :=
  (Scheme.Modules.pullback _).map f ≫ Stacks.ProjectiveBundleSplitting.tautologicalMap G hqc

omit [SheafOfModules.IsQuasicoherent G] in
/-- The chart over an affine open `V` lands in the inverse image of `V`. -/
theorem top_le_chart_preimage (V : X.Opens) (hV : IsAffineOpen V) :
    ⊤ ≤ (relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV ⁻¹ᵁ
      (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase ⁻¹ᵁ V := by
  intro x _
  change ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV ≫
    (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase) x ∈ V
  rw [Stacks.AlgebraicGeometry.RelativeProjMapDomain.chart_comp_toBase]
  exact (projInclusionToOpen (schemeSheafGradedAlgebra G hqc) V hV x).2

omit [SheafOfModules.IsQuasicoherent G] hM in
/-- The value of `π^*f ≫ τ` on the pulled-back generator, on a chart: through the chart
identification of `𝒪(1)` it is the global section attached to the degree-one element `f(m₀)`. -/
theorem chartIso_bundleSectionHom_unitSection (V : X.Opens) (hV : IsAffineOpen V)
    (m : Γ(M, V)) :
    letI := Stacks.AlgebraicGeometry.RelativeProjTwistGlue.isOpenImmersion_chart
      (relativeProj (schemeSheafGradedAlgebra G hqc)) V hV
    Scheme.Modules.Hom.app ((((Scheme.Modules.restrictFunctorIsoPullback
        ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).app
          (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)).symm ≪≫
        (projectiveBundleTwistData G hqc).chartData.chartIso V hV ((1 : ℕ) : ℤ)).hom) ⊤
      (Scheme.Modules.Hom.app ((Scheme.Modules.pullback
          ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).map
          (bundleSectionHom G hqc M f)) ⊤
        (((Scheme.Modules.pullback ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).obj
          ((Scheme.Modules.pullback (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase).obj
            M)).val.map (homOfLE (top_le_chart_preimage G hqc V hV)).op
          (unitSection ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)
            ((Scheme.Modules.pullback (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase).obj
              M)
            ((relativeProj (schemeSheafGradedAlgebra G hqc)).toBase ⁻¹ᵁ V)
            (unitSection (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase M V m)))) =
      degreeSection
        ((schemeSheafGradedAlgebra G hqc).grading V) 1
        ⟨DirectSum.of ((schemeSheafGradedAlgebra G hqc).sectionPieces V) 1
          ((Scheme.Modules.symmetricAlgebraGen X G).val.app (op V) (f.val.app (op V) m)),
          (schemeSheafGradedAlgebra G hqc).of_mem_grading V _⟩ := by
  let := Stacks.AlgebraicGeometry.RelativeProjTwistGlue.isOpenImmersion_chart
    (relativeProj (schemeSheafGradedAlgebra G hqc)) V hV
  have hle : (relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV ''ᵁ ⊤ ≤
      (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase ⁻¹ᵁ V := by
    rintro _ ⟨y, -, rfl⟩
    exact top_le_chart_preimage G hqc V hV trivial
  have e1 := PresheafOfModules.naturality_apply ((Scheme.Modules.pullback
      ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).map
      (bundleSectionHom G hqc M f)).val (homOfLE (top_le_chart_preimage G hqc V hV)).op
    (unitSection ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)
      ((Scheme.Modules.pullback (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase).obj M)
      ((relativeProj (schemeSheafGradedAlgebra G hqc)).toBase ⁻¹ᵁ V)
      (unitSection (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase M V m))
  have e2 := unitSection_pullback_map ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)
    (bundleSectionHom G hqc M f) ((relativeProj (schemeSheafGradedAlgebra G hqc)).toBase ⁻¹ᵁ V)
    (unitSection (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase M V m)
  have e3 : (bundleSectionHom G hqc M f).val.app
      (op ((relativeProj (schemeSheafGradedAlgebra G hqc)).toBase ⁻¹ᵁ V))
      (unitSection (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase M V m) =
      ((projectiveBundleTwistData G hqc).ψ 1).val.app (op V)
        ((Scheme.Modules.symmetricAlgebraGen X G).val.app (op V) (f.val.app (op V) m)) :=
    (congrArg (fun w => (Stacks.ProjectiveBundleSplitting.tautologicalMap G hqc).val.app
        (op ((relativeProj (schemeSheafGradedAlgebra G hqc)).toBase ⁻¹ᵁ V)) w)
      (unitSection_pullback_map (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase f V m)).trans
      (tautologicalMap_unitSection G hqc V _)
  have e4 := fun z => (PresheafOfModules.naturality_apply
      ((Scheme.Modules.restrictFunctorIsoPullback
        ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).inv.app
          (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)).val
      (homOfLE (top_le_chart_preimage G hqc V hV)).op
      (unitSection ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)
        (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)
        ((relativeProj (schemeSheafGradedAlgebra G hqc)).toBase ⁻¹ᵁ V) z)).trans
    (congrArg _ (restrictFunctorIsoPullback_inv_unitSection'
      ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)
      (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)
      ((relativeProj (schemeSheafGradedAlgebra G hqc)).toBase ⁻¹ᵁ V) z))
  have e5 := chartIso_inv_degreeSection (E := G) (hqc := hqc) V hV
    ((Scheme.Modules.symmetricAlgebraGen X G).val.app (op V) (f.val.app (op V) m)) hle
  have e4' : ∀ z, ((Scheme.Modules.restrictFunctorIsoPullback
        ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).inv.app
          (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)).val.app (op ⊤)
      (((Scheme.Modules.pullback ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).obj
          (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)).val.map
        (homOfLE (top_le_chart_preimage G hqc V hV)).op
        (unitSection ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)
          (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)
          ((relativeProj (schemeSheafGradedAlgebra G hqc)).toBase ⁻¹ᵁ V) z)) =
      (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc).val.map (homOfLE hle).op z :=
    fun z => (e4 z).trans ((restrict_map_apply' _ _ (top_le_chart_preimage G hqc V hV) _).trans
      (map_map_homOfLE' _ _ _ z))
  have hinv := congrArg (fun ψ => ψ.val.app (op ⊤)
      (degreeSection
        ((schemeSheafGradedAlgebra G hqc).grading V) 1
        ⟨DirectSum.of ((schemeSheafGradedAlgebra G hqc).sectionPieces V) 1
          ((Scheme.Modules.symmetricAlgebraGen X G).val.app (op V) (f.val.app (op V) m)),
          (schemeSheafGradedAlgebra G hqc).of_mem_grading V _⟩))
    ((projectiveBundleTwistData G hqc).chartData.chartIso V hV ((1 : ℕ) : ℤ)).inv_hom_id
  have key : ((projectiveBundleTwistData G hqc).chartData.chartIso V hV ((1 : ℕ) : ℤ)).hom.val.app
      (op ⊤) (((Scheme.Modules.restrictFunctorIsoPullback
        ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).inv.app
          (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)).val.app (op ⊤)
        (((Scheme.Modules.pullback ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).map
          (bundleSectionHom G hqc M f)).val.app (op ⊤)
          (((Scheme.Modules.pullback
              ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).obj
            ((Scheme.Modules.pullback (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase).obj
              M)).val.map (homOfLE (top_le_chart_preimage G hqc V hV)).op
            (unitSection ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)
              ((Scheme.Modules.pullback (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase).obj
                M)
              ((relativeProj (schemeSheafGradedAlgebra G hqc)).toBase ⁻¹ᵁ V)
              (unitSection (relativeProj (schemeSheafGradedAlgebra G hqc)).toBase M V m))))) =
      degreeSection
        ((schemeSheafGradedAlgebra G hqc).grading V) 1
        ⟨DirectSum.of ((schemeSheafGradedAlgebra G hqc).sectionPieces V) 1
          ((Scheme.Modules.symmetricAlgebraGen X G).val.app (op V) (f.val.app (op V) m)),
          (schemeSheafGradedAlgebra G hqc).of_mem_grading V _⟩ := by
    refine (congrArg (fun w => ((projectiveBundleTwistData G hqc).chartData.chartIso V hV
          ((1 : ℕ) : ℤ)).hom.val.app (op ⊤)
        (((Scheme.Modules.restrictFunctorIsoPullback
              ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).inv.app
            (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)).val.app (op ⊤) w))
      e1).trans ?_
    refine (congrArg (fun w => ((projectiveBundleTwistData G hqc).chartData.chartIso V hV
          ((1 : ℕ) : ℤ)).hom.val.app (op ⊤)
        (((Scheme.Modules.restrictFunctorIsoPullback
              ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).inv.app
            (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)).val.app (op ⊤)
          (((Scheme.Modules.pullback
                ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).obj
              (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)).val.map
            (homOfLE (top_le_chart_preimage G hqc V hV)).op w)))
      e2).trans ?_
    refine (congrArg (fun w => ((projectiveBundleTwistData G hqc).chartData.chartIso V hV
          ((1 : ℕ) : ℤ)).hom.val.app (op ⊤)
        (((Scheme.Modules.restrictFunctorIsoPullback
              ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).inv.app
            (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)).val.app (op ⊤)
          (((Scheme.Modules.pullback
                ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)).obj
              (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)).val.map
            (homOfLE (top_le_chart_preimage G hqc V hV)).op
            (unitSection ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV)
              (Stacks.ProjectiveBundleSplitting.tautologicalTwist G hqc)
              ((relativeProj (schemeSheafGradedAlgebra G hqc)).toBase ⁻¹ᵁ V) w))))
      e3).trans ?_
    refine (congrArg (fun w => ((projectiveBundleTwistData G hqc).chartData.chartIso V hV
      ((1 : ℕ) : ℤ)).hom.val.app (op ⊤) w) (e4' _)).trans ?_
    refine (congrArg (fun w => ((projectiveBundleTwistData G hqc).chartData.chartIso V hV
      ((1 : ℕ) : ℤ)).hom.val.app (op ⊤) w) e5.symm).trans ?_
    exact hinv
  exact key

/-- **The zero scheme of `π^*f ≫ τ` on a chart.** Over an affine open `V` of the base on which
`ℳ` is generated by `m₀`, the inverse image along the chart `Proj Γ(V, Sym 𝒢) ⟶ 𝐏(𝒢)` of the
zero scheme of the section of `ℒ` attached to `π^*f ≫ τ` is the zero scheme of the global section
of `𝒪(1)` attached to the degree-one element `f(m₀)` of `Γ(V, Sym 𝒢)`. -/
theorem comap_chart_zeroScheme_bundleSection (V : X.Opens) (hV : IsAffineOpen V)
    (m₀ : Stacks.SheafOfModules.GeneratorSections X.toRingedSpace M V) :
    letI := Stacks.AlgebraicGeometry.RelativeProjTwistGlue.isOpenImmersion_chart
      (relativeProj (schemeSheafGradedAlgebra G hqc)) V hV
    haveI := algebraicGeometry_isInvertible_twistingSheaf
      ((schemeSheafGradedAlgebra G hqc).grading V) (adjoin_grading_one_eq_top G V hqc hV)
      ((1 : ℕ) : ℤ)
    (Stacks.Divisors.zeroScheme _ (homSectionModule _ _ (bundleSectionHom G hqc M f))
        ((homSection _ _ (bundleSectionHom G hqc M f)).eval (op ⊤))).comap
        ((relativeProj (schemeSheafGradedAlgebra G hqc)).chart V hV) =
      Stacks.Divisors.zeroScheme (Proj ((schemeSheafGradedAlgebra G hqc).grading V))
        (twistingSheafModule ((schemeSheafGradedAlgebra G hqc).grading V) ((1 : ℕ) : ℤ))
        (degreeSection
          ((schemeSheafGradedAlgebra G hqc).grading V) 1
          ⟨DirectSum.of ((schemeSheafGradedAlgebra G hqc).sectionPieces V) 1
            ((Scheme.Modules.symmetricAlgebraGen X G).val.app (op V)
              (f.val.app (op V) m₀.val)),
            (schemeSheafGradedAlgebra G hqc).of_mem_grading V _⟩) := by
  let := Stacks.AlgebraicGeometry.RelativeProjTwistGlue.isOpenImmersion_chart
    (relativeProj (schemeSheafGradedAlgebra G hqc)) V hV
  have := algebraicGeometry_isInvertible_twistingSheaf
    ((schemeSheafGradedAlgebra G hqc).grading V) (adjoin_grading_one_eq_top G V hqc hV)
    ((1 : ℕ) : ℤ)
  rw [comap_zeroScheme_homSection_of_generator (Stacks.ProjectiveBundleSplitting.tautologicalTwist
    G hqc) _ M V m₀ _ (top_le_chart_preimage G hqc V hV) (bundleSectionHom G hqc M f)]
  exact AlgebraicGeometry.zeroScheme_eq_of_iso _
    (chartIso_bundleSectionHom_unitSection G hqc M f V hV m₀.val)

end Chart

section Subbundle

variable {X : Scheme.{u}} (S : ShortComplex X.Modules) (hS : S.ShortExact)
  [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property S.X₁]
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} S.X₂]
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} S.X₃]

include hS in
/-- **`𝐏(𝒬) ⊂ 𝐏(𝒢)` is the zero scheme of `π^*f ≫ τ`.** For `0 ⟶ ℳ ⟶ 𝒢 ⟶ 𝒬 ⟶ 0` short exact
with `ℳ` invertible and `𝒢`, `𝒬` finite locally free, the zero scheme of the section of
`ℒ = 𝒪(1) ⊗ π^*ℳ^{-1}` attached to `π^*f ≫ τ : π^*ℳ ⟶ 𝒪(1)` is the closed subscheme cut out by
`Stacks.Chow.GenuineChern.bundleEmbedding`, and it is an effective Cartier divisor: over a small
affine open `V` of `X` on which `ℳ` is generated by `m₀` and the sequence of sections splits, the
kernel of `Γ(V, Sym 𝒢) ⟶ Γ(V, Sym 𝒬)` is generated by the nonzerodivisor `f(m₀)` of degree one,
and on the chart over `V` the zero scheme is the hyperplane of `f(m₀)`. -/
theorem zeroScheme_bundleSection_eq_ker_bundleEmbedding :
    haveI : Epi S.g := hS.epi_g
    Stacks.Divisors.zeroScheme _
        (homSectionModule _ _ (bundleSectionHom S.X₂ (bundlePieces S.X₂) S.X₁ S.f))
        ((homSection _ _ (bundleSectionHom S.X₂ (bundlePieces S.X₂) S.X₁ S.f)).eval (op ⊤)) =
      (Stacks.AlgebraicGeometry.ProjBundleSurjection.map
        (surjectiveOnAffineSections_bundle S.g)).ker ∧
    Stacks.Divisors.IsEffectiveCartierDivisor
      (Stacks.Divisors.zeroScheme _
        (homSectionModule _ _ (bundleSectionHom S.X₂ (bundlePieces S.X₂) S.X₁ S.f))
        ((homSection _ _ (bundleSectionHom S.X₂ (bundlePieces S.X₂) S.X₁ S.f)).eval (op ⊤))) := by
  have : Epi S.g := hS.epi_g
  choose O hO hxO m₀ hsurj hexact l hl using exists_affine_split_sections S hS
  have hcov : ⨆ x, O x = ⊤ := eq_top_iff.2 fun x _ => Opens.mem_iSup.2 ⟨x, hxO x⟩
  have hgen := fun x => adjoin_grading_one_eq_top S.X₂ (O x) (bundlePieces S.X₂) (hO x)
  let t : ∀ x, (schemeSheafGradedAlgebra S.X₂ (bundlePieces S.X₂)).grading (O x) 1 := fun x =>
    ⟨DirectSum.of ((schemeSheafGradedAlgebra S.X₂ (bundlePieces S.X₂)).sectionPieces (O x)) 1
      ((Scheme.Modules.symmetricAlgebraGen X S.X₂).val.app (op (O x))
        (S.f.val.app (op (O x)) (m₀ x).val)),
      (schemeSheafGradedAlgebra S.X₂ (bundlePieces S.X₂)).of_mem_grading (O x) _⟩
  have hZ := fun x => comap_chart_zeroScheme_bundleSection S.X₂ (bundlePieces S.X₂) S.X₁ S.f
    (O x) (hO x) (m₀ x)
  have hsplit := fun x => Stacks.SymGraded.AffinePieces.ker_sectionHom_eq_span_of_split S.g
    (bundlePieces S.X₂) (bundlePieces S.X₃) (hO x) (S.f.app (O x) (m₀ x).val) (hsurj x)
    (hexact x) (l x) (hl x)
  have ht : ∀ x, (t x : (schemeSheafGradedAlgebra S.X₂ (bundlePieces S.X₂)).sectionRing (O x)) =
      (Stacks.SymGraded.AffinePieces.symSectionRingEquiv S.X₂ (hO x) (bundlePieces S.X₂)).symm
        (SymmetricAlgebra.ι _ _ (S.f.app (O x) (m₀ x).val)) := fun x =>
    (RingEquiv.eq_symm_apply _).2
      (Stacks.SymGraded.AffinePieces.symSectionRingEquiv_of_symmetricAlgebraGen S.X₂ (hO x)
        (bundlePieces S.X₂) _)
  refine ⟨zeroScheme_eq_ker_map_of_charts (surjectiveOnAffineSections_bundle S.g) O hO hcov hgen
    t _ _ hZ fun x => (ht x).symm ▸ (hsplit x).1, ?_⟩
  exact isEffectiveCartierDivisor_zeroScheme_of_charts O hO hcov hgen t _ _ hZ
    fun x => (ht x).symm ▸ (hsplit x).2.1

include hS in
/-- **`𝐏(𝒬) ⊂ 𝐏(𝒢)` as a relative effective Cartier divisor.** For `0 ⟶ ℳ ⟶ 𝒢 ⟶ 𝒬 ⟶ 0` short
exact with `ℳ` invertible, `𝒢` finite locally free and `𝒬` finite locally free of positive rank,
there are an invertible module `ℒ` on `𝐏(𝒢)` with `π^*ℳ ⊗ ℒ ≅ 𝒪_{𝐏(𝒢)}(1)` and a section `s` of
`ℒ` whose zero scheme is a relative effective Cartier divisor over `X`, identified with `𝐏(𝒬)`
over `𝐏(𝒢)` through `Stacks.Chow.GenuineChern.bundleEmbedding`. Here `ℒ` and `s` come from the
morphism `π^*f ≫ τ : π^*ℳ ⟶ 𝒪(1)`. -/
theorem exists_relativeEffectiveCartierDivisor_bundleEmbedding (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} S.X₃ (r + 1)] :
    haveI : Epi S.g := hS.epi_g
    ∃ (L : (bundle S.X₂).Modules)
      (hL : AlgebraicGeometry.SheafOfModules.IsInvertible (bundle S.X₂).sheaf.obj
        (bundle S.X₂).ringCatSheaf.property L) (s : L.sections),
      letI := hL
      Stacks.Divisors.IsRelativeEffectiveCartierDivisor (bundleProj S.X₂)
          (Stacks.Divisors.zeroScheme (bundle S.X₂) L (s.eval (.op ⊤))) ∧
        ∃ e : (Stacks.Divisors.zeroScheme (bundle S.X₂) L (s.eval (.op ⊤))).subscheme ≅
            bundle S.X₃,
          e.hom ≫ bundleEmbedding S.g =
              (Stacks.Divisors.zeroScheme (bundle S.X₂) L (s.eval (.op ⊤))).subschemeι ∧
            Nonempty (Scheme.Modules.tensorObj
              ((Scheme.Modules.pullback (bundleProj S.X₂)).obj S.X₁) L ≅ bundleTwist S.X₂) := by
  have : Epi S.g := hS.epi_g
  obtain ⟨hker, hD⟩ := zeroScheme_bundleSection_eq_ker_bundleEmbedding S hS
  have : AlgebraicGeometry.SheafOfModules.IsInvertible (bundle S.X₂).sheaf.obj
      (bundle S.X₂).ringCatSheaf.property
      ((Scheme.Modules.pullback
        (relativeProj (schemeSheafGradedAlgebra S.X₂ (bundlePieces S.X₂))).toBase).obj S.X₁) :=
    isInvertible_pullback_bundle S.X₂ (bundlePieces S.X₂) S.X₁
  have : AlgebraicGeometry.SheafOfModules.IsInvertible (bundle S.X₂).sheaf.obj
      (bundle S.X₂).ringCatSheaf.property
      (Stacks.ProjectiveBundleSplitting.tautologicalTwist S.X₂ (bundlePieces S.X₂)) :=
    isInvertible_tautologicalTwist' S.X₂ (bundlePieces S.X₂)
  have : AlgebraicGeometry.SheafOfModules.IsInvertible (bundle S.X₂).sheaf.obj
      (bundle S.X₂).ringCatSheaf.property
      (homSectionModule _ _ (bundleSectionHom S.X₂ (bundlePieces S.X₂) S.X₁ S.f)) :=
    isInvertible_homSectionModule _ _ _
  have := Stacks.AlgebraicGeometry.ProjBundleSurjection.isClosedImmersion_map
    (surjectiveOnAffineSections_bundle S.g)
  refine ⟨homSectionModule _ _ (bundleSectionHom S.X₂ (bundlePieces S.X₂) S.X₁ S.f),
    inferInstance, homSection _ _ (bundleSectionHom S.X₂ (bundlePieces S.X₂) S.X₁ S.f), ?_⟩
  have hker2 : (Stacks.Divisors.zeroScheme
        (relativeProj (schemeSheafGradedAlgebra S.X₂ (bundlePieces S.X₂))).scheme
        (homSectionModule _ _ (bundleSectionHom S.X₂ (bundlePieces S.X₂) S.X₁ S.f))
        ((homSection _ _
          (bundleSectionHom S.X₂ (bundlePieces S.X₂) S.X₁ S.f)).eval (op ⊤))).subschemeι.ker =
      (Stacks.AlgebraicGeometry.ProjBundleSurjection.map
        (surjectiveOnAffineSections_bundle S.g)).ker := by
    rw [Scheme.IdealSheafData.ker_subschemeι]
    exact hker
  have := IsClosedImmersion.isIso_lift _ _ hker2
  let φ := asIso (IsClosedImmersion.lift _ _ hker2.le)
  have hφ : φ.hom ≫ (Stacks.Divisors.zeroScheme
        (relativeProj (schemeSheafGradedAlgebra S.X₂ (bundlePieces S.X₂))).scheme
        (homSectionModule _ _ (bundleSectionHom S.X₂ (bundlePieces S.X₂) S.X₁ S.f))
        ((homSection _ _
          (bundleSectionHom S.X₂ (bundlePieces S.X₂) S.X₁ S.f)).eval (op ⊤))).subschemeι =
      (Stacks.AlgebraicGeometry.ProjBundleSurjection.map
        (surjectiveOnAffineSections_bundle S.g)) :=
    IsClosedImmersion.lift_fac _ _ _
  have he : φ.symm.hom ≫ (Stacks.AlgebraicGeometry.ProjBundleSurjection.map
        (surjectiveOnAffineSections_bundle S.g)) =
      (Stacks.Divisors.zeroScheme
        (relativeProj (schemeSheafGradedAlgebra S.X₂ (bundlePieces S.X₂))).scheme
        (homSectionModule _ _ (bundleSectionHom S.X₂ (bundlePieces S.X₂) S.X₁ S.f))
        ((homSection _ _
          (bundleSectionHom S.X₂ (bundlePieces S.X₂) S.X₁ S.f)).eval (op ⊤))).subschemeι := by
    rw [Iso.symm_hom, ← hφ]
    exact φ.inv_hom_id_assoc _
  have := flat_bundleProj S.X₃ r
  refine ⟨⟨hD, ?_⟩, φ.symm, he, ⟨homSectionTensorIso _ _ _⟩⟩
  have hflat : Flat (φ.symm.hom ≫ bundleProj S.X₃) :=
    @Flat.comp _ _ _ φ.symm.hom (bundleProj S.X₃) inferInstance (flat_bundleProj S.X₃ r)
  have hcomp : φ.symm.hom ≫ bundleProj S.X₃ =
      (φ.symm.hom ≫ bundleEmbedding S.g) ≫ bundleProj S.X₂ :=
    (congrArg (φ.symm.hom ≫ ·) (bundleEmbedding_comp_bundleProj S.g).symm).trans
      (Category.assoc _ _ _).symm
  exact (congrArg (fun k => Flat (k ≫ bundleProj S.X₂)) he).mp (hcomp ▸ hflat)

end Subbundle

