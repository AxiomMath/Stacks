module

public import StacksFrontier.AlgebraicGeometry.Chow.SectionZeroScheme.ArbitraryRank

/-!
# The top Chern class of a module with a regular section: Stacks 0FA9

Let `(S, δ)` be the base situation of chapter 42, `X` locally of finite type over `S`, `ℰ` a
finite locally free `𝒪_X`-module, `f : X' ⟶ X` locally of finite type and `s ∈ Γ(X', f^*ℰ)`, with
zero scheme `Z(s) ⊆ X'`. [Stacks, Tag 0FA9]: if

1. `dim_δ(X') = n`,
2. `f^*ℰ` has constant rank `r`,
3. `dim_δ(Z(s)) ≤ n - r`, and
4. for every generic point `ξ ∈ Z(s)` with `δ(ξ) = n - r` the ideal of `Z(s)` in `𝒪_{X', ξ}` is
   generated by a regular sequence of length `r`,

then `c_r(ℰ) ∩ [X']_n = [Z(s)]_{n - r}` in `CH_{n - r}(X')`. Here `c_r(ℰ) ∈ A^r(X)` is the Chern
class of [Stacks, Tag 0ESW], built from the bivariant Chern classes of [Stacks, Tag 0B7H] on the
rank loci of `ℰ`, and `c_r(ℰ) ∩ -` on `X'` is its operation on the test scheme `f`.

The proof is the source's: `f` maps into the rank-`r` locus, so `c_r(ℰ) ∩ -` on `X'` is
`c_r(f^*ℰ) ∩ -` (`Stacks.Chow.SectionZeroScheme.idRule_chernClassOfLocallyFree`), and the
statement for `f^*ℰ` on `X'` is proven by induction on `r` over the projective bundle
(`Stacks.Chow.SectionZeroScheme.reducedTopChernCap`).

## Main results

* `Stacks.Chow.SectionZeroScheme.chernClassOfLocallyFree_cap_fundamental_eq_zeroSchemeCycle`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace Stacks.Chow.SectionZeroScheme

/-- **[Stacks, Tag 0FA9].** Let `ℰ` be finite locally free on `X`, `f : X' ⟶ X` locally of finite
type and `s` a section of `f^*ℰ` with zero scheme `Z(s)`. If `dim_δ(X') = n`, `f^*ℰ` has constant
rank `r`, `dim_δ(Z(s)) ≤ n - r` and at every generic point `ξ` of `Z(s)` with `δ(ξ) = n - r` the
ideal of `Z(s)` in `𝒪_{X', ξ}` is generated by a regular sequence of length `r`, then
`c_r(ℰ) ∩ [X']_n = [Z(s)]_{n - r}` in `CH_{n - r}(X')`, where `c_r(ℰ) ∈ A^r(X)` is the Chern class
of Stacks 0ESW. -/
@[stacks 0FA9 "c_r(E) ∩ [X']_n = [Z(s)]_{n-r} under dim_δ(X') = n, f^*E of constant rank r, \
dim_δ(Z(s)) ≤ n - r and the regular-sequence condition at the generic points of Z(s) of \
δ-dimension n - r"]
theorem chernClassOfLocallyFree_cap_fundamental_eq_zeroSchemeCycle (C : ChowSituation.{u})
    {X X' : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX] (E : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]
    (f : X' ⟶ X) [LocallyOfFiniteType f] (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback f).obj E) r]
    (s : Γ((Scheme.Modules.pullback f).obj E, ⊤)) (n : ℤ)
    (hX' : schemeDeltaDimension C (f ≫ sX) = (n : EInt))
    (hZ : schemeDeltaDimension C
        ((zeroSchemeOfSection X' ((Scheme.Modules.pullback f).obj E) s).subschemeι ≫ (f ≫ sX)) ≤
      ((n - (r : ℤ) : ℤ) : EInt))
    (hreg : IsRegularZeroSchemeSequence C (f ≫ sX) ((Scheme.Modules.pullback f).obj E) s r
      (n - (r : ℤ))) :
    (chernClassOfLocallyFree E C sX r).idRule C sX (gysinSystemOfInvertible C) f n
        (QuotientAddGroup.mk' (rationalEquivalences C (f ≫ sX) n)
          (cycleAssociatedToClosedSubscheme C (f ≫ sX) (𝟙 X') n)) =
      QuotientAddGroup.mk' (rationalEquivalences C (f ≫ sX) (n - (r : ℤ)))
        (cycleAssociatedToClosedSubscheme C (f ≫ sX)
          (zeroSchemeOfSection X' ((Scheme.Modules.pullback f).obj E) s).subschemeι
          (n - (r : ℤ))) :=
  (idRule_chernClassOfLocallyFree E C sX r f n _).trans
    (reducedTopChernCap C r (f ≫ sX) ((Scheme.Modules.pullback f).obj E) s n (le_of_eq hX') hZ
      hreg)

end Stacks.Chow.SectionZeroScheme

end
