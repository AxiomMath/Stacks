module

public import StacksFrontier.AlgebraicGeometry.Chow.SectionZeroScheme.Frame
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierStalk.Stalkwise
public import StacksFrontier.AlgebraicGeometry.CartierAffineLocalConverse.Basic
public import StacksFrontier.AlgebraicGeometry.Morphisms.Support.TestModuleStalk

/-!
# The zero scheme of a section of a finite locally free module, at a point

Let `ℰ` be finite locally free of rank `r` on a scheme `X` and `s ∈ Γ(X, ℰ)`. This file reads the
zero scheme `Z(s)` at a point `x`:

* the ideal of `Z(s)` in `𝒪_{X, x}` is generated by `r` elements, the germs of the coordinates of
  `s` in a frame of `ℰ` around `x`;
* if `x ∉ Z(s)`, then on an affine neighbourhood `V` of `x` some linear form on `Γ(ℰ, V)` takes
  the value `1` at `s|_V`;
* in rank zero `Z(s)` is the whole of `X`.

## Main results

* `Stacks.Chow.SectionZeroScheme.exists_stalk_eq_span` — the stalk of `Z(s)` at a point is
  generated by `r` elements.
* `Stacks.Chow.SectionZeroScheme.exists_linearForm_eq_one` — off `Z(s)` the section is locally
  part of a basis of the dual.
* `Stacks.Chow.SectionZeroScheme.zeroSchemeOfSection_eq_bot_of_rank_zero` — in rank zero
  `Z(s) = X`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

universe u

namespace Stacks.Chow.SectionZeroScheme

variable {X : Scheme.{u}} (F : X.Modules) (r : ℕ)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r]

/-- The open `U.ι ''ᵁ ⊤` of a frame over an affine open `U` is that affine open. -/
theorem isAffineOpen_image_top {U : X.Opens} (hU : IsAffineOpen U) : IsAffineOpen (U.ι ''ᵁ ⊤) := by
  rwa [Scheme.Opens.ι_image_top]

/-- **The stalk of the zero scheme is generated by `r` elements**: the germs of the coordinates
of the section in a frame around the point. -/
theorem exists_stalk_eq_span (s : Γ(F, ⊤)) (x : X) :
    ∃ g : Fin r → X.presheaf.stalk x,
      IdealSheafData.stalk (zeroSchemeOfSection X F s) x = Ideal.span (Set.range g) := by
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} F :=
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree F r
  obtain ⟨U, hU, hxU, -, ⟨e⟩⟩ := exists_frame F r (W := ⊤) (x := x) trivial
  have hxU' : x ∈ U.ι ''ᵁ ⊤ := by rwa [Scheme.Opens.ι_image_top]
  refine ⟨fun i => X.presheaf.germ (U.ι ''ᵁ ⊤) x hxU'
    (frameCoord F U e ⟨i⟩ (F.presheaf.map (homOfLE le_top).op s)), ?_⟩
  rw [IdealSheafData.stalk_eq_map_germ _ x ⟨U.ι ''ᵁ ⊤, isAffineOpen_image_top hU⟩ hxU',
    zeroSchemeOfSection_ideal_frame F U e s, Ideal.map_span, ← Set.range_comp]
  congr 1
  ext y
  exact ⟨fun ⟨i, h⟩ => ⟨i.down, h⟩, fun ⟨i, h⟩ => ⟨⟨i⟩, h⟩⟩

/-- An ideal sheaf all of whose stalks vanish is the zero ideal sheaf. -/
theorem eq_bot_of_stalk_eq_bot (I : X.IdealSheafData)
    (h : ∀ x : X, IdealSheafData.stalk I x = ⊥) : I = ⊥ := by
  refine le_antisymm ?_ bot_le
  intro U a ha
  change a ∈ (⊥ : X.IdealSheafData).ideal U
  rw [Scheme.IdealSheafData.ideal_bot, Pi.bot_apply, Ideal.mem_bot]
  refine TopCat.Presheaf.section_ext X.sheaf U.1 a 0 fun x hx => ?_
  change X.presheaf.germ U.1 x hx a = X.presheaf.germ U.1 x hx 0
  have hmem : X.presheaf.germ U.1 x hx a ∈ IdealSheafData.stalk I x := by
    rw [IdealSheafData.stalk_eq_map_germ I x U hx]
    exact Ideal.mem_map_of_mem _ ha
  rw [h x, Ideal.mem_bot] at hmem
  rw [hmem, map_zero]

/-- **In rank zero the zero scheme of a section is the whole scheme.** -/
theorem zeroSchemeOfSection_eq_bot_of_rank_zero
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F 0] (s : Γ(F, ⊤)) :
    zeroSchemeOfSection X F s = ⊥ := by
  refine eq_bot_of_stalk_eq_bot _ fun x => ?_
  obtain ⟨g, hg⟩ := exists_stalk_eq_span F 0 s x
  rw [hg, Set.range_eq_empty, Ideal.span_empty]

/-- The values at `m` of the linear forms on `M` already form an ideal. -/
theorem mem_span_eval_iff {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] (m : M)
    (a : R) :
    a ∈ Ideal.span {a : R | ∃ φ : M →ₗ[R] R, a = φ m} ↔ ∃ φ : M →ₗ[R] R, a = φ m := by
  refine ⟨fun h => ?_, fun h => Ideal.subset_span h⟩
  induction h using Submodule.span_induction with
  | mem x hx => exact hx
  | zero => exact ⟨0, rfl⟩
  | add x y _ _ hx hy =>
    obtain ⟨φ, rfl⟩ := hx
    obtain ⟨ψ, rfl⟩ := hy
    exact ⟨φ + ψ, rfl⟩
  | smul c x _ hx =>
    obtain ⟨φ, rfl⟩ := hx
    exact ⟨c • φ, rfl⟩

/-- **Off the zero scheme the section is locally unimodular.** If `x ∉ Z(s)`, then inside any
open neighbourhood of `x` there is an affine open `V ∋ x` and a linear form on `Γ(ℰ, V)` taking
the value `1` at `s|_V`. -/
theorem exists_linearForm_eq_one [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} F]
    (s : Γ(F, ⊤)) {x : X} (hx : x ∉ (zeroSchemeOfSection X F s).supportSet) {W : X.Opens}
    (hxW : x ∈ W) :
    ∃ V : X.affineOpens, x ∈ V.1 ∧ V.1 ≤ W ∧
      ∃ l : Γ(F, V.1) →ₗ[Γ(X, V.1)] Γ(X, V.1), l (F.presheaf.map (homOfLE le_top).op s) = 1 := by
  obtain ⟨V₀, hxV₀, htop₀⟩ :=
    Stacks.CartierAffineLocalConverse.exists_affineOpen_ideal_eq_top _ hx
  obtain ⟨f, hfle, hxf⟩ := V₀.2.exists_basicOpen_le (V := W ⊓ V₀.1) ⟨x, hxW, hxV₀⟩ hxV₀
  let V : X.affineOpens := X.affineBasicOpen f
  have htop : (zeroSchemeOfSection X F s).ideal V = ⊤ := by
    change (zeroSchemeOfSection X F s).ideal (X.affineBasicOpen f) = ⊤
    rw [← (zeroSchemeOfSection X F s).map_ideal_basicOpen V₀ f, htop₀, Ideal.map_top]
    rfl
  refine ⟨V, hxf, fun y hy => (hfle hy).1, ?_⟩
  have h1 : (1 : Γ(X, V.1)) ∈ (zeroSchemeOfSection X F s).ideal V := by simp [htop]
  rw [zeroSchemeOfSection_ideal F s V, mem_span_eval_iff] at h1
  exact h1.imp fun _ => Eq.symm

end Stacks.Chow.SectionZeroScheme

end
