module

public import StacksFrontier.RingTheory.Koszul.MinimalGenerators

/-!
# A regular sequence through a principal quotient

Let `A` be a Noetherian local ring, `φ : A →+* B` surjective with kernel `(g)`, and `J ⊆ A` an
ideal containing `g` and generated by a regular sequence of length `r + 1`. If the image of `J`
in `B` is generated by `r` elements, those elements form a regular sequence of `B`.

Indeed, lifting the `r` generators to `A` and adding `g` gives `r + 1` generators of `J`, which
form a regular sequence because `J` is generated by a regular sequence of that length
(`Koszul.isRegular_of_ofList_eq_of_length_eq`); dividing out its first term `g` leaves a regular
sequence of `A/(g) ≅ B`.

## Main definitions

* `Stacks.Chow.SectionZeroScheme.quotSMulTopEquiv`: the identification of `A / g • A` with `B`.

## Main results

* `Stacks.Chow.SectionZeroScheme.isRegular_of_map_eq_ofList`: generators of the image of `J`
  in `B`, of length one less than a regular sequence generating `J`, form a regular sequence.

## References

* [Stacks, Tag 0FA9]
-/

@[expose] public section

open RingTheory.Sequence IsLocalRing Pointwise

namespace Stacks.Chow.SectionZeroScheme

variable {A B : Type*} [CommRing A] [CommRing B]

/-- The quotient of `A` by `g • A`, identified with `B` through a surjection with kernel `(g)`. -/
noncomputable def quotSMulTopEquiv (φ : A →+* B) (hφ : Function.Surjective φ) (g : A)
    (hker : RingHom.ker φ = Ideal.span {g}) : QuotSMulTop g A ≃+ B :=
  ((Submodule.quotEquivOfEq _ _ (by
      rw [← Submodule.ideal_span_singleton_smul, Ideal.smul_top_eq_self, hker] :
        g • (⊤ : Submodule A A) = (RingHom.ker φ : Submodule A A))).toAddEquiv).trans
    (RingHom.quotientKerEquivOfSurjective hφ).toAddEquiv

/-- The additive equivalence `quotSMulTopEquiv φ hφ g hker` is semilinear along `φ`: it sends
`a • x` to `φ a • quotSMulTopEquiv φ hφ g hker x`. -/
theorem quotSMulTopEquiv_smul (φ : A →+* B) (hφ : Function.Surjective φ) (g : A)
    (hker : RingHom.ker φ = Ideal.span {g}) (a : A) (x : QuotSMulTop g A) :
    quotSMulTopEquiv φ hφ g hker (a • x) = φ a • quotSMulTopEquiv φ hφ g hker x := by
  induction x using Submodule.Quotient.induction_on with
  | H y =>
    rw [← Submodule.Quotient.mk_smul]
    change φ (a • y) = φ a * φ y
    rw [smul_eq_mul, map_mul]

/-- Let `A` be a Noetherian local ring, `φ : A →+* B` surjective with kernel `(g)`, and `J` an
ideal of `A` containing `g` and generated by a regular sequence of length `r + 1`. If
`J.map φ` is generated by a list `hs` of length `r`, then `hs` is a regular sequence of `B`. -/
theorem isRegular_of_map_eq_ofList [IsNoetherianRing A] [IsLocalRing A]
    (φ : A →+* B) (hφ : Function.Surjective φ) (g : A) (hker : RingHom.ker φ = Ideal.span {g})
    (J : Ideal A) (hgJ : g ∈ J) (rs : List A) (hrs : IsRegular A rs) (hJ : Ideal.ofList rs = J)
    (hs : List B) (hlen : rs.length = hs.length + 1) (hspan : J.map φ = Ideal.ofList hs) :
    IsRegular B hs := by
  classical
  set hs' : List A := hs.map (Function.surjInv hφ) with hhs'
  have hmap : hs'.map φ = hs := by
    rw [hhs', List.map_map]
    conv_rhs => rw [← List.map_id hs]
    exact List.map_congr_left fun b _ => Function.surjInv_eq hφ b
  have hkerJ : RingHom.ker φ ≤ J := by
    rwa [hker, Ideal.span_le, Set.singleton_subset_iff]
  have hJeq : Ideal.ofList (g :: hs') = J := by
    have h1 : J = Ideal.comap φ (Ideal.map φ J) :=
      (Ideal.comap_map_of_surjective' φ hφ J).trans (sup_eq_left.2 hkerJ) |>.symm
    rw [h1, hspan, ← hmap, ← Ideal.map_ofList, Ideal.comap_map_of_surjective' φ hφ, hker,
      Ideal.ofList_cons, sup_comm]
  have hreg : IsRegular A (g :: hs') :=
    Koszul.isRegular_of_ofList_eq_of_length_eq (g :: hs') rs
      (by rw [List.length_cons, hhs', List.length_map, hlen]) (hJeq.trans hJ.symm) hrs
  rw [← hmap]
  exact (AddEquiv.isRegular_congr (e := quotSMulTopEquiv φ hφ g hker)
    (List.forall₂_map_right_iff.mpr (List.forall₂_same.mpr fun a _ x =>
      quotSMulTopEquiv_smul φ hφ g hker a x))).mp
    ((isRegular_cons_iff A g hs').mp hreg).2

end Stacks.Chow.SectionZeroScheme

end
