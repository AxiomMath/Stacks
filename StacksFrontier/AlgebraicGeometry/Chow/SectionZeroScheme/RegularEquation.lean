module

public import StacksFrontier.AlgebraicGeometry.Chow.SectionZeroScheme.InvertibleCase
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.ProjHyperplane

/-!
# Regular local equations of a closed subscheme

For a closed subscheme `Z ⊆ X` and a point `x ∈ Z`, say that the ideal of `Z` in `𝒪_{X, x}`
*contains a nonzerodivisor*. This file records three ways of producing such a point:

* from a regular generator of the ideal of `Z` on an affine neighbourhood of `x`;
* from the inverse image of `Z` along an open immersion;
* on `Proj` of a graded ring generated in degree one, for the zero scheme of the section of
  `𝒪(1)` attached to a degree-one nonzerodivisor.

## Main results

* `Stacks.Chow.SectionZeroScheme.exists_nonZeroDivisor_mem_stalkIdeal_of_eq_span`.
* `Stacks.Chow.SectionZeroScheme.exists_nonZeroDivisor_mem_stalkIdeal_of_comap`.
* `Stacks.Chow.SectionZeroScheme.exists_nonZeroDivisor_mem_stalkIdeal_degreeSection`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

universe u

namespace Stacks.Chow.SectionZeroScheme

/-- **A regular local generator gives a nonzerodivisor in the ideal at the point.** -/
theorem exists_nonZeroDivisor_mem_stalkIdeal_of_eq_span {X : Scheme.{u}}
    (I : X.IdealSheafData) (x : X) (hx : x ∈ I.support) (U : X.affineOpens) (hxU : x ∈ U.1)
    (f : Γ(X, U.1)) (hf : IsRegular f) (hI : I.ideal U = Ideal.span {f}) :
    ∃ a ∈ nonZeroDivisors (X.presheaf.stalk x),
      a ∈ Stacks.AlgebraicGeometry.stalkIdeal I x hx := by
  refine ⟨X.presheaf.germ U.1 x hxU f, ?_, ?_⟩
  · let _ : Algebra Γ(X, U.1) (X.presheaf.stalk x) := X.presheaf.algebra_section_stalk ⟨x, hxU⟩
    have : IsLocalization (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl
        (X.presheaf.stalk x) := U.2.isLocalization_stalk ⟨x, hxU⟩
    exact IsLocalization.map_nonZeroDivisors_le
      (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl (X.presheaf.stalk x)
      (Submonoid.mem_map_of_mem _ (isRegular_iff_mem_nonZeroDivisors.1 hf))
  · rw [Stacks.AlgebraicGeometry.stalkIdeal_eq_map_germ I x hx U.2 hxU, hI]
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span rfl)

/-- **The property is local along open immersions.** If the inverse image of `I` along an open
immersion `j` has, at `z`, a nonzerodivisor in its ideal, so does `I` at `j z`. -/
theorem exists_nonZeroDivisor_mem_stalkIdeal_of_comap {X Z : Scheme.{u}}
    (I : X.IdealSheafData) (j : Z ⟶ X) [IsOpenImmersion j] (z : Z) (hz : j z ∈ I.support)
    (hz' : z ∈ (I.comap j).support)
    (h : ∃ a ∈ nonZeroDivisors (Z.presheaf.stalk z),
      a ∈ Stacks.AlgebraicGeometry.stalkIdeal (I.comap j) z hz') :
    ∃ b ∈ nonZeroDivisors (X.presheaf.stalk (j z)),
      b ∈ Stacks.AlgebraicGeometry.stalkIdeal I (j z) hz := by
  obtain ⟨a, ha, hmem⟩ := h
  rw [Stacks.AlgebraicGeometry.stalkIdeal_comap I j z hz' hz] at hmem
  let e : X.presheaf.stalk (j z) ≃+* Z.presheaf.stalk z :=
    (asIso (j.stalkMap z)).commRingCatIsoToRingEquiv
  have hmem' : a ∈ Ideal.map (e : X.presheaf.stalk (j z) →+* Z.presheaf.stalk z)
      (Stacks.AlgebraicGeometry.stalkIdeal I (j z) hz) := hmem
  rw [Ideal.map_comap_of_equiv] at hmem'
  refine ⟨e.symm a, ?_, hmem'⟩
  exact MulEquivClass.map_nonZeroDivisors e.symm ▸ Submonoid.mem_map_of_mem _ ha

section Hyperplane

open AlgebraicGeometry.ProjectiveSpectrum.Proj HomogeneousLocalization

variable {S σ : Type u} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S] (𝒮 : ℕ → σ)
  [GradedRing 𝒮]

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf
attribute [local instance_reducible] ProjectiveSpectrum.top

/-- **The hyperplane of a degree-one nonzerodivisor has regular local equations.** For `𝒮`
generated in degree one and `t ∈ 𝒮 1` a nonzerodivisor, at every point of the zero scheme of the
section of `𝒪_{Proj 𝒮}(1)` attached to `t` the ideal contains a nonzerodivisor: on `D₊(g)` it is
generated by the nonzerodivisor `t / g`. -/
theorem exists_nonZeroDivisor_mem_stalkIdeal_degreeSection
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤) (t : 𝒮 1) (ht : IsRegular (t : S)) :
    haveI := algebraicGeometry_isInvertible_twistingSheaf 𝒮 hgen ((1 : ℕ) : ℤ)
    ∀ (x : AlgebraicGeometry.Proj 𝒮)
      (hx : x ∈ (Stacks.Divisors.zeroScheme (AlgebraicGeometry.Proj 𝒮)
        (twistingSheafModule 𝒮 ((1 : ℕ) : ℤ)) (degreeSection 𝒮 1 t)).support),
      ∃ a ∈ nonZeroDivisors ((AlgebraicGeometry.Proj 𝒮).presheaf.stalk x),
        a ∈ Stacks.AlgebraicGeometry.stalkIdeal
          (Stacks.Divisors.zeroScheme (AlgebraicGeometry.Proj 𝒮)
            (twistingSheafModule 𝒮 ((1 : ℕ) : ℤ)) (degreeSection 𝒮 1 t)) x hx := by
  have := algebraicGeometry_isInvertible_twistingSheaf 𝒮 hgen ((1 : ℕ) : ℤ)
  intro x hx
  have hcover : ⨆ g : 𝒮 1, Proj.basicOpen 𝒮 (g : S) = ⊤ := by
    refine Proj.iSup_basicOpen_eq_top' 𝒮 (fun g : 𝒮 1 => (g : S)) (fun g => ⟨1, g.2⟩) ?_
    rw [show Set.range (fun g : 𝒮 1 => (g : S)) = (𝒮 1 : Set S) from Subtype.range_coe]
    exact hgen
  have hx' : x ∈ ⨆ g : 𝒮 1, Proj.basicOpen 𝒮 (g : S) := by rw [hcover]; trivial
  obtain ⟨g, hxg⟩ := Opens.mem_iSup.1 hx'
  have ht' : (t : S) ∈ 𝒮 (1 • 1) := by simp [t.2]
  exact exists_nonZeroDivisor_mem_stalkIdeal_of_eq_span _ x hx
    ⟨Proj.basicOpen 𝒮 (g : S), Proj.isAffineOpen_basicOpen 𝒮 (g : S) g.2 Nat.one_pos⟩ hxg
    (chartFraction 𝒮 g.2 1 ⟨t, ht'⟩)
    (Stacks.Chow.GenuineChern.isRegular_chartFraction 𝒮 g.2 ⟨t, ht'⟩ ht)
    (zeroScheme_degreeSection_ideal_basicOpen_of_degree_eq 𝒮 g.2
      Nat.one_pos 1 (by simp) t ht')

end Hyperplane

end Stacks.Chow.SectionZeroScheme

end
