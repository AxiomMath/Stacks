module

public import StacksFrontier.AlgebraicGeometry.Chow.SectionZeroScheme.Lift
public import StacksFrontier.AlgebraicGeometry.Chow.SectionZeroScheme.Dimension
public import StacksFrontier.AlgebraicGeometry.Chow.SectionZeroScheme.RegularQuotient
public import StacksFrontier.AlgebraicGeometry.Chow.UnionFundamentalCycle
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RelativeRegularImmersion.StalkIdeal
public import StacksFrontier.RingTheory.Sequence.BaseChange
public import Mathlib.AlgebraicGeometry.Morphisms.Flat

/-!
# The regular-sequence hypothesis of Stacks 0FA9 in the inductive step

Let `π : P ⟶ X` be flat, locally of finite type and of relative dimension `d`, `ℰ` finite locally
free of rank `r + 2` on `X` with a section `s` whose zero scheme satisfies the hypotheses of
[Stacks, Tag 0FA9] in `δ`-dimension `n`, and `τ : π^*ℰ ⟶ ℒ` an epimorphism onto an invertible
module. With `σ = π^* s`, `t = τ(σ)`, `j : Z(t) ⟶ P` and the lifted section `σ'` of
`ℰ' = ker(j^* τ)` (`Stacks.Chow.SectionZeroScheme.liftSection`), the source observes: if `ξ` is a
generic point of `Z(σ')` of `δ`-dimension `n + d - r - 1`, then the ideal of `Z(σ')` in
`𝒪_{Z(t), ξ}` is generated by a regular sequence of length `r + 1`.

Indeed `ξ` lies over a generic point `x` of `Z(s)` of `δ`-dimension `n - r - 2`, where the ideal
of `Z(s)` is generated by a regular sequence of length `r + 2`; by flatness its image generates
the ideal of `Z(σ) = π⁻¹(Z(s))` at `ξ` and is regular ([Stacks, Tag 00LM]); the ideal of `Z(t)`
is principal and contained in it, and the ideal of `Z(σ')` is the image of that of `Z(σ)` in
`𝒪_{Z(t), ξ}`, generated by `r + 1` elements; so it is generated by a regular sequence
(`Stacks.Chow.SectionZeroScheme.isRegular_of_map_eq_ofList`).

## Main results

* `Stacks.Chow.SectionZeroScheme.isRegular_map_stalkMap` — [Stacks, Tag 00LM] along a flat
  morphism of schemes.
* `Stacks.Chow.SectionZeroScheme.isRegularZeroSchemeSequence_liftSection`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Chow.SectionZeroScheme

/-- **[Stacks, Tag 00LM] along a flat morphism of schemes.** The image of a regular sequence of
`𝒪_{Y, f x}` in `𝒪_{X, x}` is a regular sequence. -/
theorem isRegular_map_stalkMap {X Y : Scheme.{u}} (f : X ⟶ Y) [Flat f] (x : X)
    (rs : List (Y.presheaf.stalk (f x)))
    (h : RingTheory.Sequence.IsRegular (Y.presheaf.stalk (f x)) rs) :
    RingTheory.Sequence.IsRegular (X.presheaf.stalk x) (rs.map (f.stalkMap x).hom) := by
  let : Algebra (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) := (f.stalkMap x).hom.toAlgebra
  have : Module.Flat (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) := Flat.stalkMap f x
  have : IsLocalHom (algebraMap (Y.presheaf.stalk (f x)) (X.presheaf.stalk x)) :=
    inferInstanceAs (IsLocalHom (f.stalkMap x).hom)
  have : Module.FaithfullyFlat (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom
  exact (Stacks.RegularSequence.FlatBaseChange.solution
    (IsBaseChange.linearMap (Y.presheaf.stalk (f x)) (X.presheaf.stalk x)) rs).2 h

/-- The ideal that a closed subscheme cuts out at a point depends only on the ideal sheaf. -/
theorem stalkIdeal_congr {X : Scheme.{u}} {I J : X.IdealSheafData} (h : I = J) {x : X}
    (hx : x ∈ I.support) (hx' : x ∈ J.support) :
    Stacks.AlgebraicGeometry.stalkIdeal I x hx = Stacks.AlgebraicGeometry.stalkIdeal J x hx' := by
  subst h
  rfl

/-- The ideal that a closed subscheme cuts out at a point is the stalk of its ideal sheaf. -/
theorem stalkIdeal_eq_stalk {X : Scheme.{u}} (I : X.IdealSheafData) (x : X) (hx : x ∈ I.support) :
    Stacks.AlgebraicGeometry.stalkIdeal I x hx = IdealSheafData.stalk I x :=
  IdealSheafData.ker_stalkMap_subschemeι I ⟨x, hx⟩

/-- The kernel of the stalk map of the closed immersion of a closed subscheme is the stalk of its
ideal sheaf. -/
theorem _root_.AlgebraicGeometry.IdealSheafData.ker_subschemeι_stalkMap_eq {X : Scheme.{u}}
    (I : X.IdealSheafData) (z : I.subscheme) :
    RingHom.ker (I.subschemeι.stalkMap z).hom = IdealSheafData.stalk I (I.subschemeι z) :=
  IdealSheafData.ker_stalkMap_subschemeι I z

/-- Larger ideal sheaves have larger stalks. -/
alias stalk_mono := Stacks.Chow.idealStalk_mono

/-- **The regular-sequence hypothesis of [Stacks, Tag 0FA9] for the lifted section.** -/
theorem isRegularZeroSchemeSequence_liftSection (C : ChowSituation.{u}) {X P : Scheme.{u}}
    (q : X ⟶ C.S) [LocallyOfFiniteType q] (π : P ⟶ X) [LocallyOfFiniteType π] [Flat π]
    (d : ℕ) (hπ : AlgebraicGeometry.RelativeDimension π d) (F : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F (r + 2)]
    (s : Γ(F, ⊤)) {L : P.Modules} (τ : (Scheme.Modules.pullback π).obj F ⟶ L) [Epi τ]
    [AlgebraicGeometry.SheafOfModules.IsInvertible P.sheaf.obj P.ringCatSheaf.property L]
    (k : ℤ)
    (hZ : schemeDeltaDimension C ((zeroSchemeOfSection X F s).subschemeι ≫ q) ≤
      ((k - d : ℤ) : EInt))
    (hreg : IsRegularZeroSchemeSequence C q F s (r + 2) (k - d)) :
    haveI := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback π F (r + 2)
    IsRegularZeroSchemeSequence C
      ((hyperplane τ (pullbackGlobalSections π F s)).subschemeι ≫ π ≫ q)
      (liftModule τ (pullbackGlobalSections π F s)) (liftSection τ (pullbackGlobalSections π F s))
      (r + 1) k := by
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback π F (r + 2)
  set σ := pullbackGlobalSections π F s with hσdef
  have := isFiniteLocallyFreeOfRank_liftModule τ σ r
  set D := hyperplane τ σ with hDdef
  set j := D.subschemeι with hjdef
  set I := zeroSchemeOfSection X F s with hIdef
  set Iσ := zeroSchemeOfSection P ((Scheme.Modules.pullback π).obj F) σ with hIσdef
  set I' := zeroSchemeOfSection D.subscheme (liftModule τ σ) (liftSection τ σ) with hI'def
  have hI' : I' = Iσ.comap j := zeroSchemeOfSection_liftSection τ σ r
  have hIσ : Iσ = I.comap π := zeroSchemeOfSection_pullback π F (r + 2) s
  intro ξ' hξ'
  set z : D.subscheme := I'.subschemeι ξ'.1 with hzdef
  set y : P := j z with hydef
  set x : X := π y with hxdef
  have hz' : z ∈ I'.support :=
    I'.range_subschemeι.subset ⟨ξ'.1, rfl⟩
  have hz : z ∈ (Iσ.comap j).support := hI' ▸ hz'
  have hyσ : y ∈ Iσ.support := by
    rwa [Scheme.IdealSheafData.support_comap] at hz
  have hy : y ∈ (I.comap π).support := hIσ ▸ hyσ
  have hx : x ∈ I.support := by
    rwa [Scheme.IdealSheafData.support_comap] at hy
  have hδy : relativeDimension C.dimensionFunction (π ≫ q) y = k := by
    rw [← relativeDimension_comp_closedImmersion C.dimensionFunction j (π ≫ q) z]
    exact hξ'
  have hδx₁ := relativeDimension_comp_le_add C q π d hπ y
  have hδx₂ := relativeDimension_le_of_schemeDeltaDimension_le C q I.subschemeι hZ ⟨x, hx⟩
  have hb : relativeDimension C.dimensionFunction q (π y) =
      relativeDimension C.dimensionFunction q x := rfl
  have hδx : relativeDimension C.dimensionFunction q (I.subschemeι ⟨x, hx⟩) = k - d := by
    show relativeDimension C.dimensionFunction q x = k - d
    change relativeDimension C.dimensionFunction q x ≤ k - d at hδx₂
    omega
  have hgen := mem_genericPoints_of_relativeDimension_eq C q I hZ ⟨x, hx⟩ hδx
  obtain ⟨rs₀, hlen, hrs₀, hspan₀⟩ := hreg ⟨⟨x, hx⟩, hgen⟩ hδx
  let rs : List (X.presheaf.stalk x) := rs₀
  have hrs : RingTheory.Sequence.IsRegular (X.presheaf.stalk x) rs := hrs₀
  have hspan : Ideal.ofList rs = Stacks.AlgebraicGeometry.stalkIdeal I x hx := hspan₀
  set J := Stacks.AlgebraicGeometry.stalkIdeal Iσ y hyσ with hJdef
  have hJ : Ideal.ofList (rs.map (π.stalkMap y).hom) = J := by
    rw [hJdef, stalkIdeal_congr hIσ hyσ hy,
      Stacks.AlgebraicGeometry.stalkIdeal_comap I π y hy hx, ← Ideal.map_ofList]
    exact congrArg (Ideal.map (π.stalkMap y).hom) hspan
  have hrs' := isRegular_map_stalkMap π y rs hrs
  have : IsLocallyNoetherian P := LocallyOfFiniteType.isLocallyNoetherian (π ≫ q)
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L 1 :=
    Stacks.ProjectiveBundleSplitting.isFiniteLocallyFreeOfRank_one_of_isInvertible L
      (by exact (inferInstance :
        AlgebraicGeometry.SheafOfModules.IsInvertible P.sheaf.obj P.ringCatSheaf.property L))
  obtain ⟨g, hg⟩ := exists_stalk_eq_span L 1 (τ.app ⊤ σ) y
  have hker : RingHom.ker (j.stalkMap z).hom = Ideal.span {g 0} := by
    rw [IdealSheafData.ker_subschemeι_stalkMap_eq D z]
    exact hg.trans (by rw [Set.range_unique]; rfl)
  have hsurj : Function.Surjective (j.stalkMap z).hom := j.stalkMap_surjective z
  have hgJ : g 0 ∈ J := by
    have hle := stalk_mono (hyperplane_le_zeroSchemeOfSection τ σ (r + 2)) y
    rw [hJdef, stalkIdeal_eq_stalk]
    refine hle ?_
    show g 0 ∈ IdealSheafData.stalk (zeroSchemeOfSection P L (τ.app ⊤ σ)) y
    rw [hg]
    exact Ideal.subset_span ⟨0, rfl⟩
  obtain ⟨h, hh⟩ := exists_stalk_eq_span (liftModule τ σ) (r + 1) (liftSection τ σ) z
  have hmapJ : J.map (j.stalkMap z).hom = Ideal.ofList (List.ofFn h) := by
    rw [Ideal.ofList_ofFn, ← hh, hJdef, ← Stacks.AlgebraicGeometry.stalkIdeal_comap Iσ j z hz hyσ,
      stalkIdeal_congr hI'.symm hz hz', stalkIdeal_eq_stalk]
  have hreg' := isRegular_of_map_eq_ofList (j.stalkMap z).hom hsurj (g 0) hker J hgJ
    (rs.map (π.stalkMap y).hom) hrs' hJ (List.ofFn h)
    (by rwa [List.length_map, List.length_ofFn]) hmapJ
  refine ⟨List.ofFn h, List.length_ofFn, hreg', ?_⟩
  show Ideal.ofList (List.ofFn h) = _
  rw [Ideal.ofList_ofFn, ← hh, IdealSheafData.ker_subschemeι_stalkMap_eq I' ξ'.1]

end Stacks.Chow.SectionZeroScheme

end
