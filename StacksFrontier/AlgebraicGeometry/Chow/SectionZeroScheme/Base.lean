module

public import StacksFrontier.AlgebraicGeometry.Chow.SectionZeroScheme.InvertibleCase
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.BivariantChernClass
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.CapRuleRankOne
public import StacksFrontier.AlgebraicGeometry.Chow.FibreCycles.FibreDifferencePushforward

/-!
# The top Chern class of a module with a regular section: ranks zero and one

Let `(S, δ)` be the base situation of chapter 42, `X` locally of finite type over `S`, `ℰ` finite
locally free of rank `r` on `X` and `s ∈ Γ(X, ℰ)`.
`Stacks.Chow.SectionZeroScheme.ReducedTopChernCap` is the assertion that, whenever `dim_δ(X) ≤ n`,
`dim_δ(Z(s)) ≤ n - r` and the ideal of `Z(s)` is generated by a regular sequence of length `r` at
every generic point of `Z(s)` of `δ`-dimension `n - r`,

  `c_r(ℰ) ∩ [X]_n = [Z(s)]_{n - r}`  in  `CH_{n - r}(X)`,

for the Chern class cap products `Stacks.Chow.GenuineChern.chernCap` of [Stacks, Tag 02U6].
This is the case `X = X'` of [Stacks, Tag 0FA9], to which the source reduces, with `dim_δ(X) = n`
weakened to `dim_δ(X) ≤ n` so that it can be carried through the source's induction on `r`. This
file proves it for `r = 0` and `r = 1`.

## Main definitions

* `Stacks.Chow.SectionZeroScheme.ReducedTopChernCap`.

## Main results

* `Stacks.Chow.SectionZeroScheme.reducedTopChernCap_zero` — the case `r = 0`: then `Z(s) = X`.
* `Stacks.Chow.SectionZeroScheme.reducedTopChernCap_one` — the case `r = 1`, which is
  [Stacks, Tag 02SQ].
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

universe u

namespace Stacks.Chow.SectionZeroScheme

/-- **[Stacks, Tag 0FA9] in the case `X = X'`, at rank `r`**, with `dim_δ(X) ≤ n`. -/
def ReducedTopChernCap (C : ChowSituation.{u}) (r : ℕ) : Prop :=
  ∀ ⦃X : Scheme.{u}⦄ (q : X ⟶ C.S) [LocallyOfFiniteType q] (F : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F r] (s : Γ(F, ⊤))
    (n : ℤ),
    schemeDeltaDimension C q ≤ (n : EInt) →
    schemeDeltaDimension C ((zeroSchemeOfSection X F s).subschemeι ≫ q) ≤
      ((n - (r : ℤ) : ℤ) : EInt) →
    IsRegularZeroSchemeSequence C q F s r (n - (r : ℤ)) →
    GenuineChern.chernCap C r q F n (Fin.last r)
        (QuotientAddGroup.mk' (rationalEquivalences C q n)
          (cycleAssociatedToClosedSubscheme C q (𝟙 X) n)) =
      QuotientAddGroup.mk' (rationalEquivalences C q (n - (r : ℤ)))
        (cycleAssociatedToClosedSubscheme C q (zeroSchemeOfSection X F s).subschemeι
          (n - (r : ℤ)))

/-- Transporting the class of the cycle of a closed subscheme along an equality of degrees gives
the class of its cycle in the new degree. -/
theorem chowGroupCast_mk_cycle (C : ChowSituation.{u}) {X Z : Scheme.{u}} (q : X ⟶ C.S)
    [LocallyOfFiniteType q] (i : Z ⟶ X) [IsClosedImmersion i] {k l : ℤ} (h : k = l) :
    chowGroupCast C q h (QuotientAddGroup.mk' (rationalEquivalences C q k)
        (cycleAssociatedToClosedSubscheme C q i k)) =
      QuotientAddGroup.mk' (rationalEquivalences C q l)
        (cycleAssociatedToClosedSubscheme C q i l) := by
  subst h
  rfl

/-- Equal ideal sheaves have equal fundamental cycles. -/
theorem cycle_subschemeι_congr (C : ChowSituation.{u}) {X : Scheme.{u}} (q : X ⟶ C.S)
    [LocallyOfFiniteType q] {I J : X.IdealSheafData} (h : I = J) (k : ℤ) :
    cycleAssociatedToClosedSubscheme C q I.subschemeι k =
      cycleAssociatedToClosedSubscheme C q J.subschemeι k := by
  subst h
  rfl

/-- **[Stacks, Tag 0FA9] at rank zero**: `c_0(ℰ) = 1` and `Z(s) = X`. -/
theorem reducedTopChernCap_zero (C : ChowSituation.{u}) : ReducedTopChernCap C 0 := by
  intro X q _ F _ s n _ _ _
  rw [GenuineChern.chernCap_zero, chowGroupCast_mk_cycle]
  have hZ : zeroSchemeOfSection X F s = ⊥ := zeroSchemeOfSection_eq_bot_of_rank_zero F s
  refine congrArg _ ?_
  rw [cycleAssociatedToClosedSubscheme_ker C q (𝟙 X),
    cycleAssociatedToClosedSubscheme_ker C q (zeroSchemeOfSection X F s).subschemeι]
  exact cycle_subschemeι_congr C q (by
    rw [Scheme.IdealSheafData.ker_subschemeι, hZ, Scheme.Hom.ker_eq_bot_of_isIso]) _

/-- A regular sequence of length one in a ring is a nonzerodivisor. -/
theorem mem_nonZeroDivisors_of_isRegular_singleton {R : Type*} [CommRing R] {a : R}
    (h : RingTheory.Sequence.IsRegular R [a]) : a ∈ nonZeroDivisors R := by
  have ha := ((RingTheory.Sequence.isRegular_cons_iff R a []).mp h).1
  refine mem_nonZeroDivisors_iff_right.mpr fun x hx => ha ?_
  show a • x = a • 0
  rw [smul_eq_mul, smul_eq_mul, mul_comm, hx, mul_zero]

/-- **`c₁(ℒ) ∩ [X]_n = [Z(s)]_{n - 1}`** for a module `ℒ` of rank one and a section `s` such that
`dim_δ(X) ≤ n`, `dim_δ(Z(s)) ≤ n - 1` and at every generic point of `Z(s)` of `δ`-dimension
`n - 1` the ideal of `Z(s)` contains a nonzerodivisor ([Stacks, Tag 02SQ]). -/
theorem chernCap_one_mk_fundamental_eq (C : ChowSituation.{u}) {X : Scheme.{u}} (q : X ⟶ C.S)
    [LocallyOfFiniteType q] (F : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F 1] (s : Γ(F, ⊤))
    (n : ℤ) (hX : schemeDeltaDimension C q ≤ (n : EInt))
    (hZ : schemeDeltaDimension C ((zeroSchemeOfSection X F s).subschemeι ≫ q) ≤
      ((n - 1 : ℤ) : EInt))
    (hnzd : ∀ ξ : genericPoints (zeroSchemeOfSection X F s).subscheme,
      relativeDimension C.dimensionFunction q
          ((zeroSchemeOfSection X F s).subschemeι ξ.1) = n - 1 →
        ∃ a ∈ nonZeroDivisors
            (X.presheaf.stalk ((zeroSchemeOfSection X F s).subschemeι ξ.1)),
          a ∈ RingHom.ker ((zeroSchemeOfSection X F s).subschemeι.stalkMap ξ.1).hom) :
    GenuineChern.chernCap C 1 q F n (Fin.last 1)
        (QuotientAddGroup.mk' (rationalEquivalences C q n)
          (cycleAssociatedToClosedSubscheme C q (𝟙 X) n)) =
      QuotientAddGroup.mk' (rationalEquivalences C q (n - 1))
        (cycleAssociatedToClosedSubscheme C q (zeroSchemeOfSection X F s).subschemeι
          (n - 1)) := by
  have := GenuineChern.isInvertible_of_rank_one F
  have h1 := GenuineChern.chernCap_one_eq_invCap C q F n
    (QuotientAddGroup.mk' (rationalEquivalences C q n)
      (cycleAssociatedToClosedSubscheme C q (𝟙 X) n))
  refine h1.trans ?_
  rw [chowGroupCast_mk_cycle C q (𝟙 X) (show n = n - 1 + 1 by omega), invCap_capOnChow_mk]
  exact firstChernClassCapOfInvertible_fundamental_eq_zeroScheme C q F s (n - 1)
    (le_trans hX (le_of_eq (by norm_num))) hZ hnzd

/-- **[Stacks, Tag 0FA9] at rank one**, which is [Stacks, Tag 02SQ]. -/
theorem reducedTopChernCap_one (C : ChowSituation.{u}) : ReducedTopChernCap C 1 := by
  intro X q _ F _ s n hX hZ hreg
  refine chernCap_one_mk_fundamental_eq C q F s n hX hZ fun ξ hξ => ?_
  obtain ⟨rs, hlen, hrs, hspan⟩ := hreg ξ hξ
  match rs, hlen, hrs, hspan with
  | [a], _, hrs, hspan =>
    refine ⟨a, mem_nonZeroDivisors_of_isRegular_singleton hrs, ?_⟩
    exact hspan ▸ Ideal.subset_span (List.mem_singleton_self a)

end Stacks.Chow.SectionZeroScheme

end
