module

public import StacksFrontier.AlgebraicGeometry.Chow.SectionZeroScheme.Induction

/-!
# Chern classes and sections: Stacks 0FA9

Let `(S, δ)` be the base situation of chapter 42, `X` locally of finite type over `S`, `ℰ` a
finite locally free `𝒪_X`-module, `f : X' ⟶ X` locally of finite type and `s ∈ Γ(X', f^*ℰ)`, with
zero scheme `Z(s) ⊆ X'`. [Stacks, Tag 0FA9]: if `dim_δ(X') = n`, `f^*ℰ` has constant rank `r`,
`dim_δ(Z(s)) ≤ n - r` and for every generic point `ξ ∈ Z(s)` with `δ(ξ) = n - r` the ideal of
`Z(s)` in `𝒪_{X', ξ}` is generated by a regular sequence of length `r`, then

  `c_r(ℰ) ∩ [X']_n = [Z(s)]_{n - r}`  in  `CH_*(X')`.

This file proves it for a module `ℰ` of constant rank `r` on `X`, with `c_r(ℰ)` the bivariant
Chern class `Stacks.Chow.GenuineChern.chernClass` of [Stacks, Tag 0B7H]: as in the source,
because `c_r(ℰ)` is a bivariant class its cap product on `X'` is that of `c_r(f^*ℰ)`, and the
reduced statement on `X'` (`Stacks.Chow.SectionZeroScheme.reducedTopChernCap`) is the source's
induction on `r`.

## Main results

* `Stacks.Chow.SectionZeroScheme.chernClass_cap_fundamental_eq_zeroSchemeCycle`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace Stacks.Chow.SectionZeroScheme

/-- **[Stacks, Tag 0FA9] for a module of constant rank on `X`.** With `c_r(ℰ) ∈ A^r(X)` the
bivariant Chern class of [Stacks, Tag 0B7H], `c_r(ℰ) ∩ [X']_n = [Z(s)]_{n - r}` in
`CH_{n - r}(X')`, the cap product of a bivariant class for `𝟙 X` being read on `X'` through the
identification `X ×_X X' ≅ X'`. -/
theorem chernClass_cap_fundamental_eq_zeroSchemeCycle (C : ChowSituation.{u}) {X X' : Scheme.{u}}
    (sX : X ⟶ C.S) [LocallyOfFiniteType sX] (E : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    (f : X' ⟶ X) [LocallyOfFiniteType f] (s : Γ((Scheme.Modules.pullback f).obj E, ⊤)) (n : ℤ)
    (hX' : schemeDeltaDimension C (f ≫ sX) = (n : EInt))
    (hZ : schemeDeltaDimension C
        ((zeroSchemeOfSection X' ((Scheme.Modules.pullback f).obj E) s).subschemeι ≫ (f ≫ sX)) ≤
      ((n - (r : ℤ) : ℤ) : EInt))
    (hreg : IsRegularZeroSchemeSequence C (f ≫ sX) ((Scheme.Modules.pullback f).obj E) s r
      (n - (r : ℤ))) :
    chowPushforwardOfIso C (pullback.fst (𝟙 X) f ≫ sX) (f ≫ sX) (identityBaseChangeIso f).hom
        (identityBaseChangeIso_hom_comp_base C sX f) (n - ((Fin.last r : Fin (r + 1)) : ℤ))
        ((GenuineChern.chernClass C sX E r (Fin.last r)).cap f n
          (QuotientAddGroup.mk' (rationalEquivalences C (f ≫ sX) n)
            (cycleAssociatedToClosedSubscheme C (f ≫ sX) (𝟙 X') n))) =
      QuotientAddGroup.mk' (rationalEquivalences C (f ≫ sX) (n - (r : ℤ)))
        (cycleAssociatedToClosedSubscheme C (f ≫ sX)
          (zeroSchemeOfSection X' ((Scheme.Modules.pullback f).obj E) s).subschemeι
          (n - (r : ℤ))) := by
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback f E r
  refine (GenuineChern.isChernClassBivariant_chernClass C sX E r (Fin.last r) f n _).trans ?_
  exact reducedTopChernCap C r (f ≫ sX) ((Scheme.Modules.pullback f).obj E) s n
    (le_of_eq hX') hZ hreg

end Stacks.Chow.SectionZeroScheme

end
