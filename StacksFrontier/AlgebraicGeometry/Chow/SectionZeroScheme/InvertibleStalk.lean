module

public import StacksFrontier.AlgebraicGeometry.Chow.SectionZeroScheme.Factorization
public import StacksFrontier.AlgebraicGeometry.Chow.ZeroSchemePullback.LocalEquation
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierStalk.StalkwiseRegular
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RelativeRegularImmersion.StalkIdeal
import all StacksFrontier.AlgebraicGeometry.Chow.ZeroSchemePullback.Factorization

/-!
# A section of an invertible module whose zero scheme has a regular local equation

Let `ℒ` be an invertible module on a scheme `Y`, let `t` be a global section and let `y` be a
point of the zero scheme `Z(t)`. If the ideal that `Z(t)` cuts out in `𝒪_{Y, y}` contains a
nonzerodivisor, then multiplication by `t` is injective on the stalk at `y`: the map
`𝒪_{Y, y} ⟶ ℒ_y`, `c ↦ c t`, is injective. This is the form in which the third hypothesis of
[Stacks, Tag 02SQ] is checked.

Indeed, on an affine neighbourhood `U` of `y` over which `ℒ` is trivial, `t` corresponds to a
function `g` generating the ideal of `Z(t)` on `U`; the ideal of `Z(t)` in `𝒪_{Y, y}` is then
generated by the germ of `g`, which is a nonzerodivisor because a multiple of it is, and the map
`c ↦ c t` reads `c ↦ c g` under the trivialization.

## Main results

* `Stacks.Chow.SectionZeroScheme.injective_stalk_of_nonZeroDivisor_mem`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

universe u

namespace Stacks.Chow.SectionZeroScheme

variable {Y : Scheme.{u}} (L : Y.Modules)
  [AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property L]

omit [AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property L] in
/-- The map of modules `𝒪_Y ⟶ L` corresponding to a section `t` sends `c` to `c • t`. -/
theorem unitHomEquiv_symm_val_app_apply (t : L.sections) (W : Y.Opens) (c : Γ(Y, W)) :
    (L.unitHomEquiv.symm t).val.app (op W) c = c • (show Γ(L, W) from t.eval (op W)) :=
  (Stacks.SheafOfModules.app_unit_eq (L.unitHomEquiv.symm t) (op W) c).trans
    (congrArg (fun z : Γ(L, W) => c • z)
      (Stacks.SheafOfModules.unitHomEquiv_symm_app_unitOne t (op W)))

omit [AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property L] in
/-- The value of a section on `W` is the restriction of its global value. -/
theorem sections_eval_eq_map_top (t : L.sections) (W : Y.Opens) :
    (show Γ(L, W) from t.eval (op W)) =
      L.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op (t.eval (op ⊤)) :=
  (PresheafOfModules.sections_property t (homOfLE (le_top : W ≤ ⊤)).op).symm

omit [AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property L] in
/-- A trivialization of `L` over `U` commutes with restriction to smaller opens. -/
theorem trivialization_naturality_apply {U : Y.Opens}
    (eU : L.over U ≅ SheafOfModules.unit (Y.ringCatSheaf.over U)) {V W : Y.Opens} (hV : V ≤ U)
    (hWV : W ≤ V) (m : Γ(L, V)) :
    (eU.hom.val.app (op (Over.mk (homOfLE (hWV.trans hV))))).hom
        (L.presheaf.map (homOfLE hWV).op m) =
      Y.presheaf.map (homOfLE hWV).op ((eU.hom.val.app (op (Over.mk (homOfLE hV)))).hom m) :=
  PresheafOfModules.naturality_apply eU.hom.val
    (Over.homMk (homOfLE hWV) : Over.mk (homOfLE (hWV.trans hV)) ⟶ Over.mk (homOfLE hV)).op m

omit [AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property L] in
/-- Multiplication by a section is injective on the stalk at `y` when, under a trivialization
`eU` of `L` on an affine neighbourhood `U` of `y`, the germ of the function `g` corresponding to
the section is a nonzerodivisor. -/
theorem injective_stalk_of_frame (t : L.sections) (y : Y) (U : Y.affineOpens)
    (eU : L.over U.1 ≅ SheafOfModules.unit (Y.ringCatSheaf.over U.1)) (hyU : y ∈ U.1)
    (g : Γ(Y, U.1))
    (hg_def : (eU.hom.val.app (op (Over.mk (homOfLE (le_refl U.1))))).hom
      (show Γ(L, U.1) from L.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op (t.eval (op ⊤))) = g)
    (hg : Y.presheaf.germ U.1 y hyU g ∈ nonZeroDivisors (Y.presheaf.stalk y)) :
    Function.Injective (ConcreteCategory.hom
      ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} y).map
        ((Scheme.Modules.toPresheaf Y).map (L.unitHomEquiv.symm t)))) := by
  let ψ : ∀ (V : Y.Opens) (_ : V ≤ U.1), Γ(L, V) →ₗ[Γ(Y, V)] Γ(Y, V) := fun V hV =>
    (eU.hom.val.app (op (Over.mk (homOfLE hV)))).hom
  refine (injective_iff_map_eq_zero _).2 fun w hw => ?_
  obtain ⟨V, hVU, hyV, c, rfl⟩ := TopCat.Presheaf.exists_le_germ_eq _ w hyU
  rw [TopCat.Presheaf.stalkFunctor_map_germ_apply] at hw
  obtain ⟨W, hyW, iV, iV', hW⟩ := TopCat.Presheaf.germ_eq _ y hyV hyV _ 0
    (hw.trans (map_zero _).symm)
  have hWV : W ≤ V := leOfHom iV
  have hWU : W ≤ U.1 := hWV.trans hVU
  let c' : Γ(Y, W) := Y.presheaf.map (homOfLE hWV).op c
  have h₁ : L.presheaf.map iV.op ((L.unitHomEquiv.symm t).val.app (op V) c) =
      (L.unitHomEquiv.symm t).val.app (op W) c' :=
    (PresheafOfModules.naturality_apply (L.unitHomEquiv.symm t).val iV.op c).symm
  have hzero : c' • (show Γ(L, W) from t.eval (op W)) = 0 :=
    (unitHomEquiv_symm_val_app_apply L t W c').symm.trans (h₁.symm.trans (hW.trans (map_zero _)))
  have hres : L.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op (t.eval (op ⊤)) =
      L.presheaf.map (homOfLE hWU).op
        (L.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op (t.eval (op ⊤))) :=
    (congrArg (fun φ => (ConcreteCategory.hom φ) (t.eval (op ⊤)))
      (L.presheaf.map_comp (homOfLE (le_top : U.1 ≤ ⊤)).op (homOfLE hWU).op)).trans
      (ConcreteCategory.comp_apply _ _ _)
  have hψt : ψ W hWU (show Γ(L, W) from t.eval (op W)) = Y.presheaf.map (homOfLE hWU).op g :=
    (congrArg (ψ W hWU) ((sections_eval_eq_map_top L t W).trans hres)).trans
      ((trivialization_naturality_apply L eU le_rfl hWU _).trans
        (congrArg (Y.presheaf.map (homOfLE hWU).op) hg_def))
  have hprod : c' * Y.presheaf.map (homOfLE hWU).op g = 0 :=
    (congrArg (fun z => c' * z) hψt).symm.trans
      (((ψ W hWU).map_smul c' _).symm.trans ((congrArg (ψ W hWU) hzero).trans (map_zero _)))
  have hgerm : Y.presheaf.germ V y hyV c * Y.presheaf.germ U.1 y hyU g = 0 := by
    have h := congrArg (Y.presheaf.germ W y hyW) hprod
    rw [map_mul, map_zero] at h
    exact (congrArg₂ (· * ·) (TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE hWV) y hyW c).symm
      (TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE hWU) y hyW g).symm).trans h
  have hc0 : Y.presheaf.germ V y hyV c = Y.presheaf.germ V y hyV 0 :=
    ((mul_right_mem_nonZeroDivisors_eq_zero_iff hg).1 hgerm).trans (map_zero _).symm
  obtain ⟨W', hyW', j, j', hj⟩ := TopCat.Presheaf.germ_eq Y.presheaf y hyV hyV c 0 hc0
  exact (TopCat.Presheaf.germ_res_apply ((Scheme.Modules.toPresheaf Y).obj
    (SheafOfModules.unit Y.ringCatSheaf)) j y hyW' c).symm.trans
    ((congrArg (((Scheme.Modules.toPresheaf Y).obj
      (SheafOfModules.unit Y.ringCatSheaf)).germ W' y hyW') (hj.trans (map_zero _))).trans
      (map_zero _))

/-- **Multiplication by a section is injective on the stalk at a point where the ideal of its
zero scheme contains a nonzerodivisor.** -/
theorem injective_stalk_of_nonZeroDivisor_mem (t : L.sections) (y : Y)
    (hy : y ∈ (Stacks.Divisors.zeroScheme Y L (t.eval (op ⊤))).support)
    (a : Y.presheaf.stalk y) (ha : a ∈ nonZeroDivisors (Y.presheaf.stalk y))
    (hmem : a ∈ Stacks.AlgebraicGeometry.stalkIdeal
      (Stacks.Divisors.zeroScheme Y L (t.eval (op ⊤))) y hy) :
    Function.Injective (ConcreteCategory.hom
      ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} y).map
        ((Scheme.Modules.toPresheaf Y).map (L.unitHomEquiv.symm t)))) := by
  obtain ⟨U, eU, hyU, -⟩ := Stacks.Divisors.exists_affine_frame_subset Y L y ⊤ trivial
  let ψ : Γ(L, U.1) →ₗ[Γ(Y, U.1)] Γ(Y, U.1) :=
    (eU.hom.val.app (op (Over.mk (homOfLE (le_refl U.1))))).hom
  have hbij : Function.Bijective ψ :=
    ⟨Function.LeftInverse.injective
        (g := (eU.inv.val.app (op (Over.mk (homOfLE (le_refl U.1))))).hom)
        fun m => Stacks.SheafOfModules.inv_val_app_hom_val_app eU
          (op (Over.mk (homOfLE (le_refl U.1)))) m,
      fun z => ⟨_, Stacks.SheafOfModules.hom_val_app_inv_val_app eU
        (op (Over.mk (homOfLE (le_refl U.1)))) z⟩⟩
  let g : Γ(Y, U.1) := ψ (L.presheaf.map (homOfLE le_top).op (t.eval (op ⊤)))
  have hstalk : Stacks.AlgebraicGeometry.stalkIdeal
      (Stacks.Divisors.zeroScheme Y L (t.eval (op ⊤))) y hy =
        Ideal.span {Y.presheaf.germ U.1 y hyU g} := by
    rw [Stacks.AlgebraicGeometry.stalkIdeal_eq_map_germ _ y hy U.2 hyU,
      Stacks.Divisors.zeroScheme_ideal_of_trivialization Y L (t.eval (op ⊤)) U
        (LinearEquiv.ofBijective ψ hbij) g rfl, Ideal.map_span, Set.image_singleton]
  exact injective_stalk_of_frame L t y U eU hyU g rfl
    (Stacks.Divisors.mem_nonZeroDivisors_of_mem_span_singleton ha (hstalk ▸ hmem))

end Stacks.Chow.SectionZeroScheme

end
