module

public import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassArbitraryRank.TotalChernClass
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassArbitraryRank.RankClass
public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassDerived.PerfectTwist
public import StacksFrontier.AlgebraicGeometry.Chow.SectionZeroScheme.ArbitraryRank
public import StacksFrontier.AlgebraicGeometry.Chow.SplittingPrinciple.ChernGrading
public import StacksCore.Tactic.StacksAttribute

/-!
# Polynomials in the rank and the Chern classes

Let `(S, δ)` be as in Situation 02QL, let `X` be locally of finite type over `S` and let `ℰ` be a
finite locally free `𝒪_X`-module whose rank need not be constant. Grade
`𝐙[r, c₁, c₂, c₃, …]` by giving `r` degree `0` and `c_i` degree `i`
(`AlgebraicGeometry.ChernPolynomial`). [Stacks, Tag 0FA7] evaluates a homogeneous polynomial `P`
of degree `p` at the rank `r(ℰ)` and the Chern classes `c_i(ℰ)` of Stacks 0ESW,

  `P(ℰ) = P(r(ℰ), c₁(ℰ), c₂(ℰ), c₃(ℰ), …) ∈ A^p(X)`,

and observes that relations among these classes may be proved locally on `X`, on the open and
closed pieces where the ranks are constant.

## The construction

The classes live in the ring `∏_{q ≥ 0} A^q(X)` of total classes (`Stacks.Chow.TotalChowClass`),
which is not commutative, so a polynomial is evaluated in the commutative subring generated by a
pairwise commuting family (`Stacks.Chow.commEval`). The rank `r(ℰ)` is the class acting by `r` on
the piece `X_r` where `ℰ` has rank `r` (`Stacks.Chow.rankTotalClass`), glued over the pieces by
Stacks 0FDZ; `c_i(ℰ)` is the degree-`i` component of the total Chern class of Stacks 0ESW.
These classes commute pairwise: on a piece where the ranks are constant the rank is an integer
multiple of `1`, and two Chern classes commute by Stacks 02UA.

## Main definitions

* `Stacks.Chow.commEval` — evaluation of an integral polynomial at a pairwise commuting family in
  a ring.
* `Stacks.Chow.rankTotalClass` — the rank `r(ℰ) ∈ A^0(X)` of Stacks 0ESW, as a total class.
* `Stacks.Chow.chernVariable` — the values `r(ℰ)` and `c_i(ℰ)` of the variables of
  `𝐙[r, c₁, c₂, …]`.
* `Stacks.Chow.chernPolynomialClass` — **Stacks 0FA7**, the class `P(ℰ)`.

## Main results

* `Stacks.Chow.chernPolynomialClass_isHomogeneous` — **Stacks 0FA7**: for `P` homogeneous of
  degree `p`, `P(ℰ)` lies in `A^p(X)`.
* `Stacks.Chow.res_chernPolynomialClass_of_rank` — **Stacks 0FA7**, working locally: along a
  morphism over which `ℰ` acquires a constant rank `r`, `P(ℰ)` restricts to `P` evaluated at `r`
  and the Chern classes of Stacks 0B7H of the pullback.

## References

* [Stacks Project, Tag 0FA7](https://stacks.math.columbia.edu/tag/0FA7)
* [Stacks Project, Tag 0ESW](https://stacks.math.columbia.edu/tag/0ESW)
* [Stacks Project, Tag 0FDZ](https://stacks.math.columbia.edu/tag/0FDZ)
* [Stacks Project, Tag 02UA](https://stacks.math.columbia.edu/tag/02UA)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory MvPolynomial

universe u

namespace Stacks.Chow

/-! ### Evaluation at a commuting family -/

section CommEval

variable {R : Type*} [Ring R] {σ : Type*} (z : σ → R)

/-- The subring generated by a family of elements of a ring. -/
abbrev commEvalSubring : Subring R :=
  Subring.closure (Set.range z)

variable {z} (hz : ∀ i j, Commute (z i) (z j))

include hz in
/-- The subring generated by a pairwise commuting family is commutative. -/
theorem isMulCommutative_commEvalSubring : IsMulCommutative (commEvalSubring z) :=
  Subring.isMulCommutative_closure (by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
    exact fun _ ↦ hz i j)

open scoped IsMulCommutative in
/-- **Evaluation of an integral polynomial at a pairwise commuting family** of elements of a
ring, which need not be commutative: the evaluation in the commutative subring the family
generates, followed by the inclusion. -/
def commEval : MvPolynomial σ ℤ →+* R :=
  haveI := isMulCommutative_commEvalSubring hz
  (commEvalSubring z).subtype.comp
    (eval₂Hom (Int.castRingHom (commEvalSubring z))
      fun i ↦ ⟨z i, Subring.subset_closure ⟨i, rfl⟩⟩)

/-- The evaluation sends the variable `X i` to `z i`. -/
@[simp]
theorem commEval_X (i : σ) : commEval hz (X i) = z i := by
  simp [commEval]

/-- **Evaluation at a commuting family is the only ring homomorphism with the prescribed values
on the variables.** -/
theorem eq_commEval {f : MvPolynomial σ ℤ →+* R} (hf : ∀ i, f (X i) = z i) :
    f = commEval hz := by
  refine MvPolynomial.ringHom_ext (fun n ↦ ?_) fun i ↦ by rw [hf, commEval_X]
  rw [← RingHom.comp_apply, ← RingHom.comp_apply, RingHom.ext_int (f.comp C)
    ((commEval hz).comp C)]

/-- **Evaluation commutes with ring homomorphisms.** -/
theorem map_commEval {R' : Type*} [Ring R'] (φ : R →+* R') (P : MvPolynomial σ ℤ) :
    φ (commEval hz P) = commEval (fun i j ↦ (hz i j).map φ) P :=
  RingHom.congr_fun (eq_commEval (z := fun i ↦ φ (z i)) (fun i j ↦ (hz i j).map φ)
    (f := φ.comp (commEval hz)) fun i ↦ by rw [RingHom.comp_apply, commEval_X]) P

/-- Evaluations at two families agreeing on the variables agree. -/
theorem commEval_congr {z' : σ → R} (hz' : ∀ i j, Commute (z' i) (z' j)) (h : ∀ i, z i = z' i)
    (P : MvPolynomial σ ℤ) : commEval hz P = commEval hz' P :=
  RingHom.congr_fun (eq_commEval hz' (f := commEval hz) fun i ↦ by rw [commEval_X, h]) P

/-- **Evaluation of a weighted homogeneous polynomial is homogeneous.** For a grading of `R` by
additive subgroups `A n` with `1 ∈ A 0` and `A m * A n ⊆ A (m + n)`, if each `z i` lies in
`A (w i)`, then the evaluation of a polynomial of weighted degree `p` lies in `A p`. -/
theorem commEval_mem {A : ℕ → AddSubgroup R} [SetLike.GradedMonoid A] {w : σ → ℕ}
    (hw : ∀ i, z i ∈ A (w i)) {p : ℕ} {P : MvPolynomial σ ℤ}
    (hP : P ∈ weightedHomogeneousSubmodule ℤ w p) : commEval hz P ∈ A p := by
  classical
  rw [mem_weightedHomogeneousSubmodule] at hP
  -- a product of powers of variables evaluates into the degree of its weight
  have hprod : ∀ (d : σ →₀ ℕ) (t : Finset σ),
      commEval hz (∏ i ∈ t, X i ^ d i) ∈ A (∑ i ∈ t, d i * w i) := by
    intro d t
    induction t using Finset.induction_on with
    | empty =>
      rw [Finset.prod_empty, map_one, Finset.sum_empty]
      exact SetLike.GradedOne.one_mem
    | insert a t ha ih =>
      rw [Finset.prod_insert ha, map_mul, Finset.sum_insert ha, map_pow, commEval_X]
      have h1 : z a ^ d a ∈ A (d a • w a) := SetLike.pow_mem_graded (d a) (hw a)
      rw [smul_eq_mul] at h1
      exact SetLike.mul_mem_graded h1 ih
  rw [P.as_sum, map_sum]
  refine AddSubgroup.sum_mem _ fun d hd ↦ ?_
  have hdeg : ∑ i ∈ d.support, d i * w i = p := by
    rw [← hP (mem_support_iff.mp hd), Finsupp.weight_apply, Finsupp.sum]
    simp only [smul_eq_mul]
  rw [monomial_eq, map_mul, Finsupp.prod, ← hdeg,
    show commEval hz (C (P.coeff d)) = ((P.coeff d : ℤ) : R) from
      eq_intCast ((commEval hz).comp C) _, ← zsmul_eq_mul]
  exact AddSubgroup.zsmul_mem _ (hprod d d.support) _

end CommEval

/-! ### The grading of the ring of total classes -/

namespace TotalChowClass

variable {C : ChowSituation.{u}} {Y : Scheme.{u}} {sY : Y ⟶ C.S} [LocallyOfFiniteType sY]

/-- A total class is homogeneous of degree `i` exactly when it is its own degree-`i` component. -/
theorem isHomogeneous_iff_homComponent_eq {i : ℕ} {c : TotalChowClass C sY} :
    c.IsHomogeneous i ↔ homComponent i c = c := by
  refine ⟨fun h ↦ ext fun p ↦ ?_, fun h p hp ↦ by rw [← h, homComponent_apply, ite_eq_right hp]⟩
  rw [homComponent_apply]
  split_ifs with hp
  · rfl
  · exact (h p hp).symm

/-- **The product of homogeneous total classes is homogeneous**, of the sum of the degrees: on
every test scheme this is the corresponding fact for graded cap families. -/
theorem IsHomogeneous.mul {i j : ℕ} {c d : TotalChowClass C sY} (hc : c.IsHomogeneous i)
    (hd : d.IsHomogeneous j) : (c * d).IsHomogeneous (i + j) := by
  rw [isHomogeneous_iff_homComponent_eq]
  refine ext_op fun g _ ↦ ?_
  rw [op_homComponent, op_mul]
  exact ((hc.op g).mul (hd.op g)).homComponent_self

/-- The unit is homogeneous of degree `0`. -/
theorem isHomogeneous_one : (1 : TotalChowClass C sY).IsHomogeneous 0 :=
  fun _ hp ↦ one_apply_of_ne hp

variable (C sY) in
/-- The total classes homogeneous of degree `i`, which form the subgroup `A^i(Y)` of
`∏_{q ≥ 0} A^q(Y)`. -/
def homogeneousSubgroup (i : ℕ) : AddSubgroup (TotalChowClass C sY) where
  carrier := {c | c.IsHomogeneous i}
  zero_mem' := fun p _ ↦ zero_apply p
  add_mem' := fun {a b} ha hb p hp ↦ by
    rw [add_apply, show a p = 0 from ha p hp, show b p = 0 from hb p hp, add_zero]
  neg_mem' := fun {a} ha p hp ↦ by rw [neg_apply, show a p = 0 from ha p hp, neg_zero]

/-- A total class lies in `homogeneousSubgroup C sY i` if and only if it is homogeneous of
degree `i`. -/
theorem mem_homogeneousSubgroup {i : ℕ} {c : TotalChowClass C sY} :
    c ∈ homogeneousSubgroup C sY i ↔ c.IsHomogeneous i :=
  Iff.rfl

/-- The homogeneous total classes form a graded monoid. -/
instance : SetLike.GradedMonoid (homogeneousSubgroup C sY) where
  one_mem := isHomogeneous_one
  mul_mem := fun _ _ _ _ ha hb ↦ IsHomogeneous.mul ha hb

end TotalChowClass

/-! ### Locally constant integers, and the rank -/

section RankClass

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
  (E : X.Modules) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]

/-- **The degree-zero class of an integer-valued function of the rank.** For `f : ℕ → ℤ`, the total
class which is `f r` times `1` on the open and closed piece `X_r` where `ℰ` has rank `r`, glued by
Stacks 0FDZ. -/
def rankFunctionClass (f : ℕ → ℤ) : TotalChowClass C sX :=
  TotalChowClass.glue (isClopenDecomposition_rankLociFamily E) fun r ↦ f r.down • 1

/-- **The rank `r(ℰ) ∈ A^0(X)` of Stacks 0ESW**, as a total class: on the piece `X_r` it is `r`
times `1`, so it sends `(α_r) ∈ ∏_r CH_*(X'_r)` to `(r α_r)`. Its degree-zero component is
`Stacks.Chow.rankBivariantClass` (`Stacks.Chow.rankTotalClass_apply_zero`). -/
def rankTotalClass : TotalChowClass C sX :=
  rankFunctionClass C sX E fun r ↦ r

/-- On the piece `X_r` the class of `f` is `f r` times `1`. -/
theorem res_rankFunctionClass_rankLocus (f : ℕ → ℤ) (r : ℕ) :
    TotalChowClass.res (rankLocus E r).ι rfl (rankFunctionClass C sX E f) = f r • 1 :=
  TotalChowClass.res_glue (isClopenDecomposition_rankLociFamily E) _ (ULift.up r)

/-- **Along a morphism over which `ℰ` has constant rank `r`, the class of `f` restricts to `f r`
times `1`.** -/
theorem res_rankFunctionClass_of_rank {Y' : Scheme.{u}} {sY' : Y' ⟶ C.S}
    [LocallyOfFiniteType sY'] (h : Y' ⟶ X) [LocallyOfFiniteType h] (hs : h ≫ sX = sY') (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback h).obj E) r] (f : ℕ → ℤ) :
    TotalChowClass.res h hs (rankFunctionClass C sX E f) = f r • 1 := by
  have hU := isClopenDecomposition_rankLociFamily E
  refine TotalChowClass.eq_of_res_eq (hU.preimage h) fun ρ ↦ ?_
  have ha : ∀ ρ, h ⁻¹ᵁ rankLociFamily E ρ ≤ h ⁻¹ᵁ rankLociFamily E (id ρ) := fun _ ↦ le_rfl
  have hfac : (h ⁻¹ᵁ rankLociFamily E ρ).ι ≫ h =
      pieceMap h (fun ρ ↦ h ⁻¹ᵁ rankLociFamily E ρ) (rankLociFamily E) id ha ρ ≫
        (rankLociFamily E ρ).ι :=
    (pieceMap_comp_ι h _ _ id ha ρ).symm
  have hpm : pieceMap h (fun ρ ↦ h ⁻¹ᵁ rankLociFamily E ρ) (rankLociFamily E) id ha ρ ≫
      ((rankLociFamily E ρ).ι ≫ sX) = (h ⁻¹ᵁ rankLociFamily E ρ).ι ≫ sY' := by
    rw [← Category.assoc, ← hfac, Category.assoc, hs]
  rw [TotalChowClass.res_res, TotalChowClass.res_congr hfac _ (by rw [Category.assoc, hpm]),
    ← TotalChowClass.res_res (rankLociFamily E ρ).ι rfl _ hpm, rankFunctionClass,
    TotalChowClass.res_glue]
  simp only [map_zsmul, map_one]
  rcases isEmpty_or_nonempty (h ⁻¹ᵁ rankLociFamily E ρ : Scheme.{u}) with hW | ⟨⟨x, hx⟩⟩
  · have := TotalChowClass.subsingleton_of_isEmpty (C := C) ((h ⁻¹ᵁ rankLociFamily E ρ).ι ≫ sY')
    exact Subsingleton.elim _ _
  · have h1 : moduleRank E (h x) = ρ.down := hx
    have h2 : moduleRank E (h x) = r :=
      SectionZeroScheme.mem_rankLocus_of_isFiniteLocallyFreeOfRank_pullback E h r x
    rw [← h1, h2]

/-- Two total classes agreeing on every piece `X_r` where `ℰ` has constant rank `r` are equal. -/
private theorem eq_of_res_rankLocus_eq {a b : TotalChowClass C sX}
    (h : ∀ r : ℕ, TotalChowClass.res (rankLocus E r).ι rfl a =
      TotalChowClass.res (rankLocus E r).ι rfl b) : a = b :=
  TotalChowClass.eq_of_res_eq (isClopenDecomposition_rankLociFamily E) fun ρ ↦ h ρ.down

/-- The class of `f` is homogeneous of degree `0`. -/
theorem isHomogeneous_rankFunctionClass (f : ℕ → ℤ) :
    (rankFunctionClass C sX E f).IsHomogeneous 0 := by
  rw [TotalChowClass.isHomogeneous_iff_homComponent_eq]
  refine eq_of_res_rankLocus_eq C sX E fun r ↦ ?_
  rw [TotalChowClass.res_homComponent, res_rankFunctionClass_rankLocus, map_zsmul,
    TotalChowClass.homComponent_one, ite_eq_left rfl]

/-- **The class of `f` is central**: on each piece `X_r` it is an integer multiple of `1`. -/
theorem commute_rankFunctionClass (f : ℕ → ℤ) (c : TotalChowClass C sX) :
    Commute (rankFunctionClass C sX E f) c := by
  show _ * _ = _ * _
  refine eq_of_res_rankLocus_eq C sX E fun r ↦ ?_
  rw [map_mul, map_mul, res_rankFunctionClass_rankLocus, zsmul_eq_mul, mul_one]
  exact (Int.cast_commute _ _).eq

/-- The classes of functions of the rank add as the functions do. -/
theorem rankFunctionClass_add (f g : ℕ → ℤ) :
    rankFunctionClass C sX E (f + g) = rankFunctionClass C sX E f + rankFunctionClass C sX E g := by
  refine eq_of_res_rankLocus_eq C sX E fun r ↦ ?_
  rw [map_add, res_rankFunctionClass_rankLocus, res_rankFunctionClass_rankLocus,
    res_rankFunctionClass_rankLocus, Pi.add_apply, add_smul]

/-- The classes of functions of the rank multiply as the functions do. -/
theorem rankFunctionClass_mul (f g : ℕ → ℤ) :
    rankFunctionClass C sX E (f * g) = rankFunctionClass C sX E f * rankFunctionClass C sX E g := by
  refine eq_of_res_rankLocus_eq C sX E fun r ↦ ?_
  rw [map_mul, res_rankFunctionClass_rankLocus, res_rankFunctionClass_rankLocus,
    res_rankFunctionClass_rankLocus, Pi.mul_apply]
  simp only [zsmul_eq_mul, mul_one, Int.cast_mul]

/-- The class of a constant function is that constant. -/
theorem rankFunctionClass_const (n : ℤ) :
    rankFunctionClass C sX E (fun _ ↦ n) = (n : TotalChowClass C sX) := by
  refine eq_of_res_rankLocus_eq C sX E fun r ↦ ?_
  rw [res_rankFunctionClass_rankLocus, map_intCast, zsmul_eq_mul, mul_one]

/-- The class of `f` only depends on `f`. -/
theorem rankFunctionClass_congr {f g : ℕ → ℤ} (h : ∀ r, f r = g r) :
    rankFunctionClass C sX E f = rankFunctionClass C sX E g :=
  congrArg _ (funext h)

/-- The unit `1 ∈ A^0(W)` of `Stacks.Chow.TotalChowClass` is the unit
`Stacks.Chow.chowCohomologyOne` from which Stacks 0ESW builds the rank: both act as the identity on
every test scheme. -/
theorem one_apply_zero_eq_chowCohomologyOne {W : Scheme.{u}} (sW : W ⟶ C.S)
    [LocallyOfFiniteType sW]
    (hflat : IdentityCapRule.TransportFlatNaturality C sW 0 (identityCapRuleZero C sW))
    (hgysin : IdentityCapRule.TransportGysinNaturality C sW 0 (identityCapRuleZero C sW)
      (gysinSystemOfInvertible C)) :
    (1 : TotalChowClass C sW) 0 =
      chowCohomologyOne C sW (gysinSystemOfInvertible C) hflat hgysin := by
  refine BivariantClass.eq_of_idRule_eq C sW _ _ _ fun g _ k α ↦ eq_of_heq ?_
  have h1 : ((1 : TotalChowClass C sW) 0).idRule C sW (gysinSystemOfInvertible C) g k α ≍ α := by
    rw [← TotalChowClass.op_apply, TotalChowClass.op_one, gradedCap_one_apply_zero]
    exact gradedDegreeCast_heq _ _
  have h2 : (chowCohomologyOne C sW (gysinSystemOfInvertible C) hflat hgysin).idRule C sW
      (gysinSystemOfInvertible C) g k α = chowGroupDegreeEquiv C (g ≫ sW) (by omega) α := by
    simpa only [identityBaseChangeIso, asIso_hom, BivariantClass.idRule_apply, pullbackSndPush]
      using chowCohomologyOne_cap C sW (gysinSystemOfInvertible C) hflat hgysin g k α
  rw [h2]
  exact h1.trans (chowGroupDegreeEquiv_heq C (g ≫ sW) _ α).symm

/-- **The degree-zero component of `r(ℰ)` is the rank class of Stacks 0ESW**,
`Stacks.Chow.rankBivariantClass`, for any proof of the Gysin transport it carries. -/
theorem rankTotalClass_apply_zero
    (hgysin : ∀ r : ℕ, IdentityCapRule.TransportGysinNaturality C ((rankLocus E r).ι ≫ sX) 0
      (identityCapRuleZero C ((rankLocus E r).ι ≫ sX)) (gysinSystemOfInvertible C)) :
    rankTotalClass C sX E 0 = rankBivariantClass C (gysinSystemOfInvertible C) sX E
      (gysinSystemOfInvertible_isNaturalUnderOpenImmersion C)
      (gysinSystemOfInvertible_isNaturalUnderOpensRestriction C)
      (gysinSystemOfInvertible_isNaturalUnderPullbackComp C) hgysin := by
  refine eq_rankBivariantClass_of_rankLocusRestriction_eq C _ sX E _ _ _ hgysin fun r ↦ ?_
  refine (rankLocusRestriction_eq_res C sX E (rankTotalClass C sX E) 0 r).trans ?_
  rw [rankTotalClass, rankFunctionClass, TotalChowClass.res_glue]
  show (r : ℤ) • (1 : TotalChowClass C ((rankLocus E r).ι ≫ sX)) 0 = _
  rw [one_apply_zero_eq_chowCohomologyOne]

end RankClass

/-! ### The Chern classes of Stacks 0ESW in the ring of total classes -/

section ChernClasses

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

/-- The degree-`p` component of the total Chern class of Stacks 0ESW is the Chern class
`Stacks.Chow.SectionZeroScheme.chernClassOfLocallyFree` of Stacks 0ESW. -/
theorem totalChernClassOfModule_apply_eq_chernClassOfLocallyFree (E : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] (p : ℕ) :
    totalChernClassOfModule C sX E p = SectionZeroScheme.chernClassOfLocallyFree E C sX p :=
  totalChernClassOfModule_apply C sX E p

/-- **The Chern classes of two finite locally free modules commute** in the ring of total classes,
whatever their ranks: on the pieces where both ranks are constant this is Stacks 02UA. -/
theorem commute_homComponent_totalChernClassOfModule (E F : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} F] (i j : ℕ) :
    Commute (TotalChowClass.homComponent i (totalChernClassOfModule C sX E))
      (TotalChowClass.homComponent j (totalChernClassOfModule C sX F)) := by
  show _ * _ = _ * _
  refine TotalChowClass.eq_of_res_eq_of_rank E F fun V a b ha hb ↦ ?_
  have := ha
  have := hb
  rw [map_mul, map_mul, TotalChowClass.res_homComponent, TotalChowClass.res_homComponent,
    res_totalChernClassOfModule_of_rank C sX E V.ι rfl a,
    res_totalChernClassOfModule_of_rank C sX F V.ι rfl b]
  exact (commute_homComponent_totalChern C (V.ι ≫ sX) _ _ a b i j).eq

end ChernClasses

/-! ### Polynomials in the rank and the Chern classes -/

section Polynomial

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

/-- The values of the variables of `𝐙[r, c₁, c₂, …]` at a module `ℱ` of constant rank `s`: the
integer `s` for `r`, and the Chern class `c_i(ℱ)` of Stacks 0B7H for `c_i`. -/
def chernVariableOfRank (F : X.Modules) (s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s] :
    Option ℕ+ → TotalChowClass C sX
  | none => (s : ℤ) • 1
  | some i => TotalChowClass.homComponent i (totalChern C sX F s)

/-- The values of the variables at a module of constant rank commute pairwise. -/
theorem commute_chernVariableOfRank (F : X.Modules) (s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s]
    (o o' : Option ℕ+) :
    Commute (chernVariableOfRank C sX F s o) (chernVariableOfRank C sX F s o') := by
  rcases o with _ | i
  · exact (Commute.one_left _).smul_left _
  · rcases o' with _ | j
    · exact ((Commute.one_left _).smul_left _).symm
    · exact commute_homComponent_totalChern C sX F F s s i j

/-- **The polynomial `P(ℱ)` of a module of constant rank `s`**: `P` evaluated at `s` and the Chern
classes `c_i(ℱ)` of Stacks 0B7H, in the ring of total classes. -/
def chernPolynomialClassOfRank (F : X.Modules) (s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F s] :
    ChernPolynomial →+* TotalChowClass C sX :=
  commEval (commute_chernVariableOfRank C sX F s)

variable (E : X.Modules) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]

/-- **The values of the variables of `𝐙[r, c₁, c₂, …]` at `ℰ`** (Stacks 0FA7): the rank
`r(ℰ) ∈ A^0(X)` for `r`, and the Chern class `c_i(ℰ) ∈ A^i(X)` of Stacks 0ESW for `c_i`. -/
def chernVariable : Option ℕ+ → TotalChowClass C sX
  | none => rankTotalClass C sX E
  | some i => TotalChowClass.homComponent i (totalChernClassOfModule C sX E)

/-- **The rank and the Chern classes commute pairwise**, the rank being central and two Chern
classes commuting by Stacks 02UA. -/
theorem commute_chernVariable (o o' : Option ℕ+) :
    Commute (chernVariable C sX E o) (chernVariable C sX E o') := by
  rcases o with _ | i
  · exact commute_rankFunctionClass C sX E _ _
  · rcases o' with _ | j
    · exact (commute_rankFunctionClass C sX E _ _).symm
    · exact commute_homComponent_totalChernClassOfModule C sX E E i j

/-- The value of the variable of degree `w` lies in `A^w(X)`. -/
theorem chernVariable_mem (o : Option ℕ+) :
    chernVariable C sX E o ∈ TotalChowClass.homogeneousSubgroup C sX (chernPolynomialWeight o) := by
  rcases o with _ | i
  · exact isHomogeneous_rankFunctionClass C sX E _
  · exact TotalChowClass.isHomogeneous_homComponent _ _

/-- **Stacks 0FA7, the class `P(ℰ)`.** For `ℰ` finite locally free on `X`, of rank not necessarily
constant, and `P ∈ 𝐙[r, c₁, c₂, c₃, …]`,

  `P(ℰ) = P(r(ℰ), c₁(ℰ), c₂(ℰ), c₃(ℰ), …)`,

the evaluation of `P` at the rank `r(ℰ)` and the Chern classes `c_i(ℰ)` of Stacks 0ESW in the
ring `∏_{q ≥ 0} A^q(X)` of total classes. These classes commute pairwise
(`Stacks.Chow.commute_chernVariable`), so the evaluation is a ring homomorphism; for `P`
homogeneous of degree `p` the class lies in `A^p(X)`
(`Stacks.Chow.chernPolynomialClass_isHomogeneous`). -/
@[stacks 0FA7 "the class P(E) = P(r(E), c_1(E), c_2(E), ...) for P in Z[r, c_1, c_2, ...] and E \
finite locally free of rank not necessarily constant, at the rank and Chern classes of Tag 0ESW; \
it lies in A^p(X) for P homogeneous of degree p by \
Stacks.Chow.chernPolynomialClass_isHomogeneous"]
def chernPolynomialClass : ChernPolynomial →+* TotalChowClass C sX :=
  commEval (commute_chernVariable C sX E)

/-- At the variable `r`, `P(ℰ)` is the rank `r(ℰ)`. -/
@[simp]
theorem chernPolynomialClass_X_none :
    chernPolynomialClass C sX E (MvPolynomial.X none) = rankTotalClass C sX E :=
  commEval_X _ none

/-- At the variable `c_i`, `P(ℰ)` is the Chern class `c_i(ℰ)`. -/
@[simp]
theorem chernPolynomialClass_X_some (i : ℕ+) :
    chernPolynomialClass C sX E (MvPolynomial.X (some i)) =
      TotalChowClass.homComponent i (totalChernClassOfModule C sX E) :=
  commEval_X _ (some i)

/-- **Stacks 0FA7, `P(ℰ) ∈ A^p(X)`.** For `P ∈ 𝐙[r, c₁, c₂, …]` homogeneous of degree `p` for the
grading in which `r` has degree `0` and `c_i` has degree `i`, the class `P(ℰ)` is homogeneous of
degree `p`: all its components outside `A^p(X)` vanish. -/
@[stacks 0FA7 "P(E) lies in A^p(X) for P homogeneous of degree p in the graded ring \
Z[r, c_1, c_2, ...] (r of degree 0, c_i of degree i), for every finite locally free E of rank not \
necessarily constant"]
theorem chernPolynomialClass_isHomogeneous {p : ℕ} {P : ChernPolynomial}
    (hP : P ∈ ChernPolynomial.homogeneousSubmodule p) :
    (chernPolynomialClass C sX E P).IsHomogeneous p :=
  commEval_mem (A := TotalChowClass.homogeneousSubgroup C sX) (commute_chernVariable C sX E)
    (chernVariable_mem C sX E) hP

/-- **The class `P(ℰ) ∈ A^p(X)`** of a homogeneous polynomial `P` of degree `p`, as an element of
the Chow cohomology group `A^p(X)` of Stacks 0B7E: the degree-`p` component of `P(ℰ)`, which is
all of it by `Stacks.Chow.chernPolynomialClass_isHomogeneous`. -/
def chernPolynomialComponent (p : ℕ) (P : ChernPolynomial.homogeneousSubmodule p) :
    chowCohomologyComponent C (gysinSystemOfInvertible C) sX (p : ℤ) :=
  chernPolynomialClass C sX E P p

/-- `P(ℰ)` is its component in `A^p(X)`. -/
theorem homComponent_chernPolynomialClass (p : ℕ) (P : ChernPolynomial.homogeneousSubmodule p) :
    TotalChowClass.homComponent p (chernPolynomialClass C sX E P) = chernPolynomialClass C sX E P :=
  TotalChowClass.isHomogeneous_iff_homComponent_eq.mp
    (chernPolynomialClass_isHomogeneous C sX E P.2)

/-- At the variable `c_i`, the class in `A^i(X)` is the Chern class `c_i(ℰ)` of Stacks 0ESW. -/
theorem chernPolynomialComponent_X_some (i : ℕ+) :
    chernPolynomialComponent C sX E i
        ⟨MvPolynomial.X (some i), isWeightedHomogeneous_X ℤ chernPolynomialWeight (some i)⟩ =
      SectionZeroScheme.chernClassOfLocallyFree E C sX i := by
  rw [chernPolynomialComponent, chernPolynomialClass_X_some, TotalChowClass.homComponent_apply,
    ite_eq_left rfl]
  exact totalChernClassOfModule_apply_eq_chernClassOfLocallyFree C sX E i

/-- At the variable `r`, the class in `A^0(X)` is the rank `r(ℰ)` of Stacks 0ESW,
`Stacks.Chow.rankBivariantClass`. -/
theorem chernPolynomialComponent_X_none
    (hgysin : ∀ r : ℕ, IdentityCapRule.TransportGysinNaturality C ((rankLocus E r).ι ≫ sX) 0
      (identityCapRuleZero C ((rankLocus E r).ι ≫ sX)) (gysinSystemOfInvertible C)) :
    chernPolynomialComponent C sX E 0
        ⟨MvPolynomial.X none, isWeightedHomogeneous_X ℤ chernPolynomialWeight none⟩ =
      rankBivariantClass C (gysinSystemOfInvertible C) sX E
        (gysinSystemOfInvertible_isNaturalUnderOpenImmersion C)
        (gysinSystemOfInvertible_isNaturalUnderOpensRestriction C)
        (gysinSystemOfInvertible_isNaturalUnderPullbackComp C) hgysin := by
  rw [chernPolynomialComponent]
  exact (congrArg (fun c : TotalChowClass C sX ↦ c 0) (chernPolynomialClass_X_none C sX E)).trans
    (rankTotalClass_apply_zero C sX E hgysin)

/-- **Stacks 0FA7, working locally on `X`.** Along a morphism `h : Y' ⟶ X` over which `h^*ℰ` has
constant rank `s` — for instance the inclusion of a piece where the rank of `ℰ` is `s` — the class
`P(ℰ)` restricts to `P` evaluated at the integer `s` and the Chern classes of Stacks 0B7H of the
module `h^*ℰ` of rank `s`. Relations among the classes `P(ℰ)` may therefore be checked on the
pieces of constant rank, as the remark says. -/
@[stacks 0FA7 "relations among the P(E) may be proved locally on X: along a morphism over which E \
has constant rank s, P(E) restricts to P(s, c_1, c_2, ...) of the pullback, at the Chern classes \
of Tag 0B7H"]
theorem res_chernPolynomialClass_of_rank {Y' : Scheme.{u}} {sY' : Y' ⟶ C.S}
    [LocallyOfFiniteType sY'] (h : Y' ⟶ X) [LocallyOfFiniteType h] (hs : h ≫ sX = sY') (s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback h).obj E) s] (P : ChernPolynomial) :
    TotalChowClass.res h hs (chernPolynomialClass C sX E P) =
      chernPolynomialClassOfRank C sY' ((Scheme.Modules.pullback h).obj E) s P := by
  rw [chernPolynomialClass, map_commEval]
  refine commEval_congr _ _ (fun o ↦ ?_) P
  rcases o with _ | i
  · exact res_rankFunctionClass_of_rank C sX E h hs s _
  · show TotalChowClass.res h hs (TotalChowClass.homComponent i _) = _
    rw [TotalChowClass.res_homComponent, res_totalChernClassOfModule_of_rank C sX E h hs s]
    rfl

/-- **On a module of constant rank `s`, `P(ℰ)` is `P` evaluated at `s` and the Chern classes of
Stacks 0B7H.** -/
theorem chernPolynomialClass_eq_ofRank (s : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E s]
    (P : ChernPolynomial) :
    chernPolynomialClass C sX E P = chernPolynomialClassOfRank C sX E s P := by
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback (𝟙 X)).obj E) s :=
    AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback (𝟙 X) E s
  rw [← TotalChowClass.res_id (chernPolynomialClass C sX E P),
    res_chernPolynomialClass_of_rank C sX E (𝟙 X) (Category.id_comp sX) s]
  refine commEval_congr _ _ (fun o ↦ ?_) P
  rcases o with _ | i
  · rfl
  · exact congrArg (TotalChowClass.homComponent i)
      (totalChern_congr C sX ((Scheme.Modules.pullbackId X).app E) rfl)

end Polynomial

end Stacks.Chow

end
