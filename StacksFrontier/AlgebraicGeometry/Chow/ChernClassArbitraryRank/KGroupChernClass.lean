module

public import StacksFrontier.AlgebraicGeometry.Chow.ChernClassArbitraryRank.TotalChernClass
public import StacksFrontier.AlgebraicGeometry.Perfect.VectorBundleKGroup
public import StacksCore.Tactic.StacksAttribute

/-!
# The Chern class map on `K_0(Vect(X))`

Let `(S, δ)` be as in Situation 02QL and let `X` be locally of finite type over `S`.
**Stacks 0FEL** records that the Chern class map defines a canonical map

  `c : K_0(Vect(X)) ⟶ ∏_{i ≥ 0} A^i(X)`

sending a generator `[ℰ]` to `c(ℰ) = 1 + c_1(ℰ) + c_2(ℰ) + …` and extended multiplicatively;
thus `−[ℰ]` goes to the formal inverse `c(ℰ)^{-1}`, which is why the target is the infinite
product, and the map is well defined by the Whitney sum formula, Stacks 02UI.

Here `∏_{i ≥ 0} A^i(X)` is `Stacks.Chow.TotalChowClass`, the ring of families `(a_0, a_1, …)` of
bivariant classes `a_i ∈ A^i(X)` (Stacks 0B7E, at the Gysin system of the first Chern class of an
invertible module) under the Cauchy product of the composition of bivariant classes; it is the
type `Stacks.Chow.chowCohomologySeries` at that Gysin system. The class `c(ℰ)` is
`Stacks.Chow.totalChernClassOfModule`, with components the Chern classes `c_p(ℰ)` of Stacks 0ESW
(which for `ℰ` of constant rank are those of Stacks 0B7H), for a finite locally free module of
any rank.

The ring `∏_{i ≥ 0} A^i(X)` is not known to be commutative, but the total Chern classes commute
with each other (`Stacks.Chow.totalChernClassOfModule_commute`), so they generate a commutative
subgroup of its units, and the Whitney sum formula
(`Stacks.Chow.totalChernClassOfModule_eq_mul_of_shortExact`) is exactly what makes `[ℰ] ↦ c(ℰ)`
descend to a homomorphism from `K_0(Vect(X))` to that group.

## Main definitions

* `Stacks.Chow.totalChernClassUnit` — `c(ℰ)` as a unit, and `1` off the finite locally free
  modules.
* `Stacks.Chow.totalChernUnitGroup` — the commutative group generated by the total Chern classes.
* `Stacks.Chow.totalChernKGroupHom` — the map as a homomorphism from `K_0(Vect(X))` to the group
  of units of `∏_{i ≥ 0} A^i(X)`, written additively.
* `Stacks.Chow.totalChernKGroupMap` — **Stacks 0FEL**, the map
  `c : K_0(Vect(X)) ⟶ ∏_{i ≥ 0} A^i(X)`.

## Main results

* `Stacks.Chow.totalChernKGroupMap_classOf` — `c([ℰ]) = c(ℰ)`.
* `Stacks.Chow.totalChernKGroupMap_add` — `c(α + β) = c(α) c(β)`.
* `Stacks.Chow.totalChernKGroupMap_neg_classOf_mul`,
  `Stacks.Chow.mul_totalChernKGroupMap_neg_classOf`
  — `c(−[ℰ])` is the two-sided inverse of `c(ℰ)`.
* `Stacks.Chow.eq_totalChernKGroupMap` — the map is the only one with these two properties.
* `Stacks.Chow.totalChernKGroupMap_spec` — **Stacks 0FEL**, the remark in full.

## References

* [Stacks Project, Tag 0FEL](https://stacks.math.columbia.edu/tag/0FEL)
* [Stacks Project, Tag 02UI](https://stacks.math.columbia.edu/tag/02UI)
* [Stacks Project, Tag 0ESW](https://stacks.math.columbia.edu/tag/0ESW)
* [Stacks Project, Tag 0FDK](https://stacks.math.columbia.edu/tag/0FDK)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open scoped ZeroObject

universe u

namespace Stacks.Chow

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

open Classical in
/-- The total Chern class `c(ℰ)` of a module as a unit of `∏_{i ≥ 0} A^i(X)`, and `1` when the
module is not finite locally free. -/
def totalChernClassUnit (M : X.Modules) : (TotalChowClass C sX)ˣ :=
  if _h : Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M then
    (isUnit_totalChernClassOfModule C sX M).unit
  else 1

/-- On a finite locally free module, the unit `Stacks.Chow.totalChernClassUnit` is `c(ℰ)`. -/
theorem val_totalChernClassUnit (M : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} M] :
    (totalChernClassUnit C sX M : TotalChowClass C sX) = totalChernClassOfModule C sX M := by
  rw [totalChernClassUnit, dite_eq_left
    ‹Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M›]
  rfl

/-- Off the finite locally free modules, `Stacks.Chow.totalChernClassUnit` is `1`. -/
theorem totalChernClassUnit_of_not (M : X.Modules)
    (hM : ¬ Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M) :
    totalChernClassUnit C sX M = 1 := by
  rw [totalChernClassUnit, dite_eq_right hM]

/-- Any two of the units `Stacks.Chow.totalChernClassUnit` commute. -/
theorem totalChernClassUnit_commute (M N : X.Modules) :
    totalChernClassUnit C sX M * totalChernClassUnit C sX N =
      totalChernClassUnit C sX N * totalChernClassUnit C sX M := by
  by_cases hM : Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M
  · by_cases hN : Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) N
    · refine Units.ext ?_
      rw [Units.val_mul, Units.val_mul, val_totalChernClassUnit, val_totalChernClassUnit]
      exact totalChernClassOfModule_commute C sX M N
    · rw [totalChernClassUnit_of_not C sX N hN, mul_one, one_mul]
  · rw [totalChernClassUnit_of_not C sX M hM, mul_one, one_mul]

/-- **The group generated by the total Chern classes**: the subgroup of the units of
`∏_{i ≥ 0} A^i(X)` generated by the classes `c(ℰ)`. It is commutative, total Chern classes
commuting with each other. -/
def totalChernUnitGroup : Subgroup (TotalChowClass C sX)ˣ :=
  Subgroup.closure (Set.range (totalChernClassUnit C sX))

/-- The group generated by the total Chern classes is commutative. -/
instance : CommGroup (totalChernUnitGroup C sX) where
  mul_comm := (Subgroup.isMulCommutative_closure (by
    rintro _ ⟨M, rfl⟩ _ ⟨N, rfl⟩ -
    exact totalChernClassUnit_commute C sX M N)).is_comm.comm

/-- `c(ℰ)` as an element of the group generated by the total Chern classes, written additively. -/
def totalChernKFun (M : X.Modules) : Additive (totalChernUnitGroup C sX) :=
  Additive.ofMul ⟨totalChernClassUnit C sX M, Subgroup.subset_closure ⟨M, rfl⟩⟩

/-- **The total Chern class through `K_0(Vect(X))`**, into the group generated by the total
Chern classes. It is well defined by the Whitney sum formula, Stacks 02UI. -/
def totalChernKHom : VectorBundleKZero X →+ Additive (totalChernUnitGroup C sX) :=
  VectorBundleKZero.liftAddHom (totalChernKFun C sX)
    (fun M hM ↦ by
      rw [totalChernKFun, ← ofMul_one]
      exact congrArg Additive.ofMul (Subtype.ext (totalChernClassUnit_of_not C sX M hM)))
    (fun {E F G} f g w hE hF hG _ _ hex ↦ by
      refine congrArg Additive.ofMul (Subtype.ext (Units.ext ?_))
      change (totalChernClassUnit C sX F : TotalChowClass C sX) =
        ((totalChernClassUnit C sX E * totalChernClassUnit C sX G : (TotalChowClass C sX)ˣ) :
          TotalChowClass C sX)
      rw [Units.val_mul, val_totalChernClassUnit, val_totalChernClassUnit,
        val_totalChernClassUnit]
      exact totalChernClassOfModule_eq_mul_of_shortExact C sX (ShortComplex.mk f g w)
        { exact := hex })

/-- **Stacks 0FEL, as a homomorphism of groups.** The Chern class map from `K_0(Vect(X))` to the
group of units of `∏_{i ≥ 0} A^i(X)`, written additively: it sends `[ℰ]` to `c(ℰ)` and sums to
products. -/
def totalChernKGroupHom : VectorBundleKZero X →+ Additive (TotalChowClass C sX)ˣ :=
  (MonoidHom.toAdditive (totalChernUnitGroup C sX).subtype).comp (totalChernKHom C sX)

/-- **Stacks 0FEL.** The Chern class map `c : K_0(Vect(X)) ⟶ ∏_{i ≥ 0} A^i(X)`. -/
def totalChernKGroupMap (α : VectorBundleKZero X) : TotalChowClass C sX :=
  ((Additive.toMul (totalChernKGroupHom C sX α) : (TotalChowClass C sX)ˣ) : TotalChowClass C sX)

/-- The values of the Chern class map are units. -/
theorem isUnit_totalChernKGroupMap (α : VectorBundleKZero X) :
    IsUnit (totalChernKGroupMap C sX α) :=
  Units.isUnit _

/-- **The value on a generator**: `c([ℰ]) = c(ℰ)`. -/
theorem totalChernKGroupMap_classOf (E : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] :
    totalChernKGroupMap C sX (VectorBundleKZero.classOf X E) = totalChernClassOfModule C sX E := by
  have h : totalChernKHom C sX (VectorBundleKZero.classOf X E) = totalChernKFun C sX E :=
    VectorBundleKZero.liftAddHom_classOf _ _ _ E
  change (((Additive.toMul (totalChernKHom C sX (VectorBundleKZero.classOf X E)) :
    totalChernUnitGroup C sX) : (TotalChowClass C sX)ˣ) : TotalChowClass C sX) = _
  rw [h]
  exact val_totalChernClassUnit C sX E

/-- **Multiplicativity**: `c(α + β) = c(α) c(β)`. -/
theorem totalChernKGroupMap_add (α β : VectorBundleKZero X) :
    totalChernKGroupMap C sX (α + β) = totalChernKGroupMap C sX α * totalChernKGroupMap C sX β := by
  rw [totalChernKGroupMap, map_add, toMul_add, Units.val_mul]
  rfl

/-- `c(0) = 1`. -/
theorem totalChernKGroupMap_zero : totalChernKGroupMap C sX 0 = 1 := by
  rw [totalChernKGroupMap, map_zero, toMul_zero, Units.val_one]

/-- `c(−α) c(α) = 1`. -/
theorem totalChernKGroupMap_neg_mul (α : VectorBundleKZero X) :
    totalChernKGroupMap C sX (-α) * totalChernKGroupMap C sX α = 1 := by
  rw [← totalChernKGroupMap_add, neg_add_cancel, totalChernKGroupMap_zero]

/-- `c(α) c(−α) = 1`. -/
theorem totalChernKGroupMap_mul_neg (α : VectorBundleKZero X) :
    totalChernKGroupMap C sX α * totalChernKGroupMap C sX (-α) = 1 := by
  rw [← totalChernKGroupMap_add, add_neg_cancel, totalChernKGroupMap_zero]

/-- **`−[ℰ]` goes to the formal inverse of `c(ℰ)`**, on the left. -/
theorem totalChernKGroupMap_neg_classOf_mul (E : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] :
    totalChernKGroupMap C sX (-VectorBundleKZero.classOf X E) *
      totalChernClassOfModule C sX E = 1 := by
  rw [← totalChernKGroupMap_classOf C sX E, totalChernKGroupMap_neg_mul]

/-- **`−[ℰ]` goes to the formal inverse of `c(ℰ)`**, on the right. -/
theorem mul_totalChernKGroupMap_neg_classOf (E : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] :
    totalChernClassOfModule C sX E *
      totalChernKGroupMap C sX (-VectorBundleKZero.classOf X E) = 1 := by
  rw [← totalChernKGroupMap_classOf C sX E, totalChernKGroupMap_mul_neg]

/-- **The map is canonical**: a map `K_0(Vect(X)) ⟶ ∏_{i ≥ 0} A^i(X)` sending each `[ℰ]` to
`c(ℰ)` and sums to products is the Chern class map. -/
theorem eq_totalChernKGroupMap (c : VectorBundleKZero X → TotalChowClass C sX)
    (hc : ∀ (E : X.Modules) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E],
      c (VectorBundleKZero.classOf X E) = totalChernClassOfModule C sX E)
    (hadd : ∀ α β, c (α + β) = c α * c β) : c = totalChernKGroupMap C sX := by
  have h0 : c 0 = 1 := by
    have := VectorBundleKZero.isFiniteLocallyFree_zero X
    obtain ⟨v, hv⟩ := isUnit_totalChernClassOfModule C sX (0 : X.Modules)
    have hc0 : c 0 = v := by
      rw [hv, ← hc, VectorBundleKZero.classOf_zero]
    have hvv : (v : TotalChowClass C sX) * v = v := by
      rw [← hc0, ← hadd, add_zero]
    rw [hc0]
    simpa using congrArg (fun x ↦ (↑v⁻¹ : TotalChowClass C sX) * x) hvv
  have hgen : ∀ M : X.Modules, c (VectorBundleKZero.classOf X M) =
      totalChernKGroupMap C sX (VectorBundleKZero.classOf X M) := fun M ↦ by
    by_cases hM : Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M
    · rw [hc, totalChernKGroupMap_classOf]
    · rw [VectorBundleKZero.classOf_eq_zero_of_not_isFiniteLocallyFree M hM, h0,
        totalChernKGroupMap_zero]
  funext α
  induction α using QuotientAddGroup.induction_on with
  | H x =>
    induction x using FreeAbelianGroup.induction_on with
    | zero => exact h0.trans (totalChernKGroupMap_zero C sX).symm
    | of M => exact hgen M
    | neg M ih =>
      change c (-VectorBundleKZero.classOf X M) =
        totalChernKGroupMap C sX (-VectorBundleKZero.classOf X M)
      refine left_inv_eq_right_inv (a := totalChernKGroupMap C sX (VectorBundleKZero.classOf X M))
        ?_ (totalChernKGroupMap_mul_neg C sX _)
      rw [← hgen, ← hadd, neg_add_cancel, h0]
    | add x y ihx ihy =>
      change c (QuotientAddGroup.mk x + QuotientAddGroup.mk y) =
        totalChernKGroupMap C sX (QuotientAddGroup.mk x + QuotientAddGroup.mk y)
      rw [hadd, totalChernKGroupMap_add]
      exact congrArg₂ (· * ·) ihx ihy

/-- **Stacks 0FEL.** Let `X` be locally of finite type over the base of chapter 42. The Chern
class map `c : K_0(Vect(X)) ⟶ ∏_{i ≥ 0} A^i(X)`:

1. sends a generator `[ℰ]`, `ℰ` finite locally free of any rank, to
   `c(ℰ) = 1 + c_1(ℰ) + c_2(ℰ) + …`, whose degree-`p` component is the Chern class `c_p(ℰ)` of
   Stacks 0ESW and whose degree-`0` component is `1`;
2. is multiplicative, `c(α + β) = c(α) c(β)`;
3. sends `−[ℰ]` to the formal inverse of `c(ℰ)`, a two-sided inverse in `∏_{i ≥ 0} A^i(X)`;
4. is the only map with properties 1 and 2 (it is obtained "by extending multiplicatively").

It is well defined by the Whitney sum formula, Stacks 02UI
(`Stacks.Chow.totalChernClassOfModule_eq_mul_of_shortExact`). -/
@[stacks 0FEL]
theorem totalChernKGroupMap_spec :
    (∀ (E : X.Modules) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E],
      totalChernKGroupMap C sX (VectorBundleKZero.classOf X E) = totalChernClassOfModule C sX E ∧
        totalChernClassOfModule C sX E 0 = (1 : TotalChowClass C sX) 0 ∧
        ∀ p : ℕ, totalChernClassOfModule C sX E p = chernClassOfModule C sX E p) ∧
    (∀ α β : VectorBundleKZero X,
      totalChernKGroupMap C sX (α + β) = totalChernKGroupMap C sX α * totalChernKGroupMap C sX β) ∧
    (∀ (E : X.Modules) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E],
      totalChernKGroupMap C sX (-VectorBundleKZero.classOf X E) *
          totalChernClassOfModule C sX E = 1 ∧
        totalChernClassOfModule C sX E *
          totalChernKGroupMap C sX (-VectorBundleKZero.classOf X E) = 1) ∧
    (∀ c : VectorBundleKZero X → TotalChowClass C sX,
      (∀ (E : X.Modules) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E],
        c (VectorBundleKZero.classOf X E) = totalChernClassOfModule C sX E) →
      (∀ α β, c (α + β) = c α * c β) → c = totalChernKGroupMap C sX) :=
  ⟨fun E _ ↦ ⟨totalChernKGroupMap_classOf C sX E, totalChernClassOfModule_apply_zero C sX E,
      totalChernClassOfModule_apply C sX E⟩,
    totalChernKGroupMap_add C sX,
    fun E _ ↦ ⟨totalChernKGroupMap_neg_classOf_mul C sX E,
      mul_totalChernKGroupMap_neg_classOf C sX E⟩,
    eq_totalChernKGroupMap C sX⟩

end Stacks.Chow

end
