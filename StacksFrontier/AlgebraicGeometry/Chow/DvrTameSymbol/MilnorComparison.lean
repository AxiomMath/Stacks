module

public import StacksFrontier.AlgebraicGeometry.Chow.DvrTameSymbol
public import StacksFrontier.AlgebraicGeometry.Chow.DvrTameSymbol.MilnorTameSymbol
public import StacksFrontier.AlgebraicGeometry.Chow.RationalEquivalence.MilnorKSymbolTransport

/-!
# The Milnor tame symbol of a discrete valuation ring extends the symbol of Section 42.5

`Stacks.Chow.dvrMilnorTameSymbol` is the tame symbol `K^M_{i+1}(F) ⟶ K^M_i(κ)` of a discrete
valuation ring in every degree, and `Stacks.Chow.dvrRegularTameSymbol` is the tame symbol
`∂_A` of Stacks 0EAH on pairs of nonzerodivisors of `A`. This file checks that the first is an
extension of the second: in degree two, on a pair of nonzerodivisors of `A`,

`∂_A {a, b} = {∂_A(a, b)}`.

Both sides are the formula of Stacks 02Q6, `(-1) ^ (m n) ū ^ n v̄ ^ (-m)`; the content of the
check is that the valuation and unit part computed in `F` by
`Stacks.Chow.dvrFracOrd` and `Stacks.Chow.dvrFracUnitPart` are the ones computed in `A` by
`Stacks.Chow.dvrOrd` and `Stacks.Chow.dvrUnitPart`. Since `∂_A` is bimultiplicative and `Q(A)^*`
is generated by the nonzerodivisors of `A`, this pins the degree-two part of the Milnor tame
symbol down to the symbol of Section 42.5.

## Main results

* `Stacks.Chow.dvrFracOrd_regularFractionUnit`,
  `Stacks.Chow.dvrFracUnitPart_regularFractionUnit` — the two coordinates of a nonzerodivisor of
  `A`, read in `F`, are the ones read in `A`.
* `Stacks.Chow.dvrMilnorTameSymbol_regularFractionUnit` — the comparison in degree two.
* `Stacks.Chow.dvrMilnorTameSymbol_milnorKTwoPureSymbol` — the same for the tame symbol itself,
  evaluated at the pure symbol `{a, b}` of `K^M_2(F)`.

## References

* [Stacks Project, Tag 0EAY](https://stacks.math.columbia.edu/tag/0EAY)
* [Stacks Project, Section 0EAH](https://stacks.math.columbia.edu/tag/0EAH)
* [Stacks Project, Tag 02Q6](https://stacks.math.columbia.edu/tag/02Q6)
-/

@[expose] public noncomputable section

open IsLocalRing IsDiscreteValuationRing AlgebraicGeometry

universe u v

namespace Stacks.Chow

variable {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
variable {F : Type v} [Field F] [Algebra A F] [IsFractionRing A F]
variable {ϖ : A}

/-- The valuation in `F` of a nonzerodivisor `a` of `A`, viewed as a unit of `F`, is its
valuation `dvrOrd a` in `A`. -/
theorem dvrFracOrd_regularFractionUnit (hϖ : Irreducible ϖ) (a : nonZeroDivisors A) :
    dvrFracOrd (F := F) hϖ (regularFractionUnit (Q := F) a) = (dvrOrd a : ℤ) :=
  dvrFracOrd_eq_of_eq hϖ (by
    rw [regularFractionUnit_val, dvrUnitPart_spec hϖ a, map_mul, map_pow, zpow_natCast])

/-- The unit part in `F` of a nonzerodivisor `a` of `A`, viewed as a unit of `F`, is the image in
the residue field of its unit part `dvrUnitPart hϖ a` in `A`. -/
theorem dvrFracUnitPart_regularFractionUnit (hϖ : Irreducible ϖ) (a : nonZeroDivisors A) :
    dvrFracUnitPart (F := F) hϖ (regularFractionUnit (Q := F) a) =
      Units.map (residue A).toMonoidHom (dvrUnitPart hϖ a) :=
  dvrFracUnitPart_eq_of_eq hϖ (by
    rw [regularFractionUnit_val, dvrUnitPart_spec hϖ a, map_mul, map_pow, zpow_natCast])

/-- **In degree two the Milnor tame symbol of a discrete valuation ring is the tame symbol of
Stacks 0EAH.** On a pair of nonzerodivisors of `A` the coefficient of `ξ` is the symbol
`∂_A(a, b)` of `Stacks.Chow.dvrRegularTameSymbol`, read as a degree-one symbol of the residue
field. -/
theorem dvrMilnorTameSymbol_regularFractionUnit (hϖ : Irreducible ϖ) (a b : nonZeroDivisors A) :
    MilnorKShift.shift (dvrMilnorShiftMap (F := F) hϖ
        (milnorKSymbol F (regularFractionUnit (Q := F) a) *
          milnorKSymbol F (regularFractionUnit (Q := F) b))) =
      milnorKSymbol (ResidueField A) (dvrRegularTameSymbol hϖ a b) := by
  rw [dvrMilnorTameSymbol_degree_two, dvrRegularTameSymbol_apply,
    dvrFracOrd_regularFractionUnit, dvrFracOrd_regularFractionUnit,
    dvrFracUnitPart_regularFractionUnit, dvrFracUnitPart_regularFractionUnit,
    dvrTameSymbolFormula, ← Nat.cast_mul, zpow_natCast, zpow_natCast, zpow_natCast]

/-- **The tame symbol of Stacks 0EAY, in degree two, at a pure symbol.** For nonzerodivisors
`a, b` of `A`,

`∂_A {a, b} = {∂_A(a, b)}`,

with `∂_A(a, b)` the tame symbol of Stacks 0EAH on pairs of nonzerodivisors
(`Stacks.Chow.dvrRegularTameSymbol`) and `{-}` the identification `K^M_1(κ) = κ^*`. So the map
registered for Stacks 0EAY really does extend the symbol of Section 42.5. -/
theorem dvrMilnorTameSymbol_milnorKTwoPureSymbol (hϖ : Irreducible ϖ) (a b : nonZeroDivisors A) :
    (dvrMilnorTameSymbol hϖ 1
        (milnorKTwoPureSymbol F (regularFractionUnit (Q := F) a)
          (regularFractionUnit (Q := F) b)) : MilnorKRing (ResidueField A)) =
      milnorKSymbol (ResidueField A) (dvrRegularTameSymbol hϖ a b) := by
  have hcoe : ((milnorKTwoPureSymbol F (regularFractionUnit (Q := F) a)
        (regularFractionUnit (Q := F) b) : MilnorKTheory F 2) : MilnorKRing F) =
      milnorKSymbol F (regularFractionUnit (Q := F) a) *
        milnorKSymbol F (regularFractionUnit (Q := F) b) := by
    rw [coe_milnorKTwoPureSymbol, map_mul, milnorKSymbol_eq_mk', milnorKSymbol_eq_mk']
  rw [dvrMilnorTameSymbol_coe, hcoe]
  exact dvrMilnorTameSymbol_regularFractionUnit hϖ a b

end Stacks.Chow
