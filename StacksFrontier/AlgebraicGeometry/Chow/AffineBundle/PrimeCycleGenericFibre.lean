module

public import StacksFrontier.AlgebraicGeometry.Chow.AffineBundle.GenericFibre
public import StacksFrontier.AlgebraicGeometry.Chow.AffineBundle.SpreadOutFunctionFieldPolynomial
public import Mathlib.RingTheory.Polynomial.Basic

/-!
# The generic fibre of a prime cycle on the affine line over an integral base

Let `Y` be an integral scheme with function field `R(Y)`. A prime cycle on `𝔸¹_Y` is an integral
closed subscheme `W ⊆ 𝔸¹_Y`, which is determined by its generic point `w`: it is the reduced
induced structure on `closure {w}`. Such a cycle dominates `Y` exactly when `w` lies over the
generic point of `Y`, and it is the whole of `𝔸¹_Y` exactly when `w` is the generic point of
`𝔸¹_Y`.

This file proves the statement the fourth step of the proof of Stacks 02TT opens with: a prime
cycle on `𝔸¹_Y` which dominates `Y` and is not all of `𝔸¹_Y` meets the generic fibre
`𝔸¹_{R(Y)} = Spec R(Y)[T]` in the closed subset cut out by a **monic irreducible** polynomial
`P(T) ∈ R(Y)[T]`.

The proof has three parts. Because `w` lies over the generic point of `Y`, it is the image of a
point `q` of the generic fibre (`Stacks.Chow.exists_genericFibreι_eq`). The prime of `R(Y)[T]`
at `q` is nonzero: otherwise `q` would be the generic point of `Spec R(Y)[T]`, which specializes
to every point, so `w` would specialize to the generic point of `𝔸¹_Y` and hence be it. Finally
`R(Y)[T]` is a principal ideal domain, so a nonzero prime is generated by an irreducible
element, which can be normalized to a monic one.

Together with `Stacks.Chow.exists_opens_monic_polynomial_map_eq`, which spreads `P` out to a
nonempty open of `Y`, this is the whole bridge the fourth step of Stacks 02TT needs in order to
exhibit the prime cycle as a principal divisor over a nonempty open of the base.

## Main results

* `Stacks.Chow.exists_monic_irreducible_span_eq` — a nonzero prime ideal of `K[T]`, `K` a field,
  is generated by a monic irreducible polynomial.
* `Stacks.Chow.exists_monic_irreducible_genericFibre` — **the conclusion**: the generic fibre of
  a prime cycle on `𝔸¹_Y` dominating `Y` and distinct from `𝔸¹_Y` is cut out by a monic
  irreducible element of `R(Y)[T]`.

## References

* [Stacks Project, Tag 02TT](https://stacks.math.columbia.edu/tag/02TT)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Chow

/-! ### Nonzero primes of a univariate polynomial ring over a field -/

/-- **A nonzero prime ideal of `K[T]`, for `K` a field, is generated by a monic irreducible
polynomial.** The polynomial ring over a field is a principal ideal domain, so the ideal is
generated by a single element, which is prime because the ideal is, hence irreducible; dividing
by its leading coefficient makes it monic without changing the ideal. -/
theorem exists_monic_irreducible_span_eq {K : Type u} [Field K] {I : Ideal (Polynomial K)}
    (hI : I.IsPrime) (hI0 : I ≠ ⊥) :
    ∃ P : Polynomial K, P.Monic ∧ Irreducible P ∧ I = Ideal.span {P} := by
  obtain ⟨p, hp⟩ := (IsPrincipalIdealRing.principal I).principal
  have hspan : I = Ideal.span {p} := hp
  have hp0 : p ≠ 0 := by
    intro h
    rw [h, Ideal.span_singleton_eq_bot.2 rfl] at hspan
    exact hI0 hspan
  have hprime : Prime p := (Ideal.span_singleton_prime hp0).1 (hspan ▸ hI)
  have hunit : IsUnit (Polynomial.C p.leadingCoeff⁻¹) :=
    Polynomial.isUnit_C.2 (isUnit_iff_ne_zero.2
      (inv_ne_zero (Polynomial.leadingCoeff_ne_zero.2 hp0)))
  have hassoc : Associated p (p * Polynomial.C p.leadingCoeff⁻¹) :=
    (associated_mul_unit_left p _ hunit).symm
  refine ⟨p * Polynomial.C p.leadingCoeff⁻¹, Polynomial.monic_mul_leadingCoeff_inv hp0,
    hassoc.irreducible hprime.irreducible, ?_⟩
  rw [hspan]
  exact Ideal.span_singleton_eq_span_singleton.2 hassoc

/-! ### The generic fibre of a prime cycle -/

/-- **A point of an affine scheme whose prime is zero specializes to every point.** Its closure
is the zero locus of the zero ideal, which is everything. -/
theorem specializes_of_asIdeal_eq_bot {R : CommRingCat.{u}} {q q' : ↥(Spec R)}
    (hq : q.asIdeal = ⊥) : q ⤳ q' := by
  rw [specializes_iff_mem_closure]
  have hc : closure ({q} : Set ↥(Spec R)) =
      PrimeSpectrum.zeroLocus (↑q.asIdeal : Set ↑R) :=
    PrimeSpectrum.closure_singleton q
  rw [hc]
  have hsub : (↑q.asIdeal : Set ↑R) ⊆ ↑q'.asIdeal := by
    rw [hq]
    intro x hx
    simp only [SetLike.mem_coe, Ideal.mem_bot] at hx
    simp [hx]
  exact hsub

variable (Y : Scheme.{u}) [IsIntegral Y]

/-- A point of `𝔸¹_Y` lying over the generic point of `Y` is the image of a point of the generic
fibre `Spec R(Y)[T]` under `Stacks.Chow.affineLineGenericFibreι`. -/
theorem exists_affineLineGenericFibreι_eq (w : ↥𝔸(ULift.{u} (Fin 1); Y))
    (hw : (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) w = genericPoint ↥Y) :
    ∃ q : ↥(Spec (CommRingCat.of (Polynomial ↑Y.functionField))),
      affineLineGenericFibreι Y q = w := by
  obtain ⟨z, hz⟩ := exists_genericFibreι_eq (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) w hw
  exact ⟨(genericFibreAffineLineIso Y).inv z,
    (affineLineGenericFibreι_genericFibreAffineLineIso_inv Y z).trans hz⟩

/-- **The generic fibre of a prime cycle on the affine line is cut out by a monic irreducible
polynomial.** Let `Y` be integral and let `w` be the generic point of an integral closed
subscheme `W ⊆ 𝔸¹_Y`. If `W` dominates `Y` — that is, `w` lies over the generic point of `Y` —
and `W` is not the whole of `𝔸¹_Y` — that is, `w` is not the generic point of `𝔸¹_Y` — then
there is a monic irreducible `P ∈ R(Y)[T]` and a point `q` of the generic fibre
`𝔸¹_{R(Y)} = Spec R(Y)[T]` lying over `w` whose prime is generated by `P`, so that the generic
fibre of `W` is the zero locus of `P`.

This is the opening claim of the fourth step of the proof of Stacks 02TT. -/
theorem exists_monic_irreducible_genericFibre (w : ↥𝔸(ULift.{u} (Fin 1); Y))
    (hdom : (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) w = genericPoint ↥Y)
    (hne : w ≠ genericPoint ↥𝔸(ULift.{u} (Fin 1); Y)) :
    ∃ (q : ↥(Spec (CommRingCat.of (Polynomial ↑Y.functionField))))
      (P : Polynomial ↑Y.functionField),
      affineLineGenericFibreι Y q = w ∧ P.Monic ∧ Irreducible P ∧
        q.asIdeal = Ideal.span {P} ∧
        closure ({q} : Set ↥(Spec (CommRingCat.of (Polynomial ↑Y.functionField)))) =
          PrimeSpectrum.zeroLocus ({P} : Set (Polynomial ↑Y.functionField)) := by
  obtain ⟨q, hq⟩ := exists_affineLineGenericFibreι_eq Y w hdom
  -- The generic point of `𝔸¹_Y` also lies over the generic point of `Y`, so it too comes from
  -- the generic fibre.
  obtain ⟨q₀, hq₀⟩ := exists_affineLineGenericFibreι_eq Y
    (genericPoint ↥𝔸(ULift.{u} (Fin 1); Y)) (genericPoint_eq_of_isDominant _)
  -- The prime at `q` is nonzero: otherwise `q` specializes to `q₀`, so `w` specializes to the
  -- generic point of `𝔸¹_Y` and therefore is it.
  have hq0 : q.asIdeal ≠ ⊥ := by
    intro h
    have hspec : affineLineGenericFibreι Y q ⤳ affineLineGenericFibreι Y q₀ :=
      (specializes_of_asIdeal_eq_bot (q' := q₀) h).map
        (affineLineGenericFibreι Y).base.hom.continuous
    rw [hq, hq₀] at hspec
    have hg : closure ({genericPoint ↥𝔸(ULift.{u} (Fin 1); Y)} :
        Set ↥𝔸(ULift.{u} (Fin 1); Y)) = Set.univ :=
      genericPoint_spec ↥𝔸(ULift.{u} (Fin 1); Y)
    have huniv : closure ({w} : Set ↥𝔸(ULift.{u} (Fin 1); Y)) = Set.univ := by
      refine Set.eq_univ_of_univ_subset ?_
      rw [← hg]
      exact hspec.closure_subset
    exact hne (IsGenericPoint.eq huniv (genericPoint_spec _))
  obtain ⟨P, hPm, hPi, hPspan⟩ := exists_monic_irreducible_span_eq q.isPrime hq0
  refine ⟨q, P, hq, hPm, hPi, hPspan, ?_⟩
  have hc : closure ({q} : Set ↥(Spec (CommRingCat.of (Polynomial ↑Y.functionField)))) =
      PrimeSpectrum.zeroLocus (↑q.asIdeal : Set (Polynomial ↑Y.functionField)) :=
    PrimeSpectrum.closure_singleton q
  rw [hc, hPspan]
  exact PrimeSpectrum.zeroLocus_span ({P} : Set (Polynomial ↑Y.functionField))

end Stacks.Chow

end
