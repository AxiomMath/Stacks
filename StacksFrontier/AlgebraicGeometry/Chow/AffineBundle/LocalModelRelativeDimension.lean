@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u v

namespace Stacks.MvPolynomial

variable (k : Type u) [Field k] (ι : Type v) [Finite ι]

/-- A prime of `k[ι]` minimal over a principal ideal generated by a nonzero element is itself
generated by a single nonzero nonunit: it has height one, at most one by Krull's principal ideal
theorem and not zero because it contains a nonzero element of a domain, and a height-one prime of
a unique factorization domain is principal. -/
theorem exists_span_singleton_of_mem_minimalPrimes {z : MvPolynomial ι k} (hz0 : z ≠ 0)
    {P : Ideal (MvPolynomial ι k)} (hP : P ∈ (Ideal.span {z}).minimalPrimes) :
    ∃ g : MvPolynomial ι k, g ≠ 0 ∧ ¬ IsUnit g ∧ P = Ideal.span {g} := by
  have hPp : P.IsPrime := hP.1.1
  have hPbot : P ≠ ⊥ := fun h => hz0 (by simpa [h] using hP.1.2 (Ideal.mem_span_singleton_self z))
  have hprin : (Ideal.span {z} : Ideal (MvPolynomial ι k)).IsPrincipal := ⟨⟨z, rfl⟩⟩
  obtain ⟨g, hg : P = Ideal.span {g}⟩ := (UniqueFactorizationMonoid.isPrincipal_of_height_eq_one
    (le_antisymm (Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ P hP)
      (Order.one_le_iff_ne_zero.mpr
        fun h => hPbot (Ideal.height_eq_zero_iff_eq_bot.mp h)))).principal
  refine ⟨g, ?_, fun hu => hPp.ne_top (by rw [hg, Ideal.span_singleton_eq_top.mpr hu]), hg⟩
  rintro rfl
  exact hPbot (by simpa using hg)

/-- The quotient of `k[ι]` by a prime minimal over a nonzero nonunit principal ideal has the
dimension of the hypersurface itself, because that prime is again generated by a nonzero
nonunit. -/
theorem ringKrullDim_quotient_of_mem_minimalPrimes {n : ℕ} (hn : Nat.card ι = n + 1)
    {z : MvPolynomial ι k} (hz0 : z ≠ 0) {P : Ideal (MvPolynomial ι k)}
    (hP : P ∈ (Ideal.span {z}).minimalPrimes) :
    ringKrullDim (MvPolynomial ι k ⧸ P) = (n : WithBot ℕ∞) := by
  obtain ⟨g, hg0, hgu, rfl⟩ := exists_span_singleton_of_mem_minimalPrimes k ι hz0 hP
  exact ringKrullDim_quotient_span_singleton k ι hn g hg0 hgu

/-- **A hypersurface in affine space over a field is equidimensional.** Every minimal prime of
`k[ι]/(z)`, for `z` a nonzero nonunit, has quotient of the same dimension `#ι - 1`; no hypothesis
that the hypersurface be reduced or irreducible is needed, so in particular `k[x, y]/(xy)` is
covered. -/
theorem specEquidimensional_quotient_span_singleton {n : ℕ} (hn : Nat.card ι = n + 1)
    {z : MvPolynomial ι k} (hz0 : z ≠ 0) :
    SpecEquidimensional (MvPolynomial ι k ⧸ Ideal.span {z}) := by
  have key : ∀ P ∈ minimalPrimes (MvPolynomial ι k ⧸ Ideal.span {z}),
      ringKrullDim ((MvPolynomial ι k ⧸ Ideal.span {z}) ⧸ P) = (n : WithBot ℕ∞) := by
    intro P hP
    have hPp : P.IsPrime := hP.1.1
    set p : Ideal (MvPolynomial ι k) := P.comap (Ideal.Quotient.mk (Ideal.span {z}))
    have hpp : p.IsPrime := hPp.comap _
    have hIp : Ideal.span {z} ≤ p := Ideal.mk_ker.symm.trans_le (Ideal.ker_le_comap _)
    have hmap : p.map (Ideal.Quotient.mk (Ideal.span {z})) = P :=
      Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective P
    rw [← hmap, ringKrullDim_eq_of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hIp)]
    exact ringKrullDim_quotient_of_mem_minimalPrimes k ι hn hz0 (by
      simpa using Ideal.mem_minimalPrimes_sup (p := p) (I := Ideal.span {z}) (J := ⊥) hIp
        (by simpa [hmap] using hP))
  exact fun P hP Q hQ => (key P hP).trans (key Q hQ).symm

end Stacks.MvPolynomial

namespace Stacks.AffineBundle

/-! ### The local model over a field -/

section Field

variable (K : Type u) [Field K] (c : K)

/-- The defining relation `z₁z₂ - c` of the local model is not the zero polynomial: its
coefficient at the monomial `z₁z₂` is `1`. -/
theorem localRelation_ne_zero (B : Type u) [CommRing B] [Nontrivial B] (f : B) :
    localRelation B f ≠ 0 := by
  have hm : (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) ≠ 0 :=
    fun h => by simpa using DFunLike.congr_fun h 0
  refine MvPolynomial.ne_zero_iff.mpr
    ⟨Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1, ?_⟩
  rw [localRelation, MvPolynomial.coeff_sub, MvPolynomial.X, MvPolynomial.X,
    MvPolynomial.monomial_mul_monomial, one_mul, MvPolynomial.coeff_monomial,
    MvPolynomial.coeff_C, if_pos rfl, if_neg (Ne.symm hm), sub_zero]
  exact one_ne_zero

/-- The defining relation `z₁z₂ - f` of the local model is not a unit: it vanishes at the point
`(1, f)`, so its image under evaluation there is `0`, which is not a unit. -/
theorem not_isUnit_localRelation (B : Type u) [CommRing B] [Nontrivial B] (f : B) :
    ¬ IsUnit (localRelation B f) :=
  fun hu => by simpa [localRelation] using hu.map (MvPolynomial.eval ![(1 : B), f])

/-- **The local model over a field is one-dimensional**, being a hypersurface in the affine plane
cut out by a nonzero nonunit. -/
theorem ringKrullDim_localModel_field : ringKrullDim (LocalModel K c) = (1 : ℕ) :=
  _root_.Stacks.MvPolynomial.ringKrullDim_quotient_span_singleton K (Fin 2) (by simp)
    (localRelation K c) (localRelation_ne_zero K c) (not_isUnit_localRelation K c)

/-- **The local model over a field is equidimensional.** Both of its shapes are covered: the
punctured affine line `K[z, z⁻¹]` when `c ≠ 0`, which is irreducible, and the pair of crossing
affine lines `K[z₁, z₂]/(z₁z₂)` when `c = 0`, whose two components are each one-dimensional. -/
theorem equidimensional_primeSpectrum_localModel :
    Equidimensional (PrimeSpectrum (LocalModel K c)) :=
  specEquidimensional_iff_equidimensional.mp
    (_root_.Stacks.MvPolynomial.specEquidimensional_quotient_span_singleton K (Fin 2) (n := 1)
      (by simp) (localRelation_ne_zero K c))

end Field

/-! ### The relative dimension of the structure morphism -/

variable (B : Type u) [CommRing B] (f : B)

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- The fibre ring of the local model over a prime `𝔭` of the base is the local model over the
residue field `κ(𝔭)` of the image of `f` there: the local model commutes with base change. -/
def fiberRingEquiv (p : PrimeSpectrum B) :
    p.asIdeal.Fiber (LocalModel B f) ≃+*
      LocalModel p.asIdeal.ResidueField (baseChangeElt B f p.asIdeal.ResidueField) :=
  (baseChangeEquiv B f p.asIdeal.ResidueField).toRingEquiv

/-- Every fibre of the structure morphism of the local model is equidimensional of topological
Krull dimension one. -/
theorem equidimensional_and_topologicalKrullDim_fiber (p : PrimeSpectrum B) :
    Equidimensional
        ((Spec.map (CommRingCat.ofHom (algebraMap B (LocalModel B f)))).fiber p) ∧
      topologicalKrullDim
          ((Spec.map (CommRingCat.ofHom (algebraMap B (LocalModel B f)))).fiber p) =
        ((1 : ℕ) : WithBot ℕ∞) := by
  refine ⟨.of_homeomorph (fiberSpecHomeo B (LocalModel B f) p)
    (.of_homeomorph (PrimeSpectrum.homeomorphOfRingEquiv (fiberRingEquiv B f p))
      (equidimensional_primeSpectrum_localModel p.asIdeal.ResidueField _)), ?_⟩
  rw [topologicalKrullDim_fiber_specMap_eq B (LocalModel B f) p,
    ringKrullDim_eq_of_ringEquiv (fiberRingEquiv B f p)]
  exact ringKrullDim_localModel_field p.asIdeal.ResidueField _

/-- **The structure morphism `Spec(B[z₁, z₂]/(z₁z₂ - f)) ⟶ Spec B` of the local model has
relative dimension one.** Its fibre over a prime `𝔭` of `B` is the local model over `κ(𝔭)` of the
image of `f`, a hypersurface in the affine plane over a field, hence equidimensional of
dimension one. -/
theorem relativeDimension_localModelSpecMap :
    AlgebraicGeometry.RelativeDimension (localModelSpecMap B f) 1 :=
  fun p _ => equidimensional_and_topologicalKrullDim_fiber B f p

end Stacks.AffineBundle

end
