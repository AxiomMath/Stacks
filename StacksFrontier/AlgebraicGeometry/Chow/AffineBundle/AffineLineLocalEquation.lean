module

public import Mathlib.AlgebraicGeometry.Restrict
public import Mathlib.AlgebraicGeometry.Stalk
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import StacksFrontier.AlgebraicGeometry.Chow.AffineBundle.PrimeCycleSpreadOut

/-!
# A prime divisor on the affine line has a global equation over a nonempty open of the base

Let `Y` be an integral scheme and let `W ⊆ 𝔸¹_Y` be an integral closed subscheme which dominates
`Y` and is not the whole of `𝔸¹_Y`, that is, whose generic point `w` lies over the generic point
of `Y` and is not the generic point of `𝔸¹_Y`. The crux of the fourth paragraph of the proof of
Stacks 02TT is that `W` is then *cut out by a single global equation* over a nonempty open of the
base: there are a nonempty open `V ⊆ Y` and a nonzero section `t` of the structure sheaf of
`𝔸¹_Y` over the preimage of `V` whose germ at `w` generates the maximal ideal of the local ring
at `w` and which is a unit at every point of the preimage of `V` outside the closure of `{w}`.

The equation is the monic polynomial produced by
`Stacks.Chow.exists_opens_monic_isPrime_genericFibre`, read through the identification of the
preimage of an affine open `U ⊆ Y` with the spectrum of a univariate polynomial ring:

* the preimage of `U` under `𝔸¹_Y ⟶ Y` is `𝔸¹_U`, because affine space is stable under base
  change (`AlgebraicGeometry.AffineSpace.isPullback_map`) and the restriction of a morphism to an
  open of its target is a base change (`AlgebraicGeometry.isPullback_morphismRestrict`);
* `𝔸¹_U = 𝔸¹_{Spec Γ(Y, U)} = Spec Γ(Y, U)[T]` by
  `Stacks.Chow.affineLineSpecIsoSpecPolynomial`.

Under this identification the point `w` becomes the prime `(Q)` of `Γ(Y, U)[T]`: the inclusion of
the generic fibre `Spec R(Y)[T] ⟶ 𝔸¹_Y` factors through `Spec Γ(Y, U)[T]` by the morphism induced
by the germ map `Γ(Y, U) → R(Y)`, so the prime of `w` is the contraction of the prime of the point
of the generic fibre over `w`, which is `(Q)` by
`Stacks.Chow.span_singleton_eq_comap_span_singleton_map`. The section `t` is then the element of
the sections over the preimage of `U` corresponding to `Q`, and the two germ statements are the
statements that a prime generated by one element localizes to the maximal ideal generated by the
image of that element, and that the non-unit locus of an element of the ring of an affine scheme
is the zero locus of the ideal it generates.

## Main definitions

* `Stacks.Chow.affineSpaceIsoOfIso` — an isomorphism of bases induces one of affine spaces.
* `Stacks.Chow.affineLinePreimageIso` — the preimage of an affine open `U ⊆ Y` under the
  projection of the affine line is `Spec Γ(Y, U)[T]`.

## Main results

* `Stacks.Chow.specMap_mapRingHom_comp_affineLineSpecIsoSpecPolynomial_inv` — the identification
  `𝔸¹_{Spec R} = Spec R[T]` is natural in `R`.
* `Stacks.Chow.specMap_comp_affineLinePreimageIso_hom_ι` — the inclusion of the generic fibre
  factors through `Spec Γ(Y, U)[T] ⟶ 𝔸¹_Y`.
* `Stacks.Chow.exists_opens_germ_span_eq_maximalIdeal` — **the crux of the fourth paragraph of
  Stacks 02TT**: a global equation for `W` over a nonempty open of the base, as a section over the
  preimage of that open, an open of `𝔸¹_Y`.
* `Stacks.Chow.exists_opens_primeIdealOf_eq_span_restrict` — the purely algebraic form of the
  same statement on the open subscheme of `𝔸¹_Y` cut out by that preimage, which is affine: the
  equation generates the prime ideal of the point above `w`.
* `Stacks.Chow.exists_opens_germ_span_eq_maximalIdeal_restrict` — the germ form on that open
  subscheme, which is how the Chow-group computation of Stacks 02TT consumes it.

## References

* [Stacks Project, Tag 02TT](https://stacks.math.columbia.edu/tag/02TT)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Chow

/-! ### Naturality of the identification of the affine line with `Spec R[T]` -/

/-- An isomorphism of base schemes induces an isomorphism of the affine spaces over them, because
affine space is functorial in its base (`AlgebraicGeometry.AffineSpace.map`). -/
def affineSpaceIsoOfIso (n : Type u) {S T : Scheme.{u}} (e : S ≅ T) : 𝔸(n; S) ≅ 𝔸(n; T) where
  hom := AffineSpace.map n e.hom
  inv := AffineSpace.map n e.inv
  hom_inv_id := by rw [← AffineSpace.map_comp, Iso.hom_inv_id, AffineSpace.map_id]
  inv_hom_id := by rw [← AffineSpace.map_comp, Iso.inv_hom_id, AffineSpace.map_id]

/-- The variable goes to the variable under the identification of polynomials in the variables
`ULift (Fin 1)` with univariate polynomials. -/
theorem mvPolynomialULiftFinOneAlgEquiv_X (R : Type u) [CommRing R] (i : ULift.{u} (Fin 1)) :
    mvPolynomialULiftFinOneAlgEquiv R (MvPolynomial.X i) = Polynomial.X := by
  simp [mvPolynomialULiftFinOneAlgEquiv]

/-- **The identification of polynomials in the variables `ULift (Fin 1)` with univariate
polynomials is natural.** Both composites send a constant `r` to the constant `φ r` and the
variable to the variable. -/
theorem mvPolynomialULiftFinOneIso_hom_comp_mapRingHom {R S : CommRingCat.{u}} (φ : R ⟶ S) :
    (mvPolynomialULiftFinOneIso R).hom ≫ CommRingCat.ofHom (Polynomial.mapRingHom φ.hom) =
      CommRingCat.ofHom (MvPolynomial.map (σ := ULift.{u} (Fin 1)) φ.hom) ≫
        (mvPolynomialULiftFinOneIso S).hom := by
  refine CommRingCat.hom_ext (MvPolynomial.ringHom_ext (fun r => ?_) fun i => ?_) <;>
    simp [CommRingCat.hom_comp, mvPolynomialULiftFinOneIso, mvPolynomialULiftFinOneAlgEquiv]

/-- The inverse of the identification `𝔸¹_{Spec R} = Spec R[T]`, unfolded into its two factors:
Mathlib's identification of `𝔸(n; Spec R)` with the spectrum of a multivariate polynomial ring,
and the passage from multivariate to univariate polynomials. -/
theorem affineLineSpecIsoSpecPolynomial_inv_eq (R : CommRingCat.{u}) :
    (affineLineSpecIsoSpecPolynomial R).inv =
      Spec.map (mvPolynomialULiftFinOneIso R).hom ≫
        (AffineSpace.SpecIso (ULift.{u} (Fin 1)) R).inv :=
  rfl

/-- **The identification `𝔸¹_{Spec R} = Spec R[T]` is natural in `R`.** It carries the morphism of
affine lines induced by `φ : R ⟶ S` to the morphism of spectra induced by `Polynomial.map φ`. -/
theorem specMap_mapRingHom_comp_affineLineSpecIsoSpecPolynomial_inv {R S : CommRingCat.{u}}
    (φ : R ⟶ S) :
    Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom φ.hom)) ≫
        (affineLineSpecIsoSpecPolynomial R).inv =
      (affineLineSpecIsoSpecPolynomial S).inv ≫
        AffineSpace.map (ULift.{u} (Fin 1)) (Spec.map φ) := by
  rw [affineLineSpecIsoSpecPolynomial_inv_eq, affineLineSpecIsoSpecPolynomial_inv_eq,
    AffineSpace.map_SpecMap, ← Spec.map_comp_assoc, Category.assoc, Iso.inv_hom_id_assoc,
    ← Spec.map_comp_assoc, mvPolynomialULiftFinOneIso_hom_comp_mapRingHom]

/-! ### The preimage of an affine open of the base -/

/-- **The preimage of an affine open `U ⊆ Y` under the projection of the affine line is
`Spec Γ(Y, U)[T]`.** Affine space is stable under base change and the restriction of a morphism to
an open of its target is a base change, so the preimage is the affine line over `U`; and the
affine line over `U ≅ Spec Γ(Y, U)` is `Spec Γ(Y, U)[T]`. -/
def affineLinePreimageIso {Y : Scheme.{u}} {U : Y.Opens} (hU : IsAffineOpen U) :
    Spec (CommRingCat.of (Polynomial ↑Γ(Y, U))) ≅
      ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ U).toScheme :=
  (affineLineSpecIsoSpecPolynomial Γ(Y, U)).symm ≪≫
    affineSpaceIsoOfIso (ULift.{u} (Fin 1)) hU.isoSpec.symm ≪≫
      (AffineSpace.isPullback_map (n := ULift.{u} (Fin 1)) U.ι).isoIsPullback _ _
        (isPullback_morphismRestrict (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) U).flip

/-- The identification of `Stacks.Chow.affineLinePreimageIso`, followed by the inclusion of the
preimage into the affine line, is the base change of `Spec Γ(Y, U) ⟶ Y` to affine lines. -/
theorem affineLinePreimageIso_hom_ι {Y : Scheme.{u}} {U : Y.Opens} (hU : IsAffineOpen U) :
    (affineLinePreimageIso hU).hom ≫ ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ U).ι =
      (affineLineSpecIsoSpecPolynomial Γ(Y, U)).inv ≫
        AffineSpace.map (ULift.{u} (Fin 1)) hU.fromSpec := by
  rw [affineLinePreimageIso, Iso.trans_hom, Iso.trans_hom, Iso.symm_hom, Category.assoc,
    Category.assoc, IsPullback.isoIsPullback_hom_fst]
  congr 1
  rw [show (affineSpaceIsoOfIso (ULift.{u} (Fin 1)) hU.isoSpec.symm).hom =
      AffineSpace.map (ULift.{u} (Fin 1)) hU.isoSpec.inv from rfl, ← AffineSpace.map_comp]
  rfl

/-- **The inclusion of the generic fibre of the affine line factors through the preimage of an
affine open containing the generic point.** The factoring morphism is the one induced by the germ
map `Γ(Y, U) → R(Y)` at the generic point. -/
theorem specMap_comp_affineLinePreimageIso_hom_ι (Y : Scheme.{u}) [IsIntegral Y] {U : Y.Opens}
    (hU : IsAffineOpen U) (hgU : genericPoint ↥Y ∈ U) :
    Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (germFunctionField Y hgU).hom)) ≫
        (affineLinePreimageIso hU).hom ≫ ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ U).ι =
      affineLineGenericFibreι Y := by
  have hstalk : Spec.map (germFunctionField Y hgU) ≫ hU.fromSpec = fromSpecFunctionField Y :=
    hU.fromSpecStalk_eq_fromSpecStalk hgU
  rw [affineLinePreimageIso_hom_ι, ← Category.assoc,
    specMap_mapRingHom_comp_affineLineSpecIsoSpecPolynomial_inv, Category.assoc,
    ← AffineSpace.map_comp, hstalk, affineLineGenericFibreι_eq]

/-! ### A principal prime on an affine open gives a local equation -/

/-- The contraction of a principal ideal along a ring isomorphism is generated by the preimage of
the generator. -/
private theorem comap_span_singleton_of_inverse {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (ψ : S →+* R) (hψφ : ∀ r, ψ (φ r) = r) (hφψ : ∀ s, φ (ψ s) = s) (x : S) :
    (Ideal.span {x} : Ideal S).comap φ = Ideal.span {ψ x} := by
  ext r
  simp only [Ideal.mem_comap, Ideal.mem_span_singleton]
  refine ⟨fun ⟨c, hc⟩ => ⟨ψ c, ?_⟩, fun ⟨c, hc⟩ => ⟨φ c, ?_⟩⟩
  · rw [← hψφ r, hc, map_mul]
  · rw [hc, map_mul, hφψ]

/-- **A point of an affine open whose prime ideal is principal, read off an identification of the
open with a spectrum.** If an affine open `U` of `X` is identified with `Spec R` in such a way
that the point `x` corresponds to a prime `(r)` of `R`, then the section of `𝒪_X` over `U`
corresponding to `r` is nonzero and generates the prime ideal of `x` in `Γ(X, U)`. -/
private theorem exists_section_primeIdealOf_eq_span {X : Scheme.{u}} {U : X.Opens}
    (hU : IsAffineOpen U) {R : CommRingCat.{u}} (e : Spec R ≅ U.toScheme) (P : ↥(Spec R))
    {r : ↑R} (hr : r ≠ 0) (hP : P.asIdeal = Ideal.span {r}) {x : ↥X} (hx : x ∈ U)
    (hxe : U.ι (e.hom P) = x) :
    ∃ t : Γ(X, U), t ≠ 0 ∧ (hU.primeIdealOf ⟨x, hx⟩).asIdeal = Ideal.span {t} := by
  obtain ⟨θ, hθ⟩ : ∃ θ : Γ(X, U) ⟶ R, Spec.map θ = (e ≪≫ hU.isoSpec).hom :=
    ⟨Spec.preimage _, Spec.map_preimage _⟩
  obtain ⟨θ', hθ'⟩ : ∃ θ' : R ⟶ Γ(X, U), Spec.map θ' = (e ≪≫ hU.isoSpec).inv :=
    ⟨Spec.preimage _, Spec.map_preimage _⟩
  have hinv : ∀ {A B : CommRingCat.{u}} (f : A ⟶ B) (g : B ⟶ A), Spec.map g ≫ Spec.map f = 𝟙 _ →
      ∀ y, g.hom (f.hom y) = y := fun f g h y => by
    have : f ≫ g = 𝟙 _ := Spec.map_injective (by rw [Spec.map_comp, h, Spec.map_id])
    simpa using ConcreteCategory.congr_hom this y
  have e₁ := hinv θ' θ (by rw [hθ, hθ', Iso.hom_inv_id])
  have e₂ := hinv θ θ' (by rw [hθ, hθ', Iso.inv_hom_id])
  have hfromSpec : hU.fromSpec ((e ≪≫ hU.isoSpec).hom P) = x := by
    rw [← hxe, ← Scheme.Hom.comp_apply, Iso.trans_hom, Category.assoc,
      IsAffineOpen.isoSpec_hom_fromSpec, Scheme.Hom.comp_apply]
  have hprime : hU.primeIdealOf ⟨x, hx⟩ = (e ≪≫ hU.isoSpec).hom P :=
    hU.fromSpec.isOpenEmbedding.injective
      ((hU.fromSpec_primeIdealOf ⟨x, hx⟩).trans hfromSpec.symm)
  have hcomap : ((e ≪≫ hU.isoSpec).hom P).asIdeal = P.asIdeal.comap θ.hom := by
    rw [← hθ]
    rfl
  refine ⟨θ'.hom r, fun h0 => hr (by rw [← e₁ r, h0, map_zero]), ?_⟩
  rw [hprime, hcomap, hP]
  exact comap_span_singleton_of_inverse _ _ e₂ e₁ r

/-- **A section generating the prime ideal of a point of an affine open is a local equation
there.** Its germ at the point generates the maximal ideal of the local ring, and it is a unit at
every point of the open outside the closure of the given one.

The first is the statement that a prime generated by one element localizes to the maximal ideal
generated by the image of that element, and the second is the statement that the zero locus of a
prime is the closure of the point it cuts out. -/
private theorem germ_span_eq_maximalIdeal_of_primeIdealOf_eq_span {X : Scheme.{u}} {U : X.Opens}
    (hU : IsAffineOpen U) {x : ↥X} (hx : x ∈ U) (t : Γ(X, U))
    (hspan : (hU.primeIdealOf ⟨x, hx⟩).asIdeal = Ideal.span {t}) :
    Ideal.span {(X.presheaf.germ U x hx).hom t} =
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) ∧
      ∀ (z : ↥X) (hz : z ∈ U), ¬ IsUnit ((X.presheaf.germ U z hz).hom t) →
        z ∈ closure ({x} : Set ↥X) := by
  refine ⟨?_, ?_⟩
  · let _ : Algebra ↑Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hx).hom.toAlgebra
    have _ : IsLocalization.AtPrime (X.presheaf.stalk x) (hU.primeIdealOf ⟨x, hx⟩).asIdeal :=
      hU.isLocalization_stalk ⟨x, hx⟩
    have hmax : Ideal.map (X.presheaf.germ U x hx).hom (hU.primeIdealOf ⟨x, hx⟩).asIdeal =
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
      IsLocalization.AtPrime.map_eq_maximalIdeal _ _
    rwa [hspan, Ideal.map_span, Set.image_singleton] at hmax
  · intro z hz hnu
    let _ : Algebra ↑Γ(X, U) (X.presheaf.stalk z) := (X.presheaf.germ U z hz).hom.toAlgebra
    have _ : IsLocalization.AtPrime (X.presheaf.stalk z) (hU.primeIdealOf ⟨z, hz⟩).asIdeal :=
      hU.isLocalization_stalk ⟨z, hz⟩
    have hle : hU.primeIdealOf ⟨x, hx⟩ ≤ hU.primeIdealOf ⟨z, hz⟩ := by
      rw [← PrimeSpectrum.asIdeal_le_asIdeal, hspan, Ideal.span_singleton_le_iff_mem]
      by_contra hc
      exact hnu ((IsLocalization.AtPrime.isUnit_to_map_iff (X.presheaf.stalk z)
        (hU.primeIdealOf ⟨z, hz⟩).asIdeal _).mpr hc)
    have hsing : ({hU.primeIdealOf ⟨x, hx⟩} : Set ↥(Spec Γ(X, U))) ⊆
        (fun p => hU.fromSpec p) ⁻¹' closure ({x} : Set ↥X) := by
      intro p hp
      obtain rfl : p = hU.primeIdealOf ⟨x, hx⟩ := hp
      show hU.fromSpec (hU.primeIdealOf ⟨x, hx⟩) ∈ closure ({x} : Set ↥X)
      rw [hU.fromSpec_primeIdealOf ⟨x, hx⟩]
      exact subset_closure rfl
    have h₂ : hU.fromSpec (hU.primeIdealOf ⟨z, hz⟩) ∈ closure ({x} : Set ↥X) :=
      closure_minimal hsing (isClosed_closure.preimage hU.fromSpec.continuous)
        ((PrimeSpectrum.le_iff_mem_closure _ _).mp hle)
    rwa [hU.fromSpec_primeIdealOf ⟨z, hz⟩] at h₂

/-! ### The global equation -/

/-- The datum the two forms of the global equation are read off: an affine open `U` of `Y`
containing the generic point, a nonzero polynomial `Q` over `Γ(Y, U)`, and a point of
`Spec Γ(Y, U)[T]` whose prime is `(Q)` and which lies over `w` under the identification of
`Spec Γ(Y, U)[T]` with the preimage of `U` in `𝔸¹_Y`. -/
private theorem exists_affineOpen_point_span_singleton (Y : Scheme.{u}) [IsIntegral Y]
    (w : ↥𝔸(ULift.{u} (Fin 1); Y))
    (hdom : (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) w = genericPoint ↥Y)
    (hne : w ≠ genericPoint ↥𝔸(ULift.{u} (Fin 1); Y)) :
    ∃ (U : Y.Opens) (hU : IsAffineOpen U) (_ : genericPoint ↥Y ∈ U)
      (P : ↥(Spec (CommRingCat.of (Polynomial ↑Γ(Y, U))))) (Q : Polynomial ↑Γ(Y, U)),
      Q ≠ 0 ∧ P.asIdeal = Ideal.span {Q} ∧
        ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ U).ι ((affineLinePreimageIso hU).hom P) = w := by
  obtain ⟨U, hUaff, hgU, Q, q, hQm, -, -, -, hqw, hqideal⟩ :=
    exists_opens_monic_isPrime_genericFibre Y w hdom hne
  have _ : IsDomain ↑Γ(Y, U) :=
    Function.Injective.isDomain (germFunctionField Y hgU).hom (germFunctionField_injective Y hgU)
  refine ⟨U, hUaff, hgU,
    Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (germFunctionField Y hgU).hom)) q, Q,
    hQm.ne_zero, ?_, ?_⟩
  · have hcomap : (Spec.map (CommRingCat.ofHom
          (Polynomial.mapRingHom (germFunctionField Y hgU).hom)) q).asIdeal =
        q.asIdeal.comap (Polynomial.mapRingHom (germFunctionField Y hgU).hom) := rfl
    rw [hcomap, hqideal]
    exact (span_singleton_eq_comap_span_singleton_map _ (germFunctionField_injective Y hgU)
      hQm).symm
  · simpa only [Scheme.Hom.comp_apply] using (congrArg
      (fun φ : Spec (CommRingCat.of (Polynomial ↑Y.functionField)) ⟶ 𝔸(ULift.{u} (Fin 1); Y) =>
        φ q) (specMap_comp_affineLinePreimageIso_hom_ι Y hUaff hgU)).trans hqw

/-- **A prime divisor on the affine line over an integral base, dominating the base and not the
whole line, has a global equation over a nonempty open of the base.** Let `Y` be integral and let
`w` be the generic point of an integral closed subscheme `W ⊆ 𝔸¹_Y` which lies over the generic
point of `Y` and is not the generic point of `𝔸¹_Y`. Then there are a nonempty open `V ⊆ Y` —
nonempty, which by `Stacks.Chow.genericPoint_mem_iff_nonempty` is the same as containing the
generic point — and a section `t` of the structure sheaf of `𝔸¹_Y` over the preimage of `V` such
that

* `t ≠ 0`;
* the germ of `t` at `w` generates the maximal ideal of the local ring of `𝔸¹_Y` at `w`, so that
  `t` is a local equation for `W` at `w`; and
* `t` is a unit at every point of the preimage of `V` outside the closure of `{w}`, so that the
  closed subscheme cut out by `t` is supported on `W`.

This is the crux of the fourth paragraph of the proof of Stacks 02TT: `t` is the rational function
whose principal divisor is `W` over `V`. -/
theorem exists_opens_germ_span_eq_maximalIdeal (Y : Scheme.{u}) [IsIntegral Y]
    (w : ↥𝔸(ULift.{u} (Fin 1); Y))
    (hdom : (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) w = genericPoint ↥Y)
    (hne : w ≠ genericPoint ↥𝔸(ULift.{u} (Fin 1); Y)) :
    ∃ (V : Y.Opens) (_ : genericPoint ↥Y ∈ V)
      (hw : w ∈ ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V))
      (t : Γ(𝔸(ULift.{u} (Fin 1); Y), (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V)),
      t ≠ 0 ∧
      Ideal.span {(𝔸(ULift.{u} (Fin 1); Y)).presheaf.germ
          ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V) w hw |>.hom t} =
        IsLocalRing.maximalIdeal ((𝔸(ULift.{u} (Fin 1); Y)).presheaf.stalk w) ∧
      ∀ (z : ↥𝔸(ULift.{u} (Fin 1); Y)) (hz : z ∈ (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V),
        ¬ IsUnit ((𝔸(ULift.{u} (Fin 1); Y)).presheaf.germ
            ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V) z hz |>.hom t) →
          z ∈ closure ({w} : Set ↥𝔸(ULift.{u} (Fin 1); Y)) := by
  obtain ⟨U, hUaff, hgU, P, Q, hQ0, hPideal, hPw⟩ :=
    exists_affineOpen_point_span_singleton Y w hdom hne
  have hw : w ∈ (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ U := by
    show (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) w ∈ U
    rwa [hdom]
  have hVaff : IsAffineOpen ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ U) :=
    (IsAffine.iff_of_isIso (affineLinePreimageIso hUaff).hom).mp inferInstance
  obtain ⟨t, ht0, hspan⟩ := exists_section_primeIdealOf_eq_span hVaff
    (affineLinePreimageIso hUaff) P hQ0 hPideal hw hPw
  exact ⟨U, hgU, hw, t, ht0, germ_span_eq_maximalIdeal_of_primeIdealOf_eq_span hVaff hw t hspan⟩

/-- **The equation of `Stacks.Chow.exists_opens_germ_span_eq_maximalIdeal` as a global section of
the open subscheme `f⁻¹(V)` of `𝔸¹_Y`, generating the prime ideal of the point above `w`.** This
is the purely algebraic form of the statement — `W ∩ f⁻¹(V)` is cut out by the monic polynomial of
`Stacks.Chow.exists_opens_monic_isPrime_genericFibre`, read as an ideal of
`Γ(f⁻¹(V), 𝒪) ≅ Γ(V, 𝒪_Y)[T]` — from which the germ statements follow by localizing at the
point. -/
theorem exists_opens_primeIdealOf_eq_span_restrict (Y : Scheme.{u}) [IsIntegral Y]
    (w : ↥𝔸(ULift.{u} (Fin 1); Y))
    (hdom : (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) w = genericPoint ↥Y)
    (hne : w ≠ genericPoint ↥𝔸(ULift.{u} (Fin 1); Y)) :
    ∃ (V : Y.Opens) (_ : genericPoint ↥Y ∈ V)
      (hV : IsAffine ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).toScheme)
      (w' : ↥((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).toScheme)
      (_ : ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).ι.base w' = w)
      (t : Γ(((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).toScheme, ⊤)),
      t ≠ 0 ∧
        ((@isAffineOpen_top ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).toScheme hV).primeIdealOf
          ⟨w', trivial⟩).asIdeal = Ideal.span {t} := by
  obtain ⟨U, hUaff, hgU, P, Q, hQ0, hPideal, hPw⟩ :=
    exists_affineOpen_point_span_singleton Y w hdom hne
  have hZaff : IsAffine ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ U).toScheme :=
    (IsAffine.iff_of_isIso (affineLinePreimageIso hUaff).hom).mp inferInstance
  have hxe : (⊤ : (((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ U).toScheme).Opens).ι
        ((affineLinePreimageIso hUaff ≪≫
          (Scheme.topIso ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ U).toScheme).symm).hom P) =
      (affineLinePreimageIso hUaff).hom P := by
    rw [← Scheme.Hom.comp_apply, Iso.trans_hom, Iso.symm_hom, Category.assoc,
      Scheme.toIso_inv_ι, Category.comp_id]
  obtain ⟨t, ht0, hspan⟩ := exists_section_primeIdealOf_eq_span
    (isAffineOpen_top ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ U).toScheme)
    (affineLinePreimageIso hUaff ≪≫
      (Scheme.topIso ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ U).toScheme).symm)
    P hQ0 hPideal (x := (affineLinePreimageIso hUaff).hom P) trivial hxe
  exact ⟨U, hgU, hZaff, (affineLinePreimageIso hUaff).hom P, hPw, t, ht0, hspan⟩

/-- **The global equation of `Stacks.Chow.exists_opens_germ_span_eq_maximalIdeal`, read on the
open subscheme of `𝔸¹_Y` over the nonempty open of the base.** This is the form the Chow-group
computation of Stacks 02TT consumes: the cycle whose rational equivalence to zero is being proved
lives on `f⁻¹(V)` as a scheme in its own right, so the equation is a global section of that scheme
and the three facts about it are read at its own points. -/
theorem exists_opens_germ_span_eq_maximalIdeal_restrict (Y : Scheme.{u}) [IsIntegral Y]
    (w : ↥𝔸(ULift.{u} (Fin 1); Y))
    (hdom : (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) w = genericPoint ↥Y)
    (hne : w ≠ genericPoint ↥𝔸(ULift.{u} (Fin 1); Y)) :
    ∃ (V : Y.Opens) (_ : genericPoint ↥Y ∈ V)
      (w' : ↥((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).toScheme)
      (_ : ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).ι.base w' = w)
      (t : Γ(((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).toScheme, ⊤)),
      t ≠ 0 ∧
      Ideal.span {(((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).toScheme.presheaf.germ ⊤ w'
            trivial).hom t} =
        IsLocalRing.maximalIdeal
          (((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).toScheme.presheaf.stalk w') ∧
      ∀ z : ↥((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).toScheme,
        ¬ IsUnit ((((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).toScheme.presheaf.germ ⊤ z
            trivial).hom t) →
          z ∈ closure ({w'} : Set ↥((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).toScheme) := by
  obtain ⟨V, hgV, hV, w', hw', t, ht0, hspan⟩ :=
    exists_opens_primeIdealOf_eq_span_restrict Y w hdom hne
  obtain ⟨h₁, h₂⟩ := germ_span_eq_maximalIdeal_of_primeIdealOf_eq_span
    (@isAffineOpen_top ((𝔸(ULift.{u} (Fin 1); Y) ↘ Y) ⁻¹ᵁ V).toScheme hV)
    (x := w') trivial t hspan
  exact ⟨V, hgV, w', hw', t, ht0, h₁, fun z hz => h₂ z trivial hz⟩

end Stacks.Chow

