module

public import Mathlib.Algebra.Polynomial.Div
public import Mathlib.Algebra.Polynomial.FieldDivision
public import Mathlib.Algebra.Ring.Hom.InjSurj
public import Mathlib.RingTheory.PrincipalIdealDomain
public import Mathlib.RingTheory.Polynomial.Basic

/-!
# A monic polynomial that is irreducible over a field generates a prime ideal

The fourth step of the proof of Stacks 02TT cuts out the generic fibre of a prime cycle on the
affine line over an integral base `Y` by a monic irreducible polynomial `P(T) ∈ R(Y)[T]`, spreads
`P` out to a monic `Q(T) ∈ Γ(V, 𝒪_Y)[T]` of the same degree over a nonempty open `V ⊆ Y`, and
then uses `Q` as a rational function on `𝔸¹_V` whose principal divisor is the cycle. For that
last step the ideal `(Q) ⊆ Γ(V, 𝒪_Y)[T]` has to be *prime*: it has to be the ideal of the prime
cycle, not merely an ideal cutting it out up to multiplicity.

That is what this file proves, as a statement about rings. Let `φ : A →+* K` be an injective ring
homomorphism into a field — for the application, the germ map `Γ(V, 𝒪_Y) → R(Y)` at the generic
point of an integral scheme, which is injective — and let `Q ∈ A[T]` be monic. Division with
remainder by a monic polynomial commutes with `φ` and detects divisibility, which is Mathlib's
`Polynomial.map_dvd_map`; so `(Q)` is the contraction of `(Q.map φ)` along `φ`:

  `Ideal.span {Q} = (Ideal.span {Q.map φ}).comap (Polynomial.mapRingHom φ)`.

A contraction of a prime ideal is prime, and `(P)` is prime in `K[T]` as soon as `P` is
irreducible, because `K[T]` is a principal ideal domain. So `(Q)` is prime, and `Q` is an
irreducible element of `A[T]`.

Nothing here needs `K` to be the fraction field of `A`: injectivity of `φ` and monicity of `Q`
are all that the argument uses.

## Main results

* `Stacks.Chow.span_singleton_eq_comap_span_singleton_map` — `(Q)` is the contraction of
  `(Q.map φ)`.
* `Stacks.Chow.isPrime_span_singleton_of_irreducible_map` — `(Q)` is prime when `Q.map φ` is
  irreducible.
* `Stacks.Chow.irreducible_of_irreducible_map` — `Q` is then an irreducible element of `A[T]`.

## References

* [Stacks Project, Tag 02TT](https://stacks.math.columbia.edu/tag/02TT)
-/

@[expose] public section

universe u

namespace Stacks.Chow

variable {A K : Type u} [CommRing A] [Field K] (φ : A →+* K)

/-- **A monic polynomial generates the contraction of the ideal generated by its image.** Let
`φ : A →+* K` be injective with `K` a field and let `Q ∈ A[T]` be monic. A polynomial `g ∈ A[T]`
is divisible by `Q` exactly when its image is divisible by `Q.map φ`, because division with
remainder by a monic polynomial commutes with `φ` and `φ` is injective
(`Polynomial.map_dvd_map`). -/
theorem span_singleton_eq_comap_span_singleton_map (hφ : Function.Injective φ)
    {Q : Polynomial A} (hQ : Q.Monic) :
    (Ideal.span {Q} : Ideal (Polynomial A)) =
      (Ideal.span {Q.map φ} : Ideal (Polynomial K)).comap (Polynomial.mapRingHom φ) := by
  ext g
  simp only [Ideal.mem_comap, Polynomial.coe_mapRingHom, Ideal.mem_span_singleton]
  exact (Polynomial.map_dvd_map φ hφ hQ).symm

/-- **A monic polynomial whose image is irreducible over a field generates a prime ideal.** The
ideal `(Q)` is the contraction of `(Q.map φ)` by
`Stacks.Chow.span_singleton_eq_comap_span_singleton_map`, and `(Q.map φ)` generates a maximal
ideal because `K[T]` is a principal ideal domain and `Q.map φ` is irreducible. -/
theorem isPrime_span_singleton_of_irreducible_map (hφ : Function.Injective φ)
    {Q : Polynomial A} (hQ : Q.Monic) (hirr : Irreducible (Q.map φ)) :
    (Ideal.span {Q} : Ideal (Polynomial A)).IsPrime := by
  rw [span_singleton_eq_comap_span_singleton_map φ hφ hQ]
  exact (PrincipalIdealRing.isMaximal_of_irreducible hirr).isPrime.comap _

/-- **A monic polynomial whose image is irreducible over a field is irreducible.** Its ideal is
prime by `Stacks.Chow.isPrime_span_singleton_of_irreducible_map`, and a nonzero element
generating a prime ideal is prime, hence irreducible. The ring `A` is a domain because it embeds
in the field `K`. -/
theorem irreducible_of_irreducible_map (hφ : Function.Injective φ) {Q : Polynomial A}
    (hQ : Q.Monic) (hirr : Irreducible (Q.map φ)) : Irreducible Q := by
  have _ : IsDomain A := Function.Injective.isDomain φ hφ
  exact ((Ideal.span_singleton_prime hQ.ne_zero).1
    (isPrime_span_singleton_of_irreducible_map φ hφ hQ hirr)).irreducible

end Stacks.Chow

end
