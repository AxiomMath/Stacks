module

public import Mathlib.Algebra.MvPolynomial.Nilpotent
public import Mathlib.RingTheory.Noetherian.Nilpotent
public import StacksFrontier.AlgebraicGeometry.Chow.AffineBundle.LocalModel

/-!
# Rescaling the coordinates of the local model of an affine bundle

Rescaling the two variables of `B[z₁, z₂]` by units of `B[z₁, z₂]`, that is, substituting
`z₁ ↦ v z₁` and `z₂ ↦ w z₂` for units `v, w`, is an automorphism of `B[z₁, z₂]`. Consequently the
local model `B[z₁, z₂]/(z₁z₂ - f)` of `Stacks.AffineBundle.LocalModel` only depends on the ideal
cut out by the defining relation up to such a rescaling: if `h₁, h₂` generate the same ideals as
`z₁, z₂` do, then `B[z₁, z₂]/(h₁h₂ - f)` is again the local model of the affine bundle attached to
`f`.

This is the ring-theoretic input to clause (2) of [Stacks, Tag 0F97]: a local equation for the two
branches of a degenerating affine bundle is only determined up to a unit, and the presentation of
the local model must not depend on which equation was picked.

## Main definitions

* `Stacks.AffineBundle.scaleEquiv` — the automorphism of `MvPolynomial σ B` rescaling each
  variable by a unit of the **base** ring `B`, which is written down explicitly together with its
  inverse.
* `Stacks.AffineBundle.rescaleEquiv` — **the rescaling automorphism**: the automorphism of
  `B[z₁, z₂]` sending `z₁ ↦ v z₁` and `z₂ ↦ w z₂` for units `v, w` of `B[z₁, z₂]`.
* `Stacks.AffineBundle.localModelEquivRescale`,
  `Stacks.AffineBundle.localModelEquivOfSpanEq`,
  `Stacks.AffineBundle.localModelEquivOfMulSpanEq` and
  `Stacks.AffineBundle.localModelEquivOfCoordSpanEq` — the resulting identifications of
  `B[z₁, z₂]/(a)` with the local model, for the various shapes in which the generator `a` arises.

## Main results

* `Stacks.AffineBundle.bijective_of_sub_mem_map_nilpotent` — **an endomorphism of a `B`-algebra
  that agrees with an automorphism modulo a nilpotent ideal of the base is bijective.**
* `Stacks.AffineBundle.bijective_aeval_mul_X` — **rescaling the variables of a polynomial ring by
  units is bijective.**
* `Stacks.AffineBundle.exists_isUnit_mul_X_of_span_eq` — a polynomial generating the same ideal as
  a variable is a unit multiple of that variable.

## Implementation notes

The rescaling map `z_i ↦ c_i z_i` is not obviously surjective, because the units `c_i` are
arbitrary polynomials. The proof goes through the structure of the units of a polynomial ring: a
unit `c` is the sum of a unit `c(0)` of the base ring and a polynomial all of whose coefficients
are nilpotent. The finitely many coefficients occurring this way generate a finitely generated
ideal `J` of `B` contained in the nilradical, hence a nilpotent ideal, and modulo `J` the rescaling
map becomes the rescaling of the variables by the units `c_i(0)` of `B`, which is visibly an
automorphism (`scaleEquiv`).

That reduction is packaged as `bijective_of_sub_mem_map_nilpotent`, stated for an arbitrary
`B`-algebra: if `φ` is a `B`-algebra endomorphism, `ψ` a `B`-algebra automorphism, and
`φ x - ψ x ∈ J·A` for every `x`, with `J` a nilpotent ideal of `B`, then `φ` is bijective. Both
halves are the same induction, run on the `J`-adic filtration `J^k·A`, whose key step is that `φ`
and `ψ` agree modulo `J^{k+1}·A` on `J^k·A`: this holds because `φ` and `ψ` fix `J^k` elementwise,
being `B`-algebra maps, so only the second factor of each product `algebraMap b * a` moves, and it
moves by an element of `J·A`.

## References

* [Stacks, Tag 0F97]
-/

@[expose] public noncomputable section

open MvPolynomial

universe u v w

namespace Stacks.AffineBundle

/-! ### Lifting an isomorphism along a nilpotent ideal of the base -/

section Nilpotent

variable {B : Type u} [CommRing B] {A : Type v} [CommRing A] [Algebra B A]

/-- A `B`-algebra endomorphism preserves the ideal generated by an ideal of the base. -/
private theorem mem_map_algebraMap_of_algHom (φ : A →ₐ[B] A) {J : Ideal B} {p : A}
    (hp : p ∈ J.map (algebraMap B A)) : φ p ∈ J.map (algebraMap B A) := by
  have h := Ideal.mem_map_of_mem (φ : A →+* A) hp
  rwa [Ideal.map_map, φ.comp_algebraMap] at h

/-- A `B`-algebra automorphism reflects the ideal generated by an ideal of the base. -/
private theorem mem_map_algebraMap_algEquiv_iff (ψ : A ≃ₐ[B] A) {J : Ideal B} {p : A} :
    ψ p ∈ J.map (algebraMap B A) ↔ p ∈ J.map (algebraMap B A) := by
  refine ⟨fun hp => ?_, fun hp => mem_map_algebraMap_of_algHom (ψ : A →ₐ[B] A) hp⟩
  have h := mem_map_algebraMap_of_algHom (ψ.symm : A →ₐ[B] A) hp
  rwa [show (ψ.symm : A →ₐ[B] A) (ψ p) = p from ψ.symm_apply_apply p] at h

/-- Two `B`-algebra endomorphisms agreeing modulo the ideal generated by an ideal `J` of the base
agree modulo `J * K` on the ideal generated by an ideal `K` of the base: the two maps fix the
coefficients from the base, so only the second factor of a product `algebraMap b * a` moves. -/
private theorem sub_mem_map_mul (φ ψ : A →ₐ[B] A) {J : Ideal B}
    (h : ∀ x, φ x - ψ x ∈ J.map (algebraMap B A)) (K : Ideal B) {p : A}
    (hp : p ∈ K.map (algebraMap B A)) :
    φ p - ψ p ∈ (J * K).map (algebraMap B A) := by
  have hp' : p ∈ Ideal.span ((algebraMap B A) '' (K : Set B)) := by
    rwa [← Ideal.map_span, Ideal.span_eq]
  clear hp
  induction hp' using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨b, -, rfl⟩ := hx
      simp [AlgHom.commutes]
  | zero => simp
  | add x y hx hy ihx ihy =>
      rw [show φ (x + y) - ψ (x + y) = (φ x - ψ x) + (φ y - ψ y) by
        rw [map_add, map_add]; ring]
      exact Ideal.add_mem _ ihx ihy
  | smul a x hx ih =>
      have hxK : x ∈ K.map (algebraMap B A) := by
        rwa [← Ideal.span_eq K, Ideal.map_span]
      rw [show φ (a • x) - ψ (a • x) = φ a * (φ x - ψ x) + (φ a - ψ a) * ψ x by
        rw [smul_eq_mul, map_mul, map_mul]; ring]
      refine Ideal.add_mem _ (Ideal.mul_mem_left _ _ ih) ?_
      rw [Ideal.map_mul]
      exact Ideal.mul_mem_mul (h a) (mem_map_algebraMap_of_algHom ψ hxK)

/-- **An endomorphism agreeing with an automorphism modulo a nilpotent ideal of the base is
bijective.** Both halves are the same induction along the `J`-adic filtration: if `φ p = 0` then
`p` lies in `J^k·A` for every `k`, and every element of `A` is congruent to something in the image
of `φ` modulo `J^k·A` for every `k`. -/
theorem bijective_of_sub_mem_map_nilpotent (φ : A →ₐ[B] A) (ψ : A ≃ₐ[B] A) {J : Ideal B}
    (hJ : IsNilpotent J) (h : ∀ x, φ x - ψ x ∈ J.map (algebraMap B A)) :
    Function.Bijective φ := by
  obtain ⟨m, hm⟩ := hJ
  have hbot : (J ^ m).map (algebraMap B A) = ⊥ := by
    rw [hm, Ideal.zero_eq_bot, Ideal.map_bot]
  have htop (p : A) : p ∈ (J ^ 0).map (algebraMap B A) := by simp [Ideal.map_top]
  have key (k : ℕ) {p : A} (hp : p ∈ (J ^ k).map (algebraMap B A)) :
      φ p - ψ p ∈ (J ^ (k + 1)).map (algebraMap B A) :=
    pow_succ' J k ▸ sub_mem_map_mul φ (ψ : A →ₐ[B] A) h (J ^ k) hp
  constructor
  · refine (injective_iff_map_eq_zero φ).mpr fun p hp => ?_
    have step (k : ℕ) : p ∈ (J ^ k).map (algebraMap B A) := by
      induction k with
      | zero => exact htop p
      | succ k ih =>
          have h1 := key k ih
          rw [hp, zero_sub, neg_mem_iff] at h1
          exact (mem_map_algebraMap_algEquiv_iff ψ).mp h1
    simpa [hbot] using step m
  · intro q
    have step (k : ℕ) : ∃ p, q - φ p ∈ (J ^ k).map (algebraMap B A) := by
      induction k with
      | zero => exact ⟨0, htop _⟩
      | succ k ih =>
          obtain ⟨p, hpk⟩ := ih
          have h1 := key k ((mem_map_algebraMap_algEquiv_iff ψ.symm).mpr hpk)
          rw [ψ.apply_symm_apply] at h1
          refine ⟨p + ψ.symm (q - φ p), ?_⟩
          rw [show q - φ (p + ψ.symm (q - φ p))
              = -(φ (ψ.symm (q - φ p)) - (q - φ p)) by rw [map_add]; ring]
          exact neg_mem h1
    obtain ⟨p, hp⟩ := step m
    exact ⟨p, (sub_eq_zero.mp (by simpa [hbot] using hp)).symm⟩

end Nilpotent

/-! ### Rescaling the variables of a polynomial ring by units -/

section Rescale

variable {B : Type u} [CommRing B] {σ : Type w}

/-- A polynomial all of whose coefficients lie in an ideal `J` of the base lies in the ideal
generated by `J`. -/
private theorem mem_map_algebraMap_of_coeff_mem {J : Ideal B} {p : MvPolynomial σ B}
    (h : ∀ m, p.coeff m ∈ J) : p ∈ J.map (algebraMap B (MvPolynomial σ B)) := by
  rw [p.as_sum]
  refine Ideal.sum_mem _ fun m _ => ?_
  rw [show (monomial m (p.coeff m) : MvPolynomial σ B)
      = algebraMap B (MvPolynomial σ B) (p.coeff m) * monomial m 1 by
    rw [algebraMap_eq, C_mul_monomial, mul_one]]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (h m))

/-- Finitely many polynomials with nilpotent coefficients all lie in the ideal generated by a
single nilpotent ideal of the base, namely the ideal generated by their coefficients. -/
private theorem exists_nilpotent_ideal_of_coeff_nilpotent [Finite σ] (n : σ → MvPolynomial σ B)
    (hn : ∀ (i) (m : σ →₀ ℕ), IsNilpotent ((n i).coeff m)) :
    ∃ J : Ideal B, IsNilpotent J ∧
      ∀ i, n i ∈ J.map (algebraMap B (MvPolynomial σ B)) := by
  classical
  refine ⟨Ideal.span (⋃ i, ((n i).coeffs : Set B)), ?_, ?_⟩
  · have hfg : (Ideal.span (⋃ i, ((n i).coeffs : Set B))).FG :=
      Submodule.fg_span (Set.finite_iUnion fun i => Finset.finite_toSet _)
    refine (Ideal.FG.isNilpotent_iff_le_nilradical hfg).mpr ?_
    rw [Ideal.span_le]
    rintro b hb
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hb
    obtain ⟨m, -, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp hi
    exact mem_nilradical.mpr (hn i m)
  · intro i
    refine mem_map_algebraMap_of_coeff_mem fun m => ?_
    rcases eq_or_ne ((n i).coeff m) 0 with h0 | h0
    · rw [h0]
      exact Ideal.zero_mem _
    · exact Ideal.subset_span (Set.mem_iUnion.mpr ⟨i, MvPolynomial.coeff_mem_coeffs m h0⟩)

/-- **Rescaling each variable by a unit of the base ring** is an automorphism of the polynomial
ring, with inverse the rescaling by the inverse units. -/
def scaleEquiv (e : σ → Bˣ) : MvPolynomial σ B ≃ₐ[B] MvPolynomial σ B :=
  AlgEquiv.ofAlgHom (aeval fun i => C ((e i : B)) * X i)
    (aeval fun i => C (((e i)⁻¹ : Bˣ) : B) * X i)
    (MvPolynomial.algHom_ext fun i => by
      simp only [AlgHom.comp_apply, aeval_X, AlgHom.id_apply, map_mul, aeval_C, algebraMap_eq]
      rw [← mul_assoc, ← C_mul, Units.inv_mul, C_1, one_mul])
    (MvPolynomial.algHom_ext fun i => by
      simp only [AlgHom.comp_apply, aeval_X, AlgHom.id_apply, map_mul, aeval_C, algebraMap_eq]
      rw [← mul_assoc, ← C_mul, Units.mul_inv, C_1, one_mul])

/-- The rescaling `scaleEquiv e` sends the variable `X i` to `C (e i) * X i`. -/
@[simp] theorem scaleEquiv_X (e : σ → Bˣ) (i : σ) :
    scaleEquiv e (X i) = C ((e i : B)) * X i := by
  simp [scaleEquiv]

/-- **Rescaling the variables of a polynomial ring by units is bijective.** -/
theorem bijective_aeval_mul_X [Finite σ] {c : σ → MvPolynomial σ B} (hc : ∀ i, IsUnit (c i)) :
    Function.Bijective
      (aeval (fun i => c i * X i) : MvPolynomial σ B →ₐ[B] MvPolynomial σ B) := by
  classical
  have hd : ∀ i, IsUnit ((c i).coeff 0) := fun i => (MvPolynomial.isUnit_iff.mp (hc i)).1
  have hn : ∀ (i) (m : σ →₀ ℕ),
      IsNilpotent ((c i - C ((c i).coeff 0)).coeff m) := by
    intro i m
    rcases eq_or_ne m 0 with rfl | hm
    · simp
    · have hC : (C ((c i).coeff 0) : MvPolynomial σ B).coeff m = 0 := by
        rw [coeff_C, ite_eq_right (Ne.symm hm)]
      simpa [hC] using (MvPolynomial.isUnit_iff.mp (hc i)).2 m hm
  obtain ⟨J, hJnil, hJmem⟩ :=
    exists_nilpotent_ideal_of_coeff_nilpotent (fun i => c i - C ((c i).coeff 0)) hn
  refine bijective_of_sub_mem_map_nilpotent _ (scaleEquiv fun i => (hd i).unit) hJnil ?_
  have key : (Ideal.Quotient.mkₐ B (J.map (algebraMap B (MvPolynomial σ B)))).comp
        (aeval fun i => c i * X i)
      = (Ideal.Quotient.mkₐ B (J.map (algebraMap B (MvPolynomial σ B)))).comp
        ((scaleEquiv fun i => (hd i).unit : MvPolynomial σ B ≃ₐ[B] MvPolynomial σ B) :
          MvPolynomial σ B →ₐ[B] MvPolynomial σ B) := by
    ext i
    simp only [AlgHom.comp_apply, aeval_X, AlgEquiv.coe_toAlgHom, scaleEquiv_X,
      Ideal.Quotient.mkₐ_eq_mk]
    rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem,
      show c i * X i - C (((hd i).unit : B)) * X i = (c i - C ((c i).coeff 0)) * X i by
        rw [IsUnit.unit_spec]; ring]
    exact Ideal.mul_mem_right _ _ (hJmem i)
  intro x
  have hx := AlgHom.congr_fun key x
  simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, AlgEquiv.coe_toAlgHom] at hx
  rwa [Ideal.Quotient.eq] at hx

end Rescale

/-! ### The local model is insensitive to a rescaling of its defining relation -/

section LocalModel

variable {B : Type u} [CommRing B]

/-- **The rescaling automorphism of `B[z₁, z₂]`**: the `B`-algebra automorphism sending `z₁` to
`v z₁` and `z₂` to `w z₂`, for units `v, w` of `B[z₁, z₂]`. -/
def rescaleEquiv (v w : MvPolynomial (Fin 2) B) (hv : IsUnit v) (hw : IsUnit w) :
    MvPolynomial (Fin 2) B ≃ₐ[B] MvPolynomial (Fin 2) B :=
  AlgEquiv.ofBijective (aeval fun i => ![v, w] i * X i)
    (bijective_aeval_mul_X (by
      intro i
      fin_cases i
      · simpa using hv
      · simpa using hw))

/-- The rescaling automorphism sends `z₁ = X 0` to `v * X 0`. -/
@[simp] theorem rescaleEquiv_X_zero (v w : MvPolynomial (Fin 2) B) (hv : IsUnit v)
    (hw : IsUnit w) : rescaleEquiv v w hv hw (X 0) = v * X 0 := by
  simp [rescaleEquiv]

/-- The rescaling automorphism sends `z₂ = X 1` to `w * X 1`. -/
@[simp] theorem rescaleEquiv_X_one (v w : MvPolynomial (Fin 2) B) (hv : IsUnit v)
    (hw : IsUnit w) : rescaleEquiv v w hv hw (X 1) = w * X 1 := by
  simp [rescaleEquiv]

/-- The rescaling automorphism carries the defining relation of the local model to the relation
rescaled by the product of the two units. -/
theorem rescaleEquiv_localRelation (v w : MvPolynomial (Fin 2) B) (hv : IsUnit v) (hw : IsUnit w)
    (f : B) :
    rescaleEquiv v w hv hw (localRelation B f) = v * w * (X 0 * X 1) - C f := by
  rw [localRelation, map_sub, map_mul, rescaleEquiv_X_zero, rescaleEquiv_X_one,
    show rescaleEquiv v w hv hw (C f) = C f by
      rw [← algebraMap_eq]; exact AlgEquiv.commutes _ f]
  ring

/-- **The local model is insensitive to rescaling its defining relation by units.** -/
def localModelEquivRescale (v w : MvPolynomial (Fin 2) B) (hv : IsUnit v) (hw : IsUnit w)
    (f : B) :
    (MvPolynomial (Fin 2) B ⧸ Ideal.span {v * w * (X 0 * X 1) - C f}) ≃ₐ[B] LocalModel B f :=
  (Ideal.quotientEquivAlg (Ideal.span {localRelation B f})
    (Ideal.span {v * w * (X 0 * X 1) - C f}) (rescaleEquiv v w hv hw) (by
      rw [Ideal.map_span, Set.image_singleton]
      exact congrArg (fun x => Ideal.span ({x} : Set (MvPolynomial (Fin 2) B)))
        (rescaleEquiv_localRelation v w hv hw f).symm)).symm

/-- The same identification, for an arbitrary generator of the rescaled relation. -/
def localModelEquivOfSpanEq (v w : MvPolynomial (Fin 2) B) (hv : IsUnit v) (hw : IsUnit w)
    (f : B) (a : MvPolynomial (Fin 2) B)
    (ha : Ideal.span {a} = Ideal.span {v * w * (X 0 * X 1) - C f}) :
    (MvPolynomial (Fin 2) B ⧸ Ideal.span {a}) ≃ₐ[B] LocalModel B f :=
  (Ideal.quotientEquivAlgOfEq B ha).trans (localModelEquivRescale v w hv hw f)

/-- The same identification, for a generator presented as the difference of a product of two unit
multiples of the variables and the image of `f`. -/
def localModelEquivOfMulSpanEq (a v w : MvPolynomial (Fin 2) B) (hv : IsUnit v) (hw : IsUnit w)
    (f : B) (ha : a = v * X 0 * (w * X 1) - C f) :
    (MvPolynomial (Fin 2) B ⧸ Ideal.span {a}) ≃ₐ[B] LocalModel B f :=
  localModelEquivOfSpanEq v w hv hw f a (by
    rw [ha, show v * X 0 * (w * X 1) - C f = v * w * (X 0 * X 1) - C f by ring])

/-- **A polynomial generating the same ideal as a variable is a unit multiple of that variable.**
Only the regularity of `X i` is used, so no hypothesis on the base ring is needed. -/
theorem exists_isUnit_mul_X_of_span_eq {σ : Type w} {i : σ} {h : MvPolynomial σ B}
    (hh : Ideal.span {h} = Ideal.span {(X i : MvPolynomial σ B)}) :
    ∃ v, IsUnit v ∧ h = v * X i := by
  have h1 : h ∈ Ideal.span {(X i : MvPolynomial σ B)} := hh ▸ Ideal.mem_span_singleton_self h
  have h2 : (X i : MvPolynomial σ B) ∈ Ideal.span {h} := hh ▸ Ideal.mem_span_singleton_self _
  obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp h1
  obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp h2
  have hreg : Function.Injective fun y : MvPolynomial σ B => y * X i :=
    (MvPolynomial.isRegular_X (n := i)).right
  have hvu : v * u = 1 := hreg <| by
    change v * u * X i = 1 * X i
    rw [one_mul, mul_comm v, mul_assoc, hv, hu]
  exact ⟨v, ⟨⟨v, u, hvu, (mul_comm u v).trans hvu⟩, rfl⟩, hv.symm⟩

/-- **The deliverable form**: if `h₀` and `h₁` generate the same ideals as the two variables do,
then `B[z₁, z₂]/(h₀h₁ - f)` is the local model of the affine bundle attached to `f`. -/
def localModelEquivOfCoordSpanEq (h₀ h₁ : MvPolynomial (Fin 2) B)
    (hh₀ : Ideal.span {h₀} = Ideal.span {(X 0 : MvPolynomial (Fin 2) B)})
    (hh₁ : Ideal.span {h₁} = Ideal.span {(X 1 : MvPolynomial (Fin 2) B)}) (f : B) :
    (MvPolynomial (Fin 2) B ⧸ Ideal.span {h₀ * h₁ - C f}) ≃ₐ[B] LocalModel B f :=
  localModelEquivOfMulSpanEq (h₀ * h₁ - C f)
    (exists_isUnit_mul_X_of_span_eq hh₀).choose
    (exists_isUnit_mul_X_of_span_eq hh₁).choose
    (exists_isUnit_mul_X_of_span_eq hh₀).choose_spec.1
    (exists_isUnit_mul_X_of_span_eq hh₁).choose_spec.1 f
    (by rw [← (exists_isUnit_mul_X_of_span_eq hh₀).choose_spec.2,
        ← (exists_isUnit_mul_X_of_span_eq hh₁).choose_spec.2])

end LocalModel

end Stacks.AffineBundle

end
