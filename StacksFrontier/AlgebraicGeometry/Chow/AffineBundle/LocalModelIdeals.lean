module

public import StacksFrontier.AlgebraicGeometry.Chow.AffineBundle.LocalModel

/-!
# The two coordinate ideals of the local model of an affine bundle

Let `B` be a commutative ring, let `f : B` and let `R = B[z₁, z₂]/(z₁z₂ - f)` be the local model
of an affine bundle of `Stacks.AffineBundle.LocalModel`. This file computes the intersection of
the two principal ideals generated by the coordinates:

`(z₁) ∩ (z₂) = (z₁z₂) = (f)`.

This is the ring-theoretic content of the reverse inequality in condition (5) of [Stacks, Tag
0F97]: the scheme-theoretic union of the two branches `z₁ = 0` and `z₂ = 0` of the degenerating
affine bundle is exactly the inverse image of the vanishing locus of `f`.

## Main definitions

* `Stacks.AffineBundle.equivFinsupp`: the local model as `ℤ →₀ B`, the linear equivalence
  underlying `Stacks.AffineBundle.basis`.
* `Stacks.AffineBundle.coeff`: the `B`-linear coefficient functionals of that basis.

## Main results

* `Stacks.AffineBundle.coord_zero_mul_basis` and `Stacks.AffineBundle.coord_one_mul_basis`:
  **multiplication by a coordinate shifts the basis**, by one step, picking up a factor `f`
  exactly when the step crosses the origin.
* `Stacks.AffineBundle.coeff_coord_zero_mul` and `Stacks.AffineBundle.coeff_coord_one_mul`: the
  same statement read on coefficients.
* `Stacks.AffineBundle.span_coord_zero_inf_span_coord_one`: **`(z₁) ∩ (z₂) = (z₁z₂)`.**
* `Stacks.AffineBundle.span_coord_zero_inf_span_coord_one_eq_span_f`: the same intersection,
  read as the ideal generated by `f`.

## Implementation notes

The proof is a coefficient computation in the `ℤ`-indexed basis `{z₁ⁿ}ₙ₌₀… ∪ {z₂ᵐ}ₘ₌₁…`, where
multiplication by `z₁` is the shift `n ↦ n + 1` scaled by `f` on the indices `n < 0`, and
multiplication by `z₂` is the shift `n ↦ n - 1` scaled by `f` on the indices `n > 0`. An element
of `(z₁)` therefore has all its coefficients of index `≤ 0` divisible by `f`, and an element of
`(z₂)` all its coefficients of index `≥ 0`; an element of the intersection has all of them
divisible by `f`, which is membership in `(f)`.

The witness exhibiting an element of the intersection as `f` times something is assembled from
the two given factorizations `x = z₁a = z₂b` by splitting at the origin — the positive
coefficients come from `b` and the non-positive ones from `a` — so no choice of a quotient by `f`
is made anywhere and the proof produces the factorization explicitly.

## References

* [Stacks Project, Tag 0F97](https://stacks.math.columbia.edu/tag/0F97)
-/

@[expose] public noncomputable section

universe u

namespace Stacks.AffineBundle

variable (B : Type u) [CommRing B] (f : B)

/-- **The local model, read as the free `B`-module `ℤ →₀ B`**: the linear equivalence underlying
`Stacks.AffineBundle.basis`, sending the basis vector of index `n` to `z₁^n` for `n ≥ 0` and to
`z₂^{-n}` for `n < 0`. -/
def equivFinsupp : (ℤ →₀ B) ≃ₗ[B] LocalModel B f :=
  LinearEquiv.ofBijective (toLocalModel B f)
    ⟨injective_toLocalModel B f, LinearMap.range_eq_top.mp (range_toLocalModel B f)⟩

/-- The basis `Stacks.AffineBundle.basis` is the image of the standard basis of `ℤ →₀ B` under
`Stacks.AffineBundle.equivFinsupp`. -/
theorem basis_eq_map : basis B f = Finsupp.basisSingleOne.map (equivFinsupp B f) := rfl

/-- **The coefficient of index `n`** of an element of the local model in the `ℤ`-indexed
basis. -/
def coeff (n : ℤ) : LocalModel B f →ₗ[B] B :=
  (Finsupp.lapply n).comp (equivFinsupp B f).symm.toLinearMap

/-- The coefficient of index `n` of `x` is the value at `n` of the preimage of `x` in `ℤ →₀ B`. -/
theorem coeff_apply (n : ℤ) (x : LocalModel B f) :
    coeff B f n x = (equivFinsupp B f).symm x n := rfl

/-- The coefficient of index `n` of the image of `c : ℤ →₀ B` is `c n`. -/
theorem coeff_equivFinsupp (c : ℤ →₀ B) (n : ℤ) : coeff B f n (equivFinsupp B f c) = c n := by
  rw [coeff_apply, LinearEquiv.symm_apply_apply]

/-- The coefficients of a basis vector. -/
theorem coeff_basis (m n : ℤ) : coeff B f n (basis B f m) = if n = m then 1 else 0 := by
  rw [basis_eq_map, Module.Basis.map_apply,
    show (Finsupp.basisSingleOne : Module.Basis ℤ B (ℤ →₀ B)) m = Finsupp.single m 1 from rfl,
    coeff_equivFinsupp, Finsupp.single_apply]
  exact if_congr eq_comm rfl rfl

/-- **Multiplication by the first coordinate shifts the basis up by one**, picking up a factor
`f` exactly on the negative indices. -/
theorem coord_zero_mul_basis (n : ℤ) :
    coord B f 0 * basis B f n = (if 0 ≤ n then (1 : B) else f) • basis B f (n + 1) := by
  rw [basis_apply, basis_apply,
    show coord B f 0 * (coord B f 0 ^ n.toNat * coord B f 1 ^ (-n).toNat)
      = coord B f 0 ^ (n.toNat + 1) * coord B f 1 ^ (-n).toNat from by ring,
    coord_pow_mul_coord_pow,
    show n.toNat + 1 - (-n).toNat = (n + 1).toNat from by omega,
    show (-n).toNat - (n.toNat + 1) = (-(n + 1)).toNat from by omega]
  rcases le_or_gt 0 n with h | h
  · rw [if_pos h, show min (n.toNat + 1) ((-n).toNat) = 0 from by omega, pow_zero]
  · rw [if_neg (not_le.mpr h), show min (n.toNat + 1) ((-n).toNat) = 1 from by omega, pow_one]

/-- **Multiplication by the second coordinate shifts the basis down by one**, picking up a factor
`f` exactly on the positive indices. -/
theorem coord_one_mul_basis (n : ℤ) :
    coord B f 1 * basis B f n = (if n ≤ 0 then (1 : B) else f) • basis B f (n - 1) := by
  rw [basis_apply, basis_apply,
    show coord B f 1 * (coord B f 0 ^ n.toNat * coord B f 1 ^ (-n).toNat)
      = coord B f 0 ^ n.toNat * coord B f 1 ^ ((-n).toNat + 1) from by ring,
    coord_pow_mul_coord_pow,
    show n.toNat - ((-n).toNat + 1) = (n - 1).toNat from by omega,
    show (-n).toNat + 1 - n.toNat = (-(n - 1)).toNat from by omega]
  rcases le_or_gt n 0 with h | h
  · rw [if_pos h, show min (n.toNat) ((-n).toNat + 1) = 0 from by omega, pow_zero]
  · rw [if_neg (not_le.mpr h), show min (n.toNat) ((-n).toNat + 1) = 1 from by omega, pow_one]

/-- A coefficient of `z * x` is `c` times a coefficient of `x` once this holds on the basis. -/
private theorem coeff_mul_of_basis (z : LocalModel B f) (n s : ℤ) (c : B)
    (h : ∀ m, coeff B f n (z * basis B f m) = c * coeff B f s (basis B f m))
    (x : LocalModel B f) : coeff B f n (z * x) = c * coeff B f s x := by
  have h' := congrArg (fun L : LocalModel B f →ₗ[B] B => L x)
    ((basis B f).ext (f₁ := (coeff B f n).comp (LinearMap.mulLeft B z))
      (f₂ := c • coeff B f s) h)
  simpa using h'

/-- **The coefficients of `z₁x`**: the coefficient of index `n` is the coefficient of index
`n - 1` of `x`, times `f` when `n ≤ 0`. -/
theorem coeff_coord_zero_mul (n : ℤ) (x : LocalModel B f) :
    coeff B f n (coord B f 0 * x) = (if 0 < n then (1 : B) else f) * coeff B f (n - 1) x := by
  refine coeff_mul_of_basis B f _ _ _ _ (fun m => ?_) x
  rw [coord_zero_mul_basis, map_smul, coeff_basis, coeff_basis, smul_eq_mul]
  by_cases hm : n = m + 1
  · subst hm
    rw [if_pos rfl, if_pos (show m + 1 - 1 = m from by omega), mul_one, mul_one]
    rcases le_or_gt 0 m with h | h
    · rw [if_pos h, if_pos (show (0 : ℤ) < m + 1 from by omega)]
    · rw [if_neg (not_le.mpr h), if_neg (show ¬ (0 : ℤ) < m + 1 from by omega)]
  · rw [if_neg hm, if_neg (show ¬ n - 1 = m from by omega), mul_zero, mul_zero]

/-- **The coefficients of `z₂x`**: the coefficient of index `n` is the coefficient of index
`n + 1` of `x`, times `f` when `n ≥ 0`. -/
theorem coeff_coord_one_mul (n : ℤ) (x : LocalModel B f) :
    coeff B f n (coord B f 1 * x) = (if n < 0 then (1 : B) else f) * coeff B f (n + 1) x := by
  refine coeff_mul_of_basis B f _ _ _ _ (fun m => ?_) x
  rw [coord_one_mul_basis, map_smul, coeff_basis, coeff_basis, smul_eq_mul]
  by_cases hm : n = m - 1
  · subst hm
    rw [if_pos rfl, if_pos (show m - 1 + 1 = m from by omega), mul_one, mul_one]
    rcases le_or_gt m 0 with h | h
    · rw [if_pos h, if_pos (show m - 1 < (0 : ℤ) from by omega)]
    · rw [if_neg (not_le.mpr h), if_neg (show ¬ m - 1 < (0 : ℤ) from by omega)]
  · rw [if_neg hm, if_neg (show ¬ n + 1 = m from by omega), mul_zero, mul_zero]

/-- The coefficient of index `n` of `a` is the value at `n` of the shifted preimage. -/
private theorem coeff_mapDomain_of_eq (g : ℤ → ℤ) (hg : Function.Injective g) (a : LocalModel B f)
    {n m : ℤ} (h : g m = n) :
    Finsupp.mapDomain g ((equivFinsupp B f).symm a) n = coeff B f m a := by
  rw [← h, Finsupp.mapDomain_apply_of_injective hg, coeff_apply]

/-- **The intersection of the two coordinate ideals of the local model is the ideal generated by
their product.** An element of `(z₁)` has all its coefficients of index `≤ 0` divisible by `f`,
an element of `(z₂)` all its coefficients of index `≥ 0`, so an element of the intersection has
all of them divisible by `f`; the quotients are read off the two given factorizations, the
positive indices from the second and the non-positive ones from the first. -/
theorem span_coord_zero_inf_span_coord_one :
    (Ideal.span {coord B f 0} ⊓ Ideal.span {coord B f 1} : Ideal (LocalModel B f))
      = Ideal.span {coord B f 0 * coord B f 1} := by
  refine le_antisymm ?_ ?_
  · rintro x ⟨hx₁, hx₂⟩
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hx₁
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hx₂
    rw [mul_comm] at ha hb
    set y : LocalModel B f := equivFinsupp B f
      (Finsupp.filter (fun n : ℤ => 0 < n)
          (Finsupp.mapDomain (fun m : ℤ => m - 1) ((equivFinsupp B f).symm b))
        + Finsupp.filter (fun n : ℤ => ¬ 0 < n)
          (Finsupp.mapDomain (fun m : ℤ => m + 1) ((equivFinsupp B f).symm a))) with hy
    have hcoeff : ∀ n : ℤ,
        coeff B f n y = if 0 < n then coeff B f (n + 1) b else coeff B f (n - 1) a := by
      intro n
      rw [hy, coeff_equivFinsupp, Finsupp.add_apply, Finsupp.filter_apply, Finsupp.filter_apply,
        coeff_mapDomain_of_eq B f _ (sub_left_injective (b := 1)) b (m := n + 1) (by simp),
        coeff_mapDomain_of_eq B f _ (add_left_injective 1) a (m := n - 1) (by simp)]
      by_cases hn : 0 < n
      · rw [if_pos hn, if_neg (not_not_intro hn), if_pos hn, add_zero]
      · rw [if_neg hn, if_pos hn, if_neg hn, zero_add]
    refine Ideal.mem_span_singleton'.mpr ⟨y, ?_⟩
    refine (equivFinsupp B f).symm.injective ?_
    ext n
    rw [← coeff_apply, ← coeff_apply, coord_zero_mul_coord_one, mul_comm,
      ← Algebra.smul_def, map_smul, smul_eq_mul, hcoeff]
    by_cases hn : 0 < n
    · rw [if_pos hn, ← hb, coeff_coord_one_mul, if_neg (by omega : ¬ n < (0 : ℤ))]
    · rw [if_neg hn, ← ha, coeff_coord_zero_mul, if_neg hn]
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact ⟨Ideal.mem_span_singleton'.mpr ⟨coord B f 1, by ring⟩,
      Ideal.mem_span_singleton'.mpr ⟨coord B f 0, by ring⟩⟩

/-- **The intersection of the two coordinate ideals of the local model is the ideal generated by
`f`**, the equation of the locus over which the affine bundle degenerates. -/
theorem span_coord_zero_inf_span_coord_one_eq_span_f :
    (Ideal.span {coord B f 0} ⊓ Ideal.span {coord B f 1} : Ideal (LocalModel B f))
      = Ideal.span {algebraMap B (LocalModel B f) f} := by
  rw [span_coord_zero_inf_span_coord_one, coord_zero_mul_coord_one]

end Stacks.AffineBundle

end
