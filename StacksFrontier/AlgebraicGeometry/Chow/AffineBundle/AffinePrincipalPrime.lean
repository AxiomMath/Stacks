module

public import StacksFrontier.AlgebraicGeometry.Chow.GysinConstruction.IntegralComponent
public import StacksFrontier.AlgebraicGeometry.Chow.RationalEquivalence.FlatPullbackPrincipalDivisor

/-!
# A point of an affine scheme whose prime ideal is principal

Let `X` be an affine scheme, let `x : X` and let `t ∈ Γ(X, ⊤)` be a global section generating the
prime ideal of `x` in the ring of global sections, that is
`(isAffineOpen_top X).primeIdealOf ⟨x, trivial⟩ = Ideal.span {t}`. This file records the two
germ-level consequences of that algebraic hypothesis which the order-of-vanishing machinery of
chapter 42 consumes when it reads off the coefficient of a principal divisor at `x`:

* the germ of `t` at `x` generates the maximal ideal of the local ring `𝒪_{X,x}`, so `t` is a
  local equation at `x` for the reduced induced structure on the closure of `x`;
* at any point `z` where the germ of `t` is *not* a unit, `z` lies in the closure of `x`, so the
  vanishing locus of `t` is no bigger than that single integral component.

Both are proved by reading the hypothesis through the ideal sheaf `integralComponentAt x`, the
reduced induced structure on `closure {x}`, whose ideal on an affine open is exactly the prime of
the point (`Stacks.Chow.ideal_integralComponentAt`): the first statement is then the computation
of its stalk (`Stacks.Chow.idealSheafStalk_integralComponentAt_self`) and the second is the
description of its support (`Stacks.Chow.coe_support_integralComponentAt`). No localization is
formed by hand; the affine hypothesis enters only through `AlgebraicGeometry.isAffineOpen_top`.

## Main results

* `Stacks.Chow.span_germ_eq_maximalIdeal_of_primeIdealOf_eq_span`: a generator of the prime ideal
  of `x` in `Γ(X, ⊤)` has a germ at `x` generating the maximal ideal of `𝒪_{X,x}`.
* `Stacks.Chow.mem_closure_of_not_isUnit_germ_of_primeIdealOf_eq_span`: a point at which the germ
  of such a generator is not a unit lies in the closure of `x`.

## References

* [Stacks, Tag 01HR](https://stacks.math.columbia.edu/tag/01HR): affine schemes, their global
  sections and the stalks of their structure sheaves.
* [Stacks, Tag 01J1](https://stacks.math.columbia.edu/tag/01J1): the basic opens of a section and
  the points at which its germ is a unit.
* [Stacks, Tag 02QU](https://stacks.math.columbia.edu/tag/02QU): cycles, the integral closed
  subschemes they are supported on, and the orders of vanishing that give their coefficients.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.Chow

/-- If the prime ideal of a point `x` of an affine scheme `X` in the ring of global sections is
generated by a single section `t`, then the germ of `t` at `x` generates the maximal ideal of the
local ring at `x`.

Both sides are the stalk at `x` of the ideal sheaf `Stacks.Chow.integralComponentAt x`: the right
side by `Stacks.Chow.idealSheafStalk_integralComponentAt_self`, and the left side because on the
affine open `⊤` that ideal sheaf is cut out by the prime of `x`, which the hypothesis identifies
with the span of `t`. -/
theorem span_germ_eq_maximalIdeal_of_primeIdealOf_eq_span {X : Scheme.{u}} [IsAffine X] (x : X)
    (t : Γ(X, ⊤))
    (h : ((isAffineOpen_top X).primeIdealOf ⟨x, trivial⟩).asIdeal = Ideal.span {t}) :
    Ideal.span {(X.presheaf.germ ⊤ x trivial).hom t} =
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
  rw [← idealSheafStalk_integralComponentAt_self x,
    AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ _ x ⟨⊤, isAffineOpen_top X⟩ trivial,
    ideal_integralComponentAt x ⟨⊤, isAffineOpen_top X⟩ trivial, h, Ideal.map_span,
    Set.image_singleton]

/-- If the prime ideal of a point `x` of an affine scheme `X` in the ring of global sections is
generated by a single section `t`, then `t` becomes a unit in the local ring at every point
outside the closure of `x`.

Stated contrapositively: a point `z` whose germ of `t` is not a unit lies in `closure {x}`. Not
being a unit means `z` lies in the vanishing locus of `t`, which by the hypothesis is the support
of the ideal sheaf `Stacks.Chow.integralComponentAt x`, and that support is `closure {x}` by
`Stacks.Chow.coe_support_integralComponentAt`. -/
theorem mem_closure_of_not_isUnit_germ_of_primeIdealOf_eq_span {X : Scheme.{u}} [IsAffine X]
    (x : X) (t : Γ(X, ⊤))
    (h : ((isAffineOpen_top X).primeIdealOf ⟨x, trivial⟩).asIdeal = Ideal.span {t}) (z : X)
    (hz : ¬ IsUnit ((X.presheaf.germ ⊤ z trivial).hom t)) :
    z ∈ closure ({x} : Set X) := by
  have hsupp : z ∈ (integralComponentAt x).support := by
    rw [Scheme.IdealSheafData.mem_support_iff_of_mem (I := integralComponentAt x)
        (U := ⟨⊤, isAffineOpen_top X⟩) trivial,
      ideal_integralComponentAt x ⟨⊤, isAffineOpen_top X⟩ trivial, h, Scheme.zeroLocus_span,
      Scheme.mem_zeroLocus_iff]
    rintro f rfl
    rw [Scheme.mem_basicOpen_top]
    exact hz
  rw [← coe_support_integralComponentAt x]
  exact hsupp

end Stacks.Chow

end
