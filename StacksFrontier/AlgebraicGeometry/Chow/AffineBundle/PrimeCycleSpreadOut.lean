module

public import StacksFrontier.AlgebraicGeometry.Chow.AffineBundle.MonicSpreadOutPrime
public import StacksFrontier.AlgebraicGeometry.Chow.AffineBundle.PrimeCycleGenericFibre

/-!
# A prime cycle on the affine line is cut out by a monic polynomial over an affine open

Let `Y` be an integral scheme and let `W ⊆ 𝔸¹_Y` be an integral closed subscheme which dominates
`Y` and is not the whole of `𝔸¹_Y`, that is, whose generic point `w` lies over the generic point
of `Y` and is not the generic point of `𝔸¹_Y`. The fourth step of the proof of Stacks 02TT
produces from this datum a *polynomial equation for `W` over a nonempty open of the base*: an
nonempty affine open `V ⊆ Y` and a monic `Q(T) ∈ Γ(V, 𝒪_Y)[T]` of positive degree which
generates a prime ideal and which cuts out `W` on the generic fibre.

This file assembles that datum out of the three pieces that produce it:

* `Stacks.Chow.exists_monic_irreducible_genericFibre` — the generic fibre of `W` is cut out by a
  monic irreducible `P(T) ∈ R(Y)[T]`;
* `Stacks.Chow.exists_opens_monic_polynomial_map_eq` — `P` is the image of a monic `Q(T)` of the
  same degree with coefficients in the sections over a nonempty open of `Y`, which is refined
  here to a nonempty *affine* open `V`, the form the identification `𝔸¹_{Spec A} = Spec A[T]`
  needs;
* `Stacks.Chow.isPrime_span_singleton_of_irreducible_map` — `(Q)` is then prime, because the
  germ map `Γ(V, 𝒪_Y) → R(Y)` of an integral scheme is injective and `Q` is monic.

The positivity of the degree of `Q` is the statement that `W` is a proper closed subscheme: a
monic polynomial of degree zero is `1`, which is not irreducible.

## Main results

* `Stacks.Chow.exists_isAffineOpen_monic_polynomial_map_eq` — spreading a monic polynomial over
  the function field out to an affine open.
* `Stacks.Chow.exists_opens_monic_isPrime_genericFibre` — the polynomial equation for `W` over a
  nonempty affine open of `Y`.

## References

* [Stacks Project, Tag 02TT](https://stacks.math.columbia.edu/tag/02TT)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.Chow

/-- **Spreading out a monic polynomial over the function field to an affine open.** This is
`Stacks.Chow.exists_opens_monic_polynomial_map_eq` with the open taken affine, which is what the
identification `𝔸¹_{Spec A} = Spec A[T]` of `Stacks.Chow.affineLineSpecIsoSpecPolynomial` asks
for. The affine opens form a basis of the topology, so the open produced there contains an affine
one which still contains the generic point; restricting the coefficients to it changes neither
monicity nor the degree, because the germ map at the generic point of an integral scheme is
injective. -/
theorem exists_isAffineOpen_monic_polynomial_map_eq (Y : Scheme.{u}) [IsIntegral Y]
    {p : Polynomial ↑Y.functionField} (hp : p.Monic) :
    ∃ (U : Y.Opens) (_ : IsAffineOpen U) (hU : genericPoint ↥Y ∈ U) (q : Polynomial ↑Γ(Y, U)),
      q.Monic ∧ q.natDegree = p.natDegree ∧ q.map (germFunctionField Y hU).hom = p := by
  obtain ⟨U, hU, q, -, -, hqmap⟩ := exists_opens_monic_polynomial_map_eq Y hp
  obtain ⟨-, ⟨V, hVaff, rfl⟩, hgV, hVU⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open hU U.2
  have hle : V ≤ U := hVU
  set q' : Polynomial ↑Γ(Y, V) := q.map (Y.presheaf.map (homOfLE hle).op).hom with hq'
  have hmap : q'.map (germFunctionField Y hgV).hom = p := by
    rw [hq', Polynomial.map_map,
      show (germFunctionField Y hgV).hom.comp (Y.presheaf.map (homOfLE hle).op).hom =
          (germFunctionField Y hU).hom from
        RingHom.ext fun t => Y.presheaf.germ_res_apply (homOfLE hle) (genericPoint ↥Y) hgV t]
    exact hqmap
  have hinj := germFunctionField_injective Y hgV
  have hdeg : q'.natDegree = p.natDegree := by
    rw [← hmap, Polynomial.natDegree_map_eq_of_injective hinj]
  refine ⟨V, hVaff, hgV, q', ?_, hdeg, hmap⟩
  have h1 : (germFunctionField Y hgV).hom (q'.coeff q'.natDegree) = 1 := by
    rw [← Polynomial.coeff_map, hmap, hdeg]
    exact hp.coeff_natDegree
  exact hinj (h1.trans (map_one (germFunctionField Y hgV).hom).symm)

/-- **A prime cycle on the affine line over an integral base, dominating the base and not the
whole line, has a monic polynomial equation over a nonempty open of the base.** Let `Y` be
integral and let `w` be the generic point of an integral closed subscheme `W ⊆ 𝔸¹_Y`. If `w` lies
over the generic point of `Y` and is not the generic point of `𝔸¹_Y`, then there are a nonempty
affine open `U ⊆ Y` — nonempty, which by `Stacks.Chow.genericPoint_mem_iff_nonempty` is the
same as containing the generic point — and a monic `Q(T) ∈ Γ(U, 𝒪_Y)[T]` of positive degree such
that

* `Q` is an irreducible element of `Γ(U, 𝒪_Y)[T]` and `(Q)` is a prime ideal, and
* the prime of the point `q` of the generic fibre `𝔸¹_{R(Y)} = Spec R(Y)[T]` lying over `w` is
  generated by the image of `Q` in `R(Y)[T]`.

This is the datum the fourth step of the proof of Stacks 02TT uses to exhibit `W`, restricted to
`𝔸¹_U`, as the principal divisor of `Q`. -/
theorem exists_opens_monic_isPrime_genericFibre (Y : Scheme.{u}) [IsIntegral Y]
    (w : ↥𝔸(ULift.{u} (Fin 1); Y))
    (hdom : (𝔸(ULift.{u} (Fin 1); Y) ↘ Y) w = genericPoint ↥Y)
    (hne : w ≠ genericPoint ↥𝔸(ULift.{u} (Fin 1); Y)) :
    ∃ (U : Y.Opens) (_ : IsAffineOpen U) (hU : genericPoint ↥Y ∈ U) (Q : Polynomial ↑Γ(Y, U))
      (q : ↥(Spec (CommRingCat.of (Polynomial ↑Y.functionField)))),
      Q.Monic ∧ 0 < Q.natDegree ∧ Irreducible Q ∧
        (Ideal.span {Q} : Ideal (Polynomial ↑Γ(Y, U))).IsPrime ∧
        affineLineGenericFibreι Y q = w ∧
        q.asIdeal = Ideal.span {Q.map (germFunctionField Y hU).hom} := by
  obtain ⟨q, P, hqw, hPm, hPi, hPspan, -⟩ := exists_monic_irreducible_genericFibre Y w hdom hne
  obtain ⟨U, hUaff, hU, Q, hQm, hQdeg, hQmap⟩ :=
    exists_isAffineOpen_monic_polynomial_map_eq Y hPm
  have hinj := germFunctionField_injective Y hU
  have hirr : Irreducible (Q.map (germFunctionField Y hU).hom) := hQmap ▸ hPi
  refine ⟨U, hUaff, hU, Q, q, hQm, ?_, irreducible_of_irreducible_map _ hinj hQm hirr,
    isPrime_span_singleton_of_irreducible_map _ hinj hQm hirr, hqw, ?_⟩
  · rw [hQdeg]
    exact hPi.natDegree_pos
  · rw [hPspan, hQmap]

end Stacks.Chow

end
