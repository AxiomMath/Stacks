/-! ### The order of vanishing in a localization of a principal ideal domain -/

/-- In the localization of a principal ideal domain at the prime generated by an irreducible
element `ϖ`, the order of vanishing of `a = ϖ ^ n * b` with `b` prime to `ϖ` is `n`.

The localization is a discrete valuation ring, because a principal ideal domain is a Dedekind
domain, and the image of `ϖ` generates its maximal ideal, hence is a uniformizer; the image of
`b` is a unit because `b` lies outside the prime. -/
theorem ord_localization_eq_of_eq_pow_mul {R : Type u} [CommRing R] [IsDomain R]
    [IsPrincipalIdealRing R] (P : Ideal R) [P.IsPrime] (L : Type u) [CommRing L] [IsDomain L]
    [Algebra R L] [IsLocalization.AtPrime L P] {ϖ : R} (hϖ : Irreducible ϖ)
    (hP : P = Ideal.span {ϖ}) {a b : R} (n : ℕ) (hab : a = ϖ ^ n * b) (hb : ¬ ϖ ∣ b) :
    Ring.ord L (algebraMap R L a) = n := by
  have hPne : P ≠ ⊥ := by
    rw [hP]
    exact fun h => hϖ.ne_zero (Ideal.span_singleton_eq_bot.mp h)
  have _ : IsDiscreteValuationRing L :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain R hPne L
  have hmax : IsLocalRing.maximalIdeal L = Ideal.span {algebraMap R L ϖ} := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P L, hP, Ideal.map_span, Set.image_singleton]
  have hϖ' : Irreducible (algebraMap R L ϖ) :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr hmax
  have hbnot : b ∉ P := by
    rw [hP]
    exact fun hmem => hb (Ideal.mem_span_singleton.mp hmem)
  have hu : IsUnit (algebraMap R L b) := IsLocalization.map_units L (⟨b, hbnot⟩ : P.primeCompl)
  rw [hab, map_mul, map_pow, mul_comm, ← hu.unit_spec]
  exact ord_unit_mul_pow hϖ' hu.unit n

/-! ### The spectrum of a principal ideal domain -/

section Spec

variable (A : CommRingCat.{u}) [IsDomain ↑A]

/-- The spectrum of a nontrivial ring has a point, namely the zero ideal of a domain. -/
instance nonemptyTopSpec : Nonempty ((⊤ : (Spec A).Opens) : Type u) :=
  ⟨⟨(⊥ : PrimeSpectrum ↑A), trivial⟩⟩

/-- The canonical map from a domain to the function field of its spectrum, as a bundled ring
homomorphism. Its type mentions no `Algebra` instance, which is what makes it usable at a
concrete `CommRingCat.of`; see the implementation notes. -/
def specAlgebraMap : ↑A →+* (Spec A).functionField :=
  algebraMap ↑A (Spec A).functionField

/-- `Stacks.Chow.specAlgebraMap` is the germ at the generic point of a global section. -/
theorem germToFunctionField_eq_specAlgebraMap (a : ↑A) :
    (Spec A).germToFunctionField ⊤ ((Scheme.ΓSpecIso A).inv a) = specAlgebraMap A a := rfl

/-- A domain embeds in the function field of its spectrum. -/
theorem specAlgebraMap_injective : Function.Injective (specAlgebraMap A) :=
  IsFractionRing.injective ↑A (Spec A).functionField

/-- The order of vanishing of the constant `1` is zero. -/
theorem ord_one_functionField {X : Scheme.{u}} [AlgebraicGeometry.IsIntegral X]
    [IsLocallyNoetherian X] (x : X) : X.ord (1 : X.functionField) x = 0 := by
  have h := Scheme.ord_mul (X := X) (x := x) (f := 1) (g := 1) one_ne_zero one_ne_zero
  rw [one_mul] at h
  omega

/-- The order of vanishing of an inverse is the negative of the order of vanishing. -/
theorem ord_inv_functionField {X : Scheme.{u}} [AlgebraicGeometry.IsIntegral X]
    [IsLocallyNoetherian X] {f : X.functionField} (hf : f ≠ 0) (x : X) :
    X.ord f⁻¹ x = -X.ord f x := by
  have h := Scheme.ord_mul (X := X) (x := x) (f := f) (g := f⁻¹) hf (inv_ne_zero hf)
  rw [mul_inv_cancel₀ hf, ord_one_functionField] at h
  omega

/-- The function field of `Spec A` is a fraction field of `A`, so it is canonically isomorphic to
any other one; `Stacks.Chow.specFunctionFieldEquiv_specAlgebraMap` records that the isomorphism
is one of `A`-algebras. -/
def specFunctionFieldEquiv (K : Type u) [Field K] [Algebra ↑A K] [IsFractionRing ↑A K] :
    (Spec A).functionField ≃+* K :=
  (IsLocalization.algEquiv (nonZeroDivisors ↑A) (Spec A).functionField K).toRingEquiv

/-- `Stacks.Chow.specFunctionFieldEquiv` is a map of `A`-algebras. -/
theorem specFunctionFieldEquiv_specAlgebraMap (K : Type u) [Field K] [Algebra ↑A K]
    [IsFractionRing ↑A K] (a : ↑A) :
    specFunctionFieldEquiv A K (specAlgebraMap A a) = algebraMap ↑A K a :=
  (IsLocalization.algEquiv (nonZeroDivisors ↑A) (Spec A).functionField K).commutes a

variable [IsPrincipalIdealRing ↑A]

/-- The point of `Spec A` cut out by an irreducible element of `A`. -/
def irreduciblePoint {ϖ : ↑A} (hϖ : Irreducible ϖ) : Spec A :=
  ⟨Ideal.span {ϖ}, (Ideal.span_singleton_prime hϖ.ne_zero).2
    (UniqueFactorizationMonoid.irreducible_iff_prime.1 hϖ)⟩

/-- The prime ideal of `Stacks.Chow.irreduciblePoint A hϖ` is the principal ideal `(ϖ)`. -/
@[simp]
theorem irreduciblePoint_asIdeal {ϖ : ↑A} (hϖ : Irreducible ϖ) :
    (irreduciblePoint A hϖ).asIdeal = Ideal.span {ϖ} := rfl

/-- The prime generated by an irreducible element of a principal ideal domain is maximal. -/
instance isMaximal_irreduciblePoint {ϖ : ↑A} (hϖ : Irreducible ϖ) :
    (irreduciblePoint A hϖ).asIdeal.IsMaximal :=
  PrincipalIdealRing.isMaximal_of_irreducible hϖ

/-- The point of an irreducible element has codimension one: a maximal ideal of a principal
ideal domain which is not a field has height one. -/
theorem coheight_irreduciblePoint (hA : ¬ IsField ↑A) {ϖ : ↑A} (hϖ : Irreducible ϖ) :
    coheight (irreduciblePoint A hϖ) = 1 := by
  rw [← AlgebraicGeometry.idealHeight_eq_coheight]
  exact IsPrincipalIdealRing.height_eq_one_of_isMaximal _ hA

/-- Conversely, every point of `Spec A` of codimension one is cut out by an irreducible element:
its prime is nonzero, hence generated by a nonzero nonunit, which is prime and therefore
irreducible. -/
theorem exists_irreducible_eq_irreduciblePoint (y : Spec A) (hy : coheight y = 1) :
    ∃ (ϖ : ↑A) (hϖ : Irreducible ϖ), y = irreduciblePoint A hϖ := by
  have hne : y.asIdeal ≠ ⊥ := by
    intro h
    rw [← AlgebraicGeometry.idealHeight_eq_coheight, h,
      (Ideal.height_eq_zero_iff_eq_bot (I := (⊥ : Ideal ↑A))).2 rfl] at hy
    exact absurd hy (by decide)
  obtain ⟨q, hq⟩ := Submodule.IsPrincipal.principal y.asIdeal
  have hq0 : q ≠ 0 := by
    rintro rfl
    exact hne (by simpa using hq)
  have hspan : y.asIdeal = Ideal.span {q} := hq
  have hprime : Prime q := (Ideal.span_singleton_prime hq0).1 (hspan ▸ y.isPrime)
  exact ⟨q, UniqueFactorizationMonoid.irreducible_iff_prime.2 hprime, PrimeSpectrum.ext hspan⟩

/-- **The order of vanishing at the point of an irreducible element.** If `a = ϖ ^ n * b` with
`b` prime to `ϖ`, then the order of vanishing of `a` at the point cut out by `ϖ` is `n`. -/
theorem ord_irreduciblePoint_eq_of_eq_pow_mul (hA : ¬ IsField ↑A) {ϖ : ↑A}
    (hϖ : Irreducible ϖ) {a b : ↑A} (n : ℕ) (hab : a = ϖ ^ n * b) (hb : ¬ ϖ ∣ b) :
    (Spec A).ord (specAlgebraMap A a) (irreduciblePoint A hϖ) = n := by
  have hbne : b ≠ 0 := fun h => hb (h ▸ dvd_zero ϖ)
  have hane : a ≠ 0 := hab ▸ mul_ne_zero (pow_ne_zero _ hϖ.ne_zero) hbne
  have hinj : Function.Injective (Scheme.ΓSpecIso A).inv.hom :=
    (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso A).inv).1
  have ht : (Scheme.ΓSpecIso A).inv a ≠ 0 := fun h => hane (hinj (by simpa using h))
  have hgerm : ((Spec A).presheaf.germ ⊤ (irreduciblePoint A hϖ) trivial).hom
        ((Scheme.ΓSpecIso A).inv a)
      = (Spec.stalkIso A (irreduciblePoint A hϖ)).commRingCatIsoToRingEquiv.symm
          (algebraMap ↑A (Localization.AtPrime (irreduciblePoint A hϖ).asIdeal) a) :=
    (congrArg (fun f : CommRingCat.of ↑A ⟶ (Spec A).presheaf.stalk _ => f.hom a)
      (Spec.algebraMap_stalkIso_inv (R := A) (irreduciblePoint A hϖ))).symm
  have hring : Ring.ord ((Spec A).presheaf.stalk (irreduciblePoint A hϖ))
      (((Spec A).presheaf.germ ⊤ (irreduciblePoint A hϖ) trivial).hom
        ((Scheme.ΓSpecIso A).inv a)) = n := by
    rw [hgerm, ord_congr (Spec.stalkIso A (irreduciblePoint A hϖ)).commRingCatIsoToRingEquiv.symm
      (algebraMap ↑A (Localization.AtPrime (irreduciblePoint A hϖ).asIdeal) a)]
    exact ord_localization_eq_of_eq_pow_mul (irreduciblePoint A hϖ).asIdeal _ hϖ
      (irreduciblePoint_asIdeal A hϖ) n hab hb
  exact ord_eq_ringOrd_germ (coheight_irreduciblePoint A hA hϖ) (V := ⊤) trivial
    ((Scheme.ΓSpecIso A).inv a) ht hring

end Spec

/-! ### The dictionary for the affine line over a field -/

section PolynomialRing

variable (k : Type u) [Field k] [DecidableEq k]

/-- The spectrum of the polynomial ring in one variable over a field, as the affine line. -/
abbrev specPolynomial : Scheme.{u} := Spec (CommRingCat.of (Polynomial k))

/-- The function field of `Spec k[T]` is the field of rational functions. -/
abbrev ratFuncEquivFunctionField : (specPolynomial k).functionField ≃+* RatFunc k :=
  specFunctionFieldEquiv (CommRingCat.of (Polynomial k)) (RatFunc k)

/-- **The order of vanishing of a polynomial at the point of a monic irreducible.** It is the
multiplicity of that irreducible in the normalized factorization. -/
theorem ord_irreduciblePoint_eq_count {p : Polynomial k} (hp : Irreducible p) (hpm : p.Monic)
    (a : Polynomial k) (ha : a ≠ 0) :
    (specPolynomial k).ord
        (specAlgebraMap (CommRingCat.of (Polynomial k)) a) (irreduciblePoint _ hp)
      = ((normalizedFactors a).count p : ℤ) := by
  have hfin : FiniteMultiplicity p a := FiniteMultiplicity.of_not_isUnit hp.not_isUnit ha
  obtain ⟨b, hab, hb⟩ := hfin.exists_eq_pow_mul_and_not_dvd
  have hcount : multiplicity p a = (normalizedFactors a).count p := by
    rw [multiplicity_eq_count_normalizedFactors hp ha, hpm.normalize_eq_self]
  rw [← hcount]
  exact_mod_cast ord_irreduciblePoint_eq_of_eq_pow_mul (CommRingCat.of (Polynomial k))
    (Polynomial.not_isField k) hp (multiplicity p a) hab hb

/-- **The dictionary between the order of vanishing on the affine line and `Stacks.Chow.ordAt`.**
For a monic irreducible `p` the order of vanishing at the point of `Spec k[T]` cut out by `p` of
a nonzero rational function is `Stacks.Chow.ordAt p` of it. -/
theorem ord_irreduciblePoint_eq_ordAt {p : Polynomial k} (hp : Irreducible p) (hpm : p.Monic)
    (g : (specPolynomial k).functionField) (hg : g ≠ 0) :
    (specPolynomial k).ord g (irreduciblePoint _ hp)
      = ordAt p (ratFuncEquivFunctionField k g) := by
  set G : RatFunc k := ratFuncEquivFunctionField k g with hG
  have hGne : G ≠ 0 := fun h => hg ((ratFuncEquivFunctionField k).map_eq_zero_iff.1 h)
  have hnum : G.num ≠ 0 := RatFunc.num_ne_zero hGne
  have hden : G.denom ≠ 0 := RatFunc.denom_ne_zero G
  have hsplit : g = specAlgebraMap (CommRingCat.of (Polynomial k)) G.num /
      specAlgebraMap (CommRingCat.of (Polynomial k)) G.denom := by
    apply (ratFuncEquivFunctionField k).injective
    rw [map_div₀, specFunctionFieldEquiv_specAlgebraMap, specFunctionFieldEquiv_specAlgebraMap,
      ← hG]
    exact (RatFunc.num_div_denom G).symm
  have hne : ∀ x : Polynomial k, x ≠ 0 → specAlgebraMap (CommRingCat.of (Polynomial k)) x ≠ 0 :=
    fun x hx => (map_ne_zero_iff _ (specAlgebraMap_injective _)).2 hx
  have hnum' := hne _ hnum
  have hden' := hne _ hden
  rw [hsplit, div_eq_mul_inv, Scheme.ord_mul hnum' (inv_ne_zero hden'),
    ord_inv_functionField hden',
    ord_irreduciblePoint_eq_count k hp hpm G.num hnum,
    ord_irreduciblePoint_eq_count k hp hpm G.denom hden, ordAt]
  ring

end PolynomialRing

end Stacks.Chow

