variable {X : Scheme.{u}} (F : X.Modules) [F.IsQuasicoherent] {V : X.Opens}
  (hV : IsAffineOpen V)

/-- **The identification `Sym_{Γ(X, V)}(Γ(ℱ, V)) ≅ Γ(V, Sym ℱ)` carries `ι t` to the degree-one
section of `t`.** -/
theorem symSectionsRingEquiv_ι (t : Γ(F, V)) :
    Stacks.SymAlgSections.symSectionsRingEquiv F hV (SymmetricAlgebra.ι _ _ t) =
      Scheme.Modules.Hom.app (symGen F) V t := by
  have hmem : SymmetricAlgebra.ι Γ(X, V) Γ(F, V) t ∈ SymPow.symmetricPower 1 Γ(X, V) Γ(F, V) :=
    SymPow.ι_mem_symmetricPowerInt_one _ _ t
  have hdec := DirectSum.decompose_of_mem
    (fun n : ℕ => SymPow.symmetricPower n Γ(X, V) Γ(F, V)) hmem
  simp only [Stacks.SymAlgSections.symSectionsRingEquiv, RingEquiv.trans_apply]
  have h1 : (DirectSum.decomposeRingEquiv fun n ↦ SymPow.symmetricPower n Γ(X, V) Γ(F, V))
      (SymmetricAlgebra.ι Γ(X, V) Γ(F, V) t) = DirectSum.of _ 1 ⟨_, hmem⟩ := hdec
  rw [h1]
  have h2 : ((Stacks.SymAlgSections.symPowersRingEquiv F hV).trans
      (Stacks.RelativeSpec.totalSectionsRingEquiv X _
        (Scheme.Modules.symmetricAlgebra_mul_comm X F) hV)) (DirectSum.of _ 1 ⟨_, hmem⟩) =
      Stacks.RelativeSpec.totalSectionsRingEquiv X _
        (Scheme.Modules.symmetricAlgebra_mul_comm X F) hV
        (Stacks.SymAlgSections.symPowerIncl F hV 1 ⟨_, hmem⟩) :=
    congrArg (Stacks.RelativeSpec.totalSectionsRingEquiv X _
      (Scheme.Modules.symmetricAlgebra_mul_comm X F) hV)
      (Stacks.SymAlgSections.ofSymPowers_of F hV 1 _)
  refine h2.trans ?_
  have hg := Stacks.SymGraded.AffinePieces.symmetricAlgebraGen_app_eq F V t
  have h3 : Scheme.Modules.Hom.app (symGen F) V t =
      Stacks.RelativeSpec.totalSectionsRingEquiv X _
        (Scheme.Modules.symmetricAlgebra_mul_comm X F) hV
        (DirectSum.of (fun m : ℤ => (((Scheme.Modules.symmetricAlgebra X F).piece m).val.obj
          (op V) : Type u)) (1 : ℤ)
          ((Scheme.Modules.symmetricAlgebraGen X F).val.app (op V) t)) := rfl
  refine Eq.trans ?_ h3.symm
  refine congrArg (Stacks.RelativeSpec.totalSectionsRingEquiv X _
    (Scheme.Modules.symmetricAlgebra_mul_comm X F) hV) ?_
  refine (Stacks.SymAlgSections.symPowerIncl_apply F hV 1 _).trans ?_
  exact congrArg (DirectSum.of (fun m : ℤ =>
    (((Scheme.Modules.symmetricAlgebra X F).piece m).val.obj (op V) : Type u)) (1 : ℤ)) hg.symm


omit [F.IsQuasicoherent] in
/-- The degree-one section of `t`, under `Sym(f)`. -/
theorem symmetricAlgebraSheafMap_symGen {G : X.Modules} (f : F ⟶ G) (W : X.Opens)
    (t : Γ(F, W)) :
    ((Scheme.Modules.symmetricAlgebraSheafMap X f).right.hom.app (op W)).hom
        (Scheme.Modules.Hom.app (symGen F) W t) =
      Scheme.Modules.Hom.app (symGen G) W (Scheme.Modules.Hom.app f W t) := by
  have h := symGen_comp_symmetricAlgebraSheafMap f
  have h2 := congrArg (fun φ : F ⟶ Stacks.RelativeSpec.AlgebraSheaf.underlyingModule
    (Scheme.Modules.symmetricAlgebraSheaf X G) => Scheme.Modules.Hom.app φ W t) h
  simp only [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply] at h2
  exact h2

/-- **`Sym_{Γ(X, V)}(Γ(ℱ, V)) ≅ Γ(V, Sym ℱ)` is natural in `ℱ`.** -/
theorem symmetricAlgebraSheafMap_symSectionsRingEquiv {G : X.Modules} [G.IsQuasicoherent]
    (f : F ⟶ G) (x : SymmetricAlgebra Γ(X, V) Γ(F, V)) :
    ((Scheme.Modules.symmetricAlgebraSheafMap X f).right.hom.app (op V)).hom
        (Stacks.SymAlgSections.symSectionsRingEquiv F hV x) =
      Stacks.SymAlgSections.symSectionsRingEquiv G hV
        (SymmetricAlgebra.lift (SymmetricAlgebra.ι Γ(X, V) Γ(G, V) ∘ₗ
          Scheme.Modules.sectionsLinearMap f V) x) := by
  induction x using SymmetricAlgebra.induction with
  | algebraMap r =>
    rw [AlgHom.commutes, Stacks.SymAlgSections.symSectionsRingEquiv_algebraMap,
      Stacks.SymAlgSections.symSectionsRingEquiv_algebraMap]
    exact congrArg (fun φ => (φ.hom.app (op V)).hom r)
      (Under.w (Scheme.Modules.symmetricAlgebraSheafMap X f))
  | ι t =>
    rw [symSectionsRingEquiv_ι, SymmetricAlgebra.lift_ι_apply, LinearMap.comp_apply,
      symSectionsRingEquiv_ι]
    exact symmetricAlgebraSheafMap_symGen F f V t
  | mul a b ha hb => rw [map_mul, map_mul, ha, hb, map_mul, map_mul]
  | add a b ha hb => rw [map_add, map_add, ha, hb, map_add, map_add]

omit [F.IsQuasicoherent] in
/-- The ring isomorphism on sections over `W` given by an isomorphism of algebra sheaves. -/
def algebraSheafIsoRingEquiv {A B : Stacks.RelativeSpec.AlgebraSheaf X} (e : A ≅ B)
    (W : X.Opens) : A.right.obj.obj (op W) ≃+* B.right.obj.obj (op W) where
  toFun y := (e.hom.right.hom.app (op W)).hom y
  invFun y := (e.inv.right.hom.app (op W)).hom y
  left_inv y := congrArg (fun φ : A ⟶ A => (φ.right.hom.app (op W)).hom y) e.hom_inv_id
  right_inv y := congrArg (fun φ : B ⟶ B => (φ.right.hom.app (op W)).hom y) e.inv_hom_id
  map_mul' a b := map_mul (e.hom.right.hom.app (op W)).hom a b
  map_add' a b := map_add (e.hom.right.hom.app (op W)).hom a b

omit [F.IsQuasicoherent] in
/-- The inverse of `algebraSheafIsoRingEquiv e W` is given by the sections of `e.inv` over `W`. -/
theorem algebraSheafIsoRingEquiv_symm_apply {A B : Stacks.RelativeSpec.AlgebraSheaf X}
    (e : A ≅ B) (W : X.Opens) (y : B.right.obj.obj (op W)) :
    (algebraSheafIsoRingEquiv e W).symm y = (e.inv.right.hom.app (op W)).hom y := rfl

omit [F.IsQuasicoherent] in
/-- Sections of a composite of morphisms of algebra sheaves. -/
theorem algebraSheaf_comp_app_apply {A B D : Stacks.RelativeSpec.AlgebraSheaf X} (f : A ⟶ B)
    (g : B ⟶ D) (W : X.Opens) (y : A.right.obj.obj (op W)) :
    ((f ≫ g).right.hom.app (op W)).hom y =
      (g.right.hom.app (op W)).hom ((f.right.hom.app (op W)).hom y) := rfl

/-- **The ring of sections of `𝐕(ℱ)` over the preimage of an affine open `V`** is
`Sym_{Γ(X, V)}(Γ(ℱ, V))`: [Stacks, Tag 01LX] (3) followed by the sections of `Sym(ℱ)`. -/
def bundleChartEquiv : (bundleAlgebra F).right.obj.obj (op V) ≃+*
    SymmetricAlgebra Γ(X, V) Γ(F, V) :=
  (algebraSheafIsoRingEquiv (bundleAlgebraIso F) V).trans
    (Stacks.SymAlgSections.symSectionsRingEquiv F hV).symm

/-- The inverse of `bundleChartEquiv` sends the degree-one element `ι t` of
`Sym_{Γ(X, V)}(Γ(ℱ, V))` to the section of `𝐕(ℱ)` defined by `t`. -/
theorem bundleChartEquiv_symm_ι (t : Γ(F, V)) :
    (bundleChartEquiv F hV).symm (SymmetricAlgebra.ι _ _ t) =
      ((bundleAlgebraIso F).inv.right.hom.app (op V)).hom
        (Scheme.Modules.Hom.app (symGen F) V t) := by
  show (algebraSheafIsoRingEquiv (bundleAlgebraIso F) V).symm
    (Stacks.SymAlgSections.symSectionsRingEquiv F hV (SymmetricAlgebra.ι _ _ t)) = _
  rw [symSectionsRingEquiv_ι]
  rfl

/-- The chart of the vector bundle `N = 𝐕(𝒩^∨)` over an affine open `V`:
`Γ(N, p⁻¹ V) ≅ Sym_{Γ(X, V)}(Γ(𝒩^∨, V))`. -/
def dualBundleChartEquiv (N : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} N] :
    Γ(dualVectorBundle N, dualVectorBundleToBase N ⁻¹ᵁ V) ≃+*
      SymmetricAlgebra Γ(X, V) Γ(dualSheaf N, V) :=
  bundleChartEquiv (dualSheaf N) hV

section Kernel

variable (N' N : X.Modules) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} N']
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} N]

/-- The preimage of `V` in the vector bundle `N`, an affine open. -/
def bundlePreimage : (dualVectorBundle N).affineOpens :=
  ⟨dualVectorBundleToBase N ⁻¹ᵁ V,
    Scheme.Modules.isAffineOpen_preimage_vectorBundleToBase X (dualSheaf N) ⟨V, hV⟩⟩

omit [F.IsQuasicoherent] in
/-- **The ideal of `N'` in `N` over an affine open `V`** is generated, in the chart
`Sym_{Γ(X, V)}(Γ(𝒩^∨, V))`, by the image in degree one of the kernel of `Γ(𝒩^∨, V) ⟶
Γ((𝒩')^∨, V)`. -/
theorem mem_ker_subbundleEmbedding_iff (inc : N' ⟶ N) [Epi (dualMap inc)]
    [IsClosedImmersion (subbundleEmbedding N' N inc)]
    (y : Γ(dualVectorBundle N, (bundlePreimage hV N : (dualVectorBundle N).Opens))) :
    y ∈ (subbundleEmbedding N' N inc).ker.ideal (bundlePreimage hV N) ↔
      dualBundleChartEquiv hV N y ∈ Ideal.span (SymmetricAlgebra.ι Γ(X, V) Γ(dualSheaf N, V) ''
        (LinearMap.ker (Scheme.Modules.sectionsLinearMap (dualMap inc) V) : Set _)) := by
  rw [Scheme.Hom.ker_apply, RingHom.mem_ker,
    ← Stacks.Chow.GenuineChern.ker_symAlgMap_eq_span
      (Scheme.Modules.sectionsLinearMap (dualMap inc) V)
      (surjective_app_of_epi_of_isAffineOpen (dualMap inc) hV), RingHom.mem_ker]
  have h1 : ((pushforwardAlgebraMap (bundleMapOver (dualMap inc))).right.hom.app (op V)).hom y =
      ((bundleAlgebraIso (dualSheaf N')).inv.right.hom.app (op V)).hom
        (((Scheme.Modules.symmetricAlgebraSheafMap X (dualMap inc)).right.hom.app (op V)).hom
          (((bundleAlgebraIso (dualSheaf N)).hom.right.hom.app (op V)).hom y)) := by
    rw [pushforwardAlgebraMap_bundleMapOver]
    rfl
  rw [pushforwardAlgebraMap_app _ V (preimage_le_preimage_preimage _ V)] at h1
  have hW : (bundleMapOver (dualMap inc)).left ⁻¹ᵁ
      ((Scheme.Modules.vectorBundleOver X (F := dualSheaf N)).hom ⁻¹ᵁ V) =
      (Scheme.Modules.vectorBundleOver X (F := dualSheaf N')).hom ⁻¹ᵁ V :=
    congrArg (fun q => q ⁻¹ᵁ V) (Over.w (bundleMapOver (dualMap inc)))
  have hsec : (bundleAlgebraIso (dualSheaf N)).hom.right.hom.app (op V) y =
      Stacks.SymAlgSections.symSectionsRingEquiv (dualSheaf N) hV
        (bundleChartEquiv (dualSheaf N) hV y) :=
    ((Stacks.SymAlgSections.symSectionsRingEquiv (dualSheaf N) hV).apply_symm_apply _).symm
  rw [hsec, symmetricAlgebraSheafMap_symSectionsRingEquiv] at h1
  constructor
  · intro h0
    have h2 := appLE_apply_eq_zero_of_app (bundleMapOver (dualMap inc)).left hW y
      ((bundleMapOver_left N' N inc).symm ▸ h0)
    replace h2 := h1.symm.trans h2
    have h3 := (map_eq_zero_iff _ (algebraSheafIsoRingEquiv (bundleAlgebraIso (dualSheaf N'))
      V).symm.injective).mp h2
    exact (map_eq_zero_iff _ (Stacks.SymAlgSections.symSectionsRingEquiv (dualSheaf N')
      hV).injective).mp h3
  · intro h0
    rw [← bundleMapOver_left N' N inc]
    refine app_apply_eq_zero_of_appLE _ hW y (h1.trans ?_)
    show (algebraSheafIsoRingEquiv (bundleAlgebraIso (dualSheaf N')) V).symm
      (Stacks.SymAlgSections.symSectionsRingEquiv (dualSheaf N') hV _) = 0
    have h0' : (SymmetricAlgebra.lift (SymmetricAlgebra.ι Γ(X, V) Γ(dualSheaf N', V) ∘ₗ
        Scheme.Modules.sectionsLinearMap (dualMap inc) V)) (bundleChartEquiv (dualSheaf N) hV y)
        = 0 := h0
    rw [h0', map_zero, map_zero]

end Kernel

/-- A basis of the middle term of a short exact sequence of free modules, extending the image of
a basis of the kernel. -/
noncomputable def basisOfExact {A K M P : Type*} [CommRing A] [AddCommGroup K] [Module A K]
    [AddCommGroup M] [Module A M] [AddCommGroup P] [Module A P] {κ τ : Type*}
    (f : K →ₗ[A] M) (g : M →ₗ[A] P) (hf : Function.Injective f) (hg : Function.Surjective g)
    (hfg : Function.Exact f g) (bK : Module.Basis κ A K) (bP : Module.Basis τ A P) :
    Module.Basis (κ ⊕ τ) A M :=
  haveI : Module.Projective A P := Module.Projective.of_basis bP
  let l := (Module.projective_lifting_property g LinearMap.id hg).choose
  have hl : g ∘ₗ l = LinearMap.id :=
    (Module.projective_lifting_property g LinearMap.id hg).choose_spec
  (bK.prod bP).map (hfg.splitSurjectiveEquiv hf ⟨l, hl⟩).1.symm

/-- The basis `basisOfExact` sends `Sum.inl j` to the image `f (bK j)` of the `j`-th basis
vector of the kernel. -/
theorem basisOfExact_inl {A K M P : Type*} [CommRing A] [AddCommGroup K] [Module A K]
    [AddCommGroup M] [Module A M] [AddCommGroup P] [Module A P] {κ τ : Type*}
    (f : K →ₗ[A] M) (g : M →ₗ[A] P) (hf : Function.Injective f) (hg : Function.Surjective g)
    (hfg : Function.Exact f g) (bK : Module.Basis κ A K) (bP : Module.Basis τ A P) (j : κ) :
    basisOfExact f g hf hg hfg bK bP (Sum.inl j) = f (bK j) := by
  have : Module.Projective A P := Module.Projective.of_basis bP
  let l := (Module.projective_lifting_property g LinearMap.id hg).choose
  have hl : g ∘ₗ l = LinearMap.id :=
    (Module.projective_lifting_property g LinearMap.id hg).choose_spec
  have h := ((hfg.splitSurjectiveEquiv hf ⟨l, hl⟩).2).1
  have h2 := LinearMap.congr_fun h (bK j)
  simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply,
    LinearMap.inl_apply] at h2
  rw [h2]
  simp [basisOfExact, Module.Basis.prod_apply, l]

