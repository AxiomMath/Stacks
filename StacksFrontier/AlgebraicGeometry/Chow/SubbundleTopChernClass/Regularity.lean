/-- The dual sequence is short exact on the sections over an affine open. -/
theorem exact_sections_dual :
    Function.Exact (Scheme.Modules.sectionsLinearMap (dualMap pr) V)
      (Scheme.Modules.sectionsLinearMap (dualMap inc) V) := by
  intro y
  constructor
  · exact SheafOfModules.exists_of_shortExact_sections hS (op V) y
  · rintro ⟨x, rfl⟩
    have h := congrArg (fun φ : dualSheaf E ⟶ dualSheaf N' => Scheme.Modules.Hom.app φ V x) w
    simp only [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply,
      Scheme.Modules.Hom.zero_app] at h
    exact h

omit [F.IsQuasicoherent] [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] in
/-- The canonical cosection on a section over `V`. -/
theorem subbundleCosectionAdj_app (m : Γ(dualSheaf E, V)) :
    Scheme.Modules.Hom.app (subbundleCosectionAdj N E pr) V m =
      ((bundleAlgebraIso (dualSheaf N)).inv.right.hom.app (op V)).hom
        (Scheme.Modules.Hom.app (symGen (dualSheaf N)) V
          (Scheme.Modules.Hom.app (dualMap pr) V m)) := rfl

/-- The ideal generated by the image of a submodule under a linear map into an algebra is
generated by the images of any spanning family. -/
theorem span_image_range_eq_span_range_basis {A M T : Type*} [CommRing A] [AddCommGroup M]
    [Module A M] [CommRing T] [Algebra A T] {K : Type*} [AddCommGroup K] [Module A K] {κ : Type*}
    (ι : M →ₗ[A] T) (f : K →ₗ[A] M) (bK : Module.Basis κ A K) :
    Ideal.span (ι '' (LinearMap.range f : Set M)) =
      Ideal.span (Set.range fun j => ι (f (bK j))) := by
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_mono ?_)
  · rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
    show ι (f x) ∈ Ideal.span _
    have hx : x ∈ Submodule.span A (Set.range bK) := bK.mem_span x
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨j, rfl⟩ := hy
      exact Ideal.subset_span ⟨j, rfl⟩
    | zero => simp
    | add y z _ _ hy hz =>
      rw [map_add, map_add]
      exact Ideal.add_mem _ hy hz
    | smul a y _ hy =>
      rw [map_smul, map_smul, Algebra.smul_def]
      exact Ideal.mul_mem_left _ _ hy
  · rintro _ ⟨j, rfl⟩
    exact ⟨f (bK j), ⟨bK j, rfl⟩, rfl⟩

omit [F.IsQuasicoherent] in
/-- The function on `p⁻¹ V` attached by the canonical cosection to a section of `ℰ^∨` over `V`. -/
abbrev subbundleCosectionFn (m : Γ(dualSheaf E, V)) :
    Γ(dualVectorBundle N, dualVectorBundleToBase N ⁻¹ᵁ V) :=
  Scheme.Modules.Hom.app (subbundleCosectionAdj N E pr) V m

/-- On the chart over `V`, the function attached to `m` is the degree-one element `ι` of the image
of `m` under `dualMap pr`. -/
private theorem dualBundleChartEquiv_cosectionFn {N E : X.Modules}
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} N] (pr : N ⟶ E)
    (m : Γ(dualSheaf E, V)) :
    dualBundleChartEquiv hV N (subbundleCosectionFn N E pr m) =
      SymmetricAlgebra.ι _ _ (Scheme.Modules.sectionsLinearMap (dualMap pr) V m) :=
  ((dualBundleChartEquiv hV N).eq_symm_apply).mp
    (bundleChartEquiv_symm_ι (dualSheaf N) hV _).symm

omit [F.IsQuasicoherent] [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] in
include w hS in
/-- Over `p⁻¹ V`, the ideal of the closed immersion `subbundleEmbedding N' N inc` is generated
by the functions `subbundleCosectionFn` attached to a basis of `Γ(ℰ^∨, V)`. -/
theorem ker_subbundleEmbedding_ideal_eq_span [Epi (dualMap inc)]
    [IsClosedImmersion (subbundleEmbedding N' N inc)] {e : ℕ}
    (bK : Module.Basis (Fin e) Γ(X, V) Γ(dualSheaf E, V)) :
    (subbundleEmbedding N' N inc).ker.ideal (bundlePreimage hV N) =
      Ideal.span (Set.range fun j => subbundleCosectionFn N E pr (V := V) (bK j)) := by
  ext y
  rw [mem_ker_subbundleEmbedding_iff hV N' N inc y,
    (exact_sections_dual N' N E inc pr w hS).linearMap_ker_eq,
    span_image_range_eq_span_range_basis _ _ bK]
  have hspan : Ideal.span (Set.range fun j => SymmetricAlgebra.ι Γ(X, V) Γ(dualSheaf N, V)
      (Scheme.Modules.sectionsLinearMap (dualMap pr) V (bK j))) =
      (Ideal.span (Set.range fun j => subbundleCosectionFn N E pr (bK j))).map
        ((dualBundleChartEquiv hV N) : _ →+* _) := by
    rw [Ideal.map_span, ← Set.range_comp]
    congr 1
    ext z
    simp only [Set.mem_range, Function.comp_apply, RingEquiv.coe_toRingHom,
      dualBundleChartEquiv_cosectionFn hV pr]
  rw [hspan, Ideal.map_comap_of_equiv, Ideal.mem_comap]
  exact iff_of_eq (congrArg (· ∈ Ideal.span (Set.range fun j => subbundleCosectionFn N E pr (bK j)))
    ((dualBundleChartEquiv hV N).symm_apply_apply y))

omit [F.IsQuasicoherent] in
/-- On the chart over `V`, the projection `p : N ⟶ X` is the inclusion of constants. -/
theorem dualBundleChartEquiv_app (a : Γ(X, V)) :
    dualBundleChartEquiv hV N ((dualVectorBundleToBase N).app V a) =
      algebraMap Γ(X, V) (SymmetricAlgebra Γ(X, V) Γ(dualSheaf N, V)) a := by
  rw [← RingEquiv.eq_symm_apply]
  show _ = ((bundleAlgebraIso (dualSheaf N)).inv.right.hom.app (op V)).hom
    (Stacks.SymAlgSections.symSectionsRingEquiv (dualSheaf N) hV _)
  rw [Stacks.SymAlgSections.symSectionsRingEquiv_algebraMap]
  have h := congrArg (fun φ => (φ.hom.app (op V)).hom a)
    (Under.w (bundleAlgebraIso (dualSheaf N)).inv)
  exact h.symm

end Chart

section Regularity

variable (N' N E : X.Modules) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} N']
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} N]
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]
  (inc : N' ⟶ N) (pr : N ⟶ E) (w : dualMap pr ≫ dualMap inc = 0)
  (hS : (ShortComplex.mk (dualMap pr) (dualMap inc) w).ShortExact)

omit [F.IsQuasicoherent] [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] in
/-- On the chart over `V`, the function `subbundleCosectionFn` attached to `m` is the degree-one
element `ι` of the image of `m` under `dualMap pr`. -/
theorem dualBundleChartEquiv_subbundleCosectionFn (m : Γ(dualSheaf E, V)) :
    dualBundleChartEquiv hV N (subbundleCosectionFn N E pr m) =
      SymmetricAlgebra.ι _ _ (Scheme.Modules.sectionsLinearMap (dualMap pr) V m) :=
  dualBundleChartEquiv_cosectionFn hV pr m

omit [F.IsQuasicoherent] [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] in
include hV hS in
/-- **The polynomial chart of `N` adapted to `N'`.** Over an affine open `V` on which `ℰ^∨` and
`(𝒩')^∨` are free, `Γ(N, p⁻¹ V)` is a polynomial ring over `Γ(X, V)` in which the functions
`φ(ε_j)` attached to a basis `ε` of `Γ(ℰ^∨, V)` are among the variables. -/
theorem exists_polyEquiv {e r' : ℕ} (bK : Module.Basis (Fin e) Γ(X, V) Γ(dualSheaf E, V))
    (bP : Module.Basis (Fin r') Γ(X, V) Γ(dualSheaf N', V)) :
    ∃ χ : Γ(dualVectorBundle N, dualVectorBundleToBase N ⁻¹ᵁ V) ≃+*
        MvPolynomial (Fin e ⊕ Fin r') Γ(X, V),
      (∀ j, χ (subbundleCosectionFn N E pr (bK j)) = MvPolynomial.X (Sum.inl j)) ∧
      ∀ a, χ ((dualVectorBundleToBase N).app V a) = MvPolynomial.C a := by
  have := hS.epi_g
  have := hS.mono_f
  have hf : Function.Injective (Scheme.Modules.sectionsLinearMap (dualMap pr) V) :=
    SheafOfModules.injective_of_mono_sections (dualMap pr) hS.mono_f (op V)
  have hg : Function.Surjective (Scheme.Modules.sectionsLinearMap (dualMap inc) V) :=
    surjective_app_of_epi_of_isAffineOpen (dualMap inc) hV
  let b := basisOfExact _ _ hf hg (exact_sections_dual N' N E inc pr w hS) bK bP
  refine ⟨(dualBundleChartEquiv hV N).trans (SymmetricAlgebra.equivMvPolynomial b).toRingEquiv,
    fun j => ?_, fun a => ?_⟩
  · rw [RingEquiv.trans_apply, dualBundleChartEquiv_subbundleCosectionFn,
      ← basisOfExact_inl _ _ hf hg (exact_sections_dual N' N E inc pr w hS) bK bP j]
    exact SymmetricAlgebra.equivMvPolynomial_ι_apply b _
  · rw [RingEquiv.trans_apply, dualBundleChartEquiv_app]
    show (SymmetricAlgebra.equivMvPolynomial b) (algebraMap _ _ a) = _
    rw [AlgEquiv.commutes, MvPolynomial.algebraMap_eq]

omit [F.IsQuasicoherent] in
include hS in
/-- Let `Y ⊆ X` be a closed subscheme and `p⁻¹ Y ⊆ N` its inverse image. At every point of
`p⁻¹ Y` lying on `N'`, the ideal of `N'` generates, in the local ring of `p⁻¹ Y`, an ideal
generated by a regular sequence of length `rank ℰ`. -/
theorem exists_isRegular_stalk_comap_subbundle (e r' : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E e]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} N' r']
    [IsClosedImmersion (subbundleEmbedding N' N inc)] (I : X.IdealSheafData)
    (t : (I.comap (dualVectorBundleToBase N)).subscheme)
    (ht : (I.comap (dualVectorBundleToBase N)).subschemeι t ∈
      (subbundleEmbedding N' N inc).ker.support) :
    ∃ rs : List ((I.comap (dualVectorBundleToBase N)).subscheme.presheaf.stalk t),
      rs.length = e ∧
      RingTheory.Sequence.IsRegular
        ((I.comap (dualVectorBundleToBase N)).subscheme.presheaf.stalk t) rs ∧
      Ideal.ofList rs = (IdealSheafData.stalk (subbundleEmbedding N' N inc).ker
        ((I.comap (dualVectorBundleToBase N)).subschemeι t)).map
          ((I.comap (dualVectorBundleToBase N)).subschemeι.stalkMap t).hom := by
  have := hS.epi_g
  let p := dualVectorBundleToBase N
  let T := I.comap p
  let x := T.subschemeι t
  obtain ⟨U₁, hU₁, hb₁⟩ := exists_forall_isAffineOpen_basis_sections (dualSheaf E) e (p x)
  obtain ⟨U₂, hU₂, hb₂⟩ := exists_forall_isAffineOpen_basis_sections (dualSheaf N') r' (p x)
  obtain ⟨V, hV, hxV, hVU⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (show p x ∈ U₁ ⊓ U₂ from ⟨hU₁, hU₂⟩)
  obtain ⟨bK⟩ := hb₁ V hV fun y hy => (hVU hy).1
  obtain ⟨bP⟩ := hb₂ V hV fun y hy => (hVU hy).2
  obtain ⟨χ, hχX, hχC⟩ := exists_polyEquiv hV N' N E inc pr w hS bK bP
  have hxV' : x ∈ p ⁻¹ᵁ V := hxV
  have hVaff : IsAffineOpen (p ⁻¹ᵁ V) := (bundlePreimage hV N).2
  let : Algebra Γ(dualVectorBundle N, p ⁻¹ᵁ V) ((dualVectorBundle N).presheaf.stalk x) :=
    ((dualVectorBundle N).presheaf.germ (p ⁻¹ᵁ V) x hxV').hom.toAlgebra
  have hloc := hVaff.isLocalization_stalk ⟨x, hxV'⟩
  have : Module.Flat Γ(dualVectorBundle N, p ⁻¹ᵁ V) ((dualVectorBundle N).presheaf.stalk x) :=
    IsLocalization.flat _ (hVaff.primeIdealOf ⟨x, hxV'⟩).asIdeal.primeCompl
  have hreg0 := MvPolynomial.isWeaklyRegular_quotient_ofFn_X_inl
    (S := (dualVectorBundle N).presheaf.stalk x) χ (p.app V).hom hχC (I.ideal ⟨V, hV⟩)
  have hK : ((I.ideal ⟨V, hV⟩).map (p.app V).hom).map
      (algebraMap Γ(dualVectorBundle N, p ⁻¹ᵁ V) ((dualVectorBundle N).presheaf.stalk x)) =
      RingHom.ker (T.subschemeι.stalkMap t).hom := by
    rw [ker_stalkMap_subschemeι_eq_stalk, AlgebraicGeometry.stalk_comap,
      IdealSheafData.stalk_eq_map_germ I (p x) ⟨V, hV⟩ hxV, Ideal.map_map, Ideal.map_map]
    congr 1
    exact (congrArg CommRingCat.Hom.hom (Scheme.Hom.germ_stalkMap p V x hxV)).symm
  let e1 := (Ideal.quotEquivOfEq hK).trans
    (RingHom.quotientKerEquivOfSurjective (T.subschemeι.stalkMap_surjective t))
  have hχX' : ∀ j, χ.symm (MvPolynomial.X (Sum.inl j)) = subbundleCosectionFn N E pr (bK j) :=
    fun j => (χ.symm_apply_eq).mpr (hχX j).symm
  have hweak := (Koszul.isWeaklyRegular_ringEquiv e1 _).mp hreg0
  rw [List.map_ofFn] at hweak
  simp only [Function.comp_def, hχX'] at hweak
  set gs : Fin e → T.subscheme.presheaf.stalk t := fun j => (T.subschemeι.stalkMap t).hom
    ((dualVectorBundle N).presheaf.germ (p ⁻¹ᵁ V) x hxV' (subbundleCosectionFn N E pr (bK j)))
    with hgs
  have hstalk : IdealSheafData.stalk (subbundleEmbedding N' N inc).ker x =
      Ideal.span (Set.range fun j => (dualVectorBundle N).presheaf.germ (p ⁻¹ᵁ V) x hxV'
        (subbundleCosectionFn N E pr (bK j))) := by
    rw [IdealSheafData.stalk_eq_map_germ _ x (bundlePreimage hV N) hxV',
      ker_subbundleEmbedding_ideal_eq_span hV N' N E inc pr w hS bK]
    exact (Ideal.map_span _ _).trans (congrArg Ideal.span (Set.range_comp _ _).symm)
  have hofList : Ideal.ofList (List.ofFn gs) =
      (IdealSheafData.stalk (subbundleEmbedding N' N inc).ker x).map
        (T.subschemeι.stalkMap t).hom := by
    rw [hstalk, Ideal.map_span, ← Set.range_comp]
    show Ideal.span {r | r ∈ List.ofFn gs} = _
    congr 1
    ext r
    simp [List.mem_ofFn, hgs]
  refine ⟨List.ofFn gs, by simp, ?_, hofList⟩
  have hgs' : List.ofFn gs = List.ofFn fun j => e1 ((Ideal.Quotient.mk _)
      ((algebraMap Γ(dualVectorBundle N, dualVectorBundleToBase N ⁻¹ᵁ V)
        ((dualVectorBundle N).presheaf.stalk x)) (subbundleCosectionFn N E pr (bK j)))) := by
    rfl
  rw [hgs']
  refine RingTheory.Sequence.IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal _ ?_ hweak
  intro r hr
  rw [← hgs'] at hr
  have hr' : r ∈ Ideal.ofList (List.ofFn gs) := Ideal.subset_span hr
  rw [hofList] at hr'
  have hne : IdealSheafData.stalk (subbundleEmbedding N' N inc).ker x ≠ ⊤ :=
    fun h => ((IdealSheafData.stalk_eq_top_iff_not_mem_support _ x).mp h) ht
  refine (Ideal.map_le_of_le_comap ?_) hr'
  refine (IsLocalRing.le_maximalIdeal hne).trans ?_
  intro z hz
  exact map_nonunit (T.subschemeι.stalkMap t).hom z hz

end Regularity

end Stacks.Chow
