# The Koszul resolution of the zero section of the projective completion

Let `ℰ` be a finite locally free module of rank `r` on a scheme `X`, `π : P = 𝐏(ℰ ⊕ 𝒪_X) ⟶ X`
its projective completion and `i : X = 𝐏(𝒪_X) ⟶ P` the zero section. The map
`τ : π^*ℰ ⟶ π^*(ℰ ⊕ 𝒪_X) ⟶ 𝒪_P(1)` vanishes exactly along `i(X)`, so the Koszul complex of
the cosection

  `φ : π^*ℰ ⊗ 𝒪_P(-1) ⟶ 𝒪_P`,  `m ⊗ λ ↦ λ(τ m)`,

is a resolution of `i_*𝒪_X` ([Stacks, Tag 0FEF]). This file proves it, through the stalkwise
criterion `Stacks.Chow.ExteriorPowerResolution.ofClosedImmersion`. At a point `x` of the image
of the standard open `D₊(s)` of the chart of an affine open `U` on which `ℰ` is free on
`c_1, …, c_r`, the germs of `π^*c_j ⊗ λ`, for `λ` dual to the generator `τ(π^*s)` of `𝒪_P(1)`,
are a basis of the stalk of `π^*ℰ ⊗ 𝒪_P(-1)` on which `ψ_x` takes the values `c_j / s`. Hence:

* on `D₊(c_k)`, `ψ_x` takes the value `1`;
* on `D₊(T) = Spec Γ(X, U)[c_1/T, …, c_r/T]` the values form the localization at `x` of the
  sequence of coordinate functions of affine space, which is Koszul-regular;
* everywhere, the image of `ψ_x` is generated by the germs of the `c_j / s`, which generate the
  ideal of the zero section on `D₊(s)`.

## Main definitions

* `Stacks.ProjectiveCompletion.koszulTautological`: the map `τ : π^*ℰ ⟶ 𝒪_P(1)`.
* `Stacks.ProjectiveCompletion.koszulCosection`: the cosection `φ`.
* `Stacks.ProjectiveCompletion.koszulResolutionZeroSection`: the Koszul resolution of
  `i_*𝒪_X` by the exterior powers of `π^*ℰ ⊗ 𝒪_P(-1)`.
* `Stacks.Chow.ExteriorPowerResolution.ofLocalGenerators`: the resolution of
  `Stacks.Chow.ExteriorPowerResolution.ofClosedImmersion` from local generators of the ideal.

## Main results

* `Stacks.ProjectiveCompletion.germ_unitToPushforwardUnit_eq_zero_iff`: the stalk of the ideal
  of a quasi-compact morphism, from its sections over an affine open.
* `Stacks.ProjectiveCompletion.exists_basis_koszulStalkDual`: the stalk computation above.
* `Stacks.ProjectiveCompletion.koszulStalkDual_exact_condition` and
  `Stacks.ProjectiveCompletion.exists_ker_app_zeroSection_eq_span`: the two stalkwise conditions.
* `Stacks.ProjectiveCompletion.hasDefinedChernClasses_pushforward_zeroSection`: the Chern classes
  of `i_*𝒪_X` are defined.

## References

* [Stacks Project, Tag 0FEF](https://stacks.math.columbia.edu/tag/0FEF)
* [Stacks Project, Tag 062F](https://stacks.math.columbia.edu/tag/062F)
* [Stacks Project, Tag 01CP](https://stacks.math.columbia.edu/tag/01CP)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace Stacks.ProjectiveCompletion

/-- The range of a linear functional on a module with a basis is the ideal generated by its
values on the basis. -/
theorem _root_.LinearMap.range_eq_span_range_basis {R M : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] {ι : Type*} (b : Module.Basis ι R M) (ψ : M →ₗ[R] R) :
    LinearMap.range ψ = Ideal.span (Set.range fun j => ψ (b j)) := by
  rw [LinearMap.range_eq_map, ← b.span_eq, Submodule.map_span, ← Set.range_comp]
  rfl

section KernelGerm

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose

variable {Y Z : Scheme.{u}} (i : Z ⟶ Y)

/-- `i^♯` commutes with restriction, on elements. -/
theorem app_map_homOfLE_apply {U U' : Y.Opens} (h : U' ≤ U) (a : Γ(Y, U)) :
    i.app U' (Y.presheaf.map (homOfLE h).op a) =
      Z.presheaf.map (homOfLE (i.preimage_mono h)).op (i.app U a) := by
  rw [← ConcreteCategory.comp_apply, Scheme.Hom.naturality, ConcreteCategory.comp_apply]
  rfl

/-- Two restrictions of a function compose to one. -/
theorem presheaf_map_homOfLE_map_homOfLE_apply {U V W : Y.Opens} (h₁ : W ≤ V) (h₂ : V ≤ U)
    (a : Γ(Y, U)) :
    Y.presheaf.map (homOfLE h₁).op (Y.presheaf.map (homOfLE h₂).op a) =
      Y.presheaf.map (homOfLE (h₁.trans h₂)).op a := by
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

variable [QuasiCompact i]

/-- **The germ of `i^♯ a` in `i_*𝒪_Z` vanishes exactly when the germ of `a` lies in the kernel
ideal of `i^♯` on an affine open, extended to the local ring.** For a quasi-compact morphism
`i : Z ⟶ Y`, an affine open `W` of `Y` and a point `x ∈ W`, the germ at `x` of the image of a
function `a` in `i_*𝒪_Z` is zero if and only if the germ of `a` lies in the ideal of `𝒪_{Y,x}`
generated by the kernel of `Γ(Y, W) ⟶ Γ(Z, i⁻¹W)`. -/
theorem germ_unitToPushforwardUnit_eq_zero_iff {W : Y.Opens} (hW : IsAffineOpen W) {x : Y}
    (hxW : x ∈ W) (U : Y.Opens) (hx : x ∈ U) (a : Γ(Y, U)) :
    TopCat.Presheaf.germ ((Scheme.Modules.pushforward i).obj
        (SheafOfModules.unit Z.ringCatSheaf)).val.presheaf U x hx
        ((ClosedImmersionCoherentImage.unitToPushforwardUnit i).val.app (op U) a) = 0 ↔
      Y.presheaf.germ U x hx a ∈
        Ideal.map (Y.presheaf.germ W x hxW).hom (RingHom.ker (i.app W).hom) := by
  set M := (Scheme.Modules.pushforward i).obj (SheafOfModules.unit Z.ringCatSheaf)
  have hmap : ∀ {V : Y.Opens} (h : V ≤ U),
      M.val.presheaf.map (homOfLE h).op
          ((ClosedImmersionCoherentImage.unitToPushforwardUnit i).val.app (op U) a) =
        i.app V (Y.presheaf.map (homOfLE h).op a) :=
    fun h => (app_map_homOfLE_apply i h a).symm
  refine ⟨fun h0 => ?_, fun hmem => ?_⟩
  · obtain ⟨V, hxV, iU, iV, hV⟩ := TopCat.Presheaf.germ_eq M.val.presheaf x hx hx _ 0
      (h0.trans (map_zero _).symm)
    have hV0 : i.app V (Y.presheaf.map (homOfLE iU.le).op a) = 0 := by
      rw [← hmap]
      exact hV.trans (map_zero _)
    obtain ⟨g, hgV, hxg⟩ := hW.exists_basicOpen_le ⟨x, hxV⟩ hxW
    have hgU : Y.basicOpen g ≤ U := hgV.trans iU.le
    have hres : i.app (Y.basicOpen g) (Y.presheaf.map (homOfLE hgU).op a) = 0 := by
      rw [← presheaf_map_homOfLE_map_homOfLE_apply hgV iU.le, app_map_homOfLE_apply, hV0,
        map_zero]
    have hmem : Y.presheaf.map (homOfLE hgU).op a ∈
        (i.ker).ideal (Y.affineBasicOpen (U := ⟨W, hW⟩) g) := by
      rwa [Scheme.Hom.ker_apply]
    rw [← (i.ker).map_ideal_basicOpen ⟨W, hW⟩ g, Scheme.Hom.ker_apply] at hmem
    rw [← Y.presheaf.germ_res_apply (homOfLE hgU) x hxg a]
    have := Ideal.mem_map_of_mem (Y.presheaf.germ (Y.basicOpen g) x hxg).hom hmem
    rwa [Ideal.map_map, ← CommRingCat.hom_comp, Y.presheaf.germ_res] at this
  · -- the germs of functions killed by `i^♯` near `x` form an ideal
    let P : Ideal (Y.presheaf.stalk x) :=
      { carrier := {s | ∃ (V : Y.Opens) (hxV : x ∈ V) (b : Γ(Y, V)),
            Y.presheaf.germ V x hxV b = s ∧ i.app V b = 0}
        add_mem' := by
          rintro _ _ ⟨V, hxV, b, rfl, hb⟩ ⟨V', hxV', b', rfl, hb'⟩
          refine ⟨V ⊓ V', ⟨hxV, hxV'⟩, Y.presheaf.map (homOfLE inf_le_left).op b +
            Y.presheaf.map (homOfLE inf_le_right).op b', ?_, ?_⟩
          · rw [map_add]
            exact congrArg₂ (· + ·) (Y.presheaf.germ_res_apply _ x _ b)
              (Y.presheaf.germ_res_apply _ x _ b')
          · rw [map_add, app_map_homOfLE_apply, app_map_homOfLE_apply, hb, hb',
              map_zero, map_zero, add_zero]
        zero_mem' := ⟨⊤, trivial, 0, map_zero _, map_zero _⟩
        smul_mem' := by
          rintro c _ ⟨V, hxV, b, rfl, hb⟩
          obtain ⟨V', hxV', c', rfl⟩ := Y.presheaf.exists_germ_eq c
          refine ⟨V ⊓ V', ⟨hxV, hxV'⟩, Y.presheaf.map (homOfLE inf_le_right).op c' *
            Y.presheaf.map (homOfLE inf_le_left).op b, ?_, ?_⟩
          · rw [map_mul]
            exact congrArg₂ (· * ·) (Y.presheaf.germ_res_apply _ x _ c')
              (Y.presheaf.germ_res_apply _ x _ b)
          · rw [map_mul, app_map_homOfLE_apply i _ b, hb, map_zero, mul_zero] }
    have hle : Ideal.map (Y.presheaf.germ W x hxW).hom (RingHom.ker (i.app W).hom) ≤ P :=
      Ideal.map_le_iff_le_comap.2 fun k hk => ⟨W, hxW, k, rfl, hk⟩
    obtain ⟨V, hxV, b, hb, hb0⟩ := hle hmem
    obtain ⟨V', hxV', iU, iV, hV'⟩ := TopCat.Presheaf.germ_eq Y.presheaf x hx hxV a b hb.symm
    rw [show iU = homOfLE iU.le from rfl, show iV = homOfLE iV.le from rfl] at hV'
    have h1 : i.app V' (Y.presheaf.map (homOfLE iU.le).op a) = 0 := by
      rw [hV', app_map_homOfLE_apply, hb0, map_zero]
    have h2 : M.val.presheaf.map (homOfLE iU.le).op
        ((ClosedImmersionCoherentImage.unitToPushforwardUnit i).val.app (op U) a) = 0 := by
      exact (hmap iU.le).trans h1
    exact (TopCat.Presheaf.germ_res_apply M.val.presheaf (homOfLE iU.le) x hxV' _).symm.trans
      ((congrArg _ h2).trans (map_zero _))

/-- **The degree-zero condition of `Stacks.Chow.ExteriorPowerResolution.ofClosedImmersion`
from local generators.** Suppose that around every point `x` there are an affine open `W`,
functions `f_j` on `W` generating the kernel of `i^♯` over `W`, and a basis of `ℰ_x` on which
`ψ_x` takes the values the germs of the `f_j`. Then the image of `ψ_x` is the stalk of the ideal
of `i`. -/
theorem germ_unitToPushforwardUnit_eq_zero_iff_mem_range [IsClosedImmersion i] {ℰ : Y.Modules}
    (φ : ℰ ⟶ SheafOfModules.unit Y.ringCatSheaf) {r : ℕ}
    (h : ∀ x : Y, ∃ (W : Y.Opens) (_ : IsAffineOpen W) (hxW : x ∈ W) (f : Fin r → Γ(Y, W))
      (b : Module.Basis (Fin r) ↑(TopCat.Presheaf.stalk Y.sheaf.obj x)
        ↑(TopCat.Presheaf.stalk ℰ.val.presheaf x)),
      RingHom.ker (i.app W).hom = Ideal.span (Set.range f) ∧
        ∀ j, Scheme.Modules.koszulStalkDual φ x (b j) = Y.presheaf.germ W x hxW (f j))
    (x : Y) (U : Y.Opens) (hx : x ∈ U) (a : Γ(Y, U)) :
    TopCat.Presheaf.germ ((Scheme.Modules.pushforward i).obj
        (SheafOfModules.unit Z.ringCatSheaf)).val.presheaf U x hx
        ((ClosedImmersionCoherentImage.unitToPushforwardUnit i).val.app (Opposite.op U) a) = 0 ↔
      TopCat.Presheaf.germ Y.sheaf.obj U x hx a ∈
        LinearMap.range (Scheme.Modules.koszulStalkDual φ x) := by
  obtain ⟨W, hW, hxW, f, b, hker, hb⟩ := h x
  rw [germ_unitToPushforwardUnit_eq_zero_iff i hW hxW U hx a, hker, Ideal.map_span,
    ← Set.range_comp, LinearMap.range_eq_span_range_basis b]
  have hfun : (fun j => Scheme.Modules.koszulStalkDual φ x (b j)) =
      (Y.presheaf.germ W x hxW).hom ∘ f := funext hb
  rw [hfun]
  rfl

section

attribute [local instance 10000] HasDerivedCategory.standard

/-- **The Koszul resolution of a closed subscheme from local generators.** The resolution of
`Stacks.Chow.ExteriorPowerResolution.ofClosedImmersion`, with its degree-zero condition supplied
by local generators of the ideal of `i` on which `ψ_x` takes the values of a basis of `ℰ_x`
(`Stacks.ProjectiveCompletion.germ_unitToPushforwardUnit_eq_zero_iff_mem_range`). -/
def _root_.Stacks.Chow.ExteriorPowerResolution.ofLocalGenerators [IsClosedImmersion i]
    {ℰ : Y.Modules} (φ : ℰ ⟶ SheafOfModules.unit Y.ringCatSheaf) (r : ℕ)
    (hA : ∀ x : Y, (∃ e, Scheme.Modules.koszulStalkDual φ x e = 1) ∨
      ∃ b : Module.Basis (Fin r) ↑(TopCat.Presheaf.stalk Y.sheaf.obj x)
          ↑(TopCat.Presheaf.stalk ℰ.val.presheaf x),
        Koszul.IsKoszulRegular fun j => Scheme.Modules.koszulStalkDual φ x (b j))
    (h : ∀ x : Y, ∃ (W : Y.Opens) (_ : IsAffineOpen W) (hxW : x ∈ W) (f : Fin r → Γ(Y, W))
      (b : Module.Basis (Fin r) ↑(TopCat.Presheaf.stalk Y.sheaf.obj x)
        ↑(TopCat.Presheaf.stalk ℰ.val.presheaf x)),
      RingHom.ker (i.app W).hom = Ideal.span (Set.range f) ∧
        ∀ j, Scheme.Modules.koszulStalkDual φ x (b j) = Y.presheaf.germ W x hxW (f j)) :
    Stacks.Chow.ExteriorPowerResolution ((DerivedCategory.singleFunctor Y.Modules 0).obj
      ((Scheme.Modules.pushforward i).obj (SheafOfModules.unit Z.ringCatSheaf))) ℰ :=
  Stacks.Chow.ExteriorPowerResolution.ofClosedImmersion φ i r hA
    (germ_unitToPushforwardUnit_eq_zero_iff_mem_range i φ h)

end

end KernelGerm

section StalkBasis

variable {X Y : Scheme.{u}}

/-- **A basis of sections over an affine open gives a basis of every stalk there.** For a
quasi-coherent module `F`, the germs at a point `x` of an affine open `U` of a
`Γ(X, U)`-basis of `Γ(F, U)` form an `𝒪_{X,x}`-basis of `F_x`, the stalk being the localization
of the sections at the prime of `x`. -/
theorem exists_basis_stalk_germ (F : X.Modules) [F.IsQuasicoherent] {U : X.Opens}
    (hU : IsAffineOpen U) {x : X} (hx : x ∈ U) {ι : Type*} (b : Module.Basis ι Γ(X, U) Γ(F, U)) :
    ∃ b' : Module.Basis ι (X.presheaf.stalk x) (F.presheaf.stalk x),
      ∀ i, b' i = F.presheaf.germ U x hx (b i) := by
  let := (X.presheaf.germ U x hx).hom.toAlgebra
  let := Stacks.ModuleStalkSpecialization.sectionsStalkModule F hx
  have := Stacks.ModuleStalkSpecialization.isScalarTower_sectionsStalk F hx
  have : IsLocalization.AtPrime (X.presheaf.stalk x) (hU.primeIdealOf ⟨x, hx⟩).asIdeal :=
    hU.isLocalization_stalk ⟨x, hx⟩
  have := Stacks.ModuleStalkSpecialization.isLocalizedModule_germₗ F hU hx
  exact ⟨Module.Basis.ofIsLocalizedModule (X.presheaf.stalk x)
      (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl
      (Stacks.ModuleStalkSpecialization.germₗ F hx) b,
    fun i => Module.Basis.ofIsLocalizedModule_apply _ _ _ _ i⟩

/-- **A basis of a stalk pulls back to a basis of the stalk of the pullback.** For `p : X ⟶ Y`
and a basis of `L_{p(x)}`, the pullbacks of its members form a basis of `(p^*L)_x`, the stalk of
the pullback being the base change of `L_{p(x)}` (Stacks 0098). -/
theorem exists_basis_pullbackStalk (p : X ⟶ Y) (L : Y.Modules) (x : X) {ι : Type*}
    (b : Module.Basis ι (Y.presheaf.stalk (p.base x)) (L.presheaf.stalk (p.base x))) :
    ∃ b' : Module.Basis ι (X.presheaf.stalk x)
        (((Scheme.Modules.pullback p).obj L).presheaf.stalk x),
      ∀ i, b' i = Stacks.Divisors.pullbackStalk p L x (b i) := by
  let : Algebra (Y.presheaf.stalk (p.base x)) (X.presheaf.stalk x) :=
    (p.stalkMap x).hom.toAlgebra
  exact ⟨(b.baseChange (X.presheaf.stalk x)).map
      (Stacks.Divisors.pullbackStalkBaseChange p L x).symm,
    fun i => by
      rw [Module.Basis.map_apply, Module.Basis.baseChange_apply]
      rfl⟩

/-- **A basis times a rank-one basis is a basis of the stalk of a tensor product.** For a basis
`b` of `M_x` and a stalk basis `ℓ` of `N_x`, the products `b i ⊗ ℓ` form a basis of the stalk
of `M ⊗ N` at `x` (Stacks 01CB). -/
theorem exists_basis_tensorStalkTmul (M N : X.Modules) (x : X) {ι : Type*}
    (b : Module.Basis ι (X.presheaf.stalk x) (M.presheaf.stalk x)) {ℓ : N.presheaf.stalk x}
    (hℓ : Stacks.Divisors.IsStalkBasis N x ℓ) :
    ∃ b' : Module.Basis ι (X.presheaf.stalk x)
        ((Scheme.Modules.tensorObj M N).presheaf.stalk x),
      ∀ i, b' i = tensorStalkTmul M N x (b i) ℓ := by
  refine ⟨((b.tensorProduct hℓ.basis).reindex (Equiv.prodUnique ι (Fin 1))).map
    (tensorStalkEquiv M N x).symm, fun i => ?_⟩
  rw [Module.Basis.map_apply, Module.Basis.reindex_apply, Module.Basis.tensorProduct_apply]
  change (tensorStalkEquiv M N x).symm (b i ⊗ₜ hℓ.basis default) = _
  rw [hℓ.basis_apply]
  rfl

/-- **The functional dual to a stalk basis is a stalk basis of the dual.** For a module `L` of
finite presentation and a stalk basis `σ` of `L_x`, the element of `(L^∨)_x` corresponding,
through `(L^∨)_x = Hom(L_x, 𝒪_{X,x})` (Stacks 01CP), to the coordinate functional of `σ` is a
stalk basis of `L^∨`. -/
theorem isStalkBasis_dualStalkEquiv_symm_coord (L : X.Modules) [L.IsFinitePresentation]
    {x : X} {σ : L.presheaf.stalk x} (hσ : Stacks.Divisors.IsStalkBasis L x σ) :
    Stacks.Divisors.IsStalkBasis (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L) x
      ((Stacks.AlgebraicGeometry.ReflexiveModules.dualStalkEquiv L x).symm
        hσ.coord.toLinearMap) := by
  set e := Stacks.AlgebraicGeometry.ReflexiveModules.dualStalkEquiv L x
  have hδ : Function.Bijective fun r : X.presheaf.stalk x => r • hσ.coord.toLinearMap := by
    refine ⟨fun r r' h => ?_, fun f => ⟨f σ, ?_⟩⟩
    · have := LinearMap.congr_fun h σ
      simpa using this
    · refine LinearMap.ext fun m => ?_
      rw [LinearMap.smul_apply, LinearEquiv.coe_coe, smul_eq_mul]
      conv_rhs => rw [← hσ.smul_coord m]
      rw [map_smul, smul_eq_mul, mul_comm]
  have hfun : (fun r : X.presheaf.stalk x => r • e.symm hσ.coord.toLinearMap) =
      e.symm ∘ fun r : X.presheaf.stalk x => r • hσ.coord.toLinearMap := by
    funext r
    exact (map_smul e.symm r _).symm
  change Function.Bijective fun r : X.presheaf.stalk x => r • e.symm hσ.coord.toLinearMap
  rw [hfun]
  exact e.symm.bijective.comp hδ

end StalkBasis

section GermSpelling

variable {Y : Scheme.{u}}

/-- The germ of a function, at the two spellings `Y.sheaf.obj` and `Y.presheaf`. -/
theorem sheaf_obj_germ_eq (V : Y.Opens) (x : Y) (hx : x ∈ V) (a : Γ(Y, V)) :
    TopCat.Presheaf.germ Y.sheaf.obj V x hx a = Y.presheaf.germ V x hx a := rfl

/-- `Stacks.AlgebraicGeometry.ReflexiveModules.dualStalkEquiv_germAt` at the `presheaf.germ`
spelling of the germs. -/
theorem dualStalkEquiv_presheaf_germ (F : Y.Modules) [F.IsFinitePresentation] (x : Y)
    (V : Y.Opens) (hx : x ∈ V)
    (t : Γ(Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf F, V)) (m : Γ(F, V)) :
    Stacks.AlgebraicGeometry.ReflexiveModules.dualStalkEquiv F x
        ((Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf F).presheaf.germ V x hx t)
        (F.presheaf.germ V x hx m) =
      Y.presheaf.germ V x hx (Stacks.AlgebraicGeometry.ReflexiveModules.evalAt F t m) :=
  Stacks.AlgebraicGeometry.ReflexiveModules.dualStalkEquiv_germAt F x V hx t m

/-- `dualStalkEquiv_presheaf_germ` for a section restricted from a larger open. -/
theorem dualStalkEquiv_presheaf_germ_res (F : Y.Modules) [F.IsFinitePresentation] (x : Y)
    {V W : Y.Opens} (hVW : V ≤ W) (hx : x ∈ V)
    (t : Γ(Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf F, V)) (m : Γ(F, W)) :
    Stacks.AlgebraicGeometry.ReflexiveModules.dualStalkEquiv F x
        ((Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf F).presheaf.germ V x hx t)
        (F.presheaf.germ W x (hVW hx) m) =
      Y.presheaf.germ V x hx (Stacks.AlgebraicGeometry.ReflexiveModules.evalAt F t
        (F.presheaf.map (homOfLE hVW).op m)) := by
  rw [← dualStalkEquiv_presheaf_germ F x V hx t, F.presheaf.germ_res_apply]

/-- Koszul regularity in the local ring, at the two spellings `Y.presheaf.stalk x` and
`TopCat.Presheaf.stalk Y.sheaf.obj x` of the local ring. -/
theorem isKoszulRegular_sheaf_obj_stalk {x : Y} {r : ℕ} {f : Fin r → Y.presheaf.stalk x}
    (h : Koszul.IsKoszulRegular f) :
    Koszul.IsKoszulRegular (R := ↑(TopCat.Presheaf.stalk (C := CommRingCat) Y.sheaf.obj x)) f :=
  h

/-- The unit of the local ring, at the two spellings of the local ring. -/
theorem one_sheaf_obj_stalk (x : Y) :
    (1 : Y.presheaf.stalk x) = (1 : ↑(TopCat.Presheaf.stalk (C := CommRingCat) Y.sheaf.obj x)) :=
  rfl

end GermSpelling

section Cosection

attribute [local implicit_reducible] Stacks.Chow.bundle Stacks.SymGraded.schemeProjectiveBundle
  Stacks.Chow.bundleProj Stacks.SymGraded.schemeProjectiveBundleToBase Stacks.Chow.bundleTwist
  TopCat.Sheaf sheafCompose

variable {X : Scheme.{u}} (E : X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]

/-- **The map `π^*ℰ ⟶ 𝒪_P(1)`**: the pullback of the inclusion `ℰ ⟶ ℰ ⊕ 𝒪_X` followed by the
tautological quotient `π^*(ℰ ⊕ 𝒪_X) ⟶ 𝒪_P(1)`. It vanishes exactly along the zero section. -/
def koszulTautological :
    (Scheme.Modules.pullback (projectiveCompletionProj E)).obj E ⟶
      Stacks.Chow.bundleTwist (completionModule E) :=
  (Scheme.Modules.pullback (projectiveCompletionProj E)).map (completionInl E) ≫
    Stacks.Chow.bundleTautological (completionModule E)

/-- **The cosection `π^*ℰ ⊗ 𝒪_P(-1) ⟶ 𝒪_P`** of `Stacks.ProjectiveCompletion.koszulModule`,
`m ⊗ λ ↦ λ(τ m)` for the map `τ : π^*ℰ ⟶ 𝒪_P(1)` of
`Stacks.ProjectiveCompletion.koszulTautological`. Its Koszul complex resolves the zero section. -/
def koszulCosection :
    koszulModule E ⟶ SheafOfModules.unit (projectiveCompletion E).ringCatSheaf :=
  Stacks.AlgebraicGeometry.ReflexiveModules.pairing (koszulTautological E)

open Stacks.AlgebraicGeometry.RelativeProj in
/-- **`τ(π^*s)` generates `𝒪_P(1)` at every point of the image of `D₊(s)`**: its germ is a stalk
basis. On the affine open `chartBasicOpen hU s` the sections of `𝒪_P(1)` are free on `τ(π^*s)`,
and the stalk is a localization of the sections. -/
theorem isStalkBasis_germ_tautologicalSection {U : X.Opens} (hU : IsAffineOpen U)
    (s : Γ(completionModule E, U)) {x : projectiveCompletion E} (hx : x ∈ chartBasicOpen hU s) :
    Stacks.Divisors.IsStalkBasis (Stacks.Chow.bundleTwist (completionModule E)) x
      ((Stacks.Chow.bundleTwist (completionModule E)).presheaf.germ (chartBasicOpen hU s) x hx
        ((Stacks.Chow.bundleTwist (completionModule E)).presheaf.map
          (homOfLE (chartBasicOpen_le hU s)).op (tautologicalSection E U s))) := by
  set L := Stacks.Chow.bundleTwist (completionModule E)
  have : L.IsQuasicoherent := AlgebraicGeometry.isQuasicoherent_of_isInvertible L
  set σ : Γ(L, chartBasicOpen hU s) :=
    L.presheaf.map (homOfLE (chartBasicOpen_le hU s)).op (tautologicalSection E U s)
  let eqv : Γ(projectiveCompletion E, chartBasicOpen hU s) ≃ₗ[Γ(projectiveCompletion E,
      chartBasicOpen hU s)] Γ(L, chartBasicOpen hU s) :=
    LinearEquiv.ofBijective (LinearMap.toSpanSingleton _ _ σ)
      (bijective_smul_restrict_tautologicalSection hU s)
  obtain ⟨b', hb'⟩ := exists_basis_stalk_germ L (isAffineOpen_chartBasicOpen hU s) hx
    ((Module.Basis.singleton (Fin 1) _).map eqv)
  have h0 : b' 0 = L.presheaf.germ (chartBasicOpen hU s) x hx σ := by
    rw [hb', Module.Basis.map_apply, Module.Basis.singleton_apply]
    change L.presheaf.germ _ x hx ((1 : Γ(projectiveCompletion E, chartBasicOpen hU s)) • σ) = _
    rw [one_smul]
  rw [← h0]
  refine ⟨fun r r' h => ?_, fun m => ⟨b'.repr m 0, ?_⟩⟩
  · have := congrArg (fun y => b'.repr y 0) h
    simpa using this
  · change b'.repr m 0 • b' 0 = m
    conv_rhs => rw [← b'.sum_repr m]
    rw [Fin.sum_univ_one]

/-- `π^*φ ≫ T` on a pulled-back section. -/
theorem pullback_map_comp_app_unitSection {Y Z : Scheme.{u}} (f : Z ⟶ Y) {M N : Y.Modules}
    (φ : M ⟶ N) {L : Z.Modules} (T : (Scheme.Modules.pullback f).obj N ⟶ L) (V : Y.Opens)
    (m : Γ(M, V)) :
    ((Scheme.Modules.pullback f).map φ ≫ T).app (f ⁻¹ᵁ V)
        (Stacks.AlgebraicGeometry.RelativeProjDegreeOne.unitSection f M V m) =
      T.val.app (op (f ⁻¹ᵁ V))
        (Stacks.AlgebraicGeometry.RelativeProjDegreeOne.unitSection f N V (φ.val.app (op V) m)) :=
  congrArg (T.val.app (op (f ⁻¹ᵁ V)))
    (Stacks.Chow.GenuineChern.unitSection_pullback_map f φ V m)

/-- **`τ` on the pullback of a section of `ℰ`**: it is `τ(π^*(m, 0))`. -/
theorem koszulTautological_app_unitSection (U : X.Opens) (m : Γ(E, U)) :
    (koszulTautological E).app (projectiveCompletionProj E ⁻¹ᵁ U)
        (Stacks.AlgebraicGeometry.RelativeProjDegreeOne.unitSection (projectiveCompletionProj E)
          E U m) =
      tautologicalSection E U ((completionInl E).val.app (op U) m) :=
  (pullback_map_comp_app_unitSection (projectiveCompletionProj E) (completionInl E)
    (Stacks.Chow.bundleTautological (completionModule E)) U m).trans
    (bundleTautological_app_unitSection E U _)

/-- **The cosection on a standard chart.** Over an affine open `U` on which `ℰ` is free on `c`,
at a point `x` of the image of `D₊(s)` the stalk of `π^*ℰ ⊗ 𝒪_P(-1)` has a basis on which the
functional `ψ_x` induced by the cosection takes the values `c_j / s`. -/
theorem exists_basis_koszulStalkDual {U : X.Opens} (hU : IsAffineOpen U) {r : ℕ}
    (c : Module.Basis (Fin r) Γ(X, U) Γ(E, U)) (s : Γ(completionModule E, U))
    {x : projectiveCompletion E} (hx : x ∈ chartBasicOpen hU s) :
    ∃ b : Module.Basis (Fin r) ↑(TopCat.Presheaf.stalk (projectiveCompletion E).sheaf.obj x)
        ↑(TopCat.Presheaf.stalk (koszulModule E).val.presheaf x),
      ∀ j, Scheme.Modules.koszulStalkDual (koszulCosection E) x (b j) =
        (projectiveCompletion E).presheaf.germ (chartBasicOpen hU s) x hx
          (chartFractionOn hU s ((completionInl E).app U (c j))) := by
  set π := projectiveCompletionProj E
  set L := Stacks.Chow.bundleTwist (completionModule E)
  set M := (Scheme.Modules.pullback π).obj E
  have : L.IsFinitePresentation := Stacks.Divisors.isFinitePresentation_of_isInvertible _ L
  have hxU : x ∈ π ⁻¹ᵁ U := chartBasicOpen_le hU s hx
  obtain ⟨bC, hbC⟩ := exists_basis_stalk_germ E hU hxU c
  obtain ⟨bP, hbP⟩ := exists_basis_pullbackStalk π E x bC
  have hσ := isStalkBasis_germ_tautologicalSection E hU s hx
  set ℓ := (Stacks.AlgebraicGeometry.ReflexiveModules.dualStalkEquiv L x).symm
    hσ.coord.toLinearMap
  have hℓ := isStalkBasis_dualStalkEquiv_symm_coord L hσ
  obtain ⟨bE, hbE⟩ := exists_basis_tensorStalkTmul M
    (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L) x bP hℓ
  refine ⟨bE, fun j => ?_⟩
  set W : (projectiveCompletion E).Opens := chartBasicOpen hU s
  obtain ⟨V', hxV', lam, hlam⟩ :=
    (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L).presheaf.exists_germ_eq ℓ
  set Z := W ⊓ V'
  have hxZ : x ∈ Z := ⟨hx, hxV'⟩
  have hZW : Z ≤ W := inf_le_left
  have hZV : Z ≤ V' := inf_le_right
  have hZU : Z ≤ π ⁻¹ᵁ U := hZW.trans (chartBasicOpen_le hU s)
  set e := Stacks.AlgebraicGeometry.RelativeProjDegreeOne.unitSection π E U (c j)
  have hbj : bP j = M.presheaf.germ Z x hxZ (M.presheaf.map (homOfLE hZU).op e) :=
    (hbP j).trans ((congrArg (Stacks.Divisors.pullbackStalk π E x) (hbC j)).trans
      ((Stacks.Divisors.pullbackStalk_germ π E x U hxU (c j)).trans
        (M.presheaf.germ_res_apply (homOfLE hZU) x hxZ e).symm))
  have hℓ' : ℓ = (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L).presheaf.germ Z x hxZ
      ((Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L).presheaf.map
        (homOfLE hZV).op lam) := by
    rw [← hlam]
    exact ((Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L).presheaf.germ_res_apply
      (homOfLE inf_le_right) x hxZ lam).symm
  have key : tensorStalkTmul M (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L) x
      (bP j) ℓ = tensorStalkTmul M (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L) x
        (M.presheaf.germ Z x hxZ (M.presheaf.map (homOfLE hZU).op e))
        ((Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L).presheaf.germ Z x hxZ
          ((Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L).presheaf.map
            (homOfLE hZV).op lam)) := by
    rw [hbj, hℓ']
  refine (congrArg (Scheme.Modules.koszulStalkDual (koszulCosection E) x)
    ((hbE j).trans key)).trans ?_
  refine (Stacks.AlgebraicGeometry.ReflexiveModules.koszulStalkDual_pairing_tensorStalkTmul
    (koszulTautological E) x Z hxZ _ _).trans ?_
  set σ : Γ(L, W) := L.presheaf.map (homOfLE (chartBasicOpen_le hU s)).op
    (tautologicalSection E U s)
  set F := chartFractionOn hU s ((completionInl E).app U (c j))
  have h1 : (koszulTautological E).app Z (M.presheaf.map (homOfLE hZU).op e) =
      L.presheaf.map (homOfLE hZU).op ((koszulTautological E).app (π ⁻¹ᵁ U) e) :=
    PresheafOfModules.naturality_apply (koszulTautological E).val (homOfLE hZU).op e
  have h2 : (koszulTautological E).app (π ⁻¹ᵁ U) e =
      tautologicalSection E U ((completionInl E).val.app (op U) (c j)) :=
    koszulTautological_app_unitSection E U (c j)
  have h3 : L.presheaf.map (homOfLE hZU).op
      (tautologicalSection E U ((completionInl E).val.app (op U) (c j))) =
      L.presheaf.map (homOfLE hZW).op (F • σ) := by
    have hcc := tautologicalSection_restrict_eq_smul hU s ((completionInl E).app U (c j))
    refine (Stacks.Chow.GenuineChern.map_map_homOfLE' L hZW
      (chartBasicOpen_le hU s) _).symm.trans ?_
    exact congrArg (L.presheaf.map (homOfLE hZW).op) hcc
  have h4 := Scheme.Modules.map_smul L (homOfLE hZW) F σ
  rw [h1, h2, h3, h4, Stacks.AlgebraicGeometry.ReflexiveModules.evalAt_smul_right, smul_eq_mul]
  rw [sheaf_obj_germ_eq, map_mul]
  have hb := dualStalkEquiv_presheaf_germ_res L x hZW hxZ
    ((Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L).presheaf.map (homOfLE hZV).op lam) σ
  rw [← hℓ'] at hb
  have ha := (projectiveCompletion E).presheaf.germ_res_apply (homOfLE hZW) x hxZ F
  rw [← hb]
  have hcoord : Stacks.AlgebraicGeometry.ReflexiveModules.dualStalkEquiv L x ℓ
      (L.presheaf.germ W x (hZW hxZ) σ) = 1 := by
    change Stacks.AlgebraicGeometry.ReflexiveModules.dualStalkEquiv L x
      ((Stacks.AlgebraicGeometry.ReflexiveModules.dualStalkEquiv L x).symm
        hσ.coord.toLinearMap) _ = 1
    rw [LinearEquiv.apply_symm_apply]
    exact hσ.coord_self
  rw [hcoord, mul_one]
  exact ha


/-- The function `s / s` on the image of `D₊(s)` is `1`. -/
theorem chartFractionOn_self {U : X.Opens} (hU : IsAffineOpen U) (s : Γ(completionModule E, U)) :
    chartFractionOn hU s s = 1 := by
  rw [chartFractionOn, Stacks.ProjectiveSpace.degreeOneChartFraction_self, map_one]

variable {E} in
/-- **Stalkwise, the Koszul complex of the cosection is exact in positive degrees**: at every
point `ψ_x` takes the value `1` (off the zero section, over `D₊(c_k)`), or `ℰ_x` has a basis on
which `ψ_x` is a Koszul-regular sequence (over `D₊(T)`, where it is the sequence of coordinate
functions of affine space, localized). -/
theorem koszulStalkDual_exact_condition (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    (x : projectiveCompletion E) :
    (∃ e, Scheme.Modules.koszulStalkDual (koszulCosection E) x e = 1) ∨
      ∃ b : Module.Basis (Fin r) ↑(TopCat.Presheaf.stalk (projectiveCompletion E).sheaf.obj x)
          ↑(TopCat.Presheaf.stalk (koszulModule E).val.presheaf x),
        Koszul.IsKoszulRegular fun j =>
          Scheme.Modules.koszulStalkDual (koszulCosection E) x (b j) := by
  obtain ⟨U, hU, hxU, ⟨c⟩⟩ := Stacks.Chow.exists_isAffineOpen_basis_sections E r
    ((projectiveCompletionProj E).base x)
  rcases mem_chartBasicOpen_or hU c (x := x) hxU with hT | ⟨k, hk⟩
  · right
    obtain ⟨b, hb⟩ := exists_basis_koszulStalkDual E hU c _ hT
    refine ⟨b, ?_⟩
    have hfun : (fun j => Scheme.Modules.koszulStalkDual (koszulCosection E) x (b j)) = fun j =>
      (projectiveCompletion E).presheaf.germ _ x hT
        (chartFractionOn hU (sectionsSplitting E U).t₀ ((completionInl E).app U (c j))) :=
      funext hb
    rw [hfun]
    refine isKoszulRegular_sheaf_obj_stalk ?_
    set W : (projectiveCompletion E).Opens := chartBasicOpen hU (sectionsSplitting E U).t₀
    have hWaff : IsAffineOpen W := isAffineOpen_chartBasicOpen hU _
    obtain ⟨Φ, hΦ⟩ := exists_ringEquiv_mvPolynomial_chartBasicOpen hU c
    let Φ' : MvPolynomial (Fin r) Γ(X, U) ≃+* Γ(projectiveCompletion E, W) := Φ
    have h1 : Koszul.IsKoszulRegular fun j =>
        (chartFractionOn hU (sectionsSplitting E U).t₀ ((completionInl E).app U (c j)) :
          Γ(projectiveCompletion E, W)) := by
      have h0 := Stacks.AlgebraicGeometry.isKoszulRegular_map_ringEquiv Φ'
        (Koszul.isKoszulRegular_mvPolynomial_X Γ(X, U) r)
      have hfun : (fun k => Φ' (MvPolynomial.X k)) = fun j =>
          (chartFractionOn hU (sectionsSplitting E U).t₀ ((completionInl E).app U (c j)) :
            Γ(projectiveCompletion E, W)) := funext hΦ
      rwa [hfun] at h0
    let : Algebra Γ(projectiveCompletion E, W) ((projectiveCompletion E).presheaf.stalk x) :=
      ((projectiveCompletion E).presheaf.germ W x hT).hom.toAlgebra
    have := hWaff.isLocalization_stalk ⟨x, hT⟩
    have := IsLocalization.flat ((projectiveCompletion E).presheaf.stalk x)
      (hWaff.primeIdealOf ⟨x, hT⟩).asIdeal.primeCompl
    exact Koszul.isKoszulRegular_map_of_flat _ h1
  · left
    obtain ⟨b, hb⟩ := exists_basis_koszulStalkDual E hU c _ hk
    exact ⟨b k, (hb k).trans ((congrArg _ (chartFractionOn_self E hU _)).trans
      ((map_one _).trans (one_sheaf_obj_stalk x)))⟩


variable {E} in
/-- **The local data of the zero section on a chart.** Around every point `x` of the projective
completion there is an affine open `W` and functions `f_1, …, f_r` on it generating the kernel of
`i^♯` over `W`, together with a basis of `ℰ_x` on which `ψ_x` takes the values the germs of the
`f_j`: on the image of `D₊(s)` in the chart of an affine open `U` on which `ℰ` is free on `c`,
the functions `c_j / s`. -/
theorem exists_ker_app_zeroSection_eq_span (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    (x : projectiveCompletion E) :
    ∃ (W : (projectiveCompletion E).Opens) (_ : IsAffineOpen W) (hxW : x ∈ W)
      (f : Fin r → Γ(projectiveCompletion E, W))
      (b : Module.Basis (Fin r) ↑(TopCat.Presheaf.stalk (projectiveCompletion E).sheaf.obj x)
        ↑(TopCat.Presheaf.stalk (koszulModule E).val.presheaf x)),
      RingHom.ker ((zeroSection E).app W).hom = Ideal.span (Set.range f) ∧
        ∀ j, Scheme.Modules.koszulStalkDual (koszulCosection E) x (b j) =
          (projectiveCompletion E).presheaf.germ W x hxW (f j) := by
  obtain ⟨U, hU, hxU, ⟨c⟩⟩ := Stacks.Chow.exists_isAffineOpen_basis_sections E r
    ((projectiveCompletionProj E).base x)
  obtain ⟨s, hxs⟩ : ∃ s, x ∈ chartBasicOpen hU s := by
    rcases mem_chartBasicOpen_or hU c (x := x) hxU with hT | ⟨k, hk⟩
    · exact ⟨_, hT⟩
    · exact ⟨_, hk⟩
  obtain ⟨b, hb⟩ := exists_basis_koszulStalkDual E hU c s hxs
  exact ⟨chartBasicOpen hU s, isAffineOpen_chartBasicOpen hU s, hxs,
    fun j => chartFractionOn hU s ((completionInl E).app U (c j)), b,
    ker_app_zeroSection_chartBasicOpen hU c s, hb⟩

end Cosection


section Resolution

attribute [local instance 10000] HasDerivedCategory.standard

variable {X : Scheme.{u}} (E : X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] (r : ℕ)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]

/-- **The Koszul resolution of the zero section** (Stacks 0FEF): the Koszul complex of the
cosection `π^*ℰ ⊗ 𝒪_P(-1) ⟶ 𝒪_P`, with `⋀ⁿ(π^*ℰ ⊗ 𝒪_P(-1))` in degree `-n`, represents
`i_*𝒪_X ∈ D(𝒪_P)` for the zero section `i : X = 𝐏(𝒪_X) ⟶ P = 𝐏(ℰ ⊕ 𝒪_X)`, the map
`π^*ℰ ⟶ 𝒪_P(1)` vanishing exactly along `i(X)`. -/
def koszulResolutionZeroSection :
    Stacks.Chow.ExteriorPowerResolution
      ((DerivedCategory.singleFunctor (projectiveCompletion E).Modules 0).obj
        ((Scheme.Modules.pushforward (zeroSection E)).obj
          (SheafOfModules.unit (Stacks.Chow.bundle (Stacks.Ample.unitModule X)).ringCatSheaf)))
      (koszulModule E) :=
  Stacks.Chow.ExteriorPowerResolution.ofLocalGenerators (zeroSection E) (koszulCosection E) r
    (koszulStalkDual_exact_condition r) (exists_ker_app_zeroSection_eq_span r)

include r in
/-- **The Chern classes of `i_*𝒪_X` are defined**, `i_*𝒪_X` being resolved by the Koszul
complex of the zero section (Stacks 0GUE (2)). -/
theorem hasDefinedChernClasses_pushforward_zeroSection :
    Stacks.Chow.HasDefinedChernClasses
      ((DerivedCategory.singleFunctor (projectiveCompletion E).Modules 0).obj
        ((Scheme.Modules.pushforward (zeroSection E)).obj
          (SheafOfModules.unit (Stacks.Chow.bundle (Stacks.Ample.unitModule X)).ringCatSheaf))) :=
  (koszulResolutionZeroSection E r).hasDefinedChernClasses r

end Resolution

end Stacks.ProjectiveCompletion

end
