/-!
# The zero section of the projective completion, on the standard charts

Let `ℰ` be a finite locally free module on a scheme `X`, `π : P = 𝐏(ℰ ⊕ 𝒪_X) ⟶ X` its projective
completion and `τ : π^*(ℰ ⊕ 𝒪_X) ⟶ 𝒪_P(1)` the tautological quotient. The projection
`ℰ ⊕ 𝒪_X ⟶ 𝒪_X` induces a closed immersion `i : X = 𝐏(𝒪_X) ⟶ P`, the *zero section*, the
`Proj_X(𝒪_X[T]) ⟶ Proj_X(Sym(ℰ)[T])` of [Stacks, Tag 0FEF].

Over an affine open `U` of `X` on which `Γ(ℰ, U)` is free on `c_1, …, c_r`, the part of `P` over
`U` is `Proj B` for `B = Γ(U, Sym(ℰ ⊕ 𝒪_X)) = Γ(X, U)[c_1, …, c_r, T]`, and this file computes,
over the standard open `D₊(s)` of a degree-one element `s` of `B`:

* the sections `τ(π^*n)` of `𝒪_P(1)` attached to sections `n` of `ℰ ⊕ 𝒪_X`: `τ(π^*s)` is a
  generator, and `τ(π^*n) = (n / s) τ(π^*s)`;
* the ideal of the zero section: the kernel of `i^♯` is generated by the functions `c_j / s`,
  because the kernel of `B ⟶ Γ(X, U)[T]` is generated by the `c_j`;
* over `D₊(T)`, which is `Spec Γ(U, Sym ℰ)`, the functions are the polynomial ring
  `Γ(X, U)[c_1/T, …, c_r/T]`.

The opens `D₊(T)` and `D₊(c_k)` cover the chart, the degree-one part of `B` being spanned by
`T` and the `c_j`.

## Main definitions

* `Stacks.ProjectiveCompletion.zeroSection`: the zero section `i : 𝐏(𝒪_X) ⟶ P`.
* `Stacks.ProjectiveCompletion.tautologicalSection`: the section `τ(π^*n)` of `𝒪_P(1)`.
* `Stacks.ProjectiveCompletion.chartBasicOpen`, `Stacks.ProjectiveCompletion.chartFractionOn`:
  the image of `D₊(s)` in `P` and the function `n / s` on it.

## Main results

* `Stacks.ProjectiveSpace.ker_app_projMap_basicOpen_of_span_range`: the kernel of `Proj ψ` on
  `D₊(f)` for a graded homomorphism `ψ` whose kernel is generated by degree-one elements `l_j` is
  generated by the `l_j / f`.
* `Stacks.ProjectiveCompletion.tautologicalSection_restrict_eq_smul`:
  `τ(π^*n) = (n / s) τ(π^*s)` on `D₊(s)`.
* `Stacks.ProjectiveCompletion.bijective_smul_restrict_tautologicalSection`: `τ(π^*s)`
  trivializes `𝒪_P(1)` on `D₊(s)`.
* `Stacks.ProjectiveCompletion.ker_app_zeroSection_chartBasicOpen`: the ideal of the zero
  section on `D₊(s)`.
* `Stacks.ProjectiveCompletion.mem_chartBasicOpen_or`: `D₊(T)` and the `D₊(c_k)` cover.
* `Stacks.ProjectiveCompletion.exists_ringEquiv_mvPolynomial_chartBasicOpen`: `D₊(T)` is affine
  `r`-space.

## References

* [Stacks Project, Tag 0FEF](https://stacks.math.columbia.edu/tag/0FEF)
* [Stacks Project, Tag 01MP](https://stacks.math.columbia.edu/tag/01MP)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory HomogeneousLocalization TopologicalSpace
open AlgebraicGeometry.ProjectiveSpectrum.Proj

namespace Stacks.ProjectiveSpace

universe u

variable {S B σ τ : Type u} [CommRing S] [CommRing B] [SetLike σ S] [AddSubgroupClass σ S]
  [SetLike τ B] [AddSubgroupClass τ B]
  (𝒮 : ℕ → σ) (ℬ : ℕ → τ) [GradedRing 𝒮] [GradedRing ℬ]

/-- **A homogeneous element of the ideal generated by degree-one elements has homogeneous
cofactors.** If the `l j` are homogeneous of degree one and `x` is homogeneous of degree `D + 1`
and lies in the ideal they generate, then `x = ∑ j, l j * c j` with every `c j` homogeneous of
degree `D`. -/
theorem exists_sum_mul_eq_of_mem_span_range_degreeOne {ι : Type*} [Fintype ι] {l : ι → S}
    (hl : ∀ j, l j ∈ 𝒮 1) {D : ℕ} {x : S} (hx : x ∈ 𝒮 (D + 1))
    (hmem : x ∈ Ideal.span (Set.range l)) :
    ∃ c : ι → S, (∀ j, c j ∈ 𝒮 D) ∧ x = ∑ j, l j * c j := by
  classical
  obtain ⟨a, ha⟩ := (Ideal.mem_span_range_iff_exists_fun).1 hmem
  refine ⟨fun j => (DirectSum.decompose 𝒮 (a j) D : S), fun j => (DirectSum.decompose 𝒮 (a j) D).2,
    ?_⟩
  calc x = (DirectSum.decompose 𝒮 x (D + 1) : S) :=
        (DirectSum.decompose_of_mem_same 𝒮 hx).symm
    _ = ∑ j, (DirectSum.decompose 𝒮 (l j * a j) (D + 1) : S) := by
        rw [← ha]
        simp only [DirectSum.decompose_sum, DirectSum.sum_apply, AddSubmonoidClass.coe_finsetSum]
        exact Finset.sum_congr rfl fun j _ => by rw [mul_comm]
    _ = ∑ j, l j * (DirectSum.decompose 𝒮 (a j) D : S) := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [DirectSum.coe_decompose_mul_of_left_mem_of_le 𝒮 (hl j) (by omega),
          Nat.add_sub_cancel]

/-- **The kernel of `Proj ψ` on a standard chart, for several degree-one generators.** If the
kernel of a graded homomorphism `ψ` is the ideal generated by finitely many degree-one elements
`l j`, then over the standard open of a degree-one element `f` the kernel of `Proj ψ` on sections
is generated by the fractions `l j / f`. -/
theorem ker_app_projMap_basicOpen_of_span_range (ψ : 𝒮 →+*ᵍ ℬ)
    (hψ : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒮).map ψ)
    {ι : Type*} [Finite ι] {l : ι → S} (hl : ∀ j, l j ∈ 𝒮 1)
    (hker : RingHom.ker (ψ : S →+* B) = Ideal.span (Set.range l))
    {f : S} (hf : f ∈ 𝒮 1) :
    RingHom.ker ((Proj.map ψ hψ).app (Proj.basicOpen 𝒮 f)).hom
      = Ideal.span (Set.range fun j => degreeOneChartFraction 𝒮 hf (hl j)) := by
  have := Fintype.ofFinite ι
  have hl' : ∀ j, l j ∈ 𝒮 (1 • 1) := fun j => by simpa using hl j
  have hchart : ∀ j, degreeOneChartFraction 𝒮 hf (hl j)
      = (Proj.awayToSection 𝒮 f).hom (Away.mk 𝒮 hf 1 (l j) (hl' j)) := fun j => rfl
  have hiso : IsIso (Proj.awayToSection 𝒮 f) :=
    Stacks.ProjQuotientChartIdeal.isIso_awayToSection hf Nat.one_pos
  refine le_antisymm (fun x hx => ?_) (Ideal.span_le.mpr ?_)
  · obtain ⟨z, rfl⟩ := (ConcreteCategory.bijective_of_isIso (Proj.awayToSection 𝒮 f)).2 x
    have hz := (Stacks.ProjQuotientChartIdeal.awayToSection_mem_ker_app_projMap_iff
      ψ hψ hf Nat.one_pos z).1 hx
    obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective 𝒮 hf z
    obtain ⟨k, hk⟩ :=
      (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff ψ hf n a ha).1 hz
    rw [hker] at hk
    have hk1 : f ^ (k + 1) * a ∈ Ideal.span (Set.range l) := by
      have he : f ^ (k + 1) * a = f * (f ^ k * a) := by ring
      rw [he]
      exact Ideal.mul_mem_left _ _ hk
    have ha' : a ∈ 𝒮 n := by simpa using ha
    have hdeg : f ^ (k + 1) * a ∈ 𝒮 (k + n + 1) := by
      have h1 : f ^ (k + 1) ∈ 𝒮 (k + 1) := by simpa using SetLike.pow_mem_graded (k + 1) hf
      have h2 := SetLike.mul_mem_graded h1 ha'
      rwa [show k + 1 + n = k + n + 1 by omega] at h2
    obtain ⟨c, hc, hceq⟩ := exists_sum_mul_eq_of_mem_span_range_degreeOne 𝒮 hl hdeg hk1
    have hc' : ∀ j, c j ∈ 𝒮 ((k + n) • 1) := fun j => by simpa using hc j
    have hsum : Away.mk 𝒮 hf n a ha =
        ∑ j, Away.mk 𝒮 hf 1 (l j) (hl' j) * Away.mk 𝒮 hf (k + n) (c j) (hc' j) := by
      apply HomogeneousLocalization.val_injective
      classical
      have hval : ∀ t : Finset ι, (∑ j ∈ t, Away.mk 𝒮 hf 1 (l j) (hl' j) *
          Away.mk 𝒮 hf (k + n) (c j) (hc' j)).val =
          ∑ j ∈ t, (Away.mk 𝒮 hf 1 (l j) (hl' j)).val *
            (Away.mk 𝒮 hf (k + n) (c j) (hc' j)).val := by
        intro t
        induction t using Finset.induction_on with
        | empty => simp
        | insert j t hj ih =>
          rw [Finset.sum_insert hj, Finset.sum_insert hj, HomogeneousLocalization.val_add,
            HomogeneousLocalization.val_mul, ih]
      rw [hval]
      simp only [Away.val_mk, Localization.mk_mul]
      rw [← Localization.mk_sum, ← hceq, Localization.mk_eq_mk_iff]
      refine Localization.r_of_eq ?_
      simp only [Submonoid.coe_mul]
      ring
    rw [hsum, map_sum]
    refine Ideal.sum_mem _ fun j _ => ?_
    rw [map_mul, ← hchart]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨j, rfl⟩)
  · rintro y ⟨j, rfl⟩
    change degreeOneChartFraction 𝒮 hf (hl j) ∈ _
    rw [hchart]
    refine (Stacks.ProjQuotientChartIdeal.awayToSection_mem_ker_app_projMap_iff
      ψ hψ hf Nat.one_pos _).2 ?_
    refine (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff
      ψ hf 1 (l j) (hl' j)).2 ⟨0, ?_⟩
    rw [pow_zero, one_mul, hker]
    exact Ideal.subset_span ⟨j, rfl⟩

/-! ### The canonical sections of `𝒪(1)` on a standard chart -/

/-- The chart fraction `f / f` of a degree-one element is `1`. -/
theorem degreeOneChartFraction_self {f : S} (hf : f ∈ 𝒮 1) :
    degreeOneChartFraction 𝒮 hf hf = 1 := by
  have h : Away.mk 𝒮 hf 1 f (by simpa using hf) = 1 := by
    apply HomogeneousLocalization.val_injective
    rw [Away.val_mk, HomogeneousLocalization.val_one, ← Localization.mk_one,
      Localization.mk_eq_mk_iff]
    exact Localization.r_of_eq (by simp)
  exact (congrArg (Proj.awayToSection 𝒮 f).hom h).trans (map_one _)

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf in
/-- **On `D₊(f)` the canonical section of `𝒪(1)` attached to `b` is `b / f` times the one attached
to `f`**, for degree-one elements `b` and `f`. -/
theorem restrict_degreeSection_eq_smul {f : S} (hf : f ∈ 𝒮 1) (b : 𝒮 1) :
    ((twistingSheafModule 𝒮 ((1 : ℕ) : ℤ)).presheaf.map
        (homOfLE (le_top : Proj.basicOpen 𝒮 f ≤ ⊤)).op (degreeSection 𝒮 1 b) :
        Γ(twistingSheafModule 𝒮 ((1 : ℕ) : ℤ), Proj.basicOpen 𝒮 f)) =
      degreeOneChartFraction 𝒮 hf b.2 •
        ((twistingSheafModule 𝒮 ((1 : ℕ) : ℤ)).presheaf.map
          (homOfLE (le_top : Proj.basicOpen 𝒮 f ≤ ⊤)).op (degreeSection 𝒮 1 ⟨f, hf⟩) :
          Γ(twistingSheafModule 𝒮 ((1 : ℕ) : ℤ), Proj.basicOpen 𝒮 f)) := by
  have key := fun b' : 𝒮 (1 • 1) => twistTrivialization_restrict_degreeSection 𝒮 hf 1 b'
  refine (twistTrivialization 𝒮 hf 1).injective ?_
  refine (key b).trans ?_
  refine Eq.trans ?_ (map_smul (twistTrivialization 𝒮 hf 1) (degreeOneChartFraction 𝒮 hf b.2)
    _).symm
  refine Eq.trans ?_ (congrArg (degreeOneChartFraction 𝒮 hf b.2 • ·) (key ⟨f, hf⟩)).symm
  change degreeOneChartFraction 𝒮 hf b.2 = degreeOneChartFraction 𝒮 hf b.2 *
    degreeOneChartFraction 𝒮 hf hf
  rw [degreeOneChartFraction_self, mul_one]

end Stacks.ProjectiveSpace

namespace Stacks.ProjectiveCompletion

open Opposite Stacks.SymGraded Stacks.AlgebraicGeometry.RelativeProj
open Stacks.AlgebraicGeometry.RelativeProjDegreeOne

universe u

variable {X : Scheme.{u}} (E : X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]

/-- The degree-one element of `Γ(U, Sym(ℰ ⊕ 𝒪_X))` attached to a section `n` of `ℰ ⊕ 𝒪_X` over
`U`. -/
def completionDegreeOne (U : X.Opens) (n : Γ(completionModule E, U)) :
    (completionAlgebra E).sectionRing U :=
  DirectSum.of ((completionAlgebra E).sectionPieces U) 1
    ((Scheme.Modules.symmetricAlgebraGen X (completionModule E)).val.app (op U) n)

/-- The element attached to a section of `ℰ ⊕ 𝒪_X` is homogeneous of degree one. -/
theorem completionDegreeOne_mem (U : X.Opens) (n : Γ(completionModule E, U)) :
    completionDegreeOne E U n ∈ (completionAlgebra E).grading U 1 :=
  (completionAlgebra E).of_mem_grading U _

/-- The section `τ(π^*n)` of `𝒪_P(1)` over `π⁻¹U` attached to a section `n` of `ℰ ⊕ 𝒪_X` over
`U`: its pullback mapped by the tautological map `π^*(ℰ ⊕ 𝒪_X) ⟶ 𝒪_P(1)`. -/
def tautologicalSection (U : X.Opens) (n : Γ(completionModule E, U)) :
    Γ(Stacks.ProjectiveBundleSplitting.tautologicalTwist (completionModule E)
      (Stacks.Chow.bundlePieces (completionModule E)),
      (relativeProj (completionAlgebra E)).toBase ⁻¹ᵁ U) :=
  (Stacks.ProjectiveBundleSplitting.tautologicalMap (completionModule E)
    (Stacks.Chow.bundlePieces (completionModule E))).val.app
      (op ((relativeProj (completionAlgebra E)).toBase ⁻¹ᵁ U))
      (unitSection (relativeProj (completionAlgebra E)).toBase (completionModule E) U n)

/-- `τ(π^*n)` is the value of the degree-one homogeneous-section map at the degree-one element
attached to `n`. -/
theorem tautologicalSection_eq (U : X.Opens) (n : Γ(completionModule E, U)) :
    tautologicalSection E U n = ((projectiveBundleTwistData (completionModule E)
      (Stacks.Chow.bundlePieces (completionModule E))).ψ 1).val.app (op U)
        ((Scheme.Modules.symmetricAlgebraGen X (completionModule E)).val.app (op U) n) :=
  -- The quasi-coherence proof is left to unification, which reads it off the definiens of
  -- `tautologicalSection`; spelled out, it differs from the one stored there, and the kernel
  -- then compares the two sides by evaluating them.
  Stacks.Chow.GenuineChern.tautologicalMap_unitSection (completionModule E) _ U n

/-- The tautological map of the projective completion on a pulled-back section is the section
`τ(π^*n)` of `Stacks.ProjectiveCompletion.tautologicalSection`. -/
theorem bundleTautological_app_unitSection (U : X.Opens) (n : Γ(completionModule E, U)) :
    (Stacks.Chow.bundleTautological (completionModule E)).val.app
        (op (projectiveCompletionProj E ⁻¹ᵁ U))
        (Stacks.AlgebraicGeometry.RelativeProjDegreeOne.unitSection (projectiveCompletionProj E)
          (completionModule E) U n) =
      tautologicalSection E U n :=
  (Stacks.Chow.GenuineChern.tautologicalMap_unitSection (completionModule E)
    (Stacks.Chow.bundlePieces (completionModule E)) U n).trans (tautologicalSection_eq E U n).symm

variable {E}

/-- **The tautological sections on a chart.** Over the chart `Proj Γ(U, Sym(ℰ ⊕ 𝒪_X)) ⟶ P` of an
affine open `U`, the chart identification of `𝒪_P(1)` with the twisting sheaf carries the
canonical section of the degree-one element attached to `n` to `τ(π^*n)`. -/
theorem chartIso_inv_restrict_degreeSection {U : X.Opens} (hU : IsAffineOpen U)
    (V : (AlgebraicGeometry.Proj ((completionAlgebra E).grading U)).Opens)
    (n : Γ(completionModule E, U)) :
    ((projectiveBundleTwistData (completionModule E)
        (Stacks.Chow.bundlePieces (completionModule E))).chartData.chartIso U hU
        ((1 : ℕ) : ℤ)).inv.val.app (op V)
      ((twistingSheaf ((completionAlgebra E).grading U) ((1 : ℕ) : ℤ)).val.map
        (homOfLE le_top).op (degreeSection ((completionAlgebra E).grading U) 1
          ⟨completionDegreeOne E U n, completionDegreeOne_mem E U n⟩)) =
      ((projectiveBundleTwistData (completionModule E)
        (Stacks.Chow.bundlePieces (completionModule E))).algebra.piece ((1 : ℕ) : ℤ)).val.map
        (homOfLE (((relativeProj (completionAlgebra E)).chart U hU).image_mono le_top |>.trans
          (Stacks.AlgebraicGeometry.RelativeProjTwistGlue.chart_image_top _ U hU).le)).op
        (tautologicalSection E U n) := by
  have hle : (relativeProj (completionAlgebra E)).chart U hU ''ᵁ ⊤ ≤
      (relativeProj (completionAlgebra E)).toBase ⁻¹ᵁ U :=
    (Stacks.AlgebraicGeometry.RelativeProjTwistGlue.chart_image_top _ U hU).le
  have hnat := PresheafOfModules.naturality_apply
    ((projectiveBundleTwistData (completionModule E)
        (Stacks.Chow.bundlePieces (completionModule E))).chartData.chartIso U hU
        ((1 : ℕ) : ℤ)).inv.val (homOfLE (le_top : V ≤ ⊤)).op
    (degreeSection ((completionAlgebra E).grading U) 1
          ⟨completionDegreeOne E U n, completionDegreeOne_mem E U n⟩)
  refine hnat.trans ?_
  have h2 := Stacks.Chow.GenuineChern.chartIso_inv_degreeSection U hU
    ((Scheme.Modules.symmetricAlgebraGen X (completionModule E)).val.app (op U) n) hle
  refine (congrArg _ h2).trans ?_
  rw [tautologicalSection_eq]
  refine (Stacks.Chow.GenuineChern.restrict_map_apply'
    ((relativeProj (completionAlgebra E)).chart U hU)
    ((projectiveBundleTwistData (completionModule E)
      (Stacks.Chow.bundlePieces (completionModule E))).algebra.piece ((1 : ℕ) : ℤ))
    (le_top : V ≤ ⊤) _).trans ?_
  exact Stacks.Chow.GenuineChern.map_map_homOfLE' ((projectiveBundleTwistData (completionModule E)
      (Stacks.Chow.bundlePieces (completionModule E))).algebra.piece ((1 : ℕ) : ℤ)) _ hle _

/-- The image in the projective completion of the standard open `D₊(s)` of the chart over an
affine open `U`, for a degree-one element `s` attached to a section of `ℰ ⊕ 𝒪_X`. -/
abbrev chartBasicOpen {U : X.Opens} (hU : IsAffineOpen U) (s : Γ(completionModule E, U)) :
    (relativeProj (completionAlgebra E)).scheme.Opens :=
  (relativeProj (completionAlgebra E)).chart U hU ''ᵁ
    Proj.basicOpen ((completionAlgebra E).grading U) (completionDegreeOne E U s)

/-- The image of `D₊(s)` lies over `U`. -/
theorem chartBasicOpen_le {U : X.Opens} (hU : IsAffineOpen U) (s : Γ(completionModule E, U)) :
    chartBasicOpen hU s ≤ (relativeProj (completionAlgebra E)).toBase ⁻¹ᵁ U :=
  ((relativeProj (completionAlgebra E)).chart U hU).image_mono le_top |>.trans
    (Stacks.AlgebraicGeometry.RelativeProjTwistGlue.chart_image_top _ U hU).le

/-- The function `n / s` on `chartBasicOpen hU s`, for sections `n`, `s` of `ℰ ⊕ 𝒪_X` over `U`:
the chart fraction of the attached degree-one elements, carried to the projective completion. -/
def chartFractionOn {U : X.Opens} (hU : IsAffineOpen U) (s n : Γ(completionModule E, U)) :
    Γ((relativeProj (completionAlgebra E)).scheme, chartBasicOpen hU s) :=
  (((relativeProj (completionAlgebra E)).chart U hU).appIso
    (Proj.basicOpen ((completionAlgebra E).grading U) (completionDegreeOne E U s))).inv
    (Stacks.ProjectiveSpace.degreeOneChartFraction _ (completionDegreeOne_mem E U s)
      (completionDegreeOne_mem E U n))

/-- **The tautological sections on a standard chart.** Over the image of `D₊(s)`, the section
`τ(π^*n)` of `𝒪_P(1)` is `n / s` times `τ(π^*s)`. -/
theorem tautologicalSection_restrict_eq_smul {U : X.Opens} (hU : IsAffineOpen U)
    (s n : Γ(completionModule E, U)) :
    ((Stacks.ProjectiveBundleSplitting.tautologicalTwist (completionModule E)
        (Stacks.Chow.bundlePieces (completionModule E))).presheaf.map
        (homOfLE (chartBasicOpen_le hU s)).op (tautologicalSection E U n) :
        Γ(Stacks.ProjectiveBundleSplitting.tautologicalTwist (completionModule E)
          (Stacks.Chow.bundlePieces (completionModule E)), chartBasicOpen hU s)) =
      chartFractionOn hU s n •
        ((Stacks.ProjectiveBundleSplitting.tautologicalTwist (completionModule E)
          (Stacks.Chow.bundlePieces (completionModule E))).presheaf.map
          (homOfLE (chartBasicOpen_le hU s)).op (tautologicalSection E U s) :
          Γ(Stacks.ProjectiveBundleSplitting.tautologicalTwist (completionModule E)
            (Stacks.Chow.bundlePieces (completionModule E)), chartBasicOpen hU s)) := by
  have K1 := fun m => chartIso_inv_restrict_degreeSection hU
    (Proj.basicOpen ((completionAlgebra E).grading U) (completionDegreeOne E U s)) m
  have K2 := Stacks.ProjectiveSpace.restrict_degreeSection_eq_smul
    ((completionAlgebra E).grading U) (completionDegreeOne_mem E U s)
    ⟨completionDegreeOne E U n, completionDegreeOne_mem E U n⟩
  let ι := ((projectiveBundleTwistData (completionModule E)
    (Stacks.Chow.bundlePieces (completionModule E))).chartData.chartIso U hU ((1 : ℕ) : ℤ)).inv
  refine (K1 n).symm.trans ?_
  refine (congrArg (fun w => ι.val.app (op (Proj.basicOpen ((completionAlgebra E).grading U)
    (completionDegreeOne E U s))) w) K2).trans ?_
  refine (Scheme.Modules.Hom.app_smul ι _ _).trans ?_
  exact congrArg (fun w => Stacks.ProjectiveSpace.degreeOneChartFraction _
    (completionDegreeOne_mem E U s) (completionDegreeOne_mem E U n) • w) (K1 s)

/-- **`τ(π^*s)` trivializes `𝒪_P(1)` over the image of `D₊(s)`**: multiplication by it is a
bijection from the functions on `chartBasicOpen hU s` to the sections of `𝒪_P(1)` there. -/
theorem bijective_smul_restrict_tautologicalSection {U : X.Opens} (hU : IsAffineOpen U)
    (s : Γ(completionModule E, U)) :
    Function.Bijective fun a :
        Γ((relativeProj (completionAlgebra E)).scheme, chartBasicOpen hU s) =>
      a • ((Stacks.ProjectiveBundleSplitting.tautologicalTwist (completionModule E)
        (Stacks.Chow.bundlePieces (completionModule E))).presheaf.map
        (homOfLE (chartBasicOpen_le hU s)).op (tautologicalSection E U s) :
        Γ(Stacks.ProjectiveBundleSplitting.tautologicalTwist (completionModule E)
          (Stacks.Chow.bundlePieces (completionModule E)), chartBasicOpen hU s)) := by
  set V := Proj.basicOpen ((completionAlgebra E).grading U) (completionDegreeOne E U s)
  set g := (projectiveBundleTwistData (completionModule E)
    (Stacks.Chow.bundlePieces (completionModule E))).chartData.chartIso U hU ((1 : ℕ) : ℤ)
  set triv := twistTrivialization ((completionAlgebra E).grading U)
    (completionDegreeOne_mem E U s) 1
  set d := (twistingSheafModule ((completionAlgebra E).grading U) ((1 : ℕ) : ℤ)).presheaf.map
    (homOfLE (le_top : V ≤ ⊤)).op (degreeSection ((completionAlgebra E).grading U) 1
      ⟨completionDegreeOne E U s, completionDegreeOne_mem E U s⟩)
  have hd : triv d = 1 := by
    refine (twistTrivialization_restrict_degreeSection _ (completionDegreeOne_mem E U s) 1
      ⟨completionDegreeOne E U s, completionDegreeOne_mem E U s⟩).trans ?_
    exact Stacks.ProjectiveSpace.degreeOneChartFraction_self _ (completionDegreeOne_mem E U s)
  have K1 := chartIso_inv_restrict_degreeSection hU V s
  have hι : Function.Bijective (g.inv.val.app (op V)) := by
    have h1 : ∀ t, g.hom.val.app (op V) (g.inv.val.app (op V) t) = t := fun t => by
      exact congrArg (fun φ => (φ.val.app (op V)).hom t) g.inv_hom_id
    have h2 : ∀ t, g.inv.val.app (op V) (g.hom.val.app (op V) t) = t := fun t => by
      exact congrArg (fun φ => (φ.val.app (op V)).hom t) g.hom_inv_id
    exact ⟨Function.LeftInverse.injective h1, Function.RightInverse.surjective h2⟩
  have hG : Function.Bijective fun b :
      Γ(AlgebraicGeometry.Proj ((completionAlgebra E).grading U), V) =>
      g.inv.val.app (op V) (triv.symm b) := hι.comp triv.symm.bijective
  have happ : ∀ b, g.inv.val.app (op V) (triv.symm b) =
      (((relativeProj (completionAlgebra E)).chart U hU).appIso V).inv b •
        ((Stacks.ProjectiveBundleSplitting.tautologicalTwist (completionModule E)
        (Stacks.Chow.bundlePieces (completionModule E))).presheaf.map
        (homOfLE (chartBasicOpen_le hU s)).op (tautologicalSection E U s) :
        Γ(Stacks.ProjectiveBundleSplitting.tautologicalTwist (completionModule E)
          (Stacks.Chow.bundlePieces (completionModule E)), chartBasicOpen hU s)) := by
    intro b
    have hb : triv.symm b = b • d := by
      refine triv.injective ?_
      rw [LinearEquiv.apply_symm_apply, map_smul, hd, smul_eq_mul, mul_one]
    rw [hb]
    refine (Scheme.Modules.Hom.app_smul g.inv b d).trans ?_
    exact congrArg (fun w => b • w) K1
  have hfun : (fun a : Γ((relativeProj (completionAlgebra E)).scheme, chartBasicOpen hU s) =>
      a • ((Stacks.ProjectiveBundleSplitting.tautologicalTwist (completionModule E)
        (Stacks.Chow.bundlePieces (completionModule E))).presheaf.map
        (homOfLE (chartBasicOpen_le hU s)).op (tautologicalSection E U s) :
        Γ(Stacks.ProjectiveBundleSplitting.tautologicalTwist (completionModule E)
          (Stacks.Chow.bundlePieces (completionModule E)), chartBasicOpen hU s))) =
      (fun b => g.inv.val.app (op V) (triv.symm b)) ∘
        (((relativeProj (completionAlgebra E)).chart U hU).appIso V).hom := by
    funext a
    rw [Function.comp_apply, happ]
    exact congrArg (fun r => r • _)
      (ConcreteCategory.congr_hom
        (((relativeProj (completionAlgebra E)).chart U hU).appIso V).hom_inv_id a).symm
  rw [hfun]
  exact hG.comp (ConcreteCategory.bijective_of_isIso _)

/-! ### The zero section -/

/-- The structure sheaf is finite locally free, read as an instance on `Stacks.Ample.unitModule`
(`Stacks.RelativeSpec.AlgebraSheaf.isFiniteLocallyFree_unitModule`). -/
instance isFiniteLocallyFree_unitModule (X : Scheme.{u}) :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} (Stacks.Ample.unitModule X) :=
  Stacks.RelativeSpec.AlgebraSheaf.isFiniteLocallyFree_unitModule X

variable (E) in
/-- **The zero section `i : X = 𝐏(𝒪_X) ⟶ P = 𝐏(ℰ ⊕ 𝒪_X)` of the projective completion**: the
closed immersion of projective bundles `Proj_X(𝒪_X[T]) ⟶ Proj_X(Sym(ℰ)[T])` induced by the
projection `ℰ ⊕ 𝒪_X ⟶ 𝒪_X`. -/
def zeroSection : Stacks.Chow.bundle (Stacks.Ample.unitModule X) ⟶ projectiveCompletion E :=
  Stacks.Chow.GenuineChern.bundleEmbedding (completionSnd E)

variable (E) in
/-- The zero section is a closed immersion. -/
instance isClosedImmersion_zeroSection : IsClosedImmersion (zeroSection E) :=
  Stacks.Chow.GenuineChern.isClosedImmersion_bundleEmbedding _

variable (E) in
/-- **The zero section lies over `X`.** -/
@[reassoc (attr := simp)]
theorem zeroSection_comp_projectiveCompletionProj :
    zeroSection E ≫ projectiveCompletionProj E = Stacks.Chow.bundleProj _ :=
  Stacks.Chow.GenuineChern.bundleEmbedding_comp_bundleProj _

/-- A section of `ℰ ⊕ 𝒪_X` is a combination of the basis vectors of `ℰ` and of `T`. -/
private theorem eq_sum_inl_add_smul_t₀ {F : X.Modules} {U : X.Opens} {r : ℕ}
    (c : Module.Basis (Fin r) Γ(X, U) Γ(F, U)) (n : Γ(completionModule F, U)) :
    n = ∑ k, c.repr ((sectionsSplitting F U).p n) k • (completionInl F).app U (c k) +
      (sectionsSplitting F U).q n • (sectionsSplitting F U).t₀ := by
  conv_lhs => rw [← (sectionsSplitting F U).j_p_add_q_smul n]
  congr 1
  conv_lhs => rw [← c.sum_repr ((sectionsSplitting F U).p n)]
  rw [map_sum]
  exact Finset.sum_congr rfl fun k _ => map_smul _ _ _

/-- **The kernel of `Γ(U, Sym(ℰ ⊕ 𝒪_X)) ⟶ Γ(U, Sym(𝒪_X))`** is generated by the degree-one
elements attached to a basis of `Γ(ℰ, U)`, for an affine open `U`. -/
theorem ker_sectionHom_completionSnd {U : X.Opens} (hU : IsAffineOpen U) {r : ℕ}
    (c : Module.Basis (Fin r) Γ(X, U) Γ(E, U)) :
    RingHom.ker ((schemeSheafGradedAlgebraHom (completionSnd E)
        (Stacks.Chow.bundlePieces (completionModule E))
        (Stacks.Chow.bundlePieces (Stacks.Ample.unitModule X))).sectionHom U :
          (completionAlgebra E).sectionRing U →+*
            (schemeSheafGradedAlgebra (Stacks.Ample.unitModule X)
              (Stacks.Chow.bundlePieces (Stacks.Ample.unitModule X))).sectionRing U) =
      Ideal.span (Set.range fun j => completionDegreeOne E U ((completionInl E).app U (c j))) := by
  set e₁ := Stacks.SymGraded.AffinePieces.symSectionRingEquiv (completionModule E) hU
    (Stacks.Chow.bundlePieces (completionModule E))
  set e₂ := Stacks.SymGraded.AffinePieces.symSectionRingEquiv (Stacks.Ample.unitModule X) hU
    (Stacks.Chow.bundlePieces (Stacks.Ample.unitModule X))
  set f := Stacks.SymGraded.AffinePieces.sectionsLinearMap (completionSnd E) U
  have hf : Function.Surjective f := fun a =>
    ⟨(show Γ(X, U) from a) • (sectionsSplitting E U).t₀, by
      change (sectionsSplitting E U).q ((show Γ(X, U) from a) • (sectionsSplitting E U).t₀) = a
      rw [map_smul, (sectionsSplitting E U).q_t₀, smul_eq_mul, mul_one]⟩
  have hkerf : LinearMap.ker f = Submodule.span Γ(X, U)
      (Set.range fun j => (completionInl E).app U (c j)) := by
    refine le_antisymm (fun n hn => ?_) (Submodule.span_le.2 ?_)
    · rw [eq_sum_inl_add_smul_t₀ c n, show (sectionsSplitting E U).q n = 0 from hn, zero_smul,
        add_zero]
      exact Submodule.sum_mem _ fun j _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
    · rintro _ ⟨j, rfl⟩
      exact (sectionsSplitting E U).q_j (c j)
  have hcomp : ∀ x, ((schemeSheafGradedAlgebraHom (completionSnd E)
      (Stacks.Chow.bundlePieces (completionModule E))
      (Stacks.Chow.bundlePieces (Stacks.Ample.unitModule X))).sectionHom U) x =
        e₂.symm (SymPow.symAlgMap f (e₁ x)) := fun x => by
    rw [← Stacks.SymGraded.AffinePieces.symSectionRingEquiv_sectionHom, RingEquiv.symm_apply_apply]
  have hspan : Ideal.span (SymmetricAlgebra.ι Γ(X, U) Γ(completionModule E, U) ''
      (LinearMap.ker f : Set Γ(completionModule E, U))) =
      Ideal.span (Set.range fun j => SymmetricAlgebra.ι Γ(X, U) Γ(completionModule E, U)
        ((completionInl E).app U (c j))) := by
    refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_mono ?_)
    · rintro _ ⟨n, hn, rfl⟩
      rw [SetLike.mem_coe, hkerf] at hn
      induction hn using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨j, rfl⟩ := hy
        exact Ideal.subset_span ⟨j, rfl⟩
      | zero => simp
      | add y z _ _ hy hz => rw [map_add]; exact Ideal.add_mem _ hy hz
      | smul a y _ hy =>
        rw [map_smul, Algebra.smul_def]
        exact Ideal.mul_mem_left _ _ hy
    · rintro _ ⟨j, rfl⟩
      refine ⟨(completionInl E).app U (c j), ?_, rfl⟩
      rw [SetLike.mem_coe, hkerf]
      exact Submodule.subset_span ⟨j, rfl⟩
  have hker : RingHom.ker ((schemeSheafGradedAlgebraHom (completionSnd E)
      (Stacks.Chow.bundlePieces (completionModule E))
      (Stacks.Chow.bundlePieces (Stacks.Ample.unitModule X))).sectionHom U :
        (completionAlgebra E).sectionRing U →+*
          (schemeSheafGradedAlgebra (Stacks.Ample.unitModule X)
            (Stacks.Chow.bundlePieces (Stacks.Ample.unitModule X))).sectionRing U) =
      (RingHom.ker (SymPow.symAlgMap f).toRingHom).comap e₁ := by
    ext x
    rw [RingHom.mem_ker, Ideal.mem_comap, RingHom.mem_ker]
    refine ⟨fun h => by simpa using congrArg e₂ ((hcomp x).symm.trans h), fun h => ?_⟩
    change SymPow.symAlgMap f (e₁ x) = 0 at h
    exact (hcomp x).trans (by rw [h, map_zero])
  rw [hker]
  have hk := Stacks.Chow.GenuineChern.ker_symAlgMap_eq_span f hf
  change (RingHom.ker (SymPow.symAlgMap f)).comap e₁ = _
  rw [hk, hspan, ← Ideal.map_symm, Ideal.map_span, ← Set.range_comp]
  congr 1
  refine congrArg Set.range (funext fun j => ?_)
  refine (RingEquiv.symm_apply_eq _).2 ?_
  exact (Stacks.SymGraded.AffinePieces.symSectionRingEquiv_of_symmetricAlgebraGen _ hU _ _).symm

/-- The image of a standard open of a chart is an affine open of the projective completion. -/
theorem isAffineOpen_chartBasicOpen {U : X.Opens} (hU : IsAffineOpen U)
    (s : Γ(completionModule E, U)) : IsAffineOpen (chartBasicOpen hU s) :=
  (Proj.isAffineOpen_basicOpen _ _ (completionDegreeOne_mem E U s) one_pos).image_of_isOpenImmersion
    _

/-- **The ideal of the zero section on a standard chart.** Over the image of `D₊(s)` in the
chart of an affine open `U` on which `ℰ` is free on `c`, the kernel of `i^♯` is generated by the
functions `c_j / s`. -/
theorem ker_app_zeroSection_chartBasicOpen {U : X.Opens} (hU : IsAffineOpen U) {r : ℕ}
    (c : Module.Basis (Fin r) Γ(X, U) Γ(E, U)) (s : Γ(completionModule E, U)) :
    RingHom.ker ((zeroSection E).app (chartBasicOpen hU s)).hom =
      Ideal.span (Set.range fun j => chartFractionOn hU s ((completionInl E).app U (c j))) := by
  set hψ := Stacks.Chow.GenuineChern.surjectiveOnAffineSections_bundle (completionSnd E)
  set ch := (relativeProj (completionAlgebra E)).chart U hU
  set V := Proj.basicOpen ((completionAlgebra E).grading U) (completionDegreeOne E U s)
  have hV : IsAffineOpen V :=
    Proj.isAffineOpen_basicOpen _ _ (completionDegreeOne_mem E U s) one_pos
  have := Stacks.AlgebraicGeometry.ProjBundleSurjection.isClosedImmersion_chartMap hψ U hU
  have h1 : (zeroSection E).ker.comap ch =
      (Stacks.AlgebraicGeometry.ProjBundleSurjection.chartMap hψ U hU).ker :=
    Stacks.Chow.GenuineChern.comap_chart_ker_map hψ U hU
  have h2 := congrArg
    (fun I : (AlgebraicGeometry.Proj ((completionAlgebra E).grading U)).IdealSheafData =>
    I.ideal ⟨V, hV⟩) h1
  have h3 := (Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion
    (Y := (relativeProj (completionAlgebra E)).scheme) (zeroSection E).ker ch ⟨V, hV⟩).symm.trans
    h2
  have h4 : (zeroSection E).ker.ideal ⟨ch ''ᵁ V, hV.image_of_isOpenImmersion ch⟩ =
      RingHom.ker ((zeroSection E).app (chartBasicOpen hU s)).hom :=
    Scheme.Hom.ker_apply (zeroSection E) ⟨ch ''ᵁ V, hV.image_of_isOpenImmersion ch⟩
  rw [Scheme.Hom.ker_apply] at h3
  have h5 : Ideal.comap (ch.appIso V).inv.hom
      (RingHom.ker ((zeroSection E).app (chartBasicOpen hU s)).hom) =
      RingHom.ker ((Stacks.AlgebraicGeometry.ProjBundleSurjection.chartMap hψ U hU).app V).hom :=
    (congrArg (Ideal.comap (ch.appIso V).inv.hom) h4).symm.trans h3
  clear h2 h3
  have h2 := h5
  rw [Stacks.AlgebraicGeometry.ProjBundleSurjection.chartMap_eq_map hψ U hU,
    Stacks.ProjectiveSpace.ker_app_projMap_basicOpen_of_span_range _ _ _ _
      (fun j => completionDegreeOne_mem E U ((completionInl E).app U (c j)))
      (ker_sectionHom_completionSnd hU c) (completionDegreeOne_mem E U s)] at h2
  refine ((Ideal.map_comap_of_surjective (ch.appIso V).inv.hom
    (ConcreteCategory.bijective_of_isIso (ch.appIso V).inv).2 _).symm).trans ?_
  refine (congrArg (Ideal.map (ch.appIso V).inv.hom) h2).trans ?_
  rw [Ideal.map_span, ← Set.range_comp]
  rfl

/-- **The standard opens of `T` and of a basis cover the chart.** Over an affine open `U` on
which `ℰ` is free on `c`, every point of the projective completion lying over `U` lies in the
image of `D₊(T)` or of some `D₊(c_k)`: the degree-one elements `T`, `c_1, …, c_r` span the
degree-one part of `Γ(U, Sym(ℰ ⊕ 𝒪_X))`, which generates the irrelevant ideal. -/
theorem mem_chartBasicOpen_or {U : X.Opens} (hU : IsAffineOpen U) {r : ℕ}
    (c : Module.Basis (Fin r) Γ(X, U) Γ(E, U)) {x : (relativeProj (completionAlgebra E)).scheme}
    (hx : x ∈ (relativeProj (completionAlgebra E)).toBase ⁻¹ᵁ U) :
    x ∈ chartBasicOpen hU (sectionsSplitting E U).t₀ ∨
      ∃ k, x ∈ chartBasicOpen hU ((completionInl E).app U (c k)) := by
  rw [← Stacks.AlgebraicGeometry.RelativeProjTwistGlue.chart_image_top _ U hU] at hx
  obtain ⟨z, -, rfl⟩ := hx
  have hcov := Proj.iSup_basicOpen_eq_top' ((completionAlgebra E).grading U)
    (fun b : (completionAlgebra E).grading U 1 => (b : (completionAlgebra E).sectionRing U))
    (fun b => ⟨1, b.2⟩) (by
      have hr : Set.range (fun b : (completionAlgebra E).grading U 1 =>
          (b : (completionAlgebra E).sectionRing U)) =
          ((completionAlgebra E).grading U 1 : Set ((completionAlgebra E).sectionRing U)) := by
        ext y; simp
      rw [hr]
      exact adjoin_grading_one_eq_top (completionModule E) U
        (Stacks.Chow.bundlePieces (completionModule E)) hU)
  have hz : z ∈ ⨆ b : (completionAlgebra E).grading U 1,
      Proj.basicOpen ((completionAlgebra E).grading U)
        (b : (completionAlgebra E).sectionRing U) := by
    rw [hcov]; trivial
  obtain ⟨⟨b, hb⟩, hzb⟩ := Opens.mem_iSup.1 hz
  by_contra hnot
  push Not at hnot
  obtain ⟨hT, hc⟩ := hnot
  have hnz : ∀ m, z ∉ Proj.basicOpen ((completionAlgebra E).grading U)
      (completionDegreeOne E U m) → completionDegreeOne E U m ∈ z.asHomogeneousIdeal := by
    intro m hm
    by_contra h
    exact hm ((Proj.mem_basicOpen _ _ _).2 h)
  have hT' : completionDegreeOne E U (sectionsSplitting E U).t₀ ∈ z.asHomogeneousIdeal :=
    hnz _ fun h => hT ⟨z, h, rfl⟩
  have hc' : ∀ k, completionDegreeOne E U ((completionInl E).app U (c k)) ∈
      z.asHomogeneousIdeal := fun k => hnz _ fun h => hc k ⟨z, h, rfl⟩
  have he : ∀ m, (sectionRingEquiv hU).symm (SymmetricAlgebra.ι _ _ m) =
      completionDegreeOne E U m := fun m =>
    (RingEquiv.symm_apply_eq _).2
      (Stacks.SymGraded.AffinePieces.symSectionRingEquiv_of_symmetricAlgebraGen _ hU _ m).symm
  have hb1 := (sectionRingEquiv_mem_iff hU 1 b).2 hb
  rw [SymPow.symmetricPower, pow_one] at hb1
  obtain ⟨n, hn⟩ := hb1
  have hbn : b = (sectionRingEquiv hU).symm (SymmetricAlgebra.ι _ _ n) := by
    rw [hn, RingEquiv.symm_apply_apply]
  refine (Proj.mem_basicOpen _ _ _).1 hzb ?_
  change b ∈ z.asHomogeneousIdeal
  rw [hbn, eq_sum_inl_add_smul_t₀ c n, map_add, map_sum, map_add, map_sum]
  refine Ideal.add_mem _ (Ideal.sum_mem _ fun k _ => ?_) ?_
  · rw [map_smul, Algebra.smul_def, map_mul, he]
    exact Ideal.mul_mem_left _ _ (hc' k)
  · rw [map_smul, Algebra.smul_def, map_mul, he]
    exact Ideal.mul_mem_left _ _ hT'

/-- **The chart `D₊(T)` is affine space.** Over an affine open `U` on which `ℰ` is free on `c`,
the functions on the image of `D₊(T)` are the polynomial ring over `Γ(X, U)` in the functions
`c_j / T`. -/
theorem exists_ringEquiv_mvPolynomial_chartBasicOpen {U : X.Opens} (hU : IsAffineOpen U) {r : ℕ}
    (c : Module.Basis (Fin r) Γ(X, U) Γ(E, U)) :
    ∃ Φ : MvPolynomial (Fin r) Γ(X, U) ≃+*
        Γ((relativeProj (completionAlgebra E)).scheme,
          chartBasicOpen hU (sectionsSplitting E U).t₀),
      ∀ j, Φ (MvPolynomial.X j) =
        chartFractionOn hU (sectionsSplitting E U).t₀ ((completionInl E).app U (c j)) := by
  set V := Proj.basicOpen ((completionAlgebra E).grading U)
    (completionDegreeOne E U (sectionsSplitting E U).t₀)
  have : IsIso (Proj.awayToSection ((completionAlgebra E).grading U)
      (completionDegreeOne E U (sectionsSplitting E U).t₀)) :=
    Stacks.ProjQuotientChartIdeal.isIso_awayToSection
      (completionDegreeOne_mem E U (sectionsSplitting E U).t₀) Nat.one_pos
  let Φ₄ := (asIso (Proj.awayToSection ((completionAlgebra E).grading U)
      (completionDegreeOne E U (sectionsSplitting E U).t₀))).commRingCatIsoToRingEquiv
  let Φ₅ :=
    (((relativeProj (completionAlgebra E)).chart U hU).appIso V).symm.commRingCatIsoToRingEquiv
  refine ⟨(SymmetricAlgebra.equivMvPolynomial c).symm.toRingEquiv.trans
    ((Stacks.SymAlgSections.symSectionsRingEquiv E hU).trans ((chartRingEquiv hU).trans
      (Φ₄.trans Φ₅))), fun j => ?_⟩
  have h1 : (SymmetricAlgebra.equivMvPolynomial c).symm (MvPolynomial.X j) =
      SymmetricAlgebra.ι _ _ (c j) := by
    rw [AlgEquiv.symm_apply_eq, SymmetricAlgebra.equivMvPolynomial_ι_apply]
  have h3 : chartRingEquiv hU (symGenSection E U (c j)) =
      HomogeneousLocalization.Away.mk _ (infinitySection_mem E U) 1
        (completionDegreeOne E U ((completionInl E).app U (c j)))
        (by simpa using completionDegreeOne_mem E U ((completionInl E).app U (c j))) := by
    refine ((RingEquiv.symm_apply_eq _).1 ?_).symm
    rw [chartRingEquiv_symm_mk]
    refine (sectionsDehomogenize_gen hU _).trans ?_
    have hp : (sectionsSplitting E U).p ((completionInl E).app U (c j)) = c j :=
      (sectionsSplitting E U).p_j (c j)
    have hq : (sectionsSplitting E U).q ((completionInl E).app U (c j)) = 0 :=
      (sectionsSplitting E U).q_j (c j)
    exact (congrArg₂ (· + ·) (congrArg (symGenSection E U) hp)
      ((congrArg _ hq).trans (map_zero _))).trans (add_zero _)
  change Φ₅ (Φ₄ (chartRingEquiv hU (Stacks.SymAlgSections.symSectionsRingEquiv E hU
    ((SymmetricAlgebra.equivMvPolynomial c).symm (MvPolynomial.X j))))) = _
  rw [h1, symSectionsRingEquiv_ι, h3]
  rfl

end Stacks.ProjectiveCompletion

end
