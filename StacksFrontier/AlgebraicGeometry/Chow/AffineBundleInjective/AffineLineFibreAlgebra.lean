module

public import StacksFrontier.AlgebraicGeometry.Chow.AffineBundle.PrimeCycleGenericFibre
public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.AffineLineResidue
public import StacksFrontier.AlgebraicGeometry.Chow.PointClosureFractionFieldOrder

/-!
# The primes of `A[T]` over a prime of `A`, and the units of `k(T)` without zeros or poles

Let `A` be a commutative ring, `𝔭` a prime of `A` and `ev : A →+* k` a map to a field with kernel
`𝔭` such that `k` is generated by fractions of values of `ev` with denominators off `𝔭` (that is,
`k` is a fraction field of `A ⧸ 𝔭`, for instance the residue field of `𝔭`). The fibre of
`Spec A[T] ⟶ Spec A` over `𝔭` is `Spec k[T]`, and this file proves the two algebraic facts about
that identification which the fibrewise computation of the higher Chow groups of the affine line
needs:

* extension `Q ↦ Q k[T]` along `π = map ev : A[T] → k[T]` and contraction are inverse on the
  primes of `A[T]` lying over `𝔭`; consequently a strict chain `Q' ⊊ Q` of primes over `𝔭` has
  `Q' = 𝔭 A[T]`, the generic point of the fibre;
* a rational function over a field with order zero at every closed point of the affine line is a
  constant.

## Main results

* `Stacks.Chow.exists_C_mul_eq_mapRingHom` — every polynomial over `k` is, up to a nonzero
  constant coming from `A`, the image of a polynomial over `A`.
* `Stacks.Chow.comap_map_mapRingHom`, `Stacks.Chow.isPrime_map_mapRingHom`,
  `Stacks.Chow.map_comap_mapRingHom`, `Stacks.Chow.comap_C_comap_mapRingHom` — the prime
  correspondence between the fibre over `𝔭` and `k[T]`.
* `Stacks.Chow.eq_map_C_of_le_of_ne` — a strict chain of primes over `𝔭` starts at `𝔭 A[T]`.
* `Stacks.Chow.exists_eq_C_of_ordFrac_eq_one` — a rational function without zeros or poles on
  the affine line is constant.

## References

* [Stacks Project, Tag 0GUA](https://stacks.math.columbia.edu/tag/0GUA)
* [Stacks Project, Tag 0GUB](https://stacks.math.columbia.edu/tag/0GUB)
-/

@[expose] public noncomputable section

open Polynomial

namespace Stacks.Chow

/-! ### The prime correspondence along `A[T] → k[T]` -/

section FibreAlgebra

variable {A k : Type*} [CommRing A] [Field k] (ev : A →+* k) {𝔭 : Ideal A}

/-- An element of an ideal of `k[T]` is in it as soon as a nonzero constant multiple is. -/
theorem mem_of_C_mul_mem {I : Ideal k[X]} {c : k} (hc : c ≠ 0) {x : k[X]} (h : C c * x ∈ I) :
    x ∈ I := by
  have := I.mul_mem_left (C c⁻¹) h
  rwa [← mul_assoc, ← C_mul, inv_mul_cancel₀ hc, C_1, one_mul] at this

/-- Clearing denominators is compatible with sums. -/
private theorem C_mul_add_eq_mapRingHom {s t : A} {g g' : k[X]} {h h' : A[X]}
    (hh : C (ev s) * g = mapRingHom ev h) (hh' : C (ev t) * g' = mapRingHom ev h') :
    C (ev (s * t)) * (g + g') = mapRingHom ev (C t * h + C s * h') := by
  simp only [map_add, map_mul]
  simp only [coe_mapRingHom, Polynomial.map_C] at hh hh' ⊢
  linear_combination C (ev t) * hh + C (ev s) * hh'

/-- A nonzero constant lies in no proper ideal of `k[T]`. -/
private theorem C_notMem_of_ne_top {P : Ideal k[X]} (hP : P ≠ ⊤) {c : k} (hc : c ≠ 0) :
    C c ∉ P :=
  fun h ↦ hP (Ideal.eq_top_of_isUnit_mem _ h (isUnit_C.mpr hc.isUnit))

/-- **Clearing denominators.** Every polynomial over `k` is, up to a nonzero constant `ev s` with
`s ∉ 𝔭`, the image of a polynomial over `A`. -/
theorem exists_C_mul_eq_mapRingHom [𝔭.IsPrime]
    (hfrac : ∀ c : k, ∃ a s, s ∉ 𝔭 ∧ c * ev s = ev a) (g : k[X]) :
    ∃ s, s ∉ 𝔭 ∧ ∃ h : A[X], C (ev s) * g = mapRingHom ev h := by
  induction g using Polynomial.induction_on' with
  | add p q hp hq =>
    obtain ⟨s, hs, h, hh⟩ := hp
    obtain ⟨t, ht, h', hh'⟩ := hq
    exact ⟨s * t, ‹𝔭.IsPrime›.mul_notMem hs ht, _, C_mul_add_eq_mapRingHom ev hh hh'⟩
  | monomial n c =>
    obtain ⟨a, s, hs, hc⟩ := hfrac c
    refine ⟨s, hs, monomial n a, ?_⟩
    rw [coe_mapRingHom, Polynomial.map_monomial, ← hc, C_mul_monomial, mul_comm]

/-- The kernel of `A[T] → k[T]` is `𝔭 A[T]`. -/
theorem mapRingHom_eq_zero_iff (hker : ∀ a, ev a = 0 ↔ a ∈ 𝔭) (h : A[X]) :
    mapRingHom ev h = 0 ↔ h ∈ 𝔭.map (C : A →+* A[X]) := by
  have hk : RingHom.ker ev = 𝔭 := Ideal.ext fun a ↦ (RingHom.mem_ker).trans (hker a)
  rw [← hk, ← Polynomial.ker_mapRingHom, RingHom.mem_ker]

/-- An element of the extension of an ideal `Q` of `A[T]` to `k[T]` is, up to a nonzero constant
coming from `A`, the image of an element of `Q`. -/
theorem exists_C_mul_eq_mapRingHom_of_mem_map [𝔭.IsPrime]
    (hfrac : ∀ c : k, ∃ a s, s ∉ 𝔭 ∧ c * ev s = ev a) {Q : Ideal A[X]} {g : k[X]}
    (hg : g ∈ Q.map (mapRingHom ev)) :
    ∃ s, s ∉ 𝔭 ∧ ∃ h ∈ Q, C (ev s) * g = mapRingHom ev h := by
  have h1 : (1 : A) ∉ 𝔭 := (Ideal.ne_top_iff_one 𝔭).mp ‹𝔭.IsPrime›.ne_top
  induction hg using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨h, hh, rfl⟩ := hx
    exact ⟨1, h1, h, hh, by rw [map_one, C_1, one_mul]⟩
  | zero => exact ⟨1, h1, 0, Q.zero_mem, by rw [mul_zero, map_zero]⟩
  | add x y _ _ hx hy =>
    obtain ⟨s, hs, h, hhQ, hh⟩ := hx
    obtain ⟨t, ht, h', hh'Q, hh'⟩ := hy
    refine ⟨s * t, ‹𝔭.IsPrime›.mul_notMem hs ht, C t * h + C s * h',
      Q.add_mem (Q.mul_mem_left _ hhQ) (Q.mul_mem_left _ hh'Q),
      C_mul_add_eq_mapRingHom ev hh hh'⟩
  | smul c x _ hx =>
    obtain ⟨s, hs, h, hhQ, hh⟩ := hx
    obtain ⟨t, ht, b, hb⟩ := exists_C_mul_eq_mapRingHom ev hfrac c
    refine ⟨t * s, ‹𝔭.IsPrime›.mul_notMem ht hs, b * h, Q.mul_mem_left _ hhQ, ?_⟩
    simp only [smul_eq_mul, map_mul]
    linear_combination (C (ev s) * x) * hb + mapRingHom ev b * hh

/-- **Contracting the extension of a prime over `𝔭` gives it back.** -/
theorem comap_map_mapRingHom [𝔭.IsPrime] (hker : ∀ a, ev a = 0 ↔ a ∈ 𝔭)
    (hfrac : ∀ c : k, ∃ a s, s ∉ 𝔭 ∧ c * ev s = ev a) {Q : Ideal A[X]} [Q.IsPrime]
    (hQ : Q.comap (C : A →+* A[X]) = 𝔭) :
    (Q.map (mapRingHom ev)).comap (mapRingHom ev) = Q := by
  refine le_antisymm (fun b hb ↦ ?_) Ideal.le_comap_map
  obtain ⟨s, hs, h, hhQ, hh⟩ := exists_C_mul_eq_mapRingHom_of_mem_map ev hfrac hb
  have h0 : mapRingHom ev (C s * b - h) = 0 := by
    rw [map_sub, map_mul, ← hh, coe_mapRingHom, Polynomial.map_C, sub_self]
  have hmem := (mapRingHom_eq_zero_iff ev hker _).mp h0
  have hle : 𝔭.map (C : A →+* A[X]) ≤ Q := Ideal.map_le_iff_le_comap.mpr hQ.ge
  have hsb : C s * b ∈ Q := by simpa only [sub_add_cancel] using Q.add_mem (hle hmem) hhQ
  exact (‹Q.IsPrime›.mem_or_mem hsb).resolve_left fun h1 ↦ hs (hQ ▸ Ideal.mem_comap.mpr h1)

/-- A polynomial over `k` is in the extension of an ideal `Q` as soon as a polynomial over `A` in
`Q` maps to a nonzero constant multiple of it. -/
theorem mem_map_of_C_mul_eq (hker : ∀ a, ev a = 0 ↔ a ∈ 𝔭) {Q : Ideal A[X]} {s : A}
    (hs : s ∉ 𝔭) {g : k[X]} {b : A[X]} (hb : C (ev s) * g = mapRingHom ev b) (hbQ : b ∈ Q) :
    g ∈ Q.map (mapRingHom ev) :=
  mem_of_C_mul_mem (fun h ↦ hs ((hker s).mp h)) (hb ▸ Ideal.mem_map_of_mem _ hbQ)

/-- **The extension of a prime over `𝔭` is prime.** -/
theorem isPrime_map_mapRingHom [𝔭.IsPrime] (hker : ∀ a, ev a = 0 ↔ a ∈ 𝔭)
    (hfrac : ∀ c : k, ∃ a s, s ∉ 𝔭 ∧ c * ev s = ev a) {Q : Ideal A[X]} [Q.IsPrime]
    (hQ : Q.comap (C : A →+* A[X]) = 𝔭) : (Q.map (mapRingHom ev)).IsPrime := by
  have hcm := comap_map_mapRingHom ev hker hfrac hQ
  refine ⟨fun htop ↦ ?_, fun {g g'} hgg' ↦ ?_⟩
  · exact ‹Q.IsPrime›.ne_top (by rw [← hcm, htop, Ideal.comap_top])
  · obtain ⟨s, hs, b, hb⟩ := exists_C_mul_eq_mapRingHom ev hfrac g
    obtain ⟨t, ht, b', hb'⟩ := exists_C_mul_eq_mapRingHom ev hfrac g'
    have hbb : b * b' ∈ Q := by
      rw [← hcm, Ideal.mem_comap, map_mul, ← hb, ← hb']
      have := (Q.map (mapRingHom ev)).mul_mem_left (C (ev s) * C (ev t)) hgg'
      convert this using 1
      ring
    exact (‹Q.IsPrime›.mem_or_mem hbb).imp (mem_map_of_C_mul_eq ev hker hs hb)
      (mem_map_of_C_mul_eq ev hker ht hb')

/-- **Extending the contraction of an ideal of `k[T]` gives it back.** -/
theorem map_comap_mapRingHom [𝔭.IsPrime] (hker : ∀ a, ev a = 0 ↔ a ∈ 𝔭)
    (hfrac : ∀ c : k, ∃ a s, s ∉ 𝔭 ∧ c * ev s = ev a) (P : Ideal k[X]) :
    (P.comap (mapRingHom ev)).map (mapRingHom ev) = P := by
  refine le_antisymm Ideal.map_comap_le fun g hg ↦ ?_
  obtain ⟨s, hs, b, hb⟩ := exists_C_mul_eq_mapRingHom ev hfrac g
  exact mem_map_of_C_mul_eq ev hker hs hb (Ideal.mem_comap.mpr (hb ▸ P.mul_mem_left _ hg))

/-- **The contraction of a proper ideal of `k[T]` lies over `𝔭`.** -/
theorem comap_C_comap_mapRingHom (hker : ∀ a, ev a = 0 ↔ a ∈ 𝔭) {P : Ideal k[X]}
    (hP : P ≠ ⊤) : (P.comap (mapRingHom ev)).comap (C : A →+* A[X]) = 𝔭 := by
  ext s
  rw [Ideal.mem_comap, Ideal.mem_comap, coe_mapRingHom, Polynomial.map_C, ← hker]
  exact ⟨fun h ↦ by_contra fun hne ↦ C_notMem_of_ne_top hP hne h, fun h ↦ by simp [h]⟩

/-- **A strict chain of primes lying over `𝔭` starts at `𝔭 A[T]`.** Extended to `k[T]`, the
smaller prime is a prime strictly contained in a proper ideal, so it is zero, since `k[T]` is a
principal ideal domain; contracting back, it is the kernel `𝔭 A[T]`. -/
theorem eq_map_C_of_le_of_ne [𝔭.IsPrime] (hker : ∀ a, ev a = 0 ↔ a ∈ 𝔭)
    (hfrac : ∀ c : k, ∃ a s, s ∉ 𝔭 ∧ c * ev s = ev a) {Q Q' : Ideal A[X]} [Q.IsPrime]
    [Q'.IsPrime] (hQ : Q.comap (C : A →+* A[X]) = 𝔭) (hQ' : Q'.comap (C : A →+* A[X]) = 𝔭)
    (hle : Q' ≤ Q) (hne : Q' ≠ Q) : Q' = 𝔭.map (C : A →+* A[X]) := by
  have := isPrime_map_mapRingHom ev hker hfrac hQ'
  have hcm := comap_map_mapRingHom ev hker hfrac hQ
  have hcm' := comap_map_mapRingHom ev hker hfrac hQ'
  by_cases hbot : Q'.map (mapRingHom ev) = ⊥
  · rw [← hcm', hbot]
    ext h
    rw [Ideal.mem_comap, Ideal.mem_bot, mapRingHom_eq_zero_iff ev hker]
  · have hmax := IsPrime.to_maximal_ideal hbot
    have hQtop : Q.map (mapRingHom ev) ≠ ⊤ := (isPrime_map_mapRingHom ev hker hfrac hQ).ne_top
    have heq := hmax.eq_of_le hQtop (Ideal.map_mono hle)
    exact absurd (by rw [← hcm', heq, hcm]) hne

/-- **Fractions with denominators off a prime `Q` over `𝔭` are the fractions with denominators off
its extension.** Let `P` be a prime of `k[T]` contracting to `Q`, and let `alg : k[T] →+* L` be a
map to a field. An element `z` of `L` is a fraction `alg (π a) / alg (π b)` with `b ∉ Q` if and
only if it is a fraction `alg g / alg h` with `h ∉ P`: denominators of polynomials over `k` are
cleared by nonzero constants coming from `A`, which lie outside `P`. -/
theorem exists_mul_eq_iff_of_comap_eq [𝔭.IsPrime] (hker : ∀ a, ev a = 0 ↔ a ∈ 𝔭)
    (hfrac : ∀ c : k, ∃ a s, s ∉ 𝔭 ∧ c * ev s = ev a) {L : Type*} [Field L]
    (alg : k[X] →+* L) {P : Ideal k[X]} [P.IsPrime] {Q : Ideal A[X]}
    (hP : P.comap (mapRingHom ev) = Q) (z : L) :
    (∃ a b, b ∉ Q ∧ z * alg (mapRingHom ev b) = alg (mapRingHom ev a)) ↔
      ∃ g h, h ∉ P ∧ z * alg h = alg g := by
  constructor
  · rintro ⟨a, b, hb, h⟩
    exact ⟨mapRingHom ev a, mapRingHom ev b, fun hbP ↦ hb (hP ▸ Ideal.mem_comap.mpr hbP), h⟩
  · rintro ⟨g, h, hh, hz⟩
    obtain ⟨s, hs, a, ha⟩ := exists_C_mul_eq_mapRingHom ev hfrac g
    obtain ⟨t, ht, b, hb⟩ := exists_C_mul_eq_mapRingHom ev hfrac h
    have hC : ∀ c : A, c ∉ 𝔭 → C (ev c) ∉ P := fun c hc ↦
      C_notMem_of_ne_top ‹P.IsPrime›.ne_top fun h0 ↦ hc ((hker c).mp h0)
    refine ⟨a * C t, b * C s, fun hbQ ↦ ?_, ?_⟩
    · have hmem : mapRingHom ev (b * C s) ∈ P := by rwa [← hP] at hbQ
      rw [map_mul, ← hb, coe_mapRingHom, Polynomial.map_C] at hmem
      rcases ‹P.IsPrime›.mem_or_mem hmem with h1 | h1
      · exact (‹P.IsPrime›.mem_or_mem h1).elim (hC t ht) hh
      · exact hC s hs h1
    · simp only [map_mul, ← ha, ← hb]
      simp only [coe_mapRingHom, Polynomial.map_C]
      linear_combination (alg (C (ev t)) * alg (C (ev s))) * hz

/-- **Two subrings of fields identified by an isomorphism of the fields are isomorphic, compatibly
with the inclusions.** -/
theorem exists_ringEquiv_of_mem_range_iff {S B K L : Type*} [CommRing S] [CommRing B] [Field K]
    [Field L] (ρS : S →+* K) (ρB : B →+* L) (hS : Function.Injective ρS)
    (hB : Function.Injective ρB) (η : K ≃+* L) (h : ∀ z, z ∈ ρS.range ↔ η z ∈ ρB.range) :
    ∃ ε : S ≃+* B, ∀ s, ρB (ε s) = η (ρS s) := by
  have hmap : ρS.range.map (η : K →+* L) = ρB.range := by
    ext z
    exact ⟨fun ⟨y, hy, hyz⟩ ↦ hyz ▸ (h y).mp hy, fun hz ↦
      ⟨η.symm z, (h _).mpr (by rwa [RingEquiv.apply_symm_apply]), η.apply_symm_apply z⟩⟩
  let e1 : S ≃+* ρS.range :=
    RingEquiv.ofBijective ρS.rangeRestrict ⟨fun a b hab ↦ hS (congrArg Subtype.val hab),
      ρS.rangeRestrict_surjective⟩
  let e3 : B ≃+* ρB.range :=
    RingEquiv.ofBijective ρB.rangeRestrict ⟨fun a b hab ↦ hB (congrArg Subtype.val hab),
      ρB.rangeRestrict_surjective⟩
  let e2 : ρS.range ≃+* ρB.range :=
    (RingEquiv.subringMap (s := ρS.range) η).trans (RingEquiv.subringCongr hmap)
  refine ⟨e1.trans (e2.trans e3.symm), fun s ↦ ?_⟩
  have h3 : ∀ y : ρB.range, ρB (e3.symm y) = y := fun y ↦
    congrArg Subtype.val (e3.apply_symm_apply y)
  rw [RingEquiv.trans_apply, RingEquiv.trans_apply, h3]
  rfl

end FibreAlgebra

/-! ### Rational functions without zeros or poles -/

section NoZerosNoPoles

attribute [local instance] isDiscreteValuationRing_localizationAtPrime_polynomial

variable {k : Type*} [Field k]

/-- At a closed point `P` of the affine line, the order of a polynomial is trivial if and only if
the polynomial does not vanish at `P`. -/
theorem ordFrac_algebraMap_eq_one_iff (P : Ideal k[X]) [P.IsMaximal] {g : k[X]} (hg : g ≠ 0) :
    Ring.ordFrac (Localization.AtPrime P) (algebraMap k[X] (RatFunc k) g) = 1 ↔ g ∉ P := by
  have hg' : algebraMap k[X] (Localization.AtPrime P) g ≠ 0 :=
    (IsLocalization.injective (Localization.AtPrime P) P.primeCompl_le_nonZeroDivisors).ne_iff'
      (map_zero _) |>.mpr hg
  rw [IsScalarTower.algebraMap_apply k[X] (Localization.AtPrime P) (RatFunc k),
    ordFrac_algebraMap_eq_ofAdd hg']
  constructor
  · intro h hgP
    have hnu : ¬ IsUnit (algebraMap k[X] (Localization.AtPrime P) g) :=
      fun hu ↦ (IsLocalization.AtPrime.isUnit_to_map_iff _ P g).mp hu hgP
    -- a non-unit has nonzero order: otherwise the quotient by it would be zero
    refine (fun h0 : Ring.ord (Localization.AtPrime P)
        (algebraMap k[X] (Localization.AtPrime P) g) = 0 ↦ hnu ?_) ?_
    · have hs : Subsingleton (Localization.AtPrime P ⧸
          Ideal.span {algebraMap k[X] (Localization.AtPrime P) g}) :=
        Module.length_eq_zero_iff.mp h0
      refine Ideal.span_singleton_eq_top.mp ?_
      rw [Ideal.eq_top_iff_one, ← Ideal.Quotient.eq_zero_iff_mem]
      exact Subsingleton.elim _ _
    rw [← WithZero.coe_one, WithZero.coe_inj, ofAdd_eq_one, Nat.cast_eq_zero,
      ENat.toNat_eq_zero] at h
    exact h.resolve_right (Ring.ord_ne_top (mem_nonZeroDivisors_of_ne_zero hg'))
  · intro hgP
    rw [Ring.ord_of_isUnit ((IsLocalization.AtPrime.isUnit_to_map_iff _ P g).mpr hgP)]
    rfl

/-- **A rational function without zeros or poles on the affine line is constant.** If an
irreducible polynomial divided the numerator (resp. the denominator) of `u`, it would not divide
the other, and `u` would have positive (resp. negative) order at the closed point it defines. So
numerator and denominator are units, and the monic denominator is `1`. -/
theorem exists_eq_C_of_ordFrac_eq_one {u : RatFunc k} (hu : u ≠ 0)
    (h : ∀ (P : Ideal k[X]) [P.IsMaximal], Ring.ordFrac (Localization.AtPrime P) u = 1) :
    ∃ c : k, u = algebraMap k (RatFunc k) c := by
  have hn0 := RatFunc.num_ne_zero hu
  have hd0 := u.denom_ne_zero
  have key : ∀ p : k[X], Irreducible p → ¬ p ∣ u.num ∧ ¬ p ∣ u.denom := by
    intro p hp
    have := isMaximal_span_singleton_of_irreducible_polynomial hp
    have hcop := RatFunc.isCoprime_num_denom u
    have hP := h (Ideal.span {p})
    rw [← RatFunc.num_div_denom u, map_div₀] at hP
    by_cases hn : p ∣ u.num
    · have hd : ¬ p ∣ u.denom := fun hd ↦ hp.not_isUnit (hcop.isUnit_of_dvd' hn hd)
      rw [(ordFrac_algebraMap_eq_one_iff _ hd0).mpr (by rwa [Ideal.mem_span_singleton]), div_one,
        ordFrac_algebraMap_eq_one_iff _ hn0, Ideal.mem_span_singleton] at hP
      exact absurd hn hP
    · by_cases hd : p ∣ u.denom
      · rw [(ordFrac_algebraMap_eq_one_iff _ hn0).mpr (by rwa [Ideal.mem_span_singleton]),
          one_div, inv_eq_one, ordFrac_algebraMap_eq_one_iff _ hd0,
          Ideal.mem_span_singleton] at hP
        exact absurd hd hP
      · exact ⟨hn, hd⟩
  have hunit : ∀ q : k[X], q ≠ 0 → (∀ p, Irreducible p → ¬ p ∣ q) → IsUnit q := by
    intro q hq hp
    by_contra hnu
    obtain ⟨p, hp', hpq⟩ := WfDvdMonoid.exists_irreducible_factor hnu hq
    exact hp p hp' hpq
  have hnum := hunit _ hn0 fun p hp ↦ (key p hp).1
  have hden := hunit _ hd0 fun p hp ↦ (key p hp).2
  have hd1 : u.denom = 1 := (RatFunc.monic_denom u).eq_one_of_isUnit hden
  obtain ⟨c, -, hc⟩ := Polynomial.isUnit_iff.mp hnum
  refine ⟨c, ?_⟩
  rw [← RatFunc.num_div_denom u, hd1, map_one, div_one, ← hc, RatFunc.algebraMap_C,
    RatFunc.algebraMap_eq_C]

/-- The elements of `k(T)` coming from the local ring of the affine line at a prime `P` are the
fractions of polynomials with denominator off `P`. -/
theorem mem_range_algebraMap_localizationAtPrime_iff (P : Ideal k[X]) [P.IsPrime]
    (z : RatFunc k) :
    z ∈ (algebraMap (Localization.AtPrime P) (RatFunc k)).range ↔
      ∃ g h, h ∉ P ∧ z * algebraMap k[X] (RatFunc k) h = algebraMap k[X] (RatFunc k) g := by
  constructor
  · rintro ⟨l, rfl⟩
    obtain ⟨⟨g, ⟨h, hh⟩⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl l
    refine ⟨g, h, hh, ?_⟩
    rw [IsScalarTower.algebraMap_apply k[X] (Localization.AtPrime P) (RatFunc k) h,
      IsScalarTower.algebraMap_apply k[X] (Localization.AtPrime P) (RatFunc k) g, ← map_mul,
      IsLocalization.mk'_spec]
  · rintro ⟨g, h, hh, hz⟩
    refine ⟨IsLocalization.mk' (Localization.AtPrime P) g (⟨h, hh⟩ : P.primeCompl), ?_⟩
    have hh0 : algebraMap k[X] (RatFunc k) h ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective k[X] (RatFunc k))).mpr fun h0 ↦
        hh (h0 ▸ P.zero_mem)
    refine mul_right_cancel₀ hh0 ?_
    rw [hz, IsScalarTower.algebraMap_apply k[X] (Localization.AtPrime P) (RatFunc k) h,
      IsScalarTower.algebraMap_apply k[X] (Localization.AtPrime P) (RatFunc k) g, ← map_mul,
      IsLocalization.mk'_spec]

end NoZerosNoPoles

end Stacks.Chow

