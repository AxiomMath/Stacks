/-!
# The Chern class and the Chern character on `K_0(X)`

Let `(S, δ)` be as in Situation 02QL and let `X` be locally of finite type over `S` whose
irreducible components are quasi-compact (for instance `X` quasi-compact: the components are
closed). Stacks 0FEU takes `Z = X` in Remarks 0FES and 0FET: `D_{X, perf}(𝒪_X) = D_perf(𝒪_X)`,
so `K_0(D_{X, perf}(𝒪_X)) = K_0(D_perf(𝒪_X)) = K_0(X)`, and the Chern classes give maps

  `c : K_0(X) ⟶ ∏ A^i(X)`  and  `ch : K_0(X) ⟶ ∏ A^i(X) ⊗ 𝐐`,

constructed — as the remark says one may — directly from Definition 0F9E and Lemma 0F9F: `[E]`
goes to the total Chern class `c(E)` (`Stacks.Chow.perfectChernClass`), resp. the Chern character
`ch(E)` (`Stacks.Chow.perfectChernCharacter`), of the perfect object `E`, whose Chern classes are
defined by Stacks 0GUE (3); `c` is extended multiplicatively and `ch` additively, which is
possible by Stacks 0F9F (3). Composed with the canonical map `K_0(Vect(X)) ⟶ K_0(X)`,
`[ℰ] ↦ [ℰ[0]]`, they are the maps of Stacks 0FEL and 0FEM.

## Main definitions

* `Stacks.Chow.vectorBundleKZeroToPerfect` — the map `K_0(Vect(X)) ⟶ K_0(X)`, `[ℰ] ↦ [ℰ[0]]`.
* `Stacks.Chow.perfectKZeroChernHom` — `c` as a homomorphism to the units of `∏ A^i(X)`.
* `Stacks.Chow.perfectKZeroChernClass` — `c : K_0(X) ⟶ ∏ A^i(X)`.
* `Stacks.Chow.perfectKZeroChernCharacter` — `ch : K_0(X) ⟶ ∏ A^i(X) ⊗ 𝐐`.
* `CategoryTheory.Pretriangulated.K0.liftOfDistinguished` — the universal property of `K_0`.

## Main results

* `Stacks.Chow.commute_perfectChernClass` — total Chern classes of objects of `D(𝒪_X)` commute.
* `Stacks.Chow.perfectChernClass_singleFunctor`, `Stacks.Chow.perfectChernCharacter_singleFunctor`
  — `c(ℰ[0]) = c(ℰ)` and `ch(ℰ[0]) = ch(ℰ)` for `ℰ` finite locally free of any rank.
* `Stacks.Chow.perfectKZeroChernClass_vectorBundleKZeroToPerfect`,
  `Stacks.Chow.perfectKZeroChernCharacter_comp_vectorBundleKZeroToPerfect` — the two diagrams of
  the remark commute.
* `Stacks.Chow.perfectKZero_chernMaps_spec` — **Stacks 0FEU**, the remark in full.

## Implementation notes

The ring `∏ A^i(X)` is not known to be commutative, so `c` is a homomorphism into the subgroup of
its units generated by the classes `c(E)`, which is commutative by
`Stacks.Chow.commute_perfectChernClass`, exactly as for `Stacks.Chow.totalChernKGroupHom`.

The derived-category statements are at the standard model of `D(𝒪_X)`, which every input
(`Stacks.Chow.perfectChernClass`, Stacks 0F9F,
`Stacks.Perfect.BoundedLocallyFreeComplexes.PerfectDerivedCategory`) is stated at.

## References

* [Stacks Project, Tag 0FEU](https://stacks.math.columbia.edu/tag/0FEU)
* [Stacks Project, Tag 0F9E](https://stacks.math.columbia.edu/tag/0F9E)
* [Stacks Project, Tag 0F9F](https://stacks.math.columbia.edu/tag/0F9F)
* [Stacks Project, Tag 0FEL](https://stacks.math.columbia.edu/tag/0FEL)
* [Stacks Project, Tag 0FEM](https://stacks.math.columbia.edu/tag/0FEM)
* [Stacks Project, Tag 0FDK](https://stacks.math.columbia.edu/tag/0FDK)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open Stacks.Perfect.BoundedLocallyFreeComplexes (PerfectDerivedCategory)

universe u

/-! ### Homomorphisms out of `K₀` of a pretriangulated category -/

namespace CategoryTheory.Pretriangulated.K0

variable {𝒞 : Type*} [Category 𝒞] [HasZeroObject 𝒞] [HasShift 𝒞 ℤ] [Preadditive 𝒞]
  [∀ n : ℤ, (shiftFunctor 𝒞 n).Additive] [Pretriangulated 𝒞] {A : Type*} [AddCommGroup A]

/-- **The universal property of `K₀`.** A function on the objects of a pretriangulated category
which is additive along distinguished triangles, `f(Y) = f(X) + f(Z)` for every distinguished
triangle `X ⟶ Y ⟶ Z ⟶ X⟦1⟧`, induces a homomorphism `K₀(𝒞) ⟶ A` sending `[X]` to `f(X)`. -/
def liftOfDistinguished (f : 𝒞 → A)
    (hf : ∀ T ∈ distTriang 𝒞, f T.obj₂ = f T.obj₁ + f T.obj₃) : K0 𝒞 →+ A :=
  QuotientAddGroup.lift _ (FreeAbelianGroup.lift f) fun x hx ↦ by
    refine (AddSubgroup.closure_le (K := (FreeAbelianGroup.lift f).ker)).2 ?_ hx
    rintro _ ⟨T, hT, rfl⟩
    rw [SetLike.mem_coe, AddMonoidHom.mem_ker, map_sub, map_sub, FreeAbelianGroup.lift_apply_of,
      FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of, hf T hT]
    abel

/-- `K0.liftOfDistinguished f` sends `[X]` to `f(X)`. -/
@[simp]
theorem liftOfDistinguished_cls (f : 𝒞 → A)
    (hf : ∀ T ∈ distTriang 𝒞, f T.obj₂ = f T.obj₁ + f T.obj₃) (X : 𝒞) :
    liftOfDistinguished f hf (cls X) = f X :=
  FreeAbelianGroup.lift_apply_of _ _

end CategoryTheory.Pretriangulated.K0

namespace Stacks.Chow



/-! ### A finite locally free module placed in degree zero -/

section Single

variable {X Z : Scheme.{u}} (h : Z ⟶ X) (M : X.Modules) (r : ℕ)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
    ((Scheme.Modules.pullback h).obj M) r]

/-- If `h^*ℰ` has constant rank `r`, the termwise pullback `h^*(ℰ[0])` has the constant ranks
`r` in degree `0` and `0` elsewhere. -/
theorem isFiniteLocallyFreeOfRank_pullbackComplex_singleZero (n : ℤ) :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((pullbackComplex h (singleZero M)).X n) (Finsupp.single 0 r n) := by
  suffices ∀ m : ℕ, m = Finsupp.single 0 r n →
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        ((pullbackComplex h (singleZero M)).X n) m from this _ rfl
  rintro m rfl
  by_cases hn : n = 0
  · subst hn
    simp only [Finsupp.single_eq_same]
    exact AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u}
      ((Scheme.Modules.pullback h).mapIso
        (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M)).symm inferInstance
  · simp only [Finsupp.single_eq_of_ne hn]
    exact isFiniteLocallyFreeOfRank_zero_of_isZero (Functor.map_isZero _
      (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 M n hn))

variable (C : ChowSituation.{u}) {sX : X ⟶ C.S} [LocallyOfFiniteType sX] {sZ : Z ⟶ C.S}
  [LocallyOfFiniteType sZ] [LocallyOfFiniteType h]

/-- **The restriction of `c(ℰ[0])`** along a morphism over which `ℰ` has constant rank `r` is the
total Chern class of `h^*ℰ` of rank `r`. -/
theorem res_complexChern_singleZero (hs : h ≫ sX = sZ)
    (hP : IsLocallyBoundedFiniteLocallyFree (singleZero M)) :
    TotalChowClass.res h hs (complexChern C sX hP) =
      totalChern C sZ ((Scheme.Modules.pullback h).obj M) r := by
  rw [res_complexChern_eq_complexChernBounded C sX hP h hs (Finsupp.single 0 r)
      (isFiniteLocallyFreeOfRank_pullbackComplex_singleZero h M r),
    complexChernBounded_eq_prod C sZ _ _ _ {0} fun n hn ↦
      Finsupp.single_eq_of_ne (by simpa using hn)]
  let := isFiniteLocallyFreeOfRank_pullbackComplex_singleZero h M r 0
  simp only [complexChernProd, Finset.sort_singleton, List.map_cons, List.map_nil,
    List.prod_cons, List.prod_nil, mul_one, complexChernFactor, Int.negOnePow_zero,
    Units.val_one, zpow_one, val_totalChernUnit]
  exact totalChern_congr C sZ ((Scheme.Modules.pullback h).mapIso
    (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M)) Finsupp.single_eq_same

end Single

