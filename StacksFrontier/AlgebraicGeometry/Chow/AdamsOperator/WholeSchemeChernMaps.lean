/-! ### Total Chern classes of objects whose Chern classes are defined commute -/

section Commute

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]

/-- **Total Chern classes commute.** For objects `E`, `E'` of `D(𝒪_X)` whose Chern classes are
defined, `c(E) c(E') = c(E') c(E)` in `∏_{p ≥ 0} A^p(X)`: their homogeneous components commute,
and a total class is determined by its operations on the test schemes, which are the
convolutions of the operations of the homogeneous components. -/
theorem commute_perfectChernClass {E E' : DerivedCategory X.Modules}
    (hE : HasDefinedChernClasses E) (hE' : HasDefinedChernClasses E') :
    Commute (perfectChernClass C sX hE) (perfectChernClass C sX hE') := by
  refine TotalChowClass.ext_op fun g _ ↦ ?_
  rw [TotalChowClass.op_mul, TotalChowClass.op_mul]
  refine commute_of_commute_homComponent fun i j ↦ ?_
  have h := congrArg (fun x ↦ TotalChowClass.op x g)
    (commute_homComponent_perfectChernClass C sX hE hE' i j).eq
  simp only [TotalChowClass.op_mul, TotalChowClass.op_homComponent] at h
  exact h

end Commute

section SingleFunctor

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
  (M : X.Modules) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} M]

/-- **`c(ℰ[0]) = c(ℰ)`** for the complex `ℰ[0]` of a finite locally free module of any rank: both
restrict on each rank locus `X_r` to the total Chern class of `ℰ|_{X_r}` of rank `r`. -/
theorem complexChern_singleZero_eq_totalChernClassOfModule
    (hP : IsLocallyBoundedFiniteLocallyFree (singleZero M)) :
    complexChern C sX hP = totalChernClassOfModule C sX M := by
  refine TotalChowClass.eq_of_res_eq (isClopenDecomposition_rankLociFamily M) fun ρ ↦ ?_
  have := isFiniteLocallyFreeOfRank_pullback_rankLociFamily M ρ
  rw [res_complexChern_singleZero (rankLociFamily M ρ).ι M ρ.down C rfl hP,
    res_totalChernClassOfModule_rankLocus]

/-- `ℰ[0]` is a locally bounded complex of finite locally free modules. -/
theorem isLocallyBoundedFiniteLocallyFree_singleZero_of_isFiniteLocallyFree :
    IsLocallyBoundedFiniteLocallyFree (singleZero M) :=
  isLocallyBoundedFiniteLocallyFree_singleZero M ‹_›

/-- The envelope presentation of `ℰ[0]` by itself, along the identity of `X`. -/
abbrev singleFunctorPresentation :
    EnvelopePresentation ((DerivedCategory.singleFunctor X.Modules 0).obj M) :=
  ⟨X, 𝟙 X, ⟨inferInstance, isCompletelyDecomposed_id X⟩, singleZero M,
    isLocallyBoundedFiniteLocallyFree_singleZero_of_isFiniteLocallyFree M,
    ⟨(Cohomology.DerivedPullbackAlongIso.derivedPullbackIdIso X.toRingedSpace).app _ ≪≫
      (DerivedCategory.singleFunctorIsoCompQ X.Modules 0).app M⟩⟩

/-- **The total Chern class of `ℰ[0]` is the total Chern class `c(ℰ)` of Stacks 0ESW**, for a
finite locally free module `ℰ` of any rank placed in degree `0`. -/
theorem perfectChernClass_singleFunctor
    (hE : HasDefinedChernClasses ((DerivedCategory.singleFunctor X.Modules 0).obj M)) :
    perfectChernClass C sX hE = totalChernClassOfModule C sX M :=
  (perfectChernClass_eq_complexChern C sX hE
      (isLocallyBoundedFiniteLocallyFree_singleZero_of_isFiniteLocallyFree M)
      ((DerivedCategory.singleFunctorIsoCompQ X.Modules 0).app M).symm).trans
    (complexChern_singleZero_eq_totalChernClassOfModule C sX M _)

/-- **The rank of `ℰ[0]`** restricts, along a morphism over which `ℰ` has constant rank `r`, to
`r` times the unit. -/
theorem res_perfectRankClass_singleFunctor
    (hE : HasDefinedChernClasses ((DerivedCategory.singleFunctor X.Modules 0).obj M))
    {Z : Scheme.{u}} {sZ : Z ⟶ C.S} [LocallyOfFiniteType sZ] (h : Z ⟶ X)
    [LocallyOfFiniteType h] (hs : h ≫ sX = sZ) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback h).obj M) r] :
    TotalChowClass.res h hs (perfectRankClass C sX hE) = (r : ℤ) • 1 := by
  rcases isEmpty_or_nonempty Z with hZ | hZ
  · have := TotalChowClass.subsingleton_of_isEmpty (C := C) sZ
    exact Subsingleton.elim _ _
  have hs' : h ≫ (𝟙 X ≫ sX) = sZ := by rw [Category.id_comp, hs]
  rw [TotalChowClass.res_congr (Category.comp_id h).symm hs (by rw [Category.assoc]; exact hs'),
    ← TotalChowClass.res_res (𝟙 X) rfl h hs',
    res_perfectRankClass C sX hE (singleFunctorPresentation M),
    res_complexRankClass_of_constant_rank C (𝟙 X ≫ sX) _ h hs' (Finsupp.single 0 r)
      (isFiniteLocallyFreeOfRank_pullbackComplex_singleZero h M r),
    finsum_eq_single _ 0 fun n hn ↦ by rw [Finsupp.single_eq_of_ne hn]; simp]
  simp

/-- **The power sums of `ℰ[0]` are the power sums `P_p(ℰ)` of Stacks 0ESX**, for a finite locally
free module `ℰ` of any rank placed in degree `0`: on each rank locus both are Newton's recursion
at the rank and the Chern classes of `ℰ|_{X_r}`. -/
theorem perfectPowerSum_singleFunctor
    (hE : HasDefinedChernClasses ((DerivedCategory.singleFunctor X.Modules 0).obj M)) (p : ℕ) :
    perfectPowerSum C sX hE p = modulePowerSumArbitraryRank C sX M p := by
  refine eq_modulePowerSumArbitraryRank_of_res_eq C sX M p fun r ↦ ?_
  have := isFiniteLocallyFreeOfRank_pullback_rankLocus M r
  rw [perfectPowerSum, map_newtonPowerSum,
    res_perfectRankClass_singleFunctor C sX M hE (rankLocus M r).ι rfl r, modulePowerSum]
  congr 1
  funext i
  rw [TotalChowClass.res_homComponent, perfectChernClass_singleFunctor,
    res_totalChernClassOfModule_of_rank C sX M _ rfl r]

/-- **The Chern character of `ℰ[0]` is the Chern character `ch(ℰ)` of Stacks 0ESX**, for a finite
locally free module `ℰ` of any rank placed in degree `0`. -/
theorem perfectChernCharacter_singleFunctor
    (hE : HasDefinedChernClasses ((DerivedCategory.singleFunctor X.Modules 0).obj M)) :
    perfectChernCharacter C sX hE = moduleChernCharacter C sX M :=
  funext fun p ↦ by
    change ((Nat.factorial p : ℚ)⁻¹) ⊗ₜ[ℤ] perfectPowerSum C sX hE p p =
      ((Nat.factorial p : ℚ)⁻¹) ⊗ₜ[ℤ] modulePowerSumArbitraryRank C sX M p p
    rw [perfectPowerSum_singleFunctor]

end SingleFunctor

/-! ### The maps `c` and `ch` on `K_0(X)` -/

section KZero

section Comparison

variable (X : Scheme.{u})

/-- **A finite locally free module in degree zero is a perfect object of `D(𝒪_X)`**, in the model
of `D(𝒪_X)` that `Stacks.Perfect.BoundedLocallyFreeComplexes.PerfectDerivedCategory` uses. The
perfect complex is the module in degree zero, by
`AlgebraicGeometry.isPerfectComplex_single_of_isFiniteLocallyFree`. -/
theorem isPerfect_singleFunctor_standard (M : X.Modules)
    (hM : Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M) :
    Stacks.Cohomology.PerfectComplexes.IsPerfect (X := X.toRingedSpace)
      ((DerivedCategory.singleFunctor X.Modules 0).obj M) :=
  ⟨(CochainComplex.singleFunctor X.Modules 0).obj M,
    isPerfectComplex_single_of_isFiniteLocallyFree X M hM,
    ⟨((DerivedCategory.singleFunctorIsoCompQ X.Modules 0).app M).symm⟩⟩

open Classical in
/-- The class `[ℰ[0]] ∈ K_0(X)` of a finite locally free module placed in degree zero, and `0`
for every other module. -/
def vectorBundleKZeroToPerfectFun (M : X.Modules) : K0 (PerfectDerivedCategory X) :=
  if hM : Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M then
    K0.cls ⟨(DerivedCategory.singleFunctor X.Modules 0).obj M,
      isPerfect_singleFunctor_standard X M hM⟩
  else 0

/-- **The canonical map `K_0(Vect(X)) ⟶ K_0(X) = K_0(D_perf(𝒪_X))`**, sending a finite locally
free module to itself placed in degree `0`, in the model
`Stacks.Perfect.BoundedLocallyFreeComplexes.PerfectDerivedCategory` of perfect objects. It is
well defined because a short exact sequence of finite locally free modules gives a distinguished
triangle of perfect objects, and `Stacks.Chow.eq_vectorBundleKZeroToPerfect` shows it is the
only additive map with this value on generators. -/
def vectorBundleKZeroToPerfect : VectorBundleKZero X →+ K0 (PerfectDerivedCategory X) :=
  VectorBundleKZero.liftAddHom (vectorBundleKZeroToPerfectFun X)
    (fun M hM ↦ dite_eq_right hM)
    (fun {E F G} f g w hE hF hG hmono hepi hexact ↦ by
      have hS : (ShortComplex.mk f g w).ShortExact := ⟨hexact⟩
      rw [vectorBundleKZeroToPerfectFun, dite_eq_left hF,
        vectorBundleKZeroToPerfectFun, dite_eq_left hE,
        vectorBundleKZeroToPerfectFun, dite_eq_left hG]
      exact K0.cls_eq_add_of_distinguished_of_prop _ _ _ _
        ((DerivedCategory.singleFunctor X.Modules 0).map f)
        ((DerivedCategory.singleFunctor X.Modules 0).map g) hS.singleδ
        hS.singleTriangle_distinguished)

/-- `[ℰ] ↦ [ℰ[0]]`. -/
theorem vectorBundleKZeroToPerfect_classOf (M : X.Modules)
    (hM : Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M) :
    vectorBundleKZeroToPerfect X (VectorBundleKZero.classOf X M) =
      K0.cls ⟨(DerivedCategory.singleFunctor X.Modules 0).obj M,
        isPerfect_singleFunctor_standard X M hM⟩ :=
  (VectorBundleKZero.liftAddHom_classOf _ _ _ M).trans (dite_eq_left hM)

/-- **The map is canonical**: it is the only additive map `K_0(Vect(X)) ⟶ K_0(X)` sending the
class of every finite locally free module `ℰ` to the class of `ℰ[0]`. -/
theorem eq_vectorBundleKZeroToPerfect (φ : VectorBundleKZero X →+ K0 (PerfectDerivedCategory X))
    (hφ : ∀ (M : X.Modules)
      (hM : Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M),
      φ (VectorBundleKZero.classOf X M) =
        K0.cls ⟨(DerivedCategory.singleFunctor X.Modules 0).obj M,
          isPerfect_singleFunctor_standard X M hM⟩) :
    φ = vectorBundleKZeroToPerfect X :=
  VectorBundleKZero.addHom_ext fun M hM ↦
    (hφ M hM).trans (vectorBundleKZeroToPerfect_classOf X M hM).symm

end Comparison

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
  (hqc : ∀ Z ∈ irreducibleComponents X, IsCompact Z)

include C sX hqc in
/-- When the irreducible components of `X` are quasi-compact, the Chern classes of every perfect
object of `D(𝒪_X)` are defined (Stacks 0GUE (3)). -/
theorem hasDefinedChernClasses_perfectDerivedCategory (E : PerfectDerivedCategory X) :
    HasDefinedChernClasses E.obj :=
  hasDefinedChernClasses_of_isCompact_irreducibleComponents C sX hqc E.obj E.property

/-- **Stacks 0F9F (3) inside `D_perf(𝒪_X)`.** A distinguished triangle of perfect objects has
`c(E₂) = c(E₁) c(E₃)` and `ch(E₂) = ch(E₁) + ch(E₃)`. -/
theorem perfectChernClass_mul_and_chernCharacter_add_of_distinguished
    (T : Triangle (PerfectDerivedCategory X)) (hT : T ∈ distTriang (PerfectDerivedCategory X)) :
    perfectChernClass C sX (hasDefinedChernClasses_perfectDerivedCategory C sX hqc T.obj₂) =
        perfectChernClass C sX (hasDefinedChernClasses_perfectDerivedCategory C sX hqc T.obj₁) *
          perfectChernClass C sX (hasDefinedChernClasses_perfectDerivedCategory C sX hqc T.obj₃) ∧
      perfectChernCharacter C sX (hasDefinedChernClasses_perfectDerivedCategory C sX hqc T.obj₂) =
        perfectChernCharacter C sX (hasDefinedChernClasses_perfectDerivedCategory C sX hqc T.obj₁) +
          perfectChernCharacter C sX
            (hasDefinedChernClasses_perfectDerivedCategory C sX hqc T.obj₃) := by
  obtain ⟨_, _, _, hc, hch, -, -⟩ := triangleChernAdditive_of_isCompact_irreducibleComponents C sX
    ((ObjectProperty.ι _).mapTriangle.obj T) hT T.obj₁.property T.obj₂.property hqc
  exact ⟨hc, hch⟩

/-- The total Chern class `c(E)` of a perfect object, as a unit of `∏_{p ≥ 0} A^p(X)`. -/
def perfectChernUnit (E : PerfectDerivedCategory X) : (TotalChowClass C sX)ˣ :=
  (TotalChowClass.isUnit_of_apply_zero (perfectChernClass_apply_zero C sX
    (hasDefinedChernClasses_perfectDerivedCategory C sX hqc E))).unit

/-- The unit `Stacks.Chow.perfectChernUnit` is the total Chern class. -/
theorem val_perfectChernUnit (E : PerfectDerivedCategory X) :
    (perfectChernUnit C sX hqc E : TotalChowClass C sX) =
      perfectChernClass C sX (hasDefinedChernClasses_perfectDerivedCategory C sX hqc E) :=
  rfl

/-- **The group generated by the total Chern classes of perfect objects**, a commutative
subgroup of the units of `∏_{p ≥ 0} A^p(X)`. -/
def perfectChernUnitGroup : Subgroup (TotalChowClass C sX)ˣ :=
  Subgroup.closure (Set.range (perfectChernUnit C sX hqc))

/-- The group generated by the total Chern classes of perfect objects is commutative. -/
instance : CommGroup (perfectChernUnitGroup C sX hqc) :=
  have : IsMulCommutative (perfectChernUnitGroup C sX hqc) :=
    Subgroup.isMulCommutative_closure (by
      rintro _ ⟨E, rfl⟩ _ ⟨F, rfl⟩ -
      exact Units.ext (commute_perfectChernClass C sX _ _).eq)
  { mul_comm := this.is_comm.comm }

/-- `c(E)` in the group generated by the total Chern classes of perfect objects, written
additively. -/
def perfectChernKFun (E : PerfectDerivedCategory X) : Additive (perfectChernUnitGroup C sX hqc) :=
  Additive.ofMul ⟨perfectChernUnit C sX hqc E, Subgroup.subset_closure ⟨E, rfl⟩⟩

/-- **The total Chern class through `K_0(X) = K_0(D_perf(𝒪_X))`**, into the group generated by the
total Chern classes of perfect objects; well defined by Stacks 0F9F. -/
def perfectChernKHom :
    K0 (PerfectDerivedCategory X) →+ Additive (perfectChernUnitGroup C sX hqc) :=
  K0.liftOfDistinguished (perfectChernKFun C sX hqc) fun T hT ↦
    congrArg Additive.ofMul (Subtype.ext (Units.ext
      (perfectChernClass_mul_and_chernCharacter_add_of_distinguished C sX hqc T hT).1))

/-- `Stacks.Chow.perfectChernKHom` sends `[E]` to `c(E)`. -/
theorem perfectChernKHom_cls (E : PerfectDerivedCategory X) :
    perfectChernKHom C sX hqc (K0.cls E) = perfectChernKFun C sX hqc E :=
  K0.liftOfDistinguished_cls _ _ E

/-- **The Chern class map `c : K_0(X) ⟶ ∏_{p ≥ 0} A^p(X)`**, as a homomorphism to the group of
units of `∏_{p ≥ 0} A^p(X)` written additively. -/
def perfectKZeroChernHom : K0 (PerfectDerivedCategory X) →+ Additive (TotalChowClass C sX)ˣ :=
  (MonoidHom.toAdditive (perfectChernUnitGroup C sX hqc).subtype).comp (perfectChernKHom C sX hqc)

/-- **Stacks 0FEU, the Chern class map `c : K_0(X) ⟶ ∏_{i ≥ 0} A^i(X)`**, sending `[E]` to the
total Chern class `c(E)` of Stacks 0F9E and sums to products. -/
@[stacks 0FEU "the map c : K_0(X) -> prod A^i(X), [E] |-> c(E) extended multiplicatively, built \
directly from Definition 0F9E and Lemma 0F9F as the remark allows; X has quasi-compact \
irreducible components"]
def perfectKZeroChernClass (α : K0 (PerfectDerivedCategory X)) : TotalChowClass C sX :=
  ((Additive.toMul (perfectKZeroChernHom C sX hqc α) : (TotalChowClass C sX)ˣ) :
    TotalChowClass C sX)

/-- `c([E]) = c(E)`. -/
theorem perfectKZeroChernClass_cls (E : PerfectDerivedCategory X)
    (hE : HasDefinedChernClasses E.obj) :
    perfectKZeroChernClass C sX hqc (K0.cls E) = perfectChernClass C sX hE := by
  rw [perfectKZeroChernClass, perfectKZeroChernHom, AddMonoidHom.comp_apply,
    perfectChernKHom_cls]
  rfl

/-- `c(α + β) = c(α) c(β)`. -/
theorem perfectKZeroChernClass_add (α β : K0 (PerfectDerivedCategory X)) :
    perfectKZeroChernClass C sX hqc (α + β) =
      perfectKZeroChernClass C sX hqc α * perfectKZeroChernClass C sX hqc β := by
  rw [perfectKZeroChernClass, map_add, toMul_add, Units.val_mul]
  rfl

/-- **Stacks 0FEU, the Chern character `ch : K_0(X) ⟶ ∏_{i ≥ 0} A^i(X) ⊗ 𝐐`**, additive and
sending `[E]` to `ch(E)`; well defined by Stacks 0F9F. -/
@[stacks 0FEU "the map ch : K_0(X) -> prod A^i(X) tensor Q, [E] |-> ch(E) extended additively, \
built directly from Definition 0F9E and Lemma 0F9F as the remark allows"]
def perfectKZeroChernCharacter :
    K0 (PerfectDerivedCategory X) →+ fullRationalChowCohomology C (gysinSystemOfInvertible C) sX :=
  K0.liftOfDistinguished
    (fun E ↦ perfectChernCharacter C sX (hasDefinedChernClasses_perfectDerivedCategory C sX hqc E))
    fun T hT ↦ (perfectChernClass_mul_and_chernCharacter_add_of_distinguished C sX hqc T hT).2

/-- `ch([E]) = ch(E)`. -/
theorem perfectKZeroChernCharacter_cls (E : PerfectDerivedCategory X)
    (hE : HasDefinedChernClasses E.obj) :
    perfectKZeroChernCharacter C sX hqc (K0.cls E) = perfectChernCharacter C sX hE :=
  K0.liftOfDistinguished_cls _ _ E

/-- **The first diagram of Stacks 0FEU commutes**: `c : K_0(X) ⟶ ∏ A^i(X)` composed with
`K_0(Vect(X)) ⟶ K_0(X)` is the Chern class map of Stacks 0FEL. -/
theorem perfectKZeroChernClass_vectorBundleKZeroToPerfect (α : VectorBundleKZero X) :
    perfectKZeroChernClass C sX hqc (vectorBundleKZeroToPerfect X α) =
      totalChernKGroupMap C sX α := by
  refine congrFun (eq_totalChernKGroupMap C sX
    (fun β ↦ perfectKZeroChernClass C sX hqc (vectorBundleKZeroToPerfect X β)) (fun E _ ↦ ?_)
    fun β γ ↦ by rw [map_add, perfectKZeroChernClass_add]) α
  rw [vectorBundleKZeroToPerfect_classOf X E inferInstance,
    perfectKZeroChernClass_cls C sX hqc _
      (hasDefinedChernClasses_perfectDerivedCategory C sX hqc _)]
  exact perfectChernClass_singleFunctor C sX E _

/-- **The second diagram of Stacks 0FEU commutes**: `ch : K_0(X) ⟶ ∏ A^i(X) ⊗ 𝐐` composed with
`K_0(Vect(X)) ⟶ K_0(X)` is the Chern character map of Stacks 0FEM. -/
theorem perfectKZeroChernCharacter_comp_vectorBundleKZeroToPerfect :
    (perfectKZeroChernCharacter C sX hqc).comp (vectorBundleKZeroToPerfect X) =
      (chernCharacterRingHom C sX).toAddMonoidHom := by
  refine VectorBundleKZero.addHom_ext fun E hE ↦ ?_
  rw [AddMonoidHom.comp_apply, vectorBundleKZeroToPerfect_classOf X E hE,
    perfectKZeroChernCharacter_cls C sX hqc _
    (hasDefinedChernClasses_perfectDerivedCategory C sX hqc _)]
  exact (perfectChernCharacter_singleFunctor C sX E _).trans
    (chernCharacterRingHom_classOf C sX E).symm

/-- **Stacks 0FEU.** Let `X` be locally of finite type over the base of chapter 42, with
quasi-compact irreducible components (e.g. `X` quasi-compact). Then

1. `D_{X, perf}(𝒪_X) = D_perf(𝒪_X)`, and `K_0(D_{X, perf}(𝒪_X)) ≅ K_0(D_perf(𝒪_X)) = K_0(X)`
   compatibly with classes of objects;
2. the Chern classes give `c : K_0(X) ⟶ ∏ A^i(X)`, `[E] ↦ c(E)`, with `c(α + β) = c(α) c(β)`;
3. the Chern character gives the additive `ch : K_0(X) ⟶ ∏ A^i(X) ⊗ 𝐐`, `[E] ↦ ch(E)`;
4. `c` composed with `K_0(Vect(X)) ⟶ K_0(X)` is the map `c` of Stacks 0FEL; and
5. `ch` composed with `K_0(Vect(X)) ⟶ K_0(X)` is the map `ch` of Stacks 0FEM. -/
@[stacks 0FEU "the whole remark: D_{X,perf} = D_perf, K_0(D_{X,perf}) = K_0(X), the maps c and \
ch on K_0(X), and the commutativity of both triangles with K_0(Vect(X)) -> K_0(X)"]
theorem perfectKZero_chernMaps_spec :
    AlgebraicGeometry.supportedPerfectDerivedCategory (𝟙 X) = PerfectDerivedCategory X ∧
    (∀ K : AlgebraicGeometry.supportedPerfectDerivedCategory (𝟙 X),
      AlgebraicGeometry.supportedPerfectKZeroEquiv X (K0.cls K) =
        K0.cls (⟨K.obj, K.property.1⟩ : PerfectDerivedCategory X)) ∧
    (∀ (E : PerfectDerivedCategory X) (hE : HasDefinedChernClasses E.obj),
      perfectKZeroChernClass C sX hqc (K0.cls E) = perfectChernClass C sX hE) ∧
    (∀ α β : K0 (PerfectDerivedCategory X), perfectKZeroChernClass C sX hqc (α + β) =
      perfectKZeroChernClass C sX hqc α * perfectKZeroChernClass C sX hqc β) ∧
    (∀ (E : PerfectDerivedCategory X) (hE : HasDefinedChernClasses E.obj),
      perfectKZeroChernCharacter C sX hqc (K0.cls E) = perfectChernCharacter C sX hE) ∧
    (∀ α : VectorBundleKZero X, perfectKZeroChernClass C sX hqc (vectorBundleKZeroToPerfect X α) =
      totalChernKGroupMap C sX α) ∧
    (perfectKZeroChernCharacter C sX hqc).comp (vectorBundleKZeroToPerfect X) =
      (chernCharacterRingHom C sX).toAddMonoidHom :=
  ⟨AlgebraicGeometry.supportedPerfectDerivedCategory_id X,
    AlgebraicGeometry.supportedPerfectKZeroEquiv_cls X,
    perfectKZeroChernClass_cls C sX hqc, perfectKZeroChernClass_add C sX hqc,
    perfectKZeroChernCharacter_cls C sX hqc,
    perfectKZeroChernClass_vectorBundleKZeroToPerfect C sX hqc,
    perfectKZeroChernCharacter_comp_vectorBundleKZeroToPerfect C sX hqc⟩

end KZero

end Stacks.Chow

