module

public import StacksFrontier.AlgebraicGeometry.Chow.ZeroSchemePullback.ZeroSchemeIdeal
public import StacksFrontier.AlgebraicGeometry.RegularSectionSequence.Basic
import all StacksFrontier.AlgebraicGeometry.Chow.ZeroSchemePullback.ZeroSchemeIdeal

/-!
# The defining ideal of the zero scheme of a section of a finitely presented module

For a global section `s` of a finitely presented `𝒪_X`-module `L` and an affine open `U`, the
ideal of the zero scheme of `s` on `U` is generated by the values `φ (s|_U)` of the
`Γ(X, U)`-linear functionals on `Γ(L, U)`. This extends `Stacks.Divisors.zeroScheme_ideal`, where
`L` is invertible, to a finitely presented `L`: the only input the computation uses is that the
sections of `L` over an affine open form a finitely presented module.

## Main results

* `Stacks.Divisors.evalSpan_map_basicOpen_of_isFinitePresentation` — the ideal of coordinates of
  a section commutes with restriction to a principal open of an affine open.
* `Stacks.RegularSectionSequence.zeroScheme_ideal` — the defining ideal of the zero scheme on an
  affine open.

## References

* [Stacks Project, Tag 02OQ](https://stacks.math.columbia.edu/tag/02OQ)
* [Stacks Project, Tag 01P7](https://stacks.math.columbia.edu/tag/01P7)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.Divisors

/-- The ideal of coordinates of a section of a finitely presented module commutes with
restriction to a principal open of an affine open: the restriction map is a localization both of
the ring of functions ([Stacks, Tag 01P7] for the structure sheaf) and of the module of sections
of `L` ([Stacks, Tag 01P7] for quasi-coherent modules). -/
theorem evalSpan_map_basicOpen_of_isFinitePresentation (X : Scheme.{u}) (L : X.Modules)
    [L.IsFinitePresentation]
    (s : Γ(L, ⊤)) (U : X.affineOpens) (f : Γ(X, U.1)) :
    Ideal.map (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom
        (Ideal.span {a : Γ(X, U.1) | ∃ φ : Γ(L, U.1) →ₗ[Γ(X, U.1)] Γ(X, U.1),
          a = φ (L.presheaf.map (homOfLE le_top).op s)}) =
      Ideal.span {a : Γ(X, X.basicOpen f) |
        ∃ φ : Γ(L, X.basicOpen f) →ₗ[Γ(X, X.basicOpen f)] Γ(X, X.basicOpen f),
          a = φ (L.presheaf.map (homOfLE le_top).op s)} := by
  have : L.IsQuasicoherent := SheafOfModules.instIsQuasicoherentOfIsFinitePresentation L
  let : IsLocalization (Submonoid.powers f) Γ(X, X.basicOpen f) :=
    AlgebraicGeometry.isLocalization_basicOpen_of_qcqs U.2.isCompact U.2.isQuasiSeparated f
  let : Module Γ(X, U.1) Γ(L, X.basicOpen f) :=
    Module.compHom Γ(L, X.basicOpen f)
      (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom
  let : IsScalarTower Γ(X, U.1) Γ(X, X.basicOpen f) Γ(L, X.basicOpen f) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let : IsLocalizedModule.Away f
      (Scheme.Modules.restrictionLinearMap L (homOfLE (X.basicOpen_le f))) :=
    AlgebraicGeometry.isLocalizedModule_restriction_basicOpen_of_qcqs L U.2.isCompact
      U.2.isQuasiSeparated f
  let : Module.FinitePresentation Γ(X, U.1) Γ(L, U.1) :=
    AlgebraicGeometry.affineSections_of_isFinitePresentation L U.2
  have hEval := evalSpan_map_of_isLocalizedModule (R := Γ(X, U.1))
    (S := Γ(X, X.basicOpen f)) (M := Γ(L, U.1)) (Mₛ := Γ(L, X.basicOpen f))
    (Submonoid.powers f)
    (Scheme.Modules.restrictionLinearMap L (homOfLE (X.basicOpen_le f)))
    (L.presheaf.map (homOfLE le_top).op s)
  have hres : Scheme.Modules.restrictionLinearMap L (homOfLE (X.basicOpen_le f))
      (L.presheaf.map (homOfLE le_top).op s) = L.presheaf.map (homOfLE le_top).op s := by
    change L.presheaf.map (homOfLE (X.basicOpen_le f)).op
      (L.presheaf.map (homOfLE le_top).op s) = _
    exact congrArg (fun k => (ConcreteCategory.hom k) s)
      (((L.presheaf.map_comp (homOfLE le_top).op (homOfLE (X.basicOpen_le f)).op).symm.trans
        (congrArg L.presheaf.map (Subsingleton.elim _ _))) :
          L.presheaf.map (homOfLE le_top).op ≫
              L.presheaf.map (homOfLE (X.basicOpen_le f)).op =
            L.presheaf.map (homOfLE (show X.basicOpen f ≤ ⊤ from le_top)).op)
  rw [hres] at hEval
  exact hEval

/-- **The defining ideal of the zero scheme of a section of a finitely presented module.** On an
affine open `U` the ideal of the zero scheme of a global section `s` of a finitely presented
module `L` is generated by the values `φ (s|_U)` of the `Γ(X, U)`-linear functionals on `Γ(L, U)`:
the prescribed affine-local family is already an ideal sheaf, so
`Scheme.IdealSheafData.ofIdeals` leaves it untouched. -/
theorem _root_.Stacks.RegularSectionSequence.zeroScheme_ideal (X : Scheme.{u}) (L : X.Modules)
    [L.IsFinitePresentation] (s : Γ(L, ⊤)) (U : X.affineOpens) :
    (Stacks.RegularSectionSequence.zeroScheme X L s).ideal U =
      Ideal.span {a : Γ(X, U.1) | ∃ φ : Γ(L, U.1) →ₗ[Γ(X, U.1)] Γ(X, U.1),
        a = φ (L.presheaf.map (homOfLE le_top).op s)} := by
  classical
  let A : ∀ V : X.affineOpens, Ideal Γ(X, V.1) := fun V =>
    Ideal.span {a : Γ(X, V.1) | ∃ φ : Γ(L, V.1) →ₗ[Γ(X, V.1)] Γ(X, V.1),
      a = φ (L.presheaf.map (homOfLE le_top).op s)}
  have hmap (V : X.affineOpens) (g : Γ(X, V.1)) :
      (A V).map (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom =
        A (X.affineBasicOpen g) :=
    evalSpan_map_basicOpen_of_isFinitePresentation X L s V g
  let J : X.IdealSheafData := { ideal := A, map_ideal_basicOpen := hmap }
  change (Scheme.IdealSheafData.ofIdeals A).ideal U = A U
  rw [show A = J.ideal from rfl, Scheme.IdealSheafData.ofIdeals_ideal J]

end Stacks.Divisors

end
