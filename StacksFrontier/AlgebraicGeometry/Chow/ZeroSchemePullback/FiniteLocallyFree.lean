/-!
# The zero scheme of a section of a finite locally free module

Let `X` be a scheme, `ℰ` a finite locally free `𝒪_X`-module and `s ∈ Γ(X, ℰ)`. The zero scheme
`Z(s) ⊆ X` of [Stacks, Tag 0FA8] is the closed subscheme whose ideal sheaf is the image of
`s : ℰ^∨ ⟶ 𝒪_X`; it is `Stacks.RegularSectionSequence.zeroScheme X ℰ s`, the ideal sheaf generated
on an affine open `U` by the values `φ (s|_U)` of the linear functionals on `Γ(U, ℰ)`. This file
records the facts about it used in the proof of [Stacks, Tag 0FA9]:

* on an affine open on which `ℰ` is free with basis `e_1, …, e_r`, writing `s = ∑ a_i e_i`, the
  ideal of `Z(s)` is `(a_1, …, a_r)`;
* in rank zero `Z(s) = X`;
* away from `Z(s)` the section is *nowhere vanishing*: over a suitable affine neighbourhood some
  linear functional takes the value `1` at `s`;
* a morphism of modules can only enlarge the zero scheme: `Z(s) ⊆ Z(u(s))`;
* **the universal property**: a morphism `f : Y ⟶ X` factors through `Z(s)` if and only if
  `f^* s = 0`. This is [Stacks, Tag 02OR] (2) for a finite locally free module of any rank, and
  its proof is the one of the invertible case
  `AlgebraicGeometry.pullbackSection_eq_zero_iff_factorsThrough_zeroScheme` with a local frame of
  `r` sections in place of a single generator.

## Main results

* `Stacks.RegularSectionSequence.zeroScheme_ideal_eq_span_coord` — the ideal on a framed affine
  open.
* `Stacks.RegularSectionSequence.zeroScheme_eq_bot_of_rank_zero` — `Z(s) = X` in rank zero.
* `Stacks.RegularSectionSequence.exists_linearMap_eq_one_of_notMem_support` — the section is
  nowhere vanishing off its zero scheme.
* `Stacks.RegularSectionSequence.zeroScheme_le_zeroScheme_of_hom` — `Z(s) ⊆ Z(u(s))`.
* `Stacks.RegularSectionSequence.pullbackGlobalSections_eq_zero_iff_factorsThrough_zeroScheme` —
  the universal property.

## References

* [Stacks Project, Tag 0FA8](https://stacks.math.columbia.edu/tag/0FA8)
* [Stacks Project, Tag 02OR](https://stacks.math.columbia.edu/tag/02OR)
* [Stacks Project, Tag 02OQ](https://stacks.math.columbia.edu/tag/02OQ)
-/

@[expose] public section

noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open TensorProduct
open scoped ChangeOfRings

universe u

namespace Stacks.RegularSectionSequence

variable {X : Scheme.{u}}

/-! ### The ideal on a framed affine open -/

/-- The ideal of `R` generated by the values at `m` of all linear functionals on `M` is generated
by the coordinates of `m` in any finite basis of `M`. -/
theorem span_eval_eq_span_coord {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    {ι : Type*} [Fintype ι] (b : Module.Basis ι R M) (m : M) :
    Ideal.span {a : R | ∃ φ : M →ₗ[R] R, a = φ m} =
      Ideal.span (Set.range fun i => b.coord i m) := by
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨φ, rfl⟩
    have hm : φ m = ∑ i, b.coord i m * φ (b i) := by
      conv_lhs => rw [← b.sum_repr m]
      simp only [map_sum, map_smul, smul_eq_mul, Module.Basis.coord_apply]
    rw [hm]
    exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)
  · rintro _ ⟨i, rfl⟩
    exact Ideal.subset_span ⟨b.coord i, rfl⟩

/-- **The ideal of the zero scheme on a framed affine open.** If `Γ(U, ℰ)` has a finite basis
`e_1, …, e_r` over `Γ(X, U)` and `s|_U = ∑ a_i e_i`, the ideal of `Z(s)` on `U` is
`(a_1, …, a_r)`. -/
theorem zeroScheme_ideal_eq_span_coord (L : X.Modules) [L.IsFinitePresentation] (s : Γ(L, ⊤))
    (U : X.affineOpens) {ι : Type*} [Fintype ι] (b : Module.Basis ι Γ(X, U.1) Γ(L, U.1)) :
    (zeroScheme X L s).ideal U =
      Ideal.span (Set.range fun i => b.coord i (L.presheaf.map (homOfLE le_top).op s)) := by
  rw [zeroScheme_ideal X L s U]
  exact span_eval_eq_span_coord b _

/-! ### Rank zero -/

/-- A zero module has vanishing sections over every open. -/
theorem eq_zero_of_isZero {L : X.Modules} (hL : IsZero L) {U : X.Opens} (x : Γ(L, U)) :
    x = 0 := by
  simpa using congrArg (fun φ : L ⟶ L => Scheme.Modules.Hom.app φ U x) (hL.eq_of_src (𝟙 L) 0)

/-- **In rank zero the zero scheme is everything**: the sections of a module of rank zero
vanish, so every functional vanishes at them and the ideal of the zero scheme is zero. -/
theorem zeroScheme_eq_bot_of_rank_zero (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L 0] (s : Γ(L, ⊤)) :
    zeroScheme X L s = ⊥ := by
  have hz : IsZero L := Stacks.Chow.isZero_of_isFiniteLocallyFreeOfRank_zero L
  refine le_bot_iff.mp fun U => (Scheme.IdealSheafData.ideal_ofIdeals_le _ U).trans ?_
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨φ, rfl⟩
  rw [eq_zero_of_isZero hz (L.presheaf.map (homOfLE le_top).op s), map_zero]
  exact Submodule.zero_mem _

/-! ### Nowhere vanishing off the zero scheme -/

/-- The ideal generated by the values at `m` of all linear functionals on `M` consists of those
values: they already form an ideal. -/
theorem mem_span_eval_iff {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] (m : M)
    (a : R) : a ∈ Ideal.span {a : R | ∃ φ : M →ₗ[R] R, a = φ m} ↔ ∃ φ : M →ₗ[R] R, φ m = a := by
  refine ⟨fun h => ?_, fun ⟨φ, hφ⟩ => Ideal.subset_span ⟨φ, hφ.symm⟩⟩
  induction h using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨φ, rfl⟩ := hx
    exact ⟨φ, rfl⟩
  | zero => exact ⟨0, rfl⟩
  | add x y _ _ hx hy =>
    obtain ⟨φ, rfl⟩ := hx
    obtain ⟨ψ, rfl⟩ := hy
    exact ⟨φ + ψ, rfl⟩
  | smul c x _ hx =>
    obtain ⟨φ, rfl⟩ := hx
    exact ⟨c • φ, by simp⟩

/-- **The section is nowhere vanishing off its zero scheme.** Every point outside the zero
scheme of `s` has an affine neighbourhood `V` on which some linear functional on `Γ(V, ℰ)` takes
the value `1` at `s|_V`. -/
theorem exists_linearMap_eq_one_of_notMem_support (L : X.Modules) [L.IsFinitePresentation]
    (s : Γ(L, ⊤)) {x : X} (hx : x ∉ (zeroScheme X L s).support) :
    ∃ V : X.affineOpens, x ∈ V.1 ∧
      ∃ φ : Γ(L, V.1) →ₗ[Γ(X, V.1)] Γ(X, V.1), φ (L.presheaf.map (homOfLE le_top).op s) = 1 := by
  obtain ⟨U, hxU⟩ := Stacks.Divisors.exists_affineOpens_mem x
  rw [Scheme.IdealSheafData.mem_support_iff_of_mem hxU, Scheme.mem_zeroLocus_iff] at hx
  push Not at hx
  obtain ⟨a, ha, hxa⟩ := hx
  refine ⟨X.affineBasicOpen a, hxa, ?_⟩
  have hmap := (zeroScheme X L s).map_ideal (U := X.affineBasicOpen a) (V := U)
    (X.basicOpen_le a)
  have hmem : X.presheaf.map (homOfLE (X.basicOpen_le a)).op a ∈
      (zeroScheme X L s).ideal (X.affineBasicOpen a) := by
    rw [← hmap]
    exact Ideal.mem_map_of_mem _ ha
  have htop : (zeroScheme X L s).ideal (X.affineBasicOpen a) = ⊤ :=
    Ideal.eq_top_of_isUnit_mem _ hmem (X.toRingedSpace.isUnit_res_basicOpen a)
  have h1 : (1 : Γ(X, X.basicOpen a)) ∈ (zeroScheme X L s).ideal (X.affineBasicOpen a) := by
    rw [htop]; trivial
  rw [zeroScheme_ideal X L s (X.affineBasicOpen a)] at h1
  exact (mem_span_eval_iff _ _).mp h1

/-! ### Functoriality in the module -/

/-- **A morphism of modules enlarges the zero scheme**: for `u : ℰ ⟶ ℱ`, the zero scheme of
`u(s)` contains that of `s`, that is, its ideal is smaller. Every functional `ψ` on the sections
of `ℱ` gives the functional `ψ ∘ u` on those of `ℰ`, with `ψ(u(s)) = (ψ ∘ u)(s)`. -/
theorem zeroScheme_le_zeroScheme_of_hom {L M : X.Modules} (f : L ⟶ M) (s : Γ(L, ⊤)) :
    zeroScheme X M (Scheme.Modules.Hom.app f ⊤ s) ≤ zeroScheme X L s := by
  refine Scheme.IdealSheafData.ofIdeals_mono fun U => Ideal.span_le.mpr ?_
  rintro _ ⟨ψ, rfl⟩
  refine Ideal.subset_span ⟨ψ.comp (Scheme.Modules.sectionsLinearMap f U.1), ?_⟩
  show _ = ψ (Scheme.Modules.Hom.app f U.1 (L.presheaf.map (homOfLE le_top).op s))
  congr 1
  have h := ConcreteCategory.congr_hom (f.mapPresheaf.naturality (homOfLE (le_top : U.1 ≤ ⊤)).op) s
  simp only [ConcreteCategory.comp_apply] at h
  exact h.symm


/-! ### The universal property -/

/-- In a base change of a module with a finite basis, `1 ⊗ m` vanishes exactly when all the
coordinates of `m` do. The scalar action on the target is a *parameter*, so this is applied to the
action the extension of scalars uses and nothing is re-elaborated. -/
theorem tmul_one_eq_zero_iff_of_basis {R S M : Type u} [CommRing R] [CommRing S] [Module R S]
    [AddCommGroup M] [Module R M] (φ : R →+* S) (hsmul : ∀ (r : R) (t : S), r • t = φ r * t)
    {ι : Type} [Fintype ι] [DecidableEq ι] (b : Module.Basis ι R M) (m : M) :
    (1 : S) ⊗ₜ[R] m = 0 ↔ ∀ i, φ (b.coord i m) = 0 := by
  let E : S ⊗[R] M ≃ₗ[R] (ι → S) :=
    (TensorProduct.congr (LinearEquiv.refl R S) b.equivFun).trans
      (TensorProduct.piScalarRight R R S ι)
  have key : E ((1 : S) ⊗ₜ[R] m) = fun i => φ (b.coord i m) := by
    funext i
    simp [E, hsmul, Module.Basis.coord_apply]
  rw [← E.map_eq_zero_iff, key, funext_iff]
  rfl

/-- **The affine-local vanishing criterion, for a free module.** On a pair of affine opens
`V ⊆ f⁻¹U` with `Γ(U, ℰ)` free on a finite basis, the pullback of a section of `ℰ` over `U`
vanishes on `V` exactly when all its coordinates pull back to zero. -/
theorem pullbackSection_eq_zero_iff_of_basis {Y : Scheme.{u}} (f : Y ⟶ X) (L : X.Modules)
    [L.IsQuasicoherent] {U : X.Opens} (hU : IsAffineOpen U) {V : Y.Opens} (hV : IsAffineOpen V)
    (hVU : V ≤ f ⁻¹ᵁ U) {ι : Type} [Fintype ι] [DecidableEq ι]
    (b : Module.Basis ι Γ(X, U) Γ(L, U)) (m : Γ(L, U)) :
    Scheme.Modules.pullbackSection f L U V hVU m = 0 ↔
      ∀ i, f.appLE U V hVU (b.coord i m) = 0 := by
  have h1 : Scheme.Modules.pullbackSection f L U V hVU m = 0 ↔
      ((1 : Γ(Y, V)) ⊗ₜ[Γ(X, U), (f.appLE U V hVU).hom] m) = 0 := by
    rw [← affinePullbackSectionsBaseChangeIso_one_tmul f L hU hV hVU m]
    exact map_eq_zero_iff
      (ConcreteCategory.hom (affinePullbackSectionsBaseChangeIso f L hU hV hVU).hom)
      (ConcreteCategory.bijective_of_isIso
        (affinePullbackSectionsBaseChangeIso f L hU hV hVU).hom).injective
  exact h1.trans (@tmul_one_eq_zero_iff_of_basis Γ(X, U) Γ(Y, V) Γ(L, U) _ _
    (Module.compHom _ (f.appLE U V hVU).hom) _ _ (f.appLE U V hVU).hom (fun _ _ => rfl) ι _ _ b m)

/-- The pullback of `s|_W` vanishes on `V` exactly when `f` kills the ideal of the zero scheme on
`W`, for `ℰ` free over the affine open `W`. -/
private theorem pullbackSection_eq_zero_iff_ideal_le_ker (L : X.Modules) [L.IsQuasicoherent]
    [L.IsFinitePresentation] (s : Γ(L, ⊤)) {Y : Scheme.{u}} (f : Y ⟶ X) {W : X.Opens}
    (hW : IsAffineOpen W) {V : Y.Opens} (hV : IsAffineOpen V) (hVW : V ≤ f ⁻¹ᵁ W) {ι : Type}
    [Finite ι] (b : Module.Basis ι Γ(X, W) Γ(L, W)) :
    Scheme.Modules.pullbackSection f L W V hVW (L.presheaf.map (homOfLE le_top).op s) = 0 ↔
      (zeroScheme X L s).ideal ⟨W, hW⟩ ≤ RingHom.ker (f.appLE W V hVW).hom := by
  classical
  have := Fintype.ofFinite ι
  rw [pullbackSection_eq_zero_iff_of_basis f L hW hV hVW b,
    zeroScheme_ideal_eq_span_coord L s ⟨W, hW⟩ b, Ideal.span_le, Set.range_subset_iff]
  rfl

/-- Every point `y` with `f y ∈ U` has an affine neighbourhood `V ⊆ f⁻¹W`, for an affine open
`W ⊆ U` on which `ℰ` is free of rank `r`. -/
private theorem exists_isAffineOpen_pair_basis_le {Y : Scheme.{u}} (f : Y ⟶ X) (L : X.Modules)
    [L.IsQuasicoherent] (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L r]
    {U : X.Opens} {y : Y} (hy : f y ∈ U) :
    ∃ (W : X.Opens) (V : Y.Opens), IsAffineOpen W ∧ IsAffineOpen V ∧ y ∈ V ∧
      V ≤ f ⁻¹ᵁ W ∧ W ≤ U ∧ Nonempty (Module.Basis (Fin r) Γ(X, W) Γ(L, W)) := by
  obtain ⟨W, hW, hyW, hWU, hb⟩ := Stacks.Chow.exists_isAffineOpen_basis_sections_le L r hy
  obtain ⟨-, ⟨V, hV, rfl⟩, hyV, hVsub⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open
    (show y ∈ f ⁻¹ᵁ W from hyW) (f ⁻¹ᵁ W).isOpen
  exact ⟨W, V, hW, hV, hyV, hVsub, hWU, hb⟩

/-- If the pullback of `s` along `f` vanishes, the ideal of the zero scheme of `s` on every affine
open is killed by `f`. -/
private theorem ideal_le_ker_of_pullbackGlobalSections_eq_zero (L : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L r]
    [L.IsQuasicoherent] [L.IsFinitePresentation] (s : Γ(L, ⊤)) {Y : Scheme.{u}} {f : Y ⟶ X}
    (h0 : pullbackGlobalSections f L s = 0) (U : X.affineOpens) :
    (zeroScheme X L s).ideal U ≤ RingHom.ker (f.app U.1).hom := by
  intro x hx
  rw [RingHom.mem_ker]
  choose WW VV hWaff hVaff hyV hVsub hWU hb using fun y : (f ⁻¹ᵁ U.1 : Y.Opens) =>
    exists_isAffineOpen_pair_basis_le f L r (U := U.1) (y := y.1) y.2
  have hVU : ∀ y, VV y ≤ f ⁻¹ᵁ U.1 := fun y z hz => hWU y (hVsub y hz)
  have hcover : (f ⁻¹ᵁ U.1 : Y.Opens) ≤ ⨆ y, VV y := fun z hz =>
    TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨z, hz⟩, hyV ⟨z, hz⟩⟩
  refine Y.sheaf.eq_of_locally_eq' (U := VV) (f ⁻¹ᵁ U.1)
    (fun y => homOfLE (hVU y)) hcover _ 0 fun y => ?_
  refine Eq.trans ?_ (map_zero _).symm
  refine ((ConcreteCategory.comp_apply (f.app U.1)
    (Y.presheaf.map (homOfLE (hVU y)).op) x).symm.trans ?_)
  show f.appLE U.1 (VV y) (hVU y) x = 0
  rw [← Scheme.Hom.map_appLE f (hVsub y) (homOfLE (hWU y)).op, ConcreteCategory.comp_apply]
  exact (pullbackSection_eq_zero_iff_ideal_le_ker L s f (hWaff y) (hVaff y) (hVsub y)
    (hb y).some).mp (pullbackSection_eq_zero_of_pullbackGlobalSections_eq_zero f L s h0 (hVsub y))
    ((zeroScheme X L s).ideal_le_comap_ideal (U := ⟨WW y, hWaff y⟩) (V := U) (hWU y) hx)

/-- If `f` kills the ideal of the zero scheme of `s` on every affine open, the pullback of `s`
along `f` vanishes. -/
private theorem pullbackGlobalSections_eq_zero_of_ideal_le_ker (L : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L r]
    [L.IsQuasicoherent] [L.IsFinitePresentation] (s : Γ(L, ⊤)) {Y : Scheme.{u}} {f : Y ⟶ X}
    (hle : ∀ U : X.affineOpens, (zeroScheme X L s).ideal U ≤ RingHom.ker (f.app U.1).hom) :
    pullbackGlobalSections f L s = 0 := by
  choose WW VV hWaff hVaff hyV hVsub _hWU hb using fun y : Y =>
    exists_isAffineOpen_pair_basis_le f L r (U := ⊤) (show f y ∈ (⊤ : X.Opens) from trivial)
  have hcover : (⊤ : Y.Opens) ≤ ⨆ y, VV y := fun z _ =>
    TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hyV z⟩
  let F : TopCat.Sheaf AddCommGrpCat Y :=
    ⟨((Scheme.Modules.pullback f).obj L).presheaf,
      ((Scheme.Modules.pullback f).obj L).isSheaf⟩
  refine F.eq_of_locally_eq' (U := VV) ⊤ (fun y => homOfLE le_top) hcover _ 0 fun y => ?_
  have htop : (⊤ : Y.Opens) ≤ f ⁻¹ᵁ (⊤ : X.Opens) := by simp
  have hVtop : VV y ≤ f ⁻¹ᵁ (⊤ : X.Opens) := by simp
  simp only [map_zero]
  show ((Scheme.Modules.pullback f).obj L).presheaf.map (homOfLE (le_top : VV y ≤ ⊤)).op
    (pullbackGlobalSections f L s) = 0
  rw [pullbackGlobalSections_eq_pullbackSection f L htop s,
    pullbackSection_res_target f L (le_top : VV y ≤ ⊤) htop hVtop s,
    ← pullbackSection_res_source f L (le_top : WW y ≤ ⊤) hVtop (hVsub y) s]
  refine (pullbackSection_eq_zero_iff_ideal_le_ker L s f (hWaff y) (hVaff y) (hVsub y)
    (hb y).some).mpr fun a ha => ?_
  refine ((ConcreteCategory.comp_apply (f.app (WW y))
    (Y.presheaf.map (homOfLE (hVsub y)).op) a).trans ?_)
  rw [RingHom.mem_ker.mp (hle ⟨WW y, hWaff y⟩ ha), map_zero]

/-- **Stacks Tag 02OR (2), for a finite locally free module of any rank.** A global section `s`
of a finite locally free module vanishes after pullback along `f : Y ⟶ X` if and only if `f`
factors through the zero scheme of `s`.

Both directions are checked on pairs of affine opens `V ⊆ f⁻¹W` with `ℰ` free over `W`: there
the ideal of the zero scheme is generated by the coordinates of `s`
(`Stacks.RegularSectionSequence.zeroScheme_ideal_eq_span_coord`), and `f^* s` vanishes on `V`
exactly when these coordinates pull back to zero
(`Stacks.RegularSectionSequence.pullbackSection_eq_zero_iff_of_basis`). -/
theorem pullbackGlobalSections_eq_zero_iff_factorsThrough_zeroScheme (L : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L r] (s : Γ(L, ⊤))
    {Y : Scheme.{u}} (f : Y ⟶ X) :
    pullbackGlobalSections f L s = 0 ↔
      ∃ g : Y ⟶ (zeroScheme X L s).subscheme, g ≫ (zeroScheme X L s).subschemeι = f := by
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} L :=
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree L r
  have : L.IsQuasicoherent :=
    Stacks.AlgebraicGeometry.CoherenceCriteria.isQuasicoherent_of_isFiniteLocallyFree L
  have : L.IsFinitePresentation :=
    AlgebraicGeometry.SheafOfModules.isFinitePresentation_of_isFiniteLocallyFree L inferInstance
  have le_ker_iff : ∀ I : X.IdealSheafData, I ≤ f.ker ↔
      ∀ U : X.affineOpens, I.ideal U ≤ RingHom.ker (f.app U.1).hom := fun I =>
    Scheme.IdealSheafData.le_ofIdeals_iff
  rw [factorsThrough_ideal_iff_ideal_le_ker, le_ker_iff]
  exact ⟨ideal_le_ker_of_pullbackGlobalSections_eq_zero L r s,
    pullbackGlobalSections_eq_zero_of_ideal_le_ker L r s⟩

/-- **The pulled-back section vanishes on the zero scheme.** -/
theorem pullbackGlobalSections_subschemeι_eq_zero (L : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L r] (s : Γ(L, ⊤)) :
    pullbackGlobalSections (zeroScheme X L s).subschemeι L s = 0 :=
  (pullbackGlobalSections_eq_zero_iff_factorsThrough_zeroScheme L r s _).mpr
    ⟨𝟙 _, Category.id_comp _⟩


/-- A closed subscheme contains the zero scheme of a section exactly when the section pulls back
to zero on it. -/
theorem zeroScheme_le_iff (L : X.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L r] (s : Γ(L, ⊤))
    (I : X.IdealSheafData) :
    zeroScheme X L s ≤ I ↔ pullbackGlobalSections I.subschemeι L s = 0 := by
  rw [pullbackGlobalSections_eq_zero_iff_factorsThrough_zeroScheme L r s,
    factorsThrough_ideal_iff_ideal_le_ker, Scheme.IdealSheafData.ker_subschemeι]

/-- If the pullback of `s` along `h ≫ f` vanishes, so does the pullback along `h` of the pullback
of `s` along `f`. -/
private theorem pullbackGlobalSections_pullback_eq_zero {X' T : Scheme.{u}} (f : X' ⟶ X)
    (h : T ⟶ X') (L : X.Modules) (s : Γ(L, ⊤)) (hs : pullbackGlobalSections (h ≫ f) L s = 0) :
    pullbackGlobalSections h ((Scheme.Modules.pullback f).obj L)
      (pullbackGlobalSections f L s) = 0 := by
  refine pullbackGlobalSections_injective_pullbackComp h f L ?_
  simpa [AlgebraicGeometry.SectionsEqualizer.pullbackGlobalSections_comp h f L s] using hs

/-- **The zero scheme of a pulled-back section is the inverse image of the zero scheme**
([Stacks, Tag 0B6Y] for a finite locally free module of any rank): `Z(f^* s) = f⁻¹(Z(s))`. -/
theorem zeroScheme_pullbackGlobalSections {X' : Scheme.{u}} (f : X' ⟶ X) (L : X.Modules)
    (r : ℕ) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L r]
    (s : Γ(L, ⊤)) :
    zeroScheme X' ((Scheme.Modules.pullback f).obj L) (pullbackGlobalSections f L s) =
      (zeroScheme X L s).comap f := by
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback f).obj L) r :=
    AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback f L r
  let D' := zeroScheme X' ((Scheme.Modules.pullback f).obj L) (pullbackGlobalSections f L s)
  let D := zeroScheme X L s
  let i' := D'.subschemeι
  let i := D.subschemeι
  have hi' : pullbackGlobalSections i' ((Scheme.Modules.pullback f).obj L)
      (pullbackGlobalSections f L s) = 0 :=
    pullbackGlobalSections_subschemeι_eq_zero ((Scheme.Modules.pullback f).obj L) r
      (pullbackGlobalSections f L s)
  have hcompzero : pullbackGlobalSections (i' ≫ f) L s = 0 := by
    rw [← AlgebraicGeometry.SectionsEqualizer.pullbackGlobalSections_comp i' f L s]
    simp [hi']
  obtain ⟨g, hg⟩ :=
    (pullbackGlobalSections_eq_zero_iff_factorsThrough_zeroScheme L r s (i' ≫ f)).mp hcompzero
  have hpb : IsPullback i' g f i := by
    refine IsPullback.of_isLimit (c := PullbackCone.mk i' g hg.symm) ?_
    have hfac (c : PullbackCone f i) :=
      (pullbackGlobalSections_eq_zero_iff_factorsThrough_zeroScheme
        ((Scheme.Modules.pullback f).obj L) r (pullbackGlobalSections f L s) c.fst).mp
        (pullbackGlobalSections_pullback_eq_zero f c.fst L s (by
          rw [c.condition,
            ← AlgebraicGeometry.SectionsEqualizer.pullbackGlobalSections_comp c.snd i L s,
            pullbackGlobalSections_subschemeι_eq_zero L r s]
          simp))
    let lift : ∀ c : PullbackCone f i, c.pt ⟶ D'.subscheme := fun c => (hfac c).choose
    have lift_fst (c : PullbackCone f i) : lift c ≫ i' = c.fst := (hfac c).choose_spec
    have lift_snd (c : PullbackCone f i) : lift c ≫ g = c.snd := by
      refine (cancel_mono i).1 ?_
      rw [Category.assoc, hg, ← Category.assoc, lift_fst]
      exact c.condition
    exact PullbackCone.IsLimit.mk hg.symm lift lift_fst lift_snd fun c m hleft _ =>
      (cancel_mono i').1 (hleft.trans (lift_fst c).symm)
  calc
    D' = Scheme.Hom.ker i' := (Scheme.IdealSheafData.ker_subschemeι D').symm
    _ = Scheme.Hom.ker (pullback.fst f i) :=
        (congrArg Scheme.Hom.ker hpb.isoPullback_hom_fst).symm.trans
          (Scheme.Hom.ker_comp_of_isIso _ _)
    _ = D.comap f := rfl

/-- **A morphism of modules that stays injective on global sections after every pullback does not
change the zero scheme.** If `u : ℰ ⟶ ℱ` is such that `g^* u` is injective on global sections for
every `g : T ⟶ X` — for instance a monomorphism with locally free cokernel — then
`Z(u(s)) = Z(s)`: a morphism kills `u(s)` exactly when it kills `s`. -/
theorem zeroScheme_eq_of_pullback_injective {L M : X.Modules} (r m : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L r]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} M m]
    (f : L ⟶ M)
    (hf : ∀ {T : Scheme.{u}} (g : T ⟶ X),
      Function.Injective (Scheme.Modules.Hom.app ((Scheme.Modules.pullback g).map f) ⊤))
    (s : Γ(L, ⊤)) :
    zeroScheme X M (Scheme.Modules.Hom.app f ⊤ s) = zeroScheme X L s := by
  refine le_antisymm (zeroScheme_le_zeroScheme_of_hom f s) ?_
  rw [zeroScheme_le_iff L r s]
  refine hf (zeroScheme X M (Scheme.Modules.Hom.app f ⊤ s)).subschemeι ?_
  rw [← AlgebraicGeometry.pullbackGlobalSections_natural, map_zero]
  exact pullbackGlobalSections_subschemeι_eq_zero M m _


end Stacks.RegularSectionSequence
