module

public import StacksFrontier.AlgebraicGeometry.Chow.ZeroSchemePullback.ZeroSchemeIdeal

/-!
# The local equation of a zero scheme

On an affine open over which an invertible module `L` is trivialized, the zero scheme of a global
section `s` of `L` is cut out by a single function: the one representing `s|_U` under the
trivialization. This is the form in which the zero scheme is used locally — it exhibits `Z(s)` as
a principal closed subscheme, which is what makes it an effective Cartier divisor when `s` is a
regular section.

## Main results

* `Stacks.Divisors.zeroScheme_ideal_of_trivialization` — the defining ideal of the zero scheme on
  a trivializing affine open is the principal ideal generated by the function representing the
  section.

## Implementation notes

A trivialization is taken in the concrete form of a `Γ(X, U)`-linear equivalence
`Γ(L, U) ≃ₗ[Γ(X, U)] Γ(X, U)`; the function cutting out the zero scheme is the image of `s|_U`.
Both inclusions of ideals are immediate from `Stacks.Divisors.zeroScheme_ideal`: a functional
`φ` on `Γ(L, U)` factors as `φ ∘ e.symm` applied to `a`, so `φ (s|_U)` is a multiple of `a`; and
`a` itself is the value of the functional underlying `e`.

## References

* [Stacks Project, Tag 02OQ](https://stacks.math.columbia.edu/tag/02OQ)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.Divisors

/-- **The local equation of a zero scheme.** Under a trivialization `e` of an invertible module
`L` on an affine open `U`, the ideal of the zero scheme of a global section `s` is the principal
ideal generated by the function `a = e (s|_U)` representing the section. -/
theorem zeroScheme_ideal_of_trivialization (X : Scheme.{u}) (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : Γ(L, ⊤)) (U : X.affineOpens) (e : Γ(L, U.1) ≃ₗ[Γ(X, U.1)] Γ(X, U.1))
    (a : Γ(X, U.1)) (he : e (L.presheaf.map (homOfLE le_top).op s) = a) :
    (zeroScheme X L s).ideal U = Ideal.span ({a} : Set Γ(X, U.1)) := by
  rw [zeroScheme_ideal]
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro x ⟨φ, rfl⟩
    have hφ : φ (L.presheaf.map (homOfLE le_top).op s) = a * φ (e.symm 1) :=
      calc
        φ (L.presheaf.map (homOfLE le_top).op s)
            = φ (e.symm (e (L.presheaf.map (homOfLE le_top).op s))) := by
              rw [e.symm_apply_apply]
        _ = φ (e.symm (a • (1 : Γ(X, U.1)))) := by rw [he, smul_eq_mul, mul_one]
        _ = a * φ (e.symm 1) := by rw [map_smul, map_smul, smul_eq_mul]
    rw [hφ]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
  · intro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    exact Ideal.subset_span ⟨e.toLinearMap, he.symm⟩

end Stacks.Divisors

end
