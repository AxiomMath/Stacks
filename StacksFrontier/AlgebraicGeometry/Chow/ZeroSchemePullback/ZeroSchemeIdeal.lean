module

public import StacksFrontier.AlgebraicGeometry.Chow.GysinConstruction.ZeroScheme
public import StacksFrontier.AlgebraicGeometry.Chow.MeromorphicCascade.Quasicoherent
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.InvertibleRankOne.Characterization
public import StacksFrontier.AlgebraicGeometry.Modules.FiniteLocallyFree
public import StacksFrontier.AlgebraicGeometry.Morphisms.QuasiSeparated.LocalizedRestriction
public import StacksFrontier.AlgebraicGeometry.Morphisms.WeaklyEtale.RelativeFinitePresentation.FinitePresentation
import all StacksFrontier.AlgebraicGeometry.Morphisms.WeaklyEtale.RelativeFinitePresentation.FinitePresentation

/-!
# The defining ideal of a zero scheme on an affine open

The zero scheme `Z(s)` of a global section `s` of an invertible module `L` on a scheme `X` is cut
out by `Stacks.Divisors.zeroScheme`, which takes the largest quasi-coherent ideal sheaf contained
in the affine-local family `U ↦ ⟨φ (s|_U) : φ ∈ (Γ(L, U))^*⟩`. This file proves that the family is
itself an ideal sheaf, so that no shrinking occurs: on *every* affine open the ideal of the zero
scheme is exactly that span.

The content is a localization statement. Passing from `U` to a principal open `D(f) ⊆ U`
localizes both the ring and the module of sections, and the span of the coordinates of a vector
commutes with localization as soon as the module is finitely presented — which it is, an
invertible module being finite locally free of rank one.

## Main results

* `Stacks.Divisors.isFiniteLocallyFree_of_isInvertible`,
  `Stacks.Divisors.isFinitePresentation_of_isInvertible` — an invertible module is finite locally
  free, hence of finite presentation.
* `Stacks.Divisors.finitePresentation_sections_of_isInvertible` — its sections over an affine open
  form a finitely presented module.
* `Stacks.Divisors.zeroScheme_ideal` — the defining ideal of the zero scheme on an affine open is
  the ideal generated by the values of the linear functionals at the restricted section.

## Implementation notes

The module-theoretic core is `evalSpan_map_of_isLocalizedModule`: for a finitely presented module
`M` over `R` and a localization `R → S`, the ideal of `S` spanned by the coordinates of the image
of `m` is the image of the ideal of `R` spanned by the coordinates of `m`. Surjectivity of the
induced map on dual modules — `Module.FinitePresentation.isLocalizedModule_mapExtendScalars` —
is where finite presentation enters, and it is the only place.

Finite presentation of `Γ(L, U)` over `Γ(X, U)` is obtained from the sheaf-level statement rather
than re-derived: an invertible module is finite locally free of rank one
([Stacks, Tag 0B8M](https://stacks.math.columbia.edu/tag/0B8M), proved as
`Stacks.SheafOfModules.isInvertible_iff_isFiniteLocallyFreeOfRank_one_algebraicGeometry`), hence
of finite presentation as a sheaf, and the sections of a quasi-coherent sheaf of finite
presentation over an affine open form a finitely presented module. Quasi-coherence is not
re-derived either: it is the instance `Stacks.Divisors.isQuasicoherent_of_isInvertible`.

## References

* [Stacks Project, Tag 02OQ](https://stacks.math.columbia.edu/tag/02OQ)
* [Stacks Project, Tag 01P7](https://stacks.math.columbia.edu/tag/01P7)
* [Stacks Project, Tag 0B8M](https://stacks.math.columbia.edu/tag/0B8M)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.Divisors

/-- An invertible module on a scheme is finite locally free: it is finite locally free of rank
one by [Stacks, Tag 0B8M], and a rank datum is in particular a finite one. -/
theorem isFiniteLocallyFree_of_isInvertible (X : Scheme.{u}) (L : X.Modules)
    [h : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] :
    Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} L := by
  have hrank :=
    (Stacks.SheafOfModules.isInvertible_iff_isFiniteLocallyFreeOfRank_one_algebraicGeometry
      (X := X.toRingedSpace) L).mp h
  obtain ⟨q, hfree, hr⟩ := hrank.exists_isFiniteLocallyFreeOfRankData
  exact ⟨q, hfree, ⟨fun i => ⟨Finite.of_equiv (Fin 1) (hr i).some.symm⟩⟩⟩

/-- An invertible module on a scheme is of finite presentation. -/
theorem isFinitePresentation_of_isInvertible (X : Scheme.{u}) (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] :
    L.IsFinitePresentation :=
  let : Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} L :=
    isFiniteLocallyFree_of_isInvertible X L
  Stacks.FiniteLocallyFree.isFinitePresentation L

/-- The sections of an invertible module over an affine open form a finitely presented module
over the functions on that open. -/
theorem finitePresentation_sections_of_isInvertible (X : Scheme.{u}) (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (U : X.affineOpens) : Module.FinitePresentation Γ(X, U.1) Γ(L, U.1) :=
  let : L.IsFinitePresentation := isFinitePresentation_of_isInvertible X L
  AlgebraicGeometry.affineSections_of_isFinitePresentation L U.2

/-- **The algebraic core of Stacks 02OQ.** Let `M` be a finitely presented `R`-module, let `S` be
a localization of `R` at a submonoid `T` and let `Mₛ` be the corresponding localization of `M`.
The ideal of `S` generated by the coordinates `φ (f m)`, `φ ∈ (Mₛ)^*`, of the image of `m ∈ M` is
the image under `R → S` of the ideal of `R` generated by the coordinates of `m`.

Finite presentation is used exactly once, to know that every functional on `Mₛ` is, up to a unit
of `S`, the localization of a functional on `M`. -/
private theorem evalSpan_map_of_isLocalizedModule
    {R S M Mₛ : Type u} [CommRing R] [CommRing S] [Algebra R S]
    (T : Submonoid R) [IsLocalization T S]
    [AddCommGroup M] [Module R M] [AddCommGroup Mₛ] [Module R Mₛ] [Module S Mₛ]
    [IsScalarTower R S Mₛ]
    (f : M →ₗ[R] Mₛ) [IsLocalizedModule T f]
    [Module.FinitePresentation R M] (m : M) :
    Ideal.map (algebraMap R S) (Ideal.span {a : R | ∃ φ : M →ₗ[R] R, a = φ m}) =
      Ideal.span {a : S | ∃ φ : Mₛ →ₗ[S] S, a = φ (f m)} := by
  let g : R →ₗ[R] S := Algebra.linearMap R S
  let F : (M →ₗ[R] R) →ₗ[R] (Mₛ →ₗ[S] S) := IsLocalizedModule.mapExtendScalars T f g S
  let : IsLocalizedModule T F :=
    Module.FinitePresentation.isLocalizedModule_mapExtendScalars T f g S
  apply le_antisymm
  · rw [Ideal.map_span]
    apply Ideal.span_le.2
    rintro y ⟨x, hx, rfl⟩
    rcases hx with ⟨φ, rfl⟩
    refine Ideal.subset_span ⟨F φ, ?_⟩
    simp only [F, IsLocalizedModule.mapExtendScalars_apply_apply, IsLocalizedModule.map_apply, g,
      Algebra.linearMap_apply]
  · apply Ideal.span_le.2
    rintro y ⟨φ, rfl⟩
    obtain ⟨⟨ψ, t⟩, ht⟩ := IsLocalizedModule.surj T F φ
    have heval : algebraMap R S t.1 * φ (f m) = algebraMap R S (ψ m) := by
      have h := congrArg (fun k : Mₛ →ₗ[S] S => k (f m)) ht
      change (t.1 • φ) (f m) = F ψ (f m) at h
      simp only [F, IsLocalizedModule.mapExtendScalars_apply_apply, IsLocalizedModule.map_apply,
        Algebra.smul_def, g, Algebra.linearMap_apply, LinearMap.smul_apply] at h
      simpa [g] using h
    have hmap : algebraMap R S (ψ m) ∈
        Ideal.map (algebraMap R S) (Ideal.span {a : R | ∃ φ : M →ₗ[R] R, a = φ m}) :=
      Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨ψ, rfl⟩)
    have hunit : IsUnit (algebraMap R S t.1) := IsLocalization.map_units S t
    obtain ⟨v, hv⟩ := hunit
    have hscaled : φ (f m) = (↑v⁻¹ : S) * (algebraMap R S t.1 * φ (f m)) := by
      rw [← mul_assoc, ← hv, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul]
    rw [hscaled, heval]
    exact Ideal.mul_mem_left _ _ hmap

/-- The ideal of coordinates of a section of an invertible module commutes with restriction to a
principal open of an affine open: the restriction map is a localization both of the ring of
functions ([Stacks, Tag 01P7] for the structure sheaf) and of the module of sections of `L`
([Stacks, Tag 01P7] for quasi-coherent modules). -/
private theorem evalSpan_map_basicOpen (X : Scheme.{u}) (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : Γ(L, ⊤)) (U : X.affineOpens) (f : Γ(X, U.1)) :
    Ideal.map (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom
        (Ideal.span {a : Γ(X, U.1) | ∃ φ : Γ(L, U.1) →ₗ[Γ(X, U.1)] Γ(X, U.1),
          a = φ (L.presheaf.map (homOfLE le_top).op s)}) =
      Ideal.span {a : Γ(X, X.basicOpen f) |
        ∃ φ : Γ(L, X.basicOpen f) →ₗ[Γ(X, X.basicOpen f)] Γ(X, X.basicOpen f),
          a = φ (L.presheaf.map (homOfLE le_top).op s)} := by
  let : IsLocalization (Submonoid.powers f) Γ(X, X.basicOpen f) :=
    AlgebraicGeometry.isLocalization_basicOpen_of_qcqs U.2.isCompact U.2.isQuasiSeparated f
  let : Module Γ(X, U.1) Γ(L, X.basicOpen f) :=
    Module.compHom Γ(L, X.basicOpen f)
      (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom
  let : IsScalarTower Γ(X, U.1) Γ(X, X.basicOpen f) Γ(L, X.basicOpen f) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let : IsLocalizedModule.Away f
      (Scheme.Modules.restrictionLinearMap L (homOfLE (X.basicOpen_le f))) :=
    AlgebraicGeometry.isLocalizedModule_restriction_basicOpen_of_qcqs L U.2.isCompact
      U.2.isQuasiSeparated f
  let : Module.FinitePresentation Γ(X, U.1) Γ(L, U.1) :=
    finitePresentation_sections_of_isInvertible X L U
  have hEval := evalSpan_map_of_isLocalizedModule (R := Γ(X, U.1))
    (S := Γ(X, X.basicOpen f)) (M := Γ(L, U.1)) (Mₛ := Γ(L, X.basicOpen f))
    (Submonoid.powers f)
    (Scheme.Modules.restrictionLinearMap L (homOfLE (X.basicOpen_le f)))
    (L.presheaf.map (homOfLE le_top).op s)
  have hres : Scheme.Modules.restrictionLinearMap L (homOfLE (X.basicOpen_le f))
      (L.presheaf.map (homOfLE le_top).op s) = L.presheaf.map (homOfLE le_top).op s := by
    show L.presheaf.map (homOfLE (X.basicOpen_le f)).op
      (L.presheaf.map (homOfLE le_top).op s) = _
    exact congrArg (fun k => (ConcreteCategory.hom k) s)
      (((L.presheaf.map_comp (homOfLE le_top).op (homOfLE (X.basicOpen_le f)).op).symm.trans
        (congrArg L.presheaf.map (Subsingleton.elim _ _))) :
          L.presheaf.map (homOfLE le_top).op ≫
              L.presheaf.map (homOfLE (X.basicOpen_le f)).op =
            L.presheaf.map (homOfLE (show X.basicOpen f ≤ ⊤ from le_top)).op)
  rw [hres] at hEval
  exact hEval

/-- **Stacks 02OQ**, the defining ideal. The ideal of the zero scheme of a global section `s` of
an invertible module `L` on an affine open `U` is generated by the values `φ (s|_U)` of the
`Γ(X, U)`-linear functionals on `Γ(L, U)`: the prescribed affine-local family is already an ideal
sheaf, so `Scheme.IdealSheafData.ofIdeals` leaves it untouched. -/
@[stacks 02OQ "the defining ideal"]
theorem zeroScheme_ideal (X : Scheme.{u}) (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : Γ(L, ⊤)) (U : X.affineOpens) :
    (zeroScheme X L s).ideal U =
      Ideal.span {a : Γ(X, U.1) | ∃ φ : Γ(L, U.1) →ₗ[Γ(X, U.1)] Γ(X, U.1),
        a = φ (L.presheaf.map (homOfLE le_top).op s)} := by
  classical
  let A : ∀ V : X.affineOpens, Ideal Γ(X, V.1) := fun V =>
    Ideal.span {a : Γ(X, V.1) | ∃ φ : Γ(L, V.1) →ₗ[Γ(X, V.1)] Γ(X, V.1),
      a = φ (L.presheaf.map (homOfLE le_top).op s)}
  have hmap (V : X.affineOpens) (g : Γ(X, V.1)) :
      (A V).map (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom =
        A (X.affineBasicOpen g) :=
    evalSpan_map_basicOpen X L s V g
  let J : X.IdealSheafData := { ideal := A, map_ideal_basicOpen := hmap }
  show (Scheme.IdealSheafData.ofIdeals A).ideal U = A U
  rw [show A = J.ideal from rfl, Scheme.IdealSheafData.ofIdeals_ideal J]

end Stacks.Divisors

end
