module

public import StacksFrontier.AlgebraicGeometry.FormsTrace.FiniteTrace
public import StacksFrontier.AlgebraicGeometry.DeRham.Comparison.BaseChange
public import StacksFrontier.AlgebraicGeometry.Morphisms.Syntomic.Properties
public import StacksFrontier.AlgebraicGeometry.DeRham.SchemeComplex
public import StacksFrontier.AlgebraicGeometry.Pushout.SquareSections

/-!
# Rules of trace maps on forms

Stacks, Lemma 0FLB asserts that there is a unique rule assigning to every finite syntomic
morphism of schemes `f : Y ⟶ X` maps of `𝒪_X`-modules `Θ^p_{Y/X} : f_*Ω^p_{Y/ℤ} ⟶ Ω^p_{X/ℤ}`
such that

1. the composition with `Ω^p_{X/ℤ} ⊗_{𝒪_X} f_*𝒪_Y → f_*Ω^p_{Y/ℤ}` is `id ⊗ Trace_f`,
2. the rule is compatible with base change.

This file states the two conditions. Condition (1) is read on local sections: the source
`Ω^p_{X/ℤ} ⊗ f_*𝒪_Y` is generated by local pure tensors `ω ⊗ b`, whose image in `f_*Ω^p_{Y/ℤ}` is
`b · f^*ω`, so (1) says `Θ^p_{Y/X}(b · f^*ω) = Trace_f(b) · ω`. Condition (2) is read on local
sections too: for a cartesian square `Y' = X' ×_X Y`, the map of `Y'/X'` on the pull-back of a
local form of `Y` is the pull-back of the map of `Y/X` on that form.

## Main definitions

* `AlgebraicGeometry.FormsTraceRule`: a rule of maps `Θ^p_{Y/X}`.
* `AlgebraicGeometry.FormsTraceRule.IsTrace`: condition (1).
* `AlgebraicGeometry.FormsTraceRule.IsBaseChange`: condition (2).

## References

* [Stacks Project, Tag 0FLB](https://stacks.math.columbia.edu/tag/0FLB)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace

universe u

namespace AlgebraicGeometry

/-- **A rule of trace maps on forms** (Stacks, Lemma 0FLB): to every finite syntomic morphism of
schemes `f : Y ⟶ X` it assigns maps of `𝒪_X`-modules `Θ^p_{Y/X} : f_*Ω^p_{Y/ℤ} ⟶ Ω^p_{X/ℤ}`,
`p ≥ 0`. -/
abbrev FormsTraceRule : Type (u + 1) :=
  ∀ ⦃X Y : Scheme.{u}⦄ (f : Y ⟶ X) [IsFinite f], Syntomic f → ∀ p : ℕ,
    (Scheme.Modules.pushforward f).obj (Scheme.absoluteDifferentialForms Y p) ⟶
      Scheme.absoluteDifferentialForms X p

namespace FormsTraceRule

variable (Θ : FormsTraceRule.{u})

/-- **Condition (1) of Stacks, Lemma 0FLB**, on local sections: for every open `U` of `X`, every
`b ∈ Γ(Y, f⁻¹U)` and every `ω ∈ Γ(Ω^p_{X/ℤ}, U)`,
`Θ^p_{Y/X}(b · f^*ω) = Trace_f(b) · ω`. -/
def IsTrace : Prop :=
  ∀ ⦃X Y : Scheme.{u}⦄ (f : Y ⟶ X) [IsFinite f] (hf : Syntomic f) (p : ℕ) (U : X.Opens)
    (b : Γ(Y, f ⁻¹ᵁ U)) (ω : Γ(Scheme.absoluteDifferentialForms X p, U)),
    haveI := AlgebraicGeometry.flat hf
    haveI := AlgebraicGeometry.locallyOfFinitePresentation hf
    (Θ f hf p).app U (b • f.absoluteFormsPullback p U ω) =
      (show Γ(X, U) from (f.finiteTrace).app U b) • ω

/-- **Condition (2) of Stacks, Lemma 0FLB**, on local sections: for every cartesian square
`Y' = X' ×_X Y` of schemes (with `f : Y ⟶ X`, `f' : Y' ⟶ X'` finite syntomic), every open `U` of
`X`, every open `U' ≤ a⁻¹U` of `X'` and every local form `η` of `Y` over `f⁻¹U`, the map of
`f'` on the restriction of the pull-back of `η` is the restriction of the pull-back of the map of
`f` on `η`. -/
def IsBaseChange : Prop :=
  ∀ ⦃X Y X' Y' : Scheme.{u}⦄ (f : Y ⟶ X) (f' : Y' ⟶ X') (a : X' ⟶ X) (b : Y' ⟶ Y)
    (sq : IsPullback b f' f a) [IsFinite f] [IsFinite f'] (hf : Syntomic f) (hf' : Syntomic f')
    (p : ℕ) (U : X.Opens) (U' : X'.Opens) (hU : U' ≤ a ⁻¹ᵁ U)
    (η : Γ(Scheme.absoluteDifferentialForms Y p, f ⁻¹ᵁ U)),
    (Θ f' hf' p).app U' ((Scheme.absoluteDifferentialForms Y' p).presheaf.map
        (homOfLE (AlgebraicGeometry.preimage_le_preimage_of_comm sq.w.symm hU)).op
        (b.absoluteFormsPullback p (f ⁻¹ᵁ U) η)) =
      (Scheme.absoluteDifferentialForms X' p).presheaf.map (homOfLE hU).op
        (a.absoluteFormsPullback p U ((Θ f hf p).app U η))

/-- The unit form `1 ∈ Γ(Ω^0_{X/ℤ}, U)`. -/
abbrev unitForm (X : Scheme.{u}) (U : X.Opens) : Γ(Scheme.absoluteDifferentialForms X (0 : ℕ), U) :=
  (Scheme.absoluteDifferentialFormsAlgebra X).one.eval (op U)

/-- **In degree `0`, a rule with condition (1) is the trace** (Stacks, Proposition 0FLC (1)):
`Θ^0_{Y/X}(b · 1) = Trace_f(b) · 1` for every local section `b` of `f_*𝒪_Y`. -/
theorem IsTrace.apply_smul_unitForm {Θ : FormsTraceRule.{u}} (h : Θ.IsTrace) ⦃X Y : Scheme.{u}⦄
    (f : Y ⟶ X) [IsFinite f] (hf : Syntomic f) (U : X.Opens) (b : Γ(Y, f ⁻¹ᵁ U)) :
    haveI := AlgebraicGeometry.flat hf
    haveI := AlgebraicGeometry.locallyOfFinitePresentation hf
    (Θ f hf 0).app U (b • unitForm Y (f ⁻¹ᵁ U)) =
      (show Γ(X, U) from (f.finiteTrace).app U b) • unitForm X U := by
  have h1 := h f hf 0 U b (unitForm X U)
  have h2 : f.absoluteFormsPullback ((0 : ℕ) : ℤ) U (unitForm X U) = unitForm Y (f ⁻¹ᵁ U) :=
    Scheme.Hom.relativeDifferentialFormsPullback_one f X.toSpecZ Y.toSpecZ (𝟙 _)
      (Scheme.comp_toSpecZ f) U
  rwa [h2] at h1

end FormsTraceRule

end AlgebraicGeometry
