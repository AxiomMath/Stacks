module

public import StacksFrontier.AlgebraicGeometry.LimitDescentGlueing.Glueing
public import StacksFrontier.AlgebraicGeometry.Limits.AffineNoetherianApproximation
public import StacksFrontier.AlgebraicGeometry.ModuleLimits.MorphismDescentGlue
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Descending a finitely presented object from an affine scheme to a Noetherian stage

The cone `AlgebraicGeometry.specAdjoinFinsetCone` presents an affine scheme `S` as the limit of
the spectra of the subalgebras `ℤ[i]` of `Γ(S, ⊤)` generated by its finite subsets: every stage is
affine, Noetherian and of finite type over the integers, and every transition morphism is affine.
This file feeds that presentation to the two descent theorems which consume such a system —
Limits, Tag 01ZM part (1) for schemes and Limits, Tag 01ZR part (1) for modules — and so descends
a finitely presented object over `S` to a stage.

Both descents go through with **no bridging lemma**: the cone of the presentation is literally the
cone those theorems take, and the five structural conditions they impose on the index category
and the stages — `CategoryTheory.IsCofiltered`, `CategoryTheory.EssentiallySmall` relative to the
scheme universe, affineness of the transitions, and quasi-compactness and quasi-separatedness of
every stage — are all found by instance search at `(Finset R)ᵒᵖ`, the last two from Noetherianity
of the stages.

## Main definitions

* `AlgebraicGeometry.affineStageCone`, `AlgebraicGeometry.isLimit_affineStageCone`: the
  presentation's limiting cone with its vertex moved from `Spec Γ(S, ⊤)` to `S`.

## Main results

* `AlgebraicGeometry.exists_isFinitePresentation_pullback_specAdjoinFinsetDiagram`: a sheaf of
  modules of finite presentation on `Spec R` is the pullback of one of finite presentation on
  `Spec ℤ[i]` for some finite `i ⊆ R`.
* `AlgebraicGeometry.exists_isFinitePresentation_pullback_of_isAffine`: the same for an arbitrary
  affine scheme, with the stage recorded as affine, Noetherian and of finite type over the
  integers.
* `AlgebraicGeometry.exists_finitePresentation_baseChange_specAdjoinFinsetDiagram`,
  `AlgebraicGeometry.exists_finitePresentation_baseChange_of_isAffine`: the corresponding
  statements for a scheme of finite presentation over the base.

## Implementation notes

The vertex is moved by `CategoryTheory.Limits.Cone.extend` along
`AlgebraicGeometry.Scheme.isoSpec`, exactly as
`AlgebraicGeometry.exists_limitNoetherianSituation_of_isAffine` does, rather than by transporting
the descended object along an isomorphism of schemes. Then the module and the scheme being
descended never have to be moved at all: they live over `S`, which is the vertex of the extended
cone on the nose.

## References

* [Stacks Project, Tag 01ZA](https://stacks.math.columbia.edu/tag/01ZA)
* [Stacks Project, Tag 01ZM](https://stacks.math.columbia.edu/tag/01ZM)
* [Stacks Project, Tag 01ZR](https://stacks.math.columbia.edu/tag/01ZR)
* [Stacks Project, Tag 0EX4](https://stacks.math.columbia.edu/tag/0EX4)
-/


@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry

/-! ### Descent along the presentation of `Spec R` -/

/-- **A sheaf of modules of finite presentation on `Spec R` comes from a Noetherian stage.** It is
the pullback of a sheaf of modules of finite presentation on `Spec ℤ[i]` for some finite subset
`i` of `R`.

This is Tag 01ZR (1) at `AlgebraicGeometry.specAdjoinFinsetCone`. -/
theorem exists_isFinitePresentation_pullback_specAdjoinFinsetDiagram (R : Type u) [CommRing R]
    (F : (specAdjoinFinsetCone R).pt.Modules) [F.IsFinitePresentation] :
    ∃ (i : (Finset R)ᵒᵖ) (G : ((specAdjoinFinsetDiagram R).obj i).Modules),
      G.IsFinitePresentation ∧
        Nonempty (F ≅ (Scheme.Modules.pullback ((specAdjoinFinsetCone R).π.app i)).obj G) :=
  Stacks.AlgebraicGeometry.ModuleLimits.exists_isFinitePresentation_pullback_iso_of_qcqs
    (specAdjoinFinsetDiagram R) (specAdjoinFinsetCone R) (isLimit_specAdjoinFinsetCone R) F

/-- **A scheme of finite presentation over `Spec R` comes from a Noetherian stage.** It is the
base change of a scheme of finite presentation over `Spec ℤ[i]` for some finite subset `i` of `R`.

This is Tag 01ZM (1) at `AlgebraicGeometry.specAdjoinFinsetCone`. -/
@[sga "3 VIB 10.0" "(ii), special case"]
theorem exists_finitePresentation_baseChange_specAdjoinFinsetDiagram (R : Type u) [CommRing R]
    (X : Over (specAdjoinFinsetCone R).pt) (hX : FinitePresentation X.hom) :
    ∃ (i : (Finset R)ᵒᵖ) (Xᵢ : Over ((specAdjoinFinsetDiagram R).obj i)),
      FinitePresentation Xᵢ.hom ∧
        Nonempty (X ≅ (Over.pullback ((specAdjoinFinsetCone R).π.app i)).obj Xᵢ) :=
  LimitDescent.exists_model_of_finitePresentation_of_essentiallySmall
    (specAdjoinFinsetDiagram R) (specAdjoinFinsetCone R) (isLimit_specAdjoinFinsetCone R) X hX

/-! ### Descent along the presentation of an arbitrary affine scheme -/

variable (S : Scheme.{u}) [IsAffine S]

/-- **The Noetherian presentation of an affine scheme, with vertex `S`.** The cone of
`AlgebraicGeometry.specAdjoinFinsetCone` at `Γ(S, ⊤)`, extended along
`AlgebraicGeometry.Scheme.isoSpec` so that its vertex is `S` itself. -/
def affineStageCone : Cone (specAdjoinFinsetDiagram Γ(S, ⊤)) :=
  (specAdjoinFinsetCone Γ(S, ⊤)).extend S.isoSpec.hom

/-- The vertex of `AlgebraicGeometry.affineStageCone S` is `S`. -/
@[simp] lemma affineStageCone_pt : (affineStageCone S).pt = S := rfl

/-- `S` is the limit of the spectra of the finitely generated subalgebras of `Γ(S, ⊤)`. -/
def isLimit_affineStageCone : IsLimit (affineStageCone S) :=
  IsLimit.ofIsoLimit (isLimit_specAdjoinFinsetCone Γ(S, ⊤))
    (Cone.extendIso (specAdjoinFinsetCone Γ(S, ⊤))
      (S.isoSpec.symm : (specAdjoinFinsetCone Γ(S, ⊤)).pt ≅ S))

open Stacks.AlgebraicGeometry.ModuleLimits in
/-- **A sheaf of modules of finite presentation on an affine scheme comes from a Noetherian
scheme of finite type over the integers.** There are an affine Noetherian scheme `T` of finite
type over `ℤ`, a morphism `S ⟶ T`, and a sheaf of modules of finite presentation on `T` whose
pullback is the given one.

This is Tag 01ZR (1) at `AlgebraicGeometry.affineStageCone`; the stage data is the one recorded
by `AlgebraicGeometry.exists_limitNoetherianSituation_of_isAffine`. -/
theorem exists_isFinitePresentation_pullback_of_isAffine (F : S.Modules) [F.IsFinitePresentation] :
    ∃ (T : Scheme.{u}) (q : S ⟶ T) (G : T.Modules),
      IsAffine T ∧ IsNoetherian T ∧ LocallyOfFiniteType (terminal.from T) ∧
        G.IsFinitePresentation ∧ Nonempty (F ≅ (Scheme.Modules.pullback q).obj G) := by
  have : (show (affineStageCone S).pt.Modules from F).IsFinitePresentation :=
    inferInstanceAs F.IsFinitePresentation
  obtain ⟨i, G, hG, hiso⟩ :=
    exists_isFinitePresentation_pullback_iso_of_qcqs
      (specAdjoinFinsetDiagram Γ(S, ⊤)) (affineStageCone S) (isLimit_affineStageCone S)
      (show (affineStageCone S).pt.Modules from F)
  exact ⟨(specAdjoinFinsetDiagram Γ(S, ⊤)).obj i, (affineStageCone S).π.app i, G,
    isAffine_specAdjoinFinsetDiagram_obj _ i, isNoetherian_specAdjoinFinsetDiagram_obj _ i,
    locallyOfFiniteType_terminalFrom_specAdjoinFinsetDiagram_obj _ i, hG, hiso⟩

/-- **A scheme of finite presentation over an affine scheme comes from a Noetherian scheme of
finite type over the integers.** There are an affine Noetherian scheme `T` of finite type over
`ℤ`, a morphism `S ⟶ T`, and a scheme of finite presentation over `T` whose base change along it
is the given one.

This is Tag 01ZM (1) at `AlgebraicGeometry.affineStageCone`. -/
theorem exists_finitePresentation_baseChange_of_isAffine (X : Over S)
    (hX : FinitePresentation X.hom) :
    ∃ (T : Scheme.{u}) (q : S ⟶ T) (XT : Over T),
      IsAffine T ∧ IsNoetherian T ∧ LocallyOfFiniteType (terminal.from T) ∧
        FinitePresentation XT.hom ∧ Nonempty (X ≅ (Over.pullback q).obj XT) := by
  obtain ⟨i, Xᵢ, hXᵢ, hiso⟩ :=
    LimitDescent.exists_model_of_finitePresentation_of_essentiallySmall
      (specAdjoinFinsetDiagram Γ(S, ⊤)) (affineStageCone S) (isLimit_affineStageCone S) X hX
  exact ⟨(specAdjoinFinsetDiagram Γ(S, ⊤)).obj i, (affineStageCone S).π.app i, Xᵢ,
    isAffine_specAdjoinFinsetDiagram_obj _ i, isNoetherian_specAdjoinFinsetDiagram_obj _ i,
    locallyOfFiniteType_terminalFrom_specAdjoinFinsetDiagram_obj _ i, hXᵢ, hiso⟩

end AlgebraicGeometry

end
