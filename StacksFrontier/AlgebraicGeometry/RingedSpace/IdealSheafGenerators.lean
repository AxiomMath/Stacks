module

public import Mathlib.Geometry.RingedSpace.Basic
public import Mathlib.Geometry.RingedSpace.LocallyRingedSpace
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Submodule
public import Mathlib.LinearAlgebra.Matrix.Basis
public import StacksFrontier.RingTheory.Sequence.QuasiRegular.DegreeOne
public import StacksCore.Tactic.StacksAttribute

/-!
# Local generators of an ideal sheaf on a locally ringed space

Let `X` be a locally ringed space and let `J ⊆ O_X` be an ideal subsheaf of its structure
sheaf. This file compares two descriptions of `J` near a point `x` of the support of `O_X / J`:
a lift `f_1, …, f_r ∈ J_x` of a basis of the cotangent fibre `J_x / 𝔪_x J_x`, and a sequence
`g_1, …, g_s` of sections of `O_X` on a neighbourhood of `x` which generates `J` stalkwise and
is quasi-regular at every point. The two have the same length, and after shrinking the
neighbourhood the `f_i` are sections of `J` obtained from the `g_j` by an invertible matrix of
sections of `O_X`. This is the content of the first part of Stacks 067N.

## Main definitions

* `Stacks.RingedSpace.structureSheafModule`: the structure sheaf of a ringed space as a
  rank-one sheaf of modules over itself, so that ideal sheaves are its submodules.
* `Stacks.RingedSpace.germSet` and `Stacks.RingedSpace.germIdeal`: the germs at `x` of the
  sections of an ideal subsheaf, as a set and as an ideal of the stalk.
* `Stacks.RingedSpace.stalkIdeal`: the stalk `J_x` of an ideal subsheaf, defined as the ideal
  generated by those germs.
* `Stacks.RingedSpace.idealCotangentFiber`: the cotangent fibre `J_x / 𝔪_x J_x`.

## Main results

* `Stacks.RingedSpace.stalkIdeal_eq_germIdeal`: the germs of sections of `J` already form an
  ideal, so no span is needed.
* `Stacks.RingedSpace.mem_of_germ_mem`: membership in an ideal subsheaf is a stalkwise
  condition.
* `Stacks.RingedSpace.exists_common_germ`: finitely many germs at a point are simultaneously
  represented by sections on one neighbourhood.
* `Stacks.RingedSpace.top_le_span_range_mk`: the classes of a generating family of an ideal span
  its cotangent fibre.
* `Stacks.RingedSpace.exists_basis_idealCotangentFiber`: a quasi-regular generating sequence
  gives a basis of the cotangent fibre.
* `Stacks.RingedSpace.card_eq_of_basis_idealCotangentFiber`: every basis of the cotangent fibre
  at a point of the support has the same length as such a generating sequence.
* `Stacks.RingedSpace.exists_invertible_change_of_local_generators`: the comparison of local
  generators described above.

## Implementation notes

Generation and quasi-regularity on an open set are expressed stalkwise, which avoids choosing a
restricted locally ringed space while keeping exactly the local meaning of both conditions. An
invertible matrix is expressed by `IsUnit` in the square matrix ring.

`stalkIdeal` is the ideal *generated* by the germs of sections of `J`; because `J` is a
submodule subsheaf those germs are already closed under addition and under multiplication by
germs of `O_X`, which is `stalkIdeal_eq_germIdeal`. That identity is what lets a germ lying in
`J_x` be realised by an honest section of `J` after shrinking.

The length comparison `r = s` rests on the degree-one part of quasi-regularity
(`RingTheory.Sequence.IsQuasiRegular.coeff_mem_Jid`): it gives linear independence of the
classes of the `g_j` in `J_x / 𝔪_x J_x`, while generation gives that they span, so they form a
second basis and the two index sets have the same cardinality. Invertibility of the comparison
matrix is then invertibility of a change-of-basis matrix over the residue field, which is
lifted to the stalk because a local ring detects units modulo its maximal ideal, and from the
stalk to a neighbourhood by `AlgebraicGeometry.RingedSpace.basicOpen` of the determinant. The
residue field is `X.presheaf.stalk x ⧸ IsLocalRing.maximalIdeal _`, whose `Field` instance is
supplied explicitly since it is found through `Ideal.Quotient.field` rather than through
`IsLocalRing.ResidueField`.

The universe is the one forced by `LocallyRingedSpace.{u}`: sections, stalks and the index sets
of the two generating sequences all live in it, and nothing here is universe-polymorphic beyond
that.

## References

* [Stacks Project, Tag 067N](https://stacks.math.columbia.edu/tag/067N), part (1).
* [Stacks Project, Tag 063H](https://stacks.math.columbia.edu/tag/063H), the characterisation of
  quasi-regular ideal sheaves whose proof this comparison feeds.
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry RingTheory.Sequence

universe u

namespace Stacks.RingedSpace

/-- The structure sheaf as a rank-one sheaf of modules over itself. -/
noncomputable abbrev structureSheafModule (X : RingedSpace.{u}) : SheafOfModules.{u}
    ((sheafCompose (Opens.grothendieckTopology X)
      (forget₂ CommRingCat.{u} RingCat.{u})).obj X.sheaf) :=
  SheafOfModules.unit _

variable {X : LocallyRingedSpace.{u}}
  (J : (structureSheafModule X.toRingedSpace).Submodule)

/-- The set of germs at `x` of sections of an ideal subsheaf. -/
def germSet (x : X) : Set (X.presheaf.stalk x) :=
  {a | ∃ (U : Opens X) (hx : x ∈ U) (s : X.presheaf.obj (op U)),
    s ∈ J.obj (op U) ∧ X.presheaf.germ U x hx s = a}

/-- The stalk at `x` of an ideal subsheaf of the structure sheaf. -/
noncomputable def stalkIdeal (x : X) : Ideal (X.presheaf.stalk x) :=
  Ideal.span (germSet J x)

/-- The restriction of a section of an ideal subsheaf is again a section of it. -/
lemma restrict_mem {U V : Opens X} (i : V ⟶ U) {s : X.presheaf.obj (op U)}
    (hs : s ∈ J.obj (op U)) : X.presheaf.map i.op s ∈ J.obj (op V) :=
  J.map_mem i.op hs

/-- The germ at `x` of a section of an ideal subsheaf lies in `germSet J x`. -/
lemma germ_mem_germSet {U : Opens X} {x : X} (hx : x ∈ U) {s : X.presheaf.obj (op U)}
    (hs : s ∈ J.obj (op U)) : X.presheaf.germ U x hx s ∈ germSet J x :=
  ⟨U, hx, s, hs, rfl⟩

/-- The germs at `x` of the sections of an ideal subsheaf form an ideal of the stalk. -/
noncomputable def germIdeal (x : X) : Ideal (X.presheaf.stalk x) where
  carrier := germSet J x
  zero_mem' := ⟨⊤, trivial, 0, Submodule.zero_mem _, by simp⟩
  add_mem' := by
    rintro a c ⟨U, hxU, s, hs, rfl⟩ ⟨V, hxV, t, ht, rfl⟩
    have hxUV : x ∈ U ⊓ V := ⟨hxU, hxV⟩
    refine ⟨U ⊓ V, hxUV,
      X.presheaf.map (homOfLE (inf_le_left (a := U) (b := V))).op s +
        X.presheaf.map (homOfLE (inf_le_right (a := U) (b := V))).op t,
      add_mem (restrict_mem J _ hs) (restrict_mem J _ ht), by simp⟩
  smul_mem' := by
    rintro c a ⟨U, hxU, s, hs, rfl⟩
    obtain ⟨V, hxV, t, rfl⟩ := X.presheaf.exists_germ_eq c
    have hxUV : x ∈ U ⊓ V := ⟨hxU, hxV⟩
    refine ⟨U ⊓ V, hxUV,
      X.presheaf.map (homOfLE (inf_le_right (a := U) (b := V))).op t *
        X.presheaf.map (homOfLE (inf_le_left (a := U) (b := V))).op s,
      Submodule.smul_mem _ _ (restrict_mem J _ hs), by simp⟩

/-- A germ lies in `germIdeal J x` if and only if it lies in `germSet J x`. -/
@[simp]
lemma mem_germIdeal_iff {x : X} {a : X.presheaf.stalk x} :
    a ∈ germIdeal J x ↔ a ∈ germSet J x := Iff.rfl

/-- The germs of sections of an ideal subsheaf already form an ideal, so no span is needed. -/
lemma stalkIdeal_eq_germIdeal (x : X) : stalkIdeal J x = germIdeal J x :=
  Ideal.span_eq (germIdeal J x)

/-- A germ at `x` lies in the stalk `J_x` if and only if it is the germ of a section of `J` on
some neighbourhood of `x`. -/
lemma mem_stalkIdeal_iff {x : X} {a : X.presheaf.stalk x} :
    a ∈ stalkIdeal J x ↔ ∃ (U : Opens X) (hx : x ∈ U) (s : X.presheaf.obj (op U)),
      s ∈ J.obj (op U) ∧ X.presheaf.germ U x hx s = a := by
  rw [stalkIdeal_eq_germIdeal]
  exact Iff.rfl

/-- Membership in an ideal subsheaf is a stalkwise condition. -/
lemma mem_of_germ_mem {V : Opens X} (s : X.presheaf.obj (op V))
    (hs : ∀ (y : X) (hy : y ∈ V), X.presheaf.germ V y hy s ∈ stalkIdeal J y) :
    s ∈ J.obj (op V) := by
  refine J.isSheaf s ?_
  rw [Opens.mem_grothendieckTopology]
  intro y hy
  obtain ⟨W, hyW, u, hu, hgu⟩ := mem_stalkIdeal_iff J |>.mp (hs y hy)
  obtain ⟨Z, hyZ, iZV, iZW, hZ⟩ := X.presheaf.germ_eq y hy hyW s u hgu.symm
  refine ⟨Z, iZV, ?_, hyZ⟩
  change X.presheaf.map iZV.op s ∈ J.obj (op Z)
  rw [hZ]
  exact restrict_mem J iZW hu

/-- Finitely many germs at a point are simultaneously represented on one neighbourhood. -/
lemma exists_common_germ (x : X) {ι : Type*} (F : ι → X.presheaf.stalk x) (t : Finset ι) :
    ∃ (U : Opens X) (hx : x ∈ U) (σ : ι → X.presheaf.obj (op U)),
      ∀ i ∈ t, X.presheaf.germ U x hx (σ i) = F i := by
  classical
  induction t using Finset.induction with
  | empty => exact ⟨⊤, trivial, fun _ ↦ 0, by simp⟩
  | insert i t hi ih =>
    obtain ⟨U₁, hx₁, σ₁, hσ₁⟩ := ih
    obtain ⟨U₂, hx₂, s₂, hs₂⟩ := X.presheaf.exists_germ_eq (F i)
    have hx₁₂ : x ∈ U₁ ⊓ U₂ := ⟨hx₁, hx₂⟩
    refine ⟨U₁ ⊓ U₂, hx₁₂,
      Function.update
        (fun k ↦ X.presheaf.map (homOfLE (inf_le_left (a := U₁) (b := U₂))).op (σ₁ k)) i
        (X.presheaf.map (homOfLE (inf_le_right (a := U₁) (b := U₂))).op s₂), ?_⟩
    intro k hk
    by_cases hki : k = i
    · subst hki
      rwa [Function.update_self, X.presheaf.germ_res_apply]
    · rw [Function.update_of_ne hki, X.presheaf.germ_res_apply]
      exact hσ₁ k (by simpa [hki] using hk)

/-- The cotangent fibre `J_x / 𝔪_x J_x` of an ideal subsheaf at a point. -/
noncomputable abbrev idealCotangentFiber (x : X) :=
  stalkIdeal J x ⧸
    (IsLocalRing.maximalIdeal (X.presheaf.stalk x) •
      (⊤ : Submodule (X.presheaf.stalk x) (stalkIdeal J x)))

/-- The class of a combination of elements of an ideal is the combination of their classes. -/
private theorem mk_sum_smul_eq {R : Type*} [CommRing R] (m : Ideal R) {I : Ideal R} {s : ℕ}
    (v : Fin s → I) (cc : Fin s → R) :
    (Submodule.Quotient.mk (∑ j, cc j • v j) : I ⧸ (m • (⊤ : Submodule R I))) =
      ∑ j, Ideal.Quotient.mk m (cc j) • Submodule.Quotient.mk (v j) := by
  rw [← Submodule.mkQ_apply, map_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [Submodule.mkQ_apply, Module.Quotient.mk_smul_mk]

/-- The underlying element of a combination of elements of an ideal. -/
private theorem coe_sum_smul_mk {R : Type*} [CommRing R] {I : Ideal R} {s : ℕ}
    (gg : Fin s → R) (hmem : ∀ j, gg j ∈ I) (cc : Fin s → R) :
    ((∑ j, cc j • (⟨gg j, hmem j⟩ : I) : I) : R) = ∑ j, cc j • gg j := by
  rw [AddSubmonoidClass.coe_finsetSum]
  rfl

/-- An element of an ideal equals any combination of generators that has the same value in the
ring. -/
private theorem eq_sum_smul_of_coe_eq {R : Type*} [CommRing R] {I : Ideal R} {s : ℕ}
    (gg : Fin s → R) (hmem : ∀ j, gg j ∈ I) (y : I) (cc : Fin s → R)
    (h : ∑ j, cc j • gg j = (y : R)) : y = ∑ j, cc j • (⟨gg j, hmem j⟩ : I) :=
  Subtype.ext <| by rw [coe_sum_smul_mk, h]

/-- **The classes of a generating family of an ideal span the quotient of that ideal by any
multiple of it.** For the maximal ideal `𝔪` of a local ring, generators of `I` span the
cotangent fibre `I / 𝔪 I`. -/
lemma top_le_span_range_mk {R : Type*} [CommRing R] (m : Ideal R) {I : Ideal R} {s : ℕ}
    (gg : Fin s → R) (hI : I = Ideal.span (Set.range gg)) (hmem : ∀ j, gg j ∈ I) :
    ⊤ ≤ Submodule.span (R ⧸ m) (Set.range fun j ↦
      (Submodule.Quotient.mk ⟨gg j, hmem j⟩ : I ⧸ (m • (⊤ : Submodule R I)))) := by
  intro t _
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ t
  obtain ⟨cc, hcc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp (hI.le y.2)
  rw [eq_sum_smul_of_coe_eq gg hmem y cc hcc, mk_sum_smul_eq]
  exact Submodule.sum_mem _ fun j _ ↦
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)

/-- A quasi-regular sequence of local generators of an ideal subsheaf gives a basis of the
cotangent fibre at a point of the support. -/
lemma exists_basis_idealCotangentFiber {x : X} (hsupp : stalkIdeal J x ≠ ⊤) {s : ℕ}
    (gg : Fin s → X.presheaf.stalk x) (hI : stalkIdeal J x = Jid gg)
    (hqr : IsQuasiRegular (X.presheaf.stalk x) (List.ofFn gg)) :
    ∃ bg : Module.Basis (Fin s)
      (X.presheaf.stalk x ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk x))
      (idealCotangentFiber J x),
      ∀ j, bg j = Submodule.Quotient.mk ⟨gg j, hI ▸ Ideal.subset_span ⟨j, rfl⟩⟩ := by
  have hmem : ∀ j, gg j ∈ stalkIdeal J x := fun j ↦ hI ▸ Ideal.subset_span ⟨j, rfl⟩
  set v : Fin s → stalkIdeal J x := fun j ↦ ⟨gg j, hmem j⟩
  set w : Fin s → idealCotangentFiber J x := fun j ↦ Submodule.Quotient.mk (v j)
  have hspan : ⊤ ≤ Submodule.span
      (X.presheaf.stalk x ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (Set.range w) :=
    top_le_span_range_mk _ gg hI hmem
  have hli : LinearIndependent
      (X.presheaf.stalk x ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk x)) w := by
    rw [Fintype.linearIndependent_iff]
    intro cbar hsum j
    choose lam hlam using fun j ↦ Ideal.Quotient.mk_surjective (I := IsLocalRing.maximalIdeal
      (X.presheaf.stalk x)) (cbar j)
    have hsum' : (Submodule.Quotient.mk (∑ j, lam j • v j) : idealCotangentFiber J x) = 0 := by
      rw [mk_sum_smul_eq]
      simpa only [hlam] using hsum
    have hmemsmul : (∑ j, lam j • v j) ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) •
          (⊤ : Submodule (X.presheaf.stalk x) (stalkIdeal J x)) :=
      (Submodule.Quotient.mk_eq_zero _).mp hsum'
    rw [Submodule.mem_smul_top_iff, coe_sum_smul_mk gg hmem, hI] at hmemsmul
    obtain ⟨ww, hww, hweq⟩ := RingTheory.Sequence.exists_coeff_mem_of_mem_smul_Jid hmemsmul
    have hdiff : ∑ j, (lam j - ww j) * gg j = 0 := by
      rw [Finset.sum_congr rfl (fun j _ ↦ sub_mul (lam j) (ww j) (gg j)),
        Finset.sum_sub_distrib, ← hweq]
      simp only [smul_eq_mul]
      exact sub_self _
    have hin := hqr.coeff_mem_Jid (fun j ↦ lam j - ww j)
      (by rw [hdiff]; exact Submodule.zero_mem _) j
    rw [← hI] at hin
    rw [← hlam j, Ideal.Quotient.eq_zero_iff_mem]
    simpa using add_mem (IsLocalRing.le_maximalIdeal hsupp hin) (hww j)
  exact ⟨Module.Basis.mk hli hspan, fun j ↦ by rw [Module.Basis.mk_apply]⟩

/-- A square matrix of sections whose determinant is a unit at `x` becomes invertible after
restricting to the basic open set of its determinant. -/
lemma exists_invertible_restriction {U₁ : Opens X} {r : ℕ} (x : X) (hxU₁ : x ∈ U₁)
    (a₁ : Matrix (Fin r) (Fin r) (X.presheaf.obj (op U₁)))
    (hdet : IsUnit (X.presheaf.germ U₁ x hxU₁ a₁.det)) :
    ∃ (U : Opens X) (_hxU : x ∈ U) (iU : U ⟶ U₁)
      (a : Matrix (Fin r) (Fin r) (X.presheaf.obj (op U))),
      IsUnit a ∧ ∀ i j, a i j = X.presheaf.map iU.op (a₁ i j) := by
  set iU : (X.toRingedSpace.basicOpen a₁.det : Opens X) ⟶ U₁ :=
    homOfLE (X.toRingedSpace.basicOpen_le a₁.det)
  have hu : IsUnit (X.presheaf.map iU.op a₁.det) :=
    X.toRingedSpace.isUnit_res_basicOpen a₁.det
  have hdet2 : Matrix.det (fun i j ↦ X.presheaf.map iU.op (a₁ i j))
      = X.presheaf.map iU.op a₁.det := ((X.presheaf.map iU.op).hom.map_det a₁).symm
  exact ⟨X.toRingedSpace.basicOpen a₁.det,
    (AlgebraicGeometry.RingedSpace.mem_basicOpen _ a₁.det x hxU₁).mpr hdet, iU,
    fun i j ↦ X.presheaf.map iU.op (a₁ i j),
    (Matrix.isUnit_iff_isUnit_det _).mpr (hdet2 ▸ hu), fun _ _ ↦ rfl⟩

/-- Two local generating sequences of an ideal subsheaf that are quasi-regular at `x` have the
same length as any basis of the cotangent fibre at `x`. -/
lemma card_eq_of_basis_idealCotangentFiber {x : X} (hsupp : stalkIdeal J x ≠ ⊤) {r s : ℕ}
    (b : Module.Basis (Fin r)
      (X.presheaf.stalk x ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk x))
      (idealCotangentFiber J x))
    (gg : Fin s → X.presheaf.stalk x) (hI : stalkIdeal J x = Jid gg)
    (hqr : IsQuasiRegular (X.presheaf.stalk x) (List.ofFn gg)) : r = s := by
  obtain ⟨bg, -⟩ := exists_basis_idealCotangentFiber J hsupp gg hI hqr
  have : Field (X.presheaf.stalk x ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk x)) :=
    Ideal.Quotient.field _
  simpa using (Module.finrank_eq_card_basis b).symm.trans (Module.finrank_eq_card_basis bg)

/-- A lift of a basis of the cotangent fibre is expressed in terms of quasi-regular local
generators by a matrix whose determinant is a unit in the stalk. -/
lemma exists_unit_det_coeff_matrix {x : X} (hsupp : stalkIdeal J x ≠ ⊤) {r : ℕ}
    (f : Fin r → stalkIdeal J x)
    (b : Module.Basis (Fin r)
      (X.presheaf.stalk x ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk x))
      (idealCotangentFiber J x))
    (hf : ∀ i, b i = Submodule.Quotient.mk (f i))
    (gg : Fin r → X.presheaf.stalk x) (hI : stalkIdeal J x = Jid gg)
    (hqr : IsQuasiRegular (X.presheaf.stalk x) (List.ofFn gg)) :
    ∃ M : Matrix (Fin r) (Fin r) (X.presheaf.stalk x),
      IsUnit M.det ∧ ∀ i, ∑ j, M i j • gg j = (f i : X.presheaf.stalk x) := by
  classical
  obtain ⟨bg, hbg⟩ := exists_basis_idealCotangentFiber J hsupp gg hI hqr
  have hcoeff : ∀ i, ∃ cc : Fin r → X.presheaf.stalk x,
      ∑ j, cc j • gg j = (f i : X.presheaf.stalk x) :=
    fun i ↦ (Submodule.mem_span_range_iff_exists_fun (X.presheaf.stalk x)).mp (hI.le (f i).2)
  choose c hc using hcoeff
  refine ⟨fun i j ↦ c i j, ?_, hc⟩
  have hbgtoM : bg.toMatrix b = Matrix.transpose
      ((Ideal.Quotient.mk (IsLocalRing.maximalIdeal (X.presheaf.stalk x))).mapMatrix
        (fun i j ↦ c i j)) := by
    ext j i
    rw [Module.Basis.toMatrix_apply, hf i]
    have hexp : (Submodule.Quotient.mk (f i) : idealCotangentFiber J x)
        = ∑ k, (Ideal.Quotient.mk
            (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (c i k)) • bg k := by
      rw [eq_sum_smul_of_coe_eq gg (fun k ↦ hI ▸ Ideal.subset_span ⟨k, rfl⟩) (f i) (c i) (hc i),
        mk_sum_smul_eq]
      exact Finset.sum_congr rfl fun k _ ↦ by rw [hbg k]
    rw [hexp, Module.Basis.repr_sum_self]
    rfl
  let _ := Module.Basis.invertibleToMatrix bg b
  have hT : IsUnit (Matrix.transpose ((Ideal.Quotient.mk
      (IsLocalRing.maximalIdeal (X.presheaf.stalk x))).mapMatrix (fun i j ↦ c i j))) :=
    hbgtoM ▸ isUnit_of_invertible (bg.toMatrix b)
  have hmapdet : (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (X.presheaf.stalk x)))
      (Matrix.det (fun i j ↦ c i j))
      = Matrix.det ((Ideal.Quotient.mk
        (IsLocalRing.maximalIdeal (X.presheaf.stalk x))).mapMatrix (fun i j ↦ c i j)) :=
    RingHom.map_det _ _
  rw [Matrix.isUnit_iff_isUnit_det, Matrix.det_transpose, ← hmapdet] at hT
  rw [← IsLocalRing.notMem_maximalIdeal]
  intro hmem
  rw [(Ideal.Quotient.eq_zero_iff_mem).mpr hmem] at hT
  exact (not_isUnit_zero (M₀ := X.presheaf.stalk x ⧸
    IsLocalRing.maximalIdeal (X.presheaf.stalk x))) hT

/-- A square matrix over a stalk with unit determinant is the germ of an invertible matrix of
sections on a neighbourhood contained in any given neighbourhood. -/
lemma exists_invertible_sections_of_unit_det {x : X} {r : ℕ}
    (M : Matrix (Fin r) (Fin r) (X.presheaf.stalk x)) (hM : IsUnit M.det)
    (V : Opens X) (hxV : x ∈ V) :
    ∃ (U : Opens X) (hxU : x ∈ U) (_iUV : U ⟶ V)
      (a : Matrix (Fin r) (Fin r) (X.presheaf.obj (op U))),
      IsUnit a ∧ ∀ i j, X.presheaf.germ U x hxU (a i j) = M i j := by
  classical
  obtain ⟨W, hxW, σ, hσ⟩ := exists_common_germ x (fun p : Fin r × Fin r ↦ M p.1 p.2) Finset.univ
  have hxWV : x ∈ W ⊓ V := ⟨hxW, hxV⟩
  set a₁ : Matrix (Fin r) (Fin r) (X.presheaf.obj (op (W ⊓ V))) :=
    fun i j ↦ X.presheaf.map (homOfLE (inf_le_left (a := W) (b := V))).op (σ (i, j)) with ha₁
  have hgerma₁ : ∀ i j, X.presheaf.germ (W ⊓ V) x hxWV (a₁ i j) = M i j := fun i j ↦ by
    rw [ha₁, X.presheaf.germ_res_apply]
    exact hσ (i, j) (Finset.mem_univ _)
  have hdetgerm : X.presheaf.germ (W ⊓ V) x hxWV a₁.det = M.det := by
    rw [(X.presheaf.germ (W ⊓ V) x hxWV).hom.map_det a₁]
    congr 1
    ext i j
    exact hgerma₁ i j
  obtain ⟨U, hxU, iU, a, haunit, ha⟩ :=
    exists_invertible_restriction x hxWV a₁ (by rwa [hdetgerm])
  exact ⟨U, hxU, iU ≫ homOfLE inf_le_right, a, haunit, fun i j ↦ by
    rw [ha i j, X.presheaf.germ_res_apply]; exact hgerma₁ i j⟩

/-- **Invertible change of local generators.** Let `J` be an ideal subsheaf of the structure
sheaf of a locally ringed space, let `x` be a point of the support of `O_X / J`, and let
`f_1, …, f_r ∈ J_x` lift a basis of `J_x / 𝔪_x J_x`. If `J` is generated on a neighbourhood `V`
of `x` by a sequence `g_1, …, g_s` which is quasi-regular at every point of `V`, then `r = s`
and, after shrinking `V` to a smaller neighbourhood `U`, the `f_i` are sections of `J` over `U`
obtained from the `g_j` by an invertible matrix of sections of `O_X` over `U`. -/
theorem exists_invertible_change_of_local_generators
    (x : X) {r s : ℕ} (f : Fin r → stalkIdeal J x)
    (b : Module.Basis (Fin r)
      (X.presheaf.stalk x ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk x))
      (idealCotangentFiber J x))
    (hf : ∀ i, b i = Submodule.Quotient.mk (f i))
    (hsupp : stalkIdeal J x ≠ ⊤)
    (V : Opens X) (hxV : x ∈ V) (g : Fin s → X.presheaf.obj (op V))
    (hgen : ∀ (y : X) (hy : y ∈ V), stalkIdeal J y =
      Jid (fun j ↦ X.presheaf.germ V y hy (g j)))
    (hqr : ∀ (y : X) (hy : y ∈ V), IsQuasiRegular (X.presheaf.stalk y)
      (List.ofFn fun j ↦ X.presheaf.germ V y hy (g j))) :
    ∃ (hrs : r = s) (U : Opens X) (hxU : x ∈ U) (iUV : U ⟶ V)
      (fU : Fin r → J.obj (op U)) (a : Matrix (Fin r) (Fin r) (X.presheaf.obj (op U))),
      IsUnit a ∧
        (∀ i, X.presheaf.germ U x hxU (fU i).1 = f i) ∧
        (∀ i, (fU i).1 =
          ∑ j, a i j * X.presheaf.map iUV.op (g (Fin.cast hrs j))) := by
  have hI : stalkIdeal J x = Jid (fun j ↦ X.presheaf.germ V x hxV (g j)) := hgen x hxV
  have hrs : r = s := card_eq_of_basis_idealCotangentFiber J hsupp b _ hI (hqr x hxV)
  subst hrs
  have hgJ : ∀ j, g j ∈ J.obj (op V) := fun j ↦ mem_of_germ_mem J (g j) fun y hy ↦
    hgen y hy ▸ Ideal.subset_span ⟨j, rfl⟩
  obtain ⟨M, hMunit, hMc⟩ :=
    exists_unit_det_coeff_matrix J hsupp f b hf _ hI (hqr x hxV)
  obtain ⟨U, hxU, iUV, a, haunit, hgerma⟩ :=
    exists_invertible_sections_of_unit_det M hMunit V hxV
  refine ⟨rfl, U, hxU, iUV,
    fun i ↦ ⟨∑ j, a i j * X.presheaf.map iUV.op (g j), ?_⟩, a, haunit, ?_, fun _ ↦ rfl⟩
  · exact Submodule.sum_mem _ fun j _ ↦
      Submodule.smul_mem (J.obj (op U)) (a i j) (restrict_mem J iUV (hgJ j))
  · intro i
    change X.presheaf.germ U x hxU (∑ j, a i j * X.presheaf.map iUV.op (g j))
      = (f i : X.presheaf.stalk x)
    rw [map_sum, ← hMc i]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [map_mul, smul_eq_mul, hgerma i j, X.presheaf.germ_res_apply]

end Stacks.RingedSpace
