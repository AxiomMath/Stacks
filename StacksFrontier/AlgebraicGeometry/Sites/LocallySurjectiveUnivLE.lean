module

public import Mathlib.CategoryTheory.Sites.LocallyInjective
public import Mathlib.CategoryTheory.Sites.LocallySurjective
public import StacksFrontier.CategoryTheory.Sites.Sheafification.LocallyInjectiveWide
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Local surjectivity and local injectivity of the plus construction at a bounded coefficient
universe

For a Grothendieck topology `J` on a category `C`, the unit of the plus construction and the
comparison map to the sheafification obtained by iterating it are locally surjective and locally
injective: a section of `J.plusObj P` is by construction represented by a compatible family on a
covering sieve, and two sections with the same image already agree on one.

## Main results

* `AlgebraicGeometry.isLocallySurjective_toPlus`:
  the unit of the plus construction.
* `AlgebraicGeometry.isLocallySurjective_toSheafify`,
  `AlgebraicGeometry.isLocallyInjective_toSheafify`: the comparison map to the sheafification.

## Implementation notes

Mathlib's `CategoryTheory.Presheaf.isLocallySurjective_toPlus` is an instance, but it constrains
the coefficient category to the universe generated by the site. The statements here take the
weaker hypothesis `UnivLE.{max z w, v}`, which is what a presheaf of `Type v` on a site with
objects in `Type z` and morphisms in `Type w` needs for the plus construction to land in
`Type v`, so they apply at a coefficient universe chosen independently of the site. The proofs
are Mathlib's, transferred verbatim.

The map here is `CategoryTheory.GrothendieckTopology.toSheafify`, into the twice-iterated plus
construction, which exists for any topology. The unit `CategoryTheory.toSheafify` of a
sheafification adjunction is a different morphism, with a different target, and local
surjectivity for it is `Stacks.Sheafification.isLocallySurjective_toSheafify_type`.

The locally-injective half is not repeated here: it is
`Stacks.Sheafification.isLocallyInjective_toPlus_type` and
`Stacks.Sheafification.isLocallyInjective_toSheafify_type` of
`StacksFrontier.CategoryTheory.Sites.Sheafification.LocallyInjectiveWide`, at the same hypothesis.

They are stated as theorems rather than instances, so that they do not compete with Mathlib's
instances during synthesis; a consumer that wants an instance at its own site declares a
one-field instance appealing to these.

The namespace is `AlgebraicGeometry` rather than `CategoryTheory.Presheaf`, where the
mathematics would put it, precisely because `CategoryTheory.Presheaf` is where Mathlib's
universe-restricted versions live: the same names there would be duplicate fully-qualified names
and the two modules could not be imported together.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe v w z

namespace AlgebraicGeometry

section Plus

open GrothendieckTopology.Plus

/-- The unit of the plus construction is locally surjective: a section of `J.plusObj P` is
represented by a family on a covering sieve. -/
@[sga "3 IV 4.3.11" "more general"]
theorem isLocallySurjective_toPlus
    {C : Type z} [Category.{w} C] (J : GrothendieckTopology C)
    [UnivLE.{max z w, v}] (P : Cᵒᵖ ⥤ Type v) :
    Presheaf.IsLocallySurjective J (J.toPlus P) where
  imageSieve_mem x := by
    obtain ⟨R, x, rfl⟩ := exists_rep x
    refine J.superset_covering (fun Y f hf ↦ ⟨x.1 ⟨Y, f, hf⟩, ?_⟩) R.2
    rw [toPlus_eq_mk, res_mk_eq_mk_pullback, eq_mk_iff_exists]
    refine ⟨R.pullback f, homOfLE le_top, 𝟙 _, ?_⟩
    ext ⟨Z, g, hg⟩
    simpa using!
      x.2 { fst.hf := hf, snd.hf := R.1.downward_closed hf g, r.g₁ := g, r.g₂ := 𝟙 Z, .. }

end Plus

/-- The comparison map to the sheafification obtained by iterating the plus construction is
locally surjective. -/
theorem isLocallySurjective_toSheafify
    {C : Type z} [Category.{w} C] (J : GrothendieckTopology C)
    [UnivLE.{max z w, v}] (P : Cᵒᵖ ⥤ Type v) :
    Presheaf.IsLocallySurjective J (J.toSheafify P) := by
  dsimp [GrothendieckTopology.toSheafify]
  rw [GrothendieckTopology.plusMap_toPlus]
  let := isLocallySurjective_toPlus J P
  let := isLocallySurjective_toPlus J (J.plusObj P)
  exact Presheaf.isLocallySurjective_comp J (J.toPlus P) (J.toPlus (J.plusObj P))

/-- The comparison map to the sheafification obtained by iterating the plus construction is
locally injective.  The plus-construction half is
`Stacks.Sheafification.isLocallyInjective_toPlus_type`; only the composition is done here, because
the canonical statement is about `CategoryTheory.toSheafify` rather than this iterated form. -/
theorem isLocallyInjective_toSheafify
    {C : Type z} [Category.{w} C] (J : GrothendieckTopology C)
    [UnivLE.{max z w, v}] (P : Cᵒᵖ ⥤ Type v) :
    Presheaf.IsLocallyInjective J (J.toSheafify P) := by
  dsimp [GrothendieckTopology.toSheafify]
  rw [GrothendieckTopology.plusMap_toPlus]
  let := Stacks.Sheafification.isLocallyInjective_toPlus_type J P
  let := Stacks.Sheafification.isLocallyInjective_toPlus_type J (J.plusObj P)
  exact Presheaf.isLocallyInjective_comp J (J.toPlus P) (J.toPlus (J.plusObj P))

end AlgebraicGeometry

end
