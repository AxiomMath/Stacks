module

public import StacksFrontier.AlgebraicGeometry.RelativeProjQcohSheaf.RelativeProjRepresentsBaseChange
public import StacksFrontier.AlgebraicGeometry.Morphism.BaseChange
public import StacksFrontier.AlgebraicGeometry.RelativeProjTwistChartBridge.ClassifyingOverBase

/-!
# The isomorphism of relative Proj induced by an isomorphism of graded algebras, on the charts

Let `Φ : A₁ ⟶ A₂` be an isomorphism of quasi-coherent graded `𝒪_S`-algebras and let
`relativeProjCongr Φ : Proj_S(A₁) ≅ Proj_S(A₂)` be the isomorphism it induces. Over an affine open
`U` of `S`, the chart of `Proj_S(A₁)` followed by `relativeProjCongr Φ` is `Proj` of the graded
ring isomorphism `Γ(U, A₂) ⟶ Γ(U, A₁)` induced by `Φ⁻¹`, followed by the chart of `Proj_S(A₂)`.
For a commuting square of graded algebra maps whose horizontal sides are such isomorphisms, the
open and the morphism of Tag 07ZG are carried into one another by them.

All names below are in the namespace `Stacks.AlgebraicGeometry.RelativeProjQcohSheaf`.

## Main results

* `veroneseSections_chartTwisting_toFun_algebraTransport`: the Veronese family of the chart-wise
  class of a transported quadruple, on a homogeneous section, is the one of the original
  quadruple on the image of the section.
* `Fd.toProj_chartEquiv_chartClass_comp_projMap_algebraTransport`: the morphism into
  `Proj Γ(V, A₁)` attached to the chart-wise class of a quadruple, followed by
  `Proj(Γ(V, A₂) ⟶ Γ(V, A₁))`, is the morphism into `Proj Γ(V, A₂)` attached to the chart-wise
  class of its transport.
* `chart_comp_relativeProjCongr_hom`: the chart formula for `relativeProjCongr`.
* `relativeProjCongr_preimage_relativeMapDomain` and `relativeMapHom_comp_relativeProjCongr`: the
  open and the morphism of Tag 07ZG along `relativeProjCongr`.

## References

* [Stacks Project, Tag 01NY](https://stacks.math.columbia.edu/tag/01NY)
* [Stacks Project, Tag 01NZ](https://stacks.math.columbia.edu/tag/01NZ)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite
open AlgebraicGeometry Stacks.RingedSpace RingedSpaceModuleAdjunction
open Stacks.AlgebraicGeometry.CoherentMulSections (powCompare)
open Stacks.AlgebraicGeometry.MorphismsIntoProj
open Stacks.AlgebraicGeometry.MorphismToProjUniversal
open Stacks.AlgebraicGeometry.ProjChartFromRatios
open Stacks.AlgebraicGeometry.ProjTripleClassifying
open Stacks.AlgebraicGeometry.RelativeProj
open Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.AlgebraicGeometry.RelativeProjMapDomain
open Stacks.NonvanishingOpen (nonvanishingOpen)
open Stacks.AlgebraicGeometry.RelativeProjInvertibleMorphism

universe u

namespace Stacks.AlgebraicGeometry.RelativeProjQcohSheaf

variable {S : Scheme.{u}} {A₁ A₂ : SheafGradedAlgebra S}
  (Φ : SheafOfModules.GradedAlgebra.UnitalHom (situationAlgebra A₁) (situationAlgebra A₂))
  (hΦ : ∀ n : ℤ, IsIso (Φ.app n))

/-- **The graded ring map of sections induced by `Φ⁻¹`**, `Γ(U, A₂) ⟶ Γ(U, A₁)`. -/
abbrev congrSectionHom (U : S.Opens) : A₂.grading U →+*ᵍ A₁.grading U :=
  (SheafGradedAlgebraHom.ofSituationHom (unitalHomInverse Φ hΦ)).sectionHom U

/-- On a homogeneous element the graded ring map of sections induced by `Φ⁻¹` is `Φ⁻¹` on its
component. -/
theorem congrSectionHom_apply_of_mem (U : S.Opens) {m : ℕ} (y : A₂.sectionRing U)
    (hy : y ∈ A₂.grading U m) :
    (congrSectionHom Φ hΦ U y : A₁.sectionRing U) m =
      ((unitalHomInverse Φ hΦ).app (m : ℤ)).val.app (op U) (y m) := by
  obtain ⟨a, rfl⟩ := hy
  rw [SheafGradedAlgebraHom.sectionHom_of, DirectSum.of_eq_same, DirectSum.of_eq_same]
  rfl

/-- The graded ring map of sections induced by `Φ⁻¹` undoes the one induced by `Φ`. -/
theorem congrSectionHom_sectionHom (U : S.Opens) (x : A₁.sectionRing U) :
    congrSectionHom Φ hΦ U ((SheafGradedAlgebraHom.ofSituationHom Φ).sectionHom U x) = x := by
  induction x using DirectSum.induction_on with
  | zero => rw [map_zero, map_zero]
  | of n a =>
    rw [SheafGradedAlgebraHom.sectionHom_of, SheafGradedAlgebraHom.sectionHom_of]
    congr 1
    exact val_app_roundtrip (Φ.app (n : ℤ)) (@inv _ _ _ _ (Φ.app (n : ℤ)) (hΦ n))
      (@IsIso.hom_inv_id _ _ _ _ (Φ.app (n : ℤ)) (hΦ n)) (op U) a
  | add x y hx hy => rw [map_add, map_add, hx, hy]

/-- The irrelevant ideal of `Γ(U, A₁)` is contained in the ideal generated by the image of the
irrelevant ideal of `Γ(U, A₂)` under the graded ring map of sections induced by `Φ⁻¹`. -/
theorem irrelevant_le_map_congrSectionHom (U : S.Opens) :
    HomogeneousIdeal.irrelevant (A₁.grading U) ≤
      (HomogeneousIdeal.irrelevant (A₂.grading U)).map (congrSectionHom Φ hΦ U) := by
  refine (HomogeneousIdeal.irrelevant_le _).2 fun i hi x hx ↦ ?_
  have hy' : (SheafGradedAlgebraHom.ofSituationHom Φ).sectionHom U x ∈ A₂.grading U i :=
    GradedRingHom.map_mem _ hx
  exact congrSectionHom_sectionHom Φ hΦ U x ▸
    Ideal.mem_map_of_mem _ (HomogeneousIdeal.mem_irrelevant_of_mem _ hi hy')

/-! ### The chart-wise Veronese family of a transported quadruple -/

section Veronese

variable {U : S.Opens} {k : ℕ} {T : Scheme.{u}} (gU : T ⟶ U.toScheme) {L : T.Modules}
  [Stacks.Ample.IsInvertibleModule T L]

/-- **The chart-wise Veronese family of a transported quadruple**, on sections of the
restrictions: for a twisting `χ` for `A₁` over `g_U ≫ U.ι`, the Veronese family of the chart-wise
class at `U` of its transport along `Φ⁻¹`, evaluated on a homogeneous global section `a` of
`A₂|_U`, is the Veronese family of the chart-wise class of `χ` evaluated on a global section of
`A₁|_U` whose component is the image of the one of `a` under `Φ⁻¹`. -/
theorem veroneseSections_chartTwisting_toFun_algebraTransport_restrict
    (χ : Twisting (gU ≫ U.ι) (situationAlgebra A₁) (k : ℤ) L) (n : ℕ)
    (a : (A₂.restrict U.ι).grading (⊤ : U.toScheme.Opens) (n * k))
    (b : (A₁.restrict U.ι).grading (⊤ : U.toScheme.Opens) (n * k))
    (hab : (b : (A₁.restrict U.ι).sectionRing (⊤ : U.toScheme.Opens)) (n * k)
      = ((unitalHomInverse Φ hΦ).app ((n * k : ℕ) : ℤ)).val.app
          (op (U.ι ''ᵁ (⊤ : Opens U.toScheme.toRingedSpace.carrier)))
          ((a : (A₂.restrict U.ι).sectionRing (⊤ : U.toScheme.Opens)) (n * k))) :
    (veroneseSections (chartTwisting A₂ U gU
        (Twisting.algebraTransport (unitalHomInverse Φ hΦ) χ))).toFun n a
      = (veroneseSections (chartTwisting A₁ U gU χ)).toFun n b := by
  set e := (homOfLE (top_le_preimage_image_top (V := U) (gV := gU))).op with he
  refine (veroneseSections_chartTwisting' A₂ U gU _ n a e).trans
    (Eq.trans ?_ (veroneseSections_chartTwisting' A₁ U gU χ n b e).symm)
  refine congrArg (fun z ↦ (powCompare L n).inv.app ⊤
    (((laurent L).piece (n : ℤ)).val.restrictₛₗ e z)) ?_
  exact (Twisting.algebraTransport_sectionHom _ χ (n : ℤ) _ _).trans (congrArg _ hab.symm)

/-- `veroneseSections_chartTwisting_toFun_algebraTransport_restrict` at the gradings of the image
open, with the section of `A₁` the image of the one of `A₂` under the graded ring map of sections
induced by `Φ⁻¹`. -/
theorem veroneseSections_chartTwisting_toFun_algebraTransport
    (χ : Twisting (gU ≫ U.ι) (situationAlgebra A₁) (k : ℤ) L) (n : ℕ)
    (y : A₂.grading (U.ι ''ᵁ (⊤ : Opens U.toScheme.toRingedSpace.carrier)) (n * k)) :
    (veroneseSections (chartTwisting A₂ U gU
        (Twisting.algebraTransport (unitalHomInverse Φ hΦ) χ))).toFun n y
      = (veroneseSections (chartTwisting A₁ U gU χ)).toFun n
          ⟨congrSectionHom Φ hΦ _ (y : A₂.sectionRing
              (U.ι ''ᵁ (⊤ : Opens U.toScheme.toRingedSpace.carrier))),
            GradedRingHom.map_mem _ y.2⟩ :=
  veroneseSections_chartTwisting_toFun_algebraTransport_restrict Φ hΦ gU χ n y _
    (congrSectionHom_apply_of_mem Φ hΦ _ _ y.2)

/-- **The Veronese family of the chart-wise class of a transported quadruple is `comapVeronese` of
the one of the original quadruple** along the graded ring map of sections induced by `Φ⁻¹`,
degreewise, at the grading read at an open `V` the image open is known to be. -/
theorem chartVeronese_algebraTransport_toFun {V : S.Opens}
    (hV : U.ι ''ᵁ (⊤ : Opens U.toScheme.toRingedSpace.carrier) = V)
    (χ : Twisting (gU ≫ U.ι) (situationAlgebra A₁) (k : ℤ) L)
    (ψ₁ : VeroneseSections (A₁.grading V) k L) (ψ₂ : VeroneseSections (A₂.grading V) k L)
    (hψ₁ : HEq (veroneseSections (chartTwisting A₁ U gU χ)) ψ₁)
    (hψ₂ : HEq (veroneseSections (chartTwisting A₂ U gU
      (Twisting.algebraTransport (unitalHomInverse Φ hΦ) χ))) ψ₂)
    (n : ℕ) (y : A₂.grading V (n * k)) :
    ψ₂.toFun n y =
      (ProjChartGradedClassifying.comapVeronese (congrSectionHom Φ hΦ V) ψ₁).toFun n y := by
  subst hV
  exact ((veroneseSections_restrict_toFun_image A₂ U L _ ψ₂ hψ₂ n y).symm.trans
    (veroneseSections_chartTwisting_toFun_algebraTransport Φ hΦ gU χ n y)).trans
      (veroneseSections_restrict_toFun_image A₁ U L _ ψ₁ hψ₁ n _)

end Veronese

/-! ### The chart-wise classifying morphisms -/

/-- **The transport comparison of charts for the classifying morphisms.** For an affine open `V`
of `S` and a quadruple `P` for `A₁` over `g_V ≫ V.ι`, the morphism into `Proj Γ(V, A₁)` attached
to the chart-wise class of `P`, followed by `Proj(Γ(V, A₂) ⟶ Γ(V, A₁))`, is the morphism into
`Proj Γ(V, A₂)` attached to the chart-wise class of the transport of `P` along `Φ⁻¹`. -/
theorem Fd.toProj_chartEquiv_chartClass_comp_projMap_algebraTransport (V : S.AffineZariskiSite)
    {k : ℕ} (hk : 0 < k) {T : Scheme.{u}} (gV : T ⟶ V.toOpens.toScheme)
    (P : Quadruple (gV ≫ V.toOpens.ι) (situationAlgebra A₁) (k : ℤ)) :
    toProj (A₁.grading V.toOpens)
          (Fd.chartEquiv A₁ V.toOpens V.2 hk T
            (Fd.chartClass A₁ V.toOpens gV (Quotient.mk _ P)))
        ≫ AlgebraicGeometry.Proj.map (congrSectionHom Φ hΦ V.toOpens)
          (irrelevant_le_map_congrSectionHom Φ hΦ V.toOpens)
      = toProj (A₂.grading V.toOpens)
          (Fd.chartEquiv A₂ V.toOpens V.2 hk T
            (Fd.chartClass A₂ V.toOpens gV (Quotient.mk _
              (P.algebraTransport (unitalHomInverse Φ hΦ)
                (isIso_unitalHomInverse_app Φ hΦ))))) := by
  have : IsAffine V.toOpens.toScheme := V.2
  set P₂ := P.algebraTransport (unitalHomInverse Φ hΦ) (isIso_unitalHomInverse_app Φ hΦ)
    with hP₂
  rw [Fd.chartClass_mk A₁ V.toOpens gV P, Fd.chartClass_mk A₂ V.toOpens gV P₂]
  set Q₁ := (P.baseChangeDown V.toOpens.ι gV (situationAlgebra A₁) (k : ℤ)).algebraTransport
      (unitalHomInverse (restrictPullbackUnitalHom A₁ V.toOpens.ι)
        (isIso_restrictPullbackUnitalHom_app_forall A₁ V.toOpens.ι))
      (isIso_unitalHomInverse_app (restrictPullbackUnitalHom A₁ V.toOpens.ι)
        (isIso_restrictPullbackUnitalHom_app_forall A₁ V.toOpens.ι)) with hQ₁
  set Q₂ := (P₂.baseChangeDown V.toOpens.ι gV (situationAlgebra A₂) (k : ℤ)).algebraTransport
      (unitalHomInverse (restrictPullbackUnitalHom A₂ V.toOpens.ι)
        (isIso_restrictPullbackUnitalHom_app_forall A₂ V.toOpens.ι))
      (isIso_unitalHomInverse_app (restrictPullbackUnitalHom A₂ V.toOpens.ι)
        (isIso_restrictPullbackUnitalHom_app_forall A₂ V.toOpens.ι)) with hQ₂
  obtain ⟨ψ₁, hψ₁⟩ := exists_veroneseSections_restrict A₁ V.toOpens (L := P.L)
    V.toOpens.ι_image_top (veroneseSections Q₁.twisting)
  have hψ₂ : HEq (veroneseSections Q₂.twisting)
      (ProjChartGradedClassifying.comapVeronese (congrSectionHom Φ hΦ V.toOpens) ψ₁) := by
    obtain ⟨ψ₂, hψ₂⟩ := exists_veroneseSections_restrict A₂ V.toOpens (L := P.L)
      V.toOpens.ι_image_top (veroneseSections Q₂.twisting)
    exact hψ₂.trans (heq_of_eq (veroneseSections_ext fun n y ↦
      chartVeronese_algebraTransport_toFun Φ hΦ gV V.toOpens.ι_image_top P.twisting ψ₁ ψ₂ hψ₁ hψ₂
        n y))
  have hgen : (⨆ f : A₂.grading V.toOpens k, nonvanishingOpen T P.L
      (psiSection (A₂.grading V.toOpens)
        (ProjChartGradedClassifying.comapVeronese (congrSectionHom Φ hΦ V.toOpens) ψ₁) f)) = ⊤ :=
    iSup_nonvanishingOpen_psiSection_restrict_heq A₂ V.toOpens (L := P.L)
      V.toOpens.ι_image_top (veroneseSections Q₂.twisting) _ hψ₂
      (Quadruple.iSup_nonvanishingOpen_psiSection_eq_top (B := A₂.restrict V.toOpens.ι) (d := k)
        (fun n ↦ (A₂.restrict V.toOpens.ι).isQuasicoherent n) Q₂)
  rw [Fd.toProj_chartEquiv_mk A₁ V.toOpens V.2 hk gV Q₁ rfl ψ₁ hψ₁
      (ProjChartGradedClassifying.iSup_nonvanishingOpen_psiSection_comapVeronese
        (congrSectionHom Φ hΦ V.toOpens) ψ₁ hgen),
    Fd.toProj_chartEquiv_mk A₂ V.toOpens V.2 hk gV Q₂ rfl _ hψ₂ hgen]
  exact ProjChartGradedClassifying.toProj_classifyingHom_comp_projMap
    (congrSectionHom Φ hΦ V.toOpens) ψ₁ (irrelevant_le_map_congrSectionHom Φ hΦ V.toOpens) hk hgen

/-- Transport along a unital homomorphism commutes with reading a quadruple over an equal
morphism. -/
theorem Quadruple.congrBaseStrict_algebraTransport {T : Scheme.{u}}
    {B₁ B₂ : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf S.toRingedSpace)}
    (Ψ : SheafOfModules.GradedAlgebra.UnitalHom B₁ B₂) (hΨ : ∀ n : ℤ, IsIso (Ψ.app n)) {d : ℤ}
    {g g' : T ⟶ S} (h : g = g') (Q : Quadruple g B₂ d) :
    Quadruple.congrBaseStrict h (Q.algebraTransport Ψ hΨ) =
      (Quadruple.congrBaseStrict h Q).algebraTransport Ψ hΨ := by
  subst h
  rfl

/-- **The classifying morphism of a quadruple whose morphism factors through an affine open `U` of
the base** is the morphism into `Proj Γ(U, A)` attached to its chart-wise class at `U`, followed by
the chart over `U`. -/
theorem F.classifyingMorphism_mk_eq_toProj_comp_chart (A : SheafGradedAlgebra S) (U : S.Opens)
    (hU : IsAffineOpen U) {k : ℕ} (hk : 0 < k) {W : Scheme.{u}} (gU : W ⟶ U.toScheme)
    (g : W ⟶ S) (hg : g = gU ≫ U.ι) (Q : Quadruple g (situationAlgebra A) (k : ℤ)) :
    F.classifyingMorphism A (F.mk g (by exact_mod_cast hk) Q) =
      toProj (A.grading U) (Fd.chartEquiv A U hU hk W
          (Fd.chartClass A U gU (Quotient.mk _ (Quadruple.congrBaseStrict hg Q)))) ≫
        (relativeProj A).chart U hU := by
  subst hg
  have hQ : Quadruple.congrBaseStrict (rfl : gU ≫ U.ι = gU ≫ U.ι) Q = Q := rfl
  rw [hQ, F.classifyingMorphism_mk A hk, canonicalIso_relativeProj, Iso.refl_inv,
    Category.comp_id]
  set η0 := Fd.chartClass A U gU (Quotient.mk (Quadruple.setoid (gU ≫ U.ι) (situationAlgebra A)
    (k : ℤ)) Q)
  set ξ : Fd (situationAlgebra A) (k : ℤ) W := Fd.mk (gU ≫ U.ι) Q
  have hη : Fd.chartClassInv A U (Fd.pullback (ξ.1 ⁻¹ᵁ U).ι η0) =
      Fd.pullback (ξ.1 ⁻¹ᵁ U).ι ξ := by
    rw [Fd.chartClassInv_pullback]
    exact congrArg (Fd.pullback _) (Fd.chartClassInv_chartClass A U gU _)
  have h1 := Fd.ι_homDegreeOpen A (relativeProj A) hk ξ U hU _ hη
  rw [Fd.chartHom_pullback] at h1
  have hepi : ∀ o : W.Opens, o = ⊤ → Epi o.ι := fun o h ↦ by
    subst h
    exact (Scheme.topIso W).isIso_hom.epi_of_iso
  have := hepi (ξ.1 ⁻¹ᵁ U) (top_unique fun y _ ↦ (gU.base y).2)
  rw [← Fd.chartHom_eq_toProj_comp_chart A U (relativeProj A) hU hk W]
  exact (cancel_epi (ξ.1 ⁻¹ᵁ U).ι).1 h1

/-- **The isomorphism of relative Proj induced by `Φ`, on the charts.** Over an affine open `U` of
`S`, the chart of `Proj_S(A₁)` followed by `relativeProjCongr Φ` is `Proj` of the graded ring map
`Γ(U, A₂) ⟶ Γ(U, A₁)` induced by `Φ⁻¹`, followed by the chart of `Proj_S(A₂)`. -/
theorem chart_comp_relativeProjCongr_hom (U : S.Opens) (hU : IsAffineOpen U) :
    (relativeProj A₁).chart U hU ≫ (relativeProjCongr Φ hΦ).hom =
      AlgebraicGeometry.Proj.map (congrSectionHom Φ hΦ U)
          (irrelevant_le_map_congrSectionHom Φ hΦ U) ≫ (relativeProj A₂).chart U hU := by
  refine Scheme.hom_ext_of_forall _ _ fun x ↦ ?_
  obtain ⟨_, ⟨O₀, hO, rfl⟩, hxO, -⟩ :=
    (AlgebraicGeometry.Proj (A₁.grading U)).isBasis_affineOpens.exists_subset_of_mem_open
      (Set.mem_univ x) isOpen_univ
  set O : (AlgebraicGeometry.Proj (A₁.grading U)).Opens := O₀ with hOdef
  replace hO : IsAffineOpen O := hO
  refine ⟨O, hxO, ?_⟩
  have : IsAffine O.toScheme := hO
  have hW : CompactSpace O.toScheme := inferInstance
  set m := O.ι ≫ (relativeProj A₁).chart U hU with hm
  set ζ₁ := ((relativeProjRepresentableByFunctorUnconditional A₁).homEquiv m).val _ hW (𝟙 _)
    with hζ₁
  have hcl₁ : F.classifyingMorphism A₁ ζ₁ = m := classifyingMorphism_homEquiv_val A₁ hW m
  have hL : O.ι ≫ (relativeProj A₁).chart U hU ≫ (relativeProjCongr Φ hΦ).hom =
      F.classifyingMorphism A₂ (F.algebraTransport (unitalHomInverse Φ hΦ)
        (isIso_unitalHomInverse_app Φ hΦ) ζ₁) := by
    rw [← homEquiv_comp_relativeProjCongr_val Φ hΦ m _ hW (𝟙 _), ← Category.assoc,
      classifyingMorphism_homEquiv_val]
  obtain ⟨d, hd, Q, hQ⟩ := F.exists_quadruple ζ₁
  obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hd.le
  have hk : 0 < k := by exact_mod_cast hd
  have hg : ζ₁.1 = (O.ι ≫ projInclusionToOpen A₁ U hU) ≫ U.ι := by
    rw [← F.classifyingMorphism_comp_toBase A₁ ζ₁, hcl₁, hm, Category.assoc,
      chart_comp_toBase, Category.assoc]
  have hmk : F.mk ζ₁.1 (by exact_mod_cast hk) Q = ζ₁ := hQ
  have h₁ := F.classifyingMorphism_mk_eq_toProj_comp_chart A₁ U hU hk _ ζ₁.1 hg Q
  rw [hmk, hcl₁, hm] at h₁
  have hO' : O.ι = toProj (A₁.grading U) (Fd.chartEquiv A₁ U hU hk O.toScheme
      (Fd.chartClass A₁ U (O.ι ≫ projInclusionToOpen A₁ U hU)
        (Quotient.mk _ (Quadruple.congrBaseStrict hg Q)))) :=
    (cancel_mono ((relativeProj A₁).chart U hU)).1 h₁
  rw [hL, ← hmk, F.algebraTransport_mk,
    F.classifyingMorphism_mk_eq_toProj_comp_chart A₂ U hU hk _ ζ₁.1 hg]
  conv_rhs => rw [hO', ← Category.assoc,
    Fd.toProj_chartEquiv_chartClass_comp_projMap_algebraTransport Φ hΦ ⟨U, hU⟩ hk]
  rw [Quadruple.congrBaseStrict_algebraTransport]

/-! ### Tag 07ZG along the isomorphism of relative Proj -/

section MapDomain

open Stacks.AlgebraicGeometry.Tag07ZGMorphism

variable {B₁ B₂ : SheafGradedAlgebra S}
  (Φ' : SheafOfModules.GradedAlgebra.UnitalHom (situationAlgebra B₁) (situationAlgebra B₂))
  (hΦ' : ∀ n : ℤ, IsIso (Φ'.app n))
  (ψ₁ : SheafGradedAlgebraHom A₁ B₁) (ψ₂ : SheafGradedAlgebraHom A₂ B₂)
  (hsq : ∀ n : ℤ, ψ₁.toSituationHom.app n ≫ Φ'.app n = Φ.app n ≫ ψ₂.toSituationHom.app n)

include hsq in
/-- The square of graded ring maps of sections induced by the inverses commutes. -/
theorem congrSectionHom_comp_sectionHom (U : S.Opens) :
    (congrSectionHom Φ' hΦ' U).comp (ψ₂.sectionHom U) =
      (ψ₁.sectionHom U).comp (congrSectionHom Φ hΦ U) := by
  refine GradedRingHom.ext fun x ↦ ?_
  rw [GradedRingHom.comp_apply, GradedRingHom.comp_apply]
  induction x using DirectSum.induction_on with
  | zero => rw [map_zero, map_zero, map_zero, map_zero]
  | of n a =>
    rw [ψ₂.sectionHom_of, SheafGradedAlgebraHom.sectionHom_of,
      SheafGradedAlgebraHom.sectionHom_of, ψ₁.sectionHom_of]
    congr 1
    have h : (ψ₂.toSituationHom.app (n : ℤ) ≫ @inv _ _ _ _ (Φ'.app (n : ℤ)) (hΦ' n) :
          (situationAlgebra A₂).piece (n : ℤ) ⟶ (situationAlgebra B₁).piece (n : ℤ)) =
        @inv _ _ _ _ (Φ.app (n : ℤ)) (hΦ n) ≫ ψ₁.toSituationHom.app (n : ℤ) := by
      have := hΦ n
      have := hΦ' n
      rw [IsIso.eq_inv_comp, ← Category.assoc, ← hsq, Category.assoc, IsIso.hom_inv_id,
        Category.comp_id]
    exact congrArg (fun z ↦ z.val.app (op U) a) h
  | add x y hx hy => rw [map_add, map_add, map_add, map_add, hx, hy]

include hsq in
/-- **The chart square of the isomorphisms of relative Proj induced by `Φ` and `Φ'`** over an
affine open `U` of the base. -/
def congrChartSquare (U : S.Opens) (hU : IsAffineOpen U) :
    ChartSquare ψ₂ ψ₁ (relativeProjCongr Φ hΦ).hom (relativeProjCongr Φ' hΦ').hom U hU where
  W := U
  hW := hU
  σA := congrSectionHom Φ hΦ U
  σB := congrSectionHom Φ' hΦ' U
  hσA := irrelevant_le_map_congrSectionHom Φ hΦ U
  hσB := irrelevant_le_map_congrSectionHom Φ' hΦ' U
  chart_cA := chart_comp_relativeProjCongr_hom Φ hΦ U hU
  chart_cB := chart_comp_relativeProjCongr_hom Φ' hΦ' U hU
  comm := congrSectionHom_comp_sectionHom Φ hΦ Φ' hΦ' ψ₁ ψ₂ hsq U
  mapDomain_comp := mapDomain_comp_eq_of_mem_span _ _ _ _ _ fun _ _ a ha ↦
    Ideal.subset_span ⟨(SheafGradedAlgebraHom.ofSituationHom Φ).sectionHom U a,
      GradedRingHom.map_mem _ ha, congrSectionHom_sectionHom Φ hΦ U a⟩

include hΦ hsq in
/-- Every point of `S` lies in an affine open `U` over which there is a chart square of the
isomorphisms of relative Proj induced by `Φ` and `Φ'`. -/
theorem exists_congrChartSquare (y : S) :
    ∃ (U : S.Opens) (hU : IsAffineOpen U), y ∈ U ∧
      Nonempty (ChartSquare ψ₂ ψ₁ (relativeProjCongr Φ hΦ).hom
        (relativeProjCongr Φ' hΦ').hom U hU) := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ :=
    S.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ y) isOpen_univ
  exact ⟨U, hU, hyU, ⟨congrChartSquare Φ hΦ Φ' hΦ' ψ₁ ψ₂ hsq U hU⟩⟩

include hΦ hsq in
/-- **The open of Tag 07ZG along the isomorphism of relative Proj induced by an isomorphism of
graded algebras**: for a commuting square `Φ' ∘ ψ₁ = ψ₂ ∘ Φ` with `Φ`, `Φ'` isomorphisms, the
open of `ψ₁` is the inverse image of the open of `ψ₂`. -/
theorem relativeProjCongr_preimage_relativeMapDomain :
    (relativeProjCongr Φ' hΦ').hom ⁻¹ᵁ ψ₂.relativeMapDomain = ψ₁.relativeMapDomain :=
  preimage_relativeMapDomain_of_chartSquare (exists_congrChartSquare Φ hΦ Φ' hΦ' ψ₁ ψ₂ hsq)

include hsq in
/-- **The morphism of Tag 07ZG along the isomorphism of relative Proj induced by an isomorphism of
graded algebras**: for a commuting square `Φ' ∘ ψ₁ = ψ₂ ∘ Φ` with `Φ`, `Φ'` isomorphisms, the
morphism of `ψ₁` followed by the isomorphism induced by `Φ` is the restriction of the isomorphism
induced by `Φ'` to the opens of `ψ₁` and `ψ₂`, followed by the morphism of `ψ₂`. -/
theorem relativeMapHom_comp_relativeProjCongr :
    relativeMapHom ψ₁ ≫ (relativeProjCongr Φ hΦ).hom =
      (relativeProjCongr Φ' hΦ').hom.resLE ψ₂.relativeMapDomain ψ₁.relativeMapDomain
          (relativeProjCongr_preimage_relativeMapDomain Φ hΦ Φ' hΦ' ψ₁ ψ₂ hsq).ge ≫
        relativeMapHom ψ₂ :=
  relativeMapHom_comp_of_chartSquare (exists_congrChartSquare Φ hΦ Φ' hΦ' ψ₁ ψ₂ hsq)

