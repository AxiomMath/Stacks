* [Stacks Project, Tag 01CY](https://stacks.math.columbia.edu/tag/01CY)
-/

@[expose] public noncomputable section

open CategoryTheory MonoidalCategory TopologicalSpace Opposite
open AlgebraicGeometry Stacks.RingedSpace Stacks.PullbackTensorCoherence
open Stacks.SheafOfModules.TensorPower RingedSpaceModuleAdjunction

universe u

namespace Stacks.AlgebraicGeometry.RelativeProjQcohSheaf

/-! ### Generation by the family of all global sections over an affine base -/

/-- **A quasi-coherent module on an affine scheme is generated by the family of *all* of its
global sections.** `AlgebraicGeometry.generatingSectionsOfIsAffine` produces some generating
family; enlarging the index type to the whole module of global sections keeps the germs
spanning, by Tag 01AN in the form
`AlgebraicGeometry.generates_iff_stalkwise_generates`. -/
theorem epi_freeHomEquiv_symm_id {Y : Scheme.{u}} [IsAffine Y] (N : Y.Modules)
    (hqc : N.IsQuasicoherent) :
    Epi (N.freeHomEquiv.symm (id : N.sections → N.sections)) := by
  have := hqc
  refine (AlgebraicGeometry.generates_iff_stalkwise_generates _ N id).mpr fun x => ?_
  have h := (AlgebraicGeometry.generates_iff_stalkwise_generates _ N
      (AlgebraicGeometry.generatingSectionsOfIsAffine N).s).mp
    (AlgebraicGeometry.generatingSectionsOfIsAffine N).epi x
  refine top_le_iff.mp ?_
  rw [← h]
  exact Submodule.span_mono (by rintro z ⟨i, rfl⟩; exact ⟨_, rfl⟩)

/-! ### Pulling a generating family back along a morphism of schemes -/

section Pullback

variable {T S : Scheme.{u}} (f : T ⟶ S)
  (N : SheafOfModules.{u} (structureRingSheaf S.toRingedSpace))

/-- **`f^*(𝒪_S^{(I)}) ≅ 𝒪_T^{(I)}`**, the pullback of a free module identified with the free
module on the same index type, retyped over `Stacks.RingedSpace.structureRingSheaf`. -/
def pullbackFreeIso (I : Type u) :
    (pullbackFunctor (ringedSpaceHom f)).obj
        (SheafOfModules.free (R := structureRingSheaf S.toRingedSpace) I) ≅
      SheafOfModules.free (R := structureRingSheaf T.toRingedSpace) I :=
  modulePullbackObjFreeIso (ringedSpaceHom f) I

/-- **The morphism `𝒪_S^{(Γ(S,N))} ⟶ N` reading off all the global sections of `N`.** -/
def globalGenHom :
    SheafOfModules.free (R := structureRingSheaf S.toRingedSpace) N.sections ⟶ N :=
  N.freeHomEquiv.symm id

/-- **The pullback of `globalGenHom`**, as a morphism `𝒪_T^{(Γ(S,N))} ⟶ f^*N` out of the free
module on the same index type. -/
def pullbackGenHom :
    SheafOfModules.free (R := structureRingSheaf T.toRingedSpace) N.sections ⟶
      (pullbackFunctor (ringedSpaceHom f)).obj N :=
  (pullbackFreeIso f N.sections).inv ≫
    (pullbackFunctor (ringedSpaceHom f)).map (globalGenHom N)

/-- The `i`-th inclusion into the free module on `T`, read through the identification
`f^*(𝒪_S^{(I)}) ≅ 𝒪_T^{(I)}`, is the pullback of the `i`-th inclusion on `S`, after the
comparison `f^*𝒪_S ⟶ 𝒪_T`. -/
theorem unitComparison_comp_ιFree_comp_pullbackFreeIso_inv (I : Type u) (a : I) :
    Stacks.PullbackAlgebra.unitComparison (ringedSpaceHom f) ≫
        SheafOfModules.ιFree a ≫ (pullbackFreeIso f I).inv =
      (pullbackFunctor (ringedSpaceHom f)).map
        (SheafOfModules.ιFree (R := structureRingSheaf S.toRingedSpace) a) := by
  rw [← Category.assoc, Iso.comp_inv_eq]
  exact (SheafOfModules.pullback_map_ιFree_comp_pullbackObjFreeIso_hom
    (structureSheafHom (ringedSpaceHom f)) a).symm

/-- The component of `pullbackGenHom` at `a : Γ(S, N)` is the pullback of the morphism
`𝒪_S ⟶ N` that `a` names. -/
theorem unitComparison_comp_ιFree_comp_pullbackGenHom (a : N.sections) :
    Stacks.PullbackAlgebra.unitComparison (ringedSpaceHom f) ≫
        SheafOfModules.ιFree a ≫ pullbackGenHom f N =
      (pullbackFunctor (ringedSpaceHom f)).map (N.unitHomEquiv.symm a) := by
  rw [show pullbackGenHom f N = (pullbackFreeIso f N.sections).inv ≫
      (pullbackFunctor (ringedSpaceHom f)).map (globalGenHom N) from rfl,
    ← Category.assoc, ← Category.assoc,
    Category.assoc (Stacks.PullbackAlgebra.unitComparison (ringedSpaceHom f)),
    unitComparison_comp_ιFree_comp_pullbackFreeIso_inv, ← Functor.map_comp]
  congr 1
  conv_lhs => rw [← SheafOfModules.unitHomEquiv_symm_freeHomEquiv_apply (globalGenHom N) a]
  exact congrArg N.unitHomEquiv.symm
    (congrFun (N.freeHomEquiv.apply_symm_apply (id : N.sections → N.sections)) a)

/-- **The morphism `pullbackGenHom` evaluated at the pullback-unit image of a local section of
`𝒪_S`**, after the comparison `f^*𝒪_S ⟶ 𝒪_T`: it is the pullback-unit image of the value of the
morphism `𝒪_S ⟶ N` that `a` names. -/
theorem val_app_ιFree_comp_pullbackGenHom (a : N.sections)
    (V : (Opens S.toRingedSpace.carrier)ᵒᵖ)
    (x : (SheafOfModules.unit (structureRingSheaf S.toRingedSpace)).val.obj V) :
    (SheafOfModules.ιFree a ≫ pullbackGenHom f N).val.app
        ((opensMap (ringedSpaceHom f)).op.obj V)
        ((Stacks.PullbackAlgebra.unitComparison (ringedSpaceHom f)).val.app
          ((opensMap (ringedSpaceHom f)).op.obj V)
          (pullbackUnit (ringedSpaceHom f)
            (SheafOfModules.unit (structureRingSheaf S.toRingedSpace)) V x)) =
      pullbackUnit (ringedSpaceHom f) N V ((N.unitHomEquiv.symm a).val.app V x) := by
  rw [← SheafOfModules.comp_val_app_apply,
    unitComparison_comp_ιFree_comp_pullbackGenHom f N a, pullbackUnit_naturality]

/-- **The global section of `f^*N` that `pullbackGenHom` attaches to `a` is the pullback-unit
image of `a`.** -/
theorem eval_unitHomEquiv_ιFree_comp_pullbackGenHom (a : N.sections)
    (V : (Opens S.toRingedSpace.carrier)ᵒᵖ) :
    (((pullbackFunctor (ringedSpaceHom f)).obj N).unitHomEquiv
        (SheafOfModules.ιFree a ≫ pullbackGenHom f N)).eval
        ((opensMap (ringedSpaceHom f)).op.obj V) =
      pullbackUnit (ringedSpaceHom f) N V (a.eval V) := by
  have hone : (Stacks.PullbackAlgebra.unitComparison (ringedSpaceHom f)).val.app
        ((opensMap (ringedSpaceHom f)).op.obj V)
        (pullbackUnit (ringedSpaceHom f)
          (SheafOfModules.unit (structureRingSheaf S.toRingedSpace)) V
          (1 : (structureRingSheaf S.toRingedSpace).obj.obj V)) =
      (1 : (structureRingSheaf T.toRingedSpace).obj.obj
        ((opensMap (ringedSpaceHom f)).op.obj V)) :=
    (Stacks.PullbackAlgebra.pullbackUnitIso_hom_pullbackUnit (ringedSpaceHom f) V 1).trans
      (sharp_one (ringedSpaceHom f) V)
  have hα : (N.unitHomEquiv.symm a).val.app V
        (1 : (structureRingSheaf S.toRingedSpace).obj.obj V) = a.eval V :=
    (SheafOfModules.unitHomEquiv_apply_coe N (N.unitHomEquiv.symm a) V).symm.trans
      (congrArg (fun s : N.sections => s.eval V) (N.unitHomEquiv.apply_symm_apply a))
  refine (SheafOfModules.unitHomEquiv_apply_coe _ _ _).trans ?_
  refine Eq.trans
    (congrArg (fun z : (structureRingSheaf T.toRingedSpace).obj.obj
        ((opensMap (ringedSpaceHom f)).op.obj V) =>
      (SheafOfModules.ιFree a ≫ pullbackGenHom f N).val.app
        ((opensMap (ringedSpaceHom f)).op.obj V) z) hone).symm ?_
  exact (val_app_ιFree_comp_pullbackGenHom f N a V
      (1 : (structureRingSheaf S.toRingedSpace).obj.obj V)).trans
    (congrArg (pullbackUnit (ringedSpaceHom f) N V) hα)

/-- **The pullback of the family of all global sections of a quasi-coherent module on an affine
base generates the pullback.** `f^*` is a left adjoint, hence preserves epimorphisms, and it
carries the free module on `Γ(S, N)` to the free module on `Γ(S, N)`. -/
theorem epi_pullbackGenHom [IsAffine S] (hqc : N.IsQuasicoherent) :
    Epi (pullbackGenHom f N) := by
  have : Epi (globalGenHom N) := epi_freeHomEquiv_symm_id (Y := S) N hqc
  have := CategoryTheory.Functor.preservesEpimorphisms_of_adjunction
    (pullbackAdjunction (ringedSpaceHom f))
  exact epi_comp _ _

end Pullback

/-! ### The generating family attached to a twisting -/

namespace Twisting

variable {T S : Scheme.{u}} {f : T ⟶ S}
  {A : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf S.toRingedSpace)} {d : ℤ}
  {L : SheafOfModules.{u} (structureRingSheaf T.toRingedSpace)}
  [Stacks.SheafOfModules.IsInvertible T.toRingedSpace.presheaf (isSheafStruct T) L]

/-- **The identification `L^{⊗ 1} = L` of Tag 01CU** for an invertible module carrying a
twisting. The two invertibility spellings the integral tensor powers are indexed by are supplied
by hand, exactly as `Twisting.degreeOneSectionHom` supplies them. -/
abbrev laurentOneIso (L : SheafOfModules.{u} (structureRingSheaf T.toRingedSpace))
    [Stacks.SheafOfModules.IsInvertible T.toRingedSpace.presheaf (isSheafStruct T) L] :
    (laurent L).piece 1 ≅ L :=
  letI := Stacks.SheafOfModules.IsInvertible.toAlgebraicGeometry T.toRingedSpace.presheaf
    (isSheafStruct T) L inferInstance
  letI := Stacks.SheafOfModules.isEquivalence_tensorRightFunctor_of_isInvertible
    T.toRingedSpace.presheaf (isSheafStruct T) L
  tensorPowerOneIso T.toRingedSpace.presheaf (isSheafStruct T) L

/-- **The morphism `𝒪_T^{(Γ(S,𝒜_{1·d}))} ⟶ L` whose components are the sections `ψ(a)`.** It is
the pullback of the global-section family of `𝒜_{1 · d}`, composed with the degree-one component
of `ψ` and with the identification `L^{⊗ 1} ≅ L` of Tag 01CU.

Only the twisting enters, not the surjectivity of its degree-one component: whether this
morphism is an epimorphism is exactly the question of whether the sections `ψ(a)` generate
`L`. -/
def freeHom (ψ : Twisting f A d L) :
    SheafOfModules.free (R := structureRingSheaf T.toRingedSpace)
        (A.piece (1 * d)).sections ⟶ L :=
  pullbackGenHom f (A.piece (1 * d)) ≫ ψ.app 1 ≫ (laurentOneIso L).hom

/-- The global section of `L` that `freeHom` attaches to a global section `a` of `𝒜_{1 · d}`,
read over the inverse image of `S`: the degree-one component of `ψ` applied to the pullback-unit
image of `a`. -/
theorem eval_freeHomEquiv_preimage (ψ : Twisting f A d L) (a : (A.piece (1 * d)).sections) :
    (L.freeHomEquiv ψ.freeHom a).eval
        ((opensMap (ringedSpaceHom f)).op.obj (op (⊤ : Opens S.toRingedSpace.carrier))) =
      (ψ.app 1 ≫ (laurentOneIso L).hom).val.app
        ((opensMap (ringedSpaceHom f)).op.obj (op (⊤ : Opens S.toRingedSpace.carrier)))
        (pullbackUnit (ringedSpaceHom f) (A.piece (1 * d))
          (op (⊤ : Opens S.toRingedSpace.carrier))
          (a.eval (op (⊤ : Opens S.toRingedSpace.carrier)))) := by
  have hgs : L.freeHomEquiv ψ.freeHom a =
      SheafOfModules.sectionsMap (ψ.app 1 ≫ (laurentOneIso L).hom)
        (((pullbackFunctor (ringedSpaceHom f)).obj (A.piece (1 * d))).unitHomEquiv
          (SheafOfModules.ιFree a ≫ pullbackGenHom f (A.piece (1 * d)))) := by
    show L.unitHomEquiv (SheafOfModules.ιFree a ≫ ψ.freeHom) = _
    rw [show SheafOfModules.ιFree a ≫ ψ.freeHom =
        (SheafOfModules.ιFree a ≫ pullbackGenHom f (A.piece (1 * d))) ≫
          (ψ.app 1 ≫ (laurentOneIso L).hom) from (Category.assoc _ _ _).symm]
    exact SheafOfModules.unitHomEquiv_comp_apply _ _
  rw [hgs]
  exact congrArg
    (fun z : ((pullbackFunctor (ringedSpaceHom f)).obj (A.piece (1 * d))).val.obj
        ((opensMap (ringedSpaceHom f)).op.obj (op (⊤ : Opens S.toRingedSpace.carrier))) =>
      (ψ.app 1 ≫ (laurentOneIso L).hom).val.app
        ((opensMap (ringedSpaceHom f)).op.obj (op (⊤ : Opens S.toRingedSpace.carrier))) z)
    (eval_unitHomEquiv_ιFree_comp_pullbackGenHom f (A.piece (1 * d)) a
      (op (⊤ : Opens S.toRingedSpace.carrier)))

/-- **The global section of `L` that `freeHom` attaches to `a` is one of the sections `ψ(b)`**:
it is the value of `Twisting.degreeOneSectionHom` at the global section of `𝒜_d` that `a` becomes
through the degree identification `1 · d = d`. -/
theorem eval_freeHomEquiv (ψ : Twisting f A d L) (a : (A.piece (1 * d)).sections) :
    (L.freeHomEquiv ψ.freeHom a).eval (op (⊤ : Opens T.toRingedSpace.carrier)) =
      ψ.degreeOneSectionHom
        ((eqToHom (congrArg A.piece (one_mul d)) : A.piece (1 * d) ⟶ A.piece d).val.app
          (op (⊤ : Opens S.toRingedSpace.carrier))
          (a.eval (op (⊤ : Opens S.toRingedSpace.carrier)))) := by
  have hid : (eqToHom (congrArg A.piece (one_mul d)) : A.piece (1 * d) ⟶ A.piece d) ≫
      (eqToHom (congrArg A.piece (one_mul d).symm) : A.piece d ⟶ A.piece (1 * d)) =
      𝟙 (A.piece (1 * d)) := by
    rw [eqToHom_trans, eqToHom_refl]
  have hcast : (eqToHom (congrArg A.piece (one_mul d).symm) :
        A.piece d ⟶ A.piece (1 * d)).val.app (op (⊤ : Opens S.toRingedSpace.carrier))
        ((eqToHom (congrArg A.piece (one_mul d)) : A.piece (1 * d) ⟶ A.piece d).val.app
          (op (⊤ : Opens S.toRingedSpace.carrier))
          (a.eval (op (⊤ : Opens S.toRingedSpace.carrier)))) =
      a.eval (op (⊤ : Opens S.toRingedSpace.carrier)) := by
    rw [← SheafOfModules.comp_val_app_apply, hid]
    rfl
  have hdeg : ψ.degreeOneSectionHom
        ((eqToHom (congrArg A.piece (one_mul d)) : A.piece (1 * d) ⟶ A.piece d).val.app
          (op (⊤ : Opens S.toRingedSpace.carrier))
          (a.eval (op (⊤ : Opens S.toRingedSpace.carrier)))) =
      (laurentOneIso L).hom.val.app (op (⊤ : Opens T.toRingedSpace.carrier))
        (ψ.globalSectionHom 1
          ((eqToHom (congrArg A.piece (one_mul d).symm) :
              A.piece d ⟶ A.piece (1 * d)).val.app
            (op (⊤ : Opens S.toRingedSpace.carrier))
            ((eqToHom (congrArg A.piece (one_mul d)) :
                A.piece (1 * d) ⟶ A.piece d).val.app
              (op (⊤ : Opens S.toRingedSpace.carrier))
              (a.eval (op (⊤ : Opens S.toRingedSpace.carrier)))))) := rfl
  rw [hdeg, hcast, Twisting.globalSectionHom_apply, Twisting.sectionHom_apply]
  refine (PresheafOfModules.sections_property (L.freeHomEquiv ψ.freeHom a)
    (eqToHom (congrArg op (Twisting.preimage_top f)) :
      (opensMap (ringedSpaceHom f)).op.obj (op (⊤ : Opens S.toRingedSpace.carrier)) ⟶
        op (⊤ : Opens T.toRingedSpace.carrier))).symm.trans ?_
  refine Eq.trans (congrArg (fun z : L.val.obj
        ((opensMap (ringedSpaceHom f)).op.obj (op (⊤ : Opens S.toRingedSpace.carrier))) =>
      L.val.map (eqToHom (congrArg op (Twisting.preimage_top f)) :
        (opensMap (ringedSpaceHom f)).op.obj (op (⊤ : Opens S.toRingedSpace.carrier)) ⟶
          op (⊤ : Opens T.toRingedSpace.carrier)) z)
    ((eval_freeHomEquiv_preimage ψ a).trans
      (SheafOfModules.comp_val_app_apply _ _ _ _))) ?_
  exact (PresheafOfModules.naturality_apply (laurentOneIso L).hom.val
    (eqToHom (congrArg op (Twisting.preimage_top f)) :
      (opensMap (ringedSpaceHom f)).op.obj (op (⊤ : Opens S.toRingedSpace.carrier)) ⟶
        op (⊤ : Opens T.toRingedSpace.carrier)) _).symm

end Twisting

/-! ### The generation condition of a quadruple -/

namespace Quadruple

variable {T S : Scheme.{u}} {f : T ⟶ S}
  {A : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf S.toRingedSpace)} {d : ℤ}

/-- **The morphism `𝒪_T^{(Γ(S,𝒜_{1·d}))} ⟶ L` whose components are the sections `ψ(a)`.** It is
the pullback of the global-section family of `𝒜_{1 · d}`, composed with the degree-one component
of `ψ` and with the identification `L^{⊗ 1} ≅ L` of Tag 01CU. -/
def freeHom (P : Quadruple f A d) :
    SheafOfModules.free (R := structureRingSheaf T.toRingedSpace)
        (A.piece (1 * d)).sections ⟶ P.L :=
  P.twisting.freeHom

/-- **`freeHom` is an epimorphism**: the first factor generates `f^*𝒜_{1 · d}` because `S` is
affine and `𝒜_{1 · d}` is quasi-coherent, the second is the surjectivity of `ψ_1` that is part
of the data of a quadruple, and the third is an isomorphism. -/
theorem epi_freeHom [IsAffine S] (hqc : ∀ n : ℤ, (A.piece n).IsQuasicoherent)
    (P : Quadruple f A d) : Epi P.freeHom := by
  have : Epi (pullbackGenHom f (A.piece (1 * d))) :=
    epi_pullbackGenHom f (A.piece (1 * d)) (hqc (1 * d))
  have := P.epi_app_one
  exact epi_comp _ _

/-- **The global sections `ψ(a)` of `L`, `a ∈ Γ(S, 𝒜_{1 · d})`, as a generating family.** -/
def generatingSections [IsAffine S] (hqc : ∀ n : ℤ, (A.piece n).IsQuasicoherent)
    (P : Quadruple f A d) : SheafOfModules.GeneratingSections P.L where
  I := (A.piece (1 * d)).sections
  s := P.L.freeHomEquiv P.freeHom
  epi := by
    rw [Equiv.symm_apply_apply]
    exact epi_freeHom hqc P

/-- The members of the generating family, read over the inverse image of `S`: the member indexed
by a global section `a` of `𝒜_{1 · d}` is the degree-one component of `ψ` applied to the
pullback-unit image of `a`. This is `Twisting.eval_freeHomEquiv_preimage` for the twisting of the
quadruple. -/
theorem eval_generatingSections_s_preimage [IsAffine S]
    (hqc : ∀ n : ℤ, (A.piece n).IsQuasicoherent) (P : Quadruple f A d)
    (a : (A.piece (1 * d)).sections) :
    ((generatingSections hqc P).s a).eval
        ((opensMap (ringedSpaceHom f)).op.obj (op (⊤ : Opens S.toRingedSpace.carrier))) =
      (P.twisting.app 1 ≫ (Twisting.laurentOneIso P.L).hom).val.app
        ((opensMap (ringedSpaceHom f)).op.obj (op (⊤ : Opens S.toRingedSpace.carrier)))
        (pullbackUnit (ringedSpaceHom f) (A.piece (1 * d))
          (op (⊤ : Opens S.toRingedSpace.carrier))
          (a.eval (op (⊤ : Opens S.toRingedSpace.carrier)))) :=
  Twisting.eval_freeHomEquiv_preimage P.twisting a

/-- **Every member of the generating family is one of the sections `ψ(a)`**, `a` a global
section of `𝒜_d`: the member indexed by a global section of `𝒜_{1 · d}` is the value of
`Twisting.degreeOneSectionHom` at that section read in `Γ(S, 𝒜_d)` through the degree
identification `1 · d = d`. This is `Twisting.eval_freeHomEquiv` for the twisting of the
quadruple, with the witness forgotten. -/
theorem exists_eval_generatingSections_s [IsAffine S]
    (hqc : ∀ n : ℤ, (A.piece n).IsQuasicoherent) (P : Quadruple f A d)
    (a : (A.piece (1 * d)).sections) :
    ∃ b : (A.piece d).val.obj (op (⊤ : Opens S.toRingedSpace.carrier)),
      ((generatingSections hqc P).s a).eval (op (⊤ : Opens T.toRingedSpace.carrier)) =
        P.twisting.degreeOneSectionHom b :=
  ⟨_, Twisting.eval_freeHomEquiv P.twisting a⟩

/-- **The generation condition of Tag 01NU.** Let `S` be affine and `𝒜` a graded
`𝒪_S`-algebra with quasi-coherent homogeneous pieces (Situation 01NN), and let
`(d, f : T → S, L, ψ)` be a quadruple over a test scheme `T` (Section 01NS). Then the global
sections `ψ(a)` of `L`, for `a` a global section of `𝒜_d`, **generate `L`**, in the geometric
form Section 27.12 uses that condition: their nonvanishing opens cover `T`.

This is what turns the surjectivity of `ψ_1` that a quadruple carries into the generation
condition that a triple (Section 01N4) carries, and it is the one step of the identification
`F_d = F_d^{triples}` that uses the affineness of `S` and the quasi-coherence of `𝒜`. -/
theorem iSup_nonvanishingOpen_eq_top [IsAffine S]
    (hqc : ∀ n : ℤ, (A.piece n).IsQuasicoherent) (P : Quadruple f A d) :
    (⨆ b : (A.piece d).val.obj (op (⊤ : Opens S.toRingedSpace.carrier)),
        Stacks.NonvanishingOpen.nonvanishingOpen T P.L
          (P.twisting.degreeOneSectionHom b)) = ⊤ := by
  refine top_unique fun t _ => ?_
  obtain ⟨a, ha⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing P.L
    (generatingSections hqc P) t
  obtain ⟨b, hb⟩ := exists_eval_generatingSections_s hqc P a
  refine TopologicalSpace.Opens.mem_iSup.2 ⟨b, ?_⟩
  show t ∈ Stacks.Ample.nonvanishingLocus P.L (P.twisting.degreeOneSectionHom b)
  rw [← hb]
  exact (Stacks.NonvanishingSpelling.stalkNonvanishingLocus_eq T P.L
    ((generatingSections hqc P).s a)).le ha

end Quadruple

end Stacks.AlgebraicGeometry.RelativeProjQcohSheaf

