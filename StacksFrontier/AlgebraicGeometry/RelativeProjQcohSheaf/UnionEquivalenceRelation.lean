module

public import StacksFrontier.AlgebraicGeometry.RelativeProjQcohSheaf.PowerTransitionChain
public import StacksFrontier.AlgebraicGeometry.RelativeProjQcohSheaf.PowerTransitionPullback

/-!
# The identifications made by the union are already an equivalence relation

Let `S` be a scheme, `𝒜` a graded `𝒪_S`-algebra (Situation 01NN) and `T` a test scheme. The set
`F(T)` of the display 01NX is `Quot UnionRel`, the quotient of the quadruples of positive degree
over `T` by the relation generated by strict equivalence inside one degree and the equivalence of
Tag 01NW across degrees. This file shows that `UnionRel` is itself an equivalence relation: it
coincides with `CofinallyEqual`, the relation of becoming equal in a common multiple of the
degrees. Hence two quadruples of positive degree have the same point of `F(T)` exactly when they
are equivalent, and the transitions `F_d → F_{a d}` and the canonical maps `F_d(T) → F(T)` are
injective.

The key step is the converse of `Quadruple.strictlyEquivalent_scale_of_compatibleAt`: a strict
equivalence of the transitions of two quadruples to a common multiple `m = a d = a' d'` of their
degrees is a comparison of the two quadruples at `m`.

## Main results

* `Quadruple.compatibleAt_of_strictlyEquivalent_scale`: a strict equivalence of the two transitions
  to a common multiple of the degrees is a comparison at that multiple.
* `Quadruple.equivalent_of_strictlyEquivalent_scale`: such a strict equivalence makes the two
  quadruples equivalent.
* `Quadruple.compatibleAt_self` and `Quadruple.strictlyEquivalent_of_compatibleAt_one_one`: a
  quadruple is comparable with itself at `(1, 1)`, and a comparison at `(1, 1)` is a strict
  equivalence.
* `Quadruple.strictlyEquivalent_of_equivalent`: equivalent quadruples of one and the same degree
  are strictly equivalent, which is Tag 01NW, (2) implies (1), at `d = d'`.
* `Quadruple.strictlyEquivalent_of_strictlyEquivalent_scale`, `Fd.scale_injective` and
  `Fd.toF_injective`: the transitions `F_d → F_{a d}` and the canonical maps `F_d(T) → F(T)` are
  injective.
* `unionRel_iff_cofinallyEqual` and `unionRel_equivalence`: the relation defining the union of the
  display 01NX is cofinal equality, and is an equivalence relation.
* `F.mk_eq_mk_iff_equivalent` and `F.mk_eq_mk_iff_strictlyEquivalent`: two quadruples of positive
  degree have the same point of `F(T)` exactly when they are equivalent, and, if their degrees
  agree, exactly when they are strictly equivalent.

## References

* [Stacks Project, Section 01NS](https://stacks.math.columbia.edu/tag/01NS)
* [Stacks Project, Tag 01NW](https://stacks.math.columbia.edu/tag/01NW)
* [Stacks Project, Tag 01NX](https://stacks.math.columbia.edu/tag/01NX)
* [Stacks Project, Tag 01NY](https://stacks.math.columbia.edu/tag/01NY)
-/

@[expose] public noncomputable section

open CategoryTheory MonoidalCategory

open AlgebraicGeometry Stacks.RingedSpace Stacks.PullbackTensorCoherence
open Stacks.SheafOfModules.TensorPower

attribute [local instance] Stacks.PullbackGradedAlgebra.monoidalCategory

universe u

namespace Stacks.AlgebraicGeometry.RelativeProjQcohSheaf

open Stacks.AlgebraicGeometry.RelativeProjQcohSheaf.LaurentPullback

attribute [local instance] isInvertible_piece

variable {T S : Scheme.{u}} {f : T ⟶ S}
  {A : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf S.toRingedSpace)} {d d' : ℤ}

namespace Quadruple

variable {P : Quadruple f A d} {Q : Quadruple f A d'}

/-- The degree-`n` component of an isomorphism of sheaves of graded algebras, as an isomorphism. -/
private def gradedAppIso
    {R R' : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf T.toRingedSpace)}
    (γ : R ≅ R') (n : ℤ) : R.piece n ≅ R'.piece n where
  hom := γ.hom.app n
  inv := γ.inv.app n
  hom_inv_id := congrArg (fun φ : R ⟶ R => φ.app n) γ.hom_inv_id
  inv_hom_id := congrArg (fun φ : R' ⟶ R' => φ.app n) γ.inv_hom_id

@[simp] private theorem gradedAppIso_hom
    {R R' : SheafOfModules.GradedAlgebra.{u, u} (structureRingSheaf T.toRingedSpace)}
    (γ : R ≅ R') (n : ℤ) : (gradedAppIso γ n).hom = γ.hom.app n :=
  rfl

variable {a a' e : ℤ}

/-- The comparison `L^{⊗ n a} ≅ (L')^{⊗ n a'}` read off an isomorphism of the Laurent algebras of
`L^{⊗ a}` and `(L')^{⊗ a'}`: the degree-`n` component of that isomorphism conjugated by the
power-of-a-power comparisons on both sides. -/
private def powCmp (γ : laurent (powModule P.L a) ≅ laurent (powModule Q.L a')) (n : ℤ) :
    (laurent P.L).piece (n * a) ≅ (laurent Q.L).piece (n * a') :=
  powPowIso P.L a n ≪≫ gradedAppIso γ n ≪≫ (powPowIso Q.L a' n).symm

/-- If `γ` is compatible with the transitions of the twistings of `P` and `Q` to the common degree
`a d = a' d'`, then `powCmp γ n` is a comparison of `P` with `Q` in the degrees `(n a, n a')`. -/
private theorem isCompAt_powCmp (hm : a' * d' = a * d)
    (γ : laurent (powModule P.L a) ≅ laurent (powModule Q.L a'))
    (hψ : ∀ n : ℤ, P.twisting.scaleApp a n ≫ γ.hom.app n =
      (pullbackFunctor (ringedSpaceHom f)).map
          (eqToHom (congrArg A.piece (show n * (a * d) = n * (a' * d') by rw [hm]))) ≫
        Q.twisting.scaleApp a' n) (n : ℤ) :
    IsCompAt P Q (show n * a * d = n * a' * d' by linear_combination n * hm.symm)
      (powCmp γ n).hom := by
  have key := congrArg (fun z => (pullbackFunctor (ringedSpaceHom f)).map
      (eqToHom (congrArg A.piece (show n * a * d = n * (a * d) by ring))) ≫
        z ≫ (powPowIso Q.L a' n).inv) (hψ n)
  change P.twisting.app (n * a) ≫ (powCmp γ n).hom = _
  simpa only [powCmp, Iso.trans_hom, Iso.symm_hom, gradedAppIso_hom, Twisting.scaleApp,
    CategoryTheory.eqToHom_map, Category.assoc, eqToHom_trans_assoc, eqToHom_refl,
    Category.id_comp, Iso.hom_inv_id, Category.comp_id] using key

/-- A strict equivalence of the two transitions to a common multiple of the degrees is a comparison
at that multiple. This is the converse of `Quadruple.strictlyEquivalent_scale_of_compatibleAt`. -/
theorem compatibleAt_of_strictlyEquivalent_scale (ha : 0 < a) (ha' : 0 < a')
    (hm : a' * d' = a * d)
    (hs : StrictlyEquivalent (P.scale ha) ((Q.scale ha').congrDegree hm)) :
    CompatibleAt P Q a a' := by
  obtain ⟨γ, hψ⟩ := (strictlyEquivalent_iff_exists_hom _ _).mp hs
  have hcmp := isCompAt_powCmp (P := P) (Q := Q) (a := a) (a' := a') hm γ (fun n => hψ n)
  have hH : ∀ n : ℤ, 0 < n → HasCompAt P Q (n * a) (n * a') :=
    fun n _ => ⟨_, powCmp γ n, hcmp n⟩
  have hβ : IsCompAt P Q (scaledDegEq hm.symm 1) (scaledIso (powCmp γ 1) 1).hom := by
    rw [scaledIso_one]
    exact hcmp 1
  exact ⟨hm.symm, pairIso (powCmp γ 1),
    fun p q p' q' h h' => pairIso_mul (powCmp γ 1) ha.ne' p q p' q' h h',
    pairIso_one (powCmp γ 1) ha.ne',
    fun p q h => pairIso_twisting (powCmp γ 1) ha.ne' hm.symm ha ha' hβ hH p q h⟩

/-- A strict equivalence of the two transitions, both read in a common degree `e = a d = a' d'`, is
a comparison at that multiple. -/
theorem compatibleAt_of_strictlyEquivalent_scale_congrDegree (ha : 0 < a) (ha' : 0 < a')
    (h : a * d = e) (h' : a' * d' = e)
    (hs : StrictlyEquivalent ((P.scale ha).congrDegree h) ((Q.scale ha').congrDegree h')) :
    CompatibleAt P Q a a' := by
  refine compatibleAt_of_strictlyEquivalent_scale ha ha' (h'.trans h.symm) ?_
  refine strictlyEquivalent_equivalence.trans
    (strictlyEquivalent_equivalence.symm
      (strictlyEquivalent_equivalence.trans
        (strictlyEquivalent_congrDegree_congrDegree (P.scale ha) h h.symm)
        (strictlyEquivalent_congrDegree_self (P.scale ha) (h.trans h.symm))))
    (strictlyEquivalent_equivalence.trans (hs.congrDegree h.symm)
      (strictlyEquivalent_congrDegree_congrDegree (Q.scale ha') h' h.symm))

/-- Two quadruples of positive degrees whose transitions to a common multiple of their degrees are
strictly equivalent are equivalent. This is Tag 01NW, (3) implies (2), in terms of transitions. -/
theorem equivalent_of_strictlyEquivalent_scale (hd : 0 < d) (hd' : 0 < d') (ha : 0 < a)
    (ha' : 0 < a') (h : a * d = e) (h' : a' * d' = e)
    (hs : StrictlyEquivalent ((P.scale ha).congrDegree h) ((Q.scale ha').congrDegree h')) :
    Equivalent P Q :=
  equivalent_of_exists_compatible hd hd'
    ⟨a * d, a, a', mul_pos ha hd, rfl, h.trans h'.symm,
      compatibleAt_of_strictlyEquivalent_scale_congrDegree ha ha' h h' hs⟩

/-! ### One degree: the comparison at `(1, 1)` -/

/-- A pair of degrees lying on the line through `(1, 1)` is a pair of equal degrees. -/
private theorem isScaledPair_one_one_eq {p q : ℤ} (h : IsScaledPair 1 1 p q) : p = q := by
  obtain ⟨n, hp, hq⟩ := h
  rw [hp, hq]

/-- A quadruple is comparable with itself at `(1, 1)`, by the identity. -/
theorem compatibleAt_self (P : Quadruple f A d) : CompatibleAt P P 1 1 := by
  refine ⟨rfl, fun p q h => reindexIso P.L (isScaledPair_one_one_eq h), ?_, ?_, ?_⟩
  · intro p q p' q' h h'
    obtain ⟨n, hp, hq⟩ := id h
    obtain ⟨m, hp', hq'⟩ := id h'
    subst hp hq hp' hq'
    simp only [reindexIso_self, Iso.refl_hom, id_tensorHom_id]
    exact (Category.id_comp _).trans (Category.comp_id _).symm
  · simp only [reindexIso_self, Iso.refl_hom]
    exact Category.comp_id _
  · intro p q h
    obtain ⟨n, hp, hq⟩ := id h
    subst hp hq
    simp only [reindexIso_self, Iso.refl_hom, eqToHom_refl, CategoryTheory.Functor.map_id]
    exact (Category.comp_id _).trans (Category.id_comp _).symm

/-- Two quadruples of one degree comparable at `(1, 1)` are strictly equivalent. -/
theorem strictlyEquivalent_of_compatibleAt_one_one {P Q : Quadruple f A d}
    (h : CompatibleAt P Q 1 1) : StrictlyEquivalent P Q :=
  strictlyEquivalent_of_compatibleAt_one (compatibleAt_self P) h

/-- The least common multiple of a positive integer `d` with itself is `1 * d`. -/
private theorem lcm_self_eq (hd : 0 < d) : (Int.lcm d d : ℤ) = 1 * d := by
  rw [one_mul, Int.lcm, Nat.lcm_self]
  exact Int.natAbs_of_nonneg hd.le

/-- Two quadruples of one positive degree whose transitions to a multiple of that degree are
strictly equivalent are already strictly equivalent: the transitions `F_d → F_{a d}` of Tag 01NW
are injective. -/
theorem strictlyEquivalent_of_strictlyEquivalent_scale (hd : 0 < d) (ha : 0 < a)
    {P Q : Quadruple f A d} (hs : StrictlyEquivalent (P.scale ha) (Q.scale ha)) :
    StrictlyEquivalent P Q := by
  have hc : CompatibleAt P Q a a :=
    compatibleAt_of_strictlyEquivalent_scale ha ha rfl
      (strictlyEquivalent_equivalence.trans hs
        (strictlyEquivalent_equivalence.symm
          (strictlyEquivalent_congrDegree_self (Q.scale ha) rfl)))
  exact strictlyEquivalent_of_compatibleAt_one_one
    (lcm_compatible_of_exists_compatible hd hd (lcm_self_eq hd) (lcm_self_eq hd)
      ⟨a * d, a, a, mul_pos ha hd, rfl, rfl, hc⟩)

/-- Equivalent quadruples of the same positive degree are strictly equivalent. This is Tag 01NW,
(2) implies (1), for two quadruples of one degree. -/
theorem strictlyEquivalent_of_equivalent (hd : 0 < d) {P Q : Quadruple f A d}
    (h : Equivalent P Q) : StrictlyEquivalent P Q :=
  strictlyEquivalent_of_compatibleAt_one_one
    (lcm_compatible_of_equivalent hd hd (lcm_self_eq hd) (lcm_self_eq hd) h)

end Quadruple

/-! ### Cofinal equality is equivalence -/

/-- Two quadruples that become equal in a common multiple of their degrees are equivalent. -/
theorem Quadruple.equivalent_of_cofinallyEqual {x y : PositiveQuadruple f A}
    (hxy : CofinallyEqual x y) : Quadruple.Equivalent x.2 y.2 := by
  obtain ⟨e, a, a', ha, ha', h, h', hEq⟩ := hxy
  rw [Fd.scale_mk, Fd.scale_mk, Fd.congrDegree_mk, Fd.congrDegree_mk] at hEq
  exact Quadruple.equivalent_of_strictlyEquivalent_scale x.1.2 y.1.2 ha ha' h h'
    ((Fd.mk_eq_mk_iff _ _).mp hEq)

/-- The relation `UnionRel` defining the union of the display 01NX is cofinal equality. -/
theorem unionRel_iff_cofinallyEqual {x y : PositiveQuadruple f A} :
    UnionRel x y ↔ CofinallyEqual x y :=
  ⟨fun hxy => unionRel_le_cofinallyEqual _ _ hxy,
    fun hxy => UnionRel.equivalent (Quadruple.equivalent_of_cofinallyEqual hxy)⟩

/-- The relation `UnionRel` defining the union of the display 01NX is an equivalence relation. -/
theorem unionRel_equivalence : Equivalence (UnionRel (f := f) (A := A)) where
  refl x := unionRel_iff_cofinallyEqual.mpr (cofinallyEqual_equivalence.refl x)
  symm hxy :=
    unionRel_iff_cofinallyEqual.mpr
      (cofinallyEqual_equivalence.symm (unionRel_iff_cofinallyEqual.mp hxy))
  trans hxy hyz :=
    unionRel_iff_cofinallyEqual.mpr
      (cofinallyEqual_equivalence.trans (unionRel_iff_cofinallyEqual.mp hxy)
        (unionRel_iff_cofinallyEqual.mp hyz))

/-- Two quadruples of positive degree have the same point of `F(T)` exactly when they are
equivalent. -/
theorem F.mk_eq_mk_iff_equivalent (hd : 0 < d) (hd' : 0 < d') (P : Quadruple f A d)
    (Q : Quadruple f A d') :
    F.mk f hd P = F.mk f hd' Q ↔ Quadruple.Equivalent P Q :=
  ⟨fun hPQ => Quadruple.equivalent_of_cofinallyEqual
      (x := ⟨⟨d, hd⟩, P⟩) (y := ⟨⟨d', hd'⟩, Q⟩)
      ((F.mk_eq_mk_iff_exists_common_degree hd hd' P Q).mp hPQ),
    F.mk_eq_mk_of_equivalent hd hd'⟩

/-- **Two quadruples of one positive degree have the same point of `F(T)` exactly when they are
strictly equivalent**, that is, exactly when they have the same class in `F_d(T)`. -/
theorem F.mk_eq_mk_iff_strictlyEquivalent (hd : 0 < d) (P Q : Quadruple f A d) :
    F.mk f hd P = F.mk f hd Q ↔ Quadruple.StrictlyEquivalent P Q :=
  ⟨fun hPQ => Quadruple.strictlyEquivalent_of_equivalent hd
      ((F.mk_eq_mk_iff_equivalent hd hd P Q).mp hPQ),
    F.mk_eq_mk_of_strictlyEquivalent hd⟩

/-! ### The transitions and the canonical maps to the union are injective -/

/-- A map out of `F_d(T)` that preserves the morphism to `S` is injective as soon as equal images
of the classes of two quadruples force them to be strictly equivalent. -/
private theorem Fd.injective_of_strictlyEquivalent {β : Type*} {g : Fd A d T → β}
    (hfst : ∀ ξ ξ', g ξ = g ξ' → ξ.1 = ξ'.1)
    (h : ∀ {f : T ⟶ S} (P Q : Quadruple f A d), g (Fd.mk f P) = g (Fd.mk f Q) →
      Quadruple.StrictlyEquivalent P Q) : Function.Injective g := by
  rintro ⟨f, x⟩ ⟨g', y⟩ hfg
  obtain rfl : f = g' := hfst _ _ hfg
  induction x using Quotient.ind with
  | _ P =>
    induction y using Quotient.ind with
    | _ Q => exact (Fd.mk_eq_mk_iff P Q).mpr (h P Q hfg)

/-- The transition `F_d(T) → F_{a d}(T)` is injective. -/
theorem Fd.scale_injective {a : ℤ} (hd : 0 < d) (ha : 0 < a) :
    Function.Injective (Fd.scale (A := A) (T := T) (d := d) ha) :=
  Fd.injective_of_strictlyEquivalent (fun _ _ => congrArg Sigma.fst) fun P Q h =>
    Quadruple.strictlyEquivalent_of_strictlyEquivalent_scale hd ha
      ((Fd.mk_eq_mk_iff (P.scale ha) (Q.scale ha)).mp h)

/-- The canonical map `F_d(T) → F(T)` is injective. -/
theorem Fd.toF_injective (hd : 0 < d) :
    Function.Injective (Fd.toF (A := A) (T := T) (d := d) hd) :=
  Fd.injective_of_strictlyEquivalent (fun _ _ => congrArg Sigma.fst) fun P Q h =>
    Quadruple.strictlyEquivalent_of_equivalent hd ((F.mk_eq_mk_iff_equivalent hd hd P Q).mp h)

end Stacks.AlgebraicGeometry.RelativeProjQcohSheaf

end
