/-!
# Global functions on a geometrically reduced and connected proper scheme

A proper scheme over a field that is both geometrically reduced and geometrically connected has
only the constants as global regular functions: the canonical homomorphism from the base field to
the ring of global sections is an isomorphism.

## Main results

All of these live in the namespace `Stacks.AlgebraicGeometry.ProperSectionsGeom`.

* `isSeparable_of_isSeparableExtension_of_isAlgebraic`: for an algebraic field extension,
  separability in the sense of `Algebra.IsSeparableExtension` is Mathlib's `Algebra.IsSeparable`.
* `isField_globalSections_of_geometricallyConnected`: the global sections of a geometrically
  connected proper scheme over a field form a field.
* `isIso_globalSections_of_isProper`: clause (7) of [Stacks, Tag 0BUG]. For a geometrically
  reduced and geometrically connected proper scheme the canonical homomorphism from the base field
  to the global sections is an isomorphism.

## Implementation notes

The ring `Γ(X, ⊤)` is integral over `k` (`ProperGeomConnected.isIntegral_toSpecΓ_algebraMap`),
reduced because `X` is, and geometrically irreducible over `k` by the connected-sections part of
Tag 0BUG. Reduced with irreducible spectrum makes it a domain, and a domain integral over a field
is a field.

Once `Γ(X, ⊤)` is a field `K`, geometric irreducibility says `K/k` is purely inseparable (Tag
0G33), while geometric reducedness of `X` makes `K` geometrically reduced over `k` — the germ map
`Γ(X, ⊤) ⟶ 𝒪_{X, x}` is injective because `K` is a field, and the stalk is geometrically reduced
by Tag 035W — hence `K/k` is separable by Tag 030W. A purely inseparable separable extension is
trivial.

No finiteness of `Γ(X, ⊤)` over `k` is used, so the separability step goes through
`Algebra.IsSeparableExtension` at each element rather than through the finite-extension lemma
`isSeparable_of_isSeparableExtension`.

## References

* [Stacks Project, Tag 0BUG](https://stacks.math.columbia.edu/tag/0BUG)
* [Stacks Project, Tag 0G33](https://stacks.math.columbia.edu/tag/0G33)
* [Stacks Project, Tag 030W](https://stacks.math.columbia.edu/tag/030W)
* [Stacks Project, Tag 035W](https://stacks.math.columbia.edu/tag/035W)
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry
open scoped AlgebraicGeometry TensorProduct

universe u

namespace Stacks.AlgebraicGeometry.ProperSectionsGeom

/-- For an algebraic field extension, separability in the sense of
`Algebra.IsSeparableExtension` (Stacks Tag 030O (2)) is Mathlib's `Algebra.IsSeparable`. The
extension is not assumed finite: separability is checked on the simple subextension generated by
each element, which is finite. -/
theorem isSeparable_of_isSeparableExtension_of_isAlgebraic (k K : Type*) [Field k] [Field K]
    [Algebra k K] [Algebra.IsAlgebraic k K] [Algebra.IsSeparableExtension k K] :
    Algebra.IsSeparable k K := by
  refine ⟨fun x => ?_⟩
  have : FiniteDimensional k (IntermediateField.adjoin k {x}) :=
    IntermediateField.adjoin.finiteDimensional
      (Algebra.IsAlgebraic.isAlgebraic (R := k) x).isIntegral
  have : Algebra.IsSeparable k (IntermediateField.adjoin k {x}) :=
    isSeparable_of_isSeparablyGenerated k (IntermediateField.adjoin k {x})
  exact IntermediateField.isSeparable_of_mem_isSeparable k K
    (L := IntermediateField.adjoin k {x}) (IntermediateField.mem_adjoin_simple_self k x)

variable (k : Type u) [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))

/-- The global sections of a geometrically connected proper scheme over a field form a field:
they are reduced with irreducible spectrum, hence a domain, and integral over the base field. -/
theorem isField_globalSections_of_geometricallyConnected
    [GeometricallyConnected f] [IsProper f] [IsReduced X] : IsField Γ(X, ⊤) := by
  let alg : Algebra k Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom.toAlgebra
  have hint : Algebra.IsIntegral k Γ(X, ⊤) := ⟨fun x => by
    rw [_root_.IsIntegral, RingHom.algebraMap_toAlgebra]
    exact ProperGeomConnected.isIntegral_toSpecΓ_algebraMap f x⟩
  have hred : _root_.IsReduced Γ(X, ⊤) := AlgebraicGeometry.IsReduced.component_reduced ⊤
  have hirr : IrreducibleSpace (PrimeSpectrum Γ(X, ⊤)) :=
    (PrimeSpectrum.homeomorphOfRingEquiv
      (Algebra.TensorProduct.rid k k Γ(X, ⊤)).toRingEquiv).irreducibleSpace_iff.mp
      ((Algebra.isGeometricallyIrreducible_iff_irreducibleSpace_primeSpectrum_tensorProduct
        k Γ(X, ⊤)).mp (isGeometricallyIrreducible_globalSections_of_isProper k f) k)
  have hredSpec : IsReduced (Spec Γ(X, ⊤)) := (affine_isReduced_iff _).mpr hred
  have hirrSpec : IrreducibleSpace (Spec Γ(X, ⊤)) := hirr
  have hdom : IsDomain Γ(X, ⊤) :=
    (affine_isIntegral_iff _).mp (isIntegral_of_irreducibleSpace_of_isReduced _)
  exact isField_of_isIntegral_of_isField' (R := k) (Field.toIsField k)

/-- If `X` is geometrically reduced over a field `k` and taking germs at some point `x` of `X` is
injective on global sections, then the global sections are geometrically reduced over `k`: the
stalk at `x` is geometrically reduced (Stacks Tag 035W), and geometric reducedness is inherited by
a subalgebra. -/
theorem isGeometricallyReduced_globalSections_of_injective_germ
    [GeometricallyReduced f] (x : X)
    (hinj : Function.Injective (X.presheaf.germ (⊤ : X.Opens) x trivial).hom) :
    letI : Algebra k Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom.toAlgebra
    Algebra.IsGeometricallyReduced k Γ(X, ⊤) := by
  let algΓ : Algebra k Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom.toAlgebra
  let algS : Algebra k ((Spec (.of k)).presheaf.stalk (f.base x)) :=
    StructureSheaf.stalkAlgebra k (f.base x)
  let algSt : Algebra k (X.presheaf.stalk x) :=
    ((f.stalkMap x).hom.comp
      (algebraMap k ((Spec (.of k)).presheaf.stalk (f.base x)))).toAlgebra
  have hgeomStalk : Algebra.IsGeometricallyReduced k (X.presheaf.stalk x) :=
    (isGeometricallyReducedAt_iff_isGeometricallyReduced_stalk f x).mp
      ((geometricallyReduced_iff_forall_isGeometricallyReducedAt f).mp inferInstance x)
  let germAlgHom : Γ(X, ⊤) →ₐ[k] X.presheaf.stalk x :=
    { (X.presheaf.germ ⊤ x trivial).hom with
      commutes' := fun c => (algebraMap_stalk_apply k f x c).symm }
  exact Algebra.IsGeometricallyReduced.of_injective germAlgHom hinj

/-- **[Stacks, Tag 0BUG] (7).** The canonical homomorphism from a field to the global sections
of a geometrically reduced, geometrically connected proper scheme over that field is an
isomorphism.

This is the whole of clause (7): the source's conclusion `A = k` is the assertion that the
homomorphism `k ⟶ Γ(X, 𝒪_X)` induced by the structure morphism is an isomorphism, the standard
identification `Γ(Spec k, 𝒪) ≅ k` being part of that map. -/
@[stacks 0BUG "clause (7): for a GEOMETRICALLY REDUCED and GEOMETRICALLY CONNECTED proper scheme \
over a field k, the global sections are k. The equality A = k is stated canonically, as the \
induced homomorphism from k to the global sections being an isomorphism. Geometric irreducibility \
of the global sections (clause (5)) makes the extension purely inseparable; geometric reducedness \
of a stalk makes it separable (Tag 030W, Tag 035W); a purely inseparable separable extension is \
trivial. No finiteness of the global sections over k is used."]
theorem isIso_globalSections_of_isProper
    [GeometricallyReduced f] [GeometricallyConnected f] [IsProper f] :
    IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop) := by
  have hXred : IsReduced X := self_of_isIntegral_of_geometrically (P := IsReduced)
    (inferInstance : GeometricallyReduced f).geometrically_isReduced
  let alg : Algebra k Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom.toAlgebra
  have hint : Algebra.IsIntegral k Γ(X, ⊤) := ⟨fun x => by
    rw [_root_.IsIntegral, RingHom.algebraMap_toAlgebra]
    exact ProperGeomConnected.isIntegral_toSpecΓ_algebraMap f x⟩
  let fieldΓ : Field Γ(X, ⊤) :=
    (isField_globalSections_of_geometricallyConnected k f).toField
  have halg : Algebra.IsAlgebraic k Γ(X, ⊤) := Algebra.IsIntegral.isAlgebraic
  -- Purely inseparable, from geometric irreducibility of the global sections.
  have hpi : IsPurelyInseparable k Γ(X, ⊤) :=
    (separableClosure.eq_bot_iff (F := k) (E := Γ(X, ⊤))).1
      ((separableClosure.eq_bot_iff_geometricallyIrreducible k Γ(X, ⊤)).2
        (isGeometricallyIrreducible_globalSections_of_isProper k f))
  -- Separable, from geometric reducedness of a stalk.
  have hsep : Algebra.IsSeparable k Γ(X, ⊤) := by
    obtain ⟨x⟩ := (GeometricallyConnected.connectedSpace_of_subsingleton f).toNonempty
    have hsepExt : Algebra.IsSeparableExtension k Γ(X, ⊤) :=
      ((Algebra.isSeparableExtension_tfae k Γ(X, ⊤) (ringExpChar k)).out 4 1).mp
        (isGeometricallyReduced_globalSections_of_injective_germ k f x
          (X.presheaf.germ ⊤ x trivial).hom.injective)
    exact isSeparable_of_isSeparableExtension_of_isAlgebraic k Γ(X, ⊤)
  exact (ConcreteCategory.isIso_iff_bijective
    ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)).mpr
    (IsPurelyInseparable.bijective_algebraMap_of_isSeparable k Γ(X, ⊤))

end Stacks.AlgebraicGeometry.ProperSectionsGeom

end
