/-!
# The symmetric algebra of a quasi-coherent module is generated in degree one

Let `E` be a quasi-coherent `𝒪_X`-module on a scheme `X`, and
`AlgebraicGeometry.Scheme.Modules.symmetricAlgebra X E` its symmetric algebra, the degreewise
sheafification of the sectionwise symmetric algebra. Over every affine open of the base the
algebra is generated in degree one: `Sym^{1+n}` of the sections is additively generated by the
products of a degree-one section with a degree-`n` one. Hence the graded ring of sections of the
relative Proj datum `Stacks.SymGraded.schemeSheafGradedAlgebra` over an affine open is generated
by its degree-one part over its degree-zero part.

## Main results

* `Stacks.SymGraded.eq_top_of_symMul_mem`: `Sym^{1+n}` is generated as an additive group by the
  products of `Sym^1` with `Sym^n`.
* `Stacks.SymGraded.surjective_sheafifyUnit_app_of_isAffineOpen`: over an affine open every
  section of the degree-`n` piece of `Sym(E)` is the unit image of an element of
  `Sym^n_{Γ(X, V)}(Γ(E, V))`.
* `Stacks.SymGraded.isGeneratedInDegreeOne_symmetricAlgebra`: `Sym(E)` is generated in degree
  one over every affine open, in the additive-subgroup form.
* `Stacks.SymGraded.isGeneratedInDegreeOne_schemeSheafGradedAlgebra`: the graded ring of sections
  of the relative Proj datum of `Sym(E)` over an affine open is generated by its degree-one part
  over its degree-zero part.
* `Stacks.SymGraded.exists_degreeOne_notMem`: at every point of the homogeneous spectrum of that
  ring some degree-one section does not vanish.

## Implementation notes

`E` carries `[E.IsQuasicoherent]` and the datum `hqc : Stacks.SymGraded.IsQuasicoherentPieces E`
separately: the second follows from the first
(`Stacks.SymGraded.isQuasicoherentPieces_of_isQuasicoherent`), but not visibly conversely.

Local bijectivity is supplied by name, never by instance search: with the ring comparison
`𝟙 X.ringCatSheaf.obj` the sheaf of rings is an unsolved metavariable at the point of synthesis.
For the same reason the ring comparison and the object of the site are written out at every
application; left implicit, they exceed the heartbeat budget at `isDefEq`. Likewise
`isGeneratedInDegreeOne_symmetricAlgebra` rewrites `Sym(E)` once into its sheafification
spelling, which left to unification is re-derived at every piece.

## References

* [Stacks Project, Tag 01CG](https://stacks.math.columbia.edu/tag/01CG)
* [Stacks Project, Tag 01O4](https://stacks.math.columbia.edu/tag/01O4)
* [Stacks Project, Tag 01OB](https://stacks.math.columbia.edu/tag/01OB)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace Opposite
open PresheafOfModules
open Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.AlgebraicGeometry.ImmersionRestrict

namespace Stacks.SymGraded

universe u

/-! ### The algebraic input -/

section Algebra

variable {R : Type u} [CommRing R] (M : Type u) [AddCommGroup M] [Module R M]

/-- **`Sym^{1+n}` is the product of `Sym^1` with `Sym^n`**, as submodules of the symmetric
algebra. -/
theorem gradedPiece_one_add (n : ℕ) :
    gradedPiece (R := R) M (1 + (n : ℤ)) =
      gradedPiece (R := R) M 1 * gradedPiece (R := R) M (n : ℤ) := by
  change SymPow.symmetricPower (1 + n) R M
      = SymPow.symmetricPower 1 R M * SymPow.symmetricPower n R M
  rw [SymPow.symmetricPower, SymPow.symmetricPower, SymPow.symmetricPower, pow_add]

/-- **The degree-`1 + n` symmetric power is generated as an additive group by the products of a
degree-one element with a degree-`n` one.** -/
theorem eq_top_of_symMul_mem (n : ℕ)
    (P : AddSubgroup (gradedPiece (R := R) M (1 + (n : ℤ))))
    (hP : ∀ (x : gradedPiece (R := R) M 1) (y : gradedPiece (R := R) M (n : ℤ)),
      symMulₗ M 1 (n : ℤ) x y ∈ P) : P = ⊤ := by
  set Q : AddSubgroup (SymmetricAlgebra R M) :=
    P.map ((gradedPiece (R := R) M (1 + (n : ℤ))).subtype.toAddMonoidHom)
  have hmemQ : ∀ z : gradedPiece (R := R) M (1 + (n : ℤ)),
      (z : SymmetricAlgebra R M) ∈ Q → z ∈ P := by
    intro z hz
    obtain ⟨w, hwP, hw⟩ := hz
    exact (Subtype.ext hw : w = z) ▸ hwP
  refine top_unique fun z _ => hmemQ z ?_
  have hz : (z : SymmetricAlgebra R M) ∈
      gradedPiece (R := R) M 1 * gradedPiece (R := R) M (n : ℤ) := by
    rw [← gradedPiece_one_add M n]; exact z.2
  refine Submodule.mul_induction_on hz ?_ fun x y hx hy => Q.add_mem hx hy
  intro a ha b hb
  exact ⟨symMulₗ M 1 (n : ℤ) ⟨a, ha⟩ ⟨b, hb⟩, hP _ _, rfl⟩

end Algebra

/-! ### The geometric input: the sheafification unit is surjective over an affine open -/

section Surjectivity

open Stacks.SymGraded.AffinePieces

variable {X : Scheme.{u}} (E : X.Modules) [E.IsQuasicoherent] {V : X.Opens}
  (hV : IsAffineOpen V) (n : ℤ)

omit [E.IsQuasicoherent] hV in
/-- **The comparison with the associated sheaf is surjective on the global sections of
`Spec Γ(X, V)`.** -/
theorem surjective_toTilde_app_top : Function.Surjective
    (Hom.app (Stacks.AffineBaseChange.toTilde (pieceAt E V n))
      (op (⊤ : (Spec Γ(X, V)).Opens))) := by
  have h := Stacks.AffineBaseChange.surjective_toTildeₗ_basicOpen (pieceAt E V n) (1 : Γ(X, V))
  rwa [show Stacks.AffineBaseChange.specBasicOpen (1 : Γ(X, V)) =
    (⊤ : (Spec Γ(X, V)).Opens) from PrimeSpectrum.basicOpen_one] at h

omit [E.IsQuasicoherent] hV in
/-- **The sheafification unit of the base-change presheaf of `Sym^n_{Γ(X, V)}(Γ(E, V))` is
surjective on the global sections of `Spec Γ(X, V)`.** -/
theorem surjective_sheafifyUnit_app_baseChange_top :
    Function.Surjective (Hom.app (sheafifyUnit (𝟙 (Spec Γ(X, V)).ringCatSheaf.obj)
      (Stacks.AffineBaseChange.presheaf (pieceAt E V n)))
      (op (⊤ : (Spec Γ(X, V)).Opens))) :=
  Stacks.PresheafOfModules.surjective_sheafifyUnit_app_of_surjective
    (𝟙 (Spec Γ(X, V)).ringCatSheaf.obj) (tilde (pieceAt E V n))
    (Stacks.AffineBaseChange.toTilde (pieceAt E V n))
    (Stacks.AffineBaseChange.isLocallyInjective_toTilde (pieceAt E V n))
    (Stacks.AffineBaseChange.isLocallySurjective_toTilde (pieceAt E V n))
    (op (⊤ : (Spec Γ(X, V)).Opens)) (surjective_toTilde_app_top E n)

include hV in
/-- **The sheafification unit of the restriction along `fromSpec` of the sectionwise degree-`n`
symmetric power is surjective on the global sections of `Spec Γ(X, V)`.** -/
theorem surjective_sheafifyUnit_app_restrict_top :
    Function.Surjective (Hom.app (sheafifyUnit (𝟙 (Spec Γ(X, V)).ringCatSheaf.obj)
      ((presheafRestrict hV.fromSpec).obj (siteGradedPiece E.val n)))
      (op (⊤ : (Spec Γ(X, V)).Opens))) :=
  Stacks.PresheafOfModules.surjective_sheafifyUnit_app_of_isLocallyBijective
    (𝟙 (Spec Γ(X, V)).ringCatSheaf.obj) (toPiece E hV n)
    (isLocallyInjective_toPiece E hV n) (isLocallySurjective_toPiece E hV n)
    (op (⊤ : (Spec Γ(X, V)).Opens)) (surjective_sheafifyUnit_app_baseChange_top E n)

include hV in
/-- **The restriction along `fromSpec` of the sheafification unit is surjective on the global
sections of `Spec Γ(X, V)`.** -/
theorem surjective_restrict_map_sheafifyUnit_app_top :
    Function.Surjective (Hom.app ((presheafRestrict hV.fromSpec).map
      (sheafifyUnit (R := X.ringCatSheaf) (𝟙 X.ringCatSheaf.obj) (siteGradedPiece E.val n)))
      (op (⊤ : (Spec Γ(X, V)).Opens))) := by
  have _hi := Stacks.AlgebraicGeometry.SheafifyRestrict.isLocallyInjective_sheafifyUnit
    (siteGradedPiece E.val n)
  have _hs := Stacks.AlgebraicGeometry.SheafifyRestrict.isLocallySurjective_sheafifyUnit
    (siteGradedPiece E.val n)
  exact Stacks.PresheafOfModules.surjective_app_of_surjective_sheafifyUnit_app
    (𝟙 (Spec Γ(X, V)).ringCatSheaf.obj)
    ((Scheme.Modules.restrictFunctor hV.fromSpec).obj
      ((PresheafOfModules.sheafification (𝟙 X.ringCatSheaf.obj)).obj (siteGradedPiece E.val n)))
    ((presheafRestrict hV.fromSpec).map
      (sheafifyUnit (R := X.ringCatSheaf) (𝟙 X.ringCatSheaf.obj) (siteGradedPiece E.val n)))
    (isLocallyInjective_presheafRestrict_map hV.fromSpec
      (sheafifyUnit (R := X.ringCatSheaf) (𝟙 X.ringCatSheaf.obj) (siteGradedPiece E.val n)))
    (isLocallySurjective_presheafRestrict_map hV.fromSpec
      (sheafifyUnit (R := X.ringCatSheaf) (𝟙 X.ringCatSheaf.obj) (siteGradedPiece E.val n)))
    (op (⊤ : (Spec Γ(X, V)).Opens)) (surjective_sheafifyUnit_app_restrict_top E hV n)

include hV in
/-- **Over an affine open, every section of the degree-`n` piece of `Sym(E)` is the image of an
element of `Sym^n_{Γ(X, V)}(Γ(E, V))` under the sheafification unit.** -/
theorem surjective_sheafifyUnit_app_of_isAffineOpen :
    Function.Surjective (Hom.app
      (sheafifyUnit (R := X.ringCatSheaf) (𝟙 X.ringCatSheaf.obj) (siteGradedPiece E.val n))
      (op V)) := by
  have h : Function.Surjective (Hom.app
      (sheafifyUnit (R := X.ringCatSheaf) (𝟙 X.ringCatSheaf.obj) (siteGradedPiece E.val n))
      (op (hV.fromSpec ''ᵁ (⊤ : (Spec Γ(X, V)).Opens)))) :=
    surjective_restrict_map_sheafifyUnit_app_top E hV n
  rwa [show hV.fromSpec ''ᵁ (⊤ : (Spec Γ(X, V)).Opens) = V from
    (Scheme.Hom.image_top_eq_opensRange hV.fromSpec).trans hV.opensRange_fromSpec] at h

end Surjectivity

/-! ### Generation in degree one -/

section Generation

variable {X : Scheme.{u}} (E : X.Modules) [E.IsQuasicoherent]

/-- **`Sym(E)` is generated in degree one over an affine open of the base.** Every additive
subgroup of the degree-`1 + n` sections there which contains all products of a degree-one section
with a degree-`n` one is everything. -/
theorem isGeneratedInDegreeOne_symmetricAlgebra {V : X.Opens} (hV : IsAffineOpen V) :
    SheafOfModules.GradedAlgebra.IsGeneratedInDegreeOne
      (Scheme.Modules.symmetricAlgebra X E) (op V) := by
  rw [show Scheme.Modules.symmetricAlgebra X E
      = (sitePresheafAlgebra E.val).sheafify (𝟙 X.ringCatSheaf.obj) from rfl]
  intro n P hP
  refine top_unique fun s _ => ?_
  obtain ⟨t, hts⟩ := surjective_sheafifyUnit_app_of_isAffineOpen E hV (1 + (n : ℤ)) s
  set Q : AddSubgroup ((siteGradedPiece E.val (1 + (n : ℤ))).obj (op V)) :=
    P.comap (Hom.app
      (sheafifyUnit (R := X.ringCatSheaf) (𝟙 X.ringCatSheaf.obj)
        (siteGradedPiece E.val (1 + (n : ℤ)))) (op V)).hom.toAddMonoidHom
  have hQ : Q = ⊤ := by
    refine eq_top_of_symMul_mem _ n Q fun x y => ?_
    have hmul := (sitePresheafAlgebra E.val).sheafify_mul_unit
      (𝟙 X.ringCatSheaf.obj) 1 (n : ℤ) (op V) x y
    change Hom.app
        (sheafifyUnit (R := X.ringCatSheaf) (𝟙 X.ringCatSheaf.obj)
          (siteGradedPiece E.val (1 + (n : ℤ)))) (op V)
      ((siteMul E.val 1 (n : ℤ)).app (op V) x y) ∈ P
    exact hmul ▸ hP _ _
  have hmem : t ∈ Q := hQ.symm ▸ AddSubgroup.mem_top t
  exact hts ▸ hmem

variable (hqc : IsQuasicoherentPieces E)

/-- The two spellings of generation in degree one agree: the one for a sheaf of graded algebras
and the one for the relative Proj datum it converts to. -/
theorem isGeneratedInDegreeOneAt_toSheafGradedAlgebra {S : Scheme.{u}}
    (A : SheafOfModules.GradedAlgebra.{u, u} S.ringCatSheaf)
    (hcomm : Stacks.AlgebraicGeometry.SheafSymmetricAlgebra.IsCommutative A)
    (hneg : Stacks.AlgebraicGeometry.SheafSymmetricAlgebra.VanishesInNegativeDegrees A)
    (hq : ∀ n : ℤ, ((A.piece n : S.Modules)).IsQuasicoherent) (U : S.Opens)
    (h : A.IsGeneratedInDegreeOne (op U)) :
    (Stacks.AlgebraicGeometry.SheafSymmetricAlgebra.toSheafGradedAlgebra
      A hcomm hneg hq).IsGeneratedInDegreeOneAt U := h

/-- **The relative Proj datum of `Sym(E)` is generated in degree one over every affine open.** -/
theorem isGeneratedInDegreeOneAt_schemeSheafGradedAlgebra {V : X.Opens} (hV : IsAffineOpen V) :
    (schemeSheafGradedAlgebra E hqc).IsGeneratedInDegreeOneAt V :=
  isGeneratedInDegreeOne_symmetricAlgebra E hV

/-- **`Sym(E)` is generated in degree one**: over every affine open of the base the graded ring of
sections of its relative Proj datum is generated, as an algebra over its degree-zero part, by its
degree-one part. -/
theorem isGeneratedInDegreeOne_schemeSheafGradedAlgebra :
    Stacks.AlgebraicGeometry.ProjRepresentsF1.IsGeneratedInDegreeOne
      (schemeSheafGradedAlgebra E hqc) := fun V hV =>
  (schemeSheafGradedAlgebra E hqc).adjoin_grading_one_eq_top V
    (isGeneratedInDegreeOneAt_schemeSheafGradedAlgebra E hqc hV)

/-- **At every point of the homogeneous spectrum of the graded ring of sections of `Sym(E)` over
an affine open, some degree-one section does not vanish.** -/
theorem exists_degreeOne_notMem {V : X.Opens} (hV : IsAffineOpen V)
    (x : ProjectiveSpectrum ((schemeSheafGradedAlgebra E hqc).grading V)) :
    ∃ a : ((schemeSheafGradedAlgebra E hqc).grading V) 1,
      (a : (schemeSheafGradedAlgebra E hqc).sectionRing V) ∉ x.asHomogeneousIdeal :=
  Stacks.AlgebraicGeometry.TwistRigidityDegreeOne.exists_degreeOne_notMem_of_adjoin_eq_top
    (isGeneratedInDegreeOne_schemeSheafGradedAlgebra E hqc V hV) x

end Generation

end Stacks.SymGraded

end
