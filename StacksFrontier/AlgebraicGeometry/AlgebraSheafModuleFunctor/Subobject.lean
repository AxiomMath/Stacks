module

public import StacksFrontier.AlgebraicGeometry.AlgebraSheafModuleFunctor.Basic
public import StacksFrontier.AlgebraicGeometry.FiniteTypeSubalgebra.Basic
public import StacksFrontier.AlgebraicGeometry.IntegralApproximation.Finiteness
public import StacksFrontier.CategoryTheory.Images.Sheaf

/-!
# Reading the properties of a subalgebra off a monomorphism

The finite type quasi-coherent subalgebras of an algebra sheaf `A` are, by
`Stacks.AlgebraicGeometry.FiniteTypeSubalgebras.FiniteTypeSubalgebra`, the objects of
`CategoryTheory.Subobject A` whose underlying algebra sheaf is quasi-coherent and of finite type.
A construction, however, produces a monomorphism `i : B ⟶ A`, and the properties are known for
`B`, not for the representative that `CategoryTheory.Subobject.mk` chooses.  This file closes that
gap for all five properties and packages the result as a constructor
`Stacks.AlgebraicGeometry.FiniteTypeSubalgebras.ofMono`.

It then records what is left of the directedness half of Stacks Tag 05JT.  The join of two
subobjects of an algebra sheaf now exists -- `CategoryTheory.Subobject.semilatticeSup` is
synthesized at this signature, out of
`Stacks.SheafImages.hasImagesTopCatSheaf` and
`Stacks.AlgebraicGeometry.FiniteTypeSubalgebras.hasBinaryCoproducts` -- and
`Stacks.AlgebraicGeometry.FiniteTypeSubalgebras.isFiltered_of_exists_join` already supplies the
formal part of filteredness.  So the whole of directedness is now one statement about that join,
isolated here as `Stacks.AlgebraicGeometry.FiniteTypeSubalgebras.SupClosed`.

## Main definitions

* `Stacks.AlgebraicGeometry.FiniteTypeSubalgebras.ofMono`: a monomorphism of algebra sheaves
  whose source is quasi-coherent and of finite type, as an object of `FiniteTypeSubalgebra A`.
* `Stacks.AlgebraicGeometry.FiniteTypeSubalgebras.SupClosed`: the statement that the join of two
  quasi-coherent finite type subobjects is quasi-coherent and of finite type.

## Main results

* `isQuasicoherent_mk`, `isFiniteType_mk`, `isFinite_mk`, `isFinitePresentation_mk`,
  `isIntegral_mk`: each of the five properties passes from the source of a monomorphism to the
  subobject it represents.
* `Stacks.AlgebraicGeometry.FiniteTypeSubalgebras.isFiltered_of_supClosed`: the directedness
  assertion of Stacks Tag 05JT, assuming `SupClosed` and nonemptiness.

## What is not done

`SupClosed` is not proved, and neither is `Nonempty (FiniteTypeSubalgebra A)`.  Both ask for the
same unavailable thing, and it is worth naming precisely.  The join of `S` and `T` is
`CategoryTheory.Limits.image` of the morphism out of their coproduct, and the image in a category
of sheaves -- by the construction in `Stacks.SheafImages.hasImages` -- is the sheafification of
the image presheaf.  So its sections over an affine open are *not* the subalgebra of `A(U)`
generated by the images of `S(U)` and `T(U)`; identifying the two is exactly the
quasi-compactness argument of the Stacks proof, and only then does
`Stacks.RingTheory.FiniteTypeSubalgebra.finiteType_of_sup_range_eq_top` apply.  Nonemptiness is
the same obstruction for the image of `𝒪_X` in `A`: that image exists now, but its sections over
an affine open are the sheafification's, and finite type of its structure morphism needs the
morphism to be surjective on those sections, not merely locally surjective.

## References

* [The Stacks Project, Tag 05JT](https://stacks.math.columbia.edu/tag/05JT)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open Stacks.RelativeSpec

universe u

namespace Stacks.AlgebraicGeometry.FiniteTypeSubalgebras

variable {X : Scheme.{u}} {A B : AlgebraSheaf X}

section Representative

variable (i : B ⟶ A) [Mono i]

/-- Quasi-coherence passes from the source of a monomorphism to the subobject it represents. -/
theorem isQuasicoherent_mk (hB : B.IsQuasicoherent) :
    ((Subobject.mk i : Subobject A) : AlgebraSheaf X).IsQuasicoherent :=
  AlgebraSheaf.isQuasicoherent_of_iso (Subobject.underlyingIso i).symm hB

/-- Finite type passes from the source of a monomorphism to the subobject it represents. -/
theorem isFiniteType_mk (hB : B.IsFiniteType) :
    ((Subobject.mk i : Subobject A) : AlgebraSheaf X).IsFiniteType :=
  isFiniteType_of_iso (Subobject.underlyingIso i).symm hB

/-- Finiteness passes from the source of a monomorphism to the subobject it represents. -/
theorem isFinite_mk (hB : B.IsFinite) :
    ((Subobject.mk i : Subobject A) : AlgebraSheaf X).IsFinite :=
  AlgebraSheaf.isFinite_of_iso (Subobject.underlyingIso i).symm hB

/-- Finite presentation passes from the source of a monomorphism to the subobject it
represents. -/
theorem isFinitePresentation_mk (hB : B.IsFinitePresentation) :
    ((Subobject.mk i : Subobject A) : AlgebraSheaf X).IsFinitePresentation :=
  AlgebraSheaf.isFinitePresentation_of_iso (Subobject.underlyingIso i).symm hB

/-- Integrality passes from the source of a monomorphism to the subobject it represents. -/
theorem isIntegral_mk (hB : B.IsIntegral) :
    ((Subobject.mk i : Subobject A) : AlgebraSheaf X).IsIntegral :=
  AlgebraSheaf.isIntegral_of_iso (Subobject.underlyingIso i).symm hB

/-- A monomorphism of algebra sheaves whose source is quasi-coherent and of finite type is an
object of `FiniteTypeSubalgebra A`. -/
def ofMono (hqc : B.IsQuasicoherent) (hft : B.IsFiniteType) : FiniteTypeSubalgebra A :=
  ⟨Subobject.mk i, isQuasicoherent_mk i hqc, isFiniteType_mk i hft⟩

/-- The subobject underlying `ofMono i` is the one `i` represents. -/
@[simp]
theorem ofMono_obj (hqc : B.IsQuasicoherent) (hft : B.IsFiniteType) :
    (ofMono i hqc hft).obj = Subobject.mk i :=
  rfl

end Representative

section Join

variable (A)

/-- The property that the join, in `CategoryTheory.Subobject A`, of two quasi-coherent finite
type subalgebras is again quasi-coherent and of finite type. -/
def SupClosed : Prop :=
  ∀ S T : Subobject A,
    (S : AlgebraSheaf X).IsQuasicoherent → (S : AlgebraSheaf X).IsFiniteType →
    (T : AlgebraSheaf X).IsQuasicoherent → (T : AlgebraSheaf X).IsFiniteType →
    ((S ⊔ T : Subobject A) : AlgebraSheaf X).IsQuasicoherent ∧
      ((S ⊔ T : Subobject A) : AlgebraSheaf X).IsFiniteType

/-- Under `SupClosed`, any two finite type quasi-coherent subalgebras are contained in a third,
namely their join. -/
theorem exists_join_of_supClosed (h : SupClosed A) (B C : FiniteTypeSubalgebra A) :
    ∃ D : FiniteTypeSubalgebra A, B.obj ≤ D.obj ∧ C.obj ≤ D.obj :=
  ⟨⟨B.obj ⊔ C.obj, h _ _ B.property.1 B.property.2 C.property.1 C.property.2⟩,
    le_sup_left, le_sup_right⟩

/-- Under `SupClosed`, the finite type quasi-coherent subalgebras of `A` form a
filtered-or-empty category. -/
theorem isFilteredOrEmpty_of_supClosed (h : SupClosed A) :
    IsFilteredOrEmpty (FiniteTypeSubalgebra A) :=
  isFilteredOrEmpty_of_exists_join A (exists_join_of_supClosed A h)

/-- **The directedness assertion of Stacks Tag 05JT, modulo `SupClosed` and nonemptiness.** -/
theorem isFiltered_of_supClosed (hne : Nonempty (FiniteTypeSubalgebra A)) (h : SupClosed A) :
    IsFiltered (FiniteTypeSubalgebra A) :=
  isFiltered_of_exists_join A hne (exists_join_of_supClosed A h)

end Join

end Stacks.AlgebraicGeometry.FiniteTypeSubalgebras
