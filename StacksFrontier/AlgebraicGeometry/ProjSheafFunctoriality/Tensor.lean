/-- The additive map out of the tensor product on a pure tensor of sections. -/
theorem tensorModuleSectionsAddHom_tmul
    (U : Opens (ProjectiveSpectrum.top 𝒮))
    (a : ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒨 U)
    (b : ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒩 U) :
    tensorModuleSectionsAddHom (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨) (𝒩 := 𝒩) U
