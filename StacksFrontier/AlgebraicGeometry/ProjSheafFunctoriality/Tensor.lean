    (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 𝒨 hf n m hm)).1 x = _
  exact ProjectiveSpectrum.Proj.degreeZeroToSection_fraction 𝒮 𝒨 hf n m hm x

/-- On a positive-degree standard open, the canonical morphism sends the tensor of two
homogeneous fractions to the fraction of their tensor over the product of the denominators. -/
@[stacks 01MK "formula on standard opens", ega "II 2.5.11" "λ_f on D_+(f)"]
theorem associatedModuleSheafTensorMap_standardOpen
    {f : S} {d : ℕ} (hf : f ∈ 𝒮 d) (hd : 0 < d)
    (p q : ℕ) (m : M) (hm : m ∈ 𝒨 (p • (d : ℤ)))
    (n : N) (hn : n ∈ 𝒩 (q • (d : ℤ))) :
    letI := tensorGrading_decomposition (S := S) 𝒮 𝒨 𝒩
    letI := tensorGrading_gradedSMul (S := S) 𝒮 𝒨 𝒩
    let U := ProjectiveSpectrum.basicOpen 𝒮 f
    let F := ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒨
    let G := ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒩
    ((associatedModuleSheafTensorMap 𝒮 𝒨 𝒩).val.app (op U))
      (Stacks.SheafOfModules.TensorStalkRingedSpace.toTensorSheafSection
        (_root_.AlgebraicGeometry.Proj 𝒮).toRingedSpace F G (op U)
        (((ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮 𝒨 hf hd).symm
          (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 𝒨 hf p m hm)) ⊗ₜ[_]
         ((ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮 𝒩 hf hd).symm
          (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 𝒩 hf q n hn)))) =
      (ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮
        (tensorGrading (S := S) 𝒨 𝒩) hf hd).symm
        (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 (tensorGrading (S := S) 𝒨 𝒩)
          hf (p + q) (m ⊗ₜ[S] n)
          (by
            apply AddSubgroup.subset_closure
            refine ⟨p • (d : ℤ), q • (d : ℤ), ?_, m, hm, n, hn, rfl⟩
            simp [add_mul])) := by
  let _ := tensorGrading_decomposition (S := S) 𝒮 𝒨 𝒩
  let _ := tensorGrading_gradedSMul (S := S) 𝒮 𝒨 𝒩
  dsimp
  refine .trans (associatedModuleSheafTensorMap_app_toTensorSheafSection 𝒮 𝒨 𝒩 _ _) ?_
  change tensorModuleSectionsAddHom (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨) (𝒩 := 𝒩)
      (ProjectiveSpectrum.basicOpen 𝒮 f)
      (((ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮 𝒨 hf hd).symm
        (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 𝒨 hf p m hm)) ⊗ₜ[
          ↑((ProjectiveSpectrum.Proj.structureSheaf 𝒮).obj.obj
            (op (ProjectiveSpectrum.basicOpen 𝒮 f)))]
        ((ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮 𝒩 hf hd).symm
          (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 𝒩 hf q n hn))) = _
  refine .trans (tensorModuleSectionsAddHom_tmul 𝒮 𝒨 𝒩 _ _ _) ?_
  apply Subtype.ext
  funext x
  change tensorLocalizationEquivOverLocalization
      (S := S) (M := M) (N := N) x.1.asHomogeneousIdeal.toIdeal.primeCompl
      ((ProjectiveSpectrum.Proj.associatedModuleSheafSectionsEquiv 𝒮 𝒨
          (ProjectiveSpectrum.basicOpen 𝒮 f)
          ((ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮 𝒨 hf hd).symm
            (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 𝒨 hf p m hm))).1 x ⊗ₜ[S]
       (ProjectiveSpectrum.Proj.associatedModuleSheafSectionsEquiv 𝒮 𝒩
          (ProjectiveSpectrum.basicOpen 𝒮 f)
          ((ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮 𝒩 hf hd).symm
            (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 𝒩 hf q n hn))).1 x) =
    _
  rw [associatedModuleSheafStandardOpenEquiv_symm_fraction_apply,
    associatedModuleSheafStandardOpenEquiv_symm_fraction_apply,
    tensorLocalizationEquivOverLocalization_mk]
  refine .trans ?_ (associatedModuleSheafStandardOpenEquiv_symm_fraction_apply 𝒮
    (tensorGrading (S := S) 𝒨 𝒩) hf hd (p + q) (m ⊗ₜ[S] n) _ x).symm
  congr 1
  apply Subtype.ext
  simp [pow_add]

/-- On the stalk at a homogeneous prime of a positive-degree standard open, the canonical
morphism carries the tensor of the germs of two homogeneous fractions to the germ of the
fraction of their tensor. -/
@[stacks 01MK "formula on stalks"]
theorem associatedModuleSheafTensorMap_stalk
    {f : S} {d : ℕ} (hf : f ∈ 𝒮 d) (hd : 0 < d)
    (x : ProjectiveSpectrum.top 𝒮)
    (hx : x ∈ ProjectiveSpectrum.basicOpen 𝒮 f)
    (p q : ℕ) (m : M) (hm : m ∈ 𝒨 (p • (d : ℤ)))
    (n : N) (hn : n ∈ 𝒩 (q • (d : ℤ))) :
    letI := tensorGrading_decomposition (S := S) 𝒮 𝒨 𝒩
    letI := tensorGrading_gradedSMul (S := S) 𝒮 𝒨 𝒩
    let X := (_root_.AlgebraicGeometry.Proj 𝒮).toRingedSpace
    let U := ProjectiveSpectrum.basicOpen 𝒮 f
    let F := ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒨
    let G := ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒩
    let T := ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 (tensorGrading (S := S) 𝒨 𝒩)
    letI := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule X F.val x
    letI := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule X G.val x
    letI := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule X
      ((((Stacks.SheafOfModules.Tensor.sheafTensor (X).sheaf).obj (F)).obj (G))).val x
    letI := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule X T.val x
    Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X
      ((((Stacks.SheafOfModules.Tensor.sheafTensor (X).sheaf).obj (F)).obj (G))).val T.val
      (associatedModuleSheafTensorMap 𝒮 𝒨 𝒩).val x
      ((Stacks.SheafOfModules.TensorStalkRingedSpace.tensorStalkIso X x F G).symm
        ((Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x U hx
            ((ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮 𝒨 hf hd).symm
              (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 𝒨 hf p m hm)))
          ⊗ₜ[Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x]
         (Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X G.val x U hx
            ((ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮 𝒩 hf hd).symm
              (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 𝒩 hf q n hn))))) =
      Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X T.val x U hx
        ((ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮
          (tensorGrading (S := S) 𝒨 𝒩) hf hd).symm
          (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 (tensorGrading (S := S) 𝒨 𝒩)
            hf (p + q) (m ⊗ₜ[S] n)
            (by
              apply AddSubgroup.subset_closure
              refine ⟨p • (d : ℤ), q • (d : ℤ), ?_, m, hm, n, hn, rfl⟩
              simp [add_mul]))) := by
  let _ := tensorGrading_decomposition (S := S) 𝒮 𝒨 𝒩
  let _ := tensorGrading_gradedSMul (S := S) 𝒮 𝒨 𝒩
  let X := (_root_.AlgebraicGeometry.Proj 𝒮).toRingedSpace
  let U := ProjectiveSpectrum.basicOpen 𝒮 f
  let F : SheafOfModules (structureSheafRing X) :=
    ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒨
  let G : SheafOfModules (structureSheafRing X) :=
    ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒩
  let T : SheafOfModules (structureSheafRing X) :=
    ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 (tensorGrading (S := S) 𝒨 𝒩)
  let _ := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule X F.val x
  let _ := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule X G.val x
  let _ := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule X
    ((((Stacks.SheafOfModules.Tensor.sheafTensor (X).sheaf).obj (F)).obj (G))).val x
  let _ := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule X T.val x
  let tM := (ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮 𝒨 hf hd).symm
      (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 𝒨 hf p m hm)
  let tN := (ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮 𝒩 hf hd).symm
      (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 𝒩 hf q n hn)
  have hIso : (Stacks.SheafOfModules.TensorStalkRingedSpace.tensorStalkIso X x F G).symm
      ((Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x U hx tM)
        ⊗ₜ[Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x]
        (Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X G.val x U hx tN)) =
      Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X
        ((((Stacks.SheafOfModules.Tensor.sheafTensor (X).sheaf).obj (F)).obj (G))).val x U hx
        (Stacks.SheafOfModules.TensorStalkRingedSpace.toTensorSheafSection X F G (op U) (tM ⊗ₜ[_]
          tN)) :=
    (Stacks.SheafOfModules.TensorStalkRingedSpace.tensorStalkIso X x F G).symm_apply_eq.mpr
      (Stacks.SheafOfModules.TensorStalkRingedSpace.tensorStalkIso_germ X x F G U hx tM tN).symm
  change Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X
    ((((Stacks.SheafOfModules.Tensor.sheafTensor (X).sheaf).obj (F)).obj (G))).val T.val
      (associatedModuleSheafTensorMap 𝒮 𝒨 𝒩).val x
      ((Stacks.SheafOfModules.TensorStalkRingedSpace.tensorStalkIso X x F G).symm
        ((Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x U hx tM)
          ⊗ₜ[Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x]
         (Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X G.val x U hx tN))) = _
  rw [hIso]
  calc
    _ = Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X T.val x U hx
        (((associatedModuleSheafTensorMap 𝒮 𝒨 𝒩).val.app (op U)).hom
          (Stacks.SheafOfModules.TensorStalkRingedSpace.toTensorSheafSection X F G (op U) (tM ⊗ₜ[_]
            tN))) :=
      TopCat.Presheaf.stalkFunctor_map_germ_apply' U x hx
        ((PresheafOfModules.toPresheaf (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)).map
          (associatedModuleSheafTensorMap 𝒮 𝒨 𝒩).val) _
    _ = _ := congrArg (Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X T.val x U hx)
      (associatedModuleSheafTensorMap_standardOpen
        (𝒮 := 𝒮) (𝒨 := 𝒨) (𝒩 := 𝒩) hf hd p q m hm n hn)

end Stacks.AlgebraicGeometry.ProjSheafFunctoriality

