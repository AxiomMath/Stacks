variable {S M N : Type u} {σ : Type w} {τ : Type t} {υ : Type t'}
  [CommRing S] [AddCommGroup M] [Module S M] [AddCommGroup N] [Module S N]
  [SetLike σ S] [AddSubgroupClass σ S] (𝒮 : ℕ → σ) [GradedRing 𝒮]
  [SetLike τ M] [AddSubgroupClass τ M] (𝒨 : ℤ → τ) [Decomposition 𝒨]
  [SetLike.GradedSMul 𝒮 𝒨]
  [SetLike υ N] [AddSubgroupClass υ N] (𝒩 : ℤ → υ) [Decomposition 𝒩]
  [SetLike.GradedSMul 𝒮 𝒩]

/-! ### The localization of a tensor product

The equivalence below is the bridge used to turn a tensor of local fractions into a fraction
in the localized tensor module. -/

/-- The localization of a tensor product is the tensor product of the localizations. -/
def tensorLocalizationEquiv (P : Submonoid S) :
    LocalizedModule P M ⊗[S] LocalizedModule P N ≃ₗ[S]
      LocalizedModule P (M ⊗[S] N) :=
  IsLocalizedModule.linearEquiv P
    (TensorProduct.map (LocalizedModule.mkLinearMap P M) (LocalizedModule.mkLinearMap P N))
    (LocalizedModule.mkLinearMap P (M ⊗[S] N))

/-- The bridge of `tensorLocalizationEquiv`, read as an equivalence of modules over the
localized ring. -/
def tensorLocalizationEquivOverLocalization (P : Submonoid S) :
    LocalizedModule P M ⊗[S] LocalizedModule P N ≃ₗ[Localization P]
      LocalizedModule P (M ⊗[S] N) :=
  (tensorLocalizationEquiv (S := S) (M := M) (N := N) P).extendScalarsOfIsLocalization
    P (Localization P)

/-- The bridge sends a tensor of fractions to the fraction of their tensor. -/
theorem tensorLocalizationEquiv_mk (P : Submonoid S)
    (m : M) (s : P) (n : N) (t : P) :
    tensorLocalizationEquiv (S := S) (M := M) (N := N) P
      (LocalizedModule.mk m s ⊗ₜ[S] LocalizedModule.mk n t) =
      LocalizedModule.mk (m ⊗ₜ[S] n) (s * t) := by
  let e := (tensorLocalizationEquiv (S := S) (M := M) (N := N) P).toLinearMap
    |>.extendScalarsOfIsLocalization P (Localization P)
  have hm : LocalizedModule.mk m s = (Localization.mk 1 s) • LocalizedModule.mk m 1 := by
    rw [LocalizedModule.mk_smul_mk]
    simp
  have hn : LocalizedModule.mk n t = (Localization.mk 1 t) • LocalizedModule.mk n 1 := by
    rw [LocalizedModule.mk_smul_mk]
    simp
  have hnum : e (LocalizedModule.mk m 1 ⊗ₜ[S] LocalizedModule.mk n 1) =
      LocalizedModule.mk (m ⊗ₜ[S] n) 1 := by
    change IsLocalizedModule.linearEquiv P
      (TensorProduct.map (LocalizedModule.mkLinearMap P M)
        (LocalizedModule.mkLinearMap P N))
      (LocalizedModule.mkLinearMap P (M ⊗[S] N))
      ((LocalizedModule.mkLinearMap P M) m ⊗ₜ[S]
        (LocalizedModule.mkLinearMap P N) n) = _
    exact IsLocalizedModule.linearEquiv_apply P
      (TensorProduct.map (LocalizedModule.mkLinearMap P M)
        (LocalizedModule.mkLinearMap P N))
      (LocalizedModule.mkLinearMap P (M ⊗[S] N)) (m ⊗ₜ[S] n)
  have hsmul (a b : Localization P) (x : LocalizedModule P M) (y : LocalizedModule P N) :
      (a • x) ⊗ₜ[S] (b • y) = (a * b) • (x ⊗ₜ[S] y) := by
    calc
      (a • x) ⊗ₜ[S] (b • y) = x ⊗ₜ[S] (a • (b • y)) := by
        rw [TensorProduct.smul_tmul]
      _ = x ⊗ₜ[S] ((a * b) • y) := by rw [← smul_smul]
      _ = (a * b) • (x ⊗ₜ[S] y) := by rw [TensorProduct.tmul_smul]
  calc
    e (LocalizedModule.mk m s ⊗ₜ[S] LocalizedModule.mk n t) =
        e ((Localization.mk 1 s • LocalizedModule.mk m 1) ⊗ₜ[S]
          (Localization.mk 1 t • LocalizedModule.mk n 1)) := by rw [hm, hn]
    _ = (Localization.mk 1 s * Localization.mk 1 t) •
        e (LocalizedModule.mk m 1 ⊗ₜ[S] LocalizedModule.mk n 1) := by
      rw [hsmul, map_smul]
    _ = (Localization.mk 1 (s * t)) • LocalizedModule.mk (m ⊗ₜ[S] n) 1 := by
      rw [Localization.mk_mul, one_mul, hnum]
    _ = LocalizedModule.mk (m ⊗ₜ[S] n) (s * t) := by
      rw [LocalizedModule.mk_smul_mk]
      simp

/-- The fraction formula for the bridge over the localized ring. -/
theorem tensorLocalizationEquivOverLocalization_mk (P : Submonoid S)
    (m : M) (s : P) (n : N) (t : P) :
      tensorLocalizationEquivOverLocalization (S := S) (M := M) (N := N) P
      (LocalizedModule.mk m s ⊗ₜ[S] LocalizedModule.mk n t) =
      LocalizedModule.mk (m ⊗ₜ[S] n) (s * t) := by
  simpa [tensorLocalizationEquivOverLocalization] using
    (tensorLocalizationEquiv_mk (S := S) (M := M) (N := N) P m s n t)

/-! ### The decomposition of the tensor grading -/

/-- The `ℤ`-tensor product of a homogeneous piece of `M` and one of `N`. -/
abbrev tensorGradingPair (i j : ℤ) := (𝒨 i) ⊗[ℤ] (𝒩 j)

/-- The homogeneous pure tensors of degrees `i` and `j` land in degree `i + j`. -/
def tensorGradingPairMap (i j : ℤ) :
    tensorGradingPair 𝒨 𝒩 i j →+ tensorGrading (S := S) 𝒨 𝒩 (i + j) := by
  let f : (𝒨 i) →+ (𝒩 j) →+ tensorGrading (S := S) 𝒨 𝒩 (i + j) := {
    toFun := fun m => {
      toFun := fun n => ⟨(m : M) ⊗ₜ[S] (n : N),
        AddSubgroup.subset_closure ⟨i, j, rfl, m, m.property, n, n.property, rfl⟩⟩
      map_zero' := by apply Subtype.ext; simp
      map_add' := by intro a b; apply Subtype.ext; simp [TensorProduct.tmul_add] }
    map_zero' := by
      ext n
      change (0 : M) ⊗ₜ[S] (n : N) = 0
      simp
    map_add' := by
      intro a b
      ext n
      change ((a + b : 𝒨 i) : M) ⊗ₜ[S] (n : N) =
        ((a : 𝒨 i) : M) ⊗ₜ[S] (n : N) + ((b : 𝒨 i) : M) ⊗ₜ[S] (n : N)
      simp [TensorProduct.add_tmul] }
  exact TensorProduct.liftAddHom f (by
    intro r m n
    apply Subtype.ext
    change ((r • (m : M)) ⊗ₜ[S] (n : N)) = ((m : M) ⊗ₜ[S] (r • (n : N)))
    simp [TensorProduct.smul_tmul'])

/-- Collapse the bigrading of the tensor product along the sum of the degrees. -/
def tensorGradingPairCollapse :
    (⨁ p : ℤ × ℤ, tensorGradingPair 𝒨 𝒩 p.1 p.2) →+
      ⨁ k : ℤ, tensorGrading (S := S) 𝒨 𝒩 k :=
  DirectSum.toAddMonoid fun p =>
    (DirectSum.of (fun k : ℤ => tensorGrading (S := S) 𝒨 𝒩 k) (p.1 + p.2)).comp
      (tensorGradingPairMap 𝒨 𝒩 p.1 p.2)

/-- The candidate decomposition of a pure tensor: decompose both factors and collapse. -/
def tensorGradingPairValue (m : M) (n : N) :
    ⨁ k : ℤ, tensorGrading (S := S) 𝒨 𝒩 k :=
  tensorGradingPairCollapse 𝒨 𝒩 <|
    letI : Module ℤ M := AddCommGroup.toIntModule M
    letI : Module ℤ N := AddCommGroup.toIntModule N
    letI : Module ℤ (⨁ i : ℤ, 𝒨 i) := AddCommGroup.toIntModule _
    letI : Module ℤ (⨁ i : ℤ, 𝒩 i) := AddCommGroup.toIntModule _
    TensorProduct.directSum ℤ ℤ (fun i => 𝒨 i) (fun j => 𝒩 j)
      (((DirectSum.decomposeAddEquiv 𝒨).toIntLinearEquiv
        (modM := inferInstance) (modM₂ := inferInstance) m) ⊗ₜ[ℤ]
        ((DirectSum.decomposeAddEquiv 𝒩).toIntLinearEquiv
          (modM := inferInstance) (modM₂ := inferInstance) n))

/-- The candidate decomposition of a pure tensor, as a biadditive map. -/
def tensorGradingPairBilin : M →+ N →+
    (⨁ k : ℤ, tensorGrading (S := S) 𝒨 𝒩 k) where
  toFun m := {
    toFun := tensorGradingPairValue (S := S) 𝒨 𝒩 m
    map_zero' := by
      simp only [tensorGradingPairValue, LinearEquiv.map_zero, TensorProduct.tmul_zero,
        AddMonoidHom.map_zero]
    map_add' := by
      intro n n'
      simp only [tensorGradingPairValue, LinearEquiv.map_add, TensorProduct.tmul_add,
        AddMonoidHom.map_add] }
  map_zero' := by
    ext n
    simp only [tensorGradingPairValue, LinearEquiv.map_zero, TensorProduct.zero_tmul,
      AddMonoidHom.map_zero, AddMonoidHom.coe_mk, ZeroHom.coe_mk, AddMonoidHom.zero_apply]
  map_add' := by
    intro m m'
    ext n
    simp only [tensorGradingPairValue, LinearEquiv.map_add, TensorProduct.add_tmul,
      AddMonoidHom.map_add, AddMonoidHom.coe_mk, ZeroHom.coe_mk, AddMonoidHom.add_apply]

/-- On a pure tensor of homogeneous elements the candidate decomposition is concentrated in
the degree given by the sum. -/
theorem tensorGradingPairValue_homogeneous (i j : ℤ) (m : 𝒨 i) (n : 𝒩 j) :
    tensorGradingPairValue (S := S) 𝒨 𝒩 (m : M) (n : N) =
    DirectSum.of (fun k : ℤ => tensorGrading (S := S) 𝒨 𝒩 k) (i + j)
        ⟨(m : M) ⊗ₜ[S] (n : N),
          AddSubgroup.subset_closure ⟨i, j, rfl, m, m.property, n, n.property, rfl⟩⟩ := by
  simp only [tensorGradingPairValue, AddEquiv.coe_toIntLinearEquiv]
  let _ : Module ℤ (𝒨 i) := AddCommGroup.toIntModule _
  let _ : Module ℤ (𝒩 j) := AddCommGroup.toIntModule _
  have hm : (DirectSum.decomposeAddEquiv 𝒨) (m : M) =
      DirectSum.of (fun i : ℤ => 𝒨 i) i m :=
    DirectSum.decompose_coe 𝒨 m
  have hn : (DirectSum.decomposeAddEquiv 𝒩) (n : N) =
      DirectSum.of (fun j : ℤ => 𝒩 j) j n :=
    DirectSum.decompose_coe 𝒩 n
  rw [hm, hn]
  change tensorGradingPairCollapse (S := S) 𝒨 𝒩
    (TensorProduct.directSum ℤ ℤ (fun i => 𝒨 i) (fun j => 𝒩 j)
      (DirectSum.lof ℤ ℤ (fun i => 𝒨 i) i m ⊗ₜ[ℤ]
        DirectSum.lof ℤ ℤ (fun j => 𝒩 j) j n)) = _
  rw [TensorProduct.directSum_lof_tmul_lof]
  change tensorGradingPairCollapse (S := S) 𝒨 𝒩
    (DirectSum.of (fun p : ℤ × ℤ => (𝒨 p.1) ⊗[ℤ] (𝒩 p.2)) (i, j) (m ⊗ₜ[ℤ] n)) = _
  simp only [tensorGradingPairCollapse, DirectSum.toAddMonoid_of, AddMonoidHom.comp_apply]
  change (DirectSum.of (fun k : ℤ => tensorGrading (S := S) 𝒨 𝒩 k) (i + j))
      (tensorGradingPairMap 𝒨 𝒩 i j (m ⊗ₜ[ℤ] n)) = _
  rw [tensorGradingPairMap, TensorProduct.liftAddHom_tmul]
  rfl

omit [AddSubgroupClass σ S] [GradedRing 𝒮] in
/-- The candidate decomposition is balanced over a homogeneous scalar, on homogeneous
elements. -/
theorem tensorGradingPairValue_balanced_homogeneous
    (d : ℕ) (i j : ℤ) (s : 𝒮 d) (m : 𝒨 i) (n : 𝒩 j) :
    tensorGradingPairValue (S := S) 𝒨 𝒩 ((s : S) • (m : M)) (n : N) =
      tensorGradingPairValue (S := S) 𝒨 𝒩 (m : M) ((s : S) • (n : N)) := by
  have hsm : (s : S) • (m : M) ∈ 𝒨 ((d : ℤ) + i) :=
    SetLike.GradedSMul.smul_mem s.property m.property
  have hsn : (s : S) • (n : N) ∈ 𝒩 ((d : ℤ) + j) :=
    SetLike.GradedSMul.smul_mem s.property n.property
  rw [tensorGradingPairValue_homogeneous (S := S) 𝒨 𝒩 ((d : ℤ) + i) j
      ⟨(s : S) • (m : M), hsm⟩ n,
    tensorGradingPairValue_homogeneous (S := S) 𝒨 𝒩 i ((d : ℤ) + j)
      m ⟨(s : S) • (n : N), hsn⟩]
  apply DirectSum.of_eq_of_gradedMonoid_eq
  have hdeg : ((d : ℤ) + i) + j = i + ((d : ℤ) + j) := by omega
  refine Sigma.ext hdeg ?_
  have hp : ∀ z : M ⊗[S] N,
      z ∈ tensorGrading (S := S) 𝒨 𝒩 (((d : ℤ) + i) + j) ↔
        z ∈ tensorGrading (S := S) 𝒨 𝒩 (i + ((d : ℤ) + j)) := by
    intro z
    rw [hdeg]
  apply (Subtype.heq_iff_coe_eq hp).2
  change ((s : S) • (m : M)) ⊗ₜ[S] (n : N) = (m : M) ⊗ₜ[S] ((s : S) • (n : N))
  rw [TensorProduct.smul_tmul]

/-- The candidate decomposition is `S`-balanced. -/
theorem tensorGradingPairValue_balanced (𝒮 : ℕ → σ) [GradedRing 𝒮]
    [SetLike.GradedSMul 𝒮 𝒨] [SetLike.GradedSMul 𝒮 𝒩]
    (r : S) (m : M) (n : N) :
    tensorGradingPairBilin (S := S) 𝒨 𝒩 (r • m) n =
      tensorGradingPairBilin (S := S) 𝒨 𝒩 m (r • n) := by
  induction r using DirectSum.Decomposition.inductionOn (ℳ := 𝒮) with
  | zero => simp only [zero_smul, map_zero, AddMonoidHom.zero_apply]
  | homogeneous r =>
    induction m using DirectSum.Decomposition.inductionOn (ℳ := 𝒨) with
    | zero => simp only [smul_zero, map_zero, AddMonoidHom.zero_apply]
    | homogeneous m =>
      induction n using DirectSum.Decomposition.inductionOn (ℳ := 𝒩) with
      | zero => simp only [smul_zero, map_zero]
      | homogeneous n =>
        exact tensorGradingPairValue_balanced_homogeneous (S := S) 𝒮 𝒨 𝒩 _ _ _ r m n
      | add n n' hn hn' =>
        rw [smul_add]
        simp only [map_add, hn, hn']
    | add m m' hm hm' =>
      rw [smul_add, map_add, map_add]
      simp only [AddMonoidHom.add_apply, hm, hm']
  | add r r' hr hr' =>
    rw [add_smul, map_add, add_smul, map_add]
    simp only [AddMonoidHom.add_apply, hr, hr']

/-- The candidate decomposition of a pure tensor recovers that pure tensor. -/
theorem tensorGradingPairValue_coe (m : M) (n : N) :
    DirectSum.coeAddMonoidHom (tensorGrading (S := S) 𝒨 𝒩)
        (tensorGradingPairValue (S := S) 𝒨 𝒩 m n) = m ⊗ₜ[S] n := by
  change DirectSum.coeAddMonoidHom (tensorGrading (S := S) 𝒨 𝒩)
      (tensorGradingPairBilin (S := S) 𝒨 𝒩 m n) = _
  induction m using DirectSum.Decomposition.inductionOn (ℳ := 𝒨) with
  | zero => simp
  | homogeneous m =>
    induction n using DirectSum.Decomposition.inductionOn (ℳ := 𝒩) with
    | zero => simp
    | homogeneous n =>
      change DirectSum.coeAddMonoidHom (tensorGrading (S := S) 𝒨 𝒩)
        (tensorGradingPairValue (S := S) 𝒨 𝒩 (m : M) (n : N)) = _
      rw [tensorGradingPairValue_homogeneous (S := S) 𝒨 𝒩 _ _ m n]
      simp
    | add n n' hn hn' =>
      simp only [AddMonoidHom.map_add, hn, hn', TensorProduct.tmul_add]
  | add m m' hm hm' =>
    simp only [AddMonoidHom.map_add, AddMonoidHom.add_apply, hm, hm',
      TensorProduct.add_tmul]

/-- The candidate decomposition map of the tensor product. -/
def tensorGradingDecomposeAddHom (𝒮' : ℕ → σ) [GradedRing 𝒮']
    [SetLike.GradedSMul 𝒮' 𝒨] [SetLike.GradedSMul 𝒮' 𝒩] : M ⊗[S] N →+
    ⨁ k : ℤ, tensorGrading (S := S) 𝒨 𝒩 k :=
  TensorProduct.liftAddHom (tensorGradingPairBilin (S := S) 𝒨 𝒩)
    (tensorGradingPairValue_balanced (S := S) (𝒨 := 𝒨) (𝒩 := 𝒩) (𝒮 := 𝒮'))

/-- The candidate decomposition map on a pure tensor. -/
theorem tensorGradingDecomposeAddHom_tmul (𝒮' : ℕ → σ) [GradedRing 𝒮']
    [SetLike.GradedSMul 𝒮' 𝒨] [SetLike.GradedSMul 𝒮' 𝒩] (m : M) (n : N) :
    tensorGradingDecomposeAddHom 𝒨 𝒩 𝒮' (m ⊗ₜ[S] n) =
      tensorGradingPairBilin (S := S) 𝒨 𝒩 m n :=
  TensorProduct.liftAddHom_tmul (tensorGradingPairBilin (S := S) 𝒨 𝒩)
    (tensorGradingPairValue_balanced (S := S) (𝒨 := 𝒨) (𝒩 := 𝒩) (𝒮 := 𝒮')) m n

/-- The candidate decomposition map is the identity on a homogeneous element. -/
theorem tensorGradingDecomposeAddHom_of_mem (𝒮' : ℕ → σ) [GradedRing 𝒮']
    [SetLike.GradedSMul 𝒮' 𝒨] [SetLike.GradedSMul 𝒮' 𝒩] (k : ℤ)
    (z : M ⊗[S] N) (hz : z ∈ tensorGrading (S := S) 𝒨 𝒩 k) :
    tensorGradingDecomposeAddHom 𝒨 𝒩 𝒮' z =
      DirectSum.of (fun j : ℤ => tensorGrading (S := S) 𝒨 𝒩 j) k ⟨z, hz⟩ := by
  induction hz using AddSubgroup.closure_induction with
  | mem z hz =>
    obtain ⟨i, j, hij, m, hm, n, hn, rfl⟩ := hz
    subst k
    rw [tensorGradingDecomposeAddHom_tmul (S := S) 𝒨 𝒩 𝒮' m n]
    change tensorGradingPairValue (S := S) 𝒨 𝒩 m n = _
    rw [tensorGradingPairValue_homogeneous (S := S) 𝒨 𝒩 i j ⟨m, hm⟩ ⟨n, hn⟩]
  | zero =>
    have hz : (⟨0, (tensorGrading (S := S) 𝒨 𝒩 k).zero_mem⟩ :
        tensorGrading (S := S) 𝒨 𝒩 k) = 0 := by
      apply Subtype.ext
      rfl
    simp [hz]
  | add x y hx hy ihx ihy =>
    rw [map_add, ihx, ihy]
    have hsub : (⟨x + y, (tensorGrading (S := S) 𝒨 𝒩 k).add_mem hx hy⟩ :
        tensorGrading (S := S) 𝒨 𝒩 k) =
        (⟨x, hx⟩ : tensorGrading (S := S) 𝒨 𝒩 k) + ⟨y, hy⟩ := by
      apply Subtype.ext
      rfl
    rw [hsub]
    simp
  | neg x hx ih =>
    rw [map_neg, ih]
    have hsub : (⟨-x, (tensorGrading (S := S) 𝒨 𝒩 k).neg_mem hx⟩ :
        tensorGrading (S := S) 𝒨 𝒩 k) =
        - (⟨x, hx⟩ : tensorGrading (S := S) 𝒨 𝒩 k) := by
      apply Subtype.ext
      rfl
    rw [hsub]
    simp

/-- The homogeneous pieces of the tensor grading give an additive decomposition of
`M ⊗[S] N`. -/
@[instance_reducible]
def tensorGrading_decomposition
    (𝒮 : ℕ → σ) [GradedRing 𝒮]
    (𝒨 : ℤ → τ) [Decomposition 𝒨] [SetLike.GradedSMul 𝒮 𝒨]
    (𝒩 : ℤ → υ) [Decomposition 𝒩] [SetLike.GradedSMul 𝒮 𝒩] :
    Decomposition (tensorGrading (S := S) 𝒨 𝒩) := by
  let d := tensorGradingDecomposeAddHom (S := S) 𝒨 𝒩 𝒮
  refine DirectSum.Decomposition.ofAddHom _ d ?_ ?_
  · refine AddMonoidHom.ext fun z ↦ ?_
    induction z using TensorProduct.inductionOn with
    | add x y hx hy =>
      have hx' : DirectSum.coeAddMonoidHom (tensorGrading (S := S) 𝒨 𝒩) (d x) = x := by
        simpa only [AddMonoidHom.comp_apply, AddMonoidHom.id_apply] using hx
      have hy' : DirectSum.coeAddMonoidHom (tensorGrading (S := S) 𝒨 𝒩) (d y) = y := by
        simpa only [AddMonoidHom.comp_apply, AddMonoidHom.id_apply] using hy
      change DirectSum.coeAddMonoidHom (tensorGrading (S := S) 𝒨 𝒩) (d (x + y)) = _
      rw [map_add, map_add, hx', hy']
      simp
    | tmul m n =>
      change DirectSum.coeAddMonoidHom (tensorGrading (S := S) 𝒨 𝒩) (d (m ⊗ₜ[S] n)) = _
      rw [tensorGradingDecomposeAddHom_tmul (S := S) 𝒨 𝒩 𝒮 m n]
      exact tensorGradingPairValue_coe (S := S) 𝒨 𝒩 m n
  · refine DirectSum.addHom_ext fun k x ↦ ?_
    change d ((DirectSum.coeAddMonoidHom (tensorGrading (S := S) 𝒨 𝒩)
      (DirectSum.of (fun j : ℤ => tensorGrading (S := S) 𝒨 𝒩 j) k x))) = _
    rw [DirectSum.coeAddMonoidHom_of]
    exact tensorGradingDecomposeAddHom_of_mem (S := S) 𝒨 𝒩 𝒮 k x x.property

