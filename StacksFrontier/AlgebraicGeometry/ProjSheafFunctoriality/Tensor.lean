/-- The pointwise tensor of two sections of the associated sheaves, as a section of the
associated sheaf of the graded tensor product. -/
def tensorModuleSectionsPair
    (U : Opens (ProjectiveSpectrum.top 𝒮))
    (a : ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒨 U)
    (b : ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒩 U) :
    (letI := tensorGrading_gradedSMul (S := S) 𝒮 𝒨 𝒩
     ProjectiveSpectrum.Proj.moduleSections 𝒮 (tensorGrading (S := S) 𝒨 𝒩) U) := by
  refine ⟨fun x => tensorLocalizationEquivOverLocalization
      (S := S) (M := M) (N := N) x.1.asHomogeneousIdeal.toIdeal.primeCompl
      (a.1 x ⊗ₜ[S] b.1 x), ?_⟩
  intro x
  obtain ⟨V, hxV, iV, n, m, s, hm, hs, hn, ha⟩ := a.2 x
  obtain ⟨W, hxW, iW, k, l, t, hl, ht, hp, hb⟩ := b.2 x
  refine ⟨V ⊓ W, ⟨hxV, hxW⟩, Opens.infLELeft _ _ ≫ iV, n + k,
    m ⊗ₜ[S] l, s * t, ?_, SetLike.mul_mem_graded hs ht,
    fun y => y.1.asHomogeneousIdeal.toIdeal.primeCompl.mul_mem
      (hn ⟨y.1, y.2.1⟩) (hp ⟨y.1, y.2.2⟩), ?_⟩
  · apply AddSubgroup.subset_closure
    refine ⟨(n : ℤ), (k : ℤ), ?_, m, hm, l, hl, rfl⟩
    simp
  · intro y
    change tensorLocalizationEquivOverLocalization
        (S := S) (M := M) (N := N)
        y.1.asHomogeneousIdeal.toIdeal.primeCompl
        (a.1 (iV ⟨y.1, y.2.1⟩) ⊗ₜ[S] b.1 (iW ⟨y.1, y.2.2⟩)) = _
    have h1 := ha ⟨y.1, y.2.1⟩
    have h2 := hb ⟨y.1, y.2.2⟩
    change a.1 (iV ⟨y.1, y.2.1⟩) = _ at h1
    change b.1 (iW ⟨y.1, y.2.2⟩) = _ at h2
    rw [h1, h2]
    exact tensorLocalizationEquivOverLocalization_mk
      (S := S) (M := M) (N := N) _ m ⟨s, hn ⟨y.1, y.2.1⟩⟩ l ⟨t, hp ⟨y.1, y.2.2⟩⟩

/-- The pointwise tensor of sections, as a bilinear map over the structure sheaf. -/
def tensorModuleSectionsBilinear (U : Opens (ProjectiveSpectrum.top 𝒮)) :
    (ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒨 U) →ₗ[
      (ProjectiveSpectrum.Proj.structureSheaf 𝒮).obj.obj (op U)]
      (ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒩 U →ₗ[
        (ProjectiveSpectrum.Proj.structureSheaf 𝒮).obj.obj (op U)]
        (letI := tensorGrading_gradedSMul (S := S) 𝒮 𝒨 𝒩
         ProjectiveSpectrum.Proj.moduleSections 𝒮 (tensorGrading (S := S) 𝒨 𝒩) U)) := by
  let R := (ProjectiveSpectrum.Proj.structureSheaf 𝒮).obj.obj (op U)
  exact LinearMap.mk₂ R (tensorModuleSectionsPair (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨) (𝒩 := 𝒩) U)
    (by intro a a' b; apply Subtype.ext; funext x; simp [tensorModuleSectionsPair,
      TensorProduct.add_tmul])
    (by
      intro r a b
      apply Subtype.ext
      funext x
      change tensorLocalizationEquivOverLocalization
          (S := S) (M := M) (N := N) x.1.asHomogeneousIdeal.toIdeal.primeCompl
          ((HomogeneousLocalization.val (r.1 x) • a.1 x) ⊗ₜ[S] b.1 x) =
        HomogeneousLocalization.val (r.1 x) •
          tensorLocalizationEquivOverLocalization
            (S := S) (M := M) (N := N) x.1.asHomogeneousIdeal.toIdeal.primeCompl
            (a.1 x ⊗ₜ[S] b.1 x)
      rw [TensorProduct.smul_tmul, TensorProduct.tmul_smul, map_smul])
    (by intro a b b'; apply Subtype.ext; funext x; simp [tensorModuleSectionsPair,
      TensorProduct.tmul_add])
    (by
      intro r a b
      apply Subtype.ext
      funext x
      change tensorLocalizationEquivOverLocalization
          (S := S) (M := M) (N := N) x.1.asHomogeneousIdeal.toIdeal.primeCompl
          (a.1 x ⊗ₜ[S] (HomogeneousLocalization.val (r.1 x) • b.1 x)) =
        HomogeneousLocalization.val (r.1 x) •
          tensorLocalizationEquivOverLocalization
            (S := S) (M := M) (N := N) x.1.asHomogeneousIdeal.toIdeal.primeCompl
            (a.1 x ⊗ₜ[S] b.1 x)
      rw [TensorProduct.tmul_smul, map_smul])

/-- The pointwise tensor of sections, as an additive map out of the tensor product of the
section modules. -/
def tensorModuleSectionsAddHom (U : Opens (ProjectiveSpectrum.top 𝒮)) :
    TensorProduct ((ProjectiveSpectrum.Proj.structureSheaf 𝒮).obj.obj (op U))
      (ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒨 U)
      (ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒩 U) →+
      (letI := tensorGrading_gradedSMul (S := S) 𝒮 𝒨 𝒩
       ProjectiveSpectrum.Proj.moduleSections 𝒮 (tensorGrading (S := S) 𝒨 𝒩) U) :=
  TensorProduct.liftAddHom {
    toFun := fun a => (tensorModuleSectionsBilinear
      (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨) (𝒩 := 𝒩) U a).toAddMonoidHom
    map_zero' := by ext b; simp
    map_add' := by intro a a'; ext b; simp }
    (by
      intro r a b
      calc
        (tensorModuleSectionsBilinear (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨)
          (𝒩 := 𝒩) U) (r • a) b = r • (tensorModuleSectionsBilinear
            (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨) (𝒩 := 𝒩) U a b) :=
              congrArg (fun f => f b) ((tensorModuleSectionsBilinear
                (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨) (𝒩 := 𝒩) U).map_smul r a)
        _ = (tensorModuleSectionsBilinear (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨)
          (𝒩 := 𝒩) U) a (r • b) :=
              ((tensorModuleSectionsBilinear (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨)
                (𝒩 := 𝒩) U a).map_smul r b).symm)

