/-- The tensor grading is compatible with the graded scalar action of `𝒮`. -/
theorem tensorGrading_gradedSMul :
    SetLike.GradedSMul 𝒮 (tensorGrading (S := S) 𝒨 𝒩) := by
  refine ⟨?_⟩
  intro i j a b ha hb
  induction hb using AddSubgroup.closure_induction with
  | mem z hz =>
    obtain ⟨p, q, hpq, m, hm, n, hn, rfl⟩ := hz
    rw [TensorProduct.smul_tmul']
    exact Stacks.GradedModule.tmul_mem_tensorGrading 𝒨 𝒩
      ((add_assoc (i : ℤ) p q).trans (congrArg _ hpq)) (SetLike.GradedSMul.smul_mem ha hm) hn
  | zero => simp
  | add x y hx hy ihx ihy =>
    simpa only [smul_add] using (tensorGrading (S := S) 𝒨 𝒩 (i +ᵥ j)).add_mem ihx ihy
  | neg x hx ih =>
    simpa only [smul_neg] using (tensorGrading (S := S) 𝒨 𝒩 (i +ᵥ j)).neg_mem ih

