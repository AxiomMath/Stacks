        (tensorGrading (S := S) 𝒨 𝒩)).val) := by
  letI := tensorGrading_gradedSMul (S := S) 𝒮 𝒨 𝒩
  exact PresheafOfModules.homMk (tensorModuleSectionsNat (S := S) (𝒮 := 𝒮)
      (𝒨 := 𝒨) (𝒩 := 𝒩)) (by
    intro U
    let R := (ProjectiveSpectrum.Proj.structureSheaf 𝒮).obj.obj U
    let _ : Module R
        (ProjectiveSpectrum.Proj.moduleSections 𝒮 (tensorGrading (S := S) 𝒨 𝒩) U.unop) :=
      ProjectiveSpectrum.Proj.modulePresheafModule 𝒮 (tensorGrading (S := S) 𝒨 𝒩) U
    let _ : Module ((Stacks.SheafOfModules.TensorStalkRingedSpace.O
          (_root_.AlgebraicGeometry.Proj 𝒮).toRingedSpace).obj U)
        (ProjectiveSpectrum.Proj.moduleSections 𝒮 (tensorGrading (S := S) 𝒨 𝒩) U.unop) :=
      Module.compHom _ (RingHom.id R)
    let _ : Module R (ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒨 U.unop) :=
      ProjectiveSpectrum.Proj.modulePresheafModule 𝒮 𝒨 U
    let _ : Module ((Stacks.SheafOfModules.TensorStalkRingedSpace.O
          (_root_.AlgebraicGeometry.Proj 𝒮).toRingedSpace).obj U)
        (ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒨 U.unop) :=
      Module.compHom _ (RingHom.id R)
    let _ : Module R (ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒩 U.unop) :=
      ProjectiveSpectrum.Proj.modulePresheafModule 𝒮 𝒩 U
    let _ : Module ((Stacks.SheafOfModules.TensorStalkRingedSpace.O
          (_root_.AlgebraicGeometry.Proj 𝒮).toRingedSpace).obj U)
        (ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒩 U.unop) :=
      Module.compHom _ (RingHom.id R)
    let _ : Module R
        (TensorProduct ((ProjectiveSpectrum.Proj.structureSheaf 𝒮).obj.obj U)
          (ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒨 U.unop)
          (ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒩 U.unop)) := inferInstance
    intro r z
    change tensorModuleSectionsAddHom (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨)
        (𝒩 := 𝒩) U.unop (r • z) = r • tensorModuleSectionsAddHom
        (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨) (𝒩 := 𝒩) U.unop z
    exact (tensorModuleSectionsLinearMap (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨)
      (𝒩 := 𝒩) U.unop).map_smul r z)

