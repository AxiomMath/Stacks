  TensorProduct.liftAddHom_tmul _ _ _ _

/-- The pointwise tensor of sections, as a linear map out of the tensor product of the
section modules. -/
def tensorModuleSectionsLinearMap (U : Opens (ProjectiveSpectrum.top 𝒮)) :
    TensorProduct ((ProjectiveSpectrum.Proj.structureSheaf 𝒮).obj.obj (op U))
      (ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒨 U)
      (ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒩 U) →ₗ[
        (ProjectiveSpectrum.Proj.structureSheaf 𝒮).obj.obj (op U)]
      (letI := tensorGrading_gradedSMul (S := S) 𝒮 𝒨 𝒩
       ProjectiveSpectrum.Proj.moduleSections 𝒮 (tensorGrading (S := S) 𝒨 𝒩) U) :=
  TensorProduct.lift (tensorModuleSectionsBilinear
    (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨) (𝒩 := 𝒩) U)

/-- The pointwise tensor of sections, as a morphism of the underlying presheaves of abelian
groups. -/
def tensorModuleSectionsNat :
    (PresheafOfModules.tensorObj
      (O := (_root_.AlgebraicGeometry.Proj 𝒮).toRingedSpace.presheaf)
        (ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒨).val
        (ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒩).val).presheaf ⟶
      (ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮
        (tensorGrading (S := S) 𝒨 𝒩)).val.presheaf where
  app U := AddCommGrpCat.ofHom (tensorModuleSectionsAddHom
    (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨) (𝒩 := 𝒩) U.unop)
  naturality U V f := by
    apply AddCommGrpCat.hom_ext
    ext z
    induction z using TensorProduct.inductionOn with
    | add x y hx hy =>
      refine (map_add _ x y).trans (Eq.trans ?_ (map_add _ x y).symm)
      exact congrArg₂ (· + ·) hx hy
    | tmul a b =>
      change tensorModuleSectionsAddHom (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨) (𝒩 := 𝒩)
          V.unop ((PresheafOfModules.tensorObj
            (O := (_root_.AlgebraicGeometry.Proj 𝒮).toRingedSpace.presheaf)
            (ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒨).val
            (ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒩).val).restrictₛₗ f (a ⊗ₜ b)) = _
      refine (congrArg
        (tensorModuleSectionsAddHom (S := S) (𝒮 := 𝒮) (𝒨 := 𝒨) (𝒩 := 𝒩) V.unop)
        (PresheafOfModules.tensorObj_restrictₛₗ_tmul
          (O := (_root_.AlgebraicGeometry.Proj 𝒮).toRingedSpace.presheaf)
          (F := (ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒨).val)
          (G := (ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒩).val) f a b)).trans ?_
      exact Subtype.ext (funext fun point => rfl)

/-- The pointwise tensor of sections, as a morphism of presheaves of modules out of the
tensor-product presheaf. -/
def tensorModuleSectionsPresheafMap :
    (PresheafOfModules.tensorObj (O := ((_root_.AlgebraicGeometry.Proj
      𝒮).toRingedSpace).presheaf) ((ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒨).val)
