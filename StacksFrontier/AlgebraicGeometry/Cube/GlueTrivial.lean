/-!
# Gluing normalized trivializations over `P ×_k Z`

Let `P` be a proper, geometrically integral scheme over a field `k`, let `Z` be a scheme over
`k`, and let `L` be a sheaf of modules on `P ×_k Z`, trivial over the inverse image of each
member of an open covering of `Z`, whose pullback along a section `δ : Z → P ×_k Z` of the
second projection is trivial.  Then `L` is trivial.  This is the gluing step of the proof of the
theorem of the cube (Stacks Tag 0BF4).

## Main results

* `AlgebraicGeometry.Cube.isIso_snd_app_of_isAffineOpen`: `Γ(W, 𝒪_Z) → Γ(P ×_k W, 𝒪)` is an
  isomorphism for every affine open `W` of `Z`.
* `AlgebraicGeometry.Cube.isUnit_ev`: the value along `δ` of a section trivializing `L` is a
  unit.
* `AlgebraicGeometry.Cube.nonempty_iso_unit_of_locally`: **the gluing statement.**

## Implementation notes

Trivializations are handled as *trivializing sections*, in the shape of
`StacksFrontier.AlgebraicGeometry.PicardGroup.Descent`: a section `a` of `L` over `T` such that
`c ↦ c • a|_V` is bijective for every open `V ≤ T`.  The value of a local section along `δ` is
its image under the unit of `δ^* ⊣ δ_*` followed by the given trivialization `θ` of `δ^* L`
(`AlgebraicGeometry.Cube.ev`); it is semilinear over `δ^♯` and natural.  That the value of a
trivializing section is a unit uses that `δ^* L` is locally generated by pulled-back sections
(`Stacks.PullbackUnitGenerators.exists_mem_span`), so no comparison of pullbacks along
different maps is needed.

Each local trivialization is first restricted to an affine open `W` of `Z` and then divided by
its value along `δ`.  Two such normalized trivializations differ, over `P ×_k W` for `W` affine,
by a unit of `Γ(P ×_k W, 𝒪) = Γ(W, 𝒪)` whose value along `δ` is `1`, hence by `1`; equality on an
arbitrary overlap follows by covering it with affine opens.  The normalized trivializations then
glue, and multiplication by the glued section is bijective on every open below a member of the
covering.  Invertibility of `L` is never used.

## References

* [Stacks Project, Tag 0BF4](https://stacks.math.columbia.edu/tag/0BF4)
* [Stacks Project, Tag 0BUG](https://stacks.math.columbia.edu/tag/0BUG)
* [Stacks Project, Tag 02KH](https://stacks.math.columbia.edu/tag/02KH)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace AlgebraicGeometry.Cube

/-- **Regular functions on `P ×_k W` are the regular functions on `W`**, for `P` proper and
geometrically integral over a field `k` and `W` an affine open of a scheme `Z` over `k`.  Global
sections commute with the flat base change `k → Γ(W)` (Stacks Tag 02KH in degree `0`), and those
of `P` are the constants (Stacks Tag 0BUG, part (8)). -/
@[sga "3 VIB 12.2" "special case"]
theorem isIso_snd_app_of_isAffineOpen {k : Type u} [Field k] {P Z : Scheme.{u}}
    (π : P ⟶ Spec (.of k)) [IsProper π] [GeometricallyIntegral π] (h : Z ⟶ Spec (.of k))
    {W : Z.Opens} (hW : IsAffineOpen W) :
    IsIso ((pullback.snd π h).app W) := by
  have H := IsPullback.of_hasPullback π h
  have : CompactSpace P := QuasiCompact.compactSpace_of_compactSpace π
  have : QuasiSeparatedSpace P := quasiSeparatedSpace_of_quasiSeparated π
  have hiso := isIso_pushoutSection_of_isQuasiSeparated_of_flat_right H
    (US := ⊤) (UT := W) (UX := ⊤) (UY := (pullback.snd π h) ⁻¹ᵁ W) (by simp) (by simp)
    (by simp) (isAffineOpen_top _) hW (by simpa using isCompact_univ) isQuasiSeparated_univ
  replace hiso := (isIso_pushoutSection_iff H _ _ _).mp hiso
  have : IsIso (π.appLE ⊤ ⊤ (by simp)) := by
    have := isIso_globalSections_of_geometricallyIntegral k π
    have : IsIso π.appTop := IsIso.of_isIso_comp_left (Scheme.ΓSpecIso (.of k)).inv π.appTop
    have h0 : IsIso (π.appLE ⊤ (π ⁻¹ᵁ ⊤) le_rfl) := by rwa [Scheme.Hom.appLE_eq_app]
    exact (Scheme.Hom.appLE_congr π le_rfl rfl (Scheme.Hom.preimage_top π) (IsIso ·)).mp h0
  rw [← Scheme.Hom.appLE_eq_app]
  exact hiso.isIso_inr_of_isIso

section Eval

open Stacks.SchemeCohomology RingedSpaceModuleAdjunction

variable {X Y : Scheme.{u}} (L : SheafOfModules.{u} (structureSheafRing (ringedSpace X)))
  (δ : Y ⟶ X) (θ : (modulePullback (hom δ)).obj L ≅
    SheafOfModules.unit (structureSheafRing (ringedSpace Y)))

/-- Restriction of local sections of `L`, with its type pinned. -/
noncomputable def resL {V V' : X.Opens} (i : V' ≤ V) (m : L.val.obj (op V)) :
    L.val.obj (op V') :=
  L.val.map (homOfLE i).op m

/-- Evaluation of a local section of `L` along `δ`, read through `θ` as a function. -/
noncomputable def ev (V : X.Opens) (m : L.val.obj (op V)) : Y.presheaf.obj (op (δ ⁻¹ᵁ V)) :=
  θ.hom.val.app (op (δ ⁻¹ᵁ V))
    (Stacks.PullbackUnitGenerators.pullbackUnitSection (Stacks.SchemeCohomology.hom δ) L (op V) m)

/-- Evaluation along `δ` is semilinear over the ring map `δ^♯`. -/
theorem ev_smul (V : X.Opens) (r : X.presheaf.obj (op V)) (m : L.val.obj (op V)) :
    ev L δ θ V (r • m) = δ.app V r * ev L δ θ V m :=
  (congrArg (θ.hom.val.app (op (δ ⁻¹ᵁ V))).hom
    (Stacks.RingedSpace.pullbackUnit_smul (hom δ) L (op V) r m)).trans <|
    (θ.hom.val.app (op (δ ⁻¹ᵁ V))).hom.map_smul (Stacks.RingedSpace.sharp (hom δ) (op V) r)
      (Stacks.RingedSpace.pullbackUnit (hom δ) L (op V) m)

/-- Evaluation along `δ` commutes with restriction. -/
theorem ev_map {V V' : X.Opens} (i : V' ≤ V) (m : L.val.obj (op V)) :
    ev L δ θ V' (resL L i m) =
      Y.presheaf.map (homOfLE (δ.preimage_mono i)).op (ev L δ θ V m) := by
  unfold ev resL
  rw [Stacks.PullbackUnitGenerators.pullbackUnitSection_naturality]
  exact PresheafOfModules.naturality_apply θ.hom.val _ _

/-- Restriction in `Y` along two composable inclusions, as one restriction. -/
theorem map_map {A B C : Y.Opens} (hAB : A ≤ B) (hBC : B ≤ C) (x : Y.presheaf.obj (op C)) :
    Y.presheaf.map (homOfLE hAB).op (Y.presheaf.map (homOfLE hBC).op x) =
      Y.presheaf.map (homOfLE (hAB.trans hBC)).op x := by
  rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
  rfl

/-- Evaluation of a pulled-back unit section of `L` along `δ` sends the span of the
pullback-unit sections over `W ≤ δ⁻¹ V` into the ideal generated by the evaluation of a
trivializing section `a` over `V`. -/
theorem hom_app_mem_span_ev (V : X.Opens) (a : L.val.obj (op V))
    (ha : ∀ (V' : X.Opens) (hV' : V' ≤ V),
      Function.Bijective fun c : X.presheaf.obj (op V') =>
        c • resL L hV' a)
    {W : Y.Opens} (i : W ⟶ δ ⁻¹ᵁ V) (z : ((modulePullback (hom δ)).obj L).val.obj (op W))
    (hz : z ∈ (Stacks.SheafOfModules.spanSubmodule ((modulePullback (hom δ)).obj L)
      (Stacks.PullbackUnitGenerators.unitSections (hom δ) L)).obj (op W)) :
    θ.hom.val.app (op W) z ∈ Ideal.span {Y.presheaf.map i.op (ev L δ θ V a)} := by
  let θW : ((modulePullback (hom δ)).obj L).val.obj (op W) → Y.presheaf.obj (op W) := fun z =>
    θ.hom.val.app (op W) z
  let c := Y.presheaf.map i.op (ev L δ θ V a)
  change θW z ∈ Ideal.span {c}
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
  · rintro _ ⟨Z₀, g, x, ⟨V₁, g', s, rfl⟩, rfl⟩
    have hle : W ≤ δ ⁻¹ᵁ V₁.unop := (g' ≫ g).unop.le
    have hle₀ : W ≤ δ ⁻¹ᵁ (V₁.unop ⊓ V) := fun w hw => ⟨hle hw, i.le hw⟩
    obtain ⟨d, hd⟩ := (ha (V₁.unop ⊓ V) inf_le_right).2
      (resL L (inf_le_left : V₁.unop ⊓ V ≤ V₁.unop) s)
    have hd' : d • resL L (inf_le_right : V₁.unop ⊓ V ≤ V) a =
        resL L (inf_le_left : V₁.unop ⊓ V ≤ V₁.unop) s := hd
    have h1 : θW (((modulePullback (hom δ)).obj L).val.map g
        (((modulePullback (hom δ)).obj L).val.map g'
          (Stacks.PullbackUnitGenerators.pullbackUnitSection (hom δ) L V₁ s))) =
        Y.presheaf.map (homOfLE hle).op (ev L δ θ V₁.unop s) := by
      simp only [θW]
      rw [← ((modulePullback (hom δ)).obj L).val.map_comp_apply]
      exact PresheafOfModules.naturality_apply θ.hom.val _ _
    have h2 : Y.presheaf.map (homOfLE hle).op (ev L δ θ V₁.unop s) =
        Y.presheaf.map (homOfLE hle₀).op (ev L δ θ (V₁.unop ⊓ V)
          (resL L (inf_le_left : V₁.unop ⊓ V ≤ V₁.unop) s)) := by
      rw [ev_map, map_map]
    rw [h1, h2, ← hd', ev_smul, ev_map, map_mul, map_map]
    refine Ideal.mul_mem_left _ _ ?_
    exact Ideal.subset_span rfl
  · exact (show θW 0 = 0 from map_zero _) ▸ Ideal.zero_mem _
  · intro x y _ _ hx hy
    exact (show θW (x + y) = θW x + θW y from map_add _ _ _) ▸ Ideal.add_mem _ hx hy
  · intro r x _ hx
    exact (show θW (r • x) = (show Y.presheaf.obj (op W) from r) * θW x from
      (θ.hom.val.app (op W)).hom.map_smul r x) ▸ Ideal.mul_mem_left _ _ hx

/-- **The evaluation of a trivializing section is a unit.** If `a` trivializes `L` over `V`,
then its evaluation along `δ` through `θ` is a unit over `δ⁻¹ V`.  The pullback `δ^*L` is
locally generated by the pullback-unit sections, which over `V` are multiples of the one of
`a`; so `1 = θ(θ⁻¹ 1)` lies, locally, in the ideal generated by the evaluation of `a`. -/
theorem isUnit_ev (V : X.Opens) (a : L.val.obj (op V))
    (ha : ∀ (V' : X.Opens) (hV' : V' ≤ V),
      Function.Bijective fun c : X.presheaf.obj (op V') =>
        c • resL L hV' a) :
    IsUnit (ev L δ θ V a) := by
  refine (ringedSpace Y).isUnit_of_isUnit_germ (δ ⁻¹ᵁ V) _ fun y hy => ?_
  let one : (SheafOfModules.unit (structureSheafRing (ringedSpace Y))).val.obj
    (op (δ ⁻¹ᵁ V)) := (1 : Y.presheaf.obj (op (δ ⁻¹ᵁ V)))
  let β := θ.inv.val.app (op (δ ⁻¹ᵁ V)) one
  obtain ⟨W, i, hyW, hW⟩ :=
    Stacks.PullbackUnitGenerators.exists_mem_span (hom δ) L (op (δ ⁻¹ᵁ V)) β y hy
  let θW : ((modulePullback (hom δ)).obj L).val.obj (op W) → Y.presheaf.obj (op W) := fun z =>
    θ.hom.val.app (op W) z
  let c := Y.presheaf.map i.op (ev L δ θ V a)
  have hone : θW (((modulePullback (hom δ)).obj L).val.map i.op β) = 1 := by
    have hβ : θ.hom.val.app (op (δ ⁻¹ᵁ V)) β = one :=
      Stacks.SheafOfModules.hom_val_app_inv_val_app θ (op (δ ⁻¹ᵁ V)) _
    simp only [θW]
    rw [PresheafOfModules.naturality_apply, hβ]
    exact map_one (Y.presheaf.map i.op).hom
  have hc : θW (((modulePullback (hom δ)).obj L).val.map i.op β) ∈ Ideal.span {c} :=
    hom_app_mem_span_ev L δ θ V a ha i _ hW
  rw [hone] at hc
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hc
  have := (IsUnit.of_mul_eq_one (a := c) r ((mul_comm _ _).trans hr)).map
    ((ringedSpace Y).presheaf.germ W y hyW).hom
  rwa [show ((ringedSpace Y).presheaf.germ W y hyW).hom c =
    ((ringedSpace Y).presheaf.germ (δ ⁻¹ᵁ V) y hy).hom (ev L δ θ V a) from
    (ringedSpace Y).presheaf.germ_res_apply i y hyW _] at this

/-- Evaluation along `δ` of a restriction of a section with value `1` is `1`. -/
theorem ev_resL_eq_one {V V' : X.Opens} (i : V' ≤ V) {m : L.val.obj (op V)}
    (hm : ev L δ θ V m = 1) : ev L δ θ V' (resL L i m) = 1 := by
  rw [ev_map, hm, map_one]

end Eval

section Section

variable {X Y : Scheme.{u}} (q : X ⟶ Y) (δ : Y ⟶ X) (hδ : δ ≫ q = 𝟙 Y)

include hδ in
/-- The inverse image of `W` under `q` and then under its section `δ` is `W`. -/
theorem preimage_preimage_eq (W : Y.Opens) : δ ⁻¹ᵁ (q ⁻¹ᵁ W) = W := by
  rw [← Scheme.Hom.comp_preimage, hδ]
  rfl

include hδ in
/-- A function on `W` pulled back along `q` and then along its section `δ` is itself. -/
theorem app_comp_app (W : Y.Opens) (v : Y.presheaf.obj (op W)) :
    δ.app (q ⁻¹ᵁ W) (q.app W v) =
      Y.presheaf.map (homOfLE (preimage_preimage_eq q δ hδ W).le).op v := by
  have h3 : q.app W ≫ δ.app (q ⁻¹ᵁ W) =
      Y.presheaf.map (homOfLE (preimage_preimage_eq q δ hδ W).le).op := by
    rw [← Scheme.Hom.comp_app δ q W, Scheme.Hom.congr_app hδ W, Scheme.Hom.id_app]
    exact Category.id_comp _
  rw [← CategoryTheory.comp_apply, h3]

end Section

open Stacks.SchemeCohomology RingedSpaceModuleAdjunction Stacks.SheafOfModules

/-- Restriction of a trivializing section is trivializing. -/
theorem triv_resL {X : Scheme.{u}} (L : SheafOfModules.{u} (structureSheafRing (ringedSpace X)))
    {V V₀ : X.Opens} (hV₀ : V₀ ≤ V) (a : L.val.obj (op V))
    (ha : ∀ (V' : X.Opens) (hV' : V' ≤ V),
      Function.Bijective fun c : X.presheaf.obj (op V') => c • resL L hV' a)
    (V' : X.Opens) (hV' : V' ≤ V₀) :
    Function.Bijective fun c : X.presheaf.obj (op V') => c • resL L hV' (resL L hV₀ a) := by
  rw [show resL L hV' (resL L hV₀ a) = resL L (hV'.trans hV₀) a from
    map_restrict_comp (X := ringedSpace X) L hV' hV₀ a]
  exact ha V' (hV'.trans hV₀)

/-- Restriction of local sections of `L` from an open to itself is the identity. -/
theorem resL_self {X : Scheme.{u}} (L : SheafOfModules.{u} (structureSheafRing (ringedSpace X)))
    {V : X.Opens} (hVV : V ≤ V) (m : L.val.obj (op V)) : resL L hVV m = m := by
  simp [resL]

/-- Restriction in `Y` from an open to itself is the identity. -/
theorem map_self {Y : Scheme.{u}} {A : Y.Opens} (hAA : A ≤ A) (x : Y.presheaf.obj (op A)) :
    Y.presheaf.map (homOfLE hAA).op x = x := by
  simp

/-- **Normalizing a trivialization.** Dividing a trivializing section of `L` over `q⁻¹ U` by
its value along the section `δ` of `q` gives a trivializing section whose value along `δ` is
`1`. -/
theorem exists_normalized_trivialization {X Z : Scheme.{u}} (q : X ⟶ Z) (δ : Z ⟶ X)
    (hδ : δ ≫ q = 𝟙 Z) (L : SheafOfModules.{u} (structureSheafRing (ringedSpace X)))
    (θ : (modulePullback (hom δ)).obj L ≅
      SheafOfModules.unit (structureSheafRing (ringedSpace Z)))
    (U : Z.Opens) (a : L.val.obj (op (q ⁻¹ᵁ U)))
    (ha : ∀ (V' : X.Opens) (hV' : V' ≤ q ⁻¹ᵁ U),
      Function.Bijective fun c : X.presheaf.obj (op V') => c • resL L hV' a) :
    ∃ s : L.val.obj (op (q ⁻¹ᵁ U)),
      (∀ (V' : X.Opens) (hV' : V' ≤ q ⁻¹ᵁ U),
        Function.Bijective fun c : X.presheaf.obj (op V') => c • resL L hV' s) ∧
      ev L δ θ (q ⁻¹ᵁ U) s = 1 := by
  have hu := isUnit_ev L δ θ (q ⁻¹ᵁ U) a ha
  let v : Z.presheaf.obj (op U) :=
    Z.presheaf.map (homOfLE (preimage_preimage_eq q δ hδ U).ge).op (hu.unit⁻¹ : _)
  have hv : IsUnit (q.app U v) :=
    ((hu.unit⁻¹).isUnit.map
      (Z.presheaf.map (homOfLE (preimage_preimage_eq q δ hδ U).ge).op).hom).map (q.app U).hom
  refine ⟨hv.unit • a, bijective_smul_units_smul (X := ringedSpace X) L _ a ha hv.unit, ?_⟩
  rw [Units.smul_def, IsUnit.unit_spec, ev_smul, app_comp_app q δ hδ, map_map, map_self]
  exact hu.val_inv_mul

/-- **Normalized trivializations agree.** If `q^♯` is an isomorphism over `A`, two
trivializing sections of `L` over opens containing `q⁻¹ A`, both with value `1` along the
section `δ` of `q`, agree on `q⁻¹ A`. -/
theorem resL_eq_of_ev_eq_one {X Z : Scheme.{u}} (q : X ⟶ Z) (δ : Z ⟶ X)
    (hδ : δ ≫ q = 𝟙 Z) (L : SheafOfModules.{u} (structureSheafRing (ringedSpace X)))
    (θ : (modulePullback (hom δ)).obj L ≅
      SheafOfModules.unit (structureSheafRing (ringedSpace Z)))
    {A W₁ W₂ : Z.Opens} [IsIso (q.app A)] (h₁ : A ≤ W₁) (h₂ : A ≤ W₂)
    (s₁ : L.val.obj (op (q ⁻¹ᵁ W₁))) (s₂ : L.val.obj (op (q ⁻¹ᵁ W₂)))
    (hs₁ : ∀ (V' : X.Opens) (hV' : V' ≤ q ⁻¹ᵁ W₁),
      Function.Bijective fun c : X.presheaf.obj (op V') => c • resL L hV' s₁)
    (hs₂ : ∀ (V' : X.Opens) (hV' : V' ≤ q ⁻¹ᵁ W₂),
      Function.Bijective fun c : X.presheaf.obj (op V') => c • resL L hV' s₂)
    (hs₁' : ev L δ θ (q ⁻¹ᵁ W₁) s₁ = 1) (hs₂' : ev L δ θ (q ⁻¹ᵁ W₂) s₂ = 1) :
    resL L (q.preimage_mono h₁) s₁ = resL L (q.preimage_mono h₂) s₂ := by
  have t₁ := triv_resL L (q.preimage_mono h₁) s₁ hs₁ _ le_rfl
  have t₂ := triv_resL L (q.preimage_mono h₂) s₂ hs₂ _ le_rfl
  simp only [resL_self] at t₁ t₂
  obtain ⟨c, hc⟩ := exists_units_smul_eq (X := ringedSpace X) L (q ⁻¹ᵁ A)
    (resL L (q.preimage_mono h₁) s₁) (resL L (q.preimage_mono h₂) s₂) t₁ t₂
  let c₀ : X.presheaf.obj (op (q ⁻¹ᵁ A)) := c.1
  let c' : Z.presheaf.obj (op A) := inv (q.app A) c₀
  have hcc' : q.app A c' = c₀ := by
    simp only [c', ← CategoryTheory.comp_apply, IsIso.inv_hom_id, CategoryTheory.id_apply]
  have hc' : c₀ • resL L (q.preimage_mono h₁) s₁ = resL L (q.preimage_mono h₂) s₂ := hc
  have hev := congrArg (ev L δ θ (q ⁻¹ᵁ A)) hc'
  rw [ev_smul, ev_resL_eq_one L δ θ _ hs₁', ev_resL_eq_one L δ θ _ hs₂', mul_one, ← hcc',
    app_comp_app q δ hδ] at hev
  have hc'1 : c' = 1 := by
    have := congrArg (Z.presheaf.map (homOfLE (preimage_preimage_eq q δ hδ A).ge).op) hev
    rwa [map_map, map_self, map_one] at this
  rw [← hc', ← hcc', hc'1, map_one, one_smul]

/-- **Normalized trivializations are compatible.** If `q^♯` is an isomorphism over every affine
open of `Z`, a family of trivializing sections of `L` over the inverse images `q⁻¹ W i`, each with
value `1` along the section `δ` of `q`, is compatible. -/
theorem isCompatible_of_ev_eq_one {X Z : Scheme.{u}} (q : X ⟶ Z) (δ : Z ⟶ X)
    (hδ : δ ≫ q = 𝟙 Z) (L : SheafOfModules.{u} (structureSheafRing (ringedSpace X)))
    (θ : (modulePullback (hom δ)).obj L ≅
      SheafOfModules.unit (structureSheafRing (ringedSpace Z)))
    (hq : ∀ B : Z.Opens, IsAffineOpen B → IsIso (q.app B))
    {ι : Type u} (W : ι → Z.Opens) (s : ∀ i, L.val.obj (op (q ⁻¹ᵁ W i)))
    (hs : ∀ i (V' : X.Opens) (hV' : V' ≤ q ⁻¹ᵁ W i),
      Function.Bijective fun c : X.presheaf.obj (op V') => c • resL L hV' (s i))
    (hs1 : ∀ i, ev L δ θ (q ⁻¹ᵁ W i) (s i) = 1) :
    TopCat.Presheaf.IsCompatible L.val.presheaf (fun i => q ⁻¹ᵁ W i) s := by
  let F : TopCat.Sheaf AddCommGrpCat X.carrier := ⟨L.val.presheaf, SheafOfModules.isSheaf L⟩
  intro z₁ z₂
  refine F.eq_of_locally_eq' (fun B : {B : Z.Opens // IsAffineOpen B ∧ B ≤ W z₁ ⊓ W z₂} =>
    q ⁻¹ᵁ B.1) _ (fun B => homOfLE (q.preimage_mono B.2.2)) ?_ _ _ fun B => ?_
  · intro x hx
    obtain ⟨_, ⟨B, hB, rfl⟩, hxB, hBU⟩ := Z.isBasis_affineOpens.exists_subset_of_mem_open
      (show q x ∈ W z₁ ⊓ W z₂ from hx) (W z₁ ⊓ W z₂).2
    exact Opens.mem_iSup.mpr ⟨⟨B, hB, hBU⟩, hxB⟩
  · have e₁ := map_restrict_comp (X := ringedSpace X) L
      (q.preimage_mono B.2.2) (inf_le_left : q ⁻¹ᵁ W z₁ ⊓ q ⁻¹ᵁ W z₂ ≤ _) (s z₁)
    have e₂ := map_restrict_comp (X := ringedSpace X) L
      (q.preimage_mono B.2.2) (inf_le_right : q ⁻¹ᵁ W z₁ ⊓ q ⁻¹ᵁ W z₂ ≤ _) (s z₂)
    have := hq _ B.2.1
    exact e₁.trans ((resL_eq_of_ev_eq_one q δ hδ L θ (B.2.2.trans inf_le_left)
      (B.2.2.trans inf_le_right) (s z₁) (s z₂) (hs z₁) (hs z₂) (hs1 z₁) (hs1 z₂)).trans e₂.symm)

/-- **Gluing of normalized trivializations.** Let `P` be proper and geometrically integral over
a field `k`, let `Z` be a scheme over `k`, and let `L` be a sheaf of modules on `P ×_k Z` which is
trivial over the inverse image of every member of an open covering of `Z`, and whose pullback
along a section `δ` of the projection to `Z` is trivial.  Then `L` is trivial.

This is the gluing step in the proof of the theorem of the cube (Stacks Tag 0BF4).  Regular
functions on `P ×_k W`, for `W ⊆ Z` affine, are the regular functions on `W`, because those on
`P` are the constants (Stacks Tag 0BUG, part (8)) and global sections commute with the flat base
change `k → Γ(W)`.  So a local trivialization of `L` is unique up to a unit pulled back from `Z`;
normalising it by its value along `δ` makes it unique, and the normalised local trivializations
glue.  Invertibility of `L` is not needed. -/
theorem nonempty_iso_unit_of_locally {k : Type u} [Field k] {P Z : Scheme.{u}}
    (π : P ⟶ Spec (.of k)) [IsProper π] [GeometricallyIntegral π] (h : Z ⟶ Spec (.of k))
    (L : (pullback π h).Modules)
    (δ : Z ⟶ pullback π h) (hδ : δ ≫ pullback.snd π h = 𝟙 Z)
    (hδL : Nonempty ((Scheme.Modules.pullback δ).obj L ≅ SheafOfModules.unit _))
    (hloc : ∀ z : Z, ∃ U : Z.Opens, z ∈ U ∧
      Nonempty ((Scheme.Modules.pullback ((pullback.snd π h) ⁻¹ᵁ U).ι).obj L ≅
        SheafOfModules.unit _)) :
    Nonempty (L ≅ SheafOfModules.unit _) := by
  obtain ⟨θ⟩ := hδL
  let q := pullback.snd π h
  let L' : SheafOfModules.{u} (structureSheafRing (ringedSpace (pullback π h))) := L
  let θ' : (modulePullback (hom δ)).obj L' ≅
      SheafOfModules.unit (structureSheafRing (ringedSpace Z)) := θ
  have hnorm : ∀ z : Z, ∃ W : Z.Opens, z ∈ W ∧ ∃ s : L'.val.obj (op (q ⁻¹ᵁ W)),
      (∀ (V' : (pullback π h).Opens) (hV' : V' ≤ q ⁻¹ᵁ W),
        Function.Bijective fun c : (pullback π h).presheaf.obj (op V') => c • resL L' hV' s) ∧
      ev L' δ θ' (q ⁻¹ᵁ W) s = 1 := by
    intro z
    obtain ⟨U, hzU, ⟨e⟩⟩ := hloc z
    obtain ⟨a, ha⟩ := exists_bijective_smul_of_over_iso_unit (X := ringedSpace (pullback π h)) L'
      (q ⁻¹ᵁ U) (Stacks.Modules.overIsoUnitOfRestrictIsoUnit L (q ⁻¹ᵁ U)
        ((Scheme.Modules.restrictFunctorIsoPullback _).app L ≪≫ e))
    exact ⟨U, hzU, exists_normalized_trivialization q δ hδ L' θ' U (resL L' le_rfl a)
      (triv_resL L' le_rfl a ha)⟩
  choose W hzW s hs hs1 using hnorm
  let F : TopCat.Sheaf AddCommGrpCat (pullback π h).carrier :=
    ⟨L'.val.presheaf, SheafOfModules.isSheaf L'⟩
  have hcov : IsOpenCover fun z => q ⁻¹ᵁ W z :=
    le_antisymm le_top fun x _ => Opens.mem_iSup.mpr ⟨q x, hzW (q x)⟩
  have hcompat := isCompatible_of_ev_eq_one q δ hδ L' θ'
    (fun _ hB => isIso_snd_app_of_isAffineOpen π h hB) W s hs hs1
  obtain ⟨g, hg, -⟩ := F.existsUnique_gluing' (fun z => q ⁻¹ᵁ W z) ⊤ (fun _ => homOfLE le_top)
    hcov.ge s hcompat
  let g' : L'.val.obj (op ⊤) := g
  have hg' : ∀ z, resL L' le_top g' = s z := hg
  let sec : L'.val.sections := PresheafOfModules.sectionsMk
    (fun B => L'.val.map (homOfLE (le_top (a := B.unop))).op g') fun B C f => by
      rw [← L'.val.map_comp_apply]
      exact L'.val.congr_map_apply (Subsingleton.elim _ _) g'
  refine nonempty_iso_unit_of_bijective_smul_on_cover (X := ringedSpace (pullback π h)) L' sec
    (fun z => q ⁻¹ᵁ W z) hcov fun z V hV => ?_
  have hsec : sec.eval (op V) = resL L' hV (s z) := by
    rw [← hg' z]
    exact (map_restrict_comp (X := ringedSpace (pullback π h)) L' hV le_top g').symm
  exact hsec ▸ hs z V hV

end AlgebraicGeometry.Cube
