namespace Stacks.GradedProperCohomology

/-- **The higher cohomology of the graded layers of a large twist vanishes, over a Noetherian
local base.**

Let `(A, 𝔪)` be a Noetherian local ring, `f : X ⟶ Spec A` proper, `ℒ` an invertible `𝒪_X`-module
and `ℱ` quasi-coherent of finite type; write `ℱ(d) = ℱ ⊗_{𝒪_X} ℒ ^⊗ d`.  Let `v : V ⟶ X` be a
closed immersion with ideal sheaf `𝔪 𝒪_X` — the fibre of `f` over the closed point — lying over
`Spec(A ⧸ 𝔪)` by a proper `g`, and suppose `v ^* ℒ` is ample on `V`.  Then one `d₀` serves every
`n`:

`H ᵖ(X, ker(ℱ(d) / 𝔪 ⁿ⁺¹ ℱ(d) ⟶ ℱ(d) / 𝔪 ⁿ ℱ(d))) = 0`  for `d ≥ d₀`, `p > 0` and all `n`.

The kernel is `𝔪 ⁿ ℱ(d) / 𝔪 ⁿ⁺¹ ℱ(d)`, and this is exactly the hypothesis `hgr` of the two
assertions of [Stacks, Tag 0D2M] over a local base.

This is part (2) of [Stacks, Tag 0897] at the fibre, read on the base: the engine is
`exists_isZero_Hgroup_tensorPowTwist_int_fibreAssociatedGraded_of_isAffine`,
the layer is carried to the fibre by
`Stacks.Algebraization.kernelIdealPowerQuotientDropTwistReesIso` and the cohomology by
`Stacks.Cohomology.FormalFunctions.isZero_rightDerived_pushforward_iff_isZero_hgroup`. -/
theorem exists_isZero_rightDerived_kernelIdealPowerQuotientDropTwist
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] {X : Scheme.{u}}
    (f : X ⟶ Spec (CommRingCat.of A)) [IsProper f]
    (F L : X.Modules) [IsInvertibleModule X L] [F.IsQuasicoherent]
    [PresheafOfModules.IsFiniteType (Opens.grothendieckTopology (X : TopCat)) F.val]
    {V : Scheme.{u}} (v : V ⟶ X) [IsClosedImmersion v]
    (hv : v.ker = baseIdealSheaf A (IsLocalRing.maximalIdeal A) f)
    (g : V ⟶ Spec (CommRingCat.of (A ⧸ IsLocalRing.maximalIdeal A)))
    (hg : AlgebraicGeometry.IsProper g)
    (hsq : v ≫ f = g ≫ quotImmersion (CommRingCat.of A) (IsLocalRing.maximalIdeal A))
    (hL : IsAmple V ((Scheme.Modules.pullback v).obj L)) :
    ∃ d₀ : ℤ, ∀ d : ℤ, d₀ ≤ d → ∀ p : ℕ, 0 < p → ∀ n : ℕ,
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived p).obj
        (kernel (idealPowerQuotientDrop
          (baseIdealSheaf A (IsLocalRing.maximalIdeal A) f) (Nat.le_succ n)
          (twistModule X L F d)))) := by
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have : IsLocallyNoetherian V := isLocallyNoetherian_of_isClosedImmersion v
  have : IsNoetherianRing (AssociatedGraded.gradedRing (IsLocalRing.maximalIdeal A)) :=
    AssociatedGraded.isNoetherianRing_gradedRing _
  have hker : RingHom.ker (((quotImmersion (CommRingCat.of A) (IsLocalRing.maximalIdeal A)).app
      (⊤ : (Spec (CommRingCat.of A)).Opens)).hom) =
      (specIdealSheaf (IsLocalRing.maximalIdeal A)).ideal
        ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of A))⟩ :=
    Stacks.Conormal.ker_app_top_quotImmersion_eq_specIdealSheaf (IsLocalRing.maximalIdeal A)
  have hmul := associatedGradedAlgebra_mul_comm
    (quotImmersion (CommRingCat.of A) (IsLocalRing.maximalIdeal A))
    (specIdealSheaf (IsLocalRing.maximalIdeal A))
  have key := exists_isZero_Hgroup_tensorPowTwist_int_fibreAssociatedGraded_of_isAffine
    v f g (quotImmersion (CommRingCat.of A) (IsLocalRing.maximalIdeal A))
    (specIdealSheaf (IsLocalRing.maximalIdeal A)) hg
    (R := AssociatedGraded.gradedRing (IsLocalRing.maximalIdeal A))
    (Stacks.Conormal.specGradedPullbackSectionsRingEquiv (CommRingCat.of A)
      (IsLocalRing.maximalIdeal A) (specIdealSheaf (IsLocalRing.maximalIdeal A)) hker
      hmul)
    (Stacks.Conormal.specGradedPullbackSectionsRingEquiv_algebraMap (CommRingCat.of A)
      (IsLocalRing.maximalIdeal A) (specIdealSheaf (IsLocalRing.maximalIdeal A)) hker
      hmul)
    F hsq ((Scheme.Modules.pullback v).obj L)
    (Stacks.AmplePullback.isAmple_modulePullback_of_isAffineHom _ _ hL)
  have hIJ : (specIdealSheaf (IsLocalRing.maximalIdeal A)).comap f =
      baseIdealSheaf A (IsLocalRing.maximalIdeal A) f :=
    (Stacks.PuncturedSpectrumPicard.baseIdealSheaf_eq_comap A
      (IsLocalRing.maximalIdeal A) f).symm
  have hv1 : v.ker = baseIdealSheaf A (IsLocalRing.maximalIdeal A) f ^ 1 := by
    rw [pow_one]; exact hv
  obtain ⟨d₀, hd₀⟩ := key
  refine ⟨d₀, fun d hd p hp n => ?_⟩
  have h1 : IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived p).obj
      ((Scheme.Modules.pushforward v).obj
        (Stacks.RelativeVeryAmple.tensorModules V
          ((Scheme.Modules.pullback v).obj
            ((Stacks.Blowup.reesMultiple (baseIdealSheaf A (IsLocalRing.maximalIdeal A) f)
              (n : ℤ) F).toSheafOfModules : X.Modules))
          (tensorPowModule V ((Scheme.Modules.pullback v).obj L) d)))) :=
    (Stacks.Cohomology.FormalFunctions.isZero_rightDerived_pushforward_iff_isZero_hgroup
      v _ p).2 (by
        simpa only [fibreAssociatedGradedModule_piece, hIJ] using hd₀ d hd p hp n)
  exact h1.of_iso (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived p).mapIso
    (kernelIdealPowerQuotientDropTwistReesIso _ L F n d v hv1))

end Stacks.GradedProperCohomology

end
