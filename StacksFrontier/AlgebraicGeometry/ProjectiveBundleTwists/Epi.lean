module

public import StacksFrontier.AlgebraicGeometry.ProjectiveBundleTwists.Basic
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.StalkEpiMono

/-!
# Epimorphy of the universal degree-one map of a projective bundle

Let `X` be a scheme, `E` a quasi-coherent `𝒪_X`-module and `π : 𝐏(E) ⟶ X` its projective bundle.
If every section of `𝒪_{𝐏(E)}(1)` is, near each of its points, an `𝒪_{𝐏(E)}`-multiple of a
section coming from `E`, then the universal degree-one map `π^*E ⟶ 𝒪_{𝐏(E)}(1)` is an
epimorphism, and there is a tautological datum `Stacks.RelativeProj.TautologicalDatum X E`.

## Main definitions

* `Stacks.SymGraded.bundleSection`: the section of `𝒪_{𝐏(E)}(1)` over `π^{-1}(W)` attached to a
  section of `E` over `W`, its image under the adjoint form `E ⟶ π_* 𝒪_{𝐏(E)}(1)` of the
  universal degree-one map.

## Main results

* `Stacks.SymGraded.univ_app_unit`: the universal map sends the unit section of `e` to
  `bundleSection e`.
* `Stacks.SymGraded.epi_projectiveBundleTwistUniv_of_exists_bundleSection`: if every section of
  `𝒪_{𝐏(E)}(1)` is locally a multiple of a `bundleSection`, the universal degree-one map is an
  epimorphism.
* `Stacks.SymGraded.epi_bundleTwistUniv_of_epi`: epimorphy transfers from the canonical
  presentation of the bundle to the presentation `Stacks.RelativeProj.TautologicalDatum` is stated
  over.
* `Stacks.SymGraded.exists_tautologicalDatum_of_exists_bundleSection`: a tautological datum on
  `𝐏(E)`, granted that `𝒪_{𝐏(E)}(1)` is locally generated by the sections `bundleSection`.

## Implementation notes

`AlgebraicGeometry.Scheme.Modules X` is a `def` for `SheafOfModules X.ringCatSheaf` with a copy of
its `Category` instance, so `Epi` at the two spellings are distinct propositions; epimorphy is
transported from the latter to the former by cancellation.

## References

* [Stacks Project, Tag 01O4](https://stacks.math.columbia.edu/tag/01O4)
* [Stacks Project, Tag 01OB](https://stacks.math.columbia.edu/tag/01OB)
* [Stacks Project, Tag 01NR](https://stacks.math.columbia.edu/tag/01NR)
* [Stacks Project, Tag 007T](https://stacks.math.columbia.edu/tag/007T)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite TopologicalSpace

namespace Stacks.SymGraded

universe u

variable {X : Scheme.{u}} (E : X.Modules) [E.IsQuasicoherent]
  (hqc : IsQuasicoherentPieces E)

/-! ### Sections of the twist coming from the base -/

/-- The section of `𝒪_{𝐏(E)}(1)` over `π^{-1}(W)` attached to a section `e` of `E` over `W`: the
image of `e` under the adjoint form `E ⟶ π_* 𝒪_{𝐏(E)}(1)` of the universal degree-one map. -/
def bundleSection (W : X.Opens) (e : Γ(E, W)) :
    Γ(projectiveBundleTwist E hqc 1, (schemeProjectiveBundle E hqc).toBase ⁻¹ᵁ W) :=
  (projectiveBundleTwistGen E hqc).app W e

/-- A morphism of `X.Modules` which is an epimorphism in `SheafOfModules X.ringCatSheaf` is an
epimorphism in `X.Modules`. -/
private theorem epi_of_sheafOfModules {M N : X.Modules} (f : M ⟶ N)
    (hf : Epi (C := _root_.SheafOfModules.{u} X.ringCatSheaf) f) : Epi (C := X.Modules) f :=
  ⟨fun _ _ hh => (cancel_epi (C := _root_.SheafOfModules.{u} X.ringCatSheaf) f).1 hh⟩

omit [E.IsQuasicoherent] in
/-- The universal degree-one map carries the image of `e` under the unit of the
pullback–pushforward adjunction to `bundleSection e`. -/
theorem univ_app_unit (W : X.Opens) (e : Γ(E, W)) :
    (projectiveBundleTwistUniv E hqc).app
        ((schemeProjectiveBundle E hqc).toBase ⁻¹ᵁ W)
        (((Scheme.Modules.pullbackPushforwardAdjunction
            (schemeProjectiveBundle E hqc).toBase).unit.app E).app W e) =
      bundleSection E hqc W e := by
  have h := projectiveBundleTwistUniv_adjoint E hqc
  rw [Adjunction.homEquiv_unit] at h
  exact congrArg (fun φ => Scheme.Modules.Hom.app φ W e) h

/-! ### The reduction of the surjectivity clause -/

omit [E.IsQuasicoherent] in
/-- If every section `t` of `𝒪_{𝐏(E)}(1)` over an open `U` is, near each point of `U`, an
`𝒪_{𝐏(E)}`-multiple of a section `bundleSection e` coming from the base, then the universal
degree-one map `π^*E ⟶ 𝒪_{𝐏(E)}(1)` is an epimorphism. -/
theorem epi_projectiveBundleTwistUniv_of_exists_bundleSection
    (h : ∀ (U : (schemeProjectiveBundle E hqc).scheme.Opens)
           (t : (projectiveBundleTwist E hqc 1).val.obj (op U))
           (y : (schemeProjectiveBundle E hqc).scheme), y ∈ U →
         ∃ (V : (schemeProjectiveBundle E hqc).scheme.Opens) (hVU : V ≤ U), y ∈ V ∧
           ∃ (W : X.Opens)
             (hVW : V ≤ (schemeProjectiveBundle E hqc).toBase ⁻¹ᵁ W)
             (e : Γ(E, W))
             (r : (schemeProjectiveBundle E hqc).scheme.ringCatSheaf.obj.obj (op V)),
             (projectiveBundleTwist E hqc 1).val.map (homOfLE hVU).op t =
               r • (projectiveBundleTwist E hqc 1).val.map (homOfLE hVW).op
                     (bundleSection E hqc W e)) :
    Epi (projectiveBundleTwistUniv E hqc) := by
  refine epi_of_sheafOfModules _ ?_
  refine Stacks.SheafOfModules.StalkEpiMono.epi_of_exists_sections _ fun U t y hy => ?_
  obtain ⟨V, hVU, hyV, W, hVW, e, r, heq⟩ := h U t y hy
  refine ⟨V, hVU, hyV, r • ((Scheme.Modules.pullback
      (schemeProjectiveBundle E hqc).toBase).obj E).val.map (homOfLE hVW).op
      (((Scheme.Modules.pullbackPushforwardAdjunction
          (schemeProjectiveBundle E hqc).toBase).unit.app E).app W e), ?_⟩
  refine Eq.trans ?_ heq.symm
  refine Eq.trans
    ((ConcreteCategory.hom ((projectiveBundleTwistUniv E hqc).val.app (op V))).map_smul r _) ?_
  congr 1
  refine Eq.trans (PresheafOfModules.naturality_apply _ _ _) ?_
  exact congrArg _ (univ_app_unit E hqc W e)

/-! ### Transport to the presentation the tautological datum is stated over -/

/-- If the universal degree-one map `Stacks.SymGraded.projectiveBundleTwistUniv` is an epimorphism,
so is `Stacks.SymGraded.bundleTwistUniv`, its transport along the comparison
`Stacks.SymGraded.bundleComparison` of the two presentations of the bundle. -/
theorem epi_bundleTwistUniv_of_epi (h : Epi (projectiveBundleTwistUniv E hqc)) :
    Epi (bundleTwistUniv E hqc) := by
  have := h
  have h3 : Epi ((Scheme.Modules.pullback (bundleComparison E hqc).inv).map
      (projectiveBundleTwistUniv E hqc)) := inferInstance
  unfold bundleTwistUniv
  exact @epi_comp _ _ _ _ _ _ (IsIso.epi_of_iso _) _
    (@epi_comp _ _ _ _ _ _ (IsIso.epi_of_iso _) _ h3)

/-- If every section of `𝒪_{𝐏(E)}(1)` is, near each point, an `𝒪_{𝐏(E)}`-multiple of a section
`bundleSection e` coming from the base, there is a tautological datum
`Stacks.RelativeProj.TautologicalDatum X E`. -/
theorem exists_tautologicalDatum_of_exists_bundleSection
    (h : ∀ (U : (schemeProjectiveBundle E hqc).scheme.Opens)
           (t : (projectiveBundleTwist E hqc 1).val.obj (op U))
           (y : (schemeProjectiveBundle E hqc).scheme), y ∈ U →
         ∃ (V : (schemeProjectiveBundle E hqc).scheme.Opens) (hVU : V ≤ U), y ∈ V ∧
           ∃ (W : X.Opens)
             (hVW : V ≤ (schemeProjectiveBundle E hqc).toBase ⁻¹ᵁ W)
             (e : Γ(E, W))
             (r : (schemeProjectiveBundle E hqc).scheme.ringCatSheaf.obj.obj (op V)),
             (projectiveBundleTwist E hqc 1).val.map (homOfLE hVU).op t =
               r • (projectiveBundleTwist E hqc 1).val.map (homOfLE hVW).op
                     (bundleSection E hqc W e)) :
    Nonempty (Stacks.RelativeProj.TautologicalDatum X E) :=
  exists_tautologicalDatum_of_epi E hqc
    (epi_bundleTwistUniv_of_epi E hqc
      (epi_projectiveBundleTwistUniv_of_exists_bundleSection E hqc h))

end Stacks.SymGraded

end
