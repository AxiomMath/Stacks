module

public import StacksFrontier.AlgebraicGeometry.ProjectiveBundleTwists.Epi
public import StacksFrontier.AlgebraicGeometry.TwistDataFromChart.DegreeOneChart

/-!
# `𝒪_{𝐏(E)}(1)` is locally generated by the sections coming from the base

Every section of `𝒪_{𝐏(E)}(1)` on the projective bundle of a quasi-coherent module `E` is, near
each of its points, an `𝒪_{𝐏(E)}`-multiple of a section pulled back from the base. Consequently
the universal degree-one map `π^*E ⟶ 𝒪_{𝐏(E)}(1)` is an epimorphism, and `𝐏(E)` carries a
tautological datum at arbitrary rank with no hypothesis beyond quasi-coherence of `E`.

## Main results

* `Stacks.SymGraded.exists_local_bundleSection`: **local generation.** Every section of
  `𝒪_{𝐏(E)}(1)` over an open `U` is, on a neighbourhood of each point of `U` contained in the
  inverse image of an affine open `W` of the base, an `𝒪_{𝐏(E)}`-multiple of the restriction of
  `bundleSection W e` for a section `e` of `E` over `W`.
* `Stacks.SymGraded.epi_projectiveBundleTwistUniv`: the universal degree-one map
  `π^*E ⟶ 𝒪_{𝐏(E)}(1)` is an epimorphism, with no hypothesis.
* `Stacks.SymGraded.epi_bundleTwistUniv`: the same on the presentation of the bundle that a
  tautological datum is stated over.
* `Stacks.SymGraded.nonempty_tautologicalDatum`: **a tautological datum on `𝐏(E)` for every
  quasi-coherent module on every scheme**, at arbitrary rank and with no hypothesis. The
  quasi-coherence of the homogeneous pieces of `Sym(E)` that the bundle's construction asks for is
  itself a theorem, `Stacks.SymGraded.isQuasicoherentPieces_of_isQuasicoherent`, so no witness has
  to be supplied by the caller.

## References

* [Stacks Project, Tag 01O4](https://stacks.math.columbia.edu/tag/01O4)
* [Stacks Project, Tag 01OB](https://stacks.math.columbia.edu/tag/01OB)
* [Stacks Project, Tag 0B3V](https://stacks.math.columbia.edu/tag/0B3V)
* [Stacks Project, Tag 01MS](https://stacks.math.columbia.edu/tag/01MS)
-/


@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open AlgebraicGeometry
open AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjTwistSections
open Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.AlgebraicGeometry.RelativeProj
open Stacks.AlgebraicGeometry.RelativeProjTwists
open Stacks.AlgebraicGeometry.TwistDataFromChart

namespace Stacks.SymGraded

universe u

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf
attribute [local instance_reducible] ProjectiveSpectrum.top

variable {X : Scheme.{u}} (E : X.Modules) [E.IsQuasicoherent]
  (hqc : IsQuasicoherentPieces E)

/-- **Local generation of `𝒪_{𝐏(E)}(1)` by the sections of Stacks 01OB.** Every section `t` of
`𝒪_{𝐏(E)}(1)` over an open `U` of the projective bundle is, on a neighbourhood `V` of each point
`y` of `U`, an `𝒪_{𝐏(E)}`-multiple of the section `bundleSection W e` attached to a section `e`
of `E` over an affine open `W` of the base — the neighbourhood being contained in `π^{-1}(W)`. -/
public theorem exists_local_bundleSection
    (U : (schemeProjectiveBundle E hqc).scheme.Opens)
    (t : (projectiveBundleTwist E hqc 1).val.obj (op U))
    (y : (schemeProjectiveBundle E hqc).scheme) (hy : y ∈ U) :
    ∃ (V : (schemeProjectiveBundle E hqc).scheme.Opens) (hVU : V ≤ U), y ∈ V ∧
      ∃ (W : X.Opens)
        (hVW : V ≤ (schemeProjectiveBundle E hqc).toBase ⁻¹ᵁ W)
        (e : Γ(E, W))
        (r : (schemeProjectiveBundle E hqc).scheme.ringCatSheaf.obj.obj (op V)),
        (projectiveBundleTwist E hqc 1).val.map (homOfLE hVU).op t =
          r • (projectiveBundleTwist E hqc 1).val.map (homOfLE hVW).op
                (bundleSection E hqc W e) := by
  obtain ⟨W, hWaff, hyW, -⟩ := exists_isAffineOpen_mem_and_subset (X := X)
    (x := (schemeProjectiveBundle E hqc).toBase.base y) (U := ⊤) trivial
  set D := projectiveBundleTwistData E hqc with hDdef
  let := D.chartData.chart_isOpenImmersion W hWaff
  set c := (schemeProjectiveBundle E hqc).chart W hWaff with hcdef
  obtain ⟨z, -, hz⟩ : y ∈ c ''ᵁ (⊤ : (AlgebraicGeometry.Proj
      ((schemeSheafGradedAlgebra E hqc).grading W)).Opens) :=
    (D.chartData.chart_range W hWaff).ge hyW
  obtain ⟨g, hg⟩ := Stacks.AlgebraicGeometry.ProjDegreeOneTriv.exists_mem_basicOpen_degreeOne
    ((schemeSheafGradedAlgebra E hqc).grading W)
    (isGeneratedInDegreeOne_schemeSheafGradedAlgebra E hqc W hWaff) z
  obtain ⟨b, hb⟩ := g.2
  set V₀ := ProjectiveSpectrum.basicOpen ((schemeSheafGradedAlgebra E hqc).grading W)
    (g : (schemeSheafGradedAlgebra E hqc).sectionRing W) ⊓ (c ⁻¹ᵁ U) with hV₀def
  have hV₀basic : V₀ ≤ ProjectiveSpectrum.basicOpen
      ((schemeSheafGradedAlgebra E hqc).grading W)
      (g : (schemeSheafGradedAlgebra E hqc).sectionRing W) := inf_le_left
  have hV₀U : V₀ ≤ c ⁻¹ᵁ U := inf_le_right
  have hVU : c ''ᵁ V₀ ≤ U :=
    (Scheme.Hom.image_mono c hV₀U).trans (c.image_preimage_le U)
  have hVW : c ''ᵁ V₀ ≤ (schemeProjectiveBundle E hqc).toBase ⁻¹ᵁ W :=
    (Scheme.Hom.image_mono c (le_top (a := V₀))).trans (D.chartData.chart_range W hWaff).le
  set e := (symmetricAlgebraGenIso E).inv.val.app (op W) b with hedef
  have he : (Scheme.Modules.symmetricAlgebraGen X E).val.app (op W) e = b :=
    Stacks.AlgebraicGeometry.TwistRigidity.iso_inv_app_hom_app (symmetricAlgebraGenIso E).symm
      (op W) b
  obtain ⟨r, hr⟩ := (Stacks.AlgebraicGeometry.ProjDegreeOneTriv.bijective_smul_degreeOneSection
      ((schemeSheafGradedAlgebra E hqc).grading W) g.2 hV₀basic).surjective
    ((twistingSheaf ((schemeSheafGradedAlgebra E hqc).grading W) 1).val.map
      (homOfLE hV₀U).op (chartPull D.chartData W hWaff 1 U t))
  refine ⟨c ''ᵁ V₀, hVU, ⟨z, ⟨hg, show c.base z ∈ U from hz ▸ hy⟩, hz⟩, W, hVW, e,
    chartScalar D.chartData W hWaff V₀ r, ?_⟩
  have hbs : (D.ψ 1).val.app (op W) b = bundleSection E hqc W e := by
    rw [← he]; rfl
  refine Eq.trans (mapSection_res_chartPull D.chartData W hWaff 1 U t V₀ hV₀U hVU).symm ?_
  refine Eq.trans (congrArg (D.chartData.mapSection W hWaff 1 V₀) hr.symm) ?_
  refine Eq.trans (mapSection_smul D.chartData W hWaff 1 V₀ r _) ?_
  refine congrArg (fun w => chartScalar D.chartData W hWaff V₀ r • w) ?_
  refine Eq.trans (mapSection_degreeOneSection D W hWaff b g.2 hb hV₀basic hVW) ?_
  exact congrArg ((D.algebra.piece 1).val.map (homOfLE hVW).op) hbs

/-- **The universal degree-one map `π^*E ⟶ 𝒪_{𝐏(E)}(1)` is an epimorphism**, with no hypothesis
beyond quasi-coherence. -/
public theorem epi_projectiveBundleTwistUniv : Epi (projectiveBundleTwistUniv E hqc) :=
  epi_projectiveBundleTwistUniv_of_exists_bundleSection E hqc (exists_local_bundleSection E hqc)

/-- **The universal degree-one map is an epimorphism on the presentation of the bundle a
tautological datum is stated over.** -/
public theorem epi_bundleTwistUniv : Epi (bundleTwistUniv E hqc) :=
  epi_bundleTwistUniv_of_epi E hqc (epi_projectiveBundleTwistUniv E hqc)

/-- **A tautological datum on `𝐏(E)` for every quasi-coherent module on every scheme.** All four
fields are supplied: the twist `𝒪_{𝐏(E)}(1)`, its invertibility, the universal map out of `π^*E`
and the surjectivity of that map.

The hypothesis `Stacks.SymGraded.IsQuasicoherentPieces` of the bundle's construction is itself a
theorem for a quasi-coherent module, so the statement carries no datum beyond `E`. -/
public theorem nonempty_tautologicalDatum :
    Nonempty (Stacks.RelativeProj.TautologicalDatum X E) :=
  exists_tautologicalDatum_of_epi E (isQuasicoherentPieces_of_isQuasicoherent E)
    (epi_bundleTwistUniv E (isQuasicoherentPieces_of_isQuasicoherent E))

end Stacks.SymGraded

end
