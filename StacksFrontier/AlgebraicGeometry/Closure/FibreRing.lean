module

public import Mathlib.RingTheory.Smooth.Fiber
public import Mathlib.RingTheory.TensorProduct.Quotient

/-!
# The commutative algebra behind (2) ⟹ (1) of Tag 01V9

Condition (2) of Stacks Tag 01V9 is flatness of the induced map of local rings together with
smoothness of the scheme-theoretic fibre.  This file proves two statements of commutative algebra
that turn it into condition (1): a form of
`Algebra.FormallySmooth.of_formallySmooth_residueField_tensor` for arbitrary models of the two
localizations, and the passage from formal smoothness of the fibre quotient to formal smoothness
of the residue-field base change.

## Main results

* `Stacks.Tag01V9Closure.formallySmooth_of_formallySmooth_residueField_tensor`: for a finitely
  presented algebra `S'` over `R'` and primes `q` of `S'` lying over `p` of `R'`, any model
  `Rp` of `R'_p` and `Sq` of `S'_q` with `Sq` flat and local over `Rp` and with
  `𝓀[Rp] ⊗[Rp] Sq` formally smooth over `𝓀[Rp]` has `Sq` formally smooth over `Rp`.
* `Stacks.Tag01V9Closure.formallySmooth_residueField_tensor_of_quotient`: if the quotient of `B`
  by the ideal generated by the maximal ideal of a local ring `R` is formally smooth over the
  residue field of `R`, then so is `𝓀[R] ⊗[R] B`.

## References

* [Stacks Project, Tag 01V9](https://stacks.math.columbia.edu/tag/01V9)
* [Stacks Project, Tag 00TF](https://stacks.math.columbia.edu/tag/00TF)
-/

@[expose] public section

open TensorProduct IsLocalRing

universe u

namespace Stacks.Tag01V9Closure

/-- Let `S'` be a finitely presented `R'`-algebra, let `q` be a
prime of `S'` lying over the prime `p` of `R'`, and let `Rp` and `Sq` be any rings presenting
`R'_p` and `S'_q` compatibly.  If `Sq` is a flat local `Rp`-algebra and `𝓀[Rp] ⊗[Rp] Sq` is
formally smooth over `𝓀[Rp]`, then `Sq` is formally smooth over `Rp`. -/
public theorem formallySmooth_of_formallySmooth_residueField_tensor
    {R' S' : Type u} [CommRing R'] [CommRing S'] [Algebra R' S']
    [Algebra.FinitePresentation R' S']
    (p : Ideal R') (q : Ideal S') [p.IsPrime] [q.IsPrime] [q.LiesOver p]
    (Rp Sq : Type u) [CommRing Rp] [CommRing Sq] [IsLocalRing Rp] [IsLocalRing Sq]
    [Algebra R' Rp] [IsLocalization.AtPrime Rp p]
    [Algebra S' Sq] [IsLocalization.AtPrime Sq q]
    [Algebra Rp Sq] [Algebra R' Sq] [IsScalarTower R' Rp Sq] [IsScalarTower R' S' Sq]
    [Module.Flat Rp Sq] [IsLocalHom (algebraMap Rp Sq)]
    [Algebra.FormallySmooth (ResidueField Rp) (ResidueField Rp ⊗[Rp] Sq)] :
    Algebra.FormallySmooth Rp Sq := by
  let Sp := Localization (Algebra.algebraMapSubmonoid S' p.primeCompl)
  let _ : Algebra Rp Sp := localizationAlgebra p.primeCompl S'
  have _ : IsScalarTower R' Rp Sp := isScalarTower_localizationAlgebra p.primeCompl S'
  let g : Sp →ₐ[S'] Sq := IsLocalization.liftAlgHom
      (M := Algebra.algebraMapSubmonoid S' p.primeCompl) (f := Algebra.ofId _ _) (by
    rintro ⟨_, y, hy, rfl⟩
    have h : (algebraMap S' Sq) ((algebraMap R' S') y) = algebraMap R' Sq y :=
      (IsScalarTower.algebraMap_apply R' S' Sq y).symm
    simpa [h] using IsLocalization.map_units (M := q.primeCompl) Sq
      ⟨algebraMap R' S' y, by simp_all [q.over_def p]⟩)
  algebraize [g.toRingHom]
  have : IsScalarTower R' Sp Sq := .to₁₃₄ _ S' _ _
  have : IsScalarTower Rp Sp Sq := .of_algebraMap_eq' <| by
    apply IsLocalization.ringHom_ext p.primeCompl
    simp only [RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq]
  have : IsLocalization (Algebra.algebraMapSubmonoid Sp q.primeCompl) Sq :=
    .isLocalization_of_submonoid_le _ _ (Algebra.algebraMapSubmonoid S' p.primeCompl) _
      (by rintro _ ⟨y, hy, rfl⟩; simp_all [q.over_def p])
  have : Algebra.FinitePresentation Rp Sp := by
    have : Algebra.IsPushout R' Rp S' Sp :=
      .symm <| Algebra.isPushout_of_isLocalization p.primeCompl _ _ _
    exact .equiv (Algebra.IsPushout.equiv R' Rp S' Sp)
  exact Algebra.FormallySmooth.of_formallySmooth_residueField_tensor
    (R := Rp) (S := Sq) (P := Sp) (Algebra.algebraMapSubmonoid _ q.primeCompl)

/-- Let `R` be a local ring and `B` an `R`-algebra, and suppose the quotient of `B` by the ideal
generated by the maximal ideal of `R` carries a formally smooth `𝓀[R]`-algebra structure given by
a ring map `φ` that agrees with the canonical quotient structure, in the sense that
`φ ∘ residue` is the quotient of `algebraMap R B`.  Then `𝓀[R] ⊗[R] B` is formally smooth over
`𝓀[R]`. -/
public theorem formallySmooth_residueField_tensor_of_quotient
    {R B F : Type u} [CommRing R] [CommRing B] [CommRing F] [Algebra R B] [IsLocalRing R]
    (φ : (R ⧸ maximalIdeal R) →+* F)
    (e : (B ⧸ Ideal.map (algebraMap R B) (maximalIdeal R)) ≃+* F)
    (he : ∀ r : R, e (Ideal.Quotient.mk _ (algebraMap R B r)) = φ (Ideal.Quotient.mk _ r))
    (hF : @Algebra.FormallySmooth (R ⧸ maximalIdeal R) F _ _ φ.toAlgebra) :
    Algebra.FormallySmooth (ResidueField R) (ResidueField R ⊗[R] B) := by
  let _ : Algebra (R ⧸ maximalIdeal R) F := φ.toAlgebra
  have _ : Algebra.FormallySmooth (R ⧸ maximalIdeal R) F := hF
  have hcomm : ∀ y : R ⧸ maximalIdeal R,
      e (algebraMap (R ⧸ maximalIdeal R) (B ⧸ Ideal.map (algebraMap R B) (maximalIdeal R)) y)
        = algebraMap (R ⧸ maximalIdeal R) F y :=
    Ideal.Quotient.mk_surjective.forall.2 he
  have _ : Algebra.FormallySmooth (R ⧸ maximalIdeal R)
      (B ⧸ Ideal.map (algebraMap R B) (maximalIdeal R)) :=
    Algebra.FormallySmooth.of_equiv (AlgEquiv.ofRingEquiv (f := e) hcomm).symm
  exact (Algebra.FormallySmooth.of_equiv
    (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B (maximalIdeal R)) :
      Algebra.FormallySmooth (R ⧸ maximalIdeal R) ((R ⧸ maximalIdeal R) ⊗[R] B))

end Stacks.Tag01V9Closure

end
