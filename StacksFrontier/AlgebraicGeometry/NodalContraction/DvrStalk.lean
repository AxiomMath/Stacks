/-!
# Stalks of the spectrum of a discrete valuation ring, and cutting a regular local ring

For a discrete valuation ring `R`, the spectrum of `R` has exactly two points, its generic point is
open, every stalk is a principal ideal ring, and the stalk at the closed point has its maximal
ideal generated by a nonzero uniformiser.

Cutting a two-dimensional regular local ring by an element of its maximal ideal outside the square
of that ideal gives a one-dimensional regular local ring. An element whose image in a domain cuts
out a reduced quotient lies outside the square of any ideal whose image is contained in the ideal
generated by a nonunit.

## Main results

* `AlgebraicGeometry.dvr_prime_cases`: a prime of a discrete valuation ring is either the zero
  ideal or the maximal ideal.
* `AlgebraicGeometry.isOpen_generic_of_isDiscreteValuationRing`: the generic point of the spectrum
  of a discrete valuation ring is open.
* `AlgebraicGeometry.isPrincipalIdealRing_stalk_spec`: every stalk of the spectrum of a principal
  ideal ring is a principal ideal ring.
* `AlgebraicGeometry.isLocalRing_stalk_spec`: every stalk of `Spec A` is a local ring.
* `AlgebraicGeometry.exists_span_maximalIdeal_stalk_spec_of_eq_closedPoint`: the stalk at the
  closed point of the spectrum of a discrete valuation ring has a nonzero element generating its
  maximal ideal.
* `AlgebraicGeometry.notMem_sq_of_isReduced_quotient`: an element cutting out a reduced quotient
  of a domain avoids the square of an ideal whose image lies in a nonunit principal ideal.
* `AlgebraicGeometry.isRegularLocalRing_quotient_and_ringKrullDim_eq_one_of_notMem_sq`: cutting a
  two-dimensional regular local ring by an element of the maximal ideal outside its square gives a
  one-dimensional regular local ring.

## References

* [Stacks Project, Tag 0CDF](https://stacks.math.columbia.edu/tag/0CDF)
* [Stacks Project, Tag 00NQ](https://stacks.math.columbia.edu/tag/00NQ)
-/

@[expose] public noncomputable section

open CategoryTheory

universe u

namespace AlgebraicGeometry

/-- **A prime of a discrete valuation ring is the zero ideal or the maximal ideal.** -/
public theorem dvr_prime_cases (R : Type u) [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] (p : PrimeSpectrum R) :
    p = (⊥ : PrimeSpectrum R) ∨
      p = (⟨IsLocalRing.maximalIdeal R, inferInstance⟩ : PrimeSpectrum R) := by
  by_cases hp : p.asIdeal = ⊥
  · exact Or.inl (PrimeSpectrum.ext hp)
  · rcases (IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime R).mp inferInstance with
      ⟨_, P, _, hUnique⟩
    have hpP : p.asIdeal = P := hUnique p.asIdeal ⟨hp, p.2⟩
    have hmax : IsLocalRing.maximalIdeal R = P :=
      hUnique _ ⟨IsDiscreteValuationRing.not_a_field R, inferInstance⟩
    exact Or.inr (PrimeSpectrum.ext (hpP.trans hmax.symm))

/-- **The generic point of the spectrum of a discrete valuation ring is open.** -/
@[ega "IV 5.2.5" "partial"]
public theorem isOpen_generic_of_isDiscreteValuationRing (R : Type u) [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] :
    IsOpen ({(⊥ : PrimeSpectrum R)} : Set (PrimeSpectrum R)) := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hset : ({(⊥ : PrimeSpectrum R)} : Set (PrimeSpectrum R)) =
      PrimeSpectrum.basicOpen π := by
    ext p
    rcases dvr_prime_cases R p with rfl | rfl
    · simp [hπ.ne_zero]
    · have hmem : π ∈ IsLocalRing.maximalIdeal R :=
        (IsLocalRing.mem_maximalIdeal π).mpr hπ.not_isUnit
      have hne : (⟨IsLocalRing.maximalIdeal R, inferInstance⟩ : PrimeSpectrum R) ≠ ⊥ :=
        fun h => IsDiscreteValuationRing.not_a_field R (congrArg PrimeSpectrum.asIdeal h)
      simpa [hmem] using hne
  rw [hset]
  exact PrimeSpectrum.isOpen_basicOpen

/-- A localization of a principal ideal ring is a principal ideal ring. -/
private theorem isPrincipalIdealRing_of_isLocalization {R : Type u} [CommRing R]
    [IsPrincipalIdealRing R] (M : Submonoid R) (A : Type u) [CommRing A] [Algebra R A]
    [IsLocalization M A] : IsPrincipalIdealRing A := by
  refine ⟨fun I => ?_⟩
  obtain ⟨r, hr⟩ := IsPrincipalIdealRing.principal (I.under R)
  refine ⟨algebraMap R A r, ?_⟩
  rw [← IsLocalization.map_under M A I, hr, Ideal.map_span, Set.image_singleton]

/-- **Every stalk of the spectrum of a principal ideal ring is a principal ideal ring.** -/
public theorem isPrincipalIdealRing_stalk_spec {R : Type u} [CommRing R]
    [IsPrincipalIdealRing R] (p : PrimeSpectrum R) :
    IsPrincipalIdealRing ((Spec (CommRingCat.of R)).presheaf.stalk p) := by
  have : IsPrincipalIdealRing (Localization.AtPrime p.asIdeal) :=
    isPrincipalIdealRing_of_isLocalization p.asIdeal.primeCompl _
  exact IsPrincipalIdealRing.of_surjective
    (Spec.stalkIso (CommRingCat.of R) p).symm.commRingCatIsoToRingEquiv
    (Spec.stalkIso (CommRingCat.of R) p).symm.commRingCatIsoToRingEquiv.surjective

/-- **The stalk of `Spec A` at a prime is a local ring.** -/
public instance isLocalRing_stalk_spec (A : CommRingCat.{u}) (p : PrimeSpectrum A) :
    IsLocalRing ((Spec A).presheaf.stalk p) :=
  (Spec.stalkIso A p).symm.commRingCatIsoToRingEquiv.isLocalRing

/-- The stalk of `Spec R` at the closed point of a local ring `R` is `R` itself. -/
private noncomputable def closedStalkEquiv (R : Type u) [CommRing R] [IsLocalRing R] :
    R ≃+* (Spec (CommRingCat.of R)).presheaf.stalk (IsLocalRing.closedPoint R) :=
  (IsLocalization.atUnits R (IsLocalRing.maximalIdeal R).primeCompl
    (S := Localization.AtPrime (IsLocalRing.maximalIdeal R))
    (fun _ hx => (IsLocalRing.notMem_maximalIdeal).mp hx)).toRingEquiv.trans
    (Spec.stalkIso (CommRingCat.of R) (IsLocalRing.closedPoint R)).commRingCatIsoToRingEquiv.symm

/-- **The stalk at the closed point of the spectrum of a discrete valuation ring has a
uniformiser**: a nonzero element generating its maximal ideal. -/
public theorem exists_span_maximalIdeal_stalk_spec_of_eq_closedPoint
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (p : PrimeSpectrum R) (hp : p = IsLocalRing.closedPoint R) :
    ∃ π : (Spec (CommRingCat.of R)).presheaf.stalk p,
      π ≠ 0 ∧
        IsLocalRing.maximalIdeal ((Spec (CommRingCat.of R)).presheaf.stalk p) =
          Ideal.span {π} := by
  subst hp
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  let e := closedStalkEquiv R
  refine ⟨e π, fun h => hπ.ne_zero (e.injective (by simpa using h)), ?_⟩
  have hm := IsLocalRing.map_maximalIdeal_of_surjective e.toRingHom e.surjective
  rw [hπ.maximalIdeal_eq] at hm
  have he : e.toRingHom π = e π := rfl
  simpa only [Ideal.map_span, Set.image_singleton, he] using hm.symm

/-- **An element cutting out a reduced quotient of a domain avoids the square of an ideal whose
image lies in a nonunit principal ideal.** Let `φ : A →+* B` with `B` a domain, and let `I` be an
ideal of `A` whose image lies in the ideal generated by a nonunit `t`. If `φ a ≠ 0` and
`B ⧸ (φ a)` is reduced, then `a ∉ I ^ 2`. -/
public theorem notMem_sq_of_isReduced_quotient
    {A B : Type*} [CommRing A] [CommRing B] [IsDomain B]
    (φ : A →+* B) (I : Ideal A) (t : B) (ht : ¬ IsUnit t)
    (hI : Ideal.map φ I ≤ Ideal.span {t}) (a : A) (ha : φ a ≠ 0)
    [IsReduced (B ⧸ Ideal.span {φ a})] : a ∉ I ^ 2 := by
  intro h
  have hsf : Squarefree (φ a) := (isRadical_iff_span_singleton.mpr
    ((Ideal.isRadical_iff_quotient_reduced _).mpr inferInstance)).squarefree ha
  refine ht (hsf t ?_)
  rw [← pow_two, ← Ideal.mem_span_singleton, ← Ideal.span_singleton_pow]
  exact pow_le_pow_left' hI 2 (Ideal.map_pow φ I 2 ▸ Ideal.mem_map_of_mem φ h)

section

open IsLocalRing Module

/-- An element of the maximal ideal of a two-dimensional regular local ring which avoids its
square is part of a two-element system of generators. -/
private theorem exists_pair_span_maximalIdeal
    {A : Type*} [CommRing A] [IsRegularLocalRing A]
    (hdim : ringKrullDim A = 2) (a : A)
    (ha : a ∈ maximalIdeal A) (ha2 : a ∉ maximalIdeal A ^ 2) :
    ∃ b : A, Ideal.span {a, b} = maximalIdeal A := by
  classical
  have hdim' : finrank (ResidueField A) (CotangentSpace A) = 2 := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
    rw [hdim, spanFinrank_maximalIdeal_eq_finrank_cotangentSpace] at h
    exact_mod_cast h
  let a' : maximalIdeal A := ⟨a, ha⟩
  have ha' : (maximalIdeal A).toCotangent a' ≠ 0 :=
    fun h => ha2 (((maximalIdeal A).toCotangent_eq_zero a').mp h)
  obtain ⟨v, hli⟩ := exists_linearIndependent_pair_of_one_lt_finrank
    (R := ResidueField A) (by omega : 1 < finrank (ResidueField A) (CotangentSpace A)) ha'
  obtain ⟨b, hb⟩ := (maximalIdeal A).toCotangent_surjective v
  let basis := basisOfLinearIndependentOfCardEqFinrank hli (by simpa using hdim'.symm)
  have hspan : Submodule.span (ResidueField A)
      ({(maximalIdeal A).toCotangent a', (maximalIdeal A).toCotangent b} : Set _) = ⊤ := by
    rw [hb]
    simpa [basis, Set.pair_comm] using basis.span_eq
  have hspan' : Submodule.span A ({a', b} : Set (maximalIdeal A)) = ⊤ := by
    apply CotangentSpace.span_image_eq_top_iff.mp
    simpa using hspan
  refine ⟨b, ?_⟩
  have h := congrArg (Submodule.map (maximalIdeal A).subtype) hspan'
  simpa [Submodule.map_span, Submodule.map_top, Submodule.range_subtype,
    Ideal.submodule_span_eq, a'] using h

/-- **Cutting a two-dimensional regular local ring by an element of the maximal ideal outside its
square gives a one-dimensional regular local ring.** -/
public theorem isRegularLocalRing_quotient_and_ringKrullDim_eq_one_of_notMem_sq
    {A : Type*} [CommRing A] [IsRegularLocalRing A]
    (hdim : ringKrullDim A = 2) (a : A)
    (ha : a ∈ IsLocalRing.maximalIdeal A) (ha2 : a ∉ IsLocalRing.maximalIdeal A ^ 2) :
    IsRegularLocalRing (A ⧸ Ideal.span {a}) ∧
      ringKrullDim (A ⧸ Ideal.span {a}) = 1 := by
  obtain ⟨b, hb⟩ := exists_pair_span_maximalIdeal hdim a ha ha2
  have hgen : Ideal.ofList [a, b] = maximalIdeal A := by
    rw [← hb, Ideal.ofList_cons, Ideal.ofList_singleton, Ideal.span_insert]
  have hone : Ideal.ofList ([a, b].take 1) = Ideal.span {a} := Ideal.ofList_singleton a
  have hmin : [a, b].length = (maximalIdeal A).spanFinrank := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
    rw [hdim] at h
    exact_mod_cast h.symm
  obtain ⟨hr, hd⟩ :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay A).1
      [a, b] hgen hmin |>.2 1 (by simp)
  rw [hone] at hr hd
  have hr' : IsRegularLocalRing (A ⧸ Ideal.span {a}) := hr
  have hd' : ringKrullDim (A ⧸ Ideal.span {a}) + 1 = 2 := by
    simpa [hdim] using hd
  refine ⟨hr', ?_⟩
  generalize ringKrullDim (A ⧸ Ideal.span {a}) = d at *
  induction d using WithBot.recBotCoe with
  | bot => simp at hd'
  | coe n =>
    have hn : n + 1 = (2 : ℕ∞) := WithBot.coe_injective hd'
    induction n using ENat.recTopCoe with
    | top => simp at hn
    | coe n =>
      have hn' : n + 1 = 2 := by exact_mod_cast hn
      have hn1 : n = 1 := by omega
      simp [hn1]

end

end AlgebraicGeometry

