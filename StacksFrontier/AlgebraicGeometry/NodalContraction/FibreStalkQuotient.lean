module

public import StacksFrontier.AlgebraicGeometry.Morphisms.CohenMacaulay.FibreStalk

/-!
# The stalk of a fibre as a quotient by a uniformizer
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace

universe u

namespace AlgebraicGeometry

/-- When the maximal ideal of the base local ring is generated by one element, the stalk of the
fibre is the quotient of the stalk of the source by the image of that element. -/
public noncomputable def fiberStalkEquivQuotientSpan {X S : Scheme.{u}} (f : X ⟶ S) (x : X)
    (π : S.presheaf.stalk (f x))
    (hπ : IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)) = Ideal.span {π}) :
    (X.presheaf.stalk x ⧸ Ideal.span {(f.stalkMap x).hom π}) ≃+*
      (f.fiber (f x)).presheaf.stalk (f.asFiber x) := by
  have hmap : Ideal.map (f.stalkMap x).hom
      (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))) =
      Ideal.span {(f.stalkMap x).hom π} := by
    rw [hπ, Ideal.map_span, Set.image_singleton]
  exact hmap ▸ quotientStalkEquivFiberStalk f x

end AlgebraicGeometry

end
