/-!
# The local rings along a contracted exceptional curve

Let `b : X ⟶ X'` contract the ideal sheaf `D` on `X` in the sense of
`AlgebraicGeometry.IsContractionOfExceptionalCurve`: there is a closed point `z` of `X'` whose
local ring is regular of Krull dimension two, `X` is the blowup of `X'` in the reduced point
`{z}`, and `D` is the inverse image of the vanishing ideal of `{z}`. At a point of the
exceptional curve `E = D.subscheme` the local ring of `X` is regular, and the ideal induced by `D`
in it is principal, proper, and generated by the maximal ideal of `𝒪_{X',z}`. At a closed point
over the centre the local ring of the blowup is two-dimensional.

## Main results

* `AlgebraicGeometry.ringKrullDim_stalk_blowUp_eq_two_of_mapsTo` — the local ring of the blowup
  of a scheme at a reduced closed point with regular two-dimensional local ring is
  two-dimensional at a *closed* point over the centre.
* `AlgebraicGeometry.ringKrullDim_stalk_blowUp_eq_two_of_isClosed` — the same at any closed point
  of the blowup whose image has a two-dimensional local ring.
* `AlgebraicGeometry.isRegularLocalRing_stalk_blowUp_of_isRegularLocalRing_stalk_blowUpToBase` —
  regularity at any point of the blowup whose image has a regular local ring.
* `AlgebraicGeometry.isRegularLocalRing_stalk_of_isContractionOfExceptionalCurve` — the local
  rings of `X` along the contracted curve are regular.
* `AlgebraicGeometry.exists_span_stalk_of_isContractionOfExceptionalCurve` — the ideal induced by
  `D` in such a local ring is generated by a single non-unit.
* `AlgebraicGeometry.idealSheafData_stalk_eq_map_maximalIdeal` — that ideal is the image of the
  maximal ideal of the local ring at the centre.
* `AlgebraicGeometry.topologicalKrullDimAt_subscheme_eq_one_of_iso_projectiveLineProj` — a
  subscheme presented as the projective line has Krull dimension one at each of its points.

## References

* [Stacks Project, Tag 0CDF](https://stacks.math.columbia.edu/tag/0CDF)
* [Stacks Project, Tag 0C2L](https://stacks.math.columbia.edu/tag/0C2L)
* [Stacks Project, Tag 0AGR](https://stacks.math.columbia.edu/tag/0AGR)
* [Stacks Project, Tag 0805](https://stacks.math.columbia.edu/tag/0805)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace

universe u

namespace AlgebraicGeometry

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The inverse image along `Spec 𝒪_{X,z} ⟶ X` of the vanishing ideal of a reduced closed point
`z` is the ideal sheaf of the closed point of `Spec 𝒪_{X,z}`: the one whose global sections are
the image of the maximal ideal under `𝒪_{X,z} ≅ Γ(Spec 𝒪_{X,z})`. -/
private theorem vanishingIdeal_singleton_comap_fromSpecStalk_eq {X : Scheme.{u}} (z : X)
    (hz : IsClosed ({z} : Set X)) :
    (Scheme.IdealSheafData.vanishingIdeal (⟨{z}, hz⟩ : Closeds X)).comap
        (X.fromSpecStalk z) =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of (X.presheaf.stalk z))).inv.hom
          (IsLocalRing.maximalIdeal (X.presheaf.stalk z))) := by
  rw [vanishingIdeal_singleton_comap_fromSpecStalk z hz, Scheme.ker_SpecMap]
  show Scheme.IdealSheafData.ofIdealTop
    (Ideal.map _ (RingHom.ker (IsLocalRing.residue (X.presheaf.stalk z)))) = _
  rw [IsLocalRing.ker_residue]
  rfl

/-- A point of the subscheme cut out by an ideal sheaf lies in the support of the ideal sheaf. -/
private theorem subschemeι_mem_support {X : Scheme.{u}} (D : X.IdealSheafData)
    (x : D.subscheme) :
    D.subschemeι x ∈ (D.support : Set X) := by
  rw [← D.range_subschemeι]
  exact ⟨x, rfl⟩

/-- Over the centre, the local ring of the blowup is identified with a local ring of the blowup of
the localisation, through a preimmersion. -/
private theorem exists_preimmersion_stalk_ringEquiv_of_blowUpToBase_eq {X : Scheme.{u}}
    (I : X.IdealSheafData) (z : X) (y : blowUp I) (hy : blowUpToBase I y = z) :
    ∃ (h : blowUp (I.comap (X.fromSpecStalk z)) ⟶ blowUp I) (w : _),
      IsPreimmersion h ∧ h w = y ∧
        Nonempty ((blowUp I).presheaf.stalk y ≃+*
          (blowUp (I.comap (X.fromSpecStalk z))).presheaf.stalk w) := by
  obtain ⟨h, hpb⟩ := exists_isPullback_blowUpToBase_comap (X.fromSpecStalk z) I
  have : Flat h := MorphismProperty.of_isPullback (P := @Flat) hpb (flat_fromSpecStalk X z)
  have : IsPreimmersion h :=
    MorphismProperty.of_isPullback (P := @IsPreimmersion) hpb inferInstance
  obtain ⟨w, -, hwy⟩ := Scheme.exists_preimage_of_isPullback hpb
    (IsLocalRing.closedPoint (X.presheaf.stalk z)) y
    (Scheme.fromSpecStalk_closedPoint.trans hy.symm)
  have : IsIso (h.stalkMap w) := isIso_stalkMap_of_flat_preimmersion h w
  subst hwy
  exact ⟨h, w, inferInstance, rfl, ⟨(asIso (h.stalkMap w)).commRingCatIsoToRingEquiv⟩⟩

/-- Away from the centre, the blowup map is an isomorphism on stalks. -/
private theorem isIso_stalkMap_blowUpToBase_of_ne {X : Scheme.{u}} (M : X.IdealSheafData)
    (z : X) (hz : IsClosed ({z} : Set X))
    (hM : M = Scheme.IdealSheafData.vanishingIdeal (⟨{z}, hz⟩ : Closeds X))
    (y : blowUp M) (hy : blowUpToBase M y ≠ z) : IsIso ((blowUpToBase M).stalkMap y) := by
  have hsupport : (M.support : Set X) = {z} := by
    rw [hM, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hmem : y ∈ blowUpToBase M ⁻¹ᵁ
      (⟨M.supportᶜ, M.support.isClosed.isOpen_compl⟩ : X.Opens) := by
    show blowUpToBase M y ∉ (M.support : Set X)
    rwa [hsupport]
  exact isIso_stalkMap_of_isIso_morphismRestrict _ (isIso_blowUp_restrict_compl_support M) hmem

/-- The local rings of the blowup of a regular closed point of dimension two are regular at every
point of the blowup lying over the centre. -/
@[ega "IV 19.4.4" "special case"]
private theorem isRegularLocalRing_stalk_blowUp_of_mapsTo {X : Scheme.{u}}
    (I : X.IdealSheafData) (z : X) (hz : IsClosed ({z} : Set X))
    (hI : I = Scheme.IdealSheafData.vanishingIdeal (⟨{z}, hz⟩ : Closeds X))
    (hreg : IsRegularLocalRing (X.presheaf.stalk z))
    (hdim : ringKrullDim (X.presheaf.stalk z) = 2)
    (y : blowUp I) (hy : blowUpToBase I y = z) :
    IsRegularLocalRing ((blowUp I).presheaf.stalk y) := by
  have := hreg
  obtain ⟨h, w, -, hwy, ⟨e⟩⟩ :=
    exists_preimmersion_stalk_ringEquiv_of_blowUpToBase_eq I z y hy
  have hregBlow : IsRegular (blowUp (I.comap (X.fromSpecStalk z))) := by
    rw [hI, vanishingIdeal_singleton_comap_fromSpecStalk_eq z hz]
    exact isRegular_blowUp_maximalIdeal _ hdim
  have := AlgebraicGeometry.IsRegular.isRegularLocalRing_stalk hregBlow w
  exact IsRegularLocalRing.of_ringEquiv e.symm

/-- The local ring of the blowup of a regular closed point of dimension two at a closed point over
the centre is two-dimensional. -/
public theorem ringKrullDim_stalk_blowUp_eq_two_of_mapsTo {X : Scheme.{u}}
    (I : X.IdealSheafData) (z : X) (hz : IsClosed ({z} : Set X))
    (hI : I = Scheme.IdealSheafData.vanishingIdeal (⟨{z}, hz⟩ : Closeds X))
    (hreg : IsRegularLocalRing (X.presheaf.stalk z))
    (hdim : ringKrullDim (X.presheaf.stalk z) = 2)
    (y : blowUp I) (hy : blowUpToBase I y = z)
    (hyclosed : IsClosed ({y} : Set (blowUp I))) :
    ringKrullDim ((blowUp I).presheaf.stalk y) = 2 := by
  have := hreg
  obtain ⟨h, w, hh, hwy, ⟨e⟩⟩ :=
    exists_preimmersion_stalk_ringEquiv_of_blowUpToBase_eq I z y hy
  have hcomap : I.comap (X.fromSpecStalk z) =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of (X.presheaf.stalk z))).inv.hom
          (IsLocalRing.maximalIdeal (X.presheaf.stalk z))) := by
    rw [hI]
    exact vanishingIdeal_singleton_comap_fromSpecStalk_eq z hz
  have hwclosed : IsClosed ({w} : Set (blowUp (I.comap (X.fromSpecStalk z)))) := by
    have hpre : h ⁻¹' ({y} : Set (blowUp I)) = {w} := by
      ext v
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      exact (IsPreimmersion.isEmbedding h).injective.eq_iff' hwy
    rw [← hpre]
    exact hyclosed.preimage h.continuous
  have : IsNormalDomain (X.presheaf.stalk z) :=
    ⟨IsRegularLocalRing.isDomain _, isIntegrallyClosed_of_isRegularLocalRing _⟩
  have key : ∀ J : (Spec (CommRingCat.of (X.presheaf.stalk z))).IdealSheafData,
      J = Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of (X.presheaf.stalk z))).inv.hom
          (IsLocalRing.maximalIdeal (X.presheaf.stalk z))) →
      ∀ v : blowUp J, IsClosed ({v} : Set (blowUp J)) →
        ringKrullDim ((blowUp J).presheaf.stalk v) = 2 := by
    intro J hJ v hvclosed
    subst hJ
    exact ringKrullDim_stalk_blowUp_maximalIdeal_eq_two_of_isClosed _ hdim v hvclosed
  exact (ringKrullDim_eq_of_ringEquiv e).trans (key _ hcomap w hwclosed)

/-- Every closed point of the blowup of a regular closed point of dimension two over a point
whose local ring is two-dimensional has a two-dimensional local ring. -/
public theorem ringKrullDim_stalk_blowUp_eq_two_of_isClosed {X : Scheme.{u}}
    (M : X.IdealSheafData) (z : X) (hz : IsClosed ({z} : Set X))
    (hM : M = Scheme.IdealSheafData.vanishingIdeal (⟨{z}, hz⟩ : Closeds X))
    (hreg : IsRegularLocalRing (X.presheaf.stalk z))
    (hdim : ringKrullDim (X.presheaf.stalk z) = 2)
    (y : blowUp M) (hyclosed : IsClosed ({y} : Set (blowUp M)))
    (hbase : ringKrullDim (X.presheaf.stalk (blowUpToBase M y)) = 2) :
    ringKrullDim ((blowUp M).presheaf.stalk y) = 2 := by
  by_cases hy : blowUpToBase M y = z
  · exact ringKrullDim_stalk_blowUp_eq_two_of_mapsTo M z hz hM hreg hdim y hy hyclosed
  have := isIso_stalkMap_blowUpToBase_of_ne M z hz hM y hy
  exact (ringKrullDim_eq_of_ringEquiv
    (asIso ((blowUpToBase M).stalkMap y)).commRingCatIsoToRingEquiv).symm.trans hbase

/-- Every point of the blowup of a regular closed point of dimension two whose image has a
regular local ring has a regular local ring. -/
public theorem isRegularLocalRing_stalk_blowUp_of_isRegularLocalRing_stalk_blowUpToBase
    {X : Scheme.{u}}
    (M : X.IdealSheafData) (z : X) (hz : IsClosed ({z} : Set X))
    (hM : M = Scheme.IdealSheafData.vanishingIdeal (⟨{z}, hz⟩ : Closeds X))
    (hreg : IsRegularLocalRing (X.presheaf.stalk z))
    (hdim : ringKrullDim (X.presheaf.stalk z) = 2)
    (y : blowUp M)
    (hbase : IsRegularLocalRing (X.presheaf.stalk (blowUpToBase M y))) :
    IsRegularLocalRing ((blowUp M).presheaf.stalk y) := by
  by_cases hy : blowUpToBase M y = z
  · exact isRegularLocalRing_stalk_blowUp_of_mapsTo M z hz hM hreg hdim y hy
  have := hbase
  have := isIso_stalkMap_blowUpToBase_of_ne M z hz hM y hy
  exact IsRegularLocalRing.of_ringEquiv
    (asIso ((blowUpToBase M).stalkMap y)).commRingCatIsoToRingEquiv

/-- The ideal sheaf contracted by a contraction is an effective Cartier divisor. -/
private theorem isEffectiveCartierDivisor_of_isContractionOfExceptionalCurve
    {X X' : Scheme.{u}} (D : X.IdealSheafData) (b : X ⟶ X')
    (hb : IsContractionOfExceptionalCurve D b) :
    Stacks.Divisors.IsEffectiveCartierDivisor D := by
  obtain ⟨z, hz, -, -, hD, e, he⟩ := hb.exists_blowUp_iso
  have : Flat e.hom := inferInstance
  have hD' : D = (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal
      (⟨{z}, hz⟩ : Closeds X'))).comap e.hom := by
    rw [hD, ← he, Scheme.IdealSheafData.comap_comp]
  rw [hD']
  exact Stacks.Divisors.isPullbackDefined_of_flat e.hom _ inferInstance

/-- The local ring of `X` at a point of a contracted exceptional curve is regular. -/
public theorem isRegularLocalRing_stalk_of_isContractionOfExceptionalCurve
    {X X' : Scheme.{u}} (D : X.IdealSheafData) (b : X ⟶ X')
    (hb : IsContractionOfExceptionalCurve D b) (x : D.subscheme) :
    IsRegularLocalRing (X.presheaf.stalk (D.subschemeι x)) := by
  obtain ⟨z, hz, hreg, hdim, hD, e, he⟩ := hb.exists_blowUp_iso
  have hbz : b (D.subschemeι x) = z :=
    IsContractionOfExceptionalCurve.eq_centre_of_mem_support hD (subschemeι_mem_support D x)
  have hy : blowUpToBase (Scheme.IdealSheafData.vanishingIdeal (⟨{z}, hz⟩ : Closeds X'))
      (e.hom (D.subschemeι x)) = z := by
    have hc := congrArg (fun q : X ⟶ X' => q (D.subschemeι x)) he
    change blowUpToBase _ (e.hom (D.subschemeι x)) = b (D.subschemeι x) at hc
    exact hc.trans hbz
  have := isRegularLocalRing_stalk_blowUp_of_mapsTo _ z hz rfl hreg hdim
    (e.hom (D.subschemeι x)) hy
  have : IsIso (e.hom.stalkMap (D.subschemeι x)) := inferInstance
  exact IsRegularLocalRing.of_ringEquiv
    (asIso (e.hom.stalkMap (D.subschemeι x))).commRingCatIsoToRingEquiv

/-- The ideal induced by a contracted exceptional curve in a local ring along it is principal,
generated by a non-unit. -/
public theorem exists_span_stalk_of_isContractionOfExceptionalCurve
    {X X' : Scheme.{u}} (D : X.IdealSheafData) (b : X ⟶ X')
    (hb : IsContractionOfExceptionalCurve D b) (x : D.subscheme) :
    ∃ t : X.presheaf.stalk (D.subschemeι x),
      IdealSheafData.stalk D (D.subschemeι x) = Ideal.span {t} ∧ ¬ IsUnit t := by
  obtain ⟨U, hU, hxU, f, -, hgen⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor D
      (isEffectiveCartierDivisor_of_isContractionOfExceptionalCurve D b hb) (D.subschemeι x)
  refine ⟨(X.presheaf.germ U (D.subschemeι x) hxU).hom f, ?_, fun ht => ?_⟩
  · rw [IdealSheafData.stalk_eq_map_germ D (D.subschemeι x) ⟨U, hU⟩ hxU, hgen, Ideal.map_span,
      Set.image_singleton]
  · have htop : IdealSheafData.stalk D (D.subschemeι x) = ⊤ := by
      rwa [IdealSheafData.stalk_eq_map_germ D (D.subschemeι x) ⟨U, hU⟩ hxU, hgen, Ideal.map_span,
        Set.image_singleton, Ideal.span_singleton_eq_top]
    exact (IdealSheafData.stalk_eq_top_iff_not_mem_support D (D.subschemeι x)).mp htop
      (subschemeι_mem_support D x)

/-- The ideal induced along the exceptional curve is the one generated by the maximal ideal of
the local ring at the centre. -/
public theorem idealSheafData_stalk_eq_map_maximalIdeal
    {X X' : Scheme.{u}} (D : X.IdealSheafData) (b : X ⟶ X')
    (z : X') (hz : IsClosed ({z} : Set X'))
    (hD : D = (Scheme.IdealSheafData.vanishingIdeal
      (⟨{z}, hz⟩ : TopologicalSpace.Closeds X')).comap b)
    (x : D.subscheme) :
    IdealSheafData.stalk D (D.subschemeι x) =
      (IsLocalRing.maximalIdeal (X'.presheaf.stalk (b (D.subschemeι x)))).map
        (b.stalkMap (D.subschemeι x)).hom := by
  have hbz : b (D.subschemeι x) = z :=
    IsContractionOfExceptionalCurve.eq_centre_of_mem_support hD (subschemeι_mem_support D x)
  have hcentre : IdealSheafData.stalk
      (Scheme.IdealSheafData.vanishingIdeal (⟨{z}, hz⟩ : Closeds X')) (b (D.subschemeι x)) =
      IsLocalRing.maximalIdeal (X'.presheaf.stalk (b (D.subschemeι x))) := by
    subst hbz
    exact IdealSheafData.stalk_vanishingIdeal_singleton _ hz
  have hrw : IdealSheafData.stalk D (D.subschemeι x) =
      IdealSheafData.stalk ((Scheme.IdealSheafData.vanishingIdeal
        (⟨{z}, hz⟩ : Closeds X')).comap b) (D.subschemeι x) :=
    congrArg (fun J : X.IdealSheafData => IdealSheafData.stalk J (D.subschemeι x)) hD
  rw [hrw, IdealSheafData.stalk_comap, hcentre]

/-- A subscheme presented as the projective line has topological Krull dimension one at each of
its points. -/
public theorem topologicalKrullDimAt_subscheme_eq_one_of_iso_projectiveLineProj
    {X : Scheme.{u}} (D : X.IdealSheafData) (k : Type u) [Field k]
    (e : projectiveLineProj k ≅ D.subscheme) (x : D.subscheme) :
    topologicalKrullDimAt D.subscheme x = 1 := by
  have : IrreducibleSpace (projectiveSpaceOverRing 1 (CommRingCat.of k)) :=
    irreducibleSpace_of_isIntegral _
  let ε : projectiveSpaceOverRing 1 (CommRingCat.of k) ≅ D.subscheme :=
    (Stacks.AlgebraicGeometry.ProjBaseChange.polynomialComparison k 1).iso ≪≫ e
  rw [topologicalKrullDimAt_eq_of_homeomorph ε.hom.homeomorph.symm x,
    ← topologicalKrullDim_eq_topologicalKrullDimAt_of_irreducible k _
      (projectiveSpaceOverRing 1 (CommRingCat.of k) ↘ Spec (CommRingCat.of k))
      (ε.hom.homeomorph.symm x),
    topologicalKrullDim_projectiveSpaceOverRing k 1]
  rfl

end AlgebraicGeometry

