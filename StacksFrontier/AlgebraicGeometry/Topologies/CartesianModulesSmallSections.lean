module

public import StacksFrontier.AlgebraicGeometry.Topologies.CartesianModulesOnAffineSite

/-!
# A cartesian module with small sections on an affine site with flat coverings is a sheaf

`Stacks.PresheafOfModules.isSheaf_of_cartesian_of_flat_covers` concludes the sheaf condition for
a presheaf of modules whose sections live in `Type (max m r v w)`, where `v` and `w` are the
universes of the objects and the morphisms of the site.  That is a real restriction: on the
small affine sites of a scheme the objects live one universe above the schemes while the
sections of the structure sheaf and of the modules of interest live in the universe of the
schemes itself, so the sections are *smaller* than the objects of the site and the existing
statement does not apply.

This file removes the restriction.  The sections may live in any `Type (max m r)`.

## Main results

* `Stacks.PresheafOfModules.isSheaf_of_cartesian_of_flat_covers'`: **a cartesian presheaf of
  modules with sections in `Type (max m r)` is a sheaf for a topology generated by finite flat
  covering families of affine schemes.**

## Implementation notes

The proof is that of `Stacks.PresheafOfModules.isSheaf_of_cartesian_of_flat_covers` with one
step replaced.  That proof passes between the sheaf condition for the `AddCommGrpCat`-valued
presheaf and the sheaf condition for its underlying presheaf of types with
`CategoryTheory.Presheaf.isSheaf_iff_isSheaf_comp`, whose hypothesis
`HasLimitsOfSize.{w, max w v} AddCommGrpCat.{max m r}` forces `max v w ≤ max m r`: abelian groups
in a universe below that of the site do not have limits indexed by the site.  Only the direction
from types to abelian groups is needed, and that direction is
`CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp`, which carries no size condition — the group
axioms are equations between sections, so the amalgamation of a compatible family of group
homomorphisms is again a group homomorphism.

Everything after that step is unchanged: the covering sieve is pulled back, the pullback family
is again a finite flat covering because flat coverings are stable under base change, and
`Stacks.PresheafOfModules.isSheafFor_of_cartesian_of_flat_cover` — which is already free of any
size condition — gives the sheaf axiom for it.

## References

* [Stacks Project, Tag 023M](https://stacks.math.columbia.edu/tag/023M)
* [Stacks Project, Tag 0H04](https://stacks.math.columbia.edu/tag/0H04)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u v r m w i

/-- Flatness of morphisms of schemes, named as a `MorphismProperty` so that the stability
instances of its precoverage can be located by instance search. -/
private abbrev flatProp : MorphismProperty Scheme.{u} := @AlgebraicGeometry.Flat

namespace Stacks.PresheafOfModules

/-- **A cartesian presheaf of modules is a sheaf for a topology generated by finite flat
covering families of affine schemes**, with no size condition relating the universe of the
sections to the universes of the site.  This is
`Stacks.PresheafOfModules.isSheaf_of_cartesian_of_flat_covers` with its sections in
`Type (max m r)` rather than in `Type (max m r v w)`. -/
theorem isSheaf_of_cartesian_of_flat_covers'
    {C : Type v} [Category.{w} C] [HasPullbacks C]
    (L : C ⥤ Scheme.{u}) [PreservesLimitsOfShape WalkingCospan L]
    (R : Cᵒᵖ ⥤ CommRingCat.{r})
    (hff : ∀ {U : C} (E : PreZeroHypercover.{i} U), Finite E.I₀ →
      (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U) →
      (RingHom.pi (fun k => (R.map (E.f k).op).hom)).FaithfullyFlat)
    (hpo : ∀ {X Y Z P : C} {fst : P ⟶ X} {snd : P ⟶ Y} {a : X ⟶ Z} {b : Y ⟶ Z},
      IsPullback fst snd a b →
      IsPushout (R.map a.op) (R.map b.op) (R.map fst.op) (R.map snd.op))
    (M : PresheafOfModules.{max m r} (R ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {X Y : Cᵒᵖ} (f : X ⟶ Y), IsIso (restrictionBaseChange.{v, w, r, m} M f))
    (J : Precoverage C)
    (hJ : ∀ {U : C} {P : Presieve U}, P ∈ J U →
      ∃ E : PreZeroHypercover.{i} U, P = E.presieve₀ ∧ Finite E.I₀ ∧
        (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U)) :
    Presheaf.IsSheaf J.toGrothendieck M.presheaf := by
  apply Presheaf.isSheaf_of_isSheaf_comp
    J.toGrothendieck M.presheaf (forget AddCommGrpCat.{max m r})
  rw [isSheaf_iff_isSheaf_of_type, Precoverage.isSheaf_toGrothendieck_iff]
  intro U V f P hP
  obtain ⟨E, rfl, hfin, hE⟩ := hJ hP
  let _ := hfin
  let K := (Scheme.precoverage @Flat).comap L
  let _ : K.IsStableUnderBaseChange :=
    inferInstanceAs (Precoverage.IsStableUnderBaseChange
      ((Scheme.precoverage flatProp.{u}).comap L))
  have he : E.presieve₀ ∈ K U := by
    show E.presieve₀.map L ∈ (Scheme.precoverage @Flat) (L.obj U)
    simpa only [PreZeroHypercover.presieve₀_map] using hE
  have he' : (E.pullback₂ f).presieve₀ ∈ K V :=
    K.mem_coverings_of_isPullback _ he _ _ _
      (fun i => (IsPullback.of_hasPullback (E.f i) f).flip)
  let _ : Finite (E.pullback₂ f).I₀ := hfin
  have h := isSheafFor_of_cartesian_of_flat_cover L R hff hpo M hM (E.pullback₂ f)
    (by simpa only [K, Precoverage.mem_comap_iff, PreZeroHypercover.presieve₀_map] using he')
  rwa [PreZeroHypercover.presieve₀_pullback₁, Presieve.isSheafFor_iff_generate,
    Sieve.pullbackArrows_comm] at h

end Stacks.PresheafOfModules

end
