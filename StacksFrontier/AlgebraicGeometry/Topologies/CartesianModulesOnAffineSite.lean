* [Stacks Project, Tag 0H04](https://stacks.math.columbia.edu/tag/0H04)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u v r m t w i

/-- Flatness of morphisms of schemes, named as a `MorphismProperty` so that the stability
instances of its precoverage can be located by instance search. -/
private abbrev AlgebraicGeometry.flatProperty : MorphismProperty Scheme.{u} :=
  @AlgebraicGeometry.Flat

namespace AlgebraicGeometry.Scheme

/-- **A finite flat covering of an affine scheme by affine schemes is faithfully flat on global
functions.**  The product map on global functions is flat because each component is, and it is
surjective on primes because the covering is surjective on points. -/
@[sga "3 VIB 11.9.1" "partial"]
theorem faithfullyFlat_pi_appTop {U : Scheme.{u}} [IsAffine U]
    {I : Type v} [Finite I] (V : I → Scheme.{u}) [∀ i, IsAffine (V i)]
    (f : ∀ i, V i ⟶ U) [∀ i, Flat (f i)]
    (hcover : ∀ x : U, ∃ i, ∃ y : V i, f i y = x) :
    (RingHom.pi (fun i => (f i).appTop.hom)).FaithfullyFlat := by
  apply RingHom.FaithfullyFlat.pi _ (fun i => (f i).flat_appTop)
  intro p
  obtain ⟨i, y, hy⟩ := hcover (U.isoSpec.inv p)
  refine ⟨i, (V i).isoSpec.hom y, ?_⟩
  show (Spec.map (f i).appTop) ((V i).isoSpec.hom y) = p
  show ((V i).isoSpec.hom ≫ Spec.map (f i).appTop) y = p
  rw [Scheme.isoSpec_hom_naturality]
  show U.isoSpec.hom (f i y) = p
  rw [hy]
  exact congrArg (fun k : Spec Γ(U, ⊤) ⟶ Spec Γ(U, ⊤) => k p) U.isoSpec.inv_hom_id

end AlgebraicGeometry.Scheme

namespace Stacks.Sites

/-- The presheaf of commutative rings of global regular functions of a functor to schemes, with
its sections raised to a larger universe. -/
def liftedSchemeRings {C : Type v} [Category.{w} C]
    (L : C ⥤ Scheme.{u}) : Cᵒᵖ ⥤ CommRingCat.{max u t} where
  obj X := CommRingCat.of (ULift.{t} (Γ(L.obj X.unop, ⊤)))
  map f := CommRingCat.ofHom ((L.map f.unop).appTop.hom.ulift)
  map_id X := by
    ext x
    simp
  map_comp f g := by
    ext x
    exact congrArg (fun k => (CommRingCat.Hom.hom (Scheme.Hom.appTop k)) x.down)
      (L.map_comp g.unop f.unop)

/-- A covering sieve for the topology generated by a precoverage all of whose coverings are
finite and flat over the schemes is refined by a single finite family which is a flat covering of
schemes. -/
theorem exists_finite_flat_refinement
    {C : Type v} [Category.{w} C] [HasPullbacks C]
    (L : C ⥤ Scheme.{u}) [PreservesLimitsOfShape WalkingCospan L]
    (P : Precoverage C)
    (hP : ∀ {U : C} (R : Presieve U), R ∈ P U →
      R.uncurry.Finite ∧ R.map L ∈ Scheme.precoverage @Flat (L.obj U))
    {U : C} (S : Sieve U) (hS : S ∈ P.toGrothendieck U) :
    ∃ E : PreZeroHypercover.{max v w} U, Finite E.I₀ ∧
      (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U) ∧ E.sieve₀ ≤ S := by
  have : Precoverage.HasIsos ((Scheme.precoverage (@Flat)).comap L) :=
    inferInstanceAs (Precoverage.HasIsos
      ((Scheme.precoverage AlgebraicGeometry.flatProperty.{u}).comap L))
  have : Precoverage.IsStableUnderBaseChange ((Scheme.precoverage (@Flat)).comap L) :=
    inferInstanceAs (Precoverage.IsStableUnderBaseChange
      ((Scheme.precoverage AlgebraicGeometry.flatProperty.{u}).comap L))
  have : Precoverage.IsStableUnderComposition ((Scheme.precoverage (@Flat)).comap L) :=
    inferInstanceAs (Precoverage.IsStableUnderComposition
      ((Scheme.precoverage AlgebraicGeometry.flatProperty.{u}).comap L))
  let K : Pretopology C := Pretopology.finite C ⊓
    ((Scheme.precoverage @Flat).comap L).toPretopology
  have hle : P.toGrothendieck ≤ K.toGrothendieck := by
    refine Precoverage.toGrothendieck_le_iff_le_toPrecoverage.mpr fun X R hR => ?_
    show Sieve.generate R ∈ K.toGrothendieck X
    exact ⟨R, hP R hR, Sieve.le_generate R⟩
  obtain ⟨R, hR, hRS⟩ := (Pretopology.mem_toGrothendieck K U S).mp (hle U hS)
  let E : PreZeroHypercover U :=
    { I₀ := R.uncurry, X := fun i => i.1.1, f := fun i => i.1.2 }
  have he : E.presieve₀ = R := by
    funext V f
    exact propext ⟨fun ⟨i⟩ => i.2, fun hf => Presieve.ofArrows.mk (⟨⟨V, f⟩, hf⟩ : R.uncurry)⟩
  refine ⟨E, hR.1.to_subtype, ?_, ?_⟩
  · rw [PreZeroHypercover.presieve₀_map, he]
    exact hR.2
  · show Sieve.generate E.presieve₀ ≤ S
    rw [he]
    exact (Sieve.generate_le_iff _ _).mpr hRS

/-- `Stacks.Sites.exists_finite_flat_refinement` on a slice of the site: a covering sieve of the
localized topology at an object is refined by a finite family which is a flat covering of the
schemes. -/
theorem exists_finite_flat_refinement_over
    {C : Type v} [Category.{w} C] [HasPullbacks C]
    (L : C ⥤ Scheme.{u}) [PreservesLimitsOfShape WalkingCospan L]
    (P : Precoverage C)
    (hP : ∀ {U : C} (R : Presieve U), R ∈ P U →
      R.uncurry.Finite ∧ R.map L ∈ Scheme.precoverage @Flat (L.obj U))
    (U : C) {V : Over U} (S : Sieve V) (hS : S ∈ P.toGrothendieck.over U V) :
    ∃ E : PreZeroHypercover.{max v w} V, Finite E.I₀ ∧
      (E.map (Over.forget U ⋙ L)).presieve₀ ∈ Scheme.precoverage @Flat (L.obj V.left) ∧
        E.sieve₀ ≤ S := by
  obtain ⟨E, hfin, hE, hES⟩ := exists_finite_flat_refinement L P hP
    (Sieve.overEquiv V S) hS
  let E' : PreZeroHypercover V :=
    { I₀ := E.I₀, X := fun i => Over.mk (E.f i ≫ V.hom),
      f := fun i => Over.homMk (E.f i) }
  refine ⟨E', hfin, hE, (Sieve.generate_le_iff _ _).mpr ?_⟩
  rintro W f ⟨i⟩
  rw [← (Sieve.overEquiv V).symm_apply_apply S]
  exact hES _ (Sieve.le_generate E.presieve₀ _ _ (Presieve.ofArrows.mk i))

/-- **A fibre product square of a site of affine schemes becomes a pushout square of the rings
of global regular functions.**  This is `AlgebraicGeometry.isPushout_appTop_of_isPullback`
applied to the image of the square under `L`, read through a presheaf of rings `R` identified
with the global functions of `L` by `hR`.  It is exactly the `hpo` hypothesis of
`Stacks.PresheafOfModules.isSheafFor_of_cartesian_of_flat_cover` and of the two sheaf statements
built on it. -/
theorem isPushout_schemeRings_of_isPullback
    {C : Type v} [Category.{w} C]
    (L : C ⥤ Scheme.{u}) [PreservesLimitsOfShape WalkingCospan L]
    [∀ X, IsAffine (L.obj X)]
    (R : Cᵒᵖ ⥤ CommRingCat.{u}) (hR : R = L.op ⋙ Scheme.Γ)
    {X Y Z P : C} {fst : P ⟶ X} {snd : P ⟶ Y} {a : X ⟶ Z} {b : Y ⟶ Z}
    (h : IsPullback fst snd a b) :
    IsPushout (R.map a.op) (R.map b.op) (R.map fst.op) (R.map snd.op) := by
  have key := isPushout_appTop_of_isPullback (Functor.map_isPullback L h)
  subst hR
  exact key

end Stacks.Sites

namespace Stacks.PresheafOfModules

/-- **A cartesian presheaf of modules satisfies the sheaf axiom for a finite family which is a
flat covering of affine schemes.**  The rings of sections form a faithfully flat family by
`AlgebraicGeometry.Scheme.faithfullyFlat_pi_appTop`, and the double overlaps are fibre products of
affine schemes, hence pushouts of rings. -/
theorem isSheafFor_of_affine_flat_cover
    {C : Type v} [Category.{w} C] [HasPullbacks C]
    (L : C ⥤ Scheme.{u}) [PreservesLimitsOfShape WalkingCospan L]
    [∀ X, IsAffine (L.obj X)]
    (R : Cᵒᵖ ⥤ CommRingCat.{max u t}) (hR : R = Stacks.Sites.liftedSchemeRings L)
    (M : PresheafOfModules.{max m u t} (R ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {X Y : Cᵒᵖ} (f : X ⟶ Y), IsIso (restrictionBaseChange.{v, w, max u t, m} M f))
    {U : C} (E : PreZeroHypercover U) [Finite E.I₀]
    (hE : (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U)) :
    Presieve.IsSheafFor (M.presheaf ⋙ forget AddCommGrpCat) E.presieve₀ := by
  classical
  obtain ⟨hcover, hflat⟩ := (Scheme.presieve₀_mem_precoverage_iff (E.map L)).mp hE
  have (i : E.I₀) : Flat (L.map (E.f i)) := hflat i
  refine isSheafFor_of_cartesian R M E.X E.f
    (fun i j => pullback (E.f i) (E.f j))
    (fun i j => pullback.fst (E.f i) (E.f j))
    (fun i j => pullback.snd (E.f i) (E.f j))
    (fun i j => pullback.condition) ?_ ?_ hM
  · rw [hR]
    exact RingHom.FaithfullyFlat.pi_ulift _ _
      (AlgebraicGeometry.Scheme.faithfullyFlat_pi_appTop (fun i => L.obj (E.X i))
        (fun i => L.map (E.f i)) hcover)
  · intro i j
    rw [hR]
    exact CommRingCat.isPushout_ulift (isPushout_appTop_of_isPullback
      (Functor.map_isPullback L (IsPullback.of_hasPullback (E.f i) (E.f j))))

/-- **A cartesian presheaf of modules is a sheaf for a topology generated by finite flat coverings
of affine schemes.** -/
theorem isSheaf_of_affine_flat_covers
    {C : Type v} [Category.{w} C] [HasPullbacks C]
    (L : C ⥤ Scheme.{u}) [PreservesLimitsOfShape WalkingCospan L]
    [∀ X, IsAffine (L.obj X)]
    (R : Cᵒᵖ ⥤ CommRingCat.{max u t}) (hR : R = Stacks.Sites.liftedSchemeRings L)
    (M : PresheafOfModules.{max m u t v w} (R ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {X Y : Cᵒᵖ} (f : X ⟶ Y),
      IsIso (restrictionBaseChange.{v, w, max u t, max m v w} M f))
    (J : Precoverage C)
    (hJ : ∀ {U : C} {P : Presieve U}, P ∈ J U →
      ∃ E : PreZeroHypercover U, P = E.presieve₀ ∧ Finite E.I₀ ∧
        (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U)) :
    Presheaf.IsSheaf J.toGrothendieck M.presheaf := by
  apply (Presheaf.isSheaf_iff_isSheaf_comp.{w, max m u t v w, max m u t v w,
    v, (max m u t v w) + 1, (max m u t v w) + 1}
    J.toGrothendieck M.presheaf (forget AddCommGrpCat.{max m u t v w})).mpr
  rw [isSheaf_iff_isSheaf_of_type, Precoverage.isSheaf_toGrothendieck_iff]
  intro U V f P hP
  obtain ⟨E, rfl, hfin, hE⟩ := hJ hP
  let K := (Scheme.precoverage @Flat).comap L
  have : K.IsStableUnderBaseChange :=
    inferInstanceAs (Precoverage.IsStableUnderBaseChange
      ((Scheme.precoverage AlgebraicGeometry.flatProperty.{u}).comap L))
  have he : E.presieve₀ ∈ K U := by
    show E.presieve₀.map L ∈ (Scheme.precoverage @Flat) (L.obj U)
    simpa only [PreZeroHypercover.presieve₀_map] using hE
  have he' : (E.pullback₂ f).presieve₀ ∈ K V :=
    K.mem_coverings_of_isPullback _ he _ _ _
      (fun i => (IsPullback.of_hasPullback (E.f i) f).flip)
  have : Finite (E.pullback₂ f).I₀ := hfin
  have h := isSheafFor_of_affine_flat_cover L R hR M hM (E.pullback₂ f)
    (by simpa only [K, Precoverage.mem_comap_iff, PreZeroHypercover.presieve₀_map] using he')
  rwa [PreZeroHypercover.presieve₀_pullback₁, Presieve.isSheafFor_iff_generate,
    Sieve.pullbackArrows_comm] at h

/-- **A cartesian presheaf of modules is a sheaf for a topology all of whose covering sieves are
refined by finite flat coverings of affine schemes.** -/
theorem isSheaf_of_affine_flat_refinements
    {C : Type v} [Category.{w} C] [HasPullbacks C]
    (L : C ⥤ Scheme.{u}) [PreservesLimitsOfShape WalkingCospan L]
    [∀ X, IsAffine (L.obj X)]
    (R : Cᵒᵖ ⥤ CommRingCat.{max u t}) (hR : R = Stacks.Sites.liftedSchemeRings L)
    (M : PresheafOfModules.{max m u t v w} (R ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {X Y : Cᵒᵖ} (f : X ⟶ Y),
      IsIso (restrictionBaseChange.{v, w, max u t, max m v w} M f))
    (J : GrothendieckTopology C)
    (hJ : ∀ {U : C} (S : Sieve U), S ∈ J U →
      ∃ E : PreZeroHypercover.{max v w} U, Finite E.I₀ ∧
        (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U) ∧ E.sieve₀ ≤ S) :
    Presheaf.IsSheaf J M.presheaf := by
  apply (Presheaf.isSheaf_iff_isSheaf_comp.{w, max m u t v w, max m u t v w,
    v, (max m u t v w) + 1, (max m u t v w) + 1}
    J M.presheaf (forget AddCommGrpCat.{max m u t v w})).mpr
  rw [isSheaf_iff_isSheaf_of_type]
  intro U S hS
  obtain ⟨E, hfin, hE, hES⟩ := hJ S hS
  apply Presieve.isSheafFor_subsieve _ hES
  intro V f
  let K := (Scheme.precoverage @Flat).comap L
  have : K.IsStableUnderBaseChange :=
    inferInstanceAs (Precoverage.IsStableUnderBaseChange
      ((Scheme.precoverage AlgebraicGeometry.flatProperty.{u}).comap L))
  have he : E.presieve₀ ∈ K U := by
    show E.presieve₀.map L ∈ (Scheme.precoverage @Flat) (L.obj U)
    simpa only [PreZeroHypercover.presieve₀_map] using hE
  have he' : (E.pullback₂ f).presieve₀ ∈ K V :=
    K.mem_coverings_of_isPullback _ he _ _ _
      (fun i => (IsPullback.of_hasPullback (E.f i) f).flip)
  have : Finite (E.pullback₂ f).I₀ := hfin
  have h := isSheafFor_of_affine_flat_cover L R hR M hM (E.pullback₂ f)
    (by simpa only [K, Precoverage.mem_comap_iff, PreZeroHypercover.presieve₀_map] using he')
  rwa [PreZeroHypercover.presieve₀_pullback₁, Presieve.isSheafFor_iff_generate,
    Sieve.pullbackArrows_comm] at h

/-! ### The same statements for an arbitrary presheaf of rings

The three statements above use the identification of `R` with
`Stacks.Sites.liftedSchemeRings L` only twice: to see that the product of the restriction maps
of a flat covering family is faithfully flat, and that a fibre product square of the site
becomes a pushout square of rings.  Taking those two facts as hypotheses makes the statements
available for any presheaf of rings on `C` — in particular for the global regular functions of
`L` with no universe lift, where the two facts are
`AlgebraicGeometry.Scheme.faithfullyFlat_pi_appTop` and
`AlgebraicGeometry.isPushout_appTop_of_isPullback` directly.  Affineness of the values of `L` is
then not needed either: it enters only through those two facts.

The second of the two is supplied for any such `R` by
`Stacks.Sites.isPushout_schemeRings_of_isPullback`, which takes the identification
`R = L.op ⋙ Scheme.Γ` as a hypothesis rather than fixing `R`, so that it serves a slice
`Over.forget U ⋙ L` of a site of affine schemes as well as the site itself.
-/

/-- **A cartesian presheaf of modules satisfies the sheaf axiom for a finite flat covering
family**, for any presheaf of rings whose restriction maps are faithfully flat along such a
family and which turns fibre product squares into pushout squares. -/
theorem isSheafFor_of_cartesian_of_flat_cover
    {C : Type v} [Category.{w} C] [HasPullbacks C]
    (L : C ⥤ Scheme.{u}) (R : Cᵒᵖ ⥤ CommRingCat.{r})
    (hff : ∀ {U : C} (E : PreZeroHypercover.{i} U), Finite E.I₀ →
      (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U) →
      (RingHom.pi (fun k => (R.map (E.f k).op).hom)).FaithfullyFlat)
    (hpo : ∀ {X Y Z P : C} {fst : P ⟶ X} {snd : P ⟶ Y} {a : X ⟶ Z} {b : Y ⟶ Z},
      IsPullback fst snd a b →
      IsPushout (R.map a.op) (R.map b.op) (R.map fst.op) (R.map snd.op))
    (M : PresheafOfModules.{max m r} (R ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {X Y : Cᵒᵖ} (f : X ⟶ Y), IsIso (restrictionBaseChange.{v, w, r, m} M f))
    {U : C} (E : PreZeroHypercover.{i} U) [Finite E.I₀]
    (hE : (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U)) :
    Presieve.IsSheafFor (M.presheaf ⋙ forget AddCommGrpCat) E.presieve₀ :=
  isSheafFor_of_cartesian R M E.X E.f
    (fun i j => pullback (E.f i) (E.f j))
    (fun i j => pullback.fst (E.f i) (E.f j))
    (fun i j => pullback.snd (E.f i) (E.f j))
    (fun _ _ => pullback.condition) (hff E inferInstance hE)
    (fun i j => hpo (IsPullback.of_hasPullback (E.f i) (E.f j))) hM

/-- **A cartesian presheaf of modules is a sheaf for a topology generated by finite flat covering
families**, for any presheaf of rings as in
`Stacks.PresheafOfModules.isSheafFor_of_cartesian_of_flat_cover`. -/
theorem isSheaf_of_cartesian_of_flat_covers
    {C : Type v} [Category.{w} C] [HasPullbacks C]
    (L : C ⥤ Scheme.{u}) [PreservesLimitsOfShape WalkingCospan L]
    (R : Cᵒᵖ ⥤ CommRingCat.{r})
    (hff : ∀ {U : C} (E : PreZeroHypercover.{i} U), Finite E.I₀ →
      (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U) →
      (RingHom.pi (fun k => (R.map (E.f k).op).hom)).FaithfullyFlat)
    (hpo : ∀ {X Y Z P : C} {fst : P ⟶ X} {snd : P ⟶ Y} {a : X ⟶ Z} {b : Y ⟶ Z},
      IsPullback fst snd a b →
      IsPushout (R.map a.op) (R.map b.op) (R.map fst.op) (R.map snd.op))
    (M : PresheafOfModules.{max m r v w} (R ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {X Y : Cᵒᵖ} (f : X ⟶ Y),
      IsIso (restrictionBaseChange.{v, w, r, max m v w} M f))
    (J : Precoverage C)
    (hJ : ∀ {U : C} {P : Presieve U}, P ∈ J U →
      ∃ E : PreZeroHypercover.{i} U, P = E.presieve₀ ∧ Finite E.I₀ ∧
        (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U)) :
    Presheaf.IsSheaf J.toGrothendieck M.presheaf := by
  apply (Presheaf.isSheaf_iff_isSheaf_comp.{w, max m r v w, max m r v w,
    v, (max m r v w) + 1, (max m r v w) + 1}
    J.toGrothendieck M.presheaf (forget AddCommGrpCat.{max m r v w})).mpr
  rw [isSheaf_iff_isSheaf_of_type, Precoverage.isSheaf_toGrothendieck_iff]
  intro U V f P hP
  obtain ⟨E, rfl, hfin, hE⟩ := hJ hP
  let K := (Scheme.precoverage @Flat).comap L
  have : K.IsStableUnderBaseChange :=
    inferInstanceAs (Precoverage.IsStableUnderBaseChange
      ((Scheme.precoverage AlgebraicGeometry.flatProperty.{u}).comap L))
  have he : E.presieve₀ ∈ K U := by
    show E.presieve₀.map L ∈ (Scheme.precoverage @Flat) (L.obj U)
    simpa only [PreZeroHypercover.presieve₀_map] using hE
  have he' : (E.pullback₂ f).presieve₀ ∈ K V :=
    K.mem_coverings_of_isPullback _ he _ _ _
      (fun i => (IsPullback.of_hasPullback (E.f i) f).flip)
  have : Finite (E.pullback₂ f).I₀ := hfin
  have h := isSheafFor_of_cartesian_of_flat_cover L R hff hpo M hM (E.pullback₂ f)
    (by simpa only [K, Precoverage.mem_comap_iff, PreZeroHypercover.presieve₀_map] using he')
  rwa [PreZeroHypercover.presieve₀_pullback₁, Presieve.isSheafFor_iff_generate,
    Sieve.pullbackArrows_comm] at h

/-- **A cartesian presheaf of modules is a sheaf for a topology all of whose covering sieves are
refined by finite flat covering families**, for any presheaf of rings as in
`Stacks.PresheafOfModules.isSheafFor_of_cartesian_of_flat_cover`. -/
theorem isSheaf_of_cartesian_of_flat_refinements
    {C : Type v} [Category.{w} C] [HasPullbacks C]
    (L : C ⥤ Scheme.{u}) [PreservesLimitsOfShape WalkingCospan L]
    (R : Cᵒᵖ ⥤ CommRingCat.{r})
    (hff : ∀ {U : C} (E : PreZeroHypercover.{max v w} U), Finite E.I₀ →
      (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U) →
      (RingHom.pi (fun k => (R.map (E.f k).op).hom)).FaithfullyFlat)
    (hpo : ∀ {X Y Z P : C} {fst : P ⟶ X} {snd : P ⟶ Y} {a : X ⟶ Z} {b : Y ⟶ Z},
      IsPullback fst snd a b →
      IsPushout (R.map a.op) (R.map b.op) (R.map fst.op) (R.map snd.op))
    (M : PresheafOfModules.{max m r v w} (R ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {X Y : Cᵒᵖ} (f : X ⟶ Y),
      IsIso (restrictionBaseChange.{v, w, r, max m v w} M f))
    (J : GrothendieckTopology C)
    (hJ : ∀ {U : C} (S : Sieve U), S ∈ J U →
      ∃ E : PreZeroHypercover.{max v w} U, Finite E.I₀ ∧
        (E.map L).presieve₀ ∈ Scheme.precoverage @Flat (L.obj U) ∧ E.sieve₀ ≤ S) :
    Presheaf.IsSheaf J M.presheaf := by
  apply (Presheaf.isSheaf_iff_isSheaf_comp.{w, max m r v w, max m r v w,
    v, (max m r v w) + 1, (max m r v w) + 1}
    J M.presheaf (forget AddCommGrpCat.{max m r v w})).mpr
  rw [isSheaf_iff_isSheaf_of_type]
  intro U S hS
  obtain ⟨E, hfin, hE, hES⟩ := hJ S hS
  apply Presieve.isSheafFor_subsieve _ hES
  intro V f
  let K := (Scheme.precoverage @Flat).comap L
  have : K.IsStableUnderBaseChange :=
    inferInstanceAs (Precoverage.IsStableUnderBaseChange
      ((Scheme.precoverage AlgebraicGeometry.flatProperty.{u}).comap L))
  have he : E.presieve₀ ∈ K U := by
    show E.presieve₀.map L ∈ (Scheme.precoverage @Flat) (L.obj U)
    simpa only [PreZeroHypercover.presieve₀_map] using hE
  have he' : (E.pullback₂ f).presieve₀ ∈ K V :=
    K.mem_coverings_of_isPullback _ he _ _ _
      (fun i => (IsPullback.of_hasPullback (E.f i) f).flip)
  have : Finite (E.pullback₂ f).I₀ := hfin
  have h := isSheafFor_of_cartesian_of_flat_cover L R hff hpo M hM (E.pullback₂ f)
    (by simpa only [K, Precoverage.mem_comap_iff, PreZeroHypercover.presieve₀_map] using he')
  rwa [PreZeroHypercover.presieve₀_pullback₁, Presieve.isSheafFor_iff_generate,
    Sieve.pullbackArrows_comm] at h

end Stacks.PresheafOfModules

