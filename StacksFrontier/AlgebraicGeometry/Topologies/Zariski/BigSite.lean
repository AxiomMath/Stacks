module

public import Mathlib.AlgebraicGeometry.Cover.Open
public import Mathlib.AlgebraicGeometry.Sites.BigZariski
public import StacksFrontier.AlgebraicGeometry.Size.Cutoff
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale
public import StacksFrontier.CategoryTheory.Sites.Pretopology.CombinatorialEquivalence
public import StacksFrontier.CategoryTheory.Sites.Pretopology.SmallSubsite
public import StacksCore.Tactic.StacksAttribute

/-!
# The big Zariski site

A big Zariski site is obtained by cutting the category of schemes down at a sufficiently large
cardinal and then choosing, among the Zariski covering families of that cutoff category, a
set-sized system which satisfies the site axioms, contains prescribed covering families, and
represents every Zariski covering up to combinatorial equivalence.

Both choices are genuine data: a cardinal cutoff large enough to be closed under the
constructions one wants, and a bound on the index types of the admitted covering families.
Retaining the families themselves — rather than only the Grothendieck topology they generate —
is what lets the site axioms be stated about those families, which is how the source presents
the site.

Every Zariski covering of an object of a big Zariski site is tautologically equivalent to one
of the site's own covering families, so nothing is lost by restricting to them.

## Main definitions

* `AlgebraicGeometry.IsZariskiCovering` — a covering family of a cutoff category is Zariski
  when its image in schemes lies in Mathlib's Zariski pretopology.
* `AlgebraicGeometry.BigZariskiSite` — all the choices and properties of a big Zariski site.
* `AlgebraicGeometry.BigZariskiSite.grothendieckTopology` — the topology generated by the
  chosen covering families.

## Main results

* `AlgebraicGeometry.BigZariskiSite.generate_mem_grothendieckTopology` — every chosen covering
  family covers for the associated Grothendieck topology.
* `AlgebraicGeometry.BigZariskiSite.exists_isCovering_tautologicallyEquivalent_openCover` —
  every Zariski covering of an object of the site is tautologically equivalent to one of the
  site's covering families.

## Implementation notes

The cutoff category is the size-bounded full subcategory `AlgebraicGeometry.SchemeBelow`,
the full subcategory of schemes `X` with `X.size < κ`; the cardinal closure hypotheses needed to
make it closed under the relevant constructions are retained as fields of `BigZariskiSite`.
`IsZariskiCovering` reuses Mathlib's Zariski pretopology rather than redefining Zariski
coverings. The `coveringCardinal` and `coveringOrdinal` fields are the output of the
set-sized-covering construction.

For use with Mathlib's sheaf API, `grothendieckTopology` is the Grothendieck topology generated
by exactly the chosen families, and `generate_mem_grothendieckTopology` is the bridge from the
family-level presentation to it.

In the tautological-equivalence statement the given Zariski covering is an
`AlgebraicGeometry.Scheme.OpenCover`, whose sources need not satisfy the site's size bound; the
chosen internal family is therefore mapped along the site's inclusion before the two families
are compared.

## References

* [Stacks Project, Tag 020S](https://stacks.math.columbia.edu/tag/020S)
* [Stacks Project, Tag 03WV](https://stacks.math.columbia.edu/tag/03WV)
-/

@[expose] public section

open Cardinal CategoryTheory

universe u v

namespace AlgebraicGeometry

/-- A covering family in a cutoff category of schemes is Zariski if its image in schemes
belongs to Mathlib's Zariski pretopology. -/
public def IsZariskiCovering {κ : Cardinal.{u}}
    (𝒰 : Covering.{u + 1, u, u + 1} (AlgebraicGeometry.SchemeBelow κ)) : Prop :=
  (𝒰.2.map (AlgebraicGeometry.schemeBelowInclusion κ)).presieve₀ ∈
    Scheme.zariskiPretopology 𝒰.1.1

/-- **Stacks 020S.** A big Zariski site consists of an initial set of schemes and initial
Zariski covering families, a sufficiently large cutoff category containing those schemes,
and a bounded set of Zariski covering families.

The last two fields say that the selected families satisfy the site axioms and that every
Zariski covering family has a combinatorially equivalent selected representative. -/
@[stacks 020S]
public structure BigZariskiSite where
  /-- The initially chosen set `S₀` of schemes. -/
  initialSchemes : Set Scheme.{u}
  /-- The initial collection is set-sized at the universe of the underlying scheme data. -/
  initialSchemes_small : Small.{u} initialSchemes
  /-- The cardinal defining the cutoff category. -/
  schemeCardinal : Cardinal.{u}
  /-- The cutoff cardinal is uncountable. -/
  aleph0_lt_schemeCardinal : ℵ₀ < schemeCardinal
  /-- The cutoff cardinal is a strong limit cardinal. -/
  schemeCardinal_isStrongPrelimit : Cardinal.IsStrongPrelimit schemeCardinal
  /-- The cutoff cardinal has uncountable cofinality. -/
  aleph0_lt_schemeCardinal_cof : ℵ₀ < schemeCardinal.ord.cof
  /-- Every initially chosen scheme belongs to the cutoff category. -/
  initialSchemes_size_lt : ∀ S ∈ initialSchemes, S.size < schemeCardinal
  /-- The initially chosen Zariski covering families `Cov₀`. -/
  initialCoverings :
    Set (Covering (AlgebraicGeometry.SchemeBelow schemeCardinal))
  /-- The initial collection of covering families is set-sized. -/
  initialCoverings_small : Small.{u + 1} initialCoverings
  /-- Every object occurring in an initial covering family belongs to `S₀`. -/
  initialCoverings_among_initialSchemes : ∀ 𝒰 ∈ initialCoverings,
    𝒰.1.1 ∈ initialSchemes ∧ ∀ i, (𝒰.2.X i).1 ∈ initialSchemes
  /-- The cardinal bounding the index types of the selected covering families. -/
  coveringCardinal : Cardinal.{u + 1}
  /-- The limit ordinal occurring in the set-sized covering construction. -/
  coveringOrdinal : Ordinal.{u + 1}
  /-- The ordinal used for the covering construction is a successor limit. -/
  coveringOrdinal_isSuccLimit : Order.IsSuccLimit coveringOrdinal
  /-- The selected bounded covering families contain all initially chosen families. -/
  initialCoverings_mem : ∀ 𝒰 ∈ initialCoverings,
    CovBounded (IsZariskiCovering (κ := schemeCardinal)) coveringCardinal 𝒰
  /-- The selected bounded Zariski families satisfy the site axioms. -/
  coverings_isSite :
    IsSite (C := AlgebraicGeometry.SchemeBelow schemeCardinal)
      (CovBounded (IsZariskiCovering (κ := schemeCardinal)) coveringCardinal)
  /-- Every Zariski covering has a combinatorially equivalent selected representative. -/
  covering_representative :
    ∀ 𝒰 : Covering (AlgebraicGeometry.SchemeBelow schemeCardinal),
      IsZariskiCovering 𝒰 →
      ∃ 𝒰' : Covering (AlgebraicGeometry.SchemeBelow schemeCardinal),
        CovBounded (IsZariskiCovering (κ := schemeCardinal)) coveringCardinal 𝒰' ∧
          Covering.CombEquiv 𝒰 𝒰'

namespace BigZariskiSite

/-- The underlying cutoff category of a big Zariski site. -/
public abbrev Schemes (𝒮 : BigZariskiSite.{u}) :=
  AlgebraicGeometry.SchemeBelow 𝒮.schemeCardinal

/-- The inclusion of the underlying cutoff category into all schemes. -/
public abbrev inclusion (𝒮 : BigZariskiSite.{u}) : 𝒮.Schemes ⥤ Scheme.{u} :=
  AlgebraicGeometry.schemeBelowInclusion 𝒮.schemeCardinal

/-- A scheme is contained in a big Zariski site when it lies below its size cutoff. -/
public abbrev Contains (𝒮 : BigZariskiSite.{u}) (X : Scheme.{u}) : Prop :=
  X.size < 𝒮.schemeCardinal

/-- The distinguished covering families of a big Zariski site. -/
public abbrev IsCovering (𝒮 : BigZariskiSite.{u}) : Covering 𝒮.Schemes → Prop :=
  CovBounded (IsZariskiCovering (κ := 𝒮.schemeCardinal)) 𝒮.coveringCardinal

/-- The precoverage consisting of the distinguished covering families of a big Zariski site. -/
public def precoverage (𝒮 : BigZariskiSite.{u}) : Precoverage 𝒮.Schemes := ⟨fun X =>
  { R | ∃ E : PreZeroHypercover X, 𝒮.IsCovering ⟨X, E⟩ ∧ R = E.presieve₀ }⟩

/-- The Grothendieck topology generated by the distinguished covering families. -/
public def grothendieckTopology (𝒮 : BigZariskiSite.{u}) :
    GrothendieckTopology 𝒮.Schemes :=
  𝒮.precoverage.toGrothendieck

/-- Each distinguished covering family generates a covering sieve for the associated
Grothendieck topology. -/
public lemma generate_mem_grothendieckTopology (𝒮 : BigZariskiSite.{u})
    (𝒰 : Covering 𝒮.Schemes) (h𝒰 : 𝒮.IsCovering 𝒰) :
    Sieve.generate 𝒰.2.presieve₀ ∈ 𝒮.grothendieckTopology 𝒰.1 :=
  𝒮.precoverage.generate_mem_toGrothendieck ⟨𝒰.2, h𝒰, rfl⟩

/-- **Stacks Project, Tag 03WV.** Every Zariski covering of an object of a big Zariski site
is tautologically equivalent to a covering belonging to that site. -/
@[stacks 03WV]
public theorem exists_isCovering_tautologicallyEquivalent_openCover
    (B : BigZariskiSite.{u}) (T : B.Schemes)
    (U : (B.inclusion.obj T).OpenCover.{v}) :
    ∃ V : PreZeroHypercover.{u + 1} T,
      B.IsCovering ⟨T, V⟩ ∧
        PreZeroHypercover.TautologicallyEquivalent U.toPreZeroHypercover
          (V.map B.inclusion) := by
  let S := U.toPreZeroHypercover.shrink
  have hS_open (i : S.I₀) : IsOpenImmersion (S.f i) := U.mem₀.2 i.2
  let E : PreZeroHypercover.{u + 1} T :=
    { I₀ := S.I₀
      X := fun i ↦
        ⟨S.X i, Scheme.size_lt_of_isOpenImmersion (S.f i) T.2⟩
      f := fun i ↦ ⟨S.f i⟩ }
  have hE : IsZariskiCovering ⟨T, E⟩ := by
    show S.presieve₀ ∈ _
    rw [PreZeroHypercover.presieve₀_shrink]
    exact U.mem_pretopology
  obtain ⟨⟨T', V⟩, hV, hT, hcomb⟩ := B.covering_representative ⟨T, E⟩ hE
  cases hT
  change E.CombinatoriallyEquivalent V at hcomb
  refine ⟨V, hV, ?_⟩
  apply PreZeroHypercover.tautologicallyEquivalent_trans _ S _
  · refine ⟨⟨U.toPreZeroHypercover.toShrink.s₀, fun i ↦ ?_⟩,
      U.toPreZeroHypercover.fromShrink.s₀, fun i ↦ ?_⟩
    · exact ⟨Iso.refl _, U.toPreZeroHypercover.toShrink.w₀ i⟩
    · exact ⟨eqToIso (Presieve.ofArrows_surj _ _ i.2).choose_spec.1.symm,
        U.toPreZeroHypercover.fromShrink.w₀ i⟩
  · rcases hcomb with ⟨⟨a, ha, hfa⟩, b, hb, hfb⟩
    refine ⟨⟨a, fun i ↦ ?_⟩, b, fun j ↦ ?_⟩
    · have hi : S.X i = (V.X (a i)).obj := congrArg ObjectProperty.FullSubcategory.obj (ha i)
      refine ⟨eqToIso hi, ?_⟩
      show eqToHom hi ≫ (V.f (a i)).hom = S.f i
      simpa [E, hi] using (congrArg InducedCategory.Hom.hom (hfa i)).symm
    · have hj : (V.X j).obj = S.X (b j) := congrArg ObjectProperty.FullSubcategory.obj (hb j)
      refine ⟨eqToIso hj, ?_⟩
      show eqToHom hj ≫ S.f (b j) = (V.f j).hom
      simpa [E, hj] using (congrArg InducedCategory.Hom.hom (hfb j)).symm

end BigZariskiSite

end AlgebraicGeometry
