module

public import StacksFrontier.AlgebraicGeometry.Topologies.AssociatedModulePresentationEssImage

/-!
# Descent, Lemma 0GN7 for a globally presented source, over an arbitrary base

Let `S` be a scheme and let a site `C` of schemes over `S` satisfy the four conditions of
Tag 03OJ.  Descent, Lemma 0GN7 asserts that `F ↦ Fᵃ` is fully faithful on quasi-coherent modules.
This file proves it, over a base `S` which is **not** assumed affine, for a source which is the
cokernel of a morphism of free modules on `S` and an arbitrary quasi-coherent target.

That is exactly the case the gluing step of Tag 03OJ consumes: the local modules it glues are
the cokernels of morphisms of free modules that the globally presented case produces, and the
transitions of the descent datum are morphisms out of their pullbacks, which are again such
cokernels.

## Main results

* `Stacks.Sites.bijective_siteAssociatedModuleMap_cokernel`: for `φ : ⊕_{L'} 𝒪_S ⟶ ⊕_L 𝒪_S` and a
  quasi-coherent `N`, the map `χ ↦ χᵃ` from `coker φ ⟶ N` to the morphisms of sheaves of
  `𝒪`-modules `coker(φ)ᵃ ⟶ Nᵃ` is bijective.
* `Stacks.Sites.bijective_associatedModuleMap_cokernel`: the same at the level of presheaves of
  modules.
* `Stacks.Sites.exists_cokernel_iso_of_isColimit`: the globally presented case of the third
  assertion of Tag 03OJ, with the witness exhibited as a cokernel of a morphism of free modules.

## Implementation notes

The injectivity is `Stacks.Sites.associatedModuleMap_injective_of_epi_free`, the pullback of the
projection onto the cokernel to the final object being an epimorphism out of a free module.  The
surjectivity runs through the free case: composing a given `a : coker(φ)ᵃ ⟶ Nᵃ` with `πᵃ` gives a
morphism out of `(⊕_L 𝒪_S)ᵃ`, which is `ψᵃ` by
`Stacks.Sites.surjective_siteAssociatedModuleMap_free`; then `(φ ≫ ψ)ᵃ = 0`, so `φ ≫ ψ = 0` by
the injectivity for the free source `⊕_{L'} 𝒪_S`, and `ψ` descends to `χ : coker φ ⟶ N`.  The
equation `χᵃ = a` is checked after composing with `πᵃ`, which is an epimorphism of **sheaves** of
modules because step two (`Stacks.Sites.isIso_cokernelAssociatedComparison`) identifies it with
the projection onto the cokernel of `φᵃ`.  It is not an epimorphism of presheaves of modules,
global sections not being right exact, which is why the bijection is proved for sheaves first.

## References

* [Stacks Project, Tag 0GN7](https://stacks.math.columbia.edu/tag/0GN7)
* [Stacks Project, Tag 03OJ](https://stacks.math.columbia.edu/tag/03OJ)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace Stacks.Sites

open _root_.AlgebraicGeometry

attribute [local instance] CategoryTheory.hasWeakSheafify_addCommGrpCat_of_essentiallySmall
  CategoryTheory.wEqualsLocallyBijective_addCommGrpCat_of_essentiallySmall
  CategoryTheory.hasSheafify_addCommGrpCat_of_essentiallySmall

variable (S : Scheme.{u}) {C : Type (u + 1)} [Category.{u} C] [EssentiallySmall.{u} C]
  (toOver : C ⥤ Over S) (K : Precoverage C) [toOver.Full] [toOver.Faithful]
  (hR : Presheaf.IsSheaf K.toGrothendieck (structurePresheaf S toOver))
  (e : C) [IsIso (toOver.obj e).hom]

/-- The inverse of an isomorphism is an epimorphism, stated with the category instance left
free, so that it applies to an isomorphism of `AlgebraicGeometry.Scheme.Modules` read in
`SheafOfModules`. -/
public theorem epi_iso_inv {D : Type*} [Category D] {X Y : D} (i : X ≅ Y) : Epi i.inv :=
  inferInstance

/-- **The pullback of the projection onto a cokernel of free modules is an epimorphism out of a
free module.**  Pullback is a left adjoint, so it carries the epimorphism `⊕_L 𝒪 ⟶ coker φ` to
an epimorphism, and it carries a free module to a free module. -/
public theorem epi_pullbackFreeIso_inv_comp_cokernelπ {T : Scheme.{u}} (g : T ⟶ S) {L L' : Type u}
    (φ : SheafOfModules.free (R := S.ringCatSheaf) L' ⟶
      SheafOfModules.free (R := S.ringCatSheaf) L) :
    Epi ((Scheme.Modules.pullbackFreeIso g L).inv ≫
      (Scheme.Modules.pullback g).map (cokernel.π (C := S.Modules) φ)) := by
  have : (Scheme.Modules.pullback g).IsLeftAdjoint :=
    (Scheme.Modules.pullbackPushforwardAdjunction g).isLeftAdjoint
  have : (Scheme.Modules.pullback g).PreservesEpimorphisms :=
    Functor.preservesEpimorphisms_of_isLeftAdjoint _
  have : Epi (cokernel.π (C := S.Modules) φ) := coequalizer.π_epi
  exact @epi_comp _ _ _ _ _ _ (epi_iso_inv (Scheme.Modules.pullbackFreeIso g L)) _
    ((Scheme.Modules.pullback g).map_epi _)

/-- **The pullback along `g` of a cokernel of free modules is generated by global sections**: it
admits an epimorphism from a free module.  This is the hypothesis of the injectivity half of
Descent, Lemma 0GN7 over an arbitrary base. -/
public theorem exists_epi_free_pullback_cokernel {T : Scheme.{u}} (g : T ⟶ S) {L L' : Type u}
    (φ : SheafOfModules.free (R := S.ringCatSheaf) L' ⟶
      SheafOfModules.free (R := S.ringCatSheaf) L) :
    ∃ π : SheafOfModules.free (R := T.ringCatSheaf) L ⟶
      (Scheme.Modules.pullback g).obj (cokernel (C := S.Modules) φ), Epi π :=
  ⟨_, epi_pullbackFreeIso_inv_comp_cokernelπ S g φ⟩

/-- **The pullback of a free module is generated by global sections**: it admits an
epimorphism from a free module, namely the inverse of
`AlgebraicGeometry.Scheme.Modules.pullbackFreeIso`. -/
public theorem exists_epi_free_pullback_free {T : Scheme.{u}} (g : T ⟶ S) (L : Type u) :
    ∃ π : SheafOfModules.free (R := T.ringCatSheaf) L ⟶
      (Scheme.Modules.pullback g).obj (SheafOfModules.free (R := S.ringCatSheaf) L), Epi π :=
  ⟨_, epi_iso_inv (Scheme.Modules.pullbackFreeIso g L)⟩

variable {L L' : Type u}
  (φ : SheafOfModules.free (R := S.ringCatSheaf) L' ⟶
      SheafOfModules.free (R := S.ringCatSheaf) L)
  {N : S.Modules} [N.IsQuasicoherent]

omit [EssentiallySmall.{u} C] [toOver.Full] [toOver.Faithful] in
include e in
/-- **The injectivity half of Descent, Lemma 0GN7 for a cokernel of free modules, over an
arbitrary base**, at the level of presheaves of modules. -/
public theorem associatedModuleMap_injective_cokernel :
    Function.Injective fun χ : cokernel (C := S.Modules) φ ⟶ N =>
      associatedModuleMap S toOver χ := by
  obtain ⟨π, hπ⟩ := exists_epi_free_pullback_cokernel S (toOver.obj e).hom φ
  exact associatedModuleMap_injective_of_epi_free S toOver e π

variable (hL : Presheaf.IsSheaf K.toGrothendieck
    (associatedPresheaf S (SheafOfModules.free (R := S.ringCatSheaf) L) toOver))
  (hL' : Presheaf.IsSheaf K.toGrothendieck
    (associatedPresheaf S (SheafOfModules.free (R := S.ringCatSheaf) L') toOver))
  (hC : Presheaf.IsSheaf K.toGrothendieck
    (associatedPresheaf S (cokernel (C := S.Modules) φ) toOver))
  (hN : Presheaf.IsSheaf K.toGrothendieck (associatedPresheaf S N toOver))

omit [toOver.Full] [toOver.Faithful] in
include hL' in
/-- **The associated module of the projection onto a cokernel of free modules is an epimorphism
of sheaves of modules.**  By step two of Tag 03OJ
(`Stacks.Sites.isIso_cokernelAssociatedComparison`) it is the projection onto the cokernel of
`φᵃ` followed by an isomorphism. -/
public theorem epi_siteAssociatedModuleMap_cokernelπ
    (hZariski : ∀ (T : C) (R : Presieve ((toOver.obj T).left)),
      R ∈ Scheme.zariskiPrecoverage.{u} ((toOver.obj T).left) →
        ∃ Q : Presieve T, Q ∈ K T ∧
          Presieve.map (toOver ⋙ Over.forget S) Q ≤ (Sieve.generate R).arrows) :
    Epi (siteAssociatedModuleMap S toOver K hR (cokernel.π (C := S.Modules) φ) hL hC) := by
  have := isIso_cokernelAssociatedComparison S toOver K hR φ hL' hL hC hZariski
  rw [← cokernelAssociatedComparison_π S toOver K hR φ hL' hL hC]
  exact epi_comp _ _

omit [EssentiallySmall.{u} C] [toOver.Full] [toOver.Faithful] in
include e in
/-- **A morphism out of a free module whose associated module factors through the associated
module of the projection onto a cokernel factors through that projection.**  The composite with
`φ` has associated module zero, and the injectivity half of Descent, Lemma 0GN7 for the free
source `⊕_{L'} 𝒪_S` makes it zero. -/
public theorem exists_cokernelπ_comp_eq_of_associatedModuleMap
    (ψ : SheafOfModules.free (R := S.ringCatSheaf) L ⟶ N)
    (a : associatedModulePresheaf S (cokernel (C := S.Modules) φ) toOver ⟶
      associatedModulePresheaf S N toOver)
    (hval : associatedModuleMap S toOver ψ =
      associatedModuleMap S toOver (cokernel.π (C := S.Modules) φ) ≫ a) :
    ∃ χ : cokernel (C := S.Modules) φ ⟶ N, cokernel.π (C := S.Modules) φ ≫ χ = ψ := by
  refine ⟨cokernel.desc (C := S.Modules) φ ψ ?_, cokernel.π_desc (C := S.Modules) _ _ _⟩
  obtain ⟨π₀, hπ₀⟩ := exists_epi_free_pullback_free S (toOver.obj e).hom L'
  refine associatedModuleMap_injective_of_epi_free S toOver (N := N) e π₀ ?_
  exact (associatedModuleMap_comp S toOver φ ψ).trans <|
    (congrArg (associatedModuleMap S toOver φ ≫ ·) hval).trans <|
    (Category.assoc _ _ _).symm.trans <|
    (congrArg (· ≫ a) (associatedModuleMap_comp_cokernelπ S toOver φ)).trans <|
    zero_comp.trans (associatedModuleMap_zero S toOver).symm

include e hL hL' in
/-- **Descent, Lemma 0GN7 for a source which is a cokernel of free modules, over an arbitrary
base.**  On a site of schemes over `S` satisfying the four conditions of Tag 03OJ, for
`φ : ⊕_{L'} 𝒪_S ⟶ ⊕_L 𝒪_S` and a quasi-coherent module `N` on `S`, every morphism of sheaves of
`𝒪`-modules `coker(φ)ᵃ ⟶ Nᵃ` is `χᵃ` for a unique `χ : coker φ ⟶ N`. -/
public theorem bijective_siteAssociatedModuleMap_cokernel
    (hZariski : ∀ (T : C) (R : Presieve ((toOver.obj T).left)),
      R ∈ Scheme.zariskiPrecoverage.{u} ((toOver.obj T).left) →
        ∃ Q : Presieve T, Q ∈ K T ∧
          Presieve.map (toOver ⋙ Over.forget S) Q ≤ (Sieve.generate R).arrows) :
    Function.Bijective fun χ : cokernel (C := S.Modules) φ ⟶ N =>
      siteAssociatedModuleMap S toOver K hR χ hC hN := by
  refine ⟨fun χ χ' h => associatedModuleMap_injective_cokernel S toOver e φ
    (congrArg SheafOfModules.Hom.val h), fun a => ?_⟩
  obtain ⟨ψ, hψ⟩ := surjective_siteAssociatedModuleMap_free S toOver K L hR hL e hN hZariski
    (siteAssociatedModuleMap S toOver K hR (cokernel.π (C := S.Modules) φ) hL hC ≫ a)
  obtain ⟨χ, hχ⟩ := exists_cokernelπ_comp_eq_of_associatedModuleMap S toOver e φ ψ a.val
    (congrArg SheafOfModules.Hom.val hψ)
  refine ⟨χ, ?_⟩
  have := epi_siteAssociatedModuleMap_cokernelπ S toOver K hR φ hL hL' hC hZariski
  refine (cancel_epi (siteAssociatedModuleMap S toOver K hR (cokernel.π (C := S.Modules) φ)
    hL hC)).1 ?_
  refine Eq.trans ?_ hψ
  refine SheafOfModules.hom_ext ?_
  exact (associatedModuleMap_comp S toOver (cokernel.π (C := S.Modules) φ) χ).symm.trans
    (congrArg (associatedModuleMap S toOver) hχ)

include e hR hL hL' hC hN in
/-- **Descent, Lemma 0GN7 for a source which is a cokernel of free modules, over an arbitrary
base, at the level of presheaves of modules.**  A morphism of sheaves of modules is a morphism of
the underlying presheaves of modules, so this is
`Stacks.Sites.bijective_siteAssociatedModuleMap_cokernel` with the sheaf wrapper removed. -/
public theorem bijective_associatedModuleMap_cokernel
    (hZariski : ∀ (T : C) (R : Presieve ((toOver.obj T).left)),
      R ∈ Scheme.zariskiPrecoverage.{u} ((toOver.obj T).left) →
        ∃ Q : Presieve T, Q ∈ K T ∧
          Presieve.map (toOver ⋙ Over.forget S) Q ≤ (Sieve.generate R).arrows) :
    Function.Bijective fun χ : cokernel (C := S.Modules) φ ⟶ N =>
      associatedModuleMap S toOver χ := by
  refine ⟨associatedModuleMap_injective_cokernel S toOver e φ, fun a => ?_⟩
  obtain ⟨χ, hχ⟩ := (bijective_siteAssociatedModuleMap_cokernel S toOver K hR e φ hL hL' hC hN
    hZariski).2 ⟨a⟩
  exact ⟨χ, congrArg SheafOfModules.Hom.val hχ⟩

end Stacks.Sites

end
