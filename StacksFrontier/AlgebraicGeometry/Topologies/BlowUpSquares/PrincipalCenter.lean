/-!
# An almost blowup square with a principal centre

Let `A` be a commutative ring, `f ∈ A`, and `J ⊆ A` a finitely generated ideal annihilated by a
power of `f`. Then the closed immersion `Spec (A ⧸ J) ⟶ Spec A`, with the centre cut out by `f`,
is an almost blowup square.

The content is a computation of the blowup. Over the single affine chart of a principal centre
the Rees algebra collapses: the affine blowup algebra `A[(f)/f]` is just the image of `A` in the
localization `A_f`, so the blowup of `Spec A` in `(f)` is the closed subscheme cut out by the
kernel of `A ⟶ A_f`, that is by the `f`-power torsion. On the other side, the ideal of sections
of the structure sheaf of `Spec (A ⧸ J)` supported on the inverse image of the centre is the
`f`-power torsion of `A ⧸ J`, which pushes forward to the same ideal because `J` itself is killed
by a power of `f`. The two closed subschemes therefore agree over `Spec A`.

## Main definitions

There are no new definitions.

## Main results

* `IsLocalization.Away.algebraMap_eq_zero_iff`: an element dies in a localization away from `a`
  exactly when a power of `a` annihilates it.
* `RingHom.ker_comp_algebraMap_away`: localizing away from `a` before or after a ring map whose
  kernel is annihilated by a power of `a` gives the same kernel.
* `affineBlowupAlgebra_span_singleton_eq_range`, `affineBlowupAlgebra_map_surjective` and
  `affineBlowupAlgebra_map_ker`: the affine blowup algebra of a principal ideal at a generator is
  the image of the ring in the localization away from that generator.
* `AlgebraicGeometry.reesDegreeOne_dvd_of_mem_span_singleton`: divisibility in the local Rees
  algebra of degree-one elements coming from a principal ideal.
* `AlgebraicGeometry.supportedSectionsIdeal_ideal_top_eq_ker`: on an affine scheme whose ideal
  sheaf is generated by `t`, the ideal of sections supported on the closed subscheme is the kernel
  of the localization away from `t`.
* `AlgebraicGeometry.isClosedImmersion_of_chart` and
  `AlgebraicGeometry.ker_eq_ofIdealTop_of_chart`: a morphism onto an affine base which has an
  affine chart given by `Spec` of a surjective ring map is the closed immersion cut out by the
  kernel of that map.
* `AlgebraicGeometry.isAlmostBlowUpSquare_quotient_of_pow_mul_eq_zero`: the almost blowup square
  attached to `f` and `J`.

## Implementation notes

That the single chart `Spec A[(f)/f] ⟶ blowUp I` is surjective comes from the chart cover of the
blowup over an affine open: every chart of a degree-one element of a principal ideal factors
through the chart at the generator, because the corresponding degree-one Rees elements divide one
another.

The comparison of the two closed subschemes of `Spec A` is made through their kernels as ideal
sheaves, which on an affine scheme are determined by their ideal of global sections; both are
computed to be the kernel of the localization away from the image of `f`.

## References

* [Stacks Project, Tag 0EVG](https://stacks.math.columbia.edu/tag/0EVG)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

universe u

namespace IsLocalization.Away

/-- An element of a ring dies in a localization away from `a` exactly when it is annihilated by a
power of `a`. -/
public theorem algebraMap_eq_zero_iff {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] (a : R)
    [IsLocalization.Away a S] (x : R) :
    algebraMap R S x = 0 ↔ ∃ n : ℕ, a ^ n * x = 0 := by
  rw [IsLocalization.map_eq_zero_iff (Submonoid.powers a)]
  exact ⟨fun ⟨⟨_, n, hn⟩, h⟩ ↦ ⟨n, by simpa only [show a ^ n = _ from hn] using h⟩,
    fun ⟨n, hn⟩ ↦ ⟨⟨a ^ n, n, rfl⟩, hn⟩⟩
end IsLocalization.Away

/-- For a ring map whose kernel is annihilated by a power of `a`, localizing away from `a` before
or after that map gives the same kernel over the source. -/
public theorem RingHom.ker_comp_algebraMap_away {R S A B : Type*} [CommRing R] [CommRing S]
    [CommRing A] [CommRing B] [Algebra R A] [Algebra S B] (φ : R →+* S) (a : R)
    [IsLocalization.Away a A] [IsLocalization.Away (φ a) B] (N : ℕ)
    (hker : ∀ x ∈ RingHom.ker φ, a ^ N * x = 0) :
    RingHom.ker ((algebraMap S B).comp φ) = RingHom.ker (algebraMap R A) := by
  ext x
  rw [RingHom.mem_ker, RingHom.mem_ker, RingHom.comp_apply,
    IsLocalization.Away.algebraMap_eq_zero_iff (φ a), IsLocalization.Away.algebraMap_eq_zero_iff a]
  constructor
  · rintro ⟨n, hn⟩
    refine ⟨n + N, ?_⟩
    rw [pow_add]
    calc a ^ n * a ^ N * x = a ^ N * (a ^ n * x) := by ring
      _ = 0 := hker _ (by rwa [RingHom.mem_ker, map_mul, map_pow])
  · rintro ⟨n, hn⟩
    exact ⟨n, by simpa only [map_mul, map_pow, map_zero] using congrArg φ hn⟩

/-- The affine blowup algebra of a principal ideal at its generator is the image of the ring in
the localization away from that generator: every fraction `y/a` with `y ∈ (a)` is already
there. -/
public theorem affineBlowupAlgebra_span_singleton_eq_range {R : Type u} [CommRing R] (a : R) :
    affineBlowupAlgebra (Ideal.span {a}) a (Localization.Away a) =
      (Algebra.ofId R (Localization.Away a)).range := by
  refine le_antisymm (Algebra.adjoin_le ?_) fun z hz ↦ ?_
  · rintro z ⟨y, hy, rfl⟩
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    refine (AlgHom.mem_range (Algebra.ofId R (Localization.Away a))).2 ⟨r, ?_⟩
    rw [Algebra.ofId_apply, Algebra.algebraMap_eq_smul_one, ← Algebra.algebraMap_eq_smul_one,
      eq_comm, IsLocalization.mk'_eq_iff_eq_mul, map_mul]
  · obtain ⟨r, rfl⟩ := (AlgHom.mem_range (Algebra.ofId R (Localization.Away a))).1 hz
    exact (affineBlowupAlgebra (Ideal.span {a}) a (Localization.Away a)).algebraMap_mem r

/-- For a principal ideal, the structure map into its affine blowup algebra at a generator is
surjective. -/
public theorem affineBlowupAlgebra_map_surjective {R : Type u} [CommRing R] (I : Ideal R) (a : R)
    (hI : I = Ideal.span {a}) :
    Function.Surjective (algebraMap R (affineBlowupAlgebra I a (Localization.Away a))) := by
  subst hI
  intro z
  have hz : (z : Localization.Away a) ∈ (Algebra.ofId R (Localization.Away a)).range :=
    (affineBlowupAlgebra_span_singleton_eq_range a).le z.property
  obtain ⟨r, hr⟩ := (AlgHom.mem_range (Algebra.ofId R (Localization.Away a))).mp hz
  refine ⟨r, Subtype.ext ?_⟩
  change algebraMap R (Localization.Away a) r = (z : Localization.Away a)
  simpa only [Algebra.ofId_apply] using hr

/-- For a principal ideal, the structure map into its affine blowup algebra at a generator has the
same kernel as the localization away from that generator. -/
public theorem affineBlowupAlgebra_map_ker {R : Type u} [CommRing R] (I : Ideal R) (a : R)
    (hI : I = Ideal.span {a}) :
    RingHom.ker (algebraMap R (affineBlowupAlgebra I a (Localization.Away a))) =
      RingHom.ker (algebraMap R (Localization.Away a)) := by
  subst hI
  ext x
  rw [RingHom.mem_ker, RingHom.mem_ker,
    show (algebraMap R (affineBlowupAlgebra (Ideal.span {a}) a (Localization.Away a))) x = 0 ↔
      ((algebraMap R (affineBlowupAlgebra (Ideal.span {a}) a (Localization.Away a))) x :
        Localization.Away a) = 0 from ⟨fun h ↦ congrArg Subtype.val h, fun h ↦ Subtype.ext h⟩]
  rfl

namespace AlgebraicGeometry

/-- In the Rees algebra of local sections, the degree-one element attached to a generator of a
principal ideal divides the degree-one element attached to any member of that ideal. -/
public theorem reesDegreeOne_dvd_of_mem_span_singleton {X : Scheme.{u}} (I : X.IdealSheafData)
    (U : X.affineOpens) (a x : I.ideal U)
    (hx : (x : Γ(X, U.1)) ∈ Ideal.span {(a : Γ(X, U.1))}) :
    (reesDegreeOne I U a).1 ∣ (reesDegreeOne I U x).1 := by
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hx
  refine ⟨(reesSituation I).sectionRingBaseMap U.1 r, ?_⟩
  dsimp only [reesDegreeOne]
  rw [mul_comm]
  refine Eq.trans ?_ (Stacks.RelativeProj.Situation.sectionRingBaseMap_mul_of
    (reesSituation I) U.1 1
    (show (reesSituation I).base.ringCatSheaf.obj.obj (op U.1) from r) _).symm
  refine congrArg (DirectSum.of ((reesSituation I).sectionPieces U.1) 1) ?_
  apply ((reesAlgebraData I).pieceEquiv 1 (by omega) U).injective
  apply Subtype.ext
  rw [(reesAlgebraData I).pieceEquiv_smul,
    ((reesAlgebraData I).pieceEquiv 1 (by omega) U).apply_symm_apply,
    ((reesAlgebraData I).pieceEquiv 1 (by omega) U).apply_symm_apply]
  exact hr.symm

/-- On an affine scheme whose ideal sheaf is generated over the whole space by `t`, the ideal of
global sections supported on the closed subscheme is the kernel of the localization away
from `t`. -/
public theorem supportedSectionsIdeal_ideal_top_eq_ker {Y : Scheme.{u}} [IsAffine Y]
    (K : Y.IdealSheafData) (t : Γ(Y, ⊤))
    (ht : K.ideal ⟨⊤, isAffineOpen_top Y⟩ = Ideal.span {t}) :
    (supportedSectionsIdeal (K.support : Set Y)).ideal ⟨⊤, isAffineOpen_top Y⟩ =
      RingHom.ker (algebraMap Γ(Y, ⊤) (Localization.Away t)) := by
  let U : Y.affineOpens := ⟨⊤, isAffineOpen_top Y⟩
  let F : Y.Modules := SheafOfModules.unit Y.ringCatSheaf
  let W : Y.Opens := Y.basicOpen t
  have hWU : W ≤ U.1 := Y.basicOpen_le t
  have hZeq (x : Y) (hx : x ∈ U.1) : x ∈ K.support ↔ x ∉ W := by
    rw [K.mem_support_iff_of_mem (U := U) hx, ht, Scheme.zeroLocus_span]
    simp [W, Scheme.mem_zeroLocus_iff]
  have hZc : IsRetrocompact ((K.support : Set Y))ᶜ := by
    have hsupp : ((K.support : Set Y))ᶜ = (W : Set Y) := by
      ext y
      simpa using (hZeq y (Set.mem_univ y)).not
    rw [hsupp]
    exact isRetrocompact_basicOpen t
  have hloc : IsLocalization.Away t Γ(Y, W) := (isAffineOpen_top Y).isLocalization_basicOpen t
  ext s
  rw [supportedSectionsIdeal_ideal (K.support : Set Y) K.support.isClosed hZc U, RingHom.mem_ker,
    IsLocalization.Away.algebraMap_eq_zero_iff t s]
  have hgerm : (∀ (x : Y) (hx : x ∈ U.1), x ∉ (K.support : Set Y) →
        TopCat.Presheaf.germ F.presheaf U.1 x hx s = 0) ↔
      F.presheaf.map (homOfLE hWU).op s = 0 := by
    rw [section_map_eq_zero_iff_germs F U.1 W hWU s]
    constructor
    · intro hs x hx
      exact hs x (hWU hx) fun hmem ↦ (hZeq x (hWU hx)).1 (SetLike.mem_coe.mp hmem) hx
    · intro hs x hx hxZ
      refine hs x ?_
      by_contra hn
      exact hxZ (SetLike.mem_coe.mpr ((hZeq x hx).2 hn))
  exact (Scheme.Modules.mem_supportedSectionsSubmodule_iff (K.support : Set Y) F U.1 s).trans
    (hgerm.trans (IsLocalization.Away.algebraMap_eq_zero_iff (S := Γ(Y, W)) t s))

end AlgebraicGeometry

namespace AlgebraicGeometry

/-- On an affine scheme, taking global sections of `Spec` of a ring map `ψ` out of the global
sections, composed with the identification of the scheme with the spectrum of its global
sections, returns `ψ`. -/
public theorem ΓSpecIso_hom_comp_appTop_fromSpec {X : Scheme.{u}} (hU : IsAffineOpen (⊤ : X.Opens))
    {C : Type u} [CommRing C] (ψ : Γ(X, ⊤) →+* C) :
    (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom.comp
      ((Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec).appTop).hom = ψ := by
  have hfrom : (hU.fromSpec.appTop).hom =
      (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, ⊤)))).inv.hom := by
    have hpre : hU.fromSpec ⁻¹ᵁ (⊤ : X.Opens) = ⊤ := hU.fromSpec_preimage_self
    have hAppLE : hU.fromSpec.appLE (⊤ : X.Opens) ⊤ (by simp [hpre]) =
        (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, ⊤)))).inv := by
      simp only [Scheme.Hom.appLE, hU.fromSpec_app_self, Category.assoc, ← Functor.map_comp]
      simp
      rfl
    exact congrArg CommRingCat.Hom.hom
      (by simpa [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, hpre] using hAppLE)
  rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, ← RingHom.comp_assoc]
  have hn : (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom.comp
      (Spec.map (CommRingCat.ofHom ψ)).appTop.hom =
      ψ.comp (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, ⊤)))).hom.hom :=
    congrArg CommRingCat.Hom.hom (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom ψ))
  rw [hn, hfrom, RingHom.comp_assoc]
  have hright : (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, ⊤)))).hom.hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, ⊤)))).inv.hom = RingHom.id _ := by
    simpa only [CommRingCat.hom_comp, CommRingCat.hom_id] using congrArg CommRingCat.Hom.hom
      (Iso.inv_hom_id (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, ⊤)))))
  rw [hright, RingHom.comp_id]

/-- A scheme isomorphic to the spectrum of a ring is affine. -/
public theorem isAffine_of_chart_isIso {W : Scheme.{u}} {C : Type u} [CommRing C]
    (c : Spec (CommRingCat.of C) ⟶ W) [IsIso c] : IsAffine W := IsAffine.of_isIso (inv c)

section Chart

variable {X W : Scheme.{u}} [IsAffine X] (hU : IsAffineOpen (⊤ : X.Opens))
  {C : Type u} [CommRing C] (ψ : Γ(X, ⊤) →+* C) (p : W ⟶ X)
  (c : Spec (CommRingCat.of C) ⟶ W) [IsIso c]
  (hc : c ≫ p = Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)


omit [IsAffine X] [IsIso c] in
include hc in
/-- The global-sections map of a morphism with an affine chart, read through the chart. -/
public theorem appTop_comp_eq_of_chart :
    (c.appTop).hom.comp (p.appTop).hom =
      ((Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec).appTop).hom := by
  rw [← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop, hc]

omit [IsAffine X] in
/-- The global-sections map of an affine chart is injective. -/
public theorem injective_appTop_of_chart_isIso : Function.Injective (c.appTop).hom := by
  have : IsIso c.appTop := by
    change IsIso (c.app ⊤)
    infer_instance
  exact (ConcreteCategory.bijective_of_isIso c.appTop).1

/-- Reading a global section through the chart returns the ring map defining the chart. -/
private theorem ΓSpecIso_appTop_comp_apply_of_chart {X W : Scheme.{u}}
    (hU : IsAffineOpen (⊤ : X.Opens)) {C : Type u} [CommRing C] (ψ : Γ(X, ⊤) →+* C) (p : W ⟶ X)
    (c : Spec (CommRingCat.of C) ⟶ W) (hc : c ≫ p = Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)
    (x : Γ(X, ⊤)) :
    (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom ((c.appTop).hom ((p.appTop).hom x)) = ψ x := by
  rw [← RingHom.comp_apply, ← RingHom.comp_apply, RingHom.comp_assoc,
    appTop_comp_eq_of_chart hU ψ p c hc, ΓSpecIso_hom_comp_appTop_fromSpec hU ψ]

omit [IsAffine X] in
include hc in
/-- The kernel of the global-sections map of a morphism with an affine chart given by `Spec` of a
ring map is the kernel of that ring map. -/
public theorem ker_appTop_eq_of_chart : RingHom.ker (p.appTop).hom = RingHom.ker ψ := by
  ext x
  rw [RingHom.mem_ker, RingHom.mem_ker, ← ΓSpecIso_appTop_comp_apply_of_chart hU ψ p c hc,
    map_eq_zero_iff _ (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso _).hom).1,
    map_eq_zero_iff _ (injective_appTop_of_chart_isIso c)]

include hc in
/-- If the chart is `Spec` of a surjective ring map, the morphism is a closed immersion. -/
public theorem isClosedImmersion_of_chart (hψ : Function.Surjective ψ) : IsClosedImmersion p := by
  have hW : IsAffine W := isAffine_of_chart_isIso c
  refine IsClosedImmersion.of_surjective_of_isAffine _ fun y ↦ ?_
  obtain ⟨x, hx⟩ := hψ ((Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom ((c.appTop).hom y))
  refine ⟨x, injective_appTop_of_chart_isIso c ?_⟩
  apply (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of C)).hom).1
  rw [ΓSpecIso_appTop_comp_apply_of_chart hU ψ p c hc]
  exact hx

include hc in
/-- The kernel of a morphism with an affine chart over an affine base is the ideal sheaf
associated to the kernel of the ring map defining the chart. -/
public theorem ker_eq_ofIdealTop_of_chart [IsClosedImmersion p] :
    p.ker = Scheme.IdealSheafData.ofIdealTop (RingHom.ker ψ) := by
  apply Scheme.IdealSheafData.ext_of_isAffine
  rw [Scheme.Hom.ker_apply p ⟨⊤, hU⟩, Scheme.IdealSheafData.ofIdealTop_ideal]
  simp only [homOfLE_refl, op_id, CategoryTheory.Functor.map_id, CommRingCat.hom_id,
    Ideal.map_id]
  exact ker_appTop_eq_of_chart hU ψ p c hc

end Chart

/-- **Stacks Project, Tag 0EVG.** For a finitely generated ideal `J` of `A` annihilated by a power
of `f`, the closed immersion `Spec (A ⧸ J) ⟶ Spec A` is the modification of an almost blowup
square whose centre is the closed subscheme cut out by `f`. -/
@[stacks 0EVG]
public theorem isAlmostBlowUpSquare_quotient_of_pow_mul_eq_zero (A : Type u) [CommRing A]
    (f : A) (J : Ideal A) (hJ : J.FG) (h : ∃ n : ℕ, ∀ x ∈ J, f ^ n * x = 0) :
    IsAlmostBlowUpSquare
      (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom (Ideal.span {f})))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) := by
  classical
  let b := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))
  have hbimm : IsClosedImmersion b :=
    IsClosedImmersion.spec_of_quotient_mk (R := CommRingCat.of A) J
  have hb : FinitePresentation b := by
    refine ⟨?_, inferInstance, inferInstance⟩
    rw [LocallyOfFinitePresentation.SpecMap_iff]
    exact RingHom.FinitePresentation.of_surjective _ Ideal.Quotient.mk_surjective
      (by simpa using hJ)
  let X := Spec (CommRingCat.of A)
  let I : X.IdealSheafData := Scheme.IdealSheafData.ofIdealTop
    (Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom (Ideal.span {f}))
  have hIfg : ∀ V : X.affineOpens, (I.ideal V).FG := by
    intro V
    rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    simp only [Ideal.map_span, Set.image_singleton]
    exact Submodule.fg_span (Set.finite_singleton _)
  have hIprin : Stacks.Divisors.IsLocallyPrincipal I := by
    intro x
    refine ⟨⟨⊤, isAffineOpen_top _⟩, Set.mem_univ x, ?_⟩
    rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    simp only [Ideal.map_span, Set.image_singleton]
    exact ⟨⟨(Scheme.ΓSpecIso (.of A)).inv.hom f, by simp⟩⟩
  refine ⟨(Stacks.Flatness.finitePresentation_subschemeι_iff I).mpr hIfg,
    Stacks.Divisors.isLocallyPrincipal_comap b I hIprin, ?_, hb, ?_⟩
  · have : IsFinite b := inferInstance
    infer_instance
  · let U : X.affineOpens := ⟨⊤, isAffineOpen_top X⟩
    let a : I.ideal U := ⟨(Scheme.ΓSpecIso (.of A)).inv.hom f, by
      simpa [I, U, Scheme.IdealSheafData.ofIdealTop_ideal] using
        Ideal.mem_map_of_mem ((Scheme.ΓSpecIso (.of A)).inv.hom)
          (Ideal.mem_span_singleton_self f)⟩
    have hIideal : I.ideal U = Ideal.span {(a : Γ(X, U.1))} := by
      ext x
      simp [I, a, U, Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span]
    let grading := (reesSituation I).sectionRingGrading U.1
    let := (reesSituation I).sectionRingGradedRing U.1
    let := (reesSituation I).sectionRingGradingGradedRing U.1
    let d (x : I.ideal U) := reesDegreeOne I U x
    let chartAt (x : I.ideal U) :=
      (Proj.basicOpen grading (d x).1).ι ≫
        Stacks.RelativeProj.Situation.relativeProjChart (reesSituation I) U
    let chart := (affineBlowupStandardOpenIso I U a).hom ≫ chartAt a
    have hfactor (x : I.ideal U) :
        chartAt x = (Proj grading).homOfLE
          (Proj.basicOpen_mono grading (d a).1 (d x).1
            (reesDegreeOne_dvd_of_mem_span_singleton I U a x (by
              rw [← hIideal]
              exact x.property))) ≫ chartAt a := by
      dsimp only [chartAt, d]
      rw [← Category.assoc, Scheme.homOfLE_ι]
    have hchartAt : Set.range (chartAt a) ⊆ Set.range chart := by
      rintro z ⟨y, rfl⟩
      refine ⟨(affineBlowupStandardOpenIso I U a).inv.base y, ?_⟩
      change (chartAt a).base
          ((affineBlowupStandardOpenIso I U a).hom.base
            ((affineBlowupStandardOpenIso I U a).inv.base y)) = (chartAt a).base y
      simp
    have hsub (x : I.ideal U) : Set.range (chartAt x) ⊆ Set.range chart := by
      rw [hfactor]
      rintro z ⟨y, rfl⟩
      exact hchartAt ⟨_, rfl⟩
    have hcover := blownUpAffine_chart_cover I U
    have hsurj : Function.Surjective chart := by
      intro z
      have hz : z ∈ ⋃ x : I.ideal U, Set.range (chartAt x) := by
        rw [hcover]
        exact show z ∈ (blowUpToBase I ⁻¹ᵁ U.1).1 by simp [U]
      obtain ⟨x, y, rfl⟩ := Set.mem_iUnion.mp hz
      exact hsub x ⟨y, rfl⟩
    have hchartOpen : IsOpenImmersion chart := by
      have hUimm : IsOpenImmersion U.1.ι := by
        dsimp only [U]
        infer_instance
      dsimp only [chart, chartAt]
      have : IsOpenImmersion
          (Stacks.RelativeProj.Situation.relativeProjChart (reesSituation I) U) :=
        MorphismProperty.of_isPullback
          (Stacks.RelativeProj.Situation.relativeProjChart_isPullback
            (reesSituation I) U).flip hUimm
      infer_instance
    have hchartIso : IsIso chart :=
      (isIso_iff_isOpenImmersion_and_surjective chart).2 ⟨hchartOpen, ⟨hsurj⟩⟩
    -- the exceptional ideal on the quotient
    let Y := Spec (CommRingCat.of (A ⧸ J))
    let V : Y.affineOpens := ⟨⊤, isAffineOpen_top Y⟩
    let K : Y.IdealSheafData := I.comap b
    let a0 : Γ(X, ⊤) := (a : Γ(X, U.1))
    let t : Γ(Y, ⊤) := b.appTop.hom a0
    have hKideal : K.ideal V = Ideal.span {t} := by
      rw [Stacks.IdealSheaf.ideal_comap_top_of_isAffine I b, hIideal, Ideal.map_span]
      simp only [Set.image_singleton]
      rfl
    let L : Y.IdealSheafData := supportedSectionsIdeal (K.support : Set Y)
    have hLker : L.ideal V = RingHom.ker (algebraMap Γ(Y, ⊤) (Localization.Away t)) :=
      supportedSectionsIdeal_ideal_top_eq_ker K t hKideal
    let φ : Γ(X, ⊤) →+* Γ(Y, ⊤) := b.appTop.hom
    have hφ : Function.Surjective φ :=
      (IsClosedImmersion.isAffine_surjective_of_isAffine b).2
    let eA : Γ(X, ⊤) ≃+* A := (Scheme.ΓSpecIso (.of A)).commRingCatIsoToRingEquiv
    let eB : Γ(Y, ⊤) ≃+* A ⧸ J := (Scheme.ΓSpecIso (.of (A ⧸ J))).commRingCatIsoToRingEquiv
    have ha : eA a0 = f := by
      change (Scheme.ΓSpecIso (.of A)).hom.hom ((Scheme.ΓSpecIso (.of A)).inv.hom f) = f
      exact (Scheme.ΓSpecIso (.of A)).commRingCatIsoToRingEquiv.apply_symm_apply f
    have hnat (x : Γ(X, ⊤)) : eB (φ x) = Ideal.Quotient.mk J (eA x) := by
      change (Scheme.ΓSpecIso (.of (A ⧸ J))).hom.hom (b.appTop.hom x) =
        Ideal.Quotient.mk J ((Scheme.ΓSpecIso (.of A)).hom.hom x)
      exact congrArg (fun g : CommRingCat.Hom _ _ => g.hom x)
        (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (Ideal.Quotient.mk J)))
    obtain ⟨N, hN⟩ := h
    have hnilpotent : ∀ x ∈ RingHom.ker φ, a0 ^ N * x = 0 := by
      intro x hx
      have hxJ : eA x ∈ J := Ideal.Quotient.eq_zero_iff_mem.mp (by
        rw [← hnat x, RingHom.mem_ker.mp hx, map_zero])
      apply eA.injective
      rw [map_mul, map_pow, ha, hN _ hxJ, map_zero]
    have hkerAway : RingHom.ker ((algebraMap Γ(Y, ⊤) (Localization.Away (φ a0))).comp φ) =
        RingHom.ker (algebraMap Γ(X, ⊤) (Localization.Away a0)) :=
      RingHom.ker_comp_algebraMap_away φ a0 N hnilpotent
    have hLmapIdeal : (L.map b).ideal U =
        RingHom.ker (algebraMap Γ(X, ⊤) (Localization.Away a0)) := by
      rw [Scheme.IdealSheafData.ideal_map_of_isAffineHom]
      change (L.ideal V).comap φ = RingHom.ker (algebraMap Γ(X, ⊤) (Localization.Away a0))
      rw [hLker, RingHom.comap_ker]
      exact hkerAway
    let T : X.IdealSheafData := Scheme.IdealSheafData.ofIdealTop
      (RingHom.ker (algebraMap Γ(X, ⊤) (Localization.Away a0)))
    have hLmap : L.map b = T := by
      apply Scheme.IdealSheafData.ext_of_isAffine
      simpa [T, Scheme.IdealSheafData.ofIdealTop_ideal] using hLmapIdeal
    let C := affineBlowupAlgebra (I.ideal U) (a : Γ(X, U.1))
      (Localization.Away (a : Γ(X, U.1)))
    let ψ : Γ(X, ⊤) →+* C := algebraMap _ _
    have hUaff : IsAffineOpen (⊤ : X.Opens) := isAffineOpen_top X
    have hbase : chart ≫ blowUpToBase I =
        Spec.map (CommRingCat.ofHom ψ) ≫ hUaff.fromSpec := by
      let e := affineBlowupStandardOpenIso I U a
      let p := (Proj.basicOpen grading (d a).1).ι
      let c := Stacks.RelativeProj.Situation.relativeProjChart (reesSituation I) U
      let q := Stacks.RelativeProj.Situation.projInclusionToOpen (reesSituation I) U.1 U.2
      change ((e.hom ≫ p) ≫ c) ≫ blowUpToBase I = _
      have hpull : c ≫ blowUpToBase I = q ≫ U.1.ι :=
        (Stacks.RelativeProj.Situation.relativeProjChart_isPullback (reesSituation I) U).w
      have hover := affineBlowupStandardOpenIso_over I U a
      have hover' : (e.hom ≫ p) ≫ q =
          Spec.map (CommRingCat.ofHom (algebraMap (Γ(X, U.1)) C)) ≫ U.2.isoSpec.inv := by
        simpa only [e, p, q, Category.assoc, C] using hover
      calc
        ((e.hom ≫ p) ≫ c) ≫ blowUpToBase I =
            (e.hom ≫ p) ≫ (c ≫ blowUpToBase I) := Category.assoc _ _ _
        _ = (e.hom ≫ p) ≫ (q ≫ U.1.ι) := by rw [hpull]
        _ = ((e.hom ≫ p) ≫ q) ≫ U.1.ι := (Category.assoc _ _ _).symm
        _ = (Spec.map (CommRingCat.ofHom ψ) ≫ U.2.isoSpec.inv) ≫ U.1.ι := by rw [hover']
        _ = Spec.map (CommRingCat.ofHom ψ) ≫ U.2.isoSpec.inv ≫ U.1.ι := Category.assoc _ _ _
    have hψsurj : Function.Surjective ψ :=
      affineBlowupAlgebra_map_surjective (I.ideal U) (a : Γ(X, U.1)) hIideal
    have hciso : IsIso chart := hchartIso
    have hbaseImm : IsClosedImmersion (blowUpToBase I) :=
      isClosedImmersion_of_chart hUaff ψ (blowUpToBase I) chart hbase hψsurj
    have hi2ker : (blowUpToBase I).ker = T := by
      rw [ker_eq_ofIdealTop_of_chart hUaff ψ (blowUpToBase I) chart hbase]
      exact congrArg Scheme.IdealSheafData.ofIdealTop
        (affineBlowupAlgebra_map_ker (I.ideal U) (a : Γ(X, U.1)) hIideal)
    let i1 : L.subscheme ⟶ X := L.subschemeι ≫ b
    have hi1ker : i1.ker = T := by
      change (L.subschemeι ≫ b).ker = T
      rw [Scheme.Hom.ker_comp, L.ker_subschemeι, hLmap]
    have hi1imm : IsClosedImmersion i1 := by
      change IsClosedImmersion (L.subschemeι ≫ b)
      infer_instance
    let isoSub : L.subscheme ⟶ blowUp I :=
      IsClosedImmersion.lift (blowUpToBase I) i1 (hi2ker.le.trans hi1ker.symm.le)
    have hisoSub : IsIso isoSub :=
      IsClosedImmersion.isIso_of_ker_eq i1 (blowUpToBase I) isoSub
        (IsClosedImmersion.lift_fac _ _ _) (hi1ker.trans hi2ker.symm)
    have hfac : isoSub ≫ blowUpToBase I = i1 := IsClosedImmersion.lift_fac _ _ _
    exact ⟨Over.isoMk (asIso isoSub) hfac⟩

end AlgebraicGeometry

