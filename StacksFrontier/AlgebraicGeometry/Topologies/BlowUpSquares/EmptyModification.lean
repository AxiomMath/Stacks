module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Topologies.BlowUpSquares.Existence
public import StacksFrontier.AlgebraicGeometry.Topologies.BlowUpSquares.Shrinking

/-!
# An almost blowup square with empty modification over a thickening

Let `I` be a quasi-coherent ideal sheaf of finite type on a quasi-compact and quasi-separated
scheme `X` whose support is all of `X`, so that the closed subscheme it cuts out is a thickening
of `X`.  Then `X` is the base of an almost blowup square with centre `I` whose modification is
the *empty* scheme.

This is the input of the first step of the proof of the sufficiency direction of Stacks 0EVF,
where the source says that "the blow up of `Y` in `X` is the empty scheme and this produces an
almost blow up square consisting with `∅, ∅, X, Y` at the vertices".

## Main results

* `AlgebraicGeometry.supportedSectionsIdeal_univ`: the ideal of sections supported on the whole
  space is the unit ideal sheaf.
* `AlgebraicGeometry.exists_isEmpty_isAlmostBlowUpSquare`: the almost blowup square with empty
  modification.

## Implementation notes

The emptiness of the blowup itself is not proved here, and is not needed: Stacks 0EVA
`AlgebraicGeometry.exists_isAlmostBlowUpSquare` already provides *some* almost blowup square
`b : X' ⟶ X` with centre `I`, and shrinking it to the closed subscheme cut out by the ideal of
sections supported on the inverse-image centre is again an almost blowup square by Stacks 0EV8
`AlgebraicGeometry.le_supportedSectionsIdeal_iff_isAlmostBlowUpSquare`.  Because the support of
`I` is everything, the support of the inverse-image centre is all of `X'`, so that ideal of
supported sections is the unit ideal and the subscheme it cuts out is empty.

## References

* [Stacks Project, Tag 0EVF](https://stacks.math.columbia.edu/tag/0EVF)
* [Stacks Project, Tag 0EVA](https://stacks.math.columbia.edu/tag/0EVA)
* [Stacks Project, Tag 0EV8](https://stacks.math.columbia.edu/tag/0EV8)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-- The ideal of sections of the structure sheaf supported on the whole space is the unit ideal
sheaf: it is the kernel of the inclusion of the empty open complement. -/
public theorem supportedSectionsIdeal_univ {X : Scheme.{u}} :
    supportedSectionsIdeal (Set.univ : Set X) = ⊤ := by
  rw [supportedSectionsIdeal_eq_complementKernel _ isClosed_univ]
  have : IsEmpty (Scheme.Opens.toScheme
      (⟨(Set.univ : Set X)ᶜ, isClosed_univ.isOpen_compl⟩ : X.Opens)) :=
    ⟨fun x ↦ by simpa using x.2⟩
  exact Scheme.ker_eq_top_of_isEmpty _

/-- The unit ideal sheaf cuts out a closed subscheme of finite presentation: the unit ideal is
generated by one element on every affine open. -/
public theorem finitePresentation_subschemeι_top {X : Scheme.{u}} :
    FinitePresentation (⊤ : X.IdealSheafData).subschemeι :=
  (Stacks.Flatness.finitePresentation_subschemeι_iff _).mpr fun _ ↦ by
    rw [Scheme.IdealSheafData.ideal_top]
    exact ⟨{1}, by simp⟩

/-- **An almost blowup square with empty modification over a thickening.** Let `I` be a
quasi-coherent ideal sheaf of finite type on a quasi-compact and quasi-separated scheme `X` whose
support is all of `X`.  Then there is an almost blowup square with centre `I` whose modification
has empty source.

This is the square `(∅, ∅, Z, X)` that the proof of the sufficiency direction of Stacks 0EVF
starts from, with `Z` the thickening cut out by `I`. -/
public theorem exists_isEmpty_isAlmostBlowUpSquare {X : Scheme.{u}}
    [CompactSpace X] [QuasiSeparatedSpace X] (I : X.IdealSheafData)
    (hI : Scheme.IdealSheafData.IsFiniteType I) (hsupp : (I.support : Set X) = Set.univ) :
    ∃ (X' : Scheme.{u}) (b : X' ⟶ X), IsEmpty X' ∧ IsAlmostBlowUpSquare I b := by
  obtain ⟨Y, b, hb⟩ := exists_isAlmostBlowUpSquare X I hI
  have hK : supportedSectionsIdeal ((I.comap b).support : Set Y) = ⊤ := by
    have hsupp' : ((I.comap b).support : Set Y) = Set.univ := by
      rw [Scheme.IdealSheafData.support_comap]
      simp only [TopologicalSpace.Closeds.coe_preimage, hsupp, Set.preimage_univ]
    rw [hsupp']
    exact supportedSectionsIdeal_univ
  refine ⟨(⊤ : Y.IdealSheafData).subscheme, (⊤ : Y.IdealSheafData).subschemeι ≫ b,
    inferInstance, ?_⟩
  refine (le_supportedSectionsIdeal_iff_isAlmostBlowUpSquare I b hb ⊤
    finitePresentation_subschemeι_top).mp ?_
  rw [hK]

end AlgebraicGeometry

end
