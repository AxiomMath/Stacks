module

public import StacksFrontier.AlgebraicGeometry.Topologies.ExtendingFunctorsCoveringSheaf
public import StacksFrontier.AlgebraicGeometry.Topologies.ExtendingFunctorsNoetherian
public import StacksFrontier.AlgebraicGeometry.Topologies.ExtendingFunctorsStandardAffineDescent
public import StacksFrontier.AlgebraicGeometry.Topologies.ExtendingFunctorsStandardTopologies

/-!
# Restricting a sheaf on `(Sch/S)_τ` to a full subcategory of schemes over a base

Let `S` be a scheme, let `τ` be one of the five topologies of
`AlgebraicGeometry.CoveringTopology` and let `𝒞` be a full subcategory of `Sch/S`, presented as
the full subcategory cut out by an `ObjectProperty (Over S)`. The `τ`-coverings of `Sch/S` whose
members are objects of `𝒞` make `𝒞` a site, and the sheaf condition for that site is
`AlgebraicGeometry.ExtendingFunctors.IsCoveringSheafOnSubcategory`. This file goes the other way
from `StacksFrontier.AlgebraicGeometry.Topologies.ExtendingFunctorsCoveringSheaf`, which extends a
sheaf on the subcategory to `Sch/S`: it restricts a sheaf on `(Sch/S)_τ` to the subcategory, and
records the two conditions on `𝒞` under which that restriction is well behaved.

Restricting the sheaf condition needs the subcategory to contain the fibre products of the members
of its `τ`-coverings — `AlgebraicGeometry.ExtendingFunctors.HasCoveringPullbacks`, which is Stacks
0GE1 (2) — because the compatibility of a family of sections is tested on the objects of the
subcategory only, and it is the fibre product of two members that has to witness it. Restricting
the limit condition needs nothing: a directed inverse limit of affine objects of the subcategory
whose limit is computed in `Sch/S` is one of affine schemes over `S`.

## Main definitions

* `AlgebraicGeometry.ExtendingFunctors.HasCoveringPullbacks`: the full subcategory contains the
  fibre product of a morphism of the subcategory with a morphism of the subcategory having the
  property of morphisms defining the topology.

## Main results

* `AlgebraicGeometry.ExtendingFunctors.existsUnique_section_of_isSheafFor_ofArrows` and
  `AlgebraicGeometry.ExtendingFunctors.isSheafFor_ofArrows_of_existsUnique`: the sheaf condition
  for a presieve generated by a family of arrows, read as the unique amalgamation of the families
  of sections indexed by the index type of the family.
* `AlgebraicGeometry.ExtendingFunctors.isZariskiSheaf_of_isCoveringSheaf`: a sheaf for the
  `τ`-coverings of `Sch/S` is a Zariski sheaf.
* `AlgebraicGeometry.ExtendingFunctors.hasCoveringPullbacks_isLocallyNoetherianOver`: **Stacks
  0GE1 (2) for the locally Noetherian subcategory.**
* `AlgebraicGeometry.ExtendingFunctors.isCoveringSheafOnSubcategory_of_isCoveringSheaf`: the
  restriction of a sheaf on `(Sch/S)_τ` is a sheaf on the site `(𝒞)_τ`.
* The restriction of a limit preserving functor is limit preserving on the subcategory:
  `AlgebraicGeometry.ExtendingFunctors.preservesAffineLimitsOnSubcategory_of_preservesAffineLimits`

## Implementation notes

A covering of the subcategory is a family of morphisms of the subcategory whose image in `Sch/S`
generates a presieve belonging to
`AlgebraicGeometry.ExtendingFunctors.coveringPrecoverage`; this is Stacks 0GE1 (4), the coverings
of `(Sch/S)_τ` whose objects lie in the subcategory. The compatibility of a family of sections is
left to `CategoryTheory.Presieve.IsSheafFor`, which tests it on every object of the subcategory
mapping to two members of the covering, so the definition does not refer to fibre products — the
subcategory need not have them. It is only the *restriction* of a sheaf from `Sch/S` that needs
them, to transport a compatibility stated over all of `Sch/S` to one stated over the subcategory.

The index type of a covering lies in the universe `v`; the comparison with the Zariski sheaf
condition uses the case `v = u` of the universe of the schemes, which is where the opens of a
scheme live and which is the universe in which
`AlgebraicGeometry.ExtendingFunctors.IsZariskiSheaf` indexes its coverings.

## References

* [Stacks Project, Tag 0GE1](https://stacks.math.columbia.edu/tag/0GE1)
* [Stacks Project, Tag 0EUW](https://stacks.math.columbia.edu/tag/0EUW)
* [Stacks Project, Tag 0GDW](https://stacks.math.columbia.edu/tag/0GDW)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.ExtendingFunctors

universe w u v

variable {S : Scheme.{u}}

/-! ### Sections of a sheaf for a family of arrows -/

/-- The amalgamation of an indexed family of sections for a presieve generated by arrows is
unique. This is `AlgebraicGeometry.ExtendingFunctors.exists_section_of_isSheafFor_ofArrows`
together with the separatedness half of the sheaf condition. -/
theorem existsUnique_section_of_isSheafFor_ofArrows {C : Type*} [Category C] {G : Cᵒᵖ ⥤ Type w}
    {X : C} {ι : Type*} (W : ι → C) (g : ∀ j, W j ⟶ X)
    (hsh : (Presieve.ofArrows W g).IsSheafFor G) (y : ∀ j, G.obj (op (W j)))
    (hy : ∀ (j j' : ι) (A : C) (a : A ⟶ W j) (b : A ⟶ W j'), a ≫ g j = b ≫ g j' →
      G.map a.op (y j) = G.map b.op (y j')) :
    ∃! t : G.obj (op X), ∀ j, G.map (g j).op t = y j := by
  obtain ⟨t, ht⟩ := exists_section_of_isSheafFor_ofArrows W g hsh y hy
  refine ⟨t, ht, fun t' ht' => hsh.isSeparatedFor.ext ?_⟩
  intro A h hh
  rw [hh.eq_eqToHom_comp_hom_idx, ← map_map_apply, ← map_map_apply, ht' hh.idx, ht hh.idx]

/-- The converse of
`AlgebraicGeometry.ExtendingFunctors.existsUnique_section_of_isSheafFor_ofArrows`: to verify the
sheaf condition for a presieve generated by a family of arrows it suffices to amalgamate the
families of sections indexed by the index type of the family. -/
theorem isSheafFor_ofArrows_of_existsUnique {C : Type*} [Category C] {G : Cᵒᵖ ⥤ Type w}
    {X : C} {ι : Type*} (W : ι → C) (g : ∀ j, W j ⟶ X)
    (H : ∀ y : ∀ j, G.obj (op (W j)),
      (∀ (j j' : ι) (A : C) (a : A ⟶ W j) (b : A ⟶ W j'), a ≫ g j = b ≫ g j' →
        G.map a.op (y j) = G.map b.op (y j')) →
      ∃! t : G.obj (op X), ∀ j, G.map (g j).op t = y j) :
    (Presieve.ofArrows W g).IsSheafFor G := by
  intro x hx
  obtain ⟨t, ht, huniq⟩ := H (fun j => x (g j) (Presieve.ofArrows.mk j))
    fun j j' A a b hab => hx a b (Presieve.ofArrows.mk j) (Presieve.ofArrows.mk j') hab
  refine ⟨t, ?_, fun t' ht' => huniq t' fun j => ht' (g j) (Presieve.ofArrows.mk j)⟩
  intro A h hh
  have hfac : eqToHom hh.obj_idx.symm ≫ g hh.idx = h := hh.eq_eqToHom_comp_hom_idx.symm
  have hval : x h hh
      = G.map (eqToHom hh.obj_idx.symm).op (x (g hh.idx) (Presieve.ofArrows.mk hh.idx)) := by
    simpa using hx (𝟙 A) (eqToHom hh.obj_idx.symm) hh (Presieve.ofArrows.mk hh.idx)
      (by rw [Category.id_comp, hfac])
  calc G.map h.op t = G.map (eqToHom hh.obj_idx.symm ≫ g hh.idx).op t := by rw [hfac]
    _ = G.map (eqToHom hh.obj_idx.symm).op (G.map (g hh.idx).op t) := (map_map_apply G _ _ t).symm
    _ = G.map (eqToHom hh.obj_idx.symm).op (x (g hh.idx) (Presieve.ofArrows.mk hh.idx)) := by
        rw [ht hh.idx]
    _ = x h hh := hval.symm

/-! ### The Zariski sheaf condition -/

/-- Sections of a presheaf which agree on a common source stay equal after restricting along a
common morphism. -/
private theorem map_comp_eq_map_comp_of_eq {C : Type*} [Category C] (G : Cᵒᵖ ⥤ Type w)
    {A Q B₁ B₂ : C} {γ : A ⟶ Q} {a : Q ⟶ B₁} {b : Q ⟶ B₂} {α : A ⟶ B₁} {β : A ⟶ B₂}
    (hα : γ ≫ a = α) (hβ : γ ≫ b = β) {x : G.obj (op B₁)} {y : G.obj (op B₂)}
    (h : G.map a.op x = G.map b.op y) : G.map α.op x = G.map β.op y := by
  rw [← hα, ← hβ, ← map_map_apply, ← map_map_apply, h]

/-- The range of the open immersion underlying `overOpenι X V` is the open `V`. -/
@[simp]
lemma opensRange_left_overOpenι (X : Over S) (V : X.left.Opens) :
    (overOpenι X V).left.opensRange = V :=
  TopologicalSpace.Opens.ext V.range_ι

/-- **A sheaf for the `τ`-coverings of `Sch/S` is a Zariski sheaf.** A covering of an object of
`Sch/S` by open subobjects is a `τ`-covering, and the compatibility of a family of sections on the
pairwise intersections upgrades to the compatibility tested by
`CategoryTheory.Presieve.IsSheafFor`: a morphism into a member of the covering which agrees over
the ambient object with a morphism into another member has image in the intersection, hence
factors through it. -/
theorem isZariskiSheaf_of_isCoveringSheaf (τ : CoveringTopology) {G : (Over S)ᵒᵖ ⥤ Type w}
    (hG : IsCoveringSheaf.{w, u, u} τ G) : IsZariskiSheaf G := by
  intro X ι V hV s hs
  have hcov : Presieve.ofArrows (fun i => overOpen X (V i)) (fun i => overOpenι X (V i))
      ∈ coveringPrecoverage S τ X := by
    refine ofArrows_mem_coveringPrecoverage_of_isOpenImmersion τ _ _ (fun i => inferInstance) ?_
    simpa only [opensRange_left_overOpenι] using hV
  refine existsUnique_section_of_isSheafFor_ofArrows _ _ (hG X _ _ hcov) s ?_
  intro i j A α β hαβ
  have h1 : Set.range (⇑(α ≫ overOpenι X (V i)).left) ⊆ ((V i : X.left.Opens) : Set X.left) :=
    range_le_of_comp α _ _ (by rw [overOpenι_left]; exact (V i).range_ι.le)
  have h2 : Set.range (⇑(α ≫ overOpenι X (V i)).left) ⊆ ((V j : X.left.Opens) : Set X.left) := by
    rw [hαβ]
    exact range_le_of_comp β _ _ (by rw [overOpenι_left]; exact (V j).range_ι.le)
  have hr : Set.range (⇑(α ≫ overOpenι X (V i)).left)
      ⊆ ((V i ⊓ V j : X.left.Opens) : Set X.left) := by
    rw [TopologicalSpace.Opens.coe_inf]
    exact Set.subset_inter h1 h2
  set γ : A ⟶ overOpen X (V i ⊓ V j) :=
    liftOverOpen (α ≫ overOpenι X (V i)) (V i ⊓ V j) hr with hγ
  have hγ₁ : γ ≫ overOpenLE X (inf_le_left : V i ⊓ V j ≤ V i) = α := by
    refine eq_of_comp_overOpenι ?_
    rw [Category.assoc, overOpenLE_comp_overOpenι, hγ, liftOverOpen_comp_overOpenι]
  have hγ₂ : γ ≫ overOpenLE X (inf_le_right : V i ⊓ V j ≤ V j) = β := by
    refine eq_of_comp_overOpenι ?_
    rw [Category.assoc, overOpenLE_comp_overOpenι, hγ, liftOverOpen_comp_overOpenι, hαβ]
  exact map_comp_eq_map_comp_of_eq G hγ₁ hγ₂ (hs i j)

/-! ### Restricting a sheaf on `Sch/S` to the subcategory -/

/-- A full subcategory of `Sch/S` contains the fibre products of the members of its `τ`-coverings:
the fibre product of a morphism of the subcategory with a morphism of the subcategory having the
property of morphisms defining the topology is again an object of the subcategory. This is Stacks
0GE1 (2) for the locally Noetherian subcategory. -/
def HasCoveringPullbacks (τ : CoveringTopology) (P : ObjectProperty (Over S)) : Prop :=
  ∀ {X Y Z : Over S} (p : Y ⟶ X) (q : Z ⟶ X), P Y → P Z →
    coveringMorphismProperty τ q.left → P (pullback p q)

/-- **Stacks 0GE1 (2) for the locally Noetherian subcategory.** The fibre product of a morphism of
`Sch/S` with a source which is locally Noetherian and a morphism having the property of morphisms
defining one of the five topologies is locally Noetherian: the first projection is the base change
of the second morphism, hence locally of finite presentation and in particular locally of finite
type. -/
theorem hasCoveringPullbacks_isLocallyNoetherianOver (τ : CoveringTopology) :
    HasCoveringPullbacks τ (IsLocallyNoetherianOver (S := S)) := by
  intro X Y Z p q hY _hZ hq
  have : IsLocallyNoetherian Y.left := hY
  have : LocallyOfFinitePresentation (pullback.fst p q).left :=
    MorphismProperty.of_isPullback (P := @LocallyOfFinitePresentation)
      ((IsPullback.of_hasPullback p q).map (Over.forget S)).flip
      (locallyOfFinitePresentation_of_coveringMorphismProperty τ hq)
  exact LocallyOfFiniteType.isLocallyNoetherian (pullback.fst p q).left

/-- **The restriction of a sheaf on `(Sch/S)_τ` is a sheaf on the site `(𝒞)_τ`**, as soon as the
full subcategory contains the fibre products of the members of its `τ`-coverings.

The sheaf condition on the subcategory tests the compatibility of a family of sections only on the
objects of the subcategory; the fibre product of two members of a covering is one of them, and
every object of `Sch/S` mapping compatibly to the two members factors through it. -/
theorem isCoveringSheafOnSubcategory_of_isCoveringSheaf (τ : CoveringTopology)
    {P : ObjectProperty (Over S)} (hPp : HasCoveringPullbacks τ P)
    {G : (Over S)ᵒᵖ ⥤ Type w} (hG : IsCoveringSheaf.{w, u, v} τ G) :
    IsCoveringSheafOnSubcategory.{w, u, v} τ P (P.ι.op ⋙ G) := by
  intro ι X Y f hcov
  have hprop := ((ofArrows_mem_coveringPrecoverage_iff τ _ _).mp hcov).2
  refine isSheafFor_ofArrows_of_existsUnique Y f fun y hy => ?_
  have hy' : ∀ (i j : ι) (A : Over S) (α : A ⟶ (Y i).obj) (β : A ⟶ (Y j).obj),
      α ≫ P.ι.map (f i) = β ≫ P.ι.map (f j) → G.map α.op (y i) = G.map β.op (y j) := by
    intro i j A α β hαβ
    set Qc : P.FullSubcategory :=
      ⟨pullback (P.ι.map (f i)) (P.ι.map (f j)),
        hPp _ _ (Y i).property (Y j).property (hprop j)⟩
    set π₁ : Qc ⟶ Y i :=
      ObjectProperty.homMk (pullback.fst (P.ι.map (f i)) (P.ι.map (f j))) with hπ₁
    set π₂ : Qc ⟶ Y j :=
      ObjectProperty.homMk (pullback.snd (P.ι.map (f i)) (P.ι.map (f j))) with hπ₂
    have hπ : π₁ ≫ f i = π₂ ≫ f j := by
      refine P.ι.map_injective ?_
      rw [Functor.map_comp, Functor.map_comp, hπ₁, hπ₂]
      exact pullback.condition
    exact map_comp_eq_map_comp_of_eq G (pullback.lift_fst _ _ hαβ) (pullback.lift_snd _ _ hαβ)
      (hy i j Qc π₁ π₂ hπ)
  exact existsUnique_section_of_isSheafFor_ofArrows (fun i => (Y i).obj)
    (fun i => P.ι.map (f i)) (hG X.obj _ _ hcov) y hy'

/-- **The restriction of a limit preserving functor on `Sch/S` is limit preserving on the
subcategory.** A directed inverse limit of affine objects of the subcategory whose limit is
computed in `Sch/S` is a directed inverse limit of affine schemes over `S`. -/
theorem preservesAffineLimitsOnSubcategory_of_preservesAffineLimits
    {P : ObjectProperty (Over S)} {G : (Over S)ᵒᵖ ⥤ Type w} (hG : PreservesAffineLimits G) :
    PreservesAffineLimitsOnSubcategory P (P.ι.op ⋙ G) := by
  intro Λ _ _ _ D haff c hc
  obtain ⟨hcol⟩ := hG Λ (D ⋙ P.ι) haff (P.ι.mapCone c) hc
  exact ⟨hcol⟩

end AlgebraicGeometry.ExtendingFunctors

end
