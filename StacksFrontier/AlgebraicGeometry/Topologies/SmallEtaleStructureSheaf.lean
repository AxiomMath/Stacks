module

public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.Precoverage
public import StacksFrontier.AlgebraicGeometry.Topologies.SmallEtaleGlobalFunctions

/-!
# The structure sheaf of the small étale site

The presheaf of rings `T ↦ Γ(T, 𝒪_T)` on the small étale site of a scheme `S` is a sheaf.  This
is étale descent of functions, the structure-sheaf case of faithfully flat descent for
quasi-coherent modules.

The proof has three steps.  Global functions are an fpqc sheaf on the category of all schemes
(`Stacks.Sites.isSheaf_fpqcTopology_globalSections`).  The canonical functor from the small
étale site to all schemes is compatible-preserving, because the small étale site has fibre
products and that functor preserves them, so the sheaf condition transports to any sieve whose
image generates an fpqc covering sieve; the sieve generated by a covering family of the small
étale site is such a sieve, since such a family is an étale covering.  Finally the small étale
precoverage is stable under base change, so these sieves suffice.

## Main definitions

* `Stacks.Sites.structurePresheaf` is the presheaf of rings of global functions on a site of
  `S`-schemes.
* `AlgebraicGeometry.SmallEtale.structureSheaf` is the structure sheaf of the small étale site.
  It is the structure sheaf `𝒪_S` of Stacks 04HS for the site `S_étale`.

## Main results

* `AlgebraicGeometry.SmallEtale.compatiblePreserving_toScheme`: the canonical functor from the
  small étale site to all schemes is compatible-preserving.
* `AlgebraicGeometry.SmallEtale.structure_isSheaf`: the presheaf of global functions on the
  small étale site of `S` is a sheaf of rings.

## References

* [Stacks Project, Tag 03DU](https://stacks.math.columbia.edu/tag/03DU)
* [Stacks Project, Tag 04HS](https://stacks.math.columbia.edu/tag/04HS)
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Limits Opposite

universe u

namespace Stacks.Sites

/-- The ring-valued presheaf of global functions on the schemes of a site over `S`. -/
public abbrev structurePresheaf (S : Scheme.{u}) {C : Type (u + 1)} [Category.{u} C]
    (toOver : C ⥤ Over S) : Cᵒᵖ ⥤ RingCat.{u} :=
  (toOver ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat RingCat

end Stacks.Sites

namespace AlgebraicGeometry.SmallEtale

variable (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The canonical functor from the small étale site of `S` to all schemes is
compatible-preserving: a cospan of the small étale site is completed by its fibre product, and
that fibre product is one of the underlying schemes. -/
public theorem compatiblePreserving_toScheme :
    CompatiblePreserving.{u} Scheme.fpqcTopology (toScheme B S hS) := by
  refine Stacks.Sites.compatiblePreserving_of_lift _ _ ?_
  intro Y₁ Y₂ Z g₁ g₂ T f₁ f₂ e
  have h : IsPullback ((toScheme B S hS).map (pullback.fst g₁ g₂))
      ((toScheme B S hS).map (pullback.snd g₁ g₂)) ((toScheme B S hS).map g₁)
      ((toScheme B S hS).map g₂) :=
    (IsPullback.of_hasPullback g₁ g₂).map (toScheme B S hS)
  exact ⟨pullback g₁ g₂, pullback.fst g₁ g₂, pullback.snd g₁ g₂, h.lift f₁ f₂ e,
    pullback.condition, h.lift_fst f₁ f₂ e, h.lift_snd f₁ f₂ e⟩

/-- Global functions satisfy the sheaf condition for a single covering family of the small
étale site, that family being an étale and hence fpqc covering. -/
public theorem isSheafFor_globalSections {X : SmallEtale B S hS} {R : Presieve X}
    (hR : R ∈ precoverage B S hS X) :
    Presieve.IsSheafFor ((toScheme B S hS).op ⋙ Stacks.Sites.globalSectionsSheaf.obj) R := by
  obtain ⟨E, rfl, hE⟩ := hR
  rw [Presieve.isSheafFor_iff_generate]
  refine Stacks.Sites.isSheafFor_op_comp (compatiblePreserving_toScheme B S hS) _ _ ?_
  rw [← Sieve.generate_map_eq_functorPushforward, PreZeroHypercover.presieve₀,
    Presieve.map_ofArrows]
  exact Stacks.Sites.etaleTopology_le_fpqcTopology _
    (Precoverage.generate_mem_toGrothendieck hE.1)

/-- Global functions on the small étale site of `S` form a sheaf of types. -/
public theorem isSheaf_globalSections :
    Presieve.IsSheaf (topology B S hS)
      ((toScheme B S hS).op ⋙ Stacks.Sites.globalSectionsSheaf.obj) := by
  have := smallEtale_precoverage_stableUnderBaseChange B S hS
  rw [Precoverage.isSheaf_toGrothendieck_iff_of_isStableUnderBaseChange]
  intro X R hR
  exact isSheafFor_globalSections B S hS hR

/-- **Stacks 03DU, small étale structure sheaf.**  The presheaf of global functions on the small
étale site of `S` is a sheaf of rings. -/
@[stacks 03DU "small étale structure sheaf"]
public theorem structure_isSheaf :
    Presheaf.IsSheaf (topology B S hS)
      (Stacks.Sites.structurePresheaf S (inclusion B S hS ⋙ Over.post B.inclusion)) :=
  Stacks.Sites.isSheaf_ringCat_of_isSheaf_forget _ _ (isSheaf_globalSections B S hS)

/-- The structure sheaf of the small étale site of `S`. -/
@[stacks 03DU "small étale structure sheaf construction"]
public noncomputable def structureSheaf : Sheaf (topology B S hS) RingCat.{u} :=
  ⟨Stacks.Sites.structurePresheaf S (inclusion B S hS ⋙ Over.post B.inclusion),
    structure_isSheaf B S hS⟩

/-- The structure sheaf of the small étale site has the presheaf of global functions as its
underlying presheaf. -/
@[simp]
public theorem structureSheaf_obj :
    (structureSheaf B S hS).obj =
      Stacks.Sites.structurePresheaf S (inclusion B S hS ⋙ Over.post B.inclusion) :=
  rfl

end AlgebraicGeometry.SmallEtale

add_to_stacks 04HS "small étale structure sheaf" AlgebraicGeometry.SmallEtale.structureSheaf

end
