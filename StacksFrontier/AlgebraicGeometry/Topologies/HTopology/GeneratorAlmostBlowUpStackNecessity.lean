module

public import StacksFrontier.AlgebraicGeometry.Topologies.HTopology.GeneratorAlmostBlowUpStackDiagonalCovering
public import StacksFrontier.CategoryTheory.Sites.Stack.CartesianSquareDescent

/-!
# Necessity of condition (3) of Stacks 0EX9

A stack in groupoids `p : 𝒮 ⥤ (Sch/S)_h` for the h topology turns every almost blowup square of the
site into an equivalence `𝒮_X ⟶ 𝒮_Z ×_{𝒮_E} 𝒮_{X'}` onto the two-fibre product of fibre
categories.  This is the categorified form of Stacks 0EVD; the source omits the proof.

The statement is the general descent theorem across a cartesian square with a monomorphic centre,
`CategoryTheory.Pseudofunctor.CartesianSquareDescent.isEquivalence_comp_restriction`,
applied to the pullback pseudofunctor of `p`, which is a stack for the h topology by
`CategoryTheory.Functor.isStack_of_isStackInGroupoids` and
`CategoryTheory.Functor.isStack_pullbackPseudofunctor_iff`.  Its three geometric inputs are in
place: the centre is a monomorphism
(`AlgebraicGeometry.BigHOver.mono_center_of_almostBlowUpSquare`), `{z, b}` covers the base
(`AlgebraicGeometry.BigHOver.sieve_ofArrows_pair_mem_topology`), and the
base change of the centre with the diagonal of the modification covers `X' ×_X X'`
(`AlgebraicGeometry.BigHOver.sieve_ofArrows_pair_diagonal_mem_topology`).  What remains is to
identify the comparison functor `AlgebraicGeometry.BigHOver.twoFibreProductComparison`, built from
the chosen pullbacks of `p`, with the descent data functor followed by the restriction functor:
`AlgebraicGeometry.BigHOver.twoFibreProductComparisonIso`.

No hypothesis on the base or on the shape of the square is used, so the theorem covers both shapes
of condition (3), Examples 0EVG and 0EVH.

## Main results

* `AlgebraicGeometry.BigHOver.isEquivalence_twoFibreProductComparison_of_isStackInGroupoids`: the
  comparison functor of an almost blowup square is an equivalence for an h stack in groupoids.
* `AlgebraicGeometry.BigHOver.isOneGeneratorAlmostBlowUpStack_of_isStackInGroupoids` and
  `AlgebraicGeometry.BigHOver.isTwoGeneratorAlmostBlowUpStack_of_isStackInGroupoids`: **Stacks
  0EX9, necessity of condition (3)**, for the two shapes.

## References

* [Stacks Project, Tag 0EX9](https://stacks.math.columbia.edu/tag/0EX9)
* [Stacks Project, Tag 0EVD](https://stacks.math.columbia.edu/tag/0EVD)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe t v u

namespace AlgebraicGeometry

namespace BigHOver

variable {B : BigHSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- The sieve generated by the `ULift Bool`-indexed pair of the site is the one generated by the
`Bool`-indexed pair. -/
public theorem sieve_ofArrows_pair_eq {A C X : BigHOver B S hS} (g : A ⟶ X) (k : C ⟶ X) :
    Sieve.ofArrows (fun j : ULift.{u + 1} Bool ↦ pairObj A C j.down) (fun j ↦ pairHom g k j.down) =
      Sieve.ofArrows (Pseudofunctor.CartesianSquareDescent.pairObj A C)
        (Pseudofunctor.CartesianSquareDescent.pairHom g k) := by
  ext Y f
  simp only [Sieve.mem_ofArrows_iff]
  constructor
  · rintro ⟨⟨_ | _⟩, h, rfl⟩
    · exact ⟨false, h, rfl⟩
    · exact ⟨true, h, rfl⟩
  · rintro ⟨_ | _, h, rfl⟩
    · exact ⟨⟨false⟩, h, rfl⟩
    · exact ⟨⟨true⟩, h, rfl⟩

variable {𝒳 : Type t} [Category.{v} 𝒳] {p : 𝒳 ⥤ BigHOver B S hS} [p.IsFibered]

open Functor.IsFibered in
/-- **The comparison functor of a cartesian square is the descent data functor along `{z, b}`
followed by the restriction functor.**  Both send an object to its two chosen pullbacks; the
structural isomorphism over the corner is in both cases the canonical comparison of the two
iterated chosen pullbacks, by `AlgebraicGeometry.BigHOver.cmpMor_cartComp_cartCompOfSquare` and
`CategoryTheory.Functor.toDescentData_obj_hom`.  The target category is spelled with
`CategoryTheory.Functor.IsFibered.fiberPullback`, which the pullback functors of the pullback
pseudofunctor are by definition. -/
public def twoFibreProductComparisonIso {X X' Z E : BigHOver B S hS} (b : X' ⟶ X) (z : Z ⟶ X)
    (d : E ⟶ X') (e : E ⟶ Z) (hsq : IsPullback e d z b) :
    twoFibreProductComparison B S hS p b z d e hsq ≅
      ((pullbackPseudofunctor p).toDescentData
          (Pseudofunctor.CartesianSquareDescent.pairHom z b) ⋙
        Pseudofunctor.CartesianSquareDescent.restriction (F := pullbackPseudofunctor p) hsq.w :
        p.Fiber X ⥤ CategoricalPullback (fiberPullback (p := p) e)
          (fiberPullback (p := p) d)) :=
  NatIso.ofComponents (fun x ↦ CategoricalPullback.mkIso (Iso.refl _) (Iso.refl _) (by
    have key : ((twoFibreProductComparison B S hS p b z d e hsq).obj x).iso.hom =
        (((pullbackPseudofunctor p).toDescentData
          (Pseudofunctor.CartesianSquareDescent.pairHom z b)).obj x).hom (e ≫ z)
          (i₁ := false) (i₂ := true) e d rfl hsq.w.symm :=
      (cmpMor_cartComp_cartCompOfSquare b z d e hsq rfl x).trans
        ((Functor.pullbackFiberCompIso'_hom_comp_inv p x z b e d (e ≫ z) rfl hsq.w.symm
          hsq.w).trans
        (Functor.toDescentData_obj_hom p (Pseudofunctor.CartesianSquareDescent.pairHom z b) x
          (e ≫ z) (i₁ := false) (i₂ := true) e d rfl hsq.w.symm hsq.w).symm)
    exact (congrArg (· ≫ _) (CategoryTheory.Functor.map_id _ _)).trans ((Category.id_comp _).trans
      (key.symm.trans ((Category.comp_id _).symm.trans
        (congrArg (_ ≫ ·) (CategoryTheory.Functor.map_id _ _).symm)))))) (fun _ ↦
      CategoricalPullback.hom_ext ((Category.comp_id _).trans (Category.id_comp _).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm))

end BigHOver

namespace BigHOver

variable (B : BigHSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
variable {𝒳 : Type t} [Category.{v} 𝒳] (p : 𝒳 ⥤ BigHOver B S hS)

open Functor.IsFibered Pseudofunctor.CartesianSquareDescent in
/-- **A stack in groupoids for the h topology turns an almost blowup square into an equivalence
onto the two-fibre product** `𝒮_X ⟶ 𝒮_Z ×_{𝒮_E} 𝒮_{X'}`, the categorified form of Stacks 0EVD.

The fibre square `X' ×_X X'` and the base change `Z ×_X (X' ×_X X')` are the canonical pullbacks of
the site, and the general theorem
`CategoryTheory.Pseudofunctor.CartesianSquareDescent.isEquivalence_comp_restriction`
is transported along `AlgebraicGeometry.BigHOver.twoFibreProductComparisonIso`.  Neither
affineness of the base nor the shape of the square is used. -/
public theorem isEquivalence_twoFibreProductComparison_of_isStackInGroupoids [p.IsFibered]
    (hp : p.IsStackInGroupoids.{u + 1} (BigHOver.topology B S hS))
    {X X' Z E : BigHOver B S hS} (b : X' ⟶ X) (z : Z ⟶ X) (d : E ⟶ X') (e : E ⟶ Z)
    (I : ((BigHOver.toScheme B S hS).obj X).IdealSheafData)
    (hb : IsAlmostBlowUpSquare I ((BigHOver.toScheme B S hS).map b))
    (hZ : Nonempty (Over.mk ((BigHOver.toScheme B S hS).map z) ≅ Over.mk I.subschemeι))
    (hsq : IsPullback e d z b) :
    (twoFibreProductComparison B S hS p b z d e hsq).IsEquivalence := by
  have : (pullbackPseudofunctor p).IsStack (BigHOver.topology B S hS) :=
    (Functor.isStack_pullbackPseudofunctor_iff p _).2 (Functor.isStack_of_isStackInGroupoids hp)
  have : Mono z := mono_center_of_almostBlowUpSquare z I hZ
  have hP := IsPullback.of_hasPullback b b
  have hT := IsPullback.of_hasPullback z (pullback.fst b b ≫ b)
  have hδ₁ : pullback.lift (𝟙 X') (𝟙 X') rfl ≫ pullback.fst b b = 𝟙 X' := pullback.lift_fst _ _ _
  have hδ₂ : pullback.lift (𝟙 X') (𝟙 X') rfl ≫ pullback.snd b b = 𝟙 X' :=
    pullback.lift_snd _ _ _
  have hzb := sieve_ofArrows_pair_mem_topology b z I hb hZ
  rw [sieve_ofArrows_pair_eq] at hzb
  have hRδ := sieve_ofArrows_pair_diagonal_mem_topology b z _ _ hP _ rfl _ _ hT _ hδ₁ hδ₂ I hb hZ
  rw [sieve_ofArrows_pair_eq] at hRδ
  have := isEquivalence_comp_restriction (F := pullbackPseudofunctor p) hsq hP hT
    hδ₁ hδ₂ (BigHOver.topology B S hS) hzb hRδ
  exact @Functor.isEquivalence_of_iso _ _ _ _ _ _ (twoFibreProductComparisonIso b z d e hsq).symm
    this

/-- **Stacks 0EX9, necessity of condition (3) for the shape of Example 0EVG.**  A stack in
groupoids for the h topology satisfies condition (3) for the squares of Example 0EVG; this is
`AlgebraicGeometry.BigHOver.isEquivalence_twoFibreProductComparison_of_isStackInGroupoids`, which
needs neither the affineness of the base nor the shape. -/
@[stacks 0EX9 "only if, condition (3) for the shape of Example 0EVG"]
public theorem isOneGeneratorAlmostBlowUpStack_of_isStackInGroupoids [p.IsFibered]
    (hp : p.IsStackInGroupoids.{u + 1} (BigHOver.topology B S hS)) :
    IsOneGeneratorAlmostBlowUpStack B S hS p :=
  fun _ _ _ _ b z d e I _ hb hZ hsq _ _ ↦
    isEquivalence_twoFibreProductComparison_of_isStackInGroupoids B S hS p hp b z d e I hb hZ hsq

/-- **Stacks 0EX9, necessity of condition (3) for the shape of Example 0EVH.**  A stack in
groupoids for the h topology satisfies condition (3) for the squares of Example 0EVH; this is
`AlgebraicGeometry.BigHOver.isEquivalence_twoFibreProductComparison_of_isStackInGroupoids`, which
needs neither the affineness of the base nor the shape. -/
@[stacks 0EX9 "only if, condition (3) for the shape of Example 0EVH"]
public theorem isTwoGeneratorAlmostBlowUpStack_of_isStackInGroupoids [p.IsFibered]
    (hp : p.IsStackInGroupoids.{u + 1} (BigHOver.topology B S hS)) :
    IsTwoGeneratorAlmostBlowUpStack B S hS p :=
  fun _ _ _ _ b z d e I _ hb hZ hsq _ _ ↦
    isEquivalence_twoFibreProductComparison_of_isStackInGroupoids B S hS p hp b z d e I hb hZ hsq

end BigHOver

end AlgebraicGeometry

end
