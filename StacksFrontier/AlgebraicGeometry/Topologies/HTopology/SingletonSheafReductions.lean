module

public import Mathlib.CategoryTheory.Sites.Preserves
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Topologies.HTopology.SheafCriterion

/-!
# Reductions for the sheaf condition on a one-element family

The sufficiency direction of Stacks 0EVF and of Stacks 0EVI is, by Stacks 0EU5, a statement about
the sheaf condition for the one-element family attached to a single morphism of the site.  This
file collects the manipulations of that condition which the argument uses over and over, in the
greatest generality in which they hold.

## Main results

* `CategoryTheory.Presieve.isSheafFor_singleton_of_isIso_map`: a morphism whose image under the
  presheaf is an isomorphism is a one-element family for which the presheaf is a sheaf, and
  conversely for a monomorphism.
* `CategoryTheory.Presieve.isIso_map_of_mono_of_isSheafFor_singleton`: the converse.
* `CategoryTheory.Presieve.isSheafFor_singleton_of_isIso_map_square`: the sheaf condition for a
  one-element family transfers along a commuting square whose two horizontal edges the presheaf
  sends to bijections.
* `CategoryTheory.Presieve.isSheafFor_singleton_of_pullback_squares`: the sheaf condition for
  `{f}` from the sheaf condition for a dominating morphism `f'`, the sheaf condition for the
  centre `z`, and two cartesian images.  This is the set-theoretic heart of the induction.
* `AlgebraicGeometry.BigHOver.isSheafFor_singleton_of_affine_target`: under condition (1) of
  Stacks 0EU5, the sheaf condition for the one-element family attached to a morphism with a
  property stable under base change need only be checked when the target has affine underlying
  scheme.
* `AlgebraicGeometry.BigHOver.isTerminal_of_isEmpty`: under condition (1), the sections over an
  object with empty underlying scheme form a terminal object.

## Implementation notes

`AlgebraicGeometry.BigHOver.isSheafFor_singleton_of_affine_target` is the generic form of the
affine reduction `AlgebraicGeometry.BigHOver.isProperFinitePresentationSheaf_of_affine` of Stacks
0EU5: that one is this one for the property "proper, surjective and of finite presentation".  It
is obtained from the sieve-theoretic
`AlgebraicGeometry.BigHOver.isSheafFor_of_affine_pullbacks`, the pullback of the sieve generated
by a one-element family being generated by the base change of the morphism.

## References

* [Stacks Project, Tag 0EVF](https://stacks.math.columbia.edu/tag/0EVF)
* [Stacks Project, Tag 0EU5](https://stacks.math.columbia.edu/tag/0EU5)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v

namespace CategoryTheory

namespace Presieve

variable {C : Type*} [Category C] (F : Cᵒᵖ ⥤ Type v)

/-- A commuting square `g ≫ f = g' ≫ f'` gives equal composites of the induced maps of sections. -/
private theorem map_op_map_op_apply_eq_of_comp_eq {X Y Z W : C} {g : X ⟶ Y} {f : Y ⟶ W}
    {g' : X ⟶ Z} {f' : Z ⟶ W} (h : g ≫ f = g' ≫ f') (x : F.obj (op W)) :
    F.map g.op (F.map f.op x) = F.map g'.op (F.map f'.op x) := by
  simp only [← Functor.map_comp_apply, ← op_comp, h]

/-- Compatibility of `s` for `f` gives compatibility of `F.map j.op s` for `f'`, along a commuting
square `j ≫ f = f' ≫ i`. -/
private theorem map_op_eq_of_comp_eq_of_comm_square {X Y X' Y' : C} {f : X ⟶ Y} {f' : X' ⟶ Y'}
    {i : Y' ⟶ Y} {j : X' ⟶ X} (h : j ≫ f = f' ≫ i) {s : F.obj (op X)}
    (hs : ∀ {W : C} (p₁ p₂ : W ⟶ X), p₁ ≫ f = p₂ ≫ f → F.map p₁.op s = F.map p₂.op s) :
    ∀ {W : C} (r₁ r₂ : W ⟶ X'), r₁ ≫ f' = r₂ ≫ f' →
      F.map r₁.op (F.map j.op s) = F.map r₂.op (F.map j.op s) := by
  intro W r₁ r₂ hr
  simp only [← Functor.map_comp_apply, ← op_comp]
  exact hs (r₁ ≫ j) (r₂ ≫ j) (by
    rw [Category.assoc, Category.assoc, h, ← Category.assoc, ← Category.assoc, hr])

/-- If a presheaf sends a morphism to an isomorphism, it is a sheaf for the one-element family
attached to that morphism. -/
public theorem isSheafFor_singleton_of_isIso_map {X Y : C} (f : X ⟶ Y) [IsIso (F.map f.op)] :
    Presieve.IsSheafFor F (.singleton f) := by
  rw [Presieve.isSheafFor_singleton]
  intro x _
  obtain ⟨hinj, hsurj⟩ := (CategoryTheory.isIso_iff_bijective (F.map f.op)).mp inferInstance
  obtain ⟨y, hy⟩ := hsurj x
  exact ⟨y, hy, fun y' hy' ↦ hinj (hy'.trans hy.symm)⟩

/-- For a monomorphism, the sheaf condition for the one-element family it generates says exactly
that the presheaf sends it to an isomorphism: the compatibility condition is vacuous. -/
public theorem isIso_map_of_mono_of_isSheafFor_singleton {X Y : C} (f : X ⟶ Y) [Mono f]
    (hf : Presieve.IsSheafFor F (.singleton f)) : IsIso (F.map f.op) := by
  rw [CategoryTheory.isIso_iff_bijective]
  refine (Function.bijective_iff_existsUnique _).mpr fun x ↦ ?_
  exact Presieve.isSheafFor_singleton.mp hf x fun p q hpq ↦ by rw [(cancel_mono f).mp hpq]

/-- The sheaf condition for a one-element family transfers along a commuting square
`j ≫ f = f' ≫ i` whose two horizontal edges the presheaf sends to bijections. -/
public theorem isSheafFor_singleton_of_isIso_map_square {X Y X' Y' : C}
    (f : X ⟶ Y) (f' : X' ⟶ Y') (i : Y' ⟶ Y) (j : X' ⟶ X) (h : j ≫ f = f' ≫ i)
    [IsIso (F.map i.op)] [IsIso (F.map j.op)]
    (hf' : Presieve.IsSheafFor F (.singleton f')) :
    Presieve.IsSheafFor F (.singleton f) := by
  have hi := (CategoryTheory.isIso_iff_bijective (F.map i.op)).mp inferInstance
  have hj := (CategoryTheory.isIso_iff_bijective (F.map j.op)).mp inferInstance
  rw [Presieve.isSheafFor_singleton] at hf' ⊢
  intro s hs
  obtain ⟨t, ht, htuniq⟩ := hf' (F.map j.op s) (map_op_eq_of_comp_eq_of_comm_square F h hs)
  obtain ⟨u, hu⟩ := hi.2 t
  have hfu : F.map f.op u = s := by
    refine hj.1 ?_
    calc
      F.map j.op (F.map f.op u) = F.map f'.op (F.map i.op u) :=
        map_op_map_op_apply_eq_of_comp_eq F h u
      _ = F.map j.op s := by rw [hu, ht]
  refine ⟨u, hfu, fun v hv ↦ hi.1 ?_⟩
  rw [hu]
  refine htuniq _ ?_
  calc
    F.map f'.op (F.map i.op v) = F.map j.op (F.map f.op v) :=
      (map_op_map_op_apply_eq_of_comp_eq F h v).symm
    _ = F.map j.op s := by rw [hv]

/-- **The set-theoretic core of the induction of the sufficiency direction of Stacks 0EVF.**
Let `f : X ⟶ Y` be dominated by a morphism `f' : X' ⟶ Y'` over `b : Y' ⟶ Y`, `c : X' ⟶ X`, let
`z : T ⟶ Z` be the restriction of `f` to a centre `i : Z ⟶ Y`, `j : T ⟶ X`, and let
`a : D ⟶ E` be the restriction of `f'` to the exceptional corners `e : E ⟶ Z`, `p : E ⟶ Y'`,
`d : D ⟶ T`, `q : D ⟶ X'`.  If the presheaf turns both the base and the source square into
cartesian squares of sets, is a sheaf for `{f'}` and for `{z}`, and is separated for `{a}`, then
it is a sheaf for `{f}`. -/
public theorem isSheafFor_singleton_of_pullback_squares {X Y X' Y' Z T E D : C}
    (f : X ⟶ Y) (f' : X' ⟶ Y') (z : T ⟶ Z) (a : D ⟶ E)
    (b : Y' ⟶ Y) (c : X' ⟶ X) (i : Z ⟶ Y) (j : T ⟶ X)
    (e : E ⟶ Z) (p : E ⟶ Y') (d : D ⟶ T) (q : D ⟶ X')
    (hbc : c ≫ f = f' ≫ b) (hij : j ≫ f = z ≫ i)
    (hde : a ≫ e = d ≫ z) (hpq : a ≫ p = q ≫ f')
    (hY : IsPullback (F.map i.op) (F.map b.op) (F.map e.op) (F.map p.op))
    (hX : IsPullback (F.map j.op) (F.map c.op) (F.map d.op) (F.map q.op))
    (hf' : Presieve.IsSheafFor F (.singleton f'))
    (hz : Presieve.IsSheafFor F (.singleton z))
    (ha : Presieve.IsSeparatedFor F (.singleton a)) :
    Presieve.IsSheafFor F (.singleton f) := by
  have hzinj := Presieve.isSeparatedFor_singleton.mp hz.isSeparatedFor
  have hf'inj := Presieve.isSeparatedFor_singleton.mp hf'.isSeparatedFor
  have hainj := Presieve.isSeparatedFor_singleton.mp ha
  rw [Presieve.isSheafFor_singleton] at hz hf' ⊢
  intro s hs
  obtain ⟨t, ht, _⟩ := hz (F.map j.op s) (map_op_eq_of_comp_eq_of_comm_square F hij hs)
  obtain ⟨t', ht', _⟩ := hf' (F.map c.op s) (map_op_eq_of_comp_eq_of_comm_square F hbc hs)
  have htt' : F.map e.op t = F.map p.op t' := by
    refine hainj ?_
    calc
      F.map a.op (F.map e.op t) = F.map d.op (F.map z.op t) :=
        map_op_map_op_apply_eq_of_comp_eq F hde t
      _ = F.map d.op (F.map j.op s) := by rw [ht]
      _ = F.map q.op (F.map c.op s) := ConcreteCategory.congr_hom hX.w s
      _ = F.map q.op (F.map f'.op t') := by rw [ht']
      _ = F.map a.op (F.map p.op t') :=
        (map_op_map_op_apply_eq_of_comp_eq F hpq t').symm
  obtain ⟨u, hui, hub⟩ := Types.exists_of_isPullback hY t t' htt'
  refine ⟨u, ?_, ?_⟩
  · refine Types.ext_of_isPullback hX ?_ ?_
    · calc
        F.map j.op (F.map f.op u) = F.map z.op (F.map i.op u) :=
          map_op_map_op_apply_eq_of_comp_eq F hij u
        _ = F.map j.op s := by rw [hui, ht]
    · calc
        F.map c.op (F.map f.op u) = F.map f'.op (F.map b.op u) :=
          map_op_map_op_apply_eq_of_comp_eq F hbc u
        _ = F.map c.op s := by rw [hub, ht']
  · intro v hv
    refine Types.ext_of_isPullback hY ?_ ?_
    · refine hzinj ?_
      calc
        F.map z.op (F.map i.op v) = F.map j.op (F.map f.op v) :=
          (map_op_map_op_apply_eq_of_comp_eq F hij v).symm
        _ = F.map j.op s := by rw [hv]
        _ = F.map z.op (F.map i.op u) := by rw [hui, ht]
    · refine hf'inj ?_
      calc
        F.map f'.op (F.map b.op v) = F.map c.op (F.map f.op v) :=
          (map_op_map_op_apply_eq_of_comp_eq F hbc v).symm
        _ = F.map c.op s := by rw [hv]
        _ = F.map f'.op (F.map b.op u) := by rw [hub, ht']

end Presieve

end CategoryTheory

namespace AlgebraicGeometry

namespace BigHOver

variable {B : BigHSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
variable {F : (BigHOver B S hS)ᵒᵖ ⥤ Type v}

/-- **The generic affine reduction of the sheaf condition for a one-element family.** Given
condition (1) of Stacks 0EU5 and a property of morphisms of schemes stable under base change, the
sheaf condition for the one-element family attached to a morphism of the site with that property
need only be checked when the target has affine underlying scheme.

This is `AlgebraicGeometry.BigHOver.isProperFinitePresentationSheaf_of_affine` with the
properties "proper, surjective and of finite presentation" replaced by an arbitrary property
stable under base change. -/
public theorem isSheafFor_singleton_of_affine_target
    (hZ : BigHOver.IsZariskiSheaf B S hS F) (Q : MorphismProperty Scheme.{u})
    [Q.IsStableUnderBaseChange]
    (hlocal : ∀ (X Y : BigHOver B S hS) (f : Y ⟶ X),
      IsAffine ((BigHOver.toScheme B S hS).obj X) → Q ((BigHOver.toScheme B S hS).map f) →
      Presieve.IsSheafFor F (Presieve.singleton f))
    {X Y : BigHOver B S hS} (f : Y ⟶ X) (hf : Q ((BigHOver.toScheme B S hS).map f)) :
    Presieve.IsSheafFor F (Presieve.singleton f) := by
  let := schemeSizeBelow_isClosedUnderLimitsOfShape_walkingCospan B.cutoff
  let : Limits.PreservesLimitsOfShape Limits.WalkingCospan (BigHOver.toScheme B S hS) :=
    inferInstance
  rw [Presieve.isSheafFor_iff_generate]
  refine isSheafFor_of_affine_pullbacks hZ (Sieve.generate (Presieve.singleton f)) ?_
  intro W g hW
  rw [← Sieve.pullbackArrows_comm, Presieve.pullback_singleton,
    ← Presieve.isSheafFor_iff_generate]
  refine hlocal W (Limits.pullback f g) (Limits.pullback.snd f g) hW ?_
  exact Q.of_isPullback
    ((IsPullback.of_hasPullback f g).map (BigHOver.toScheme B S hS)) hf

/-- **Under condition (1) of Stacks 0EU5, an object with empty underlying scheme has a terminal
set of sections.** The empty family is a Zariski covering of the empty scheme, so the sheaf
condition for it applies. -/
public def isTerminal_of_isEmpty (hZ : BigHOver.IsZariskiSheaf B S hS F)
    (X : BigHOver B S hS) [IsEmpty ((BigHOver.toScheme B S hS).obj X)] :
    Limits.IsTerminal (F.obj (op X)) := by
  have hbot : Presieve.IsSheafFor F (⊥ : Presieve X) := by
    have hmapbot : ((PreZeroHypercover.empty.{u + 1} X).map
        (BigHOver.toScheme B S hS)).presieve₀ = ⊥ := by
      funext W g
      exact propext ⟨fun ⟨i⟩ ↦ i.elim, False.elim⟩
    have hmem : ((PreZeroHypercover.empty.{u + 1} X).map
        (BigHOver.toScheme B S hS)).presieve₀ ∈
        Scheme.zariskiPrecoverage ((BigHOver.toScheme B S hS).obj X) := by
      rw [hmapbot]
      exact Scheme.bot_mem_precoverage (P := @IsOpenImmersion) _
    have := hZ X (PreZeroHypercover.empty.{u + 1} X) hmem
    rwa [PreZeroHypercover.presieve₀_empty] at this
  refine Presieve.isTerminal_of_isSheafFor_empty_presieve X F ?_
  have heq : Presieve.ofArrows (X := X) Empty.elim Empty.instIsEmpty.elim = ⊥ := by
    funext W g
    exact propext ⟨fun ⟨i⟩ ↦ i.elim, False.elim⟩
  rw [heq]
  exact hbot

end BigHOver

end AlgebraicGeometry

end
