* [Stacks Project, Tag 0ETW](https://stacks.math.columbia.edu/tag/0ETW)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe t v u

namespace AlgebraicGeometry

namespace BigHOver

variable {B : BigHSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-! ### The two-element family of the centre and the modification -/

/-- The two-element family of objects of the big h category over `S` with members `A` and `C`. -/
public abbrev pairObj (A C : BigHOver B S hS) : Bool → BigHOver B S hS
  | false => A
  | true => C

/-- The two-element family of morphisms of the big h category over `S` to a common target with
members `g` and `k`. -/
public abbrev pairHom {A C X : BigHOver B S hS} (g : A ⟶ X) (k : C ⟶ X) :
    (i : Bool) → pairObj A C i ⟶ X
  | false => g
  | true => k

/-- **The centre and the modification of an almost blowup square of the site generate a covering
sieve of the h topology on its base.**

The centre is proper and of finite presentation and its image together with the image of the
modification is everything, by
`AlgebraicGeometry.isProper_finitePresentation_range_union_center_modification`; so the
two-element family of their underlying morphisms of schemes is an h covering by
`AlgebraicGeometry.isHCovering_bool_of_isProper_of_range_union`, and
`AlgebraicGeometry.BigHOver.sieve₀_mem_topology_of_isHCovering` turns that into membership of the
h topology.  The family is reindexed along `Equiv.ulift` because a covering family of the site is
indexed by a type in `Type (u + 1)`. -/
public theorem sieve_ofArrows_pair_mem_topology
    {X X' Z : BigHOver B S hS} (b : X' ⟶ X) (z : Z ⟶ X)
    (I : ((BigHOver.toScheme B S hS).obj X).IdealSheafData)
    (hb : IsAlmostBlowUpSquare I ((BigHOver.toScheme B S hS).map b))
    (hZ : Nonempty (Over.mk ((BigHOver.toScheme B S hS).map z) ≅ Over.mk I.subschemeι)) :
    Sieve.ofArrows (fun j : ULift.{u + 1} Bool ↦ pairObj Z X' j.down)
      (fun j ↦ pairHom z b j.down) ∈ BigHOver.topology B S hS X := by
  obtain ⟨hproperz, hfpz, hrange⟩ :=
    isProper_finitePresentation_range_union_center_modification I
      ((BigHOver.toScheme B S hS).map b) ((BigHOver.toScheme B S hS).map z) hb hZ
  have hbool : IsHCovering (fun i : Bool ↦ (BigHOver.toScheme B S hS).obj (pairObj Z X' i))
      (fun i : Bool ↦ (BigHOver.toScheme B S hS).map (pairHom z b i)) :=
    isHCovering_bool_of_isProper_of_range_union _ _
      (fun | false => hfpz.1 | true => hb.finitePresentation.1)
      (fun | false => hproperz | true => hb.proper) hrange
  exact sieve₀_mem_topology_of_isHCovering B S hS
    { I₀ := ULift.{u + 1} Bool
      X := fun j ↦ pairObj Z X' j.down
      f := fun j ↦ pairHom z b j.down } (hbool.reindex Equiv.ulift)

/-! ### Descent of morphisms -/

section

variable {𝒳 : Type t} [Category.{v} 𝒳] {p : 𝒳 ⥤ BigHOver B S hS} [p.IsFibered]
variable {U : BigHOver B S hS} {x y : p.Fiber U}
variable {I : Type (u + 1)} {V : I → BigHOver B S hS} {f : ∀ i, V i ⟶ U}
variable {ψ : ∀ i, Functor.pullbackFiber p x (f i) ⟶ Functor.pullbackFiber p y (f i)}

/-- **A morphism agreeing with `ψ` exists over the base of an almost blowup square of the slice at
`U`** once ones exist over its centre and its modification and the comparison functor of the square
is an equivalence: `AlgebraicGeometry.BigHOver.exists_morAgree_square` glues them, and agreement is
checked on the covering of `AlgebraicGeometry.BigHOver.sieve_ofArrows_pair_mem_topology`. -/
public theorem exists_morAgree_of_almostBlowUpSquare
    (h1 : IsZariskiStackInGroupoids B S hS p)
    (h2 : IsAffineFlatProperFinitePresentationDescent B S hS p)
    (h3 : IsOneGeneratorAlmostBlowUpStack B S hS p)
    (h4 : IsTwoGeneratorAlmostBlowUpStack B S hS p)
    (hf : Sieve.ofArrows V f ∈ BigHOver.topology B S hS U)
    {Xb X' Z Xe : Over U} (b : X' ⟶ Xb) (z : Z ⟶ Xb) (q : Xe ⟶ X') (e : Xe ⟶ Z)
    (Id : ((BigHOver.toScheme B S hS).obj Xb.left).IdealSheafData)
    (hb : IsAlmostBlowUpSquare Id ((BigHOver.toScheme B S hS).map b.left))
    (hZ : Nonempty (Over.mk ((BigHOver.toScheme B S hS).map z.left) ≅ Over.mk Id.subschemeι))
    (hsq : IsPullback e.left q.left z.left b.left)
    (heq : (twoFibreProductComparison B S hS p b.left z.left q.left e.left hsq).IsEquivalence)
    (hZψ : ∃ m : Functor.pullbackFiber p x Z.hom ⟶ Functor.pullbackFiber p y Z.hom,
      MorAgree ψ Z.hom m)
    (hXψ : ∃ m : Functor.pullbackFiber p x X'.hom ⟶ Functor.pullbackFiber p y X'.hom,
      MorAgree ψ X'.hom m) :
    ∃ m : Functor.pullbackFiber p x Xb.hom ⟶ Functor.pullbackFiber p y Xb.hom,
      MorAgree ψ Xb.hom m := by
  obtain ⟨mZ, hmZ⟩ := hZψ
  obtain ⟨mX, hmX⟩ := hXψ
  obtain ⟨M, hMz, hMb⟩ := exists_morAgree_square h1 h2 h3 h4 hf b.left z.left q.left e.left hsq
    heq (Over.w z) (Over.w b) hmZ hmX
  refine ⟨M, morAgree_of_covering h1 h2 h3 h4 M
    (T := fun j : ULift.{u + 1} Bool ↦ pairObj Z.left X'.left j.down)
    (fun j ↦ pairHom z.left b.left j.down) (fun j ↦ pairHom Z.hom X'.hom j.down)
    (fun | ⟨false⟩ => Over.w z | ⟨true⟩ => Over.w b)
    (sieve_ofArrows_pair_mem_topology b.left z.left Id hb hZ) ?_⟩
  rintro ⟨_ | _⟩
  · change MorAgree ψ Z.hom
      (Functor.baseChangeFiberMor M z.left Z.hom (Over.w z) Z.hom (Over.w z))
    rwa [hMz]
  · change MorAgree ψ X'.hom
      (Functor.baseChangeFiberMor M b.left X'.hom (Over.w b) X'.hom (Over.w b))
    rwa [hMb]

/-- **A morphism agreeing with a compatible family of local morphisms exists over `U` itself.**

This is `AlgebraicGeometry.BigHOver.of_localOnGenerators` for the property that a morphism
agreeing with `ψ` exists: it is stable under precomposition by
`AlgebraicGeometry.BigHOver.MorAgree.baseChange`, its Zariski step is
`AlgebraicGeometry.BigHOver.morAgree_zariski`, and its three remaining steps are the three
instantiations of `AlgebraicGeometry.BigHOver.exists_morAgree_square` described in the module
docstring.  The hypothesis is that each `ψ i` agrees with the family, which is the compatibility
of `ψ` over the overlaps. -/
public theorem exists_morAgree_id
    (h1 : IsZariskiStackInGroupoids B S hS p)
    (h2 : IsAffineFlatProperFinitePresentationDescent B S hS p)
    (h3 : IsOneGeneratorAlmostBlowUpStack B S hS p)
    (h4 : IsTwoGeneratorAlmostBlowUpStack B S hS p)
    (hf : Sieve.ofArrows V f ∈ BigHOver.topology B S hS U)
    (hψ : ∀ i, MorAgree ψ (f i) (ψ i)) :
    ∃ m : Functor.pullbackFiber p x (𝟙 U) ⟶ Functor.pullbackFiber p y (𝟙 U),
      MorAgree ψ (𝟙 U) m := by
  refine of_localOnGenerators B S hS U
    (fun Y ↦ ∃ m : Functor.pullbackFiber p x Y.hom ⟶ Functor.pullbackFiber p y Y.hom,
      MorAgree ψ Y.hom m)
    (fun k hY ↦ ⟨_, hY.choose_spec.baseChange k.left _ (Over.w k)⟩)
    (fun Y E hE hloc ↦ morAgree_zariski h1 h2 h3 h4 hf E hE hloc) ?_ ?_ ?_ f hf
    (fun i ↦ ⟨ψ i, hψ i⟩)
  · intro Y Y' g hAff hflat hproper hsurj hfp hY'
    -- the hypotheses are stated for `sliceToScheme`, which is `toScheme` precomposed with
    -- `Over.forget U`; instance search does not see through that, so they are restated
    have hsurj' : Surjective ((BigHOver.toScheme B S hS).map g.left) := hsurj
    have hproper' : IsProper ((BigHOver.toScheme B S hS).map g.left) := hproper
    have hE : IsHCovering
        ((PreZeroHypercover.singleton.{u + 1} g.left).map (BigHOver.toScheme B S hS)).X
        ((PreZeroHypercover.singleton.{u + 1} g.left).map (BigHOver.toScheme B S hS)).f :=
      (surjective_proper_isHCovering ((BigHOver.toScheme B S hS).map g.left) hfp).reindex
        (Equiv.ofUnique PUnit.{u + 2} Unit)
    have := h2 Y.left Y'.left g.left hAff hflat hproper hsurj hfp
    exact morAgree_of_fullyFaithful_toDescentData h1 h2 h3 h4 hf
      (PreZeroHypercover.singleton.{u + 1} g)
      ⟨Functor.FullyFaithful.ofFullyFaithful
        ((Functor.IsFibered.pullbackPseudofunctor p).toDescentData
          (fun _ : PUnit.{u + 2} ↦ g.left))⟩
      (sieve₀_mem_topology_of_isHCovering B S hS
        (PreZeroHypercover.singleton.{u + 1} g.left) hE) fun _ ↦ hY'
  all_goals
    intro Xb X' Z Xe b z q e Id hAff hb hZ hsq hmod hZψ hXψ
    have hsq' : IsPullback e.left q.left z.left b.left :=
      IsPullback.of_map_of_faithful (BigHOver.toScheme B S hS) hsq
    exact exists_morAgree_of_almostBlowUpSquare h1 h2 h3 h4 hf b z q e Id hb hZ hsq'
      (by first
        | exact h3 _ _ _ _ _ _ _ _ Id hAff hb hZ hsq' hsq hmod
        | exact h4 _ _ _ _ _ _ _ _ Id hAff hb hZ hsq' hsq hmod)
      hZψ hXψ

/-- **Descent of morphisms of a fibre along an h covering family, from conditions (1), (2) and (3)
of Stacks 0EX9.** A family of morphisms `ψ i` between the chosen pullbacks of `x` and of `y` along
an h covering family `f i : V i ⟶ U`, whose base changes to any object mapping compatibly into two
members agree, is the family of base changes of a *unique* morphism `x ⟶ y` of the fibre over `U`.

This is condition (2) of Stacks 02ZI in its family-indexed form.  Existence is
`AlgebraicGeometry.BigHOver.exists_morAgree_id`, read at `𝟙 U` through
`CategoryTheory.Functor.pullbackFiberIdIso`; uniqueness is
`AlgebraicGeometry.BigHOver.eq_of_pullbackFiberHom_eq_of_covering`, the separatedness half, which
needs no further input. -/
public theorem existsUnique_fiberHom_of_covering
    (h1 : IsZariskiStackInGroupoids B S hS p)
    (h2 : IsAffineFlatProperFinitePresentationDescent B S hS p)
    (h3 : IsOneGeneratorAlmostBlowUpStack B S hS p)
    (h4 : IsTwoGeneratorAlmostBlowUpStack B S hS p)
    (hf : Sieve.ofArrows V f ∈ BigHOver.topology B S hS U)
    (hψ : ∀ (i j : I) {Z : BigHOver B S hS} (ε : Z ⟶ V i) (ε' : Z ⟶ V j) (q : Z ⟶ U)
      (h₁ : ε ≫ f i = q) (h₂ : ε' ≫ f j = q),
      Functor.baseChangeFiberMor (ψ i) ε q h₁ q h₁ =
        Functor.baseChangeFiberMor (ψ j) ε' q h₂ q h₂) :
    ∃! m : x ⟶ y, ∀ i, Functor.pullbackFiberHom m (f i) = ψ i := by
  obtain ⟨m₀, hm₀⟩ := exists_morAgree_id h1 h2 h3 h4 hf
    (fun i₀ i Z ε δ q h₁ h₂ ↦ hψ i₀ i δ ε q h₂ h₁)
  have hm : ∀ i, Functor.pullbackFiberHom
      ((Functor.pullbackFiberIdIso x).inv ≫ m₀ ≫ (Functor.pullbackFiberIdIso y).hom) (f i) =
        ψ i := by
    intro i
    have hk := hm₀ i (V i) (𝟙 (V i)) (f i) (f i) (Category.id_comp (f i))
      (Category.comp_id (f i))
    rw [Functor.baseChangeFiberMor_id] at hk
    rwa [Functor.pullbackFiberHom_comp, Functor.pullbackFiberHom_comp,
      Functor.pullbackFiberHom_pullbackFiberIdIso_inv_eq,
      pullbackFiberHom_pullbackFiberIdIso_hom_eq]
  exact ⟨_, hm, fun m' hm' ↦ eq_of_pullbackFiberHom_eq_of_covering h1 h2 h3 h4 m' _ f hf
    fun i ↦ (hm' i).trans (hm i).symm⟩

end

section

variable {𝒳 : Type t} [Category.{v} 𝒳] {p : 𝒳 ⥤ BigHOver B S hS} [p.IsFibered]

/-- **The functor from a fibre to the descent data of a covering family is fully faithful**, from
conditions (1), (2) and (3) of Stacks 0EX9.

This is `AlgebraicGeometry.BigHOver.existsUnique_fiberHom_of_covering` read through
`CategoryTheory.Functor.FullyFaithful.nonempty_iff_map_bijective`: a morphism of descent data is a
compatible family of local morphisms, and such a family comes from a unique morphism of the fibre
over the base. -/
public theorem nonempty_fullyFaithful_toDescentData_of_generatorSquares
    (h1 : IsZariskiStackInGroupoids B S hS p)
    (h2 : IsAffineFlatProperFinitePresentationDescent B S hS p)
    (h3 : IsOneGeneratorAlmostBlowUpStack B S hS p)
    (h4 : IsTwoGeneratorAlmostBlowUpStack B S hS p)
    {T : BigHOver B S hS} {K : Type (u + 1)} {W : K → BigHOver B S hS}
    (g : ∀ k, W k ⟶ T) (hg : Sieve.ofArrows W g ∈ BigHOver.topology B S hS T) :
    Nonempty ((Functor.IsFibered.pullbackPseudofunctor p).toDescentData g).FullyFaithful := by
  rw [Functor.FullyFaithful.nonempty_iff_map_bijective]
  refine fun a c ↦ ⟨fun m m' hmm ↦ ?_, fun ξ ↦ ?_⟩
  · refine (existsUnique_fiberHom_of_covering h1 h2 h3 h4 hg
      (ψ := fun k ↦ Functor.pullbackFiberHom m (g k))
      (fun i j Z ε ε' q h₁ h₂ ↦ Functor.baseChangeFiberMor_hom_eq
        (((Functor.IsFibered.pullbackPseudofunctor p).toDescentData g).map m) ε ε' h₁ h₂)).unique
      (fun _ ↦ rfl) fun k ↦ ?_
    exact (congrArg (fun ξ ↦ Pseudofunctor.DescentData.Hom.hom ξ k) hmm).symm.trans rfl
  · obtain ⟨m, hm, -⟩ := existsUnique_fiberHom_of_covering h1 h2 h3 h4 hg
      (ψ := fun k ↦ ξ.hom k)
      (fun i j Z ε ε' q h₁ h₂ ↦ Functor.baseChangeFiberMor_hom_eq ξ ε ε' h₁ h₂)
    exact ⟨m, Pseudofunctor.DescentData.hom_ext fun k ↦ hm k⟩

/-- **Condition (2) of Stacks 026F from conditions (1), (2) and (3) of Stacks 0EX9.** The
presheaves `Mor(x, y)` of Stacks 02ZB are sheaves on the localized sites `(Sch/S)_h / U` for the h
topology.

This is `AlgebraicGeometry.BigHOver.nonempty_fullyFaithful_toDescentData_of_generatorSquares` read
on the family of all arrows of a covering sieve, as in
`CategoryTheory.Functor.isMorSheaf_of_isomIsSheaf`. -/
public theorem isMorSheaf_of_generatorSquares
    (h1 : IsZariskiStackInGroupoids B S hS p)
    (h2 : IsAffineFlatProperFinitePresentationDescent B S hS p)
    (h3 : IsOneGeneratorAlmostBlowUpStack B S hS p)
    (h4 : IsTwoGeneratorAlmostBlowUpStack B S hS p)
    (U : BigHOver B S hS) (x y : p.Fiber U) :
    Functor.IsMorSheaf p (BigHOver.topology B S hS) U x y := by
  have hpre : (Functor.IsFibered.pullbackPseudofunctor p).IsPrestack
      (BigHOver.topology B S hS) := by
    refine Pseudofunctor.IsPrestack.of_isPrestackFor fun T R hR ↦ ?_
    rw [← Presieve.ofArrows_category R.arrows, Pseudofunctor.isPrestackFor_ofArrows_iff]
    exact nonempty_fullyFaithful_toDescentData_of_generatorSquares h1 h2 h3 h4 _
      (by rwa [Sieve.ofArrows_category])
  exact (Functor.isPrestack_pullbackPseudofunctor_iff p (BigHOver.topology B S hS)).1 hpre U x y

end

end BigHOver

end AlgebraicGeometry

end
