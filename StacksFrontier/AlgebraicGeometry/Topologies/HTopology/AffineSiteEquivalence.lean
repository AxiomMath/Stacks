/-!
# The big affine h site is a dense subsite of the big h site

Let `B` be a big h site containing a scheme `S`.  The big affine h category over `S` is the
full subcategory of affine objects of the big h category over `S`, and its covering families
are the standard h coverings which cover in the big h site.  This file proves that the
inclusion of the big affine h site into the big h site over `S` is cocontinuous and exhibits the
former as a dense subsite of the latter, so that restriction along it is an equivalence of the
two topoi of sheaves.

## Main definitions

* `AlgebraicGeometry.BigAffineH.sheafEquivInclusion` and
  `AlgebraicGeometry.BigAffineH.toposEquivInclusion`: the equivalence of sheaf categories, for
  an arbitrary target category with the requisite limits and for set-valued sheaves.

## Main results

* `AlgebraicGeometry.exists_isStandardHCovering_refinement`: an h covering of an affine scheme
  is refined by a standard h covering, with the index type of the refining family placed in any
  universe above that of the schemes.
* `AlgebraicGeometry.BigAffineH.isCocontinuous_inclusion`: the inclusion of the big affine h site
  into the big h site over `S` is cocontinuous.
* `AlgebraicGeometry.BigAffineH.isDenseSubsite_inclusion`: the inclusion exhibits the big affine
  h site as a dense subsite of the big h site over `S`.

## References

* [Stacks Project, Tag 0EU4](https://stacks.math.columbia.edu/tag/0EU4)
* [Stacks Project, Tag 0EU0](https://stacks.math.columbia.edu/tag/0EU0)
* [Stacks Project, Tag 0EU1](https://stacks.math.columbia.edu/tag/0EU1)
* [Stacks Project, Tag 0ETU](https://stacks.math.columbia.edu/tag/0ETU)
* [Stacks Project, Tag 0DBH](https://stacks.math.columbia.edu/tag/0DBH)
* [Stacks Project, Tag 0DBP](https://stacks.math.columbia.edu/tag/0DBP)
* [Stacks Project, Tag 03A0](https://stacks.math.columbia.edu/tag/03A0)
-/

@[expose] public section

open Cardinal CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u v w

namespace AlgebraicGeometry

/-- An h covering of an affine scheme is refined by a standard h covering of that scheme, whose
index type may be taken in any universe above the universe of the schemes. -/
public theorem exists_isStandardHCovering_refinement {T : Scheme.{u}} [IsAffine T] {I : Type v}
    (X : I → Scheme.{u}) (f : ∀ i, X i ⟶ T) (hf : IsHCovering X f) :
    ∃ (K : Type (max u w)) (V : K → Scheme.{u}) (q : ∀ k, V k ⟶ T),
      IsStandardHCovering q ∧
        Nonempty (({ I₀ := K, X := V, f := q } : PreZeroHypercover.{max u w} T).Hom
          ({ I₀ := I, X := X, f := f } : PreZeroHypercover.{v} T)) := by
  obtain ⟨K, Y, p, V, j, hfinK, hproper, hsurj, hfpp, haff, hopen, hcover, hrefine⟩ :=
    exists_finitePresentation_proper_refinement_of_isHCovering X f hf
  have : Finite K := hfinK
  have hlfpp : LocallyOfFinitePresentation p := hfpp.1
  have hstdph : StandardPHCovering (fun k ↦ j k ≫ p) :=
    StandardPHCovering.of_presentation _ haff p j hproper hsurj hopen hcover fun _ ↦ rfl
  have hfpq : ∀ k, FinitePresentation (j k ≫ p) := by
    intro k
    have : IsAffine (V k) := haff k
    have : IsOpenImmersion (j k) := hopen k
    exact ⟨inferInstance, inferInstance, inferInstance⟩
  have hfinU : Finite (ULift.{max u w, u} K) := Finite.of_equiv K Equiv.ulift.symm
  choose σ h₀ hw using hrefine
  refine ⟨ULift.{max u w, u} K, fun k ↦ V k.down, fun k ↦ j k.down ≫ p,
    ⟨hfinU, fun k ↦ haff k.down, fun k ↦ hfpq k.down,
      { I₀ := K, X := V, f := fun k ↦ j k ≫ p }, hstdph, ⟨?_⟩⟩, ⟨?_⟩⟩
  · exact { s₀ := fun k ↦ ULift.up k
            h₀ := fun k ↦ 𝟙 (V k)
            w₀ := fun k ↦ Category.id_comp _ }
  · exact { s₀ := fun k ↦ σ k.down
            h₀ := fun k ↦ h₀ k.down
            w₀ := fun k ↦ hw k.down }

namespace BigAffineH

variable (B : BigHSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The inclusion of the big affine h category over `S` into the size-bounded category of
schemes: forget the affineness and then the structure morphism to `S`. -/
public abbrev toSchemes : BigAffineH B S hS ⥤ B.Schemes :=
  inclusion B S hS ⋙ BigHOver.forget B S hS

/-- The sieve generated by a chosen covering family of the big h site, base changed along a
morphism out of an affine object of the site, pulls back to a covering sieve of the big affine
h site. -/
public theorem generate_pullback_functorPullback_mem
    (T : BigAffineH B S hS) (X : B.Schemes) (g : (toSchemes B S hS).obj T ⟶ X)
    (R : Presieve X) (hR : R ∈ B.precoverage X) :
    ((Sieve.generate R).pullback g).functorPullback (toSchemes B S hS) ∈ topology B S hS T := by
  classical
  obtain ⟨𝒰, rfl, h𝒰⟩ := hR
  have hTaff : IsAffine (B.inclusion.obj T.obj.left) := T.property
  obtain ⟨P, π₁, π₂, hpb, hcovP⟩ := B.isSite.2.2 ⟨X, 𝒰⟩ h𝒰 T.obj.left g
  have hHcov : IsHCovering (fun i ↦ B.inclusion.obj (P i))
      (fun i ↦ B.inclusion.map (π₂ i)) := hcovP.h
  obtain ⟨K₁, V, q, hstd, ⟨φ⟩⟩ :=
    exists_isStandardHCovering_refinement.{u, u + 1, u + 1} _ _ hHcov
  have hfinK : Finite K₁ := hstd.1
  have hVaff : ∀ k, IsAffine (V k) := hstd.2.1
  have hqfp : ∀ k, FinitePresentation (q k) := hstd.2.2.1
  obtain ⟨φs, φh, φw⟩ : ∃ (s : K₁ → 𝒰.I₀) (h : ∀ k, V k ⟶ B.inclusion.obj (P (s k))),
      ∀ k, h k ≫ B.inclusion.map (π₂ (s k)) = q k := ⟨φ.s₀, φ.h₀, φ.w₀⟩
  obtain ⟨𝒱, h𝒱, htaut⟩ :=
    exists_isCovering_tautologicallyEquivalent_standardHCovering B T.obj.left
      ({ I₀ := K₁, X := V, f := q } : PreZeroHypercover.{u + 1} _) hstd
  obtain ⟨α, hα⟩ : ∃ α : K₁ → 𝒱.I₀, ∀ k, ∃ e : V k ≅ B.inclusion.obj (𝒱.X (α k)),
      e.hom ≫ B.inclusion.map (𝒱.f (α k)) = q k := htaut.1
  obtain ⟨β, hβ⟩ : ∃ β : 𝒱.I₀ → K₁, ∀ j, ∃ e : B.inclusion.obj (𝒱.X j) ≅ V (β j),
      e.hom ≫ q (β j) = B.inclusion.map (𝒱.f j) := htaut.2
  have hAfin : Finite (Set.range α) := (Set.finite_range α).to_subtype
  have haffE : ∀ a : Set.range α, IsAffine (B.inclusion.obj (𝒱.X a.1)) := by
    intro a
    obtain ⟨e, _⟩ := hβ a.1
    have : IsAffine (V (β a.1)) := hVaff _
    exact IsAffine.of_isIso e.hom
  have hfpE : ∀ a : Set.range α, FinitePresentation (B.inclusion.map (𝒱.f a.1)) := by
    intro a
    obtain ⟨e, he⟩ := hβ a.1
    obtain ⟨_, _, _⟩ := hqfp (β a.1)
    rw [← he]
    exact ⟨inferInstance, inferInstance, inferInstance⟩
  have hstdE : AlgebraicGeometry.IsStandardHCovering
      (fun a : Set.range α ↦ B.inclusion.map (𝒱.f a.1)) := by
    obtain ⟨𝒲, h𝒲, ⟨ψ⟩⟩ := hstd.2.2.2
    refine ⟨hAfin, haffE, hfpE, 𝒲, h𝒲, ⟨ψ.comp ?_⟩⟩
    exact { s₀ := fun k ↦ ⟨α k, ⟨k, rfl⟩⟩
            h₀ := fun k ↦ (hα k).choose.hom
            w₀ := fun k ↦ (hα k).choose_spec }
  have hhE : IsHCovering (fun a : Set.range α ↦ B.inclusion.obj (𝒱.X a.1))
      (fun a : Set.range α ↦ B.inclusion.map (𝒱.f a.1)) := hstdE.isHCovering
  have hEcov : IsCovering B S hS
      ⟨T, { I₀ := Set.range α
            X := fun a ↦ ⟨Over.mk (𝒱.f a.1 ≫ T.obj.hom), haffE a⟩
            f := fun a ↦ ObjectProperty.homMk (Over.homMk (𝒱.f a.1)) }⟩ := by
    refine ⟨⟨hhE, ?_⟩, hstdE⟩
    have hle : #(Set.range α) ≤ #𝒱.I₀ := Cardinal.mk_le_of_injective Subtype.val_injective
    exact hle.trans h𝒱.2
  refine GrothendieckTopology.superset_covering _ ?_
    (Precoverage.generate_mem_toGrothendieck (J := precoverage B S hS) ⟨_, rfl, hEcov⟩)
  rw [Sieve.generate_le_iff]
  rintro Z f ⟨⟨j, k, rfl⟩⟩
  obtain ⟨e, hiso⟩ := hα k
  have hkey : B.inclusion.map (𝒱.f (α k)) = e.inv ≫ q k := by
    simp [← hiso]
  have hfac : B.inclusion.map (𝒱.f (α k)) =
      (e.inv ≫ φh k) ≫ B.inclusion.map (π₂ (φs k)) := by
    rw [hkey, ← φw k, Category.assoc]
  have hmap : ObjectProperty.homMk (e.inv ≫ φh k) ≫ π₂ (φs k) = 𝒱.f (α k) :=
    B.inclusion.map_injective (by simpa using hfac.symm)
  have hw : π₁ (φs k) ≫ 𝒰.f (φs k) = π₂ (φs k) ≫ g := (hpb (φs k)).w
  refine ⟨𝒰.X (φs k), ObjectProperty.homMk (e.inv ≫ φh k) ≫ π₁ (φs k),
    𝒰.f (φs k), ⟨φs k⟩, ?_⟩
  change (ObjectProperty.homMk (e.inv ≫ φh k) ≫ π₁ (φs k)) ≫ 𝒰.f (φs k) =
    𝒱.f (α k) ≫ g
  rw [Category.assoc, hw, ← Category.assoc, hmap]

/-- Let `B` be a big h site containing a scheme `S`. The inclusion of the big affine h category
over `S` into the big h category over `S` is cocontinuous for the two topologies of Stacks 0EU1.
-/
@[stacks 0EU4 "cocontinuity"]
public theorem isCocontinuous_inclusion :
    (inclusion B S hS).IsCocontinuous (topology B S hS) (BigHOver.topology B S hS) :=
  have : (toSchemes B S hS).IsCocontinuous (topology B S hS) B.topology :=
    Functor.isCocontinuous_toGrothendieck_of_forall_pullback _ _ _
      (generate_pullback_functorPullback_mem B S hS)
  Functor.isCocontinuous_over _ _ _

/-- Every object of a big h site carries a chosen covering family all of whose members are
affine. -/
private theorem exists_isCovering_isAffine (B : BigHSite.{u}) (T : B.Schemes) :
    ∃ G : PreZeroHypercover.{u + 1} T, B.IsCovering ⟨T, G⟩ ∧
      ∀ j, IsAffine (B.inclusion.obj (G.X j)) := by
  classical
  let O := B.inclusion.obj T
  let U := O.affineOpenCover.openCover
  let E := U.toPreZeroHypercover
  let E' := E.shrink
  have hEaff (i : E.I₀) : IsAffine (E.X i) := by
    change IsAffine (Spec (O.affineOpenCover.X i))
    exact isAffine_Spec _
  have hE' (i : E'.I₀) : IsOpenImmersion (E'.f i) ∧ IsAffine (E'.X i) := by
    obtain ⟨j, hX, hf⟩ := Presieve.ofArrows_surj E.f _ i.2
    have h : IsAffine i.1.1 := hX ▸ hEaff j
    have : IsOpenImmersion (eqToHom hX.symm) := inferInstance
    exact ⟨by change IsOpenImmersion i.1.2; rw [hf]; infer_instance, h⟩
  have hopen := fun i ↦ (hE' i).1
  have hcover : ∀ x : O, ∃ i, x ∈ Set.range (E'.f i) := by
    intro x
    obtain ⟨i, y, hy⟩ := U.exists_eq x
    refine ⟨E.toShrink.s₀ i, ?_⟩
    have hf : (E.toShrink.h₀ i ≫ E'.f (E.toShrink.s₀ i)) y = x :=
      (congrArg (fun f ↦ f y) (E.toShrink.w₀ i)).trans hy
    exact ⟨E.toShrink.h₀ i y, by simpa only [Scheme.Hom.comp_apply] using hf⟩
  let V : O.OpenCover.{u + 1} :=
    { I₀ := E'.I₀
      X := E'.X
      f := E'.f
      mem₀ := by
        rw [Scheme.presieve₀_mem_precoverage_iff]
        exact ⟨hcover, hopen⟩ }
  have hV : IsHCovering V.X V.f := ⟨fun _ ↦ inferInstance, IsPHCovering.of_openCover V⟩
  have hsmall : ∀ i, (V.X i).size < B.cutoff :=
    fun i ↦ Scheme.size_lt_of_isOpenImmersion (V.f i) T.2
  let W : PreZeroHypercover.{u + 1} T :=
    { I₀ := V.I₀
      X i := ⟨V.X i, hsmall i⟩
      f i := ObjectProperty.homMk (V.f i) }
  have hW : IsHCoveringInCutoff (κ := B.cutoff) ⟨T, W⟩ := hV
  obtain ⟨⟨T', G⟩, hG, hT, hcomb⟩ := B.covering_representative ⟨T, W⟩ hW
  cases hT
  refine ⟨G, hG, fun j ↦ ?_⟩
  obtain ⟨-, β, hY, -⟩ : PreZeroHypercover.CombinatoriallyEquivalent W G := hcomb
  rw [hY j]
  exact (hE' (β j)).2

/-- The inclusion of the big affine h site into the big h site over `S` is cover dense: every
object of the big h category over `S` is covered by affine objects of the site. -/
private theorem isCoverDense_inclusion (B : BigHSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) :
    (inclusion B S hS).IsCoverDense (BigHOver.topology B S hS) := by
  classical
  constructor
  intro X
  obtain ⟨G, hG, hGaff⟩ := exists_isCovering_isAffine B X.left
  let Vobj (j : G.I₀) : BigAffineH B S hS :=
    { obj := Over.mk (G.f j ≫ X.hom)
      property := hGaff j }
  let vf (j : G.I₀) : (inclusion B S hS).obj (Vobj j) ⟶ X := Over.homMk (G.f j)
  have hBcover : Sieve.ofArrows
      (fun j ↦ (inclusion B S hS).obj (Vobj j)) vf ∈ BigHOver.topology B S hS X := by
    rw [BigHOver.topology, GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
    change Sieve.ofArrows G.X G.f ∈ B.topology X.left
    have hpre : G.presieve₀ ∈ B.precoverage X.left := ⟨G, rfl, hG⟩
    simpa [PreZeroHypercover.presieve₀] using
      Precoverage.generate_mem_toGrothendieck hpre
  refine (BigHOver.topology B S hS).superset_covering ?_ hBcover
  rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
  exact fun j ↦ Presieve.in_coverByImage (inclusion B S hS) (vf j)

/-- The inclusion of the big affine h site into the big h site over `S` carries covering
sieves to covering sieves. -/
private theorem coverPreserving_inclusion (B : BigHSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) :
    CoverPreserving (topology B S hS) (BigHOver.topology B S hS) (inclusion B S hS) := by
  have : HasLimitsOfShape WalkingCospan B.Schemes := inferInstance
  have : HasLimitsOfShape WalkingCospan (BigHOver B S hS) := inferInstance
  have : HasPullbacks (BigHOver B S hS) := inferInstance
  have : PreservesLimitsOfShape WalkingCospan B.inclusion := by infer_instance
  have : PreservesLimitsOfShape WalkingCospan (BigHOver.forget B S hS) := by infer_instance
  have : PreservesLimitsOfShape WalkingCospan (BigHOver.toScheme B S hS) := by infer_instance
  have hIso : (BigHOver.IsAffineOver B S hS).IsClosedUnderIsomorphisms := ⟨fun e h ↦ by
    change IsAffine ((BigHOver.toScheme B S hS).obj _) at h ⊢
    exact IsAffine.of_isIso ((BigHOver.toScheme B S hS).map e.inv)⟩
  have hLim : (BigHOver.IsAffineOver B S hS).IsClosedUnderLimitsOfShape WalkingCospan := by
    apply ObjectProperty.IsClosedUnderLimitsOfShape.mk'
    rintro X ⟨F, hF⟩
    let D := F ⋙ BigHOver.toScheme B S hS
    have : IsAffine (D.obj WalkingCospan.left) := hF WalkingCospan.left
    have : IsAffine (D.obj WalkingCospan.right) := hF WalkingCospan.right
    have : IsAffine (D.obj WalkingCospan.one) := hF WalkingCospan.one
    have hlim : IsAffine (limit D) := by
      have : IsAffine (pullback (D.map WalkingCospan.Hom.inl)
          (D.map WalkingCospan.Hom.inr)) := inferInstance
      exact IsAffine.of_isIso (HasLimit.isoOfNatIso (diagramIsoCospan D)).hom
    exact IsAffine.of_isIso (preservesLimitIso (BigHOver.toScheme B S hS) F).hom
  have : HasLimitsOfShape WalkingCospan (BigAffineH B S hS) := inferInstance
  have : HasPullbacks (BigAffineH B S hS) := inferInstance
  have : PreservesLimitsOfShape WalkingCospan (inclusion B S hS) := by infer_instance
  apply coverPreserving_of_generators (inclusion B S hS) (precoverage B S hS)
    (BigHOver.topology B S hS)
  intro X R hR
  obtain ⟨E, rfl, hE⟩ := hR
  rw [← Sieve.generate_map_eq_functorPushforward, GrothendieckTopology.mem_over_iff,
    Sieve.overEquiv_generate]
  have hbase : Presieve.map (BigHOver.forget B S hS)
      ((E.map (inclusion B S hS)).presieve₀) ∈
        B.precoverage (((inclusion B S hS).obj X).left) := by
    refine ⟨(E.map (inclusion B S hS)).map (BigHOver.forget B S hS), ?_, hE.1⟩
    simp [PreZeroHypercover.presieve₀_map]
  apply B.topology.superset_covering _ (Precoverage.generate_mem_toGrothendieck hbase)
  rw [Sieve.generate_le_iff, PreZeroHypercover.presieve₀_map]
  exact le_trans
    (Presieve.map_le_functorPushforward (F := BigHOver.forget B S hS)
      (Presieve.map (inclusion B S hS) E.presieve₀))
    (Sieve.le_generate _)

/-- Let `B` be a big h site containing a scheme `S`. The inclusion of the big affine h category
over `S` into the big h category over `S` exhibits the big affine h site as a *dense subsite* of
the big h site over `S`, in the sense of `CategoryTheory.Functor.IsDenseSubsite`; consequently
the two halves of the induced morphism of topoi are equivalences of categories and
`Sh((Aff/S)_h) ≃ Sh((Sch/S)_h)`. -/
@[stacks 0EU4 "equivalence of topoi"]
public instance isDenseSubsite_inclusion :
    (inclusion B S hS).IsDenseSubsite (topology B S hS) (BigHOver.topology B S hS) := by
  have hfaithful : ∀ ⦃U' U : BigAffineH B S hS⦄ (a b : U' ⟶ U),
      (inclusion B S hS).map a = (inclusion B S hS).map b →
        Sieve.equalizer a b ∈ topology B S hS U' := by
    intro U' U a b hab
    obtain rfl := (inclusion B S hS).map_injective hab
    simp
  have hfull : ∀ ⦃U' U : BigAffineH B S hS⦄
      (c : (inclusion B S hS).obj U' ⟶ (inclusion B S hS).obj U),
      (inclusion B S hS).imageSieve c ∈ topology B S hS U' := by
    intro U' U c
    rw [← (inclusion B S hS).map_preimage c, Functor.imageSieve_map]
    exact (topology B S hS).top_mem U'
  have := isCocontinuous_inclusion B S hS
  have := isCoverDense_inclusion B S hS
  exact Functor.isDenseSubsite_of_isCocontinuous (inclusion B S hS) (topology B S hS)
    (BigHOver.topology B S hS) (coverPreserving_inclusion B S hS) hfaithful hfull

/-- The equivalence of sheaf categories attached to the dense subsite, for an arbitrary target
category with the limits needed to form it: restriction along the inclusion is an equivalence
between the sheaves on the big h site over `S` and the sheaves on the big affine h site over
`S`. -/
public noncomputable def sheafEquivInclusion {A : Type*} [Category A]
    [∀ X, Limits.HasLimitsOfShape (StructuredArrow X (inclusion B S hS).op) A] :
    Sheaf (topology B S hS) A ≌ Sheaf (BigHOver.topology B S hS) A :=
  Functor.IsDenseSubsite.sheafEquiv (topology B S hS) (BigHOver.topology B S hS)
    (inclusion B S hS) A

/-- The topos of set-valued sheaves on the big affine h site over `S` is equivalent to the topos
of set-valued sheaves on the big h site over `S`, the equivalence being restriction along the
inclusion. -/
@[stacks 0EU4 "equivalence of topoi"]
public noncomputable def toposEquivInclusion :
    Sheaf (topology B S hS) (Type (u + 1)) ≌
      Sheaf (BigHOver.topology B S hS) (Type (u + 1)) :=
  sheafEquivInclusion B S hS

end BigAffineH

end AlgebraicGeometry
