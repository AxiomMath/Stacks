* [Stacks Project, Tag 04EX](https://stacks.math.columbia.edu/tag/04EX)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v

namespace AlgebraicGeometry

namespace BigHOver

variable (B : BigHSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
variable (F : (BigHOver B S hS)ᵒᵖ ⥤ Type v)

/-- Base changing along a thickening of finite presentation does not change the sheaf condition
for a one-element family.

This is the step "we may replace `Y` by `Y₀` and `X` by `X₀`" in the sufficiency direction of
Stacks 0EVF.  Both sheaf conditions are rewritten as the bijectivity of the canonical map to the
equalizer attached to the chosen fibre product of the morphism with itself, by
`AlgebraicGeometry.isSheafFor_singleton_iff_bijective_mapToEqualizer`.  The two equalizer data
are compared by `u`, by `v` and by the induced morphism `q : X₀ ×_{Y₀} X₀ ⟶ X ×_Y X`, each of
which is a thickening of finite presentation on underlying schemes — `u` by hypothesis, `v` and
`q` because they are base changes of `u`, the latter by
`CategoryTheory.IsPullback.pullbackFst` — and therefore sent to a bijection by Interlude A,
`AlgebraicGeometry.BigHOver.bijective_map_of_isThickening`.  The transport is
`CategoryTheory.regularTopology.bijective_mapToEqualizer_of_bijective`. -/
public theorem isSheafFor_singleton_of_isSheafFor_singleton_of_isThickening
    (hZ : BigHOver.IsZariskiSheaf B S hS F)
    (h3 : BigHOver.IsAffineAlmostBlowUpSheaf B S hS F)
    {X Y X₀ Y₀ : BigHOver B S hS} (f : X ⟶ Y) (f₀ : X₀ ⟶ Y₀) (u : Y₀ ⟶ Y) (v : X₀ ⟶ X)
    (hcart : IsPullback
      ((BigHOver.toScheme B S hS).map v) ((BigHOver.toScheme B S hS).map f₀)
      ((BigHOver.toScheme B S hS).map f) ((BigHOver.toScheme B S hS).map u))
    (hthick : Stacks.Thickenings.IsThickening ((BigHOver.toScheme B S hS).map u))
    (hfp : FinitePresentation ((BigHOver.toScheme B S hS).map u))
    (h : Presieve.IsSheafFor F (Presieve.singleton f₀)) :
    Presieve.IsSheafFor F (Presieve.singleton f) := by
  let := schemeSizeBelow_isClosedUnderLimitsOfShape_walkingCospan B.cutoff
  let : Limits.PreservesLimitsOfShape Limits.WalkingCospan (BigHOver.toScheme B S hS) :=
    inferInstance
  let : Limits.ReflectsLimitsOfShape Limits.WalkingCospan (BigHOver.toScheme B S hS) :=
    inferInstance
  -- The given square is cartesian already in the site, whose inclusion into schemes preserves
  -- fibre products and reflects isomorphisms.
  have hcartSite : IsPullback v f₀ f u :=
    IsPullback.of_map (BigHOver.toScheme B S hS)
      ((BigHOver.toScheme B S hS).map_injective
        (by simpa only [Functor.map_comp] using hcart.w)) hcart
  have hsq : f₀ ≫ u = v ≫ f := hcartSite.w.symm
  -- The two chosen fibre products of the site and the comparison morphism between them.
  have hWsite : IsPullback (Limits.pullback.fst f f) (Limits.pullback.snd f f) f f :=
    IsPullback.of_hasPullback f f
  have hW₀site : IsPullback (Limits.pullback.fst f₀ f₀) (Limits.pullback.snd f₀ f₀) f₀ f₀ :=
    IsPullback.of_hasPullback f₀ f₀
  -- The comparison morphism is again a base change of `u`, so all three comparison morphisms
  -- are thickenings of finite presentation and Interlude A sends them to bijections.
  have hQ := Functor.map_isPullback (BigHOver.toScheme B S hS)
    ((IsPullback.pullbackFst hcartSite).paste_vert hcartSite)
  -- Interlude A applies to every base change of `u` along a morphism of the site.
  have key : ∀ {T T' : BigHOver B S hS} (w : T ⟶ T') {c d},
      IsPullback ((BigHOver.toScheme B S hS).map w) c d ((BigHOver.toScheme B S hS).map u) →
      Function.Bijective (F.map w.op) := fun _ _ _ hP =>
    bijective_map_of_isThickening B S hS F hZ h3 _
      (Stacks.Thickenings.isThickening_of_isPullback hP hthick)
      (MorphismProperty.of_isPullback hP.flip hfp)
  rw [isSheafFor_singleton_iff_bijective_mapToEqualizer f _ _ hWsite]
  rw [isSheafFor_singleton_iff_bijective_mapToEqualizer f₀ _ _ hW₀site] at h
  exact regularTopology.bijective_mapToEqualizer_of_bijective F f _ _ hWsite.w f₀ _ _ hW₀site.w
    u v _ hsq (pullback.lift_fst _ _ _).symm
    (pullback.lift_snd _ _ _).symm
    (bijective_map_of_isThickening B S hS F hZ h3 u hthick hfp)
    (key v hcart) (key _ hQ) h

end BigHOver

end AlgebraicGeometry

end
