@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe w t v u

namespace CategoryTheory.Functor

/-- A stack in groupoids for a topology is a stack in groupoids for every coarser topology.

All three conditions of Stacks 02ZI are indexed by the families whose generated sieve is covering,
so shrinking the topology only shrinks the family of conditions. -/
public theorem IsStackInGroupoids.mono {𝒞 : Type*} [Category 𝒞] {𝒮 : Type*} [Category 𝒮]
    {p : 𝒮 ⥤ 𝒞} {J J' : GrothendieckTopology 𝒞} (hJ : J' ≤ J)
    (hp : p.IsStackInGroupoids.{w} J) : p.IsStackInGroupoids.{w} J' where
  isFiberedInGroupoids := hp.isFiberedInGroupoids
  isom_isSheaf := by
    intro U x y hx hy I V f hf
    exact hp.isom_isSheaf x y hx hy V f (hJ _ hf)
  effective_descent := by
    intro U I V f hf
    exact hp.effective_descent V f (hJ _ hf)

end CategoryTheory.Functor

namespace AlgebraicGeometry

namespace BigHOver

variable (B : BigHSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### The Zariski topology on the big h category over `S` -/

/-- The Zariski precoverage on the big h category over `S`: a presieve is covering when it is the
presieve of a family of morphisms of the site whose underlying family of morphisms of schemes is a
Zariski covering.

These are exactly the families the sheaf-level condition (1) of Stacks 0EVI,
`AlgebraicGeometry.BigHOver.IsZariskiSheaf`, is quantified over. -/
public def zariskiPrecoverage : Precoverage (BigHOver B S hS) where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X, E.presieve₀ = R ∧
    (E.map (BigHOver.toScheme B S hS)).presieve₀ ∈
      Scheme.zariskiPrecoverage ((BigHOver.toScheme B S hS).obj X)}

/-- **The Zariski topology on `(Sch/S)_h`.** The Grothendieck topology generated by the families
of morphisms of the site whose underlying family of morphisms of schemes is a Zariski covering.

This is the topology condition (1) of Stacks 0EX9 refers to.  The h topology on the same category
is `AlgebraicGeometry.BigHOver.topology`. -/
@[sga "4 VII 4.2" "special case"]
public abbrev zariskiTopology : GrothendieckTopology (BigHOver B S hS) :=
  (zariskiPrecoverage B S hS).toGrothendieck

/-- The Zariski topology on `(Sch/S)_h` is coarser than the h topology.

A jointly surjective family of open immersions is a Zariski covering, hence a ph covering by
Stacks 0DBH; its members are locally of finite presentation, so the family is an h covering, and
`AlgebraicGeometry.BigHOver.sieve₀_mem_topology_of_isHCovering` turns that into membership of the
h topology. -/
public theorem zariskiTopology_le_topology :
    zariskiTopology B S hS ≤ BigHOver.topology B S hS := by
  rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
  rintro X R ⟨E, rfl, hE⟩
  rw [GrothendieckTopology.mem_toPrecoverage_iff]
  refine sieve₀_mem_topology_of_isHCovering B S hS E ?_
  let O : ((BigHOver.toScheme B S hS).obj X).OpenCover.{u + 1} :=
    ⟨E.map (BigHOver.toScheme B S hS), hE⟩
  refine ⟨fun i ↦ ?_, IsPHCovering.of_openCover O⟩
  have := O.map_prop i
  show LocallyOfFinitePresentation (O.f i)
  infer_instance

/-! ### The three conditions of Stacks 0EX9 -/

variable {𝒳 : Type t} [Category.{v} 𝒳] (p : 𝒳 ⥤ BigHOver B S hS)

/-- **Condition (1) of Stacks 0EX9.** A category fibred in groupoids over the big h category over
`S` is a stack in groupoids for the Zariski topology. -/
public def IsZariskiStackInGroupoids : Prop :=
  p.IsStackInGroupoids.{u + 1} (zariskiTopology B S hS)

/-- For a cartesian square of the site with base `X`, centre `z : Z ⟶ X`, modification
`b : X' ⟶ X` and exceptional corner `E`, the canonical functor
`𝒮_X ⟶ 𝒮_Z ×_{𝒮_E} 𝒮_{X'}`.

An object of `𝒮_X` is sent to its pullbacks along `z` and along `b`, together with the canonical
isomorphism of their further pullbacks to `𝒮_E`, which exists because the two composites
`e ≫ z` and `d ≫ b` around the square agree. -/
public def twoFibreProductComparison [p.IsFibered] {X X' Z E : BigHOver B S hS}
    (b : X' ⟶ X) (z : Z ⟶ X) (d : E ⟶ X') (e : E ⟶ Z)
    (hsq : IsPullback e d z b) :
    p.Fiber X ⥤ CategoricalPullback
      (Functor.IsFibered.fiberPullback (p := p) e)
      (Functor.IsFibered.fiberPullback (p := p) d) :=
  (CategoricalPullback.CatCommSqOver.toFunctorToCategoricalPullback
    (Functor.IsFibered.fiberPullback (p := p) e)
    (Functor.IsFibered.fiberPullback (p := p) d)
    (p.Fiber X)).obj
    { fst := Functor.IsFibered.fiberPullback (p := p) z
      snd := Functor.IsFibered.fiberPullback (p := p) b
      iso := Functor.IsFibered.CartStruct.cmpIso
        (Functor.IsFibered.cartComp z e)
        (hsq.w ▸ Functor.IsFibered.cartComp b d) }

/-- **Condition (2) of Stacks 0EX9.** For every morphism `f : X ⟶ Y` of the site with `Y` affine
and `f` surjective, flat, proper and of finite presentation, and every realization of `X ×_Y X` in
the site, the functor `𝒮_Y ⟶ 𝒮_X ×_{𝒮_{X ×_Y X}} 𝒮_X` is an equivalence of categories.

The displayed functor is `AlgebraicGeometry.BigHOver.twoFibreProductComparison` for the cartesian
square of `f` with itself: the base is `Y`, both legs are `f`, and the exceptional corner is
`X ×_Y X`.  The fibre product is quantified over rather than constructed, as in
`AlgebraicGeometry.isPullback_of_almostBlowUpSquare_bigH`. -/
public def IsAffineFlatProperFinitePresentationStack [p.IsFibered] : Prop :=
  ∀ (Y X W : BigHOver B S hS) (f : X ⟶ Y) (pr₁ pr₂ : W ⟶ X)
      (hW : IsPullback pr₁ pr₂ f f),
    IsAffine ((BigHOver.toScheme B S hS).obj Y) →
    Flat ((BigHOver.toScheme B S hS).map f) →
    IsProper ((BigHOver.toScheme B S hS).map f) →
    Surjective ((BigHOver.toScheme B S hS).map f) →
    FinitePresentation ((BigHOver.toScheme B S hS).map f) →
    (twoFibreProductComparison B S hS p f f pr₂ pr₁ hW).IsEquivalence

/-- **Condition (2) of Stacks 0EX9, corrected: descent along the morphism.** For every morphism
`f : X ⟶ Y` of the site with `Y` affine and `f` surjective, flat, proper and of finite
presentation, the functor from the fibre `𝒮_Y` to the category of descent data relative to the
one-element family `{f}` is an equivalence of categories.

The source's condition (2) asks instead for the comparison functor
`𝒮_Y ⟶ 𝒮_X ×_{𝒮_{X ×_Y X}} 𝒮_X` onto the two-fibre product to be an equivalence; that is
`AlgebraicGeometry.BigHOver.IsAffineFlatProperFinitePresentationStack`.  The two differ by the
cocycle condition over `X ×_Y X ×_Y X`, which a descent datum carries and an object of the
two-fibre product does not, and the literal condition fails for every h stack with a nontrivial
automorphism over an affine object, by the fold-map computation in the module documentation. This
form is the one the source's proof actually uses.  It depends on the generated sieve only,
`CategoryTheory.Pseudofunctor.DescentData.isEquivalence_toDescentData_iff_of_sieve_eq`, so the
index type of the one-element family is immaterial. -/
public def IsAffineFlatProperFinitePresentationDescent [p.IsFibered] : Prop :=
  ∀ (Y X : BigHOver B S hS) (f : X ⟶ Y),
    IsAffine ((BigHOver.toScheme B S hS).obj Y) →
    Flat ((BigHOver.toScheme B S hS).map f) →
    IsProper ((BigHOver.toScheme B S hS).map f) →
    Surjective ((BigHOver.toScheme B S hS).map f) →
    FinitePresentation ((BigHOver.toScheme B S hS).map f) →
    ((Functor.IsFibered.pullbackPseudofunctor p).toDescentData
      (fun _ : PUnit.{u + 2} ↦ f)).IsEquivalence

/-- **Condition (3) of Stacks 0EX9 for the shape of Example 0EVG.** For every almost blowup square
of the site which has affine base and the shape of Example 0EVG, the functor
`𝒮_X ⟶ 𝒮_Z ×_{𝒮_E} 𝒮_{X'}` is an equivalence of categories.

The hypothesis list is the one of condition (3) of Stacks 0EVI,
`AlgebraicGeometry.BigHOver.IsOneGeneratorAlmostBlowUpSheaf`, so that this condition ranges over
exactly the squares that one ranges over; in particular the shape is
`AlgebraicGeometry.IsOneGeneratorAlmostBlowUpModel`, reused from there. -/
public def IsOneGeneratorAlmostBlowUpStack [p.IsFibered] : Prop :=
  ∀ (X X' Z E : BigHOver B S hS) (b : X' ⟶ X) (z : Z ⟶ X) (d : E ⟶ X') (e : E ⟶ Z)
      (I : ((BigHOver.toScheme B S hS).obj X).IdealSheafData),
    IsAffine ((BigHOver.toScheme B S hS).obj X) →
    IsAlmostBlowUpSquare I ((BigHOver.toScheme B S hS).map b) →
    Nonempty (Over.mk ((BigHOver.toScheme B S hS).map z) ≅ Over.mk I.subschemeι) →
    ∀ hsq : IsPullback e d z b,
    IsPullback
      ((BigHOver.toScheme B S hS).map e)
      ((BigHOver.toScheme B S hS).map d)
      ((BigHOver.toScheme B S hS).map z)
      ((BigHOver.toScheme B S hS).map b) →
    IsOneGeneratorAlmostBlowUpModel
      ((BigHOver.toScheme B S hS).map b) ((BigHOver.toScheme B S hS).map z) →
    (twoFibreProductComparison B S hS p b z d e hsq).IsEquivalence

/-- **Condition (3) of Stacks 0EX9 for the shape of Example 0EVH.** For every almost blowup square
of the site which has affine base and the shape of Example 0EVH, the functor
`𝒮_X ⟶ 𝒮_Z ×_{𝒮_E} 𝒮_{X'}` is an equivalence of categories.

The hypothesis list is the one of condition (4) of Stacks 0EVI,
`AlgebraicGeometry.BigHOver.IsTwoGeneratorAlmostBlowUpSheaf`, and the shape is
`AlgebraicGeometry.IsTwoGeneratorAlmostBlowUpModel`, reused from there. -/
public def IsTwoGeneratorAlmostBlowUpStack [p.IsFibered] : Prop :=
  ∀ (X X' Z E : BigHOver B S hS) (b : X' ⟶ X) (z : Z ⟶ X) (d : E ⟶ X') (e : E ⟶ Z)
      (I : ((BigHOver.toScheme B S hS).obj X).IdealSheafData),
    IsAffine ((BigHOver.toScheme B S hS).obj X) →
    IsAlmostBlowUpSquare I ((BigHOver.toScheme B S hS).map b) →
    Nonempty (Over.mk ((BigHOver.toScheme B S hS).map z) ≅ Over.mk I.subschemeι) →
    ∀ hsq : IsPullback e d z b,
    IsPullback
      ((BigHOver.toScheme B S hS).map e)
      ((BigHOver.toScheme B S hS).map d)
      ((BigHOver.toScheme B S hS).map z)
      ((BigHOver.toScheme B S hS).map b) →
    IsTwoGeneratorAlmostBlowUpModel
      ((BigHOver.toScheme B S hS).map b) ((BigHOver.toScheme B S hS).map z) →
    (twoFibreProductComparison B S hS p b z d e hsq).IsEquivalence

/-! ### Necessity of condition (1) -/

/-- **Stacks 0EX9, necessity of condition (1).** A category fibred in groupoids over the big h
category over `S` which is a stack in groupoids for the h topology is a stack in groupoids for the
Zariski topology.

The Zariski topology on `(Sch/S)_h` is coarser than the h topology,
`AlgebraicGeometry.BigHOver.zariskiTopology_le_topology`, and the conditions of Stacks 02ZI are
indexed by the covering families of the topology. -/
@[stacks 0EX9 "only if, condition (1)"]
public theorem isZariskiStackInGroupoids_of_isStackInGroupoids
    (hp : p.IsStackInGroupoids.{u + 1} (BigHOver.topology B S hS)) :
    BigHOver.IsZariskiStackInGroupoids B S hS p :=
  hp.mono (zariskiTopology_le_topology B S hS)

/-! ### Descent along the morphisms condition (2) is about -/

/-- A stack in groupoids for the h topology has effective descent, and descent for morphisms,
along every morphism of the site which is proper, surjective and of finite presentation: the
canonical functor from the fibre over the target to the category of descent data of the
one-element family is an equivalence.

Such a morphism is an h covering all by itself, by Stacks 0ETW, so this is
`CategoryTheory.Functor.isEquivalence_toDescentData_of_isStack` for that covering, through the
bridge `CategoryTheory.Functor.isStack_of_isStackInGroupoids` from Stacks 02ZI to Stacks 026F —
available here because the site has pullbacks and its index universe is `u + 1`.

This is *not* condition (2) of Stacks 0EX9.  Condition (2) asks for an equivalence onto the
two-fibre product `𝒮_X ×_{𝒮_{X ×_Y X}} 𝒮_X`, whose objects carry no cocycle condition over the
triple overlap, while the category of descent data imposes one; the two are not interchangeable,
and identifying them for a one- or two-element family is exactly the input this development does
not have.  What is proved here is the descent statement that the h topology does give. -/
public theorem isEquivalence_toDescentData_singleton_of_isStackInGroupoids [p.IsFibered]
    (hp : p.IsStackInGroupoids.{u + 1} (BigHOver.topology B S hS))
    {X Y : BigHOver B S hS} (f : Y ⟶ X)
    (hproper : IsProper ((BigHOver.toScheme B S hS).map f))
    (hsurj : Surjective ((BigHOver.toScheme B S hS).map f))
    (hfp : FinitePresentation ((BigHOver.toScheme B S hS).map f)) :
    ((Functor.IsFibered.pullbackPseudofunctor p).toDescentData
      (PreZeroHypercover.singleton.{u + 1} f).f).IsEquivalence := by
  have hE : IsHCovering
      ((PreZeroHypercover.singleton.{u + 1} f).map (BigHOver.toScheme B S hS)).X
      ((PreZeroHypercover.singleton.{u + 1} f).map (BigHOver.toScheme B S hS)).f :=
    (surjective_proper_isHCovering ((BigHOver.toScheme B S hS).map f) hfp).reindex
      (Equiv.ofUnique PUnit.{u + 2} Unit)
  have hsieve := sieve₀_mem_topology_of_isHCovering B S hS
    (PreZeroHypercover.singleton.{u + 1} f) hE
  have hst : p.IsStack (BigHOver.topology B S hS) :=
    Functor.isStack_of_isStackInGroupoids hp
  exact Functor.isEquivalence_toDescentData_of_isStack p hst
    (PreZeroHypercover.singleton.{u + 1} f).f hsieve

/-- **Stacks 0EX9, necessity of condition (2) in its descent form.** A category fibred in
groupoids over the big h category over `S` which is a stack in groupoids for the h topology has
effective descent, with descent of morphisms, along every surjective flat proper morphism of finite
presentation onto an affine object of the site.

Flatness and affineness of the target are not used:
`AlgebraicGeometry.BigHOver.isEquivalence_toDescentData_singleton_of_isStackInGroupoids` holds for
every proper surjection of finite presentation, such a morphism being an h covering by itself. -/
@[stacks 0EX9 "only if, condition (2) in its descent form"]
public theorem isAffineFlatProperFinitePresentationDescent_of_isStackInGroupoids [p.IsFibered]
    (hp : p.IsStackInGroupoids.{u + 1} (BigHOver.topology B S hS)) :
    IsAffineFlatProperFinitePresentationDescent B S hS p :=
  fun _ _ f _ _ hproper hsurj hfp ↦
    isEquivalence_toDescentData_singleton_of_isStackInGroupoids B S hS p hp f hproper hsurj hfp

end BigHOver

end AlgebraicGeometry

end
