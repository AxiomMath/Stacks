module

public import StacksFrontier.AlgebraicGeometry.Divisors.LocallyGeneratedBy
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.AlmostBlowUp.PrincipalCenterHDescent
public import StacksFrontier.AlgebraicGeometry.Topologies.HTopology.AffineAlmostBlowUpInterludeB
public import StacksFrontier.AlgebraicGeometry.Topologies.HTopology.AlmostBlowUpSquareGluing

/-!
# The base change of an almost blowup square inside the big h site, and the induction variable

The induction in the proof of Stacks 0EVI runs on two predicates for a presheaf on the big h
category over `S`: that it sends to a cartesian square of sets every almost blowup square of the
site whose centre is *locally* generated by `r` sections, and the same for an affine base and a
centre generated by `r` global sections.  The second implies the first, because cartesianness of
the image of a square is local on the base and the base change of an almost blowup square is one.

## Main definitions

* `AlgebraicGeometry.BigHOver.IsLocalGeneratorAlmostBlowUpSheaf`: the image of every almost
  blowup square of the site whose centre is locally generated by `r` sections is cartesian.
* `AlgebraicGeometry.BigHOver.IsAffineGeneratorAlmostBlowUpSheaf`: the same for an affine base and
  a centre generated by `r` global sections.

## Main results

* `AlgebraicGeometry.BigHOver.isAlmostBlowUpSquare_pullback_fst` and
  `AlgebraicGeometry.BigHOver.nonempty_over_iso_comap_pullback_fst`: the base change of an almost
  blowup square of the site along an arbitrary morphism into its base is an almost blowup square
  of the site, with the inverse-image centre.
* `AlgebraicGeometry.BigHOver.isLocalGeneratorAlmostBlowUpSheaf_of_isAffineGenerator`: the affine
  predicate implies the local one.

## Implementation notes

The fibre products are the ones of the site; the inclusion of the site into schemes preserves
them, and `CategoryTheory.Limits.PreservesPullback.iso` is the comparison with the fibre product
of schemes, which is why the almost blowup property of the base change is the one of Stacks 0EV7
precomposed with an isomorphism.

The restriction of the exceptional corner is `AlgebraicGeometry.BigHOver.restrictExcToMod` and
`AlgebraicGeometry.BigHOver.restrictExcToCen`, already used by Interlude B of the proof of the
sufficiency direction of Stacks 0EVF, and the covering of the new base is the one of
`AlgebraicGeometry.BigHOver.preZeroHypercoverOfOpenCover` applied to the affine opens on which the
inverse-image centre is generated by `r` sections.

## References

* [Stacks Project, Tag 0EVI](https://stacks.math.columbia.edu/tag/0EVI)
* [Stacks Project, Tag 0EV7](https://stacks.math.columbia.edu/tag/0EV7)
* [Stacks Project, Tag 0EVF](https://stacks.math.columbia.edu/tag/0EVF)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v

namespace AlgebraicGeometry

/-! ### Restricting a generating family to an affine open subscheme -/

/-- **The restriction of an ideal sheaf to an affine open on which it is generated by `r`
sections is generated by `r` sections.** The ideal of global sections of the inverse image on the
open subscheme is the ideal of the given ideal sheaf there, read through the isomorphism of global
sections of the open immersion. -/
public theorem exists_span_range_comap_ideal_top {X : Scheme.{u}} (I : X.IdealSheafData)
    (U : X.affineOpens) {r : ℕ}
    (h : ∃ g : Fin r → Γ(X, U.1), I.ideal U = Ideal.span (Set.range g)) :
    letI : IsAffine (U.1 : Scheme.{u}) := U.2
    ∃ g : Fin r → Γ((U.1 : Scheme.{u}), ⊤),
      (I.comap U.1.ι).ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span (Set.range g) := by
  let : IsAffine (U.1 : Scheme.{u}) := U.2
  have hA : Γ((U.1 : Scheme.{u}), ⊤) = Γ(X, U.1) := by
    show Γ(X, (Scheme.Hom.opensFunctor U.1.ι).obj ⊤) = Γ(X, U.1)
    rw [Scheme.Opens.ι_image_top]
  exact Stacks.Divisors.spanRange_heq hA.symm (Stacks.Divisors.ideal_comap_top_heq I U).symm h

namespace BigHOver

variable (B : BigHSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### The base change of a square of the site -/

/-- The inclusion of the site into schemes preserves fibre products. -/
private theorem preservesLimitsOfShape_walkingCospan_toScheme :
    PreservesLimitsOfShape WalkingCospan (BigHOver.toScheme B S hS) := by
  have : HasPullbacks B.Schemes := inferInstance
  let _ := schemeSizeBelow_isClosedUnderLimitsOfShape_walkingCospan B.cutoff
  exact inferInstance

/-- **The base change of an almost blowup square of the site is an almost blowup square.** The new
centre is the inverse image of the old one and the new modification is the fibre product of the
site. -/
public theorem isAlmostBlowUpSquare_pullback_fst {X X' W : BigHOver B S hS} (b : X' ⟶ X)
    (h : W ⟶ X) (I : ((BigHOver.toScheme B S hS).obj X).IdealSheafData)
    (hb : IsAlmostBlowUpSquare I ((BigHOver.toScheme B S hS).map b)) :
    IsAlmostBlowUpSquare (I.comap ((BigHOver.toScheme B S hS).map h))
      ((BigHOver.toScheme B S hS).map (pullback.fst h b)) := by
  have := preservesLimitsOfShape_walkingCospan_toScheme B S hS
  rw [← Limits.PreservesPullback.iso_hom_fst (BigHOver.toScheme B S hS) h b]
  exact isAlmostBlowUpSquare_isIso_comp _ (isAlmostBlowUpSquare_baseChange I
    ((BigHOver.toScheme B S hS).map b) ((BigHOver.toScheme B S hS).map h) hb) _

/-- **The centre of the base change of a square of the site is cut out by the inverse-image
centre.** -/
public theorem nonempty_over_iso_comap_pullback_fst {X Z W : BigHOver B S hS} (z : Z ⟶ X)
    (h : W ⟶ X) (I : ((BigHOver.toScheme B S hS).obj X).IdealSheafData)
    (hZ : Nonempty (Over.mk ((BigHOver.toScheme B S hS).map z) ≅ Over.mk I.subschemeι)) :
    Nonempty (Over.mk ((BigHOver.toScheme B S hS).map (pullback.fst h z)) ≅
      Over.mk (I.comap ((BigHOver.toScheme B S hS).map h)).subschemeι) := by
  have := preservesLimitsOfShape_walkingCospan_toScheme B S hS
  obtain ⟨ez⟩ := hZ
  have e1 : Over.mk ((BigHOver.toScheme B S hS).map (pullback.fst h z)) ≅
      Over.mk (pullback.fst ((BigHOver.toScheme B S hS).map h)
        ((BigHOver.toScheme B S hS).map z)) :=
    Over.isoMk (Limits.PreservesPullback.iso (BigHOver.toScheme B S hS) h z)
      (Limits.PreservesPullback.iso_hom_fst _ _ _)
  have e3 : Over.mk (I.comap ((BigHOver.toScheme B S hS).map h)).subschemeι ≅
      Over.mk (pullback.fst ((BigHOver.toScheme B S hS).map h) I.subschemeι) :=
    Over.isoMk (I.comapIso ((BigHOver.toScheme B S hS).map h))
      (Scheme.IdealSheafData.comapIso_hom_fst I _)
  exact ⟨e1 ≪≫ pullbackOverIso ((BigHOver.toScheme B S hS).map h)
    ((BigHOver.toScheme B S hS).map z) I.subschemeι ez ≪≫ e3.symm⟩

variable (F : (BigHOver B S hS)ᵒᵖ ⥤ Type v)

/-! ### The two induction variables -/

/-- **The induction variable of the proof of Stacks 0EVI.** A presheaf on the big h category over
`S` sends to a cartesian square of sets every almost blowup square of the site whose centre is
locally generated by `r` sections. -/
public def IsLocalGeneratorAlmostBlowUpSheaf (r : ℕ) : Prop :=
  ∀ (X X' Z E : BigHOver B S hS) (b : X' ⟶ X) (z : Z ⟶ X) (d : E ⟶ X') (e : E ⟶ Z)
      (I : ((BigHOver.toScheme B S hS).obj X).IdealSheafData),
    IsAlmostBlowUpSquare I ((BigHOver.toScheme B S hS).map b) →
    Nonempty (Over.mk ((BigHOver.toScheme B S hS).map z) ≅ Over.mk I.subschemeι) →
    IsPullback ((BigHOver.toScheme B S hS).map e) ((BigHOver.toScheme B S hS).map d)
      ((BigHOver.toScheme B S hS).map z) ((BigHOver.toScheme B S hS).map b) →
    Stacks.Divisors.IsLocallyGeneratedBy r I →
    IsPullback (F.map z.op) (F.map b.op) (F.map e.op) (F.map d.op)

/-- **The affine form of the induction variable of the proof of Stacks 0EVI.** A presheaf on the
big h category over `S` sends to a cartesian square of sets every almost blowup square of the site
whose base is affine and whose centre is generated by `r` global sections. -/
public def IsAffineGeneratorAlmostBlowUpSheaf (r : ℕ) : Prop :=
  ∀ (X X' Z E : BigHOver B S hS) [IsAffine ((BigHOver.toScheme B S hS).obj X)]
      (b : X' ⟶ X) (z : Z ⟶ X) (d : E ⟶ X') (e : E ⟶ Z)
      (I : ((BigHOver.toScheme B S hS).obj X).IdealSheafData),
    IsAlmostBlowUpSquare I ((BigHOver.toScheme B S hS).map b) →
    Nonempty (Over.mk ((BigHOver.toScheme B S hS).map z) ≅ Over.mk I.subschemeι) →
    IsPullback ((BigHOver.toScheme B S hS).map e) ((BigHOver.toScheme B S hS).map d)
      ((BigHOver.toScheme B S hS).map z) ((BigHOver.toScheme B S hS).map b) →
    (∃ g : Fin r → Γ((BigHOver.toScheme B S hS).obj X, ⊤),
      I.ideal ⟨⊤, isAffineOpen_top ((BigHOver.toScheme B S hS).obj X)⟩ =
        Ideal.span (Set.range g)) →
    IsPullback (F.map z.op) (F.map b.op) (F.map e.op) (F.map d.op)

/-- A centre generated by fewer sections is covered by the hypothesis for more, so the local
induction variable is antitone. -/
public theorem IsLocalGeneratorAlmostBlowUpSheaf.antitone {r s : ℕ} (hrs : r ≤ s)
    (h : IsLocalGeneratorAlmostBlowUpSheaf B S hS F s) :
    IsLocalGeneratorAlmostBlowUpSheaf B S hS F r :=
  fun X X' Z E b z d e I hb hZ hsq hlg ↦ h X X' Z E b z d e I hb hZ hsq (hlg.mono hrs)

/-- A centre generated by fewer global sections is covered by the hypothesis for more, so the
affine induction variable is antitone. -/
public theorem IsAffineGeneratorAlmostBlowUpSheaf.antitone {r s : ℕ} (hrs : r ≤ s)
    (h : IsAffineGeneratorAlmostBlowUpSheaf B S hS F s) :
    IsAffineGeneratorAlmostBlowUpSheaf B S hS F r :=
  fun X X' Z E _ b z d e I hb hZ hsq hg ↦
    h X X' Z E b z d e I hb hZ hsq (Stacks.Divisors.exists_span_range_of_le hrs hg)

/-! ### The affine induction variable implies the local one -/

/-- **Cartesianness of the image of an almost blowup square with a centre locally generated by `r`
sections is local on the base.** Over the members of a covering of the base by affine opens on
which the inverse-image centre is generated by `r` global sections the restricted square is an
almost blowup square with affine base and a centre generated by `r` global sections, so the affine
induction variable applies there, and cartesianness glues by
`AlgebraicGeometry.BigHOver.isPullback_of_isLocallyCartesianSquare`.

This is the first step of the proof of Stacks 0EVI, in the form the induction consumes. -/
public theorem isLocalGeneratorAlmostBlowUpSheaf_of_isAffineGenerator (r : ℕ)
    (hzar : BigHOver.IsZariskiSheaf B S hS F)
    (hQ : IsAffineGeneratorAlmostBlowUpSheaf B S hS F r) :
    IsLocalGeneratorAlmostBlowUpSheaf B S hS F r := by
  classical
  intro X X' Z E b z d e I hb hZ hsq hlg
  have := preservesLimitsOfShape_walkingCospan_toScheme B S hS
  have hsqsite : IsPullback e d z b := hsq.of_map_of_faithful (BigHOver.toScheme B S hS)
  have hwsite : e ≫ z = d ≫ b := hsqsite.w
  refine isPullback_of_isLocallyCartesianSquare B S hS F hzar b z d e hwsite ?_
  intro W w
  set wS := (BigHOver.toScheme B S hS).map w
  choose Uo hUoMem hUoGen using hlg.comap wS
  let U0 : ((BigHOver.toScheme B S hS).obj W).OpenCover.{u} :=
    Scheme.openCoverOfIsOpenCover _ (fun y ↦ (Uo y).1)
      (TopologicalSpace.IsOpenCover.mk (TopologicalSpace.Opens.ext
        (Set.eq_univ_of_forall fun y ↦ by
          rw [TopologicalSpace.Opens.coe_iSup]
          exact Set.mem_iUnion.2 ⟨y, hUoMem y⟩)))
  let U : Scheme.OpenCover.{u + 1, u} ((BigHOver.toScheme B S hS).obj W) :=
    U0.reindex (Equiv.ulift.{u + 1, u})
  refine ⟨preZeroHypercoverOfOpenCover U,
    (by simpa [preZeroHypercoverOfOpenCover, PreZeroHypercover.presieve₀, PreZeroHypercover.map]
      using U.mem₀), fun i => ?_⟩
  set x : (BigHOver.toScheme B S hS).obj W := Equiv.ulift.{u + 1, u} i
  have : IsAffine ((BigHOver.toScheme B S hS).obj ((preZeroHypercoverOfOpenCover U).X i)) := by
    show IsAffine ((Uo x).1 : Scheme.{u})
    exact (Uo x).2
  set h : (preZeroHypercoverOfOpenCover U).X i ⟶ X :=
    (preZeroHypercoverOfOpenCover U).f i ≫ w with hh
  have hmapeq : (BigHOver.toScheme B S hS).map h = (Uo x).1.ι ≫ wS := by
    rw [hh, Functor.map_comp]
    rfl
  refine ⟨pullback h b, pullback h z, pullback h (d ≫ b), pullback.fst h b, pullback.fst h z,
    restrictExcToMod B S hS b d h, restrictExcToCen B S hS b z d e hwsite h,
    pullback.snd h b, pullback.snd h z, pullback.snd h (d ≫ b),
    (IsPullback.of_hasPullback h b).flip, (IsPullback.of_hasPullback h z).flip,
    pullback.lift_snd _ _ _, pullback.lift_snd _ _ _, ?_⟩
  refine hQ ((preZeroHypercoverOfOpenCover U).X i) (pullback h b) (pullback h z)
    (pullback h (d ≫ b))
    (pullback.fst h b) (pullback.fst h z) (restrictExcToMod B S hS b d h)
    (restrictExcToCen B S hS b z d e hwsite h)
    (I.comap ((BigHOver.toScheme B S hS).map h))
    (isAlmostBlowUpSquare_pullback_fst B S hS b h I hb)
    (nonempty_over_iso_comap_pullback_fst B S hS z h I hZ)
    ((isPullback_restrictExc B S hS hwsite hsqsite h).map (BigHOver.toScheme B S hS)) ?_
  have hcomapeq :
      I.comap ((BigHOver.toScheme B S hS).map h) = (I.comap wS).comap (Uo x).1.ι := by
    rw [hmapeq]
    exact Scheme.IdealSheafData.comap_comp I (Uo x).1.ι wS
  rw [hcomapeq]
  exact exists_span_range_comap_ideal_top (I.comap wS) (Uo x) (hUoGen x)

end BigHOver

end AlgebraicGeometry

end
