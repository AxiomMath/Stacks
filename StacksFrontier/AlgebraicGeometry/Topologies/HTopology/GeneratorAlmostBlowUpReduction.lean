module

public import StacksFrontier.AlgebraicGeometry.LocallyGeneratedIdealSheaf.Basic
public import StacksFrontier.AlgebraicGeometry.Topologies.BlowUpSquares.CommonRefinement
public import StacksFrontier.AlgebraicGeometry.Topologies.BlowUpSquares.GeneratorModelRecognition
public import StacksFrontier.AlgebraicGeometry.Topologies.HTopology.AlmostBlowUpSheafGluing
public import StacksFrontier.AlgebraicGeometry.Topologies.HTopology.AlmostBlowUpSheafInduction

/-!
# Testing h descent on the one- and two-generator almost blowup squares suffices

More on Flatness, Lemma 0EVI says that a presheaf of sets `F` on the big h site `(Sch/S)_h` is
a sheaf as soon as it is a sheaf for the Zariski topology, satisfies descent for flat proper
surjections of finite presentation over affines, and sends the almost blowup squares of
Examples 0EVG and 0EVH to cartesian squares of sets. By Stacks 0EVF the whole content of the
lemma is the reduction of condition (3) of Stacks 0EVF — cartesianness of the image of *every*
almost blowup square with affine base — to those two shapes, which is what this file proves:
`AlgebraicGeometry.generatorAlmostBlowUpSquaresSuffice`.

The proof is the source's. The centre of an almost blowup square with affine base is cut out by
finitely many functions `f₁, …, f_r`, and one inducts on `r`, in the following form: an almost
blowup square whose centre is locally generated by at most `r` sections is sent to a cartesian
square. Cartesianness is local on the base for a Zariski sheaf
(`AlgebraicGeometry.BigHOver.isPullback_map_of_isPullback_map_pullback`), which reduces each
case to an affine base with `r` global generators.

* With no generator the centre is the whole base and there is nothing to prove.
* With one generator, compare the square with the identity of the base, an almost blowup square
  as in Example 0EVG with `J = 0`: by Stacks 0EVB both are dominated by an almost blowup square
  whose modification is a closed immersion into each of them. A closed immersion of finite
  presentation which is an isomorphism away from a locally principal centre is, affine locally,
  a square of Example 0EVG; so condition (3) of Stacks 0EVI makes the image of the dominating
  square cartesian, and separates sections over the given modification, and a chase gives the
  claim.
* With at least two generators, base change the square along the square of Example 0EVH for
  `f₁, f₂`. On its modification the ideal `(f₁, f₂)` is locally principal, so the centre is
  locally generated by `r - 1` sections; on its centre `f₁` and `f₂` vanish, so the centre is
  generated by `r - 2` sections. Condition (4) of Stacks 0EVI and a chase through the two base
  changes give the claim.

## Main results

* `AlgebraicGeometry.generatorAlmostBlowUpSquaresSuffice`: the reduction, discharging
  `AlgebraicGeometry.GeneratorAlmostBlowUpSquaresSuffice`.
* `AlgebraicGeometry.BigHOver.isSheaf_iff_zariski_and_flatProper_and_generatorSquares`:
  **Stacks 0EVI**.

## References

* [Stacks Project, Tag 0EVI](https://stacks.math.columbia.edu/tag/0EVI)
* [Stacks Project, Tag 0EVF](https://stacks.math.columbia.edu/tag/0EVF)
* [Stacks Project, Tag 0EVB](https://stacks.math.columbia.edu/tag/0EVB)
* [Stacks Project, Tag 0EVG](https://stacks.math.columbia.edu/tag/0EVG)
* [Stacks Project, Tag 0EVH](https://stacks.math.columbia.edu/tag/0EVH)
* [Stacks Project, Tag 0EV7](https://stacks.math.columbia.edu/tag/0EV7)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v

namespace AlgebraicGeometry

/-! ### Kernels of closed immersions which are isomorphisms away from a closed set -/

/-- The ideal of a closed immersion which restricts to an isomorphism over an open vanishes on
that open. -/
theorem comap_ker_eq_bot_of_isIso_morphismRestrict {W Y : Scheme.{u}} (i : W ⟶ Y)
    [IsClosedImmersion i] (U : Y.Opens) [IsIso (i ∣_ U)] : i.ker.comap U.ι = ⊥ := by
  rw [← ker_morphismRestrict_eq_comap]
  exact IsClosedImmersion.isIso_iff_ker_eq_bot.mp inferInstance

/-- The vanishing of the ideal of a closed immersion on an open is stable under base change. -/
theorem comap_ker_pullback_fst_eq_bot {W Y Y' : Scheme.{u}} (i : W ⟶ Y) [IsClosedImmersion i]
    (U : Y.Opens) (h : i.ker.comap U.ι = ⊥) (f : Y' ⟶ Y) :
    (pullback.fst f i).ker.comap (f ⁻¹ᵁ U).ι = ⊥ := by
  rw [Scheme.IdealSheafData.ker_fst_of_isClosedImmersion, ← Scheme.IdealSheafData.comap_comp,
    ← morphismRestrict_ι, Scheme.IdealSheafData.comap_comp, h,
    Scheme.IdealSheafData.comap_bot]

/-- The inverse image of the complement of the support of an ideal sheaf is the complement of the
support of its inverse image. -/
private theorem preimage_compl_support_eq {Y X : Scheme.{u}} (b : Y ⟶ X) (I : X.IdealSheafData) :
    b ⁻¹ᵁ ⟨(I.support : Set X)ᶜ, I.support.isClosed.isOpen_compl⟩ =
      ⟨((I.comap b).support : Set Y)ᶜ, (I.comap b).support.isClosed.isOpen_compl⟩ := by
  ext x
  simp [Scheme.IdealSheafData.support_comap]

/-- Let `b₀` and `i ≫ b₀` be modifications of almost blowup squares with the same centre `I`,
with `i` a closed immersion. Then the ideal of `i` vanishes away from the inverse image of the
centre: both modifications are isomorphisms away from the centre. -/
theorem comap_ker_eq_bot_of_isAlmostBlowUpSquare {W Y X : Scheme.{u}} (i : W ⟶ Y)
    [IsClosedImmersion i] (b₀ : Y ⟶ X) (I : X.IdealSheafData) (h₀ : IsAlmostBlowUpSquare I b₀)
    (h : IsAlmostBlowUpSquare I (i ≫ b₀)) :
    i.ker.comap (Scheme.Opens.ι (X := Y)
      ⟨((I.comap b₀).support : Set Y)ᶜ, (I.comap b₀).support.isClosed.isOpen_compl⟩) = ⊥ := by
  let V : X.Opens := ⟨I.supportᶜ, I.support.isClosed.isOpen_compl⟩
  have : IsIso (b₀ ∣_ V) := isIso_restrict_compl_support I b₀ h₀
  have : IsIso ((i ≫ b₀) ∣_ V) := isIso_restrict_compl_support I (i ≫ b₀) h
  have : IsIso (i ∣_ (b₀ ⁻¹ᵁ V)) := by
    have hcancel : IsIso (((i ≫ b₀) ∣_ V) ≫ inv (b₀ ∣_ V)) := inferInstance
    have heq : ((i ≫ b₀) ∣_ V) ≫ inv (b₀ ∣_ V) = i ∣_ (b₀ ⁻¹ᵁ V) := by
      rw [morphismRestrict_comp]
      simp
    exact heq ▸ hcancel
  rw [← preimage_compl_support_eq b₀ I]
  exact comap_ker_eq_bot_of_isIso_morphismRestrict i _

/-- The closed subscheme cut out by an ideal sheaf pulls the ideal sheaf back to zero; so does
anything isomorphic to it over the ambient scheme. -/
theorem Scheme.IdealSheafData.comap_eq_bot_of_nonempty_overIso {X Z : Scheme.{u}} {z : Z ⟶ X}
    {I : X.IdealSheafData} (h : Nonempty (Over.mk z ≅ Over.mk I.subschemeι)) : I.comap z = ⊥ := by
  obtain ⟨e⟩ := h
  have hw : e.hom.left ≫ I.subschemeι = z := Over.w e.hom
  rw [← hw, Scheme.IdealSheafData.comap_comp]
  have h0 : I.comap I.subschemeι = ⊥ := by
    have := ker_comap_self I.subschemeι
    rwa [Scheme.IdealSheafData.ker_subschemeι] at this
  rw [h0, Scheme.IdealSheafData.comap_bot]

/-- Over an affine base, the identity is the modification of an almost blowup square whose centre
is cut out by a single global section. -/
private theorem isAlmostBlowUpSquare_id_of_eq_span_singleton {X Z : Scheme.{u}} [IsAffine X]
    (z : Z ⟶ X) (I : X.IdealSheafData) (hZ : Nonempty (Over.mk z ≅ Over.mk I.subschemeι))
    (t : Γ(X, ⊤))
    (ht : I.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {t}) : IsAlmostBlowUpSquare I (𝟙 X) := by
  have hker : Scheme.Hom.ker (𝟙 X) = ⊥ := IsClosedImmersion.isIso_iff_ker_eq_bot.mp inferInstance
  obtain ⟨I', hI', hZ'⟩ := exists_isAlmostBlowUpSquare_of_isOneGeneratorAlmostBlowUpModel _ _
    (isOneGeneratorAlmostBlowUpModel_of_isClosedImmersion (𝟙 X) z I hZ t ht
      (by rw [hker, Scheme.IdealSheafData.comap_bot]))
  obtain rfl : I' = I := Scheme.IdealSheafData.eq_of_nonempty_overIso ⟨hZ'.some.symm ≪≫ hZ.some⟩
  exact hI'

namespace BigHOver

variable (B : BigHSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
variable (F : (BigHOver B S hS)ᵒᵖ ⥤ Type v)

local notation "𝒦" => BigHOver.toScheme B S hS

/-! ### Cartesianness at a centre -/

/-- `F` sends every almost blowup square of the site with base `X` and centre `I` to a cartesian
square of sets. -/
private def IsCartesianAt (X : BigHOver B S hS) (I : ((𝒦).obj X).IdealSheafData) : Prop :=
  ∀ (X' Z E : BigHOver B S hS) (b : X' ⟶ X) (z : Z ⟶ X) (p : E ⟶ X') (e : E ⟶ Z),
    IsAlmostBlowUpSquare I ((𝒦).map b) →
    Nonempty (Over.mk ((𝒦).map z) ≅ Over.mk I.subschemeι) →
    IsPullback ((𝒦).map e) ((𝒦).map p) ((𝒦).map z) ((𝒦).map b) →
    IsPullback (F.map z.op) (F.map b.op) (F.map e.op) (F.map p.op)

variable {B S hS F}

/-- The exceptional corner of an almost blowup square of the site is, over the modification, the
closed subscheme cut out by the inverse image of the centre. -/
private theorem nonempty_overIso_exceptional {X X' Z E : BigHOver B S hS} {b : X' ⟶ X}
    {z : Z ⟶ X} {p : E ⟶ X'} {e : E ⟶ Z} (I : ((𝒦).obj X).IdealSheafData)
    (hZ : Nonempty (Over.mk ((𝒦).map z) ≅ Over.mk I.subschemeι))
    (hsq : IsPullback ((𝒦).map e) ((𝒦).map p) ((𝒦).map z) ((𝒦).map b)) :
    Nonempty (Over.mk ((𝒦).map p) ≅ Over.mk (I.comap ((𝒦).map b)).subschemeι) :=
  ⟨(Over.isoMk hsq.flip.isoPullback hsq.flip.isoPullback_hom_fst :
      Over.mk ((𝒦).map p) ≅ Over.mk (pullback.fst ((𝒦).map b) ((𝒦).map z))) ≪≫
    pullbackOverIso ((𝒦).map b) ((𝒦).map z) I.subschemeι hZ.some ≪≫
    Over.isoMk (I.comapIso ((𝒦).map b)).symm
      (Scheme.IdealSheafData.comapIso_inv_subschemeι I ((𝒦).map b))⟩

/-- Cartesianness at the inverse-image centre makes the image of the base change of an almost
blowup square cartesian. -/
private theorem isPullback_baseChange_of_isCartesianAt {X X' Z V : BigHOver B S hS}
    (b : X' ⟶ X) (z : Z ⟶ X) (I : ((𝒦).obj X).IdealSheafData)
    (hb : IsAlmostBlowUpSquare I ((𝒦).map b))
    (hZ : Nonempty (Over.mk ((𝒦).map z) ≅ Over.mk I.subschemeι)) (g : V ⟶ X)
    (h : IsCartesianAt B S hS F V (I.comap ((𝒦).map g))) :
    IsPullback (F.map (pullback.fst g z).op) (F.map (pullback.fst g b).op)
      (F.map (pullback.fst (pullback.fst g z) (pullback.fst g b)).op)
      (F.map (pullback.snd (pullback.fst g z) (pullback.fst g b)).op) :=
  h _ _ _ (pullback.fst g b) (pullback.fst g z)
    (pullback.snd (pullback.fst g z) (pullback.fst g b))
    (pullback.fst (pullback.fst g z) (pullback.fst g b))
    (by
      rw [← pullbackComparison_comp_fst 𝒦 g b]
      exact isAlmostBlowUpSquare_isIso_comp _
        (isAlmostBlowUpSquare_baseChange I ((𝒦).map b) ((𝒦).map g) hb) _)
    (nonempty_overIso_exceptional I hZ
      (isPullback_toScheme_map (IsPullback.of_hasPullback g z).flip))
    (isPullback_toScheme_map (IsPullback.of_hasPullback _ _))

/-- Restricting along two equal composites to the same base gives the same result. -/
private theorem map_map_eq_map_map {X Z W T : BigHOver B S hS} {t : T ⟶ W} {h : W ⟶ X}
    {a : T ⟶ Z} {z : Z ⟶ X} (ht : t ≫ h = a ≫ z) (x : F.obj (op X)) :
    F.map t.op (F.map h.op x) = F.map a.op (F.map z.op x) := by
  rw [← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp, ht]

/-- Two sections over `W` are equal when the image of the base change of a square along
`h : W ⟶ X` is cartesian and the sections agree after restriction along every morphism through
which `h` factors via the centre or via the modification. -/
private theorem eq_of_isPullback_baseChange {X X' Z W : BigHOver B S hS} (b : X' ⟶ X)
    (z : Z ⟶ X) (h : W ⟶ X)
    (hpb : IsPullback (F.map (pullback.fst h z).op) (F.map (pullback.fst h b).op)
      (F.map (pullback.fst (pullback.fst h z) (pullback.fst h b)).op)
      (F.map (pullback.snd (pullback.fst h z) (pullback.fst h b)).op))
    {x y : F.obj (op W)}
    (hz : ∀ {T : BigHOver B S hS} (t : T ⟶ W) (a : T ⟶ Z), t ≫ h = a ≫ z →
      F.map t.op x = F.map t.op y)
    (hb : ∀ {T : BigHOver B S hS} (t : T ⟶ W) (a : T ⟶ X'), t ≫ h = a ≫ b →
      F.map t.op x = F.map t.op y) :
    x = y :=
  Types.ext_of_isPullback hpb (hz _ (pullback.snd h z) pullback.condition)
    (hb _ (pullback.snd h b) pullback.condition)

/-- A pair of sections over the centre and over the modification which agree over the
exceptional corner restrict, along the base change of a square whose image is cartesian, to the
two restrictions of a single section. -/
private theorem exists_of_isPullback_baseChange {X X' Z E V : BigHOver B S hS}
    {b : X' ⟶ X} {z : Z ⟶ X} {p : E ⟶ X'} {e : E ⟶ Z} (hsq : IsPullback e p z b)
    (g : V ⟶ X)
    (hpb : IsPullback (F.map (pullback.fst g z).op) (F.map (pullback.fst g b).op)
      (F.map (pullback.fst (pullback.fst g z) (pullback.fst g b)).op)
      (F.map (pullback.snd (pullback.fst g z) (pullback.fst g b)).op))
    (t : F.obj (op Z)) (s' : F.obj (op X')) (hc : F.map e.op t = F.map p.op s') :
    ∃ w : F.obj (op V), F.map (pullback.fst g z).op w = F.map (pullback.snd g z).op t ∧
      F.map (pullback.fst g b).op w = F.map (pullback.snd g b).op s' := by
  refine Types.exists_of_isPullback hpb _ _ ?_
  have hcomm : (pullback.fst (pullback.fst g z) (pullback.fst g b) ≫ pullback.snd g z) ≫ z
      = (pullback.snd (pullback.fst g z) (pullback.fst g b) ≫ pullback.snd g b) ≫ b := by
    have c₁ : pullback.fst g z ≫ g = pullback.snd g z ≫ z := pullback.condition
    have c₂ : pullback.fst g b ≫ g = pullback.snd g b ≫ b := pullback.condition
    have c₃ : pullback.fst (pullback.fst g z) (pullback.fst g b) ≫ pullback.fst g z
        = pullback.snd (pullback.fst g z) (pullback.fst g b) ≫ pullback.fst g b :=
      pullback.condition
    rw [Category.assoc, ← c₁, ← Category.assoc, c₃, Category.assoc, c₂, ← Category.assoc]
  simpa only [op_comp, FunctorToTypes.map_comp_apply] using
    hsq.map_op_eq_map_op F hc hcomm

/-! ### One generator -/

/-- Let `io` be a closed immersion of finite presentation whose ideal vanishes away from a
closed subscheme `J` of `X'`, and let `g : V ⟶ X'` have affine source along which `J` is cut out
by a single global section. Then `F` sends the base change along `g` of the square of `io` and
`J` to a cartesian square, granted condition (3) of Stacks 0EVI. -/
private theorem isPullback_baseChange_of_eq_span_singleton
    (h3 : IsOneGeneratorAlmostBlowUpSheaf B S hS F) {X' E X'' V : BigHOver B S hS} (p : E ⟶ X')
    (io : X'' ⟶ X') [IsClosedImmersion ((𝒦).map io)] [LocallyOfFinitePresentation ((𝒦).map io)]
    (J : ((𝒦).obj X').IdealSheafData) (hE : Nonempty (Over.mk ((𝒦).map p) ≅ Over.mk J.subschemeι))
    (hker : ((𝒦).map io).ker.comap (Scheme.Opens.ι (X := (𝒦).obj X')
      ⟨(J.support : Set _)ᶜ, J.support.isClosed.isOpen_compl⟩) = ⊥)
    (g : V ⟶ X') [IsAffine ((𝒦).obj V)] (t' : Γ((𝒦).obj V, ⊤))
    (ht' : (J.comap ((𝒦).map g)).ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {t'}) :
    IsPullback (F.map (pullback.fst g p).op) (F.map (pullback.fst g io).op)
      (F.map (pullback.fst (pullback.fst g p) (pullback.fst g io)).op)
      (F.map (pullback.snd (pullback.fst g p) (pullback.fst g io)).op) := by
  have hcomp : (𝒦).map (pullback.fst g io) =
      pullbackComparison 𝒦 g io ≫ pullback.fst ((𝒦).map g) ((𝒦).map io) :=
    (pullbackComparison_comp_fst 𝒦 g io).symm
  have : IsClosedImmersion ((𝒦).map (pullback.fst g io)) := by
    rw [hcomp]
    infer_instance
  have : LocallyOfFinitePresentation ((𝒦).map (pullback.fst g io)) := by
    rw [hcomp]
    infer_instance
  have hcen := nonempty_overIso_exceptional _ hE
    (isPullback_toScheme_map (IsPullback.of_hasPullback g p).flip)
  have hker' : ((𝒦).map (pullback.fst g io)).ker.comap (Scheme.Opens.ι
      ⟨(((J.comap ((𝒦).map g)).support : Set _))ᶜ,
        (J.comap ((𝒦).map g)).support.isClosed.isOpen_compl⟩) = ⊥ := by
    rw [hcomp, Scheme.Hom.ker_comp_of_isIso]
    rw [← preimage_compl_support_eq]
    exact comap_ker_pullback_fst_eq_bot ((𝒦).map io) _ hker ((𝒦).map g)
  have hshape := isOneGeneratorAlmostBlowUpModel_of_isClosedImmersion
    ((𝒦).map (pullback.fst g io)) ((𝒦).map (pullback.fst g p)) (J.comap ((𝒦).map g)) hcen t' ht'
    hker'
  obtain ⟨I', hI', hZ'⟩ :=
    exists_isAlmostBlowUpSquare_of_isOneGeneratorAlmostBlowUpModel _ _ hshape
  exact h3 _ _ _ _ (pullback.fst g io) (pullback.fst g p)
    (pullback.snd (pullback.fst g p) (pullback.fst g io))
    (pullback.fst (pullback.fst g p) (pullback.fst g io)) I' inferInstance hI' hZ'
    (isPullback_toScheme_map (IsPullback.of_hasPullback _ _)) hshape

/-- A closed immersion `io` of finite presentation into the modification `X'` of an almost
blowup square, whose ideal vanishes away from the exceptional subscheme `E`, separates sections
over `X'` together with `E`, granted conditions (1) and (3) of Stacks 0EVI. -/
private theorem eq_of_map_exceptional_of_map_closedImmersion (hZsh : IsZariskiSheaf B S hS F)
    (h3 : IsOneGeneratorAlmostBlowUpSheaf B S hS F) {X X' Z E X'' : BigHOver B S hS}
    {b : X' ⟶ X} {z : Z ⟶ X} {p : E ⟶ X'} {e : E ⟶ Z} (I : ((𝒦).obj X).IdealSheafData)
    (hb : IsAlmostBlowUpSquare I ((𝒦).map b))
    (hZ : Nonempty (Over.mk ((𝒦).map z) ≅ Over.mk I.subschemeι))
    (hsq : IsPullback ((𝒦).map e) ((𝒦).map p) ((𝒦).map z) ((𝒦).map b)) (io : X'' ⟶ X')
    [IsClosedImmersion ((𝒦).map io)] [LocallyOfFinitePresentation ((𝒦).map io)]
    (hker : ((𝒦).map io).ker.comap (Scheme.Opens.ι (X := (𝒦).obj X')
      ⟨((I.comap ((𝒦).map b)).support : Set _)ᶜ,
        (I.comap ((𝒦).map b)).support.isClosed.isOpen_compl⟩) = ⊥)
    {x y : F.obj (op X')} (hxp : F.map p.op x = F.map p.op y)
    (hxio : F.map io.op x = F.map io.op y) : x = y := by
  have key : ∀ {W : BigHOver B S hS} (u : W ⟶ X'), F.map u.op x = F.map u.op y →
      ∀ {T : BigHOver B S hS} (t₀ : T ⟶ X') (a : T ⟶ W), t₀ ≫ 𝟙 X' = a ≫ u →
        F.map t₀.op x = F.map t₀.op y := fun u hu T t₀ a ht₀ ↦ by
    simpa using ((map_map_eq_map_map ht₀ x).trans
      ((congrArg (F.map a.op) hu).trans (map_map_eq_map_map ht₀ y).symm))
  have hloc : (I.comap ((𝒦).map b)).IsLocallyGeneratedByAtMost 1 :=
    Scheme.IdealSheafData.isLocallyGeneratedByAtMost_one_of_isLocallyPrincipal _
      hb.exceptional_locallyPrincipal
  refine eq_of_isPullback_map_pullback hZsh io p (𝟙 X') hloc.openCover.{u, u + 1}
    (preZeroHypercoverOfOpenCover hloc.openCover.{u, u + 1}).f
    (fun _ ↦ Category.comp_id _) (fun i ↦ ?_) ?_ ?_
  · obtain ⟨hV, s, hs, hIs⟩ := hloc.openCover_spec i
    obtain ⟨t', ht'⟩ := Scheme.IdealSheafData.exists_eq_span_singleton_of_card_le_one s hs hIs
    have : IsAffine ((𝒦).obj ((preZeroHypercoverOfOpenCover hloc.openCover.{u, u + 1}).X i)) :=
      hV
    exact isPullback_baseChange_of_eq_span_singleton h3 p io _
      (nonempty_overIso_exceptional I hZ hsq) hker _ t' ht'
  · exact key p hxp
  · exact key io hxio

/-- **The case of one generator.** Over an affine base, an almost blowup square whose centre is
cut out by a single global section is sent to a cartesian square, granted condition (3) of
Stacks 0EVI.

By Stacks 0EVB the square and the identity of the base — an almost blowup square as in Example
0EVG with `J = 0` — are dominated by an almost blowup square `X'' ⟶ X` whose modification is a
closed immersion into both. That square has the shape of Example 0EVG, so its image is
cartesian; and the closed immersion `X'' ⟶ X'`, an isomorphism away from the locally principal
exceptional subscheme `E` of `X'`, is affine locally on `X'` a square of Example 0EVG, which
makes `F(X') ⟶ F(E) × F(X'')` injective. A chase concludes. -/
private theorem isCartesianAt_of_eq_span_singleton (hZsh : IsZariskiSheaf B S hS F)
    (h3 : IsOneGeneratorAlmostBlowUpSheaf B S hS F) (X : BigHOver B S hS) [IsAffine ((𝒦).obj X)]
    (I : ((𝒦).obj X).IdealSheafData) (t : Γ((𝒦).obj X, ⊤))
    (ht : I.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {t}) : IsCartesianAt B S hS F X I := by
  intro X' Z E b z p e hb hZ hsq
  have hsq' : IsPullback e p z b := IsPullback.of_map_of_faithful 𝒦 hsq
  have hIft : I.IsFiniteType :=
    (Stacks.Flatness.finitePresentation_subschemeι_iff I).mp hb.center_finitePresentation
  -- the identity of the base is a modification with centre `I`
  have hid := isAlmostBlowUpSquare_id_of_eq_span_singleton ((𝒦).map z) I hZ t ht
  -- the common refinement of Stacks 0EVB
  obtain ⟨X'', b'', i₁, i₂, hb'', hi₁, hi₂, hi₁b, hi₂b, -, -⟩ :=
    exists_isAlmostBlowUpSquare_closedImmersion_to_both I hIft ((𝒦).map b) (𝟙 _) hb hid
  have : IsClosedImmersion b'' := by rwa [← hi₂b, Category.comp_id]
  have : IsClosedImmersion i₁ := hi₁
  have : LocallyOfFinitePresentation b'' := hb''.finitePresentation.locallyOfFinitePresentation
  have : LocallyOfFiniteType ((𝒦).map b) := by
    have := hb.finitePresentation.locallyOfFinitePresentation
    infer_instance
  have : LocallyOfFinitePresentation (i₁ ≫ (𝒦).map b) := by rw [hi₁b]; infer_instance
  have : LocallyOfFinitePresentation i₁ := locallyOfFinitePresentation_of_comp i₁ ((𝒦).map b)
  have hsize : B.Contains X'' :=
    Scheme.size_lt_of_isClosedImmersion i₂ ((BigHOver.forget B S hS).obj X).2
  let X''o : BigHOver B S hS := objOver B S hS hsize i₁
  let io : X''o ⟶ X' := objOverHom B S hS hsize i₁
  have hKiob : (𝒦).map (io ≫ b) = b'' := by rw [Functor.map_comp]; exact hi₁b
  have : IsClosedImmersion ((𝒦).map io) := hi₁
  have : LocallyOfFinitePresentation ((𝒦).map io) := ‹LocallyOfFinitePresentation i₁›
  have hS2 : IsPullback (pullback.fst p io) (pullback.snd p io) p io :=
    IsPullback.of_hasPullback p io
  -- the dominating square has the shape of Example 0EVG
  have hF1 : IsPullback (F.map z.op) (F.map (io ≫ b).op) (F.map (pullback.fst p io ≫ e).op)
      (F.map (pullback.snd p io).op) := by
    refine h3 X X''o Z (pullback p io) (io ≫ b) z (pullback.snd p io) (pullback.fst p io ≫ e) I
      inferInstance (by rw [hKiob]; exact hb'') hZ
      (isPullback_toScheme_map (hS2.paste_horiz hsq')) ?_
    rw [hKiob]
    have := isIso_restrict_compl_support I b'' hb''
    exact isOneGeneratorAlmostBlowUpModel_of_isClosedImmersion b'' ((𝒦).map z) I hZ t ht
      (comap_ker_eq_bot_of_isIso_morphismRestrict b'' _)
  -- the closed immersion `X'' ⟶ X'` separates sections
  have hi₁ker := comap_ker_eq_bot_of_isAlmostBlowUpSquare i₁ ((𝒦).map b) I hb
    (by rw [hi₁b]; exact hb'')
  -- the chase
  rw [Types.isPullback_iff]
  refine ⟨?_, fun s₁ s₂ h ↦ ?_, fun t₀ s' hc ↦ ?_⟩
  · rw [← Functor.map_comp, ← Functor.map_comp, ← op_comp, ← op_comp, hsq'.w]
  · refine Types.ext_of_isPullback hF1 h.1 ?_
    simp only [op_comp, FunctorToTypes.map_comp_apply, h.2]
  · obtain ⟨s, hs₁, hs₂⟩ := Types.exists_of_isPullback hF1 t₀ (F.map io.op s') (by
      simp only [op_comp, FunctorToTypes.map_comp_apply, hc]
      simp only [← FunctorToTypes.map_comp_apply, ← op_comp, hS2.w])
    refine ⟨s, hs₁, eq_of_map_exceptional_of_map_closedImmersion hZsh h3 I hb hZ hsq io hi₁ker
      ?_ ?_⟩
    · rw [← FunctorToTypes.map_comp_apply, ← op_comp, ← hsq'.w, op_comp,
        FunctorToTypes.map_comp_apply, hs₁, hc]
    · rw [← FunctorToTypes.map_comp_apply, ← op_comp, hs₂]

/-! ### From affine bases to local generation -/

/-- **Cartesianness is local.** If every almost blowup square over an affine base whose centre
is generated by at most `r` global sections is sent to a cartesian square, then so is every
almost blowup square whose centre is locally generated by at most `r` sections. -/
private theorem isCartesianAt_of_isLocallyGeneratedByAtMost (hZsh : IsZariskiSheaf B S hS F)
    (r : ℕ)
    (haff : ∀ (X : BigHOver B S hS) [IsAffine ((𝒦).obj X)] (I : ((𝒦).obj X).IdealSheafData)
      (s : Finset Γ((𝒦).obj X, ⊤)), s.card ≤ r →
      I.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span s → IsCartesianAt B S hS F X I)
    (X : BigHOver B S hS) (I : ((𝒦).obj X).IdealSheafData) (hI : I.IsLocallyGeneratedByAtMost r) :
    IsCartesianAt B S hS F X I := by
  intro X' Z E b z p e hb hZ hsq
  have hsq' : IsPullback e p z b := IsPullback.of_map_of_faithful 𝒦 hsq
  refine isPullback_map_of_isPullback_map_pullback hZsh hsq'
    (fun {V} (g : V ⟶ X) ↦ ∃ _ : IsAffine ((𝒦).obj V), ∃ s : Finset Γ((𝒦).obj V, ⊤),
      s.card ≤ r ∧ (I.comap ((𝒦).map g)).ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span s)
    ?_ hI.openCover.{u, u + 1} (fun i ↦ ?_) ?_
  · rintro V V' k g hV' - ⟨hV, s, hs, hIs⟩
    classical
    refine ⟨hV', s.image ((𝒦).map k).appTop.hom, Finset.card_image_le.trans hs, ?_⟩
    rw [Functor.map_comp, Scheme.IdealSheafData.comap_comp,
      Scheme.IdealSheafData.ideal_comap_top_eq_span_image _ _ _ hIs, Finset.coe_image]
  · obtain ⟨hV, s, hs, hIs⟩ := hI.openCover_spec i
    exact ⟨hV, hV, s, hs, hIs⟩
  · rintro V g - ⟨hV, s, hs, hIs⟩
    exact isPullback_baseChange_of_isCartesianAt b z I hb hZ g (haff V _ s hs hIs)

/-! ### At least two generators -/

/-- A finite set containing `f₁` and `f₂` is the union of `{f₁, f₂}` and of its remaining
elements. -/
private theorem coe_eq_pair_union {R : Type*} [DecidableEq R] (s : Finset R) {f₁ f₂ : R}
    (h₁ : f₁ ∈ s) (h₂ : f₂ ∈ s) :
    (s : Set R) = {f₁, f₂} ∪ (((s.erase f₁).erase f₂ : Finset R) : Set R) := by
  ext x
  by_cases hx₁ : x = f₁ <;> by_cases hx₂ : x = f₂ <;> simp_all

/-- The span of the image of a finite set containing `f₁` and `f₂` is the span of the images of
`f₁` and `f₂` together with the span of the images of the remaining elements. -/
private theorem span_image_eq_sup {R R' : Type*} [CommRing R] [CommRing R'] [DecidableEq R]
    (φ : R →+* R') (s : Finset R) {f₁ f₂ : R} (h₁ : f₁ ∈ s) (h₂ : f₂ ∈ s) :
    Ideal.span (φ '' (s : Set R)) =
      Ideal.span {φ f₁, φ f₂} ⊔ Ideal.span (φ '' (((s.erase f₁).erase f₂ : Finset R) : Set R)) := by
  rw [coe_eq_pair_union s h₁ h₂, Set.image_union, Ideal.span_union, Set.image_pair]

/-- The inverse image along a morphism of affine schemes of an ideal sheaf generated by a finite
set containing `f₁` and `f₂` is generated by the images of `f₁`, `f₂` and of the remaining
elements. -/
private theorem ideal_comap_top_eq_span_pair_sup {X V : Scheme.{u}} [IsAffine X] [IsAffine V]
    [DecidableEq Γ(X, ⊤)] (I : X.IdealSheafData) (s : Finset Γ(X, ⊤))
    (hIs : I.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span s) {f₁ f₂ : Γ(X, ⊤)} (hf₁ : f₁ ∈ s)
    (hf₂ : f₂ ∈ s) (g : V ⟶ X) :
    (I.comap g).ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.span {g.appTop.hom f₁, g.appTop.hom f₂} ⊔
        Ideal.span (g.appTop.hom '' (((s.erase f₁).erase f₂ : Finset _) : Set _)) := by
  rw [Scheme.IdealSheafData.ideal_comap_top_eq_span_image I g s hIs, span_image_eq_sup _ s hf₁ hf₂]

/-- The inverse image along a morphism of affine schemes of the ideal sheaf generated by `f₁` and
`f₂` is generated by their images. -/
private theorem ideal_comap_top_eq_span_pair {X V : Scheme.{u}} [IsAffine X] [IsAffine V]
    (J : X.IdealSheafData) {f₁ f₂ : Γ(X, ⊤)}
    (hJ : J.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {f₁, f₂}) (g : V ⟶ X) :
    (J.comap g).ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {g.appTop.hom f₁, g.appTop.hom f₂} := by
  rw [Scheme.IdealSheafData.ideal_comap_top_eq_span_image J g {f₁, f₂} hJ, Set.image_pair]

/-- Where `f₁` and `f₂` vanish, an ideal sheaf generated by a finite set containing them is
generated by the images of the remaining elements. -/
private theorem isLocallyGeneratedByAtMost_comap_of_vanish {X W : Scheme.{u}} [IsAffine X]
    [IsAffine W] [DecidableEq Γ(X, ⊤)] (I J : X.IdealSheafData) (s : Finset Γ(X, ⊤))
    (hIs : I.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span s) {f₁ f₂ : Γ(X, ⊤)} (hf₁ : f₁ ∈ s)
    (hf₂ : f₂ ∈ s) (hJ : J.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {f₁, f₂}) (w : W ⟶ X)
    (hw : J.comap w = ⊥) :
    (I.comap w).IsLocallyGeneratedByAtMost ((s.erase f₁).erase f₂).card := by
  classical
  have h0 : (J.comap w).ideal ⟨⊤, isAffineOpen_top _⟩ = ⊥ := by
    rw [hw]
    exact congrFun Scheme.IdealSheafData.ideal_bot _
  rw [ideal_comap_top_eq_span_pair J hJ w] at h0
  have h₁ : w.appTop.hom f₁ = 0 := (Submodule.eq_bot_iff _).mp h0 _ (Ideal.subset_span (by simp))
  have h₂ : w.appTop.hom f₂ = 0 := (Submodule.eq_bot_iff _).mp h0 _ (Ideal.subset_span (by simp))
  refine Scheme.IdealSheafData.isLocallyGeneratedByAtMost_of_isAffine _ _
    (((s.erase f₁).erase f₂).image w.appTop.hom) Finset.card_image_le ?_
  rw [ideal_comap_top_eq_span_pair_sup I s hIs hf₁ hf₂, h₁, h₂, Finset.coe_image]
  simp

/-- Where the ideal sheaf generated by `f₁` and `f₂` is locally generated by one section, an ideal
sheaf generated by a finite set containing them is locally generated by one section more than
the remaining elements. -/
private theorem isLocallyGeneratedByAtMost_comap_of_pair_le_one {X Y : Scheme.{u}} [IsAffine X]
    [DecidableEq Γ(X, ⊤)] (I J : X.IdealSheafData) (s : Finset Γ(X, ⊤))
    (hIs : I.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span s) {f₁ f₂ : Γ(X, ⊤)} (hf₁ : f₁ ∈ s)
    (hf₂ : f₂ ∈ s) (hJ : J.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {f₁, f₂}) (m : Y ⟶ X)
    (hm : (J.comap m).IsLocallyGeneratedByAtMost 1) :
    (I.comap m).IsLocallyGeneratedByAtMost (((s.erase f₁).erase f₂).card + 1) := by
  classical
  intro y
  obtain ⟨U, hyU, s12, hs12, h12⟩ := hm y
  have : IsAffine U.1.toScheme := U.2
  let g : U.1.toScheme ⟶ X := U.1.ι ≫ m
  refine ⟨U, hyU, s12 ∪ ((s.erase f₁).erase f₂).image g.appTop.hom,
    (Finset.card_union_le _ _).trans ?_, ?_⟩
  · have := Finset.card_image_le (s := (s.erase f₁).erase f₂) (f := g.appTop.hom)
    omega
  · rw [← Scheme.IdealSheafData.comap_comp, ideal_comap_top_eq_span_pair_sup I s hIs hf₁ hf₂ g,
      ← ideal_comap_top_eq_span_pair J hJ g, Scheme.IdealSheafData.comap_comp, h12,
      Finset.coe_union, Finset.coe_image, Ideal.span_union]

/-- Over the modification of an almost blowup square with centre generated by a finite set
containing `f₁` and `f₂`, the ideal sheaf generated by `f₁` and `f₂` is locally generated by one
section more than the remaining elements. -/
private theorem isLocallyGeneratedByAtMost_comap_pair {X X' : Scheme.{u}} [IsAffine X]
    [DecidableEq Γ(X, ⊤)] (I J : X.IdealSheafData) (s : Finset Γ(X, ⊤))
    (hIs : I.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span s) {f₁ f₂ : Γ(X, ⊤)} (hf₁ : f₁ ∈ s)
    (hf₂ : f₂ ∈ s) (hJ : J.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {f₁, f₂}) (m : X' ⟶ X)
    (hb : IsAlmostBlowUpSquare I m) :
    (J.comap m).IsLocallyGeneratedByAtMost (((s.erase f₁).erase f₂).card + 1) := by
  rcases Nat.eq_zero_or_pos ((s.erase f₁).erase f₂).card with h | h
  · have hJI : J = I := by
      apply Scheme.IdealSheafData.ext_of_isAffine
      rw [hJ, hIs]
      congr 1
      rw [coe_eq_pair_union s hf₁ hf₂, Finset.card_eq_zero.mp h, Finset.coe_empty,
        Set.union_empty]
    rw [hJI, h]
    exact Scheme.IdealSheafData.isLocallyGeneratedByAtMost_one_of_isLocallyPrincipal _
      hb.exceptional_locallyPrincipal
  · exact ((Scheme.IdealSheafData.isLocallyGeneratedByAtMost_of_isAffine J 2 {f₁, f₂}
      Finset.card_le_two (by rw [hJ, Finset.coe_pair])).comap _).mono (by omega)

/-- Where an ideal sheaf generated by a finite set containing `f₁` and `f₂` vanishes, so does the
ideal sheaf generated by `f₁` and `f₂`. -/
private theorem isLocallyGeneratedByAtMost_comap_pair_of_comap_eq_bot {X W : Scheme.{u}}
    [IsAffine X] (I J : X.IdealSheafData) (s : Finset Γ(X, ⊤))
    (hIs : I.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span s) {f₁ f₂ : Γ(X, ⊤)} (hf₁ : f₁ ∈ s)
    (hf₂ : f₂ ∈ s) (hJ : J.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {f₁, f₂}) (w : W ⟶ X)
    (hw : I.comap w = ⊥) (n : ℕ) : (J.comap w).IsLocallyGeneratedByAtMost n := by
  have hle : J ≤ I := by
    refine Scheme.IdealSheafData.le_of_isAffine ?_
    rw [hJ, hIs]
    refine Ideal.span_le.mpr ?_
    intro x hx
    rcases hx with rfl | rfl
    · exact Ideal.subset_span hf₁
    · exact Ideal.subset_span hf₂
  have hbot : J.comap w = ⊥ :=
    le_bot_iff.mp ((Scheme.IdealSheafData.comap_mono _ hle).trans hw.le)
  rw [hbot]
  exact Scheme.IdealSheafData.isLocallyGeneratedByAtMost_bot _

/-- Over an affine base, the square of Example 0EVH for two global sections `f₁, f₂` is realised
in the site, with centre the ideal sheaf generated by `f₁, f₂`, and is sent to a cartesian square,
granted condition (4) of Stacks 0EVI. -/
private theorem exists_twoGeneratorSquare (h4 : IsTwoGeneratorAlmostBlowUpSheaf B S hS F)
    (X : BigHOver B S hS) [IsAffine ((𝒦).obj X)] (f₁ f₂ : Γ((𝒦).obj X, ⊤)) :
    ∃ (J : ((𝒦).obj X).IdealSheafData) (Y Z₁ : BigHOver B S hS) (b₁ : Y ⟶ X) (z₁ : Z₁ ⟶ X),
      J.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {f₁, f₂} ∧
      IsAlmostBlowUpSquare J ((𝒦).map b₁) ∧
      Nonempty (Over.mk ((𝒦).map z₁) ≅ Over.mk J.subschemeι) ∧ IsAffine ((𝒦).obj Z₁) ∧
      IsPullback (F.map z₁.op) (F.map b₁.op) (F.map (pullback.fst z₁ b₁).op)
        (F.map (pullback.snd z₁ b₁).op) := by
  let iX : (𝒦).obj X ≅ Spec (.of Γ((𝒦).obj X, ⊤)) := ((𝒦).obj X).isoSpec
  let := (Stacks.AlmostBlowUp.twoGeneratorSquare Γ((𝒦).obj X, ⊤) f₁ f₂).modificationGraded
  let bm := Stacks.AlmostBlowUp.modificationToBase Γ((𝒦).obj X, ⊤) f₁ f₂
  let Im := Stacks.AlmostBlowUp.centerIdealSheaf Γ((𝒦).obj X, ⊤) f₁ f₂
  have hm : IsAlmostBlowUpSquare Im bm :=
    Stacks.AlmostBlowUp.isAlmostBlowUpSquare_modificationToBase _ f₁ f₂
  let I12 := Im.comap iX.hom
  have hb1s : IsAlmostBlowUpSquare I12 (pullback.fst iX.hom bm) :=
    isAlmostBlowUpSquare_baseChange Im bm iX.hom hm
  have hI12 : I12.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {f₁, f₂} := by
    show ((Scheme.IdealSheafData.ofIdealTop ((Ideal.span {f₁, f₂}).map
      (Scheme.ΓSpecIso Γ((𝒦).obj X, ⊤)).inv.hom)).comap ((𝒦).obj X).isoSpec.hom).ideal _ = _
    rw [Scheme.IdealSheafData.comap_isoSpec_hom_ofIdealTop]
    exact Scheme.IdealSheafData.equivOfIsAffine.apply_symm_apply _
  have hXsize : ((𝒦).obj X).size < B.cutoff := ((BigHOver.forget B S hS).obj X).2
  have : LocallyOfFiniteType (pullback.fst iX.hom bm) := by
    have := hb1s.finitePresentation.locallyOfFinitePresentation
    infer_instance
  have : QuasiCompact (pullback.fst iX.hom bm) := hb1s.finitePresentation.quasiCompact
  have hYsize : B.Contains (pullback iX.hom bm) :=
    Scheme.size_lt_of_locallyOfFiniteType_of_quasiCompact (pullback.fst iX.hom bm) hXsize
  have hZ1size : B.Contains I12.subscheme :=
    Scheme.size_lt_of_isClosedImmersion I12.subschemeι hXsize
  let Y : BigHOver B S hS := objOver B S hS hYsize (pullback.fst iX.hom bm)
  let b1 : Y ⟶ X := objOverHom B S hS hYsize (pullback.fst iX.hom bm)
  let Z1 : BigHOver B S hS := objOver B S hS hZ1size I12.subschemeι
  let z1 : Z1 ⟶ X := objOverHom B S hS hZ1size I12.subschemeι
  have hZ1 : Nonempty (Over.mk ((𝒦).map z1) ≅ Over.mk I12.subschemeι) := ⟨Iso.refl _⟩
  have hsndIso : IsIso (pullback.snd iX.hom bm) :=
    (IsPullback.of_hasPullback iX.hom bm).isIso_snd_of_isIso (Iso.isIso_hom iX)
  have hshape : IsTwoGeneratorAlmostBlowUpModel ((𝒦).map b1) ((𝒦).map z1) := by
    let eZ : Over.mk (I12.subschemeι ≫ iX.hom) ≅
        Over.mk (Stacks.AlmostBlowUp.centerToBase Γ((𝒦).obj X, ⊤) f₁ f₂) :=
      overIsoComapSubschemeι iX Im ≪≫
        (Spec.overIsoQuotientSubschemeι
          (Stacks.AlmostBlowUp.centerIdeal Γ((𝒦).obj X, ⊤) f₁ f₂)).symm
    exact ⟨Γ((𝒦).obj X, ⊤), inferInstance, f₁, f₂, iX,
      @asIso _ _ _ _ (pullback.snd iX.hom bm) hsndIso,
      (Over.forget _).mapIso eZ, pullback.condition, (Over.w eZ.hom).symm⟩
  have : IsAffine I12.subscheme := isAffine_of_isAffineHom I12.subschemeι
  exact ⟨I12, Y, Z1, b1, z1, hI12, hb1s, hZ1, this,
    h4 X Y Z1 (pullback z1 b1) b1 z1 (pullback.snd z1 b1) (pullback.fst z1 b1) I12
      inferInstance hb1s hZ1 (isPullback_toScheme_map (IsPullback.of_hasPullback z1 b1)) hshape⟩

/-- Two sections over `X` which agree over the centre and over the modification of a square agree
over `g : W ⟶ X` when the image of the base change of the square along `g` is cartesian. -/
private theorem map_eq_of_isPullback_baseChange {X X' Z W : BigHOver B S hS} (b : X' ⟶ X)
    (z : Z ⟶ X) (g : W ⟶ X)
    (hpb : IsPullback (F.map (pullback.fst g z).op) (F.map (pullback.fst g b).op)
      (F.map (pullback.fst (pullback.fst g z) (pullback.fst g b)).op)
      (F.map (pullback.snd (pullback.fst g z) (pullback.fst g b)).op))
    {x y : F.obj (op X)} (hz : F.map z.op x = F.map z.op y) (hb : F.map b.op x = F.map b.op y) :
    F.map g.op x = F.map g.op y :=
  eq_of_isPullback_baseChange b z g hpb
    (fun t a ht ↦ by rw [map_map_eq_map_map ht, map_map_eq_map_map ht, hz])
    (fun t a ht ↦ by rw [map_map_eq_map_map ht, map_map_eq_map_map ht, hb])

/-- **The chase of the induction step.** Let `b₁, z₁` be the modification and the centre of a
square over `X` whose image is cartesian. If the images of the base changes of the square `b, z`
along `z₁`, `b₁` and the exceptional corner, and of the square `b₁, z₁` along `b` and `z`, are
cartesian, then so is the image of the square `b, z`. -/
private theorem isPullback_of_isPullback_baseChange {X X' Z E Y Z1 : BigHOver B S hS}
    {b : X' ⟶ X} {z : Z ⟶ X} {p : E ⟶ X'} {e : E ⟶ Z} (hsq' : IsPullback e p z b)
    (b1 : Y ⟶ X) (z1 : Z1 ⟶ X)
    (hF4 : IsPullback (F.map z1.op) (F.map b1.op) (F.map (pullback.fst z1 b1).op)
      (F.map (pullback.snd z1 b1).op))
    (hII : IsPullback (F.map (pullback.fst z1 z).op) (F.map (pullback.fst z1 b).op)
      (F.map (pullback.fst (pullback.fst z1 z) (pullback.fst z1 b)).op)
      (F.map (pullback.snd (pullback.fst z1 z) (pullback.fst z1 b)).op))
    (hI : IsPullback (F.map (pullback.fst b1 z).op) (F.map (pullback.fst b1 b).op)
      (F.map (pullback.fst (pullback.fst b1 z) (pullback.fst b1 b)).op)
      (F.map (pullback.snd (pullback.fst b1 z) (pullback.fst b1 b)).op))
    (hC : IsPullback (F.map (pullback.fst (pullback.snd z1 b1 ≫ b1) z).op)
      (F.map (pullback.fst (pullback.snd z1 b1 ≫ b1) b).op)
      (F.map (pullback.fst (pullback.fst (pullback.snd z1 b1 ≫ b1) z)
        (pullback.fst (pullback.snd z1 b1 ≫ b1) b)).op)
      (F.map (pullback.snd (pullback.fst (pullback.snd z1 b1 ≫ b1) z)
        (pullback.fst (pullback.snd z1 b1 ≫ b1) b)).op))
    (hD : IsPullback (F.map (pullback.fst b z1).op) (F.map (pullback.fst b b1).op)
      (F.map (pullback.fst (pullback.fst b z1) (pullback.fst b b1)).op)
      (F.map (pullback.snd (pullback.fst b z1) (pullback.fst b b1)).op))
    (hE : IsPullback (F.map (pullback.fst z z1).op) (F.map (pullback.fst z b1).op)
      (F.map (pullback.fst (pullback.fst z z1) (pullback.fst z b1)).op)
      (F.map (pullback.snd (pullback.fst z z1) (pullback.fst z b1)).op)) :
    IsPullback (F.map z.op) (F.map b.op) (F.map e.op) (F.map p.op) := by
  rw [Types.isPullback_iff]
  refine ⟨?_, fun s₁ s₂ h ↦ ?_, fun t s' hc ↦ ?_⟩
  · rw [← Functor.map_comp, ← Functor.map_comp, ← op_comp, ← op_comp, hsq'.w]
  · exact Types.ext_of_isPullback hF4 (map_eq_of_isPullback_baseChange b z z1 hII h.1 h.2)
      (map_eq_of_isPullback_baseChange b z b1 hI h.1 h.2)
  · obtain ⟨tY, htY₁, htY₂⟩ := exists_of_isPullback_baseChange hsq' b1 hI t s' hc
    obtain ⟨t1, ht1₁, ht1₂⟩ := exists_of_isPullback_baseChange hsq' z1 hII t s' hc
    have hagree : F.map (pullback.fst z1 b1).op t1 = F.map (pullback.snd z1 b1).op tY := by
      symm
      refine eq_of_isPullback_baseChange b z (pullback.snd z1 b1 ≫ b1) hC ?_ ?_
      · intro T t₀ a ht₀
        rw [← FunctorToTypes.map_comp_apply, ← op_comp, ← FunctorToTypes.map_comp_apply,
          ← op_comp,
          map_op_eq_of_map_fst_eq b1 htY₁ (t₀ ≫ pullback.snd z1 b1) a
            (by rw [Category.assoc]; exact ht₀),
          map_op_eq_of_map_fst_eq z1 ht1₁ (t₀ ≫ pullback.fst z1 b1) a
            (by rw [Category.assoc, pullback.condition]; exact ht₀)]
      · intro T t₀ a ht₀
        rw [← FunctorToTypes.map_comp_apply, ← op_comp, ← FunctorToTypes.map_comp_apply,
          ← op_comp,
          map_op_eq_of_map_fst_eq b1 htY₂ (t₀ ≫ pullback.snd z1 b1) a
            (by rw [Category.assoc]; exact ht₀),
          map_op_eq_of_map_fst_eq z1 ht1₂ (t₀ ≫ pullback.fst z1 b1) a
            (by rw [Category.assoc, pullback.condition]; exact ht₀)]
    obtain ⟨s₀, hs₁, hs₂⟩ := Types.exists_of_isPullback hF4 t1 tY hagree
    refine ⟨s₀, ?_, ?_⟩
    · refine eq_of_isPullback_baseChange b1 z1 z hE ?_ ?_
      · intro T t₀ a ht₀
        rw [map_map_eq_map_map ht₀, hs₁]
        exact map_op_eq_of_map_fst_eq z1 ht1₁ a t₀ ht₀.symm
      · intro T t₀ a ht₀
        rw [map_map_eq_map_map ht₀, hs₂]
        exact map_op_eq_of_map_fst_eq b1 htY₁ a t₀ ht₀.symm
    · refine eq_of_isPullback_baseChange b1 z1 b hD ?_ ?_
      · intro T t₀ a ht₀
        rw [map_map_eq_map_map ht₀, hs₁]
        exact map_op_eq_of_map_fst_eq z1 ht1₂ a t₀ ht₀.symm
      · intro T t₀ a ht₀
        rw [map_map_eq_map_map ht₀, hs₂]
        exact map_op_eq_of_map_fst_eq b1 htY₂ a t₀ ht₀.symm

/-- **The induction step.** Over an affine base, an almost blowup square whose centre is
generated by at least two and at most `r + 2` global sections is sent to a cartesian square,
granted condition (4) of Stacks 0EVI and the claim for centres locally generated by at most
`r + 1` sections.

For two of the generators `f₁, f₂`, base change along the square of Example 0EVH for `f₁, f₂`.
Over its modification `Y` the centre is locally generated by `r + 1` sections, because `(f₁, f₂)`
becomes locally principal; over its centre `Z₁` the centre is generated by the `r` remaining
sections, because `f₁` and `f₂` vanish there. Condition (4) makes the image of the square of
Example 0EVH cartesian, and the claim for `r + 1` makes the images of the two base changes, and of
the base changes of the square of Example 0EVH to `X'` and to `Z`, cartesian; a chase concludes.
-/
private theorem isCartesianAt_of_two_le_card (h4 : IsTwoGeneratorAlmostBlowUpSheaf B S hS F)
    (r : ℕ)
    (IH : ∀ (X : BigHOver B S hS) (I : ((𝒦).obj X).IdealSheafData),
      I.IsLocallyGeneratedByAtMost (r + 1) → IsCartesianAt B S hS F X I)
    (X : BigHOver B S hS) [IsAffine ((𝒦).obj X)] (I : ((𝒦).obj X).IdealSheafData)
    (s : Finset Γ((𝒦).obj X, ⊤)) (hs : s.card ≤ r + 2) (h2 : 2 ≤ s.card)
    (hIs : I.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span s) : IsCartesianAt B S hS F X I := by
  classical
  intro X' Z E b z p e hb hZ hsq
  have hsq' : IsPullback e p z b := IsPullback.of_map_of_faithful 𝒦 hsq
  obtain ⟨f₁, hf₁, f₂, hf₂, hne⟩ := Finset.one_lt_card.mp h2
  have hrestcard : ((s.erase f₁).erase f₂).card ≤ r := by
    have h₂' : f₂ ∈ s.erase f₁ := Finset.mem_erase.mpr ⟨hne.symm, hf₂⟩
    rw [Finset.card_erase_of_mem h₂', Finset.card_erase_of_mem hf₁]
    omega
  -- the square of Example 0EVH for `f₁, f₂`
  obtain ⟨I12, Y, Z1, b1, z1, hI12, hb1s, hZ1, _, hF4⟩ := exists_twoGeneratorSquare h4 X f₁ f₂
  -- over the centre `Z₁` the generators `f₁, f₂` vanish
  have hlocZ1 := isLocallyGeneratedByAtMost_comap_of_vanish I I12 s hIs hf₁ hf₂ hI12
    ((𝒦).map z1) (Scheme.IdealSheafData.comap_eq_bot_of_nonempty_overIso hZ1)
  have hII := isPullback_baseChange_of_isCartesianAt b z I hb hZ z1
    (IH Z1 _ (hlocZ1.mono (by omega)))
  -- over the modification `Y` the centre is locally generated by `r + 1` sections
  have hI := isPullback_baseChange_of_isCartesianAt b z I hb hZ b1 (IH Y _
    ((isLocallyGeneratedByAtMost_comap_of_pair_le_one I I12 s hIs hf₁ hf₂ hI12 _
      (Scheme.IdealSheafData.isLocallyGeneratedByAtMost_one_of_isLocallyPrincipal _
        hb1s.exceptional_locallyPrincipal)).mono (by omega)))
  -- over the exceptional corner `E₁` of the square of Example 0EVH
  have hlocE1 : (I.comap ((𝒦).map (pullback.snd z1 b1 ≫ b1))).IsLocallyGeneratedByAtMost
      (r + 1) := by
    rw [← pullback.condition, Functor.map_comp, Scheme.IdealSheafData.comap_comp]
    exact (hlocZ1.comap ((𝒦).map (pullback.fst z1 b1))).mono (by omega)
  have hC := isPullback_baseChange_of_isCartesianAt b z I hb hZ (pullback.snd z1 b1 ≫ b1)
    (IH _ _ hlocE1)
  -- the square of Example 0EVH over `X'`
  have hD := isPullback_baseChange_of_isCartesianAt b1 z1 I12 hb1s hZ1 b (IH X' _
    ((isLocallyGeneratedByAtMost_comap_pair I I12 s hIs hf₁ hf₂ hI12 _ hb).mono (by omega)))
  -- the square of Example 0EVH over `Z`
  have hE := isPullback_baseChange_of_isCartesianAt b1 z1 I12 hb1s hZ1 z (IH Z _
    (isLocallyGeneratedByAtMost_comap_pair_of_comap_eq_bot I I12 s hIs hf₁ hf₂ hI12 _
      (Scheme.IdealSheafData.comap_eq_bot_of_nonempty_overIso hZ) _))
  -- the chase
  exact isPullback_of_isPullback_baseChange hsq' b1 z1 hF4 hII hI hC hD hE

/-! ### The induction -/

/-- **The claim, by induction on the bound.** Granted conditions (1), (3) and (4) of Stacks 0EVI,
every almost blowup square of the site whose centre is locally generated by at most `r`
sections is sent to a cartesian square. -/
private theorem isCartesianAt_of_isLocallyGeneratedByAtMost_of_conditions
    (hZsh : IsZariskiSheaf B S hS F) (h3 : IsOneGeneratorAlmostBlowUpSheaf B S hS F)
    (h4 : IsTwoGeneratorAlmostBlowUpSheaf B S hS F) (r : ℕ) :
    ∀ (X : BigHOver B S hS) (I : ((𝒦).obj X).IdealSheafData),
      I.IsLocallyGeneratedByAtMost r → IsCartesianAt B S hS F X I := by
  induction r with
  | zero =>
    refine isCartesianAt_of_isLocallyGeneratedByAtMost hZsh 0 fun X _ I s hs hIs ↦ ?_
    obtain ⟨t, ht⟩ := Scheme.IdealSheafData.exists_eq_span_singleton_of_card_le_one s
      (hs.trans zero_le_one) hIs
    exact isCartesianAt_of_eq_span_singleton hZsh h3 X I t ht
  | succ r IH =>
    refine isCartesianAt_of_isLocallyGeneratedByAtMost hZsh (r + 1) fun X _ I s hs hIs ↦ ?_
    by_cases h1 : s.card ≤ 1
    · obtain ⟨t, ht⟩ := Scheme.IdealSheafData.exists_eq_span_singleton_of_card_le_one s h1 hIs
      exact isCartesianAt_of_eq_span_singleton hZsh h3 X I t ht
    · obtain ⟨r', rfl⟩ : ∃ r', r = r' + 1 := ⟨r - 1, by omega⟩
      exact isCartesianAt_of_two_le_card h4 r' IH X I s hs (by omega) hIs

end BigHOver

/-- **The reduction step in the proof of Stacks 0EVI.** On every big h site over every base
scheme, conditions (1) to (4) of Stacks 0EVI force condition (3) of Stacks 0EVF: a presheaf of
sets which is a Zariski sheaf and sends the almost blowup squares of Examples 0EVG and 0EVH to
cartesian squares sends every almost blowup square with affine base to a cartesian square.

The centre of such a square is cut out by finitely many global sections, so it is locally
generated by a bounded number of sections, and the claim proved by induction on that bound
applies. Condition (2) is not used. -/
theorem generatorAlmostBlowUpSquaresSuffice : GeneratorAlmostBlowUpSquaresSuffice.{u, v} := by
  intro B S hS F hZsh _ h3 h4 X X' Z E b z p e I hX hb hZ hsq
  have : IsAffine ((BigHOver.toScheme B S hS).obj X) := hX
  obtain ⟨s, hs⟩ := (Stacks.Flatness.finitePresentation_subschemeι_iff I).mp
    hb.center_finitePresentation ⟨⊤, isAffineOpen_top _⟩
  exact BigHOver.isCartesianAt_of_isLocallyGeneratedByAtMost_of_conditions hZsh h3 h4 s.card X I
    (Scheme.IdealSheafData.isLocallyGeneratedByAtMost_of_isAffine I _ s le_rfl hs.symm)
    X' Z E b z p e hb hZ hsq

namespace BigHOver

/-- **Stacks 0EVI.** A presheaf of sets on the big h category over `S` is a sheaf for the h
topology if and only if it satisfies condition (1), the sheaf condition for Zariski coverings,
condition (2), the sheaf condition for every morphism of the site with affine target which is
flat, proper, surjective and of finite presentation, condition (3), cartesianness of the image
of every almost blowup square of the site with affine base and the shape of Example 0EVG, and
condition (4), the same for the shape of Example 0EVH.

The sufficiency direction is the sufficiency direction of Stacks 0EVF,
`AlgebraicGeometry.affineAlmostBlowUpHSheafCriterion`, applied after the reduction of its
condition (3) to the two shapes, `AlgebraicGeometry.generatorAlmostBlowUpSquaresSuffice`.
Condition (2) in the source's equalizer form is
`AlgebraicGeometry.BigHOver.IsAffineFlatProperFinitePresentationSheaf.bijective_mapToEqualizer`.
-/
@[stacks 0EVI]
theorem isSheaf_iff_zariski_and_flatProper_and_generatorSquares
    (B : BigHSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (BigHOver B S hS)ᵒᵖ ⥤ Type v) :
    Presheaf.IsSheaf (BigHOver.topology B S hS) F ↔
      (BigHOver.IsZariskiSheaf B S hS F ∧
        BigHOver.IsAffineFlatProperFinitePresentationSheaf B S hS F ∧
        BigHOver.IsOneGeneratorAlmostBlowUpSheaf B S hS F ∧
        BigHOver.IsTwoGeneratorAlmostBlowUpSheaf B S hS F) :=
  isSheaf_iff_zariski_and_affineFlatProperFP_and_generatorSquares
    affineAlmostBlowUpHSheafCriterion generatorAlmostBlowUpSquaresSuffice B S hS F

end BigHOver

end AlgebraicGeometry

