module

public import StacksFrontier.AlgebraicGeometry.Topologies.HTopology.AlmostBlowUpSquareBaseChangeInSite
public import StacksFrontier.AlgebraicGeometry.Topologies.HTopology.AlmostBlowUpSquareIndependence
public import StacksFrontier.AlgebraicGeometry.Topologies.HTopology.TwoGeneratorSquareOverAffine
import StacksFrontier.AlgebraicGeometry.Chow.ZeroSchemeRegularSection
import StacksFrontier.CategoryTheory.Sites.QuasiCompact.ObjectsAndColimits

/-!
# The induction on the number of generators of the centre

This is the content of the proof of Stacks 0EVI: conditions (1) to (4) of that criterion force
condition (3) of Stacks 0EVF, cartesianness of the image of *every* almost blowup square of the
big h site with affine base.  The induction is on the number of sections generating the ideal
sheaf cutting out the centre.

For at most two generators the square of Example 0EVH over the base has the same centre, so
condition (4) applies to it, and step 4 of the source's proof — the independence of the chosen
square, `AlgebraicGeometry.BigHOver.isPullback_of_isAlmostBlowUpSquare_of_isPullback` — transfers
cartesianness to the given square.

For `r > 2` generators `f₁, …, f_r` the square of Example 0EVH for `(f₁, f₂)`, with modification
`Y` and centre `Z₁`, is an almost blowup square over the base, and condition (4) makes
`F(X)` the fibre product of `F(Z₁)` and `F(Y)` over `F(E₁)`.  On `Y` the ideal `(f₁, f₂)` becomes
locally principal — it is the exceptional subscheme of that square — so the centre of the base
change of the given square to `Y` is locally generated by `r - 1` sections, and on `Z₁` the
sections `f₁, f₂` vanish, so the centre of the base change to `Z₁` is locally generated by
`r - 2` sections.  The induction hypothesis therefore applies to both base changes, and to the
base change to `E₁`; the base changes of the square of Example 0EVH itself always have a centre
generated by two sections, so the induction hypothesis applies to them as well.  A diagram chase
assembles a section over the base from a section over the modification and one over the centre.

## Main results

* `AlgebraicGeometry.BigHOver.isAffineGeneratorAlmostBlowUpSheaf_two`: the base case.
* `AlgebraicGeometry.BigHOver.isAffineGeneratorAlmostBlowUpSheaf_succ`: the induction step.
* `AlgebraicGeometry.BigHOver.isAffineAlmostBlowUpSheaf_of_generatorSquares`: conditions (1) to
  (4) of Stacks 0EVI force condition (3) of Stacks 0EVF.

## Implementation notes

The diagram chase is phrased through `CategoryTheory.Limits.Types.isPullback_iff` and the single
transfer lemma `Stacks.Sites.FilteredColimitSections.map_op_eq_of_comp_eq_of_isPullback`: two
sections which agree on one fibre product of a cospan agree on every object mapping compatibly to
the two legs. Every comparison of the chase is an instance of it, so no fibre product needs to be
identified with another.

The source's "we omit the verification that `s` maps to `s'` and to `t`" is the last two steps:
they are the joint injectivity of the restriction maps of the base changes of the square of
Example 0EVH along the centre and along the modification of the given square, which the induction
hypothesis supplies because those base changes again have a centre generated by two sections.

## References

* [Stacks Project, Tag 0EVI](https://stacks.math.columbia.edu/tag/0EVI)
* [Stacks Project, Tag 0EVF](https://stacks.math.columbia.edu/tag/0EVF)
* [Stacks Project, Tag 0EVG](https://stacks.math.columbia.edu/tag/0EVG)
* [Stacks Project, Tag 0EVH](https://stacks.math.columbia.edu/tag/0EVH)
* [Stacks Project, Tag 0EV7](https://stacks.math.columbia.edu/tag/0EV7)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite Stacks.Sites.FilteredColimitSections

universe u v

namespace AlgebraicGeometry

/-! ### Generating families of two and of `r` elements -/

/-- A family indexed by `Fin 2` spans the same ideal as the pair of its values. -/
public theorem span_range_fin_two {R : Type*} [CommRing R] (g : Fin 2 → R) :
    Ideal.span (Set.range g) = Ideal.span {g 0, g 1} := by
  congr 1
  ext y
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  refine ⟨?_, ?_⟩
  · rintro ⟨i, rfl⟩
    fin_cases i
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro (rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩

/-- A pair of elements is a generating family indexed by `Fin 2`. -/
public theorem exists_span_range_pair {R : Type*} [CommRing R] (a b : R) :
    ∃ g : Fin 2 → R, Ideal.span {a, b} = Ideal.span (Set.range g) := by
  refine ⟨fun i ↦ if (i : ℕ) = 0 then a else b, ?_⟩
  congr 1
  ext y
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_range]
  refine ⟨?_, ?_⟩
  · rintro (rfl | rfl)
    · exact ⟨0, by simp⟩
    · exact ⟨1, by simp⟩
  · rintro ⟨i, rfl⟩
    by_cases h : (i : ℕ) = 0
    · exact Or.inl (by simp [h])
    · exact Or.inr (by simp [h])

/-- A family of `r + 3` elements spans the join of the ideal of its first two members and the
ideal of the remaining `r + 1`. -/
public theorem span_range_eq_sup {R : Type*} [CommRing R] {n : ℕ} (g : Fin (n + 3) → R) :
    Ideal.span (Set.range g) = Ideal.span {g 0, g 1} ⊔
      Ideal.span (Set.range (fun i : Fin (n + 1) ↦ g ⟨i + 2, by omega⟩)) := by
  refine le_antisymm (Ideal.span_le.2 ?_) (sup_le (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_))
  · rintro _ ⟨i, rfl⟩
    rcases Nat.lt_or_ge (i : ℕ) 2 with h | h
    · refine Submodule.mem_sup_left (Ideal.subset_span ?_)
      have h2 : (i : ℕ) = 0 ∨ (i : ℕ) = 1 := by omega
      rcases h2 with h0 | h0
      · exact Or.inl (congrArg g (Fin.ext (by simpa using h0)))
      · exact Or.inr (Set.mem_singleton_iff.2 (congrArg g (Fin.ext (by simpa using h0))))
    · refine Submodule.mem_sup_right (Ideal.subset_span ⟨⟨(i : ℕ) - 2, by omega⟩, ?_⟩)
      exact congrArg g (Fin.ext (by simp only; omega))
  · rintro _ (rfl | rfl)
    · exact Ideal.subset_span ⟨0, rfl⟩
    · exact Ideal.subset_span ⟨1, rfl⟩
  · rintro _ ⟨i, rfl⟩
    exact Ideal.subset_span ⟨_, rfl⟩

/-! ### The inverse image of an ideal sheaf on the subscheme it cuts out -/

/-- **An ideal sheaf pulls back to zero along any morphism identified over the base with the
inclusion of the closed subscheme it cuts out.** For the inclusion itself this is
`Stacks.Divisors.comap_eq_bot_iff_le` at `I ≤ I`. -/
public theorem Scheme.IdealSheafData.comap_eq_bot_of_over_iso {X Z : Scheme.{u}}
    (I : X.IdealSheafData) (z : Z ⟶ X) (ε : Over.mk z ≅ Over.mk I.subschemeι) :
    I.comap z = ⊥ := by
  have hz : ε.hom.left ≫ I.subschemeι = z := ε.hom.w
  rw [← hz, Scheme.IdealSheafData.comap_comp,
    (Stacks.Divisors.comap_eq_bot_iff_le I I).2 le_rfl, Scheme.IdealSheafData.comap_bot]

/-! ### The shape of Example 0EVH only depends on the centre up to isomorphism -/

/-- **The shape of Example 0EVH is invariant under replacing the centre by an isomorphic one over
the base.** This is the two-generator sibling of
`AlgebraicGeometry.IsOneGeneratorAlmostBlowUpModel.of_centre_iso`, and like it the work is done by
`AlgebraicGeometry.IsModelPairOverBase.of_centre_iso`. -/
public theorem IsTwoGeneratorAlmostBlowUpModel.of_centre_iso {X X' Z Z' : Scheme.{u}}
    {b : X' ⟶ X} {z : Z ⟶ X} {z' : Z' ⟶ X}
    (h : IsTwoGeneratorAlmostBlowUpModel b z) (w : Over.mk z' ≅ Over.mk z) :
    IsTwoGeneratorAlmostBlowUpModel b z' := by
  obtain ⟨A, hA, f₁, f₂, hm⟩ := h
  exact ⟨A, hA, f₁, f₂, hm.of_centre_iso w⟩

namespace BigHOver

variable (B : BigHSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
variable (F : (BigHOver B S hS)ᵒᵖ ⥤ Type v)

/-! ### The base case of the induction -/

/-- **The base case of the induction of Stacks 0EVI: at most two generators.** A presheaf on the
big h category over `S` which is a sheaf for the Zariski topology and satisfies conditions (3) and
(4) of Stacks 0EVI sends to a cartesian square of sets every almost blowup square of the site
whose base is affine and whose centre is generated by two global sections.

The square of Example 0EVH for those two sections has the same centre, so condition (4) applies to
it, and step 4 of the source's proof transfers cartesianness to the given square. -/
public theorem isAffineGeneratorAlmostBlowUpSheaf_two
    (hzar : BigHOver.IsZariskiSheaf B S hS F)
    (h1 : BigHOver.IsOneGeneratorAlmostBlowUpSheaf B S hS F)
    (h2 : BigHOver.IsTwoGeneratorAlmostBlowUpSheaf B S hS F) :
    IsAffineGeneratorAlmostBlowUpSheaf B S hS F 2 := by
  intro X X' Z E hAff b z d e I hb hZ hsq hg
  have : HasPullbacks B.Schemes := inferInstance
  let _ := schemeSizeBelow_isClosedUnderLimitsOfShape_walkingCospan B.cutoff
  let _ : Limits.PreservesLimitsOfShape Limits.WalkingCospan (BigHOver.toScheme B S hS) :=
    inferInstance
  obtain ⟨g, hgI⟩ := hg
  obtain ⟨Y, Z₁, y, z₁, J, hbY, hZ₁, hshape, hJ⟩ :=
    exists_isTwoGeneratorAlmostBlowUpSquare_of_isAffine B S hS X (g 0) (g 1)
  have hJI : J = I := by
    refine Scheme.IdealSheafData.ext_of_isAffine ?_
    rw [hJ, hgI, span_range_fin_two]
  rw [hJI] at hbY hZ₁
  obtain ⟨ez⟩ := hZ
  obtain ⟨ez₁⟩ := hZ₁
  -- the square of Example 0EVH, with the given centre
  have hshape' : IsTwoGeneratorAlmostBlowUpModel ((BigHOver.toScheme B S hS).map y)
      ((BigHOver.toScheme B S hS).map z) :=
    hshape.of_centre_iso (ez ≪≫ ez₁.symm)
  have hsq₁s : IsPullback (pullback.snd y z) (pullback.fst y z) z y :=
    (IsPullback.of_hasPullback y z).flip
  have hcart₁ : IsPullback (F.map z.op) (F.map y.op) (F.map (pullback.snd y z).op)
      (F.map (pullback.fst y z).op) :=
    h2 X Y Z (pullback y z) y z (pullback.fst y z) (pullback.snd y z) I hAff hbY ⟨ez⟩
      (hsq₁s.map (BigHOver.toScheme B S hS)) hshape'
  -- step 4 of the source's proof
  have := hAff
  exact isPullback_of_isAlmostBlowUpSquare_of_isPullback B S hS F hzar h1 I z y
    (pullback.fst y z) (pullback.snd y z) b d e hbY hb ⟨ez⟩
    (hsq₁s.map (BigHOver.toScheme B S hS)) hsq hcart₁

/-! ### The induction step -/

/-- **The induction step of the proof of Stacks 0EVI.** A presheaf on the big h category over `S`
which satisfies conditions (3) and (4) of Stacks 0EVI, and sends to a cartesian square of sets
every almost blowup square of the site whose centre is locally generated by `n + 2` sections,
sends to a cartesian square of sets every almost blowup square of the site whose base is affine and
whose centre is generated by `n + 3` global sections. -/
public theorem isAffineGeneratorAlmostBlowUpSheaf_succ (n : ℕ)
    (h2 : BigHOver.IsTwoGeneratorAlmostBlowUpSheaf B S hS F)
    (hP : IsLocalGeneratorAlmostBlowUpSheaf B S hS F (n + 2)) :
    IsAffineGeneratorAlmostBlowUpSheaf B S hS F (n + 3) := by
  classical
  intro X X' Z E hAff b z d e I hb hZ hsq hg
  have : HasPullbacks B.Schemes := inferInstance
  let _ := schemeSizeBelow_isClosedUnderLimitsOfShape_walkingCospan B.cutoff
  let _ : Limits.PreservesLimitsOfShape Limits.WalkingCospan (BigHOver.toScheme B S hS) :=
    inferInstance
  have := hAff
  have hP2 : IsLocalGeneratorAlmostBlowUpSheaf B S hS F 2 :=
    IsLocalGeneratorAlmostBlowUpSheaf.antitone B S hS F (by omega) hP
  have hsqsite : IsPullback e d z b := hsq.of_map_of_faithful (BigHOver.toScheme B S hS)
  have hw : e ≫ z = d ≫ b := hsqsite.w
  have hesnd : ∀ {W : BigHOver B S hS} (w : W ⟶ X),
      restrictExcToCen B S hS b z d e hw w ≫ pullback.snd w z =
        pullback.snd w (d ≫ b) ≫ e := fun _ ↦ pullback.lift_snd _ _ _
  have hdsnd : ∀ {W : BigHOver B S hS} (w : W ⟶ X),
      restrictExcToMod B S hS b d w ≫ pullback.snd w b =
        pullback.snd w (d ≫ b) ≫ d := fun _ ↦ pullback.lift_snd _ _ _
  obtain ⟨g, hgI⟩ := hg
  -- the square of Example 0EVH for the first two generators
  obtain ⟨Y, Z₁, y, z₁, J, hbY, hZ₁, hshape, hJ⟩ :=
    exists_isTwoGeneratorAlmostBlowUpSquare_of_isAffine B S hS X (g 0) (g 1)
  obtain ⟨ez₁⟩ := hZ₁
  -- the remaining generators
  set K : ((BigHOver.toScheme B S hS).obj X).IdealSheafData :=
    Scheme.IdealSheafData.ofIdealTop
      (Ideal.span (Set.range (fun i : Fin (n + 1) ↦ g ⟨i + 2, by omega⟩))) with hK
  have hKtop : K.ideal ⟨⊤, isAffineOpen_top ((BigHOver.toScheme B S hS).obj X)⟩ =
      Ideal.span (Set.range (fun i : Fin (n + 1) ↦ g ⟨i + 2, by omega⟩)) :=
    Scheme.IdealSheafData.equivOfIsAffine.apply_symm_apply _
  have hIJK : I = J ⊔ K := by
    refine Scheme.IdealSheafData.ext_of_isAffine ?_
    have hsup : (J ⊔ K).ideal ⟨⊤, isAffineOpen_top ((BigHOver.toScheme B S hS).obj X)⟩ =
        J.ideal ⟨⊤, isAffineOpen_top ((BigHOver.toScheme B S hS).obj X)⟩ ⊔
          K.ideal ⟨⊤, isAffineOpen_top ((BigHOver.toScheme B S hS).obj X)⟩ := rfl
    rw [hgI, span_range_eq_sup g, hsup, hJ, hKtop]
  -- the generator counts
  obtain ⟨g2, hg2⟩ := exists_span_range_pair (g 0) (g 1)
  have hlgJ : Stacks.Divisors.IsLocallyGeneratedBy 2 J :=
    Stacks.Divisors.isLocallyGeneratedBy_of_ideal_top (hJ.trans hg2)
  have hlgK : Stacks.Divisors.IsLocallyGeneratedBy (n + 1) K :=
    Stacks.Divisors.isLocallyGeneratedBy_of_ideal_top hKtop
  have hlgIY : Stacks.Divisors.IsLocallyGeneratedBy (n + 2)
      (I.comap ((BigHOver.toScheme B S hS).map y)) := by
    rw [hIJK, Scheme.IdealSheafData.comap_sup]
    exact (Stacks.Divisors.IsLocallyGeneratedBy.sup
      (hbY.exceptional_locallyPrincipal.isLocallyGeneratedBy_one)
      (hlgK.comap ((BigHOver.toScheme B S hS).map y))).mono (by omega)
  have hlgIZ₁ : Stacks.Divisors.IsLocallyGeneratedBy (n + 2)
      (I.comap ((BigHOver.toScheme B S hS).map z₁)) := by
    rw [hIJK, Scheme.IdealSheafData.comap_sup,
      Scheme.IdealSheafData.comap_eq_bot_of_over_iso J _ ez₁, bot_sup_eq]
    exact (hlgK.comap ((BigHOver.toScheme B S hS).map z₁)).mono (by omega)
  -- the four base changes of the given square, and the two of the square of Example 0EVH
  have bc : ∀ (W : BigHOver B S hS) (w : W ⟶ X),
      Stacks.Divisors.IsLocallyGeneratedBy (n + 2)
        (I.comap ((BigHOver.toScheme B S hS).map w)) →
      IsPullback (F.map (pullback.fst w z).op) (F.map (pullback.fst w b).op)
        (F.map (restrictExcToCen B S hS b z d e hw w).op)
        (F.map (restrictExcToMod B S hS b d w).op) := fun W w hlgw ↦
    hP W (pullback w b) (pullback w z) (pullback w (d ≫ b))
      (pullback.fst w b) (pullback.fst w z) (restrictExcToMod B S hS b d w)
      (restrictExcToCen B S hS b z d e hw w) (I.comap ((BigHOver.toScheme B S hS).map w))
      (isAlmostBlowUpSquare_pullback_fst B S hS b w I hb)
      (nonempty_over_iso_comap_pullback_fst B S hS z w I hZ)
      ((isPullback_restrictExc B S hS hw hsqsite w).map (BigHOver.toScheme B S hS)) hlgw
  have hsq₁s : IsPullback (pullback.snd y z₁) (pullback.fst y z₁) z₁ y :=
    (IsPullback.of_hasPullback y z₁).flip
  have hw₁ : pullback.snd y z₁ ≫ z₁ = pullback.fst y z₁ ≫ y := hsq₁s.w
  have bcc : ∀ (W : BigHOver B S hS) (w : W ⟶ X),
      Stacks.Divisors.IsLocallyGeneratedBy 2
        (J.comap ((BigHOver.toScheme B S hS).map w)) →
      IsPullback (F.map (pullback.fst w z₁).op) (F.map (pullback.fst w y).op)
        (F.map (restrictExcToCen B S hS y z₁ (pullback.fst y z₁) (pullback.snd y z₁) hw₁ w).op)
        (F.map (restrictExcToMod B S hS y (pullback.fst y z₁) w).op) := fun W w hlgw ↦
    hP2 W (pullback w y) (pullback w z₁) (pullback w (pullback.fst y z₁ ≫ y))
      (pullback.fst w y) (pullback.fst w z₁)
      (restrictExcToMod B S hS y (pullback.fst y z₁) w)
      (restrictExcToCen B S hS y z₁ (pullback.fst y z₁) (pullback.snd y z₁) hw₁ w)
      (J.comap ((BigHOver.toScheme B S hS).map w))
      (isAlmostBlowUpSquare_pullback_fst B S hS y w J hbY)
      (nonempty_over_iso_comap_pullback_fst B S hS z₁ w J ⟨ez₁⟩)
      ((isPullback_restrictExc B S hS hw₁ hsq₁s w).map (BigHOver.toScheme B S hS)) hlgw
  -- condition (4) for the square of Example 0EVH
  have hcartC : IsPullback (F.map z₁.op) (F.map y.op) (F.map (pullback.snd y z₁).op)
      (F.map (pullback.fst y z₁).op) :=
    h2 X Y Z₁ (pullback y z₁) y z₁ (pullback.fst y z₁) (pullback.snd y z₁) J hAff hbY ⟨ez₁⟩
      (hsq₁s.map (BigHOver.toScheme B S hS)) hshape
  have hAY := bc Y y hlgIY
  have hAZ₁ := bc Z₁ z₁ hlgIZ₁
  have hAE := bc (pullback y z₁) (pullback.fst y z₁ ≫ y)
    (by rw [Functor.map_comp, Scheme.IdealSheafData.comap_comp]; exact hlgIY.comap _)
  have hAB := bcc X' b (hlgJ.comap ((BigHOver.toScheme B S hS).map b))
  have hAZ := bcc Z z (hlgJ.comap ((BigHOver.toScheme B S hS).map z))
  -- the three fibre-product descriptions, read in `Type v`
  rw [Limits.Types.isPullback_iff] at hAY hAZ₁ hAE hAB hAZ hcartC
  rw [Limits.Types.isPullback_iff]
  refine ⟨?_, ?_, ?_⟩
  · rw [← F.map_comp, ← F.map_comp, ← op_comp, ← op_comp, hw]
  · -- joint injectivity
    rintro s t ⟨hzs, hbs⟩
    refine hcartC.2.1 s t ⟨?_, ?_⟩
    · refine hAZ₁.2.1 _ _ ⟨?_, ?_⟩
      · rw [map_op_comp_apply, map_op_comp_apply, (IsPullback.of_hasPullback z₁ z).w,
          ← map_op_comp_apply, ← map_op_comp_apply, hzs]
      · rw [map_op_comp_apply, map_op_comp_apply, (IsPullback.of_hasPullback z₁ b).w,
          ← map_op_comp_apply, ← map_op_comp_apply, hbs]
    · refine hAY.2.1 _ _ ⟨?_, ?_⟩
      · rw [map_op_comp_apply, map_op_comp_apply, (IsPullback.of_hasPullback y z).w,
          ← map_op_comp_apply, ← map_op_comp_apply, hzs]
      · rw [map_op_comp_apply, map_op_comp_apply, (IsPullback.of_hasPullback y b).w,
          ← map_op_comp_apply, ← map_op_comp_apply, hbs]
  · -- gluing a section
    intro t s' hed
    -- the section over the modification of the square of Example 0EVH
    obtain ⟨sY, hsYz, hsYb⟩ := hAY.2.2 (F.map (pullback.snd y z).op t)
      (F.map (pullback.snd y b).op s') (by
        rw [map_op_comp_apply, map_op_comp_apply, hesnd y, hdsnd y,
          ← map_op_comp_apply, ← map_op_comp_apply, hed])
    -- the section over its centre
    obtain ⟨t₁, ht₁z, ht₁b⟩ := hAZ₁.2.2 (F.map (pullback.snd z₁ z).op t)
      (F.map (pullback.snd z₁ b).op s') (by
        rw [map_op_comp_apply, map_op_comp_apply, hesnd z₁, hdsnd z₁,
          ← map_op_comp_apply, ← map_op_comp_apply, hed])
    -- they agree on the exceptional corner
    have hagree : F.map (pullback.snd y z₁).op t₁ = F.map (pullback.fst y z₁).op sY := by
      refine hAE.2.1 _ _ ⟨?_, ?_⟩
      · rw [map_op_comp_apply, map_op_comp_apply]
        trans F.map (pullback.snd (pullback.fst y z₁ ≫ y) z).op t
        · exact map_op_eq_of_comp_eq_of_isPullback (IsPullback.of_hasPullback z₁ z) ht₁z
            (pullback.fst (pullback.fst y z₁ ≫ y) z ≫ pullback.snd y z₁)
            (pullback.snd (pullback.fst y z₁ ≫ y) z)
            (by rw [Category.assoc, hw₁, ← Category.assoc]
                exact (IsPullback.of_hasPullback (pullback.fst y z₁ ≫ y) z).w)
        · exact (map_op_eq_of_comp_eq_of_isPullback (IsPullback.of_hasPullback y z) hsYz
            (pullback.fst (pullback.fst y z₁ ≫ y) z ≫ pullback.fst y z₁)
            (pullback.snd (pullback.fst y z₁ ≫ y) z)
            (by rw [Category.assoc]
                exact (IsPullback.of_hasPullback (pullback.fst y z₁ ≫ y) z).w)).symm
      · rw [map_op_comp_apply, map_op_comp_apply]
        trans F.map (pullback.snd (pullback.fst y z₁ ≫ y) b).op s'
        · exact map_op_eq_of_comp_eq_of_isPullback (IsPullback.of_hasPullback z₁ b) ht₁b
            (pullback.fst (pullback.fst y z₁ ≫ y) b ≫ pullback.snd y z₁)
            (pullback.snd (pullback.fst y z₁ ≫ y) b)
            (by rw [Category.assoc, hw₁, ← Category.assoc]
                exact (IsPullback.of_hasPullback (pullback.fst y z₁ ≫ y) b).w)
        · exact (map_op_eq_of_comp_eq_of_isPullback (IsPullback.of_hasPullback y b) hsYb
            (pullback.fst (pullback.fst y z₁ ≫ y) b ≫ pullback.fst y z₁)
            (pullback.snd (pullback.fst y z₁ ≫ y) b)
            (by rw [Category.assoc]
                exact (IsPullback.of_hasPullback (pullback.fst y z₁ ≫ y) b).w)).symm
    -- the glued section over the base
    obtain ⟨s, hsz₁, hsy⟩ := hcartC.2.2 t₁ sY hagree
    refine ⟨s, ?_, ?_⟩
    · -- it restricts to the given section of the centre
      refine hAZ.2.1 _ _ ⟨?_, ?_⟩
      · rw [map_op_comp_apply, (IsPullback.of_hasPullback z z₁).w, ← map_op_comp_apply, hsz₁]
        exact map_op_eq_of_comp_eq_of_isPullback (IsPullback.of_hasPullback z₁ z) ht₁z
          (pullback.snd z z₁) (pullback.fst z z₁)
          (IsPullback.of_hasPullback z z₁).w.symm
      · rw [map_op_comp_apply, (IsPullback.of_hasPullback z y).w, ← map_op_comp_apply, hsy]
        exact map_op_eq_of_comp_eq_of_isPullback (IsPullback.of_hasPullback y z) hsYz
          (pullback.snd z y) (pullback.fst z y) (IsPullback.of_hasPullback z y).w.symm
    · -- it restricts to the given section of the modification
      refine hAB.2.1 _ _ ⟨?_, ?_⟩
      · rw [map_op_comp_apply, (IsPullback.of_hasPullback b z₁).w, ← map_op_comp_apply, hsz₁]
        exact map_op_eq_of_comp_eq_of_isPullback (IsPullback.of_hasPullback z₁ b) ht₁b
          (pullback.snd b z₁) (pullback.fst b z₁) (IsPullback.of_hasPullback b z₁).w.symm
      · rw [map_op_comp_apply, (IsPullback.of_hasPullback b y).w, ← map_op_comp_apply, hsy]
        exact map_op_eq_of_comp_eq_of_isPullback (IsPullback.of_hasPullback y b) hsYb
          (pullback.snd b y) (pullback.fst b y) (IsPullback.of_hasPullback b y).w.symm

/-! ### The induction -/

/-- **The induction of the proof of Stacks 0EVI.** A presheaf on the big h category over `S`
which is a sheaf for the Zariski topology and satisfies conditions (3) and (4) of Stacks 0EVI
sends to a cartesian square of sets every almost blowup square of the site whose base is affine
and whose centre is generated by `r` global sections, for every `r`. -/
public theorem isAffineGeneratorAlmostBlowUpSheaf
    (hzar : BigHOver.IsZariskiSheaf B S hS F)
    (h1 : BigHOver.IsOneGeneratorAlmostBlowUpSheaf B S hS F)
    (h2 : BigHOver.IsTwoGeneratorAlmostBlowUpSheaf B S hS F) :
    ∀ r : ℕ, IsAffineGeneratorAlmostBlowUpSheaf B S hS F r := by
  intro r
  induction r using Nat.strong_induction_on with
  | _ r ih =>
    have hP : ∀ k, k < r → IsLocalGeneratorAlmostBlowUpSheaf B S hS F k := fun k hk ↦
      isLocalGeneratorAlmostBlowUpSheaf_of_isAffineGenerator B S hS F k hzar (ih k hk)
    match r with
    | 0 =>
      exact IsAffineGeneratorAlmostBlowUpSheaf.antitone B S hS F (by omega)
        (isAffineGeneratorAlmostBlowUpSheaf_two B S hS F hzar h1 h2)
    | 1 =>
      exact IsAffineGeneratorAlmostBlowUpSheaf.antitone B S hS F (by omega)
        (isAffineGeneratorAlmostBlowUpSheaf_two B S hS F hzar h1 h2)
    | 2 => exact isAffineGeneratorAlmostBlowUpSheaf_two B S hS F hzar h1 h2
    | (n + 3) =>
      exact isAffineGeneratorAlmostBlowUpSheaf_succ B S hS F n h2 (hP (n + 2) (by omega))

/-- **The reduction step in the proof of Stacks 0EVI.** A presheaf on the big h category over `S`
which satisfies conditions (1) to (4) of Stacks 0EVI satisfies condition (3) of Stacks 0EVF: it
sends to a cartesian square of sets *every* almost blowup square of the site with affine base.

On an affine base the centre of an almost blowup square is cut out by a finitely generated ideal
of global sections, because the centre is a closed immersion of finite presentation, so the
induction on the number of generators applies. -/
public theorem isAffineAlmostBlowUpSheaf_of_generatorSquares
    (hzar : BigHOver.IsZariskiSheaf B S hS F)
    (h1 : BigHOver.IsOneGeneratorAlmostBlowUpSheaf B S hS F)
    (h2 : BigHOver.IsTwoGeneratorAlmostBlowUpSheaf B S hS F) :
    BigHOver.IsAffineAlmostBlowUpSheaf B S hS F := by
  classical
  intro X X' Z E b z p e I hAff hb hZ hsq
  have := hAff
  have hft : I.IsFiniteType :=
    (Stacks.Flatness.finitePresentation_subschemeι_iff I).mp hb.center_finitePresentation
  obtain ⟨r, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (hft ⟨⊤, isAffineOpen_top ((BigHOver.toScheme B S hS).obj X)⟩)
  exact isAffineGeneratorAlmostBlowUpSheaf B S hS F hzar h1 h2 r X X' Z E b z p e I
    hb hZ hsq ⟨g, hg.symm⟩

end BigHOver

