module

public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.Sites
public import StacksFrontier.AlgebraicGeometry.Topologies.ZariskiTopology.Sites

/-!
# Affine objects are a basis of the small étale and small Zariski sites

Let `B` be a big étale or big Zariski site containing a scheme `S`. For every object `U` of the
small site of `S`, the arrows into `U` whose source has affine underlying scheme generate a
covering sieve of `U`.

## Main results

* `AlgebraicGeometry.SmallEtale.sieve_generate_isAffine_mem_topology`: affine objects generate a
  covering sieve of every object of the small étale site.
* `AlgebraicGeometry.SmallZariski.sieve_generate_isAffine_mem_topology`: affine objects generate a
  covering sieve of every object of the small Zariski site.
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

/-- **Affine objects generate a covering sieve of the small étale site.** For an object `U` of
the small étale site of `S`, the sieve generated by the arrows into `U` with affine source
covers `U`. -/
public theorem SmallEtale.sieve_generate_isAffine_mem_topology
    (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (U : SmallEtale B S hS) :
    Sieve.generate (fun {V : SmallEtale B S hS} (_ : V ⟶ U) =>
      AlgebraicGeometry.IsAffine ((SmallEtale.toScheme B S hS).obj V)) ∈
        SmallEtale.topology B S hS U := by
  let T := (SmallEtale.toScheme B S hS).obj U
  let E : PreZeroHypercover.{u + 1} U.obj.left := {
    I₀ := ULift.{u + 1} T.affineCover.I₀
    X i := B.obj (T.affineCover.X i.down)
      (Scheme.size_lt_of_isOpenImmersion (T.affineCover.f i.down) U.obj.left.property)
    f i := ObjectProperty.homMk (T.affineCover.f i.down) }
  have hE : IsEtaleCovering ⟨U.obj.left, E⟩ := by
    show (E.map B.inclusion).presieve₀ ∈ Scheme.etalePrecoverage T
    exact (Scheme.presieve₀_mem_precoverage_iff (P := @Etale.{u}) (E.map B.inclusion)).mpr
      ⟨fun x => ⟨ULift.up (T.affineCover.idx x), T.affineCover.covers x⟩,
        fun i => inferInstanceAs (Etale (T.affineCover.f i.down))⟩
  obtain ⟨⟨V, D⟩, hD, heq, hcomb⟩ := B.exists_covering_rep ⟨U.obj.left, E⟩ hE
  dsimp at heq
  subst V
  obtain ⟨β, hβ, hf⟩ := hcomb.2
  have hopen (i : D.I₀) : IsOpenImmersion (B.inclusion.map (D.f i)) := by
    rw [hf i, B.inclusion.map_comp]
    have : IsOpenImmersion (B.inclusion.map (E.f (β i))) :=
      inferInstanceAs (IsOpenImmersion (T.affineCover.f (β i).down))
    infer_instance
  have haff (i : D.I₀) : AlgebraicGeometry.IsAffine (B.inclusion.obj (D.X i)) := by
    rw [hβ i]
    exact inferInstanceAs (AlgebraicGeometry.IsAffine (T.affineCover.X (β i).down))
  let W (i : D.I₀) : SmallEtale B S hS :=
    ⟨Over.mk (D.f i ≫ U.obj.hom), by
      show Etale (B.inclusion.map (D.f i ≫ U.obj.hom))
      rw [B.inclusion.map_comp]
      have := hopen i
      infer_instance⟩
  let D' : PreZeroHypercover.{u + 1} U := {
    I₀ := D.I₀
    X := W
    f i := ObjectProperty.homMk (Over.homMk (D.f i) rfl) }
  refine (SmallEtale.topology B S hS).superset_covering ((Sieve.generate_le_iff _ _).mpr ?_)
    ((SmallEtale.precoverage B S hS).generate_mem_toGrothendieck
      (show D'.presieve₀ ∈ SmallEtale.precoverage B S hS U from ⟨D', rfl, hD⟩))
  rintro Y f ⟨i⟩
  exact Sieve.le_generate _ _ _ (haff i)

/-- **Affine objects generate a covering sieve of the small Zariski site.** For an object `U` of
the small Zariski site of `S`, the sieve generated by the arrows into `U` with affine source
covers `U`. -/
public theorem SmallZariski.sieve_generate_isAffine_mem_topology
    (B : BigZariskiSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (U : SmallZariski B S hS) :
    Sieve.generate (fun {V : SmallZariski B S hS} (_ : V ⟶ U) =>
      AlgebraicGeometry.IsAffine ((SmallZariski.toScheme B S hS).obj V)) ∈
        SmallZariski.topology B S hS U := by
  let T := (SmallZariski.toScheme B S hS).obj U
  let E : PreZeroHypercover.{u + 1} U.obj.left := {
    I₀ := ULift.{u + 1} T.affineCover.I₀
    X i := ⟨T.affineCover.X i.down,
      Scheme.size_lt_of_isOpenImmersion (T.affineCover.f i.down) U.obj.left.property⟩
    f i := ObjectProperty.homMk (T.affineCover.f i.down) }
  have hE : IsZariskiCovering ⟨U.obj.left, E⟩ := by
    show (E.map B.inclusion).presieve₀ ∈ Scheme.zariskiPretopology T
    exact (Scheme.presieve₀_mem_precoverage_iff (P := @IsOpenImmersion.{u})
      (E.map B.inclusion)).mpr
      ⟨fun x => ⟨ULift.up (T.affineCover.idx x), T.affineCover.covers x⟩,
        fun i => inferInstanceAs (IsOpenImmersion (T.affineCover.f i.down))⟩
  obtain ⟨⟨V, D⟩, hD, heq, hcomb⟩ := B.covering_representative ⟨U.obj.left, E⟩ hE
  dsimp at heq
  subst V
  obtain ⟨β, hβ, hf⟩ := hcomb.2
  have hopen (i : D.I₀) : IsOpenImmersion (B.inclusion.map (D.f i)) := by
    rw [hf i, B.inclusion.map_comp]
    have : IsOpenImmersion (B.inclusion.map (E.f (β i))) :=
      inferInstanceAs (IsOpenImmersion (T.affineCover.f (β i).down))
    infer_instance
  have haff (i : D.I₀) : AlgebraicGeometry.IsAffine (B.inclusion.obj (D.X i)) := by
    rw [hβ i]
    exact inferInstanceAs (AlgebraicGeometry.IsAffine (T.affineCover.X (β i).down))
  let W (i : D.I₀) : SmallZariski B S hS :=
    ⟨Over.mk (D.f i ≫ U.obj.hom), by
      show IsOpenImmersion (B.inclusion.map (D.f i ≫ U.obj.hom))
      rw [B.inclusion.map_comp]
      have := hopen i
      infer_instance⟩
  let D' : PreZeroHypercover.{u + 1} U := {
    I₀ := D.I₀
    X := W
    f i := ObjectProperty.homMk (Over.homMk (D.f i) rfl) }
  refine (SmallZariski.topology B S hS).superset_covering ((Sieve.generate_le_iff _ _).mpr ?_)
    ((SmallZariski.precoverage B S hS).generate_mem_toGrothendieck
      (show D'.presieve₀ ∈ SmallZariski.precoverage B S hS U from ⟨D', rfl, hD⟩))
  rintro Y f ⟨i⟩
  exact Sieve.le_generate _ _ _ (haff i)

end AlgebraicGeometry

end
