module

public import Mathlib.CategoryTheory.ObjectProperty.Equivalence
public import Mathlib.CategoryTheory.Sites.CoverLifting
public import Mathlib.CategoryTheory.Sites.DenseSubsite.InducedTopology
public import Mathlib.CategoryTheory.Sites.Equivalence
public import Mathlib.CategoryTheory.Sites.Hypercover.Zero
public import Mathlib.CategoryTheory.Sites.InducedTopology
public import StacksFrontier.AlgebraicGeometry.Topologies.ChangeOfSites.CoverPreserving

/-!
# An equivalence of categories which is an isomorphism of sites

A site is very often presented by a *precoverage* whose covering presieves are exactly those
presented by a distinguished class of covering families: a presieve on `X` is covering when it
is the presieve of a `0`-hypercover `E` of `X` belonging to the class. The small étale site and
the affine étale site of a presheaf on a big fppf site are both of this form, as are the étale,
fppf, ph and Zariski sites of a scheme.

For an *equivalence* `e : C ≌ D` of two such sites, the whole package of site-theoretic
compatibilities follows from one combinatorial input: that each half of `e` carries a
distinguished covering family to a distinguished covering family. This file isolates that
input, as `CategoryTheory.Equivalence.IsIsoOfSites`, and derives the package from it once and
for all — so that a site presented this way never has to repeat the derivation.

## Main definitions

* `CategoryTheory.Equivalence.IsIsoOfSites` is the property of an equivalence `e : C ≌ D` that
  both `e.functor` and `e.inverse` are cover preserving for a Grothendieck topology on `C` and
  one on `D`.

## Main results

* `CategoryTheory.coverPreserving_toGrothendieck_of_isCovering`: a functor preserving fibre
  products is cover preserving for two precoverage-generated topologies as soon as it carries
  the covering families presenting one to covering families presenting the other.
* `CategoryTheory.Equivalence.isIsoOfSites_of_isCovering`: the same criterion applied to both
  halves of an equivalence gives
  `CategoryTheory.Equivalence.IsIsoOfSites`.
* `CategoryTheory.Equivalence.IsIsoOfSites.functor_isCocontinuous`,
  `CategoryTheory.Equivalence.IsIsoOfSites.inverse_isCocontinuous` and
  `CategoryTheory.Equivalence.IsIsoOfSites.functor_isContinuous`: both halves are
  cocontinuous, and the functor is continuous, so restriction of sheaves along it is defined.
* `CategoryTheory.Equivalence.IsIsoOfSites.functor_isDenseSubsite`: the equivalence exhibits
  the one site as a dense subsite of the other, which is what transports sheaves.
* `CategoryTheory.Equivalence.IsIsoOfSites.functor_restrictedTopology` and
  `CategoryTheory.Equivalence.IsIsoOfSites.functor_inducedTopology`: the topology of `C` is the
  one restricted, equivalently induced, along the equivalence from the topology of `D`.
* `CategoryTheory.Equivalence.congrFullSubcategory_functor_comp_ι` and
  `CategoryTheory.Equivalence.congrFullSubcategory_inverse_comp_ι`: the equivalence of full
  subcategories induced by an equivalence of the ambient categories acts on the underlying
  objects as the ambient equivalence does.

## Implementation notes

The distinguished class of covering families is taken as an arbitrary predicate on
`(X : C) × CategoryTheory.PreZeroHypercover X`, and the way the precoverage is presented by it
as a hypothesis in the shape of the `mem_precoverage_iff` lemma a concrete site provides. This
keeps the statements independent of how the precoverage happens to be defined, at the price of
two hypotheses that are `Iff.rfl` in practice.

Cover preservation is read off the generating families with
`CategoryTheory.coverPreserving_of_generators`. Everything else is formal: cocontinuity of each
half is cover preservation of the other through
`CategoryTheory.Adjunction.isCocontinuous_iff_coverPreserving` for the two adjunctions of the
equivalence, cocontinuity in both directions gives the dense subsite by
`CategoryTheory.Equivalence.isDenseSubsite_functor_of_isCocontinuous`, and a dense subsite
identifies the restricted topology with the given one, hence with the induced one once the
functor is known to be continuous.
-/

@[expose] public section

open CategoryTheory.Limits

universe w v₁ v₂ u₁ u₂

namespace CategoryTheory

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]

/-- A functor preserving fibre products is cover preserving for two topologies generated by
precoverages, each presented by a distinguished class of `0`-hypercovers, as soon as it carries
a distinguished covering family of the source to a distinguished covering family of the
target. -/
theorem coverPreserving_toGrothendieck_of_isCovering [HasPullbacks C] (L : C ⥤ D)
    [PreservesLimitsOfShape WalkingCospan L] (P : Precoverage C) (Q : Precoverage D)
    (p : (X : C) × PreZeroHypercover.{w} X → Prop)
    (q : (Y : D) × PreZeroHypercover.{w} Y → Prop)
    (hP : ∀ (X : C) (R : Presieve X), R ∈ P X ↔
      ∃ E : PreZeroHypercover.{w} X, R = E.presieve₀ ∧ p ⟨X, E⟩)
    (hQ : ∀ (Y : D) (R : Presieve Y), R ∈ Q Y ↔
      ∃ E : PreZeroHypercover.{w} Y, R = E.presieve₀ ∧ q ⟨Y, E⟩)
    (hpq : ∀ (X : C) (E : PreZeroHypercover.{w} X), p ⟨X, E⟩ → q ⟨L.obj X, E.map L⟩) :
    CoverPreserving P.toGrothendieck Q.toGrothendieck L := by
  refine coverPreserving_of_generators L P _ ?_
  intro A R hR
  obtain ⟨E, rfl, hE⟩ := (hP A R).mp hR
  rw [← Sieve.generate_map_eq_functorPushforward]
  refine Precoverage.generate_mem_toGrothendieck ((hQ _ _).2 ⟨E.map L, ?_, hpq A E hE⟩)
  simp [PreZeroHypercover.presieve₀_map]

namespace Equivalence

/-- An equivalence of categories is an **isomorphism of sites** for a topology `J` on its
source and a topology `K` on its target when both of its halves are cover preserving. All the
site-theoretic compatibilities of the equivalence follow from this: see
`CategoryTheory.Equivalence.IsIsoOfSites.functor_isDenseSubsite` and
`CategoryTheory.Equivalence.IsIsoOfSites.functor_inducedTopology`. -/
structure IsIsoOfSites (e : C ≌ D) (J : GrothendieckTopology C) (K : GrothendieckTopology D) :
    Prop where
  /-- The equivalence carries a covering sieve of `J` to a covering sieve of `K`. -/
  functor_coverPreserving : CoverPreserving J K e.functor
  /-- The inverse equivalence carries a covering sieve of `K` to a covering sieve of `J`. -/
  inverse_coverPreserving : CoverPreserving K J e.inverse

/-- An equivalence is an isomorphism of two sites presented by distinguished classes of
`0`-hypercovers as soon as each of its halves carries a distinguished covering family to a
distinguished covering family. -/
theorem isIsoOfSites_of_isCovering [HasPullbacks C] [HasPullbacks D] (e : C ≌ D)
    (P : Precoverage C) (Q : Precoverage D)
    (p : (X : C) × PreZeroHypercover.{w} X → Prop)
    (q : (Y : D) × PreZeroHypercover.{w} Y → Prop)
    (hP : ∀ (X : C) (R : Presieve X), R ∈ P X ↔
      ∃ E : PreZeroHypercover.{w} X, R = E.presieve₀ ∧ p ⟨X, E⟩)
    (hQ : ∀ (Y : D) (R : Presieve Y), R ∈ Q Y ↔
      ∃ E : PreZeroHypercover.{w} Y, R = E.presieve₀ ∧ q ⟨Y, E⟩)
    (hpq : ∀ (X : C) (E : PreZeroHypercover.{w} X), p ⟨X, E⟩ →
      q ⟨e.functor.obj X, E.map e.functor⟩)
    (hqp : ∀ (Y : D) (E : PreZeroHypercover.{w} Y), q ⟨Y, E⟩ →
      p ⟨e.inverse.obj Y, E.map e.inverse⟩) :
    e.IsIsoOfSites P.toGrothendieck Q.toGrothendieck where
  functor_coverPreserving :=
    coverPreserving_toGrothendieck_of_isCovering e.functor P Q p q hP hQ hpq
  inverse_coverPreserving :=
    coverPreserving_toGrothendieck_of_isCovering e.inverse Q P q p hQ hP hqp

namespace IsIsoOfSites

variable {e : C ≌ D} {J : GrothendieckTopology C} {K : GrothendieckTopology D}

/-- The inverse of an isomorphism of sites is cocontinuous: it is adjoint to a cover preserving
functor. -/
theorem inverse_isCocontinuous (h : e.IsIsoOfSites J K) : e.inverse.IsCocontinuous K J :=
  (e.symm.toAdjunction.isCocontinuous_iff_coverPreserving K J).2 h.functor_coverPreserving

/-- An isomorphism of sites is cocontinuous. -/
theorem functor_isCocontinuous (h : e.IsIsoOfSites J K) : e.functor.IsCocontinuous J K :=
  (e.toAdjunction.isCocontinuous_iff_coverPreserving J K).2 h.inverse_coverPreserving

/-- An isomorphism of sites is continuous, so restriction of sheaves along it is defined. -/
theorem functor_isContinuous (h : e.IsIsoOfSites J K) : e.functor.IsContinuous J K :=
  Functor.isContinuous_iff_coverPreserving.2 h.functor_coverPreserving

/-- An isomorphism of sites exhibits its source as a dense subsite of its target. -/
theorem functor_isDenseSubsite (h : e.IsIsoOfSites J K) : e.functor.IsDenseSubsite J K :=
  have := h.functor_isCocontinuous
  have := h.inverse_isCocontinuous
  Equivalence.isDenseSubsite_functor_of_isCocontinuous _ _ e

/-- A sieve is covering for the source topology of an isomorphism of sites exactly when the
sieve it generates on the corresponding object of the target is covering. -/
theorem functor_restrictedTopology (h : e.IsIsoOfSites J K) :
    e.functor.restrictedTopology K = J := by
  have hDense := h.functor_isDenseSubsite
  ext A R
  rw [Functor.mem_restrictedTopology_iff]
  exact hDense.functorPushforward_mem_iff

/-- **The source of an isomorphism of sites is its target, topology included**: the topology of
the source is the one induced along the equivalence from the topology of the target. -/
theorem functor_inducedTopology (h : e.IsIsoOfSites J K) : e.functor.inducedTopology K = J :=
  have := h.functor_isContinuous
  e.functor.restrictedTopology_eq_inducedTopology_of_isContinuous h.functor_restrictedTopology

end IsIsoOfSites

/-- The equivalence of full subcategories induced by an equivalence of the ambient categories
acts on the underlying objects as the ambient equivalence does. -/
theorem congrFullSubcategory_functor_comp_ι {P : ObjectProperty C} {Q : ObjectProperty D}
    [Q.IsClosedUnderIsomorphisms] (e : C ≌ D) (h : Q.inverseImage e.functor = P) :
    (e.congrFullSubcategory h).functor ⋙ Q.ι = P.ι ⋙ e.functor := rfl

/-- Read backwards: the inverse of the equivalence of full subcategories acts on the underlying
objects as the inverse of the ambient equivalence does. -/
theorem congrFullSubcategory_inverse_comp_ι {P : ObjectProperty C} {Q : ObjectProperty D}
    [Q.IsClosedUnderIsomorphisms] (e : C ≌ D) (h : Q.inverseImage e.functor = P) :
    (e.congrFullSubcategory h).inverse ⋙ P.ι = Q.ι ⋙ e.inverse := rfl

end Equivalence

end CategoryTheory

end
