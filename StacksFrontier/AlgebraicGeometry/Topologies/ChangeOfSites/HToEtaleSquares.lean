module

public import StacksFrontier.AlgebraicGeometry.Topologies.ChangeOfSites.ChosenEtaleSite
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.SmallEtaleBaseChange
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.SmallEtaleProjection
public import StacksFrontier.AlgebraicGeometry.Topologies.HTopology.EtaleHComparison
public import StacksFrontier.AlgebraicGeometry.Topologies.HTopology.MorphismOfTopoi
public import StacksFrontier.CategoryTheory.Sites.Topos.MorphismOfTopoi

/-!
# Change of topology from h to étale, and the resulting push-pull squares

The underlying category of a chosen big h site carries a second topology, the one generated by
its bounded étale coverings; this is legitimate because an étale covering is an h covering.
Restriction along the identity functor of a slice is then a morphism of topoi `ε` from the big
h topos to the big étale topos, and composing with the projection `π` to the small étale topos
gives a morphism `a = π ∘ ε` to the latter.  Both comparisons commute with the morphisms
induced by a morphism `f : X ⟶ Y` of the site: the square formed by the big h and big étale
base-change morphisms over `ε_X`, `ε_Y`, and the square formed by the big h and small étale
base-change morphisms over `a_X`, `a_Y`, commute up to canonical natural isomorphism of the
direct-image functors.

## Main definitions

* `AlgebraicGeometry.hAssociatedBigEtaleSite` — the same category of schemes as a chosen big
  h site, with its bounded étale coverings.
* `AlgebraicGeometry.hToBigEtaleMorphism` and `AlgebraicGeometry.hToSmallEtaleMorphism` — the
  change-of-topology morphism `ε_X` and its composite `a_X` with the big-to-small projection.
* `AlgebraicGeometry.hSmallEtaleMorphism` — the morphism of small étale topoi induced by base
  change in the associated étale site.

## Main results

* `AlgebraicGeometry.etaleBounded_eq_hEtaleBounded`, `AlgebraicGeometry.hEtaleCovering_isSite`
  and `AlgebraicGeometry.hEtaleCovering_has_representative` — the étale coverings chosen by a
  big h site form a site with enough representatives, which is what makes the associated big
  étale site exist.
* `AlgebraicGeometry.bigEtaleOverTopology_le_bigHOverTopology` — étale coverings of a slice are
  h coverings, which is what makes restriction continuous, and
  `AlgebraicGeometry.hToBigEtale_pushforwardIso` identifies the direct image of the
  change-of-topology morphism with that restriction.
* `AlgebraicGeometry.bigHBigEtale_pushforwardCommIso` and
  `AlgebraicGeometry.bigHSmallEtale_pushforwardCommIso` — the two commuting squares of
  Stacks 0EW9.

## Implementation notes

The associated étale site has the same cutoff, covering bound and covering ordinal as the
given h site, and no prescribed initial coverings.  That a bounded étale covering is one of the
h site's chosen coverings is `AlgebraicGeometry.isHCoveringInCutoff_of_isEtaleCovering`, the
étale case of Stacks 0ETV; nothing else about h coverings is used.

Commutativity of a square of geometric morphisms is expressed by a natural isomorphism of the
direct-image functors, there being no `2`-cells on
`CategoryTheory.MorphismOfTopoi`.  The comparison to the small site is defined as the stated
composite, so its factorization through the big étale topos holds definitionally and the second
square reduces to the first together with the commuting square for small étale base change,
Stacks 021I.  In particular Stacks 0EW8 is not needed: `a_X` is literally
`CategoryTheory.MorphismOfTopoi.comp`.

Unlike its fppf counterpart the direct image of the big h base-change morphism is already
restriction along `CategoryTheory.Over.pullback`, so the first square needs no intermediate
identification of a cocontinuous pushforward with a continuous one.

## References

* [Stacks Project, Tag 021G](https://stacks.math.columbia.edu/tag/021G)
* [Stacks Project, Tag 021H](https://stacks.math.columbia.edu/tag/021H)
* [Stacks Project, Tag 0ETS](https://stacks.math.columbia.edu/tag/0ETS)
* [Stacks Project, Tag 0ETV](https://stacks.math.columbia.edu/tag/0ETV)
* [Stacks Project, Tag 0EU1](https://stacks.math.columbia.edu/tag/0EU1)
* [Stacks Project, Tag 0EW9](https://stacks.math.columbia.edu/tag/0EW9)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Cardinal

universe u

namespace AlgebraicGeometry

/-- A chosen covering of a big h site which is étale is the same thing as a bounded étale
covering, because an étale covering is an h covering. -/
public theorem etaleBounded_eq_hEtaleBounded (B : BigHSite.{u}) (E : Covering B.Schemes) :
    (B.IsCovering E ∧ IsEtaleCovering E) ↔
      CovBounded (IsEtaleCovering (κ := B.cutoff)) B.coveringBound E :=
  ⟨fun ⟨⟨_, hbound⟩, hetale⟩ ↦ ⟨hetale, hbound⟩,
    fun ⟨hetale, hbound⟩ ↦ ⟨⟨isHCoveringInCutoff_of_isEtaleCovering E hetale, hbound⟩, hetale⟩⟩

/-- The étale subcollection of the chosen coverings of a big h site satisfies the site
axioms. -/
public theorem hEtaleCovering_isSite (B : BigHSite.{u}) :
    IsSite (fun E : Covering B.Schemes ↦ B.IsCovering E ∧ IsEtaleCovering E) := by
  have : MorphismProperty.IsStableUnderComposition
      (@Etale : MorphismProperty Scheme.{u}) :=
    (inferInstance : MorphismProperty.IsMultiplicative
      (@Etale : MorphismProperty Scheme.{u})).toIsStableUnderComposition
  have : Precoverage.HasIsos Scheme.etalePrecoverage.{u} :=
    ⟨by
      intro S T f hf
      show Presieve.singleton f ∈ Scheme.etalePretopology T
      exact Scheme.etalePretopology.has_isos f⟩
  have : Scheme.etalePrecoverage.{u}.IsStableUnderComposition := by
    unfold Scheme.etalePrecoverage
    exact schemePrecoverage_stableUnderComposition _
  have : Scheme.etalePrecoverage.{u}.IsStableUnderBaseChange := by
    unfold Scheme.etalePrecoverage
    exact schemePrecoverage_stableUnderBaseChange _
  exact isSite_and_precoverage B.inclusion B.IsCovering Scheme.etalePrecoverage B.isSite

/-- Every étale covering of the underlying category of a big h site is combinatorially
equivalent to one of the site's chosen coverings, which is then again étale. -/
public theorem hEtaleCovering_has_representative (B : BigHSite.{u}) (E : Covering B.Schemes)
    (hE : IsEtaleCovering E) :
    ∃ E' : Covering B.Schemes,
      (B.IsCovering E' ∧ IsEtaleCovering E') ∧ Covering.CombEquiv E E' := by
  obtain ⟨E', hB, hCE⟩ :=
    B.covering_representative E (isHCoveringInCutoff_of_isEtaleCovering E hE)
  exact ⟨E', ⟨hB, (map_mem_iff_of_combEquiv B.inclusion Scheme.etalePrecoverage hCE).mp hE⟩,
    hCE⟩

/-- The étale site on the underlying category of a chosen big h site. -/
public abbrev hAssociatedBigEtaleSite (B : BigHSite.{u}) : BigEtaleSite.{u} := by
  let Cov₀ : Set.{u + 2} (Covering.{u + 1, u, u + 1} B.Schemes) := ∅
  exact {
    S₀ := ∅
    small_S₀ := inferInstance
    cutoff := B.cutoff
    aleph0_lt_cutoff := B.aleph0_lt_cutoff
    cutoff_isStrongPrelimit := B.cutoff_isStrongPrelimit
    aleph0_lt_cutoff_cof := B.aleph0_lt_cutoff_cof
    mem_cutoff_of_mem := by simp
    initialCoverings := Cov₀
    small_initialCoverings := inferInstance
    initial_objects_mem := by simp [Cov₀]
    initialCoverings_etale := by simp [Cov₀]
    coveringBound := B.coveringBound
    coveringOrdinal := B.coveringOrdinal
    coveringOrdinal_isSuccLimit := B.coveringOrdinal_isSuccLimit
    initialCoverings_bounded := by simp [Cov₀]
    coverings_isSite := by
      simpa only [etaleBounded_eq_hEtaleBounded] using hEtaleCovering_isSite B
    exists_covering_rep := fun E hE ↦ (hEtaleCovering_has_representative B E hE).imp
      fun E' h ↦ ⟨(etaleBounded_eq_hEtaleBounded B E').mp h.1, h.2⟩
  }

/-- Every covering for the associated étale topology is a covering for the h topology. -/
public theorem hAssociatedEtaleTopology_le_hTopology (B : BigHSite.{u}) :
    (hAssociatedBigEtaleSite B).topology ≤ B.topology := by
  apply Precoverage.toGrothendieck_mono
  rintro X R ⟨E, hR, hE⟩
  exact ⟨E, hR, (etaleBounded_eq_hEtaleBounded B ⟨X, E⟩).mpr hE |>.1⟩

/-- The big-site comparison from h to étale is induced by the identity functor on the common
slice category: every étale covering of the slice is an h covering of the slice. -/
public theorem bigEtaleOverTopology_le_bigHOverTopology (B : BigHSite.{u}) (X : B.Schemes) :
    BigEtaleOver.topology (hAssociatedBigEtaleSite B) X.1 X.2 ≤ B.topology.over X := by
  apply Precoverage.toGrothendieck_le_iff_le_toPrecoverage.mpr
  intro Y R hR
  obtain ⟨E, hR, hE⟩ := (BigEtaleOver.mem_precoverage_iff _ _ _).mp hR
  rw [GrothendieckTopology.mem_toPrecoverage_iff, hR, GrothendieckTopology.mem_over_iff]
  let p := Over.forget ((hAssociatedBigEtaleSite B).obj X.1 X.2)
  let E' : Covering (hAssociatedBigEtaleSite B).Scheme := ⟨Y.left, E.map p⟩
  have hE' : (hAssociatedBigEtaleSite B).IsCovering E' := hE
  have hmem : (E.presieve₀.map (Over.forget X)) ∈
      (hAssociatedBigEtaleSite B).precoverage Y.left := by
    refine ⟨E.map p, ?_, hE'⟩
    rw [← PreZeroHypercover.presieve₀_map]
  have heq : Sieve.overEquiv Y (Sieve.generate E.presieve₀) =
      Sieve.generate (E.presieve₀.map p) := by
    show Sieve.functorPushforward p (Sieve.generate E.presieve₀) = _
    exact Sieve.generate_map_eq_functorPushforward p |>.symm
  rw [heq]
  exact hAssociatedEtaleTopology_le_hTopology B Y.left
    (Precoverage.generate_mem_toGrothendieck hmem)

/-- Restriction along the identity on the common slice takes h sheaves to étale sheaves. -/
public instance hChangeOfTopology_isContinuous (B : BigHSite.{u}) (X : B.Schemes) :
    (𝟭 (Over X)).IsContinuous
      (BigEtaleOver.topology (hAssociatedBigEtaleSite B) X.1 X.2)
      (B.topology.over X) :=
  let J := BigEtaleOver.topology (hAssociatedBigEtaleSite B) X.1 X.2
  let h := bigEtaleOverTopology_le_bigHOverTopology B X
  { op_comp_isSheaf_of_types := fun G => by
      change Presieve.IsSheaf J G.obj
      exact (isSheaf_iff_isSheaf_of_type _ _).1 (G.property.of_le h) }

/-- The comparison `ε_X` from the big h topos to the big étale topos, induced by the identity
functor on the common slice category. -/
@[stacks 0EW9 "change-of-topology morphism"]
public def hToBigEtaleMorphism (B : BigHSite.{u}) (X : B.Schemes) :
    MorphismOfTopoi
      (Sheaf (B.topology.over X) (Type (u + 1)))
      (Sheaf (BigEtaleOver.topology (hAssociatedBigEtaleSite B) X.1 X.2) (Type (u + 1))) := by
  let J := BigEtaleOver.topology (hAssociatedBigEtaleSite B) X.1 X.2
  let K := B.topology.over X
  letI : (𝟭 (Over X)).IsContinuous J K := hChangeOfTopology_isContinuous B X
  haveI : PreservesFiniteLimits
      (((𝟭 (Over X)).op.lan :
        ((Over X)ᵒᵖ ⥤ Type (u + 1)) ⥤ ((Over X)ᵒᵖ ⥤ Type (u + 1)))) := by
    have e : (𝟭 (Over X)).op.lan ≅ 𝟭 ((Over X)ᵒᵖ ⥤ Type (u + 1)) := by
      simpa only [Functor.whiskeringLeft_obj_id] using
        Adjunction.leftAdjointUniq
          ((𝟭 (Over X)).op.lanAdjunction (Type (u + 1))) Adjunction.id
    exact preservesFiniteLimits_of_natIso e.symm
  exact
    { pushforward := (𝟭 (Over X)).sheafPushforwardContinuous (Type (u + 1)) J K
      inverseImage := (𝟭 (Over X)).sheafPullback (Type (u + 1)) J K
      adj := (𝟭 (Over X)).sheafAdjunctionContinuous (Type (u + 1)) J K
      preservesFiniteLimits :=
        Functor.sheafPullbackConstruction.preservesFiniteLimits
          (𝟭 (Over X)) (Type (u + 1)) J K }

/-- The direct image of the change-of-topology morphism is restriction of h sheaves along the
identity functor on the common slice category. -/
public def hToBigEtale_pushforwardIso (B : BigHSite.{u}) (X : B.Schemes) :
    (hToBigEtaleMorphism B X).pushforward ≅
      (𝟭 (Over X)).sheafPushforwardContinuous (Type (u + 1))
        (BigEtaleOver.topology (hAssociatedBigEtaleSite B) X.1 X.2)
        (B.topology.over X) := by
  dsimp [hToBigEtaleMorphism]
  exact Iso.refl _

/-- The comparison `a_X = π_X ∘ ε_X` from the big h topos to the small étale topos. -/
@[stacks 0EW9 "factorization through the big étale topos"]
public def hToSmallEtaleMorphism (B : BigHSite.{u}) (X : B.Schemes) :
    MorphismOfTopoi
      (Sheaf (B.topology.over X) (Type (u + 1)))
      (Sheaf (SmallEtale.topology (hAssociatedBigEtaleSite B) X.1 X.2) (Type (u + 1))) :=
  (bigEtaleToSmallEtaleMorphism (hAssociatedBigEtaleSite B) X.1 X.2).comp
    (hToBigEtaleMorphism B X)

/-- The morphism of small étale topoi induced by base change along a morphism of the big h
site, formed in its associated big étale site. -/
public def hSmallEtaleMorphism (B : BigHSite.{u}) {X Y : B.Schemes} (f : X ⟶ Y) :
    MorphismOfTopoi
      (Sheaf (SmallEtale.topology (hAssociatedBigEtaleSite B) X.1 X.2) (Type (u + 1)))
      (Sheaf (SmallEtale.topology (hAssociatedBigEtaleSite B) Y.1 Y.2) (Type (u + 1))) :=
  let E := hAssociatedBigEtaleSite B
  let g := smallEtaleBaseChange E f
  let h := smallEtaleBaseChange_isMorphismOfSites E f
  letI := h.toIsContinuous
  let L := Classical.choose h.hasExactLeftAdjoint
  let hL := Classical.choose_spec h.hasExactLeftAdjoint
  { pushforward := g.sheafPushforwardContinuous (Type (u + 1))
      (SmallEtale.topology E Y.1 Y.2) (SmallEtale.topology E X.1 X.2)
    inverseImage := L
    adj := Classical.choice hL.1
    preservesFiniteLimits := hL.2 }

/-- **Stacks 0EW9, first diagram.** The square formed by the big h and big étale base-change
morphisms over the change-of-topology comparisons `ε_X` and `ε_Y` commutes on direct
images. -/
@[stacks 0EW9 "the big h–big étale square"]
public def bigHBigEtale_pushforwardCommIso (B : BigHSite.{u}) {X Y : B.Schemes} (f : X ⟶ Y) :
    ((bigEtaleMorphism (hAssociatedBigEtaleSite B) X Y f).comp
      (hToBigEtaleMorphism B X)).pushforward ≅
      ((hToBigEtaleMorphism B Y).comp (bigHMorphismOfTopoi B f)).pushforward := by
  let E := hAssociatedBigEtaleSite B
  let JeX := BigEtaleOver.topology E X.1 X.2
  let JeY := BigEtaleOver.topology E Y.1 Y.2
  let JhX := B.topology.over X
  let JhY := B.topology.over Y
  let eX : Over X ⥤ Over X := 𝟭 _
  let eY : Over Y ⥤ Over Y := 𝟭 _
  let bp : Over Y ⥤ Over X := Over.pullback f
  haveI : eX.IsContinuous JeX JhX := hChangeOfTopology_isContinuous B X
  haveI : eY.IsContinuous JeY JhY := hChangeOfTopology_isContinuous B Y
  haveI : bp.IsContinuous JeY JeX := bigEtalePullback_isContinuous E X Y f
  haveI : bp.IsContinuous JhY JhX := by
    dsimp [bp, JhX, JhY]
    infer_instance
  haveI : (bp ⋙ eX).IsContinuous JeY JhX := Functor.isContinuous_comp bp eX JeY JeX JhX
  haveI : (eY ⋙ bp).IsContinuous JeY JhX := Functor.isContinuous_comp eY bp JeY JhY JhX
  let eXpush := eX.sheafPushforwardContinuous (Type (u + 1)) JeX JhX
  let eYpush := eY.sheafPushforwardContinuous (Type (u + 1)) JeY JhY
  let hEtale := bigEtaleMorphismPushforwardIso E X Y f
  let hEpsX := hToBigEtale_pushforwardIso B X
  let hEpsY := hToBigEtale_pushforwardIso B Y
  let hCompL := Functor.sheafPushforwardContinuousComp bp eX (Type (u + 1)) JeY JeX JhX
  let hCompR := Functor.sheafPushforwardContinuousComp eY bp (Type (u + 1)) JeY JhY JhX
  let hSite : bp ⋙ eX ≅ eY ⋙ bp := Iso.refl _
  let hSitePush := Functor.sheafPushforwardContinuousIso hSite (Type (u + 1)) JeY JhX
  exact
    Functor.isoWhiskerRight hEpsX (bigEtaleMorphism E X Y f).pushforward ≪≫
    Functor.isoWhiskerLeft eXpush hEtale ≪≫ hCompL ≪≫ hSitePush ≪≫ hCompR.symm ≪≫
    Functor.isoWhiskerLeft (bigHMorphismOfTopoi B f).pushforward hEpsY.symm

/-- **Stacks 0EW9, second diagram.** The square formed by the big h and small étale
base-change morphisms over the comparisons `a_X = π_X ∘ ε_X` and `a_Y = π_Y ∘ ε_Y` commutes on
direct images. -/
@[stacks 0EW9 "the big h–small étale square"]
public def bigHSmallEtale_pushforwardCommIso (B : BigHSite.{u}) {X Y : B.Schemes} (f : X ⟶ Y) :
    ((hSmallEtaleMorphism B f).comp (hToSmallEtaleMorphism B X)).pushforward ≅
      ((hToSmallEtaleMorphism B Y).comp (bigHMorphismOfTopoi B f)).pushforward := by
  let εX := hToBigEtaleMorphism B X
  let εY := hToBigEtaleMorphism B Y
  let πX := bigEtaleToSmallEtaleMorphism (hAssociatedBigEtaleSite B) X.1 X.2
  let πY := bigEtaleToSmallEtaleMorphism (hAssociatedBigEtaleSite B) Y.1 Y.2
  let s := hSmallEtaleMorphism B f
  let b := bigHMorphismOfTopoi B f
  let hSmall := bigSmallEtalePushforwardCommIso (hAssociatedBigEtaleSite B) X Y f
  let hBig := bigHBigEtale_pushforwardCommIso B f
  change ((εX.pushforward ⋙ πX.pushforward) ⋙ s.pushforward) ≅
    (b.pushforward ⋙ (εY.pushforward ⋙ πY.pushforward))
  exact
    Functor.associator εX.pushforward πX.pushforward s.pushforward ≪≫
    Functor.isoWhiskerLeft εX.pushforward hSmall ≪≫
    (Functor.associator εX.pushforward
      (bigEtaleMorphism (hAssociatedBigEtaleSite B) X Y f).pushforward
      πY.pushforward).symm ≪≫
    Functor.isoWhiskerRight hBig πY.pushforward ≪≫
    Functor.associator b.pushforward εY.pushforward πY.pushforward

end AlgebraicGeometry

end
