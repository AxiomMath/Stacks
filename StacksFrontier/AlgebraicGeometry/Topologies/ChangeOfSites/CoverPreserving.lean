module

public import Mathlib.CategoryTheory.Sites.CoverPreserving
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck

/-!
# Checking cover preservation on the generators of a topology

A Grothendieck topology generated by a precoverage is generated by the sieves of its
covering presieves, so a functor is cover preserving for it as soon as it carries those
generating presieves to covering sieves. This file records that reduction, together with the
compatibility of sieve pushforward and pullback it rests on.

## Main results

* `CategoryTheory.pullback_functorPushforward_le` — the pullback of a pushed-forward sieve
  along the image of a morphism contains the pushforward of the pullback.
* `CategoryTheory.coverPreserving_of_generators` — a functor preserving fibre products is
  cover preserving for a topology generated by a precoverage as soon as it preserves the
  generating covering families.
-/

@[expose] public section

open CategoryTheory.Limits

universe v₁ v₂ u₁ u₂

namespace CategoryTheory

/-- The pullback of a pushed-forward sieve along the image of a morphism contains the
pushforward of the pullback, for a functor preserving fibre products. -/
public lemma pullback_functorPushforward_le {C : Type u₁} [Category.{v₁} C]
    {D : Type u₂} [Category.{v₂} D] [HasPullbacks C] (F : C ⥤ D)
    [PreservesLimitsOfShape WalkingCospan F] {X Y : C} (f : Y ⟶ X) (R : Sieve X) :
    (R.functorPushforward F).pullback (F.map f) ≤
      (R.pullback f).functorPushforward F := by
  intro Z g hg
  obtain ⟨V, a, b, ha, he⟩ := hg
  let h := (IsPullback.of_hasPullback a f).map F
  let l := h.lift b g (by simpa using he.symm)
  refine ⟨pullback a f, pullback.snd a f, l, ?_, ?_⟩
  · change R (pullback.snd a f ≫ f)
    rw [← pullback.condition]
    exact R.downward_closed ha (pullback.fst a f)
  · exact (h.lift_snd _ _ _).symm

/-- A functor preserving fibre products is cover preserving for a topology generated by a
precoverage as soon as it preserves the generating families. -/
public lemma coverPreserving_of_generators {C : Type u₁} [Category.{v₁} C]
    {D : Type u₂} [Category.{v₂} D] [HasPullbacks C] (F : C ⥤ D)
    [PreservesLimitsOfShape WalkingCospan F]
    (P : Precoverage C) (K : GrothendieckTopology D)
    (hgen : ∀ {X : C} {R : Presieve X}, R ∈ P X →
      (Sieve.generate R).functorPushforward F ∈ K (F.obj X)) :
    CoverPreserving P.toGrothendieck K F := by
  refine ⟨fun {X S} hS => ?_⟩
  rw [Precoverage.mem_toGrothendieck_iff] at hS
  induction hS with
  | of X R hR => exact hgen hR
  | top X => simp
  | pullback X R hR Y f ih =>
      exact K.superset_covering (pullback_functorPushforward_le F f R)
        (K.pullback_stable (F.map f) ih)
  | transitive X R Q hR hRQ ihR ihRQ =>
      apply K.transitive ihR
      intro Y f hf
      obtain ⟨Z, g, k, hg, he⟩ := hf
      have hk := K.pullback_stable k (ihRQ hg)
      refine K.superset_covering ?_ hk
      intro W q hq
      have hq' := (Sieve.functorPushforward_pullback_le F g Q) (q ≫ k) hq
      change (Q.functorPushforward F) ((q ≫ k) ≫ F.map g) at hq'
      change (Q.functorPushforward F) (q ≫ f)
      rw [he]
      simpa only [Category.assoc] using hq'

/-- Base change of a slice object along `f` is the fibre product of the slice structure
morphisms, displayed as a pullback square in the ambient category. -/
public lemma baseChange_square {C : Type*} [Category C] [HasPullbacks C]
    {A X S T : C} (a : A ⟶ X) (b : X ⟶ S) (bA : A ⟶ S) (f : T ⟶ S)
    (h : a ≫ b = bA) :
    IsPullback
      (pullback.lift (pullback.fst bA f ≫ a) (pullback.snd bA f)
        (by rw [Category.assoc, h]; exact pullback.condition))
      (pullback.fst bA f) (pullback.fst b f) a := by
  refine ⟨⟨by exact pullback.lift_fst _ _ _⟩,
    ⟨PullbackCone.IsLimit.mk _ ?_ ?_ ?_ ?_⟩⟩
  · intro c
    refine pullback.lift c.snd (c.fst ≫ pullback.snd b f) ?_
    calc
      c.snd ≫ bA = c.snd ≫ a ≫ b := by rw [← h]
      _ = c.fst ≫ pullback.fst b f ≫ b := by
        simpa only [Category.assoc] using congrArg (fun k => k ≫ b) c.condition.symm
      _ = c.fst ≫ pullback.snd b f ≫ f := by
        rw [pullback.condition]
    all_goals simp only [Category.assoc]
  · intro c
    apply pullback.hom_ext
    · simpa only [Category.assoc, pullback.lift_fst_assoc, pullback.lift_fst] using
        c.condition.symm
    · simp only [Category.assoc, pullback.lift_snd, pullback.lift_snd]
  · intro c
    exact pullback.lift_fst _ _ _
  · intro c m hm₁ hm₂
    apply pullback.hom_ext
    · simpa only [Category.assoc, pullback.lift_fst] using hm₂
    · simpa only [Category.assoc, pullback.lift_snd] using
        congrArg (fun k => k ≫ pullback.snd b f) hm₁

/-- The sheaf condition for a family of arrows is unchanged by composing them with an
isomorphism of the target. -/
public theorem isSheafFor_postcomp_iso
    {C : Type*} [Category C] (P : Cᵒᵖ ⥤ Type*) {T T' : C}
    {ι : Type*} {X : ι → C} (f : ∀ i, X i ⟶ T) (e : T ≅ T') :
    Presieve.IsSheafFor P (Presieve.ofArrows X f) ↔
      Presieve.IsSheafFor P (Presieve.ofArrows X (fun i => f i ≫ e.hom)) := by
  rw [Presieve.isSheafFor_iff_generate (Presieve.ofArrows X f),
    Presieve.isSheafFor_iff_generate (Presieve.ofArrows X (fun i => f i ≫ e.hom))]
  have he := Presieve.isSheafFor_pullback_iff P (Sieve.ofArrows X f) e.inv
  change Presieve.IsSheafFor P
    (Sieve.pullback e.symm.hom (Sieve.ofArrows X f)).arrows ↔ _ at he
  rw [Sieve.pullback_ofArrows_of_iso X f e.symm] at he
  exact he.symm

end CategoryTheory
