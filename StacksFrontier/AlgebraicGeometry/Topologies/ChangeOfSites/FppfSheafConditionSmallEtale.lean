module

public import StacksFrontier.AlgebraicGeometry.Topologies.ChangeOfSites.FppfSheafCondition
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.SmallEtalePullbackFpqcEtaleRefinement
public import StacksFrontier.AlgebraicGeometry.Topologies.Fpqc.FinerTopologies

/-!
# Inverse image from the small étale site is an fppf sheaf

Let `B` be a chosen big fppf site, let `S` be one of its schemes and let `F` be a sheaf of sets
on the small étale site of `S`. By Stacks 09XN the presheaf underlying `π_S⁻¹F` on the big étale
site over `S` — the rule `X ↦ Γ(X_ét, f_X⁻¹F)` — satisfies the sheaf condition for fpqc
coverings. Every chosen fppf covering family is an fpqc covering family, so `π_S⁻¹F` is in
particular a sheaf for the big fppf topology over `S`. Since the direct image of the
change-of-topology morphism `ε_S` from the big fppf topos over `S` to the big étale topos over
`S` is restriction along the identity functor, this says exactly that the unit of
`ε_S⁻¹ ⊣ ε_{S,*}` is an isomorphism at `π_S⁻¹F`, which is Stacks 0DDL.

## Main results

* `AlgebraicGeometry.BigFppfSite.precoverage_le_fpqcPrecoverage_comap` — the chosen covering
  families of a big fppf site are fpqc covering families.
* `AlgebraicGeometry.isSheaf_bigFppfOver_of_isSheaf_fpqc_comap` — a presheaf on the slice over
  `S` which is a sheaf for the fpqc topology of the chosen site is a sheaf for the big fppf
  topology over `S`.
* `AlgebraicGeometry.smallEtaleInverseImage_isSheaf_fppf` — **Stacks 0DDL, the fppf sheaf
  condition**: the presheaf underlying `π_S⁻¹F` is a sheaf for the big fppf topology over `S`.
* `AlgebraicGeometry.isIso_fppfToBigEtale_unit_app` — **Stacks 0DDL, the canonical fppf
  comparison**: the unit of `ε_S⁻¹ ⊣ ε_{S,*}` is an isomorphism at `π_S⁻¹F`.

## Implementation notes

The comparison of topologies is made on the slice by localising a comparison on the chosen
category of schemes. Writing `K` for the fpqc precoverage comapped along the inclusion of the
chosen category into all schemes, `K` is stable under base change and the chosen category has
fibre products, so Mathlib's
`CategoryTheory.over_toGrothendieck_eq_toGrothendieck_comap_forget` identifies the localisation
of `K.toGrothendieck` at `S` with the topology generated by the comap of `K` along the slice
projection, and `CategoryTheory.Precoverage.comap_comp` identifies the latter with the fpqc
topology of the slice as it is stated throughout the library. The comparison on the chosen
category is `Stacks.Sites.over_mono` applied to the inclusion
`AlgebraicGeometry.BigFppfSite.precoverage_le_fpqcPrecoverage_comap` of precoverages.

The last step is the equivalence
`AlgebraicGeometry.isIso_fppfToBigEtale_unit_app_iff`, which needs no new input: the
underlying categories of the big fppf site and of its associated big étale site agree, so the
direct image of `ε_S` is restriction along the identity functor and is fully faithful.

## References

* [Stacks Project, Tag 03O4](https://stacks.math.columbia.edu/tag/03O4)
* [Stacks Project, Tag 09XN](https://stacks.math.columbia.edu/tag/09XN)
* [Stacks Project, Tag 0DDL](https://stacks.math.columbia.edu/tag/0DDL)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

variable (B : BigFppfSite.{u}) (S : B.Schemes)

/-- The chosen covering families of a big fppf site are fpqc covering families of schemes:
they are fppf covering families by `AlgebraicGeometry.BigFppfSite.isFppfCovering_of_isCovering`,
and the fppf precoverage of schemes is contained in the fpqc precoverage. -/
public theorem BigFppfSite.precoverage_le_fpqcPrecoverage_comap :
    B.precoverage ≤ Scheme.fpqcPrecoverage.comap B.inclusion := by
  intro X R hR
  rw [Precoverage.mem_comap_iff]
  refine Scheme.fppfPrecoverage_le_fpqcPrecoverage _ ?_
  obtain ⟨E, rfl, hE⟩ := hR
  have h2 := B.isFppfCovering_of_isCovering hE
  rw [IsFppfCovering, Precoverage.mem_comap_iff, PreZeroHypercover.presieve₀,
    Presieve.map_ofArrows] at h2
  rw [PreZeroHypercover.presieve₀, Presieve.map_ofArrows]
  exact h2

/-- The big fppf topology over `S` is coarser than the fpqc topology of the chosen slice over
`S`: localise `AlgebraicGeometry.BigFppfSite.precoverage_le_fpqcPrecoverage_comap` at `S`. -/
public theorem BigFppfSite.topology_over_le_fpqcPrecoverage_comap_toGrothendieck :
    B.topology.over S ≤
      (Scheme.fpqcPrecoverage.comap
        (BigEtaleOver.toScheme (associatedBigEtaleSite B) S.1 S.property)).toGrothendieck := by
  refine (Stacks.Sites.over_mono
    (Precoverage.toGrothendieck_mono (B.precoverage_le_fpqcPrecoverage_comap)) S).trans ?_
  rw [over_toGrothendieck_eq_toGrothendieck_comap_forget, Precoverage.comap_comp]

/-- A presheaf of sets on the slice over `S` which satisfies the fpqc sheaf condition of the
chosen site satisfies the big fppf sheaf condition over `S`. -/
public theorem isSheaf_bigFppfOver_of_isSheaf_fpqc_comap
    (P : (BigEtaleOver (associatedBigEtaleSite B) S.1 S.property)ᵒᵖ ⥤ Type (u + 1))
    (h : Presheaf.IsSheaf ((Scheme.fpqcPrecoverage.comap
      (BigEtaleOver.toScheme (associatedBigEtaleSite B) S.1 S.property)).toGrothendieck) P) :
    Presheaf.IsSheaf (B.topology.over S) P := by
  rw [isSheaf_iff_isSheaf_of_type] at h ⊢
  exact Presieve.isSheaf_of_le _
    (B.topology_over_le_fpqcPrecoverage_comap_toGrothendieck S) h

/-- **Stacks 0DDL, the fppf sheaf condition.** For a sheaf of sets `F` on the small étale site
of `S`, the presheaf underlying `π_S⁻¹F` — by the sections formula the rule
`X ↦ Γ(X_ét, f_X⁻¹F)` — is a sheaf for the big fppf topology over `S`.

By Stacks 09XN, `AlgebraicGeometry.bigEtaleToSmallEtale_inverseImage_isSheaf_fpqc`, it is a
sheaf for the much finer fpqc topology of the chosen slice, and every chosen fppf covering
family is an fpqc covering family. -/
@[stacks 0DDL "the fppf sheaf condition"]
public theorem smallEtaleInverseImage_isSheaf_fppf
    (F : Sheaf (SmallEtale.topology (associatedBigEtaleSite B) S.1 S.property)
      (Type (u + 1))) :
    Presheaf.IsSheaf (B.topology.over S)
      ((bigEtaleToSmallEtaleMorphism (associatedBigEtaleSite B) S.1 S.property).inverseImage.obj
        F).obj :=
  isSheaf_bigFppfOver_of_isSheaf_fpqc_comap B S _
    (bigEtaleToSmallEtale_inverseImage_isSheaf_fpqc (associatedBigEtaleSite B) S.1 S.property F)

/-- **Stacks 0DDL, the canonical fppf comparison.** At `π_S⁻¹F` the unit of `ε_S⁻¹ ⊣ ε_{S,*}`
is an isomorphism. Since `ε_{S,*}` is restriction along the identity functor, this identifies
the fppf sheaf `ε_S⁻¹π_S⁻¹F` with the rule `X ↦ Γ(X_ét, f_X⁻¹F)`.

By `AlgebraicGeometry.isIso_fppfToBigEtale_unit_app_iff` the assertion is exactly the fppf
sheaf condition `AlgebraicGeometry.smallEtaleInverseImage_isSheaf_fppf`. -/
@[stacks 0DDL "the canonical fppf comparison"]
public theorem isIso_fppfToBigEtale_unit_app
    (F : Sheaf (SmallEtale.topology (associatedBigEtaleSite B) S.1 S.property)
      (Type (u + 1))) :
    IsIso ((fppfToBigEtaleMorphism B S).adj.unit.app
      ((bigEtaleToSmallEtaleMorphism (associatedBigEtaleSite B) S.1
        S.property).inverseImage.obj F)) :=
  (isIso_fppfToBigEtale_unit_app_iff B S _).2
    (smallEtaleInverseImage_isSheaf_fppf B S F)

end AlgebraicGeometry

end
