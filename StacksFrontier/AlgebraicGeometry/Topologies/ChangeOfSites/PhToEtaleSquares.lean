module

public import StacksFrontier.AlgebraicGeometry.Topologies.ChangeOfSites.ChosenEtaleSite
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.SmallEtaleBaseChange
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.SmallEtaleProjection
public import StacksFrontier.AlgebraicGeometry.Topologies.HTopology.EtaleHComparison
public import StacksFrontier.AlgebraicGeometry.Topologies.Ph.MorphismOfTopoi
public import StacksFrontier.CategoryTheory.Sites.Topos.MorphismOfTopoi

/-!
# Change of topology from ph to étale, and the resulting push-pull squares

The underlying category of a chosen big ph site carries a second topology, the one generated by
its bounded étale coverings; this is legitimate because an étale covering is a ph covering.
Restriction along the identity functor of a slice is then a morphism of topoi `ε` from the big
ph topos to the big étale topos, and composing with the projection `π` to the small étale topos
gives a morphism `a = π ∘ ε` to the latter.  Both comparisons commute with the morphisms
induced by a morphism `f : X ⟶ Y` of the site: the square formed by the big ph and big étale
base-change morphisms over `ε_X`, `ε_Y`, and the square formed by the big ph and small étale
base-change morphisms over `a_X`, `a_Y`, commute up to canonical natural isomorphism of the
direct-image functors.

## Main definitions

* `AlgebraicGeometry.phAssociatedBigEtaleSite` — the same category of schemes as a chosen big
  ph site, with its bounded étale coverings.
* `AlgebraicGeometry.phToBigEtaleMorphism` and `AlgebraicGeometry.phToSmallEtaleMorphism` — the
  change-of-topology morphism `ε_X` and its composite `a_X` with the big-to-small projection.
* `AlgebraicGeometry.phSmallEtaleMorphism` — the morphism of small étale topoi induced by base
  change in the associated étale site.

## Main results

* `AlgebraicGeometry.isPHCoveringInCutoff_of_isEtaleCovering`,
  `AlgebraicGeometry.etaleBounded_eq_phEtaleBounded`,
  `AlgebraicGeometry.phEtaleCovering_isSite` and
  `AlgebraicGeometry.phEtaleCovering_has_representative` — the étale coverings chosen by a big
  ph site form a site with enough representatives, which is what makes the associated big étale
  site exist.
* `AlgebraicGeometry.bigEtaleOverTopology_le_bigPHOverTopology` — étale coverings of a slice are
  ph coverings, which is what makes restriction continuous.
* `AlgebraicGeometry.bigPHBigEtale_pushforwardCommIso` and
  `AlgebraicGeometry.bigPHSmallEtale_pushforwardCommIso` — the two commuting squares of
  Stacks 0DDX.

## Implementation notes

The associated étale site has the same cutoff, covering bound and covering ordinal as the given
ph site, and no prescribed initial coverings, so the two sites have the same underlying category
and hence literally the same slices.  That a bounded étale covering is a ph covering is the
étale case of Stacks 0DBT; nothing else about ph coverings is used.

Commutativity of a square of geometric morphisms is expressed by a natural isomorphism of the
direct-image functors, there being no `2`-cells on `CategoryTheory.MorphismOfTopoi`.  The
comparison to the small site is defined as the stated composite, so the identity `a = π ∘ ε`
holds definitionally and the second square reduces to the first together with the commuting
square for small étale base change, Stacks 021I.  As for the fppf topology, the direct image of
the big ph base-change morphism is a cocontinuous pushforward, so the first square needs the
intermediate identification of Stacks 0DBR with restriction along `CategoryTheory.Over.pullback`.

## References

* [Stacks Project, Tag 021G](https://stacks.math.columbia.edu/tag/021G)
* [Stacks Project, Tag 021I](https://stacks.math.columbia.edu/tag/021I)
* [Stacks Project, Tag 0DBR](https://stacks.math.columbia.edu/tag/0DBR)
* [Stacks Project, Tag 0DBT](https://stacks.math.columbia.edu/tag/0DBT)
* [Stacks Project, Tag 0DDX](https://stacks.math.columbia.edu/tag/0DDX)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Cardinal

universe u

namespace AlgebraicGeometry

/-- An étale covering family in a size-bounded category of schemes is a ph covering family
there, since both conditions are read off the image of the family in all schemes. -/
@[stacks 0DBT "étale coverings in a cutoff category"]
public theorem isPHCoveringInCutoff_of_isEtaleCovering {κ : Cardinal.{u}}
    (𝒰 : Covering.{u + 1, u, u + 1} (SchemeBelow κ)) (h𝒰 : IsEtaleCovering 𝒰) :
    IsPHCoveringInCutoff 𝒰 :=
  have h := (Scheme.presieve₀_mem_precoverage_iff (P := @Etale)
    (𝒰.2.map (schemeBelowInclusion κ))).mp h𝒰
  isPHCovering_of_etale _ _ h.1 h.2

/-- A chosen covering of a big ph site which is étale is the same thing as a bounded étale
covering, because an étale covering is a ph covering. -/
public theorem etaleBounded_eq_phEtaleBounded (B : BigPHSite.{u}) (E : Covering B.Schemes) :
    (B.IsCovering E ∧ IsEtaleCovering E) ↔
      CovBounded (IsEtaleCovering (κ := B.cutoff)) B.coveringBound E :=
  ⟨fun ⟨⟨_, hbound⟩, hetale⟩ ↦ ⟨hetale, hbound⟩,
    fun ⟨hetale, hbound⟩ ↦ ⟨⟨isPHCoveringInCutoff_of_isEtaleCovering E hetale, hbound⟩, hetale⟩⟩

/-- The étale subcollection of the chosen coverings of a big ph site satisfies the site
axioms. -/
public theorem phEtaleCovering_isSite (B : BigPHSite.{u}) :
    IsSite (fun E : Covering B.Schemes ↦ B.IsCovering E ∧ IsEtaleCovering E) := by
  have : MorphismProperty.IsStableUnderComposition
      (@Etale : MorphismProperty Scheme.{u}) :=
    (inferInstance : MorphismProperty.IsMultiplicative
      (@Etale : MorphismProperty Scheme.{u})).toIsStableUnderComposition
  have : Precoverage.HasIsos Scheme.etalePrecoverage.{u} :=
    ⟨by
      intro S T f _
      exact Scheme.etalePretopology.has_isos f⟩
  have : Scheme.etalePrecoverage.{u}.IsStableUnderComposition :=
    schemePrecoverage_stableUnderComposition (@Etale)
  have : Scheme.etalePrecoverage.{u}.IsStableUnderBaseChange :=
    schemePrecoverage_stableUnderBaseChange (@Etale)
  exact isSite_and_precoverage B.inclusion B.IsCovering Scheme.etalePrecoverage B.isSite

/-- Every étale covering of the underlying category of a big ph site is combinatorially
equivalent to one of the site's chosen coverings, which is then again étale. -/
public theorem phEtaleCovering_has_representative (B : BigPHSite.{u}) (E : Covering B.Schemes)
    (hE : IsEtaleCovering E) :
    ∃ E' : Covering B.Schemes,
      (B.IsCovering E' ∧ IsEtaleCovering E') ∧ Covering.CombEquiv E E' := by
  obtain ⟨E', hB, hCE⟩ :=
    B.covering_representative E (isPHCoveringInCutoff_of_isEtaleCovering E hE)
  exact ⟨E', ⟨hB, (map_mem_iff_of_combEquiv B.inclusion Scheme.etalePrecoverage hCE).mp hE⟩,
    hCE⟩

/-- The étale site on the underlying category of a chosen big ph site. -/
public abbrev phAssociatedBigEtaleSite (B : BigPHSite.{u}) : BigEtaleSite.{u} := by
  let Cov₀ : Set.{u + 2} (Covering.{u + 1, u, u + 1} B.Schemes) := ∅
  have hpred : (fun E : Covering B.Schemes ↦ B.IsCovering E ∧ IsEtaleCovering E) =
      (fun E ↦ CovBounded (IsEtaleCovering (κ := B.cutoff)) B.coveringBound E) := by
    funext E
    exact propext (etaleBounded_eq_phEtaleBounded B E)
  have hsite : IsSite (CovBounded (IsEtaleCovering (κ := B.cutoff)) B.coveringBound) := by
    change IsSite (fun E : Covering B.Schemes ↦
      CovBounded (IsEtaleCovering (κ := B.cutoff)) B.coveringBound E)
    rw [← hpred]
    exact phEtaleCovering_isSite B
  have hrep : ∀ E : Covering B.Schemes, IsEtaleCovering E →
      ∃ E' : Covering B.Schemes,
        CovBounded (IsEtaleCovering (κ := B.cutoff)) B.coveringBound E' ∧
          Covering.CombEquiv E E' := by
    intro E hE
    obtain ⟨E', hE', hEq⟩ := phEtaleCovering_has_representative B E hE
    exact ⟨E', (etaleBounded_eq_phEtaleBounded B E').mp hE', hEq⟩
  letI : Small.{u + 1} Cov₀ := inferInstance
  letI : Small.{u} (∅ : Set Scheme.{u}) := inferInstance
  exact {
    S₀ := ∅
    small_S₀ := inferInstance
    cutoff := B.cutoff
    aleph0_lt_cutoff := B.aleph0_lt_cutoff
    cutoff_isStrongPrelimit := B.cutoff_isStrongPrelimit
    aleph0_lt_cutoff_cof := B.aleph0_lt_cutoff_cof
    mem_cutoff_of_mem := by simp
    initialCoverings := Cov₀
    small_initialCoverings := inferInstance
    initial_objects_mem := by simp [Cov₀]
    initialCoverings_etale := by simp [Cov₀]
    coveringBound := B.coveringBound
    coveringOrdinal := B.coveringOrdinal
    coveringOrdinal_isSuccLimit := B.coveringOrdinal_isSuccLimit
    initialCoverings_bounded := by simp [Cov₀]
    coverings_isSite := hsite
    exists_covering_rep := hrep
  }

/-- Every covering for the associated étale topology is a covering for the ph topology. -/
public theorem phAssociatedEtaleTopology_le_phTopology (B : BigPHSite.{u}) :
    (phAssociatedBigEtaleSite B).topology ≤ B.topology := by
  apply Precoverage.toGrothendieck_mono
  rintro X R ⟨E, hR, hE⟩
  exact ⟨E, hR, (etaleBounded_eq_phEtaleBounded B ⟨X, E⟩).mpr hE |>.1⟩

/-- The big-site comparison from ph to étale is induced by the identity functor on the common
slice category: every étale covering of the slice is a ph covering of the slice. -/
@[stacks 0DBT "étale coverings on a slice"]
public theorem bigEtaleOverTopology_le_bigPHOverTopology (B : BigPHSite.{u}) (X : B.Schemes) :
    BigEtaleOver.topology (phAssociatedBigEtaleSite B) X.1 X.2 ≤ B.topology.over X := by
  apply Precoverage.toGrothendieck_le_iff_le_toPrecoverage.mpr
  intro Y R hR
  obtain ⟨E, hR, hE⟩ := (BigEtaleOver.mem_precoverage_iff _ _ _).mp hR
  rw [GrothendieckTopology.mem_toPrecoverage_iff, hR, GrothendieckTopology.mem_over_iff]
  let p := Over.forget ((phAssociatedBigEtaleSite B).obj X.1 X.2)
  have hmem : (E.presieve₀.map (Over.forget X)) ∈
      (phAssociatedBigEtaleSite B).precoverage Y.left := by
    refine ⟨E.map p, ?_, hE⟩
    rw [← PreZeroHypercover.presieve₀_map]
  have heq : Sieve.overEquiv Y (Sieve.generate E.presieve₀) =
      Sieve.generate (E.presieve₀.map p) :=
    (Sieve.generate_map_eq_functorPushforward p).symm
  rw [heq]
  exact phAssociatedEtaleTopology_le_phTopology B Y.left
    (Precoverage.generate_mem_toGrothendieck hmem)

/-- Restriction along the identity on the common slice takes ph sheaves to étale sheaves. -/
public instance phChangeOfTopology_isContinuous (B : BigPHSite.{u}) (X : B.Schemes) :
    (𝟭 (Over X)).IsContinuous
      (BigEtaleOver.topology (phAssociatedBigEtaleSite B) X.1 X.2)
      (B.topology.over X) :=
  let J := BigEtaleOver.topology (phAssociatedBigEtaleSite B) X.1 X.2
  { op_comp_isSheaf_of_types := fun G => by
      change Presieve.IsSheaf J G.obj
      exact (isSheaf_iff_isSheaf_of_type _ _).1 (G.property.of_le
        (bigEtaleOverTopology_le_bigPHOverTopology B X)) }

/-- The comparison `ε_X` from the big ph topos to the big étale topos, induced by the identity
functor on the common slice category. -/
@[stacks 0DDX "change-of-topology morphism"]
public def phToBigEtaleMorphism (B : BigPHSite.{u}) (X : B.Schemes) :
    MorphismOfTopoi
      (Sheaf (B.topology.over X) (Type (u + 1)))
      (Sheaf (BigEtaleOver.topology (phAssociatedBigEtaleSite B) X.1 X.2)
        (Type (u + 1))) := by
  let J := BigEtaleOver.topology (phAssociatedBigEtaleSite B) X.1 X.2
  let K := B.topology.over X
  letI : (𝟭 (Over X)).IsContinuous J K := phChangeOfTopology_isContinuous B X
  haveI : PreservesFiniteLimits
      (((𝟭 (Over X)).op.lan :
        ((Over X)ᵒᵖ ⥤ Type (u + 1)) ⥤ ((Over X)ᵒᵖ ⥤ Type (u + 1)))) := by
    have e : (𝟭 (Over X)).op.lan ≅ 𝟭 ((Over X)ᵒᵖ ⥤ Type (u + 1)) := by
      simpa only [Functor.whiskeringLeft_obj_id] using
        Adjunction.leftAdjointUniq
          ((𝟭 (Over X)).op.lanAdjunction (Type (u + 1))) Adjunction.id
    exact preservesFiniteLimits_of_natIso e.symm
  exact
    { pushforward := (𝟭 (Over X)).sheafPushforwardContinuous (Type (u + 1)) J K
      inverseImage := (𝟭 (Over X)).sheafPullback (Type (u + 1)) J K
      adj := (𝟭 (Over X)).sheafAdjunctionContinuous (Type (u + 1)) J K
      preservesFiniteLimits :=
        Functor.sheafPullbackConstruction.preservesFiniteLimits
          (𝟭 (Over X)) (Type (u + 1)) J K }

/-- The direct image of the change-of-topology morphism is restriction of ph sheaves along the
identity functor on the common slice category. -/
public def phToBigEtale_pushforwardIso (B : BigPHSite.{u}) (X : B.Schemes) :
    (phToBigEtaleMorphism B X).pushforward ≅
      (𝟭 (Over X)).sheafPushforwardContinuous (Type (u + 1))
        (BigEtaleOver.topology (phAssociatedBigEtaleSite B) X.1 X.2)
        (B.topology.over X) := by
  dsimp [phToBigEtaleMorphism]
  exact Iso.refl _

/-- The comparison `a_X = π_X ∘ ε_X` from the big ph topos to the small étale topos. -/
@[stacks 0DDX "factorization through the big étale topos"]
public def phToSmallEtaleMorphism (B : BigPHSite.{u}) (X : B.Schemes) :
    MorphismOfTopoi
      (Sheaf (B.topology.over X) (Type (u + 1)))
      (Sheaf (SmallEtale.topology (phAssociatedBigEtaleSite B) X.1 X.2) (Type (u + 1))) :=
  (bigEtaleToSmallEtaleMorphism (phAssociatedBigEtaleSite B) X.1 X.2).comp
    (phToBigEtaleMorphism B X)

/-- The morphism of small étale topoi induced by base change along a morphism of the big ph
site, formed in its associated big étale site. -/
public def phSmallEtaleMorphism (B : BigPHSite.{u}) {X Y : B.Schemes} (f : X ⟶ Y) :
    MorphismOfTopoi
      (Sheaf (SmallEtale.topology (phAssociatedBigEtaleSite B) X.1 X.2) (Type (u + 1)))
      (Sheaf (SmallEtale.topology (phAssociatedBigEtaleSite B) Y.1 Y.2) (Type (u + 1))) :=
  let E := phAssociatedBigEtaleSite B
  let g := smallEtaleBaseChange E f
  let h := smallEtaleBaseChange_isMorphismOfSites E f
  letI := h.toIsContinuous
  let L := Classical.choose h.hasExactLeftAdjoint
  let hL := Classical.choose_spec h.hasExactLeftAdjoint
  { pushforward := g.sheafPushforwardContinuous (Type (u + 1))
      (SmallEtale.topology E Y.1 Y.2) (SmallEtale.topology E X.1 X.2)
    inverseImage := L
    adj := Classical.choice hL.1
    preservesFiniteLimits := hL.2 }

/-- **Stacks 0DDX, first diagram.** The square formed by the big ph and big étale base-change
morphisms over the change-of-topology comparisons `ε_X` and `ε_Y` commutes on direct
images. -/
@[stacks 0DDX "the big ph–big étale square"]
public def bigPHBigEtale_pushforwardCommIso (B : BigPHSite.{u}) {X Y : B.Schemes} (f : X ⟶ Y) :
    ((bigEtaleMorphism (phAssociatedBigEtaleSite B) X Y f).comp
      (phToBigEtaleMorphism B X)).pushforward ≅
      ((phToBigEtaleMorphism B Y).comp (bigPHMorphism B X Y f)).pushforward := by
  let E := phAssociatedBigEtaleSite B
  let JeX := BigEtaleOver.topology E X.1 X.2
  let JeY := BigEtaleOver.topology E Y.1 Y.2
  let JpX := B.topology.over X
  let JpY := B.topology.over Y
  let eX : Over X ⥤ Over X := 𝟭 _
  let eY : Over Y ⥤ Over Y := 𝟭 _
  let bp : Over Y ⥤ Over X := Over.pullback f
  have heX : eX.IsContinuous JeX JpX := phChangeOfTopology_isContinuous B X
  have heY : eY.IsContinuous JeY JpY := phChangeOfTopology_isContinuous B Y
  have hbpE : bp.IsContinuous JeY JeX := bigEtalePullback_isContinuous E X Y f
  have hbpP : bp.IsContinuous JpY JpX := by
    dsimp [bp, JpX, JpY]
    infer_instance
  letI := heX
  letI := heY
  letI := hbpE
  letI := hbpP
  haveI : (bp ⋙ eX).IsContinuous JeY JpX := Functor.isContinuous_comp bp eX JeY JeX JpX
  haveI : (eY ⋙ bp).IsContinuous JeY JpX := Functor.isContinuous_comp eY bp JeY JpY JpX
  let eXpush := eX.sheafPushforwardContinuous (Type (u + 1)) JeX JpX
  let eYpush := eY.sheafPushforwardContinuous (Type (u + 1)) JeY JpY
  let hEtale := bigEtaleMorphismPushforwardIso E X Y f
  let hPH :
      (Over.map f).sheafPushforwardCocontinuous (Type (u + 1)) JpX JpY ≅
        (Over.pullback f).sheafPushforwardContinuous (Type (u + 1)) JpY JpX :=
    (Over.mapPullbackAdj f).sheafPushforwardCocontinuousIso (Type (u + 1))
  let hEpsX := phToBigEtale_pushforwardIso B X
  let hEpsY := phToBigEtale_pushforwardIso B Y
  let hCompL := Functor.sheafPushforwardContinuousComp bp eX (Type (u + 1)) JeY JeX JpX
  let hCompR := Functor.sheafPushforwardContinuousComp eY bp (Type (u + 1)) JeY JpY JpX
  let hSite : bp ⋙ eX ≅ eY ⋙ bp := Iso.refl _
  let hSitePush := Functor.sheafPushforwardContinuousIso hSite (Type (u + 1)) JeY JpX
  exact
    Functor.isoWhiskerRight hEpsX (bigEtaleMorphism E X Y f).pushforward ≪≫
    Functor.isoWhiskerLeft eXpush hEtale ≪≫ hCompL ≪≫ hSitePush ≪≫ hCompR.symm ≪≫
    (Functor.isoWhiskerRight hPH eYpush).symm ≪≫
    Functor.isoWhiskerLeft (bigPHMorphism B X Y f).pushforward hEpsY.symm

/-- **Stacks 0DDX, second diagram.** The square formed by the big ph and small étale
base-change morphisms over the comparisons `a_X = π_X ∘ ε_X` and `a_Y = π_Y ∘ ε_Y` commutes on
direct images. -/
@[stacks 0DDX "the big ph–small étale square"]
public def bigPHSmallEtale_pushforwardCommIso
    (B : BigPHSite.{u}) {X Y : B.Schemes} (f : X ⟶ Y) :
    ((phSmallEtaleMorphism B f).comp (phToSmallEtaleMorphism B X)).pushforward ≅
      ((phToSmallEtaleMorphism B Y).comp (bigPHMorphism B X Y f)).pushforward := by
  let εX := phToBigEtaleMorphism B X
  let εY := phToBigEtaleMorphism B Y
  let πX := bigEtaleToSmallEtaleMorphism (phAssociatedBigEtaleSite B) X.1 X.2
  let πY := bigEtaleToSmallEtaleMorphism (phAssociatedBigEtaleSite B) Y.1 Y.2
  let s := phSmallEtaleMorphism B f
  let b := bigPHMorphism B X Y f
  let hSmall := bigSmallEtalePushforwardCommIso (phAssociatedBigEtaleSite B) X Y f
  let hBig := bigPHBigEtale_pushforwardCommIso B f
  change ((εX.pushforward ⋙ πX.pushforward) ⋙ s.pushforward) ≅
    (b.pushforward ⋙ (εY.pushforward ⋙ πY.pushforward))
  exact
    Functor.associator εX.pushforward πX.pushforward s.pushforward ≪≫
    Functor.isoWhiskerLeft εX.pushforward hSmall ≪≫
    (Functor.associator εX.pushforward
      (bigEtaleMorphism (phAssociatedBigEtaleSite B) X Y f).pushforward
      πY.pushforward).symm ≪≫
    Functor.isoWhiskerRight hBig πY.pushforward ≪≫
    Functor.associator b.pushforward εY.pushforward πY.pushforward

end AlgebraicGeometry

end
