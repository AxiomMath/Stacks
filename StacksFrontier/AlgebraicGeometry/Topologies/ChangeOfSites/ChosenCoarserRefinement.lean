module

public import StacksFrontier.AlgebraicGeometry.Topologies.ChangeOfSites.ChosenCoarserSites
public import StacksCore.Tactic.StacksAttribute

/-!
# Refining a covering sieve of a coarser big site by a chosen covering family

Each of the four coarser topologies carried by a big fppf site `B` — Zariski, étale, smooth and
syntomic, **Stacks 03FF** — is generated by a selected collection of covering families, namely the
families chosen by `B` which are coverings for the coarser topology. A covering sieve of the
generated topology is a priori only obtained from those families by the saturation process, and
this file shows that the saturation adds nothing: every covering sieve of each of the four
topologies already *contains* one of the selected families.

`AlgebraicGeometry.exists_covering_le_of_mem_topology` is the fppf case and
`AlgebraicGeometry.exists_etaleCovering_le_of_mem_etaleTopology` the étale case at
`AlgebraicGeometry.etaleTopology`; the general statement proved here covers all four coarser
topologies at the `AlgebraicGeometry.BigFppfSite` spellings of their covering collections, which
are the spellings `AlgebraicGeometry.BigFppfSite.baseTopology` is assembled from.

## Main results

* `AlgebraicGeometry.BigFppfSite.exists_chosenCovering_le_of_mem_chosenTopology`: the statement
  for an arbitrary precoverage of schemes below the fppf one, with isomorphisms and stable under
  composition, base change and the formation of fibre products.
* `AlgebraicGeometry.BigFppfSite.exists_zariskiCovering_le_of_mem_zariskiTopology`,
  `AlgebraicGeometry.BigFppfSite.exists_etaleCovering_le_of_mem_etaleTopology`,
  `AlgebraicGeometry.BigFppfSite.exists_smoothCovering_le_of_mem_smoothTopology` and
  `AlgebraicGeometry.BigFppfSite.exists_syntomicCovering_le_of_mem_syntomicTopology`: the four
  instances.

## References

* [Stacks Project, Tag 03FF](https://stacks.math.columbia.edu/tag/03FF)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.BigFppfSite

variable (B : BigFppfSite.{u})

/-- **A covering sieve of a topology generated by a selected collection of covering families
contains one of those families.** The collection is cut out of the families chosen by `B` by
membership of the image family in a precoverage `Q` of all schemes which is below the fppf
precoverage, has isomorphisms, and is stable under composition, base change and fibre products. -/
theorem exists_chosenCovering_le_of_mem_chosenTopology (Q : Precoverage Scheme.{u})
    [Precoverage.HasIsos Q] [Q.IsStableUnderComposition] [Q.IsStableUnderBaseChange]
    [Q.HasPullbacks] (hQ : Q ≤ Scheme.fppfPrecoverage) (P : Covering B.Schemes → Prop)
    (hP : ∀ E : Covering B.Schemes,
      P E ↔ (E.2.map B.inclusion).presieve₀ ∈ Q (B.inclusion.obj E.1))
    {X : B.Schemes} {R : Sieve X}
    (hR : R ∈ (B.chosenPrecoverage fun E => B.IsCovering E ∧ P E).toGrothendieck X) :
    ∃ E : PreZeroHypercover.{u + 1} X,
      (B.IsCovering ⟨X, E⟩ ∧ P ⟨X, E⟩) ∧ E.presieve₀ ≤ R.arrows := by
  have heq : (B.chosenPrecoverage fun E => B.IsCovering E ∧ P E) = Q.comap B.inclusion :=
    chosenPrecoverage_eq_comap B Q (fun E => B.IsCovering E ∧ P E)
      (fun E hE => (hP E).mp hE.2) (fun E hE => by
        obtain ⟨E', hB, hQ', hCE⟩ := covering_has_representative B Q hQ E hE
        exact ⟨E', ⟨hB, (hP E').mpr hQ'⟩, hCE⟩)
  have : PreservesLimitsOfShape WalkingCospan B.inclusion := inferInstance
  have : (B.chosenPrecoverage fun E => B.IsCovering E ∧ P E).HasIsos := by
    rw [heq]; infer_instance
  have : (B.chosenPrecoverage fun E => B.IsCovering E ∧ P E).IsStableUnderComposition := by
    rw [heq]; infer_instance
  have : (B.chosenPrecoverage fun E => B.IsCovering E ∧ P E).IsStableUnderBaseChange := by
    rw [heq]; infer_instance
  have : (B.chosenPrecoverage fun E => B.IsCovering E ∧ P E).HasPullbacks := by
    rw [heq]; infer_instance
  obtain ⟨R', ⟨E, rfl, hE⟩, hle⟩ :=
    Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition.mp hR
  exact ⟨E, hE, hle⟩

/-- The chosen-covering refinement for the precoverage of jointly surjective families of
`W`-morphisms, for a morphism property `W` stable under composition and base change. -/
private theorem exists_chosenCovering_le_of_mem_chosenTopology_precoverage
    (W : MorphismProperty Scheme.{u}) [W.IsStableUnderComposition] [W.IsStableUnderBaseChange]
    (hW : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f], W f)
    (hQ : Scheme.precoverage W ≤ Scheme.fppfPrecoverage) (P : Covering B.Schemes → Prop)
    (hP : ∀ E : Covering B.Schemes,
      P E ↔ (E.2.map B.inclusion).presieve₀ ∈ Scheme.precoverage W (B.inclusion.obj E.1))
    {X : B.Schemes} {R : Sieve X}
    (hR : R ∈ (B.chosenPrecoverage fun E => B.IsCovering E ∧ P E).toGrothendieck X) :
    ∃ E : PreZeroHypercover.{u + 1} X,
      (B.IsCovering ⟨X, E⟩ ∧ P ⟨X, E⟩) ∧ E.presieve₀ ≤ R.arrows :=
  have := schemePrecoverage_hasIsos W hW
  have := schemePrecoverage_stableUnderComposition W
  have := schemePrecoverage_stableUnderBaseChange W
  B.exists_chosenCovering_le_of_mem_chosenTopology _ hQ P hP hR

/-- **Stacks 03FF.** A covering sieve of the big Zariski topology carried by a big fppf site
contains a chosen Zariski covering family. -/
theorem exists_zariskiCovering_le_of_mem_zariskiTopology {X : B.Schemes} {R : Sieve X}
    (hR : R ∈ B.zariskiTopology X) :
    ∃ E : PreZeroHypercover.{u + 1} X, B.zariskiCovering ⟨X, E⟩ ∧ E.presieve₀ ≤ R.arrows :=
  B.exists_chosenCovering_le_of_mem_chosenTopology Scheme.zariskiPrecoverage
    Scheme.zariskiPrecoverage_le_fppfPrecoverage _ isZariskiCovering_iff_mem_precoverage hR

/-- **Stacks 03FF.** A covering sieve of the big étale topology carried by a big fppf site
contains a chosen étale covering family. -/
theorem exists_etaleCovering_le_of_mem_etaleTopology {X : B.Schemes} {R : Sieve X}
    (hR : R ∈ B.etaleTopology X) :
    ∃ E : PreZeroHypercover.{u + 1} X, B.etaleCovering ⟨X, E⟩ ∧ E.presieve₀ ≤ R.arrows := by
  have : MorphismProperty.IsStableUnderComposition
      (@Etale : MorphismProperty Scheme.{u}) :=
    (inferInstance : MorphismProperty.IsMultiplicative
      (@Etale : MorphismProperty Scheme.{u})).toIsStableUnderComposition
  exact B.exists_chosenCovering_le_of_mem_chosenTopology_precoverage (@Etale)
    (fun _ _ => inferInstance) Scheme.etalePrecoverage_le_fppfPrecoverage _ (fun _ => Iff.rfl) hR

/-- **Stacks 03FF.** A covering sieve of the big smooth topology carried by a big fppf site
contains a chosen smooth covering family. -/
theorem exists_smoothCovering_le_of_mem_smoothTopology {X : B.Schemes} {R : Sieve X}
    (hR : R ∈ B.smoothTopology X) :
    ∃ E : PreZeroHypercover.{u + 1} X, B.smoothCovering ⟨X, E⟩ ∧ E.presieve₀ ≤ R.arrows :=
  B.exists_chosenCovering_le_of_mem_chosenTopology_precoverage (@Smooth) (fun _ _ => inferInstance)
    Scheme.smoothPrecoverage_le_fppfPrecoverage _ (smoothCovering_iff_mem_precoverage B.cutoff) hR

/-- **Stacks 03FF.** A covering sieve of the big syntomic topology carried by a big fppf site
contains a chosen syntomic covering family. -/
theorem exists_syntomicCovering_le_of_mem_syntomicTopology {X : B.Schemes} {R : Sieve X}
    (hR : R ∈ B.syntomicTopology X) :
    ∃ E : PreZeroHypercover.{u + 1} X, B.syntomicCovering ⟨X, E⟩ ∧ E.presieve₀ ≤ R.arrows :=
  B.exists_chosenCovering_le_of_mem_chosenTopology_precoverage (@Syntomic)
    (fun f _ => syntomic_of_isOpenImmersion f) Scheme.syntomicPrecoverage_le_fppfPrecoverage _
    (syntomicCovering_iff_mem_precoverage B.cutoff) hR

end AlgebraicGeometry.BigFppfSite

end
