module

public import Mathlib.CategoryTheory.Functor.Flat
public import Mathlib.CategoryTheory.Limits.Constructions.Over.Connected
public import Mathlib.CategoryTheory.Sites.CoverPreserving
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.LocallyFiniteTypeSiteEtaleCovers
public import StacksFrontier.CategoryTheory.Sites.Cohomology.DerivedSections.ConstantSheafDerivedSectionsAdjunction

/-!
# The small étale site of an object of the locally-finite-type étale site

Let `S` be a scheme, `C` the category of schemes locally of finite type over `S` with its étale
topology, and `Y` an object of `C` with underlying scheme `W`. A scheme étale over `W` is locally
of finite type over `S`, so it is an object of the slice `C/Y`; this defines a functor

`ι : W_ét ⥤ C/Y`

from the small étale site of `W`. It is the functor of the comparison of the big and the small
étale site (Stacks 0757, 0758) for the subcategory `C` of the big étale site: it is continuous and
cocontinuous, it preserves fibre products and equalizers, and it carries the terminal object `W`
of `W_ét` to a terminal object of `C/Y`.

## Main definitions

* `AlgebraicGeometry.Scheme.LocallyFiniteTypeEtale.smallEtaleFunctor`: the functor `ι`.

## Main results

* `AlgebraicGeometry.Scheme.LocallyFiniteTypeEtale.smallEtaleFunctor_isContinuous`
* `AlgebraicGeometry.Scheme.LocallyFiniteTypeEtale.smallEtaleFunctor_isCocontinuous`
* `AlgebraicGeometry.Scheme.LocallyFiniteTypeEtale.isTerminalSmallEtaleFunctorObj`

## References

* [Stacks Project, Tag 0757](https://stacks.math.columbia.edu/tag/0757)
* [Stacks Project, Tag 0758](https://stacks.math.columbia.edu/tag/0758)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Scheme

/-- The structure morphisms of the small étale site commute with its morphisms. -/
lemma Etale.hom_w {W : Scheme.{u}} {T T' : W.Etale} (h : T ⟶ T') : h.left ≫ T'.hom = T.hom :=
  Over.w ((Scheme.Etale.forget _).map h)

/-- A morphism of the small étale site is étale. -/
lemma Etale.etale_left {W : Scheme.{u}} {T T' : W.Etale} (h : T ⟶ T') :
    AlgebraicGeometry.Etale h.left := by
  have h1 : AlgebraicGeometry.Etale T.hom := T.prop
  have h2 : AlgebraicGeometry.Etale T'.hom := T'.prop
  have : AlgebraicGeometry.Etale (h.left ≫ T'.hom) := by rw [Etale.hom_w]; exact h1
  exact AlgebraicGeometry.Etale.of_comp h.left T'.hom

/-- A sieve of the small étale site is the sieve generated by all of its arrows. -/
lemma Etale.sieve_eq_ofArrows {W : Scheme.{u}} {T : W.Etale} (R : Sieve T) :
    R = Sieve.ofArrows (fun p : Σ Z : W.Etale, {h : Z ⟶ T // R.arrows h} ↦ p.1)
      (fun p ↦ p.2.1) := by
  ext Z h
  constructor
  · intro hh
    exact ⟨Z, 𝟙 Z, h, Presieve.ofArrows.mk
      (⟨Z, ⟨h, hh⟩⟩ : Σ Z' : W.Etale, {h' : Z' ⟶ T // R.arrows h'}), Category.id_comp h⟩
  · rintro ⟨_, a, _, ⟨p⟩, rfl⟩
    exact R.downward_closed p.2.2 a

/-- A covering sieve of the small étale site contains, for every point, an arrow whose image
contains that point. -/
lemma exists_mem_range_of_mem_smallEtaleTopology {W : Scheme.{u}} {T : W.Etale} {R : Sieve T}
    (hR : R ∈ W.smallEtaleTopology T) (t : T.left) :
    ∃ (Z : W.Etale) (h : Z ⟶ T), R.arrows h ∧ t ∈ Set.range h.left.base := by
  rw [Etale.sieve_eq_ofArrows R, ofArrows_mem_smallEtaleTopology_iff] at hR
  obtain ⟨p, hp⟩ := Set.mem_iUnion.1 (hR ▸ Set.mem_univ t)
  exact ⟨p.1, p.2.1, p.2.2, hp⟩

/-- A sieve of the small étale site containing, for every point, an arrow whose image contains
that point is a covering sieve. -/
lemma mem_smallEtaleTopology_of_forall_exists {W : Scheme.{u}} {T : W.Etale} {R : Sieve T}
    (hR : ∀ t : T.left, ∃ (Z : W.Etale) (h : Z ⟶ T), R.arrows h ∧ t ∈ Set.range h.left.base) :
    R ∈ W.smallEtaleTopology T := by
  choose Z h hRh ht using hR
  refine (W.smallEtaleTopology).superset_covering ?_
    ((ofArrows_mem_smallEtaleTopology_iff h).2 (Set.eq_univ_of_forall fun t ↦
      Set.mem_iUnion.2 ⟨t, ht t⟩))
  rintro _ _ ⟨_, a, _, ⟨t⟩, rfl⟩
  exact R.downward_closed (hRh t) a

namespace LocallyFiniteTypeEtale

variable {S : Scheme.{u}} (Y : LocallyFiniteTypeEtale S)

/-- A scheme étale over the scheme underlying `Y`, as an object of the site. -/
def etaleObj (T : Y.obj.left.Etale) : LocallyFiniteTypeEtale S :=
  ⟨Over.mk (T.hom ≫ Y.obj.hom), by
    change LocallyOfFiniteType (T.hom ≫ Y.obj.hom)
    have : LocallyOfFiniteType Y.obj.hom := Y.property
    infer_instance⟩

/-- The structure morphism of `etaleObj Y T` to `Y`. -/
def etaleHom (T : Y.obj.left.Etale) : etaleObj Y T ⟶ Y :=
  ObjectProperty.homMk (Over.homMk T.hom rfl)

/-- A morphism of schemes étale over the scheme underlying `Y` commutes with the structure
morphisms. -/
lemma etale_w {T T' : Y.obj.left.Etale} (h : T ⟶ T') : h.left ≫ T'.hom = T.hom :=
  Etale.hom_w h

/-- A morphism of schemes étale over the scheme underlying `Y`, as a morphism of the site. -/
def etaleMap {T T' : Y.obj.left.Etale} (h : T ⟶ T') : etaleObj Y T ⟶ etaleObj Y T' :=
  ObjectProperty.homMk (Over.homMk h.left (by
    change h.left ≫ T'.hom ≫ Y.obj.hom = T.hom ≫ Y.obj.hom
    rw [reassoc_of% (etale_w Y h)]))

/-- The underlying morphism of schemes of `etaleHom Y T` is the structure morphism of `T`. -/
@[simp]
lemma forget_map_etaleHom (T : Y.obj.left.Etale) : (forget S).map (etaleHom Y T) = T.hom := rfl

/-- The underlying morphism of schemes of `etaleMap Y h` is that of `h`. -/
@[simp]
lemma forget_map_etaleMap {T T' : Y.obj.left.Etale} (h : T ⟶ T') :
    (forget S).map (etaleMap Y h) = h.left := rfl

/-- **The small étale site of `Y` inside the slice `C/Y`.** -/
def smallEtaleFunctor : Y.obj.left.Etale ⥤ Over Y where
  obj T := Over.mk (etaleHom Y T)
  map {T T'} h := Over.homMk (etaleMap Y h) (by
    apply (forget S).map_injective
    simp only [Functor.map_comp, forget_map_etaleMap, forget_map_etaleHom, Over.mk_hom]
    exact etale_w Y h)
  map_id T := by
    ext
    rfl
  map_comp f g := by
    ext
    rfl

/-- The underlying morphism of schemes of the image of `h` under `smallEtaleFunctor Y` is that of
`h`. -/
@[simp]
lemma forget_map_smallEtaleFunctor_map_left {T T' : Y.obj.left.Etale} (h : T ⟶ T') :
    (forget S).map ((smallEtaleFunctor Y).map h).left = h.left := rfl

/-- The underlying scheme of an object of the slice `C/Y`. -/
abbrev sliceForget : Over Y ⥤ Scheme.{u} := Over.forget Y ⋙ forget S

/-- Following the small étale site into the slice by the underlying scheme is forgetting the
structure morphism. -/
def smallEtaleFunctorCompSliceForgetIso :
    smallEtaleFunctor Y ⋙ sliceForget Y ≅ Scheme.Etale.forget _ ⋙ Over.forget _ :=
  NatIso.ofComponents (fun _ ↦ Iso.refl _) (fun _ ↦ by
    simp only [Iso.refl_hom]
    rfl)

/-- The functor `smallEtaleFunctor Y` preserves fibre products. -/
instance : PreservesLimitsOfShape WalkingCospan (smallEtaleFunctor Y) := by
  have : PreservesLimitsOfShape WalkingCospan (smallEtaleFunctor Y ⋙ sliceForget Y) :=
    preservesLimitsOfShape_of_natIso (smallEtaleFunctorCompSliceForgetIso Y).symm
  exact preservesLimitsOfShape_of_reflects_of_preserves _ (sliceForget Y)

/-- The functor `smallEtaleFunctor Y` preserves equalizers. -/
instance : PreservesLimitsOfShape WalkingParallelPair (smallEtaleFunctor Y) := by
  have : PreservesLimitsOfShape WalkingParallelPair (smallEtaleFunctor Y ⋙ sliceForget Y) :=
    preservesLimitsOfShape_of_natIso (smallEtaleFunctorCompSliceForgetIso Y).symm
  exact preservesLimitsOfShape_of_reflects_of_preserves _ (sliceForget Y)

/-- The terminal object of the small étale site, `𝟙 W`. -/
abbrev smallEtaleTerminal : Y.obj.left.Etale :=
  Stacks.Cohomology.SiteConstantSheaf.smallEtaleTerminalObj Y.obj.left

/-- The inverse of the structure morphism of `etaleObj Y (𝟙 W)`. -/
def etaleTerminalInv : Y ⟶ etaleObj Y (smallEtaleTerminal Y) :=
  ObjectProperty.homMk (Over.homMk (𝟙 _) (by
    change 𝟙 _ ≫ 𝟙 _ ≫ Y.obj.hom = Y.obj.hom
    simp))

/-- `etaleTerminalInv Y` is a section of the structure morphism of `etaleObj Y (𝟙 W)`. -/
@[reassoc (attr := simp)]
lemma etaleTerminalInv_etaleHom : etaleTerminalInv Y ≫ etaleHom Y (smallEtaleTerminal Y) = 𝟙 Y := by
  apply (forget S).map_injective
  show 𝟙 _ ≫ 𝟙 _ = 𝟙 _
  simp

/-- `etaleTerminalInv Y` is a retraction of the structure morphism of `etaleObj Y (𝟙 W)`. -/
@[reassoc (attr := simp)]
lemma etaleHom_etaleTerminalInv :
    etaleHom Y (smallEtaleTerminal Y) ≫ etaleTerminalInv Y = 𝟙 _ := by
  apply (forget S).map_injective
  show 𝟙 _ ≫ 𝟙 _ = 𝟙 _
  simp

/-- **The small étale site of `Y` has its terminal object sent to a terminal object of `C/Y`.** -/
def isTerminalSmallEtaleFunctorObj :
    IsTerminal ((smallEtaleFunctor Y).obj (smallEtaleTerminal Y)) :=
  Over.mkIdTerminal.ofIso
    (Over.isoMk
      { hom := etaleTerminalInv Y
        inv := etaleHom Y (smallEtaleTerminal Y)
        hom_inv_id := etaleTerminalInv_etaleHom Y
        inv_hom_id := etaleHom_etaleTerminalInv Y }
      (etaleTerminalInv_etaleHom Y))

/-- **The functor from the small étale site is cover preserving.** -/
lemma smallEtaleFunctor_coverPreserving :
    CoverPreserving Y.obj.left.smallEtaleTopology ((topology S).over Y) (smallEtaleFunctor Y) where
  cover_preserve {T} R hR := by
    rw [GrothendieckTopology.mem_over_iff]
    apply mem_topology_of_hasEtalePointCover
    intro x
    obtain ⟨Z, h, hRh, hx⟩ := exists_mem_range_of_mem_smallEtaleTopology hR x
    refine ⟨_, ((smallEtaleFunctor Y).map h).left, ?_, hx, ?_⟩
    · rw [forget_map_smallEtaleFunctor_map_left]
      exact Etale.etale_left h
    · exact ⟨_, (smallEtaleFunctor Y).map h, 𝟙 _, ⟨Z, h, 𝟙 _, hRh, by simp⟩, by simp⟩

/-- The functor `smallEtaleFunctor Y` is continuous for the étale topologies. -/
instance smallEtaleFunctor_isContinuous :
    (smallEtaleFunctor Y).IsContinuous Y.obj.left.smallEtaleTopology ((topology S).over Y) := by
  have : PreservesLimit (Functor.empty.{0} Y.obj.left.Etale) (smallEtaleFunctor Y) :=
    preservesLimit_of_preserves_limit_cone
      (Stacks.Cohomology.SiteConstantSheaf.smallEtaleTerminalObjIsTerminal _)
      ((isLimitMapConeEmptyConeEquiv _ _).symm (isTerminalSmallEtaleFunctorObj Y))
  have : PreservesLimitsOfShape (Discrete.{0} PEmpty) (smallEtaleFunctor Y) :=
    preservesLimitsOfShape_pempty_of_preservesTerminal _
  have : HasTerminal Y.obj.left.Etale :=
    (Stacks.Cohomology.SiteConstantSheaf.smallEtaleTerminalObjIsTerminal _).hasTerminal
  have : PreservesFiniteLimits (smallEtaleFunctor Y) :=
    preservesFiniteLimits_of_preservesTerminal_and_pullbacks _
  have : RepresentablyFlat (smallEtaleFunctor Y) := flat_of_preservesFiniteLimits _
  exact Functor.isContinuous_of_coverPreserving
    (compatiblePreservingOfFlat _ _) (smallEtaleFunctor_coverPreserving Y)

/-- The functor `smallEtaleFunctor Y` is cocontinuous for the étale topologies. -/
instance smallEtaleFunctor_isCocontinuous :
    (smallEtaleFunctor Y).IsCocontinuous Y.obj.left.smallEtaleTopology ((topology S).over Y) where
  cover_lift {T} R hR := by
    rw [GrothendieckTopology.mem_over_iff] at hR
    apply mem_smallEtaleTopology_of_forall_exists
    intro t
    obtain ⟨Z, f, het, ⟨z, hz⟩, hf⟩ := hasEtalePointCover_of_mem_topology hR t
    rw [Sieve.overEquiv_iff] at hf
    let fs : Z.obj.left ⟶ T.left := (forget S).map f
    have : AlgebraicGeometry.Etale fs := het
    let Z' : Y.obj.left.Etale := Scheme.Etale.mk (fs ≫ T.hom)
    let h : Z' ⟶ T := MorphismProperty.Over.homMk fs rfl
    refine ⟨Z', h, ?_, ⟨z, hz⟩⟩
    let c₀ : etaleObj Y Z' ⟶ Z := ObjectProperty.homMk (Over.homMk (𝟙 _) (by
      change 𝟙 _ ≫ Z.obj.hom = (fs ≫ T.hom) ≫ Y.obj.hom
      rw [Category.id_comp, ← Over.w f.hom, Category.assoc]
      rfl))
    let c : (smallEtaleFunctor Y).obj Z' ⟶
        Over.mk (f ≫ ((smallEtaleFunctor Y).obj T).hom) :=
      Over.homMk c₀ (by
        apply (forget S).map_injective
        change 𝟙 _ ≫ fs ≫ T.hom = fs ≫ T.hom
        simp)
    have : (smallEtaleFunctor Y).map h = c ≫ Over.homMk f := by
      ext1
      apply (forget S).map_injective
      change fs = 𝟙 _ ≫ fs
      simp
    change R.arrows ((smallEtaleFunctor Y).map h)
    rw [this]
    exact R.downward_closed hf c

end LocallyFiniteTypeEtale

end AlgebraicGeometry.Scheme

end
