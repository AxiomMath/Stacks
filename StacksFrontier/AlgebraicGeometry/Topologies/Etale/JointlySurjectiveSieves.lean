module

public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.BoundedCovering
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.Precoverage

/-!
# Jointly surjective families cover in the small étale topology

A sieve on an object `V` of the small étale site of a scheme `S` is a covering sieve as soon as
its members are jointly surjective on points: for every point of `V` some morphism in the sieve
hits it. Only surjectivity has to be checked, because every object of the small étale site is
already étale over `S`, hence every morphism of the site is étale.

The point of the criterion is that it says nothing about indexing. The covering families
presenting the étale topology are indexed by a type of bounded cardinality and are compared up
to combinatorial equivalence; a sieve, by contrast, is a sieve. Given joint surjectivity the
family indexed by the points of `V` itself is an étale covering, and the big site's
representability axiom replaces it by a bounded one refining the given sieve.

## Main results

* `AlgebraicGeometry.SmallEtale.generate_ofArrows_mem_topology_of_jointlySurjective` — the
  sieve generated by a jointly surjective family of morphisms is a covering sieve.
* `AlgebraicGeometry.SmallEtale.exists_mem_arrows_mem_range` — the converse: every covering
  sieve of the small étale site is jointly surjective on points.

That a jointly surjective *sieve* is a covering sieve is
`AlgebraicGeometry.SmallEtale.mem_topology_of_jointlySurjective`, proved in
`StacksFrontier.AlgebraicGeometry.Topologies.Etale.BoundedCovering` and re-exported here.

## References

* [Stacks Project, Tag 021B](https://stacks.math.columbia.edu/tag/021B)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.SmallEtale

variable (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The sieve generated by a family of morphisms into `V` which is jointly surjective on points
is a covering sieve of the small étale site. -/
public theorem generate_ofArrows_mem_topology_of_jointlySurjective
    {V : SmallEtale B S hS} {ι : Type*}
    (W : ι → SmallEtale B S hS) (g : ∀ i, W i ⟶ V)
    (h : ∀ x : V.obj.left.1, ∃ i, x ∈ Set.range (B.inclusion.map (g i).hom.left)) :
    Sieve.generate (Presieve.ofArrows W g) ∈ SmallEtale.topology B S hS V :=
  mem_topology_of_jointlySurjective fun x ↦
    (h x).elim fun i hi ↦ ⟨W i, g i, Sieve.le_generate _ _ _ (Presieve.ofArrows.mk i), hi⟩

/-- **Every covering sieve of the small étale site of `S` is jointly surjective on points:**
some member of the sieve has the given point of its target in its image.

This is the converse of `mem_topology_of_jointlySurjective`.  The small étale precoverage is
stable under base change and under composition, so a covering sieve is refined by the sieve
generated by a single covering family, and a covering family of the small étale site is an
étale covering family of the ambient category of schemes, which builds in surjectivity. -/
public theorem exists_mem_arrows_mem_range
    {V : SmallEtale B S hS} {R : Sieve V} (hR : R ∈ SmallEtale.topology B S hS V)
    (x : (SmallEtale.toScheme B S hS).obj V) :
    ∃ (W : SmallEtale B S hS) (g : W ⟶ V), R g ∧
      x ∈ Set.range ((SmallEtale.toScheme B S hS).map g) := by
  obtain ⟨Rp, hRp, hle⟩ :=
    Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition.mp hR
  obtain ⟨E, rfl, hE⟩ := (SmallEtale.mem_precoverage_iff B S hS).mp hRp
  have hcov : (E.map (SmallEtale.toScheme B S hS)).presieve₀ ∈
      Scheme.etalePrecoverage ((SmallEtale.toScheme B S hS).obj V) := hE.1
  obtain ⟨i, hi⟩ :=
    ((Scheme.ofArrows_mem_precoverage_iff (P := @Etale)).mp hcov).1 x
  exact ⟨E.X i, E.f i, hle _ _ (Presieve.ofArrows.mk i), hi⟩

end AlgebraicGeometry.SmallEtale

end
