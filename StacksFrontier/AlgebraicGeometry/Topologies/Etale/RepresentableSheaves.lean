module

public import StacksFrontier.AlgebraicGeometry.Topologies.Fpqc.FinerTopologies
public import StacksFrontier.AlgebraicGeometry.Topologies.FpqcSmallEtaleSheaf
public import Mathlib.CategoryTheory.Sites.Subcanonical
public import Mathlib.CategoryTheory.Sites.SubcanonicalOver

/-!
# Representable presheaves are sheaves on the étale sites of a scheme

The étale topology is coarser than the fpqc topology, which is subcanonical, so the étale
topology on all schemes is subcanonical, and so are the topologies it induces on the schemes
over a scheme `S` and on the small étale site of `S`.  Consequently a representable presheaf on
either étale site of `S` is a sheaf, and a representable presheaf on the schemes over `S`
restricts to a sheaf on the small étale site.

## Main results

* `Stacks.Sites.le_toGrothendieck_toPrecoverage`: a topology is contained in the topology
  generated by its own covering families.
* `AlgebraicGeometry.Scheme.etaleTopology_subcanonical`: the étale topology on all schemes is
  subcanonical.
* `AlgebraicGeometry.Scheme.isContinuous_etaleForget`: the forgetful functor from the small
  étale site of `S` to the schemes over `S` is continuous for the étale topologies.
* `AlgebraicGeometry.Scheme.smallEtaleTopology_subcanonical`: the small étale topology of a
  scheme is subcanonical.
* `AlgebraicGeometry.isSheaf_smallEtale_of_isRepresentable` and
  `AlgebraicGeometry.isSheaf_bigEtale_of_isRepresentable`: a representable presheaf on the small
  or the big étale site of `S` is a sheaf.
* `AlgebraicGeometry.isSheaf_smallEtale_of_isRepresentable_restrict`: a representable presheaf on
  the schemes over `S` restricts to a sheaf on the small étale site of `S`.

## Implementation notes

The small étale topology of `S` is by definition the topology restricted along
`AlgebraicGeometry.Scheme.Etale.forget` from the étale topology on the schemes over `S`, and a
restricted topology is by definition the one generated by the comapped covering families.  So
the continuity of that forgetful functor is one application of
`Stacks.Sites.isContinuous_toGrothendieck_of_precoverage_le` at the comapped precoverage itself,
with no covering-family computation; what it needs is that the functor creates pairwise
pullbacks, which holds because it is fully faithful and preserves them.

Subcanonicality then transports along a fully faithful continuous functor, and the two
representability statements are `CategoryTheory.GrothendieckTopology.Subcanonical`'s own
consequence read through `CategoryTheory.isSheaf_iff_isSheaf_of_type`.

## References

* [Stacks Project, Tag 03O4](https://stacks.math.columbia.edu/tag/03O4)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u v

namespace Stacks.Sites

/-- A Grothendieck topology is contained in the topology generated by its own covering
families. -/
public theorem le_toGrothendieck_toPrecoverage {C : Type*} [Category C]
    (J : GrothendieckTopology C) : J ≤ J.toPrecoverage.toGrothendieck := by
  intro X R hR
  rw [← Sieve.generate_sieve R]
  exact Precoverage.generate_mem_toGrothendieck
    ((GrothendieckTopology.arrows_mem_toPrecoverage_iff J R).2 hR)

end Stacks.Sites

namespace AlgebraicGeometry

namespace Scheme

/-- The forgetful functor from the small étale site of `S` to the schemes over `S` creates
pairwise pullbacks: it is fully faithful, and the schemes over `S` have pullbacks. -/
public noncomputable instance createsLimitsOfShape_etaleForget (S : Scheme.{u}) :
    CreatesLimitsOfShape WalkingCospan (Scheme.Etale.forget S) :=
  ⟨fun {_} => createsLimitOfFullyFaithfulOfPreserves⟩

/-- The forgetful functor from the small étale site of `S` to the schemes over `S` is continuous
for the étale topologies.  The small étale topology is by definition the topology generated by
the covering families comapped along this functor, so this is the criterion applied at the
comapped precoverage itself. -/
public instance isContinuous_etaleForget (S : Scheme.{u}) :
    (Scheme.Etale.forget S).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.etaleTopology.{u}.over S) :=
  Stacks.Sites.isContinuous_toGrothendieck_of_precoverage_le
    ((Scheme.etaleTopology.{u}.over S).toPrecoverage.comap (Scheme.Etale.forget S))
    (Scheme.etaleTopology.{u}.over S) (Scheme.Etale.forget S) le_rfl

/-- The étale topology on all schemes is subcanonical, because it is coarser than the fpqc
topology, which is subcanonical. -/
public instance etaleTopology_subcanonical : Scheme.etaleTopology.{u}.Subcanonical :=
  GrothendieckTopology.Subcanonical.of_le Stacks.Sites.etaleTopology_le_fpqcTopology

/-- The small étale topology of a scheme is subcanonical, transported along the fully faithful
continuous forgetful functor to the schemes over that scheme. -/
public instance smallEtaleTopology_subcanonical (S : Scheme.{u}) :
    (Scheme.smallEtaleTopology S).Subcanonical :=
  GrothendieckTopology.subcanonical_of_full_of_faithful (Scheme.Etale.forget S)
    (Scheme.smallEtaleTopology S) (Scheme.etaleTopology.{u}.over S)

end Scheme

/-- **Stacks 03O4.** A representable presheaf on the small étale site of a scheme is a
sheaf. -/
@[stacks 03O4 "representables on the small étale site"]
public theorem isSheaf_smallEtale_of_isRepresentable (S : Scheme.{u})
    (F : (S.Etale)ᵒᵖ ⥤ Type v) [F.IsRepresentable] :
    Presheaf.IsSheaf (Scheme.smallEtaleTopology S) F :=
  (isSheaf_iff_isSheaf_of_type _ _).mpr
    (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable
      (J := Scheme.smallEtaleTopology S) F)

/-- **Stacks 03O4.** A representable presheaf on the big étale site over a scheme is a
sheaf. -/
@[stacks 03O4 "representables on the big étale site"]
public theorem isSheaf_bigEtale_of_isRepresentable (S : Scheme.{u})
    (F : (Over S)ᵒᵖ ⥤ Type v) [F.IsRepresentable] :
    Presheaf.IsSheaf (Scheme.etaleTopology.over S) F :=
  (isSheaf_iff_isSheaf_of_type _ _).mpr
    (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable
      (J := Scheme.etaleTopology.over S) F)

/-- **Stacks 03O4.** A representable presheaf on the schemes over `S` restricts to a sheaf on
the small étale site of `S`. -/
@[stacks 03O4 "big representables on the small étale site"]
public theorem isSheaf_smallEtale_of_isRepresentable_restrict (S : Scheme.{u})
    (F : (Over S)ᵒᵖ ⥤ Type v) [F.IsRepresentable] :
    Presheaf.IsSheaf (Scheme.smallEtaleTopology S) ((Scheme.Etale.forget S).op ⋙ F) :=
  Functor.op_comp_isSheaf_of_isSheaf _ _ _ _ (isSheaf_bigEtale_of_isRepresentable S F)

end AlgebraicGeometry

end
