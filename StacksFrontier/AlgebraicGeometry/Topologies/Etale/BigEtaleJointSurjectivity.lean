module

public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.BoundedCovering
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.Precoverage

/-!
# Covering sieves of a big étale site are exactly the jointly surjective étale sieves

Let `B` be a big étale site. Its topology is generated by the *selected* étale covering
families — those whose index type obeys the covering bound `B.coveringBound`. This file shows
that at the level of covering *sieves* the selection is no restriction and the topology is
characterised geometrically:

* every covering sieve is jointly surjective on points
  (`AlgebraicGeometry.BigEtaleSite.exists_mem_arrows_mem_range`), and
* conversely a sieve whose arrows are étale and jointly surjective on points is a covering
  sieve (`AlgebraicGeometry.BigEtaleSite.mem_topology_of_jointlySurjective`).

Both statements are also proved for the big étale site over a scheme `S`.

## Main results

* `AlgebraicGeometry.BigEtaleSite.exists_mem_range_of_mem_precoverage` — a selected covering
  family is jointly surjective on points.
* `AlgebraicGeometry.BigEtaleSite.exists_mem_arrows_mem_range` and
  `AlgebraicGeometry.BigEtaleOver.exists_mem_arrows_mem_range` — every covering sieve of the
  big étale site, resp. of the big étale site over `S`, is jointly surjective on points.
* `AlgebraicGeometry.BigEtaleSite.exists_isCovering_le` — a jointly surjective family of étale
  morphisms of `B` is refined by a selected covering family.
* `AlgebraicGeometry.BigEtaleSite.mem_topology_of_jointlySurjective` and
  `AlgebraicGeometry.BigEtaleOver.generate_ofArrows_mem_topology` — a jointly surjective sieve
  of étale morphisms, resp. the sieve generated by a jointly surjective family of étale
  morphisms over `S`, is a covering sieve.

## References

* [Stacks Project, Tag 021A](https://stacks.math.columbia.edu/tag/021A)
* [Stacks Project, Tag 021B](https://stacks.math.columbia.edu/tag/021B)
* [Stacks Project, Tag 09XN](https://stacks.math.columbia.edu/tag/09XN)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-- Étaleness of morphisms of schemes, as a morphism property. -/
private abbrev etaleMorphisms : MorphismProperty Scheme.{u} := @Etale

/-! ### Covering sieves of a big étale site are jointly surjective -/

/-- A selected covering family of a big étale site is jointly surjective on points. -/
public theorem BigEtaleSite.exists_mem_range_of_mem_precoverage (B : BigEtaleSite.{u})
    {X : B.Scheme} {R : Presieve X} (hR : R ∈ B.precoverage X) (x : B.inclusion.obj X) :
    ∃ (Y : B.Scheme) (f : Y ⟶ X), R f ∧ x ∈ Set.range (B.inclusion.map f) := by
  obtain ⟨E, rfl, hE⟩ := hR
  obtain ⟨i, hi⟩ := ((Scheme.ofArrows_mem_precoverage_iff
    (P := etaleMorphisms.{u})).mp hE.etale).1 x
  exact ⟨E.X i, E.f i, ⟨i⟩, hi⟩

/-- **Every covering sieve of a big étale site is jointly surjective on points.** Each point of
the target is in the image of one of the members of the sieve. -/
public theorem BigEtaleSite.exists_mem_arrows_mem_range (B : BigEtaleSite.{u}) {X : B.Scheme}
    {R : Sieve X} (hR : R ∈ B.topology X) :
    ∀ x : B.inclusion.obj X,
      ∃ (Y : B.Scheme) (f : Y ⟶ X), R.arrows f ∧ x ∈ Set.range (B.inclusion.map f) := by
  rw [Precoverage.mem_toGrothendieck_iff] at hR
  induction hR with
  | of X R hR =>
      intro x
      obtain ⟨Y, f, hf, hx⟩ := B.exists_mem_range_of_mem_precoverage hR x
      exact ⟨Y, f, ⟨Y, 𝟙 Y, f, hf, by simp⟩, hx⟩
  | top X => exact fun x ↦ ⟨X, 𝟙 X, trivial, by simp⟩
  | pullback X T _ Y f ih =>
      intro y
      obtain ⟨Z, g, hg, z, hz⟩ := ih (B.inclusion.map f y)
      obtain ⟨p, hp₁, -⟩ := Scheme.exists_preimage_of_isPullback
        ((IsPullback.of_hasPullback f g).map B.inclusion) y z hz.symm
      exact ⟨Limits.pullback f g, Limits.pullback.fst f g,
        by simpa [Limits.pullback.condition] using T.downward_closed hg (pullback.snd f g),
        p, hp₁⟩
  | transitive X T R _ _ ih₁ ih₂ =>
      intro x
      obtain ⟨Z, g, hg, z, hz⟩ := ih₁ x
      obtain ⟨W, h, hh, w, hw⟩ := ih₂ hg z
      refine ⟨W, h ≫ g, hh, w, ?_⟩
      rw [B.inclusion.map_comp, Scheme.Hom.comp_apply, hw, hz]

/-- **Every covering sieve of the big étale site over `S` is jointly surjective on points.**
Each point of the target is in the image of one of the members of the sieve. -/
public theorem BigEtaleOver.exists_mem_arrows_mem_range (B : BigEtaleSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) {X : BigEtaleOver B S hS} {R : Sieve X}
    (hR : R ∈ BigEtaleOver.topology B S hS X) (x : B.inclusion.obj X.left) :
    ∃ (Y : BigEtaleOver B S hS) (f : Y ⟶ X), R.arrows f ∧
      x ∈ Set.range (B.inclusion.map f.left) := by
  rw [bigEtaleOver_topology_eq, GrothendieckTopology.mem_over_iff] at hR
  obtain ⟨Y, f, hf, hx⟩ := B.exists_mem_arrows_mem_range hR x
  exact ⟨Over.mk (f ≫ X.hom), Over.homMk f, (Sieve.overEquiv_iff R f).1 hf, hx⟩

/-! ### Jointly surjective étale sieves are covering sieves -/

/-- **The covering bound is no restriction on a big étale site.** A family of étale morphisms
of `B` whose underlying morphisms of schemes are jointly surjective admits a *selected*
covering family — one of the families the site has chosen, so in particular one whose index
type obeys `B.coveringBound` — all of whose arrows belong to the presieve of the given family. -/
public theorem BigEtaleSite.exists_isCovering_le (B : BigEtaleSite.{u}) {X : B.Scheme}
    (E : PreZeroHypercover.{u + 1} X) (hetale : ∀ i, Etale (B.inclusion.map (E.f i)))
    (hE : ∀ x : B.inclusion.obj X, ∃ i, x ∈ Set.range (B.inclusion.map (E.f i))) :
    ∃ E' : PreZeroHypercover.{u + 1} X, B.IsCovering ⟨X, E'⟩ ∧ E'.presieve₀ ≤ E.presieve₀ := by
  obtain ⟨⟨V, F⟩, hF, hV, hce⟩ := B.exists_covering_rep ⟨X, E⟩
    ((Scheme.ofArrows_mem_precoverage_iff
      (P := etaleMorphisms.{u})).2 ⟨hE, hetale⟩)
  dsimp only at hV hce
  subst hV
  replace hce : PreZeroHypercover.CombinatoriallyEquivalent E F := hce
  obtain ⟨β, hX, hf⟩ := hce.2
  refine ⟨⟨F.I₀, fun j ↦ E.X (β j), fun j ↦ E.f (β j)⟩, ⟨?_, hF.2⟩, ?_⟩
  · refine (Scheme.ofArrows_mem_precoverage_iff
      (P := etaleMorphisms.{u})).2
      ⟨fun x ↦ ?_, fun j ↦ hetale (β j)⟩
    obtain ⟨j, hj⟩ := ((Scheme.ofArrows_mem_precoverage_iff
      (P := etaleMorphisms.{u})).1 hF.1).1 x
    refine ⟨j, ?_⟩
    have hrange : Set.range (B.inclusion.map (F.f j)) ⊆
        Set.range (B.inclusion.map (E.f (β j))) := by
      rw [hf j, B.inclusion.map_comp]
      rintro _ ⟨y, rfl⟩
      exact ⟨(B.inclusion.map (eqToHom (hX j))).base y, rfl⟩
    exact hrange hj
  · rintro Y g ⟨j⟩
    exact ⟨β j⟩

/-- **A sieve of a big étale site whose arrows are étale and jointly surjective on points is a
covering sieve.** -/
public theorem BigEtaleSite.mem_topology_of_jointlySurjective (B : BigEtaleSite.{u})
    {X : B.Scheme} {R : Sieve X}
    (hR : ∀ x : B.inclusion.obj X, ∃ (Y : B.Scheme) (g : Y ⟶ X), R g ∧
      Etale (B.inclusion.map g) ∧ x ∈ Set.range (B.inclusion.map g)) :
    R ∈ B.topology X := by
  choose Y g hg hge hx using hR
  obtain ⟨E', hE', hle⟩ := B.exists_isCovering_le
    (X := X) ⟨ULift.{u + 1} (B.inclusion.obj X), fun i ↦ Y i.down, fun i ↦ g i.down⟩
    (fun i ↦ hge i.down) fun x ↦ ⟨ULift.up x, hx x⟩
  refine B.topology.superset_covering ?_
    (CategoryTheory.Precoverage.generate_mem_toGrothendieck ⟨E', rfl, hE'⟩)
  rw [Sieve.generate_le_iff]
  intro Z f hf
  obtain ⟨i⟩ := hle _ f hf
  exact hg i.down

/-- **The sieve generated by a jointly surjective family of étale morphisms over `S` is a
covering sieve of the big étale site over `S`.** -/
public theorem BigEtaleOver.generate_ofArrows_mem_topology (B : BigEtaleSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) {X : BigEtaleOver B S hS} {K : Type*}
    (V : K → BigEtaleOver B S hS) (v : ∀ k, V k ⟶ X)
    (hetale : ∀ k, Etale (B.inclusion.map (v k).left))
    (hsurj : ∀ x : B.inclusion.obj X.left, ∃ k, x ∈ Set.range (B.inclusion.map (v k).left)) :
    Sieve.generate (Presieve.ofArrows V v) ∈ BigEtaleOver.topology B S hS X := by
  rw [bigEtaleOver_topology_eq, GrothendieckTopology.mem_over_iff,
    show Sieve.generate (Presieve.ofArrows V v) = Sieve.ofArrows V v from rfl,
    Sieve.overEquiv_ofArrows]
  refine B.mem_topology_of_jointlySurjective fun x ↦ ?_
  obtain ⟨k, hk⟩ := hsurj x
  exact ⟨(V k).left, (v k).left, Sieve.le_generate _ _ _ (Presieve.ofArrows.mk k),
    hetale k, hk⟩

end AlgebraicGeometry

end
