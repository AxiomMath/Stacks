module

public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale
public import StacksCore.Tactic.StacksAttribute

/-!
# The big and small étale sites of a scheme

Let `B` be a big étale site containing a scheme `S`. There are four categories of interest,
each a full subcategory of the next-largest, and each with its own class of covering families:

* the **big étale site over `S`**, the slice of `B` over `S`, with the covering families of `B`;
* the **small étale site of `S`**, its full subcategory of objects whose structure morphism to
  `S` is étale;
* the **big affine étale site over `S`**, its full subcategory of affine schemes, whose
  covering families are the standard étale ones — finite, with affine target and sources;
* the **small affine étale site of `S`**, the affine objects of the small étale site.

This file defines the four categories, specifies their covering families, and exhibits the
precoverage each class of families presents. That these classes satisfy the site axioms is a
separate statement.

## Main definitions

* `AlgebraicGeometry.BigEtaleOver` — the big étale category over `S`.
* `AlgebraicGeometry.SmallEtale` — its full subcategory of schemes étale over `S`.
* `AlgebraicGeometry.BigAffineEtale` — its full subcategory of affine schemes.
* `AlgebraicGeometry.SmallAffineEtale` — the affine full subcategory of `SmallEtale`.
* The `IsCovering` predicate in each of the four namespaces specifies that category's covering
  families, `precoverage` is the precoverage they present, and `topology` the Grothendieck
  topology they generate.

## Main results

* The `mem_precoverage_iff` lemmas characterize the four precoverages in terms of the
  presenting covering families.

## Implementation notes

The localized category is a slice category, so its fibre products and final object come from
the general theory of slices. Every full subcategory is an `ObjectProperty.FullSubcategory`,
so its canonical inclusion is available without making any choices, and the defining property
of its objects is registered as an instance.

A standard étale covering is expressed intrinsically, as a finite big étale covering whose
target and source schemes are affine. This is equivalent to presenting those schemes as
spectra of rings, but avoids choosing such presentations.

The covering predicates retain indexed families rather than passing to the Grothendieck
topology they generate, because the site axioms are statements about those families
themselves. The `mem_precoverage_iff` lemmas expose the presenting families without unfolding
a `Precoverage`.

## References

* [Stacks Project, Tag 021B](https://stacks.math.columbia.edu/tag/021B)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

variable (B : AlgebraicGeometry.BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **Stacks 021B, part (1).** The underlying category of the big étale site of `S` is the
slice of the chosen big étale category over `S`. -/
@[stacks 021B "part (1), category", sga "4 XVII 0.10" "big étale site"]
public abbrev BigEtaleOver := Over (B.obj S hS)

namespace BigEtaleOver

/-- The forgetful functor from the big étale category over `S` to the chosen big étale
category. -/
public abbrev forget : BigEtaleOver B S hS ⥤ B.Scheme := Over.forget _

/-- The canonical functor from the big étale category over `S` to schemes. -/
public abbrev toScheme : BigEtaleOver B S hS ⥤ Scheme.{u} :=
  forget B S hS ⋙ B.inclusion

/-- **Stacks 021B, part (1).** A family in the slice is covering precisely when its underlying
family is a covering in the chosen big étale site. -/
@[stacks 021B "part (1), coverings", sga "4 XVII 0.10" "big étale site"]
public abbrev IsCovering (E : Covering (BigEtaleOver B S hS)) : Prop :=
  B.IsCovering ⟨(Over.forget (B.obj S hS)).obj E.1, E.2.map (Over.forget (B.obj S hS))⟩

/-- The precoverage presented by the covering families of the big étale category over `S`. -/
public def precoverage : Precoverage (BigEtaleOver B S hS) where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X,
    R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩}

/-- A presieve belongs to the big étale precoverage over `S` exactly when it is presented by a
covering family. -/
public theorem mem_precoverage_iff {X : BigEtaleOver B S hS} {R : Presieve X} :
    R ∈ precoverage B S hS X ↔ ∃ E : PreZeroHypercover.{u + 1} X,
      R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩ :=
  Iff.rfl

/-- The Grothendieck topology generated by the covering families of the big étale category
over `S`. -/
@[sga "4 XVII 0.10" "big étale site"]
public abbrev topology : GrothendieckTopology (BigEtaleOver B S hS) :=
  (precoverage B S hS).toGrothendieck

/-- The property of an object of the big étale category over `S` that its structure morphism
to `S` is étale. -/
public abbrev IsEtaleOver : ObjectProperty (BigEtaleOver B S hS) :=
  fun X ↦ Etale (B.inclusion.map X.hom)

/-- The property of an object of the big étale category over `S` that its underlying scheme
is affine. -/
public abbrev IsAffineOver : ObjectProperty (BigEtaleOver B S hS) :=
  fun X ↦ IsAffine ((toScheme B S hS).obj X)

/-- A standard étale covering in the big étale category over `S` is a finite covering family
whose target and source schemes are affine.  Since it is a big étale covering, all its arrows
are étale and their images jointly cover the target. -/
public abbrev IsStandardEtaleCovering (E : Covering (BigEtaleOver B S hS)) : Prop :=
  IsCovering B S hS E ∧
    IsAffine ((toScheme B S hS).obj E.1) ∧ Finite E.2.I₀ ∧
    ∀ i, IsAffine ((toScheme B S hS).obj (E.2.X i))

end BigEtaleOver

/-- **Stacks 021B, part (2).** The small étale category of `S` is the full subcategory of the
big étale category over `S` consisting of objects étale over `S`. -/
@[stacks 021B "part (2), category"]
public abbrev SmallEtale := (BigEtaleOver.IsEtaleOver B S hS).FullSubcategory

namespace SmallEtale

/-- The structure morphism of every object of the small étale category is étale. -/
public instance etale_structureMorphism (X : SmallEtale B S hS) :
    Etale (B.inclusion.map X.obj.hom) :=
  X.property

/-- The canonical full embedding of the small étale category into the big étale category
over `S`. -/
public abbrev inclusion : SmallEtale B S hS ⥤ BigEtaleOver B S hS :=
  (BigEtaleOver.IsEtaleOver B S hS).ι

/-- The canonical functor from the small étale category of `S` to schemes. -/
public abbrev toScheme : SmallEtale B S hS ⥤ Scheme.{u} :=
  inclusion B S hS ⋙ BigEtaleOver.toScheme B S hS

/-- **Stacks 021B, part (2).** A family in the small étale category is covering when its
image in the big étale category over `S` is covering. -/
@[stacks 021B "part (2), coverings"]
public abbrev IsCovering (E : Covering (SmallEtale B S hS)) : Prop :=
  BigEtaleOver.IsCovering B S hS
    ⟨(inclusion B S hS).obj E.1, E.2.map (inclusion B S hS)⟩

/-- The precoverage presented by the covering families of the small étale category of `S`. -/
public def precoverage : Precoverage (SmallEtale B S hS) where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X,
    R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩}

/-- A presieve belongs to the small étale precoverage exactly when it is presented by a
covering family. -/
public theorem mem_precoverage_iff {X : SmallEtale B S hS} {R : Presieve X} :
    R ∈ precoverage B S hS X ↔ ∃ E : PreZeroHypercover.{u + 1} X,
      R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩ :=
  Iff.rfl

/-- The Grothendieck topology generated by the covering families of the small étale category
of `S`. -/
public abbrev topology : GrothendieckTopology (SmallEtale B S hS) :=
  (precoverage B S hS).toGrothendieck

end SmallEtale

/-- **Stacks 021B, part (3).** The big affine étale category over `S` is the full subcategory
of the big étale category over `S` consisting of affine source schemes. -/
@[stacks 021B "part (3), category"]
public abbrev BigAffineEtale := (BigEtaleOver.IsAffineOver B S hS).FullSubcategory

namespace BigAffineEtale

/-- The canonical full embedding of the big affine étale category into the big étale category
over `S`. -/
public abbrev inclusion : BigAffineEtale B S hS ⥤ BigEtaleOver B S hS :=
  (BigEtaleOver.IsAffineOver B S hS).ι

/-- The canonical functor from the big affine étale category over `S` to schemes. -/
public abbrev toScheme : BigAffineEtale B S hS ⥤ Scheme.{u} :=
  inclusion B S hS ⋙ BigEtaleOver.toScheme B S hS

/-- Every object of the big affine étale category has affine underlying scheme. -/
public instance isAffine_toScheme_obj (X : BigAffineEtale B S hS) :
    IsAffine ((toScheme B S hS).obj X) :=
  X.property

/-- **Stacks 021B, part (3).** A family in the big affine étale category is covering when its
image in the big étale category over `S` is a standard étale covering. -/
@[stacks 021B "part (3), coverings"]
public abbrev IsCovering (E : Covering (BigAffineEtale B S hS)) : Prop :=
  BigEtaleOver.IsStandardEtaleCovering B S hS
    ⟨(inclusion B S hS).obj E.1, E.2.map (inclusion B S hS)⟩

/-- The precoverage presented by standard étale covering families in the big affine étale
category over `S`. -/
public def precoverage : Precoverage (BigAffineEtale B S hS) where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X,
    R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩}

/-- A presieve belongs to the big affine étale precoverage exactly when it is presented by a
standard étale covering family. -/
public theorem mem_precoverage_iff {X : BigAffineEtale B S hS} {R : Presieve X} :
    R ∈ precoverage B S hS X ↔ ∃ E : PreZeroHypercover.{u + 1} X,
      R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩ :=
  Iff.rfl

/-- The Grothendieck topology generated by the standard étale covering families of the big
affine étale category over `S`. -/
public abbrev topology : GrothendieckTopology (BigAffineEtale B S hS) :=
  (precoverage B S hS).toGrothendieck

end BigAffineEtale

/-- The property of a small étale object over `S` that its underlying scheme is affine. -/
public abbrev SmallEtale.IsAffine : ObjectProperty (SmallEtale B S hS) :=
  fun X ↦ AlgebraicGeometry.IsAffine ((SmallEtale.toScheme B S hS).obj X)

/-- **Stacks 021B, part (4).** The small affine étale category of `S` is the full subcategory
of the small étale category consisting of affine schemes. -/
@[stacks 021B "part (4), category"]
public abbrev SmallAffineEtale := (SmallEtale.IsAffine B S hS).FullSubcategory

namespace SmallAffineEtale

/-- The canonical full embedding of the small affine étale category into the small étale
category. -/
public abbrev inclusion : SmallAffineEtale B S hS ⥤ SmallEtale B S hS :=
  (SmallEtale.IsAffine B S hS).ι

/-- The canonical functor from the small affine étale category of `S` to schemes. -/
public abbrev toScheme : SmallAffineEtale B S hS ⥤ Scheme.{u} :=
  inclusion B S hS ⋙ SmallEtale.toScheme B S hS

/-- Every object of the small affine étale category has affine underlying scheme. -/
public instance isAffine_toScheme_obj (X : SmallAffineEtale B S hS) :
    IsAffine ((toScheme B S hS).obj X) :=
  X.property

/-- **Stacks 021B, part (4).** A family in the small affine étale category is covering when
its image in the small étale category is covering and it is finite (hence standard étale,
since its source objects are affine). -/
@[stacks 021B "part (4), coverings"]
public abbrev IsCovering (E : Covering (SmallAffineEtale B S hS)) : Prop :=
  SmallEtale.IsCovering B S hS
      ⟨(inclusion B S hS).obj E.1, E.2.map (inclusion B S hS)⟩ ∧
    Finite E.2.I₀

/-- The precoverage presented by standard étale covering families in the small affine étale
category of `S`. -/
public def precoverage : Precoverage (SmallAffineEtale B S hS) where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X,
    R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩}

/-- A presieve belongs to the small affine étale precoverage exactly when it is presented by a
standard étale covering family. -/
public theorem mem_precoverage_iff {X : SmallAffineEtale B S hS} {R : Presieve X} :
    R ∈ precoverage B S hS X ↔ ∃ E : PreZeroHypercover.{u + 1} X,
      R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩ :=
  Iff.rfl

/-- The Grothendieck topology generated by the standard étale covering families of the small
affine étale category of `S`. -/
public abbrev topology : GrothendieckTopology (SmallAffineEtale B S hS) :=
  (precoverage B S hS).toGrothendieck

end SmallAffineEtale

end AlgebraicGeometry
