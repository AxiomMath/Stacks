module

public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.Sites
public import StacksFrontier.CategoryTheory.Sites.Pretopology.CombinatorialEquivalence

/-!
# The covering bound of a big étale site is no restriction on covering sieves

A big étale site `B` selects, among all étale covering families of its size-bounded category of
schemes, only those whose index type has cardinality at most `B.coveringBound`
(`AlgebraicGeometry.BigEtaleSite.IsCovering`), and the small étale topology of a scheme `S`
contained in `B` is generated by exactly those families
(`AlgebraicGeometry.SmallEtale.topology`).  Mathlib's small étale topology, by contrast, is
generated by *all* jointly surjective families of étale morphisms, with no bound on the index
type.

This file reconciles the two.  The reconciling input is
`AlgebraicGeometry.BigEtaleSite.exists_covering_rep`: every étale covering family has a
*selected* representative which is combinatorially equivalent to it in the sense of Stacks
00VU (1).  Combinatorial equivalence does not preserve the index type; it only matches the two
families arrow for arrow.  So a selected representative of an unbounded family is a reindexing
of a *subfamily* of it — which is all one needs, because a presieve remembers only the set of
arrows.

## Main results

* `AlgebraicGeometry.SmallEtale.etale_toScheme_map`: every morphism of the small étale category
  is étale on underlying schemes.
* `AlgebraicGeometry.SmallEtale.exists_isCovering_le`: a jointly surjective family in the small
  étale category of `S` admits a *selected* covering family all of whose arrows belong to the
  presieve of the original family.
* `AlgebraicGeometry.SmallEtale.mem_topology_of_jointlySurjective`: **a sieve of the small étale
  category of `S` whose arrows are jointly surjective on underlying spaces is a covering sieve
  of `AlgebraicGeometry.SmallEtale.topology`.**  This is the statement that the covering bound
  imposes no restriction at the level of the generated topology.

## Implementation notes

The selected representative produced by `exists_covering_rep` lives in the size-bounded category
of schemes of `B`, not in the small étale category of `S`.  It is pulled back to the small étale
category by reindexing the *given* family along the index map supplied by combinatorial
equivalence, rather than by equipping the representative's objects with structure morphisms:
reindexing keeps the arrows literally equal to arrows of the given family, which is what makes
the presieve comparison hold on the nose.

## References

* [Stacks Project, Tag 000X](https://stacks.math.columbia.edu/tag/000X)
* [Stacks Project, Tag 00VU](https://stacks.math.columbia.edu/tag/00VU)
* [Stacks Project, Tag 021B](https://stacks.math.columbia.edu/tag/021B)
-/

@[expose] public section

open CategoryTheory Cardinal

universe u

namespace AlgebraicGeometry

variable {B : BigEtaleSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

namespace SmallEtale

/-- The canonical functor from the small étale category of `S` to the size-bounded category of
schemes of the ambient big étale site, through which the underlying scheme of an object is
reached: composing it with `AlgebraicGeometry.BigEtaleSite.inclusion` is
`AlgebraicGeometry.SmallEtale.toScheme`. -/
public abbrev toBigScheme (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) :
    SmallEtale B S hS ⥤ B.Scheme :=
  inclusion B S hS ⋙ CategoryTheory.Over.forget (B.obj S hS)

/-- Every morphism of the small étale category of `S` is étale on underlying schemes: it is a
morphism over `S` between two schemes étale over `S`, so étaleness descends by cancellation. -/
public instance etale_toScheme_map {X Y : SmallEtale B S hS} (g : X ⟶ Y) :
    Etale ((toScheme B S hS).map g) := by
  have hw : (toScheme B S hS).map g ≫ B.inclusion.map Y.obj.hom =
      B.inclusion.map X.obj.hom :=
    (B.inclusion.map_comp _ _).symm.trans
      (congrArg B.inclusion.map (CategoryTheory.Over.w ((inclusion B S hS).map g)))
  have : Etale ((toScheme B S hS).map g ≫ B.inclusion.map Y.obj.hom) := by
    rw [hw]; infer_instance
  exact Etale.of_comp ((toScheme B S hS).map g) (B.inclusion.map Y.obj.hom)

/-- A family in the small étale category of `S` whose underlying morphisms are jointly
surjective is an étale covering family of the ambient big étale site, before the covering bound
is taken into account. -/
public theorem isEtaleCovering_map_toBigScheme {X : SmallEtale B S hS}
    (E : PreZeroHypercover.{u + 1} X)
    (hE : ∀ x : (toScheme B S hS).obj X, ∃ i, x ∈ Set.range ((toScheme B S hS).map (E.f i))) :
    IsEtaleCovering ⟨(toBigScheme B S hS).obj X, E.map (toBigScheme B S hS)⟩ :=
  (Scheme.ofArrows_mem_precoverage_iff (P := @Etale)).2
    ⟨hE, fun i ↦ etale_toScheme_map (E.f i)⟩

/-- **The covering bound is no restriction.**  A jointly surjective family in the small étale
category of `S` admits a *selected* covering family — one of the families the ambient big étale
site has chosen, so in particular one whose index type obeys `B.coveringBound` — whose arrows
all belong to the presieve of the given family.

The selected family is obtained from `AlgebraicGeometry.BigEtaleSite.exists_covering_rep` by
reindexing the given family along the index map of the resulting combinatorial equivalence. -/
public theorem exists_isCovering_le {X : SmallEtale B S hS} (E : PreZeroHypercover.{u + 1} X)
    (hE : ∀ x : (toScheme B S hS).obj X, ∃ i, x ∈ Set.range ((toScheme B S hS).map (E.f i))) :
    ∃ E' : PreZeroHypercover.{u + 1} X, IsCovering B S hS ⟨X, E'⟩ ∧
      E'.presieve₀ ≤ E.presieve₀ := by
  obtain ⟨⟨V, F⟩, hF, hV, hce⟩ := B.exists_covering_rep
    ⟨(toBigScheme B S hS).obj X, E.map (toBigScheme B S hS)⟩
    (isEtaleCovering_map_toBigScheme E hE)
  dsimp only at hV hce
  subst hV
  replace hce : PreZeroHypercover.CombinatoriallyEquivalent
    (E.map (toBigScheme B S hS)) F := hce
  obtain ⟨β, hX, hf⟩ := hce.2
  refine ⟨⟨F.I₀, fun j ↦ E.X (β j), fun j ↦ E.f (β j)⟩, ⟨?_, hF.2⟩, fun _ _ ⟨j⟩ ↦ ⟨β j⟩⟩
  refine (Scheme.ofArrows_mem_precoverage_iff (P := @Etale)).2 ⟨fun x ↦ ?_, fun j ↦ ?_⟩
  · obtain ⟨j, hj⟩ := ((Scheme.ofArrows_mem_precoverage_iff (P := @Etale)).1 hF.1).1 x
    have hrange : Set.range (B.inclusion.map (F.f j)) ⊆
        Set.range ((toScheme B S hS).map (E.f (β j))) := by
      rw [hf j, B.inclusion.map_comp]
      rintro _ ⟨y, rfl⟩
      exact ⟨(B.inclusion.map (eqToHom (hX j))).base y, rfl⟩
    exact ⟨j, hrange hj⟩
  · exact inferInstanceAs (Etale ((toScheme B S hS).map (E.f (β j))))

/-- **A sieve of the small étale category of `S` whose arrows are jointly surjective on
underlying spaces is a covering sieve.**  Only the selected covering families of the ambient
big étale site generate the topology, but by
`AlgebraicGeometry.SmallEtale.exists_isCovering_le` one of them is refined by the given
arrows. -/
public theorem mem_topology_of_jointlySurjective {X : SmallEtale B S hS} {R : Sieve X}
    (hR : ∀ x : (toScheme B S hS).obj X, ∃ (Y : SmallEtale B S hS) (g : Y ⟶ X), R g ∧
      x ∈ Set.range ((toScheme B S hS).map g)) :
    R ∈ topology B S hS X := by
  choose Y g hg hx using hR
  obtain ⟨E', hE', hle⟩ := exists_isCovering_le
    (X := X) ⟨ULift.{u + 1} ((toScheme B S hS).obj X), fun i ↦ Y i.down, fun i ↦ g i.down⟩
    fun x ↦ ⟨ULift.up x, hx x⟩
  refine topology B S hS |>.superset_covering ?_
    (CategoryTheory.Precoverage.generate_mem_toGrothendieck ⟨E', rfl, hE'⟩)
  rw [Sieve.generate_le_iff]
  intro Z f hf
  obtain ⟨i⟩ := hle _ f hf
  exact hg i.down

end SmallEtale

end AlgebraicGeometry

end
