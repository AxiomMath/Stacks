module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Topologies.Fppf.Precoverage

/-!
# The covering sieve generated by a family inside the big fppf site of `S`

`AlgebraicGeometry.exists_family_of_mem_topology` extracts, from a covering sieve of an object
`U` of the big fppf site of `S`, a family of morphisms of the site which is flat, locally of
finite presentation and jointly surjective. This module proves the converse: such a family
generates a covering sieve.

## Main results

* `AlgebraicGeometry.mem_topology_of_family`: a flat, locally of finite presentation and jointly
  surjective family of morphisms of the underlying category of the site generates a covering
  sieve of the big fppf topology of `S`.
* `AlgebraicGeometry.exists_mem_topology_of_family`: the same, packaged as the existence of a
  covering sieve each of whose arrows factors through a member of the family.

## References

* [Stacks Project, Tag 021R](https://stacks.math.columbia.edu/tag/021R)
* [Stacks Project, Tag 021S](https://stacks.math.columbia.edu/tag/021S)
* [Stacks Project, Tag 04XD](https://stacks.math.columbia.edu/tag/04XD)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry

universe u

/-- A flat, locally finitely presented, jointly surjective family of morphisms into `U`
generates a covering sieve of `U` in the big fppf site over `S`. -/
theorem mem_topology_of_family (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {U : BigFppfOver B S hS} {I : Type (u + 1)} (W : I → B.Schemes)
    (m : ∀ i, W i ⟶ U.left)
    (hflat : ∀ i, Flat (B.inclusion.map (m i)))
    (hlfp : ∀ i, LocallyOfFinitePresentation (B.inclusion.map (m i)))
    (hsurj : ∀ x : (B.inclusion.obj U.left), ∃ i, x ∈ Set.range (B.inclusion.map (m i))) :
    Sieve.ofArrows (fun i => (Over.mk (m i ≫ U.hom) : BigFppfOver B S hS))
        (fun i => (Over.homMk (m i) : Over.mk (m i ≫ U.hom) ⟶ U))
      ∈ BigFppfOver.topology B S hS U := by
  rw [BigFppfOver.topology, GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
  change Sieve.generate (Presieve.ofArrows W m) ∈ B.topology U.left
  refine Precoverage.generate_mem_toGrothendieck ?_
  rw [bigFppfPrecoverage_eq_comap B, Precoverage.mem_comap_iff, Presieve.map_ofArrows]
  exact (Scheme.ofArrows_mem_precoverage_iff _).mpr ⟨hsurj, fun i ↦ ⟨hflat i, hlfp i⟩⟩

/-- A flat, locally finitely presented, jointly surjective family of morphisms into `U` yields a
covering sieve of `U` in the big fppf site over `S` each of whose arrows factors through a member
of the family. -/
theorem exists_mem_topology_of_family (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    {U : BigFppfOver B S hS} {I : Type (u + 1)} (W : I → B.Schemes)
    (m : ∀ i, W i ⟶ U.left)
    (hflat : ∀ i, Flat (B.inclusion.map (m i)))
    (hlfp : ∀ i, LocallyOfFinitePresentation (B.inclusion.map (m i)))
    (hsurj : ∀ x : (B.inclusion.obj U.left), ∃ i, x ∈ Set.range (B.inclusion.map (m i))) :
    ∃ R ∈ BigFppfOver.topology B S hS U,
      ∀ ⦃V : BigFppfOver B S hS⦄ ⦃k : V ⟶ U⦄, R.arrows k →
        ∃ (i : I) (b : V ⟶ Over.mk (m i ≫ U.hom)),
          b ≫ (Over.homMk (m i) : Over.mk (m i ≫ U.hom) ⟶ U) = k := by
  refine ⟨_, mem_topology_of_family B S hS W m hflat hlfp hsurj, ?_⟩
  rintro V k ⟨T, a, b, ⟨i⟩, rfl⟩
  exact ⟨i, a, rfl⟩

end AlgebraicGeometry

end
