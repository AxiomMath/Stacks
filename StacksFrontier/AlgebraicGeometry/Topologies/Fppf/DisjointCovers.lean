module

public import StacksFrontier.AlgebraicGeometry.Topologies.Fppf.CoveringSieves
public import StacksFrontier.CategoryTheory.Sites.InheritedTopology.DisjointGluing

/-!
# Disjoint open coverings in the big fppf site

An object of the big fppf site over `S` whose underlying scheme is empty is void: the empty
sieve covers it and it is initial, as is everything mapping to it. A finite family of open
immersions covering the target whose distinct members only meet over the empty scheme is
therefore a disjoint covering
family of the big fppf site, along which objects and morphisms of a stack in groupoids glue
(`CategoryTheory.Functor.IsStackInGroupoids.exists_glue_obj` and
`CategoryTheory.Functor.IsStackInGroupoids.existsUnique_glue_hom_over`).

## Main results

* `AlgebraicGeometry.BigFppfOver.isVoid_of_isEmpty`.
* `AlgebraicGeometry.BigFppfOver.isDisjointCover_of_isOpenImmersion`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Functor

namespace AlgebraicGeometry.BigFppfOver

universe w u

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- The sieve generated by a family with empty index is the empty sieve. -/
theorem _root_.CategoryTheory.Sieve.ofArrows_eq_bot_of_isEmpty {C : Type*} [Category C] {X : C}
    {ι : Type*} [IsEmpty ι] (Y : ι → C) (f : ∀ i, Y i ⟶ X) : Sieve.ofArrows Y f = ⊥ := by
  ext Z g
  simp only [Sieve.bot_apply, iff_false]
  rintro ⟨_, _, _, ⟨i⟩, _⟩
  exact isEmptyElim i

/-- **An object with empty underlying scheme is void.** -/
theorem isVoid_of_isEmpty (Z : BigFppfOver B S hS)
    (hZ : IsEmpty ((BigFppfOver.toScheme B S hS).obj Z)) :
    IsVoid (BigFppfOver.topology B S hS) Z := by
  refine ⟨?_, fun Z' f T ↦ ?_⟩
  · have h := mem_topology_of_family B S hS (U := Z) (I := PEmpty.{u + 2}) (fun i ↦ i.elim)
      (fun i ↦ i.elim) (fun i ↦ i.elim) (fun i ↦ i.elim)
      (fun x ↦ (IsEmpty.false (α := (BigFppfOver.toScheme B S hS).obj Z) x).elim)
    rwa [Sieve.ofArrows_eq_bot_of_isEmpty] at h
  · have : IsEmpty ((BigFppfOver.toScheme B S hS).obj Z') :=
      ⟨fun z ↦ IsEmpty.false ((BigFppfOver.toScheme B S hS).map f z)⟩
    exact ⟨fun a b ↦ (BigFppfOver.toScheme B S hS).map_injective (isInitialOfIsEmpty.hom_ext _ _)⟩

/-- **A finite family of open immersions covering the target, two distinct members of which only
meet over the empty scheme, is a disjoint covering family of the big fppf site.** -/
theorem isDisjointCover_of_isOpenImmersion {E : BigFppfOver B S hS} {I : Type w} [Finite I]
    (V : I → BigFppfOver B S hS) (e : ∀ i, V i ⟶ E)
    (hop : ∀ i, IsOpenImmersion ((BigFppfOver.toScheme B S hS).map (e i)))
    (hsurj : ∀ x : (BigFppfOver.toScheme B S hS).obj E, ∃ i,
      x ∈ Set.range ((BigFppfOver.toScheme B S hS).map (e i)))
    (hdisj : ∀ i j, i ≠ j → ∀ ⦃Z : BigFppfOver B S hS⦄ (a : Z ⟶ V i) (b : Z ⟶ V j),
      a ≫ e i = b ≫ e j → IsEmpty ((BigFppfOver.toScheme B S hS).obj Z)) :
    IsDisjointCover (BigFppfOver.topology B S hS) V e := by
  refine ⟨?_, fun i ↦ ?_, fun i j hij Z a b hab ↦ isVoid_of_isEmpty Z (hdisj i j hij a b hab)⟩
  · obtain ⟨n, ⟨σ⟩⟩ := Finite.exists_equiv_fin I
    let τ : ULift.{u + 1} (Fin n) → I := fun k ↦ σ.symm k.down
    have hτ : Function.Surjective τ := fun i ↦ ⟨⟨σ i⟩, by simp [τ]⟩
    have h := mem_topology_of_family B S hS (U := E) (I := ULift.{u + 1} (Fin n))
      (fun k ↦ (V (τ k)).left) (fun k ↦ (e (τ k)).left)
      (fun k ↦ (inferInstance : Flat ((BigFppfOver.toScheme B S hS).map (e (τ k)))))
      (fun k ↦ (inferInstance : LocallyOfFinitePresentation
        ((BigFppfOver.toScheme B S hS).map (e (τ k)))))
      (fun x ↦ by
        obtain ⟨i, hi⟩ := hsurj x
        obtain ⟨k, rfl⟩ := hτ i
        exact ⟨k, hi⟩)
    refine (BigFppfOver.topology B S hS).superset_covering ?_ h
    rw [Sieve.ofArrows, Sieve.generate_le_iff]
    rintro _ _ ⟨k⟩
    refine ⟨V (τ k), Over.homMk (𝟙 _) (by simp), e (τ k), ⟨τ k⟩, ?_⟩
    ext
    simp
  · have := hop i
    exact (BigFppfOver.toScheme B S hS).mono_of_mono_map inferInstance

end AlgebraicGeometry.BigFppfOver

end
