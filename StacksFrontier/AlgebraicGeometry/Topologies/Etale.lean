module

public import Mathlib.AlgebraicGeometry.Sites.Etale
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Size.Cutoff
public import StacksFrontier.CategoryTheory.Sites.Pretopology.SmallSubsite

/-!
# Big étale sites

The big étale site of Stacks 021A is `AlgebraicGeometry.StacksBigEtaleSite`: a set of schemes
`S₀` and a set `Cov₀` of étale coverings among them, a set-sized full subcategory of schemes
satisfying the conditions (1)–(4) of Stacks 000J (`AlgebraicGeometry.IsBigSchemeCategory`), and
a set of étale coverings of it satisfying the conclusions (1)–(3) of Stacks 000X.

The size-bounded variant `AlgebraicGeometry.BigEtaleSite`, used throughout the library, is the
following. A big étale site is obtained by choosing a size cutoff for a full subcategory of schemes
and then choosing, among the étale covering families in that subcategory, a bounded
collection of coverings satisfying the site axioms. The initial sets of schemes and
coverings are retained as part of the data.

In the variant, `Sch_α` is replaced by the full subcategory cut out by `Scheme.size X < κ`, with
canonical inclusion `AlgebraicGeometry.BigEtaleSite.inclusion`, and the selected coverings are
`CovBounded IsEtaleCovering κ'`, all étale coverings with index cardinality at most `κ'`. Neither
class is a set. The topology is generated by exactly these selected families. Mathlib's étale
topology on all schemes is the unbounded standard example.

## Main definitions

* `AlgebraicGeometry.StacksBigEtaleSite`: the big étale site of Stacks 021A, with its
  topology `AlgebraicGeometry.StacksBigEtaleSite.topology`.
* `AlgebraicGeometry.IsBigSchemeCategory`: the conditions of Stacks 000J on a full
  subcategory of schemes.
* `AlgebraicGeometry.SchemeBelow` is the full subcategory of schemes whose size is below a
  cardinal, cut out by `AlgebraicGeometry.schemeSizeBelow` and included into all schemes
  by `AlgebraicGeometry.schemeBelowInclusion`.
* `AlgebraicGeometry.IsEtaleCovering` says that a family in `SchemeBelow` becomes an étale
  covering after applying the canonical inclusion into all schemes.
* `AlgebraicGeometry.BigEtaleSite` is the size-bounded variant.
* `AlgebraicGeometry.BigEtaleSite.topology` is the Grothendieck topology generated by its
  chosen coverings.
* `AlgebraicGeometry.Scheme.etaleTopology` (Mathlib) is the full-universe example.

## Main results

* `AlgebraicGeometry.StacksBigEtaleSite.generate_mem_topology_of_isEtaleCoveringIn`: every étale
  covering of the underlying category of a big étale site generates a covering sieve.
* `AlgebraicGeometry.BigEtaleSite.mem_precoverage_iff`: the coverings of the precoverage of a big
  étale site are the presieves of its chosen covering families.
* `AlgebraicGeometry.BigEtaleSite.IsCovering.etale`,
  `AlgebraicGeometry.BigEtaleSite.IsCovering.mk_le`: a chosen covering family is étale, and its
  index type has cardinality at most the covering bound.

## References

* [Stacks Project, Tag 021A](https://stacks.math.columbia.edu/tag/021A)
-/

@[expose] public section

open Cardinal CategoryTheory

universe u

namespace AlgebraicGeometry

/-- The property that a scheme has cardinal size strictly below `κ`. -/
public abbrev schemeSizeBelow (κ : Cardinal.{u}) : ObjectProperty Scheme.{u} :=
  fun X => X.size < κ

/-- The full subcategory of schemes whose cardinal size is strictly below `κ`; it models the
category `Sch_α` of Stacks 000J. -/
public abbrev SchemeBelow (κ : Cardinal.{u}) := (schemeSizeBelow κ).FullSubcategory

/-- The canonical inclusion of the size-bounded full subcategory into the category of all
schemes. -/
public abbrev schemeBelowInclusion (κ : Cardinal.{u}) : SchemeBelow κ ⥤ Scheme.{u} :=
  (schemeSizeBelow κ).ι

/-- An étale covering in the bounded category is a family which becomes an étale covering
of schemes under the canonical inclusion. -/
public abbrev IsEtaleCovering {κ : Cardinal.{u}}
    (𝒰 : Covering.{u + 1, u, u + 1} (SchemeBelow κ)) : Prop :=
  (𝒰.2.map (schemeBelowInclusion κ)).presieve₀ ∈
    Scheme.etalePrecoverage ((schemeBelowInclusion κ).obj 𝒰.1)

/-- A size-bounded variant of the big étale site of Stacks 021A, used throughout the library: a
size-bounded full category of schemes and the class of all étale covering families on it whose
index type has cardinality at most a bound, containing an initial set of schemes and an initial
set of étale coverings. Neither its objects nor its coverings form a set, the Stacks 000J
conditions on limits and colimits are not imposed, and the ordinal `coveringOrdinal` constrains
nothing; it therefore differs from Stacks 021A, which is `AlgebraicGeometry.StacksBigEtaleSite`. -/
public structure BigEtaleSite where
  /-- The initially chosen set of schemes. -/
  S₀ : Set Scheme.{u}
  /-- The initial collection is a set at the universe in which sizes are measured. -/
  small_S₀ : Small.{u} S₀
  /-- The cardinal cutoff defining the underlying category. -/
  cutoff : Cardinal.{u}
  /-- The cutoff is uncountable. -/
  aleph0_lt_cutoff : ℵ₀ < cutoff
  /-- The cutoff is a strong limit cardinal. -/
  cutoff_isStrongPrelimit : cutoff.IsStrongPrelimit
  /-- The cutoff has uncountable cofinality. -/
  aleph0_lt_cutoff_cof : ℵ₀ < cutoff.ord.cof
  /-- Every initially chosen scheme belongs to the bounded category. -/
  mem_cutoff_of_mem : ∀ X ∈ S₀, X.size < cutoff
  /-- The initially chosen set of étale covering families among the initial schemes. -/
  initialCoverings : Set (Covering (SchemeBelow cutoff))
  /-- The initial covering collection is set-sized. -/
  small_initialCoverings : Small.{u + 1} initialCoverings
  /-- The target and every source of an initial covering belong to `S₀`. -/
  initial_objects_mem : ∀ 𝒰 ∈ initialCoverings,
    (schemeBelowInclusion cutoff).obj 𝒰.1 ∈ S₀ ∧
      ∀ i, (schemeBelowInclusion cutoff).obj (𝒰.2.X i) ∈ S₀
  /-- Every initially chosen covering is étale and jointly surjective. -/
  initialCoverings_etale : ∀ 𝒰 ∈ initialCoverings, IsEtaleCovering 𝒰
  /-- The cardinal bounding the index types of the selected coverings. -/
  coveringBound : Cardinal.{u + 1}
  /-- The limit ordinal occurring in the covering-set construction. -/
  coveringOrdinal : Ordinal.{u + 1}
  /-- The chosen covering ordinal is a successor limit. -/
  coveringOrdinal_isSuccLimit : Order.IsSuccLimit coveringOrdinal
  /-- Every initial covering belongs to the selected bounded collection. -/
  initialCoverings_bounded : ∀ 𝒰 ∈ initialCoverings,
    CovBounded IsEtaleCovering coveringBound 𝒰
  /-- The selected bounded covering families satisfy the site axioms. -/
  coverings_isSite : IsSite (CovBounded (IsEtaleCovering (κ := cutoff)) coveringBound)
  /-- Every étale covering has a combinatorially equivalent selected representative. -/
  exists_covering_rep : ∀ 𝒰 : Covering (SchemeBelow cutoff), IsEtaleCovering 𝒰 →
    ∃ 𝒱 : Covering (SchemeBelow cutoff),
      CovBounded IsEtaleCovering coveringBound 𝒱 ∧ Covering.CombEquiv 𝒰 𝒱

namespace BigEtaleSite

/-- The stored smallness proof for the initial set of schemes is available to typeclass
inference. -/
public instance (B : BigEtaleSite.{u}) : Small.{u} B.S₀ := B.small_S₀

/-- The stored smallness proof for the initial set of coverings is available to typeclass
inference. -/
public instance (B : BigEtaleSite.{u}) : Small.{u + 1} B.initialCoverings :=
  B.small_initialCoverings

/-- The underlying category of a big étale site. -/
public abbrev Scheme (B : BigEtaleSite.{u}) := SchemeBelow B.cutoff

/-- The canonical fully faithful inclusion from a big étale site into all schemes. -/
public abbrev inclusion (B : BigEtaleSite.{u}) : B.Scheme ⥤ AlgebraicGeometry.Scheme.{u} :=
  schemeBelowInclusion B.cutoff

/-- A scheme is contained in a big étale site when it lies below its size cutoff. -/
public abbrev Contains (B : BigEtaleSite.{u}) (X : AlgebraicGeometry.Scheme.{u}) : Prop :=
  X.size < B.cutoff

/-- Regard a scheme contained in a big étale site as an object of its underlying
category. -/
public abbrev obj (B : BigEtaleSite.{u}) (X : AlgebraicGeometry.Scheme.{u})
    (hX : B.Contains X) : B.Scheme := ⟨X, hX⟩

/-- The chosen covering families of a big étale site. -/
public abbrev IsCovering (B : BigEtaleSite.{u}) : Covering B.Scheme → Prop :=
  CovBounded IsEtaleCovering B.coveringBound

/-- The precoverage consisting of exactly the chosen covering families. -/
public def precoverage (B : BigEtaleSite.{u}) : Precoverage B.Scheme where
  coverings X := {R | ∃ 𝒰 : PreZeroHypercover.{u + 1} X, R = 𝒰.presieve₀ ∧
    B.IsCovering ⟨X, 𝒰⟩}

/-- Characterization of membership in the precoverage of a big étale site. -/
public theorem mem_precoverage_iff (B : BigEtaleSite.{u}) {X : B.Scheme} {R : Presieve X} :
    R ∈ B.precoverage X ↔ ∃ 𝒰 : PreZeroHypercover.{u + 1} X, R = 𝒰.presieve₀ ∧
      B.IsCovering ⟨X, 𝒰⟩ := Iff.rfl

/-- The Grothendieck topology generated by the chosen covering families of a big étale
site. -/
public abbrev topology (B : BigEtaleSite.{u}) : GrothendieckTopology B.Scheme :=
  B.precoverage.toGrothendieck

namespace IsCovering

/-- A chosen covering family is an étale covering family. -/
public theorem etale {B : BigEtaleSite.{u}} {𝒰 : Covering B.Scheme}
    (h𝒰 : B.IsCovering 𝒰) : IsEtaleCovering 𝒰 := h𝒰.1

/-- The index type of a chosen covering family has cardinality at most the site's covering
bound. -/
public theorem mk_le {B : BigEtaleSite.{u}} {𝒰 : Covering B.Scheme}
    (h𝒰 : B.IsCovering 𝒰) : #𝒰.2.I₀ ≤ B.coveringBound := h𝒰.2

end IsCovering

end BigEtaleSite

/-! ### The big étale site of Stacks 021A -/

/-- The conditions (1)–(4) of Stacks 000J on a full subcategory `Sch` of schemes, starting from a
set `S₀` of schemes: the objects of `Sch` form a set containing `S₀`; every scheme of size at most
`Bound(size S)` for an object `S` is isomorphic to an object; and for every countable diagram
`F` in `Sch` the limit (resp. colimit) of `F` exists in `Sch` if and only if the limit (resp.
colimit) of the underlying diagram of schemes exists, in which case the inclusion preserves it,
that is, the natural morphism between the two is an isomorphism.

A countable diagram category is a category whose objects and morphism sets are countable; every
such category is equivalent to one in `Type`, which is where the diagram categories range. -/
public structure IsBigSchemeCategory (S₀ : Set Scheme.{u}) (Sch : ObjectProperty Scheme.{u}) :
    Prop where
  /-- The objects of `Sch` form a set. -/
  small : Small.{u} (Subtype Sch)
  /-- Condition (1) of Stacks 000J: `S₀` consists of objects of `Sch`. -/
  mem_of_mem : ∀ X ∈ S₀, Sch X
  /-- Condition (2) of Stacks 000J. -/
  exists_iso_of_size_le : ∀ S : Scheme.{u}, Sch S → ∀ T : Scheme.{u},
    T.size ≤ Cardinal.stacksBound S.size → ∃ S' : Scheme.{u}, Sch S' ∧ Nonempty (T ≅ S')
  /-- Condition (3) of Stacks 000J, existence: a countable limit exists in `Sch` if and only if it
  exists in the category of schemes. -/
  hasLimit_iff : ∀ (I : Type) [SmallCategory I] [CountableCategory I]
    (F : I ⥤ Sch.FullSubcategory), Limits.HasLimit F ↔ Limits.HasLimit (F ⋙ Sch.ι)
  /-- Condition (3) of Stacks 000J, comparison: the inclusion preserves countable limits. -/
  preservesLimit : ∀ (I : Type) [SmallCategory I] [CountableCategory I]
    (F : I ⥤ Sch.FullSubcategory), Limits.PreservesLimit F Sch.ι
  /-- Condition (4) of Stacks 000J, existence: a countable colimit exists in `Sch` if and only if
  it exists in the category of schemes. -/
  hasColimit_iff : ∀ (I : Type) [SmallCategory I] [CountableCategory I]
    (F : I ⥤ Sch.FullSubcategory), Limits.HasColimit F ↔ Limits.HasColimit (F ⋙ Sch.ι)
  /-- Condition (4) of Stacks 000J, comparison: the inclusion preserves countable colimits. -/
  preservesColimit : ∀ (I : Type) [SmallCategory I] [CountableCategory I]
    (F : I ⥤ Sch.FullSubcategory), Limits.PreservesColimit F Sch.ι

/-- A family of morphisms with fixed target in a full subcategory `Sch` of schemes is an étale
covering (Stacks 0215) if its image in the category of schemes is a jointly surjective family of
étale morphisms. -/
public abbrev IsEtaleCoveringIn (Sch : ObjectProperty Scheme.{u})
    (𝒰 : Covering.{u + 1, u, u} Sch.FullSubcategory) : Prop :=
  (𝒰.2.map Sch.ι).presieve₀ ∈ Scheme.etalePrecoverage (Sch.ι.obj 𝒰.1)

/-- **Stacks 021A.** A big étale site: a site `Sch_étale` in the sense of Stacks 00VH constructed
as follows.

1. A set of schemes `S₀` and a set `Cov₀` of étale coverings among these schemes.
2. As underlying category a full subcategory `Sch` of schemes as in Stacks 000J starting with
   `S₀`: the fields of `AlgebraicGeometry.IsBigSchemeCategory`.
3. A set `Cov` of coverings as in Stacks 000X starting with `Sch`, the class of étale coverings
   of `Sch` and `Cov₀`: `Cov` consists of étale coverings, contains `Cov₀`, satisfies the axioms
   of a site (Stacks 00VH), and every étale covering of `Sch` is combinatorially equivalent
   (Stacks 00VU (1)) to a member of `Cov`.

Stacks takes the objects of `Sch` to be the schemes in a stage `V_α` of the von Neumann hierarchy
and `Cov` to be the étale coverings in a stage `V_β` with index set of cardinality at most `κ`.
Lean's type theory assigns no von Neumann rank to a scheme or to a family of morphisms; what the
stages provide is that the objects and the coverings form *sets*, which is recorded here as
`Small.{u}`, `u` being the universe of the sets underlying the schemes. A family of morphisms has
its index set in `Type u`. -/
@[stacks 021A]
public structure StacksBigEtaleSite where
  /-- The chosen set of schemes. -/
  S₀ : Set Scheme.{u}
  /-- `S₀` is a set. -/
  small_S₀ : Small.{u} S₀
  /-- The chosen set of étale coverings among the schemes of `S₀`. -/
  Cov₀ : Set (Covering.{u + 1, u, u} Scheme.{u})
  /-- `Cov₀` is a set. -/
  small_Cov₀ : Small.{u} Cov₀
  /-- Every member of `Cov₀` is an étale covering. -/
  etale_of_mem_Cov₀ : ∀ 𝒰 ∈ Cov₀, 𝒰.2.presieve₀ ∈ Scheme.etalePrecoverage 𝒰.1
  /-- The target and every source of a member of `Cov₀` belong to `S₀`. -/
  mem_S₀_of_mem_Cov₀ : ∀ 𝒰 ∈ Cov₀, 𝒰.1 ∈ S₀ ∧ ∀ i, 𝒰.2.X i ∈ S₀
  /-- The underlying category, as a full subcategory of the category of schemes. -/
  Sch : ObjectProperty Scheme.{u}
  /-- The underlying category is constructed as in Stacks 000J starting with `S₀`. -/
  isBigSchemeCategory : IsBigSchemeCategory S₀ Sch
  /-- The chosen set of coverings. -/
  Cov : Set (Covering.{u + 1, u, u} Sch.FullSubcategory)
  /-- `Cov` is a set. -/
  small_Cov : Small.{u} Cov
  /-- Every member of `Cov` is an étale covering. -/
  etale_of_mem_Cov : ∀ 𝒰 ∈ Cov, IsEtaleCoveringIn Sch 𝒰
  /-- Condition (1) of Stacks 000X: `Cov₀ ⊂ Cov`. -/
  exists_mem_Cov_of_mem_Cov₀ : ∀ 𝒰 ∈ Cov₀, ∃ 𝒱 ∈ Cov,
    (⟨Sch.ι.obj 𝒱.1, 𝒱.2.map Sch.ι⟩ : Covering.{u + 1, u, u} Scheme.{u}) = 𝒰
  /-- Condition (2) of Stacks 000X: `Cov` satisfies the axioms of a site. -/
  isSite : IsSite (· ∈ Cov)
  /-- Condition (3) of Stacks 000X: every étale covering is combinatorially equivalent to a member
  of `Cov`. -/
  exists_combEquiv : ∀ 𝒰 : Covering.{u + 1, u, u} Sch.FullSubcategory, IsEtaleCoveringIn Sch 𝒰 →
    ∃ 𝒱 ∈ Cov, Covering.CombEquiv 𝒰 𝒱

namespace StacksBigEtaleSite

variable (B : StacksBigEtaleSite.{u})

/-- The chosen set of schemes is small. -/
public instance : Small.{u} B.S₀ := B.small_S₀

/-- The chosen set of initial coverings is small. -/
public instance : Small.{u} B.Cov₀ := B.small_Cov₀

/-- The chosen set of coverings is small. -/
public instance : Small.{u} B.Cov := B.small_Cov

/-- The objects of the underlying category of a big étale site form a set. -/
public instance : Small.{u} B.Sch.FullSubcategory :=
  have := B.isBigSchemeCategory.small
  small_of_injective (f := fun X : B.Sch.FullSubcategory => (⟨X.obj, X.property⟩ : Subtype B.Sch))
    fun X Y h => by
      obtain ⟨X, hX⟩ := X
      obtain ⟨Y, hY⟩ := Y
      cases congrArg Subtype.val h
      rfl

/-- The precoverage of a big étale site: the presieves of the members of `Cov`. -/
public def precoverage : Precoverage B.Sch.FullSubcategory where
  coverings X := {R | ∃ 𝒰 : PreZeroHypercover.{u} X, R = 𝒰.presieve₀ ∧ ⟨X, 𝒰⟩ ∈ B.Cov}

/-- The Grothendieck topology of a big étale site, generated by the members of `Cov`. -/
public abbrev topology : GrothendieckTopology B.Sch.FullSubcategory :=
  B.precoverage.toGrothendieck

/-- A member of `Cov` generates a covering sieve of the topology of a big étale site. -/
public theorem generate_mem_topology {𝒰 : Covering.{u + 1, u, u} B.Sch.FullSubcategory}
    (h𝒰 : 𝒰 ∈ B.Cov) : Sieve.generate 𝒰.2.presieve₀ ∈ B.topology 𝒰.1 :=
  Precoverage.generate_mem_toGrothendieck ⟨𝒰.2, rfl, h𝒰⟩

/-- Every étale covering of the underlying category of a big étale site, whether or not it
belongs to `Cov`, generates a covering sieve of its topology: it is combinatorially equivalent
to a member of `Cov`, and combinatorially equivalent families generate the same presieve. -/
public theorem generate_mem_topology_of_isEtaleCoveringIn
    {𝒰 : Covering.{u + 1, u, u} B.Sch.FullSubcategory} (h𝒰 : IsEtaleCoveringIn B.Sch 𝒰) :
    Sieve.generate 𝒰.2.presieve₀ ∈ B.topology 𝒰.1 := by
  obtain ⟨𝒱, h𝒱, h, hE⟩ := B.exists_combEquiv 𝒰 h𝒰
  obtain ⟨U, E⟩ := 𝒰
  obtain ⟨V, F⟩ := 𝒱
  obtain rfl : U = V := h
  rw [PreZeroHypercover.presieve₀_eq_of_combinatoriallyEquivalent hE]
  exact B.generate_mem_topology h𝒱

end StacksBigEtaleSite

add_to_sga "3 IV 6.3" AlgebraicGeometry.Scheme.etaleTopology
add_to_sga "4 VII 1.2" AlgebraicGeometry.Scheme.etaleTopology
add_to_sga "4 VII 1.3" AlgebraicGeometry.Scheme.etaleTopology
add_to_sga "4 XVII 0.10" "étale topology on Sch" AlgebraicGeometry.Scheme.etaleTopology

end AlgebraicGeometry
