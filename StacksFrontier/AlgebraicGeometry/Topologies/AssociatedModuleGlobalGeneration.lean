module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FiniteTypeKernel
public import StacksFrontier.AlgebraicGeometry.Topologies.AssociatedModuleFaithful
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Free

/-!
# Faithfulness of `F ↦ Fᵃ` over a base which is not assumed affine

Descent, Lemma 0GN7 asserts that `F ↦ Fᵃ` is fully faithful on quasi-coherent modules. This file
proves the faithfulness half over an arbitrary base `S`, for a source module whose pullback to an
object of the site with invertible structure morphism is **generated by global sections**, in the
sense that it admits an epimorphism from a free sheaf of modules. It also identifies the
morphisms from a free sheaf of modules on the site into `Nᵃ` with the morphisms from a free sheaf
of modules into the pullback of `N` to a terminal object of the site, naturally in `N`.

## Main results

* `SheafOfModules.hom_ext_of_app_isTerminal_of_epi_free`: on a site with a terminal object, two
  morphisms out of a sheaf of modules admitting an epimorphism from a free sheaf of modules are
  equal as soon as their components at the terminal object agree.
* `AlgebraicGeometry.Scheme.isTerminalTop`: the top open of a scheme is terminal among its opens.
* `AlgebraicGeometry.Scheme.Modules.hom_ext_of_pullback_app_top_of_epi_free`: two morphisms of
  modules on `S` whose pullbacks along an isomorphism agree on global sections are equal, the
  pullback of the source being generated by global sections.
* `Stacks.Sites.isTerminalOfIsIsoHom`: an object of a site of schemes over `S` whose structure
  morphism is invertible is terminal in the site.
* `Stacks.Sites.associatedModuleMap_injective_of_epi_free`: **the faithfulness half of Descent,
  Lemma 0GN7 over an arbitrary base**, for a source module whose pullback to an object with
  invertible structure morphism is generated by global sections.
* `SheafOfModules.freeHomEquivAppIsTerminal` and
  `AlgebraicGeometry.Scheme.Modules.freeHomEquivAppTop`: a morphism out of a free sheaf of modules
  is a family of sections over a terminal object of the site, respectively over the top open of a
  scheme.
* `Stacks.Sites.freeHomEquivSiteAssociatedModule`: morphisms from a free sheaf of modules on the
  site into `Nᵃ` and morphisms from a free sheaf of modules into the pullback of `N` to the
  underlying scheme of a terminal object are in bijection.
* `SheafOfModules.freeHomEquivAppIsTerminal_comp`,
  `AlgebraicGeometry.Scheme.Modules.freeHomEquivAppTop_comp` and
  `Stacks.Sites.freeHomEquivSiteAssociatedModule_comp`: the three Hom-bijections above are
  natural in the target.

## References

* [Stacks Project, Tag 0GN7](https://stacks.math.columbia.edu/tag/0GN7)
* [Stacks Project, Tag 03DU](https://stacks.math.columbia.edu/tag/03DU)
* [Stacks Project, Tag 03OJ](https://stacks.math.columbia.edu/tag/03OJ)
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Limits Opposite

universe v₁ u₁ u

namespace SheafOfModules

/-- **A morphism out of a sheaf of modules generated by global sections is determined by its
component at a terminal object.**  Let `e` be a terminal object of a site, let `M` be a sheaf of
modules admitting an epimorphism `π : free L ⟶ M` from a free sheaf of modules, and let
`φ, ψ : M ⟶ N`.  If `φ` and `ψ` agree at `e` then they are equal. -/
public theorem hom_ext_of_app_isTerminal_of_epi_free {C : Type u₁} [Category.{v₁} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
    [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    {e : C} (he : IsTerminal e) {M N : SheafOfModules.{u} R} {L : Type u}
    (π : SheafOfModules.free L ⟶ M) [Epi π] {φ ψ : M ⟶ N}
    (h : φ.val.app (op e) = ψ.val.app (op e)) : φ = ψ := by
  have key (s : M.sections) : sectionsMap φ s = sectionsMap ψ s := by
    refine (Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal N he).injective ?_
    change φ.val.app (op e) (s.val (op e)) = ψ.val.app (op e) (s.val (op e))
    rw [h]
  rw [← cancel_epi π]
  exact (freeHomEquiv N).injective (funext fun l => by
    rw [freeHomEquiv_comp_apply, freeHomEquiv_comp_apply, key])

/-- **A morphism out of a free sheaf of modules on a site with a terminal object is exactly a
family of sections over that object.** -/
public noncomputable def freeHomEquivAppIsTerminal {C : Type u₁} [Category.{v₁} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
    [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    {e : C} (he : IsTerminal e) (M : SheafOfModules.{u} R) (L : Type u) :
    (SheafOfModules.free L ⟶ M) ≃ (L → M.val.obj (op e)) :=
  (freeHomEquiv M).trans (Equiv.piCongrRight fun _ =>
    Stacks.SheafOfModules.FiniteTypeKernel.sectionsEquivOfTerminal M he)

/-- **`SheafOfModules.freeHomEquivAppIsTerminal` is natural in the target.**  Composing a
morphism out of a free sheaf of modules with a morphism `θ` of its target replaces the family of
sections over the terminal object by its image under the component of `θ` there. -/
public theorem freeHomEquivAppIsTerminal_comp {C : Type u₁} [Category.{v₁} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
    [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    {e : C} (he : IsTerminal e) {M N : SheafOfModules.{u} R} {L : Type u}
    (ξ : SheafOfModules.free L ⟶ M) (θ : M ⟶ N) (l : L) :
    freeHomEquivAppIsTerminal he N L (ξ ≫ θ) l =
      θ.val.app (op e) (freeHomEquivAppIsTerminal he M L ξ l) :=
  rfl

end SheafOfModules

namespace AlgebraicGeometry

/-- The top open of a scheme is a terminal object of its category of opens. -/
public def Scheme.isTerminalTop (X : Scheme.{u}) : IsTerminal (⊤ : X.Opens) :=
  IsTerminal.ofUniqueHom (fun _ => homOfLE le_top) (fun _ _ => rfl)

/-- **Two morphisms of modules on `S` whose pullbacks along an isomorphism agree on global
sections are equal**, provided the pullback of the source is generated by global sections. -/
public theorem Scheme.Modules.hom_ext_of_pullback_app_top_of_epi_free {T S : Scheme.{u}}
    (g : T ⟶ S) [IsIso g] {M N : S.Modules} {L : Type u}
    (π : SheafOfModules.free L ⟶ (Scheme.Modules.pullback g).obj M) [Epi π] {φ ψ : M ⟶ N}
    (h : ((Scheme.Modules.pullback g).map φ).val.app (op ⊤) =
      ((Scheme.Modules.pullback g).map ψ).val.app (op ⊤)) : φ = ψ :=
  Functor.map_injective (Scheme.Modules.pullback g)
    (SheafOfModules.hom_ext_of_app_isTerminal_of_epi_free (Scheme.isTerminalTop T) π h)

/-- **A morphism from a free sheaf of modules on a scheme is exactly a family of global
sections.**  This is `SheafOfModules.freeHomEquivAppIsTerminal` at the terminal open `⊤`. -/
public noncomputable def Scheme.Modules.freeHomEquivAppTop (X : Scheme.{u}) (M : X.Modules)
    (L : Type u) :
    (SheafOfModules.free L ⟶ M) ≃ (L → M.val.obj (op (⊤ : X.Opens))) :=
  SheafOfModules.freeHomEquivAppIsTerminal (Scheme.isTerminalTop X) M L

/-- **`AlgebraicGeometry.Scheme.Modules.freeHomEquivAppTop` is natural in the target.**  This is
`SheafOfModules.freeHomEquivAppIsTerminal_comp` at the terminal open `⊤`. -/
public theorem Scheme.Modules.freeHomEquivAppTop_comp {X : Scheme.{u}} {M N : X.Modules}
    (L : Type u) (ξ : SheafOfModules.free (R := X.ringCatSheaf) L ⟶ M) (θ : M ⟶ N) (l : L) :
    Scheme.Modules.freeHomEquivAppTop X N L (ξ ≫ θ) l =
      θ.app ⊤ (Scheme.Modules.freeHomEquivAppTop X M L ξ l) :=
  SheafOfModules.freeHomEquivAppIsTerminal_comp (Scheme.isTerminalTop X) ξ θ l

end AlgebraicGeometry

namespace Stacks.Sites

open _root_.AlgebraicGeometry

variable (S : Scheme.{u}) {C : Type (u + 1)} [Category.{u} C] (toOver : C ⥤ Over S)

/-- **An object of a site of schemes over `S` whose structure morphism is invertible is terminal
in the site**, provided the functor `toOver` to the schemes over `S` is fully faithful. -/
public noncomputable def isTerminalOfIsIsoHom [toOver.Full] [toOver.Faithful] (e : C)
    [IsIso (toOver.obj e).hom] : IsTerminal e := by
  refine IsTerminal.ofUniqueHom (fun X => toOver.preimage
    (Over.homMk ((toOver.obj X).hom ≫ inv (toOver.obj e).hom) (by simp))) ?_
  intro X m
  refine toOver.map_injective ?_
  rw [toOver.map_preimage]
  ext
  change (toOver.map m).left = (toOver.obj X).hom ≫ inv (toOver.obj e).hom
  rw [← Over.w (toOver.map m), Category.assoc, IsIso.hom_inv_id, Category.comp_id]

/-- **The faithfulness half of Descent, Lemma 0GN7 over an arbitrary base.**  Let `toOver` present
a category of schemes over `S` containing an object `X₀` whose structure morphism to `S` is
invertible, and let `M`, `N` be quasi-coherent modules on `S` such that the pullback of `M` to
`X₀` is generated by global sections.  Then a morphism `M ⟶ N` is determined by the induced map
of associated presheaves of modules. -/
public theorem associatedModuleMap_injective_of_epi_free
    {M N : S.Modules} [M.IsQuasicoherent] [N.IsQuasicoherent]
    (X₀ : C) [IsIso (toOver.obj X₀).hom] {L : Type u}
    (π : SheafOfModules.free L ⟶
      (Scheme.Modules.pullback (toOver.obj X₀).hom).obj M) [Epi π] :
    Function.Injective fun φ : M ⟶ N => associatedModuleMap S toOver φ := fun _ _ h =>
  Scheme.Modules.hom_ext_of_pullback_app_top_of_epi_free (toOver.obj X₀).hom π
    (congrArg (fun a : associatedModulePresheaf S M toOver ⟶
      associatedModulePresheaf S N toOver => a.app (op X₀)) h)

/-- **The two Hom-sets out of a free module agree**: morphisms of `𝒪`-modules on the site from a
free sheaf of modules into `Nᵃ` are morphisms from the free sheaf of modules into the pullback of
`N` to the underlying scheme of a terminal object of the site. Both are identified with the
families of sections of that pullback over the terminal object. -/
public noncomputable def freeHomEquivSiteAssociatedModule
    (N : S.Modules) [N.IsQuasicoherent] (J : GrothendieckTopology C)
    (hR : Presheaf.IsSheaf J (structurePresheaf S toOver))
    (hM : Presheaf.IsSheaf J (associatedPresheaf S N toOver))
    [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    {e : C} (he : IsTerminal e) (L : Type u) :
    (SheafOfModules.free L ⟶ siteAssociatedModule S N toOver J hR hM) ≃
      (SheafOfModules.free L ⟶ (Scheme.Modules.pullback (toOver.obj e).hom).obj N) :=
  (SheafOfModules.freeHomEquivAppIsTerminal he _ L).trans
    (Scheme.Modules.freeHomEquivAppTop _ _ L).symm

/-- `Stacks.Sites.freeHomEquivSiteAssociatedModule`, written as the composite of its two halves. -/
public theorem freeHomEquivSiteAssociatedModule_apply
    (N : S.Modules) [N.IsQuasicoherent] (J : GrothendieckTopology C)
    (hR : Presheaf.IsSheaf J (structurePresheaf S toOver))
    (hM : Presheaf.IsSheaf J (associatedPresheaf S N toOver))
    [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    {e : C} (he : IsTerminal e) (L : Type u)
    (ξ : SheafOfModules.free L ⟶ siteAssociatedModule S N toOver J hR hM) :
    freeHomEquivSiteAssociatedModule S toOver N J hR hM he L ξ =
      (Scheme.Modules.freeHomEquivAppTop ((toOver.obj e).left)
          ((Scheme.Modules.pullback (toOver.obj e).hom).obj N) L).symm
        (SheafOfModules.freeHomEquivAppIsTerminal he _ L ξ) :=
  rfl

/-- **The Hom-bijection of the free-source case of Descent, Lemma 0GN7 is natural in the
module.**  Let `θ : Nᵃ ⟶ N'ᵃ` be a morphism of sheaves of modules on the site whose component at
a terminal object `e` is the map on global sections of a morphism
`χ : (toOver.obj e).hom⁺ N ⟶ (toOver.obj e).hom⁺ N'` downstairs.  Then composing with `θ`
upstairs corresponds to composing with `χ` downstairs. -/
public theorem freeHomEquivSiteAssociatedModule_comp
    {N N' : S.Modules} [N.IsQuasicoherent] [N'.IsQuasicoherent] (J : GrothendieckTopology C)
    (hR : Presheaf.IsSheaf J (structurePresheaf S toOver))
    (hM : Presheaf.IsSheaf J (associatedPresheaf S N toOver))
    (hM' : Presheaf.IsSheaf J (associatedPresheaf S N' toOver))
    [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    {e : C} (he : IsTerminal e) (L : Type u)
    (θ : siteAssociatedModule S N toOver J hR hM ⟶ siteAssociatedModule S N' toOver J hR hM')
    (χ : (Scheme.Modules.pullback (toOver.obj e).hom).obj N ⟶
      (Scheme.Modules.pullback (toOver.obj e).hom).obj N')
    (h : ∀ x : (siteAssociatedModule S N toOver J hR hM).val.obj (op e),
      θ.val.app (op e) x = χ.app ⊤ x)
    (ξ : SheafOfModules.free L ⟶ siteAssociatedModule S N toOver J hR hM) :
    freeHomEquivSiteAssociatedModule S toOver N' J hR hM' he L (ξ ≫ θ) =
      freeHomEquivSiteAssociatedModule S toOver N J hR hM he L ξ ≫ χ := by
  rw [freeHomEquivSiteAssociatedModule_apply, freeHomEquivSiteAssociatedModule_apply]
  refine (Equiv.symm_apply_eq _).2 (funext fun l => ?_)
  rw [Scheme.Modules.freeHomEquivAppTop_comp]
  refine (SheafOfModules.freeHomEquivAppIsTerminal_comp he ξ θ l).trans
    ((h _).trans (congrArg (fun z => χ.app ⊤ z) ?_))
  exact congrFun (Equiv.apply_symm_apply _ _).symm l

end Stacks.Sites

end
