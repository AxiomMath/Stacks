-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite
open scoped AlgebraicGeometry TensorProduct ChangeOfRings
open Scheme.Modules

universe w v' u' u

namespace Stacks.Sites

open Stacks.AlgebraicGeometry.SectionsColimit

/-- The map on global sections attached to a morphism of schemes `j` and a comparison
`j⁺ M ⟶ N` is semilinear over `j` on global functions: it is the global-sections component of a
morphism of sheaves of modules into a direct image. -/
theorem topUnitMap_smul {T₁ T₂ : Scheme.{u}} (j : T₁ ⟶ T₂) {M : T₂.Modules} {N : T₁.Modules}
    (a : (pullback j).obj M ⟶ N) (r : Γ(T₂, ⊤)) (x : ToType Γ(M, ⊤)) :
    topUnitMap j a (r • x) = (j.appTop r) • topUnitMap j a x :=
  (Scheme.Modules.Hom.app_smul
      ((pullbackPushforwardAdjunction j).unit.app M ≫ (pushforward j).map a) (U := ⊤) r x).trans
    (pushforward_app_smul j N ⊤ r _).symm

section SieveReduction

variable {C : Type u'} [Category.{v'} C] {Y : C}

/-- **The sieve reduction for a single morphism.**  The sieve of `CategoryTheory.Over Y`
corresponding to the sieve of `Y` generated by a morphism `f : X ⟶ Y` is the sieve generated by
the single morphism `Over.mk f ⟶ Over.mk (𝟙 Y)` into the terminal object.

A morphism `g : A ⟶ Over.mk (𝟙 Y)` has `g.left = A.hom`, so a factorisation of `A.hom` through
`f` in `C` is the same thing as a morphism `A ⟶ Over.mk f` over `Y`. -/
theorem overEquiv_symm_generate_singleton {X : C} (f : X ⟶ Y) :
    (Sieve.overEquiv (Over.mk (𝟙 Y) : Over Y)).symm
        (Sieve.generate (Presieve.singleton f)) =
      Sieve.generate (Presieve.singleton
        (Over.homMk f (by simp) : Over.mk f ⟶ Over.mk (𝟙 Y))) := by
  apply le_antisymm
  · rintro A g hg
    rw [Sieve.overEquiv_symm_iff] at hg
    obtain ⟨Z, a, b, hb, hab⟩ := hg
    cases hb
    have hA : a ≫ f = A.hom := by
      rw [hab]
      simpa using Over.w g
    exact ⟨_, Over.homMk a hA, _, Presieve.singleton.mk, by
      apply Over.OverMorphism.ext
      simpa using hab⟩
  · rintro A g ⟨Z, a, b, hb, hab⟩
    cases hb
    rw [Sieve.overEquiv_symm_iff, ← hab]
    exact ⟨_, a.left, f, Presieve.singleton.mk, rfl⟩

/-- **The sheaf condition for the sieve of Tag 03DT's affine half is a one-morphism sheaf
condition.**  Combined with `CategoryTheory.Presieve.isSheafFor_singleton` this turns the
hypothesis `haff` of
`Stacks.Sites.isSheaf_fpqcTopology_over_quasiCoherentPresheaf_of_affine_base` into a statement
about a single morphism of `CategoryTheory.Over Y` and an arbitrary test object. -/
theorem isSheafFor_overEquiv_symm_generate_singleton_iff (P : (Over Y)ᵒᵖ ⥤ Type w) {X : C}
    (f : X ⟶ Y) :
    Presieve.IsSheafFor P ((Sieve.overEquiv (Over.mk (𝟙 Y) : Over Y)).symm
        (Sieve.generate (Presieve.singleton f))).arrows ↔
      Presieve.IsSheafFor P (Presieve.singleton
        (Over.homMk f (by simp) : Over.mk f ⟶ Over.mk (𝟙 Y))) := by
  rw [overEquiv_symm_generate_singleton f, ← Presieve.isSheafFor_iff_generate]

end SieveReduction

section Generators

variable {R T W : CommRingCat.{u}}

/-- **The comparison of Tag 03DT's affine half takes the canonical generator to the canonical
generator.**  For a quasi-coherent module `F` on `Spec R`, a ring map `ψ : R ⟶ T` and a
factorisation `ψ ≫ α = χ`, the canonical map on sections to `Spec T` followed by the restriction
map of the presheaf of Tag 03DS along `Spec α` carries `m : Γ(F, ⊤)` to `1 ⊗ m` in
`W ⊗_R Γ(F, ⊤)`.

This is `Stacks.Sites.sectionsPullbackIso_specSectionsMap` transported along
`Stacks.Sites.pullbackSectionsMap_sectionsPullbackMap`: both canonical maps on sections are the
unit of the pullback--pushforward adjunction, so composing them along `Spec α` gives the canonical
map on sections along the composite. -/
theorem sectionsPullbackIso_pullbackSectionsMap_specSectionsMap (ψ : R ⟶ T) (α : T ⟶ W)
    (χ : R ⟶ W) (h : ψ ≫ α = χ) (F : (Spec R).Modules) [F.IsQuasicoherent]
    (m : ToType (moduleSpecΓFunctor.obj F)) :
    (sectionsPullbackIso χ F).hom
        (pullbackSectionsMap F (specOverMap ψ α χ h) (specSectionsMap ψ F m)) =
      (1 : W) ⊗ₜ[(R : Type u), χ.hom] m := by
  have hps := pullbackSectionsMap_sectionsPullbackMap F
    (A := specOver χ) (B := specOver ψ) (specOverMap ψ α χ h) m
  rw [show specSectionsMap ψ F m = sectionsPullbackMap (specOver ψ).hom F m from rfl, hps]
  exact sectionsPullbackIso_specSectionsMap χ F m

end Generators

end Stacks.Sites

end
