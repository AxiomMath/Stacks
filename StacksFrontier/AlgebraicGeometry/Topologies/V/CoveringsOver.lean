module

public import StacksFrontier.AlgebraicGeometry.Topologies.ExtendingFunctors
public import StacksFrontier.AlgebraicGeometry.Topologies.HTopology.Refinement
public import StacksFrontier.AlgebraicGeometry.Topologies.StandardPhRefinement
public import StacksFrontier.AlgebraicGeometry.Topologies.V.PhComparison
public import StacksCore.Tactic.StacksAttribute

/-!
# V coverings of the schemes over a base

Let `S` be a scheme.  A family of morphisms of `Sch/S` is a V covering when the underlying family
of morphisms of schemes is one, and a functor on `Sch/S` is a V sheaf when it satisfies the sheaf
condition for every such family.  This is the V analogue of the h vocabulary of
`StacksFrontier/AlgebraicGeometry/Topologies/HTopology/ExtendingFunctors.lean`, and it is what the
relative form of Stacks 0EVQ is stated in.

No geometry is added by passing to the slice: every object and every morphism occurring in a
covering of an object `Y` of `Sch/S` lies over `Y`, hence over `S`, so a covering family of
schemes over `Y.left` lifts to a covering family of `Sch/S` and the two notions of covering
determine each other.  That lifting, `AlgebraicGeometry.ExtendingFunctors.overLift`, is how the
coverings produced by the absolute theory enter the slice; it generalizes
`AlgebraicGeometry.ExtendingFunctors.overOpen`, the open subobjects of an object of `Sch/S`.

## Main definitions

* `AlgebraicGeometry.ExtendingFunctors.overLift`: the object of `Sch/S` attached to a morphism of
  schemes into the underlying scheme of an object of `Sch/S`.
* `AlgebraicGeometry.ExtendingFunctors.IsVCoveringOver`: a family of morphisms of `Sch/S` whose
  underlying family of morphisms of schemes is a V covering.
* `AlgebraicGeometry.ExtendingFunctors.IsVSheafOver`: the sheaf condition for every V covering of
  every object of `Sch/S`.

## Main results

* `AlgebraicGeometry.IsVCovering.of_iso`: a V covering stays one after replacing each source by an
  isomorphic scheme.
* `AlgebraicGeometry.ExtendingFunctors.isVCoveringOver_overLiftι`: a V covering of the underlying
  scheme of an object of `Sch/S` lifts to a V covering of that object.
* `AlgebraicGeometry.ExtendingFunctors.isVCoveringOver_openCover`: an open covering of the
  underlying scheme of an object of `Sch/S` lifts to a V covering of that object.
* `AlgebraicGeometry.ExtendingFunctors.IsVSheafOver.ulift`: the V sheaf condition does not depend
  on the universe of the index type of the coverings it is tested at, a family and its universe
  lift generating the same presieve.

## References

* [Stacks Project, Tag 0ETH](https://stacks.math.columbia.edu/tag/0ETH)
* [Stacks Project, Tag 0ETL](https://stacks.math.columbia.edu/tag/0ETL)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry

universe w u v

/-- The presieve generated by a family of morphisms does not change when the family is reindexed
by the universe lift of its index type: the two families consist of the same arrows. -/
theorem Presieve.ofArrows_ulift {C : Type*} [Category C] {X : C} {ι : Type v} (Y : ι → C)
    (f : ∀ i, Y i ⟶ X) :
    Presieve.ofArrows (fun j : ULift.{w} ι ↦ Y j.down) (fun j ↦ f j.down) =
      Presieve.ofArrows Y f := by
  funext Z
  ext g
  constructor
  · rintro ⟨j⟩
    exact .mk j.down
  · rintro ⟨i⟩
    exact .mk (ULift.up i)

/-- A V covering remains a V covering when its index type is replaced by its universe lift: the
family of arrows is unchanged. -/
theorem IsVCovering.ulift {T : Scheme.{u}} {ι : Type v} {X : ι → Scheme.{u}}
    {f : ∀ i, X i ⟶ T} (hf : IsVCovering X f) :
    IsVCovering (fun j : ULift.{w} ι ↦ X j.down) (fun j ↦ f j.down) := by
  intro U hU
  obtain ⟨𝒰, hfinite, haffine, hstandard, ⟨s⟩⟩ := hf U hU
  exact ⟨𝒰, hfinite, haffine, hstandard,
    ⟨{ s₀ := fun i ↦ ULift.up (s.s₀ i), h₀ := s.h₀, w₀ := s.w₀ }⟩⟩

/-- A V covering remains a V covering when each of its sources is replaced by an isomorphic
scheme and each of its members is precomposed with that isomorphism. -/
theorem IsVCovering.of_iso {T : Scheme.{u}} {I : Type v} {X X' : I → Scheme.{u}}
    {f : ∀ i, X i ⟶ T} {f' : ∀ i, X' i ⟶ T} (hf : IsVCovering X f)
    (e : ∀ i, X' i ≅ X i) (he : ∀ i, (e i).hom ≫ f i = f' i) :
    IsVCovering X' f' := by
  intro U hU
  obtain ⟨𝒰, hfinite, haffine, hstandard, ⟨s⟩⟩ := hf U hU
  let r : ({ I₀ := I, X := X, f := f } : PreZeroHypercover.{v} T).Hom
      ({ I₀ := I, X := X', f := f' } : PreZeroHypercover.{v} T) :=
    { s₀ := fun i ↦ i
      h₀ := fun i ↦ (e i).inv
      w₀ := fun i ↦ (congrArg (fun k ↦ (e i).inv ≫ k) (he i).symm).trans
        (Iso.inv_hom_id_assoc (e i) (f i)) }
  exact ⟨𝒰, hfinite, haffine, hstandard, ⟨s.comp (r.pullback₂ U.ι)⟩⟩

namespace ExtendingFunctors

variable {S : Scheme.{u}}

/-! ### Objects of `Sch/S` lying over an object of `Sch/S` -/

/-- The object of `Sch/S` attached to a morphism of schemes into the underlying scheme of an
object `X` of `Sch/S`: its structure morphism is the composite with that of `X`.

For the inclusion of an open subscheme this is
`AlgebraicGeometry.ExtendingFunctors.overOpen`. -/
@[implicit_reducible]
def overLift (X : Over S) {W : Scheme.{u}} (w : W ⟶ X.left) : Over S := Over.mk (w ≫ X.hom)

/-- The underlying scheme of `overLift X w` is the source of `w`. -/
@[simp]
lemma overLift_left (X : Over S) {W : Scheme.{u}} (w : W ⟶ X.left) :
    (overLift X w).left = W := rfl

/-- The structure morphism of `overLift X w` is `w` followed by the structure morphism of `X`. -/
@[simp]
lemma overLift_hom (X : Over S) {W : Scheme.{u}} (w : W ⟶ X.left) :
    (overLift X w).hom = w ≫ X.hom := rfl

/-- A morphism of schemes into the underlying scheme of an object `X` of `Sch/S`, read as a
morphism of `Sch/S` with target `X`. -/
@[implicit_reducible]
def overLiftι (X : Over S) {W : Scheme.{u}} (w : W ⟶ X.left) : overLift X w ⟶ X := Over.homMk w

/-- The underlying morphism of schemes of `overLiftι X w` is `w`. -/
@[simp]
lemma overLiftι_left (X : Over S) {W : Scheme.{u}} (w : W ⟶ X.left) :
    (overLiftι X w).left = w := rfl

/-- An object of `Sch/S` over `X` is the object attached to the underlying morphism of schemes of
its structure morphism over `X`. -/
@[simps!]
def overLiftIso {X Z : Over S} (g : Z ⟶ X) : overLift X g.left ≅ Z :=
  Over.isoMk (Iso.refl _) (by simp)

/-! ### V coverings of `Sch/S` -/

/-- A family of morphisms of `Sch/S` is a **V covering** when the underlying family of morphisms
of schemes is one. -/
def IsVCoveringOver {X : Over S} {ι : Type v} {Y : ι → Over S} (f : ∀ i, Y i ⟶ X) : Prop :=
  IsVCovering (fun i ↦ (Y i).left) (fun i ↦ (f i).left)

/-- **The V sheaf condition on `Sch/S`.** A functor on `Sch/S` satisfies the sheaf condition for
every V covering `{Y i ⟶ X}` of every object of `Sch/S`.

This is the conclusion of the relative form of Stacks 0EVQ, and the analogue for the V topology
of `AlgebraicGeometry.ExtendingFunctors.IsHSheaf`. -/
def IsVSheafOver (G : (Over S)ᵒᵖ ⥤ Type w) : Prop :=
  ∀ {ι : Type v} (X : Over S) (Y : ι → Over S) (f : ∀ i, Y i ⟶ X),
    IsVCoveringOver f → (Presieve.ofArrows Y f).IsSheafFor G

/-- A V covering of the underlying scheme of an object of `Sch/S` lifts to a V covering of that
object: the underlying family of the lifted family is the given one. -/
theorem isVCoveringOver_overLiftι {X : Over S} {ι : Type v} {Z : ι → Scheme.{u}}
    (g : ∀ i, Z i ⟶ X.left) (hg : IsVCovering Z g) :
    IsVCoveringOver (fun i ↦ overLiftι X (g i)) := hg

/-- An open covering of the underlying scheme of an object of `Sch/S` lifts to a V covering of
that object: an open covering is a ph covering and a ph covering is a V covering. -/
theorem isVCoveringOver_openCover {X : Over S} (𝒰 : X.left.OpenCover.{v}) :
    IsVCoveringOver (fun i ↦ overLiftι X (𝒰.f i)) :=
  isVCovering_of_isPHCovering 𝒰.X 𝒰.f (IsPHCovering.of_openCover 𝒰)

/-- A V covering of `Sch/S` remains one when its index type is replaced by its universe lift. -/
theorem IsVCoveringOver.ulift {X : Over S} {ι : Type v} {Y : ι → Over S} {f : ∀ i, Y i ⟶ X}
    (hf : IsVCoveringOver f) : IsVCoveringOver (fun j : ULift.{w} ι ↦ f j.down) :=
  IsVCovering.ulift hf

/-- **The V sheaf condition is insensitive to the universe of the index type.** A functor on
`Sch/S` satisfying the sheaf condition for the V coverings indexed in `Type (max u v)` satisfies
it for the V coverings indexed in `Type v`: such a family generates the same presieve as its
universe lift, and the sheaf condition depends only on the presieve. -/
theorem IsVSheafOver.ulift {G : (Over S)ᵒᵖ ⥤ Type w} (h : IsVSheafOver.{w, u, max u v} G) :
    IsVSheafOver.{w, u, v} G := by
  intro ι X Y f hf
  have hlift := h X (fun j : ULift.{u} ι ↦ Y j.down) (fun j ↦ f j.down) hf.ulift
  rwa [Presieve.ofArrows_ulift] at hlift

/-- A V covering of `Sch/S` by objects isomorphic to the members of a V covering is a V
covering. -/
theorem IsVCoveringOver.of_iso {X : Over S} {ι : Type v} {Y Y' : ι → Over S}
    {f : ∀ i, Y i ⟶ X} {f' : ∀ i, Y' i ⟶ X} (hf : IsVCoveringOver f)
    (e : ∀ i, Y' i ≅ Y i) (he : ∀ i, (e i).hom ≫ f i = f' i) :
    IsVCoveringOver f' :=
  IsVCovering.of_iso hf (fun i ↦ (Over.forget S).mapIso (e i))
    fun i ↦ (Over.forget S).congr_map (he i)

end ExtendingFunctors

end AlgebraicGeometry
