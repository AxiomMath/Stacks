/-!
# Big fppf sites

A *standard fppf covering* of an affine scheme is a finite family of flat, finitely
presented morphisms from affine schemes whose images cover the target.

A *big fppf site* consists of a size-bounded full subcategory of schemes and a set-sized system of
fppf covering families on it. The system contains prescribed initial schemes and coverings,
satisfies the site axioms, and contains a combinatorial representative of every fppf covering. The
category `Sch_κ` is `AlgebraicGeometry.SchemeBelow`, the full subcategory of schemes `X` with
`X.size < κ`, and the fields on `κ` are the size-cutoff conditions of Stacks 000J. The chosen
coverings are `CovBounded` applied to the pullback of Mathlib's
`AlgebraicGeometry.Scheme.fppfPrecoverage` along the full-subcategory inclusion. The remaining
fields are the conclusions of Stacks 000X, including the chosen limit ordinal and combinatorial
completeness. The associated Grothendieck topology is generated from the chosen families, while
`AlgebraicGeometry.BigFppfSite.IsCovering` retains the family-level data, including repetitions.

For a big fppf site containing `S`, the big fppf site *of* `S` is its slice over `S`,
formed with Mathlib's canonical topology on a slice; covering families in the slice retain
the chosen family-level covering system of the big site. The big affine fppf site is the
full subcategory of this slice on objects with affine underlying scheme, so no separate
morphisms or coherence choices are required. Its covering families are exactly the
standard fppf coverings which are coverings in the big site, and its topology is generated
by precisely these families.

## Main definitions

* `AlgebraicGeometry.IsStandardFppfCovering`: a standard fppf covering of an affine scheme.
* `AlgebraicGeometry.BigFppfSite`: a big fppf site, with all the choices in its construction.
* `AlgebraicGeometry.BigFppfSite.topology`: the Grothendieck topology generated by the chosen
  covering families of a big fppf site.
* `AlgebraicGeometry.BigFppfOver`: the underlying category of the big fppf site of `S`, with
  covering families `AlgebraicGeometry.BigFppfOver.IsCovering` and topology
  `AlgebraicGeometry.BigFppfOver.topology`.
* `AlgebraicGeometry.BigAffineFppf`: the big affine fppf site of `S`, with covering families
  `AlgebraicGeometry.BigAffineFppf.IsCovering` and topology
  `AlgebraicGeometry.BigAffineFppf.topology`.

## Main results

* `AlgebraicGeometry.BigFppfSite.isSite`: the chosen covering families of a big fppf site
  satisfy the site axioms.
* `AlgebraicGeometry.BigFppfSite.residueField_spec_contains`: the spectrum of a residue field
  of a scheme in a big fppf site is in the site.

## References

* [Stacks Project, Tag 021Q](https://stacks.math.columbia.edu/tag/021Q)
* [Stacks Project, Tag 021R](https://stacks.math.columbia.edu/tag/021R)
* [Stacks Project, Tag 021S](https://stacks.math.columbia.edu/tag/021S)
-/

@[expose] public section

open Cardinal CategoryTheory

universe u v

namespace AlgebraicGeometry

/-! ### Standard fppf coverings -/

/-- A family `fᵢ : Uᵢ ⟶ T` is a **standard fppf covering** if it is finite, its
source and target schemes are affine, every `fᵢ` is flat and of finite presentation,
and the images of the `fᵢ` cover `T`. -/
@[stacks 021Q]
public structure IsStandardFppfCovering {T : Scheme.{u}} {I : Type v}
    (U : I → Scheme.{u}) (f : ∀ i, U i ⟶ T) : Prop where
  /-- The family has finitely many members. -/
  finite_index : Finite I
  /-- The target of the covering is affine. -/
  affine_target : IsAffine T
  /-- Every source scheme in the covering is affine. -/
  affine_source : ∀ i, IsAffine (U i)
  /-- Every morphism in the covering is flat. -/
  flat : ∀ i, Flat (f i)
  /-- Every morphism in the covering is of finite presentation. -/
  finite_presentation : ∀ i, FinitePresentation (f i)
  /-- The images of the morphisms cover the target. -/
  jointly_surjective : (⋃ i, Set.range (f i)) = Set.univ

/-! ### Big fppf sites -/

/-- An indexed family in `Sch_κ` is fppf covering when its image in schemes belongs to
Mathlib's fppf precoverage. -/
def IsFppfCovering {κ : Cardinal.{u}} (E : Covering.{u + 1, u, u + 1} (SchemeBelow κ)) : Prop :=
  E.2.presieve₀ ∈ Scheme.fppfPrecoverage.comap (schemeBelowInclusion κ) E.1

/-- A covering of `Sch_κ` is supported on `S₀` when its target and all its source schemes
belong to `S₀`. -/
def CoveringSupportedOn {κ : Cardinal.{u}} (S₀ : Set Scheme.{u})
    (E : Covering.{u + 1, u, u + 1} (SchemeBelow κ)) : Prop :=
  E.1.1 ∈ S₀ ∧ ∀ i, (E.2.X i).1 ∈ S₀

/-- A big fppf site, retaining all choices in the construction: the initial set of schemes
and coverings, the size cutoff defining its underlying full subcategory, and the bounded family
of fppf coverings of Stacks 000X. -/
@[stacks 021R]
structure BigFppfSite where
  /-- The initially prescribed set of schemes. -/
  initialSchemes : Set Scheme.{u}
  /-- The initial collection of schemes is set-sized in the working universe. -/
  initialSchemes_small : Small.{u} initialSchemes
  /-- The cardinal defining the full subcategory `Sch_κ`. -/
  cutoff : Cardinal.{u}
  /-- The cutoff is uncountable. -/
  aleph0_lt_cutoff : ℵ₀ < cutoff
  /-- The cutoff is a strong prelimit cardinal, hence is closed under the size bounds used
  in the construction of schemes. -/
  cutoff_isStrongPrelimit : Cardinal.IsStrongPrelimit cutoff
  /-- The cutoff has uncountable cofinality. -/
  aleph0_lt_cutoff_cof : ℵ₀ < cutoff.ord.cof
  /-- Every initially prescribed scheme belongs to `Sch_κ`. -/
  initialSchemes_mem : ∀ X ∈ initialSchemes, X.size < cutoff
  /-- The initially prescribed fppf covering families, regarded in `Sch_κ`. -/
  initialCoverings : Set (Covering (SchemeBelow cutoff))
  /-- The initial collection of coverings is set-sized. -/
  initialCoverings_small : Small.{u + 1} initialCoverings
  /-- Every object occurring in an initial covering belongs to the initial set of
  schemes. -/
  initialCoverings_supported :
    ∀ E ∈ initialCoverings, CoveringSupportedOn initialSchemes E
  /-- The cardinal bounding the index types of the chosen covering families. -/
  coveringBound : Cardinal.{u + 1}
  /-- The limit ordinal chosen in the set-sized covering construction. -/
  coveringOrdinal : Ordinal.{u + 1}
  /-- The chosen ordinal is a limit ordinal. -/
  coveringOrdinal_isSuccLimit : Order.IsSuccLimit coveringOrdinal
  /-- Every initial covering belongs to the chosen bounded fppf system. -/
  initialCoverings_mem : ∀ E ∈ initialCoverings,
    CovBounded (IsFppfCovering (κ := cutoff)) coveringBound E
  /-- The chosen bounded fppf covering families satisfy the site axioms. -/
  coverings_isSite : IsSite (CovBounded (IsFppfCovering (κ := cutoff)) coveringBound)
  /-- Every fppf covering is combinatorially equivalent to a chosen bounded one. -/
  fppf_has_representative : ∀ E : Covering (SchemeBelow cutoff), IsFppfCovering E →
    ∃ E' : Covering (SchemeBelow cutoff),
      CovBounded (IsFppfCovering (κ := cutoff)) coveringBound E' ∧ Covering.CombEquiv E E'

namespace BigFppfSite

/-- The underlying category `Sch_κ` of a big fppf site. -/
abbrev Schemes (B : BigFppfSite.{u}) := SchemeBelow B.cutoff

/-- The canonical functor from a big fppf site's underlying category to all schemes. -/
abbrev inclusion (B : BigFppfSite.{u}) : B.Schemes ⥤ Scheme.{u} :=
  schemeBelowInclusion B.cutoff

/-- The canonical inclusion of a big fppf site is full. -/
instance (B : BigFppfSite.{u}) : B.inclusion.Full :=
  ObjectProperty.full_ι (schemeSizeBelow B.cutoff)

/-- The canonical inclusion of a big fppf site is faithful. -/
instance (B : BigFppfSite.{u}) : B.inclusion.Faithful :=
  ObjectProperty.faithful_ι (schemeSizeBelow B.cutoff)

/-- The selected covering families of a big fppf site. -/
def IsCovering (B : BigFppfSite.{u}) (E : Covering B.Schemes) : Prop :=
  CovBounded (IsFppfCovering (κ := B.cutoff)) B.coveringBound E

/-- A selected covering family is fppf. -/
lemma isFppfCovering_of_isCovering (B : BigFppfSite.{u}) {E : Covering B.Schemes}
    (hE : B.IsCovering E) : IsFppfCovering E := hE.1

/-- The index type of a selected covering family satisfies the site's chosen bound. -/
lemma card_le_of_isCovering (B : BigFppfSite.{u}) {E : Covering B.Schemes}
    (hE : B.IsCovering E) : #E.2.I₀ ≤ B.coveringBound := hE.2

/-- The selected covering families satisfy the site axioms. -/
lemma isSite (B : BigFppfSite.{u}) : IsSite B.IsCovering := B.coverings_isSite

/-- The precoverage whose covering presieves are represented by the selected covering
families. -/
def precoverage (B : BigFppfSite.{u}) : Precoverage B.Schemes where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X, R = E.presieve₀ ∧
    B.IsCovering ⟨X, E⟩}

/-- The Grothendieck topology generated by the selected fppf covering families. -/
abbrev topology (B : BigFppfSite.{u}) : GrothendieckTopology B.Schemes :=
  B.precoverage.toGrothendieck

/-- A scheme is contained in a big fppf site precisely when it satisfies the site's size
cutoff. -/
abbrev Contains (B : BigFppfSite.{u}) (X : Scheme.{u}) : Prop := X.size < B.cutoff

/-- The spectrum of a residue field of a scheme contained in a big fppf site is contained in
it. -/
theorem residueField_spec_contains (B : BigFppfSite.{u})
    {X : Scheme.{u}} (hX : B.Contains X) (x : X) :
    B.Contains (Spec (.of (X.residueField x))) :=
  lt_of_le_of_lt
    (Scheme.size_le_of_mono_quasiCompact (X.fromSpecResidueField x)) hX

/-- Regard a scheme contained in a big fppf site as an object of its underlying
category. -/
@[implicit_reducible]
def obj (B : BigFppfSite.{u}) {X : Scheme.{u}} (hX : B.Contains X) : B.Schemes := ⟨X, hX⟩

/-- An initial covering is fppf. -/
lemma initialCoverings_fppf (B : BigFppfSite.{u}) (E : Covering B.Schemes)
    (hE : E ∈ B.initialCoverings) : IsFppfCovering E := (B.initialCoverings_mem E hE).1

/-- The index type of an initial covering satisfies the chosen bound. -/
lemma initialCoverings_card (B : BigFppfSite.{u}) (E : Covering B.Schemes)
    (hE : E ∈ B.initialCoverings) : #E.2.I₀ ≤ B.coveringBound :=
  (B.initialCoverings_mem E hE).2

end BigFppfSite

add_to_stacks 021R AlgebraicGeometry.SchemeBelow
add_to_stacks 021R AlgebraicGeometry.schemeBelowInclusion

/-! ### The big and big affine fppf sites of a scheme -/

section Over

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The big fppf category over `S`: the slice of the chosen big fppf category over its
object `S`. -/
@[stacks 021S "part (1), category", sga "4 XVII 0.10" "big fppf site"]
public abbrev BigFppfOver := Over (B.obj hS)

namespace BigFppfOver

/-- Forget the structure morphism to `S`. -/
public abbrev forget : BigFppfOver B S hS ⥤ B.Schemes :=
  Over.forget (B.obj hS)

/-- The canonical functor from the big fppf category over `S` to schemes. -/
public abbrev toScheme : BigFppfOver B S hS ⥤ Scheme.{u} :=
  forget B S hS ⋙ B.inclusion

/-- A family in the slice covers when its underlying family covers in the chosen big fppf
site. -/
@[stacks 021S "part (1), coverings"]
public abbrev IsCovering (E : Covering (BigFppfOver B S hS)) : Prop :=
  B.IsCovering ⟨(forget B S hS).obj E.1, E.2.map (forget B S hS)⟩

/-- The canonical localization of the big fppf site's Grothendieck topology at `S`. -/
public abbrev topology : GrothendieckTopology (BigFppfOver B S hS) :=
  B.topology.over (B.obj hS)

end BigFppfOver

/-- A scheme over `S` that belongs to the big fppf site, viewed as an object of the big fppf
category over `S`. -/
public abbrev siteObject {T : Scheme.{u}} (hT : B.Contains T) (b : T ⟶ S) :
    BigFppfOver B S hS :=
  Over.mk (ObjectProperty.homMk b : B.obj hT ⟶ B.obj hS)

/-- The property of an object of the big fppf category over `S` that its underlying
scheme is affine. -/
public abbrev IsAffineOver : ObjectProperty (BigFppfOver B S hS) :=
  fun X ↦ IsAffine ((BigFppfOver.toScheme B S hS).obj X)

/-- The big affine fppf category over `S`: the full subcategory of the big fppf category over
`S` on objects with affine underlying scheme. -/
@[stacks 021S "part (2), category"]
public abbrev BigAffineFppf := (IsAffineOver B S hS).FullSubcategory

namespace BigAffineFppf

/-- The canonical full embedding into the big fppf category over `S`. -/
public abbrev inclusion : BigAffineFppf B S hS ⥤ BigFppfOver B S hS :=
  (IsAffineOver B S hS).ι

/-- The canonical functor from the big affine fppf category over `S` to schemes. -/
public abbrev toScheme : BigAffineFppf B S hS ⥤ Scheme.{u} :=
  inclusion B S hS ⋙ BigFppfOver.toScheme B S hS

/-- The underlying scheme of an object of the big affine fppf category is affine. -/
public instance isAffine_toScheme_obj (X : BigAffineFppf B S hS) :
    IsAffine ((toScheme B S hS).obj X) := X.property

/-- An indexed family in the big affine fppf category is standard fppf when its
underlying family of scheme morphisms is standard fppf. -/
public abbrev IsStandardFppfCovering (E : Covering (BigAffineFppf B S hS)) : Prop :=
  _root_.AlgebraicGeometry.IsStandardFppfCovering
    (fun i ↦ (toScheme B S hS).obj (E.2.X i))
    (fun i ↦ (toScheme B S hS).map (E.2.f i))

/-- A family in the big affine category covers exactly when it is a covering of the big fppf
site over `S` and is standard fppf. -/
@[stacks 021S "part (2), coverings"]
public abbrev IsCovering (E : Covering (BigAffineFppf B S hS)) : Prop :=
  BigFppfOver.IsCovering B S hS
      ⟨(inclusion B S hS).obj E.1, E.2.map (inclusion B S hS)⟩ ∧
    IsStandardFppfCovering B S hS E

/-- The precoverage presented by standard fppf covering families in the big
affine category over `S`. -/
public def precoverage : Precoverage (BigAffineFppf B S hS) where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X,
    R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩}

/-- Membership in the affine precoverage is characterized by a presenting standard
fppf covering family. -/
public theorem mem_precoverage_iff {X : BigAffineFppf B S hS} {R : Presieve X} :
    R ∈ precoverage B S hS X ↔ ∃ E : PreZeroHypercover.{u + 1} X,
      R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩ :=
  Iff.rfl

/-- The topology generated by the standard fppf covering families of the big
affine category over `S`. -/
public abbrev topology : GrothendieckTopology (BigAffineFppf B S hS) :=
  (precoverage B S hS).toGrothendieck

end BigAffineFppf

end Over

end AlgebraicGeometry
