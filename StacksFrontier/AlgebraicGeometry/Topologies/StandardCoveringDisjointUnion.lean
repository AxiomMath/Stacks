@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u v w

namespace AlgebraicGeometry

-- `S.Etale` is by definition `MorphismProperty.Over @Etale ⊤ S`, which is where its finite
-- coproducts come from. The property has to be named by a local `P` of type
-- `MorphismProperty Scheme.{u}` for those instances to be found: the bare class `@Etale` does not
-- have a `MorphismProperty` as its type, and applying `MorphismProperty.Over` to it directly
-- leaves the category instance of the result unsolved. Each of the three declarations below does
-- the same.
/-- Finite disjoint unions of schemes étale over a fixed base are again étale over it. -/
instance Scheme.Etale.hasFiniteCoproducts (S : Scheme.{u}) : HasFiniteCoproducts S.Etale := by
  let P : MorphismProperty Scheme.{u} := @Etale
  change HasFiniteCoproducts (MorphismProperty.Over P ⊤ S)
  infer_instance

/-- The members of a standard covering form a covering family for the topology they are standard
for. -/
theorem IsStandardCovering.ofArrows_mem_precoverage (τ : CoveringTopology) {T : Scheme.{u}}
    [IsAffine T] {I : Type w} (U : I → Scheme.{u}) (f : ∀ i, U i ⟶ T)
    (h : IsStandardCovering τ U f) :
    Presieve.ofArrows U f ∈ Scheme.precoverage (coveringMorphismProperty τ) T := by
  rw [Scheme.ofArrows_mem_precoverage_iff]
  refine ⟨fun x ↦ ?_, fun i ↦ ?_⟩
  · simpa only [Set.mem_iUnion, Set.mem_range] using
      Set.eq_univ_iff_forall.mp h.jointly_surjective x
  · have hU : IsAffine (U i) := h.affine_source i
    cases τ with
    | fppf => exact ⟨(h.standard i).1, (h.standard i).2.locallyOfFinitePresentation⟩
    | syntomic =>
        intro x
        rw [syntomicAt_iff]
        refine ⟨⟨⊤, isAffineOpen_top (U i)⟩, by simp, ⟨⊤, isAffineOpen_top T⟩, by simp, ?_⟩
        let : Algebra Γ(T, ⊤) Γ(U i, ⊤) := (f i).appTop.hom.toAlgebra
        have : Algebra.IsRelativeGlobalCompleteIntersection Γ(T, ⊤) Γ(U i, ⊤) := h.standard i
        have hmap : (f i).appTop = (f i).appLE (⊤ : T.Opens) (⊤ : (U i).Opens) le_top := by
          rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
          congr 1
        rw [← hmap]
        exact Algebra.Syntomic.of_isRelativeGlobalCompleteIntersection _ _
    | smooth =>
        have hs : (f i).appTop.hom.IsStandardSmooth := h.standard i
        exact (HasRingHomProperty.iff_of_isAffine (P := @Smooth)).2 hs.smooth
    | etale => exact h.standard i
    | zariski =>
        obtain ⟨a, e, hEq⟩ := h.standard i
        rw [hEq]
        infer_instance

/-- The morphism from the disjoint union of a standard covering is an fpqc covering of the
target, for each of the five topologies. -/
@[stacks 03FI "part (1), fpqc covering"]
theorem IsStandardCovering.singleton_sigmaDesc_mem_fpqcPrecoverage (τ : CoveringTopology)
    {T : Scheme.{u}} [IsAffine T] {I : Type w} (U : I → Scheme.{u}) (f : ∀ i, U i ⟶ T)
    (h : IsStandardCovering τ U f) :
    letI : Finite I := h.finite_index
    Presieve.singleton (Sigma.desc f) ∈ Scheme.fpqcPrecoverage T := by
  have : Finite I := h.finite_index
  have hfamily : Presieve.ofArrows U f ∈ Scheme.fppfPrecoverage T := by
    have h' := h.ofArrows_mem_precoverage τ U f
    cases τ with
    | fppf => exact h'
    | syntomic => exact Scheme.syntomicPrecoverage_le_fppfPrecoverage _ h'
    | smooth => exact Scheme.smoothPrecoverage_le_fppfPrecoverage _ h'
    | etale => exact Scheme.etalePrecoverage_le_fppfPrecoverage _ h'
    | zariski => exact Scheme.zariskiPrecoverage_le_fppfPrecoverage _ h'
  exact (ofArrows_mem_fpqcPrecoverage_iff_singleton_sigmaDesc_mem U f).mp
    (Scheme.fppfPrecoverage_le_fpqcPrecoverage T hfamily)

/-- Outside the Zariski topology, the morphism from the disjoint union of a standard covering is
itself a covering family for the topology the covering is standard for. -/
@[stacks 03FI "part (1), covering in the original topology"]
theorem IsStandardCovering.singleton_sigmaDesc_mem_precoverage (τ : CoveringTopology)
    (hτ : τ ≠ .zariski) {T : Scheme.{u}} [IsAffine T] {I : Type w} (U : I → Scheme.{u})
    (f : ∀ i, U i ⟶ T) (h : IsStandardCovering τ U f) :
    letI : Finite I := h.finite_index
    Presieve.singleton (Sigma.desc f) ∈ Scheme.precoverage (coveringMorphismProperty τ) T := by
  have : Finite I := h.finite_index
  have hmem := (Scheme.ofArrows_mem_precoverage_iff _).mp (h.ofArrows_mem_precoverage τ U f)
  rw [Scheme.singleton_mem_precoverage_iff]
  refine ⟨(Surjective.sigmaDesc_of_union_range_eq_univ h.jointly_surjective).surj, ?_⟩
  cases τ with
  | fppf =>
      have : IsZariskiLocalAtSource (@Flat : MorphismProperty Scheme.{u}) :=
        HasRingHomProperty.instIsZariskiLocalAtSource
      have : IsZariskiLocalAtSource
          (@LocallyOfFinitePresentation : MorphismProperty Scheme.{u}) :=
        HasRingHomProperty.instIsZariskiLocalAtSource
      exact ⟨IsZariskiLocalAtSource.sigmaDesc (P := @Flat) fun i ↦ (hmem.2 i).1,
        IsZariskiLocalAtSource.sigmaDesc (P := @LocallyOfFinitePresentation)
          fun i ↦ (hmem.2 i).2⟩
  | syntomic => exact IsZariskiLocalAtSource.sigmaDesc (P := @Syntomic) hmem.2
  | smooth =>
      have : IsZariskiLocalAtSource (@Smooth : MorphismProperty Scheme.{u}) :=
        HasRingHomProperty.instIsZariskiLocalAtSource
      exact IsZariskiLocalAtSource.sigmaDesc (P := @Smooth) hmem.2
  | etale =>
      have : IsZariskiLocalAtSource (@Etale : MorphismProperty Scheme.{u}) :=
        HasRingHomProperty.instIsZariskiLocalAtSource
      exact IsZariskiLocalAtSource.sigmaDesc (P := @Etale) hmem.2
  | zariski => exact (hτ rfl).elim

/-- In every one of the five topologies, the sieve generated by the morphism from the disjoint
union of a standard covering is a covering sieve of the target. -/
@[stacks 03FI "part (1), covering sieve in every topology"]
theorem IsStandardCovering.sieve_sigmaDesc_mem_topology (τ : CoveringTopology) {T : Scheme.{u}}
    [IsAffine T] {I : Type w} (U : I → Scheme.{u}) (f : ∀ i, U i ⟶ T)
    (h : IsStandardCovering τ U f) :
    letI : Finite I := h.finite_index
    Sieve.generate (Presieve.singleton (Sigma.desc f)) ∈
      (Scheme.precoverage (coveringMorphismProperty τ)).toGrothendieck T := by
  have : Finite I := h.finite_index
  refine GrothendieckTopology.superset_covering _ ?_
    (Precoverage.generate_mem_toGrothendieck (h.ofArrows_mem_precoverage τ U f))
  rw [Sieve.generate_le_iff]
  rintro V g ⟨i⟩
  exact ⟨∐ U, Sigma.ι U i, Sigma.desc f, Presieve.singleton.mk, Sigma.ι_comp_desc f i⟩

/-- Slice categories of a finitary extensive category with finite limits are finitary
extensive. -/
public instance overFinitaryExtensive {C : Type u} [Category.{v} C] [HasFiniteLimits C]
    [FinitaryExtensive C] (T : C) : FinitaryExtensive (Over T) :=
  finitaryExtensive_of_preserves_and_reflects (Over.forget T)

/-- The extensive topology is coarser than a topology containing the sieve generated by each
finite coproduct cofan. -/
private theorem extensiveTopology_le_of_ofArrows_mem {C : Type*} [Category C]
    [FinitaryPreExtensive C] (J : GrothendieckTopology C)
    (h : ∀ {T : C} {I : Type} [Finite I] (X : I → C) (f : ∀ i, X i ⟶ T),
      IsColimit (Cofan.mk T f) → Sieve.ofArrows X f ∈ J T) :
    extensiveTopology C ≤ J := by
  intro T R hR
  obtain ⟨I, hI, X, f, ⟨hc⟩, hf⟩ :=
    (extensiveTopology.mem_sieves_iff_contains_colimit_cofan R).mp hR
  exact J.superset_covering ((Sieve.generate_le_iff _ _).mpr (by rintro _ _ ⟨i⟩; exact hf i))
    (h X f hc)

/-- Finite disjoint unions of schemes over `S` cover their coproduct in the big Zariski topology
on `Over S`, so the extensive topology is coarser than it. -/
public theorem extensiveTopology_over_le_zariskiTopology_over (S : Scheme.{u}) :
    extensiveTopology (Over S) ≤ Scheme.zariskiTopology.over S := by
  refine extensiveTopology_le_of_ofArrows_mem _ fun X f hc ↦ ?_
  rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
  have hc' := isColimitOfPreserves (Over.forget S) hc
  have h := ofArrows_ι_mem_zariskiTopology_of_isColimit _ _ hc'
  apply Scheme.zariskiTopology.superset_covering _ h
  rw [Sieve.ofArrows, Sieve.generate_le_iff]
  rintro V g ⟨i⟩
  exact ⟨_, 𝟙 _, _, ⟨i.as⟩, by simp⟩

/-- The small étale site of a scheme is finitary extensive. -/
public instance etaleFinitaryExtensive (S : Scheme.{u}) : FinitaryExtensive S.Etale := by
  let P : MorphismProperty Scheme.{u} := @Etale
  change FinitaryExtensive (MorphismProperty.Over P ⊤ S)
  let G := MorphismProperty.Over.forget P ⊤ S
  have : PreservesFiniteLimits G := inferInstance
  have : PreservesLimitsOfShape WalkingCospan (G ⋙ Over.forget S) := inferInstance
  have : PreservesColimitsOfShape (Discrete WalkingPair) G := by
    dsimp [G]
    infer_instance
  have : G.ReflectsIsomorphisms := by
    dsimp [G]
    infer_instance
  exact finitaryExtensive_of_preserves_and_reflects_isomorphism (G ⋙ Over.forget S)

/-- Finite disjoint unions of schemes étale over `S` cover their coproduct in the small étale
topology, so the extensive topology is coarser than it. -/
public theorem extensiveTopology_le_smallEtaleTopology (S : Scheme.{u}) :
    extensiveTopology S.Etale ≤ Scheme.smallEtaleTopology S := by
  refine extensiveTopology_le_of_ofArrows_mem _ fun {T I _} X f hc ↦ ?_
  rw [Scheme.ofArrows_mem_smallEtaleTopology_iff]
  refine Set.eq_univ_iff_forall.mpr fun x ↦ ?_
  have hG : PreservesColimitsOfShape (Discrete I) (Scheme.Etale.forget S) := by
    let P : MorphismProperty Scheme.{u} := @Etale
    change PreservesColimitsOfShape (Discrete I) (MorphismProperty.Over.forget P ⊤ S)
    infer_instance
  let G := Scheme.Etale.forget S ⋙ Over.forget S ⋙ Scheme.forgetToTop
  obtain ⟨i, y, hy⟩ := Concrete.isColimit_exists_rep _ (isColimitOfPreserves G hc) x
  exact Set.mem_iUnion.mpr ⟨i.as, y, hy⟩

/-- For an abelian sheaf on a topology refining the extensive topology of a finitary extensive
category, the Čech complex of a finite family agrees with that of its coproduct morphism. -/
private theorem isIso_cechComplexMap_coproductRefinement_of_extensiveTopology_le
    {C : Type*} [Category C] [HasFiniteLimits C] [FinitaryExtensive C] {J : GrothendieckTopology C}
    (hJ : extensiveTopology C ≤ J) {T : C} (E : PreZeroHypercover.{w} T) [Finite E.I₀]
    (F : Cᵒᵖ ⥤ Ab.{v}) (hF : Presheaf.IsSheaf J F) :
    IsIso (Stacks.CechSite.cechComplexMap E
      (PreZeroHypercover.singleton.{w} (Sigma.desc E.f))
      (Stacks.CechSite.coproductRefinement E) (F ⋙ AddCommGrpCat.uliftFunctor.{w, v})) := by
  have : PreservesFiniteProducts F :=
    (Presheaf.isSheaf_iff_preservesFiniteProducts F).mp (Presheaf.IsSheaf.of_le hJ hF)
  exact Stacks.CechSite.isIso_cechComplexMap_of_preservesFiniteProducts E _

/-- For an abelian sheaf on a topology on `Over S` refining the big Zariski topology, the
canonical refinement of a finite family by the morphism from its disjoint union induces an
isomorphism of Čech complexes. -/
@[stacks 03FI "part (3), big site"]
theorem isIso_cechComplexMap_coproductRefinement_over (S : Scheme.{u})
    (J : GrothendieckTopology (Over S)) (hJ : Scheme.zariskiTopology.over S ≤ J) {T : Over S}
    (E : PreZeroHypercover.{w} T) [Finite E.I₀] (F : (Over S)ᵒᵖ ⥤ Ab.{v})
    (hF : Presheaf.IsSheaf J F) :
    IsIso (Stacks.CechSite.cechComplexMap E
      (PreZeroHypercover.singleton.{w} (Sigma.desc E.f))
      (Stacks.CechSite.coproductRefinement E) (F ⋙ AddCommGrpCat.uliftFunctor.{w, v})) := by
  exact isIso_cechComplexMap_coproductRefinement_of_extensiveTopology_le
    ((extensiveTopology_over_le_zariskiTopology_over S).trans hJ) E F hF

/-- For an abelian sheaf on the small étale site of `S`, the canonical refinement of a finite
family by the morphism from its disjoint union induces an isomorphism of Čech complexes. -/
@[stacks 03FI "part (3), small étale site"]
theorem isIso_cechComplexMap_coproductRefinement_smallEtale (S : Scheme.{u}) {T : S.Etale}
    (E : PreZeroHypercover.{w} T) [Finite E.I₀] (F : (S.Etale)ᵒᵖ ⥤ Ab.{v})
    (hF : Presheaf.IsSheaf (Scheme.smallEtaleTopology S) F) :
    IsIso (Stacks.CechSite.cechComplexMap E
      (PreZeroHypercover.singleton.{w} (Sigma.desc E.f))
      (Stacks.CechSite.coproductRefinement E) (F ⋙ AddCommGrpCat.uliftFunctor.{w, v})) := by
  exact isIso_cechComplexMap_coproductRefinement_of_extensiveTopology_le
    (extensiveTopology_le_smallEtaleTopology S) E F hF

/-- The morphism from the disjoint union of a standard étale covering of an object of the small
étale site of `S` generates a covering sieve of that object. -/
@[stacks 03FI "part (1), small étale site"]
theorem IsStandardCovering.sieve_sigmaDesc_mem_smallEtaleTopology (S : Scheme.{u})
    {T : S.Etale} [IsAffine T.left] (E : PreZeroHypercover.{u} T) [HasCoproduct E.X]
    (h : IsStandardCovering .etale (fun i : E.I₀ ↦ (E.X i).left) (fun i ↦ (E.f i).left)) :
    Sieve.ofArrows (fun _ : PUnit ↦ ∐ E.X) (fun _ : PUnit ↦ Sigma.desc E.f) ∈
      Scheme.smallEtaleTopology S T := by
  rw [Scheme.ofArrows_mem_smallEtaleTopology_iff]
  refine Set.eq_univ_iff_forall.mpr fun x ↦ ?_
  simp only [Set.mem_iUnion, Set.mem_range]
  have hx : x ∈ ⋃ i, Set.range (E.f i).left := by
    rw [h.jointly_surjective]
    simp
  obtain ⟨i, y, hy⟩ := Set.mem_iUnion.mp hx
  refine ⟨PUnit.unit, (Sigma.ι E.X i).left y, ?_⟩
  have hcomp : (Sigma.ι E.X i).left ≫ (Sigma.desc E.f).left = (E.f i).left :=
    congrArg (fun g ↦ g.left) (Sigma.ι_comp_desc E.f i)
  rw [← Scheme.Hom.comp_apply, hcomp]
  exact hy

/-- The disjoint union of the members of a standard `τ`-covering is an affine scheme: the index
type is finite and every member is affine. -/
@[stacks 03OZ "part (1)"]
theorem IsStandardCovering.isAffine_sigmaObj (τ : CoveringTopology) {T : Scheme.{u}}
    [IsAffine T] {I : Type w} (U : I → Scheme.{u}) (f : ∀ i, U i ⟶ T)
    (h : IsStandardCovering τ U f) :
    letI : Finite I := h.finite_index
    IsAffine (∐ U) := by
  have : Finite I := h.finite_index
  have := h.affine_source
  infer_instance

/-- The scheme underlying the disjoint union, in the big site over `S`, of the members of a
family whose underlying morphisms form a standard `τ`-covering is affine. The disjoint union is
computed on underlying schemes, since the forgetful functor to schemes preserves it. -/
@[stacks 03OZ "part (1), big site"]
theorem IsStandardCovering.isAffine_left_sigmaObj (τ : CoveringTopology) (S : Scheme.{u})
    {T : Over S} [IsAffine T.left] (E : PreZeroHypercover.{w} T)
    (h : IsStandardCovering τ (fun i ↦ (E.X i).left) (fun i ↦ (E.f i).left)) :
    letI : Finite E.I₀ := h.finite_index
    IsAffine (∐ E.X).left := by
  have : Finite E.I₀ := h.finite_index
  have : ∀ i, IsAffine (E.X i).left := h.affine_source
  have hc : IsColimit (Cofan.mk ((∐ E.X).left) (fun i ↦ (Sigma.ι E.X i).left)) :=
    (isColimitMapCoconeCofanMkEquiv (Over.forget S) E.X _)
      (isColimitOfPreserves (Over.forget S) (coproductIsCoproduct E.X))
  have e : (∐ fun i ↦ (E.X i).left) ≅ (∐ E.X).left :=
    (coproductIsCoproduct (fun i ↦ (E.X i).left)).coconePointUniqueUpToIso hc
  exact IsAffine.of_isIso e.inv

/-- Every open immersion has the property of morphisms defining each of the five topologies. -/
theorem isOpenImmersion_le_coveringMorphismProperty (τ : CoveringTopology) :
    (@IsOpenImmersion : MorphismProperty Scheme.{u}) ≤ coveringMorphismProperty τ := by
  cases τ with
  | fppf => intro X Y f _; exact ⟨inferInstance, inferInstance⟩
  | syntomic => intro X Y f _; exact syntomic_of_isOpenImmersion f
  | smooth => intro X Y f _; exact inferInstance
  | etale => intro X Y f _; exact inferInstance
  | zariski => intro X Y f hf; exact hf

/-- The big Zariski topology on schemes is coarser than each of the five topologies. -/
theorem Scheme.zariskiTopology_le_grothendieckTopology (τ : CoveringTopology) :
    Scheme.zariskiTopology.{u} ≤ Scheme.grothendieckTopology (coveringMorphismProperty τ) :=
  Scheme.grothendieckTopology_monotone (isOpenImmersion_le_coveringMorphismProperty τ)

/-- For an abelian sheaf on the big `τ`-site over `S` and a standard `τ`-covering of an affine
object of that site, the canonical refinement of the covering by the morphism from the disjoint
union of its members induces an isomorphism of Čech complexes. -/
@[stacks 03OZ "part (3), big τ-site"]
theorem IsStandardCovering.isIso_cechComplexMap_coproductRefinement_bigSite
    (τ : CoveringTopology) (S : Scheme.{u}) {T : Over S} [IsAffine T.left]
    (E : PreZeroHypercover.{w} T)
    (h : IsStandardCovering τ (fun i ↦ (E.X i).left) (fun i ↦ (E.f i).left))
    (F : (Over S)ᵒᵖ ⥤ Ab.{v})
    (hF : Presheaf.IsSheaf
      ((Scheme.grothendieckTopology (coveringMorphismProperty τ)).over S) F) :
    letI : Finite E.I₀ := h.finite_index
    IsIso (Stacks.CechSite.cechComplexMap E
      (PreZeroHypercover.singleton.{w} (Sigma.desc E.f))
      (Stacks.CechSite.coproductRefinement E) (F ⋙ AddCommGrpCat.uliftFunctor.{w, v})) := by
  have : Finite E.I₀ := h.finite_index
  refine isIso_cechComplexMap_coproductRefinement_over S _ (fun T' R hR ↦ ?_) E F hF
  rw [GrothendieckTopology.mem_over_iff] at hR ⊢
  exact Scheme.zariskiTopology_le_grothendieckTopology τ _ hR

