module

public import Mathlib.CategoryTheory.Sites.Finite
public import StacksFrontier.Algebra.Category.ModuleCat.Presheaf.CartesianRestriction
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.LocalOnCover.Quasicoherence
public import StacksFrontier.AlgebraicGeometry.Topologies.QuasicoherentOnSite

/-!
# A sheaf of modules with a global presentation is cartesian

A global presentation of a sheaf of modules, `SheafOfModules.HasGlobalPresentation`, exhibits it as
a cokernel of a map between coproducts of copies of the structure sheaf. Each copy of the structure
sheaf is cartesian — `Stacks.PresheafOfModules.isIso_restrictionBaseChange_largeUnit` — and the
cartesian condition passes to colimits, so a sheaf of modules with a global presentation is
cartesian, provided every cartesian presheaf of modules is a sheaf (the hypothesis `hSheaf`).

On a site whose coverings are finite, every object has a *finite* covering on whose slices a
quasi-coherent sheaf of modules has a global presentation.

## Main results

* `Stacks.SheafOfModules.uliftForPresentationIsoSelf`: a sheaf of modules is isomorphic to itself
  with sections raised to the universe where presentations live.
* `Stacks.PresheafOfModules.isIso_restrictionBaseChange_sheafColimit`: a colimit of cartesian
  sheaves of modules is cartesian.
* `Stacks.PresheafOfModules.isIso_restrictionBaseChange_of_hasGlobalPresentation`: a sheaf of
  modules with a global presentation is cartesian.
* `Stacks.Sites.exists_finite_cover_of_mem_generated`: a covering sieve of a topology generated by
  finite covering families contains a finite covering family.
* `Stacks.SheafOfModules.exists_finite_globalPresentation_cover`: a quasi-coherent sheaf of modules
  on a site with finite coverings admits, over every object, a finite covering on whose slices it
  has a global presentation.

## References

* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
* [Stacks Project, Tag 0H04](https://stacks.math.columbia.edu/tag/0H04)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v r m t w

namespace Stacks.SheafOfModules

/-- A sheaf of modules whose sections already live in the universe where global presentations are
taken is isomorphic to its own universe lift. -/
noncomputable def uliftForPresentationIsoSelf
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{r}} (M : SheafOfModules.{max u v r m} R) :
    M ≅ SheafOfModules.uliftForPresentation.{u, v, r, max u v r m, max u v r} M :=
  (SheafOfModules.fullyFaithfulForget R).preimageIso
    (PresheafOfModules.isoMk
      (fun X => (ULift.moduleEquiv.symm : M.val.obj X ≃ₗ[R.obj.obj X]
        ULift.{max u v r} (M.val.obj X)).toModuleIso)
      (by intro X Y f; ext x; rfl))

end Stacks.SheafOfModules

namespace Stacks.PresheafOfModules

/-- A colimit of cartesian sheaves of modules is cartesian, provided every cartesian presheaf of
modules is a sheaf (`hSheaf`). -/
theorem isIso_restrictionBaseChange_sheafColimit
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    (R : Cᵒᵖ ⥤ CommRingCat.{r})
    (hR : Presheaf.IsSheaf J (R ⋙ forget₂ CommRingCat RingCat))
    (hSheaf : ∀ M : PresheafOfModules.{max r m} (R ⋙ forget₂ CommRingCat RingCat),
      (∀ {X Y} (f : X ⟶ Y), IsIso (restrictionBaseChange M f)) →
        Presheaf.IsSheaf J M.presheaf)
    {D : Type t} [Category.{w} D]
    [HasColimitsOfShape D AddCommGrpCat.{max r m}]
    (K : D ⥤ SheafOfModules.{max r m} ⟨R ⋙ forget₂ CommRingCat RingCat, hR⟩)
    (c : Cocone K) (hc : IsColimit c)
    (hK : ∀ i {X Y} (f : X ⟶ Y),
      IsIso (restrictionBaseChange (K.obj i).val f))
    {X Y : Cᵒᵖ} (f : X ⟶ Y) :
    IsIso (restrictionBaseChange c.pt.val f) := by
  let S : Sheaf J RingCat.{r} := ⟨R ⋙ forget₂ CommRingCat RingCat, hR⟩
  let H := SheafOfModules.forget.{max r m} S
  let _ : H.Full := (SheafOfModules.fullyFaithfulForget S).full
  let _ : H.Faithful := (SheafOfModules.fullyFaithfulForget S).faithful
  let N : SheafOfModules.{max r m} S := ⟨colimit (K ⋙ H), hSheaf _ fun g =>
    isIso_restrictionBaseChange_colimit.{u, v, r, m, t, w} R (K ⋙ H) _ (colimit.isColimit _) g
      (fun i => hK i g)⟩
  let _ : CreatesColimit K H := createsColimitOfFullyFaithfulOfIso N (Iso.refl _)
  exact isIso_restrictionBaseChange_colimit.{u, v, r, m, t, w} R (K ⋙ H) _
    (isColimitOfPreserves H hc) f (fun i => hK i f)

/-- A sheaf of modules with a global presentation is cartesian, provided every cartesian presheaf
of modules is a sheaf (`hSheaf`). -/
theorem isIso_restrictionBaseChange_of_hasGlobalPresentation
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    (R : Cᵒᵖ ⥤ CommRingCat.{r})
    (hR : Presheaf.IsSheaf J (R ⋙ forget₂ CommRingCat RingCat))
    (hSheaf : ∀ M : PresheafOfModules.{max u v r m} (R ⋙ forget₂ CommRingCat RingCat),
      (∀ {X Y} (f : X ⟶ Y), IsIso (restrictionBaseChange.{u, v, r, max u v r m} M f)) →
        Presheaf.IsSheaf J M.presheaf)
    (M : SheafOfModules.{max u v r m} ⟨R ⋙ forget₂ CommRingCat RingCat, hR⟩)
    (hM : M.HasGlobalPresentation) {X Y : Cᵒᵖ} (f : X ⟶ Y) :
    IsIso (restrictionBaseChange.{u, v, r, max u v r m} M.val f) := by
  obtain ⟨I, K, P, Q, ι, κ, ⟨hP⟩, ⟨hQ⟩, a, b, hab, ⟨hc⟩⟩ := hM
  have hfree {I : Type (max u v r m)}
      {N : SheafOfModules.{max u v r m} ⟨R ⋙ forget₂ CommRingCat RingCat, hR⟩}
      {ι : ∀ _ : I, SheafOfModules.uliftForPresentation.{u, v, r, r, max u v r m}
        (SheafOfModules.unit ⟨R ⋙ forget₂ CommRingCat RingCat, hR⟩) ⟶ N}
      (hN : IsColimit (Cofan.mk N ι)) {X Y : Cᵒᵖ} (f : X ⟶ Y) :
      IsIso (restrictionBaseChange.{u, v, r, max u v r m} N.val f) :=
    isIso_restrictionBaseChange_sheafColimit.{u, v, r, max u v r m} R hR hSheaf _ _ hN
      (fun _ {_ _} g => isIso_restrictionBaseChange_largeUnit R g) f
  have hL : IsIso (restrictionBaseChange.{u, v, r, max u v r m}
      (SheafOfModules.uliftForPresentation.{u, v, r, max u v r m, max u v r} M).val f) :=
    isIso_restrictionBaseChange_sheafColimit.{u, v, r, max u v r m} R hR hSheaf _ _ hc
      (by rintro ⟨⟩ X Y g; exacts [hfree hQ g, hfree hP g]) f
  exact @isIso_restrictionBaseChange_of_iso.{u, v, r, max u v r m} C _ R _ _
    ((SheafOfModules.forget _).mapIso
      (Stacks.SheafOfModules.uliftForPresentationIsoSelf.{u, v, r, m} M).symm) X Y f hL

end Stacks.PresheafOfModules

namespace Stacks.Sites

/-- A covering sieve of a topology generated by a precoverage whose covering families are finite
contains a finite covering family. -/
theorem exists_finite_cover_of_mem_generated
    {C : Type u} [Category.{v} C] [HasPullbacks C]
    (P : Precoverage C)
    (hP : ∀ {U : C} (R : Presieve U), R ∈ P U → R.uncurry.Finite)
    {U : C} (S : Sieve U) (hS : S ∈ P.toGrothendieck U) :
    ∃ (I : Type (max u v)) (_ : Finite I) (V : I → C) (f : ∀ i, V i ⟶ U),
      Sieve.ofArrows V f ∈ P.toGrothendieck U ∧ ∀ i, S (f i) := by
  let J := P.toGrothendieck
  let K : Pretopology C := Pretopology.finite C ⊓ J.toPretopology
  have hle : J ≤ K.toGrothendieck := Precoverage.toGrothendieck_le_iff_le_toPrecoverage.mpr
    fun _ R hR => ⟨R, ⟨hP R hR, Precoverage.generate_mem_toGrothendieck hR⟩, Sieve.le_generate R⟩
  obtain ⟨R, hR, hRS⟩ := (Pretopology.mem_toGrothendieck K U S).mp (hle U hS)
  let I := R.uncurry
  refine ⟨I, hR.1.to_subtype, fun i => i.1.1, fun i => i.1.2, ?_, fun i => hRS _ _ i.2⟩
  have he : Presieve.ofArrows (fun i : I => i.1.1) (fun i => i.1.2) = R := by
    funext V f
    exact propext ⟨fun ⟨i⟩ => i.2, fun hf => .mk (⟨⟨V, f⟩, hf⟩ : I)⟩
  change Sieve.generate (Presieve.ofArrows _ _) ∈ J U
  exact he ▸ hR.2

end Stacks.Sites

namespace Stacks.SheafOfModules

/-- A quasi-coherent sheaf of modules on a site whose covering families are finite admits, over
every object `U`, a finite covering family of `U` on whose slices it has a global presentation. -/
theorem exists_finite_globalPresentation_cover
    {C : Type u} [Category.{v} C] [HasPullbacks C]
    (P : Precoverage C)
    (hP : ∀ {U : C} (R : Presieve U), R ∈ P U → R.uncurry.Finite)
    {R : Sheaf P.toGrothendieck RingCat.{r}}
    (M : SheafOfModules.{max u v r m} R) (hM : M.IsQuasicoherentOnSite) (U : C) :
    ∃ (I : Type (max u v)) (_ : Finite I) (V : I → C) (f : ∀ i, V i ⟶ U),
      Sieve.ofArrows V f ∈ P.toGrothendieck U ∧ ∀ i, (M.over (V i)).HasGlobalPresentation := by
  obtain ⟨I, V, f, hcover, hpres⟩ := hM.locally_hasGlobalPresentation U
  obtain ⟨K, hK, W, g, hcov, hg⟩ := Stacks.Sites.exists_finite_cover_of_mem_generated
    P hP (Sieve.ofArrows V f) hcover
  refine ⟨K, hK, W, g, hcov, fun k => ?_⟩
  obtain ⟨Z, a, b, ⟨i⟩, hab⟩ := hg k
  exact hasGlobalPresentation_overMap.{u, v, r, max u v r m} M a (hpres i)

end Stacks.SheafOfModules

end
