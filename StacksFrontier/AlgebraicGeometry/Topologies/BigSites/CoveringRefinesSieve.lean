module

public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import StacksFrontier.CategoryTheory.Sites.Pretopology.SmallSubsite

/-!
# Covering families refining a covering sieve

A Grothendieck topology presented by a class of covering families is generated by the sieves
of those families, so every one of its covering sieves contains one of the families. This file
records that reduction once, for an arbitrary class of covering families satisfying the site
axioms.

The statement is the family-level counterpart of
`CategoryTheory.Precoverage.mem_toGrothendieck_iff`.

## Main results

* `CategoryTheory.exists_covering_refining_sieve` — a covering sieve for the topology generated
  by a precoverage contains the family of a covering of the underlying class.
-/

@[expose] public section

universe v u

namespace CategoryTheory

/-- A covering sieve for the topology generated by a precoverage contains the family of one of
the covering families presenting it, provided those families satisfy the site axioms. -/
public theorem exists_covering_refining_sieve {C : Type u} [Category.{v} C]
    (P : Covering C → Prop) (H : Precoverage C)
    (hH : ∀ {X : C} {R : Presieve X}, R ∈ H X →
      ∃ E : PreZeroHypercover X, P ⟨X, E⟩ ∧ R = E.presieve₀)
    (hP : IsSite P) {X : C} {R : Sieve X} (hR : R ∈ H.toGrothendieck X) :
    ∃ E : PreZeroHypercover X, P ⟨X, E⟩ ∧ E.presieve₀ ≤ R := by
  rw [Precoverage.mem_toGrothendieck_iff] at hR
  induction hR with
  | of X Q hQ =>
      obtain ⟨E, hE, hEq⟩ := hH hQ
      exact ⟨E, hE, by simpa [hEq] using Sieve.le_generate _⟩
  | top X =>
      exact ⟨PreZeroHypercover.singleton (𝟙 X), hP.1 (𝟙 X), by
        intro Y f hf; trivial⟩
  | pullback X R hR Y f ih =>
      obtain ⟨E, hE, hle⟩ := ih
      obtain ⟨Q, p₁, p₂, hpb, hQ⟩ := hP.2.2 ⟨X, E⟩ hE Y f
      refine ⟨⟨E.I₀, Q, p₂⟩, hQ, ?_⟩
      rw [Presieve.ofArrows_le_iff]
      intro i
      rw [Sieve.pullback_apply, ← (hpb i).w]
      exact R.downward_closed (hle _ _ ⟨i⟩) (p₁ i)
  | transitive X R Q hR hRQ ihR ihRQ =>
      obtain ⟨E, hE, hle⟩ := ihR
      have hlocal (i : E.I₀) := ihRQ (hle _ _ ⟨i⟩)
      choose F hF hFle using hlocal
      refine ⟨E.bind fun i ↦ (F i).pushforward (𝟙 (E.X i)), ?_, ?_⟩
      · exact hP.2.1 ⟨X, E⟩ hE (fun i ↦ ⟨E.X i, F i⟩) hF (fun _ ↦ rfl)
      · rw [Presieve.ofArrows_le_iff]
        rintro ⟨i, j⟩
        show Q (((F i).f j ≫ 𝟙 _) ≫ E.f i)
        simpa using hFle i _ _ ⟨j⟩

end CategoryTheory
