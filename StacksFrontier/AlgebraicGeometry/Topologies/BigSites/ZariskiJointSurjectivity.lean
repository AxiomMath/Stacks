module

public import StacksFrontier.AlgebraicGeometry.Topologies.BigSites.ZariskiPrecoverage
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Covering sieves of a big Zariski site are exactly the jointly surjective open sieves

Let `B` be a big Zariski site. Its topology is generated by the *selected* Zariski covering
families — those whose index type obeys the bound `B.coveringCardinal`. This file shows that at
the level of covering *sieves* the selection is no restriction and the topology is characterised
geometrically:

* every covering sieve is jointly surjective on points
  (`AlgebraicGeometry.BigZariskiSite.exists_mem_arrows_mem_range`), and
* conversely a sieve whose arrows are open immersions and jointly surjective on points is a
  covering sieve (`AlgebraicGeometry.BigZariskiSite.mem_topology_of_jointlySurjective`).

Both statements are then transported to the big Zariski site over a scheme `S`.

## Main results

* `AlgebraicGeometry.BigZariskiSite.exists_mem_range_of_mem_precoverage` — a selected covering
  family is jointly surjective on points.
* `AlgebraicGeometry.BigZariskiSite.exists_mem_arrows_mem_range` and
  `AlgebraicGeometry.BigZariskiOver.exists_mem_arrows_mem_range` — every covering sieve of the
  big Zariski site, resp. of the big Zariski site over `S`, is jointly surjective on points.
* `AlgebraicGeometry.BigZariskiSite.mem_topology_of_jointlySurjective` and
  `AlgebraicGeometry.BigZariskiOver.generate_ofArrows_mem_topology` — a jointly surjective sieve
  of open immersions, resp. the sieve generated by a jointly surjective family of open
  immersions over `S`, is a covering sieve.

## Implementation notes

The surjectivity half is an induction over the inductive generation of
`CategoryTheory.Precoverage.toGrothendieck`: the selected families are jointly surjective
because `AlgebraicGeometry.IsZariskiCovering` is membership in `Scheme.zariskiPretopology`,
which has the same covering families as `Scheme.zariskiPrecoverage` and therefore builds in
joint surjectivity, and the base-change step uses that the underlying space of a fibre product
of schemes surjects onto the fibre product of the underlying spaces
(`AlgebraicGeometry.Scheme.exists_preimage_of_isPullback`). This mirrors
`AlgebraicGeometry.BigEtaleSite.exists_mem_arrows_mem_range` for the big étale site.

The converse half uses the representative field
`AlgebraicGeometry.BigZariskiSite.covering_representative` of the site: the family indexed by
the points of the target is a Zariski covering family of `B`, and that field replaces it by a
selected one which matches it arrow for arrow, hence refines the given sieve. Being an open
immersion is a hypothesis rather than automatic, since an object of the big Zariski site over
`S` need not be open over `S`.

The transport to the slice `BigZariskiOver B S hS` is through
`AlgebraicGeometry.BigZariskiOver.topology_eq_over`, which identifies its topology with
`CategoryTheory.GrothendieckTopology.over`, and `CategoryTheory.Sieve.overEquiv`.

## References

* [Stacks Project, Tag 020S](https://stacks.math.columbia.edu/tag/020S)
* [Stacks Project, Tag 020T](https://stacks.math.columbia.edu/tag/020T)
* [Stacks Project, Tag 09XN](https://stacks.math.columbia.edu/tag/09XN)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-- Open immersions of schemes, packaged as a morphism property. This is the property whose
covering families are the Zariski covering families selected by a big Zariski site, named so
that `AlgebraicGeometry.Scheme.ofArrows_mem_precoverage_iff` can be instantiated at it without
repeating the ascription that disambiguates `Scheme` from
`AlgebraicGeometry.BigZariskiSite.Schemes`. -/
private abbrev openImmersions : MorphismProperty Scheme.{u} := @IsOpenImmersion

/-- A family of morphisms of schemes belongs to Mathlib's Zariski pretopology exactly when it
is jointly surjective on points and consists of open immersions. The Zariski pretopology has
the same covering families as the Zariski precoverage, so this is
`AlgebraicGeometry.Scheme.ofArrows_mem_precoverage_iff` at `@IsOpenImmersion`. -/
@[sga "3 IV 6.1" "partial", sga "4 VII 4.2" "partial"]
private lemma ofArrows_mem_zariskiPretopology_iff {S : Scheme.{u}} {ι : Type*}
    {X : ι → Scheme.{u}} {f : ∀ i, X i ⟶ S} :
    Presieve.ofArrows X f ∈ Scheme.zariskiPretopology S ↔
      (∀ x, ∃ i, x ∈ Set.range (f i)) ∧ ∀ i, IsOpenImmersion (f i) :=
  Scheme.ofArrows_mem_precoverage_iff (P := openImmersions.{u})

/-! ### Covering sieves of a big Zariski site are jointly surjective -/

/-- A selected covering family of a big Zariski site is jointly surjective on points: this is
the joint surjectivity built into Mathlib's Zariski pretopology. -/
public theorem BigZariskiSite.exists_mem_range_of_mem_precoverage (B : BigZariskiSite.{u})
    {X : B.Schemes} {R : Presieve X} (hR : R ∈ B.precoverage X) (x : B.inclusion.obj X) :
    ∃ (Y : B.Schemes) (f : Y ⟶ X), R f ∧ x ∈ Set.range (B.inclusion.map f) := by
  obtain ⟨E, hE, rfl⟩ := hR
  obtain ⟨i, hi⟩ := (ofArrows_mem_zariskiPretopology_iff.mp hE.1).1 x
  exact ⟨E.X i, E.f i, ⟨i⟩, hi⟩

/-- **Every covering sieve of a big Zariski site is jointly surjective on points.** Each point
of the target is in the image of one of the members of the sieve.

The proof is an induction over the inductive generation of the topology from the selected
covering families: those are jointly surjective by
`AlgebraicGeometry.BigZariskiSite.exists_mem_range_of_mem_precoverage`, and the base-change step
uses that the underlying space of a fibre product of schemes surjects onto the fibre product of
the underlying spaces (`AlgebraicGeometry.Scheme.exists_preimage_of_isPullback`). -/
public theorem BigZariskiSite.exists_mem_arrows_mem_range (B : BigZariskiSite.{u})
    {X : B.Schemes} {R : Sieve X} (hR : R ∈ B.grothendieckTopology X) :
    ∀ x : B.inclusion.obj X,
      ∃ (Y : B.Schemes) (f : Y ⟶ X), R.arrows f ∧ x ∈ Set.range (B.inclusion.map f) := by
  replace hR : R ∈ B.precoverage.toGrothendieck X := hR
  rw [Precoverage.mem_toGrothendieck_iff] at hR
  induction hR with
  | of X R hR =>
      intro x
      obtain ⟨Y, f, hf, hx⟩ := B.exists_mem_range_of_mem_precoverage hR x
      exact ⟨Y, f, ⟨Y, 𝟙 Y, f, hf, by simp⟩, hx⟩
  | top X => exact fun x => ⟨X, 𝟙 X, trivial, by simp⟩
  | pullback X T _ Y f ih =>
      intro y
      obtain ⟨Z, g, hg, z, hz⟩ := ih (B.inclusion.map f y)
      obtain ⟨p, hp₁, -⟩ := Scheme.exists_preimage_of_isPullback
        ((IsPullback.of_hasPullback f g).map B.inclusion) y z hz.symm
      exact ⟨Limits.pullback f g, Limits.pullback.fst f g,
        by simpa [Limits.pullback.condition] using T.downward_closed hg (pullback.snd f g),
        p, hp₁⟩
  | transitive X T R _ _ ih₁ ih₂ =>
      intro x
      obtain ⟨Z, g, hg, z, hz⟩ := ih₁ x
      obtain ⟨W, h, hh, w, hw⟩ := ih₂ hg z
      refine ⟨W, h ≫ g, hh, w, ?_⟩
      rw [B.inclusion.map_comp, Scheme.Hom.comp_apply, hw, hz]

/-- **Every covering sieve of the big Zariski site over `S` is jointly surjective on points.**
This is `AlgebraicGeometry.BigZariskiSite.exists_mem_arrows_mem_range` read in the slice,
through the identification `AlgebraicGeometry.BigZariskiOver.topology_eq_over` of the topology
of the slice with the induced topology of `CategoryTheory.GrothendieckTopology.over`. -/
public theorem BigZariskiOver.exists_mem_arrows_mem_range (B : BigZariskiSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) {X : BigZariskiOver B S hS} {R : Sieve X}
    (hR : R ∈ BigZariskiOver.topology B S hS X) (x : B.inclusion.obj X.left) :
    ∃ (Y : BigZariskiOver B S hS) (f : Y ⟶ X), R.arrows f ∧
      x ∈ Set.range (B.inclusion.map f.left) := by
  rw [BigZariskiOver.topology_eq_over B ⟨S, hS⟩, GrothendieckTopology.mem_over_iff] at hR
  obtain ⟨Y, f, hf, hx⟩ := B.exists_mem_arrows_mem_range hR x
  exact ⟨Over.mk (f ≫ X.hom), Over.homMk f, (Sieve.overEquiv_iff R f).1 hf, hx⟩

/-! ### Jointly surjective open sieves are covering sieves -/

/-- **The covering bound is no restriction on a big Zariski site.** A family of morphisms of `B`
whose underlying morphisms of schemes are open immersions and jointly surjective admits a
*selected* covering family — one of the families the site has chosen, so in particular one whose
index type obeys `B.coveringCardinal` — all of whose arrows belong to the presieve of the given
family.

The selected family is obtained from
`AlgebraicGeometry.BigZariskiSite.covering_representative` by reindexing the given family along
the index map of the resulting combinatorial equivalence; reindexing keeps the arrows literally
equal to arrows of the given family, which is what makes the presieve comparison hold on the
nose. -/
private theorem BigZariskiSite.exists_isCovering_le (B : BigZariskiSite.{u}) {X : B.Schemes}
    (E : PreZeroHypercover.{u + 1} X)
    (hopen : ∀ i, IsOpenImmersion (B.inclusion.map (E.f i)))
    (hE : ∀ x : B.inclusion.obj X, ∃ i, x ∈ Set.range (B.inclusion.map (E.f i))) :
    ∃ E' : PreZeroHypercover.{u + 1} X, B.IsCovering ⟨X, E'⟩ ∧ E'.presieve₀ ≤ E.presieve₀ := by
  obtain ⟨⟨V, F⟩, hF, hV, hce⟩ := B.covering_representative ⟨X, E⟩
    (ofArrows_mem_zariskiPretopology_iff.2 ⟨hE, hopen⟩)
  dsimp only at hV hce
  subst hV
  replace hce : PreZeroHypercover.CombinatoriallyEquivalent E F := hce
  obtain ⟨β, hX, hf⟩ := hce.2
  refine ⟨⟨F.I₀, fun j ↦ E.X (β j), fun j ↦ E.f (β j)⟩, ⟨?_, hF.2⟩, ?_⟩
  · refine ofArrows_mem_zariskiPretopology_iff.2 ⟨fun x ↦ ?_, fun j ↦ hopen (β j)⟩
    obtain ⟨j, hj⟩ := (ofArrows_mem_zariskiPretopology_iff.1 hF.1).1 x
    refine ⟨j, ?_⟩
    have hrange : Set.range (B.inclusion.map (F.f j)) ⊆
        Set.range (B.inclusion.map (E.f (β j))) := by
      rw [hf j, B.inclusion.map_comp]
      rintro _ ⟨y, rfl⟩
      exact ⟨(B.inclusion.map (eqToHom (hX j))).base y, rfl⟩
    exact hrange hj
  · rintro Y g ⟨j⟩
    exact ⟨β j⟩

/-- **A sieve of a big Zariski site whose arrows are open immersions and jointly surjective on
points is a covering sieve.** Only the selected covering families generate the topology, but by
`AlgebraicGeometry.BigZariskiSite.exists_isCovering_le` one of them is refined by the given
arrows. -/
public theorem BigZariskiSite.mem_topology_of_jointlySurjective (B : BigZariskiSite.{u})
    {X : B.Schemes} {R : Sieve X}
    (hR : ∀ x : B.inclusion.obj X, ∃ (Y : B.Schemes) (g : Y ⟶ X), R g ∧
      IsOpenImmersion (B.inclusion.map g) ∧ x ∈ Set.range (B.inclusion.map g)) :
    R ∈ B.grothendieckTopology X := by
  choose Y g hg hgo hx using hR
  obtain ⟨E', hE', hle⟩ := B.exists_isCovering_le
    (X := X) ⟨ULift.{u + 1} (B.inclusion.obj X), fun i ↦ Y i.down, fun i ↦ g i.down⟩
    (fun i ↦ hgo i.down) fun x ↦ ⟨ULift.up x, hx x⟩
  refine B.grothendieckTopology.superset_covering ?_
    (CategoryTheory.Precoverage.generate_mem_toGrothendieck ⟨E', hE', rfl⟩)
  rw [Sieve.generate_le_iff]
  intro Z f hf
  obtain ⟨i⟩ := hle _ f hf
  exact hg i.down

/-- **The sieve generated by a jointly surjective family of open immersions over `S` is a
covering sieve of the big Zariski site over `S`.** This is
`AlgebraicGeometry.BigZariskiSite.mem_topology_of_jointlySurjective` read in the slice: the
`CategoryTheory.Sieve.overEquiv` image of the generated sieve is the sieve generated by the
underlying family of morphisms of `B`. -/
public theorem BigZariskiOver.generate_ofArrows_mem_topology (B : BigZariskiSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) {X : BigZariskiOver B S hS} {K : Type*}
    (V : K → BigZariskiOver B S hS) (v : ∀ k, V k ⟶ X)
    (hopen : ∀ k, IsOpenImmersion (B.inclusion.map (v k).left))
    (hsurj : ∀ y : B.inclusion.obj X.left, ∃ k, y ∈ Set.range (B.inclusion.map (v k).left)) :
    Sieve.generate (Presieve.ofArrows V v) ∈ BigZariskiOver.topology B S hS X := by
  rw [BigZariskiOver.topology_eq_over B ⟨S, hS⟩, GrothendieckTopology.mem_over_iff,
    show Sieve.generate (Presieve.ofArrows V v) = Sieve.ofArrows V v from rfl,
    Sieve.overEquiv_ofArrows]
  refine B.mem_topology_of_jointlySurjective fun x => ?_
  obtain ⟨k, hk⟩ := hsurj x
  exact ⟨(V k).left, (v k).left, Sieve.le_generate _ _ _ (Presieve.ofArrows.mk k),
    hopen k, hk⟩

end AlgebraicGeometry

end
