-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open Stacks.Sheaves.ToposPullback Stacks.Sheaves.ToposPushforward

universe u

namespace AlgebraicGeometry

/-- The sheaf of commutative rings of global functions on a site of schemes over `S`: its value
at an object is the ring `Γ(T, 𝒪_T)` of global functions on the underlying scheme `T`. -/
public noncomputable def commStructureSheaf (S : Scheme.{u}) {C : Type (u + 1)} [Category.{u} C]
    (J : GrothendieckTopology C) (toOver : C ⥤ Over S)
    (h : Presheaf.IsSheaf J (Stacks.Sites.structurePresheaf S toOver)) :
    Sheaf J CommRingCat.{u} :=
  ⟨(toOver ⋙ Over.forget S).op ⋙ Scheme.Γ,
    Presheaf.isSheaf_of_isSheaf_comp J _ (forget₂ CommRingCat.{u} RingCat.{u}) h⟩

/-- A sheaf of commutative rings with its sections raised into a larger universe. The sections
and the restriction maps are the original ones transported through `ULift`, so neither the ring
structure nor the sheaf condition changes. -/
public noncomputable def uliftRingSheaf.{z, r, u₁, v₁} {C : Type u₁} [Category.{v₁} C]
    {J : GrothendieckTopology C} (O : Sheaf J CommRingCat.{r}) :
    Sheaf J CommRingCat.{max r u₁ v₁ z} where
  obj := O.obj ⋙ SheafOfModules.commRingCatULift.{r, max u₁ v₁ z}
  property := by
    have : HasLimitsOfSize.{v₁, max v₁ u₁} CommRingCat.{max r u₁ v₁ z} :=
      hasLimitsOfSizeShrink.{v₁, max v₁ u₁, max r u₁ v₁ z, max r u₁ v₁ z} _
    refine (Presheaf.isSheaf_iff_isSheaf_comp J _ (forget CommRingCat.{max r u₁ v₁ z})).mpr ?_
    change Presheaf.IsSheaf J ((O.obj ⋙ forget CommRingCat.{r}) ⋙ uliftFunctor.{max u₁ v₁ z})
    exact Presheaf.isSheaf_comp_of_isSheaf J _ _
      ((sheafCompose J (forget CommRingCat.{r})).obj O).property

section DenseSubsite

/-- The morphism of topoi induced by a dense subsite inclusion: its inverse image is restriction
along the inclusion, which is an equivalence, and its direct image is the quasi-inverse of that
equivalence. -/
public noncomputable def affineToBigToposHom.{u₁, v₁, u₂, v₂, w}
    {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    (i : C ⥤ D) [i.IsDenseSubsite J K] :
    MorphismOfTopoi (Sheaf J (Type max u₁ v₁ u₂ v₂ w))
      (Sheaf K (Type max u₁ v₁ u₂ v₂ w)) where
  inverseImage := i.sheafPushforwardContinuous (Type max u₁ v₁ u₂ v₂ w) J K
  pushforward :=
    (i.sheafPushforwardContinuous (Type max u₁ v₁ u₂ v₂ w) J K).asEquivalence.inverse
  adj := (i.sheafPushforwardContinuous (Type max u₁ v₁ u₂ v₂ w) J K).asEquivalence.toAdjunction
  preservesFiniteLimits := inferInstance

/-- The inverse image of the morphism of topoi induced by a dense subsite inclusion is
restriction along the inclusion. -/
@[simp]
public theorem affineToBigToposHom_inverseImage.{u₁, v₁, u₂, v₂, w}
    {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    (i : C ⥤ D) [i.IsDenseSubsite J K] :
    (affineToBigToposHom.{u₁, v₁, u₂, v₂, w} J K i).inverseImage =
      i.sheafPushforwardContinuous (Type max u₁ v₁ u₂ v₂ w) J K :=
  rfl

/-- Restriction along a dense subsite inclusion is an equivalence of sheaf topoi, so the induced
morphism of topoi has an equivalence as its inverse image. -/
public theorem isEquivalence_affineToBigToposHom_inverseImage.{u₁, v₁, u₂, v₂, w}
    {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    (i : C ⥤ D) [i.IsDenseSubsite J K] :
    (affineToBigToposHom.{u₁, v₁, u₂, v₂, w} J K i).inverseImage.IsEquivalence :=
  inferInstanceAs
    (i.sheafPushforwardContinuous (Type max u₁ v₁ u₂ v₂ w) J K).IsEquivalence

/-- The affine-to-big morphism of ringed topoi: the morphism of topoi induced by a dense subsite
inclusion, with the restriction of `O` as the structure sheaf of the source and with the
identification of the inverse image of `O` with that restriction as its structure morphism. -/
public noncomputable def affineToBigRingedToposHom.{u₁, v₁, u₂, v₂, w}
    {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    (i : C ⥤ D) [i.IsDenseSubsite J K]
    (O : Sheaf K CommRingCat.{max u₁ v₁ u₂ v₂ w}) :
    RingedToposHom
      ⟨C, J, (i.sheafPushforwardContinuous CommRingCat.{max u₁ v₁ u₂ v₂ w} J K).obj O⟩
      ⟨D, K, O⟩ where
  toToposHom := affineToBigToposHom.{u₁, v₁, u₂, v₂, w} J K i
  fSharp :=
    (commRingImageAdjunction (affineToBigToposHom.{u₁, v₁, u₂, v₂, w} J K i)).homEquiv _ _
      (restrictionCommRingIso J K i O).hom

/-- The inverse-image form of the structure morphism of the affine-to-big morphism of ringed
topoi is the identification of the inverse image of `O` with its restriction. -/
public theorem affineToBigRingedToposHom_fSharpInverseImage.{u₁, v₁, u₂, v₂, w}
    {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    (i : C ⥤ D) [i.IsDenseSubsite J K]
    (O : Sheaf K CommRingCat.{max u₁ v₁ u₂ v₂ w}) :
    (affineToBigRingedToposHom.{u₁, v₁, u₂, v₂, w} J K i O).fSharpInverseImage =
      (restrictionCommRingIso J K i O).hom :=
  ((commRingImageAdjunction
    (affineToBigToposHom.{u₁, v₁, u₂, v₂, w} J K i)).homEquiv _ _).symm_apply_apply _

/-- The structure morphism of the affine-to-big morphism of ringed topoi is an isomorphism. -/
public theorem isIso_affineToBigRingedToposHom_fSharpInverseImage.{u₁, v₁, u₂, v₂, w}
    {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    (i : C ⥤ D) [i.IsDenseSubsite J K]
    (O : Sheaf K CommRingCat.{max u₁ v₁ u₂ v₂ w}) :
    IsIso (affineToBigRingedToposHom.{u₁, v₁, u₂, v₂, w} J K i O).fSharpInverseImage := by
  rw [affineToBigRingedToposHom_fSharpInverseImage]
  exact (restrictionCommRingIso J K i O).isIso_hom

/-- The structure morphism of the affine-to-big morphism of ringed topoi is the identity on
underlying sheaves of sets. -/
public theorem forget_map_affineToBigRingedToposHom_fSharpInverseImage.{u₁, v₁, u₂, v₂, w}
    {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    (i : C ⥤ D) [i.IsDenseSubsite J K]
    (O : Sheaf K CommRingCat.{max u₁ v₁ u₂ v₂ w}) :
    (sheafCompose J (forget CommRingCat.{max u₁ v₁ u₂ v₂ w})).map
        (affineToBigRingedToposHom.{u₁, v₁, u₂, v₂, w} J K i O).fSharpInverseImage =
      𝟙 ((i.sheafPushforwardContinuous (Type max u₁ v₁ u₂ v₂ w) J K).obj
        ((sheafCompose K (forget CommRingCat.{max u₁ v₁ u₂ v₂ w})).obj O)) :=
  (congrArg (sheafCompose J (forget CommRingCat.{max u₁ v₁ u₂ v₂ w})).map
      (affineToBigRingedToposHom_fSharpInverseImage.{u₁, v₁, u₂, v₂, w} J K i O)).trans
    (restrictionCommRingIso_hom_forget J K i O)

end DenseSubsite

/-! ### The five big sites of the source -/

/-- **Stacks 020W, dense-subsite form.** The inclusion of the big affine Zariski site over `S`
into the big Zariski site over `S` exhibits the former as a dense subsite of the latter. -/
public instance bigAffineZariskiInclusion_isDenseSubsite (B : BigZariskiSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) :
    (BigAffineZariski.inclusion B S hS).IsDenseSubsite
      (BigAffineZariski.topology B S hS) (BigZariskiOver.topology B S hS) :=
  (BigAffineZariski.inclusion_isSpecialCocontinuous B S hS).2

/-- **Stacks 021E, dense-subsite form.** The inclusion of the big affine étale site over `S`
into the big étale site over `S` exhibits the former as a dense subsite of the latter. -/
public instance bigAffineEtaleInclusion_isDenseSubsite (B : BigEtaleSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) :
    (BigAffineEtale.inclusion B S hS).IsDenseSubsite
      (BigAffineEtale.topology B S hS) (BigEtaleOver.topology B S hS) :=
  (BigAffineEtale.inclusion_isSpecialCocontinuous B S hS).2

/-- **Stacks 06VC, dense-subsite form.** The inclusion of the big affine smooth site over `S`
into the big smooth site over `S` exhibits the former as a dense subsite of the latter. -/
public instance bigAffineSmoothInclusion_isDenseSubsite (B : BigSmoothSite.{u})
    (S : Scheme.{u}) (hS : S.size < B.cutoff) :
    (BigAffineSmooth.inclusion B S hS).IsDenseSubsite
      (BigAffineSmooth.topology B S hS) (BigSmoothOver.topology B S hS) :=
  (BigAffineSmooth.inclusion_isSpecialCocontinuous B S hS).2

/-- **Stacks 06VD, dense-subsite form.** The inclusion of the big affine syntomic site over `S`
into the big syntomic site over `S` exhibits the former as a dense subsite of the latter. -/
public instance bigAffineSyntomicInclusion_isDenseSubsite (B : BigSyntomicSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) :
    (BigAffineSyntomic.inclusion B S hS).IsDenseSubsite
      (BigAffineSyntomic.topology B S hS) (BigSyntomicOver.topology B S hS) :=
  (BigAffineSyntomic.inclusion_isSpecialCocontinuous B S hS).2

universe w

/-- The inverse image of the affine-to-big morphism of ringed topoi over the big sites is an
equivalence and its structure morphism is an isomorphism. -/
private theorem affineToBigRingedToposHom_isEquivalence_and_isIso
    {C : Type (u + 1)} [Category.{u} C] {D : Type (u + 1)} [Category.{u} D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    (i : C ⥤ D) [i.IsDenseSubsite J K] (O : Sheaf K CommRingCat.{max (u + 1) u w}) :
    (affineToBigRingedToposHom.{u + 1, u, u + 1, u, w} J K i O
        ).toToposHom.inverseImage.IsEquivalence ∧
      IsIso (affineToBigRingedToposHom.{u + 1, u, u + 1, u, w} J K i O).fSharpInverseImage :=
  ⟨isEquivalence_affineToBigToposHom_inverseImage.{u + 1, u, u + 1, u, w} _ _ _,
    isIso_affineToBigRingedToposHom_fSharpInverseImage.{u + 1, u, u + 1, u, w} _ _ _ _⟩

/-- **Stacks 0GZU, Zariski site.** The affine-to-big morphism of ringed topoi over the big
Zariski site of `S` is an equivalence of ringed topoi: its inverse image is an equivalence and
its structure morphism is an isomorphism. -/
@[stacks 0GZU "Zariski site"]
public theorem zariski_affineToBigRingedToposEquivalence
    (B : BigZariskiSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) :
    let f := affineToBigRingedToposHom.{u + 1, u, u + 1, u, w}
      (BigAffineZariski.topology B S hS) (BigZariskiOver.topology B S hS)
      (BigAffineZariski.inclusion B S hS)
      (uliftRingSheaf.{w} (commStructureSheaf S (BigZariskiOver.topology B S hS)
        (Over.post B.inclusion) (BigZariskiOver.structure_isSheaf B S hS)))
    f.toToposHom.inverseImage.IsEquivalence ∧ IsIso f.fSharpInverseImage :=
  affineToBigRingedToposHom_isEquivalence_and_isIso _ _ _ _

/-- **Stacks 0GZU, étale site.** The affine-to-big morphism of ringed topoi over the big étale
site of `S` is an equivalence of ringed topoi: its inverse image is an equivalence and its
structure morphism is an isomorphism. -/
@[stacks 0GZU "étale site"]
public theorem etale_affineToBigRingedToposEquivalence
    (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) :
    let f := affineToBigRingedToposHom.{u + 1, u, u + 1, u, w}
      (BigAffineEtale.topology B S hS) (BigEtaleOver.topology B S hS)
      (BigAffineEtale.inclusion B S hS)
      (uliftRingSheaf.{w} (commStructureSheaf S (BigEtaleOver.topology B S hS)
        (Over.post B.inclusion) (BigEtaleOver.structure_isSheaf B S hS)))
    f.toToposHom.inverseImage.IsEquivalence ∧ IsIso f.fSharpInverseImage :=
  affineToBigRingedToposHom_isEquivalence_and_isIso _ _ _ _

/-- **Stacks 0GZU, smooth site.** The affine-to-big morphism of ringed topoi over the big smooth
site of `S` is an equivalence of ringed topoi: its inverse image is an equivalence and its
structure morphism is an isomorphism. -/
@[stacks 0GZU "smooth site"]
public theorem smooth_affineToBigRingedToposEquivalence
    (B : BigSmoothSite.{u}) (S : Scheme.{u}) (hS : S.size < B.cutoff) :
    let f := affineToBigRingedToposHom.{u + 1, u, u + 1, u, w}
      (BigAffineSmooth.topology B S hS) (BigSmoothOver.topology B S hS)
      (BigAffineSmooth.inclusion B S hS)
      (uliftRingSheaf.{w} (commStructureSheaf S (BigSmoothOver.topology B S hS)
        (Over.post (ObjectProperty.ι _)) (BigSmoothOver.structure_isSheaf B S hS)))
    f.toToposHom.inverseImage.IsEquivalence ∧ IsIso f.fSharpInverseImage :=
  affineToBigRingedToposHom_isEquivalence_and_isIso _ _ _ _

/-- **Stacks 0GZU, syntomic site.** The affine-to-big morphism of ringed topoi over the big
syntomic site of `S` is an equivalence of ringed topoi: its inverse image is an equivalence and
its structure morphism is an isomorphism. -/
@[stacks 0GZU "syntomic site"]
public theorem syntomic_affineToBigRingedToposEquivalence
    (B : BigSyntomicSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) :
    let f := affineToBigRingedToposHom.{u + 1, u, u + 1, u, w}
      (BigAffineSyntomic.topology B S hS) (BigSyntomicOver.topology B S hS)
      (BigAffineSyntomic.inclusion B S hS)
      (uliftRingSheaf.{w} (commStructureSheaf S (BigSyntomicOver.topology B S hS)
        (Over.post B.inclusion) (BigSyntomicOver.structure_isSheaf B S hS)))
    f.toToposHom.inverseImage.IsEquivalence ∧ IsIso f.fSharpInverseImage :=
  affineToBigRingedToposHom_isEquivalence_and_isIso _ _ _ _

/-- **Stacks 0GZU, fppf site.** The affine-to-big morphism of ringed topoi over the big fppf
site of `S` is an equivalence of ringed topoi: its inverse image is an equivalence and its
structure morphism is an isomorphism. -/
@[stacks 0GZU "fppf site"]
public theorem fppf_affineToBigRingedToposEquivalence
    (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) :
    let f := affineToBigRingedToposHom.{u + 1, u, u + 1, u, w}
      (BigAffineFppf.topology B S hS) (BigFppfOver.topology B S hS)
      (BigAffineFppf.inclusion B S hS)
      (uliftRingSheaf.{w} (commStructureSheaf S (BigFppfOver.topology B S hS)
        (Over.post B.inclusion) (BigFppfOver.structure_isSheaf B S hS)))
    f.toToposHom.inverseImage.IsEquivalence ∧ IsIso f.fSharpInverseImage :=
  affineToBigRingedToposHom_isEquivalence_and_isIso _ _ _ _

end AlgebraicGeometry

end
