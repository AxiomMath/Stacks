module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Topologies.BigSites.ChangeOfBigSites
public import StacksFrontier.AlgebraicGeometry.Topologies.BigSites.ZariskiPrecoverage
public import StacksFrontier.AlgebraicGeometry.Descent.QuasiCoherent.TopologyComparison
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.Subcanonical
public import StacksFrontier.AlgebraicGeometry.Topologies.Fpqc.FinerTopologies

/-!
# The five big sites of schemes are subcanonical

A Grothendieck topology is *subcanonical* when every representable presheaf is a sheaf for it.
The big Zariski, étale, smooth, syntomic and fppf sites of
`AlgebraicGeometry.BigSite` all carry the size-bounded full subcategory `Sch_κ` of schemes
with a *chosen* set-sized system of covering families, and each of the five chosen systems
becomes a family of fppf covering families of schemes. So each of the five topologies is
subcanonical by the transport
`CategoryTheory.Precoverage.subcanonical_toGrothendieck_of_fullyFaithful` along the inclusion
`Sch_κ ⥤ Sch`, which is fully faithful and preserves fibre products.

The fppf and étale cases are
`AlgebraicGeometry.BigFppfSite.subcanonical_topology` and
`AlgebraicGeometry.BigEtaleSite.subcanonical_topology`; this file adds the Zariski, smooth and
syntomic cases and then collects all five into one statement for
`AlgebraicGeometry.siteTopology` and `AlgebraicGeometry.overTopology`.

## Main results

* `AlgebraicGeometry.BigZariskiSite.subcanonical_grothendieckTopology`,
  `AlgebraicGeometry.BigSmoothSite.subcanonical_grothendieckTopology` and
  `AlgebraicGeometry.BigSyntomicSite.subcanonical_topology`: the three missing big sites are
  subcanonical.
* `AlgebraicGeometry.BigSite.subcanonical_siteTopology` and
  `AlgebraicGeometry.BigSite.subcanonical_overTopology`: the topology of a big site of any of
  the five topologies, and of its localization at a contained scheme, is subcanonical.
* `AlgebraicGeometry.BigSite.isSheaf_yoneda_obj_overTopology`: the representable presheaf of
  an object of a localized big site is a sheaf, in the form in which the sheaf condition is
  consumed.

## Implementation notes

The localization of each of the five chosen topologies at a contained scheme is subcanonical
because a localization `J.over X` of a subcanonical topology is subcanonical. For the smooth,
syntomic and fppf sites the localized topology is *defined* as `J.over X`, so the instance
applies directly; for the Zariski and the étale sites the localized topology is generated by
its own precoverage, and the identifications
`AlgebraicGeometry.BigZariskiOver.topology_eq_over` and
`AlgebraicGeometry.bigEtaleOver_topology_eq` are used to rewrite it into that shape.

## References

* [Stacks Project, Tag 021N](https://stacks.math.columbia.edu/tag/021N)
* [Stacks Project, Tag 021U](https://stacks.math.columbia.edu/tag/021U)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-- The base change of the presieve of a zero-hypercover along `f`, given by pullback squares,
is refined by the presieve of the zero-hypercover. -/
private theorem factorsThruAlong_presieve₀_of_isPullback {C : Type*} [Category C] {X Y : C}
    {E : PreZeroHypercover.{u + 1} X} {f : Y ⟶ X} {P : E.I₀ → C} {π₁ : ∀ i, P i ⟶ E.X i}
    {π₂ : ∀ i, P i ⟶ Y} (hpb : ∀ i, IsPullback (π₁ i) (π₂ i) (E.f i) f) :
    (⟨E.I₀, P, π₂⟩ : PreZeroHypercover.{u + 1} Y).presieve₀.FactorsThruAlong E.presieve₀ f := by
  rintro Z g ⟨i⟩
  exact ⟨E.X i, π₁ i, E.f i, ⟨i⟩, (hpb i).w⟩

namespace BigZariskiSite

/-- The coverage axiom for the chosen covering families of a big Zariski site: the base change
of a chosen covering family along any morphism of the site is refined by a chosen covering
family.

This is the base-change axiom `AlgebraicGeometry.BigZariskiSite.coverings_isSite` read at the
level of presieves. The fibre products it produces need not be the chosen fibre products of
`Sch_κ`, which is why the conclusion is a refinement rather than an equality of presieves. -/
theorem exists_mem_precoverage_factorsThruAlong (B : BigZariskiSite.{u}) {X Y : B.Schemes}
    (f : Y ⟶ X) (R : Presieve X) (hR : R ∈ B.precoverage X) :
    ∃ T ∈ B.precoverage Y, T.FactorsThruAlong R f := by
  obtain ⟨E, hE, rfl⟩ := hR
  obtain ⟨P, π₁, π₂, hpb, hcov⟩ := B.coverings_isSite.2.2 ⟨X, E⟩ hE Y f
  exact ⟨_, ⟨⟨E.I₀, P, π₂⟩, hcov, rfl⟩, factorsThruAlong_presieve₀_of_isPullback hpb⟩

/-- The topology of a big Zariski site is subcanonical: every representable presheaf on
`Sch_κ` is a sheaf for the chosen Zariski covering families.

A chosen Zariski covering family becomes a family of jointly surjective open immersions of
schemes, hence an fppf covering family, so this is Mathlib's subcanonicality of the fppf
topology on all schemes transported along the inclusion `Sch_κ ⥤ Sch`. -/
@[sga "3 IV 6.1.1" "special case"]
instance subcanonical_grothendieckTopology (B : BigZariskiSite.{u}) :
    B.grothendieckTopology.Subcanonical :=
  B.precoverage.subcanonical_toGrothendieck_of_fullyFaithful Scheme.fppfPrecoverage
    B.inclusion
    (fun _ _ hR => by
      obtain ⟨E, hE, rfl⟩ := hR
      have h := Scheme.zariskiPrecoverage_le_fppfPrecoverage _ hE.1
      rwa [PreZeroHypercover.presieve₀_map] at h)
    B.exists_mem_precoverage_factorsThruAlong

/-- A representable presheaf on the underlying category of a big Zariski site is a sheaf. -/
@[sga "3 IV 6.1.1" "special case"]
theorem isSheaf_yoneda_obj (B : BigZariskiSite.{u}) (X : B.Schemes) :
    Presheaf.IsSheaf B.grothendieckTopology (yoneda.obj X) :=
  (isSheaf_iff_isSheaf_of_type _ _).2
    (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _)

end BigZariskiSite

namespace BigSmoothSite

/-- The coverage axiom for the chosen covering families of a big smooth site: the base change
of a chosen covering family along any morphism of the site is refined by a chosen covering
family.

This is the base-change axiom `AlgebraicGeometry.BigSmoothSite.covering_isSite` read at the
level of presieves. -/
theorem exists_mem_precoverage_factorsThruAlong (B : BigSmoothSite.{u}) {X Y : B.category}
    (f : Y ⟶ X) (R : Presieve X) (hR : R ∈ B.precoverage X) :
    ∃ T ∈ B.precoverage Y, T.FactorsThruAlong R f := by
  obtain ⟨E, hE, rfl⟩ := hR
  obtain ⟨P, π₁, π₂, hpb, hcov⟩ := B.covering_isSite.2.2 ⟨X, E⟩ hE Y f
  exact ⟨_, ⟨⟨E.I₀, P, π₂⟩, hcov, rfl⟩, factorsThruAlong_presieve₀_of_isPullback hpb⟩

/-- The topology of a big smooth site is subcanonical: every representable presheaf on
`Sch_κ` is a sheaf for the chosen smooth covering families.

A chosen smooth covering family becomes an fppf covering family of schemes by
`AlgebraicGeometry.Scheme.smoothPrecoverage_le_fppfPrecoverage`, so this is Mathlib's
subcanonicality of the fppf topology on all schemes transported along the inclusion
`Sch_κ ⥤ Sch`. -/
instance subcanonical_grothendieckTopology (B : BigSmoothSite.{u}) :
    B.grothendieckTopology.Subcanonical :=
  B.precoverage.subcanonical_toGrothendieck_of_fullyFaithful Scheme.fppfPrecoverage
    (schemeBelowInclusion B.cutoff)
    (fun _ _ hR => by
      obtain ⟨E, hE, rfl⟩ := hR
      rw [Precoverage.mem_comap_iff, ← PreZeroHypercover.presieve₀_map]
      exact Scheme.smoothPrecoverage_le_fppfPrecoverage _ hE.1)
    B.exists_mem_precoverage_factorsThruAlong

/-- A representable presheaf on the underlying category of a big smooth site is a sheaf. -/
theorem isSheaf_yoneda_obj (B : BigSmoothSite.{u}) (X : B.category) :
    Presheaf.IsSheaf B.grothendieckTopology (yoneda.obj X) :=
  (isSheaf_iff_isSheaf_of_type _ _).2
    (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _)

end BigSmoothSite

namespace BigSyntomicSite

/-- The coverage axiom for the chosen covering families of a big syntomic site: the base
change of a chosen covering family along any morphism of the site is refined by a chosen
covering family.

This is the base-change axiom `AlgebraicGeometry.BigSyntomicSite.covering_isSite` read at the
level of presieves. -/
theorem exists_mem_precoverage_factorsThruAlong (B : BigSyntomicSite.{u}) {X Y : B.category}
    (f : Y ⟶ X) (R : Presieve X) (hR : R ∈ B.precoverage X) :
    ∃ T ∈ B.precoverage Y, T.FactorsThruAlong R f := by
  obtain ⟨E, rfl, hE⟩ := hR
  obtain ⟨P, π₁, π₂, hpb, hcov⟩ := B.covering_isSite.2.2 ⟨X, E⟩ hE Y f
  exact ⟨_, ⟨⟨E.I₀, P, π₂⟩, rfl, hcov⟩, factorsThruAlong_presieve₀_of_isPullback hpb⟩

/-- The topology of a big syntomic site is subcanonical: every representable presheaf on
`Sch_κ` is a sheaf for the chosen syntomic covering families.

A chosen syntomic covering family becomes an fppf covering family of schemes by
`AlgebraicGeometry.Scheme.syntomicPrecoverage_le_fppfPrecoverage`, so this is Mathlib's
subcanonicality of the fppf topology on all schemes transported along the inclusion
`Sch_κ ⥤ Sch`. -/
instance subcanonical_topology (B : BigSyntomicSite.{u}) : B.topology.Subcanonical :=
  B.precoverage.subcanonical_toGrothendieck_of_fullyFaithful Scheme.fppfPrecoverage
    B.inclusion
    (fun _ _ hR => by
      obtain ⟨E, rfl, hE⟩ := hR
      rw [Precoverage.mem_comap_iff, ← PreZeroHypercover.presieve₀_map]
      exact isSyntomicCovering_mem_fppfPrecoverage _ _ hE.1)
    B.exists_mem_precoverage_factorsThruAlong

/-- A representable presheaf on the underlying category of a big syntomic site is a sheaf. -/
theorem isSheaf_yoneda_obj (B : BigSyntomicSite.{u}) (X : B.category) :
    Presheaf.IsSheaf B.topology (yoneda.obj X) :=
  (isSheaf_iff_isSheaf_of_type _ _).2
    (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _)

end BigSyntomicSite

/-- The topology of the big Zariski site of a scheme contained in a big Zariski site is
subcanonical.

The topology is the localization of the site's topology at the scheme by
`AlgebraicGeometry.BigZariskiOver.topology_eq_over`, and a localization of a subcanonical
topology is subcanonical. -/
instance BigZariskiOver.subcanonical_topology (B : BigZariskiSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) : (BigZariskiOver.topology B S hS).Subcanonical := by
  rw [BigZariskiOver.topology_eq_over B (⟨S, hS⟩ : B.Schemes)]
  infer_instance

/-- The topology of the big smooth site of a scheme contained in a big smooth site is
subcanonical. -/
instance BigSmoothOver.subcanonical_topology (B : BigSmoothSite.{u}) (S : Scheme.{u})
    (hS : S.size < B.cutoff) : (BigSmoothOver.topology B S hS).Subcanonical :=
  inferInstanceAs (B.grothendieckTopology.over (B.base S hS)).Subcanonical

/-- The topology of the big syntomic site of a scheme contained in a big syntomic site is
subcanonical. -/
instance BigSyntomicOver.subcanonical_topology (B : BigSyntomicSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) : (BigSyntomicOver.topology B S hS).Subcanonical :=
  inferInstanceAs (B.topology.over (B.obj S hS)).Subcanonical

namespace BigSite

/-- **Stacks 021N and 021U together.** The topology of a big site is subcanonical, for each of
the five topologies that have big sites.

`AlgebraicGeometry.subcanonical_overTopology` is the fppf case of the localized statement
below, proved independently from the representability of the localized representables. -/
theorem subcanonical_siteTopology (τ : CoveringTopology) (B : BigSite.{u} τ) :
    (siteTopology τ B).Subcanonical := by
  cases τ with
  | zariski => exact BigZariskiSite.subcanonical_grothendieckTopology B
  | etale => exact BigEtaleSite.subcanonical_topology B
  | smooth => exact BigSmoothSite.subcanonical_grothendieckTopology B
  | syntomic => exact BigSyntomicSite.subcanonical_topology B
  | fppf => exact BigFppfSite.subcanonical_topology B

/-- The topology of a big site localized at a contained scheme is subcanonical, for each of
the five topologies that have big sites. -/
instance subcanonical_overTopology (τ : CoveringTopology) (B : BigSite.{u} τ) (S : Scheme.{u})
    (hS : S.size < cutoff τ B) : (overTopology τ B S hS).Subcanonical := by
  cases τ with
  | zariski => exact BigZariskiOver.subcanonical_topology B S hS
  | etale =>
      -- `AlgebraicGeometry.BigEtaleOver.subcanonical_topology` is stated for the localization
      -- `B.topology.over (B.obj S hS)`, whereas `AlgebraicGeometry.BigEtaleOver.topology` is
      -- generated by the slice's own precoverage; the two agree by
      -- `AlgebraicGeometry.bigEtaleOver_topology_eq`.
      change (BigEtaleOver.topology B S hS).Subcanonical
      rw [bigEtaleOver_topology_eq B S hS]
      exact BigEtaleOver.subcanonical_topology B S hS
  | smooth => exact BigSmoothOver.subcanonical_topology B S hS
  | syntomic => exact BigSyntomicOver.subcanonical_topology B S hS
  | fppf => exact BigFppfOver.subcanonical_topology B S hS

/-- A representable presheaf on a big site localized at a contained scheme is a sheaf, in the
`Presheaf.IsSheaf` form in which the sheaf condition is usually stated. -/
theorem isSheaf_yoneda_obj_overTopology (τ : CoveringTopology) (B : BigSite.{u} τ)
    (S : Scheme.{u}) (hS : S.size < cutoff τ B) (X : CategoryTheory.Over (base B S hS)) :
    Presheaf.IsSheaf (overTopology τ B S hS) (yoneda.obj X) :=
  (isSheaf_iff_isSheaf_of_type _ _).2
    (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _)

end BigSite

end AlgebraicGeometry

end
