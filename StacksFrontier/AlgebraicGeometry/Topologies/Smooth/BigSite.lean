module

public import Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import StacksFrontier.AlgebraicGeometry.Size.Cutoff
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale
public import StacksFrontier.CategoryTheory.Sites.Pretopology.SmallSubsite
public import StacksCore.Tactic.StacksAttribute

/-!
# The big smooth site

A big smooth site is a size-bounded full subcategory of schemes together with a chosen bounded
collection of smooth covering families. The cutoff contains a prescribed small set of schemes,
and the chosen coverings contain a prescribed small set of smooth coverings among them.

This is the same construction as for the big Zariski and big étale sites, with the class of
smooth coverings in place of the Zariski or étale ones: a cardinal cutoff makes the category a
set, and a bound on index types makes the collection of admitted covering families a set, while
every smooth covering still has a combinatorially equivalent admitted representative.

## Main definitions

* `AlgebraicGeometry.SmoothCovering` — a family in a cutoff category is jointly surjective and
  consists of smooth morphisms.
* `AlgebraicGeometry.BigSmoothSite` — the choices and conditions defining a big smooth site.
* `AlgebraicGeometry.BigSmoothSite.grothendieckTopology` — the topology generated by its chosen
  covering families.

## Implementation notes

The cutoff category `Sch_α` is `AlgebraicGeometry.SchemeBelow`, the full subcategory of
schemes `X` with `X.size < κ`; the three cutoff fields are the properties supplied by
`AlgebraicGeometry.exists_size_cutoff`. `SmoothCovering` is defined using Mathlib's canonical
smooth precoverage on all schemes, so no separate notion of smooth covering is introduced.

The selected coverings are `CovBounded` applied to the smooth coverings, and the remaining
fields record the conclusions of the set-sized-covering construction, including the prescribed
coverings and the combinatorial representatives. Retaining the families themselves, rather than
only the Grothendieck topology they generate, is essential: different big sites may have
different cutoffs and different chosen bounds while generating comparable topologies.

## References

* [Stacks Project, Tag 03WY](https://stacks.math.columbia.edu/tag/03WY)
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry

/-- A smooth covering in a cutoff category of schemes: after applying the full-subcategory
inclusion, the family is a jointly surjective family of smooth morphisms of schemes. -/
public def SmoothCovering (κ : Cardinal.{u})
    (𝒰 : Covering.{u + 1, u, u + 1} (AlgebraicGeometry.SchemeBelow κ)) : Prop :=
  Presieve.ofArrows (fun i => (𝒰.2.X i).1)
      (fun i => (ObjectProperty.ι _).map (𝒰.2.f i)) ∈
    Scheme.precoverage (@Smooth.{u}) 𝒰.1.1

/-- A big smooth site.

Besides the cutoff category and its selected bounded smooth coverings, this structure records
the initial sets `S₀` and `Cov₀` and all the conditions imposed by the size-cutoff and
set-sized-covering constructions. -/
@[stacks 03WY]
public structure BigSmoothSite where
  /-- The prescribed set `S₀` of schemes. -/
  initialSchemes : Set Scheme.{u}
  /-- The prescribed collection of schemes is small in the ambient universe. -/
  initialSchemes_small : Small.{u} initialSchemes
  /-- The cardinal defining the full subcategory `Sch_κ`. -/
  cutoff : Cardinal.{u}
  /-- The cutoff is uncountable. -/
  aleph0_lt_cutoff : Cardinal.aleph0 < cutoff
  /-- The cutoff is a strong limit cardinal. -/
  cutoff_isStrongPrelimit : Cardinal.IsStrongPrelimit cutoff
  /-- The cutoff has uncountable cofinality. -/
  aleph0_lt_cutoff_cof : Cardinal.aleph0 < cutoff.ord.cof
  /-- Every scheme prescribed in `S₀` belongs to `Sch_κ`. -/
  contains_initialScheme : ∀ X ∈ initialSchemes, X.size < cutoff
  /-- The prescribed set `Cov₀` of smooth covering families among the schemes in `S₀`. -/
  initialCoverings : Set (Covering (AlgebraicGeometry.SchemeBelow cutoff))
  /-- The prescribed collection of coverings is small. -/
  initialCoverings_small : Small.{u + 1} initialCoverings
  /-- Every prescribed covering is smooth. -/
  initialCoverings_smooth : ∀ 𝒰 ∈ initialCoverings, SmoothCovering cutoff 𝒰
  /-- The target and sources of every prescribed covering belong to `S₀`. -/
  initialCoverings_among_initialSchemes : ∀ 𝒰 ∈ initialCoverings,
    𝒰.1.1 ∈ initialSchemes ∧ ∀ i, (𝒰.2.X i).1 ∈ initialSchemes
  /-- The cardinal bound selecting the covering families of the site. -/
  coveringBound : Cardinal.{u + 1}
  /-- The limit ordinal accompanying the selected covering set. -/
  coveringOrdinal : Ordinal.{u + 1}
  /-- The selected ordinal is a limit ordinal. -/
  coveringOrdinal_isSuccLimit : Order.IsSuccLimit coveringOrdinal
  /-- Every prescribed covering belongs to the selected bounded collection. -/
  contains_initialCovering : ∀ 𝒰 ∈ initialCoverings,
    CovBounded (SmoothCovering cutoff) coveringBound 𝒰
  /-- The selected bounded smooth coverings satisfy the site axioms. -/
  covering_isSite : IsSite (CovBounded (SmoothCovering cutoff) coveringBound)
  /-- Every smooth covering is combinatorially equivalent to a selected covering. -/
  has_coveringRepresentative : ∀ 𝒰, SmoothCovering cutoff 𝒰 →
    ∃ 𝒰', CovBounded (SmoothCovering cutoff) coveringBound 𝒰' ∧
      Covering.CombEquiv 𝒰 𝒰'

namespace BigSmoothSite

/-- The underlying category of a big smooth site. -/
public abbrev category (S : BigSmoothSite.{u}) : Type (u + 1) :=
  AlgebraicGeometry.SchemeBelow S.cutoff

/-- The chosen collection of covering families of a big smooth site. -/
public abbrev IsCovering (S : BigSmoothSite.{u}) : Covering S.category → Prop :=
  CovBounded (SmoothCovering S.cutoff) S.coveringBound

/-- The precoverage whose members are the presieves represented by the chosen covering
families. -/
public def precoverage (S : BigSmoothSite.{u}) : Precoverage S.category where
  coverings X := { R | ∃ 𝒰 : PreZeroHypercover.{u + 1} X,
    S.IsCovering ⟨X, 𝒰⟩ ∧ R = 𝒰.presieve₀ }

/-- The Grothendieck topology generated by the chosen smooth covering families. -/
public abbrev grothendieckTopology (S : BigSmoothSite.{u}) :
    GrothendieckTopology S.category :=
  S.precoverage.toGrothendieck

end BigSmoothSite

end AlgebraicGeometry
