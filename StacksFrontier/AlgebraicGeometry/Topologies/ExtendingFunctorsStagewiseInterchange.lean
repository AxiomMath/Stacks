module

public import StacksFrontier.AlgebraicGeometry.Topologies.ExtendingFunctorsStandardAffineInterchange

/-!
# The filtered-colimit interchange, stated stagewise

Let `S` be a scheme, let `𝒞` be a full subcategory of `Sch/S` satisfying conditions (1) and (2)
of Stacks 0EUW and let `F : 𝒞ᵒᵖ ⥤ Set` satisfy conditions (a) and (b). Let an affine object `V`
of `Sch/S` be the limit of a directed inverse system `E` of affine objects with a least stage and
let `{s i : T i ⟶ E_⊥}` be a finite family of morphisms with affine sources. The interchange of
Stacks 0GDW deduces the sheaf condition for the base-changed family `{V ×_{E_⊥} T i ⟶ V}` from
the sheaf condition for the base-changed family at every stage; the deduction uses nothing about
the family beyond the finiteness of its index type and the affineness of its sources.

A family of arrows is also recorded to determine the sheaf condition only through the sieve it
generates, which is how a family identified with a base-changed one only up to refinement in both
directions inherits the conclusion.

## Main results

* `AlgebraicGeometry.ExtendingFunctors.ofArrows_reindex`,
  `AlgebraicGeometry.ExtendingFunctors.generate_ofArrows_le` and
  `AlgebraicGeometry.ExtendingFunctors.isSheafFor_of_generate_eq`: reindexing a family does not
  change the presieve it generates, a family refining a second generates a smaller sieve, and the
  sheaf condition depends only on the generated sieve.
* `AlgebraicGeometry.ExtendingFunctors.comp_hom_of_comp_left`: a morphism of schemes between two
  objects of `Sch/S` over a third is a morphism of `Sch/S`.
* `AlgebraicGeometry.ExtendingFunctors.isSheafFor_pullback_fst_of_stagewise`: the sheaf condition
  for the base change to the limit, from the sheaf condition for the base change to each stage.

## Implementation notes

The three systems `E`, `baseChange E (s i)` and `baseChange E (pullback.fst (s i) (s j) ≫ s i)`,
whose limits are `V`, the members of the base-changed family and their pairwise fibre products,
are carried to filtered colimits by the extension; the finitely many sections and the finitely
many pairwise compatibilities between them are therefore all defined at a common stage, where the
hypothesis applies.

`AlgebraicGeometry.ExtendingFunctors.isSheafFor_pullback_fst_of_presentation` is the instance of
this at a standard `τ`-covering of the least stage, for `τ` one of the five standard topologies;
the sheaf condition at a stage is there supplied by condition (c) of Stacks 0GDW.

## References

* [Stacks Project, Tag 0GDW](https://stacks.math.columbia.edu/tag/0GDW)
* [Stacks Project, Tag 0EUW](https://stacks.math.columbia.edu/tag/0EUW)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe v w u

namespace AlgebraicGeometry.ExtendingFunctors

/-! ### Presieves generated by reindexed and by refined families -/

/-- Reindexing the family generating a presieve along an equivalence of index types does not
change the presieve. -/
theorem ofArrows_reindex {C : Type*} [Category C] {X : C} {ι : Type*} {κ : Type*}
    (Y : ι → C) (f : ∀ i, Y i ⟶ X) (e : κ ≃ ι) :
    Presieve.ofArrows (fun j ↦ Y (e j)) (fun j ↦ f (e j)) = Presieve.ofArrows Y f := by
  refine funext fun Z ↦ funext fun g ↦ propext ⟨?_, ?_⟩
  · rintro ⟨j⟩
    exact Presieve.ofArrows.mk (e j)
  · rintro ⟨i⟩
    obtain ⟨j, rfl⟩ := e.surjective i
    exact Presieve.ofArrows.mk j

/-- A family each of whose members factors through a member of a second family generates a smaller
sieve than the second family does. -/
theorem generate_ofArrows_le {C : Type*} [Category C] {X : C} {ι : Type*} {κ : Type*}
    (Y : ι → C) (f : ∀ i, Y i ⟶ X) (Y' : κ → C) (f' : ∀ j, Y' j ⟶ X) (σ : ι → κ)
    (θ : ∀ i, Y i ⟶ Y' (σ i)) (hθ : ∀ i, θ i ≫ f' (σ i) = f i) :
    Sieve.generate (Presieve.ofArrows Y f) ≤ Sieve.generate (Presieve.ofArrows Y' f') := by
  rw [Sieve.generate_le_iff]
  rintro Z g ⟨i⟩
  exact ⟨Y' (σ i), θ i, f' (σ i), Presieve.ofArrows.mk (σ i), hθ i⟩

/-- The sheaf condition for a family of arrows depends only on the sieve the family generates. -/
theorem isSheafFor_of_generate_eq {C : Type*} [Category C] {G : Cᵒᵖ ⥤ Type w} {X : C}
    {R R' : Presieve X} (h : Sieve.generate R = Sieve.generate R')
    (hR : R.IsSheafFor G) : R'.IsSheafFor G := by
  rw [Presieve.isSheafFor_iff_generate] at hR ⊢
  rwa [← h]

variable {S : Scheme.{u}}

/-- A morphism of schemes between the underlying schemes of two objects of `Sch/S` lying over a
third, compatible with the morphisms to it, is a morphism of `Sch/S`. -/
theorem comp_hom_of_comp_left {V A B : Over S} (a : A ⟶ V) (b : B ⟶ V) (γ : A.left ⟶ B.left)
    (hγ : γ ≫ b.left = a.left) : γ ≫ B.hom = A.hom := by
  rw [← Over.w b, ← Category.assoc, hγ, Over.w a]

/-! ### The interchange -/

/-- **The filtered-colimit interchange of Stacks 0GDW, stated stagewise.** Let `V` be the limit of
a directed inverse system `E` of affine objects of `Sch/S` with a least stage, and let
`{s i : T i ⟶ E_⊥}` be a family, indexed by a finite type, of morphisms with affine sources. If
the extension satisfies the sheaf condition for the base change of the family to every stage of
the system, then it satisfies the sheaf condition for the base change of the family to `V`.

The finitely many sections over the members of the base-changed family and the finitely many
pairwise compatibilities between them are defined at a common stage, where the hypothesis supplies
a section; pushing that section forward to `V` amalgamates the given family, and the same argument
applied to two sections gives uniqueness. -/
theorem isSheafFor_pullback_fst_of_stagewise
    {P : ObjectProperty (Over S)} (F : P.FullSubcategoryᵒᵖ ⥤ Type (max w (u + 1)))
    (hP1 : HasAffineOpens P) (hP2 : HasFinitePresentationAffines P)
    (haF : IsZariskiSheafOnSubcategory P F)
    {M : Type u} [PartialOrder M] [OrderBot M] [IsDirectedOrder M] (E : Mᵒᵖ ⥤ Over S)
    (haff : ∀ m, IsAffine (E.obj m).left) (c : Cone E) (hc : IsLimit c)
    {ι : Type v} [Finite ι] (T : ι → Over S) (s : ∀ i, T i ⟶ E.obj (op (⊥ : M)))
    (hTaff : ∀ i, IsAffine (T i).left)
    (hstage : ∀ m : Mᵒᵖ,
      (Presieve.ofArrows (fun i => Limits.pullback ((toBottom E).app m) (s i))
        (fun i => Limits.pullback.fst ((toBottom E).app m) (s i))).IsSheafFor (extension P F)) :
    (Presieve.ofArrows (fun i => Limits.pullback (c.π.app (op (⊥ : M))) (s i))
      (fun i => Limits.pullback.fst (c.π.app (op (⊥ : M))) (s i))).IsSheafFor
      (extension P F) := by
  classical
  have hne : Nonempty M := ⟨⊥⟩
  have hbotaff : IsAffine (E.obj (op (⊥ : M))).left := haff _
  -- the three systems are carried to filtered colimits
  have hcolE : IsColimit ((extension P F).mapCocone c.op) :=
    (preservesAffineLimits_extension F hP1 hP2 haF M E haff c hc).some
  have hcolW : ∀ i, IsColimit ((extension P F).mapCocone (baseChangeCone E (s i) c).op) :=
    fun i => (nonempty_isColimit_extension_baseChange F hP1 hP2 haF E haff (s i)
      (hTaff i) c hc).some
  have hcolQ : ∀ i j, IsColimit ((extension P F).mapCocone
      (baseChangeCone E (Limits.pullback.fst (s i) (s j) ≫ s i) c).op) := fun i j =>
    (nonempty_isColimit_extension_baseChange F hP1 hP2 haF E haff
      (Limits.pullback.fst (s i) (s j) ≫ s i)
      (isAffine_pullback_left (s i) (s j) hbotaff (hTaff i) (hTaff j)) c hc).some
  have hmove : ∀ {a b : M} (h : a ≤ b) (r : (extension P F).obj (op (E.obj (op a)))),
      (extension P F).map (c.π.app (op a)).op r
        = (extension P F).map (c.π.app (op b)).op
          ((extension P F).map (E.map (homOfLE h).op).op r) := by
    intro a b h r
    rw [map_map_apply, c.w]
  have hlift : ∀ (i : ι) {n : M} (r : (extension P F).obj (op (E.obj (op n)))),
      (extension P F).map (baseChangeConeπ E (s i) c (op n)).op
          ((extension P F).map (Limits.pullback.fst ((toBottom E).app (op n)) (s i)).op r)
        = (extension P F).map (Limits.pullback.fst (c.π.app (op (⊥ : M))) (s i)).op
          ((extension P F).map (c.π.app (op n)).op r) := by
    intro i n r
    simp only [map_map_apply]
    rw [baseChangeConeπ_comp_fst]
  -- uniqueness
  have hsep : (Presieve.ofArrows (fun i => Limits.pullback (c.π.app (op (⊥ : M))) (s i))
      (fun i => Limits.pullback.fst (c.π.app (op (⊥ : M))) (s i))).IsSeparatedFor
      (extension P F) := by
    intro y t₁ t₂ ht₁ ht₂
    obtain ⟨n, r₁, r₂, hr₁, hr₂⟩ :
        ∃ (n : M) (r₁ r₂ : (extension P F).obj (op (E.obj (op n)))),
          (extension P F).map (c.π.app (op n)).op r₁ = t₁ ∧
            (extension P F).map (c.π.app (op n)).op r₂ = t₂ := by
      obtain ⟨n₁, y₁, hy₁⟩ := exists_map_eq_of_isColimit_op (extension P F) E c hcolE t₁
      obtain ⟨n₂, y₂, hy₂⟩ := exists_map_eq_of_isColimit_op (extension P F) E c hcolE t₂
      obtain ⟨n, hn₁, hn₂⟩ := exists_ge_ge n₁ n₂
      refine ⟨n, (extension P F).map (E.map (homOfLE hn₁).op).op y₁,
        (extension P F).map (E.map (homOfLE hn₂).op).op y₂, ?_, ?_⟩
      · rw [← hmove, hy₁]
      · rw [← hmove, hy₂]
    have hEq : ∀ i, (extension P F).map (baseChangeConeπ E (s i) c (op n)).op
          ((extension P F).map
            (Limits.pullback.fst ((toBottom E).app (op n)) (s i)).op r₁)
        = (extension P F).map (baseChangeConeπ E (s i) c (op n)).op
          ((extension P F).map
            (Limits.pullback.fst ((toBottom E).app (op n)) (s i)).op r₂) := by
      intro i
      rw [hlift, hlift, hr₁, hr₂, ht₁ _ (Presieve.ofArrows.mk i), ht₂ _ (Presieve.ofArrows.mk i)]
    have hone : ∀ i, ∃ (q : M) (hq : n ≤ q),
        (extension P F).map
            (Limits.pullback.fst ((toBottom E).app (op q)) (s i)).op
            ((extension P F).map (E.map (homOfLE hq).op).op r₁)
          = (extension P F).map
            (Limits.pullback.fst ((toBottom E).app (op q)) (s i)).op
            ((extension P F).map (E.map (homOfLE hq).op).op r₂) := by
      intro i
      obtain ⟨q, hq, hqe⟩ := exists_le_map_baseChangeTrans_eq E (s i) c (hcolW i) _ _ (hEq i)
      refine ⟨q, hq, ?_⟩
      rw [← map_baseChange_fst_push E (s i) hq r₁, ← map_baseChange_fst_push E (s i) hq r₂]
      exact hqe
    choose q hq hqe using hone
    obtain ⟨q₀, hq₀⟩ := Finite.exists_le q
    obtain ⟨Q, hnQ, hq₀Q⟩ := exists_ge_ge n q₀
    have hqQ : ∀ i, q i ≤ Q := fun i => le_trans (hq₀ i) hq₀Q
    have hQe : ∀ i, (extension P F).map
          (Limits.pullback.fst ((toBottom E).app (op Q)) (s i)).op
          ((extension P F).map (E.map (homOfLE hnQ).op).op r₁)
        = (extension P F).map
          (Limits.pullback.fst ((toBottom E).app (op Q)) (s i)).op
          ((extension P F).map (E.map (homOfLE hnQ).op).op r₂) := by
      intro i
      rw [← map_system_map_apply E (hq i) (hqQ i) hnQ r₁,
        ← map_system_map_apply E (hq i) (hqQ i) hnQ r₂,
        ← map_baseChange_fst_push E (s i) (hqQ i)
          ((extension P F).map (E.map (homOfLE (hq i)).op).op r₁),
        ← map_baseChange_fst_push E (s i) (hqQ i)
          ((extension P F).map (E.map (homOfLE (hq i)).op).op r₂),
        hqe i]
    have hRQ : (extension P F).map (E.map (homOfLE hnQ).op).op r₁
        = (extension P F).map (E.map (homOfLE hnQ).op).op r₂ := by
      refine (hstage (op Q)).isSeparatedFor.ext ?_
      intro A h hh
      obtain ⟨i⟩ := hh
      exact hQe i
    rw [← hr₁, ← hr₂, hmove hnQ r₁, hmove hnQ r₂, hRQ]
  -- existence
  refine hsep.isSheafFor ?_
  intro x hx
  obtain ⟨m₀, z, hz⟩ : ∃ (m₀ : ι → M) (z : ∀ i, (extension P F).obj
        (op (Limits.pullback ((toBottom E).app (op (m₀ i))) (s i)))),
      ∀ i, (extension P F).map (baseChangeConeπ E (s i) c (op (m₀ i))).op (z i)
        = x _ (Presieve.ofArrows.mk i) := by
    choose m₀ z hz using fun i => exists_map_baseChangeConeπ_eq E (s i) c (hcolW i)
      (x _ (Presieve.ofArrows.mk i))
    exact ⟨m₀, z, hz⟩
  obtain ⟨m₁, hm₁⟩ := Finite.exists_le m₀
  obtain ⟨w, hw⟩ : ∃ w : ∀ i, (extension P F).obj
        (op (Limits.pullback ((toBottom E).app (op m₁)) (s i))),
      ∀ i, (extension P F).map (baseChangeConeπ E (s i) c (op m₁)).op (w i)
        = x _ (Presieve.ofArrows.mk i) := by
    refine ⟨fun i => (extension P F).map
      (baseChangeTrans E (s i) (homOfLE (hm₁ i)).op).op (z i), fun i => ?_⟩
    rw [map_map_apply, baseChangeConeπ_comp_trans, hz i]
  obtain ⟨m₂, hm₁₂, W₂, hW₂c, hW₂y⟩ :
      ∃ (m₂ : M) (_ : m₁ ≤ m₂) (W₂ : ∀ i, (extension P F).obj
          (op (Limits.pullback ((toBottom E).app (op m₂)) (s i)))),
        (∀ i j, (extension P F).map
              (baseChangeInterFst ((toBottom E).app (op m₂)) (s i) (s j)).op (W₂ i)
            = (extension P F).map
              (baseChangeInterSnd ((toBottom E).app (op m₂)) (s i) (s j)).op (W₂ j)) ∧
          ∀ i, (extension P F).map (baseChangeConeπ E (s i) c (op m₂)).op (W₂ i)
            = x _ (Presieve.ofArrows.mk i) := by
    have hmid : ∀ i j, (extension P F).map
          (baseChangeConeπ E (Limits.pullback.fst (s i) (s j) ≫ s i) c (op m₁)).op
          ((extension P F).map
            (baseChangeInterFst ((toBottom E).app (op m₁)) (s i) (s j)).op (w i))
        = (extension P F).map
          (baseChangeConeπ E (Limits.pullback.fst (s i) (s j) ≫ s i) c (op m₁)).op
          ((extension P F).map
            (baseChangeInterSnd ((toBottom E).app (op m₁)) (s i) (s j)).op (w j)) := by
      intro i j
      have e₁ := hx (baseChangeInterFst (c.π.app (op (⊥ : M))) (s i) (s j))
        (baseChangeInterSnd (c.π.app (op (⊥ : M))) (s i) (s j))
        (Presieve.ofArrows.mk i) (Presieve.ofArrows.mk j)
        (baseChangeInter_condition (c.π.app (op (⊥ : M))) (s i) (s j))
      rw [← hw i, ← hw j] at e₁
      simp only [map_map_apply] at e₁
      simp only [map_map_apply]
      rw [baseChangeInterFst_cone, baseChangeInterSnd_cone]
      exact e₁
    have hpair : ∀ i j, ∃ (k : M) (hk : m₁ ≤ k),
        (extension P F).map
            (baseChangeInterFst ((toBottom E).app (op k)) (s i) (s j)).op
            ((extension P F).map (baseChangeTrans E (s i) (homOfLE hk).op).op (w i))
          = (extension P F).map
            (baseChangeInterSnd ((toBottom E).app (op k)) (s i) (s j)).op
            ((extension P F).map (baseChangeTrans E (s j) (homOfLE hk).op).op (w j)) := by
      intro i j
      obtain ⟨k, hk, hke⟩ := exists_le_map_baseChangeTrans_eq E
        (Limits.pullback.fst (s i) (s j) ≫ s i) c (hcolQ i j) _ _ (hmid i j)
      refine ⟨k, hk, ?_⟩
      simp only [map_map_apply] at hke
      simp only [map_map_apply]
      rw [← baseChangeInterFst_naturality, ← baseChangeInterSnd_naturality]
      exact hke
    choose k hk hke using hpair
    obtain ⟨p₀, hp₀⟩ := Finite.exists_le (fun pr : ι × ι => k pr.1 pr.2)
    obtain ⟨m₂, hm₁₂, hp₀m₂⟩ := exists_ge_ge m₁ p₀
    refine ⟨m₂, hm₁₂, fun i => (extension P F).map
      (baseChangeTrans E (s i) (homOfLE hm₁₂).op).op (w i), fun i j => ?_, fun i => ?_⟩
    · dsimp only
      have hle : k i j ≤ m₂ := le_trans (hp₀ (i, j)) hp₀m₂
      rw [← map_baseChangeTrans_apply E (s i) (hk i j) hle hm₁₂ (w i),
        ← map_baseChangeTrans_apply E (s j) (hk i j) hle hm₁₂ (w j)]
      exact map_baseChangeInter_eq_of_le E (s i) (s j) hle _ _ (hke i j)
    · dsimp only
      rw [map_map_apply, baseChangeConeπ_comp_trans, hw i]
  have hfull : ∀ (i j : ι) (A : Over S)
      (α : A ⟶ Limits.pullback ((toBottom E).app (op m₂)) (s i))
      (β : A ⟶ Limits.pullback ((toBottom E).app (op m₂)) (s j)),
      α ≫ Limits.pullback.fst ((toBottom E).app (op m₂)) (s i)
          = β ≫ Limits.pullback.fst ((toBottom E).app (op m₂)) (s j) →
      (extension P F).map α.op (W₂ i) = (extension P F).map β.op (W₂ j) := by
    intro i j A α β hαβ
    obtain ⟨γ, hγ₁, hγ₂⟩ := exists_lift_baseChangeInter ((toBottom E).app (op m₂))
      (s i) (s j) α β hαβ
    rw [← hγ₁, ← hγ₂,
      ← map_map_apply (extension P F) γ
        (baseChangeInterFst ((toBottom E).app (op m₂)) (s i) (s j)) (W₂ i),
      ← map_map_apply (extension P F) γ
        (baseChangeInterSnd ((toBottom E).app (op m₂)) (s i) (s j)) (W₂ j),
      hW₂c i j]
  obtain ⟨t, ht⟩ := exists_section_of_isSheafFor_ofArrows
    (fun i => Limits.pullback ((toBottom E).app (op m₂)) (s i))
    (fun i => Limits.pullback.fst ((toBottom E).app (op m₂)) (s i))
    (hstage (op m₂)) W₂ hfull
  refine ⟨(extension P F).map (c.π.app (op m₂)).op t, ?_⟩
  intro A h hh
  obtain ⟨i⟩ := hh
  rw [← hlift i, ht i, hW₂y i]


end AlgebraicGeometry.ExtendingFunctors

end
