module

public import StacksFrontier.AlgebraicGeometry.Descent.QuasiCoherent.FpqcCoveringSiteSheaves
public import StacksFrontier.AlgebraicGeometry.Topologies.AssociatedModuleSliceConditions

/-!
# The two sheaf assertions of Tag 03OJ with fibre products along coverings only

Let `S` be a scheme and let a site of schemes over `S` be given by a precoverage `K` on a
category `C` and a functor `toOver : C ⥤ Over S`.  The sheaf condition for `K` only involves the
fibre products `Uᵢ ×_U V` of a covering `{Uᵢ ⟶ U}` along an arrow `V ⟶ U`, which exist by the
site axioms (Stacks 00VH (3), `CategoryTheory.Precoverage.HasPullbacks`).  This file proves that
the presheaf `𝒪` and the presheaves `Fᵃ` of a quasi-coherent module `F` on `S` are sheaves on such
a site, assuming of the fibre products only that **the fibre products along covering arrows are
fibre products of schemes** (`Stacks.Sites.PreservesCoveringFibreProducts`), and not that `C` has
all fibre products.

That assumption cannot be dropped:
`StacksFrontier.AlgebraicGeometry.Topologies.SiteFibreProductCounterexample` gives a site
satisfying the four conditions of Tag 03OJ and the site axioms on which `𝒪` is not a
sheaf, because there the fibre product of the site along a covering arrow is not the fibre product
of schemes.  On the big sites of the Topologies chapter (Definitions 020S, 021A, 03WY, 03X1 and
021R) the underlying category is closed under fibre products in `Sch/S`, so the assumption holds
there.

## Main definitions

* `Stacks.Sites.PreservesCoveringFibreProducts`: a functor preserves the fibre products along the
  covering arrows of a precoverage.

## Main results

* `Stacks.Sites.isSheaf_type_op_comp_of_preservesCoveringFibreProducts`: the restriction of a sheaf
  of types along a functor preserving the fibre products along covering arrows, and sending
  covering families to covering families, is a sheaf.
* `Stacks.Sites.isSheaf_structurePresheaf_of_preservesCoveringFibreProducts`: **the first assertion
  of Tag 03OJ**, `𝒪` is a sheaf.
* `Stacks.Sites.isSheaf_associatedPresheaf_of_preservesCoveringFibreProducts`: `Fᵃ` is a sheaf.
* `Stacks.Sites.preservesCoveringFibreProducts_comap_overForget`: the assumption passes to slices.

## References

* [Stacks Project, Tag 00VH](https://stacks.math.columbia.edu/tag/00VH)
* [Stacks Project, Tag 03OJ](https://stacks.math.columbia.edu/tag/03OJ)
* [Stacks Project, Tag 03DT](https://stacks.math.columbia.edu/tag/03DT)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe w v₁ v₂ u₁ u₂ u

namespace Stacks.Sites

open _root_.AlgebraicGeometry

/-! ### Fibre products along covering arrows -/

section Transfer

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]

/-- **A functor preserves the fibre products along covering arrows of a precoverage `K`**: for a
covering family `R` of `T`, an arrow `f` of `R` and any arrow `g` with target `T`, every pullback
square of `f` and `g` in `C` is sent to a pullback square.  These are exactly the fibre products
whose existence the site axioms guarantee (Stacks 00VH (3)). -/
def PreservesCoveringFibreProducts (K : Precoverage C) (G : C ⥤ D) : Prop :=
  ∀ ⦃T Y Z P : C⦄ (R : Presieve T), R ∈ K T → ∀ ⦃f : Y ⟶ T⦄, R f → ∀ (g : Z ⟶ T)
    (fst : P ⟶ Y) (snd : P ⟶ Z), IsPullback fst snd f g →
      IsPullback (G.map fst) (G.map snd) (G.map f) (G.map g)

/-- **Restriction of a sheaf of types along a functor preserving the fibre products along covering
arrows.**  If `G` sends each covering family of `K` to a family generating a covering sieve of
`L`, and preserves the fibre products along covering arrows, then `G.op ⋙ P` is a sheaf for the
topology generated by `K` whenever `P` is a sheaf for `L`.  The compatibility of a family on the
image of a covering is tested on the fibre products of the covering, which `G` preserves. -/
theorem isSheaf_type_op_comp_of_preservesCoveringFibreProducts (K : Precoverage C) [K.HasPullbacks]
    [K.IsStableUnderBaseChange] {G : C ⥤ D} (hG : PreservesCoveringFibreProducts K G)
    {L : GrothendieckTopology D} (P : Dᵒᵖ ⥤ Type w) (hP : Presieve.IsSheaf L P)
    (h : ∀ ⦃Y : C⦄ (R : Presieve Y), R ∈ K Y → Sieve.generate (R.map G) ∈ L (G.obj Y)) :
    Presieve.IsSheaf K.toGrothendieck (G.op ⋙ P) := by
  rw [Precoverage.isSheaf_toGrothendieck_iff_of_isStableUnderBaseChange]
  intro Y R hR
  have hRG : (R.map G).IsSheafFor P :=
    (Presieve.isSheafFor_iff_generate _).2 (hP _ (h R hR))
  obtain ⟨ι, X, π, rfl⟩ := R.exists_eq_ofArrows
  rw [Presieve.map_ofArrows, Presieve.isSheafFor_arrows_iff] at hRG
  rw [Presieve.isSheafFor_arrows_iff]
  intro x hx
  refine hRG x fun i j Z gi gj hij => ?_
  have := K.hasPullbacks_of_mem (π j) hR
  have : HasPullback (π i) (π j) := Presieve.hasPullback (π j) (Presieve.ofArrows.mk i)
  have hpb := hG _ hR (Presieve.ofArrows.mk i) (π j) _ _ (IsPullback.of_hasPullback (π i) (π j))
  have hc : P.map (G.map (pullback.fst (π i) (π j))).op (x i) =
      P.map (G.map (pullback.snd (π i) (π j))).op (x j) :=
    hx i j _ (pullback.fst _ _) (pullback.snd _ _) pullback.condition
  have e : ∀ {W V : D} (l : Z ⟶ W) (m : W ⟶ V) (y : P.obj (op V)),
      P.map (l ≫ m).op y = P.map l.op (P.map m.op y) := fun l m y => by
    rw [op_comp, Functor.map_comp_apply]
  have h₁ := hpb.lift_fst gi gj hij
  have h₂ := hpb.lift_snd gi gj hij
  generalize hpb.lift gi gj hij = l at h₁ h₂
  subst h₁ h₂
  rw [e, e, hc]

variable {K : Precoverage C}

/-- **The fibre products along covering arrows pass to the slices.**  A covering family of the
slice at `X` is a family whose image in `C` is covering, `CategoryTheory.Over.forget X` preserves
pullbacks, and so the fibre products of the slice along covering arrows are fibre products of `C`
along covering arrows. -/
theorem preservesCoveringFibreProducts_comap_overForget {G : C ⥤ D}
    (hG : PreservesCoveringFibreProducts K G) (X : C) :
    PreservesCoveringFibreProducts (K.comap (Over.forget X)) (Over.forget X ⋙ G) :=
  fun _ _ _ _ R hR _ hf g _ _ h =>
    hG (R.map (Over.forget X)) (Precoverage.mem_comap_iff.1 hR) (Presieve.map_map hf)
      ((Over.forget X).map g) _ _ (h.map (Over.forget X))

end Transfer

/-! ### A site of schemes whose coverings are fpqc coverings -/

section Fpqc

variable {C : Type (u + 1)} [Category.{u} C] {S : Scheme.{u}} (K : Precoverage C)
  (toOver : C ⥤ Over S)
  (hfpqc : ∀ (T : C) (Q : Presieve T), Q ∈ K T →
    Presieve.map (toOver ⋙ Over.forget S) Q ∈ Scheme.fpqcPrecoverage.{u} ((toOver.obj T).left))

include hfpqc in
/-- The sieve generated in the schemes over `S` by the image of a covering family of the site is
covering for the fpqc topology induced on `Over S`: its image in all schemes is the sieve generated
by the image of the family, which is an fpqc covering family. -/
theorem generate_map_toOver_mem_fpqcOver ⦃T : C⦄ (R : Presieve T) (hR : R ∈ K T) :
    Sieve.generate (R.map toOver) ∈ (Scheme.fpqcTopology.{u}.over S) (toOver.obj T) := by
  rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_apply,
    Sieve.generate_map_eq_functorPushforward, ← Sieve.functorPushforward_comp,
    ← Sieve.generate_map_eq_functorPushforward]
  exact Precoverage.generate_mem_toGrothendieck (hfpqc T R hR)

variable {K toOver}

/-- The fibre products along covering arrows, read in the schemes over `S`: a pullback square of
schemes over `S` is a pullback square of schemes, by `CategoryTheory.Over.forget` reflecting
connected limits. -/
theorem preservesCoveringFibreProducts_toOver
    (hpres : PreservesCoveringFibreProducts K (toOver ⋙ Over.forget S)) :
    PreservesCoveringFibreProducts K toOver :=
  fun _ _ _ _ R hR _ hf g fst snd h =>
    IsPullback.of_map (Over.forget S) (by rw [← toOver.map_comp, ← toOver.map_comp, h.w])
      (hpres R hR hf g fst snd h)

variable (K toOver) [K.HasPullbacks] [K.IsStableUnderBaseChange]

include hfpqc in
/-- **Tag 03OJ, the first assertion: the presheaf `𝒪` is a sheaf** on a site of schemes over `S`
whose coverings are fpqc coverings of schemes, provided its fibre products along covering arrows
are fibre products of schemes.  Global functions are an fpqc sheaf on the schemes over `S`
(`Stacks.Sites.isSheaf_fpqcOver_globalSections`), and restricting along `toOver` keeps the sheaf
condition on each covering family, whose fibre products are those of schemes. -/
theorem isSheaf_structurePresheaf_of_preservesCoveringFibreProducts
    (hpres : PreservesCoveringFibreProducts K (toOver ⋙ Over.forget S)) :
    Presheaf.IsSheaf K.toGrothendieck (structurePresheaf S toOver) :=
  isSheaf_structurePresheaf S K.toGrothendieck toOver
    ((isSheaf_iff_isSheaf_of_type _ _).2
      (isSheaf_type_op_comp_of_preservesCoveringFibreProducts K
        (preservesCoveringFibreProducts_toOver hpres) (globalSectionsOver S)
        ((isSheaf_iff_isSheaf_of_type _ _).1 (isSheaf_fpqcOver_globalSections S))
        (generate_map_toOver_mem_fpqcOver K toOver hfpqc)))

include hfpqc in
/-- **The presheaf `Fᵃ` of a quasi-coherent module `F` on `S` is a sheaf** on a site of schemes
over `S` whose coverings are fpqc coverings of schemes, provided its fibre products along covering
arrows are fibre products of schemes.  The pullback sections of `F` are an fpqc sheaf on the
schemes over `S` (`AlgebraicGeometry.quasiCoherentPresheafIsoPresheafHom` and
`AlgebraicGeometry.isSheaf_presheafHom'`), restricted along `toOver` as for `𝒪`. -/
theorem isSheaf_associatedPresheaf_of_preservesCoveringFibreProducts
    (hpres : PreservesCoveringFibreProducts K (toOver ⋙ Over.forget S)) (F : S.Modules)
    [F.IsQuasicoherent] :
    Presheaf.IsSheaf K.toGrothendieck (associatedPresheaf S F toOver) := by
  have htype : Presheaf.IsSheaf (Scheme.fpqcTopology.{u}.over S)
      (quasiCoherentPresheafFunctor S F ⋙ CategoryTheory.forget AddCommGrpCat) :=
    (Presheaf.isSheaf_of_iso_iff (quasiCoherentPresheafIsoPresheafHom F)).mpr
      (isSheaf_presheafHom' (Scheme.unitModule S) F)
  exact isSheaf_addCommGrpCat_of_isSheaf_forget _ _
    (isSheaf_type_op_comp_of_preservesCoveringFibreProducts K
      (preservesCoveringFibreProducts_toOver hpres)
      (quasiCoherentPresheafFunctor S F ⋙ CategoryTheory.forget AddCommGrpCat)
      ((isSheaf_iff_isSheaf_of_type _ _).1 htype)
      (generate_map_toOver_mem_fpqcOver K toOver hfpqc))

end Fpqc

end Stacks.Sites

end
