module

public import StacksFrontier.AlgebraicGeometry.Topologies.FpqcQuasicoherentSheaf

/-!
# An fpqc sheaf on the schemes over `S` restricts to a sheaf on the small étale site

The canonical functor from the small étale site of `S` to the schemes over `S` is continuous
for the fpqc topology, so restriction along it carries a sheaf of any target category to a
sheaf on the small étale site.

The continuity statement is obtained from a general criterion: a functor creating pairwise
pullbacks is continuous for the topology generated by a precoverage whose members have covering
image.  Unlike the compatible-preserving route of
`AlgebraicGeometry.SmallEtale.compatiblePreserving_toOver`, which fixes the universe of the
sheaf of types, `CategoryTheory.Functor.IsContinuous` is universe-free, so the resulting sheaf
statement holds for presheaves of types in an arbitrary universe and for presheaves valued in
an arbitrary category.

## Main results

* `Stacks.Sites.isSheaf_toGrothendieck_of_precoverage_le`: if the image under `F` of every
  member of a precoverage `J` generates a `K`-covering sieve, then restriction along `F` carries
  a `K`-sheaf to a sheaf for the topology generated by `J`.
* `Stacks.Sites.isContinuous_toGrothendieck_of_precoverage_le`: the same hypothesis makes `F`
  a continuous functor.
* `AlgebraicGeometry.SmallEtale.isContinuous_toOver`: the canonical functor from the small étale
  site of `S` to the schemes over `S` is continuous for the fpqc topology.
* `AlgebraicGeometry.isSheaf_chosenSmallEtale_of_isSheaf_fpqc`: restriction of an fpqc sheaf on
  the schemes over `S` to the chosen small étale site of `S` is a sheaf.

## Implementation notes

The covering hypothesis is exactly `AlgebraicGeometry.SmallEtale.functorPushforward_toOver_mem`,
which is already available, so nothing about étale coverings is redone here: the image of a
covering family of the small étale site is an étale covering of schemes, hence an fpqc covering.

`CategoryTheory.Precoverage.HasPullbacks` of the comapped precoverage needs `F` to *create*
pairwise pullbacks, not merely to preserve them, which is why the criterion asks for
`CategoryTheory.Limits.CreatesLimitsOfShape`.  For the functor to the schemes over `S` that
holds because it is fully faithful and `CategoryTheory.Over.forget` reflects the connected
limit along which pullbacks of the small étale site are computed.

## References

* [Stacks Project, Tag 03O4](https://stacks.math.columbia.edu/tag/03O4)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe w u₁ v₁ u₂ v₂ u v

namespace Stacks.Sites

section PrecoverageContinuity

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D] [HasPullbacks D]

/-- Restriction along a functor `F` creating pairwise pullbacks carries a `K`-sheaf to a sheaf
for the topology generated by a precoverage `J`, as soon as the image under `F` of every member
of `J` generates a `K`-covering sieve.  The hypothesis is stated for the generating families of
`J` rather than for all covering sieves of the generated topology, which is what a site
presented by covering families supplies. -/
public theorem isSheaf_toGrothendieck_of_precoverage_le (J : Precoverage C)
    (K : GrothendieckTopology D) (F : C ⥤ D) [CreatesLimitsOfShape WalkingCospan F]
    (P : Dᵒᵖ ⥤ Type w) (hP : Presheaf.IsSheaf K P) (hJ : J ≤ K.toPrecoverage.comap F) :
    Presheaf.IsSheaf J.toGrothendieck (F.op ⋙ P) := by
  let Q := K.toPrecoverage.comap F
  let : Q.IsStableUnderBaseChange := by dsimp only [Q]; infer_instance
  let : Q.HasPullbacks := by dsimp only [Q]; infer_instance
  let : Q.PullbacksPreservedBy F := by dsimp only [Q]; infer_instance
  let : F.IsContinuous Q.toGrothendieck K.toPrecoverage.toGrothendieck :=
    Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy F Q K.toPrecoverage le_rfl
  have hP' : Presheaf.IsSheaf K.toPrecoverage.toGrothendieck P :=
    Presheaf.IsSheaf.of_le (GrothendieckTopology.toGrothendieck_toPrecoverage_le K) hP
  exact Presheaf.IsSheaf.of_le (Precoverage.toGrothendieck_mono hJ)
    (F.op_comp_isSheaf_of_isSheaf Q.toGrothendieck K.toPrecoverage.toGrothendieck P hP')

/-- A functor creating pairwise pullbacks is continuous from the topology generated by a
precoverage `J` to a topology `K` as soon as the image under it of every member of `J` generates
a `K`-covering sieve. -/
public theorem isContinuous_toGrothendieck_of_precoverage_le (J : Precoverage C)
    (K : GrothendieckTopology D) (F : C ⥤ D) [CreatesLimitsOfShape WalkingCospan F]
    (hJ : J ≤ K.toPrecoverage.comap F) :
    F.IsContinuous J.toGrothendieck K where
  op_comp_isSheaf_of_types P :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      (isSheaf_toGrothendieck_of_precoverage_le J K F P.obj P.property hJ)

end PrecoverageContinuity

end Stacks.Sites

namespace AlgebraicGeometry

variable (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

namespace SmallEtale

/-- The canonical functor from the small étale site of `S` to the schemes over `S` creates
pairwise pullbacks: it is fully faithful, and it preserves pairwise pullbacks because
`CategoryTheory.Over.forget` reflects them and the composite with it is the canonical functor to
all schemes. -/
public noncomputable instance createsLimitsOfShape_toOver :
    CreatesLimitsOfShape WalkingCospan
      (inclusion B S hS ⋙ Over.post (X := B.obj S hS) B.inclusion) := by
  have : PreservesLimitsOfShape WalkingCospan
      ((inclusion B S hS ⋙ Over.post (X := B.obj S hS) B.inclusion) ⋙ Over.forget S) :=
    inferInstanceAs (PreservesLimitsOfShape WalkingCospan (toScheme B S hS))
  have : PreservesLimitsOfShape WalkingCospan
      (inclusion B S hS ⋙ Over.post (X := B.obj S hS) B.inclusion) :=
    preservesLimitsOfShape_of_reflects_of_preserves _ (Over.forget S)
  exact ⟨fun {_} => createsLimitOfFullyFaithfulOfPreserves⟩

/-- The covering families of the small étale site of `S` are fpqc covering families of the
schemes over `S`, in the form the continuity criterion asks for. -/
public theorem precoverage_le_comap_toOver :
    precoverage B S hS ≤
      (Scheme.fpqcTopology.{u}.over S).toPrecoverage.comap
        (inclusion B S hS ⋙ Over.post (X := B.obj S hS) B.inclusion) := by
  intro X R hR
  rw [Precoverage.mem_comap_iff, GrothendieckTopology.mem_toPrecoverage_iff,
    Sieve.generate_map_eq_functorPushforward]
  exact functorPushforward_toOver_mem B S hS hR

/-- **The site half of Tag 03O4 for the small étale site.** The canonical functor from the small
étale site of `S` to the schemes over `S` is continuous for the fpqc topology.

Stated in the unfolded spelling of `AlgebraicGeometry.SmallEtale.toOver`, which is the spelling
instance synthesis can use; see `AlgebraicGeometry.SmallEtale.isContinuous_toOver'` for the
abbreviated one. -/
public instance isContinuous_toOver :
    (inclusion B S hS ⋙ Over.post (X := B.obj S hS) B.inclusion).IsContinuous
      (topology B S hS) (Scheme.fpqcTopology.{u}.over S) :=
  Stacks.Sites.isContinuous_toGrothendieck_of_precoverage_le _ _ _
    (precoverage_le_comap_toOver B S hS)

/-- `AlgebraicGeometry.SmallEtale.isContinuous_toOver` at the abbreviated spelling of the
functor.  Both are needed as instances: the two are `rfl`-equal, but instance synthesis at one
spelling does not find the instance stated at the other, because the `CategoryTheory.Over.post`
factor carries its base object implicitly. -/
public instance isContinuous_toOver' :
    (toOver B S hS).IsContinuous (topology B S hS) (Scheme.fpqcTopology.{u}.over S) :=
  isContinuous_toOver B S hS

end SmallEtale

/-- **Stacks 03O4.** Restriction of an fpqc sheaf to a chosen small étale site is a sheaf. -/
@[stacks 03O4 "chosen small étale sheaves"]
public theorem isSheaf_chosenSmallEtale_of_isSheaf_fpqc
    (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (Over S)ᵒᵖ ⥤ Type v)
    (hF : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) F) :
    Presheaf.IsSheaf (SmallEtale.topology B S hS)
      ((SmallEtale.inclusion B S hS ⋙
        Over.post (X := B.obj S hS) B.inclusion).op ⋙ F) :=
  Functor.op_comp_isSheaf_of_isSheaf _ _ _ _ hF

end AlgebraicGeometry

end
