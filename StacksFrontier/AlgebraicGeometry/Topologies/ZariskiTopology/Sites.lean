module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Topologies.Zariski.BigSite
public import StacksFrontier.AlgebraicGeometry.Topologies.ZariskiTopology.StandardCoverings

/-!
# Big and small Zariski sites of a scheme

For a scheme in a chosen big Zariski site, its big site is the slice category.
The small and affine sites are full subcategories, with coverings inherited from
the big site and restricted to standard coverings in the affine cases.

## Main definitions

* `AlgebraicGeometry.BigZariskiOver` is the slice of the big Zariski category over a scheme.
* `AlgebraicGeometry.SmallZariski`, `AlgebraicGeometry.BigAffineZariski`, and
  `AlgebraicGeometry.SmallAffineZariski` are its full subcategories.
* The four `IsCovering` predicates specify their respective covering families.

## Implementation notes

`BigZariskiOver` and its covering predicate give part (1); `SmallZariski` and its
covering predicate give part (2); `BigAffineZariski` and `SmallAffineZariski`, with
their covering predicates, give parts (3) and (4). The categories are full
subcategories, so their inclusion functors are canonical. The
precoverages remember indexed covering families, as in the source. Standard affine
coverings use `AlgebraicGeometry.IsStandardZariskiCovering` after applying the canonical
functor to schemes; the existence of the resulting Zariski cover is retained explicitly.

The two predicates `BigZariskiOver.IsAffineOver` and
`BigZariskiOver.IsStandardZariskiCovering` are nested inside `BigZariskiOver` because the
names `IsAffineOver` and `IsStandardZariskiCovering` already denote different notions at the
top of the `AlgebraicGeometry` namespace.

## References

* [Stacks Project, Tag 020T](https://stacks.math.columbia.edu/tag/020T)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

variable (B : BigZariskiSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The big Zariski category of `S` is the slice of the chosen big category. -/
@[stacks 020T "part (1), category"]
public abbrev BigZariskiOver := Over (⟨S, hS⟩ : B.Schemes)

namespace BigZariskiOver

/-- The inclusion of the big Zariski category of `S` into the chosen big category. -/
public abbrev inclusion : BigZariskiOver B S hS ⥤ B.Schemes := Over.forget _

/-- The functor sending an object of the big Zariski category of `S` to its scheme. -/
public abbrev toScheme : BigZariskiOver B S hS ⥤ Scheme.{u} :=
  inclusion B S hS ⋙ B.inclusion

/-- A family over `S` covers when its underlying family covers in the chosen big site. -/
@[stacks 020T "part (1), coverings"]
public abbrev IsCovering (E : Covering (BigZariskiOver B S hS)) : Prop :=
  B.IsCovering ⟨(inclusion B S hS).obj E.1, E.2.map (inclusion B S hS)⟩

/-- The precoverage of the big Zariski category of `S`, consisting of the presieves
underlying its covering families. -/
public def precoverage : Precoverage (BigZariskiOver B S hS) where
  coverings X :=
    {R | ∃ E : PreZeroHypercover.{u + 1} X, R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩}

/-- Membership in the precoverage of the big Zariski category of `S` unfolds to the existence
of a covering family with the given presieve. -/
public theorem mem_precoverage_iff {X : BigZariskiOver B S hS} {R : Presieve X} :
    R ∈ precoverage B S hS X ↔
      ∃ E : PreZeroHypercover.{u + 1} X, R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩ :=
  Iff.rfl

/-- The Grothendieck topology generated by the coverings of the big Zariski category. -/
public abbrev topology : GrothendieckTopology (BigZariskiOver B S hS) :=
  (precoverage B S hS).toGrothendieck

end BigZariskiOver

/-- An object of the big Zariski category of `S` is open over `S` when its structure morphism
is an open immersion. -/
public abbrev IsOpenOver : ObjectProperty (BigZariskiOver B S hS) :=
  fun X ↦ IsOpenImmersion (B.inclusion.map X.hom)

/-- The small Zariski category consists of schemes open in `S`. -/
@[stacks 020T "part (2), category"]
public abbrev SmallZariski := (IsOpenOver B S hS).FullSubcategory

namespace SmallZariski

/-- The inclusion of the small Zariski category of `S` into its big Zariski category. -/
public abbrev inclusion : SmallZariski B S hS ⥤ BigZariskiOver B S hS := (IsOpenOver B S hS).ι

/-- The functor sending an object of the small Zariski category of `S` to its scheme. -/
public abbrev toScheme : SmallZariski B S hS ⥤ Scheme.{u} :=
  inclusion B S hS ⋙ BigZariskiOver.toScheme B S hS

/-- The structure morphism of an object of the small Zariski category is an open immersion. -/
public instance isOpenImmersion_structureMorphism (X : SmallZariski B S hS) :
    IsOpenImmersion (B.inclusion.map X.obj.hom) := X.property

/-- Small-site coverings are precisely big-site coverings of small-site objects. -/
@[stacks 020T "part (2), coverings"]
public abbrev IsCovering (E : Covering (SmallZariski B S hS)) : Prop :=
  BigZariskiOver.IsCovering B S hS ⟨(inclusion B S hS).obj E.1, E.2.map (inclusion B S hS)⟩

/-- The precoverage of the small Zariski category of `S`. -/
public def precoverage : Precoverage (SmallZariski B S hS) where
  coverings X :=
    {R | ∃ E : PreZeroHypercover.{u + 1} X, R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩}

/-- Membership in the precoverage of the small Zariski category of `S` unfolds to the
existence of a covering family with the given presieve. -/
public theorem mem_precoverage_iff {X : SmallZariski B S hS} {R : Presieve X} :
    R ∈ precoverage B S hS X ↔
      ∃ E : PreZeroHypercover.{u + 1} X, R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩ :=
  Iff.rfl

/-- The Grothendieck topology generated by the coverings of the small Zariski category. -/
public abbrev topology : GrothendieckTopology (SmallZariski B S hS) :=
  (precoverage B S hS).toGrothendieck

end SmallZariski

/-- An object of the big Zariski category of `S` is affine over `S` when its scheme is
affine. -/
public abbrev BigZariskiOver.IsAffineOver : ObjectProperty (BigZariskiOver B S hS) :=
  fun X ↦ IsAffine ((BigZariskiOver.toScheme B S hS).obj X)

/-- A covering is standard Zariski when its image in schemes is a standard Zariski
covering in the sense of Stacks 020R. -/
public abbrev BigZariskiOver.IsStandardZariskiCovering (E : Covering (BigZariskiOver B S hS))
    [IsAffine ((BigZariskiOver.toScheme B S hS).obj E.1)] : Prop :=
  BigZariskiOver.IsCovering B S hS E ∧
    ∃ h : (E.2.map (BigZariskiOver.toScheme B S hS)).presieve₀ ∈
      Scheme.zariskiPrecoverage ((BigZariskiOver.toScheme B S hS).obj E.1),
      AlgebraicGeometry.IsStandardZariskiCovering
        (⟨E.2.map (BigZariskiOver.toScheme B S hS), h⟩ :
          ((BigZariskiOver.toScheme B S hS).obj E.1).Cover.{u + 1} Scheme.zariskiPrecoverage)

/-- The big affine Zariski category consists of affine schemes over `S`. -/
@[stacks 020T "part (3), category"]
public abbrev BigAffineZariski := (BigZariskiOver.IsAffineOver B S hS).FullSubcategory

namespace BigAffineZariski

/-- The inclusion of the big affine Zariski category of `S` into its big Zariski category. -/
public abbrev inclusion : BigAffineZariski B S hS ⥤ BigZariskiOver B S hS :=
  (BigZariskiOver.IsAffineOver B S hS).ι

/-- The functor sending an object of the big affine Zariski category of `S` to its scheme. -/
public abbrev toScheme : BigAffineZariski B S hS ⥤ Scheme.{u} :=
  inclusion B S hS ⋙ BigZariskiOver.toScheme B S hS

/-- The scheme of an object of the big affine Zariski category is affine. -/
public instance isAffine_toScheme_obj (X : BigAffineZariski B S hS) :
    IsAffine ((toScheme B S hS).obj X) := X.property

/-- Big affine coverings are standard Zariski coverings. -/
@[stacks 020T "part (3), coverings"]
public abbrev IsCovering (E : Covering (BigAffineZariski B S hS)) : Prop :=
  letI : IsAffine ((BigZariskiOver.toScheme B S hS).obj ((inclusion B S hS).obj E.1)) :=
    E.1.property
  BigZariskiOver.IsStandardZariskiCovering B S hS
    ⟨(inclusion B S hS).obj E.1, E.2.map (inclusion B S hS)⟩

/-- The precoverage of the big affine Zariski category of `S`. -/
public def precoverage : Precoverage (BigAffineZariski B S hS) where
  coverings X :=
    {R | ∃ E : PreZeroHypercover.{u + 1} X, R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩}

/-- Membership in the precoverage of the big affine Zariski category of `S` unfolds to the
existence of a covering family with the given presieve. -/
public theorem mem_precoverage_iff {X : BigAffineZariski B S hS} {R : Presieve X} :
    R ∈ precoverage B S hS X ↔
      ∃ E : PreZeroHypercover.{u + 1} X, R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩ :=
  Iff.rfl

/-- The Grothendieck topology generated by the coverings of the big affine Zariski
category. -/
public abbrev topology : GrothendieckTopology (BigAffineZariski B S hS) :=
  (precoverage B S hS).toGrothendieck

end BigAffineZariski

/-- An object of the small Zariski category of `S` is affine when its scheme is affine. -/
public abbrev SmallZariski.IsAffine : ObjectProperty (SmallZariski B S hS) :=
  fun X ↦ AlgebraicGeometry.IsAffine ((SmallZariski.toScheme B S hS).obj X)

/-- The small affine Zariski category consists of affine opens in `S`. -/
@[stacks 020T "part (4), category"]
public abbrev SmallAffineZariski := (SmallZariski.IsAffine B S hS).FullSubcategory

namespace SmallAffineZariski

/-- The inclusion of the small affine Zariski category of `S` into its small Zariski
category. -/
public abbrev inclusion : SmallAffineZariski B S hS ⥤ SmallZariski B S hS :=
  (SmallZariski.IsAffine B S hS).ι

/-- The functor sending an object of the small affine Zariski category of `S` to its
scheme. -/
public abbrev toScheme : SmallAffineZariski B S hS ⥤ Scheme.{u} :=
  inclusion B S hS ⋙ SmallZariski.toScheme B S hS

/-- The scheme of an object of the small affine Zariski category is affine. -/
public instance isAffine_toScheme_obj (X : SmallAffineZariski B S hS) :
    IsAffine ((toScheme B S hS).obj X) := X.property

/-- Small affine coverings are the standard Zariski coverings inherited from the small site. -/
@[stacks 020T "part (4), coverings"]
public abbrev IsCovering (E : Covering (SmallAffineZariski B S hS)) : Prop :=
  letI : IsAffine ((BigZariskiOver.toScheme B S hS).obj
      ((SmallZariski.inclusion B S hS).obj ((inclusion B S hS).obj E.1))) := E.1.property
  BigZariskiOver.IsStandardZariskiCovering B S hS
    ⟨(SmallZariski.inclusion B S hS).obj ((inclusion B S hS).obj E.1),
      (E.2.map (inclusion B S hS)).map (SmallZariski.inclusion B S hS)⟩

/-- The precoverage of the small affine Zariski category of `S`. -/
public def precoverage : Precoverage (SmallAffineZariski B S hS) where
  coverings X :=
    {R | ∃ E : PreZeroHypercover.{u + 1} X, R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩}

/-- Membership in the precoverage of the small affine Zariski category of `S` unfolds to the
existence of a covering family with the given presieve. -/
public theorem mem_precoverage_iff {X : SmallAffineZariski B S hS} {R : Presieve X} :
    R ∈ precoverage B S hS X ↔
      ∃ E : PreZeroHypercover.{u + 1} X, R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩ :=
  Iff.rfl

/-- The Grothendieck topology generated by the coverings of the small affine Zariski
category. -/
public abbrev topology : GrothendieckTopology (SmallAffineZariski B S hS) :=
  (precoverage B S hS).toGrothendieck

end SmallAffineZariski

end AlgebraicGeometry
