module

public import StacksFrontier.AlgebraicGeometry.Size.Cutoff
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale
public import StacksFrontier.AlgebraicGeometry.Topologies.Syntomic.Coverings
public import StacksFrontier.CategoryTheory.Sites.Pretopology.SmallSubsite
public import StacksCore.Tactic.StacksAttribute

/-!
# The big syntomic site

A big syntomic site is a size-bounded full subcategory of schemes together with a chosen bounded
collection of syntomic covering families. The cutoff contains a prescribed small set of schemes,
and the chosen coverings contain a prescribed small set of syntomic coverings among them.

This is the same construction as for the big Zariski, étale and smooth sites, with the syntomic
coverings in place of the others: a cardinal cutoff makes the category a set, and a bound on
index types makes the collection of admitted covering families a set, while every syntomic
covering still has a combinatorially equivalent admitted representative.

## Main definitions

* `AlgebraicGeometry.SyntomicCovering` — a family in a cutoff category is a syntomic covering
  after inclusion into schemes.
* `AlgebraicGeometry.BigSyntomicSite` — the choices and conditions defining a big syntomic site.
* `AlgebraicGeometry.BigSyntomicSite.topology` — the topology generated by its chosen covering
  families.

## Implementation notes

The cutoff category is the size-bounded full subcategory
`AlgebraicGeometry.SchemeBelow`, the full subcategory of schemes `X` with
`X.size < κ`; the three cutoff fields are the properties supplied by
`AlgebraicGeometry.exists_size_cutoff`. A family is syntomic in the sense of the predicate on
indexed families, applied after the canonical full-subcategory inclusion, so no separate notion
of syntomic covering is introduced.

The selected coverings are `CovBounded` applied to that predicate, and the remaining fields
record the conclusions of the set-sized-covering construction, including the prescribed
coverings and the combinatorial representatives. The family-level predicate is retained rather
than only the Grothendieck topology it generates, because different choices of the two bounds
give different big syntomic sites with the same ambient class of syntomic coverings.

## References

* [Stacks Project, Tag 03X1](https://stacks.math.columbia.edu/tag/03X1)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

/-- A family in a size-bounded category is a syntomic covering when its image
under the canonical inclusion is a syntomic covering of schemes. -/
public abbrev SyntomicCovering (κ : Cardinal.{u})
    (𝒰 : Covering.{u + 1, u, u + 1} (AlgebraicGeometry.SchemeBelow κ)) : Prop :=
  IsSyntomicCovering (fun i ↦ (𝒰.2.X i).1)
    (fun i ↦ (AlgebraicGeometry.schemeBelowInclusion κ).map (𝒰.2.f i))

/-- **Stacks 03X1.** A big syntomic site consists of an initial set of
schemes and syntomic coverings, a size cutoff containing those schemes, and
a bounded collection of syntomic coverings containing the initial ones and
satisfying the site axioms. -/
@[stacks 03X1]
public structure BigSyntomicSite where
  /-- The prescribed set `S₀` of schemes. -/
  initialSchemes : Set Scheme.{u}
  /-- The prescribed collection of schemes is small. -/
  initialSchemes_small : Small.{u} initialSchemes
  /-- The cardinal defining the full subcategory `Sch_κ`. -/
  cutoff : Cardinal.{u}
  /-- The cutoff is uncountable. -/
  aleph0_lt_cutoff : Cardinal.aleph0 < cutoff
  /-- The cutoff is a strong limit cardinal. -/
  cutoff_isStrongPrelimit : Cardinal.IsStrongPrelimit cutoff
  /-- The cutoff has uncountable cofinality. -/
  aleph0_lt_cutoff_cof : Cardinal.aleph0 < cutoff.ord.cof
  /-- Every scheme prescribed in `S₀` belongs to `Sch_κ`. -/
  contains_initialScheme : ∀ X ∈ initialSchemes, X.size < cutoff
  /-- The prescribed set `Cov₀` of covering families among the schemes in
  `S₀`. -/
  initialCoverings :
    Set (Covering (AlgebraicGeometry.SchemeBelow cutoff))
  /-- The prescribed collection of coverings is small. -/
  initialCoverings_small : Small.{u + 1} initialCoverings
  /-- Every prescribed covering is syntomic. -/
  initialCoverings_syntomic : ∀ 𝒰 ∈ initialCoverings, SyntomicCovering cutoff 𝒰
  /-- The target and sources of every prescribed covering belong to `S₀`. -/
  initialCoverings_among_initialSchemes : ∀ 𝒰 ∈ initialCoverings,
    𝒰.1.1 ∈ initialSchemes ∧ ∀ i, (𝒰.2.X i).1 ∈ initialSchemes
  /-- The cardinal bound selecting the covering families of the site. -/
  coveringBound : Cardinal.{u + 1}
  /-- The limit ordinal accompanying the selected covering set. -/
  coveringOrdinal : Ordinal.{u + 1}
  /-- The selected ordinal is a limit ordinal. -/
  coveringOrdinal_isSuccLimit : Order.IsSuccLimit coveringOrdinal
  /-- Every prescribed covering belongs to the selected bounded collection. -/
  contains_initialCovering : ∀ 𝒰 ∈ initialCoverings,
    CovBounded (SyntomicCovering cutoff) coveringBound 𝒰
  /-- The selected bounded syntomic coverings satisfy the site axioms. -/
  covering_isSite : IsSite (CovBounded (SyntomicCovering cutoff) coveringBound)
  /-- Every syntomic covering is combinatorially equivalent to a selected
  covering. -/
  has_coveringRepresentative : ∀ 𝒰, SyntomicCovering cutoff 𝒰 →
    ∃ 𝒰', (CovBounded (SyntomicCovering cutoff) coveringBound 𝒰' ∧
      Covering.CombEquiv 𝒰 𝒰')

namespace BigSyntomicSite

/-- The underlying category of a big syntomic site. -/
public abbrev category (B : BigSyntomicSite.{u}) : Type (u + 1) :=
  AlgebraicGeometry.SchemeBelow B.cutoff

/-- The canonical fully faithful inclusion from the big syntomic category to
all schemes. -/
public abbrev inclusion (B : BigSyntomicSite.{u}) : B.category ⥤ Scheme.{u} :=
  AlgebraicGeometry.schemeBelowInclusion B.cutoff

/-- A scheme is contained in a big syntomic site when it lies below its size
cutoff. -/
public abbrev Contains (B : BigSyntomicSite.{u}) (X : Scheme.{u}) : Prop :=
  X.size < B.cutoff

/-- Regard a contained scheme as an object of the big syntomic category. -/
public abbrev obj (B : BigSyntomicSite.{u}) (X : Scheme.{u}) (hX : B.Contains X) :
    B.category := ⟨X, hX⟩

/-- The chosen collection of covering families of a big syntomic site. -/
public abbrev IsCovering (B : BigSyntomicSite.{u}) : Covering B.category → Prop :=
  CovBounded (SyntomicCovering B.cutoff) B.coveringBound

/-- The precoverage represented by the chosen syntomic covering families. -/
public def precoverage (B : BigSyntomicSite.{u}) : Precoverage B.category where
  coverings X := {R | ∃ 𝒰 : PreZeroHypercover.{u + 1} X,
    R = 𝒰.presieve₀ ∧ B.IsCovering ⟨X, 𝒰⟩}

/-- The Grothendieck topology generated by the chosen syntomic covering
families. -/
public abbrev topology (B : BigSyntomicSite.{u}) : GrothendieckTopology B.category :=
  B.precoverage.toGrothendieck

end BigSyntomicSite

end AlgebraicGeometry
