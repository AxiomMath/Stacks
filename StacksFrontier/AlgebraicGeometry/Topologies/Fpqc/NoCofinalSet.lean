module

public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.CategoryTheory.Sites.Hypercover.Zero
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.RingTheory.Localization.Basic
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import Mathlib.SetTheory.Cardinal.Order
public import StacksCore.Tactic.StacksAttribute

/-!
# No set of fpqc coverings is cofinal under refinement

For a nonzero ring, no set-sized family of fpqc coverings of its spectrum refines every
fpqc covering: there is no small cofinal system, which is why the big fpqc site has to be
cut off by a cardinal bound rather than generated by a set of coverings.

## Main results

* `AlgebraicGeometry.exists_fpqcCover_not_refined_by_family`: for any small family of fpqc
  coverings of an affine scheme there is an fpqc covering which none of them refines.

## Implementation notes

An fpqc covering is a zero-hypercover for `AlgebraicGeometry.Scheme.fpqcPrecoverage`, and
refinement is a morphism of pre-zero-hypercovers over the common target.  The schemes and
the index types of the coverings live in universe `u`, and the family of coverings is
indexed by a type in that same universe; this smallness distinction is the universe-level
form of the source's "set of coverings", as opposed to the proper class of all coverings.
The separating covering is built from a faithfully flat polynomial extension in which a
prescribed family of residues is separated, so that no member of the given family can
dominate it.

## References

* [Stacks Project, Tag 0BBK](https://stacks.math.columbia.edu/tag/0BBK)
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

universe u

namespace AlgebraicGeometry

private def residueElements (R : Type u) [CommRing R] (A : Type u)
    (U : A → Scheme.fpqcPrecoverage.ZeroHypercover.{u} (Spec (.of R))) : Type u :=
  Σ a : A, Σ i : (U a).I₀, Σ x : (U a).X i, (U a).X i |>.residueField x

private def separatingSubmonoid {R : Type u} [CommRing R] (I : Type u) :
    Submonoid (MvPolynomial I R) where
  carrier := {f | ∀ p : PrimeSpectrum R,
    MvPolynomial.map (Ideal.Quotient.mk p.asIdeal) f ≠ 0}
  one_mem' := by
    intro p; simp
  mul_mem' := by
    intro f g hf hg p
    simpa only [map_mul] using mul_ne_zero (hf p) (hg p)

private lemma separatingSubmonoid_X_sub_X {R : Type u} [CommRing R] [Nontrivial R]
    {I : Type u} {i j : I} (hij : i ≠ j) :
    ∀ p : PrimeSpectrum R,
    MvPolynomial.map (Ideal.Quotient.mk p.asIdeal)
      (MvPolynomial.X i - MvPolynomial.X j : MvPolynomial I R) ≠ 0 := by
  classical
  intro p hzero
  have hcoeff := congrArg (MvPolynomial.coeff (Finsupp.single i 1)) hzero
  have hsingle : Finsupp.single j (1 : ℕ) ≠ Finsupp.single i 1 := by
    intro h; exact hij ((Finsupp.single_left_inj (by decide : (1 : ℕ) ≠ 0)).mp h).symm
  have hmapcoeff : MvPolynomial.coeff (Finsupp.single i 1)
      (MvPolynomial.map (Ideal.Quotient.mk p.asIdeal)
        (MvPolynomial.X i - MvPolynomial.X j : MvPolynomial I R)) = 1 := by
    rw [MvPolynomial.coeff_map, MvPolynomial.coeff_sub, map_sub]
    simp [MvPolynomial.coeff_X, hsingle]
  rw [hmapcoeff, MvPolynomial.coeff_zero] at hcoeff
  exact one_ne_zero hcoeff

private abbrev separatorRing (R : Type u) [CommRing R] (I : Type u) :=
  Localization (separatingSubmonoid (R := R) I)

private noncomputable def separatorMap (R : Type u) [CommRing R] (I : Type u) :
    R →+* separatorRing R I :=
  (algebraMap (MvPolynomial I R) (separatorRing R I)).comp (MvPolynomial.C)

private lemma separatorMap_faithfullyFlat (R : Type u) [CommRing R] [Nontrivial R]
    (I : Type u) : (separatorMap R I).FaithfullyFlat := by
  classical
  let P := MvPolynomial I R
  let S := separatingSubmonoid (R := R) I
  let T := Localization S
  let f : R →+* T := (algebraMap P T).comp (MvPolynomial.C)
  have hflat₁ : (MvPolynomial.C : R →+* P).Flat := by
    have hC : (MvPolynomial.C : R →+* P) = algebraMap R P := by
      ext r; rfl
    rw [hC, RingHom.flat_algebraMap_iff]; infer_instance
  have hflat₂ : (algebraMap P T).Flat := by
    rw [RingHom.flat_algebraMap_iff]; exact IsLocalization.flat (S := T) S
  have hflat : f.Flat := RingHom.Flat.comp hflat₁ hflat₂
  have hsurj : Function.Surjective (PrimeSpectrum.comap f) := by
    intro p
    let : p.asIdeal.IsPrime := p.2
    let : IsDomain (R ⧸ p.asIdeal) := Ideal.Quotient.isDomain p.asIdeal
    let q : PrimeSpectrum P :=
      PrimeSpectrum.comap (MvPolynomial.map (R := R) (σ := I)
        (Ideal.Quotient.mk p.asIdeal)) ⊥
    have hdisjoint : Disjoint (S : Set P) q.asIdeal :=
      Set.disjoint_left.mpr fun g hg hq ↦ hg p hq
    obtain ⟨q', hq'⟩ : q ∈ Set.range (PrimeSpectrum.comap (algebraMap P T)) := by
      rw [PrimeSpectrum.localization_comap_range T S]; exact hdisjoint
    refine ⟨q', ?_⟩
    show PrimeSpectrum.comap ((algebraMap P T).comp (MvPolynomial.C)) q' = p
    rw [PrimeSpectrum.comap_comp_apply, hq']
    apply PrimeSpectrum.ext
    ext r
    simp only [q, PrimeSpectrum.comap, Ideal.mem_comap]
    show MvPolynomial.map (Ideal.Quotient.mk p.asIdeal) (MvPolynomial.C r) = 0 ↔ _
    rw [MvPolynomial.map_C, MvPolynomial.C_eq_zero, Ideal.Quotient.eq_zero_iff_mem]
  exact RingHom.FaithfullyFlat.iff_flat_and_comap_surjective.mpr ⟨hflat, hsurj⟩

private noncomputable def residueLocalizationMap {R : Type u} [CommRing R] (I : Type u)
    {X : Scheme.{u}} (f : X ⟶ Spec (.of (separatorRing R I))) (x : X) :
    separatorRing R I →+* X.residueField x := by
  letI : (f x).asIdeal.IsPrime := (f x).2
  let e := Scheme.Spec.residueFieldIso (CommRingCat.of (separatorRing R I)) (f x)
  let m₁ : separatorRing R I →+* (f x).asIdeal.ResidueField :=
    algebraMap (separatorRing R I) (f x).asIdeal.ResidueField
  exact (f.residueFieldMap x).hom.comp (e.inv.hom.comp m₁)

private noncomputable def residuePolynomialMap {R : Type u} [CommRing R] (I : Type u)
    {X : Scheme.{u}} (f : X ⟶ Spec (.of (separatorRing R I))) (x : X) :
    MvPolynomial I R →+* X.residueField x :=
  (residueLocalizationMap I f x).comp (algebraMap (MvPolynomial I R) (separatorRing R I))

private lemma residuePolynomialMap_X_injective {R : Type u} [CommRing R] [Nontrivial R]
    (I : Type u) {X : Scheme.{u}}
    (f : X ⟶ Spec (.of (separatorRing R I))) (x : X) :
    Function.Injective (fun i : I => residuePolynomialMap I f x (MvPolynomial.X i)) := by
  classical
  intro i j heq
  by_contra hne
  have hdiff := separatingSubmonoid_X_sub_X (R := R) (I := I) hne
  have hunit : IsUnit (algebraMap (MvPolynomial I R) (separatorRing R I)
      (MvPolynomial.X i - MvPolynomial.X j)) :=
    IsLocalization.map_units (M := separatingSubmonoid (R := R) I)
      (separatorRing R I) ⟨MvPolynomial.X i - MvPolynomial.X j, hdiff⟩
  have hmapunit : IsUnit (residuePolynomialMap I f x
      (MvPolynomial.X i - MvPolynomial.X j)) := by
    convert hunit.map (residueLocalizationMap I f x) using 1; rfl
  apply hmapunit.ne_zero
  change residuePolynomialMap I f x (MvPolynomial.X i) =
    residuePolynomialMap I f x (MvPolynomial.X j) at heq
  rw [map_sub, heq, sub_self]

private lemma fpqcFamily_covers_point {R : Type u} [CommRing R] (A : Type u)
    (U : A → Scheme.fpqcPrecoverage.ZeroHypercover.{u} (Spec (.of R))) (a : A)
    (z : Spec (.of R)) :
    ∃ i, z ∈ Set.range ((U a).f i) := by
  have hmem := (U a).mem₀
  change Presieve.ofArrows (U a).X (U a).f ∈ Scheme.propQCPrecoverage @Flat (Spec (.of R)) at hmem
  change Presieve.ofArrows (U a).X (U a).f ∈ Scheme.qcPrecoverage (Spec (.of R)) ∧
      Presieve.ofArrows (U a).X (U a).f ∈ Scheme.precoverage @Flat (Spec (.of R)) at hmem
  exact ((Scheme.ofArrows_mem_precoverage_iff (P := @Flat)).1 hmem.2).1 z

/-- No small family of fpqc coverings of the spectrum of a nonzero ring is cofinal under
refinement. -/
@[stacks 0BBK]
public theorem exists_fpqcCover_not_refined_by_family
    (R : Type u) [CommRing R] [Nontrivial R]
    (A : Type u)
    (U : A → Scheme.fpqcPrecoverage.ZeroHypercover.{u} (Spec (.of R))) :
    ∃ V : Scheme.fpqcPrecoverage.ZeroHypercover.{u} (Spec (.of R)),
      ∀ a : A, ¬ Nonempty ((U a).toPreZeroHypercover.Hom V.toPreZeroHypercover) := by
  classical
  let P := residueElements R A U
  let I := Set P
  let T := separatorRing R I
  let α := separatorMap R I
  let f := Spec.map (CommRingCat.ofHom α)
  obtain ⟨_, _⟩ : Flat f ∧ Surjective f := (flat_and_surjective_SpecMap_iff
    (CommRingCat.ofHom α)).2 (separatorMap_faithfullyFlat R I)
  refine ⟨Precoverage.ZeroHypercover.singleton f (Scheme.Hom.singleton_mem_fpqcPrecoverage f),
    fun a ⟨φ⟩ ↦ ?_⟩
  obtain ⟨m, hm⟩ := Ideal.exists_maximal R
  obtain ⟨i, ⟨x, _hx⟩⟩ := fpqcFamily_covers_point (R := R) A U a ⟨m, hm.isPrime⟩
  let g : (U a).X i ⟶ Spec (.of T) := φ.h₀ i
  have hinj := residuePolynomialMap_X_injective (R := R) I g x
  have hκP : Cardinal.mk (((U a).X i).residueField x) ≤ Cardinal.mk P := by
    apply Cardinal.mk_le_of_injective (f := fun y => (⟨a, i, x, y⟩ : P))
    intro y y' h; simpa using h
  have hlarge : Cardinal.mk P < Cardinal.mk I := by
    simpa only [I, Cardinal.mk_set] using Cardinal.cantor (Cardinal.mk P)
  exact (not_le_of_gt hlarge ((Cardinal.mk_le_of_injective hinj).trans hκP))

end AlgebraicGeometry
