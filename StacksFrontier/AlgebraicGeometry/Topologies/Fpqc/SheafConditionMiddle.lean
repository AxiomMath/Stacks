/-!
# The fpqc sheaf condition for an algebraic space along one flat morphism

Let `F` be an algebraic space over `S` and let `f : T' ⟶ T` be a morphism of the big fppf site
over `S` whose underlying morphism of schemes is surjective, flat and quasi-compact. Given a
section `c` of `F` over `T'` with `pr₀^* c = pr₁^* c`, an étale chart of `F` with separated
underlying scheme, and effectivity of the fpqc descent datum that `c` determines on the base
change of the chart, this file constructs a surjective étale `w : W ⟶ T` and a section over `W`
agreeing with `c`, and concludes the sheaf condition for the presieve generated by `f`.

## Main results

* `AlgebraicGeometry.Space.etale_of_isPullback_yoneda` and
  `AlgebraicGeometry.Space.isSeparated_of_isPullback_yoneda`: the base change of an étale chart
  with separated underlying scheme along a section is an étale separated morphism of schemes.
* `AlgebraicGeometry.isIndQuasiAffineHom_of_etale_of_isSeparated`: a separated étale morphism of
  schemes is ind-quasi-affine.
* `AlgebraicGeometry.BigFppfOver.exists_desc_of_surjective_flat_quasiCompact`: a morphism out of
  `T' ×_T W` which is invariant for the two projections of the self-fibre product over `W`
  descends to a morphism out of `W`, for `f : T' ⟶ T` surjective flat quasi-compact.
* `AlgebraicGeometry.IsAlgebraicSpace.isSheafFor_singleton_of_isEffectiveFpqcDescent`: an
  algebraic space over `S` satisfies the sheaf condition for the presieve generated by a
  surjective flat quasi-compact morphism of the site, given a chart and effectivity of the
  resulting descent datum as hypotheses.
* `AlgebraicGeometry.IsAlgebraicSpace.isSheafFor_singleton_of_isEffectiveFpqcDescent_of_atlas`:
  the same with the chart hypothesis replaced by a single surjective étale chart whose
  underlying scheme is separated.

## References

* [Stacks Project, Tag 0APL](https://stacks.math.columbia.edu/tag/0APL)
* [Stacks Project, Tag 0APK](https://stacks.math.columbia.edu/tag/0APK)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

namespace Space

/-- If `u : yoneda.obj U ⟶ F` is étale as a morphism of presheaves and the square over a section
`c` of `F` on `T'` is cartesian, then the morphism `p : V ⟶ T'` of the site representing the base
change has étale underlying morphism of schemes. -/
theorem etale_of_isPullback_yoneda {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U T' V : BigFppfOver B S hS} {u : yoneda.obj U ⟶ F} {c : yoneda.obj T' ⟶ F}
    {q : V ⟶ U} {p : V ⟶ T'}
    (hu : (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf u)
    (sq : IsPullback (yoneda.map q) (yoneda.map p) u c) :
    Etale ((BigFppfOver.toScheme B S hS).map p) :=
  hu.property c (yoneda.map q) p sq

/-- If the underlying scheme of `U` is separated and the square of `u : yoneda.obj U ⟶ F` over a
section `c` of `F` on `T'` is cartesian, then the morphism `p : V ⟶ T'` of the site representing
the base change has separated underlying morphism of schemes. -/
theorem isSeparated_of_isPullback_yoneda {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {U T' V : BigFppfOver B S hS} {u : yoneda.obj U ⟶ F} {c : yoneda.obj T' ⟶ F}
    {q : V ⟶ U} {p : V ⟶ T'}
    (hU : Scheme.IsSeparated ((BigFppfOver.toScheme B S hS).obj U))
    (sq : IsPullback (yoneda.map q) (yoneda.map p) u c) :
    _root_.AlgebraicGeometry.IsSeparated ((BigFppfOver.toScheme B S hS).map p) := by
  have hstable : ((MorphismProperty.inverseImage
      (@_root_.AlgebraicGeometry.IsClosedImmersion.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf).IsStableUnderBaseChange :=
    MorphismProperty.relative_isStableUnderBaseChange _
  refine (isSeparated_yoneda_map_iff B S hS p).1 ?_
  exact MorphismProperty.IsStableUnderBaseChange.of_isPullback
    (P := (MorphismProperty.inverseImage
      (@_root_.AlgebraicGeometry.IsClosedImmersion.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf.diagonal)
    sq (isSeparated_of_isSeparatedOver B S hS (isSeparatedOver_yoneda_obj B S hS U hU) u)

end Space

/-- A separated étale morphism of schemes is ind-quasi-affine. -/
theorem isIndQuasiAffineHom_of_etale_of_isSeparated {X Y : Scheme.{u}} (g : X ⟶ Y)
    (hsep : _root_.AlgebraicGeometry.IsSeparated g) (het : Etale g) :
    IsIndQuasiAffineHom g := by
  have := het
  have := hsep
  obtain ⟨_, _⟩ := locallyQuasiFinite_of_etale g
  exact isIndQuasiAffineHom_of_isSeparated_of_locallyQuasiFinite g

namespace BigFppfOver

/-- Let `f : T' ⟶ T` be a morphism of the big fppf site over `S` whose underlying morphism of
schemes is surjective, flat and quasi-compact, let `w : W ⟶ T` be any morphism of the site, and
let `b' : T' ×_T W ⟶ U` be invariant, in the sense that its two restrictions along the
projections of the self-fibre product of `T' ×_T W ⟶ W` agree. Then `b'` is the restriction of a
morphism `b : W ⟶ U`. -/
@[sga "3 X 4.3" "Existence"]
theorem exists_desc_of_surjective_flat_quasiCompact
    {T T' W U : BigFppfOver B S hS} {f : T' ⟶ T}
    (hfs : Surjective ((toScheme B S hS).map f))
    (hff : Flat ((toScheme B S hS).map f))
    (hfqc : QuasiCompact ((toScheme B S hS).map f))
    (w : W ⟶ T) (b' : pullback f w ⟶ U)
    (hinv : pullback.fst (pullback.snd f w) (pullback.snd f w) ≫ b' =
      pullback.snd (pullback.snd f w) (pullback.snd f w) ≫ b') :
    ∃ b : W ⟶ U, pullback.snd f w ≫ b = b' := by
  have hsq := (IsPullback.of_hasPullback f w).map (toScheme B S hS)
  have hbc : ∀ (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange],
      P ((toScheme B S hS).map f) → P ((toScheme B S hS).map (pullback.snd f w)) :=
    fun P _ => MorphismProperty.IsStableUnderBaseChange.of_isPullback hsq
  have := hbc @Surjective hfs
  have := hbc @Flat hff
  have := hbc @QuasiCompact hfqc
  have hinv' : ∀ {Z : Scheme.{u}} (g₁ g₂ : Z ⟶ (toScheme B S hS).obj (pullback f w)),
      g₁ ≫ (toScheme B S hS).map (pullback.snd f w) =
        g₂ ≫ (toScheme B S hS).map (pullback.snd f w) →
      g₁ ≫ (toScheme B S hS).map b' = g₂ ≫ (toScheme B S hS).map b' := by
    intro Z g₁ g₂ hg
    have hpb : IsPullback
        ((toScheme B S hS).map (pullback.fst (pullback.snd f w) (pullback.snd f w)))
        ((toScheme B S hS).map (pullback.snd (pullback.snd f w) (pullback.snd f w)))
        ((toScheme B S hS).map (pullback.snd f w))
        ((toScheme B S hS).map (pullback.snd f w)) :=
      (IsPullback.of_hasPullback _ _).map (toScheme B S hS)
    simpa only [Functor.map_comp, ← Category.assoc, hpb.lift_fst, hpb.lift_snd] using
      hpb.lift g₁ g₂ hg ≫= congrArg (toScheme B S hS).map hinv
  have hfac : (toScheme B S hS).map (pullback.snd f w) ≫
      EffectiveEpi.desc ((toScheme B S hS).map (pullback.snd f w))
        ((toScheme B S hS).map b') hinv' = (toScheme B S hS).map b' :=
    EffectiveEpi.fac _ _ _
  have hinc : ∀ {X Y : BigFppfOver B S hS} (g : X ⟶ Y),
      (toScheme B S hS).map g ≫ B.inclusion.map Y.hom = B.inclusion.map X.hom := fun g =>
    (B.inclusion.map_comp _ _).symm.trans (congrArg B.inclusion.map (Over.w g))
  have hover : EffectiveEpi.desc ((toScheme B S hS).map (pullback.snd f w))
      ((toScheme B S hS).map b') hinv' ≫ B.inclusion.map U.hom = B.inclusion.map W.hom := by
    rw [← cancel_epi ((toScheme B S hS).map (pullback.snd f w)), ← Category.assoc, hfac,
      hinc, hinc]
  refine ⟨Over.homMk (B.inclusion.preimage (EffectiveEpi.desc
    ((toScheme B S hS).map (pullback.snd f w)) ((toScheme B S hS).map b') hinv')) ?_, ?_⟩
  · exact B.inclusion.map_injective (by rw [Functor.map_comp, Functor.map_preimage]; exact hover)
  · refine Over.OverMorphism.ext (B.inclusion.map_injective ?_)
    simp only [Over.comp_left, Over.homMk_left, Functor.map_comp, Functor.map_preimage]
    exact hfac

end BigFppfOver

namespace IsAlgebraicSpace

variable {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

/-- An algebraic space `F` over `S` satisfies the sheaf condition for the presieve generated by a
morphism `f : T' ⟶ T` of the big fppf site over `S` whose underlying morphism of schemes is
surjective, flat and quasi-compact, given two hypotheses:

* `hchart`: for every section `c` of `F` over `T'` there is an étale chart
  `u : yoneda.obj U ⟶ F` whose underlying scheme is separated and whose base change along `c` is
  represented by a *surjective* morphism `p : V ⟶ T'` of the site;
* `hAPK`: effectivity of fpqc descent for the descent datum which `c` determines on `V/T'/T`
  when `V ⟶ T'` is surjective, étale, separated and ind-quasi-affine: there are an object `W` of
  the site, a morphism `w : W ⟶ T`, an isomorphism `α : T' ×_T W ≅ V` over `T'`, and the
  composite `T' ×_T W ≅ V ⟶ U` is invariant for the two projections of the self-fibre product
  over `W`. -/
theorem isSheafFor_singleton_of_isEffectiveFpqcDescent (hF : IsAlgebraicSpace B S hS F)
    {T T' : BigFppfOver B S hS} (f : T' ⟶ T)
    (hfs : Surjective ((BigFppfOver.toScheme B S hS).map f))
    (hff : Flat ((BigFppfOver.toScheme B S hS).map f))
    (hfqc : QuasiCompact ((BigFppfOver.toScheme B S hS).map f))
    (hchart : ∀ c : yoneda.obj T' ⟶ F, ∃ (U V : BigFppfOver B S hS) (u : yoneda.obj U ⟶ F)
      (q : V ⟶ U) (p : V ⟶ T'),
      Scheme.IsSeparated ((BigFppfOver.toScheme B S hS).obj U) ∧
      (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
        (BigFppfOver.toScheme B S hS)).presheaf u ∧
      IsPullback (yoneda.map q) (yoneda.map p) u c ∧
      Surjective ((BigFppfOver.toScheme B S hS).map p))
    (hAPK : ∀ (U V : BigFppfOver B S hS) (u : yoneda.obj U ⟶ F) (q : V ⟶ U) (p : V ⟶ T')
      (c : yoneda.obj T' ⟶ F), IsPullback (yoneda.map q) (yoneda.map p) u c →
      Surjective ((BigFppfOver.toScheme B S hS).map p) →
      Etale ((BigFppfOver.toScheme B S hS).map p) →
      _root_.AlgebraicGeometry.IsSeparated ((BigFppfOver.toScheme B S hS).map p) →
      IsIndQuasiAffineHom ((BigFppfOver.toScheme B S hS).map p) →
      yoneda.map (pullback.fst f f) ≫ c = yoneda.map (pullback.snd f f) ≫ c →
      ∃ (W : BigFppfOver B S hS) (w : W ⟶ T) (α : pullback f w ≅ V),
        α.hom ≫ p = pullback.fst f w ∧
        pullback.fst (pullback.snd f w) (pullback.snd f w) ≫ α.hom ≫ q =
          pullback.snd (pullback.snd f w) (pullback.snd f w) ≫ α.hom ≫ q) :
    Presieve.IsSheafFor F (Presieve.singleton f) := by
  have := hfs
  have := hff
  have := hfqc
  have : IsZariskiLocalAtTarget (@Etale.{u}) :=
    HasRingHomProperty.instIsZariskiLocalAtTarget _ (Q := RingHom.Etale)
  have hR : Presieve.singleton f ∈
      Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS) T := by
    rw [Precoverage.mem_comap_iff, ← Presieve.ofArrows_pUnit.{0}, Presieve.map_ofArrows,
      Presieve.ofArrows_pUnit]
    exact Scheme.Hom.singleton_mem_fpqcPrecoverage _
  refine hF.isSheafFor_fpqc_of_exists_compatible_section hR ?_
  intro x hx
  set c : yoneda.obj T' ⟶ F := yonedaEquiv.symm (x f (Presieve.singleton_self f)) with hcdef
  have hce : yonedaEquiv c = x f (Presieve.singleton_self f) := by
    rw [hcdef, Equiv.apply_symm_apply]
  obtain ⟨U, V, u, q, p, hUsep, hu, sq, hpsurj⟩ := hchart c
  have hpet : Etale ((BigFppfOver.toScheme B S hS).map p) :=
    Space.etale_of_isPullback_yoneda hu sq
  have hpsep : _root_.AlgebraicGeometry.IsSeparated ((BigFppfOver.toScheme B S hS).map p) :=
    Space.isSeparated_of_isPullback_yoneda hUsep sq
  have hpiqa : IsIndQuasiAffineHom ((BigFppfOver.toScheme B S hS).map p) :=
    isIndQuasiAffineHom_of_etale_of_isSeparated _ hpsep hpet
  have hcc : yoneda.map (pullback.fst f f) ≫ c = yoneda.map (pullback.snd f f) ≫ c := by
    refine yonedaEquiv.injective ?_
    rw [← yonedaEquiv_naturality, ← yonedaEquiv_naturality, hce]
    exact hx (pullback.fst f f) (pullback.snd f f) (Presieve.singleton_self f)
      (Presieve.singleton_self f) pullback.condition
  obtain ⟨W, w, α, hα, hinv⟩ := hAPK U V u q p c sq hpsurj hpet hpsep hpiqa hcc
  have hsq := (IsPullback.of_hasPullback f w).map (BigFppfOver.toScheme B S hS)
  have hfsteq : (BigFppfOver.toScheme B S hS).map (pullback.fst f w) =
      (BigFppfOver.toScheme B S hS).map α.hom ≫ (BigFppfOver.toScheme B S hS).map p := by
    rw [← Functor.map_comp, hα]
  have hQf : (@Surjective.{u} ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u})
      ((BigFppfOver.toScheme B S hS).map f) := ⟨⟨hfs, hff⟩, hfqc⟩
  have hdesc : ∀ (P : MorphismProperty Scheme.{u}) [P.DescendsAlong
      (@Surjective.{u} ⊓ @Flat ⊓ @QuasiCompact)] [P.RespectsIso],
      P ((BigFppfOver.toScheme B S hS).map p) → P ((BigFppfOver.toScheme B S hS).map w) :=
    fun P _ _ hp => MorphismProperty.of_isPullback_of_descendsAlong hsq hQf
      (hfsteq ▸ MorphismProperty.RespectsIso.precomp P _ _ hp)
  have hwet : Etale ((BigFppfOver.toScheme B S hS).map w) := hdesc @Etale hpet
  have hwsurj : Surjective ((BigFppfOver.toScheme B S hS).map w) := hdesc @Surjective hpsurj
  obtain ⟨b, hb⟩ := BigFppfOver.exists_desc_of_surjective_flat_quasiCompact hfs hff hfqc w
    (α.hom ≫ q) hinv
  refine ⟨W, w, Space.sieve_generate_singleton_mem_topology_over B S hS w hwsurj hwet,
    yonedaEquiv (yoneda.map b ≫ u), ?_⟩
  have key : F.map (pullback.snd f w).op (yonedaEquiv (yoneda.map b ≫ u)) =
      F.map (pullback.fst f w).op (x f (Presieve.singleton_self f)) := by
    rw [← hce, yonedaEquiv_naturality, yonedaEquiv_naturality]
    congr 1
    rw [← Category.assoc, ← Functor.map_comp, hb, Functor.map_comp, Category.assoc, sq.w,
      ← Category.assoc, ← Functor.map_comp, hα]
  intro Y Z u' g hg v hcomm
  cases hg
  obtain ⟨l, hl₁, hl₂⟩ : ∃ l : Y ⟶ pullback f w,
      l ≫ pullback.fst f w = v ∧ l ≫ pullback.snd f w = u' :=
    ⟨(IsPullback.of_hasPullback f w).lift v u' hcomm.symm,
      (IsPullback.of_hasPullback f w).lift_fst _ _ _,
      (IsPullback.of_hasPullback f w).lift_snd _ _ _⟩
  rw [← hl₁, ← hl₂, op_comp, op_comp, Functor.map_comp_apply, Functor.map_comp_apply, key]

/-- An algebraic space `F` over `S` satisfies the sheaf condition for the presieve generated by a
morphism `f : T' ⟶ T` of the big fppf site over `S` whose underlying morphism of schemes is
surjective, flat and quasi-compact, given a surjective étale chart `u : yoneda.obj U ⟶ F` whose
underlying scheme is separated, and given as hypothesis `hAPK`, effectivity of the fpqc descent
datum on `V/T'/T` as in
`AlgebraicGeometry.IsAlgebraicSpace.isSheafFor_singleton_of_isEffectiveFpqcDescent`. -/
theorem isSheafFor_singleton_of_isEffectiveFpqcDescent_of_atlas (hF : IsAlgebraicSpace B S hS F)
    {T T' : BigFppfOver B S hS} (f : T' ⟶ T)
    (hfs : Surjective ((BigFppfOver.toScheme B S hS).map f))
    (hff : Flat ((BigFppfOver.toScheme B S hS).map f))
    (hfqc : QuasiCompact ((BigFppfOver.toScheme B S hS).map f))
    {U : BigFppfOver B S hS}
    (hUsep : Scheme.IsSeparated ((BigFppfOver.toScheme B S hS).obj U))
    {u : yoneda.obj U ⟶ F}
    (hus : (MorphismProperty.inverseImage (@Surjective.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf u)
    (hue : (MorphismProperty.inverseImage (@Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).presheaf u)
    (hAPK : ∀ (U V : BigFppfOver B S hS) (u : yoneda.obj U ⟶ F) (q : V ⟶ U) (p : V ⟶ T')
      (c : yoneda.obj T' ⟶ F), IsPullback (yoneda.map q) (yoneda.map p) u c →
      Surjective ((BigFppfOver.toScheme B S hS).map p) →
      Etale ((BigFppfOver.toScheme B S hS).map p) →
      _root_.AlgebraicGeometry.IsSeparated ((BigFppfOver.toScheme B S hS).map p) →
      IsIndQuasiAffineHom ((BigFppfOver.toScheme B S hS).map p) →
      yoneda.map (pullback.fst f f) ≫ c = yoneda.map (pullback.snd f f) ≫ c →
      ∃ (W : BigFppfOver B S hS) (w : W ⟶ T) (α : pullback f w ≅ V),
        α.hom ≫ p = pullback.fst f w ∧
        pullback.fst (pullback.snd f w) (pullback.snd f w) ≫ α.hom ≫ q =
          pullback.snd (pullback.snd f w) (pullback.snd f w) ≫ α.hom ≫ q) :
    Presieve.IsSheafFor F (Presieve.singleton f) :=
  isSheafFor_singleton_of_isEffectiveFpqcDescent hF f hfs hff hfqc
    (fun c => ⟨U, hue.rep.pullback c, u, hue.rep.fst' c, hue.rep.snd c, hUsep, hue,
      hue.rep.isPullback' c,
      hus.property c (yoneda.map (hue.rep.fst' c)) (hue.rep.snd c) (hue.rep.isPullback' c)⟩)
    hAPK

end IsAlgebraicSpace

end AlgebraicGeometry

end
