module

public import StacksFrontier.AlgebraicGeometry.Spaces.CoveringSieveStepOne
public import StacksFrontier.AlgebraicGeometry.Topologies.Fpqc.CoveringRefinement
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The fpqc sheaf condition for algebraic spaces from standard fpqc coverings

An algebraic space over `S` is a sheaf for the fpqc topology of the big fppf category over `S` as
soon as it satisfies the sheaf condition for the fpqc covering presieves generated by a finite
family of flat morphisms whose sources and target have affine underlying scheme, that is, for
the standard fpqc coverings of Tag 022F.

## Main results

* `AlgebraicGeometry.BigFppfOver.sieve_generate_ofArrows_mem_topology`: a family in the big
  fppf category over `S` whose image in schemes is an fppf covering family generates a
  covering sieve of the site.
* `AlgebraicGeometry.IsAlgebraicSpace.isSheafFor_fpqc_of_isSheafFor_refinement`: for an
  algebraic space, the sheaf condition for an fpqc covering presieve follows from the sheaf
  condition for any fpqc covering presieve refining it.
* `AlgebraicGeometry.IsAlgebraicSpace.isSheaf_fpqc_of_isSheafFor_of_isAffine`: an algebraic
  space over `S` is an fpqc sheaf as soon as it satisfies the sheaf condition for the fpqc
  covering presieves of the objects whose underlying scheme is affine.
* `AlgebraicGeometry.BigFppfOver.exists_finite_affine_flat_refinement`: over an object with
  affine underlying scheme, every fpqc covering presieve is refined by a finite family of
  flat morphisms with affine sources which is itself an fpqc covering.
* `AlgebraicGeometry.IsAlgebraicSpace.isSheaf_fpqc_of_isSheafFor_affine_flat_finite`: an
  algebraic space over `S` is an fpqc sheaf as soon as it satisfies the sheaf condition for the
  standard fpqc coverings.

## References

* [Stacks Project, Tag 022F](https://stacks.math.columbia.edu/tag/022F)
* [Stacks Project, Tag 022H](https://stacks.math.columbia.edu/tag/022H)
* [Stacks Project, Tag 040I](https://stacks.math.columbia.edu/tag/040I)
* [Stacks Project, Tag 0APL](https://stacks.math.columbia.edu/tag/0APL)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

namespace BigFppfOver

/-! ### Covering sieves generated by a family -/

/-- A family of morphisms of the big fppf category over `S` whose image in schemes is an fppf
covering family generates a covering sieve of the site. -/
theorem sieve_generate_ofArrows_mem_topology {X : BigFppfOver B S hS} {ι : Type*}
    (Z : ι → BigFppfOver B S hS) (u : ∀ j, Z j ⟶ X)
    (h : Presieve.ofArrows (fun j => (toScheme B S hS).obj (Z j))
        (fun j => (toScheme B S hS).map (u j))
        ∈ Scheme.fppfPrecoverage ((toScheme B S hS).obj X)) :
    Sieve.generate (Presieve.ofArrows Z u) ∈ BigFppfOver.topology B S hS X := by
  have hB : Presieve.ofArrows (fun j => (Z j).left) (fun j => (u j).left) ∈
      B.precoverage X.left := by
    rwa [bigFppfPrecoverage_eq_comap B, Precoverage.mem_comap_iff, Presieve.map_ofArrows]
  refine (BigFppfOver.topology B S hS).superset_covering ?_
    (B.topology.overEquiv_symm_mem_over X _ (Precoverage.generate_mem_toGrothendieck hB))
  intro W k hk
  obtain ⟨Z₀, a₀, b₀, ⟨j⟩, hfac₀⟩ : Sieve.generate (Presieve.ofArrows (fun j => (Z j).left)
      (fun j => (u j).left)) k.left := by simpa using hk
  refine ⟨Z j, Over.homMk a₀ ?_, u j, ⟨j⟩, Over.OverMorphism.ext hfac₀⟩
  rw [← Over.w k, ← hfac₀, Category.assoc, Over.w (u j)]

/-! ### The refinement over an affine object -/

/-- If the scheme underlying `Y` is affine, every fpqc covering presieve of `Y` is refined by a
*finite* family of flat morphisms whose sources have affine underlying scheme, and that family is
again an fpqc covering of `Y`. -/
@[sga "3 IV 6.3.1" "(i), special case"]
theorem exists_finite_affine_flat_refinement {Y : BigFppfOver B S hS}
    (hY : IsAffine ((toScheme B S hS).obj Y)) (R : Presieve Y)
    (hR : R ∈ Scheme.fpqcPrecoverage.comap (toScheme B S hS) Y) :
    ∃ (m : ℕ) (W : Fin m → BigFppfOver B S hS) (w : ∀ i, W i ⟶ Y),
      (∀ i, IsAffine ((toScheme B S hS).obj (W i))) ∧
      (∀ i, Flat ((toScheme B S hS).map (w i))) ∧
      Presieve.ofArrows W w ∈ Scheme.fpqcPrecoverage.comap (toScheme B S hS) Y ∧
      Sieve.generate (Presieve.ofArrows W w) ≤ Sieve.generate R := by
  classical
  obtain ⟨ι, Z, g, rfl⟩ := R.exists_eq_ofArrows
  rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows] at hR
  obtain ⟨hqc, hfl⟩ := hR
  have hflat : ∀ i, Flat ((toScheme B S hS).map (g i)) :=
    fun i => ((Scheme.ofArrows_mem_precoverage_iff _).mp hfl).2 i
  let E : PreZeroHypercover _ :=
    ⟨ι, fun i => (toScheme B S hS).obj (Z i), fun i => (toScheme B S hS).map (g i)⟩
  have hEqc : QuasiCompactCover E := Scheme.presieve₀_mem_qcPrecoverage_iff.mp hqc
  obtain ⟨m, a, V, hVaff, hVcov⟩ := QuasiCompactCover.exists_isAffineOpen_of_isCompact E
    (U := ⊤) (isAffineOpen_top ((toScheme B S hS).obj Y)).isCompact
  let Wo : Fin m → BigFppfOver B S hS := fun i => Over.mk (Y := (⟨((V i : Scheme.{u})),
      Scheme.size_lt_of_isOpenImmersion (V i).ι (Z (a i)).left.2⟩ : B.Schemes))
        (ObjectProperty.homMk ((V i).ι ≫ (Z (a i)).hom.hom))
  let v : ∀ i, Wo i ⟶ Z (a i) := fun i => Over.homMk (ObjectProperty.homMk (V i).ι)
    (by apply ObjectProperty.hom_ext; rfl)
  have hvflat : ∀ i, Flat ((toScheme B S hS).map (v i)) := fun i =>
    inferInstanceAs (Flat (V i).ι)
  have hwflat : ∀ i, Flat ((toScheme B S hS).map (v i ≫ g (a i))) := fun i => by
    rw [Functor.map_comp]
    have := hvflat i
    have := hflat (a i)
    infer_instance
  have hcov : ∀ y : (toScheme B S hS).obj Y, ∃ i,
      y ∈ Set.range ((toScheme B S hS).map (v i ≫ g (a i))) := by
    intro y
    have hmem : y ∈ ((⊤ : ((toScheme B S hS).obj Y).Opens) : Set _) := trivial
    rw [← hVcov] at hmem
    obtain ⟨i, p, hp, hpe⟩ := Set.mem_iUnion.1 hmem
    obtain ⟨q, hq⟩ : ∃ q : ((V i : Scheme.{u})), (V i).ι q = p := by
      rwa [← (V i).range_ι] at hp
    refine ⟨i, q, ?_⟩
    rw [Functor.map_comp]
    show ((toScheme B S hS).map (g (a i))) ((V i).ι q) = y
    rw [hq, hpe]
  refine ⟨m, Wo, fun i => v i ≫ g (a i), fun i => hVaff i, hwflat, ?_, ?_⟩
  · rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    exact Scheme.ofArrows_mem_fpqcPrecoverage_of_finite hY
      (fun i => ((V i : Scheme.{u}))) _ (fun i => hVaff i) hwflat hcov
  · rw [Sieve.generate_le_iff]
    rintro T f ⟨i⟩
    exact ⟨Z (a i), v i, g (a i), ⟨a i⟩, rfl⟩

end BigFppfOver

namespace IsAlgebraicSpace

variable {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

/-- The pullback of the sieve generated by an fpqc covering presieve is separated for an algebraic
space. -/
private theorem isSeparatedFor_pullback_generate (hF : IsAlgebraicSpace B S hS F)
    {X Y : BigFppfOver B S hS} {R : Presieve X}
    (hR : R ∈ Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS) X) (f : Y ⟶ X) :
    Presieve.IsSeparatedFor F (Sieve.pullback f (Sieve.generate R)).arrows := by
  rw [← Sieve.pullbackArrows_comm, ← Presieve.isSeparatedFor_iff_generate]
  exact hF.isSeparatedFor_fpqc (Precoverage.pullbackArrows_mem f hR)

/-- The sheaf condition for an fpqc covering presieve of a *fixed* object follows from the
sheaf condition for any fpqc covering presieve refining it, for an algebraic space `F`. -/
theorem isSheafFor_fpqc_of_isSheafFor_refinement (hF : IsAlgebraicSpace B S hS F)
    {X : BigFppfOver B S hS} {R R' : Presieve X}
    (hR' : R' ∈ Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS) X)
    (hle : Sieve.generate R' ≤ Sieve.generate R) (hsheaf : Presieve.IsSheafFor F R') :
    Presieve.IsSheafFor F R := by
  rw [Presieve.isSheafFor_iff_generate]
  refine Presieve.isSheafFor_subsieve_aux F hle
    ((Presieve.isSheafFor_iff_generate _).mp hsheaf) fun Y f _ => ?_
  exact isSeparatedFor_pullback_generate hF hR' f

/-- An algebraic space over `S` is a sheaf for the fpqc topology of the big fppf category over
`S` as soon as it satisfies the sheaf condition for every fpqc covering presieve of an object
whose underlying scheme is *affine*. -/
theorem isSheaf_fpqc_of_isSheafFor_of_isAffine (hF : IsAlgebraicSpace B S hS F)
    (h : ∀ ⦃Y : BigFppfOver B S hS⦄ (R : Presieve Y),
      IsAffine ((BigFppfOver.toScheme B S hS).obj Y) →
      R ∈ Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS) Y →
      Presieve.IsSheafFor F R) :
    Presheaf.IsSheaf
      ((Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS)).toGrothendieck) F := by
  have hFsheaf : Presieve.IsSheaf (BigFppfOver.topology B S hS) F :=
    (isSheaf_iff_isSheaf_of_type _ _).mp hF.isSheaf
  refine isSheaf_fpqc_of_isSheafFor fun {X} R hR => ?_
  obtain ⟨J, Z, u, m, W, w, hZaff, hu, hzar, -, -, -, -⟩ :=
    BigFppfOver.exists_zariski_affine_flat_refinement R hR
  have hmem₀ : Sieve.generate (Presieve.ofArrows Z u) ∈ BigFppfOver.topology B S hS X := by
    refine BigFppfOver.sieve_generate_ofArrows_mem_topology Z u ?_
    rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows] at hzar
    exact Scheme.zariskiPrecoverage_le_fppfPrecoverage _ hzar
  let E₀ : PreZeroHypercover.{u} X := ⟨J, Z, u⟩
  let E : (BigFppfOver.topology B S hS).OneHypercover X :=
    GrothendieckTopology.OneHypercover.mk' E₀.toPreOneHypercover hmem₀ (fun i j =>
      (CategoryTheory.sieve₁'_toPreOneHypercover_eq_top E₀ i j) ▸
        GrothendieckTopology.top_mem _ _)
  refine E.isSheafFor_of_pullback hFsheaf (fun i => ?_) (fun i j k => ?_)
  · show Presieve.IsSheafFor F (Sieve.pullback (u i) (Sieve.generate R)).arrows
    rw [← Sieve.pullbackArrows_comm, ← Presieve.isSheafFor_iff_generate]
    exact h _ (hZaff i) (Precoverage.pullbackArrows_mem _ hR)
  · exact isSeparatedFor_pullback_generate hF hR _

/-- An algebraic space over `S` is a sheaf for the fpqc topology of the big fppf category over
`S` as soon as it satisfies the sheaf condition for the fpqc covering presieves generated by a
*finite* family of flat morphisms whose sources have affine underlying scheme, over an object
whose underlying scheme is affine: that is, for the standard fpqc coverings of Tag 022F. -/
theorem isSheaf_fpqc_of_isSheafFor_affine_flat_finite (hF : IsAlgebraicSpace B S hS F)
    (h : ∀ ⦃Y : BigFppfOver B S hS⦄ (m : ℕ) (W : Fin m → BigFppfOver B S hS)
      (w : ∀ i, W i ⟶ Y), IsAffine ((BigFppfOver.toScheme B S hS).obj Y) →
      (∀ i, IsAffine ((BigFppfOver.toScheme B S hS).obj (W i))) →
      (∀ i, Flat ((BigFppfOver.toScheme B S hS).map (w i))) →
      Presieve.ofArrows W w ∈
        Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS) Y →
      Presieve.IsSheafFor F (Presieve.ofArrows W w)) :
    Presheaf.IsSheaf
      ((Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS)).toGrothendieck) F := by
  refine hF.isSheaf_fpqc_of_isSheafFor_of_isAffine fun {Y} R hYaff hR => ?_
  obtain ⟨m, W, w, hWaff, hwflat, hmem, hle⟩ :=
    BigFppfOver.exists_finite_affine_flat_refinement hYaff R hR
  exact hF.isSheafFor_fpqc_of_isSheafFor_refinement hmem hle
    (h m W w hYaff hWaff hwflat hmem)

end IsAlgebraicSpace

end AlgebraicGeometry

end
