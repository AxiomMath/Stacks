/-!
# Continuity and limits for the chosen fppf, smooth and syntomic sites

The inclusion of a chosen big fppf, smooth or syntomic site's underlying category into all
schemes is continuous for the fpqc topology, because the covering families of those sites are
fppf, smooth and syntomic covering families of schemes, hence fpqc covering families. The
affine objects of the smooth and syntomic slices over `S` admit fibre products, and the
canonical functor to all schemes preserves them.

## Main results

* `AlgebraicGeometry.BigSmoothSite.coverPreserving_cutoffInclusion`,
  `AlgebraicGeometry.BigSyntomicSite.coverPreserving_inclusion` and the companion
  `isContinuous_*` statements, together with
  `AlgebraicGeometry.BigFppfSite.isContinuous_inclusion_fpqc`: the inclusion of a chosen big site's
  underlying category into all schemes is continuous for the fpqc topology.
* `AlgebraicGeometry.BigAffineSmooth.hasPullbacks`,
  `AlgebraicGeometry.BigAffineSmooth.preservesLimitsOfShape_toScheme` and their syntomic
  counterparts: the affine objects of a chosen big smooth or syntomic site over `S` admit fibre
  products, and the canonical functor to all schemes preserves them.

## Implementation notes

The restriction statements these results serve —
`AlgebraicGeometry.isSheaf_bigFppf_of_isSheaf_fpqc` and its five siblings for the big affine
fppf, big smooth, big affine smooth, big syntomic and big affine syntomic sites — are in
`StacksFrontier.AlgebraicGeometry.Topologies.Fpqc.Comparison`. They split into two shapes, because
the sites are presented differently.

For the three non-affine sites the topology is the *slice* of the chosen big site's own topology,
so the statement is restriction along `CategoryTheory.Over.post` of the inclusion, and it follows
from `CategoryTheory.Functor.isContinuous_overPost_of_preservesPullbacks` applied to the
continuity of that inclusion, which is what this file supplies.  The continuity in turn comes
from `CategoryTheory.coverPreserving_of_generators`, whose covering hypothesis is the site's own
covering predicate composed with the comparison of precoverages of Tag 022C.

For the three affine sites the topology is generated by a precoverage on the site itself, so the
route is `Stacks.Sites.isSheaf_toGrothendieck_of_precoverage_le` with
`Stacks.Sites.mem_comap_over_fpqcTopology` for the covering hypothesis.  The affine objects of
the smooth and syntomic slices are shown to admit fibre products here, by the same
full-subcategory argument as `AlgebraicGeometry.hasPullbacks_bigAffineFppf`: a fibre product of
affine schemes over an affine base is affine.

## References

* [Stacks Project, Tag 03O4](https://stacks.math.columbia.edu/tag/03O4)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u v

namespace AlgebraicGeometry

/-- A cover preserving functor into schemes is continuous for the fpqc topology. -/
private theorem isContinuous_of_coverPreserving_fpqc {C : Type (u + 1)} [Category.{u} C]
    [HasPullbacks C] (F : C ⥤ Scheme.{u}) [PreservesLimitsOfShape WalkingCospan F]
    (J : GrothendieckTopology C)
    (h : CoverPreserving J Scheme.fpqcTopology.{u} F) :
    F.IsContinuous J Scheme.fpqcTopology.{u} :=
  have : F.PreservesOneHypercovers.{u + 1} J Scheme.fpqcTopology.{u} :=
    Functor.PreservesOneHypercovers.of_coverPreserving h
  Functor.isContinuous_of_preservesOneHypercovers.{u + 1} _ _ _

namespace BigFppfSite

/-- The inclusion of a chosen big fppf site's underlying category into all schemes is continuous
for the fpqc topology. -/
public theorem isContinuous_inclusion_fpqc (B : BigFppfSite.{u}) :
    B.inclusion.IsContinuous B.topology Scheme.fpqcTopology.{u} :=
  isContinuous_of_coverPreserving_fpqc _ _ B.coverPreserving_inclusion

end BigFppfSite

namespace BigSmoothSite

/-- The inclusion of a chosen big smooth site's cutoff category into all schemes is cover
preserving from the site's topology to the fpqc topology, because each selected covering family
is a smooth covering of schemes and smooth coverings are fpqc coverings. -/
public theorem coverPreserving_cutoffInclusion (B : BigSmoothSite.{u}) :
    CoverPreserving B.grothendieckTopology Scheme.fpqcTopology.{u}
      (ObjectProperty.ι (AlgebraicGeometry.schemeSizeBelow B.cutoff)) := by
  refine coverPreserving_of_generators _ B.precoverage _ ?_
  intro X R hR
  obtain ⟨E, hE, rfl⟩ := hR
  rw [← Sieve.generate_map_eq_functorPushforward]
  refine Precoverage.generate_mem_toGrothendieck ?_
  refine Scheme.smoothPrecoverage_le_fpqcPrecoverage _ ?_
  rw [PreZeroHypercover.presieve₀, Presieve.map_ofArrows]
  exact hE.1

/-- The inclusion of a chosen big smooth site's cutoff category into all schemes is continuous
for the fpqc topology. -/
public theorem isContinuous_cutoffInclusion (B : BigSmoothSite.{u}) :
    (ObjectProperty.ι (AlgebraicGeometry.schemeSizeBelow B.cutoff)).IsContinuous
      B.grothendieckTopology Scheme.fpqcTopology.{u} :=
  isContinuous_of_coverPreserving_fpqc _ _ B.coverPreserving_cutoffInclusion

end BigSmoothSite

namespace BigSyntomicSite

/-- The inclusion of a chosen big syntomic site's underlying category into all schemes is cover
preserving from the site's topology to the fpqc topology, because each selected covering family
is a syntomic covering of schemes and syntomic coverings are fpqc coverings. -/
public theorem coverPreserving_inclusion (B : BigSyntomicSite.{u}) :
    CoverPreserving B.topology Scheme.fpqcTopology.{u} B.inclusion := by
  refine coverPreserving_of_generators _ B.precoverage _ ?_
  intro X R hR
  obtain ⟨E, rfl, hE⟩ := hR
  rw [← Sieve.generate_map_eq_functorPushforward]
  refine Precoverage.generate_mem_toGrothendieck ?_
  refine Scheme.syntomicPrecoverage_le_fpqcPrecoverage _ ?_
  have h := hE.1
  have hsurj : ∀ x : (B.inclusion.obj X), ∃ i, x ∈ Set.range (B.inclusion.map (E.f i)) := by
    intro x
    have h₂ := h.2
    simp only [Set.eq_univ_iff_forall, Set.mem_iUnion] at h₂
    exact h₂ x
  have hm := (Scheme.ofArrows_mem_precoverage_iff
    (P := (@Syntomic : MorphismProperty Scheme.{u}))
    (f := fun i => B.inclusion.map (E.f i))).mpr ⟨hsurj, fun i => h.1 i⟩
  simpa [PreZeroHypercover.presieve₀, Presieve.map_ofArrows] using hm

/-- The inclusion of a chosen big syntomic site's underlying category into all schemes is
continuous for the fpqc topology. -/
public theorem isContinuous_inclusion (B : BigSyntomicSite.{u}) :
    B.inclusion.IsContinuous B.topology Scheme.fpqcTopology.{u} :=
  isContinuous_of_coverPreserving_fpqc _ _ B.coverPreserving_inclusion

end BigSyntomicSite

namespace BigAffineSmooth

variable (B : BigSmoothSite.{u}) (S : Scheme.{u}) (hS : S.size < B.cutoff)

/-- The inclusion of the affine slice into the big smooth category over `S` creates fibre
products, because a fibre product of affine schemes over an affine base is affine. -/
public noncomputable instance createsLimitsOfShape_inclusion :
    CreatesLimitsOfShape WalkingCospan (BigAffineSmooth.inclusion B S hS) where
  CreatesLimit := fun {F} => by
    let G := BigSmoothOver.toScheme B S hS
    let D := F ⋙ BigAffineSmooth.inclusion B S hS
    let _ (j : WalkingCospan) : IsAffine (G.obj (D.obj j)) := (F.obj j).property
    let t := pullback.cone (D.map WalkingCospan.Hom.inl) (D.map WalkingCospan.Hom.inr)
    exact createsLimitFullSubcategoryInclusion' F
      ((IsLimit.postcomposeInvEquiv (diagramIsoCospan D) t).symm (limit.isLimit _)) (by
      let e := PreservesPullback.iso G (D.map WalkingCospan.Hom.inl)
        (D.map WalkingCospan.Hom.inr)
      exact @IsAffine.of_isIso _ _ e.hom e.isIso_hom inferInstance)

/-- The affine objects of the big smooth category over `S` admit fibre products. -/
public instance hasPullbacks : HasPullbacks (BigAffineSmooth B S hS) :=
  hasLimitsOfShape_of_hasLimitsOfShape_createsLimitsOfShape (BigAffineSmooth.inclusion B S hS)

/-- The canonical functor from the affine objects of the big smooth category over `S` to all
schemes preserves fibre products. -/
public instance preservesLimitsOfShape_toScheme :
    PreservesLimitsOfShape WalkingCospan (BigAffineSmooth.toScheme B S hS) :=
  comp_preservesLimitsOfShape _ _

end BigAffineSmooth

namespace BigAffineSyntomic

variable (B : BigSyntomicSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The inclusion of the affine slice into the big syntomic category over `S` creates fibre
products, because a fibre product of affine schemes over an affine base is affine. -/
public noncomputable instance createsLimitsOfShape_inclusion :
    CreatesLimitsOfShape WalkingCospan (BigAffineSyntomic.inclusion B S hS) where
  CreatesLimit := fun {F} => by
    let G := BigSyntomicOver.toScheme B S hS
    let D := F ⋙ BigAffineSyntomic.inclusion B S hS
    let _ (j : WalkingCospan) : IsAffine (G.obj (D.obj j)) := (F.obj j).property
    let t := pullback.cone (D.map WalkingCospan.Hom.inl) (D.map WalkingCospan.Hom.inr)
    exact createsLimitFullSubcategoryInclusion' F
      ((IsLimit.postcomposeInvEquiv (diagramIsoCospan D) t).symm (limit.isLimit _)) (by
      let e := PreservesPullback.iso G (D.map WalkingCospan.Hom.inl)
        (D.map WalkingCospan.Hom.inr)
      exact @IsAffine.of_isIso _ _ e.hom e.isIso_hom inferInstance)

/-- The affine objects of the big syntomic category over `S` admit fibre products. -/
public instance hasPullbacks : HasPullbacks (BigAffineSyntomic B S hS) :=
  hasLimitsOfShape_of_hasLimitsOfShape_createsLimitsOfShape (BigAffineSyntomic.inclusion B S hS)

/-- The canonical functor from the affine objects of the big syntomic category over `S` to all
schemes preserves fibre products. -/
public instance preservesLimitsOfShape_toScheme :
    PreservesLimitsOfShape WalkingCospan (BigAffineSyntomic.toScheme B S hS) :=
