module

public import StacksFrontier.AlgebraicGeometry.Topologies.Fpqc.Coverings
public import StacksFrontier.AlgebraicGeometry.Morphisms.Syntomic.Properties
public import StacksFrontier.AlgebraicGeometry.Topologies.SmallEtaleGlobalFunctions
public import Mathlib.CategoryTheory.Sites.Over
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The fpqc topology is finer than the smooth and syntomic topologies

The fpqc topology on schemes is finer than the Zariski, étale, smooth, syntomic and fppf
topologies, so an fpqc sheaf on the schemes over a base is a sheaf for each of those topologies
induced on the schemes over that base.

The two syntomic comparisons of precoverages that this needs --
`AlgebraicGeometry.Scheme.syntomicPrecoverage_le_fppfPrecoverage` and
`AlgebraicGeometry.Scheme.syntomicPrecoverage_le_fpqcPrecoverage` -- are
`StacksFrontier.AlgebraicGeometry.Descent.QuasiCoherent.TopologyComparison`, which this module
imports: that is where they carry their Stacks 021N and 022C attributes.

## Main results

* `Stacks.Sites.over_mono`: the topology induced on the slice category by a finer topology is
  finer.
* `AlgebraicGeometry.Scheme.smoothTopology_le_fpqcTopology` and
  `AlgebraicGeometry.Scheme.syntomicTopology_le_fpqcTopology`: the smooth and syntomic
  comparisons of topologies.
* `AlgebraicGeometry.isSheaf_zariski_of_isSheaf_fpqc`,
  `AlgebraicGeometry.isSheaf_etale_of_isSheaf_fpqc`,
  `AlgebraicGeometry.isSheaf_smooth_of_isSheaf_fpqc`,
  `AlgebraicGeometry.isSheaf_syntomic_of_isSheaf_fpqc` and
  `AlgebraicGeometry.isSheaf_fppf_of_isSheaf_fpqc`: an fpqc sheaf on the schemes over `S` is a
  sheaf for each of the five coarser topologies induced on the schemes over `S`.

## Implementation notes

The topologies are compared on the common category of all schemes, and the sheaf implications
are then read off on the slice category by `Stacks.Sites.over_mono`, so each of the five is one
application of `CategoryTheory.Presheaf.IsSheaf.of_le`.  The Zariski and fppf comparisons are
Mathlib's `AlgebraicGeometry.Scheme.zariskiTopology_le_fpqcTopology` and
`AlgebraicGeometry.Scheme.fppfTopology_le_fpqcTopology`, and the étale one is
`Stacks.Sites.etaleTopology_le_fpqcTopology`; all three are adopted directly.

The syntomic topology is the one generated by the syntomic morphism property of Tag 01UC,
`AlgebraicGeometry.Syntomic`.

## References

* [Stacks Project, Tag 03O4](https://stacks.math.columbia.edu/tag/03O4)
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

universe u v

namespace Stacks.Sites

/-- A finer topology induces a finer topology on a slice category: if `J ≤ K` then
`J.over S ≤ K.over S`. -/
public theorem over_mono {C : Type*} [Category C] {J K : GrothendieckTopology C} (h : J ≤ K)
    (S : C) : J.over S ≤ K.over S := by
  intro X R hR
  rw [GrothendieckTopology.mem_over_iff] at hR ⊢
  exact h _ hR

end Stacks.Sites

namespace AlgebraicGeometry

namespace Scheme

/-- **Stacks 021N.** Every syntomic covering family is an fppf covering family: a syntomic
morphism is flat by Stacks 01UL and locally of finite presentation by Stacks 01UK. -/
@[stacks 021N "syntomic coverings"]
public theorem syntomicPrecoverage_le_fppfPrecoverage :
    Scheme.precoverage (@Syntomic : MorphismProperty Scheme.{u}) ≤ Scheme.fppfPrecoverage :=
  Scheme.precoverage_mono fun _ _ _ hf ↦ ⟨flat hf, locallyOfFinitePresentation hf⟩

/-- **Stacks 022C.** Every syntomic covering family is an fpqc covering family. -/
@[stacks 022C "syntomic coverings"]
public theorem syntomicPrecoverage_le_fpqcPrecoverage :
    Scheme.precoverage (@Syntomic : MorphismProperty Scheme.{u}) ≤ Scheme.fpqcPrecoverage :=
  syntomicPrecoverage_le_fppfPrecoverage.trans Scheme.fppfPrecoverage_le_fpqcPrecoverage

/-- **The smooth comparison of Tag 03O4.** The fpqc topology is finer than the smooth
topology. -/
@[stacks 03O4 "smooth topology"]
public theorem smoothTopology_le_fpqcTopology :
    Scheme.grothendieckTopology (@Smooth : MorphismProperty Scheme.{u}) ≤
      Scheme.fpqcTopology.{u} :=
  Precoverage.toGrothendieck_mono Scheme.smoothPrecoverage_le_fpqcPrecoverage

/-- **The syntomic comparison of Tag 03O4.** The fpqc topology is finer than the syntomic
topology. -/
@[stacks 03O4 "syntomic topology"]
public theorem syntomicTopology_le_fpqcTopology :
    Scheme.grothendieckTopology (@Syntomic : MorphismProperty Scheme.{u}) ≤
      Scheme.fpqcTopology.{u} :=
  Precoverage.toGrothendieck_mono syntomicPrecoverage_le_fpqcPrecoverage

end Scheme

/-- **Stacks 03O4.** An fpqc sheaf on the schemes over `S` is a Zariski sheaf. -/
@[stacks 03O4 "Zariski sheaves", sga "3 XI 3.4" "fpqc example"]
public theorem isSheaf_zariski_of_isSheaf_fpqc (S : Scheme.{u}) (F : (Over S)ᵒᵖ ⥤ Type v)
    (hF : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) F) :
    Presheaf.IsSheaf (Scheme.zariskiTopology.over S) F :=
  Presheaf.IsSheaf.of_le (Stacks.Sites.over_mono Scheme.zariskiTopology_le_fpqcTopology S) hF

/-- **Stacks 03O4.** An fpqc sheaf on the schemes over `S` is an étale sheaf. -/
@[stacks 03O4 "étale sheaves"]
public theorem isSheaf_etale_of_isSheaf_fpqc (S : Scheme.{u}) (F : (Over S)ᵒᵖ ⥤ Type v)
    (hF : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) F) :
    Presheaf.IsSheaf (Scheme.etaleTopology.over S) F :=
  Presheaf.IsSheaf.of_le
    (Stacks.Sites.over_mono Stacks.Sites.etaleTopology_le_fpqcTopology S) hF

/-- **Stacks 03O4.** An fpqc sheaf on the schemes over `S` is a smooth sheaf. -/
@[stacks 03O4 "smooth sheaves"]
public theorem isSheaf_smooth_of_isSheaf_fpqc (S : Scheme.{u}) (F : (Over S)ᵒᵖ ⥤ Type v)
    (hF : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) F) :
    Presheaf.IsSheaf
      ((Scheme.grothendieckTopology (@Smooth : MorphismProperty Scheme.{u})).over S) F :=
  Presheaf.IsSheaf.of_le (Stacks.Sites.over_mono Scheme.smoothTopology_le_fpqcTopology S) hF

/-- **Stacks 03O4.** An fpqc sheaf on the schemes over `S` is a syntomic sheaf. -/
@[stacks 03O4 "syntomic sheaves"]
public theorem isSheaf_syntomic_of_isSheaf_fpqc (S : Scheme.{u}) (F : (Over S)ᵒᵖ ⥤ Type v)
    (hF : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) F) :
    Presheaf.IsSheaf
      ((Scheme.grothendieckTopology (@Syntomic : MorphismProperty Scheme.{u})).over S) F :=
  Presheaf.IsSheaf.of_le (Stacks.Sites.over_mono Scheme.syntomicTopology_le_fpqcTopology S) hF

/-- **Stacks 03O4.** An fpqc sheaf on the schemes over `S` is an fppf sheaf. -/
@[stacks 03O4 "fppf sheaves"]
public theorem isSheaf_fppf_of_isSheaf_fpqc (S : Scheme.{u}) (F : (Over S)ᵒᵖ ⥤ Type v)
    (hF : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) F) :
    Presheaf.IsSheaf (Scheme.fppfTopology.over S) F :=
  Presheaf.IsSheaf.of_le (Stacks.Sites.over_mono Scheme.fppfTopology_le_fpqcTopology S) hF

end AlgebraicGeometry

end
