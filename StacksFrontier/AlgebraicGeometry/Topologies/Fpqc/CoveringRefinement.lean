module

public import StacksFrontier.AlgebraicGeometry.Topologies.Fpqc.SheafConditionExistence
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Refining an fpqc covering of the big fppf category over `S`

An arbitrary fpqc covering presieve of an object `X` of the big fppf category over a scheme `S`
is refined by a Zariski covering of `X` which is in turn refined, over each member, by a standard
fpqc covering — a finite family of flat morphisms of affine objects which is jointly surjective.
This is Stacks 022H transported to the big fppf category over `S`. As a consequence, an
algebraic space over `S` is an fpqc sheaf as soon as it satisfies the sheaf condition for the
fpqc covering presieves generated by flat morphisms from affine objects, which is the first
reduction in the proof of Stacks 0APL.

## Main results

* `AlgebraicGeometry.Scheme.ofArrows_mem_fpqcPrecoverage_of_finite`: a finite, jointly
  surjective family of flat morphisms of affine schemes is an fpqc covering family. This is
  the scheme-level statement that a standard fpqc covering (Stacks 022F) is fpqc.
* `AlgebraicGeometry.BigFppfOver.exists_affine_flat_family_of_isAffineOpen`: given an affine
  open `U` of `X` and finitely many affine opens of the sources of a family over `X` whose
  images cover `U` exactly, there is an object of the site with underlying scheme `U`, and a
  standard fpqc covering of it each of whose members factors through a member of the given
  family.
* `AlgebraicGeometry.BigFppfOver.exists_zariski_affine_flat_refinement`: **the refinement**.
  An fpqc covering presieve of `X` is refined by a Zariski covering `{Y j ⟶ X}` of `X` by affine
  objects, together with, for each `j`, a finite family `{W j i ⟶ Y j}` of flat morphisms of
  affine objects which is an fpqc covering of `Y j`, such that every composite
  `W j i ⟶ Y j ⟶ X` factors through a member of the given presieve.
* `AlgebraicGeometry.BigFppfOver.exists_mem_fpqc_refinement_affine_flat`: the same refinement
  flattened to a single fpqc covering presieve of `X`.
* `AlgebraicGeometry.IsAlgebraicSpace.isSheaf_fpqc_of_isSheafFor_affine_flat`: an algebraic
  space over `S` is an fpqc sheaf as soon as it satisfies the sheaf condition for the fpqc
  covering presieves generated by a family of flat morphisms whose sources are affine.

## Implementation notes

The only geometric input is Mathlib's
`AlgebraicGeometry.QuasiCompactCover.exists_isAffineOpen_of_isCompact`: a quasi-compact
covering family of a scheme and a compact open `U` of its target produce **finitely many**
affine opens of the sources whose images are **exactly** `U`. Membership of `R` in
`AlgebraicGeometry.Scheme.fpqcPrecoverage` after transport along the canonical functor to
schemes gives precisely that quasi-compactness, because
`AlgebraicGeometry.Scheme.fpqcPrecoverage` is by definition the quasi-compact precoverage of
flat morphisms. Running this over all affine opens of `X` at once produces both stages of the
refinement simultaneously: the affine opens are the Zariski stage, and the chosen affine opens
of the sources are the standard fpqc coverings refining it.

The sources of the refinement are open subschemes of the sources of the given family, so they
lie in the size-bounded subcategory by `AlgebraicGeometry.Scheme.size_lt_of_isOpenImmersion`,
and the structure morphisms to `S` are inherited. The morphism `W j i ⟶ Y j` is
`AlgebraicGeometry.Scheme.Hom.resLE` of a member of the given family, which is flat because
`AlgebraicGeometry.Flat` is stable under `Scheme.Hom.resLE`, and the factorisation
`W j i ⟶ Y j ⟶ X` through that member is `AlgebraicGeometry.Scheme.Hom.resLE_comp_ι`.

A standard fpqc covering (Stacks 022F) is a finite jointly surjective family of **flat**
morphisms of affine schemes; it is *not* required to be of finite presentation. The
repository's `AlgebraicGeometry.IsStandardFppfCovering` carries finite presentation as a field,
so it is not the predicate used here: the conditions are spelled out in the statements.

## References

* [Stacks Project, Tag 022F](https://stacks.math.columbia.edu/tag/022F)
* [Stacks Project, Tag 022H](https://stacks.math.columbia.edu/tag/022H)
* [Stacks Project, Tag 0APL](https://stacks.math.columbia.edu/tag/0APL)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry

/-! ### Standard fpqc coverings of a scheme -/

/-- Every covering family in `AlgebraicGeometry.Scheme.precoverage @Flat` is jointly
surjective. -/
theorem Scheme.jointlySurjective_precoverage_flat :
    Scheme.JointlySurjective (Scheme.precoverage (@Flat)) where
  exists_eq {X} R hR x := by
    obtain ⟨ι, Y, f, rfl⟩ := R.exists_eq_ofArrows
    obtain ⟨i, hi⟩ := ((Scheme.ofArrows_mem_precoverage_iff _).mp hR).1 x
    exact ⟨Y i, f i, ⟨i⟩, hi⟩

/-- A **standard fpqc covering** is an fpqc covering family: a finite, jointly surjective
family of flat morphisms from affine schemes to an affine scheme belongs to
`AlgebraicGeometry.Scheme.fpqcPrecoverage`. -/
@[sga "3 IV 6.3.1" "(v), special case", sga "3 IV 6.3.2" "special case"]
theorem Scheme.ofArrows_mem_fpqcPrecoverage_of_finite {T : Scheme.{u}} (hT : IsAffine T)
    {m : ℕ} (Y : Fin m → Scheme.{u}) (q : ∀ i, Y i ⟶ T) (hY : ∀ i, IsAffine (Y i))
    (hq : ∀ i, Flat (q i)) (hcov : ∀ x : T, ∃ i, x ∈ Set.range (q i)) :
    Presieve.ofArrows Y q ∈ Scheme.fpqcPrecoverage T := by
  have := hT
  let 𝒰 : T.Cover (Scheme.precoverage @Flat) := Scheme.Cover.mkOfCovers (Fin m) Y q hcov hq
  have hcompact : ∀ i, QuasiCompact (𝒰.f i) := fun i => by
    change QuasiCompact (q i)
    have := hY i
    have : IsAffineHom (q i) := inferInstance
    infer_instance
  have := Scheme.jointlySurjective_precoverage_flat
  have hfin : Finite 𝒰.I₀ := inferInstanceAs (Finite (Fin m))
  have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover := QuasiCompactCover.of_finite
  exact ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.2 hqc,
    (Scheme.ofArrows_mem_precoverage_iff _).2 ⟨hcov, hq⟩⟩

namespace BigFppfOver

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-! ### The refinement over one affine open -/

/-- Let `{g i : Z i ⟶ X}` be a family of flat morphisms in the big fppf category over `S`, let
`U` be an affine open of the scheme underlying `X`, and let `V i` be finitely many affine opens
of the schemes underlying the sources, chosen so that the images of the `V i` are *exactly* `U`.

Then `U` is the underlying scheme of an object `Y` of the site, with the open immersion as a
morphism `Y ⟶ X`, and the `V i` are the underlying schemes of objects `W i` forming a standard
fpqc covering `{W i ⟶ Y}` of `Y`: finitely many flat morphisms of affine objects, jointly
surjective. Each `W i ⟶ Y ⟶ X` factors through `g (a i)`. -/
theorem exists_affine_flat_family_of_isAffineOpen {X : BigFppfOver B S hS} {ι : Type*}
    (Z : ι → BigFppfOver B S hS) (g : ∀ i, Z i ⟶ X)
    (hflat : ∀ i, Flat ((toScheme B S hS).map (g i)))
    {U : ((toScheme B S hS).obj X).Opens} (hU : IsAffineOpen U)
    {m : ℕ} (a : Fin m → ι) (V : ∀ i, ((toScheme B S hS).obj (Z (a i))).Opens)
    (hVaff : ∀ i, IsAffineOpen (V i))
    (hVcov : ⋃ i, ((toScheme B S hS).map (g (a i))) '' (V i) = (U : Set _)) :
    ∃ (Y : BigFppfOver B S hS) (u : Y ⟶ X) (W : Fin m → BigFppfOver B S hS)
      (w : ∀ i, W i ⟶ Y),
      IsAffine ((toScheme B S hS).obj Y) ∧
      IsOpenImmersion ((toScheme B S hS).map u) ∧
      Set.range ((toScheme B S hS).map u) = (U : Set _) ∧
      (∀ i, IsAffine ((toScheme B S hS).obj (W i))) ∧
      (∀ i, Flat ((toScheme B S hS).map (w i))) ∧
      Presieve.ofArrows W w ∈ Scheme.fpqcPrecoverage.comap (toScheme B S hS) Y ∧
      ∀ i, ∃ v : W i ⟶ Z (a i), w i ≫ u = v ≫ g (a i) := by
  have hle : ∀ i, V i ≤ ((toScheme B S hS).map (g (a i))) ⁻¹ᵁ U := fun i p hp => by
    change _ ∈ (U : Set ((toScheme B S hS).obj X))
    rw [← hVcov]
    exact Set.mem_iUnion.2 ⟨i, p, hp, rfl⟩
  have hresflat : ∀ i, Flat (((toScheme B S hS).map (g (a i))).resLE U (V i) (hle i)) := fun i => by
    have := hflat (a i)
    infer_instance
  refine ⟨Over.mk (Y := (⟨(U : Scheme.{u}),
      Scheme.size_lt_of_isOpenImmersion U.ι X.left.2⟩ : B.Schemes))
        (ObjectProperty.homMk (U.ι ≫ X.hom.hom)),
    Over.homMk (ObjectProperty.homMk U.ι) (by apply ObjectProperty.hom_ext; rfl),
    fun i => Over.mk (Y := (⟨((V i : Scheme.{u})),
      Scheme.size_lt_of_isOpenImmersion (V i).ι (Z (a i)).left.2⟩ : B.Schemes))
        (ObjectProperty.homMk ((V i).ι ≫ (Z (a i)).hom.hom)),
    fun i => Over.homMk
      (ObjectProperty.homMk (((toScheme B S hS).map (g (a i))).resLE U (V i) (hle i)))
      (by
        apply ObjectProperty.hom_ext
        change (((toScheme B S hS).map (g (a i))).resLE U (V i) (hle i) ≫ U.ι) ≫ X.hom.hom
          = (V i).ι ≫ (Z (a i)).hom.hom
        rw [Scheme.Hom.resLE_comp_ι, Category.assoc]
        exact congrArg (fun k => (V i).ι ≫ k)
          (congrArg InducedCategory.Hom.hom (Over.w (g (a i))))),
    hU, ?_, U.range_ι, fun i => hVaff i, hresflat, ?_, fun i => ?_⟩
  · exact inferInstanceAs (IsOpenImmersion U.ι)
  · have hUaff : IsAffine (U : Scheme.{u}) := hU
    rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    refine Scheme.ofArrows_mem_fpqcPrecoverage_of_finite hUaff
      (fun i => ((V i : Scheme.{u}))) _ (fun i => hVaff i) hresflat (fun y => ?_)
    · have hmem : U.ι y ∈ (U : Set ((toScheme B S hS).obj X)) := by
        rw [← U.range_ι]
        exact ⟨y, rfl⟩
      rw [← hVcov] at hmem
      obtain ⟨i, p, hp, hpe⟩ := Set.mem_iUnion.1 hmem
      obtain ⟨q, hq⟩ : ∃ q : ((V i : Scheme.{u})), (V i).ι q = p := by
        rw [← (V i).range_ι] at hp
        exact hp
      refine ⟨i, q, ?_⟩
      change (((toScheme B S hS).map (g (a i))).resLE U (V i) (hle i)) q = y
      apply U.ι.isOpenEmbedding.injective
      rw [← Scheme.Hom.comp_apply, Scheme.Hom.resLE_comp_ι, Scheme.Hom.comp_apply, hq, hpe]
  · exact ⟨Over.homMk (ObjectProperty.homMk (V i).ι)
      (by apply ObjectProperty.hom_ext; rfl), by
      apply Over.OverMorphism.ext
      apply ObjectProperty.hom_ext
      exact Scheme.Hom.resLE_comp_ι _ (hle i)⟩

/-! ### The refinement -/

/-- **Stacks 022H for the big fppf category over `S`, covering-theoretic form.** Every fpqc
covering presieve `R` of an object `X` of the big fppf category over `S` is refined by a
Zariski covering of `X` by affine objects which is in turn refined, over each of its members,
by a standard fpqc covering, in such a way that every member of the resulting family factors
through a member of `R`.

Concretely: there are objects `Y j` with affine underlying scheme and open immersions
`u j : Y j ⟶ X` forming a Zariski covering of `X`, and for each `j` finitely many objects
`W j i` with affine underlying scheme and flat morphisms `w j i : W j i ⟶ Y j` forming an fpqc
covering of `Y j`, such that each `w j i ≫ u j` factors through a member of `R`. -/
@[sga "3 IV 6.3.1" "(i), special case"]
theorem exists_zariski_affine_flat_refinement {X : BigFppfOver B S hS} (R : Presieve X)
    (hR : R ∈ Scheme.fpqcPrecoverage.comap (toScheme B S hS) X) :
    ∃ (J : Type u) (Y : J → BigFppfOver B S hS) (u : ∀ j, Y j ⟶ X) (m : J → ℕ)
      (W : ∀ j, Fin (m j) → BigFppfOver B S hS) (w : ∀ j i, W j i ⟶ Y j),
      (∀ j, IsAffine ((toScheme B S hS).obj (Y j))) ∧
      (∀ j, IsOpenImmersion ((toScheme B S hS).map (u j))) ∧
      Presieve.ofArrows Y u ∈ Scheme.zariskiPrecoverage.comap (toScheme B S hS) X ∧
      (∀ j i, IsAffine ((toScheme B S hS).obj (W j i))) ∧
      (∀ j i, Flat ((toScheme B S hS).map (w j i))) ∧
      (∀ j, Presieve.ofArrows (W j) (w j) ∈
        Scheme.fpqcPrecoverage.comap (toScheme B S hS) (Y j)) ∧
      ∀ j i, ∃ (T : BigFppfOver B S hS) (f : T ⟶ X), R f ∧
        ∃ v : W j i ⟶ T, w j i ≫ u j = v ≫ f := by
  classical
  obtain ⟨ι, Z, g, rfl⟩ := R.exists_eq_ofArrows
  rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows] at hR
  obtain ⟨hqc, hfl⟩ := hR
  have hflat : ∀ i, Flat ((toScheme B S hS).map (g i)) :=
    fun i => ((Scheme.ofArrows_mem_precoverage_iff _).mp hfl).2 i
  let E : PreZeroHypercover _ :=
    ⟨ι, fun i => (toScheme B S hS).obj (Z i), fun i => (toScheme B S hS).map (g i)⟩
  have hEqc : QuasiCompactCover E := Scheme.presieve₀_mem_qcPrecoverage_iff.mp hqc
  choose m a V hVaff hVcov using fun (U : ((toScheme B S hS).obj X).affineOpens) =>
    QuasiCompactCover.exists_isAffineOpen_of_isCompact E U.2.isCompact
  choose Y u W w hYaff hu hrange hWaff hwflat hWfpqc hfac using
    fun (U : ((toScheme B S hS).obj X).affineOpens) =>
      exists_affine_flat_family_of_isAffineOpen Z g hflat U.2 (a U) (V U) (hVaff U) (hVcov U)
  refine ⟨_, Y, u, m, W, w, hYaff, hu, ?_, hWaff, hwflat, hWfpqc,
    fun j i => ⟨Z (a j i), g (a j i), ⟨a j i⟩, hfac j i⟩⟩
  rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
  refine (Scheme.ofArrows_mem_precoverage_iff _).2 ⟨fun x => ?_, fun j => hu j⟩
  obtain ⟨W', hW', hxW', -⟩ := exists_isAffineOpen_mem_and_subset
    (X := (toScheme B S hS).obj X) (x := x) (U := ⊤) trivial
  exact ⟨⟨W', hW'⟩, (hrange ⟨W', hW'⟩).symm ▸ hxW'⟩

/-- **Stacks 022H for the big fppf category over `S`.** Every fpqc covering presieve of an
object `X` of the big fppf category over `S` is refined by an fpqc covering presieve generated
by a family of flat morphisms whose sources have affine underlying scheme. -/
theorem exists_mem_fpqc_refinement_affine_flat {X : BigFppfOver B S hS} (R : Presieve X)
    (hR : R ∈ Scheme.fpqcPrecoverage.comap (toScheme B S hS) X) :
    ∃ (K : Type u) (W : K → BigFppfOver B S hS) (w : ∀ k, W k ⟶ X),
      (∀ k, IsAffine ((toScheme B S hS).obj (W k))) ∧
      (∀ k, Flat ((toScheme B S hS).map (w k))) ∧
      Presieve.ofArrows W w ∈ Scheme.fpqcPrecoverage.comap (toScheme B S hS) X ∧
      Sieve.generate (Presieve.ofArrows W w) ≤ Sieve.generate R := by
  obtain ⟨J, Y, u, m, W, w, hYaff, hu, hzar, hWaff, hwflat, hWfpqc, hfac⟩ :=
    exists_zariski_affine_flat_refinement R hR
  have hzar' : Presieve.ofArrows Y u ∈ Scheme.fpqcPrecoverage.comap (toScheme B S hS) X :=
    Precoverage.comap_monotone Scheme.zariskiPrecoverage_le_fpqcPrecoverage _ hzar
  refine ⟨Σ j, Fin (m j), fun p => W p.1 p.2, fun p => w p.1 p.2 ≫ u p.1,
    fun p => hWaff p.1 p.2, fun p => ?_,
    Precoverage.comp_mem_coverings u hzar' (fun j i => w j i) hWfpqc, ?_⟩
  · rw [Functor.map_comp]
    have := hu p.1
    have := hwflat p.1 p.2
    infer_instance
  · rw [Sieve.generate_le_iff]
    rintro T f ⟨p⟩
    obtain ⟨T', f', hf', v, hv⟩ := hfac p.1 p.2
    exact ⟨T', v, f', hf', hv.symm⟩

end BigFppfOver

namespace IsAlgebraicSpace

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}

/-- **Stacks 0APL after its first reduction.** An algebraic space over `S` is a sheaf for the
fpqc topology of the big fppf category over `S` as soon as it satisfies the sheaf condition
for every fpqc covering presieve generated by a family of flat morphisms whose sources have
affine underlying scheme. -/
theorem isSheaf_fpqc_of_isSheafFor_affine_flat (hF : IsAlgebraicSpace B S hS F)
    (h : ∀ ⦃X : BigFppfOver B S hS⦄ (K : Type u) (W : K → BigFppfOver B S hS)
      (w : ∀ k, W k ⟶ X), (∀ k, IsAffine ((BigFppfOver.toScheme B S hS).obj (W k))) →
      (∀ k, Flat ((BigFppfOver.toScheme B S hS).map (w k))) →
      Presieve.ofArrows W w ∈
        Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS) X →
      Presieve.IsSheafFor F (Presieve.ofArrows W w)) :
    Presheaf.IsSheaf
      ((Scheme.fpqcPrecoverage.comap (BigFppfOver.toScheme B S hS)).toGrothendieck) F := by
  refine hF.isSheaf_fpqc_of_isSheafFor_refinement fun {X} R hR => ?_
  obtain ⟨K, W, w, hWaff, hwflat, hmem, hle⟩ :=
    BigFppfOver.exists_mem_fpqc_refinement_affine_flat R hR
  exact ⟨_, hmem, hle, h K W w hWaff hwflat hmem⟩

end IsAlgebraicSpace

end AlgebraicGeometry

