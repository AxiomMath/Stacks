module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.Limits
public import StacksFrontier.AlgebraicGeometry.Topologies.Fpqc.Comparison

/-!
# The fpqc sheaf condition on a site of schemes over a base

A site whose objects are schemes over a fixed base `S` carries an fpqc topology: the one
generated by those families of the site whose image in schemes is an fpqc covering family.
This file relates that topology to the fpqc topology induced on *all* schemes over `S`, for an
arbitrary category mapping to the schemes over `S`, and specialises the comparison to a chosen
big Zariski site and a chosen big étale site of `S`.

The comparison has two uses. In one direction it says that the sheaf condition for the
generated topology need only be checked on the covering families themselves. In the other it
says that a presheaf obtained by restricting an fpqc sheaf on the schemes over `S` is a sheaf
for the fpqc topology of the site; this is how one produces fpqc sheaves on a chosen big site
out of constructions that make sense for every scheme over `S`.

## Main results

* `AlgebraicGeometry.isSheaf_fpqcComap_iff` — the sheaf condition for the fpqc topology of a
  site over `S` is the sheaf condition for its fpqc covering families.
* `AlgebraicGeometry.isSheaf_fpqcComap_of_isSheaf_fpqcOver` — restriction of an fpqc sheaf on
  the schemes over `S` is a sheaf for the fpqc topology of the site.
* `AlgebraicGeometry.isSheaf_fpqc_bigZariskiOver_of_isSheaf_fpqcOver` and
  `AlgebraicGeometry.isSheaf_fpqc_bigEtaleOver_of_isSheaf_fpqcOver` — the same statement for a
  chosen big Zariski and a chosen big étale site of `S`.

## Implementation notes

The fpqc topology of a category `C` over `S` is the Grothendieck topology generated by
`Scheme.fpqcPrecoverage.comap G`, where `G : C ⥤ Scheme` is the canonical functor; this is the
form in which the condition is stated throughout the library. Writing `G` as `F ⋙ Over.forget S`
for the canonical functor `F : C ⥤ Over S` turns that precoverage into an iterated comap, and
Mathlib's `CategoryTheory.over_toGrothendieck_eq_toGrothendieck_comap_forget` identifies the fpqc
topology induced on the schemes over `S` with the topology generated by the inner comap. The
comparison is then the tautological `Precoverage.comap_comp`, and continuity of `F` follows from
`CategoryTheory.Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy` with `le_rfl`.

Only two hypotheses on `C` are needed: it has fibre products, and `F` preserves them. For the
chosen big Zariski and big étale sites over `S` the relevant functor is `Over.post` of the site's
inclusion into schemes, which preserves fibre products because the inclusion does.

## References

* [Stacks Project, Tag 03O4](https://stacks.math.columbia.edu/tag/03O4)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe v₁ v₂ u₁ u₂ u

namespace AlgebraicGeometry

section General

variable {C : Type u₂} [Category.{v₂} C] [HasPullbacks C] {S : Scheme.{u}} (F : C ⥤ Over S)
  [PreservesLimitsOfShape WalkingCospan F]

omit [HasPullbacks C] [PreservesLimitsOfShape WalkingCospan F] in
/-- The fpqc precoverage of a category over `S`, pulled back along the canonical functor to
schemes, is the fpqc precoverage of the schemes over `S` pulled back along the canonical functor
to the schemes over `S`. -/
public lemma fpqcPrecoverage_comap_eq_comap_comap :
    Scheme.fpqcPrecoverage.comap (F ⋙ Over.forget S) =
      (Scheme.fpqcPrecoverage.comap (Over.forget S)).comap F :=
  Precoverage.comap_comp F (Over.forget S) Scheme.fpqcPrecoverage

/-- The canonical functor from a category over `S` to the schemes over `S` is continuous for the
fpqc topologies: the one generated by the fpqc covering families of the category, and the one
induced on the schemes over `S`. -/
public instance isContinuous_fpqcComap :
    F.IsContinuous (Scheme.fpqcPrecoverage.comap (F ⋙ Over.forget S)).toGrothendieck
      (Scheme.fpqcTopology.over S) := by
  rw [over_toGrothendieck_eq_toGrothendieck_comap_forget Scheme.fpqcPrecoverage S,
    fpqcPrecoverage_comap_eq_comap_comap F]
  exact Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy F _ _ le_rfl

/-- A presheaf on a category over `S` is a sheaf for the fpqc topology as soon as it satisfies
the sheaf condition for every fpqc covering family of the category. -/
public lemma isSheaf_fpqcComap_iff (P : Cᵒᵖ ⥤ Type v₁) :
    Presheaf.IsSheaf (Scheme.fpqcPrecoverage.comap (F ⋙ Over.forget S)).toGrothendieck P ↔
      ∀ ⦃X : C⦄ (R : Presieve X),
        R ∈ Scheme.fpqcPrecoverage.comap (F ⋙ Over.forget S) X →
        Presieve.IsSheafFor P R := by
  rw [isSheaf_iff_isSheaf_of_type,
    Precoverage.isSheaf_toGrothendieck_iff_of_isStableUnderBaseChange]

/-- Restriction along the canonical functor to the schemes over `S` carries a sheaf for the
induced fpqc topology to a sheaf for the fpqc topology of the category. -/
public lemma isSheaf_fpqcComap_of_isSheaf_fpqcOver {A : Type u₁} [Category.{v₁} A]
    (Φ : (Over S)ᵒᵖ ⥤ A) (hΦ : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) Φ) :
    Presheaf.IsSheaf (Scheme.fpqcPrecoverage.comap (F ⋙ Over.forget S)).toGrothendieck
      (F.op ⋙ Φ) :=
  F.op_comp_isSheaf_of_isSheaf _ _ Φ hΦ

end General

section BigZariski

variable (B : BigZariskiSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The canonical functor from a chosen big Zariski site of `S` to the schemes over `S` is the
inclusion of the site followed by the forgetful functor. -/
public lemma bigZariskiOver_toScheme_eq :
    BigZariskiOver.toScheme B S hS =
      Over.post (X := (⟨S, hS⟩ : B.Schemes)) B.inclusion ⋙ Over.forget S :=
  (Over.post_forget_eq_forget_comp B.inclusion (⟨S, hS⟩ : B.Schemes)).symm

/-- Postcomposition with the inclusion of a chosen big Zariski site, from the big Zariski
category over `S` to the schemes over `S`, preserves fibre products: the forgetful functor to
schemes does, and the forgetful functor of a slice reflects fibre products. -/
public instance preservesPullbacks_bigZariskiOverPost :
    PreservesLimitsOfShape WalkingCospan
      (Over.post (X := (⟨S, hS⟩ : B.Schemes)) B.inclusion) := by
  have : PreservesLimitsOfShape WalkingCospan
      (Over.post (X := (⟨S, hS⟩ : B.Schemes)) B.inclusion ⋙ Over.forget S) :=
    show PreservesLimitsOfShape WalkingCospan (BigZariskiOver.toScheme B S hS) from
      inferInstance
  exact preservesLimitsOfShape_of_reflects_of_preserves _ (Over.forget S)

/-- A presheaf on a chosen big Zariski site of `S` is a sheaf for the fpqc topology as soon as
it satisfies the sheaf condition for every fpqc covering family of the site. -/
public lemma isSheaf_fpqc_bigZariskiOver_iff (P : (BigZariskiOver B S hS)ᵒᵖ ⥤ Type v₁) :
    Presheaf.IsSheaf
        (Scheme.fpqcPrecoverage.comap (BigZariskiOver.toScheme B S hS)).toGrothendieck P ↔
      ∀ ⦃X : BigZariskiOver B S hS⦄ (R : Presieve X),
        R ∈ Scheme.fpqcPrecoverage.comap (BigZariskiOver.toScheme B S hS) X →
        Presieve.IsSheafFor P R := by
  rw [bigZariskiOver_toScheme_eq B S hS]
  exact isSheaf_fpqcComap_iff _ P

/-- Restriction of an fpqc sheaf on the schemes over `S` to a chosen big Zariski site of `S` is
a sheaf for the fpqc topology of that site. -/
public lemma isSheaf_fpqc_bigZariskiOver_of_isSheaf_fpqcOver {A : Type u₁} [Category.{v₁} A]
    (Φ : (Over S)ᵒᵖ ⥤ A) (hΦ : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) Φ) :
    Presheaf.IsSheaf
      (Scheme.fpqcPrecoverage.comap (BigZariskiOver.toScheme B S hS)).toGrothendieck
      ((Over.post (X := (⟨S, hS⟩ : B.Schemes)) B.inclusion).op ⋙ Φ) := by
  rw [bigZariskiOver_toScheme_eq B S hS]
  have := preservesPullbacks_bigZariskiOverPost B S hS
  exact isSheaf_fpqcComap_of_isSheaf_fpqcOver _ Φ hΦ

end BigZariski

section BigEtale

variable (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The canonical functor from a chosen big étale site of `S` to the schemes over `S` is the
inclusion of the site followed by the forgetful functor. -/
public lemma bigEtaleOver_toScheme_eq :
    BigEtaleOver.toScheme B S hS =
      Over.post (X := B.obj S hS) B.inclusion ⋙ Over.forget S :=
  (Over.post_forget_eq_forget_comp B.inclusion (B.obj S hS)).symm

/-- Postcomposition with the inclusion of a chosen big étale site, from the big étale category
over `S` to the schemes over `S`, preserves fibre products: the forgetful functor to schemes
does, and the forgetful functor of a slice reflects fibre products. -/
public instance preservesPullbacks_bigEtaleOverPost :
    PreservesLimitsOfShape WalkingCospan (Over.post (X := B.obj S hS) B.inclusion) := by
  have : PreservesLimitsOfShape WalkingCospan
      (Over.post (X := B.obj S hS) B.inclusion ⋙ Over.forget S) :=
    show PreservesLimitsOfShape WalkingCospan (BigEtaleOver.toScheme B S hS) from
      inferInstance
  exact preservesLimitsOfShape_of_reflects_of_preserves _ (Over.forget S)

/-- A presheaf on a chosen big étale site of `S` is a sheaf for the fpqc topology as soon as it
satisfies the sheaf condition for every fpqc covering family of the site. -/
public lemma isSheaf_fpqc_bigEtaleOver_iff (P : (BigEtaleOver B S hS)ᵒᵖ ⥤ Type v₁) :
    Presheaf.IsSheaf
        (Scheme.fpqcPrecoverage.comap (BigEtaleOver.toScheme B S hS)).toGrothendieck P ↔
      ∀ ⦃X : BigEtaleOver B S hS⦄ (R : Presieve X),
        R ∈ Scheme.fpqcPrecoverage.comap (BigEtaleOver.toScheme B S hS) X →
        Presieve.IsSheafFor P R := by
  rw [bigEtaleOver_toScheme_eq B S hS]
  exact isSheaf_fpqcComap_iff _ P

/-- Restriction of an fpqc sheaf on the schemes over `S` to a chosen big étale site of `S` is a
sheaf for the fpqc topology of that site. -/
public lemma isSheaf_fpqc_bigEtaleOver_of_isSheaf_fpqcOver {A : Type u₁} [Category.{v₁} A]
    (Φ : (Over S)ᵒᵖ ⥤ A) (hΦ : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) Φ) :
    Presheaf.IsSheaf
      (Scheme.fpqcPrecoverage.comap (BigEtaleOver.toScheme B S hS)).toGrothendieck
      ((Over.post (X := B.obj S hS) B.inclusion).op ⋙ Φ) := by
  rw [bigEtaleOver_toScheme_eq B S hS]
  have := preservesPullbacks_bigEtaleOverPost B S hS
  exact isSheaf_fpqcComap_of_isSheaf_fpqcOver _ Φ hΦ

end BigEtale

end AlgebraicGeometry
