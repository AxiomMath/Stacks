module

public import StacksFrontier.AlgebraicGeometry.Topologies.Fpqc.Comparison
public import StacksFrontier.AlgebraicGeometry.Topologies.ZariskiTopology.Limits

/-!
# Restriction of fpqc sheaves to the affine Zariski sites

An fpqc sheaf on the schemes over a base `S` restricts to a sheaf on a chosen big affine
Zariski site of `S`, and to a sheaf on a chosen small affine Zariski site of `S`. These are
the two cases of the comparison between the fpqc topology and the Zariski topologies which
are not already in
`StacksFrontier.AlgebraicGeometry.Topologies.Fpqc.Comparison`, and they are deduced from the two
that are: the covering families of an affine Zariski site are, by definition, covering
families of the ambient big or small Zariski site, so only the inclusion of the affine
subcategory has to be shown continuous.

## Main results

* `AlgebraicGeometry.isSheaf_bigAffineZariski_of_isSheaf_fpqc`: an fpqc sheaf on the schemes
  over `S` restricts to a sheaf on a chosen big affine Zariski site of `S`.
* `AlgebraicGeometry.isSheaf_smallAffineZariski_of_isSheaf_fpqc`: the same for a chosen small
  affine Zariski site of `S`.

## Implementation notes

The affine Zariski categories are full subcategories of the big and the small Zariski category
of `S`, and an affine covering family is a standard Zariski covering, whose first component is
a covering family of the ambient site. The image of a covering presieve of the affine site
therefore generates a covering sieve of the ambient site, which — the affine inclusions
preserving fibre products — makes those inclusions continuous. Restriction along a continuous
functor carries sheaves to sheaves, so the two statements follow from
`AlgebraicGeometry.isSheaf_bigZariski_of_isSheaf_fpqc` and
`AlgebraicGeometry.isSheaf_smallZariski_of_isSheaf_fpqc` by composing the inclusions, the
presheaf being restricted along the composite in exactly the same way.

Going through the ambient site rather than directly to the schemes over `S` is what makes the
topology-specific input a single line in each case: the standard affine coverings need not be
recognised in schemes at all, only in the site they are inherited from.

## References

* [Stacks Project, Tag 03O4](https://stacks.math.columbia.edu/tag/03O4)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u u' v v₁ v₂

namespace AlgebraicGeometry

/-- A pullback-preserving functor is continuous for the topology generated by a precoverage as
soon as every covering presieve is presented by a hypercover whose image generates a covering
sieve. -/
private theorem isContinuous_toGrothendieck_of_map_presieve₀_mem
    {C : Type u} [Category.{v₁} C] {D : Type u'} [Category.{v₂} D]
    [HasPullbacks C] [HasPullbacks D] (J : Precoverage C) (K : GrothendieckTopology D)
    (G : C ⥤ D) [PreservesLimitsOfShape WalkingCospan G]
    (hJ : ∀ {X : C} {R : Presieve X}, R ∈ J X → ∃ E : PreZeroHypercover.{v} X,
      R = E.presieve₀ ∧ (E.map G).presieve₀ ∈ K.toPrecoverage (G.obj X)) :
    G.IsContinuous J.toGrothendieck K := by
  have := Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy G
    (K.toPrecoverage.comap G) K.toPrecoverage le_rfl
  refine ⟨fun P ↦ (isSheaf_iff_isSheaf_of_type _ _).mp (Presheaf.IsSheaf.of_le
    (Precoverage.toGrothendieck_mono fun X R hR ↦ ?_)
    (G.op_comp_isSheaf_of_isSheaf (K.toPrecoverage.comap G).toGrothendieck
      K.toPrecoverage.toGrothendieck P.obj
      (P.property.of_le (GrothendieckTopology.toGrothendieck_toPrecoverage_le K))))⟩
  obtain ⟨E, rfl, hE⟩ := hJ hR
  rwa [Precoverage.mem_comap_iff, ← PreZeroHypercover.presieve₀_map]

variable (B : BigZariskiSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The inclusion of a chosen big affine Zariski site of `S` into the big Zariski site of `S`
is continuous: a standard affine covering is in particular a covering of the ambient site. -/
private theorem bigAffineZariski_isContinuous :
    (BigAffineZariski.inclusion B S hS).IsContinuous
      (BigAffineZariski.topology B S hS) (BigZariskiOver.topology B S hS) := by
  refine isContinuous_toGrothendieck_of_map_presieve₀_mem _ _ _ fun hR ↦
    let ⟨E, h, hE⟩ := (BigAffineZariski.mem_precoverage_iff B S hS).mp hR
    ⟨E, h, Precoverage.generate_mem_toGrothendieck ⟨E.map _, rfl, hE.1⟩⟩

/-- **Stacks Project, Tag 03O4.** Restriction of an fpqc sheaf on the schemes over `S` to a
chosen big affine Zariski site of `S` is a sheaf. -/
@[stacks 03O4 "chosen big affine Zariski sheaves"]
public theorem isSheaf_bigAffineZariski_of_isSheaf_fpqc
    (F : (Over S)ᵒᵖ ⥤ Type v)
    (hF : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) F) :
    Presheaf.IsSheaf (BigAffineZariski.topology B S hS)
      ((BigAffineZariski.inclusion B S hS ⋙
        Over.post (X := (⟨S, hS⟩ : B.Schemes)) B.inclusion).op ⋙ F) :=
  have := bigAffineZariski_isContinuous B S hS
  (BigAffineZariski.inclusion B S hS).op_comp_isSheaf_of_isSheaf
    (BigAffineZariski.topology B S hS) (BigZariskiOver.topology B S hS) _
    (isSheaf_bigZariski_of_isSheaf_fpqc B S hS F hF)

/-- The inclusion of a chosen small affine Zariski site of `S` into the small Zariski site of
`S` is continuous: a standard affine covering is in particular a covering of the ambient
site. -/
private theorem smallAffineZariski_isContinuous :
    (SmallAffineZariski.inclusion B S hS).IsContinuous
      (SmallAffineZariski.topology B S hS) (SmallZariski.topology B S hS) := by
  refine isContinuous_toGrothendieck_of_map_presieve₀_mem _ _ _ fun hR ↦
    let ⟨E, h, hE⟩ := (SmallAffineZariski.mem_precoverage_iff B S hS).mp hR
    ⟨E, h, Precoverage.generate_mem_toGrothendieck ⟨E.map _, rfl, hE.1⟩⟩

/-- **Stacks Project, Tag 03O4.** Restriction of an fpqc sheaf on the schemes over `S` to a
chosen small affine Zariski site of `S` is a sheaf. -/
@[stacks 03O4 "chosen small affine Zariski sheaves"]
public theorem isSheaf_smallAffineZariski_of_isSheaf_fpqc
    (F : (Over S)ᵒᵖ ⥤ Type v)
    (hF : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) F) :
    Presheaf.IsSheaf (SmallAffineZariski.topology B S hS)
      ((SmallAffineZariski.inclusion B S hS ⋙ SmallZariski.inclusion B S hS ⋙
        Over.post (X := (⟨S, hS⟩ : B.Schemes)) B.inclusion).op ⋙ F) :=
  have := smallAffineZariski_isContinuous B S hS
  (SmallAffineZariski.inclusion B S hS).op_comp_isSheaf_of_isSheaf
    (SmallAffineZariski.topology B S hS) (SmallZariski.topology B S hS) _
    (isSheaf_smallZariski_of_isSheaf_fpqc B S hS F hF)

end AlgebraicGeometry
