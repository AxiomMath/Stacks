/-- The inclusion of the cutoff category of a big smooth site into schemes is continuous for
the fpqc topology. -/
private theorem bigSmoothSite_inclusion_isContinuous
    (B : BigSmoothSite.{u}) :
    (ObjectProperty.ι (fun X : Scheme.{u} => X.size < B.cutoff)).IsContinuous
      B.grothendieckTopology Scheme.fpqcTopology := by
  let I : B.category ⥤ Scheme.{u} := ObjectProperty.ι _
  apply isContinuous_of_precoverage_le B.precoverage Scheme.fpqcTopology I
  intro X R hR
  obtain ⟨E, hCover, rfl⟩ := hR
  have hs := hCover.1
  change SmoothCovering B.cutoff ⟨X, E⟩ at hs
  have hSmooth : (E.map I).presieve₀ ∈
      Scheme.precoverage (@Smooth : MorphismProperty Scheme.{u})
        (I.obj X) := by
    simpa [SmoothCovering, SchemeBelow, I,
      PreZeroHypercover.map] using hs
  have hfpqc := Scheme.smoothPrecoverage_le_fpqcPrecoverage _ hSmooth
  exact mem_comap_fpqcTopology_of_mem I E hfpqc

