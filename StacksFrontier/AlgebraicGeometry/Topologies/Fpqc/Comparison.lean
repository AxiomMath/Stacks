/-- The inclusion of a big fppf site into schemes is continuous for the fpqc topology. -/
@[sga "3 IV 6.3" "partial"]
private theorem bigFppfSite_inclusion_isContinuous (B : BigFppfSite.{u}) :
    B.inclusion.IsContinuous B.topology Scheme.fpqcTopology := by
  apply isContinuous_of_precoverage_le B.precoverage Scheme.fpqcTopology B.inclusion
  intro X R hR
  obtain ⟨E, rfl, hCover⟩ := hR
  have hfppf := B.isFppfCovering_of_isCovering hCover
  dsimp [IsFppfCovering] at hfppf
  rw [Precoverage.mem_comap_iff] at hfppf
  have hfpqc := Scheme.fppfPrecoverage_le_fpqcPrecoverage _ hfppf
  rw [← PreZeroHypercover.presieve₀_map] at hfpqc
  exact mem_comap_fpqcTopology_of_mem B.inclusion E hfpqc

/-- The inclusion of a chosen big fppf site over `S` into the schemes over `S` is continuous
for the induced fpqc topology. -/
@[sga "3 IV 6.3" "partial"]
private theorem bigFppfOver_isContinuous (B : BigFppfSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) :
    (Over.post (X := B.obj hS) B.inclusion).IsContinuous
      (BigFppfOver.topology B S hS) (Scheme.fpqcTopology.over S) := by
  let : B.inclusion.IsContinuous B.topology Scheme.fpqcTopology :=
    bigFppfSite_inclusion_isContinuous B
  simpa [BigFppfOver.topology, BigFppfSite.obj,
    schemeBelowInclusion] using
    (Functor.isContinuous_overPost_of_preservesPullbacks B.topology
      Scheme.fpqcTopology B.inclusion (B.obj hS))

/-- The inclusion of a chosen big affine fppf site into the schemes over `S` is continuous for
the induced fpqc topology. -/
private theorem bigAffineFppf_isContinuous (B : BigFppfSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) :
    (BigAffineFppf.inclusion B S hS ⋙
      Over.post (X := B.obj hS) B.inclusion).IsContinuous
      (BigAffineFppf.topology B S hS) (Scheme.fpqcTopology.over S) := by
  let P := BigAffineFppf.precoverage B S hS
  let I := BigAffineFppf.inclusion B S hS
  let F := I ⋙ Over.post (X := B.obj hS) B.inclusion
  let G := BigAffineFppf.toScheme B S hS
  let Cover : {X : BigAffineFppf B S hS} →
      PreZeroHypercover.{u + 1} X → Prop := fun E =>
        BigAffineFppf.IsCovering B S hS ⟨_, E⟩
  have hFG : F ⋙ Over.forget S = G :=
    comp_overPost_forget B.inclusion (B.obj hS) I
  apply over_isContinuous_of_precoverage P F G hFG Cover
  · intro X R hR
    exact (BigAffineFppf.mem_precoverage_iff B S hS).mp hR
  · intro X E hE
    have hBig : BigFppfOver.IsCovering B S hS
        ⟨I.obj X, E.map I⟩ := hE.1
    have hB : B.IsCovering
        ⟨(BigFppfOver.forget B S hS).obj (I.obj X),
          (E.map I).map (BigFppfOver.forget B S hS)⟩ := hBig
    have hfppf := B.isFppfCovering_of_isCovering hB
    dsimp [IsFppfCovering] at hfppf
    rw [Precoverage.mem_comap_iff] at hfppf
    have hfpqc := Scheme.fppfPrecoverage_le_fpqcPrecoverage _ hfppf
    simpa [G, I, BigAffineFppf.toScheme, BigAffineFppf.inclusion,
      BigFppfOver.toScheme, BigFppfOver.forget, BigFppfSite.inclusion,
      schemeBelowInclusion, PreZeroHypercover.map] using hfpqc

/-- The inclusion of a chosen big affine smooth site into the schemes over `S` is continuous
for the induced fpqc topology. -/
private theorem bigAffineSmooth_isContinuous (B : BigSmoothSite.{u})
    (S : Scheme.{u}) (hS : S.size < B.cutoff) :
    (BigAffineSmooth.inclusion B S hS ⋙
      Over.post (X := (⟨S, hS⟩ : B.category)) (ObjectProperty.ι _)).IsContinuous
      (BigAffineSmooth.topology B S hS) (Scheme.fpqcTopology.over S) := by
  let P := BigAffineSmooth.precoverage B S hS
  let I := BigAffineSmooth.inclusion B S hS
  let F := I ⋙ Over.post (X := (⟨S, hS⟩ : B.category)) (ObjectProperty.ι _)
  let G := BigAffineSmooth.toScheme B S hS
  let Cover : {X : BigAffineSmooth B S hS} →
      PreZeroHypercover.{u + 1} X → Prop := fun E =>
        BigAffineSmooth.IsCovering B S hS ⟨_, E⟩
  have hFG : F ⋙ Over.forget S = G :=
    comp_overPost_forget (ObjectProperty.ι (fun X : Scheme.{u} => X.size < B.cutoff))
      (⟨S, hS⟩ : B.category) I
  let : HasPullbacks B.category := inferInstance
  let : PreservesLimitsOfShape WalkingCospan
      (ObjectProperty.ι (fun X : Scheme.{u} => X.size < B.cutoff)) := inferInstance
  let : PreservesLimitsOfShape WalkingCospan
      (BigSmoothOver.toScheme B S hS) := inferInstance
  let : CreatesLimitsOfShape WalkingCospan (BigAffineSmooth.inclusion B S hS) := by
    change CreatesLimitsOfShape WalkingCospan
      (ObjectProperty.ι (fun X : BigSmoothOver B S hS =>
        IsAffine ((BigSmoothOver.toScheme B S hS).obj X)))
    exact affineCreatesPullbacks (C := BigSmoothOver B S hS)
      (BigSmoothOver.toScheme B S hS)
  let : HasPullbacks (BigSmoothOver B S hS) := inferInstance
  let : HasPullbacks (BigAffineSmooth B S hS) :=
    hasLimitsOfShape_of_hasLimitsOfShape_createsLimitsOfShape
      (BigAffineSmooth.inclusion B S hS)
  apply over_isContinuous_of_precoverage P F G hFG Cover
  · intro X R hR
    exact hR
  · intro X E hE
    have hBig : BigSmoothOver.IsCovering B S hS
        ⟨I.obj X, E.map I⟩ := hE.1
    have hB : B.IsCovering
        ⟨(BigSmoothOver.forget B S hS).obj (I.obj X),
          (E.map I).map (BigSmoothOver.forget B S hS)⟩ := hBig
    have hs := hB.1
    change SmoothCovering B.cutoff
      ⟨(BigSmoothOver.forget B S hS).obj (I.obj X),
        (E.map I).map (BigSmoothOver.forget B S hS)⟩ at hs
    have hSmooth : (E.map G).presieve₀ ∈
        Scheme.precoverage (@Smooth : MorphismProperty Scheme.{u}) (G.obj X) := by
      simpa [SmoothCovering, G, I, BigAffineSmooth.toScheme,
        BigAffineSmooth.inclusion, BigSmoothOver.toScheme,
        BigSmoothOver.forget, SchemeBelow,
        PreZeroHypercover.map] using hs
    exact Scheme.smoothPrecoverage_le_fpqcPrecoverage _ hSmooth

