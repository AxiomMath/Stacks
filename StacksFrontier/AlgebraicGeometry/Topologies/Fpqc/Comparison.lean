/-- The inclusion of a chosen big étale site into the schemes over `S` is continuous for the
induced fpqc topology. -/
private theorem bigEtaleOver_isContinuous (B : BigEtaleSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) :
    (Over.post (X := B.obj S hS) B.inclusion).IsContinuous
      (BigEtaleOver.topology B S hS) (Scheme.fpqcTopology.over S) := by
  let P := BigEtaleOver.precoverage B S hS
  let F := Over.post (X := B.obj S hS) B.inclusion
  let G := BigEtaleOver.toScheme B S hS
  let Cover : {X : BigEtaleOver B S hS} →
      PreZeroHypercover.{u + 1} X → Prop := fun E =>
        BigEtaleOver.IsCovering B S hS ⟨_, E⟩
  have hFG : F ⋙ Over.forget S = G := by
    dsimp [F, G, BigEtaleOver.toScheme, BigEtaleOver.forget]
    exact Over.post_forget_eq_forget_comp B.inclusion (B.obj S hS)
  apply over_isContinuous_of_precoverage P F G hFG Cover
  · intro X R hR
    exact (BigEtaleOver.mem_precoverage_iff B S hS).mp hR
  · intro X E hE
    have hB : B.IsCovering
        ⟨(BigEtaleOver.forget B S hS).obj X,
          E.map (BigEtaleOver.forget B S hS)⟩ := hE
    have hEtale' := BigEtaleSite.IsCovering.etale hB
    dsimp [IsEtaleCovering] at hEtale'
    change (E.map (Over.forget (B.obj S hS) ⋙ B.inclusion)).presieve₀ ∈
      Scheme.etalePrecoverage (G.obj X) at hEtale'
    have hEtale : (E.map G).presieve₀ ∈ Scheme.etalePrecoverage (G.obj X) := by
      simpa [G, BigEtaleOver.toScheme, BigEtaleOver.forget] using hEtale'
    exact Scheme.etalePrecoverage_le_fpqcPrecoverage _ hEtale

/-- Restriction of an fpqc sheaf to a chosen big étale site of `S` is a sheaf. -/
@[stacks 03O4 "chosen big étale sheaves"]
public theorem isSheaf_chosenBigEtale_of_isSheaf_fpqc
    (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (Over S)ᵒᵖ ⥤ Type v)
    (hF : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) F) :
    Presheaf.IsSheaf (BigEtaleOver.topology B S hS)
      ((Over.post (X := B.obj S hS) B.inclusion).op ⋙ F) :=
  isSheaf_restrict _ _ _ F (bigEtaleOver_isContinuous B S hS) hF

/-- The inclusion of a chosen big Zariski site into the schemes over `S` is continuous for the
induced fpqc topology. -/
private theorem bigZariskiOver_isContinuous (B : BigZariskiSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) :
    (Over.post (X := (⟨S, hS⟩ : B.Schemes)) B.inclusion).IsContinuous
      (BigZariskiOver.topology B S hS) (Scheme.fpqcTopology.over S) := by
  let P := BigZariskiOver.precoverage B S hS
  let F := Over.post (X := (⟨S, hS⟩ : B.Schemes)) B.inclusion
  let G := BigZariskiOver.toScheme B S hS
  let Cover : {X : BigZariskiOver B S hS} →
      PreZeroHypercover.{u + 1} X → Prop := fun E =>
        BigZariskiOver.IsCovering B S hS ⟨_, E⟩
  have hFG : F ⋙ Over.forget S = G := by
    dsimp [F, G, BigZariskiOver.toScheme, BigZariskiOver.inclusion]
    exact Over.post_forget_eq_forget_comp B.inclusion (⟨S, hS⟩ : B.Schemes)
  apply over_isContinuous_of_precoverage P F G hFG Cover
  · intro X R hR
    exact (BigZariskiOver.mem_precoverage_iff B S hS).mp hR
  · intro X E hE
    have hZariski : (E.map G).presieve₀ ∈ Scheme.zariskiPretopology (G.obj X) := hE.1
    exact Scheme.zariskiPrecoverage_le_fpqcPrecoverage _ hZariski

/-- Restriction of an fpqc sheaf to a chosen big Zariski site of `S` is a sheaf. -/
@[stacks 03O4 "chosen big Zariski sheaves"]
public theorem isSheaf_bigZariski_of_isSheaf_fpqc
    (B : BigZariskiSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (Over S)ᵒᵖ ⥤ Type v)
    (hF : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) F) :
    Presheaf.IsSheaf (BigZariskiOver.topology B S hS)
      ((Over.post (X := (⟨S, hS⟩ : B.Schemes)) B.inclusion).op ⋙ F) :=
  isSheaf_restrict _ _ _ F (bigZariskiOver_isContinuous B S hS) hF

/-- The inclusion of a chosen small Zariski site into the schemes over `S` is continuous for
the induced fpqc topology. -/
private theorem smallZariski_isContinuous (B : BigZariskiSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) :
    (SmallZariski.inclusion B S hS ⋙
      Over.post (X := (⟨S, hS⟩ : B.Schemes)) B.inclusion).IsContinuous
      (SmallZariski.topology B S hS) (Scheme.fpqcTopology.over S) := by
  let P := SmallZariski.precoverage B S hS
  let I := SmallZariski.inclusion B S hS
  let F := I ⋙ Over.post (X := (⟨S, hS⟩ : B.Schemes)) B.inclusion
  let G := SmallZariski.toScheme B S hS
  let Cover : {X : SmallZariski B S hS} →
      PreZeroHypercover.{u + 1} X → Prop := fun E =>
        SmallZariski.IsCovering B S hS ⟨_, E⟩
  have hFG : F ⋙ Over.forget S = G :=
    comp_overPost_forget B.inclusion (⟨S, hS⟩ : B.Schemes) I
  apply over_isContinuous_of_precoverage P F G hFG Cover
  · intro X R hR
    exact (SmallZariski.mem_precoverage_iff B S hS).mp hR
  · intro X E hE
    have hBig : BigZariskiOver.IsCovering B S hS
        ⟨(SmallZariski.inclusion B S hS).obj X,
          E.map (SmallZariski.inclusion B S hS)⟩ := hE
    have hZariski : (E.map G).presieve₀ ∈ Scheme.zariskiPretopology (G.obj X) := hBig.1
    exact Scheme.zariskiPrecoverage_le_fpqcPrecoverage _ hZariski

/-- Restriction of an fpqc sheaf to a chosen small Zariski site of `S` is a sheaf. -/
@[stacks 03O4 "chosen small Zariski sheaves"]
public theorem isSheaf_smallZariski_of_isSheaf_fpqc
    (B : BigZariskiSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
    (F : (Over S)ᵒᵖ ⥤ Type v)
    (hF : Presheaf.IsSheaf (Scheme.fpqcTopology.over S) F) :
    Presheaf.IsSheaf (SmallZariski.topology B S hS)
      ((SmallZariski.inclusion B S hS ⋙
        Over.post (X := (⟨S, hS⟩ : B.Schemes)) B.inclusion).op ⋙ F) :=
  isSheaf_restrict _ _ _ F (smallZariski_isContinuous B S hS) hF

/-- The inclusion of a chosen big affine étale site into the schemes over `S` is continuous
for the induced fpqc topology. -/
private theorem bigAffineEtale_isContinuous (B : BigEtaleSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) :
    (BigAffineEtale.inclusion B S hS ⋙
      Over.post (X := B.obj S hS) B.inclusion).IsContinuous
      (BigAffineEtale.topology B S hS) (Scheme.fpqcTopology.over S) := by
  let P := BigAffineEtale.precoverage B S hS
  let I := BigAffineEtale.inclusion B S hS
  let F := I ⋙ Over.post (X := B.obj S hS) B.inclusion
  let G := BigAffineEtale.toScheme B S hS
  let Cover : {X : BigAffineEtale B S hS} →
      PreZeroHypercover.{u + 1} X → Prop := fun E =>
        BigAffineEtale.IsCovering B S hS ⟨_, E⟩
  have hFG : F ⋙ Over.forget S = G :=
    comp_overPost_forget B.inclusion (B.obj S hS) I
  apply over_isContinuous_of_precoverage P F G hFG Cover
  · intro X R hR
    exact (BigAffineEtale.mem_precoverage_iff B S hS).mp hR
  · intro X E hE
    change BigAffineEtale.IsCovering B S hS ⟨X, E⟩ at hE
    have hBig : BigEtaleOver.IsCovering B S hS
        ⟨I.obj X, E.map I⟩ := hE.1
    have hB : B.IsCovering
        ⟨(BigEtaleOver.forget B S hS).obj (I.obj X),
          (E.map I).map (BigEtaleOver.forget B S hS)⟩ := hBig
    have hEtale' := BigEtaleSite.IsCovering.etale hB
    dsimp [IsEtaleCovering] at hEtale'
    have hEtale : (E.map G).presieve₀ ∈ Scheme.etalePrecoverage (G.obj X) := by
      simpa [G, I, BigAffineEtale.toScheme, BigAffineEtale.inclusion,
        BigEtaleOver.toScheme, BigEtaleOver.forget,
        BigEtaleSite.inclusion, PreZeroHypercover.map] using hEtale'
    exact Scheme.etalePrecoverage_le_fpqcPrecoverage _ hEtale

/-- The inclusion of a chosen small affine étale site into the schemes over `S` is continuous
for the induced fpqc topology. -/
private theorem smallAffineEtale_isContinuous (B : BigEtaleSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) :
    (SmallAffineEtale.inclusion B S hS ⋙ SmallEtale.inclusion B S hS ⋙
      Over.post (X := B.obj S hS) B.inclusion).IsContinuous
      (SmallAffineEtale.topology B S hS) (Scheme.fpqcTopology.over S) := by
  let P := SmallAffineEtale.precoverage B S hS
  let I := SmallAffineEtale.inclusion B S hS ⋙ SmallEtale.inclusion B S hS
  let F := I ⋙ Over.post (X := B.obj S hS) B.inclusion
  let G := SmallAffineEtale.toScheme B S hS
  let Cover : {X : SmallAffineEtale B S hS} →
      PreZeroHypercover.{u + 1} X → Prop := fun E =>
        SmallAffineEtale.IsCovering B S hS ⟨_, E⟩
  have hFG : F ⋙ Over.forget S = G :=
    comp_overPost_forget B.inclusion (B.obj S hS) I
  apply over_isContinuous_of_precoverage P F G hFG Cover
  · intro X R hR
    exact (SmallAffineEtale.mem_precoverage_iff B S hS).mp hR
  · intro X E hE
    have hSmall : SmallEtale.IsCovering B S hS
        ⟨(SmallAffineEtale.inclusion B S hS).obj X,
          E.map (SmallAffineEtale.inclusion B S hS)⟩ := hE.1
    have hBig : BigEtaleOver.IsCovering B S hS
        ⟨(SmallEtale.inclusion B S hS).obj
            ((SmallAffineEtale.inclusion B S hS).obj X),
          (E.map (SmallAffineEtale.inclusion B S hS)).map
            (SmallEtale.inclusion B S hS)⟩ := hSmall
    have hB : B.IsCovering
        ⟨(BigEtaleOver.forget B S hS).obj
            ((SmallEtale.inclusion B S hS).obj
              ((SmallAffineEtale.inclusion B S hS).obj X)),
          ((E.map (SmallAffineEtale.inclusion B S hS)).map
            (SmallEtale.inclusion B S hS)).map
            (BigEtaleOver.forget B S hS)⟩ := hBig
    have hEtale' := BigEtaleSite.IsCovering.etale hB
    dsimp [IsEtaleCovering] at hEtale'
    have hEtale : (E.map G).presieve₀ ∈ Scheme.etalePrecoverage (G.obj X) := by
      simpa [G, SmallAffineEtale.toScheme, SmallAffineEtale.inclusion,
        SmallEtale.inclusion, SmallEtale.toScheme,
        BigEtaleOver.toScheme, BigEtaleOver.forget,
        BigEtaleSite.inclusion, PreZeroHypercover.map] using hEtale'
    exact Scheme.etalePrecoverage_le_fpqcPrecoverage _ hEtale

