namespace AlgebraicGeometry

/-- A fully faithful functor preserving pullbacks creates them. -/
private noncomputable instance createsPullbacks_of_fullyFaithful
    {C : Type u} [CategoryTheory.Category.{v₁, u} C]
    {D : Type u'} [CategoryTheory.Category.{v₂, u'} D]
    (F : C ⥤ D) [F.Full] [F.Faithful] [HasPullbacks C]
    [PreservesLimitsOfShape CategoryTheory.Limits.WalkingCospan F] :
    CreatesLimitsOfShape CategoryTheory.Limits.WalkingCospan F where
  CreatesLimit := fun {_K} => createsLimitOfFullyFaithfulOfPreserves

/-- Post-composing with `Over.post G` and forgetting equals forgetting and composing with `G`. -/
private lemma comp_overPost_forget {C D E : Type*} [Category C] [Category D] [Category E]
    (G : C ⥤ D) (X : C) (I : E ⥤ Over X) :
    (I ⋙ Over.post (X := X) G) ⋙ Over.forget (G.obj X) = (I ⋙ Over.forget X) ⋙ G :=
  congrArg (I ⋙ ·) (Over.post_forget_eq_forget_comp G X)

/-- A fully faithful functor to `Over S` whose composite with the forgetful functor preserves
pullbacks creates them. -/
@[instance_reducible]
private noncomputable def createsPullbacks_of_comp_overForget {C : Type*} [Category C]
    [HasPullbacks C]
    {S : Scheme.{u}} (F : C ⥤ Over S) [F.Full] [F.Faithful]
    (_ : PreservesLimitsOfShape WalkingCospan (F ⋙ Over.forget S)) :
    CreatesLimitsOfShape WalkingCospan F := by
  have := preservesLimitsOfShape_of_reflects_of_preserves (J := WalkingCospan) F (Over.forget S)
  exact createsPullbacks_of_fullyFaithful F

/-- Restriction along a continuous functor carries sheaves to sheaves. -/
private lemma isSheaf_restrict {C : Type u} [Category C] {D : Type u'} [Category D]
    (G : C ⥤ D) (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    (P : Dᵒᵖ ⥤ Type v) (hG : G.IsContinuous J K) (hP : Presheaf.IsSheaf K P) :
    Presheaf.IsSheaf J (G.op ⋙ P) := by
  have := hG
  exact G.op_comp_isSheaf_of_isSheaf J K P hP

/-- If every covering family of `J` maps to a covering sieve of `K`, restriction along a
pullback-creating functor carries `K`-sheaves to `J.toGrothendieck`-sheaves. -/
private lemma isSheaf_of_precoverage_le {C : Type u} [CategoryTheory.Category C]
    {D : Type u'} [CategoryTheory.Category D] [HasPullbacks D]
    (J : Precoverage C) (K : GrothendieckTopology D) (F : C ⥤ D)
    [CreatesLimitsOfShape CategoryTheory.Limits.WalkingCospan F]
    (P : Dᵒᵖ ⥤ Type v) (hP : Presheaf.IsSheaf K P)
    (hJ : J ≤ K.toPrecoverage.comap F) :
    Presheaf.IsSheaf J.toGrothendieck (F.op ⋙ P) := by
  let Q := K.toPrecoverage.comap F
  let : Q.IsStableUnderBaseChange := by dsimp [Q]; infer_instance
  let : Q.HasPullbacks := by dsimp [Q]; infer_instance
  let : Q.PullbacksPreservedBy F := by dsimp [Q]; infer_instance
  let : F.IsContinuous Q.toGrothendieck K.toPrecoverage.toGrothendieck :=
    Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy F Q K.toPrecoverage le_rfl
  exact (F.op_comp_isSheaf_of_isSheaf Q.toGrothendieck K.toPrecoverage.toGrothendieck P
    (hP.of_le (GrothendieckTopology.toGrothendieck_toPrecoverage_le K))).of_le
    (Precoverage.toGrothendieck_mono hJ)

/-- A pullback-creating functor sending the covering families of `J` into `K` is continuous. -/
private lemma isContinuous_of_precoverage_le {C : Type u} [CategoryTheory.Category C]
    {D : Type u'} [CategoryTheory.Category D] [HasPullbacks D]
    (J : Precoverage C) (K : GrothendieckTopology D) (F : C ⥤ D)
    [CreatesLimitsOfShape CategoryTheory.Limits.WalkingCospan F]
    (hJ : J ≤ K.toPrecoverage.comap F) :
    F.IsContinuous J.toGrothendieck K :=
  ⟨fun P => (isSheaf_iff_isSheaf_of_type _ _).mp
    (isSheaf_of_precoverage_le J K F P.obj P.property hJ)⟩

/-- A family over `S` whose image in schemes is an fpqc covering family generates a covering
sieve for the fpqc topology induced on the schemes over `S`. -/
private lemma over_mem_toPrecoverage_of_mapped_hypercover
    {C : Type w} [CategoryTheory.Category.{v, w} C] {S : Scheme.{u}}
    (F : C ⥤ Over S) (G : C ⥤ Scheme.{u})
    (hFG : F ⋙ Over.forget S = G) {X : C}
    (E : PreZeroHypercover.{u + 1} X)
    (hE : (E.map G).presieve₀ ∈ Scheme.fpqcPrecoverage (G.obj X)) :
    (E.presieve₀.map F) ∈
      (Scheme.fpqcTopology.over S).toPrecoverage (F.obj X) := by
  rw [GrothendieckTopology.mem_toPrecoverage_iff, GrothendieckTopology.mem_over_iff,
    Sieve.overEquiv_generate]
  change Sieve.generate (Presieve.functorPushforward (Over.forget S)
      (E.presieve₀.map F)) ∈ Scheme.fpqcTopology (F.obj X).left
  rw [← Sieve.arrows_generate_map_eq_functorPushforward]
  simp only [Sieve.generate_sieve]
  have hmem : Sieve.generate ((E.map G).presieve₀) ∈
      Scheme.fpqcTopology (G.obj X) :=
    Scheme.fpqcPrecoverage.generate_mem_toGrothendieck hE
  rw [Sieve.generate_map_eq_functorPushforward,
    Sieve.generate_map_eq_functorPushforward,
    ← Sieve.functorPushforward_comp]
  rwa [PreZeroHypercover.presieve₀_map, Sieve.generate_map_eq_functorPushforward, ← hFG] at hmem

/-- A fully faithful functor to the schemes over `S` whose forgetful composite preserves pullbacks
is continuous for the induced fpqc topology as soon as every covering family has fpqc image in
schemes. -/
private lemma over_isContinuous_of_precoverage
    {C : Type w} [CategoryTheory.Category.{v, w} C] [HasPullbacks C] {S : Scheme.{u}}
    (P : Precoverage C) (F : C ⥤ Over S) [F.Full] [F.Faithful] (G : C ⥤ Scheme.{u})
    [PreservesLimitsOfShape WalkingCospan G]
    (hFG : F ⋙ Over.forget S = G)
    (Cover : {X : C} → PreZeroHypercover.{u + 1} X → Prop)
    (hrepr : ∀ {X : C} {R : Presieve X}, R ∈ P X →
      ∃ E : PreZeroHypercover.{u + 1} X, R = E.presieve₀ ∧ Cover E)
    (hbase : ∀ {X : C} (E : PreZeroHypercover.{u + 1} X), Cover E →
      (E.map G).presieve₀ ∈ Scheme.fpqcPrecoverage (G.obj X)) :
    F.IsContinuous P.toGrothendieck (Scheme.fpqcTopology.over S) := by
  subst hFG
  have := createsPullbacks_of_comp_overForget F inferInstance
  apply isContinuous_of_precoverage_le P (Scheme.fpqcTopology.over S) F
  intro X R hR
  obtain ⟨E, rfl, hE⟩ := hrepr hR
  exact over_mem_toPrecoverage_of_mapped_hypercover F _ rfl E (hbase E hE)

/-- A functor to schemes sends a family to an fpqc covering family exactly when the family lies
in the pullback of the fpqc precoverage. -/
private lemma mem_comap_fpqcTopology_of_mem {C : Type w} [CategoryTheory.Category.{v, w} C]
    (I : C ⥤ Scheme.{u}) {X : C} (E : PreZeroHypercover.{u + 1} X)
    (h : (E.map I).presieve₀ ∈ Scheme.fpqcPrecoverage (I.obj X)) :
    E.presieve₀ ∈ (Scheme.fpqcTopology.toPrecoverage.comap I) X := by
  rw [Precoverage.mem_comap_iff, ← PreZeroHypercover.presieve₀_map,
    GrothendieckTopology.mem_toPrecoverage_iff]
  exact Scheme.fpqcPrecoverage.generate_mem_toGrothendieck h

/-- A size cutoff on schemes is stable under pullback. -/
private theorem schemeSizeCutoff_closedUnderPullbacks (κ : Cardinal.{u}) :
    ObjectProperty.IsClosedUnderLimitsOfShape
      (fun X : Scheme.{u} => X.size < κ) WalkingCospan := by
  apply ObjectProperty.IsClosedUnderLimitsOfShape.mk'
  rintro _ ⟨F, hF⟩
  rw [Scheme.size_congr (HasLimit.isoOfNatIso (diagramIsoCospan F))]
  exact Scheme.size_pullback_lt _ _ (hF .left) (hF .right)

