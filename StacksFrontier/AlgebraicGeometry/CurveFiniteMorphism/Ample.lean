module

public import StacksFrontier.AlgebraicGeometry.CurveFiniteMorphism.Basic
public import StacksFrontier.AlgebraicGeometry.NormInvertible.Ample
public import StacksFrontier.AlgebraicGeometry.AmplePredicateBridge.Basic

/-!
# Generating sections make an invertible module on a proper curve ample

Let `X` be a proper curve over a field `k` and `𝓛` an invertible `𝒪_X`-module generated by finitely
many global sections `s₀, …, sₙ`, one of which vanishes somewhere but not everywhere. Then `𝓛` is
ample.

## Main results

* `AlgebraicGeometry.isAmple_of_iSup_nonvanishingChart_eq_top`: the statement above, for the
  predicate `Stacks.Ample.IsAmple`.
* `AlgebraicGeometry.modulesIsAmple_of_iSup_nonvanishingChart_eq_top`: the same for the predicate
  `AlgebraicGeometry.Scheme.Modules.IsAmple`.

## References

* [Stacks Project, Tag 01PS](https://stacks.math.columbia.edu/tag/01PS)
* [Stacks Project, Tag 0A27](https://stacks.math.columbia.edu/tag/0A27)
-/


@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace
open Stacks.ProjectiveSpaceSections (nonvanishingChart)

universe u

namespace AlgebraicGeometry

/-- An invertible module on a proper curve generated by finitely many global sections, one of which
vanishes somewhere but not everywhere, is ample. -/
public theorem isAmple_of_iSup_nonvanishingChart_eq_top {k : Type u} [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (hf : IsProper f) (hc : IsCurve k f) (L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L] {n : ℕ} (sec : Fin (n + 1) → L.sections)
    (hcover : (⨆ i, nonvanishingChart L (sec i)) = ⊤)
    (i₀ : Fin (n + 1)) (hne : nonvanishingChart L (sec i₀) ≠ ⊤)
    (hnb : (nonvanishingChart L (sec i₀) : Set X).Nonempty) :
    Stacks.Ample.IsAmple X L := by
  have := hf
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  refine Stacks.Ample.isAmple_of_forall_exists_affine_nonvanishingLocus L fun x => ?_
  obtain ⟨j, hj⟩ : ∃ j, x ∈ nonvanishingChart L (sec j) :=
    TopologicalSpace.Opens.mem_iSup.1 (hcover ▸ (Set.mem_univ x : x ∈ (⊤ : X.Opens)))
  have hchart : Stacks.NonvanishingOpen.nonvanishingOpen X L ((sec j).eval (op ⊤)) =
      nonvanishingChart L (sec j) :=
    TopologicalSpace.Opens.ext
      (((Stacks.NonvanishingOpen.coe_nonvanishingOpen X L _).trans
        (Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval X L (sec j)).symm))
  refine ⟨(sec j).eval (op ⊤), ?_, ?_⟩
  · exact hchart.ge hj
  · rw [hchart]
    exact Stacks.ProjectiveSpaceSections.isAffineOpen_nonvanishingChart_of_isCurve L sec hcover
      hf hc i₀ hne hnb j

/-- An invertible module on a proper curve generated by finitely many global sections, one of which
vanishes somewhere but not everywhere, is ample in the sense of
`AlgebraicGeometry.Scheme.Modules.IsAmple`. -/
public theorem modulesIsAmple_of_iSup_nonvanishingChart_eq_top {k : Type u} [Field k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) (hf : IsProper f) (hc : IsCurve k f) (L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L] {n : ℕ} (sec : Fin (n + 1) → L.sections)
    (hcover : (⨆ i, nonvanishingChart L (sec i)) = ⊤)
    (i₀ : Fin (n + 1)) (hne : nonvanishingChart L (sec i₀) ≠ ⊤)
    (hnb : (nonvanishingChart L (sec i₀) : Set X).Nonempty) :
    Scheme.Modules.IsAmple X L :=
  Stacks.PowerFamilyBridge.modulesIsAmple_of_isAmple X L
    (isAmple_of_iSup_nonvanishingChart_eq_top f hf hc L sec hcover i₀ hne hnb)

end AlgebraicGeometry

end
