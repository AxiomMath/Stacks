/-!
# Topological generators of the chart ring over the base

In the proof of Stacks 0GI5, with `S = Spec R` affine and `W = Spf B` an affine formal chart,
"by Stacks 0GC6 we see that `B` is topologically of finite type over `R`. Say `B` is
topologically generated by `b_1, …, b_n`." This file provides that input in the form consumed
by `AlgebraicGeometry.Artin.StageLift.exists_stage_continuous_ringHom`: a ring map
`ρ : R → B` through which every quotient stage of `B` lies over `O = Spec R`, and a finite set
`s ⊆ B` such that the subring generated by `ρ(R)` and `s` is dense.

## Main results

* `AlgebraicGeometry.Artin.FormalDictionary.exists_ringHom_mk_comp_eq`: compatible ring maps
  into the quotients of a complete adic ring by its weak ideals of definition lift.
* `AlgebraicGeometry.Artin.FormalDictionary.exists_finset_dense_subring_closure`: a ring map
  `R → B` into a Noetherian weakly admissible ring with `R → B ⧸ 𝔟` of finite type has a finite
  set of topological generators over its image (Stacks 0GC6).
* `AlgebraicGeometry.Artin.FormalDictionary.locallyOfFiniteType_overS_nilIdx`: the reduction
  `Spec (B ⧸ 𝔟)` of an étale chart `Spf B ⟶ W` is locally of finite type over `S`.
* `AlgebraicGeometry.Artin.FormalDictionary.exists_ringHom_overS_eq`: a formal spectrum over an
  affine open `O = Spec R` of `S` is a topological ring over `R`.
* `AlgebraicGeometry.Artin.FormalDictionary.exists_ringHom_overS_dense_subring_closure`: the
  generators input of the proof of Stacks 0GI5.

## References

* [Stacks Project, Tag 0GI5](https://stacks.math.columbia.edu/tag/0GI5)
* [Stacks Project, Tag 0GC6](https://stacks.math.columbia.edu/tag/0GC6)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Artin.FormalDictionary

section Algebra

variable {R Bt : Type u} [CommRing R] [CommRing Bt] [TopologicalSpace Bt] [IsTopologicalRing Bt]

/-- **Compatible ring maps into the quotients by the weak ideals of definition lift** to a
complete adic ring: if `B` is `I₀`-adically complete for an ideal `I₀` defining its topology,
a family `g_J : R → B ⧸ J` compatible with the projections `B ⧸ J → B ⧸ L` for `J ≤ L` is
`R → B → B ⧸ J` for a ring map `R → B`. -/
theorem exists_ringHom_mk_comp_eq {I₀ : Ideal Bt} (hI₀ : IsAdic I₀) [IsAdicComplete I₀ Bt]
    (g : ∀ J : { J : Ideal Bt // TopologicalRing.IsWeakIdealOfDefinition J }, R →+* Bt ⧸ J.1)
    (hg : ∀ (J L : { J : Ideal Bt // TopologicalRing.IsWeakIdealOfDefinition J })
      (h : J.1 ≤ L.1), (Ideal.Quotient.factor h).comp (g J) = g L) :
    ∃ ρ : R →+* Bt, ∀ J, (Ideal.Quotient.mk J.1).comp ρ = g J := by
  classical
  let P : ℕ → { J : Ideal Bt // TopologicalRing.IsWeakIdealOfDefinition J } := fun n =>
    ⟨I₀ ^ (n + 1), TopologicalRing.isWeakIdealOfDefinition_pow_of_isAdic hI₀ n⟩
  let f : (n : ℕ) → R →+* Bt ⧸ I₀ ^ n := fun n =>
    (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.le_succ n))).comp (g (P n))
  have hf : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I₀ hle).comp (f n) = f m := by
    intro m n hle
    have hPP : (P n).1 ≤ (P m).1 := Ideal.pow_le_pow_right (by omega)
    simp only [f, ← RingHom.comp_assoc, ← hg (P n) (P m) hPP]
    congr 1
    exact Ideal.Quotient.ringHom_ext (RingHom.ext fun _ => rfl)
  refine ⟨IsAdicComplete.liftRingHom I₀ f hf, fun J => ?_⟩
  obtain ⟨n, -, hn⟩ := hI₀.hasBasis_nhds_zero.mem_iff.mp (J.2.1.mem_nhds J.1.zero_mem)
  have hJ : (P n).1 ≤ J.1 := (Ideal.pow_le_pow_right (Nat.le_succ n)).trans hn
  have hPn : (Ideal.Quotient.mk (P n).1).comp (IsAdicComplete.liftRingHom I₀ f hf) = g (P n) := by
    rw [← hg (P (n + 1)) (P n) (Ideal.pow_le_pow_right (by omega))]
    exact IsAdicComplete.mk_comp_liftRingHom I₀ f hf (n + 1)
  rw [← hg (P n) J hJ, ← hPn]
  rfl

end Algebra

section Generators

variable {R Bt : Type u} [CommRing R] [CommRing Bt] [TopologicalSpace Bt] [IsTopologicalRing Bt]
  [IsLinearTopology Bt Bt] [IsNoetherianRing Bt]

/-- **Stacks 0GC6 for a ring map out of a discrete ring.** Let `B` be a Noetherian weakly
admissible topological ring with ideal `𝔟` of topologically nilpotent elements, and `ρ : R → B` a
ring map such that `R → B ⧸ 𝔟` is of finite type. Then there is a finite set `s ⊆ B` such that the
subring generated by `ρ(R)` and `s` is dense: `B` is topologically of finite type over `R`. -/
theorem exists_finset_dense_subring_closure (hB : TopologicalRing.IsWeaklyAdmissible Bt)
    (ρ : R →+* Bt) (hρ : ((Ideal.Quotient.mk (topologicalNilradical Bt)).comp ρ).FiniteType) :
    ∃ s : Finset Bt, Dense (Subring.closure ((ρ.range : Set Bt) ∪ (s : Set Bt)) : Set Bt) := by
  classical
  let : TopologicalSpace R := ⊥
  have : DiscreteTopology R := ⟨rfl⟩
  have hρc : Continuous ρ := continuous_of_discreteTopology
  have hred : Rig.IsFiniteTypeOnReductions ρ hρc := by
    refine RingHom.FiniteType.of_comp_finiteType (f := Ideal.Quotient.mk _) ?_
    have heq : (Ideal.quotientMap (topologicalNilradical Bt) ρ (fun _ hx ↦
        IsTopologicallyNilpotent.mem_topologicalNilradical_iff.mpr
          ((IsTopologicallyNilpotent.mem_topologicalNilradical_iff.mp hx).map hρc))).comp
        (Ideal.Quotient.mk (topologicalNilradical R)) =
        (Ideal.Quotient.mk (topologicalNilradical Bt)).comp ρ :=
      RingHom.ext fun x => rfl
    exact heq ▸ hρ
  obtain ⟨n, e, he, hdense⟩ :=
    Rig.isTopologicallyOfFiniteType_of_isFiniteTypeOnReductions ρ hρc hB hred
  refine ⟨Finset.univ.image fun i => e (MvPolynomial.X i), hdense.mono ?_⟩
  rintro _ ⟨p, rfl⟩
  induction p using MvPolynomial.induction_on with
  | C a =>
    refine Subring.subset_closure (Or.inl ?_)
    rw [← he]
    exact ⟨a, rfl⟩
  | add p q hp hq => rw [map_add]; exact add_mem hp hq
  | mul_X p i hp =>
    rw [map_mul]
    refine mul_mem hp (Subring.subset_closure (Or.inr ?_))
    simp

end Generators


section Geometry

attribute [local instance] Space.pointTopology

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {Bt : Type u} [CommRing Bt] [TopologicalSpace Bt] [IsTopologicalRing Bt]
  [IsLinearTopology Bt Bt]

/-- An isomorphism of presheaves on the site is an étale chart of its target in the sense of the
relative property along the universe-lifted Yoneda embedding: every represented base change of it
is an isomorphism of the site. -/
theorem relative_etale_of_isIso {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type (u + 1)} (f : X ⟶ Y)
    [IsIso f] :
    (MorphismProperty.inverseImage
      (@AlgebraicGeometry.Etale.{u} : MorphismProperty Scheme.{u})
      (BigFppfOver.toScheme B S hS)).relative (uliftYoneda.{u + 1}) f := by
  refine ⟨Functor.relativelyRepresentable.of_isIso (uliftYoneda.{u + 1}) _, ?_⟩
  intro X Y g fst snd hpb
  have h1 : IsIso ((uliftYoneda.{u + 1}).map snd) := hpb.isIso_snd_of_isIso
  have h2 : IsIso snd :=
    Functor.FullyFaithful.isIso_of_isIso_map (ULiftYoneda.fullyFaithful _) snd
  change AlgebraicGeometry.Etale ((BigFppfOver.toScheme B S hS).map snd)
  infer_instance

variable (B S hS) in
/-- The presheaf represented by the terminal object `S` of the site is terminal. -/
instance isIso_terminalFrom_uliftYoneda_terminalObj :
    IsIso (terminal.from ((uliftYoneda.{u + 1}).obj (BigFppfOver.terminalObj B S hS))) := by
  have hsub : ∀ X : BigFppfOver B S hS, Subsingleton (X ⟶ BigFppfOver.terminalObj B S hS) :=
    fun X => ⟨fun a b => Over.mkIdTerminal.hom_ext a b⟩
  let inv : ⊤_ ((BigFppfOver B S hS)ᵒᵖ ⥤ Type (u + 1)) ⟶
      (uliftYoneda.{u + 1}).obj (BigFppfOver.terminalObj B S hS) :=
    { app := fun X => TypeCat.ofHom fun _ => ULift.up (Over.mkIdTerminal.from X.unop)
      naturality := fun X Y g => by
        ext x
        exact congrArg ULift.up ((hsub _).elim _ _) }
  refine ⟨inv, ?_, terminal.hom_ext _ _⟩
  ext X x
  exact congrArg ULift.up ((hsub _).elim _ _)

/-- **The reduction of a chart of `W` is locally of finite type over `S`.** Let `ω : W₀ ⟶ W` be
representable étale, with `W₀ ≅ Spf B` for a weakly admissible adic ring `B`, and let `𝔟 ⊆ B` be
the ideal of topologically nilpotent elements. Then `Spec (B ⧸ 𝔟) ⟶ S` is locally of finite type:
`Spec (B ⧸ 𝔟)` is the reduction of `Spf B` (Stacks 0GB6), the induced morphism to `W_red` is
étale, and `W_red` is locally of finite type over `S`. -/
theorem locallyOfFiniteType_overS_nilIdx (c : ContractionSituation B S hS)
    {W₀ : FormalSpace.FppfSheaf B S hS} (ω : W₀ ⟶ c.W)
    (hω : FormalSpace.IsRepresentableEtale B S hS ω)
    (hB : TopologicalRing.IsWeaklyAdmissible Bt) (hBadic : TopologicalRing.IsAdic Bt)
    {DB : FormalSpace.QuotientSystem B S hS Bt} (e : W₀ ≅ FormalSpace.formalSpectrum DB) :
    LocallyOfFiniteType (DB.overS (TopologicalRing.nilIdx hB.1)) := by
  classical
  have hLS : DB.HasLargeSite := FormalSpace.hasLargeSite_of_mk_lt_cutoff _
    (FormalSpace.mk_lt_cutoff_of_quotientSystem_of_isAdic (B := B) (S := S) (hS := hS) hBadic DB)
  have hU := (FormalSpace.isReduction_formalSpectrum hB DB hLS).comp_iso B S hS e.symm
  have hXr := c.isReduction_WredInclusion
  obtain ⟨aR, haR, -⟩ := hXr.universal _ hU.algebraic hU.reduced
    ((FormalSpace.formalSpectrumInclusion DB (OrderDual.toDual (TopologicalRing.nilIdx hB.1)) ≫
      e.symm.hom) ≫ ω)
  have haE := FormalSpace.IsReduction.isEtaleULift_map B S hS hU hXr hω.1 hω.2 haR
  let T : BigFppfOver B S hS :=
    (BigAffineFppf.inclusion B S hS).obj (DB.stage (TopologicalRing.nilIdx hB.1))
  let hatlas := FormalSpace.sheafifiedYonedaObjIso B S hS T
  have ha := haE T hatlas.hom (relative_etale_of_isIso hatlas.hom)
  have hb := relative_etale_of_isIso
    (terminal.from ((uliftYoneda.{u + 1}).obj (BigFppfOver.terminalObj B S hS)))
  exact c.isLocallyOfFiniteType_Wred T _ (hatlas.hom ≫ aR.hom) _
    (Over.homMk T.hom (Category.comp_id _)) ha hb (terminal.hom_ext _ _)

omit [IsLinearTopology Bt Bt] in
/-- **A formal spectrum over an affine open `O = Spec R` of the base is a ring over `R`.** If
`Spf B ⟶ S` factors through the sheaf represented by `O`, with `B` adic, there is a ring map
`ρ : R → B` such that each quotient stage `Spec (B ⧸ J) ⟶ S` is
`Spec (B ⧸ J) ⟶ Spec R ≅ O ⟶ S`: the stages give compatible ring maps `R → B ⧸ J`, which lift to
the complete ring `B`. -/
theorem exists_ringHom_overS_eq (O : S.Opens) [IsAffine (O : Scheme.{u})]
    (hOC : B.Contains (O : Scheme.{u})) (hBadic : TopologicalRing.IsAdic Bt)
    {DB : FormalSpace.QuotientSystem B S hS Bt}
    (π : FormalSpace.formalSpectrum DB ⟶
      (Sheaf.sheafifiedYoneda (BigFppfOver.topology B S hS)).obj (openObj hS O hOC)) :
    ∃ ρ : Γ((O : Scheme.{u}), ⊤) →+* Bt,
      ∀ J : { J : Ideal Bt // TopologicalRing.IsWeakIdealOfDefinition J },
        DB.overS J = Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk J.1).comp ρ)) ≫
          (O : Scheme.{u}).isoSpec.inv ≫ O.ι := by
  classical
  let JT := BigFppfOver.topology B S hS
  let : JT.Subcanonical := bigFppfOver_subcanonical B S hS
  let F := Sheaf.sheafifiedYoneda JT
  let t : ∀ J : { J : Ideal Bt // TopologicalRing.IsWeakIdealOfDefinition J },
      (BigAffineFppf.inclusion B S hS).obj (DB.stage J) ⟶ openObj hS O hOC := fun J =>
    F.preimage (FormalSpace.formalSpectrumInclusion DB (OrderDual.toDual J) ≫ π)
  have ht : ∀ J, F.map (t J) = FormalSpace.formalSpectrumInclusion DB (OrderDual.toDual J) ≫ π :=
    fun J => F.map_preimage _
  let tS : ∀ J : { J : Ideal Bt // TopologicalRing.IsWeakIdealOfDefinition J },
      Spec (CommRingCat.of (Bt ⧸ J.1)) ⟶ (O : Scheme.{u}) := fun J =>
    (BigFppfOver.toScheme B S hS).map (t J)
  have htS : ∀ J, tS J ≫ O.ι = DB.overS J := fun J =>
    congrArg (fun m => B.inclusion.map m) (Over.w (t J))
  have htr : ∀ (J L : { J : Ideal Bt // TopologicalRing.IsWeakIdealOfDefinition J })
      (h : J.1 ≤ L.1), Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor h)) ≫ tS J = tS L := by
    intro J L h
    have h₀ : (BigAffineFppf.inclusion B S hS).map (DB.transition h) ≫ t J = t L := by
      apply F.map_injective
      rw [F.map_comp, ht, ht]
      exact colimit.w_assoc (FormalSpace.formalSpectrumDiagram DB)
        (homOfLE (show OrderDual.toDual L ≤ OrderDual.toDual J from h)) π
    exact ((BigFppfOver.toScheme B S hS).map_comp _ _).symm.trans
      (congrArg (BigFppfOver.toScheme B S hS).map h₀)
  let g : ∀ J : { J : Ideal Bt // TopologicalRing.IsWeakIdealOfDefinition J },
      Γ((O : Scheme.{u}), ⊤) →+* Bt ⧸ J.1 := fun J =>
    (Spec.preimage (tS J ≫ (O : Scheme.{u}).isoSpec.hom)).hom
  have hg : ∀ J, Spec.map (CommRingCat.ofHom (g J)) = tS J ≫ (O : Scheme.{u}).isoSpec.hom :=
    fun J => Spec.map_preimage _
  have hcomp : ∀ (J L : { J : Ideal Bt // TopologicalRing.IsWeakIdealOfDefinition J })
      (h : J.1 ≤ L.1), (Ideal.Quotient.factor h).comp (g J) = g L := by
    intro J L h
    have h1 : Spec.map (CommRingCat.ofHom ((Ideal.Quotient.factor h).comp (g J))) =
        Spec.map (CommRingCat.ofHom (g L)) := by
      rw [CommRingCat.ofHom_comp, Spec.map_comp, hg, hg, ← htr J L h, Category.assoc]
    exact congrArg CommRingCat.Hom.hom (Spec.map_injective h1)
  obtain ⟨I₀, -, hI₀, hcompl⟩ := FormalSpace.exists_idealOfDefinition_isAdicComplete hBadic
  obtain ⟨ρ, hρ⟩ := exists_ringHom_mk_comp_eq hI₀ g hcomp
  refine ⟨ρ, fun J => ?_⟩
  rw [hρ J, hg, ← htS J, Category.assoc, Iso.hom_inv_id_assoc]

/-- **Stacks 0GC6 input of the proof of Stacks 0GI5.** Let `ω : W₀ ⟶ W` be representable étale,
`W₀ ≅ Spf B` with `B` Noetherian, weakly admissible and adic, and suppose `W₀` maps to the sheaf
represented by an affine open `O = Spec R` of `S`. Then there are a ring map `ρ : R → B` through
which every quotient stage `Spec (B ⧸ J) ⟶ S` factors as `Spec (B ⧸ J) ⟶ Spec R ≅ O ⟶ S`, and a
finite set `s ⊆ B` such that the subring generated by `ρ(R)` and `s` is dense: `B` is
topologically of finite type over `R`. The finiteness comes from `W_red` being locally of finite
type over `S`, through the reduction `Spec (B ⧸ 𝔟)` of `W₀` (Stacks 0GB6, 0GB7, 0GC6). -/
theorem exists_ringHom_overS_dense_subring_closure (c : ContractionSituation B S hS)
    (O : S.Opens) [IsAffine (O : Scheme.{u})] (hOC : B.Contains (O : Scheme.{u}))
    {W₀ : FormalSpace.FppfSheaf B S hS} (ω : W₀ ⟶ c.W)
    (hω : FormalSpace.IsRepresentableEtale B S hS ω)
    (π : W₀ ⟶ (Sheaf.sheafifiedYoneda (BigFppfOver.topology B S hS)).obj (openObj hS O hOC))
    [IsNoetherianRing Bt] (hB : TopologicalRing.IsWeaklyAdmissible Bt)
    (hBadic : TopologicalRing.IsAdic Bt)
    {DB : FormalSpace.QuotientSystem B S hS Bt} (e : W₀ ≅ FormalSpace.formalSpectrum DB) :
    ∃ ρ : Γ((O : Scheme.{u}), ⊤) →+* Bt,
      (∀ J : { J : Ideal Bt // TopologicalRing.IsWeakIdealOfDefinition J },
        DB.overS J = Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk J.1).comp ρ)) ≫
          (O : Scheme.{u}).isoSpec.inv ≫ O.ι) ∧
      ∃ s : Finset Bt, Dense (Subring.closure ((ρ.range : Set Bt) ∪ (s : Set Bt)) : Set Bt) := by
  obtain ⟨ρ, hρ⟩ := exists_ringHom_overS_eq O hOC hBadic (e.inv ≫ π)
  refine ⟨ρ, hρ, exists_finset_dense_subring_closure hB ρ ?_⟩
  have hlft := locallyOfFiniteType_overS_nilIdx c ω hω hB hBadic e
  rw [hρ] at hlft
  have := locallyOfFiniteType_of_comp (Spec.map (CommRingCat.ofHom
    ((Ideal.Quotient.mk (TopologicalRing.nilIdx hB.1).1).comp ρ)))
    ((O : Scheme.{u}).isoSpec.inv ≫ O.ι)
  exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this

end Geometry

end AlgebraicGeometry.Artin.FormalDictionary

