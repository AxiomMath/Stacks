module

public import Mathlib.RingTheory.AdicCompletion.Exactness
public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.Filtration

/-!
# Completions of a finite algebra with power torsion kernel and cokernel

Let `A` be a Noetherian ring, `I ⊆ A` an ideal and `C` a finite `A`-algebra such that the kernel
and the cokernel of `A → C` are killed by a power of `I`. In the proof of Stacks 0GI5 this is the
ring map `A → C = Γ(V', O)` from the coordinate ring of an affine Noetherian scheme to the global
functions of a proper modification `V' → Spec A` which is an isomorphism away from `V(I)`.

This file records the facts about the `I`-adic completion `Â → Ĉ` of `A → C` used by the algebra
of that proof (the "kernels and cokernels are equal to their completions" of the source):

* `Ĉ` is generated by the image of `Â` and the image of `C`;
* an element of `C` whose image in `Ĉ` comes from `Â` comes from `A`;
* the kernel of `Â → Ĉ` is the image of the kernel of `A → C`;
* by Artin–Rees, an element of the image of `Â` lying deep in the `I`-adic filtration of `Ĉ` is
  the image of an element lying deep in that of `Â`;
* the kernel of `Â → Ĉ` meets a power of `I` in zero.

## Main results

* `AdicCompletion.isAdicComplete_of_pow_smul_top_eq_bot`: a module killed by a power of `I` is
  `I`-adically complete.
* `AdicCompletion.exists_eq_map_add_of`, `AdicCompletion.mem_range_of_of_mem_range_map`,
  `AdicCompletion.exists_of_eq_of_map_eq_zero`, `AdicCompletion.exists_val_eq_zero_map_eq`,
  `AdicCompletion.exists_eq_zero_of_map_eq_zero_of_val`: the five facts above.

## References

* [Stacks Project, Tag 0GI5](https://stacks.math.columbia.edu/tag/0GI5)
* [Stacks Project, Tag 0BNH](https://stacks.math.columbia.edu/tag/0BNH)
-/

@[expose] public section

open Submodule

universe u

namespace AdicCompletion

variable {A : Type u} [CommRing A] (I : Ideal A)

/-- A module killed by a power of `I` is `I`-adically complete. -/
theorem isAdicComplete_of_pow_smul_top_eq_bot {M : Type u} [AddCommGroup M] [Module A M] {N : ℕ}
    (hN : (I ^ N • ⊤ : Submodule A M) = ⊥) : IsAdicComplete I M := by
  refine { haus' := fun x hx => ?_, prec' := fun f hf => ⟨f N, fun n => ?_⟩ }
  · have := SModEq.sub_mem.1 (hx N)
    rw [hN, sub_zero] at this
    exact (Submodule.mem_bot A).1 this
  · rcases le_total n N with h | h
    · exact hf h
    · have := SModEq.sub_mem.1 (hf h)
      rw [hN, Submodule.mem_bot, sub_eq_zero] at this
      rw [this]

section Map

variable [IsNoetherianRing A] {M N : Type u} [AddCommGroup M] [Module A M] [Module.Finite A M]
  [AddCommGroup N] [Module A N] [Module.Finite A N] (f : M →ₗ[A] N)

/-- **The completion is generated by the image of `M̂` and the image of `N`**, when the cokernel
of `f` is killed by a power of `I`. -/
theorem exists_eq_map_add_of {n₀ : ℕ}
    (hQ : (I ^ n₀ • ⊤ : Submodule A (N ⧸ LinearMap.range f)) = ⊥)
    (y : AdicCompletion I N) : ∃ (x : AdicCompletion I M) (c : N), y = map I f x + of I N c := by
  have : IsAdicComplete I (N ⧸ LinearMap.range f) := isAdicComplete_of_pow_smul_top_eq_bot I hQ
  have : Module.Finite A (LinearMap.range f) := Module.Finite.range f
  have hex := map_exact (I := I) (f := (LinearMap.range f).subtype)
    (g := (LinearMap.range f).mkQ) Subtype.val_injective
    (by simpa using LinearMap.exact_subtype_mkQ (LinearMap.range f)) (Submodule.mkQ_surjective _)
  obtain ⟨q, hq⟩ := of_surjective I (N ⧸ LinearMap.range f) (map I (LinearMap.range f).mkQ y)
  obtain ⟨c, rfl⟩ := Submodule.mkQ_surjective _ q
  have h0 : map I (LinearMap.range f).mkQ (y - of I N c) = 0 := by
    rw [map_sub, map_of, ← hq, sub_self]
  obtain ⟨z, hz⟩ := (hex _).1 h0
  obtain ⟨x, rfl⟩ := map_surjective I (f := f.rangeRestrict)
    (LinearMap.surjective_rangeRestrict f) z
  refine ⟨x, c, ?_⟩
  rw [← LinearMap.comp_apply, map_comp, LinearMap.subtype_comp_rangeRestrict] at hz
  rw [hz, sub_add_cancel]

omit [IsNoetherianRing A] [Module.Finite A M] [Module.Finite A N] in
/-- **An element of `N` whose image in `N̂` comes from `M̂` comes from `M`**, when the cokernel of
`f` is killed by a power of `I`. -/
theorem mem_range_of_of_mem_range_map {n₀ : ℕ}
    (hQ : (I ^ n₀ • ⊤ : Submodule A (N ⧸ LinearMap.range f)) = ⊥) {c : N}
    (hc : of I N c ∈ LinearMap.range (map I f)) : c ∈ LinearMap.range f := by
  have : IsAdicComplete I (N ⧸ LinearMap.range f) := isAdicComplete_of_pow_smul_top_eq_bot I hQ
  have h0 : of I _ ((LinearMap.range f).mkQ c) = 0 := by
    rw [← map_of]
    obtain ⟨x, hx⟩ := hc
    rw [← hx, ← LinearMap.comp_apply, map_comp, LinearMap.range_mkQ_comp,
      AdicCompletion.map_zero, LinearMap.zero_apply]
  have h1 : (LinearMap.range f).mkQ c = 0 := of_injective I _ (by rw [h0, _root_.map_zero])
  simpa using h1

/-- **The kernel of `M̂ → N̂` is the image of the kernel of `f`**, when the kernel of `f` is killed
by a power of `I`. -/
theorem exists_of_eq_of_map_eq_zero {n₀ : ℕ}
    (hK : (I ^ n₀ • ⊤ : Submodule A (LinearMap.ker f)) = ⊥) {x : AdicCompletion I M}
    (hx : map I f x = 0) : ∃ k : M, f k = 0 ∧ of I M k = x := by
  have : IsAdicComplete I (LinearMap.ker f) := isAdicComplete_of_pow_smul_top_eq_bot I hK
  have : Module.Finite A (LinearMap.ker f) := Module.Finite.of_injective (LinearMap.ker f).subtype
    Subtype.val_injective
  have : Module.Finite A (LinearMap.range f) := Module.Finite.range f
  have hex := map_exact (I := I) (f := (LinearMap.ker f).subtype) (g := f.rangeRestrict)
    Subtype.val_injective (fun y => by
      constructor
      · intro h
        exact ⟨⟨y, by simpa [LinearMap.rangeRestrict, Subtype.ext_iff] using h⟩, rfl⟩
      · rintro ⟨z, rfl⟩
        ext
        simp) (LinearMap.surjective_rangeRestrict f)
  have hx' : map I f.rangeRestrict x = 0 := by
    apply map_injective I (f := (LinearMap.range f).subtype) Subtype.val_injective
    rw [← LinearMap.comp_apply, map_comp, LinearMap.subtype_comp_rangeRestrict, hx, _root_.map_zero]
  obtain ⟨z, rfl⟩ := (hex x).1 hx'
  obtain ⟨k, rfl⟩ := of_surjective I _ z
  exact ⟨k, k.2, by rw [map_of]; rfl⟩

/-- Artin–Rees: for a submodule `P` of `L` there is `k` with `Iⁿ⁺ᵏ L ⊓ P ≤ Iⁿ • P` for all `n`. -/
private theorem exists_pow_add_smul_inf_le {L : Type u} [AddCommGroup L] [Module A L]
    [Module.Finite A L] (P : Submodule A L) :
    ∃ k : ℕ, ∀ n : ℕ, (I ^ (n + k) • ⊤ : Submodule A L) ⊓ P ≤ I ^ n • P := by
  obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul I P
  refine ⟨k, fun n => ?_⟩
  rw [hk (n + k) (Nat.le_add_left k n), Nat.add_sub_cancel]
  exact Submodule.smul_mono le_rfl inf_le_right

omit [Module.Finite A M] in
/-- **Artin–Rees for the image of `M̂` in `N̂`**: there is `k₀` such that an element of the image
of `M̂` vanishing at level `n + k₀` in `N̂` is the image of an element vanishing at level `n`. -/
theorem exists_val_eq_zero_map_eq :
    ∃ k₀ : ℕ, ∀ (n : ℕ) (x : AdicCompletion I M), (map I f x).val (n + k₀) = 0 →
      ∃ x' : AdicCompletion I M, x'.val n = 0 ∧ map I f x' = map I f x := by
  obtain ⟨k, hk⟩ := exists_pow_add_smul_inf_le I (LinearMap.range f)
  refine ⟨k, fun n x hx => ?_⟩
  obtain ⟨a, ha⟩ := Submodule.Quotient.mk_surjective _ (x.val (n + k))
  have hfa : f a ∈ (I ^ (n + k) • ⊤ : Submodule A N) := by
    rw [map_val_apply, ← ha, LinearMap.reduceModIdeal_apply] at hx
    exact (Submodule.Quotient.mk_eq_zero _).1 hx
  have h2 : I ^ n • LinearMap.range f ≤ (I ^ n • ⊤ : Submodule A M).map f := by
    rw [LinearMap.range_eq_map, Submodule.map_smul'']
  obtain ⟨z, hz, hfz⟩ := h2 (hk n ⟨hfa, a, rfl⟩)
  refine ⟨x - of I M (a - z), ?_, ?_⟩
  · have hv : x.val n = Submodule.Quotient.mk a := by
      rw [← x.prop (Nat.le_add_right n k), ← ha]
      rfl
    rw [val_sub, Pi.sub_apply, hv, of_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_sub,
      (Submodule.Quotient.mk_eq_zero _).2 hz, sub_zero, sub_self]
  · rw [map_sub, map_of, map_sub, hfz, sub_self, _root_.map_zero, sub_zero]

/-- **The kernel of `M̂ → N̂` meets a level of the filtration in zero**, when the kernel of `f` is
killed by a power of `I`. -/
theorem exists_eq_zero_of_map_eq_zero_of_val {n₀ : ℕ}
    (hK : (I ^ n₀ • ⊤ : Submodule A (LinearMap.ker f)) = ⊥) :
    ∃ n₁ : ℕ, ∀ x : AdicCompletion I M, map I f x = 0 → x.val n₁ = 0 → x = 0 := by
  obtain ⟨k, hk⟩ := exists_pow_add_smul_inf_le I (LinearMap.ker f)
  refine ⟨n₀ + k, fun x hx hv => ?_⟩
  obtain ⟨a, ha, rfl⟩ := exists_of_eq_of_map_eq_zero I f hK hx
  have hker : I ^ n₀ • LinearMap.ker f ≤ (⊥ : Submodule A M) := by
    have h := congrArg (Submodule.map (LinearMap.ker f).subtype) hK
    rw [Submodule.map_smul'', Submodule.map_bot, Submodule.map_top, Submodule.range_subtype] at h
    exact h.le
  have hmem := hk n₀ ⟨(Submodule.Quotient.mk_eq_zero _).1 (by rwa [of_apply] at hv), ha⟩
  rw [(Submodule.mem_bot A).1 (hker hmem), _root_.map_zero]

end Map

end AdicCompletion

end
