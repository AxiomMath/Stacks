section Transitions

variable (V : BigFppfOver B S hS) [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
  (I : Ideal Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)) {X : AlgebraicSpaces B S hS}
  (f : X ⟶ schemeSpace V)

/-- The transition map of the fibre tower from level `n` to itself is the identity. -/
theorem fibreTransition_refl (n : ℕ) : fibreTransition V I f (le_refl n) = 𝟙 _ :=
  ObjectProperty.hom_ext _ ((cancel_mono (Subfunctor.ι _)).1 (by
    change Subfunctor.homOfLe (fibreThickening_le V I f (le_refl n)) ≫
        (fibreThickening V I f n).1.ι = 𝟙 _ ≫ (fibreThickening V I f n).1.ι
    rw [Subfunctor.homOfLe_ι, Category.id_comp]))

/-- The transition maps of the fibre tower compose: `a ≤ b ≤ c` gives the transition `a ≤ c`. -/
theorem fibreTransition_trans {a b c : ℕ} (hab : a ≤ b) (hbc : b ≤ c) :
    fibreTransition V I f hab ≫ fibreTransition V I f hbc =
      fibreTransition V I f (hab.trans hbc) :=
  ObjectProperty.hom_ext _ ((cancel_mono (Subfunctor.ι _)).1 (by
    change (Subfunctor.homOfLe (fibreThickening_le V I f hab) ≫
        Subfunctor.homOfLe (fibreThickening_le V I f hbc)) ≫ (fibreThickening V I f c).1.ι =
      Subfunctor.homOfLe (fibreThickening_le V I f (hab.trans hbc)) ≫ (fibreThickening V I f c).1.ι
    rw [Category.assoc, Subfunctor.homOfLe_ι, Subfunctor.homOfLe_ι, Subfunctor.homOfLe_ι]))

end Transitions

variable {V : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
  [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)]
  {I : Ideal Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)}
  {X : AlgebraicSpaces B S hS} (g : X.1 ⟶ yoneda.obj V)

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
/-- The families of `lim_n Γ(X ×_V Spec (A / I^{n+1}), 𝒪)` are compatible with every
transition. -/
theorem towerRing_compat (w : towerRing I g) {m n : ℕ} (h : m ≤ n) :
    globalSectionsRingHomSite B S hS (fibreTransition V I (spaceHom V g) (Nat.succ_le_succ h))
      (w.1 n) = w.1 m := by
  induction n, h using Nat.le_induction with
  | base =>
    rw [fibreTransition_refl, globalSectionsRingHomSite_id]
    rfl
  | succ n hmn ih =>
    have e := congrArg (fun φ => φ (w.1 (n + 1))) (globalSectionsRingHomSite_comp B S hS
      (fibreTransition V I (spaceHom V g) (Nat.succ_le_succ hmn))
      (fibreTransition V I (spaceHom V g) (Nat.le_succ (n + 1))))
    rw [fibreTransition_trans, RingHom.comp_apply] at e
    have hw : globalSectionsRingHomSite B S hS
        (fibreTransition V I (spaceHom V g) (Nat.le_succ (n + 1))) (w.1 (n + 1)) = w.1 n := w.2 n
    rwa [e, hw]

/-- If a linear equivalence `e : M ≃ N` carries `m` into `J • N`, then `m ∈ J • M`. -/
theorem mem_smul_top_of_linearEquiv {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (e : M ≃ₗ[R] N) (J : Ideal R) {m : M}
    (h : e m ∈ J • (⊤ : Submodule R N)) : m ∈ J • (⊤ : Submodule R M) := by
  have h' := Submodule.mem_map_of_mem (f := e.symm.toLinearMap) h
  rwa [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range, LinearEquiv.coe_coe,
    LinearEquiv.symm_apply_apply] at h'

/-- If the level-`k` component of `y ∈ M^∧` is the class of `m ∈ J^j • M` with `j ≤ k`, then
the level-`j` component of `y` vanishes. -/
theorem val_eq_zero_of_val_eq_mk {R : Type*} [CommRing R] {J : Ideal R} {M : Type*}
    [AddCommGroup M] [Module R M] (y : AdicCompletion J M) {j k : ℕ} (hjk : j ≤ k) {m : M}
    (hm : y.val k = Submodule.Quotient.mk m) (hm' : m ∈ J ^ j • (⊤ : Submodule R M)) :
    y.val j = 0 := by
  rw [← y.prop hjk, hm]
  exact (Submodule.Quotient.mk_eq_zero _).2 hm'

/-- If the level-`n` component of `y ∈ M^∧` vanishes, so does that of its image under the
completion of a linear map `M ⟶ N`. -/
theorem map_val_eq_zero {R : Type*} [CommRing R] {J : Ideal R} {M N : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] (f : M →ₗ[R] N)
    (y : AdicCompletion J M) {n : ℕ} (h : y.val n = 0) : (AdicCompletion.map J f y).val n = 0 := by
  rw [AdicCompletion.map_val_apply, h, map_zero]

section Comparison

variable [_root_.AlgebraicGeometry.IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj V)]
  (hf : Space.IsProper B S hS g)

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
include hf in
/-- **Formal functions on the fibres: the kernels of the restrictions are deep in the
`I`-adic filtration** (the first clause of Stacks 08AY for `𝒪_X`, read on the fibres). -/
theorem exists_fibreRestriction_bound :
    ∃ c : ℕ, ∀ (n : ℕ) (m : globalFunctionsOver V (spaceHom V g)),
      fibreRestriction V I (spaceHom V g) (n + c) m = 0 →
        m ∈ I ^ n • (⊤ : Submodule Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)
          (globalFunctionsOver V (spaceHom V g))) := by
  have : Fact (HasEtaleLocalProperty B S hS X.1
      (fun T : Scheme.{u} => _root_.AlgebraicGeometry.IsLocallyNoetherian T)) :=
    ⟨hasEtaleLocalProperty_isLocallyNoetherian_of_isProper_of_isAffine V (spaceHom V g) hf⟩
  obtain ⟨c, hc, -⟩ := exists_sectionsTower_bounds V (spaceHom V g) hf
    (AlgebraicGeometry.Space.structureSheafModule B S hS X) I
  refine ⟨c, fun n m hm => ?_⟩
  let φ := pullbackRingHom B V (spaceHom V g)
  have h0 : sectionsTowerProj φ (AlgebraicGeometry.Space.structureSheafModule B S hS X) I (n + c)
      (globalFunctionsEquivCohomologyZero φ m) = 0 := by
    have e₂ := fibreSectionsOfCohomologyZero_proj V I (spaceHom V g) (n + c) 0
    rw [map_zero, map_zero] at e₂
    exact (fibreSectionsOfCohomologyZero_bijective V I (spaceHom V g) (n + c)).1
      ((fibreSectionsOfCohomologyZero_proj V I (spaceHom V g) (n + c) m).trans
        ((hm.trans (map_zero (fibreRestriction V I (spaceHom V g) (n + c))).symm).trans e₂.symm))
  have hk := hc (n + c) (Nat.le_add_left c n) h0
  rw [Nat.add_sub_cancel] at hk
  exact mem_smul_top_of_linearEquiv _ _ hk

/-- **The comparison `Γ(X, 𝒪)^∧_I ⟶ lim_n Γ(X ×_V Spec (A / I^{n+1}), 𝒪)`** of the theorem on
formal functions. -/
def towerComparison (y : AdicCompletion I (globalFunctionsOver V (spaceHom V g))) :
    towerRing I g :=
  ⟨fun n => (adicCompletionFibreFunctionsEquiv V I (spaceHom V g) hf y).1 (n + 1),
    fun n => Stacks.IntertwinedFiltration.towerLimit_compat
      (adicCompletionFibreFunctionsEquiv V I (spaceHom V g) hf y) (n + 1) (n + 1 + 1)
        (Nat.le_succ _)⟩

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
/-- The level-`n` component of `towerComparison g hf y` is the level-`(n + 1)` component of the
image of `y` under `AlgebraicGeometry.Space.adicCompletionFibreFunctionsEquiv`. -/
theorem towerComparison_apply (y : AdicCompletion I (globalFunctionsOver V (spaceHom V g)))
    (n : ℕ) :
    (towerComparison g hf y).1 n =
      (adicCompletionFibreFunctionsEquiv V I (spaceHom V g) hf y).1 (n + 1) :=
  rfl

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
/-- `towerComparison` is additive. -/
theorem towerComparison_add (y y' : AdicCompletion I (globalFunctionsOver V (spaceHom V g))) :
    towerComparison g hf (y + y') = towerComparison g hf y + towerComparison g hf y' :=
  Subtype.ext (funext fun n => congrArg (fun z : Stacks.IntertwinedFiltration.towerLimit _
    (fibreFunctionsMap V I (spaceHom V g)) => z.1 (n + 1))
      (map_add (adicCompletionFibreFunctionsEquiv V I (spaceHom V g) hf) y y'))

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
/-- `towerComparison` commutes with subtraction. -/
theorem towerComparison_sub (y y' : AdicCompletion I (globalFunctionsOver V (spaceHom V g))) :
    towerComparison g hf (y - y') = towerComparison g hf y - towerComparison g hf y' :=
  Subtype.ext (funext fun n => congrArg (fun z : Stacks.IntertwinedFiltration.towerLimit _
    (fibreFunctionsMap V I (spaceHom V g)) => z.1 (n + 1))
      (map_sub (adicCompletionFibreFunctionsEquiv V I (spaceHom V g) hf) y y'))

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
/-- `towerComparison` carries `0` to `0`. -/
theorem towerComparison_zero :
    towerComparison g hf (0 : AdicCompletion I (globalFunctionsOver V (spaceHom V g))) = 0 :=
  Subtype.ext (funext fun n => congrArg (fun z : Stacks.IntertwinedFiltration.towerLimit _
    (fibreFunctionsMap V I (spaceHom V g)) => z.1 (n + 1))
    (map_zero (adicCompletionFibreFunctionsEquiv V I (spaceHom V g) hf)))

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
/-- The comparison carries the image of `c ∈ Γ(X, 𝒪)` in `Γ(X, 𝒪)^∧_I` to its restriction to the
fibres, `towerOf I g c`. -/
theorem towerComparison_of (c : ↥(GlobalSectionRing (Stacks.SheafOfModules.Tensor.ringSheaf
      (Space.smallEtaleRingedSite B S hS X.1 X.2).O))) :
    towerComparison g hf (AdicCompletion.of I (globalFunctionsOver V (spaceHom V g)) c) =
      towerOf I g c :=
  Subtype.ext (funext fun n => adicCompletionFibreFunctionsEquiv_of V I (spaceHom V g) hf c (n + 1))

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
/-- `towerComparison` is injective. -/
theorem towerComparison_injective : Function.Injective (towerComparison (I := I) g hf) := by
  intro y y' h
  refine (adicCompletionFibreFunctionsEquiv V I (spaceHom V g) hf).injective
    (Stacks.IntertwinedFiltration.towerLimit_ext fun n => ?_)
  cases n with
  | zero =>
    have e₁ := Stacks.IntertwinedFiltration.towerLimit_compat
      (adicCompletionFibreFunctionsEquiv V I (spaceHom V g) hf y) 0 1 (Nat.zero_le 1)
    have e₂ := Stacks.IntertwinedFiltration.towerLimit_compat
      (adicCompletionFibreFunctionsEquiv V I (spaceHom V g) hf y') 0 1 (Nat.zero_le 1)
    exact e₁.symm.trans ((congrArg (fibreFunctionsMap V I (spaceHom V g) 0 1 (Nat.zero_le 1))
      (congrArg (fun z : towerRing I g => z.1 0) h)).trans e₂)
  | succ n => exact congrArg (fun z : towerRing I g => z.1 n) h

/-- The family of `lim_n Γ(X ×_V Spec (A / Iⁿ), 𝒪)` of an element of
`lim_n Γ(X ×_V Spec (A / I^{n+1}), 𝒪)`. -/
def towerLimitFamily (w : towerRing I g) :
    ∀ n, (fibreFunctions V I (spaceHom V g) n : Type (u + 1))
  | 0 => globalSectionsRingHomSite B S hS (fibreTransition V I (spaceHom V g) (Nat.zero_le 1))
      (w.1 0)
  | n + 1 => w.1 n

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)]
  [_root_.AlgebraicGeometry.IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj V)] in
/-- The family `towerLimitFamily g w` is compatible with the transition maps of the fibre tower. -/
theorem towerLimitFamily_compat (w : towerRing I g) (m n : ℕ) (h : m ≤ n) :
    fibreFunctionsMap V I (spaceHom V g) m n h (towerLimitFamily g w n) =
      towerLimitFamily g w m := by
  rw [fibreFunctionsMap_apply]
  match m, n, h with
  | 0, 0, _ =>
    rw [fibreTransition_refl, globalSectionsRingHomSite_id]
    rfl
  | 0, k + 1, _ =>
    have e := congrArg (fun φ => φ (w.1 k)) (globalSectionsRingHomSite_comp B S hS
      (fibreTransition V I (spaceHom V g) (Nat.zero_le 1))
      (fibreTransition V I (spaceHom V g) (Nat.succ_le_succ (Nat.zero_le k))))
    rw [fibreTransition_trans, RingHom.comp_apply] at e
    exact e.trans (congrArg _ (towerRing_compat g w (Nat.zero_le k)))
  | j + 1, k + 1, h => exact towerRing_compat g w (Nat.le_of_succ_le_succ h)

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
/-- `towerComparison` is surjective. -/
theorem towerComparison_surjective : Function.Surjective (towerComparison (I := I) g hf) := by
  intro w
  obtain ⟨y, hy⟩ := (adicCompletionFibreFunctionsEquiv V I (spaceHom V g) hf).surjective
    ⟨towerLimitFamily g w, fun m n h => towerLimitFamily_compat g w m n h⟩
  refine ⟨y, Subtype.ext (funext fun n => ?_)⟩
  rw [towerComparison_apply, hy]
  rfl

/-- `A ⟶ Γ(X, 𝒪)`, as a map of `A`-modules. -/
def pullbackLinear :
    Γ((BigFppfOver.toScheme B S hS).obj V, ⊤) →ₗ[Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)]
      globalFunctionsOver V (spaceHom V g) :=
  { toFun := fun a => pullbackRingHom B V (spaceHom V g) a
    map_add' := map_add _
    map_smul' := fun a b => map_mul (pullbackRingHom B V (spaceHom V g)) a b }

omit [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
  [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)]
  [_root_.AlgebraicGeometry.IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj V)] in
/-- `pullbackLinear g a` is the image of `a` under `A ⟶ Γ(X, 𝒪)`. -/
theorem pullbackLinear_apply (a : Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)) :
    pullbackLinear g a = pullbackRingHom B V (spaceHom V g) a :=
  rfl

variable {Z : Set (Space.points B S hS (yoneda.obj V))}
  (hZI : ∀ x, x ∈ Z ↔ Space.pointsToScheme B S hS V x ∈
    ((BigFppfOver.toScheme B S hS).obj V).zeroLocus
      (I : Set Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)))
  (hqc : ∀ n, IsQuasiCompactSpace B S hS (fibreSpace V I (spaceHom V g) n).1)

omit [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
  [_root_.AlgebraicGeometry.IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj V)] in
/-- If `x - a ∈ I^k A^∧` for `x ∈ A^∧` and `a ∈ A`, then the level-`k` component of `x` is the
class of `a`. -/
theorem val_eq_mk_of_sub_mem {x : AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)}
    {a : Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)} {k : ℕ}
    (ha : x - algebraMap _ _ a ∈ (I ^ k).map (algebraMap _ _)) :
    x.val k = Submodule.Quotient.mk a := by
  have h : x - algebraMap _ _ a ∈ (I ^ k • ⊤ : Submodule Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)
      (AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤))) := by
    rwa [Ideal.smul_top_eq_map]
  rwa [AdicCompletion.pow_smul_top_eq_ker_eval I.fg_of_isNoetherianRing,
    LinearMap.mem_ker, map_sub, AdicCompletion.algebraMap_apply, AdicCompletion.eval_of,
    Algebra.algebraMap_self, RingHom.id_apply, sub_eq_zero] at h

/-- **The comparison carries the completion of `A ⟶ Γ(X, 𝒪)` to `α`.** -/
theorem towerComparison_map (x : AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)) :
    towerComparison g hf (AdicCompletion.map I (pullbackLinear g) x) = alpha g hZI hqc x := by
  refine Subtype.ext (funext fun n => ?_)
  obtain ⟨a, ha⟩ := Ideal.exists_sub_algebraMap_mem_map_pow I x (n + 1)
  have hm : (AdicCompletion.map I (pullbackLinear g) x).val (n + 1) =
      Submodule.Quotient.mk (pullbackLinear g a) := by
    rw [AdicCompletion.map_val_apply, val_eq_mk_of_sub_mem ha]
    rfl
  have e₁ := fibreFunctionsTowerOf_apply V I (spaceHom V g) hf _ (n + 1) _ hm
  have hx : x = algebraMap _ _ a + (x - algebraMap _ _ a) := (add_sub_cancel _ _).symm
  have e₂ : alphaComp I g n x = alphaComp I g n (algebraMap _ _ a) :=
    ((congrArg (alphaComp I g n) hx).trans ((alphaComp I g n).map_add _ _)).trans
      ((congrArg (_ + ·) (alphaComp_eq_zero g ha)).trans (add_zero _))
  refine e₁.trans (Eq.trans ?_ ((alphaComp_algebraMap I g n a).symm.trans e₂.symm))
  exact congrArg (globalSectionsRingHomSite B S hS (fibreInclusion V I (spaceHom V g) (n + 1)))
    (pullbackLinear_apply g a)

end Comparison

section Torsion

variable [_root_.AlgebraicGeometry.IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj V)]
  (hf : Space.IsProper B S hS g)
  {Z : Set (Space.points B S hS (yoneda.obj V))}
  (hZI : ∀ x, x ∈ Z ↔ Space.pointsToScheme B S hS V x ∈
    ((BigFppfOver.toScheme B S hS).obj V).zeroLocus
      (I : Set Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)))
  (hqc : ∀ n, IsQuasiCompactSpace B S hS (fibreSpace V I (spaceHom V g) n).1)
  {N : ℕ}
  (hK : ∀ a, pullbackRingHom B V (spaceHom V g) a = 0 → ∀ x ∈ I ^ N, x * a = 0)
  (hQ : ∀ s : ↥(GlobalSectionRing (Stacks.SheafOfModules.Tensor.ringSheaf
      (Space.smallEtaleRingedSite B S hS X.1 X.2).O)), ∀ x ∈ I ^ N,
        pullbackRingHom B V (spaceHom V g) x * s ∈ (pullbackRingHom B V (spaceHom V g)).range)

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
include hf in
/-- `Γ(X, 𝒪)` is `u`-small. -/
theorem small_globalFunctionsOver : Small.{u} (globalFunctionsOver V (spaceHom V g)) :=
  have := moduleFinite_globalFunctionsOver_of_isProper V (spaceHom V g) hf
  Module.Finite.small.{u} Γ((BigFppfOver.toScheme B S hS).obj V, ⊤) _

/-- `Γ(X, 𝒪)` in the universe of `A`. -/
abbrev SmallFunctions : Type u :=
  haveI := small_globalFunctionsOver g hf
  Shrink.{u} (globalFunctionsOver V (spaceHom V g))

/-- The identification of `Γ(X, 𝒪)` with its copy in the universe of `A`. -/
def smallFunctionsEquiv :
    SmallFunctions g hf ≃ₗ[Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)]
      globalFunctionsOver V (spaceHom V g) :=
  haveI := small_globalFunctionsOver g hf
  Shrink.linearEquiv.{u} _ _

/-- `SmallFunctions g hf` is a finite `A`-module. -/
instance moduleFinite_smallFunctions :
    Module.Finite Γ((BigFppfOver.toScheme B S hS).obj V, ⊤) (SmallFunctions g hf) :=
  haveI := moduleFinite_globalFunctionsOver_of_isProper V (spaceHom V g) hf
  Module.Finite.equiv (smallFunctionsEquiv g hf).symm

/-- `A ⟶ Γ(X, 𝒪)` into the copy in the universe of `A`. -/
def smallPullbackLinear :
    Γ((BigFppfOver.toScheme B S hS).obj V, ⊤) →ₗ[Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)]
      SmallFunctions g hf :=
  (smallFunctionsEquiv g hf).symm.toLinearMap ∘ₗ pullbackLinear g

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
/-- Under `smallFunctionsEquiv`, `smallPullbackLinear` is the map `A ⟶ Γ(X, 𝒪)`. -/
theorem smallFunctionsEquiv_smallPullbackLinear (a : Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)) :
    smallFunctionsEquiv g hf (smallPullbackLinear g hf a) = pullbackRingHom B V (spaceHom V g) a :=
  (smallFunctionsEquiv g hf).apply_symm_apply _

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
/-- Under the completion of `smallFunctionsEquiv`, the completion of `smallPullbackLinear` is
the completion of `pullbackLinear`. -/
theorem congr_map_smallPullbackLinear
    (x : AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)) :
    AdicCompletion.congr I (smallFunctionsEquiv g hf)
        (AdicCompletion.map I (smallPullbackLinear g hf) x) =
      AdicCompletion.map I (pullbackLinear g) x := by
  change (AdicCompletion.map I (smallFunctionsEquiv g hf).toLinearMap ∘ₗ
    AdicCompletion.map I (smallPullbackLinear g hf)) x = _
  rw [AdicCompletion.map_comp]
  congr 2
  exact LinearMap.ext fun a => (smallFunctionsEquiv g hf).apply_symm_apply _

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
include hK in
/-- `I^N` kills the kernel of `A ⟶ Γ(X, 𝒪)`. -/
theorem pow_smul_top_ker_eq_bot :
    (I ^ N • ⊤ : Submodule Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)
      (LinearMap.ker (smallPullbackLinear g hf))) = ⊥ := by
  refine eq_bot_iff.2 (Submodule.smul_le.2 fun r hr k _ => ?_)
  rw [Submodule.mem_bot]
  refine Subtype.ext ?_
  have hk : pullbackRingHom B V (spaceHom V g) k.1 = 0 := by
    have h := congrArg (smallFunctionsEquiv g hf) k.2
    rwa [smallFunctionsEquiv_smallPullbackLinear, map_zero] at h
  exact hK k.1 hk r hr

omit [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)] in
include hQ in
/-- `I^N` kills the cokernel of `A ⟶ Γ(X, 𝒪)`. -/
theorem pow_smul_top_coker_eq_bot :
    (I ^ N • ⊤ : Submodule Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)
      (SmallFunctions g hf ⧸ LinearMap.range (smallPullbackLinear g hf))) = ⊥ := by
  refine eq_bot_iff.2 (Submodule.smul_le.2 fun r hr q _ => ?_)
  obtain ⟨s', rfl⟩ := Submodule.Quotient.mk_surjective _ q
  rw [Submodule.mem_bot, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
  obtain ⟨a, ha⟩ := hQ (smallFunctionsEquiv g hf s') r hr
  refine ⟨a, (smallFunctionsEquiv g hf).injective ?_⟩
  rw [smallFunctionsEquiv_smallPullbackLinear, ha, map_smul]
  rfl

include hf hQ in
/-- **The tower ring is generated by the images of `A^∧` and of `Γ(X, 𝒪)`.** -/
theorem exists_eq_alpha_add_towerOf (z : towerRing I g) :
    ∃ (x : AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤))
      (c : ↥(GlobalSectionRing (Stacks.SheafOfModules.Tensor.ringSheaf
        (Space.smallEtaleRingedSite B S hS X.1 X.2).O))),
      z = alpha g hZI hqc x + towerOf I g c := by
  obtain ⟨y, rfl⟩ := towerComparison_surjective g hf z
  obtain ⟨x, c', hxc⟩ := AdicCompletion.exists_eq_map_add_of I (smallPullbackLinear g hf)
    (pow_smul_top_coker_eq_bot g hf hQ) ((AdicCompletion.congr I (smallFunctionsEquiv g hf)).symm y)
  refine ⟨x, smallFunctionsEquiv g hf c', ?_⟩
  have hy : y = AdicCompletion.map I (pullbackLinear g) x +
      AdicCompletion.of I _ (smallFunctionsEquiv g hf c') := by
    have h := congrArg (AdicCompletion.congr I (smallFunctionsEquiv g hf)) hxc
    rw [LinearEquiv.apply_symm_apply, map_add, congr_map_smallPullbackLinear] at h
    rw [h]
    rfl
  rw [hy, towerComparison_add, towerComparison_map g hf hZI hqc]
  exact congrArg (alpha g hZI hqc x + ·) (towerComparison_of g hf (smallFunctionsEquiv g hf c'))

include hf hQ in
/-- **An element of `Γ(X, 𝒪)` whose image in the tower ring comes from `A^∧` comes from `A`.** -/
theorem exists_pullbackRingHom_eq_of_towerOf_eq_alpha
    {c : ↥(GlobalSectionRing (Stacks.SheafOfModules.Tensor.ringSheaf
      (Space.smallEtaleRingedSite B S hS X.1 X.2).O))}
    {x : AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)}
    (h : towerOf I g c = alpha g hZI hqc x) :
    ∃ a, pullbackRingHom B V (spaceHom V g) a = c := by
  rw [← towerComparison_of g hf, ← towerComparison_map g hf hZI hqc] at h
  have h' := congrArg (AdicCompletion.congr I (smallFunctionsEquiv g hf)).symm
    (towerComparison_injective g hf h)
  rw [← congr_map_smallPullbackLinear g hf, LinearEquiv.symm_apply_apply] at h'
  obtain ⟨a, ha⟩ := AdicCompletion.mem_range_of_of_mem_range_map I (smallPullbackLinear g hf)
    (pow_smul_top_coker_eq_bot g hf hQ) (c := (smallFunctionsEquiv g hf).symm c) ⟨x, h'.symm⟩
  refine ⟨a, ?_⟩
  rw [← smallFunctionsEquiv_smallPullbackLinear g hf, ha]
  exact (smallFunctionsEquiv g hf).apply_symm_apply c

/-- If `α x = 0`, then `x` lies in the kernel of the completion of `A ⟶ Γ(X, 𝒪)`. -/
theorem map_smallPullbackLinear_eq_zero
    {x : AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)}
    (h : alpha g hZI hqc x = 0) : AdicCompletion.map I (smallPullbackLinear g hf) x = 0 := by
  rw [← towerComparison_map g hf hZI hqc, ← towerComparison_zero g hf] at h
  have h' := congrArg (AdicCompletion.congr I (smallFunctionsEquiv g hf)).symm
    (towerComparison_injective g hf h)
  rwa [← congr_map_smallPullbackLinear g hf, LinearEquiv.symm_apply_apply, map_zero] at h'

include hf hK in
/-- **The kernel of `α` is the image of the kernel of `A ⟶ Γ(X, 𝒪)`.** -/
theorem exists_algebraMap_eq_of_alpha_eq_zero
    {x : AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)} (h : alpha g hZI hqc x = 0) :
    ∃ a, pullbackRingHom B V (spaceHom V g) a = 0 ∧ algebraMap _ _ a = x := by
  obtain ⟨a, ha, rfl⟩ := AdicCompletion.exists_of_eq_of_map_eq_zero I (smallPullbackLinear g hf)
    (pow_smul_top_ker_eq_bot g hf hK) (map_smallPullbackLinear_eq_zero g hf hZI hqc h)
  refine ⟨a, ?_, ?_⟩
  · exact (smallFunctionsEquiv_smallPullbackLinear g hf a).symm.trans
      ((congrArg (smallFunctionsEquiv g hf) ha).trans (map_zero _))
  · rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]

omit [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
  [_root_.AlgebraicGeometry.IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj V)] in
/-- An element of `(I A^∧)^n` has vanishing level-`n` component. -/
theorem val_eq_zero_of_mem_map_pow {x : AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)}
    {n : ℕ} (hx : x ∈ (I.map (algebraMap _
      (AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)))) ^ n) :
    x.val n = 0 := by
  have h : x ∈ (I ^ n • ⊤ : Submodule Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)
      (AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤))) := by
    rwa [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem, Ideal.map_pow]
  rwa [AdicCompletion.pow_smul_top_eq_ker_eval I.fg_of_isNoetherianRing, LinearMap.mem_ker] at h

omit [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
  [_root_.AlgebraicGeometry.IsLocallyNoetherian ((BigFppfOver.toScheme B S hS).obj V)] in
/-- An element of `A^∧` with vanishing level-`n` component lies in `(I A^∧)^n`. -/
theorem mem_map_pow_of_val_eq_zero {x : AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)}
    {n : ℕ} (hx : x.val n = 0) :
    x ∈ (I.map (algebraMap _
      (AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)))) ^ n := by
  have h : x ∈ (I ^ n • ⊤ : Submodule Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)
      (AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤))) := by
    rwa [AdicCompletion.pow_smul_top_eq_ker_eval I.fg_of_isNoetherianRing, LinearMap.mem_ker]
  rwa [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem, Ideal.map_pow] at h

include hf hK in
/-- **The kernel of `α` meets a power of `I A^∧` in zero.** -/
theorem exists_eq_zero_of_alpha_eq_zero_of_mem :
    ∃ n₁ : ℕ, ∀ x : AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤),
      alpha g hZI hqc x = 0 →
        x ∈ (I.map (algebraMap _
            (AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)))) ^ n₁ →
          x = 0 := by
  obtain ⟨n₁, h₁⟩ := AdicCompletion.exists_eq_zero_of_map_eq_zero_of_val I
    (smallPullbackLinear g hf) (pow_smul_top_ker_eq_bot g hf hK)
  exact ⟨n₁, fun x hx hm => h₁ x (map_smallPullbackLinear_eq_zero g hf hZI hqc hx)
    (val_eq_zero_of_mem_map_pow hm)⟩

include hf in
/-- **The Artin–Rees lemma for `α`**: an element of `A^∧` whose image lies deep in the filtration
of the tower ring has the same image as an element of a power of `I A^∧`. -/
theorem exists_alpha_eq_of_mem_towerFiltration :
    ∃ K : ℕ, ∀ (n : ℕ) (x : AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)),
      alpha g hZI hqc x ∈ towerFiltration I g (n + K) →
        ∃ x' ∈ (I.map (algebraMap _
            (AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)))) ^ n,
          alpha g hZI hqc x' = alpha g hZI hqc x := by
  obtain ⟨c₀, hc₀⟩ := exists_fibreRestriction_bound (I := I) g hf
  obtain ⟨k₀, hk₀⟩ := AdicCompletion.exists_val_eq_zero_map_eq I (smallPullbackLinear g hf)
  refine ⟨k₀ + 1 + c₀, fun n x hx => ?_⟩
  obtain ⟨y, hyd⟩ : ∃ y, AdicCompletion.map I (pullbackLinear g) x = y := ⟨_, rfl⟩
  have hy :
      (adicCompletionFibreFunctionsEquiv V I (spaceHom V g) hf y).1 (n + k₀ + 1 + c₀) = 0 := by
    have h := hx (n + k₀ + c₀) (by omega)
    rw [← towerComparison_map g hf hZI hqc, hyd, towerComparison_apply] at h
    rwa [show n + k₀ + 1 + c₀ = n + k₀ + c₀ + 1 by omega]
  obtain ⟨mm, hmm⟩ := Submodule.Quotient.mk_surjective _ (y.val (n + k₀ + 1 + c₀))
  have h₁ := fibreFunctionsTowerOf_apply V I (spaceHom V g) hf y (n + k₀ + 1 + c₀) mm hmm.symm
  have h₂ := hc₀ (n + k₀ + 1) mm (h₁.symm.trans hy)
  have h₃ : y.val (n + k₀) = 0 := val_eq_zero_of_val_eq_mk y (by omega) hmm.symm
    (Submodule.smul_mono_left (Ideal.pow_le_pow_right (by omega)) h₂)
  have h₄ : (AdicCompletion.map I (smallPullbackLinear g hf) x).val (n + k₀) = 0 := by
    have e : AdicCompletion.map I (smallPullbackLinear g hf) x =
        AdicCompletion.map I (smallFunctionsEquiv g hf).symm.toLinearMap y :=
      (AdicCompletion.map_comp_apply I (pullbackLinear g)
        (smallFunctionsEquiv g hf).symm.toLinearMap x).symm.trans (congrArg _ hyd)
    rw [e]
    exact map_val_eq_zero _ y h₃
  obtain ⟨x', hx', hxx'⟩ := hk₀ n x h₄
  refine ⟨x', mem_map_pow_of_val_eq_zero hx', ?_⟩
  have hm :
      AdicCompletion.map I (pullbackLinear g) x' = AdicCompletion.map I (pullbackLinear g) x :=
    (congr_map_smallPullbackLinear g hf x').symm.trans
      ((congrArg (AdicCompletion.congr I (smallFunctionsEquiv g hf)) hxx').trans
        (congr_map_smallPullbackLinear g hf x))
  exact (towerComparison_map g hf hZI hqc x').symm.trans
    ((congrArg (towerComparison g hf) hm).trans (towerComparison_map g hf hZI hqc x))

end Torsion

