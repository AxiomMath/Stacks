module

public import StacksFrontier.AlgebraicGeometry.Artin.ContractionLimitFormalDictionary
public import StacksFrontier.AlgebraicGeometry.Artin.ContractionClosedImmersionChartAdic
public import StacksFrontier.AlgebraicGeometry.FormalSpace.AdicMorphism
public import StacksFrontier.AlgebraicGeometry.FormalSpace.TautFormalSpectrumRepresentable
public import StacksFrontier.AlgebraicGeometry.FormalSpace.RigSurjectiveClosedImmersionCharts
public import StacksFrontier.AlgebraicGeometry.FormalSpace.RigSurjectiveFaithfullyFlat
public import StacksFrontier.RingTheory.Rig.FlatBaseChangeReduction

/-!
# Adicness of the formal component at a stage

In the last part of the proof of Stacks 0GI5 the formal component at a stage `k` is the morphism
`x̂_k : V_{k,/Z_k} ≅ Spf A_k^∧ ⟶ Spf B ≅ W₀ ⟶ W` built from a continuous ring map
`φ_k : B → A_k^∧` and an étale chart `ω : W₀ ⟶ W`. This file shows that `x̂_k` is adic as soon as
`φ_k` is an adic ring map, and that `φ_k` is adic as soon as `I_k^N A_k^∧` is contained in the
ideal generated by the image of an ideal of definition of `B`.

## Main results

* `AlgebraicGeometry.Artin.FormalDictionary.isAdic_toRingHom_of_pow_le_map`: the ring-theoretic
  criterion for `φ_k` to be adic.
* `AlgebraicGeometry.Artin.FormalDictionary.isAdicMorphism_continuousHomEquiv_comp`: `x̂_k` is
  adic (`Spf` of a taut map is representable by algebraic spaces, Stacks 0AN5).

## References

* [Stacks Project, Tag 0GI5](https://stacks.math.columbia.edu/tag/0GI5)
* [Stacks Project, Tag 0AN5](https://stacks.math.columbia.edu/tag/0AN5)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Artin.FormalDictionary

attribute [local instance] Space.pointTopology

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- The `I`-adic topology on the adic completion `AdicCompletion I A`. -/
local instance instTopologicalSpaceAdicCompletionAux {A : Type u} [CommRing A] (I : Ideal A) :
    TopologicalSpace (AdicCompletion I A) :=
  I.adicModuleTopology (AdicCompletion I A)

variable {V : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj V)]
  [IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)]
  {I : Ideal Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)}
  {Bt : Type u} [CommRing Bt] [TopologicalSpace Bt] [IsTopologicalRing Bt]
  [IsLinearTopology Bt Bt] {DB : FormalSpace.QuotientSystem B S hS Bt}

omit [IsTopologicalRing Bt] [IsLinearTopology Bt Bt] in
/-- A continuous ring map `φ : B → A^∧` is adic as soon as the topology of `B` is `J`-adic and
`I^N A^∧ ⊆ φ(J) A^∧` for some `N`. -/
theorem isAdic_toRingHom_of_pow_le_map
    (φ : FormalSpace.ContinuousHom DB (FormalDictionary.completionQuotientSystem V I))
    {J : Ideal Bt} (hJ : IsAdic J) {N : ℕ}
    (hN : (I.map (algebraMap _ (AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤))))
      ^ N ≤ J.map φ.toRingHom) :
    RingHom.IsAdic φ.toRingHom := by
  obtain ⟨hTR, -, hIadic, -, -⟩ :=
    FormalSpace.adicCompletion_isAdic_of_fg I I.fg_of_isNoetherianRing
  set K := I.map (algebraMap _ (AdicCompletion I Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)))
  have hKopen : IsOpen (SetLike.coe K) := by simpa using (isAdic_iff.mp hIadic).1 1
  have hpre : (φ.toRingHom ⁻¹' (SetLike.coe K)) ∈ nhds (0 : Bt) :=
    φ.continuous.continuousAt.preimage_mem_nhds (by simpa using hKopen.mem_nhds K.zero_mem)
  obtain ⟨n, -, hn⟩ := hJ.hasBasis_nhds_zero.mem_iff.mp hpre
  refine ⟨J, hJ, Rig.isAdic_of_isAdic_of_pow_le_of_pow_le hIadic hN (n := n) ?_⟩
  rw [← Ideal.map_pow, Ideal.map_le_iff_le_comap]
  exact hn

/-- Let `φ : B → A^∧` be a continuous ring map over `S` which is adic, `e : W₀ ≅ Spf B` and
`ω : W₀ ⟶ W` representable étale. Then `V_{/Z} ≅ Spf A^∧ ⟶ Spf B ≅ W₀ ⟶ W` is adic, that is,
representable by algebraic spaces. -/
theorem isAdicMorphism_continuousHomEquiv_comp {Z : Set (Space.points B S hS (yoneda.obj V))}
    (hZI : ∀ x, x ∈ Z ↔ Space.pointsToScheme B S hS V x ∈
      ((BigFppfOver.toScheme B S hS).obj V).zeroLocus
        (I : Set Γ((BigFppfOver.toScheme B S hS).obj V, ⊤)))
    (hB : TopologicalRing.IsWeaklyAdmissible Bt)
    {W₀ W : FormalSpace.FppfSheaf B S hS} (e : W₀ ≅ FormalSpace.formalSpectrum DB) (ω : W₀ ⟶ W)
    (hω : FormalSpace.IsRepresentableEtale B S hS ω)
    (φ : FormalSpace.ContinuousHom DB (FormalDictionary.completionQuotientSystem V I))
    (hφ : RingHom.IsAdic φ.toRingHom) :
    FormalSpace.IsAdicMorphism B S hS (continuousHomEquiv hZI hB φ ≫ e.inv ≫ ω) := by
  obtain ⟨hTR, hLT, -, hAadic, hAw⟩ :=
    FormalSpace.adicCompletion_isAdic_of_fg I I.fg_of_isNoetherianRing
  have hE : (FormalDictionary.completionQuotientSystem V I).HasLargeSite :=
    FormalSpace.hasLargeSite_of_mk_lt_cutoff _
      (FormalSpace.mk_lt_cutoff_of_quotientSystem_of_isAdic (B := B) (S := S) (hS := hS) hAadic
        (FormalDictionary.completionQuotientSystem V I))
  have htaut : RingHom.IsTaut φ.toRingHom := RingHom.isTaut_of_isAdic φ.toRingHom hφ
  have hSpf : FormalSpace.IsAdicMorphism B S hS (FormalSpace.formalSpectrumMap hB φ) :=
    FormalSpace.isRepresentableByAlgebraicSpacesULift_formalSpectrumMap_of_isTaut B S hS hB hAw
      DB _ hE φ htaut
  rw [continuousHomEquiv_apply, Category.assoc]
  have hiso {X Y : FormalSpace.FppfSheaf B S hS} (f : X ⟶ Y) [IsIso f] :=
    FormalSpace.isAdicMorphism_of_isIso B S hS f
  exact .comp B S hS _ _ (hiso _) (.comp B S hS _ _ hSpf (.comp B S hS _ _ (hiso _) hω.1))

end AlgebraicGeometry.Artin.FormalDictionary

end
