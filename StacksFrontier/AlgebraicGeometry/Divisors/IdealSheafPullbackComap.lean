* [Stacks Project, Tag 0C4U](https://stacks.math.columbia.edu/tag/0C4U)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open RingedSpaceModuleAdjunction
open Stacks.RingedSpace (pullbackFunctor pullbackUnit)

universe u

namespace Stacks.Divisors

variable {X Y : Scheme.{u}} (h : Y ⟶ X) (D : X.IdealSheafData)

/-! ### The commutative square of closed subschemes -/

/-- **The commutative square `(h^{-1}D ⊆ Y) → (D ⊆ X)`.** Its lower edge is the restriction of
`h` to the closed subschemes, `AlgebraicGeometry.Scheme.IdealSheafData.subschemeMap`. -/
theorem comap_subschemeι_comm :
    (D.comap h).subschemeι ≫ h =
      Scheme.IdealSheafData.subschemeMap (D.comap h) D h (D.le_map_comap h) ≫ D.subschemeι :=
  (Scheme.IdealSheafData.subschemeMap_subschemeι _ _ _ _).symm

/-- The same commutative square, read on the underlying ringed spaces. Passing to underlying
ringed spaces preserves composition on the nose, so this is the image of
`Stacks.Divisors.comap_subschemeι_comm` under `congrArg`. -/
theorem comap_subschemeι_comm_toShHom :
    (D.comap h).subschemeι.toLRSHom.toShHom ≫ h.toLRSHom.toShHom =
      (Scheme.IdealSheafData.subschemeMap (D.comap h) D h
          (D.le_map_comap h)).toLRSHom.toShHom ≫ D.subschemeι.toLRSHom.toShHom :=
  congrArg (fun p : (D.comap h).subscheme ⟶ X => p.toLRSHom.toShHom)
    (comap_subschemeι_comm h D)

/-! ### The canonical morphism and its compatibility with the inclusions -/

/-- **The canonical morphism `h^* ℐ_D ⟶ ℐ_{h^{-1}D}`.** It is the factorisation through the
kernel defining `ℐ_{h^{-1}D}` of the canonical map `h^* ℐ_D ⟶ 𝒪_Y`, which exists because the
square `(h^{-1}D ⊆ Y) → (D ⊆ X)` commutes. No hypothesis on `h` or on `D` is needed. -/
def pullbackIdealSheafComapMap :
    (pullbackFunctor h.toLRSHom.toShHom).obj (Eta.idealSheaf D) ⟶ Eta.idealSheaf (D.comap h) :=
  Stacks.ClosedImmersion.idealSheafMap (comap_subschemeι_comm_toShHom h D)

/-- **The canonical morphism is compatible with the two inclusions into `𝒪_Y`.** This holds by
construction: the morphism is the factorisation of `Stacks.IdealTorsion.Eta.pullbackIdealIncl`
through the kernel. -/
theorem pullbackIdealSheafComapMap_comp_idealSheafι :
    pullbackIdealSheafComapMap h D ≫ Eta.idealSheafι (D.comap h) =
      Stacks.IdealTorsion.Eta.pullbackIdealIncl h.toLRSHom.toShHom (Eta.idealSheaf D)
        (Eta.idealSheafι D) :=
  Stacks.ClosedImmersion.idealSheafMap_comp_ι (comap_subschemeι_comm_toShHom h D)

/-! ### Local sections of the pullback of the ideal sheaf -/

/-- **A local section of `h^* ℐ_D`, read as a section of `𝒪_Y`** through the canonical map
`Stacks.IdealTorsion.Eta.pullbackIdealIncl`. -/
def pullbackIdealSection (V : Y.Opens)
    (σ : ((pullbackFunctor h.toLRSHom.toShHom).obj (Eta.idealSheaf D)).val.obj (op V)) :
    Γ(Y, V) :=
  Stacks.IdealTorsion.idealSection Y.toRingedSpace
    (Stacks.IdealTorsion.Eta.pullbackIdealIncl h.toLRSHom.toShHom (Eta.idealSheaf D)
      (Eta.idealSheafι D)) (op V) σ

/-- The ambient section of the zero section is zero. -/
theorem pullbackIdealSection_zero (V : Y.Opens) : pullbackIdealSection h D V 0 = 0 :=
  map_zero ((Stacks.IdealTorsion.Eta.pullbackIdealIncl h.toLRSHom.toShHom (Eta.idealSheaf D)
    (Eta.idealSheafι D)).val.app (op V)).hom

/-- The ambient section of a sum is the sum of the ambient sections. -/
theorem pullbackIdealSection_add (V : Y.Opens)
    (σ τ : ((pullbackFunctor h.toLRSHom.toShHom).obj (Eta.idealSheaf D)).val.obj (op V)) :
    pullbackIdealSection h D V (σ + τ) =
      pullbackIdealSection h D V σ + pullbackIdealSection h D V τ :=
  map_add ((Stacks.IdealTorsion.Eta.pullbackIdealIncl h.toLRSHom.toShHom (Eta.idealSheaf D)
    (Eta.idealSheafι D)).val.app (op V)).hom σ τ

/-- The ambient section is `𝒪_Y`-linear. The scalar action is written with
`Stacks.SheafOfModules.smulSectionMap` because the two spellings of the sections of the
structure sheaf do not share instances. -/
theorem pullbackIdealSection_smulSectionMap (V : Y.Opens)
    (σ : ((pullbackFunctor h.toLRSHom.toShHom).obj (Eta.idealSheaf D)).val.obj (op V))
    (c : Γ(Y, V)) :
    pullbackIdealSection h D V (Stacks.SheafOfModules.smulSectionMap
        (𝒪 := Y.sheaf.obj) (h𝒪 := (structureSheafRing Y.toRingedSpace).property) σ c) =
      c * pullbackIdealSection h D V σ :=
  ((Stacks.IdealTorsion.Eta.pullbackIdealIncl h.toLRSHom.toShHom (Eta.idealSheaf D)
    (Eta.idealSheafι D)).val.app (op V)).hom.map_smul c σ

/-- The ambient section commutes with the restriction maps. -/
theorem pullbackIdealSection_res {V W : Y.Opens} (hWV : W ≤ V)
    (σ : ((pullbackFunctor h.toLRSHom.toShHom).obj (Eta.idealSheaf D)).val.obj (op V)) :
    pullbackIdealSection h D W
        ((((pullbackFunctor h.toLRSHom.toShHom).obj (Eta.idealSheaf D)).val.map
          (homOfLE hWV).op).hom σ) =
      Y.presheaf.map (homOfLE hWV).op (pullbackIdealSection h D V σ) :=
  PresheafOfModules.naturality_apply
    (Stacks.IdealTorsion.Eta.pullbackIdealIncl h.toLRSHom.toShHom (Eta.idealSheaf D)
      (Eta.idealSheafι D)).val (homOfLE hWV).op σ

/-- **The ambient section of a pullback-unit image.** The unit of `h^* ⊣ h_*` carries a section
of `ℐ_D` over `U` to a section of `h^* ℐ_D` over `h^{-1}U`, and its ambient section is the image
of the original ambient section under `h^♯`. -/
theorem pullbackIdealSection_pullbackUnit (U : X.Opens)
    (e : (Eta.idealSheaf D).val.obj (op U)) :
    pullbackIdealSection h D (h ⁻¹ᵁ U)
        (pullbackUnit h.toLRSHom.toShHom (Eta.idealSheaf D) (op U) e) =
      (h.app U).hom (idealSheafSection D e) :=
  Stacks.IdealTorsion.Eta.idealSection_pullbackIdealIncl h.toLRSHom.toShHom
    (Eta.idealSheaf D) (Eta.idealSheafι D) (op U) e

/-- **The ambient section of a restricted pullback-unit image.** This is
`Stacks.Divisors.pullbackIdealSection_pullbackUnit` followed by
`Stacks.Divisors.pullbackIdealSection_res`, with `h^♯` on `U` followed by restriction to `V`
read as `AlgebraicGeometry.Scheme.Hom.appLE`. -/
theorem pullbackIdealSection_res_pullbackUnit (U : X.Opens) (V : Y.Opens)
    (hVU : V ≤ h ⁻¹ᵁ U) (e : (Eta.idealSheaf D).val.obj (op U)) :
    pullbackIdealSection h D V
        ((((pullbackFunctor h.toLRSHom.toShHom).obj (Eta.idealSheaf D)).val.map
            (homOfLE hVU).op).hom
          (pullbackUnit h.toLRSHom.toShHom (Eta.idealSheaf D) (op U) e)) =
      (h.appLE U V hVU).hom (idealSheafSection D e) :=
  (pullbackIdealSection_res h D hVU
      (pullbackUnit h.toLRSHom.toShHom (Eta.idealSheaf D) (op U) e)).trans
    (congrArg (fun y => Y.presheaf.map (homOfLE hVU).op y)
      (pullbackIdealSection_pullbackUnit h D U e))

/-! ### The chart-level surjectivity -/

/-- **The chart-level surjectivity.** Let `U` be an affine open of the target and `V` an affine
open of the source contained in `h^{-1}U`. Then every element of the ideal that `h^{-1}D` cuts
out on `V` is the ambient section of a local section of `h^* ℐ_D` over `V`.

The ambient sections of `h^* ℐ_D` over `V` form an ideal of `Γ(Y, V)`, and by
`Stacks.IdealSheaf.ideal_comap_appLE` the ideal `(D.comap h).ideal V` is generated by the images
of the elements of `D.ideal U`, each of which is such an ambient section by
`Stacks.Divisors.mem_ideal_iff_exists_idealSheafSection` together with
`Stacks.Divisors.pullbackIdealSection_pullbackUnit`. -/
theorem exists_pullbackIdealSection (U : X.affineOpens) (V : Y.affineOpens)
    (hVU : (V : Y.Opens) ≤ h ⁻¹ᵁ (U : X.Opens)) (r : Γ(Y, (V : Y.Opens)))
    (hr : r ∈ (D.comap h).ideal V) :
    ∃ σ, pullbackIdealSection h D (V : Y.Opens) σ = r := by
  have hgen : ∀ a ∈ D.ideal U, ∃ σ, pullbackIdealSection h D (V : Y.Opens) σ =
      (h.appLE (U : X.Opens) (V : Y.Opens) hVU).hom a := by
    intro a ha
    obtain ⟨e, he⟩ := (mem_ideal_iff_exists_idealSheafSection D U a).1 ha
    exact ⟨_, (pullbackIdealSection_res_pullbackUnit h D (U : X.Opens) (V : Y.Opens) hVU e).trans
      (congrArg (fun y => (h.appLE (U : X.Opens) (V : Y.Opens) hVU).hom y) he)⟩
  let T : Ideal Γ(Y, (V : Y.Opens)) :=
    { carrier := {s | ∃ σ, pullbackIdealSection h D (V : Y.Opens) σ = s}
      zero_mem' := ⟨0, pullbackIdealSection_zero h D _⟩
      add_mem' := fun ⟨σ, hσ⟩ ⟨τ, hτ⟩ =>
        ⟨σ + τ, by rw [pullbackIdealSection_add, hσ, hτ]⟩
      smul_mem' := fun c _ ⟨σ, hσ⟩ =>
        ⟨Stacks.SheafOfModules.smulSectionMap (𝒪 := Y.sheaf.obj)
            (h𝒪 := (structureSheafRing Y.toRingedSpace).property) σ c,
          by rw [pullbackIdealSection_smulSectionMap, hσ, smul_eq_mul]⟩ }
  rw [Stacks.IdealSheaf.ideal_comap_appLE D h U V hVU] at hr
  exact (show _ ≤ T from Ideal.map_le_iff_le_comap.2 hgen) hr

/-! ### Surjectivity, and the isomorphism -/

/-- **The ambient section computes the canonical morphism.** Composing the canonical morphism
with the inclusion of `ℐ_{h^{-1}D}` gives the canonical map `h^* ℐ_D ⟶ 𝒪_Y`, so on sections the
ambient section of the image is the ambient section of the pullback. -/
theorem idealSheafSection_pullbackIdealSheafComapMap (V : Y.Opens)
    (σ : ((pullbackFunctor h.toLRSHom.toShHom).obj (Eta.idealSheaf D)).val.obj (op V)) :
    idealSheafSection (D.comap h) ((pullbackIdealSheafComapMap h D).val.app (op V) σ) =
      pullbackIdealSection h D V σ :=
  congrArg
    (fun m : (pullbackFunctor h.toLRSHom.toShHom).obj (Eta.idealSheaf D) ⟶
        SheafOfModules.unit (structureSheafRing Y.toRingedSpace) => m.val.app (op V) σ)
    (pullbackIdealSheafComapMap_comp_idealSheafι h D)

/-- **The canonical morphism `h^* ℐ_D ⟶ ℐ_{h^{-1}D}` is an epimorphism**, for an arbitrary
morphism of schemes and an arbitrary closed subscheme.

A morphism of sheaves of modules is an epimorphism exactly when it is locally surjective. Near a
point of the source, choose an affine open `U` of the target containing its image and an affine
open `V` of the source inside the given open and inside `h^{-1}U`; the ambient section of the
given local section restricted to `V` lies in `(D.comap h).ideal V`, so
`Stacks.Divisors.exists_pullbackIdealSection` produces a preimage of its ambient section, and
the inclusion of the ideal sheaf being injective on sections makes that a preimage of the
section itself. -/
@[ega "I 10.10.9" "Discrete case of 10.10.9", sga "3 III 0.1.4" "special case"]
theorem epi_pullbackIdealSheafComapMap : Epi (pullbackIdealSheafComapMap h D) := by
  refine Stacks.SheafOfModules.EpiMono.epi_of_isLocallySurjective _
    ((TopCat.Presheaf.isLocallySurjective_iff _).2 ?_)
  intro W t x hx
  obtain ⟨U, hxU⟩ := exists_affineOpens_mem (h.base x)
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVsub⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open
      (show x ∈ W ⊓ h ⁻¹ᵁ (U : X.Opens) from ⟨hx, hxU⟩)
      (W ⊓ h ⁻¹ᵁ (U : X.Opens)).isOpen
  have hVW : V ≤ W := fun y hy => (hVsub hy).1
  have hVU : V ≤ h ⁻¹ᵁ (U : X.Opens) := fun y hy => (hVsub hy).2
  have hsmem : idealSheafSection (D.comap h) (V := V)
      (((Eta.idealSheaf (D.comap h)).val.map (homOfLE hVW).op).hom t) ∈
      (D.comap h).ideal ⟨V, hV⟩ :=
    (mem_ideal_iff_exists_idealSheafSection (D.comap h) ⟨V, hV⟩ _).2 ⟨_, rfl⟩
  obtain ⟨σ, hσ⟩ := exists_pullbackIdealSection h D U ⟨V, hV⟩ hVU _ hsmem
  exact ⟨V, hVW, ⟨σ, idealSheafSection_injective (D.comap h) (V := V)
    ((idealSheafSection_pullbackIdealSheafComapMap h D V σ).trans hσ)⟩, hxV⟩

variable [IsEffectiveCartierDivisor D]

/-- The pullback of the ideal sheaf of an effective Cartier divisor is invertible: this is
[Stacks, Tag 0B8L], restated at the spelling of the structure sheaf that
`Stacks.SheafOfModules.isIso_of_epi_of_isInvertible` consumes. -/
theorem isInvertible_pullbackFunctor_obj_idealSheaf :
    Stacks.SheafOfModules.IsInvertible Y.presheaf
      (structureSheafRing Y.toRingedSpace).property
      ((pullbackFunctor h.toLRSHom.toShHom).obj (Eta.idealSheaf D)) :=
  Stacks.IdealTorsion.Eta.isInvertible_pullbackIdeal h.toLRSHom.toShHom (Eta.idealSheaf D)

/-- The ideal sheaf of an effective Cartier divisor is invertible, at the spelling of the
structure sheaf that `Stacks.SheafOfModules.isIso_of_epi_of_isInvertible` consumes. -/
theorem isInvertible_idealSheaf' :
    Stacks.SheafOfModules.IsInvertible X.presheaf
      (structureSheafRing X.toRingedSpace).property
      (Eta.idealSheaf D) :=
  Stacks.Divisors.Eta.isInvertible_idealSheaf D

/-- **The canonical morphism `h^* ℐ_D ⟶ ℐ_{h^{-1}D}` is an isomorphism** when `D` and its
inverse image are effective Cartier divisors: it is an epimorphism between invertible sheaves of
modules. -/
theorem isIso_pullbackIdealSheafComapMap (hD : IsPullbackDefined h D) :
    IsIso (pullbackIdealSheafComapMap h D) :=
  have : IsEffectiveCartierDivisor (D.comap h) := hD
  @Stacks.SheafOfModules.isIso_of_epi_of_isInvertible Y.toRingedSpace _ _
    (pullbackIdealSheafComapMap h D) (epi_pullbackIdealSheafComapMap h D)
    (isInvertible_pullbackFunctor_obj_idealSheaf h D)
    (isInvertible_idealSheaf' (D.comap h))

/-- **`h^* ℐ_D ≅ ℐ_{h^{-1}D}`.** The pullback of the ideal sheaf of an effective Cartier divisor
whose pullback is defined is the ideal sheaf of the inverse image. No flatness is needed: the
hypothesis is exactly that `h^{-1}D` is again an effective Cartier divisor. -/
def pullbackIdealSheafComapIso (hD : IsPullbackDefined h D) :
    (pullbackFunctor h.toLRSHom.toShHom).obj (Eta.idealSheaf D) ≅ Eta.idealSheaf (D.comap h) :=
  haveI := isIso_pullbackIdealSheafComapMap h D hD
  asIso (pullbackIdealSheafComapMap h D)

/-- **The isomorphism `h^* ℐ_D ≅ ℐ_{h^{-1}D}` is compatible with the two inclusions into
`𝒪_Y`.** Composed with the inclusion of `ℐ_{h^{-1}D}` it is the canonical map `h^* ℐ_D ⟶ 𝒪_Y`
of `Stacks.IdealTorsion.Eta.pullbackIdealIncl`. -/
theorem pullbackIdealSheafComapIso_hom_comp_idealSheafι (hD : IsPullbackDefined h D) :
    (pullbackIdealSheafComapIso h D hD).hom ≫ Eta.idealSheafι (D.comap h) =
      Stacks.IdealTorsion.Eta.pullbackIdealIncl h.toLRSHom.toShHom (Eta.idealSheaf D)
        (Eta.idealSheafι D) :=
  pullbackIdealSheafComapMap_comp_idealSheafι h D

end Stacks.Divisors

end
