module

public import StacksFrontier.AlgebraicGeometry.Divisors.EtaDerivedBerthelotOgus
public import StacksFrontier.Homology.Eta.RestrictScalars

/-!
# The derived décalage of a sheafified complex on `Spec R`, over the ring `R` itself

Let `R` be a ring and let `D ⊆ Spec R` be an effective Cartier divisor cut out by an element
`f ∈ R`: the ideal of `D` over `Spec R` is generated by the image of `f` in `Γ(Spec R, ⊤)`.  For a
complex `M^•` of `R`-modules on whose terms `f` acts injectively, the derived décalage of
[Stacks, Tag 0F8Q] of the sheafified complex is the sheafified décalage of More on Algebra,
[Stacks, Tag 0F7N]:

`Lη_I (M̃^•) ≅ (η_f M^•)^~`

in `D(𝒪_{Spec R})`.  This is the second assertion of [Stacks, Tag 0GTV], evaluated at an object
and read over the ring `R` rather than over the ring `Γ(Spec R, ⊤)` of global functions at which
`Stacks.Divisors.Eta.derivedEtaAffineComparison` is stated: the two rings are identified by
`AlgebraicGeometry.Scheme.ΓSpecIso`, and the décalage is transported across that identification by
`EtaComplex.etaObjectRestrictScalarsIso`.

## Main results

* `Stacks.Divisors.Eta.nonempty_derivedEta_tilde_iso`: `Lη_I (M̃^•) ≅ (η_f M^•)^~`.

## Implementation notes

The derived categories are the standard models, which is where the derived décalage
`Stacks.Divisors.Eta.derivedEtaData` is constructed; they are installed by `letI` in the
statement.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite

universe u

namespace Stacks.Divisors.Eta

variable (R : CommRingCat.{u})

/-- Restricting scalars from `R` to `Γ(Spec R, ⊤)` and back is the identity. -/
def gammaRestrictCancelModule (N : ModuleCat.{u} R) :
    (gammaRestrict R).obj ((ModuleCat.restrictScalars (Scheme.ΓSpecIso R).hom.hom).obj N) ≅ N :=
  (ModuleCat.restrictScalarsComp'App (Scheme.ΓSpecIso R).inv.hom (Scheme.ΓSpecIso R).hom.hom
      (RingHom.id R) (by rw [← CommRingCat.hom_comp, Iso.inv_hom_id]; rfl) N).symm ≪≫
    ModuleCat.restrictScalarsId'App (RingHom.id R) rfl N

/-- Sheafifying a complex of `R`-modules read over `Γ(Spec R, ⊤)` is sheafifying it over `R`. -/
def tildeComplexRestrictScalarsIso (X : CochainComplex (ModuleCat.{u} R) ℤ) :
    (tildeComplexFunctor R).obj
        (((ModuleCat.restrictScalars (Scheme.ΓSpecIso R).hom.hom).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj X) ≅
      ((tilde.functor R).mapHomologicalComplex (ComplexShape.up ℤ)).obj X :=
  HomologicalComplex.Hom.isoOfComponents
    (fun i => (tilde.functor R).mapIso (gammaRestrictCancelModule R (X.X i))) (by
      intro i j _
      change (tilde.functor R).map _ ≫ (tilde.functor R).map _ =
        (tilde.functor R).map _ ≫ (tilde.functor R).map _
      rw [← Functor.map_comp, ← Functor.map_comp]
      congr 1)

/-- **The derived décalage of a sheafified complex is the sheafified décalage.**  Let
`D ⊆ Spec R` be an effective Cartier divisor whose ideal over `Spec R` is generated by the image
in `Γ(Spec R, ⊤)` of `f ∈ R`, and let `M^•` be a complex of `R`-modules on whose terms `f` acts
injectively.  Then `Lη_I (M̃^•) ≅ (η_f M^•)^~` in `D(𝒪_{Spec R})`.

The complex `M^•`, read over `Γ(Spec R, ⊤)`, is a complex of modules torsion-free for a global
generator of the ideal sheaf; there `Lη_I` is computed by the chain-level décalage of the
sheafified complex (`derivedEtaTildeFactors`, from [Stacks, Tag 0F8Q]), which is the sheafified
décalage of modules (`etaTildeChainIsoApp`, from [Stacks, Tag 0F8M]); and the décalage over
`Γ(Spec R, ⊤)` is the décalage over `R`, read over `Γ(Spec R, ⊤)`
(`EtaComplex.etaObjectRestrictScalarsIso`). -/
theorem nonempty_derivedEta_tilde_iso (D : (Spec R).IdealSheafData)
    [Stacks.Divisors.IsEffectiveCartierDivisor D] (f : R)
    (hD : D.ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ = Ideal.span {(Scheme.ΓSpecIso R).inv f})
    (M : CochainComplex (ModuleCat.{u} R) ℤ) (hM : ∀ n : ℤ, IsSMulRegular (M.X n) f) :
    letI := HasDerivedCategory.standard (Spec R).Modules
    letI := HasDerivedCategory.standard (ModuleCat.{u} R)
    Nonempty ((derivedEtaData D).functor.obj
        ((tilde.functor R).mapDerivedCategory.obj (DerivedCategory.Q.obj M)) ≅
      (tilde.functor R).mapDerivedCategory.obj
        (DerivedCategory.Q.obj (EtaComplex.etaObject f M))) := by
  let := HasDerivedCategory.standard (Spec R).Modules
  let := HasDerivedCategory.standard (ModuleCat.{u} R)
  let := HasDerivedCategory.standard (ModuleCat.{u} (GammaTop R))
  let : Algebra (GammaTop R) R := (Scheme.ΓSpecIso R).hom.hom.toAlgebra
  have hreg := mem_nonZeroDivisors_of_ideal_top_eq_span R D hD
  obtain ⟨g, hg, hgf⟩ := exists_generatesIdealOn_of_ideal_eq_span D ⟨⊤, isAffineOpen_top _⟩ hD hreg
  have hgen : algebraMap (GammaTop R) R (globalGenerator R D g) = f := by
    change (Scheme.ΓSpecIso R).hom.hom (globalGenerator R D g) = f
    rw [show globalGenerator R D g = (Scheme.ΓSpecIso R).inv f from hgf, ← CommRingCat.comp_apply,
      Iso.inv_hom_id]
    rfl
  let M' := (EtaComplex.restrictScalarsComplex (A := GammaTop R)).obj M
  have htf : ∀ n : ℤ,
      Stacks.Eta.DerivedFunctor.isFTorsionFree (globalGenerator R D g) (M'.X n) := by
    intro n x hx
    change algebraMap (GammaTop R) R (globalGenerator R D g) • (show M.X n from x) =
      (0 : M.X n) at hx
    rw [hgen] at hx
    exact hM n (hx.trans (smul_zero f).symm)
  let M'' : CochainComplex (Stacks.Eta.DerivedFunctor.FTorsionFreeModule
      (globalGenerator R D g)) ℤ := HomologicalComplex.liftObjectProperty _ M' htf
  have e₁ := (derivedEtaTildeFactors R D g).app M''
  have e₂ := etaTildeChainIsoApp R D g hg M''
  have e₃ := EtaComplex.etaObjectRestrictScalarsIso (A := GammaTop R) (globalGenerator R D g) M
  have e₄ : EtaComplex.etaObject (algebraMap (GammaTop R) R (globalGenerator R D g)) M ≅
      EtaComplex.etaObject f M := eqToIso (by rw [hgen])
  exact ⟨(derivedEtaData D).functor.mapIso ((tilde.functor R).mapDerivedCategoryFactors.app M ≪≫
      (DerivedCategory.Q (C := (Spec R).Modules)).mapIso
        (tildeComplexRestrictScalarsIso R M).symm ≪≫
      ((derivedTildeGammaFactors R).app M').symm) ≪≫ e₁ ≪≫
    (DerivedCategory.Q (C := (Spec R).Modules)).mapIso (e₂ ≪≫ (tildeComplexFunctor R).mapIso
      (e₃ ≪≫ (EtaComplex.restrictScalarsComplex (A := GammaTop R)).mapIso e₄) ≪≫
      tildeComplexRestrictScalarsIso R (EtaComplex.etaObject f M)) ≪≫
    ((tilde.functor R).mapDerivedCategoryFactors.app (EtaComplex.etaObject f M)).symm⟩

end Stacks.Divisors.Eta

end
