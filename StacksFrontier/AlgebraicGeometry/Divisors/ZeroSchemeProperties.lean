module

public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartier
public import StacksFrontier.AlgebraicGeometry.Divisors.ZeroSchemeData

/-!
# Properties of the zero scheme of a section of an invertible sheaf

This file records the clauses of [Stacks, Tag 02OR](https://stacks.math.columbia.edu/tag/02OR)
about the zero scheme `AlgebraicGeometry.zeroScheme` of a global section `s` of an invertible
module `L` on a scheme `X`.

## Main results

* `AlgebraicGeometry.zeroScheme_ideal_of_trivialization`: on an affine open where `L` is
  trivialized, the defining ideal of the zero scheme is generated by the single function
  representing `s` there. This is the local equation of the zero scheme, and it is what every
  local argument about `Z(s)` goes through.
* `AlgebraicGeometry.isLocallyPrincipal_zeroScheme`: **Tag 02OR (3)**, the zero scheme is a
  locally principal closed subscheme.

## Implementation notes

The local equation is immediate from `AlgebraicGeometry.zeroScheme_ideal`: under a
trivialization `e : Γ(L, U) ≃ₗ[Γ(X, U)] Γ(X, U)` the functionals on `Γ(L, U)` are exactly the
multiples of `e`, so the ideal of their values at `s|_U` is the principal ideal generated by
`e (s|_U)`.

For local principality the trivializing opens are produced by
`AlgebraicGeometry.exists_basicOpen_linearEquiv`, which gives a *basic* open of a chosen affine
open, hence an affine open, with the trivialization already in the form of a linear equivalence
on sections, so no comparison built by hand out of `IsFiniteLocallyFreeOfRank`-data and the
free-sheaf comparison is needed.

## References

* [Stacks Project, Tag 02OR](https://stacks.math.columbia.edu/tag/02OR)
* [Stacks Project, Tag 01WR](https://stacks.math.columbia.edu/tag/01WR)
-/

@[expose] public section

open CategoryTheory TopologicalSpace Opposite

universe u

namespace AlgebraicGeometry

/-- **The local equation of the zero scheme.** On an affine open where the invertible module is
trivialized, the defining ideal of the zero scheme is generated by the function representing the
section. -/
theorem zeroScheme_ideal_of_trivialization (X : Scheme.{u}) (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : Γ(L, ⊤)) (U : X.affineOpens)
    (e : Γ(L, U.1) ≃ₗ[Γ(X, U.1)] Γ(X, U.1)) (a : Γ(X, U.1))
    (he : e (L.presheaf.map (homOfLE le_top).op s) = a) :
    (zeroScheme X L s).ideal U = Ideal.span ({a} : Set Γ(X, U.1)) := by
  rw [zeroScheme_ideal]
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro x ⟨φ, rfl⟩
    have hφ : φ (L.presheaf.map (homOfLE le_top).op s) = a * φ (e.symm 1) := by
      calc φ (L.presheaf.map (homOfLE le_top).op s)
          = φ (e.symm (e (L.presheaf.map (homOfLE le_top).op s))) := by
            rw [e.symm_apply_apply]
        _ = φ (e.symm (a • (1 : Γ(X, U.1)))) := by
            rw [he]
            congr 1
            simp
        _ = φ (a • e.symm 1) := by rw [map_smul]
        _ = a • φ (e.symm 1) := by rw [map_smul]
        _ = a * φ (e.symm 1) := smul_eq_mul _ _
    exact hφ ▸ Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
  · intro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    exact Ideal.subset_span ⟨e.toLinearMap, he.symm⟩

/-- **Stacks Tag 02OR (3).** The zero scheme of a global section of an invertible module is a
locally principal closed subscheme: on the trivializing opens its ideal is generated by the one
function representing the section. -/
@[stacks 02OR "locally_principal"]
theorem isLocallyPrincipal_zeroScheme (X : Scheme.{u}) (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : Γ(L, ⊤)) : Stacks.Divisors.IsLocallyPrincipal (zeroScheme X L s) := by
  intro x
  obtain ⟨U, hxU⟩ := Stacks.Divisors.exists_affineOpens_mem x
  obtain ⟨g, hxg, -, ⟨e⟩⟩ := exists_basicOpen_linearEquiv L U x hxU
  refine ⟨⟨X.basicOpen g, U.2.basicOpen g⟩, hxg, ?_⟩
  rw [zeroScheme_ideal_of_trivialization X L s ⟨X.basicOpen g, U.2.basicOpen g⟩ e _ rfl]
  exact ⟨_, rfl⟩

end AlgebraicGeometry

end
