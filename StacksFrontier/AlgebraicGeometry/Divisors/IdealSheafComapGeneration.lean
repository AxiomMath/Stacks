module

public import StacksFrontier.AlgebraicGeometry.Divisors.IdealSheafPullbackComap
public import StacksFrontier.AlgebraicGeometry.FlatBaseChange.GlobalGeneration
public import StacksFrontier.AlgebraicGeometry.ResolutionsAndBounds.FiniteTypeGeneration
public import StacksFrontier.AlgebraicGeometry.Scheme.Immersion.IdealSheafQuasicoherent

/-!
# The module-level ideal sheaf of an inverse-image ideal sheaf is globally generated

Let `h : Y ⟶ X` be a morphism of schemes with `X` affine and let `D` be a sheaf of ideals on
`X`. Then the sheaf of `𝒪_Y`-modules `ℐ_{h^{-1}D}` cut out by the inverse-image ideal sheaf
`D.comap h` is generated by its global sections.

The chain is short, and every link already exists:

* `ℐ_D` is quasi-coherent (`Stacks.ClosedImmersion.isQuasicoherent_idealSheaf`, [Stacks,
  Tag 01IN]), and a quasi-coherent module on an affine scheme is generated by its global
  sections (`AlgebraicGeometry.generatingSectionsOfIsAffine`);
* global generation is preserved by pullback, the pullback functor being a left adjoint
  carrying the structure sheaf to the structure sheaf
  (`Stacks.SheafOfModules.modulePullbackGeneratingSections`);
* the canonical map `h^* ℐ_D ⟶ ℐ_{h^{-1}D}` is an epimorphism, for an arbitrary morphism of
  schemes and an arbitrary closed subscheme
  (`Stacks.Divisors.epi_pullbackIdealSheafComapMap`), and global generation passes along an
  epimorphism (`SheafOfModules.GeneratingSections.ofEpi`).

This is the global generation of `I𝒪_X` that part (3) of [Stacks, Tag 0AGS] consumes in the
form of a `SheafOfModules.GeneratingSections`: it discharges the hypothesis `hH1` of
`Stacks.Blowup.Colength.length_globalSections_lt_length_quotient` (in
`AlgebraicGeometry.isZero_hgroup_one_idealSheaf_comap_blowUp`), and it is the global generation
of `𝓘` behind
`RationalSingularitySituation.isZero_firstCohomology_exceptionalIdealPow_unconditional`, in the
namespace `AlgebraicGeometry`.

## Main results

* `Stacks.Divisors.nonempty_generatingSections_idealSheaf_comap` — global generation of
  `ℐ_{h^{-1}D}` over an affine base.
* `Stacks.Divisors.nonempty_generatingSections_idealSheaf_comap_ofIdealTop` — the same for the
  inverse image of an ideal of the base ring.

## Implementation notes

The three spellings of the sheaf of rings on a scheme — `X.ringCatSheaf`, which indexes
`AlgebraicGeometry.Scheme.Modules`; `RingedSpaceModuleAdjunction.structureSheafRing
X.toRingedSpace`, at which `Stacks.SheafOfModules.modulePullbackGeneratingSections` is stated;
and `Stacks.SheafOfModules.Tensor.ringSheaf`, at which `Stacks.Divisors.Eta.idealSheaf` is
stated — are equal by `rfl` but do not share an instance key. The two `GeneratingSections`
terms are therefore built with their module arguments given explicitly, so that elaboration
crosses the spellings by unification rather than by instance search.

## References

* [Stacks Project, Tag 0AGS](https://stacks.math.columbia.edu/tag/0AGS)
* [Stacks Project, Tag 01IN](https://stacks.math.columbia.edu/tag/01IN)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open RingedSpaceModuleAdjunction

universe u

namespace Stacks.Divisors

variable {X Y : Scheme.{u}} (h : Y ⟶ X) (D : X.IdealSheafData)

/-- **The module-level ideal sheaf of a closed subscheme of an affine scheme is generated by its
global sections.** It is quasi-coherent by [Stacks, Tag 01IN], and a quasi-coherent module on an
affine scheme is generated by its global sections. -/
public theorem nonempty_generatingSections_idealSheaf [IsAffine X] :
    Nonempty (Eta.idealSheaf D).GeneratingSections := by
  have hci : Stacks.ClosedImmersion.IsClosedImmersion D.subschemeι.toLRSHom.toShHom :=
    ((Stacks.AlgebraicGeometry.ClosedImmersionTFAE.closedImmersion_tfae D.subschemeι).out 1 6).mp
      (inferInstance : IsClosedImmersion D.subschemeι)
  have hqc : (Eta.idealSheaf D).IsQuasicoherent :=
    Stacks.ClosedImmersion.isQuasicoherent_idealSheaf _ _ D.subschemeι.toLRSHom
  -- the quasi-coherence is handed over positionally: the two spellings of the sheaf of rings
  -- give `IsQuasicoherent` two instance keys, so a search for it from here does not find `hqc`.
  exact ⟨@AlgebraicGeometry.generatingSectionsOfIsAffine X ‹_› (Eta.idealSheaf D) hqc⟩

/-- **The module-level ideal sheaf of an inverse-image ideal sheaf over an affine base is
generated by its global sections.** The ideal sheaf on the affine base is globally generated,
global generation is preserved by pullback, and the canonical map from the pullback onto the
ideal sheaf of the inverse image is an epimorphism.

This is the global generation that part (3) of [Stacks, Tag 0AGS] consumes. -/
public theorem nonempty_generatingSections_idealSheaf_comap [IsAffine X] :
    Nonempty (Eta.idealSheaf (D.comap h)).GeneratingSections := by
  obtain ⟨σ⟩ := nonempty_generatingSections_idealSheaf D
  -- the epimorphism is handed over positionally, for the same reason.
  exact ⟨@SheafOfModules.GeneratingSections.ofEpi _ _ _ _ _ _ _ _
    (Stacks.SheafOfModules.modulePullbackGeneratingSections h.toLRSHom.toShHom
      (Eta.idealSheaf D) σ)
    (pullbackIdealSheafComapMap h D) (epi_pullbackIdealSheafComapMap h D)⟩

/-- **The module-level ideal sheaf of `I𝒪_Y` is generated by its global sections**, for `I` an
ideal of the ring of functions of an affine base. This is the form in which part (3) of
[Stacks, Tag 0AGS] asks for it. -/
public theorem nonempty_generatingSections_idealSheaf_comap_ofIdealTop
    {A : Type u} [CommRing A] (g : Y ⟶ Spec (.of A)) (I : Ideal A) :
    Nonempty (Eta.idealSheaf ((Scheme.IdealSheafData.ofIdealTop
      (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap g)).GeneratingSections :=
  nonempty_generatingSections_idealSheaf_comap g _

end Stacks.Divisors

end
