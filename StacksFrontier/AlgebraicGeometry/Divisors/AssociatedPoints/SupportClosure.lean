* [Stacks Project, Tag 0B3L](https://stacks.math.columbia.edu/tag/0B3L)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace

universe u

namespace AlgebraicGeometry

/-- Over a Noetherian ring, the annihilator of a nonzero element of a module is contained in an
associated prime of that module.

The cyclic submodule generated by the element is a nonzero finite module, so the annihilator of
*it* — which is the annihilator of the element — is a proper ideal and has a minimal prime, and
a minimal prime of the annihilator of a finite module is an associated prime of it. Associated
primes only grow along an injection, so it is an associated prime of the ambient module. -/
theorem exists_mem_associatedPrimes_annihilator_le {R M : Type*} [CommRing R]
    [IsNoetherianRing R] [AddCommGroup M] [Module R M] {m : M} (hm : m ≠ 0) :
    ∃ p ∈ associatedPrimes R M, ∀ r : R, r • m = 0 → r ∈ p := by
  have hsmul : ∀ r : R, r • m = 0 → r ∈ Module.annihilator R (Submodule.span R {m}) := by
    intro r hr
    refine Module.mem_annihilator.2 fun n => Subtype.ext ?_
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.1 n.2
    have hn : r • (n : M) = 0 := by rw [← hc, smul_comm, hr, smul_zero]
    simpa using hn
  have hann : Module.annihilator R (Submodule.span R {m}) ≠ ⊤ := by
    intro htop
    have h1 : (1 : R) ∈ Module.annihilator R (Submodule.span R {m}) := htop ▸ Submodule.mem_top
    have h2 := Module.mem_annihilator.1 h1 ⟨m, Submodule.mem_span_singleton_self m⟩
    exact hm (by simpa using congrArg Subtype.val h2)
  obtain ⟨⟨q, hq⟩⟩ := Ideal.nonempty_minimalPrimes hann
  exact ⟨q, associatedPrimes.subset_of_injective
    (Submodule.injective_subtype (Submodule.span R {m}))
    (Module.associatedPrimes.minimalPrimes_annihilator_subset_associatedPrimes _ _ hq),
    fun r hr => hq.1.2 (hsmul r hr)⟩

/-- On an affine open of a scheme, a point whose corresponding prime is contained in the prime
corresponding to another point specializes to that point: the inclusion of primes is a
specialization in the spectrum, and `IsAffineOpen.fromSpec` is continuous. -/
@[ega "I 1.1.7" "partial"]
theorem specializes_of_primeIdealOf_le {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U)
    {x y : X} (hx : x ∈ U) (hy : y ∈ U)
    (h : hU.primeIdealOf ⟨x, hx⟩ ≤ hU.primeIdealOf ⟨y, hy⟩) :
    x ⤳ y := by
  have hsp := ((PrimeSpectrum.le_iff_specializes _ _).mp h).map hU.fromSpec.continuous
  rwa [hU.fromSpec_primeIdealOf, hU.fromSpec_primeIdealOf] at hsp

/-- The point of an affine open corresponding to a prime of its ring of functions. -/
private noncomputable def pointOfPrime {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U)
    (p : PrimeSpectrum Γ(X, U)) : U :=
  hU.isoSpec.inv p

/-- The prime corresponding to the point attached to a prime is that prime again. -/
private theorem primeIdealOf_pointOfPrime {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U)
    (p : PrimeSpectrum Γ(X, U)) :
    hU.primeIdealOf (pointOfPrime hU p) = p := by
  change (hU.isoSpec.inv ≫ hU.isoSpec.hom) p = p
  rw [hU.isoSpec.inv_hom_id]
  rfl

/-- An associated prime of the module of sections over an affine open is the prime of an
associated point of the sheaf lying in that open. -/
private theorem exists_isAssociatedPoint_of_mem_associatedPrimes {X : Scheme.{u}}
    [IsLocallyNoetherian X] (F : X.Modules) [F.IsQuasicoherent] {U : X.Opens}
    (hU : IsAffineOpen U) [IsNoetherianRing Γ(X, U)] {q : Ideal Γ(X, U)}
    (hq : q ∈ associatedPrimes Γ(X, U) Γ(F, U)) :
    ∃ (z : X) (hz : z ∈ U), z ∈ Stacks.Divisors.associatedPoints F ∧
      (hU.primeIdealOf ⟨z, hz⟩).asIdeal = q := by
  let Q : PrimeSpectrum Γ(X, U) := ⟨q, IsAssociatedPrime.isPrime hq⟩
  let z := pointOfPrime hU Q
  have hzU : (z : X) ∈ U := z.2
  have hpz : hU.primeIdealOf ⟨(z : X), hzU⟩ = Q := primeIdealOf_pointOfPrime hU Q
  refine ⟨(z : X), hzU, ?_, congrArg PrimeSpectrum.asIdeal hpz⟩
  refine (isAssociatedPrime_sections_iff_isAssociatedPoint_of_isLocallyNoetherian F U hU hzU).1 ?_
  rw [hpz]
  exact (isAssociatedPrimeStacks_iff_mem_associatedPrimes q).2 hq

/-- **The support of a coherent module is the closure of its associated points.** For a
quasi-coherent module of finite type on a locally Noetherian scheme, the support is the closure
of the set of associated points.

The associated points lie in the support (Stacks tag 05AD) and the support is closed (Stacks
tag 056J), which gives one inclusion. For the other, read a point `x` of the support on an
affine open `W`: the support of `F` there is the zero locus of the annihilator of `Γ(F, W)`, so
that annihilator has a minimal prime `q` inside the prime of `x`, and a minimal prime of the
annihilator of a finite module is an associated prime. The point of `W` corresponding to `q` is
therefore an associated point of `F` (Stacks tag 05AH read through tag 02OK) specializing to
`x`. -/
@[sga "2 III 1.2" "more general"]
theorem supp_eq_closure_associatedPoints {X : Scheme.{u}} [IsLocallyNoetherian X]
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    SheafOfModules.supp F = closure (Stacks.Divisors.associatedPoints F) := by
  refine Set.Subset.antisymm (fun x hx => ?_)
    (closure_minimal (associatedPoints_subset_support F)
      (SheafOfModules.isClosed_supp (show SheafOfModules X.ringCatSheaf from F)))
  obtain ⟨W, hW, hxW, -⟩ :=
    exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := x) trivial
  have _ : IsNoetherianRing Γ(X, W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
  have _ : Module.Finite Γ(X, W) Γ(F, W) := moduleFinite_sections_on_affine F W hW
  have hp : hW.primeIdealOf ⟨x, hxW⟩ ∈ Module.support Γ(X, W) Γ(F, W) :=
    (Scheme.Modules.mem_support_sections_iff_mem_supp F ⟨W, hW⟩ x hxW).2 hx
  rw [Module.support_eq_zeroLocus, PrimeSpectrum.mem_zeroLocus] at hp
  obtain ⟨q, hq, hqle⟩ :=
    Ideal.exists_minimalPrimes_le (J := (hW.primeIdealOf ⟨x, hxW⟩).asIdeal) fun c hc => hp hc
  obtain ⟨z, hzW, hzass, hzq⟩ := exists_isAssociatedPoint_of_mem_associatedPrimes F hW
    (Module.associatedPrimes.minimalPrimes_annihilator_subset_associatedPrimes _ _ hq)
  exact closure_mono (Set.singleton_subset_iff.2 hzass) (specializes_iff_mem_closure.1
    (specializes_of_primeIdealOf_le hW hzW hxW
      ((PrimeSpectrum.asIdeal_le_asIdeal _ _).1 (le_of_eq_of_le hzq hqle))))

/-- **Germ vanishing transports along a specialization.** If `x` specializes to `y` and a
section of a sheaf of modules over an open containing `y` has vanishing germ at `y`, then its
germ at `x` vanishes too.

The specialization gives a map `F_y ⟶ F_x` carrying the germ at `y` to the germ at `x`
(`TopCat.Presheaf.germ_stalkSpecializes`), and an additive map sends `0` to `0`. In particular
the finer fact that `F_x` is a localization of `F_y` is not needed. -/
theorem germ_eq_zero_of_specializes {X : Scheme.{u}} (F : X.Modules) (U : X.Opens) {x y : X}
    (hy : y ∈ U) (hx : x ∈ U) (h : x ⤳ y) (s : Γ(F, U))
    (hs : F.presheaf.germ U y hy s = 0) :
    F.presheaf.germ U x hx s = 0 := by
  have hs' : TopCat.Presheaf.germ (C := Ab.{u}) F.val.presheaf U y hy s = 0 := hs
  exact (TopCat.Presheaf.germ_stalkSpecializes_apply F.val.presheaf hy h s).symm.trans
    ((congrArg (ConcreteCategory.hom (TopCat.Presheaf.stalkSpecializes F.val.presheaf h))
      hs').trans (map_zero _))

/-- A section whose restriction to a smaller open containing the point vanishes has vanishing
germ at that point. -/
private theorem germ_eq_zero_of_res_eq_zero {X : Scheme.{u}} (F : X.Modules) {V W : X.Opens}
    (hWV : W ≤ V) {z : X} (hzW : z ∈ W) (hzV : z ∈ V) (s : Γ(F, V))
    (h : F.presheaf.map (homOfLE hWV).op s = 0) :
    F.presheaf.germ V z hzV s = 0 :=
  (TopCat.Presheaf.germ_res_apply F.val.presheaf (homOfLE hWV) z hzW s).symm.trans
    ((congrArg (ConcreteCategory.hom
      (TopCat.Presheaf.germ (C := Ab.{u}) F.val.presheaf W z hzW)) h).trans (map_zero _))

/-- Affine case of the vanishing criterion: a section of a quasi-coherent module over an affine
open of a locally Noetherian scheme whose germ vanishes at every associated point of the module
lying in that open is zero.

Were it nonzero, its annihilator would sit inside an associated prime of the module of sections,
which is the prime of an associated point `z` of `F` in the open. The germ at `z` vanishes by
hypothesis, so some function outside the prime of `z` kills the section — contradicting that the
annihilator lies in that prime. -/
private theorem eq_zero_of_forall_germ_associatedPoints_eq_zero_affine {X : Scheme.{u}}
    [IsLocallyNoetherian X] (F : X.Modules) [F.IsQuasicoherent] {W : X.Opens}
    (hW : IsAffineOpen W) (t : Γ(F, W))
    (h : ∀ (x : X) (hx : x ∈ W), x ∈ Stacks.Divisors.associatedPoints F →
      F.presheaf.germ W x hx t = 0) :
    t = 0 := by
  by_contra hne
  have _ : IsNoetherianRing Γ(X, W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
  obtain ⟨q, hqass, hqle⟩ :=
    exists_mem_associatedPrimes_annihilator_le (R := Γ(X, W)) (M := Γ(F, W)) hne
  obtain ⟨z, hzW, hzass, hzq⟩ :=
    exists_isAssociatedPoint_of_mem_associatedPrimes F hW hqass
  obtain ⟨r, hr, hrt⟩ :=
    (germ_eq_zero_iff_exists_smul_eq_zero_affine F W hW z hzW t).1 (h z hzW hzass)
  exact hr (hzq ▸ hqle r hrt)

/-- **A section with vanishing germs at the associated points is zero.** A section of a
quasi-coherent module on a locally Noetherian scheme, over an arbitrary open, whose germ
vanishes at every associated point of the module lying in that open is zero.

This is the form in which Stacks tag 05AG — a quasi-coherent module with no associated point
vanishes — is used: the section is zero because it is zero on each affine open of a basis, by
the affine case, and a section with vanishing germs everywhere vanishes. -/
theorem eq_zero_of_forall_germ_associatedPoints_eq_zero {X : Scheme.{u}}
    [IsLocallyNoetherian X] (F : X.Modules) [F.IsQuasicoherent] (V : X.Opens) (s : Γ(F, V))
    (h : ∀ (x : X) (hx : x ∈ V), x ∈ Stacks.Divisors.associatedPoints F →
      F.presheaf.germ V x hx s = 0) :
    s = 0 := by
  refine TopCat.Presheaf.section_ext ((SheafOfModules.toSheaf X.ringCatSheaf).obj F) V s 0
    fun z hz => ?_
  obtain ⟨W, hW, hzW, hWV⟩ :=
    Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens (U := V) (x := z) hz
  have ht : F.presheaf.map (homOfLE hWV).op s = 0 :=
    eq_zero_of_forall_germ_associatedPoints_eq_zero_affine F hW _ fun x hx hxass =>
      (TopCat.Presheaf.germ_res_apply F.val.presheaf (homOfLE hWV) x hx s).trans
        (h x (hWV hx) hxass)
  exact (germ_eq_zero_of_res_eq_zero F hWV hzW hz s ht).trans (map_zero _).symm

/-- **Stacks Project, Tag 0B3L for a pair of opens.** On a locally Noetherian scheme,
restriction of sections of a quasi-coherent module from an open `V` to an open `O ≤ V`
containing every associated point of the module that lies in `V` is injective.

The maximal-open case `AlgebraicGeometry.restriction_injective_of_associatedPoints_subset` is
this statement for `V = ⊤`. The difference of two sections with the same restriction has
vanishing germ at each associated point of `V`, since each of those points lies in `O` where the
difference is zero. -/
theorem restriction_injective_of_associatedPoints_inter_subset {X : Scheme.{u}}
    [IsLocallyNoetherian X] (F : X.Modules) [F.IsQuasicoherent] {O V : X.Opens} (hOV : O ≤ V)
    (hAss : Stacks.Divisors.associatedPoints F ∩ (V : Set X) ⊆ (O : Set X)) :
    Function.Injective (F.presheaf.map (homOfLE hOV).op) := by
  intro s t hst
  have hsub : F.presheaf.map (homOfLE hOV).op (s - t) = 0 := by
    rw [map_sub, hst, sub_self]
  exact sub_eq_zero.mp (eq_zero_of_forall_germ_associatedPoints_eq_zero F V (s - t)
    fun x hx hxass => germ_eq_zero_of_res_eq_zero F hOV (hAss ⟨hxass, hx⟩) hx (s - t) hsub)

end AlgebraicGeometry

end
