module

public import Mathlib.RingTheory.Localization.BaseChange
public import StacksFrontier.AlgebraicGeometry.Divisors.MeromorphicStalk.ModuleStalk
public import StacksFrontier.Algebra.Category.ModuleCat.Presheaf.ChangeOfRingsAdjunction

/-!
# Stalks of a sectionwise extension of scalars

Let `θ : O₁ ⟶ O₂` be a morphism of presheaves of commutative rings on a topological space `X`
and let `G` be a presheaf of `O₁`-modules. Extension of scalars along `θ` produces the presheaf
of `O₂`-modules `O₂ ⊗_{O₁} G` with sections `O₂(U) ⊗_{O₁(U)} G(U)` over `U` (Stacks 03CU), and
a canonical morphism `G ⟶ O₂ ⊗_{O₁} G` of presheaves of `O₁`-modules sending a section `m` to
`1 ⊗ m`.

This file proves that extension of scalars is computed stalkwise: at every point the induced map
`G_x → (O₂ ⊗_{O₁} G)_x` exhibits the target as the base change of `G_x` along `O₁,x → O₂,x`,
that is, `(O₂ ⊗_{O₁} G)_x = O₂,x ⊗_{O₁,x} G_x`. The content is that the tensor product commutes
with the filtered colimit computing a stalk; the proof writes down the comparison map in both
directions, the inverse one as the descent of the cocone `a ⊗ m ↦ (germ a) ⊗ (germ m)`.

## Main definitions

* `Stacks.ModuleStalk.changeOfRings`: the presheaf `O₂ ⊗_{O₁} G`, and
  `Stacks.ModuleStalk.cofTmul` its pure-tensor sections.
* `Stacks.ModuleStalk.toChangeOfRings`: the canonical morphism `G ⟶ O₂ ⊗_{O₁} G` of presheaves
  of `O₁`-modules, and `Stacks.ModuleStalk.toChangeOfRingsStalk` the linear map it induces on
  stalks.
* `Stacks.ModuleStalk.stalkAlgebra`: the algebra structure `O₁,x → O₂,x` induced by `θ`.

## Main results

* `Stacks.ModuleStalk.isBaseChange_toChangeOfRingsStalk`: the stalk of `O₂ ⊗_{O₁} G` at `x` is
  the base change of `G_x` along `O₁,x → O₂,x`.
* `Stacks.ModuleStalk.changeOfRingsStalkEquiv`: the resulting linear equivalence
  `O₂,x ⊗_{O₁,x} G_x ≃ (O₂ ⊗_{O₁} G)_x`.
* `Stacks.ModuleStalk.changeOfRings_induction`: the sections of `O₂ ⊗_{O₁} G` are generated by
  the pure tensors.
* `Stacks.ModuleStalk.isScalarTower_of_germ_smul`: for a presheaf of `O₂`-modules whose stalk
  carries the `O₁,x`-action obtained by restriction of scalars, the two actions form a tower.

## Implementation notes

Every statement about pure tensors is phrased through `Stacks.ModuleStalk.cofTmul` rather than
through `⊗ₜ` directly. The reason is that the algebra structure of `O₂(U)` over `O₁(U)` is the
one induced by `θ` at `U`, which is not an instance; writing `a ⊗ₜ m` therefore requires a local
instance, and a local instance introduced in a proof is not syntactically the one appearing in a
lemma whose statement introduced its own, so `rw` and `simp` fail to match. Naming the pure
tensor removes the instance from every statement.

The algebra structure on the stalks is likewise not an instance, so it is passed as an instance
argument together with the hypothesis `halg` identifying `algebraMap` with the stalk map of `θ`;
the main theorem instantiates it with `Stacks.ModuleStalk.stalkAlgebra` and `rfl`.

## References

* [Stacks Project, Tag 03CU](https://stacks.math.columbia.edu/tag/03CU)
* [Stacks Project, Tag 01X4](https://stacks.math.columbia.edu/tag/01X4)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace TensorProduct

universe u

namespace Stacks.ModuleStalk

variable {X : TopCat.{u}} {O₁ O₂ : X.Presheaf CommRingCat.{u}} (θ : O₁ ⟶ O₂)
  (G : PresheafOfModules.{u} (O₁ ⋙ forget₂ CommRingCat RingCat))

/-- Extension of scalars along `θ`, applied to `G`: the presheaf of `O₂`-modules with sections
`O₂(U) ⊗_{O₁(U)} G(U)` over an open set `U`. -/
abbrev changeOfRings : PresheafOfModules.{u} (O₂ ⋙ forget₂ CommRingCat RingCat) :=
  (Stacks.PresheafOfModules.ChangeOfRings.changeOfRings θ).obj G

/-- The pure tensor `a ⊗ m`, as a section of `O₂ ⊗_{O₁} G` over an open set. -/
def cofTmul (W : Opens X) (a : ↑(O₂.obj (op W))) (m : ↑(G.obj (op W))) :
    ↑((changeOfRings θ G).obj (op W)) :=
  let := (θ.app (op W)).hom.toAlgebra
  a ⊗ₜ[↑(O₁.obj (op W))] m

/-- The sections of `O₂ ⊗_{O₁} G` over an open set are generated by the pure tensors. -/
theorem changeOfRings_induction {W : Opens X}
    {motive : ↑((changeOfRings θ G).obj (op W)) → Prop}
    (tmul : ∀ a m, motive (cofTmul θ G W a m))
    (add : ∀ s t, motive s → motive t → motive (s + t))
    (t : ↑((changeOfRings θ G).obj (op W))) : motive t := by
  let := (θ.app (op W)).hom.toAlgebra
  exact TensorProduct.inductionOn t tmul add

/-- Restriction of a pure tensor section of `O₂ ⊗_{O₁} G` restricts both factors. -/
theorem res_cofTmul {W W' : Opens X} (h : W' ≤ W) (a : ↑(O₂.obj (op W)))
    (m : ↑(G.obj (op W))) :
    res (changeOfRings θ G) h (cofTmul θ G W a m) =
      cofTmul θ G W' ((O₂.map (homOfLE h).op).hom a) (res G h m) :=
  Stacks.PresheafOfModules.ChangeOfRings.cofMap_tmul θ G (homOfLE h).op a m

/-- Multiplying a pure tensor section of `O₂ ⊗_{O₁} G` by a section of `O₂` multiplies its
first factor. -/
theorem smul_cofTmul (W : Opens X) (a b : ↑(O₂.obj (op W))) (m : ↑(G.obj (op W))) :
    a • cofTmul θ G W b m = cofTmul θ G W (a * b) m := by
  let := (θ.app (op W)).hom.toAlgebra
  exact TensorProduct.smul_tmul' a b m

/-- The canonical morphism `G ⟶ O₂ ⊗_{O₁} G` of presheaves of `O₁`-modules: the unit of
extension of scalars, which sends a section `m` to `1 ⊗ m`. -/
def toChangeOfRings : G ⟶ (Stacks.PresheafOfModules.ChangeOfRings.restrictScalars θ).obj
  (changeOfRings θ G) :=
  Stacks.PresheafOfModules.ChangeOfRings.unitHom θ (𝟙 (changeOfRings θ G))

/-- The canonical morphism `G ⟶ O₂ ⊗_{O₁} G` sends a section `m` to `1 ⊗ m`. -/
theorem toChangeOfRings_app (W : Opens X) (m : ↑(G.obj (op W))) :
    ((toChangeOfRings θ G).app (op W)).hom m = cofTmul θ G W 1 m :=
  Stacks.PresheafOfModules.ChangeOfRings.unitApp_apply θ (𝟙 (changeOfRings θ G)) (op W) m

/-- The stalk of `O₂ ⊗_{O₁} G` is a module over the stalk of `O₁`, by restriction of scalars
along `θ`. This is the instance belonging to
`(Stacks.PresheafOfModules.ChangeOfRings.restrictScalars θ).obj (changeOfRings θ G)`, which
  instance search does not match
against the `changeOfRings` spelling; the two are equal by `rfl`. -/
instance moduleStalkChangeOfRings (x : X) :
    Module ↑(O₁.stalk x) ↑((presheafOn (changeOfRings θ G)).stalk x) :=
  inferInstanceAs (Module ↑(O₁.stalk x)
    ↑((presheafOn ((Stacks.PresheafOfModules.ChangeOfRings.restrictScalars θ).obj (changeOfRings θ
      G))).stalk x))

/-- The map `G_x → (O₂ ⊗_{O₁} G)_x` induced by the unit of extension of scalars, as a linear
map over the stalk of `O₁`. -/
def toChangeOfRingsStalk (x : X) :
    ↑((presheafOn G).stalk x) →ₗ[O₁.stalk x] ↑((presheafOn (changeOfRings θ G)).stalk x) :=
  stalkMap (toChangeOfRings θ G) x

/-- The map `G_x → (O₂ ⊗_{O₁} G)_x` sends the germ of a section `m` to the germ of `1 ⊗ m`. -/
theorem toChangeOfRingsStalk_germ (x : X) (W : Opens X) (hx : x ∈ W) (m : ↑(G.obj (op W))) :
    toChangeOfRingsStalk θ G x (germ G W x hx m) =
      germ (changeOfRings θ G) W x hx (cofTmul θ G W 1 m) := by
  have h := stalkMap_germ (toChangeOfRings θ G) x W hx m
  rw [toChangeOfRings_app] at h
  exact h

/-- Acting on the stalk of `O₂ ⊗_{O₁} G` by the germ of a section of `O₁` is acting by the germ
of its image under `θ`. This is `Stacks.ModuleStalk.germ_smul` for the restriction of scalars
along `θ`, restated at the `changeOfRings` spelling. -/
theorem germ_smul_changeOfRings (x : X) (W : Opens X) (hx : x ∈ W) (r : ↑(O₁.obj (op W)))
    (t : ↑((changeOfRings θ G).obj (op W))) :
    O₁.germ W x hx r • germ (changeOfRings θ G) W x hx t =
      germ (changeOfRings θ G) W x hx ((θ.app (op W)).hom r • t) :=
  (presheafGerm_smul ((Stacks.PresheafOfModules.ChangeOfRings.restrictScalars θ).obj (changeOfRings
    θ G)) hx r t).symm

/-- The algebra structure of the stalk of `O₂` over the stalk of `O₁` induced by `θ`. -/
abbrev stalkAlgebra (x : X) : Algebra ↑(O₁.stalk x) ↑(O₂.stalk x) :=
  ((TopCat.Presheaf.stalkFunctor CommRingCat x).map θ).hom.toAlgebra

section Comparison

variable (x : X) [Algebra ↑(O₁.stalk x) ↑(O₂.stalk x)]
  (halg : algebraMap ↑(O₁.stalk x) ↑(O₂.stalk x) =
    ((TopCat.Presheaf.stalkFunctor CommRingCat x).map θ).hom)

include halg in
/-- The structure map `O₁,x → O₂,x` sends the germ of a section `r` to the germ of `θ(r)`. -/
theorem germ_algebraMap (W : Opens X) (hx : x ∈ W) (r : ↑(O₁.obj (op W))) :
    algebraMap ↑(O₁.stalk x) ↑(O₂.stalk x) (O₁.germ W x hx r) =
      O₂.germ W x hx ((θ.app (op W)).hom r) := by
  rw [halg]
  exact TopCat.Presheaf.stalkFunctor_map_germ_apply W x hx θ r

/-- The comparison map on the sections over one open neighbourhood of `x`: it sends a section
`a ⊗ m` of `O₂ ⊗_{O₁} G` to the tensor product of the germs of `a` and of `m`. -/
def stalkTmulHom (W : Opens X) (hx : x ∈ W) :
    ↑((changeOfRings θ G).obj (op W)) →+
      TensorProduct ↑(O₁.stalk x) ↑(O₂.stalk x) ↑((presheafOn G).stalk x) :=
  let := (θ.app (op W)).hom.toAlgebra
  Stacks.PresheafOfModules.ChangeOfRings.tmulMap ↑(O₁.obj (op W)) ↑(O₂.obj (op W)) ↑(O₁.stalk x)
    ↑(O₂.stalk x)
    (O₁.germ W x hx).hom (O₂.germ W x hx).hom
    (RingHom.ext fun r => (germ_algebraMap θ x halg W hx r).symm)
    ↑(G.obj (op W)) ↑((presheafOn G).stalk x)
    ((presheafOn G).germ W x hx).hom
    (fun r m => presheafGerm_smul G hx r m)

/-- The comparison map sends a pure tensor to the tensor product of the germs. -/
theorem stalkTmulHom_cofTmul (W : Opens X) (hx : x ∈ W)
    (a : ↑(O₂.obj (op W))) (m : ↑(G.obj (op W))) :
    stalkTmulHom θ G x halg W hx (cofTmul θ G W a m) =
      O₂.germ W x hx a ⊗ₜ[↑(O₁.stalk x)] germ G W x hx m := by
  let := (θ.app (op W)).hom.toAlgebra
  exact Stacks.PresheafOfModules.ChangeOfRings.tmulMap_tmul ↑(O₁.obj (op W)) ↑(O₂.obj (op W))
    ↑(O₁.stalk x) ↑(O₂.stalk x)
    (O₁.germ W x hx).hom (O₂.germ W x hx).hom
    (RingHom.ext fun r => (germ_algebraMap θ x halg W hx r).symm)
    ↑(G.obj (op W)) ↑((presheafOn G).stalk x)
    ((presheafOn G).germ W x hx).hom (fun r m => presheafGerm_smul G hx r m) a m

/-- The comparison maps over the open neighbourhoods of `x` are compatible with restriction. -/
theorem stalkTmulHom_res {W W' : Opens X} (h : W' ≤ W) (hx' : x ∈ W')
    (t : ↑((changeOfRings θ G).obj (op W))) :
    stalkTmulHom θ G x halg W' hx' (res (changeOfRings θ G) h t) =
      stalkTmulHom θ G x halg W (h hx') t := by
  refine changeOfRings_induction θ G (motive := fun t => stalkTmulHom θ G x halg W' hx'
    (res (changeOfRings θ G) h t) = stalkTmulHom θ G x halg W (h hx') t)
    (fun a m => ?_) (fun s t hs ht => ?_) t
  · rw [res_cofTmul, stalkTmulHom_cofTmul, stalkTmulHom_cofTmul,
      O₂.germ_res_apply (homOfLE h) x hx' a, germ_res G h hx' m]
  · rw [res_add, map_add, map_add, hs, ht]

/-- The cocone, over the diagram computing the stalk of `O₂ ⊗_{O₁} G` at `x`, whose vertex is
`O₂,x ⊗_{O₁,x} G_x` and whose components are the comparison maps. -/
def stalkTensorCocone :
    Cocone ((OpenNhds.inclusion x).op ⋙ presheafOn (changeOfRings θ G)) where
  pt := AddCommGrpCat.of
    (TensorProduct ↑(O₁.stalk x) ↑(O₂.stalk x) ↑((presheafOn G).stalk x))
  ι :=
    { app := fun V => AddCommGrpCat.ofHom (stalkTmulHom θ G x halg V.unop.1 V.unop.2)
      naturality := by
        intro V V' i
        have h : (V'.unop.1 : Opens X) ≤ V.unop.1 := leOfHom ((OpenNhds.inclusion x).map i.unop)
        exact AddCommGrpCat.hom_ext (AddMonoidHom.ext fun t =>
          stalkTmulHom_res θ G x halg h V'.unop.2 t) }

/-- The comparison map `(O₂ ⊗_{O₁} G)_x → O₂,x ⊗_{O₁,x} G_x`, obtained by descending the
comparison maps on sections through the colimit defining the stalk. -/
def stalkTensorDesc :
    ↑((presheafOn (changeOfRings θ G)).stalk x) →+
      TensorProduct ↑(O₁.stalk x) ↑(O₂.stalk x) ↑((presheafOn G).stalk x) :=
  (colimit.desc _ (stalkTensorCocone θ G x halg)).hom

/-- The comparison map sends the germ of a section to the value of the comparison map on that
section. -/
theorem stalkTensorDesc_germ (W : Opens X) (hx : x ∈ W)
    (t : ↑((changeOfRings θ G).obj (op W))) :
    stalkTensorDesc θ G x halg (germ (changeOfRings θ G) W x hx t) =
      stalkTmulHom θ G x halg W hx t := by
  have h := colimit.ι_desc (stalkTensorCocone θ G x halg) (op (⟨W, hx⟩ : OpenNhds x))
  change ((colimit.ι ((OpenNhds.inclusion x).op ⋙ presheafOn (changeOfRings θ G))
      (op (⟨W, hx⟩ : OpenNhds x)) ≫ colimit.desc _ (stalkTensorCocone θ G x halg))).hom t = _
  rw [h]
  rfl

include halg in
/-- **The two scalar actions on a stalk form a tower.** Let `N` be a presheaf of `O₂`-modules
whose stalk at `x` carries an `O₁,x`-action satisfying the germ formula of restriction of
scalars along `θ`. Then that action is the one obtained from the `O₂,x`-action through the
structure map. -/
theorem isScalarTower_of_germ_smul
    {N : PresheafOfModules.{u} (O₂ ⋙ forget₂ CommRingCat RingCat)}
    [Module ↑(O₁.stalk x) ↑((presheafOn N).stalk x)]
    (hsmul : ∀ (W : Opens X) (hx : x ∈ W) (r : ↑(O₁.obj (op W))) (t : ↑(N.obj (op W))),
      O₁.germ W x hx r • germ N W x hx t = germ N W x hx ((θ.app (op W)).hom r • t)) :
    IsScalarTower ↑(O₁.stalk x) ↑(O₂.stalk x) ↑((presheafOn N).stalk x) := by
  refine IsScalarTower.of_algebraMap_smul fun r n => ?_
  obtain ⟨W, hxW, t, ht⟩ := exists_germ_eq N n
  obtain ⟨W', hW', hxW', ρ, hρ⟩ := O₁.exists_le_germ_eq r hxW
  rw [← ht, ← germ_res N hW' hxW' t, ← hρ, germ_algebraMap θ x halg, hsmul,
    ← presheafGerm_smul N hxW']

include halg in
/-- The two scalar actions on the stalk of `O₂ ⊗_{O₁} G` — that of `O₁,x` by restriction of
scalars and that of `O₂,x` through the structure map — are compatible. -/
theorem isScalarTower_stalk :
    IsScalarTower ↑(O₁.stalk x) ↑(O₂.stalk x)
      ↑((presheafOn (changeOfRings θ G)).stalk x) :=
  isScalarTower_of_germ_smul θ x halg (germ_smul_changeOfRings θ G x)

include halg in
/-- **The stalk of a sectionwise extension of scalars.** At every point `x` the canonical map
`G_x → (O₂ ⊗_{O₁} G)_x` exhibits the stalk of `O₂ ⊗_{O₁} G` as the base change of `G_x` along
the structure map `O₁,x → O₂,x`; that is, `(O₂ ⊗_{O₁} G)_x = O₂,x ⊗_{O₁,x} G_x`. -/
theorem isBaseChange_toChangeOfRingsStalk :
    letI := isScalarTower_stalk θ G x halg
    IsBaseChange ↑(O₂.stalk x) (toChangeOfRingsStalk θ G x) := by
  let := isScalarTower_stalk θ G x halg
  have hleft : ∀ z : TensorProduct ↑(O₁.stalk x) ↑(O₂.stalk x) ↑((presheafOn G).stalk x),
      stalkTensorDesc θ G x halg
        ((toChangeOfRingsStalk θ G x).liftBaseChange ↑(O₂.stalk x) z) = z := by
    intro z
    induction z using TensorProduct.inductionOn with
    | add a b ha hb => simp only [map_add, ha, hb]
    | tmul a m =>
      obtain ⟨W, hxW, s, hs⟩ := exists_germ_eq G m
      obtain ⟨W', hW', hxW', b, hb⟩ := O₂.exists_le_germ_eq a hxW
      rw [LinearMap.liftBaseChange_tmul, ← hs, ← germ_res G hW' hxW' s, ← hb,
        toChangeOfRingsStalk_germ, ← presheafGerm_smul (changeOfRings θ G) hxW',
        smul_cofTmul, mul_one, stalkTensorDesc_germ, stalkTmulHom_cofTmul]
  have hright : ∀ n : ↑((presheafOn (changeOfRings θ G)).stalk x),
      (toChangeOfRingsStalk θ G x).liftBaseChange ↑(O₂.stalk x)
        (stalkTensorDesc θ G x halg n) = n := by
    intro n
    obtain ⟨W, hxW, t, ht⟩ := exists_germ_eq (changeOfRings θ G) n
    rw [← ht]
    refine changeOfRings_induction θ G (motive := fun t =>
      (toChangeOfRingsStalk θ G x).liftBaseChange ↑(O₂.stalk x)
        (stalkTensorDesc θ G x halg (germ (changeOfRings θ G) W x hxW t)) =
          germ (changeOfRings θ G) W x hxW t) (fun a m => ?_) (fun s s' hs hs' => ?_) t
    · rw [stalkTensorDesc_germ, stalkTmulHom_cofTmul, LinearMap.liftBaseChange_tmul,
        toChangeOfRingsStalk_germ, ← presheafGerm_smul (changeOfRings θ G) hxW, smul_cofTmul,
        mul_one]
    · rw [germ_add, map_add, map_add, hs, hs']
  exact IsBaseChange.of_equiv
    (LinearEquiv.ofBijective ((toChangeOfRingsStalk θ G x).liftBaseChange ↑(O₂.stalk x))
      (Function.bijective_iff_has_inverse.mpr ⟨stalkTensorDesc θ G x halg, hleft, hright⟩))
    fun m => by
      rw [LinearEquiv.ofBijective_apply, LinearMap.liftBaseChange_one_tmul]

/-- The stalk of a sectionwise extension of scalars, as a linear equivalence
`O₂,x ⊗_{O₁,x} G_x ≃ (O₂ ⊗_{O₁} G)_x`. -/
def changeOfRingsStalkEquiv :
    TensorProduct ↑(O₁.stalk x) ↑(O₂.stalk x) ↑((presheafOn G).stalk x) ≃ₗ[O₂.stalk x]
      ↑((presheafOn (changeOfRings θ G)).stalk x) :=
  let := isScalarTower_stalk θ G x halg
  (isBaseChange_toChangeOfRingsStalk θ G x halg).equiv

/-- The stalk comparison equivalence sends `a ⊗ m` to `a` times the image of `m`. -/
theorem changeOfRingsStalkEquiv_tmul (a : ↑(O₂.stalk x)) (m : ↑((presheafOn G).stalk x)) :
    changeOfRingsStalkEquiv θ G x halg (a ⊗ₜ[↑(O₁.stalk x)] m) =
      a • toChangeOfRingsStalk θ G x m :=
  rfl

end Comparison

end Stacks.ModuleStalk

end
