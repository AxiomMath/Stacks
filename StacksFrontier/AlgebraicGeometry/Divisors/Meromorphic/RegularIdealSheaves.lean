/-!
# Multiplication by a member of a sequence modulo its predecessors

Let `f₀, …, fₙ₋₁` be global sections of the structure sheaf of a ringed space `X`.
Multiplication by `fᵢ` induces an endomorphism of the quotient of the structure sheaf by the
ideal sheaf generated by the preceding sections. This is the datum whose vanishing conditions
define a *regular ideal sheaf*.

## Main definitions

* `AlgebraicGeometry.precedingIdeal`: the ideal of sections lying locally in the ideal generated
  by the sections preceding `f i`, i.e. the generated ideal sheaf read on an open set.
* `AlgebraicGeometry.additivePresheaf`: the underlying additive presheaf of a sheaf of
  commutative rings.
* `AlgebraicGeometry.RegularSequenceMultiplicationData`: the quotient sheaf
  `𝒪_X/(f₀, …, f_{i-1})` together with its multiplication endomorphism.
* `AlgebraicGeometry.regularSequenceMultiplication`: the canonical such datum.

## Main results

`AlgebraicGeometry.regularSequenceMultiplication` exhibits the endomorphism
`f i : 𝒪_X/(f₀, …, f_{i-1}) ⟶ 𝒪_X/(f₀, …, f_{i-1})`.

## Implementation notes

The generated ideal is characterized on an open set by local finite linear combinations of the
preceding sections, which is `AlgebraicGeometry.IsLocallyInPrecedingIdeal`. The quotient is an
actual sheaf of commutative rings: its quotient map is
locally surjective and has precisely this ideal sheaf as kernel. The displayed endomorphism is
a natural transformation of the underlying additive presheaf and is characterized by its
composite with the quotient map. This avoids sectionwise quotients, which need not themselves
be sheaves, and works for independent universes of the rings and the underlying topological
space — which is why the local surjectivity and local injectivity of the sheafification unit
are re-derived here for a concrete category whose objects live in `Type (max u v w)`, rather
than reusing the `Type (max u v)` versions from the general theory.

## References

* [Stacks Project, Tag 0639](https://stacks.math.columbia.edu/tag/0639)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry

universe u v w t t'

namespace AlgebraicGeometry

/-- The underlying additive presheaf of a sheaf of commutative rings. -/
public abbrev additivePresheaf (X : RingedSpace.{u, v})
    (F : TopCat.Sheaf CommRingCat.{w} X) :=
  F.presheaf ⋙ forget₂ CommRingCat.{w} RingCat.{w} ⋙
    forget₂ RingCat.{w} AddCommGrpCat.{w}

/-- Restricting twice along inclusions of opens is restricting once. -/
lemma res_res (X : RingedSpace.{u, v}) (U V W : Opens X)
    (hVU : V ≤ U) (hWV : W ≤ V) (s : X.presheaf.obj (op U)) :
    X.presheaf.map (homOfLE hWV).op (X.presheaf.map (homOfLE hVU).op s) =
      X.presheaf.map (homOfLE (hWV.trans hVU)).op s := by
  rw [← ConcreteCategory.comp_apply, ← X.presheaf.map_comp]
  rfl

/-- The ideal of sections over `U` belonging locally to the ideal generated by the global
sections preceding `f i`. -/
noncomputable def precedingIdeal (X : RingedSpace.{u, v}) {n : ℕ}
    (f : Fin n → X.presheaf.obj (op (⊤ : Opens X))) (i : Fin n)
    (U : Opens X) : Ideal (X.presheaf.obj (op U)) where
  carrier := {s | IsLocallyInPrecedingIdeal X f i U s}
  zero_mem' := by
    intro x hx
    refine ⟨U, hx, le_rfl, 0, ?_⟩
    simp
  add_mem' := by
    intro s t hs ht x hx
    obtain ⟨V, hxV, hVU, a, ha⟩ := hs x hx
    obtain ⟨W, hxW, hWU, b, hb⟩ := ht x hx
    let Z : Opens X := V ⊓ W
    have hxZ : x ∈ Z := ⟨hxV, hxW⟩
    have hZV : Z ≤ V := inf_le_left
    have hZW : Z ≤ W := inf_le_right
    refine ⟨Z, hxZ, hZV.trans hVU, fun j ↦
      X.presheaf.map (homOfLE hZV).op (a j) +
        X.presheaf.map (homOfLE hZW).op (b j), ?_⟩
    rw [map_add]
    have haZ := congrArg (X.presheaf.map (homOfLE hZV).op) ha
    have hbZ := congrArg (X.presheaf.map (homOfLE hZW).op) hb
    simp only [map_sum, map_mul] at haZ hbZ
    have haZ' : X.presheaf.map (homOfLE (hZV.trans hVU)).op s =
        ∑ j, X.presheaf.map (homOfLE hZV).op (a j) *
          X.presheaf.map (homOfLE le_top).op
            (f ⟨j.val, lt_trans j.isLt i.isLt⟩) := by
      simpa only [res_res] using haZ
    have hbZ' : X.presheaf.map (homOfLE (hZW.trans hWU)).op t =
        ∑ j, X.presheaf.map (homOfLE hZW).op (b j) *
          X.presheaf.map (homOfLE le_top).op
            (f ⟨j.val, lt_trans j.isLt i.isLt⟩) := by
      simpa only [res_res] using hbZ
    change _ + _ = _
    rw [haZ', hbZ']
    simp_rw [add_mul, Finset.sum_add_distrib]
  smul_mem' := by
    intro r s hs x hx
    obtain ⟨V, hxV, hVU, a, ha⟩ := hs x hx
    refine ⟨V, hxV, hVU, fun j ↦ X.presheaf.map (homOfLE hVU).op r * a j, ?_⟩
    change X.presheaf.map (homOfLE hVU).op (r * s) = _
    rw [map_mul, ha, Finset.mul_sum]
    simp_rw [mul_assoc]

/-- `AlgebraicGeometry.precedingIdeal` is stable under restriction. -/
lemma precedingIdeal_res (X : RingedSpace.{u, v}) {n : ℕ}
    (f : Fin n → X.presheaf.obj (op (⊤ : Opens X))) (i : Fin n)
    (U V : Opens X) (hVU : V ≤ U) (s : X.presheaf.obj (op U))
    (hs : s ∈ precedingIdeal X f i U) :
    X.presheaf.map (homOfLE hVU).op s ∈ precedingIdeal X f i V := by
  intro x hx
  obtain ⟨W, hxW, hWU, a, ha⟩ := hs x (hVU hx)
  let Z : Opens X := W ⊓ V
  have hxZ : x ∈ Z := ⟨hxW, hx⟩
  have hZW : Z ≤ W := inf_le_left
  have hZV : Z ≤ V := inf_le_right
  refine ⟨Z, hxZ, hZV, fun j ↦ X.presheaf.map (homOfLE hZW).op (a j), ?_⟩
  have haZ := congrArg (X.presheaf.map (homOfLE hZW).op) ha
  rw [res_res X U V Z hVU hZV s]
  simpa only [map_sum, map_mul, res_res] using haZ

/-- The sectionwise quotient of the structure presheaf by `AlgebraicGeometry.precedingIdeal`.
It is only a presheaf; the quotient sheaf is its sheafification. -/
noncomputable def quotientPresheaf (X : RingedSpace.{u, v}) {n : ℕ}
    (f : Fin n → X.presheaf.obj (op (⊤ : Opens X))) (i : Fin n) :
    TopCat.Presheaf CommRingCat.{u} X where
  obj U := CommRingCat.of (X.presheaf.obj U ⧸ precedingIdeal X f i U.unop)
  map {U V} g := CommRingCat.ofHom <| Ideal.quotientMap _ (X.presheaf.map g).hom <|
    precedingIdeal_res X f i U.unop V.unop (leOfHom g.unop)
  map_id U := by
    refine CommRingCat.hom_ext (Ideal.Quotient.ringHom_ext (RingHom.ext fun s ↦ ?_))
    change Ideal.Quotient.mk _ ((X.presheaf.map (𝟙 U)).hom s) = _
    rw [X.presheaf.map_id]
    rfl
  map_comp g h := by
    refine CommRingCat.hom_ext (Ideal.Quotient.ringHom_ext (RingHom.ext fun s ↦ ?_))
    change Ideal.Quotient.mk _ ((X.presheaf.map (g ≫ h)).hom s) = _
    rw [X.presheaf.map_comp]
    rfl

/-- The sectionwise quotient map onto `AlgebraicGeometry.quotientPresheaf`. -/
noncomputable def quotientPreMap (X : RingedSpace.{u, v}) {n : ℕ}
    (f : Fin n → X.presheaf.obj (op (⊤ : Opens X))) (i : Fin n) :
    X.presheaf ⟶ quotientPresheaf X f i where
  app U := CommRingCat.ofHom (Ideal.Quotient.mk (precedingIdeal X f i U.unop))
  naturality U V g := by
    apply CommRingCat.hom_ext
    ext s
    rfl

/-- `ULift` as a functor between categories of commutative rings, used to move the sectionwise
quotient into the universe where the sheafification lives. -/
def commRingULiftFunctor : CommRingCat.{u} ⥤ CommRingCat.{max u v} where
  obj R := CommRingCat.of (ULift.{v} (R : Type u))
  map f := CommRingCat.ofHom (RingHom.ulift.{v, v} f.hom)
  map_id R := by ext x; rfl
  map_comp f g := by ext x; rfl

/-- `AlgebraicGeometry.quotientPresheaf` with its rings of sections lifted to the universe
`max u v`. -/
noncomputable def quotientPresheafLarge (X : RingedSpace.{u, v}) {n : ℕ}
    (f : Fin n → X.presheaf.obj (op (⊤ : Opens X))) (i : Fin n) :
    TopCat.Presheaf CommRingCat.{max u v} X :=
  quotientPresheaf X f i ⋙ commRingULiftFunctor

/-- `AlgebraicGeometry.quotientPreMap` with its rings of sections lifted to the universe
`max u v`. -/
noncomputable def quotientPreMapLarge (X : RingedSpace.{u, v}) {n : ℕ}
    (f : Fin n → X.presheaf.obj (op (⊤ : Opens X))) (i : Fin n) :
    (X.presheaf ⋙ commRingULiftFunctor) ⟶ quotientPresheafLarge X f i :=
  Functor.whiskerRight (quotientPreMap X f i) commRingULiftFunctor

/-- `ULift.up` as a ring homomorphism. -/
def ringUp (R : Type u) [CommRing R] : R →+* ULift.{v} R where
  toFun := ULift.up
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

open CategoryTheory.GrothendieckTopology.Plus

/-- The map to the plus construction is locally surjective, for an object universe that need
not be `max u v`. -/
private instance plusLocallySurjectiveWide {C : Type u} [Category.{v} C]
    (J : GrothendieckTopology C) (P : Cᵒᵖ ⥤ Type (max u v w)) :
    Presheaf.IsLocallySurjective J (J.toPlus P) where
  imageSieve_mem x := by
    obtain ⟨S, x, rfl⟩ := exists_rep x
    refine J.superset_covering (fun Y f hf => ⟨x.1 ⟨Y, f, hf⟩, ?_⟩) S.2
    rw [toPlus_eq_mk, res_mk_eq_mk_pullback, eq_mk_iff_exists]
    refine ⟨S.pullback f, homOfLE le_top, 𝟙 _, ?_⟩
    ext ⟨Z, g, hg⟩
    simpa using!
      x.2 { fst.hf := hf, snd.hf := S.1.downward_closed hf g, r.g₁ := g, r.g₂ := 𝟙 Z, .. }

/-- The map to the plus construction is locally injective, for an object universe that need
not be `max u v`. -/
private instance plusLocallyInjectiveWide {C : Type u} [Category.{v} C]
    (J : GrothendieckTopology C) (P : Cᵒᵖ ⥤ Type (max u v w)) :
    Presheaf.IsLocallyInjective J (J.toPlus P) where
  equalizerSieve_mem {X} x y h := by
    rw [toPlus_eq_mk, toPlus_eq_mk, eq_mk_iff_exists] at h
    obtain ⟨W, h₁, h₂, eq⟩ := h
    exact J.superset_covering
      (fun Y f hf => congr_fun (congr_arg Subtype.val eq) ⟨Y, f, hf⟩) W.2

/-- The sheafification unit of a presheaf of types is locally surjective, for an object
universe that need not be `max u v`. -/
private instance typeSheafifyLocallySurjectiveWide {C : Type u} [Category.{v} C]
    (J : GrothendieckTopology C) (P : Cᵒᵖ ⥤ Type (max u v w)) :
    Presheaf.IsLocallySurjective J (J.toSheafify P) := by
  dsimp [GrothendieckTopology.toSheafify]
  rw [GrothendieckTopology.plusMap_toPlus]
  exact Presheaf.isLocallySurjective_comp J (J.toPlus P) (J.toPlus (J.plusObj P))

/-- The sheafification unit of a presheaf of types is locally injective, for an object
universe that need not be `max u v`. -/
private instance typeSheafifyLocallyInjectiveWide {C : Type u} [Category.{v} C]
    (J : GrothendieckTopology C) (P : Cᵒᵖ ⥤ Type (max u v w)) :
    Presheaf.IsLocallyInjective J (J.toSheafify P) := by
  dsimp [GrothendieckTopology.toSheafify]
  rw [GrothendieckTopology.plusMap_toPlus]
  exact Presheaf.isLocallyInjective_comp J (J.toPlus P) (J.toPlus (J.plusObj P))

/-- The sheafification unit of a presheaf valued in a concrete category is locally surjective,
for an object universe that need not be `max u v`. -/
instance sheafifyLocallySurjectiveWide {C : Type u} [Category.{v} C]
    (J : GrothendieckTopology C) {D : Type t} [Category.{t'} D]
    {FD : D → D → Type*} {CD : D → Type (max u v w)}
    [∀ X Y, FunLike (FD X Y) (CD X) (CD Y)] [ConcreteCategory.{max u v w} D FD]
    (P : Cᵒᵖ ⥤ D) [HasWeakSheafify J D] [J.HasSheafCompose (forget D)]
    [J.PreservesSheafification (forget D)] :
  Presheaf.IsLocallySurjective J (toSheafify J P) := by
  rw [Presheaf.isLocallySurjective_iff_whisker_forget,
    ← sheafComposeIso_hom_fac, ← toSheafify_plusPlusIsoSheafify_hom]
  infer_instance

/-- The sheafification unit of a presheaf valued in a concrete category is locally injective,
for an object universe that need not be `max u v`. -/
instance sheafifyLocallyInjectiveWide {C : Type u} [Category.{v} C]
    (J : GrothendieckTopology C) {D : Type t} [Category.{t'} D]
    {FD : D → D → Type*} {CD : D → Type (max u v w)}
    [∀ X Y, FunLike (FD X Y) (CD X) (CD Y)] [ConcreteCategory.{max u v w} D FD]
    (P : Cᵒᵖ ⥤ D) [HasWeakSheafify J D] [J.HasSheafCompose (forget D)]
    [J.PreservesSheafification (forget D)] :
  Presheaf.IsLocallyInjective J (toSheafify J P) := by
  rw [← Presheaf.isLocallyInjective_forget_iff, ← sheafComposeIso_hom_fac,
    ← toSheafify_plusPlusIsoSheafify_hom]
  infer_instance

/-- The quotient sheaf by the ideal generated by the sections preceding
`f i`, together with multiplication by `f i` on that quotient.

The local description of `precedingIdeal` makes it the generated ideal
subsheaf. Local surjectivity and the kernel condition characterize
`quotientSheaf` as its sheaf quotient. -/
public structure RegularSequenceMultiplicationData (X : RingedSpace.{u, v})
    {n : ℕ} (f : Fin n → X.presheaf.obj (op (⊤ : Opens X))) (i : Fin n) where
  /-- The ideal of sections on each open of the generated ideal subsheaf. -/
  precedingIdeal (U : Opens X) : Ideal (X.presheaf.obj (op U))
  /-- Membership in the ideal subsheaf is local generation by the preceding
  global sections. -/
  mem_precedingIdeal_iff (U : Opens X) (s : X.presheaf.obj (op U)) :
    s ∈ precedingIdeal U ↔ IsLocallyInPrecedingIdeal X f i U s
  /-- Restriction maps preserve the generated ideal subsheaf. -/
  precedingIdeal_res (U V : Opens X) (hVU : V ≤ U)
      (s : X.presheaf.obj (op U)) (hs : s ∈ precedingIdeal U) :
    X.presheaf.map (homOfLE hVU).op s ∈ precedingIdeal V
  /-- The sheaf quotient `O_X/(f₀, …, f_{i-1})`. -/
  quotientSheaf : TopCat.Sheaf CommRingCat.{max u v} X
  /-- The components of the quotient morphism from the structure sheaf,
  allowing its source and target rings to lie in different universes. -/
  quotientMap (U : Opens X) :
    X.presheaf.obj (op U) →+* quotientSheaf.presheaf.obj (op U)
  /-- The quotient morphism commutes with every restriction map. -/
  quotientMap_naturality (U V : Opens X) (hVU : V ≤ U)
      (s : X.presheaf.obj (op U)) :
    quotientSheaf.presheaf.map (homOfLE hVU).op (quotientMap U s) =
      quotientMap V (X.presheaf.map (homOfLE hVU).op s)
  /-- Sections of the quotient sheaf locally lift to the structure sheaf. -/
  quotientMap_locallySurjective (U : Opens X)
      (s : quotientSheaf.presheaf.obj (op U)) (x : X) (hx : x ∈ U) :
    ∃ (V : Opens X) (_ : x ∈ V) (hVU : V ≤ U)
      (t : X.presheaf.obj (op V)),
      quotientMap V t =
        quotientSheaf.presheaf.map (homOfLE hVU).op s
  /-- The kernel of the quotient morphism is exactly the generated ideal
  subsheaf. -/
  quotientMap_eq_zero_iff (U : Opens X) (s : X.presheaf.obj (op U)) :
    quotientMap U s = 0 ↔ s ∈ precedingIdeal U
  /-- Multiplication by `f i` on the quotient sheaf, as a bundled morphism of
  its underlying additive sheaf. -/
  multiplication : additivePresheaf X quotientSheaf ⟶ additivePresheaf X quotientSheaf
  /-- The quotient endomorphism is induced by multiplication by `f i` on the
  structure sheaf. -/
  multiplication_quotientMap (U : Opens X) (s : X.presheaf.obj (op U)) :
    multiplication.app (op U) (quotientMap U s) =
      quotientMap U
        (X.presheaf.map (homOfLE le_top).op (f i) * s)

/-- **Stacks Project, Tag 0639.** Multiplication by `f i` on
`O_X/(f₀, …, f_{i-1})`, for an arbitrary ringed space. -/
@[stacks 0639]
public noncomputable def regularSequenceMultiplication
    (X : RingedSpace.{u, v}) {n : ℕ}
    (f : Fin n → X.presheaf.obj (op (⊤ : Opens X))) (i : Fin n) :
    RegularSequenceMultiplicationData X f i := by
  let J := Opens.grothendieckTopology X.carrier
  letI : Limits.HasColimitsOfSize.{max u v, max u v} CommRingCat.{max u v} :=
    Limits.hasColimitsOfSizeShrink (CommRingCat.{max u v})
  letI : ∀ U : Opens X,
      Limits.HasColimitsOfShape (J.Cover U)ᵒᵖ CommRingCat.{max u v} := fun U =>
    Limits.HasColimitsOfShape.of_small (C := CommRingCat.{max u v}) ((J.Cover U)ᵒᵖ)
  letI : Limits.PreservesFilteredColimitsOfSize.{max u v, max u v}
      (forget CommRingCat.{max u v}) := Limits.preservesFilteredColimitsOfSize_shrink _
  letI : Limits.PreservesFilteredColimitsOfSize.{v, v}
      (forget CommRingCat.{max u v}) := Limits.preservesFilteredColimitsOfSize_shrink _
  letI : Limits.HasColimitsOfSize.{v, v} CommRingCat.{max u v} :=
    Limits.hasColimitsOfSizeShrink (CommRingCat.{max u v})
  letI : HasWeakSheafify J CommRingCat.{max u v} := inferInstance
  letI : J.HasSheafCompose (forget CommRingCat.{max u v}) := inferInstance
  letI : ∀ U : Opens X,
      Limits.PreservesColimitsOfShape (J.Cover U)ᵒᵖ (forget CommRingCat.{max u v}) := fun U =>
    inferInstance
  letI : J.PreservesSheafification (forget CommRingCat.{max u v}) :=
    CategoryTheory.GrothendieckTopology.instPreservesSheafification J
      (forget CommRingCat.{max u v})
  letI : ConcreteCategory.{max u v} CommRingCat
      (fun A B : CommRingCat.{max u v} => A →+* B) := inferInstance
  let P : TopCat.Presheaf CommRingCat.{max u v} X := quotientPresheafLarge X f i
  let Q : TopCat.Sheaf CommRingCat.{max u v} X :=
    (presheafToSheaf J CommRingCat).obj P
  let unit := toSheafify J P
  let qpre := quotientPreMapLarge X f i
  let qmap : ∀ U : Opens X,
      X.presheaf.obj (op U) →+* Q.presheaf.obj (op U) := fun U =>
    (unit.app (op U)).hom.comp ((qpre.app (op U)).hom.comp (ringUp _))
  refine
    { precedingIdeal := precedingIdeal X f i
      mem_precedingIdeal_iff := fun _ _ => Iff.rfl
      precedingIdeal_res := precedingIdeal_res X f i
      quotientSheaf := Q
      quotientMap := qmap
      quotientMap_naturality := ?_
      quotientMap_locallySurjective := ?_
      quotientMap_eq_zero_iff := ?_
      multiplication := ?_
      multiplication_quotientMap := ?_ }
  · intro U V hVU s
    change (sheafify J P).map (homOfLE hVU).op
        (unit.app (op U) (qpre.app (op U) (ULift.up s))) =
      unit.app (op V)
        (qpre.app (op V) (ULift.up (X.presheaf.map (homOfLE hVU).op s)))
    calc
      _ = unit.app (op V)
          (P.map (homOfLE hVU).op (qpre.app (op U) (ULift.up s))) :=
            (NatTrans.naturality_apply unit (homOfLE hVU).op _).symm
      _ = unit.app (op V)
          (qpre.app (op V) (ULift.up (X.presheaf.map (homOfLE hVU).op s))) := by
            congr 1
  · intro U s x hx
    let : Presheaf.IsLocallySurjective J unit :=
      sheafifyLocallySurjectiveWide J P
    have hcover := Presheaf.imageSieve_mem J unit s
    obtain ⟨V, g, hg, hxV⟩ :=
      (Opens.mem_grothendieckTopology X.carrier).1 hcover x hx
    let a := Presheaf.localPreimage unit s g hg
    have ha : unit.app (op V) a = Q.presheaf.map g.op s :=
      Presheaf.app_localPreimage unit s g hg
    obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective a.down
    refine ⟨V, hxV, leOfHom g, t, ?_⟩
    change unit.app (op V) (qpre.app (op V) (ULift.up t)) =
      Q.presheaf.map g.op s
    have hqa : qpre.app (op V) (ULift.up t) = a := by
      change ULift.up (Ideal.Quotient.mk (precedingIdeal X f i V) t) = a
      apply ULift.ext
      exact ht
    rwa [hqa]
  · intro U s
    constructor
    · intro hs x hx
      let a := qpre.app (op U) (ringUp _ s)
      let : Presheaf.IsLocallyInjective J unit :=
        sheafifyLocallyInjectiveWide J P
      have hEq : unit.app (op U) a = unit.app (op U) 0 := by
        change qmap U s = 0 at hs
        change unit.app (op U) (qpre.app (op U) (ringUp _ s)) = 0 at hs
        simpa [a] using hs
      have hcover :=
        Presheaf.equalizerSieve_mem J unit a 0 hEq
      obtain ⟨V, g, hg, hxV⟩ :=
        (Opens.mem_grothendieckTopology X.carrier).1 hcover x hx
      have hloc : P.map g.op a = P.map g.op 0 := hg
      have hmk : Ideal.Quotient.mk (precedingIdeal X f i V)
          (X.presheaf.map g.op s) = 0 := by
        let qmapV : (X.presheaf.obj (op U) ⧸ precedingIdeal X f i U) →+*
            (X.presheaf.obj (op V) ⧸ precedingIdeal X f i V) :=
            Ideal.quotientMap (precedingIdeal X f i V) (X.presheaf.map g.op).hom
            (precedingIdeal_res X f i U V (leOfHom g))
        have hmk' : ULift.up
            (qmapV (Ideal.Quotient.mk (precedingIdeal X f i U) s)) =
            ULift.up (qmapV 0) := by
          change _ = _ at hloc
          exact hloc
        have hmk' := ULift.up.inj hmk'
        rwa [map_zero] at hmk'
      have hzero : X.presheaf.map g.op s ∈ precedingIdeal X f i V :=
        Ideal.Quotient.eq_zero_iff_mem.mp hmk
      obtain ⟨W, hxW, hWV, a, ha⟩ := hzero x hxV
      refine ⟨W, hxW, hWV.trans (leOfHom g), a, ?_⟩
      have hres : X.presheaf.map (homOfLE hWV).op
          (X.presheaf.map (homOfLE (leOfHom g)).op s) =
          X.presheaf.map (homOfLE (hWV.trans (leOfHom g))).op s := by
        rw [← ConcreteCategory.comp_apply, ← X.presheaf.map_comp]
        rfl
      exact hres.symm.trans ha
    · intro hs
      change unit.app (op U) (qpre.app (op U) (ringUp _ s)) = 0
      have hmk : qpre.app (op U) (ringUp _ s) = 0 := by
        apply ULift.ext
        change Ideal.Quotient.mk (precedingIdeal X f i U) s = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hs
      rw [hmk]
      simp
  · refine
      { app := fun U => AddCommGrpCat.ofHom
          { toFun := fun s => qmap U.unop
              (X.presheaf.map (homOfLE le_top).op (f i)) *
                (show Q.presheaf.obj (op U.unop) from s)
            map_zero' := by simp
            map_add' := by intro a b; simp [mul_add] }
        naturality := ?_ }
    intro U V g
    ext s
    let s' : Q.presheaf.obj (op U.unop) := s
    let htopU : X.presheaf.obj (op U.unop) :=
      X.presheaf.map (homOfLE (le_top : U.unop ≤ ⊤)).op (f i)
    let htopV : X.presheaf.obj (op V.unop) :=
      X.presheaf.map (homOfLE (le_top : V.unop ≤ ⊤)).op (f i)
    change qmap V.unop htopV *
        Q.presheaf.map g s' =
      Q.presheaf.map g
        (qmap U.unop htopU * s')
    rw [map_mul]
    have hqf : qmap V.unop (X.presheaf.map g htopU) =
        Q.presheaf.map g (qmap U.unop htopU) := by
      change unit.app (op V.unop)
          (qpre.app (op V.unop) (ULift.up (X.presheaf.map g htopU))) =
        Q.presheaf.map g
          (unit.app (op U.unop) (qpre.app (op U.unop) (ULift.up htopU)))
      calc
        _ = unit.app (op V.unop)
            (P.map g (qpre.app (op U.unop) (ULift.up htopU))) := by
              congr 1
        _ = Q.presheaf.map g
            (unit.app (op U.unop) (qpre.app (op U.unop) (ULift.up htopU))) := by
              change unit.app (op V.unop)
                  (P.map g (qpre.app (op U.unop) (ULift.up htopU))) =
                (sheafify J P).map g
                  (unit.app (op U.unop) (qpre.app (op U.unop) (ULift.up htopU)))
              exact NatTrans.naturality_apply unit g _
    have hg : g = (homOfLE (leOfHom g.unop)).op := Subsingleton.elim _ _
    have hf : X.presheaf.map g htopU = htopV := by
      rw [hg, ← ConcreteCategory.comp_apply, ← X.presheaf.map_comp]
      rfl
    rw [hf] at hqf
    rw [hqf]
  · intro U s
    change qmap U (X.presheaf.map (homOfLE le_top).op (f i)) * qmap U s =
      qmap U (X.presheaf.map (homOfLE le_top).op (f i) * s)
    exact ((qmap U).map_mul _ _).symm

end AlgebraicGeometry
