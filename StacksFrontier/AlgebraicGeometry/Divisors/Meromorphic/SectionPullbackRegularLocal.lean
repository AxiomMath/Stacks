/-!
# Regularity of the pullback of a regular meromorphic section

Let `f : X ⟶ Y` be a morphism of locally ringed spaces for which pullbacks of meromorphic
functions are defined ([Tag 02OT](https://stacks.math.columbia.edu/tag/02OT)), let `F` be a
sheaf of `𝒪_Y`-modules which near every point is generated by a single section, and let `s` be
a regular meromorphic section of `F`. Then the pullback `f^* s` of
[Tag 02OY](https://stacks.math.columbia.edu/tag/02OY) part (1) is a regular meromorphic section
of `f^* F`. For an invertible module the generation hypothesis is automatic, and that case is
part (2) of the tag; it is
`AlgebraicGeometry.isRegularMeromorphicSection_pullbackMeromorphicSection_of_isInvertible`.

## Main results

* `AlgebraicGeometry.isRegularMeromorphicSection_pullbackMeromorphicSection_of_exists_generator`:
  the regularity of the pullback, under the local generation hypothesis.
* `AlgebraicGeometry.isSMulRegular_germ_pullbackMeromorphicSection`: its pointwise content, that
  no nonzero germ of the structure sheaf kills the germ of the pullback.
* `AlgebraicGeometry.smul_pullbackMeromorphicSection_valOver` and
  `AlgebraicGeometry.germ_smul_pullbackMeromorphicSection`: the normal form `b · s = t` of a
  meromorphic section pulls back, on sections and on germs.
* `AlgebraicGeometry.isSMulRegular_numerator`: regularity of `s` makes the numerator of that
  normal form a nonzerodivisor — the one place the hypothesis on `s` is used.
* `Stacks.ModuleStalk.bijective_smul_germ` and
  `AlgebraicGeometry.bijective_smul_germ_modulePullbackUnit`: a sectionwise basis has a basis
  germ, and its pullback has a basis germ, the latter by Tag 0098.

## Implementation notes

The argument is the one the source omits. A meromorphic section is locally `t / b` with `b` a
section whose germs are everywhere nonzerodivisors
(`Stacks.Divisors.exists_nhds_smul_eq`); where `F` is generated by `g` the numerator is `α · g`,
and regularity of `s` forces `α` to be a regular section of `𝒪_Y` — this is where Tag 02OT
enters, carrying `α` and `b` to regular sections of `𝒪_X`. The pullback of the normal form then
exhibits the germ of `f^* s` at a point as a nonzerodivisor multiple of the germ of the pullback
of `g`, which is a basis of the stalk by Tag 0098. Since the stalk of the sheaf of meromorphic
sections is the localization of the stalk at the regular germs
(`Stacks.Divisors.isLocalizedModule_toMeromorphicSectionStalk`), no nonzero scalar kills that
germ; and a multiplier killing `f^* s` over an open set is locally a fraction, so its numerator
dies at every germ and the multiplier vanishes.

Each of the five spellings of a module over the structure sheaf that the statement has to
cross — the module itself, the sheaf of meromorphic sections as a module over `𝒪` and as a
module over `𝒦`, the pullback of a section of `𝒪`, and the image of a section in `𝒦` — is
named by an abbreviation below, because instance search finds the scalar action only at the
spelling in which the ring presheaf appears as a composite with `forget₂`. For the same reason
every computation with germs is made in a lemma of its own, stated at variables: inside a long
proof the elaborator no longer finds the module structures on a stalk.

## References

* [Stacks Project, Tag 02OY](https://stacks.math.columbia.edu/tag/02OY)
* [Stacks Project, Tag 02OT](https://stacks.math.columbia.edu/tag/02OT)
* [Stacks Project, Tag 02OX](https://stacks.math.columbia.edu/tag/02OX)
* [Stacks Project, Tag 0098](https://stacks.math.columbia.edu/tag/0098)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry TensorProduct
open Stacks.ModuleStalk

universe u

namespace Stacks.ModuleStalk

variable {Z : TopCat.{u}} {O : Z.Presheaf CommRingCat.{u}}

/-- **Sectionwise bijectivity of multiplication by a section is inherited by its germ.** If
`c ↦ c · g` is bijective on the sections over every open inside the domain of `g`, then
`r ↦ r · germ g` is bijective on the stalk at every point of that domain. -/
theorem bijective_smul_germ {M : PresheafOfModules.{u} (O ⋙ forget₂ CommRingCat RingCat)}
    {W : Opens Z} (g : M.obj (op W))
    (h : ∀ (V : Opens Z) (hV : V ≤ W),
      Function.Bijective fun c : O.obj (op V) => c • res M hV g)
    (y : Z) (hy : y ∈ W) :
    Function.Bijective fun r : O.stalk y => r • germ M W y hy g := by
  have hzero : ∀ r : O.stalk y, r • germ M W y hy g = 0 → r = 0 := by
    intro r hr
    obtain ⟨V, hVW, hyV, t, ht⟩ := O.exists_le_germ_eq r hy
    have h0 : germ M V y hyV (t • res M hVW g) = germ M V y hyV 0 := by
      rw [presheafGerm_smul M hyV, germ_res M hVW hyV g, ht, hr, germ_zero]
    obtain ⟨V', hyV', i, j, hij⟩ := TopCat.Presheaf.germ_eq (presheafOn M) y hyV hyV _ _ h0
    cases Subsingleton.elim i j
    have hres : res M (leOfHom i) (t • res M hVW g) = (0 : M.obj (op V')) :=
      hij.trans (res_zero M (leOfHom i))
    rw [res_smul M (leOfHom i) t (res M hVW g), res_res M hVW (leOfHom i) g] at hres
    have htz : ((O.map (homOfLE (leOfHom i)).op).hom t : O.obj (op V')) = 0 :=
      ((h V' ((leOfHom i).trans hVW)).injective.eq_iff' (zero_smul _ _)).mp hres
    rw [← ht, ← O.germ_res_apply (homOfLE (leOfHom i)) y hyV' t, htz, map_zero]
  refine ⟨fun r r' hrr' => ?_, fun m => ?_⟩
  · have hrr'' : r • germ M W y hy g = r' • germ M W y hy g := hrr'
    refine sub_eq_zero.mp (hzero (r - r') ?_)
    rw [sub_smul, hrr'', sub_self]
  · obtain ⟨V, hVW, hyV, n, hn⟩ := exists_le_germ_eq M m hy
    obtain ⟨c, hc⟩ := (h V hVW).surjective n
    have hc' : c • res M hVW g = n := hc
    refine ⟨O.germ V y hyV c, ?_⟩
    show (O.germ V y hyV c : O.stalk y) • germ M W y hy g = m
    rw [← germ_res M hVW hyV g, ← presheafGerm_smul M hyV, hc', hn]

end Stacks.ModuleStalk

namespace AlgebraicGeometry

/-- A sheaf of modules on a locally ringed space, read as a presheaf of modules over the
structure presheaf. -/
abbrev structureModule (Z : LocallyRingedSpace.{u}) (G : SheafOfModules.{u} Z.ringCatSheaf) :
    PresheafOfModules.{u} (Z.sheaf.presheaf ⋙ forget₂ CommRingCat RingCat) := G.val

/-- The value of a meromorphic section over an open set, read as a section of the sheaf of
meromorphic sections regarded as a module over the structure sheaf. -/
abbrev MeromorphicSection.valOver {Z : LocallyRingedSpace.{u}}
    {G : SheafOfModules.{u} Z.ringCatSheaf} (t : MeromorphicSection Z.sheaf G) (U : Opens Z) :
    (Stacks.Divisors.meromorphicSectionRestrict Z.sheaf G).obj (op U) := t.val (op U)

/-- The value of a meromorphic section over an open set, read as a section of the sheaf of
meromorphic sections over the sheaf of meromorphic functions. -/
abbrev MeromorphicSection.valK {Z : LocallyRingedSpace.{u}}
    {G : SheafOfModules.{u} Z.ringCatSheaf} (t : MeromorphicSection Z.sheaf G) (U : Opens Z) :
    (meromorphicSectionSheaf Z.sheaf G).val.obj (op U) := t.val (op U)

/-- The pullback of a section of the structure sheaf to an open set of the source, read over
the structure presheaf. -/
abbrev pullbackSectionOver {X Y : LocallyRingedSpace.{u}} (f : X ⟶ Y) (U : Opens X)
    (V : Opens Y) (h : U ≤ (Opens.map f.base).obj V) (b : Y.sheaf.presheaf.obj (op V)) :
    X.sheaf.presheaf.obj (op U) := pullbackSection f U V h b

/-- The image of a section of the structure sheaf in the sheaf of meromorphic functions, read
over the `RingCat`-valued sheaf of rings. -/
abbrev toTotalQuotientOver (Z : LocallyRingedSpace.{u}) (U : Opens Z)
    (c : Z.sheaf.presheaf.obj (op U)) : Z.totalQuotientRingCatSheaf.obj.obj (op U) :=
  (toTotalQuotientSheaf Z.sheaf).hom.app (op U) c

/-- **The germ of the pullback of a basis is a basis.** If multiplication by `g` is bijective on
the sections of `G` over every open inside `V`, then multiplication by the germ at `x` of the
pullback of `g` is bijective on the stalk of `f^* G`. This is Tag 0098 at one point. -/
theorem bijective_smul_germ_modulePullbackUnit {X Y : LocallyRingedSpace.{u}} (f : X ⟶ Y)
    (G : SheafOfModules.{u} Y.ringCatSheaf) (x : X) (V : Opens Y)
    (hx : f.base x ∈ V) (g : (structureModule Y G).obj (op V))
    (hg : ∀ (V' : Opens Y) (hV' : V' ≤ V), Function.Bijective
      fun c : Y.sheaf.presheaf.obj (op V') => c • res (structureModule Y G) hV' g) :
    Function.Bijective fun r : X.sheaf.presheaf.stalk x =>
      r • germ (structureModule X ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj G))
        ((Opens.map f.base).obj V) x hx
        ((((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
          f.toShHom).unit.app G).val.app (op V)).hom g) := by
  let : Algebra (Y.sheaf.presheaf.stalk (f.base x)) (X.sheaf.presheaf.stalk x) :=
    (f.toShHom.hom.stalkMap x).hom.toAlgebra
  obtain ⟨e, he⟩ := RingedSpaceModuleAdjunction.exists_modulePullbackStalkLinearEquiv
    f.toShHom G x
  let e' : ↑((presheafOn (structureModule X
        ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj G))).stalk x) ≃ₗ[
      X.sheaf.presheaf.stalk x]
      TensorProduct (Y.sheaf.presheaf.stalk (f.base x)) (X.sheaf.presheaf.stalk x)
        ↑((presheafOn (structureModule Y G)).stalk (f.base x)) := e
  have he' : ∀ (W : Opens Y) (hxW : f.base x ∈ W) (t : (structureModule Y G).obj (op W)),
      e' (germ (structureModule X
          ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj G))
          ((Opens.map f.base).obj W) x hxW
          ((((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
            f.toShHom).unit.app G).val.app (op W)).hom t)) =
        (1 : X.sheaf.presheaf.stalk x) ⊗ₜ[Y.sheaf.presheaf.stalk (f.base x)]
          germ (structureModule Y G) W (f.base x) hxW t := he
  have hgx := bijective_smul_germ (O := Y.sheaf.presheaf) (M := structureModule Y G) g hg
    (f.base x) hx
  have h1 : Function.Bijective fun r : X.sheaf.presheaf.stalk x =>
      r • ((1 : X.sheaf.presheaf.stalk x) ⊗ₜ[Y.sheaf.presheaf.stalk (f.base x)]
        germ (structureModule Y G) V (f.base x) hx g) :=
    Stacks.Divisors.bijective_smul_one_tmul hgx
  have hgerm : germ
        (structureModule X ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj G))
        ((Opens.map f.base).obj V) x hx
        ((((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
          f.toShHom).unit.app G).val.app (op V)).hom g) =
      e'.symm ((1 : X.sheaf.presheaf.stalk x) ⊗ₜ[Y.sheaf.presheaf.stalk (f.base x)]
        germ (structureModule Y G) V (f.base x) hx g) := by
    rw [← he' V hx g, e'.symm_apply_apply]
  rw [show (fun r : X.sheaf.presheaf.stalk x =>
      r • germ
        (structureModule X ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj G))
        ((Opens.map f.base).obj V) x hx
        ((((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
          f.toShHom).unit.app G).val.app (op V)).hom g)) =
      e'.symm ∘ fun r : X.sheaf.presheaf.stalk x =>
        r • ((1 : X.sheaf.presheaf.stalk x) ⊗ₜ[Y.sheaf.presheaf.stalk (f.base x)]
          germ (structureModule Y G) V (f.base x) hx g) from
    funext fun r => by rw [hgerm]; exact (e'.symm.map_smul r _).symm]
  exact e'.symm.bijective.comp h1

variable {X Y : LocallyRingedSpace.{u}} (f : X ⟶ Y) (hf : PullbacksMeromorphicSections f)
  (F : SheafOfModules.{u} Y.ringCatSheaf)

/-- The pullback map on the sections of the sheaf of meromorphic sections over an open set of
the target. -/
abbrev meromorphicSectionPullbackApp (V : Opens Y)
    (z : (meromorphicSectionSheaf Y.sheaf F).val.obj (op V)) :
    (meromorphicSectionSheaf X.sheaf
      ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj F)).val.obj
        (op ((Opens.map f.base).obj V)) :=
  ((meromorphicSectionSheafPullback f hf F).val.app (op V)).hom z

/-- The pullback of a section of the structure sheaf to the whole inverse image is the
component of the structure morphism there. -/
theorem pullbackSectionOver_eq_structureSheafHom (V : Opens Y)
    (c : Y.sheaf.presheaf.obj (op V)) :
    pullbackSectionOver f ((Opens.map f.base).obj V) V le_rfl c =
      (RingedSpaceModuleAdjunction.structureSheafHom f.toShHom).hom.app (op V) c := by
  show X.presheaf.map (homOfLE le_rfl).op (f.c.app (op V) c) = _
  rw [show (homOfLE (le_rfl : (Opens.map f.base).obj V ≤ (Opens.map f.base).obj V)) = 𝟙 _ from
    Subsingleton.elim _ _, op_id, X.presheaf.map_id]
  rfl

/-- The unit of the pullback adjunction on the sections over an open set of the target. -/
abbrev modulePullbackUnitApp (V : Opens Y) (m : (structureModule Y F).obj (op V)) :
    (structureModule X ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj F)).obj
      (op ((Opens.map f.base).obj V)) :=
  (((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
    f.toShHom).unit.app F).val.app (op V)).hom m

/-- The unit of the pullback adjunction is semilinear over the structure morphism. -/
theorem modulePullbackUnitApp_smul (V : Opens Y) (c : Y.sheaf.presheaf.obj (op V))
    (m : (structureModule Y F).obj (op V)) :
    modulePullbackUnitApp f F V (c • m) =
      pullbackSectionOver f ((Opens.map f.base).obj V) V le_rfl c •
        modulePullbackUnitApp f F V m := by
  rw [pullbackSectionOver_eq_structureSheafHom f V c]
  exact (((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
    f.toShHom).unit.app F).val.app (op V)).hom.map_smul c m

/-- **The pullback of a meromorphic section, read over the inverse image of an open set.** Its
value there is the value of the inducing morphism of sheaves of meromorphic sections. -/
theorem pullbackMeromorphicSection_val_preimage (s : MeromorphicSection Y.sheaf F)
    (V : Opens Y) :
    (pullbackMeromorphicSection f hf F s).valK ((Opens.map f.base).obj V) =
      meromorphicSectionPullbackApp f hf F V (s.valK V) :=
  PresheafOfModules.sections_property
    (SheafOfModules.sectionsMap (meromorphicSectionSheafPullback f hf F) s)
    (homOfLE (le_top (a := V))).op

/-- **The pullback morphism on the meromorphic image of a section.** The meromorphic image over
`V` of a section `t` is carried to the meromorphic image over `f^{-1} V` of the pullback of
`t`; by the adjunction this property determines the pullback morphism. -/
theorem meromorphicSectionPullbackApp_toMeromorphicSectionSheaf (V : Opens Y)
    (t : (structureModule Y F).obj (op V)) :
    meromorphicSectionPullbackApp f hf F V
        (((Stacks.Divisors.toMeromorphicSectionSheaf Y.sheaf F).app (op V)).hom t) =
      ((Stacks.Divisors.toMeromorphicSectionSheaf X.sheaf
        ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj F)).app
          (op ((Opens.map f.base).obj V))).hom (modulePullbackUnitApp f F V t) :=
  congrArg (fun φ => ((SheafOfModules.Hom.val φ).app (op V)).hom t)
    (unit_comp_meromorphicSectionSheafPullback f hf F)

/-- Pulling a regular function back and regarding it as meromorphic agrees with regarding it as
meromorphic and pulling back. -/
@[ega "IV 21.8.3" "θ′ extends θ"]
theorem totalQuotientRingCatSheafPullback_app_toTotalQuotientSheaf (V : Opens Y)
    (b : Y.sheaf.presheaf.obj (op V)) :
    ((totalQuotientRingCatSheafPullback f hf).hom.app (op V)).hom (toTotalQuotientOver Y V b) =
      toTotalQuotientOver X ((Opens.map f.base).obj V)
        (pullbackSectionOver f ((Opens.map f.base).obj V) V le_rfl b) := by
  rw [pullbackSectionOver_eq_structureSheafHom f V b]
  exact (congrArg (fun φ : Y.ringCatSheaf ⟶ (ringCatSheafPushforward f).obj
    X.totalQuotientRingCatSheaf => (φ.hom.app (op V)).hom b)
      (toTotalQuotient_comp_totalQuotientRingCatSheafPullback f hf)).symm

/-- The pullback morphism on sheaves of meromorphic sections is semilinear over the structure
morphism: a regular multiplier pulls back to its pullback. -/
theorem meromorphicSectionPullbackApp_smul (V : Opens Y) (b : Y.sheaf.presheaf.obj (op V))
    (z : (meromorphicSectionSheaf Y.sheaf F).val.obj (op V)) :
    meromorphicSectionPullbackApp f hf F V (toTotalQuotientOver Y V b • z) =
      toTotalQuotientOver X ((Opens.map f.base).obj V)
          (pullbackSectionOver f ((Opens.map f.base).obj V) V le_rfl b) •
        meromorphicSectionPullbackApp f hf F V z := by
  rw [← totalQuotientRingCatSheafPullback_app_toTotalQuotientSheaf f hf V b]
  exact ((meromorphicSectionSheafPullback f hf F).val.app (op V)).hom.map_smul _ z

/-- **The pullback of the normal form of a meromorphic section.** If `b · s = t` over `V` with
`t` a section of `F`, then the pullback of `b` times the pullback of `s` is the meromorphic
image of the pullback of `t` over `f^{-1} V`. -/
theorem smul_pullbackMeromorphicSection_valOver (s : MeromorphicSection Y.sheaf F) (V : Opens Y)
    (b : Y.sheaf.presheaf.obj (op V)) (a : (structureModule Y F).obj (op V))
    (hba : b • s.valOver V = ((Stacks.Divisors.toMeromorphicSectionSheaf Y.sheaf F).app
      (op V)).hom a) :
    pullbackSectionOver f ((Opens.map f.base).obj V) V le_rfl b •
        (pullbackMeromorphicSection f hf F s).valOver ((Opens.map f.base).obj V) =
      ((Stacks.Divisors.toMeromorphicSectionSheaf X.sheaf
        ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj F)).app
          (op ((Opens.map f.base).obj V))).hom (modulePullbackUnitApp f F V a) := by
  have hbaK : toTotalQuotientOver Y V b • s.valK V =
      ((Stacks.Divisors.toMeromorphicSectionSheaf Y.sheaf F).app (op V)).hom a := hba
  show toTotalQuotientOver X ((Opens.map f.base).obj V)
      (pullbackSectionOver f ((Opens.map f.base).obj V) V le_rfl b) •
      (pullbackMeromorphicSection f hf F s).valK ((Opens.map f.base).obj V) = _
  rw [pullbackMeromorphicSection_val_preimage f hf F s V,
    ← meromorphicSectionPullbackApp_smul f hf F V b (s.valK V), hbaK,
    meromorphicSectionPullbackApp_toMeromorphicSectionSheaf f hf F V a]


section GermCriteria

variable {Z : LocallyRingedSpace.{u}}

/-- Every germ of a meromorphic section is a germ of its value on the whole space. -/
theorem germ_valOver_eq_top {G : SheafOfModules.{u} Z.ringCatSheaf}
    (t : MeromorphicSection Z.sheaf G) (U : Opens Z) (z : Z) (hz : z ∈ U) :
    germ (Stacks.Divisors.meromorphicSectionRestrict Z.sheaf G) U z hz (t.valOver U) =
      germ (Stacks.Divisors.meromorphicSectionRestrict Z.sheaf G) ⊤ z trivial (t.valOver ⊤) := by
  have hres : res (Stacks.Divisors.meromorphicSectionRestrict Z.sheaf G) (le_top (a := U))
      (t.valOver ⊤) = t.valOver U :=
    PresheafOfModules.sections_property t (homOfLE (le_top (a := U))).op
  rw [← hres]
  exact germ_res (Stacks.Divisors.meromorphicSectionRestrict Z.sheaf G) le_top hz (t.valOver ⊤)

/-- The germ of a multiple of a meromorphic section is the multiple of its germ on the whole
space. -/
private theorem germ_smul_valOver_top {G : SheafOfModules.{u} Z.ringCatSheaf}
    (t : MeromorphicSection Z.sheaf G) {U : Opens Z} (c : Z.sheaf.presheaf.obj (op U)) (z : Z)
    (hz : z ∈ U) :
    Z.sheaf.presheaf.germ U z hz c •
        germ (Stacks.Divisors.meromorphicSectionRestrict Z.sheaf G) ⊤ z trivial
          (t.valOver ⊤) =
      germ (Stacks.Divisors.meromorphicSectionRestrict Z.sheaf G) U z hz (c • t.valOver U) := by
  rw [← germ_valOver_eq_top t U z hz, presheafGerm_smul]

/-- A section of the structure sheaf which is a nonzerodivisor on the sections over every
smaller open set has nonzerodivisor germs. -/
theorem isSMulRegular_germ_of_forall_mul_eq_zero {V : Opens Z}
    (α : Z.sheaf.presheaf.obj (op V))
    (h : ∀ (W : Opens Z) (hWV : W ≤ V) (c : Z.sheaf.presheaf.obj (op W)),
      (Z.sheaf.presheaf.map (homOfLE hWV).op).hom α * c = 0 → c = 0)
    (z : Z) (hz : z ∈ V) :
    IsSMulRegular (Z.sheaf.presheaf.stalk z) (Z.sheaf.presheaf.germ V z hz α) := by
  refine IsSMulRegular.of_right_eq_zero_of_smul fun τ hτ => ?_
  obtain ⟨W, hWV, hzW, c, hc⟩ := Z.sheaf.presheaf.exists_le_germ_eq τ hz
  have hmul : Z.sheaf.presheaf.germ W z hzW
      ((Z.sheaf.presheaf.map (homOfLE hWV).op).hom α * c) = 0 := by
    rw [map_mul, Z.sheaf.presheaf.germ_res_apply (homOfLE hWV) z hzW α, hc]
    exact hτ
  obtain ⟨W', hzW', i, j, hij⟩ := TopCat.Presheaf.germ_eq Z.sheaf.presheaf z hzW hzW _ _
    (hmul.trans (map_zero (ConcreteCategory.hom (Z.sheaf.presheaf.germ W z hzW))).symm)
  cases Subsingleton.elim i j
  have hzero : (Z.sheaf.presheaf.map (homOfLE ((leOfHom i).trans hWV)).op).hom α *
      (Z.sheaf.presheaf.map (homOfLE (leOfHom i)).op).hom c = 0 := by
    have hmap := (Z.sheaf.presheaf.map (homOfLE (leOfHom i)).op).hom.map_mul
      ((Z.sheaf.presheaf.map (homOfLE hWV).op).hom α) c
    have hres : (Z.sheaf.presheaf.map (homOfLE (leOfHom i)).op).hom
        ((Z.sheaf.presheaf.map (homOfLE hWV).op).hom α) =
        (Z.sheaf.presheaf.map (homOfLE ((leOfHom i).trans hWV)).op).hom α := by
      rw [← CommRingCat.comp_apply, ← Z.sheaf.presheaf.map_comp]
      rfl
    rw [← hres, ← hmap]
    exact hij.trans (map_zero _)
  have hcz := h W' ((leOfHom i).trans hWV) _ hzero
  rw [← hc, ← Z.sheaf.presheaf.germ_res_apply (homOfLE (leOfHom i)) z hzW' c, hcz, map_zero]

/-- The map induced on stalks by the canonical map to the sheaf of meromorphic sections is
linear. -/
theorem toMeromorphicSectionStalk_smul (G : SheafOfModules.{u} Z.ringCatSheaf) (z : Z)
    (c : Z.sheaf.presheaf.stalk z) (m : ↑((presheafOn (structureModule Z G)).stalk z)) :
    Stacks.Divisors.toMeromorphicSectionStalk Z.sheaf G z (c • m) =
      c • Stacks.Divisors.toMeromorphicSectionStalk Z.sheaf G z m :=
  LinearMap.map_smul (Stacks.Divisors.toMeromorphicSectionStalk Z.sheaf G z) c m

/-- From a proportionality between two germs of meromorphic sections and the vanishing of a
multiple of the first, the corresponding multiple of the second vanishes. -/
theorem smul_mul_eq_zero_of_smul_eq (G : SheafOfModules.{u} Z.ringCatSheaf) (z : Z)
    (c d r : Z.sheaf.presheaf.stalk z)
    (w n : ↑((presheafOn (Stacks.Divisors.meromorphicSectionRestrict Z.sheaf G)).stalk z))
    (hQ : d • w = c • n) (hr : r • w = 0) : (r * c) • n = 0 := by
  rw [mul_smul, ← hQ, ← mul_smul, mul_comm, mul_smul, hr, smul_zero]

/-- Restricting a multiple of a meromorphic section restricts the multiplier. -/
theorem resK_smul (G : SheafOfModules.{u} Z.ringCatSheaf) (t : MeromorphicSection Z.sheaf G)
    {U W : Opens Z} (h : W ≤ U) (d : Z.totalQuotientRingCatSheaf.obj.obj (op U)) :
    ((meromorphicSectionSheaf Z.sheaf G).val.map (homOfLE h).op).hom (d • t.valK U) =
      (Z.totalQuotientRingCatSheaf.obj.map (homOfLE h).op).hom d • t.valK W := by
  rw [(meromorphicSectionSheaf Z.sheaf G).val.map_smul (homOfLE h).op d (t.valK U)]
  exact congrArg _ (PresheafOfModules.sections_property t (homOfLE h).op)

/-- A meromorphic section is regular as soon as every multiplier killing it over an open set
vanishes. -/
theorem isRegularMeromorphicSection_of_forall_eq_zero (G : SheafOfModules.{u} Z.ringCatSheaf)
    (t : MeromorphicSection Z.sheaf G)
    (h : ∀ (U : Opens Z) (d : Z.totalQuotientRingCatSheaf.obj.obj (op U)),
      d • t.valK U = 0 → d = 0) :
    IsRegularMeromorphicSection Z.sheaf G t := by
  refine CategoryTheory.SheafOfModules.mono_of_forall_app_injective _ fun U => ?_
  intro c c' hcc'
  have hsub : (((meromorphicSectionSheaf Z.sheaf G).unitHomEquiv.symm t).val.app U).hom
      (c - c') = 0 :=
    ((((meromorphicSectionSheaf Z.sheaf G).unitHomEquiv.symm t).val.app U).hom.map_sub c c').trans
      (sub_eq_zero.mpr hcc')
  exact sub_eq_zero.mp (h U.unop (c - c') hsub)

/-- Every meromorphic function on a locally ringed space is locally a fraction, in the
`RingCat` spelling of the sheaf of meromorphic functions. -/
theorem exists_nhds_mul_toTotalQuotientOver_eq (U : Opens Z)
    (c : Z.totalQuotientRingCatSheaf.obj.obj (op U)) {z : Z} (hz : z ∈ U) :
    ∃ (W : Opens Z) (hWU : W ≤ U), z ∈ W ∧ ∃ a b : Z.sheaf.presheaf.obj (op W),
      IsUnit (toTotalQuotientOver Z W b) ∧
        (Z.totalQuotientRingCatSheaf.obj.map (homOfLE hWU).op).hom c *
            toTotalQuotientOver Z W b = toTotalQuotientOver Z W a :=
  exists_nhds_mul_toTotalQuotientSheaf_app_eq Z.sheaf U c hz

/-- A multiple of a multiplier which kills a meromorphic section kills it too. -/
theorem smul_mul_eq_zero (G : SheafOfModules.{u} Z.ringCatSheaf)
    (t : MeromorphicSection Z.sheaf G) (W : Opens Z)
    (p q : Z.totalQuotientRingCatSheaf.obj.obj (op W)) (hp : p • t.valK W = 0) :
    (p * q) • t.valK W = 0 :=
  have hcomm : p * q = q * p :=
    mul_comm (G := ↑((totalQuotientSheaf Z.sheaf).presheaf.obj (op W))) p q
  (congrArg (fun y => y • t.valK W) hcomm).trans
    ((mul_smul q p (t.valK W)).trans
      ((congrArg (fun y => q • y) hp).trans (smul_zero q)))

end GermCriteria

section Numerator

variable {Z : LocallyRingedSpace.{u}} (G : SheafOfModules.{u} Z.ringCatSheaf)
  (t : MeromorphicSection Z.sheaf G)

/-- **The numerator of a regular meromorphic section is a nonzerodivisor.** If `b · t` is the
meromorphic image of `α · g` over `V` with the germs of `b` everywhere nonzerodivisors, then
multiplication by `α` is injective on the sections over every open inside `V`. -/
theorem isSMulRegular_numerator (ht : IsRegularMeromorphicSection Z.sheaf G t)
    {V : Opens Z} {b : Z.sheaf.presheaf.obj (op V)}
    (hb : ∀ (z : Z) (hz : z ∈ V), Z.sheaf.presheaf.germ V z hz b ∈
      nonZeroDivisors ↑(Z.sheaf.presheaf.stalk z))
    {g : (structureModule Z G).obj (op V)} {α : Z.sheaf.presheaf.obj (op V)}
    (hba : b • t.valOver V =
      ((Stacks.Divisors.toMeromorphicSectionSheaf Z.sheaf G).app (op V)).hom (α • g))
    {W : Opens Z} (hWV : W ≤ V) (c : Z.sheaf.presheaf.obj (op W))
    (hc : (Z.sheaf.presheaf.map (homOfLE hWV).op).hom α * c = 0) : c = 0 := by
  set rb := (Z.sheaf.presheaf.map (homOfLE hWV).op).hom b with hrb
  set rα := (Z.sheaf.presheaf.map (homOfLE hWV).op).hom α with hrα
  set rg := res (structureModule Z G) hWV g with hrg
  -- restrict the normal form to `W`
  have e1 : res (Stacks.Divisors.meromorphicSectionRestrict Z.sheaf G) hWV (b • t.valOver V)
      = rb • res (Stacks.Divisors.meromorphicSectionRestrict Z.sheaf G) hWV (t.valOver V) :=
    res_smul _ hWV b (t.valOver V)
  have e2 : res (Stacks.Divisors.meromorphicSectionRestrict Z.sheaf G) hWV (t.valOver V)
      = t.valOver W := PresheafOfModules.sections_property t (homOfLE hWV).op
  have e3 : res (Stacks.Divisors.meromorphicSectionRestrict Z.sheaf G) hWV
        (((Stacks.Divisors.toMeromorphicSectionSheaf Z.sheaf G).app (op V)).hom (α • g))
      = ((Stacks.Divisors.toMeromorphicSectionSheaf Z.sheaf G).app (op W)).hom
        (res (structureModule Z G) hWV (α • g)) :=
    res_app (Stacks.Divisors.toMeromorphicSectionSheaf Z.sheaf G) hWV (α • g)
  have e4 : res (structureModule Z G) hWV (α • g) = rα • rg := res_smul _ hWV α g
  have hres : rb • t.valOver W =
      ((Stacks.Divisors.toMeromorphicSectionSheaf Z.sheaf G).app (op W)).hom (rα • rg) := by
    rw [← e2, ← e1, hba, e3, e4]
  -- multiplying the normal form by `c` kills it
  have hzero : toTotalQuotientOver Z W (rb * c) • t.valK W = 0 := by
    have hmapsmul := ((Stacks.Divisors.toMeromorphicSectionSheaf Z.sheaf G).app
      (op W)).hom.map_smul c (rα • rg)
    have hvanish : c • (rα • rg) = (0 : (structureModule Z G).obj (op W)) := by
      rw [smul_smul, mul_comm c rα, hc, zero_smul]
    have h1 : (c * rb) • t.valOver W = (0 : (Stacks.Divisors.meromorphicSectionRestrict
        Z.sheaf G).obj (op W)) :=
      (mul_smul c rb (t.valOver W)).trans
        (((congrArg (fun y => c • y) hres).trans hmapsmul.symm).trans
          ((congrArg (fun y => ((Stacks.Divisors.toMeromorphicSectionSheaf Z.sheaf G).app
            (op W)).hom y) hvanish).trans (map_zero _)))
    rw [mul_comm rb c]
    exact h1
  -- regularity of `t` forces the multiplier to vanish
  have hmul : toTotalQuotientOver Z W (rb * c) = 0 :=
    ((CategoryTheory.SheafOfModules.app_injective_of_mono ht (op W)).eq_iff'
      (zero_smul _ _)).mp hzero
  -- the denominator is invertible, so the cofactor vanishes
  have hunit : IsUnit (toTotalQuotientOver Z W rb) := by
    refine isUnit_toTotalQuotientSheaf_app Z.sheaf W rb fun y hy => ?_
    rw [hrb, Z.sheaf.presheaf.germ_res_apply (homOfLE hWV) y hy b]
    exact hb y (hWV hy)
  refine Stacks.SheafifyMono.injective_toTotalQuotientSheaf_app Z.sheaf W ?_
  rw [map_zero]
  refine (hunit.mul_right_eq_zero).mp ?_
  show toTotalQuotientOver Z W rb * toTotalQuotientOver Z W c = 0
  exact (map_mul ((toTotalQuotientSheaf Z.sheaf).hom.app (op W)).hom rb c).symm.trans hmul

end Numerator


/-- A scalar killing the image of a basis in a localization of modules at nonzerodivisors
vanishes, after cancelling one nonzerodivisor factor. -/
private theorem eq_zero_of_smul_localized {R M M' : Type*} [CommRing R] [AddCommGroup M]
    [AddCommGroup M'] {instM : Module R M} {instM' : Module R M'} (S : Submonoid R)
    (hS : S ≤ nonZeroDivisors R)
    (φ : M →ₗ[R] M') (hloc : IsLocalizedModule S φ) {m : M}
    (hm : Function.Injective fun c : R => c • m) {A r : R} (hA : IsSMulRegular R A)
    (h : (r * A) • φ m = 0) : r = 0 := by
  have h1 : φ ((r * A) • m) = 0 := by rw [map_smul]; exact h
  obtain ⟨τ, hτ⟩ := (IsLocalizedModule.eq_zero_iff S φ).mp h1
  have h2 : ((τ : R) * (r * A)) • m = 0 := by rw [mul_smul]; exact hτ
  have h3 : (τ : R) * (r * A) = 0 := (hm.eq_iff' (zero_smul _ _)).mp h2
  have h4 : r * A = 0 := (mem_nonZeroDivisors_iff.mp (hS τ.2)).1 _ h3
  refine hA ?_
  show A • r = A • (0 : R)
  rw [smul_eq_mul, smul_zero, mul_comm]
  exact h4

section Main

/-- **The germ form of the pulled-back normal form.** At a point `x` over `V`, the germ of the
pullback of `b` times the germ of the pullback of `s` is the meromorphic image of the germ of
the pullback of the numerator. -/
theorem germ_smul_pullbackMeromorphicSection (L : SheafOfModules.{u} Y.ringCatSheaf)
    (s : MeromorphicSection Y.sheaf L) (V : Opens Y) (b : Y.sheaf.presheaf.obj (op V))
    (a : (structureModule Y L).obj (op V))
    (hba : b • s.valOver V =
      ((Stacks.Divisors.toMeromorphicSectionSheaf Y.sheaf L).app (op V)).hom a)
    (x : X) (hx : f.base x ∈ V) :
    X.sheaf.presheaf.germ ((Opens.map f.base).obj V) x hx
          (pullbackSectionOver f ((Opens.map f.base).obj V) V le_rfl b) •
        germ (Stacks.Divisors.meromorphicSectionRestrict X.sheaf
          ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L)) ⊤ x trivial
          ((pullbackMeromorphicSection f hf L s).valOver ⊤) =
      Stacks.Divisors.toMeromorphicSectionStalk X.sheaf
        ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L) x
        (germ (structureModule X
          ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L))
          ((Opens.map f.base).obj V) x hx (modulePullbackUnitApp f L V a)) := by
  have hgermR : Stacks.Divisors.toMeromorphicSectionStalk X.sheaf
        ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L) x
        (germ (structureModule X
          ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L))
          ((Opens.map f.base).obj V) x hx (modulePullbackUnitApp f L V a)) =
      germ (Stacks.Divisors.meromorphicSectionRestrict X.sheaf
          ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L))
        ((Opens.map f.base).obj V) x hx
        (((Stacks.Divisors.toMeromorphicSectionSheaf X.sheaf
          ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L)).app
            (op ((Opens.map f.base).obj V))).hom (modulePullbackUnitApp f L V a)) :=
    stalkMap_germ (Stacks.Divisors.toMeromorphicSectionSheaf X.sheaf
      ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L)) x
      ((Opens.map f.base).obj V) hx (modulePullbackUnitApp f L V a)
  refine (germ_smul_valOver_top (Z := X)
    (G := (RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L)
    (pullbackMeromorphicSection f hf L s) _ x hx).trans ?_
  rw [smul_pullbackMeromorphicSection_valOver f hf L s V b a hba]
  exact hgermR.symm


/-- **The germ of the pullback of a regular meromorphic section is a nonzerodivisor multiple of
a basis.** Concretely: a scalar of the local ring at `x` killing that germ vanishes. This is the
pointwise content of part (2) of Tag 02OY. -/
theorem isSMulRegular_germ_pullbackMeromorphicSection (L : SheafOfModules.{u} Y.ringCatSheaf)
    (hgen : ∀ y : Y, ∃ (V : Opens Y) (_ : y ∈ V) (g : (structureModule Y L).obj (op V)),
      ∀ (V' : Opens Y) (hV' : V' ≤ V), Function.Bijective
        fun c : Y.sheaf.presheaf.obj (op V') => c • res (structureModule Y L) hV' g)
    (s : MeromorphicSection Y.sheaf L) (hs : IsRegularMeromorphicSection Y.sheaf L s) (x : X)
    (r : X.sheaf.presheaf.stalk x)
    (hr : r • germ (Stacks.Divisors.meromorphicSectionRestrict X.sheaf
        ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L)) ⊤ x trivial
      ((pullbackMeromorphicSection f hf L s).valOver ⊤) = 0) : r = 0 := by
  obtain ⟨V₀, hyV₀, g, hgbij⟩ := hgen (f.base x)
  obtain ⟨V, hVV₀, hyV, b, hb, a, hba⟩ := Stacks.Divisors.exists_nhds_smul_eq Y.sheaf L
    (f.base x) V₀ hyV₀ (s.valOver V₀)
  have hresV : res (Stacks.Divisors.meromorphicSectionRestrict Y.sheaf L) hVV₀ (s.valOver V₀) =
      s.valOver V := PresheafOfModules.sections_property s (homOfLE hVV₀).op
  rw [hresV] at hba
  obtain ⟨α, hα⟩ := (hgbij V hVV₀).surjective a
  have hαa : α • res (structureModule Y L) hVV₀ g = a := hα
  rw [← hαa] at hba
  -- the generator restricted to `V` generates on every smaller open
  have hgbijV : ∀ (V' : Opens Y) (hV' : V' ≤ V), Function.Bijective
      fun c : Y.sheaf.presheaf.obj (op V') =>
        c • res (structureModule Y L) hV' (res (structureModule Y L) hVV₀ g) := by
    intro V' hV'
    have hrr : res (structureModule Y L) hV' (res (structureModule Y L) hVV₀ g) =
        res (structureModule Y L) (hV'.trans hVV₀) g := res_res _ hVV₀ hV' g
    rw [hrr]
    exact hgbij V' (hV'.trans hVV₀)
  -- the numerator and the denominator are regular sections on `V`
  have hαreg : IsRegularSectionOn Y V α :=
    (isRegularSectionOn_iff_forall_isSMulRegular_germ Y V α).mpr
      (isSMulRegular_germ_of_forall_mul_eq_zero α
        (fun W hWV c hc => isSMulRegular_numerator L s hs hb hba hWV c hc))
  have hbgerm : ∀ (z : Y) (hz : z ∈ V),
      IsSMulRegular (Y.presheaf.stalk z) (Y.presheaf.germ V z hz b) := by
    intro z hz
    have hbz : Y.presheaf.germ V z hz b ∈ nonZeroDivisors ↑(Y.presheaf.stalk z) := hb z hz
    exact (isRegular_iff_mem_nonZeroDivisors.mpr hbz).left
  have hbreg : IsRegularSectionOn Y V b :=
    (isRegularSectionOn_iff_forall_isSMulRegular_germ Y V b).mpr hbgerm
  -- and so are their pullbacks
  have hA := (isRegularSectionOn_iff_forall_isSMulRegular_germ X ((Opens.map f.base).obj V)
    (pullbackSection f ((Opens.map f.base).obj V) V le_rfl α)).mp
      (hf ((Opens.map f.base).obj V) V le_rfl α hαreg) x hyV
  have hB := (isRegularSectionOn_iff_forall_isSMulRegular_germ X ((Opens.map f.base).obj V)
    (pullbackSection f ((Opens.map f.base).obj V) V le_rfl b)).mp
      (hf ((Opens.map f.base).obj V) V le_rfl b hbreg) x hyV
  -- the pullback of the normal form
  have hQ := germ_smul_pullbackMeromorphicSection f hf L s V b
    (α • res (structureModule Y L) hVV₀ g) hba x hyV
  rw [modulePullbackUnitApp_smul f L V α (res (structureModule Y L) hVV₀ g),
    presheafGerm_smul (structureModule X
      ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L)) hyV
      (pullbackSectionOver f ((Opens.map f.base).obj V) V le_rfl α)
      (modulePullbackUnitApp f L V (res (structureModule Y L) hVV₀ g)),
    toMeromorphicSectionStalk_smul (Z := X)
      ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L) x] at hQ
  have hbasis := bijective_smul_germ_modulePullbackUnit f L x V hyV
    (res (structureModule Y L) hVV₀ g) hgbijV
  have hA' : IsSMulRegular (X.sheaf.presheaf.stalk x)
      (X.sheaf.presheaf.germ ((Opens.map f.base).obj V) x hyV
        (pullbackSectionOver f ((Opens.map f.base).obj V) V le_rfl α)) := hA
  refine eq_zero_of_smul_localized (Stacks.Divisors.regularGerms X.sheaf x)
    (Stacks.Divisors.regularGerms_le_nonZeroDivisors X.sheaf x)
    (Stacks.Divisors.toMeromorphicSectionStalk X.sheaf
      ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L) x)
    (Stacks.Divisors.isLocalizedModule_toMeromorphicSectionStalk X.sheaf
      ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L) x)
    hbasis.injective hA' ?_
  exact smul_mul_eq_zero_of_smul_eq (Z := X)
    ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L) x _ _ r _ _ hQ hr

end Main


/-- **The pullback of a regular meromorphic section is regular**, for a module generated by one
section near every point. -/
theorem isRegularMeromorphicSection_pullbackMeromorphicSection_of_exists_generator
    (L : SheafOfModules.{u} Y.ringCatSheaf)
    (hgen : ∀ y : Y, ∃ (V : Opens Y) (_ : y ∈ V) (g : (structureModule Y L).obj (op V)),
      ∀ (V' : Opens Y) (hV' : V' ≤ V), Function.Bijective
        fun c : Y.sheaf.presheaf.obj (op V') => c • res (structureModule Y L) hV' g)
    (s : MeromorphicSection Y.sheaf L) (hs : IsRegularMeromorphicSection Y.sheaf L s) :
    IsRegularMeromorphicSection X.sheaf
      ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L)
      (pullbackMeromorphicSection f hf L s) := by
  refine isRegularMeromorphicSection_of_forall_eq_zero
    ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L) _ fun U d hsub => ?_
  -- it is enough to kill every germ
  refine TopCat.Presheaf.section_ext (totalQuotientSheaf X.sheaf) U d 0 fun z hz => ?_
  rw [map_zero]
  obtain ⟨W, hWU, hzW, a', b', hunit, hfrac⟩ :=
    exists_nhds_mul_toTotalQuotientOver_eq (Z := X) U d hz
  -- its numerator kills the pullback, hence vanishes
  have hres : (X.totalQuotientRingCatSheaf.obj.map (homOfLE hWU).op).hom d •
      (pullbackMeromorphicSection f hf L s).valK W = 0 := by
    rw [← resK_smul (Z := X) ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L)
      (pullbackMeromorphicSection f hf L s) hWU d, hsub, map_zero]
    rfl
  have hnum : toTotalQuotientOver X W a' •
      (pullbackMeromorphicSection f hf L s).valK W = 0 :=
    hfrac ▸ smul_mul_eq_zero (Z := X)
      ((RingedSpaceModuleAdjunction.modulePullback f.toShHom).obj L)
      (pullbackMeromorphicSection f hf L s) W _ _ hres
  have hzeroa : a' = 0 := by
    refine TopCat.Presheaf.section_ext X.sheaf W a' 0 fun z' hz' => ?_
    rw [map_zero]
    refine isSMulRegular_germ_pullbackMeromorphicSection f hf L hgen s hs z'
      (X.sheaf.presheaf.germ W z' hz' a') ?_
    have hnum' : a' • (pullbackMeromorphicSection f hf L s).valOver W = 0 := hnum
    rw [germ_smul_valOver_top (pullbackMeromorphicSection f hf L s) a' z' hz', hnum', germ_zero]
  -- so the fraction has zero numerator and the multiplier vanishes near `z`
  have hrzero : (X.totalQuotientRingCatSheaf.obj.map (homOfLE hWU).op).hom d = 0 :=
    (hunit.mul_left_eq_zero).mp (hfrac.trans ((congrArg (toTotalQuotientOver X W) hzeroa).trans
      (map_zero ((toTotalQuotientSheaf X.sheaf).hom.app (op W)).hom)))
  have hrzero' : ((totalQuotientSheaf X.sheaf).presheaf.map (homOfLE hWU).op).hom d = 0 := hrzero
  have hgerm := (totalQuotientSheaf X.sheaf).presheaf.germ_res_apply (homOfLE hWU) z hzW d
  exact (hgerm.symm.trans ((congrArg
    (ConcreteCategory.hom ((totalQuotientSheaf X.sheaf).presheaf.germ W z hzW)) hrzero').trans
      (map_zero _)))

end AlgebraicGeometry

end
