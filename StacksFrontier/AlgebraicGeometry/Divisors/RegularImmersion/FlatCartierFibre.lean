module

public import StacksFrontier.AlgebraicGeometry.Divisors.RegularImmersion.LocallyPrincipalFibre
public import StacksFrontier.AlgebraicGeometry.Morphisms.FinitePresentation.Basic
import StacksCore.Tactic.EgaSgaAttribute

/-!
# A closed subscheme flat over the base with Cartier fibre

Let `f : X ⟶ S` be flat and locally of finite presentation, let `Z` be a closed subscheme of `X`
of finite presentation over `X` and let `x` be a point of `Z` at which `Z` is flat over `S` and
whose fibre `Z_{f x}` is an effective Cartier divisor in a neighbourhood of `x`.  Then `Z` is
*locally principal* near `x`, and therefore agrees on an affine open neighbourhood of `x` with a
relative effective Cartier divisor over `S`.

## Main results

* `Stacks.Divisors.stalkIdeal_comap_fiberι_eq_map`: the ideal that the fibre of a closed subscheme
  cuts out in a local ring of the fibre is the image of the ideal the subscheme cuts out in the
  local ring of the ambient scheme.
* `Stacks.Divisors.exists_mem_stalkIdeal_map_eq_span_of_fibre`: if the fibre of `Z` is an
  effective Cartier divisor near `x`, the ideal cut out by `Z` in `𝒪_{X, x}` contains an element
  which generates that ideal modulo the extended maximal ideal of `𝒪_{S, f x}` and is a
  nonzerodivisor there.
* `Stacks.Divisors.exists_affineOpen_ideal_isPrincipal_of_fibre`: the ideal of `Z` is principal
  on an affine open neighbourhood of `x`.
* `Stacks.Divisors.exists_isRelativeEffectiveCartierDivisor_of_flat_of_finitePresentation`: `Z`
  restricts to a relative effective Cartier divisor over `S` on an affine open neighbourhood of
  `x`.
* `Stacks.Divisors.isRelativeEffectiveCartierDivisor_of_flat_of_fibres`: a closed subscheme flat
  and locally of finite presentation over `S` all of whose fibres are effective Cartier divisors
  is a relative effective Cartier divisor over `S`.

## References

* [Stacks Project, Tag 062Y, part (2)](https://stacks.math.columbia.edu/tag/062Y)
* [Stacks Project, Tag 046Y](https://stacks.math.columbia.edu/tag/046Y)
* [Stacks Project, Tag 02FV](https://stacks.math.columbia.edu/tag/02FV)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open Stacks.AlgebraicGeometry
open Stacks.RingTheory.SpreadingOut

universe u

namespace Stacks.Divisors

variable {X S : Scheme.{u}}

/-! ### The ideal cut out in a local ring of the fibre -/

/-- **A point of a closed subscheme is a point of its fibre.** -/
theorem mem_support_comap_fiberι (f : X ⟶ S) (Z : X.IdealSheafData) (x : X)
    (hx : x ∈ Z.support) : f.asFiber x ∈ (Z.comap (f.fiberι (f x))).support := by
  have hgφsupp : f.fiberι (f x) (f.asFiber x) ∈ Z.support := by
    rw [f.fiberι_asFiber x]; exact hx
  rw [Scheme.IdealSheafData.support_comap]
  exact hgφsupp

/-- **The ideal cut out in a local ring of the fibre.**  The ideal that the fibre of a closed
subscheme `Z` of `X` cuts out in the local ring of the fibre at a point `x` is the image of the
ideal that `Z` cuts out in `𝒪_{X, x}`, along the quotient by the extended maximal ideal of
`𝒪_{S, f x}` followed by `AlgebraicGeometry.quotientStalkEquivFiberStalk`. -/
theorem stalkIdeal_comap_fiberι_eq_map (f : X ⟶ S) (Z : X.IdealSheafData) (x : X)
    (hx : x ∈ Z.support)
    (hx' : f.asFiber x ∈ (Z.comap (f.fiberι (f x))).support) :
    stalkIdeal (Z.comap (f.fiberι (f x))) (f.asFiber x) hx'
      = Ideal.map ((quotientStalkEquivFiberStalk f x).toRingHom.comp
          (Ideal.Quotient.mk (Ideal.map (f.stalkMap x).hom
            (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))))) (stalkIdeal Z x hx) := by
  have hgφ : f.fiberι (f x) (f.asFiber x) = x := f.fiberι_asFiber x
  have hgφsupp : f.fiberι (f x) (f.asFiber x) ∈ Z.support := by rw [hgφ]; exact hx
  set P : Ideal (X.presheaf.stalk x) := Ideal.map (f.stalkMap x).hom
    (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))) with hP
  have hcomp : ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom.comp
        (X.presheaf.stalkCongr (Inseparable.of_eq hgφ.symm)).hom.hom
      = (quotientStalkEquivFiberStalk f x).toRingHom.comp (Ideal.Quotient.mk P) :=
    RingHom.ext fun b => (quotientStalkEquivFiberStalk_mk f x b).symm
  rw [stalkIdeal_comap Z (f.fiberι (f x)) (f.asFiber x) hx' hgφsupp,
    ← stalkIdeal_congr Z hgφ.symm hx hgφsupp, Ideal.map_map, hcomp]

/-! ### The fibre dictionary, without local principality -/

/-- **The extension of a principal ideal is generated by the image of its generator.** -/
private theorem map_span_singleton_eq {R T : Type*} [CommRing R] [CommRing T] (φ : R →+* T)
    (a : R) : (Ideal.span {a}).map φ = Ideal.span {φ a} := by
  rw [Ideal.map_span, Set.image_singleton]

/-- **An ideal whose extension along a ring isomorphism is principal is principal.** -/
private theorem eq_span_of_map_eq_span {R T : Type*} [CommRing R] [CommRing T] (e : R ≃+* T)
    (J : Ideal R) (b : T) (h : Ideal.map e.toRingHom J = Ideal.span {b}) :
    J = Ideal.span {e.symm b} := by
  have hcomp : (e.symm.toRingHom).comp e.toRingHom = RingHom.id R :=
    RingHom.ext fun z => e.symm_apply_apply z
  have h2 := congrArg (Ideal.map e.symm.toRingHom) h
  rwa [Ideal.map_map, hcomp, Ideal.map_id, map_span_singleton_eq] at h2

/-- **A Cartier divisor on the fibre, read in the local ring, with no principality assumed.**
Let `f : X ⟶ S` be a morphism of schemes, let `Z` be a closed subscheme of `X` and let `x` be a
point of `Z` whose fibre over `f x` is, near `x`, an effective Cartier divisor.  Then the ideal
that `Z` cuts out in `𝒪_{X, x}` contains an element whose class modulo the extended maximal ideal
of `𝒪_{S, f x}` is a nonzerodivisor and generates the image of that ideal — a proper ideal of the
local ring of the fibre. -/
theorem exists_mem_stalkIdeal_map_eq_span_of_fibre (f : X ⟶ S) (Z : X.IdealSheafData) (x : X)
    (hx : x ∈ Z.support)
    (hfib : ∃ V : (f.fiber (f x)).Opens, f.asFiber x ∈ V ∧
      IsEffectiveCartierDivisor ((Z.comap (f.fiberι (f x))).comap V.ι)) :
    ∃ h ∈ stalkIdeal Z x hx,
      IsSMulRegular (X.presheaf.stalk x ⧸ Ideal.map (f.stalkMap x).hom
          (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))))
        (Ideal.Quotient.mk (Ideal.map (f.stalkMap x).hom
          (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) h) ∧
      (stalkIdeal Z x hx).map (Ideal.Quotient.mk (Ideal.map (f.stalkMap x).hom
          (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))))
        = Ideal.span {Ideal.Quotient.mk (Ideal.map (f.stalkMap x).hom
          (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) h} ∧
      Ideal.span {Ideal.Quotient.mk (Ideal.map (f.stalkMap x).hom
          (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) h} ≠ ⊤ := by
  obtain ⟨V, hφV, hcartier⟩ := hfib
  have hφsupp := mem_support_comap_fiberι f Z x hx
  have hVsupp : (⟨f.asFiber x, hφV⟩ : V.toScheme) ∈
      ((Z.comap (f.fiberι (f x))).comap V.ι).support := by
    rw [Scheme.IdealSheafData.support_comap]
    exact hφsupp
  obtain ⟨b, hbspan, hbreg⟩ := exists_isRegular_stalkIdeal_eq_span_of_isOpenImmersion
    (Z.comap (f.fiberι (f x))) V.ι ⟨f.asFiber x, hφV⟩ (f.asFiber x) rfl hVsupp hφsupp hcartier
  have hkey := stalkIdeal_comap_fiberι_eq_map f Z x hx hφsupp
  rw [← Ideal.map_map, hbspan] at hkey
  set ψ := quotientStalkEquivFiberStalk f x with hψ
  have hspan' := eq_span_of_map_eq_span ψ _ b hkey.symm
  obtain ⟨h, hhmem, hhmk⟩ := (Ideal.mem_map_iff_of_surjective _
    Ideal.Quotient.mk_surjective).mp (hspan'.ge (Ideal.mem_span_singleton_self (ψ.symm b)))
  refine ⟨h, hhmem, ?_, ?_, ?_⟩
  · rw [hhmk]
    exact (isRegular_ringEquiv ψ.symm hbreg).left.isSMulRegular
  · rw [hspan', hhmk]
  · rw [hhmk]
    intro htop
    refine stalkIdeal_ne_top (Z.comap (f.fiberι (f x))) (f.asFiber x) hφsupp ?_
    rw [hbspan, Ideal.span_singleton_eq_top]
    have hunit := (Ideal.span_singleton_eq_top.mp htop).map ψ
    rwa [ψ.apply_symm_apply] at hunit

/-! ### The chart on which the ideal is principal -/

/-- **An ideal equality in the localization away from a section holds on the basic open.**  The
sections over a basic open of an affine open are a localization away from the section, so an
equality of extended ideals there is an equality of the ideals they extend to on the basic
open. -/
private theorem map_res_basicOpen_eq_of_map_away_eq {U : X.Opens} (hU : IsAffineOpen U)
    (g : Γ(X, U)) (hVU : X.basicOpen g ≤ U) (J I : Ideal Γ(X, U))
    (h : I.map (algebraMap Γ(X, U) (Localization.Away g))
      = J.map (algebraMap Γ(X, U) (Localization.Away g))) :
    I.map (X.presheaf.map (homOfLE hVU).op).hom
      = J.map (X.presheaf.map (homOfLE hVU).op).hom := by
  have _ := hU.isLocalization_basicOpen g
  set e := IsLocalization.algEquiv (Submonoid.powers g) (Localization.Away g)
    Γ(X, X.basicOpen g) with hedef
  have hcomp : ((e : Localization.Away g →+* Γ(X, X.basicOpen g))).comp
      (algebraMap Γ(X, U) (Localization.Away g))
      = algebraMap Γ(X, U) Γ(X, X.basicOpen g) := RingHom.ext fun z => e.commutes z
  have halg : algebraMap Γ(X, U) Γ(X, X.basicOpen g)
      = (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom :=
    RingHom.algebraMap_toAlgebra _
  have hmapped := congrArg
    (Ideal.map (e : Localization.Away g →+* Γ(X, X.basicOpen g))) h
  rw [Ideal.map_map, Ideal.map_map, hcomp, halg] at hmapped
  exact hmapped

/-- **An ideal whose image in a quotient lies in the image of another lies in that other plus the
ideal defining the quotient.** -/
private theorem le_sup_of_map_quotient_le {R : Type*} [CommRing R] (P J K : Ideal R)
    (h : J.map (Ideal.Quotient.mk P) ≤ K.map (Ideal.Quotient.mk P)) : J ≤ K ⊔ P := by
  intro z hz
  obtain ⟨w, hwK, hw⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp
    (h (Ideal.mem_map_of_mem _ hz))
  have hdiff : z - w ∈ P := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hw, sub_self]
  exact Submodule.mem_sup.2 ⟨w, hwK, z - w, hdiff, by ring⟩

/-- **A closed subscheme flat over the base with Cartier fibre is locally principal.**  Let
`f : X ⟶ S` be flat and locally of finite presentation, let `Z` be a closed subscheme of `X` of
finite presentation over `X` and let `x` be a point of `Z` at which `Z` is flat over `S` and whose
fibre over `f x` is an effective Cartier divisor in a neighbourhood of `x`.  Then the ideal of `Z`
is principal on an affine open neighbourhood of `x`. -/
theorem exists_affineOpen_ideal_isPrincipal_of_fibre (f : X ⟶ S) [Flat f]
    [LocallyOfFinitePresentation f] (Z : X.IdealSheafData)
    [LocallyOfFinitePresentation Z.subschemeι] (x : X) (hx : x ∈ Z.support)
    (hfib : ∃ V : (f.fiber (f x)).Opens, f.asFiber x ∈ V ∧
      IsEffectiveCartierDivisor ((Z.comap (f.fiberι (f x))).comap V.ι))
    (hflat : ((Z.subschemeι ≫ f).stalkMap (⟨x, hx⟩ : Z.subscheme)).hom.Flat) :
    ∃ U : X.affineOpens, x ∈ (U : X.Opens) ∧ (Z.ideal U).IsPrincipal := by
  classical
  obtain ⟨W, hW, hxW, -⟩ := Opens.isBasis_iff_nbhd.mp S.isBasis_affineOpens
    (show f x ∈ (⊤ : S.Opens) from trivial)
  obtain ⟨U, hU, hxU, hUW⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
    (show x ∈ f ⁻¹ᵁ W from hxW)
  let _ : Algebra Γ(S, W) Γ(X, U) := (f.appLE W U hUW).hom.toAlgebra
  have _ : Module.Flat Γ(S, W) Γ(X, U) := f.flat_appLE hW hU hUW
  have _ : Algebra.FinitePresentation Γ(S, W) Γ(X, U) := f.finitePresentation_appLE hW hU hUW
  have _ : (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).asIdeal.IsPrime :=
    (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).isPrime
  let _ : Algebra Γ(X, U) (X.presheaf.stalk x) := X.presheaf.algebra_section_stalk ⟨x, hxU⟩
  have _ : IsLocalization.AtPrime (X.presheaf.stalk x)
      (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).asIdeal := hU.isLocalization_stalk ⟨x, hxU⟩
  let _ : Algebra Γ(S, W) (X.presheaf.stalk x) :=
    ((X.presheaf.germ U x hxU).hom.comp (f.appLE W U hUW).hom).toAlgebra
  have _ : IsScalarTower Γ(S, W) Γ(X, U) (X.presheaf.stalk x) := .of_algebraMap_eq fun _ => rfl
  have halg : ∀ t : Γ(S, W), algebraMap Γ(S, W) (X.presheaf.stalk x) t
      = (f.stalkMap x).hom ((S.presheaf.germ W (f x) hxW).hom t) := fun t =>
    (RingHom.congr_fun (stalkMap_hom_comp_germ f hUW hxU hxW) t).symm
  have hcomap : (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).asIdeal.comap
        (algebraMap Γ(S, W) Γ(X, U)) = (hW.primeIdealOf (⟨f x, hxW⟩ : ↥W)).asIdeal :=
    congrArg PrimeSpectrum.asIdeal
      (IsAffineOpen.comap_primeIdealOf_appLE W hW U hU hUW hxU)
  let _ : Algebra Γ(S, W) (S.presheaf.stalk (f x)) :=
    S.presheaf.algebra_section_stalk ⟨f x, hxW⟩
  have _ : IsLocalization.AtPrime (S.presheaf.stalk (f x))
      (hW.primeIdealOf (⟨f x, hxW⟩ : ↥W)).asIdeal := hW.isLocalization_stalk ⟨f x, hxW⟩
  have _ : (hW.primeIdealOf (⟨f x, hxW⟩ : ↥W)).asIdeal.IsPrime :=
    (hW.primeIdealOf (⟨f x, hxW⟩ : ↥W)).isPrime
  let _ : Algebra (S.presheaf.stalk (f x)) (X.presheaf.stalk x) := (f.stalkMap x).hom.toAlgebra
  have _ : IsScalarTower Γ(S, W) (S.presheaf.stalk (f x)) (X.presheaf.stalk x) :=
    .of_algebraMap_eq halg
  have hP : Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))
      = ((hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).asIdeal.comap
          (algebraMap Γ(S, W) Γ(X, U))).map (algebraMap Γ(S, W) (X.presheaf.stalk x)) := by
    rw [hcomap]
    exact map_maximalIdeal_eq_map_of_isLocalization _
  have hstalk : stalkIdeal Z x hx
      = (Z.ideal ⟨U, hU⟩).map (algebraMap Γ(X, U) (X.presheaf.stalk x)) :=
    stalkIdeal_eq_map_germ Z x hx hU hxU
  have hIfg : (Z.ideal ⟨U, hU⟩).FG :=
    (Stacks.Flatness.locallyOfFinitePresentation_subschemeι_iff Z).mp inferInstance ⟨U, hU⟩
  obtain ⟨h, hhmem, hhreg, hhspan, hhne⟩ :=
    exists_mem_stalkIdeal_map_eq_span_of_fibre f Z x hx hfib
  have hofn : (List.ofFn fun _ : Fin 1 => Ideal.Quotient.mk (Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) h)
      = [Ideal.Quotient.mk (Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) h] := by
    simp
  have hregseq : RingTheory.Sequence.IsRegular
      (X.presheaf.stalk x ⧸ Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))))
      (List.ofFn fun _ : Fin 1 => Ideal.Quotient.mk (Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) h) := by
    rw [hofn]
    refine ⟨(RingTheory.Sequence.isWeaklyRegular_singleton_iff _ _).2 hhreg, ?_⟩
    rw [Ideal.ofList_singleton, Ideal.smul_eq_mul, Ideal.mul_top]
    exact fun hcontra => hhne hcontra.symm
  have hle : (Z.ideal ⟨U, hU⟩).map (algebraMap Γ(X, U) (X.presheaf.stalk x))
      ≤ Ideal.span (Set.range fun _ : Fin 1 => h) ⊔ Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))) := by
    rw [Set.range_unique, ← hstalk]
    exact le_sup_of_map_quotient_le _ _ _ (hhspan.trans (map_span_singleton_eq _ h).symm).le
  obtain ⟨c, hcI, hcreg, hcle, -⟩ := exists_mem_isRegular_fibre_atPrime
    (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).asIdeal (Z.ideal ⟨U, hU⟩) (fun _ : Fin 1 => h) _ hP
    (fun _ => hstalk.le hhmem) hregseq hle
  have hIflat : Module.Flat Γ(S, W) (Localization.AtPrime
      (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).asIdeal ⧸ (Z.ideal ⟨U, hU⟩).map
        (algebraMap Γ(X, U) (Localization.AtPrime
          (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).asIdeal))) := by
    refine flat_quotient_map_atPrime_of_abstract (O := X.presheaf.stalk x)
      (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).asIdeal (Z.ideal ⟨U, hU⟩) ?_
    have _ := flat_quotient_stalkIdeal f Z x hx hflat hW hxW halg
    exact Module.Flat.of_linearEquiv
      (Ideal.quotientEquivAlgOfEq Γ(S, W) hstalk).symm.toLinearEquiv
  obtain ⟨g, hg, heq⟩ := exists_notMem_map_eq_map_away (A := Γ(S, W))
    (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).asIdeal (Ideal.span (Set.range c)) (Z.ideal ⟨U, hU⟩)
    (Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hcI i))
    (Submodule.fg_span (Set.finite_range c)) hIfg hIflat hcle
  have hV : IsAffineOpen (X.basicOpen g) := hU.basicOpen g
  have hVU : X.basicOpen g ≤ U := X.basicOpen_le g
  have hxV : x ∈ X.basicOpen g := by
    rw [X.mem_basicOpen g x hxU]
    exact (IsLocalization.AtPrime.isUnit_to_map_iff (X.presheaf.stalk x)
      (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).asIdeal g).mpr hg
  refine ⟨⟨X.basicOpen g, hV⟩, hxV, ⟨(X.presheaf.map (homOfLE hVU).op).hom (c 0), ?_⟩⟩
  have hres := map_res_basicOpen_eq_of_map_away_eq hU g hVU (Ideal.span (Set.range c))
    (Z.ideal ⟨U, hU⟩) heq
  rw [← Z.map_ideal (U := ⟨X.basicOpen g, hV⟩) (V := ⟨U, hU⟩) hVU]
  exact hres.trans (by rw [Set.range_unique, map_span_singleton_eq]; rfl)

/-! ### The local statement -/

/-- Let `f : X ⟶ S` be flat and locally of finite presentation, let `Z` be a closed subscheme of
`X` of finite presentation over `X` and let `x` be a point of `Z` at which `Z` is flat over `S` and
whose fibre over `f x` is an effective Cartier divisor in a neighbourhood of `x`.  Then `Z`
restricts to a relative effective Cartier divisor over `S` on an affine open neighbourhood of
`x`. -/
@[stacks 062Y "flat_finitely_presented_case"]
theorem exists_isRelativeEffectiveCartierDivisor_of_flat_of_finitePresentation (f : X ⟶ S)
    [Flat f] [LocallyOfFinitePresentation f] (Z : X.IdealSheafData)
    [LocallyOfFinitePresentation Z.subschemeι] (x : X) (hx : x ∈ Z.support)
    (hfib : ∃ V : (f.fiber (f x)).Opens, f.asFiber x ∈ V ∧
      IsEffectiveCartierDivisor ((Z.comap (f.fiberι (f x))).comap V.ι))
    (hflat : ((Z.subschemeι ≫ f).stalkMap (⟨x, hx⟩ : Z.subscheme)).hom.Flat) :
    ∃ V : X.Opens, x ∈ V ∧ IsAffineOpen V ∧
      IsRelativeEffectiveCartierDivisor (V.ι ≫ f) (Z.comap V.ι) :=
  exists_isRelativeEffectiveCartierDivisor_of_ideal_isPrincipal f Z x hx
    (exists_affineOpen_ideal_isPrincipal_of_fibre f Z x hx hfib hflat) hfib

/-! ### The global statement -/

/-- A closed subscheme of a scheme flat and locally of finite presentation over `S`, itself flat
and locally of finite presentation over `S`, all of whose fibres are effective Cartier divisors, is
a relative effective Cartier divisor over `S`. -/
@[stacks 062Y "flat_fibres_global_case", ega "IV 21.15.3.3" "converse"]
theorem isRelativeEffectiveCartierDivisor_of_flat_of_fibres (f : X ⟶ S) [Flat f]
    [LocallyOfFinitePresentation f] (Z : X.IdealSheafData) [Flat (Z.subschemeι ≫ f)]
    [LocallyOfFinitePresentation (Z.subschemeι ≫ f)]
    (hfib : ∀ s : S, IsEffectiveCartierDivisor (Z.comap (f.fiberι s))) :
    IsRelativeEffectiveCartierDivisor f Z := by
  have _ : LocallyOfFinitePresentation Z.subschemeι :=
    locallyOfFinitePresentation_of_comp Z.subschemeι f
  refine ⟨isEffectiveCartierDivisor_of_forall_mem_support Z fun x hx => ?_, inferInstance⟩
  have hfibx : ∃ V : (f.fiber (f x)).Opens, f.asFiber x ∈ V ∧
      IsEffectiveCartierDivisor ((Z.comap (f.fiberι (f x))).comap V.ι) :=
    ⟨⊤, trivial, isPullbackDefined_of_flat (⊤ : (f.fiber (f x)).Opens).ι _ (hfib (f x))⟩
  have hflatx : ((Z.subschemeι ≫ f).stalkMap (⟨x, hx⟩ : Z.subscheme)).hom.Flat :=
    Flat.stalkMap (Z.subschemeι ≫ f) (⟨x, hx⟩ : Z.subscheme)
  obtain ⟨W, hW, V, hV, hVW, hxV, a, hareg, hideal, -⟩ :=
    exists_affineOpen_isRegular_ideal_eq_span_of_fibre f Z x hx
      (exists_affineOpen_ideal_isPrincipal_of_fibre f Z x hx hfibx hflatx) hfibx
  exact ⟨⟨V, hV⟩, a, hxV, hideal, isRegular_iff_mem_nonZeroDivisors.mp hareg⟩

end Stacks.Divisors

