module

public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartier.Intersection
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.Divisors.Meromorphic.RegularSections
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RelativeRegularImmersion.FibreDictionary
import StacksCore.Tactic.EgaSgaAttribute

/-!
# A Cartier divisor on a fibre, read in the local ring

Let `f : X ⟶ S` be a morphism of schemes, let `Z` be a closed subscheme of `X` and let `x` be a
point of `Z`.  Suppose that the scheme-theoretic fibre `Z_{f x}` is an effective Cartier divisor
in a neighbourhood of `x`.  This file turns that geometric hypothesis into the ring-theoretic one
that the spreading out of a relative effective Cartier divisor needs:  a generator of the ideal
that `Z` cuts out in `𝒪_{X, x}` becomes a nonzerodivisor in the local ring of the fibre, that is,
in the quotient of `𝒪_{X, x}` by the ideal generated by the maximal ideal of `𝒪_{S, f x}`.

This is the one-element companion of
`Stacks.AlgebraicGeometry.exists_mem_stalkIdeal_isRegular_quotient`, which does the same for a
quasi-regular sequence.  Here the conclusion is sharper, because the
hypothesis is:  the fibre is an effective *Cartier divisor*, so its ideal is already principal and
there is nothing to choose — the given generator itself is the nonzerodivisor.

## Main results

* `Stacks.Divisors.exists_isRegular_stalkIdeal_eq_span`: an effective Cartier divisor cuts out, in
  every local ring of its ambient scheme, a principal ideal with a regular generator.
* `Stacks.Divisors.exists_isRegular_stalkIdeal_eq_span_of_isOpenImmersion`: the same conclusion
  from the effective Cartier condition on an open neighbourhood only.
* `Stacks.Divisors.isSMulRegular_quotient_of_isEffectiveCartierDivisor_fibre`: **the dictionary.**

## Implementation notes

The local ring of the fibre is the quotient of `𝒪_{X, x}` by the extended maximal ideal of
`𝒪_{S, f x}`, by `AlgebraicGeometry.quotientStalkEquivFiberStalk`, and the ideal that the fibre of
`Z` cuts out in it is the image of the ideal that `Z` cuts out in `𝒪_{X, x}`, by
`Stacks.AlgebraicGeometry.stalkIdeal_comap`.  Those two facts are the dictionary.  The geometric
hypothesis is stated on an open neighbourhood of the point of the fibre, which is removed by
transporting the generator along the isomorphism of local rings that an open immersion induces;
the generator produced there and the image of the given one differ by a unit, which is what
`AlgebraicGeometry.isRegular_of_span_singleton_eq` exploits.

`Stacks.Divisors.isRegular_of_isSMulRegular` and `Stacks.Divisors.isRegular_ringEquiv` are the
public forms of lemmas that the tree carries only as `private` copies (among them
`StacksFrontier/AlgebraicGeometry/Divisors/EffectiveCartier/StalkwiseRegular.lean`); folding those
copies onto these is REPO-tier dedup work rather than a correctness matter.

## References

* [Stacks Project, Tag 062Y](https://stacks.math.columbia.edu/tag/062Y)
* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory
open Stacks.AlgebraicGeometry

universe u

namespace Stacks.Divisors

variable {X Y S : Scheme.{u}}

/-! ### Nonzerodivisors, transported -/

/-- An element acting injectively by scalar multiplication on the ring is a nonzerodivisor. -/
theorem isRegular_of_isSMulRegular {R : Type*} [CommRing R] {a : R} (h : IsSMulRegular R a) :
    IsRegular a :=
  (Commute.isRegular_iff (Commute.all a)).mpr h

/-- An element of the base ring whose image in an algebra is a nonzerodivisor acts injectively
by scalar multiplication on that algebra. -/
theorem isSMulRegular_of_isRegular_algebraMap {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] {r : R} (h : IsRegular (algebraMap R A r)) : IsSMulRegular A r :=
  fun y z hyz => h.left (by simpa only [Algebra.smul_def] using hyz)

/-- A ring isomorphism carries nonzerodivisors to nonzerodivisors. -/
theorem isRegular_ringEquiv {R T : Type*} [CommRing R] [CommRing T] (e : R ≃+* T) {a : R}
    (ha : IsRegular a) : IsRegular (e a) :=
  (Commute.isRegular_iff (Commute.all _)).mpr fun y z hyz => e.symm.injective <|
    ha.left (by simpa only [map_mul, e.symm_apply_apply] using congrArg e.symm hyz)

/-! ### The ideal cut out in a local ring by an effective Cartier divisor -/

/-- **An effective Cartier divisor cuts out a principal ideal with a regular generator in every
local ring.**  This is the stalkwise form of [Stacks, Tag 01WS]. -/
theorem exists_isRegular_stalkIdeal_eq_span (I : X.IdealSheafData)
    (hI : IsEffectiveCartierDivisor I) (x : X) (hx : x ∈ I.support) :
    ∃ b : X.presheaf.stalk x, stalkIdeal I x hx = Ideal.span {b} ∧ IsRegular b := by
  obtain ⟨U, hU, hxU, a, ha, hgen⟩ :=
    exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor I hI x
  refine ⟨(X.presheaf.germ U x hxU).hom a, ?_, ?_⟩
  · rw [stalkIdeal_eq_map_germ I x hx hU hxU, hgen, Ideal.map_span, Set.image_singleton]
  · exact isRegular_of_isSMulRegular
      (AlgebraicGeometry.isSMulRegular_germ_of_isAffineOpen X hU ha.isSMulRegular (⟨x, hxU⟩ : U))

/-- **The ideal cut out in a local ring, from the effective Cartier condition on a
neighbourhood.**  If an ideal sheaf restricts to an effective Cartier divisor on an open
subscheme, then at every point of that open the ideal it cuts out in the local ring of the ambient
scheme is principal with a regular generator. -/
@[ega "IV 21.6.5" "partial"]
theorem exists_isRegular_stalkIdeal_eq_span_of_isOpenImmersion (I : X.IdealSheafData) (k : Y ⟶ X)
    [IsOpenImmersion k] (y : Y) (x : X) (hxy : k y = x) (hy : y ∈ (I.comap k).support)
    (hx : x ∈ I.support) (hI : IsEffectiveCartierDivisor (I.comap k)) :
    ∃ b : X.presheaf.stalk x, stalkIdeal I x hx = Ideal.span {b} ∧ IsRegular b := by
  subst hxy
  obtain ⟨b, hspan, hreg⟩ := exists_isRegular_stalkIdeal_eq_span (I.comap k) hI y hy
  have _ : IsIso (k.stalkMap y) := (IsOpenImmersion.iff_isIso_stalkMap.mp inferInstance).2 y
  set ε : X.presheaf.stalk (k y) ≃+* Y.presheaf.stalk y :=
    (asIso (k.stalkMap y)).commRingCatIsoToRingEquiv
  have hεhom : (ε : X.presheaf.stalk (k y) →+* Y.presheaf.stalk y) = (k.stalkMap y).hom := rfl
  refine ⟨ε.symm b, ?_, isRegular_ringEquiv ε.symm hreg⟩
  have hmap : Ideal.map (ε : X.presheaf.stalk (k y) →+* Y.presheaf.stalk y)
      (stalkIdeal I (k y) hx) = Ideal.span {b} := by
    rw [hεhom, ← stalkIdeal_comap I k y hy hx, hspan]
  have := congrArg (Ideal.map (ε.symm : Y.presheaf.stalk y →+* X.presheaf.stalk (k y))) hmap
  rwa [Ideal.map_map, show (ε.symm : Y.presheaf.stalk y →+* X.presheaf.stalk (k y)).comp
      (ε : X.presheaf.stalk (k y) →+* Y.presheaf.stalk y) = RingHom.id _ from
      RingHom.ext ε.symm_apply_apply, Ideal.map_id, Ideal.map_span,
    Set.image_singleton] at this

/-! ### The dictionary -/

/-- **A Cartier divisor on the fibre, read in the local ring.**  Let `f : X ⟶ S` be a morphism of
schemes, let `Z` be a closed subscheme of `X` and let `x` be a point of `Z` whose fibre over `f x`
is, near `x`, an effective Cartier divisor.  Then any generator of the ideal that `Z` cuts out in
`𝒪_{X, x}` is a nonzerodivisor modulo the extended maximal ideal of `𝒪_{S, f x}`, that is, in the
local ring of the fibre.

This is the hypothesis on the fibre of
`Stacks.RingTheory.SpreadingOut.exists_notMem_isSMulRegular_and_flat_quotient_away`. -/
theorem isSMulRegular_quotient_of_isEffectiveCartierDivisor_fibre (f : X ⟶ S)
    (Z : X.IdealSheafData) (x : X) (hx : x ∈ Z.support)
    (hfib : ∃ V : (f.fiber (f x)).Opens, f.asFiber x ∈ V ∧
      IsEffectiveCartierDivisor ((Z.comap (f.fiberι (f x))).comap V.ι))
    (h : X.presheaf.stalk x) (hh : stalkIdeal Z x hx = Ideal.span {h}) :
    IsSMulRegular (X.presheaf.stalk x ⧸ Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))))
      (Ideal.Quotient.mk (Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))) h) := by
  obtain ⟨V, hφV, hcartier⟩ := hfib
  have hgφ : f.fiberι (f x) (f.asFiber x) = x := f.fiberι_asFiber x
  have hgφsupp : f.fiberι (f x) (f.asFiber x) ∈ Z.support := by rwa [hgφ]
  have hφsupp : f.asFiber x ∈ (Z.comap (f.fiberι (f x))).support := by
    rw [Scheme.IdealSheafData.support_comap]
    exact hgφsupp
  have hVsupp : (⟨f.asFiber x, hφV⟩ : V.toScheme) ∈
      ((Z.comap (f.fiberι (f x))).comap V.ι).support := by
    rw [Scheme.IdealSheafData.support_comap]
    exact hφsupp
  -- a regular generator of the ideal cut out in the local ring of the fibre
  obtain ⟨b, hbspan, hbreg⟩ := exists_isRegular_stalkIdeal_eq_span_of_isOpenImmersion
    (Z.comap (f.fiberι (f x))) V.ι ⟨f.asFiber x, hφV⟩ (f.asFiber x) rfl hVsupp hφsupp hcartier
  -- the dictionary: the ideal on the fibre is the image of the ideal on `X`
  set P : Ideal (X.presheaf.stalk x) := Ideal.map (f.stalkMap x).hom
    (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x)))
  set ψ : (X.presheaf.stalk x ⧸ P) ≃+*
      (f.fiber (f x)).presheaf.stalk (f.asFiber x) := quotientStalkEquivFiberStalk f x
  have hcomp : ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom.comp
        (X.presheaf.stalkCongr (Inseparable.of_eq hgφ.symm)).hom.hom
      = (ψ : (X.presheaf.stalk x ⧸ P) →+* _).comp (Ideal.Quotient.mk P) :=
    RingHom.ext fun c => (quotientStalkEquivFiberStalk_mk f x c).symm
  have hkey : stalkIdeal (Z.comap (f.fiberι (f x))) (f.asFiber x) hφsupp
      = Ideal.map ((ψ : (X.presheaf.stalk x ⧸ P) →+* _).comp (Ideal.Quotient.mk P))
        (stalkIdeal Z x hx) := by
    rw [stalkIdeal_comap Z (f.fiberι (f x)) (f.asFiber x) hφsupp hgφsupp,
      ← stalkIdeal_congr Z hgφ.symm hx hgφsupp, Ideal.map_map, hcomp]
  -- the two generators of one principal ideal
  have hspan : Ideal.span {b} = Ideal.span {ψ (Ideal.Quotient.mk P h)} := by
    rw [← hbspan, hkey, hh, Ideal.map_span, Set.image_singleton]
    rfl
  have hregQ : IsRegular (Ideal.Quotient.mk P h) := by
    simpa only [ψ.symm_apply_apply] using isRegular_ringEquiv ψ.symm
      (AlgebraicGeometry.isRegular_of_span_singleton_eq hbreg hspan.symm)
  exact hregQ.left.isSMulRegular

end Stacks.Divisors

end
