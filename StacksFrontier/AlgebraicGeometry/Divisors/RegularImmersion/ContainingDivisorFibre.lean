module

public import StacksFrontier.AlgebraicGeometry.Divisors.RegularImmersion.BaseChangeDivisor
public import StacksFrontier.AlgebraicGeometry.Divisors.RegularImmersion.LocallyPrincipalFibre
public import StacksFrontier.AlgebraicGeometry.Morphisms.CohenMacaulay.FibreStalk
public import Mathlib.Topology.Maps.Basic
import StacksFrontier.AlgebraicGeometry.DivisorFlatPullback.Basic
import StacksCore.Tactic.EgaSgaAttribute

/-!
# A relative Cartier divisor containing a closed subscheme near a point

Let `f : X ⟶ S` be flat and locally of finite presentation, let `Z` be a closed subscheme of `X`
and let `x` be a point of `Z` whose fibre `Z_{f x}` is an effective Cartier divisor in a
neighbourhood of `x`.  Then on some open neighbourhood `U` of `x` there is a relative effective
Cartier divisor `D` over `S` containing `Z ∩ U` and with the same fibre over `f x`.

## Main results

* `Stacks.Divisors.exists_mem_ideal_fibre_ideal_eq_span`: a single section `c` of the ideal of
  `Z` on an affine open neighbourhood of `x` cuts out the fibre `Z_{f x}` on an affine open
  neighbourhood of the corresponding point of the fibre, and its germ there is a nonzerodivisor.
* `Stacks.Divisors.exists_isRelativeEffectiveCartierDivisor_containing`: on an open neighbourhood
  `U` of `x` there is a relative effective Cartier divisor `D` over `S` with `Z ∩ U ⊆ D` and
  `Z_{f x} ∩ U = D_{f x}`.
* `Stacks.Divisors.isRelativeEffectiveCartierDivisor_comap_of_flat`: a relative effective Cartier
  divisor pulls back to one along a flat morphism of the source.
* `Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor_comap`: if an
  ideal sheaf restricts to an effective Cartier divisor on an open subscheme, its ideal is
  generated by a nonzerodivisor on small affine opens of the ambient scheme.

## References

* [Stacks Project, Tag 062Y](https://stacks.math.columbia.edu/tag/062Y)
* [Stacks Project, Tag 062T](https://stacks.math.columbia.edu/tag/062T)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace
open Stacks.AlgebraicGeometry

universe u

namespace Stacks.Divisors

variable {X Y S : Scheme.{u}}

/-! ### Identifications of maps of sections -/

/-- **The germ at two equal points.**  Transporting a germ along an equality of points is again a
germ. -/
private theorem germ_stalkCongr_apply {U : X.Opens} (c : Γ(X, U)) {x x' : X} (h : x = x')
    (hx : x ∈ U) (hx' : x' ∈ U) :
    (X.presheaf.stalkCongr (Inseparable.of_eq h)).hom ((X.presheaf.germ U x hx).hom c)
      = (X.presheaf.germ U x' hx').hom c := by
  subst h
  rw [stalkCongr_hom_self X.presheaf]
  rfl

/-- **The inclusion of an open restricts sections to the global sections of the open
subscheme.**  The map of sections `Γ(X, V) ⟶ Γ(V.toScheme, ⊤)` induced by `V.ι` is the
isomorphism `AlgebraicGeometry.Scheme.Opens.topIso`. -/
theorem ι_appLE_top_eq_topIso_inv (V : X.Opens)
    (e : (⊤ : V.toScheme.Opens) ≤ V.ι ⁻¹ᵁ V) : V.ι.appLE V ⊤ e = V.topIso.inv := by
  simp only [Scheme.Hom.appLE, Scheme.Opens.ι_app, Scheme.Opens.topIso,
    Scheme.Opens.toScheme_presheaf_map]
  exact (X.presheaf.map_comp _ _).symm.trans (congrArg X.presheaf.map (Subsingleton.elim _ _))

/-- **Equal morphisms have equal maps of sections.**  Two morphisms that are equal induce the
same map on sections over a pair of opens. -/
theorem appLE_congr {Z : Scheme.{u}} {m₁ m₂ : Z ⟶ X} (h : m₁ = m₂) (U : X.Opens) (B : Z.Opens)
    (e₁ : B ≤ m₁ ⁻¹ᵁ U) (e₂ : B ≤ m₂ ⁻¹ᵁ U) : m₁.appLE U B e₁ = m₂.appLE U B e₂ := by
  subst h
  rfl

/-! ### Flat pullback -/

/-- **A relative effective Cartier divisor pulls back along a flat morphism of the source.**  If
`I` is a relative effective Cartier divisor for `f : X ⟶ S` and `g : Y ⟶ X` is flat, then
`I.comap g` is a relative effective Cartier divisor for `g ≫ f`. -/
theorem isRelativeEffectiveCartierDivisor_comap_of_flat (f : X ⟶ S) (I : X.IdealSheafData)
    (g : Y ⟶ X) [Flat g] (hI : IsRelativeEffectiveCartierDivisor f I) :
    IsRelativeEffectiveCartierDivisor (g ≫ f) (I.comap g) := by
  refine ⟨isPullbackDefined_of_flat g I hI.1, ?_⟩
  set k : (I.comap g).subscheme ⟶ I.subscheme :=
    (I.comapIso g).hom ≫ pullback.snd g I.subschemeι with hk
  have hkcomm : (I.comap g).subschemeι ≫ g = k ≫ I.subschemeι := by
    calc (I.comap g).subschemeι ≫ g
        = ((I.comapIso g).hom ≫ pullback.fst g I.subschemeι) ≫ g := by
          rw [Scheme.IdealSheafData.comapIso_hom_fst]
      _ = (I.comapIso g).hom ≫ pullback.fst g I.subschemeι ≫ g := by
          rw [Category.assoc]
      _ = (I.comapIso g).hom ≫ pullback.snd g I.subschemeι ≫ I.subschemeι := by
          rw [pullback.condition]
      _ = k ≫ I.subschemeι := by rw [hk, Category.assoc]
  have hkflat : Flat k := by
    rw [hk]
    infer_instance
  have hcomp : (I.comap g).subschemeι ≫ g ≫ f = k ≫ I.subschemeι ≫ f := by
    rw [← Category.assoc, hkcomm, Category.assoc]
  rw [hcomp]
  have _ := hkflat
  have _ := hI.2
  infer_instance

/-! ### The affine chart of an effective Cartier divisor on an open subscheme -/

/-- **The affine chart of an effective Cartier divisor on an open subscheme, read on the ambient
scheme.**  If an ideal sheaf `I` on `X` restricts to an effective Cartier divisor on an open
subscheme `N`, then every point of `N` has an affine open neighbourhood inside `N` on which the
ideal of `I` itself is generated by a nonzerodivisor. -/
@[ega "IV 21.2.12" "more general", ega "IV 21.6.5" "partial"]
theorem exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor_comap
    (I : X.IdealSheafData) {N : X.Opens} (hN : IsEffectiveCartierDivisor (I.comap N.ι))
    (x : X) (hxN : x ∈ N) :
    ∃ (A : X.Opens) (hA : IsAffineOpen A), x ∈ A ∧ A ≤ N ∧
      ∃ b : Γ(X, A), IsRegular b ∧ I.ideal ⟨A, hA⟩ = Ideal.span {b} := by
  obtain ⟨A', hA', hxA', b, hbreg, hgen⟩ :=
    exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor (I.comap N.ι) hN
      (⟨x, hxN⟩ : N.toScheme)
  have hA : IsAffineOpen (N.ι ''ᵁ A') := hA'.image_of_isOpenImmersion N.ι
  have hAN : N.ι ''ᵁ A' ≤ N := by
    refine le_trans (Scheme.Hom.image_mono N.ι le_top) ?_
    rw [Scheme.Opens.ι_image_top]
  have hxA : x ∈ N.ι ''ᵁ A' := ⟨⟨x, hxN⟩, hxA', rfl⟩
  refine ⟨N.ι ''ᵁ A', hA, hxA, hAN, b, hbreg, ?_⟩
  have hideal := Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion I N.ι ⟨A', hA'⟩
  rw [Scheme.Opens.ι_appIso, Iso.refl_inv] at hideal
  exact hideal.symm.trans hgen

/-! ### Shrinking an open of the fibre to an open of the ambient scheme -/

/-- **An inducing map pulls back a small neighbourhood.**  If `g` is inducing and `A` is an open
neighbourhood of `y`, then some open neighbourhood of `g y` has its inverse image inside `A`. -/
private theorem exists_opens_preimage_le (g : Y ⟶ X)
    (hg : Topology.IsInducing (fun z : Y => g z)) {y : Y} (A : Y.Opens) (hyA : y ∈ A) :
    ∃ O : X.Opens, g y ∈ O ∧ g ⁻¹ᵁ O ≤ A := by
  have hmem : (A : Set Y) ∈ nhds y := A.2.mem_nhds hyA
  rw [hg.nhds_eq_comap] at hmem
  obtain ⟨B, hB, hpre⟩ := Filter.mem_comap.mp hmem
  obtain ⟨O, hOB, hO, hxO⟩ := mem_nhds_iff.mp hB
  exact ⟨⟨O, hO⟩, hxO, fun z hz => hpre (hOB hz)⟩

/-! ### The local equation of the fibre -/

/-- If the ideal of `I` on `U` is generated by `b`, its ideal on a smaller affine open `V` is
generated by the restriction of `b`. -/
private theorem ideal_eq_span_restrict (I : X.IdealSheafData) {U V : X.Opens} (hU : IsAffineOpen U)
    (hV : IsAffineOpen V) (h : V ≤ U) {b : Γ(X, U)} (hb : I.ideal ⟨U, hU⟩ = Ideal.span {b}) :
    I.ideal ⟨V, hV⟩ = Ideal.span {(X.presheaf.map (homOfLE h).op).hom b} := by
  rw [← I.map_ideal (U := ⟨V, hV⟩) (V := ⟨U, hU⟩) h, hb, Ideal.map_span, Set.image_singleton]
  exact rfl

/-- If the ideal of `I` on `U` is generated by `a`, the ideal of `I.comap m` on an affine open `B`
over `U` is generated by the image of `a`. -/
private theorem ideal_comap_eq_span_appLE (I : Y.IdealSheafData) (m : X ⟶ Y) {U : Y.Opens}
    (hU : IsAffineOpen U) {B : X.Opens} (hB : IsAffineOpen B) (hBU : B ≤ m ⁻¹ᵁ U) {a : Γ(Y, U)}
    (ha : I.ideal ⟨U, hU⟩ = Ideal.span {a}) :
    (I.comap m).ideal ⟨B, hB⟩ = Ideal.span {(m.appLE U B hBU).hom a} := by
  rw [Stacks.IdealSheaf.ideal_comap_appLE I m ⟨U, hU⟩ ⟨B, hB⟩ hBU, ha, Ideal.map_span,
    Set.image_singleton]

/-- **A single section of the ideal cuts out the fibre near the point.**  Let `f : X ⟶ S`, let `Z`
be a closed subscheme of `X`, let `x` be a point of `Z` whose fibre `Z_{f x}` is an effective
Cartier divisor in a neighbourhood of `x`, and let `U₀` be an affine open neighbourhood of `x`.
Then there is a section `c` of the ideal of `Z` on `U₀` and an affine open neighbourhood `A` of
`f.asFiber x` inside the preimage of `U₀`, on which the ideal of the fibre of `Z` is generated by
the image of `c`;  moreover that image has a nonzerodivisor germ. -/
theorem exists_mem_ideal_fibre_ideal_eq_span (f : X ⟶ S) (Z : X.IdealSheafData) (x : X)
    (hx : x ∈ Z.support)
    (hfib : ∃ N : (f.fiber (f x)).Opens, f.asFiber x ∈ N ∧
      IsEffectiveCartierDivisor ((Z.comap (f.fiberι (f x))).comap N.ι))
    {U₀ : X.Opens} (hU₀ : IsAffineOpen U₀) (hxU₀ : x ∈ U₀) :
    ∃ (c : Γ(X, U₀)) (A : (f.fiber (f x)).Opens) (hA : IsAffineOpen A)
      (hyA : f.asFiber x ∈ A) (hAU : A ≤ f.fiberι (f x) ⁻¹ᵁ U₀),
      c ∈ Z.ideal ⟨U₀, hU₀⟩ ∧
        (Z.comap (f.fiberι (f x))).ideal ⟨A, hA⟩ =
          Ideal.span {((f.fiberι (f x)).appLE U₀ A hAU).hom c} ∧
        IsRegular (((f.fiber (f x)).presheaf.germ A (f.asFiber x) hyA).hom
          (((f.fiberι (f x)).appLE U₀ A hAU).hom c)) := by
  classical
  set F := f.fiber (f x) with hF
  set ι : F ⟶ X := f.fiberι (f x) with hιdef
  set y : F := f.asFiber x with hydef
  have hιy : ι y = x := f.fiberι_asFiber x
  have hιyU : ι y ∈ U₀ := hιy ▸ hxU₀
  have hιysupp : ι y ∈ Z.support := hιy ▸ hx
  set Zf : F.IdealSheafData := Z.comap ι with hZf
  have hysupp : y ∈ Zf.support := by
    rw [hZf, Scheme.IdealSheafData.support_comap]
    exact hιysupp
  obtain ⟨N, hyN, hcart⟩ := hfib
  obtain ⟨A₀, hA₀, hyA₀, -, b, hbreg, hb⟩ :=
    exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor_comap Zf hcart y hyN
  have hyIU : y ∈ ι ⁻¹ᵁ U₀ := hιyU
  obtain ⟨g₃, hg₃, hyg₃⟩ := hA₀.exists_basicOpen_le (⟨y, hyIU⟩ : (ι ⁻¹ᵁ U₀)) hyA₀
  set A₂ : F.Opens := F.basicOpen g₃ with hA₂def
  have hA₂ : IsAffineOpen A₂ := hA₀.basicOpen g₃
  have hA₂A₀ : A₂ ≤ A₀ := F.basicOpen_le g₃
  have hA₂U : A₂ ≤ ι ⁻¹ᵁ U₀ := hg₃
  have hyA₂ : y ∈ A₂ := hyg₃
  obtain ⟨b₂, hb₂, hgermb₂⟩ : ∃ b₂ : Γ(F, A₂), Zf.ideal ⟨A₂, hA₂⟩ = Ideal.span {b₂} ∧
      (F.presheaf.germ A₂ y hyA₂).hom b₂ = (F.presheaf.germ A₀ y hyA₀).hom b := by
    refine ⟨(F.presheaf.map (homOfLE hA₂A₀).op).hom b, ?_, ?_⟩
    · exact ideal_eq_span_restrict Zf hA₀ hA₂ hA₂A₀ hb
    · rw [← CommRingCat.comp_apply, F.presheaf.germ_res (homOfLE hA₂A₀) y hyA₂]
  have hβreg : IsRegular ((F.presheaf.germ A₂ y hyA₂).hom b₂) := by
    rw [hgermb₂]
    exact isRegular_of_isSMulRegular
      (AlgebraicGeometry.isSMulRegular_germ_of_isAffineOpen F hA₀ hbreg.isSMulRegular
        (⟨y, hyA₀⟩ : A₀))
  have hstalkZf : stalkIdeal Zf y hysupp
      = Ideal.span {(F.presheaf.germ A₂ y hyA₂).hom b₂} := by
    rw [stalkIdeal_eq_map_germ Zf y hysupp hA₂ hyA₂, hb₂, Ideal.map_span, Set.image_singleton]
  have hmapstalk : stalkIdeal Zf y hysupp
      = Ideal.map (ι.stalkMap y).hom (stalkIdeal Z (ι y) hιysupp) :=
    stalkIdeal_comap Z ι y hysupp hιysupp
  obtain ⟨γ, hγmem, hγ⟩ := (Ideal.mem_map_iff_of_surjective _
      (ι.stalkMap_surjective y)).1
    (hmapstalk ▸ (hstalkZf ▸ Ideal.mem_span_singleton_self
      ((F.presheaf.germ A₂ y hyA₂).hom b₂)) :
      (F.presheaf.germ A₂ y hyA₂).hom b₂ ∈
        Ideal.map (ι.stalkMap y).hom (stalkIdeal Z (ι y) hιysupp))
  let _ : Algebra Γ(X, U₀) (X.presheaf.stalk (ι y)) :=
    X.presheaf.algebra_section_stalk (⟨ι y, hιyU⟩ : U₀)
  set q : Ideal Γ(X, U₀) := (hU₀.primeIdealOf (⟨ι y, hιyU⟩ : U₀)).asIdeal with hqdef
  have _ : q.IsPrime := (hU₀.primeIdealOf (⟨ι y, hιyU⟩ : U₀)).isPrime
  have _ : IsLocalization.AtPrime (X.presheaf.stalk (ι y)) q :=
    hU₀.isLocalization_stalk (⟨ι y, hιyU⟩ : U₀)
  have hγideal : γ ∈ Ideal.map (algebraMap Γ(X, U₀) (X.presheaf.stalk (ι y)))
      (Z.ideal ⟨U₀, hU₀⟩) := by
    rw [show Ideal.map (algebraMap Γ(X, U₀) (X.presheaf.stalk (ι y))) (Z.ideal ⟨U₀, hU₀⟩)
      = stalkIdeal Z (ι y) hιysupp from
        (stalkIdeal_eq_map_germ Z (ι y) hιysupp hU₀ hιyU).symm]
    exact hγmem
  obtain ⟨⟨⟨c, hcZ⟩, ⟨g, hgq⟩⟩, hcg⟩ := (IsLocalization.mem_map_algebraMap_iff
    q.primeCompl (X.presheaf.stalk (ι y))).1 hγideal
  have hgunit : IsUnit (algebraMap Γ(X, U₀) (X.presheaf.stalk (ι y)) g) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff (X.presheaf.stalk (ι y)) q g).mpr hgq
  have hstalkc : (ι.stalkMap y).hom (algebraMap Γ(X, U₀) (X.presheaf.stalk (ι y)) c)
      = (F.presheaf.germ A₂ y hyA₂).hom b₂ *
        (ι.stalkMap y).hom (algebraMap Γ(X, U₀) (X.presheaf.stalk (ι y)) g) := by
    rw [← hcg, map_mul, hγ]
  have hunitw : IsUnit ((ι.stalkMap y).hom
      (algebraMap Γ(X, U₀) (X.presheaf.stalk (ι y)) g)) := hgunit.map _
  have hgermc : (ι.stalkMap y).hom (algebraMap Γ(X, U₀) (X.presheaf.stalk (ι y)) c)
      = (F.presheaf.germ A₂ y hyA₂).hom ((ι.appLE U₀ A₂ hA₂U).hom c) :=
    RingHom.congr_fun (stalkMap_hom_comp_germ ι hA₂U hyA₂ hιyU) c
  have hcmem : (ι.appLE U₀ A₂ hA₂U).hom c ∈ Ideal.span {b₂} := by
    rw [← hb₂, Stacks.IdealSheaf.ideal_comap_appLE Z ι ⟨U₀, hU₀⟩ ⟨A₂, hA₂⟩ hA₂U]
    exact Ideal.mem_map_of_mem _ hcZ
  obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.1 hcmem
  have hgermv : (F.presheaf.germ A₂ y hyA₂).hom v
      = (ι.stalkMap y).hom (algebraMap Γ(X, U₀) (X.presheaf.stalk (ι y)) g) := by
    have key : (F.presheaf.germ A₂ y hyA₂).hom v * (F.presheaf.germ A₂ y hyA₂).hom b₂
        = (ι.stalkMap y).hom (algebraMap Γ(X, U₀) (X.presheaf.stalk (ι y)) g)
          * (F.presheaf.germ A₂ y hyA₂).hom b₂ := by
      rw [← map_mul, hv, ← hgermc, hstalkc]
      ring
    exact hβreg.right key
  have hvunit : IsUnit ((F.presheaf.germ A₂ y hyA₂).hom v) := hgermv ▸ hunitw
  have hA₃ : IsAffineOpen (F.basicOpen v) := hA₂.basicOpen v
  have hyA₃ : y ∈ F.basicOpen v := (F.mem_basicOpen v y hyA₂).2 hvunit
  have hA₃A₂ : F.basicOpen v ≤ A₂ := F.basicOpen_le v
  have hA₃U : F.basicOpen v ≤ ι ⁻¹ᵁ U₀ := hA₃A₂.trans hA₂U
  have hvres : IsUnit ((F.presheaf.map (homOfLE hA₃A₂).op).hom v) :=
    F.toRingedSpace.isUnit_res_basicOpen v
  have hres : (ι.appLE U₀ (F.basicOpen v) hA₃U).hom c
      = (F.presheaf.map (homOfLE hA₃A₂).op).hom ((ι.appLE U₀ A₂ hA₂U).hom c) := by
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
  refine ⟨c, F.basicOpen v, hA₃, hyA₃, hA₃U, hcZ, ?_, ?_⟩
  · rw [hres, ← hv, map_mul, ideal_eq_span_restrict Zf hA₂ hA₃ hA₃A₂ hb₂,
      Ideal.span_singleton_mul_left_unit hvres _]
  · have hgermeq : (F.presheaf.germ (F.basicOpen v) y hyA₃).hom
        ((ι.appLE U₀ (F.basicOpen v) hA₃U).hom c)
        = (F.presheaf.germ A₂ y hyA₂).hom ((ι.appLE U₀ A₂ hA₂U).hom c) := by
      rw [hres, ← CommRingCat.comp_apply, F.presheaf.germ_res (homOfLE hA₃A₂) y hyA₃]
    rw [hgermeq, ← hgermc, hstalkc]
    exact hβreg.mul hunitw.isRegular

/-! ### The fibre of a restricted morphism -/

/-- **The fibre of a morphism restricted to an open, inside the fibre of the morphism.**  For an
open `U` of `X` the fibre of `U.ι ≫ f` over `s` maps canonically to the fibre of `f` over `s`. -/
noncomputable def fiberιOfOpens (f : X ⟶ S) (U : X.Opens) (s : S) :
    (U.ι ≫ f).fiber s ⟶ f.fiber s :=
  pullback.lift ((U.ι ≫ f).fiberι s ≫ U.ι) ((U.ι ≫ f).fiberToSpecResidueField s)
    (by simpa only [Category.assoc] using (U.ι ≫ f).fiber_fac s)

/-- `fiberιOfOpens f U s` followed by the inclusion of the fibre of `f` is the inclusion of the
fibre of `U.ι ≫ f` followed by `U.ι`. -/
@[reassoc]
lemma fiberιOfOpens_fiberι (f : X ⟶ S) (U : X.Opens) (s : S) :
    fiberιOfOpens f U s ≫ f.fiberι s = (U.ι ≫ f).fiberι s ≫ U.ι :=
  pullback.lift_fst _ _ _

/-- `fiberιOfOpens f U s` lands in the part of the fibre of `f` lying over `U`. -/
lemma fiberιOfOpens_mem (f : X ⟶ S) (U : X.Opens) (s : S) (z : (U.ι ≫ f).fiber s) :
    f.fiberι s (fiberιOfOpens f U s z) ∈ U := by
  have h := congrArg (fun m : (U.ι ≫ f).fiber s ⟶ X => m z) (fiberιOfOpens_fiberι f U s)
  simp only [Scheme.Hom.comp_apply] at h
  rw [h]
  exact ((U.ι ≫ f).fiberι s z).2

/-! ### The containing divisor -/

/-- Let `f : X ⟶ S` be flat and locally of finite presentation, let `Z` be a closed subscheme of
`X` and let `x` be a point of `Z` whose fibre over `f x` is an effective Cartier divisor in a
neighbourhood of `x`.  Then there is an open neighbourhood `U` of `x` carrying a relative
effective Cartier divisor `D` over `S` with `Z ∩ U ⊆ D` and `Z_{f x} ∩ U = D_{f x}`. -/
@[stacks 062Y "local_containing_divisor"]
theorem exists_isRelativeEffectiveCartierDivisor_containing (f : X ⟶ S) [Flat f]
    [LocallyOfFinitePresentation f] (Z : X.IdealSheafData) (x : X) (hx : x ∈ Z.support)
    (hfib : ∃ N : (f.fiber (f x)).Opens, f.asFiber x ∈ N ∧
      IsEffectiveCartierDivisor ((Z.comap (f.fiberι (f x))).comap N.ι)) :
    ∃ (U : X.Opens) (_ : x ∈ U) (D : U.toScheme.IdealSheafData),
      IsRelativeEffectiveCartierDivisor (U.ι ≫ f) D ∧ D ≤ Z.comap U.ι ∧
        (Z.comap U.ι).comap ((U.ι ≫ f).fiberι (f x)) =
          D.comap ((U.ι ≫ f).fiberι (f x)) := by
  classical
  set ι : f.fiber (f x) ⟶ X := f.fiberι (f x) with hιdef
  set y : f.fiber (f x) := f.asFiber x with hydef
  have hιy : ι y = x := f.fiberι_asFiber x
  obtain ⟨U₀, hU₀, hxU₀, -⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
    (show x ∈ (⊤ : X.Opens) from trivial)
  have hιyU₀ : ι y ∈ U₀ := by rw [hιy]; exact hxU₀
  obtain ⟨c, A, hA, hyA, hAU, hcZ, hidealA, hregA⟩ :=
    exists_mem_ideal_fibre_ideal_eq_span f Z x hx hfib hU₀ hxU₀
  have hregSMul : IsSMulRegular
      (X.presheaf.stalk x ⧸ Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))))
      (Ideal.Quotient.mk
        (Ideal.map (f.stalkMap x).hom
          (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))))
        ((X.presheaf.germ U₀ x hxU₀).hom c)) := by
    set P : Ideal (X.presheaf.stalk x) := Ideal.map (f.stalkMap x).hom
      (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))) with hP
    set ψ : (X.presheaf.stalk x ⧸ P) ≃+* (f.fiber (f x)).presheaf.stalk y :=
      quotientStalkEquivFiberStalk f x with hψ
    have hψmk : ψ (Ideal.Quotient.mk P ((X.presheaf.germ U₀ x hxU₀).hom c))
        = (ι.stalkMap y).hom ((X.presheaf.germ U₀ (ι y) hιyU₀).hom c) := by
      rw [hψ, quotientStalkEquivFiberStalk_mk f x]
      congr 1
      exact germ_stalkCongr_apply c hιy.symm hxU₀ hιyU₀
    have hstep : (ι.stalkMap y).hom ((X.presheaf.germ U₀ (ι y) hιyU₀).hom c)
        = ((f.fiber (f x)).presheaf.germ A y hyA).hom ((ι.appLE U₀ A hAU).hom c) :=
      RingHom.congr_fun (stalkMap_hom_comp_germ ι hAU hyA hιyU₀) c
    have hreg : IsRegular (ψ (Ideal.Quotient.mk P ((X.presheaf.germ U₀ x hxU₀).hom c))) := by
      rw [hψmk, hstep]
      exact hregA
    have hregQ : IsRegular (Ideal.Quotient.mk P ((X.presheaf.germ U₀ x hxU₀).hom c)) := by
      have h := isRegular_ringEquiv ψ.symm hreg
      rwa [ψ.symm_apply_apply] at h
    exact hregQ.left.isSMulRegular
  obtain ⟨W, hW, V, hV, hVW, hVU₀, hxV, a, hadef, hareg, hflat⟩ :=
    exists_affineOpen_isRegular_flat_quotient_of_mem_ideal f Z x hx hU₀ hxU₀ c hcZ hregSMul
  have hVa : IsAffine V.toScheme := hV
  have hT : IsAffineOpen (⊤ : V.toScheme.Opens) := isAffineOpen_top V.toScheme
  set DV : V.toScheme.IdealSheafData :=
    Scheme.IdealSheafData.ofIdealTop (Ideal.span {V.topIso.inv.hom a}) with hDV
  have hDVideal : DV.ideal ⟨⊤, hT⟩ = Ideal.span {V.topIso.inv.hom a} := by
    rw [hDV, Scheme.IdealSheafData.ofIdealTop_ideal,
      show (homOfLE (le_top (a := (⊤ : V.toScheme.Opens)))) = 𝟙 _ from rfl]
    simp only [CategoryTheory.op_id, CategoryTheory.Functor.map_id, CommRingCat.hom_id,
      Ideal.map_id]
  have hDVrel : IsRelativeEffectiveCartierDivisor (V.ι ≫ f) DV :=
    isRelativeEffectiveCartierDivisor_of_ideal_top_eq_span f hW hV hVW DV hT a hareg
      hDVideal hflat
  have hDVle : DV ≤ Z.comap V.ι := by
    refine Scheme.IdealSheafData.le_of_isAffine ?_
    rw [hDVideal, Stacks.IdealSheaf.ideal_comap_ι_top Z hV hT, Ideal.span_le,
      Set.singleton_subset_iff]
    refine Ideal.mem_map_of_mem _ ?_
    rw [hadef, ← Z.map_ideal (U := ⟨V, hV⟩) (V := ⟨U₀, hU₀⟩) hVU₀]
    exact Ideal.mem_map_of_mem _ hcZ
  obtain ⟨O, hxO, hO⟩ := exists_opens_preimage_le ι ι.isEmbedding.isInducing A hyA
  rw [hιy] at hxO
  set U : X.Opens := V ⊓ O with hU
  have hxU : x ∈ U := ⟨hxV, hxO⟩
  have hUV : U ≤ V := inf_le_left
  set j : U.toScheme ⟶ V.toScheme := X.homOfLE hUV with hj
  have hjι : j ≫ V.ι = U.ι := X.homOfLE_ι hUV
  refine ⟨U, hxU, DV.comap j, ?_, ?_, ?_⟩
  · have h := isRelativeEffectiveCartierDivisor_comap_of_flat (V.ι ≫ f) DV j hDVrel
    rwa [← Category.assoc, hjι] at h
  · have h : DV.comap j ≤ (Z.comap V.ι).comap j := Scheme.IdealSheafData.comap_mono j hDVle
    rwa [← Scheme.IdealSheafData.comap_comp, hjι] at h
  · set G := (U.ι ≫ f).fiber (f x) with hG
    set ρ : G ⟶ U.toScheme := (U.ι ≫ f).fiberι (f x) with hρ
    set n : G ⟶ f.fiber (f x) := fiberιOfOpens f U (f x) with hn
    have hnι : n ≫ ι = ρ ≫ U.ι := fiberιOfOpens_fiberι f U (f x)
    have hnA : ∀ B : G.Opens, B ≤ n ⁻¹ᵁ A := by
      intro B z _
      have hzU : ι (n z) ∈ U := fiberιOfOpens_mem f U (f x) z
      exact hO hzU.2
    have hρι : ρ ≫ U.ι = n ≫ ι := hnι.symm
    have hmeq : (ρ ≫ j) ≫ V.ι = n ≫ ι := by
      rw [Category.assoc, hjι, hρι]
    refine Scheme.IdealSheafData.ext (funext fun B => ?_)
    have hBU₀ : (B : G.Opens) ≤ (n ≫ ι) ⁻¹ᵁ U₀ := by
      intro z _
      exact hVU₀ (hUV (fiberιOfOpens_mem f U (f x) z))
    have hBU₀' : (B : G.Opens) ≤ ((ρ ≫ j) ≫ V.ι) ⁻¹ᵁ U₀ := by
      rw [hmeq]
      exact hBU₀
    have hBA : (B : G.Opens) ≤ n ⁻¹ᵁ A := hnA B.1
    have hVtop : (⊤ : V.toScheme.Opens) ≤ V.ι ⁻¹ᵁ V := fun z _ => z.2
    have hBtop : (B : G.Opens) ≤ (ρ ≫ j) ⁻¹ᵁ (⊤ : V.toScheme.Opens) := fun z _ => trivial
    have hsecL : (n.appLE A B.1 hBA).hom ((ι.appLE U₀ A hAU).hom c)
        = ((n ≫ ι).appLE U₀ B.1 hBU₀).hom c := by
      rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
    have hsecR : ((ρ ≫ j).appLE (⊤ : V.toScheme.Opens) B.1 hBtop).hom
          (V.topIso.inv.hom a)
        = (((ρ ≫ j) ≫ V.ι).appLE U₀ B.1 hBU₀').hom c := by
      rw [← ι_appLE_top_eq_topIso_inv V hVtop, ← CommRingCat.comp_apply,
        Scheme.Hom.appLE_comp_appLE, hadef, ← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
    have hleft : ((Z.comap U.ι).comap ρ).ideal B
        = Ideal.span {((n ≫ ι).appLE U₀ B.1 hBU₀).hom c} := by
      rw [← Scheme.IdealSheafData.comap_comp, hρι, Scheme.IdealSheafData.comap_comp,
        ideal_comap_eq_span_appLE (Z.comap ι) n hA B.2 hBA hidealA, hsecL]
    have hright : ((DV.comap j).comap ρ).ideal B
        = Ideal.span {(((ρ ≫ j) ≫ V.ι).appLE U₀ B.1 hBU₀').hom c} := by
      rw [← Scheme.IdealSheafData.comap_comp,
        ideal_comap_eq_span_appLE DV (ρ ≫ j) hT B.2 hBtop hDVideal, hsecR]
    rw [hleft, hright, appLE_congr hmeq U₀ B.1 hBU₀' hBU₀]

end Stacks.Divisors

