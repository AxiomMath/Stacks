/-! ### Lifting flatness along a regular element -/

/-- **Flatness lifts along a nonzerodivisor of the maximal ideal.**  Let `B` be a Noetherian
local `A`-algebra and `h ∈ 𝔪_B` a nonzerodivisor.  If `B/hB` is flat over `A`, so is `B`. -/
theorem flat_of_regular_quotient_flat
    {A B : Type u} [CommRing A] [CommRing B] [IsLocalRing B]
    [Algebra A B] [IsNoetherianRing B]
    (h : B) (hh : h ∈ nonZeroDivisors B)
    (hm : h ∈ IsLocalRing.maximalIdeal B)
    (hflat : Module.Flat A (B ⧸ Ideal.span {h})) : Module.Flat A B := by
  classical
  let J : Ideal B := Ideal.span {h}
  let μ : B →ₗ[A] B :=
    { toFun := fun b => h * b
      map_add' := by intro x y; simp [mul_add]
      map_smul' := by intro a b; simp [Algebra.smul_def, mul_assoc, mul_comm] }
  let q : B →ₗ[A] B ⧸ J := (Ideal.Quotient.mkₐ B J).toLinearMap.restrictScalars A
  have hμ : Function.Injective μ := (isRegular_iff_mem_nonZeroDivisors.mpr hh).1
  have hmq : Function.Exact μ q := by
    intro b
    show Ideal.Quotient.mk J b = 0 ↔ _
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton']
    exact exists_congr fun c => by rw [mul_comm]; rfl
  have hqsurj : Function.Surjective q := Ideal.Quotient.mk_surjective
  refine ⟨?_⟩
  intro P hPcomm hPmodule hPfinite N hNfg
  let _ : AddCommGroup P := Module.addCommMonoidToAddCommGroup A
  let _ : AddCommGroup N := Module.addCommMonoidToAddCommGroup A
  let f : N →ₗ[A] P := N.subtype
  let fB := TensorProduct.AlgebraTensorModule.lTensor B B f
  let fQ := LinearMap.lTensor (B ⧸ J) f
  have hfQ : Function.Injective fQ :=
    Module.Flat.lTensor_preserves_injective_linearMap f Subtype.val_injective
  let μN := μ.rTensor N
  let μP := μ.rTensor P
  let qN := q.rTensor N
  let qP := q.rTensor P
  have hseq := fun (M : Type u) [AddCommGroup M] [Module A M] =>
    flat_tor_zero μ q (by simpa [μ] using hμ) hmq hqsurj (N := M)
  have hExactN : Function.Exact (μ.rTensor N) (q.rTensor N) :=
    (LinearMap.rTensor_exact_iff_lTensor_exact N).2 (hseq N).2.1
  have hμsmul : ∀ {M : Type u} [AddCommGroup M] [Module A M] (y : B ⊗[A] M),
      μ.rTensor M y = h • y := by
    intro M _ _ y
    induction y using TensorProduct.induction_on with
    | zero => simp
    | tmul b n => simp [μ, TensorProduct.smul_tmul', smul_eq_mul]
    | add a b ha hb => simp [ha, hb]
  have hcommMul : ∀ y, fB (μN y) = μP (fB y) := by
    intro y
    rw [show μN y = h • y from hμsmul y, show μP (fB y) = h • fB y from hμsmul _, map_smul]
  have hComm : ∀ z, fQ (qN z) = qP (fB z) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp [qN, qP]
    | tmul b n => simp [fB, fQ, qN, qP, q, J]
    | add x y hx hy => simp [hx, hy]
  let K : Submodule B (B ⊗[A] N) := LinearMap.ker fB
  have hKfg : K.FG := by
    have := Module.Finite.of_fg hNfg
    exact IsNoetherian.noetherian K
  have hKsmul : K ≤ Ideal.span {h} • K := by
    intro z hz
    have hzker : fB z = 0 := LinearMap.mem_ker.mp hz
    obtain ⟨y, hy⟩ := (hExactN z).mp (hfQ (by simpa [hzker] using hComm z))
    have hyK : y ∈ K := LinearMap.mem_ker.mpr <|
      (μ.lTensor_inj_iff_rTensor_inj P).mp (hseq P).1 (by rw [← hcommMul y, hy, hzker, map_zero])
    rw [← hy, hμsmul]
    exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self h) hyK
  have hKzero : K = ⊥ :=
    Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ K hKfg hKsmul
      (((Ideal.span_singleton_le_iff_mem _).mpr hm).trans (IsLocalRing.maximalIdeal_le_jacobson ⊥))
  refine (f.lTensor_inj_iff_rTensor_inj B).mp fun a b hab => LinearMap.ker_eq_bot.mp hKzero ?_
  simpa [fB, TensorProduct.AlgebraTensorModule.coe_lTensor] using hab

/-- A sequence `r :: rs` of a commutative ring is regular exactly when `r` is a nonzerodivisor
and the image of `rs` in `B ⧸ (r)` is regular. -/
theorem isRegular_cons_iff_quotient_span_singleton
    {B : Type u} [CommRing B] (r : B) (rs : List B) :
    RingTheory.Sequence.IsRegular B (r :: rs) ↔
      r ∈ nonZeroDivisors B ∧
        RingTheory.Sequence.IsRegular (B ⧸ Ideal.span {r})
          (rs.map (Ideal.Quotient.mk (Ideal.span {r}))) := by
  rw [RingTheory.Sequence.isRegular_cons_iff]
  refine and_congr ?_ ?_
  · rw [← isLeftRegular_iff, isLeftRegular_iff_isRegular, isRegular_iff_mem_nonZeroDivisors]
  · have heq : (Ideal.span {r} : Submodule B B) = r • (⊤ : Submodule B B) := by
      simp [← Submodule.ideal_span_singleton_smul]
    let e : (B ⧸ Ideal.span {r}) ≃ₗ[B] QuotSMulTop r B := Submodule.quotEquivOfEq _ _ heq
    symm
    refine AddEquiv.isRegular_congr (e := e.toAddEquiv) ?_
    refine List.forall₂_map_left_iff.mpr (List.forall₂_same.mpr ?_)
    intro a _ x
    show e ((Ideal.Quotient.mk (Ideal.span {r}) a) • x) = a • e x
    rw [← Ideal.Quotient.algebraMap_eq, algebraMap_smul, map_smul]

private theorem flat_of_regularSequence_quotient_flat_aux (n : ℕ) :
    ∀ {A B : Type u} [CommRing A] [CommRing B] [IsLocalRing B]
      [Algebra A B] [IsNoetherianRing B]
      (rs : List B), rs.length = n → RingTheory.Sequence.IsRegular B rs →
      (∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal B) →
      Module.Flat A (B ⧸ Ideal.ofList rs) → Module.Flat A B := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro A B _ _ _ _ _ rs hlen hreg hmax hflat
    cases rs with
    | nil =>
      rw [Ideal.ofList_nil] at hflat
      exact (Module.Flat.equiv_iff (AlgEquiv.quotientBot A B).toLinearEquiv).mp hflat
    | cons r rs =>
      have hreg' := (isRegular_cons_iff_quotient_span_singleton r rs).mp hreg
      have hquotFlat : Module.Flat A
          ((B ⧸ Ideal.span {r}) ⧸
            Ideal.map (Ideal.Quotient.mk (Ideal.span {r})) (Ideal.ofList rs)) := by
        let e := (Ideal.quotientEquivAlgOfEq A (Ideal.ofList_cons r rs)).trans
          (DoubleQuot.quotQuotEquivQuotSupₐ A (Ideal.span {r}) (Ideal.ofList rs)).symm
        exact (Module.Flat.equiv_iff e.toLinearEquiv).mp hflat
      let B' := B ⧸ Ideal.span {r}
      let q : B →+* B' := Ideal.Quotient.mk (Ideal.span {r})
      have _ : Nontrivial B' := hreg'.2.nontrivial
      have _ : IsLocalRing B' := IsLocalRing.of_surjective' q Ideal.Quotient.mk_surjective
      have _ : IsNoetherianRing B' :=
        isNoetherianRing_of_surjective B B' q Ideal.Quotient.mk_surjective
      have _ : IsLocalHom q := IsLocalHom.of_surjective q Ideal.Quotient.mk_surjective
      have hrestMax : ∀ s ∈ rs.map q, s ∈ IsLocalRing.maximalIdeal B' := by
        intro s hs
        obtain ⟨t, ht, rfl⟩ := List.mem_map.mp hs
        exact fun hu => hmax t (List.mem_cons_of_mem r ht) (IsLocalHom.map_nonunit (f := q) t hu)
      have hflatB' : Module.Flat A B' :=
        ih rs.length (by simp [← hlen])
          (A := A) (B := B') (rs.map q) (List.length_map ..) hreg'.2
          hrestMax (by rw [Ideal.map_ofList] at hquotFlat; exact hquotFlat)
      exact flat_of_regular_quotient_flat r hreg'.1 (hmax r List.mem_cons_self) hflatB'

/-- **Flatness lifts along a regular sequence inside the maximal ideal.**  Let `B` be a
Noetherian local `A`-algebra and `rs` a regular sequence of elements of `𝔪_B`.  If `B ⧸ (rs)` is
flat over `A`, so is `B`. -/
theorem flat_of_regularSequence_quotient_flat
    {A B : Type u} [CommRing A] [CommRing B] [IsLocalRing B]
    [Algebra A B] [IsNoetherianRing B]
    (rs : List B) (hreg : RingTheory.Sequence.IsRegular B rs)
    (hmax : ∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal B)
    (hflat : Module.Flat A (B ⧸ Ideal.ofList rs)) : Module.Flat A B :=
  flat_of_regularSequence_quotient_flat_aux rs.length rs rfl hreg hmax hflat

/-- If `g : B →+* C` is surjective with kernel generated by a regular sequence inside the
maximal ideal of the Noetherian local ring `B`, then flatness of `g ∘ f` gives flatness of
`f`. -/
theorem flat_of_comp_surjective_of_regular_ker
    {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
    [IsLocalRing B] [IsNoetherianRing B]
    (f : A →+* B) (g : B →+* C) (hg : Function.Surjective g)
    (rs : List B) (hker : Ideal.ofList rs = RingHom.ker g)
    (hreg : RingTheory.Sequence.IsRegular B rs)
    (hmax : ∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal B)
    (hflat : (g.comp f).Flat) : f.Flat := by
  let _ : Algebra A B := f.toAlgebra
  have hq : ((Ideal.Quotient.mk (RingHom.ker g)).comp f).Flat := by
    have h := hflat.comp (RingHom.Flat.of_bijective
      (f := (g.quotientKerEquivOfSurjective hg).symm.toRingHom)
      (g.quotientKerEquivOfSurjective hg).symm.bijective)
    rwa [← RingHom.comp_assoc, RingHom.quotientKerEquivOfSurjective_symm_comp hg] at h
  have hqModule : Module.Flat A (B ⧸ RingHom.ker g) := hq
  exact flat_of_regularSequence_quotient_flat rs hreg hmax (by rw [hker]; exact hqModule)

/-- Flatness of a composite whose second factor is an isomorphism gives flatness of the
first. -/
theorem flat_of_comp_isIso {A B C : CommRingCat.{u}}
    (f : A ⟶ B) (g : B ⟶ C) [IsIso g] (h : RingHom.Flat (f ≫ g).hom) :
    RingHom.Flat f.hom := by
  have h' := h.comp (RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso (inv g)))
  change RingHom.Flat ((f ≫ g) ≫ inv g).hom at h'
  simpa using h'

/-! ### The defining ideal near a point of the immersed scheme -/

/-- Every point of the image of a morphism of schemes lies in the support of the quotient of the
structure sheaf by the defining ideal of that morphism:  the unit section does not vanish
there. -/
theorem mem_idealQuotientSupport_definingIdealOfHom {Z X : Scheme.{u}} (i : Z ⟶ X) (z : Z) :
    i z ∈ idealQuotientSupport X.toRingedSpace (definingIdealOfHom i) := by
  let J := definingIdealOfHom i
  let φ := SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i.toLRSHom.toShHom)
  have hzero : J.ι ≫ φ = (0 : J.toSheafOfModules ⟶ _) := by
    ext U s
    exact s.2
  let d := cokernel.desc J.ι φ hzero
  let F : RingedSpace.ModuleSheaf X.toRingedSpace :=
    ⟨(idealQuotient X.toRingedSpace J).val, (idealQuotient X.toRingedSpace J).isSheaf⟩
  let s := (cokernel.π J.ι).val.app (op ⊤) (1 : X.presheaf.obj (op ⊤))
  refine ⟨F.sectionGerm ⊤ (i z) trivial s, ?_⟩
  intro hs
  obtain ⟨V, hxV, a, ha⟩ := (F.sectionGerm_eq_zero_iff ⊤ (i z) trivial s).mp hs
  have hπ : (cokernel.π J.ι).val.app (op V) (1 : X.presheaf.obj (op V)) = 0 := by
    have hn := PresheafOfModules.naturality_apply (cokernel.π J.ι).val a.op (1 : Γ(X, ⊤))
    change (cokernel.π J.ι).val.app (op V) (X.presheaf.map a.op 1) = _ at hn
    rw [map_one] at hn
    exact hn.trans ha
  have hφ : φ.val.app (op V) (1 : X.presheaf.obj (op V)) = 0 := by
    have hd := congrArg (fun k => (SheafOfModules.Hom.val k).app (op V)
      (1 : X.presheaf.obj (op V))) (cokernel.π_desc J.ι φ hzero)
    change d.val.app (op V) ((cokernel.π J.ι).val.app (op V) (1 : Γ(X, V))) = _ at hd
    rw [hπ, map_zero] at hd
    exact hd.symm
  have hz : (1 : Z.presheaf.obj (op (i ⁻¹ᵁ V))) = 0 := by
    change i.app V 1 = 0 at hφ
    simpa using hφ
  simpa using congrArg (Z.presheaf.germ (i ⁻¹ᵁ V) z hxV) hz

/-- A section of an ideal sheaf generated on `U` by a finite family has, at every point of `U`,
a germ in the ideal generated by the germs of that family. -/
theorem germ_mem_span_of_isGeneratedByOn {X : Scheme.{u}}
    (J : (structureSheafModule X.toRingedSpace).Submodule)
    (U : X.Opens) {r : ℕ} (f : Fin r → Γ(X, U))
    (hgen : IsGeneratedByOn X.toRingedSpace J U f)
    (x : X) (hx : x ∈ U) (V : X.Opens) (hxV : x ∈ V) (hVU : V ≤ U)
    (s : Γ(X, V)) (hs : s ∈ J.obj (op V)) :
    X.presheaf.germ V x hxV s ∈
      Ideal.span (Set.range fun j => X.presheaf.germ U x hx (f j)) := by
  rw [hgen V hVU] at hs
  exact germ_mem_of_mem_generatedIdealOn U f V s hs x hxV hx

/-- Every element of the kernel of the stalk map of an immersion is the germ of a section of its
defining ideal, over an open neighbourhood inside any prescribed one. -/
theorem exists_germ_mem_definingIdealOfHom {Z X : Scheme.{u}}
    (i : Z ⟶ X) [IsImmersion i] (z : Z) (b : X.presheaf.stalk (i z))
    (hb : (i.stalkMap z) b = 0) (U : X.Opens) (hxU : i z ∈ U) :
    ∃ (V : X.Opens) (hxV : i z ∈ V), V ≤ U ∧ ∃ s : Γ(X, V),
      s ∈ (definingIdealOfHom i).obj (op V) ∧ X.presheaf.germ V (i z) hxV s = b := by
  obtain ⟨W, hxW, s, rfl⟩ := X.presheaf.exists_germ_eq b
  rw [Scheme.Hom.germ_stalkMap_apply] at hb
  have heq : Z.presheaf.germ (i ⁻¹ᵁ W) z hxW (i.app W s) =
      Z.presheaf.germ (i ⁻¹ᵁ W) z hxW 0 := by simpa using hb
  obtain ⟨T, hzT, a, a', hs⟩ := Z.presheaf.germ_eq z hxW hxW (i.app W s) 0 heq
  obtain ⟨V₀, hV₀, hpre⟩ := i.isEmbedding.isInducing.isOpen_iff.mp T.isOpen
  let V : X.Opens := ⟨V₀, hV₀⟩ ⊓ W ⊓ U
  have hxV : i z ∈ V := ⟨⟨show z ∈ i ⁻¹' V₀ from hpre.symm ▸ hzT, hxW⟩, hxU⟩
  have hVW : V ≤ W := inf_le_left.trans inf_le_right
  have hVT : i ⁻¹ᵁ V ≤ T := by
    intro y hy
    show y ∈ (T : Set Z)
    rw [← hpre]
    exact hy.1.1
  let t : Γ(X, V) := X.presheaf.map (homOfLE hVW).op s
  refine ⟨V, hxV, inf_le_right, t, ?_, ?_⟩
  · show i.app V t = 0
    have hn := i.toLRSHom.toShHom.hom.c.naturality (homOfLE hVW).op
    have hn' := congrArg (fun g => g s) hn
    change i.app V t =
      Z.presheaf.map ((Opens.map i.base).map (homOfLE hVW)).op (i.app W s) at hn'
    rw [hn']
    have ha : Z.presheaf.map a.op (i.app W s) = 0 := by simpa using hs
    have hfac : ((Opens.map i.base).map (homOfLE hVW)).op = a.op ≫ (homOfLE hVT).op :=
      Subsingleton.elim _ _
    rw [hfac, Z.presheaf.map_comp]
    show Z.presheaf.map (homOfLE hVT).op (Z.presheaf.map a.op (i.app W s)) = 0
    rw [ha, map_zero]
  · exact X.presheaf.germ_res_apply (homOfLE hVW) (i z) hxV s

/-- The kernel of the stalk map of an immersion at a point is generated by the germs of any
family generating its defining ideal near that point. -/
theorem ker_stalkMap_eq_span_of_isGeneratedByOn {Z X : Scheme.{u}}
    (i : Z ⟶ X) [IsImmersion i] (z : Z) (U : X.Opens) (hx : i z ∈ U)
    {r : ℕ} (f : Fin r → Γ(X, U))
    (hgen : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom i) U f) :
    RingHom.ker (i.stalkMap z).hom =
      Ideal.span (Set.range fun j => X.presheaf.germ U (i z) hx (f j)) := by
  apply le_antisymm
  · intro b hb
    obtain ⟨V, hxV, hVU, s, hs, rfl⟩ := exists_germ_mem_definingIdealOfHom i z b hb U hx
    exact germ_mem_span_of_isGeneratedByOn _ U f hgen (i z) hx V hxV hVU s hs
  · apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    show (i.stalkMap z) (X.presheaf.germ U (i z) hx (f j)) = 0
    rw [Scheme.Hom.germ_stalkMap_apply]
    have hmem : f j ∈ (definingIdealOfHom i).obj (op U) := by
      rw [hgen U le_rfl]
      exact mem_generatedIdealOn X.toRingedSpace U f j
    have h : i.app U (f j) = 0 := hmem
    rw [h, map_zero]

/-- At a point with Noetherian local ring, the kernel of the stalk map of a quasi-regular
immersion is generated by a regular sequence lying in the maximal ideal. -/
theorem exists_regularSequence_ker_stalkMap {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i]
    (hi : IsQuasiRegularIdealSheaf X.toRingedSpace (definingIdealOfHom i))
    (z : Z) [IsNoetherianRing (X.presheaf.stalk (i z))] :
    ∃ rs : List (X.presheaf.stalk (i z)),
      Ideal.ofList rs = RingHom.ker (i.stalkMap z).hom ∧
      RingTheory.Sequence.IsRegular (X.presheaf.stalk (i z)) rs ∧
      ∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (i z)) := by
  obtain ⟨U, hxU, n, f, hgen, hquasi⟩ :=
    (isQuasiRegularIdealSheaf_iff_exists_affine_generators X (definingIdealOfHom i)).mp hi
      (i z) (mem_idealQuotientSupport_definingIdealOfHom i z)
  let B := X.presheaf.stalk (i z)
  let _ : Algebra Γ(X, U.1) B := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨i z, hxU⟩
  let _ : IsLocalization.AtPrime B (U.2.primeIdealOf ⟨i z, hxU⟩).asIdeal :=
    U.2.isLocalization_stalk ⟨i z, hxU⟩
  let _ : Module.Flat Γ(X, U.1) B :=
    IsLocalization.flat B (U.2.primeIdealOf ⟨i z, hxU⟩).asIdeal.primeCompl
  let rs := (List.ofFn f).map (algebraMap Γ(X, U.1) B)
  have hqr : RingTheory.Sequence.IsQuasiRegular B rs :=
    hquasi.of_flat_of_isBaseChange (IsBaseChange.linearMap Γ(X, U.1) B)
  have hker : Ideal.ofList rs = RingHom.ker (i.stalkMap z).hom := by
    rw [ker_stalkMap_eq_span_of_isGeneratedByOn i z U.1 hxU f hgen]
    simp only [rs, Ideal.ofList, List.mem_map, List.mem_ofFn]
    congr 1
    ext b
    simp
    rfl
  have hmax : ∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal B := by
    intro r hr
    have hz : (i.stalkMap z).hom r = 0 := by
      rw [← RingHom.mem_ker, ← hker]
      exact Ideal.subset_span hr
    exact fun hu => not_isUnit_zero (hz ▸ hu.map (i.stalkMap z).hom)
  exact ⟨rs, hker,
    RingTheory.Sequence.IsRegular.of_isQuasiRegular_of_mem_maximalIdeal hmax hqr, hmax⟩

/-- Let `f : X ⟶ S` be a morphism of schemes and `i : Z ⟶ X` a relative quasi-regular immersion
over `S`.  Then `f` is flat at every point of the image of `i` whose local ring on `X` is
Noetherian. -/
@[stacks 063T]
theorem isFlatAt_of_isRelativeQuasiRegularImmersion
    {X S Z : Scheme.{u}} (f : X ⟶ S) (i : Z ⟶ X) [IsImmersion i]
    (hi : IsRelativeQuasiRegularImmersion f i)
    (x : X) (hx : x ∈ Set.range i.base)
    (hNoetherian : IsNoetherianRing (X.presheaf.stalk x)) :
    IsFlatAt f.toLRSHom.toShHom x := by
  obtain ⟨z, rfl⟩ := hx
  let j := i.liftCoborder
  let k := i.coborderRange.ι
  have hjk : j ≫ k = i := i.liftCoborder_ι
  have hx : k (j z) = i z := congrArg (fun g : Z ⟶ X => g z) hjk
  have _ : IsNoetherianRing (X.presheaf.stalk (k (j z))) := hx ▸ hNoetherian
  have _ : IsNoetherianRing (i.coborderRange.toScheme.presheaf.stalk (j z)) :=
    isNoetherianRing_of_ringEquiv (X.presheaf.stalk (k (j z)))
      (asIso (k.stalkMap (j z))).commRingCatIsoToRingEquiv
  obtain ⟨rs, hker, hreg, hmax⟩ := exists_regularSequence_ker_stalkMap j hi.2 z
  have hflatZ : RingHom.Flat ((j ≫ (k ≫ f)).stalkMap z).hom := by
    rw [← Category.assoc, hjk]
    exact (Flat.iff_flat_stalkMap (i ≫ f)).mp hi.1 z
  rw [Scheme.Hom.stalkMap_comp] at hflatZ
  have hflat : RingHom.Flat ((k ≫ f).stalkMap (j z)).hom :=
    flat_of_comp_surjective_of_regular_ker ((k ≫ f).stalkMap (j z)).hom
      (j.stalkMap z).hom (j.stalkMap_surjective z) rs hker hreg hmax hflatZ
  rw [Scheme.Hom.stalkMap_comp] at hflat
  have h := flat_of_comp_isIso (f.stalkMap (k (j z))) (k.stalkMap (j z)) hflat
  rwa [hx] at h

end AlgebraicGeometry

end
