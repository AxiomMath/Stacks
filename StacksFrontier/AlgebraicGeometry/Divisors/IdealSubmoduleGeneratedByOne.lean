/-!
# Local principality of an ideal sheaf and generation of its ideal subsheaf by one section

For a quasi-coherent sheaf of ideals `I` on a scheme `X` two towers describe the same
mathematics.  On one side `I` is an `AlgebraicGeometry.Scheme.IdealSheafData`, recorded by the
ideals `I(U) ⊆ Γ(X, U)` it cuts out on the affine opens, and local principality
(`Stacks.Divisors.IsLocallyPrincipal`, [Stacks, Tag 01WR]) is the condition that those ideals be
principal near every point.  On the other side it is the submodule
`I.unitSubmodule` of the structure sheaf, and the corresponding condition
is `AlgebraicGeometry.IsGeneratedByNear` with bound one, which is what the descent theory of
[Stacks, Tag 082U] and the Fitting-ideal criteria of [Stacks, Tag 0C3F] speak about.

This file identifies the two conditions.

## Main results

* `AlgebraicGeometry.isGeneratedByNear_of_iso`: generation by `r` sections near a point transfers
  along an isomorphism of modules.
* `Stacks.Divisors.generatesLocally_unitSubmodule_of_ideal_top_eq_span`: on an affine scheme
  whose global ideal is principal, the generator generates the ideal subsheaf locally in the
  Zariski topology.
* `Stacks.Divisors.exists_generatingSections_unitSubmodule_of_ideal_top_eq_span`,
  `Stacks.Divisors.isGeneratedByNear_unitSubmodule_of_ideal_top_eq_span` and
  `Stacks.Divisors.isFiniteType_unitSubmodule_of_ideal_top_eq_span`: **a principal global ideal
  on an affine scheme makes the ideal subsheaf generated by one section near every point, hence
  of finite type.**
* `Stacks.Divisors.stalk_isPrincipal_of_isGeneratedByNear`: **generation of the ideal subsheaf by
  one section near a point makes the stalk ideal principal there.**
* `Stacks.Divisors.isLocallyPrincipal_of_forall_stalk_isPrincipal_of_fg`: [Stacks, Tag 0AG8(1)]
  with the finite generation of the ideals supplied as a hypothesis instead of being deduced from
  a Noetherian hypothesis.
* `Stacks.Divisors.isLocallyPrincipal_of_forall_isGeneratedByNear`: **the ideal sheaf of a
  quasi-coherent ideal whose ideal subsheaf is generated by one section near every point is
  locally principal.**

## Implementation notes

The sections of `I.unitSubmodule` over an affine open are `I`'s own ideal there on the nose
(`AlgebraicGeometry.Scheme.IdealSheafData.unitSubmodule_obj_affine`), which is what makes the
translation possible; the other constructions of the ideal subsheaf record their affine sections
only in the form `I(U) ^ 1 • ⊤`.

Both directions go through an elementwise description of generation,
`Stacks.SheafOfModules.GeneratesLocally`, rather than through the epimorphism of sheaves of
modules itself.  Producing it is `Stacks.Divisors.principalSieve`, the sieve of opens on which a
given section is a multiple of the generator, which is downward closed because restriction of
regular functions is multiplicative; consuming it is
`Stacks.SheafOfModules.generatesLocally_of_epi`.  The passage back to an ideal-theoretic statement
is taken at the *stalks*: an epimorphism onto the ideal subsheaf over an open is not surjective on
the sections over an affine open inside it for any formal reason, and the local statement is all
the Fitting-ideal theory needs.  From principality of the stalk ideal, local principality of the
ideal sheaf is [Stacks, Tag 0AG8(1)], whose proof uses a Noetherian hypothesis only to know that
the ideals are finitely generated; finite generation is available here from finite type of the
ideal subsheaf, so the statement is reproved with that hypothesis in place of the Noetherian one.

## References

* [Stacks Project, Tag 01WR](https://stacks.math.columbia.edu/tag/01WR)
* [Stacks Project, Tag 0AG8](https://stacks.math.columbia.edu/tag/0AG8)
* [Stacks Project, Tag 0C3F](https://stacks.math.columbia.edu/tag/0C3F)
* [Stacks Project, Tag 082U](https://stacks.math.columbia.edu/tag/082U)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry Stacks.ClosedSubscheme

universe u

attribute [local instance] Stacks.Algebraization.sectionsModuleΓ
  Stacks.Algebraization.sectionsModuleΓSheaf

attribute [local instance_reducible] AlgebraicGeometry.Scheme.Modules

namespace AlgebraicGeometry

/-- **A section of the structure sheaf of a scheme over an open, read as a regular function.**
The sheaf of rings indexing the `𝒪_X`-modules is the `RingCat`-valued
`AlgebraicGeometry.Scheme.ringCatSheaf`, whose sections are definitionally the `CommRingCat`-valued
`Γ(X, U)` but are not that spelling. -/
def structureFun {X : Scheme.{u}} {U : X.Opens}
    (c : ToType (X.ringCatSheaf.obj.obj (op U))) : Γ(X, U) := c

/-- **Generation by `r` sections near a point transfers along an isomorphism of modules.** -/
theorem isGeneratedByNear_of_iso {X : Scheme.{u}} {F G : X.Modules} (ε : F ≅ G) (r : ℕ) (x : X)
    (h : IsGeneratedByNear G r x) : IsGeneratedByNear F r x := by
  obtain ⟨U, hxU, σ, ⟨e⟩⟩ := h
  exact ⟨U, hxU, (SheafOfModules.GeneratingSections.equivOfIso
    ((SheafOfModules.overFunctor X.ringCatSheaf U).mapIso ε).symm) σ, ⟨e⟩⟩

end AlgebraicGeometry

namespace Stacks.Divisors

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-! ### Generation by one section on an affine scheme -/

/-- **The sieve of opens on which a section is a multiple of a prescribed global function.** -/
def principalSieve (a : Γ(X, ⊤)) {V : X.Opens} (t : Γ(X, V)) : Sieve V where
  arrows O g := ∃ c : Γ(X, O),
    c * (X.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op).hom a =
      (X.presheaf.map g.op).hom t
  downward_closed := by
    rintro O O' g ⟨c, hc⟩ k
    refine ⟨(X.presheaf.map k.op).hom c, ?_⟩
    have h1 : (X.presheaf.map (homOfLE (le_top : O' ≤ ⊤)).op).hom a =
        (X.presheaf.map k.op).hom ((X.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op).hom a) := by
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    have h2 : (X.presheaf.map (k ≫ g).op).hom t =
        (X.presheaf.map k.op).hom ((X.presheaf.map g.op).hom t) := by
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    rw [h1, h2, ← map_mul, hc]

/-- Membership in `Stacks.Divisors.principalSieve`, unfolded. -/
theorem principalSieve_arrows (a : Γ(X, ⊤)) {V O : X.Opens} (t : Γ(X, V)) (g : O ⟶ V) :
    (principalSieve a t).arrows g ↔ ∃ c : Γ(X, O),
      c * (X.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op).hom a =
        (X.presheaf.map g.op).hom t :=
  Iff.rfl

/-- Restricting a section of the ideal subsheaf to an affine open lands in the ideal there. -/
private theorem map_mem_ideal_of_mem_unitSubmodule {O U : X.Opens} (hO : IsAffineOpen O)
    (g : O ⟶ U) {t : Γ(X, U)} (ht : t ∈ I.unitSubmodule.toSubmodule.obj (op U)) :
    (X.presheaf.map g.op).hom t ∈ I.ideal ⟨O, hO⟩ := by
  have := I.unitSubmodule.toSubmodule.map_mem g.op ht
  rwa [AlgebraicGeometry.Scheme.IdealSheafData.unitSubmodule_obj_affine I ⟨O, hO⟩] at this

/-- **On an affine scheme a generator of the global ideal generates the ideal subsheaf locally in
the Zariski topology.** -/
theorem generatesLocally_unitSubmodule_of_ideal_top_eq_span [IsAffine X] {a : Γ(X, ⊤)}
    (hI : I.ideal ⟨⊤, isAffineOpen_top X⟩ = Ideal.span {a})
    (ha : a ∈ I.unitSubmodule.toSubmodule.obj (op (⊤ : X.Opens))) :
    Stacks.SheafOfModules.GeneratesLocally (Opens.grothendieckTopology X)
      (I.unitSubmodule.toSheafOfModules).val
      (fun _ : Fin 1 =>
        (⟨a, ha⟩ : ToType ((I.unitSubmodule.toSheafOfModules).val.obj
          (op (⊤ : X.Opens))))) := by
  intro V f t
  refine ⟨principalSieve a t.val, ?_, ?_⟩
  · rw [Opens.mem_grothendieckTopology]
    intro x hx
    obtain ⟨-, ⟨O, hO, rfl⟩, hxO, hOV⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open hx V.2
    refine ⟨O, homOfLE hOV, ?_, hxO⟩
    have hmem := map_mem_ideal_of_mem_unitSubmodule I hO (homOfLE hOV) t.2
    rw [← I.map_ideal (U := ⟨O, hO⟩) (V := ⟨⊤, isAffineOpen_top X⟩) (le_top (a := O)), hI,
      Ideal.map_span, Set.image_singleton] at hmem
    exact Ideal.mem_span_singleton'.1 hmem
  · rintro O g ⟨c, hc⟩
    refine ⟨fun _ => c, ?_⟩
    rw [Fintype.sum_unique]
    exact Subtype.ext hc

/-- **On an affine scheme whose global ideal is principal the ideal subsheaf has a single
generating section.** -/
theorem exists_generatingSections_unitSubmodule_of_ideal_top_eq_span [IsAffine X] {a : Γ(X, ⊤)}
    (hI : I.ideal ⟨⊤, isAffineOpen_top X⟩ = Ideal.span {a}) :
    ∃ σ : ((I.unitSubmodule.toSheafOfModules).over (⊤ : X.Opens)).GeneratingSections,
      Nonempty (σ.I ≃ Fin 1) := by
  have ha : a ∈ I.unitSubmodule.toSubmodule.obj (op (⊤ : X.Opens)) := by
    rw [I.unitSubmodule_obj_affine ⟨⊤, isAffineOpen_top X⟩, hI]
    exact Ideal.mem_span_singleton_self a
  exact ⟨Stacks.SheafOfModules.generatorsOfGeneratesLocally
    (I.unitSubmodule.toSheafOfModules) (fun _ : Fin 1 => ⟨a, ha⟩)
    (generatesLocally_unitSubmodule_of_ideal_top_eq_span I hI ha), ⟨Equiv.ulift⟩⟩

/-- **On an affine scheme whose global ideal is principal the ideal subsheaf is generated by one
section near every point.** -/
theorem isGeneratedByNear_unitSubmodule_of_ideal_top_eq_span [IsAffine X] {a : Γ(X, ⊤)}
    (hI : I.ideal ⟨⊤, isAffineOpen_top X⟩ = Ideal.span {a}) (x : X) :
    IsGeneratedByNear (I.unitSubmodule.toSheafOfModules) 1 x := by
  obtain ⟨σ, he⟩ := exists_generatingSections_unitSubmodule_of_ideal_top_eq_span I hI
  exact ⟨⊤, trivial, σ, he⟩

/-- **On an affine scheme whose global ideal is principal the ideal subsheaf is of finite
type.** -/
theorem isFiniteType_unitSubmodule_of_ideal_top_eq_span [IsAffine X] {a : Γ(X, ⊤)}
    (hI : I.ideal ⟨⊤, isAffineOpen_top X⟩ = Ideal.span {a}) :
    (I.unitSubmodule.toSheafOfModules).IsFiniteType :=
  Stacks.StrictTransformFittingRank.isFiniteType_of_isGeneratedByNear _ 1
    (isGeneratedByNear_unitSubmodule_of_ideal_top_eq_span I hI)

/-! ### From generation by one section to a principal stalk ideal -/

/-- **Generation of the ideal subsheaf by one section near a point makes the stalk ideal
principal there.** -/
theorem stalk_isPrincipal_of_isGeneratedByNear (x : X)
    (h : IsGeneratedByNear (I.unitSubmodule.toSheafOfModules) 1 x) :
    (IdealSheafData.stalk I x).IsPrincipal := by
  classical
  obtain ⟨U, hxU, σ, ⟨e⟩⟩ := h
  let _ : Unique σ.I := Equiv.unique e
  let _ : Fintype σ.I := Fintype.ofEquiv _ e.symm
  have hGL := Stacks.SheafOfModules.generatesLocally_of_epi U σ.π
  set s : σ.I → ToType ((I.unitSubmodule.toSheafOfModules).val.obj (op U)) :=
    fun i => Stacks.SheafOfModules.evalOver
      (((I.unitSubmodule.toSheafOfModules).over U).freeHomEquiv σ.π i) with hs
  obtain ⟨-, ⟨O, hO, rfl⟩, hxO, hOU⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxU U.2
  refine ⟨(X.presheaf.germ U x hxU).hom (s default).val, ?_⟩
  rw [IdealSheafData.stalk_eq_map_germ I x ⟨O, hO⟩ hxO]
  refine le_antisymm (Ideal.map_le_iff_le_comap.2 fun z hz => ?_) ?_
  · obtain ⟨R, hR, hcoef⟩ := hGL O (homOfLE hOU) ⟨z, by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.unitSubmodule_obj_affine I ⟨O, hO⟩]; exact hz⟩
    rw [Opens.mem_grothendieckTopology] at hR
    obtain ⟨O', g, hg, hxO'⟩ := hR x hxO
    obtain ⟨c, hc⟩ := hcoef O' g hg
    rw [Fintype.sum_unique] at hc
    have hcval : structureFun (c default) *
        (X.presheaf.map (g ≫ homOfLE hOU).op).hom (s default).val =
        (X.presheaf.map g.op).hom z := congrArg Subtype.val hc
    refine Ideal.mem_comap.2 (Ideal.mem_span_singleton'.2
      ⟨(X.presheaf.germ O' x hxO').hom (structureFun (c default)), ?_⟩)
    have e1 : (X.presheaf.germ O' x hxO').hom
          ((X.presheaf.map (g ≫ homOfLE hOU).op).hom (s default).val) =
        (X.presheaf.germ U x hxU).hom (s default).val :=
      X.presheaf.germ_res_apply (g ≫ homOfLE hOU) x hxO' (s default).val
    have e2 : (X.presheaf.germ O' x hxO').hom ((X.presheaf.map g.op).hom z) =
        (X.presheaf.germ O x hxO).hom z :=
      X.presheaf.germ_res_apply g x hxO' z
    rw [← e1, ← e2, ← map_mul (X.presheaf.germ O' x hxO').hom, hcval]
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    have hmem := map_mem_ideal_of_mem_unitSubmodule I hO (homOfLE hOU) (s default).2
    have e3 : (X.presheaf.germ O x hxO).hom
          ((X.presheaf.map (homOfLE hOU).op).hom (s default).val) =
        (X.presheaf.germ U x hxU).hom (s default).val :=
      X.presheaf.germ_res_apply (homOfLE hOU) x hxO (s default).val
    rw [← e3]
    exact Ideal.mem_map_of_mem _ hmem

/-! ### From a principal stalk ideal to local principality -/

/-- **[Stacks, Tag 0AG8(1)] with finite generation hypothesised.**  A closed subscheme whose
ideal is finitely generated on an affine open around every point and whose stalk ideals are
principal is locally principal. -/
theorem isLocallyPrincipal_of_forall_stalk_isPrincipal_of_fg
    (hfg : ∀ x : X, ∃ (V : X.affineOpens) (hxV : x ∈ V.1), (I.ideal V).FG ∧
      (Ideal.map (X.presheaf.germ V.1 x hxV).hom (I.ideal V)).IsPrincipal) :
    IsLocallyPrincipal I := by
  intro x
  obtain ⟨V, hxV, hfgV, hprin⟩ := hfg x
  let p : PrimeSpectrum Γ(X, V.1) := V.2.primeIdealOf ⟨x, hxV⟩
  let P : Ideal Γ(X, V.1) := p.asIdeal
  have _ : P.IsPrime := p.isPrime
  let _ : Algebra Γ(X, V.1) (X.presheaf.stalk x) :=
    X.presheaf.algebra_section_stalk (⟨x, hxV⟩ : V.1)
  have _ : IsLocalization P.primeCompl (X.presheaf.stalk x) :=
    V.2.isLocalization_stalk (⟨x, hxV⟩ : V.1)
  have hprincipalStalk :
      ((I.ideal V).map (algebraMap Γ(X, V.1) (X.presheaf.stalk x))).IsPrincipal := hprin
  have hprincipalLocal :
      ((I.ideal V).map (algebraMap Γ(X, V.1) (Localization.AtPrime P))).IsPrincipal := by
    let ε := IsLocalization.algEquiv P.primeCompl (Localization.AtPrime P)
      (X.presheaf.stalk x)
    have heq : ((I.ideal V).map (algebraMap Γ(X, V.1) (X.presheaf.stalk x))).map
          ε.symm.toRingHom = (I.ideal V).map (algebraMap Γ(X, V.1) (Localization.AtPrime P)) := by
      rw [Ideal.map_map]
      congr 1
      ext r
      exact ε.symm.commutes r
    rw [← heq]
    exact hprincipalStalk.map_ringHom ε.symm.toRingHom
  obtain ⟨a, ha, hprincipalAway⟩ :=
    exists_notMem_isPrincipal_localizationAway (I.ideal V) P hfgV hprincipalLocal
  let W := X.affineBasicOpen (U := V) a
  have hxW : x ∈ W.1 := by
    refine (X.mem_basicOpen' a ⟨x, hxV⟩).2 ?_
    show IsUnit (algebraMap Γ(X, V.1) (X.presheaf.stalk x) a)
    exact IsLocalization.map_units (M := P.primeCompl) _ ⟨a, ha⟩
  let _ : Algebra Γ(X, V.1) Γ(X, W.1) :=
    (X.presheaf.map (homOfLE (X.basicOpen_le a)).op).hom.toAlgebra
  have _ : IsLocalization.Away a Γ(X, W.1) := V.2.isLocalization_basicOpen a
  let ε := IsLocalization.algEquiv (.powers a) (Localization.Away a) Γ(X, W.1)
  have hcomp : ε.toRingHom.comp (algebraMap Γ(X, V.1) (Localization.Away a)) =
      (X.presheaf.map (homOfLE (X.basicOpen_le a)).op).hom := by
    ext r
    exact ε.commutes r
  have hideal : I.ideal W =
      ((I.ideal V).map (algebraMap Γ(X, V.1) (Localization.Away a))).map ε.toRingHom := by
    rw [← I.map_ideal (X.basicOpen_le a), Ideal.map_map, hcomp]
    rfl
  exact ⟨W, hxW, hideal ▸ hprincipalAway.map_ringHom ε.toRingHom⟩

/-- **The ideal sheaf of a closed subscheme whose ideal subsheaf is generated by one section near
every point is locally principal.** -/
theorem isLocallyPrincipal_of_forall_isGeneratedByNear
    [(I.unitSubmodule.toSheafOfModules).IsQuasicoherent]
    (h : ∀ x : X, IsGeneratedByNear (I.unitSubmodule.toSheafOfModules) 1 x) :
    IsLocallyPrincipal I := by
  have _ : (I.unitSubmodule.toSheafOfModules).IsFiniteType :=
    Stacks.StrictTransformFittingRank.isFiniteType_of_isGeneratedByNear _ 1 h
  refine isLocallyPrincipal_of_forall_stalk_isPrincipal_of_fg I fun x => ?_
  obtain ⟨-, ⟨V, hV, rfl⟩, hxV, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  refine ⟨⟨V, hV⟩, hxV, ?_, ?_⟩
  · rw [← AlgebraicGeometry.Scheme.IdealSheafData.unitSubmodule_obj_affine I ⟨V, hV⟩]
    have hfin : Module.Finite Γ(X, V) Γ(I.unitSubmodule.toSheafOfModules, V) :=
      AlgebraicGeometry.moduleFinite_sections_on_affine
        (I.unitSubmodule.toSheafOfModules) V hV
    exact Module.Finite.iff_fg.1 hfin
  · have hst := stalk_isPrincipal_of_isGeneratedByNear I x (h x)
    rwa [IdealSheafData.stalk_eq_map_germ I x ⟨V, hV⟩ hxV] at hst

end Stacks.Divisors

end
