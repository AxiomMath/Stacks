module

public import StacksFrontier.AlgebraicGeometry.IdealOfClosedSubscheme.Basic
public import StacksFrontier.AlgebraicGeometry.Divisors.ProjIdealOfClosedSubscheme
public import StacksFrontier.AlgebraicGeometry.ProjStalkGlobalSections.Functoriality

/-!
# The degreewise kernel criterion for the ideal of a closed subscheme of `Proj`

Let `S = ⨁_{n ≥ 0} 𝒮 n` be a nonnegatively graded ring, `X = Proj 𝒮`, and `i : Z ⟶ X` a closed
immersion. `AlgebraicGeometry.ProjectiveSpectrum.Proj.idealOfClosedSubscheme` is the ideal
generated by the homogeneous elements whose canonical twisted global section pulls back to zero
on `Z`. This file proves that this ideal is exactly the kernel

`I(Z) = Ker(S ⟶ ⨁_{n ≥ 0} Γ(Z, 𝒪_Z(n)))`

of the source: an arbitrary element of `S` lies in it precisely when *every* one of its
homogeneous components has vanishing pulled-back section.

The key ingredient is multiplicativity of the pullback across the different twists. It is
supplied here as a morphism of sheaves rather than a pairing: multiplication by a homogeneous
element `a` of degree `k` is a degree-preserving map of the graded modules `S(n) ⟶ S(k + n)`,
hence a morphism `𝒪_X(n) ⟶ 𝒪_X(k + n)` of twisting sheaves, and the pullback map on global
sections is natural in the module. So a section that pulls back to zero still does so after
multiplication by `a`, which is what makes the vanishing locus an ideal.

## Main definitions

* `AlgebraicGeometry.ProjectiveSpectrum.Proj.twistMulLeft`: multiplication by a homogeneous
  element of degree `k`, as a morphism `𝒪_X(n) ⟶ 𝒪_X(k + n)` of twisting sheaves.

## Main results

* `AlgebraicGeometry.ProjectiveSpectrum.Proj.twistMulLeft_degreeSection`: multiplication by `a`
  sends the section attached to `b` to the one attached to `a * b`.
* `AlgebraicGeometry.ProjectiveSpectrum.Proj.pullbackGlobalSections_degreeSection_mul_eq_zero`:
  the homogeneous elements with vanishing pulled-back section absorb multiplication.
* `AlgebraicGeometry.ProjectiveSpectrum.Proj.mem_idealOfClosedSubscheme_iff`: the degreewise
  kernel criterion.

## Implementation notes

`AlgebraicGeometry.pullbackGlobalSections` is a composite of the unit of the
pullback–pushforward adjunction with the restriction along `f ⁻¹ᵁ ⊤ = ⊤`, and that composite
typechecks only up to unfolding `Scheme.Modules.pushforward`. Rewriting inside it re-elaborates
the composite at a lower transparency and fails, so its naturality is assembled from two
explicitly stated squares by `Eq.trans` rather than by `rw`.

Multiplication by a homogeneous element is obtained from
`Stacks.AlgebraicGeometry.ProjSheafFunctoriality.associatedModuleSheafMap`, and its effect on
the canonical sections from
`Stacks.AlgebraicGeometry.ProjStalkGlobalSections.degreeZeroToGlobalSections_naturality`; no
tensor product of twists and no pairing of sections is needed. The target degree is written
`((k + n : ℕ) : ℤ)` rather than `(k : ℤ) + (n : ℤ)` so that the degree-`0` part of
`twistGrading 𝒮 ((k + n : ℕ) : ℤ)` is the one `degreeSection 𝒮 (k + n)` uses, which avoids a
cast.

`AlgebraicGeometry.ProjectiveSpectrum.Proj.mul_mem_integerGrading` duplicates, for the
`integerGrading` of `StacksFrontier/AlgebraicGeometry/Constructions/ProjTwist.lean`, what
`Stacks.GradedModule.mul_mem_integerGrading` says for the separate copy of `integerGrading` in
`StacksFrontier/AlgebraicGeometry/ProjTwists/Basic.lean`. The two `integerGrading`s are distinct
constants with identical definitions; the twisting sheaves are built from the first, so the
second lemma does not apply to them.

## References

* [Stacks Project, Tag 0BXK](https://stacks.math.columbia.edu/tag/0BXK)
* [Stacks Project, Tag 0801](https://stacks.math.columbia.edu/tag/0801)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace
open scoped AlgebraicGeometry

namespace AlgebraicGeometry

universe u

variable {X Y : Scheme.{u}} (f : X ⟶ Y) {F G : Y.Modules} (φ : F ⟶ G)

namespace ProjectiveSpectrum.Proj

open Stacks.AlgebraicGeometry
open AlgebraicGeometry.ProjectiveSpectrum.Proj

universe w

variable {S : Type u} {σ : Type w} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

/-- Multiplying an element of degree `j` of `integerGrading 𝒮` by a homogeneous element of
degree `k` gives an element of degree `k + j`. -/
theorem mul_mem_integerGrading {k : ℕ} {a : S} (ha : a ∈ 𝒮 k) {j : ℤ} {x : S}
    (hx : x ∈ integerGrading (S := S) 𝒮 j) :
    a * x ∈ integerGrading (S := S) 𝒮 ((k : ℤ) + j) := by
  by_cases hj : 0 ≤ j
  · have hx' : x ∈ 𝒮 j.toNat := by simpa [integerGrading, hj] using hx
    have ht : (0 : ℤ) ≤ (k : ℤ) + j := by omega
    have heq : ((k : ℤ) + j).toNat = k + j.toNat := by omega
    simpa [integerGrading, ht, heq, homogeneousSubmodule] using SetLike.mul_mem_graded ha hx'
  · have hx0 : x = 0 := by
      rw [integerGrading_neg 𝒮 j (by omega)] at hx
      simpa using hx
    rw [hx0, mul_zero]
    exact zero_mem _

/-- Multiplication by a homogeneous element of degree `k`, as a morphism
`𝒪_{Proj 𝒮}(n) ⟶ 𝒪_{Proj 𝒮}(k + n)` of twisting sheaves. -/
noncomputable def twistMulLeft {k : ℕ} (a : 𝒮 k) (n : ℕ) :
    twistingSheaf 𝒮 (n : ℤ) ⟶ twistingSheaf 𝒮 ((k + n : ℕ) : ℤ) :=
  ProjSheafFunctoriality.associatedModuleSheafMap 𝒮 (twistGrading (S := S) 𝒮 (n : ℤ))
    (twistGrading (S := S) 𝒮 ((k + n : ℕ) : ℤ)) (LinearMap.mulLeft S (a : S)) <| by
      intro j x hx
      have h := mul_mem_integerGrading 𝒮 a.2 (j := j + (n : ℤ)) hx
      have he : (k : ℤ) + (j + (n : ℤ)) = j + ((k + n : ℕ) : ℤ) := by push_cast; ring
      rw [he] at h
      exact h

private theorem twistMulLeft_degreeSection_val {k : ℕ} (a : 𝒮 k) (n : ℕ) (b : 𝒮 n) :
    (twistMulLeft 𝒮 a n).val.app (op ⊤) (degreeSection 𝒮 n b) =
      degreeSection 𝒮 (k + n) ⟨(a : S) * (b : S), SetLike.mul_mem_graded a.2 b.2⟩ :=
  ProjStalkGlobalSections.degreeZeroToGlobalSections_naturality 𝒮
    (twistGrading (S := S) 𝒮 (n : ℤ)) (twistGrading (S := S) 𝒮 ((k + n : ℕ) : ℤ))
    (LinearMap.mulLeft S (a : S)) _ _

/-- Multiplication by `a` carries the canonical section of `𝒪(n)` attached to a homogeneous
element `b` of degree `n` to the one attached to `a * b`. -/
theorem twistMulLeft_degreeSection {k : ℕ} (a : 𝒮 k) (n : ℕ) (b : 𝒮 n) :
    Scheme.Modules.Hom.app (X := Proj 𝒮) (M := twistingSheaf 𝒮 (n : ℤ))
        (N := twistingSheaf 𝒮 ((k + n : ℕ) : ℤ)) (twistMulLeft 𝒮 a n) ⊤
        (degreeSection 𝒮 n b) =
      degreeSection 𝒮 (k + n) ⟨(a : S) * (b : S), SetLike.mul_mem_graded a.2 b.2⟩ :=
  twistMulLeft_degreeSection_val 𝒮 a n b

/-- If the section of `𝒪(n)` attached to a homogeneous element `b` pulls back to zero along
`i`, then so does the section of `𝒪(k + n)` attached to `a * b`, for every homogeneous `a`. -/
theorem pullbackGlobalSections_degreeSection_mul_eq_zero {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮)
    {k n : ℕ} (a : 𝒮 k) (b : 𝒮 n)
    (hb : pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ)) (degreeSection 𝒮 n b) = 0) :
    pullbackGlobalSections i (twistingSheaf 𝒮 ((k + n : ℕ) : ℤ))
        (degreeSection 𝒮 (k + n) ⟨(a : S) * (b : S), SetLike.mul_mem_graded a.2 b.2⟩) = 0 := by
  rw [← twistMulLeft_degreeSection 𝒮 a n b]
  calc pullbackGlobalSections i (twistingSheaf 𝒮 ((k + n : ℕ) : ℤ))
        (Scheme.Modules.Hom.app (X := Proj 𝒮) (M := twistingSheaf 𝒮 (n : ℤ))
          (N := twistingSheaf 𝒮 ((k + n : ℕ) : ℤ)) (twistMulLeft 𝒮 a n) ⊤
          (degreeSection 𝒮 n b))
      = (Scheme.Modules.Hom.app (X := Proj 𝒮) (M := twistingSheaf 𝒮 (n : ℤ))
            (N := twistingSheaf 𝒮 ((k + n : ℕ) : ℤ)) (twistMulLeft 𝒮 a n) ⊤ ≫
          pullbackGlobalSections i (twistingSheaf 𝒮 ((k + n : ℕ) : ℤ)))
          (degreeSection 𝒮 n b) := (CategoryTheory.comp_apply _ _ _).symm
    _ = (pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ)) ≫
          Scheme.Modules.Hom.app
            ((Scheme.Modules.pullback i).map (twistMulLeft 𝒮 a n)) ⊤)
          (degreeSection 𝒮 n b) :=
        ConcreteCategory.congr_hom
          (Stacks.AlgebraicGeometry.IdealOfClosedSubscheme.pullbackGlobalSections_naturality_app i
            (F := twistingSheaf 𝒮 (n : ℤ)) (G := twistingSheaf 𝒮 ((k + n : ℕ) : ℤ))
            (twistMulLeft 𝒮 a n)).symm _
    _ = Scheme.Modules.Hom.app ((Scheme.Modules.pullback i).map (twistMulLeft 𝒮 a n)) ⊤
          (pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ)) (degreeSection 𝒮 n b)) :=
        CategoryTheory.comp_apply _ _ _
    _ = 0 := by rw [hb, map_zero]

/-- The canonical section of `𝒪(n)` attached to the zero element of degree `n` is zero. -/
theorem degreeSection_zero (n : ℕ) : degreeSection 𝒮 n 0 = 0 := by
  unfold degreeSection
  exact map_zero _

/-- The canonical section of `𝒪(n)` attached to a sum of two homogeneous elements of degree `n`
is the sum of their sections. -/
theorem degreeSection_add (n : ℕ) (b c : 𝒮 n) :
    degreeSection 𝒮 n (b + c) = degreeSection 𝒮 n b + degreeSection 𝒮 n c := by
  unfold degreeSection
  show ProjStalkGlobalSections.degreeZeroToGlobalSections 𝒮
    (twistGrading (S := S) 𝒮 (n : ℤ)) ⟨(b : S) + (c : S), _⟩ = _
  rw [← map_add]
  congr 1

/-- The same statement as `pullbackGlobalSections_degreeSection_mul_eq_zero`, with the degree of
the product given by an equation rather than literally `k + n`. -/
theorem pullbackGlobalSections_degreeSection_eq_zero_of_mul {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮)
    {k n m : ℕ} (hm : m = k + n) (a : 𝒮 k) (b : 𝒮 n) (c : 𝒮 m)
    (hc : (c : S) = (a : S) * (b : S))
    (hb : pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ)) (degreeSection 𝒮 n b) = 0) :
    pullbackGlobalSections i (twistingSheaf 𝒮 (m : ℤ)) (degreeSection 𝒮 m c) = 0 := by
  subst hm
  rw [show c = ⟨(a : S) * (b : S), SetLike.mul_mem_graded a.2 b.2⟩ from Subtype.ext hc]
  exact pullbackGlobalSections_degreeSection_mul_eq_zero 𝒮 i a b hb

/-- The section of `𝒪(n)` attached to a homogeneous element that is zero pulls back to zero. -/
private theorem pullbackGlobalSections_degreeSection_eq_zero_of_eq_zero {Z : Scheme.{u}}
    (i : Z ⟶ Proj 𝒮) {n : ℕ} (b : 𝒮 n) (hb : b = 0) :
    pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ)) (degreeSection 𝒮 n b) = 0 := by
  rw [hb, degreeSection_zero]
  exact map_zero _

/-- The elements of `S` all of whose homogeneous components have twisted section vanishing on
`Z`, as an additive submonoid. -/
private def vanishingSections {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) : AddSubmonoid S where
  carrier := {x : S | ∀ n : ℕ, pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ))
    (degreeSection 𝒮 n (DirectSum.decompose 𝒮 x n)) = 0}
  zero_mem' := by
    intro n
    exact pullbackGlobalSections_degreeSection_eq_zero_of_eq_zero 𝒮 i _ (by simp)
  add_mem' := by
    intro x y hx hy n
    rw [show (DirectSum.decompose 𝒮 (x + y) n : 𝒮 n) =
      DirectSum.decompose 𝒮 x n + DirectSum.decompose 𝒮 y n from by simp]
    refine ((congrArg
      (ConcreteCategory.hom (pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ))))
      (degreeSection_add 𝒮 n (DirectSum.decompose 𝒮 x n)
        (DirectSum.decompose 𝒮 y n))).trans (map_add _ _ _)).trans ?_
    rw [hx n, hy n, add_zero]

private lemma vanishingSections_mul_homogeneous {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮)
    {j : ℕ} {c : S} (hc : c ∈ 𝒮 j) {x : S} (hx : x ∈ vanishingSections 𝒮 i) :
    c * x ∈ vanishingSections 𝒮 i := by
  show ∀ n : ℕ, pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ))
    (degreeSection 𝒮 n (DirectSum.decompose 𝒮 (c * x) n)) = 0
  intro n
  by_cases h : j ≤ n
  · exact pullbackGlobalSections_degreeSection_eq_zero_of_mul 𝒮 i
      (show n = j + (n - j) by omega) ⟨c, hc⟩ (DirectSum.decompose 𝒮 x (n - j)) _
      (DirectSum.coe_decompose_mul_of_left_mem_of_le 𝒮 hc h) (hx (n - j))
  · exact pullbackGlobalSections_degreeSection_eq_zero_of_eq_zero 𝒮 i _
      (Subtype.ext (DirectSum.coe_decompose_mul_of_left_mem_of_not_le 𝒮 hc h))

private lemma vanishingSections_mul {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) (r : S) {x : S}
    (hx : x ∈ vanishingSections 𝒮 i) : r * x ∈ vanishingSections 𝒮 i := by
  classical
  rw [← DirectSum.sum_support_decompose 𝒮 r, Finset.sum_mul]
  exact AddSubmonoid.sum_mem _ fun j _ ↦
    vanishingSections_mul_homogeneous 𝒮 i (DirectSum.decompose 𝒮 r j).2 hx

/-- An element of `S` lies in the ideal of a closed subscheme `Z ⊆ Proj 𝒮` exactly when, for
every `n`, the section of `𝒪(n)` attached to its degree-`n` homogeneous component pulls back to
zero on `Z`. -/
@[stacks 0BXK "ideal_of_a_closed_subscheme"]
theorem mem_idealOfClosedSubscheme_iff {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮)
    [IsClosedImmersion i] (a : S) :
    a ∈ idealOfClosedSubscheme 𝒮 i ↔
      ∀ n : ℕ, pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ))
        (degreeSection 𝒮 n (DirectSum.decompose 𝒮 a n)) = 0 := by
  classical
  constructor
  · intro ha
    show a ∈ vanishingSections 𝒮 i
    induction ha using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨m, b, rfl, hb⟩ := hy
      show ∀ n : ℕ, pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ))
        (degreeSection 𝒮 n (DirectSum.decompose 𝒮 (b : S) n)) = 0
      intro n
      by_cases hn : n = m
      · subst hn
        rw [show (DirectSum.decompose 𝒮 (b : S) n : 𝒮 n) = b from
          Subtype.ext (DirectSum.decompose_of_mem_same 𝒮 b.2)]
        exact hb
      · exact pullbackGlobalSections_degreeSection_eq_zero_of_eq_zero 𝒮 i _
          (Subtype.ext (DirectSum.decompose_of_mem_ne 𝒮 b.2 (Ne.symm hn)))
    | zero => exact (vanishingSections 𝒮 i).zero_mem
    | add y z _ _ hy hz => exact (vanishingSections 𝒮 i).add_mem hy hz
    | smul r y _ hy => exact vanishingSections_mul 𝒮 i r hy
  · intro h
    rw [← DirectSum.sum_support_decompose 𝒮 a]
    exact Submodule.sum_mem _ fun n _ ↦
      mem_idealOfClosedSubscheme 𝒮 i n (DirectSum.decompose 𝒮 a n) (h n)

end ProjectiveSpectrum.Proj

end AlgebraicGeometry

