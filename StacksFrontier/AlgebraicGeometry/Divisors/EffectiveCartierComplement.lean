module

public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.Morphisms.Closure.DenseOpenImmersion
public import Mathlib.RingTheory.Regular.Flat
public import Mathlib.RingTheory.Localization.Away.Basic

/-!
# The complement of an effective Cartier divisor is scheme-theoretically dense

Let `X` be a scheme and `D ⊂ X` an effective Cartier divisor, presented by its ideal-sheaf
data `I`.  Then `X ∖ D` is scheme-theoretically dense in `X`.  This is the density half of
[Stacks, Tag 07ZU](https://stacks.math.columbia.edu/tag/07ZU).

## Main results

* `Stacks.Divisors.exists_affineOpen_basicOpen_eq_inf_compl_support`: around every point of
  every open there is an affine open `W` on which `X ∖ D` is the basic open of a nonzerodivisor
  `f ∈ Γ(X, W)`.
* `Stacks.Divisors.isSchemeTheoreticallyDense_compl_of_isEffectiveCartierDivisor`:
  **Tag 07ZU, scheme-theoretic density.**

## Implementation notes

The source reduces the density statement to the affine case by Tag 01RE and then quotes
`A ⊆ A_f` for a nonzerodivisor `f`.  Here the reduction used is the library form of 01RE,
`AlgebraicGeometry.isSchemeTheoreticallyDense_opensRange_iff_mono`: an open immersion has
scheme-theoretically dense image exactly when its comorphism is a monomorphism, i.e. when
`j.app V` is injective for every open `V` of `X`.  Injectivity of `j.app V` is checked
sectionwise and is therefore local on `V`, by `TopCat.Presheaf.IsSheaf.section_ext`, so the
affine reduction happens there rather than in the density predicate.

On an affine open `W` on which `I` is generated by a nonzerodivisor `f`, the complement of the
divisor meets `W` in `X.basicOpen f`
(`Stacks.Divisors.basicOpen_eq_inf_compl_support_of_ideal_eq_span`), so `Γ(X ∖ D, j⁻¹W)` is the
localization `Γ(X, W)_f` and `j.app W` is `A → A_f`, injective because every power of `f` is a
nonzerodivisor (`IsLocalization.injectiveₛ`).  That such a `W` exists around every point of
every open is `Stacks.Divisors.exists_affineOpen_basicOpen_eq_inf_compl_support`, which is Tag
01WS in the form `Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor`
shrunk to a basic open; the nonzerodivisor survives the shrinking because `Γ(X, W)` is a
localization of `Γ(X, U)` (`RingTheory.Sequence.IsWeaklyRegular.of_isLocalization`).

The affineness half of Tag 07ZU is **proved**, in
`StacksFrontier/AlgebraicGeometry/Divisors/LocallyPrincipalComplementAffine.lean`: Tag 07ZT —
the complement of a locally principal closed subscheme is affine over the scheme — is
`Stacks.Divisors.isAffineHom_compl_of_isLocallyPrincipal` there, and applying it to the divisor
through `Stacks.Divisors.isLocallyPrincipal_of_isEffectiveCartierDivisor` below gives
`Stacks.Divisors.isAffineHom_compl_of_isEffectiveCartierDivisor`, which carries
`@[stacks 07ZU "affineness"]`.  So both halves of Tag 07ZU are tagged.

Note that affineness needs nothing about nonzerodivisors — only local principality.

## References

* [Stacks Project, Tag 07ZU](https://stacks.math.columbia.edu/tag/07ZU)
* [Stacks Project, Tag 01RE](https://stacks.math.columbia.edu/tag/01RE)
* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

universe u

namespace Stacks.Divisors

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- **An effective Cartier divisor is locally principal.**  This is the remark following
Definition 01WR; it is Tag 01WS together with the fact that a principal ideal is principal. -/
theorem isLocallyPrincipal_of_isEffectiveCartierDivisor
    (hI : IsEffectiveCartierDivisor I) : IsLocallyPrincipal I := fun x => by
  obtain ⟨U, hU, hxU, f, -, hgen⟩ :=
    exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor I hI x
  exact ⟨⟨U, hU⟩, hxU, ⟨f, hgen⟩⟩

/-- A nonzerodivisor on an affine open restricts to a nonzerodivisor on a basic open of it:
the ring of sections there is a localization. -/
theorem isRegular_res_of_eq_basicOpen {U W : X.affineOpens} (hUW : W.1 ≤ U.1)
    (g f : Γ(X, U.1)) (e : W.1 = X.basicOpen g) (hf : IsRegular f) :
    IsRegular ((X.presheaf.map (homOfLE hUW).op).hom f) := by
  let _ : Algebra Γ(X, U.1) Γ(X, W.1) :=
    (X.presheaf.map (homOfLE hUW).op).hom.toAlgebra
  have _ : IsLocalization.Away g Γ(X, W.1) :=
    U.2.isLocalization_of_eq_basicOpen g (homOfLE hUW) e
  have hsmul : IsSMulRegular Γ(X, W.1)
      ((X.presheaf.map (homOfLE hUW).op).hom f) := by
    show IsSMulRegular Γ(X, W.1) (algebraMap Γ(X, U.1) Γ(X, W.1) f)
    exact (RingTheory.Sequence.isWeaklyRegular_singleton_iff _ _).1
      (((RingTheory.Sequence.isWeaklyRegular_singleton_iff Γ(X, U.1) f).2
        hf.isSMulRegular).of_isLocalization Γ(X, W.1) (.powers g))
  exact ⟨fun a b hab => hsmul (by simpa [Algebra.smul_def] using hab),
    fun a b hab => hsmul (by simpa [Algebra.smul_def, mul_comm] using hab)⟩

/-- **On an affine open where the ideal is principal, the complement of the subscheme is the
basic open of the generator.** -/
theorem basicOpen_eq_inf_compl_support_of_ideal_eq_span (W : X.affineOpens) (f : Γ(X, W.1))
    (hgen : I.ideal W = Ideal.span {f}) :
    X.basicOpen f = W.1 ⊓ I.support.compl := by
  ext y
  show (y ∈ X.basicOpen f) ↔ (y ∈ W.1 ∧ y ∉ I.support)
  by_cases hy : y ∈ W.1
  · simp only [hy, true_and]
    rw [I.mem_support_iff_of_mem hy, hgen, Scheme.zeroLocus_span]
    simp [Scheme.mem_zeroLocus_iff]
  · simp [hy, show y ∉ X.basicOpen f from fun h => hy (X.basicOpen_le f h)]

/-- **The affine charts of Tag 07ZU.**  Around every point of every open of `X` there is an
affine open `W` inside that open and a nonzerodivisor `f ∈ Γ(X, W)` whose basic open is the
part of the complement of the divisor lying in `W`. -/
theorem exists_affineOpen_basicOpen_eq_inf_compl_support
    (hI : IsEffectiveCartierDivisor I) (V : X.Opens) (x : X) (hxV : x ∈ V) :
    ∃ W : X.affineOpens, x ∈ W.1 ∧ W.1 ≤ V ∧
      ∃ f : Γ(X, W.1), IsRegular f ∧ X.basicOpen f = W.1 ⊓ I.support.compl := by
  obtain ⟨-, ⟨V₀, hV₀, rfl⟩, hxV₀, hV₀V⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxV V.isOpen
  obtain ⟨U, hU, hxU, f, hf, hgen⟩ :=
    exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor I hI x
  obtain ⟨g, g₀, hgg₀, hxW⟩ :=
    AlgebraicGeometry.exists_basicOpen_le_affine_inter hU hV₀ x ⟨hxU, hxV₀⟩
  let U' : X.affineOpens := ⟨U, hU⟩
  let V' : X.affineOpens := ⟨V₀, hV₀⟩
  let g' : Γ(X, U'.1) := g
  let g₀' : Γ(X, V'.1) := g₀
  let W : X.affineOpens := X.affineBasicOpen g'
  have hWU : W ≤ U' := X.affineBasicOpen_le g'
  have hWV' : W.1 ≤ V'.1 := hgg₀.trans_le (X.affineBasicOpen_le g₀')
  have hgenW : I.ideal W = Ideal.span {(X.presheaf.map (homOfLE hWU).op).hom f} := by
    have h1 : I.ideal W = Ideal.map (X.presheaf.map (homOfLE hWU).op).hom (I.ideal U') :=
      (I.map_ideal hWU).symm
    rw [h1, show I.ideal U' = Ideal.span {f} from hgen, Ideal.map_span,
      Set.image_singleton]
  exact ⟨W, hxW, hWV'.trans hV₀V, (X.presheaf.map (homOfLE hWU).op).hom f,
    isRegular_res_of_eq_basicOpen hWU g' f rfl hf,
    basicOpen_eq_inf_compl_support_of_ideal_eq_span I W _ hgenW⟩

/-- **The comorphism of the complementary open immersion is injective on an affine chart.**
On such a chart the sections of the complement are the localization at the generator, so the
restriction map is `A → A_f`. -/
theorem injective_app_compl_support_of_chart (W : X.affineOpens) (f : Γ(X, W.1))
    (hbasic : X.basicOpen f = W.1 ⊓ I.support.compl) (hf : IsRegular f) :
    Function.Injective (((Scheme.Opens.ι I.support.compl).app W.1).hom) := by
  let Uc : X.Opens := I.support.compl
  let j : Uc.toScheme ⟶ X := Scheme.Opens.ι Uc
  have hR : j ''ᵁ (j ⁻¹ᵁ W.1) = X.basicOpen f := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι, hbasic,
      inf_comm]
  have hRW : j ''ᵁ (j ⁻¹ᵁ W.1) ≤ W.1 := (hR.trans hbasic).le.trans inf_le_left
  let rho : Γ(X, W.1) →+* Γ(X, j ''ᵁ (j ⁻¹ᵁ W.1)) :=
    (X.presheaf.map (homOfLE hRW).op).hom
  let _ : Algebra Γ(X, W.1) Γ(X, j ''ᵁ (j ⁻¹ᵁ W.1)) := rho.toAlgebra
  have _ : IsLocalization.Away f Γ(X, j ''ᵁ (j ⁻¹ᵁ W.1)) :=
    W.2.isLocalization_of_eq_basicOpen f (homOfLE hRW) hR
  have hrho : Function.Injective rho := by
    refine IsLocalization.injectiveₛ (M := Submonoid.powers f) _ fun g hg => ?_
    obtain ⟨n, rfl⟩ := hg
    exact hf.pow n
  have hcomp : j.app W.1 ≫ (j.appIso (j ⁻¹ᵁ W.1)).inv =
      X.presheaf.map (homOfLE hRW).op := by
    rw [j.app_appIso_inv]
    rfl
  have hcompi : Function.Injective (j.app W.1 ≫ (j.appIso (j ⁻¹ᵁ W.1)).inv).hom := by
    simpa only [hcomp, RingHom.comp_apply] using hrho
  exact fun a b hab => hcompi (congrArg (j.appIso (j ⁻¹ᵁ W.1)).inv.hom hab)

/-- **The comorphism of the complementary open immersion is injective.**  Injectivity on
sections is local, and the affine charts of
`Stacks.Divisors.exists_affineOpen_basicOpen_eq_inf_compl_support` supply it locally. -/
theorem injective_app_compl_support (hI : IsEffectiveCartierDivisor I) (V : X.Opens) :
    Function.Injective (((Scheme.Opens.ι I.support.compl).app V).hom) := by
  let Uc : X.Opens := I.support.compl
  let j : Uc.toScheme ⟶ X := Scheme.Opens.ι Uc
  intro s t hst
  refine X.IsSheaf.section_ext fun x hx => ?_
  obtain ⟨W, hxW, hWV, f, hf, hbasic⟩ :=
    exists_affineOpen_basicOpen_eq_inf_compl_support I hI V x hx
  refine ⟨W.1, hWV, hxW, injective_app_compl_support_of_chart I W f hbasic hf ?_⟩
  have hn := j.naturality (homOfLE hWV).op
  have hn_s := congrArg (fun k => k.hom s) hn
  have hn_t := congrArg (fun k => k.hom t) hn
  simp only [ConcreteCategory.comp_apply] at hn_s hn_t
  rw [hn_s, hn_t]
  exact congrArg (Uc.toScheme.presheaf.map ((Opens.map j.base).map (homOfLE hWV)).op).hom hst

/-- The comorphism of a morphism of schemes is a monomorphism as soon as it is injective on
sections over every open. -/
theorem mono_c_of_forall_app_injective {Y Z : Scheme.{u}} (f : Y ⟶ Z)
    (h : ∀ V : Z.Opens, Function.Injective (f.app V).hom) : Mono f.c := by
  rw [NatTrans.mono_iff_mono_app]
  exact fun V => (ConcreteCategory.mono_iff_injective_of_preservesPullback _).mpr (h V.unop)

/-- **Stacks Project, Tag 07ZU (scheme-theoretic density).**  The complement of an effective
Cartier divisor is scheme-theoretically dense in the ambient scheme. -/
@[stacks 07ZU "scheme-theoretic density"]
theorem isSchemeTheoreticallyDense_compl_of_isEffectiveCartierDivisor
    (hI : IsEffectiveCartierDivisor I) :
    Scheme.Opens.IsSchemeTheoreticallyDense I.support.compl := by
  simpa only [Scheme.Opens.opensRange_ι] using
    (isSchemeTheoreticallyDense_opensRange_iff_mono (Scheme.Opens.ι I.support.compl)).2
      (mono_c_of_forall_app_injective _ (injective_app_compl_support I hI))

end Stacks.Divisors

end
