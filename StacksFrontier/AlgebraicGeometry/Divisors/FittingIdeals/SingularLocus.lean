/-- For a morphism locally of finite presentation whose fibre through `x` is equidimensional of
dimension `d`, the local dimension of that fibre at the image of `x` is `d`. -/
private lemma fiber_topologicalKrullDimAt_eq_of_equidimensional
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFinitePresentation f]
    (x : X) (d : ℕ) (he : TopologicalSpace.Equidimensional (f.fiber (f x)))
    (hd : topologicalKrullDim (f.fiber (f x)) = (d : WithBot ℕ∞)) :
    topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x) = (d : WithBot ℕ∞) := by
  let Y := f.fiber (f x)
  let y : Y := f.asFiber x
  have : LocallyOfFiniteType (f.fiberToSpecResidueField (f x)) := by
    show LocallyOfFiniteType
      (Limits.pullback.snd f (S.fromSpecResidueField (f x)))
    infer_instance
  obtain ⟨C, hC, hyC, hdimy⟩ :=
    exists_mem_irreducibleComponents_topologicalKrullDim_eq_topologicalKrullDimAt
      (S.residueField (f x)) Y (f.fiberToSpecResidueField (f x)) y
  have hloc (z : Y) : topologicalKrullDimAt Y z = topologicalKrullDim C := by
    obtain ⟨D, hD, hzD, hdimz⟩ :=
      exists_mem_irreducibleComponents_topologicalKrullDim_eq_topologicalKrullDimAt
        (S.residueField (f x)) Y (f.fiberToSpecResidueField (f x)) z
    rw [← hdimz]
    exact he D hD C hC
  have : Nonempty Y := ⟨y⟩
  have hglobal : topologicalKrullDim Y = topologicalKrullDim C := by
    rw [TopologicalSpace.topologicalKrullDim_eq_iSup_localKrullDim]
    simp_rw [← TopologicalSpace.topologicalKrullDimAt_eq_localKrullDim, hloc]
    exact iSup_const
  exact hdimy.symm.trans (hglobal.symm.trans hd)

/-- The numerical criterion for smoothness at a point whose fibre has local dimension `d`: a
flat morphism locally of finite presentation is smooth at `x` exactly when its relative
cotangent space at `x` is generated by at most `d` elements. -/
private lemma smoothAt_iff_generatedByAtMost_relativeCotangentSpace
    {X S : Scheme.{u}} (f : X ⟶ S) [Flat f]
    [LocallyOfFinitePresentation f] (x : X) (d : ℕ)
    (hdim : topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x) =
      (d : WithBot ℕ∞)) :
    InfinitesimalLifting.SmoothAt f x ↔
      GeneratedByAtMost (X.residueField x)
        (relativeCotangentSpace f x) (d : WithBot ℕ∞) := by
  have hflat : (f.stalkMap x).hom.Flat :=
    (Flat.iff_flat_stalkMap f).mp (inferInstance : Flat f) x
  have h := (Stacks.Tag01V9NumericalCriterion.smoothAt_tfae f x).out 1 4
  rw [hdim] at h
  simpa [hflat] using h

/-- A point lies in the `r`-th Fitting closed subscheme of a finite type quasi-coherent module
exactly when the pullback of the module to the residue field of that point fails to be generated
by `r` sections. -/
private theorem mem_fittingIdeal_iff_not_generatedByNear_residueField
    {X : Scheme.{u}} (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) (x : X) :
    x ∈ Set.range (fittingIdeal F (r : ℤ)).subschemeι ↔
      ¬ ∀ t : Spec (.of (X.residueField x)),
        IsGeneratedByNear
          ((Scheme.Modules.pullback (X.fromSpecResidueField x)).obj F) r t := by
  classical
  let p := X.fromSpecResidueField x
  let T := Spec (.of (X.residueField x))
  let t : T := IsLocalRing.closedPoint (X.residueField x)
  let I := fittingIdeal F (r : ℤ)
  let G := (Scheme.Modules.pullback p).obj F
  have : G.IsFiniteType :=
    @SheafOfModules.pullback_isFiniteType _ _ p.toLRSHom.toShHom F ‹F.IsFiniteType›
  have : G.IsQuasicoherent :=
    @SheafOfModules.modulePullback_isQuasicoherent _ _ p.toLRSHom.toShHom F ‹F.IsQuasicoherent›
  have hopen : ∀ y : X, y ∈ (fittingGeneratorOpen F r : Set X) ↔
      y ∉ (I.support : Set X) := by
    intro y
    show y ∉ Set.range (fittingClosedSubscheme F (r : ℤ)).hom.base ↔ _
    rw [fittingClosedSubscheme_ofNat]
    show y ∉ Set.range I.subschemeι ↔ _
    rw [Scheme.IdealSheafData.range_subschemeι]
  have hfactor :
      (∃! q : T ⟶ (fittingGeneratorOpen F r).toScheme,
        q ≫ (fittingGeneratorOpen F r).ι = p) ↔
        x ∈ (fittingGeneratorOpen F r : Set X) := by
    constructor
    · rintro ⟨q, hq, -⟩
      have hqrange : p.base t ∈ Set.range (fittingGeneratorOpen F r).ι.base :=
        ⟨q.base t, by
          simpa only [Scheme.Hom.comp_apply] using congrArg (fun q : T ⟶ X => q.base t) hq⟩
      rw [Scheme.Opens.range_ι] at hqrange
      simpa [p, Scheme.fromSpecResidueField_apply] using hqrange
    · intro hx
      have hrange : Set.range p.base ⊆ Set.range (fittingGeneratorOpen F r).ι.base := by
        rw [Scheme.Opens.range_ι, Set.range_subset_iff]
        intro z
        show p.base z ∈ fittingGeneratorOpen F r
        simpa [p, Scheme.fromSpecResidueField_apply] using hx
      exact ⟨IsOpenImmersion.lift _ p hrange, by simp,
        fun q hq => IsOpenImmersion.lift_uniq _ p hrange q hq⟩
  have hgen : (∀ z : T, IsGeneratedByNear G r z) ↔
      x ∈ (fittingGeneratorOpen F r : Set X) :=
    (locallyGenerated_iff_factorsThrough_fittingGeneratorOpen F r p).trans hfactor
  have hsupport : x ∈ I.support ↔ ¬ ∀ z : T, IsGeneratedByNear G r z := by
    rw [hgen]
    exact ⟨fun hx hopenx => (hopen x).mp hopenx hx,
      fun hnot => not_not.mp fun hn => hnot ((hopen x).mpr hn)⟩
  rw [Scheme.IdealSheafData.range_subschemeι]
  exact hsupport

/-- The canonical residue field point of `x` makes the residue field at `x` an algebra over the
local ring of `X` at that point compatibly with the stalk of the structure sheaf of the
spectrum, so the three rings form a scalar tower. -/
theorem isScalarTower_stalk_residueField_specResidueFieldStalk
    {X : Scheme.{u}} (x : X) :
    let K := X.residueField x
    let T := Spec (.of K)
    let t : T := IsLocalRing.closedPoint K
    let p := X.fromSpecResidueField x
    let D := T.toPresheafedSpace.presheaf.stalk t
    let A := X.presheaf.stalk (p t)
    let L := X.residueField (p t)
    let hpt : p t = x := Scheme.fromSpecResidueField_apply x t
    let eField := (X.residueFieldCongr hpt).commRingCatIsoToRingEquiv
    let eD := (stalkClosedPointIso (.of K)).commRingCatIsoToRingEquiv
    let eDL := eD.trans eField.symm
    letI : Algebra A D := (p.toLRSHom.toShHom.hom.stalkMap t).hom.toAlgebra
    letI : Algebra A L := (X.residue (p t)).hom.toAlgebra
    letI : Algebra L D := eDL.symm.toRingHom.toAlgebra
    IsScalarTower A L D := by
  dsimp
  let K := X.residueField x
  let T := Spec (.of K)
  let t : T := IsLocalRing.closedPoint K
  let p := X.fromSpecResidueField x
  let D := T.toPresheafedSpace.presheaf.stalk t
  let A := X.presheaf.stalk (p t)
  let L := X.residueField (p t)
  let hpt : p t = x := Scheme.fromSpecResidueField_apply x t
  let eField : L ≃+* K := (X.residueFieldCongr hpt).commRingCatIsoToRingEquiv
  let eD : D ≃+* K := (stalkClosedPointIso (.of K)).commRingCatIsoToRingEquiv
  let eDL : D ≃+* L := eD.trans eField.symm
  let : Algebra A D := (p.toLRSHom.toShHom.hom.stalkMap t).hom.toAlgebra
  let : Algebra A L := (X.residue (p t)).hom.toAlgebra
  let : Algebra L D := eDL.symm.toRingHom.toAlgebra
  have : IsLocalHom (Scheme.stalkClosedPointTo p).hom := Scheme.isLocalHom_stalkClosedPointTo' p
  let δ : L ⟶ .of K := @Scheme.descResidueField _ _ X (p t)
      (Scheme.stalkClosedPointTo p) (Scheme.isLocalHom_stalkClosedPointTo' p)
  have hdesc : δ = (X.residueFieldCongr hpt).hom := by
    apply (Spec.map_inj).mp
    apply (cancel_mono (X.fromSpecResidueField (p t))).mp
    rw [Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField,
      Scheme.residueFieldCongr_fromSpecResidueField hpt]
  have hcomp : (p.toLRSHom.toShHom).hom.stalkMap t ≫ (stalkClosedPointIso (.of K)).hom =
      Scheme.stalkClosedPointTo p := rfl
  have hcompa (a : A) : eD (algebraMap A D a) = (Scheme.stalkClosedPointTo p).hom a := by
    show ((stalkClosedPointIso (.of K)).hom.hom) _ = _
    exact congrArg (fun φ : A ⟶ .of K => φ.hom a) hcomp
  have hδ (a : A) : eField ((X.residue (p t)).hom a) =
      (Scheme.stalkClosedPointTo p).hom a := by
    have hr := @Scheme.residue_descResidueField K _ X (p t)
      (Scheme.stalkClosedPointTo p) (Scheme.isLocalHom_stalkClosedPointTo' p)
    have hra := congrArg (fun φ : A ⟶ .of K => φ.hom a) hr
    change δ.hom ((X.residue (p t)).hom a) = (Scheme.stalkClosedPointTo p).hom a at hra
    show ((X.residueFieldCongr hpt).hom).hom ((X.residue (p t)).hom a) =
      (Scheme.stalkClosedPointTo p).hom a
    simpa only [hdesc] using hra
  have hf (a : A) : eDL (algebraMap A D a) = (algebraMap A L) a := by
    show eField.symm (eD (algebraMap A D a)) = (X.residue (p t)).hom a
    rw [hcompa a, ← hδ a]
    exact eField.symm_apply_apply _
  exact IsScalarTower.of_algebraMap_eq' (by
    ext a
    exact eDL.injective ((hf a).trans (eDL.apply_symm_apply _).symm))

/-- In a subsingleton space, an open set containing a point is the whole space. -/
private lemma opens_eq_top_of_mem_of_subsingleton {T : Type*} [TopologicalSpace T]
    [Subsingleton T] {U : Opens T} {t : T} (h : t ∈ U) : U = ⊤ :=
  SetLike.ext fun z => ⟨fun _ => trivial, fun _ => by rwa [Subsingleton.elim z t]⟩

/-- On a subsingleton space every section over the whole space is determined by, and realises,
an arbitrary germ at the unique point. -/
private theorem germ_top_bijective_of_subsingleton {T : TopCat.{u}} [Subsingleton T]
    {C : Type (u + 1)} [Category.{u} C] [HasColimits C] {FC : C → C → Type*}
    {CC : C → Type u} [∀ X Y, FunLike (FC X Y) (CC X) (CC Y)] [ConcreteCategory.{u} C FC]
    [PreservesFilteredColimits (forget C)] (P : T.Presheaf C) (t : T) :
    Function.Bijective (P.germ ⊤ t trivial) := by
  constructor
  · intro s₁ s₂ h
    obtain ⟨W, hW, i₁, i₂, hres⟩ := P.germ_eq t (U := ⊤) (V := ⊤) (by simp) (by simp) s₁ s₂ h
    obtain rfl := opens_eq_top_of_mem_of_subsingleton hW
    obtain rfl : i₁ = 𝟙 _ := Subsingleton.elim _ _
    obtain rfl : i₂ = 𝟙 _ := Subsingleton.elim _ _
    simpa using hres
  · intro y
    obtain ⟨U, hU, s, hs⟩ := P.exists_germ_eq y
    obtain rfl := opens_eq_top_of_mem_of_subsingleton hU
    exact ⟨s, hs⟩

/-- On the spectrum of a field the global sections of a sheaf of modules are its stalk at the
unique point, linearly over the field. -/
private theorem nonempty_sectionsStalkLinearEquiv {K : Type u} [Field K]
    (F : (Spec (.of K)).Modules) :
    let t : Spec (.of K) := IsLocalRing.closedPoint K
    let D := (Spec (.of K)).presheaf.stalk t
    let R := Γ(Spec (.of K), ⊤)
    letI : Algebra K R := (Scheme.ΓSpecIso (.of K)).inv.hom.toAlgebra
    letI : Module R Γ(F, ⊤) := inferInstance
    letI : Module K Γ(F, ⊤) := Module.compHom Γ(F, ⊤) (algebraMap K R)
    let eD := (stalkClosedPointIso (.of K)).commRingCatIsoToRingEquiv
    letI : Algebra K D := eD.symm.toRingHom.toAlgebra
    letI : Module D (F.presheaf.stalk t) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier F.val t
    letI : Module K (F.presheaf.stalk t) := Module.compHom _ (algebraMap K D)
    Nonempty (Γ(F, ⊤) ≃ₗ[K] F.presheaf.stalk t) := by
  dsimp
  let t : Spec (.of K) := IsLocalRing.closedPoint K
  let D := (Spec (.of K)).presheaf.stalk t
  let R := Γ(Spec (.of K), ⊤)
  let : Algebra K R := (Scheme.ΓSpecIso (.of K)).inv.hom.toAlgebra
  let : Module R Γ(F, ⊤) := inferInstance
  let : Module K Γ(F, ⊤) := Module.compHom Γ(F, ⊤) (algebraMap K R)
  let eD := (stalkClosedPointIso (.of K)).commRingCatIsoToRingEquiv
  let : Algebra K D := eD.symm.toRingHom.toAlgebra
  let : Module D (F.presheaf.stalk t) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier F.val t
  let : Module K (F.presheaf.stalk t) := Module.compHom _ (algebraMap K D)
  let g := F.presheaf.germ ⊤ t trivial
  let gfun : Γ(F, ⊤) → F.presheaf.stalk t := fun s => g s
  let gAdd : Γ(F, ⊤) →+ F.presheaf.stalk t :=
    AddMonoidHom.mk (ZeroHom.mk gfun (by simp [gfun, g]))
      (fun s₁ s₂ => by simp [gfun, g])
  let l : Γ(F, ⊤) →ₗ[K] F.presheaf.stalk t :=
    LinearMap.mk gAdd (by
      intro a s
      show gfun (((Scheme.ΓSpecIso (.of K)).inv.hom a) • s) =
        algebraMap K D a • gfun s
      rw [show gfun (((Scheme.ΓSpecIso (.of K)).inv.hom a) • s) =
          (Spec (.of K)).presheaf.germ ⊤ t trivial ((Scheme.ΓSpecIso (.of K)).inv a) • gfun s from
        PresheafOfModules.germ_smul F.val t ⊤ trivial ((Scheme.ΓSpecIso (.of K)).inv a) s]
      have hconst : (Spec (.of K)).presheaf.germ ⊤ t trivial
          ((Scheme.ΓSpecIso (.of K)).inv a) = algebraMap K D a := by
        apply (stalkClosedPointIso (.of K)).commRingCatIsoToRingEquiv.injective
        show ((stalkClosedPointIso (.of K)).hom.hom) _ = _
        calc
          ((stalkClosedPointIso (.of K)).hom.hom)
              ((Spec (.of K)).presheaf.germ ⊤ t trivial ((Scheme.ΓSpecIso (.of K)).inv a)) = a := by
                simpa using congrArg
                  (fun φ : Γ(Spec (.of K), ⊤) ⟶ .of K => φ.hom ((Scheme.ΓSpecIso (.of K)).inv a))
                  (germ_stalkClosedPointIso_hom (R := .of K))
          _ = eD (algebraMap K D a) := (eD.apply_symm_apply a).symm
      rw [hconst])
  have hbij : Function.Bijective l := germ_top_bijective_of_subsingleton F.presheaf t
  exact ⟨LinearEquiv.ofBijective l hbij⟩

/-- Over a field the `r`-th Fitting ideal of a finite-dimensional vector space is the unit ideal
exactly when the space has rank at most `r`. -/
@[sga "7 VI 5.1" "5.1(b), special case"]
private theorem moduleFittingIdeal_eq_top_iff_finrank_le {K : Type u} {V : Type u}
    [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V] (r : ℕ) :
    _root_.fittingIdeal (R := K) (M := V) (r : ℤ) = ⊤ ↔
      Module.finrank K V ≤ r := by
  let b := Module.finBasis K V
  let e : (Fin (Module.finrank K V) → K) ≃ₗ[K] V := b.equivFun.symm
  have h₁ := (fittingIdeal_basic_properties.{u, u, u, u}
    (R := K) (M := V)).2.2.2.2.1
      (Fin (Module.finrank K V) → K) e.symm.toLinearMap r e.symm.surjective
  have h₂ := (fittingIdeal_basic_properties.{u, u, u, u}
    (R := K) (M := Fin (Module.finrank K V) → K)).2.2.2.2.1
      V e.toLinearMap r e.surjective
  rw [le_antisymm h₁ h₂, fittingIdeal_fin_eq_bot_or_top]
  split_ifs with h
  · simp [show ¬ Module.finrank K V ≤ r by omega]
  · simp [show Module.finrank K V ≤ r by omega]

/-- Over a field, generation by at most `r` elements of a finite-dimensional vector space is the
rank bound `r`. -/
private theorem generatedByAtMost_natCast_iff_finrank_le {K : Type u} {V : Type u}
    [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V] (r : ℕ) :
    GeneratedByAtMost K V (r : WithBot ℕ∞) ↔ Module.finrank K V ≤ r := by
  rw [Stacks.Tag01V9Closure.generatedByAtMost_iff_finrank_le]
  exact Nat.cast_le

/-- Transporting a basis along a ring isomorphism acting by the same scalar multiplication
keeps the module finite and leaves the rank unchanged. -/
private theorem finite_and_finrank_eq_of_ringEquiv {K R : Type u} {M : Type u}
    [Field K] [Field R] [AddCommGroup M] [Module K M] [Module R M]
    [FiniteDimensional K M]
    (e : K ≃+* R) (h : ∀ (c : K) (m : M), e c • m = c • m) :
    Module.Finite R M ∧ Module.finrank K M = Module.finrank R M := by
  let b := (Module.finBasis K M).mapCoeffs e h
  exact ⟨Module.Finite.of_basis b,
    by rw [Module.finrank_eq_card_basis (Module.finBasis K M), Module.finrank_eq_card_basis b]⟩

/-- On the spectrum of a field the global sections of a quasi-coherent module of finite type are
finite-dimensional over the field. -/
private lemma moduleFinite_field_sections_on_spec_field {K : Type u} [Field K]
    (F : (Spec (.of K)).Modules) [F.IsFiniteType] [F.IsQuasicoherent] :
    letI : Algebra K Γ(Spec (.of K), ⊤) := (Scheme.ΓSpecIso (.of K)).inv.hom.toAlgebra
    letI : Module K Γ(F, ⊤) := Module.compHom _ (algebraMap K Γ(Spec (.of K), ⊤))
    Module.Finite K Γ(F, ⊤) := by
  let M : ModuleCat (CommRingCat.of K) := moduleSpecΓFunctor.obj F
  have : IsIso F.fromTildeΓ := (isQuasicoherent_iff_isIso_fromTildeΓ F).mp inferInstance
  exact (tilde_isFiniteType_iff M).mp
    (Stacks.SheafOfModules.isFiniteType_of_iso.{u} (asIso F.fromTildeΓ).symm)

/-- On a one-point scheme the stalk of an ideal sheaf at that point is the image of its ideal of
global sections. -/
private theorem idealSheafData_stalk_of_subsingleton {K : Type u} [Field K]
    (T : Scheme.{u}) (t : T) [Subsingleton T] (I : T.IdealSheafData) :
    IdealSheafData.stalk I t =
      Ideal.map (T.presheaf.germ ⊤ t trivial).hom
        (I.ideal ⟨⊤, isAffineOpen_top T⟩) := by
  classical
  let Utop : T.affineOpens := ⟨⊤, isAffineOpen_top T⟩
  show (⨆ U : T.affineOpens, ⨆ h : t ∈ U.1,
    Ideal.map (T.presheaf.germ U.1 t h).hom (I.ideal U)) = _
  apply le_antisymm
  · apply iSup_le
    intro U
    apply iSup_le
    intro h
    have hU' : U = Utop := Subtype.ext (opens_eq_top_of_mem_of_subsingleton h)
    subst U
    have : h = (by simp [Utop] : t ∈ Utop.1) := Subsingleton.elim _ _
    subst h
    rfl
  · exact le_iSup_of_le Utop (le_iSup_of_le (by simp [Utop]) le_rfl)

/-- On the spectrum of a field a quasi-coherent module of finite type is generated by `r`
sections near the unique point exactly when its space of global sections has rank at most `r`. -/
private theorem isGeneratedByNear_specField_iff_finrank_le {K : Type u} [Field K]
    (F : (Spec (.of K)).Modules) [F.IsFiniteType] [F.IsQuasicoherent] (r : ℕ) :
    let t : Spec (.of K) := IsLocalRing.closedPoint K
    IsGeneratedByNear F r t ↔
      let R := Γ(Spec (.of K), ⊤)
      letI : Algebra K R := (Scheme.ΓSpecIso (.of K)).inv.hom.toAlgebra
      letI : Module K Γ(F, ⊤) := Module.compHom _ (algebraMap K R)
      Module.finrank K Γ(F, ⊤) ≤ r := by
  classical
  let T := Spec (.of K)
  let t : T := IsLocalRing.closedPoint K
  let R := Γ(T, ⊤)
  let : Algebra K R := (Scheme.ΓSpecIso (.of K)).inv.hom.toAlgebra
  let : Module K Γ(F, ⊤) := Module.compHom _ (algebraMap K R)
  let eR : R ≃+* K := (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv
  let : Field R := eR.toMulEquiv.isField (Field.toIsField K) |>.toField
  have : Module.Finite K Γ(F, ⊤) := moduleFinite_field_sections_on_spec_field F
  obtain ⟨_, hrank⟩ := finite_and_finrank_eq_of_ringEquiv (M := Γ(F, ⊤)) eR.symm fun _ _ => rfl
  let Utop : T.affineOpens := ⟨⊤, isAffineOpen_top T⟩
  show IsGeneratedByNear F r t ↔ _
  rw [isGeneratedByNear_iff_fittingIdeal_stalk_eq_top,
    idealSheafData_stalk_of_subsingleton (K := K) T t, fittingIdeal_ideal F (r : ℤ) Utop,
    Ideal.map_eq_top_of_bijective (f := (T.presheaf.germ ⊤ t trivial).hom)
      (germ_top_bijective_of_subsingleton _ t),
    moduleFittingIdeal_eq_top_iff_finrank_le, ← hrank]

/-- Base change along the canonical residue field point identifies the stalk of the pullback of
the relative differentials with the relative cotangent space at that point. -/
private theorem nonempty_pullbackStalkCotangentLinearEquiv
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) :
    let K := X.residueField x
    let T := Spec (.of K)
    let t : T := IsLocalRing.closedPoint K
    let p := X.fromSpecResidueField x
    let y := p t
    let F := Scheme.Hom.relativeDifferentials f
    let G := (Scheme.Modules.pullback p).obj F
    let D := T.toPresheafedSpace.presheaf.stalk t
    let A := X.presheaf.stalk y
    let Ω := F.presheaf.stalk y
    let L := X.residueField y
    let hpt : y = x := Scheme.fromSpecResidueField_apply x t
    let eField := (X.residueFieldCongr hpt).commRingCatIsoToRingEquiv
    let eD := (stalkClosedPointIso (.of K)).commRingCatIsoToRingEquiv
    let eDL := eD.trans eField.symm
    letI : Algebra K D := eD.symm.toRingHom.toAlgebra
    letI : Algebra A D := (p.toLRSHom.toShHom.hom.stalkMap t).hom.toAlgebra
    letI : Algebra A L := (X.residue y).hom.toAlgebra
    letI : Algebra L D := eDL.symm.toRingHom.toAlgebra
    letI : Module A Ω := relativeDifferentialStalkModule f y
    letI : IsScalarTower A L D := isScalarTower_stalk_residueField_specResidueFieldStalk x
    letI : Module D (G.presheaf.stalk t) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier G.val t
    letI : Module L (G.presheaf.stalk t) := Module.compHom _ (algebraMap L D)
    Nonempty ((G.presheaf.stalk t) ≃ₗ[L] (relativeCotangentSpace f y)) := by
  dsimp
  let K := X.residueField x
  let T := Spec (.of K)
  let t : T := IsLocalRing.closedPoint K
  let p := X.fromSpecResidueField x
  let F := Scheme.Hom.relativeDifferentials f
  let G := (Scheme.Modules.pullback p).obj F
  let D := T.toPresheafedSpace.presheaf.stalk t
  let A := X.presheaf.stalk (p t)
  let Ω := F.presheaf.stalk (p t)
  let L := X.residueField (p t)
  let hpt : p t = x := Scheme.fromSpecResidueField_apply x t
  let eField : L ≃+* K := (X.residueFieldCongr hpt).commRingCatIsoToRingEquiv
  let eD : D ≃+* K := (stalkClosedPointIso (.of K)).commRingCatIsoToRingEquiv
  let eDL : D ≃+* L := eD.trans eField.symm
  let : Algebra K D := eD.symm.toRingHom.toAlgebra
  let : Algebra A D := (p.toLRSHom.toShHom.hom.stalkMap t).hom.toAlgebra
  let : Algebra A L := (X.residue (p t)).hom.toAlgebra
  let : Algebra L D := eDL.symm.toRingHom.toAlgebra
  let : Module A Ω := relativeDifferentialStalkModule f (p t)
  have : IsScalarTower A L D := isScalarTower_stalk_residueField_specResidueFieldStalk x
  let : Module D (G.presheaf.stalk t) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier G.val t
  let : Module L (G.presheaf.stalk t) := Module.compHom _ (algebraMap L D)
  have : IsScalarTower L D (G.presheaf.stalk t) := IsScalarTower.of_compHom L D _
  have : IsScalarTower L D (D ⊗[A] Ω) := IsScalarTower.of_compHom L D _
  let eDLalg : D ≃ₐ[L] L := AlgEquiv.ofRingEquiv (f := eDL) eDL.apply_symm_apply
  let eTensor : D ⊗[A] Ω ≃ₗ[L] L ⊗[A] Ω :=
    TensorProduct.AlgebraTensorModule.congr eDLalg.toLinearEquiv (LinearEquiv.refl A Ω)
  obtain ⟨ep, _⟩ := RingedSpaceModuleAdjunction.exists_modulePullbackStalkLinearEquiv
    p.toLRSHom.toShHom F t
  have ep' : (G.presheaf.stalk t) ≃ₗ[D] (D ⊗[A] Ω) := ep
  let epL : (G.presheaf.stalk t) ≃ₗ[L] D ⊗[A] Ω :=
    LinearEquiv.ofBijective (LinearMap.restrictScalars L ep'.toLinearMap) ep'.bijective
  show Nonempty ((G.presheaf.stalk t) ≃ₗ[L] (L ⊗[A] Ω))
  exact ⟨epL.trans eTensor⟩

/-- At the canonical residue field point of `x`, the pullback of `Ω_{X/S}` is generated by `d`
sections exactly when the relative cotangent space at `x` is generated by at most `d` elements. -/
private theorem isGeneratedByNear_pullback_relativeDifferentials_iff_generatedByAtMost
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f] (x : X) (d : ℕ) :
    let t : Spec (.of (X.residueField x)) := IsLocalRing.closedPoint (X.residueField x)
    let p := X.fromSpecResidueField x
    IsGeneratedByNear ((Scheme.Modules.pullback p).obj (Scheme.Hom.relativeDifferentials f)) d t ↔
      GeneratedByAtMost (X.residueField (p t)) (relativeCotangentSpace f (p t))
        (d : WithBot ℕ∞) := by
  intro t p
  classical
  let K := X.residueField x
  let T := Spec (.of K)
  let F := Scheme.Hom.relativeDifferentials f
  let z := p t
  let G := (Scheme.Modules.pullback p).obj F
  have hGfinite : G.IsFiniteType :=
    @SheafOfModules.pullback_isFiniteType _ _ p.toLRSHom.toShHom F
      (Scheme.Hom.isFiniteType_relativeDifferentials f)
  have hGQC : G.IsQuasicoherent :=
    @SheafOfModules.modulePullback_isQuasicoherent _ _ p.toLRSHom.toShHom F
      (Scheme.Hom.isQuasicoherent_relativeDifferentials f)
  let D := T.toPresheafedSpace.presheaf.stalk t
  let L := X.residueField z
  let eField : L ≃+* K := (X.residueFieldCongr
    (Scheme.fromSpecResidueField_apply x t)).commRingCatIsoToRingEquiv
  let eD : D ≃+* K := (stalkClosedPointIso (.of K)).commRingCatIsoToRingEquiv
  let eDL : D ≃+* L := eD.trans eField.symm
  let R := Γ(T, ⊤)
  let : Algebra K R := (Scheme.ΓSpecIso (.of K)).inv.hom.toAlgebra
  let : Module K Γ(G, ⊤) := Module.compHom _ (algebraMap K R)
  have : Module.Finite K Γ(G, ⊤) :=
    @moduleFinite_field_sections_on_spec_field (↑K) inferInstance G hGfinite hGQC
  let : Module D (G.presheaf.stalk t) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      G.val t
  let : Module K (G.presheaf.stalk t) := Module.compHom _ eD.symm.toRingHom
  let : Module L (G.presheaf.stalk t) := Module.compHom _ eDL.symm.toRingHom
  obtain ⟨eSections⟩ := nonempty_sectionsStalkLinearEquiv (K := K) G
  obtain ⟨eCotangent⟩ := nonempty_pullbackStalkCotangentLinearEquiv f x
  have : Module.Finite K (G.presheaf.stalk t) := Module.Finite.equiv eSections
  have hscalar (c : K) (m : G.presheaf.stalk t) :
      eField.symm c • m = c • m := by
    show eDL.symm (eField.symm c) • m = eD.symm c • m
    congr 1
    show eD.symm (eField (eField.symm c)) = eD.symm c
    simp
  obtain ⟨_, hcross⟩ := finite_and_finrank_eq_of_ringEquiv eField.symm hscalar
  have : Module.Finite L (relativeCotangentSpace f z) := Module.Finite.equiv eCotangent
  show IsGeneratedByNear G d t ↔
    GeneratedByAtMost L (relativeCotangentSpace f z) (d : WithBot ℕ∞)
  calc
    IsGeneratedByNear G d t ↔ Module.finrank K Γ(G, ⊤) ≤ d :=
      @isGeneratedByNear_specField_iff_finrank_le _ inferInstance G hGfinite hGQC d
    _ ↔ Module.finrank L (relativeCotangentSpace f z) ≤ d := by
      rw [eSections.finrank_eq, hcross, eCotangent.finrank_eq]
    _ ↔ GeneratedByAtMost L (relativeCotangentSpace f z) (d : WithBot ℕ∞) :=
      (generatedByAtMost_natCast_iff_finrank_le d).symm

/-- **The nonsmooth locus is cut out by the `d`-th Fitting ideal of the relative
differentials.** For `f : X ⟶ S` flat and locally of finite presentation whose nonempty fibres
are all equidimensional of dimension `d`, a point of `X` lies in the closed subscheme defined by
the `d`-th Fitting ideal of `Ω_{X/S}` exactly when `f` is not smooth at that point. -/
@[stacks 0C3K "pointwise characterisation of the nonsmooth locus"]
theorem mem_fittingIdeal_relativeDifferentials_iff_not_smoothAt
    {X S : Scheme.{u}} (f : X ⟶ S) [Flat f]
    [LocallyOfFinitePresentation f] (d : ℕ)
    (hd : ∀ s : S, Nonempty (f.fiber s) →
      (TopologicalSpace.Equidimensional (f.fiber s) ∧
        topologicalKrullDim (f.fiber s) = (d : WithBot ℕ∞)))
    (x : X) :
    x ∈ Set.range
      (fittingIdeal (Scheme.Hom.relativeDifferentials f) (d : ℤ)).subschemeι ↔
      ¬ InfinitesimalLifting.SmoothAt f x := by
  classical
  let F := Scheme.Hom.relativeDifferentials f
  have : F.IsFiniteType := Scheme.Hom.isFiniteType_relativeDifferentials f
  have : F.IsQuasicoherent := Scheme.Hom.isQuasicoherent_relativeDifferentials f
  let K := X.residueField x
  let T := Spec (.of K)
  let t : T := IsLocalRing.closedPoint K
  let p := X.fromSpecResidueField x
  let z := p t
  let G := (Scheme.Modules.pullback p).obj F
  have hzx : z = x := Scheme.fromSpecResidueField_apply x t
  have hgenAll : (∀ y : T, IsGeneratedByNear G d y) ↔ IsGeneratedByNear G d t :=
    ⟨fun h => h t, fun ht y => by simpa [Subsingleton.elim y t] using ht⟩
  have hmem := mem_fittingIdeal_iff_not_generatedByNear_residueField F d x
  have hdimFiberZ := hd (f z) ⟨f.asFiber z⟩
  have hdimz := fiber_topologicalKrullDimAt_eq_of_equidimensional f z d hdimFiberZ.1 hdimFiberZ.2
  calc
    x ∈ Set.range (fittingIdeal F (d : ℤ)).subschemeι ↔
        ¬ IsGeneratedByNear G d t := hmem.trans (not_congr hgenAll)
    _ ↔ ¬ GeneratedByAtMost (X.residueField z)
        (relativeCotangentSpace f z) (d : WithBot ℕ∞) :=
      not_congr (isGeneratedByNear_pullback_relativeDifferentials_iff_generatedByAtMost f x d)
    _ ↔ ¬ InfinitesimalLifting.SmoothAt f z :=
      (not_congr (smoothAt_iff_generatedByAtMost_relativeCotangentSpace f z d hdimz)).symm
    _ ↔ ¬ InfinitesimalLifting.SmoothAt f x := by rw [hzx]

/-- **The closed subscheme cut out by the `d`-th Fitting ideal of `Ω_{X/S}` is the nonsmooth
locus.** For `f : X ⟶ S` flat and locally of finite presentation whose nonempty fibres are all
equidimensional of dimension `d`, that closed subscheme has as its underlying subset of `X`
exactly the set of points at which `f` is not smooth. -/
@[stacks 0C3K]
theorem range_subschemeι_fittingIdeal_relativeDifferentials
    {X S : Scheme.{u}} (f : X ⟶ S) [Flat f]
    [LocallyOfFinitePresentation f] (d : ℕ)
    (hd : ∀ s : S, Nonempty (f.fiber s) →
      (TopologicalSpace.Equidimensional (f.fiber s) ∧
        topologicalKrullDim (f.fiber s) = (d : WithBot ℕ∞))) :
    Set.range (fittingIdeal (Scheme.Hom.relativeDifferentials f) (d : ℤ)).subschemeι =
      {x : X | ¬ InfinitesimalLifting.SmoothAt f x} :=
  Set.ext fun x => mem_fittingIdeal_relativeDifferentials_iff_not_smoothAt f d hd x

end AlgebraicGeometry

