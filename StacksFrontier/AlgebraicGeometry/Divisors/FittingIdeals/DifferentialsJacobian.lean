module

public import StacksFrontier.AlgebraicGeometry.Curves.FittingIdealJacobianMinors
public import StacksFrontier.AlgebraicGeometry.Divisors.FittingIdeals.RelativeDifferentialsStalk

/-!
# The stalk of a Fitting ideal sheaf of differentials as an ideal of Jacobian minors

Let `f : X ⟶ S` be locally of finite type and let `x ∈ X`. On an affine open `Spec A = U ∋ x`
lying over an affine open `Spec R = V` with `R` Noetherian, `A` is a finitely presented
`R`-algebra, so it has a presentation by `n` generators and `m` relations. The stalk at `x` of
the `r`-th Fitting ideal sheaf of `Ω_{X/S}` is then the ideal of `𝒪_{X,x}` generated by the
`(n - r) × (n - r)` minors of the Jacobian matrix of those relations.

## Main results

* `AlgebraicGeometry.exists_affineOpen_le_preimage` — every point lies in an affine open mapping
  into an affine open of the target.
* `AlgebraicGeometry.finitePresentation_appLE` — for a morphism locally of finite type with
  Noetherian affine base sections, the sections on an affine chart are a finitely presented
  algebra.
* `AlgebraicGeometry.stalk_fittingIdeal_eq_map_minorIdeal_jacobian` — the stalk of the Fitting
  ideal sheaf of `Ω_{X/S}` is generated by the Jacobian minors of a finite presentation.
* `AlgebraicGeometry.stalk_fittingIdeal_eq_maximalIdeal_iff` — at a closed point, that stalk is
  the maximal ideal exactly when the Jacobian minors generate the prime of the point modulo its
  square.
* `AlgebraicGeometry.stalk_fittingIdeal_eq_maximalIdeal_iff_of_presentation` — the same for an
  arbitrary presentation of the chart, so that one centred at the point may be chosen.
* `AlgebraicGeometry.stalk_fittingIdeal_eq_maximalIdeal_iff_jacobianMinorIdealModulo` — over a
  base isomorphic to a field, that condition is the Jacobian condition of Tag 0C4C for the
  power-series model attached to a presentation centred at the point.

## Implementation notes

Finite presentation comes from finite type of `f.appLE` together with
`Algebra.FinitePresentation.of_finiteType` over a Noetherian base, and the presentation itself is
`Algebra.Presentation.ofFinitePresentation`. The two halves of the computation are
`AlgebraicGeometry.stalk_fittingIdeal_relativeDifferentials`, which expresses the stalk through
the Fitting ideal of `Ω_{A/R}`, and
`Stacks.Curves.fittingIdeal_kaehlerDifferential_eq_minorIdeal_jacobian`, which computes that
Fitting ideal as an ideal of minors of the Jacobian matrix.

The base ring is an arbitrary Noetherian ring rather than a field: no more is used, and the
index of minors is `n - r` for the number `n` of generators of the chosen presentation.

## References

* [Stacks Project, Tag 0C3D](https://stacks.math.columbia.edu/tag/0C3D)
* [Stacks Project, Tag 0C4D](https://stacks.math.columbia.edu/tag/0C4D)
* [Stacks Project, Tag 00RM](https://stacks.math.columbia.edu/tag/00RM)
-/

@[expose] public section

open CategoryTheory Algebra MvPolynomial

universe u

namespace AlgebraicGeometry

/-- Every point of the source of a morphism of schemes lies in an affine open contained in the
preimage of an affine open of the target. -/
theorem exists_affineOpen_le_preimage {X S : Scheme.{u}} (f : X ⟶ S) (x : X) :
    ∃ U : X.Opens, IsAffineOpen U ∧ x ∈ U ∧ ∃ V : S.Opens, IsAffineOpen V ∧ U ≤ f ⁻¹ᵁ V := by
  obtain ⟨V, hV, hfxV, -⟩ :=
    exists_isAffineOpen_mem_and_subset (X := S) (x := f.base x) (U := ⊤) trivial
  obtain ⟨U, hU, hxU, hUV⟩ :=
    exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := f ⁻¹ᵁ V) hfxV
  exact ⟨U, hU, hxU, V, hV, hUV⟩

/-- For a morphism locally of finite type, the sections on an affine chart over an affine open of
the target with Noetherian sections are a finitely presented algebra. -/
theorem finitePresentation_appLE {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f]
    {U : X.Opens} (hU : IsAffineOpen U) {V : S.Opens} (hV : IsAffineOpen V)
    (hUV : U ≤ f ⁻¹ᵁ V) [IsNoetherianRing Γ(S, V)] :
    letI := Stacks.Smooth.algebraAppLE f hUV
    Algebra.FinitePresentation Γ(S, V) Γ(X, U) := by
  let := Stacks.Smooth.algebraAppLE f hUV
  have hft : (algebraMap Γ(S, V) Γ(X, U)).FiniteType := f.finiteType_appLE hV hU hUV
  have : Algebra.FiniteType Γ(S, V) Γ(X, U) := RingHom.finiteType_algebraMap.mp hft
  exact Algebra.FinitePresentation.of_finiteType.1 this

/-- **The stalk of a Fitting ideal sheaf of the relative differentials is an ideal of Jacobian
minors.** For `f : X ⟶ S` locally of finite type, an affine open `Spec A = U ∋ x` over an affine
open `Spec R = V` with `R` Noetherian, and a presentation of `A` over `R` by `n` generators and
`m` relations `f_j`, the stalk at `x` of the `r`-th Fitting ideal sheaf of `Ω_{X/S}` is generated
in `𝒪_{X,x}` by the `(n - r) × (n - r)` minors of `(∂f_j/∂x_i)`. -/
theorem stalk_fittingIdeal_eq_map_minorIdeal_jacobian
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f] (r : ℕ) (x : X)
    (U : X.affineOpens) (hxU : x ∈ U.1) {V : S.Opens} (hV : IsAffineOpen V)
    (hUV : (U : X.Opens) ≤ f ⁻¹ᵁ V) [IsNoetherianRing Γ(S, V)] :
    letI := Stacks.Smooth.algebraAppLE f hUV
    letI := finitePresentation_appLE f U.2 hV hUV
    IdealSheafData.stalk (fittingIdeal (Scheme.Hom.relativeDifferentials f) (r : ℤ)) x =
      (minorIdeal (Matrix.of fun i j =>
        aeval (Algebra.Presentation.ofFinitePresentation Γ(S, V) Γ(X, U.1)).val
          (pderiv i ((Algebra.Presentation.ofFinitePresentation
            Γ(S, V) Γ(X, U.1)).relation j)))
        (Algebra.Presentation.ofFinitePresentationVars Γ(S, V) Γ(X, U.1) - r)).map
        (X.presheaf.germ U.1 x hxU).hom := by
  let := Stacks.Smooth.algebraAppLE f hUV
  have := finitePresentation_appLE f U.2 hV hUV
  rw [stalk_fittingIdeal_relativeDifferentials f (r : ℤ) x U hxU hV hUV,
    Stacks.Curves.fittingIdeal_kaehlerDifferential_eq_minorIdeal_jacobian
      (Algebra.Presentation.ofFinitePresentation Γ(S, V) Γ(X, U.1)) r]

/-- **The Fitting-ideal condition of Tag 0C4D at a closed point, in the affine chart.** The
stalk at a closed point `x` of the `r`-th Fitting ideal sheaf of `Ω_{X/S}` is the maximal ideal
of `𝒪_{X,x}` exactly when the Jacobian minors of a finite presentation of `Γ(X, U)` generate the
prime of `x` modulo its square. -/
theorem stalk_fittingIdeal_eq_maximalIdeal_iff
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f] (r : ℕ) (x : X)
    (U : X.affineOpens) (hxU : x ∈ U.1) (hx : IsClosed ({x} : Set X))
    {V : S.Opens} (hV : IsAffineOpen V) (hUV : (U : X.Opens) ≤ f ⁻¹ᵁ V)
    [IsNoetherianRing Γ(S, V)] :
    letI := Stacks.Smooth.algebraAppLE f hUV
    letI := finitePresentation_appLE f U.2 hV hUV
    let N := minorIdeal (Matrix.of fun i j =>
        aeval (Algebra.Presentation.ofFinitePresentation Γ(S, V) Γ(X, U.1)).val
          (pderiv i ((Algebra.Presentation.ofFinitePresentation
            Γ(S, V) Γ(X, U.1)).relation j)))
        (Algebra.Presentation.ofFinitePresentationVars Γ(S, V) Γ(X, U.1) - r)
    (IdealSheafData.stalk (fittingIdeal (Scheme.Hom.relativeDifferentials f) (r : ℤ)) x =
          IsLocalRing.maximalIdeal (X.presheaf.stalk x) ↔
        N ⊔ (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal ^ 2 =
          (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal) := by
  let := Stacks.Smooth.algebraAppLE f hUV
  have hfp := finitePresentation_appLE f U.2 hV hUV
  intro N
  have hft : Algebra.FiniteType Γ(S, V) Γ(X, U.1) := inferInstance
  have hnoethU : IsNoetherianRing Γ(X, U.1) :=
    Algebra.FiniteType.isNoetherianRing Γ(S, V) Γ(X, U.1)
  let := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxU⟩ : U.1)
  have hloc : IsLocalization.AtPrime (X.presheaf.stalk x)
      (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal := U.2.isLocalization_stalk ⟨x, hxU⟩
  have hmax : (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.IsMaximal :=
    U.2.primeIdealOf_isMaximal_of_isClosed ⟨x, hxU⟩ hx
  have hnoethS : IsNoetherianRing (X.presheaf.stalk x) :=
    IsLocalization.isNoetherianRing (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl _ hnoethU
  rw [stalk_fittingIdeal_eq_map_minorIdeal_jacobian f r x U hxU hV hUV]
  exact IsLocalRing.map_atPrime_eq_maximalIdeal_iff _ (X.presheaf.stalk x)

/-- **The Fitting-ideal condition of Tag 0C4D at a closed point, for an arbitrary presentation of
the chart.** Same as `AlgebraicGeometry.stalk_fittingIdeal_eq_maximalIdeal_iff`, but quantified
over presentations instead of using the arbitrary choice made by
`Algebra.Presentation.ofFinitePresentation`; this is what allows a presentation centred at the
point to be used. -/
theorem stalk_fittingIdeal_eq_maximalIdeal_iff_of_presentation
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f] (r : ℕ) (x : X)
    (U : X.affineOpens) (hxU : x ∈ U.1) (hx : IsClosed ({x} : Set X))
    {V : S.Opens} (hV : IsAffineOpen V) (hUV : (U : X.Opens) ≤ f ⁻¹ᵁ V)
    [IsNoetherianRing Γ(S, V)] :
    letI := Stacks.Smooth.algebraAppLE f hUV
    ∀ {n m : ℕ} (P : Algebra.Presentation Γ(S, V) Γ(X, U.1) (Fin n) (Fin m)),
      (IdealSheafData.stalk (fittingIdeal (Scheme.Hom.relativeDifferentials f) (r : ℤ)) x =
          IsLocalRing.maximalIdeal (X.presheaf.stalk x) ↔
        minorIdeal (Matrix.of fun (i : Fin n) (j : Fin m) =>
            aeval P.val (pderiv i (P.relation j))) (n - r) ⊔
          (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal ^ 2 = (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal) := by
  let := Stacks.Smooth.algebraAppLE f hUV
  have hfp := finitePresentation_appLE f U.2 hV hUV
  intro n m P
  have hft : Algebra.FiniteType Γ(S, V) Γ(X, U.1) := inferInstance
  have hnoethU : IsNoetherianRing Γ(X, U.1) :=
    Algebra.FiniteType.isNoetherianRing Γ(S, V) Γ(X, U.1)
  let := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxU⟩ : U.1)
  have hloc : IsLocalization.AtPrime (X.presheaf.stalk x)
      (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal := U.2.isLocalization_stalk ⟨x, hxU⟩
  have hmax : (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.IsMaximal :=
    U.2.primeIdealOf_isMaximal_of_isClosed ⟨x, hxU⟩ hx
  have hnoethS : IsNoetherianRing (X.presheaf.stalk x) :=
    IsLocalization.isNoetherianRing (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl _ hnoethU
  rw [stalk_fittingIdeal_relativeDifferentials f (r : ℤ) x U hxU hV hUV,
    Stacks.Curves.fittingIdeal_kaehlerDifferential_eq_minorIdeal_jacobian P r]
  exact IsLocalRing.map_atPrime_eq_maximalIdeal_iff _ (X.presheaf.stalk x)

/-- **The Fitting-ideal condition of Tag 0C4D at a closed point, as the Jacobian condition of Tag
0C4C.** Let `f : X ⟶ S` be locally of finite type, `x` a closed point in an affine open
`Spec A = U` over an affine open `Spec R = V`, and `e : R ≃+* K` an isomorphism onto a field.
For a presentation of `A` over `R` whose generators lie in the prime of `x`, the stalk at `x` of
the `r`-th Fitting ideal sheaf of `Ω_{X/S}` is the maximal ideal of `𝒪_{X,x}` exactly when the
`(n - r)`-minors of the Jacobian of the transported relations generate the maximal ideal of
`K[[x_1, …, x_n]] / (f)`. -/
theorem stalk_fittingIdeal_eq_maximalIdeal_iff_jacobianMinorIdealModulo
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f] (r : ℕ) (x : X)
    (U : X.affineOpens) (hxU : x ∈ U.1) (hx : IsClosed ({x} : Set X))
    {V : S.Opens} (hV : IsAffineOpen V) (hUV : (U : X.Opens) ≤ f ⁻¹ᵁ V)
    [IsNoetherianRing Γ(S, V)] (K : Type u) [Field K] (e : Γ(S, V) ≃+* K) :
    letI := Stacks.Smooth.algebraAppLE f hUV
    ∀ {n m : ℕ} (P : Algebra.Presentation Γ(S, V) Γ(X, U.1) (Fin n) (Fin m))
      (_hv : ∀ i, P.val i ∈ (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal)
      (hJ : Ideal.span (Set.range fun j =>
          MvPolynomial.map (e : Γ(S, V) →+* K) (P.relation j)) ≤
        MvPolynomial.idealOfVars (Fin n) K),
      letI : Nontrivial (MvPowerSeries (Fin n) K ⧸
          (Ideal.span (Set.range fun j =>
            MvPolynomial.map (e : Γ(S, V) →+* K) (P.relation j))).map
            (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := K))) :=
        Ideal.Quotient.nontrivial_iff.mpr
          (Stacks.MvPowerSeries.map_ne_top_of_le_idealOfVars hJ)
      letI : IsLocalRing (MvPowerSeries (Fin n) K ⧸
          (Ideal.span (Set.range fun j =>
            MvPolynomial.map (e : Γ(S, V) →+* K) (P.relation j))).map
            (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := K))) :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
      (IdealSheafData.stalk (fittingIdeal (Scheme.Hom.relativeDifferentials f) (r : ℤ)) x =
          IsLocalRing.maximalIdeal (X.presheaf.stalk x) ↔
        Stacks.Curves.jacobianMinorIdealModulo
            ((Ideal.span (Set.range fun j =>
              MvPolynomial.map (e : Γ(S, V) →+* K) (P.relation j))).map
              (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := K)))
            (fun j => ((MvPolynomial.map (e : Γ(S, V) →+* K) (P.relation j) :
              MvPowerSeries (Fin n) K))) (n - r) =
          IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K ⧸
            (Ideal.span (Set.range fun j =>
              MvPolynomial.map (e : Γ(S, V) →+* K) (P.relation j))).map
              (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := K)))) := by
  let := Stacks.Smooth.algebraAppLE f hUV
  intro n m P hv hJ
  have hmax : (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.IsMaximal :=
    U.2.primeIdealOf_isMaximal_of_isClosed ⟨x, hxU⟩ hx
  rw [stalk_fittingIdeal_eq_maximalIdeal_iff_of_presentation f r x U hxU hx hV hUV P,
    Stacks.Curves.sup_sq_eq_iff_jacobianMinorIdealModulo_of_ringEquiv K e P hv (n - r) hJ]

end AlgebraicGeometry

end
