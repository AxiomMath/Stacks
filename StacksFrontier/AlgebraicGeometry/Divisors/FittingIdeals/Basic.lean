/-!
# Generation by finitely many sections near a point and Fitting ideals

A quasi-coherent module of finite type on a scheme is generated by `r` sections on some
neighbourhood of a point exactly when the stalk of its `r`-th Fitting ideal at that point is
the unit ideal.

## Main definitions

* `AlgebraicGeometry.IdealSheafData.stalk` is the ideal induced in a local ring by an ideal
  sheaf.
* `AlgebraicGeometry.IsGeneratedByNear` means that a module is generated by `r` sections on
  some neighbourhood of a point.

## Main results

* `AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ` computes that ideal on any affine open
  neighbourhood of the point.
* `AlgebraicGeometry.isGeneratedByNear_iff_fittingIdeal_stalk_eq_top` characterizes generation
  by `r` sections near a point by the condition on the Fitting ideal.

## Implementation notes

Generation by finitely many sections is expressed by `GeneratingSections` with an index type
equivalent to `Fin r`; the local condition is an existential over open neighbourhoods, reduced
to affine neighbourhoods. The Fitting ideal is `AlgebraicGeometry.fittingIdeal`, whose value on
an affine open is the Fitting ideal of the module of sections there; its stalk at a point is
the image of that ideal in the local ring.

## References

* [Stacks Project, Tag 0C3F](https://stacks.math.columbia.edu/tag/0C3F)
-/

@[expose] public section

universe u

open CategoryTheory TopologicalSpace
open scoped TensorProduct

namespace AlgebraicGeometry

namespace IdealSheafData

/-- The stalk of an ideal sheaf at a point, as an ideal of the local ring. -/
public noncomputable def stalk {X : Scheme.{u}} (I : X.IdealSheafData) (s : X) :
    Ideal (X.presheaf.stalk s) :=
  ⨆ (U : X.affineOpens) (hs : s ∈ U.1),
    (I.ideal U).map (X.presheaf.germ U.1 s hs).hom

end IdealSheafData

/-- The ideal induced in a local ring by an ideal sheaf is the image, under the germ map, of
the sections of the ideal sheaf on any affine open neighbourhood of the point. -/
theorem IdealSheafData.stalk_eq_map_germ
    {X : Scheme.{u}} (I : X.IdealSheafData) (x : X)
    (U : X.affineOpens) (hx : x ∈ U.1) :
    IdealSheafData.stalk I x =
      (I.ideal U).map (X.presheaf.germ U.1 x hx).hom := by
  rw [IdealSheafData.stalk]
  apply le_antisymm
  · refine iSup_le fun V ↦ iSup_le fun hxV ↦ ?_
    obtain ⟨f, g, hfg, hxf⟩ :=
      exists_basicOpen_le_affine_inter U.2 V.2 x ⟨hx, hxV⟩
    let W := X.affineBasicOpen f
    have hWU : W ≤ U := X.basicOpen_le f
    have hWV : W ≤ V := hfg.trans_le (X.basicOpen_le g)
    have hxW : x ∈ W.1 := hxf
    let rUWcat := X.presheaf.map
      (homOfLE (X := X.Opens) (show (W : X.Opens) ≤ (U : X.Opens) from hWU)).op
    let rVWcat := X.presheaf.map
      (homOfLE (X := X.Opens) (show (W : X.Opens) ≤ (V : X.Opens) from hWV)).op
    have hcompU : rUWcat ≫ X.presheaf.germ W.1 x hxW =
        X.presheaf.germ U.1 x hx :=
      X.presheaf.germ_res (homOfLE (X := X.Opens)
        (show (W : X.Opens) ≤ (U : X.Opens) from hWU)) x hxW
    have hcompV : rVWcat ≫ X.presheaf.germ W.1 x hxW =
        X.presheaf.germ V.1 x hxV :=
      X.presheaf.germ_res (homOfLE (X := X.Opens)
        (show (W : X.Opens) ≤ (V : X.Opens) from hWV)) x hxW
    exact le_of_eq <| calc
      (I.ideal V).map (X.presheaf.germ V.1 x hxV).hom =
          ((I.ideal V).map rVWcat.hom).map (X.presheaf.germ W.1 x hxW).hom := by
            rw [Ideal.map_map]
            congr 1
            simpa only [CommRingCat.hom_comp] using
              (CommRingCat.hom_ext_iff.mp hcompV).symm
      _ = (I.ideal W).map (X.presheaf.germ W.1 x hxW).hom := by
            rw [← I.map_ideal hWV]
            rfl
      _ = ((I.ideal U).map rUWcat.hom).map (X.presheaf.germ W.1 x hxW).hom := by
            rw [← I.map_ideal hWU]
            rfl
      _ = (I.ideal U).map (X.presheaf.germ U.1 x hx).hom := by
            rw [Ideal.map_map]
            congr 1
            simpa only [CommRingCat.hom_comp] using
              CommRingCat.hom_ext_iff.mp hcompU
  · exact le_iSup_of_le U (le_iSup_of_le hx le_rfl)

/-- **Ideal sheaves are compared stalkwise.** If the ideal induced by `I` in every local ring is
contained in the one induced by `J`, then `I ≤ J`.

A section of `I` on an affine open lies in `J` there as soon as its germ at every point of that
open lies in the stalk of `J`, by `AlgebraicGeometry.IsAffineOpen.mem_ideal_iff`, and the germ
of such a section lies in the stalk of `I` by
`AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ`. -/
theorem IdealSheafData.le_of_stalk_le {X : Scheme.{u}} (I J : X.IdealSheafData)
    (h : ∀ x : X, IdealSheafData.stalk I x ≤ IdealSheafData.stalk J x) : I ≤ J := by
  rw [Scheme.IdealSheafData.le_def]
  intro U f hf
  refine U.2.mem_ideal_iff.mpr fun x hx => ?_
  have hfx : (X.presheaf.germ U.1 x hx).hom f ∈ IdealSheafData.stalk I x := by
    rw [IdealSheafData.stalk_eq_map_germ I x U hx]
    exact Ideal.mem_map_of_mem _ hf
  have hfx' := h x hfx
  rwa [IdealSheafData.stalk_eq_map_germ J x U hx] at hfx'

/-- **Ideal sheaves are determined by the ideals they induce in the local rings.** -/
theorem IdealSheafData.eq_of_stalk_eq {X : Scheme.{u}} (I J : X.IdealSheafData)
    (h : ∀ x : X, IdealSheafData.stalk I x = IdealSheafData.stalk J x) : I = J :=
  le_antisymm (IdealSheafData.le_of_stalk_le I J fun x => (h x).le)
    (IdealSheafData.le_of_stalk_le J I fun x => (h x).ge)

/-- A spanning family stays spanning after applying a linear equivalence. -/
private theorem span_range_comp_equiv_eq_top {R M N ι : Type*} [Semiring R] [AddCommMonoid M]
    [Module R M] [AddCommMonoid N] [Module R N] (e : M ≃ₗ[R] N) (g : ι → M)
    (hg : Submodule.span R (Set.range g) = ⊤) :
    Submodule.span R (Set.range fun i ↦ e (g i)) = ⊤ := by
  rw [show (Set.range fun i ↦ e (g i)) = e.toLinearMap '' Set.range g from Set.range_comp e g,
    Submodule.span_image, hg, Submodule.map_top]
  exact LinearMap.range_eq_top.mpr e.surjective

private theorem exists_generatingSections_of_span_sections
    {R : CommRingCat.{u}} (F : (Spec R).Modules) [F.IsQuasicoherent]
    (r : ℕ) (g : Fin r → Γ(F, ⊤))
    (hg : Submodule.span (R := R) (Set.range g) = ⊤) :
    ∃ G : F.GeneratingSections, Nonempty (G.I ≃ Fin r) := by
  classical
  let ι := ULift.{u, 0} (Fin r)
  let g' : ι → Γ(F, ⊤) := fun i ↦ g i.down
  have hrange : Set.range g' = Set.range g := ULift.down_surjective.range_comp g
  have hg' : Submodule.span (R := R) (Set.range g') = ⊤ := by rwa [hrange]
  let q : (ι →₀ R) →ₗ[R] Γ(F, ⊤) := Finsupp.linearCombination R g'
  have hq : Function.Surjective q := by
    rw [← LinearMap.range_eq_top, Finsupp.range_linearCombination, hg']
  let qhom : ModuleCat.of R (ι →₀ R) ⟶ ModuleCat.of R Γ(F, ⊤) :=
    ModuleCat.ofHom q
  have : Epi qhom := (ModuleCat.epi_iff_surjective qhom).mpr hq
  let e₁ := AlgebraicGeometry.tildeFinsupp (R := R) ι
  let e₂ : (AlgebraicGeometry.tilde.functor R).obj (ModuleCat.of R Γ(F, ⊤)) ≅ F :=
    @asIso _ _ _ _ F.fromTildeΓ
      (Scheme.Modules.isIso_fromTildeΓ_of_isQuasicoherent F)
  let ψ : SheafOfModules.free (R := (Spec R).ringCatSheaf) ι ⟶ F :=
    e₁.inv ≫ (AlgebraicGeometry.tilde.functor R).map qhom ≫ e₂.hom
  have : IsIso e₁.inv := e₁.isIso_inv
  have : IsIso e₂.hom := e₂.isIso_hom
  have : Epi e₁.inv := IsIso.epi_of_iso _
  have : Epi e₂.hom := IsIso.epi_of_iso _
  have : Epi ((AlgebraicGeometry.tilde.functor R).map qhom) :=
    Functor.map_epi _ qhom
  have : Epi ψ := by
    show Epi (e₁.inv ≫ (AlgebraicGeometry.tilde.functor R).map qhom ≫ e₂.hom)
    exact epi_comp'
      (show Epi e₁.inv from inferInstance)
      (epi_comp' (show Epi ((AlgebraicGeometry.tilde.functor R).map qhom) from inferInstance)
        (show Epi e₂.hom from inferInstance))
  exact ⟨(SheafOfModules.free.generatingSections (R := (Spec R).ringCatSheaf) ι).ofEpi ψ,
    ⟨Equiv.ulift.{u, 0}⟩⟩

open Scheme.Modules in
private theorem exists_generatingSections_of_localized_span
    {R : CommRingCat.{u}} (F : (Spec R).Modules) [F.IsQuasicoherent]
    (f : R) (r : ℕ) (g : Fin r → LocalizedModule.Away f Γ(F, ⊤))
    (hg : Submodule.span (R := Localization.Away f) (Set.range g) = ⊤) :
    ∃ G : (F.restrict (Spec.map (CommRingCat.ofHom
      (algebraMap R (Localization.Away f))))).GeneratingSections,
      Nonempty (G.I ≃ Fin r) := by
  classical
  let A : CommRingCat := CommRingCat.of (Localization.Away f)
  let φ : R ⟶ A := CommRingCat.ofHom (algebraMap R (Localization.Away f))
  let ψ : Spec A ⟶ Spec R := Spec.map φ
  let M : ModuleCat R := AlgebraicGeometry.moduleSpecΓFunctor.obj F
  let M' : ModuleCat A := (ModuleCat.extendScalars φ.hom).obj M
  let : Module (Localization.Away f) Γ(F.restrict ψ, ⊤) :=
    @instModuleCarrierCarrierObjOppositeOpensCarrierCarrierCommRingCatSpecAbPresheafOp
      A (F.restrict ψ) ⊤
  have : IsIso F.fromTildeΓ :=
    Scheme.Modules.isIso_fromTildeΓ_of_isQuasicoherent F
  let eFrom : (AlgebraicGeometry.tilde.functor R).obj M ≅ F :=
    @asIso _ _ _ _ F.fromTildeΓ
      (Scheme.Modules.isIso_fromTildeΓ_of_isQuasicoherent F)
  let ePull := (pullbackTildeIso R A φ).app M
  let eTilde : (AlgebraicGeometry.tilde.functor A).obj M' ≅
    F.restrict ψ :=
    ePull.symm ≪≫ (Scheme.Modules.pullback ψ).mapIso eFrom ≪≫
      ((Scheme.Modules.restrictFunctorIsoPullback ψ).app F).symm
  let eSectIso : ModuleCat.of A M' ≅
      ModuleCat.of A (Γ(F.restrict ψ, ⊤)) :=
    (AlgebraicGeometry.tilde.toTildeΓNatIso (R := A)).app M' ≪≫
      (AlgebraicGeometry.moduleSpecΓFunctor (R := A)).mapIso eTilde
  let eLoc : LocalizedModule.Away f Γ(F, ⊤) ≃ₗ[A]
      Γ(F.restrict ψ, ⊤) := by
    let S : Type u := Localization.Away f
    let e₁ : LocalizedModule.Away f Γ(F, ⊤) ≃ₗ[A]
        (S ⊗[R] (M : Type u)) :=
      LocalizedModule.equivTensorProduct (Submonoid.powers f) (M : Type u)
    let B : ModuleCat R :=
      (ModuleCat.restrictScalars φ.hom).obj (ModuleCat.of A A)
    let : Module A (B : Type u) := inferInstanceAs (Module A A)
    let : IsScalarTower R A (B : Type u) :=
      IsScalarTower.of_algebraMap_smul (R := R) (A := A) (M := (B : Type u))
        fun r x => by
          rw [ModuleCat.restrictScalars.smul_def]
          rfl
    let eB : A ≃ₗ[A] (B : Type u) := LinearEquiv.refl A A
    let eTensor : (A ⊗[R] (M : Type u)) ≃ₗ[A]
        TensorProduct R B (M : Type u) :=
      TensorProduct.AlgebraTensorModule.congr eB (LinearEquiv.refl R (M : Type u))
    let e₂ : TensorProduct R B (M : Type u) ≃ₗ[A]
        Γ(F.restrict ψ, ⊤) := eSectIso.toLinearEquiv
    exact e₁.trans (eTensor.trans e₂)
  let g' : Fin r → Γ(F.restrict ψ, ⊤) := fun i ↦ eLoc (g i)
  exact exists_generatingSections_of_span_sections (F := F.restrict ψ) r g'
    (span_range_comp_equiv_eq_top eLoc g hg)

private noncomputable def generatingSections_of_equivalence
    {C D : Type u} [Category.{u, u} C] [Category.{u, u} D]
    {J : GrothendieckTopology C} {K : GrothendieckTopology D}
    {R : Sheaf J RingCat.{u}} {S : Sheaf K RingCat.{u}}
    [HasWeakSheafify J AddCommGrpCat.{u}] [HasWeakSheafify K AddCommGrpCat.{u}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    [K.WEqualsLocallyBijective AddCommGrpCat.{u}]
    (E : SheafOfModules R ≌ SheafOfModules S)
    (hfree : ∀ I : Type u,
      SheafOfModules.free.{u} I ≅ E.inverse.obj (SheafOfModules.free.{u} I))
    {M : SheafOfModules R} (G : (E.functor.obj M).GeneratingSections) :
    M.GeneratingSections := by
  letI : E.inverse.IsLeftAdjoint := inferInstance
  letI : E.inverse.PreservesEpimorphisms := inferInstance
  let p : SheafOfModules.free G.I ⟶ M :=
    (hfree G.I).hom ≫ E.inverse.map G.π ≫ (E.unitIso.app M).inv
  haveI : Epi p := by
    dsimp [p]
    infer_instance
  exact (SheafOfModules.free.generatingSections (R := R) G.I).ofEpi p

/-- Restriction along an isomorphism of schemes is an equivalence of categories of modules. -/
private noncomputable def restrictEquivOfIso {X Y : Scheme.{u}} (e : Y ≅ X) :
    X.Modules ≌ Y.Modules :=
  CategoryTheory.Equivalence.mk
    (Scheme.Modules.restrictFunctor e.hom)
    (Scheme.Modules.restrictFunctor e.inv)
    (Scheme.Modules.restrictFunctorId.symm ≪≫
      (Scheme.Modules.restrictFunctorCongr e.inv_hom_id.symm) ≪≫
      Scheme.Modules.restrictFunctorComp e.inv e.hom)
    ((Scheme.Modules.restrictFunctorComp e.hom e.inv).symm ≪≫
      (Scheme.Modules.restrictFunctorCongr e.hom_inv_id) ≪≫
      Scheme.Modules.restrictFunctorId)

private noncomputable def affineOpenToSpecEquiv
    {X : Scheme.{u}} (U : X.affineOpens) :
    SheafOfModules (X.ringCatSheaf.over U.1) ≌
      (Spec (CommRingCat.of Γ(X, U.1))).Modules := by
  letI : IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
  exact (Scheme.Modules.overEquiv U.1).trans (restrictEquivOfIso
    (IsOpenImmersion.isoOfRangeEq U.2.fromSpec U.1.ι (U.2.range_fromSpec.trans U.1.range_ι.symm)))

private noncomputable def restrictFunctor_free_iso
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f] (I : Type u) :
    (Scheme.Modules.restrictFunctor f).obj (SheafOfModules.free.{u} I) ≅
      SheafOfModules.free.{u} I := by
  haveI : (Opens.map f.base).Final := by
    have : (Opens.map f.base).IsRightAdjoint :=
      ⟨_, ⟨f.isOpenEmbedding.isOpenMap.adjunction⟩⟩
    exact Functor.final_of_isRightAdjoint _
  letI : (SheafOfModules.pushforward (Scheme.Hom.toRingCatSheafHom f)).IsRightAdjoint :=
    (Scheme.Modules.pullbackPushforwardAdjunction f).isRightAdjoint
  exact (Scheme.Modules.restrictFunctorIsoPullback f).app
      (SheafOfModules.free.{u} I) ≪≫
    SheafOfModules.pullbackObjFreeIso (Scheme.Hom.toRingCatSheafHom f) I

private noncomputable def freeOverEquivIsoX
    (X : Scheme.{u}) (U : X.Opens) (I : Type u) :
    SheafOfModules.free (R := (U : Scheme.{u}).ringCatSheaf) I ≅
      (Scheme.Modules.overEquiv U).functor.obj
        (SheafOfModules.free (R := X.ringCatSheaf.over U) I) := by
  let F := (Scheme.Modules.overEquiv U).functor
  haveI : Limits.PreservesColimitsOfShape.{u, u} (Discrete I) F :=
    Functor.instPreservesColimitsOfShapeOfIsLeftAdjoint.{u, u, u, u + 1, u, u + 1} F
  exact @SheafOfModules.mapFreeIso _ _ _ _ _ _ _ _ _ _ _ _ F I this (Iso.refl _)

private noncomputable def overEquiv_free_inverse_iso
    {X : Scheme.{u}} (U : X.Opens) (I : Type u) :
    SheafOfModules.free (R := X.ringCatSheaf.over U) I ≅
      (Scheme.Modules.overEquiv U).inverse.obj
        (SheafOfModules.free (R := U.toScheme.ringCatSheaf) I) :=
  (Scheme.Modules.overEquiv U).unitIso.app (SheafOfModules.free (R := X.ringCatSheaf.over U) I) ≪≫
    (Scheme.Modules.overEquiv U).inverse.mapIso (freeOverEquivIsoX X U I).symm

private noncomputable def restrictGeneratingSections
    {X : Scheme.{u}} (F : X.Modules) (V W : X.Opens) (h : W ≤ V)
    (G : (F.over V).GeneratingSections) : (F.over W).GeneratingSections := by
  let i := X.homOfLE h
  let EV := Scheme.Modules.overEquiv V
  let EW := Scheme.Modules.overEquiv W
  let ηV := V.sheafOfModulesEquivOverUnit X.ringCatSheaf
  let hpresV : Limits.PreservesColimitsOfSize.{u, u, u, u, u + 1, u + 1} EV.functor :=
    Adjunction.leftAdjoint_preservesColimits EV.toAdjunction
  let σV := @SheafOfModules.GeneratingSections.map _ _ _ _ _ _ _ _ _ _ _ _ _
    G EV.functor hpresV ηV
  let isoV := (Scheme.Modules.overFunctorEquiv V).app F
  let σV' := σV.equivOfIso isoV
  let ηi := (Scheme.Modules.restrictUnitIso i).symm
  letI : (Scheme.Modules.restrictFunctor i).IsLeftAdjoint := inferInstance
  let hpresi : Limits.PreservesColimitsOfSize.{u, u, u, u, u + 1, u + 1}
      (Scheme.Modules.restrictFunctor i) :=
    Adjunction.leftAdjoint_preservesColimits
      (Adjunction.ofIsLeftAdjoint (Scheme.Modules.restrictFunctor i))
  let σW := @SheafOfModules.GeneratingSections.map _ _ _ _ _ _ _ _ _ _ _ _ _
    σV' (Scheme.Modules.restrictFunctor i) hpresi ηi
  have hi : i ≫ V.ι = W.ι := Scheme.homOfLE_ι X h
  let isoComp := (Scheme.Modules.restrictFunctorComp i V.ι).app F
  let isoToW : (Scheme.Modules.restrictFunctor i).obj
      ((Scheme.Modules.restrictFunctor V.ι).obj F) ≅
      (Scheme.Modules.overEquiv W).functor.obj (F.over W) :=
    isoComp.symm ≪≫ (Scheme.Modules.restrictFunctorCongr hi).app F ≪≫
      ((Scheme.Modules.overFunctorEquiv W).app F).symm
  let σW' := σW.equivOfIso isoToW
  exact generatingSections_of_equivalence EW (overEquiv_free_inverse_iso W) σW'

private noncomputable def affineOpen_equiv_free_inverse_iso
    {X : Scheme.{u}} (U : X.affineOpens) (I : Type u) :
    SheafOfModules.free (R := X.ringCatSheaf.over U.1) I ≅
      (affineOpenToSpecEquiv U).inverse.obj
        (SheafOfModules.free (R := (Spec (CommRingCat.of Γ(X, U.1))).ringCatSheaf) I) := by
  letI : IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
  let e := IsOpenImmersion.isoOfRangeEq U.2.fromSpec U.1.ι
    (U.2.range_fromSpec.trans U.1.range_ι.symm)
  exact overEquiv_free_inverse_iso U.1 I ≪≫
    (Scheme.Modules.overEquiv U.1).inverse.mapIso (restrictFunctor_free_iso e.inv I).symm

/-- The equivalence `affineOpenToSpecEquiv` sends `F.over U` to `F` restricted to `Spec Γ(X, U)`. -/
private noncomputable def affineOpenToSpecEquiv_obj_over_iso
    {X : Scheme.{u}} (F : X.Modules) (U : X.affineOpens) :
    (affineOpenToSpecEquiv U).functor.obj (F.over U.1) ≅
      haveI : IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
      F.restrict U.2.fromSpec :=
  letI : IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
  let e := IsOpenImmersion.isoOfRangeEq U.2.fromSpec U.1.ι
    (U.2.range_fromSpec.trans U.1.range_ι.symm)
  have hfac : e.hom ≫ U.1.ι = U.2.fromSpec :=
    IsOpenImmersion.isoOfRangeEq_hom_fac U.2.fromSpec U.1.ι _
  (Scheme.Modules.restrictFunctor e.hom).mapIso ((Scheme.Modules.overFunctorEquiv U.1).app F) ≪≫
    ((Scheme.Modules.restrictFunctorComp e.hom U.1.ι).app F).symm ≪≫
    (Scheme.Modules.restrictFunctorCongr hfac).app F

private theorem exists_generatingSections_over_affine_of_span_sections
    {X : Scheme.{u}} (F : X.Modules) [F.IsQuasicoherent]
    (U : X.affineOpens) (r : ℕ) (g : Fin r → Γ(F, U.1))
    (hg : Submodule.span (R := Γ(X, U.1)) (Set.range g) = ⊤) :
    ∃ G : (F.over U.1).GeneratingSections, Nonempty (G.I ≃ Fin r) := by
  let : IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
  let Fspec := F.restrict U.2.fromSpec
  have : Fspec.IsQuasicoherent := inferInstance
  let eSect := affineSectionsLinearEquiv F U.2
  let gspec : Fin r → Γ(Fspec, ⊤) := fun i ↦ eSect.symm (g i)
  obtain ⟨Gspec, hI⟩ := exists_generatingSections_of_span_sections Fspec r gspec
    (span_range_comp_equiv_eq_top eSect.symm g hg)
  let E := affineOpenToSpecEquiv U
  let htarget := affineOpenToSpecEquiv_obj_over_iso F U
  let G' := Gspec.equivOfIso htarget.symm
  let G := generatingSections_of_equivalence E
    (affineOpen_equiv_free_inverse_iso U) G'
  exact ⟨G, hI⟩

private noncomputable def generatingSections_on_range_of_openImmersion
    {X Y : Scheme.{u}} (i : Y ⟶ X) [IsOpenImmersion i]
    (F : X.Modules) (G : (F.restrict i).GeneratingSections) :
    (F.over i.opensRange).GeneratingSections := by
  let W := i.opensRange
  let e := IsOpenImmersion.isoOfRangeEq i W.ι (by simp [W])
  let E := restrictEquivOfIso e
  have hfac : e.hom ≫ W.ι = i :=
    IsOpenImmersion.isoOfRangeEq_hom_fac i W.ι (by simp [W])
  let htarget : E.functor.obj (F.restrict W.ι) ≅ F.restrict i :=
    ((Scheme.Modules.restrictFunctorComp e.hom W.ι).app F).symm ≪≫
      (Scheme.Modules.restrictFunctorCongr hfac).app F
  let G' := G.equivOfIso htarget.symm
  let G'' := generatingSections_of_equivalence E
    (fun I ↦ (restrictFunctor_free_iso e.inv I).symm) G'
  exact generatingSections_of_equivalence (Scheme.Modules.overEquiv W)
    (overEquiv_free_inverse_iso W)
    (G''.equivOfIso ((Scheme.Modules.overFunctorEquiv W).app F).symm)

private theorem map_top_iff_not_le_prime_of_localization
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
    (p : Ideal R) [p.IsPrime] [IsLocalization p.primeCompl S] (I : Ideal R) :
    Ideal.map (algebraMap R S) I = ⊤ ↔ ¬ I ≤ p := by
  have hdisj : Disjoint (p.primeCompl : Set R) (I : Set R) ↔ I ≤ p := by
    rw [Set.disjoint_left]
    exact ⟨fun h _ hxI ↦ Classical.byContradiction fun hxp ↦ h hxp hxI,
      fun h _ hxp hxI ↦ hxp (h hxI)⟩
  rw [show Ideal.map (algebraMap R S) I = ⊤ ↔
      ¬ Ideal.map (algebraMap R S) I ≠ ⊤ by simp,
    IsLocalization.map_algebraMap_ne_top_iff_disjoint (S := S) p.primeCompl I,
    hdisj]

private theorem fittingIdeal_stalk_eq_top_iff_not_le_on_affine
    {X : Scheme.{u}} (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) (s : X) (U : X.affineOpens) (hs : s ∈ U.1)
    [Module.Finite (Γ(X, U.1)) Γ(F, U.1)] :
    IdealSheafData.stalk (fittingIdeal F (r : ℤ)) s = ⊤ ↔
      ¬ _root_.fittingIdeal (R := Γ(X, U.1)) (M := Γ(F, U.1)) (r : ℤ) ≤
        (U.2.primeIdealOf ⟨s, hs⟩).asIdeal := by
  let p := (U.2.primeIdealOf ⟨s, hs⟩).asIdeal
  let : Algebra (Γ(X, U.1)) (X.presheaf.stalk s) :=
    (X.presheaf.germ U.1 s hs).hom.toAlgebra
  let : IsLocalization p.primeCompl (X.presheaf.stalk s) :=
    U.2.isLocalization_stalk ⟨s, hs⟩
  rw [IdealSheafData.stalk_eq_map_germ (I := fittingIdeal F (r : ℤ)) s U hs,
    fittingIdeal_ideal F (r : ℤ) U]
  have hmap : (X.presheaf.germ U.1 s hs).hom =
      algebraMap (Γ(X, U.1)) (X.presheaf.stalk s) := rfl
  rw [hmap]
  exact map_top_iff_not_le_prime_of_localization p _

private theorem span_sections_of_generatingSections_on_spec
    {R : CommRingCat.{u}} (F : (Spec R).Modules) [F.IsQuasicoherent]
    (G : F.GeneratingSections) :
    ∃ g : G.I → Γ(F, ⊤), Submodule.span (R := R) (Set.range g) = ⊤ := by
  classical
  let Q := SheafOfModules.isQuasicoherent (Spec R).ringCatSheaf
  let E := AlgebraicGeometry.tildeEquiv (R := R)
  let free := SheafOfModules.free (R := (Spec R).ringCatSheaf) G.I
  have hfree : Q free := inferInstance
  let freeQ : Q.FullSubcategory := ⟨free, hfree⟩
  let targetQ : Q.FullSubcategory := ⟨F, inferInstance⟩
  let πQ : freeQ ⟶ targetQ := ObjectProperty.homMk G.π
  have : Epi πQ := (ObjectProperty.ι Q).epi_of_epi_map G.epi
  let qCat := E.inverse.map πQ
  have : Epi qCat := inferInstance
  let e₁ := AlgebraicGeometry.tildeFinsupp (R := R) G.I
  let eSrc : ModuleCat.of R (G.I →₀ R) ≅
      AlgebraicGeometry.moduleSpecΓFunctor.obj free :=
    (AlgebraicGeometry.tilde.toTildeΓNatIso (R := R)).app
        (ModuleCat.of R (G.I →₀ R)) ≪≫
      (AlgebraicGeometry.moduleSpecΓFunctor (R := R)).mapIso e₁
  let q : (G.I →₀ R) →ₗ[R] Γ(F, ⊤) := qCat.hom.comp eSrc.toLinearEquiv.toLinearMap
  have hq : Function.Surjective q :=
    ((ModuleCat.epi_iff_surjective qCat).mp inferInstance).comp eSrc.toLinearEquiv.surjective
  let g : G.I → Γ(F, ⊤) := fun i ↦ q (Finsupp.single i 1)
  have hlin : Finsupp.linearCombination R g = q := by
    ext i
    simp [g]
  refine ⟨g, ?_⟩
  rwa [← Finsupp.range_linearCombination, hlin, LinearMap.range_eq_top]

private theorem exists_span_sections_of_generatingSections_over_affine
    {X : Scheme.{u}} (F : X.Modules) [F.IsQuasicoherent]
    (U : X.affineOpens) (r : ℕ) (G : (F.over U.1).GeneratingSections)
    (hI : Nonempty (G.I ≃ Fin r)) :
    ∃ g : Fin r → Γ(F, U.1),
      Submodule.span (R := Γ(X, U.1)) (Set.range g) = ⊤ := by
  let : IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
  let Fspec := F.restrict U.2.fromSpec
  have : Fspec.IsQuasicoherent := inferInstance
  let E := affineOpenToSpecEquiv U
  let htarget := affineOpenToSpecEquiv_obj_over_iso F U
  let hfree : ∀ I : Type u,
      SheafOfModules.free (R := (Spec (CommRingCat.of Γ(X, U.1))).ringCatSheaf) I ≅
        E.functor.obj
          (SheafOfModules.free (R := X.ringCatSheaf.over U.1) I) := fun I =>
    ((E.counitIso.app
      (SheafOfModules.free (R := (Spec (CommRingCat.of Γ(X, U.1))).ringCatSheaf) I)).symm ≪≫
      E.functor.mapIso (affineOpen_equiv_free_inverse_iso U I).symm)
  let G₁ := G.equivOfIso (E.unitIso.app (F.over U.1))
  let G₂ := generatingSections_of_equivalence E.symm hfree G₁
  let Gspec := G₂.equivOfIso htarget
  obtain ⟨g₀, hg₀⟩ := span_sections_of_generatingSections_on_spec Fspec Gspec
  let := Classical.decEq Gspec.I
  let e : Gspec.I ≃ Fin r := Classical.choice hI
  let eSect := affineSectionsLinearEquiv F U.2
  refine ⟨fun i => eSect (g₀ (e.symm i)), ?_⟩
  refine span_range_comp_equiv_eq_top eSect (fun i => g₀ (e.symm i)) ?_
  rw [show (Set.range fun i => g₀ (e.symm i)) = Set.range g₀ from
    e.symm.surjective.range_comp g₀, hg₀]

/-- A linear equivalence `M ≃ₗ[R] N` induces a linear equivalence of the localizations at `S`
over `Localization S`. -/
public noncomputable def localizedLinearEquiv
    {R : Type u} [CommRing R] {S : Submonoid R} {M N : Type u}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (e : M ≃ₗ[R] N) :
    LocalizedModule S M ≃ₗ[Localization S] LocalizedModule S N :=
  LinearEquiv.ofBijective (LocalizedModule.map S e.toLinearMap) ⟨
    LocalizedModule.map_injective S e.toLinearMap e.injective,
    LocalizedModule.map_surjective S e.toLinearMap e.surjective⟩

/-- A sheaf of modules is generated by `r` sections near `s` if this holds on
some open neighbourhood of `s`. -/
public def IsGeneratedByNear {X : Scheme.{u}} (F : X.Modules) (r : ℕ) (s : X) : Prop :=
  ∃ U : X.Opens, s ∈ U ∧
    ∃ g : (F.over U).GeneratingSections, Nonempty (g.I ≃ Fin r)

/-- A finite type quasicoherent module is generated by `r` sections near a
point if and only if the stalk of its `r`th Fitting ideal is the unit ideal. -/
@[stacks 0C3F]
public theorem isGeneratedByNear_iff_fittingIdeal_stalk_eq_top
    {X : Scheme.{u}} (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) (s : X) :
    IsGeneratedByNear F r s ↔ IdealSheafData.stalk (fittingIdeal F r) s = ⊤ := by
  constructor
  · rintro ⟨W, hsW, G, hI⟩
    obtain ⟨_, ⟨Uopen, hU, rfl⟩, hsU, hUW⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open hsW W.2
    let U : X.affineOpens := ⟨Uopen, by simpa [Scheme.affineOpens] using hU⟩
    obtain ⟨g, hg⟩ := exists_span_sections_of_generatingSections_over_affine F U r
      (restrictGeneratingSections F W U.1 hUW G) hI
    have : Module.Finite (Γ(X, U.1)) Γ(F, U.1) := moduleFinite_sections_on_affine F U.1 U.2
    let p := (U.2.primeIdealOf ⟨s, hsU⟩).asIdeal
    let loc : Γ(F, U.1) →ₗ[Γ(X, U.1)] LocalizedModule.AtPrime p Γ(F, U.1) :=
      LocalizedModule.mkLinearMap p.primeCompl Γ(F, U.1)
    have hloc : Submodule.span (Localization.AtPrime p)
        (Set.range fun i : Fin r => loc (g i)) = ⊤ := by
      have h := span_eq_top_of_isLocalizedModule
        (Rₛ := Localization.AtPrime p) (S := p.primeCompl) (f := loc) (v := Set.range g) hg
      rwa [← Set.range_comp] at h
    have hgen : ∃ q : Fin r → LocalizedModule.AtPrime p Γ(F, U.1),
        Submodule.span (Localization.AtPrime p) (Set.range q) = ⊤ := ⟨_, hloc⟩
    exact (fittingIdeal_stalk_eq_top_iff_not_le_on_affine F r s U hsU).mpr
      (((fittingIdeal_local_generation_tfae (M := Γ(F, U.1)) r p).out 3 1).mp hgen)
  · intro hstalk
    obtain ⟨_, ⟨Uopen, hU, rfl⟩, hsU, -⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ s) isOpen_univ
    let U : X.affineOpens := ⟨Uopen, by simpa [Scheme.affineOpens] using hU⟩
    have : Module.Finite (Γ(X, U.1)) Γ(F, U.1) := moduleFinite_sections_on_affine F U.1 U.2
    let p := (U.2.primeIdealOf ⟨s, hsU⟩).asIdeal
    have hnot : ¬ _root_.fittingIdeal (R := Γ(X, U.1)) (M := Γ(F, U.1)) (r : ℤ) ≤ p :=
      (fittingIdeal_stalk_eq_top_iff_not_le_on_affine F r s U hsU).mp hstalk
    obtain ⟨f, hfp, g, hg⟩ :=
      ((fittingIdeal_local_generation_tfae (M := Γ(F, U.1)) r p).out 1 4).mp hnot
    have : IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
    let Fspec := F.restrict U.2.fromSpec
    let eSect := affineSectionsLinearEquiv F U.2
    let eLoc := localizedLinearEquiv (S := Submonoid.powers f) eSect.symm
    let gloc : Fin r → LocalizedModule.Away f Γ(Fspec, ⊤) := fun i => eLoc (g i)
    obtain ⟨Gspec, hI⟩ := exists_generatingSections_of_localized_span Fspec f r gloc
      (span_range_comp_equiv_eq_top eLoc g hg)
    let A : CommRingCat := CommRingCat.of Γ(X, U.1)
    let φ : A ⟶ CommRingCat.of (Localization.Away f) :=
      CommRingCat.ofHom (algebraMap (Γ(X, U.1)) (Localization.Away f))
    let ψ : Spec (CommRingCat.of (Localization.Away f)) ⟶ Spec A := Spec.map φ
    let i := ψ ≫ U.2.fromSpec
    let G' := Gspec.equivOfIso
      ((Scheme.Modules.restrictFunctorComp ψ U.2.fromSpec).app F).symm
    let y : Spec A := U.2.primeIdealOf ⟨s, hsU⟩
    have hsRange : s ∈ i.opensRange := by
      rw [Scheme.Hom.opensRange_comp]
      exact ⟨y, by rwa [Scheme.Hom.opensRange_localizationAway],
        U.2.fromSpec_primeIdealOf ⟨s, hsU⟩⟩
    exact ⟨i.opensRange, hsRange, generatingSections_on_range_of_openImmersion i F G', hI⟩

end AlgebraicGeometry
