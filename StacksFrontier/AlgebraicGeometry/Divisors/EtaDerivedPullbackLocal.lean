module

public import StacksFrontier.AlgebraicGeometry.Divisors.EtaDerivedPullbackMap
public import StacksFrontier.AlgebraicGeometry.Modules.DerivedIsIsoOfOpenCover
public import StacksFrontier.AlgebraicGeometry.Divisors.EtaDerivedEmptySupport
public import StacksFrontier.Topology.Sheaves.Cohomology.KFlat.PullbackFromTheStalkCriterion

/-!
# The comparison of décalage with derived pullback is local on the target

Let `h : Y ⟶ X` be a morphism of schemes, `D ⊆ X` an effective Cartier divisor with ideal sheaf
`I = ℐ_D` whose pullback `h^{-1}D` is defined, and `F^•` a complex of flat `𝒪_X`-modules. The
comparison `Lh^*[η_I F^•] ⟶ [η_{h^*I}(h^*F^•)]` of
`Stacks.IdealTorsion.Eta.derivedPullbackEtaCore` is invertible as soon as `X` is covered by open
immersions `j : U ⟶ X` such that for every morphism `h' : V ⟶ U` along which `j^{-1}D` pulls
back to an effective Cartier divisor the comparison along `h'` at `j^*F^•` is invertible.

Invertibility in `D(𝒪_Y)` is local on `Y`
(`Stacks.Cohomology.DerivedOpenImmersion.isIso_of_isIso_derivedPullback_ι`). On the member
`V = h^{-1}(j(U))` of the induced cover, the cocycle condition
`Stacks.IdealTorsion.Eta.derivedPullbackEtaCore_cocycle` identifies the restriction of the
comparison along `h` with the comparison along `V ⟶ Y ⟶ X`, because the comparison along the
flat open immersion `V ⟶ Y` is invertible; and the latter, written as `V ⟶ U ⟶ X`, with the
comparison along `V ⟶ U` at `j^*F^•`, because the comparison along the flat `j` is invertible.

Flatness of the terms of `F^•` is what makes every torsion-freeness hypothesis automatic: the
pullback of a flat module is flat, and a flat module has no torsion for an invertible ideal
sheaf contained in the structure sheaf.

## Main results

* `Stacks.Divisors.Eta.isIdealTorsionFree_of_isFlat_of_mono`: a flat module has no torsion for an
  invertible ideal sheaf contained in the structure sheaf of a scheme.
* `Stacks.Divisors.Eta.mono_pullbackIdealIncl_pullbackIdealIncl`: the twice pulled-back inclusion
  of `ℐ_D` is a monomorphism when the pullback of `j^{-1}D` is defined.
* `Stacks.Divisors.Eta.isIso_derivedPullbackEtaCore_of_isOpenCover`: the locality statement.
-/

@[expose] public noncomputable section

attribute [local instance_reducible] TopCat.Sheaf CategoryTheory.sheafCompose
  AlgebraicGeometry.SheafedSpace.sheaf Stacks.SheafOfModules.TensorSheafification.structureSheaf
  Stacks.SheafOfModules.Tensor.ringSheaf

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

open Stacks.RingedSpace (pullbackFunctor)
open Stacks.Cohomology.DerivedAdjunctionOnRingedSpaces (derivedPullback)

attribute [local instance 10000] HasDerivedCategory.standard

universe u

namespace Stacks.Divisors.Eta

/-- **A flat module has no torsion for an invertible ideal sheaf of a scheme.** The ideal is
locally generated by a nonzerodivisor (Stacks 0GT3) and multiplication by a nonzerodivisor is
injective on a flat module. -/
theorem isIdealTorsionFree_of_isFlat_of_mono {Z : Scheme.{u}}
    (J : SheafOfModules.{u} (structureSheaf Z.toRingedSpace.sheaf))
    (κ : J ⟶ SheafOfModules.unit (structureSheaf Z.toRingedSpace.sheaf)) [Mono κ]
    [hJ : Stacks.SheafOfModules.IsInvertible Z.toRingedSpace.sheaf.obj
      (structureSheaf Z.toRingedSpace.sheaf).property J]
    (M : SheafOfModules.{u} (structureSheaf Z.toRingedSpace.sheaf))
    (hM : AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := Z.toRingedSpace.sheaf) M) :
    Stacks.IdealTorsion.IsIdealTorsionFree Z.toRingedSpace κ M :=
  Stacks.IdealTorsion.isIdealTorsionFree_of_isFlat Z.toRingedSpace _ _
    (Stacks.IdealTorsion.isLocallyGeneratedByRegular_of_isInvertible Z.toRingedSpace _ hJ) _ hM

/-- **The twice pulled-back inclusion of the ideal sheaf of a divisor is a monomorphism** when
`j` is flat and the pullback of `j^{-1}D` along `h'` is defined. The inclusion `j^*ℐ_D ⟶ 𝒪_U`
is `ℐ_{j^{-1}D} ⟶ 𝒪_U` after the identification `j^*ℐ_D ≅ ℐ_{j^{-1}D}`, so its pullback along
`h'` is the pullback of an isomorphism followed by `h'^*ℐ_{j^{-1}D} ⟶ 𝒪_V`. -/
theorem mono_pullbackIdealIncl_pullbackIdealIncl {X U V : Scheme.{u}} (D : X.IdealSheafData)
    [Stacks.Divisors.IsEffectiveCartierDivisor D] (j : U ⟶ X) [Flat j] (h' : V ⟶ U)
    (hD' : Stacks.Divisors.IsPullbackDefined h' (D.comap j)) :
    Mono (Stacks.IdealTorsion.Eta.pullbackIdealIncl h'.toLRSHom.toShHom
      ((pullbackFunctor j.toLRSHom.toShHom).obj (idealSheaf D))
      (Stacks.IdealTorsion.Eta.pullbackIdealIncl j.toLRSHom.toShHom (idealSheaf D)
        (idealSheafι D))) := by
  have hj : Stacks.Divisors.IsPullbackDefined j D :=
    Stacks.Divisors.isPullbackDefined_of_flat j D inferInstance
  have : Stacks.Divisors.IsEffectiveCartierDivisor (D.comap j) := hj
  have hm := mono_pullbackIdealIncl_of_isPullbackDefined h' (D.comap j) hD'
  rw [← Stacks.Divisors.pullbackIdealSheafComapIso_hom_comp_idealSheafι j D hj]
  unfold Stacks.IdealTorsion.Eta.pullbackIdealIncl at hm ⊢
  rw [Functor.map_comp, Category.assoc]
  exact mono_comp _ _

/-- The pullback of a flat module along a morphism of schemes has no torsion for the pulled-back
ideal, when the pulled-back inclusion is a monomorphism. -/
theorem isIdealTorsionFree_pullbackFunctor_of_isFlat {Z W : Scheme.{u}} (g : Z ⟶ W)
    (J : SheafOfModules.{u} (structureSheaf W.toRingedSpace.sheaf))
    (κ : J ⟶ SheafOfModules.unit (structureSheaf W.toRingedSpace.sheaf))
    [Stacks.SheafOfModules.IsInvertible W.toRingedSpace.sheaf.obj
      (structureSheaf W.toRingedSpace.sheaf).property J]
    [Mono (Stacks.IdealTorsion.Eta.pullbackIdealIncl g.toLRSHom.toShHom J κ)]
    (M : SheafOfModules.{u} (structureSheaf W.toRingedSpace.sheaf))
    (hM : AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := W.toRingedSpace.sheaf) M) :
    Stacks.IdealTorsion.IsIdealTorsionFree Z.toRingedSpace
      (Stacks.IdealTorsion.Eta.pullbackIdealIncl g.toLRSHom.toShHom J κ)
      ((pullbackFunctor g.toLRSHom.toShHom).obj M) :=
  isIdealTorsionFree_of_isFlat_of_mono _ _ _
    (Stacks.SheafOfModules.modulePullback_isFlat g.toLRSHom.toShHom M hM)

/-- If `D` pulls back to an effective Cartier divisor along `h`, it does so along `g ≫ h` for a
flat `g`. -/
private theorem isPullbackDefined_comp_of_flat {X Y Z : Scheme.{u}} (g : Z ⟶ Y) [Flat g]
    (h : Y ⟶ X) (D : X.IdealSheafData) (hD : Stacks.Divisors.IsPullbackDefined h D) :
    Stacks.Divisors.IsPullbackDefined (g ≫ h) D := by
  rw [Stacks.Divisors.IsPullbackDefined, Scheme.IdealSheafData.comap_comp]
  exact Stacks.Divisors.isPullbackDefined_of_flat _ _ hD

/-- **The comparison is invertible when it is so locally on the target.** Let `h : Y ⟶ X` be a
morphism of schemes along which the effective Cartier divisor `D` pulls back to an effective
Cartier divisor, and let `F^•` be a complex of flat `𝒪_X`-modules. Suppose every point of `X`
lies in the image of an open immersion `j : U ⟶ X` such that, for every morphism `h' : V ⟶ U`
along which `j^{-1}D` pulls back to an effective Cartier divisor, the comparison along `h'` at
`j^*F^•` is invertible. Then the comparison along `h` at `F^•` is invertible. -/
theorem isIso_derivedPullbackEtaCore_of_isOpenCover {X Y : Scheme.{u}} (h : Y ⟶ X)
    (D : X.IdealSheafData) [Stacks.Divisors.IsEffectiveCartierDivisor D]
    (hD : Stacks.Divisors.IsPullbackDefined h D)
    (F : CochainComplex (SheafOfModules.{u} (structureSheaf X.toRingedSpace.sheaf)) ℤ)
    (hfl : ∀ n : ℤ,
      AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := X.toRingedSpace.sheaf) (F.X n))
    (hU : ∀ x : X, ∃ (U : Scheme.{u}) (j : U ⟶ X) (_ : IsOpenImmersion j),
      x ∈ Set.range j.base ∧ ∀ (V : Scheme.{u}) (h' : V ⟶ U)
        (hD' : Stacks.Divisors.IsPullbackDefined h' (D.comap j)),
        haveI := Stacks.IdealTorsion.Eta.mono_pullbackIdealIncl j.toLRSHom.toShHom
          (fun x => AlgebraicGeometry.Flat.stalkMap j x) (idealSheaf D) (idealSheafι D)
        haveI := mono_pullbackIdealIncl_pullbackIdealIncl D j h' hD'
        IsIso (Stacks.IdealTorsion.Eta.derivedPullbackEtaCore h'.toLRSHom.toShHom
          ((pullbackFunctor j.toLRSHom.toShHom).obj (idealSheaf D))
          (Stacks.IdealTorsion.Eta.pullbackIdealIncl j.toLRSHom.toShHom (idealSheaf D)
            (idealSheafι D))
          (Stacks.IdealTorsion.Eta.pullbackComplex j.toLRSHom.toShHom F)
          (fun n => isIdealTorsionFree_pullbackFunctor_of_isFlat j _ _ _ (hfl n))
          (fun n => isIdealTorsionFree_pullbackFunctor_of_isFlat h' _ _
            ((pullbackFunctor j.toLRSHom.toShHom).obj (F.X n))
            (Stacks.SheafOfModules.modulePullback_isFlat j.toLRSHom.toShHom _ (hfl n))))) :
    haveI := mono_pullbackIdealIncl_of_isPullbackDefined h D hD
    IsIso (Stacks.IdealTorsion.Eta.derivedPullbackEtaCore h.toLRSHom.toShHom (idealSheaf D)
      (idealSheafι D) F (fun n => isIdealTorsionFree_of_isFlat_of_mono _ _ _ (hfl n))
      (fun n => isIdealTorsionFree_pullbackFunctor_of_isFlat h _ _ _ (hfl n))) := by
  have := mono_pullbackIdealIncl_of_isPullbackDefined h D hD
  choose U j hj hxj hloc using hU
  let V : Y → Y.Opens := fun y => h ⁻¹ᵁ (j (h.base y)).opensRange
  refine Stacks.Cohomology.DerivedOpenImmersion.isIso_of_isIso_derivedPullback_ι _ V
    (TopologicalSpace.IsOpenCover.mk (eq_top_iff.2 fun y _ =>
      TopologicalSpace.Opens.mem_iSup.2 ⟨y, hxj (h.base y)⟩)) fun y => ?_
  have : IsOpenImmersion (j (h.base y)) := hj _
  have hflV : AlgebraicGeometry.IsFlat (V y).ι.toLRSHom.toShHom :=
    AlgebraicGeometry.Flat.stalkMap (V y).ι
  have hflj : AlgebraicGeometry.IsFlat (j (h.base y)).toLRSHom.toShHom :=
    AlgebraicGeometry.Flat.stalkMap (j (h.base y))
  have hVh := isPullbackDefined_comp_of_flat (V y).ι h D hD
  have hm1 : Mono (Stacks.IdealTorsion.Eta.pullbackIdealIncl
      ((V y).ι.toLRSHom.toShHom ≫ h.toLRSHom.toShHom) (idealSheaf D) (idealSheafι D)) :=
    mono_pullbackIdealIncl_of_isPullbackDefined ((V y).ι ≫ h) D hVh
  have hm2 : Mono (Stacks.IdealTorsion.Eta.pullbackIdealIncl (V y).ι.toLRSHom.toShHom
      ((pullbackFunctor h.toLRSHom.toShHom).obj (idealSheaf D))
      (Stacks.IdealTorsion.Eta.pullbackIdealIncl h.toLRSHom.toShHom (idealSheaf D)
        (idealSheafι D))) :=
    Stacks.IdealTorsion.Eta.mono_pullbackIdealIncl _ hflV _ _
  have hlift : Set.range ((V y).ι ≫ h).base ⊆ Set.range (j (h.base y)).base := by
    rintro _ ⟨z, rfl⟩
    exact z.2
  let h'' := IsOpenImmersion.lift (j (h.base y)) ((V y).ι ≫ h) hlift
  have e : (V y).ι.toLRSHom.toShHom ≫ h.toLRSHom.toShHom =
      h''.toLRSHom.toShHom ≫ (j (h.base y)).toLRSHom.toShHom :=
    congrArg (fun t : (V y).toScheme ⟶ X => t.toLRSHom.toShHom)
      (IsOpenImmersion.lift_fac (j (h.base y)) ((V y).ι ≫ h) hlift).symm
  have hD'' : Stacks.Divisors.IsPullbackDefined h'' (D.comap (j (h.base y))) := by
    rwa [Stacks.Divisors.IsPullbackDefined, ← Scheme.IdealSheafData.comap_comp,
      IsOpenImmersion.lift_fac]
  have hm3 : Mono (Stacks.IdealTorsion.Eta.pullbackIdealIncl (j (h.base y)).toLRSHom.toShHom
      (idealSheaf D) (idealSheafι D)) :=
    Stacks.IdealTorsion.Eta.mono_pullbackIdealIncl _ hflj _ _
  have hm4 := mono_pullbackIdealIncl_pullbackIdealIncl D (j (h.base y)) h'' hD''
  have hm5 : Mono (Stacks.IdealTorsion.Eta.pullbackIdealIncl
      (h''.toLRSHom.toShHom ≫ (j (h.base y)).toLRSHom.toShHom) (idealSheaf D) (idealSheafι D)) :=
    e ▸ hm1
  have hF := fun n => isIdealTorsionFree_of_isFlat_of_mono (idealSheaf D) (idealSheafι D) _ (hfl n)
  refine (Stacks.IdealTorsion.Eta.isIso_derivedPullbackEtaCore_comp_iff_left
    (V y).ι.toLRSHom.toShHom h.toLRSHom.toShHom (idealSheaf D) (idealSheafι D) F hF
    (fun n => isIdealTorsionFree_pullbackFunctor_of_isFlat h _ _ _ (hfl n))
    (fun n => isIdealTorsionFree_of_isFlat_of_mono _ _ _
      (Stacks.SheafOfModules.modulePullback_isFlat _ _ (hfl n)))
    (fun n => isIdealTorsionFree_pullbackFunctor_of_isFlat (V y).ι _ _
      ((pullbackFunctor h.toLRSHom.toShHom).obj (F.X n))
      (Stacks.SheafOfModules.modulePullback_isFlat h.toLRSHom.toShHom _ (hfl n)))
    (Stacks.IdealTorsion.Eta.isIso_derivedPullbackEtaCore_of_isFlat _ _ _ hflV _ _ _)).2 ?_
  rw [Stacks.IdealTorsion.Eta.isIso_derivedPullbackEtaCore_congr _ _ _ e F hF _
    (fun n => isIdealTorsionFree_of_isFlat_of_mono _ _ _
      (Stacks.SheafOfModules.modulePullback_isFlat _ _ (hfl n)))]
  refine (Stacks.IdealTorsion.Eta.isIso_derivedPullbackEtaCore_comp_iff_right
    h''.toLRSHom.toShHom (j (h.base y)).toLRSHom.toShHom (idealSheaf D) (idealSheafι D) F hF
    (fun n => isIdealTorsionFree_pullbackFunctor_of_isFlat (j (h.base y)) _ _ _ (hfl n))
    (fun n => isIdealTorsionFree_of_isFlat_of_mono _ _ _
      (Stacks.SheafOfModules.modulePullback_isFlat _ _ (hfl n)))
    (fun n => isIdealTorsionFree_pullbackFunctor_of_isFlat h'' _ _
      ((pullbackFunctor (j (h.base y)).toLRSHom.toShHom).obj (F.X n))
      (Stacks.SheafOfModules.modulePullback_isFlat (j (h.base y)).toLRSHom.toShHom _ (hfl n)))
    (Stacks.IdealTorsion.Eta.isIso_derivedPullbackEtaCore_of_isFlat _ _ _ hflj _ _ _)).1 ?_
  exact hloc (h.base y) (V y) h'' hD''

/-- **Away from the divisor the comparison is invertible.** Let `j : U ⟶ X` be flat with
`j^{-1}D = ∅`, and let `F^•` be a K-flat complex of flat `𝒪_X`-modules. For every morphism
`h' : V ⟶ U` along which `j^{-1}D` pulls back to an effective Cartier divisor, the comparison along
`h'` at `j^*F^•` is invertible: the inclusion `j^*ℐ_D ⟶ 𝒪_U` is invertible, being
`ℐ_{j^{-1}D} ⟶ 𝒪_U` for a divisor with empty support, so
`Stacks.IdealTorsion.Eta.isIso_derivedPullbackEtaCore_of_isIso` applies to the K-flat complex
`j^*F^•`. -/
theorem isIso_derivedPullbackEtaCore_of_supportSet_comap_eq_empty {X U V : Scheme.{u}}
    (D : X.IdealSheafData) [Stacks.Divisors.IsEffectiveCartierDivisor D] (j : U ⟶ X) [Flat j]
    (hj : (D.comap j).supportSet = ∅)
    (F : CochainComplex (SheafOfModules.{u} (structureSheaf X.toRingedSpace.sheaf)) ℤ)
    (hfl : ∀ n : ℤ,
      AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := X.toRingedSpace.sheaf) (F.X n))
    (hFk : Stacks.Cohomology.KFlatDerivedPullback.KFlatComplex X.toRingedSpace F)
    (h' : V ⟶ U) (hD' : Stacks.Divisors.IsPullbackDefined h' (D.comap j)) :
    haveI := Stacks.IdealTorsion.Eta.mono_pullbackIdealIncl j.toLRSHom.toShHom
      (fun x => AlgebraicGeometry.Flat.stalkMap j x) (idealSheaf D) (idealSheafι D)
    haveI := mono_pullbackIdealIncl_pullbackIdealIncl D j h' hD'
    IsIso (Stacks.IdealTorsion.Eta.derivedPullbackEtaCore h'.toLRSHom.toShHom
      ((pullbackFunctor j.toLRSHom.toShHom).obj (idealSheaf D))
      (Stacks.IdealTorsion.Eta.pullbackIdealIncl j.toLRSHom.toShHom (idealSheaf D)
        (idealSheafι D))
      (Stacks.IdealTorsion.Eta.pullbackComplex j.toLRSHom.toShHom F)
      (fun n => isIdealTorsionFree_pullbackFunctor_of_isFlat j _ _ _ (hfl n))
      (fun n => isIdealTorsionFree_pullbackFunctor_of_isFlat h' _ _
        ((pullbackFunctor j.toLRSHom.toShHom).obj (F.X n))
        (Stacks.SheafOfModules.modulePullback_isFlat j.toLRSHom.toShHom _ (hfl n)))) := by
  have := mono_pullbackIdealIncl_pullbackIdealIncl D j h' hD'
  have hjD : Stacks.Divisors.IsPullbackDefined j D :=
    Stacks.Divisors.isPullbackDefined_of_flat j D inferInstance
  have : Stacks.Divisors.IsEffectiveCartierDivisor (D.comap j) := hjD
  have := isIso_idealSheafι_of_supportSet_eq_empty (D.comap j) hj
  have : IsIso (Stacks.IdealTorsion.Eta.pullbackIdealIncl j.toLRSHom.toShHom (idealSheaf D)
      (idealSheafι D)) := by
    rw [← Stacks.Divisors.pullbackIdealSheafComapIso_hom_comp_idealSheafι j D hjD]
    infer_instance
  exact Stacks.IdealTorsion.Eta.isIso_derivedPullbackEtaCore_of_isIso _ _ _ _
    (Stacks.SheafOfModules.KFlatPullback.kFlat_pullback_unconditional j.toLRSHom.toShHom F hFk)
    _ _

/-- **The comparison at a pulled-back complex is local on the source.** Let `j : U ⟶ X` be flat,
`h' : V ⟶ U` a morphism along which `j^{-1}D` pulls back to an effective Cartier divisor, and
`F^•` a complex of flat `𝒪_X`-modules. If every point of `V` lies in an open `W ⊆ V` such that the
comparison along `W ⟶ V ⟶ U` at `j^*F^•` is invertible, then so is the comparison along `h'`.
The comparison along the flat open immersion `W ⟶ V` is invertible, so the cocycle condition
identifies the restriction to `W` of the comparison along `h'` with the comparison along the
composite. -/
theorem isIso_derivedPullbackEtaCore_of_isOpenCover_source {X U V : Scheme.{u}}
    (D : X.IdealSheafData) [Stacks.Divisors.IsEffectiveCartierDivisor D] (j : U ⟶ X) [Flat j]
    (F : CochainComplex (SheafOfModules.{u} (structureSheaf X.toRingedSpace.sheaf)) ℤ)
    (hfl : ∀ n : ℤ,
      AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := X.toRingedSpace.sheaf) (F.X n))
    (h' : V ⟶ U) (hD' : Stacks.Divisors.IsPullbackDefined h' (D.comap j))
    (hW : ∀ v : V, ∃ W : V.Opens, v ∈ W ∧
      ∀ hW' : Stacks.Divisors.IsPullbackDefined (W.ι ≫ h') (D.comap j),
        haveI := Stacks.IdealTorsion.Eta.mono_pullbackIdealIncl j.toLRSHom.toShHom
          (fun x => AlgebraicGeometry.Flat.stalkMap j x) (idealSheaf D) (idealSheafι D)
        haveI := mono_pullbackIdealIncl_pullbackIdealIncl D j (W.ι ≫ h') hW'
        IsIso (Stacks.IdealTorsion.Eta.derivedPullbackEtaCore (W.ι ≫ h').toLRSHom.toShHom
          ((pullbackFunctor j.toLRSHom.toShHom).obj (idealSheaf D))
          (Stacks.IdealTorsion.Eta.pullbackIdealIncl j.toLRSHom.toShHom (idealSheaf D)
            (idealSheafι D))
          (Stacks.IdealTorsion.Eta.pullbackComplex j.toLRSHom.toShHom F)
          (fun n => isIdealTorsionFree_pullbackFunctor_of_isFlat j _ _ _ (hfl n))
          (fun n => isIdealTorsionFree_pullbackFunctor_of_isFlat (W.ι ≫ h') _ _
            ((pullbackFunctor j.toLRSHom.toShHom).obj (F.X n))
            (Stacks.SheafOfModules.modulePullback_isFlat j.toLRSHom.toShHom _ (hfl n))))) :
    haveI := Stacks.IdealTorsion.Eta.mono_pullbackIdealIncl j.toLRSHom.toShHom
      (fun x => AlgebraicGeometry.Flat.stalkMap j x) (idealSheaf D) (idealSheafι D)
    haveI := mono_pullbackIdealIncl_pullbackIdealIncl D j h' hD'
    IsIso (Stacks.IdealTorsion.Eta.derivedPullbackEtaCore h'.toLRSHom.toShHom
      ((pullbackFunctor j.toLRSHom.toShHom).obj (idealSheaf D))
      (Stacks.IdealTorsion.Eta.pullbackIdealIncl j.toLRSHom.toShHom (idealSheaf D)
        (idealSheafι D))
      (Stacks.IdealTorsion.Eta.pullbackComplex j.toLRSHom.toShHom F)
      (fun n => isIdealTorsionFree_pullbackFunctor_of_isFlat j _ _ _ (hfl n))
      (fun n => isIdealTorsionFree_pullbackFunctor_of_isFlat h' _ _
        ((pullbackFunctor j.toLRSHom.toShHom).obj (F.X n))
        (Stacks.SheafOfModules.modulePullback_isFlat j.toLRSHom.toShHom _ (hfl n)))) := by
  have := Stacks.IdealTorsion.Eta.mono_pullbackIdealIncl j.toLRSHom.toShHom
    (fun x => AlgebraicGeometry.Flat.stalkMap j x) (idealSheaf D) (idealSheafι D)
  have := mono_pullbackIdealIncl_pullbackIdealIncl D j h' hD'
  choose W hvW hloc using hW
  refine Stacks.Cohomology.DerivedOpenImmersion.isIso_of_isIso_derivedPullback_ι _ W
    (TopologicalSpace.IsOpenCover.mk (eq_top_iff.2 fun v _ =>
      TopologicalSpace.Opens.mem_iSup.2 ⟨v, hvW v⟩)) fun v => ?_
  have hflW : AlgebraicGeometry.IsFlat (W v).ι.toLRSHom.toShHom :=
    AlgebraicGeometry.Flat.stalkMap (W v).ι
  have hWD := isPullbackDefined_comp_of_flat (W v).ι h' (D.comap j) hD'
  have hm0 := mono_pullbackIdealIncl_pullbackIdealIncl D j ((W v).ι ≫ h') hWD
  have e : ((W v).ι ≫ h').toLRSHom.toShHom =
      (W v).ι.toLRSHom.toShHom ≫ h'.toLRSHom.toShHom := rfl
