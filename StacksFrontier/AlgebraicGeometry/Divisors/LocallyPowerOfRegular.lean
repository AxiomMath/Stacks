module

public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.Blowup.CartierCentre

/-!
# Ideals that are locally a power of a fixed nonzerodivisor

Let `X = Spec A` be an affine scheme and `J ⊆ A` an ideal.  Suppose there is a nonzerodivisor
`f ∈ A` such that every prime `p` of `A` admits `g ∉ p` with `J A_g = (f^n) A_g` for some
`n`.  Then the closed subscheme cut out by `J` is an effective Cartier divisor, and
consequently blowing `X` up along `J` does not change `X`.

## Main results

* `Stacks.Divisors.isEffectiveCartierDivisor_ofIdealTop_of_forall_exists_away`: such an ideal
  defines an effective Cartier divisor.
* `Stacks.Divisors.isIso_blowUpToBase_ofIdealTop_of_forall_exists_away`: the blowup of such an
  ideal has an isomorphism as its structure morphism.

## Implementation notes

The hypothesis is phrased with the model localization `Localization.Away g`, while the
sections of the structure sheaf over the basic open `D(g) ⊆ X` form another localization of
`A` away from `g` (`AlgebraicGeometry.IsAffineOpen.isLocalization_basicOpen`).  The two are
identified by `IsLocalization.algEquiv`, which is an `A`-algebra equivalence, so the ideal
generated by the image of `J` is carried to the ideal generated by the image of `J` and the
distinguished generator `f^n` to the corresponding power of the image of `f`.

## References

* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
* [Stacks Project, Tag 0807](https://stacks.math.columbia.edu/tag/0807)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite

universe u

namespace Stacks.Divisors

/-- On a basic open `D(g)` of an affine scheme, the ideal generated by the image of `J` is
computed by any other localization away from `g`: if `J` becomes `(f^n)` in
`Localization.Away g`, it becomes `(f|_{D(g)}^n)` in `Γ(X, D(g))`. -/
private theorem map_algebraMap_basicOpen_eq_span_pow {X : Scheme.{u}} [IsAffine X]
    (J : Ideal Γ(X, ⊤)) (f g : Γ(X, ⊤)) (n : ℕ)
    (hn : J.map (algebraMap Γ(X, ⊤) (Localization.Away g))
      = Ideal.span {algebraMap Γ(X, ⊤) (Localization.Away g) f ^ n}) :
    J.map (algebraMap Γ(X, ⊤) Γ(X, X.basicOpen g))
      = Ideal.span {algebraMap Γ(X, ⊤) Γ(X, X.basicOpen g) f ^ n} := by
  let _ : IsLocalization.Away g Γ(X, X.basicOpen g) :=
    (isAffineOpen_top X).isLocalization_basicOpen g
  let E := IsLocalization.algEquiv (Submonoid.powers g) (Localization.Away g)
    Γ(X, X.basicOpen g)
  have hmap : J.map (algebraMap Γ(X, ⊤) Γ(X, X.basicOpen g))
      = (J.map (algebraMap Γ(X, ⊤) (Localization.Away g))).map E.toRingHom := by
    rw [Ideal.map_map]
    congr 1
    ext a
    exact (E.commutes a).symm
  have hEf : E.toRingHom (algebraMap Γ(X, ⊤) (Localization.Away g) f)
      = algebraMap Γ(X, ⊤) Γ(X, X.basicOpen g) f := E.commutes f
  rw [hmap, hn, Ideal.map_span, Set.image_singleton, map_pow, hEf]

/-- The image of a nonzerodivisor in a localization at a submonoid of the ring is again a
nonzerodivisor, hence so is each of its powers. -/
private theorem isRegular_pow_algebraMap {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    (M : Submonoid A) [IsLocalization M B] {f : A} (hf : IsRegular f) (n : ℕ) :
    IsRegular (algebraMap A B f ^ n) := by
  have hmem : algebraMap A B f ∈ nonZeroDivisors B :=
    IsLocalization.nonZeroDivisors_le_comap M B hf.mem_nonZeroDivisors
  exact isRegular_iff_mem_nonZeroDivisors.mpr (pow_mem hmem n)

/-- An ideal of the global sections of an affine scheme that is, locally on the spectrum,
generated by a power of a fixed nonzerodivisor defines an effective Cartier divisor. -/
theorem isEffectiveCartierDivisor_ofIdealTop_of_forall_exists_away
    {X : Scheme.{u}} [IsAffine X] (J : Ideal Γ(X, ⊤)) (f : Γ(X, ⊤)) (hf : IsRegular f)
    (h : ∀ p : PrimeSpectrum Γ(X, ⊤), ∃ g ∈ p.asIdeal.primeCompl, ∃ n : ℕ,
      J.map (algebraMap Γ(X, ⊤) (Localization.Away g))
        = Ideal.span {algebraMap Γ(X, ⊤) (Localization.Away g) f ^ n}) :
    IsEffectiveCartierDivisor (Scheme.IdealSheafData.ofIdealTop J) := by
  refine isEffectiveCartierDivisor_of_forall_exists_affineOpen _ fun x => ?_
  have hX := isAffineOpen_top X
  obtain ⟨g, hg, n, hn⟩ := h (hX.primeIdealOf ⟨x, TopologicalSpace.Opens.mem_top x⟩)
  let _ : IsLocalization.Away g Γ(X, X.basicOpen g) := hX.isLocalization_basicOpen g
  refine ⟨X.basicOpen g, hX.basicOpen g, ?_,
    algebraMap Γ(X, ⊤) Γ(X, X.basicOpen g) f ^ n,
    isRegular_pow_algebraMap (Submonoid.powers g) hf n, ?_⟩
  · have hg' : hX.primeIdealOf ⟨x, TopologicalSpace.Opens.mem_top x⟩ ∈
        PrimeSpectrum.basicOpen g := hg
    rw [← hX.fromSpec_preimage_basicOpen] at hg'
    change hX.fromSpec (hX.primeIdealOf ⟨x, TopologicalSpace.Opens.mem_top x⟩) ∈
      X.basicOpen g at hg'
    simpa [hX.fromSpec_primeIdealOf] using hg'
  · rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    exact map_algebraMap_basicOpen_eq_span_pow J f g n hn

/-- Blowing up an affine scheme along an ideal that is, locally on the spectrum, generated by a
power of a fixed nonzerodivisor does not change the scheme: the blowup morphism is an
isomorphism. -/
theorem isIso_blowUpToBase_ofIdealTop_of_forall_exists_away
    {X : Scheme.{u}} [IsAffine X] (J : Ideal Γ(X, ⊤)) (f : Γ(X, ⊤)) (hf : IsRegular f)
    (h : ∀ p : PrimeSpectrum Γ(X, ⊤), ∃ g ∈ p.asIdeal.primeCompl, ∃ n : ℕ,
      J.map (algebraMap Γ(X, ⊤) (Localization.Away g))
        = Ideal.span {algebraMap Γ(X, ⊤) (Localization.Away g) f ^ n}) :
    IsIso (AlgebraicGeometry.blowUpToBase (Scheme.IdealSheafData.ofIdealTop J)) :=
  Stacks.Blowup.isIso_blowUpToBase_of_isEffectiveCartierDivisor _
    (isEffectiveCartierDivisor_ofIdealTop_of_forall_exists_away J f hf h)

end Stacks.Divisors

end
