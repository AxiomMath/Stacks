module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
public import StacksFrontier.AlgebraicGeometry.ClosedImmersion.Defs
public import StacksFrontier.Topology.Sheaves.Modules.Invertible
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Locally principal closed subschemes and effective Cartier divisors

Let `S` be a scheme. A closed subscheme of `S` is *locally principal* when its sheaf of ideals
is locally generated by a single element, and it is an *effective Cartier divisor* when that
sheaf of ideals is an invertible `𝒪_S`-module.

A closed subscheme is represented by `AlgebraicGeometry.Scheme.IdealSheafData`, which records
the ideal `I.ideal U ⊆ Γ(S, U)` cut out on every affine open `U` together with the closed
immersion `I.subschemeι`. Local principality is therefore the existence, around every point, of
an affine open on which `I.ideal U` is a principal ideal. The ideal *sheaf* of the subscheme is
the kernel `Stacks.ClosedImmersion.idealSheaf` of `𝒪_S ⟶ i_* 𝒪_D` as a sheaf of
`𝒪_S`-modules, and invertibility is the sheaf-level notion
`AlgebraicGeometry.SheafOfModules.IsInvertible`.

## Main definitions

* `Stacks.Divisors.IsLocallyPrincipal` is part (1) of Tag 01WR.
* `Stacks.Divisors.IsEffectiveCartierDivisor` is part (2) of Tag 01WR.

## Main results

* `Stacks.Divisors.isLocallyPrincipal_bot` and `Stacks.Divisors.isLocallyPrincipal_top`: the
  two trivial closed subschemes, `S` itself and the empty subscheme, are locally principal.

## Implementation notes

Both predicates are abbreviations, so that consumers can apply Mathlib's
`Submodule.IsPrincipal` API and the invertibility API directly without unfolding.

Tag 01WS, the affine-local characterization of an effective Cartier divisor by a
nonzerodivisor, is proved in
`StacksFrontier/AlgebraicGeometry/Divisors/EffectiveCartierAffineLocal.lean`, as
`Stacks.Divisors.isEffectiveCartierDivisor_iff_affineLocal`. Its proof uses that an invertible
sheaf of modules is locally trivial, in the form
`Stacks.SheafOfModules.exists_bijective_smul_of_isInvertible` of
`StacksFrontier/AlgebraicGeometry/InvertibleTrivialization/Basic.lean`.

The remark following Definition 01WR, that an effective Cartier divisor is locally principal, is
`Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor` of that file,
which produces an affine open with a principal ideal around every point and so gives
`Stacks.Divisors.IsLocallyPrincipal`. It is not stated here because this file is below that one
in the import order.

The sheaf of rings indexing the modules is `structureSheafRing`, which is
`𝒪_S` composed with `forget₂ CommRingCat RingCat`; it is definitionally the sheaf that
`AlgebraicGeometry.SheafOfModules.IsInvertible` expects.

## References

* [Stacks Project, Tag 01WR](https://stacks.math.columbia.edu/tag/01WR)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.Divisors

/-- **Stacks Project, Tag 01WR (1).** A closed subscheme of `S` is *locally principal* when its
sheaf of ideals is locally generated by a single element: every point of `S` has an affine open
neighbourhood on which the defining ideal is principal. -/
@[stacks 01WR "locally_principal_closed_subscheme"]
abbrev IsLocallyPrincipal {X : Scheme.{u}} (I : X.IdealSheafData) : Prop :=
  ∀ x : X, ∃ (U : X.affineOpens), x ∈ (U : Set X) ∧ (I.ideal U).IsPrincipal

/-- **Stacks Project, Tag 01WR (2).** An *effective Cartier divisor* on `S` is a closed
subscheme `D ⊆ S` whose ideal sheaf `ℐ_D ⊆ 𝒪_S` is an invertible `𝒪_S`-module. -/
@[stacks 01WR "effective_cartier_divisor", ega "II 8.9.4" "Setup hypothesis"]
abbrev IsEffectiveCartierDivisor {X : Scheme.{u}} (I : X.IdealSheafData) : Prop :=
  AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj
    (structureSheafRing X.toRingedSpace).property
    (Stacks.ClosedImmersion.idealSheaf I.subschemeι.toLRSHom.toShHom)

/-- Every point of a scheme lies in an affine open, since the affine opens form a basis of the
topology. -/
theorem exists_affineOpens_mem {X : Scheme.{u}} (x : X) :
    ∃ U : X.affineOpens, x ∈ (U : Set X) := by
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  exact ⟨⟨V, hV⟩, hxV⟩

/-- The whole scheme, as a closed subscheme of itself, is locally principal: it is cut out by
the zero ideal. -/
theorem isLocallyPrincipal_bot {X : Scheme.{u}} :
    IsLocallyPrincipal (⊥ : X.IdealSheafData) := fun x => by
  obtain ⟨U, hU⟩ := exists_affineOpens_mem x
  exact ⟨U, hU, ⟨0, by simp [Scheme.IdealSheafData.ideal_bot]⟩⟩

/-- The empty closed subscheme is locally principal: it is cut out by the unit ideal. -/
theorem isLocallyPrincipal_top {X : Scheme.{u}} :
    IsLocallyPrincipal (⊤ : X.IdealSheafData) := fun x => by
  obtain ⟨U, hU⟩ := exists_affineOpens_mem x
  exact ⟨U, hU, ⟨1, by simp [Scheme.IdealSheafData.ideal_top]⟩⟩

end Stacks.Divisors

end
