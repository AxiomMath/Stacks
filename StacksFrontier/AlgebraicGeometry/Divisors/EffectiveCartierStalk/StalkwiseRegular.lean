/-!
# Stalkwise regular ideal sheaves on a locally Noetherian scheme

On a locally Noetherian scheme a closed subscheme whose defining ideal is generated, in the local
ring at every point of the subscheme, by a single nonzerodivisor is an effective Cartier divisor.
This is the second part of Tag 0AG8, and
`isEffectiveCartierDivisor_of_stalk_isPrincipal_nonZeroDivisor` is how it reads here; the first
part, that a stalkwise principal ideal is locally principal, is
`Stacks.Divisors.isLocallyPrincipal_of_stalk_isPrincipal` of
`StacksFrontier/AlgebraicGeometry/Divisors/EffectiveCartierStalk/Stalkwise.lean`.

The two parts are proved in the same order as the source: the first part already produces an
affine open `U` around a point of the subscheme on which the ideal is generated by a single
section `f`, so all that is left is to see that `f` may be taken to be a nonzerodivisor after
shrinking `U`. That is two separate facts.

*The generator is a nonzerodivisor in the stalk.* The ideal of `U` maps onto the stalk ideal, so
the image of `f` generates it, and the hypothesis supplies a nonzerodivisor generating the same
ideal. A nonzerodivisor lying in the ideal generated by `f` forces `f` itself to be a
nonzerodivisor, which is `mem_nonZeroDivisors_of_mem_span_singleton`.

*Being a nonzerodivisor spreads to a neighbourhood.* This is the role played in the source by
[Stacks, Tag 061L]. The elementary argument used here is that the annihilator `K` of `f` in
`Γ(X, U)` is finitely generated, and each of its generators `k` is killed by some `e_k` outside
the prime of the point, because `k` becomes zero in the stalk. The product `h` of the `e_k` then
kills all of `K`, so on the affine open `U_h` nothing but zero is annihilated by `f`.

## Main results

* `Stacks.Divisors.mem_nonZeroDivisors_of_mem_span_singleton`: a ring element whose principal
  ideal contains a nonzerodivisor is itself a nonzerodivisor.
* `Stacks.Divisors.exists_notMem_mul_annihilator_eq_zero`: if `a` becomes a nonzerodivisor in
  the localization at a prime `p` and its annihilator is finitely generated, then one element
  outside `p` annihilates the whole annihilator of `a`.
* `Stacks.Divisors.mem_nonZeroDivisors_localizationAway`: that conclusion makes `a` a
  nonzerodivisor in the localization away from the element produced.
* `Stacks.Divisors.isEffectiveCartierDivisor_of_stalk_isPrincipal_nonZeroDivisor`: the second
  part of Tag 0AG8.

## Implementation notes

The Noetherian hypothesis of the source enters only through finite generation of the annihilator
of the generator, so `exists_notMem_mul_annihilator_eq_zero` asks for that directly; the
geometric result supplies it from `IsLocallyNoetherian`, which makes `Γ(X, U)` Noetherian for an
affine open `U`.

The two localization lemmas are stated for an arbitrary ring carrying the relevant
`IsLocalization` instance rather than for `Localization.AtPrime` and `Localization.Away`. That is
what lets them be applied to `X.presheaf.stalk x` and to `Γ(X, X.affineBasicOpen h)` with no
transfer along an algebra equivalence, which is the step that costs the most in this corner of
the library. Their conclusion and hypothesis about the ring being localized are both equations in
that ring, so neither lemma needs to know which model of the localization the other used.

The conclusion is asserted in the spelling `Stacks.Divisors.IsEffectiveCartierDivisor` of Tag
01WR and is produced through the affine-local criterion
`Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen`, which asks for a regular
generator on an affine open around *every* point of the scheme; away from the support that is
supplied by `Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_notMem_support`, with the unit
ideal and the generator `1`.

## References

* [Stacks Project, Tag 0AG8](https://stacks.math.columbia.edu/tag/0AG8)
* [Stacks Project, Tag 01WR](https://stacks.math.columbia.edu/tag/01WR)
* [Stacks Project, Tag 061L](https://stacks.math.columbia.edu/tag/061L)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.Divisors

section Algebra

variable {A : Type*} [CommRing A]

/-- An element whose principal ideal contains a nonzerodivisor is itself a nonzerodivisor: a
nonzerodivisor multiple of `x` cannot be killed without killing the cofactor. -/
theorem mem_nonZeroDivisors_of_mem_span_singleton {x y : A} (hy : y ∈ nonZeroDivisors A)
    (hmem : y ∈ Ideal.span ({x} : Set A)) : x ∈ nonZeroDivisors A := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 hmem
  exact isRegular_iff_mem_nonZeroDivisors.1
    (IsRegular.of_mul_right (a := c) (hc ▸ isRegular_iff_mem_nonZeroDivisors.2 hy))

/-- **Being a nonzerodivisor spreads out from a prime.** If `a` has finitely generated
annihilator and becomes a nonzerodivisor in a localization of `A` at a prime `p`, then some `h`
outside `p` annihilates every element annihilated by `a`. -/
theorem exists_notMem_mul_annihilator_eq_zero (p : Ideal A) [p.IsPrime] (S : Type*) [CommRing S]
    [Algebra A S] [IsLocalization p.primeCompl S] {a : A}
    (hfg : (Ideal.span ({a} : Set A)).annihilator.FG)
    (hnzd : algebraMap A S a ∈ nonZeroDivisors S) :
    ∃ h ∈ p.primeCompl, ∀ b : A, b * a = 0 → h * b = 0 := by
  classical
  obtain ⟨s, hs⟩ := hfg
  have hmem_ann : ∀ b : A, b ∈ (Ideal.span ({a} : Set A)).annihilator ↔ b * a = 0 := fun b => by
    simp
  have key : ∀ k ∈ s, ∃ e ∈ p.primeCompl, e * k = 0 := by
    intro k hk
    have hka : k * a = 0 := (hmem_ann k).1 (hs ▸ Ideal.subset_span hk)
    have hz : algebraMap A S k = 0 := by
      refine (mem_nonZeroDivisors_iff.1 hnzd).2 _ ?_
      rw [← map_mul, hka, map_zero]
    rw [← IsLocalization.mk'_one (M := p.primeCompl) S k, IsLocalization.mk'_eq_zero_iff] at hz
    obtain ⟨e, he⟩ := hz
    exact ⟨e.1, e.2, he⟩
  choose! e he hek using key
  refine ⟨s.prod e, Submonoid.prod_mem _ fun k hk => he k hk, ?_⟩
  intro b hb
  have hbmem := (hmem_ann b).2 hb
  rw [← hs] at hbmem
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hbmem
  · intro k hk
    rw [← Finset.mul_prod_erase s e hk, mul_right_comm, hek k hk, zero_mul]
  · simp
  · intro u v _ _ hu hv
    rw [mul_add, hu, hv, add_zero]
  · intro c u _ hu
    rw [smul_eq_mul, mul_left_comm, hu, mul_zero]

/-- **The spread-out nonzerodivisor.** If `h` annihilates everything that `a` annihilates, then
`a` is a nonzerodivisor in any localization of `A` away from `h`. -/
theorem mem_nonZeroDivisors_localizationAway {a h : A} (hh : ∀ b : A, b * a = 0 → h * b = 0)
    (T : Type*) [CommRing T] [Algebra A T] [IsLocalization.Away h T] :
    algebraMap A T a ∈ nonZeroDivisors T := by
  have key : ∀ z : T, z * algebraMap A T a = 0 → z = 0 := by
    intro z hz
    obtain ⟨⟨b, m⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers h) z
    simp only at hz
    rw [← IsLocalization.mk'_one (M := Submonoid.powers h) T a,
      ← IsLocalization.mk'_mul T b a m 1, IsLocalization.mk'_eq_zero_iff] at hz
    obtain ⟨⟨c, n, hn⟩, hc⟩ := hz
    simp only at hn hc
    subst hn
    rw [IsLocalization.mk'_eq_zero_iff]
    refine ⟨⟨h ^ (n + 1), n + 1, rfl⟩, ?_⟩
    show h ^ (n + 1) * b = 0
    linear_combination hh (h ^ n * b) (by linear_combination hc)
  exact mem_nonZeroDivisors_iff.2 ⟨fun x hx => key x (by rwa [mul_comm]), key⟩

end Algebra

section Scheme

/-- **Stacks Project, Tag 0AG8.** A closed subscheme of a locally Noetherian scheme is an
effective Cartier divisor if its ideal is generated by a single nonzerodivisor in the local ring
at each point of the subscheme. -/
@[stacks 0AG8, ega "IV 21.2.12" "special case"]
theorem isEffectiveCartierDivisor_of_stalk_isPrincipal_nonZeroDivisor {X : Scheme.{u}}
    [IsLocallyNoetherian X] (I : X.IdealSheafData)
    (hI : ∀ x : X, x ∈ I.support → ∃ g ∈ nonZeroDivisors (X.presheaf.stalk x),
      IdealSheafData.stalk I x = Ideal.span {g}) :
    IsEffectiveCartierDivisor I := by
  have hprincipal : ∀ x : X, x ∈ I.support → (IdealSheafData.stalk I x).IsPrincipal := by
    intro x hx
    obtain ⟨g, -, hg⟩ := hI x hx
    exact ⟨g, hg⟩
  refine isEffectiveCartierDivisor_of_forall_exists_affineOpen I fun x => ?_
  by_cases hx : x ∈ I.supportSet
  swap
  · exact exists_affineOpen_ideal_eq_span_of_notMem_support I x hx
  obtain ⟨V, hxV, f, hgenV⟩ := isLocallyPrincipal_of_stalk_isPrincipal I hprincipal x
  have hstalkV :
      IdealSheafData.stalk I x = Ideal.span {(X.presheaf.germ V.1 x hxV).hom f} := by
    rw [IdealSheafData.stalk_eq_map_germ I x V hxV, hgenV, Ideal.map_span, Set.image_singleton]
  obtain ⟨g, hgnzd, hgspan⟩ := hI x (Scheme.IdealSheafData.mem_supportSet_iff_mem_support.1 hx)
  have hnzdStalk :
      (X.presheaf.germ V.1 x hxV).hom f ∈ nonZeroDivisors (X.presheaf.stalk x) :=
    mem_nonZeroDivisors_of_mem_span_singleton hgnzd
      (by
        rw [← hstalkV, hgspan]
        exact Ideal.subset_span rfl)
  have : IsNoetherianRing Γ(X, V) := IsLocallyNoetherian.component_noetherian V
  let p : PrimeSpectrum Γ(X, V) := V.2.primeIdealOf ⟨x, hxV⟩
  let P : Ideal Γ(X, V) := p.asIdeal
  have : P.IsPrime := p.isPrime
  let _ : Algebra Γ(X, V) (X.presheaf.stalk x) := X.presheaf.algebra_section_stalk ⟨x, hxV⟩
  have : IsLocalization P.primeCompl (X.presheaf.stalk x) := V.2.isLocalization_stalk ⟨x, hxV⟩
  obtain ⟨a, ha, hann⟩ := exists_notMem_mul_annihilator_eq_zero P (X.presheaf.stalk x)
    (Ideal.fg_of_isNoetherianRing _) hnzdStalk
  let W := X.affineBasicOpen a
  have hxW : x ∈ W.1 := by
    refine (X.mem_basicOpen' a ⟨x, hxV⟩).2 ?_
    show IsUnit (algebraMap Γ(X, V) (X.presheaf.stalk x) a)
    exact IsLocalization.map_units (M := P.primeCompl) _ ⟨a, ha⟩
  let _ : Algebra Γ(X, V) Γ(X, W) :=
    (X.presheaf.map (homOfLE (X.basicOpen_le a)).op).hom.toAlgebra
  have : IsLocalization.Away a Γ(X, W) := V.2.isLocalization_basicOpen a
  have hnzdW : algebraMap Γ(X, V) Γ(X, W) f ∈ nonZeroDivisors Γ(X, W) :=
    mem_nonZeroDivisors_localizationAway hann Γ(X, W)
  have hidealW : I.ideal W = Ideal.span {algebraMap Γ(X, V) Γ(X, W) f} := by
    rw [← I.map_ideal (X.basicOpen_le a), hgenV, Ideal.map_span, Set.image_singleton]
    rfl
  exact ⟨W.1, W.2, hxW, algebraMap Γ(X, V) Γ(X, W) f,
    isRegular_iff_mem_nonZeroDivisors.2 hnzdW, hidealW⟩

end Scheme

end Stacks.Divisors

end
