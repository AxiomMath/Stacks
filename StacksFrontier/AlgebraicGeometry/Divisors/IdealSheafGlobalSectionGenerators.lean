module

public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartier.SumSequence

/-!
# An ideal sheaf cut out by global functions is generated by global sections

Let `X` be a scheme and let `J ⊆ Γ(X, 𝒪_X)` be an ideal of its ring of global functions.  The
quasi-coherent sheaf of ideals it generates is
`AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop J`, whose ideal on an affine open `U` is the
extension `J · Γ(X, U)`.  This file shows that the corresponding sheaf of `𝒪_X`-modules
`Stacks.Divisors.idealSheafOfModules (ofIdealTop J)` is generated by global sections, the
generators being the elements of `J` themselves.

## Main results

* `Stacks.Divisors.idealSheafHomOfGlobalFunction`: a global function lying in the ideal of the
  closed subscheme on every affine open determines a morphism `𝒪_X ⟶ ℐ_K`, namely multiplication
  by it, and `Stacks.Divisors.idealSheafSection_idealSheafHomOfGlobalFunction` identifies it on
  sections.
* `Stacks.Divisors.ofIdealTopGeneratingSections`: **the ideal sheaf generated by an ideal `J` of
  global functions is generated by global sections**, indexed by `J` itself.
* `Stacks.Divisors.nonempty_generatingSections_ofIdealTop`: the same statement with the data
  discarded.

## Implementation notes

The epimorphism out of the free sheaf is verified by
`Stacks.Divisors.epi_of_surjective_affine`, which reduces it to surjectivity on sections over
each affine open; that is where the description `(ofIdealTop J).ideal U = J · Γ(X, U)` enters.
The surjectivity itself is proved by exhibiting the image as an *ideal* of `Γ(X, U)` and
bounding `J · Γ(X, U)` by it, which `Ideal.map_le_iff_le_comap` turns into the single statement
that each element of `J` is hit — by its own generator.

Two ascriptions, `Stacks.Divisors.unitSectionFun` and its inverse
`Stacks.Divisors.unitSectionOfFun`, name the identification of `Γ(X, V)` with the sections of
the unit sheaf of modules over the `RingCat`-valued structure sheaf.  The two types are equal by
`rfl`, but `AlgebraicGeometry.structureSheafRing` is `@[instance_reducible]`, so a product or a
scalar multiplication written at the second spelling does not retrieve the ring and module
instances; naming the ascription is what keeps those expressions type-correct.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace Stacks.Divisors

variable {X : Scheme.{u}}

/-- A section of the unit sheaf of `𝒪_X`-modules over `V`, read as a regular function on `V`. -/
def unitSectionFun {V : X.Opens}
    (c : ToType ((structureSheafRing X.toRingedSpace).obj.obj (op V))) : Γ(X, V) := c

/-- A regular function on `V`, read as a section of the unit sheaf of `𝒪_X`-modules. -/
def unitSectionOfFun {V : X.Opens} (c : Γ(X, V)) :
    ToType ((structureSheafRing X.toRingedSpace).obj.obj (op V)) := c

/-- The restrictions of a global function form a global section of the unit sheaf of
`𝒪_X`-modules. -/
noncomputable def unitGlobalSection (a : Γ(X, ⊤)) :
    (SheafOfModules.unit (structureSheafRing X.toRingedSpace)).sections :=
  PresheafOfModules.sectionsMk
    (M := (SheafOfModules.unit (structureSheafRing X.toRingedSpace)).val)
    (fun V => X.presheaf.map (homOfLE (le_top (a := V.unop))).op a)
    (fun {V W} g => by
      change (X.presheaf.map g).hom ((X.presheaf.map (homOfLE _).op).hom a) = _
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl)

/-- Multiplication by a global function, as an endomorphism of the structure sheaf read as a
sheaf of modules over itself. -/
noncomputable def mulGlobalFunction (a : Γ(X, ⊤)) :
    SheafOfModules.unit (structureSheafRing X.toRingedSpace) ⟶
      SheafOfModules.unit (structureSheafRing X.toRingedSpace) :=
  (SheafOfModules.unit (structureSheafRing X.toRingedSpace)).unitHomEquiv.symm
    (unitGlobalSection a)

/-- On sections over `V`, `Stacks.Divisors.mulGlobalFunction a` is multiplication by the
restriction of `a`. -/
theorem unitSectionFun_mulGlobalFunction_app (a : Γ(X, ⊤)) (V : X.Opens)
    (c : ToType ((structureSheafRing X.toRingedSpace).obj.obj (op V))) :
    unitSectionFun (((mulGlobalFunction a).val.app (op V)).hom c) =
      unitSectionFun c * X.presheaf.map (homOfLE (le_top (a := V))).op a := rfl

/-- Multiplication by a global function lying in the ideal of a closed subscheme on every affine
open annihilates the structure sheaf of that closed subscheme.  Only affine opens have to be
checked, because they form a basis of the topology. -/
theorem mulGlobalFunction_comp_subschemeStructureHom (K : X.IdealSheafData) (a : Γ(X, ⊤))
    (ha : ∀ U : X.affineOpens, X.presheaf.map (homOfLE (le_top (a := U.1))).op a ∈ K.ideal U) :
    mulGlobalFunction a ≫ subschemeStructureHom K = 0 := by
  apply SheafOfModules.hom_ext
  apply presheafToSheaf_hom_ext_affine
    (SheafOfModules.unit (structureSheafRing X.toRingedSpace)).val
  intro U
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro c
  have hmem : X.presheaf.map (homOfLE (le_top (a := U.1))).op a ∈
      RingHom.ker (K.subschemeι.app (U : X.Opens)).hom := by
    rw [K.ker_subschemeι_app U]; exact ha U
  change K.subschemeι.app (U : X.Opens)
    (unitSectionFun c * X.presheaf.map (homOfLE _).op a) = 0
  rw [map_mul, RingHom.mem_ker.1 hmem, mul_zero]

/-- **A global function lying in the ideal of a closed subscheme is a global section of its
ideal sheaf.**  More precisely, multiplication by it is a morphism `𝒪_X ⟶ ℐ_K`. -/
noncomputable def idealSheafHomOfGlobalFunction (K : X.IdealSheafData) (a : Γ(X, ⊤))
    (ha : ∀ U : X.affineOpens, X.presheaf.map (homOfLE (le_top (a := U.1))).op a ∈ K.ideal U) :
    SheafOfModules.unit (structureSheafRing X.toRingedSpace) ⟶ idealSheafOfModules K :=
  kernel.lift _ (mulGlobalFunction a) (mulGlobalFunction_comp_subschemeStructureHom K a ha)

/-- On sections over `V`, `Stacks.Divisors.idealSheafHomOfGlobalFunction` is multiplication by
the restriction of `a`, read inside the structure sheaf. -/
theorem idealSheafSection_idealSheafHomOfGlobalFunction (K : X.IdealSheafData) (a : Γ(X, ⊤))
    (ha : ∀ U : X.affineOpens, X.presheaf.map (homOfLE (le_top (a := U.1))).op a ∈ K.ideal U)
    (V : X.Opens) (c : ToType ((structureSheafRing X.toRingedSpace).obj.obj (op V))) :
    idealSheafSection K (((idealSheafHomOfGlobalFunction K a ha).val.app (op V)).hom c) =
      unitSectionFun c * X.presheaf.map (homOfLE (le_top (a := V))).op a := by
  rw [← unitSectionFun_mulGlobalFunction_app a V c]
  exact congrArg
    (fun q : SheafOfModules.unit (structureSheafRing X.toRingedSpace) ⟶ _ =>
      (q.val.app (op V)).hom c)
    (kernel.lift_ι (subschemeStructureHom K) (mulGlobalFunction a)
      (mulGlobalFunction_comp_subschemeStructureHom K a ha))

/-- The inclusion of the ideal sheaf into the structure sheaf is additive on sections. -/
theorem idealSheafSection_add (K : X.IdealSheafData) {V : X.Opens}
    (y y' : (idealSheafOfModules K).val.obj (op V)) :
    idealSheafSection K (y + y') = idealSheafSection K y + idealSheafSection K y' :=
  map_add ((kernel.ι (subschemeStructureHom K)).val.app (op V)).hom y y'

/-- The inclusion of the ideal sheaf into the structure sheaf takes `0` to `0`. -/
theorem idealSheafSection_zero (K : X.IdealSheafData) (V : X.Opens) :
    idealSheafSection K (0 : (idealSheafOfModules K).val.obj (op V)) = 0 :=
  map_zero ((kernel.ι (subschemeStructureHom K)).val.app (op V)).hom

/-- The inclusion of the ideal sheaf into the structure sheaf is `Γ(X, V)`-linear on sections. -/
theorem idealSheafSection_smul (K : X.IdealSheafData) {V : X.Opens} (c : Γ(X, V))
    (y : (idealSheafOfModules K).val.obj (op V)) :
    idealSheafSection K (unitSectionOfFun c • y) = c * idealSheafSection K y :=
  ((kernel.ι (subschemeStructureHom K)).val.app (op V)).hom.map_smul
    (unitSectionOfFun c) y

/-- **The ideal sheaf generated by an ideal `J` of global functions is generated by global
sections**, the generators being the elements of `J`: on an affine open `U` the ideal cut out is
`J · Γ(X, U)`, so the restrictions of the elements of `J` generate it there, and the affine
opens form a basis of the topology. -/
noncomputable def ofIdealTopGeneratingSections (J : Ideal Γ(X, ⊤)) :
    (idealSheafOfModules (Scheme.IdealSheafData.ofIdealTop J)).GeneratingSections where
  I := ↥J
  s a := (idealSheafOfModules (Scheme.IdealSheafData.ofIdealTop J)).unitHomEquiv
    (idealSheafHomOfGlobalFunction _ a.1 (fun U => by
      rw [Scheme.IdealSheafData.ofIdealTop_ideal]; exact Ideal.mem_map_of_mem _ a.2))
  epi := by
    set K := Scheme.IdealSheafData.ofIdealTop J with hK
    set M := idealSheafOfModules K with hM
    refine epi_of_surjective_affine _ (fun U => ?_)
    set φ := M.freeHomEquiv.symm (fun a : ↥J => M.unitHomEquiv
      (idealSheafHomOfGlobalFunction K a.1 (fun U => by
        rw [hK, Scheme.IdealSheafData.ofIdealTop_ideal]; exact Ideal.mem_map_of_mem _ a.2)))
      with hφ
    have hfactor : ∀ a : ↥J, SheafOfModules.ιFree a ≫ φ =
        idealSheafHomOfGlobalFunction K a.1 (fun U => by
          rw [hK, Scheme.IdealSheafData.ofIdealTop_ideal]
          exact Ideal.mem_map_of_mem _ a.2) := by
      intro a
      rw [← SheafOfModules.unitHomEquiv_symm_freeHomEquiv_apply, hφ,
        Equiv.apply_symm_apply, Equiv.symm_apply_apply]
    let P : Ideal Γ(X, (U : X.Opens)) :=
      { carrier := {r | ∃ z, idealSheafSection K ((φ.val.app (op U.1)).hom z) = r}
        add_mem' := by
          rintro r r' ⟨z, hz⟩ ⟨z', hz'⟩
          exact ⟨z + z', by rw [map_add, idealSheafSection_add, hz, hz']⟩
        zero_mem' := ⟨0, by rw [map_zero, idealSheafSection_zero]⟩
        smul_mem' := by
          rintro c r ⟨z, hz⟩
          exact ⟨unitSectionOfFun c • z, by
            rw [(φ.val.app (op U.1)).hom.map_smul, idealSheafSection_smul, hz, smul_eq_mul]⟩ }
    have hPJ : K.ideal U ≤ P := by
      rw [hK, Scheme.IdealSheafData.ofIdealTop_ideal]
      refine Ideal.map_le_iff_le_comap.2 (fun a ha => ?_)
      refine ⟨((SheafOfModules.ιFree (⟨a, ha⟩ : ↥J)).val.app (op U.1)).hom
        (unitSectionOfFun (1 : Γ(X, (U : X.Opens)))), ?_⟩
      have h1 := congrArg
        (fun q : SheafOfModules.unit (structureSheafRing X.toRingedSpace) ⟶ M =>
          idealSheafSection K ((q.val.app (op U.1)).hom
            (unitSectionOfFun (1 : Γ(X, (U : X.Opens))))))
        (hfactor ⟨a, ha⟩)
      rw [idealSheafSection_idealSheafHomOfGlobalFunction] at h1
      exact Eq.trans rfl (h1.trans (one_mul _))
    intro y
    obtain ⟨z, hz⟩ := hPJ ((mem_ideal_iff_exists_idealSheafSection K U _).2 ⟨y, rfl⟩)
    exact ⟨z, idealSheafSection_injective K hz⟩

/-- **The ideal sheaf generated by an ideal of global functions is generated by global
sections.** -/
theorem nonempty_generatingSections_ofIdealTop (J : Ideal Γ(X, ⊤)) :
    Nonempty (idealSheafOfModules (Scheme.IdealSheafData.ofIdealTop J)).GeneratingSections :=
  ⟨ofIdealTopGeneratingSections J⟩

end Stacks.Divisors

end
