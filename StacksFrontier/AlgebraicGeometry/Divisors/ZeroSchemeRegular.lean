module

public import StacksFrontier.AlgebraicGeometry.Divisors.Meromorphic.RegularSections
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.Divisors.ZeroSchemeProperties

/-!
# The zero scheme of a section is Cartier exactly when the section is regular

This file proves clause (4) of [Stacks, Tag 02OR](https://stacks.math.columbia.edu/tag/02OR):
for a global section `s` of an invertible module `L` on a scheme `X`, the zero scheme `Z(s)` is
an effective Cartier divisor if and only if `s` is a nonzerodivisor, i.e. multiplication by `s`
is a monomorphism `𝒪_X ⟶ L`.

## Main results

* `AlgebraicGeometry.isEffectiveCartierDivisor_zeroScheme_iff_isRegularSection`:
  **Tag 02OR (4)**, the characterization itself.
* `AlgebraicGeometry.isRegular_germ_of_isEffectiveCartierDivisor`: if `Z(s)` is an effective
  Cartier divisor then on a trivializing affine open the function representing `s` has
  nonzerodivisor germs.
* `AlgebraicGeometry.isRegular_coordinate_of_isRegularSection`: conversely, if `s` is a
  nonzerodivisor then the function representing it on a trivializing affine open is a
  nonzerodivisor there.

## Implementation notes

Both directions run through a trivializing affine open `U` and the local equation
`AlgebraicGeometry.zeroScheme_ideal_of_trivialization`: under `e : Γ(L, U) ≃ₗ Γ(X, U)` the
defining ideal of `Z(s)` on `U` is generated by the single function `a = e (s|_U)`.

*Cartier implies regular.* The Cartier hypothesis gives, around each point, some affine open on
which the ideal of `Z(s)` is generated by a nonzerodivisor `f`
(`Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor`, the forward half
of Tag 01WS). On an affine open inside the intersection with `U` the two generators span the same
ideal, so `a` divides `f` there, and a divisor of a nonzerodivisor is a nonzerodivisor; passing to
the stalk is `AlgebraicGeometry.isSMulRegular_germ_of_isAffineOpen`. Regularity of the germ of `a`
then cancels `a` out of the sectionwise identity `r • s|_U = t • s|_U`, which is injectivity of
`𝒪_X ⟶ L` on sections, hence monicity.

*Regular implies Cartier.* Monicity gives injectivity on the sections over the trivializing open,
which transported through `e` says exactly that `a` is a nonzerodivisor; then
`Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen` (the backward half of
Tag 01WS) applies with the local equation. No charts and no quotient presentations are needed in
either direction.

Components of a global section are spelled as restrictions from `⊤`, never as `s.eval (.op U)`
retyped at `Γ(L, U)`: the retyping is erased by `simp`, which then loses the
`Γ(X, U)`-module structure on `Γ(L, U)` and with it every `Scheme.Modules.map_smul` rewrite.

## References

* [Stacks Project, Tag 02OR](https://stacks.math.columbia.edu/tag/02OR)
* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
* [Stacks Project, Tag 01WY](https://stacks.math.columbia.edu/tag/01WY)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace AlgebraicGeometry

namespace Scheme.Modules

variable {X : Scheme.{u}} (L : X.Modules)

/-- The component of a global section over an open is the restriction of its component over the
whole space. -/
theorem map_eval_top (s : L.sections) (U : X.Opens) :
    L.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op (s.eval (op ⊤)) = s.eval (op U) :=
  s.property (homOfLE le_top).op

/-- Restricting a section of `L` over the whole space to `V` and then to `U ≤ V` restricts it
to `U`. -/
theorem map_map_le_top (s : Γ(L, ⊤)) {U V : X.Opens} (h : U ≤ V) :
    L.presheaf.map (homOfLE h).op (L.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op s) =
      L.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op s := by
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
  congr 2

/-- The morphism `𝒪_X ⟶ L` attached to a global section `s` acts on sections over an open by
multiplying by the restriction of `s` there. -/
theorem unitHomEquiv_symm_app_apply (s : L.sections) (U : X.Opens) (r : Γ(X, U)) :
    ((L.unitHomEquiv.symm s).val.app (op U)).hom r =
      r • L.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op (s.eval (op ⊤)) := by
  rw [map_eval_top]
  rfl

/-- A global section of `L` is a nonzerodivisor exactly when multiplication by it is injective
on the sections over every open. -/
theorem injective_unitHomEquiv_symm_app_of_isRegularSection (s : L.sections)
    (hs : IsRegularSection X.sheaf.obj X.ringCatSheaf.property s) (U : X.Opens) :
    Function.Injective ((L.unitHomEquiv.symm s).val.app (op U)) := by
  have h0 : PreservesFiniteLimits (SheafOfModules.forget.{u} X.ringCatSheaf) :=
    SheafOfModules.Finite.forgetPreservesFiniteLimits _
  have h1 : PreservesLimitsOfShape WalkingCospan (SheafOfModules.forget.{u} X.ringCatSheaf) :=
    h0.preservesFiniteLimits WalkingCospan
  have h2 : (SheafOfModules.forget.{u} X.ringCatSheaf).PreservesMonomorphisms :=
    preservesMonomorphisms_of_preservesLimitsOfShape _
  have _ : Mono (L.unitHomEquiv.symm s) := hs
  have h3 : Mono ((SheafOfModules.forget.{u} X.ringCatSheaf).map (L.unitHomEquiv.symm s)) :=
    h2.preserves _
  have _ : Mono (L.unitHomEquiv.symm s).val := h3
  exact PresheafOfModules.injective_of_mono _ (op U)

end Scheme.Modules

variable (X : Scheme.{u}) (L : X.Modules)
  [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]

include L in
/-- Every point of an open has a trivializing affine open neighbourhood inside that open: the
basic opens of `AlgebraicGeometry.exists_basicOpen_linearEquiv` are affine and cofinal. -/
theorem exists_affineOpens_linearEquiv_le (x : X) (V : X.Opens) (hx : x ∈ V) :
    ∃ U : X.affineOpens, x ∈ U.1 ∧ U.1 ≤ V ∧
      Nonempty (Γ(L, U.1) ≃ₗ[Γ(X, U.1)] Γ(X, U.1)) := by
  obtain ⟨-, ⟨W, hW, rfl⟩, hxW, hWV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hx V.isOpen
  obtain ⟨g, hxg, hgW, he⟩ := exists_basicOpen_linearEquiv L ⟨W, hW⟩ x hxW
  exact ⟨⟨X.basicOpen g, hW.basicOpen g⟩, hxg, hgW.trans hWV, he⟩

include L in
/-- **The local function of an effective Cartier zero scheme has nonzerodivisor germs.** If
`Z(s)` is an effective Cartier divisor then on a trivializing affine open `U` the function
`e (s|_U)` generating the ideal of `Z(s)` has a nonzerodivisor germ at every point of `U`. -/
theorem isRegular_germ_of_isEffectiveCartierDivisor (s : Γ(L, ⊤))
    (hI : Stacks.Divisors.IsEffectiveCartierDivisor (zeroScheme X L s))
    (U : X.affineOpens) (e : Γ(L, U.1) ≃ₗ[Γ(X, U.1)] Γ(X, U.1)) (x : X) (hxU : x ∈ U.1) :
    IsRegular ((X.presheaf.germ U.1 x hxU).hom
      (e (L.presheaf.map (homOfLE le_top).op s))) := by
  classical
  set I : X.IdealSheafData := zeroScheme X L s with hIdef
  set a : Γ(X, U.1) := e (L.presheaf.map (homOfLE le_top).op s) with hadef
  have hgenU : I.ideal U = Ideal.span {a} :=
    zeroScheme_ideal_of_trivialization X L s U e a rfl
  obtain ⟨V, hV, hxV, f, hf, hgenV⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor I hI x
  obtain ⟨-, ⟨W, hW, rfl⟩, hxW, hWmeet⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open
      (show x ∈ U.1 ⊓ V from ⟨hxU, hxV⟩) (U.1 ⊓ V).isOpen
  have hWU : (⟨W, hW⟩ : X.affineOpens) ≤ U := fun y hy => (hWmeet hy).1
  have hWV : (⟨W, hW⟩ : X.affineOpens) ≤ (⟨V, hV⟩ : X.affineOpens) := fun y hy => (hWmeet hy).2
  -- a generator of the ideal on a larger affine open restricts to a generator on `W`
  have hspan {V' : X.affineOpens} (h : (⟨W, hW⟩ : X.affineOpens) ≤ V') {g : Γ(X, V'.1)}
      (hg : I.ideal V' = Ideal.span {g}) :
      I.ideal ⟨W, hW⟩ = Ideal.span {(X.presheaf.map (homOfLE h).op).hom g} := by
    rw [← I.map_ideal h, hg, Ideal.map_span, Set.image_singleton]
  -- on `W` the two generators span the same ideal, so `a|_W` divides `f|_W`
  obtain ⟨c, hc⟩ : (X.presheaf.map (homOfLE hWU).op).hom a ∣
      (X.presheaf.map (homOfLE hWV).op).hom f :=
    Ideal.mem_span_singleton.mp
      (hspan hWU hgenU ▸ hspan hWV hgenV ▸ Ideal.mem_span_singleton_self _)
  have hfgerm : IsRegular ((X.presheaf.germ V x hxV).hom f) :=
    isLeftRegular_iff_isRegular.mp
      (isSMulRegular_germ_of_isAffineOpen X hV hf.left.isSMulRegular ⟨x, hxV⟩)
  rw [← X.presheaf.germ_res_apply (homOfLE hWU) x hxW]
  refine IsRegular.of_mul_left (b := (X.presheaf.germ W x hxW).hom c) ?_
  rw [← map_mul]
  erw [← hc]
  rwa [← X.presheaf.germ_res_apply (homOfLE hWV) x hxW] at hfgerm

include L in
/-- **Cancelling the section of an effective Cartier zero scheme.** If `Z(s)` is an effective
Cartier divisor then multiplication by `s` is injective on the sections of the structure sheaf
over every open. -/
theorem eq_of_smul_restrict_eq_of_isEffectiveCartierDivisor (s : Γ(L, ⊤))
    (hI : Stacks.Divisors.IsEffectiveCartierDivisor (zeroScheme X L s))
    (T : X.Opens) {r t : Γ(X, T)}
    (hrt : r • L.presheaf.map (homOfLE (le_top : T ≤ ⊤)).op s =
      t • L.presheaf.map (homOfLE (le_top : T ≤ ⊤)).op s) : r = t := by
  classical
  apply TopCat.Presheaf.section_ext
    (⟨X.presheaf, X.IsSheaf⟩ : TopCat.Sheaf CommRingCat.{u} X.toTopCat) T r t
  intro x hx
  obtain ⟨U, hxU, hUT, ⟨e⟩⟩ := exists_affineOpens_linearEquiv_le X L x T hx
  set a : Γ(X, U.1) := e (L.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op s) with hadef
  have ha : IsRegular ((X.presheaf.germ U.1 x hxU).hom a) :=
    isRegular_germ_of_isEffectiveCartierDivisor X L s hI U e x hxU
  have hres := congrArg (fun z : Γ(L, T) => L.presheaf.map (homOfLE hUT).op z) hrt
  simp only [Scheme.Modules.map_smul, Scheme.Modules.map_map_le_top L s hUT] at hres
  have hcoord (q : Γ(X, U.1)) :
      e (q • L.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op s) = q * a := by
    rw [map_smul, hadef, smul_eq_mul]
  have hprod : (X.presheaf.map (homOfLE hUT).op).hom r * a =
      (X.presheaf.map (homOfLE hUT).op).hom t * a := by
    simpa only [hcoord] using congrArg e hres
  have hcancel : (X.presheaf.germ U.1 x hxU).hom ((X.presheaf.map (homOfLE hUT).op).hom r) =
      (X.presheaf.germ U.1 x hxU).hom ((X.presheaf.map (homOfLE hUT).op).hom t) := by
    refine ha.right ?_
    simpa only [map_mul] using congrArg (X.presheaf.germ U.1 x hxU).hom hprod
  simpa only [X.presheaf.germ_res_apply] using hcancel

omit [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] in
/-- **The local function of a nonzerodivisor section is a nonzerodivisor.** On a trivializing
affine open `U`, the function `e (s|_U)` representing a nonzerodivisor global section is a
nonzerodivisor in `Γ(X, U)`. -/
theorem isRegular_coordinate_of_isRegularSection (s : L.sections)
    (hs : IsRegularSection X.sheaf.obj X.ringCatSheaf.property s)
    (U : X.affineOpens) (e : Γ(L, U.1) ≃ₗ[Γ(X, U.1)] Γ(X, U.1)) :
    IsRegular (e (L.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op (s.eval (op ⊤)))) := by
  have hinj := Scheme.Modules.injective_unitHomEquiv_symm_app_of_isRegularSection L s hs U.1
  have hcoord (q : Γ(X, U.1)) :
      e (q • L.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op (s.eval (op ⊤))) =
        e (L.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op (s.eval (op ⊤))) * q := by
    rw [map_smul, smul_eq_mul, mul_comm]
  refine isLeftRegular_iff_isRegular.mp fun q q' hqq' => ?_
  refine hinj ?_
  rw [Scheme.Modules.unitHomEquiv_symm_app_apply L s U.1 q,
    Scheme.Modules.unitHomEquiv_symm_app_apply L s U.1 q']
  refine e.injective ?_
  rw [hcoord, hcoord]
  exact hqq'

include L in
/-- **Stacks Project, Tag 02OR (4).** The zero scheme of a global section `s` of an invertible
module is an effective Cartier divisor if and only if `s` is a nonzerodivisor. -/
@[stacks 02OR "cartier_iff_regular"]
theorem isEffectiveCartierDivisor_zeroScheme_iff_isRegularSection (s : L.sections) :
    Stacks.Divisors.IsEffectiveCartierDivisor (zeroScheme X L (s.eval (op ⊤))) ↔
      IsRegularSection X.sheaf.obj X.ringCatSheaf.property s := by
  classical
  constructor
  · intro hI
    have hreflect : Functor.ReflectsMonomorphisms (SheafOfModules.forget X.ringCatSheaf) :=
      Functor.reflectsMonomorphisms_of_faithful _
    refine hreflect.reflects (L.unitHomEquiv.symm s) ?_
    refine PresheafOfModules.mono_of_injective fun T r t hrt => ?_
    refine eq_of_smul_restrict_eq_of_isEffectiveCartierDivisor X L (s.eval (op ⊤)) hI T.unop ?_
    rw [← Scheme.Modules.unitHomEquiv_symm_app_apply L s T.unop r,
      ← Scheme.Modules.unitHomEquiv_symm_app_apply L s T.unop t]
    exact hrt
  · intro hs
    refine Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen _ fun x => ?_
    obtain ⟨U, hxU, -, ⟨e⟩⟩ := exists_affineOpens_linearEquiv_le X L x ⊤ trivial
    refine ⟨U.1, U.2, hxU, e (L.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op (s.eval (op ⊤))),
      isRegular_coordinate_of_isRegularSection X L s hs U e, ?_⟩
    exact zeroScheme_ideal_of_trivialization X L (s.eval (op ⊤)) U e _ rfl

end AlgebraicGeometry

end
