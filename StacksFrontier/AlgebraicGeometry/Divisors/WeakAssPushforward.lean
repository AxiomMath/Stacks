module

public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.RingTheory.Ideal.MinimalPrime.Basic
public import StacksFrontier.AlgebraicGeometry.PushforwardRegularity.Basic
public import StacksFrontier.RingTheory.Ideal.WeaklyAssociatedPrime.Defs

/-!
# Weakly associated points of a pushforward

Let `f : X ⟶ S` be a quasi-compact morphism of schemes and let `F` be an `𝒪_X`-module. This
file proves [Stacks, Tag 0AVN]: a point of `S` outside the image of `f` is not weakly
associated to `f_* F`.

The source proves this by base changing to `Spec 𝒪_{S, s}`, which makes `s` a closed point, so
that the complement of `s` in the base is covered by the basic opens of the elements of the
maximal ideal; flat base change (Tag 02KH) then identifies the stalk of the pushforward after
the base change. Degree-zero flat base change itself *is* in Mathlib — it is
`AlgebraicGeometry.isIso_pushoutSection_of_isQuasiSeparated_of_flat_right`, instantiated at the
top open by `Stacks.AlgebraicGeometry.GlobalSectionsBaseChange.isPushout_appTop` — but its form
there needs the open of `X` to be quasi-separated as well as quasi-compact, which `QuasiCompact f`
alone does not give. So that ingredient is not usable at these hypotheses, and the argument below
avoids it: the reduction to a closed point is replaced by a direct commutative-algebra statement
about an affine chart.

Fix an affine open `V ∋ s` of `S`, write `A = Γ(S, V)` and let `p ⊆ A` be the prime of `s`. Let
`W ⊆ f⁻¹V` be an affine open of `X`, `B = Γ(X, W)`, and `φ : A → B` the induced map. Since `s`
is not in the image of `f`, no prime of `B` contracts to `p`, so `φ⁻¹(pB) ≠ p`
(`Ideal.comap_map_eq_self_iff_of_isPrime`); as `p ⊆ φ⁻¹(pB)` always, there is `t ∈ A \ p` with
`φ t ∈ pB`. This is `exists_notMem_map_primeIdealOf`, and it is the exact replacement for the
covering `X = ⋃_{a ∈ 𝔪} f⁻¹D(a)` of the source.

Writing `φ t = ∑ c i * φ (a i)` with `a i ∈ p`, weak association supplies for each `a i` an
exponent `N i` killing the germ over a neighbourhood of `s`, so `φ t` lies in the radical of
the ideal generated by the `φ (a i) ^ N i` and hence some power `φ t ^ M` lies in that ideal.
Thus `φ t ^ M` annihilates the germ of the section at every point of `W` over a suitable
neighbourhood of `s`. But `t` is invertible on the basic open `D(t) ∋ s`, so after shrinking
once more the germ itself vanishes. Quasi-compactness of `f⁻¹V` assembles these finitely many
neighbourhoods of `s` into one, which says that the germ in `(f_* F)_s` is zero.

Neither quasi-separatedness of `f` nor quasi-coherence of `F` is used.

## Main definitions

* `IsWeaklyAssociatedPoint`: a point is weakly associated to an `𝒪_X`-module when the maximal
  ideal of its local ring is weakly associated to the stalk. This is [Stacks, Tag 056L].
* `germF`: the germ at a point of a section of an `𝒪_X`-module.

## Main results

* `exists_notMem_map_primeIdealOf`: the commutative-algebra replacement for the source's
  covering by basic opens of the maximal ideal.
* `pushforwardGerm_eq_zero_of_notMem_range`: a germ of the pushforward annihilated by powers
  of every element of the prime of `s` vanishes.
* `not_isWeaklyAssociatedPoint_pushforward_of_not_mem_range`: [Stacks, Tag 0AVN].

## References

* [The Stacks Project, Lemma 31.2.4 (Tag 0AVN)](https://stacks.math.columbia.edu/tag/0AVN)
* [The Stacks Project, Definition 31.2.1 (Tag 056L)](https://stacks.math.columbia.edu/tag/056L)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace

universe u

namespace Stacks.AlgebraicGeometry.WeakAssPushforward

open Stacks.AlgebraicGeometry.PushforwardRegularity

/-- A point `x` is weakly associated to an `𝒪_X`-module `F` if the maximal ideal of `𝒪_{X,x}`
is weakly associated to the stalk `F_x`. -/
-- No stacks attribute for 056L: that tag is already formalized elsewhere, so this is a
-- duplicate of its definition rather than new content.
public def IsWeaklyAssociatedPoint {X : Scheme.{u}} (F : X.Modules) (x : X) : Prop :=
  IsWeaklyAssociatedPrime (X.presheaf.stalk x)
    (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x)
    (IsLocalRing.maximalIdeal (X.presheaf.stalk x))

variable {X S : Scheme.{u}} (f : X ⟶ S) (F : X.Modules)

/-- The germ at `y` of a section of an `𝒪_X`-module over an open containing `y`. -/
public noncomputable abbrev germF {U : X.Opens} (y : X) (hy : y ∈ U) (ξ : Γ(F, U)) :
    TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf y :=
  TopCat.Presheaf.germ F.val.presheaf U y hy ξ

/-- Pulling a section of `𝒪_S` back to a stalk of `X` respects powers. -/
public lemma stalkPullback_pow {V : S.Opens} (y : X) (hy : y ∈ f ⁻¹ᵁ V) (r : Γ(S, V)) (k : ℕ) :
    stalkPullback f V y hy (r ^ k) = stalkPullback f V y hy r ^ k :=
  (congrArg (fun z => X.presheaf.germ (f ⁻¹ᵁ V) y hy z)
      (map_pow (f.app V).hom r k)).trans
    (map_pow (X.presheaf.germ (f ⁻¹ᵁ V) y hy).hom _ k)

/-- The germ on an affine chart of a power of the pullback of a section of `𝒪_S` is the
pullback of that power to the stalk. -/
public lemma germ_appLE_pow {V : S.Opens} {W : X.Opens} (hW : W ≤ f ⁻¹ᵁ V) (r : Γ(S, V))
    (y : X) (hy : y ∈ W) (k : ℕ) :
    X.presheaf.germ W y hy ((f.appLE V W hW).hom r ^ k)
      = stalkPullback f V y (hW hy) (r ^ k) :=
  ((map_pow (X.presheaf.germ W y hy).hom _ k).trans
      (congrArg (· ^ k) (germ_appLE f hW r y hy))).trans
    (stalkPullback_pow f y (hW hy) r k).symm

section Prime

variable {s : S}

/-- The germ at a point of an affine open lies in the maximal ideal of the stalk exactly when
the section lies in the prime ideal of that point: the stalk is the localization of the
sections at that prime. -/
public lemma germ_mem_maximalIdeal_iff {V : S.Opens} (hV : IsAffineOpen V) (hsV : s ∈ V)
    (a : Γ(S, V)) :
    S.presheaf.germ V s hsV a ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk s) ↔
      a ∈ (hV.primeIdealOf ⟨s, hsV⟩).asIdeal := by
  let _inst : Algebra Γ(S, V) (S.presheaf.stalk s) :=
    S.presheaf.algebra_section_stalk (⟨s, hsV⟩ : V)
  have := hV.isLocalization_stalk (⟨s, hsV⟩ : V)
  exact IsLocalization.AtPrime.to_map_mem_maximal_iff (S.presheaf.stalk s)
    (hV.primeIdealOf ⟨s, hsV⟩).asIdeal a

/-- A section of an affine open which is outside the prime ideal of one of its points is
invertible at that point. -/
public lemma mem_basicOpen_of_notMem_primeIdealOf {V : S.Opens} (hV : IsAffineOpen V)
    (hsV : s ∈ V) (a : Γ(S, V)) (ha : a ∉ (hV.primeIdealOf ⟨s, hsV⟩).asIdeal) :
    s ∈ S.basicOpen a := by
  rw [S.mem_basicOpen a s hsV]
  by_contra h
  exact ha ((germ_mem_maximalIdeal_iff hV hsV a).mp
    ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h)))

/-- **The replacement for the base change to a local ring.** Let `s` be a point of an affine
open `V` of `S` which is not in the image of `f`, and let `W` be an affine open of `X` lying
over `V`. Then some section `t` of `𝒪_S` over `V` which is invertible at `s` pulls back into
the ideal of `Γ(X, W)` generated by the prime of `s`.

In the source this is the statement that finitely many basic opens `D(a)`, with `a` in the
maximal ideal, cover `X` after base change to `Spec 𝒪_{S, s}`. -/
public lemma exists_notMem_map_primeIdealOf (hrange : s ∉ Set.range f.base)
    {V : S.Opens} (hV : IsAffineOpen V) (hsV : s ∈ V)
    {W : X.Opens} (hW : IsAffineOpen W) (hWle : W ≤ f ⁻¹ᵁ V) :
    ∃ t : Γ(S, V), t ∉ (hV.primeIdealOf ⟨s, hsV⟩).asIdeal ∧
      (f.appLE V W hWle).hom t ∈
        Ideal.map (f.appLE V W hWle).hom (hV.primeIdealOf ⟨s, hsV⟩).asIdeal := by
  set φ := (f.appLE V W hWle).hom with hφ
  set p := (hV.primeIdealOf ⟨s, hsV⟩).asIdeal with hp
  have hpp : p.IsPrime := (hV.primeIdealOf ⟨s, hsV⟩).isPrime
  have hno : ¬ ∃ q : Ideal Γ(X, W), q.IsPrime ∧ q.comap φ = p := by
    rintro ⟨q, hq, hqp⟩
    have hsq : PrimeSpectrum.comap φ (⟨q, hq⟩ : PrimeSpectrum Γ(X, W))
        = hV.primeIdealOf ⟨s, hsV⟩ := PrimeSpectrum.ext hqp
    refine hrange ⟨hW.fromSpec (⟨q, hq⟩ : PrimeSpectrum Γ(X, W)), ?_⟩
    have hsquare : Spec.map (f.appLE V W hWle) ≫ hV.fromSpec = hW.fromSpec ≫ f :=
      IsAffineOpen.SpecMap_appLE_fromSpec f hV hW hWle
    have e := congrArg (fun g : Spec Γ(X, W) ⟶ S =>
      g (⟨q, hq⟩ : PrimeSpectrum Γ(X, W))) hsquare
    have h8 : hV.fromSpec (Spec.map (f.appLE V W hWle) (⟨q, hq⟩ : PrimeSpectrum Γ(X, W)))
        = f (hW.fromSpec (⟨q, hq⟩ : PrimeSpectrum Γ(X, W))) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans (e.trans (Scheme.Hom.comp_apply _ _ _))
    rw [← h8]
    change hV.fromSpec (PrimeSpectrum.comap φ (⟨q, hq⟩ : PrimeSpectrum Γ(X, W))) = s
    rw [hsq]
    exact hV.fromSpec_primeIdealOf ⟨s, hsV⟩
  by_contra hcon
  refine hno ?_
  refine (Ideal.comap_map_eq_self_iff_of_isPrime p).mp
    (le_antisymm (fun x hx => ?_) Ideal.le_comap_map)
  by_contra hxp
  exact hcon ⟨x, hxp, hx⟩

end Prime

/-- A point of an open `A` lying in each of finitely many opens lies in `A ⊓ ⨅ i, U i`. -/
private lemma mem_inf_iInf_of_forall {ι : Type*} [Finite ι] {A : X.Opens} {U : ι → X.Opens}
    {x : X} (hA : x ∈ A) (hU : ∀ i, x ∈ U i) : x ∈ A ⊓ ⨅ i, U i :=
  ⟨hA, by simpa only [SetLike.mem_coe, Opens.coe_iInf, Set.mem_iInter] using hU⟩

/-- **The local step.** Let `s ∉ range f` lie in an affine open `V`, and let `ξ` be a section
of `F` over `f⁻¹V` whose germ at every point over a suitable neighbourhood of `s` is killed by
a power of each element of the prime of `s`. Then around every point of `f⁻¹V` there is an open
`W` and a neighbourhood `V'` of `s` on which `ξ` has vanishing germs over `V'`. -/
public lemma exists_nbhd_germF_eq_zero_aux {s : S} (hrange : s ∉ Set.range f.base)
    {V : S.Opens} (hV : IsAffineOpen V) (hsV : s ∈ V) (ξ : Γ(F, f ⁻¹ᵁ V))
    (H : ∀ a : Γ(S, V), a ∈ (hV.primeIdealOf ⟨s, hsV⟩).asIdeal →
      ∃ (n : ℕ) (V' : S.Opens) (_ : s ∈ V'), ∀ (y : X) (hy : y ∈ f ⁻¹ᵁ V),
        f.base y ∈ V' → stalkPullback f V y hy (a ^ n) • germF F y hy ξ = 0)
    {y : X} (hy : y ∈ f ⁻¹ᵁ V) :
    ∃ (W : X.Opens) (_ : y ∈ W) (hWle : W ≤ f ⁻¹ᵁ V) (V' : S.Opens) (_ : s ∈ V'),
      ∀ (y' : X) (hy' : y' ∈ W), f.base y' ∈ V' → germF F y' (hWle hy') ξ = 0 := by
  obtain ⟨_, ⟨W, hW, rfl⟩, hyW, hWsub⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hy (f ⁻¹ᵁ V).isOpen
  have hWle : W ≤ f ⁻¹ᵁ V := hWsub
  obtain ⟨t, htp, htmem⟩ := exists_notMem_map_primeIdealOf f hrange hV hsV hW hWle
  -- Write the pullback of `t` as a finite combination of pullbacks of elements of the prime.
  obtain ⟨n, c, g, hsum⟩ := Submodule.mem_span_set'.mp htmem
  choose a hap hga using fun i : Fin n => (g i).2
  choose N V' hsV' hann using fun i : Fin n => H (a i) (hap i)
  -- A power of the pullback of `t` lies in the ideal generated by the relevant powers.
  obtain ⟨M, hM⟩ : ∃ M : ℕ, (f.appLE V W hWle).hom t ^ M ∈
      Ideal.span (Set.range fun i : Fin n => (f.appLE V W hWle).hom (a i) ^ N i) := by
    refine Ideal.mem_radical_iff.mp ?_
    have hrep : ∑ i, c i * (f.appLE V W hWle).hom (a i) = (f.appLE V W hWle).hom t := by
      rw [← hsum]
      exact Finset.sum_congr rfl fun i _ => by rw [hga i, smul_eq_mul]
    rw [← hrep]
    refine Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ ?_
    exact Ideal.mem_radical_iff.mpr ⟨N i, Ideal.subset_span ⟨i, rfl⟩⟩
  obtain ⟨d, hd⟩ := (Submodule.mem_span_range_iff_exists_fun Γ(X, W)).mp hM
  refine ⟨W, hyW, hWle, S.basicOpen t ⊓ ⨅ i, V' i,
    mem_inf_iInf_of_forall (mem_basicOpen_of_notMem_primeIdealOf hV hsV t htp) hsV', ?_⟩
  intro y' hy'W hy'V
  -- The pullback of `t` is invertible in the stalk at `y'`.
  have hunit : IsUnit (stalkPullback f V y' (hWle hy'W) t) := by
    have hb : y' ∈ X.basicOpen (f.app V t) := by
      rw [← Scheme.preimage_basicOpen]
      exact hy'V.1
    exact (X.mem_basicOpen (f.app V t) y' (hWle hy'W)).mp hb
  -- Each relevant power of a pullback annihilates the germ.
  have hzero : ∀ i : Fin n,
      X.presheaf.germ W y' hy'W ((f.appLE V W hWle).hom (a i) ^ N i)
        • germF F y' (hWle hy'W) ξ = 0 := by
    intro i
    have h4 : f.base y' ∈ V' i :=
      (show S.basicOpen t ⊓ ⨅ j, V' j ≤ V' i from inf_le_right.trans (iInf_le _ i)) hy'V
    rw [germ_appLE_pow f hWle (a i) y' hy'W (N i)]
    exact hann i y' (hWle hy'W) h4
  -- Hence so does the corresponding power of the pullback of `t`.
  have hkey : X.presheaf.germ W y' hy'W ((f.appLE V W hWle).hom t ^ M)
      • germF F y' (hWle hy'W) ξ = 0 := by
    rw [← hd, show X.presheaf.germ W y' hy'W
          (∑ i, d i • ((f.appLE V W hWle).hom (a i) ^ N i))
        = ∑ i, X.presheaf.germ W y' hy'W (d i • ((f.appLE V W hWle).hom (a i) ^ N i)) from
      map_sum (X.presheaf.germ W y' hy'W).hom _ Finset.univ, Finset.sum_smul]
    refine Finset.sum_eq_zero fun i _ => ?_
    rw [show X.presheaf.germ W y' hy'W (d i • ((f.appLE V W hWle).hom (a i) ^ N i))
        = X.presheaf.germ W y' hy'W (d i) *
            X.presheaf.germ W y' hy'W ((f.appLE V W hWle).hom (a i) ^ N i) from
      map_mul (X.presheaf.germ W y' hy'W).hom _ _, mul_smul, hzero i, smul_zero]
  -- The invertibility of `t` now forces the germ itself to vanish.
  rw [germ_appLE_pow f hWle t y' hy'W M, stalkPullback_pow f y' (hWle hy'W) t M] at hkey
  exact (hunit.pow M).smul_eq_zero.mp hkey

/-- **The quasi-compact assembly.** Under the hypotheses of `exists_nbhd_germF_eq_zero_aux`,
if `f` is quasi-compact then the germ of `ξ` in the stalk of `f_* F` at `s` vanishes. -/
public lemma pushforwardGerm_eq_zero_of_notMem_range [QuasiCompact f] {s : S}
    (hrange : s ∉ Set.range f.base)
    {V : S.Opens} (hV : IsAffineOpen V) (hsV : s ∈ V) (ξ : Γ(F, f ⁻¹ᵁ V))
    (H : ∀ a : Γ(S, V), a ∈ (hV.primeIdealOf ⟨s, hsV⟩).asIdeal →
      ∃ (n : ℕ) (V' : S.Opens) (_ : s ∈ V'), ∀ (y : X) (hy : y ∈ f ⁻¹ᵁ V),
        f.base y ∈ V' → stalkPullback f V y hy (a ^ n) • germF F y hy ξ = 0) :
    pushforwardGerm f F s V hsV ξ = 0 := by
  choose W hyW hWle V' hsV' hgerm using
    fun (y : (f ⁻¹ᵁ V : X.Opens)) => exists_nbhd_germF_eq_zero_aux f F hrange hV hsV ξ H y.2
  obtain ⟨T, hT⟩ := (f.isCompact_preimage hV.isCompact).elim_finite_subcover
    (fun y : (f ⁻¹ᵁ V : X.Opens) => (W y : Set X)) (fun y => (W y).isOpen)
    fun z hz => Set.mem_iUnion.mpr ⟨⟨z, hz⟩, hyW ⟨z, hz⟩⟩
  have hsV₀ : s ∈ V ⊓ ⨅ i : {x : (f ⁻¹ᵁ V : X.Opens) // x ∈ T}, V' i.1 :=
    mem_inf_iInf_of_forall hsV fun i => hsV' i.1
  have hV₀V : (V ⊓ ⨅ i : {x : (f ⁻¹ᵁ V : X.Opens) // x ∈ T}, V' i.1) ≤ V := inf_le_left
  have hpre : f ⁻¹ᵁ (V ⊓ ⨅ i : {x : (f ⁻¹ᵁ V : X.Opens) // x ∈ T}, V' i.1) ≤ f ⁻¹ᵁ V :=
    fun _ h => hV₀V h
  have hres : F.val.map (homOfLE hpre).op ξ = 0 := by
    refine section_ext_F F _ _ fun z hzV₀ => ?_
    refine Eq.trans (germ_resF F hpre ξ z hzV₀) ?_
    refine Eq.trans ?_ (germF_zero F z hzV₀).symm
    obtain ⟨i, hi, hzi⟩ := Set.mem_iUnion₂.mp (hT (hpre hzV₀))
    have hle : (V ⊓ ⨅ i : {x : (f ⁻¹ᵁ V : X.Opens) // x ∈ T}, V' i.1) ≤ V' i :=
      inf_le_right.trans
        (iInf_le (fun i : {x : (f ⁻¹ᵁ V : X.Opens) // x ∈ T} => V' i.1) ⟨i, hi⟩)
    exact hgerm i z hzi (hle hzV₀)
  rw [← pushforwardGerm_res f F s hV₀V hsV₀ hpre ξ, hres]
  exact pushforwardGerm_zero f F s _ hsV₀

/-- **Stacks Project, Tag 0AVN.** A point outside the image of a quasi-compact,
quasi-separated morphism is not weakly associated to the pushforward of a quasi-coherent
module.

Neither quasi-separatedness nor quasi-coherence is used in the proof. -/
@[stacks 0AVN]
public theorem not_isWeaklyAssociatedPoint_pushforward_of_not_mem_range
    {X S : Scheme.{u}} (f : X ⟶ S) [QuasiCompact f] [QuasiSeparated f]
    (F : X.Modules) [F.IsQuasicoherent] (s : S) (hs : s ∉ Set.range f) :
    ¬ IsWeaklyAssociatedPoint ((Scheme.Modules.pushforward f).obj F) s := by
  rintro ⟨x, hmin⟩
  -- The element witnessing weak association is nonzero.
  have hx0 : x ≠ 0 := by
    rintro rfl
    refine hmin.1.1.ne_top (top_le_iff.mp (le_trans (le_of_eq ?_) hmin.1.2))
    exact (Submodule.annihilator_eq_top_iff.mpr (Submodule.span_zero_singleton _)).symm
  -- The maximal ideal is the only prime over the annihilator, so every element of it has a
  -- power annihilating `x`.
  have hpow : ∀ α ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk s), ∃ k : ℕ, α ^ k • x = 0 := by
    intro α hα
    have hrad : α ∈ (Submodule.span (S.presheaf.stalk s) {x}).annihilator.radical := by
      rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
      intro q hq
      exact hmin.2 ⟨hq.2, hq.1⟩ (IsLocalRing.le_maximalIdeal hq.2.ne_top) hα
    obtain ⟨k, hk⟩ := Ideal.mem_radical_iff.mp hrad
    exact ⟨k, (Submodule.mem_annihilator_span_singleton _ _).mp hk⟩
  -- Represent `x` as the germ of a section over the preimage of an affine open.
  obtain ⟨V, hV, hsV, ξ, hξ⟩ := exists_pushforwardGerm_eq f F s x
  refine hx0 ?_
  rw [← hξ]
  refine pushforwardGerm_eq_zero_of_notMem_range f F hs hV hsV ξ fun a ha => ?_
  -- Transport the annihilation statement to germs on the source.
  obtain ⟨k, hk⟩ := hpow (S.presheaf.germ V s hsV a)
    ((germ_mem_maximalIdeal_iff hV hsV a).mpr ha)
  have hk' : pushforwardGerm f F s V hsV ((f.app V (a ^ k)) • ξ) = 0 := by
    rw [pushforwardGerm_smul f F s V hsV (a ^ k) ξ, hξ, map_pow]
    exact hk
  obtain ⟨V₁, hsV₁, i₁, i₂, he⟩ := TopCat.Presheaf.germ_eq
    ((Scheme.Modules.pushforward f).obj F).val.presheaf s hsV hsV ((f.app V (a ^ k)) • ξ) 0
    (hk'.trans (pushforwardGerm_zero f F s V hsV).symm)
  have hpre : f ⁻¹ᵁ V₁ ≤ f ⁻¹ᵁ V := fun _ h => i₁.le h
  have hres : F.val.map (homOfLE hpre).op ((f.app V (a ^ k)) • ξ) = 0 :=
    he.trans (resF_zero F (show f ⁻¹ᵁ V₁ ≤ f ⁻¹ᵁ V from fun _ h => i₂.le h))
  refine ⟨k, V₁, hsV₁, fun z hz hzV₁ => ?_⟩
  have hzpre : z ∈ f ⁻¹ᵁ V₁ := hzV₁
  have h1 : germF F z hz ((f.app V (a ^ k)) • ξ) = 0 :=
    (germ_resF F hpre ((f.app V (a ^ k)) • ξ) z hzpre).symm.trans
      ((congrArg (fun w => germF F z hzpre w) hres).trans (germF_zero F z hzpre))
  have h2 : germF F z hz ((f.app V (a ^ k)) • ξ)
      = stalkPullback f V z hz (a ^ k) • germF F z hz ξ := by
    have h3 := germ_smul_appLE f F (le_refl (f ⁻¹ᵁ V)) (a ^ k) ξ z hz
    rwa [f.appLE_eq_app (U := V)] at h3
  rw [← h2]
  exact h1

end Stacks.AlgebraicGeometry.WeakAssPushforward

end
