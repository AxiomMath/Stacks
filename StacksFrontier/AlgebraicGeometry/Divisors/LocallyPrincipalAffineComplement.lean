module

public import Mathlib.AlgebraicGeometry.Morphisms.Affine
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartier
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The complement of a locally principal closed subscheme is affine over the base

Let `S` be a scheme and let `Z ⊆ S` be a locally principal closed subscheme, cut out by an ideal
sheaf `I` with `Stacks.Divisors.IsLocallyPrincipal I`. Writing `U = S \ Z` for the open
complement of the support of `I`, the inclusion `U ⟶ S` is an affine morphism, and therefore
quasi-compact: `U` is retrocompact in `S`.

The argument is the one of Stacks tag 07ZT. Affineness of a morphism may be checked on an open
neighbourhood of every point of the target
(`AlgebraicGeometry.isAffineHom_of_forall_exists_isAffineOpen`), and around a point `s` we may
take an affine open `V` on which `I` is generated by a single section `a`. On such a `V` the
support of `I` meets `V` in the zero locus of `a`, so `U ⊓ V` is the basic open `D(a)`, which is
affine. Since `D(a) ≤ U`, the preimage of `V` under `U ⟶ S` is affine by
`AlgebraicGeometry.IsAffineOpen.preimage_of_isOpenImmersion`.

## Main results

* `Stacks.Divisors.inf_eq_basicOpen_of_support_inter_eq` and
  `Stacks.Divisors.inf_eq_basicOpen_of_ideal_eq_span`: on an affine open where the support of the
  ideal sheaf is the zero locus of one section `a` — in particular where the ideal sheaf is
  generated by `a` — the complement of that support meets the open in `D(a)`.
* `Stacks.Divisors.isAffineHom_ι_compl_support_of_isLocallyPrincipal`: **Stacks Project, Tag
  07ZT.** The inclusion of the complement of a locally principal closed subscheme is an affine
  morphism. `Stacks.Divisors.isAffineHom_ι_of_isLocallyPrincipal` is the same statement for an
  arbitrary open presenting that complement, and
  `Stacks.Divisors.isAffineHom_ι_of_forall_support_inter_eq` strengthens both by asking only
  that the support be locally the zero locus of a single section.
* `Stacks.Divisors.quasiCompact_ι_of_isLocallyPrincipal` and
  `Stacks.Divisors.isRetrocompact_of_isLocallyPrincipal`: the two standard reformulations, the
  second in the shape Stacks tag 07ZP takes its hypothesis in.

## Implementation notes

The open complement is taken as a hypothesis `(W : Set X) = (I.support : Set X)ᶜ` rather than as
the literal `I.support.compl`, because the consumers of this lemma — for instance
`Stacks.Blowup.exceptionalPullbackCompl` — build their open by hand from a complement of a
preimage, and such an open is equal to `I.support.compl` only after rewriting with
`AlgebraicGeometry.Scheme.IdealSheafData.support_comap`. Carrying the equation makes the lemma
applicable without that rewriting at the level of `TopologicalSpace.Opens`.

Local principality is used only through the single affine open it produces at each point, so the
conclusion holds verbatim for the two extreme ideal sheaves, whose local principality is
`Stacks.Divisors.isLocallyPrincipal_bot` and `Stacks.Divisors.isLocallyPrincipal_top`: there `W`
is forced to be the empty open and the whole space respectively, the two degenerate readings of
the statement.

## References

* [Stacks Project, Tag 07ZT](https://stacks.math.columbia.edu/tag/07ZT)
* [Stacks Project, Tag 01WR](https://stacks.math.columbia.edu/tag/01WR)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.Divisors

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- On an affine open `V` meeting the support of the ideal sheaf `I` in the zero locus of a
single section `a`, the open complement `W` of that support meets `V` exactly in the basic open
`D(a)`. Only the support of `I` enters, so the hypothesis is weaker than principality of
`I.ideal V`: it holds whenever `I.ideal V` and `Ideal.span {a}` have the same radical. -/
theorem inf_eq_basicOpen_of_support_inter_eq {V : X.affineOpens} {a : Γ(X, V.1)}
    (ha : (I.support : Set X) ∩ (V.1 : Set X) = X.zeroLocus {a} ∩ (V.1 : Set X))
    {W : X.Opens} (hW : (W : Set X) = (I.support : Set X)ᶜ) :
    W ⊓ V.1 = X.basicOpen a := by
  have h1 : (I.support : Set X) ∩ (V.1 : Set X) =
      ((X.basicOpen a : Set X)ᶜ) ∩ (V.1 : Set X) := by
    rw [ha, Scheme.zeroLocus_singleton]
  have hle : (X.basicOpen a : Set X) ⊆ (V.1 : Set X) := X.basicOpen_le a
  refine Opens.ext (Set.ext fun x => ?_)
  simp only [Opens.coe_inf, Set.mem_inter_iff, hW, Set.mem_compl_iff]
  constructor
  · rintro ⟨hx, hxV⟩
    by_contra hxa
    exact hx (h1.ge ⟨hxa, hxV⟩).1
  · intro hxa
    exact ⟨fun hx => (h1.le ⟨hx, hle hxa⟩).1 hxa, hle hxa⟩

/-- On an affine open `V` on which the ideal sheaf `I` is generated by a single section `a`, the
open complement `W` of the support of `I` meets `V` exactly in the basic open `D(a)`: a point of
`V` lies in the support of `I` precisely when it lies in the zero locus of `I.ideal V`, which for
a principal ideal is the complement of `D(a)`. -/
theorem inf_eq_basicOpen_of_ideal_eq_span {V : X.affineOpens} {a : Γ(X, V.1)}
    (ha : I.ideal V = Ideal.span {a}) {W : X.Opens} (hW : (W : Set X) = (I.support : Set X)ᶜ) :
    W ⊓ V.1 = X.basicOpen a :=
  inf_eq_basicOpen_of_support_inter_eq I
    (by rw [I.coe_support_inter V, ha, Scheme.zeroLocus_span]) hW

/-- **Stacks Project, Tag 07ZT.** Support-only form: if every point of `X` has an affine open
neighbourhood `V` on which the support of the ideal sheaf `I` is the zero locus of a single
section `a`, then the inclusion into `X` of any open `W` presenting the complement of that
support is an affine morphism. The hypothesis asks nothing about the ideal `I.ideal V` beyond
its radical, so it applies to ideal sheaves that are only locally principal up to radicals. -/
@[stacks 07ZT "the complement is affine over the base already when the support is locally a
zero locus of one section"]
theorem isAffineHom_ι_of_forall_support_inter_eq
    (hI : ∀ x : X, ∃ (V : X.affineOpens) (_ : x ∈ (V.1 : Set X)) (a : Γ(X, V.1)),
      (I.support : Set X) ∩ (V.1 : Set X) = X.zeroLocus {a} ∩ (V.1 : Set X))
    {W : X.Opens} (hW : (W : Set X) = (I.support : Set X)ᶜ) :
    IsAffineHom (Scheme.Opens.ι W) := by
  refine isAffineHom_of_forall_exists_isAffineOpen _ fun x => ?_
  obtain ⟨V, hxV, a, ha⟩ := hI x
  refine ⟨V.1, hxV, V.2, ?_⟩
  have hA : IsAffineOpen (W ⊓ V.1) :=
    inf_eq_basicOpen_of_support_inter_eq I ha hW ▸ V.2.basicOpen a
  have heq : Scheme.Opens.ι W ⁻¹ᵁ (W ⊓ V.1) = Scheme.Opens.ι W ⁻¹ᵁ V.1 := by
    rw [Scheme.Hom.preimage_inf, Scheme.Opens.ι_preimage_self, top_inf_eq]
  exact heq ▸ hA.preimage_of_isOpenImmersion W.ι (by simp)

/-- Let `Z ⊆ X` be a locally principal closed subscheme, cut out by the ideal sheaf `I`, and let
`W` be any open whose underlying set is the complement of the support of `I`. Then the inclusion
`W ⟶ X` is an affine morphism. This is Stacks tag 07ZT, stated for an arbitrary presentation of
the complement; see `Stacks.Divisors.isAffineHom_ι_compl_support_of_isLocallyPrincipal` for the
statement with `W` the canonical complement.

A principal ideal `Ideal.span {a}` has zero locus `D(a)ᶜ`, so this is a special case of
`Stacks.Divisors.isAffineHom_ι_of_forall_support_inter_eq`. -/
theorem isAffineHom_ι_of_isLocallyPrincipal (hI : IsLocallyPrincipal I) {W : X.Opens}
    (hW : (W : Set X) = (I.support : Set X)ᶜ) : IsAffineHom (Scheme.Opens.ι W) :=
  isAffineHom_ι_of_forall_support_inter_eq I
    (fun x => by
      obtain ⟨V, hxV, a, ha⟩ := hI x
      exact ⟨V, hxV, a, by rw [I.coe_support_inter V, ha, Scheme.zeroLocus_span]⟩) hW

/-- **Stacks Project, Tag 07ZT.** Let `X` be a scheme and let `Z ⊆ X` be a locally principal
closed subscheme, cut out by the ideal sheaf `I`. Then the inclusion of the open complement
`X \ Z` into `X` is an affine morphism. -/
@[stacks 07ZT]
theorem isAffineHom_ι_compl_support_of_isLocallyPrincipal (hI : IsLocallyPrincipal I) :
    IsAffineHom (Scheme.Opens.ι I.support.compl) :=
  isAffineHom_ι_of_isLocallyPrincipal I hI rfl

/-- The inclusion of the complement of a locally principal closed subscheme is quasi-compact,
being an affine morphism. -/
theorem quasiCompact_ι_of_isLocallyPrincipal (hI : IsLocallyPrincipal I) {W : X.Opens}
    (hW : (W : Set X) = (I.support : Set X)ᶜ) : QuasiCompact (Scheme.Opens.ι W) :=
  have := isAffineHom_ι_of_isLocallyPrincipal I hI hW
  inferInstance

/-- The complement of a locally principal closed subscheme is retrocompact. This is the shape in
which Stacks tag 07ZP takes its hypothesis, so it is what the quasi-coherence results about
sections supported on a closed subset consume. -/
@[ega "IV 1.9.5" "(v), special case"]
theorem isRetrocompact_of_isLocallyPrincipal (hI : IsLocallyPrincipal I) {W : X.Opens}
    (hW : (W : Set X) = (I.support : Set X)ᶜ) : IsRetrocompact (W : Set X) :=
  have := quasiCompact_ι_of_isLocallyPrincipal I hI hW
  IsRetrocompact_iff_isSpectralMap_subtypeVal.mpr
    (quasiCompact_iff_isSpectralMap.mp ‹QuasiCompact (Scheme.Opens.ι W)›)

end Stacks.Divisors

end
