open CategoryTheory IsLocalRing

open scoped TensorProduct

universe u m

/-! ### Weak association of the maximal ideal under a local base change -/

/-- For a flat local homomorphism of local rings whose extension of the maximal ideal has the
maximal ideal as its radical, weak association of the maximal ideal passes to the base
change. -/
theorem isWeaklyAssociatedPrime_maximalIdeal_tensorProduct_of_flat_of_radical_eq
    {R A M : Type*} [CommRing R] [IsLocalRing R] [CommRing A] [IsLocalRing A] [Algebra R A]
    [Module.Flat R A] [AddCommGroup M] [Module R M]
    (hrad : (Ideal.map (algebraMap R A) (maximalIdeal R)).radical = maximalIdeal A)
    (h : IsWeaklyAssociatedPrime R M (maximalIdeal R)) :
    IsWeaklyAssociatedPrime A (A ⊗[R] M) (maximalIdeal A) := by
  change WeaklyAssociated (maximalIdeal R) M at h
  obtain ⟨t, ht⟩ :=
    (weaklyAssociated_maximalIdeal_iff_exists_radical_eq (S := R) (N := M)).mp h
  have htor : (Ideal.torsionOf R M t).radical = maximalIdeal R := by
    simpa [annihilatorOfElem_semiring, Ideal.annihilator_span_singleton_eq_torsionOf] using ht
  change WeaklyAssociated (maximalIdeal A) (A ⊗[R] M)
  refine (weaklyAssociated_maximalIdeal_iff_exists_radical_eq
    (S := A) (N := A ⊗[R] M)).mpr ⟨(1 : A) ⊗ₜ[R] t, ?_⟩
  rw [annihilatorOfElem_semiring, Ideal.annihilator_span_singleton_eq_torsionOf,
    ← ann_extension_eq_ann_baseChange_elem]
  refine le_antisymm ?_ ?_
  · calc (Ideal.map (algebraMap R A) (Ideal.torsionOf R M t)).radical
        ≤ (Ideal.map (algebraMap R A) (maximalIdeal R)).radical :=
          Ideal.radical_mono (Ideal.map_mono
            ((Ideal.le_radical : Ideal.torsionOf R M t ≤ _).trans htor.le))
      _ = maximalIdeal A := hrad
  · calc maximalIdeal A = (Ideal.map (algebraMap R A) (maximalIdeal R)).radical := hrad.symm
      _ = (Ideal.map (algebraMap R A) (Ideal.torsionOf R M t).radical).radical := by rw [htor]
      _ ≤ ((Ideal.map (algebraMap R A) (Ideal.torsionOf R M t)).radical).radical :=
          Ideal.radical_mono (Ideal.map_radical_le _)
      _ = (Ideal.map (algebraMap R A) (Ideal.torsionOf R M t)).radical := Ideal.radical_idem _

/-- Weak association of a prime is transported along a linear equivalence of modules. -/
private theorem isWeaklyAssociatedPrime_map_linearEquiv {R M N : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] (e : M ≃ₗ[R] N) {p : Ideal R}
    (h : IsWeaklyAssociatedPrime R M p) : IsWeaklyAssociatedPrime R N p :=
  Module.weaklyAssociatedPrimes_subset_of_injective (f := e.toLinearMap) e.injective h

/-- For a finite flat algebra `A` over `R`, a prime weakly associated to `A ⊗[R] M` is weakly
associated to `M`: after localising at the prime, `A` becomes free, and weak association
descends through a tensor product with a free module. -/
@[ega "IV 3.3.8" "special case"]
theorem isWeaklyAssociatedPrime_of_tensorProduct_of_finite_flat
    {R A M : Type*} [CommRing R] [CommRing A] [Algebra R A] [AddCommGroup M] [Module R M]
    [Module.Finite R A] [Module.Flat R A] {p : Ideal R} [p.IsPrime]
    (h : IsWeaklyAssociatedPrime R (A ⊗[R] M) p) : IsWeaklyAssociatedPrime R M p := by
  let L := Localization.AtPrime p
  let T := p.primeCompl
  have : Module.Free L (LocalizedModule T A) := Module.free_of_flat_of_isLocalRing
  have hloc := (weaklyAssociated_iff_localization p).mp h
  let e₀ : LocalizedModule T (A ⊗[R] M) ≃ₗ[L] L ⊗[R] (A ⊗[R] M) :=
    LocalizedModule.equivTensorProduct T (A ⊗[R] M)
  let e₁ : L ⊗[R] (A ⊗[R] M) ≃ₗ[L] (L ⊗[R] A) ⊗[L] (L ⊗[R] M) :=
    TensorProduct.AlgebraTensorModule.distribBaseChange R L A M
  let eA : LocalizedModule T A ≃ₗ[L] L ⊗[R] A := LocalizedModule.equivTensorProduct T A
  let eM : LocalizedModule T M ≃ₗ[L] L ⊗[R] M := LocalizedModule.equivTensorProduct T M
  let e : LocalizedModule T (A ⊗[R] M) ≃ₗ[L]
      LocalizedModule T A ⊗[L] LocalizedModule T M :=
    e₀.trans (e₁.trans (TensorProduct.congr eA.symm eM.symm))
  have hlocal : IsWeaklyAssociatedPrime L
      (LocalizedModule T A ⊗[L] LocalizedModule T M) (maximalIdeal L) := by
    have hloc' : IsWeaklyAssociatedPrime L (LocalizedModule T (A ⊗[R] M)) (maximalIdeal L) := by
      obtain ⟨z, hz⟩ := hloc
      refine ⟨z, ?_⟩
      have heq : annihilatorOfElem_semiring (R := L) z = (L ∙ z).annihilator := rfl
      rw [← heq]
      exact hz
    exact isWeaklyAssociatedPrime_map_linearEquiv e hloc'
  exact (weaklyAssociated_iff_localization p).mpr
    (IsWeaklyAssociatedPrime.of_tensorProduct_free (R := L) (M := LocalizedModule T M)
      (P := LocalizedModule T A) hlocal)

/-- **For a finite flat local homomorphism of local rings**, the maximal ideal of the source is
weakly associated to a module exactly when the maximal ideal of the target is weakly
associated to the base change of that module. -/
theorem isWeaklyAssociatedPrime_maximalIdeal_tensorProduct_iff_of_finite_flat
    {R A M : Type*} [CommRing R] [IsLocalRing R] [CommRing A] [IsLocalRing A] [Algebra R A]
    [Module.Finite R A] [Module.Flat R A] [IsLocalHom (algebraMap R A)]
    [AddCommGroup M] [Module R M] :
    IsWeaklyAssociatedPrime R M (maximalIdeal R) ↔
      IsWeaklyAssociatedPrime A (A ⊗[R] M) (maximalIdeal A) := by
  have : Module.FaithfullyFlat R A := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hinj : Function.Injective (TensorProduct.mk R A M 1) :=
    Module.FaithfullyFlat.tensorProduct_mk_injective (A := R) (B := A) M
  have hcomap : Ideal.comap (algebraMap R A) (maximalIdeal A) = maximalIdeal R :=
    IsLocalRing.maximalIdeal_comap (algebraMap R A)
  have : Algebra.IsIntegral R A := Algebra.IsIntegral.of_finite R A
  constructor
  · intro hM
    have hN : IsWeaklyAssociatedPrime R (A ⊗[R] M) (maximalIdeal R) :=
      Module.weaklyAssociatedPrimes_subset_of_injective
        (f := TensorProduct.mk R A M 1) hinj hM
    obtain ⟨q, hq, hqp⟩ := weakAss_subset_comap_image_weakAss
      (R := R) (S := A) (M := A ⊗[R] M) (maximalIdeal R) hN
    have : q.IsPrime := hq.isPrime
    have hqmax : q.IsMaximal :=
      Ideal.isMaximal_of_isIntegral_of_isMaximal_under (R := R) q
        (show (Ideal.comap (algebraMap R A) q).IsMaximal from
          hqp ▸ IsLocalRing.maximalIdeal.isMaximal R)
    exact (IsLocalRing.eq_maximalIdeal hqmax) ▸ hq
  · intro hN
    have hN' : IsWeaklyAssociatedPrime R (A ⊗[R] M) (maximalIdeal R) := by
      simpa only [hcomap] using
        comap_isWeaklyAssociatedPrime_of_finite (R := R) (S := A) (M := A ⊗[R] M)
          inferInstance (maximalIdeal A) hN
    exact isWeaklyAssociatedPrime_of_tensorProduct_of_finite_flat
      (R := R) (A := A) (M := M) hN'

namespace AlgebraicGeometry.Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {X Y : AlgebraicSpaces B S hS}

/-- The base-change form, at a free module universe, of the equivalence tagged below. Let
`f : X ⟶ Y` be a flat morphism of algebraic spaces whose canonical homomorphism of étale local
rings at a geometric point `x̄` is finite. Then the maximal ideal of `𝒪_{Y, ȳ}` is weakly
associated to the geometric stalk `G_{ȳ}` exactly when the maximal ideal of `𝒪_{X, x̄}` is
weakly associated to the base change `𝒪_{X, x̄} ⊗_{𝒪_{Y, ȳ}} G_{ȳ}`.

At the module universe of the structure rings that base change is the geometric stalk of
`f^*G`, and the statement in those terms is
`AlgebraicGeometry.Space.isWeaklyAssociatedPrime_geometricModuleStalk_modulePullback_iff`,
which is where Stacks 0CUT is registered. -/
theorem isWeaklyAssociatedPrime_geometricModuleStalk_baseChange_iff (f : X ⟶ Y)
    (hflat : IsFlat B S hS f.hom) (xbar : GeometricPoint B S hS X.1)
    (hfinite : (etaleLocalRingMap X.2 f.hom xbar).Finite)
    (G : Modules.{u, m} B S hS Y.1 Y.2) :
    letI : IsLocalRing (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar)) :=
      isLocalRing_etaleLocalRing B S hS Y.1 Y.2 (geometricPointMap f.hom xbar)
    letI : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
      isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
    letI : Algebra (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
        (etaleLocalRing B S hS X.1 xbar) := (etaleLocalRingMap X.2 f.hom xbar).toAlgebra
    letI : Module (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
        (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G) :=
      (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G).isModule
    (IsWeaklyAssociatedPrime (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
          (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G)
          (maximalIdeal (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))) ↔
      IsWeaklyAssociatedPrime (etaleLocalRing B S hS X.1 xbar)
        (etaleLocalRing B S hS X.1 xbar ⊗[etaleLocalRing B S hS Y.1
            (geometricPointMap f.hom xbar)]
          geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G)
        (maximalIdeal (etaleLocalRing B S hS X.1 xbar))) := by
  let : IsLocalRing (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar)) :=
    isLocalRing_etaleLocalRing B S hS Y.1 Y.2 (geometricPointMap f.hom xbar)
  let : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
    isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
  let : Algebra (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
      (etaleLocalRing B S hS X.1 xbar) := (etaleLocalRingMap X.2 f.hom xbar).toAlgebra
  let : Module (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
      (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G) :=
    (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G).isModule
  have : Module.Finite (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
      (etaleLocalRing B S hS X.1 xbar) := hfinite
  have : Module.Flat (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
      (etaleLocalRing B S hS X.1 xbar) :=
    flat_etaleLocalRingMap B S hS X.2 Y.2 f.hom hflat xbar
  have : IsLocalHom (algebraMap (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
      (etaleLocalRing B S hS X.1 xbar)) :=
    isLocalHom_etaleLocalRingMap B S hS X.2 Y.2 f.hom xbar
  exact isWeaklyAssociatedPrime_maximalIdeal_tensorProduct_iff_of_finite_flat

/-- **Stacks 0CUT** at the étale local ring, for the geometric stalk of the pullback module.
Let `f : X ⟶ Y` be a finite flat morphism of algebraic spaces and let `x̄` be a geometric point
of `X` with image `ȳ`. Then the maximal ideal of `𝒪_{Y, ȳ}` is weakly associated to the
geometric stalk `G_{ȳ}` exactly when the maximal ideal of `𝒪_{X, x̄}` is weakly associated to
the geometric stalk `(f^*G)_{x̄}` of the pullback module. -/
@[stacks 0CUT "at the étale local ring, for the geometric stalk of the pullback module"]
theorem isWeaklyAssociatedPrime_geometricModuleStalk_modulePullback_iff (f : X ⟶ Y)
    (hfinite : IsFinite B S hS f.hom) (hflat : IsFlat B S hS f.hom)
    (xbar : GeometricPoint B S hS X.1)
    (G : Modules.{u, u} B S hS Y.1 Y.2) :
    letI : IsLocalRing (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar)) :=
      isLocalRing_etaleLocalRing B S hS Y.1 Y.2 (geometricPointMap f.hom xbar)
    letI : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
      isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
    letI : Module (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
        (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G) :=
      (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G).isModule
    letI : Module (etaleLocalRing B S hS X.1 xbar)
        (geometricModuleStalk B S hS X xbar ((modulePullback B S hS f).obj G)) :=
      (geometricModuleStalk B S hS X xbar ((modulePullback B S hS f).obj G)).isModule
    (IsWeaklyAssociatedPrime (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
          (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G)
          (maximalIdeal (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))) ↔
      IsWeaklyAssociatedPrime (etaleLocalRing B S hS X.1 xbar)
        (geometricModuleStalk B S hS X xbar ((modulePullback B S hS f).obj G))
        (maximalIdeal (etaleLocalRing B S hS X.1 xbar))) := by
  let : IsLocalRing (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar)) :=
    isLocalRing_etaleLocalRing B S hS Y.1 Y.2 (geometricPointMap f.hom xbar)
  let : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
    isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
  let : Algebra (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
      (etaleLocalRing B S hS X.1 xbar) := (etaleLocalRingMap X.2 f.hom xbar).toAlgebra
  let : Module (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
      (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G) :=
    (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G).isModule
  let e := (geometricModuleStalkPullbackIso B S hS f xbar G).toLinearEquiv
  refine (isWeaklyAssociatedPrime_geometricModuleStalk_baseChange_iff
    B S hS f hflat xbar (finite_etaleLocalRingMap X.2 Y.2 f.hom hfinite xbar) G).trans
    ⟨fun h => ?_, fun h => ?_⟩
  · exact isWeaklyAssociatedPrime_map_linearEquiv e.symm h
  · exact isWeaklyAssociatedPrime_map_linearEquiv e h

/-- **The stalkwise content of Stacks 0CUA.** Let `f : X ⟶ Y` be a morphism of algebraic spaces
which is flat at a geometric point `x̄` of `X`, and suppose the local ring of the fibre of `f`
at `x̄` has dimension zero, that is, the maximal ideal of `𝒪_{X, x̄}` is the radical of the
ideal generated by the maximal ideal of `𝒪_{Y, ȳ}`. If the maximal ideal of `𝒪_{Y, ȳ}` is
weakly associated to the geometric stalk `G_{ȳ}`, then the maximal ideal of `𝒪_{X, x̄}` is
weakly associated to the base change `𝒪_{X, x̄} ⊗_{𝒪_{Y, ȳ}} G_{ȳ}`.

The tag itself is `AlgebraicGeometry.Space.isWeaklyAssociatedPoint_modulePullback`, which
identifies that base change with the geometric stalk of `f^*G`. -/
theorem isWeaklyAssociatedPrime_geometricModuleStalk_baseChange (f : X ⟶ Y)
    (xbar : GeometricPoint B S hS X.1) (hflat : IsFlatAt B S hS f.hom xbar.image)
    (G : Modules.{u, m} B S hS Y.1 Y.2) :
    letI : IsLocalRing (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar)) :=
      isLocalRing_etaleLocalRing B S hS Y.1 Y.2 (geometricPointMap f.hom xbar)
    letI : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
      isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
    letI : Algebra (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
        (etaleLocalRing B S hS X.1 xbar) := (etaleLocalRingMap X.2 f.hom xbar).toAlgebra
    letI : Module (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
        (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G) :=
      (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G).isModule
    (Ideal.map (algebraMap (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
            (etaleLocalRing B S hS X.1 xbar))
          (maximalIdeal (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar)))).radical =
        maximalIdeal (etaleLocalRing B S hS X.1 xbar) →
      IsWeaklyAssociatedPrime (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
          (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G)
          (maximalIdeal (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))) →
        IsWeaklyAssociatedPrime (etaleLocalRing B S hS X.1 xbar)
          (etaleLocalRing B S hS X.1 xbar ⊗[etaleLocalRing B S hS Y.1
              (geometricPointMap f.hom xbar)]
            geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G)
          (maximalIdeal (etaleLocalRing B S hS X.1 xbar)) := by
  let : IsLocalRing (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar)) :=
    isLocalRing_etaleLocalRing B S hS Y.1 Y.2 (geometricPointMap f.hom xbar)
  let : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
    isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
  let : Algebra (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
      (etaleLocalRing B S hS X.1 xbar) := (etaleLocalRingMap X.2 f.hom xbar).toAlgebra
  let : Module (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
      (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G) :=
    (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G).isModule
  have : Module.Flat (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
      (etaleLocalRing B S hS X.1 xbar) :=
    (isFlatAt_iff_etaleLocalRingMap_flat (B := B) (S := S) (hS := hS) X.2 Y.2 f.hom xbar).mp hflat
  intro hrad hwa
  exact isWeaklyAssociatedPrime_maximalIdeal_tensorProduct_of_flat_of_radical_eq hrad hwa

/-- **Stacks 0CUA.** Let `f : X ⟶ Y` be a morphism of algebraic spaces over a scheme `S`, let
`G` be an `𝒪_Y`-module, let `x` be a point of `X` with image `y`, and let `x̄` be a geometric
point above `x`. Suppose that `y` is weakly associated to `G`, that `f` is flat at `x`, and
that the local ring of the fibre of `f` at `x̄` has dimension zero — that is, the maximal ideal
of `𝒪_{X, x̄}` is the radical of the ideal generated by the maximal ideal of `𝒪_{Y, ȳ}`. Then
`x` is weakly associated to `f^*G`.

The stalk of `f^*G` at `x̄` is the base change `𝒪_{X, x̄} ⊗_{𝒪_{Y, ȳ}} G_{ȳ}` by the
base-change clause of Stacks 05VQ, and weak association at `ȳ` follows from weak association
of `y` because the condition does not depend on the geometric point chosen above a point. -/
@[stacks 0CUA "the zero-dimensional local ring of the fibre read as the equality of the maximal
ideal of the étale local ring with the radical of the ideal extended from the maximal ideal of
the target, at a geometric point above the given point"]
theorem isWeaklyAssociatedPoint_modulePullback (f : X ⟶ Y) (x : points B S hS X.1)
    (xbar : GeometricPoint B S hS X.1) (hxbar : xbar.LiesOver x)
    (hflat : IsFlatAt B S hS f.hom x) (G : Modules.{u, u} B S hS Y.1 Y.2) :
    letI : IsLocalRing (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar)) :=
      isLocalRing_etaleLocalRing B S hS Y.1 Y.2 (geometricPointMap f.hom xbar)
    letI : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
      isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
    letI : Algebra (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
        (etaleLocalRing B S hS X.1 xbar) := (etaleLocalRingMap X.2 f.hom xbar).toAlgebra
    (Ideal.map (algebraMap (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
            (etaleLocalRing B S hS X.1 xbar))
          (maximalIdeal (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar)))).radical =
        maximalIdeal (etaleLocalRing B S hS X.1 xbar) →
      IsWeaklyAssociatedPoint B S hS Y G (pointsMap B S hS X.1 f.hom x) →
        IsWeaklyAssociatedPoint B S hS X ((modulePullback B S hS f).obj G) x := by
  subst hxbar
  let : IsLocalRing (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar)) :=
    isLocalRing_etaleLocalRing B S hS Y.1 Y.2 (geometricPointMap f.hom xbar)
  let : IsLocalRing (etaleLocalRing B S hS X.1 xbar) :=
    isLocalRing_etaleLocalRing B S hS X.1 X.2 xbar
  let : Algebra (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
      (etaleLocalRing B S hS X.1 xbar) := (etaleLocalRingMap X.2 f.hom xbar).toAlgebra
  let : Module (etaleLocalRing B S hS Y.1 (geometricPointMap f.hom xbar))
      (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G) :=
    (geometricModuleStalk B S hS Y (geometricPointMap f.hom xbar) G).isModule
  intro hrad hG
  have hwa := (isWeaklyAssociatedPoint_iff_isWeaklyAssociatedPrime B S hS Y G
    (pointsMap B S hS X.1 f.hom xbar.image) (geometricPointMap f.hom xbar) rfl).mp hG
  refine ⟨xbar, rfl, ?_⟩
  let e := (geometricModuleStalkPullbackIso B S hS f xbar G).symm.toLinearEquiv
  exact isWeaklyAssociatedPrime_map_linearEquiv e
    (isWeaklyAssociatedPrime_geometricModuleStalk_baseChange B S hS f xbar hflat G hrad hwa)

end AlgebraicGeometry.Space

