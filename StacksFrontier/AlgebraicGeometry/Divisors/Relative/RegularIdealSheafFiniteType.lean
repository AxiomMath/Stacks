/-- An ideal sheaf of finite type on a scheme is quasi-coherent. -/
private theorem isQuasicoherent_of_isFiniteType (hJ : J.toSheafOfModules.IsFiniteType) :
    J.toSheafOfModules.IsQuasicoherent := by
  refine (Stacks.ClosedImmersion.isQuasicoherent_iff_localGenerators X J).2 ?_
  obtain ⟨σ, _⟩ := hJ.exists_localGeneratorsData
  exact ⟨σ⟩

/-- **Stacks Project, Tag 063F.**  A regular ideal sheaf on a scheme is of finite type. -/
