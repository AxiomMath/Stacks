/-- The sheaf of rings a sheaf of modules is taken over, read off from the module sheaf itself.
This spells the base of `structureSheafModule X` exactly as elaboration produced it, which keeps
later terms over it well-typed without unfolding the structure sheaf. -/
abbrev moduleRingSheaf {C : Type*} [Category C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat} (_M : SheafOfModules R) : Sheaf J RingCat := R

/-! ### A section of a generated ideal sheaf is locally a combination of the generators -/

/-- A section of the ideal sheaf generated by `f` over `U`, on a subopen `V` of `U`, is on some
neighbourhood of each point of `V` an `O_X`-linear combination of the restrictions of the `fᵢ`. -/
theorem exists_localCombination_of_mem_generatedIdealOn (X : RingedSpace.{u})
    (U V : Opens X) (hVU : V ≤ U) {r : ℕ} (f : Fin r → X.presheaf.obj (op U))
    (s : X.presheaf.obj (op V)) (hs : s ∈ (generatedIdealOn X U f).obj (op V))
    (x : X) (hx : x ∈ V) :
    ∃ (W : Opens X) (_hxW : x ∈ W) (hWV : W ≤ V) (hWU : W ≤ U)
      (a : Fin r → X.presheaf.obj (op W)),
      X.presheaf.map (homOfLE hWV).op s =
        ∑ i, a i * X.presheaf.map (homOfLE hWU).op (f i) := by
  classical
  obtain ⟨cc, hcc⟩ := Ideal.mem_span_range_iff_exists_fun.mp
    (germ_mem_of_mem_generatedIdealOn U f V s hs x hx (hVU hx))
  obtain ⟨V₀, hxV₀, b, hb⟩ := exists_nhds_germ_eq (Finset.univ : Finset (Fin r)) x cc
  have hxW₀ : x ∈ V ⊓ V₀ := ⟨hx, hxV₀⟩
  have hinfU : V ⊓ V₀ ≤ U := le_trans (inf_le_left (a := V) (b := V₀)) hVU
  set dd : X.presheaf.obj (op (V ⊓ V₀)) :=
    X.presheaf.map (homOfLE (inf_le_left (a := V) (b := V₀))).op s
      - ∑ i, X.presheaf.map (homOfLE (inf_le_right (a := V) (b := V₀))).op (b i)
          * X.presheaf.map (homOfLE hinfU).op (f i) with hdd
  have hgerm : X.presheaf.germ (V ⊓ V₀) x hxW₀ dd = 0 := by
    rw [hdd, map_sub, map_sum, sub_eq_zero,
      TopCat.Presheaf.germ_res_apply X.presheaf
        (homOfLE (inf_le_left (a := V) (b := V₀))) x hxW₀ s, ← hcc]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul,
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hinfU) x hxW₀ (f i),
      TopCat.Presheaf.germ_res_apply X.presheaf
        (homOfLE (inf_le_right (a := V) (b := V₀))) x hxW₀ (b i),
      hb i (Finset.mem_univ i)]
    rfl
  obtain ⟨W, hxW, hWW₀, hdW⟩ :=
    exists_nhds_eq_zero_of_germ_eq_zero (V ⊓ V₀) dd x hxW₀ hgerm
  refine ⟨W, hxW, le_trans hWW₀ (inf_le_left (a := V) (b := V₀)),
    le_trans hWW₀ hinfU,
    fun i => X.presheaf.map
      (homOfLE (le_trans hWW₀ (inf_le_right (a := V) (b := V₀)))).op (b i), ?_⟩
  rw [hdd, map_sub, map_sum, sub_eq_zero] at hdW
  rw [← QuasiRegular.res_res (inf_le_left (a := V) (b := V₀)) hWW₀ s, hdW]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_mul, QuasiRegular.res_res, QuasiRegular.res_res]

/-! ### Membership in an ideal sheaf from vanishing in the quotient -/

/-- Away from the support of `O_X/J` the unit section is killed on some neighbourhood by the
projection onto the quotient. -/
theorem exists_nhds_quotient_one_eq_zero (X : RingedSpace.{u})
    (J : (structureSheafModule X).Submodule) (x : X)
    (hx : x ∉ idealQuotientSupport X J) :
    ∃ (V : Opens X) (_hxV : x ∈ V) (i : V ⟶ ⊤),
      (idealQuotient X J).val.presheaf.map i.op
        ((cokernel.π J.ι).val.app (op (⊤ : Opens X))
          (1 : X.presheaf.obj (op (⊤ : Opens X)))) = 0 := by
  let Q : RingedSpace.ModuleSheaf.{u} X :=
    ⟨(idealQuotient X J).val, (idealQuotient X J).isSheaf⟩
  change x ∉ Q.supp at hx
  let s : Q.toPresheaf.obj (op (⊤ : Opens X)) :=
    (cokernel.π J.ι).val.app (op (⊤ : Opens X)) (1 : X.presheaf.obj (op (⊤ : Opens X)))
  have hzero : Q.sectionGerm ⊤ x (by simp) s = 0 :=
    of_not_not fun hne => hx ⟨Q.sectionGerm ⊤ x (by simp) s, hne⟩
  exact (Q.sectionGerm_eq_zero_iff ⊤ x (by simp) s).mp hzero

/-- An ideal subsheaf of the structure sheaf is the kernel of the projection onto its quotient: a
section killed by that projection belongs to the ideal subsheaf. -/
theorem mem_of_quotient_section_eq_zero (X : RingedSpace.{u})
    (J : (structureSheafModule X).Submodule) (V : Opens X) (s : X.presheaf.obj (op V))
    (hs : (cokernel.π J.ι).val.app (op V) s = 0) :
    s ∈ J.obj (op V) := by
  let M := structureSheafModule X
  let R := moduleRingSheaf M
  let F := SheafOfModules.evaluation R (op V)
  let sM : M.val.obj (op V) := s
  let c : KernelFork (cokernel.π J.ι) := KernelFork.ofι J.ι (cokernel.condition J.ι)
  have hc : IsLimit c :=
    Abelian.monoIsKernelOfCokernel
      (Cofork.ofπ (cokernel.π J.ι) (by simp))
      (cokernelIsCokernel J.ι)
  have hc' : IsLimit (c.map F) := c.mapIsLimit hc F
  let e : F.obj M ⟶ F.obj M := ModuleCat.ofHom
    (LinearMap.toSpanSingleton (↑(R.obj.obj (op V))) (M.val.obj (op V)) sM)
  have hs' : (F.map (cokernel.π J.ι)) sM = 0 := by convert hs using 1 <;> rfl
  have hzero : ∀ t : ↑(R.obj.obj (op V)),
      (F.map (cokernel.π J.ι))
        (LinearMap.toSpanSingleton (↑(R.obj.obj (op V))) (M.val.obj (op V)) sM t) = 0 := by
    intro t
    have h2 : (F.map (cokernel.π J.ι)) (t • sM) = t • (F.map (cokernel.π J.ι)) sM :=
      map_smul _ t sM
    rw [LinearMap.toSpanSingleton_apply, h2, hs', smul_zero]
  have he : e ≫ F.map (cokernel.π J.ι) = 0 :=
    ModuleCat.hom_ext (LinearMap.ext fun t => hzero t)
  let lift : F.obj M ⟶ F.obj J.toSheafOfModules := hc'.lift (KernelFork.ofι e he)
  have hfac := hc'.fac (KernelFork.ofι e he) WalkingParallelPair.zero
  have he1 : e (1 : ↑(R.obj.obj (op V))) = sM :=
    (LinearMap.toSpanSingleton_apply (↑(R.obj.obj (op V))) (M.val.obj (op V)) sM 1).trans
      (one_smul _ _)
  have h1 : (F.map J.ι) (lift (1 : ↑(R.obj.obj (op V)))) = sM := by
    have h := congrArg (fun g => g (1 : ↑(R.obj.obj (op V)))) hfac
    have hL : (F.map J.ι) (lift (1 : ↑(R.obj.obj (op V)))) = e (1 : ↑(R.obj.obj (op V))) := by
      convert h using 1 <;> rfl
    exact hL.trans he1
  have hsM : sM = s := rfl
  exact (h1.trans hsM) ▸ (lift (1 : ↑(R.obj.obj (op V)))).property

/-! ### Finite generating sections of a locally generated ideal sheaf -/

/-- A section of `J` over `U`, read as a global section of the restriction of `J` to `U`. -/
noncomputable def idealSectionOn (X : Scheme.{u})
    (J : (structureSheafModule X.toRingedSpace).Submodule) (U : Opens X)
    (s : X.presheaf.obj (op U)) (hs : s ∈ J.obj (op U)) :
    (J.toSheafOfModules.over U).sections := by
  refine PresheafOfModules.sectionsMk (fun V => ?_) ?_
  · change J.toSubmodule.obj (op V.unop.left)
    exact ⟨X.presheaf.map V.unop.hom.op s, J.toSubmodule.map V.unop.hom.op hs⟩
  · intro V W f
    apply Subtype.ext
    change X.presheaf.map ((Over.forget U).map f.unop).op
        (X.presheaf.map V.unop.hom.op s) = X.presheaf.map W.unop.hom.op s
    have h : (Over.forget U).map f.unop ≫ V.unop.hom = W.unop.hom := by cat_disch
    have hop : V.unop.hom.op ≫ ((Over.forget U).map f.unop).op = W.unop.hom.op := by
      rw [← op_comp, h]
    rw [← CategoryTheory.comp_apply, ← X.presheaf.map_comp, hop]

/-- The value of the unit-hom adjunction on a section, read pointwise. -/
theorem unitHomEquiv_symm_app_apply {C : Type*} [Category C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat} (M : SheafOfModules R) (s : M.sections) (V : Cᵒᵖ)
    (a : ↑(R.obj.obj V)) :
    (ConcreteCategory.hom ((M.unitHomEquiv.symm s).val.app V)) a =
      ((LinearMap.ringLmapEquivSelf (R.obj.obj V) ℤ (M.val.obj V)).symm (s.val V)) a := by
  dsimp [SheafOfModules.unitHomEquiv, PresheafOfModules.unitHomEquiv]
  rfl

/-- A finite family of sections generating `J` over `U` gives finite generating sections of the
restriction of `J` to `U`. -/
noncomputable def localGeneratingSectionsOn (X : Scheme.{u})
    (J : (structureSheafModule X.toRingedSpace).Submodule) (U : Opens X) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op U))
    (hgen : IsGeneratedByOn X.toRingedSpace J U f) :
    (J.toSheafOfModules.over U).GeneratingSections := by
  let R := moduleRingSheaf (structureSheafModule X.toRingedSpace)
  let M := J.toSheafOfModules.over U
  let gs : ULift.{u} (Fin r) → M.sections := fun i =>
    idealSectionOn X J U (f i.down) (by
      rw [hgen U le_rfl]; exact mem_generatedIdealOn X.toRingedSpace U f i.down)
  let ψ : SheafOfModules.free (R := R.over U) (ULift.{u} (Fin r)) ⟶ M := M.freeHomEquiv.symm gs
  refine { I := ULift.{u} (Fin r), s := gs, epi := ?_ }
  let p := (PresheafOfModules.toPresheaf (R.over U).obj).map ψ.val
  have hp : Presheaf.IsLocallySurjective
      ((Opens.grothendieckTopology X.toRingedSpace).over U) p := by
    refine ⟨fun {Y} t => ?_⟩
    rw [CategoryTheory.GrothendieckTopology.mem_over_iff, Opens.mem_grothendieckTopology]
    intro x hx
    let V : Opens X := Y.left
    have hVU : V ≤ U := leOfHom Y.hom
    have hxV : x ∈ V := hx
    obtain ⟨W, hxW, hWV, hWU, a, ha⟩ :=
      exists_localCombination_of_mem_generatedIdealOn X.toRingedSpace U V hVU f t.val
        (by rw [← hgen V hVU]; exact t.property) x hxV
    let Z : Over U := Over.mk (homOfLE hWU)
    let gZY : Z ⟶ Y := Over.homMk (homOfLE hWV) (by cat_disch)
    let a' : Fin r → (SheafOfModules.unit (R.over U)).val.obj (op Z) := fun i => a i
    let z : (SheafOfModules.free (R := R.over U) (ULift.{u} (Fin r))).val.obj (op Z) :=
      ∑ i, (ConcreteCategory.hom (((SheafOfModules.forget (R.over U)).map
        (SheafOfModules.ιFree (R := R.over U) (ULift.up i : ULift.{u} (Fin r)))).app
          (op Z))) (a' i)
    have hz : (ConcreteCategory.hom (p.app (op Z))) z =
        (ConcreteCategory.hom (((PresheafOfModules.toPresheaf (R.over U).obj).obj
          (J.toSheafOfModules.over U).val).map gZY.op)) t := by
      change (ψ.val.app (op Z)) z = ((J.toSheafOfModules.over U).val.map gZY.op) t
      have hterm (i : Fin r) :
          (ψ.val.app (op Z))
              ((ConcreteCategory.hom (((SheafOfModules.forget (R.over U)).map
                (SheafOfModules.ιFree (R := R.over U)
                  (ULift.up i : ULift.{u} (Fin r)))).app (op Z))) (a' i)) =
            (ConcreteCategory.hom (((SheafOfModules.forget (R.over U)).map
              ((J.toSheafOfModules.over U).unitHomEquiv.symm
                (gs (ULift.up i)))).app (op Z))) (a' i) := by
        have hc : SheafOfModules.ιFree (R := R.over U) (ULift.up i : ULift.{u} (Fin r)) ≫ ψ =
            (J.toSheafOfModules.over U).unitHomEquiv.symm (gs (ULift.up i)) := by
          simpa [ψ] using
            (SheafOfModules.unitHomEquiv_symm_freeHomEquiv_apply ψ
              (ULift.up i : ULift.{u} (Fin r))).symm
        have hc' := congrArg (fun q => q.val.app (op Z)) hc
        have hc'' := congrArg (fun q => q.hom (a' i)) hc'
        convert hc'' using 1
        all_goals rfl
      have htermval (i : Fin r) :
          ((ConcreteCategory.hom (((SheafOfModules.forget (R.over U)).map
            ((J.toSheafOfModules.over U).unitHomEquiv.symm
              (gs (ULift.up i)))).app (op Z))) (a' i)).val =
            a i * X.presheaf.map (homOfLE hWU).op (f i) := by
        change ((ConcreteCategory.hom (((J.toSheafOfModules.over U).unitHomEquiv.symm
          (gs (ULift.up i))).val.app (op Z))) (a' i)).val = _
        have hh := congrArg Subtype.val
          (unitHomEquiv_symm_app_apply (J.toSheafOfModules.over U)
            (gs (ULift.up i)) (op Z) (a' i))
        rw [hh]
        dsimp [a']
        change a i * (X.presheaf.map (homOfLE hWU).op (f i)) = _
        rfl
      let b : Fin r → J.obj (op W) := fun i =>
        (ConcreteCategory.hom (((SheafOfModules.forget (R.over U)).map
          ((J.toSheafOfModules.over U).unitHomEquiv.symm
            (gs (ULift.up i)))).app (op Z))) (a' i)
      have hsum : (ψ.val.app (op Z)) z = ∑ i, b i := by
        change (ψ.val.app (op Z)).hom
            (∑ i ∈ Finset.univ, (ConcreteCategory.hom (((SheafOfModules.forget
              (R.over U)).map (SheafOfModules.ιFree
                (R := R.over U) (ULift.up i : ULift.{u} (Fin r)))).app (op Z))) (a' i)) = _
        calc
          _ = ∑ i ∈ Finset.univ, (ψ.val.app (op Z)).hom
                ((ConcreteCategory.hom (((SheafOfModules.forget (R.over U)).map
                  (SheafOfModules.ιFree (R := R.over U)
                    (ULift.up i : ULift.{u} (Fin r)))).app (op Z))) (a' i)) :=
              map_sum (ψ.val.app (op Z)).hom _ Finset.univ
          _ = _ := Finset.sum_congr rfl fun i _ => hterm i
      rw [hsum]
      refine Subtype.ext ?_
      change (∑ i, b i).val = X.presheaf.map (homOfLE hWV).op t.val
      rw [show (∑ i, b i).val = ∑ i, (b i).val from
        map_sum (Submodule.subtype (J.obj (op W))) _ Finset.univ]
      simp_rw [b, htermval]
      exact ha.symm
    refine ⟨W, homOfLE hWV, ?_, hxW⟩
    rw [CategoryTheory.Sieve.overEquiv_apply]
    change ∃ (Z' : Over U) (g : Z' ⟶ Y) (h : W ⟶ (Over.forget U).obj Z'),
      (CategoryTheory.Presheaf.imageSieve p t).arrows g ∧ homOfLE hWV = h ≫ (Over.forget U).map g
    exact ⟨Z, gZY, 𝟙 W, ⟨z, hz⟩, by simp [gZY]⟩
  have hepi : Epi ((SheafOfModules.toSheaf (R.over U)).map ψ) :=
    (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat
      ((SheafOfModules.toSheaf (R.over U)).map ψ)).1 hp
  refine ⟨fun {N} φ χ h => ?_⟩
  apply (SheafOfModules.toSheaf (R.over U)).map_injective
  have hh : (SheafOfModules.toSheaf (R.over U)).map ψ ≫ (SheafOfModules.toSheaf (R.over U)).map φ =
      (SheafOfModules.toSheaf (R.over U)).map ψ ≫ (SheafOfModules.toSheaf (R.over U)).map χ := by
    simpa only [Functor.map_comp] using
      congrArg ((SheafOfModules.toSheaf (R.over U)).map) h
  exact (cancel_epi ((SheafOfModules.toSheaf (R.over U)).map ψ)).1 hh

/-! ### Finite type -/

/-- An ideal sheaf on a scheme which, near every point of the support of its quotient, is
generated by a finite family of sections, is of finite type. -/
theorem isFiniteType_of_locallyGenerated_on_quotient_support (X : Scheme.{u})
    (J : (structureSheafModule X.toRingedSpace).Submodule)
    (hlocal : ∀ x : X, x ∈ idealQuotientSupport X.toRingedSpace J →
      ∃ (U : Opens X) (_hx : x ∈ U) (r : ℕ) (f : Fin r → X.presheaf.obj (op U)),
        IsGeneratedByOn X.toRingedSpace J U f) :
    J.toSheafOfModules.IsFiniteType := by
  classical
  have hdata (x : X) : ∃ (U : Opens X) (_hx : x ∈ U) (r : ℕ)
      (f : Fin r → X.presheaf.obj (op U)), IsGeneratedByOn X.toRingedSpace J U f := by
    by_cases hx : x ∈ idealQuotientSupport X.toRingedSpace J
    · exact hlocal x hx
    obtain ⟨V, hxV, i, hi⟩ := exists_nhds_quotient_one_eq_zero X.toRingedSpace J x hx
    let R0 := (sheafCompose (Opens.grothendieckTopology X.toRingedSpace)
      (forget₂ CommRingCat RingCat)).obj X.toRingedSpace.sheaf
    let M := structureSheafModule X.toRingedSpace
    let oneTop : M.val.obj (op (⊤ : Opens X)) := (1 : X.presheaf.obj (op (⊤ : Opens X)))
    let oneV : M.val.obj (op V) := (1 : X.presheaf.obj (op V))
    have h1V : (1 : X.presheaf.obj (op V)) ∈ J.obj (op V) := by
      refine mem_of_quotient_section_eq_zero X.toRingedSpace J V 1 ?_
      have hnat := PresheafOfModules.naturality_apply (cokernel.π J.ι).val i.op oneTop
      have hunit : M.val.map i.op oneTop = oneV :=
        PresheafOfModules.unit_map_one R0.obj i.op
      have hq : (ConcreteCategory.hom ((idealQuotient X.toRingedSpace J).val.map i.op))
          (((cokernel.π J.ι).val.app (op (⊤ : Opens X))) oneTop) = 0 := hi
      rwa [hunit, hq] at hnat
    refine ⟨V, hxV, 1, fun _ => 1, fun W hWV => ?_⟩
    have hres : M.val.restrictₛₗ (homOfLE hWV).op (1 : X.presheaf.obj (op V)) =
        (1 : X.presheaf.obj (op W)) := PresheafOfModules.unit_map_one R0.obj (homOfLE hWV).op
    have hone : ∀ I : (structureSheafModule X.toRingedSpace).Submodule,
        (1 : X.presheaf.obj (op V)) ∈ I.obj (op V) → (1 : X.presheaf.obj (op W)) ∈ I.obj (op W) :=
      fun I h => by
        have hm' := Submodule.mem_comap.mp (I.toSubmodule.map (homOfLE hWV).op h)
        rwa [hres] at hm'
    have h1J := hone J h1V
    have h1gen := hone (generatedIdealOn X.toRingedSpace V (fun _ : Fin 1 => 1))
      (mem_generatedIdealOn X.toRingedSpace V (fun _ : Fin 1 => 1) 0)
    rw [(Ideal.eq_top_iff_one _).mpr h1J, (Ideal.eq_top_iff_one _).mpr h1gen]
  choose U hU r f hf using hdata
  refine Stacks.AlgebraicGeometry.CoherentKernel.isFiniteType_of_coversTop
    J.toSheafOfModules U ?_ (fun x => localGeneratingSectionsOn X J (U x) (f x) (hf x))
    (fun x => inferInstanceAs (Finite (ULift.{u} (Fin (r x)))))
  refine (Opens.coversTop_iff (T := X.toTopCat) (U := U)).2 ?_
  exact IsOpenCover.of_sets (v := fun x => (U x : Set X)) (fun x => (U x).isOpen)
    (by ext x; exact ⟨fun _ => trivial, fun _ => Set.mem_iUnion.mpr ⟨x, hU x⟩⟩)

