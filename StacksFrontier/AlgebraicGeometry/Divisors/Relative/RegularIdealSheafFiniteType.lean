theorem isFiniteType_of_isRegularIdealSheaf (hJ : IsRegularIdealSheaf X.toRingedSpace J) :
    J.toSheafOfModules.IsFiniteType := by
  refine isFiniteType_of_locallyGenerated_on_quotient_support X J fun x hx => ?_
  obtain ⟨U, hxU, r, f, _, hgen⟩ := hJ x hx
  exact ⟨U, hxU, r, f, hgen⟩

