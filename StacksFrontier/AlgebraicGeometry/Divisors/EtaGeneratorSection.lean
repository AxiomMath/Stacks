module

public import StacksFrontier.AlgebraicGeometry.Divisors.EtaAffineComparison
public import StacksFrontier.AlgebraicGeometry.Divisors.IdealSheafSections

/-!
# The generating section of a principal ideal sheaf on an affine open

Let `X` be a scheme, `D ⊆ X` a closed subscheme given by its ideal sheaf data, and `U ⊆ X` an
affine open on which the ideal of `D` is generated by a nonzerodivisor `f ∈ Γ(X, U)`.  Then `f`
comes from a section of the ideal sheaf which generates it over every open subset of `U`, in the
sense of Situation 0GT3.

This is the hypothesis in the form the affine comparison of the Berthelot–Ogus décalage asks
for: `Stacks.Divisors.Eta.etaSectionsIso` is stated for a section `g` of the ideal sheaf with
`Stacks.IdealTorsion.GeneratesIdealOn X U g`, whereas an affine chart for a complex and a divisor
records the divisor as the equation `D.ideal U = Ideal.span {f}` in the ring of sections.

## Main results

* `Stacks.Divisors.Eta.exists_generatesIdealOn_of_ideal_eq_span`: the equation
  `D.ideal U = Ideal.span {f}` for a nonzerodivisor `f` produces a section of the ideal sheaf
  which generates the ideal on every open subset of `U` and whose image in `Γ(X, U)` is `f`.
* `Stacks.Divisors.Eta.generatesStalkIdeal_germ`: hence the germ of `f` at a point of `U`
  generates the stalk ideal of `ℐ_D ⟶ 𝒪_X` there, which is the form the décalage calculus asks
  a generator in.

## Implementation notes

Generation on every open subset of `U` is the surjectivity half of
`Stacks.Divisors.bijective_smulSectionMap_resSection`, read at the object `Over.mk (homOfLE hVU)`
of the slice over `U`; the section itself is the one attached to the generator by
`Stacks.Divisors.mem_ideal_iff_exists_idealSheafSection`.  Nothing has to be transported:
`Stacks.SheafOfModules.resSection` is
by definition the restriction map of the sheaf of modules, `Stacks.SheafOfModules.smulSectionMap`
is by definition scalar multiplication, and the inclusion of the ideal sheaf used by
`Stacks.Divisors.idealSheafSection` is the one `Stacks.Divisors.Eta.idealSheafι` is defined as,
so the identification of `Stacks.IdealTorsion.Eta.generatorSection` with
`Stacks.Divisors.idealSheafSection` is definitional.

## References

* [Stacks Project, Tag 0F8M](https://stacks.math.columbia.edu/tag/0F8M)
* [Stacks Project, Tag 0GT3](https://stacks.math.columbia.edu/tag/0GT3)
* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite TopologicalSpace

universe u

namespace Stacks.Divisors.Eta

variable {X : Scheme.{u}}

/-- **The generator of a principal ideal on an affine open comes from a generating section of
the ideal sheaf.**  If the ideal of `D` on an affine open `U` is generated by a nonzerodivisor
`f`, then some section `g` of the ideal sheaf over `U` generates the ideal on every open subset
of `U` and has image `f` in `Γ(X, U)`.

This supplies the hypotheses of `Stacks.Divisors.Eta.etaSectionsIso` from the equation
`D.ideal U = Ideal.span {f}`. -/
theorem exists_generatesIdealOn_of_ideal_eq_span (D : X.IdealSheafData) (U : X.affineOpens)
    {f : Γ(X, (U : X.Opens))} (hf : D.ideal U = Ideal.span {f})
    (hfnzd : f ∈ nonZeroDivisors Γ(X, (U : X.Opens))) :
    ∃ g : (idealSheaf D).val.obj (op (U : X.Opens)),
      Stacks.IdealTorsion.GeneratesIdealOn X.toRingedSpace (U : X.Opens) g ∧
        Stacks.IdealTorsion.Eta.generatorSection X.toRingedSpace (idealSheafι D)
          (U : X.Opens) g = f := by
  obtain ⟨e, he⟩ : ∃ y, Stacks.Divisors.idealSheafSection D y = f :=
    (Stacks.Divisors.mem_ideal_iff_exists_idealSheafSection D U f).1
      (hf ▸ Ideal.mem_span_singleton_self f)
  refine ⟨e, ?_, he⟩
  intro V hVU a
  obtain ⟨r, hr⟩ := (Stacks.Divisors.bijective_smulSectionMap_resSection D U hf hfnzd he
    (op (Over.mk (homOfLE hVU)))).2 a
  exact ⟨r, hr.symm⟩

/-- **The germ of the equation of a principal ideal generates the stalk ideal.**  If the ideal of
`D` on an affine open `U` is generated by a nonzerodivisor `f`, then at every point `x` of `U` the
germ of `f` generates the stalk ideal of `ℐ_D ⟶ 𝒪_X` at `x`, in the sense of
`Stacks.IdealTorsion.GeneratesStalkIdeal`.

This is `Stacks.Divisors.Eta.exists_generatesIdealOn_of_ideal_eq_span` followed by
`Stacks.IdealTorsion.generatesStalkIdeal_of_generatesIdealOn`, the sectionwise-to-stalkwise step
of Situation 0GT3. -/
theorem generatesStalkIdeal_germ (D : X.IdealSheafData) (U : X.affineOpens) {x : X}
    (hx : x ∈ (U : X.Opens)) {f : Γ(X, (U : X.Opens))} (hf : D.ideal U = Ideal.span {f})
    (hfnzd : f ∈ nonZeroDivisors Γ(X, (U : X.Opens))) :
    Stacks.IdealTorsion.GeneratesStalkIdeal X.toRingedSpace (idealSheafι D) x
      ((X.presheaf.germ (U : X.Opens) x hx).hom f) := by
  obtain ⟨g, hgen, hgf⟩ := exists_generatesIdealOn_of_ideal_eq_span D U hf hfnzd
  have hstalk := Stacks.IdealTorsion.generatesStalkIdeal_of_generatesIdealOn X.toRingedSpace
    (idealSheafι D) (U : X.Opens) g hgen x hx
  have hgf' : Stacks.IdealTorsion.idealSection X.toRingedSpace (idealSheafι D)
      (op (U : X.Opens)) g = f := hgf
  rwa [hgf'] at hstalk

end Stacks.Divisors.Eta

end
