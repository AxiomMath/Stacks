/-!
# The Berthelot–Ogus operator on quasi-coherent complexes and on affine schemes

Let `X` be a scheme and let `D ⊆ X` be an effective Cartier divisor with ideal sheaf
`I ⊆ 𝒪_X`. The derived décalage `Lη_I : D(𝒪_X) ⥤ D(𝒪_X)` of [Stacks, Tag 0F8Q] sends
`D_QCoh(𝒪_X)` into itself. Moreover, if `X = Spec(A)` is affine and `D = V(f)`, then the functor
`Lη_f` on `D(A)` of [Stacks, Tag 0F7R] and the functor `Lη_I` correspond via the equivalence
`D(A) ≌ D_QCoh(𝒪_X)` of [Stacks, Tag 06Z0]. This is [Stacks, Tag 0GTV].

## Main results

* `Stacks.Divisors.Eta.mem_nonZeroDivisors_of_ideal_eq_span`: a generator of the ideal of an
  effective Cartier divisor on an affine open is a nonzerodivisor.
* `Stacks.Divisors.Eta.derivedEtaAffineComparisonOfIdealEqSpan`: on `Spec(A)`, for `D = V(f)`,
  the natural isomorphism `(-)^~ ⋙ Lη_I ≅ Lη_f ⋙ (-)^~` of functors `D(A) ⥤ D(𝒪_{Spec A})`.
* `Stacks.Divisors.Eta.derivedEta_isQuasicoherent_and_affineComparison`: [Stacks, Tag 0GTV].

## Implementation notes

The hypothesis `D = V(f)` is the equation `D.ideal ⊤ = (f)` between ideals of
`A = Γ(Spec R, ⊤)`; the ideal of the closed subscheme `D` on the affine open `⊤` is the ideal
cutting `D` out. That `f` is a nonzerodivisor, which is what makes `Lη_f` defined at all, is
not assumed: it is `mem_nonZeroDivisors_of_ideal_eq_span`, proved from the effective Cartier
property by comparing `f` with the local nonzerodivisor generators of [Stacks, Tag 01WS] on
affine opens covering `Spec(A)`.

The equivalence of [Stacks, Tag 06Z0] is read as derived sheafification
`Stacks.Divisors.Eta.derivedTildeGamma`, the derived functor of `M ↦ M^~` for modules over the
ring `A = Γ(Spec R, ⊤)` of global functions; see
`StacksFrontier/AlgebraicGeometry/Divisors/EtaDerivedAffineComparison.lean`.

## References

* [Stacks Project, Tag 0GTV](https://stacks.math.columbia.edu/tag/0GTV)
* [Stacks Project, Tag 0F8Q](https://stacks.math.columbia.edu/tag/0F8Q)
* [Stacks Project, Tag 0F7R](https://stacks.math.columbia.edu/tag/0F7R)
* [Stacks Project, Tag 06Z0](https://stacks.math.columbia.edu/tag/06Z0)
* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite

universe u

namespace Stacks.Divisors.Eta

/-- **A local equation of an effective Cartier divisor is a nonzerodivisor.** If `D ⊆ X` is an
effective Cartier divisor and its ideal on an affine open `U` is generated by `f ∈ Γ(X, U)`, then
`f` is a nonzerodivisor of `Γ(X, U)`.

Near every point of `U` the ideal of `D` is generated on an affine open by a nonzerodivisor
(the forward direction of [Stacks, Tag 01WS]); on a smaller affine open both generators generate
the restricted ideal, so the restriction of `f` is a nonzerodivisor there, and being killed by
`f` is a local condition. -/
theorem mem_nonZeroDivisors_of_ideal_eq_span {X : Scheme.{u}} (D : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) (U : X.affineOpens) {f : Γ(X, (U : X.Opens))}
    (hf : D.ideal U = Ideal.span {f}) : f ∈ nonZeroDivisors Γ(X, (U : X.Opens)) := by
  have hloc : ∀ x : (U : X.Opens), ∃ W : X.affineOpens, (x : X) ∈ (W : Set X) ∧
      ∃ hWU : (W : X.Opens) ≤ U,
        X.presheaf.map (homOfLE hWU).op f ∈ nonZeroDivisors Γ(X, (W : X.Opens)) := by
    intro x
    obtain ⟨V, hxV, h, hh, hV⟩ :=
      Stacks.CartierAffineLocal.exists_affineOpen_nonZeroDivisor D hD x
    obtain ⟨W, hxW, hWUV⟩ := Stacks.CartierAffineLocal.exists_affineOpens_le (x := (x : X))
      ((U : X.Opens) ⊓ V) ⟨x.2, hxV⟩
    have hWU : W ≤ U := fun y hy => (hWUV hy).1
    have hWV : W ≤ V := fun y hy => (hWUV hy).2
    have e1 := D.map_ideal hWU
    rw [hf, Ideal.map_span, Set.image_singleton] at e1
    have e2 := D.map_ideal hWV
    rw [hV, Ideal.map_span, Set.image_singleton] at e2
    exact ⟨W, hxW, hWU, Stacks.Divisors.mem_nonZeroDivisors_of_span_singleton_eq
      (e1.trans e2.symm) (Stacks.Divisors.mem_nonZeroDivisors_res V.2 hh hWV)⟩
  choose W hxW hWU hW using hloc
  have key : ∀ r : Γ(X, (U : X.Opens)), r * f = 0 → r = 0 := by
    intro r hr
    refine Stacks.Divisors.eq_of_locally_eq (fun x => (W x : X.Opens)) U
      (fun x => homOfLE (hWU x)) (fun y hy => TopologicalSpace.Opens.mem_iSup.2
        ⟨⟨y, hy⟩, hxW ⟨y, hy⟩⟩) r 0 fun x => ?_
    rw [map_zero]
    refine (mul_right_mem_nonZeroDivisors_eq_zero_iff (hW x)).1 ?_
    rw [← map_mul, hr, map_zero]
  exact mem_nonZeroDivisors_iff.2 ⟨fun r hr => key r (by rw [mul_comm]; exact hr), key⟩

section Derived

attribute [local instance 10000] HasDerivedCategory.standard

open Stacks.Eta.DerivedDescent (moduleDerivedEta)

variable (R : CommRingCat.{u}) (D : (Spec R).IdealSheafData)
  [Stacks.Divisors.IsEffectiveCartierDivisor D]

/-- A generator `f ∈ Γ(Spec R, ⊤)` of the ideal of an effective Cartier divisor `D = V(f)` is a
nonzerodivisor. -/
theorem mem_nonZeroDivisors_of_ideal_top_eq_span {f : GammaTop R}
    (hf : D.ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ = Ideal.span {f}) :
    f ∈ nonZeroDivisors (GammaTop R) :=
  mem_nonZeroDivisors_of_ideal_eq_span D ‹_› ⟨⊤, isAffineOpen_top (Spec R)⟩ hf

/-- **The derived décalages on `Spec(A)` correspond, for `D = V(f)`.** Let `D ⊆ Spec R` be an
effective Cartier divisor with ideal sheaf `I` whose ideal in `A = Γ(Spec R, ⊤)` is generated by
`f`. Then `(-)^~ ⋙ Lη_I ≅ Lη_f ⋙ (-)^~` as functors `D(A) ⥤ D(𝒪_{Spec R})`, where `(-)^~` is
derived sheafification, `Lη_I` is the functor of [Stacks, Tag 0F8Q] and `Lη_f` the functor of
[Stacks, Tag 0F7R], `f` being a nonzerodivisor by `mem_nonZeroDivisors_of_ideal_top_eq_span`.

The generator `f` comes from a section `g` of `I` over `Spec R` generating `I` there
(`Stacks.Divisors.Eta.exists_generatesIdealOn_of_ideal_eq_span`), and the isomorphism is
`Stacks.Divisors.Eta.derivedEtaAffineComparison` at `g`. -/
def derivedEtaAffineComparisonOfIdealEqSpan (f : GammaTop R)
    (hf : D.ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ = Ideal.span {f}) :
    derivedTildeGamma R ⋙ (derivedEtaData D).functor ≅
      moduleDerivedEta f (mem_nonZeroDivisors_of_ideal_top_eq_span R D hf) ⋙
        derivedTildeGamma R := by
  have hex := exists_generatesIdealOn_of_ideal_eq_span D ⟨⊤, isAffineOpen_top (Spec R)⟩ hf
    (mem_nonZeroDivisors_of_ideal_top_eq_span R D hf)
  generalize mem_nonZeroDivisors_of_ideal_top_eq_span R D hf = hfz
  have hg : Stacks.IdealTorsion.GeneratesIdealOn (Spec R).toRingedSpace ⊤ hex.choose :=
    hex.choose_spec.1
  have he : globalGenerator R D hex.choose = f := hex.choose_spec.2
  generalize hex.choose = g at hg he
  clear hex
  subst he
  exact derivedEtaAffineComparison R D g hg hfz

end Derived

attribute [local instance 10000] HasDerivedCategory.standard in
/-- **[Stacks, Tag 0GTV].** Let `X` be a scheme and let `D ⊆ X` be an effective Cartier divisor
with ideal sheaf `I ⊆ 𝒪_X`. The functor `Lη_I : D(𝒪_X) ⥤ D(𝒪_X)` of [Stacks, Tag 0F8Q] sends
`D_QCoh(𝒪_X)` into itself: if every cohomology sheaf `H^n(K)` of `K` is quasi-coherent, so is
every cohomology sheaf of `Lη_I K`.
Moreover, if `X = Spec(A)` is affine and `D = V(f)` — the ideal of `D` in `A = Γ(X, 𝒪_X)` is
generated by `f` — then the functor `Lη_f` on `D(A)` of [Stacks, Tag 0F7R] and the functor `Lη_I`
correspond via the equivalence `(-)^~ : D(A) ≌ D_QCoh(𝒪_X)` of [Stacks, Tag 06Z0]:
`(-)^~ ⋙ Lη_I ≅ Lη_f ⋙ (-)^~`.

The functor `Lη_f` is defined because `f` is a nonzerodivisor, which follows from the
hypotheses (`Stacks.Divisors.Eta.mem_nonZeroDivisors_of_ideal_top_eq_span`). -/
@[stacks 0GTV]
theorem derivedEta_isQuasicoherent_and_affineComparison :
    (∀ (X : Scheme.{u}) (D : X.IdealSheafData) [Stacks.Divisors.IsEffectiveCartierDivisor D]
        (K : DerivedCategory X.Modules),
        (∀ n : ℤ, ((DerivedCategory.homologyFunctor X.Modules n).obj K).IsQuasicoherent) →
          ∀ n : ℤ, ((DerivedCategory.homologyFunctor X.Modules n).obj
            ((derivedEtaData D).functor.obj K)).IsQuasicoherent) ∧
      ∀ (R : CommRingCat.{u}) (D : (Spec R).IdealSheafData)
        [Stacks.Divisors.IsEffectiveCartierDivisor D] (f : GammaTop R)
        (hf : D.ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ = Ideal.span {f}),
        Nonempty (derivedTildeGamma R ⋙ (derivedEtaData D).functor ≅
          Stacks.Eta.DerivedDescent.moduleDerivedEta f
              (mem_nonZeroDivisors_of_ideal_top_eq_span R D hf) ⋙
            derivedTildeGamma R) :=
  ⟨fun _ D _ K hK => derivedCategoryB_isQuasicoherent_obj D (derivedEtaData D) K hK,
    fun R D _ f hf => ⟨derivedEtaAffineComparisonOfIdealEqSpan R D f hf⟩⟩

end Stacks.Divisors.Eta

end
