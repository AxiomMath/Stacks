module

public import StacksFrontier.AlgebraicGeometry.Divisors.IdealSheafPullbackComap
public import StacksFrontier.AlgebraicGeometry.RelativeProjQcohSheaf.AffineGeneration

/-!
# The ideal sheaf of the inverse image of a closed subscheme of an affine scheme

Let `h : Y ⟶ X` be a morphism of schemes with `X` affine and let `D ⊆ X` be a closed subscheme
whose ideal sheaf is quasi-coherent. Then the ideal sheaf of the scheme-theoretic inverse image
`h^{-1}D`, which is `I · 𝒪_Y` for `I` the ideal of `D`, is generated by global sections.
Nothing is assumed about `h`.

## Main definitions

* `Stacks.Divisors.comapIdealGeneratingSections`: the generating family, indexed by the whole
  module of global sections of the ideal sheaf of `D`.

## References

* [Stacks Project, Tag 01JU](https://stacks.math.columbia.edu/tag/01JU)
* [Stacks Project, Tag 01PK](https://stacks.math.columbia.edu/tag/01PK)
* [Stacks Project, Tag 0B4Y](https://stacks.math.columbia.edu/tag/0B4Y)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace Stacks.Divisors

/-- **The ideal sheaf of the inverse image of a closed subscheme of an affine scheme is generated
by global sections.** For `h : Y ⟶ X` an arbitrary morphism of schemes with `X` affine and `D` a
closed subscheme of `X` whose ideal sheaf is quasi-coherent, the global sections of `ℐ_D`
generate `ℐ_{h^{-1}D}`, the index type of the family being all of `Γ(X, ℐ_D)`. -/
def comapIdealGeneratingSections {X Y : Scheme.{u}} (h : Y ⟶ X) [IsAffine X]
    (D : X.IdealSheafData) (hD : (Eta.idealSheaf D).IsQuasicoherent) :
    (Eta.idealSheaf (D.comap h)).GeneratingSections where
  I := (Eta.idealSheaf D).sections
  s := (Eta.idealSheaf (D.comap h)).freeHomEquiv
    (Stacks.AlgebraicGeometry.RelativeProjQcohSheaf.pullbackGenHom h (Eta.idealSheaf D) ≫
      pullbackIdealSheafComapMap h D)
  epi := by
    rw [Equiv.symm_apply_apply]
    exact @epi_comp _ _ _ _ _ _
      (Stacks.AlgebraicGeometry.RelativeProjQcohSheaf.epi_pullbackGenHom h (Eta.idealSheaf D) hD)
      _ (epi_pullbackIdealSheafComapMap h D)

end Stacks.Divisors

end
