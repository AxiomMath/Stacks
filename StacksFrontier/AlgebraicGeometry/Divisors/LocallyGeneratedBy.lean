module

public import StacksFrontier.AlgebraicGeometry.LocallyPrincipalPullback.Basic

/-!
# Ideal sheaves locally generated by a bounded number of sections

This file defines the condition on an ideal sheaf that every point has an affine open neighbourhood
on which the ideal is generated by `r` sections.

For `r = 1` this is `Stacks.Divisors.IsLocallyPrincipal`. The predicate is monotone in `r`, it is
inherited by inverse images along an arbitrary morphism of schemes, and the join of an ideal sheaf
locally generated by `r` sections with one locally generated by `s` sections is locally generated
by `r + s` sections.

## Main definitions

* `Stacks.Divisors.IsLocallyGeneratedBy`: every point has an affine open neighbourhood on which
  the ideal is generated by a given number of sections.

## Main results

* `Stacks.Divisors.IsLocallyGeneratedBy.mono`: the predicate is monotone in the number of
  generators.
* `Stacks.Divisors.IsLocallyGeneratedBy.comap`: the inverse image of an ideal sheaf locally
  generated by `r` sections is locally generated by `r` sections.
* `Stacks.Divisors.IsLocallyGeneratedBy.sup`: the join of two ideal sheaves is locally generated
  by the sum of their local generator counts.
* `Stacks.Divisors.isLocallyGeneratedBy_of_ideal_top`: on an affine scheme a finite generating
  set of the ideal of global sections bounds the local generator count.

## Implementation notes

The generators are indexed by `Fin r` rather than collected into a finite set, so that repetition
is allowed and the predicate is automatically monotone in `r` by padding with zeros.

## References

* [Stacks Project, Tag 0EVI](https://stacks.math.columbia.edu/tag/0EVI)
* [Stacks Project, Tag 01WR](https://stacks.math.columbia.edu/tag/01WR)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.Divisors

/-- An ideal sheaf is *locally generated by `r` sections* when every point has an affine open
neighbourhood on which its ideal is generated by `r` sections.

For `r = 1` this is `Stacks.Divisors.IsLocallyPrincipal`. -/
def IsLocallyGeneratedBy (r : ℕ) {X : Scheme.{u}} (I : X.IdealSheafData) : Prop :=
  ∀ x : X, ∃ (U : X.affineOpens), x ∈ (U : Set X) ∧
    ∃ g : Fin r → Γ(X, U.1), I.ideal U = Ideal.span (Set.range g)

/-! ### Elementary properties -/

/-- The image of an ideal generated by `r` elements is generated by their images. -/
theorem ideal_map_span_range {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) {r : ℕ}
    (g : Fin r → R) :
    Ideal.map φ (Ideal.span (Set.range g)) = Ideal.span (Set.range (φ ∘ g)) := by
  rw [Ideal.map_span, ← Set.range_comp]

/-- The range of the concatenation of two families is the union of their ranges. -/
theorem range_fin_append {R : Type*} {r s : ℕ} (g : Fin r → R) (h : Fin s → R) :
    Set.range (Fin.append g h) = Set.range g ∪ Set.range h := by
  refine Set.Subset.antisymm ?_ ?_
  · rintro _ ⟨i, rfl⟩
    induction i using Fin.addCases
    · exact Or.inl ⟨_, by rw [Fin.append_left]⟩
    · exact Or.inr ⟨_, by rw [Fin.append_right]⟩
  · rintro _ (⟨j, rfl⟩ | ⟨j, rfl⟩)
    · exact ⟨Fin.castAdd s j, Fin.append_left g h j⟩
    · exact ⟨Fin.natAdd r j, Fin.append_right g h j⟩

/-- A family indexed by `Fin 1` spans the same ideal as its single value. -/
theorem span_range_fin_one {R : Type*} [CommRing R] (g : Fin 1 → R) :
    Ideal.span (Set.range g) = Ideal.span {g 0} := by
  congr 1
  ext y
  simp only [Set.mem_range, Set.mem_singleton_iff]
  refine ⟨?_, fun hy ↦ ⟨0, hy.symm⟩⟩
  rintro ⟨i, hi⟩
  rw [Fin.fin_one_eq_zero i] at hi
  exact hi.symm

/-- Being generated by `r` elements transports along an equality of carrier rings together with a
heterogeneous equality of ideals. -/
theorem spanRange_heq {A B : CommRingCat.{u}} (hAB : A = B) {J : Ideal A} {K : Ideal B}
    (hJK : HEq J K) {r : ℕ} (hJ : ∃ g : Fin r → A, J = Ideal.span (Set.range g)) :
    ∃ g : Fin r → B, K = Ideal.span (Set.range g) := by
  cases hAB
  simpa only [eq_of_heq hJK] using hJ

/-- Padding a generating family with zeros: an ideal generated by `r` elements is generated by
`s` elements for every `s ≥ r`. -/
theorem exists_span_range_of_le {R : Type*} [CommRing R] {r s : ℕ} (hrs : r ≤ s) {J : Ideal R}
    (h : ∃ g : Fin r → R, J = Ideal.span (Set.range g)) :
    ∃ g : Fin s → R, J = Ideal.span (Set.range g) := by
  obtain ⟨g, rfl⟩ := h
  refine ⟨fun i ↦ if hi : (i : ℕ) < r then g ⟨i, hi⟩ else 0, le_antisymm ?_ ?_⟩
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨i, rfl⟩
    exact Ideal.subset_span ⟨⟨i, lt_of_lt_of_le i.2 hrs⟩, dif_pos i.2⟩
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨i, rfl⟩
    show (if hi : (i : ℕ) < r then g ⟨i, hi⟩ else 0) ∈ (Ideal.span (Set.range g) : Set R)
    by_cases hi : (i : ℕ) < r
    · rw [dif_pos hi]
      exact Ideal.subset_span ⟨⟨i, hi⟩, rfl⟩
    · rw [dif_neg hi]
      exact (Ideal.span (Set.range g)).zero_mem

/-- The local generator count is monotone. -/
theorem IsLocallyGeneratedBy.mono {r s : ℕ} (hrs : r ≤ s) {X : Scheme.{u}}
    {I : X.IdealSheafData} (h : IsLocallyGeneratedBy r I) : IsLocallyGeneratedBy s I := by
  intro x
  obtain ⟨U, hxU, hg⟩ := h x
  exact ⟨U, hxU, exists_span_range_of_le hrs hg⟩

/-- An ideal sheaf locally generated by one section is locally principal, and conversely. -/
theorem isLocallyGeneratedBy_one_iff_isLocallyPrincipal {X : Scheme.{u}}
    {I : X.IdealSheafData} : IsLocallyGeneratedBy 1 I ↔ IsLocallyPrincipal I := by
  refine ⟨fun h x ↦ ?_, fun h x ↦ ?_⟩
  · obtain ⟨U, hxU, g, hg⟩ := h x
    exact ⟨U, hxU, ⟨g 0, by rw [hg, span_range_fin_one]⟩⟩
  · obtain ⟨U, hxU, a, ha⟩ := h x
    exact ⟨U, hxU, fun _ ↦ a, by rw [ha, span_range_fin_one]⟩

/-- A locally principal ideal sheaf is locally generated by one section. -/
theorem IsLocallyPrincipal.isLocallyGeneratedBy_one {X : Scheme.{u}} {I : X.IdealSheafData}
    (h : IsLocallyPrincipal I) : IsLocallyGeneratedBy 1 I :=
  isLocallyGeneratedBy_one_iff_isLocallyPrincipal.2 h

/-! ### Shrinking the affine open -/

/-- A generating family of the ideal of an ideal sheaf on an affine open restricts to a
generating family on every smaller affine open. -/
theorem exists_span_range_of_affineOpens_le {X : Scheme.{u}} (I : X.IdealSheafData) {r : ℕ}
    {U V : X.affineOpens} (hVU : V ≤ U) (h : ∃ g : Fin r → Γ(X, U.1), I.ideal U =
      Ideal.span (Set.range g)) :
    ∃ g : Fin r → Γ(X, V.1), I.ideal V = Ideal.span (Set.range g) := by
  obtain ⟨g, hg⟩ := h
  refine ⟨fun i ↦ (X.presheaf.map (homOfLE (show V.1 ≤ U.1 from hVU)).op).hom (g i), ?_⟩
  rw [← I.map_ideal hVU, hg, ideal_map_span_range]
  rfl

/-- Two affine opens through a point contain a common affine open through it. -/
theorem exists_affineOpens_le_inf {X : Scheme.{u}} {x : X} {U V : X.affineOpens}
    (hxU : x ∈ (U : Set X)) (hxV : x ∈ (V : Set X)) :
    ∃ W : X.affineOpens, x ∈ (W : Set X) ∧ W ≤ U ∧ W ≤ V := by
  obtain ⟨_, ⟨W, hW, rfl⟩, hxW, hWUV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (show x ∈ U.1.1 ⊓ V.1.1 from ⟨hxU, hxV⟩)
      (U.1.isOpen.inter V.1.isOpen)
  exact ⟨⟨W, hW⟩, hxW, fun y hy ↦ (hWUV hy).1, fun y hy ↦ (hWUV hy).2⟩

/-! ### The join -/

/-- **The join of two ideal sheaves is locally generated by the sum of their generator counts.**
-/
theorem IsLocallyGeneratedBy.sup {r s : ℕ} {X : Scheme.{u}} {I J : X.IdealSheafData}
    (hI : IsLocallyGeneratedBy r I) (hJ : IsLocallyGeneratedBy s J) :
    IsLocallyGeneratedBy (r + s) (I ⊔ J) := by
  intro x
  obtain ⟨U, hxU, hgU⟩ := hI x
  obtain ⟨V, hxV, hgV⟩ := hJ x
  obtain ⟨W, hxW, hWU, hWV⟩ := exists_affineOpens_le_inf hxU hxV
  obtain ⟨g, hg⟩ := exists_span_range_of_affineOpens_le I hWU hgU
  obtain ⟨h, hh⟩ := exists_span_range_of_affineOpens_le J hWV hgV
  refine ⟨W, hxW, Fin.append g h, ?_⟩
  rw [show (I ⊔ J).ideal W = I.ideal W ⊔ J.ideal W from rfl, hg, hh,
    ← Ideal.span_union, range_fin_append]

/-! ### Inverse images -/

/-- The sections of `U` as a scheme over its top open agree with the sections of `X` over `U`. -/
private theorem gamma_top_toScheme_eq {X : Scheme.{u}} (U : X.Opens) :
    Γ(U.toScheme, ⊤) = Γ(X, U) := by
  show Γ(X, (Scheme.Hom.opensFunctor U.ι).obj ⊤) = Γ(X, U)
  rw [Scheme.Opens.ι_image_top]

/-- **The inverse image of an ideal sheaf locally generated by `r` sections is locally generated
by `r` sections.** -/
theorem IsLocallyGeneratedBy.comap {r : ℕ} {X Y : Scheme.{u}} (f : X ⟶ Y)
    {I : Y.IdealSheafData} (hI : IsLocallyGeneratedBy r I) :
    IsLocallyGeneratedBy r (I.comap f) := by
  intro x
  obtain ⟨U, hxU, hgU⟩ := hI (f x)
  change f x ∈ U.1 at hxU
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVU⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open
      (show x ∈ f ⁻¹ᵁ U.1 from hxU) (f ⁻¹ᵁ U.1).isOpen
  let V' : X.affineOpens := ⟨V, hV⟩
  have hVU' : V ≤ f ⁻¹ᵁ U.1 := hVU
  let g : Scheme.Opens.toScheme V ⟶ U.1.toScheme := f.resLE U.1 V hVU'
  have hfactor : g ≫ U.1.ι = Scheme.Opens.ι V ≫ f := Scheme.Hom.resLE_comp_ι f hVU'
  have hcomp : (I.comap f).comap (Scheme.Opens.ι V) = (I.comap U.1.ι).comap g := by
    rw [← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp, hfactor]
  have : IsAffine (Scheme.Opens.toScheme V) := hV
  have : IsAffine U.1.toScheme := U.2
  have htop := Stacks.IdealSheaf.ideal_comap_top_of_isAffine (I.comap U.1.ι) g
  have hbase := ideal_comap_top_heq I U
  have hbaseG : ∃ g' : Fin r → Γ(U.1.toScheme, ⊤),
      (I.comap U.1.ι).ideal ⟨⊤, isAffineOpen_top U.1.toScheme⟩ = Ideal.span (Set.range g') :=
    spanRange_heq (gamma_top_toScheme_eq U.1).symm hbase.symm hgU
  have htarget := ideal_comap_top_heq (I.comap f) V'
  rw [hcomp] at htarget
  have hlocal : ∃ g' : Fin r → Γ(Scheme.Opens.toScheme V, ⊤),
      ((I.comap U.1.ι).comap g).ideal ⟨⊤, isAffineOpen_top (Scheme.Opens.toScheme V)⟩ =
        Ideal.span (Set.range g') := by
    obtain ⟨g', hg'⟩ := hbaseG
    exact ⟨fun i ↦ (g.appTop).hom (g' i), by rw [htop, hg', ideal_map_span_range]; rfl⟩
  exact ⟨V', hxV, spanRange_heq (gamma_top_toScheme_eq V) htarget hlocal⟩

/-! ### On an affine scheme -/

/-- **On an affine scheme a generating family of the ideal of global sections bounds the local
generator count.** -/
theorem isLocallyGeneratedBy_of_ideal_top {r : ℕ} {X : Scheme.{u}} [IsAffine X]
    {I : X.IdealSheafData} {g : Fin r → Γ(X, ⊤)}
    (hg : I.ideal ⟨⊤, isAffineOpen_top X⟩ = Ideal.span (Set.range g)) :
    IsLocallyGeneratedBy r I :=
  fun _ ↦ ⟨⟨⊤, isAffineOpen_top X⟩, trivial, g, hg⟩

end Stacks.Divisors

end
