module

public import StacksFrontier.AlgebraicGeometry.Divisors.QuasicoherentIdealSheafData.Basic
public import StacksFrontier.AlgebraicGeometry.Scheme.Immersion.IdealSheafQuasicoherent
public import StacksFrontier.AlgebraicGeometry.SheafComplexLocality.Basic

/-!
# Quasi-coherent sheaves of ideals and closed subschemes

Let `X` be a scheme and `J ⊆ 𝒪_X` a sheaf of ideals, presented as a submodule of the unit sheaf
of modules. Three conditions on `J` agree: being locally generated by sections, being
quasi-coherent, and being the kernel of the structure map of a closed immersion of schemes into
`X`.

## Main results

* `Stacks.Divisors.subschemeι_app_eq_zero_iff_mem_of_isQuasicoherent`: for quasi-coherent `J`,
  over an *arbitrary* open the sections killed by the closed immersion
  `Stacks.Divisors.idealSheafDataOfSubmodule` cuts out are exactly the sections of `J`.
* `Stacks.Divisors.isQuasicoherent_of_ker_app_eq`: a sheaf of ideals that is the kernel of the
  structure map of a closed immersion of schemes is quasi-coherent — the implication (3) ⇒ (2).
* `Stacks.Divisors.isQuasicoherent_ideal_tfae`: the equivalence of the three conditions.

## References

* [Stacks Project, Tag 01IN](https://stacks.math.columbia.edu/tag/01IN)
* [Stacks Project, Tag 01QQ](https://stacks.math.columbia.edu/tag/01QQ)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace Opposite
open RingedSpaceModuleAdjunction

universe u

namespace Stacks.Divisors

variable {X : Scheme.{u}}

/-! ### The implication (2) ⇒ (3) over an arbitrary open -/

/-- Over an arbitrary open, the closed subscheme cut out by a quasi-coherent `J` kills exactly
the sections of `J`. -/
theorem subschemeι_app_eq_zero_iff_mem_of_isQuasicoherent
    (J : (SheafOfModules.unit X.ringCatSheaf).Submodule)
    [(J.toSheafOfModules : X.Modules).IsQuasicoherent] (V : X.Opens) (s : Γ(X, V)) :
    (idealSheafDataOfSubmodule J).subschemeι.app V s = 0 ↔ s ∈ J.obj (op V) := by
  refine ⟨fun h => J.isSheaf s fun x hx => ?_, subschemeι_app_eq_zero_of_mem J V s⟩
  obtain ⟨W, hW, hxW, hWV⟩ :=
    Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens (U := V) (x := x) hx
  refine ⟨W, homOfLE hWV, ?_, hxW⟩
  show X.presheaf.map (homOfLE hWV).op s ∈ J.obj (op W)
  rw [← subschemeι_app_eq_zero_iff_mem J ⟨W, hW⟩]
  have hnat := ConcreteCategory.congr_hom
    ((idealSheafDataOfSubmodule J).subschemeι.naturality (homOfLE hWV).op) s
  rw [CommRingCat.comp_apply, CommRingCat.comp_apply] at hnat
  rw [hnat, h, map_zero]

/-! ### The implication (3) ⇒ (2) -/

section Ker

variable {Z : Scheme.{u}} (J : (SheafOfModules.unit X.ringCatSheaf).Submodule) (i : Z ⟶ X)

/-- The map `𝒪_X ⟶ i_* 𝒪_Z` of a morphism of schemes, read as a morphism of sheaves of
`𝒪_X`-modules. Its kernel is `Stacks.ClosedImmersion.idealSheaf i`. -/
abbrev structureModuleHom : SheafOfModules.unit X.ringCatSheaf ⟶
    (SheafOfModules.pushforward i.toRingCatSheafHom).obj (SheafOfModules.unit Z.ringCatSheaf) :=
  SheafOfModules.unitToPushforwardObjUnit i.toRingCatSheafHom

/-- The comparison from a sheaf of ideals killed by `𝒪_X ⟶ i_* 𝒪_Z` to the ideal sheaf of `i`,
the kernel of `𝒪_X ⟶ i_* 𝒪_Z`. -/
def toIdealSheafOfKer
    (hJ : ∀ (V : X.Opens) (s : Γ(X, V)), s ∈ J.obj (op V) → i.app V s = 0) :
    J.toSheafOfModules ⟶ kernel (structureModuleHom i) :=
  kernel.lift (structureModuleHom i) J.ι (by
    refine SheafOfModules.hom_ext (PresheafOfModules.Hom.ext (funext fun V => ?_))
    exact ModuleCat.hom_ext (LinearMap.ext fun y => hJ V.unop y.1 y.2))

/-- The comparison `toIdealSheafOfKer` followed by the inclusion of the kernel is the inclusion
of `J`. -/
@[reassoc]
lemma toIdealSheafOfKer_ι
    (hJ : ∀ (V : X.Opens) (s : Γ(X, V)), s ∈ J.obj (op V) → i.app V s = 0) :
    toIdealSheafOfKer J i hJ ≫ kernel.ι (structureModuleHom i) = J.ι :=
  kernel.lift_ι _ _ _

/-- A sheaf of ideals which is the kernel of a closed immersion is quasi-coherent. -/
theorem isQuasicoherent_of_ker_app_eq [IsClosedImmersion i]
    (hJ : ∀ V : X.Opens, RingHom.ker (i.app V).hom = J.obj (op V)) :
    (J.toSheafOfModules : X.Modules).IsQuasicoherent := by
  have hmem : ∀ (V : X.Opens) (s : Γ(X, V)), s ∈ J.obj (op V) ↔ i.app V s = 0 := fun V s => by
    rw [← hJ V]; exact RingHom.mem_ker
  set φ := toIdealSheafOfKer J i (fun V s hs => (hmem V s).1 hs) with hφ
  have hfac : φ ≫ kernel.ι (structureModuleHom i) = J.ι := toIdealSheafOfKer_ι J i _
  have hmono : Mono φ := mono_of_mono_fac hfac
  have hepi : Epi φ := by
    refine Stacks.SheafOfModules.ComplexLocality.epi_of_isLocallySurjective φ
      (Presheaf.isLocallySurjective_of_surjective _ _ fun V y => ?_)
    have hy : i.app V.unop ((kernel.ι (structureModuleHom i)).val.app V y) = 0 :=
      Stacks.SheafOfModules.ComplexLocality.app_kernel_ι_app (structureModuleHom i) V y
    have hx := (hmem V.unop _).2 hy
    exact ⟨⟨_, hx⟩, Stacks.SheafOfModules.ComplexLocality.injective_kernel_ι_app
      (structureModuleHom i) V
      (congrArg (fun f : J.toSheafOfModules ⟶ SheafOfModules.unit X.ringCatSheaf =>
        f.val.app V ⟨_, hx⟩) hfac)⟩
  have : IsIso φ := isIso_of_mono_of_epi φ
  exact ObjectProperty.prop_of_iso
    (SheafOfModules.isQuasicoherent X.ringCatSheaf) (asIso φ).symm
    (Stacks.AlgebraicGeometry.ClosedImmersionTFAE.isQuasicoherent_idealSheaf i)

end Ker

/-! ### The equivalence -/

/-- For a sheaf of ideals `J ⊆ 𝒪_X` on a scheme the following are
equivalent: `J` is locally generated by sections as a sheaf of `𝒪_X`-modules; `J` is
quasi-coherent; and there is a closed immersion of schemes `i : Z ⟶ X` whose ideal sheaf
`Ker(i^♯)` is `J`, in the sense that over every open the kernel of `i.app` is the ideal that `J`
cuts out there. -/
@[stacks 01QQ "the full equivalence: (1) locally generated by sections, (2) quasi-coherent, \
(3) the kernel of a closed immersion of schemes"]
theorem isQuasicoherent_ideal_tfae (J : (SheafOfModules.unit X.ringCatSheaf).Submodule) :
    List.TFAE [
      Nonempty (SheafOfModules.LocalGeneratorsData.{u} J.toSheafOfModules),
      (J.toSheafOfModules : X.Modules).IsQuasicoherent,
      ∃ (Z : Scheme.{u}) (i : Z ⟶ X), IsClosedImmersion i ∧
        ∀ V : X.Opens, RingHom.ker (i.app V).hom = J.obj (op V)] := by
  tfae_have 1 ↔ 2 := (Stacks.ClosedImmersion.isQuasicoherent_iff_localGenerators X J).symm
  tfae_have 2 → 3 := fun _ =>
    ⟨(idealSheafDataOfSubmodule J).subscheme, (idealSheafDataOfSubmodule J).subschemeι,
      inferInstance, fun V => Ideal.ext fun s =>
        (RingHom.mem_ker (f := ((idealSheafDataOfSubmodule J).subschemeι.app V).hom)).trans
          (subschemeι_app_eq_zero_iff_mem_of_isQuasicoherent J V s)⟩
  tfae_have 3 → 2 := fun ⟨_, i, _, hJ⟩ => isQuasicoherent_of_ker_app_eq J i hJ
  tfae_finish

end Stacks.Divisors

end
