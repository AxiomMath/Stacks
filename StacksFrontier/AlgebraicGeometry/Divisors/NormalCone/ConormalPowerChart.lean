module

public import StacksFrontier.AlgebraicGeometry.Divisors.NormalCone.Functoriality
public import StacksFrontier.AlgebraicGeometry.Divisors.RegularImmersion.ConormalSections

/-!
# The conormal algebra of a principal chart with a nonzerodivisor generator

Let `i : Z ⟶ X` be an immersion and `U` an affine open of `X` on which `i` restricts to a closed
immersion, so that the ideal of the chart is `ℐ(U) = ker(Γ(X, U) ⟶ Γ(Z, i⁻¹U))`. Suppose that
ideal is generated by a single element `f` which is a nonzerodivisor — the local shape of an
effective Cartier divisor, [Stacks, Tag 01WS].

Then in every degree `n` the homogeneous piece `𝒞_{Z/X,n} = ℐⁿ/ℐⁿ⁺¹` of the conormal algebra of
[Stacks, Tag 0630] is **free of rank one over the chart**, generated by the class of `fⁿ`:

* every local section over `i⁻¹U` is a multiple of that class, because `ℐⁿ = (fⁿ)`;
* and no nonzero function annihilates it, because `a·fⁿ ∈ (f^{n+1})` forces `a ∈ (f)` when `f`
  is a nonzerodivisor, and `(f) = ℐ(U)` is exactly the kernel.

This is the sense in which "the normal cone of an effective Cartier divisor is a line bundle":
it is the degreewise statement that the surjection `Symⁿ(ℐ/ℐ²) ⟶ ℐⁿ/ℐⁿ⁺¹` of [Stacks, Tag 0632]
has a free rank-one target.

## Main results

* `Stacks.Conormal.chartIdeal_pow_eq_span_pow`: `ℐ(U)ⁿ = (fⁿ)` when `ℐ(U) = (f)`.
* `Stacks.Conormal.ConormalAlgebraData.exists_smul_localMap_pow`: **every homogeneous local
  section over a principal chart is a multiple of the class of `fⁿ`.**
* `Stacks.Conormal.ConormalAlgebraData.eq_zero_of_smul_localMap_pow`: **the class of `fⁿ` is
  annihilated by no nonzero function**, when `f` is a nonzerodivisor.
* `Stacks.Conormal.ConormalAlgebraData.bijective_smul_localMap_pow`: the two together, as
  bijectivity of `s ↦ s • [fⁿ]`: **`𝒞_{Z/X,n}` is free of rank one on the chart.**

## Implementation notes

Everything is stated for an arbitrary `Stacks.Conormal.ConormalAlgebraData i` rather than for
`Stacks.Conormal.conormalAlgebra i`: the local associated-graded presentations `localMap` are the
only input, so a statement about them holds of any graded algebra carrying them.

The generator is written `D.localMap U hU n ⟨f ^ n, _⟩` rather than as an `n`-fold product of
the degree-one class of `f`; `Stacks.Conormal.ConormalAlgebraData.localMap_mul` identifies the
two, and the chosen spelling is the one in which the membership side condition
`fⁿ ∈ ℐ(U)ⁿ` is discharged by `Stacks.Conormal.chartIdeal_pow_eq_span_pow` once.

## References

* [Stacks Project, Tag 0630](https://stacks.math.columbia.edu/tag/0630)
* [Stacks Project, Tag 0632](https://stacks.math.columbia.edu/tag/0632)
* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite

universe u

namespace Stacks.Conormal

variable {Z X : Scheme.{u}}

/-! ### Powers of a principal chart ideal -/

/-- **The `n`-th power of a principal chart ideal is generated by the `n`-th power of its
generator.** -/
theorem chartIdeal_pow_eq_span_pow (i : Z ⟶ X) [IsImmersion i] (U : X.affineOpens)
    {f : Γ(X, U.1)} (hf : chartIdeal i U = Ideal.span {f}) (n : ℕ) :
    chartIdeal i U ^ n = Ideal.span {f ^ n} := by
  rw [hf, Ideal.span_singleton_pow]

/-- The `n`-th power of the generator, as an element of the `n`-th power of a principal chart
ideal. -/
def chartIdealPowGen (i : Z ⟶ X) [IsImmersion i] (U : X.affineOpens) {f : Γ(X, U.1)}
    (hf : chartIdeal i U = Ideal.span {f}) (n : ℕ) : ↥(chartIdeal i U ^ n) :=
  ⟨f ^ n, by rw [chartIdeal_pow_eq_span_pow i U hf]; exact Ideal.mem_span_singleton_self _⟩

/-- The underlying section of `chartIdealPowGen i U hf n` is `f ^ n`. -/
@[simp]
theorem chartIdealPowGen_coe (i : Z ⟶ X) [IsImmersion i] (U : X.affineOpens) {f : Γ(X, U.1)}
    (hf : chartIdeal i U = Ideal.span {f}) (n : ℕ) :
    ((chartIdealPowGen i U hf n : ↥(chartIdeal i U ^ n)) : Γ(X, U.1)) = f ^ n := rfl

/-! ### Freeness of the homogeneous pieces over a principal chart -/

/-- The class of a multiple `c·fⁿ` of the generator is the corresponding multiple of the class
of `fⁿ`. -/
private theorem ConormalAlgebraData.localMap_eq_smul_localMap_pow {i : Z ⟶ X} [IsImmersion i]
    (D : ConormalAlgebraData i) (U : X.affineOpens)
    (hU : IsClosedImmersion (i.resLE U.1 (i ⁻¹ᵁ U.1) le_rfl)) {f : Γ(X, U.1)}
    (hf : chartIdeal i U = Ideal.span {f}) (n : ℕ) (c : Γ(X, U.1))
    (a : ↥(chartIdeal i U ^ n)) (h : (a : Γ(X, U.1)) = c * f ^ n) :
    D.localMap U hU n a = (show Z.ringCatSheaf.obj.obj (op (i ⁻¹ᵁ U.1)) from (i.app U).hom c) •
      D.localMap U hU n (chartIdealPowGen i U hf n) :=
  D.localMap_smul U hU n c _ a (by rw [chartIdealPowGen_coe]; exact h)

/-- **Over a principal chart every homogeneous local section of the conormal algebra is a
multiple of the class of `fⁿ`.** A degree-`n` section over `i⁻¹U` is the class of an element of
`ℐ(U)ⁿ = (fⁿ)`, hence of `c·fⁿ` for some `c ∈ Γ(X, U)`, and the local presentations are linear
for the restriction `Γ(X, U) ⟶ Γ(Z, i⁻¹U)`. -/
theorem ConormalAlgebraData.exists_smul_localMap_pow {i : Z ⟶ X} [IsImmersion i]
    (D : ConormalAlgebraData i) (U : X.affineOpens)
    (hU : IsClosedImmersion (i.resLE U.1 (i ⁻¹ᵁ U.1) le_rfl)) {f : Γ(X, U.1)}
    (hf : chartIdeal i U = Ideal.span {f}) (n : ℕ)
    (x : (D.algebra.piece (n : ℤ)).val.obj (op (i ⁻¹ᵁ U.1))) :
    ∃ s : Z.ringCatSheaf.obj.obj (op (i ⁻¹ᵁ U.1)),
      s • D.localMap U hU n (chartIdealPowGen i U hf n) = x := by
  obtain ⟨a, ha⟩ := D.localMap_surjective U hU n x
  have hmem : (a : Γ(X, U.1)) ∈ Ideal.span {f ^ n} := by
    rw [← chartIdeal_pow_eq_span_pow i U hf]; exact a.2
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 hmem
  refine ⟨(i.app U).hom c, ?_⟩
  rw [← ha]
  exact (D.localMap_eq_smul_localMap_pow U hU hf n c a hc.symm).symm

/-- **Over a principal chart with a nonzerodivisor generator the class of `fⁿ` is annihilated by
no nonzero function.** A function on the chart lifts to `Γ(X, U)`, and its lift `c` annihilates
the class exactly when `c·fⁿ ∈ ℐ(U)ⁿ⁺¹ = (fⁿ⁺¹)`; cancelling `fⁿ` leaves `c ∈ (f) = ℐ(U)`, which
is the kernel of the restriction. -/
theorem ConormalAlgebraData.eq_zero_of_smul_localMap_pow {i : Z ⟶ X} [IsImmersion i]
    (D : ConormalAlgebraData i) (U : X.affineOpens)
    (hU : IsClosedImmersion (i.resLE U.1 (i ⁻¹ᵁ U.1) le_rfl)) {f : Γ(X, U.1)}
    (hf : chartIdeal i U = Ideal.span {f}) (hfreg : f ∈ nonZeroDivisors Γ(X, U.1)) (n : ℕ)
    (s : Z.ringCatSheaf.obj.obj (op (i ⁻¹ᵁ U.1)))
    (hs : s • D.localMap U hU n (chartIdealPowGen i U hf n) = 0) : s = 0 := by
  obtain ⟨c, hcs⟩ := app_surjective_of_closedRestriction i U hU s
  have hcmem : c * f ^ n ∈ chartIdeal i U ^ n := by
    rw [chartIdeal_pow_eq_span_pow i U hf]
    exact Ideal.mem_span_singleton'.2 ⟨c, rfl⟩
  have hzero : D.localMap U hU n ⟨c * f ^ n, hcmem⟩ = 0 := by
    rw [D.localMap_eq_smul_localMap_pow U hU hf n c _ rfl, hcs, hs]
  rw [D.localMap_eq_zero_iff, chartIdeal_pow_eq_span_pow i U hf] at hzero
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.1 hzero
  have hbc : b * f ^ (n + 1) = c * f ^ n := hb
  have hcancel : (c - b * f) * f ^ n = 0 := by linear_combination -hbc
  have hcf : c = b * f :=
    sub_eq_zero.1 ((mem_nonZeroDivisors_iff.1 (pow_mem hfreg n)).2 _ hcancel)
  rw [← hcs, hcf]
  change b * f ∈ chartIdeal i U
  rw [hf]; exact Ideal.mem_span_singleton'.2 ⟨b, rfl⟩

/-- **Over a principal chart with a nonzerodivisor generator the degree-`n` piece of the
conormal algebra is free of rank one, generated by the class of `fⁿ`**: the map
`s ↦ s • [fⁿ]` from the functions on the chart to the degree-`n` sections is bijective. -/
theorem ConormalAlgebraData.bijective_smul_localMap_pow {i : Z ⟶ X} [IsImmersion i]
    (D : ConormalAlgebraData i) (U : X.affineOpens)
    (hU : IsClosedImmersion (i.resLE U.1 (i ⁻¹ᵁ U.1) le_rfl)) {f : Γ(X, U.1)}
    (hf : chartIdeal i U = Ideal.span {f}) (hfreg : f ∈ nonZeroDivisors Γ(X, U.1)) (n : ℕ) :
    Function.Bijective fun s : Z.ringCatSheaf.obj.obj (op (i ⁻¹ᵁ U.1)) =>
      s • D.localMap U hU n (chartIdealPowGen i U hf n) := by
  refine ⟨fun s t hst => ?_, fun x => D.exists_smul_localMap_pow U hU hf n x⟩
  have h : (s - t) • D.localMap U hU n (chartIdealPowGen i U hf n) = 0 := by
    rw [sub_smul]
    exact sub_eq_zero.2 hst
  exact sub_eq_zero.1 (D.eq_zero_of_smul_localMap_pow U hU hf hfreg n _ h)

end Stacks.Conormal

end
