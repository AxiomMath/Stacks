/-! ### Sections of a sheaf of modules along a morphism -/

private lemma appLE_apply {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens)
    (h : V ≤ f ⁻¹ᵁ U) (r : Γ(Y, U)) :
    (f.appLE U V h).hom r = X.presheaf.map (homOfLE h).op ((f.app U).hom r) := rfl

/-- Restricting a section along `U ≤ U` does nothing. -/
lemma presheaf_map_homOfLE_self {X : Scheme.{u}} {V : X.Opens} (h : V ≤ V) (x : Γ(X, V)) :
    X.presheaf.map (homOfLE h).op x = x := by
  rw [show (homOfLE h).op = 𝟙 (op V) from rfl, X.presheaf.map_id]
  rfl

/-- The sections over `f ⁻¹ᵁ W` obtained from a morphism into a pushforward.  This is
`ψ.app W` read at the type `Γ(N, f ⁻¹ᵁ W)` rather than at the pushforward sheaf. -/
private def pushforwardSection {X Y : Scheme.{u}} (f : X ⟶ Y) {F : Y.Modules} {N : X.Modules}
    (ψ : F ⟶ (Scheme.Modules.pushforward f).obj N) (W : Y.Opens) :
    Γ(F, W) →+ Γ(N, f ⁻¹ᵁ W) := (ψ.app W).hom

private lemma pushforwardSection_smul {X Y : Scheme.{u}} (f : X ⟶ Y) {F : Y.Modules}
    {N : X.Modules} (ψ : F ⟶ (Scheme.Modules.pushforward f).obj N) (W : Y.Opens)
    (r : Γ(Y, W)) (a : Γ(F, W)) :
    pushforwardSection f ψ W (r • a) = (f.app W).hom r • pushforwardSection f ψ W a :=
  Scheme.Modules.Hom.app_smul ψ r a

/-- A morphism of sheaves of modules commutes with restriction of sections. -/
private lemma hom_app_restrict {X : Scheme.{u}} {M N : X.Modules} (φ : M ⟶ N) {U V : X.Opens}
    (h : V ≤ U) (a : Γ(M, U)) :
    φ.app V (M.presheaf.map (homOfLE h).op a) = N.presheaf.map (homOfLE h).op (φ.app U a) :=
  congrArg (fun k => k a) (φ.mapPresheaf.naturality (homOfLE h).op)

private lemma pushforwardSection_naturality {X Y : Scheme.{u}} (f : X ⟶ Y) {F : Y.Modules}
    {N : X.Modules} (ψ : F ⟶ (Scheme.Modules.pushforward f).obj N) (W W' : Y.Opens)
    (hW : W' ≤ W) (a : Γ(F, W)) :
    pushforwardSection f ψ W' (F.presheaf.map (homOfLE hW).op a) =
      N.presheaf.map (homOfLE (f.preimage_mono hW)).op (pushforwardSection f ψ W a) :=
  hom_app_restrict ψ hW a

/-- A morphism into a pushforward, evaluated on sections over `W` and restricted to an open
`V ⊆ f⁻¹W`. -/
private def sectionMap {X Y : Scheme.{u}} (f : X ⟶ Y) {F : Y.Modules} {N : X.Modules}
    (ψ : F ⟶ (Scheme.Modules.pushforward f).obj N)
    (V : X.Opens) (W : Y.Opens) (h : V ≤ f ⁻¹ᵁ W) : Γ(F, W) →+ Γ(N, V) :=
  (N.presheaf.map (homOfLE h).op).hom.comp (pushforwardSection f ψ W)

private lemma sectionMap_apply {X Y : Scheme.{u}} (f : X ⟶ Y) {F : Y.Modules} {N : X.Modules}
    (ψ : F ⟶ (Scheme.Modules.pushforward f).obj N)
    (V : X.Opens) (W : Y.Opens) (h : V ≤ f ⁻¹ᵁ W) (a : Γ(F, W)) :
    sectionMap f ψ V W h a =
      N.presheaf.map (homOfLE h).op (pushforwardSection f ψ W a) := rfl

private lemma sectionMap_smul {X Y : Scheme.{u}} (f : X ⟶ Y) {F : Y.Modules} {N : X.Modules}
    (ψ : F ⟶ (Scheme.Modules.pushforward f).obj N)
    (V : X.Opens) (W : Y.Opens) (h : V ≤ f ⁻¹ᵁ W) (r : Γ(Y, W)) (a : Γ(F, W)) :
    sectionMap f ψ V W h (r • a) = (f.appLE W V h).hom r • sectionMap f ψ V W h a := by
  rw [sectionMap_apply, sectionMap_apply, pushforwardSection_smul,
    Scheme.Modules.map_smul, appLE_apply]

private lemma sectionMap_restrict_target {X Y : Scheme.{u}}
    (f : X ⟶ Y) {F : Y.Modules} {N : X.Modules}
    (ψ : F ⟶ (Scheme.Modules.pushforward f).obj N)
    (V V' : X.Opens) (W : Y.Opens) (h : V ≤ f ⁻¹ᵁ W) (h' : V' ≤ V) (a : Γ(F, W)) :
    N.presheaf.map (homOfLE h').op (sectionMap f ψ V W h a) =
      sectionMap f ψ V' W (h'.trans h) a := by
  rw [sectionMap_apply, sectionMap_apply, ← N.presheaf.map_comp_apply]
  rfl

private lemma sectionMap_restrict_source {X Y : Scheme.{u}}
    (f : X ⟶ Y) {F : Y.Modules} {N : X.Modules}
    (ψ : F ⟶ (Scheme.Modules.pushforward f).obj N)
    (V : X.Opens) (W W' : Y.Opens) (h : V ≤ f ⁻¹ᵁ W) (h' : V ≤ f ⁻¹ᵁ W')
    (hW : W' ≤ W) (a : Γ(F, W)) :
    sectionMap f ψ V W' h' (F.presheaf.map (homOfLE hW).op a) = sectionMap f ψ V W h a := by
  rw [sectionMap_apply, sectionMap_apply, pushforwardSection_naturality,
    ← N.presheaf.map_comp_apply]
  rfl

/-! ### Gluing sections and morphisms along a basis -/

/-- Sections of a sheaf of modules agree if they agree on an open cover. -/
private lemma sections_ext_of_cover {X : Scheme.{u}} (N : X.Modules) {ι : Type*}
    (V : ι → X.Opens) {U : X.Opens} (hV : ∀ j, V j ≤ U) (hcov : ∀ x ∈ U, ∃ j, x ∈ V j)
    {a b : Γ(N, U)}
    (h : ∀ j, N.presheaf.map (homOfLE (hV j)).op a = N.presheaf.map (homOfLE (hV j)).op b) :
    a = b :=
  TopCat.Sheaf.eq_of_locally_eq' ⟨N.presheaf, N.isSheaf⟩ V U (fun j => homOfLE (hV j))
    (fun x hx => Opens.mem_iSup.mpr (hcov x hx)) a b h

private lemma sections_ext_of_basis {X : Scheme.{u}} (N : X.Modules)
    {ι : Type*} (B : ι → X.Opens) (hB : Opens.IsBasis (Set.range B))
    {U : X.Opens} (a b : Γ(N, U))
    (h : ∀ j (hj : B j ≤ U), N.presheaf.map (homOfLE hj).op a =
      N.presheaf.map (homOfLE hj).op b) : a = b := by
  refine sections_ext_of_cover N (fun j : {j // B j ≤ U} => B j.1) (fun j => j.2) ?_
    (fun j => h j.1 j.2)
  intro x hx
  obtain ⟨V, ⟨j, rfl⟩, hxj, hj⟩ := Opens.isBasis_iff_nbhd.mp hB hx
  exact ⟨⟨j, hj⟩, hxj⟩

private lemma exists_hom_of_basis {X : Scheme.{u}} {G N : X.Modules}
    {ι : Type*} (B : ι → X.Opens) (hB : Opens.IsBasis (Set.range B))
    (d : ∀ j, Γ(G, B j) →+ Γ(N, B j))
    (hs : ∀ j (r : Γ(X, B j)) a, d j (r • a) = r • d j a)
    (hn : ∀ j k (h : B k ≤ B j) a,
      N.presheaf.map (homOfLE h).op (d j a) = d k (G.presheaf.map (homOfLE h).op a)) :
    ∃ r : G ⟶ N, ∀ j a, Scheme.Modules.Hom.app r (B j) a = d j a := by
  let β : (inducedFunctor B).op ⋙ G.presheaf ⟶ (inducedFunctor B).op ⋙ N.presheaf :=
    { app := fun j => AddCommGrpCat.ofHom (d j.unop)
      naturality := by
        intro j k h
        ext a
        exact (hn j.unop k.unop (leOfHom ((inducedFunctor B).map h.unop)) a).symm }
  let α := TopCat.Sheaf.restrictHomEquivHom G.presheaf ⟨N.presheaf, N.isSheaf⟩ hB β
  have hα j : α.app (op (B j)) = AddCommGrpCat.ofHom (d j) :=
    TopCat.Sheaf.extend_hom_app (B := B) G.presheaf ⟨N.presheaf, N.isSheaf⟩ hB β j
  have hαa j (a : Γ(G, B j)) : α.app (op (B j)) a = d j a := congrArg (fun k => k a) (hα j)
  have hnat {U V : X.Opens} (h : V ≤ U) (a : Γ(G, U)) :
      N.presheaf.map (homOfLE h).op (α.app (op U) a) =
        α.app (op V) (G.presheaf.map (homOfLE h).op a) :=
    (congrArg (fun k => k a) (α.naturality (homOfLE h).op)).symm
  have hsmul (U : X.Opens) (r : Γ(X, U)) (a : Γ(G, U)) :
      α.app (op U) (r • a) = r • α.app (op U) a := by
    apply sections_ext_of_basis N B hB
    intro j hj
    rw [hnat, G.map_smul, hαa, hs, N.map_smul, hnat, hαa]
  exact ⟨⟨PresheafOfModules.homMk α fun U r a => hsmul U.unop r a⟩, fun j a => hαa j a⟩

private lemma epi_of_span_on_basis {Z Z' : Scheme.{u}} (f : Z ⟶ Z')
    {F : Z'.Modules} {G : Z.Modules} (φ : (Scheme.Modules.pullback f).obj F ⟶ G)
    {ι : Type*} (B : ι → Z.Opens) (hB : Opens.IsBasis (Set.range B))
    (W : ι → Z'.Opens) (hBW : ∀ j, B j ≤ f ⁻¹ᵁ W j)
    (hspan : ∀ j, Submodule.span Γ(Z, B j)
      (Set.range fun a : Γ(F, W j) =>
        sectionMap f (((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _) φ)
          (B j) (W j) (hBW j) a) = ⊤) :
    Epi φ := by
  constructor
  intro N p q hpq
  have h := congrArg ((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv F N) hpq
  rw [Adjunction.homEquiv_naturality_right, Adjunction.homEquiv_naturality_right] at h
  apply (Scheme.Modules.toPresheaf Z).map_injective
  apply TopCat.Sheaf.hom_ext G.presheaf ⟨N.presheaf, N.isSheaf⟩ hB
  intro j
  ext y
  have hy := Submodule.eq_top_iff'.mp (hspan j) y
  show p.app (B j) y = q.app (B j) y
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨a, rfl⟩ := hy
    simp only [sectionMap_apply, hom_app_restrict]
    exact congrArg (N.presheaf.map (homOfLE (hBW j)).op)
      (congrArg (fun ψ => pushforwardSection f ψ (W j) a) h)
  | zero => simp
  | add x y hx hy ihx ihy => simp only [map_add, ihx, ihy]
  | smul r x hx ih => simp only [Scheme.Modules.Hom.app_smul, ih]

/-! ### Base change of an associated graded piece

Everything in this section is a statement about a map of commutative rings; none of it mentions
schemes.  This keeps the quotients and tensor products below out of the elaborator's way when
the scheme-theoretic statements are assembled. -/

/-- If an additive map out of `J ^ n` is semilinear over `σ` and sends every `φ a` with
`a ∈ I ^ n` into a submodule `P`, then it sends the whole of the extended ideal
`(I ^ n).map φ` into `P`. -/
private lemma mem_of_mem_map_pow {A B C T : Type*} [CommRing A] [CommRing B] [CommRing C]
    [AddCommGroup T] [Module C T] (φ : A →+* B) (σ : B →+* C)
    (I : Ideal A) (J : Ideal B) (hJ : J = I.map φ) (n : ℕ)
    (L : ↥(J ^ n) →+ T) (P : Submodule C T)
    (hsmul : ∀ (r : B) (a b : ↥(J ^ n)), (b : B) = r * (a : B) → L b = σ r • L a)
    (hgen : ∀ (a : A), a ∈ I ^ n → ∀ h : φ a ∈ J ^ n, L ⟨φ a, h⟩ ∈ P)
    (x : B) (hmap : x ∈ (I ^ n).map φ) (hx : x ∈ J ^ n) :
    L ⟨x, hx⟩ ∈ P := by
  have hpow : ∀ {y : B}, y ∈ (I ^ n).map φ → y ∈ J ^ n := fun hy => by
    rwa [hJ, ← Ideal.map_pow]
  revert hx
  induction hmap using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨a, ha, rfl⟩ := hy
    exact hgen a ha
  | zero =>
    intro h
    have h0 : (⟨0, h⟩ : ↥(J ^ n)) = 0 := Subtype.ext rfl
    rw [h0, map_zero]
    exact P.zero_mem
  | add y z hy hz ihy ihz =>
    intro h
    have he : (⟨y + z, h⟩ : ↥(J ^ n)) = ⟨y, hpow hy⟩ + ⟨z, hpow hz⟩ := Subtype.ext rfl
    rw [he, map_add]
    exact P.add_mem (ihy (hpow hy)) (ihz (hpow hz))
  | smul r y hy ih =>
    intro h
    rw [hsmul r ⟨y, hpow hy⟩ ⟨r • y, h⟩ (smul_eq_mul r y)]
    exact P.smul_mem _ (ih (hpow hy))

/-- A ring map sends `Iⁿ` into `(IS)ⁿ`. -/
private lemma algebraMap_mem_power {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (I : Ideal R) (n : ℕ) {x : R} (hx : x ∈ AssociatedGraded.power (M := R) I n) :
    algebraMap R S x ∈ AssociatedGraded.power (M := S) (I.map (algebraMap R S)) n := by
  rw [AssociatedGraded.ring_power_eq, ← Ideal.map_pow]
  exact Ideal.mem_map_of_mem _ (by rwa [← AssociatedGraded.ring_power_eq])

/-- The map `Iⁿ/Iⁿ⁺¹ ⟶ (IS)ⁿ/(IS)ⁿ⁺¹` induced by a ring map `R ⟶ S`. -/
private noncomputable def associatedGradedBaseChangeLinearMap
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (I : Ideal R) (n : ℕ) :
    AssociatedGraded.piece (M := R) I n →ₗ[R]
      AssociatedGraded.piece (M := S) (I.map (algebraMap R S)) n := by
  let P := AssociatedGraded.power (M := R) I n
  let Q := (AssociatedGraded.power (M := R) I (n + 1)).comap (Submodule.subtype P)
  let P' := AssociatedGraded.power (M := S) (I.map (algebraMap R S)) n
  let Q' := (AssociatedGraded.power (M := S) (I.map (algebraMap R S)) (n + 1)).comap
    (Submodule.subtype P')
  let qMap : P →ₗ[R] P' :=
    { toFun := fun x => ⟨algebraMap R S (x : R), algebraMap_mem_power I n x.2⟩
      map_add' x y := by
        ext
        simp
      map_smul' := by
        intro r x
        ext
        simp only [Submodule.coe_smul, Submodule.coe_smul_of_tower,
          Algebra.smul_def, map_mul]
        simp }
  exact Q.liftQ ((Q'.mkQ.restrictScalars R).comp qMap) (by
    intro x hx
    rw [LinearMap.mem_ker, LinearMap.comp_apply, LinearMap.restrictScalars_apply,
      Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact algebraMap_mem_power I (n + 1) hx)

/-- The base-change map `S ⊗_R Iⁿ/Iⁿ⁺¹ ⟶ (IS)ⁿ/(IS)ⁿ⁺¹`. -/
private noncomputable def associatedGradedBaseChangeMap
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (I : Ideal R) (n : ℕ) :
    S ⊗[R] AssociatedGraded.piece (M := R) I n →ₗ[S]
      AssociatedGraded.piece (M := S) (I.map (algebraMap R S)) n :=
  LinearMap.liftBaseChange S (associatedGradedBaseChangeLinearMap I n)

private theorem associatedGradedBaseChangeMap_tmul_mk
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (I : Ideal R) (n : ℕ) (a : AssociatedGraded.power (M := R) I n) (s : S) :
    associatedGradedBaseChangeMap I n
        (s ⊗ₜ[R] AssociatedGraded.mk I n a) =
      s • AssociatedGraded.mk (I.map (algebraMap R S)) n
        (⟨algebraMap R S (a : R), algebraMap_mem_power I n a.2⟩) := by
  simp [associatedGradedBaseChangeMap, associatedGradedBaseChangeLinearMap,
    LinearMap.liftBaseChange_tmul, AssociatedGraded.mk]

private theorem associatedGradedBaseChangeMap_surjective
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (I : Ideal R) (n : ℕ) :
    Function.Surjective (associatedGradedBaseChangeMap (S := S) I n) := by
  let F := associatedGradedBaseChangeMap (S := S) I n
  rw [← LinearMap.range_eq_top, eq_top_iff]
  intro y _
  induction y using Submodule.Quotient.induction_on with
  | _ b =>
    have hb : (b : S) ∈ Ideal.map (algebraMap R S) (I ^ n) := by
      simpa [← Ideal.map_pow] using b.property
    show AssociatedGraded.mk _ n b ∈ F.range
    have hpow : ∀ {x : S}, x ∈ Ideal.map (algebraMap R S) (I ^ n) →
        x ∈ AssociatedGraded.power (M := S) (I.map (algebraMap R S)) n := fun h => by
      rwa [AssociatedGraded.ring_power_eq, ← Ideal.map_pow]
    have aux : ∀ (x : S), x ∈ Ideal.map (algebraMap R S) (I ^ n) →
        ∀ (hx : x ∈ AssociatedGraded.power (M := S) (I.map (algebraMap R S)) n),
        AssociatedGraded.mk _ n ⟨x, hx⟩ ∈ F.range := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨a, ha, rfl⟩ := hx
        intro hx
        exact ⟨1 ⊗ₜ[R] AssociatedGraded.mk I n ⟨a, by simpa using ha⟩,
          by
            simpa [F] using (associatedGradedBaseChangeMap_tmul_mk I n
              ⟨a, by simpa using ha⟩ (1 : S))⟩
      | zero =>
        intro hx
        exact ⟨0, by
          show F 0 = AssociatedGraded.mk _ n 0
          simp [AssociatedGraded.mk]⟩
      | add x y hx hy ihx ihy =>
        exact fun _ => F.range.add_mem (ihx (hpow hx)) (ihy (hpow hy))
      | smul s x hx ih =>
        exact fun _ => F.range.smul_mem s (ih (hpow hx))
    exact aux b hb b.property

/-- The injection `Iⁿ/Iⁿ⁺¹ ⟶ R/Iⁿ⁺¹`. -/
private def associatedGradedToQuotient {R : Type*} [CommRing R] (I : Ideal R) (n : ℕ) :
    AssociatedGraded.piece (M := R) I n →ₗ[R] R ⧸ I ^ (n + 1) :=
  ((AssociatedGraded.power (M := R) I (n + 1)).comap
    (AssociatedGraded.power (M := R) I n).subtype).liftQ
      ((I ^ (n + 1)).mkQ.comp (AssociatedGraded.power (M := R) I n).subtype)
      (by
        intro x hx
        change Ideal.Quotient.mk (I ^ (n + 1)) (x : R) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (by simpa using hx))

private theorem associatedGradedToQuotient_injective {R : Type*} [CommRing R]
    (I : Ideal R) (n : ℕ) : Function.Injective (associatedGradedToQuotient I n) := by
  rw [← LinearMap.ker_eq_bot]
  apply bot_unique
  intro x hx
  induction x using Submodule.Quotient.induction_on with
  | _ a =>
    change associatedGradedToQuotient I n (Submodule.Quotient.mk a) = 0 at hx
    change Submodule.Quotient.mk (a : R) = (0 : R ⧸ I ^ (n + 1)) at hx
    show Submodule.Quotient.mk a = (0 : AssociatedGraded.piece (M := R) I n)
    rw [Submodule.Quotient.mk_eq_zero]
    simpa using (Ideal.Quotient.eq_zero_iff_mem.mp hx)

/-- The identification `S ⊗_R R/J ≃ S/JS`. -/
private noncomputable def tensorRingQuotientEquiv
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] (J : Ideal R) :
    S ⊗[R] (R ⧸ J) ≃ₗ[R] S ⧸ J.map (algebraMap R S) :=
  (TensorProduct.tensorQuotEquivQuotSMul S J).trans
    ((Submodule.quotEquivOfEq _ _ (Ideal.smul_top_eq_map J)).trans
      (Submodule.Quotient.restrictScalarsEquiv R (J.map (algebraMap R S))))

private theorem tensorRingQuotientEquiv_tmul_mk
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (J : Ideal R) (s : S) (r : R) :
    tensorRingQuotientEquiv (S := S) J (s ⊗ₜ[R] Ideal.Quotient.mk J r) =
      Ideal.Quotient.mk (J.map (algebraMap R S)) (s * algebraMap R S r) := by
  simp [tensorRingQuotientEquiv, Algebra.smul_def, mul_comm]

private theorem associatedGradedBaseChangeMap_injective
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
    (I : Ideal R) (n : ℕ) :
    Function.Injective (associatedGradedBaseChangeMap (S := S) I n) := by
  let j := associatedGradedToQuotient I n
  let J := (I.map (algebraMap R S)) ^ (n + 1)
  let e : S ⊗[R] (R ⧸ I ^ (n + 1)) ≃ₗ[R] S ⧸ J :=
    (tensorRingQuotientEquiv (S := S) (I ^ (n + 1))).trans
      ((Submodule.quotEquivOfEq _ _ (Ideal.map_pow _ _ _)).restrictScalars R)
  have he (s : S) (r : R) : e (s ⊗ₜ[R] Ideal.Quotient.mk (I ^ (n + 1)) r) =
      Ideal.Quotient.mk J (s * algebraMap R S r) := by
    show (Submodule.quotEquivOfEq _ _ (Ideal.map_pow _ _ _))
      (tensorRingQuotientEquiv (I ^ (n + 1)) (s ⊗ₜ[R] Ideal.Quotient.mk _ r)) = _
    rw [tensorRingQuotientEquiv_tmul_mk]
    rfl
  have hinj : Function.Injective (e.toLinearMap.comp (j.lTensor S)) :=
    e.injective.comp (Module.Flat.lTensor_preserves_injective_linearMap j
      (associatedGradedToQuotient_injective I n))
  have heq : e.toLinearMap.comp (j.lTensor S) =
      ((associatedGradedToQuotient (I.map (algebraMap R S)) n).restrictScalars R).comp
        ((associatedGradedBaseChangeMap (S := S) I n).restrictScalars R) := by
    apply TensorProduct.ext'
    intro s a
    induction a using Submodule.Quotient.induction_on with
    | _ a =>
      show e (s ⊗ₜ[R] (associatedGradedToQuotient I n) (AssociatedGraded.mk I n a)) =
        associatedGradedToQuotient (I.map (algebraMap R S)) n
          (associatedGradedBaseChangeMap I n (s ⊗ₜ[R] AssociatedGraded.mk I n a))
      rw [associatedGradedBaseChangeMap_tmul_mk, map_smul]
      show e (s ⊗ₜ[R] Ideal.Quotient.mk (I ^ (n + 1)) (a : R)) =
        s • Ideal.Quotient.mk J (algebraMap R S (a : R))
      rw [he]
      exact J.mkQ.map_smul s (algebraMap R S (a : R))
  rw [heq] at hinj
  exact fun x y hxy => hinj (congrArg (associatedGradedToQuotient (I.map (algebraMap R S)) n) hxy)

/-- Transport of the associated graded pieces along an equality of ideals. -/
private def associatedGradedCongr {R : Type*} [CommRing R]
    {I J : Ideal R} (h : I = J) (n : ℕ) :
    AssociatedGraded.piece (M := R) I n ≃ₗ[R] AssociatedGraded.piece (M := R) J n := by
  subst J
  exact LinearEquiv.refl R _

private lemma associatedGradedCongr_mk {R : Type*} [CommRing R]
    {I J : Ideal R} (h : I = J) (n : ℕ) (a : AssociatedGraded.power (M := R) I n) :
    associatedGradedCongr h n (AssociatedGraded.mk I n a) =
      AssociatedGraded.mk (M := R) J n ⟨(a : R), by simpa [← h] using a.property⟩ := by
  subst J
  rfl

private theorem associatedGradedBaseChangeMap_bijective
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
    (I : Ideal R) (n : ℕ) :
    Function.Bijective (associatedGradedBaseChangeMap (S := S) I n) :=
  ⟨associatedGradedBaseChangeMap_injective I n,
    associatedGradedBaseChangeMap_surjective I n⟩

/-- For a flat ring map `R ⟶ S` and an ideal `J` of `S` extended from an ideal `I` of `R`,
the base-change comparison `S ⊗_R Iⁿ/Iⁿ⁺¹ ≃ Jⁿ/Jⁿ⁺¹`. -/
private noncomputable def associatedGradedBaseChangeEquiv
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
    (I : Ideal R) (J : Ideal S) (hJ : J = I.map (algebraMap R S)) (n : ℕ) :
    S ⊗[R] AssociatedGraded.piece (M := R) I n ≃ₗ[S]
      AssociatedGraded.piece (M := S) J n :=
  (LinearEquiv.ofBijective (associatedGradedBaseChangeMap I n)
      (associatedGradedBaseChangeMap_bijective I n)).trans
    (associatedGradedCongr hJ.symm n)

private lemma associatedGradedBaseChangeEquiv_tmul_mk
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
    (I : Ideal R) (J : Ideal S) (hJ : J = I.map (algebraMap R S)) (n : ℕ)
    (s : S) (a : AssociatedGraded.power (M := R) I n)
    (h : algebraMap R S (a : R) ∈ J ^ n) :
    associatedGradedBaseChangeEquiv I J hJ n (s ⊗ₜ[R] AssociatedGraded.mk I n a) =
      s • AssociatedGraded.mk (M := S) J n
        ⟨algebraMap R S (a : R), by rwa [AssociatedGraded.ring_power_eq]⟩ := by
  rw [associatedGradedBaseChangeEquiv, LinearEquiv.trans_apply,
    LinearEquiv.ofBijective_apply, associatedGradedBaseChangeMap_tmul_mk, map_smul,
    associatedGradedCongr_mk]

/-! ### The conormal algebra at the `Γ(M, U)` spelling -/

/-- The degree-`n` homogeneous piece `𝒞_{Z/X,n}` of the conormal algebra of an immersion
`i : Z ⟶ X`, as a sheaf of `𝒪_Z`-modules.
See [Stacks, Tag 0630](https://stacks.math.columbia.edu/tag/0630). -/
def conormalPiece {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i] (n : ℤ) : Z.Modules :=
  (Stacks.Conormal.conormalAlgebra i).algebra.piece n

/-- The canonical local map `Iⁿ ⟶ 𝒞_{Z/X,n}(i⁻¹U)` of Tag 0630 on an affine
closed-immersion chart. -/
private def conormalLocalMap {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i]
    (U : X.affineOpens) (hU : IsClosedImmersion (i.resLE U.1 (i ⁻¹ᵁ U.1) le_rfl)) (n : ℕ) :
    ↥(Stacks.Conormal.chartIdeal i U ^ n) →+ Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ U.1) :=
  (Stacks.Conormal.conormalAlgebra i).localMap U hU n

/-- The sectionwise morphism of conormal algebras of Tag 0634 over a pair of compatible
opens. -/
def conormalHomSection {Z X Z' X' : Scheme.{u}} (i : Z ⟶ X) (i' : Z' ⟶ X')
    (f : Z ⟶ Z') [IsImmersion i] [IsImmersion i'] (H : ConormalAlgebraHom i i' f)
    (n : ℤ) (V : Z.Opens) (W : Z'.Opens) (h : V ≤ f ⁻¹ᵁ W) :
    Γ(conormalPiece i' n, W) →+ Γ(conormalPiece i n, V) := H.map n V W h

/-- The sectionwise canonical morphism is linear over the structural map on functions. -/
lemma conormalHomSection_smul {Z X Z' X' : Scheme.{u}} (i : Z ⟶ X) (i' : Z' ⟶ X')
    (f : Z ⟶ Z') [IsImmersion i] [IsImmersion i'] (H : ConormalAlgebraHom i i' f)
    (n : ℤ) (V : Z.Opens) (W : Z'.Opens) (h : V ≤ f ⁻¹ᵁ W) (r : Γ(Z', W))
    (a : Γ(conormalPiece i' n, W)) :
    conormalHomSection i i' f H n V W h (r • a) =
      Z.presheaf.map (homOfLE h).op ((f.app W).hom r) •
        conormalHomSection i i' f H n V W h a :=
  H.map_smul n V W h r a

/-- The sectionwise canonical morphism commutes with restriction of the target open. -/
lemma conormalHomSection_restrict_target {Z X Z' X' : Scheme.{u}} (i : Z ⟶ X)
    (i' : Z' ⟶ X') (f : Z ⟶ Z') [IsImmersion i] [IsImmersion i']
    (H : ConormalAlgebraHom i i' f) (n : ℤ) (V V' : Z.Opens) (hV'V : V' ≤ V)
    (W : Z'.Opens) (hVW : V ≤ f ⁻¹ᵁ W) (a : Γ(conormalPiece i' n, W)) :
    (conormalPiece i n).presheaf.map (homOfLE hV'V).op
        (conormalHomSection i i' f H n V W hVW a) =
      conormalHomSection i i' f H n V' W (hV'V.trans hVW) a :=
  H.map_restrict_target n V V' hV'V W hVW a

/-- The sectionwise canonical morphism commutes with restriction of the source open. -/
lemma conormalHomSection_restrict_source {Z X Z' X' : Scheme.{u}} (i : Z ⟶ X)
    (i' : Z' ⟶ X') (f : Z ⟶ Z') [IsImmersion i] [IsImmersion i']
    (H : ConormalAlgebraHom i i' f) (n : ℤ) (V : Z.Opens) (W W' : Z'.Opens)
    (hW'W : W' ≤ W) (hVW' : V ≤ f ⁻¹ᵁ W') (hVW : V ≤ f ⁻¹ᵁ W)
    (a : Γ(conormalPiece i' n, W)) :
    conormalHomSection i i' f H n V W' hVW'
        ((conormalPiece i' n).presheaf.map (homOfLE hW'W).op a) =
      conormalHomSection i i' f H n V W hVW a :=
  H.map_restrict_source n V W W' hW'W hVW' hVW a

/-- The associated graded description `Iⁿ/Iⁿ⁺¹ ≃ 𝒞_{Z/X,n}(i⁻¹U)` of Tag 0633 on an affine
closed-immersion chart. -/
private def chartSectionsEquiv {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i]
    (U : X.affineOpens) (hU : IsClosedImmersion (i.resLE U.1 (i ⁻¹ᵁ U.1) le_rfl)) (n : ℕ) :
    AssociatedGraded.piece (M := Γ(X, U.1)) (Stacks.Conormal.chartIdeal i U) n ≃+
      Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ U.1) :=
  (affineSectionsEquiv i U hU).equiv n

private lemma chartSectionsEquiv_mk {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i]
    (U : X.affineOpens) (hU : IsClosedImmersion (i.resLE U.1 (i ⁻¹ᵁ U.1) le_rfl)) (n : ℕ)
    (a : AssociatedGraded.power (M := Γ(X, U.1)) (Stacks.Conormal.chartIdeal i U) n)
    (b : ↥(Stacks.Conormal.chartIdeal i U ^ n)) (hb : (b : Γ(X, U.1)) = (a : Γ(X, U.1))) :
    chartSectionsEquiv i U hU n (AssociatedGraded.mk (Stacks.Conormal.chartIdeal i U) n a) =
      conormalLocalMap i U hU n b := by
  rw [show b = ⟨(a : Γ(X, U.1)), by simpa using a.property⟩ from Subtype.ext hb]
  exact (affineSectionsEquiv i U hU).map_mk n a

private lemma chartSectionsEquiv_smul {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i]
    (U : X.affineOpens) (hU : IsClosedImmersion (i.resLE U.1 (i ⁻¹ᵁ U.1) le_rfl)) (n : ℕ)
    (r : Γ(X, U.1))
    (a : AssociatedGraded.piece (M := Γ(X, U.1)) (Stacks.Conormal.chartIdeal i U) n) :
    chartSectionsEquiv i U hU n (r • a) =
      (i.app U.1).hom r • chartSectionsEquiv i U hU n a :=
  (affineSectionsEquiv i U hU).map_smul n r a

/-- The chart identification of Tag 0633, as a `Γ(X, U)`-linear equivalence for a module
structure on the sections induced along `i`. -/
private def chartDegreeEquiv {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i]
    (U : X.affineOpens) (hU : IsClosedImmersion (i.resLE U.1 (i ⁻¹ᵁ U.1) le_rfl)) (n : ℕ)
    [Module Γ(X, U.1) Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ U.1)]
    (hs : ∀ (r : Γ(X, U.1)) (x : Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ U.1)),
      r • x = (i.app U.1).hom r • x) :
    AssociatedGraded.piece (M := Γ(X, U.1)) (Stacks.Conormal.chartIdeal i U) n ≃ₗ[Γ(X, U.1)]
      Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ U.1) :=
  { chartSectionsEquiv i U hU n with
    map_smul' := fun r a => (chartSectionsEquiv_smul i U hU n r a).trans (hs r _).symm }

private lemma chartDegreeEquiv_apply {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i]
    (U : X.affineOpens) (hU : IsClosedImmersion (i.resLE U.1 (i ⁻¹ᵁ U.1) le_rfl)) (n : ℕ)
    [Module Γ(X, U.1) Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ U.1)]
    (hs : ∀ (r : Γ(X, U.1)) (x : Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ U.1)),
      r • x = (i.app U.1).hom r • x)
    (a : AssociatedGraded.piece (M := Γ(X, U.1)) (Stacks.Conormal.chartIdeal i U) n) :
    chartDegreeEquiv i U hU n hs a = chartSectionsEquiv i U hU n a := rfl

/-! ### Affine charts of a square of immersions -/

/-- For a cartesian square of schemes whose bottom row `i'` restricts to a **closed** immersion
over an affine open `U'`, the sections over `U'`, over `U`, over `i'⁻¹U'` and over `i⁻¹U` form a
pushout square of rings.

The general versions in the library (`Stacks.Morphisms.isPushout_appLE_of_isPullback`,
`Stacks.Flatness.isPushout_appLE_of_isPullback`) assume a morphism of the square to be globally
affine, resp. a globally closed immersion; here only the restriction of `i'` over the chart is
closed, which is what the charts of an immersion provide. -/
private lemma isPushout_appLE_of_closedRestriction
    {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    (sq : IsPullback i f g i')
    (U : X.affineOpens) (U' : X'.affineOpens) (hU : U.1 ≤ g ⁻¹ᵁ U'.1)
    [IsClosedImmersion (i'.resLE U'.1 (i' ⁻¹ᵁ U'.1) le_rfl)] :
    IsPushout (g.appLE U'.1 U.1 hU) (i'.app U'.1) (i.app U.1)
      (f.appLE (i' ⁻¹ᵁ U'.1) (i ⁻¹ᵁ U.1) (by
        simpa only [← Scheme.Hom.comp_preimage, sq.w] using i.preimage_mono hU)) := by
  have hle : i ⁻¹ᵁ U.1 ≤ f ⁻¹ᵁ (i' ⁻¹ᵁ U'.1) := by
    simpa only [← Scheme.Hom.comp_preimage, sq.w] using i.preimage_mono hU
  have hsq := Scheme.Hom.isPullback_resLE sq (US := U'.1) (UT := i' ⁻¹ᵁ U'.1)
    (UX := U.1) le_rfl hU (UY := i ⁻¹ᵁ U.1) (by exact (inf_eq_left.mpr hle).symm)
  have : IsAffine (i' ⁻¹ᵁ U'.1).toScheme :=
    isAffine_of_isAffineHom (i'.resLE U'.1 (i' ⁻¹ᵁ U'.1) le_rfl)
  have hr := isPushout_appTop_of_isPullback hsq
  refine hr.of_iso U'.1.topIso U.1.topIso (i' ⁻¹ᵁ U'.1).topIso
    (i ⁻¹ᵁ U.1).topIso ?_ ?_ ?_ ?_
  · exact (arrowResLEAppIso g U'.1 U.1 hU).hom.w.symm
  · rw [← Scheme.Hom.appLE_eq_app]
    exact (arrowResLEAppIso i' U'.1 (i' ⁻¹ᵁ U'.1) le_rfl).hom.w.symm
  · rw [← Scheme.Hom.appLE_eq_app]
    exact (arrowResLEAppIso i U.1 (i ⁻¹ᵁ U.1) le_rfl).hom.w.symm
  · exact (arrowResLEAppIso f (i' ⁻¹ᵁ U'.1) (i ⁻¹ᵁ U.1) hle).hom.w.symm

/-- An affine chart of a square of immersions: a pair of affine opens `U ⊆ X`, `U' ⊆ X'` with
`g(U) ⊆ U'` over which both `i` and `i'` restrict to closed immersions. -/
private structure ConormalChart {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (g : X ⟶ X') where
  source : X.affineOpens
  target : X'.affineOpens
  le_preimage : source.1 ≤ g ⁻¹ᵁ target.1
  source_closed : IsClosedImmersion (i.resLE source.1 (i ⁻¹ᵁ source.1) le_rfl)
  target_closed : IsClosedImmersion (i'.resLE target.1 (i' ⁻¹ᵁ target.1) le_rfl)

private lemma chart_preimage_le {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    (comm : f ≫ i' = i ≫ g) {U : X.Opens} {U' : X'.Opens}
    (hU : U ≤ g ⁻¹ᵁ U') : i ⁻¹ᵁ U ≤ f ⁻¹ᵁ (i' ⁻¹ᵁ U') := by
  simpa only [← Scheme.Hom.comp_preimage, ← comm] using i.preimage_mono hU

private lemma chart_app_square {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    (comm : f ≫ i' = i ≫ g) (C : ConormalChart i i' g) :
    i'.app C.target.1 ≫ f.appLE (i' ⁻¹ᵁ C.target.1) (i ⁻¹ᵁ C.source.1)
        (chart_preimage_le i i' f g comm C.le_preimage) =
      g.appLE C.target.1 C.source.1 C.le_preimage ≫ i.app C.source.1 := by
  simp only [← Scheme.Hom.appLE_eq_app, Scheme.Hom.appLE_comp_appLE, comm]

/-- Over an affine chart of a cartesian square the kernel ideal upstairs is generated by the
kernel ideal downstairs. -/
private lemma chart_ker_eq {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (sq : IsPullback i f g i') (C : ConormalChart i i' g) :
    Stacks.Conormal.chartIdeal i C.source =
      (Stacks.Conormal.chartIdeal i' C.target).map
        (g.appLE C.target.1 C.source.1 C.le_preimage).hom := by
  have : IsClosedImmersion (i'.resLE C.target.1 (i' ⁻¹ᵁ C.target.1) le_rfl) := C.target_closed
  exact ker_eq_map_ker_of_pushout
    (isPushout_appLE_of_closedRestriction i i' f g sq C.source C.target C.le_preimage)
    (app_surjective_of_closedRestriction i' C.target C.target_closed)

/-- Every point of `Z` has a chart whose source lies in a prescribed neighbourhood `Q` of its image
in `X` and whose target lies in a prescribed neighbourhood `P` of its image in `X'`. -/
private lemma exists_chart_nbhd {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g) (z : Z)
    (Q : X.Opens) (hQ : i z ∈ Q) (P : X'.Opens) (hP : g (i z) ∈ P) :
    ∃ C : ConormalChart i i' g, i z ∈ C.source.1 ∧ C.source.1 ≤ Q ∧ C.target.1 ≤ P := by
  have hz' : g (i z) ∈ P ⊓ i'.coborderRange := by
    refine ⟨hP, ?_⟩
    rw [← show i' (f z) = g (i z) from congrArg (fun h : Z ⟶ X' => h z) comm]
    exact subset_coborder ⟨f z, rfl⟩
  obtain ⟨U', hU'a, hzU', hU'⟩ := Opens.isBasis_iff_nbhd.mp X'.isBasis_affineOpens hz'
  have hz : i z ∈ Q ⊓ i.coborderRange ⊓ g ⁻¹ᵁ U' :=
    ⟨⟨hQ, subset_coborder ⟨z, rfl⟩⟩, hzU'⟩
  obtain ⟨U, hUa, hzU, hU⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens hz
  exact ⟨⟨⟨U, hUa⟩, ⟨U', hU'a⟩, hU.trans inf_le_right,
      isClosedImmersion_resLE_of_le_coborderRange i U (hU.trans (inf_le_left.trans inf_le_right)),
      isClosedImmersion_resLE_of_le_coborderRange i' U' (hU'.trans inf_le_right)⟩,
    hzU, hU.trans (inf_le_left.trans inf_le_left), hU'.trans inf_le_left⟩

private lemma conormalChart_isBasis {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g) :
    Opens.IsBasis (Set.range fun C : ConormalChart i i' g => i ⁻¹ᵁ C.source.1) := by
  rw [Opens.isBasis_iff_nbhd]
  intro O z hz
  have hb := (X.isBasis_affineOpens).of_isInducing i.isEmbedding.isInducing
  obtain ⟨V, ⟨U₀, hU₀, rfl⟩, hzU₀, hU₀O⟩ := Opens.isBasis_iff_nbhd.mp hb hz
  obtain ⟨C, hzC, hCU, -⟩ := exists_chart_nbhd i i' f g comm z U₀ hzU₀ ⊤ trivial
  exact ⟨i ⁻¹ᵁ C.source.1, ⟨C, rfl⟩, hzC, (i.preimage_mono hCU).trans hU₀O⟩

private lemma exists_common_chart {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g)
    (C D : ConormalChart i i' g) (z : Z)
    (hzC : z ∈ i ⁻¹ᵁ C.source.1) (hzD : z ∈ i ⁻¹ᵁ D.source.1) :
    ∃ E : ConormalChart i i' g,
      z ∈ i ⁻¹ᵁ E.source.1 ∧ E.source.1 ≤ C.source.1 ∧ E.source.1 ≤ D.source.1 ∧
        E.target.1 ≤ C.target.1 ∧ E.target.1 ≤ D.target.1 := by
  obtain ⟨E, hzE, hS, hT⟩ := exists_chart_nbhd i i' f g comm z (C.source.1 ⊓ D.source.1)
    ⟨hzC, hzD⟩ (C.target.1 ⊓ D.target.1) ⟨C.le_preimage hzC, D.le_preimage hzD⟩
  exact ⟨E, hzE, hS.trans inf_le_left, hS.trans inf_le_right, hT.trans inf_le_left,
    hT.trans inf_le_right⟩

private lemma exists_chart_over_open {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g)
    (W : Z'.Opens) (z : Z) (hz : f z ∈ W) :
    ∃ C : ConormalChart i i' g, z ∈ i ⁻¹ᵁ C.source.1 ∧ i' ⁻¹ᵁ C.target.1 ≤ W := by
  have hb := X'.isBasis_affineOpens.of_isInducing i'.isEmbedding.isInducing
  obtain ⟨V, ⟨U₀, hU₀, rfl⟩, hzU₀, hU₀W⟩ := Opens.isBasis_iff_nbhd.mp hb hz
  have hzU : g (i z) ∈ U₀ := by
    rw [← show i' (f z) = g (i z) from congrArg (fun h : Z ⟶ X' => h z) comm]
    exact hzU₀
  obtain ⟨C, hzC, -, hCU⟩ := exists_chart_nbhd i i' f g comm z ⊤ trivial U₀ hzU
  exact ⟨C, hzC, (i'.preimage_mono hCU).trans hU₀W⟩

/-! ### The canonical morphism out of the pullback -/

/-- The pullback sheaf morphisms that are adjoint to the sectionwise canonical
conormal algebra morphism of Tag 0634. -/
structure CanonicalPullbackHom {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g) where
  /-- The morphism `f^* (conormalPiece i' n) ⟶ conormalPiece i n` in degree `n`. -/
  hom (n : ℤ) :
    (Scheme.Modules.pullback f).obj (conormalPiece i' n) ⟶ conormalPiece i n
  /-- The adjoint of `hom n` agrees on sections over `W` with the canonical conormal algebra
  morphism `conormalAlgebraHom i i' f g comm` in degree `n`. -/
  agrees (n : ℤ) (W : Z'.Opens) (a : Γ(conormalPiece i' n, W)) :
    (((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _) (hom n)).app W a =
      (conormalAlgebraHom i i' f g comm).hom.map n
        (f ⁻¹ᵁ W) W le_rfl a

/-- The canonical morphism of Tag 0634 in degree `n`, as a morphism into the pushforward
along `f`. -/
def canonicalPushforwardHom {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g) (n : ℤ) :
    conormalPiece i' n ⟶ (Scheme.Modules.pushforward f).obj (conormalPiece i n) :=
  ⟨PresheafOfModules.homMk
    { app := fun W => AddCommGrpCat.ofHom
        (conormalHomSection i i' f (conormalAlgebraHom i i' f g comm).hom
          n (f ⁻¹ᵁ W.unop) W.unop le_rfl)
      naturality := by
        intro W W' h
        ext a
        exact (conormalHomSection_restrict_source i i' f
            (conormalAlgebraHom i i' f g comm).hom n (f ⁻¹ᵁ W'.unop) W.unop W'.unop
            (leOfHom h.unop) le_rfl (f.preimage_mono (leOfHom h.unop)) a).trans
          (conormalHomSection_restrict_target i i' f (conormalAlgebraHom i i' f g comm).hom
            n (f ⁻¹ᵁ W.unop) (f ⁻¹ᵁ W'.unop) (f.preimage_mono (leOfHom h.unop))
            W.unop le_rfl a).symm }
    (fun W r a => by
      refine (conormalHomSection_smul i i' f (conormalAlgebraHom i i' f g comm).hom
        n (f ⁻¹ᵁ W.unop) W.unop le_rfl r a).trans ?_
      rw [presheaf_map_homOfLE_self]
      rfl)⟩

/-- The canonical homogeneous morphism, regarded as a map from the pullback
of the source sheaf. -/
noncomputable def canonicalPullbackHom {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g) :
    CanonicalPullbackHom i i' f g comm where
  hom n := ((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _).symm
    (canonicalPushforwardHom i i' f g comm n)
  agrees n W a := congrArg (fun ψ => (Scheme.Modules.Hom.app ψ W) a)
    (((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _).apply_symm_apply
      (canonicalPushforwardHom i i' f g comm n))

private lemma sectionMap_canonical {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g)
    (n : ℤ) (V : Z.Opens) (W : Z'.Opens) (h : V ≤ f ⁻¹ᵁ W)
    (a : Γ(conormalPiece i' n, W)) :
    sectionMap f (((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _)
        ((canonicalPullbackHom i i' f g comm).hom n)) V W h a =
      conormalHomSection i i' f (conormalAlgebraHom i i' f g comm).hom n V W h a := by
  have h2 : pushforwardSection f (((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _)
        ((canonicalPullbackHom i i' f g comm).hom n)) W a =
      conormalHomSection i i' f (conormalAlgebraHom i i' f g comm).hom n (f ⁻¹ᵁ W) W le_rfl a :=
    (canonicalPullbackHom i i' f g comm).agrees n W a
  rw [sectionMap_apply, h2, conormalHomSection_restrict_target]

private theorem conormalAlgebraMap_isIso_of_neg {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g)
    (n : ℤ) (hn : n < 0) :
    IsIso ((canonicalPullbackHom i i' f g comm).hom n) :=
  ((Scheme.Modules.pullback f).map_isZero
    ((Stacks.Conormal.conormalAlgebra i').negative_isZero n hn)).isIso
      ((Stacks.Conormal.conormalAlgebra i).negative_isZero n hn) _

/-! ### Surjectivity -/

/-- On an affine chart the degree-`n` sections of the conormal algebra are spanned by the image
of the canonical morphism. -/
private lemma conormalChart_span {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g)
    (C : ConormalChart i i' g)
    (hker : Stacks.Conormal.chartIdeal i C.source =
      (Stacks.Conormal.chartIdeal i' C.target).map
        (g.appLE C.target.1 C.source.1 C.le_preimage).hom) (n : ℕ) :
    Submodule.span Γ(Z, i ⁻¹ᵁ C.source.1)
      (Set.range (conormalHomSection i i' f (conormalAlgebraHom i i' f g comm).hom
        (n : ℤ) (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
        (chart_preimage_le i i' f g comm C.le_preimage))) = ⊤ := by
  rw [Submodule.eq_top_iff']
  intro y
  obtain ⟨b, rfl⟩ := (Stacks.Conormal.conormalAlgebra i).localMap_surjective
    C.source C.source_closed n y
  refine mem_of_mem_map_pow (g.appLE C.target.1 C.source.1 C.le_preimage).hom
    (i.app C.source.1).hom (Stacks.Conormal.chartIdeal i' C.target)
    (Stacks.Conormal.chartIdeal i C.source) hker n
    (conormalLocalMap i C.source C.source_closed n) _ ?_ ?_
    (b : Γ(X, C.source.1)) ?_ b.property
  · intro r a c hc
    exact (Stacks.Conormal.conormalAlgebra i).localMap_smul C.source C.source_closed n r a c hc
  · exact fun a ha _ => Submodule.subset_span
      ⟨conormalLocalMap i' C.target C.target_closed n ⟨a, ha⟩,
      (conormalAlgebraHom i i' f g comm).chart C.source C.target C.le_preimage
        C.source_closed C.target_closed (chart_preimage_le i i' f g comm C.le_preimage)
        n ⟨a, ha⟩ _ rfl⟩
  · rw [Ideal.map_pow, ← hker]
    exact b.property

/-- The canonical map on each homogeneous piece of the conormal algebra is
locally surjective for a cartesian square of immersions. -/
@[stacks 0635 "surjectivity"]
theorem conormalAlgebraMap_epi {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (sq : IsPullback i f g i') (n : ℤ) :
    Epi ((canonicalPullbackHom i i' f g sq.w.symm).hom n) := by
  by_cases hn : n < 0
  · have : IsIso ((canonicalPullbackHom i i' f g sq.w.symm).hom n) :=
      conormalAlgebraMap_isIso_of_neg i i' f g sq.w.symm n hn
    infer_instance
  obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le (le_of_not_gt hn)
  refine epi_of_span_on_basis f _
    (fun C : ConormalChart i i' g => i ⁻¹ᵁ C.source.1)
    (conormalChart_isBasis i i' f g sq.w.symm)
    (fun C => i' ⁻¹ᵁ C.target.1)
    (fun C => chart_preimage_le i i' f g sq.w.symm C.le_preimage) (fun C => ?_)
  have heq : (fun a => sectionMap f
        (((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _)
          ((canonicalPullbackHom i i' f g sq.w.symm).hom (n : ℤ)))
        (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
        (chart_preimage_le i i' f g sq.w.symm C.le_preimage) a) =
      conormalHomSection i i' f (conormalAlgebraHom i i' f g sq.w.symm).hom (n : ℤ)
        (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
        (chart_preimage_le i i' f g sq.w.symm C.le_preimage) :=
    funext fun a => sectionMap_canonical i i' f g sq.w.symm (n : ℤ) _ _ _ a
  rw [heq]
  exact conormalChart_span i i' f g sq.w.symm C (chart_ker_eq i i' f g sq C) n

/-! ### The flat case -/

/-- The chart map `(I')ⁿ/(I')ⁿ⁺¹ ⟶ Γ(N, i⁻¹U)` attached to a morphism `ψ` out of the
degree-`n` piece downstairs. -/
private def chartLinearMap {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g)
    (C : ConormalChart i i' g) (n : ℕ) {N : Z.Modules}
    (ψ : conormalPiece i' (n : ℤ) ⟶ (Scheme.Modules.pushforward f).obj N)
    [Module Γ(X', C.target.1) Γ(N, i ⁻¹ᵁ C.source.1)]
    (hs : ∀ (r : Γ(X', C.target.1)) (x : Γ(N, i ⁻¹ᵁ C.source.1)),
      r • x = (f.appLE (i' ⁻¹ᵁ C.target.1) (i ⁻¹ᵁ C.source.1)
        (chart_preimage_le i i' f g comm C.le_preimage)).hom
          ((i'.app C.target.1).hom r) • x) :
    AssociatedGraded.piece (M := Γ(X', C.target.1)) (Stacks.Conormal.chartIdeal i' C.target) n
      →ₗ[Γ(X', C.target.1)] Γ(N, i ⁻¹ᵁ C.source.1) where
  toFun a := sectionMap f ψ (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
    (chart_preimage_le i i' f g comm C.le_preimage)
    (chartSectionsEquiv i' C.target C.target_closed n a)
  map_add' a b := by
    rw [map_add, map_add]
  map_smul' r a := by
    rw [RingHom.id_apply, chartSectionsEquiv_smul, sectionMap_smul, hs]

private lemma chartLinearMap_mk {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g)
    (C : ConormalChart i i' g) (n : ℕ) {N : Z.Modules}
    (ψ : conormalPiece i' (n : ℤ) ⟶ (Scheme.Modules.pushforward f).obj N)
    [Module Γ(X', C.target.1) Γ(N, i ⁻¹ᵁ C.source.1)]
    (hs : ∀ (r : Γ(X', C.target.1)) (x : Γ(N, i ⁻¹ᵁ C.source.1)),
      r • x = (f.appLE (i' ⁻¹ᵁ C.target.1) (i ⁻¹ᵁ C.source.1)
        (chart_preimage_le i i' f g comm C.le_preimage)).hom
          ((i'.app C.target.1).hom r) • x)
    (a : AssociatedGraded.piece (M := Γ(X', C.target.1))
      (Stacks.Conormal.chartIdeal i' C.target) n) :
    chartLinearMap i i' f g comm C n ψ hs a =
      sectionMap f ψ (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
        (chart_preimage_le i i' f g comm C.le_preimage)
        (chartSectionsEquiv i' C.target C.target_closed n a) := rfl

/-- On an affine chart of a cartesian square with `g` flat, the degree-`n` sections upstairs are
the base change of those downstairs. -/
private def chartBaseChangeEquiv {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (C : ConormalChart i i' g) (n : ℕ)
    [Algebra Γ(X', C.target.1) Γ(X, C.source.1)]
    [Module.Flat Γ(X', C.target.1) Γ(X, C.source.1)]
    (hker : Stacks.Conormal.chartIdeal i C.source =
      (Stacks.Conormal.chartIdeal i' C.target).map
        (algebraMap Γ(X', C.target.1) Γ(X, C.source.1)))
    [Module Γ(X, C.source.1) Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ C.source.1)]
    (hs : ∀ (r : Γ(X, C.source.1)) (x : Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ C.source.1)),
      r • x = (i.app C.source.1).hom r • x) :
    Γ(X, C.source.1) ⊗[Γ(X', C.target.1)]
        AssociatedGraded.piece (M := Γ(X', C.target.1))
          (Stacks.Conormal.chartIdeal i' C.target) n
      ≃ₗ[Γ(X, C.source.1)] Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ C.source.1) :=
  (associatedGradedBaseChangeEquiv (Stacks.Conormal.chartIdeal i' C.target)
      (Stacks.Conormal.chartIdeal i C.source) hker n).trans
    (chartDegreeEquiv i C.source C.source_closed n hs)

private lemma chartBaseChangeEquiv_tmul_mk {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g)
    (C : ConormalChart i i' g) (n : ℕ)
    [Algebra Γ(X', C.target.1) Γ(X, C.source.1)]
    [Module.Flat Γ(X', C.target.1) Γ(X, C.source.1)]
    (hker : Stacks.Conormal.chartIdeal i C.source =
      (Stacks.Conormal.chartIdeal i' C.target).map
        (algebraMap Γ(X', C.target.1) Γ(X, C.source.1)))
    (halg : algebraMap Γ(X', C.target.1) Γ(X, C.source.1) =
      (g.appLE C.target.1 C.source.1 C.le_preimage).hom)
    [Module Γ(X, C.source.1) Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ C.source.1)]
    (hs : ∀ (r : Γ(X, C.source.1)) (x : Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ C.source.1)),
      r • x = (i.app C.source.1).hom r • x)
    (a : AssociatedGraded.power (M := Γ(X', C.target.1))
      (Stacks.Conormal.chartIdeal i' C.target) n) :
    chartBaseChangeEquiv i i' g C n hker hs
        ((1 : Γ(X, C.source.1)) ⊗ₜ[Γ(X', C.target.1)]
          AssociatedGraded.mk (Stacks.Conormal.chartIdeal i' C.target) n a) =
      conormalHomSection i i' f (conormalAlgebraHom i i' f g comm).hom (n : ℤ)
        (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
        (chart_preimage_le i i' f g comm C.le_preimage)
        (chartSectionsEquiv i' C.target C.target_closed n
          (AssociatedGraded.mk (Stacks.Conormal.chartIdeal i' C.target) n a)) := by
  have hmem : algebraMap Γ(X', C.target.1) Γ(X, C.source.1) (a : Γ(X', C.target.1)) ∈
      Stacks.Conormal.chartIdeal i C.source ^ n := by
    rw [hker, ← AssociatedGraded.ring_power_eq]
    exact algebraMap_mem_power _ n a.2
  have ha : (a : Γ(X', C.target.1)) ∈ Stacks.Conormal.chartIdeal i' C.target ^ n := by
    simpa using a.property
  rw [chartBaseChangeEquiv, LinearEquiv.trans_apply,
    associatedGradedBaseChangeEquiv_tmul_mk _ _ _ _ _ _ hmem, one_smul,
    chartDegreeEquiv_apply,
    chartSectionsEquiv_mk i C.source C.source_closed n _
      ⟨algebraMap Γ(X', C.target.1) Γ(X, C.source.1) (a : Γ(X', C.target.1)), hmem⟩ rfl,
    chartSectionsEquiv_mk i' C.target C.target_closed n a ⟨(a : Γ(X', C.target.1)), ha⟩ rfl]
  refine ((conormalAlgebraHom i i' f g comm).chart C.source C.target C.le_preimage
    C.source_closed C.target_closed (chart_preimage_le i i' f g comm C.le_preimage) n
    ⟨(a : Γ(X', C.target.1)), ha⟩ _ ?_).symm
  rw [← appLE_apply, ← halg]

private lemma chartBaseChangeEquiv_tmul {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g)
    (C : ConormalChart i i' g) (n : ℕ)
    [Algebra Γ(X', C.target.1) Γ(X, C.source.1)]
    [Module.Flat Γ(X', C.target.1) Γ(X, C.source.1)]
    (hker : Stacks.Conormal.chartIdeal i C.source =
      (Stacks.Conormal.chartIdeal i' C.target).map
        (algebraMap Γ(X', C.target.1) Γ(X, C.source.1)))
    (halg : algebraMap Γ(X', C.target.1) Γ(X, C.source.1) =
      (g.appLE C.target.1 C.source.1 C.le_preimage).hom)
    [Module Γ(X, C.source.1) Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ C.source.1)]
    (hs : ∀ (r : Γ(X, C.source.1)) (x : Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ C.source.1)),
      r • x = (i.app C.source.1).hom r • x)
    (a : AssociatedGraded.piece (M := Γ(X', C.target.1))
      (Stacks.Conormal.chartIdeal i' C.target) n) :
    chartBaseChangeEquiv i i' g C n hker hs
        ((1 : Γ(X, C.source.1)) ⊗ₜ[Γ(X', C.target.1)] a) =
      conormalHomSection i i' f (conormalAlgebraHom i i' f g comm).hom (n : ℤ)
        (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
        (chart_preimage_le i i' f g comm C.le_preimage)
        (chartSectionsEquiv i' C.target C.target_closed n a) := by
  induction a using Submodule.Quotient.induction_on with
  | _ a => exact chartBaseChangeEquiv_tmul_mk i i' f g comm C n hker halg hs a

/-- On an affine chart of a cartesian square with `g` flat, the canonical morphism admits a
section compatible with any morphism `ψ` out of the degree-`n` piece downstairs. -/
private lemma exists_chartDesc {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] [Flat g] (sq : IsPullback i f g i')
    (C : ConormalChart i i' g) (n : ℕ) {N : Z.Modules}
    (ψ : conormalPiece i' (n : ℤ) ⟶ (Scheme.Modules.pushforward f).obj N) :
    ∃ d : Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ C.source.1) →+ Γ(N, i ⁻¹ᵁ C.source.1),
      (∀ (r : Γ(Z, i ⁻¹ᵁ C.source.1)) a, d (r • a) = r • d a) ∧
      ∀ a, d (conormalHomSection i i' f (conormalAlgebraHom i i' f g sq.w.symm).hom (n : ℤ)
          (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
          (chart_preimage_le i i' f g sq.w.symm C.le_preimage) a) =
        sectionMap f ψ (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
          (chart_preimage_le i i' f g sq.w.symm C.le_preimage) a := by
  let : Algebra Γ(X', C.target.1) Γ(X, C.source.1) :=
    (g.appLE C.target.1 C.source.1 C.le_preimage).hom.toAlgebra
  have halg : algebraMap Γ(X', C.target.1) Γ(X, C.source.1) =
      (g.appLE C.target.1 C.source.1 C.le_preimage).hom := rfl
  have : Module.Flat Γ(X', C.target.1) Γ(X, C.source.1) :=
    g.flat_appLE C.target.2 C.source.2 C.le_preimage
  let : Module Γ(X, C.source.1) Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ C.source.1) :=
    Module.compHom _ (i.app C.source.1).hom
  let : Module Γ(X, C.source.1) Γ(N, i ⁻¹ᵁ C.source.1) :=
    Module.compHom _ (i.app C.source.1).hom
  let : Module Γ(X', C.target.1) Γ(N, i ⁻¹ᵁ C.source.1) :=
    Module.compHom _ (algebraMap Γ(X', C.target.1) Γ(X, C.source.1))
  have : IsScalarTower Γ(X', C.target.1) Γ(X, C.source.1) Γ(N, i ⁻¹ᵁ C.source.1) :=
    IsScalarTower.of_compHom _ _ _
  have hsP : ∀ (r : Γ(X, C.source.1)) (x : Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ C.source.1)),
      r • x = (i.app C.source.1).hom r • x := fun _ _ => rfl
  have hsN : ∀ (r : Γ(X', C.target.1)) (x : Γ(N, i ⁻¹ᵁ C.source.1)),
      r • x = (f.appLE (i' ⁻¹ᵁ C.target.1) (i ⁻¹ᵁ C.source.1)
        (chart_preimage_le i i' f g sq.w.symm C.le_preimage)).hom
          ((i'.app C.target.1).hom r) • x := by
    intro r x
    have h1 : (f.appLE (i' ⁻¹ᵁ C.target.1) (i ⁻¹ᵁ C.source.1)
          (chart_preimage_le i i' f g sq.w.symm C.le_preimage)).hom
            ((i'.app C.target.1).hom r) =
        (i.app C.source.1).hom
          ((g.appLE C.target.1 C.source.1 C.le_preimage).hom r) :=
      congrArg (fun k : Γ(X', C.target.1) ⟶ Γ(Z, i ⁻¹ᵁ C.source.1) => k.hom r)
        (chart_app_square i i' f g sq.w.symm C)
    rw [h1, ← halg]
    rfl
  have hker : Stacks.Conormal.chartIdeal i C.source =
      (Stacks.Conormal.chartIdeal i' C.target).map
        (algebraMap Γ(X', C.target.1) Γ(X, C.source.1)) := by
    rw [halg]
    exact chart_ker_eq i i' f g sq C
  set E := chartBaseChangeEquiv i i' g C n hker hsP with hE
  set d := (LinearMap.liftBaseChange Γ(X, C.source.1)
    (chartLinearMap i i' f g sq.w.symm C n ψ hsN)).comp E.symm.toLinearMap with hd
  refine ⟨d.toAddMonoidHom, ?_, ?_⟩
  · intro r a
    obtain ⟨s, rfl⟩ := app_surjective_of_closedRestriction i C.source C.source_closed r
    exact d.map_smul s a
  · intro a
    obtain ⟨a, rfl⟩ := (chartSectionsEquiv i' C.target C.target_closed n).surjective a
    rw [← chartBaseChangeEquiv_tmul i i' f g sq.w.symm C n hker halg hsP a]
    show (LinearMap.liftBaseChange Γ(X, C.source.1)
      (chartLinearMap i i' f g sq.w.symm C n ψ hsN))
        (E.symm (E ((1 : Γ(X, C.source.1)) ⊗ₜ[Γ(X', C.target.1)] a))) = _
    rw [E.symm_apply_apply, LinearMap.liftBaseChange_tmul, one_smul, chartLinearMap_mk]

/-- For a cartesian square with `g` flat, the canonical morphism in degree `n` admits a global
section compatible with any morphism `ψ` out of the degree-`n` piece downstairs. -/
private lemma exists_conormalDesc {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] [Flat g] (sq : IsPullback i f g i')
    (n : ℕ) {N : Z.Modules}
    (ψ : conormalPiece i' (n : ℤ) ⟶ (Scheme.Modules.pushforward f).obj N) :
    ∃ r : conormalPiece i (n : ℤ) ⟶ N,
      ∀ (C : ConormalChart i i' g) a,
        Scheme.Modules.Hom.app r (i ⁻¹ᵁ C.source.1)
          (conormalHomSection i i' f (conormalAlgebraHom i i' f g sq.w.symm).hom (n : ℤ)
            (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
            (chart_preimage_le i i' f g sq.w.symm C.le_preimage) a) =
          sectionMap f ψ (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
            (chart_preimage_le i i' f g sq.w.symm C.le_preimage) a := by
  classical
  choose d hs hd using fun C => exists_chartDesc i i' f g sq C n ψ
  have hn (C D : ConormalChart i i' g) (hS : D.source.1 ≤ C.source.1)
      (hT : D.target.1 ≤ C.target.1)
      (a : Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ C.source.1)) :
      N.presheaf.map (homOfLE (i.preimage_mono hS)).op (d C a) =
        d D ((conormalPiece i (n : ℤ)).presheaf.map (homOfLE (i.preimage_mono hS)).op a) := by
    have ha : a ∈ Submodule.span Γ(Z, i ⁻¹ᵁ C.source.1)
        (Set.range (conormalHomSection i i' f (conormalAlgebraHom i i' f g sq.w.symm).hom
          (n : ℤ) (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
          (chart_preimage_le i i' f g sq.w.symm C.le_preimage))) := by
      rw [conormalChart_span i i' f g sq.w.symm C (chart_ker_eq i i' f g sq C) n]
      trivial
    induction ha using Submodule.span_induction with
    | mem a ha =>
      obtain ⟨a, rfl⟩ := ha
      rw [hd, conormalHomSection_restrict_target,
        ← conormalHomSection_restrict_source i i' f (conormalAlgebraHom i i' f g sq.w.symm).hom
          (n : ℤ) (i ⁻¹ᵁ D.source.1) (i' ⁻¹ᵁ C.target.1) (i' ⁻¹ᵁ D.target.1)
          (i'.preimage_mono hT) (chart_preimage_le i i' f g sq.w.symm D.le_preimage)
          ((i.preimage_mono hS).trans
            (chart_preimage_le i i' f g sq.w.symm C.le_preimage)),
        hd, sectionMap_restrict_target, sectionMap_restrict_source]
    | zero => simp
    | add a b ha hb iha ihb => simp only [map_add, iha, ihb]
    | smul r a ha ih =>
      rw [hs, N.map_smul, Scheme.Modules.map_smul, hs, ih]
  have hn' (C D : ConormalChart i i' g) (h : i ⁻¹ᵁ D.source.1 ≤ i ⁻¹ᵁ C.source.1)
      (a : Γ(conormalPiece i (n : ℤ), i ⁻¹ᵁ C.source.1)) :
      N.presheaf.map (homOfLE h).op (d C a) =
        d D ((conormalPiece i (n : ℤ)).presheaf.map (homOfLE h).op a) := by
    choose E hzE hEC hED hTC hTD using fun z : i ⁻¹ᵁ D.source.1 =>
      exists_common_chart i i' f g sq.w.symm C D z (h z.property) z.property
    refine sections_ext_of_cover N (fun z : i ⁻¹ᵁ D.source.1 => i ⁻¹ᵁ (E z).source.1)
      (fun z => i.preimage_mono (hED z)) (fun z hz => ⟨⟨z, hz⟩, hzE ⟨z, hz⟩⟩) fun z => ?_
    rw [← N.presheaf.map_comp_apply]
    show N.presheaf.map (homOfLE (i.preimage_mono (hEC z))).op (d C a) = _
    rw [hn C (E z) (hEC z) (hTC z), hn D (E z) (hED z) (hTD z),
      ← (conormalPiece i (n : ℤ)).presheaf.map_comp_apply]
    rfl
  obtain ⟨r, hr⟩ := exists_hom_of_basis (G := conormalPiece i (n : ℤ)) (N := N)
    (fun C : ConormalChart i i' g => i ⁻¹ᵁ C.source.1)
    (conormalChart_isBasis i i' f g sq.w.symm) d hs hn'
  exact ⟨r, fun C a => (hr C _).trans (hd C a)⟩

private lemma conormalDesc_comp {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] (comm : f ≫ i' = i ≫ g)
    (n : ℕ) {N : Z.Modules}
    (ψ : conormalPiece i' (n : ℤ) ⟶ (Scheme.Modules.pushforward f).obj N)
    (r : conormalPiece i (n : ℤ) ⟶ N)
    (hr : ∀ (C : ConormalChart i i' g) a,
      Scheme.Modules.Hom.app r (i ⁻¹ᵁ C.source.1)
        (conormalHomSection i i' f (conormalAlgebraHom i i' f g comm).hom (n : ℤ)
          (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
          (chart_preimage_le i i' f g comm C.le_preimage) a) =
        sectionMap f ψ (i ⁻¹ᵁ C.source.1) (i' ⁻¹ᵁ C.target.1)
          (chart_preimage_le i i' f g comm C.le_preimage) a) :
    ((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _)
      ((canonicalPullbackHom i i' f g comm).hom n ≫ r) = ψ := by
  classical
  rw [Adjunction.homEquiv_naturality_right]
  apply Scheme.Modules.hom_ext
  intro W
  ext a
  choose C hzC hCW using fun z : f ⁻¹ᵁ W => exists_chart_over_open i i' f g comm W z z.property
  have hVW z : i ⁻¹ᵁ (C z).source.1 ≤ f ⁻¹ᵁ W :=
    (chart_preimage_le i i' f g comm (C z).le_preimage).trans (f.preimage_mono (hCW z))
  refine sections_ext_of_cover N (fun z : f ⁻¹ᵁ W => i ⁻¹ᵁ (C z).source.1) hVW
    (fun z hz => ⟨⟨z, hz⟩, hzC ⟨z, hz⟩⟩) fun z => ?_
  have hchart : Scheme.Modules.Hom.app r (i ⁻¹ᵁ (C z).source.1)
        (sectionMap f (((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _)
          ((canonicalPullbackHom i i' f g comm).hom (n : ℤ)))
          (i ⁻¹ᵁ (C z).source.1) W (hVW z) a) =
      sectionMap f ψ (i ⁻¹ᵁ (C z).source.1) W (hVW z) a := by
    rw [sectionMap_canonical, ← conormalHomSection_restrict_source i i' f
      (conormalAlgebraHom i i' f g comm).hom (n : ℤ) (i ⁻¹ᵁ (C z).source.1) W
      (i' ⁻¹ᵁ (C z).target.1) (hCW z)
      (chart_preimage_le i i' f g comm (C z).le_preimage) (hVW z), hr,
      sectionMap_restrict_source]
  exact (hom_app_restrict r (hVW z) _).symm.trans hchart

/-- Under flat base change the canonical map on every homogeneous piece is
an isomorphism. -/
@[stacks 0635 "flat isomorphism"]
theorem conormalAlgebraMap_isIso_of_flat {Z X Z' X' : Scheme.{u}}
    (i : Z ⟶ X) (i' : Z' ⟶ X') (f : Z ⟶ Z') (g : X ⟶ X')
    [IsImmersion i] [IsImmersion i'] [Flat g]
    (sq : IsPullback i f g i') (n : ℤ) :
    IsIso ((canonicalPullbackHom i i' f g sq.w.symm).hom n) := by
  by_cases hn : n < 0
  · exact conormalAlgebraMap_isIso_of_neg i i' f g sq.w.symm n hn
  obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le (le_of_not_gt hn)
  let P := (Scheme.Modules.pullback f).obj (conormalPiece i' (n : ℤ))
  let φ := (canonicalPullbackHom i i' f g sq.w.symm).hom (n : ℤ)
  let ψ := ((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _) (𝟙 P)
  obtain ⟨r, hr⟩ := exists_conormalDesc i i' f g sq n ψ
  have hφr : φ ≫ r = 𝟙 P :=
    ((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _).injective
      (conormalDesc_comp i i' f g sq.w.symm n ψ r hr)
  have : Epi φ := conormalAlgebraMap_epi i i' f g sq n
  refine ⟨⟨r, hφr, ?_⟩⟩
  apply (cancel_epi φ).mp
  show φ ≫ (r ≫ φ) = φ ≫ 𝟙 _
  rw [← Category.assoc, hφr, Category.id_comp, Category.comp_id]

