module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent
public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Descent.ModuleFiniteness.FiniteType
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierStalk.Stalkwise
public import StacksFrontier.AlgebraicGeometry.Properties.CardinalGenerated

/-!
# Descent of a bound on the number of local generators

A quasi-coherent module on a scheme which becomes locally generated by a fixed number of
sections on every member of an fpqc covering is itself locally generated by that many sections.

## Main results

* `AlgebraicGeometry.IdealSheafData.stalk_comap_eq_top_iff`: the stalk of the inverse image of
  an ideal sheaf is the unit ideal exactly where the stalk of the ideal sheaf at the image point
  is.
* `AlgebraicGeometry.isGeneratedByNear_pullback_iff`: generation by `r` sections near a point is
  the same condition for a module and for its pullback along an arbitrary morphism of schemes.
* `AlgebraicGeometry.isGeneratedByNear_of_pullback`: generation by `r` sections near a point
  descends along an arbitrary morphism of schemes.
* `AlgebraicGeometry.isCardinalGenerated_of_pullback_fpqc`: fpqc descent of local generation by
  `r` sections for quasi-coherent modules.

## Implementation notes

Local generation by `r` sections is expressed by `SheafOfModules.IsCardinalGenerated` with bound
the cardinal associated to `r`, so local generating families may contain at most `r` sections,
which is equivalent to the source's convention of generation by `r` sections. An fpqc covering
is membership of the associated presieve in Mathlib's `Scheme.fpqcPrecoverage`.

## References

* [Stacks Project, Tag 082U](https://stacks.math.columbia.edu/tag/082U)
-/

@[expose] public section

namespace AlgebraicGeometry

universe u v

open CategoryTheory TopologicalSpace

/-- The stalk of the inverse image of an ideal sheaf at a point is the unit ideal exactly when
the stalk of the ideal sheaf at the image of that point is. -/
theorem IdealSheafData.stalk_comap_eq_top_iff {X Y : Scheme.{u}} (I : Y.IdealSheafData)
    (g : X ⟶ Y) (x : X) :
    IdealSheafData.stalk (I.comap g) x = ⊤ ↔ IdealSheafData.stalk I (g.base x) = ⊤ := by
  rw [Stacks.Divisors.stalk_eq_top_iff_notMem_support,
    Stacks.Divisors.stalk_eq_top_iff_notMem_support, Scheme.IdealSheafData.support_comap]
  exact Iff.rfl

/-- **Generation by `r` sections near a point is insensitive to pullback.** The pullback of a
finite type quasi-coherent module along an arbitrary morphism of schemes is generated by `r`
sections near a point exactly when the module is generated by `r` sections near the image of
that point. -/
theorem isGeneratedByNear_pullback_iff {X Y : Scheme.{u}} (g : X ⟶ Y) (M : Y.Modules)
    [M.IsFiniteType] [M.IsQuasicoherent] (r : ℕ) (x : X) :
    IsGeneratedByNear ((Scheme.Modules.pullback g).obj M) r x ↔
      IsGeneratedByNear M r (g.base x) := by
  have hfin : ((Scheme.Modules.pullback g).obj M).IsFiniteType :=
    SheafOfModules.pullback_isFiniteType g.toLRSHom.toShHom M
  have hqc : ((Scheme.Modules.pullback g).obj M).IsQuasicoherent :=
    @SheafOfModules.modulePullback_isQuasicoherent X.toRingedSpace Y.toRingedSpace
      g.toLRSHom.toShHom M ‹M.IsQuasicoherent›
  rw [isGeneratedByNear_iff_fittingIdeal_stalk_eq_top, ← fittingIdeal_comap g M (r : ℤ),
    IdealSheafData.stalk_comap_eq_top_iff,
    isGeneratedByNear_iff_fittingIdeal_stalk_eq_top M r (g.base x)]

/-- Generation by `r` sections near a point descends along an arbitrary morphism of schemes: if
the pullback of a finite type quasi-coherent module is generated by `r` sections near a point,
then the module is generated by `r` sections near the image of that point. -/
theorem isGeneratedByNear_of_pullback {X Y : Scheme.{u}} (g : X ⟶ Y) (M : Y.Modules)
    [M.IsFiniteType] [M.IsQuasicoherent] (r : ℕ) (x : X)
    (h : IsGeneratedByNear ((Scheme.Modules.pullback g).obj M) r x) :
    IsGeneratedByNear M r (g.base x) :=
  (isGeneratedByNear_pullback_iff g M r x).mp h

/-- A module with a local generating family of cardinality below `ℵ₀` is of finite type. -/
private theorem finiteType_of_cardinalGenerated {X : Scheme.{u}} (M : X.Modules)
    {κ : Cardinal.{u}} (hM : SheafOfModules.IsCardinalGenerated.{u} M κ)
    (hκ : κ < Cardinal.aleph0) : M.IsFiniteType := by
  obtain ⟨σ, hσ⟩ := hM
  have hσfinite : σ.IsFiniteType := by
    constructor
    intro i
    exact ⟨Cardinal.lt_aleph0_iff_finite.mp ((hσ i).trans_lt hκ)⟩
  exact SheafOfModules.IsFiniteType.mk (C := TopologicalSpace.Opens X) (M := M) ⟨σ, hσfinite⟩

/-- Pad a family of generating sections along an embedding of its index type into a larger type,
sending the indices outside the image to the zero section. -/
private noncomputable def padGeneratingSections
    {C : Type u} [Category.{u} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
    [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    {M : SheafOfModules.{u} R} {K : Type u}
    (g : M.GeneratingSections) (e : g.I ↪ K) : M.GeneratingSections := by
  classical
  let s : K → M.sections := fun j =>
    if h : ∃ i, e i = j then g.s h.choose
    else M.unitHomEquiv (0 : SheafOfModules.unit R ⟶ M)
  have hs (i : g.I) : s (e i) = g.s i := by
    have hex : ∃ j, e j = e i := ⟨i, rfl⟩
    have hchoose : hex.choose = i := e.injective hex.choose_spec
    dsimp only [s]
    rw [dite_eq_left hex, hchoose]
  refine { I := K, s := s, epi := ?_ }
  apply epi_of_epi_fac (f := SheafOfModules.freeMap (R := R) e) (h := g.π)
  apply M.freeHomEquiv.injective
  funext i
  rw [SheafOfModules.freeHomEquiv_comp_apply, SheafOfModules.freeHomEquiv_freeMap]
  calc
    _ = s (e i) :=
      SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection (R := R) s (e i)
    _ = g.s i := hs i
    _ = M.freeHomEquiv g.π i := by simp [SheafOfModules.GeneratingSections.π]

/-- A module locally generated by at most `r` sections is generated by `r` sections near every
point. -/
private theorem cardinalGenerated_isGeneratedByNear {X : Scheme.{u}}
    (M : X.Modules) (r : ℕ)
    (hM : SheafOfModules.IsCardinalGenerated.{u} M (Cardinal.lift.{u, 0} r)) (x : X) :
    IsGeneratedByNear M r x := by
  classical
  obtain ⟨σ, hσ⟩ := hM
  obtain ⟨U, fU, ⟨i, ⟨gU⟩⟩, hxU⟩ := σ.coversTop ⊤ x (by trivial)
  have hx : x ∈ σ.X i := (leOfHom gU) hxU
  have hbound : Cardinal.mk (σ.generators i).I ≤ Cardinal.mk (ULift.{u, 0} (Fin r)) := by
    simpa using hσ i
  obtain ⟨e⟩ := (Cardinal.le_def _ _).mp hbound
  let q : (M.over (σ.X i)).GeneratingSections :=
    padGeneratingSections (C := Over (σ.X i)) (R := X.ringCatSheaf.over (σ.X i))
      (M := M.over (σ.X i)) (K := ULift.{u, 0} (Fin r)) (σ.generators i) e
  exact ⟨σ.X i, hx, q, ⟨Equiv.ulift⟩⟩

/-- Being locally generated by `r` sections descends along an fpqc covering for quasi-coherent
modules. -/
@[stacks 082U]
theorem isCardinalGenerated_of_pullback_fpqc {X : Scheme.{u}} (M : X.Modules)
    (hM : M.IsQuasicoherent) (r : ℕ) {I : Type v} (X' : I → Scheme.{u})
    (f : ∀ i, X' i ⟶ X)
    (hfpqc : Presieve.ofArrows X' f ∈ Scheme.fpqcPrecoverage X)
    (hgen : ∀ i, SheafOfModules.IsCardinalGenerated.{u}
      ((Scheme.Modules.pullback (f i)).obj M) (Cardinal.lift.{u, 0} r)) :
    SheafOfModules.IsCardinalGenerated.{u} M (Cardinal.lift.{u, 0} r) := by
  classical
  have hpullFinite : ∀ i, ((Scheme.Modules.pullback (f i)).obj M).IsFiniteType := by
    intro i
    apply finiteType_of_cardinalGenerated (M := ((Scheme.Modules.pullback (f i)).obj M))
      (hgen i)
    simp
  have : M.IsQuasicoherent := hM
  have : M.IsFiniteType := isFiniteType_of_pullback_fpqc M hM X' f hfpqc hpullFinite
  have hsurj : ∀ x : X, ∃ i, x ∈ Set.range (f i).base :=
    ((Scheme.ofArrows_mem_precoverage_iff (P := @Flat)).mp hfpqc.2).1
  have hlocal : ∀ x : X, IsGeneratedByNear M r x := by
    intro x
    obtain ⟨i, y, hy⟩ := hsurj x
    exact hy ▸ isGeneratedByNear_of_pullback (f i) M r y
      (cardinalGenerated_isGeneratedByNear _ r (hgen i) y)
  choose Ux hmem gens hgens using hlocal
  let σ : M.LocalGeneratorsData.{u} :=
    { I := X
      X := Ux
      coversTop := (Opens.coversTop_iff (X : Type u) Ux).mpr (by
        apply IsOpenCover.of_sets (fun x => (Ux x).2)
        ext x
        simp only [Set.mem_iUnion, Set.mem_univ]
        exact ⟨fun _ => trivial, fun _ => ⟨x, hmem x⟩⟩)
      generators := gens }
  refine ⟨σ, ?_⟩
  intro x
  obtain ⟨e⟩ := hgens x
  rw [Cardinal.mk_congr (e.trans Equiv.ulift.symm)]
  simp

end AlgebraicGeometry

end
