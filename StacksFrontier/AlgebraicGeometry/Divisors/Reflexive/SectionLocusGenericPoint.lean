module

public import StacksFrontier.AlgebraicGeometry.Divisors.Reflexive.HullExtensionUniqueness
public import StacksFrontier.AlgebraicGeometry.Divisors.Reflexive.SectionIsomorphismLocus
public import StacksFrontier.AlgebraicGeometry.Divisors.ReflexiveEquivalence.StalkDescent
public import StacksFrontier.AlgebraicGeometry.FiberRank.GenericPoint
public import StacksCore.Tactic.StacksAttribute

/-!
# A nonzero section of a rank one reflexive module trivializes it at the generic point

Let `X` be an integral locally Noetherian scheme, `ℱ` a coherent reflexive `𝒪_X`-module of rank
one, and `s` a nonzero global section of `ℱ`.  Then the generic point `η` of `X` lies in the
locus of [Stacks, Tag 0EBN] where `s` induces an isomorphism `𝒪_{X, x} ⟶ ℱ_x`.

This is the only use the proof of [Stacks, Tag 0EBP] makes of the hypotheses "`s` nonzero" and
"`ℱ` of rank one".

## Main results

* `AlgebraicGeometry.mem_sectionIsomorphismLocus_genericPoint`: the statement above.

## Implementation notes

Rank one is `AlgebraicGeometry.Scheme.Modules.fiberRank ℱ η = 1`, the rank function of
[Stacks, Tag 05P2] read at the generic point; it is what the predicate
`AlgebraicGeometry.CoherentReflexive.HasRankOne` unfolds to.

The local ring at the generic point of an integral scheme is the function field, hence a field,
and the fibre rank there is the dimension of the stalk over it
(`AlgebraicGeometry.Scheme.Modules.fiberRank_genericPoint_eq_finrank_stalk`).  A reflexive
module on an integral scheme is torsion free ([Stacks, Tag 0AY2] part (1)) and a section of a
torsion free quasi-coherent module whose germ at the generic point vanishes is zero
(`AlgebraicGeometry.injective_generic_germ_of_isTorsionFree`), so the germ `s_η` is a nonzero
vector of a one-dimensional vector space and therefore a basis.

**Why the stalk of `𝒪_X` as a module over itself is not identified with `𝒪_{X, η}`.**  That
identification exists — `Stacks.SheafOfModules.unitStalkLinearEquiv` — but it is stated over a
ringed space, and the module structure it uses on the stalk is
`Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule`, which is not the instance
`Module.finrank` and `fiberRank` are read at on a scheme.  Both halves of the bijectivity are
therefore proved here directly from germs: every germ of `𝒪_X` as a module over itself is a
multiple of the germ of the unit section (`germ_eq_smul_unitGerm`), the morphism
`s : 𝒪_X ⟶ ℱ` carries that germ to `s_η` (`stalkMapOfHom_unitGerm`), and the stalk map is
linear over the local ring.

## References

* [Stacks Project, Tag 0EBP](https://stacks.math.columbia.edu/tag/0EBP)
* [Stacks Project, Tag 0EBN](https://stacks.math.columbia.edu/tag/0EBN)
* [Stacks Project, Tag 0AY2](https://stacks.math.columbia.edu/tag/0AY2)
* [Stacks Project, Tag 05P2](https://stacks.math.columbia.edu/tag/05P2)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace
open Stacks.AlgebraicGeometry.ReflexiveModules
open Stacks.AlgebraicGeometry.ReflexiveEquivalence

universe u

namespace AlgebraicGeometry

variable {X : Scheme.{u}}

/-- The structure sheaf of `X` as a module over itself, at the spelling in which it is the
source of the morphism `𝒪_X ⟶ ℱ` attached to a section of `ℱ`.  This is `unitModule X` of
`StacksFrontier/AlgebraicGeometry/ReflexiveHull/StructureSheaf.lean` with `X.ringCatSheaf` in place
of the definitionally equal `structureSheaf X.sheaf`; the two spellings have syntactically
different types, so rewriting needs this one. -/
private abbrev unitMod (X : Scheme.{u}) : X.Modules := SheafOfModules.unit X.ringCatSheaf

/-- The germ at `x` of the unit section of the structure sheaf viewed as a module over itself. -/
private def unitGerm (X : Scheme.{u}) (x : X) : (unitMod X).presheaf.stalk x :=
  (unitMod X).presheaf.germ ⊤ x trivial (1 : Γ(X, (⊤ : X.Opens)))

/-- Every germ of `𝒪_X` as a module over itself is a multiple of the germ of the unit section:
over each open the module is already generated by `1`. -/
private theorem germ_eq_smul_unitGerm (x : X) (U : X.Opens) (hx : x ∈ U) (r : Γ(X, U)) :
    (unitMod X).presheaf.germ U x hx r = X.presheaf.germ U x hx r • unitGerm X x := by
  have hres : ((unitMod X).presheaf.map (homOfLE (le_top (a := U))).op)
      (1 : Γ(X, (⊤ : X.Opens))) = (1 : Γ(X, U)) :=
    map_one (X.presheaf.map (homOfLE (le_top (a := U))).op).hom
  have h1 : (unitMod X).presheaf.germ U x hx (1 : Γ(X, U)) = unitGerm X x :=
    (congrArg ((unitMod X).presheaf.germ U x hx) hres).symm.trans
      ((unitMod X).presheaf.germ_res_apply (homOfLE (le_top (a := U))) x hx
        (1 : Γ(X, (⊤ : X.Opens))))
  have hgs : (unitMod X).presheaf.germ U x hx (r • (1 : Γ(X, U))) =
      X.presheaf.germ U x hx r • (unitMod X).presheaf.germ U x hx (1 : Γ(X, U)) :=
    PresheafOfModules.germ_smul (unitMod X).val x U hx r (1 : Γ(X, U))
  rw [h1] at hgs
  exact (congrArg ((unitMod X).presheaf.germ U x hx) ((mul_one r).symm : r = r * 1)).trans hgs

/-- The morphism `s : 𝒪_X ⟶ ℱ` attached to a global section carries the germ of the unit
section to the germ of `s`. -/
private theorem stalkMapOfHom_unitGerm (F : X.Modules) (s : F.sections) (x : X) :
    stalkMapOfHom (F.unitHomEquiv.symm s) x (unitGerm X x) =
      F.presheaf.germ ⊤ x trivial (s.eval (op ⊤)) := by
  have happ := _root_.SheafOfModules.unitHomEquiv_apply_coe F (F.unitHomEquiv.symm s) (op ⊤)
  rw [Equiv.apply_symm_apply] at happ
  have hg : stalkMapOfHom (F.unitHomEquiv.symm s) x
      ((unitMod X).presheaf.germ ⊤ x trivial (1 : Γ(X, (⊤ : X.Opens)))) =
      F.presheaf.germ ⊤ x trivial
        (Scheme.Modules.Hom.app (F.unitHomEquiv.symm s) ⊤ (1 : Γ(X, (⊤ : X.Opens)))) :=
    stalkMapOfHom_germ (F.unitHomEquiv.symm s) x ⊤ trivial (1 : Γ(X, (⊤ : X.Opens)))
  exact hg.trans (congrArg (F.presheaf.germ ⊤ x trivial) happ.symm)

/-- **A nonzero global section of a coherent reflexive module of rank one on an integral
locally Noetherian scheme trivializes it at the generic point.**  This supplies, from the two
hypotheses of [Stacks, Tag 0EBP] that the codimension argument never otherwise uses, the fact
that the complement of the locus of [Stacks, Tag 0EBN] misses the generic point. -/
theorem mem_sectionIsomorphismLocus_genericPoint [IsIntegral X] [IsLocallyNoetherian X]
    (F : X.Modules) [_root_.SheafOfModules.IsCoherent F] (hF : IsReflexive F)
    (hrank : Scheme.Modules.fiberRank F (genericPoint X) = 1) (s : F.sections)
    (hs : s.eval (op (⊤ : X.Opens)) ≠ 0) :
    genericPoint X ∈ sectionIsomorphismLocus F s := by
  let _ : Field (X.presheaf.stalk (genericPoint X)) :=
    inferInstanceAs (Field X.functionField)
  have _ : F.IsFiniteType := _root_.SheafOfModules.IsCoherent.isFiniteType
  have _ : F.IsQuasicoherent := isQuasicoherent_of_isCoherent F
  have hinj := injective_generic_germ_of_isTorsionFree F (isTorsionFree_of_isReflexive F hF)
    (U := ⊤) (Opens.mem_top (genericPoint X))
  have hne : F.presheaf.germ ⊤ (genericPoint X) trivial (s.eval (op ⊤)) ≠ 0 := fun h =>
    hs (hinj (h.trans (map_zero _).symm))
  have hfin : Module.finrank (X.presheaf.stalk (genericPoint X))
      (F.presheaf.stalk (genericPoint X)) = 1 :=
    (Scheme.Modules.fiberRank_genericPoint_eq_finrank_stalk F).symm.trans hrank
  have hsmul : ∀ c : X.presheaf.stalk (genericPoint X),
      stalkMapOfHom (F.unitHomEquiv.symm s) (genericPoint X) (c • unitGerm X (genericPoint X)) =
        c • F.presheaf.germ ⊤ (genericPoint X) trivial (s.eval (op ⊤)) := fun c =>
    (stalkMapOfHom_smul (F.unitHomEquiv.symm s) (genericPoint X) c
        (unitGerm X (genericPoint X))).trans
      (congrArg (c • ·) (stalkMapOfHom_unitGerm F s (genericPoint X)))
  refine (mem_sectionIsomorphismLocus_iff F s (genericPoint X)).mpr ⟨fun a b hab => ?_, ?_⟩
  · obtain ⟨U, hU, r, rfl⟩ := (unitMod X).presheaf.exists_germ_eq a
    obtain ⟨V, hV, t, rfl⟩ := (unitMod X).presheaf.exists_germ_eq b
    rw [germ_eq_smul_unitGerm _ U hU r, germ_eq_smul_unitGerm _ V hV t] at hab ⊢
    set c := X.presheaf.germ U (genericPoint X) hU r
    set d := X.presheaf.germ V (genericPoint X) hV t
    have hcd : c = d := by
      by_contra hne'
      refine hne ?_
      have h0 : (c - d) • F.presheaf.germ ⊤ (genericPoint X) trivial (s.eval (op ⊤)) = 0 := by
        rw [sub_smul, ← hsmul c, ← hsmul d]
        exact sub_eq_zero.mpr hab
      exact (smul_eq_zero.mp h0).resolve_left (sub_ne_zero.mpr hne')
    rw [hcd]
  · intro w
    obtain ⟨c, hc⟩ := exists_smul_eq_of_finrank_eq_one hfin hne w
    exact ⟨c • unitGerm X (genericPoint X), (hsmul c).trans hc⟩

end AlgebraicGeometry

end
