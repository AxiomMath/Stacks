module

public import StacksFrontier.AlgebraicGeometry.Divisors.EtaGoodBaseChange.Comparison
public import StacksFrontier.AlgebraicGeometry.Divisors.EtaGoodBaseChange.StalkInputs
public import StacksCore.Tactic.StacksAttribute

/-!
# Stacks Tag 0F9X in general: goodness in place of flatness

Let `X` be a scheme, `D ⊆ X` an effective Cartier divisor with ideal sheaf `I = ℐ_D`, and
`h : Y ⟶ X` an **arbitrary** morphism of schemes along which the inverse image `E = h^{-1}D` is
defined, with ideal sheaf `J = ℐ_E`.  This file proves

`Lh^*(Lη_I M) ≅ Lη_J(Lh^* M)`

in `D(𝒪_Y)` for every object `M` of `D(𝒪_X)` presented by a K-flat complex of flat modules whose
stalk complexes admit good finite free models.  **No flatness of `h` is assumed**, which is what
separates this from `Stacks.Divisors.Eta.isIso_derivedEtaPullbackComparison`.

## Main results

* `Stacks.Divisors.Eta.quasiIso_comp_etaPullbackChainMap_of_forall_stalk_good`: the chain-level
  hypothesis `hΨ` of `Stacks.Divisors.Eta.nonempty_derivedPullback_derivedEta_iso_of_quasiIso`,
  discharged from stalkwise goodness.
* `nonempty_derivedPullback_derivedEta_iso_of_forall_stalk_good_at_presentation`:
  the same at a chosen K-flat presentation of `η_I 𝒦`.
* `Stacks.Divisors.Eta.nonempty_derivedPullback_derivedEta_iso_of_forall_stalk_good`:
  **[Stacks, Tag 0F9X] with goodness in place of flatness.**  The presentation is supplied by
  the K-flat resolution of Stacks 06YF, so none is carried as a hypothesis.

## Implementation notes

The placement is forced: the reduction
`Stacks.Divisors.Eta.nonempty_derivedPullback_derivedEta_iso_of_quasiIso` lives in
`StacksFrontier/AlgebraicGeometry/Divisors/EtaGoodBaseChange/Comparison.lean`, which *imports*
`StacksFrontier/AlgebraicGeometry/Divisors/EtaDerivedPullbackComparison.lean`, where the flat case
is registered; so the general case cannot be stated beside it without a cycle.  This file is a
sibling of `Comparison.lean` and of `StalkGoodInput.lean` and imports both.

## References

* [Stacks Project, Tag 0F9X](https://stacks.math.columbia.edu/tag/0F9X)
* [Stacks Project, Tag 0F8S](https://stacks.math.columbia.edu/tag/0F8S)
* [Stacks Project, Tag 0F7X](https://stacks.math.columbia.edu/tag/0F7X)
* [Stacks Project, Tag 0GT3](https://stacks.math.columbia.edu/tag/0GT3)
-/

@[expose] public noncomputable section

attribute [local instance_reducible] TopCat.Sheaf CategoryTheory.sheafCompose
  AlgebraicGeometry.SheafedSpace.sheaf Stacks.SheafOfModules.TensorSheafification.structureSheaf

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

open Stacks.RingedSpace (pullbackFunctor commStalkGermMap)
open Stacks.IdealTorsion (IsIdealTorsionFree IsLocallyGeneratedByRegular GeneratesStalkIdeal)
open Stacks.IdealTorsion.Eta (pullbackIdealIncl pullbackComplex etaObj stalkComplex)
open Stacks.SheafOfModules.TensorStalkRingedSpace (ringStalk)
open Stacks.Cohomology.DerivedAdjunctionOnRingedSpaces (derivedPullback)

attribute [local instance 10000] HasDerivedCategory.standard

universe u

namespace Stacks.Divisors.Eta

variable {X Y : Scheme.{u}} (h : Y ⟶ X) (D : X.IdealSheafData)
  [Stacks.Divisors.IsEffectiveCartierDivisor D]

/-- **The ideal sheaf of an effective Cartier divisor is locally generated by a
nonzerodivisor.**  It is invertible and the stalks of `𝒪_X` are local rings, so Stacks tag 0GT3
applies. -/
theorem isLocallyGeneratedByRegular_idealSheafι :
    IsLocallyGeneratedByRegular X.toRingedSpace (idealSheafι D) :=
  @Stacks.IdealTorsion.isLocallyGeneratedByRegular_of_isInvertible X.toRingedSpace
    inferInstance _ (idealSheafι D) (mono_idealSheafι D) (isInvertible_idealSheaf D)

/-- **The pulled-back ideal `h^*ℐ_D ⟶ 𝒪_Y` is locally generated by a nonzerodivisor**, as soon
as `h^{-1}D` is defined.  The pullback of an invertible module is invertible (Stacks tag 0B8L,
`Stacks.Divisors.isInvertible_pullbackFunctor_obj_idealSheaf`), and the inclusion is a
monomorphism by `Stacks.Divisors.Eta.mono_pullbackIdealIncl_of_isPullbackDefined`, so Stacks
tag 0GT3 applies again. -/
theorem isLocallyGeneratedByRegular_pullbackIdealIncl
    (hD : Stacks.Divisors.IsPullbackDefined h D) :
    IsLocallyGeneratedByRegular Y.toRingedSpace
      (pullbackIdealIncl h.toLRSHom.toShHom (idealSheaf D) (idealSheafι D)) :=
  @Stacks.IdealTorsion.isLocallyGeneratedByRegular_of_isInvertible Y.toRingedSpace
    inferInstance _ (pullbackIdealIncl h.toLRSHom.toShHom (idealSheaf D) (idealSheafι D))
    (mono_pullbackIdealIncl_of_isPullbackDefined h D hD)
    (Stacks.Divisors.isInvertible_pullbackFunctor_obj_idealSheaf h D)

variable (hD : Stacks.Divisors.IsPullbackDefined h D) (𝒦 : CochainComplex X.Modules ℤ)
  (hflat : ∀ n : ℤ, AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := X.sheaf) (𝒦.X n))

include hD hflat in
/-- **The chain-level comparison composed with a presentation is a quasi-isomorphism, from
stalkwise goodness alone.**  This is the hypothesis `hΨ` of
`Stacks.Divisors.Eta.nonempty_derivedPullback_derivedEta_iso_of_quasiIso`, discharged with **no
flatness of `h`**.

`Stacks.IdealTorsion.Eta.quasiIso_comp_pullbackEtaMap_of_forall_stalk_goodModel` gives the
statement for `Stacks.IdealTorsion.Eta.pullbackEtaMap`, the comparison with the décalage by the
pulled-back ideal `h^*ℐ_D`; `Stacks.Divisors.Eta.etaPullbackChainMap` is that map followed by the
transport along `h^*ℐ_D ≅ ℐ_E`, and postcomposition with an isomorphism neither creates nor
destroys quasi-isomorphisms. -/
theorem quasiIso_comp_etaPullbackChainMap_of_forall_stalk_good
    (h𝒦 : Stacks.Cohomology.KFlatDerivedPullback.KFlatComplex X.toRingedSpace 𝒦)
    (P : CochainComplex X.Modules ℤ)
    (hP : Stacks.Cohomology.KFlatDerivedPullback.KFlatComplex X.toRingedSpace P)
    (p : P ⟶ etaObj X.toRingedSpace (idealSheaf D) (idealSheafι D) 𝒦
      (isIdealTorsionFree_flatComplex D 𝒦 hflat))
    (hp : QuasiIso p)
    (hgood : ∀ z : Y, ∃ (a : ringStalk X.toRingedSpace (h.toLRSHom.toShHom.hom.base z))
        (_ : GeneratesStalkIdeal X.toRingedSpace (idealSheafι D)
          (h.toLRSHom.toShHom.hom.base z) a)
        (_ : GeneratesStalkIdeal Y.toRingedSpace
          (pullbackIdealIncl h.toLRSHom.toShHom (idealSheaf D) (idealSheafι D)) z
          (commStalkGermMap h.toLRSHom.toShHom z a))
        (C : BoundedComplex (ringStalk X.toRingedSpace (h.toLRSHom.toShHom.hom.base z))),
        (∀ i : ℤ, (idealI C a i).IsPrincipal) ∧
          Nonempty (DerivedCategory.Q.obj C.toCochainComplex ≅
            DerivedCategory.Q.obj
              (stalkComplex X.toRingedSpace (h.toLRSHom.toShHom.hom.base z) 𝒦))) :
    QuasiIso ((((pullbackFunctor h.toLRSHom.toShHom).mapHomologicalComplex
        (ComplexShape.up ℤ)).map p) ≫ etaPullbackChainMap h D hD 𝒦 hflat) := by
  have := mono_pullbackIdealIncl_of_isPullbackDefined h D hD
  -- the décalage statements are indexed by `Tensor.ringSheaf X.sheaf` and the divisor's ideal
  -- sheaf by `Tensor.ringSheaf ⟨X.presheaf, X.IsSheaf⟩`, so the two `Mono` instances are not
  -- synthesized at these applications although both are in scope; each is applied with `@` and
  -- the instances given by name.
  have hq := @Stacks.IdealTorsion.Eta.quasiIso_comp_pullbackEtaMap_of_forall_stalk_goodModel
    _ _ h.toLRSHom.toShHom (idealSheaf D) (idealSheafι D)
    (mono_idealSheafι D) (isInvertible_idealSheaf D)
    (mono_pullbackIdealIncl_of_isPullbackDefined h D hD) 𝒦
    (isIdealTorsionFree_flatComplex D 𝒦 hflat)
    (isIdealTorsionFree_pullback_flatComplex h D hD 𝒦 hflat)
    (isLocallyGeneratedByRegular_idealSheafι D)
    (isLocallyGeneratedByRegular_pullbackIdealIncl h D hD)
    hflat h𝒦 P hP p hp hgood
  obtain ⟨c, hc⟩ : ∃ c : _ ≅ _, etaPullbackChainMap h D hD 𝒦 hflat =
      @Stacks.IdealTorsion.Eta.pullbackEtaMap _ _ h.toLRSHom.toShHom (idealSheaf D)
          (idealSheafι D) (mono_idealSheafι D) (isInvertible_idealSheaf D)
          (mono_pullbackIdealIncl_of_isPullbackDefined h D hD) 𝒦
        (isIdealTorsionFree_flatComplex D 𝒦 hflat)
        (isIdealTorsionFree_pullback_flatComplex h D hD 𝒦 hflat) ≫ c.hom := ⟨_, rfl⟩
  rw [hc]
  erw [← Category.assoc]
  exact (quasiIso_iff_of_arrow_mk_iso _ _
    (Arrow.isoMk' _ _ (Iso.refl _) c (Category.id_comp _))).1 hq

include hD hflat in
/-- **Tag 0F9X with goodness in place of flatness, at a chosen K-flat presentation of the
décalage.**  Same hypotheses as
`Stacks.Divisors.Eta.nonempty_derivedPullback_derivedEta_iso_of_forall_stalk_good`, except that
the auxiliary K-flat presentation `p : P^• ⟶ η_I 𝒦` that the reduction
`Stacks.Divisors.Eta.nonempty_derivedPullback_derivedEta_iso_of_quasiIso'` consumes is carried
rather than produced.

**No flatness of `h` is used.**  The route is the source's: stalkwise goodness feeds the
ring-level goodness form of Tag 0F7X
(`Stacks.Eta.GoodBaseChange.quasiIso_baseChangeMap_comp_etaBaseChangeMap_of_kFlat`) through the
stalk bridge, which turns it into quasi-isomorphy of the chain-level comparison
`h^*(η_I 𝒦) ⟶ η_J(h^* 𝒦)` at the presentation `p`. -/
theorem nonempty_derivedPullback_derivedEta_iso_of_forall_stalk_good_at_presentation
    (h𝒦 : Stacks.Cohomology.KFlatDerivedPullback.KFlatComplex X.toRingedSpace 𝒦)
    (P : CochainComplex X.Modules ℤ)
    (hP : Stacks.Cohomology.KFlatDerivedPullback.KFlatComplex X.toRingedSpace P)
    (p : P ⟶ etaObj X.toRingedSpace (idealSheaf D) (idealSheafι D) 𝒦
      (isIdealTorsionFree_flatComplex D 𝒦 hflat))
    (hp : QuasiIso p)
    (hgood : ∀ z : Y, ∃ (a : ringStalk X.toRingedSpace (h.toLRSHom.toShHom.hom.base z))
        (_ : GeneratesStalkIdeal X.toRingedSpace (idealSheafι D)
          (h.toLRSHom.toShHom.hom.base z) a)
        (_ : GeneratesStalkIdeal Y.toRingedSpace
          (pullbackIdealIncl h.toLRSHom.toShHom (idealSheaf D) (idealSheafι D)) z
          (commStalkGermMap h.toLRSHom.toShHom z a))
        (C : BoundedComplex (ringStalk X.toRingedSpace (h.toLRSHom.toShHom.hom.base z))),
        (∀ i : ℤ, (idealI C a i).IsPrincipal) ∧
          Nonempty (DerivedCategory.Q.obj C.toCochainComplex ≅
            DerivedCategory.Q.obj
              (stalkComplex X.toRingedSpace (h.toLRSHom.toShHom.hom.base z) 𝒦)))
    (M : DerivedCategory X.Modules) (e : DerivedCategory.Q.obj 𝒦 ≅ M) :
    Nonempty ((derivedPullback h.toLRSHom.toShHom).obj ((derivedEtaData D).functor.obj M) ≅
      (derivedEtaData (D.comap h)).functor.obj
        ((derivedPullback h.toLRSHom.toShHom).obj M)) :=
  nonempty_derivedPullback_derivedEta_iso_of_quasiIso' h D hD 𝒦 hflat h𝒦 P hP p hp
    (quasiIso_comp_etaPullbackChainMap_of_forall_stalk_good h D hD 𝒦 hflat h𝒦 P hP p hp hgood)
    M e

include hD hflat in
/-- **[Stacks, Tag 0F9X] with goodness in place of flatness.**  Let `X` be a scheme, let
`D ⊆ X` be an effective Cartier divisor with ideal sheaf `I = ℐ_D`, let `h : Y ⟶ X` be an
**arbitrary** morphism of schemes such that the inverse image `E = h^{-1}D` is defined, and let
`J = ℐ_E`.  Let `M` be an object of `D(𝒪_X)` presented by a K-flat complex `𝒦` of flat
`𝒪_X`-modules, and suppose that at every point `z` of `Y` the stalk complex of `𝒦` at `h(z)` is
**good**: there are a generator `a` of `I_{h(z)}` whose germ generates `J_z` and a bounded
complex `C` of finite free `𝒪_{X,h(z)}`-modules representing `𝒦_{h(z)}` in `D(𝒪_{X,h(z)})` all
of whose determinantal ideals `I_i(C, a)` are principal.  Then

`Lh^*(Lη_I M) ≅ Lη_J(Lh^* M)`

in `D(𝒪_Y)`.

**No flatness of `h` is used**, which is what separates this from
`Stacks.Divisors.Eta.isIso_derivedEtaPullbackComparison`.  Presenting `M` by a K-flat complex of
flat modules is no restriction: `Stacks.Divisors.Eta.exists_kFlat_isFlat_rep'` produces one for
every object of `D(𝒪_X)`.  The auxiliary K-flat presentation of `η_I 𝒦` that the reduction
consumes is supplied here by the K-flat resolution of Stacks 06YF, so it is not a hypothesis. -/
@[stacks 0F9X "the general case --- goodness in place of flatness, with goodness of the triple \
(Situation 0F8S) read at the stalks: at every point z of Y the stalk complex of the chosen \
representative is represented in the derived category of the local ring O_{X,h(z)} by a bounded \
complex C of finite free modules whose determinantal ideals I_i(C, a) are all principal, a \
being a generator of the stalk of the ideal sheaf. The passage from \
AlgebraicGeometry.ComplexAndDivisorSituation.IsGoodTriple to that stalkwise reading is \
AlgebraicGeometry.ComplexAndDivisorSituation.exists_affineOpen_stalk_goodModel, and the \
statement of the tag at a good triple is \
AlgebraicGeometry.ComplexAndDivisorSituation.nonempty_derivedPullback_derivedEta_iso. The case \
of a flat h, which neither implies nor is implied by this one, is \
Stacks.Divisors.Eta.isIso_derivedEtaPullbackComparison"]
theorem nonempty_derivedPullback_derivedEta_iso_of_forall_stalk_good
    (h𝒦 : Stacks.Cohomology.KFlatDerivedPullback.KFlatComplex X.toRingedSpace 𝒦)
    (hgood : ∀ z : Y, ∃ (a : ringStalk X.toRingedSpace (h.toLRSHom.toShHom.hom.base z))
        (_ : GeneratesStalkIdeal X.toRingedSpace (idealSheafι D)
          (h.toLRSHom.toShHom.hom.base z) a)
        (_ : GeneratesStalkIdeal Y.toRingedSpace
          (pullbackIdealIncl h.toLRSHom.toShHom (idealSheaf D) (idealSheafι D)) z
          (commStalkGermMap h.toLRSHom.toShHom z a))
        (C : BoundedComplex (ringStalk X.toRingedSpace (h.toLRSHom.toShHom.hom.base z))),
        (∀ i : ℤ, (idealI C a i).IsPrincipal) ∧
          Nonempty (DerivedCategory.Q.obj C.toCochainComplex ≅
            DerivedCategory.Q.obj
              (stalkComplex X.toRingedSpace (h.toLRSHom.toShHom.hom.base z) 𝒦)))
    (M : DerivedCategory X.Modules) (e : DerivedCategory.Q.obj 𝒦 ≅ M) :
    Nonempty ((derivedPullback h.toLRSHom.toShHom).obj ((derivedEtaData D).functor.obj M) ≅
      (derivedEtaData (D.comap h)).functor.obj
        ((derivedPullback h.toLRSHom.toShHom).obj M)) := by
  obtain ⟨P, q, hP, -, hq, -⟩ := Stacks.Cohomology.KFlatDerivedPullback.exists_kFlatResolution
    X.toRingedSpace (etaObj X.toRingedSpace (idealSheaf D) (idealSheafι D) 𝒦
      (isIdealTorsionFree_flatComplex D 𝒦 hflat))
  exact nonempty_derivedPullback_derivedEta_iso_of_forall_stalk_good_at_presentation h D hD 𝒦
    hflat h𝒦 P hP q hq hgood M e

end Stacks.Divisors.Eta

end
