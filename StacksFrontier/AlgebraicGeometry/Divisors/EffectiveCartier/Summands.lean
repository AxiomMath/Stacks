module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartier.Sum

/-!
# The summands of an effective Cartier divisor

Let `X` be a scheme and `Z, Y ⊆ X` two closed subschemes with ideal sheaves `ℐ` and `𝒥`.  If the
product `ℐ · 𝒥` cuts out an effective Cartier divisor `D ⊆ X`, then `Z` and `Y` are themselves
effective Cartier divisors, and `D = Z + Y`.  The last assertion is built into the
representation: the sum of two closed subschemes is the closed subscheme cut out by the product
of their ideal sheaves, so `D` *is* `Z + Y`, and what is left to prove is that each factor is
effective Cartier.

## Main results

* `Ideal.map_eq_span_singleton_of_mul_eq_span_singleton`: the ring-theoretic step.
* `AlgebraicGeometry.exists_finset_factorization_of_mul_eq_span_singleton`: a nonzerodivisor
  generator of a product of two ideals is a sum of products whose coefficients sum to `1`.
* `AlgebraicGeometry.isEffectiveCartierDivisor_left_of_mul` and
  `AlgebraicGeometry.isEffectiveCartierDivisor_right_of_mul`: **Stacks Tag 07ZV.**

## The argument

The question is local, by the two halves of Tag 01WS
(`Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor` and
`Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen`), so fix a point `x` and
an affine open `U` on which `(ℐ · 𝒥)(U) = (f)` with `f` a nonzerodivisor.  Write
`f = ∑ aᵢ bᵢ` with `aᵢ ∈ ℐ(U)` and `bᵢ ∈ 𝒥(U)`.  Each product `aᵢ bᵢ` lies in `(f)`, say
`aᵢ bᵢ = cᵢ f`, and cancelling the nonzerodivisor `f` from `f = ∑ cᵢ f` gives `∑ cᵢ = 1`.  The
stalk at `x` is a local ring, so some `cᵢ` has invertible germ, and then `x` lies in the basic
open `D(cᵢ)`.  On `D(cᵢ)` the element `cᵢ` becomes a unit, and
`Ideal.map_eq_span_singleton_of_mul_eq_span_singleton` turns the single relation
`aᵢ bᵢ = cᵢ f` into `ℐ(D(cᵢ)) = (aᵢ)`, with `aᵢ` a nonzerodivisor there because
`aᵢ bᵢ = cᵢ f` is one.

## References

* [Stacks Project, Tag 07ZV](https://stacks.math.columbia.edu/tag/07ZV)
-/

@[expose] public section

open CategoryTheory Stacks.Divisors

universe u v

/-- **Reading off a generator of a factor of a principal product.**  Let `I`, `J` be ideals of a
commutative ring `A` with `I * J = (f)`, and let `x ∈ I`, `y ∈ J` and `c ∈ A` satisfy
`x * y = c * f`.  Along a ring map `ρ` that makes `ρ c` a unit and `ρ f` a nonzerodivisor, the
ideal `I` becomes principal, generated by `ρ x`.

Indeed `ρ x * ρ y = ρ c * ρ f` is then a nonzerodivisor, so `ρ y` is one; and for `z ∈ I` the
product `z * y` lies in `I * J = (f)`, say `z * y = b * f`, whence
`ρ z * ρ y = ρ b * (ρ c)⁻¹ * ρ x * ρ y` and `ρ y` cancels. -/
theorem Ideal.map_eq_span_singleton_of_mul_eq_span_singleton {A : Type u} {B : Type v}
    [CommRing A] [CommRing B] (ρ : A →+* B) {I J : Ideal A} {c f x y : A}
    (hxy : x * y = c * f) (hx : x ∈ I) (hy : y ∈ J) (hIJ : I * J = Ideal.span {f})
    (hc : IsUnit (ρ c)) (hf : _root_.IsRegular (ρ f)) :
    Ideal.map ρ I = Ideal.span {ρ x} := by
  have hxyB : ρ x * ρ y = ρ c * ρ f := by simpa only [map_mul] using congrArg ρ hxy
  have hyB : _root_.IsRegular (ρ y) := (hxyB ▸ hc.isRegular.mul hf).of_mul_right
  have hfrep : ρ f = (hc.unit⁻¹ : Bˣ) * (ρ x * ρ y) := by
    rw [hxyB, ← mul_assoc, hc.val_inv_mul, one_mul]
  refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun z hz => ?_) ?_
  · obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp (hIJ ▸ Ideal.mul_mem_mul hz hy)
    refine Ideal.mem_span_singleton.mpr ⟨(hc.unit⁻¹ : Bˣ) * ρ b, hyB.right ?_⟩
    calc ρ z * ρ y = ρ b * ρ f := by
            simpa only [map_mul, mul_comm] using congrArg ρ hb
      _ = ρ x * ((hc.unit⁻¹ : Bˣ) * ρ b) * ρ y := by
            rw [hfrep]
            ring
  · simpa only [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe] using
      Ideal.mem_map_of_mem ρ hx

namespace AlgebraicGeometry

/-- **A nonzerodivisor generator of a product of ideals is a sum of products.**  If
`I * J = (f)` with `f` a nonzerodivisor of a commutative ring `A`, there is a finite family of
elements `i` of `J`, each paired with `a i ∈ I` and a coefficient `c i` with
`a i * i = c i * f`, whose coefficients sum to `1`.

The family comes from writing `f` as a finite `I`-linear combination of elements of `J`; that
`∑ c i = 1` is then the cancellation of `f` from `f = ∑ c i * f`. -/
theorem exists_finset_factorization_of_mul_eq_span_singleton {A : Type u} [CommRing A]
    {I J : Ideal A} {f : A} (hIJ : I * J = Ideal.span {f}) (hf : IsRegular f) :
    ∃ (t : Finset J) (a c : J → A), (∀ i ∈ t, a i ∈ I) ∧
      (∀ i ∈ t, a i * (i : A) = c i * f) ∧ ∑ i ∈ t, c i = 1 := by
  classical
  have hspan : Submodule.span A (Set.range fun y : J => (y : A)) = J := by
    rw [← Submodule.span_eq J]
    congr 1
    ext z
    simp
  have hfmem : f ∈ I • Submodule.span A (Set.range fun y : J => (y : A)) := by
    rw [hspan, Ideal.smul_eq_mul, hIJ]
    exact Ideal.mem_span_singleton_self f
  obtain ⟨a, ha, hsum⟩ :=
    (Submodule.mem_ideal_smul_span_iff_exists_sum I (fun y : J => (y : A)) f).mp hfmem
  choose b hb using fun i : J =>
    Ideal.mem_span_singleton.mp (hIJ ▸ Ideal.mul_mem_mul (ha i) i.2)
  have hkey : f * ∑ i ∈ a.support, b i = f * 1 := by
    rw [Finset.mul_sum, mul_one]
    calc (∑ i ∈ a.support, f * b i) = ∑ i ∈ a.support, a i * (i : A) :=
          Finset.sum_congr rfl fun i _ => (hb i).symm
      _ = f := by simpa [Finsupp.sum, smul_eq_mul] using hsum
  exact ⟨a.support, a, b, fun i _ => ha i, fun i _ => (hb i).trans (mul_comm _ _), hf.left hkey⟩

variable {X : Scheme.{u}}

/-- **Stacks Project, Tag 07ZV.**  If the product of the ideal sheaves of two closed subschemes
of a scheme cuts out an effective Cartier divisor, then the first subscheme is an effective
Cartier divisor. -/
@[stacks 07ZV "effectivity of the first summand"]
theorem isEffectiveCartierDivisor_left_of_mul (I J : X.IdealSheafData)
    (hIJ : IsEffectiveCartierDivisor (I * J)) : IsEffectiveCartierDivisor I := by
  classical
  refine isEffectiveCartierDivisor_of_forall_exists_affineOpen I fun x => ?_
  obtain ⟨U, hU, hxU, f, hf, hgen⟩ :=
    exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor (I * J) hIJ x
  have hprod : I.ideal ⟨U, hU⟩ * J.ideal ⟨U, hU⟩ = Ideal.span {f} := hgen
  obtain ⟨t, a, c, hmem, hfactor, hone⟩ :=
    exists_finset_factorization_of_mul_eq_span_singleton hprod hf
  have hsum : IsUnit (∑ i ∈ t, (X.presheaf.germ U x hxU).hom (c i)) := by
    rw [← map_sum, hone, map_one]
    exact isUnit_one
  obtain ⟨i, hi, hunit⟩ := IsLocalRing.exists_of_isUnit_sum hsum
  set W : X.affineOpens := X.affineBasicOpen (U := ⟨U, hU⟩) (c i)
  have hWU : W ≤ (⟨U, hU⟩ : X.affineOpens) := X.affineBasicOpen_le (V := ⟨U, hU⟩) (c i)
  have hfW : IsRegular ((X.presheaf.map (homOfLE hWU).op).hom f) :=
    isRegular_res_of_isAffineOpen hU hf hWU
  have hcW : IsUnit ((X.presheaf.map (homOfLE hWU).op).hom (c i)) :=
    X.toRingedSpace.isUnit_res_basicOpen (c i)
  refine ⟨W, W.2, (X.mem_basicOpen (c i) x hxU).2 hunit,
    (X.presheaf.map (homOfLE hWU).op).hom (a i), ?_, ?_⟩
  · have h := congrArg (X.presheaf.map (homOfLE hWU).op).hom (hfactor i hi)
    rw [map_mul, map_mul] at h
    exact IsRegular.of_mul_left (h ▸ hcW.isRegular.mul hfW)
  · rw [← I.map_ideal hWU]
    exact Ideal.map_eq_span_singleton_of_mul_eq_span_singleton
      (X.presheaf.map (homOfLE hWU).op).hom (hfactor i hi) (hmem i hi) i.2 hprod hcW hfW

/-- **Stacks Project, Tag 07ZV.**  If the product of the ideal sheaves of two closed subschemes
of a scheme cuts out an effective Cartier divisor, then the second subscheme is an effective
Cartier divisor. -/
@[stacks 07ZV "effectivity of the second summand"]
theorem isEffectiveCartierDivisor_right_of_mul (I J : X.IdealSheafData)
    (hIJ : IsEffectiveCartierDivisor (I * J)) : IsEffectiveCartierDivisor J :=
  isEffectiveCartierDivisor_left_of_mul J I (by simpa only [mul_comm] using hIJ)

end AlgebraicGeometry

end
