module

public import Mathlib.AlgebraicGeometry.Modules.Sheaf
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.InvertibleRankOne.Characterization
public import StacksFrontier.AlgebraicGeometry.Divisors.IdealSheafSections
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierComplement

/-!
# An effective Cartier divisor is cut out by a nonzerodivisor on affine opens

Let `X` be a scheme and `D ⊆ X` a closed subscheme whose ideal sheaf `ℐ_D` is an invertible
`𝒪_X`-module, that is, an effective Cartier divisor. This file proves that every point of `X`
has an affine open neighbourhood `U` on which `ℐ_D` is generated by a single nonzerodivisor of
`Γ(X, U)`. It is the direction of [Stacks, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
that `StacksFrontier.AlgebraicGeometry.Divisors.IdealSheafSections` does not prove, and with it the
remark following Definition 01WR, that an effective Cartier divisor is locally principal.

## The argument

Invertibility is converted into local freeness of rank one by the characterization clause of
[Stacks, Tag 0B8M](https://stacks.math.columbia.edu/tag/0B8M), which holds because the stalks of
the structure sheaf of a scheme are local rings; local freeness of rank one is in turn a
trivialization `ℐ_D|_{V} ≅ 𝒪_X|_{V}` over each member of a covering family
(`Stacks.SheafOfModules.Invertible.isLocallyTrivial_of_isFiniteLocallyFreeOfRank_one`).

Such a trivialization is multiplication by a section, by
`Stacks.SheafOfModules.exists_smulSectionMap_bijective_of_over_iso_unit`, and bijectively so over
*every* object of the slice site `Opens X / V` — in particular over an affine open `U ⊆ V`
containing the given point, which the affine opens being a basis supplies. Reading that section
of the ideal sheaf as a section of the structure sheaf
(`Stacks.Divisors.idealSheafSection`) turns the bijectivity into exactly the two assertions
wanted: surjectivity says every element of `I.ideal U` is a multiple of it, and injectivity says
it is a nonzerodivisor.

## Main results

* `Stacks.Divisors.exists_affineOpens_ideal_eq_span_of_isEffectiveCartierDivisor`: the local
  generator, as a nonzerodivisor.
* `Stacks.Divisors.isLocallyPrincipal_of_isEffectiveCartierDivisor` (in
  `StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierComplement`): an effective Cartier
  divisor is locally principal.

## References

* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
* [Stacks Project, Tag 01WR](https://stacks.math.columbia.edu/tag/01WR)
* [Stacks Project, Tag 0B8M](https://stacks.math.columbia.edu/tag/0B8M)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace Opposite
open RingedSpaceModuleAdjunction

universe u

namespace Stacks.Divisors

variable {X : Scheme.{u}}

/-- **The characterization clause of Stacks Tag 0B8M, for the ideal sheaf of a closed subscheme
of a scheme.** A closed subscheme is an effective Cartier divisor exactly when its ideal sheaf is
finite locally free of rank one. The stalks of the structure sheaf of a scheme are local rings,
which is the hypothesis of that clause. -/
theorem isEffectiveCartierDivisor_iff_isFiniteLocallyFreeOfRank_one (I : X.IdealSheafData) :
    IsEffectiveCartierDivisor I ↔
      Stacks.SheafOfModules.Invertible.IsFiniteLocallyFreeOfRank
        (R := structureSheafRing X.toRingedSpace) (idealSheafOfModules I) 1 :=
  Stacks.SheafOfModules.isInvertible_iff_isFiniteLocallyFreeOfRank_one_algebraicGeometry _

/-- **An effective Cartier divisor is cut out by a nonzerodivisor near every point.** Every point
of `X` has an affine open neighbourhood `U` on which the ideal of the closed subscheme is
generated by a single element of `Γ(X, U)` which is a nonzerodivisor.

This is the direction (1) ⇒ (2) of Stacks Tag 01WS, in its algebraic form; the converse is
`Stacks.Divisors.isEffectiveCartierDivisor_of_forall_mem_support`. -/
theorem exists_affineOpens_ideal_eq_span_of_isEffectiveCartierDivisor (I : X.IdealSheafData)
    (hI : IsEffectiveCartierDivisor I) (x : X) :
    ∃ (U : X.affineOpens) (f : Γ(X, (U : X.Opens))), x ∈ (U : Set X) ∧
      I.ideal U = Ideal.span {f} ∧ f ∈ nonZeroDivisors Γ(X, (U : X.Opens)) := by
  classical
  have : Stacks.SheafOfModules.Invertible.IsFiniteLocallyFreeOfRank
      (R := structureSheafRing X.toRingedSpace) (idealSheafOfModules I) 1 :=
    (isEffectiveCartierDivisor_iff_isFiniteLocallyFreeOfRank_one I).mp hI
  obtain ⟨Ix, V, hV, hiso⟩ :=
    (Stacks.SheafOfModules.Invertible.isLocallyTrivial_of_isFiniteLocallyFreeOfRank_one
      (idealSheafOfModules I)).exists_trivializing_cover
  have hxV : x ∈ ⨆ i, V i := by
    rw [(Opens.coversTop_iff X V).mp hV]
    trivial
  rw [Opens.mem_iSup] at hxV
  obtain ⟨i, hxi⟩ := hxV
  obtain ⟨-, ⟨W, hW, rfl⟩, hxW, hWle⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxi (V i).isOpen
  obtain ⟨e, he⟩ := Stacks.SheafOfModules.exists_smulSectionMap_bijective_of_over_iso_unit
    (𝒪 := X.sheaf.obj) (h𝒪 := (structureSheafRing X.toRingedSpace).property)
    (L := idealSheafOfModules I) (hiso i).some
  obtain ⟨y, hbij⟩ : ∃ y : (idealSheafOfModules I).val.obj (op W),
      Function.Bijective (Stacks.SheafOfModules.smulSectionMap
        (𝒪 := X.sheaf.obj) (h𝒪 := (structureSheafRing X.toRingedSpace).property) y) :=
    ⟨_, he (op (Over.mk (homOfLE (show W ≤ V i from hWle))))⟩
  have hmul (c : Γ(X, W)) : idealSheafSection I (Stacks.SheafOfModules.smulSectionMap y c) =
      c * idealSheafSection I y := idealSheafSection_smulSectionMap I y c
  refine ⟨⟨W, hW⟩, idealSheafSection I y, hxW, le_antisymm ?_ ?_, ?_⟩
  · intro r hr
    obtain ⟨z, hz⟩ := (mem_ideal_iff_exists_idealSheafSection I ⟨W, hW⟩ r).mp hr
    obtain ⟨c, hc⟩ := hbij.surjective z
    exact Ideal.mem_span_singleton'.mpr ⟨c, (hmul c).symm.trans ((congrArg _ hc).trans hz)⟩
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
    exact (mem_ideal_iff_exists_idealSheafSection I ⟨W, hW⟩ _).mpr ⟨y, rfl⟩
  · have key (c) (hc : c * idealSheafSection I y = 0) : c = 0 :=
      hbij.injective (a₁ := c) (a₂ := 0)
        (idealSheafSection_injective I (((hmul c).trans hc).trans ((hmul 0).trans (by
          rw [zero_mul])).symm))
    exact mem_nonZeroDivisors_iff.mpr
      ⟨fun c hc => key c (by rw [mul_comm]; exact hc), fun c hc => key c hc⟩

end Stacks.Divisors

end
