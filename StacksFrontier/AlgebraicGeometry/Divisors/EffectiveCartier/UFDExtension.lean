/-!
# Extending an effective Cartier divisor across a factorial locus

Let `X` be a locally Noetherian scheme, `U ⊆ X` an open subscheme and `D ⊆ U` an effective
Cartier divisor. If the local ring `𝒪_{X, x}` is a unique factorization domain at every point
`x` outside `U`, then `D` extends to an effective Cartier divisor `D' ⊆ X` cutting out `D` on
`U`.

The extension is the scheme-theoretic image of `D ⟶ X`, that is the kernel ideal sheaf of
`D ⟶ U ⟶ X`. It restricts to `D` on `U` because the formation of the kernel commutes with
restriction to an open of the target
(`AlgebraicGeometry.ker_morphismRestrict_eq_comap`, Tag 01R8). That it is an effective Cartier
divisor is checked stalk by stalk, by
`AlgebraicGeometry.isEffectiveCartierDivisor_of_stalk_regular_principal` (Tag 0AG8): at a point
of `U` the stalk ideal is the stalk ideal of `D`, which is principal with a nonzerodivisor
generator; at a point `x` outside `U` the whole situation is pulled back along the flat morphism
`Spec 𝒪_{X, x} ⟶ X`, where the ambient ring is a Noetherian UFD. There the extended ideal is
finitely generated, the greatest common divisor of a finite generating set generates it, and that
generator is nonzero because the ideal becomes principal and nonzero at every point of the
preimage of `U`.

## Main results

* `AlgebraicGeometry.exists_isEffectiveCartierDivisor_comap_eq`: the extension (Tag 0BD8).
* `AlgebraicGeometry.exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor`: the converse
  of the stalkwise criterion — the ideal of an effective Cartier divisor is principal with a
  nonzerodivisor generator in every local ring.
* `AlgebraicGeometry.ker_comap_eq_of_isOpenImmersion`: the scheme-theoretic image of a closed
  subscheme of an open subscheme cuts that subscheme out again.

## Implementation notes

The commutative-algebra step is
`AlgebraicGeometry.map_span_eq_span_gcd_of_isPrincipal`: in a localization of a normalized GCD
monoid, a finitely generated ideal whose extension is principal has that extension generated by
the image of the greatest common divisor of the generators. This is what makes the generator
produced at the closed point of `Spec 𝒪_{X, x}` descend to `𝒪_{X, x}` itself.

## References

* [Stacks Project, Tag 0BD8](https://stacks.math.columbia.edu/tag/0BD8)
* [Stacks Project, Tag 0AG8](https://stacks.math.columbia.edu/tag/0AG8)
* [Stacks Project, Tag 01R8](https://stacks.math.columbia.edu/tag/01R8)
* [Stacks Project, Tag 081I](https://stacks.math.columbia.edu/tag/081I)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite Stacks.Divisors

universe u

namespace AlgebraicGeometry

/-- The ideal generated by a finite set lies in the ideal generated by its gcd. -/
private theorem span_finset_le_span_gcd {R : Type*} [CommRing R] [NormalizedGCDMonoid R]
    (s : Finset R) : Ideal.span (s : Set R) ≤ Ideal.span {s.gcd id} :=
  Ideal.span_le.mpr fun _ hr => Ideal.mem_span_singleton.mpr (Finset.gcd_dvd hr)

/-- **The gcd generates a principal extension.** In a localization `S` of a normalized GCD
monoid `R`, if the ideal generated by a finite set `s` extends to a principal ideal of `S`, that
extension is generated by the image of `s.gcd id`. -/
theorem map_span_eq_span_gcd_of_isPrincipal {R S : Type*} [CommRing R] [CommRing S]
    [NormalizedGCDMonoid R] (M : Submonoid R) [Algebra R S] [IsLocalization M S]
    (s : Finset R) (h : (Ideal.map (algebraMap R S) (Ideal.span (s : Set R))).IsPrincipal) :
    Ideal.map (algebraMap R S) (Ideal.span (s : Set R)) =
      Ideal.span {algebraMap R S (s.gcd id)} := by
  classical
  let I : Ideal R := Ideal.span (s : Set R)
  let J : Ideal S := I.map (algebraMap R S)
  refine le_antisymm ?_ ?_
  · refine le_trans (Ideal.map_mono (f := algebraMap R S) (span_finset_le_span_gcd s)) ?_
    rw [Ideal.map_span, Set.image_singleton]
  obtain ⟨b, hb⟩ := h.principal
  change J = Ideal.span {b} at hb
  obtain ⟨⟨a, t⟩, hat⟩ := (IsLocalization.mem_map_algebraMap_iff M S).mp
    (show b ∈ J from hb ▸ Ideal.subset_span (by simp))
  have hJa : J = Ideal.span {algebraMap R S a} := by
    rw [hb]
    refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
    · rintro z (rfl : z = b)
      refine (Ideal.unit_mul_mem_iff_mem _ (IsLocalization.map_units S t)).mp ?_
      rw [mul_comm, hat]
      exact Ideal.subset_span (by simp)
    · rintro z (rfl : z = algebraMap R S a)
      rw [← hat]
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
  have hdvd : ∀ r ∈ s, ∃ m ∈ M, (a : R) ∣ m * r := by
    intro r hr
    have hrJ : algebraMap R S r ∈ J := Ideal.mem_map_of_mem _ (Ideal.subset_span hr)
    rw [hJa, ← Set.image_singleton, ← Ideal.map_span] at hrJ
    obtain ⟨m, hm, hmr⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff M S (Ideal.span {a.1}) r).mp hrJ
    exact ⟨m, hm, Ideal.mem_span_singleton.mp hmr⟩
  choose m hm hmr using hdvd
  let t' : R := ∏ r ∈ s, if hr : r ∈ s then m r hr else 1
  have ht' : t' ∈ M :=
    Submonoid.prod_mem _ fun r hr => by simpa only [dite_eq_left hr] using hm r hr
  have hadvd : (a : R) ∣ t' * s.gcd id := by
    refine (s.gcd_mul_left' id t').dvd_iff_dvd_right.mp (Finset.dvd_gcd_iff.mpr fun r hr => ?_)
    have hmdiv : m r hr ∣ t' := by
      simpa only [dite_eq_left hr] using
        Finset.dvd_prod_of_mem (fun r => if hr : r ∈ s then m r hr else 1) hr
    exact (hmr r hr).trans (mul_dvd_mul_right hmdiv r)
  change Ideal.span {algebraMap R S (s.gcd id)} ≤ J
  rw [hJa]
  refine Ideal.span_le.mpr ?_
  rintro z (rfl : z = algebraMap R S (s.gcd id))
  refine (Ideal.unit_mul_mem_iff_mem _ (IsLocalization.map_units S ⟨t', ht'⟩)).mp ?_
  simpa only [← map_mul] using Ideal.mem_span_singleton.mpr (map_dvd (algebraMap R S) hadvd)

/-- An ideal is principal with a nonzerodivisor generator as soon as its extension along a ring
isomorphism is. -/
theorem exists_isRegular_eq_span_of_ringEquiv {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) (I : Ideal R)
    (hI : ∃ f : S, IsRegular f ∧ I.map e.toRingHom = Ideal.span {f}) :
    ∃ f : R, IsRegular f ∧ I = Ideal.span {f} := by
  obtain ⟨f, hf, he⟩ := hI
  refine ⟨e.symm f, isRegular_ringEquiv e.symm hf, ?_⟩
  have h := congrArg (Ideal.map e.symm.toRingHom) he
  rwa [Ideal.map_map, show e.symm.toRingHom.comp e.toRingHom = RingHom.id R by ext; simp,
    Ideal.map_id, Ideal.map_span, Set.image_singleton] at h

/-- The germ of a nonzerodivisor section on an affine open is a nonzerodivisor in the stalk, the
stalk being a localization of the sections. -/
theorem isRegular_germ {X : Scheme.{u}} (U : X.affineOpens) (x : X) (hx : x ∈ U.1)
    {f : Γ(X, U.1)} (hf : IsRegular f) :
    IsRegular ((X.presheaf.germ U.1 x hx).hom f) := by
  let _ := X.presheaf.algebra_section_stalk (⟨x, hx⟩ : U.1)
  have _ := U.2.isLocalization_stalk ⟨x, hx⟩
  exact isRegular_iff_mem_nonZeroDivisors.mpr
    (IsLocalization.map_nonZeroDivisors_le (U.2.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl
      (X.presheaf.stalk x) ⟨f, hf.mem_nonZeroDivisors, rfl⟩)

/-- **The converse of the stalkwise criterion for an effective Cartier divisor.** The ideal of an
effective Cartier divisor is generated by a nonzerodivisor in the local ring at every point:
around a point of the support it is generated on an affine open by a nonzerodivisor, whose germ
then generates the stalk ideal, and off the support it is the unit ideal.

Together with `AlgebraicGeometry.isEffectiveCartierDivisor_of_stalk_regular_principal` this is
the stalkwise characterization of Tag 0AG8. -/
theorem exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor {X : Scheme.{u}}
    (I : X.IdealSheafData) (hI : IsEffectiveCartierDivisor I) (x : X) :
    ∃ f : X.presheaf.stalk x, IsRegular f ∧ IdealSheafData.stalk I x = Ideal.span {f} := by
  obtain ⟨U, hU, hxU, f, hf, hgen⟩ :=
    exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor I hI x
  refine ⟨(X.presheaf.germ U x hxU).hom f, isRegular_germ ⟨U, hU⟩ x hxU hf, ?_⟩
  rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ I x ⟨U, hU⟩ hxU, hgen, Ideal.map_span,
    Set.image_singleton]

/-- **Formation of the stalk ideal commutes with inverse image.** -/
theorem stalk_comap {X Y : Scheme.{u}} (I : X.IdealSheafData) (f : Y ⟶ X) (y : Y) :
    IdealSheafData.stalk (I.comap f) y =
      (IdealSheafData.stalk I (f y)).map (f.stalkMap y).hom := by
  obtain ⟨-, ⟨W, hW, rfl⟩, hyW, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (f y)) isOpen_univ
  let W' : X.affineOpens := ⟨W, hW⟩
  obtain ⟨-, ⟨V, hV, rfl⟩, hyV, hVW⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open
      (show y ∈ f ⁻¹ᵁ (W' : X.Opens) from hyW) (f ⁻¹ᵁ (W' : X.Opens)).isOpen
  let V' : Y.affineOpens := ⟨V, hV⟩
  have hcomp : (f.stalkMap y).hom.comp (X.presheaf.germ W' (f y) hyW).hom =
      (Y.presheaf.germ V' y hyV).hom.comp (f.appLE W' V' hVW).hom := by
    have h₁ := congrArg CommRingCat.Hom.hom (Scheme.Hom.germ_stalkMap (f := f) W' y hyW)
    have h₂ := congrArg CommRingCat.Hom.hom (Y.presheaf.germ_res (homOfLE hVW) y hyV)
    simp only [CommRingCat.hom_comp] at h₁ h₂
    dsimp only [Scheme.Hom.appLE]
    calc (f.stalkMap y).hom.comp (X.presheaf.germ W' (f y) hyW).hom
        = (Y.presheaf.germ (f ⁻¹ᵁ (W' : X.Opens)) y hyW).hom.comp (f.app W').hom := h₁
      _ = ((Y.presheaf.germ V' y hyV).hom.comp
            (Y.presheaf.map (homOfLE hVW).op).hom).comp (f.app W').hom := by rw [← h₂]; rfl
      _ = (Y.presheaf.germ V' y hyV).hom.comp
            ((Y.presheaf.map (homOfLE hVW).op).hom.comp (f.app W').hom) := by
          rw [RingHom.comp_assoc]
      _ = (Y.presheaf.germ V' y hyV).hom.comp (f.appLE W' V' hVW).hom := rfl
  rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ (I.comap f) y V' hyV,
    Stacks.IdealSheaf.ideal_comap_appLE I f W' V' hVW,
    AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ I (f y) W' hyW, Ideal.map_map, Ideal.map_map,
    hcomp]

/-- **The scheme-theoretic image of a closed subscheme of an open subscheme recovers it.** The
kernel ideal sheaf of `D ⟶ U ⟶ X` cuts out `D` again on `U`. -/
theorem ker_comap_eq_of_isOpenImmersion {X : Scheme.{u}} [IsLocallyNoetherian X] (U : X.Opens)
    (D : U.toScheme.IdealSheafData) :
    (D.subschemeι ≫ U.ι).ker.comap U.ι = D := by
  let g := D.subschemeι ≫ U.ι
  have _ : QuasiCompact g := inferInstance
  rw [← ker_morphismRestrict_eq_comap g U]
  dsimp only [g]
  rw [morphismRestrict_comp]
  let P : U.toScheme.Opens := U.ι ⁻¹ᵁ U
  have hinc : U.ι ∣_ U = P.ι := by
    apply (cancel_mono U.ι).1
    rw [morphismRestrict_ι]
  rw [hinc, morphismRestrict_ι]
  have _ : IsIso ((D.subschemeι ⁻¹ᵁ P).ι) := by
    rw [show D.subschemeι ⁻¹ᵁ P = (⊤ : D.subscheme.Opens) by ext z; simp [P],
      ← Scheme.topIso_hom]
    infer_instance
  exact (Scheme.Hom.ker_comp_of_isIso ((D.subschemeι ⁻¹ᵁ P).ι) D.subschemeι).trans
    (Scheme.IdealSheafData.ker_subschemeι D)

/-- At a point of `U` the stalk ideal of the scheme-theoretic image of an effective Cartier
divisor `D ⊆ U` is the stalk ideal of `D`, hence principal with a nonzerodivisor generator. -/
theorem exists_isRegular_stalk_ker_eq_span_of_mem {X : Scheme.{u}} [IsLocallyNoetherian X]
    (U : X.Opens) (D : U.toScheme.IdealSheafData) (hD : IsEffectiveCartierDivisor D)
    (x : X) (hx : x ∈ U) :
    ∃ f : X.presheaf.stalk x, IsRegular f ∧
      IdealSheafData.stalk (D.subschemeι ≫ U.ι).ker x = Ideal.span {f} := by
  have _ : IsIso (U.ι.stalkMap ⟨x, hx⟩) := by
    rw [← U.stalkIso_inv]
    exact (U.stalkIso ⟨x, hx⟩).isIso_inv
  refine exists_isRegular_eq_span_of_ringEquiv
    (asIso (U.ι.stalkMap ⟨x, hx⟩)).commRingCatIsoToRingEquiv _ ?_
  obtain ⟨f, hf, he⟩ :=
    exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor D hD ⟨x, hx⟩
  refine ⟨f, hf, ?_⟩
  have hc := congrArg (fun J : U.toScheme.IdealSheafData => IdealSheafData.stalk J ⟨x, hx⟩)
    (ker_comap_eq_of_isOpenImmersion U D)
  exact (stalk_comap (D.subschemeι ≫ U.ι).ker U.ι ⟨x, hx⟩).symm.trans (hc.trans he)

/-- A section of the structure sheaf of an affine scheme lies in the ideal of the kernel of a
quasi-compact morphism as soon as its germ does at every point of the image. -/
theorem mem_ker_ideal_of_forall_germ_mem_stalk {X Y : Scheme.{u}} [IsAffine X]
    (f : Y ⟶ X) [QuasiCompact f] (a : Γ(X, ⊤))
    (ha : ∀ y : Y, (X.presheaf.germ ⊤ (f y) trivial).hom a ∈
      IdealSheafData.stalk f.ker (f y)) :
    a ∈ f.ker.ideal ⟨⊤, isAffineOpen_top X⟩ := by
  have hker : ∀ y : Y, IdealSheafData.stalk f.ker (f y) ≤ RingHom.ker (f.stalkMap y).hom := by
    intro y
    obtain ⟨-, ⟨W, hW, rfl⟩, hyW, -⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (f y)) isOpen_univ
    rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ f.ker (f y) ⟨W, hW⟩ hyW,
      Ideal.map_le_iff_le_comap]
    intro b hb
    rw [Scheme.Hom.ker_apply, RingHom.mem_ker] at hb
    change (f.stalkMap y).hom ((X.presheaf.germ W (f y) hyW).hom b) = 0
    rw [Scheme.Hom.germ_stalkMap_apply, hb, map_zero]
  rw [Scheme.Hom.ker_apply, RingHom.mem_ker]
  refine TopCat.Presheaf.section_ext
    (⟨Y.presheaf, Y.IsSheaf⟩ : TopCat.Sheaf CommRingCat.{u} Y.toTopCat) _ _ _ fun y hy => ?_
  have h := hker y (ha y)
  rw [RingHom.mem_ker, Scheme.Hom.germ_stalkMap_apply f ⊤ y trivial a] at h
  simpa only [map_zero] using h

/-- Over an affine scheme whose global sections form a Noetherian UFD, the scheme-theoretic image
of an effective Cartier divisor on an open subscheme is cut out by a nonzerodivisor. The gcd of a
finite generating set works: it generates the ideal because the ideal becomes principal in every
stalk, and it is nonzero as soon as the open subscheme is nonempty. -/
theorem exists_isRegular_ker_ideal_eq_span_of_uniqueFactorization {X : Scheme.{u}} [IsAffine X]
    [IsLocallyNoetherian X] [IsDomain Γ(X, ⊤)] [UniqueFactorizationMonoid Γ(X, ⊤)]
    (U : X.Opens) (D : U.toScheme.IdealSheafData) (hD : IsEffectiveCartierDivisor D) :
    ∃ f : Γ(X, ⊤), IsRegular f ∧
      (D.subschemeι ≫ U.ι).ker.ideal ⟨⊤, isAffineOpen_top X⟩ = Ideal.span {f} := by
  classical
  have _ : IsNoetherianRing Γ(X, ⊤) :=
    IsLocallyNoetherian.component_noetherian ⟨⊤, isAffineOpen_top X⟩
  set g := D.subschemeι ≫ U.ι with hgdef
  set I := g.ker.ideal ⟨⊤, isAffineOpen_top X⟩ with hIdef
  rcases isEmpty_or_nonempty U.toScheme with hU | hU
  · have _ : IsEmpty D.subscheme := Function.isEmpty D.subschemeι
    exact ⟨1, isRegular_one, by rw [hIdef, (Scheme.Hom.ker_eq_top_iff_isEmpty g).mpr ‹_›]; simp⟩
  have _ := UniqueFactorizationMonoid.strongNormalizationMonoid (α := Γ(X, ⊤))
  have _ := UniqueFactorizationMonoid.toNormalizedGCDMonoid Γ(X, ⊤)
  obtain ⟨s, hs⟩ := I.fg_of_isNoetherianRing
  set f : Γ(X, ⊤) := s.gcd id with hfdef
  have hfI : f ∈ I := by
    refine mem_ker_ideal_of_forall_germ_mem_stalk g f fun z => ?_
    obtain ⟨b, -, hgen⟩ := exists_isRegular_stalk_ker_eq_span_of_mem U D hD
      (g z) (D.subschemeι z).2
    rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ g.ker (g z) ⟨⊤, isAffineOpen_top X⟩
      trivial] at hgen ⊢
    let _ := X.presheaf.algebra_section_stalk
      (⟨g z, show g z ∈ (⊤ : X.Opens) from trivial⟩ : (⊤ : X.Opens))
    have _ := (isAffineOpen_top X).isLocalization_stalk ⟨g z, trivial⟩
    have he := map_span_eq_span_gcd_of_isPrincipal
      ((isAffineOpen_top X).primeIdealOf ⟨g z, trivial⟩).asIdeal.primeCompl s
      (hs ▸ (⟨b, hgen⟩ : (I.map (algebraMap Γ(X, ⊤) (X.presheaf.stalk (g z)))).IsPrincipal))
    rw [hs] at he
    change algebraMap Γ(X, ⊤) (X.presheaf.stalk (g z)) f ∈
      I.map (algebraMap Γ(X, ⊤) (X.presheaf.stalk (g z)))
    rw [he]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hIf : I = Ideal.span {f} :=
    le_antisymm
      (hs ▸ span_finset_le_span_gcd s)
      (Ideal.span_le.mpr (by simpa using hfI))
  refine ⟨f, isRegular_iff_ne_zero.mpr fun hf0 => ?_, hIf⟩
  obtain ⟨y⟩ := hU
  obtain ⟨b, hb, hgen⟩ := exists_isRegular_stalk_ker_eq_span_of_mem U D hD y.1 y.2
  rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ g.ker y.1 ⟨⊤, isAffineOpen_top X⟩
    trivial] at hgen
  change I.map (X.presheaf.germ ⊤ y.1 trivial).hom = _ at hgen
  rw [hIf, hf0, Ideal.span_singleton_zero, Ideal.map_bot] at hgen
  exact hb.ne_zero (show b ∈ (⊥ : Ideal (X.presheaf.stalk y.1)) from
    hgen.symm ▸ Ideal.subset_span (Set.mem_singleton b))

/-- Base change of the scheme-theoretic image along a flat morphism is the scheme-theoretic
image of the base-changed divisor. -/
theorem ker_comap_eq_ker_of_flat {X Y : Scheme.{u}} [IsLocallyNoetherian X] (U : X.Opens)
    (D : U.toScheme.IdealSheafData) (f : Y ⟶ X) [Flat f] :
    (D.subschemeι ≫ U.ι).ker.comap f =
      ((D.comap (f ∣_ U)).subschemeι ≫ (f ⁻¹ᵁ U).ι).ker := by
  have hs := (IsPullback.of_hasPullback (f ∣_ U) D.subschemeι).flip.paste_vert
    (isPullback_morphismRestrict f U)
  rw [← ker_pullback_snd_eq_comap f (D.subschemeι ≫ U.ι),
    ← Scheme.Hom.ker_comp_of_isIso hs.isoPullback.hom, hs.isoPullback_hom_snd,
    ← Scheme.IdealSheafData.comapIso_hom_fst D (f ∣_ U), Category.assoc,
    Scheme.Hom.ker_comp_of_isIso (D.comapIso (f ∣_ U)).hom]

/-- The ideal of the inverse image of an ideal sheaf along `Spec 𝒪_{X, x} ⟶ X` is the extension
of the stalk ideal. -/
theorem ideal_comap_fromSpecStalk {X : Scheme.{u}} (I : X.IdealSheafData) (x : X) :
    (I.comap (X.fromSpecStalk x)).ideal ⟨⊤, isAffineOpen_top _⟩ =
      (IdealSheafData.stalk I x).map (Scheme.ΓSpecIso (X.presheaf.stalk x)).inv.hom := by
  obtain ⟨-, ⟨W, hW, rfl⟩, hxW, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  have hle : (⊤ : (Spec (X.presheaf.stalk x)).Opens) ≤ (X.fromSpecStalk x) ⁻¹ᵁ W :=
    (Scheme.preimage_eq_top_of_closedPoint_mem _ (by simpa using hxW)).ge
  have happ : (X.fromSpecStalk x).appLE W ⊤ hle =
      X.presheaf.germ W x hxW ≫ (Scheme.ΓSpecIso (X.presheaf.stalk x)).inv := by
    rw [Scheme.Hom.appLE, Scheme.fromSpecStalk_app hxW]
    simp only [Category.assoc, ← Functor.map_comp]
    rw [show (homOfLE (show (X.fromSpecStalk x) ⁻¹ᵁ W ≤ ⊤ from le_top)).op ≫ (homOfLE hle).op
        = 𝟙 _ from Subsingleton.elim _ _, CategoryTheory.Functor.map_id, Category.comp_id]
  rw [Stacks.IdealSheaf.ideal_comap_appLE I (X.fromSpecStalk x) ⟨W, hW⟩
      ⟨⊤, isAffineOpen_top _⟩ hle,
    AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ I x ⟨W, hW⟩ hxW, Ideal.map_map, happ,
    CommRingCat.hom_comp]

/-- At a point where the local ring is a unique factorization domain, the stalk ideal of the
scheme-theoretic image of an effective Cartier divisor `D ⊆ U` is principal with a
nonzerodivisor generator. The whole situation is pulled back along the flat morphism
`Spec 𝒪_{X, x} ⟶ X`, where the ambient scheme is affine with Noetherian UFD global sections. -/
theorem exists_isRegular_stalk_ker_eq_span_of_uniqueFactorization {X : Scheme.{u}}
    [IsLocallyNoetherian X] (U : X.Opens) (D : U.toScheme.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) (x : X)
    [UniqueFactorizationMonoid (X.presheaf.stalk x)] :
    ∃ f : X.presheaf.stalk x, IsRegular f ∧
      IdealSheafData.stalk (D.subschemeι ≫ U.ι).ker x = Ideal.span {f} := by
  have _ : Flat (X.fromSpecStalk x) := flat_fromSpecStalk X x
  have _ : Flat (X.fromSpecStalk x ∣_ U) :=
    MorphismProperty.of_isPullback (isPullback_morphismRestrict (X.fromSpecStalk x) U).flip ‹_›
  have hE : IsEffectiveCartierDivisor (D.comap (X.fromSpecStalk x ∣_ U)) :=
    isPullbackDefined_of_flat (X.fromSpecStalk x ∣_ U) D hD
  set e := (Scheme.ΓSpecIso (X.presheaf.stalk x)).commRingCatIsoToRingEquiv with hedef
  have _ : IsDomain (X.presheaf.stalk x) := ⟨⟩
  have _ : IsDomain Γ(Spec (X.presheaf.stalk x), ⊤) := e.toMulEquiv.isDomain _
  have _ : UniqueFactorizationMonoid Γ(Spec (X.presheaf.stalk x), ⊤) :=
    e.symm.toMulEquiv.uniqueFactorizationMonoid inferInstance
  refine exists_isRegular_eq_span_of_ringEquiv e.symm _ ?_
  obtain ⟨a, ha, he⟩ := exists_isRegular_ker_ideal_eq_span_of_uniqueFactorization
    (X.fromSpecStalk x ⁻¹ᵁ U) (D.comap (X.fromSpecStalk x ∣_ U)) hE
  refine ⟨a, ha, ?_⟩
  have hc := ideal_comap_fromSpecStalk (D.subschemeι ≫ U.ι).ker x
  rw [ker_comap_eq_ker_of_flat] at hc
  exact hc.symm.trans he

/-- **Stacks Project, Tag 0BD8.** An effective Cartier divisor on an open subscheme of a locally
Noetherian scheme extends to an effective Cartier divisor on the whole scheme, provided the local
rings at the points outside the open are unique factorization domains. The extension is the
scheme-theoretic image. -/
@[stacks 0BD8]
theorem exists_isEffectiveCartierDivisor_comap_eq {X : Scheme.{u}} [IsLocallyNoetherian X]
    (U : X.Opens) (D : U.toScheme.IdealSheafData) (hD : IsEffectiveCartierDivisor D)
    (hUFD : ∀ x : X, x ∉ U → UniqueFactorizationMonoid (X.presheaf.stalk x)) :
    ∃ D' : X.IdealSheafData, IsEffectiveCartierDivisor D' ∧ D'.comap U.ι = D := by
  refine ⟨(D.subschemeι ≫ U.ι).ker, ?_, ker_comap_eq_of_isOpenImmersion U D⟩
  refine isEffectiveCartierDivisor_of_stalk_regular_principal _ fun x _ => ?_
  by_cases hxU : x ∈ U
  · exact exists_isRegular_stalk_ker_eq_span_of_mem U D hD x hxU
  · have _ := hUFD x hxU
    exact exists_isRegular_stalk_ker_eq_span_of_uniqueFactorization U D hD x

end AlgebraicGeometry

