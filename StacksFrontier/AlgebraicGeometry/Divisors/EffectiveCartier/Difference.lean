module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartier.Sum
public import StacksFrontier.AlgebraicGeometry.Divisors.IdealSheafColon
public import StacksFrontier.AlgebraicGeometry.Properties.ExtendIdealSheaf

/-!
# The difference of two effective Cartier divisors

Let `X` be a scheme and let `D ⊆ D'` be effective Cartier divisors on `X`, that is, closed
subschemes with invertible ideal sheaves such that `ℐ_{D'} ⊆ ℐ_D`.  Then `D'` is the sum of `D`
and a third effective Cartier divisor `E`:

`ℐ_{D'} = ℐ_D · ℐ_E`.

The divisor `E = D' - D` is the quotient of ideal sheaves `ℐ_{D'} : ℐ_D`.

## Main results

* `AlgebraicGeometry.fg_ideal_of_isEffectiveCartierDivisor`: the ideal sheaf of an effective
  Cartier divisor is finitely generated on every affine open.
* `AlgebraicGeometry.exists_affineOpen_ideal_eq_span_pair`: a common affine chart on which two
  effective Cartier divisors are both principal with nonzerodivisor generator.
* `AlgebraicGeometry.exists_isEffectiveCartierDivisor_mul_eq_of_le`: if `D ⊆ D'` are effective
  Cartier divisors, then `D' = D + E` for an effective Cartier divisor `E`.
* `AlgebraicGeometry.mul_colon_eq_of_isEffectiveCartierDivisor` and
  `AlgebraicGeometry.exists_mul_eq_of_le_of_isEffectiveCartierDivisor`: the same factorization
  `Z = D · (Z : D)` for an arbitrary ideal sheaf `Z ≤ D`, the second factor no longer being a
  divisor.

## The argument

Everything is read on the affine charts supplied by the two halves of Tag 01WS
(`Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor` and
`Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen`), shrunk to a common
basic open with `AlgebraicGeometry.exists_basicOpen_le_affine_inter` so that both divisors are
principal there: `ℐ_D(U) = (a)` and `ℐ_{D'}(U) = (b)` with `a`, `b` nonzerodivisors.  Restriction
preserves nonzerodivisors by `AlgebraicGeometry.isRegular_res_of_isAffineOpen`.

On such a chart `b ∈ (a)`, say `b = a * c`, and the two facts to prove are both immediate
consequences of `a` being a nonzerodivisor:

* `(ℐ_{D'} : ℐ_D)(U) = (c)`: the inclusion `⊇` is the relation `c * a = b`, and for `⊆` an
  element `d` of the colon ideal satisfies `d * a ∈ (b) = (a * c)`, so `d * a = e * a * c` and
  cancelling `a` gives `d = e * c`;
* `ℐ_D(U) · (ℐ_{D'} : ℐ_D)(U) = (a) * (c) = (a * c) = ℐ_{D'}(U)`.

The first makes `E` an effective Cartier divisor, with nonzerodivisor generator `c` because
`a * c = b` is one.  The second is the inclusion `ℐ_{D'} ≤ ℐ_D · ℐ_E`; the reverse inclusion
needs no charts, being the defining property
`AlgebraicGeometry.Scheme.IdealSheafData.mul_colon_le` of the quotient.

The quotient of ideal sheaves exists only because `ℐ_D` is finitely generated on affine opens,
which is where `fg_ideal_of_isEffectiveCartierDivisor` is used: the divisor is principal on a
cover, and finite generation on an affine open descends from a cover by
`Stacks.IdealSheaf.fg_ideal_of_fg_cover`.

## References

* [Stacks Project, Tag 02ON](https://stacks.math.columbia.edu/tag/02ON)
-/

@[expose] public section

open CategoryTheory Stacks.Divisors

universe u

namespace AlgebraicGeometry

variable {X : Scheme.{u}}

/-- Opens `V x ∋ x` indexed by the points of `X` cover `X`. -/
private theorem iSup_eq_top_of_mem {V : X → X.Opens} (h : ∀ x, x ∈ V x) : ⨆ x, V x = ⊤ :=
  eq_top_iff.2 fun z _ => TopologicalSpace.Opens.mem_iSup.2 ⟨z, h z⟩

/-- **The ideal sheaf of an effective Cartier divisor is finitely generated.**  On every affine
open `U` of `X` the ideal `ℐ_D(U)` is finitely generated, because `ℐ_D` is principal on a cover
of `X` and finite generation on an affine open descends from a cover. -/
theorem fg_ideal_of_isEffectiveCartierDivisor (D : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) (U : X.affineOpens) : (D.ideal U).FG := by
  choose V hV hxV f _ hgen using
    fun x : X => exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor D hD x
  refine Stacks.IdealSheaf.fg_ideal_of_fg_cover (V := V) hV ?_ (fun x => ?_) U
  · exact iSup_eq_top_of_mem hxV
  · rw [hgen x]
    exact Submodule.fg_span_singleton (f x)

/-- Restricting a principal ideal sheaf to a smaller affine open gives the principal ideal
generated by the restricted generator. -/
private theorem ideal_eq_span_res {D : X.IdealSheafData} {U W : X.affineOpens} {a : Γ(X, U)}
    (hW : W ≤ U) (h : D.ideal U = Ideal.span {a}) :
    D.ideal W = Ideal.span {(X.presheaf.map (homOfLE hW).op).hom a} := by
  rw [← D.map_ideal hW, h, Ideal.map_span, Set.image_singleton]

/-- **A common principal chart for two effective Cartier divisors.**  Around every point of `X`
there is an affine open on which both of two effective Cartier divisors are cut out by a single
nonzerodivisor. -/
theorem exists_affineOpen_ideal_eq_span_pair (D D' : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) (hD' : IsEffectiveCartierDivisor D') (x : X) :
    ∃ (U : X.Opens) (hU : IsAffineOpen U), x ∈ U ∧ ∃ a b : Γ(X, U),
      IsRegular a ∧ IsRegular b ∧ D.ideal ⟨U, hU⟩ = Ideal.span {a} ∧
        D'.ideal ⟨U, hU⟩ = Ideal.span {b} := by
  obtain ⟨U, hU, hxU, a, ha, hDa⟩ :=
    exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor D hD x
  obtain ⟨V, hV, hxV, b, hb, hDb⟩ :=
    exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor D' hD' x
  obtain ⟨a₀, b₀, hab, hxW⟩ := exists_basicOpen_le_affine_inter hU hV x ⟨hxU, hxV⟩
  set W : X.affineOpens := X.affineBasicOpen (U := ⟨U, hU⟩) a₀ with hW
  have hWU : W ≤ (⟨U, hU⟩ : X.affineOpens) := X.affineBasicOpen_le (V := ⟨U, hU⟩) a₀
  have hWV : W ≤ (⟨V, hV⟩ : X.affineOpens) :=
    hab.trans_le (X.affineBasicOpen_le (V := ⟨V, hV⟩) b₀)
  refine ⟨W.1, W.2, hxW, (X.presheaf.map (homOfLE hWU).op).hom a,
    (X.presheaf.map (homOfLE hWV).op).hom b, isRegular_res_of_isAffineOpen hU ha hWU,
    isRegular_res_of_isAffineOpen hV hb hWV, ideal_eq_span_res hWU hDa,
    ideal_eq_span_res hWV hDb⟩

/-- Dividing by a principal ideal with nonzerodivisor generator: if `a` is a nonzerodivisor,
then `((a * c) : (a)) = (c)`. -/
theorem colon_span_singleton_of_isRegular {A : Type u} [CommRing A] {a c : A} (ha : IsRegular a) :
    (Ideal.span {a * c}).colon ((Ideal.span {a} : Ideal A) : Set A) = Ideal.span {c} := by
  refine le_antisymm (fun d hd => ?_) ?_
  · obtain ⟨e, he⟩ := Ideal.mem_span_singleton.mp
      ((Submodule.mem_colon.mp hd) a (Ideal.mem_span_singleton_self a))
    refine Ideal.mem_span_singleton.mpr ⟨e, ha.left ?_⟩
    calc a * d = d • a := by rw [smul_eq_mul, mul_comm]
      _ = a * c * e := he
      _ = a * (c * e) := by ring
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    refine Submodule.mem_colon.mpr fun s hs => ?_
    obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton.mp hs
    exact Ideal.mem_span_singleton.mpr ⟨t, by rw [smul_eq_mul]; ring⟩

/-- Let `D` and `D'` be effective Cartier divisors on a scheme `X` with `D ⊆ D'` as closed
subschemes, that is, with `ℐ_{D'} ⊆ ℐ_D`.  Then there is an effective Cartier divisor `E` with
`D' = D + E`, in the ideal-sheaf presentation `ℐ_{D'} = ℐ_D · ℐ_E`.

The divisor `E` is the quotient of ideal sheaves `ℐ_{D'} : ℐ_D`. -/
@[stacks 02ON]
theorem exists_isEffectiveCartierDivisor_mul_eq_of_le (D D' : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) (hD' : IsEffectiveCartierDivisor D') (h : D' ≤ D) :
    ∃ E : X.IdealSheafData, IsEffectiveCartierDivisor E ∧ D' = D * E := by
  classical
  have hfg := fg_ideal_of_isEffectiveCartierDivisor D hD
  set E : X.IdealSheafData := D'.colon D hfg with hE
  have chart : ∀ x : X, ∃ (U : X.Opens) (hU : IsAffineOpen U), x ∈ U ∧ ∃ c : Γ(X, U),
      IsRegular c ∧ E.ideal ⟨U, hU⟩ = Ideal.span {c} ∧
        D'.ideal ⟨U, hU⟩ ≤ D.ideal ⟨U, hU⟩ * E.ideal ⟨U, hU⟩ := by
    intro x
    obtain ⟨U, hU, hxU, a, b, ha, hb, hDa, hDb⟩ :=
      exists_affineOpen_ideal_eq_span_pair D D' hD hD' x
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp
      (hDa.le (h ⟨U, hU⟩ (hDb.ge (Ideal.mem_span_singleton_self b))))
    have hEU : E.ideal ⟨U, hU⟩ = Ideal.span {c} := by
      rw [hE, Scheme.IdealSheafData.ideal_colon, hDa, hDb, hc]
      exact colon_span_singleton_of_isRegular ha
    refine ⟨U, hU, hxU, c, (hc ▸ hb).of_mul_right, hEU, ?_⟩
    rw [hDb, hDa, hEU, Ideal.span_singleton_mul_span_singleton, hc]
  choose U hU hxU c hc hEU hmul using chart
  refine ⟨E, ?_, le_antisymm ?_ ?_⟩
  · exact isEffectiveCartierDivisor_of_forall_exists_affineOpen E
      fun x => ⟨U x, hU x, hxU x, c x, hc x, hEU x⟩
  · refine Scheme.IdealSheafData.le_of_iSup_eq_top (fun x : X => ⟨U x, hU x⟩) ?_ hmul
    exact iSup_eq_top_of_mem hxU
  · exact Scheme.IdealSheafData.mul_colon_le D' D hfg

/-! ### Dividing an arbitrary ideal sheaf by an effective Cartier divisor -/

/-- The product of a principal ideal with the quotient of an ideal contained in it recovers that
ideal: `(b) · (I : (b)) = I` whenever `I ≤ (b)`. No regularity of `b` is needed, since every
element of `I` is `b` times an element of the colon ideal. -/
theorem _root_.Ideal.span_singleton_mul_colon_eq {A : Type u} [CommRing A] (I : Ideal A) (b : A)
    (h : I ≤ Ideal.span {b}) :
    Ideal.span {b} * I.colon ((Ideal.span {b} : Ideal A) : Set A) = I := by
  rw [Ideal.colon_span]
  refine le_antisymm (Ideal.mul_le.mpr fun a ha c hc => ?_) fun a ha => ?_
  · obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton.mp ha
    have hc' : c * b ∈ I := Submodule.mem_colon_singleton.mp hc
    simpa [mul_assoc, mul_comm, mul_left_comm] using I.mul_mem_left d hc'
  · obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp (h ha)
    exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self b)
      (Submodule.mem_colon_singleton.mpr (by simpa [smul_eq_mul, mul_comm] using ha))

/-- **An ideal sheaf inside an effective Cartier divisor is that divisor times its quotient.**
For `Z ≤ D` with `D` an effective Cartier divisor, `Z = D · (Z : D)`. Unlike Tag 02ON the
smaller ideal sheaf `Z` is arbitrary, so `Z : D` need not be an effective Cartier divisor. -/
theorem mul_colon_eq_of_isEffectiveCartierDivisor (D Z : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) (hZD : Z ≤ D) :
    D * Z.colon D (fg_ideal_of_isEffectiveCartierDivisor D hD) = Z := by
  choose U hU hxU b _ hgen using
    fun x : X => exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor D hD x
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top
    (fun x : X => (⟨U x, hU x⟩ : X.affineOpens)) ?_ fun x => ?_
  · exact iSup_eq_top_of_mem hxU
  · change D.ideal ⟨U x, hU x⟩ *
      (Z.ideal ⟨U x, hU x⟩).colon ((D.ideal ⟨U x, hU x⟩ : Ideal Γ(X, U x)) : Set Γ(X, U x)) = _
    rw [hgen x]
    exact Ideal.span_singleton_mul_colon_eq _ _ (by rw [← hgen x]; exact hZD ⟨U x, hU x⟩)

/-- **Dividing by an effective Cartier divisor.** Every ideal sheaf contained in an effective
Cartier divisor is that divisor times a second ideal sheaf. -/
theorem exists_mul_eq_of_le_of_isEffectiveCartierDivisor (D Z : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) (hZD : Z ≤ D) : ∃ K : X.IdealSheafData, Z = D * K :=
  ⟨_, (mul_colon_eq_of_isEffectiveCartierDivisor D Z hD hZD).symm⟩

end AlgebraicGeometry

end
