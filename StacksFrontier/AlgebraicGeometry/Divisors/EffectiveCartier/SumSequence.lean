/-! ### Two diagram lemmas -/

/-- **Nested kernels of compatible quotient sequences.** Given two exact sequences with the same
middle term mapping onto two quotients, a morphism of the quotients compatible with them induces
a short exact sequence of the kernels. The statement is phrased in the opposite category, so
that it is applied to quotient sequences and produces the sequence of their kernels. -/
private theorem shortExact_kernels_of_shortExact_quotients
    {C : Type*} [Category* C] [Abelian C]
    (S T R : ShortComplex C) (hS : S.Exact) (hT : T.ShortExact)
    (hR : R.Exact) [Mono S.f] [Mono R.f]
    (a : T.X₂ ≅ S.X₂) (b : T.X₃ ≅ R.X₂) (c : S.X₃ ≅ R.X₃)
    (h : T.g ≫ b.hom ≫ R.g = a.hom ≫ S.g ≫ c.hom)
    (f : T.X₁ ⟶ S.X₁) (hf : f ≫ S.f = T.f ≫ a.hom) :
    ∃ (g : S.X₁ ⟶ R.X₁) (hz : f ≫ g = 0),
      (ShortComplex.mk f g hz).ShortExact := by
  have := hT.mono_f
  have := hT.epi_g
  have hz : (S.f ≫ a.inv ≫ T.g ≫ b.hom) ≫ R.g = 0 := by
    simp only [Category.assoc, h, Iso.inv_hom_id_assoc, S.zero_assoc, zero_comp]
  let g := hR.lift (S.f ≫ a.inv ≫ T.g ≫ b.hom) hz
  have hg : g ≫ R.f = S.f ≫ a.inv ≫ T.g ≫ b.hom := hR.lift_f _ hz
  have hfg : f ≫ g = 0 := by
    apply (cancel_mono R.f).1
    simp [Category.assoc, hg, ← Category.assoc f S.f, hf, T.zero_assoc]
  have : Mono f := mono_of_mono_fac hf
  have hker : IsLimit (KernelFork.ofι f hfg) := by
    apply KernelFork.IsLimit.ofι'
    intro W k hk
    have hk' : (k ≫ S.f ≫ a.inv) ≫ T.g = 0 := by
      apply (cancel_mono b.hom).1
      simp [Category.assoc, ← hg, ← Category.assoc k g, hk]
    refine ⟨hT.exact.lift (k ≫ S.f ≫ a.inv) hk', ?_⟩
    apply (cancel_mono S.f).1
    rw [Category.assoc, hf, ← Category.assoc, hT.exact.lift_f]
    simp
  have : Epi g := by
    rw [epi_iff_surjective_up_to_refinements]
    intro W k
    obtain ⟨W', π, hπ, t, ht⟩ :=
      surjective_up_to_refinements_of_epi T.g (k ≫ R.f ≫ b.inv)
    have ht' : (t ≫ a.hom) ≫ S.g = 0 := by
      apply (cancel_mono c.hom).1
      rw [Category.assoc, Category.assoc, ← h, ← Category.assoc t T.g, ← ht]
      simp [Category.assoc]
    let l := hS.lift (t ≫ a.hom) ht'
    have hl : l ≫ S.f = t ≫ a.hom := hS.lift_f _ ht'
    refine ⟨W', π, hπ, l, ?_⟩
    apply (cancel_mono R.f).1
    rw [Category.assoc l g, hg, ← Category.assoc l S.f, hl]
    simpa [Category.assoc] using congrArg (fun z => z ≫ b.hom) ht
  exact ⟨g, hfg, ⟨ShortComplex.exact_of_f_is_kernel _ hker⟩⟩

/-- Transporting the left-hand term of a short exact sequence along an isomorphism keeps it
short exact. -/
private theorem shortExact_transportSource
    {A : Type*} [Category* A] [Abelian A]
    (S : ShortComplex A) (hS : S.ShortExact) {M : A} (e : S.X₁ ≅ M) :
    ∃ zero : (e.inv ≫ S.f) ≫ S.g = 0,
      (ShortComplex.mk (e.inv ≫ S.f) S.g zero).ShortExact := by
  have zero : (e.inv ≫ S.f) ≫ S.g = 0 := by
    rw [Category.assoc, S.zero, comp_zero]
  refine ⟨zero, ShortComplex.shortExact_of_iso
    (ShortComplex.isoMk e (Iso.refl _) (Iso.refl _) ?_ ?_) hS⟩
  · simp only [Iso.refl_hom, Category.comp_id, Iso.hom_inv_id_assoc]
  · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]

/-- **Transporting a short exact sequence along three isomorphisms.**  Given a short exact
sequence and a pair of commuting squares identifying its three terms with others, the
transported pair of arrows is again a short exact sequence. -/
private theorem shortExact_of_squares {C : Type*} [Category* C] [Abelian C]
    (T : ShortComplex C) (hT : T.ShortExact) {A B E : C} (f : A ⟶ B) (g : B ⟶ E)
    (a : T.X₁ ≅ A) (b : T.X₂ ≅ B) (d : T.X₃ ≅ E)
    (h12 : a.hom ≫ f = T.f ≫ b.hom) (h23 : b.hom ≫ g = T.g ≫ d.hom) :
    ∃ zero : f ≫ g = 0, (ShortComplex.mk f g zero).ShortExact := by
  have hz : f ≫ g = 0 := by
    rw [← cancel_epi a.hom, ← Category.assoc, h12, Category.assoc, h23, ← Category.assoc,
      T.zero, zero_comp, comp_zero]
  exact ⟨hz, ShortComplex.shortExact_of_iso (ShortComplex.isoMk a b d h12 h23) hT⟩

/-- **Nested kernels of compatible quotient sequences, in the original category.**  Given three
short exact sequences, isomorphisms identifying the middle terms of the first two and the
kernels with the terms of the third, and a morphism of the right-hand terms compatible with the
quotient maps, the kernels fit into a short exact sequence. -/
private theorem shortExact_kernels_of_quotients {𝒜 : Type*} [Category* 𝒜] [Abelian 𝒜]
    (S T R : ShortComplex 𝒜) (hS : S.ShortExact) (hT : T.ShortExact) (hR : R.ShortExact)
    (ea : S.X₂ ≅ T.X₂) (eb : R.X₂ ≅ T.X₁) (ec : R.X₁ ≅ S.X₁)
    (ρ : S.X₃ ⟶ T.X₃) (hρ : S.g ≫ ρ = ea.hom ≫ T.g)
    (hdiag : R.f ≫ eb.hom ≫ T.f = ec.hom ≫ S.f ≫ ea.hom) :
    ∃ (φ : R.X₃ ⟶ S.X₃) (hz : φ ≫ ρ = 0), (ShortComplex.mk φ ρ hz).ShortExact := by
  have hmS : Mono S.op.f :=
    have := hS.epi_g
    inferInstanceAs (Mono S.g.op)
  have hmR : Mono R.op.f :=
    have := hR.epi_g
    inferInstanceAs (Mono R.g.op)
  have hdiag' : T.op.g ≫ eb.op.hom ≫ R.op.g = ea.op.hom ≫ S.op.g ≫ ec.op.hom :=
    Quiver.Hom.unop_inj (by
      change (R.f ≫ eb.hom) ≫ T.f = (ec.hom ≫ S.f) ≫ ea.hom
      rw [Category.assoc, Category.assoc]
      exact hdiag)
  have hρ' : ρ.op ≫ S.op.f = T.op.f ≫ ea.op.hom :=
    Quiver.Hom.unop_inj hρ
  obtain ⟨g, hz, hse⟩ := shortExact_kernels_of_shortExact_quotients S.op T.op R.op
    hS.exact.op hT.op hR.exact.op ea.op eb.op ec.op hdiag' ρ.op hρ'
  exact ⟨g.unop, (ShortComplex.mk ρ.op g hz).unop.zero, hse.unop⟩

/-! ### Restriction between nested closed subschemes -/

private lemma unitToPushforward_app_apply {X Z : Scheme.{u}} (r : X ⟶ Z) (U : Z.Opens)
    (a : Γ(Z, U)) :
    Scheme.Modules.Hom.app (M := SheafOfModules.unit Z.ringCatSheaf)
      (N := (Scheme.Modules.pushforward r).obj (SheafOfModules.unit X.ringCatSheaf))
      (SheafOfModules.unitToPushforwardObjUnit r.toRingCatSheafHom) U a = r.app U a := rfl

/-- **Restriction between nested closed subschemes is compatible with the quotient maps out of
the ambient structure sheaf.** For `D' ≤ D`, the canonical map `𝒪_X ⟶ 𝒪_{D'}` followed by the
restriction `𝒪_{D'} ⟶ 𝒪_D` is the canonical map `𝒪_X ⟶ 𝒪_D`. -/
private lemma ambientToClosedSubscheme_comp_restriction {X : Scheme.{u}}
    {D' D : X.IdealSheafData} (h : D' ≤ D) :
    Scheme.IdealSheafData.ambientToClosedSubscheme D' ≫
        Scheme.IdealSheafData.closedSubschemeRestriction h =
      Scheme.IdealSheafData.ambientToClosedSubscheme D := by
  apply Scheme.Modules.hom_ext
  intro U
  ext a
  rw [Scheme.IdealSheafData.closedSubschemeRestriction]
  refine Eq.trans (Scheme.IdealSheafData.comp_app_apply _ _ U a) ?_
  refine Eq.trans (Scheme.IdealSheafData.comp_app_apply _ _ U _) ?_
  refine Eq.trans (Scheme.IdealSheafData.comp_app_apply _ _ U _) ?_
  refine Scheme.IdealSheafData.eqToHom_app_heq _ U _ _ ?_
  refine HEq.trans (heq_of_eq ?_)
    (Scheme.IdealSheafData.heq_scheme_app (Scheme.IdealSheafData.inclusion_subschemeι h) U a)
  refine Eq.trans (Scheme.IdealSheafData.pushforwardComp_app_apply _ _ _ U _) ?_
  refine Eq.trans (Scheme.IdealSheafData.pushforward_map_app_apply _ _ U _) ?_
  refine Eq.trans (unitToPushforward_app_apply (Scheme.IdealSheafData.inclusion h)
    (D'.subschemeι ⁻¹ᵁ U) _) ?_
  refine Eq.trans (congrArg (fun y => (Scheme.IdealSheafData.inclusion h).app
    (D'.subschemeι ⁻¹ᵁ U) y) (unitToPushforward_app_apply D'.subschemeι U a)) ?_
  exact (ConcreteCategory.comp_apply (D'.subschemeι.app U)
      ((Scheme.IdealSheafData.inclusion h).app (D'.subschemeι ⁻¹ᵁ U)) a).symm.trans
    (ConcreteCategory.congr_hom (Scheme.Hom.comp_app
      (Scheme.IdealSheafData.inclusion h) D'.subschemeι U) a).symm

/-- The same compatibility, with the quotient maps written as in `Stacks.IdealSheafSequence`:
`𝒪_X ⟶ i_* 𝒪_D` is the same morphism in both spellings. -/
private lemma divisorQuotientMap_comp_restriction {X : Scheme.{u}}
    {D' D : X.IdealSheafData} (h : D' ≤ D) :
    Stacks.IdealSheafSequence.divisorQuotientMap D' ≫
        Scheme.IdealSheafData.closedSubschemeRestriction h =
      Stacks.IdealSheafSequence.divisorQuotientMap D :=
  ambientToClosedSubscheme_comp_restriction h

/-! ### The product of two ideal sheaves is their tensor product -/

section IdealTensor

open Stacks.SheafOfModules.TensorStalkRingedSpace
open scoped TensorProduct

variable {X : Scheme.{u}}

/-- A morphism of presheaves of modules into a sheaf is determined by its values on sections
over affine opens, since those form a basis of the topology. -/
theorem presheafToSheaf_hom_ext_affine
    (M : PresheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj)
    (N : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) (f g : M ⟶ N.val)
    (h : ∀ U : X.affineOpens, f.app (op U.val) = g.app (op U.val)) : f = g := by
  apply (PresheafOfModules.toPresheaf
    (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj).map_injective
  apply TopCat.Sheaf.hom_ext M.presheaf
    ((SheafOfModules.toSheaf (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).obj N)
    (B := fun U : X.affineOpens => U.val)
  · simpa using X.isBasis_affineOpens
  · intro U
    exact congrArg (fun q => (forget₂ (ModuleCat _) AddCommGrpCat).map q) (h U)

/-- A morphism out of a tensor product of sheaves of modules is determined by its values on
pure tensors of sections over affine opens. -/
theorem tensorSheaf_hom_ext_affine
    {A B C : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)}
    {f g : (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).obj (A)).obj
      (B)) ⟶ C}
    (h : ∀ (U : X.affineOpens) (a : A.val.obj (op U.val)) (b : B.val.obj (op U.val)),
      (f.val.app (op U.val)).hom
          (toTensorSheafSection X.toRingedSpace A B (op U.val) (a ⊗ₜ b)) =
        (g.val.app (op U.val)).hom
          (toTensorSheafSection X.toRingedSpace A B (op U.val) (a ⊗ₜ b))) :
    f = g := by
  apply ((PresheafOfModules.sheafificationAdjunction
    (R := Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)
    (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj)).homEquiv
      (PresheafOfModules.tensorObj (O := X.sheaf.obj) A.val B.val) C).injective
  apply presheafToSheaf_hom_ext_affine
  intro U
  exact ModuleCat.tensor_ext (h U)

/-- The left unit constraint `𝒪_X ⊗ F ≅ F` of the tensor product of sheaves of modules on a
scheme: the sheafified left unitor of the presheaf tensor product. -/
noncomputable def tensorUnitIso
    (F : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) :
    (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).obj
      ((SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)))).obj (F)) ≅
        F := by
  letI : MonoidalCategory (PresheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj) :=
    Stacks.SheafOfModules.Tensor.ringSheafPresheafMonoidalCategory X.sheaf
  change (PresheafOfModules.sheafification.{u}
    (R := Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)
    (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj)).obj
    ((SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).val ⊗ F.val) ≅ F
  letI : IsIso (PresheafOfModules.sheafificationAdjunction
      (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj)).counit := by infer_instance
  exact (PresheafOfModules.sheafification.{u}
    (R := Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)
    (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj)).mapIso
      (MonoidalCategoryStruct.leftUnitor
        (self := (Stacks.SheafOfModules.Tensor.ringSheafPresheafMonoidalCategory
          X.sheaf).toMonoidalCategoryStruct) F.val) ≪≫
    (asIso (PresheafOfModules.sheafificationAdjunction
      (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj)).counit).app F

/-- The left unit constraint on a local pure tensor: a section of the structure sheaf acts on
the second factor as a scalar. -/
lemma tensorUnitIso_hom_app_tmul
    (F : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
    (U : X.Opens) (r : (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj.obj (op U))
    (m : F.val.obj (op U)) :
    ((tensorUnitIso F).hom.val.app (op U)).hom
        (toTensorSheafSection X.toRingedSpace
          (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) F
          (op U) (r ⊗ₜ m)) = r • m := by
  let : MonoidalCategory (PresheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj) :=
    Stacks.SheafOfModules.Tensor.ringSheafPresheafMonoidalCategory X.sheaf
  let a := PresheafOfModules.sheafificationAdjunction
    (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj)
  have h : a.homEquiv _ _ (tensorUnitIso F).hom = (λ_ F.val).hom := by
    change a.homEquiv _ _ ((PresheafOfModules.sheafification
      (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj)).map (λ_ F.val).hom ≫
        a.counit.app F) = _
    exact (a.homEquiv _ _).apply_symm_apply (λ_ F.val).hom
  exact congrArg (fun q => (q.app (op U)).hom (r ⊗ₜ m)) h

/-- The tensor product of the ideal sheaves of two closed subschemes. -/
noncomputable abbrev idealTensorProd (I J : X.IdealSheafData) :
    SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)) :=
  (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).obj
    ((idealSheafOfModules I))).obj ((idealSheafOfModules J)))

/-- The tensor product of the structure sheaf with the ideal sheaf of a closed subscheme. -/
noncomputable abbrev unitTensorIdeal (J : X.IdealSheafData) :
    SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)) :=
  (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).obj
    ((SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf))))).obj
      ((idealSheafOfModules J)))

/-- The left unit constraint at the ideal sheaf of a closed subscheme, `𝒪_X ⊗ ℐ_J ≅ ℐ_J`. -/
noncomputable def idealUnitIso (J : X.IdealSheafData) :
    unitTensorIdeal J ≅ idealSheafOfModules J :=
  tensorUnitIso (idealSheafOfModules J)

/-- The inclusion `ℐ_I ⟶ 𝒪_X` of the first ideal sheaf, tensored with the second. -/
noncomputable abbrev idealTensorInclusion (I J : X.IdealSheafData) :
    idealTensorProd I J ⟶ unitTensorIdeal J :=
  ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).map (idealInclusion I)).app
    (idealSheafOfModules J)

/-- The inclusion of the first ideal sheaf, tensored with the second, is the image of that
inclusion under the functor `- ⊗ ℐ_J`. -/
lemma idealTensorInclusion_eq (I J : X.IdealSheafData) :
    idealTensorInclusion I J =
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj
        (idealSheafOfModules J)).map (idealInclusion I) := rfl

/-- **Multiplication of the sections of two ideal sheaves**, as a morphism
`ℐ_I ⊗ ℐ_J ⟶ 𝒪_X`: the inclusion of the first factor into the structure sheaf, the left unit
constraint, and the inclusion of the second factor. -/
noncomputable abbrev idealTensorToUnit (I J : X.IdealSheafData) :
    idealTensorProd I J ⟶
      SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)) :=
  idealTensorInclusion I J ≫ (idealUnitIso J).hom ≫ idealInclusion J

/-- On a local pure tensor, `idealTensorToUnit` is the product of the two sections of the
structure sheaf that the factors represent. -/
lemma idealTensorToUnit_app_tmul (I J : X.IdealSheafData) (U : X.Opens)
    (y : (idealSheafOfModules I).val.obj (op U))
    (m : (idealSheafOfModules J).val.obj (op U)) :
    ((idealTensorToUnit I J).val.app (op U)).hom
        (toTensorSheafSection X.toRingedSpace (idealSheafOfModules I) (idealSheafOfModules J)
          (op U) (y ⊗ₜ m)) =
      idealSheafSection I y * idealSheafSection J m := by
  have hinclusion : idealTensorInclusion I J =
      (Functor.uncurry.obj
        (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf)).map
          ((idealInclusion I, 𝟙 (idealSheafOfModules J)) : (_, _) ⟶ (_, _)) :=
    (Stacks.SheafOfModules.Tensor.sheafTensor_map_app X.sheaf
      (idealInclusion I) (idealSheafOfModules J)).trans
        (Stacks.SheafOfModules.Tensor.sheafTensor_uncurry_map X.sheaf
          (idealInclusion I) (𝟙 (idealSheafOfModules J))).symm
  refine Eq.trans ?_ (idealSheafSection_smulSectionMap J m (idealSheafSection I y))
  refine congrArg ((idealInclusion J).val.app (op U)).hom ?_
  refine Eq.trans (congrArg ((idealUnitIso J).hom.val.app (op U)).hom
      ((congrArg (fun morphism : idealTensorProd I J ⟶ unitTensorIdeal J =>
        (morphism.val.app (op U)).hom (toTensorSheafSection X.toRingedSpace
          (idealSheafOfModules I) (idealSheafOfModules J) (op U) (y ⊗ₜ m)))
        hinclusion).trans
          (tensorSheafMap_app_toTensorSheafSection X.toRingedSpace
            (idealSheafOfModules I) (idealSheafOfModules J)
            (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
            (idealSheafOfModules J) (idealInclusion I)
            (𝟙 (idealSheafOfModules J)) U y m))) ?_
  exact tensorUnitIso_hom_app_tmul (idealSheafOfModules J) U
    (((idealInclusion I).val.app (op U)).hom y) m

/-- A morphism of sheaves of modules which is surjective on sections over every affine open is
an epimorphism, since the affine opens form a basis of the topology. -/
theorem epi_of_surjective_affine
    {M N : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)} (f : M ⟶ N)
    (hf : ∀ U : X.affineOpens, Function.Surjective (f.val.app (op U.val)).hom) : Epi f := by
  constructor
  intro P g h hgh
  apply SheafOfModules.hom_ext
  apply presheafToSheaf_hom_ext_affine N.val P g.val h.val
  intro U
  ext x
  obtain ⟨y, rfl⟩ := hf U x
  exact congrArg (fun t => (t.val.app (op U.val)).hom y) hgh

/-- Multiplication of sections of two ideal sheaves lands in the ideal sheaf of the product of
the two closed subschemes: over an affine open the product of the two ideals is cut out by the
product closed subscheme. -/
lemma idealTensorToUnit_comp_divisorQuotientMap (I J : X.IdealSheafData) :
    idealTensorToUnit I J ≫ Stacks.IdealSheafSequence.divisorQuotientMap (I * J) =
      (SheafOfModules.fullyFaithfulForget
        (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).preimage 0 := by
  apply tensorSheaf_hom_ext_affine
  intro U y m
  have hmem : idealSheafSection I y * idealSheafSection J m ∈ (I * J).ideal U :=
    Ideal.mul_mem_mul ((mem_ideal_iff_exists_idealSheafSection I U _).2 ⟨y, rfl⟩)
      ((mem_ideal_iff_exists_idealSheafSection J U _).2 ⟨m, rfl⟩)
  rw [← (I * J).ker_subschemeι_app U] at hmem
  have hzero : (I * J).subschemeι.app (U : X.Opens)
      (idealSheafSection I y * idealSheafSection J m) = 0 := hmem
  refine ((congrArg (fun r => ((Stacks.IdealSheafSequence.divisorQuotientMap (I * J)).val.app
      (op (U : X.Opens))).hom r) (idealTensorToUnit_app_tmul I J (U : X.Opens) y m)).trans
    hzero).trans ?_
  let : Module ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj.obj
      (op (U : X.Opens)))
      (((modulePushforward (I * J).subschemeι.toLRSHom.toShHom).obj
        (SheafOfModules.unit (structureSheafRing (I * J).subscheme.toRingedSpace))).val.obj
          (op (U : X.Opens))) :=
    (((modulePushforward (I * J).subschemeι.toLRSHom.toShHom).obj
      (SheafOfModules.unit (structureSheafRing (I * J).subscheme.toRingedSpace))).val.obj
        (op (U : X.Opens))).isModule
  simp only [SheafOfModules.fullyFaithfulForget, PresheafOfModules.zero_app]
  exact (LinearMap.congr_fun
    (ModuleCat.hom_zero (R := (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj.obj
      (op (U : X.Opens)))
      (M := (idealTensorProd I J).val.obj (op (U : X.Opens)))
      (N := ((modulePushforward (I * J).subschemeι.toLRSHom.toShHom).obj
        (SheafOfModules.unit (structureSheafRing (I * J).subscheme.toRingedSpace))).val.obj
          (op (U : X.Opens)))) _).symm

/-- **The tensor product of two ideal sheaves maps onto the ideal sheaf of the sum.** The
multiplication `ℐ_I ⊗ ℐ_J ⟶ 𝒪_X` factors through the ideal sheaf of the closed subscheme cut
out by the product `I * J`, which is the kernel of `𝒪_X ⟶ 𝒪_{I * J}`. -/
noncomputable abbrev idealTensorMul (I J : X.IdealSheafData) :
    idealTensorProd I J ⟶ idealSheafOfModules (I * J) :=
  kernel.lift (C := SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
    _ (idealTensorToUnit I J) (idealTensorToUnit_comp_divisorQuotientMap I J)

/-- `idealTensorMul` followed by the inclusion of the ideal sheaf of the product into the
structure sheaf is multiplication of sections. -/
lemma idealTensorMul_comp_idealInclusion (I J : X.IdealSheafData) :
    idealTensorMul I J ≫ idealInclusion (I * J) = idealTensorToUnit I J :=
  kernel.lift_ι (C := SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) _ _ _

/-- On sections, `idealTensorMul` is multiplication, read inside the ideal sheaf of the
product. -/
lemma idealSheafSection_idealTensorMul (I J : X.IdealSheafData) (U : X.Opens)
    (t : (idealTensorProd I J).val.obj (op U)) :
    idealSheafSection (I * J) (((idealTensorMul I J).val.app (op U)).hom t) =
      ((idealTensorToUnit I J).val.app (op U)).hom t :=
  congrArg (fun q => (q.val.app (op U)).hom t) (idealTensorMul_comp_idealInclusion I J)

/-- Over an affine open, `idealTensorMul` is surjective on sections: the ideal of the product is
generated by products of sections of the two factors. -/
lemma surjective_idealTensorMul_app (I J : X.IdealSheafData) (U : X.affineOpens) :
    Function.Surjective ((idealTensorMul I J).val.app (op U.val)).hom := by
  intro x
  have key : ∀ r : Γ(X, (U : X.Opens)), r ∈ I.ideal U * J.ideal U →
      ∃ t, ((idealTensorToUnit I J).val.app (op (U : X.Opens))).hom t = r := by
    intro r hr
    refine Submodule.mul_induction_on hr ?_ ?_
    · intro a ha b hb
      obtain ⟨y, hy⟩ := (mem_ideal_iff_exists_idealSheafSection I U a).1 ha
      obtain ⟨m, hm⟩ := (mem_ideal_iff_exists_idealSheafSection J U b).1 hb
      refine ⟨toTensorSheafSection X.toRingedSpace (idealSheafOfModules I)
        (idealSheafOfModules J) (op (U : X.Opens)) (y ⊗ₜ m), ?_⟩
      rw [idealTensorToUnit_app_tmul I J (U : X.Opens) y m, hy, hm]
    · rintro p q ⟨tp, hp⟩ ⟨tq, hq⟩
      refine ⟨tp + tq, ?_⟩
      have hadd := map_add ((idealTensorToUnit I J).val.app (op (U : X.Opens))).hom tp tq
      rw [hp, hq] at hadd
      exact hadd
  obtain ⟨t, ht⟩ := key (idealSheafSection (I * J) x)
    ((mem_ideal_iff_exists_idealSheafSection (I * J) U _).2 ⟨x, rfl⟩)
  refine ⟨t, idealSheafSection_injective (I * J) ?_⟩
  rw [idealSheafSection_idealTensorMul]
  exact ht

/-- `idealTensorMul` is an epimorphism. -/
lemma epi_idealTensorMul (I J : X.IdealSheafData) : Epi (idealTensorMul I J) :=
  epi_of_surjective_affine _ (surjective_idealTensorMul_app I J)

/-- The ideal sheaf of a closed subscheme is a subsheaf of the structure sheaf. -/
lemma mono_idealInclusion (I : X.IdealSheafData) : Mono (idealInclusion I) := by
  change Mono (kernel.ι _)
  infer_instance

/-- **The tensor product of the ideal sheaves of two effective Cartier divisors is the ideal
sheaf of their sum.** The multiplication map is an epimorphism always, and a monomorphism when
the second factor is invertible, because tensoring by an invertible sheaf of modules is an
equivalence. -/
@[ega "II 8.1.1" "special case", ega "IV 21.2.8" "(21.2.8.3), special case"]
lemma isIso_idealTensorMul (I J : X.IdealSheafData)
    (hJ : IsEffectiveCartierDivisor J) : IsIso (idealTensorMul I J) := by
  let hinv : AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).property (idealSheafOfModules J) := hJ
  let : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).obj
      (idealSheafOfModules J)).IsEquivalence :=
    AlgebraicGeometry.SheafOfModules.tensorLeftFunctor_isEquivalence X.presheaf
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).property (idealSheafOfModules J)
  let : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj
      (idealSheafOfModules J)).IsEquivalence :=
    Functor.isEquivalence_of_iso
      (F := (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).obj
        (idealSheafOfModules J))
      (Stacks.Cohomology.AmpleH1.tensorLeftIsoRight X _)
  let : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj
      (idealSheafOfModules J)).PreservesMonomorphisms := inferInstance
  let hmI : Mono (C := SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) (idealInclusion I) :=
    mono_idealInclusion I
  let hmJ : Mono (C := SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) (idealInclusion J) :=
    mono_idealInclusion J
  let hmT : Mono (C := SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) (idealTensorInclusion I J) := by
    change Mono (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj
      (idealSheafOfModules J)).map (idealInclusion I))
    exact Functor.map_mono
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj
        (idealSheafOfModules J)) (idealInclusion I)
  let : IsIso (C := SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) (idealUnitIso J).hom :=
    (idealUnitIso J).isIso_hom
  let hmU : Mono (C := SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
      ((idealUnitIso J).hom ≫ idealInclusion J) :=
    mono_comp' (IsIso.mono_of_iso (idealUnitIso J).hom) hmJ
  let hmTU : Mono (C := SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) (idealTensorToUnit I J) :=
    mono_comp' hmT hmU
  let hmK : Mono (idealTensorMul I J ≫ idealInclusion (I * J)) := by
    rw [idealTensorMul_comp_idealInclusion]
    exact hmTU
  let : Mono (idealTensorMul I J) := mono_of_mono _ (idealInclusion (I * J))
  let := epi_idealTensorMul I J
  exact isIso_of_mono_of_epi _

/-- The tensor product of the ideal sheaves of two effective Cartier divisors, as an
isomorphism onto the ideal sheaf of their sum. -/
noncomputable def idealTensorMulIso (I J : X.IdealSheafData)
    (hJ : IsEffectiveCartierDivisor J) :
    idealTensorProd I J ≅ idealSheafOfModules (I * J) :=
  have := isIso_idealTensorMul I J hJ
  asIso (idealTensorMul I J)

end IdealTensor



/-! ### The ideal sheaf sequence twisted by an invertible sheaf -/

section TwistedSequence

open Stacks.SheafOfModules.TensorStalkRingedSpace
open Stacks.AffineProjectionFormula
open scoped CategoryTheory.Prod

variable {X : Scheme.{u}}

/-- The inverse image functor along the inclusion of a closed subscheme is final on opens, so
the pullback of sheaves of modules along it is available. -/
private instance final_opensMap_subschemeι (C : X.IdealSheafData) :
    (TopologicalSpace.Opens.map C.subschemeι.toLRSHom.toShHom.hom.base).Final :=
  CategoryTheory.final_of_representablyFlat _

/-- Tensoring by an invertible sheaf of modules preserves zero morphisms: it is an equivalence,
hence preserves the terminal object, hence the zero object. -/
private instance preservesZeroMorphisms_tensorRight (X : Scheme.{u})
    (L : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)))
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).property L] :
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj
      L).PreservesZeroMorphisms :=
  letI : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).obj L).IsEquivalence :=
    AlgebraicGeometry.SheafOfModules.tensorLeftFunctor_isEquivalence X.presheaf
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).property L
  have : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj
      L).IsEquivalence :=
    Functor.isEquivalence_of_iso
      (F := (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).obj L)
      (Stacks.Cohomology.AmpleH1.tensorLeftIsoRight X L)
  have : PreservesLimit
      (Functor.empty.{0}
        (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf))))
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L) :=
    inferInstance
  Functor.preservesZeroMorphisms_of_map_zero_object
    (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L).mapIso
        HasZeroObject.zeroIsoTerminal ≪≫
      PreservesTerminal.iso
        ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L) ≪≫
      HasZeroObject.zeroIsoTerminal.symm)

/-- The unit of `i^* ⊣ i_*` at the structure sheaf: the map `𝒪_X ⟶ i_* i^* 𝒪_X` for `i` the
inclusion of the closed subscheme cut out by `C`. -/
private noncomputable abbrev unitAtStructureSheaf (C : X.IdealSheafData) :
    SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)) ⟶
      (modulePullback C.subschemeι.toLRSHom.toShHom ⋙
        modulePushforward C.subschemeι.toLRSHom.toShHom).obj
          (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf))) :=
  (modulePullbackPushforwardAdjunction C.subschemeι.toLRSHom.toShHom).unit.app
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)))

/-- `i_* i^* 𝒪_X ≅ i_* 𝒪_C`, from the canonical isomorphism `i^* 𝒪_X ≅ 𝒪_C`. -/
private noncomputable def pushforwardPullbackUnitIso (C : X.IdealSheafData) :=
  (modulePushforward C.subschemeι.toLRSHom.toShHom).mapIso
    (asIso (SheafOfModules.pullbackObjUnitToUnit
      (structureSheafHom C.subschemeι.toLRSHom.toShHom)))

/-- The unit at the structure sheaf, followed by `i_* i^* 𝒪_X ≅ i_* 𝒪_C`, is the structure
comorphism `𝒪_X ⟶ i_* 𝒪_C`. -/
private lemma unitAtStructureSheaf_comp :
    ∀ C : X.IdealSheafData, unitAtStructureSheaf C ≫ (pushforwardPullbackUnitIso C).hom =
      Stacks.IdealSheafSequence.divisorQuotientMap C :=
  fun C => Stacks.Cohomology.AmpleH1.unit_app_unit_comp C.subschemeι

/-- **The ideal sheaf of a closed subscheme is the kernel of `𝒪_X ⟶ i_* i^* 𝒪_X`.** -/
private noncomputable def unitKernelIso (C : X.IdealSheafData) :
    kernel (unitAtStructureSheaf C) ≅ idealSheafOfModules C :=
  kernel.mapIso (unitAtStructureSheaf C) (Stacks.IdealSheafSequence.divisorQuotientMap C)
    (Iso.refl _) (pushforwardPullbackUnitIso C)
    ((unitAtStructureSheaf_comp C).trans
      (Category.id_comp (Stacks.IdealSheafSequence.divisorQuotientMap C)).symm)

/-- `unitKernelIso` is compatible with the two inclusions into the structure sheaf. -/
private lemma unitKernelIso_hom_comp (C : X.IdealSheafData) :
    (unitKernelIso C).hom ≫ idealInclusion C = kernel.ι (unitAtStructureSheaf C) := by
  simp only [unitKernelIso, kernel.mapIso, kernel.map]
  exact kernel.lift_ι _ _ _

/-- **The sequence `0 ⟶ ℐ_C ⟶ 𝒪_X ⟶ i_* i^* 𝒪_X ⟶ 0`** of a closed subscheme. -/
private lemma shortExact_unitAtStructureSheaf (C : X.IdealSheafData) :
    (ShortComplex.mk (C := SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
      (kernel.ι (unitAtStructureSheaf C)) (unitAtStructureSheaf C)
      (kernel.condition _)).ShortExact := by
  refine ShortComplex.shortExact_of_iso
    (C := SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
    (ShortComplex.isoMk
      (C := SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
      (S₁ := ShortComplex.mk (C := SheafOfModules.{u}
        (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
        (kernel.ι (unitAtStructureSheaf C)) (unitAtStructureSheaf C)
        (kernel.condition _))
      (S₂ := ShortComplex.mk (C := SheafOfModules.{u}
        (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
        (kernel.ι (C := SheafOfModules.{u}
          (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
          (Stacks.IdealSheafSequence.divisorQuotientMap C))
        (Stacks.IdealSheafSequence.divisorQuotientMap C)
        (kernel.condition (C := SheafOfModules.{u}
          (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) _))
      (unitKernelIso C) (Iso.refl _) (pushforwardPullbackUnitIso C) ?_ ?_).symm
    (Stacks.Cohomology.AmpleH1.shortExact_idealSheaf C.subschemeι)
  · exact (unitKernelIso_hom_comp C).trans (Category.comp_id _).symm
  · exact (Category.id_comp _).trans (unitAtStructureSheaf_comp C).symm

/-- The ideal sequence of a closed subscheme, tensored on the right by an invertible sheaf. -/
private noncomputable abbrev unitTensorComplex (C : X.IdealSheafData)
    (L : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)))
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).property L] :
    ShortComplex (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf))) :=
  (ShortComplex.mk (C := SheafOfModules.{u}
    (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
    (kernel.ι (unitAtStructureSheaf C)) (unitAtStructureSheaf C)
      (kernel.condition _)).map
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L)

/-- Tensoring the sequence by an invertible sheaf keeps it short exact. -/
private lemma shortExact_unitAtStructureSheaf_tensor (C : X.IdealSheafData)
    (L : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)))
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).property L] :
    (unitTensorComplex C L).ShortExact := by
  let : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).obj L).IsEquivalence :=
    AlgebraicGeometry.SheafOfModules.tensorLeftFunctor_isEquivalence X.presheaf
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).property L
  let : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj
      L).IsEquivalence :=
    Functor.isEquivalence_of_iso
      (F := (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).obj L)
      (Stacks.Cohomology.AmpleH1.tensorLeftIsoRight X L)
  exact (shortExact_unitAtStructureSheaf C).map_of_exact
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L)

/-- The pullback-tensor comparison of [Stacks, Tag 01CD] at `(𝒪_X, ℒ)`, composed with the
left unit constraint: `i^*(𝒪_X ⊗ ℒ) ≅ i^* ℒ`. -/
private noncomputable def pullbackUnitTensorIso (C : X.IdealSheafData)
    (L : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf))) :=
  (asIso ((Stacks.RingedSpace.comparisonNatTrans C.subschemeι.toLRSHom.toShHom).app
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)), L))).symm ≪≫
    (modulePullback C.subschemeι.toLRSHom.toShHom).mapIso (tensorUnitIso L)

/-- The comparison morphism followed by `pullbackUnitTensorIso` is the pullback of the left
unit constraint. -/
private lemma comparison_comp_pullbackUnitTensorIso (C : X.IdealSheafData)
    (L : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf))) :
    (Stacks.RingedSpace.comparisonNatTrans C.subschemeι.toLRSHom.toShHom).app
        (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)), L) ≫
      (pullbackUnitTensorIso C L).hom =
    (modulePullback C.subschemeι.toLRSHom.toShHom).map (tensorUnitIso L).hom := by
  rw [pullbackUnitTensorIso]
  exact IsIso.hom_inv_id_assoc _ _

/-- **The projection formula identification `(i_* i^* 𝒪_X) ⊗ ℒ ≅ i_* i^* ℒ`.**  It is the
projection formula of [Stacks, Tag 0FZE] for the closed immersion `i`, followed by the
pullback-tensor comparison of [Stacks, Tag 01CD]. -/
private noncomputable def projectionIso (C : X.IdealSheafData)
    (L : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf))) :=
  closedImmersionProjectionFormulaIso C.subschemeι
      ((modulePullback C.subschemeι.toLRSHom.toShHom).obj
        (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)))) L ≪≫
    (modulePushforward C.subschemeι.toLRSHom.toShHom).mapIso (pullbackUnitTensorIso C L)

/-- The adjoint transpose of the pullback-tensor comparison followed by the left unit
constraint is the left unit constraint followed by the unit of `i^* ⊣ i_*`. -/
private lemma homEquiv_comparison_comp (C : X.IdealSheafData)
    (L : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf))) :
    (modulePullbackPushforwardAdjunction C.subschemeι.toLRSHom.toShHom).homEquiv _ _
        ((Stacks.RingedSpace.comparisonNatTrans C.subschemeι.toLRSHom.toShHom).app
            (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)), L) ≫
          (pullbackUnitTensorIso C L).hom) =
      (tensorUnitIso L).hom ≫
        (modulePullbackPushforwardAdjunction C.subschemeι.toLRSHom.toShHom).unit.app L :=
  (congrArg ((modulePullbackPushforwardAdjunction C.subschemeι.toLRSHom.toShHom).homEquiv _ _)
      (comparison_comp_pullbackUnitTensorIso C L)).trans
    ((Adjunction.homEquiv_unit _ _ _ _).trans
      ((modulePullbackPushforwardAdjunction
        C.subschemeι.toLRSHom.toShHom).unit.naturality (tensorUnitIso L).hom).symm)

/-- The middle square of the comparison: the left unit constraint followed by the unit of
`i^* ⊣ i_*` is the tensored unit followed by the projection-formula isomorphism. -/
private lemma projectionIso_square (C : X.IdealSheafData)
    (L : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf))) :
    (tensorUnitIso L).hom ≫
        (modulePullbackPushforwardAdjunction C.subschemeι.toLRSHom.toShHom).unit.app L =
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L).map
        (unitAtStructureSheaf C) ≫ (projectionIso C L).hom := by
  have hmap : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L).map
      (unitAtStructureSheaf C) =
      (Functor.uncurry.obj (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        X.sheaf)).map ((unitAtStructureSheaf C, 𝟙 L) : (_, _) ⟶ (_, _)) :=
    (Stacks.SheafOfModules.Tensor.sheafTensor_map_app X.sheaf
      (unitAtStructureSheaf C) L).trans
        (Stacks.SheafOfModules.Tensor.sheafTensor_uncurry_map X.sheaf
          (unitAtStructureSheaf C) (𝟙 L)).symm
  rw [hmap]
  have hnat := closedImmersionProjectionFormulaIso_hom_natural_unit C.subschemeι
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf))) L
  refine Eq.symm (((Category.assoc _ _ _).symm.trans
    ((congrArg (fun z => z ≫ (modulePushforward C.subschemeι.toLRSHom.toShHom).map
        (pullbackUnitTensorIso C L).hom) hnat).trans
      (Adjunction.homEquiv_naturality_right _ _ _).symm)).trans
    (homEquiv_comparison_comp C L))

/-- The left square of the comparison. -/
private lemma projectionIso_square_left (C : X.IdealSheafData)
    (L : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf))) :
    (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L).mapIso
          (unitKernelIso C)).hom ≫
        ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L).map
            (idealInclusion C) ≫
          (tensorUnitIso L).hom =
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L).map
        (kernel.ι (unitAtStructureSheaf C)) ≫ (tensorUnitIso L).hom :=
  (Category.assoc _ _ _).symm.trans
    ((congrArg (fun morphism => morphism ≫ (tensorUnitIso L).hom)
      (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L).map_comp
        (unitKernelIso C).hom (idealInclusion C)).symm).trans
      (congrArg (fun morphism =>
        ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L).map
          morphism ≫ (tensorUnitIso L).hom) (unitKernelIso_hom_comp C)))

/-- **The sequence `0 ⟶ ℐ_C ⊗ ℒ ⟶ ℒ ⟶ i_*i^*ℒ ⟶ 0`** for a closed subscheme `C ⊆ X` with
inclusion `i` and an invertible sheaf `ℒ` on `X`.  It is the ideal sheaf sequence of `C`
tensored by `ℒ`, with the right-hand term identified by the projection formula of
[Stacks, Tag 0FZE] for a closed immersion.

This is the twisting-down step of [Stacks, Tag 0B8Z] and the left-hand term of
[Stacks, Tag 0C4T]; the two are the same sequence, the latter at `ℒ = ℐ_D`. -/
public lemma exists_shortExact_invertibleTwist (C : X.IdealSheafData)
    (L : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)))
    (hL : AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).property L) :
    ∃ zero : (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L).map
          (idealInclusion C) ≫
        (tensorUnitIso L).hom) ≫
        (modulePullbackPushforwardAdjunction C.subschemeι.toLRSHom.toShHom).unit.app L =
          (SheafOfModules.fullyFaithfulForget
            (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).preimage 0,
      (ShortComplex.mk
        (C := SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
        (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L).map
            (idealInclusion C) ≫
          (tensorUnitIso L).hom)
        ((modulePullbackPushforwardAdjunction C.subschemeι.toLRSHom.toShHom).unit.app L)
        zero).ShortExact := by
  let := hL
  let tensorSequence := unitTensorComplex C L
  let firstMap :=
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L).map
      (idealInclusion C) ≫ (tensorUnitIso L).hom
  let quotientMap :=
    (modulePullbackPushforwardAdjunction C.subschemeι.toLRSHom.toShHom).unit.app L
  let firstIso :=
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj L).mapIso
      (unitKernelIso C)
  have leftSquare : firstIso.hom ≫ firstMap = tensorSequence.f ≫ (tensorUnitIso L).hom :=
    projectionIso_square_left C L
  have rightSquare : (tensorUnitIso L).hom ≫ quotientMap =
      tensorSequence.g ≫ (projectionIso C L).hom := projectionIso_square C L
  let : Epi firstIso.hom := IsIso.epi_of_iso firstIso.hom
  have zero : firstMap ≫ quotientMap =
      (SheafOfModules.fullyFaithfulForget
        (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).preimage 0 := by
    apply (cancel_epi firstIso.hom).1
    calc
      firstIso.hom ≫ (firstMap ≫ quotientMap) =
          (firstIso.hom ≫ firstMap) ≫ quotientMap := (Category.assoc _ _ _).symm
      _ = (tensorSequence.f ≫ (tensorUnitIso L).hom) ≫ quotientMap :=
        congrArg (fun morphism => morphism ≫ quotientMap) leftSquare
      _ = tensorSequence.f ≫ ((tensorUnitIso L).hom ≫ quotientMap) := Category.assoc _ _ _
      _ = tensorSequence.f ≫ (tensorSequence.g ≫ (projectionIso C L).hom) :=
        congrArg (fun morphism => tensorSequence.f ≫ morphism) rightSquare
      _ = (tensorSequence.f ≫ tensorSequence.g) ≫ (projectionIso C L).hom :=
        (Category.assoc _ _ _).symm
      _ = _ := congrArg (fun morphism => morphism ≫ (projectionIso C L).hom) tensorSequence.zero
      _ = _ := zero_comp (C := SheafOfModules.{u}
        (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} X.sheaf))
      _ = _ := (comp_zero (C := SheafOfModules.{u}
        (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} X.sheaf))).symm
  refine ⟨zero, ?_⟩
  exact ShortComplex.shortExact_of_iso
    (C := SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
    (ShortComplex.isoMk (S₁ := tensorSequence)
      firstIso (tensorUnitIso L) (projectionIso C L) leftSquare rightSquare)
    (shortExact_unitAtStructureSheaf_tensor C L)

/-- **The sequence `0 ⟶ ℐ_C ⊗ ℐ_D ⟶ ℐ_D ⟶ i_*i^*ℐ_D ⟶ 0`** for a closed subscheme `C ⊆ X` with
inclusion `i` and an effective Cartier divisor `D`: `exists_shortExact_invertibleTwist` at
`ℒ = ℐ_D`. -/
private lemma exists_shortExact_idealTensor (C D : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) :
    ∃ zero : (idealTensorInclusion C D ≫ (idealUnitIso D).hom) ≫
        (modulePullbackPushforwardAdjunction C.subschemeι.toLRSHom.toShHom).unit.app
          (idealSheafOfModules D) =
          (SheafOfModules.fullyFaithfulForget
            (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).preimage 0,
      (ShortComplex.mk
        (C := SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
        (idealTensorInclusion C D ≫ (idealUnitIso D).hom)
        ((modulePullbackPushforwardAdjunction C.subschemeι.toLRSHom.toShHom).unit.app
          (idealSheafOfModules D)) zero).ShortExact :=
  exists_shortExact_invertibleTwist C (idealSheafOfModules D) hD

/-- The multiplication `ℐ_C ⊗ ℐ_D ⟶ ℐ_D` lands in the kernel of `ℐ_D ⟶ i_* i^* ℐ_D`. -/
private lemma idealTensor_comp_unit_eq_zero (C D : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) :
    (idealTensorInclusion C D ≫ (idealUnitIso D).hom) ≫
      (modulePullbackPushforwardAdjunction C.subschemeι.toLRSHom.toShHom).unit.app
        (idealSheafOfModules D) =
        (SheafOfModules.fullyFaithfulForget
          (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).preimage 0 :=
  (exists_shortExact_idealTensor C D hD).elim fun hz _ => hz

/-- The sequence `0 ⟶ ℐ_C ⊗ ℐ_D ⟶ ℐ_D ⟶ i_*i^*ℐ_D ⟶ 0`, as a short complex. -/
private noncomputable abbrev idealTensorComplex (C D : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) :
    ShortComplex (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf))) :=
  ShortComplex.mk
    (C := SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
    (idealTensorInclusion C D ≫ (idealUnitIso D).hom)
    ((modulePullbackPushforwardAdjunction C.subschemeι.toLRSHom.toShHom).unit.app
      (idealSheafOfModules D)) (idealTensor_comp_unit_eq_zero C D hD)

/-- That sequence is short exact. -/
private lemma shortExact_idealTensorComplex (C D : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) : (idealTensorComplex C D hD).ShortExact :=
  (exists_shortExact_idealTensor C D hD).elim fun _ h => h

end TwistedSequence


/-! ### Tag 0C4T -/

section SumSequence

open Stacks.SheafOfModules.TensorStalkRingedSpace

variable {X : Scheme.{u}}

/-- The restriction `𝒪_X(-D)|_C` of the ideal sheaf of `D` to the closed subscheme `C`, pushed
forward to `X`. -/
private noncomputable abbrev restrictedNegativeTwist (C D : X.IdealSheafData) : X.Modules :=
  (modulePushforward C.subschemeι.toLRSHom.toShHom).obj
    ((modulePullback C.subschemeι.toLRSHom.toShHom).obj (idealSheafOfModules D))

/-- The sequence `0 ⟶ ℐ_I ⟶ 𝒪_X ⟶ i_* 𝒪_I ⟶ 0` of a closed subscheme, as a short complex. -/
private noncomputable abbrev idealQuotientComplex (I : X.IdealSheafData) :
    ShortComplex (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf))) :=
  ShortComplex.mk (C := SheafOfModules.{u}
    (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
    (Stacks.IdealSheafSequence.divisorIdealMap I)
    (Stacks.IdealSheafSequence.divisorQuotientMap I)
    (kernel.condition (C := SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) _)

/-- A short complex of `𝒪_X`-modules, read in `AlgebraicGeometry.Scheme.Modules`.  The two
categories are the same — `Stacks.SchemeCohomology.ringSheaf_ringedSpace` — but a short complex
over the unwrapped category carries `SheafOfModules.instPreadditive` while one over the wrapper
carries the `Preadditive` instance of its `Abelian` structure, and that is the instance the
diagram lemma below uses.  Discharging the comparison once here keeps it out of every statement
that mentions a short complex. -/
private noncomputable abbrev toSchemeComplex
    (S : ShortComplex (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)))) :
    ShortComplex X.Modules := S

/-- Short exactness does not depend on which of the two readings is used. -/
private lemma shortExact_toSchemeComplex
    {S : ShortComplex (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (X).sheaf)))}
    (h : S.ShortExact) :
    (toSchemeComplex S).ShortExact := h

/-- The canonical restriction `𝒪_{D'} ⟶ 𝒪_D` between nested closed subschemes, typed as a
morphism between the right-hand terms of the two quotient sequences. -/
private noncomputable def quotientRestriction {I J : X.IdealSheafData} (h : I ≤ J) :
    (toSchemeComplex (idealQuotientComplex I)).X₃ ⟶
      (toSchemeComplex (idealQuotientComplex J)).X₃ :=
  Scheme.IdealSheafData.closedSubschemeRestriction h

/-- The quotient maps out of the structure sheaf are compatible with the restriction. -/
private lemma quotientComplex_g_comp_restriction {I J : X.IdealSheafData} (h : I ≤ J) :
    (toSchemeComplex (idealQuotientComplex I)).g ≫ quotientRestriction h =
      (toSchemeComplex (idealQuotientComplex J)).g :=
  divisorQuotientMap_comp_restriction h

/-- **Stacks Tag 0C6K.** The sequence of `idealQuotientComplex` is short exact. -/
@[sga "6 X 5.2.2" "more general"]
private lemma shortExact_idealQuotientComplex (I : X.IdealSheafData) :
    (idealQuotientComplex I).ShortExact :=
  Stacks.Cohomology.AmpleH1.shortExact_idealSheaf I.subschemeι

/-- The right-hand square of the diagram: multiplication of ideal sheaves identifies
`ℐ_C ⊗ ℐ_D` with `ℐ_{C + D}` compatibly with the two inclusions into `𝒪_X`. -/
private lemma idealTensorComplex_diagram (C D : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) :
    (toSchemeComplex (idealTensorComplex C D hD)).f ≫
        (Iso.refl (toSchemeComplex (idealTensorComplex C D hD)).X₂).hom ≫
          (toSchemeComplex (idealQuotientComplex D)).f =
      (idealTensorMulIso C D hD).hom ≫ (toSchemeComplex (idealQuotientComplex (C * D))).f ≫
        (Iso.refl (toSchemeComplex (idealQuotientComplex (C * D))).X₂).hom := by
  refine Eq.trans ?_ (idealTensorMul_comp_idealInclusion C D).symm
  exact Category.assoc _ _ _

/-- The left-hand square of the diagram: the restriction is compatible with the quotient
maps. -/
private lemma quotientRestriction_diagram {I J : X.IdealSheafData} (h : I ≤ J) :
    (toSchemeComplex (idealQuotientComplex I)).g ≫ quotientRestriction h =
      (Iso.refl (toSchemeComplex (idealQuotientComplex I)).X₂).hom ≫
        (toSchemeComplex (idealQuotientComplex J)).g :=
  (quotientComplex_g_comp_restriction h).trans (Category.id_comp _).symm

/-- **Tag 0C4T with the sum written out.**  For `C` and `D` closed subschemes of `X` with `D` an
effective Cartier divisor, the structure sheaf of the sum `C + D` is an extension of the
structure sheaf of `D` by `𝒪_X(-D)|_C`. -/
private lemma addEffectiveCartierDivisor_shortExact_aux (D C : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) (hsub : C * D ≤ D)
    (hleft : (toSchemeComplex (idealQuotientComplex (C * D))).g ≫ quotientRestriction hsub =
      (Iso.refl (toSchemeComplex (idealQuotientComplex (C * D))).X₂).hom ≫
        (toSchemeComplex (idealQuotientComplex D)).g)
    (hright : (toSchemeComplex (idealTensorComplex C D hD)).f ≫
          (Iso.refl (toSchemeComplex (idealTensorComplex C D hD)).X₂).hom ≫
            (toSchemeComplex (idealQuotientComplex D)).f =
        (idealTensorMulIso C D hD).hom ≫ (toSchemeComplex (idealQuotientComplex (C * D))).f ≫
          (Iso.refl (toSchemeComplex (idealQuotientComplex (C * D))).X₂).hom) :
    ∃ f : (toSchemeComplex (idealTensorComplex C D hD)).X₃ ⟶
        (toSchemeComplex (idealQuotientComplex (C * D))).X₃,
      ∃ zero : f ≫ quotientRestriction hsub = 0,
        (ShortComplex.mk f (quotientRestriction hsub) zero).ShortExact :=
  shortExact_kernels_of_quotients (𝒜 := X.Modules)
    (toSchemeComplex (idealQuotientComplex (C * D)))
    (toSchemeComplex (idealQuotientComplex D))
    (toSchemeComplex (idealTensorComplex C D hD))
    (shortExact_toSchemeComplex (shortExact_idealQuotientComplex (C * D)))
    (shortExact_toSchemeComplex (shortExact_idealQuotientComplex D))
    (shortExact_toSchemeComplex (shortExact_idealTensorComplex C D hD))
    (Iso.refl _) (Iso.refl _) (idealTensorMulIso C D hD) (quotientRestriction hsub) hleft hright

/-- **Tag 0C4T with the sum written out**, with the left-hand square supplied. -/
private lemma exists_shortExact_sum_of_right (D C : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) (hsub : C * D ≤ D)
    (hright : (toSchemeComplex (idealTensorComplex C D hD)).f ≫
          (Iso.refl (toSchemeComplex (idealTensorComplex C D hD)).X₂).hom ≫
            (toSchemeComplex (idealQuotientComplex D)).f =
        (idealTensorMulIso C D hD).hom ≫ (toSchemeComplex (idealQuotientComplex (C * D))).f ≫
          (Iso.refl (toSchemeComplex (idealQuotientComplex (C * D))).X₂).hom) :
    ∃ f : (toSchemeComplex (idealTensorComplex C D hD)).X₃ ⟶
        (toSchemeComplex (idealQuotientComplex (C * D))).X₃,
      ∃ zero : f ≫ quotientRestriction hsub = 0,
        (ShortComplex.mk f (quotientRestriction hsub) zero).ShortExact :=
  addEffectiveCartierDivisor_shortExact_aux D C hD hsub
    (quotientRestriction_diagram hsub) hright

/-- **Tag 0C4T with the sum written out**, with both commuting squares supplied. -/
@[sga "7 X 1.13" "more general"]
private lemma exists_shortExact_sum (D C : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) (hsub : C * D ≤ D) :
    ∃ f : (toSchemeComplex (idealTensorComplex C D hD)).X₃ ⟶
        (toSchemeComplex (idealQuotientComplex (C * D))).X₃,
      ∃ zero : f ≫ quotientRestriction hsub = 0,
        (ShortComplex.mk f (quotientRestriction hsub) zero).ShortExact :=
  exists_shortExact_sum_of_right D C hD hsub (idealTensorComplex_diagram C D hD)

/-- **The sequence of [Stacks, Tag 0C4T] for an arbitrary complement.**  Only the invertibility
of `ℐ_D` is used, so the sequence exists for every sheaf of ideals `C`: for `D` an effective
Cartier divisor and `C` any sheaf of ideals with `C · D ⊆ D` there is a short exact sequence
`0 ⟶ 𝒪_X(-D)|_C ⟶ 𝒪_{C · D} ⟶ 𝒪_D ⟶ 0` of `𝒪_X`-modules.

`Stacks.Divisors.addEffectiveCartierDivisor_shortExact` is this statement phrased with the
source's sum `D' = D * C`. -/
theorem exists_shortExact_mul (D C : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) (hsub : C * D ≤ D) :
    ∃ f : (Scheme.Modules.pushforward C.subschemeι).obj
          ((Scheme.Modules.pullback C.subschemeι).obj (negativeTwist D)) ⟶
        Scheme.IdealSheafData.closedSubschemeStructureSheaf (C * D),
      ∃ zero : f ≫ Scheme.IdealSheafData.closedSubschemeRestriction hsub = 0,
        (ShortComplex.mk f (Scheme.IdealSheafData.closedSubschemeRestriction hsub)
          zero).ShortExact := by
  rw [← Stacks.SchemeCohomology.modulePushforward_hom C.subschemeι,
    AlgebraicGeometry.pullback_scheme_eq C.subschemeι]
  exact exists_shortExact_sum D C hD hsub

/-- **Stacks Project, Tag 0C4T.**  Let `D ⊆ D'` be effective Cartier divisors on a scheme `X`
and let `C` be an effective Cartier divisor with `D' = D + C`, which exists by
[Stacks, Tag 02ON].  Then there is a short exact sequence
`0 ⟶ 𝒪_X(-D)|_C ⟶ 𝒪_{D'} ⟶ 𝒪_D ⟶ 0` of `𝒪_X`-modules. -/
@[stacks 0C4T]
theorem addEffectiveCartierDivisor_shortExact (D D' C : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) (hsub : D' ≤ D) (hsum : D' = D * C) :
    ∃ f : (Scheme.Modules.pushforward C.subschemeι).obj
          ((Scheme.Modules.pullback C.subschemeι).obj (negativeTwist D)) ⟶
        Scheme.IdealSheafData.closedSubschemeStructureSheaf D',
      ∃ zero : f ≫ Scheme.IdealSheafData.closedSubschemeRestriction hsub = 0,
        (ShortComplex.mk f (Scheme.IdealSheafData.closedSubschemeRestriction hsub)
          zero).ShortExact := by
  have hprod : D' = C * D := hsum.trans (mul_comm D C)
  clear hsum
  subst hprod
  exact exists_shortExact_mul D C hD hsub

end SumSequence

end Stacks.Divisors


end
