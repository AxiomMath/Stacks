/-!
# A stalkwise criterion for an effective Cartier divisor

Let `X` be a locally Noetherian scheme and `D ⊆ X` a closed subscheme whose defining ideal is
generated, in the local ring at every point of `D`, by a nonzerodivisor.  Then `D` is an
effective Cartier divisor.

## Main results

* `AlgebraicGeometry.isRegular_of_isLocalization_away`: a nonzerodivisor of a local ring
  `A_𝔭`, coming from `a ∈ A` with `A` Noetherian, is already a nonzerodivisor in some
  localization `A[1/c]` with `c ∉ 𝔭`.
* `AlgebraicGeometry.isEffectiveCartierDivisor_of_stalk_regular_principal`: the criterion.

## The argument

Principality of the stalk ideals already gives local principality, by
`Stacks.Divisors.isLocallyPrincipal_of_stalk_isPrincipal`: on an affine open `U` around a point
`x` of `D` the ideal is `I(U) = (g)`.  Its germ `g_x` generates the stalk ideal, which is by
hypothesis generated by a nonzerodivisor, so `g_x` is a nonzerodivisor too (two generators of
one principal ideal divide each other).  Being a nonzerodivisor in the local ring is an open
condition on a Noetherian ring: the regular sequence `[g]` localizes from `A_𝔭` to `A[1/c]` for
some `c ∉ 𝔭`, which is `regular_sequence_localize_away_of_atPrime`.  The basic open `D(c) ⊆ U`
is then an affine neighbourhood of `x` on which the ideal is generated by the nonzerodivisor
`g|_{D(c)}`, and `Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen`
concludes.  Away from `D` the ideal is the unit ideal, generated by the nonzerodivisor `1`.

## References

* [Stacks Project, Tag 0AG8](https://stacks.math.columbia.edu/tag/0AG8)
-/

@[expose] public section

open CategoryTheory Stacks.Divisors

universe u

namespace AlgebraicGeometry

/-- **Nonzerodivisor at a prime spreads to a principal open.**  If the image of `a` in the
localization of a Noetherian ring `A` at a prime `𝔭` is a nonzerodivisor, then its image in
`A[1/c]` is a nonzerodivisor for some `c ∉ 𝔭`.

If `a ∉ 𝔭` this is immediate with `c = a`, whose image is a unit.  Otherwise `a` lies in the
maximal ideal of `A_𝔭`, so the one-term weakly regular sequence `[a]` is regular there, and
`regular_sequence_localize_away_of_atPrime` produces the required `c`. -/
theorem isRegular_of_isLocalization_away {A : Type*} [CommRing A] [IsNoetherianRing A]
    (p : Ideal A) [p.IsPrime] (a : A)
    (ha : IsRegular (algebraMap A (Localization.AtPrime p) a)) :
    ∃ c : A, c ∉ p ∧ IsRegular (algebraMap A (Localization.Away c) a) := by
  by_cases hap : a ∈ p
  swap
  · exact ⟨a, hap,
      (IsLocalization.map_units (M := Submonoid.powers a) _ ⟨a, Submonoid.mem_powers a⟩).isRegular⟩
  have hmax : algebraMap A (Localization.AtPrime p) a ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime p) := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.mem_map_of_mem _ hap
  have hweak : RingTheory.Sequence.IsWeaklyRegular (LocalizedModule p.primeCompl A)
      [algebraMap A (Localization.AtPrime p) a] := by
    rw [RingTheory.Sequence.isWeaklyRegular_cons_iff]
    exact ⟨ha.left, RingTheory.Sequence.IsWeaklyRegular.nil _ _⟩
  have hpreg : RingTheory.Sequence.IsRegular (LocalizedModule p.primeCompl A)
      [algebraMap A (Localization.AtPrime p) a] :=
    RingTheory.Sequence.IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal
      (L := LocalizedModule p.primeCompl A)
      (by rintro r hr; simp only [List.mem_singleton] at hr; exact hr ▸ hmax) hweak
  obtain ⟨c, hc, hreg⟩ := regular_sequence_localize_away_of_atPrime p [a] hpreg
  have hw : RingTheory.Sequence.IsWeaklyRegular (LocalizedModule (Submonoid.powers c) A)
      [algebraMap A (Localization.Away c) a] := by simpa using hreg.toIsWeaklyRegular
  rw [RingTheory.Sequence.isWeaklyRegular_cons_iff] at hw
  exact ⟨c, hc, ⟨hw.1, fun x y hxy => hw.1 (by simpa [mul_comm] using hxy)⟩⟩

/-- **A closed subscheme of a locally Noetherian scheme whose ideal is generated at every point
of it by a nonzerodivisor of the local ring is an effective Cartier divisor.**  This is the
clause of [Stacks, Tag 0AG8](https://stacks.math.columbia.edu/tag/0AG8) complementing
`Stacks.Divisors.isLocallyPrincipal_of_stalk_isPrincipal`, which supplies the local principality
it upgrades. -/
theorem isEffectiveCartierDivisor_of_stalk_regular_principal {X : Scheme.{u}}
    [IsLocallyNoetherian X] (I : X.IdealSheafData)
    (hI : ∀ x : X, x ∈ I.support →
      ∃ f : X.presheaf.stalk x, IsRegular f ∧ IdealSheafData.stalk I x = Ideal.span {f}) :
    IsEffectiveCartierDivisor I := by
  refine isEffectiveCartierDivisor_of_forall_exists_affineOpen I fun x => ?_
  by_cases hx : x ∈ I.supportSet
  swap
  · exact exists_affineOpen_ideal_eq_span_of_notMem_support I x hx
  have hxs : x ∈ I.support := Scheme.IdealSheafData.mem_supportSet_iff_mem_support.mp hx
  obtain ⟨U, hxU, hgen⟩ := isLocallyPrincipal_of_stalk_isPrincipal I
    (fun y hy => ⟨(hI y hy).choose, (hI y hy).choose_spec.2⟩) x
  have _ : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian U
  let _ := X.presheaf.algebra_section_stalk (⟨x, hxU⟩ : U.1)
  have _ : IsLocalization (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl (X.presheaf.stalk x) :=
    U.2.isLocalization_stalk ⟨x, hxU⟩
  obtain ⟨g, hgenU⟩ := hgen
  have hgenStalk : IdealSheafData.stalk I x =
      Ideal.span {(X.presheaf.germ U.1 x hxU).hom g} := by
    rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ I x U hxU, hgenU, Ideal.map_span]
    simp
  obtain ⟨f, hf, hIf⟩ := hI x hxs
  have hfmem : f ∈ Ideal.span {(X.presheaf.germ U.1 x hxU).hom g} := by
    rw [← hgenStalk, hIf]
    exact Ideal.subset_span (Set.mem_singleton f)
  obtain ⟨c, hcdvd⟩ := Ideal.mem_span_singleton.mp hfmem
  have hregularGerm : IsRegular ((X.presheaf.germ U.1 x hxU).hom g) := (hcdvd ▸ hf).of_mul_left
  -- transport the regularity to `Localization.AtPrime`, then spread it to a basic open
  have hregularAtPrime : IsRegular (algebraMap Γ(X, U)
      (Localization.AtPrime (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal) g) := by
    rw [← (IsLocalization.algEquiv (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl
      (Localization.AtPrime (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal)
      (X.presheaf.stalk x)).symm.commutes g]
    exact isRegular_ringEquiv _ hregularGerm
  obtain ⟨c, hc, hregularAway⟩ :=
    isRegular_of_isLocalization_away (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal g hregularAtPrime
  have hxW : x ∈ (X.affineBasicOpen (U := U) c : X.Opens) :=
    (X.mem_basicOpen' c ⟨x, hxU⟩).2 <| IsLocalization.map_units
      (M := (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl) _ ⟨c, hc⟩
  let _ : Algebra Γ(X, U) Γ(X, (X.affineBasicOpen (U := U) c : X.Opens)) :=
    (X.presheaf.map (homOfLE (X.basicOpen_le c)).op).hom.toAlgebra
  have _ : IsLocalization (.powers c) Γ(X, (X.affineBasicOpen (U := U) c : X.Opens)) :=
    U.2.isLocalization_basicOpen c
  have hcomp : (IsLocalization.algEquiv (.powers c) (Localization.Away c)
        Γ(X, (X.affineBasicOpen (U := U) c : X.Opens))).toRingHom.comp
      (algebraMap Γ(X, U) (Localization.Away c)) =
      (X.presheaf.map (homOfLE (X.basicOpen_le c)).op).hom :=
    RingHom.ext (IsLocalization.algEquiv (.powers c) (Localization.Away c)
      Γ(X, (X.affineBasicOpen (U := U) c : X.Opens))).commutes
  refine ⟨(X.affineBasicOpen (U := U) c : X.Opens), (X.affineBasicOpen (U := U) c).2, hxW,
    IsLocalization.algEquiv (.powers c) (Localization.Away c)
      Γ(X, (X.affineBasicOpen (U := U) c : X.Opens))
      (algebraMap Γ(X, U) (Localization.Away c) g),
    isRegular_ringEquiv _ hregularAway, ?_⟩
  have hideal : I.ideal (X.affineBasicOpen (U := U) c) =
      ((I.ideal U).map (algebraMap Γ(X, U) (Localization.Away c))).map
        (IsLocalization.algEquiv (.powers c) (Localization.Away c)
          Γ(X, (X.affineBasicOpen (U := U) c : X.Opens))).toRingHom := by
    rw [← I.map_ideal (X.affineBasicOpen_le (V := U) c), Ideal.map_map, hcomp]
    rfl
  rw [show I.ideal ⟨(X.affineBasicOpen (U := U) c : X.Opens),
      (X.affineBasicOpen (U := U) c).2⟩ = I.ideal (X.affineBasicOpen (U := U) c) from rfl,
    hideal, hgenU, Ideal.map_map, Ideal.map_span]
  simp

end AlgebraicGeometry

end
