module

public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartier.PrincipalOfInvertible
public import StacksFrontier.RingTheory.Ideal.LocallyPrincipalInvertible

/-!
# The global ideal of an effective Cartier divisor on an affine scheme is invertible

Let `X` be an affine scheme and `I` an ideal sheaf on `X` which is an effective Cartier divisor.
Then the ideal `I(X) ⊆ Γ(X, ⊤)` is an invertible `Γ(X, ⊤)`-module.

## Main results

* `Stacks.Divisors.invertible_ideal_top_of_isEffectiveCartierDivisor`: invertibility of the ideal
  of global sections.
* `Stacks.Divisors.invertible_of_isEffectiveCartierDivisor_ofIdealTop`: the same for the ideal
  sheaf generated by an ideal of `Γ(X, ⊤)`.

## Implementation notes

An effective Cartier divisor is generated by a nonzerodivisor on an affine open neighbourhood of
each point (`Stacks.Divisors.exists_affineOpens_ideal_eq_span_of_isEffectiveCartierDivisor`);
shrinking that neighbourhood to a standard open `D(g)` of `X` puts the generator in a localization
of `Γ(X, ⊤)` away from `g`, which is the hypothesis of
`Ideal.invertible_of_forall_isMaximal_map_eq_span_singleton`.

## References

* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
* [Stacks Project, Tag 0AFW](https://stacks.math.columbia.edu/tag/0AFW)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.Divisors

/-- **The global ideal of an effective Cartier divisor on an affine scheme is an invertible
module.** Each point has a standard open neighbourhood `D(g)` on which the ideal is generated by a
nonzerodivisor, and `Γ(X, D(g))` is the localization of `Γ(X, ⊤)` away from `g`. -/
theorem invertible_ideal_top_of_isEffectiveCartierDivisor {X : Scheme.{u}} [IsAffine X]
    (I : X.IdealSheafData) (hI : IsEffectiveCartierDivisor I) :
    Module.Invertible Γ(X, ⊤) (I.ideal ⟨⊤, isAffineOpen_top X⟩) := by
  have htop : IsAffineOpen (⊤ : X.Opens) := isAffineOpen_top X
  refine Ideal.invertible_of_forall_isMaximal_map_eq_span_singleton _ fun p hp => ?_
  obtain ⟨U, f, hxU, hIU, hfNZD⟩ :=
    exists_affineOpens_ideal_eq_span_of_isEffectiveCartierDivisor I hI
      (htop.fromSpec ⟨p, hp.isPrime⟩)
  obtain ⟨-, ⟨g, rfl⟩, hxg, hgU⟩ :=
    Opens.isBasis_iff_nbhd.mp (isBasis_basicOpen X) (U := U.1) hxU
  have hgp : g ∉ p := by
    have hmem : (⟨p, hp.isPrime⟩ : PrimeSpectrum Γ(X, ⊤)) ∈
        htop.fromSpec ⁻¹ᵁ X.basicOpen g := hxg
    rw [htop.fromSpec_preimage_basicOpen] at hmem
    exact (PrimeSpectrum.mem_basicOpen g _).mp hmem
  refine ⟨g, hgp, ?_⟩
  have hIW : I.ideal ⟨X.basicOpen g, htop.basicOpen g⟩ =
      Ideal.span {(X.presheaf.map (homOfLE hgU).op).hom f} := by
    rw [← I.map_ideal (U := ⟨X.basicOpen g, htop.basicOpen g⟩) (V := U) hgU, hIU,
      Ideal.map_span, Set.image_singleton]
    rfl
  have hIWtop : (I.ideal ⟨⊤, htop⟩).map
      (X.presheaf.map (homOfLE (le_top : X.basicOpen g ≤ ⊤)).op).hom
      = I.ideal ⟨X.basicOpen g, htop.basicOpen g⟩ :=
    I.map_ideal (U := ⟨X.basicOpen g, htop.basicOpen g⟩) (V := ⟨⊤, htop⟩)
      (le_top : X.basicOpen g ≤ ⊤)
  let _ : Algebra Γ(X, U.1) Γ(X, X.basicOpen g) :=
    (X.presheaf.map (homOfLE hgU).op).hom.toAlgebra
  have : IsLocalization.Away
      ((X.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op).hom g) Γ(X, X.basicOpen g) :=
    U.2.isLocalization_of_eq_basicOpen _ (homOfLE hgU) (by
      rw [Scheme.basicOpen_res, inf_eq_right.mpr hgU])
  have htNZD : (X.presheaf.map (homOfLE hgU).op).hom f ∈
      nonZeroDivisors Γ(X, X.basicOpen g) :=
    IsLocalization.map_nonZeroDivisors_le
      (M := Submonoid.powers ((X.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op).hom g))
      (S := Γ(X, X.basicOpen g)) ⟨f, hfNZD, rfl⟩
  exact Ideal.exists_map_localization_away_eq_span_singleton g _ htNZD (hIWtop.trans hIW)

/-- **An ideal of the global sections of an affine scheme whose ideal sheaf is an effective
Cartier divisor is an invertible module.** -/
theorem invertible_of_isEffectiveCartierDivisor_ofIdealTop {X : Scheme.{u}} [IsAffine X]
    (K : Ideal Γ(X, ⊤)) (hK : IsEffectiveCartierDivisor (Scheme.IdealSheafData.ofIdealTop K)) :
    Module.Invertible Γ(X, ⊤) K := by
  have h := invertible_ideal_top_of_isEffectiveCartierDivisor _ hK
  rwa [show (Scheme.IdealSheafData.ofIdealTop K).ideal ⟨⊤, isAffineOpen_top X⟩ = K by simp] at h

end Stacks.Divisors

end
