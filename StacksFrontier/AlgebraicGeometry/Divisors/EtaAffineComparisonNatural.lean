module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EtaSheafQuasiIso
public import StacksFrontier.AlgebraicGeometry.Divisors.EtaAffineComparison
import StacksCore.Tactic.StacksAttribute

/-!
# The affine comparison of décalages is natural in the complex

Let `X` be a ringed space, let `I ⊆ 𝒪_X` be an invertible ideal sheaf and let `V` be an open on
which `I` is generated by a section `g` with image `f ∈ 𝒪_X(V)`.  The isomorphism
`Stacks.IdealTorsion.Eta.etaSectionsIso` of [Stacks, Tag 0F8M] identifies the sections over `V`
of the sheaf-theoretic décalage `η_I F^•` with the ordinary décalage `η_f (F^•(V))`.  This file
proves that identification is natural in `F^•`: it commutes with the maps induced by a morphism
of complexes of `I`-torsion-free `𝒪_X`-modules.

## Main results

* `Stacks.IdealTorsion.Eta.etaSectionsIso_naturality`: the comparison square commutes.

## Implementation notes

Both composites become monomorphisms once followed by the inclusion of the degree-`n` décalage
term of the complex of sections into the localization of `G^n(V)` at `f`, so it is enough to
compare them there.  `etaSectionsIso_hom` reads each comparison, in that position, as the
normalized ideal-power map applied to the first projection of the defining fibre product;
`etaMap_fst` says the induced map of décalages is the twisted map on first projections; and
`idealPowerSectionsMap_natural` says the normalized ideal-power map is natural in the module.
Composing those three is the whole proof: nothing about the differentials enters, the degreewise
statement being an equality of morphisms of modules of sections.

The composition is done in `comp_eq_of_comp_squares`, a diagram lemma in an arbitrary category.
Rewriting the concrete goal directly does not work: the terms of the complexes involved are
those of a `CochainComplex.of` and the structure sheaf appears at two spellings, so the goal is
type-correct only at `default` transparency and `rw` and `simp` both refuse it — the same
obstacle the proof of `Stacks.IdealTorsion.Eta.etaSectionsIso` itself runs into.  Applying a
lemma whose statement is pure category theory puts all of the unification into `exact`, which
does work at that transparency.

No `@[stacks]` attribute is attached.  The source states the comparison of Tag 0F8M at a single
complex and says nothing about its naturality; what is below is a property of the construction,
needed by the derived form of the comparison, and not a clause of that tag.

## References

* [Stacks Project, Tag 0F8M](https://stacks.math.columbia.edu/tag/0F8M)
* [Stacks Project, Tag 0GT2](https://stacks.math.columbia.edu/tag/0GT2)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open Stacks.IdealTorsion (GeneratesIdealOn IsIdealTorsionFree)

universe v u

namespace Stacks.IdealTorsion.Eta

/-- **A diagram lemma.**  Suppose `A ≫ pG = pF ≫ q`, that `eG` and `eF` become `pG ≫ aG` and
`pF ≫ aF` after the monomorphisms `vG` and `vF`, that `q ≫ aG = aF ≫ w`, and that `m` becomes
`vF ≫ w` after `vG`.  Then `A ≫ eG = eF ≫ m`.

This is the combinatorial core of `etaSectionsIso_naturality`, stated in an arbitrary category
so that the composition of the five squares is carried out where no term needs unfolding. -/
private lemma comp_eq_of_comp_squares {C : Type u} [Category.{v} C]
    {W₁ W₂ O₁ O₂ Q₁ Q₂ L₁ L₂ : C} (A : W₁ ⟶ W₂) (eF : W₁ ⟶ O₁) (eG : W₂ ⟶ O₂) (m : O₁ ⟶ O₂)
    (vF : O₁ ⟶ L₁) (vG : O₂ ⟶ L₂) (pF : W₁ ⟶ Q₁) (pG : W₂ ⟶ Q₂) (q : Q₁ ⟶ Q₂)
    (aF : Q₁ ⟶ L₁) (aG : Q₂ ⟶ L₂) (w : L₁ ⟶ L₂) (hvG : Mono vG)
    (hA : A ≫ pG = pF ≫ q) (heF : eF ≫ vF = pF ≫ aF) (heG : eG ≫ vG = pG ≫ aG)
    (hq : q ≫ aG = aF ≫ w) (hm : m ≫ vG = vF ≫ w) : A ≫ eG = eF ≫ m := by
  refine hvG.right_cancellation _ _ ?_
  rw [Category.assoc, heG, ← Category.assoc, hA, Category.assoc, hq, ← Category.assoc, ← heF,
    Category.assoc, ← hm, ← Category.assoc]

variable (X : RingedSpace.{u, u})

local notation "Oₓ" => (Stacks.SheafOfModules.Tensor.ringSheaf
  (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))
local notation "𝒪" => SheafOfModules.unit Oₓ

/-- **The affine comparison of décalages is natural in the complex.**  For a morphism
`a : F^• ⟶ G^•` of complexes of `I`-torsion-free `𝒪_X`-modules, the identification of the
sections over `V` of `η_I F^•` with `η_f (F^•(V))` commutes with the maps induced by `a`. -/
theorem etaSectionsIso_naturality (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    {F G : CochainComplex (SheafOfModules.{u} Oₓ) ℤ} (a : F ⟶ G)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (hG : ∀ n : ℤ, IsIdealTorsionFree X ι (G.X n))
    (V : Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g) :
    ((sectionsFunctor X V).mapHomologicalComplex (ComplexShape.up ℤ)).map
          (etaMap X I ι a hF hG) ≫ (etaSectionsIso X I ι G hG V g hg).hom =
      (etaSectionsIso X I ι F hF V g hg).hom ≫
        EtaComplex.etaMap (generatorSection X ι V g)
          (((sectionsFunctor X V).mapHomologicalComplex (ComplexShape.up ℤ)).map a) := by
  apply HomologicalComplex.hom_ext
  intro n
  have hmono : Mono (ModuleCat.ofHom (Submodule.subtype
      (EtaComplex.term (generatorSection X ι V g) (sectionsComplex X G V) n))) :=
    (ModuleCat.mono_iff_injective _).mpr Subtype.val_injective
  have hA : (sectionsFunctor X V).map ((etaMap X I ι a hF hG).f n) ≫
        (sectionsFunctor X V).map (etaFst X I ι G n) =
      (sectionsFunctor X V).map (etaFst X I ι F n) ≫
        (sectionsFunctor X V).map (idealPowerMap X I n (a.f n)) :=
    ((sectionsFunctor X V).map_comp ((etaMap X I ι a hF hG).f n)
        (etaFst X I ι G n)).symm.trans
      ((congrArg (sectionsFunctor X V).map (etaMap_fst X I ι a hF hG n)).trans
        ((sectionsFunctor X V).map_comp (etaFst X I ι F n)
          (idealPowerMap X I n (a.f n))))
  have hm : (EtaComplex.etaMap (generatorSection X ι V g)
          (((sectionsFunctor X V).mapHomologicalComplex (ComplexShape.up ℤ)).map a)).f n ≫
        ModuleCat.ofHom (Submodule.subtype
          (EtaComplex.term (generatorSection X ι V g) (sectionsComplex X G V) n)) =
      ModuleCat.ofHom (Submodule.subtype
          (EtaComplex.term (generatorSection X ι V g) (sectionsComplex X F V) n)) ≫
        ModuleCat.ofHom (EtaPow.fLoc (generatorSection X ι V g)
          ((sectionsFunctor X V).map (a.f n)).hom) := by
    ext x
    rfl
  have hq : (sectionsFunctor X V).map (idealPowerMap X I n (a.f n)) ≫
        idealPowerSectionsHom X I ι (G.X n) V g hg n =
      idealPowerSectionsHom X I ι (F.X n) V g hg n ≫
        ModuleCat.ofHom (EtaPow.fLoc (generatorSection X ι V g)
          ((sectionsFunctor X V).map (a.f n)).hom) := by
    ext z
    exact (idealPowerSectionsMap_natural X I ι (a.f n) V g hg n z).symm
  exact comp_eq_of_comp_squares _ _ _ _ _ _ _ _ _ _ _ _ hmono hA
    (etaSectionsIso_hom X I ι F hF V g hg n) (etaSectionsIso_hom X I ι G hG V g hg n) hq hm

end Stacks.IdealTorsion.Eta

end
