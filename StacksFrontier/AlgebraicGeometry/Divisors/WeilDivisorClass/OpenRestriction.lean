module

public import StacksFrontier.AlgebraicGeometry.Divisors.WeilDivisorClass.ClassGroup
public import StacksFrontier.AlgebraicGeometry.Chow.RationalFunctions.OpenImmersion
public import StacksFrontier.AlgebraicGeometry.Divisors.PrimeDivisorStalk

/-!
# Restricting Weil divisors to an open subscheme

Let `j : X ⟶ Y` be an open immersion of Noetherian integral schemes. A prime divisor of `X` is
determined by its generic point, a point of coheight one, and `j` preserves coheight, so `j`
carries the prime divisors of `X` injectively to those of `Y`; its image consists of the prime
divisors meeting the image of `j`. Restricting the coefficients of a Weil divisor gives a
homomorphism `Div(Y) ⟶ Div(X)`, which is onto (extend by zero) and carries `div_Y(f)` to the
divisor of the restriction of `f`, since orders of vanishing are computed in local rings. So it
descends to a surjection `Cl(Y) ↠ Cl(X)`, whose kernel is generated by the classes of the prime
divisors of `Y` not meeting `X`.

This is the exact sequence `⊕_{Z ∩ X = ∅} 𝐙[Z] ⟶ Cl(Y) ⟶ Cl(X) ⟶ 0` (compare
[Stacks, Tag 0BE9] and the proof of [Stacks, Tag 03RR], where it is used as
`Pic(X) = Pic(X̄)/R` for a curve `X ⊂ X̄`).

## Main definitions

* `AlgebraicGeometry.OpenWeilRestriction.primeDivisorMap`: the prime divisors of `X` as prime
  divisors of `Y`.
* `AlgebraicGeometry.OpenWeilRestriction.restrictWeil`: `Div(Y) ⟶ Div(X)`.
* `AlgebraicGeometry.OpenWeilRestriction.restrictClass`: `Cl(Y) ⟶ Cl(X)`.
* `AlgebraicGeometry.OpenWeilRestriction.primeWeil`: the Weil divisor `1 · [Z]`.

## Main results

* `AlgebraicGeometry.OpenWeilRestriction.surjective_restrictClass`.
* `AlgebraicGeometry.OpenWeilRestriction.ker_restrictClass`: the kernel is generated by the
  classes of the prime divisors outside `X`.
-/

@[expose] public noncomputable section

open Order

universe u

namespace AlgebraicGeometry.OpenWeilRestriction

variable {X Y : Scheme.{u}} (j : X ⟶ Y) [IsOpenImmersion j]

/-- The prime divisor of `Y` whose generic point is the image of the generic point of `W`. -/
def primeDivisorMap (W : PrimeDivisor X) : PrimeDivisor Y :=
  PrimeDivisor.ofCoheightOne (j.base W.genericPoint)
    ((coheight_eq_of_isOpenImmersion j).trans W.coheight_genericPoint)

/-- The generic point of `primeDivisorMap j W` is the image under `j` of the generic point of
`W`. -/
@[simp] theorem genericPoint_primeDivisorMap (W : PrimeDivisor X) :
    (primeDivisorMap j W).genericPoint = j.base W.genericPoint :=
  PrimeDivisor.genericPoint_ofCoheightOne _ _

/-- Distinct prime divisors of `X` map to distinct prime divisors of `Y`. -/
theorem primeDivisorMap_injective : Function.Injective (primeDivisorMap j) := fun W W' h =>
  PrimeDivisor.genericPoint_injective (j.isOpenEmbedding.injective (by
    rw [← genericPoint_primeDivisorMap, ← genericPoint_primeDivisorMap, h]))

/-- A prime divisor of `Y` comes from `X` if and only if its generic point lies in the image
of `j`. -/
theorem mem_range_primeDivisorMap_iff (Z : PrimeDivisor Y) :
    Z ∈ Set.range (primeDivisorMap j) ↔ Z.genericPoint ∈ Set.range j.base := by
  constructor
  · rintro ⟨W, rfl⟩
    exact ⟨_, (genericPoint_primeDivisorMap j W).symm⟩
  · rintro ⟨x, hx⟩
    have hc : coheight x = 1 := by
      rw [← coheight_eq_of_isOpenImmersion j, hx]
      exact Z.coheight_genericPoint
    refine ⟨PrimeDivisor.ofCoheightOne x hc, PrimeDivisor.genericPoint_injective ?_⟩
    rw [genericPoint_primeDivisorMap, PrimeDivisor.genericPoint_ofCoheightOne, hx]

/-- The Weil divisor `1 · [Z]` on a Noetherian scheme. -/
def primeWeil [IsNoetherian Y] (Z : PrimeDivisor Y) : WeilDivisor Y := by
  classical
  exact ⟨Pi.single Z 1, (mem_weilDivisor_iff_finite_support _).2
    ((Set.finite_singleton Z).subset (Pi.support_single_subset))⟩

open Classical in
/-- The coefficient of `primeWeil Z` at `Z'` is `1` if `Z' = Z` and `0` otherwise. -/
theorem primeWeil_apply [IsNoetherian Y] (Z Z' : PrimeDivisor Y) :
    (primeWeil Z).1 Z' = if Z' = Z then 1 else 0 := by
  classical
  simp only [primeWeil, Pi.single_apply]

variable [IsNoetherian X] [IsNoetherian Y]

/-- **Restriction of Weil divisors** along an open immersion: the coefficient at a prime divisor
`W` of `X` is the coefficient at the prime divisor of `Y` with the same generic point. -/
def restrictWeil : WeilDivisor Y →+ WeilDivisor X where
  toFun D := ⟨fun W => D.1 (primeDivisorMap j W), by
    rw [mem_weilDivisor_iff_finite_support]
    exact ((mem_weilDivisor_iff_finite_support _).1 D.2).preimage
      (primeDivisorMap_injective j).injOn⟩
  map_zero' := rfl
  map_add' _ _ := rfl

/-- The coefficient of `restrictWeil j D` at `W` is the coefficient of `D` at
`primeDivisorMap j W`. -/
@[simp] theorem restrictWeil_apply (D : WeilDivisor Y) (W : PrimeDivisor X) :
    (restrictWeil j D).1 W = D.1 (primeDivisorMap j W) := rfl

open Classical in
/-- Extension of a Weil divisor by zero. -/
def extendWeil (D : WeilDivisor X) : WeilDivisor Y :=
  ⟨fun Z => if h : Z ∈ Set.range (primeDivisorMap j) then D.1 h.choose else 0, by
    rw [mem_weilDivisor_iff_finite_support]
    refine (((mem_weilDivisor_iff_finite_support _).1 D.2).image (primeDivisorMap j)).subset ?_
    intro Z hZ
    simp only [Function.mem_support] at hZ
    split_ifs at hZ with h
    · exact ⟨h.choose, hZ, h.choose_spec⟩
    · exact absurd rfl hZ⟩

open Classical in
/-- Restricting the extension by zero of a Weil divisor on `X` recovers it. -/
theorem restrictWeil_extendWeil (D : WeilDivisor X) : restrictWeil j (extendWeil j D) = D := by
  refine Subtype.ext (funext fun W => ?_)
  have h : primeDivisorMap j W ∈ Set.range (primeDivisorMap j) := ⟨W, rfl⟩
  change (if h : primeDivisorMap j W ∈ Set.range (primeDivisorMap j) then D.1 h.choose
    else 0) = D.1 W
  rw [dite_eq_left h, primeDivisorMap_injective j h.choose_spec]

/-- Restriction of Weil divisors along an open immersion is surjective. -/
theorem surjective_restrictWeil : Function.Surjective (restrictWeil j) := fun D =>
  ⟨extendWeil j D, restrictWeil_extendWeil j D⟩

variable [IsIntegral X] [IsIntegral Y] [IsDominant j]

/-- **Restriction carries `div_Y(f)` to the divisor of the restriction of `f`.** -/
theorem restrictWeil_principalDivisor (f : (Stacks.Chow.rationalFunctions Y)ˣ) :
    restrictWeil j (principalDivisor Y f) =
      principalDivisor X (Stacks.Chow.rationalFunctionsUnitsMulEquivOfOpenImmersion j f) := by
  refine Subtype.ext (funext fun W => ?_)
  rw [restrictWeil_apply, principalDivisor_apply, principalDivisor_apply,
    genericPoint_primeDivisorMap, Stacks.Chow.rationalFunctionsUnitsMulEquivOfOpenImmersion_coe,
    Stacks.Chow.rationalFunctionsEquivFunctionField_rationalFunctionsRingEquivOfOpenImmersion,
    Stacks.Chow.ord_functionFieldEquiv_openImmersion]

/-- **Restriction of Weil divisor classes**, `Cl(Y) ⟶ Cl(X)`. -/
def restrictClass : weilDivisorClassGroup Y →+ weilDivisorClassGroup X :=
  QuotientAddGroup.map _ _ (restrictWeil j) (by
    rintro _ ⟨f, rfl⟩
    exact ⟨_, (restrictWeil_principalDivisor j f).symm⟩)

/-- The restriction of the class of a Weil divisor `D` is the class of `restrictWeil j D`. -/
@[simp] theorem restrictClass_mk (D : WeilDivisor Y) :
    restrictClass j (D : weilDivisorClassGroup Y) = (restrictWeil j D : weilDivisorClassGroup X) :=
  rfl

/-- Restriction of Weil divisor classes `Cl(Y) ⟶ Cl(X)` along an open immersion is
surjective. -/
theorem surjective_restrictClass : Function.Surjective (restrictClass j) := by
  intro x
  obtain ⟨D, rfl⟩ := QuotientAddGroup.mk_surjective x
  exact ⟨(extendWeil j D : weilDivisorClassGroup Y), by
    rw [restrictClass_mk, restrictWeil_extendWeil]⟩

/-- **The kernel of `Cl(Y) ↠ Cl(X)` is generated by the prime divisors outside `X`.** Here
`Z : ι → PrimeDivisor Y` enumerates, without repetition, the prime divisors of `Y` not meeting
the image of `j`. -/
theorem ker_restrictClass {ι : Type*} [Finite ι] (Z : ι → PrimeDivisor Y)
    (hZinj : Function.Injective Z)
    (hZ : ∀ Z', Z' ∉ Set.range (primeDivisorMap j) ↔ Z' ∈ Set.range Z) :
    (restrictClass j).ker = AddSubgroup.closure
      (Set.range fun i => ((primeWeil (Z i) : WeilDivisor Y) : weilDivisorClassGroup Y)) := by
  classical
  have := Fintype.ofFinite ι
  apply le_antisymm
  · intro x hx
    obtain ⟨D, rfl⟩ := QuotientAddGroup.mk_surjective x
    rw [AddMonoidHom.mem_ker, restrictClass_mk, mk_eq_zero_iff] at hx
    obtain ⟨g, hg⟩ := hx
    set f := (Stacks.Chow.rationalFunctionsUnitsMulEquivOfOpenImmersion j).symm g
    have hf : restrictWeil j (principalDivisor Y f) = restrictWeil j D := by
      rw [restrictWeil_principalDivisor, MulEquiv.apply_symm_apply, hg]
    set E := D - principalDivisor Y f
    have hE0 : ∀ W, E.1 (primeDivisorMap j W) = 0 := fun W => by
      have := congrArg (fun F : WeilDivisor X => F.1 W) hf
      simp only [restrictWeil_apply] at this
      change D.1 _ - (principalDivisor Y f).1 _ = 0
      rw [this, sub_self]
    have hEsum : E = ∑ i, E.1 (Z i) • primeWeil (Z i) := by
      refine Subtype.ext (funext fun Z' => ?_)
      rw [AddSubgroup.val_finsetSum, Finset.sum_apply]
      simp only [AddSubgroup.coe_zsmul, Pi.smul_apply, primeWeil_apply, smul_eq_mul, mul_ite,
        mul_one, mul_zero]
      by_cases hZ' : Z' ∈ Set.range Z
      · obtain ⟨i₀, rfl⟩ := hZ'
        rw [Finset.sum_eq_single i₀]
        · simp
        · intro i _ hi
          rw [ite_eq_right (fun h => hi (hZinj h).symm)]
        · simp
      · have hr : Z' ∈ Set.range (primeDivisorMap j) := by
          by_contra h
          exact hZ' ((hZ Z').1 h)
        obtain ⟨W, rfl⟩ := hr
        rw [hE0 W]
        refine (Finset.sum_eq_zero fun i _ => ?_).symm
        rw [ite_eq_right]
        intro h
        exact hZ' ⟨i, h.symm⟩
    have hDE : (D : weilDivisorClassGroup Y) = (E : weilDivisorClassGroup Y) := by
      rw [QuotientAddGroup.eq]
      refine ⟨f⁻¹, ?_⟩
      rw [principalDivisor_inv]
      simp only [E]
      abel
    rw [hDE, hEsum, QuotientAddGroup.mk_sum]
    exact AddSubgroup.sum_mem _ fun i _ => by
      rw [QuotientAddGroup.mk_zsmul]
      exact AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure (Set.mem_range_self i)) _
  · rw [AddSubgroup.closure_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, AddMonoidHom.mem_ker, restrictClass_mk]
    have h0 : restrictWeil j (primeWeil (Z i)) = 0 := by
      refine Subtype.ext (funext fun W => ?_)
      rw [restrictWeil_apply, primeWeil_apply, ite_eq_right]
      · rfl
      · intro h
        exact (hZ (Z i)).2 ⟨i, rfl⟩ ⟨W, h⟩
    rw [h0, QuotientAddGroup.mk_zero]

end AlgebraicGeometry.OpenWeilRestriction

end
