module

public import StacksFrontier.AlgebraicGeometry.Divisors.DivisorPicardClass
public import StacksFrontier.AlgebraicGeometry.Divisors.WeilDivisorClass.IntegralDivisorGeneration
public import StacksFrontier.AlgebraicGeometry.NormMapInvertible.Covering
public import StacksFrontier.AlgebraicGeometry.TwistMapsInvertible.Local

/-!
# The Picard group of a scheme with trivial Picard group off an integral divisor

Let `X` be a normal locally Noetherian integral scheme and let `E ⊆ X` be an effective Cartier
divisor whose closed subscheme is integral. If the Picard group of the open complement `X ∖ E`
vanishes, then `Pic(X)` is generated by the class of `𝒪_X(E)`.

This is the generation half of the argument of [Stacks, Tag 0C5G]. An invertible module `ℒ` has
trivial restriction to `X ∖ E`, hence a trivializing section there; read as a regular meromorphic
section of `ℒ`, that section has order of vanishing zero along every prime divisor meeting
`X ∖ E`, so its Weil divisor is `n [E]` for an integer `n`. The first Chern class
([Stacks, Tag 0BE7]) therefore sends `[ℒ]` and `n • [𝒪_X(E)]` to the same class, and it is
injective because `X` is normal ([Stacks, Tag 0BE8]).

## Main results

* `AlgebraicGeometry.exists_isStalkBasis_of_subsingleton_picardGroup`: an invertible module whose
  restriction to an open subscheme with trivial Picard group has a section there which is a basis
  of the stalk at every point of that open.
* `AlgebraicGeometry.surjective_zsmul_picardClass_of_subsingleton_picardGroup_compl`:
  **generation of `Pic(X)` by the class of `𝒪_X(E)`.**

## Implementation notes

The passage from the vanishing of `Pic(X ∖ E)` to a trivializing section of `ℒ` on `X ∖ E` runs
through two bridges that the library already carries: invertibility of the restriction of an
invertible module to an open subscheme
(`Stacks.NormMapInvertible.isInvertibleModule_restrict`, Tag 0B8L) and the comparison between
triviality on the open subscheme and triviality on the slice site
(`Stacks.AlgebraicGeometry.TwistMapsInvertible.overIsoUnitOfRestrictIsoUnit`). The latter is what
makes `Stacks.Divisors.frameSections` — and hence the order-of-vanishing API of
[Stacks, Tag 02SF] — applicable.

Three defeq spellings of the structure sheaf of rings and of its sheaf condition meet here, as at
`StacksFrontier/AlgebraicGeometry/Divisors/DivisorPicardClass.lean`. The move used is the same:
every imported fact is `have`-bound at a declared type, after which the Picard-group API applies
with no rewriting. Since `Stacks.SheafOfModules.IsInvertible` is a `Prop`, the invertibility
argument of `Stacks.SheafOfModules.picardClass` never has to be compared.

## References

* [Stacks Project, Tag 0C5G](https://stacks.math.columbia.edu/tag/0C5G)
* [Stacks Project, Tag 0BE6](https://stacks.math.columbia.edu/tag/0BE6)
* [Stacks Project, Tag 0BE7](https://stacks.math.columbia.edu/tag/0BE7)
* [Stacks Project, Tag 0BE8](https://stacks.math.columbia.edu/tag/0BE8)
* [Stacks Project, Tag 0B8L](https://stacks.math.columbia.edu/tag/0B8L)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite Order TopologicalSpace
open Stacks.RingedSpace (structureIsSheaf)

universe u

namespace AlgebraicGeometry

variable {X : Scheme.{u}}

/-! ### A trivializing section on an open with trivial Picard group -/

/-- **An invertible module has a trivializing section on an open subscheme whose Picard group
vanishes.** The restriction of the module to the open subscheme is invertible
([Stacks, Tag 0B8L]), so its Picard class is the only element of a trivial group and it is
therefore isomorphic to the structure sheaf; transporting that isomorphism to the slice site
makes `Stacks.Divisors.frameSections` available, and the germ of the section it sends `1` to is a
basis of the stalk at every point. -/
theorem exists_isStalkBasis_of_subsingleton_picardGroup (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (U : X.Opens) (hU : Subsingleton (Scheme.Opens.toScheme U).picardGroup) :
    ∃ t : Γ(L, U),
      ∀ (y : X) (hy : y ∈ U), Stacks.Divisors.IsStalkBasis L y (L.presheaf.germ U y hy t) := by
  have hLinv : Stacks.Ample.IsInvertibleModule X L := ‹_›
  have hres : Stacks.Ample.IsInvertibleModule (Scheme.Opens.toScheme U) (L.restrict U.ι) :=
    Stacks.NormMapInvertible.isInvertibleModule_restrict L U
  have hres' : Stacks.SheafOfModules.IsInvertible (Scheme.Opens.toScheme U).presheaf
      (Scheme.Opens.toScheme U).ringCatIsSheaf (L.restrict U.ι) :=
    Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ hres
  obtain ⟨e0⟩ : Stacks.SheafOfModules.IsTrivial (Scheme.Opens.toScheme U).presheaf
      (Scheme.Opens.toScheme U).ringCatIsSheaf (L.restrict U.ι) :=
    (Scheme.picardClass_eq_zero_iff (Scheme.Opens.toScheme U) (L.restrict U.ι) hres').1
      (Subsingleton.elim _ _)
  let e : L.over U ≅ _root_.SheafOfModules.unit (X.ringCatSheaf.over U) :=
    Stacks.AlgebraicGeometry.TwistMapsInvertible.overIsoUnitOfRestrictIsoUnit L U e0
  exact ⟨(Stacks.Divisors.frameSections X L e).symm 1,
    fun y hy => Stacks.ChernCap42.isStalkBasis_germ_frameSections L e y hy⟩

/-! ### Generation of the Picard group -/

variable [IsIntegral X] [IsLocallyNoetherian X]

omit [IsLocallyNoetherian X] in
/-- The generic point of an integral scheme lies in the open complement of an effective Cartier
divisor. -/
theorem genericPoint_mem_compl_support (E : X.IdealSheafData)
    (hE : Stacks.Divisors.IsEffectiveCartierDivisor E) :
    genericPoint X ∈ Closeds.compl (E.support : Closeds X) :=
  genericPoint_notMem_supportSet_of_isEffectiveCartierDivisor hE

/-- The generic point of a prime divisor other than an integral effective Cartier divisor lies in
the open complement of that divisor. -/
theorem genericPoint_mem_compl_support_of_ne {E : X.IdealSheafData} [IsIntegral E.subscheme]
    (hE : Stacks.Divisors.IsEffectiveCartierDivisor E) (Z : PrimeDivisor X)
    (hZ : Z ≠ PrimeDivisor.ofEffectiveCartier E hE) :
    Z.genericPoint ∈ Closeds.compl (E.support : Closeds X) :=
  fun hmem => hZ (eq_ofEffectiveCartier_of_genericPoint_mem hE Z hmem)

/-- **Every Picard class represented by an invertible module trivial off `E` is a multiple of the
class of `𝒪_X(E)`.** This is the body of
`AlgebraicGeometry.surjective_zsmul_picardClass_of_subsingleton_picardGroup_compl`, stated at a
representing module so that the module and its invertibility are available at the spelling
`Stacks.Divisors.frameSections` and the first Chern class are written over. -/
theorem exists_zsmul_picardClass_eq_picardClass [IsNormal X] (L : X.Modules)
    (hL : Stacks.SheafOfModules.IsInvertible X.presheaf (structureIsSheaf X.toRingedSpace) L)
    (E : X.IdealSheafData) [IsIntegral E.subscheme]
    [hE : Stacks.Divisors.IsEffectiveCartierDivisor E]
    (hPic : Subsingleton
      (Scheme.Opens.toScheme (Closeds.compl (E.support : Closeds X))).picardGroup) :
    ∃ n : ℤ, n • Stacks.Divisors.picardClass E =
      Stacks.SheafOfModules.picardClass X.presheaf (structureIsSheaf X.toRingedSpace) L hL := by
  have hLinv : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj
      X.ringCatSheaf.property L := hL.toAlgebraicGeometry _ _ _
  have : L.IsQuasicoherent := isQuasicoherent_of_isInvertible L
  have hEinv : Stacks.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property
      (Stacks.Divisors.modulesInvertibleSheaf E) :=
    Stacks.Divisors.isTensorInvertible_invertibleSheaf E
  obtain ⟨t, htb⟩ := exists_isStalkBasis_of_subsingleton_picardGroup L
    (Closeds.compl (E.support : Closeds X)) hPic
  have hηU : genericPoint X ∈ Closeds.compl (E.support : Closeds X) :=
    genericPoint_mem_compl_support E hE
  have hs := isRegularMeromorphicSection_of_isStalkBasis_genericPoint L t hηU (htb _ hηU)
  -- The Weil divisor of the trivializing section is concentrated at `E`.
  have hdiv : ∀ W : PrimeDivisor X, W ≠ PrimeDivisor.ofEffectiveCartier E hE →
      (weilDivisorOfMeromorphicSection X L _ hs).val W = 0 := fun W hW =>
    orderOfVanishingMeromorphic_eq_zero_of_isStalkBasis L t htb hηU hs W
      (genericPoint_mem_compl_support_of_ne hE W hW)
  refine ⟨(weilDivisorOfMeromorphicSection X L _ hs).val
    (PrimeDivisor.ofEffectiveCartier E hE), ?_⟩
  set n : ℤ :=
    (weilDivisorOfMeromorphicSection X L _ hs).val (PrimeDivisor.ofEffectiveCartier E hE) with hn
  -- Both sides have the same first Chern class, which is injective.
  refine picardToWeilDivisorClassGroup_injective X ?_
  have h1 : weilDivisorClassOfPicardClass X (n • Stacks.Divisors.picardClass E) =
      n • weilDivisorClassOfPicardClass X (Stacks.Divisors.picardClass E) :=
    map_zsmul (picardToWeilDivisorClassGroup X) n (Stacks.Divisors.picardClass E)
  have h2 : weilDivisorClassOfPicardClass X (Stacks.Divisors.picardClass E) =
      ((PrimeDivisor.ofEffectiveCartier E hE).toWeilDivisor : weilDivisorClassGroup X) :=
    (weilDivisorClassOfPicardClass_picardClass X (Stacks.Divisors.modulesInvertibleSheaf E)).trans
      (weilDivisorClassOfInvertibleSheaf_eq_toWeilDivisor E)
  have h3 : weilDivisorClassOfPicardClass X
        (Stacks.SheafOfModules.picardClass X.presheaf (structureIsSheaf X.toRingedSpace) L hL) =
      ((weilDivisorOfMeromorphicSection X L _ hs : WeilDivisor X) :
        weilDivisorClassGroup X) :=
    (weilDivisorClassOfPicardClass_picardClass X L).trans
      (weilDivisorClassOfInvertibleSheaf_eq X L _ hs)
  change weilDivisorClassOfPicardClass X (n • Stacks.Divisors.picardClass E) =
    weilDivisorClassOfPicardClass X
      (Stacks.SheafOfModules.picardClass X.presheaf (structureIsSheaf X.toRingedSpace) L hL)
  rw [h1, h2, h3,
    eq_zsmul_toWeilDivisor_of_forall_eq_zero (weilDivisorOfMeromorphicSection X L _ hs) hdiv,
    ← hn]
  exact (map_zsmul (QuotientAddGroup.mk' (principalWeilDivisors X)) n
    (PrimeDivisor.ofEffectiveCartier E hE).toWeilDivisor).symm

/-- **Stacks Project, Tag 0C5G, the generation half.** Let `X` be a normal locally Noetherian
integral scheme and let `E ⊆ X` be an effective Cartier divisor whose closed subscheme is
integral. If the Picard group of `X ∖ E` is trivial, then every Picard class of `X` is an
integral multiple of the class of `𝒪_X(E)`.

An invertible module `ℒ` is trivial on `X ∖ E`, so it has a trivializing section `t` there; the
regular meromorphic section of `ℒ` determined by the germ of `t` at the generic point has order of
vanishing zero along every prime divisor whose generic point avoids `E`, and `E` is the only prime
divisor whose generic point meets `E`. So the Weil divisor of that section is `n [E]` for an
integer `n`, and `[E]` is the Weil divisor class of `𝒪_X(E)`. The first Chern class of
[Stacks, Tag 0BE7] therefore agrees on `[ℒ]` and on `n • [𝒪_X(E)]`, and it is injective by
[Stacks, Tag 0BE8]. -/
theorem surjective_zsmul_picardClass_of_subsingleton_picardGroup_compl [IsNormal X]
    (E : X.IdealSheafData) [IsIntegral E.subscheme]
    [hE : Stacks.Divisors.IsEffectiveCartierDivisor E]
    (hPic : Subsingleton
      (Scheme.Opens.toScheme (Closeds.compl (E.support : Closeds X))).picardGroup) :
    Function.Surjective fun n : ℤ => n • Stacks.Divisors.picardClass E := by
  intro cx
  obtain ⟨L, hL, hLc⟩ :=
    Stacks.SheafOfModules.exists_picardClass_eq X.presheaf (structureIsSheaf X.toRingedSpace) cx
  obtain ⟨n, hnn⟩ := exists_zsmul_picardClass_eq_picardClass L hL E hPic
  exact ⟨n, hnn.trans hLc⟩

end AlgebraicGeometry

end
