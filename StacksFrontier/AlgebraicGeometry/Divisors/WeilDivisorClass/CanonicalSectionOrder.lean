module

public import StacksFrontier.AlgebraicGeometry.Chow.ChernCap42.DivisorOfSectionCycle
public import StacksFrontier.AlgebraicGeometry.Chow.GysinCartierIntersection
public import StacksFrontier.AlgebraicGeometry.ComponentMultiplicity.Basic
public import StacksFrontier.AlgebraicGeometry.Divisors.CanonicalSectionNonvanishing
public import StacksFrontier.AlgebraicGeometry.Divisors.Meromorphic.DivisorClass
public import StacksFrontier.AlgebraicGeometry.Divisors.ZeroSchemeCanonicalSection
public import StacksFrontier.AlgebraicGeometry.InvertiblePullbackFlat.MeromorphicFromGenericStalk
public import StacksFrontier.AlgebraicGeometry.Variety.Curve.NonpositiveDegreeSection

/-!
# The Weil divisor class of `𝒪_X(D)` for an effective Cartier divisor `D`

Let `X` be a locally Noetherian integral scheme and `D ⊆ X` an effective Cartier divisor. The
canonical section `1_D` of `𝒪_X(D)` is regular, hence nonzero, and the meromorphic section it
determines is regular. Its order of vanishing along a prime divisor `Z` is the order of the
local equation of `D` in the local ring at the generic point of `Z`, because `Z(1_D) = D`. So the
Weil divisor class of `𝒪_X(D)` is the class of the Weil divisor whose coefficient at `Z` is the
order of a generator of the ideal `D` induces in `𝒪_{X, ξ}`.

## Main results

* `AlgebraicGeometry.canonicalSections_eval_top_ne_zero`: the canonical section of `𝒪_X(D)` is
  nonzero.
* `AlgebraicGeometry.isRegularMeromorphicSection_ofGenericStalk_germ`: the meromorphic section
  determined by the germ at the generic point of a nonzero global section of an invertible module
  is regular.
* `AlgebraicGeometry.orderOfVanishingMeromorphic_ofGenericStalk_germ`: its order of vanishing
  along a prime divisor is the order of the function representing the section under a
  trivialization near the generic point of that prime divisor.
* `AlgebraicGeometry.weilDivisorClassOfInvertibleSheaf_eq_of_forall_ord`: the Weil divisor class
  of `𝒪_X(D)`.

## Implementation notes

The meromorphic section used is `AlgebraicGeometry.meromorphicSectionOfGenericStalk` at the germ
of `1_D` at the generic point, rather than
`Stacks.ChernCap42.meromorphicSectionOfSection`: the characterization of the order of vanishing
in Tag 02SF is read through the comparison isomorphism of Tag 01X5 part (2), and
`AlgebraicGeometry.meromorphicSectionSheafIsoConstant_meromorphicSectionOfGenericStalk` computes
that comparison on the nose.

## References

* [Stacks Project, Tag 0BE9](https://stacks.math.columbia.edu/tag/0BE9)
* [Stacks Project, Tag 0BE6](https://stacks.math.columbia.edu/tag/0BE6)
* [Stacks Project, Tag 01WX](https://stacks.math.columbia.edu/tag/01WX)
* [Stacks Project, Tag 01X0](https://stacks.math.columbia.edu/tag/01X0)
* [Stacks Project, Tag 02SF](https://stacks.math.columbia.edu/tag/02SF)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite Order TopologicalSpace

universe u

namespace AlgebraicGeometry

variable {X : Scheme.{u}}

variable [IsIntegral X]

/-- A nonzero element of the local ring at the generic point of an integral scheme is a unit. -/
private theorem isUnit_of_ne_zero_stalk_genericPoint {a : X.presheaf.stalk (genericPoint X)}
    (ha : a ≠ 0) : IsUnit a := by
  have hfield : IsField ↑(X.presheaf.stalk (genericPoint X)) :=
    isField_stalk_of_isMax (fun b _ => genericPoint_specializes b)
  obtain ⟨w, hw⟩ := hfield.mul_inv_cancel ha
  exact IsUnit.of_mul_eq_one w hw

/-- The generic point of an integral scheme lies outside the support of an effective Cartier
divisor: the ideal the divisor induces in the local ring there is generated by a nonzerodivisor,
and that local ring is a field. -/
theorem genericPoint_notMem_supportSet_of_isEffectiveCartierDivisor {I : X.IdealSheafData}
    (hI : Stacks.Divisors.IsEffectiveCartierDivisor I) :
    genericPoint X ∉ I.supportSet := by
  obtain ⟨g, hg, hgnz⟩ := exists_stalk_eq_span_of_isEffectiveCartierDivisor hI (genericPoint X)
  have htop : IdealSheafData.stalk I (genericPoint X) = ⊤ := by
    rw [hg]
    exact Ideal.span_singleton_eq_top.mpr
      (isUnit_of_ne_zero_stalk_genericPoint (mem_nonZeroDivisors_iff_ne_zero.mp hgnz))
  simpa using (IdealSheafData.stalk_eq_top_iff_notMem_support I (genericPoint X)).mp htop

/-- **The canonical section of `𝒪_X(D)` is nonzero** on an integral scheme: it does not vanish at
the generic point, which lies outside `D`. -/
theorem canonicalSections_eval_top_ne_zero (I : X.IdealSheafData)
    (hI : Stacks.Divisors.IsEffectiveCartierDivisor I) :
    (Stacks.Divisors.canonicalSections I).eval (op (⊤ : X.Opens)) ≠ 0 := by
  refine eval_top_ne_zero_of_mem_nonvanishingLocus _ _ (x := genericPoint X) ?_
  rw [Stacks.Divisors.nonvanishingLocus_canonicalSections I]
  exact genericPoint_notMem_supportSet_of_isEffectiveCartierDivisor hI

/-- The germ at the generic point of a nonzero global section of an invertible module is a basis
of the generic stalk: it is a unit multiple of the germ of a local trivialization there, the unit
being invertible because the local ring at the generic point is a field. -/
theorem isStalkBasis_germ_top_genericPoint (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (t : Γ(L, (⊤ : X.Opens))) (ht : t ≠ 0) :
    Stacks.Divisors.IsStalkBasis L (genericPoint X)
      (L.presheaf.germ ⊤ (genericPoint X) trivial t) := by
  obtain ⟨U, eU, -, hηU, -⟩ :=
    Stacks.Chow.exists_affine_frame_subset X L (genericPoint X) ⊤ trivial
  have hbasis := Stacks.ChernCap42.isStalkBasis_germ_frameSections L eU (genericPoint X) hηU
  have hsmul :=
    Stacks.ChernCap42.germ_restrict_eq_smul L t hηU (Stacks.Divisors.frameSections X L eU)
  have hres : L.presheaf.germ U.1 (genericPoint X) hηU
      (L.presheaf.map (homOfLE le_top).op t) = L.presheaf.germ ⊤ (genericPoint X) trivial t :=
    L.presheaf.germ_res_apply (homOfLE (le_top (a := U.1))) (genericPoint X) hηU t
  have hne : X.presheaf.germ U.1 (genericPoint X) hηU
      (Stacks.Divisors.frameSections X L eU (L.presheaf.map (homOfLE le_top).op t)) ≠ 0 :=
    Stacks.ChernCap42.germ_frameSections_ne_zero L t ht eU (genericPoint X) hηU
  rw [← hres, hsmul]
  exact hbasis.smul_of_isUnit (isUnit_of_ne_zero_stalk_genericPoint hne)

/-- The meromorphic section determined by the germ at the generic point of a nonzero global
section of an invertible module is regular. -/
theorem isRegularMeromorphicSection_ofGenericStalk_germ (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    [L.IsQuasicoherent] (t : Γ(L, (⊤ : X.Opens))) (ht : t ≠ 0) :
    IsRegularMeromorphicSection X.sheaf L
      (meromorphicSectionOfGenericStalk X L (L.presheaf.germ ⊤ (genericPoint X) trivial t)) := by
  rw [← meromorphicSectionOfConstantGenericStalk_eq_meromorphicSectionOfGenericStalk]
  exact isRegularMeromorphicSection_meromorphicSectionOfConstantGenericStalk X L
    (isStalkBasis_germ_top_genericPoint L t ht).1

variable [IsLocallyNoetherian X]

/-- **The order of vanishing from a coordinate of the generic value.** If a meromorphic section
`s` is the one determined by `v ∈ L_η` and `a` is a coordinate of `v` at the generic point of a
prime divisor `Z`, then the order of vanishing of `s` along `Z` is the order of `a` there. This is
the characterization of Tag 02SF read through the comparison isomorphism of Tag 01X5 part (2). -/
theorem orderOfVanishingMeromorphic_eq_ord_of_isCoordinateAt (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    [L.IsQuasicoherent] (s : MeromorphicSection X.sheaf L)
    (hs : IsRegularMeromorphicSection X.sheaf L s) (Z : PrimeDivisor X)
    (v : L.presheaf.stalk (genericPoint X)) (hsv : s = meromorphicSectionOfGenericStalk X L v)
    (a : X.functionField) (hcoord : Stacks.Divisors.IsCoordinateAt L Z.genericPoint v a) :
    orderOfVanishingMeromorphic X L s hs Z = X.ord a Z.genericPoint := by
  obtain ⟨m, hmb, hv⟩ := hcoord
  refine (orderOfVanishingMeromorphicData X L s hs Z).property.2 m
    ((Stacks.Divisors.isStalkBasis_iff_span_eq_top L Z.genericPoint m).mp hmb) a ?_
  subst hsv
  exact (meromorphicSectionSheafIsoConstant_meromorphicSectionOfGenericStalk X L v).trans
    (congrArg (constantGenericStalkModuleSection X L ⊤) hv)

/-- **One rational function computes the orders of a meromorphic section near a point.** Every
point has an open neighbourhood `U` and a rational function `a` such that the order of vanishing
of `s` along every prime divisor whose generic point lies in `U` is the order of `a` at that
generic point: `a` is the coordinate of the generic value of `s` against a trivializing section
of `L` over `U`, which is a basis of the stalk of `L` at every point of `U`. -/
theorem exists_forall_orderOfVanishingMeromorphic_eq_ord (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : MeromorphicSection X.sheaf L)
    (hs : IsRegularMeromorphicSection X.sheaf L s) (x : X) :
    ∃ U : X.Opens, x ∈ U ∧ ∃ a : X.functionField,
      ∀ W : PrimeDivisor X, W.genericPoint ∈ U →
        orderOfVanishingMeromorphic X L s hs W = X.ord a W.genericPoint := by
  have : L.IsQuasicoherent := isQuasicoherent_of_isInvertible L
  obtain ⟨U, eU, -, hxU, -⟩ := Stacks.Chow.exists_affine_frame_subset X L x ⊤ trivial
  have : Nonempty (U : X.Opens) := ⟨⟨x, hxU⟩⟩
  obtain ⟨v, hv, -⟩ := exists_unique_eq_meromorphicSectionOfGenericStalk X L s
  have hηU : genericPoint X ∈ U.1 := Stacks.Divisors.genericPoint_mem_of_mem hxU
  obtain ⟨a, ha⟩ :=
    (Stacks.ChernCap42.isStalkBasis_germ_frameSections L eU (genericPoint X) hηU).2 v
  refine ⟨U.1, hxU, a, fun W hW => ?_⟩
  refine orderOfVanishingMeromorphic_eq_ord_of_isCoordinateAt L s hs W v hv a
    ⟨L.presheaf.germ U.1 W.genericPoint hW ((Stacks.Divisors.frameSections X L eU).symm 1),
      Stacks.ChernCap42.isStalkBasis_germ_frameSections L eU W.genericPoint hW, ?_⟩
  rw [Stacks.Divisors.toGenericStalk_germ hW hηU]
  exact ha.symm

/-- **The order of vanishing of the meromorphic section of a global section.** Along a prime
divisor `Z` it is the order of vanishing, at the generic point of `Z`, of the function
representing the section under a trivialization on a neighbourhood of that generic point. -/
theorem orderOfVanishingMeromorphic_ofGenericStalk_germ (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    [L.IsQuasicoherent] (t : Γ(L, (⊤ : X.Opens)))
    (hs : IsRegularMeromorphicSection X.sheaf L
      (meromorphicSectionOfGenericStalk X L (L.presheaf.germ ⊤ (genericPoint X) trivial t)))
    (Z : PrimeDivisor X) {U : X.Opens} [Nonempty U]
    (eU : L.over U ≅ SheafOfModules.unit (X.ringCatSheaf.over U)) (hx : Z.genericPoint ∈ U) :
    orderOfVanishingMeromorphic X L
        (meromorphicSectionOfGenericStalk X L (L.presheaf.germ ⊤ (genericPoint X) trivial t))
        hs Z =
      X.ord (X.germToFunctionField U (Stacks.Divisors.frameSections X L eU
        (L.presheaf.map (homOfLE le_top).op t))) Z.genericPoint := by
  exact orderOfVanishingMeromorphic_eq_ord_of_isCoordinateAt L _ hs Z _ rfl _
    (Stacks.ChernCap42.isCoordinateAt_frameSections L t eU Z.genericPoint hx)

/-- **The Weil divisor class of `𝒪_X(D)`.** For an effective Cartier divisor `D` on a locally
Noetherian integral scheme, the Weil divisor class of `𝒪_X(D)` is the class of any Weil divisor
whose coefficient at a prime divisor `Z` is the order of vanishing of a generator of the ideal
that `D` induces in the local ring at the generic point of `Z`. -/
theorem weilDivisorClassOfInvertibleSheaf_eq_of_forall_ord (I : X.IdealSheafData)
    [Stacks.Divisors.IsEffectiveCartierDivisor I] (D : WeilDivisor X)
    (hD : ∀ (Z : PrimeDivisor X) (c : X.presheaf.stalk Z.genericPoint),
      IdealSheafData.stalk I Z.genericPoint = Ideal.span {c} →
      D.val Z = X.ord (algebraMap (X.presheaf.stalk Z.genericPoint) X.functionField c)
        Z.genericPoint) :
    weilDivisorClassOfInvertibleSheaf X (Stacks.Divisors.modulesInvertibleSheaf I) =
      (D : weilDivisorClassGroup X) := by
  have : (Stacks.Divisors.modulesInvertibleSheaf I).IsQuasicoherent :=
    isQuasicoherent_of_isInvertible _
  have ht : (Stacks.Divisors.canonicalSections I).eval (op (⊤ : X.Opens)) ≠ 0 :=
    canonicalSections_eval_top_ne_zero I ‹_›
  have hs := isRegularMeromorphicSection_ofGenericStalk_germ
    (Stacks.Divisors.modulesInvertibleSheaf I)
    ((Stacks.Divisors.canonicalSections I).eval (op (⊤ : X.Opens))) ht
  rw [weilDivisorClassOfInvertibleSheaf_eq X (Stacks.Divisors.modulesInvertibleSheaf I) _ hs]
  congr 1
  refine Subtype.ext (funext fun Z => ?_)
  rw [weilDivisorOfMeromorphicSection_apply]
  obtain ⟨U, eU, -, hxU, -⟩ := Stacks.Chow.exists_affine_frame_subset X
    (Stacks.Divisors.modulesInvertibleSheaf I) Z.genericPoint ⊤ trivial
  have : Nonempty (U : X.Opens) := ⟨⟨Z.genericPoint, hxU⟩⟩
  have hideal : (zeroScheme X (Stacks.Divisors.modulesInvertibleSheaf I)
      ((Stacks.Divisors.canonicalSections I).eval (op (⊤ : X.Opens)))).ideal U =
      Ideal.span {Stacks.Divisors.frameSections X (Stacks.Divisors.modulesInvertibleSheaf I) eU
        ((Stacks.Divisors.modulesInvertibleSheaf I).presheaf.map (homOfLE le_top).op
          ((Stacks.Divisors.canonicalSections I).eval (op (⊤ : X.Opens))))} :=
    zeroScheme_ideal_of_trivialization X (Stacks.Divisors.modulesInvertibleSheaf I) _ U
      (Stacks.Divisors.frameSections X (Stacks.Divisors.modulesInvertibleSheaf I) eU) _ rfl
  rw [Stacks.Divisors.zeroScheme_canonicalSections I] at hideal
  rw [hD Z _ (IdealSheafData.stalk_eq_span_germ_of_ideal_eq_span (U := U) hxU hideal),
    Scheme.algebraMap_germ_eq_germToFunctionField X hxU]
  exact orderOfVanishingMeromorphic_ofGenericStalk_germ
    (Stacks.Divisors.modulesInvertibleSheaf I) _ hs Z eU hxU

end AlgebraicGeometry

end
