/-!
# Quasi-compactness of the relative homogeneous spectrum

Let `S` be a scheme carrying a quasi-coherent, commutative, nonnegatively graded
`𝒪_S`-algebra `𝒜`, and let `p : X = Proj_S(𝒜) ⟶ S` be its relative homogeneous spectrum. Then
`p` is quasi-compact as soon as `𝒜` is finitely generated over `𝒜_0` in any of three senses:
as an `𝒜_0`-algebra, by its degree-one piece, or up to a locally nilpotent quotient of the
positive part.

Quasi-compactness is checked on the affine opens `U` of the base, where the fibre of `p` is the
chart `Proj 𝒜(U)` of the relative construction: the chart square is cartesian, so the chart is
isomorphic to `p⁻¹(U)`, and the criterion of Stacks 01MD
(`AlgebraicGeometry.Proj.compactSpace_iff`) reduces each of the three hypotheses to exhibiting a
finite family of positive-degree homogeneous elements whose span has the irrelevant ideal inside
its radical.

## Main definitions

* `Stacks.RelativeProj.Situation.IsFiniteTypeOverDegreeZero` — the sections over every affine
  open form a finite type algebra over their degree-zero part.
* `Stacks.RelativeProj.Situation.IsFinitelyGeneratedInDegreeOne` — those algebras are generated
  by their degree-one part, which is in turn a finite type degree-zero module.
* `Stacks.RelativeProj.Situation.HasNilpotentPositiveQuotient` — there is a finite type
  degree-zero submodule of the positive part modulo which the positive part is locally
  nilpotent.

## Main results

* `Stacks.RelativeProj.Situation.quasiCompact_relativeProj` — under any of the three
  hypotheses the structure morphism of the relative homogeneous spectrum is quasi-compact.
* `Stacks.RelativeProj.Situation.compactSpace_proj_of_finset_generators` and
  `Stacks.RelativeProj.Situation.compactSpace_proj_of_finiteType` — the absolute statements the
  three reductions run through: the homogeneous spectrum of a graded ring generated over its
  degree-zero part by finitely many positive-degree homogeneous elements, or of finite type over
  it, is quasi-compact.

## Implementation notes

In the third hypothesis the submodule is a single family `F`, compatible with restriction
between affine opens, rather than an independent choice of generators on each of them: that
compatibility is what quasi-coherence of the submodule of the source amounts to. The proof uses
only the inclusion in the positive part, the finite generation and the nilpotence, so the
hypothesis could be weakened by dropping the compatibility clause; it is kept because the
definition is named after the source's quasi-coherent submodule.

The finite family produced in the third case is obtained by replacing a finite generating set of
`F` by the finite set of all homogeneous components of its members: those components have
positive degree because `F` lies in the irrelevant ideal, and they span a larger ideal, so the
nilpotence hypothesis still applies to them.

## References

* [Stacks Project, Tag 07ZX](https://stacks.math.columbia.edu/tag/07ZX)
* [Stacks Project, Tag 01MD](https://stacks.math.columbia.edu/tag/01MD)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.RelativeProj.Situation

/-! ### Finite generation of a graded ring, read on the projective spectrum -/

/-- **The projective spectrum of a graded ring generated by a finite set of positive-degree
homogeneous elements over its degree-zero part is quasi-compact.** -/
@[ega "II 3.4.1" "partial"]
theorem compactSpace_proj_of_finset_generators
    {A : Type*} {σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] (t : Finset A)
    (ht : ∀ x ∈ t, ∃ d : ℕ, 0 < d ∧ x ∈ 𝒜 d)
    (hadj : Algebra.adjoin (𝒜 0) (t : Set A) = ⊤) :
    CompactSpace (Proj 𝒜) := by
  classical
  have hspan := (generates_algebra_iff_generates_irrelevant 𝒜 (fun x : t => x.1)
    (fun x => Classical.choose (ht x.1 x.2))
    (fun x => (Classical.choose_spec (ht x.1 x.2)).1)
    (fun x => (Classical.choose_spec (ht x.1 x.2)).2)).mp (by simpa using hadj)
  refine (Proj.compactSpace_iff 𝒜).2 ⟨t, ht, ?_⟩
  rw [← show Ideal.span (t : Set A) = (HomogeneousIdeal.irrelevant 𝒜).toIdeal by simpa using hspan]
  exact Ideal.le_radical

/-- **The projective spectrum of a graded ring of finite type over its degree-zero part is
quasi-compact.** -/
theorem compactSpace_proj_of_finiteType
    {A : Type*} {σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] [Algebra.FiniteType (𝒜 0) A] :
    CompactSpace (Proj 𝒜) := by
  obtain ⟨t, hadj, ht⟩ := GradedAlgebra.exists_finset_adjoin_eq_top_and_homogeneous_ne_zero 𝒜
  refine compactSpace_proj_of_finset_generators 𝒜 t (fun x hx => ?_) hadj
  obtain ⟨d, hd, hxd⟩ := ht x hx
  exact ⟨d, Nat.pos_of_ne_zero hd, hxd⟩

/-- The finite set of all homogeneous components of the members of a finite set. -/
private noncomputable def homogeneousComponentFinset
    {A : Type*} {σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] (t : Finset A) : Finset A := by
  classical
  exact t.biUnion fun x => (DirectSum.decompose 𝒜 x).support.image
    fun n => GradedRing.proj 𝒜 n x

/-- A finite set spans no more than the ideal spanned by the homogeneous components of its
members, every member being the sum of its components. -/
private theorem span_le_span_homogeneousComponentFinset
    {A : Type*} {σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] (t : Finset A) :
    Ideal.span (t : Set A) ≤ Ideal.span (homogeneousComponentFinset 𝒜 t : Set A) := by
  classical
  refine Ideal.span_le.mpr fun x hx => ?_
  rw [← DirectSum.sum_support_decompose 𝒜 x]
  refine Ideal.sum_mem _ fun n hn => Ideal.subset_span ?_
  rw [← GradedRing.proj_apply]
  exact Finset.mem_biUnion.mpr ⟨x, hx, Finset.mem_image.mpr ⟨n, hn, rfl⟩⟩

/-- The homogeneous components of elements of the irrelevant ideal have positive degree. -/
private theorem homogeneousComponentFinset_pos
    {A : Type*} {σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] {t : Finset A}
    (ht : ∀ x ∈ t, x ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal) :
    ∀ x ∈ homogeneousComponentFinset 𝒜 t, ∃ d : ℕ, 0 < d ∧ x ∈ 𝒜 d := by
  classical
  intro x hx
  simp only [homogeneousComponentFinset, Finset.mem_biUnion, Finset.mem_image] at hx
  obtain ⟨y, hyt, n, hn, rfl⟩ := hx
  refine ⟨n, Nat.pos_of_ne_zero fun hn0 => ?_, proj_mem 𝒜 y n⟩
  subst hn0
  exact (GradedRing.mem_support_iff 𝒜 y 0).mp hn
    ((HomogeneousIdeal.mem_irrelevant_iff 𝒜 y).mp (ht y hyt))

/-! ### The three finite generation hypotheses -/

variable (s : Situation.{u})

/-- The graded algebra of a relative `Proj` situation is of finite type over its degree-zero
part: over every affine open of the base, the graded ring of sections is a finite type algebra
over its degree-zero piece. This is hypothesis (1) of Stacks 07ZX. -/
def IsFiniteTypeOverDegreeZero : Prop :=
  ∀ U : s.base.Opens, IsAffineOpen U →
    Algebra.FiniteType (s.sectionRingGrading U 0) (s.sectionRing U)

/-- The graded algebra of a relative `Proj` situation is generated in degree one: over every
affine open of the base, the graded ring of sections is generated as an algebra over its
degree-zero piece by its degree-one piece, which is itself a finite type degree-zero module.
This is hypothesis (2) of Stacks 07ZX. -/
def IsFinitelyGeneratedInDegreeOne : Prop :=
  ∀ U : s.base.Opens, IsAffineOpen U →
    (Algebra.adjoin (s.sectionRingGrading U 0)
      (s.sectionRingGrading U 1 : Set (s.sectionRing U)) = ⊤) ∧
    ∃ t : Finset (s.sectionRing U),
      ((t : Set (s.sectionRing U)) ⊆ (s.sectionRingGrading U 1 : Set (s.sectionRing U))) ∧
      ((s.sectionRingGrading U 1 : Set (s.sectionRing U)) ⊆
        (Submodule.span (s.sectionRingGrading U 0) (t : Set (s.sectionRing U)) :
          Set (s.sectionRing U)))

/-- The positive part of the graded algebra of a relative `Proj` situation is locally nilpotent
modulo a finite type quasi-coherent degree-zero submodule: there is one family `F` of
degree-zero submodules of the graded rings of sections, compatible with restriction between
affine opens, contained in the irrelevant ideal, finitely generated, and such that every element
of the irrelevant ideal has a power in the ideal generated by `F`. This is hypothesis (3) of
Stacks 07ZX. -/
def HasNilpotentPositiveQuotient : Prop :=
  ∃ F : ∀ U : s.base.Opens, IsAffineOpen U →
      Submodule (s.sectionRingGrading U 0) (s.sectionRing U),
    (∀ (U : s.base.Opens) (hU : IsAffineOpen U),
      (F U hU : Set (s.sectionRing U)) ⊆
        (HomogeneousIdeal.irrelevant (s.sectionRingGrading U)).toIdeal) ∧
    (∀ (U : s.base.Opens) (hU : IsAffineOpen U), (F U hU).FG) ∧
    (∀ (U V : s.base.Opens) (hU : IsAffineOpen U) (hV : IsAffineOpen V) (h : V ≤ U),
      F V hV = Submodule.span (s.sectionRingGrading V 0)
        (s.sectionRingRestrict V U h '' (F U hU : Set (s.sectionRing U)))) ∧
    (∀ (U : s.base.Opens) (hU : IsAffineOpen U) (x : s.sectionRing U),
      x ∈ (HomogeneousIdeal.irrelevant (s.sectionRingGrading U)).toIdeal →
        ∃ n : ℕ, x ^ n ∈ Ideal.span (F U hU : Set (s.sectionRing U)))

/-! ### Quasi-compactness -/

/-- Under hypothesis (2) of Stacks 07ZX the graded ring of sections over an affine open is
generated over its degree-zero part by a finite set of degree-one elements, so its projective
spectrum is quasi-compact. -/
@[ega "II 3.4.1" "partial"]
private theorem compactSpace_proj_of_degreeOne {U : s.base.Opens} (hU : IsAffineOpen U)
    (h : IsFinitelyGeneratedInDegreeOne s) :
    CompactSpace (Proj (s.sectionRingGrading U)) := by
  obtain ⟨hgen, t, hts, htspan⟩ := h U hU
  refine compactSpace_proj_of_finset_generators (s.sectionRingGrading U) t
    (fun x hx => ⟨1, Nat.one_pos, hts hx⟩) (top_unique ?_)
  rw [← hgen]
  refine Algebra.adjoin_le_iff.mpr fun x hx => ?_
  refine (Submodule.span_le.mpr fun y hy => Algebra.subset_adjoin hy : _ ≤
    (Algebra.adjoin (s.sectionRingGrading U 0)
      (t : Set (s.sectionRing U))).toSubmodule.restrictScalars _) (htspan hx)

/-- Under hypothesis (3) of Stacks 07ZX the irrelevant ideal of the graded ring of sections over
an affine open is contained in the radical of the ideal spanned by the homogeneous components of
a finite generating set of `F U`, so its projective spectrum is quasi-compact. -/
private theorem compactSpace_proj_of_nilpotent {U : s.base.Opens} (hU : IsAffineOpen U)
    (h : HasNilpotentPositiveQuotient s) :
    CompactSpace (Proj (s.sectionRingGrading U)) := by
  obtain ⟨F, hFpos, hFfg, -, hnilpotent⟩ := h
  obtain ⟨t, htspan⟩ := hFfg U hU
  have htirr : ∀ x ∈ t, x ∈ (HomogeneousIdeal.irrelevant (s.sectionRingGrading U)).toIdeal :=
    fun x hx => hFpos U hU (htspan ▸ Submodule.subset_span hx)
  have hFle : F U hU ≤ (Ideal.span (t : Set (s.sectionRing U))).restrictScalars
      (s.sectionRingGrading U 0) := by
    rw [← htspan]
    exact Submodule.span_le.mpr fun x hx => Ideal.subset_span hx
  have hspan : Ideal.span (F U hU : Set (s.sectionRing U)) ≤
      Ideal.span (homogeneousComponentFinset (s.sectionRingGrading U) t :
        Set (s.sectionRing U)) :=
    (Ideal.span_le.mpr fun x hx => hFle hx).trans
      (span_le_span_homogeneousComponentFinset (s.sectionRingGrading U) t)
  refine (Proj.compactSpace_iff (s.sectionRingGrading U)).2
    ⟨_, homogeneousComponentFinset_pos (s.sectionRingGrading U) htirr, fun x hx => ?_⟩
  obtain ⟨n, hn⟩ := hnilpotent U hU x hx
  exact Ideal.mem_radical_iff.mpr ⟨n, hspan hn⟩

/-- **Stacks 07ZX.** The structure morphism of the relative homogeneous spectrum of a
quasi-coherent graded algebra is quasi-compact as soon as the algebra is of finite type over its
degree-zero part, or generated by its degree-one piece, or has locally nilpotent positive part
modulo a finite type quasi-coherent degree-zero submodule. -/
@[stacks 07ZX,
  ega "II 3.4.1" "quasi-compactness",
  ega "II 3.1.3" "partial",
  ega "II 4.6.18" "partial"]
theorem quasiCompact_relativeProj
    (h : IsFiniteTypeOverDegreeZero s ∨ IsFinitelyGeneratedInDegreeOne s ∨
      HasNilpotentPositiveQuotient s) :
    QuasiCompact (relativeProjToBase s) := by
  rw [quasiCompact_iff_forall_isAffineOpen]
  intro U hU
  have e : Proj (s.sectionRingGrading U) ≅ (relativeProjToBase s ⁻¹ᵁ U).toScheme :=
    (relativeProjChart_isPullback s ⟨U, hU⟩).isoPullback.trans
      (isPullback_morphismRestrict (relativeProjToBase s) U).flip.isoPullback.symm
  have : CompactSpace (Proj (s.sectionRingGrading U)) := by
    rcases h with hfinite | hdegree | hnil
    · have : Algebra.FiniteType (s.sectionRingGrading U 0) (s.sectionRing U) := hfinite U hU
      exact compactSpace_proj_of_finiteType (s.sectionRingGrading U)
    · exact compactSpace_proj_of_degreeOne s hU hdegree
    · exact compactSpace_proj_of_nilpotent s hU hnil
  have : CompactSpace (↑(relativeProjToBase s ⁻¹ᵁ U : Set (relativeProj s))) :=
    (TopCat.homeoOfIso (asIso e.hom.base)).compactSpace
  exact isCompact_iff_compactSpace.mpr inferInstance

end Stacks.RelativeProj.Situation

end
