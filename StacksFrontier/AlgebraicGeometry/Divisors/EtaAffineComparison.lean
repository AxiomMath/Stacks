namespace Stacks.IdealTorsion.Eta

variable (X : RingedSpace.{u, u})

local notation "Oₓ" => (Stacks.SheafOfModules.Tensor.ringSheaf
  (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))
local notation "𝒪" => SheafOfModules.unit Oₓ

/-- Sections of a sheaf of `O_X`-modules are a module over the sections of the structure sheaf in
its `CommRingCat`-valued spelling. -/
private instance moduleSectionCommRingCat (M : SheafOfModules.{u} Oₓ) (V : (Opens X)ᵒᵖ) :
    Module (X.presheaf.obj V) (M.val.obj V) :=
  inferInstanceAs (Module ((Oₓ).obj.obj V) (M.val.obj V))

/-- Evaluation of sheaves of `O_X`-modules on an open subset, as a functor to modules over the
ring of sections of `O_X` on that open. -/
public noncomputable def sectionsFunctor (V : Opens X) :
    SheafOfModules.{u} Oₓ ⥤ ModuleCat.{u} (X.presheaf.obj (op V) : Type u) :=
  _root_.SheafOfModules.evaluation Oₓ (op V)

/-- Evaluating sheaves of modules on an open subset is an additive functor. -/
public instance additive_sectionsFunctor (V : Opens X) : (sectionsFunctor X V).Additive where
  map_add := rfl

/-- The complex of sections of a complex of sheaves of `O_X`-modules over an open subset. -/
public noncomputable abbrev sectionsComplex (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (V : Opens X) : EtaComplex.Complex.{u, u} (X.presheaf.obj (op V) : Type u) :=
  ((sectionsFunctor X V).mapHomologicalComplex (ComplexShape.up ℤ)).obj F

/-- The image in `O_X(U)` of a section of the ideal sheaf over `U`; this is the element `f` with
`D ∩ U = V(f)` when the section generates the ideal there. -/
public noncomputable def generatorSection {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (V : Opens X) (g : I.val.obj (op V)) : (X.presheaf.obj (op V) : Type u) :=
  idealSection X ι (op V) g

/-- Evaluation on an open subset preserves finite limits. -/
private theorem preservesFiniteLimits_sectionsFunctor (V : Opens X) :
    PreservesFiniteLimits (sectionsFunctor X V) :=
  _root_.SheafOfModules.Finite.evaluationPreservesFiniteLimits Oₓ (op V)

/-! ### Gluing a locally defined bijection -/

/-- A family of maps on the sections over the opens contained in `U` which is bijective on every
stalk over `U` is bijective on the sections over `U`. The family is not assumed to be natural;
compatibility with restriction follows from the stalkwise description. -/
private lemma local_sections_bijective_of_stalk_bijective
    {T : TopCat.{u}} (A B : TopCat.Sheaf AddCommGrpCat.{u} T) (V : Opens T)
    (φ : ∀ (W : Opens T), W ≤ V → A.obj.obj (op W) → B.obj.obj (op W))
    (ψ : ∀ (x : T), x ∈ V → A.presheaf.stalk x → B.presheaf.stalk x)
    (hψ : ∀ (x : T) (hx : x ∈ V), Function.Bijective (ψ x hx))
    (hφ : ∀ (W : Opens T) (hWV : W ≤ V) (x : T) (hx : x ∈ W)
      (s : A.obj.obj (op W)),
      ψ x (hWV hx) (A.presheaf.germ W x hx s) = B.presheaf.germ W x hx (φ W hWV s)) :
    Function.Bijective (φ V le_rfl) := by
  have hn (W : Opens T) (hWV : W ≤ V) (Z : Opens T) (hZW : Z ≤ W)
      (s : A.obj.obj (op W)) :
      φ Z (hZW.trans hWV) (A.obj.map (homOfLE hZW).op s) =
        B.obj.map (homOfLE hZW).op (φ W hWV s) := by
    apply TopCat.Presheaf.section_ext B Z
    intro x hxZ
    rw [← hφ, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply]
    exact hφ W hWV x (hZW hxZ) s
  have hi (W : Opens T) (hWV : W ≤ V) : Function.Injective (φ W hWV) := by
    intro s t hst
    apply TopCat.Presheaf.section_ext A W
    intro x hxW
    apply (hψ x (hWV hxW)).injective
    rw [hφ, hφ, hst]
  refine ⟨hi V le_rfl, ?_⟩
  intro t
  have hlocal (x : V) : ∃ (W : Opens T) (hxW : x.val ∈ W) (hWV : W ≤ V)
      (s : A.obj.obj (op W)), φ W hWV s = B.obj.map (homOfLE hWV).op t := by
    obtain ⟨z, hz⟩ := (hψ x.val x.property).surjective (B.presheaf.germ V x.val x.property t)
    obtain ⟨W, hxW, s, hs⟩ := A.presheaf.exists_germ_eq z
    let Z := W ⊓ V
    have hxZ : x.val ∈ Z := ⟨hxW, x.property⟩
    let sZ := A.obj.map (homOfLE (inf_le_left : Z ≤ W)).op s
    have h : B.presheaf.germ Z x.val hxZ (φ Z inf_le_right sZ) =
        B.presheaf.germ V x.val x.property t := by
      rw [← hφ]
      dsimp only [sZ]
      rw [TopCat.Presheaf.germ_res_apply, hs]
      exact hz
    obtain ⟨Y, hxY, iYZ, iYV, heq⟩ :=
      B.presheaf.germ_eq x.val hxZ x.property _ _ h
    refine ⟨Y, hxY, iYV.le, A.obj.map iYZ.op sZ, ?_⟩
    exact (hn Z inf_le_right Y iYZ.le sZ).trans heq
  choose W hxW hWV s hs using hlocal
  have hcover : V ≤ iSup W := fun x hxV => Opens.mem_iSup.mpr ⟨⟨x, hxV⟩, hxW ⟨x, hxV⟩⟩
  have hcompat : TopCat.Presheaf.IsCompatible A.obj W s := by
    intro x y
    apply hi (W x ⊓ W y) (inf_le_left.trans (hWV x))
    change φ (W x ⊓ W y) _ (A.obj.map (homOfLE inf_le_left).op (s x)) =
      φ (W x ⊓ W y) _ (A.obj.map (homOfLE inf_le_right).op (s y))
    rw [hn (W x) (hWV x) _ inf_le_left, hn (W y) (hWV y) _ inf_le_right, hs, hs]
    simp only [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  obtain ⟨a, ha, -⟩ := A.existsUnique_gluing' W V (fun x => homOfLE (hWV x))
    hcover s hcompat
  refine ⟨a, B.eq_of_locally_eq' W V (fun x => homOfLE (hWV x)) hcover _ _
    fun x => ?_⟩
  rw [← hn V le_rfl (W x) (hWV x), ha]
  exact hs x

/-! ### Tensoring by a cyclic generator -/

open TensorProduct in
/-- If `g` generates `I` and kills no element of `M` through its annihilator, then tensoring
with `g` is a bijection `M ≃ I ⊗ M`. -/
private lemma tensor_mk_bijective_of_cyclic
    {R I M : Type*} [CommRing R] [AddCommGroup I] [AddCommGroup M]
    [Module R I] [Module R M] (g : I)
    (hg : ∀ a : I, ∃ r : R, a = r • g)
    (hM : ∀ r : R, r • g = 0 → ∀ m : M, r • m = 0) :
    Function.Bijective (TensorProduct.mk R I M g) := by
  let a : R →ₗ[R] I := LinearMap.toSpanSingleton R I g
  have ha : Function.Surjective a := fun i => (hg i).imp fun _ hr => hr.symm
  have hk : a.ker ≤ (LinearMap.lsmul R M).ker := fun r hr => LinearMap.ext (hM r hr)
  let e := a.quotKerEquivOfSurjective ha
  let b : I →ₗ[R] M →ₗ[R] M :=
    (a.ker.liftQ (LinearMap.lsmul R M) hk).comp e.symm.toLinearMap
  have hb (r : R) (m : M) : b (r • g) m = r • m := by
    change (a.ker.liftQ (LinearMap.lsmul R M) hk) (e.symm (a r)) m = _
    rw [LinearMap.quotKerEquivOfSurjective_symm_apply]
    rfl
  let q := TensorProduct.lift b
  have hq (m : M) : q (TensorProduct.tmul R g m) = m := by
    change b g m = m
    simpa only [one_smul] using hb 1 m
  refine ⟨fun m n hmn => (hq m).symm.trans ((congrArg q hmn).trans (hq n)), fun z => ⟨q z, ?_⟩⟩
  induction z using TensorProduct.inductionOn with
  | tmul i m =>
    obtain ⟨r, rfl⟩ := hg i
    change TensorProduct.tmul R g (b (r • g) m) = _
    rw [hb, TensorProduct.smul_tmul, TensorProduct.tmul_smul]
  | add x y hx hy => simpa only [map_add] using congrArg₂ (· + ·) hx hy

open TensorProduct in
/-- The annihilator hypothesis of `tensor_mk_bijective_of_cyclic` holds on a tensor product
with `I`, since there the annihilator of `g` acts through `I`. -/
private lemma tensor_mk_bijective_tensor_of_cyclic
    {R I M : Type*} [CommRing R] [AddCommGroup I] [AddCommGroup M]
    [Module R I] [Module R M] (g : I)
    (hg : ∀ a : I, ∃ r : R, a = r • g) :
    Function.Bijective (TensorProduct.mk R I (TensorProduct R I M) g) := by
  apply tensor_mk_bijective_of_cyclic g hg
  intro r hr m
  induction m using TensorProduct.inductionOn with
  | tmul i m =>
    obtain ⟨s, rfl⟩ := hg i
    rw [TensorProduct.smul_tmul', smul_comm r s g, hr, smul_zero, TensorProduct.zero_tmul]
  | add x y hx hy => rw [smul_add, hx, hy, zero_add]

open TensorProduct in
/-- Tensoring with a generator `g` of `I` is a bijection `M ≃ I ⊗ M` whenever `M` is itself a
tensor product with `I`. -/
private lemma tensor_mk_bijective_of_tensor_equiv
    {R I M P : Type*} [CommRing R] [AddCommGroup I] [AddCommGroup M] [AddCommGroup P]
    [Module R I] [Module R M] [Module R P] (g : I)
    (hg : ∀ a : I, ∃ r : R, a = r • g) (e : M ≃ₗ[R] TensorProduct R I P) :
    Function.Bijective (TensorProduct.mk R I M g) := by
  apply tensor_mk_bijective_of_cyclic g hg
  intro r hr m
  apply e.injective
  rw [map_smul, map_zero]
  apply (tensor_mk_bijective_tensor_of_cyclic (M := P) g hg).injective
  change TensorProduct.tmul R g (r • e m) = TensorProduct.tmul R g 0
  rw [← TensorProduct.smul_tmul, hr, TensorProduct.zero_tmul, TensorProduct.tmul_zero]

open TensorProduct in
/-- The right-handed form: tensoring on the right with a generator `g` of `I` is a bijection
`M ≃ M ⊗ I` whenever `M` is itself a tensor product with `I`. -/
private lemma tmul_right_bijective_of_tensor_equiv
    {R I M P : Type*} [CommRing R] [AddCommGroup I] [AddCommGroup M] [AddCommGroup P]
    [Module R I] [Module R M] [Module R P] (g : I)
    (hg : ∀ a : I, ∃ r : R, a = r • g) (e : M ≃ₗ[R] TensorProduct R P I) :
    Function.Bijective (fun m : M => m ⊗ₜ[R] g) := by
  have h := tensor_mk_bijective_of_tensor_equiv (M := M) (P := P) g hg
    (e.trans (TensorProduct.comm R P I))
  exact (TensorProduct.comm R I M).bijective.comp h

/-! ### Stalks of sheaves of modules -/

/-- A section generating an ideal sheaf on `U` spans the stalk of the ideal at every point
of `U`. -/
private lemma generator_spans_stalk {I : SheafOfModules.{u} Oₓ}
    (V : Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g) (x : X) (hxV : x ∈ V)
    (m : grpStalk X I.val x) :
    ∃ r : ringStalk X x, m = r • grpGerm X I.val x V hxV g := by
  obtain ⟨W, hxW, a, ha⟩ :=
    TopCat.Presheaf.exists_germ_eq (C := AddCommGrpCat.{u}) I.val.presheaf m
  let Z : Opens X := W ⊓ V
  have hxZ : x ∈ Z := ⟨hxW, hxV⟩
  let aZ : I.val.obj (op Z) := (I.val.map (homOfLE inf_le_left).op).hom a
  obtain ⟨r, hr⟩ := hg Z inf_le_right aZ
  have hres : grpGerm X I.val x Z hxZ aZ = m :=
    (grpGerm_res I W Z inf_le_left x hxZ a).trans ha
  refine ⟨ringGerm X x Z hxZ r, ?_⟩
  rw [← hres, hr]
  -- The two germ identities are composed as terms: the module sheaf is an explicit argument of
  -- `stalkModule_germ_smul`, which `rw` cannot instantiate across the ring-sheaf spellings.
  exact (stalkModule_germ_smul X I.val x Z hxZ r
      ((I.val.map (homOfLE (inf_le_right : Z ≤ V)).op).hom g)).trans
    (congrArg (fun w => ringGerm X x Z hxZ r • w)
      (grpGerm_res I V Z inf_le_right x hxZ g))

/-! ### Tensoring a section by a generator of the ideal -/

open TensorProduct in
/-- Tensoring with a section `g` of `I` over `V`, on the sections over `V`. -/
private noncomputable def tensorGen (I M : SheafOfModules.{u} Oₓ) (V : Opens X)
    (g : I.val.obj (op V)) :
    (sectionsFunctor X V).obj M →ₗ[X.presheaf.obj (op V)]
      (sectionsFunctor X V).obj
          ((((Stacks.SheafOfModules.Tensor.sheafTensor
          ⟨((X)).presheaf, ((X)).IsSheaf⟩).obj (M)).obj (I))) :=
  let s : ((PresheafOfModules.tensorObj (O := (X).presheaf) (M.val) (I.val))).obj (op V) ⟶
      (sectionsFunctor X V).obj
          ((((Stacks.SheafOfModules.Tensor.sheafTensor
          ⟨((X)).presheaf, ((X)).IsSheaf⟩).obj (M)).obj (I))) :=
    (sheafifyUnit X ((PresheafOfModules.tensorObj (O := (X).presheaf) (M.val) (I.val)))).app (op V)
  s.hom ∘ₗ (TensorProduct.mk (X.presheaf.obj (op V))
    (M.val.obj (op V)) (I.val.obj (op V))).flip g

open TensorProduct in
/-- Tensoring with a generator of `I` on `V` is bijective on the sections over `V`, provided the
module is itself a tensor product with `I`. The map is bijective on every stalk over `V`, since
there the generator spans the stalk of `I`, and a stalkwise bijection on the opens contained in
`V` is bijective on the sections over `V`. -/
private lemma bijective_tensorGen (I M P : SheafOfModules.{u} Oₓ)
    (e : M ≅ (((Stacks.SheafOfModules.Tensor.sheafTensor
        ⟨((X)).presheaf, ((X)).IsSheaf⟩).obj (P)).obj (I)))
    (V : Opens X) (g : I.val.obj (op V))
    (hg : GeneratesIdealOn X V g) :
    Function.Bijective (tensorGen X I M V g) := by
  let A := (_root_.SheafOfModules.toSheaf Oₓ).obj M
  let B := (_root_.SheafOfModules.toSheaf Oₓ).obj
      ((((Stacks.SheafOfModules.Tensor.sheafTensor
      ⟨((X)).presheaf, ((X)).IsSheaf⟩).obj (M)).obj (I)))
  let φ (W : Opens X) (hWV : W ≤ V) (m : M.val.obj (op W)) :=
    toTensorSheafSection X M I (op W)
      (m ⊗ₜ[X.presheaf.obj (op W)] (I.val.map (homOfLE hWV).op).hom g)
  let ψ (x : X) (hx : x ∈ V) (m : grpStalk X M.val x) :=
    (tensorStalkIso X x M I).symm (m ⊗ₜ[ringStalk X x] grpGerm X I.val x V hx g)
  have hψ (x : X) (hx : x ∈ V) : Function.Bijective (ψ x hx) :=
    (tensorStalkIso X x M I).symm.bijective.comp
      (tmul_right_bijective_of_tensor_equiv (grpGerm X I.val x V hx g)
        (fun a => generator_spans_stalk X V g hg x hx a)
        ((moduleStalkIso X e x).trans (tensorStalkIso X x P I)))
  have hφ (W : Opens X) (hWV : W ≤ V) (x : X) (hx : x ∈ W) (m : M.val.obj (op W)) :
      ψ x (hWV hx) (grpGerm X M.val x W hx m) =
        grpGerm X ((((Stacks.SheafOfModules.Tensor.sheafTensor
            ⟨((X)).presheaf, ((X)).IsSheaf⟩).obj (M)).obj (I))).val x W hx (φ W hWV m) := by
    apply (tensorStalkIso X x M I).injective
    change (tensorStalkIso X x M I) ((tensorStalkIso X x M I).symm _) = _
    rw [LinearEquiv.apply_symm_apply]
    -- The germ identities are composed as terms: `tensorStalkIso_germ` carries the module
    -- sheaves as explicit arguments typed over the other spelling of the ring sheaf.
    exact ((tensorStalkIso_germ X x M I W hx m
          ((I.val.map (homOfLE hWV).op).hom g)).trans
      (congrArg (fun w => grpGerm X M.val x W hx m ⊗ₜ[ringStalk X x] w)
        (grpGerm_res I V W hWV x hx g))).symm
  have h := local_sections_bijective_of_stalk_bijective A B V φ ψ hψ hφ
  have hres : (I.val.map (homOfLE (le_refl V)).op).hom g = g := by
    change (I.val.presheaf.map (𝟙 (op V))).hom g = g
    exact congrArg (fun k => AddCommGrpCat.Hom.hom k g) (I.val.presheaf.map_id (op V))
  have hfun (m : (sectionsFunctor X V).obj M) :
      tensorGen X I M V g m = φ V (le_refl V) m :=
    congrArg (fun w => toTensorSheafSection X M I (op V)
      (m ⊗ₜ[X.presheaf.obj (op V)] w)) hres.symm
  refine ⟨fun a b hab => h.1 ((hfun a).symm.trans (hab.trans (hfun b))), fun z => ?_⟩
  obtain ⟨a, ha⟩ := h.2 z
  exact ⟨a, (hfun a).trans ha⟩

/-- Tensoring with a generator of `I` on `V`, as an isomorphism of modules of sections. -/
private noncomputable def tensorGenEquiv (I M P : SheafOfModules.{u} Oₓ)
    (e : M ≅ (((Stacks.SheafOfModules.Tensor.sheafTensor
        ⟨((X)).presheaf, ((X)).IsSheaf⟩).obj (P)).obj (I)))
    (V : Opens X) (g : I.val.obj (op V))
    (hg : GeneratesIdealOn X V g) :
    (sectionsFunctor X V).obj M ≃ₗ[X.presheaf.obj (op V)]
      (sectionsFunctor X V).obj
          ((((Stacks.SheafOfModules.Tensor.sheafTensor
          ⟨((X)).presheaf, ((X)).IsSheaf⟩).obj (M)).obj (I))) :=
  LinearEquiv.ofBijective (tensorGen X I M V g) (bijective_tensorGen X I M P e V g hg)

/-! ### The ideal-power inclusion on sections -/

/-- Tensoring on the right with an invertible ideal sheaf is an equivalence. -/
private instance isEquivalence_tensorRight (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I] :
    (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf
      X.IsSheaf)).flip.obj I)).IsEquivalence :=
  tensorRightFunctor_isEquivalence X.sheaf.obj (Oₓ).property I

/-- The ideal-power inclusion in degree `n` is the zeroth inclusion on the `n`-th power,
precomposed with the successor comparison. -/
private lemma idealPowerIncl_eq_comp (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (n : ℤ) :
    idealPowerIncl X I ι n M =
      (powSuccIso (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
          (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf
          X.IsSheaf)).flip.obj I)).asEquivalence n M).inv ≫
        idealPowerIncl X I ι 0 (idealPowerTerm X I n M) := by
  let T := ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj I)
  let Q : SheafOfModules.{u} Oₓ := idealPowerTerm X I n M
  let c : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).obj Q).obj I ⟶
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).obj Q).obj 𝒪 :=
    ((Functor.uncurry.obj (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)))).map
      (X := (Q, I)) (Y := (Q, 𝒪)) (𝟙 Q, ι)
  let r := (tensorProductRightUnitor X.sheaf.obj (Oₓ).property Q).hom
  change (powSuccIso T.asEquivalence n M).inv ≫ c ≫ r =
    (powSuccIso T.asEquivalence n M).inv ≫ (𝟙 _ ≫ c ≫ r)
  rw [Category.id_comp]

/-- The `n`-th ideal power of a module is a tensor product with `I`. -/
private noncomputable def idealPowerTensorIso (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (n : ℤ) :
    idealPowerTerm X I n M ≅
        (((Stacks.SheafOfModules.Tensor.sheafTensor
        ⟨((X)).presheaf, ((X)).IsSheaf⟩).obj ((idealPowerTerm X I (n - 1) M))).obj (I)) :=
  eqToIso (congrArg (fun k => idealPowerTerm X I k M) (sub_add_cancel n 1).symm) ≪≫
    (powSuccIso (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf
        X.IsSheaf)).flip.obj I)).asEquivalence (n - 1) M).symm

/-- Division by the generator: on the sections over `V`, the `(n+1)`-st ideal power is isomorphic
to the `n`-th, the inverse isomorphism being tensoring with the generator followed by the
successor comparison. -/
private noncomputable def idealPowerStepEquiv (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (V : Opens X) (g : I.val.obj (op V))
    (hg : GeneratesIdealOn X V g) (n : ℤ) :
    (sectionsFunctor X V).obj (idealPowerTerm X I (n + 1) M) ≃ₗ[X.presheaf.obj (op V)]
      (sectionsFunctor X V).obj (idealPowerTerm X I n M) :=
  (CategoryTheory.Iso.toLinearEquiv ((sectionsFunctor X V).mapIso
      (powSuccIso (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
          (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf
          X.IsSheaf)).flip.obj I)).asEquivalence n M))).symm.trans
    (tensorGenEquiv X I (idealPowerTerm X I n M) (idealPowerTerm X I (n - 1) M)
      (idealPowerTensorIso X I M n) V g hg).symm

private lemma idealPowerStepEquiv_smul (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (V : Opens X) (g : I.val.obj (op V))
    (hg : GeneratesIdealOn X V g) (n : ℤ)
    (z : (sectionsFunctor X V).obj (idealPowerTerm X I (n + 1) M)) :
    ((sectionsFunctor X V).map (idealPowerIncl X I ι n M)).hom z =
      generatorSection X ι V g • idealPowerStepEquiv X I M V g hg n z := by
  have hmap : ((sectionsFunctor X V).map (idealPowerIncl X I ι n M)).hom z =
      ((sectionsFunctor X V).map
          (idealPowerIncl X I ι 0 (idealPowerTerm X I n M))).hom
        (((sectionsFunctor X V).map (powSuccIso
          (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
              (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf
              X.IsSheaf)).flip.obj I)).asEquivalence n M).inv).hom z) :=
    ConcreteCategory.congr_hom
      ((congrArg (fun k => (sectionsFunctor X V).map k) (idealPowerIncl_eq_comp X I ι M n)).trans
        ((sectionsFunctor X V).map_comp _ _)) z
  have hρz : tensorGen X I (idealPowerTerm X I n M) V g
        (idealPowerStepEquiv X I M V g hg n z) =
      ((sectionsFunctor X V).map (powSuccIso
        (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
            (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf
            X.IsSheaf)).flip.obj I)).asEquivalence n M).inv).hom z :=
    (tensorGenEquiv X I (idealPowerTerm X I n M) (idealPowerTerm X I (n - 1) M)
      (idealPowerTensorIso X I M n) V g hg).apply_symm_apply _
  rw [hmap, ← hρz]
  exact idealPowerIncl_zero_app_toTensorSheafSection X I ι (idealPowerTerm X I n M) V
    (idealPowerStepEquiv X I M V g hg n z) g

/-- A monomorphism of sheaves of modules is injective on the sections over every open: it is
injective on every stalk, and a section with vanishing germs vanishes. -/
private lemma injective_sectionsFunctor_map {M N : SheafOfModules.{u} Oₓ} (a : M ⟶ N) [Mono a]
    (V : Opens X) : Function.Injective ((sectionsFunctor X V).map a) := by
  intro s t hst
  refine TopCat.Presheaf.section_ext ((_root_.SheafOfModules.toSheaf Oₓ).obj M) V _ _
    fun x hx => stalkMapL_injective_of_mono X a x ?_
  exact (stalkMapL_germ X a x V hx s).trans
    ((congrArg (fun w => grpGerm X N.val x V hx w) hst).trans
      (stalkMapL_germ X a x V hx t).symm)

/-- On an open where it generates the ideal sheaf, the image of a generator is a nonzerodivisor on
the sections of every ideal power of an `I`-torsion-free module. -/
private lemma generator_isSMulRegular (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (hM : IsIdealTorsionFree X ι M)
    (V : Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g) (n : ℤ) :
    IsSMulRegular ((sectionsFunctor X V).obj (idealPowerTerm X I n M))
      (generatorSection X ι V g) := by
  have := idealPowerIncl_mono X I ι M hM n
  intro a b hab
  let e := idealPowerStepEquiv X I M V g hg n
  refine e.symm.injective (injective_sectionsFunctor_map X (idealPowerIncl X I ι n M) V ?_)
  rw [idealPowerStepEquiv_smul X I ι M V g hg, idealPowerStepEquiv_smul X I ι M V g hg]
  change generatorSection X ι V g • e (e.symm a) = generatorSection X ι V g • e (e.symm b)
  rwa [e.apply_symm_apply, e.apply_symm_apply]

/-! ### The comparison of the ideal powers with the powers of the generator -/

/-- The generator-normalized comparison on sections: in degree `n` it is the trivialization of
`I^n` by `g^n` followed by multiplication by `f^n` inside the localization of `M(V)` at the image
`f` of the generator. It is pinned down by `idealPowerSectionsMap_zero`,
`idealPowerSectionsMap_succ` and `idealPowerSectionsMap_range`. -/
@[no_expose]
public noncomputable def idealPowerSectionsMap (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (V : Opens X) (g : I.val.obj (op V))
    (hg : GeneratesIdealOn X V g) (n : ℤ) :
    (sectionsFunctor X V).obj (idealPowerTerm X I n M) →ₗ[X.presheaf.obj (op V)]
      EtaPow.Loc (generatorSection X ι V g) ((sectionsFunctor X V).obj M) :=
  (EtaPow.fpowMap (generatorSection X ι V g) ((sectionsFunctor X V).obj M) n).comp
    (integerLinearEquiv (fun k => (sectionsFunctor X V).obj (idealPowerTerm X I k M))
      (idealPowerStepEquiv X I M V g hg) n).toLinearMap

/-- In the zeroth power the comparison is the canonical map of `M(V)` into its localization. -/
public theorem idealPowerSectionsMap_zero (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (V : Opens X) (g : I.val.obj (op V))
    (hg : GeneratesIdealOn X V g) :
    idealPowerSectionsMap X I ι M V g hg 0 =
      EtaPow.toLoc (generatorSection X ι V g) ((sectionsFunctor X V).obj M) := by
  -- The two halves — the transition equivalence at `0` is the identity, and `f^0 • ·` is the
  -- identity — are stated separately, so that neither has to be found inside a goal whose type
  -- mentions both spellings of the ring sheaf.
  have hzero : ∀ (z : (sectionsFunctor X V).obj (idealPowerTerm X I 0 M)),
      (integerLinearEquiv (fun k => (sectionsFunctor X V).obj (idealPowerTerm X I k M))
          (idealPowerStepEquiv X I M V g hg) 0) z = z :=
    fun z => congrArg (fun q => q z)
      (integerLinearEquiv_zero (fun k => (sectionsFunctor X V).obj (idealPowerTerm X I k M))
        (idealPowerStepEquiv X I M V g hg))
  have hpow : ∀ (w : (sectionsFunctor X V).obj M),
      EtaPow.fpowMap (generatorSection X ι V g) ((sectionsFunctor X V).obj M) 0 w =
        EtaPow.toLoc (generatorSection X ι V g) ((sectionsFunctor X V).obj M) w := by
    intro w
    rw [EtaPow.fpowMap_apply, zpow_zero, one_smul]
  ext z
  exact Eq.trans (congrArg (fun w => EtaPow.fpowMap (generatorSection X ι V g)
    ((sectionsFunctor X V).obj M) 0 w) (hzero z)) (hpow z)

/-- The comparison carries the inclusion of the next ideal power to the inclusion of the next
power of the generator. -/
public theorem idealPowerSectionsMap_succ (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (V : Opens X) (g : I.val.obj (op V))
    (hg : GeneratesIdealOn X V g) (n : ℤ)
    (z : (sectionsFunctor X V).obj (idealPowerTerm X I (n + 1) M)) :
    idealPowerSectionsMap X I ι M V g hg n
        (((sectionsFunctor X V).map (idealPowerIncl X I ι n M)).hom z) =
      idealPowerSectionsMap X I ι M V g hg (n + 1) z := by
  dsimp only [idealPowerSectionsMap, LinearMap.comp_apply, LinearEquiv.coe_coe]
  -- In the goal the transition equivalence sits behind its linear-map coercion, which
  -- `integerLinearEquiv_succ` does not see; that step is done in its own statement instead.
  have hinner :
      integerLinearEquiv (fun k => (sectionsFunctor X V).obj (idealPowerTerm X I k M))
            (idealPowerStepEquiv X I M V g hg) n
          (((sectionsFunctor X V).map (idealPowerIncl X I ι n M)).hom z) =
        generatorSection X ι V g • integerLinearEquiv
            (fun k => (sectionsFunctor X V).obj (idealPowerTerm X I k M))
            (idealPowerStepEquiv X I M V g hg) (n + 1) z := by
    rw [idealPowerStepEquiv_smul X I ι M V g hg, map_smul,
      integerLinearEquiv_succ
        (fun k => (sectionsFunctor X V).obj (idealPowerTerm X I k M))
        (idealPowerStepEquiv X I M V g hg) n z]
  have hpow : ∀ (w : (sectionsFunctor X V).obj M),
      EtaPow.fpowMap (generatorSection X ι V g) ((sectionsFunctor X V).obj M) n
          (generatorSection X ι V g • w) =
        EtaPow.fpowMap (generatorSection X ι V g) ((sectionsFunctor X V).obj M) (n + 1) w := by
    intro w
    rw [EtaPow.fpowMap_apply, EtaPow.fpowMap_apply, map_smul,
      ← EtaPow.fUnit_units_smul, smul_smul, zpow_add, zpow_one]
  exact (congrArg (fun w => EtaPow.fpowMap (generatorSection X ι V g)
    ((sectionsFunctor X V).obj M) n w) hinner).trans (hpow _)

/-- The image of the comparison in degree `n` is the submodule `f^n M(V)` of the
localization. -/
public theorem idealPowerSectionsMap_range (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (V : Opens X) (g : I.val.obj (op V))
    (hg : GeneratesIdealOn X V g) (n : ℤ) :
    LinearMap.range (idealPowerSectionsMap X I ι M V g hg n) =
      EtaPow.fpowSub (generatorSection X ι V g) ((sectionsFunctor X V).obj M) n := by
  rw [EtaPow.fpowSub_eq_range]
  exact LinearMap.range_comp_of_range_eq_top _ (LinearEquiv.range _)

/-- The comparison is injective in every degree, the generator being a nonzerodivisor on the
sections of an `I`-torsion-free module. -/
public theorem idealPowerSectionsMap_injective (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (hM : IsIdealTorsionFree X ι M)
    (V : Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g) (n : ℤ) :
    Function.Injective (idealPowerSectionsMap X I ι M V g hg n) := by
  intro a b hab
  apply (integerLinearEquiv (fun k => (sectionsFunctor X V).obj (idealPowerTerm X I k M))
    (idealPowerStepEquiv X I M V g hg) n).injective
  apply EtaPow.toLoc_injective_of_isSMulRegular
    (generator_isSMulRegular X I ι M hM V g hg 0)
  exact EtaPow.fUnit_zpow_smul_injective n hab

/-- **The generator-normalized comparison is natural in the module.**  A map `a : M ⟶ N` of
sheaves of modules commutes with the comparison of the `n`-th ideal power with the `n`-th power
of the generator, the map induced on the localizations being `f`-adic localization of the map on
sections. -/
public theorem idealPowerSectionsMap_natural (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    {M N : SheafOfModules.{u} Oₓ} (a : M ⟶ N)
    (V : Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g) (n : ℤ)
    (z : (sectionsFunctor X V).obj (idealPowerTerm X I n M)) :
    EtaPow.fLoc (generatorSection X ι V g) ((sectionsFunctor X V).map a).hom
        (idealPowerSectionsMap X I ι M V g hg n z) =
      idealPowerSectionsMap X I ι N V g hg n
        (((sectionsFunctor X V).map (idealPowerMap X I n a)).hom z) := by
  have hn (k : ℤ) (w : (sectionsFunctor X V).obj (idealPowerTerm X I (k + 1) M)) :
      ((sectionsFunctor X V).map (idealPowerMap X I k a)).hom
          (((sectionsFunctor X V).map (idealPowerIncl X I ι k M)).hom w) =
        ((sectionsFunctor X V).map (idealPowerIncl X I ι k N)).hom
          (((sectionsFunctor X V).map (idealPowerMap X I (k + 1) a)).hom w) :=
    ConcreteCategory.congr_hom
      (by simpa only [Functor.map_comp] using
        congrArg (sectionsFunctor X V).map (idealPowerIncl_natural X I ι k a)) w
  induction n using (Int.inductionOn' · 0) with
  | zero =>
    rw [idealPowerSectionsMap_zero, idealPowerSectionsMap_zero]
    exact EtaPow.fLoc_toLoc _ _
  | succ k hk ih =>
    rw [← idealPowerSectionsMap_succ, ih, hn, idealPowerSectionsMap_succ]
  | pred k hk ih =>
    obtain ⟨w, rfl⟩ := (idealPowerStepEquiv X I M V g hg (k - 1)).surjective z
    apply EtaPow.fUnit_zpow_smul_injective 1
    simp only [zpow_one, EtaPow.fUnit_units_smul]
    rw [← map_smul (EtaPow.fLoc (generatorSection X ι V g)
        ((sectionsFunctor X V).map a).hom),
      ← map_smul (idealPowerSectionsMap X I ι M V g hg (k - 1)),
      ← map_smul (idealPowerSectionsMap X I ι N V g hg (k - 1)),
      ← map_smul ((sectionsFunctor X V).map (idealPowerMap X I (k - 1) a)).hom]
    change EtaPow.fLoc (generatorSection X ι V g) ((sectionsFunctor X V).map a).hom
        (idealPowerSectionsMap X I ι M V g hg (k - 1)
          (generatorSection X ι V g • idealPowerStepEquiv X I M V g hg (k - 1) w)) = _
    rw [← idealPowerStepEquiv_smul X I ι M V g hg (k - 1),
      idealPowerSectionsMap_succ, hn, idealPowerSectionsMap_succ]
    have ih' : ∀ z, EtaPow.fLoc (generatorSection X ι V g)
        ((sectionsFunctor X V).map a).hom
        (idealPowerSectionsMap X I ι M V g hg (k - 1 + 1) z) =
      idealPowerSectionsMap X I ι N V g hg (k - 1 + 1)
        (((sectionsFunctor X V).map (idealPowerMap X I (k - 1 + 1) a)).hom z) := by
      rw [sub_add_cancel]
      exact ih
    exact ih' w

/-- The comparison of the `n`-th ideal power with the `n`-th power of the generator, as a
morphism of modules of sections. -/
public noncomputable def idealPowerSectionsHom (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (V : Opens X) (g : I.val.obj (op V))
    (hg : GeneratesIdealOn X V g) (n : ℤ) :
    ModuleCat.of (X.presheaf.obj (op V) : Type u)
        ((sectionsFunctor X V).obj (idealPowerTerm X I n M)) ⟶
      ModuleCat.of (X.presheaf.obj (op V) : Type u)
        (EtaPow.Loc (generatorSection X ι V g) ((sectionsFunctor X V).obj M)) :=
  ModuleCat.ofHom (idealPowerSectionsMap X I ι M V g hg n)

/-! ### The comparison of the two décalages on an affine chart -/

private lemma etaTerm_sections_range_inf (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (V : Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g) (n : ℤ) :
    LinearMap.range (idealPowerSectionsMap X I ι (F.X n) V g hg n) ⊓
        (LinearMap.range
          (idealPowerSectionsMap X I ι (F.X (n + 1)) V g hg (n + 1))).comap
          (EtaPow.fLoc (generatorSection X ι V g)
            ((sectionsFunctor X V).map (F.d n (n + 1))).hom) =
      EtaComplex.term (generatorSection X ι V g) (sectionsComplex X F V) n := by
  rw [idealPowerSectionsMap_range, idealPowerSectionsMap_range]
  rfl

private lemma idealPowerSectionsMap_comp_natural (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (V : Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g) (n : ℤ) :
    (EtaPow.fLoc (generatorSection X ι V g)
          ((sectionsFunctor X V).map (F.d n (n + 1))).hom).comp
        (idealPowerSectionsMap X I ι (F.X n) V g hg n) =
      (idealPowerSectionsMap X I ι (F.X (n + 1)) V g hg n).comp
        ((sectionsFunctor X V).map (idealPowerMap X I n (F.d n (n + 1)))).hom :=
  LinearMap.ext fun z => idealPowerSectionsMap_natural X I ι (F.d n (n + 1)) V g hg n z

private lemma idealPowerSectionsMap_comp_succ (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ)
    (V : Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g) (n : ℤ) :
    (idealPowerSectionsMap X I ι M V g hg n).comp
        ((sectionsFunctor X V).map (idealPowerIncl X I ι n M)).hom =
      idealPowerSectionsMap X I ι M V g hg (n + 1) :=
  LinearMap.ext fun z => idealPowerSectionsMap_succ X I ι M V g hg n z

/-- In degree `n` the sections of the décalage term are the degree-`n` term of the décalage of
the complex of sections: the defining fibre product is carried by the normalized ideal-power
comparisons onto the intersection of `f^n F^n(V)` with the preimage of `f^{n+1} F^{n+1}(V)`. -/
private noncomputable def etaTermSectionsIso (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n, IsIdealTorsionFree X ι (F.X n))
    (V : Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g) (n : ℤ) :
    (sectionsFunctor X V).obj (etaTerm X I ι F n) ≅
      ModuleCat.of _ (EtaComplex.term (generatorSection X ι V g) (sectionsComplex X F V) n) :=
  let := preservesFiniteLimits_sectionsFunctor X V
  pullbackSubmoduleIso
    (L := ModuleCat.of (X.presheaf.obj (op V) : Type u)
      (EtaPow.Loc (generatorSection X ι V g) ((sectionsFunctor X V).obj (F.X n))))
    (K := ModuleCat.of (X.presheaf.obj (op V) : Type u)
      (EtaPow.Loc (generatorSection X ι V g) ((sectionsFunctor X V).obj (F.X (n + 1)))))
    ((IsPullback.of_hasPullback (idealPowerMap X I n (F.d n (n + 1)))
      (idealPowerIncl X I ι n (F.X (n + 1)))).map (sectionsFunctor X V))
    (idealPowerSectionsMap X I ι (F.X n) V g hg n)
    (idealPowerSectionsMap X I ι (F.X (n + 1)) V g hg (n + 1))
    (idealPowerSectionsMap X I ι (F.X (n + 1)) V g hg n)
    (EtaPow.fLoc (generatorSection X ι V g)
      ((sectionsFunctor X V).map (F.d n (n + 1))).hom)
    (idealPowerSectionsMap_injective X I ι _ (hF n) V g hg n)
    (idealPowerSectionsMap_injective X I ι _ (hF (n + 1)) V g hg (n + 1))
    (idealPowerSectionsMap_injective X I ι _ (hF (n + 1)) V g hg n)
    (idealPowerSectionsMap_comp_natural X I ι F V g hg n)
    (idealPowerSectionsMap_comp_succ X I ι (F.X (n + 1)) V g hg n)
    _ (etaTerm_sections_range_inf X I ι F V g hg n)

private lemma etaTermSectionsIso_hom (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n, IsIdealTorsionFree X ι (F.X n))
    (V : Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g) (n : ℤ) :
    (etaTermSectionsIso X I ι F hF V g hg n).hom ≫
        ModuleCat.ofHom
          (EtaComplex.term (generatorSection X ι V g) (sectionsComplex X F V) n).subtype =
      (sectionsFunctor X V).map
        (pullback.fst (idealPowerMap X I n (F.d n (n + 1)))
          (idealPowerIncl X I ι n (F.X (n + 1)))) ≫
        idealPowerSectionsHom X I ι (F.X n) V g hg n :=
  let := preservesFiniteLimits_sectionsFunctor X V
  pullbackSubmoduleIso_hom _ _ _ _ _ _ _ _ _ _ _
    (etaTerm_sections_range_inf X I ι F V g hg n)

/-- The degreewise comparisons commute with the differentials: both sides agree after the
monomorphism into the localization, where the square becomes the defining condition of the
fibre product together with the naturality of the ideal-power comparisons. -/
private lemma etaTermSectionsIso_comm (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n, IsIdealTorsionFree X ι (F.X n))
    (V : Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g) (n : ℤ) :
    (etaTermSectionsIso X I ι F hF V g hg n).hom ≫
        (EtaComplex.etaObject (generatorSection X ι V g)
          (sectionsComplex X F V)).d n (n + 1) =
      (sectionsComplex X (etaObj X I ι F hF) V).d n (n + 1) ≫
        (etaTermSectionsIso X I ι F hF V g hg (n + 1)).hom := by
  set E := sectionsFunctor X V
  set C := sectionsComplex X F V
  let p (k : ℤ) := pullback.fst (idealPowerMap X I k (F.d k (k + 1)))
    (idealPowerIncl X I ι k (F.X (k + 1)))
  let q (k : ℤ) := pullback.snd (idealPowerMap X I k (F.d k (k + 1)))
    (idealPowerIncl X I ι k (F.X (k + 1)))
  let a (k : ℤ) := idealPowerSectionsHom X I ι (F.X k) V g hg k
  let v (k : ℤ) := ModuleCat.ofHom
    (EtaComplex.term (generatorSection X ι V g) C k).subtype
  let t := ModuleCat.ofHom
    (EtaPow.fLoc (generatorSection X ι V g) (E.map (F.d n (n + 1))).hom)
  let b := a (n + 1)
  let c := ModuleCat.ofHom
    (idealPowerSectionsMap X I ι (F.X (n + 1)) V g hg n)
  have he (k : ℤ) : (etaTermSectionsIso X I ι F hF V g hg k).hom ≫ v k =
      E.map (p k) ≫ a k :=
    etaTermSectionsIso_hom X I ι F hF V g hg k
  have hd : (EtaComplex.etaObject (generatorSection X ι V g) C).d n (n + 1) ≫ v (n + 1) =
      v n ≫ t := by
    rw [EtaComplex.etaObject_d]
    rfl
  have hn : a n ≫ t = E.map (idealPowerMap X I n (F.d n (n + 1))) ≫ c :=
    ModuleCat.hom_ext (idealPowerSectionsMap_comp_natural X I ι F V g hg n)
  have hs : E.map (idealPowerIncl X I ι n (F.X (n + 1))) ≫ c = b :=
    ModuleCat.hom_ext (idealPowerSectionsMap_comp_succ X I ι (F.X (n + 1)) V g hg n)
  have hEd : (sectionsComplex X (etaObj X I ι F hF) V).d n (n + 1) ≫ E.map (p (n + 1)) =
      E.map (q n) := by
    change E.map ((etaObj X I ι F hF).d n (n + 1)) ≫ E.map (p (n + 1)) = E.map (q n)
    exact (E.map_comp ((etaObj X I ι F hF).d n (n + 1)) (p (n + 1))).symm.trans
      (congrArg (fun k => E.map k) (etaObj_d_fst X I ι F hF n))
  have hmono : Mono (v (n + 1)) := (ModuleCat.mono_iff_injective _).mpr Subtype.val_injective
  apply (cancel_mono (v (n + 1))).mp
  -- Each step is a separately stated `have`: `calc` cannot synthesize the `Trans` instance here,
  -- because the middle term of the chain is type-correct only at `default` transparency.
  have step₁ : ((etaTermSectionsIso X I ι F hF V g hg n).hom ≫
      (EtaComplex.etaObject (generatorSection X ι V g) C).d n (n + 1)) ≫ v (n + 1) =
      (E.map (p n) ≫ a n) ≫ t :=
    (Category.assoc (etaTermSectionsIso X I ι F hF V g hg n).hom
        ((EtaComplex.etaObject (generatorSection X ι V g) C).d n (n + 1)) (v (n + 1))).trans
      ((congrArg (fun k => (etaTermSectionsIso X I ι F hF V g hg n).hom ≫ k) hd).trans
        ((Category.assoc (etaTermSectionsIso X I ι F hF V g hg n).hom (v n) t).symm.trans
          (congrArg (fun k => k ≫ t) (he n))))
  have step₂ : (E.map (p n) ≫ a n) ≫ t = E.map (q n) ≫ b := by
    rw [Category.assoc, hn, ← Category.assoc, ← E.map_comp,
      pullback.condition, E.map_comp, Category.assoc, hs]
  have step₃ : E.map (q n) ≫ b =
      ((sectionsComplex X (etaObj X I ι F hF) V).d n (n + 1) ≫
        (etaTermSectionsIso X I ι F hF V g hg (n + 1)).hom) ≫ v (n + 1) :=
    ((congrArg (fun k => k ≫ a (n + 1)) hEd).symm.trans
        (Category.assoc ((sectionsComplex X (etaObj X I ι F hF) V).d n (n + 1))
          (E.map (p (n + 1))) (a (n + 1)))).trans
      ((congrArg (fun k => (sectionsComplex X (etaObj X I ι F hF) V).d n (n + 1) ≫ k)
          (he (n + 1)).symm).trans
        (Category.assoc ((sectionsComplex X (etaObj X I ι F hF) V).d n (n + 1))
          (etaTermSectionsIso X I ι F hF V g hg (n + 1)).hom (v (n + 1))).symm)
  exact step₁.trans (step₂.trans step₃)

/-- At a section `g` generating the ideal `I` on an open `V`, the sections over `V` of the
décalage `η_I F` form the ordinary décalage `η_f` of the complex of sections over `V`, where `f`
is the image of `g` in `O_X(V)`. -/
@[no_expose]
public noncomputable def etaSectionsIso (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (V : Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g) :
    sectionsComplex X (etaObj X I ι F hF) V ≅
      EtaComplex.etaObject (generatorSection X ι V g) (sectionsComplex X F V) :=
  HomologicalComplex.Hom.isoOfComponents (etaTermSectionsIso X I ι F hF V g hg)
    (fun n m h => by
      subst h
      exact etaTermSectionsIso_comm X I ι F hF V g hg n)

/-- In degree `n`, the comparison of `etaSectionsIso` is the normalized ideal-power map applied
to the first projection of the defining fibre product, read inside the localization. -/
public theorem etaSectionsIso_hom (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (V : Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g) (n : ℤ) :
    (etaSectionsIso X I ι F hF V g hg).hom.f n ≫
        ModuleCat.ofHom (Submodule.subtype
          (EtaComplex.term (generatorSection X ι V g) (sectionsComplex X F V) n)) =
      (sectionsFunctor X V).map
        (pullback.fst (idealPowerMap X I n (F.d n (n + 1)))
          (idealPowerIncl X I ι n (F.X (n + 1)))) ≫
        idealPowerSectionsHom X I ι (F.X n) V g hg n :=
  etaTermSectionsIso_hom X I ι F hF V g hg n

end Stacks.IdealTorsion.Eta

namespace Stacks.Divisors.Eta

variable {Y : Scheme.{u}}

local notation "Oᵧ" => (Stacks.SheafOfModules.Tensor.ringSheaf
  (CategoryTheory.ObjectProperty.FullSubcategory.mk Y.toRingedSpace.presheaf
    Y.toRingedSpace.IsSheaf))

/-- **[Stacks, Tag 0F8M], second assertion.** Let `Y` be a scheme, let `D ⊆ Y` be an effective
Cartier divisor with ideal sheaf `I ⊆ 𝒪_Y`, and let `F^•` be a complex of quasi-coherent
`𝒪_Y`-modules whose terms are `I`-torsion free. If `U ⊆ Y` is affine open and `D ∩ U = V(f)`,
then `η_f(F^•(U))` is canonically isomorphic to `(η_I F^•)(U)`. -/
@[stacks 0F8M "the affine comparison of eta complexes"]
noncomputable def etaSectionsIso (D : Y.IdealSheafData)
    [Stacks.Divisors.IsEffectiveCartierDivisor D]
    (F : CochainComplex (SheafOfModules.{u} Oᵧ) ℤ)
    (_hqc : ∀ n : ℤ, (F.X n).IsQuasicoherent)
    (htf : ∀ n : ℤ,
      Stacks.IdealTorsion.IsIdealTorsionFree Y.toRingedSpace (idealSheafι D) (F.X n))
    (U : Y.Opens) (_hU : IsAffineOpen U)
    (g : (idealSheaf D).val.obj (op U))
    (hg : Stacks.IdealTorsion.GeneratesIdealOn Y.toRingedSpace U g) :
    EtaComplex.etaObject
        (Stacks.IdealTorsion.Eta.generatorSection Y.toRingedSpace (idealSheafι D) U g)
        (Stacks.IdealTorsion.Eta.sectionsComplex Y.toRingedSpace F U) ≅
      Stacks.IdealTorsion.Eta.sectionsComplex Y.toRingedSpace
        (etaObj Y.toRingedSpace (idealSheaf D) (idealSheafι D) F htf) U :=
  (Stacks.IdealTorsion.Eta.etaSectionsIso Y.toRingedSpace (idealSheaf D) (idealSheafι D)
    F htf U g hg).symm

end Stacks.Divisors.Eta

