module

public import StacksFrontier.AlgebraicGeometry.Divisors.EtaDerivedBerthelotOgus
public import StacksFrontier.AlgebraicGeometry.Divisors.EtaDerivedBoundedComplex
public import StacksFrontier.Homology.Eta.Perfect.EtaRestrictScalars

/-!
# The affine comparison of décalages on a bounded complex of finite free modules

Let `R` be a ring, let `D ⊆ Spec R` be an effective Cartier divisor whose ideal in
`A = Γ(Spec R, ⊤)` is generated by `f`, and let `M^•` be a bounded complex of finite free
`A`-modules given in chosen bases.  Then

`Lη_I [M̃^•] ≅ [(η_f M^•)^~]` in `D(𝒪_{Spec R})`,

the derived décalage of the sheafification of `M^•` being the sheafification of the naive
décalage `η_f M^•`.

## Main results

* `Stacks.Divisors.Eta.derivedEtaTildeBoundedComplexIso`: the comparison above.

## Implementation notes

The three inputs are composed with no further work: `Stacks.Divisors.Eta.derivedTildeGammaFactors`
identifies derived sheafification on a complex with the degreewise sheafification,
`Stacks.Divisors.Eta.derivedEtaAffineComparisonOfIdealEqSpan` is the comparison of the two
derived functors, and `Stacks.Eta.DerivedDescent.moduleDerivedEtaToCochainComplexIso` computes
`Lη_f` on `[M^•]` by `η_f M^•`, the terms of `M^•` being finite free and hence `f`-torsion-free.

## References

* [Stacks Project, Tag 0GTV](https://stacks.math.columbia.edu/tag/0GTV)
* [Stacks Project, Tag 0F7R](https://stacks.math.columbia.edu/tag/0F7R)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite

universe u

namespace Stacks.Divisors.Eta

attribute [local instance 10000] HasDerivedCategory.standard

open Stacks.Eta.DerivedDescent (moduleDerivedEta moduleDerivedEtaToCochainComplexIso)

variable (R : CommRingCat.{u}) (D : (Spec R).IdealSheafData)
  [Stacks.Divisors.IsEffectiveCartierDivisor D]

/-- **The affine comparison of décalages on a bounded complex of finite free modules.**  Let
`D ⊆ Spec R` be an effective Cartier divisor whose ideal in `A = Γ(Spec R, ⊤)` is generated by
`f`, and let `M^•` be a bounded complex of finite free `A`-modules in chosen bases.  Then the
derived décalage `Lη_I` of the class of the sheafification of `M^•` is the class of the
sheafification of the naive décalage `η_f M^•`.

This is the second assertion of [Stacks, Tag 0GTV] evaluated at `[M^•]`, composed with
`Stacks.Eta.DerivedDescent.moduleDerivedEtaToCochainComplexIso`, which computes `Lη_f [M^•]` by
`η_f M^•` because the terms of `M^•` are finite free, hence `f`-torsion-free. -/
def derivedEtaTildeBoundedComplexIso (f : GammaTop R)
    (hf : D.ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ = Ideal.span {f})
    (C : BoundedComplex (GammaTop R)) :
    (derivedEtaData D).functor.obj
        (DerivedCategory.Q.obj ((tildeComplexFunctor R).obj C.toCochainComplex)) ≅
      DerivedCategory.Q.obj ((tildeComplexFunctor R).obj
        (EtaComplex.etaObject f C.toCochainComplex)) :=
  (derivedEtaData D).functor.mapIso
      (((derivedTildeGammaFactors R).app C.toCochainComplex).symm) ≪≫
    (derivedEtaAffineComparisonOfIdealEqSpan R D f hf).app
      (DerivedCategory.Q.obj C.toCochainComplex) ≪≫
    (derivedTildeGamma R).mapIso (moduleDerivedEtaToCochainComplexIso f
      (mem_nonZeroDivisors_of_ideal_top_eq_span R D hf) C) ≪≫
    (derivedTildeGammaFactors R).app (EtaComplex.etaObject f C.toCochainComplex)

/-! ### The comparison at the ring of the chart rather than at the global functions -/

/-- The structure map `R ⟶ Γ(Spec R, ⊤)` is bijective: it is the inverse of
`AlgebraicGeometry.Scheme.ΓSpecIso`. -/
theorem bijective_algebraMap_gammaTop : Function.Bijective (algebraMap R (GammaTop R)) :=
  ((Scheme.ΓSpecIso R).symm.commRingCatIsoToRingEquiv).bijective

/-- Sheafifying a complex of `Γ(Spec R, ⊤)`-modules is reading it over `R` and then sheafifying
it there. -/
def tildeComplexFunctorIso (K : CochainComplex (ModuleCat.{u} (GammaTop R)) ℤ) :
    ((AlgebraicGeometry.tilde.functor R).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        (((gammaRestrict R).mapHomologicalComplex (ComplexShape.up ℤ)).obj K) ≅
      (tildeComplexFunctor R).obj K :=
  (Functor.mapHomologicalComplexCompIso
    (Iso.refl (gammaRestrict R ⋙ AlgebraicGeometry.tilde.functor R))
    (ComplexShape.up ℤ)).app K

/-- **The affine comparison of décalages at the ring of an affine chart.**  Let `D ⊆ Spec R` be
an effective Cartier divisor, let `f ∈ R` be such that the ideal of `D` in `Γ(Spec R, ⊤)` is
generated by the image of `f`, and let `M^•` be a bounded complex of finite free `R`-modules in
chosen bases.  Then

`Lη_I [M̃^•] ≅ [(η_f M^•)^~]` in `D(𝒪_{Spec R})`.

This is `Stacks.Divisors.Eta.derivedEtaTildeBoundedComplexIso`, which is stated over the ring
`Γ(Spec R, ⊤)` of global functions, read over `R` itself: the chart's equation `f` and its
complex `M^•` live over `R`, and the two sides are carried across the ring isomorphism
`AlgebraicGeometry.Scheme.ΓSpecIso R` by
`Stacks.Eta.RestrictScalars.boundedComplexRestrictIso` on the left and by
`Stacks.Eta.RestrictScalars.etaObjectBoundedComplexRestrictIso` — the transport of the décalage
along an isomorphism of coefficient rings — on the right. -/
def derivedEtaTildeChartIso (f : R) (M : BoundedComplex R)
    (hf : D.ideal ⟨⊤, isAffineOpen_top (Spec R)⟩ =
      Ideal.span {algebraMap R (GammaTop R) f}) :
    (derivedEtaData D).functor.obj (DerivedCategory.Q.obj
        (((AlgebraicGeometry.tilde.functor R).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj M.toCochainComplex)) ≅
      DerivedCategory.Q.obj
        (((AlgebraicGeometry.tilde.functor R).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj (EtaComplex.etaObject f M.toCochainComplex)) :=
  letI hbij := bijective_algebraMap_gammaTop R
  (derivedEtaData D).functor.mapIso (DerivedCategory.Q.mapIso
      (((AlgebraicGeometry.tilde.functor R).mapHomologicalComplex
          (ComplexShape.up ℤ)).mapIso
          (Stacks.Eta.RestrictScalars.boundedComplexRestrictIso hbij M).symm ≪≫
        tildeComplexFunctorIso R _)) ≪≫
    derivedEtaTildeBoundedComplexIso R D (algebraMap R (GammaTop R) f) hf
      (M.baseChange (algebraMap R (GammaTop R))) ≪≫
    DerivedCategory.Q.mapIso ((tildeComplexFunctorIso R _).symm ≪≫
      ((AlgebraicGeometry.tilde.functor R).mapHomologicalComplex
        (ComplexShape.up ℤ)).mapIso
        (Stacks.Eta.RestrictScalars.etaObjectBoundedComplexRestrictIso hbij f M))

end Stacks.Divisors.Eta

end
