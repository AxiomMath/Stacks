/-!
# The zero scheme of a section of an invertible sheaf

Let `X` be a scheme, `L` an invertible `𝒪_X`-module and `s ∈ Γ(X, L)` a global section. The
*zero scheme* `Z(s)` is the closed subscheme cut out by the image of the dual map
`s : L^{⊗ -1} ⟶ 𝒪_X`. On an affine open `U` that image is the ideal generated by the values of
`s|_U` under the `Γ(X, U)`-linear functionals on `Γ(L, U)`, so the zero scheme is the
quasi-coherent ideal sheaf attached to that family of ideals.

## Main definitions

* `AlgebraicGeometry.zeroScheme`: the ideal-sheaf data of the zero scheme. Its closed subscheme and
  closed immersion are `(zeroScheme X L s).subscheme` and `(zeroScheme X L s).subschemeι`.

## Main results

* `AlgebraicGeometry.evalIdeal_map_of_isLocalizedModule`: for a finitely presented module, the
  ideal of values of the linear functionals at an element commutes with localization.
* `AlgebraicGeometry.module_finitePresentation_sections`: the sections of an invertible module over
  an affine open form a finitely presented module.
* `AlgebraicGeometry.evalIdeal_map_basicOpen`: the defining family of ideals of the zero scheme is
  compatible with restriction to basic opens.
* `AlgebraicGeometry.zeroScheme_ideal`: the defining ideal of the zero scheme on an affine open is
  the ideal generated by the values of `s` under the linear functionals.

## Implementation notes

`zeroScheme` is `Scheme.IdealSheafData.ofIdeals` of the family of ideals on the affine opens, the
largest quasi-coherent ideal sheaf below that family; since the family is compatible with
restriction to basic opens, it is itself the ideal of `zeroScheme` on every affine open.

## References

* [Stacks Project, Tag 02OQ](https://stacks.math.columbia.edu/tag/02OQ)
* [Stacks Project, Tag 0B8M](https://stacks.math.columbia.edu/tag/0B8M)
* [Stacks Project, Tag 01P7](https://stacks.math.columbia.edu/tag/01P7)
-/

@[expose] public section

open CategoryTheory TopologicalSpace Opposite

universe u

namespace AlgebraicGeometry

section Localization

variable {R S M Mₛ : Type u} [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module R M] [AddCommGroup Mₛ] [Module R Mₛ] [Module S Mₛ]
  [IsScalarTower R S Mₛ]

/-- For a finitely presented module `M` and an element `m`, the ideal generated by the values `φ m`
of the `R`-linear functionals on `M` maps onto the corresponding ideal for the localized module. -/
theorem evalIdeal_map_of_isLocalizedModule (T : Submonoid R) [IsLocalization T S]
    (ρ : M →ₗ[R] Mₛ) [IsLocalizedModule T ρ] [Module.FinitePresentation R M] (m : M) :
    Ideal.map (algebraMap R S) (Ideal.span {a : R | ∃ φ : M →ₗ[R] R, a = φ m}) =
      Ideal.span {a : S | ∃ φ : Mₛ →ₗ[S] S, a = φ (ρ m)} := by
  let γ : R →ₗ[R] S := Algebra.linearMap R S
  let F : (M →ₗ[R] R) →ₗ[R] (Mₛ →ₗ[S] S) := IsLocalizedModule.mapExtendScalars T ρ γ S
  let : IsLocalizedModule T F :=
    Module.FinitePresentation.isLocalizedModule_mapExtendScalars T ρ γ S
  apply le_antisymm
  · rw [Ideal.map_span]
    apply Ideal.span_le.2
    rintro y ⟨x, ⟨φ, rfl⟩, rfl⟩
    refine Ideal.subset_span ⟨F φ, ?_⟩
    simp only [F, IsLocalizedModule.mapExtendScalars_apply_apply, IsLocalizedModule.map_apply, γ,
      Algebra.linearMap_apply]
  · apply Ideal.span_le.2
    rintro y ⟨φ, rfl⟩
    obtain ⟨⟨ψ, t⟩, ht⟩ := IsLocalizedModule.surj T F φ
    have heval : algebraMap R S t.1 * φ (ρ m) = algebraMap R S (ψ m) := by
      have h := congrArg (fun k : Mₛ →ₗ[S] S => k (ρ m)) ht
      change (t.1 • φ) (ρ m) = F ψ (ρ m) at h
      simpa [F, IsLocalizedModule.mapExtendScalars_apply_apply, IsLocalizedModule.map_apply,
        Algebra.smul_def, γ] using h
    refine (Ideal.unit_mul_mem_iff_mem _ (IsLocalization.map_units S t)).1 ?_
    rw [heval]
    exact Ideal.mem_map_of_mem (algebraMap R S) (Ideal.subset_span ⟨ψ, rfl⟩)

end Localization

section SchemeLocal

variable {X : Scheme.{u}}

variable (L : X.Modules)
  [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]

/-- An invertible module is invertible for the presheaf-level structure sheaf of rings. -/
private theorem isInvertible_presheaf : Stacks.SheafOfModules.IsInvertible X.presheaf
    (structureSheafRing X.toRingedSpace).property L :=
  (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry X.presheaf
    (structureSheafRing X.toRingedSpace).property L).2 ‹_›

include L in
/-- An invertible module on a scheme is quasi-coherent. -/
theorem isQuasicoherent_of_isInvertible : L.IsQuasicoherent :=
  have := isInvertible_presheaf L
  Stacks.SheafOfModules.Scheme.isQuasicoherent_of_isInvertible X L

include L in
/-- Every point of an affine open has a basic open neighbourhood inside it on which the sections of
an invertible module are free of rank one. -/
theorem exists_basicOpen_linearEquiv (U : X.affineOpens) (x : X) (hx : x ∈ U.1) :
    ∃ g : Γ(X, U.1), x ∈ X.basicOpen g ∧ X.basicOpen g ≤ U.1 ∧
      Nonempty (Γ(L, X.basicOpen g) ≃ₗ[Γ(X, X.basicOpen g)] Γ(X, X.basicOpen g)) := by
  have := isInvertible_presheaf L
  obtain ⟨W, hxW, hW⟩ :=
    Stacks.SheafOfModules.Scheme.exists_nonempty_linearEquiv_of_isInvertible X L x
  obtain ⟨g, hgle, hxg⟩ := U.2.exists_basicOpen_le (V := U.1 ⊓ W) ⟨x, ⟨hx, hxW⟩⟩ hx
  exact ⟨g, hxg, hgle.trans inf_le_left, hW _ (hgle.trans inf_le_right)⟩

/-- Restriction of the sections of an invertible module from an affine open to a basic open is a
localization at the powers of the function. -/
private theorem exists_isLocalizedModule_restrict (U : X.affineOpens) (f : Γ(X, U.1)) :
    ∃ (_ : Module Γ(X, U.1) Γ(L, X.basicOpen f))
      (_ : IsScalarTower Γ(X, U.1) Γ(X, X.basicOpen f) Γ(L, X.basicOpen f))
      (ρ : Γ(L, U.1) →ₗ[Γ(X, U.1)] Γ(L, X.basicOpen f)),
      (∀ a, ρ a = L.presheaf.map (homOfLE (X.basicOpen_le f)).op a) ∧
        IsLocalizedModule (Submonoid.powers f) ρ := by
  have := isQuasicoherent_of_isInvertible L
  let : Module Γ(X, U.1) Γ(L, X.basicOpen f) :=
    Module.compHom _ (algebraMap Γ(X, U.1) Γ(X, X.basicOpen f))
  have : IsScalarTower Γ(X, U.1) Γ(X, X.basicOpen f) Γ(L, X.basicOpen f) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let ρ : Γ(L, U.1) →ₗ[Γ(X, U.1)] Γ(L, X.basicOpen f) :=
    { toFun a := L.presheaf.map (homOfLE (X.basicOpen_le f)).op a
      map_add' a b := map_add _ a b
      map_smul' r a := Scheme.Modules.map_smul L (homOfLE (X.basicOpen_le f)) r a }
  exact ⟨_, this, ρ, fun _ => rfl, isLocalizedModule_restrict_basicOpen L U.2 f ρ fun _ => rfl⟩

include L in
/-- The sections of an invertible module over an affine open form a finitely presented module. -/
theorem module_finitePresentation_sections (U : X.affineOpens) :
    Module.FinitePresentation Γ(X, U.1) Γ(L, U.1) := by
  classical
  have := isQuasicoherent_of_isInvertible L
  choose gg hmem _hle he using fun x : U.1 => exists_basicOpen_linearEquiv L U x.1 x.2
  have hspan : Ideal.span (Set.range gg) = ⊤ := by
    rw [← U.2.self_le_iSup_basicOpen_iff]
    intro y hy
    exact TopologicalSpace.Opens.mem_iSup.mpr
      ⟨⟨gg ⟨y, hy⟩, Set.mem_range_self _⟩, hmem ⟨y, hy⟩⟩
  choose _ _ ϕ _ _ using fun g : Set.range gg =>
    exists_isLocalizedModule_restrict L U (g : Γ(X, U.1))
  let : ∀ g : Set.range gg, IsLocalization.Away (g : Γ(X, U.1))
      Γ(X, X.basicOpen (g : Γ(X, U.1))) := fun g => U.2.isLocalization_basicOpen _
  refine Module.FinitePresentation.of_localizationSpan' (Set.range gg) hspan
    (Mₚ := fun g => Γ(L, X.basicOpen (g : Γ(X, U.1))))
    (Rₚ := fun g => Γ(X, X.basicOpen (g : Γ(X, U.1)))) ϕ ?_
  rintro ⟨-, x, rfl⟩
  exact Module.FinitePresentation.of_equiv (he x).some.symm

include L in
/-- The defining family of the zero scheme is compatible with restriction to basic opens: the ideal
generated by the values of the linear functionals at `s` over an affine open `U` maps, under
restriction to a basic open `D(f) ⊆ U`, onto the corresponding ideal over `D(f)`. -/
theorem evalIdeal_map_basicOpen (s : Γ(L, ⊤)) (U : X.affineOpens) (f : Γ(X, U.1)) :
    Ideal.map (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom
        (Ideal.span {a : Γ(X, U.1) | ∃ φ : Γ(L, U.1) →ₗ[Γ(X, U.1)] Γ(X, U.1),
          a = φ (L.presheaf.map (homOfLE le_top).op s)}) =
      Ideal.span {a : Γ(X, X.basicOpen f) |
        ∃ φ : Γ(L, X.basicOpen f) →ₗ[Γ(X, X.basicOpen f)] Γ(X, X.basicOpen f),
          a = φ (L.presheaf.map (homOfLE le_top).op s)} := by
  have := isQuasicoherent_of_isInvertible L
  have : IsLocalization (Submonoid.powers f) Γ(X, X.basicOpen f) :=
    U.2.isLocalization_basicOpen f
  obtain ⟨_, _, ρ, hρ, _⟩ := exists_isLocalizedModule_restrict L U f
  have : Module.FinitePresentation Γ(X, U.1) Γ(L, U.1) :=
    module_finitePresentation_sections L U
  have hres : ρ (L.presheaf.map (homOfLE le_top).op s) =
      L.presheaf.map (homOfLE (le_top : X.basicOpen f ≤ ⊤)).op s := by
    rw [hρ, ← ConcreteCategory.comp_apply, ← Functor.map_comp]
    congr 2
  have h := evalIdeal_map_of_isLocalizedModule (S := Γ(X, X.basicOpen f))
    (Submonoid.powers f) ρ (L.presheaf.map (homOfLE le_top).op s)
  rw [hres] at h
  exact h

end SchemeLocal

/-- The zero scheme of a global section `s` of an invertible module `L`, as a quasi-coherent sheaf
of ideals: on an affine open it is the image of the dual map `s : L^{⊗ -1} ⟶ 𝒪_X`, i.e. the ideal
generated by the values of `s` under the linear functionals on the sections of `L`. -/
@[stacks 02OQ "the closed subscheme construction"]
noncomputable abbrev zeroScheme (X : Scheme.{u}) (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : Γ(L, ⊤)) : X.IdealSheafData :=
  Scheme.IdealSheafData.ofIdeals (fun U =>
    Ideal.span {a : Γ(X, U.1) | ∃ φ : Γ(L, U.1) →ₗ[Γ(X, U.1)] Γ(X, U.1),
      a = φ (L.presheaf.map (homOfLE le_top).op s)})

/-- The defining ideal of the zero scheme on an affine open is the ideal generated by the values of
the restricted section under the local linear functionals. -/
@[stacks 02OQ "the defining ideal"]
theorem zeroScheme_ideal (X : Scheme.{u}) (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : Γ(L, ⊤)) (U : X.affineOpens) :
    (zeroScheme X L s).ideal U =
      Ideal.span {a : Γ(X, U.1) | ∃ φ : Γ(L, U.1) →ₗ[Γ(X, U.1)] Γ(X, U.1),
        a = φ (L.presheaf.map (homOfLE le_top).op s)} := by
  let A : ∀ V : X.affineOpens, Ideal Γ(X, V.1) := fun V =>
    Ideal.span {a : Γ(X, V.1) | ∃ φ : Γ(L, V.1) →ₗ[Γ(X, V.1)] Γ(X, V.1),
      a = φ (L.presheaf.map (homOfLE le_top).op s)}
  let J : X.IdealSheafData :=
    { ideal := A
      map_ideal_basicOpen := fun V f => evalIdeal_map_basicOpen L s V f }
  exact congrArg (fun I : X.IdealSheafData => I.ideal U)
    (Scheme.IdealSheafData.ofIdeals_ideal J)

end AlgebraicGeometry

end
