module

public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Constructions.ProjTwistSectionRing
public import StacksFrontier.AlgebraicGeometry.Descent.EffectiveEpi.QuasicoherentSections

/-!
# The homogeneous ideal of a closed subscheme of `Proj`

Let `S = ⨁_{n ≥ 0} 𝒮 n` be a nonnegatively graded ring and let `i : Z ⟶ Proj 𝒮` be a closed
immersion. A homogeneous element `b` of degree `n` determines a global section of the twist
`𝒪_{Proj 𝒮}(n)`, and `b` is declared to belong to the ideal of `Z` when that section pulls back
to zero on `Z`. The ideal of `Z` is the ideal generated by all such elements; it is the graded
ideal `I(Z) = Ker(S → ⨁_{n ≥ 0} Γ(Z, 𝒪_Z(n)))` of the source.

## Main definitions

* `AlgebraicGeometry.ProjectiveSpectrum.Proj.idealOfClosedSubscheme`: the ideal of a closed
  subscheme of a projective spectrum.

## Main results

* `AlgebraicGeometry.ProjectiveSpectrum.Proj.idealOfClosedSubscheme_isHomogeneous`: the ideal of
  a closed subscheme is graded.
* `AlgebraicGeometry.ProjectiveSpectrum.Proj.mem_idealOfClosedSubscheme`: a homogeneous element
  whose twisted section pulls back to zero lies in the ideal.

## Implementation notes

The ideal is generated by the homogeneous elements whose canonical twisted sections pull back to
zero, so that it is visibly graded.

The pullback map on global sections is `AlgebraicGeometry.pullbackGlobalSections`, the canonical
map of Tag 0EUA.

## References

* [Stacks Project, Tag 0BXK](https://stacks.math.columbia.edu/tag/0BXK)
-/

@[expose] public noncomputable section

namespace AlgebraicGeometry.ProjectiveSpectrum.Proj

open AlgebraicGeometry CategoryTheory Opposite

universe u w

variable {S : Type u} {σ : Type w} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

/-- The ideal of a closed subscheme of `Proj 𝒮`, generated by the homogeneous elements whose
canonical twisted sections vanish after pullback to the subscheme. -/
@[stacks 0BXK "ideal_of_a_closed_subscheme"]
noncomputable def idealOfClosedSubscheme {Z : Scheme.{u}}
    (i : Z ⟶ Proj 𝒮) [IsClosedImmersion i] : Ideal S :=
  Ideal.span {a : S | ∃ (n : ℕ) (b : 𝒮 n), (b : S) = a ∧
    pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ)) (degreeSection 𝒮 n b) = 0}

/-- A homogeneous element of degree `n` whose section of `𝒪(n)` pulls back to zero on `Z` lies
in the ideal of `Z`. -/
theorem mem_idealOfClosedSubscheme {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) [IsClosedImmersion i]
    (n : ℕ) (b : 𝒮 n)
    (hb : pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ)) (degreeSection 𝒮 n b) = 0) :
    (b : S) ∈ idealOfClosedSubscheme 𝒮 i :=
  Ideal.subset_span ⟨n, b, rfl, hb⟩

/-- The ideal of a closed subscheme is homogeneous: it is generated by homogeneous elements. -/
@[stacks 0BXK "ideal_of_a_closed_subscheme"]
theorem idealOfClosedSubscheme_isHomogeneous {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮)
    [IsClosedImmersion i] :
    (idealOfClosedSubscheme 𝒮 i).IsHomogeneous 𝒮 :=
  Ideal.homogeneous_span 𝒮 _ <| by
    rintro a ⟨n, b, rfl, -⟩
    exact ⟨n, b.2⟩

end AlgebraicGeometry.ProjectiveSpectrum.Proj

end
