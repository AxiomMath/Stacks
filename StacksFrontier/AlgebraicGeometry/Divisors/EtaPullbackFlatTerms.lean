module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EtaSheafPullbackCompositionQuasiIso
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FlatModulePullback
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FlatIdealTorsionFree
public import StacksFrontier.AlgebraicGeometry.Divisors.IdealSheafPullbackComap
public import StacksFrontier.AlgebraicGeometry.Divisors.EtaDerivedUnconditional
public import StacksFrontier.AlgebraicGeometry.Divisors.EtaGoodBaseChange.Comparison

/-!
# The comparison of décalages under a pullback of an effective Cartier divisor, at a complex of
flat modules

Let `h : Y ⟶ X` be a morphism of schemes and `D ⊆ X` an effective Cartier divisor whose pullback
`E = h^{-1}D` is defined, with ideal sheaves `ℐ_D` and `ℐ_E`.  For a complex `P^•` of flat
`𝒪_X`-modules this file specializes the chain-level and derived comparisons of décalages

`h^*(η_{ℐ_D} P^•) ⟶ η_{ℐ_E}(h^* P^•)`,  `Lh^*[η_{ℐ_D} P^•] ⟶ [η_{ℐ_E}(h^* P^•)]`

to the ideal sheaves of the two divisors, identified by
`Stacks.Divisors.pullbackIdealSheafComapIso`.  No flatness of `h` is assumed: a flat module is
torsion free for the ideal sheaf of any effective Cartier divisor, and the pullback of a flat
module is flat, so every torsion-freeness hypothesis is discharged by the flatness of the terms
of `P^•`.

## Main definitions

* `Stacks.Divisors.Eta.divisorPullbackEtaMap`: the chain-level comparison.
* `Stacks.Divisors.Eta.divisorPullbackEtaKFlatComparison`: the derived comparison.

## Main results

* `Stacks.Divisors.Eta.isIdealTorsionFree_of_isFlat`: a flat `𝒪_X`-module is
  `ℐ_D`-torsion free.
-/

@[expose] public noncomputable section

attribute [local instance_reducible] TopCat.Sheaf CategoryTheory.sheafCompose
  AlgebraicGeometry.SheafedSpace.sheaf Stacks.SheafOfModules.TensorSheafification.structureSheaf

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

open Stacks.RingedSpace (pullbackFunctor)
open Stacks.IdealTorsion (IsIdealTorsionFree)
open Stacks.IdealTorsion.Eta (etaObj pullbackComplex pullbackIdealIncl)

universe u

namespace Stacks.Divisors.Eta

/-- **A flat module is torsion free for the ideal sheaf of an effective Cartier divisor.**  The
ideal sheaf is invertible, hence locally generated by a nonzerodivisor since the stalks of a
scheme are local rings, and a flat module has no torsion for such an ideal (Stacks 0GT5). -/
theorem isIdealTorsionFree_of_isFlat {X : Scheme.{u}} (D : X.IdealSheafData)
    [hD : Stacks.Divisors.IsEffectiveCartierDivisor D]
    (F : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.toRingedSpace.sheaf))
    (hF : AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := X.toRingedSpace.sheaf) F) :
    IsIdealTorsionFree X.toRingedSpace (idealSheafι D) F :=
  @Stacks.IdealTorsion.isIdealTorsionFree_of_isFlat X.toRingedSpace _
    (idealSheafι D) (mono_idealSheafι D)
    (@Stacks.IdealTorsion.isLocallyGeneratedByRegular_of_isInvertible X.toRingedSpace
      inferInstance _ (idealSheafι D) (mono_idealSheafι D) (isInvertible_idealSheaf D)) F hF

variable {X Y : Scheme.{u}} (h : Y ⟶ X) (D : X.IdealSheafData)
  [Stacks.Divisors.IsEffectiveCartierDivisor D] [hD : Stacks.Divisors.IsPullbackDefined h D]

variable (P : CochainComplex
    (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.toRingedSpace.sheaf)) ℤ)
  (hP : ∀ n : ℤ, AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u}
    (O := X.toRingedSpace.sheaf) (P.X n))

include hP

/-- The terms of the pullback of a complex of flat modules are flat. -/
theorem isFlat_pullbackComplex_X (n : ℤ) :
    AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := Y.toRingedSpace.sheaf)
      ((pullbackComplex h.toLRSHom.toShHom P).X n) :=
  RingedSpaceModuleAdjunction.isFlat_modulePullback h.toLRSHom.toShHom (P.X n) (hP n)

/-- The terms of a complex of flat modules are `ℐ_D`-torsion free. -/
theorem isIdealTorsionFree_X (n : ℤ) :
    IsIdealTorsionFree X.toRingedSpace (idealSheafι D) (P.X n) :=
  isIdealTorsionFree_of_isFlat D (P.X n) (hP n)

omit [Stacks.Divisors.IsEffectiveCartierDivisor D] in
/-- The terms of the pullback of a complex of flat modules are `ℐ_{h^{-1}D}`-torsion free. -/
theorem isIdealTorsionFree_pullbackComplex_X (n : ℤ) :
    IsIdealTorsionFree Y.toRingedSpace (idealSheafι (D.comap h))
      ((pullbackComplex h.toLRSHom.toShHom P).X n) :=
  isIdealTorsionFree_of_isFlat (D.comap h) _ (isFlat_pullbackComplex_X h P hP n)

/-- The terms of the pullback of a complex of flat modules are torsion free for the pulled-back
ideal `h^*ℐ_D ⟶ 𝒪_Y`. -/
theorem isIdealTorsionFree_pullbackComplex_X' (n : ℤ) :
    IsIdealTorsionFree Y.toRingedSpace
      (pullbackIdealIncl h.toLRSHom.toShHom (idealSheaf D) (idealSheafι D))
      ((pullbackComplex h.toLRSHom.toShHom P).X n) :=
  (Stacks.IdealTorsion.Eta.IdealCongr.isIdealTorsionFree_congr Y.toRingedSpace
    (pullbackIdealIncl h.toLRSHom.toShHom (idealSheaf D) (idealSheafι D))
    (idealSheafι (D.comap h)) (Stacks.Divisors.pullbackIdealSheafComapIso h D hD)
    (Stacks.Divisors.pullbackIdealSheafComapIso_hom_comp_idealSheafι h D hD) _).mpr
    (isIdealTorsionFree_pullbackComplex_X h D P hP n)

/-- **The chain-level comparison of décalages for an effective Cartier divisor**, at a complex of
flat modules: `h^*(η_{ℐ_D} P^•) ⟶ η_{ℐ_{h^{-1}D}}(h^* P^•)`. -/
def divisorPullbackEtaMap :
    pullbackComplex h.toLRSHom.toShHom
        (@etaObj X.toRingedSpace (idealSheaf D) (idealSheafι D) (mono_idealSheafι D)
          (isInvertible_idealSheaf D) P (isIdealTorsionFree_X D P hP)) ⟶
      @etaObj Y.toRingedSpace (idealSheaf (D.comap h)) (idealSheafι (D.comap h))
        (mono_idealSheafι (D.comap h)) (isInvertible_idealSheaf (D.comap h))
        (pullbackComplex h.toLRSHom.toShHom P) (isIdealTorsionFree_pullbackComplex_X h D P hP) :=
  @Stacks.IdealTorsion.Eta.transportedPullbackEtaMap _ _ h.toLRSHom.toShHom
    (idealSheaf D) (idealSheafι D) (isInvertible_idealSheaf D)
    (idealSheaf (D.comap h)) (idealSheafι (D.comap h)) (isInvertible_idealSheaf (D.comap h))
    (Stacks.Divisors.pullbackIdealSheafComapIso h D hD) (mono_idealSheafι D)
    (mono_pullbackIdealIncl_of_isPullbackDefined h D inferInstance) (mono_idealSheafι (D.comap h))
    (Stacks.Divisors.pullbackIdealSheafComapIso_hom_comp_idealSheafι h D hD) P
    (isIdealTorsionFree_X D P hP) (isIdealTorsionFree_pullbackComplex_X' h D P hP)
    (isIdealTorsionFree_pullbackComplex_X h D P hP)

/-- The standard model of the derived category of modules on a ringed space, at the spelling of
the structure sheaf used by the décalage files, pinned at a fixed universe so that instance
search does not have to solve for it.  It is not a global instance; the files of the comparison
of décalages under a pullback declare it a local one. -/
@[instance_reducible]
def etaHasDerivedCategory (Z : RingedSpace.{u}) :
    HasDerivedCategory.{u + 1}
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Z.sheaf)) :=
  HasDerivedCategory.standard _

attribute [local instance] etaHasDerivedCategory

/-- **The derived comparison of décalages for an effective Cartier divisor**, at a complex of
flat modules: `Lh^*[η_{ℐ_D} P^•] ⟶ [η_{ℐ_{h^{-1}D}}(h^* P^•)]`. -/
def divisorPullbackEtaKFlatComparison :
    (Stacks.IdealTorsion.Eta.etaDerivedPullback h.toLRSHom.toShHom).obj
        (DerivedCategory.Q.obj (@etaObj X.toRingedSpace (idealSheaf D) (idealSheafι D)
          (mono_idealSheafι D) (isInvertible_idealSheaf D) P (isIdealTorsionFree_X D P hP))) ⟶
      DerivedCategory.Q.obj (@etaObj Y.toRingedSpace (idealSheaf (D.comap h))
        (idealSheafι (D.comap h)) (mono_idealSheafι (D.comap h))
        (isInvertible_idealSheaf (D.comap h)) (pullbackComplex h.toLRSHom.toShHom P)
        (isIdealTorsionFree_pullbackComplex_X h D P hP)) :=
  @Stacks.IdealTorsion.Eta.pullbackEtaKFlatComparison _ _ h.toLRSHom.toShHom
    (idealSheaf D) (idealSheafι D) (isInvertible_idealSheaf D)
    (idealSheaf (D.comap h)) (idealSheafι (D.comap h)) (isInvertible_idealSheaf (D.comap h))
    (Stacks.Divisors.pullbackIdealSheafComapIso h D hD) (mono_idealSheafι D)
    (mono_pullbackIdealIncl_of_isPullbackDefined h D inferInstance) (mono_idealSheafι (D.comap h))
    (Stacks.Divisors.pullbackIdealSheafComapIso_hom_comp_idealSheafι h D hD) P
    (isIdealTorsionFree_X D P hP) (isIdealTorsionFree_pullbackComplex_X' h D P hP)
    (isIdealTorsionFree_pullbackComplex_X h D P hP)

/-- **The derived comparison is an isomorphism iff the chain-level comparison, precomposed with a
K-flat resolution of the décalage, is a quasi-isomorphism**: the specialization of
`Stacks.IdealTorsion.Eta.isIso_pullbackEtaKFlatComparison_iff`. -/
theorem isIso_divisorPullbackEtaKFlatComparison_iff
    {R : CochainComplex
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.toRingedSpace.sheaf)) ℤ}
    (r : R ⟶ @etaObj X.toRingedSpace (idealSheaf D) (idealSheafι D) (mono_idealSheafι D)
      (isInvertible_idealSheaf D) P (isIdealTorsionFree_X D P hP)) [QuasiIso r]
    (hR : Stacks.Cohomology.KFlatDerivedPullback.KFlatComplex X.toRingedSpace R) :
    IsIso (divisorPullbackEtaKFlatComparison h D P hP) ↔
      QuasiIso (Stacks.IdealTorsion.Eta.pullbackComplexMap h.toLRSHom.toShHom r ≫
        divisorPullbackEtaMap h D P hP) :=
  @Stacks.IdealTorsion.Eta.isIso_pullbackEtaKFlatComparison_iff _ _ h.toLRSHom.toShHom
    (idealSheaf D) (idealSheafι D) (isInvertible_idealSheaf D)
    (idealSheaf (D.comap h)) (idealSheafι (D.comap h)) (isInvertible_idealSheaf (D.comap h))
    (Stacks.Divisors.pullbackIdealSheafComapIso h D hD) (mono_idealSheafι D)
    (mono_pullbackIdealIncl_of_isPullbackDefined h D inferInstance) (mono_idealSheafι (D.comap h))
    (Stacks.Divisors.pullbackIdealSheafComapIso_hom_comp_idealSheafι h D hD) P
    (isIdealTorsionFree_X D P hP) (isIdealTorsionFree_pullbackComplex_X' h D P hP)
    (isIdealTorsionFree_pullbackComplex_X h D P hP) R r _ hR

omit hP in
/-- **Being an isomorphism transfers along a quasi-isomorphism of K-flat complexes of flat
modules**: the specialization of
`Stacks.IdealTorsion.Eta.isIso_pullbackEtaKFlatComparison_iff_of_quasiIso`. -/
theorem isIso_divisorPullbackEtaKFlatComparison_iff_of_quasiIso
    {P₁ P₂ : CochainComplex
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.toRingedSpace.sheaf)) ℤ}
    (u : P₁ ⟶ P₂) [QuasiIso u]
    (h₁ : ∀ n : ℤ, AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u}
      (O := X.toRingedSpace.sheaf) (P₁.X n))
    (h₂ : ∀ n : ℤ, AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u}
      (O := X.toRingedSpace.sheaf) (P₂.X n))
    (hk₁ : Stacks.Cohomology.KFlatDerivedPullback.KFlatComplex X.toRingedSpace P₁)
    (hk₂ : Stacks.Cohomology.KFlatDerivedPullback.KFlatComplex X.toRingedSpace P₂) :
    IsIso (divisorPullbackEtaKFlatComparison h D P₁ h₁) ↔
      IsIso (divisorPullbackEtaKFlatComparison h D P₂ h₂) :=
  @Stacks.IdealTorsion.Eta.isIso_pullbackEtaKFlatComparison_iff_of_quasiIso _ _
    h.toLRSHom.toShHom
    (idealSheaf D) (idealSheafι D) (isInvertible_idealSheaf D)
    (idealSheaf (D.comap h)) (idealSheafι (D.comap h)) (isInvertible_idealSheaf (D.comap h))
    (Stacks.Divisors.pullbackIdealSheafComapIso h D hD) (mono_idealSheafι D)
    (mono_pullbackIdealIncl_of_isPullbackDefined h D inferInstance) (mono_idealSheafι (D.comap h))
    (Stacks.Divisors.pullbackIdealSheafComapIso_hom_comp_idealSheafι h D hD) P₁ P₂ u
    (isIdealTorsionFree_X D P₁ h₁) (isIdealTorsionFree_pullbackComplex_X' h D P₁ h₁)
    (isIdealTorsionFree_pullbackComplex_X h D P₁ h₁)
    (isIdealTorsionFree_X D P₂ h₂) (isIdealTorsionFree_pullbackComplex_X' h D P₂ h₂)
    (isIdealTorsionFree_pullbackComplex_X h D P₂ h₂) _ hk₁ hk₂

end Stacks.Divisors.Eta

end
