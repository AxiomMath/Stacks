module

public import StacksFrontier.AlgebraicGeometry.Divisors.EtaAffineComparison
public import StacksFrontier.Homology.Eta.Perfect.TermInclusionSplit
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EtaSheafQuasiIso

/-!
# Sections of the décalage over an open on which the complex of sections is a matrix complex

Let `X` be a ringed space, `I ⊆ 𝒪_X` an invertible ideal sheaf, `F^•` a complex of `I`-torsion
free `𝒪_X`-modules and `V ⊆ X` an open over which `I` is generated by a section with image
`f ∈ 𝒪_X(V)` a nonzerodivisor.  Suppose the complex of sections `F^•(V)` is isomorphic to a
bounded complex `C^•` of finite free modules whose determinantal ideal `I_n(C^•, f)` is
principal.  Then, by Stacks 0F7W read through the identification of the sections of the
décalage with the décalage of the sections (Stacks 0F8M):

* the module `(η_I F^•)^n(V)` is finite projective of rank `rank Cⁿ`;
* the map `(η_I F^•)^n(V) ⟶ (I^n ⊗ F^n)(V) × (I^{n+1} ⊗ F^{n+1})(V)` given by the two projections
  of the fibre product defining `(η_I F^•)^n` has a linear retraction.

## Main results

* `Stacks.IdealTorsion.Eta.finite_projective_rankAtStalk_sections_etaTerm`.
* `Stacks.IdealTorsion.Eta.exists_retraction_sections_etaFst_etaSnd`.
-/

@[expose] public noncomputable section

attribute [local instance_reducible] TopCat.Sheaf CategoryTheory.sheafCompose
  AlgebraicGeometry.SheafedSpace.sheaf Stacks.SheafOfModules.TensorSheafification.structureSheaf

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open Stacks.IdealTorsion (IsIdealTorsionFree GeneratesIdealOn)

universe u

namespace Stacks.IdealTorsion.Eta

variable (X : RingedSpace.{u, u})
  (I : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf
    (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)))
  (ι : I ⟶ SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf
    (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))) [Mono ι]
  [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Stacks.SheafOfModules.Tensor.ringSheaf
    (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).property I]
  (F : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf
    (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))) ℤ)
  (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
  (V : TopologicalSpace.Opens X) (g : I.val.obj (op V)) (hg : GeneratesIdealOn X V g)
  (C : BoundedComplex (X.presheaf.obj (op V) : Type u))
  (e : sectionsComplex X F V ≅ C.toCochainComplex)
  (hreg : IsRegular (generatorSection X ι V g)) (n : ℤ)
  (hI : (idealI C (generatorSection X ι V g) n).IsPrincipal)

/-- The sections over `V` of the degree-`n` term of the décalage, identified with the
degree-`n` term of the décalage of the sections. -/
def sectionsEtaTermEquiv :
    (sectionsFunctor X V).obj (etaTerm X I ι F n) ≃ₗ[(X.presheaf.obj (op V) : Type u)]
      EtaComplex.term (generatorSection X ι V g) (sectionsComplex X F V) n :=
  ((HomologicalComplex.eval _ _ n).mapIso (etaSectionsIso X I ι F hF V g hg)).toLinearEquiv

include hF hg e hreg hI in
/-- **The sections of a term of the décalage are finite projective of rank `rank Cⁿ`.** -/
theorem finite_projective_rankAtStalk_sections_etaTerm :
    ∃ (_ : Module.Finite (X.presheaf.obj (op V) : Type u)
        ((sectionsFunctor X V).obj (etaTerm X I ι F n)))
      (_ : Module.Projective (X.presheaf.obj (op V) : Type u)
        ((sectionsFunctor X V).obj (etaTerm X I ι F n))),
      Module.rankAtStalk (R := (X.presheaf.obj (op V) : Type u))
        ((sectionsFunctor X V).obj (etaTerm X I ι F n)) = fun _ => C.rank n := by
  obtain ⟨hfin, hproj, hrank⟩ := EtaComplex.finite_projective_rankAtStalk_term_of_iso
    (generatorSection X ι V g) (sectionsComplex X F V) C e hreg n hI
  let ε := sectionsEtaTermEquiv X I ι F hF V g hg n
  exact ⟨Module.Finite.equiv ε.symm, Module.Projective.of_equiv ε.symm,
    (Module.rankAtStalk_eq_of_equiv ε).trans hrank⟩

/-- The comparison of the sections of an ideal power with the corresponding power submodule of
the localization, corestricted to its image. -/
def idealPowerSectionsCodRestrict (M : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))) (k : ℤ) :
    (sectionsFunctor X V).obj (idealPowerTerm X I k M) →ₗ[(X.presheaf.obj (op V) : Type u)]
      EtaPow.fpowSub (generatorSection X ι V g) ((sectionsFunctor X V).obj M) k :=
  (idealPowerSectionsMap X I ι M V g hg k).codRestrict _ (fun z => by
    rw [← idealPowerSectionsMap_range X I ι M V g hg k]; exact ⟨z, rfl⟩)

/-- The two projections of the fibre product defining a term of the décalage, on sections. -/
def sectionsEtaFstSnd :
    (sectionsFunctor X V).obj (etaTerm X I ι F n) →ₗ[(X.presheaf.obj (op V) : Type u)]
      (sectionsFunctor X V).obj (idealPowerTerm X I n (F.X n)) ×
        (sectionsFunctor X V).obj (idealPowerTerm X I (n + 1) (F.X (n + 1))) :=
  LinearMap.prod ((sectionsFunctor X V).map (etaFst X I ι F n)).hom
    ((sectionsFunctor X V).map (etaSnd X I ι F n)).hom

/-- The projections on sections, read in the power submodules, are the graph inclusion. -/
theorem idealPowerSectionsCodRestrict_comp_sectionsEtaFstSnd
    (x : (sectionsFunctor X V).obj (etaTerm X I ι F n)) :
    ((idealPowerSectionsCodRestrict X I ι V g hg (F.X n) n).prodMap
        (idealPowerSectionsCodRestrict X I ι V g hg (F.X (n + 1)) (n + 1)))
        (sectionsEtaFstSnd X I ι F V n x) =
      EtaComplex.termInclusion (generatorSection X ι V g) (sectionsComplex X F V) n
        (sectionsEtaTermEquiv X I ι F hF V g hg n x) := by
  have h1 : idealPowerSectionsMap X I ι (F.X n) V g hg n
      (((sectionsFunctor X V).map (etaFst X I ι F n)).hom x) =
        ((sectionsEtaTermEquiv X I ι F hF V g hg n x :
          EtaComplex.term (generatorSection X ι V g) (sectionsComplex X F V) n) :
          EtaPow.Loc (generatorSection X ι V g) ((sectionsComplex X F V).X n)) :=
    (ConcreteCategory.congr_hom (etaSectionsIso_hom X I ι F hF V g hg n) x).symm
  refine Prod.ext (Subtype.ext h1) (Subtype.ext ?_)
  -- the second projection
  have hcond := congrArg (fun k => ((sectionsFunctor X V).map k).hom x)
    (pullback.condition (f := idealPowerMap X I n (F.d n (n + 1)))
      (g := idealPowerIncl X I ι n (F.X (n + 1))))
  simp only [Functor.map_comp, ModuleCat.hom_comp, LinearMap.comp_apply] at hcond
  change idealPowerSectionsMap X I ι (F.X (n + 1)) V g hg (n + 1)
      (((sectionsFunctor X V).map (etaSnd X I ι F n)).hom x) =
    EtaPow.fLoc (generatorSection X ι V g) ((sectionsComplex X F V).d n (n + 1)).hom
      ((sectionsEtaTermEquiv X I ι F hF V g hg n x :
        EtaComplex.term (generatorSection X ι V g) (sectionsComplex X F V) n) :
        EtaPow.Loc (generatorSection X ι V g) ((sectionsComplex X F V).X n))
  rw [← h1, ← idealPowerSectionsMap_succ X I ι (F.X (n + 1)) V g hg n]
  change _ = EtaPow.fLoc (generatorSection X ι V g)
    ((sectionsFunctor X V).map (F.d n (n + 1))).hom _
  rw [idealPowerSectionsMap_natural X I ι (F.d n (n + 1)) V g hg n]
  exact congrArg (idealPowerSectionsMap X I ι (F.X (n + 1)) V g hg n) hcond.symm

include hF hg e hreg hI in
/-- **The projections of the fibre product defining a term of the décalage have a retraction on
sections over `V`.** -/
theorem exists_retraction_sectionsEtaFstSnd :
    ∃ ρ : (sectionsFunctor X V).obj (idealPowerTerm X I n (F.X n)) ×
        (sectionsFunctor X V).obj (idealPowerTerm X I (n + 1) (F.X (n + 1))) →ₗ[
          (X.presheaf.obj (op V) : Type u)] (sectionsFunctor X V).obj (etaTerm X I ι F n),
      ρ ∘ₗ sectionsEtaFstSnd X I ι F V n = LinearMap.id := by
  obtain ⟨ρK, hρK⟩ := EtaComplex.exists_retraction_termInclusion_of_iso
    (generatorSection X ι V g) (sectionsComplex X F V) C e hreg n hI
  refine ⟨(sectionsEtaTermEquiv X I ι F hF V g hg n).symm.toLinearMap ∘ₗ ρK ∘ₗ
    ((idealPowerSectionsCodRestrict X I ι V g hg (F.X n) n).prodMap
      (idealPowerSectionsCodRestrict X I ι V g hg (F.X (n + 1)) (n + 1))), ?_⟩
  ext x : 1
  simp only [LinearMap.comp_apply, LinearMap.id_apply]
  rw [idealPowerSectionsCodRestrict_comp_sectionsEtaFstSnd X I ι F hF V g hg n x]
  have h := LinearMap.congr_fun hρK (sectionsEtaTermEquiv X I ι F hF V g hg n x)
  simp only [LinearMap.comp_apply, LinearMap.id_apply] at h
  rw [h]
  exact (sectionsEtaTermEquiv X I ι F hF V g hg n).symm_apply_apply x

end Stacks.IdealTorsion.Eta

end
