-/

@[expose] public section

open IsLocalRing MvPowerSeries

namespace Stacks.Curves

universe u

variable {k : Type u} [Field k]

/-! ### Two small facts -/

/-- Reindexing the rows and the columns of a matrix along bijections does not change its ideal of
`r × r` minors. -/
theorem minorIdeal_submatrix_equiv {R : Type*} [CommRing R] {l l' o o' : Type*}
    (A : Matrix l o R) (e : l' ≃ l) (h : o' ≃ o) (r : ℕ) :
    minorIdeal (A.submatrix e h) r = minorIdeal A r := by
  refine le_antisymm (minorIdeal_submatrix_le A e h r) ?_
  have hle := minorIdeal_submatrix_le (A.submatrix e h) e.symm h.symm r
  rwa [Matrix.submatrix_submatrix, Equiv.self_comp_symm, Equiv.self_comp_symm,
    Matrix.submatrix_id_id] at hle

/-- A partial derivative of a power series in `𝔪 ^ 2` lies in `𝔪`: its constant term is the
coefficient of a linear monomial, which vanishes in `𝔪 ^ 2`. -/
theorem pderiv_mem_maximalIdeal_of_mem_sq {n : ℕ} {u : MvPowerSeries (Fin n) k}
    (hu : u ∈ (maximalIdeal (MvPowerSeries (Fin n) k)) ^ 2) (i : Fin n) :
    pderiv i u ∈ maximalIdeal (MvPowerSeries (Fin n) k) := by
  refine (Stacks.MvPowerSeries.RegularParameters.mem_maximalIdeal_iff_constantCoeff_eq_zero_field
    _).2 ?_
  have hdeg : ∑ j : Fin n, (((0 : Fin n →₀ ℕ) + Finsupp.single i 1) : Fin n →₀ ℕ) j < 2 := by
    have hsum : ∑ j : Fin n, (((0 : Fin n →₀ ℕ) + Finsupp.single i 1) : Fin n →₀ ℕ) j = 1 := by
      simp
    omega
  rw [← MvPowerSeries.coeff_zero_eq_constantCoeff_apply, MvPowerSeries.coeff_pderiv,
    Stacks.MvPowerSeries.RegularParameters.coeff_eq_zero_of_mem_pow_maximalIdeal hu _ hdeg,
      zero_mul]

/-- The maximal ideal of a power-series ring in at least one variable is not zero. -/
theorem maximalIdeal_ne_bot {n : ℕ} (hn : 0 < n) :
    maximalIdeal (MvPowerSeries (Fin n) k) ≠ ⊥ := by
  intro hbot
  have hmem : (MvPowerSeries.X ⟨0, hn⟩ : MvPowerSeries (Fin n) k) ∈
      maximalIdeal (MvPowerSeries (Fin n) k) :=
    (Stacks.MvPowerSeries.RegularParameters.mem_maximalIdeal_iff_constantCoeff_eq_zero_field _).2
      (MvPowerSeries.constantCoeff_X _)
  rw [hbot, Ideal.mem_bot] at hmem
  have hone : MvPowerSeries.coeff (Finsupp.single (⟨0, hn⟩ : Fin n) 1)
      (MvPowerSeries.X (⟨0, hn⟩ : Fin n) : MvPowerSeries (Fin n) k) = 1 := by
    simp
  rw [hmem, map_zero] at hone
  exact one_ne_zero hone.symm

/-- A surjective ring homomorphism is injective on the ideals containing its kernel. -/
private theorem map_eq_map_iff_of_ker_le {R S : Type*} [CommRing R] [CommRing S] {f : R →+* S}
    (hf : Function.Surjective f) {I J : Ideal R} (hI : RingHom.ker f ≤ I) (hJ : RingHom.ker f ≤ J) :
    Ideal.map f I = Ideal.map f J ↔ I = J := by
  rw [Ideal.map_eq_iff_sup_ker_eq_of_surjective f hf, sup_eq_left.2 hI, sup_eq_left.2 hJ]

/-- If `A/J` has a nodal quadratic relation for an ideal `J ⊆ 𝔪 ^ 2` of `k[[x_0, …, x_{d-1}]]`,
then `d = 2`, since the cotangent space of `A/J` has dimension `d`. -/
private theorem eq_two_of_hasNodalQuadraticRelation_of_le_sq {d : ℕ}
    (J : Ideal (MvPowerSeries (Fin d) k)) (hJ : J ≤ (maximalIdeal (MvPowerSeries (Fin d) k)) ^ 2)
    [IsLocalRing (MvPowerSeries (Fin d) k ⧸ J)]
    (hrel : HasNodalQuadraticRelation (MvPowerSeries (Fin d) k ⧸ J)) : d = 2 := by
  rw [← Stacks.MvPowerSeries.RegularParameters.finrank_cotangentSpace_field (K := k) (n := d),
    IsLocalRing.finrank_cotangentSpace_quotient _ hJ,
    finrank_cotangentSpace_eq_two_of_hasNodalQuadraticRelation hrel]

/-! ### The criterion for a defining ideal inside the square of the maximal ideal -/

/-- **Tag 0C4C's Jacobian-versus-relation equivalence for an arbitrary number of variables and a
defining ideal inside `𝔪 ^ 2`.** For `A = k[[x_0, …, x_{d-1}]]` and a family `h` of elements of
`𝔪_A ^ 2`, the Jacobian-minor ideal of Tag 0C4B at `d - 1` is the maximal ideal of the quotient
exactly when the quotient carries a nondegenerate quadratic relation on its cotangent space.

For `d = 2` this is
`Stacks.Curves.jacobianMinorIdealModulo_eq_maximalIdeal_iff_hasNodalQuadraticRelation`.
For every other `d` both sides are false: the cotangent space of the quotient has dimension `d`,
so there is no nodal relation, while the Jacobian-minor ideal is the unit ideal for `d ≤ 1` and
lies in `𝔪 ^ 2` for `d ≥ 3`. -/
theorem jacobianMinorIdealModulo_eq_maximalIdeal_iff_hasNodalQuadraticRelation_of_le_sq
    {d m : ℕ} (h : Fin m → MvPowerSeries (Fin d) k)
    (hh : ∀ j, h j ∈ (maximalIdeal (MvPowerSeries (Fin d) k)) ^ 2)
    [IsLocalRing (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range h))] :
    jacobianMinorIdealModulo (Ideal.span (Set.range h)) h (d - 1) =
        maximalIdeal (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range h)) ↔
      HasNodalQuadraticRelation (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range h)) := by
  have hJsq : Ideal.span (Set.range h) ≤ (maximalIdeal (MvPowerSeries (Fin d) k)) ^ 2 := by
    rw [Ideal.span_le]
    rintro x ⟨j, rfl⟩
    exact hh j
  have hnone : d ≠ 2 → ¬ HasNodalQuadraticRelation
      (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range h)) := fun hd hrel =>
    hd (eq_two_of_hasNodalQuadraticRelation_of_le_sq _ hJsq hrel)
  have hJm : Ideal.span (Set.range h) ≤ maximalIdeal (MvPowerSeries (Fin d) k) :=
    hJsq.trans (Ideal.pow_le_self (n := 2) (by norm_num))
  rcases lt_trichotomy d 2 with hlt | heq | hgt
  · have hd1 : d - 1 = 0 := by omega
    rw [hd1]
    refine ⟨fun hjac => absurd ?_ (maximalIdeal.isMaximal
      (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range h))).ne_top,
      fun hrel => absurd hrel (hnone (by omega))⟩
    have hdef : jacobianMinorIdealModulo (Ideal.span (Set.range h)) h 0 =
        (minorIdeal (Matrix.of fun i j => pderiv i (h j)) 0).map
          (Ideal.Quotient.mk (Ideal.span (Set.range h))) := rfl
    rw [← hjac, hdef, minorIdeal_zero, Ideal.map_top]
  · subst heq
    exact jacobianMinorIdealModulo_eq_maximalIdeal_iff_hasNodalQuadraticRelation h hh
  · refine ⟨fun hjac => ?_, fun hrel => absurd hrel (hnone (by omega))⟩
    exfalso
    rw [jacobianMinorIdealModulo_eq_maximalIdeal_iff _ hJm h (d - 1)] at hjac
    have hle : minorIdeal (fun (i : Fin d) (j : Fin m) => pderiv i (h j)) (d - 1) ≤
        (maximalIdeal (MvPowerSeries (Fin d) k)) ^ 2 :=
      (minorIdeal_le_pow_of_entries_mem _ _
        (fun i j => pderiv_mem_maximalIdeal_of_mem_sq (hh j) i) (d - 1)).trans
        (Ideal.pow_le_pow_right (by omega))
    have hmle : maximalIdeal (MvPowerSeries (Fin d) k) ≤
        ⊥ ⊔ (maximalIdeal (MvPowerSeries (Fin d) k)) ^ 2 := by
      rw [bot_sup_eq]
      exact hjac.ge.trans (sup_le hle hJsq)
    exact maximalIdeal_ne_bot (by omega) (eq_maximalIdeal_of_le_sup_sq bot_le hmle).symm

/-! ### A partial regular system of parameters adapted to an ideal -/

/-- **An ideal `I ⊆ 𝔪` of `A = k[[x_0, …, x_{n-1}]]` is generated modulo `𝔪 ^ 2` by part of a
regular system of parameters.** There are `r ≤ n` elements of `I` whose cotangent images are
linearly independent and which generate `I` modulo `𝔪 ^ 2`; here `r` is the dimension of the
image of `I` in the cotangent space. -/
theorem exists_partial_rsop_of_ideal {n : ℕ} (I : Ideal (MvPowerSeries (Fin n) k))
    (hI : I ≤ maximalIdeal (MvPowerSeries (Fin n) k)) :
    ∃ (r : ℕ) (_ : r ≤ n) (z : Fin r → maximalIdeal (MvPowerSeries (Fin n) k)),
      IsPartOfRegularSystemOfParameters z ∧
        (∀ i, ((z i : MvPowerSeries (Fin n) k)) ∈ I) ∧
        I ≤ Ideal.span (Set.range fun i => (z i : MvPowerSeries (Fin n) k)) ⊔
          (maximalIdeal (MvPowerSeries (Fin n) k)) ^ 2 := by
  classical
  set A := MvPowerSeries (Fin n) k with hA
  set mA := maximalIdeal A with hmA
  set M : Submodule A (CotangentSpace A) :=
    Submodule.map mA.toCotangent (Submodule.comap mA.subtype I) with hM
  set V : Submodule (ResidueField A) (CotangentSpace A) :=
    Submodule.span (ResidueField A) (M : Set (CotangentSpace A)) with hV
  have hVM : (V : Set (CotangentSpace A)) = (M : Set (CotangentSpace A)) := by
    have hrs := Submodule.restrictScalars_span A (ResidueField A)
      (IsLocalRing.residue_surjective (R := A)) (M : Set (CotangentSpace A))
    rw [Submodule.span_eq] at hrs
    rw [hV, ← Submodule.coe_restrictScalars A (Submodule.span (ResidueField A)
      (M : Set (CotangentSpace A))), hrs]
  have hfin : Module.Finite (ResidueField A) (CotangentSpace A) :=
    Module.Finite.of_basis (Stacks.MvPowerSeries.RegularParameters.basisCotangentSpaceX (K := k)
      (Equiv.refl (Fin n)))
  set r := Module.finrank (ResidueField A) V with hr
  set b := Module.finBasis (ResidueField A) V with hb
  have hfinA : Module.finrank (ResidueField A) (CotangentSpace A) = n :=
    Stacks.MvPowerSeries.RegularParameters.finrank_cotangentSpace_field
  have hrle : r ≤ n := le_trans (Submodule.finrank_le V) (le_of_eq hfinA)
  have hchoose : ∀ i : Fin r, ∃ x : mA, (x : A) ∈ I ∧
      mA.toCotangent x = (b i : CotangentSpace A) := by
    intro i
    have hmem : (b i : CotangentSpace A) ∈ M := by
      have hbV : (b i : CotangentSpace A) ∈ V := (b i).2
      rwa [← SetLike.mem_coe, hVM] at hbV
    obtain ⟨x, hx, hxe⟩ := Submodule.mem_map.1 hmem
    exact ⟨x, Submodule.mem_comap.1 hx, hxe⟩
  choose z hzI hzb using hchoose
  have hcoe : (fun i => mA.toCotangent (z i)) = fun i => V.subtype (b i) := funext hzb
  have hspan : Submodule.span (ResidueField A)
      (Set.range fun i => mA.toCotangent (z i)) = V := by
    rw [hcoe, Set.range_comp' V.subtype b, Submodule.span_image, b.span_eq, Submodule.map_top,
      V.range_subtype]
  refine ⟨r, hrle, z, ?_, hzI, ?_⟩
  · show LinearIndependent (ResidueField A) (fun i => mA.toCotangent (z i))
    rw [hcoe]
    exact b.linearIndependent.map' V.subtype (by simp)
  · intro x hx
    have hxm : x ∈ mA := hI hx
    have hcot : mA.toCotangent ⟨x, hxm⟩ ∈
        Submodule.span (ResidueField A) (Set.range fun i => mA.toCotangent (z i)) := by
      rw [hspan, ← SetLike.mem_coe, hVM]
      exact Submodule.mem_map.2 ⟨⟨x, hxm⟩, Submodule.mem_comap.2 hx, rfl⟩
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun (ResidueField A)).1 hcot
    choose a ha using fun i : Fin r => IsLocalRing.residue_surjective (R := A) (c i)
    have hsum : mA.toCotangent ⟨x, hxm⟩ = mA.toCotangent (∑ i, a i • z i) := by
      rw [map_sum, ← hc]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← ha i, Stacks.MvPowerSeries.RegularParameters.residue_smul_toCotangent, map_smul]
    have hzero : mA.toCotangent (⟨x, hxm⟩ - ∑ i, a i • z i) = 0 := by
      rw [map_sub, ← hsum, sub_self]
    rw [Ideal.toCotangent_eq_zero] at hzero
    have hdiff : x - ((∑ i, a i • z i : mA) : A) ∈ mA ^ 2 := by simpa using hzero
    have hmemsum : ((∑ i, a i • z i : mA) : A) ∈
        Ideal.span (Set.range fun i => (z i : A)) := by
      rw [Submodule.coe_sum]
      refine Ideal.sum_mem _ fun i _ => ?_
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
    have hxeq : x = (x - ((∑ i, a i • z i : mA) : A)) + ((∑ i, a i • z i : mA) : A) := by ring
    rw [hxeq]
    exact Submodule.add_mem _ (Submodule.mem_sup_right hdiff)
      (Submodule.mem_sup_left hmemsum)

/-! ### Changing the generating family and the coordinates -/

/-- The Jacobian condition of Tag 0C4C written upstairs — the ideal of minors joined with the
defining ideal — does not depend on the chosen finite generating family. This is Tag 0C4B pulled
back along the quotient map. -/
theorem minorIdeal_sup_eq_of_generators {n m l : ℕ} (I : Ideal (MvPowerSeries (Fin n) k))
    (f : Fin m → MvPowerSeries (Fin n) k) (g : Fin l → MvPowerSeries (Fin n) k)
    (hf : Ideal.span (Set.range f) = I) (hg : Ideal.span (Set.range g) = I) (t : ℕ) :
    minorIdeal (Matrix.of fun i j => pderiv i (f j)) t ⊔ I =
      minorIdeal (Matrix.of fun i j => pderiv i (g j)) t ⊔ I := by
  have hdeff : jacobianMinorIdealModulo I f t =
      (minorIdeal (Matrix.of fun i j => pderiv i (f j)) t).map (Ideal.Quotient.mk I) := rfl
  have hdefg : jacobianMinorIdealModulo I g t =
      (minorIdeal (Matrix.of fun i j => pderiv i (g j)) t).map (Ideal.Quotient.mk I) := rfl
  have hq := jacobianMinorIdealModulo_eq_of_generators I f g hf hg t
  rw [hdeff, hdefg] at hq
  have hc := congrArg (Ideal.comap (Ideal.Quotient.mk I)) hq
  rwa [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
    Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
    ← RingHom.ker_eq_comap_bot, Ideal.mk_ker] at hc

/-- An automorphism of a local ring carries the Jacobian condition `J ⊔ I = 𝔪` to itself. -/
theorem map_sup_eq_maximalIdeal_iff {R : Type*} [CommRing R] [IsLocalRing R] (σ : R ≃+* R)
    (J I : Ideal R) :
    Ideal.map (σ : R →+* R) J ⊔ Ideal.map (σ : R →+* R) I = maximalIdeal R ↔
      J ⊔ I = maximalIdeal R := by
  have hmax : Ideal.map (σ : R →+* R) (maximalIdeal R) = maximalIdeal R :=
    IsLocalRing.map_maximalIdeal_of_surjective (σ : R →+* R) σ.surjective
  have h := map_eq_map_iff_of_ker_le (f := (σ : R →+* R)) σ.surjective (I := J ⊔ I)
    (J := maximalIdeal R) (by simp) (by simp)
  rw [hmax] at h
  rw [← Ideal.map_sup]
  exact h

/-! ### The reduction of the general case to a defining ideal inside `𝔪 ^ 2` -/

/-- **The Jacobian-versus-relation equivalence of Tag 0C4C, in general.** For `A = k[[x_0, …,
x_{n-1}]]` and an arbitrary ideal `I ⊆ 𝔪_A` generated by a finite family `f`, the
Jacobian-minor ideal of Tag 0C4B at `n - 1` is the maximal ideal of `A/I` exactly when `A/I`
carries a nondegenerate quadratic relation on its cotangent space.

The proof is the reduction the source performs. Part of a regular system of parameters inside `I`
generating `I` modulo `𝔪 ^ 2` is extended to a full regular system of parameters
(`Stacks.MvPowerSeries.RegularParameters.extend_partial_rsop_field`); Tag 0C4B
(`Stacks.Curves.jacobianMinorIdealModulo_eq`) says the Jacobian-minor ideal may be computed in
those parameters, which is a change of coordinates carrying `I` to an ideal containing the first
`r` variables; adding those variables to the generating family puts the Jacobian matrix in the
block shape `fromBlocks 1 Q 0 M`, whose `(n-1)`-minors are the `(n-r-1)`-minors of `M`
(`Stacks.Curves.minorIdeal_fromBlocks_isUnit_det`); and killing the first `r` variables
(`Stacks.MvPowerSeries.RegularParameters.initialVarsAlgHom`) carries `M` to the Jacobian matrix of
  the image family in
`n - r` variables, because that substitution intertwines the partial derivatives. The image ideal
lies in the square of the maximal ideal, so
`Stacks.Curves.jacobianMinorIdealModulo_eq_maximalIdeal_iff_hasNodalQuadraticRelation_of_le_sq`
applies. -/
@[sga "7 XV 1.2.7" "special case"]
theorem jacobianMinorIdealModulo_eq_maximalIdeal_iff_hasNodalQuadraticRelation_of_le_maximalIdeal
    {n m : ℕ} (I : Ideal (MvPowerSeries (Fin n) k))
    (hI : I ≤ maximalIdeal (MvPowerSeries (Fin n) k))
    (f : Fin m → MvPowerSeries (Fin n) k) (hf : Ideal.span (Set.range f) = I)
    [IsLocalRing (MvPowerSeries (Fin n) k ⧸ I)] :
    jacobianMinorIdealModulo I f (n - 1) =
        maximalIdeal (MvPowerSeries (Fin n) k ⧸ I) ↔
      HasNodalQuadraticRelation (MvPowerSeries (Fin n) k ⧸ I) := by
  classical
  obtain ⟨r, hrn, z, hzind, hzI, hzsup⟩ := exists_partial_rsop_of_ideal I hI
  obtain ⟨y, hy, hyz⟩ : ∃ y : Fin n → maximalIdeal (MvPowerSeries (Fin n) k),
      IsRegularSystemOfParameters y ∧ ∀ i : Fin r, y (Fin.castLE hrn i) = z i := by
    obtain ⟨w, hyw⟩ := Stacks.MvPowerSeries.RegularParameters.extend_partial_rsop_field z hzind hrn
    refine ⟨_, hyw, fun i => ?_⟩
    have hidx : ∀ hc : n = r + (n - r),
        Fin.cast hc (Fin.castLE hrn i) = Fin.castAdd (n - r) i := fun hc => Fin.ext (by simp)
    simp only [Function.comp_apply, hidx, Fin.append_left]
  -- the coordinate automorphism attached to `y`, and its inverse as ring homomorphisms
  have hesub := Stacks.MvPowerSeries.RegularParameters.hasSubst_of_mem_maximalIdeal y
  have heX : ∀ i, (powerSeriesCoordinateEquiv y hy) (MvPowerSeries.X i) =
      (y i : MvPowerSeries (Fin n) k) := by
    intro i
    have h1 : (powerSeriesCoordinateEquiv y hy) (MvPowerSeries.X i) =
        MvPowerSeries.substAlgHom hesub (MvPowerSeries.X i) := rfl
    rw [h1, MvPowerSeries.substAlgHom_apply, MvPowerSeries.subst_X hesub]
  set τ : MvPowerSeries (Fin n) k ≃+* MvPowerSeries (Fin n) k :=
    (powerSeriesCoordinateEquiv y hy).toRingEquiv with hτ
  set E : MvPowerSeries (Fin n) k →+* MvPowerSeries (Fin n) k :=
    (τ.symm : MvPowerSeries (Fin n) k →+* MvPowerSeries (Fin n) k) with hE
  have hEy : ∀ i, E (y i : MvPowerSeries (Fin n) k) = MvPowerSeries.X i := by
    intro i
    rw [hE]
    show τ.symm (y i : MvPowerSeries (Fin n) k) = MvPowerSeries.X i
    rw [← heX i]
    exact τ.symm_apply_apply _
  have hFE : ((τ : MvPowerSeries (Fin n) k →+* MvPowerSeries (Fin n) k).comp E) =
      RingHom.id (MvPowerSeries (Fin n) k) := by
    refine RingHom.ext fun x => ?_
    rw [hE]
    exact τ.apply_symm_apply x
  have hmaxE : Ideal.map E (maximalIdeal (MvPowerSeries (Fin n) k)) =
      maximalIdeal (MvPowerSeries (Fin n) k) := by
    rw [hE]
    exact IsLocalRing.map_maximalIdeal_of_surjective _ τ.symm.surjective
  have hcomapE : ∀ X : Ideal (MvPowerSeries (Fin n) k), Ideal.comap E (Ideal.map E X) = X := by
    intro X
    rw [Ideal.comap_map_of_surjective _ (by rw [hE]; exact τ.symm.surjective),
      ← RingHom.ker_eq_comap_bot, hE, RingHom.ker_coe_equiv, sup_bot_eq]
  -- the transported ideal and generating family
  set I' : Ideal (MvPowerSeries (Fin n) k) := Ideal.map E I with hI'
  set f' : Fin m → MvPowerSeries (Fin n) k := fun j => E (f j) with hf'
  have hI'span : Ideal.span (Set.range f') = I' := by
    rw [hI', ← hf, Ideal.map_span, hf', Set.range_comp']
  have hI'max : I' ≤ maximalIdeal (MvPowerSeries (Fin n) k) := by
    rw [hI', ← hmaxE]
    exact Ideal.map_mono hI
  set KI : Ideal (MvPowerSeries (Fin n) k) :=
    Stacks.MvPowerSeries.RegularParameters.initialVarsIdeal k hrn with hKI
  have hKI' : KI ≤ I' := by
    rw [hKI, Stacks.MvPowerSeries.RegularParameters.initialVarsIdeal_eq_span, Ideal.span_le]
    rintro x ⟨i, rfl⟩
    have hx : (MvPowerSeries.X (Fin.castLE hrn i) : MvPowerSeries (Fin n) k) ∈ I' := by
      rw [← hEy (Fin.castLE hrn i), hyz i, hI']
      exact Ideal.mem_map_of_mem _ (hzI i)
    exact hx
  have hI'sq : I' ≤ KI ⊔ (maximalIdeal (MvPowerSeries (Fin n) k)) ^ 2 := by
    have hrangeeq : (Set.range fun i : Fin r => E (z i : MvPowerSeries (Fin n) k)) =
        Set.range fun i : Fin r =>
          (MvPowerSeries.X (Fin.castLE hrn i) : MvPowerSeries (Fin n) k) :=
      congrArg Set.range (funext fun i => by rw [← hyz i, hEy])
    have hstep : Ideal.map E (Ideal.span (Set.range fun i => (z i : MvPowerSeries (Fin n) k)) ⊔
        (maximalIdeal (MvPowerSeries (Fin n) k)) ^ 2) =
          KI ⊔ (maximalIdeal (MvPowerSeries (Fin n) k)) ^ 2 := by
      rw [Ideal.map_sup, Ideal.map_pow, hmaxE, Ideal.map_span, ← Set.range_comp', hrangeeq, hKI,
        Stacks.MvPowerSeries.RegularParameters.initialVarsIdeal_eq_span]
    rw [hI', ← hstep]
    exact Ideal.map_mono hzsup
  -- the quotient of the first `r` variables
  set S : MvPowerSeries (Fin n) k →+* MvPowerSeries (Fin (n - r)) k :=
    (Stacks.MvPowerSeries.RegularParameters.initialVarsAlgHom k hrn).toRingHom with hSdef
  have hSsurj : Function.Surjective S :=
    Stacks.MvPowerSeries.RegularParameters.initialVarsAlgHom_surjective hrn
  have hSker : RingHom.ker S = KI := Stacks.MvPowerSeries.RegularParameters.ker_initialVarsAlgHom
    hrn
  have hmaxS : Ideal.map S (maximalIdeal (MvPowerSeries (Fin n) k)) =
      maximalIdeal (MvPowerSeries (Fin (n - r)) k) :=
    IsLocalRing.map_maximalIdeal_of_surjective S hSsurj
  set hfam : Fin m → MvPowerSeries (Fin (n - r)) k := fun j => S (f' j) with hfamdef
  set J : Ideal (MvPowerSeries (Fin (n - r)) k) := Ideal.span (Set.range hfam) with hJ
  have hJmap : J = Ideal.map S I' := by
    rw [hJ, ← hI'span, Ideal.map_span, hfamdef, Set.range_comp']
  have hJsq : J ≤ (maximalIdeal (MvPowerSeries (Fin (n - r)) k)) ^ 2 := by
    have hstep : Ideal.map S (KI ⊔ (maximalIdeal (MvPowerSeries (Fin n) k)) ^ 2) =
        (maximalIdeal (MvPowerSeries (Fin (n - r)) k)) ^ 2 := by
      have hbot : Ideal.map S KI = ⊥ := by
        rw [← hSker]
        exact (Ideal.map_eq_bot_iff_le_ker S).2 le_rfl
      rw [Ideal.map_sup, Ideal.map_pow, hmaxS, hbot, bot_sup_eq]
    rw [hJmap, ← hstep]
    exact Ideal.map_mono hI'sq
  have hJmax : J ≤ maximalIdeal (MvPowerSeries (Fin (n - r)) k) :=
    hJsq.trans (Ideal.pow_le_self (n := 2) (by norm_num))
  have hfamsq : ∀ j, hfam j ∈ (maximalIdeal (MvPowerSeries (Fin (n - r)) k)) ^ 2 :=
    fun j => hJsq (Ideal.subset_span ⟨j, rfl⟩)
  have hlocJ : IsLocalRing (MvPowerSeries (Fin (n - r)) k ⧸ J) :=
    IsLocalRing.isLocalRing_quotient_of_le_maximalIdeal J hJmax
  -- the two quotients are isomorphic
  set T : MvPowerSeries (Fin n) k →+* MvPowerSeries (Fin (n - r)) k := S.comp E with hT
  have hTsurj : Function.Surjective T := by
    rw [hT]
    exact hSsurj.comp (by rw [hE]; exact τ.symm.surjective)
  have hJT : J = Ideal.map T I := by rw [hJmap, hI', hT, Ideal.map_map]
  have hkerT : RingHom.ker ((Ideal.Quotient.mk J).comp T) = I := by
    rw [← RingHom.comap_ker, Ideal.mk_ker, hJT, Ideal.comap_map_of_surjective _ hTsurj,
      ← RingHom.ker_eq_comap_bot, sup_eq_left]
    rw [hT, ← RingHom.comap_ker, hSker]
    calc Ideal.comap E KI ≤ Ideal.comap E I' := Ideal.comap_mono hKI'
      _ = I := by rw [hI']; exact hcomapE I
  have hiso : (MvPowerSeries (Fin n) k ⧸ I) ≃+*
      (MvPowerSeries (Fin (n - r)) k ⧸ J) :=
    (Ideal.quotEquivOfEq hkerT.symm).trans
      (RingHom.quotientKerEquivOfSurjective
        (f := (Ideal.Quotient.mk J).comp T) (Ideal.Quotient.mk_surjective.comp hTsurj))
  have hRHS : HasNodalQuadraticRelation (MvPowerSeries (Fin n) k ⧸ I) ↔
      HasNodalQuadraticRelation (MvPowerSeries (Fin (n - r)) k ⧸ J) :=
    hasNodalQuadraticRelation_congr hiso
  -- step A: the coordinate change
  have hstepA : (jacobianMinorIdealModulo I f (n - 1) =
      maximalIdeal (MvPowerSeries (Fin n) k ⧸ I)) ↔
        minorIdeal (Matrix.of fun i j => pderiv i (f' j)) (n - 1) ⊔ I' =
          maximalIdeal (MvPowerSeries (Fin n) k) := by
    rw [jacobianMinorIdealModulo_eq I f f hf hf y hy (n - 1)]
    have hdef : jacobianMinorIdealModuloInParameters I y hy f (n - 1) =
        (minorIdeal (Matrix.of fun i j => (powerSeriesCoordinateEquiv y hy)
            (pderiv i ((powerSeriesCoordinateEquiv y hy).symm (f j)))) (n - 1)).map
          (Ideal.Quotient.mk I) := rfl
    rw [hdef, map_eq_maximalIdeal_quotient_iff I _ hI]
    have hminor : minorIdeal (Matrix.of fun (i : Fin n) (j : Fin m) =>
          (powerSeriesCoordinateEquiv y hy)
            (pderiv i ((powerSeriesCoordinateEquiv y hy).symm (f j)))) (n - 1) =
        Ideal.map (τ : MvPowerSeries (Fin n) k →+* MvPowerSeries (Fin n) k)
          (minorIdeal (Matrix.of fun i j => pderiv i (f' j)) (n - 1)) := by
      rw [minorIdeal_map_matrix]
      rfl
    have hIeq : I = Ideal.map (τ : MvPowerSeries (Fin n) k →+* MvPowerSeries (Fin n) k) I' := by
      rw [hI', Ideal.map_map, hFE, Ideal.map_id]
    rw [hminor, hIeq, map_sup_eq_maximalIdeal_iff]
  rw [hstepA]
  -- the normalised generating family: the first `r` variables together with `f'`
  set g : Fin (r + m) → MvPowerSeries (Fin n) k :=
    Fin.append (fun i : Fin r =>
      (MvPowerSeries.X (Fin.castLE hrn i) : MvPowerSeries (Fin n) k)) f' with hg
  have hgspan : Ideal.span (Set.range g) = I' := by
    refine le_antisymm (Ideal.span_le.2 ?_) ?_
    · rintro x ⟨j, rfl⟩
      refine Fin.addCases (fun i => ?_) (fun i => ?_) j
      · rw [hg, Fin.append_left]
        exact hKI' (Ideal.subset_span ⟨i, rfl⟩)
      · rw [hg, Fin.append_right, ← hI'span]
        exact Ideal.subset_span ⟨i, rfl⟩
    · rw [← hI'span, Ideal.span_le]
      rintro x ⟨j, rfl⟩
      refine Ideal.subset_span ⟨Fin.natAdd r j, ?_⟩
      rw [hg, Fin.append_right]
  have hgleft : ∀ i : Fin r, g (Fin.castAdd m i) =
      (MvPowerSeries.X (Fin.castLE hrn i) : MvPowerSeries (Fin n) k) := by
    intro i; rw [hg, Fin.append_left]
  have hgright : ∀ j : Fin m, g (Fin.natAdd r j) = f' j := by
    intro j; rw [hg, Fin.append_right]
  have hone : ∀ i j : Fin r, pderiv (Fin.castLE hrn i)
      (MvPowerSeries.X (Fin.castLE hrn j) : MvPowerSeries (Fin n) k) =
      (1 : Matrix (Fin r) (Fin r) (MvPowerSeries (Fin n) k)) i j := by
    intro i j
    rw [MvPowerSeries.pderiv_X, Matrix.one_apply]
    by_cases hij : i = j
    · subst hij; simp
    · have hne : Fin.castLE hrn i ≠ Fin.castLE hrn j :=
        fun hc => hij (Fin.ext (by simpa using congrArg Fin.val hc))
      simp [hij]
  have hgen : minorIdeal (Matrix.of fun i j => pderiv i (f' j)) (n - 1) ⊔ I' =
      minorIdeal (Matrix.of fun i j => pderiv i (g j)) (n - 1) ⊔ I' :=
    minorIdeal_sup_eq_of_generators I' f' g hI'span hgspan (n - 1)
  rw [hgen]
  rcases Nat.eq_zero_or_pos (n - r) with hd0 | hdpos
  · -- no variables survive: the Jacobian minors are everything, and there is no relation
    have hnr : n - 1 ≤ r := by omega
    have htop : minorIdeal (Matrix.of fun i j => pderiv i (g j)) (n - 1) = ⊤ := by
      rw [Ideal.eq_top_iff_one]
      refine Ideal.subset_span ⟨fun t => Fin.castLE hrn (Fin.castLE hnr t),
        fun t => Fin.castAdd m (Fin.castLE hnr t), ?_⟩
      have hsub : (Matrix.of fun i j => pderiv i (g j)).submatrix
            (fun t => Fin.castLE hrn (Fin.castLE hnr t))
            (fun t => Fin.castAdd m (Fin.castLE hnr t)) =
          (1 : Matrix (Fin (n - 1)) (Fin (n - 1)) (MvPowerSeries (Fin n) k)) := by
        ext t u
        rw [Matrix.submatrix_apply, Matrix.of_apply, hgleft, hone, Matrix.one_apply,
          Matrix.one_apply]
        simp [Fin.ext_iff]
      rw [hsub, Matrix.det_one]
    rw [htop, top_sup_eq]
    refine ⟨fun hh => absurd hh.symm (maximalIdeal.isMaximal _).ne_top, fun hrel => ?_⟩
    exfalso
    have := eq_two_of_hasNodalQuadraticRelation_of_le_sq J hJsq (hRHS.1 hrel)
    omega
  · -- the surviving variables: block reduction, then the case already proved
    have hn1 : n - 1 = r + ((n - r) - 1) := by omega
    set Mb : Matrix (Fin (n - r)) (Fin m) (MvPowerSeries (Fin n) k) :=
      Matrix.of fun i j => pderiv (Stacks.MvPowerSeries.RegularParameters.QuotInitVars.embedFn hrn
        i) (f' j) with hMb
    have hblocks : (Matrix.of fun i j => pderiv i (g j)).submatrix
          (finSumFinEquiv.trans (finCongr (by omega : r + (n - r) = n)))
          (finSumFinEquiv (m := r) (n := m)) =
        Matrix.fromBlocks 1
          (Matrix.of fun (i : Fin r) (j : Fin m) => pderiv (Fin.castLE hrn i) (f' j)) 0 Mb := by
      have hrow : ∀ i : Fin r,
          (finSumFinEquiv.trans (finCongr (by omega : r + (n - r) = n))) (Sum.inl i) =
            Fin.castLE hrn i := fun i => Fin.ext (by simp)
      have hrow' : ∀ i : Fin (n - r),
          (finSumFinEquiv.trans (finCongr (by omega : r + (n - r) = n))) (Sum.inr i) =
            Stacks.MvPowerSeries.RegularParameters.QuotInitVars.embedFn hrn i := fun i => Fin.ext
              (by simp)
      ext a b
      rcases a with i | i <;> rcases b with j | j <;>
        simp only [Matrix.submatrix_apply, Matrix.of_apply, Matrix.fromBlocks_apply₁₁,
          Matrix.fromBlocks_apply₁₂, Matrix.fromBlocks_apply₂₁, Matrix.fromBlocks_apply₂₂,
          finSumFinEquiv_apply_left, finSumFinEquiv_apply_right, hrow, hrow',
          hgleft, hgright, hMb]
      · exact congrArg (MvPowerSeries.coeff _) (hone i j)
      · rw [MvPowerSeries.pderiv_X]
        have hne : Stacks.MvPowerSeries.RegularParameters.QuotInitVars.embedFn hrn i ≠ Fin.castLE
          hrn j := by
          intro hc
          have := congrArg Fin.val hc
          simp only [Stacks.MvPowerSeries.RegularParameters.QuotInitVars.embedFn_val,
            Fin.val_castLE] at this
          omega
        simp [hne]
    have hminorblocks : minorIdeal (Matrix.of fun i j => pderiv i (g j)) (n - 1) =
        minorIdeal Mb ((n - r) - 1) := by
      rw [← minorIdeal_submatrix_equiv (Matrix.of fun i j => pderiv i (g j))
          (finSumFinEquiv.trans (finCongr (by omega : r + (n - r) = n)))
          (finSumFinEquiv (m := r) (n := m)) (n - 1),
        hblocks, hn1, minorIdeal_fromBlocks_isUnit_det 1 _ 0 Mb (by simp),
        Matrix.zero_mul, Matrix.zero_mul, sub_zero]
    rw [hminorblocks]
    have hmat : Mb.map S = Matrix.of fun i j => pderiv i (hfam j) :=
      Matrix.ext fun i j => by
        simp only [Matrix.map_apply, hMb, Matrix.of_apply, hfamdef]
        exact Stacks.MvPowerSeries.RegularParameters.initialVarsAlgHom_pderiv hrn i (f' j)
    have hSmap : Ideal.map S (minorIdeal Mb ((n - r) - 1)) =
        minorIdeal (fun i j => pderiv i (hfam j)) ((n - r) - 1) := by
      rw [minorIdeal_map_matrix, hmat]
      rfl
    have hmapsup : Ideal.map S (minorIdeal Mb ((n - r) - 1) ⊔ I') =
        minorIdeal (fun i j => pderiv i (hfam j)) ((n - r) - 1) ⊔ J := by
      rw [Ideal.map_sup, hSmap, hJmap]
    have hLHS : (minorIdeal Mb ((n - r) - 1) ⊔ I' =
        maximalIdeal (MvPowerSeries (Fin n) k)) ↔
          minorIdeal (fun i j => pderiv i (hfam j)) ((n - r) - 1) ⊔ J =
            maximalIdeal (MvPowerSeries (Fin (n - r)) k) := by
      rw [← hmaxS, ← hmapsup]
      exact (map_eq_map_iff_of_ker_le hSsurj (hSker ▸ hKI'.trans le_sup_right)
        (hSker ▸ hKI'.trans hI'max)).symm
    rw [hLHS, ← jacobianMinorIdealModulo_eq_maximalIdeal_iff J hJmax hfam ((n - r) - 1), hRHS]
    exact jacobianMinorIdealModulo_eq_maximalIdeal_iff_hasNodalQuadraticRelation_of_le_sq hfam
      hfamsq

/-! ### The Jacobian criterion -/

/-- **The Jacobian criterion for a node.** A quotient of a finite-variable formal power-series
ring by equations in its maximal ideal is nodal if and only if it is reduced (equivalently, has
depth one) and its next-to-maximal Jacobian minors generate the maximal ideal.

The Jacobian-minor ideal is the one of Tag 0C4B
(`Stacks.Curves.jacobianMinorIdealModulo`). The source states the Jacobian condition as the
minors generating `I + 𝔪_A` in the power-series ring; the equivalent intrinsic equality between
their image and the maximal ideal of the quotient is used here, and the depth condition is
likewise written over the quotient ring. -/
@[stacks 0C4C]
theorem isNodalAlgebra_jacobianMinorIdeal_tfae (k : Type u) [Field k] {n m : ℕ}
    (I : Ideal (MvPowerSeries (Fin n) k))
    (f : Fin m → MvPowerSeries (Fin n) k)
    (hf : Ideal.span (Set.range f) = I)
    (hI : I ≤ maximalIdeal (MvPowerSeries (Fin n) k)) :
    letI : Nontrivial (MvPowerSeries (Fin n) k ⧸ I) :=
      Ideal.Quotient.nontrivial_iff.mpr
        (ne_top_of_le_ne_top
          (maximalIdeal.isMaximal (MvPowerSeries (Fin n) k)).ne_top hI)
    letI : IsLocalRing (MvPowerSeries (Fin n) k ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    List.TFAE [
      IsNodalAlgebra k (MvPowerSeries (Fin n) k ⧸ I),
      IsReduced (MvPowerSeries (Fin n) k ⧸ I) ∧
        jacobianMinorIdealModulo I f (n - 1) =
          maximalIdeal (MvPowerSeries (Fin n) k ⧸ I),
      Module.depth (MvPowerSeries (Fin n) k ⧸ I)
          (maximalIdeal (MvPowerSeries (Fin n) k ⧸ I))
          (MvPowerSeries (Fin n) k ⧸ I) = 1 ∧
        jacobianMinorIdealModulo I f (n - 1) =
          maximalIdeal (MvPowerSeries (Fin n) k ⧸ I)] := by
  have hnt : Nontrivial (MvPowerSeries (Fin n) k ⧸ I) :=
    Ideal.Quotient.nontrivial_iff.mpr
      (ne_top_of_le_ne_top (maximalIdeal.isMaximal (MvPowerSeries (Fin n) k)).ne_top hI)
  have hloc : IsLocalRing (MvPowerSeries (Fin n) k ⧸ I) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  exact isNodalAlgebra_tfae_of_jacobianMinorIdeal_iff I f
    (jacobianMinorIdealModulo_eq_maximalIdeal_iff_hasNodalQuadraticRelation_of_le_maximalIdeal
      I hI f hf)

end Stacks.Curves

end
