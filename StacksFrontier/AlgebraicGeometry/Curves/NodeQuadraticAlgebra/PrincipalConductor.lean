module

public import StacksFrontier.AlgebraicGeometry.Curves.NodeQuadraticAlgebra.ClosedFibreDeltaOne
public import StacksFrontier.AlgebraicGeometry.Variety.DeltaInvariant.Normalization
public import StacksFrontier.AlgebraicGeometry.Variety.DeltaInvariant.Parameters
import all StacksFrontier.AlgebraicGeometry.Variety.OneDimensional.DeltaBranchBound

/-!
# The conductor of a henselian one-dimensional ring is principal

Let `A` be a henselian, reduced, one-dimensional Nagata local ring and let
`A' = integralClosure A (FractionRing A)` be its normalization inside its total ring of
fractions. Then every ideal of `A'` is principal.

## Main results

* `Stacks.Curves.isPrincipalIdealRing_integralClosure_fractionRing` — the normalization of a
  henselian reduced one-dimensional Nagata local ring is a principal ideal ring.
* `Stacks.Curves.exists_generator_map_maximalIdeal_of_deltaInvariant_eq_one` — for delta
  invariant one, `𝔪 A'` is generated by the image of a nonzerodivisor element of `𝔪`.

## References

* [Stacks Project, Tag 0C4A](https://stacks.math.columbia.edu/tag/0C4A)
* [Stacks Project, Tag 04GJ](https://stacks.math.columbia.edu/tag/04GJ)
-/

@[expose] public noncomputable section

open IsLocalRing

universe u

namespace Stacks.Curves

/-- Being a principal ideal ring transports backwards along a ring isomorphism. -/
private theorem isPrincipalIdealRing_of_ringEquiv {R : Type*} {S : Type*} [CommRing R]
    [CommRing S] (e : R ≃+* S) [IsPrincipalIdealRing S] : IsPrincipalIdealRing R :=
  .of_surjective e.symm e.symm.surjective

/-- The normalization of a henselian reduced one-dimensional Nagata local ring is a principal
ideal ring. -/
public theorem isPrincipalIdealRing_integralClosure_fractionRing (A : Type u) [CommRing A]
    [HenselianLocalRing A] [IsReduced A] (hNagata : IsNagataRing A)
    (hdim : ringKrullDim A = 1) :
    IsPrincipalIdealRing ↥(integralClosure A (FractionRing A)) := by
  let : IsNoetherianRing A := hNagata.1
  let C := integralClosure A (FractionRing A)
  let : Module.Finite A C := module_finite_integralClosure_fractionRing hNagata
  obtain ⟨m, B, hBcomm, hBalgebra, hBlocal, hBfinite, ⟨e⟩⟩ :=
    exists_algEquiv_pi_isLocalRing A C
  let : ∀ i : Fin m, CommRing (B i) := hBcomm
  let : ∀ i : Fin m, Algebra A (B i) := hBalgebra
  let : ∀ i : Fin m, IsLocalRing (B i) := hBlocal
  let : ∀ i : Fin m, Module.Finite A (B i) := hBfinite
  have hnormalProd : IsNormalRing (∀ i : Fin m, B i) :=
    IsNormalRing.congr e.toRingEquiv (isNormalRing_integralClosure_fractionRing (A := A))
  let hnormalFactor : ∀ i : Fin m, IsNormalRing (B i) :=
    Ring.isNormalRing_of_pi_factor B hnormalProd
  let : ∀ i : Fin m, IsDomain (B i) := fun i => (hnormalFactor i).of_isLocalRing.1
  let : ∀ i : Fin m, IsIntegrallyClosed (B i) := fun i => (hnormalFactor i).of_isLocalRing.2
  let : ∀ i : Fin m, IsNoetherianRing (B i) := fun i => IsNoetherianRing.of_finite A (B i)
  have e' : ↥(integralClosure A (FractionRing A)) ≃ₐ[A] ∀ i : Fin m, B i := by simpa [C] using e
  have hdimFactor : ∀ i : Fin m, ringKrullDim (B i) = 1 :=
    Ring.normalization_factor_dim_one (A := A) (hA := hNagata) (hdim := hdim)
      (ι := Fin m) (B := B) e'
  let : ∀ i : Fin m, IsDiscreteValuationRing (B i) := fun i =>
    Ring.isDVR_of_normal_local_dim_one (B i) (hdimFactor i)
  exact isPrincipalIdealRing_of_ringEquiv e'.toRingEquiv

/-- The image in the normalization of a nonzerodivisor of a reduced one-dimensional Noetherian
local ring is a nonzerodivisor. -/
private theorem algebraMap_mem_nonZeroDivisors_integralClosure {A : Type u} [CommRing A]
    {f : A} (hf : f ∈ nonZeroDivisors A) :
    algebraMap A ↥(integralClosure A (FractionRing A)) f ∈
      nonZeroDivisors ↥(integralClosure A (FractionRing A)) := by
  have hunit : IsUnit (algebraMap A (FractionRing A) f) :=
    IsLocalization.map_units (FractionRing A) ⟨f, hf⟩
  rw [mem_nonZeroDivisors_iff_right]
  intro z hz
  have hz' : (z : FractionRing A) * algebraMap A (FractionRing A) f = 0 := by
    simpa using congrArg (fun x : ↥(integralClosure A (FractionRing A)) => (x : FractionRing A)) hz
  exact Subtype.ext (hunit.mul_left_eq_zero.mp hz')

/-- For a henselian reduced one-dimensional Nagata local ring of delta invariant one, the
extension `𝔪 A'` of the maximal ideal to the normalization is generated by the image of a single
element of `𝔪`, which is moreover a nonzerodivisor of `A'`. -/
public theorem exists_generator_map_maximalIdeal_of_deltaInvariant_eq_one (A : Type u)
    [CommRing A] [HenselianLocalRing A] [IsReduced A] (hNagata : IsNagataRing A)
    (hdim : ringKrullDim A = 1) (hdelta : Ring.deltaInvariant A = 1) :
    ∃ θ ∈ maximalIdeal A,
      algebraMap A ↥(integralClosure A (FractionRing A)) θ ∈
          nonZeroDivisors ↥(integralClosure A (FractionRing A)) ∧
        (maximalIdeal A).map (algebraMap A ↥(integralClosure A (FractionRing A))) =
          Ideal.span {algebraMap A ↥(integralClosure A (FractionRing A)) θ} := by
  let : IsNoetherianRing A := hNagata.1
  set C := ↥(integralClosure A (FractionRing A)) with hC
  set J := (maximalIdeal A).map (algebraMap A C) with hJ
  let : IsPrincipalIdealRing C :=
    isPrincipalIdealRing_integralClosure_fractionRing A hNagata hdim
  have hsimple : IsSimpleModule A (C ⧸ LinearMap.range (Algebra.linearMap A C)) :=
    Module.length_eq_one_iff.mp hdelta
  have hJle : (J.restrictScalars A) ≤ LinearMap.range (Algebra.linearMap A C) :=
    map_maximalIdeal_restrictScalars_le_range_of_isSimpleModule A C hsimple
  obtain ⟨g, hgspan⟩ := (IsPrincipalIdealRing.principal J).principal
  have hgspan' : J = Ideal.span {g} := hgspan
  have hgJ : g ∈ J := hgspan' ▸ Ideal.mem_span_singleton_self g
  obtain ⟨θ, hθ⟩ : ∃ θ : A, algebraMap A C θ = g := hJle hgJ
  obtain ⟨f, hfm, hfrad⟩ := exists_radical_span_eq_maximalIdeal (A := A) hdim
  have hfnzd : f ∈ nonZeroDivisors A :=
    (notMem_minimalPrimes_iff_mem_nonZeroDivisors_of_depth_eq_one hdim
      (depth_eq_one_of_isReduced hdim) f).mp
      ((radical_span_eq_maximalIdeal_iff_notMem_minimalPrimes hdim hfm).mp hfrad)
  have hfnzdC : algebraMap A C f ∈ nonZeroDivisors C :=
    algebraMap_mem_nonZeroDivisors_integralClosure hfnzd
  have hfJ : algebraMap A C f ∈ J := Ideal.mem_map_of_mem (algebraMap A C) hfm
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hgspan' ▸ hfJ)
  have hθJ : J = Ideal.span {algebraMap A C θ} := by rw [hgspan', hθ]
  have hθmem : θ ∈ maximalIdeal A :=
    mem_maximalIdeal_of_algebraMap_mem_map_of_isSimpleModule A C hsimple (by rwa [hθ])
  refine ⟨θ, hθmem, ?_, hθJ⟩
  rw [hθ, mem_nonZeroDivisors_iff_right]
  intro z hz
  refine mem_nonZeroDivisors_iff_right.mp hfnzdC z ?_
  rw [← hc, mul_comm c g, ← mul_assoc, hz, zero_mul]

end Stacks.Curves

end
