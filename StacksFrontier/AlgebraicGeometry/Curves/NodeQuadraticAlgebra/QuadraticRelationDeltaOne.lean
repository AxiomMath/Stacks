module

public import Mathlib.FieldTheory.Minpoly.Field
public import Mathlib.FieldTheory.Separable
public import Mathlib.Tactic.ComputeDegree
public import StacksFrontier.AlgebraicGeometry.Curves.NodeQuadraticAlgebra.ClosedFibreDeltaOne
public import StacksFrontier.RingTheory.CompleteLocalRing.QuotientNodal.NodalQuadraticRelation
import all StacksFrontier.AlgebraicGeometry.Curves.Node.Algebra

/-!
# The nodal quadratic relation from a principal conductor

Let `A` be a Noetherian local ring with `Ring.deltaInvariant A = 1`, and let
`A' = integralClosure A (FractionRing A)`. If the ideal `𝔪 A'` is generated by the image of a
nonzerodivisor `θ ∈ 𝔪` and the closed fibre `A' ⧸ 𝔪 A'` is separable over the residue field, then
`A` carries the nondegenerate quadratic relation of Stacks Tag 0C49.

## Main definitions

* `Stacks.Curves.quadraticPoly`: the monic quadratic `X² - αX - β`.

## Main results

* `Stacks.Curves.discrim_ne_zero_of_separable`: if `X² - αX - β` is separable over a field, then
  `α² + 4β ≠ 0`.
* `Stacks.Curves.discrim_ne_zero_of_isSeparable`: in a separable algebra, a quadratic relation
  `s² = αs + β` satisfied by an element `s` linearly independent from `1` has `α² + 4β ≠ 0`.
* `Stacks.Curves.hasNodalQuadraticRelation_of_deltaInvariant_eq_one_of_isPrincipal`: a Noetherian
  local ring of delta invariant one with principal `𝔪 A'` and separable closed fibre has a nodal
  quadratic relation.

## References

* [Stacks Project, Tag 0C4A](https://stacks.math.columbia.edu/tag/0C4A)
* [Stacks Project, Tag 0C49](https://stacks.math.columbia.edu/tag/0C49)
-/


@[expose] public noncomputable section

open IsLocalRing Polynomial

universe u

namespace Stacks.Curves

/-! ### The discriminant of a monic quadratic -/

/-- The monic quadratic with coefficients `α`, `β`. -/
public abbrev quadraticPoly {κ : Type u} [Field κ] (α β : κ) : κ[X] :=
  X ^ 2 - C α * X - C β

/-- `quadraticPoly α β` is monic. -/
public theorem monic_quadraticPoly {κ : Type u} [Field κ] (α β : κ) :
    (quadraticPoly α β).Monic := by
  unfold quadraticPoly
  monicity!

/-- `quadraticPoly α β` has degree `2`. -/
public theorem natDegree_quadraticPoly {κ : Type u} [Field κ] (α β : κ) :
    (quadraticPoly α β).natDegree = 2 := by
  unfold quadraticPoly
  compute_degree!

/-- The derivative of `quadraticPoly α β` is `2X - α`. -/
public theorem derivative_quadraticPoly {κ : Type u} [Field κ] (α β : κ) :
    derivative (quadraticPoly α β) = 2 * X - C α := by
  unfold quadraticPoly
  simp only [derivative_sub, derivative_mul, derivative_C, derivative_X_pow, derivative_X,
    zero_mul, mul_one, sub_zero, Nat.cast_ofNat, map_ofNat]
  ring

/-- If the quadratic `X² - αX - β` over a field is separable, then `α² + 4β ≠ 0`. -/
public theorem discrim_ne_zero_of_separable {κ : Type u} [Field κ] (α β : κ)
    (hsep : (quadraticPoly α β).Separable) : α ^ 2 + 4 * β ≠ 0 := by
  intro hd
  have hc : C α ^ 2 + 4 * C β = (0 : κ[X]) := by
    simpa only [map_add, map_mul, map_pow, map_ofNat, map_zero] using congrArg C hd
  have hid : (derivative (quadraticPoly α β)) ^ 2 = 4 * quadraticPoly α β := by
    rw [derivative_quadraticPoly]
    unfold quadraticPoly
    linear_combination hc
  have hunit : IsUnit (quadraticPoly α β) :=
    hsep.pow_right.isUnit_of_dvd' dvd_rfl (Dvd.intro_left _ hid.symm)
  rw [Polynomial.isUnit_iff_degree_eq_zero,
    Polynomial.degree_eq_natDegree (monic_quadraticPoly α β).ne_zero,
    natDegree_quadraticPoly] at hunit
  exact absurd hunit (by decide)

/-- In a separable `κ`-algebra, if `s` is linearly independent from `1` and `s² = αs + β`, then
`α² + 4β ≠ 0`. -/
public theorem discrim_ne_zero_of_isSeparable {κ : Type u} [Field κ] (T : Type*) [CommRing T]
    [Nontrivial T] [Algebra κ T] [Algebra.IsSeparable κ T] (s : T) (α β : κ)
    (hli : LinearIndependent κ ![(1 : T), s])
    (hrel : s ^ 2 = α • s + β • (1 : T)) :
    α ^ 2 + 4 * β ≠ 0 := by
  have hint : IsIntegral κ s := Algebra.IsSeparable.isIntegral κ s
  have hnr : s ∉ (algebraMap κ T).range := by
    rintro ⟨c, hc⟩
    have hz : (-c) • (1 : T) + (1 : κ) • s = 0 := by
      rw [one_smul, ← hc, Algebra.smul_def, mul_one, map_neg]
      ring
    exact one_ne_zero (LinearIndependent.pair_iff.mp hli _ _ hz).2
  have haeval : Polynomial.aeval s (quadraticPoly α β) = 0 := by
    unfold quadraticPoly
    simp only [map_sub, map_pow, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
    rw [hrel, Algebra.smul_def, Algebra.smul_def, mul_one]
    ring
  have heq : minpoly κ s = quadraticPoly α β :=
    Polynomial.eq_of_monic_of_associated (minpoly.monic hint) (monic_quadraticPoly α β)
      (Polynomial.associated_of_dvd_of_natDegree_le (minpoly.dvd κ s haeval)
        (monic_quadraticPoly α β).ne_zero
        (by rw [natDegree_quadraticPoly]; exact (minpoly.two_le_natDegree_iff hint).mpr hnr))
  exact discrim_ne_zero_of_separable α β (heq ▸ Algebra.IsSeparable.isSeparable κ s)

/-! ### The quadratic relation from a principal conductor -/

/-- Let `A` be a Noetherian local ring of delta invariant one with normalization `A'`. If `𝔪 A'` is
generated by the image of an element `θ ∈ 𝔪` that is a nonzerodivisor in `A'`, and the closed fibre
`A' ⧸ 𝔪 A'` is separable over the residue field, then `A` has a nodal quadratic relation. -/
public theorem hasNodalQuadraticRelation_of_deltaInvariant_eq_one_of_isPrincipal
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (hdelta : Ring.deltaInvariant A = 1)
    (hsep : Algebra.IsSeparable (ResidueField A) (quadraticAlgebra A))
    (θ : A) (hθm : θ ∈ maximalIdeal A)
    (hθnzd : algebraMap A ↥(integralClosure A (FractionRing A)) θ ∈
      nonZeroDivisors ↥(integralClosure A (FractionRing A)))
    (hprinc : (maximalIdeal A).map (algebraMap A ↥(integralClosure A (FractionRing A)))
      = Ideal.span {algebraMap A ↥(integralClosure A (FractionRing A)) θ}) :
    HasNodalQuadraticRelation A := by
  classical
  set B := ↥(integralClosure A (FractionRing A))
  set J := (maximalIdeal A).map (algebraMap A B) with hJdef
  have hinj : Function.Injective (algebraMap A B) := fun a b hab =>
    IsFractionRing.injective A (FractionRing A) (congrArg Subtype.val hab)
  obtain ⟨t, hJle, htop, hli, -, hpair⟩ :=
    exists_linearIndependent_quadraticAlgebra_of_deltaInvariant_eq_one A hdelta
  set s : quadraticAlgebra A := Ideal.Quotient.mk J t with hsdef
  have hdec : ∀ c : B, ∃ u v : A, c = algebraMap A B u + algebraMap A B v * t := by
    intro c
    obtain ⟨p, ⟨u, rfl⟩, q, hq, hpq⟩ :=
      Submodule.mem_sup.mp (show c ∈ LinearMap.range (Algebra.linearMap A B) ⊔
        Submodule.span A {t} from htop ▸ Submodule.mem_top)
    obtain ⟨v, rfl⟩ := Submodule.mem_span_singleton.mp hq
    exact ⟨u, v, by rw [← hpq, Algebra.smul_def]; rfl⟩
  obtain ⟨beta, alpha, hrel'⟩ := hdec (t ^ 2)
  have hrel : algebraMap A B beta + algebraMap A B alpha * t = t ^ 2 := hrel'.symm
  have hrelQ : s ^ 2 = residue A alpha • s + residue A beta • (1 : quadraticAlgebra A) := by
    rw [hsdef, ← map_pow, ← hrel, map_add, quotient_mk_algebraMap_integralClosure,
      quotient_mk_algebraMap_mul_integralClosure]
    ring
  have hnt : Nontrivial (quadraticAlgebra A) := Ideal.Quotient.nontrivial_iff.mpr
    (map_maximalIdeal_ne_top_of_isSimpleModule A B (Module.length_eq_one_iff.mp hdelta))
  have hdisc : (residue A alpha) ^ 2 + 4 * residue A beta ≠ 0 :=
    discrim_ne_zero_of_isSeparable (quadraticAlgebra A) s _ _ hli hrelQ
  have hmulJ : algebraMap A B θ * t ∈ J := J.mul_mem_right t (Ideal.mem_map_of_mem _ hθm)
  obtain ⟨yv, hyv⟩ := hJle hmulJ
  have hyv' : algebraMap A B yv = algebraMap A B θ * t := hyv
  have hyvm : yv ∈ maximalIdeal A :=
    mem_maximalIdeal_of_algebraMap_mem_map_of_isSimpleModule A B
      (Module.length_eq_one_iff.mp hdelta) (by rw [hyv']; exact hmulJ)
  have hspan : Ideal.span ({θ, yv} : Set A) = maximalIdeal A := by
    refine le_antisymm (Ideal.span_le.mpr (Set.pair_subset hθm hyvm)) ?_
    intro a ha
    have haJ : algebraMap A B a ∈ J := Ideal.mem_map_of_mem _ ha
    rw [hprinc, Ideal.mem_span_singleton'] at haJ
    obtain ⟨c, hc⟩ := haJ
    obtain ⟨uu, vv, hcc'⟩ := hdec c
    have hcc : algebraMap A B a = algebraMap A B (θ * uu + vv * yv) := by
      rw [← hc, hcc']
      simp only [map_add, map_mul]
      rw [hyv']
      ring
    rw [hinj hcc]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp)))
      (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
  have hzero : (-beta) * θ ^ 2 + (-alpha) * θ * yv + 1 * yv ^ 2 = 0 := by
    apply hinj
    rw [map_zero]
    simp only [map_add, map_mul, map_pow, map_neg, map_one]
    rw [hyv']
    linear_combination (-(algebraMap A B θ ^ 2)) * hrel
  set x' : maximalIdeal A := ⟨θ, hθm⟩ with hx'
  set y' : maximalIdeal A := ⟨yv, hyvm⟩ with hy'
  have hcotli : LinearIndependent (ResidueField A)
      ![(maximalIdeal A).toCotangent x', (maximalIdeal A).toCotangent y'] := by
    rw [LinearIndependent.pair_iff]
    intro c₁ c₂ hcc
    obtain ⟨lam, rfl⟩ := residue_surjective c₁
    obtain ⟨mu, rfl⟩ := residue_surjective c₂
    rw [← IsLocalRing.ResidueField.algebraMap_eq, algebraMap_smul, algebraMap_smul,
      ← map_smul, ← map_smul, ← map_add, Ideal.toCotangent_eq_zero] at hcc
    have hmem : lam * θ + mu * yv ∈ (maximalIdeal A) ^ 2 := by
      simpa [Submodule.coe_add, Submodule.coe_smul, hx', hy', Algebra.smul_def, smul_eq_mul]
        using hcc
    have hmap : algebraMap A B (lam * θ + mu * yv) ∈ J ^ 2 := by
      rw [← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ hmem
    rw [hprinc, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hmap
    obtain ⟨cc, hcc2⟩ := hmap
    have hcancel : algebraMap A B lam + algebraMap A B mu * t = cc * algebraMap A B θ := by
      rw [← mul_cancel_right_mem_nonZeroDivisors hθnzd]
      simp only [map_add, map_mul] at hcc2
      rw [hyv'] at hcc2
      linear_combination -hcc2
    obtain ⟨h₁, h₂⟩ := hpair lam mu (by
      rw [← hJdef, hprinc, hcancel]
      exact Ideal.mem_span_singleton'.mpr ⟨cc, rfl⟩)
    exact ⟨(residue_eq_zero_iff lam).mpr h₁, (residue_eq_zero_iff mu).mpr h₂⟩
  have hcotsp : ⊤ ≤ Submodule.span (ResidueField A)
      (Set.range (fun i : BinaryIndex (ResidueField A) =>
        ![(maximalIdeal A).toCotangent x', (maximalIdeal A).toCotangent y'] i.down)) := by
    intro z _
    obtain ⟨w, rfl⟩ := (maximalIdeal A).toCotangent_surjective z
    have hw : w ∈ Submodule.span A ({x', y'} : Set (maximalIdeal A)) := by
      rw [span_pair_subtype_eq_top_of_ideal_span_eq_maximal x' y' hspan]
      trivial
    obtain ⟨aa, bb, rfl⟩ := Submodule.mem_span_pair.mp hw
    rw [map_add, map_smul, map_smul, ← algebraMap_smul (ResidueField A) aa,
      ← algebraMap_smul (ResidueField A) bb]
    refine Submodule.add_mem _ (Submodule.smul_mem _ _ ?_) (Submodule.smul_mem _ _ ?_)
    · exact Submodule.subset_span ⟨⟨0⟩, rfl⟩
    · exact Submodule.subset_span ⟨⟨1⟩, rfl⟩
  refine (hasNodalQuadraticRelation_iff_exists_basis A).mpr
    ⟨x', y', Module.Basis.mk (hcotli.comp (fun i : BinaryIndex (ResidueField A) => i.down)
      (fun a b h => ULift.ext _ _ h)) hcotsp, -beta, -alpha, 1, ?_, ?_, ?_, ?_⟩
  · rw [Module.Basis.mk_apply]; rfl
  · rw [Module.Basis.mk_apply]; rfl
  · intro hz
    refine hdisc ?_
    have hid : residue A (4 * (-beta) * 1 - (-alpha) ^ 2)
        = -((residue A alpha) ^ 2 + 4 * residue A beta) := by
      simp only [map_sub, map_mul, map_pow, map_neg, map_ofNat, map_one]
      ring
    exact neg_eq_zero.mp (hid ▸ hz)
  · rw [show (-beta) * (x' : A) ^ 2 + (-alpha) * (x' : A) * (y' : A) + 1 * (y' : A) ^ 2 = 0 from
      hzero]
    exact Submodule.zero_mem _

end Stacks.Curves

end
