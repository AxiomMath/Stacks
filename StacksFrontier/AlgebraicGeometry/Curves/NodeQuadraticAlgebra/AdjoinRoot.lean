/-!
# The quadratic algebra of a node is a quadratic polynomial algebra

Let `(A, 𝔪, κ)` be a Noetherian nodal local algebra over a field, and write its quadratic
relation in lifted cotangent coordinates as `a x² + b x y + c y² ∈ 𝔪³`, with `x, y ∈ 𝔪` lifting
a basis of `𝔪/𝔪²`, discriminant `4ac - b²` a unit and leading coefficient `a` a unit. Then the
closed fibre of the normalization of `A` — the quadratic algebra `Stacks.Curves.quadraticAlgebra`
— is the quadratic polynomial algebra `κ[X]/(a X² + b X + c)`.

## Main definitions

* `Stacks.Curves.stableIdealQuotient`: the affine blow-up chart `R[I/y]` of an ideal `I` with
  `I² = y I`.

## Main results

* `Stacks.Curves.quadraticAlgebra_equiv_adjoinRoot`: the quadratic algebra of a node is the
  quadratic polynomial algebra determined by the coefficients of the quadratic relation.

## References

* [Stacks Project, Tag 0CBT](https://stacks.math.columbia.edu/tag/0CBT)
-/

@[expose] public noncomputable section

open IsLocalRing

universe u v

namespace Stacks.Curves

/-! ### The maximal ideal is generated by a lift of a cotangent basis -/

/-- Lifts of a basis of the cotangent space generate the maximal ideal. -/
theorem maximalIdeal_eq_span_of_cotangent_basis
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (x y : maximalIdeal R)
    (e : Module.Basis (BinaryIndex (ResidueField R)) (ResidueField R) (CotangentSpace R))
    (hx : e ⟨0⟩ = (maximalIdeal R).toCotangent x)
    (hy : e ⟨1⟩ = (maximalIdeal R).toCotangent y) :
    maximalIdeal R = Ideal.span {x.1, y.1} := by
  have he : Set.range e = (maximalIdeal R).toCotangent '' {x, y} := by
    ext z
    simp only [Set.mem_range, Set.image_pair, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨⟨i⟩, rfl⟩
      fin_cases i <;> simp [hx, hy]
    · rintro (rfl | rfl)
      · exact ⟨⟨0⟩, hx⟩
      · exact ⟨⟨1⟩, hy⟩
  have hspan : Submodule.span R ({x, y} : Set (maximalIdeal R)) = ⊤ :=
    CotangentSpace.span_image_eq_top_iff.mp (he ▸ e.span_eq)
  have h := congrArg (Submodule.map (maximalIdeal R).subtype) hspan
  simpa only [Submodule.map_span, Set.image_pair, Submodule.subtype_apply,
    Submodule.map_top, Submodule.range_subtype] using h.symm

/-- If `x`, `y` generate `𝔪` and `a x² + b x y + c y² ∈ 𝔪³` with `a` a unit, then
`𝔪² = (y) 𝔪`. -/
theorem maximalIdeal_sq_eq_span_mul_of_quadratic_relation
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (x y : maximalIdeal R) (hxy : maximalIdeal R = Ideal.span {x.1, y.1})
    (a b c : R) (ha : IsUnit a)
    (hq : a * x.1 ^ 2 + b * x.1 * y.1 + c * y.1 ^ 2 ∈ (maximalIdeal R) ^ 3) :
    (maximalIdeal R) ^ 2 = Ideal.span {y.1} * maximalIdeal R := by
  let m := maximalIdeal R
  let J := Ideal.span {y.1} * m
  have hJ : J ≤ m ^ 2 := by
    rw [pow_two]
    exact Ideal.mul_mono ((Ideal.span_singleton_le_iff_mem _).mpr y.2) le_rfl
  refine le_antisymm ?_ hJ
  apply Submodule.le_of_le_smul_of_le_jacobson_bot (m ^ 2).fg_of_isNoetherianRing
    (IsLocalRing.jacobson_eq_maximalIdeal _ bot_ne_top).ge
  rw [smul_eq_mul]
  show m ^ 2 ≤ J ⊔ m * m ^ 2
  rw [← pow_succ']
  have hle : J ≤ J ⊔ m ^ 3 := le_sup_left
  have hyJ : ∀ z ∈ m, y.1 * z ∈ J := fun z hz =>
    Ideal.mul_mem_mul (Ideal.subset_span (Set.mem_singleton y.1)) hz
  have hxyJ : x.1 * y.1 ∈ J := by
    rw [mul_comm]
    exact hyJ _ x.2
  have hyyJ : y.1 ^ 2 ∈ J := by
    rw [pow_two]
    exact hyJ _ y.2
  have hxx : x.1 ^ 2 ∈ J ⊔ m ^ 3 := by
    apply (Ideal.unit_mul_mem_iff_mem _ ha).mp
    have ht : b * x.1 * y.1 + c * y.1 ^ 2 ∈ J :=
      J.add_mem (by simpa only [mul_assoc] using J.mul_mem_left b hxyJ) (J.mul_mem_left c hyyJ)
    have hq' : a * x.1 ^ 2 + (b * x.1 * y.1 + c * y.1 ^ 2) ∈ J ⊔ m ^ 3 :=
      (show m ^ 3 ≤ J ⊔ m ^ 3 from le_sup_right) (by simpa only [add_assoc] using hq)
    exact (Ideal.add_mem_iff_left _ (hle ht)).mp hq'
  conv_lhs => rw [pow_two, show m = Ideal.span {x.1, y.1} from hxy,
    Ideal.span_pair_mul_span_pair]
  apply Ideal.span_le.mpr
  intro z hz
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
  rcases hz with rfl | rfl | rfl | rfl
  · rwa [← pow_two]
  · exact hle hxyJ
  · exact hle (hyJ _ x.2)
  · exact hle (hyJ _ y.2)

/-- In a reduced local ring with `𝔪² = (y) 𝔪`, a nonzero `y` is a nonzerodivisor. -/
theorem mem_nonZeroDivisors_of_maximalIdeal_sq_eq_span_mul
    {R : Type*} [CommRing R] [IsLocalRing R] [IsReduced R]
    (y : R) (hy : y ≠ 0)
    (hm : (maximalIdeal R) ^ 2 = Ideal.span {y} * maximalIdeal R) :
    y ∈ nonZeroDivisors R := by
  rw [mem_nonZeroDivisors_iff_right]
  intro z hz
  by_cases hu : IsUnit z
  · exact (hy (hu.mul_left_cancel (hz.trans (mul_zero z).symm))).elim
  have hz2 : z ^ 2 ∈ Ideal.span {y} * maximalIdeal R := hm ▸ Ideal.pow_mem_pow hu 2
  obtain ⟨w, hw, he⟩ := Ideal.mem_span_singleton_mul.mp hz2
  refine IsNilpotent.eq_zero ⟨3, ?_⟩
  calc
    z ^ 3 = z * z ^ 2 := by ring
    _ = z * (y * w) := by rw [he]
    _ = 0 := by rw [← mul_assoc, hz, zero_mul]

/-! ### Dividing a stable ideal by a generator: the affine blow-up chart -/

/-- Division by a fixed unit after the structural algebra map. -/
def divideLinearMap {R Q : Type*} [CommRing R] [CommRing Q] [Algebra R Q]
    (u : Qˣ) : R →ₗ[R] Q :=
  (LinearMap.mul R Q (↑(u⁻¹) : Q)).comp (Algebra.linearMap R Q)

/-- `divideLinearMap u` sends `x` to `u⁻¹ x`. -/
theorem divideLinearMap_apply {R Q : Type*} [CommRing R] [CommRing Q] [Algebra R Q]
    (u : Qˣ) (x : R) : divideLinearMap u x = ↑(u⁻¹) * algebraMap R Q x := rfl

/-- The affine blow-up chart `R[I/y]`: for an ideal with `I² = y I` and an `R`-algebra `Q` in
which `y` is invertible, the subalgebra of `Q` of the quotients `i / y` with `i ∈ I`. -/
def stableIdealQuotient {R Q : Type*} [CommRing R] [CommRing Q] [Algebra R Q]
    (I : Ideal R) (y : I) (u : Qˣ) (hu : (u : Q) = algebraMap R Q y.1)
    (hI : I * I = Ideal.span {y.1} * I) : Subalgebra R Q :=
  (Submodule.map (divideLinearMap u) I).toSubalgebra (by
    refine ⟨y.1, y.2, ?_⟩
    simp [divideLinearMap_apply, ← hu]) (by
    rintro z w ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
    have hab : a * b ∈ Ideal.span {y.1} * I :=
      hI ▸ Ideal.mul_mem_mul ha hb
    obtain ⟨c, hc, he⟩ := Ideal.mem_span_singleton_mul.mp hab
    refine ⟨c, hc, ?_⟩
    simp only [divideLinearMap_apply]
    apply u.isUnit.mul_left_cancel
    calc
      ↑u * (↑(u⁻¹) * algebraMap R Q c) = algebraMap R Q c := by simp
      _ = ↑(u⁻¹) * algebraMap R Q (a * b) := by rw [← he, map_mul, ← hu]; simp
      _ = ↑u * (↑(u⁻¹) * algebraMap R Q a *
          (↑(u⁻¹) * algebraMap R Q b)) := by
        rw [map_mul]
        simp [mul_left_comm, mul_comm])

/-- The chart `R[I/y]` of a finitely generated ideal is a finite `R`-module. -/
theorem stableIdealQuotient_finite {R Q : Type*} [CommRing R] [CommRing Q]
    [Algebra R Q] (I : Ideal R) (y : I) (u : Qˣ)
    (hu : (u : Q) = algebraMap R Q y.1)
    (hI : I * I = Ideal.span {y.1} * I) (hfg : I.FG) :
    Module.Finite R (stableIdealQuotient I y u hu hI) :=
  Module.Finite.of_fg (Submodule.FG.map (divideLinearMap u) hfg)

/-- Division by `y` is an `R`-linear isomorphism from `I` onto the chart. -/
def stableIdealQuotientLinearEquiv {R Q : Type*} [CommRing R] [CommRing Q]
    [Algebra R Q] (I : Ideal R) (y : I) (u : Qˣ)
    (hu : (u : Q) = algebraMap R Q y.1)
    (hI : I * I = Ideal.span {y.1} * I)
    (hinj : Function.Injective (algebraMap R Q)) :
    I ≃ₗ[R] stableIdealQuotient I y u hu hI :=
  LinearEquiv.ofBijective
    (((divideLinearMap u).comp I.subtype).codRestrict
      (stableIdealQuotient I y u hu hI).toSubmodule (fun z => ⟨z.1, z.2, rfl⟩)) (by
    refine ⟨fun z w h => Subtype.ext (hinj ((u⁻¹).isUnit.mul_left_cancel (congrArg Subtype.val h))),
      ?_⟩
    rintro ⟨z, a, ha, rfl⟩
    exact ⟨⟨a, ha⟩, rfl⟩)

/-- `stableIdealQuotientLinearEquiv` sends `x` to `x / y`. -/
theorem stableIdealQuotientLinearEquiv_apply {R Q : Type*}
    [CommRing R] [CommRing Q] [Algebra R Q]
    (I : Ideal R) (y : I) (u : Qˣ) (hu : (u : Q) = algebraMap R Q y.1)
    (hI : I * I = Ideal.span {y.1} * I)
    (hinj : Function.Injective (algebraMap R Q)) (x : I) :
    (stableIdealQuotientLinearEquiv I y u hu hI hinj x : Q) =
      ↑(u⁻¹) * algebraMap R Q x.1 := rfl

/-- Dividing an ideal with `I² = y I` identifies its cotangent module with the fibre of the
resulting finite algebra. -/
def stableIdealQuotientCotangentEquiv {R Q : Type*} [CommRing R] [CommRing Q]
    [Algebra R Q] (I : Ideal R) (y : I) (u : Qˣ)
    (hu : (u : Q) = algebraMap R Q y.1)
    (hI : I * I = Ideal.span {y.1} * I)
    (hinj : Function.Injective (algebraMap R Q)) :
    I.Cotangent ≃ₗ[R ⧸ I]
      (stableIdealQuotient I y u hu hI ⧸
        I.map (algebraMap R (stableIdealQuotient I y u hu hI))) := by
  let B := stableIdealQuotient I y u hu hI
  let e := stableIdealQuotientLinearEquiv I y u hu hI hinj
  let e₁ : I.Cotangent ≃ₗ[R] (B ⧸ (I.map (algebraMap R B)).restrictScalars R) :=
    Submodule.Quotient.equiv (I • ⊤) _ e (by
      rw [Submodule.map_smul'', Submodule.map_top]
      simp only [LinearEquiv.range, Ideal.smul_top_eq_map])
  let e₂ := e₁.trans (Submodule.Quotient.restrictScalarsEquiv R
    (I.map (algebraMap R B)))
  exact LinearEquiv.ofBijective
    (e₂.toLinearMap.extendScalarsOfSurjective Ideal.Quotient.mk_surjective) e₂.bijective

/-- `stableIdealQuotientCotangentEquiv` sends the class of `x` to the class of `x / y`. -/
theorem stableIdealQuotientCotangentEquiv_toCotangent {R Q : Type*}
    [CommRing R] [CommRing Q] [Algebra R Q]
    (I : Ideal R) (y : I) (u : Qˣ) (hu : (u : Q) = algebraMap R Q y.1)
    (hI : I * I = Ideal.span {y.1} * I)
    (hinj : Function.Injective (algebraMap R Q)) (x : I) :
    stableIdealQuotientCotangentEquiv I y u hu hI hinj (I.toCotangent x) =
      Ideal.Quotient.mk _ (stableIdealQuotientLinearEquiv I y u hu hI hinj x) := rfl

/-- If `I² = y I`, then `I³ = y² I`. -/
theorem cube_eq_span_sq_mul_of_sq_eq_span_mul
    {R : Type*} [CommRing R] (I : Ideal R) (y : R)
    (hI : I * I = Ideal.span {y} * I) :
    I ^ 3 = Ideal.span {y ^ 2} * I := by
  rw [show (3 : ℕ) = 2 + 1 from rfl, pow_succ I 2, pow_two I, hI, mul_assoc, hI, ← mul_assoc,
    Ideal.span_singleton_mul_span_singleton, pow_two]

/-- If `a x² + b x y + c y² ∈ I³`, then `t = x / y` satisfies `a t² + b t + c ∈ I B` in the
chart `B = R[I/y]`. -/
theorem stableIdealQuotient_quadratic_mem
    {R Q : Type*} [CommRing R] [CommRing Q] [Algebra R Q]
    (I : Ideal R) (x y : I) (u : Qˣ) (hu : (u : Q) = algebraMap R Q y.1)
    (hI : I * I = Ideal.span {y.1} * I)
    (hinj : Function.Injective (algebraMap R Q))
    (a b c : R) (hq : a * x.1 ^ 2 + b * x.1 * y.1 + c * y.1 ^ 2 ∈ I ^ 3) :
    let B := stableIdealQuotient I y u hu hI
    let t := stableIdealQuotientLinearEquiv I y u hu hI hinj x
    algebraMap R B a * t ^ 2 + algebraMap R B b * t + algebraMap R B c ∈
      I.map (algebraMap R B) := by
  let B := stableIdealQuotient I y u hu hI
  let t := stableIdealQuotientLinearEquiv I y u hu hI hinj x
  show algebraMap R B a * t ^ 2 + algebraMap R B b * t + algebraMap R B c ∈ _
  rw [cube_eq_span_sq_mul_of_sq_eq_span_mul I y.1 hI] at hq
  obtain ⟨d, hd, he⟩ := Ideal.mem_span_singleton_mul.mp hq
  have ht : algebraMap R B a * t ^ 2 + algebraMap R B b * t + algebraMap R B c =
      algebraMap R B d := by
    apply Subtype.ext
    show algebraMap R Q a * (↑(u⁻¹) * algebraMap R Q x.1) ^ 2 +
      algebraMap R Q b * (↑(u⁻¹) * algebraMap R Q x.1) + algebraMap R Q c =
        algebraMap R Q d
    apply (u ^ 2).isUnit.mul_left_cancel
    have huv : (u : Q) * ↑(u⁻¹) = 1 := Units.mul_inv u
    have hev := congrArg (algebraMap R Q) he
    simp only [map_mul, map_pow, map_add, ← hu] at hev
    simp only [Units.val_pow_eq_pow_val]
    calc
      (↑u : Q) ^ 2 * (algebraMap R Q a * (↑(u⁻¹) * algebraMap R Q x.1) ^ 2 +
          algebraMap R Q b * (↑(u⁻¹) * algebraMap R Q x.1) + algebraMap R Q c) =
          algebraMap R Q a * (↑u * ↑(u⁻¹)) ^ 2 * algebraMap R Q x.1 ^ 2 +
          algebraMap R Q b * algebraMap R Q x.1 * ↑u * (↑u * ↑(u⁻¹)) +
          algebraMap R Q c * (↑u : Q) ^ 2 := by ring
      _ = (↑u : Q) ^ 2 * algebraMap R Q d := by rw [huv]; simpa using hev.symm
  rw [ht]
  exact Ideal.mem_map_of_mem (algebraMap R B) hd

/-! ### A quadratic algebra with a known root -/

/-- A two-dimensional algebra containing a root `r` of a quadratic polynomial `f`, with `1, r`
linearly independent, is isomorphic to `K[X]/(f)`. -/
theorem adjoinRoot_equiv_of_basis
    {K L : Type*} [Field K] [CommRing L] [Nontrivial L] [Algebra K L]
    [FiniteDimensional K L]
    (f : Polynomial K) (hdeg : f.natDegree = 2)
    (r : L) (hr : Polynomial.aeval r f = 0)
    (hli : LinearIndependent K ![1, r])
    (hL : Module.finrank K L = 2) :
    Nonempty (AdjoinRoot f ≃ₐ[K] L) := by
  have hf : f ≠ 0 := by
    rintro rfl
    simp at hdeg
  let pb := AdjoinRoot.powerBasis hf
  have : FiniteDimensional K (AdjoinRoot f) := pb.basis.finiteDimensional_of_finite
  let e : AdjoinRoot f →ₐ[K] L :=
    AdjoinRoot.liftAlgHom f (Algebra.ofId K L) r hr
  let b : Module.Basis (Fin 2) K L :=
    basisOfLinearIndependentOfCardEqFinrank hli (by simp [hL])
  have hbasis : (b : Fin 2 → L) = ![1, r] := by
    dsimp [b]
    exact coe_basisOfLinearIndependentOfCardEqFinrank hli (by simp [hL])
  have hb0 : b 0 = (1 : L) := by simpa using congrFun hbasis 0
  have hb1 : b 1 = r := by simpa using congrFun hbasis 1
  have hsurj : Function.Surjective e := by
    intro y
    have hb := b.sum_repr y
    simp only [Fin.sum_univ_two] at hb
    rw [hb0, hb1] at hb
    refine ⟨algebraMap K (AdjoinRoot f) (b.repr y 0) +
      AdjoinRoot.root f * b.repr y 1, ?_⟩
    calc
      e (algebraMap K (AdjoinRoot f) (b.repr y 0) +
          AdjoinRoot.root f * b.repr y 1) =
          algebraMap K L (b.repr y 0) + r * algebraMap K L (b.repr y 1) := by
        show AdjoinRoot.liftAlgHom f (Algebra.ofId K L) r hr
          (AdjoinRoot.of f (b.repr y 0) + AdjoinRoot.root f *
            AdjoinRoot.of f (b.repr y 1)) = _
        rw [map_add, map_mul,
          AdjoinRoot.liftAlgHom_of f (Algebra.ofId K L) r hr,
          AdjoinRoot.liftAlgHom_root f (Algebra.ofId K L) r hr,
          AdjoinRoot.liftAlgHom_of f (Algebra.ofId K L) r hr]
        simp
      _ = y := by simpa [Algebra.smul_def, mul_comm] using hb
  have hsrc : Module.finrank K (AdjoinRoot f) = 2 := by
    show Module.finrank K (Polynomial K ⧸ Ideal.span {f}) = 2
    rw [finrank_quotient_span_eq_natDegree, hdeg]
  have hinj : Function.Injective e.toLinearMap :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (hsrc.trans hL.symm)).mpr hsurj
  exact ⟨AlgEquiv.ofBijective e ⟨hinj, hsurj⟩⟩

/-! ### The closed fibre of the chart -/

section

/-- The residue field of `R` acts on the closed fibre of any `R`-algebra. -/
abbrev residueFieldAlgebraQuotient
    {R S : Type*} [CommRing R] [IsLocalRing R] [CommRing S] [Algebra R S] :
    Algebra (IsLocalRing.ResidueField R)
      (S ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R S)) :=
  Ideal.Quotient.algebraQuotientMapQuotient

attribute [local instance] residueFieldAlgebraQuotient

/-- The closed fibre of the blow-up chart `R[𝔪/y]` is `κ[X]/(a X² + b X + c)`. -/
theorem stableIdealQuotient_fibre_equiv_adjoinRoot
    {R Q : Type*} [CommRing R] [IsLocalRing R] [CommRing Q] [Algebra R Q]
    (x y : maximalIdeal R) (u : Qˣ) (hu : (u : Q) = algebraMap R Q y.1)
    (hI : maximalIdeal R * maximalIdeal R = Ideal.span {y.1} * maximalIdeal R)
    (hinj : Function.Injective (algebraMap R Q))
    (e : Module.Basis (BinaryIndex (ResidueField R)) (ResidueField R) (CotangentSpace R))
    (hx : e ⟨0⟩ = (maximalIdeal R).toCotangent x)
    (hy : e ⟨1⟩ = (maximalIdeal R).toCotangent y)
    (a b c : R) (ha : residue R a ≠ 0)
    (hq : a * x.1 ^ 2 + b * x.1 * y.1 + c * y.1 ^ 2 ∈ (maximalIdeal R) ^ 3) :
    let B := stableIdealQuotient (maximalIdeal R) y u hu hI
    Nonempty ((B ⧸ (maximalIdeal R).map (algebraMap R B)) ≃ₐ[ResidueField R]
      AdjoinRoot (Polynomial.C (residue R a) * Polynomial.X ^ 2 +
        Polynomial.C (residue R b) * Polynomial.X + Polynomial.C (residue R c))) := by
  let I := maximalIdeal R
  let B := stableIdealQuotient I y u hu hI
  let J := I.map (algebraMap R B)
  let t : B := stableIdealQuotientLinearEquiv I y u hu hI hinj x
  let r : B ⧸ J := Ideal.Quotient.mk J t
  let E : CotangentSpace R ≃ₗ[ResidueField R] (B ⧸ J) :=
    stableIdealQuotientCotangentEquiv I y u hu hI hinj
  let β : Module.Basis (Fin 2) (ResidueField R) (B ⧸ J) :=
    (e.reindex Equiv.ulift).map E
  have hβ0 : β 0 = r := by
    dsimp only [β]
    rw [Module.Basis.map_apply, Module.Basis.reindex_apply]
    show E (e ⟨0⟩) = r
    rw [hx]
    rfl
  have hβ1 : β 1 = 1 := by
    dsimp only [β]
    rw [Module.Basis.map_apply, Module.Basis.reindex_apply]
    show E (e ⟨1⟩) = 1
    rw [hy]
    show Ideal.Quotient.mk J (stableIdealQuotientLinearEquiv I y u hu hI hinj y) = 1
    have h : stableIdealQuotientLinearEquiv I y u hu hI hinj y = 1 := by
      apply Subtype.ext
      show ↑(u⁻¹) * algebraMap R Q y.1 = 1
      rw [← hu]
      simp
    rw [h, map_one]
  have hdim : Module.finrank (ResidueField R) (B ⧸ J) = 2 := by
    simpa using Module.finrank_eq_card_basis β
  have : Nontrivial (B ⧸ J) := Module.nontrivial_of_finrank_pos (by rw [hdim]; decide)
  have : FiniteDimensional (ResidueField R) (B ⧸ J) := β.finiteDimensional_of_finite
  have heq : β ∘ Equiv.swap (0 : Fin 2) 1 = ![1, r] := by
    funext i
    fin_cases i <;> simp [hβ0, hβ1]
  have hli : LinearIndependent (ResidueField R) ![1, r] :=
    heq ▸ β.linearIndependent.comp (Equiv.swap 0 1) (Equiv.swap 0 1).injective
  have hr : Polynomial.aeval r
      (Polynomial.C (residue R a) * Polynomial.X ^ 2 +
        Polynomial.C (residue R b) * Polynomial.X + Polynomial.C (residue R c)) = 0 := by
    have hzero := Ideal.Quotient.eq_zero_iff_mem.mpr
      (stableIdealQuotient_quadratic_mem I x y u hu hI hinj a b c hq)
    have hres (d : R) : algebraMap (ResidueField R) (B ⧸ J) (residue R d) =
        algebraMap R (B ⧸ J) d := rfl
    simp only [Polynomial.aeval_def, Polynomial.eval₂_add, Polynomial.eval₂_mul,
      Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C, hres]
    simpa only [map_add, map_mul, map_pow, Ideal.Quotient.mk_algebraMap] using hzero
  obtain ⟨f⟩ := adjoinRoot_equiv_of_basis _ (Polynomial.natDegree_quadratic ha) r hr hli hdim
  exact ⟨f.symm⟩

end

/-! ### The chart is the normalization -/

/-- In the chart `B = R[I/y]`, the extension of `I` is the principal ideal generated by `y`. -/
theorem stableIdealQuotient_map_eq_span
    {R Q : Type*} [CommRing R] [CommRing Q] [Algebra R Q]
    (I : Ideal R) (y : I) (u : Qˣ) (hu : (u : Q) = algebraMap R Q y.1)
    (hI : I * I = Ideal.span {y.1} * I)
    (hinj : Function.Injective (algebraMap R Q)) :
    let B := stableIdealQuotient I y u hu hI
    I.map (algebraMap R B) = Ideal.span {algebraMap R B y.1} := by
  let B := stableIdealQuotient I y u hu hI
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    show algebraMap R B a ∈ Ideal.span {algebraMap R B y.1}
    apply Ideal.mem_span_singleton.mpr
    refine ⟨stableIdealQuotientLinearEquiv I y u hu hI hinj ⟨a, ha⟩, ?_⟩
    apply Subtype.ext
    show algebraMap R Q a = algebraMap R Q y.1 * (↑(u⁻¹) * algebraMap R Q a)
    rw [← hu]
    simp
  · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr
      (Ideal.mem_map_of_mem (algebraMap R B) y.2))

/-- For an integral extension with injective structure map, the contraction of the extension of
a radical ideal `I` is contained in `I`. -/
theorem comap_map_le_of_isIntegral_of_isRadical
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Algebra.IsIntegral R S]
    (hinj : Function.Injective (algebraMap R S)) (I : Ideal R) (hI : I.IsRadical) :
    (I.map (algebraMap R S)).comap (algebraMap R S) ≤ I := by
  conv_rhs => rw [← hI.radical, Ideal.radical_eq_sInf]
  apply le_sInf
  intro p hp
  have : p.IsPrime := hp.2
  obtain ⟨P, _, hP, he⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p (⊥ : Ideal S) (by
    intro x hx
    obtain rfl : x = 0 := hinj ((show algebraMap R S x = 0 from hx).trans (map_zero _).symm)
    exact p.zero_mem)
  exact (Ideal.comap_mono (Ideal.map_le_iff_le_comap.mpr (hp.1.trans he.ge))).trans he.le

/-- Let `y ∈ B` be invertible in `Q`, with `(y)` radical in `B`. An element `z` of `Q` integral
over `B` with `y z ∈ B` lies in `B`. -/
theorem mem_of_mul_mem_of_isIntegral_of_isRadical
    {R Q : Type*} [CommRing R] [CommRing Q] [Algebra R Q]
    (B : Subalgebra R Q) (y : B) (hy : IsUnit (y : Q))
    (hrad : (Ideal.span {y}).IsRadical) (z : Q) (hz : IsIntegral B z)
    (hyz : (y : Q) * z ∈ B) : z ∈ B := by
  let C := Algebra.adjoin B {z}
  have : Module.Finite B C := Algebra.finite_adjoin_simple_of_isIntegral hz
  have hinj : Function.Injective (algebraMap B C) := fun a b h =>
    Subtype.ext (congrArg (fun c : C => (c : Q)) h)
  let b : B := ⟨(y : Q) * z, hyz⟩
  have hb : algebraMap B C b ∈ (Ideal.span {y}).map (algebraMap B C) := by
    rw [Ideal.map_span, Set.image_singleton]
    apply Ideal.mem_span_singleton.mpr
    exact ⟨⟨z, Algebra.subset_adjoin (Set.mem_singleton z)⟩, Subtype.ext rfl⟩
  have hb' := comap_map_le_of_isIntegral_of_isRadical hinj (Ideal.span {y}) hrad hb
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hb'
  have hz' : z = (c : Q) := hy.mul_left_cancel (congrArg Subtype.val hc)
  exact hz' ▸ c.2

open IsLocalRing

/-- A Noetherian local ring with `𝔪² ⊆ (y)` for some `y ∈ 𝔪` has dimension at most one. -/
theorem krullDimLE_one_of_maximalIdeal_sq_le_span
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (y : maximalIdeal R) (h : (maximalIdeal R) ^ 2 ≤ Ideal.span {y.1}) :
    Ring.KrullDimLE 1 R := by
  have hmin : maximalIdeal R ∈ (Ideal.span {y.1}).minimalPrimes := by
    refine ⟨⟨inferInstance, Ideal.span_le.mpr (Set.singleton_subset_iff.mpr y.2)⟩, ?_⟩
    intro p hp hpm z hz
    exact hp.1.mem_of_pow_mem 2 (hp.2 (h (Ideal.pow_mem_pow hz 2)))
  rw [Ring.krullDimLE_iff, ← maximalIdeal_height_eq_ringKrullDim]
  exact_mod_cast Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ _ hmin

/-- In a Noetherian local ring of dimension at most one, a power of each element of the maximal
ideal lies in the ideal generated by a given nonzerodivisor. -/
theorem exists_pow_mem_span_of_nonZeroDivisor
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    [Ring.KrullDimLE 1 R] (y : maximalIdeal R) (s : R) (hs : s ∈ nonZeroDivisors R) :
    ∃ n : ℕ, y.1 ^ n ∈ Ideal.span {s} := by
  have hfin : IsFiniteLength R (R ⧸ Ideal.span {s}) :=
    isFiniteLength_quotient_span_singleton R hs
  have : IsArtinianRing (R ⧸ Ideal.span {s}) :=
    isArtinian_of_tower R (isFiniteLength_iff_isNoetherian_isArtinian.mp hfin).2
  obtain ⟨n, hn⟩ := exists_maximalIdeal_pow_le_of_isArtinianRing_quotient (Ideal.span {s})
  exact ⟨n, hn (Ideal.pow_mem_pow y.2 n)⟩

/-- A finite subalgebra `B` of the fraction ring of a Noetherian local ring of dimension at most
one is the integral closure if the ideal of `B` generated by a nonzerodivisor `y ∈ 𝔪` is
radical. -/
theorem eq_integralClosure_of_finite_of_radical_span
    {R Q : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    [Ring.KrullDimLE 1 R] [CommRing Q] [Algebra R Q] [IsFractionRing R Q]
    (B : Subalgebra R Q) [Module.Finite R B]
    (y : maximalIdeal R) (hy : y.1 ∈ nonZeroDivisors R)
    (hrad : (Ideal.span {algebraMap R B y.1}).IsRadical) :
    B = integralClosure R Q := by
  apply le_antisymm
  · exact fun z hz => (IsIntegral.of_finite R (⟨z, hz⟩ : B)).map B.val
  · intro z hz
    have hzB : IsIntegral B z := (show IsIntegral R z from hz).tower_top
    have hu : IsUnit (algebraMap R Q y.1) :=
      IsLocalization.map_units Q (⟨y.1, hy⟩ : nonZeroDivisors R)
    obtain ⟨⟨a, s⟩, he⟩ := IsLocalization.mk'_surjective (nonZeroDivisors R) z
    obtain ⟨n, hn⟩ := exists_pow_mem_span_of_nonZeroDivisor y s.1 s.2
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.mp hn
    have hpow : algebraMap R Q y.1 ^ n * z ∈ B := by
      have hval : algebraMap R Q y.1 ^ n * z = algebraMap R Q (d * a) := by
        rw [← map_pow, hd, map_mul, ← he]
        calc
          algebraMap R Q s.1 * algebraMap R Q d * IsLocalization.mk' Q a s =
              algebraMap R Q d * (algebraMap R Q s.1 * IsLocalization.mk' Q a s) := by ring
          _ = algebraMap R Q (d * a) := by rw [IsLocalization.mk'_spec', map_mul]
      exact hval ▸ B.algebraMap_mem _
    clear he hd hn a d s
    induction n with
    | zero => simpa using hpow
    | succ n ih =>
      apply ih
      apply mem_of_mul_mem_of_isIntegral_of_isRadical B (algebraMap R B y.1) hu hrad
        (algebraMap R Q y.1 ^ n * z)
      · exact ((isIntegral_algebraMap (R := R) (A := Q)).pow n).tower_top.mul hzB
      · simpa only [Subalgebra.coe_algebraMap, pow_succ', mul_assoc] using hpow

/-! ### Nondegeneracy makes the polynomial quotient reduced -/

open Polynomial in
/-- `K[X]/(aX² + bX + c)` is reduced when `4ac - b²` is nonzero. -/
theorem isReduced_adjoinRoot_quadratic
    {K : Type*} [Field K] (a b c : K) (hd : 4 * a * c - b ^ 2 ≠ 0) :
    IsReduced (AdjoinRoot (C a * X ^ 2 + C b * X + C c)) := by
  let f : K[X] := C a * X ^ 2 + C b * X + C c
  have hder : derivative f = C (2 * a) * X + C b := by
    simp [f, derivative_mul, derivative_pow]
    ring
  have hid : C (4 * a) * f - derivative f ^ 2 = C (4 * a * c - b ^ 2) := by
    rw [hder]
    simp only [f, map_mul, map_sub, map_pow, map_ofNat]
    ring
  have hsep : f.Separable := by
    rw [separable_def']
    refine ⟨C (4 * a * c - b ^ 2)⁻¹ * C (4 * a),
      -(C (4 * a * c - b ^ 2)⁻¹ * derivative f), ?_⟩
    calc
      C (4 * a * c - b ^ 2)⁻¹ * C (4 * a) * f +
          -(C (4 * a * c - b ^ 2)⁻¹ * derivative f) * derivative f =
          C (4 * a * c - b ^ 2)⁻¹ * (C (4 * a) * f - derivative f ^ 2) := by ring
      _ = 1 := by rw [hid, ← map_mul, inv_mul_cancel₀ hd, map_one]
  exact (Ideal.isRadical_iff_quotient_reduced (Ideal.span {f})).mp
    (isRadical_iff_span_singleton.mp hsep.squarefree.isRadical)

/-! ### The quadratic algebra of a node -/

/-- The quadratic algebra of a node is isomorphic over the residue field `κ` to
`κ[X]/(a X² + b X + c)`, where `a`, `b`, `c` are the residues of the coefficients of a quadratic
relation `a x² + b x y + c y² ∈ 𝔪³` in lifted cotangent coordinates. -/
@[stacks 0CBT "three_descriptions"]
public theorem quadraticAlgebra_equiv_adjoinRoot (k : Type u) (A : Type v) [Field k] [CommRing A]
    [IsLocalRing A] [IsNoetherianRing A] [Algebra k A]
    (hA : IsNodalAlgebra k A)
    (x y : maximalIdeal A)
    (e : Module.Basis (BinaryIndex (ResidueField A)) (ResidueField A) (CotangentSpace A))
    (hx : e ⟨0⟩ = (maximalIdeal A).toCotangent x)
    (hy : e ⟨1⟩ = (maximalIdeal A).toCotangent y)
    (a b c : A) (ha : residue A a ≠ 0)
    (hdisc : residue A (4 * a * c - b ^ 2) ≠ 0)
    (hrelation : a * x.1 ^ 2 + b * x.1 * y.1 + c * y.1 ^ 2 ∈ (maximalIdeal A) ^ 3) :
    Nonempty (quadraticAlgebra A ≃ₐ[ResidueField A]
      AdjoinRoot (Polynomial.C (residue A a) * Polynomial.X ^ 2 +
        Polynomial.C (residue A b) * Polynomial.X + Polynomial.C (residue A c))) := by
  have hxy := maximalIdeal_eq_span_of_cotangent_basis x y e hx hy
  have hm := maximalIdeal_sq_eq_span_mul_of_quadratic_relation x y hxy a b c
    ((residue_ne_zero_iff_isUnit a).mp ha) hrelation
  have hy0 : y.1 ≠ 0 := by
    intro hz
    apply e.ne_zero ⟨1⟩
    rw [hy, show y = 0 from Subtype.ext hz, map_zero]
  have : IsReduced A := hA.2.1
  have hyr := mem_nonZeroDivisors_of_maximalIdeal_sq_eq_span_mul y.1 hy0 hm
  let Q := FractionRing A
  let u : Qˣ := (IsLocalization.map_units Q (⟨y.1, hyr⟩ : nonZeroDivisors A)).unit
  have hu : (u : Q) = algebraMap A Q y.1 := IsUnit.unit_spec _
  have hm' : maximalIdeal A * maximalIdeal A = Ideal.span {y.1} * maximalIdeal A := by
    simpa only [pow_two] using hm
  have hinj : Function.Injective (algebraMap A Q) := IsFractionRing.injective A Q
  let B := stableIdealQuotient (maximalIdeal A) y u hu hm'
  let J := (maximalIdeal A).map (algebraMap A B)
  let : Algebra (ResidueField A) (B ⧸ J) := residueFieldAlgebraQuotient
  obtain ⟨eB⟩ := stableIdealQuotient_fibre_equiv_adjoinRoot x y u hu hm' hinj
    e hx hy a b c ha hrelation
  have hd : 4 * residue A a * residue A c - residue A b ^ 2 ≠ 0 := by
    simpa only [map_sub, map_mul, map_pow, map_ofNat] using hdisc
  have : IsReduced (AdjoinRoot (Polynomial.C (residue A a) * Polynomial.X ^ 2 +
    Polynomial.C (residue A b) * Polynomial.X + Polynomial.C (residue A c))) :=
    isReduced_adjoinRoot_quadratic _ _ _ hd
  have hred : IsReduced (B ⧸ J) :=
    ⟨fun z hz => eB.injective ((hz.map eB.toRingHom).eq_zero.trans (map_zero eB).symm)⟩
  have hrad : (Ideal.span {algebraMap A B y.1}).IsRadical := by
    rw [← stableIdealQuotient_map_eq_span (maximalIdeal A) y u hu hm' hinj]
    exact (Ideal.isRadical_iff_quotient_reduced J).mpr hred
  have : Module.Finite A B := stableIdealQuotient_finite _ _ _ _ _
    (maximalIdeal A).fg_of_isNoetherianRing
  have : Ring.KrullDimLE 1 A := krullDimLE_one_of_maximalIdeal_sq_le_span y
    (hm.le.trans Ideal.mul_le_left)
  have hB : B = integralClosure A Q :=
    eq_integralClosure_of_finite_of_radical_span B y hyr hrad
  let eN : B ≃ₐ[A] integralClosure A Q := Subalgebra.equivOfEq B _ hB
  let eF : (B ⧸ J) ≃ₐ[A] quadraticAlgebra A :=
    Ideal.quotientEquivAlg J _ eN (by
      dsimp only [J]
      rw [Ideal.map_map]
      congr 1)
  let eκ : (B ⧸ J) ≃ₐ[ResidueField A] quadraticAlgebra A :=
    { __ := eF.toRingEquiv
      commutes' r := by
        obtain ⟨a, rfl⟩ := residue_surjective r
        show eF (algebraMap A (B ⧸ J) a) = algebraMap A _ a
        exact eF.commutes a }
  exact ⟨eκ.symm.trans eB⟩

end Stacks.Curves

end
