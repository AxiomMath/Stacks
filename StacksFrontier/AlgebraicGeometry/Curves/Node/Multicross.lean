module

public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.MvPowerSeries.Substitution
public import Mathlib.RingTheory.PowerSeries.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# The two-branch multicross ring is the completed local ring of a node

The multicross ring with `n` branches over a commutative ring `k` is the subring of
`Fin n → k[[t]]` consisting of the tuples of one-variable power series whose constant
coefficients all agree. It is the completed local ring at a multicross singularity, and for
`n = 2` at a node (an ordinary double point).

This file identifies the two-branch multicross ring with the power-series hypersurface
`k[[x, y]]/(xy)`. The isomorphism is induced by the map `branchHom` sending a series `f` in two
variables to the pair `(f(x, 0), f(0, y))` of its restrictions to the two coordinate axes.

## Main definitions

* `Stacks.Curves.multicross` — the multicross ring, as a subring of `Fin n → k[[t]]`.
* `Stacks.Curves.multicrossAlgebra` — its algebra structure over the coefficient ring, the
  diagonal of the constant-series embedding.
* `Stacks.Curves.branchHom` — restriction of a two-variable series to the two coordinate axes.
* `Stacks.Curves.multicrossBranchHom` — the same map with codomain the two-branch multicross
  ring.

## Main results

* `Stacks.Curves.coeff_branchHom` — the coefficients of the two branches of a series.
* `Stacks.Curves.ker_branchHom` — the kernel of `branchHom` is generated by `xy`.
* `Stacks.Curves.multicrossBranchHom_surjective` — every element of the multicross ring is a
  pair of branches.
* `Stacks.Curves.quotientAlgEquivMulticross` — `k[[x, y]]/(xy) ≃ₐ[k] multicross k 2`.

## References

* [Stacks Project, Tag 0C1U](https://stacks.math.columbia.edu/tag/0C1U)
* [Stacks Project, Tag 0C1W](https://stacks.math.columbia.edu/tag/0C1W)
* [Stacks Project, Tag 0C4D](https://stacks.math.columbia.edu/tag/0C4D)
-/

@[expose] public noncomputable section

open MvPowerSeries

universe u

namespace Stacks.Curves

variable {k : Type u} [CommRing k]

/-- The ring of `n`-tuples of formal power series having the same constant coefficient. -/
@[stacks 0C1U]
def multicross (k : Type*) [CommRing k] (n : ℕ) : Subring (Fin n → PowerSeries k) where
  carrier := { f | ∀ i j, PowerSeries.constantCoeff (f i) = PowerSeries.constantCoeff (f j) }
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by intro f g hf hg i j; simp only [Pi.add_apply, map_add]; rw [hf i j, hg i j]
  mul_mem' := by intro f g hf hg i j; simp only [Pi.mul_apply, map_mul]; rw [hf i j, hg i j]
  neg_mem' := by intro f hf i j; simp only [Pi.neg_apply, map_neg]; rw [hf i j]

/-- A tuple belongs to the multicross ring exactly when all of its constant coefficients
agree. -/
@[simp]
theorem mem_multicross {n : ℕ} (f : Fin n → PowerSeries k) :
    f ∈ multicross k n ↔
      ∀ i j, PowerSeries.constantCoeff (f i) = PowerSeries.constantCoeff (f j) :=
  Iff.rfl

/-- The diagonal embedding of the coefficient ring into the multicross ring, as constant
power series in every branch. -/
def multicrossC (k : Type*) [CommRing k] (n : ℕ) : k →+* ↥(multicross k n) :=
  RingHom.codRestrict (RingHom.pi fun _ : Fin n ↦ (PowerSeries.C : k →+* PowerSeries k))
    (multicross k n) fun a ↦ (mem_multicross _).2 fun i j ↦ by
      simp only [RingHom.pi_apply, PowerSeries.constantCoeff_C]

/-- The coefficient algebra structure on the multicross ring. -/
instance multicrossAlgebra (k : Type*) [CommRing k] (n : ℕ) : Algebra k ↥(multicross k n) :=
  RingHom.toAlgebra (multicrossC k n)

/-- The substitution family cutting out the `i`-th coordinate axis: the `i`-th variable is sent
to the one-variable variable and the other one to zero. -/
def branchSubst (i : Fin 2) : Fin 2 → PowerSeries k :=
  fun j ↦ if j = i then PowerSeries.X else 0

/-- `branchSubst i` sends the `i`-th variable to the one-variable variable. -/
@[simp]
theorem branchSubst_self (i : Fin 2) : branchSubst (k := k) i i = PowerSeries.X := by
  simp [branchSubst]

/-- `branchSubst i` sends every variable other than the `i`-th to zero. -/
theorem branchSubst_of_ne {i j : Fin 2} (h : j ≠ i) : branchSubst (k := k) i j = 0 := by
  simp [branchSubst, h]

/-- The branch substitution family has zero constant coefficients, hence is substitutable. -/
theorem hasSubst_branchSubst (i : Fin 2) : HasSubst (branchSubst (k := k) i) :=
  hasSubst_of_constantCoeff_zero (by
    intro j
    rcases eq_or_ne j i with rfl | h
    · rw [branchSubst_self]
      exact MvPowerSeries.constantCoeff_X ()
    · simp [branchSubst_of_ne h])

/-- A power at a one-point exponent evaluates the family at that point. -/
private theorem prod_pow_single {a : Fin 2 → PowerSeries k} {i : Fin 2} (m : ℕ) :
    ((Finsupp.single i m).prod fun s e ↦ (a s) ^ e) = (a i) ^ m :=
  Finsupp.prod_single_index (pow_zero _)

/-- A monomial in a family with a vanishing member vanishes as soon as that member occurs. -/
private theorem prod_pow_eq_zero {a : Fin 2 → PowerSeries k} {d : Fin 2 →₀ ℕ} {j : Fin 2}
    (haj : a j = 0) (hdj : d j ≠ 0) :
    (d.prod fun s e ↦ (a s) ^ e) = 0 :=
  Finset.prod_eq_zero (Finsupp.mem_support_iff.mpr hdj)
    (show (a j) ^ (d j) = 0 by rw [haj, zero_pow hdj])

/-- Restriction of a power series in two variables to the two coordinate axes. -/
def branchHom : MvPowerSeries (Fin 2) k →ₐ[k] (Fin 2 → PowerSeries k) :=
  AlgHom.pi fun i ↦ substAlgHom (hasSubst_branchSubst i)

/-- The `i`-th branch of `f` is the substitution of `branchSubst i` into `f`. -/
theorem branchHom_apply (f : MvPowerSeries (Fin 2) k) (i : Fin 2) :
    branchHom f i = subst (branchSubst i) f := by
  simp [branchHom, AlgHom.pi]

/-- The `n`-th coefficient of the `i`-th branch of `f` is the coefficient of `f` at the
monomial `x_i ^ n`. -/
theorem coeff_branchHom (f : MvPowerSeries (Fin 2) k) (i : Fin 2) (n : ℕ) :
    PowerSeries.coeff n (branchHom f i) = MvPowerSeries.coeff (Finsupp.single i n) f := by
  rw [branchHom_apply,
    show PowerSeries.coeff n (subst (branchSubst i) f)
      = MvPowerSeries.coeff (Finsupp.single () n) (subst (branchSubst i) f) from rfl,
    coeff_subst (hasSubst_branchSubst i) f (Finsupp.single () n),
    finsum_eq_single _ (Finsupp.single i n) ?_]
  · rw [prod_pow_single, branchSubst_self]
    simp [PowerSeries.coeff_X_pow]
  · intro d hd
    by_cases hsupp : ∀ j, j ≠ i → d j = 0
    · have hdi : d = Finsupp.single i (d i) := by
        refine Finsupp.ext fun j ↦ ?_
        rcases eq_or_ne j i with rfl | hji
        · simp
        · simp [hsupp j hji, Ne.symm hji]
      have hne : d i ≠ n := fun h ↦ hd (by rw [hdi, h])
      rw [hdi, prod_pow_single, branchSubst_self]
      simp [PowerSeries.coeff_X_pow, Ne.symm hne]
    · obtain ⟨j, hji, hdj⟩ := not_forall₂.1 hsupp
      simp [prod_pow_eq_zero (branchSubst_of_ne hji) hdj]

/-- Both branches of a constant series are that constant. -/
theorem branchHom_C (r : k) :
    branchHom (MvPowerSeries.C r) = fun _ : Fin 2 ↦ PowerSeries.C r := by
  funext i
  rw [branchHom_apply, subst_C, PowerSeries.C_apply]

/-- The two branches of a series have the same constant coefficient, namely that of the
series. -/
theorem branchHom_mem_multicross (f : MvPowerSeries (Fin 2) k) :
    branchHom f ∈ multicross k 2 :=
  (mem_multicross _).2 fun i j ↦ by
    simp only [← PowerSeries.coeff_zero_eq_constantCoeff_apply, coeff_branchHom,
      Finsupp.single_zero]

/-- An exponent in two variables not involving the second is a power of the first. -/
private theorem eq_single_zero {d : Fin 2 →₀ ℕ} (h : d 1 = 0) :
    d = Finsupp.single 0 (d 0) := by
  refine Finsupp.ext fun j ↦ ?_
  fin_cases j <;> simp [h]

/-- An exponent in two variables not involving the first is a power of the second. -/
private theorem eq_single_one {d : Fin 2 →₀ ℕ} (h : d 0 = 0) :
    d = Finsupp.single 1 (d 1) := by
  refine Finsupp.ext fun j ↦ ?_
  fin_cases j <;> simp [h]

/-- The product of the two variables is the monomial `xy`. -/
theorem X_mul_X_eq_monomial :
    (X 0 : MvPowerSeries (Fin 2) k) * X 1 =
      monomial (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) 1 := by
  rw [X_def, X_def, monomial_mul_monomial, one_mul]

/-- An exponent fails to dominate `xy` exactly when one of the two variables is absent. -/
private theorem notLe_iff (d : Fin 2 →₀ ℕ) :
    ¬ (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1 ≤ d) ↔
      d 0 = 0 ∨ d 1 = 0 := by
  rw [Finsupp.le_def]
  simp only [not_forall]
  constructor
  · rintro ⟨s, hs⟩
    fin_cases s <;> simp_all
  · rintro (h | h)
    · exact ⟨0, by simp [h]⟩
    · exact ⟨1, by simp [h]⟩

/-- A series in two variables, shifted down by one in each variable. For a series all of whose
monomials involve both variables this is the quotient by `xy`. -/
def divXMulX (f : MvPowerSeries (Fin 2) k) : MvPowerSeries (Fin 2) k :=
  fun d ↦ MvPowerSeries.coeff
    (d + (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1)) f

/-- The coefficient of `divXMulX f` at `d` is the coefficient of `f` at `d` shifted up by one in
each variable. -/
theorem coeff_divXMulX (f : MvPowerSeries (Fin 2) k) (d : Fin 2 →₀ ℕ) :
    MvPowerSeries.coeff d (divXMulX f) =
      MvPowerSeries.coeff (d + (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1)) f :=
  rfl

/-- A series in two variables none of whose monomials is a pure power of a single variable is
divisible by `xy`. -/
theorem mem_span_X_mul_X_of_coeff_single_eq_zero {f : MvPowerSeries (Fin 2) k}
    (hc : ∀ (i : Fin 2) (n : ℕ), MvPowerSeries.coeff (Finsupp.single i n) f = 0) :
    f ∈ Ideal.span {(X 0 : MvPowerSeries (Fin 2) k) * X 1} := by
  refine Ideal.mem_span_singleton.2 ⟨divXMulX f, MvPowerSeries.ext fun d ↦ ?_⟩
  rw [X_mul_X_eq_monomial, coeff_monomial_mul]
  by_cases hle : Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1 ≤ d
  · rw [ite_eq_left hle, one_mul, coeff_divXMulX, tsub_add_cancel_of_le hle]
  · rw [ite_eq_right hle]
    rcases (notLe_iff d).1 hle with h | h
    · rw [eq_single_one h]
      exact hc 1 (d 1)
    · rw [eq_single_zero h]
      exact hc 0 (d 0)

/-- Both branches of `xy` vanish. -/
theorem branchHom_X_mul_X :
    branchHom ((X 0 : MvPowerSeries (Fin 2) k) * X 1) = 0 := by
  funext i
  rw [branchHom_apply, subst_mul (hasSubst_branchSubst i), subst_X (hasSubst_branchSubst i),
    subst_X (hasSubst_branchSubst i)]
  fin_cases i <;> simp [branchSubst]

/-- The series with prescribed branches: the two given series are laid along the two coordinate
axes, and all mixed monomials are zero. -/
def ofMulticross (g : Fin 2 → PowerSeries k) : MvPowerSeries (Fin 2) k :=
  fun d ↦ if d 1 = 0 then PowerSeries.coeff (d 0) (g 0)
    else if d 0 = 0 then PowerSeries.coeff (d 1) (g 1) else 0

/-- The coefficients of `ofMulticross g` are those of `g 0` along the first axis, those of `g 1`
along the second, and zero at the mixed monomials. -/
theorem coeff_ofMulticross (g : Fin 2 → PowerSeries k) (d : Fin 2 →₀ ℕ) :
    MvPowerSeries.coeff d (ofMulticross g) =
      if d 1 = 0 then PowerSeries.coeff (d 0) (g 0)
      else if d 0 = 0 then PowerSeries.coeff (d 1) (g 1) else 0 :=
  rfl

/-- A pair of power series with equal constant coefficients is the pair of branches of a series
in two variables. -/
theorem branchHom_ofMulticross {g : Fin 2 → PowerSeries k} (hg : g ∈ multicross k 2) :
    branchHom (ofMulticross g) = g := by
  funext i
  refine PowerSeries.ext fun n ↦ ?_
  rw [coeff_branchHom, coeff_ofMulticross]
  fin_cases i
  · simp
  · simp only [Fin.mk_one, Fin.isValue]
    rw [Finsupp.single_eq_same,
      Finsupp.single_eq_of_ne' (show (1 : Fin 2) ≠ 0 by decide)]
    split_ifs with hn
    · subst hn
      rw [PowerSeries.coeff_zero_eq_constantCoeff_apply,
        PowerSeries.coeff_zero_eq_constantCoeff_apply]
      exact hg 0 1
    · rfl
    · simp at *

/-- The kernel of the branch map is the ideal generated by `xy`. -/
theorem ker_branchHom :
    RingHom.ker (branchHom (k := k)).toRingHom =
      Ideal.span {(X 0 : MvPowerSeries (Fin 2) k) * X 1} := by
  apply le_antisymm
  · intro f hf
    refine mem_span_X_mul_X_of_coeff_single_eq_zero fun i n ↦ ?_
    rw [← coeff_branchHom, show branchHom f = 0 from hf]
    simp
  · exact (Ideal.span_singleton_le_iff_mem _).2 branchHom_X_mul_X

/-- Restriction to the two coordinate axes, as an algebra map to the two-branch multicross
ring. -/
def multicrossBranchHom : MvPowerSeries (Fin 2) k →ₐ[k] ↥(multicross k 2) where
  toRingHom :=
    RingHom.codRestrict (branchHom (k := k)).toRingHom (multicross k 2) branchHom_mem_multicross
  commutes' := fun r ↦ Subtype.ext (branchHom_C r)

/-- Every element of the two-branch multicross ring is the pair of branches of a series in two
variables. -/
theorem multicrossBranchHom_surjective :
    Function.Surjective (multicrossBranchHom (k := k)) := fun y ↦
  ⟨ofMulticross y.1, Subtype.ext (branchHom_ofMulticross y.2)⟩

/-- The kernel of `multicrossBranchHom` is the ideal generated by `xy`. -/
theorem ker_multicrossBranchHom :
    RingHom.ker (multicrossBranchHom (k := k)).toRingHom =
      Ideal.span {(X 0 : MvPowerSeries (Fin 2) k) * X 1} := by
  rw [← ker_branchHom]
  ext f
  exact Subtype.ext_iff

/-- The two-branch multicross ring is isomorphic to `k[[x, y]]/(xy)`, the isomorphism carrying
the class of a series in two variables to the pair of its restrictions to the two coordinate
axes. -/
def quotientAlgEquivMulticross :
    (MvPowerSeries (Fin 2) k ⧸ Ideal.span {(X 0 : MvPowerSeries (Fin 2) k) * X 1}) ≃ₐ[k]
      ↥(multicross k 2) :=
  (Ideal.quotientEquivAlgOfEq k ker_multicrossBranchHom.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective multicrossBranchHom_surjective)

end Stacks.Curves

end
