module

public import StacksFrontier.AlgebraicGeometry.Curves.Node.Algebra
public import StacksFrontier.AlgebraicGeometry.Curves.NodeQuadraticAlgebra.QuadraticRelationDeltaOne
public import StacksFrontier.RingTheory.PowerSeries.BaseConstantCoeff
import all StacksFrontier.AlgebraicGeometry.Curves.Node.Algebra

/-!
# The power series with constant coefficient in a quadratic subfield are a node

Let `k` be a field and let `K` be a separable quadratic extension of `k`, so `K = k ⊕ kα` with
`α² = a₁ + a₂α` and `a₂² + 4a₁ ≠ 0`. The ring
```
R = {f \in K⟦s⟧ : f(0) \in k}
```
of `PowerSeries.constantCoeffInBase` is local and reduced, its maximal ideal `𝔪 = sK⟦s⟧` is
generated by `x = s` and `y = αs`, which satisfy `y² - a₂xy - a₁x² = 0`, and its cotangent space
is two-dimensional. So `R` carries a nondegenerate quadratic relation on its cotangent space, as
in `Stacks.Curves.IsNodalAlgebra`.

## Main results

* `PowerSeries.isLocalRing_constantCoeffInBase`: `R` is local.
* `PowerSeries.mem_maximalIdeal_iff`: the maximal ideal of `R` is `sK⟦s⟧`.
* `PowerSeries.isReduced_constantCoeffInBase`: `R` is reduced.
* `PowerSeries.span_pair_eq_maximalIdeal`: `𝔪 = (s, αs)`.
* `PowerSeries.finrank_cotangentSpace_eq_two`: the embedding dimension of `R` is two.
* `PowerSeries.hasNodalQuadraticRelation_constantCoeffInBase`: `R` carries a nodal quadratic
  relation, given a spanning pair `1, α` with nondegenerate quadratic relation.
* `Stacks.Curves.exists_quadratic_generator`: a separable quadratic extension is `k ⊕ kα` with
  `α² = a₁ + a₂α` of nonzero discriminant.
* `Stacks.Curves.hasNodalQuadraticRelation_constantCoeffInBase_of_isSeparable`: `R` carries a
  nodal quadratic relation when `K/k` is separable quadratic.

## Implementation notes

`IsNoetherianRing R` is a hypothesis of the statements that mention the cotangent space. It holds
by Eakin–Nagata (`K⟦s⟧` is Noetherian and a finite `R`-module), which is not in Mathlib.

## References

* [Stacks Project, Tag 0C4A](https://stacks.math.columbia.edu/tag/0C4A)
* [Stacks Project, Tag 0C49](https://stacks.math.columbia.edu/tag/0C49)
* [Stacks Project, Tag 0E3M](https://stacks.math.columbia.edu/tag/0E3M)
-/

@[expose] public noncomputable section

open IsLocalRing

universe u v

namespace PowerSeries

variable {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]

/-- A power series with vanishing constant coefficient has its constant coefficient in the base
field. -/
theorem mem_constantCoeffInBase_of_constantCoeff_eq_zero {f : PowerSeries K}
    (hf : constantCoeff f = 0) : f ∈ constantCoeffInBase k K :=
  ⟨0, by simp [hf]⟩

/-- The coefficientwise base change `k⟦s⟧ ⟶ K⟦s⟧`, as a ring map into the power series over `K`
with constant coefficient in `k`. -/
def baseHom (k : Type u) (K : Type v) [Field k] [Field K] [Algebra k K] :
    PowerSeries k →+* ↥(constantCoeffInBase k K) :=
  RingHom.codRestrict (PowerSeries.map (algebraMap k K)) (constantCoeffInBase k K)
    fun g => ⟨constantCoeff g, rfl⟩

/-- `PowerSeries.baseHom` is the coefficientwise base change. -/
@[simp]
theorem coe_baseHom (g : PowerSeries k) :
    ((baseHom k K g : ↥(constantCoeffInBase k K)) : PowerSeries K) =
      PowerSeries.map (algebraMap k K) g := rfl

/-- An element of `{f ∈ K⟦s⟧ : f(0) ∈ k}` is invertible there exactly when its constant
coefficient is nonzero. -/
theorem isUnit_iff_constantCoeff_ne_zero (f : ↥(constantCoeffInBase k K)) :
    IsUnit f ↔ constantCoeff (f : PowerSeries K) ≠ 0 := by
  refine ⟨fun hu => (isUnit_iff_constantCoeff.mp (hu.map (Subring.subtype _))).ne_zero,
    fun hne => ?_⟩
  obtain ⟨a, ha⟩ := f.2
  refine IsUnit.of_mul_eq_one ⟨(f : PowerSeries K)⁻¹, a⁻¹, ?_⟩ (Subtype.ext ?_)
  · rw [constantCoeff_inv, ← ha, map_inv₀]
  · exact PowerSeries.mul_inv_cancel _ hne

/-- `{f ∈ K⟦s⟧ : f(0) ∈ k}` contains `0` and `1`, which are distinct. -/
instance nontrivial_constantCoeffInBase :
    Nontrivial ↥(constantCoeffInBase k K) :=
  ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩⟩

/-- `{f ∈ K⟦s⟧ : f(0) ∈ k}` is a local ring. -/
instance isLocalRing_constantCoeffInBase :
    IsLocalRing ↥(constantCoeffInBase k K) := by
  refine IsLocalRing.of_isUnit_or_isUnit_of_isUnit_add fun a b hab => ?_
  rw [isUnit_iff_constantCoeff_ne_zero] at hab
  rw [isUnit_iff_constantCoeff_ne_zero, isUnit_iff_constantCoeff_ne_zero]
  by_cases ha : constantCoeff (a : PowerSeries K) = 0
  · refine Or.inr fun hb => hab ?_
    change constantCoeff ((a : PowerSeries K) + (b : PowerSeries K)) = 0
    rw [map_add, ha, hb, add_zero]
  · exact Or.inl ha

/-- The maximal ideal of `{f ∈ K⟦s⟧ : f(0) ∈ k}` consists of the power series with vanishing
constant coefficient, that is of all of `sK⟦s⟧`. -/
theorem mem_maximalIdeal_iff (f : ↥(constantCoeffInBase k K)) :
    f ∈ maximalIdeal ↥(constantCoeffInBase k K) ↔ constantCoeff (f : PowerSeries K) = 0 := by
  rw [mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_constantCoeff_ne_zero, not_not]

/-- `{f ∈ K⟦s⟧ : f(0) ∈ k}` is reduced. -/
instance isReduced_constantCoeffInBase : IsReduced ↥(constantCoeffInBase k K) :=
  isReduced_of_injective (Subring.subtype (constantCoeffInBase k K)) Subtype.val_injective

/-- The variable `s`, as an element of `{f ∈ K⟦s⟧ : f(0) ∈ k}`. -/
def genX (k : Type u) (K : Type v) [Field k] [Field K] [Algebra k K] :
    ↥(constantCoeffInBase k K) :=
  ⟨X, mem_constantCoeffInBase_of_constantCoeff_eq_zero (by simp)⟩

/-- The element `αs` of `{f ∈ K⟦s⟧ : f(0) ∈ k}`, for `α ∈ K`. -/
def genY (k : Type u) {K : Type v} [Field k] [Field K] [Algebra k K] (alpha : K) :
    ↥(constantCoeffInBase k K) :=
  ⟨C alpha * X, mem_constantCoeffInBase_of_constantCoeff_eq_zero (by simp)⟩

/-- `PowerSeries.genX` is the variable. -/
@[simp] theorem coe_genX :
    ((genX k K : ↥(constantCoeffInBase k K)) : PowerSeries K) = X := rfl

/-- `PowerSeries.genY` is `α` times the variable. -/
@[simp] theorem coe_genY (alpha : K) :
    ((genY k alpha : ↥(constantCoeffInBase k K)) : PowerSeries K) = C alpha * X := rfl

/-- `PowerSeries.genX` lies in the maximal ideal. -/
private theorem genX_mem_maximalIdeal :
    genX k K ∈ maximalIdeal ↥(constantCoeffInBase k K) :=
  (mem_maximalIdeal_iff _).mpr (by simp)

/-- `PowerSeries.genY` lies in the maximal ideal. -/
private theorem genY_mem_maximalIdeal (alpha : K) :
    genY k alpha ∈ maximalIdeal ↥(constantCoeffInBase k K) :=
  (mem_maximalIdeal_iff _).mpr (by simp)

/-- A power series over `K` splits as `g₁ + αg₂` with `g₁` and `g₂` over `k`, whenever `1, α`
spans `K` over `k`. -/
theorem exists_decomposition {alpha : K}
    (hspan : ∀ x : K, ∃ p q : k, x = algebraMap k K p + algebraMap k K q * alpha)
    (g : PowerSeries K) :
    ∃ g₁ g₂ : PowerSeries k,
      g = PowerSeries.map (algebraMap k K) g₁ +
        C alpha * PowerSeries.map (algebraMap k K) g₂ := by
  choose p q hpq using fun n : ℕ => hspan (coeff n g)
  refine ⟨mk p, mk q, PowerSeries.ext fun n => ?_⟩
  simp only [map_add, coeff_map, coeff_C_mul, coeff_mk]
  rw [hpq n]
  ring

/-- The maximal ideal of `{f ∈ K⟦s⟧ : f(0) ∈ k}` is generated by `s` and `αs`, when `1, α` spans
`K` over `k`. -/
theorem span_pair_eq_maximalIdeal {alpha : K}
    (hspan : ∀ x : K, ∃ p q : k, x = algebraMap k K p + algebraMap k K q * alpha) :
    Ideal.span {genX k K, genY k alpha} = maximalIdeal ↥(constantCoeffInBase k K) := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro z (rfl | rfl)
    exacts [genX_mem_maximalIdeal, genY_mem_maximalIdeal _]
  · intro f hf
    have h0 : constantCoeff (f : PowerSeries K) = 0 := (mem_maximalIdeal_iff f).mp hf
    obtain ⟨g, hg⟩ := (PowerSeries.X_dvd_iff).mpr h0
    obtain ⟨g₁, g₂, hgd⟩ := exists_decomposition hspan g
    refine Ideal.mem_span_pair.mpr ⟨baseHom k K g₁, baseHom k K g₂, Subtype.ext ?_⟩
    simp only [Subring.coe_add, Subring.coe_mul, coe_baseHom, coe_genX, coe_genY, hg, hgd]
    ring

/-- The constants of `k`, as elements of `{f ∈ K⟦s⟧ : f(0) ∈ k}`. -/
def baseC (k : Type u) (K : Type v) [Field k] [Field K] [Algebra k K] :
    k →+* ↥(constantCoeffInBase k K) :=
  (baseHom k K).comp PowerSeries.C

/-- `PowerSeries.baseC` is the constant power series. -/
@[simp] theorem coe_baseC (a : k) :
    ((baseC k K a : ↥(constantCoeffInBase k K)) : PowerSeries K) = C (algebraMap k K a) := by
  simp [baseC]

/-- The maximal ideal of `{f ∈ K⟦s⟧ : f(0) ∈ k}` is not principal as soon as some `α ∈ K` is not
in `k`. -/
theorem not_isPrincipal_maximalIdeal {alpha : K}
    (hnot : alpha ∉ Set.range (algebraMap k K)) :
    ¬ (maximalIdeal ↥(constantCoeffInBase k K)).IsPrincipal := by
  rintro ⟨t, ht⟩
  have htm : t ∈ maximalIdeal ↥(constantCoeffInBase k K) := by
    rw [ht]; exact Ideal.mem_span_singleton_self t
  have ht0 : constantCoeff (t : PowerSeries K) = 0 := (mem_maximalIdeal_iff t).mp htm
  obtain ⟨u, hu⟩ := (PowerSeries.X_dvd_iff).mpr ht0
  have hX := genX_mem_maximalIdeal (k := k) (K := K)
  have hY := genY_mem_maximalIdeal (k := k) alpha
  rw [ht] at hX hY
  obtain ⟨r₁, hr₁⟩ := Ideal.mem_span_singleton'.mp hX
  obtain ⟨r₂, hr₂⟩ := Ideal.mem_span_singleton'.mp hY
  have hXne : (X : PowerSeries K) ≠ 0 := PowerSeries.X_ne_zero
  have e₁ : (r₁ : PowerSeries K) * u = 1 := by
    have h := congrArg Subtype.val hr₁
    simp only [Subring.coe_mul, coe_genX, hu] at h
    exact mul_left_cancel₀ hXne (by linear_combination h)
  have e₂ : (r₂ : PowerSeries K) * u = C alpha := by
    have h := congrArg Subtype.val hr₂
    simp only [Subring.coe_mul, coe_genY, hu] at h
    exact mul_left_cancel₀ hXne (by linear_combination h)
  obtain ⟨a₁, ha₁⟩ := r₁.2
  obtain ⟨a₂, ha₂⟩ := r₂.2
  have c₁ := congrArg constantCoeff e₁
  have c₂ := congrArg constantCoeff e₂
  rw [map_mul, map_one, ← ha₁] at c₁
  rw [map_mul, constantCoeff_C, ← ha₂] at c₂
  have ha₁0 : a₁ ≠ 0 := by
    rintro rfl
    simp at c₁
  refine hnot ⟨a₂ / a₁, ?_⟩
  have hu0 : constantCoeff u = (algebraMap k K a₁)⁻¹ := eq_inv_of_mul_eq_one_right c₁
  rw [map_div₀, ← c₂, hu0]
  field_simp

/-- The embedding dimension of the Noetherian ring `{f ∈ K⟦s⟧ : f(0) ∈ k}` is two when `1, α`
spans `K` over `k` and `α ∉ k`. -/
theorem finrank_cotangentSpace_eq_two [IsNoetherianRing ↥(constantCoeffInBase k K)]
    {alpha : K}
    (hspan : ∀ x : K, ∃ p q : k, x = algebraMap k K p + algebraMap k K q * alpha)
    (hnot : alpha ∉ Set.range (algebraMap k K)) :
    Module.finrank (ResidueField ↥(constantCoeffInBase k K))
      (CotangentSpace ↥(constantCoeffInBase k K)) = 2 := by
  have hle : Module.finrank (ResidueField ↥(constantCoeffInBase k K))
      (CotangentSpace ↥(constantCoeffInBase k K)) ≤ 2 := by
    rw [← spanFinrank_maximalIdeal_eq_finrank_cotangentSpace,
      ← span_pair_eq_maximalIdeal hspan]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)).trans ?_
    exact (Set.ncard_insert_le _ _).trans (by simp)
  have hne1 : Module.finrank (ResidueField ↥(constantCoeffInBase k K))
      (CotangentSpace ↥(constantCoeffInBase k K)) ≠ 1 := fun h =>
    not_isPrincipal_maximalIdeal hnot
      (finrank_cotangentSpace_le_one_iff.mp (le_of_eq h))
  have hne0 : Module.finrank (ResidueField ↥(constantCoeffInBase k K))
      (CotangentSpace ↥(constantCoeffInBase k K)) ≠ 0 := fun h => by
    have hXne : genX k K ≠ 0 := fun hz => X_ne_zero (R := K) (congrArg Subtype.val hz)
    obtain ⟨y, hy⟩ := (finrank_cotangentSpace_eq_zero_iff.mp h).mul_inv_cancel hXne
    exact (isUnit_iff_constantCoeff_ne_zero _).mp (.of_mul_eq_one y hy) (by simp)
  omega

/-- The Noetherian ring `{f ∈ K⟦s⟧ : f(0) ∈ k}` carries a nodal quadratic relation, when `1, α`
spans `K` over `k`, `α ∉ k`, and `α² = a₁ + a₂α` with nonzero discriminant `a₂² + 4a₁`. -/
theorem hasNodalQuadraticRelation_constantCoeffInBase
    [IsNoetherianRing ↥(constantCoeffInBase k K)]
    {alpha : K} {a₁ a₂ : k}
    (hspan : ∀ x : K, ∃ p q : k, x = algebraMap k K p + algebraMap k K q * alpha)
    (hnot : alpha ∉ Set.range (algebraMap k K))
    (halpha : alpha ^ 2 = algebraMap k K a₁ + algebraMap k K a₂ * alpha)
    (hdisc : a₂ ^ 2 + 4 * a₁ ≠ 0) :
    Stacks.Curves.HasNodalQuadraticRelation ↥(constantCoeffInBase k K) := by
  refine (Stacks.Curves.hasNodalQuadraticRelation_iff_exists_generating_pair _).mpr
    ⟨genX k K, genY k alpha, baseC k K (-a₁), baseC k K (-a₂), 1,
      genX_mem_maximalIdeal, genY_mem_maximalIdeal _, span_pair_eq_maximalIdeal hspan,
      finrank_cotangentSpace_eq_two hspan hnot, ?_, ?_⟩
  · have hcomb : (4 : ↥(constantCoeffInBase k K)) * baseC k K (-a₁) * 1 -
        baseC k K (-a₂) ^ 2 = baseC k K (4 * (-a₁) * 1 - (-a₂) ^ 2) := by
      rw [map_sub, map_mul, map_mul, map_pow, map_one, map_ofNat]
    rw [hcomb, Ne, residue_eq_zero_iff, mem_maximalIdeal_iff, coe_baseC, constantCoeff_C]
    exact fun h => hdisc
      (by linear_combination -(algebraMap k K).injective (h.trans (map_zero _).symm))
  · have hzero : baseC k K (-a₁) * genX k K ^ 2 +
        baseC k K (-a₂) * genX k K * genY k alpha +
        (1 : ↥(constantCoeffInBase k K)) * genY k alpha ^ 2 = 0 := by
      refine Subtype.ext ?_
      have h := congrArg (C (R := K)) halpha
      simp only [map_add, map_mul, map_pow] at h
      push_cast
      simp only [Subring.coe_neg, coe_baseC, coe_genX, coe_genY, map_neg]
      linear_combination (X : PowerSeries K) ^ 2 * h
    exact Set.mem_of_eq_of_mem hzero (Ideal.zero_mem _)

end PowerSeries

namespace Stacks.Curves

/-- A separable quadratic extension `K/k` is `k ⊕ kα` for an `α ∉ k` satisfying a quadratic
relation `α² = a₁ + a₂α` of nonzero discriminant `a₂² + 4a₁`. -/
theorem exists_quadratic_generator (k K : Type*) [Field k] [Field K] [Algebra k K]
    [Algebra.IsSeparable k K] (hrank : Module.finrank k K = 2) :
    ∃ (alpha : K) (a₁ a₂ : k),
      (∀ x : K, ∃ p q : k, x = algebraMap k K p + algebraMap k K q * alpha) ∧
        alpha ∉ Set.range (algebraMap k K) ∧
        alpha ^ 2 = algebraMap k K a₁ + algebraMap k K a₂ * alpha ∧
        a₂ ^ 2 + 4 * a₁ ≠ 0 := by
  classical
  have : FiniteDimensional k K := Module.finite_of_finrank_pos (by omega)
  have hex : ∃ alpha : K, alpha ∉ Set.range (algebraMap k K) := by
    by_contra! h
    have h2 := (AlgEquiv.ofBijective (Algebra.ofId k K)
      ⟨(algebraMap k K).injective, h⟩).toLinearEquiv.finrank_eq
    rw [Module.finrank_self, hrank] at h2
    omega
  obtain ⟨alpha, hnotrange⟩ := hex
  have hli : LinearIndependent k ![(1 : K), alpha] := by
    rw [LinearIndependent.pair_iff]
    intro s t hst
    rw [Algebra.smul_def, Algebra.smul_def, mul_one] at hst
    by_cases ht : t = 0
    · subst ht
      rw [map_zero, zero_mul, add_zero] at hst
      exact ⟨(algebraMap k K).injective (by simpa using hst), rfl⟩
    · exfalso
      have ht' : algebraMap k K t ≠ 0 :=
        fun h => ht ((algebraMap k K).injective (by simpa using h))
      refine hnotrange ⟨-s / t, ?_⟩
      rw [map_div₀, map_neg]
      field_simp
      linear_combination -hst
  have hspantop : Submodule.span k (Set.range ![(1 : K), alpha]) = ⊤ :=
    Submodule.eq_top_of_finrank_eq (by rw [finrank_span_eq_card hli]; simp [hrank])
  have hspan : ∀ x : K, ∃ p q : k, x = algebraMap k K p + algebraMap k K q * alpha := by
    intro x
    have hx : x ∈ Submodule.span k (Set.range ![(1 : K), alpha]) := hspantop ▸ Submodule.mem_top
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun k).mp hx
    exact ⟨c 0, c 1, by simp [← hc, Fin.sum_univ_two, Algebra.smul_def]⟩
  obtain ⟨a₁, a₂, hrel⟩ := hspan (alpha ^ 2)
  refine ⟨alpha, a₁, a₂, hspan, hnotrange, hrel, ?_⟩
  exact Stacks.Curves.discrim_ne_zero_of_isSeparable K alpha a₂ a₁ hli
    (by rw [hrel, Algebra.smul_def, Algebra.smul_def, mul_one]; ring)

/-- If `K/k` is a separable quadratic extension, then the Noetherian ring of power series over
`K` whose constant coefficient lies in `k` carries a nodal quadratic relation. -/
theorem hasNodalQuadraticRelation_constantCoeffInBase_of_isSeparable
    (k K : Type u) [Field k] [Field K] [Algebra k K] [Algebra.IsSeparable k K]
    [IsNoetherianRing ↥(PowerSeries.constantCoeffInBase k K)]
    (hrank : Module.finrank k K = 2) :
    HasNodalQuadraticRelation ↥(PowerSeries.constantCoeffInBase k K) := by
  obtain ⟨alpha, a₁, a₂, hspan, hnot, hrel, hdisc⟩ := exists_quadratic_generator k K hrank
  exact PowerSeries.hasNodalQuadraticRelation_constantCoeffInBase hspan hnot hrel hdisc

end Stacks.Curves

end
