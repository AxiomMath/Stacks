/-!
# Uniqueness of the stable contraction

Let `X` be a proper curve over a field `k` with `H⁰(X, 𝒪_X) = k`, at-worst-nodal singularities
and genus `g ≥ 2`. Two stable contractions `c : X ⟶ Y`, `c' : X ⟶ Y'` (conditions (1)–(3) of
[Stacks, Tag 0E7Q]) are related by a unique isomorphism `e : Y ≅ Y'` with `c ≫ e = c'`.

## Main results

All names are in the namespace `Stacks.Curves.StableModel`.

* `tensorSheafNPowIsoTensorPower`: the natural tensor powers `ℒ^{⊗ n}` agree with the integer
  tensor powers of [Stacks, Tag 01CU] for invertible `ℒ`.
* `isZero_cohomologyOverField_one_tensorSheafNPow_dualizingSheafOverField`:
  `H^1(X, ω_X^{⊗ (n+1)}) = 0` when `ω_X^{⊗ n}` is globally generated of positive degree
  ([Stacks, Tag 0B62]).
* `IsStableContraction.isInvertible_dualizingSheafOverField_subscheme`: the dualizing sheaf of an
  integral one-dimensional subcurve of the target is invertible.
* `IsStableContraction.nonempty_pullback_iso_dualizingSheafOverField`: [Stacks, Tag 0E7P] for a
  stable contraction, `c^*ω_Y ≅ ω_X`.

## References

* [Stacks Project, Tag 0E7Q](https://stacks.math.columbia.edu/tag/0E7Q)
* [Stacks Project, Tag 0E7P](https://stacks.math.columbia.edu/tag/0E7P)
* [Stacks Project, Tag 0E3K](https://stacks.math.columbia.edu/tag/0E3K)
* [Stacks Project, Tag 0B62](https://stacks.math.columbia.edu/tag/0B62)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Curves.StableModel

open Stacks.Duality

section Powers

variable {X : Scheme.{u}}

/-- **The natural and the integer tensor powers of an invertible module agree**: both are
`(⋯(𝒪_X ⊗ ℒ) ⊗ ⋯) ⊗ ℒ`, the integer one by its successor comparison. -/
def tensorSheafNPowIsoTensorPower (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L] :
    (n : ℕ) → ((tensorSheafNPow X.toRingedSpace L n : X.Modules) ≅
      Stacks.SheafOfModules.Invertible.tensorPower X.presheaf X.ringCatSheaf.2 L n)
  | 0 => Iso.refl _
  | n + 1 => tensorSheafMapIso X.toRingedSpace (tensorSheafNPowIsoTensorPower L n) (Iso.refl L) ≪≫
      Stacks.SheafOfModules.Invertible.tensorPowerSuccIso X.presheaf X.ringCatSheaf.2 L n ≪≫
      Stacks.SheafOfModules.Invertible.tensorPowerReindex X.presheaf X.ringCatSheaf.2 L
        (by push_cast; rfl)

end Powers

section Vanishing

/-- **[Stacks, Tag 0B62] for the powers of `ω_X`**: if `deg ω_X > 0` and `ω_X^{⊗ n}`, `n ≥ 1`, is
generated by global sections, then `H^1(X, ω_X^{⊗ (n+1)}) = 0`, as
`ω_X^{⊗ (n+1)} ≅ ω_X ⊗ ω_X^{⊗ n}` and `ω_X^{⊗ n}` has positive degree, hence is not trivial. -/
theorem isZero_cohomologyOverField_one_tensorSheafNPow_dualizingSheafOverField
    (S : CohenMacaulayCurveSituation.{u})
    [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 (dualizingSheafOverField S.f)]
    (hdeg : 0 < invertibleCurveDegree S.k S.f S.dimension_one.le (dualizingSheafOverField S.f))
    (n : ℕ) (hn : 0 < n)
    (hgen : SheafOfModules.IsGeneratedByGlobalSections
      (Stacks.SheafOfModules.Invertible.tensorPower S.X.presheaf S.X.ringCatSheaf.2
        (dualizingSheafOverField S.f) n)) :
    IsZero (cohomologyOverField S.k S.f
      (tensorSheafNPow S.X.toRingedSpace (dualizingSheafOverField S.f) (n + 1)) 1) := by
  let := Stacks.SheafOfModules.Invertible.tensorPower_isInvertible S.X.presheaf
    S.X.ringCatSheaf.2 (dualizingSheafOverField S.f) n
  have hne : ¬ SheafOfModules.IsTrivial S.X.presheaf S.X.ringCatSheaf.2
      (Stacks.SheafOfModules.Invertible.tensorPower S.X.presheaf S.X.ringCatSheaf.2
        (dualizingSheafOverField S.f) n) := by
    rintro ⟨e⟩
    have h0 := invertibleCurveDegree_eq_zero_of_iso_unit S.k S.f S.dimension_one.le _ e
    rw [invertibleCurveDegree_tensorPower] at h0
    have hn' : (0 : ℤ) < n := by exact_mod_cast hn
    exact (mul_pos hn' hdeg).ne' h0
  exact (CohenMacaulayCurveSituation.isZero_firstCohomology_dualizingSheafOverField_tensor S _
    hgen.some hne).of_iso (cohomologyOverFieldIso S.k S.f
      (Stacks.Curves.DualizingPullback.tensorSheafNPowSuccIso (dualizingSheafOverField S.f) n ≪≫
        tensorSheafMapIso S.X.toRingedSpace (Iso.refl _)
          (tensorSheafNPowIsoTensorPower (dualizingSheafOverField S.f) n)) 1)

end Vanishing

section Contraction

variable {k : Type u} [Field k] {X Y : Scheme.{u}}

namespace IsStableContraction

variable {f : X ⟶ Spec (.of k)} {gY : Y ⟶ Spec (.of k)} {c : X ⟶ Y}

/-- The target of a stable contraction of a connected curve is connected. -/
theorem connectedSpace [IsProper f] [ConnectedSpace X] (h : IsStableContraction f gY c) :
    ConnectedSpace Y := by
  have : IsProper gY := h.isProper
  have : IsProper (c ≫ gY) := by rw [h.comp_eq]; infer_instance
  have : IsProper c := IsProper.of_comp c gY
  have : Surjective c := c.surjective_of_isIso_app
    (Stacks.Curves.DualizingPullback.isIso_app_of_isIso_unitToPushforwardObjUnit c
      h.isIso_unitToPushforwardObjUnit)
  exact c.surjective.connectedSpace c.continuous

/-- **Integral one-dimensional subcurves of the target of a stable contraction have invertible
dualizing sheaves**: such a subcurve `D` is nodal (its points off the other components are
points of `Y`, the others are smooth on `D`), hence Gorenstein ([Stacks, Tag 0E37]), and it is
connected, so `ω_D` is invertible ([Stacks, Tag 0C19]). -/
theorem isInvertible_dualizingSheafOverField_subscheme [IsProper f] [ConnectedSpace X]
    (h : IsStableContraction f gY c) (D : Y.IdealSheafData) (hD : IsIntegral D.subscheme)
    (hdim : topologicalKrullDim D.subscheme = 1) :
    haveI : IsProper gY := h.isProper
    letI : Field Γ(D.subscheme, ⊤) :=
      (isField_of_universallyClosed k (D.subschemeι ≫ gY)).toField
    haveI : IsProper D.subscheme.toSpecΓ :=
      Stacks.AlgebraicGeometry.ProperGeomConnected.isProper_toSpecΓ (D.subschemeι ≫ gY)
    SheafOfModules.IsInvertible D.subscheme.presheaf D.subscheme.ringCatSheaf.2
      (Stacks.Duality.dualizingSheafOverField D.subscheme.toSpecΓ) := by
  have : IsProper gY := h.isProper
  let : Field Γ(D.subscheme, ⊤) :=
    (isField_of_universallyClosed k (D.subschemeι ≫ gY)).toField
  have : IsProper D.subscheme.toSpecΓ :=
    Stacks.AlgebraicGeometry.ProperGeomConnected.isProper_toSpecΓ (D.subschemeι ≫ gY)
  let : Y.Over (Spec (.of k)) := ⟨gY⟩
  have : LocallyOfFiniteType (Y ↘ Spec (.of k)) := (inferInstance : LocallyOfFiniteType gY)
  have := h.connectedSpace
  have : IsNoetherian Y := isNoetherian_of_locallyOfFiniteType gY
  have hYeq : Equidimensional Y :=
    equidimensional_of_connectedSpace_of_topologicalKrullDim_eq_one h.topologicalKrullDim_eq
  have hDeq : Equidimensional D.subscheme := .of_preirreducibleSpace _
  have hnD := Stacks.Curves.hasAtWorstNodalSingularities_subscheme hYeq h.topologicalKrullDim_eq
    h.hasAtWorstNodalSingularities D hDeq hdim
  let : D.subscheme.Over (Spec (.of k)) := ⟨D.subschemeι ≫ gY⟩
  have : LocallyOfFiniteType (D.subscheme ↘ Spec (.of k)) :=
    (inferInstance : LocallyOfFiniteType (D.subschemeι ≫ gY))
  have : IsGorenstein D.subscheme :=
    Stacks.Curves.isGorenstein_of_hasAtWorstNodalSingularities k D.subscheme hDeq hdim hnD
  exact isInvertible_dualizingSheafOverField_of_connectedSpace Γ(D.subscheme, ⊤)
    D.subscheme.toSpecΓ hdim

/-- **[Stacks, Tag 0E7P] for a stable contraction of a connected nodal curve**: if
`H^1(X, ω_X^{⊗ m}) = 0` and `ω_X^{⊗ m}` is globally generated for some `m ≥ 1`, then
`c^*ω_Y ≅ ω_X`. Both curves are reduced and Gorenstein ([Stacks, Tag 0E37]). -/
theorem nonempty_pullback_iso_dualizingSheafOverField [IsProper f] [ConnectedSpace X]
    (h : IsStableContraction f gY c) (hdim : topologicalKrullDim X = 1)
    (hnodal : letI : X.Over (Spec (.of k)) := ⟨f⟩
      Stacks.Curves.HasAtWorstNodalSingularities k X)
    (m : ℕ) (hm : 1 ≤ m)
    (hH1 : IsZero (cohomologyOverField k f
      (tensorSheafNPow X.toRingedSpace (dualizingSheafOverField f) m) 1))
    (hgen : SheafOfModules.IsGeneratedByGlobalSections
      (tensorSheafNPow X.toRingedSpace (dualizingSheafOverField f) m : X.Modules)) :
    haveI := h.isProper
    Nonempty ((Scheme.Modules.pullback c).obj (dualizingSheafOverField gY) ≅
      dualizingSheafOverField f) := by
  have hf := h.comp_eq
  subst hf
  have : IsProper gY := h.isProper
  have := h.connectedSpace
  have := h.isReduced
  have : IsReduced X := by
    let : X.Over (Spec (.of k)) := ⟨c ≫ gY⟩
    have : LocallyOfFiniteType (X ↘ Spec (.of k)) := (inferInstance : LocallyOfFiniteType (c ≫ gY))
    exact Stacks.Curves.isReduced_of_hasAtWorstNodalSingularities k X hnodal
  have : IsGorenstein X := by
    let : X.Over (Spec (.of k)) := ⟨c ≫ gY⟩
    have : IsProper (X ↘ Spec (.of k)) := (inferInstance : IsProper (c ≫ gY))
    exact isGorenstein_of_connectedSpace_of_hasAtWorstNodalSingularities k X hdim hnodal
  have : IsGorenstein Y := by
    let : Y.Over (Spec (.of k)) := ⟨gY⟩
    have : IsProper (Y ↘ Spec (.of k)) := (inferInstance : IsProper gY)
    exact isGorenstein_of_connectedSpace_of_hasAtWorstNodalSingularities k Y
      h.topologicalKrullDim_eq h.hasAtWorstNodalSingularities
  exact Stacks.Curves.DualizingPullback.nonempty_pullback_dualizingSheafOverField_iso c gY
    h.isIso_unitToPushforwardObjUnit h.isZero_rightDerived_one hdim h.topologicalKrullDim_eq m hm
    hH1 hgen

end IsStableContraction

end Contraction

section Uniqueness

variable {k : Type u} [Field k] {X Y Y' : Scheme.{u}}

/-- **Uniqueness in [Stacks, Tag 0E7Q]**: let `X` be a proper curve over `k` with
`H⁰(X, 𝒪_X) = k`, at-worst-nodal singularities and genus `g ≥ 2`. Two stable contractions
`c : X ⟶ Y`, `c' : X ⟶ Y'` are related by a unique isomorphism `e : Y ≅ Y'` with `c ≫ e = c'`.

Both factor through a chain `t : X ⟶ X₁` of contractions of rational tails ending in a curve
without rational tails, as stable contractions `c₁`, `c₁'` of `X₁`
(`exists_comp_eq_of_isIteratedContractionOfRationalTails`). On `X₁` the module `ω^{⊗ 3}` is
globally generated with `H¹ = 0` ([Stacks, Tag 0E3K] and [Stacks, Tag 0B62]), so
`c₁^*ω_Y ≅ ω_{X₁} ≅ c₁'^*ω_{Y'}` ([Stacks, Tag 0E7P]), and the two contractions identifying
ample modules are isomorphic under `X₁`
(`existsUnique_iso_of_pullback_dualizingSheafOverField_iso`). -/
theorem existsUnique_iso_of_isStableContraction (f : X ⟶ Spec (.of k)) [IsProper f]
    (hdim : topologicalKrullDim X = 1) [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)]
    (hgenus : 2 ≤ genus f)
    (hnodal : letI : X.Over (Spec (.of k)) := ⟨f⟩
      Stacks.Curves.HasAtWorstNodalSingularities k X)
    {gY : Y ⟶ Spec (.of k)} {gY' : Y' ⟶ Spec (.of k)} {c : X ⟶ Y} {c' : X ⟶ Y'}
    (h : IsStableContraction f gY c) (h' : IsStableContraction f gY' c') :
    ∃! e : Y ≅ Y', c ≫ e.hom = c' := by
  have := connectedSpace_of_isIso_globalSections k f
  obtain ⟨X₁, f₁, t, hseq, htail⟩ :=
    IsIteratedContractionOfRationalTails.exists_forall_not_isRationalTail k f hdim hnodal
  obtain ⟨c₁, hc₁, h₁⟩ := exists_comp_eq_of_isIteratedContractionOfRationalTails k hseq
    inferInstance hdim inferInstance hnodal h h.isInvertible_dualizingSheafOverField_subscheme
  obtain ⟨c₁', hc₁', h₁'⟩ := exists_comp_eq_of_isIteratedContractionOfRationalTails k hseq
    inferInstance hdim inferInstance hnodal h' h'.isInvertible_dualizingSheafOverField_subscheme
  have : IsProper f₁ := hseq.isProper_target hdim hnodal
  have hdim₁ := hseq.topologicalKrullDim_target hdim hnodal
  have := hseq.isIso_globalSections_target hdim hnodal
  have hnodal₁ := hseq.hasAtWorstNodalSingularities_target hdim hnodal
  have hg₁ : 2 ≤ genus f₁ := (hseq.genus_target hdim hnodal).symm ▸ hgenus
  have := connectedSpace_of_isIso_globalSections k f₁
  let : X₁.Over (Spec (.of k)) := ⟨f₁⟩
  have : IsProper (X₁ ↘ Spec (.of k)) := (inferInstance : IsProper f₁)
  have : IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ (X₁ ↘ Spec (.of k)).appTop) :=
    (inferInstance : IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f₁.appTop))
  have : SheafOfModules.IsInvertible X₁.presheaf X₁.ringCatSheaf.2 (dualizingSheafOverField f₁) :=
    isInvertible_dualizingSheafOverField_of_hasAtWorstNodalSingularities k X₁ hdim₁ hnodal₁
  have hgen := fun m hm =>
    isGeneratedByGlobalSections_tensorPower_dualizingSheafOverField_of_forall_not_isRationalTail
      (X := X₁) hdim₁ hnodal₁ htail hg₁ m hm
  let S : CohenMacaulayCurveSituation.{u} := ⟨k, X₁, f₁, hdim₁⟩
  have hdeg : 0 < invertibleCurveDegree k f₁ hdim₁.le (dualizingSheafOverField f₁) := by
    rw [invertibleCurveDegree_dualizingSheafOverField_of_isInvertible k f₁ hdim₁.le]
    have : (2 : ℤ) ≤ genus f₁ := by exact_mod_cast hg₁
    omega
  have hH1 := isZero_cohomologyOverField_one_tensorSheafNPow_dualizingSheafOverField S hdeg 2
    two_pos (hgen 2 le_rfl)
  have hgen3 := Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSections_of_iso
    (tensorSheafNPowIsoTensorPower (dualizingSheafOverField f₁) 3).symm (hgen 3 (by norm_num))
  obtain ⟨φ₁⟩ := h₁.nonempty_pullback_iso_dualizingSheafOverField hdim₁ hnodal₁ 3 (by norm_num)
    hH1 hgen3
  obtain ⟨φ₁'⟩ := h₁'.nonempty_pullback_iso_dualizingSheafOverField hdim₁ hnodal₁ 3 (by norm_num)
    hH1 hgen3
  obtain ⟨e, he, -⟩ :=
    existsUnique_iso_of_pullback_dualizingSheafOverField_iso h₁ h₁' (φ₁ ≪≫ φ₁'.symm)
  refine existsUnique_iso_of_nonempty h h' ⟨e, ?_⟩
  rw [← hc₁, ← hc₁', Category.assoc, he]

end Uniqueness

end Stacks.Curves.StableModel
