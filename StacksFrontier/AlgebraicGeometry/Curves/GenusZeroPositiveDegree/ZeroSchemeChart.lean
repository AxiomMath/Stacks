module

public import StacksFrontier.AlgebraicGeometry.EulerCharIso.Basic
public import StacksFrontier.AlgebraicGeometry.ProjectiveFromSections.Ratio
public import StacksFrontier.AlgebraicGeometry.Variety.Curve.SectionDegree

/-!
# The zero scheme of a section read on a chart of a second section

Let `k` be a field, `X` an integral scheme proper over `k` of dimension at most one, `ℒ` an
invertible `𝒪_X`-module and `a`, `b` two global sections of `ℒ` with `a ≠ 0` and
`X = X_a ∪ X_b`. The zero scheme `D = Z(a)` is supported outside `X_a`, hence inside `X_b`, and on
`X_b` the module `ℒ` is free on `b`, so the ideal of `D` there is generated by the single function
`a / b`. If `X_b` is affine this identifies `Γ(D, 𝒪_D)` with `Γ(X_b, 𝒪_X) ⧸ (a / b)`, and the
degree identity `deg(ℒ) = dim_k Γ(D, ℒ|_D) = dim_k Γ(D, 𝒪_D)` of [Stacks, Tag 0B40] gives

`dim_k Γ(X_b, 𝒪_X) ⧸ (a / b) = deg(ℒ)`.

## Main results

* `AlgebraicGeometry.zeroScheme_ideal_nvOpen_eq_span`: on an affine nonvanishing open `X_b` the
  ideal of the zero scheme of `a` is generated by `a / b`.
* `AlgebraicGeometry.finrank_quotient_span_ratio_eq`: `dim_k Γ(X_b, 𝒪_X) ⧸ (a / b) = deg(ℒ)`.
* `AlgebraicGeometry.finrank_quotient_span_ratio_le`: the inequality form.
* `AlgebraicGeometry.finiteDimensional_quotient_span_ratio`: the quotient is finite dimensional.

## Implementation notes

The `k`-algebra structure on `Γ(X_b, 𝒪_X)` is the one the structure morphism induces, restricted
from `Γ(X, 𝒪_X)`; the quotient inherits it. The identification with `Γ(D, 𝒪_D)` is the map
`Γ(X_b, 𝒪_X) ⟶ Γ(D, 𝒪_D)` induced by the closed immersion of `D`, which is surjective with
kernel the ideal of `D` over the affine open `X_b` (Mathlib's
`AlgebraicGeometry.Scheme.IdealSheafData.subschemeι_app_surjective` and
`AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι_app`), because the preimage of `X_b` in
`D` is all of `D`.

## References

* [Stacks Project, Tag 0B40](https://stacks.math.columbia.edu/tag/0B40)
* [Stacks Project, Tag 02OQ](https://stacks.math.columbia.edu/tag/02OQ)
* [Stacks Project, Tag 01CY](https://stacks.math.columbia.edu/tag/01CY)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.ProjectiveFromSections (nvOpen div resT div_smul)

universe u

namespace AlgebraicGeometry

variable {X : Scheme.{u}} {L : X.Modules}

/-- Invertibility in the ampleness spelling gives invertibility in the spelling of the zero scheme
construction; the two are definitionally equal. -/
theorem isInvertible_sheaf_obj_of_isInvertibleModule [Stacks.Ample.IsInvertibleModule X L] :
    SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L :=
  ‹Stacks.Ample.IsInvertibleModule X L›

attribute [local instance] isInvertible_sheaf_obj_of_isInvertibleModule

/-- **On an affine nonvanishing open `X_b` the ideal of the zero scheme of `a` is generated by
`a / b`.** On `X_b` the section `b` is a basis of `ℒ`, so `a = (a / b) • b` there, every linear
functional sends `a` into the ideal `(a / b)`, and division by `b` is a linear functional sending
`a` to `a / b`. -/
theorem zeroScheme_ideal_nvOpen_eq_span [Stacks.Ample.IsInvertibleModule X L] (a b : Γ(L, ⊤))
    (hV : IsAffineOpen (nvOpen L b)) :
    (zeroScheme X L a).ideal ⟨nvOpen L b, hV⟩ =
      Ideal.span {div b le_rfl (resT (nvOpen L b) a)} := by
  rw [zeroScheme_ideal]
  set V := nvOpen L b
  set r := div b le_rfl (resT V a)
  have hr : r • resT V b = resT V a := div_smul b le_rfl (resT V a)
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro x ⟨φ, rfl⟩
    have hφ : φ (resT V a) = r * φ (resT V b) := by
      rw [← hr, map_smul, smul_eq_mul]
    change φ (resT V a) ∈ _
    rw [hφ]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self r)
  · rw [Ideal.span_singleton_le_iff_mem]
    have hbij : Function.Bijective (LinearMap.toSpanSingleton Γ(X, V) Γ(L, V) (resT V b)) := by
      have h := Stacks.NonvanishingSpelling.bijective_smul X L b (le_rfl : V ≤ V)
      convert h using 1
      funext c
      rfl
    let e := LinearEquiv.ofBijective _ hbij
    refine Ideal.subset_span ⟨e.symm.toLinearMap, ?_⟩
    change r = e.symm (resT V a)
    rw [eq_comm, LinearEquiv.symm_apply_eq]
    exact hr.symm

variable {k : Type u} [Field k] (f : X ⟶ Spec (.of k))

/-- The auxiliary form of `AlgebraicGeometry.finrank_quotient_span_ratio_eq`, for a section given
as a restriction-compatible family, which is the spelling of the degree identity. -/
theorem finrank_quotient_span_ratio_eq_of_sections [IsProper f] [IsIntegral X]
    (hdim : topologicalKrullDim X ≤ 1) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
    (s : L.sections) (b : Γ(L, ⊤)) (hs : s.eval (op ⊤) ≠ 0)
    (hcov : nvOpen L (s.eval (op ⊤)) ⊔ nvOpen L b = ⊤) (hV : IsAffineOpen (nvOpen L b)) :
    letI : Algebra k Γ(X, nvOpen L b) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
      X.presheaf.map (homOfLE (le_top : nvOpen L b ≤ ⊤)).op).hom.toAlgebra
    (Module.finrank k (Γ(X, nvOpen L b) ⧸
        Ideal.span {div b le_rfl (resT (nvOpen L b) (s.eval (op ⊤)))}) : ℤ) =
      invertibleCurveDegree k f hdim L ∧
    FiniteDimensional k (Γ(X, nvOpen L b) ⧸
        Ideal.span {div b le_rfl (resT (nvOpen L b) (s.eval (op ⊤)))}) := by
  let : Algebra k Γ(X, nvOpen L b) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
    X.presheaf.map (homOfLE (le_top : nvOpen L b ≤ ⊤)).op).hom.toAlgebra
  set D := zeroScheme X L (s.eval (op ⊤))
  -- the degree is the dimension of the global functions on `D`
  have hdeg : invertibleCurveDegree k f hdim L =
      (Module.finrank k (cohomologyOverField k (D.subschemeι ≫ f)
        ((Scheme.Modules.pullback D.subschemeι).obj L) 0) : ℤ) :=
    invertibleCurveDegree_eq_finrank_cohomologyOverField_zero_zeroScheme k f hdim L s hs
      (forall_finiteDimensional_cohomologyOverField_unit k f)
  obtain ⟨e⟩ := nonempty_pullback_zeroScheme_iso_unit k f hdim L s hs
  rw [hdeg, finrank_cohomologyOverField_eq_of_iso k (D.subschemeι ≫ f) e 0,
    finrank_cohomologyOverField_zero_unit_eq_finrank_globalSections k (D.subschemeι ≫ f)]
  have hfinD : FiniteDimensional k (cohomologyOverField k (D.subschemeι ≫ f)
      (SheafOfModules.unit D.subscheme.ringCatSheaf) 0) :=
    forall_finiteDimensional_cohomologyOverField_unit k (D.subschemeι ≫ f) 0
  -- the support of `D` lies in `X_b`
  have hsupp : ∀ x ∈ D.support, x ∈ (nvOpen L b) := by
    intro x hx
    have hcompl := nonvanishingLocus_eq_compl_supportSet_zeroScheme L s hs
    rw [Stacks.NonvanishingSpelling.stalkNonvanishingLocus_eq X L s] at hcompl
    have hxa : x ∉ nvOpen L (s.eval (op ⊤)) := by
      intro hxa
      have : x ∈ D.supportSetᶜ := by
        rw [← hcompl]; exact hxa
      exact this hx
    have hx' : x ∈ nvOpen L (s.eval (op ⊤)) ⊔ (nvOpen L b) := by rw [hcov]; trivial
    rcases (TopologicalSpace.Opens.mem_sup).mp hx' with h | h
    · exact absurd h hxa
    · exact h
  have hpre : D.subschemeι ⁻¹ᵁ (nvOpen L b) = ⊤ := by
    refine top_unique fun y _ => hsupp _ ?_
    rw [← SetLike.mem_coe, ← D.range_subschemeι]
    exact ⟨y, rfl⟩
  have hle : (⊤ : D.subscheme.Opens) ≤ D.subschemeι ⁻¹ᵁ (nvOpen L b) := hpre.ge
  -- the restriction `Γ(D, D.subschemeι ⁻¹ᵁ (nvOpen L b)) ⟶ Γ(D, ⊤)` is bijective
  have hres : Function.Bijective (D.subscheme.presheaf.map (homOfLE hle).op).hom := by
    have hh : (homOfLE hle).op = (eqToHom hpre.symm).op := Subsingleton.elim _ _
    rw [hh]
    exact ConcreteCategory.bijective_of_isIso _
  let U : X.affineOpens := ⟨(nvOpen L b), hV⟩
  let h := D.subschemeι.appLE (nvOpen L b) ⊤ hle
  have hcomp : h.hom = (D.subscheme.presheaf.map (homOfLE hle).op).hom.comp
      (D.subschemeι.app (nvOpen L b)).hom := rfl
  have hsurj : Function.Surjective h.hom := by
    rw [hcomp]
    exact hres.2.comp (D.subschemeι_app_surjective U)
  have hker : RingHom.ker h.hom =
      Ideal.span {div b le_rfl (resT (nvOpen L b) (s.eval (op ⊤)))} := by
    rw [hcomp, RingHom.ker_comp_of_injective _ hres.1]
    exact (D.ker_subschemeι_app U).trans (zeroScheme_ideal_nvOpen_eq_span _ b hV)
  let eR : (Γ(X, (nvOpen L b)) ⧸ Ideal.span {div b le_rfl (resT (nvOpen L b) (s.eval (op ⊤)))}) ≃+*
      Γ(D.subscheme, ⊤) :=
    (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)
  let : Algebra k Γ(D.subscheme, ⊤) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ (D.subschemeι ≫ f).appTop).hom.toAlgebra
  have hmk : ∀ x : Γ(X, (nvOpen L b)), eR (Ideal.Quotient.mk _ x) = h.hom x := fun x => rfl
  have hmor : ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
      X.presheaf.map (homOfLE (le_top : (nvOpen L b) ≤ ⊤)).op) ≫ h =
        (Scheme.ΓSpecIso (.of k)).inv ≫ (D.subschemeι ≫ f).appTop := by
    simp only [Category.assoc, h, Scheme.Hom.map_appLE, appLE_top_top_eq_appTop,
      Scheme.Hom.comp_appTop]
  have hcomm : ∀ c : k,
      h.hom (algebraMap k Γ(X, (nvOpen L b)) c) = algebraMap k Γ(D.subscheme, ⊤) c :=
    fun c => by
      change h.hom (((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
        X.presheaf.map (homOfLE (le_top : (nvOpen L b) ≤ ⊤)).op).hom c) =
          ((Scheme.ΓSpecIso (.of k)).inv ≫ (D.subschemeι ≫ f).appTop).hom c
      rw [← hmor]
      rfl
  let eL : (Γ(X, nvOpen L b) ⧸
      Ideal.span {div b le_rfl (resT (nvOpen L b) (s.eval (op ⊤)))}) ≃ₗ[k] Γ(D.subscheme, ⊤) :=
    { eR with
      map_smul' := fun c x => by
        induction x using Submodule.Quotient.induction_on with
        | H y =>
          change eR (Ideal.Quotient.mk _ (c • y)) = c • eR (Ideal.Quotient.mk _ y)
          rw [hmk, hmk, Algebra.smul_def, Algebra.smul_def, map_mul, hcomm] }
  have hfinΓ : FiniteDimensional k Γ(D.subscheme, ⊤) :=
    (cohomologyOverFieldZeroIsoSections k (D.subschemeι ≫ f)
      (SheafOfModules.unit D.subscheme.ringCatSheaf)).toLinearEquiv.finiteDimensional
  exact ⟨by convert congrArg Nat.cast eL.finrank_eq, by convert eL.symm.finiteDimensional⟩

/-- **The dimension of the chart quotient is the degree.** Let `X` be an integral scheme proper
over a field `k` of dimension at most one, `ℒ` invertible on `X` and `a`, `b` global sections of
`ℒ` with `a ≠ 0`, `X = X_a ∪ X_b` and `X_b` affine. Then
`dim_k Γ(X_b, 𝒪_X) ⧸ (a / b) = deg(ℒ)`, the quotient being the global functions on the zero
scheme of `a`. -/
theorem finrank_quotient_span_ratio_eq [IsProper f] [IsIntegral X]
    (hdim : topologicalKrullDim X ≤ 1) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
    (a b : Γ(L, ⊤)) (ha : a ≠ 0) (hcov : nvOpen L a ⊔ nvOpen L b = ⊤)
    (hV : IsAffineOpen (nvOpen L b)) :
    letI : Algebra k Γ(X, nvOpen L b) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
      X.presheaf.map (homOfLE (le_top : nvOpen L b ≤ ⊤)).op).hom.toAlgebra
    (Module.finrank k (Γ(X, nvOpen L b) ⧸ Ideal.span {div b le_rfl (resT (nvOpen L b) a)}) :
      ℤ) = invertibleCurveDegree k f hdim L := by
  obtain ⟨s, rfl⟩ := (Stacks.NonvanishingSpelling.sectionsEquiv X L).surjective a
  exact (finrank_quotient_span_ratio_eq_of_sections f hdim L s b ha hcov hV).1

/-- **The chart quotient is finite dimensional**, under the hypotheses of
`AlgebraicGeometry.finrank_quotient_span_ratio_eq`: the quotient is the ring of global functions
on the zero scheme of `a`, a scheme proper over `k`, and that ring is finite dimensional by
[Stacks, Tag 02O6]. -/
theorem finiteDimensional_quotient_span_ratio [IsProper f] [IsIntegral X]
    (hdim : topologicalKrullDim X ≤ 1) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
    (a b : Γ(L, ⊤)) (ha : a ≠ 0) (hcov : nvOpen L a ⊔ nvOpen L b = ⊤)
    (hV : IsAffineOpen (nvOpen L b)) :
    letI : Algebra k Γ(X, nvOpen L b) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
      X.presheaf.map (homOfLE (le_top : nvOpen L b ≤ ⊤)).op).hom.toAlgebra
    FiniteDimensional k (Γ(X, nvOpen L b) ⧸ Ideal.span {div b le_rfl (resT (nvOpen L b) a)}) := by
  obtain ⟨s, rfl⟩ := (Stacks.NonvanishingSpelling.sectionsEquiv X L).surjective a
  exact (finrank_quotient_span_ratio_eq_of_sections f hdim L s b ha hcov hV).2

/-- **The dimension of the chart quotient is at most the degree**, the inequality form of
`AlgebraicGeometry.finrank_quotient_span_ratio_eq`. -/
theorem finrank_quotient_span_ratio_le [IsProper f] [IsIntegral X]
    (hdim : topologicalKrullDim X ≤ 1) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
    (a b : Γ(L, ⊤)) (ha : a ≠ 0) (hcov : nvOpen L a ⊔ nvOpen L b = ⊤)
    (hV : IsAffineOpen (nvOpen L b)) :
    letI : Algebra k Γ(X, nvOpen L b) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
      X.presheaf.map (homOfLE (le_top : nvOpen L b ≤ ⊤)).op).hom.toAlgebra
    (Module.finrank k (Γ(X, nvOpen L b) ⧸ Ideal.span {div b le_rfl (resT (nvOpen L b) a)}) :
      ℤ) ≤ invertibleCurveDegree k f hdim L :=
  (finrank_quotient_span_ratio_eq f hdim L a b ha hcov hV).le

end AlgebraicGeometry

end
