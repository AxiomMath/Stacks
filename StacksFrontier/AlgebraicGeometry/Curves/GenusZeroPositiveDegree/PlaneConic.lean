attribute [local instance] MvPolynomial.gradedAlgebra

/-! ### Generalities -/

/-- On an irreducible sober space of dimension at most one every point other than the generic
point is closed. -/
@[ega "II 7.4.3" "partial"]
theorem isClosed_singleton_of_ne_genericPoint {T : Type*} [TopologicalSpace T] [T0Space T]
    [QuasiSober T] [IrreducibleSpace T] (hdim : topologicalKrullDim T ≤ 1) {x : T}
    (hx : x ≠ genericPoint T) : IsClosed ({x} : Set T) := by
  refine Stacks.Topology.Dimension.isClosed_singleton_of_mem_of_ne_univ hdim
    (T := closure ({x} : Set T)) isClosed_closure (fun h => hx ?_)
    (subset_closure (Set.mem_singleton x))
  exact (isGenericPoint_def.mpr h).eq (genericPoint_spec T)

/-- A restriction map of `𝒪_X` between equal opens is bijective. -/
theorem bijective_presheaf_map_of_eq {Y : Scheme.{u}} {V W : Y.Opens} (h : V = W)
    (i : op W ⟶ op V) : Function.Bijective (Y.presheaf.map i) := by
  subst h
  rw [Subsingleton.elim i (𝟙 _), CategoryTheory.Functor.map_id]
  exact Function.bijective_id

/-- Surjectivity of `appLE` only depends on the two opens, not on how they are written. -/
theorem surjective_appLE_congr {A B : Scheme.{u}} (g : A ⟶ B) {U U' : B.Opens} {V V' : A.Opens}
    (hU : U = U') (hV : V = V') (e : V ≤ g ⁻¹ᵁ U) (e' : V' ≤ g ⁻¹ᵁ U')
    (h : Function.Surjective (g.appLE U V e)) : Function.Surjective (g.appLE U' V' e') := by
  subst hU hV; exact h

/-- A homogeneous polynomial of degree one is the linear form on its coefficients. -/
theorem eq_sum_monomial_of_isHomogeneous_one {σ R : Type*} [CommSemiring R] [Fintype σ]
    {F : MvPolynomial σ R} (hF : F.IsHomogeneous 1) :
    F = ∑ m, MvPolynomial.monomial (Finsupp.single m 1) (F.coeff (Finsupp.single m 1)) := by
  classical
  ext e
  rw [MvPolynomial.coeff_sum]
  simp only [MvPolynomial.coeff_monomial]
  by_cases he : ∃ m, Finsupp.single m 1 = e
  · obtain ⟨m, rfl⟩ := he
    rw [Finset.sum_eq_single m (fun b _ hb => ite_eq_right fun h =>
      hb (Finsupp.single_left_injective one_ne_zero h)) (by simp), ite_eq_left rfl]
  · rw [Finset.sum_eq_zero (fun m _ => ite_eq_right fun h => he ⟨m, h⟩)]
    by_contra hne
    have hdeg := hF hne
    have hmem : e ∈ {d : σ →₀ ℕ | d.degree = 1} := by
      change e.degree = 1
      rw [Finsupp.degree_eq_weight_one]; exact hdeg
    rw [← Finsupp.range_single_one] at hmem
    exact he hmem

/-- An integral locally Noetherian scheme has no embedded points: its associated points are
weakly associated, hence generic points by [Stacks, Tag 0EME]. -/
theorem hasNoEmbeddedPoints_of_isIntegral (Y : Scheme.{u}) [IsIntegral Y]
    [IsLocallyNoetherian Y] : HasNoEmbeddedPoints Y := by
  intro x hx
  obtain ⟨hass, hng⟩ := (isEmbeddedPoint_iff_not_genericPoint Y x).mp hx
  have hw := associatedPoints_subset_weaklyAssociatedPoints _ hass
  have hw' : x ∈ Stacks.Divisors.schemeWeaklyAssociatedPoints Y := hw
  rw [weaklyAssociatedPointsOfScheme_eq_genericPoints] at hw'
  exact hng ⟨closure {x}, hw', isGenericPoint_closure⟩


/-! ### The preimages of the standard charts -/

section Preimage

variable {k : Type u} [Field k] {n : ℕ} {X : Scheme.{u}} {L : X.Modules}
  [Stacks.Ample.IsInvertibleModule X L] (s : Fin (n + 1) → Γ(L, ⊤)) (hs : GeneratesStalks s)
  (f : X ⟶ Spec (CommRingCat.of k))

/-- A family of sections two of whose charts cover `X` generates every stalk. -/
theorem generatesStalks_of_sup {i₀ i₁ : Fin (n + 1)} (hcov : nvCover s i₀ ⊔ nvCover s i₁ = ⊤) :
    GeneratesStalks s :=
  Stacks.AmpleImmersionReduction.generatesStalks_of_forall_exists_mem s fun x => by
    have hx : x ∈ (nvCover s i₀ ⊔ nvCover s i₁ : X.Opens) := by rw [hcov]; trivial
    rcases hx with h | h
    · exact ⟨i₀, h⟩
    · exact ⟨i₁, h⟩

/-- **The preimage of the standard chart `D₊(Tᵢ)` is `X_{sᵢ}`.** On the chart `X_{sⱼ}` the preimage
is the basic open of the ratio `sᵢ / sⱼ`, which is `X_{sᵢ} ⊓ X_{sⱼ}`. -/
theorem preimage_basicOpen_toPolynomialModel (i : Fin (n + 1)) :
    toPolynomialModel s hs f ⁻¹ᵁ Proj.basicOpen (polyGrading k n) (MvPolynomial.X i) =
      nvCover s i := by
  have key : ∀ j, toPolynomialModel s hs f ⁻¹ᵁ Proj.basicOpen (polyGrading k n) (MvPolynomial.X i)
      ⊓ nvCover s j = nvCover s i ⊓ nvCover s j := by
    intro j
    have h1 : (nvCover s j).ι ⁻¹ᵁ (toPolynomialModel s hs f ⁻¹ᵁ
        Proj.basicOpen (polyGrading k n) (MvPolynomial.X i)) =
        (nvCover s j).toScheme.basicOpen (chartRatio s j i) := by
      rw [← Scheme.Hom.comp_preimage, ι_toPolynomialModel,
        Proj.fromOfGlobalSections_preimage_basicOpen _ _ _ Nat.one_pos (X_mem_one k n i),
        MvPolynomial.eval₂Hom_X']
    have h2 := congrArg ((nvCover s j).ι ''ᵁ ·) h1
    simp only [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι,
      chartRatio, Scheme.Opens.ι_image_basicOpen_topIso_inv] at h2
    rw [inf_comm, h2]
    exact (Stacks.SectionExtension.nonvanishingOpen_inf_eq_basicOpen (s j) (s i) le_rfl
      (ratio s j i) (ratio_smul s j i).symm).symm
  have hcov := isOpenCover_nvCover_of_generatesStalks s hs
  apply le_antisymm
  · intro x hx
    have hx' : x ∈ (⨆ j, nvCover s j) := by
      rw [show (⨆ j, nvCover s j) = ⊤ from hcov]; trivial
    obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx'
    have : x ∈ nvCover s i ⊓ nvCover s j := key j ▸ ⟨hx, hj⟩
    exact this.1
  · intro x hx
    have : x ∈ toPolynomialModel s hs f ⁻¹ᵁ Proj.basicOpen (polyGrading k n) (MvPolynomial.X i)
        ⊓ nvCover s i := (key i).symm ▸ ⟨hx, hx⟩
    exact this.1

end Preimage

/-! ### Finiteness of the morphism, and affineness of the charts -/

section Finite

variable {k : Type u} [Field k] {n : ℕ} {X : Scheme.{u}} {L : X.Modules}
  [Stacks.Ample.IsInvertibleModule X L] (f : X ⟶ Spec (CommRingCat.of k))
  (s : Fin (n + 1) → Γ(L, ⊤))

variable [IsProper f] [IsIntegral X]

/-- **The morphism of a generating family none of whose members vanishes nowhere is finite**, on a
proper integral scheme of dimension at most one over a field. -/
theorem isFinite_toPolynomialModel (hs : GeneratesStalks s) (hdim : topologicalKrullDim X ≤ 1)
    (hvan : ∀ i, nvCover s i ≠ ⊤) :
    IsFinite (toPolynomialModel s hs f) := by
  set Φ := toPolynomialModel s hs f with hΦ
  have : NoetherianSpace X :=
    Stacks.AlgebraicGeometry.ProperGeomConnected.noetherianSpace_of_isProper f
  have hcomp : Φ ≫ projToSpecCoeff k n = f := toPolynomialModel_comp_projToSpecCoeff s hs f
  have : IsProper (Φ ≫ projToSpecCoeff k n) := by rw [hcomp]; infer_instance
  have : IsSeparated (projToSpecCoeff k n) := by
    rw [projToSpecCoeff]; infer_instance
  have : IsProper Φ := IsProper.of_comp Φ (projToSpecCoeff k n)
  set η := genericPoint X
  -- the image of the generic point is not closed
  have hη : ¬ IsClosed ({Φ η} : Set (Proj (polyGrading k n))) := by
    intro hcl
    have hall : ∀ x, Φ x = Φ η := fun x => by
      have h := ((genericPoint_specializes x).map Φ.continuous)
      rw [specializes_iff_mem_closure, hcl.closure_eq] at h
      exact h
    have hcov := Stacks.AlgebraicGeometry.ProjPolyChart.iSup_basicOpen_X_eq_top k n
    have hm : Φ η ∈ ⨆ i : Fin (n + 1), Proj.basicOpen (polyGrading k n) (MvPolynomial.X i) := by
      rw [hcov]; trivial
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hm
    refine hvan i (eq_top_iff.mpr fun x _ => ?_)
    rw [← preimage_basicOpen_toPolynomialModel s hs f i]
    change Φ x ∈ Proj.basicOpen (polyGrading k n) (MvPolynomial.X i)
    rw [hall x]; exact hi
  have hclosed : ∀ x, x ≠ η → IsClosed ({Φ x} : Set (Proj (polyGrading k n))) := fun x hx => by
    have := Φ.isClosedMap _ (isClosed_singleton_of_ne_genericPoint hdim hx)
    rwa [Set.image_singleton] at this
  suffices hq : LocallyQuasiFinite Φ from IsFinite.of_isProper_of_locallyQuasiFinite Φ
  refine locallyQuasiFinite_iff_isDiscrete_preimage_singleton.mpr fun y => ?_
  by_cases hy : y = Φ η
  · refine Set.Subsingleton.isDiscrete fun a ha b hb => ?_
    have hab : ∀ c ∈ Φ ⁻¹' {y}, c = η := fun c hc => by
      by_contra hc'
      have := hclosed c hc'
      rw [show Φ c = Φ η from hc.trans hy] at this
      exact hη this
    rw [hab a ha, hab b hb]
  · have hnot : η ∉ Φ ⁻¹' {y} := fun h => hy h.symm
    have hne : ∀ x ∈ Φ ⁻¹' {y}, x ≠ η := fun x hx h => hnot (h ▸ hx)
    have hcp : Φ ⁻¹' {y} ⊆ closedPoints X := fun x hx =>
      isClosed_singleton_of_ne_genericPoint hdim (hne x hx)
    refine Set.Finite.isDiscrete_of_subset_closedPoints ?_ hcp
    rcases (Φ ⁻¹' {y}).eq_empty_or_nonempty with he | ⟨x₀, hx₀⟩
    · rw [he]; exact Set.finite_empty
    refine (Stacks.Topology.Dimension.finite_of_isClosed_of_ne_univ hdim isClosed_closure
      fun h => ?_).subset subset_closure
    have hyc : IsClosed ({y} : Set (Proj (polyGrading k n))) := by
      have := hclosed x₀ (hne x₀ hx₀)
      rwa [show Φ x₀ = y from hx₀] at this
    have hηcl : η ∈ closure (Φ ⁻¹' {y}) := h ▸ Set.mem_univ η
    have hmap : Φ η ∈ closure ({y} : Set (Proj (polyGrading k n))) :=
      map_mem_closure Φ.continuous hηcl (fun z hz => (hz : Φ z = y))
    rw [hyc.closure_eq] at hmap
    exact hy hmap.symm

include f in
/-- **The charts `X_{sᵢ}` are affine**, being the preimages of the standard affine charts under a
finite morphism. -/
theorem isAffineOpen_nvCover_of_generatesStalks (hs : GeneratesStalks s)
    (hdim : topologicalKrullDim X ≤ 1) (hvan : ∀ i, nvCover s i ≠ ⊤) (i : Fin (n + 1)) :
    IsAffineOpen (nvCover s i) := by
  have := isFinite_toPolynomialModel f s hs hdim hvan
  rw [← preimage_basicOpen_toPolynomialModel s hs f i]
  exact IsAffineHom.isAffine_preimage _
    (Proj.isAffineOpen_basicOpen _ _ (X_mem_one k n i) Nat.one_pos)

include f in
/-- The charts of a family whose charts cover `X` are affine. -/
theorem isAffineOpen_nvCover_of_isOpenCover (hdim : topologicalKrullDim X ≤ 1)
    (hs : IsOpenCover (nvCover s)) (hvan : ∀ i, nvCover s i ≠ ⊤) (i : Fin (n + 1)) :
    IsAffineOpen (nvCover s i) :=
  isAffineOpen_nvCover_of_generatesStalks f s
    (Stacks.AmpleImmersionReduction.generatesStalks_of_isOpenCover s hs) hdim hvan i

include f in
/-- **The charts `X_{sᵢ}` of a family of sections, two of which have no common zero and none of
which vanishes nowhere, are affine.** -/
theorem isAffineOpen_nvCover {i₀ i₁ : Fin (n + 1)} (hdim : topologicalKrullDim X ≤ 1)
    (hcov : nvCover s i₀ ⊔ nvCover s i₁ = ⊤) (hvan : ∀ i, nvCover s i ≠ ⊤) (i : Fin (n + 1)) :
    IsAffineOpen (nvCover s i) :=
  isAffineOpen_nvCover_of_generatesStalks f s (generatesStalks_of_sup s hcov) hdim hvan i

end Finite

/-! ### The closed immersion -/

section ClosedImmersion

variable {k : Type u} [Field k] {n : ℕ} {X : Scheme.{u}} {L : X.Modules}
  [Stacks.Ample.IsInvertibleModule X L] (f : X ⟶ Spec (CommRingCat.of k))
  (s : Fin (n + 1) → Γ(L, ⊤)) (hs : GeneratesStalks s)

/-- The constants pulled back along the morphism to the chart are the constants of `X_{sᵢ}`. -/
theorem appLE_awayToSection_coeffToAway (i : Fin (n + 1)) (r : k) :
    (toPolynomialModel s hs f).appLE (Proj.basicOpen (polyGrading k n) (MvPolynomial.X i))
        (nvCover s i) (nvCover_le_preimage_basicOpen_toPolynomialModel s hs f i)
        ((Proj.awayToSection (polyGrading k n) (MvPolynomial.X i)).hom (coeffToAway k n i r)) =
      sectionConstants f (nvCover s i) r := by
  rw [appLE_coeffToAway_chart]
  rfl

/-- **Over the standard chart `D₊(Tᵢ)` the morphism is surjective on sections**, as soon as the
sections over `X_{sᵢ}` are generated by the constants and the ratios. -/
theorem surjective_app_basicOpen (i : Fin (n + 1))
    (hgen : ∀ a : Γ(X, nvCover s i),
      a ∈ Subring.closure (Set.range (sectionConstants f (nvCover s i)) ∪ Set.range (ratio s i))) :
    Function.Surjective ((toPolynomialModel s hs f).app
      (Proj.basicOpen (polyGrading k n) (MvPolynomial.X i))) := by
  set e := nvCover_le_preimage_basicOpen_toPolynomialModel s hs f i
  set ψ := (toPolynomialModel s hs f).appLE (Proj.basicOpen (polyGrading k n) (MvPolynomial.X i))
    (nvCover s i) e
  have hsub : Set.range (sectionConstants f (nvCover s i)) ∪ Set.range (ratio s i) ⊆
      (ψ.hom.range : Set Γ(X, nvCover s i)) := by
    rintro _ (⟨r, rfl⟩ | ⟨j, rfl⟩)
    · exact ⟨_, appLE_awayToSection_coeffToAway f s hs i r⟩
    · exact ⟨_, appLE_coordFracAt_chart s hs f i j⟩
  have hψ : Function.Surjective ψ := fun a =>
    (Subring.closure_le.mpr hsub) (hgen a)
  have hpre := preimage_basicOpen_toPolynomialModel s hs f i
  have hmap := bijective_presheaf_map_of_eq hpre.symm (homOfLE e).op
  intro x
  obtain ⟨y, hy⟩ := hψ (X.presheaf.map (homOfLE e).op x)
  exact ⟨y, hmap.1 hy⟩

/-- **Over the standard chart `D₊(Tᵢ)` the morphism is a closed immersion**, as soon as `X_{sᵢ}` is
affine and its sections are generated by the constants and the ratios. -/
theorem isClosedImmersion_morphismRestrict_basicOpen (i : Fin (n + 1))
    (hU : IsAffineOpen (nvCover s i))
    (hgen : ∀ a : Γ(X, nvCover s i),
      a ∈ Subring.closure (Set.range (sectionConstants f (nvCover s i)) ∪ Set.range (ratio s i))) :
    IsClosedImmersion (toPolynomialModel s hs f ∣_
      Proj.basicOpen (polyGrading k n) (MvPolynomial.X i)) := by
  set Φ := toPolynomialModel s hs f
  set D := Proj.basicOpen (polyGrading k n) (MvPolynomial.X i)
  have : IsAffine D.toScheme := Proj.isAffineOpen_basicOpen _ _ (X_mem_one k n i) Nat.one_pos
  have hpre := preimage_basicOpen_toPolynomialModel s hs f i
  have hA : IsAffineOpen (Φ ⁻¹ᵁ D) := hpre ▸ hU
  have : IsAffine (Φ ⁻¹ᵁ D).toScheme := hA
  refine IsClosedImmersion.of_surjective_of_isAffine _ ?_
  change Function.Surjective ((Φ ∣_ D).app ⊤)
  rw [morphismRestrict_app']
  refine surjective_appLE_congr Φ (Scheme.Opens.ι_image_top D).symm
    (Scheme.Opens.ι_image_top _).symm le_rfl _ ?_
  rw [← Scheme.Hom.app_eq_appLE]
  exact surjective_app_basicOpen f s hs i hgen

variable [IsProper f] [IsIntegral X]

/-- **The morphism of a generating family to `ℙⁿ_k` is a closed immersion** as soon as none of the
sections vanishes nowhere and on every chart `X_{sᵢ}` the functions are generated by the constants
and the ratios. -/
theorem isClosedImmersion_toPolynomialModel (hdim : topologicalKrullDim X ≤ 1)
    (hvan : ∀ i, nvCover s i ≠ ⊤)
    (hgen : ∀ i, ∀ a : Γ(X, nvCover s i),
      a ∈ Subring.closure (Set.range (sectionConstants f (nvCover s i)) ∪ Set.range (ratio s i))) :
    IsClosedImmersion (toPolynomialModel s hs f) :=
  IsZariskiLocalAtTarget.of_iSup_eq_top _
    (Stacks.AlgebraicGeometry.ProjPolyChart.iSup_basicOpen_X_eq_top k n) fun i =>
      isClosedImmersion_morphismRestrict_basicOpen f s hs i
        (isAffineOpen_nvCover_of_generatesStalks f s hs hdim hvan i) (hgen i)

/-- **The morphism of a family of sections to `ℙⁿ_k` is a closed immersion** as soon as two of the
charts cover `X`, none of the sections vanishes nowhere, and on those two charts the functions are
generated by the constants and the ratios. -/
theorem isClosedImmersion_toPolynomialModel_of_sup {i₀ i₁ : Fin (n + 1)}
    (hdim : topologicalKrullDim X ≤ 1)
    (hcov : nvCover s i₀ ⊔ nvCover s i₁ = ⊤) (hvan : ∀ i, nvCover s i ≠ ⊤)
    (hgen : ∀ i : Fin (n + 1), i = i₀ ∨ i = i₁ → ∀ a : Γ(X, nvCover s i),
      a ∈ Subring.closure (Set.range (sectionConstants f (nvCover s i)) ∪ Set.range (ratio s i))) :
    IsClosedImmersion (toPolynomialModel s (generatesStalks_of_sup s hcov) f) := by
  set hs := generatesStalks_of_sup s hcov
  set Φ := toPolynomialModel s hs f with hΦ
  have : IsFinite Φ := isFinite_toPolynomialModel f s hs hdim hvan
  let W : (Proj (polyGrading k n)).Opens :=
    ⟨(Set.range Φ)ᶜ, Φ.isClosedMap.isClosed_range.isOpen_compl⟩
  let V : Option Bool → (Proj (polyGrading k n)).Opens := fun o =>
    o.elim W fun b => Proj.basicOpen (polyGrading k n) (MvPolynomial.X (if b then i₀ else i₁))
  refine IsZariskiLocalAtTarget.of_iSup_eq_top V (eq_top_iff.mpr fun y _ => ?_) ?_
  · by_cases hy : y ∈ Set.range Φ
    · obtain ⟨x, rfl⟩ := hy
      have hx : x ∈ (nvCover s i₀ ⊔ nvCover s i₁ : X.Opens) := by rw [hcov]; trivial
      rcases hx with h0 | h1
      · refine TopologicalSpace.Opens.mem_iSup.mpr ⟨some true, ?_⟩
        have h := (preimage_basicOpen_toPolynomialModel s hs f i₀).symm ▸ h0
        exact h
      · refine TopologicalSpace.Opens.mem_iSup.mpr ⟨some false, ?_⟩
        have h := (preimage_basicOpen_toPolynomialModel s hs f i₁).symm ▸ h1
        exact h
    · exact TopologicalSpace.Opens.mem_iSup.mpr ⟨none, hy⟩
  · rintro (_ | b)
    · have : IsEmpty (Φ ⁻¹ᵁ W).toScheme :=
        ⟨fun x => (x.2 : Φ x.1 ∈ (Set.range Φ)ᶜ) ⟨x.1, rfl⟩⟩
      change IsClosedImmersion (Φ ∣_ W)
      infer_instance
    · have hj : (if b then i₀ else i₁) = i₀ ∨ (if b then i₀ else i₁) = i₁ := by
        cases b <;> simp
      exact isClosedImmersion_morphismRestrict_basicOpen f s hs _
        (isAffineOpen_nvCover f s hdim hcov hvan _) (hgen _ hj)

end ClosedImmersion

/-! ### Very ampleness -/

section VeryAmple

variable {k : Type u} [Field k] {n : ℕ} {X : Scheme.{u}} {L : X.Modules}
  [Stacks.Ample.IsInvertibleModule X L] (f : X ⟶ Spec (CommRingCat.of k))
  (s : Fin (n + 1) → Γ(L, ⊤)) (hs : GeneratesStalks s)

/-- **If the morphism of a generating family is a closed immersion, then `ℒ` is very ample relative
to `f`.** The morphism to the base-change model `ℙⁿ_{Spec k}` is the closed immersion followed by
an isomorphism, it lies over `Spec k`, and it pulls `𝒪(1)` back to `ℒ`
(`Stacks.TwistPullbackPinned.exists_iso_pullback_twistingSheafAtUniverse`); this is
[Stacks, Tag 01VS]'s per-degree conclusion, which gives [Stacks, Tag 01VM] very ampleness over the
affine base `Spec k`. -/
theorem isRelativelyVeryAmple_of_isClosedImmersion_toPolynomialModel
    [IsClosedImmersion (toPolynomialModel s hs f)] :
    Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple f L := by
  set p := toProjectiveSpaceOver s hs f
  have hp : p = toPolynomialModel s hs f ≫ (polynomialComparison k n).iso.inv := by
    rw [toPolynomialModel, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have : IsClosedImmersion p := by rw [hp]; infer_instance
  obtain ⟨α, hα, -⟩ := Stacks.TwistPullbackPinned.exists_iso_pullback_twistingSheafAtUniverse s
    (p ≫ projectiveSpaceOver.toIntegralAtUniverse n (Spec (CommRingCat.of k)))
    (isOpenCover_nvCover_of_generatesStalks s hs) fun i => by
      rw [toProjectiveSpaceOver_snd]; exact ι_toProjectiveSpaceAtUniverse s hs i
  have : IsIso α := hα
  refine Stacks.AmpleRelativeFiniteType.isRelativelyVeryAmple_of_hasImmersionTwistOver
    (fun m => Stacks.SymGraded.hasFreeBundleTwistOne (Spec (CommRingCat.of k)) m) f L
    ⟨n, p, inferInstance, toProjectiveSpaceOver_fst s hs f, ⟨(asIso α).symm ≪≫
      ((Scheme.Modules.pullbackComp p
        (projectiveSpaceOver.toIntegralAtUniverse n (Spec (CommRingCat.of k)))).app _).symm⟩⟩

end VeryAmple

/-! ### The plane conic -/

section Main

variable {k : Type u} [Field k] {X : Scheme.{u}} {L : X.Modules}
  [Stacks.Ample.IsInvertibleModule X L] (f : X ⟶ Spec (CommRingCat.of k))

/-- **Dehomogenizing a linear form at `Tᵢ`**: `(∑ₘ aₘ Tₘ) / Tᵢ = ∑ₘ aₘ (Tₘ / Tᵢ)` in the chart ring
`k[T₀, …, Tₙ]_{(Tᵢ)}`. -/
theorem away_mk_linear {n : ℕ} (i : Fin (n + 1)) (a : Fin (n + 1) → k)
    (h : (∑ m, MvPolynomial.monomial (Finsupp.single m 1) (a m) :
      MvPolynomial (Fin (n + 1)) k) ∈ polyGrading k n (1 • 1)) :
    HomogeneousLocalization.Away.mk (polyGrading k n) (X_mem_one k n i) 1
        (∑ m, MvPolynomial.monomial (Finsupp.single m 1) (a m)) h =
      ∑ m, coeffToAway k n i (a m) * coordFracAt k n i m := by
  have hv : ∀ x : HomogeneousLocalization.Away (polyGrading k n) (MvPolynomial.X i),
      x.val = algebraMap _ (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) k))
        x := fun x => (HomogeneousLocalization.algebraMap_apply x).symm
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.Away.val_mk, hv, map_sum, Localization.mk_sum]
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [map_mul, ← hv, ← hv, Stacks.AlgebraicGeometry.ProjPolyChart.coeffToAway_eq_mk, coordFracAt,
    HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, Localization.mk_mul]
  congr 1
  · rw [MvPolynomial.C_mul_X_eq_monomial]
  · ext; simp

variable [IsProper f] [IsIntegral X] (s : Fin 3 → Γ(L, ⊤))

/-- **A proper integral curve over `k` of genus zero carrying three sections of an invertible
module as below is a plane conic.** The sections `s₀, s₁, s₂` are `k`-linearly independent, `s₀`
and `s₁` have no common zero, none of them vanishes nowhere, and on the charts `X_{s₀}` and
`X_{s₁}` the functions are generated by the constants and the ratios. Then the morphism
`X ⟶ ℙ²_k` of the sections is a closed immersion onto a plane curve whose equation has degree
`2`. -/
theorem exists_planeCurveData_deg_two (hdim1 : topologicalKrullDim X = 1)
    (hcov : nvCover s 0 ⊔ nvCover s 1 = ⊤) (hvan : ∀ i, nvCover s i ≠ ⊤)
    (hgenus : genus f = 0)
    (hindep : ∀ c : Fin 3 → k, ∑ i, baseRingHom f (c i) • s i = 0 → c = 0)
    (hgen : ∀ i : Fin 3, i = 0 ∨ i = 1 → ∀ a : Γ(X, nvCover s i),
      a ∈ Subring.closure (Set.range (sectionConstants f (nvCover s i)) ∪ Set.range (ratio s i))) :
    ∃ C : ProjectiveSpectrum.Proj.PlaneCurveData k, C.deg = 2 ∧
      ∃ e : X ≅ C.Z, e.hom ≫ C.toSpec = f := by
  have hdim : topologicalKrullDim X ≤ 1 := hdim1.le
  set hs := generatesStalks_of_sup s hcov
  set Φ := toPolynomialModel s hs f with hΦ
  have : IsClosedImmersion Φ := isClosedImmersion_toPolynomialModel_of_sup f s hdim hcov hvan hgen
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have hno := hasNoEmbeddedPoints_of_isIntegral X
  have hequi : ∀ W ∈ irreducibleComponents X, topologicalKrullDim W = 1 := by
    intro W hW
    rw [irreducibleComponents_eq_singleton, Set.mem_singleton_iff] at hW
    subst hW
    rw [IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ X).isHomeomorph, hdim1]
  set C := ProjectiveSpectrum.Proj.planeCurveData k Φ hno hequi with hC
  have := C.isClosedImmersion
  have hcomp : Φ ≫ projToSpecCoeff k 2 = f := toPolynomialModel_comp_projToSpecCoeff s hs f
  have hg : genus (Φ ≫ projToSpecCoeff k 2) = (C.deg - 1) * (C.deg - 2) / 2 :=
    ProjectiveSpectrum.Proj.genus_planeCurve C
  rw [hcomp, hgenus] at hg
  have hpos := C.deg_pos
  have hle : C.deg ≤ 2 := by
    by_contra h
    obtain ⟨m, hm⟩ : ∃ m, C.deg = m + 3 := ⟨C.deg - 3, by omega⟩
    rw [hm, show m + 3 - 1 = m + 2 by omega, show m + 3 - 2 = m + 1 by omega] at hg
    have : 0 < (m + 2) * (m + 1) / 2 := Nat.div_pos (by nlinarith) (by norm_num)
    omega
  have hne1 : C.deg ≠ 1 := by
    intro h1
    have hFh : C.F.IsHomogeneous 1 := by
      have := C.isHomogeneous
      rw [h1] at this
      exact (MvPolynomial.mem_homogeneousSubmodule _ _).1 this
    have hsum := eq_sum_monomial_of_isHomogeneous_one hFh
    have hF1 : C.F ∈ MvPolynomial.homogeneousSubmodule (Fin (2 + 1)) k (1 • 1) :=
      (MvPolynomial.mem_homogeneousSubmodule _ _).2 (by simpa using hFh)
    have hFI : C.F ∈ ProjectiveSpectrum.Proj.idealOfClosedSubscheme (polyGrading k 2) C.i := by
      rw [C.span_eq]; exact Ideal.mem_span_singleton_self _
    have hchart : ∀ j : Fin 3, resT (nvCover s j)
        (∑ m, baseRingHom f (C.F.coeff (Finsupp.single m 1)) • s m) = 0 := by
      intro j
      have hker := ProjectiveSpectrum.Proj.projectiveSpace_chartFraction_mem_ker_app k (2 + 1)
        C.i j 1 ⟨C.F, hF1⟩ hFI
      have hz : Φ.app (Proj.basicOpen (polyGrading k 2) (MvPolynomial.X j))
          ((Proj.awayToSection (polyGrading k 2) (MvPolynomial.X j)).hom
            (HomogeneousLocalization.Away.mk (polyGrading k 2) (X_mem_one k 2 j) 1 C.F hF1)) =
          0 := RingHom.mem_ker.mp hker
      have hz' : Φ.appLE (Proj.basicOpen (polyGrading k 2) (MvPolynomial.X j)) (nvCover s j)
          (nvCover_le_preimage_basicOpen_toPolynomialModel s hs f j)
          ((Proj.awayToSection (polyGrading k 2) (MvPolynomial.X j)).hom
            (HomogeneousLocalization.Away.mk (polyGrading k 2) (X_mem_one k 2 j) 1 C.F hF1)) =
          0 := by
        change X.presheaf.map _ (Φ.app _ _) = 0
        rw [hz, map_zero]
      have hlin : HomogeneousLocalization.Away.mk (polyGrading k 2) (X_mem_one k 2 j) 1 C.F hF1
          = ∑ m, coeffToAway k 2 j (C.F.coeff (Finsupp.single m 1)) * coordFracAt k 2 j m := by
        rw [← away_mk_linear j _ (hsum ▸ hF1)]
        congr 1
      rw [hlin, map_sum, map_sum] at hz'
      have hz'' : (∑ m, resO (le_top : nvCover s j ≤ ⊤)
          (baseRingHom f (C.F.coeff (Finsupp.single m 1))) * ratio s j m) = 0 := by
        rw [← hz']
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [map_mul, map_mul]
        exact congrArg₂ (· * ·) (appLE_awayToSection_coeffToAway f s hs j _).symm
          (appLE_coordFracAt_chart s hs f j m).symm
      have hres : ∀ x : Γ(X, nvCover s j), resO (le_refl (nvCover s j)) x = x := fun x => by
        simp [resO]
      rw [← sum_mul_resO_ratio_smul s f (le_refl (nvCover s j))]
      simp only [hres]
      rw [hz'', zero_smul]
    have hσ : ∑ m, baseRingHom f (C.F.coeff (Finsupp.single m 1)) • s m = 0 := by
      refine TopCat.Sheaf.eq_of_locally_eq₂ (F := ⟨L.presheaf, L.isSheaf⟩)
        (homOfLE (le_top : nvCover s 0 ≤ ⊤)) (homOfLE (le_top : nvCover s 1 ≤ ⊤))
        (by rw [hcov]) _ _ ?_ ?_ <;> exact (hchart _).trans (map_zero _).symm
    have ha := hindep _ hσ
    apply C.F_ne_zero
    rw [hsum]
    refine Finset.sum_eq_zero fun m _ => ?_
    rw [show C.F.coeff (Finsupp.single m 1) = 0 from congrFun ha m, map_zero]
  refine ⟨C, by omega, Iso.refl X, ?_⟩
  exact (Category.id_comp _).trans hcomp


end Main

end AlgebraicGeometry.PlaneConic

end
