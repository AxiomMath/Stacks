module

public import StacksFrontier.AlgebraicGeometry.Curves.GenusZeroPositiveDegree.Conic
public import StacksFrontier.AlgebraicGeometry.ProjNoetherian.Basic
public import StacksFrontier.Topology.Dimension.NowhereDense

/-!
# A positive-degree invertible module on a genus-zero curve is very ample

Let `X` be a proper curve over a field `k` with `H⁰(X, 𝒪_X) = k` and genus `0`, and let `ℒ` be an
invertible `𝒪_X`-module of degree `d > 0`, so that `dim_k H⁰(X, ℒ) = d + 1` ([Stacks, Tag 0C6T]
part (1)). This file proves part (2) of [Stacks, Tag 0C6T]: `ℒ` is very ample, and a basis
`s₀, …, s_d` of `H⁰(X, ℒ)` defines a closed immersion `X ⟶ 𝐏^d_k`. For `d = 1` the closed immersion
is an isomorphism `X ≅ 𝐏¹_k`.

## The route

The source identifies `X` with `Proj` of its section ring. Here the closed immersion is checked on
the standard charts `D₊(Tᵢ)`, whose preimages are the charts `X_{sᵢ}`. The morphism of the `sᵢ` is
finite (proper and quasi-finite), so `X_{sᵢ}` is affine, and `Γ(X_{sᵢ}, 𝒪)` is generated by the
ratios `sⱼ/sᵢ` by a pole-order induction against a second chart `X_t` with `X_{sᵢ} ∪ X_t = X`
(`AlgebraicGeometry.adjoin_ratio_eq_top`), whose input is that the zero scheme of `sᵢ` has degree
`d`. Very ampleness is the pinned comparison of `ℒ` with the pulled-back `𝒪(1)` of
[Stacks, Tag 01NE].

## Main results

* `AlgebraicGeometry.isRelativelyVeryAmple_and_isClosedImmersion_of_basis`: **[Stacks, Tag 0C6T]
  part (2).**
* `AlgebraicGeometry.isIso_toPolynomialModel_of_invertibleCurveDegree_eq_one` and
  `AlgebraicGeometry.isIso_toProjectiveSpaceOver_of_invertibleCurveDegree_eq_one`: for `d = 1`
  the morphism of a basis is an isomorphism onto `𝐏¹_k`, in both models.
* `AlgebraicGeometry.exists_iso_projectiveLine_of_invertibleCurveDegree_eq_one`: hence
  `X ≅ 𝐏¹_k` over `k`.

## References

* [Stacks Project, Tag 0C6T](https://stacks.math.columbia.edu/tag/0C6T)
* [Stacks Project, Tag 01NE](https://stacks.math.columbia.edu/tag/01NE)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.ProjectiveFromSections Stacks.ModuleStalk

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

namespace AlgebraicGeometry

/-- **A combination of sections vanishes where all of them vanish**: the nonvanishing open of
`∑ cⱼ • sⱼ` lies in the union of those of the `sⱼ`. -/
alias nvOpen_sum_smul_le := AlgebraicGeometry.ProjectiveLineCriterion.nvOpen_sum_smul_le

variable {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))

/-- **A basis of `H⁰(X, ℒ)`, read as global sections.** For a `k`-basis `b` of the global
sections of `ℒ` (with the `k`-structure of `AlgebraicGeometry.restrictScalarsOverBase`), the
sections `b j` are independent and spanning for the action of `k` through `Γ(X, 𝒪_X)`. -/
theorem independent_and_spanning_of_basis {ι : Type*} [Fintype ι] (L : X.Modules)
    (b : Module.Basis ι k ((restrictScalarsOverBase k f).obj
      ((SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).obj L))) :
    (∀ c : ι → k, ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) •
        (show Γ(L, ⊤) from b j) = 0 → c = 0) ∧
      ∀ σ : Γ(L, ⊤), ∃ c : ι → k,
        σ = ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) •
          (show Γ(L, ⊤) from b j) := by
  let M := (restrictScalarsOverBase k f).obj
    ((SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).obj L)
  let e : M →+ Γ(L, ⊤) := { toFun := fun x => x, map_zero' := rfl, map_add' := fun _ _ => rfl }
  have key : ∀ c : ι → k, e (∑ j, c j • b j) =
      ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) • (show Γ(L, ⊤) from b j) := by
    intro c
    rw [map_sum]
    exact Finset.sum_congr rfl fun j _ => smul_globalSections_eq k f L (c j) (b j)
  refine ⟨fun c hc => ?_, fun σ => ?_⟩
  · exact funext
      (Fintype.linearIndependent_iff.mp b.linearIndependent c ((key c).trans hc))
  · refine ⟨fun j => b.repr (show M from σ) j, ?_⟩
    rw [← key]
    exact (b.sum_repr (show M from σ)).symm

/-- **The charts of a basis of sections cover the curve.** On a proper integral scheme of
dimension at most one over `k` with `H¹(X, 𝒪_X) = 0`, global sections `s₀, …, sₙ` of an invertible
module spanning its global sections over `k`, one of them nonzero, have no common zero: a section
`t` not vanishing on the zero scheme of a nonzero `sᵢ` is a combination of the `sⱼ`. -/
theorem iSup_nvCover_eq_top_of_spanning [IsProper f] [IsIntegral X]
    (hdim : topologicalKrullDim X ≤ 1)
    (hH1 : IsZero (cohomologyOverField k f (SheafOfModules.unit X.ringCatSheaf) 1))
    (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L] {ι : Type*} [Fintype ι]
    (s : ι → Γ(L, ⊤)) (i : ι) (hsi : s i ≠ 0)
    (hspan : ∀ σ : Γ(L, ⊤), ∃ c : ι → k,
      σ = ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) • s j) :
    (⨆ j, nvCover s j) = ⊤ := by
  obtain ⟨t, ht⟩ := exists_sup_nvOpen_eq_top f hdim hH1 L (s i) hsi
  obtain ⟨c, hc⟩ := hspan t
  refine eq_top_iff.mpr (ht ▸ sup_le (le_iSup (nvCover s) i) ?_)
  rw [hc]
  exact nvOpen_sum_smul_le L _ s

/-- A positive-degree invertible module on a proper curve has no section nonvanishing
everywhere. -/
private theorem nvOpen_ne_top_of_invertibleCurveDegree_eq [IsProper f]
    (hdim : topologicalKrullDim X ≤ 1) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
    {d : ℕ} (hdeg : invertibleCurveDegree k f hdim L = d) (hd : 0 < d) (σ : Γ(L, ⊤)) :
    nvOpen L σ ≠ ⊤ :=
  nvOpen_ne_top_of_invertibleCurveDegree_pos f hdim L (hdeg ▸ by exact_mod_cast hd) σ

/-- **The chart rings of a basis of sections are generated by the ratios.** Let `X` be a proper
integral scheme of dimension at most one over `k` with `H⁰(X, 𝒪_X) = k` and genus `0`, and let
`s₀, …, s_d` be a basis of the global sections of an invertible module `ℒ` of degree `d > 0`. Then
for every `i` the ring `Γ(X_{sᵢ}, 𝒪)` is generated over `k` by the ratios `sⱼ / sᵢ`.

A section `t` not vanishing on the zero scheme of `sᵢ` exists because `H¹(X, 𝒪_X) = 0`; its
nonvanishing open is affine, being a chart of the finite morphism of the family `(t, s₀, …, s_d)`,
and the zero scheme of `sᵢ` read on `X_t` has dimension `d`; so
`AlgebraicGeometry.adjoin_ratio_eq_top` applies with partner `t`. -/
theorem adjoin_ratio_eq_top_of_basis [IsProper f] [IsIntegral X]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)] (hdim : topologicalKrullDim X ≤ 1)
    (hgenus : genus f = 0) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L] {d : ℕ}
    (hdeg : invertibleCurveDegree k f hdim L = d) (hd : 0 < d) (s : Fin (d + 1) → Γ(L, ⊤))
    (hind : ∀ c : Fin (d + 1) → k,
      ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) • s j = 0 → c = 0)
    (hspan : ∀ σ : Γ(L, ⊤), ∃ c : Fin (d + 1) → k,
      σ = ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) • s j)
    (i : Fin (d + 1)) :
    letI := (sectionConstants f (nvCover s i)).toAlgebra
    Algebra.adjoin k (Set.range (ratio s i)) = ⊤ := by
  have hvan := nvOpen_ne_top_of_invertibleCurveDegree_eq f hdim L hdeg hd
  have hsi : s i ≠ 0 := by
    intro h0
    simpa using congrFun (hind (Pi.single i 1) (by
      rw [Finset.sum_eq_single i (fun j _ hj => by simp [Pi.single_eq_of_ne hj])
        (by simp)]
      simp [h0])) i
  have hH1 := isZero_cohomologyOverField_unit_one_of_genus_eq_zero k f hgenus
  obtain ⟨t, ht⟩ := exists_sup_nvOpen_eq_top f hdim hH1 L (s i) hsi
  -- the chart of `t` is affine: it is a chart of the family `(t, s₀, …, s_d)`
  let s' : Fin (d + 2) → Γ(L, ⊤) := Fin.cons t s
  have hs' : IsOpenCover (nvCover s') := by
    change (⨆ j, nvCover s' j) = ⊤
    exact eq_top_iff.mpr (ht ▸ sup_le (le_iSup (nvCover s') i.succ) (le_iSup (nvCover s') 0))
  have hV : IsAffineOpen (nvOpen L t) :=
    PlaneConic.isAffineOpen_nvCover_of_isOpenCover f s' hdim hs' (fun j => hvan _) 0
  have hne : ((nvCover s i : Set X) ∩ nvOpen L t).Nonempty := by
    have hnonempty : ∀ σ τ : Γ(L, ⊤), nvOpen L σ ⊔ nvOpen L τ = ⊤ →
        (nvOpen L σ : Set X).Nonempty := by
      intro σ τ hστ
      rw [Set.nonempty_iff_ne_empty]
      intro h
      apply hvan τ
      rw [← hστ, show nvOpen L σ = ⊥ from SetLike.coe_injective h, bot_sup_eq]
    have hUne := hnonempty _ _ ht
    have hVne := hnonempty _ _ (by rwa [sup_comm])
    exact nonempty_preirreducible_inter (nvCover s i).2 (nvOpen L t).2 hUne hVne
  have hfin := finiteDimensional_quotient_span_ratio f hdim L (s i) t hsi ht hV
  have hle := finrank_quotient_span_ratio_le f hdim L (s i) t hsi ht hV
  rw [hdeg] at hle
  exact adjoin_ratio_eq_top f L s i t ht hV hne hind (hspan t) (hfin := hfin)
    (by exact_mod_cast hle)

/-- **[Stacks, Tag 0C6T] part (2).** Let `X` be a proper integral scheme of dimension at most one
over a field `k` with `H⁰(X, 𝒪_X) = k` and genus `0`, and let `ℒ` be an invertible `𝒪_X`-module of
degree `d > 0`. Then `ℒ` is very ample over `k`, and for every basis `s₀, …, s_d` of `H⁰(X, ℒ)` the
sections generate `ℒ` and the morphism `φ_{(ℒ, (s₀, …, s_d))} : X ⟶ 𝐏^d_k` they define is a closed
immersion. -/
@[stacks 0C6T "part (2)"]
theorem isRelativelyVeryAmple_and_isClosedImmersion_of_basis [IsProper f] [IsIntegral X]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)] (hdim : topologicalKrullDim X ≤ 1)
    (hgenus : genus f = 0) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L] {d : ℕ}
    (hdeg : invertibleCurveDegree k f hdim L = d) (hd : 0 < d)
    (b : Module.Basis (Fin (d + 1)) k ((restrictScalarsOverBase k f).obj
      ((SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).obj L))) :
    Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple f L ∧
      ∃ hs : GeneratesStalks (fun j => (show Γ(L, ⊤) from b j)),
        IsClosedImmersion (Stacks.ProjectiveSpaceChartRatio.toPolynomialModel
          (fun j => (show Γ(L, ⊤) from b j)) hs f) := by
  set s : Fin (d + 1) → Γ(L, ⊤) := fun j => (show Γ(L, ⊤) from b j)
  obtain ⟨hind, hspan⟩ := independent_and_spanning_of_basis f L b
  have hvan := nvOpen_ne_top_of_invertibleCurveDegree_eq f hdim L hdeg hd
  have hcov : IsOpenCover (nvCover s) := iSup_nvCover_eq_top_of_spanning f hdim
    (isZero_cohomologyOverField_unit_one_of_genus_eq_zero k f hgenus) L s 0 (b.ne_zero 0) hspan
  have hs := Stacks.AmpleImmersionReduction.generatesStalks_of_isOpenCover s hcov
  have hgen : ∀ i, ∀ a : Γ(X, nvCover s i),
      a ∈ Subring.closure
        (Set.range (sectionConstants f (nvCover s i)) ∪ Set.range (ratio s i)) := by
    intro i a
    let := (sectionConstants f (nvCover s i)).toAlgebra
    have hadj := adjoin_ratio_eq_top_of_basis f hdim hgenus L hdeg hd s hind hspan i
    have hmem : a ∈ (Algebra.adjoin k (Set.range (ratio s i))).toSubring := by
      rw [hadj]
      trivial
    rwa [Algebra.adjoin_eq_ring_closure] at hmem
  have himm : IsClosedImmersion (Stacks.ProjectiveSpaceChartRatio.toPolynomialModel s hs f) :=
    PlaneConic.isClosedImmersion_toPolynomialModel f s hs hdim (fun i => hvan _) hgen
  exact ⟨PlaneConic.isRelativelyVeryAmple_of_isClosedImmersion_toPolynomialModel f s hs, hs, himm⟩

/-- **The morphism of a basis of sections of a degree-one module on a genus-zero curve is an
isomorphism onto `𝐏¹_k`.** Let `X` be a proper integral scheme of dimension one over a field `k`
with `H⁰(X, 𝒪_X) = k` and genus `0`, and let `ℒ` be invertible of degree `1`. For a basis `s₀, s₁`
of `H⁰(X, ℒ)`, the morphism `φ_{(ℒ, (s₀, s₁))} : X ⟶ 𝐏¹_k` is an isomorphism. -/
theorem isIso_toPolynomialModel_of_invertibleCurveDegree_eq_one [IsProper f] [IsIntegral X]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)] (hdim : topologicalKrullDim X = 1)
    (hgenus : genus f = 0) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
    (hdeg : invertibleCurveDegree k f hdim.le L = 1)
    (b : Module.Basis (Fin (1 + 1)) k ((restrictScalarsOverBase k f).obj
      ((SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).obj L)))
    (hs : GeneratesStalks (fun j => (show Γ(L, ⊤) from b j))) :
    IsIso (Stacks.ProjectiveSpaceChartRatio.toPolynomialModel
      (fun j => (show Γ(L, ⊤) from b j)) hs f) := by
  obtain ⟨-, hs', himm⟩ := isRelativelyVeryAmple_and_isClosedImmersion_of_basis f hdim.le hgenus L
    (d := 1) (by exact_mod_cast hdeg) one_pos b
  set φ := Stacks.ProjectiveSpaceChartRatio.toPolynomialModel
    (fun j => (show Γ(L, ⊤) from b j)) hs f
  have : IsClosedImmersion φ := himm
  have := Stacks.AlgebraicGeometry.ProjPolyChart.isIntegral_proj k 1
  have hsurj : Function.Surjective φ := by
    have hclosed : IsClosed (Set.range φ) := φ.isClosedEmbedding.isClosed_range
    by_contra hns
    have hP : topologicalKrullDim
        (AlgebraicGeometry.Proj (Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading k 1)) = 1 := by
      simpa using Stacks.ProjectiveSpace.topologicalKrullDim_proj_fin k (r := 2) two_pos
    have hnd : IsNowhereDense (Set.range φ) := by
      rw [hclosed.isNowhereDense_iff]
      by_contra hint
      have hdense := (isOpen_interior).dense (Set.nonempty_iff_ne_empty.mpr hint)
      exact hns (Set.range_eq_univ.mp (Set.eq_univ_of_univ_subset
        (hdense.closure_eq ▸ closure_minimal interior_subset hclosed)))
    have hlt := hnd.topologicalKrullDim_lt hclosed inferInstance (by rw [hP]; decide)
    have hX : topologicalKrullDim X = topologicalKrullDim (Set.range φ) :=
      IsHomeomorph.topologicalKrullDim_eq _
        φ.isClosedEmbedding.isEmbedding.toHomeomorph.isHomeomorph
    rw [hP, ← hX, hdim] at hlt
    exact lt_irrefl _ hlt
  have : Surjective φ := ⟨hsurj⟩
  exact isIso_of_isClosedImmersion_of_surjective φ

/-- **The same in the base-change model `𝐏¹_k = Spec k ×_{Spec ℤ} 𝐏¹_ℤ`**: the morphism
`Stacks.ProjectiveFromSections.toProjectiveSpaceOver` of a basis of sections of a degree-one module
on a genus-zero curve is an isomorphism. -/
theorem isIso_toProjectiveSpaceOver_of_invertibleCurveDegree_eq_one [IsProper f] [IsIntegral X]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)] (hdim : topologicalKrullDim X = 1)
    (hgenus : genus f = 0) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
    (hdeg : invertibleCurveDegree k f hdim.le L = 1)
    (b : Module.Basis (Fin (1 + 1)) k ((restrictScalarsOverBase k f).obj
      ((SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).obj L)))
    (hs : GeneratesStalks (fun j => (show Γ(L, ⊤) from b j))) :
    IsIso (Stacks.ProjectiveFromSections.toProjectiveSpaceOver
      (fun j => (show Γ(L, ⊤) from b j)) hs f) := by
  have h : IsIso (Stacks.ProjectiveFromSections.toProjectiveSpaceOver
      (fun j => (show Γ(L, ⊤) from b j)) hs f ≫
        (Stacks.AlgebraicGeometry.ProjBaseChange.polynomialComparison k 1).iso.hom) :=
    isIso_toPolynomialModel_of_invertibleCurveDegree_eq_one f hdim hgenus L hdeg b hs
  exact IsIso.of_isIso_comp_right _
    (Stacks.AlgebraicGeometry.ProjBaseChange.polynomialComparison k 1).iso.hom

/-- **A genus-zero curve with an invertible module of degree one is the projective line.** Let `X`
be a proper integral scheme of dimension one over a field `k` with `H⁰(X, 𝒪_X) = k` and genus `0`,
carrying an invertible module of degree `1`. Then `X ≅ 𝐏¹_k` over `k`: the morphism of a basis of
`H⁰(X, ℒ)` is an isomorphism
(`AlgebraicGeometry.isIso_toPolynomialModel_of_invertibleCurveDegree_eq_one`). -/
theorem exists_iso_projectiveLine_of_invertibleCurveDegree_eq_one [IsProper f] [IsIntegral X]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)] (hdim : topologicalKrullDim X = 1)
    (hgenus : genus f = 0) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
    (hdeg : invertibleCurveDegree k f hdim.le L = 1) :
    ∃ e : X ≅ AlgebraicGeometry.Proj (Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading k 1),
      e.hom ≫ Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff k 1 = f := by
  let M := (restrictScalarsOverBase k f).obj
    ((SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).obj L)
  have hfin : Module.finrank k M = 2 := by
    have := finrank_globalSections_eq_invertibleCurveDegree_add_one k f hdim.le L hgenus
      (by
        rw [hdeg]
        norm_num)
    rw [hdeg] at this
    exact_mod_cast this
  have : Module.Finite k M := Module.finite_of_finrank_eq_succ hfin
  let b : Module.Basis (Fin (1 + 1)) k M := Module.finBasisOfFinrankEq k M hfin
  obtain ⟨-, hs, -⟩ := isRelativelyVeryAmple_and_isClosedImmersion_of_basis f hdim.le hgenus L
    (d := 1) (by exact_mod_cast hdeg) one_pos b
  have := isIso_toPolynomialModel_of_invertibleCurveDegree_eq_one f hdim hgenus L hdeg b hs
  exact ⟨asIso (Stacks.ProjectiveSpaceChartRatio.toPolynomialModel _ hs f),
    Stacks.ProjectiveSpaceChartRatio.toPolynomialModel_comp_projToSpecCoeff _ hs f⟩

end AlgebraicGeometry

end
