module

public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Tactic.LinearCombination
public import StacksFrontier.AlgebraicGeometry.ProjectiveFromSections.Ratio
public import StacksFrontier.AlgebraicGeometry.SectionExtension.Basic

/-!
# Generation of a chart ring by the ratios of sections, from a pole-order filtration

Let `X` be a curve covered by two affine opens `U` and `V`, with `U ∩ V` the locus where a
function `x ∈ 𝒪(U)` is invertible, `r = x⁻¹ ∈ 𝒪(V)`, and suppose `𝒪(U) ∩ 𝒪(V) = k` inside
`𝒪(U ∩ V)`. A function on `U` is `ρ xᵐ` for some `ρ ∈ 𝒪(V)` and `m ≥ 0`, its *pole order* along
`V \ U` being at most `m`; reducing the numerator `ρ` modulo `r` gives the leading term of the
function. If `𝒪(V)/(r)` is spanned by the reductions of finitely many functions `uⱼ = xⱼ r` with
`xⱼ ∈ 𝒪(U)`, an induction on the pole order writes every function on `U` as a polynomial in the
`xⱼ`.

This is the algebraic core of the proof that a positive-degree invertible module on a genus-zero
curve embeds the curve into projective space ([Stacks, Tag 0C6T]): there the `xⱼ` are the ratios
`sⱼ / sᵢ` of a family of global sections on the chart `X_{sᵢ}`, the `uⱼ` the ratios `sⱼ / sₚ` on a
second chart `X_{sₚ}`, and `𝒪(V)/(r)` is the coordinate ring of the zero scheme of `sᵢ`, whose
dimension is the degree.

## Main results

* `Algebra.adjoin_eq_top_of_leadingTerm`: the generation statement.

## References

* [Stacks Project, Tag 0C6T](https://stacks.math.columbia.edu/tag/0C6T)
-/

@[expose] public section

open Module

namespace Algebra

variable {k B R K : Type*} [Field k] [CommRing B] [CommRing R] [CommRing K] [Algebra k B]
  [Algebra k R] (ιB : B →+* K) (ιR : R →+* K)

/-- **Generation of a chart ring by a pole-order induction.** Let `ιB : B → K` and `ιR : R → K`
be ring maps agreeing on `k`, let `x : ι → B` and `u : ι → R` with `x i = 1`, and let `r ∈ R`
with `xⱼ r = uⱼ` in `K` for every `j`, and `w r = 1` for some `w` in the `k`-algebra generated by
the `xⱼ`. Suppose every element of `K` is `ρ wᵐ` for some `ρ ∈ R`, that an element of `B`
which agrees in `K` with an element of `R` is
a constant, that the `xⱼ` are linearly independent over `k`, and that `R/(r)` has dimension at
most `#ι - 1`. Then `B` is generated as a `k`-algebra by the `xⱼ`.

The reductions of the `uⱼ`, `j ≠ i`, are linearly independent in `R/(r)`: a relation
`∑ cⱼ uⱼ = r ρ` becomes `∑ cⱼ xⱼ = ρ` after multiplication by `w`, so it is a constant, which
independence of the `xⱼ` forbids. So they span `R/(r)`. For `β = ρ w^(m+1)` write
`ρ = ∑ cⱼ uⱼ + r ρ'`; then `β - ∑ cⱼ xⱼ wᵐ = ρ' wᵐ`, and induction on `m` applies. -/
theorem adjoin_eq_top_of_leadingTerm {ι : Type*} [Fintype ι]
    (hk : ∀ c : k, ιB (algebraMap k B c) = ιR (algebraMap k R c))
    (x : ι → B) (u : ι → R) (r : R) (i : ι) (w : B) (hw : w ∈ Algebra.adjoin k (Set.range x))
    (hxi : x i = 1)
    (hxr : ∀ j, ιB (x j) * ιR r = ιR (u j)) (hpr : ιB w * ιR r = 1)
    (hloc : ∀ z : K, ∃ (ρ : R) (m : ℕ), z = ιR ρ * ιB w ^ m)
    (hconst : ∀ (β : B) (ρ : R), ιB β = ιR ρ → β ∈ Set.range (algebraMap k B))
    (hind : LinearIndependent k x)
    [FiniteDimensional k (R ⧸ Ideal.span {r})]
    (hdim : finrank k (R ⧸ Ideal.span {r}) ≤ Fintype.card ι - 1) :
    Algebra.adjoin k (Set.range x) = ⊤ := by
  classical
  set A := Algebra.adjoin k (Set.range x) with hA
  let q : R →ₗ[k] R ⧸ Ideal.span {r} := (Ideal.Quotient.mkₐ k (Ideal.span {r})).toLinearMap
  let v : {j // j ≠ i} → R ⧸ Ideal.span {r} := fun j => q (u j)
  -- the ratios `xⱼ wᵐ` and `uⱼ` are related by `ιB w * ιR r = 1`
  have hgen : ∀ (m : ℕ) (c : {j // j ≠ i} → k),
      ιB (∑ j : {j // j ≠ i}, c j • (x j * w ^ m)) =
        ιR (∑ j, c j • u j) * ιB w ^ (m + 1) := by
    intro m c
    simp only [map_sum, Finset.sum_mul, Algebra.smul_def, map_mul, map_pow, ← hk, ← hxr]
    refine Finset.sum_congr rfl fun j _ => ?_
    linear_combination (-(ιB (algebraMap k B (c j)) * ιB (x j) * ιB w ^ m)) * hpr
  -- a relation among the `uⱼ` modulo `r` comes from a relation among the `xⱼ`
  have hrel : ∀ (c : {j // j ≠ i} → k) (ρ : R),
      ∑ j, c j • u j = r * ρ → c = 0 := by
    intro c ρ hρ
    have hK : ιB (∑ j : {j // j ≠ i}, c j • x j) = ιR ρ := by
      have hl := hgen 0 c
      simp only [pow_zero, mul_one, zero_add, pow_one] at hl
      rw [hl, hρ, map_mul]
      linear_combination (ιR ρ) * hpr
    obtain ⟨γ, hγ⟩ := hconst _ ρ hK
    let c' : ι → k := fun j => if h : j = i then -γ else c ⟨j, h⟩
    have hsum : ∑ j : ι, c' j • x j = 0 := by
      rw [Fintype.sum_eq_add_sum_subtype_ne _ i]
      have hci : c' i = -γ := dite_eq_left rfl
      have hcj : ∀ j : {j // j ≠ i}, c' j = c j := fun j => dite_eq_right j.2
      simp only [hci, hcj, hxi, ← Algebra.algebraMap_eq_smul_one]
      rw [map_neg, hγ, neg_add_cancel]
    have hzero := Fintype.linearIndependent_iff.mp hind c' hsum
    funext j
    have := hzero j
    rwa [show c' j = c j from dite_eq_right j.2] at this
  have hvind : LinearIndependent k v := by
    refine Fintype.linearIndependent_iff.mpr fun c hc => ?_
    have hmem : ∑ j, c j • u j ∈ Ideal.span {r} := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      have : q (∑ j, c j • u j) = 0 := by
        rw [map_sum]
        simpa [v, map_smul] using hc
      exact this
    obtain ⟨ρ, hρ⟩ := Ideal.mem_span_singleton'.mp hmem
    exact congrFun (hrel c ρ (by rw [← hρ, mul_comm]))
  have hcard : Fintype.card {j // j ≠ i} = finrank k (R ⧸ Ideal.span {r}) := by
    refine le_antisymm hvind.fintype_card_le_finrank ?_
    rw [Fintype.card_subtype_compl, Fintype.card_subtype_eq]
    exact hdim
  have hspan : Submodule.span k (Set.range v) = ⊤ :=
    hvind.span_eq_top_of_card_eq_finrank' hcard
  -- the induction on the pole order
  have key : ∀ m : ℕ, ∀ (β : B) (ρ : R), ιB β = ιR ρ * ιB w ^ m → β ∈ A := by
    intro m
    induction m with
    | zero =>
      intro β ρ h
      rw [pow_zero, mul_one] at h
      obtain ⟨γ, rfl⟩ := hconst β ρ h
      exact A.algebraMap_mem γ
    | succ m ih =>
      intro β ρ h
      have hρ : q ρ ∈ Submodule.span k (Set.range v) := hspan ▸ Submodule.mem_top
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun k).mp hρ
      have hmem : ρ - ∑ j, c j • u j ∈ Ideal.span {r} := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        have : q (ρ - ∑ j, c j • u j) = 0 := by
          rw [map_sub, map_sum, ← hc]
          simp [v, map_smul]
        exact this
      obtain ⟨ρ', hρ'⟩ := Ideal.mem_span_singleton'.mp hmem
      set β' := β - ∑ j : {j // j ≠ i}, c j • (x j * w ^ m) with hβ'
      have hβ'mem : β' ∈ A := by
        refine ih β' ρ' ?_
        rw [hβ', map_sub, hgen, h, show ρ = ρ' * r + ∑ j, c j • u j by rw [hρ']; ring,
          map_add, map_mul]
        linear_combination (ιR ρ' * ιB w ^ m) * hpr
      have hsum_mem : ∑ j : {j // j ≠ i}, c j • (x j * w ^ m) ∈ A :=
        Subalgebra.sum_mem _ fun j _ => Subalgebra.smul_mem _
          (Subalgebra.mul_mem _ (Algebra.subset_adjoin (Set.mem_range_self (j : ι)))
            (Subalgebra.pow_mem _ hw _)) _
      have : β = β' + ∑ j : {j // j ≠ i}, c j • (x j * w ^ m) := by rw [hβ']; ring
      rw [this]
      exact Subalgebra.add_mem _ hβ'mem hsum_mem
  refine Algebra.eq_top_iff.mpr fun β => ?_
  obtain ⟨ρ, m, h⟩ := hloc (ιB β)
  exact key m β ρ h

end Algebra

end

@[expose] public noncomputable section

namespace AlgebraicGeometry

open CategoryTheory Opposite TopologicalSpace
open Stacks.ProjectiveFromSections

universe u

variable {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))

/-- The constants of an open `U` of a scheme over `k`: the ring map `k ⟶ Γ(X, U)` through the
global functions. -/
abbrev sectionConstants (U : X.Opens) : k →+* Γ(X, U) :=
  ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.presheaf.map (homOfLE le_top).op).hom

/-- Restricting the constants of an open to a smaller open gives the constants there. -/
theorem map_sectionConstants {U U' : X.Opens} (h : U ≤ U') (c : k) :
    (X.presheaf.map (homOfLE h).op).hom (sectionConstants f U' c) = sectionConstants f U c := by
  simp only [sectionConstants, CommRingCat.hom_comp, RingHom.comp_apply]
  rw [← CommRingCat.comp_apply, ← Functor.map_comp]
  rfl

variable [IsIntegral X] [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)]
  (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]

/-- **The chart ring of a section is generated by its ratios.** Let `s₀, …, sₙ` be linearly
independent global sections of an invertible module `L` on an integral scheme over `k` with
`H⁰(X, 𝒪_X) = k`, and let `t` be a `k`-linear combination of them with `X_{sᵢ} ∪ X_t = X` and
`X_t` affine. Suppose the zero scheme of `sᵢ`, whose coordinate ring is `Γ(X_t, 𝒪) / (sᵢ/t)`, has
dimension at most `n` over `k`. Then `Γ(X_{sᵢ}, 𝒪)` is generated as a `k`-algebra by the ratios
`sⱼ / sᵢ`.

This is `Algebra.adjoin_eq_top_of_leadingTerm` with `K` the functions on
`X_{sᵢ} ∩ X_t = D(sᵢ/t) ⊆ X_t` and `w = t / sᵢ`: a function there is a function on `X_t`
divided by a power of `sᵢ/t`; a function on `X_{sᵢ}` agreeing with one on `X_t` glues to a
global function, a constant; and independence of the ratios on `X_{sᵢ}` is independence of the
sections, which a vanishing ratio combination gives on both opens. -/
theorem adjoin_ratio_eq_top {n : ℕ} (s : Fin (n + 1) → Γ(L, ⊤)) (i : Fin (n + 1))
    (t : Γ(L, ⊤)) (hcov : nvCover s i ⊔ nvOpen L t = ⊤) (hV : IsAffineOpen (nvOpen L t))
    (hne : ((nvCover s i : Set X) ∩ nvOpen L t).Nonempty)
    (hind : ∀ c : Fin (n + 1) → k,
      ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) • s j = 0 → c = 0)
    (hspan : ∃ c : Fin (n + 1) → k,
      t = ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) • s j)
    [hfin : letI := (sectionConstants f (nvOpen L t)).toAlgebra
      FiniteDimensional k (Γ(X, nvOpen L t) ⧸
        Ideal.span {div t le_rfl (resT (nvOpen L t) (s i))})]
    (hdim : letI := (sectionConstants f (nvOpen L t)).toAlgebra
      Module.finrank k (Γ(X, nvOpen L t) ⧸
        Ideal.span {div t le_rfl (resT (nvOpen L t) (s i))}) ≤ n) :
    letI := (sectionConstants f (nvCover s i)).toAlgebra
    Algebra.adjoin k (Set.range (ratio s i)) = ⊤ := by
  let : Algebra k Γ(X, nvCover s i) := (sectionConstants f (nvCover s i)).toAlgebra
  let : Algebra k Γ(X, nvOpen L t) := (sectionConstants f (nvOpen L t)).toAlgebra
  set r : Γ(X, nvOpen L t) := div t le_rfl (resT (nvOpen L t) (s i)) with hr
  set u : Fin (n + 1) → Γ(X, nvOpen L t) := fun j => div t le_rfl (resT (nvOpen L t) (s j))
    with hu
  set W := X.basicOpen r with hWdef
  have hWV : W ≤ nvOpen L t := X.basicOpen_le r
  have hWeq : nvCover s i ⊓ nvOpen L t = W := by
    refine Stacks.SectionExtension.nonvanishingOpen_inf_eq_basicOpen t (s i) le_rfl r ?_
    exact (div_smul _ _ _).symm
  have hWU : W ≤ nvCover s i := hWeq ▸ inf_le_left
  let ιB : Γ(X, nvCover s i) →+* Γ(X, W) := (X.presheaf.map (homOfLE hWU).op).hom
  let ιR : Γ(X, nvOpen L t) →+* Γ(X, W) := (X.presheaf.map (homOfLE hWV).op).hom
  have hk : ∀ c : k, ιB (algebraMap k _ c) = ιR (algebraMap k _ c) := by
    intro c
    dsimp only [ιB, ιR]
    exact (map_sectionConstants f hWU c).trans (map_sectionConstants f hWV c).symm
  have hdivW : ∀ σ : Γ(L, ⊤),
      ιR (div t le_rfl (resT (nvOpen L t) σ)) • resT W t = resT W σ := by
    intro σ
    have h := congrArg (resM hWV) (div_smul t le_rfl (resT (nvOpen L t) σ))
    rwa [resM_smul, resM_resT, resM_resT] at h
  have hratW : ∀ j, ιB (ratio s i j) • resT W (s i) = resT W (s j) :=
    fun j => resO_ratio_smul s hWU j
  have hxr : ∀ j, ιB (ratio s i j) * ιR r = ιR (u j) := by
    intro j
    refine eq_of_smul_eq_smul t hWV ?_
    rw [mul_smul, hdivW, hratW, hdivW]
  obtain ⟨c₀, hc₀⟩ := hspan
  set w : Γ(X, nvCover s i) := ∑ j, c₀ j • ratio s i j with hwdef
  have hw : w ∈ Algebra.adjoin k (Set.range (ratio s i)) :=
    Subalgebra.sum_mem _ fun j _ =>
      Subalgebra.smul_mem _ (Algebra.subset_adjoin (Set.mem_range_self j)) _
  have hsmulT : ∀ (c : k) (W' : X.Opens), resO (le_top : W' ≤ ⊤)
      (((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom c) = sectionConstants f W' c :=
    fun _ _ => rfl
  have hresT : ∀ (W' : X.Opens) (c : Fin (n + 1) → k),
      resT W' (∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) • s j) =
        ∑ j, sectionConstants f W' (c j) • resT W' (s j) := by
    intro W' c
    rw [resT, resM, map_sum]
    simp only [← resM.eq_def, resM_smul, hsmulT]
  have hpr : ιB w * ιR r = 1 := by
    refine eq_of_smul_eq_smul t hWV ?_
    rw [mul_smul, hdivW, one_smul]
    conv_rhs => rw [hc₀, hresT]
    rw [hwdef, map_sum, Finset.sum_smul]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Algebra.smul_def, map_mul, mul_smul, hratW]
    congr 1
    exact map_sectionConstants f hWU _
  have hloc : ∀ z : Γ(X, W), ∃ (ρ : Γ(X, nvOpen L t)) (m : ℕ),
      z = ιR ρ * ιB w ^ m := by
    intro z
    have := hV.isLocalization_basicOpen r
    obtain ⟨⟨ρ, ⟨_, m, rfl⟩⟩, hz⟩ := IsLocalization.mk'_surjective (Submonoid.powers r) z
    refine ⟨ρ, m, ?_⟩
    rw [← hz, IsLocalization.mk'_eq_iff_eq_mul]
    change ιR ρ = ιR ρ * ιB w ^ m * ιR (r ^ m)
    rw [map_pow, mul_assoc, ← mul_pow, hpr, one_pow, mul_one]
  have hconst : ∀ (β : Γ(X, nvCover s i)) (ρ : Γ(X, nvOpen L t)), ιB β = ιR ρ →
      β ∈ Set.range (algebraMap k Γ(X, nvCover s i)) := by
    intro β ρ h
    have hinj : Function.Injective (X.presheaf.map (homOfLE hWeq.ge).op).hom := by
      intro a b hab
      have := congrArg (X.presheaf.map (homOfLE hWeq.le).op).hom hab
      rwa [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, ← Functor.map_comp,
        show (homOfLE hWeq.ge).op ≫ (homOfLE hWeq.le).op = 𝟙 _ from rfl,
        CategoryTheory.Functor.map_id,
        CommRingCat.id_apply, CommRingCat.id_apply] at this
    have hcomp : ∀ {A B C : X.Opens} (hAB : A ≤ B) (hBC : B ≤ C) (y : Γ(X, C)),
        (X.presheaf.map (homOfLE hAB).op).hom ((X.presheaf.map (homOfLE hBC).op).hom y) =
          (X.presheaf.map (homOfLE (hAB.trans hBC)).op).hom y := by
      intro A B C hAB hBC y
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]; rfl
    have h1 := hcomp hWeq.ge (inf_le_left : nvCover s i ⊓ nvOpen L t ≤ _) β
    have h2 := hcomp hWeq.ge (inf_le_right : nvCover s i ⊓ nvOpen L t ≤ _) ρ
    have hres := hinj (h1.trans (h.trans h2.symm))
    let g : Γ(X, nvCover s i ⊔ nvOpen L t) :=
      (X.sheaf.objSupIsoProdEqLocus (nvCover s i) (nvOpen L t)).inv ⟨(β, ρ), hres⟩
    have hg : X.presheaf.map (homOfLE le_sup_left).op g = β :=
      X.sheaf.objSupIsoProdEqLocus_inv_fst (nvCover s i) (nvOpen L t) ⟨(β, ρ), hres⟩
    obtain ⟨κ, hκ⟩ := (ConcreteCategory.bijective_of_isIso
      ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)).2 (X.presheaf.map (homOfLE hcov.ge).op g)
    refine ⟨κ, ?_⟩
    change (X.presheaf.map (homOfLE le_top).op).hom
      (((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom κ) = β
    rw [hκ, ← hg, hcomp]
  have hWne : Nonempty W := by
    obtain ⟨x, hx⟩ := hne
    exact ⟨⟨x, hWeq ▸ hx⟩⟩
  have hιRinj : Function.Injective ιR := map_injective_of_isIntegral X (homOfLE hWV)
  have hind' : LinearIndependent k (ratio s i) := by
    refine Fintype.linearIndependent_iff.mpr fun c hc => ?_
    set σ := ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) • s j with hσ
    have hU : resT (nvCover s i) σ = 0 := by
      rw [hσ, hresT]
      have : ∀ j, sectionConstants f (nvCover s i) (c j) • resT (nvCover s i) (s j) =
          (c j • ratio s i j) • resT (nvCover s i) (s i) := by
        intro j
        rw [Algebra.smul_def, mul_smul, ratio_smul]
        rfl
      simp only [this, ← Finset.sum_smul, hc, zero_smul]
    have hpzero : ∑ j, c j • u j = 0 := by
      apply hιRinj
      rw [map_zero, map_sum]
      have : ∑ j, ιB (algebraMap k _ (c j)) * ιB (ratio s i j) = 0 := by
        rw [← map_zero ιB, ← hc, map_sum]
        simp only [Algebra.smul_def, map_mul]
      simp only [Algebra.smul_def, map_mul, ← hk, ← hxr, ← mul_assoc, ← Finset.sum_mul, this,
        zero_mul]
    have hP : resT (nvOpen L t) σ = 0 := by
      rw [hσ, hresT]
      have : ∀ j, sectionConstants f (nvOpen L t) (c j) • resT (nvOpen L t) (s j) =
          (c j • u j) • resT (nvOpen L t) t := by
        intro j
        rw [Algebra.smul_def, mul_smul, hu, div_smul]
        rfl
      simp only [this, ← Finset.sum_smul, hpzero, zero_smul]
    have hσ0 : σ = 0 := by
      refine TopCat.Sheaf.eq_of_locally_eq₂ (F := ⟨L.presheaf, L.isSheaf⟩)
        (homOfLE (le_top : nvCover s i ≤ ⊤)) (homOfLE (le_top : nvOpen L t ≤ ⊤))
        hcov.ge σ 0 ?_ ?_
      · exact hU.trans (map_zero _).symm
      · exact hP.trans (map_zero _).symm
    exact congrFun (hind c hσ0)
  exact Algebra.adjoin_eq_top_of_leadingTerm ιB ιR hk (ratio s i) u r i w hw (ratio_self s i)
    hxr hpr hloc hconst hind' (by simpa using hdim)

end AlgebraicGeometry

end
