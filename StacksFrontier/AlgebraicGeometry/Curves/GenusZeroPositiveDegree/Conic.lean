module

public import StacksFrontier.AlgebraicGeometry.Curves.GenusZeroPositiveDegree.BasePointFree
public import StacksFrontier.AlgebraicGeometry.Curves.GenusZeroPositiveDegree.Basic
public import StacksFrontier.AlgebraicGeometry.Curves.GenusZeroPositiveDegree.ChartGeneration
public import StacksFrontier.AlgebraicGeometry.Curves.GenusZeroPositiveDegree.PlaneConic
public import StacksFrontier.AlgebraicGeometry.Curves.GenusZeroPositiveDegree.ZeroSchemeChart
public import StacksFrontier.AlgebraicGeometry.Curves.GenusCurve.GenusZeroVanishing
public import StacksFrontier.AlgebraicGeometry.Curves.ProjectiveLineCriterion.BasePointFree

/-!
# A genus-zero curve with an invertible module of degree two is a plane conic

Let `X` be a proper curve over a field `k` with `H⁰(X, 𝒪_X) = k` and genus `0`, and let `ℒ` be an
invertible `𝒪_X`-module of degree `2`. Then `ℒ` has three independent global sections, and the
morphism to `𝐏²_k` they define is a closed immersion onto a plane curve of degree `2`. Applied to
`ℒ = ω_X^{⊗ -1}` on a Gorenstein curve this is [Stacks, Tag 0C6N].

## Main results

* `AlgebraicGeometry.nvOpen_smul_le`: the nonvanishing open of a multiple of a section lies in
  that of the section.
* `AlgebraicGeometry.exists_sections_of_invertibleCurveDegree_eq_two`: three independent
  sections, two of them without common zero, none of them nowhere vanishing.
* `AlgebraicGeometry.adjoin_ratio_eq_top_of_invertibleCurveDegree_eq_two`: the chart rings are
  generated by the ratios of these sections.
* `AlgebraicGeometry.exists_planeCurveData_deg_two_of_invertibleCurveDegree_eq_two`: `X` is
  isomorphic over `k` to a plane curve of degree `2`.

## References

* [Stacks Project, Tag 0C6N](https://stacks.math.columbia.edu/tag/0C6N)
* [Stacks Project, Tag 0C6T](https://stacks.math.columbia.edu/tag/0C6T)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.ProjectiveFromSections Stacks.ModuleStalk

universe u

namespace AlgebraicGeometry

/-- **The nonvanishing open of a multiple of a section lies in that of the section.** -/
alias nvOpen_smul_le := AlgebraicGeometry.ProjectiveLineCriterion.nvOpen_smul_le


variable {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))

/-- **Three sections of a degree-two module on a genus-zero curve.** On a proper integral scheme
of dimension at most one over `k` with `H⁰(X, 𝒪_X) = k` and genus `0`, an invertible module of
degree `2` has three linearly independent global sections `s₀, s₁, s₂` such that `s₀` and `s₁`
have no common zero and no `sᵢ` is nowhere vanishing.

`H⁰(X, ℒ)` is three-dimensional ([Stacks, Tag 0C6T] part (1)); `s₀` is any nonzero section and
`s₁` a section not vanishing on its zero scheme, which exists because `H¹(X, 𝒪_X) = 0`. A
multiple of `s₀` vanishes wherever `s₀` does, and `s₀` vanishes somewhere because the degree is
positive, so `s₀, s₁` are independent; `s₂` completes them to a basis. -/
theorem exists_sections_of_invertibleCurveDegree_eq_two [IsProper f] [IsIntegral X]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)] (hdim : topologicalKrullDim X ≤ 1)
    (hgenus : genus f = 0) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
    (hdeg : invertibleCurveDegree k f hdim L = 2) :
    ∃ s : Fin 3 → Γ(L, ⊤), nvCover s 0 ⊔ nvCover s 1 = ⊤ ∧ (∀ i, nvCover s i ≠ ⊤) ∧
      ∀ c : Fin 3 → k,
        ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) • s j = 0 → c = 0 := by
  have hpos : 0 < invertibleCurveDegree k f hdim L := by rw [hdeg]; norm_num
  let M := (restrictScalarsOverBase k f).obj
    ((SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).obj L)
  have hfin : Module.finrank k M = 3 := by
    have := finrank_globalSections_eq_invertibleCurveDegree_add_one k f hdim L hgenus hpos
    rw [hdeg] at this
    exact_mod_cast this
  let ι := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom
  have hsmul : ∀ (c : k) (σ : M), (show Γ(L, ⊤) from c • σ) = ι c • (show Γ(L, ⊤) from σ) :=
    fun c σ => smul_globalSections_eq k f L c σ
  obtain ⟨s0, hs0⟩ := exists_eval_top_ne_zero_of_invertibleCurveDegree_pos k f hdim L hgenus hpos
  set s : Γ(L, ⊤) := s0.eval (op ⊤) with hsdef
  have hH1 := isZero_cohomologyOverField_unit_one_of_genus_eq_zero k f hgenus
  obtain ⟨t, hst⟩ := exists_sup_nvOpen_eq_top f hdim hH1 L s hs0
  have hvan : ∀ σ : Γ(L, ⊤), nvOpen L σ ≠ ⊤ :=
    nvOpen_ne_top_of_invertibleCurveDegree_pos f hdim L hpos
  have hind2 : LinearIndependent k ![(show M from s), (show M from t)] := by
    refine (LinearIndependent.pair_iff' (show (show M from s) ≠ 0 from hs0)).mpr fun a ha => ?_
    have ht : t = ι a • s :=
      (congrArg (fun σ : M => (show Γ(L, ⊤) from σ)) ha).symm.trans (hsmul a s)
    apply hvan s
    rw [← hst, ht, sup_eq_left.mpr (nvOpen_smul_le L (ι a) s)]
  have hlt : Module.finrank k (Submodule.span k (Set.range
      ![(show M from s), (show M from t)])) < Module.finrank k M := by
    rw [finrank_span_eq_card hind2, hfin]
    simp
  obtain ⟨s2, hs2⟩ : ∃ s2 : M, s2 ∉ Submodule.span k (Set.range
      ![(show M from s), (show M from t)]) := by
    by_contra! h
    have htop : Submodule.span k (Set.range ![(show M from s), (show M from t)]) = ⊤ :=
      eq_top_iff.mpr fun x _ => h x
    rw [htop, finrank_top] at hlt
    exact lt_irrefl _ hlt
  have hind3 : LinearIndependent k (Fin.snoc ![(show M from s), (show M from t)] s2 :
      Fin 3 → M) := linearIndependent_finSnoc.mpr ⟨hind2, hs2⟩
  refine ⟨![s, t, (show Γ(L, ⊤) from s2)], hst, fun i => hvan _, fun c hc => ?_⟩
  refine Fintype.linearIndependent_iff.mp hind3 c ?_ |> funext
  have hsnoc : (Fin.snoc ![(show M from s), (show M from t)] s2 : Fin 3 → M) =
      ![(show M from s), (show M from t), s2] := by
    funext j; fin_cases j <;> rfl
  rw [hsnoc]
  let e : M →+ Γ(L, ⊤) := { toFun := fun x => x, map_zero' := rfl, map_add' := fun _ _ => rfl }
  have key : e (∑ j, c j • ![(show M from s), (show M from t), s2] j) =
      ∑ j, ι (c j) • ![s, t, (show Γ(L, ⊤) from s2)] j := by
    rw [map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    refine (hsmul (c j) _).trans ?_
    fin_cases j <;> rfl
  exact key.trans hc

/-- **The chart rings of three sections of a degree-two module are generated by the ratios.** Let
`s₀, s₁, s₂` be linearly independent global sections of an invertible module of degree `2` on a
proper integral scheme of dimension at most one over `k` with `H⁰(X, 𝒪_X) = k`, none of them
nowhere vanishing, with `X_{sᵢ} ∪ X_{sₚ} = X` and `X_{sₚ}` affine. Then `Γ(X_{sᵢ}, 𝒪)` is
generated over `k` by the ratios `sⱼ / sᵢ`.

This is `AlgebraicGeometry.adjoin_ratio_eq_top`; the dimension of the zero scheme of `sᵢ` read on
`X_{sₚ}` is the degree, `2`, by `AlgebraicGeometry.finrank_quotient_span_ratio_le`. -/
theorem adjoin_ratio_eq_top_of_invertibleCurveDegree_eq_two [IsProper f] [IsIntegral X]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)] (hdim : topologicalKrullDim X ≤ 1)
    (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
    (hdeg : invertibleCurveDegree k f hdim L = 2) (s : Fin 3 → Γ(L, ⊤)) (i p : Fin 3)
    (hcov : nvCover s i ⊔ nvCover s p = ⊤) (hvan : ∀ j, nvCover s j ≠ ⊤)
    (hV : IsAffineOpen (nvCover s p))
    (hind : ∀ c : Fin 3 → k,
      ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) • s j = 0 → c = 0) :
    letI := (sectionConstants f (nvCover s i)).toAlgebra
    Algebra.adjoin k (Set.range (ratio s i)) = ⊤ := by
  have hsi : s i ≠ 0 := by
    intro h0
    have := hind (Pi.single i 1) (by
      rw [Finset.sum_eq_single i (fun j _ hj => by simp [Pi.single_eq_of_ne hj])
        (by simp)]
      simp [h0])
    simpa using congrFun this i
  have hne : ((nvCover s i : Set X) ∩ nvCover s p).Nonempty := by
    have hUne : (nvCover s i : Set X).Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
      intro hU
      apply hvan p
      rw [← hcov, show nvCover s i = ⊥ from SetLike.coe_injective hU, bot_sup_eq]
    have hVne : (nvCover s p : Set X).Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
      intro hV'
      apply hvan i
      rw [← hcov, show nvCover s p = ⊥ from SetLike.coe_injective hV', sup_bot_eq]
    exact nonempty_preirreducible_inter (nvCover s i).2 (nvCover s p).2 hUne hVne
  have hfin := finiteDimensional_quotient_span_ratio f hdim L (s i) (s p) hsi hcov hV
  have hle := finrank_quotient_span_ratio_le f hdim L (s i) (s p) hsi hcov hV
  rw [hdeg] at hle
  refine adjoin_ratio_eq_top f L s i (s p) hcov hV hne hind ⟨Pi.single p 1, ?_⟩ (hfin := hfin)
    (by exact_mod_cast hle)
  rw [Finset.sum_eq_single p (fun j _ hj => by simp [Pi.single_eq_of_ne hj]) (by simp)]
  simp

/-- **A genus-zero curve with an invertible module of degree two is a plane conic.** Let `X` be
a proper integral scheme of dimension one over a field `k` with `H⁰(X, 𝒪_X) = k` and genus `0`,
and let `ℒ` be an invertible `𝒪_X`-module of degree `2`. Then `X` is isomorphic over `k` to a
plane curve of degree `2`.

Three independent sections `s₀, s₁, s₂` of `ℒ`, the first two without common zero
(`AlgebraicGeometry.exists_sections_of_invertibleCurveDegree_eq_two`), define a morphism to
`𝐏²_k` which is finite, with affine charts `X_{s₀}`, `X_{s₁}` whose rings are generated by the
ratios (`AlgebraicGeometry.adjoin_ratio_eq_top_of_invertibleCurveDegree_eq_two`); so it is a
closed immersion onto a plane curve of degree `d`, with `d ∈ {1, 2}` because the genus is
`(d - 1)(d - 2)/2 = 0`, and `d ≠ 1` because the `sⱼ` are independent
(`AlgebraicGeometry.PlaneConic.exists_planeCurveData_deg_two`). -/
theorem exists_planeCurveData_deg_two_of_invertibleCurveDegree_eq_two [IsProper f]
    [IsIntegral X] [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)]
    (hdim : topologicalKrullDim X = 1) (hgenus : genus f = 0) (L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L] (hdeg : invertibleCurveDegree k f hdim.le L = 2) :
    ∃ C : ProjectiveSpectrum.Proj.PlaneCurveData k, C.deg = 2 ∧
      ∃ e : X ≅ C.Z, e.hom ≫ C.toSpec = f := by
  obtain ⟨s, hcov, hvan, hind⟩ :=
    exists_sections_of_invertibleCurveDegree_eq_two f hdim.le hgenus L hdeg
  have hV : ∀ i, IsAffineOpen (nvCover s i) :=
    PlaneConic.isAffineOpen_nvCover f s hdim.le hcov hvan
  refine PlaneConic.exists_planeCurveData_deg_two f s hdim hcov hvan hgenus hind ?_
  intro i hi a
  let := (sectionConstants f (nvCover s i)).toAlgebra
  have hadj : Algebra.adjoin k (Set.range (ratio s i)) = ⊤ := by
    rcases hi with rfl | rfl
    · exact adjoin_ratio_eq_top_of_invertibleCurveDegree_eq_two f hdim.le L hdeg s 0 1 hcov hvan
        (hV 1) hind
    · exact adjoin_ratio_eq_top_of_invertibleCurveDegree_eq_two f hdim.le L hdeg s 1 0
        (by rw [sup_comm]; exact hcov) hvan (hV 0) hind
  have hmem : a ∈ (Algebra.adjoin k (Set.range (ratio s i))).toSubring := by
    rw [hadj]; exact trivial
  rwa [Algebra.adjoin_eq_ring_closure] at hmem

end AlgebraicGeometry
