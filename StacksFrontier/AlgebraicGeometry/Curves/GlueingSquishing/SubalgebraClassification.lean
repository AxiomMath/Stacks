module

public import Mathlib.Algebra.DualNumber
public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.LinearAlgebra.Eigenspace.Triangularizable
public import Mathlib.RingTheory.Adjoin.Polynomial.Basic
public import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic
public import Mathlib.SetTheory.Cardinal.Finite
public import StacksCore.Tactic.StacksAttribute

/-!
# Algebras with no intermediate subalgebras over an algebraically closed field

An algebra over an algebraically closed field which has exactly two subalgebras is either the
product of two copies of the field or the algebra of dual numbers. This is the algebraic input
to the glueing and squishing constructions for curves.

## Main results

* `Algebra.algEquiv_prod_or_dualNumber_of_natCard_subalgebra_eq_two` classifies algebras
  having exactly two subalgebras over an algebraically closed field.
* `Algebra.algEquiv_prod_or_dualNumber_of_no_intermediateSubalgebra` gives the corresponding
  classification when the two subalgebras are specified as the bottom and top subalgebras.

## Implementation notes

The phrase "exactly two subalgebras" is expressed either as the cardinality of the type of
subalgebras or by requiring the bottom and top subalgebras to be distinct and exhaustive. The
equalities in the source are interpreted as equivalences of algebras over the base field.

## References

* [Stacks Project, Tag 0C1I](https://stacks.math.columbia.edu/tag/0C1I)
-/

@[expose] public section

universe u v

namespace Algebra

/-- Over a field, an algebra whose only subalgebras are the bottom and top ones is integral. -/
private lemma isIntegral_of_no_intermediateSubalgebra
    (k : Type u) (A : Type v) [Field k] [CommRing A] [Algebra k A]
    (h : ∀ B : Subalgebra k A, B = ⊥ ∨ B = ⊤) (x : A) : IsIntegral k x := by
  rcases h (Algebra.adjoin k {x ^ 2}) with hs | hs
  · have hx2 : x ^ 2 ∈ (⊥ : Subalgebra k A) := hs ▸ Algebra.self_mem_adjoin_singleton k (x ^ 2)
    obtain ⟨c, hc⟩ := Algebra.mem_bot.mp hx2
    exact IsIntegral.of_pow (by omega) (hc ▸ isIntegral_algebraMap)
  · by_contra hx
    have ht : Transcendental k x := fun ha ↦ hx (isAlgebraic_iff_isIntegral.mp ha)
    have hmem : x ∈ Algebra.adjoin k {x ^ 2} := by simp [hs]
    obtain ⟨p, hp⟩ := Algebra.adjoin_mem_exists_aeval k (x ^ 2) hmem
    have heval : Polynomial.aeval x (p.comp (Polynomial.X ^ 2)) =
        Polynomial.aeval x (Polynomial.X : Polynomial k) := by
      rw [Polynomial.aeval_comp]
      simpa using hp
    have hd := congrArg (fun q : Polynomial k ↦ q.derivative.eval 0)
      (transcendental_iff_injective.mp ht heval)
    simp [Polynomial.derivative_comp] at hd

/-- If `y` generates `A` and `y * y = d • y`, then every element of `A` is of the form
`r + s • y` with `r s : k`. -/
private theorem exists_algebraMap_add_smul_eq_of_adjoin_eq_top {k : Type u} {A : Type v}
    [CommRing k] [CommRing A] [Algebra k A] {y : A} {d : k} (hygen : Algebra.adjoin k {y} = ⊤)
    (hyy : y * y = d • y) (a : A) : ∃ r s : k, algebraMap k A r + s • y = a := by
  have hypow (n : ℕ) : y ^ (n + 1) = d ^ n • y := by
    induction n with
    | zero => simp
    | succ m ih =>
      simpa only [pow_succ, smul_mul_assoc, mul_smul, hyy] using congrArg (· * y) ih
  obtain ⟨q, rfl⟩ := Algebra.adjoin_mem_exists_aeval k y
    (show a ∈ Algebra.adjoin k {y} by simp [hygen])
  induction q using Polynomial.induction_on' with
  | add q r hq hr =>
    obtain ⟨a, b, hab⟩ := hq
    obtain ⟨c, e, hce⟩ := hr
    refine ⟨a + c, b + e, ?_⟩
    simpa only [map_add, add_smul, Polynomial.aeval_add, ← hab, ← hce] using
      (show algebraMap k A a + algebraMap k A c + (b • y + e • y) =
        (algebraMap k A a + b • y) + (algebraMap k A c + e • y) by abel)
  | monomial n a =>
    cases n with
    | zero => exact ⟨a, 0, by simp⟩
    | succ n =>
      refine ⟨0, a * d ^ n, ?_⟩
      simp only [Polynomial.aeval_monomial, map_zero, zero_add]
      rw [hypow]
      simp [Algebra.smul_def, mul_assoc]

/-- If `y` lies outside the base field `k`, then `1` and `y` are linearly independent over `k`. -/
private theorem eq_zero_and_eq_zero_of_algebraMap_add_smul_eq_zero {k : Type u} {A : Type v}
    [Field k] [CommRing A] [Nontrivial A] [Algebra k A] {y : A} (hy : y ∉ (⊥ : Subalgebra k A))
    {r s : k} (hrs : algebraMap k A r + s • y = 0) : r = 0 ∧ s = 0 := by
  by_cases hs : s = 0
  · subst s
    simp only [zero_smul, add_zero] at hrs
    exact ⟨(FaithfulSMul.algebraMap_injective k A) (hrs.trans (map_zero _).symm), rfl⟩
  · refine (hy (Algebra.mem_bot.mpr ⟨-s⁻¹ * r, ?_⟩)).elim
    calc
      algebraMap k A (-s⁻¹ * r) = s⁻¹ • (-algebraMap k A r) := by simp [Algebra.smul_def]
      _ = s⁻¹ • (s • y) := by rw [eq_neg_of_add_eq_zero_right hrs]
      _ = y := by simp [← mul_smul, hs]

/-- An algebra generated by an element `y` outside the base field with `y * y = 0` is the algebra
of dual numbers. -/
private theorem nonempty_algEquiv_dualNumber_of_mul_self_eq_zero {k : Type u} {A : Type v} [Field k]
    [CommRing A] [Nontrivial A] [Algebra k A] {y : A} (hy : y ∉ (⊥ : Subalgebra k A))
    (hygen : Algebra.adjoin k {y} = ⊤) (hsq : y * y = 0) : Nonempty (A ≃ₐ[k] DualNumber k) := by
  let f : DualNumber k →ₐ[k] A := DualNumber.lift
    ⟨(Algebra.ofId k A, y), hsq, fun _ ↦ mul_comm _ _⟩
  refine ⟨(AlgEquiv.ofBijective f ⟨?_, ?_⟩).symm⟩
  · intro a b hab
    have heq : algebraMap k A (a.fst - b.fst) + (a.snd - b.snd) • y = 0 := by
      have := congrArg (· - f b) hab
      simp [f, DualNumber.lift_apply_apply, sub_eq_add_neg, Algebra.smul_def] at this ⊢
      linear_combination this
    obtain ⟨h1, h2⟩ := eq_zero_and_eq_zero_of_algebraMap_add_smul_eq_zero hy heq
    exact TrivSqZeroExt.ext (sub_eq_zero.mp h1) (sub_eq_zero.mp h2)
  · intro a
    obtain ⟨r, s, hrs⟩ :=
      exists_algebraMap_add_smul_eq_of_adjoin_eq_top hygen (by rw [zero_smul, hsq]) a
    refine ⟨⟨r, s⟩, ?_⟩
    change algebraMap k A r + algebraMap k A s * y = a
    simpa [Algebra.smul_def] using hrs

/-- An algebra generated by an element `y` outside the base field with `y * y = d • y` for some
`d ≠ 0` is the product algebra `k × k`. -/
private theorem nonempty_algEquiv_prod_of_mul_self_eq_smul {k : Type u} {A : Type v} [Field k]
    [CommRing A] [Nontrivial A] [Algebra k A] {y : A} {d : k} (hy : y ∉ (⊥ : Subalgebra k A))
    (hygen : Algebra.adjoin k {y} = ⊤) (hyy : y * y = d • y) (hd : d ≠ 0) :
    Nonempty (A ≃ₐ[k] k × k) := by
  let e : A := d⁻¹ • y
  have he : e * e = e := by
    calc
      e * e = (d⁻¹ * d⁻¹) • (y * y) := by simp [e, mul_smul]
      _ = e := by
        rw [hyy]
        simp [e, ← mul_smul, hd]
  let f : k × k →ₐ[k] A :=
    { toFun := fun a ↦ a.1 • (1 - e) + a.2 • e
      map_one' := by simp
      map_zero' := by simp
      map_add' := by
        intro a b
        simp only [Prod.fst_add, Prod.snd_add, add_smul]
        abel
      map_mul' := by
        intro a b
        dsimp
        simp only [Algebra.smul_def, map_mul]
        linear_combination (algebraMap k A b.1 * algebraMap k A a.2 +
          algebraMap k A a.1 * algebraMap k A b.2 - algebraMap k A a.1 * algebraMap k A b.1 -
          algebraMap k A a.2 * algebraMap k A b.2) * he
      commutes' := by
        intro r
        dsimp
        simp [Algebra.smul_def]
        ring }
  refine ⟨(AlgEquiv.ofBijective f ⟨?_, ?_⟩).symm⟩
  · intro a b hab
    have heq : algebraMap k A (a.1 - b.1) +
        ((a.2 - a.1) * d⁻¹ - (b.2 - b.1) * d⁻¹) • y = 0 := by
      have := congrArg (· - f b) hab
      simp [f, e, Algebra.smul_def] at this ⊢
      linear_combination this
    obtain ⟨h1, h2⟩ := eq_zero_and_eq_zero_of_algebraMap_add_smul_eq_zero hy heq
    refine Prod.ext (sub_eq_zero.mp h1) (sub_eq_zero.mp ?_)
    field_simp at h2
    simpa [sub_eq_zero.mp h1] using h2
  · intro a
    obtain ⟨r, s, hrs⟩ := exists_algebraMap_add_smul_eq_of_adjoin_eq_top hygen hyy a
    refine ⟨(r, r + s * d), ?_⟩
    change r • (1 - e) + (r + s * d) • e = a
    calc
      _ = r • (1 : A) + s • y := by
        rw [add_smul, show (s * d) • e = s • y by simp [e, ← mul_smul, hd]]
        module
      _ = a := by simpa [Algebra.smul_def] using hrs

/-- If `y * z = 0`, then `y * q(z) = q(0) • y` for every polynomial `q`. -/
theorem mul_aeval_eq_coeff_zero_smul {k : Type u} {A : Type v} [CommRing k] [CommRing A]
    [Algebra k A] {y z : A} (hyz : y * z = 0) (q : Polynomial k) :
    y * Polynomial.aeval z q = q.coeff 0 • y := by
  induction q using Polynomial.induction_on' with
  | add q r hq hr => simp [mul_add, hq, hr, add_smul]
  | monomial n a =>
    cases n with
    | zero => simp [Algebra.smul_def, mul_comm]
    | succ n =>
      rw [Polynomial.coeff_monomial, ite_eq_right (by omega), zero_smul, Polynomial.aeval_monomial,
        pow_succ]
      linear_combination (z ^ n * algebraMap k A a) * hyz

/-- If every subalgebra is `⊥` or `⊤`, an element outside `⊥` generates the whole algebra. -/
private lemma adjoin_singleton_eq_top_of_notMem_bot {k : Type u} {A : Type v} [CommRing k]
    [CommRing A] [Algebra k A] (h : ∀ B : Subalgebra k A, B = ⊥ ∨ B = ⊤) {x : A}
    (hx : x ∉ (⊥ : Subalgebra k A)) : Algebra.adjoin k {x} = ⊤ :=
  (h _).resolve_left fun e ↦ hx (e ▸ Algebra.self_mem_adjoin_singleton k x)

/-- If the bottom and top subalgebras differ, the algebra is nontrivial. -/
private lemma nontrivial_of_bot_ne_top {k : Type u} {A : Type v} [CommRing k] [CommRing A]
    [Algebra k A] (h_ne : (⊥ : Subalgebra k A) ≠ ⊤) : Nontrivial A :=
  not_subsingleton_iff_nontrivial.mp fun _ ↦ h_ne (Subsingleton.elim _ _)

/-- Over an algebraically closed field, an algebra whose only subalgebras are the bottom and top
ones contains an element `y` outside the base field with `y * y = d • y` for some scalar `d`. -/
private theorem exists_mul_self_eq_smul_of_no_intermediateSubalgebra
    (k : Type u) (A : Type v) [Field k] [IsAlgClosed k] [CommRing A] [Algebra k A]
    (h_ne : (⊥ : Subalgebra k A) ≠ ⊤)
    (h : ∀ B : Subalgebra k A, B = ⊥ ∨ B = ⊤) :
    ∃ y : A, y ∉ (⊥ : Subalgebra k A) ∧ ∃ d : k, y * y = d • y := by
  have := nontrivial_of_bot_ne_top h_ne
  obtain ⟨x, hx⟩ : ∃ x : A, x ∉ (⊥ : Subalgebra k A) := by
    simpa [SetLike.ext_iff] using h_ne
  have hxgen := adjoin_singleton_eq_top_of_notMem_bot h hx
  have : Module.Finite k (Algebra.adjoin k {x}) :=
    Algebra.finite_adjoin_simple_of_isIntegral (isIntegral_of_no_intermediateSubalgebra k A h x)
  have : Module.Finite k A := Module.Finite.of_surjective
    (Algebra.adjoin k {x}).val.toLinearMap fun a ↦
      ⟨⟨a, by simp [hxgen]⟩, rfl⟩
  obtain ⟨c, hc⟩ := Module.End.exists_eigenvalue (LinearMap.mulLeft k x)
  obtain ⟨z, hz⟩ := hc.exists_hasEigenvector
  have hz' : x * z = c • z := by simpa using hz.apply_eq_smul
  let y : A := x - algebraMap k A c
  have hyz : y * z = 0 := by
    dsimp only [y]
    rw [sub_mul, hz']
    simp [Algebra.smul_def]
  have hybot : y ∉ (⊥ : Subalgebra k A) := by
    rintro hy
    obtain ⟨d, hd⟩ := Algebra.mem_bot.mp hy
    refine hx (Algebra.mem_bot.mpr ⟨d + c, ?_⟩)
    dsimp only [y] at hd
    rw [map_add, hd]
    abel
  have hzbot : z ∉ (⊥ : Subalgebra k A) := by
    rintro hzbot
    obtain ⟨d, hd⟩ := Algebra.mem_bot.mp hzbot
    have hd0 : d ≠ 0 := by
      rintro rfl
      exact hz.2 (by simpa using hd.symm)
    refine hybot (Algebra.mem_bot.mpr ⟨0, ?_⟩)
    rw [map_zero]
    rw [← hd, mul_comm, ← Algebra.smul_def] at hyz
    exact ((smul_eq_zero.mp hyz).resolve_left hd0).symm
  obtain ⟨p, hp⟩ := Algebra.adjoin_mem_exists_aeval k z
    (by simp [adjoin_singleton_eq_top_of_notMem_bot h hzbot])
  exact ⟨y, hybot, p.coeff 0, by simpa [hp] using mul_aeval_eq_coeff_zero_smul hyz p⟩

/-- The classification of an algebra over an algebraically closed field whose only subalgebras
are the bottom and top ones: it is either `k × k` or the dual numbers over `k`. -/
private theorem classification_of_no_intermediateSubalgebra
    (k : Type u) (A : Type v) [Field k] [IsAlgClosed k] [CommRing A] [Algebra k A]
    (h_ne : (⊥ : Subalgebra k A) ≠ ⊤)
    (h : ∀ B : Subalgebra k A, B = ⊥ ∨ B = ⊤) :
    Nonempty (A ≃ₐ[k] k × k) ∨ Nonempty (A ≃ₐ[k] DualNumber k) := by
  have := nontrivial_of_bot_ne_top h_ne
  obtain ⟨y, hy, d, hyy⟩ := exists_mul_self_eq_smul_of_no_intermediateSubalgebra k A h_ne h
  have hygen := adjoin_singleton_eq_top_of_notMem_bot h hy
  by_cases hd : d = 0
  · exact Or.inr <| nonempty_algEquiv_dualNumber_of_mul_self_eq_zero hy hygen
      (by rw [hyy, hd, zero_smul])
  · exact Or.inl <| nonempty_algEquiv_prod_of_mul_self_eq_smul hy hygen hyy hd

/-- **Stacks Project, Tag 0C1I.** An algebra over an algebraically closed field with exactly
two subalgebras is isomorphic, as an algebra, either to the product algebra or to the dual
numbers. -/
@[stacks 0C1I]
theorem algEquiv_prod_or_dualNumber_of_natCard_subalgebra_eq_two
    (k : Type u) (A : Type v) [Field k] [IsAlgClosed k] [CommRing A] [Algebra k A]
    (h : Nat.card (Subalgebra k A) = 2) :
    Nonempty (A ≃ₐ[k] k × k) ∨ Nonempty (A ≃ₐ[k] DualNumber k) := by
  have h_ne : (⊥ : Subalgebra k A) ≠ ⊤ := by
    intro hbt
    have : Subsingleton (Subalgebra k A) := subsingleton_of_bot_eq_top hbt
    simp at h
  obtain ⟨B, -, hB_unique⟩ := (Nat.card_eq_two_iff' (⊥ : Subalgebra k A)).mp h
  exact classification_of_no_intermediateSubalgebra k A h_ne fun C ↦
    or_iff_not_imp_left.mpr fun hC ↦ (hB_unique C hC).trans (hB_unique ⊤ h_ne.symm).symm

/-- **Stacks Project, Tag 0C1I.** An algebra over an algebraically closed field with no proper
intermediate subalgebra is either the product algebra or the algebra of dual numbers. -/
@[stacks 0C1I]
theorem algEquiv_prod_or_dualNumber_of_no_intermediateSubalgebra
    (k : Type u) (A : Type v) [Field k] [IsAlgClosed k] [CommRing A] [Algebra k A]
    (h_ne : (⊥ : Subalgebra k A) ≠ ⊤)
    (h : ∀ B : Subalgebra k A, B = ⊥ ∨ B = ⊤) :
    Nonempty (A ≃ₐ[k] k × k) ∨ Nonempty (A ≃ₐ[k] DualNumber k) :=
  classification_of_no_intermediateSubalgebra k A h_ne h

end Algebra
