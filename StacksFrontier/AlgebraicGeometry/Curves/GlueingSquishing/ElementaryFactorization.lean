@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry

universe u v

namespace Stacks.GlueSquishFactor

/-! ### The local algebra of a minimal step -/

/-- **The image of `A` in a quotient of `B` killing `m_A` lies in the base field.** This is where
the hypothesis that the residue field of the local ring `A` is `k` enters: it is what makes the
fibre of `B` over the closed point of `A` an algebra *over `k`* whose bottom subalgebra is the
image of `A`. -/
private theorem exists_algebraMap_quotient_eq (k : Type u) (A B : Type v) [Field k] [CommRing A]
    [Algebra k A] [IsLocalRing A] [CommRing B] [Algebra k B] [Algebra A B] [IsScalarTower k A B]
    (hres : ∀ a : A, ∃ c : k, a - algebraMap k A c ∈ IsLocalRing.maximalIdeal A) (a : A) :
    ∃ c : k, Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B))
      (algebraMap A B a) =
      algebraMap k (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) c := by
  obtain ⟨c, hc⟩ := hres a
  refine ⟨c, ?_⟩
  rw [← Ideal.Quotient.mk_algebraMap, ← sub_eq_zero, ← map_sub,
    Ideal.Quotient.eq_zero_iff_mem, IsScalarTower.algebraMap_apply k A B, ← map_sub]
  exact Ideal.mem_map_of_mem _ hc

/-- **Subalgebras of the fibre come from `A`-subalgebras of `B`.** A `k`-subalgebra `D` of a
quotient `B ⧸ I` whose bottom subalgebra contains the image of `A` pulls back to an
`A`-subalgebra of `B`; the pullback is `⊥` or `⊤` exactly when `D` is. This is the source's
"if `C` has more than `2` `k`-subalgebras, then we obtain a subalgebra between `A` and `B` by
taking the inverse image in `B`", read in the contrapositive. -/
private theorem quotient_subalgebra_eq_bot_or_eq_top (k : Type u) (A B : Type v) [Field k]
    [CommRing A] [Algebra k A] [CommRing B] [Algebra k B] [Algebra A B] [IsScalarTower k A B]
    (I : Ideal B)
    (key : ∀ a : A, ∃ c : k, Ideal.Quotient.mk I (algebraMap A B a) = algebraMap k (B ⧸ I) c)
    (hmin : ∀ E : Subalgebra A B, E = ⊥ ∨ E = ⊤) (D : Subalgebra k (B ⧸ I)) :
    D = ⊥ ∨ D = ⊤ := by
  let E : Subalgebra A B :=
    { (D.comap (Ideal.Quotient.mkₐ k I)).toSubsemiring with
      algebraMap_mem' := fun a => by
        obtain ⟨c, hc⟩ := key a
        change Ideal.Quotient.mk I (algebraMap A B a) ∈ D
        rw [hc]
        exact D.algebraMap_mem c }
  have hE : ∀ b : B, b ∈ E ↔ Ideal.Quotient.mk I b ∈ D := fun _ => Iff.rfl
  rcases hmin E with hEb | hEt
  · refine Or.inl (le_antisymm (fun d hd => ?_) bot_le)
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective d
    obtain ⟨a, ha⟩ := (Algebra.mem_bot (R := A) (A := B)).mp (hEb ▸ (hE b).mpr hd)
    obtain ⟨c, hc⟩ := key a
    exact Algebra.mem_bot.mpr ⟨c, by rw [← hc, ← ha]⟩
  · refine Or.inr (le_antisymm le_top (fun d _ => ?_))
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective d
    exact (hE b).mp (hEt ▸ Algebra.mem_top)

/-- **Nakayama's lemma in the form the minimal step needs.** If `B` is module-finite over the
local ring `A` and every element of `B` is congruent to an element of `A` modulo `m_A B` — the
source's `B = A + m_A B` — then `B` is already generated by `A`. This is the source's "if
`A + m_A B = B`, then `A = B` by Nakayama, then `f` is an isomorphism and there is nothing to
prove". -/
theorem bot_eq_top_of_forall_sub_mem (A B : Type v) [CommRing A] [IsLocalRing A]
    [CommRing B] [Algebra A B] [Module.Finite A B]
    (h : ∀ b : B, ∃ a : A, b - algebraMap A B a ∈
      (IsLocalRing.maximalIdeal A).map (algebraMap A B)) :
    (⊥ : Subalgebra A B) = ⊤ := by
  have hle : (⊤ : Submodule A B) ≤
      (⊥ : Subalgebra A B).toSubmodule ⊔ IsLocalRing.maximalIdeal A • (⊤ : Submodule A B) := by
    intro b _
    obtain ⟨a, ha⟩ := h b
    rw [show b = algebraMap A B a + (b - algebraMap A B a) by ring]
    refine Submodule.add_mem_sup ((Algebra.mem_bot (R := A) (A := B)).mpr ⟨a, rfl⟩) ?_
    rwa [Ideal.smul_top_eq_map]
  have hsub := Submodule.le_of_le_smul_of_le_jacobson_bot (I := IsLocalRing.maximalIdeal A)
    (N := (⊥ : Subalgebra A B).toSubmodule) (N' := (⊤ : Submodule A B)) Module.Finite.fg_top
    (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge hle
  exact eq_top_iff.mpr fun _ _ => hsub Submodule.mem_top

/-- **A germ which is a scalar modulo `m_A B` differs from a scalar of `A` by an element of
`m_A B`.** -/
private theorem sub_algebraMap_mem_map_of_mk_eq (k : Type u) (A B : Type v) [Field k] [CommRing A]
    [Algebra k A] [IsLocalRing A] [CommRing B] [Algebra k B] [Algebra A B] [IsScalarTower k A B]
    {b : B} {c : k}
    (hb : Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) b =
      algebraMap k (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) c) :
    b - algebraMap A B (algebraMap k A c) ∈
      (IsLocalRing.maximalIdeal A).map (algebraMap A B) := by
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hb, ← IsScalarTower.algebraMap_apply k A B,
    Ideal.Quotient.mk_algebraMap, sub_self]

/-- **The fibre of a minimal step is a nontrivial `k`-algebra.** If `B` is module-finite over the
local ring `A` and the fibre `B ⧸ m_A B` is generated by the base field, then `B` is already
generated by `A`; contrapositively, if `A` does not generate `B`, the fibre is a nontrivial
`k`-algebra. -/
private theorem bot_ne_top_fibre (k : Type u) (A B : Type v) [Field k] [CommRing A] [Algebra k A]
    [IsLocalRing A] [CommRing B] [Algebra k B] [Algebra A B] [IsScalarTower k A B]
    [Module.Finite A B] (hne : (⊥ : Subalgebra A B) ≠ ⊤) :
    (⊥ : Subalgebra k (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B))) ≠ ⊤ := by
  intro h
  refine hne (bot_eq_top_of_forall_sub_mem A B fun b => ?_)
  obtain ⟨c, hc⟩ := (Algebra.mem_bot (R := k)
    (A := B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B))).mp
    (h ▸ (Algebra.mem_top (R := k) (x := Ideal.Quotient.mk _ b)))
  exact ⟨algebraMap k A c, sub_algebraMap_mem_map_of_mk_eq k A B hc.symm⟩

/-- **The local algebra of a minimal step of [Stacks, Tag 0C1L].** Let `k` be an algebraically
closed field, let `A` be a local `k`-algebra whose residue field is `k` (hypothesis `hres`: every
element of `A` is a scalar modulo the maximal ideal), and let `B` be a module-finite `A`-algebra
which is not generated by `A` (hypothesis `hne`) and admits no `A`-subalgebra strictly between
`A` and `B` (hypothesis `hmin`). Then the fibre `B ⧸ m_A B` is, as a `k`-algebra, either the
product `k × k` or the dual numbers `k[ε]`.

In the source this is the whole of the case `n = 1`: with `A = 𝒪_{X, x}` and
`B = (f_*𝒪_{X'})_x`, the absence of a proper intermediate subalgebra forces `B = A + m_A B`
(Nakayama) and then forces the fibre `C = B / m_A B` to have exactly two `k`-subalgebras, so
[Stacks, Tag 0C1I] applies. The two outcomes are what make the step a glueing of two points
respectively a squishing of a tangent vector.

This is the mathematical heart of [Stacks, Tag 0C1L], but not the whole lemma: see the
implementation notes of this file for the geometric statements that remain. -/
@[stacks 0C1L "the local algebra of a minimal step"]
theorem algEquiv_prod_or_dualNumber_of_minimal (k : Type u) (A B : Type v) [Field k]
    [IsAlgClosed k] [CommRing A] [Algebra k A] [IsLocalRing A] [CommRing B] [Algebra k B]
    [Algebra A B] [IsScalarTower k A B] [Module.Finite A B]
    (hres : ∀ a : A, ∃ c : k, a - algebraMap k A c ∈ IsLocalRing.maximalIdeal A)
    (hne : (⊥ : Subalgebra A B) ≠ ⊤) (hmin : ∀ E : Subalgebra A B, E = ⊥ ∨ E = ⊤) :
    Nonempty ((B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) ≃ₐ[k] k × k) ∨
      Nonempty ((B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) ≃ₐ[k] DualNumber k) :=
  Algebra.algEquiv_prod_or_dualNumber_of_no_intermediateSubalgebra k _
    (bot_ne_top_fibre k A B hne)
    (quotient_subalgebra_eq_bot_or_eq_top k A B _
      (exists_algebraMap_quotient_eq k A B hres) hmin)

/-! ### The fibre sequence of a minimal step -/

/-- **The `A`-subalgebra `A + m_A B` of `B`.** This is the source's intermediate subalgebra
`A ⊂ A + m_A B ⊂ B`. It is a subalgebra because `m_A B` is an ideal of `B`, so it absorbs the
cross terms of a product `(a₁ + m₁)(a₂ + m₂)`. -/
def addMapMaximalIdeal (A B : Type v) [CommRing A] [IsLocalRing A] [CommRing B]
    [Algebra A B] : Subalgebra A B where
  carrier := {b | ∃ a : A, b - algebraMap A B a ∈
    (IsLocalRing.maximalIdeal A).map (algebraMap A B)}
  mul_mem' := by
    rintro x y ⟨a, ha⟩ ⟨c, hc⟩
    refine ⟨a * c, ?_⟩
    rw [map_mul, show x * y - algebraMap A B a * algebraMap A B c =
      (x - algebraMap A B a) * y + algebraMap A B a * (y - algebraMap A B c) by ring]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ hc)
  one_mem' := ⟨1, by simp⟩
  add_mem' := by
    rintro x y ⟨a, ha⟩ ⟨c, hc⟩
    refine ⟨a + c, ?_⟩
    rw [map_add, add_sub_add_comm]
    exact Ideal.add_mem _ ha hc
  zero_mem' := ⟨0, by simp⟩
  algebraMap_mem' := fun a => ⟨a, by simp⟩

/-- **`m_A B ⊆ A` for a minimal extension.** If `B` is module-finite over the local ring `A`, is
not generated by `A`, and admits no `A`-subalgebra strictly between `A` and `B`, then the ideal
`m_A B` is contained in the image of `A`.

This is the trichotomy the source performs on the chain `A ⊂ A + m_A B ⊂ B`: by minimality
`A + m_A B` is `A` or `B`, and `A + m_A B = B` gives `A = B` by Nakayama
(`Stacks.GlueSquishFactor.bot_eq_top_of_forall_sub_mem`), which is excluded. So `A + m_A B = A`.

**This corrects the source.** [Stacks, Tag 0C1L] concludes the trichotomy with "we may assume
`B = A + m_A B`", which cannot be what is meant: the case `A + m_A B = B` was just disposed of by
Nakayama, and `B = A + m_A B` would force the fibre `C = B ⧸ m_A B` to be the image of `A`,
i.e. `k`, which has a single `k`-subalgebra, so [Stacks, Tag 0C1I] could never be applied to it.
The surviving case is `A = A + m_A B`, which is this lemma, and which leaves `C` with exactly the
two `k`-subalgebras `k` and `C` that the classification needs. Nothing in
`Stacks.GlueSquishFactor.algEquiv_prod_or_dualNumber_of_minimal` is affected: it never uses the
sentence, only `hne` and `hmin`. -/
theorem exists_algebraMap_eq_of_mem_map_maximalIdeal (A B : Type v) [CommRing A] [IsLocalRing A]
    [CommRing B] [Algebra A B] [Module.Finite A B] (hne : (⊥ : Subalgebra A B) ≠ ⊤)
    (hmin : ∀ E : Subalgebra A B, E = ⊥ ∨ E = ⊤) {b : B}
    (hb : b ∈ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) :
    ∃ a : A, algebraMap A B a = b := by
  rcases hmin (addMapMaximalIdeal A B) with hE | hE
  · have hbE : b ∈ addMapMaximalIdeal A B := ⟨0, by simpa using hb⟩
    rw [hE] at hbE
    exact (Algebra.mem_bot (R := A) (A := B)).mp hbE
  · exact absurd (bot_eq_top_of_forall_sub_mem A B fun b' =>
      (hE ▸ Algebra.mem_top : b' ∈ addMapMaximalIdeal A B)) hne

/-- **A germ which is a scalar modulo `m_A B` comes from `A`.** Under the hypotheses of the
minimal step, an element of `B` whose class in the fibre `B ⧸ m_A B` lies in the image of `k` is
already in the image of `A`: subtract the scalar and apply
`Stacks.GlueSquishFactor.exists_algebraMap_eq_of_mem_map_maximalIdeal`. -/
private theorem exists_algebraMap_eq_of_mk_eq_algebraMap (k : Type u) (A B : Type v) [Field k]
    [CommRing A] [Algebra k A] [IsLocalRing A] [CommRing B] [Algebra k B] [Algebra A B]
    [IsScalarTower k A B] [Module.Finite A B] (hne : (⊥ : Subalgebra A B) ≠ ⊤)
    (hmin : ∀ E : Subalgebra A B, E = ⊥ ∨ E = ⊤) {b : B} {c : k}
    (hb : Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) b =
      algebraMap k (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) c) :
    ∃ a : A, algebraMap A B a = b := by
  obtain ⟨a, ha⟩ := exists_algebraMap_eq_of_mem_map_maximalIdeal A B hne hmin
    (sub_algebraMap_mem_map_of_mk_eq k A B hb)
  exact ⟨a + algebraMap k A c, by rw [map_add, ha, sub_add_cancel]⟩

/-- **The glueing case, first clause: `A` is killed by the difference of the two characters.**
If the fibre of a minimal step is `k × k`, the two projections agree on the image of `A`: a germ
in `A` is a scalar modulo `m_A`, and a scalar lands on the diagonal of `k × k`.

With `A = 𝒪_{X, x}` and `B = (f_*𝒪_{X'})_x` this is the composite `𝒪_X ⟶ f_*𝒪_{X'} ⟶ x_*k` of
`AlgebraicGeometry.IsGlueingTwoPoints` being zero, read at the stalk: the two projections are the
evaluations at the two points `a` and `b` that
`Stacks.GlueSquishFactor.exists_two_points_of_fibre_algEquiv_prod` produces from the same
equivalence. -/
theorem prod_fst_eq_snd_of_algebraMap (k : Type u) (A B : Type v) [Field k] [CommRing A]
    [Algebra k A] [IsLocalRing A] [CommRing B] [Algebra k B] [Algebra A B] [IsScalarTower k A B]
    (hres : ∀ a : A, ∃ c : k, a - algebraMap k A c ∈ IsLocalRing.maximalIdeal A)
    (e : (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) ≃ₐ[k] k × k) (a : A) :
    (e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B))
        (algebraMap A B a))).1 =
      (e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B))
        (algebraMap A B a))).2 := by
  obtain ⟨c, hc⟩ := exists_algebraMap_quotient_eq k A B hres a
  rw [hc, e.commutes]
  rfl

/-- **The glueing case, second clause: exactness in the middle.** If the fibre of a minimal step
is `k × k`, an element of `B` on which the two projections agree is in the image of `A`.

Together with `Stacks.GlueSquishFactor.prod_fst_eq_snd_of_algebraMap` this says that the image of
`A` in `B` is *exactly* the equalizer of the two characters — the stalk form of exactness in the
middle of `0 → 𝒪_X → f_*𝒪_{X'} → x_*k → 0`. This is the clause of
`AlgebraicGeometry.IsGlueingTwoPoints` which needs `m_A B ⊆ A`, i.e.
`Stacks.GlueSquishFactor.exists_algebraMap_eq_of_mem_map_maximalIdeal`, and hence the correction
to the source recorded there: the class of such an element is a scalar, so it differs from an
element of `A` by something in `m_A B`, and that difference is in `A` only because `m_A B` is. -/
theorem exists_algebraMap_eq_of_prod_fst_eq_snd (k : Type u) (A B : Type v) [Field k]
    [CommRing A] [Algebra k A] [IsLocalRing A] [CommRing B] [Algebra k B] [Algebra A B]
    [IsScalarTower k A B] [Module.Finite A B] (hne : (⊥ : Subalgebra A B) ≠ ⊤)
    (hmin : ∀ E : Subalgebra A B, E = ⊥ ∨ E = ⊤)
    (e : (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) ≃ₐ[k] k × k) {b : B}
    (hb : (e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) b)).1 =
      (e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) b)).2) :
    ∃ a : A, algebraMap A B a = b := by
  have hprod : e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) b) =
      algebraMap k (k × k)
        (e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) b)).1 :=
    Prod.ext rfl hb.symm
  exact exists_algebraMap_eq_of_mk_eq_algebraMap k A B hne hmin
    (e.injective (hprod.trans (e.commutes _).symm))

/-- **The glueing case, third clause: surjectivity onto the residue field.** If the fibre of a
minimal step is `k × k`, the difference of the two projections takes every value in `k`: pick a
preimage of `(c, 0)`.

This is the surjectivity clause of `AlgebraicGeometry.IsGlueingTwoPoints` — "for every `c : k`
there is a section whose values at the two points differ by `c`" — read at the stalk. -/
theorem exists_prod_fst_sub_snd_eq (k : Type u) (A B : Type v) [Field k] [CommRing A]
    [Algebra k A] [IsLocalRing A] [CommRing B] [Algebra k B] [Algebra A B] [IsScalarTower k A B]
    (e : (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) ≃ₐ[k] k × k) (c : k) :
    ∃ b : B,
      (e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) b)).1 -
        (e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) b)).2 = c := by
  obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (I :=
    (IsLocalRing.maximalIdeal A).map (algebraMap A B)) (e.symm (c, 0))
  exact ⟨b, by rw [hb, e.apply_symm_apply, sub_zero]⟩

/-- **The squishing case, first clause: `A` is killed by the tangent character.** If the fibre of
a minimal step is the dual numbers `k[ε]`, the `ε`-coefficient vanishes on the image of `A`: a
germ in `A` is a scalar modulo `m_A`, and a scalar has no `ε`-part.

This is the composite `𝒪_X ⟶ f_*𝒪_{X'} ⟶ x_*k` of
`AlgebraicGeometry.IsSquishingTangentVector` being zero, read at the stalk. -/
theorem dualNumber_snd_eq_zero_of_algebraMap (k : Type u) (A B : Type v) [Field k] [CommRing A]
    [Algebra k A] [IsLocalRing A] [CommRing B] [Algebra k B] [Algebra A B] [IsScalarTower k A B]
    (hres : ∀ a : A, ∃ c : k, a - algebraMap k A c ∈ IsLocalRing.maximalIdeal A)
    (e : (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) ≃ₐ[k] DualNumber k) (a : A) :
    (e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B))
      (algebraMap A B a))).snd = 0 := by
  obtain ⟨c, hc⟩ := exists_algebraMap_quotient_eq k A B hres a
  rw [hc, e.commutes, TrivSqZeroExt.algebraMap_eq_inl, TrivSqZeroExt.snd_inl]

/-- **The squishing case, second clause: exactness in the middle.** If the fibre of a minimal
step is `k[ε]`, an element of `B` whose `ε`-coefficient vanishes is in the image of `A`.

Together with `Stacks.GlueSquishFactor.dualNumber_snd_eq_zero_of_algebraMap` this says that the
image of `A` in `B` is *exactly* the kernel of the tangent character, which is the stalk form of
exactness in the middle for a squishing. As in the glueing case it is where `m_A B ⊆ A`, i.e.
`Stacks.GlueSquishFactor.exists_algebraMap_eq_of_mem_map_maximalIdeal`, is used. -/
theorem exists_algebraMap_eq_of_dualNumber_snd_eq_zero (k : Type u) (A B : Type v) [Field k]
    [CommRing A] [Algebra k A] [IsLocalRing A] [CommRing B] [Algebra k B] [Algebra A B]
    [IsScalarTower k A B] [Module.Finite A B] (hne : (⊥ : Subalgebra A B) ≠ ⊤)
    (hmin : ∀ E : Subalgebra A B, E = ⊥ ∨ E = ⊤)
    (e : (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) ≃ₐ[k] DualNumber k) {b : B}
    (hb : (e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) b)).snd = 0) :
    ∃ a : A, algebraMap A B a = b := by
  have hdual : e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) b) =
      algebraMap k (DualNumber k)
        (e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) b)).fst := by
    rw [TrivSqZeroExt.algebraMap_eq_inl]
    exact TrivSqZeroExt.ext (TrivSqZeroExt.fst_inl _ _).symm
      (hb.trans (TrivSqZeroExt.snd_inl _ _).symm)
  exact exists_algebraMap_eq_of_mk_eq_algebraMap k A B hne hmin
    (e.injective (hdual.trans (e.commutes _).symm))

/-- **The squishing case, third clause: surjectivity onto the residue field.** If the fibre of a
minimal step is `k[ε]`, the `ε`-coefficient takes every value in `k`: pick a preimage of `c ε`.

This is the surjectivity clause of `AlgebraicGeometry.IsSquishingTangentVector`, read at the
stalk. -/
theorem exists_dualNumber_snd_eq (k : Type u) (A B : Type v) [Field k] [CommRing A] [Algebra k A]
    [IsLocalRing A] [CommRing B] [Algebra k B] [Algebra A B] [IsScalarTower k A B]
    (e : (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) ≃ₐ[k] DualNumber k) (c : k) :
    ∃ b : B, (e (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map (algebraMap A B)) b)).snd
      = c := by
  obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (I :=
    (IsLocalRing.maximalIdeal A).map (algebraMap A B)) (e.symm (TrivSqZeroExt.inr c))
  exact ⟨b, by rw [hb, e.apply_symm_apply, TrivSqZeroExt.snd_inr]⟩

/-! ### The elementary modifications and chains of them -/

/-- **One step of the factorization of [Stacks, Tag 0C1L]**: a morphism of algebraic
`k`-schemes which either glues two rational points ([Stacks, Tag 0C1J]) or squishes a tangent
vector ([Stacks, Tag 0C1K]). -/
@[stacks 0C1L "the elementary modifications"]
def IsElementaryStep {k : Type u} [Field k] [IsAlgClosed k] {Y' Y : Over (Spec (.of k))}
    (f : Y' ⟶ Y) : Prop :=
  (∃ a b : Spec (.of k) ⟶ Y'.left, IsGlueingTwoPoints f.left a b) ∨
    ∃ θ : Spec (.of (DualNumber k)) ⟶ Y'.left, IsSquishingTangentVector f.left θ

/-- An elementary modification is finite; finiteness is a conjunct of both
`AlgebraicGeometry.IsGlueingTwoPoints` and `AlgebraicGeometry.IsSquishingTangentVector`. -/
theorem IsElementaryStep.isFinite {k : Type u} [Field k] [IsAlgClosed k]
    {Y' Y : Over (Spec (.of k))} {f : Y' ⟶ Y} (h : IsElementaryStep f) : IsFinite f.left := by
  rcases h with ⟨a, b, hg⟩ | ⟨θ, hs⟩
  · obtain ⟨-, hfin, -⟩ := hg.2.2.2.2.2.2.2.2
    exact hfin
  · obtain ⟨-, -, -, hfin, -⟩ := hs.2.2.2.2.2.2.2
    exact hfin

/-- **The conclusion of [Stacks, Tag 0C1L], as a predicate on one morphism.** `f` is a composite
of finitely many elementary modifications and isomorphisms, which is the content of the source's
chain `X' = X_n ⟶ ⋯ ⟶ X_0 = X` together with its endpoint identifications. The recursor is the
induction on the length that the source's proof performs. -/
@[stacks 0C1L "the factorization, as an inductive predicate"]
inductive IsElementaryChain (k : Type u) [Field k] [IsAlgClosed k] :
    {Y' Y : Over (Spec (.of k))} → (Y' ⟶ Y) → Prop
  /-- An isomorphism is the empty chain: this is the source's "`f` is an isomorphism and there is
  nothing to prove", and it absorbs the identifications `X' = X_n` and `X_0 = X`. -/
  | of_isIso {Y' Y : Over (Spec (.of k))} (f : Y' ⟶ Y) (hf : IsIso f) : IsElementaryChain k f
  /-- A single elementary modification is a chain of length one. -/
  | of_step {Y' Y : Over (Spec (.of k))} (f : Y' ⟶ Y) (hf : IsElementaryStep f) :
      IsElementaryChain k f
  /-- Chains compose, which is how the chain of the source is assembled from its steps. -/
  | comp {Z Y' Y : Over (Spec (.of k))} {g : Z ⟶ Y'} {f : Y' ⟶ Y} :
      IsElementaryChain k g → IsElementaryChain k f → IsElementaryChain k (g ≫ f)

/-- A chain of elementary modifications is finite: each step is, isomorphisms are, and finiteness
is stable under composition. -/
theorem IsElementaryChain.isFinite {k : Type u} [Field k] [IsAlgClosed k]
    {X' X : Over (Spec (.of k))} {f : X' ⟶ X} (h : IsElementaryChain k f) :
    IsFinite f.left := by
  induction h with
  | of_isIso g hg =>
    have := hg
    exact inferInstanceAs (IsFinite ((Over.forget (Spec (.of k))).map g))
  | of_step g hg => exact hg.isFinite
  | comp _ _ ih1 ih2 =>
    have := ih1
    have := ih2
    rw [Over.comp_left]
    infer_instance

/-- **The hypotheses of [Stacks, Tag 0C1L] on a morphism, apart from
`𝒪_X ⊂ f_*𝒪_{X'}`.** Both schemes are algebraic over `k`, the morphism is finite, and it
restricts to an isomorphism over the complement of a finite set of points.

Finite type and quasi-compactness of the structure morphisms are conjuncts here rather than
instance arguments, matching `AlgebraicGeometry.IsGlueingTwoPoints` and
`AlgebraicGeometry.IsSquishingTangentVector`. The inclusion `𝒪_X ⊂ f_*𝒪_{X'}` is split off into
`Stacks.GlueSquishFactor.IsAlmostIso` because it is the one clause of the hypotheses of the
source whose propagation to the upper half of an intermediate factorization is not a
restriction of the data defining that factorization; see
`Stacks.GlueSquishFactor.mono_hom_pushforwardAlgebra_toIntermediate`. -/
def IsAlmostIsoCore {k : Type u} [Field k] [IsAlgClosed k] {Y' Y : Over (Spec (.of k))}
    (f : Y' ⟶ Y) : Prop :=
  LocallyOfFiniteType (Y'.left ↘ Spec (.of k)) ∧ QuasiCompact (Y'.left ↘ Spec (.of k)) ∧
    LocallyOfFiniteType (Y.left ↘ Spec (.of k)) ∧ QuasiCompact (Y.left ↘ Spec (.of k)) ∧
    IsFinite f.left ∧
    ∃ U : Y.left.Opens, Set.Finite ((U : Set Y.left)ᶜ) ∧ IsIso (f.left ∣_ U)

/-- **The hypotheses of [Stacks, Tag 0C1L] on a morphism.** Both schemes are algebraic over `k`,
the morphism is finite, it restricts to an isomorphism over the complement of a finite set of
points, and the structure-sheaf map `𝒪_X ⟶ f_*𝒪_{X'}` is injective — the source's
`𝒪_X ⊂ f_*𝒪_{X'}`, expressed as a monomorphism in the category of sheaves of commutative rings
on `X`, which is the category in which the relative-spectrum dictionary of
`StacksFrontier.AlgebraicGeometry.Curves.GlueingSquishing.IntermediateFactorization` reads the
inclusions `𝒪_X ⊂ 𝒜 ⊂ f_*𝒪_{X'}`. -/
def IsAlmostIso {k : Type u} [Field k] [IsAlgClosed k] {Y' Y : Over (Spec (.of k))}
    (f : Y' ⟶ Y) : Prop :=
  IsAlmostIsoCore f ∧ Mono (Stacks.AffineAlgebraEquivalence.pushforwardAlgebra f.left).hom

/-! ### The induction on the length -/

/-- **The induction on the length of [Stacks, Tag 0C1L], abstracted from the geometry.** Let
`Adm` be any notion of admissible morphism of `k`-schemes and `μ` any `ℕ`-valued measure on
morphisms. If every admissible morphism is either already a chain of elementary modifications or
splits as `p ≫ q` with `p` and `q` admissible of strictly smaller measure, then every admissible
morphism is a chain.

This is the skeleton of the source's "we can argue by induction on the sum of these lengths":
`Adm` is "finite, injective on structure sheaves, and an isomorphism away from a finite set",
`μ` is the length of `f_*𝒪_{X'}/𝒪_X`, and the splitting is the passage to a proper intermediate
factorization. The induction is on the measure, so the hypothesis only has to produce *some*
splitting, not a maximal chain. The tag [Stacks, Tag 0C1L] itself sits on
`Stacks.GlueSquishFactor.IsAlmostIso.isElementaryChain`. -/
theorem isElementaryChain_of_split (k : Type u) [Field k] [IsAlgClosed k]
    (Adm : ∀ {Y' Y : Over (Spec (.of k))}, (Y' ⟶ Y) → Prop)
    (μ : ∀ {Y' Y : Over (Spec (.of k))}, (Y' ⟶ Y) → ℕ)
    (hsplit : ∀ {Y' Y : Over (Spec (.of k))} (g : Y' ⟶ Y), Adm g →
      IsElementaryChain k g ∨ ∃ (Z : Over (Spec (.of k))) (p : Y' ⟶ Z) (q : Z ⟶ Y),
        p ≫ q = g ∧ Adm p ∧ Adm q ∧ μ p < μ g ∧ μ q < μ g)
    {X' X : Over (Spec (.of k))} (f : X' ⟶ X) (hf : Adm f) : IsElementaryChain k f := by
  suffices H : ∀ n : ℕ, ∀ {Y' Y : Over (Spec (.of k))} (g : Y' ⟶ Y), Adm g → μ g < n →
      IsElementaryChain k g from H (μ f + 1) f hf (Nat.lt_succ_self _)
  intro n
  induction n with
  | zero =>
    intro _ _ _ _ hlt
    omega
  | succ n ih =>
    intro Y' Y g hg hlt
    rcases hsplit g hg with hchain | ⟨Z, p, q, hpq, hp, hq, hμp, hμq⟩
    · exact hchain
    · exact hpq ▸ IsElementaryChain.comp (ih p hp (by omega)) (ih q hq (by omega))

/-- **[Stacks, Tag 0C1L], reduced to the splitting hypothesis.** Let `μ` assign a natural number
to each morphism over `Spec k`, and suppose every almost-isomorphism `g` either is an elementary
chain or factors as `g = p ≫ q` with `p` and `q` almost-isomorphisms satisfying `μ p < μ g` and
`μ q < μ g`. Then every almost-isomorphism `f : X' ⟶ X` over `Spec k` is an elementary chain, that
is, a composite of glueings of two points and squishings of tangent vectors.

This is a conditional form: the lemma itself, with `hsplit` discharged, is
`Stacks.GlueSquishFactor.IsAlmostIso.isElementaryChain`, which carries the tag. Of the
ingredients of `hsplit` the additivity of the measure is
`Stacks.GlueSquishFactor.sheafMultiplicity_cokernel_structureUnitHom_add`, its strict drop
`Stacks.GlueSquishFactor.sheafMultiplicity_cokernel_lt_of_mem_supp_right`, and the one-step
classification `Stacks.GlueSquishFactor.exists_glueing_or_squishing_data_of_minimal`. A proper
intermediate subalgebra is produced, from an arbitrary subalgebra of the stalk, by
`Stacks.GlueSquishFactor.exists_isFinite_subalg_ne_top_of_subalgebra_lt`, and the stalk
minimality that the classification asks for follows from the absence of one by
`Stacks.GlueSquishFactor.forall_eq_bot_or_eq_top_of_forall_isFinite_subalg`. -/
theorem isElementaryChain_of_isAlmostIso (k : Type u) [Field k] [IsAlgClosed k]
    (μ : ∀ {Y' Y : Over (Spec (.of k))}, (Y' ⟶ Y) → ℕ)
    (hsplit : ∀ {Y' Y : Over (Spec (.of k))} (g : Y' ⟶ Y), IsAlmostIso g →
      IsElementaryChain k g ∨ ∃ (Z : Over (Spec (.of k))) (p : Y' ⟶ Z) (q : Z ⟶ Y),
        p ≫ q = g ∧ IsAlmostIso p ∧ IsAlmostIso q ∧ μ p < μ g ∧ μ q < μ g)
    {X' X : Over (Spec (.of k))} (f : X' ⟶ X) (hf : IsAlmostIso f) : IsElementaryChain k f :=
  isElementaryChain_of_split k IsAlmostIso μ hsplit f hf

end Stacks.GlueSquishFactor

