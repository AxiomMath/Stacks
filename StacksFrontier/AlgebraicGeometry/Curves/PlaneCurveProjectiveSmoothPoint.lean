module

public import StacksFrontier.AlgebraicGeometry.Curves.PlaneCurveSmoothClosedPoint
public import StacksFrontier.AlgebraicGeometry.Morphisms.DimensionFormula.ResidueField
public import StacksFrontier.AlgebraicGeometry.ProjectiveChart.HypersurfaceFinitePresentation
public import StacksFrontier.AlgebraicGeometry.ResidueFieldAffineChart.Basic
public import StacksFrontier.AlgebraicGeometry.SmoothAtRingCriterion.Basic
public import StacksFrontier.RingTheory.Smooth.SmoothAtTransport

/-!
# A smooth plane curve over an infinite field has a smooth closed point of small degree

Let `k` be an infinite field and let `Z ⊆ 𝐏²_k` be a closed subscheme whose homogeneous ideal is
generated by a nonzero homogeneous `F` of degree `d`.  If `Z → Spec(k)` is smooth at one point,
then `Z` has a *closed* point `z` in the smooth locus whose residue field `κ(z)` is a finite
separable extension of `k` of degree at most `d`.  That is [Stacks, Tag 0CCU].

## Main results

* `Stacks.Curves.exists_isClosed_smoothAt_isSeparable_finrank_le_totalDegree`: Tag 0CCU.

## Implementation notes

The argument is the source's, with the chart machinery of
`Stacks.ProjectiveChart.chartQuotientEquiv` replacing the source's "after renumbering the
coordinates we may assume `z'` lies in `D₊(T₀)`": the standard charts cover `Z`, so the given
smooth point lies in one of them, and that chart is used — no renumbering is needed because the
chart presentation is available for every coordinate.  On the chart,
`Γ(Z, Z ∩ D₊(Tⱼ)) ≅ₖ k[x₀, x₁] ⧸ (f)` with `f = F(Tⱼ = 1)` of total degree at most `d`, and the
whole of the source's argument is then
`Stacks.Curves.exists_isMaximal_isSmoothAt_isSeparable_finrank_le_totalDegree`.

Three transports carry the conclusion back:

* smoothness, by `Stacks.SmoothAtRingCriterion.condition1_iff_isSmoothAt_appLE` — an iff, so it
  serves in both directions — together with `Algebra.isSmoothAt_congr` for the chart
  identification and `Algebra.isSmoothAt_iff_of_bijective_algebraMap` for the passage between
  `k` and `Γ(Spec k, ⊤)`.  Its hypothesis
  `AlgebraicGeometry.LocallyOfFinitePresentation` is
  `Stacks.ProjectiveChart.locallyOfFinitePresentation_toSpec`;
* the residue field, by `AlgebraicGeometry.IsAffineOpen.residueFieldEquiv`, which identifies
  `κ(z)` with the residue field of the prime of the chart, composed with the three ring
  isomorphisms that take that residue field back to `k[x₀, x₁] ⧸ m`;
* closedness, by `AlgebraicGeometry.isClosed_singleton_of_module_finite_residueField`, which is
  where the finiteness of the residue extension is used a second time.

The nonvanishing hypotheses of the affine statement come from the geometry: `f ≠ 0` because
dehomogenization is injective on the homogeneous part of a fixed degree — read off the fraction
`F / Tⱼ^d`, which is what the chart identification sends `f` to — and `f` is not a unit because
the chart is nonempty, containing the given smooth point.

## References

* [Stacks Project, Tag 0CCU](https://stacks.math.columbia.edu/tag/0CCU)
* [Stacks Project, Tag 0BYB](https://stacks.math.columbia.edu/tag/0BYB)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory MvPolynomial

namespace Stacks.Curves

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **Dehomogenization is injective on homogeneous polynomials of a fixed degree.**  Over a
domain, the dehomogenization of a nonzero homogeneous `F` at a coordinate is nonzero: the chart
identification sends it to the fraction `F / Tⱼ^d`, which vanishes only if `Tⱼ^m F = 0`. -/
theorem dehomCoeff_ne_zero {R : Type u} [CommRing R] [IsDomain R] {n d : ℕ} (j : Fin (n + 1))
    (F : MvPolynomial (Fin (n + 1)) R)
    (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R (d • 1)) (hF0 : F ≠ 0) :
    Stacks.ProjectiveChart.dehomCoeff R j F ≠ 0 := by
  intro h
  have hmk := Stacks.ProjectiveChart.chartRingEquiv_dehomCoeff R j d F hF
  rw [h, map_zero] at hmk
  have hval := congrArg HomogeneousLocalization.val hmk
  rw [HomogeneousLocalization.val_zero, HomogeneousLocalization.Away.val_mk] at hval
  rw [show (0 : Localization.Away (MvPolynomial.X j :
      MvPolynomial (Fin (n + 1)) R)) = Localization.mk 0 1 from (Localization.mk_zero 1).symm,
    Localization.mk_eq_mk_iff, Localization.r_iff_exists] at hval
  obtain ⟨c, hc⟩ := hval
  have hcne : (c : MvPolynomial (Fin (n + 1)) R) ≠ 0 := by
    obtain ⟨t, ht⟩ := c.2
    rw [← ht]
    exact pow_ne_zero t (MvPolynomial.X_ne_zero j)
  have hcF : (c : MvPolynomial (Fin (n + 1)) R) * F = 0 := by simpa using hc.symm
  exact hF0 ((mul_eq_zero.mp hcF).resolve_left hcne)

variable {k : Type u} [Field k] {Z : Scheme.{u}}

/-- **[Stacks, Tag 0CCU].**  Let `k` be an infinite field and `Z ⊆ 𝐏²_k` a closed subscheme whose
homogeneous ideal is generated by a nonzero homogeneous `F` of degree `d`.  If the structure
morphism `Z ⟶ Spec k` is smooth at one point, then there is a **closed** point `z` of `Z` at
which it is smooth and whose residue field is a finite **separable** extension of `k` of degree
at most `d`. -/
@[stacks 0CCU]
theorem exists_isClosed_smoothAt_isSeparable_finrank_le_totalDegree [Infinite k]
    (i : Z ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin 3) k)) [IsClosedImmersion i]
    {d : ℕ} (F : MvPolynomial (Fin 3) k) (hF0 : F ≠ 0)
    (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin 3) k (d • 1))
    (hideal : AlgebraicGeometry.ProjectiveSpectrum.Proj.idealOfClosedSubscheme
      (MvPolynomial.homogeneousSubmodule (Fin 3) k) i = Ideal.span {F})
    (hsmooth : ∃ z' : Z, InfinitesimalLifting.SmoothAt
      (i ≫ Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff k 2) z') :
    ∃ z : Z, IsClosed ({z} : Set Z) ∧
      InfinitesimalLifting.SmoothAt
        (i ≫ Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff k 2) z ∧
      (letI : Algebra k (Z.residueField z) :=
          ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            (i ≫ Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff k 2).appTop ≫
            Z.Γevaluation z).hom.toAlgebra;
        Module.Finite k (Z.residueField z) ∧
          Algebra.IsSeparable k (Z.residueField z) ∧
          Module.finrank k (Z.residueField z) ≤ F.totalDegree) := by
  classical
  set fZ := i ≫ Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff k 2
  have : LocallyOfFinitePresentation fZ :=
    Stacks.ProjectiveChart.locallyOfFinitePresentation_toSpec i F hF hideal
  obtain ⟨z', hz'smooth⟩ := hsmooth
  -- the standard charts cover `Z`, so `z'` lies in one of them
  obtain ⟨j, hz'j⟩ : ∃ j : Fin 3, z' ∈ Stacks.ProjectiveChart.subschemeChart i j :=
    TopologicalSpace.Opens.mem_iSup.mp
      (by rw [Stacks.ProjectiveChart.iSup_subschemeChart_eq_top i]; trivial)
  set U := Stacks.ProjectiveChart.subschemeChart i j
  have hU : IsAffineOpen U := Stacks.ProjectiveChart.isAffineOpen_subschemeChart i j
  set g := Stacks.ProjectiveChart.dehomCoeff k j F
  -- the `k`-algebra structure on the chart ring, through the structure morphism
  let algA : Algebra k Γ(Z, U) :=
    ((fZ.appLE ⊤ U le_top).hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom).toAlgebra
  let algΓ : Algebra k Γ(Spec (CommRingCat.of k), ⊤) :=
    (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom.toAlgebra
  let algΓA : Algebra Γ(Spec (CommRingCat.of k), ⊤) Γ(Z, U) :=
    (fZ.appLE ⊤ U le_top).hom.toAlgebra
  have towerA : IsScalarTower k Γ(Spec (CommRingCat.of k), ⊤) Γ(Z, U) :=
    IsScalarTower.of_algebraMap_eq' rfl
  have hΓbij : Function.Bijective (algebraMap k Γ(Spec (CommRingCat.of k), ⊤)) :=
    (Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv.bijective
  -- the chart identification, as a `k`-algebra isomorphism
  have hεalg : ∀ r : k,
      Stacks.ProjectiveChart.chartQuotientEquiv i j F hF hideal (algebraMap k _ r) =
        algebraMap k Γ(Z, U) r := by
    intro r
    rw [show algebraMap k (MvPolynomial (Fin 2) k ⧸ Ideal.span {g}) r =
        Ideal.Quotient.mk _ (MvPolynomial.C r) from rfl,
      Stacks.ProjectiveChart.chartQuotientEquiv_mk]
    exact Stacks.ProjectiveChart.chartPresentation_C i j r
  let εₐ : (MvPolynomial (Fin 2) k ⧸ Ideal.span {g}) ≃ₐ[k] Γ(Z, U) :=
    { Stacks.ProjectiveChart.chartQuotientEquiv i j F hF hideal with commutes' := hεalg }
  -- the two nonvanishing hypotheses of the affine statement
  have hg0 : g ≠ 0 := dehomCoeff_ne_zero j F hF hF0
  have : Nonempty U := ⟨⟨z', hz'j⟩⟩
  have hgu : ¬ IsUnit g := by
    intro hu
    have : Nontrivial (MvPolynomial (Fin 2) k ⧸ Ideal.span {g}) := εₐ.toEquiv.nontrivial
    exact not_subsingleton _
      (Ideal.Quotient.subsingleton_iff.mpr (Ideal.span_singleton_eq_top.mpr hu))
  -- smoothness on the chart, in both directions
  have hsm : ∀ (w : Z) (hw : w ∈ U)
      (Q : Ideal (MvPolynomial (Fin 2) k ⧸ Ideal.span {g})) [Q.IsPrime],
      (hU.primeIdealOf ⟨w, hw⟩).asIdeal =
          Ideal.map (εₐ : (MvPolynomial (Fin 2) k ⧸ Ideal.span {g}) →+* Γ(Z, U)) Q →
        (InfinitesimalLifting.SmoothAt fZ w ↔ Algebra.IsSmoothAt k Q) := by
    intro w hw Q _ hQ
    have : ((hU.primeIdealOf ⟨w, hw⟩).asIdeal).IsPrime := (hU.primeIdealOf ⟨w, hw⟩).isPrime
    rw [show InfinitesimalLifting.SmoothAt fZ w = Stacks.SmoothAtJacobian.Condition1 fZ w from rfl,
      Stacks.SmoothAtRingCriterion.condition1_iff_isSmoothAt_appLE fZ w ⟨U, hU⟩
        ⟨⊤, isAffineOpen_top _⟩ hw le_top,
      ← Algebra.isSmoothAt_iff_of_bijective_algebraMap k
        Γ(Spec (CommRingCat.of k), ⊤) Γ(Z, U) hΓbij]
    exact Algebra.isSmoothAt_congr εₐ.symm _ Q (hQ.trans (Ideal.comap_symm εₐ.toRingEquiv).symm)
  -- the affine statement, applied at the given smooth point
  have : ((hU.primeIdealOf ⟨z', hz'j⟩).asIdeal).IsPrime := (hU.primeIdealOf _).isPrime
  set Q₁ := Ideal.comap (εₐ : (MvPolynomial (Fin 2) k ⧸ Ideal.span {g}) →+* Γ(Z, U))
    ((hU.primeIdealOf ⟨z', hz'j⟩).asIdeal) with hQ₁def
  have hQ₁prime : Q₁.IsPrime := Ideal.IsPrime.comap _
  have hQ₁eq : (hU.primeIdealOf ⟨z', hz'j⟩).asIdeal = Ideal.map
      (εₐ : (MvPolynomial (Fin 2) k ⧸ Ideal.span {g}) →+* Γ(Z, U)) Q₁ :=
    (Ideal.map_comap_of_surjective _ εₐ.surjective _).symm
  obtain ⟨m, hm, hgm, ⟨i', hi'⟩, hfin, hsep, hrank⟩ :=
    exists_isMaximal_isSmoothAt_isSeparable_finrank_le_totalDegree hg0 hgu Q₁
      ((hsm z' hz'j Q₁ hQ₁eq).mp hz'smooth)
  -- the maximal ideal of the chart ring it produces
  set Qm := Ideal.map (Ideal.Quotient.mk (Ideal.span {g})) m with hQm
  have hle : Ideal.span {g} ≤ m := (Ideal.span_singleton_le_iff_mem m).mpr hgm
  have hcomapQm : Qm.comap (Ideal.Quotient.mk (Ideal.span {g})) = m := by
    rwa [hQm, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      show Ideal.comap (Ideal.Quotient.mk (Ideal.span {g})) ⊥ = Ideal.span {g} from
        Ideal.mk_ker, sup_eq_left]
  let ΦQm : ((MvPolynomial (Fin 2) k ⧸ Ideal.span {g}) ⧸ Qm) ≃+*
      (MvPolynomial (Fin 2) k ⧸ m) := DoubleQuot.quotQuotEquivQuotOfLE hle
  have hmfield : IsField (MvPolynomial (Fin 2) k ⧸ m) :=
    (Ideal.Quotient.maximal_ideal_iff_isField_quotient m).mp hm
  have hQmmax : (Qm).IsMaximal :=
    (Ideal.Quotient.maximal_ideal_iff_isField_quotient Qm).mpr
      (MulEquiv.isField hmfield ΦQm.toMulEquiv)
  set P := Ideal.map (εₐ : (MvPolynomial (Fin 2) k ⧸ Ideal.span {g}) →+* Γ(Z, U)) Qm with hP
  have hPprime : P.IsPrime := (Ideal.map_isMaximal_of_equiv εₐ : P.IsMaximal).isPrime
  -- the point of `Z` it corresponds to
  set y : PrimeSpectrum Γ(Z, U) := ⟨P, hPprime⟩
  set z := hU.fromSpec y
  have hz : z ∈ U := by
    have : z ∈ Set.range hU.fromSpec := ⟨y, rfl⟩
    rwa [hU.range_fromSpec] at this
  have hPeq : (hU.primeIdealOf ⟨z, hz⟩).asIdeal =
      Ideal.map (εₐ : (MvPolynomial (Fin 2) k ⧸ Ideal.span {g}) →+* Γ(Z, U)) Qm :=
    congrArg PrimeSpectrum.asIdeal
      (hU.fromSpec.isOpenEmbedding.injective (hU.fromSpec_primeIdealOf ⟨z, hz⟩))
  -- the residue field at that point, back to `k[x₀, x₁] ⧸ m`
  let Φ₂ : ((MvPolynomial (Fin 2) k ⧸ Ideal.span {g}) ⧸ Qm) ≃+*
      (Γ(Z, U) ⧸ (hU.primeIdealOf ⟨z, hz⟩).asIdeal) :=
    Ideal.quotientEquiv Qm _ εₐ.toRingEquiv hPeq
  have hPmax : ((hU.primeIdealOf ⟨z, hz⟩).asIdeal).IsMaximal :=
    (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mpr
      (MulEquiv.isField (MulEquiv.isField hmfield ΦQm.toMulEquiv) Φ₂.symm.toMulEquiv)
  let Φ₃ : (Γ(Z, U) ⧸ (hU.primeIdealOf ⟨z, hz⟩).asIdeal) ≃+*
      ((hU.primeIdealOf ⟨z, hz⟩).asIdeal).ResidueField :=
    RingEquiv.ofBijective (algebraMap _ _)
      (Ideal.bijective_algebraMap_quotient_residueField _)
  let Φ : (MvPolynomial (Fin 2) k ⧸ m) ≃+* Z.residueField z :=
    ((ΦQm.symm.trans Φ₂).trans Φ₃).trans (hU.residueFieldEquiv z hz)
  let algκ : Algebra k (Z.residueField z) :=
    ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ fZ.appTop ≫ Z.Γevaluation z).hom.toAlgebra
  have hevalmor : fZ.appLE ⊤ U le_top ≫ Z.evaluation U z hz =
      fZ.appTop ≫ Z.Γevaluation z := by
    simp only [Scheme.Hom.appLE, Scheme.evaluation, Scheme.Γevaluation, Category.assoc]
    congr 1
    rw [← Category.assoc, Z.presheaf.germ_res']
    rfl
  have heval : ∀ r : k, Z.evaluation U z hz (algebraMap k Γ(Z, U) r) =
      algebraMap k (Z.residueField z) r := fun r =>
    DFunLike.congr_fun (CommRingCat.hom_ext_iff.mp hevalmor)
      ((Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom r)
  have hΦ : ∀ r : k, Φ (algebraMap k (MvPolynomial (Fin 2) k ⧸ m) r) =
      algebraMap k (Z.residueField z) r := by
    intro r
    show (hU.residueFieldEquiv z hz) (Φ₃ (Φ₂ (ΦQm.symm
      (Ideal.Quotient.mk m (MvPolynomial.C r))))) = _
    rw [DoubleQuot.quotQuotEquivQuotOfLE_symm_mk]
    show (hU.residueFieldEquiv z hz) (Φ₃ (Φ₂ (Ideal.Quotient.mk Qm
      (Ideal.Quotient.mk (Ideal.span {g}) (MvPolynomial.C r))))) = _
    rw [show Φ₂ (Ideal.Quotient.mk Qm (Ideal.Quotient.mk (Ideal.span {g})
        (MvPolynomial.C r))) =
          Ideal.Quotient.mk ((hU.primeIdealOf ⟨z, hz⟩).asIdeal)
            (εₐ (Ideal.Quotient.mk (Ideal.span {g}) (MvPolynomial.C r))) from
      Ideal.quotientEquiv_mk _ _ _ _ _,
      show εₐ (Ideal.Quotient.mk (Ideal.span {g}) (MvPolynomial.C r)) =
        algebraMap k Γ(Z, U) r from hεalg r]
    show (hU.residueFieldEquiv z hz) (algebraMap Γ(Z, U) _ (algebraMap k Γ(Z, U) r)) = _
    rw [hU.residueFieldEquiv_algebraMap z hz]
    exact heval r
  let Φₐ : (MvPolynomial (Fin 2) k ⧸ m) ≃ₐ[k] Z.residueField z :=
    { Φ with commutes' := hΦ }
  have hfinκ : Module.Finite k (Z.residueField z) := Module.Finite.equiv Φₐ.toLinearEquiv
  have hsepκ : Algebra.IsSeparable k (Z.residueField z) :=
    Algebra.IsSeparable.of_equiv_equiv (RingEquiv.refl k) Φₐ.toRingEquiv
      (RingHom.ext fun r => (hΦ r).symm)
  have hrankκ : Module.finrank k (Z.residueField z) ≤ F.totalDegree := by
    rw [← Φₐ.toLinearEquiv.finrank_eq]
    exact hrank.trans (Stacks.ProjectiveChart.totalDegree_dehomCoeff_le k j F)
  exact ⟨z, isClosed_singleton_of_module_finite_residueField fZ z hfinκ,
    (hsm z hz Qm hPeq).mpr
      ((isSmoothAt_iff_exists_pderiv_notMem hg0 hgu Qm).mpr ⟨i', by rwa [hcomapQm]⟩),
    hfinκ, hsepκ, hrankκ⟩

end Stacks.Curves

end
