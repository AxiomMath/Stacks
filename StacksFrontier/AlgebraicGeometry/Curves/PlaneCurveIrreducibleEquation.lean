-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace HomogeneousLocalization
open Stacks.AlgebraicGeometry.ProjPolyChart
open Stacks.ClosedSubschemeProjQuotient
open Stacks.RingTheory.HomogeneousQuotient

universe u w

namespace AlgebraicGeometry.ProjectiveSpectrum.Proj

open AlgebraicGeometry

/-! ### `Proj` of a graded domain -/

section GradedRing

variable {A : Type u} {σ : Type w} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- **`Proj` of a nonzero graded domain is integral.** The zero ideal is a relevant homogeneous
prime, so it is a generic point and `Proj 𝒜` is irreducible; and every stalk is a graded
localization of a domain, so `Proj 𝒜` is reduced. -/
@[ega "II 2.3.17" "special case"]
private theorem isIntegral_proj_of_isDomain [IsDomain A]
    [Nonempty (AlgebraicGeometry.Proj 𝒜)] : IsIntegral (AlgebraicGeometry.Proj 𝒜) := by
  let p : ProjectiveSpectrum 𝒜 := ⟨⊥, by simpa using (inferInstance : (⊥ : Ideal A).IsPrime), by
    obtain ⟨x⟩ := ‹Nonempty (AlgebraicGeometry.Proj 𝒜)›
    exact fun h => x.not_irrelevant_le (h.trans bot_le)⟩
  have hp : closure ({p} : Set (ProjectiveSpectrum 𝒜)) = Set.univ :=
    Set.eq_univ_of_forall fun x => (ProjectiveSpectrum.le_iff_mem_closure 𝒜 p x).mp
      (show p.asHomogeneousIdeal ≤ x.asHomogeneousIdeal from bot_le)
  have : IrreducibleSpace (AlgebraicGeometry.Proj 𝒜) :=
    (irreducibleSpace_def _).mpr (by
      show IsIrreducible (Set.univ : Set (ProjectiveSpectrum 𝒜))
      rw [← hp]
      exact isIrreducible_singleton.closure)
  have hstalk (x : AlgebraicGeometry.Proj 𝒜) :
      _root_.IsReduced ((AlgebraicGeometry.Proj 𝒜).presheaf.stalk x) := by
    have : x.asHomogeneousIdeal.toIdeal.IsPrime := x.isPrime
    have : IsDomain (HomogeneousLocalization.AtPrime 𝒜 x.asHomogeneousIdeal.toIdeal) :=
      Function.Injective.isDomain
        (algebraMap (HomogeneousLocalization.AtPrime 𝒜 x.asHomogeneousIdeal.toIdeal)
          (Localization.AtPrime x.asHomogeneousIdeal.toIdeal))
        (HomogeneousLocalization.val_injective _)
    exact isReduced_of_injective (Proj.stalkIso' 𝒜 x) (Proj.stalkIso' 𝒜 x).injective
  have : IsReduced (AlgebraicGeometry.Proj 𝒜) := isReduced_of_isReduced_stalk _
  exact isIntegral_of_irreducibleSpace_of_isReduced _

/-- **An element vanishing at every point of a reduced `Proj 𝒜` is killed by a power of any
degree-one element.** The fraction `a / f ^ d` lies in every prime of the chart `D₊(f)`, hence is
nilpotent there, hence is zero because the chart ring is reduced. -/
private theorem exists_pow_mul_eq_zero_of_mem_all_proj
    [IsReduced (AlgebraicGeometry.Proj 𝒜)] {f a : A} (hf : f ∈ 𝒜 1) {d : ℕ} (ha : a ∈ 𝒜 d)
    (h : ∀ x : ProjectiveSpectrum 𝒜, a ∈ x.asHomogeneousIdeal) :
    ∃ n : ℕ, f ^ n * a = 0 := by
  let z : HomogeneousLocalization.NumDenSameDeg 𝒜 (.powers f) :=
    ⟨d, ⟨a, ha⟩, ⟨f ^ d, by simpa using SetLike.pow_mem_graded d hf⟩, ⟨d, rfl⟩⟩
  have hred : _root_.IsReduced (HomogeneousLocalization.Away 𝒜 f) :=
    isReduced_of_injective (Proj.basicOpenIsoAway 𝒜 f hf (by decide)).hom.hom
      (Proj.basicOpenIsoAway 𝒜 f hf (by decide)).commRingCatIsoToRingEquiv.injective
  have hz : IsNilpotent (HomogeneousLocalization.mk z) := by
    refine (PrimeSpectrum.basicOpen_eq_bot_iff _).mp (bot_unique fun q hq => ?_)
    obtain ⟨x, rfl⟩ := ProjIsoSpecTopComponent.toSpec_surjective 𝒜 hf (by decide) q
    exact hq ((ProjIsoSpecTopComponent.ToSpec.mk_mem_carrier x z).mpr (h x.1))
  have hz0 := congrArg HomogeneousLocalization.val hz.eq_zero
  simp only [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_zero] at hz0
  rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff] at hz0
  obtain ⟨⟨_, n, rfl⟩, hn⟩ := hz0
  exact ⟨n, hn⟩

/-- **The homogeneous ideal of all of an irreducible `Proj 𝒜` is prime.** The two standard opens
attached to elements outside it meet, and a point of the intersection separates the product. -/
@[ega "II 2.3.17" "special case"]
private theorem isPrime_vanishingIdeal_univ [IrreducibleSpace (ProjectiveSpectrum 𝒜)] :
    (ProjectiveSpectrum.vanishingIdeal
      (Set.univ : Set (ProjectiveSpectrum 𝒜))).toIdeal.IsPrime := by
  classical
  set I := ProjectiveSpectrum.vanishingIdeal (Set.univ : Set (ProjectiveSpectrum 𝒜)) with hI
  have mem (a : A) : a ∈ I.toIdeal ↔ ∀ x : ProjectiveSpectrum 𝒜, a ∈ x.asHomogeneousIdeal := by
    simp [hI, ProjectiveSpectrum.mem_vanishingIdeal]
  refine ⟨fun htop => ?_, fun {a b} hab => ?_⟩
  · obtain ⟨x⟩ := ‹IrreducibleSpace (ProjectiveSpectrum 𝒜)›.toNonempty
    exact x.isPrime.one_notMem ((mem 1).mp (by rw [htop]; trivial) x)
  · by_contra! h
    obtain ⟨x, hx⟩ := not_forall.mp (mt (mem a).mpr h.1)
    obtain ⟨y, hy⟩ := not_forall.mp (mt (mem b).mpr h.2)
    obtain ⟨z, hza, hzb⟩ := nonempty_preirreducible_inter
      (ProjectiveSpectrum.basicOpen 𝒜 a).isOpen (ProjectiveSpectrum.basicOpen 𝒜 b).isOpen
      ⟨x, hx⟩ ⟨y, hy⟩
    exact (z.isPrime.mem_or_mem ((mem (a * b)).mp hab z)).elim hza hzb

end GradedRing

/-! ### Divisibility from two coprime coordinates -/

/-- If `b` and `c` are coprime and `d` divides both `b * a` and `c * a`, then `d` divides `a`. -/
private theorem dvd_of_dvd_mul_of_dvd_mul_of_isRelPrime {R : Type*} [CommMonoidWithZero R]
    [GCDMonoid R] {a b c d : R} (h : IsRelPrime b c) (hb : d ∣ b * a) (hc : d ∣ c * a) : d ∣ a :=
  (h (gcd_dvd_left b c) (gcd_dvd_right b c)).dvd_mul_left.mp
    ((gcd_mul_right' a b c).dvd_iff_dvd_right.mp (dvd_gcd hb hc))

/-- A polynomial dividing both `T₀ ^ n * a` and `T₁ ^ m * a` divides `a`, the two coordinates
being coprime. -/
private theorem dvd_of_dvd_coordinate_pow_mul (k : Type u) [Field k]
    {a F : MvPolynomial (Fin 3) k} {n m : ℕ} (h0 : F ∣ MvPolynomial.X 0 ^ n * a)
    (h1 : F ∣ MvPolynomial.X 1 ^ m * a) : F ∣ a := by
  let _ := UniqueFactorizationMonoid.toGCDMonoid (MvPolynomial (Fin 3) k)
  have h : IsRelPrime (MvPolynomial.X (0 : Fin 3) : MvPolynomial (Fin 3) k)
      (MvPolynomial.X 1) :=
    MvPolynomial.X_prime.irreducible.isRelPrime_iff_not_dvd.mpr (by
      rw [MvPolynomial.X_dvd_X]; decide)
  exact dvd_of_dvd_mul_of_dvd_mul_of_isRelPrime h.pow h0 h1

/-! ### Closed subschemes of projective space as `Proj` of a quotient -/

section ProjectiveSpace

attribute [local instance] MvPolynomial.gradedAlgebra

variable (R : Type u) [CommRing R] (e : ℕ)

/-- Each coordinate `Tₖ` is homogeneous of degree one. -/
private theorem X_mem_homogeneousSubmodule_one (k : Fin e) :
    (MvPolynomial.X k : MvPolynomial (Fin e) R) ∈ MvPolynomial.homogeneousSubmodule (Fin e) R 1 :=
  MvPolynomial.isHomogeneous_X R k

/-- **A closed subscheme of `Proj R[T₀, …, T_{e-1}]` is `Proj` of the quotient by its homogeneous
ideal of equations**, over a Noetherian coefficient ring.

`Stacks.ProjQuotientChartIdeal.saturationIdentification_of_app_awayMk_eq_ideal` reduces this to a
chart statement — for `f` homogeneous of positive degree, `a / f ^ n` dies on `Z` exactly when
some `f ^ j · a` is an equation for `Z` — which for `f` of degree one is
`AlgebraicGeometry.ProjectiveSpectrum.Proj.mem_ker_app_basicOpen_iff`. The two differ only in the
exponent bookkeeping, matched by `chartFraction_eq_of_cross`. -/
private theorem projectiveSpace_saturationIdentification [IsNoetherianRing R] {Z : Scheme.{u}}
    (i : Z ⟶ AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin e) R))
    [IsClosedImmersion i] :
    SaturationIdentification (MvPolynomial.homogeneousSubmodule (Fin e) R) i := by
  have hX := X_mem_homogeneousSubmodule_one R e
  have hcov := Stacks.ProjectiveSpace.iSup_basicOpen_X_eq_top R (Fin e)
  refine Stacks.ProjQuotientChartIdeal.saturationIdentification_of_app_awayMk_eq_ideal _ i
    MvPolynomial.X (fun _ => 1) hX (fun _ => Nat.one_pos) hcov
    fun k n a ha => ⟨fun h => ?_, fun ⟨j, hj⟩ => ?_⟩
  · exact exists_pow_mul_mem_idealOfClosedSubscheme _ Nat.one_pos MvPolynomial.X hX hcov
      (hX k) i n ⟨a, ha⟩ h
  · have hmem : MvPolynomial.X k ^ j * a ∈
        MvPolynomial.homogeneousSubmodule (Fin e) R ((j + n) • 1) := by
      have h := SetLike.mul_mem_graded
        (SetLike.pow_mem_graded (A := MvPolynomial.homogeneousSubmodule (Fin e) R) j (hX k)) ha
      rwa [← add_smul] at h
    refine (mem_ker_app_basicOpen_iff _ Nat.one_pos MvPolynomial.X hX hcov (hX k) i _).2
      ⟨j + n, ⟨MvPolynomial.X k ^ j * a, hmem⟩, hj, ?_⟩
    refine chartFraction_eq_of_cross _ (hX k) (j + n) n
      ⟨MvPolynomial.X k ^ j * a, hmem⟩ ⟨a, ha⟩ ?_
    show MvPolynomial.X k ^ j * a * MvPolynomial.X k ^ n = a * MvPolynomial.X k ^ (j + n)
    ring

/-- **A closed subscheme of projective space over a Noetherian domain with no nonzero equation is
the whole space.** The kernel ideal sheaf is computed on the standard charts against that of the
identity: a fraction `a / T_k ^ n` killed by `i` has `T_k ^ N · a` an equation, hence zero, hence
`a = 0`. -/
private theorem projectiveSpace_isIso_of_idealOfClosedSubscheme_eq_bot [IsNoetherianRing R]
    [IsDomain R] {Z : Scheme.{u}}
    (i : Z ⟶ AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin e) R))
    [IsClosedImmersion i]
    (hI : idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin e) R) i = ⊥) :
    IsIso i := by
  have hX := X_mem_homogeneousSubmodule_one R e
  have hcov := Stacks.ProjectiveSpace.iSup_basicOpen_X_eq_top R (Fin e)
  rw [IsClosedImmersion.isIso_iff_ker_eq_bot]
  refine le_antisymm ?_ bot_le
  rw [← Scheme.Hom.ker_eq_bot_of_isIso
    (𝟙 (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin e) R)))]
  refine Stacks.ProjQuotientChartIdeal.ker_le_ker_of_app_awayMk _ i (𝟙 _) MvPolynomial.X
    (fun _ => 1) hX (fun _ => Nat.one_pos) hcov fun k z hz => ?_
  obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective _ (hX k) z
  obtain ⟨N, hN⟩ := exists_pow_mul_mem_idealOfClosedSubscheme _ Nat.one_pos MvPolynomial.X hX
    hcov (hX k) i n ⟨a, ha⟩ hz
  rw [hI, Ideal.mem_bot] at hN
  obtain rfl : a = 0 :=
    (mul_eq_zero.mp hN).resolve_left (pow_ne_zero _ (MvPolynomial.X_ne_zero k))
  rw [show Away.mk (MvPolynomial.homogeneousSubmodule (Fin e) R) (hX k) n
      (0 : MvPolynomial (Fin e) R) ha = 0 from
    HomogeneousLocalization.val_injective _
      (by rw [HomogeneousLocalization.Away.val_mk, Localization.mk_zero,
        HomogeneousLocalization.val_zero])]
  exact map_zero _

/-- **The homogeneous ideal of a nonempty closed subscheme of projective space is proper**, over
a Noetherian coefficient ring. If the ideal were the whole ring then the quotient would be the
zero ring, and `Z` is the `Proj` of that quotient, whose points are homogeneous primes — of
which the zero ring has none. -/
theorem projectiveSpace_idealOfClosedSubscheme_ne_top [IsNoetherianRing R] {Z : Scheme.{u}}
    [Nonempty Z] (i : Z ⟶ AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin e) R))
    [IsClosedImmersion i] :
    idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin e) R) i ≠ ⊤ := by
  intro htop
  obtain ⟨c, -⟩ := projectiveSpace_saturationIdentification R e i
  have hsub : Subsingleton (MvPolynomial (Fin e) R ⧸
      (homogeneousIdealOfClosedSubscheme
        (MvPolynomial.homogeneousSubmodule (Fin e) R) i).toIdeal) :=
    Ideal.Quotient.subsingleton_iff.mpr htop
  obtain ⟨x⟩ := Nonempty.map c.hom.base ‹Nonempty Z›
  exact x.isPrime.ne_top (Ideal.eq_top_iff_one _ |>.mpr
    (by rw [Subsingleton.elim (1 : MvPolynomial (Fin e) R ⧸ _) 0]; exact zero_mem _))

end ProjectiveSpace

/-! ### Tag 0BYC -/

attribute [local instance] MvPolynomial.gradedAlgebra

variable (k : Type u) [Field k] {Z : Scheme.{u}}
  (i : Z ⟶ AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 3) k))
  [IsClosedImmersion i]

include i in
/-- **An integral closed subscheme of `𝐏²_k` is a variety over `k`.** Separatedness and
quasi-compactness of the structure morphism are inherited from `𝐏²_k ⟶ Spec k`, and finite type
from its smoothness; integrality is the hypothesis. -/
theorem projectivePlane_isVariety_of_isIntegral [IsIntegral Z] :
    IsVariety k (i ≫ projToSpecCoeff k 2) := by
  have h : IsSeparated (Proj.toSpecZero (polyGrading k 2)) := inferInstance
  have hsep : IsSeparated (projToSpecCoeff k 2) := by rw [projToSpecCoeff]; infer_instance
  have hft : LocallyOfFiniteType (projToSpecCoeff k 2) := by
    have := smooth_projToSpecCoeff k 2
    infer_instance
  have hqc : QuasiCompact (projToSpecCoeff k 2) := by rw [projToSpecCoeff]; infer_instance
  constructor

include i in
/-- **The equation of a one-dimensional closed subscheme of `𝐏²_k` is nonzero.** If the
homogeneous ideal of `Z` were zero then `Z` would be the whole plane, of dimension two. -/
theorem projectivePlane_ne_zero_of_topologicalKrullDim_eq_one
    (hdim : topologicalKrullDim Z = 1) {F : MvPolynomial (Fin 3) k}
    (hF : idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin 3) k) i =
      Ideal.span {F}) : F ≠ 0 := by
  rintro rfl
  have hbot : idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin 3) k) i = ⊥ := by
    rw [hF, Ideal.span_singleton_eq_bot]
  have := projectiveSpace_isIso_of_idealOfClosedSubscheme_eq_bot k 3 i hbot
  have hhomeo := IsHomeomorph.topologicalKrullDim_eq _ (Scheme.Hom.homeomorph i).isHomeomorph
  rw [hdim, Stacks.ProjectiveSpace.topologicalKrullDim_proj_fin k (r := 3) (by norm_num)] at hhomeo
  norm_num at hhomeo

include i in
/-- **The equation of a plane curve generates a prime ideal.** If `Z` is integral and its
homogeneous ideal is `(F)`, then `(F)` is prime: the subscheme is `Proj` of the quotient by `(F)`,
the homogeneous ideal of all of an integral `Proj` is prime, and its preimage under the quotient
map is `(F)` — the containment `⊆` using that a homogeneous element vanishing identically is
divisible by `F` after multiplication by a power of each of two coprime coordinates. -/
@[ega "II 2.9.4" "Necessity clause only"]
theorem projectivePlane_isPrime_span_singleton_of_isCurve [IsIntegral Z]
    {F : MvPolynomial (Fin 3) k}
    (hF : idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin 3) k) i =
      Ideal.span {F}) :
    (Ideal.span ({F} : Set (MvPolynomial (Fin 3) k))).IsPrime := by
  classical
  set 𝒮 := MvPolynomial.homogeneousSubmodule (Fin 3) k
  obtain ⟨c, -⟩ := projectiveSpace_saturationIdentification k 3 i
  set ℐ := homogeneousIdealOfClosedSubscheme 𝒮 i
  set ℬ := quotientGrading 𝒮 ℐ
  have hψ : RingHom.ker (quotientMk 𝒮 ℐ) = Ideal.span {F} := by
    rw [ker_quotientMk]
    exact hF
  have : IsIntegral (AlgebraicGeometry.Proj ℬ) := IsIntegral.of_isIso c.hom
  have : IrreducibleSpace (ProjectiveSpectrum ℬ) :=
    inferInstanceAs (IrreducibleSpace (AlgebraicGeometry.Proj ℬ))
  set J := HomogeneousIdeal.comap (quotientMk 𝒮 ℐ)
    (ProjectiveSpectrum.vanishingIdeal (Set.univ : Set (ProjectiveSpectrum ℬ)))
  have hJprime : J.toIdeal.IsPrime := (isPrime_vanishingIdeal_univ ℬ).comap _
  suffices heq : J.toIdeal = Ideal.span {F} from heq ▸ hJprime
  refine le_antisymm (fun a ha => ?_) (fun a ha => ?_)
  · rw [← DirectSum.sum_support_decompose 𝒮 a]
    refine Ideal.sum_mem _ fun d _ => ?_
    set b := (DirectSum.decompose 𝒮 a) d
    have hbmem : quotientMk 𝒮 ℐ (b : MvPolynomial (Fin 3) k) ∈ ℬ d :=
      (quotientMk 𝒮 ℐ).map_mem b.2
    have hvan : ∀ x : ProjectiveSpectrum ℬ,
        quotientMk 𝒮 ℐ (b : MvPolynomial (Fin 3) k) ∈ x.asHomogeneousIdeal := fun x =>
      (ProjectiveSpectrum.mem_vanishingIdeal _ _).mp (J.isHomogeneous d ha) x (Set.mem_univ x)
    have hdvd (j : Fin 3) :
        ∃ n : ℕ, F ∣ MvPolynomial.X j ^ n * (b : MvPolynomial (Fin 3) k) := by
      obtain ⟨n, hn⟩ := exists_pow_mul_eq_zero_of_mem_all_proj ℬ
        ((quotientMk 𝒮 ℐ).map_mem (MvPolynomial.isHomogeneous_X k j)) hbmem hvan
      change quotientMk 𝒮 ℐ (MvPolynomial.X j) ^ n
        * quotientMk 𝒮 ℐ (b : MvPolynomial (Fin 3) k) = 0 at hn
      refine ⟨n, Ideal.mem_span_singleton.mp ?_⟩
      rw [← hψ]
      show quotientMk 𝒮 ℐ (MvPolynomial.X j ^ n * (b : MvPolynomial (Fin 3) k)) = 0
      simpa only [map_mul, map_pow] using hn
    obtain ⟨n, hn⟩ := hdvd 0
    obtain ⟨m, hm⟩ := hdvd 1
    exact Ideal.mem_span_singleton.mpr (dvd_of_dvd_coordinate_pow_mul k hn hm)
  · show quotientMk 𝒮 ℐ a ∈
      ProjectiveSpectrum.vanishingIdeal (Set.univ : Set (ProjectiveSpectrum ℬ))
    rw [show quotientMk 𝒮 ℐ a = 0 from RingHom.mem_ker.mp (hψ ▸ ha)]
    exact zero_mem _

/-- **Stacks Project, Tag 0BYC.** Let `k` be a field, let `Z ⊆ 𝐏²_k = Proj k[T₀, T₁, T₂]` be a
closed subscheme of dimension one and let `I(Z) = (F)`. Then `Z` is a curve over `k` if and only
if `F` is irreducible.

The hypotheses of [Stacks, Tag 0BYB] under which the generator `F` is produced — `Z`
equidimensional of dimension one with no embedded points — are not needed beyond `dim Z = 1`,
which they give for a nonempty `Z`; see
`AlgebraicGeometry.ProjectiveSpectrum.Proj.projectivePlane_idealOfClosedSubscheme_isPrincipal`
for that production. "Curve" is [Stacks, Tag 0A23]: a variety over `k` of Krull dimension one,
with respect to the structure morphism of the polynomial model of the projective plane. -/
@[stacks 0BYC]
theorem projectivePlane_isCurve_iff_irreducible (hdim : topologicalKrullDim Z = 1)
    {F : MvPolynomial (Fin 3) k}
    (hF : idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin 3) k) i =
      Ideal.span {F}) :
    IsCurve k (i ≫ projToSpecCoeff k 2) ↔ Irreducible F := by
  have hF0 : F ≠ 0 :=
    projectivePlane_ne_zero_of_topologicalKrullDim_eq_one k i hdim hF
  have hne : Nonempty Z := by
    obtain ⟨C⟩ : Nonempty (IrreducibleCloseds Z) := Order.krullDim_nonneg_iff.mp (by
      show 0 ≤ topologicalKrullDim Z
      rw [hdim]
      norm_num)
    exact ⟨C.2.nonempty.choose⟩
  rw [isCurve_iff, and_iff_left hdim]
  refine ⟨fun h => ?_, fun h => ?_⟩
  · have : IsIntegral Z := h.toIsIntegral
    exact UniqueFactorizationMonoid.irreducible_iff_prime.mpr
      ((Ideal.span_singleton_prime hF0).mp
        (projectivePlane_isPrime_span_singleton_of_isCurve k i hF))
  · set 𝒮 := MvPolynomial.homogeneousSubmodule (Fin 3) k
    have hprime : (idealOfClosedSubscheme 𝒮 i).IsPrime := by
      rw [hF, Ideal.span_singleton_prime hF0]
      exact UniqueFactorizationMonoid.irreducible_iff_prime.mp h
    obtain ⟨c, -⟩ := projectiveSpace_saturationIdentification k 3 i
    have hIprime : (homogeneousIdealOfClosedSubscheme 𝒮 i).toIdeal.IsPrime := hprime
    have : IsDomain (MvPolynomial (Fin 3) k ⧸ (homogeneousIdealOfClosedSubscheme 𝒮 i).toIdeal) :=
      Ideal.Quotient.isDomain _
    have : Nonempty (AlgebraicGeometry.Proj (quotientGrading 𝒮
        (homogeneousIdealOfClosedSubscheme 𝒮 i))) := Nonempty.map c.hom.base hne
    have : IsIntegral (AlgebraicGeometry.Proj (quotientGrading 𝒮
        (homogeneousIdealOfClosedSubscheme 𝒮 i))) := isIntegral_proj_of_isDomain _
    have : IsIntegral Z := IsIntegral.of_isIso c.inv
    exact projectivePlane_isVariety_of_isIntegral k i

/-- **Tag 0BYC under the hypotheses of Tag 0BYB.** A nonempty closed subscheme `Z ⊆ 𝐏²_k` all of
whose irreducible components have dimension one, with `I(Z) = (F)`, is a curve over `k` exactly
when `F` is irreducible.

This is `projectivePlane_isCurve_iff_irreducible` read through
`topologicalKrullDim_eq_one_of_forall_mem_irreducibleComponents`: for a nonempty `Z` the
hypothesis of [Stacks, Tag 0BYB] that every irreducible component has dimension one already fixes
the dimension of `Z`. The absence of embedded points, the other hypothesis of Tag 0BYB, is what
produces the generator `F` and is not needed once `F` is given, so it does not appear. The tag is
carried by `projectivePlane_isCurve_iff_irreducible`, which this specializes. -/
theorem projectivePlane_isCurve_iff_irreducible_of_equidimensional [Nonempty Z]
    (hdim : ∀ W ∈ irreducibleComponents Z, topologicalKrullDim W = 1)
    {F : MvPolynomial (Fin 3) k}
    (hF : idealOfClosedSubscheme (MvPolynomial.homogeneousSubmodule (Fin 3) k) i =
      Ideal.span {F}) :
    IsCurve k (i ≫ projToSpecCoeff k 2) ↔ Irreducible F :=
  projectivePlane_isCurve_iff_irreducible k i
    (topologicalKrullDim_eq_one_of_forall_mem_irreducibleComponents hdim) hF

end AlgebraicGeometry.ProjectiveSpectrum.Proj

