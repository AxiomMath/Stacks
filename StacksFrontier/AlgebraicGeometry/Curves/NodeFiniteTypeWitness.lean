module

public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.RingTheory.Localization.Ideal
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import StacksFrontier.AlgebraicGeometry.Curves.NodeBaseChangeFibre
public import StacksFrontier.RingTheory.MvPolynomial.RegularRing
public import StacksFrontier.RingTheory.NodalChart.Regularity
import all StacksFrontier.AlgebraicGeometry.Curves.Node.Algebra

/-!
# A node on a scheme locally of finite type over the base field

The node predicates of Tags 0C1W and 0C47 are conditions on a closed point of a scheme over a
field, and the results about them carry a `LocallyOfFiniteType` hypothesis on the structure
morphism — the source states them for algebraic curves.  This file exhibits a point satisfying
them on a scheme that **does** satisfy that hypothesis.

The witness is the affine nodal plane curve `Spec k[x, y]/(xy)` at the origin.  Its coordinate
ring is a quotient of a polynomial ring, so the structure morphism is locally of finite type by
construction; the work is showing that the origin satisfies the node predicates, whose content
is carried by the local ring there.

Over an algebraically closed — hence perfect — field the node condition is reducedness of the
local ring together with a nondegenerate quadratic relation on its cotangent space.  Reducedness
is inherited from `k[x, y]/(xy)`, whose nodal equation is a radical element because `x` and `y`
are relatively prime primes.  The quadratic relation is `xy = 0`, with discriminant `-1`; the
one substantive point is that the cotangent space is two-dimensional.  That is proved by
bracketing the minimal number of generators of the maximal ideal: the two coordinate functions
generate it, and cutting the regular local ring `k[x, y]_{(x,y)}` — which has embedding dimension
two by Tag 00OQ — by an element of the square of its maximal ideal cannot lower the embedding
dimension.  Identifying the local ring at the origin with that quotient is localization commuting
with the quotient.

## Main definitions

* `Stacks.Curves.nodalPlaneAlgebra` — the coordinate ring `k[x, y]/(xy)` of the affine nodal
  plane curve, a finitely generated `k`-algebra.
* `Stacks.Curves.nodalPlaneScheme` — its spectrum, as a scheme over `Spec k`.
* `Stacks.Curves.nodalPlaneOrigin` — the origin, as a point of that scheme.
* `Stacks.Curves.doubleLinePlaneAlgebra` — the double line `k[x, y]/(x²)`, the control.

## Main results

* `Stacks.Curves.locallyOfFiniteType_nodalPlaneScheme` — the witness scheme is locally of finite
  type over `Spec k`.
* `Stacks.Curves.spanFinrank_maximalIdeal_nodalPlaneLocalRing` — the local ring at the origin has
  embedding dimension two.
* `Stacks.Curves.isNodalAlgebra_nodalPlaneLocalRing` — that local ring is a nodal algebra in the
  sense of Tag 0C49, over any perfect base field.
* `Stacks.Curves.isOrdinaryDoublePoint_nodalPlaneScheme` and
  `Stacks.Curves.isNode_nodalPlaneScheme` — **the witness**: the origin is an ordinary double
  point in the sense of Tag 0C1W, and a node in the sense of Tag 0C47, on a scheme locally of
  finite type over an algebraically closed base field.
* `Stacks.Curves.ringKrullDim_nodalPlaneLocalRing` — the witness is one-dimensional.
* `Stacks.Curves.not_isNode_doubleLinePlaneScheme` — the control: the origin of the double line
  `Spec k[x, y]/(x²)`, also locally of finite type over `k`, is not a node.

## Implementation notes

The node conditions are verified on the local ring at the origin rather than on its completion
`k[[x, y]]/(xy)`, so no completion theory is used.

`Spec` is written out as `AlgebraicGeometry.Spec` throughout, because a root-level `abbrev Spec`
in this file's import closure makes the bare name ambiguous.

Instance search does not see the `Algebra k (𝒪_{X,x})` structure that the node predicates bind
inside their own statements, so the two witness proofs introduce it explicitly before applying
the characterizations.  The point at the origin is given the type of a point of the scheme rather
than of the prime spectrum, since `IsLocalRing` of a stalk is found only at that spelling.

The maximal ideal of the origin is presented as the kernel of evaluation at the origin, which
makes maximality immediate, and separately identified with the ideal generated by the two
coordinate functions, which is the form the quadratic relation needs.

## References

* [Stacks Project, Tag 0C1W](https://stacks.math.columbia.edu/tag/0C1W)
* [Stacks Project, Tag 0C47](https://stacks.math.columbia.edu/tag/0C47)
* [Stacks Project, Tag 0C49](https://stacks.math.columbia.edu/tag/0C49)
* [Stacks Project, Tag 00OQ](https://stacks.math.columbia.edu/tag/00OQ)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry IsLocalRing MvPolynomial

universe u

namespace Stacks.Curves

variable (k : Type u) [Field k]

/-! ### The affine nodal plane curve -/

/-- The nodal plane algebra `k[x, y]/(xy)`: the coordinate ring of the affine nodal plane
curve, a *finitely generated* `k`-algebra. -/
abbrev nodalPlaneAlgebra : Type u :=
  MvPolynomial (Fin 2) k ⧸
    Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k) * MvPolynomial.X 1}

/-- The two variables of `k[x, y]` are relatively prime: any common divisor is a unit. -/
theorem isRelPrime_X_zero_X_one :
    IsRelPrime (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) (MvPolynomial.X 1) := by
  rintro d ⟨e, he⟩ hd1
  rcases (MvPolynomial.X_prime (i := (0 : Fin 2)) (R := k)).irreducible.isUnit_or_isUnit he with
    hu | hu
  · exact hu
  · have hassoc : Associated d (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) :=
      ⟨hu.unit, by simp [he]⟩
    exact absurd (MvPolynomial.X_dvd_X.mp (hassoc.symm.dvd.trans hd1)) (by decide)

/-- The nodal equation `xy` is a radical element of `k[x, y]`. -/
theorem isRadical_X_zero_mul_X_one :
    IsRadical ((MvPolynomial.X 0 : MvPolynomial (Fin 2) k) * MvPolynomial.X 1) :=
  fun _ _ hy => (isRelPrime_X_zero_X_one k).mul_dvd
    ((MvPolynomial.X_prime (i := (0 : Fin 2)) (R := k)).dvd_of_dvd_pow
      ((dvd_mul_right _ _).trans hy))
    ((MvPolynomial.X_prime (i := (1 : Fin 2)) (R := k)).dvd_of_dvd_pow
      ((dvd_mul_left _ _).trans hy))

/-- **`k[x, y]/(xy)` is reduced.** -/
theorem isReduced_nodalPlaneAlgebra : IsReduced (nodalPlaneAlgebra k) :=
  (Ideal.isRadical_iff_quotient_reduced _).mp
    (isRadical_iff_span_singleton.mp (isRadical_X_zero_mul_X_one k))

/-! ### The origin -/

/-- The ideal of the origin of `𝔸²_k`, spanned by the two variables. -/
theorem span_X_eq_idealOfVars :
    Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k), MvPolynomial.X 1} =
      MvPolynomial.idealOfVars (Fin 2) k := by
  congr 1
  ext p
  constructor
  · rintro (rfl | rfl)
    exacts [⟨0, rfl⟩, ⟨1, rfl⟩]
  · rintro ⟨i, rfl⟩
    fin_cases i
    exacts [Or.inl rfl, Or.inr rfl]

/-- A polynomial lies in the ideal of the variables exactly when its constant term vanishes. -/
theorem mem_idealOfVars_iff_constantCoeff (p : MvPolynomial (Fin 2) k) :
    p ∈ MvPolynomial.idealOfVars (Fin 2) k ↔ MvPolynomial.constantCoeff p = 0 := by
  rw [← pow_one (MvPolynomial.idealOfVars (Fin 2) k), MvPolynomial.mem_pow_idealOfVars_iff']
  refine ⟨fun h => h 0 (by simp), fun h x hx => ?_⟩
  obtain rfl : x = 0 := (Finsupp.degree_eq_zero_iff x).mp (by omega)
  simpa [MvPolynomial.constantCoeff] using h

/-- Evaluation at the origin, as a ring homomorphism out of `k[x, y]/(xy)`. -/
def nodalPlaneEvalOrigin : nodalPlaneAlgebra k →+* k :=
  Ideal.Quotient.lift _ MvPolynomial.constantCoeff <| by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp ha
    simp

/-- Evaluation at the origin sends the class of a polynomial to its constant coefficient. -/
theorem nodalPlaneEvalOrigin_mk (p : MvPolynomial (Fin 2) k) :
    nodalPlaneEvalOrigin k (Ideal.Quotient.mk _ p) = MvPolynomial.constantCoeff p := rfl

/-- Evaluation at the origin of `k[x, y]/(xy)` is surjective. -/
theorem surjective_nodalPlaneEvalOrigin : Function.Surjective (nodalPlaneEvalOrigin k) :=
  fun r => ⟨Ideal.Quotient.mk _ (MvPolynomial.C r), by simp [nodalPlaneEvalOrigin_mk]⟩

/-- The ideal of the origin of the affine nodal plane curve. -/
def nodalPlaneOriginIdeal : Ideal (nodalPlaneAlgebra k) :=
  RingHom.ker (nodalPlaneEvalOrigin k)

/-- The ideal of the origin of the affine nodal plane curve is maximal. -/
instance isMaximal_nodalPlaneOriginIdeal : (nodalPlaneOriginIdeal k).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective _ (surjective_nodalPlaneEvalOrigin k)

/-- A class in `k[x, y]/(xy)` lies in the ideal of the origin iff its representative lies in the
ideal of the variables. -/
private theorem mk_mem_nodalPlaneOriginIdeal_iff (p : MvPolynomial (Fin 2) k) :
    Ideal.Quotient.mk _ p ∈ nodalPlaneOriginIdeal k ↔ p ∈ MvPolynomial.idealOfVars (Fin 2) k := by
  rw [mem_idealOfVars_iff_constantCoeff, nodalPlaneOriginIdeal, RingHom.mem_ker,
    nodalPlaneEvalOrigin_mk]

/-- **The ideal of the origin is generated by the two coordinate functions.** -/
theorem span_eq_nodalPlaneOriginIdeal :
    Ideal.span {Ideal.Quotient.mk _ (MvPolynomial.X 0 : MvPolynomial (Fin 2) k),
        Ideal.Quotient.mk _ (MvPolynomial.X 1)} = nodalPlaneOriginIdeal k := by
  have hmap : Ideal.span {Ideal.Quotient.mk _ (MvPolynomial.X 0 : MvPolynomial (Fin 2) k),
      Ideal.Quotient.mk _ (MvPolynomial.X 1)} =
      (MvPolynomial.idealOfVars (Fin 2) k).map
        (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k) *
          MvPolynomial.X 1})) := by
    rw [← span_X_eq_idealOfVars, Ideal.map_span]
    congr 1
    simp
  rw [hmap]
  refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun p hp => ?_) fun a ha => ?_
  · exact (mk_mem_nodalPlaneOriginIdeal_iff k p).mpr hp
  · obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
    exact Ideal.mem_map_of_mem _ ((mk_mem_nodalPlaneOriginIdeal_iff k p).mp ha)

/-! ### The local ring at the origin, and its embedding dimension -/

/-- The ideal of the variables of `k[x, y]` is the kernel of the constant coefficient map. -/
theorem idealOfVars_eq_ker_constantCoeff :
    MvPolynomial.idealOfVars (Fin 2) k =
      RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin 2) k →+* k) := by
  ext p
  rw [mem_idealOfVars_iff_constantCoeff, RingHom.mem_ker]

/-- The ideal of the variables of `k[x, y]` is maximal. -/
instance isMaximal_idealOfVars : (MvPolynomial.idealOfVars (Fin 2) k).IsMaximal := by
  rw [idealOfVars_eq_ker_constantCoeff]
  exact RingHom.ker_isMaximal_of_surjective _ fun r => ⟨MvPolynomial.C r, by simp⟩

/-- The local ring of `𝔸²_k` at the origin: a regular local ring of dimension two. -/
abbrev planeLocalRing : Type u := Localization.AtPrime (MvPolynomial.idealOfVars (Fin 2) k)

/-- The local ring of the affine nodal plane curve at the origin. -/
abbrev nodalPlaneLocalRing : Type u := Localization.AtPrime (nodalPlaneOriginIdeal k)

/-- The nodal equation, as an ideal of the local ring of `𝔸²_k` at the origin. -/
abbrev nodalPlaneLocalIdeal : Ideal (planeLocalRing k) :=
  (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k) * MvPolynomial.X 1}).map
    (algebraMap (MvPolynomial (Fin 2) k) (planeLocalRing k))

/-- **The local ring of `𝔸²_k` at the origin has embedding dimension two.**  This is Tag 00OQ at
`ι = Fin 2`: the localization is regular of Krull dimension two. -/
theorem spanFinrank_maximalIdeal_planeLocalRing :
    (maximalIdeal (planeLocalRing k)).spanFinrank = 2 := by
  obtain ⟨-, -, hloc⟩ :=
    MvPolynomial.isRegularRing_and_iSup_projectiveDimension_eq_and_isRegularLocalRing_localization
      k (Fin 2)
  obtain ⟨hreg, hdim⟩ := hloc (MvPolynomial.idealOfVars (Fin 2) k) (planeLocalRing k)
  have := hreg
  have h2 : ((maximalIdeal (planeLocalRing k)).spanFinrank : WithBot ℕ∞) =
      ringKrullDim (planeLocalRing k) := IsRegularLocalRing.spanFinrank_maximalIdeal
  rw [hdim] at h2
  simp only [Nat.card_eq_fintype_card, Fintype.card_fin] at h2
  exact_mod_cast h2

/-- The nodal equation lies in the square of the maximal ideal of `k[x, y]_{(x,y)}`. -/
theorem nodalPlaneLocalIdeal_le_sq :
    nodalPlaneLocalIdeal k ≤ maximalIdeal (planeLocalRing k) ^ 2 := by
  have hmem : ∀ i : Fin 2,
      algebraMap (MvPolynomial (Fin 2) k) (planeLocalRing k) (MvPolynomial.X i) ∈
        maximalIdeal (planeLocalRing k) := fun i =>
    (IsLocalization.AtPrime.to_map_mem_maximal_iff _ _ _).mpr
      (Ideal.subset_span (Set.mem_range_self i))
  rw [nodalPlaneLocalIdeal, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, rfl, rfl⟩
  rw [map_mul, pow_two]
  exact Ideal.mul_mem_mul (hmem 0) (hmem 1)

/-- The complement of the origin ideal of `k[x, y]` maps onto the complement of the origin ideal
of `k[x, y]/(xy)`. -/
theorem algebraMapSubmonoid_primeCompl_eq :
    Algebra.algebraMapSubmonoid (nodalPlaneAlgebra k)
        (MvPolynomial.idealOfVars (Fin 2) k).primeCompl =
      (nodalPlaneOriginIdeal k).primeCompl := by
  have hmk : (algebraMap (MvPolynomial (Fin 2) k) (nodalPlaneAlgebra k)) =
      Ideal.Quotient.mk _ := Ideal.Quotient.algebraMap_eq _
  ext s
  simp only [Algebra.algebraMapSubmonoid, Submonoid.mem_map, Ideal.primeCompl,
    Submonoid.mem_mk, Subsemigroup.mem_mk, Set.mem_compl_iff, SetLike.mem_coe]
  constructor
  · rintro ⟨r, hr, rfl⟩
    rw [hmk]
    exact fun h => hr ((mk_mem_nodalPlaneOriginIdeal_iff k r).mp h)
  · intro hs
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective s
    refine ⟨p, fun hp => ?_, hmk ▸ rfl⟩
    exact hs ((mk_mem_nodalPlaneOriginIdeal_iff k p).mpr hp)

/-- **The local ring at the origin of the affine nodal plane curve is the quotient of the regular
local ring `k[x, y]_{(x,y)}` by the nodal equation.**  Localization commutes with the quotient. -/
theorem isLocalization_quotient_nodalPlaneLocalIdeal :
    IsLocalization.AtPrime (planeLocalRing k ⧸ nodalPlaneLocalIdeal k)
      (nodalPlaneOriginIdeal k) := by
  show IsLocalization (nodalPlaneOriginIdeal k).primeCompl _
  rw [← algebraMapSubmonoid_primeCompl_eq k]
  infer_instance

/-- The two coordinate functions generate the maximal ideal of the local ring at the origin. -/
theorem span_eq_maximalIdeal_nodalPlaneLocalRing :
    Ideal.span {algebraMap (nodalPlaneAlgebra k) (nodalPlaneLocalRing k)
          (Ideal.Quotient.mk _ (MvPolynomial.X 0)),
        algebraMap (nodalPlaneAlgebra k) (nodalPlaneLocalRing k)
          (Ideal.Quotient.mk _ (MvPolynomial.X 1))} =
      maximalIdeal (nodalPlaneLocalRing k) := by
  have h : (Ideal.span {Ideal.Quotient.mk _ (MvPolynomial.X 0 : MvPolynomial (Fin 2) k),
        Ideal.Quotient.mk _ (MvPolynomial.X 1)}).map
        (algebraMap (nodalPlaneAlgebra k) (nodalPlaneLocalRing k)) =
      maximalIdeal (nodalPlaneLocalRing k) := by
    rw [span_eq_nodalPlaneOriginIdeal k]
    exact IsLocalization.AtPrime.map_eq_maximalIdeal _ _
  rwa [Ideal.map_span, Set.image_insert_eq, Set.image_singleton] at h

/-- **The local ring at the origin of the affine nodal plane curve has embedding dimension
two.**  The upper bound is the pair of coordinate functions; the lower bound is that cutting the
regular local ring `k[x, y]_{(x,y)}` by an element of the square of its maximal ideal does not
lower the embedding dimension. -/
theorem spanFinrank_maximalIdeal_nodalPlaneLocalRing :
    (maximalIdeal (nodalPlaneLocalRing k)).spanFinrank = 2 := by
  have := isLocalization_quotient_nodalPlaneLocalIdeal k
  let e : nodalPlaneLocalRing k ≃ₐ[nodalPlaneAlgebra k]
      (planeLocalRing k ⧸ nodalPlaneLocalIdeal k) :=
    IsLocalization.algEquiv (nodalPlaneOriginIdeal k).primeCompl
      (nodalPlaneLocalRing k) (planeLocalRing k ⧸ nodalPlaneLocalIdeal k)
  let φ : planeLocalRing k →+* nodalPlaneLocalRing k :=
    (e.symm : (planeLocalRing k ⧸ nodalPlaneLocalIdeal k) →+* nodalPlaneLocalRing k).comp
      (Ideal.Quotient.mk (nodalPlaneLocalIdeal k))
  have hker : RingHom.ker φ ≤ maximalIdeal (planeLocalRing k) ^ 2 := by
    intro a ha
    refine nodalPlaneLocalIdeal_le_sq k (Ideal.Quotient.eq_zero_iff_mem.mp ?_)
    have h0 : e.symm (Ideal.Quotient.mk (nodalPlaneLocalIdeal k) a) = 0 := ha
    simpa using h0
  have hle := Stacks.spanFinrank_maximalIdeal_le_of_ker_le_sq φ
    (e.symm.surjective.comp Ideal.Quotient.mk_surjective) hker
  rw [spanFinrank_maximalIdeal_planeLocalRing] at hle
  have hub : (maximalIdeal (nodalPlaneLocalRing k)).spanFinrank ≤ 2 := by
    rw [← span_eq_maximalIdeal_nodalPlaneLocalRing k]
    exact (Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)).trans
      ((Set.ncard_insert_le _ _).trans (by simp))
  omega

/-! ### The nodal quadratic relation at the origin -/

/-- The two coordinate functions, as elements of the local ring at the origin. -/
abbrev nodalPlaneCoord (i : Fin 2) : nodalPlaneLocalRing k :=
  algebraMap (nodalPlaneAlgebra k) (nodalPlaneLocalRing k)
    (Ideal.Quotient.mk _ (MvPolynomial.X i))

/-- Each coordinate function lies in the maximal ideal of the local ring at the origin. -/
theorem nodalPlaneCoord_mem_maximalIdeal (i : Fin 2) :
    nodalPlaneCoord k i ∈ maximalIdeal (nodalPlaneLocalRing k) := by
  refine (IsLocalization.AtPrime.to_map_mem_maximal_iff (nodalPlaneLocalRing k)
    (nodalPlaneOriginIdeal k) _).mpr ?_
  rw [← span_eq_nodalPlaneOriginIdeal k]
  refine Ideal.subset_span ?_
  fin_cases i
  exacts [Or.inl rfl, Or.inr rfl]

/-- The product of the two coordinate functions vanishes in the local ring at the origin. -/
theorem nodalPlaneCoord_mul_eq_zero :
    nodalPlaneCoord k 0 * nodalPlaneCoord k 1 = 0 := by
  rw [← map_mul, ← map_mul,
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), map_zero]

/-- **The local ring at the origin of the affine nodal plane curve carries a nondegenerate
quadratic relation on its cotangent space**, namely `xy = 0` with discriminant `-1`. -/
theorem hasNodalQuadraticRelation_nodalPlaneLocalRing :
    HasNodalQuadraticRelation (nodalPlaneLocalRing k) := by
  rw [hasNodalQuadraticRelation_iff_exists_generating_pair]
  refine ⟨nodalPlaneCoord k 0, nodalPlaneCoord k 1, 0, 1, 0,
    nodalPlaneCoord_mem_maximalIdeal k 0, nodalPlaneCoord_mem_maximalIdeal k 1,
    span_eq_maximalIdeal_nodalPlaneLocalRing k, ?_, by simp, ?_⟩
  · rw [← IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
    exact spanFinrank_maximalIdeal_nodalPlaneLocalRing k
  · simp [nodalPlaneCoord_mul_eq_zero k]

/-- **The local ring at the origin of the affine nodal plane curve is a nodal algebra** in the
sense of Tag 0C49, over any perfect base field. -/
theorem isNodalAlgebra_nodalPlaneLocalRing (K : Type u) [Field K] [PerfectField K]
    [Algebra K (nodalPlaneLocalRing k)] :
    IsNodalAlgebra K (nodalPlaneLocalRing k) := by
  have hred : IsReduced (nodalPlaneAlgebra k) := isReduced_nodalPlaneAlgebra k
  rw [isNodalAlgebra_iff_isReduced_and_hasNodalQuadraticRelation]
  exact ⟨inferInstance, hasNodalQuadraticRelation_nodalPlaneLocalRing k⟩

/-! ### The affine nodal plane curve as a scheme locally of finite type over `Spec k` -/

/-- The affine nodal plane curve over `k`, as a scheme. -/
abbrev nodalPlaneScheme : Scheme.{u} :=
  AlgebraicGeometry.Spec (CommRingCat.of (nodalPlaneAlgebra k))

/-- The affine nodal plane curve as a scheme over `Spec k`, via the structure map of the
`k`-algebra `k[x, y]/(xy)`. -/
instance nodalPlaneSchemeOver :
    (nodalPlaneScheme k).Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
  ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (nodalPlaneAlgebra k)))⟩

/-- **The affine nodal plane curve is locally of finite type over `k`.** -/
instance locallyOfFiniteType_nodalPlaneScheme :
    LocallyOfFiniteType (nodalPlaneScheme k ↘ AlgebraicGeometry.Spec (CommRingCat.of k)) := by
  change LocallyOfFiniteType (AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap k (nodalPlaneAlgebra k))))
  rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
  exact RingHom.finiteType_algebraMap.mpr inferInstance

/-- The origin of the affine nodal plane curve, as a point of the scheme. -/
def nodalPlaneOrigin : ↥(nodalPlaneScheme k) :=
  (⟨nodalPlaneOriginIdeal k, inferInstance⟩ : PrimeSpectrum (nodalPlaneAlgebra k))

/-- The origin is a closed point of the affine nodal plane curve. -/
theorem isClosed_nodalPlaneOrigin :
    IsClosed ({nodalPlaneOrigin k} : Set (nodalPlaneScheme k)) :=
  (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).2 (isMaximal_nodalPlaneOriginIdeal k)

/-- The stalk at the origin is the local ring of the affine nodal plane curve there. -/
def nodalPlaneStalkRingEquiv :
    ↥((nodalPlaneScheme k).presheaf.stalk (nodalPlaneOrigin k)) ≃+* nodalPlaneLocalRing k :=
  (AlgebraicGeometry.Spec.stalkIso (CommRingCat.of (nodalPlaneAlgebra k))
    (nodalPlaneOrigin k)).commRingCatIsoToRingEquiv

/-! ### The dimension of the witness, and the witness itself -/

/-- **The witness is one-dimensional**: the local ring at the origin of the affine nodal plane
curve has Krull dimension one, so the point is a singular point of a curve and not a
zero-dimensional degeneration. -/
theorem ringKrullDim_nodalPlaneLocalRing : ringKrullDim (nodalPlaneLocalRing k) = 1 := by
  have hred : IsReduced (nodalPlaneAlgebra k) := isReduced_nodalPlaneAlgebra k
  exact ringKrullDim_eq_one_of_isReduced_and_hasNodalQuadraticRelation
    (nodalPlaneLocalRing k) inferInstance (hasNodalQuadraticRelation_nodalPlaneLocalRing k)

/-- The stalk of the affine nodal plane curve at the origin is a Noetherian ring. -/
instance isNoetherianRing_nodalPlaneStalk :
    IsNoetherianRing ↥((nodalPlaneScheme k).presheaf.stalk (nodalPlaneOrigin k)) :=
  isNoetherianRing_of_ringEquiv _ (nodalPlaneStalkRingEquiv k).symm

/-- The stalk at the origin of the nodal plane curve is a nodal algebra over any perfect field. -/
private theorem isNodalAlgebra_nodalPlaneStalk [PerfectField k]
    [Algebra k ↥((nodalPlaneScheme k).presheaf.stalk (nodalPlaneOrigin k))] :
    IsNodalAlgebra k ↥((nodalPlaneScheme k).presheaf.stalk (nodalPlaneOrigin k)) :=
  isNodalAlgebra_of_ringEquiv k k (nodalPlaneStalkRingEquiv k).symm
    (isNodalAlgebra_nodalPlaneLocalRing k k)

/-- **The origin of the affine nodal plane curve `Spec k[x, y]/(xy)` is an ordinary double
point** in the sense of Tag 0C1W, over an algebraically closed field `k`. -/
theorem isOrdinaryDoublePoint_nodalPlaneScheme [IsAlgClosed k] :
    IsOrdinaryDoublePoint k (nodalPlaneScheme k) (nodalPlaneOrigin k) := by
  let : Algebra k ↥((nodalPlaneScheme k).presheaf.stalk (nodalPlaneOrigin k)) :=
    (((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
      (nodalPlaneScheme k ↘ AlgebraicGeometry.Spec (CommRingCat.of k)).appTop ≫
        (nodalPlaneScheme k).presheaf.germ ⊤ (nodalPlaneOrigin k) trivial).hom).toAlgebra
  exact (isOrdinaryDoublePoint_iff_isNodalAlgebra_stalk k (nodalPlaneScheme k)
    (nodalPlaneOrigin k)).mpr ⟨isClosed_nodalPlaneOrigin k, isNodalAlgebra_nodalPlaneStalk k⟩

/-- **The origin of `Spec k[x, y]/(xy)` is a node** in the sense of Tag 0C47, over an
algebraically closed field `k`. -/
theorem isNode_nodalPlaneScheme [IsAlgClosed k] :
    IsNode k (nodalPlaneScheme k) (nodalPlaneOrigin k) := by
  let : Algebra k ↥((nodalPlaneScheme k).presheaf.stalk (nodalPlaneOrigin k)) :=
    (((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
      (nodalPlaneScheme k ↘ AlgebraicGeometry.Spec (CommRingCat.of k)).appTop ≫
        (nodalPlaneScheme k).presheaf.germ ⊤ (nodalPlaneOrigin k) trivial).hom).toAlgebra
  exact (isNode_iff_isNodalAlgebra_stalk_of_isAlgClosed k (nodalPlaneScheme k)
    (nodalPlaneOrigin k) (isClosed_nodalPlaneOrigin k)).mpr (isNodalAlgebra_nodalPlaneStalk k)

/-! ### The predicted-failure control: the double line, also of finite type -/

/-- The double line `k[x, y]/(x²)`: a one-dimensional singularity of finite type over `k` which
is not reduced, hence not a node. -/
abbrev doubleLinePlaneAlgebra : Type u :=
  MvPolynomial (Fin 2) k ⧸ Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k) ^ 2}

/-- Evaluation at the origin, out of `k[x, y]/(x²)`. -/
def doubleLinePlaneEvalOrigin : doubleLinePlaneAlgebra k →+* k :=
  Ideal.Quotient.lift _ MvPolynomial.constantCoeff <| by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp ha
    simp

/-- Evaluation at the origin sends the class of a polynomial to its constant coefficient. -/
theorem doubleLinePlaneEvalOrigin_mk (p : MvPolynomial (Fin 2) k) :
    doubleLinePlaneEvalOrigin k (Ideal.Quotient.mk _ p) = MvPolynomial.constantCoeff p := rfl

/-- Evaluation at the origin of `k[x, y]/(x²)` is surjective. -/
theorem surjective_doubleLinePlaneEvalOrigin :
    Function.Surjective (doubleLinePlaneEvalOrigin k) :=
  fun r => ⟨Ideal.Quotient.mk _ (MvPolynomial.C r), by simp [doubleLinePlaneEvalOrigin_mk]⟩

/-- The ideal of the origin of the double line. -/
def doubleLinePlaneOriginIdeal : Ideal (doubleLinePlaneAlgebra k) :=
  RingHom.ker (doubleLinePlaneEvalOrigin k)

/-- The ideal of the origin of the double line is maximal. -/
instance isMaximal_doubleLinePlaneOriginIdeal : (doubleLinePlaneOriginIdeal k).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective _ (surjective_doubleLinePlaneEvalOrigin k)

/-- The local ring of the double line at the origin. -/
abbrev doubleLinePlaneLocalRing : Type u := Localization.AtPrime (doubleLinePlaneOriginIdeal k)

/-- **The local ring of the double line at the origin is not reduced.**  The coordinate `x` is a
nonzero square-zero element: an element of `k[x, y]` annihilating `x` modulo `x²` is divisible
by `x`, hence lies in the ideal of the origin. -/
theorem not_isReduced_doubleLinePlaneLocalRing :
    ¬ IsReduced (doubleLinePlaneLocalRing k) := by
  intro hred
  have hsq : (algebraMap (doubleLinePlaneAlgebra k) (doubleLinePlaneLocalRing k)
      (Ideal.Quotient.mk _ (MvPolynomial.X 0))) ^ 2 = 0 := by
    rw [← map_pow, ← map_pow,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), map_zero]
  obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff
    (doubleLinePlaneOriginIdeal k).primeCompl _ _).mp (hred.eq_zero _ ⟨2, hsq⟩)
  obtain ⟨t, hts⟩ := Ideal.Quotient.mk_surjective (s : doubleLinePlaneAlgebra k)
  rw [← hts, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hs
  obtain ⟨c, hc⟩ := hs
  have ht : t = MvPolynomial.X 0 * c :=
    mul_right_cancel₀ (MvPolynomial.X_prime (i := (0 : Fin 2)) (R := k)).ne_zero
      (by linear_combination hc)
  refine s.2 ?_
  rw [← hts]
  exact RingHom.mem_ker.mpr (by simp [doubleLinePlaneEvalOrigin_mk, ht])

/-- The double line over `k`, as a scheme. -/
abbrev doubleLinePlaneScheme : Scheme.{u} :=
  AlgebraicGeometry.Spec (CommRingCat.of (doubleLinePlaneAlgebra k))

/-- The double line as a scheme over `Spec k`, via the structure map of the `k`-algebra
`k[x, y]/(x²)`. -/
instance doubleLinePlaneSchemeOver :
    (doubleLinePlaneScheme k).Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
  ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (doubleLinePlaneAlgebra k)))⟩

/-- **The double line is locally of finite type over `k`.** -/
instance locallyOfFiniteType_doubleLinePlaneScheme :
    LocallyOfFiniteType
      (doubleLinePlaneScheme k ↘ AlgebraicGeometry.Spec (CommRingCat.of k)) := by
  change LocallyOfFiniteType (AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap k (doubleLinePlaneAlgebra k))))
  rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
  exact RingHom.finiteType_algebraMap.mpr inferInstance

/-- The origin of the double line, as a point of the scheme. -/
def doubleLinePlaneOrigin : ↥(doubleLinePlaneScheme k) :=
  (⟨doubleLinePlaneOriginIdeal k, inferInstance⟩ : PrimeSpectrum (doubleLinePlaneAlgebra k))

/-- The origin is a closed point of the double line. -/
theorem isClosed_doubleLinePlaneOrigin :
    IsClosed ({doubleLinePlaneOrigin k} : Set (doubleLinePlaneScheme k)) :=
  (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).2 (isMaximal_doubleLinePlaneOriginIdeal k)

/-- The stalk of the double line at the origin is its local ring there. -/
def doubleLinePlaneStalkRingEquiv :
    ↥((doubleLinePlaneScheme k).presheaf.stalk (doubleLinePlaneOrigin k)) ≃+*
      doubleLinePlaneLocalRing k :=
  (AlgebraicGeometry.Spec.stalkIso (CommRingCat.of (doubleLinePlaneAlgebra k))
    (doubleLinePlaneOrigin k)).commRingCatIsoToRingEquiv

/-- **The origin of the double line `Spec k[x, y]/(x²)` is not a node** over an algebraically
closed field `k`. -/
theorem not_isNode_doubleLinePlaneScheme [IsAlgClosed k] :
    ¬ IsNode k (doubleLinePlaneScheme k) (doubleLinePlaneOrigin k) := by
  intro hnode
  have hnodal := (isNode_iff_isNodalAlgebra_stalk_of_isAlgClosed k (doubleLinePlaneScheme k)
    (doubleLinePlaneOrigin k) hnode.isClosed).mp hnode
  have hredStalk : IsReduced ↥((doubleLinePlaneScheme k).presheaf.stalk
      (doubleLinePlaneOrigin k)) := hnodal.2.1
  exact not_isReduced_doubleLinePlaneLocalRing k
    (isReduced_of_injective (doubleLinePlaneStalkRingEquiv k).symm.toRingHom
      (RingEquiv.injective _))

end Stacks.Curves

