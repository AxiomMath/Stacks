module

public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.RingTheory.Extension.Presentation.Basic
public import Mathlib.RingTheory.Jacobson.Ring

/-!
# Presentations centred at a rational maximal ideal

A presentation of an algebra `A` over a ring `R` is a surjection from a polynomial ring onto
`A` together with generators of its kernel; the images `P.val i` of the variables are the
generators of `A`.  Nothing forces those images to lie in a prescribed ideal `p` of `A`, and
several criteria read off a presentation — the Jacobian criterion for smoothness, the
description of the first Fitting ideal of `Ω_{A/R}` by the minors of the Jacobian matrix —
require exactly that, since they compare the Jacobian matrix at `p` with the cotangent space
there.  Translating the variables by constants arranges it, as soon as every element of `A` is
congruent modulo `p` to one coming from `R`.

## Main definitions

* `Algebra.Generators.translate` and `Algebra.Presentation.translate` — the generators, resp.
  the presentation, obtained by subtracting a constant from each generator.

## Main results

* `Algebra.Presentation.exists_centred_of_surjective_algebraMap_quotient` — a finite type
  algebra over a Noetherian ring whose quotient by `p` is generated by the image of the base
  ring admits a presentation, by finitely many generators and finitely many relations, all of
  whose generators lie in `p`.
* `Algebra.Presentation.exists_centred_of_isAlgClosed` — the case of a maximal ideal of a
  finite type algebra over an algebraically closed field, where the hypothesis is automatic by
  Zariski's lemma.

## Implementation notes

The translation is the `R`-algebra automorphism `τ` of `MvPolynomial ι R` sending `X i` to
`X i + C (c i)`.  Evaluation at the translated generators, precomposed with `τ`, is evaluation
at the original ones, so the section and the relations of the translated presentation are the
images under `τ` of those of the original, and its kernel is the image of the original kernel.

Finiteness of the two index types comes from `Algebra.Presentation.ofFinitePresentation`, whose
hypothesis `Algebra.FinitePresentation` follows from `Algebra.FiniteType` over a Noetherian
ring.
-/

@[expose] public noncomputable section

open MvPolynomial

universe u v w t

namespace Algebra

variable {R : Type u} {S : Type v} {ι : Type w} {σ : Type t}
  [CommRing R] [CommRing S] [Algebra R S]

/-! ### Translating the variables of a polynomial ring -/

/-- The `R`-algebra automorphism of `MvPolynomial ι R` sending `X i` to `X i + C (c i)`. -/
def mvPolynomialShift (R : Type u) [CommRing R] {ι : Type w} (c : ι → R) :
    MvPolynomial ι R ≃ₐ[R] MvPolynomial ι R :=
  AlgEquiv.ofAlgHom (aeval fun i => X i + C (c i)) (aeval fun i => X i - C (c i))
    (by ext i; simp) (by ext i; simp)

/-- The translation `mvPolynomialShift R c` sends `X i` to `X i + C (c i)`. -/
@[simp]
theorem mvPolynomialShift_X (c : ι → R) (i : ι) :
    mvPolynomialShift R c (X i) = X i + C (c i) := by
  simp [mvPolynomialShift]

/-- Evaluation at generators translated by `c`, precomposed with the translation, is evaluation
at the original generators. -/
theorem aeval_sub_comp_mvPolynomialShift (c : ι → R) (v : ι → S) :
    (aeval fun i => v i - algebraMap R S (c i)).comp
        (mvPolynomialShift R c).toAlgHom = aeval v := by
  ext i
  simp

/-! ### Translating the generators of a presentation -/

/-- Translate a family of generators by constants: the generators of `S` whose `i`-th member is
`P.val i - c i`. -/
def Generators.translate (P : Generators R S ι) (c : ι → R) : Generators R S ι where
  val i := P.val i - algebraMap R S (c i)
  σ' s := mvPolynomialShift R c (P.σ' s)
  aeval_val_σ' s := by
    have h := congrArg (fun φ : MvPolynomial ι R →ₐ[R] S => φ (P.σ' s))
      (aeval_sub_comp_mvPolynomialShift c P.val)
    simp only [AlgHom.comp_apply] at h
    exact h.trans (P.aeval_val_σ' s)

/-- The `i`-th translated generator is `P.val i - c i`. -/
@[simp]
theorem Generators.translate_val (P : Generators R S ι) (c : ι → R) (i : ι) :
    (P.translate c).val i = P.val i - algebraMap R S (c i) := rfl

/-- Evaluating at translated generators after translating is evaluating at the original
generators. -/
theorem aeval_sub_mvPolynomialShift (c : ι → R) (v : ι → S) (f : MvPolynomial ι R) :
    aeval (fun i => v i - algebraMap R S (c i)) (mvPolynomialShift R c f) = aeval v f := by
  have h := congrArg (fun φ : MvPolynomial ι R →ₐ[R] S => φ f)
    (aeval_sub_comp_mvPolynomialShift c v)
  simpa only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom] using h

/-- Evaluating at the translated generators after translating is evaluating at the original
generators. -/
theorem Generators.aeval_translate_val (P : Generators R S ι) (c : ι → R)
    (f : MvPolynomial ι R) :
    aeval (P.translate c).val (mvPolynomialShift R c f) = aeval P.val f :=
  aeval_sub_mvPolynomialShift c P.val f

/-- The kernel of a translated family of generators is the image of the original kernel under
the translation. -/
theorem Generators.ker_translate (P : Generators R S ι) (c : ι → R) :
    (P.translate c).ker = Ideal.map (mvPolynomialShift R c) P.ker := by
  refine le_antisymm (fun f hf => ?_) ?_
  · rw [Generators.ker_eq_ker_aeval_val, RingHom.mem_ker] at hf
    have hmem : (mvPolynomialShift R c).symm f ∈ P.ker := by
      rw [Generators.ker_eq_ker_aeval_val, RingHom.mem_ker,
        ← Generators.aeval_translate_val P c ((mvPolynomialShift R c).symm f),
        AlgEquiv.apply_symm_apply]
      exact hf
    have := Ideal.mem_map_of_mem (mvPolynomialShift R c) hmem
    rwa [AlgEquiv.apply_symm_apply] at this
  · rw [Ideal.map_le_iff_le_comap]
    intro g hg
    rw [Generators.ker_eq_ker_aeval_val, RingHom.mem_ker] at hg
    rw [Ideal.mem_comap, Generators.ker_eq_ker_aeval_val, RingHom.mem_ker,
      Generators.aeval_translate_val P c g]
    exact hg

/-- Translate the generators of a presentation by constants. -/
def Presentation.translate (P : Presentation R S ι σ) (c : ι → R) : Presentation R S ι σ where
  toGenerators := P.toGenerators.translate c
  relation j := mvPolynomialShift R c (P.relation j)
  span_range_relation_eq_ker := by
    rw [Generators.ker_translate, ← P.span_range_relation_eq_ker, Ideal.map_span,
      ← Set.range_comp]
    rfl

/-- The `i`-th generator of the translated presentation is `P.val i - c i`. -/
@[simp]
theorem Presentation.translate_val (P : Presentation R S ι σ) (c : ι → R) (i : ι) :
    (P.translate c).val i = P.val i - algebraMap R S (c i) := rfl

/-! ### Existence of a centred presentation -/

/-- **A finite type algebra over a Noetherian ring has a presentation, by finitely many
generators and finitely many relations, whose generators all lie in a given ideal `p`, provided
every element of `A ⧸ p` comes from the base ring.** -/
theorem Presentation.exists_centred_of_surjective_algebraMap_quotient
    (R : Type u) (A : Type v) [CommRing R] [IsNoetherianRing R] [CommRing A] [Algebra R A]
    [Algebra.FiniteType R A] (p : Ideal A)
    (hsurj : Function.Surjective (algebraMap R (A ⧸ p))) :
    ∃ (n m : ℕ) (P : Algebra.Presentation R A (Fin n) (Fin m)), ∀ i, P.val i ∈ p := by
  have : Algebra.FinitePresentation R A :=
    Algebra.FinitePresentation.of_finiteType.mp inferInstance
  set P₀ := Algebra.Presentation.ofFinitePresentation R A with hP₀
  choose c hc using fun i => hsurj (Ideal.Quotient.mk p (P₀.val i))
  refine ⟨_, _, P₀.translate c, fun i => ?_⟩
  have hmk : (Ideal.Quotient.mk p) (algebraMap R A (c i)) = algebraMap R (A ⧸ p) (c i) := by
    rw [IsScalarTower.algebraMap_apply R A (A ⧸ p), Ideal.Quotient.algebraMap_eq]
  rw [Presentation.translate_val, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, hmk, hc i,
    sub_self]

/-- **A finite type algebra over an algebraically closed field has a presentation whose
generators all lie in a given maximal ideal.** -/
theorem Presentation.exists_centred_of_isAlgClosed
    (K : Type u) (A : Type v) [Field K] [IsAlgClosed K] [CommRing A] [Algebra K A]
    [Algebra.FiniteType K A] (p : Ideal A) [p.IsMaximal] :
    ∃ (n m : ℕ) (P : Algebra.Presentation K A (Fin n) (Fin m)), ∀ i, P.val i ∈ p := by
  let : Field (A ⧸ p) := Ideal.Quotient.field p
  have : Algebra.FiniteType K (A ⧸ p) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K p) Ideal.Quotient.mk_surjective
  have : Module.Finite K (A ⧸ p) := finite_of_finite_type_of_isJacobsonRing K (A ⧸ p)
  have hint : (algebraMap K (A ⧸ p)).IsIntegral :=
    Algebra.isIntegral_def.mp (Algebra.IsIntegral.of_finite K (A ⧸ p))
  exact Presentation.exists_centred_of_surjective_algebraMap_quotient K A p
    (IsAlgClosed.ringHom_bijective_of_isIntegral _ hint).2

end Algebra

end
