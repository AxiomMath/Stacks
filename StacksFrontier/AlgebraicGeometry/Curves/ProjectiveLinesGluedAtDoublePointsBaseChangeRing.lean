module

public import StacksFrontier.AlgebraicGeometry.Curves.ProjectiveLinesGluedAtDoublePoints

/-!
# Base change of the three double points

Let `R` be a ring and `a₀, a₁, a₂ ∈ R` with pairwise differences units. The reduction
`R[t] ⟶ ∏ᵢ R[t]/(t - aᵢ)²` is surjective (Chinese remainder theorem), and its kernel is generated
by `∏ᵢ (t - aᵢ)²`. For a ring map `R ⟶ S`, the reduction over `S` at the images of the points is
therefore the base change of the reduction over `R`: the square

```
R[t] ──→ ∏ᵢ R[t]/(t - aᵢ)²
 │                │
 ↓                ↓
S[t] ──→ ∏ᵢ S[t]/(t - aᵢ)²
```

is a pushout of commutative rings. Geometrically, the three double points over `S` are the
preimage of the three double points over `R` in the affine line.

For an element `c` with `2 = 0` and `c² = 0`, the translation `t ↦ t + c` preserves each ideal
`((t - a)²)`, so it induces an endomorphism of the three double points.

## Main definitions

* `AlgebraicGeometry.doublePointsMap`: the map `∏ᵢ R[t]/(t - aᵢ)² ⟶ ∏ᵢ S[t]/(t - aᵢ)²`.
* `AlgebraicGeometry.doublePointsTranslate`: the substitution `t ↦ t + c` on
  `∏ᵢ R[t]/(t - aᵢ)²`.

## Main results

* `AlgebraicGeometry.doublePointsMk_surjective_of_isUnit`: the Chinese remainder theorem.
* `AlgebraicGeometry.doublePointsMk_eq_zero_iff`: the kernel of the reduction.
* `AlgebraicGeometry.isPushout_doublePointsMk`: **the reduction over `S` is the base change of the
  reduction over `R`.**

## References

* [Stacks Project, Tag 0DSU](https://stacks.math.columbia.edu/tag/0DSU)
-/

@[expose] public section

noncomputable section

open CategoryTheory Limits Polynomial

namespace AlgebraicGeometry

universe u

section Ring

variable {R : Type u} [CommRing R]

/-- The squares `(t - a)²` and `(t - b)²` are coprime when `b - a` is a unit. -/
theorem isCoprime_sq_X_sub_C {a b : R} (h : IsUnit (b - a)) :
    IsCoprime ((X - C a) ^ 2 : R[X]) ((X - C b) ^ 2) := by
  obtain ⟨u, hu⟩ := h
  refine IsCoprime.pow ⟨C (↑u⁻¹ : R), -C (↑u⁻¹ : R), ?_⟩
  have e : (C (↑u⁻¹ : R) : R[X]) * (X - C a) + -C (↑u⁻¹ : R) * (X - C b) =
      C ((↑u⁻¹ : R) * (b - a)) := by
    rw [map_mul, map_sub]
    ring
  rw [e, ← hu, Units.inv_mul, map_one]

variable (pts : Fin 3 → R)

/-- **The Chinese remainder theorem** for the three double points, when the pairwise differences
of the points are units. -/
theorem doublePointsMk_surjective_of_isUnit (h : ∀ i j, i ≠ j → IsUnit (pts j - pts i)) :
    Function.Surjective (doublePointsMk pts) := by
  intro g
  have hc : Pairwise (Function.onFun IsCoprime fun i ↦ doublePointIdeal (pts i)) :=
    fun i j hij ↦ (Ideal.isCoprime_span_singleton_iff _ _).2 (isCoprime_sq_X_sub_C (h i j hij))
  obtain ⟨y, hy⟩ := Ideal.quotientInfToPiQuotient_surj hc g
  obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective y
  exact ⟨x, by rw [← hy, ← hx]; rfl⟩

/-- The `i`-th component of the reduction of `g` vanishes iff `(t - aᵢ)²` divides `g`. -/
private theorem doublePointsMk_apply_eq_zero_iff (g : R[X]) (i : Fin 3) :
    doublePointsMk pts g i = 0 ↔ (X - C (pts i)) ^ 2 ∣ g := by
  rw [doublePointsMk_apply, Ideal.Quotient.eq_zero_iff_mem, doublePointIdeal,
    Ideal.mem_span_singleton]

/-- **The kernel of the reduction** is generated by `∏ᵢ (t - aᵢ)²`. -/
theorem doublePointsMk_eq_zero_iff (h : ∀ i j, i ≠ j → IsUnit (pts j - pts i)) (g : R[X]) :
    doublePointsMk pts g = 0 ↔ (∏ i, (X - C (pts i)) ^ 2) ∣ g := by
  have hmem := doublePointsMk_apply_eq_zero_iff pts g
  exact ⟨fun hg ↦ Fintype.prod_dvd_of_coprime (fun i j hij ↦ isCoprime_sq_X_sub_C (h i j hij))
      fun i ↦ (hmem i).1 (congrFun hg i),
    fun hg ↦ funext fun i ↦ (hmem i).2 ((Finset.dvd_prod_of_mem (fun j ↦ (X - C (pts j)) ^ 2)
      (Finset.mem_univ i)).trans hg)⟩

/-- The product `∏ᵢ (t - aᵢ)²` reduces to zero. -/
theorem doublePointsMk_prod : doublePointsMk pts (∏ i, (X - C (pts i)) ^ 2) = 0 := by
  funext i
  exact (doublePointsMk_apply_eq_zero_iff pts _ i).2
    (Finset.dvd_prod_of_mem (fun j ↦ (X - C (pts j)) ^ 2) (Finset.mem_univ i))

end Ring

section BaseChange

variable {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S) (pts : Fin 3 → R)

/-- The ring map `R[t] ⟶ S[t]` induced by `R ⟶ S` sends `((t - a)²)` into `((t - f(a))²)`. -/
theorem doublePointIdeal_le_comap (a : R) :
    doublePointIdeal a ≤ (doublePointIdeal (f a)).comap (mapRingHom f) := by
  rw [doublePointIdeal, Ideal.span_le, Set.singleton_subset_iff]
  exact Ideal.subset_span (by simp)

/-- The map `∏ᵢ R[t]/(t - aᵢ)² ⟶ ∏ᵢ S[t]/(t - aᵢ)²` induced by `R ⟶ S`. -/
def doublePointsMap : DoublePoints pts →+* DoublePoints (f ∘ pts) :=
  RingHom.pi fun i ↦ (Ideal.quotientMap (doublePointIdeal (f (pts i))) (mapRingHom f)
    (doublePointIdeal_le_comap f (pts i))).comp (Pi.evalRingHom _ i)

/-- The square of reductions `R[t] ⟶ ∏ᵢ R[t]/(t - aᵢ)²` and `S[t] ⟶ ∏ᵢ S[t]/(t - aᵢ)²`
commutes. -/
theorem doublePointsMap_comp_doublePointsMk :
    (doublePointsMap f pts).comp (doublePointsMk pts) =
      (doublePointsMk (f ∘ pts)).comp (mapRingHom f) :=
  RingHom.ext fun g ↦ funext fun i ↦ by
    simp [doublePointsMap, doublePointsMk, Ideal.quotientMap_mk]

/-- `doublePointsMap` sends the reduction of `g ∈ R[t]` to the reduction of its image in `S[t]`. -/
theorem doublePointsMap_doublePointsMk (g : R[X]) :
    doublePointsMap f pts (doublePointsMk pts g) = doublePointsMk (f ∘ pts) (g.map f) :=
  congrArg (· g) (doublePointsMap_comp_doublePointsMk f pts)

/-- **The reduction over `S` is the base change of the reduction over `R`.** -/
theorem isPushout_doublePointsMk (h : ∀ i j, i ≠ j → IsUnit (pts j - pts i)) :
    IsPushout (CommRingCat.ofHom (doublePointsMk pts)) (CommRingCat.ofHom (mapRingHom f))
      (CommRingCat.ofHom (doublePointsMap f pts))
      (CommRingCat.ofHom (doublePointsMk (f ∘ pts))) := by
  have hS : ∀ i j, i ≠ j → IsUnit ((f ∘ pts) j - (f ∘ pts) i) := fun i j hij ↦ by
    simpa using (h i j hij).map f
  have hsurjR := doublePointsMk_surjective_of_isUnit pts h
  have hsurjS := doublePointsMk_surjective_of_isUnit (f ∘ pts) hS
  have w : CommRingCat.ofHom (doublePointsMk pts) ≫ CommRingCat.ofHom (doublePointsMap f pts) =
      CommRingCat.ofHom (mapRingHom f) ≫ CommRingCat.ofHom (doublePointsMk (f ∘ pts)) := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, doublePointsMap_comp_doublePointsMk]
  refine ⟨⟨w⟩, ⟨PushoutCocone.IsColimit.mk w (fun s ↦ CommRingCat.ofHom
    ((doublePointsMk (f ∘ pts)).liftOfSurjective hsurjS ⟨s.inr.hom, ?_⟩)) ?_ ?_ ?_⟩⟩
  · intro g hg
    rw [RingHom.mem_ker] at hg ⊢
    obtain ⟨r, rfl⟩ := (doublePointsMk_eq_zero_iff (f ∘ pts) hS g).1 hg
    have hP : (∏ i, (X - C ((f ∘ pts) i)) ^ 2 : S[X]) =
        mapRingHom f (∏ i, (X - C (pts i)) ^ 2) := by
      rw [map_prod]
      exact Finset.prod_congr rfl fun i _ ↦ by simp
    have hs := congrArg (fun φ : CommRingCat.of R[X] ⟶ s.pt ↦ φ.hom (∏ i, (X - C (pts i)) ^ 2))
      s.condition
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
      doublePointsMk_prod, map_zero] at hs
    rw [map_mul, hP, ← hs, zero_mul]
  · intro s
    refine CommRingCat.hom_ext (RingHom.ext fun x ↦ ?_)
    obtain ⟨g, rfl⟩ := hsurjR x
    have hs := congrArg (fun φ : CommRingCat.of R[X] ⟶ s.pt ↦ φ.hom g) s.condition
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at hs ⊢
    rw [doublePointsMap_doublePointsMk]
    exact (RingHom.liftOfSurjective_comp_apply _ hsurjS _ (g.map f)).trans hs.symm
  · intro s
    refine CommRingCat.hom_ext (RingHom.ext fun x ↦ ?_)
    exact RingHom.liftOfSurjective_comp_apply _ hsurjS _ x
  · intro s m _ hm
    refine CommRingCat.hom_ext (RingHom.ext fun x ↦ ?_)
    obtain ⟨g, rfl⟩ := hsurjS x
    have := congrArg (fun φ : CommRingCat.of S[X] ⟶ s.pt ↦ φ.hom g) hm
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this ⊢
    rwa [RingHom.liftOfSurjective_comp_apply]

end BaseChange

section Translate

variable {R : Type u} [CommRing R] (pts : Fin 3 → R) {c : R}

/-- For `2 = 0` and `c² = 0`, the translation `t ↦ t + c` preserves the ideal `((t - a)²)`. -/
theorem doublePointIdeal_le_comap_translate (h2 : (2 : R) = 0) (hc : c * c = 0) (a : R) :
    doublePointIdeal a ≤ (doublePointIdeal a).comap (translate c).toRingHom :=
  fun _ hf ↦ translate_mem_doublePointIdeal h2 hc hf

/-- **The translation `t ↦ t + c` of the three double points**, for `2 = 0` and `c² = 0`. -/
def doublePointsTranslate (h2 : (2 : R) = 0) (hc : c * c = 0) :
    DoublePoints pts →+* DoublePoints pts :=
  RingHom.pi fun i ↦ (Ideal.quotientMap (doublePointIdeal (pts i)) (translate c).toRingHom
    (doublePointIdeal_le_comap_translate h2 hc (pts i))).comp (Pi.evalRingHom _ i)

/-- The translation `t ↦ t + c` commutes with the reduction `R[t] ⟶ ∏ᵢ R[t]/(t - aᵢ)²`. -/
theorem doublePointsTranslate_comp_doublePointsMk (h2 : (2 : R) = 0) (hc : c * c = 0) :
    (doublePointsTranslate pts h2 hc).comp (doublePointsMk pts) =
      (doublePointsMk pts).comp (translate c).toRingHom :=
  RingHom.ext fun g ↦ funext fun i ↦ by
    simp [doublePointsTranslate, doublePointsMk, Ideal.quotientMap_mk]

end Translate

end AlgebraicGeometry
