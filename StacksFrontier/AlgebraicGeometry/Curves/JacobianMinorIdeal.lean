/-!
# Independence of the Jacobian ideal

For a quotient of a multivariate power-series ring, the ideal generated by the
minors of a Jacobian matrix does not depend on either the chosen finite set of
generators of the kernel or the chosen regular system of parameters.

## Main definitions

* `Stacks.Curves.jacobianMinorIdealModulo` is the ideal of Jacobian minors in the quotient.
* `Stacks.Curves.powerSeriesCoordinateEquiv` is the coordinate automorphism associated to a
  regular system of parameters.
* `Stacks.Curves.jacobianMinorIdealModuloInParameters` is the same ideal computed in a
  regular system of parameters.

## Main results

* `Stacks.Curves.jacobianMinorIdealModulo_eq` proves independence of generators and
  regular parameters.

## Implementation notes

The regular system of parameters is a basis of the cotangent space, as in Tag 07NM.
The formal inverse function theorem there identifies its canonical substitution map
with a `k`-algebra automorphism. Differentiation in the new parameters is conjugation
of the standard formal partial derivatives by this canonical automorphism. Thus both
Jacobian ideals are ideals in the same fixed quotient ring.

The four matrix lemmas the argument needs — that the ideal of minors is invariant under
transposition, is only shrunk by a rectangular left or right factor, and commutes with a ring
homomorphism — are the Stacks 07Z7 material already proved in
`StacksFrontier.AlgebraicGeometry.Curves.JacobianCriterion`, and are used from there.

## References

* [Stacks Project, Tag 0C4B](https://stacks.math.columbia.edu/tag/0C4B)
-/

@[expose] public section

namespace Stacks.Curves

open _root_.MvPowerSeries
open scoped _root_.MvPowerSeries.WithPiTopology

/-- Two matrices each of which is a right multiple of the other have the same ideal of
`r × r` minors. -/
private theorem minorIdeal_eq_of_matrix_factors {R : Type*} [CommRing R]
    {n m l : ℕ} (A : Matrix (Fin n) (Fin m) R) (B : Matrix (Fin n) (Fin l) R)
    (C : Matrix (Fin m) (Fin l) R) (D : Matrix (Fin l) (Fin m) R) (r : ℕ)
    (hB : B = A * C) (hA : A = B * D) : minorIdeal A r = minorIdeal B r := by
  apply le_antisymm
  · rw [hA]
    exact minorIdeal_mul_rect_right_le B D r
  · rw [hB]
    exact minorIdeal_mul_rect_right_le A C r

universe u v w

variable {k : Type u} [Field k]

/-- Formal partial differentiation is continuous for the product topology on power series
over a discrete coefficient ring. -/
private theorem continuous_pderiv {n : ℕ} [TopologicalSpace k] [DiscreteTopology k]
    (i : Fin n) :
    Continuous (pderiv (R := k) i : MvPowerSeries (Fin n) k → MvPowerSeries (Fin n) k) := by
  classical
  refine continuous_pi_iff.mpr fun d => ?_
  show Continuous (fun f : MvPowerSeries (Fin n) k => coeff d (pderiv (R := k) i f))
  have heq : (fun f : MvPowerSeries (Fin n) k => coeff d (pderiv (R := k) i f)) =
      fun f : MvPowerSeries (Fin n) k =>
        coeff (d + Finsupp.single i (1 : ℕ)) f * ((d i + 1 : ℕ) : k) := by
    funext f
    simpa [Nat.cast_add] using (coeff_pderiv (R := k) (i := i) f d)
  rw [heq]
  exact (WithPiTopology.continuous_coeff (R := k) (d + Finsupp.single i 1)).mul
    continuous_const

/-- The chain rule for substitution into a polynomial. -/
private theorem pderiv_subst_chain_poly {n : ℕ}
    (a : Fin n → MvPowerSeries (Fin n) k) (i : Fin n)
    (p : MvPolynomial (Fin n) k) :
    pderiv (R := k) i (MvPolynomial.aeval a p) =
      ∑ j, MvPolynomial.aeval a (MvPolynomial.pderiv j p) * pderiv (R := k) i (a j) := by
  classical
  induction p using MvPolynomial.induction_on with
  | C c => simp
  | add p q hp hq => simp [hp, hq, Finset.sum_add_distrib, add_mul]
  | mul_X p j hp =>
      rw [map_mul, MvPolynomial.aeval_X, (pderiv (R := k) i).leibniz]
      simp only [MvPolynomial.pderiv_mul, map_add, map_mul, MvPolynomial.aeval_X, smul_eq_mul]
      have hx (x : Fin n) : MvPolynomial.aeval (R := k) a
          (MvPolynomial.pderiv (R := k) x (MvPolynomial.X (R := k) j)) =
          if x = j then 1 else 0 := by
        by_cases h : x = j
        · subst x; simp
        · simp [h, MvPolynomial.pderiv_X_of_ne (Ne.symm h)]
      simp_rw [add_mul, hx]
      rw [Finset.sum_add_distrib]
      have hsum₁ : (∑ x : Fin n,
          (MvPolynomial.aeval a (MvPolynomial.pderiv x p) * a j) * pderiv (R := k) i (a x)) =
          (∑ x : Fin n,
            MvPolynomial.aeval a (MvPolynomial.pderiv x p) * pderiv (R := k) i (a x)) * a j := by
        rw [Finset.sum_mul]
        exact Finset.sum_congr rfl fun _ _ => by ring
      have hsum₂ : (∑ x : Fin n,
          (MvPolynomial.aeval a p * (if x = j then 1 else 0)) * pderiv (R := k) i (a x)) =
          MvPolynomial.aeval a p * pderiv (R := k) i (a j) := by
        rw [Finset.sum_eq_single j]
        · simp
        · intro x _ hxj
          simp [hxj]
        · simp
      rw [hsum₁, hsum₂, hp]
      ring

/-- The chain rule for substitution into a power series: it follows from the polynomial case
because the polynomials are dense and both sides are continuous. -/
private theorem pderiv_subst_chain {n : ℕ}
    (a : Fin n → MvPowerSeries (Fin n) k) (ha : HasSubst a) (i : Fin n)
    (f : MvPowerSeries (Fin n) k) :
    pderiv (R := k) i (subst a f) =
      ∑ j, subst a (pderiv (R := k) j f) * pderiv (R := k) i (a j) := by
  classical
  let : UniformSpace k := ⊥
  let : DiscreteUniformity k := ⟨rfl⟩
  let : TopologicalSpace k := ⊥
  let : DiscreteTopology k := ⟨rfl⟩
  have hcontR : Continuous (fun z : MvPowerSeries (Fin n) k =>
      ∑ j, subst a (pderiv (R := k) j z) * pderiv (R := k) i (a j)) :=
    continuous_finsetSum _ fun j _ =>
      ((continuous_subst ha).comp (continuous_pderiv j)).mul continuous_const
  have hpoly : (fun z : MvPowerSeries (Fin n) k => pderiv (R := k) i (subst a z)) ∘
      MvPolynomial.toMvPowerSeries =
      (fun z => ∑ j, subst a (pderiv (R := k) j z) * pderiv (R := k) i (a j)) ∘
        MvPolynomial.toMvPowerSeries := by
    funext p
    show pderiv (R := k) i (subst a (MvPolynomial.toMvPowerSeries p)) =
      ∑ j, subst a (pderiv (R := k) j (MvPolynomial.toMvPowerSeries p)) * pderiv (R := k) i (a j)
    rw [subst_coe]
    simp only [pderiv_coe, subst_coe]
    exact pderiv_subst_chain_poly (k := k) a i p
  exact congrFun ((WithPiTopology.denseRange_toMvPowerSeries (R := k)).equalizer
    ((continuous_pderiv i).comp (continuous_subst ha)) hcontR hpoly) f

/-- The ideal in `k[[x_i]] / I` generated by the `r × r` minors of the Jacobian
matrix of a family `f` of generators. -/
noncomputable def jacobianMinorIdealModulo {σ : Type v} {τ : Type w}
    (I : Ideal (MvPowerSeries σ k)) (f : τ → MvPowerSeries σ k) (r : ℕ) :
    Ideal (MvPowerSeries σ k ⧸ I) :=
  (minorIdeal (fun i j ↦ pderiv (R := k) i (f j)) r).map (Ideal.Quotient.mk I)

private theorem jacobianMinorIdealModulo_eq_quotientMatrix {n m : ℕ}
    (I : Ideal (MvPowerSeries (Fin n) k)) (f : Fin m → MvPowerSeries (Fin n) k) (r : ℕ) :
    jacobianMinorIdealModulo I f r =
      minorIdeal (fun i j => Ideal.Quotient.mk I (pderiv (R := k) i (f j))) r := by
  unfold jacobianMinorIdealModulo
  show (minorIdeal (Matrix.of fun i j => pderiv (R := k) i (f j)) r).map (Ideal.Quotient.mk I) =
    minorIdeal (Matrix.of fun i j => Ideal.Quotient.mk I (pderiv (R := k) i (f j))) r
  rw [minorIdeal_map_matrix]
  rfl

private theorem exists_quotient_jacobian_factor {n m l : ℕ}
    (I : Ideal (MvPowerSeries (Fin n) k))
    (f : Fin m → MvPowerSeries (Fin n) k) (g : Fin l → MvPowerSeries (Fin n) k)
    (hf : Ideal.span (Set.range f) = I) (hg : Ideal.span (Set.range g) = I) :
    ∃ C : Matrix (Fin m) (Fin l) (MvPowerSeries (Fin n) k ⧸ I),
      (Matrix.of fun t j => Ideal.Quotient.mk I (pderiv (R := k) t (g j))) =
        (Matrix.of fun t i => Ideal.Quotient.mk I (pderiv (R := k) t (f i))) * C := by
  classical
  let R := MvPowerSeries (Fin n) k
  let Q := R ⧸ I
  have hrepr : ∀ j : Fin l, ∃ c : Fin m → R, ∑ i, c i * f i = g j := by
    intro j
    apply Ideal.mem_span_range_iff_exists_fun.mp
    rw [hf, ← hg]
    exact Ideal.subset_span ⟨j, rfl⟩
  choose c hc using hrepr
  let C : Matrix (Fin m) (Fin l) Q :=
    Matrix.of fun i j => Ideal.Quotient.mk I (c j i)
  have hentry (t : Fin n) (j : Fin l) :
      Ideal.Quotient.mk I (pderiv (R := k) t (g j)) =
        ∑ i, Ideal.Quotient.mk I (pderiv (R := k) t (f i)) * Ideal.Quotient.mk I (c j i) := by
    rw [← hc j, map_sum, map_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [(pderiv (R := k) t).leibniz]
    simp only [smul_eq_mul, map_add, map_mul]
    rw [(Ideal.Quotient.eq_zero_iff_mem).2 (show f i ∈ I by
      rw [← hf]
      exact Ideal.subset_span ⟨i, rfl⟩)]
    simp [mul_comm]
  refine ⟨C, ?_⟩
  ext t j
  rw [Matrix.mul_apply]
  exact hentry t j

private theorem jacobianMinorIdealModulo_eq_of_generators {n m l : ℕ}
    (I : Ideal (MvPowerSeries (Fin n) k))
    (f : Fin m → MvPowerSeries (Fin n) k) (g : Fin l → MvPowerSeries (Fin n) k)
    (hf : Ideal.span (Set.range f) = I) (hg : Ideal.span (Set.range g) = I) (r : ℕ) :
    jacobianMinorIdealModulo I f r = jacobianMinorIdealModulo I g r := by
  classical
  obtain ⟨C, hB⟩ := exists_quotient_jacobian_factor I f g hf hg
  obtain ⟨D, hA⟩ := exists_quotient_jacobian_factor I g f hg hf
  rw [jacobianMinorIdealModulo_eq_quotientMatrix,
    jacobianMinorIdealModulo_eq_quotientMatrix]
  exact minorIdeal_eq_of_matrix_factors _ _ C D r hB hA

/-- The canonical coordinate automorphism associated to a regular system of parameters
`y`. It sends the standard variable `X i` to the underlying power series of `y i`. -/
noncomputable def powerSeriesCoordinateEquiv {n : ℕ}
    (y : Fin n → IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) k))
    (hy : IsRegularSystemOfParameters y) :
    MvPowerSeries (Fin n) k ≃ₐ[k] MvPowerSeries (Fin n) k :=
  AlgEquiv.ofBijective
    (MvPowerSeries.substAlgHom (Stacks.MvPowerSeries.RegularParameters.hasSubst_of_mem_maximalIdeal
      y))
    (main_theorem_one k n y hy).2

/-- The Jacobian-minor ideal computed with respect to a regular system of parameters
`y`. Differentiation with respect to `y i` is the conjugate of `pderiv (R := k) i` by the
canonical coordinate automorphism carrying `X i` to `y i`. -/
noncomputable def jacobianMinorIdealModuloInParameters {n : ℕ} {τ : Type w}
    (I : Ideal (MvPowerSeries (Fin n) k))
    (y : Fin n → IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) k))
    (hy : IsRegularSystemOfParameters y)
    (f : τ → MvPowerSeries (Fin n) k) (r : ℕ) :
    Ideal (MvPowerSeries (Fin n) k ⧸ I) :=
  let e := powerSeriesCoordinateEquiv y hy
  (minorIdeal (fun i j ↦ e (pderiv (R := k) i (e.symm (f j)))) r).map (Ideal.Quotient.mk I)

private theorem jacobianMinorIdealModuloInParameters_eq_quotientMatrix {n m : ℕ}
    (I : Ideal (MvPowerSeries (Fin n) k))
    (y : Fin n → IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) k))
    (hy : IsRegularSystemOfParameters y) (f : Fin m → MvPowerSeries (Fin n) k) (r : ℕ) :
    jacobianMinorIdealModuloInParameters I y hy f r =
      minorIdeal (Matrix.of fun i j =>
        Ideal.Quotient.mk I
          ((powerSeriesCoordinateEquiv y hy)
            (pderiv (R := k) i ((powerSeriesCoordinateEquiv y hy).symm (f j))))) r := by
  unfold jacobianMinorIdealModuloInParameters
  show (minorIdeal (Matrix.of fun i j =>
      (powerSeriesCoordinateEquiv y hy)
        (pderiv (R := k) i ((powerSeriesCoordinateEquiv y hy).symm (f j)))) r).map
        (Ideal.Quotient.mk I) = _
  rw [minorIdeal_map_matrix]
  rfl

private theorem jacobianMinorIdealModuloInParameters_eq {n m : ℕ}
    (I : Ideal (MvPowerSeries (Fin n) k))
    (y : Fin n → IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) k))
    (hy : IsRegularSystemOfParameters y) (g : Fin m → MvPowerSeries (Fin n) k)
    (r : ℕ) :
    jacobianMinorIdealModuloInParameters I y hy g r = jacobianMinorIdealModulo I g r := by
  classical
  let R := MvPowerSeries (Fin n) k
  let Q := R ⧸ I
  let y' : Fin n → R := fun i => (y i : R)
  have hySub : HasSubst y' := Stacks.MvPowerSeries.RegularParameters.hasSubst_of_mem_maximalIdeal y
  obtain ⟨b, hb0, hkey⟩ := Stacks.MvPowerSeries.RegularParameters.exists_right_inverse_subst_field y
    hy
  have hb : HasSubst b := hasSubst_of_constantCoeff_zero hb0
  let e := powerSeriesCoordinateEquiv y hy
  have he_apply (z : R) : e z = subst y' z := by
    show MvPowerSeries.substAlgHom hySub z = subst y' z
    exact MvPowerSeries.substAlgHom_apply hySub z
  have hcomp : (subst y' : R → R) ∘ subst b = id := by
    rw [subst_comp_subst hb hySub]
    have hfamily : (fun i => subst y' (b i)) = (X : Fin n → R) := funext hkey
    rw [hfamily, subst_self]
  have he_subst_b (z : R) : e (subst b z) = z := by
    simpa [he_apply] using congrFun hcomp z
  have hsymm (z : R) : e.symm z = subst b z := by
    apply e.injective
    rw [e.apply_symm_apply, he_subst_b]
  let E : Matrix (Fin n) (Fin n) R :=
    Matrix.of fun i j => e (pderiv (R := k) i (b j))
  let J : Matrix (Fin n) (Fin n) R :=
    Matrix.of fun i j => pderiv (R := k) i (y' j)
  have hJE : J * E = 1 := by
    funext i
    funext j
    rw [Matrix.mul_apply]
    have h := pderiv_subst_chain (k := k) y' hySub i (b j)
    rw [hkey j] at h
    simpa [E, J, he_apply, MvPowerSeries.pderiv_X, Matrix.one_apply, Pi.single_apply,
      eq_comm, mul_comm, mul_left_comm, mul_assoc]
      using h.symm
  have hdetE : IsUnit E.det := Matrix.isUnit_det_of_left_inverse hJE
  have hparameterMatrix (i : Fin n) (j : Fin m) :
      e (pderiv (R := k) i (e.symm (g j))) =
        ∑ l, E i l * pderiv (R := k) l (g j) := by
    have h := pderiv_subst_chain (k := k) b hb i (g j)
    calc
      e (pderiv (R := k) i (e.symm (g j))) = e (pderiv (R := k) i (subst b (g j))) := by rw [hsymm]
      _ = e (∑ l, subst b (pderiv (R := k) l (g j)) * pderiv (R := k) i (b l)) :=
        congrArg e h
      _ = ∑ l, e (subst b (pderiv (R := k) l (g j))) * e (pderiv (R := k) i (b l)) := by
        simp only [map_sum, map_mul]
      _ = ∑ l, E i l * pderiv (R := k) l (g j) := by
        apply Finset.sum_congr rfl
        intro l hl
        rw [he_subst_b]
        simp [E, mul_comm]
  let A : Matrix (Fin n) (Fin m) Q :=
    Matrix.of fun i j => Ideal.Quotient.mk I (pderiv (R := k) i (g j))
  let B : Matrix (Fin n) (Fin m) Q :=
    Matrix.of fun i j => Ideal.Quotient.mk I (e (pderiv (R := k) i (e.symm (g j))))
  let C : Matrix (Fin n) (Fin n) Q := E.map (Ideal.Quotient.mk I)
  have hB : B = C * A := by
    ext i j
    rw [Matrix.mul_apply]
    have h := congrArg (Ideal.Quotient.mk I) (hparameterMatrix i j)
    simpa [A, B, C, map_sum, map_mul, Matrix.mul_apply] using h
  have hC : IsUnit C.det := by
    exact (RingHom.map_det (Ideal.Quotient.mk I) E).symm ▸ hdetE.map (Ideal.Quotient.mk I)
  rw [jacobianMinorIdealModuloInParameters_eq_quotientMatrix,
    jacobianMinorIdealModulo_eq_quotientMatrix]
  show minorIdeal B r = minorIdeal A r
  rw [hB, minorIdeal_mul_left_eq C hC A r]

/-- The ideal of Jacobian minors in a quotient of a finite-variable formal power-series
ring is independent of both the finite family generating the defining ideal and the
regular system of parameters used to form the Jacobian matrix. -/
@[stacks 0C4B]
theorem jacobianMinorIdealModulo_eq {n m l : ℕ}
    (I : Ideal (MvPowerSeries (Fin n) k))
    (f : Fin m → MvPowerSeries (Fin n) k) (g : Fin l → MvPowerSeries (Fin n) k)
    (hf : Ideal.span (Set.range f) = I) (hg : Ideal.span (Set.range g) = I)
    (y : Fin n → IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) k))
    (hy : IsRegularSystemOfParameters y) (r : ℕ) :
    jacobianMinorIdealModulo I f r = jacobianMinorIdealModuloInParameters I y hy g r :=
  (jacobianMinorIdealModulo_eq_of_generators I f g hf hg r).trans
    (jacobianMinorIdealModuloInParameters_eq I y hy g r).symm

end Stacks.Curves

