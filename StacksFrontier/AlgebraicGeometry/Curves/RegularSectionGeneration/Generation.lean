module

public import StacksFrontier.AlgebraicGeometry.Curves.RegularSectionGeneration.Cohomology

/-!
# Generation of the section ring in degrees one, two and three

This is the second paragraph of the proof of [Stacks, Tag 0E8V]. Let `X` be proper of dimension
at most one over a field, `ℒ` invertible with a regular global section `σ` and `H¹(X, ℒ) = 0`.
There is a global section `t` of `ℒ^{⊗ 2}` which does not vanish on the support of
`quot σ 1 = i_*(ℒ^{⊗ 2}|_Z)` — it lifts a generator of that module, which exists by
[Stacks, Tag 0AYT] (2) — and then every section of `ℒ^{⊗ n+1}`, `n ≥ 3`, is `σ · ρ + t · β` with
`ρ ∈ H⁰(ℒ^{⊗ n})` and `β ∈ H⁰(ℒ^{⊗ n-1})`. Hence the section ring is generated over its
degree-zero part in degrees `1`, `2` and `3`.

## Main results

* `Stacks.RegularSectionGeneration.exists_section_two`: the section `t`.
* `Stacks.RegularSectionGeneration.exists_eq_add`, `mem_grading_eq_add`: the decomposition, on
  morphisms and in the section ring.
* `Stacks.RegularSectionGeneration.adjoin_grading_le_three_eq_top`: **the section ring is
  generated in degrees `1`, `2`, `3`.**

## References

* [Stacks Project, Tag 0E8V](https://stacks.math.columbia.edu/tag/0E8V)
* [Stacks Project, Tag 0AYT](https://stacks.math.columbia.edu/tag/0AYT)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MonoidalCategory
open Stacks.Ample
open Stacks.GradedSections (powSections mulMap mul)
open Stacks.TensorPowers (natTensorPow)

universe u

namespace Stacks.RegularSectionGeneration

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

variable {X : Scheme.{u}}

/-- **A quotient of an invertible module has, at each point of its support, a stalk element
outside `𝔪_x` times the stalk.** The stalk of the quotient is cyclic, generated by the image of a
generator of the stalk of the invertible module, and Nakayama's lemma does the rest. -/
theorem exists_notMem_maximalSmul_of_epi {P Q : X.Modules} [IsInvertibleModule X P]
    (π : P ⟶ Q) [Epi π] {x : X} (hx : x ∈ SheafOfModules.supp Q) :
    ∃ q : TopCat.Presheaf.stalk (C := Ab.{u}) Q.presheaf x,
      q ∉ Stacks.ModuleStalk.maximalSmul Q x := by
  obtain ⟨V, hxV, ⟨tr⟩⟩ := Stacks.SectionProduct.exists_trivialization_at P x
  set v := (P.presheaf.germ V x hxV).hom (Stacks.NonvanishingOpen.basis tr)
  refine ⟨Stacks.ModuleStalk.mapFun π x v, fun hq => ?_⟩
  have htop : (⊤ : Submodule (X.presheaf.stalk x)
      (TopCat.Presheaf.stalk (C := Ab.{u}) Q.presheaf x)) =
      Submodule.span _ {Stacks.ModuleStalk.mapFun π x v} := by
    refine le_antisymm (fun w _ => ?_) le_top
    obtain ⟨z, rfl⟩ := surjStalk_of_epi π x w
    obtain ⟨r, rfl⟩ := Stacks.SectionProduct.exists_smul_germ_basis tr hxV z
    rw [Stacks.ModuleStalk.mapFun_smul]
    exact Submodule.smul_mem _ r (Submodule.subset_span rfl)
  have hle : (⊤ : Submodule (X.presheaf.stalk x)
      (TopCat.Presheaf.stalk (C := Ab.{u}) Q.presheaf x)) ≤
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) • ⊤ :=
    htop.le.trans (Submodule.span_le.2 (Set.singleton_subset_iff.2 hq))
  have hbot := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot
    (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) ⊤
    (htop ▸ Submodule.fg_span_singleton _) hle
    (by rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top])
  obtain ⟨a, ha⟩ := hx
  exact ha ((Submodule.eq_bot_iff _).mp hbot a Submodule.mem_top)

variable (L : X.Modules) [IsInvertibleModule X L] (σ : powSections L 1)

section Proper

variable (k : Type u) [Field k] (f : X ⟶ Spec (.of k)) [IsProper f]

include f in
/-- **A global section of `quot σ 1` generating every stalk on its support**, by
[Stacks, Tag 0AYT] (2): the global sections of a coherent module with zero-dimensional support are
the product of its stalks along the support. -/
theorem exists_section_quot_notMem_maximalSmul [Mono σ] (hdim : topologicalKrullDim X ≤ 1) :
    ∃ γ : 𝟙_ X.Modules ⟶ quot σ 1, ∀ x ∈ SheafOfModules.supp (quot σ 1),
      ((quot σ 1).presheaf.Γgerm x).hom (Stacks.SectionProduct.globalSection X _ γ) ∉
        Stacks.ModuleStalk.maximalSmul (quot σ 1) x := by
  have := isLocallyNoetherian_of_isProper k f
  have := noetherianSpace_of_isProper k f
  have := isCoherent_quot L σ k f 1
  have hfin : (natTensorPow L (1 + 1)).IsFiniteType :=
    have := isCoherent_natTensorPow L k f (1 + 1)
    (Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent _).2
  have hF := topologicalKrullDim_supp_quot_le_zero L hdim σ hfin (le_refl 1)
  choose q hq using fun x : SheafOfModules.supp (quot σ 1) =>
    exists_notMem_maximalSmul_of_epi (cokernel.π (mulMap σ 1)) x.2
  obtain ⟨s, hs⟩ := (bijective_suppGermHom_of_supp_le_zero k f (quot σ 1) hF).2 q
  refine ⟨(Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv X _).symm s, fun x hx => ?_⟩
  have h1 : Stacks.SectionProduct.globalSection X _
      ((Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv X _).symm s) = s :=
    (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv X _).apply_symm_apply s
  have h2 : ((quot σ 1).presheaf.Γgerm x).hom s = q ⟨x, hx⟩ := congrFun hs ⟨x, hx⟩
  rw [h1, h2]
  exact hq ⟨x, hx⟩

include f in
/-- **A section `t` of `ℒ^{⊗ 2}` not vanishing at any point of the support of `quot σ 1`.** It is a
lift of the section of `exists_section_quot_notMem_maximalSmul`, which exists since
`H¹(X, ℒ) = 0`. -/
theorem exists_section_two [Mono σ] (hdim : topologicalKrullDim X ≤ 1)
    (hH1 : IsZero (cohomologyOverField k f L 1)) :
    ∃ t : powSections L (1 + 1), ∀ x, x ∈ Stacks.AmpleFiniteAvoidance.nvLocus L t ∨
      x ∉ SheafOfModules.supp (quot σ 1) := by
  obtain ⟨γ, hγ⟩ := exists_section_quot_notMem_maximalSmul L σ k f hdim
  obtain ⟨t, ht⟩ := exists_comp_cokernelπ_eq L σ k f 1
    (isZero_cohomologyOverField_one_natTensorPow L σ k f hdim hH1 0) γ
  refine ⟨t, fun x => ?_⟩
  by_cases hx : x ∈ SheafOfModules.supp (quot σ 1)
  · left
    by_contra hnt
    have hm : ((natTensorPow L (1 + 1)).presheaf.Γgerm x).hom
        (Stacks.SectionProduct.globalSection X _ t) ∈
        Stacks.ModuleStalk.maximalSmul (natTensorPow L (1 + 1)) x := of_not_not hnt
    apply hγ x hx
    rw [← ht, Stacks.SectionProduct.Γgerm_globalSection_comp]
    exact Stacks.SectionProduct.mapFun_mem_maximalSmul _ x hm
  · exact Or.inr hx

include f in
/-- **The decomposition `ℒ^{⊗ 3 + a} = σ · ℒ^{⊗ 2 + a} + t · ℒ^{⊗ 1 + a}` for `a ≥ 1`**, at the
level of morphisms out of `𝒪_X`. This is the claim of the second paragraph of the proof of
[Stacks, Tag 0E8V], in the form: the multiplication map
`H⁰(ℒ) ⊗ H⁰(ℒ^{⊗ n}) ⊕ H⁰(ℒ^{⊗ 2}) ⊗ H⁰(ℒ^{⊗ n-1}) ⟶ H⁰(ℒ^{⊗ n+1})` is surjective for `n ≥ 3`, with
the first factors `σ` and `t`. -/
theorem exists_eq_add [Mono σ] (hdim : topologicalKrullDim X ≤ 1)
    (hH1 : IsZero (cohomologyOverField k f L 1)) {e : ℕ} (t : powSections L e)
    (ht : ∀ x, x ∈ Stacks.AmpleFiniteAvoidance.nvLocus L t ∨
      x ∉ SheafOfModules.supp (quot σ 1))
    {a : ℕ} (ha : 1 ≤ a) (τ : powSections L (1 + (e + a))) :
    ∃ (ρ : powSections L (e + a)) (β : powSections L (1 + a)),
      τ = ρ ≫ mulMap σ (e + a) + β ≫ mulMap t (1 + a) ≫
        Stacks.GradedSections.powCongr L (by omega : e + (1 + a) = 1 + (e + a)) := by
  have hepi : ∀ x, x ∈ Stacks.AmpleFiniteAvoidance.nvLocus L t ∨
      x ∉ SheafOfModules.supp (quot σ (e + a)) := fun x =>
    (ht x).imp_right fun h h' => h (supp_quot_subset_one σ (by omega) h')
  obtain ⟨δ, hδ⟩ := exists_comp_quotMap_eq L σ k f hdim t ha hepi
    (τ ≫ cokernel.π (mulMap σ (e + a)))
  obtain ⟨a', rfl⟩ : ∃ a', a = a' + 1 := ⟨a - 1, by omega⟩
  obtain ⟨β, hβ⟩ := exists_comp_cokernelπ_eq L σ k f (a' + 1)
    (isZero_cohomologyOverField_one_natTensorPow L σ k f hdim hH1 a') δ
  obtain ⟨ρ, hρ⟩ := exists_eq_comp_mulMap L σ (e + (a' + 1))
    (τ - β ≫ mulMap t (1 + (a' + 1)) ≫
      Stacks.GradedSections.powCongr L (by omega : e + (1 + (a' + 1)) = 1 + (e + (a' + 1))))
    (by
      rw [Preadditive.sub_comp, Category.assoc, Category.assoc, ← Category.assoc _ _
        (cokernel.π _), ← π_quotMap, ← Category.assoc, hβ, hδ, sub_self])
  exact ⟨ρ, β, by rw [← hρ, sub_add_cancel]⟩

/-! ### In the section ring -/

section Ring

omit [IsInvertibleModule X L] in
/-- A transport of degree does not change a homogeneous element of the section ring. -/
theorem of_comp_powCongr {n m : ℕ} (h : n = m) (x : powSections L n) :
    DirectSum.of (powSections L) m (x ≫ Stacks.GradedSections.powCongr L h) =
      DirectSum.of (powSections L) n x := by
  subst h
  simp

omit [IsInvertibleModule X L] in
/-- Multiplication by a section, read in the section ring. -/
theorem of_comp_mulMap {n m : ℕ} (s : powSections L n) (x : powSections L m) :
    DirectSum.of (powSections L) (n + m) (x ≫ mulMap s m) =
      DirectSum.of (powSections L) n s * DirectSum.of (powSections L) m x :=
  (DirectSum.of_mul_of s x).symm

include f in
/-- **The decomposition in the section ring.** Every element of `S_{1 + e + a}` is
`σ · y₁ + t · y₂` with `y₁ ∈ S_{e + a}` and `y₂ ∈ S_{1 + a}`. -/
theorem mem_grading_eq_add [Mono σ] (hdim : topologicalKrullDim X ≤ 1)
    (hH1 : IsZero (cohomologyOverField k f L 1)) {e : ℕ} (t : powSections L e)
    (ht : ∀ x, x ∈ Stacks.AmpleFiniteAvoidance.nvLocus L t ∨
      x ∉ SheafOfModules.supp (quot σ 1))
    {a : ℕ} (ha : 1 ≤ a) {z : Stacks.GradedSections.sectionRing L}
    (hz : z ∈ Stacks.AmpleFiniteAvoidance.grading L (1 + (e + a))) :
    ∃ y₁ ∈ Stacks.AmpleFiniteAvoidance.grading L (e + a),
      ∃ y₂ ∈ Stacks.AmpleFiniteAvoidance.grading L (1 + a),
        z = DirectSum.of (powSections L) 1 σ * y₁ + DirectSum.of (powSections L) e t * y₂ := by
  obtain ⟨τ, rfl⟩ := Stacks.ExternalGrading.mem_summand_iff.mp hz
  obtain ⟨ρ, β, hτ⟩ := exists_eq_add L σ k f hdim hH1 t ht ha τ
  refine ⟨_, Stacks.ExternalGrading.of_mem_summand _ ρ, _,
    Stacks.ExternalGrading.of_mem_summand _ β, ?_⟩
  rw [hτ, map_add, of_comp_mulMap, ← Category.assoc, of_comp_powCongr, of_comp_mulMap]

end Ring

/-! ### Generation in degrees one, two and three -/

omit [IsInvertibleModule X L] in
/-- A regular section of `ℒ`, read in degree one of the section ring. -/
theorem mono_comp_leftUnitor_inv (s : 𝟙_ X.Modules ⟶ L) [Mono s] :
    Mono (s ≫ (λ_ L).inv : powSections L 1) :=
  mono_comp s (λ_ L).inv

variable {L} in
include f in
/-- **The section ring is generated over its degree-zero part in degrees `1`, `2` and `3`**, for
`ℒ` invertible with a regular global section and `H¹(X, ℒ) = 0` on a proper scheme of dimension at
most one over a field. This is the conclusion of the first two paragraphs of the proof of
[Stacks, Tag 0E8V]. -/
theorem adjoin_grading_le_three_eq_top (s : 𝟙_ X.Modules ⟶ L) [Mono s]
    (hdim : topologicalKrullDim X ≤ 1) (hH1 : IsZero (cohomologyOverField k f L 1)) :
    Algebra.adjoin (Stacks.Veronese.gradeZero (Stacks.AmpleFiniteAvoidance.grading L))
      ((Stacks.AmpleFiniteAvoidance.grading L 1 : Set (Stacks.GradedSections.sectionRing L)) ∪
        (Stacks.AmpleFiniteAvoidance.grading L 2 : Set _) ∪
          (Stacks.AmpleFiniteAvoidance.grading L 3 : Set _)) = ⊤ := by
  classical
  set σ : powSections L 1 := s ≫ (λ_ L).inv
  have : Mono σ := mono_comp_leftUnitor_inv L s
  obtain ⟨t, ht⟩ := exists_section_two L σ k f hdim hH1
  set A := Algebra.adjoin (Stacks.Veronese.gradeZero (Stacks.AmpleFiniteAvoidance.grading L))
      ((Stacks.AmpleFiniteAvoidance.grading L 1 : Set (Stacks.GradedSections.sectionRing L)) ∪
        (Stacks.AmpleFiniteAvoidance.grading L 2 : Set _) ∪
          (Stacks.AmpleFiniteAvoidance.grading L 3 : Set _))
  have hdeg : ∀ m, ∀ z ∈ Stacks.AmpleFiniteAvoidance.grading L m, z ∈ A := by
    intro m
    induction m using Nat.strong_induction_on with
    | _ m ih =>
      intro z hz
      rcases (show m = 0 ∨ m = 1 ∨ m = 2 ∨ m = 3 ∨ 4 ≤ m by omega) with rfl | rfl | rfl | rfl | h
      · exact Subalgebra.algebraMap_mem A
          (⟨z, hz⟩ : Stacks.Veronese.gradeZero (Stacks.AmpleFiniteAvoidance.grading L))
      · exact Algebra.subset_adjoin (Or.inl (Or.inl hz))
      · exact Algebra.subset_adjoin (Or.inl (Or.inr hz))
      · exact Algebra.subset_adjoin (Or.inr hz)
      · obtain ⟨a, rfl⟩ : ∃ a, m = 1 + ((1 + 1) + a) := ⟨m - 3, by omega⟩
        obtain ⟨y₁, hy₁, y₂, hy₂, rfl⟩ :=
          mem_grading_eq_add L σ k f hdim hH1 t ht (by omega : 1 ≤ a) hz
        refine add_mem (mul_mem ?_ (ih _ (by omega) y₁ hy₁))
          (mul_mem ?_ (ih _ (by omega) y₂ hy₂))
        · exact Algebra.subset_adjoin (Or.inl (Or.inl (Stacks.ExternalGrading.of_mem_summand 1 σ)))
        · exact Algebra.subset_adjoin (Or.inl (Or.inr
            (Stacks.ExternalGrading.of_mem_summand (1 + 1) t)))
  refine eq_top_iff.mpr fun x _ => ?_
  rw [← DirectSum.sum_support_of x]
  exact sum_mem fun i _ => hdeg i _ (Stacks.ExternalGrading.of_mem_summand i (x i))

end Proper

end Stacks.RegularSectionGeneration

end
