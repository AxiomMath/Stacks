module

public import Mathlib.Algebra.Algebra.Subalgebra.Basic
public import Mathlib.Algebra.GroupWithZero.NonZeroDivisors
public import Mathlib.RingTheory.Derivation.Basic

/-!
# Vector fields at a node

Let `k` be a field and let `B₁`, `B₂` be `k`-algebras carrying augmentations `εᵢ : Bᵢ →ₐ[k] k`
whose kernels are generated by a non-zero-divisor `uᵢ`. Their *node algebra* is the fibre
product `A = B₁ ×_k B₂ = {(b₁, b₂) | ε₁ b₁ = ε₂ b₂}`. Restriction of a `k`-derivation of `A` to
the two factors is injective, and its image is exactly the set of pairs of `k`-derivations of
`B₁` and of `B₂` preserving the two augmentation ideals.

For `X` an at-worst-nodal proper connected curve over an algebraically closed field and
`ν : X^ν → X` its normalization, the local ring of `X` at a node `x` is the fibre product of the
local rings of `X^ν` at the two points `x'`, `x''` of `S = {ν not an isomorphism}` above `x`,
over the common residue field `k`, and the `uᵢ` are uniformizers; so this is the local form of
the identification of Tag 0E68 between `Der_k(𝒪_X, 𝒪_X)` and the `k`-derivations of
`𝒪_{X^ν}` fixing every point of `S`. The sheaf-level statement of Tag 0E68 is
`Stacks.Curves.NodalVectorFields.range_branchPair`, in
`StacksFrontier.AlgebraicGeometry.Curves.NodalVectorFieldsEquivalence`.

## Main results

* `Stacks.Curves.NodalVectorFields.injective_branchPair` — a `k`-derivation of the node algebra
  is determined by its two restrictions.
* `Stacks.Curves.NodalVectorFields.range_branchPair_eq_setOf_fixes` — the restrictions realised
  are exactly the pairs of derivations fixing the two points.
* `Stacks.Curves.NodalVectorFields.glue` — the derivation of the node algebra attached to such a
  pair.
* `Stacks.Curves.NodalVectorFields.coe_apply_eq_branchPair` — a derivation of the node algebra
  acts on each factor through the corresponding restriction.

## Implementation notes

`Fixes ε D` is the pointwise form of the condition of Section 53.26 that a derivation fix a
closed point: the ideal of the point is carried into itself, which at the point cut out by `ε`
reads `D (ker ε) ⊆ ker ε`.

The projections of the node algebra admit the `k`-algebra sections `b ↦ (b, ε₁ b)` and
`b ↦ (ε₂ b, b)`, so restriction is conjugation by a section (`retract`) and needs no descent
along a quotient. The uniformizers are what makes restriction lossless: `(u₁, 0) (0, u₂) = 0`,
so the Leibniz rule kills the first coordinate of `D (0, u₂)` and the second coordinate of
`D (u₁, 0)`, and that single computation both recovers `D` from its restrictions and shows the
restrictions fix the two points.

The hypotheses are satisfied by `B₁ = B₂ = k[X]` with `ε = Polynomial.aeval 0` and `u = X`,
where `A` is the affine node — two coordinate axes glued at the origin — and the Euler field
`X • d/dX` is a nonzero derivation fixing the origin.

## References

* [Stacks Project, Tag 0E68](https://stacks.math.columbia.edu/tag/0E68)
* [Stacks Project, Tag 0E66](https://stacks.math.columbia.edu/tag/0E66)
* [Stacks Project, Tag 0C1X](https://stacks.math.columbia.edu/tag/0C1X)
* [Stacks Project, Tag 0CBV](https://stacks.math.columbia.edu/tag/0CBV)
-/

@[expose] public noncomputable section

universe u v w

namespace Stacks.Curves.NodalVectorFields

variable {k : Type u} {B₁ : Type v} {B₂ : Type w}
variable [Field k] [CommRing B₁] [CommRing B₂] [Algebra k B₁] [Algebra k B₂]

/-- A `k`-derivation of `B` *fixes* the `k`-point cut out by the augmentation `ε` when it
preserves the maximal ideal `ker ε` of that point. -/
def Fixes (ε : B₁ →ₐ[k] k) (D : Derivation k B₁ B₁) : Prop :=
  ∀ b, ε b = 0 → ε (D b) = 0

/-- The restriction of a `k`-derivation of `A` along a retraction `p` of `s : C →ₐ[k] A`. -/
def retract {A C : Type*} [CommRing A] [CommRing C] [Algebra k A] [Algebra k C]
    (s : C →ₐ[k] A) (p : A →ₐ[k] C) (hps : ∀ c, p (s c) = c) (D : Derivation k A A) :
    Derivation k C C where
  toFun c := p (D (s c))
  map_add' c c' := by simp
  map_smul' r c := by simp
  map_one_eq_zero' := by simp
  leibniz' c c' := by simp [smul_eq_mul, hps]

/-- The restriction `retract s p hps D` sends `c` to `p (D (s c))`. -/
@[simp]
theorem retract_apply {A C : Type*} [CommRing A] [CommRing C] [Algebra k A] [Algebra k C]
    (s : C →ₐ[k] A) (p : A →ₐ[k] C) (hps : ∀ c, p (s c) = c) (D : Derivation k A A) (c : C) :
    retract s p hps D c = p (D (s c)) :=
  rfl

variable (ε₁ : B₁ →ₐ[k] k) (ε₂ : B₂ →ₐ[k] k)

/-- The *node algebra* `B₁ ×_k B₂` of two augmented `k`-algebras: the pairs whose two
augmentations agree. -/
def nodeAlg : Subalgebra k (B₁ × B₂) :=
  AlgHom.equalizer (ε₁.comp (AlgHom.fst k B₁ B₂)) (ε₂.comp (AlgHom.snd k B₁ B₂))

/-- A pair lies in the node algebra exactly when its two augmentations agree. -/
@[simp]
theorem mem_nodeAlg {x : B₁ × B₂} : x ∈ nodeAlg ε₁ ε₂ ↔ ε₁ x.1 = ε₂ x.2 := Iff.rfl

/-- The first projection of the node algebra onto its branch. -/
def proj₁ : nodeAlg ε₁ ε₂ →ₐ[k] B₁ := (AlgHom.fst k B₁ B₂).comp (nodeAlg ε₁ ε₂).val

/-- The second projection of the node algebra onto its branch. -/
def proj₂ : nodeAlg ε₁ ε₂ →ₐ[k] B₂ := (AlgHom.snd k B₁ B₂).comp (nodeAlg ε₁ ε₂).val

/-- The section of the first projection sending `b` to `(b, ε₁ b)`. -/
def sec₁ : B₁ →ₐ[k] nodeAlg ε₁ ε₂ :=
  ((AlgHom.id k B₁).prod ((Algebra.ofId k B₂).comp ε₁)).codRestrict _ fun b => by
    simp [mem_nodeAlg, Algebra.ofId_apply]

/-- The section of the second projection sending `b` to `(ε₂ b, b)`. -/
def sec₂ : B₂ →ₐ[k] nodeAlg ε₁ ε₂ :=
  (((Algebra.ofId k B₁).comp ε₂).prod (AlgHom.id k B₂)).codRestrict _ fun b => by
    simp [mem_nodeAlg, Algebra.ofId_apply]

/-- The first projection of the node algebra is the first coordinate. -/
@[simp] theorem proj₁_apply (a : nodeAlg ε₁ ε₂) : proj₁ ε₁ ε₂ a = (a : B₁ × B₂).1 := rfl

/-- The second projection of the node algebra is the second coordinate. -/
@[simp] theorem proj₂_apply (a : nodeAlg ε₁ ε₂) : proj₂ ε₁ ε₂ a = (a : B₁ × B₂).2 := rfl

/-- The section `sec₁` sends `b` to the pair `(b, ε₁ b)`. -/
@[simp] theorem coe_sec₁ (b : B₁) :
    (sec₁ ε₁ ε₂ b : B₁ × B₂) = (b, algebraMap k B₂ (ε₁ b)) := rfl

/-- The section `sec₂` sends `b` to the pair `(ε₂ b, b)`. -/
@[simp] theorem coe_sec₂ (b : B₂) :
    (sec₂ ε₁ ε₂ b : B₁ × B₂) = (algebraMap k B₁ (ε₂ b), b) := rfl

/-- `sec₁` is a section of the first projection. -/
theorem proj₁_sec₁ (b : B₁) : proj₁ ε₁ ε₂ (sec₁ ε₁ ε₂ b) = b := rfl

/-- `sec₂` is a section of the second projection. -/
theorem proj₂_sec₂ (b : B₂) : proj₂ ε₁ ε₂ (sec₂ ε₁ ε₂ b) = b := rfl

/-- The restriction of a `k`-derivation of the node algebra to the first branch. -/
def branch₁ (D : Derivation k (nodeAlg ε₁ ε₂) (nodeAlg ε₁ ε₂)) : Derivation k B₁ B₁ :=
  retract (sec₁ ε₁ ε₂) (proj₁ ε₁ ε₂) (proj₁_sec₁ ε₁ ε₂) D

/-- The restriction of a `k`-derivation of the node algebra to the second branch. -/
def branch₂ (D : Derivation k (nodeAlg ε₁ ε₂) (nodeAlg ε₁ ε₂)) : Derivation k B₂ B₂ :=
  retract (sec₂ ε₁ ε₂) (proj₂ ε₁ ε₂) (proj₂_sec₂ ε₁ ε₂) D

/-- The first branch of `D` sends `b` to the first coordinate of `D (b, ε₁ b)`. -/
@[simp] theorem branch₁_apply (D : Derivation k (nodeAlg ε₁ ε₂) (nodeAlg ε₁ ε₂)) (b : B₁) :
    branch₁ ε₁ ε₂ D b = (D (sec₁ ε₁ ε₂ b) : B₁ × B₂).1 := rfl

/-- The second branch of `D` sends `b` to the second coordinate of `D (ε₂ b, b)`. -/
@[simp] theorem branch₂_apply (D : Derivation k (nodeAlg ε₁ ε₂) (nodeAlg ε₁ ε₂)) (b : B₂) :
    branch₂ ε₁ ε₂ D b = (D (sec₂ ε₁ ε₂ b) : B₁ × B₂).2 := rfl

/-- Restriction of a `k`-derivation of the node algebra to the pair of its two branches. -/
def branchPair (D : Derivation k (nodeAlg ε₁ ε₂) (nodeAlg ε₁ ε₂)) :
    Derivation k B₁ B₁ × Derivation k B₂ B₂ :=
  (branch₁ ε₁ ε₂ D, branch₂ ε₁ ε₂ D)

/-- The derivation of the node algebra obtained from a pair of derivations of the branches that
fix the two points. -/
def glue (D₁ : Derivation k B₁ B₁) (D₂ : Derivation k B₂ B₂) (h₁ : Fixes ε₁ D₁)
    (h₂ : Fixes ε₂ D₂) : Derivation k (nodeAlg ε₁ ε₂) (nodeAlg ε₁ ε₂) where
  toFun a := ⟨(D₁ (a : B₁ × B₂).1, D₂ (a : B₁ × B₂).2), by
    have e₁ : ε₁ (D₁ (a : B₁ × B₂).1) = 0 := by
      have hz : ε₁ ((a : B₁ × B₂).1 - algebraMap k B₁ (ε₁ (a : B₁ × B₂).1)) = 0 := by simp
      simpa using h₁ _ hz
    have e₂ : ε₂ (D₂ (a : B₁ × B₂).2) = 0 := by
      have hz : ε₂ ((a : B₁ × B₂).2 - algebraMap k B₂ (ε₂ (a : B₁ × B₂).2)) = 0 := by simp
      simpa using h₂ _ hz
    simp [mem_nodeAlg, e₁, e₂]⟩
  map_add' a a' := by ext <;> simp
  map_smul' r a := by ext <;> simp
  map_one_eq_zero' := by ext <;> simp
  leibniz' a a' := by ext <;> simp [smul_eq_mul]

/-- The glued derivation acts on a pair `(b₁, b₂)` as `(D₁ b₁, D₂ b₂)`. -/
@[simp] theorem coe_glue (D₁ : Derivation k B₁ B₁) (D₂ : Derivation k B₂ B₂) (h₁ : Fixes ε₁ D₁)
    (h₂ : Fixes ε₂ D₂) (a : nodeAlg ε₁ ε₂) :
    (glue ε₁ ε₂ D₁ D₂ h₁ h₂ a : B₁ × B₂) = (D₁ (a : B₁ × B₂).1, D₂ (a : B₁ × B₂).2) :=
  rfl

/-- The two restrictions of the derivation glued from `D₁` and `D₂` are `D₁` and `D₂`. -/
theorem branchPair_glue (D₁ : Derivation k B₁ B₁) (D₂ : Derivation k B₂ B₂) (h₁ : Fixes ε₁ D₁)
    (h₂ : Fixes ε₂ D₂) : branchPair ε₁ ε₂ (glue ε₁ ε₂ D₁ D₂ h₁ h₂) = (D₁, D₂) := by
  ext b
  · show (glue ε₁ ε₂ D₁ D₂ h₁ h₂ (sec₁ ε₁ ε₂ b) : B₁ × B₂).1 = D₁ b
    simp
  · show (glue ε₁ ε₂ D₁ D₂ h₁ h₂ (sec₂ ε₁ ε₂ b) : B₁ × B₂).2 = D₂ b
    simp

section Uniformizer

variable {u₁ : B₁} {u₂ : B₂}

/-- The Leibniz rule for a derivation of the node algebra, read in `B₁ × B₂`. -/
private theorem coe_deriv_mul (D : Derivation k (nodeAlg ε₁ ε₂) (nodeAlg ε₁ ε₂))
    (a b : nodeAlg ε₁ ε₂) :
    (D (a * b) : B₁ × B₂) = (a : B₁ × B₂) * (D b : B₁ × B₂) + (b : B₁ × B₂) * (D a : B₁ × B₂) := by
  rw [D.leibniz]
  simp [smul_eq_mul]

/-- The elements `U = (u₁, 0)` and `V = (0, u₂)` of the node algebra, with the two components
that the Leibniz rule applied to `U * V = 0` kills. -/
private theorem deriv_vanish (hu₁ : ε₁ u₁ = 0) (hu₂ : ε₂ u₂ = 0) (hreg₁ : u₁ ∈ nonZeroDivisors B₁)
    (hreg₂ : u₂ ∈ nonZeroDivisors B₂) (D : Derivation k (nodeAlg ε₁ ε₂) (nodeAlg ε₁ ε₂)) :
    ∃ U V : nodeAlg ε₁ ε₂, (U : B₁ × B₂) = (u₁, 0) ∧ (V : B₁ × B₂) = (0, u₂) ∧
      (D V : B₁ × B₂).1 = 0 ∧ (D U : B₁ × B₂).2 = 0 := by
  obtain ⟨U, hU⟩ : ∃ U : nodeAlg ε₁ ε₂, (U : B₁ × B₂) = (u₁, 0) :=
    ⟨⟨(u₁, 0), by simp [mem_nodeAlg, hu₁]⟩, rfl⟩
  obtain ⟨V, hV⟩ : ∃ V : nodeAlg ε₁ ε₂, (V : B₁ × B₂) = (0, u₂) :=
    ⟨⟨(0, u₂), by simp [mem_nodeAlg, hu₂]⟩, rfl⟩
  have hUV : U * V = 0 := by
    apply Subtype.ext
    have h : (U : B₁ × B₂) * (V : B₁ × B₂) = 0 := by rw [hU, hV]; simp [Prod.ext_iff]
    simpa using h
  have hc := coe_deriv_mul ε₁ ε₂ D U V
  rw [hUV, map_zero, hU, hV] at hc
  have h1 : (0 : B₁) = u₁ * (D V : B₁ × B₂).1 := by simpa using congrArg Prod.fst hc
  have h2 : (0 : B₂) = u₂ * (D U : B₁ × B₂).2 := by simpa using congrArg Prod.snd hc
  exact ⟨U, V, hU, hV, mem_nonZeroDivisors_iff_left.mp hreg₁ _ h1.symm,
    mem_nonZeroDivisors_iff_left.mp hreg₂ _ h2.symm⟩

variable (hu₁ : ε₁ u₁ = 0) (hu₂ : ε₂ u₂ = 0)
  (hgen₁ : ∀ b : B₁, ε₁ b = 0 → ∃ c, b = c * u₁)
  (hgen₂ : ∀ b : B₂, ε₂ b = 0 → ∃ c, b = c * u₂)
  (hreg₁ : u₁ ∈ nonZeroDivisors B₁) (hreg₂ : u₂ ∈ nonZeroDivisors B₂)

include hu₁ hu₂ hgen₁ hgen₂ hreg₁ hreg₂ in
/-- A `k`-derivation of the node algebra acts on each factor through the corresponding branch
restriction. -/
theorem coe_apply_eq_branchPair (D : Derivation k (nodeAlg ε₁ ε₂) (nodeAlg ε₁ ε₂))
    (a : nodeAlg ε₁ ε₂) :
    (D a : B₁ × B₂) =
      (branch₁ ε₁ ε₂ D (a : B₁ × B₂).1, branch₂ ε₁ ε₂ D (a : B₁ × B₂).2) := by
  obtain ⟨U, V, hUc, hVc, hV1, hU2⟩ := deriv_vanish ε₁ ε₂ hu₁ hu₂ hreg₁ hreg₂ D
  have hmem : ε₁ (a : B₁ × B₂).1 = ε₂ (a : B₁ × B₂).2 := a.2
  refine Prod.ext ?_ ?_
  · obtain ⟨d, hd⟩ := hgen₂ ((a : B₁ × B₂).2 - algebraMap k B₂ (ε₂ (a : B₁ × B₂).2)) (by simp)
    have hprod : ((sec₂ ε₁ ε₂ d * V : nodeAlg ε₁ ε₂) : B₁ × B₂) = (0, d * u₂) := by
      rw [MulMemClass.coe_mul, coe_sec₂, hVc]
      simp
    have hw : sec₁ ε₁ ε₂ (a : B₁ × B₂).1 + sec₂ ε₁ ε₂ d * V = a := by
      apply Subtype.ext
      rw [AddMemClass.coe_add, coe_sec₁, hprod, hmem]
      refine Prod.ext (by simp) ?_
      simp only [Prod.snd_add]
      rw [← hd]
      ring
    have hDa : D a = D (sec₁ ε₁ ε₂ (a : B₁ × B₂).1) + D (sec₂ ε₁ ε₂ d * V) := by
      rw [← map_add, hw]
    have hsnd : (D (sec₂ ε₁ ε₂ d * V) : B₁ × B₂).1 = 0 := by
      rw [coe_deriv_mul, hVc]
      simp [hV1]
    rw [hDa]
    simp only [AddMemClass.coe_add, Prod.fst_add, hsnd, add_zero]
    rfl
  · obtain ⟨c, hc⟩ := hgen₁ ((a : B₁ × B₂).1 - algebraMap k B₁ (ε₁ (a : B₁ × B₂).1)) (by simp)
    have hprod : ((sec₁ ε₁ ε₂ c * U : nodeAlg ε₁ ε₂) : B₁ × B₂) = (c * u₁, 0) := by
      rw [MulMemClass.coe_mul, coe_sec₁, hUc]
      simp
    have hw : sec₂ ε₁ ε₂ (a : B₁ × B₂).2 + sec₁ ε₁ ε₂ c * U = a := by
      apply Subtype.ext
      rw [AddMemClass.coe_add, coe_sec₂, hprod, ← hmem]
      refine Prod.ext ?_ (by simp)
      simp only [Prod.fst_add]
      rw [← hc]
      ring
    have hDa : D a = D (sec₂ ε₁ ε₂ (a : B₁ × B₂).2) + D (sec₁ ε₁ ε₂ c * U) := by
      rw [← map_add, hw]
    have hfst : (D (sec₁ ε₁ ε₂ c * U) : B₁ × B₂).2 = 0 := by
      rw [coe_deriv_mul, hUc]
      simp [hU2]
    rw [hDa]
    simp only [AddMemClass.coe_add, Prod.snd_add, hfst, add_zero]
    rfl

include hu₁ hu₂ hgen₁ hreg₁ hreg₂ in
/-- The restriction to the first branch of a `k`-derivation of the node algebra fixes the
point cut out by `ε₁`. -/
theorem fixes_branch₁ (D : Derivation k (nodeAlg ε₁ ε₂) (nodeAlg ε₁ ε₂)) :
    Fixes ε₁ (branch₁ ε₁ ε₂ D) := by
  intro b hb
  obtain ⟨U, V, hUc, hVc, -, hU2⟩ := deriv_vanish ε₁ ε₂ hu₁ hu₂ hreg₁ hreg₂ D
  have hDU1 : ε₁ (D U : B₁ × B₂).1 = 0 := by
    have hm : ε₁ (D U : B₁ × B₂).1 = ε₂ (D U : B₁ × B₂).2 := (D U).2
    rw [hm, hU2, map_zero]
  obtain ⟨c, hc⟩ := hgen₁ b hb
  have hsec : sec₁ ε₁ ε₂ u₁ = U := by
    apply Subtype.ext
    rw [coe_sec₁, hUc, hu₁, map_zero]
  have hval : branch₁ ε₁ ε₂ D b = (D (sec₁ ε₁ ε₂ c * U) : B₁ × B₂).1 := by
    rw [branch₁_apply, hc, map_mul, hsec]
  rw [hval, coe_deriv_mul, hUc]
  simp [hDU1, hu₁]

include hu₁ hu₂ hgen₂ hreg₁ hreg₂ in
/-- The restriction to the second branch of a `k`-derivation of the node algebra fixes the
point cut out by `ε₂`. -/
theorem fixes_branch₂ (D : Derivation k (nodeAlg ε₁ ε₂) (nodeAlg ε₁ ε₂)) :
    Fixes ε₂ (branch₂ ε₁ ε₂ D) := by
  intro b hb
  obtain ⟨U, V, hUc, hVc, hV1, -⟩ := deriv_vanish ε₁ ε₂ hu₁ hu₂ hreg₁ hreg₂ D
  have hDV2 : ε₂ (D V : B₁ × B₂).2 = 0 := by
    have hm : ε₁ (D V : B₁ × B₂).1 = ε₂ (D V : B₁ × B₂).2 := (D V).2
    rw [← hm, hV1, map_zero]
  obtain ⟨c, hc⟩ := hgen₂ b hb
  have hsec : sec₂ ε₁ ε₂ u₂ = V := by
    apply Subtype.ext
    rw [coe_sec₂, hVc, hu₂, map_zero]
  have hval : branch₂ ε₁ ε₂ D b = (D (sec₂ ε₁ ε₂ c * V) : B₁ × B₂).2 := by
    rw [branch₂_apply, hc, map_mul, hsec]
  rw [hval, coe_deriv_mul, hVc]
  simp [hDV2, hu₂]

include hu₁ hu₂ hgen₁ hgen₂ hreg₁ hreg₂ in
/-- Restriction to the two branches is injective on `k`-derivations of the node algebra. -/
theorem injective_branchPair : Function.Injective (branchPair ε₁ ε₂) := by
  intro D D' h
  have h1 : branch₁ ε₁ ε₂ D = branch₁ ε₁ ε₂ D' := congrArg Prod.fst h
  have h2 : branch₂ ε₁ ε₂ D = branch₂ ε₁ ε₂ D' := congrArg Prod.snd h
  refine Derivation.ext fun a => Subtype.ext ?_
  rw [coe_apply_eq_branchPair ε₁ ε₂ hu₁ hu₂ hgen₁ hgen₂ hreg₁ hreg₂ D a,
    coe_apply_eq_branchPair ε₁ ε₂ hu₁ hu₂ hgen₁ hgen₂ hreg₁ hreg₂ D' a, h1, h2]

include hu₁ hu₂ hgen₁ hgen₂ hreg₁ hreg₂ in
/-- **The image of restriction at a split node.** When each augmentation ideal of `Bᵢ` is
generated by a non-zero-divisor `uᵢ`, the pairs of branch derivations realised by restricting a
`k`-derivation of the node algebra `B₁ ×_k B₂` are exactly the pairs fixing the two points cut
out by `ε₁` and `ε₂`. -/
theorem range_branchPair_eq_setOf_fixes :
    Set.range (branchPair ε₁ ε₂) =
      {p : Derivation k B₁ B₁ × Derivation k B₂ B₂ | Fixes ε₁ p.1 ∧ Fixes ε₂ p.2} := by
  ext p
  constructor
  · rintro ⟨D, rfl⟩
    exact ⟨fixes_branch₁ ε₁ ε₂ hu₁ hu₂ hgen₁ hreg₁ hreg₂ D,
      fixes_branch₂ ε₁ ε₂ hu₁ hu₂ hgen₂ hreg₁ hreg₂ D⟩
  · rintro ⟨h₁, h₂⟩
    exact ⟨glue ε₁ ε₂ p.1 p.2 h₁ h₂, branchPair_glue ε₁ ε₂ p.1 p.2 h₁ h₂⟩

end Uniformizer

end Stacks.Curves.NodalVectorFields

end
