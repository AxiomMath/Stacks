-/

@[expose] public noncomputable section

open CategoryTheory
open Stacks.AmpleProjectiveImmersion Stacks.ProjectiveFromSections Stacks.TwistPullbackPinned
open Stacks.Frobenius
open Stacks.SectionsToProjectiveSpace (coordGrading)

universe u

namespace AlgebraicGeometry

variable {k : Type u} [Field k]

/-! ### The function field and the residue field at the generic point, as `k`-algebras -/

/-- **The function field of a variety is its residue field at the generic point as a
`k`-algebra.** The underlying ring isomorphism is `AlgebraicGeometry.genericResidueEquiv`, the
residue map of a stalk which is already a field; it commutes with the two structure maps because
both are the global-sections map of the structure morphism followed by a germ, read once in the
stalk and once in its residue field. -/
private def genericResidueAlgEquiv {X : Scheme.{u}} (pX : X ⟶ Spec (.of k)) [IsVariety k pX] :
    letI : Algebra k X.functionField :=
      varietyFunctionFieldAlgebra ({ toScheme := X, structureMap := pX } : Variety k)
    letI : Algebra k (X.residueField (genericPoint X)) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ pX.appTop ≫
        X.Γevaluation (genericPoint X)).hom.toAlgebra
    X.functionField ≃ₐ[k] X.residueField (genericPoint X) :=
  letI VX : Variety k := { toScheme := X, structureMap := pX }
  letI : Nonempty (⊤ : X.Opens) := ⟨⟨genericPoint X, trivial⟩⟩
  letI : Algebra k X.functionField := varietyFunctionFieldAlgebra VX
  letI : Algebra k (X.residueField (genericPoint X)) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ pX.appTop ≫
      X.Γevaluation (genericPoint X)).hom.toAlgebra
  { genericResidueEquiv X with
    commutes' := fun a => by
      have hff := DFunLike.congr_fun (functionFieldAlgebraMap_eq_germToFunctionField VX) a
      change (X.residue (genericPoint X)).hom (algebraMap k X.functionField a) = _
      rw [RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra]
      exact congrArg (X.residue (genericPoint X)).hom hff }

/-- **The compositum of `k` with the `p`-th powers of `k(X)` is the image of `k(X^{(p)})`.** The
corresponding statement for residue fields at the generic point is
`AlgebraicGeometry.fieldRange_residueFieldMap_relativeFrobenius`, and
`AlgebraicGeometry.residueFieldMap_comp_genericResidueEquivOfDominant` carries it to the function
fields, the compositum being transported by `genericResidueAlgEquiv`. -/
private theorem mem_compositumFrobenius_iff_exists_functionFieldMap_relativeFrobenius
    (p : ℕ) [Fact p.Prime] [CharP k p] (hS : IsInCharacteristic (Spec (.of k)) p)
    {X : Scheme.{u}} (pX : X ⟶ Spec (.of k)) [IsCurve k pX] [Smooth pX]
    [IsIntegral ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).left]
    [IsDominant (relativeFrobenius (Spec (.of k)) p hS (Over.mk pX)).left]
    (x : X.functionField) :
    letI : Algebra k X.functionField :=
      varietyFunctionFieldAlgebra ({ toScheme := X, structureMap := pX } : Variety k)
    ((∃ y, functionFieldMap (relativeFrobenius (Spec (.of k)) p hS (Over.mk pX)).left y = x) ↔
      x ∈ compositumFrobenius k X.functionField p) := by
  let : Algebra k X.functionField :=
    varietyFunctionFieldAlgebra ({ toScheme := X, structureMap := pX } : Variety k)
  let : Algebra k (X.residueField (genericPoint X)) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ pX.appTop ≫
      X.Γevaluation (genericPoint X)).hom.toAlgebra
  set F := (relativeFrobenius (Spec (.of k)) p hS (Over.mk pX)).left with hF
  set e := genericResidueEquiv X with he
  have hr : (F.residueFieldMap (genericPoint X)).hom.fieldRange =
      compositumFrobenius k (X.residueField (genericPoint X)) p :=
    fieldRange_residueFieldMap_relativeFrobenius pX p hS (genericPoint X)
  have hnat := DFunLike.congr_fun
    (residueFieldMap_comp_genericResidueEquivOfDominant F)
  simp only [RingHom.comp_apply] at hnat
  rw [← mem_compositumFrobenius_algEquiv_iff p (genericResidueAlgEquiv pX) x, ← hr]
  change _ ↔ e x ∈ (F.residueFieldMap (genericPoint X)).hom.fieldRange
  rw [RingHom.mem_fieldRange]
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨genericResidueEquivOfDominant F y, (hnat y).symm⟩
  · rintro ⟨z, hz⟩
    refine ⟨(genericResidueEquivOfDominant F).symm z, e.injective ?_⟩
    have h := hnat ((genericResidueEquivOfDominant F).symm z)
    simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      RingEquiv.apply_symm_apply] at h
    exact h.symm.trans hz

/-- **The fifth condition of the [Stacks, Tag 0C1C] list, read in the function fields.** The
condition is stated for the residue fields at the generic point; the identifications
`AlgebraicGeometry.genericResidueEquiv` and
`AlgebraicGeometry.genericResidueEquivOfDominant` carry it to the function fields, and
`AlgebraicGeometry.residueFieldMap_comp_genericResidueEquivOfDominant` is the compatibility the
transport of separability and of the degree both need. -/
private theorem genericFiniteSeparable_of_functionField {X Y : Scheme.{u}} (g : X ⟶ Y)
    [IsIntegral X] [IsIntegral Y] [IsDominant g]
    (hfin : letI : Algebra Y.functionField X.functionField := (functionFieldMap g).toAlgebra
      Module.Finite Y.functionField X.functionField)
    (hsep : letI : Algebra Y.functionField X.functionField := (functionFieldMap g).toAlgebra
      Algebra.IsSeparable Y.functionField X.functionField) :
    letI : Algebra (Y.residueField (g (genericPoint X))) (X.residueField (genericPoint X)) :=
      (g.residueFieldMap (genericPoint X)).hom.toAlgebra
    (Module.Finite (Y.residueField (g (genericPoint X))) (X.residueField (genericPoint X)) ∧
      Algebra.IsSeparableExtension (Y.residueField (g (genericPoint X)))
        (X.residueField (genericPoint X))) := by
  let : Algebra Y.functionField X.functionField := (functionFieldMap g).toAlgebra
  let : Algebra (Y.residueField (g (genericPoint X))) (X.residueField (genericPoint X)) :=
    (g.residueFieldMap (genericPoint X)).hom.toAlgebra
  let := hfin
  let := hsep
  have hc : (algebraMap (Y.residueField (g (genericPoint X)))
        (X.residueField (genericPoint X))).comp (genericResidueEquivOfDominant g).toRingHom =
      (genericResidueEquiv X).toRingHom.comp
        (algebraMap Y.functionField X.functionField) :=
    residueFieldMap_comp_genericResidueEquivOfDominant g
  refine ⟨?_, isSeparableExtension_of_isSeparable _ _
    (Algebra.IsSeparable.of_equiv_equiv (genericResidueEquivOfDominant g)
      (genericResidueEquiv X) hc)⟩
  have hrank := Algebra.finrank_eq_of_equiv_equiv (genericResidueEquivOfDominant g)
    (genericResidueEquiv X) hc
  exact Module.finite_of_finrank_pos (hrank ▸ Module.finrank_pos)

/-! ### Nonconstancy of the morphism attached to a pencil -/

section Charts

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **A ratio that is defined on all of a smooth proper variety has its germ at the generic point
in the compositum of `k` with the `p`-th powers of the function field.** Such a ratio is a global
function, and `AlgebraicGeometry.germToFunctionField_mem_compositumFrobenius` applies to it. -/
private theorem germ_ratio_mem_compositumFrobenius_of_nvCover_eq_top
    (p : ℕ) [Fact p.Prime] [CharP k p] {X : Scheme.{u}} (pX : X ⟶ Spec (.of k))
    [IsVariety k pX] [Smooth pX] [IsProper pX] {L : X.Modules}
    [Stacks.Ample.IsInvertibleModule X L] {ι : Type*} (t : ι → Γ(L, ⊤)) (i j : ι)
    (htop : nvCover t i = ⊤) (hi : genericPoint X ∈ nvCover t i) :
    letI : Algebra k X.functionField :=
      varietyFunctionFieldAlgebra ({ toScheme := X, structureMap := pX } : Variety k)
    X.presheaf.germ (nvCover t i) (genericPoint X) hi (ratio t i j) ∈
      compositumFrobenius k X.functionField p := by
  let : Nonempty (⊤ : X.Opens) := ⟨⟨genericPoint X, trivial⟩⟩
  let : Algebra k X.functionField :=
    varietyFunctionFieldAlgebra ({ toScheme := X, structureMap := pX } : Variety k)
  rw [← X.presheaf.germ_res_apply (homOfLE htop.ge) (genericPoint X) trivial (ratio t i j)]
  exact germToFunctionField_mem_compositumFrobenius p pX _

/-- **If the morphism of [Stacks, Tag 01ND] attached to two sections is constant, then one of the
two chart ratios is a global function.** The two charts are the inverse images of the two
standard opens of the projective line
(`Stacks.ProjectiveFromSections.preimage_basicOpen_eq_nvCover_canonical`), the generic point lies
in one of them, and a constant morphism sends every point to where it sends the generic point. -/
private theorem exists_nvCover_eq_top_of_constant {X : Scheme.{u}} {L : X.Modules}
    [IsIntegral X] [Stacks.Ample.IsInvertibleModule X L] {n : ℕ} (t : Fin (n + 1) → Γ(L, ⊤))
    (hgen : GeneratesStalks t) (hconst : ∃ z : projectiveSpaceAtUniverse.{u} n,
      ∀ x : X, (toProjectiveSpaceAtUniverse t hgen).base x = z) :
    ∃ i, nvCover t i = ⊤ ∧ genericPoint X ∈ nvCover t i := by
  obtain ⟨z, hz⟩ := hconst
  obtain ⟨i, hi⟩ := exists_mem_nvCover_of_generatesStalks t hgen (genericPoint X)
  refine ⟨i, TopologicalSpace.Opens.ext (Set.eq_univ_of_forall fun x => ?_), hi⟩
  have hpre := preimage_basicOpen_eq_nvCover_canonical t hgen i
  have h1 : genericPoint X ∈ toProjectiveSpaceAtUniverse t hgen ⁻¹ᵁ
      AlgebraicGeometry.Proj.basicOpen (coordGrading.{u} n) (MvPolynomial.X i) := by
    rwa [hpre]
  have h2 : x ∈ toProjectiveSpaceAtUniverse t hgen ⁻¹ᵁ
      AlgebraicGeometry.Proj.basicOpen (coordGrading.{u} n) (MvPolynomial.X i) := by
    change (toProjectiveSpaceAtUniverse t hgen).base x ∈
      AlgebraicGeometry.Proj.basicOpen (coordGrading.{u} n) (MvPolynomial.X i)
    rw [hz x, ← hz (genericPoint X)]
    exact h1
  rwa [hpre] at h2

/-- **The morphism to `ℙ¹_k` attached to a pair of generating sections is nonconstant as soon as
their ratio at the generic point is outside the compositum of `k` with the `p`-th powers of the
function field.** Were it constant, one of the two charts would be the whole curve by
`exists_nvCover_eq_top_of_constant`, making one of the two ratios a global function and hence a
member of the compositum by `germ_ratio_mem_compositumFrobenius_of_nvCover_eq_top`; the two
ratios are mutually inverse at the generic point and the compositum is a subfield, so the given
ratio would lie in it either way. -/
private theorem not_constant_toProjectiveSpaceOver_of_notMem_compositumFrobenius
    (p : ℕ) [Fact p.Prime] [CharP k p] {X : Scheme.{u}} (pX : X ⟶ Spec (.of k))
    [IsVariety k pX] [Smooth pX] [IsProper pX] {L : X.Modules}
    [Stacks.Ample.IsInvertibleModule X L] (t : Fin 2 → Γ(L, ⊤)) (hgen : GeneratesStalks t)
    (hη : genericPoint X ∈ nvCover t 0)
    (hnot : letI : Algebra k X.functionField :=
        varietyFunctionFieldAlgebra ({ toScheme := X, structureMap := pX } : Variety k)
      X.presheaf.germ (nvCover t 0) (genericPoint X) hη (ratio t 0 1) ∉
        compositumFrobenius k X.functionField p) :
    ¬ ∃ y : projectiveSpaceOver 1 (Spec (.of k)),
      ∀ x : X, (toProjectiveSpaceOver t hgen pX).base x = y := by
  let : Algebra k X.functionField :=
    varietyFunctionFieldAlgebra ({ toScheme := X, structureMap := pX } : Variety k)
  rintro ⟨y, hy⟩
  have hzc : ∀ x : X, (toProjectiveSpaceAtUniverse t hgen).base x =
      (projectiveSpaceOver.toIntegralAtUniverse 1 (Spec (.of k))).base y := by
    intro x
    rw [← toProjectiveSpaceOver_snd t hgen pX]
    exact (Scheme.Hom.comp_apply _ _ x).trans
      (congrArg (projectiveSpaceOver.toIntegralAtUniverse 1 (Spec (.of k))).base (hy x))
  obtain ⟨i, htop, hi⟩ := exists_nvCover_eq_top_of_constant t hgen ⟨_, hzc⟩
  obtain rfl | rfl : i = 0 ∨ i = 1 := by fin_cases i <;> simp
  · exact hnot (germ_ratio_mem_compositumFrobenius_of_nvCover_eq_top p pX t 0 1 htop hi)
  · have hB := germ_ratio_mem_compositumFrobenius_of_nvCover_eq_top p pX t 1 0 htop hi
    have hle : nvCover t 0 ≤ nvCover t 1 := le_top.trans_eq htop.symm
    have hprod := resO_ratio_mul_resO_ratio t (le_refl (nvCover t 0)) hle
    have h1 := congrArg (ConcreteCategory.hom
      (X.presheaf.germ (nvCover t 0) (genericPoint X) hη)) hprod
    rw [RingHom.map_mul, RingHom.map_one, X.presheaf.germ_res_apply,
      X.presheaf.germ_res_apply] at h1
    exact hnot (eq_inv_of_mul_eq_one_left h1 ▸ Subfield.inv_mem _ hB)

/-- **The germ at the generic point of a chart ratio of `φ_{(L, (s₀, …, sₙ))}` lies in the image
of the function field of `ℙⁿ_k`.** It lies in the image of the stalk map of the morphism to the
integral model by `Stacks.ProjectiveFromSections.germ_ratio_mem_range_stalkMap`, and that stalk
map factors through the stalk map of `φ` itself, whose image is the image of the extension of
function fields up to the identification of the stalk at the image of the generic point with the
function field. -/
private theorem germ_ratio_mem_range_functionFieldMap {X : Scheme.{u}} [IsIntegral X]
    (pX : X ⟶ Spec (.of k)) {L : X.Modules} [Stacks.Ample.IsInvertibleModule X L] {n : ℕ}
    (s : Fin (n + 1) → Γ(L, ⊤)) (hs : GeneratesStalks s) (i j : Fin (n + 1))
    (hη : genericPoint X ∈ nvCover s i)
    [IsIntegral (projectiveSpaceOver n (Spec (.of k)))]
    [IsDominant (toProjectiveSpaceOver s hs pX)] :
    X.presheaf.germ (nvCover s i) (genericPoint X) hη (ratio s i j) ∈
      (functionFieldMap (toProjectiveSpaceOver s hs pX)).range := by
  obtain ⟨w, hw⟩ := germ_ratio_mem_range_stalkMap s hs i j hη
  rw [Scheme.Hom.stalkMap_congr_hom (toProjectiveSpaceAtUniverse s hs)
      (toProjectiveSpaceOver s hs pX ≫
        projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k)))
      (toProjectiveSpaceOver_snd s hs pX).symm (genericPoint X),
    Scheme.Hom.stalkMap_comp] at hw
  set ι := (projectiveSpaceOver n (Spec (.of k))).presheaf.stalkCongr
    (Inseparable.of_eq (map_genericPoint_of_isDominant
      (toProjectiveSpaceOver s hs pX)).symm) with hιdef
  have hinv : ∀ z, ι.hom.hom (ι.inv.hom z) = z := fun z => by
    rw [← ConcreteCategory.comp_apply, ι.inv_hom_id]
    rfl
  have hle : (((toProjectiveSpaceOver s hs pX).stalkMap (genericPoint X)).hom).range ≤
      (functionFieldMap (toProjectiveSpaceOver s hs pX)).range := by
    rintro _ ⟨y, rfl⟩
    refine ⟨ι.inv.hom y, ?_⟩
    change ((toProjectiveSpaceOver s hs pX).stalkMap (genericPoint X)).hom
      (ι.hom.hom (ι.inv.hom y)) = _
    rw [hinv]
  exact hle ⟨_, hw⟩

end Charts

/-- A nonzero first section of an invertible module on a Noetherian integral scheme has the
generic point in its chart. -/
private theorem genericPoint_mem_nvCover_zero_of_ne_zero {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] {L : X.Modules} [Stacks.Ample.IsInvertibleModule X L] {n : ℕ}
    (t : Fin (n + 1) → Γ(L, ⊤)) (h : t 0 ≠ 0) : genericPoint X ∈ nvCover t 0 :=
  mem_nvOpen_genericPoint_of_germ_ne_zero L
    (Stacks.AlgebraicGeometry.ReflexiveModules.Γgerm_genericPoint_ne_zero_of_ne_zero L h)

/-! ### The second alternative: a linear series on the Frobenius twist -/

open Stacks.LinearSeriesMorphism in
/-- **The second alternative of [Stacks, Tag 0CD3].** If every ratio `s_j / s_0` of a basis of the
linear series lies in the compositum of `k` with the `p`-th powers of `k(X)`, then the morphism
`φ_{(ℒ', (s₀, …, s_r))}` of [Stacks, Tag 01ND] factors through the relative Frobenius by
`AlgebraicGeometry.exists_hom_over_comp_eq_toProjectiveSpaceOver`, and the factoring morphism
carries a `𝔤^r_{d'}` on the Frobenius twist with `p · d' = deg ℒ' ≤ d`. -/
private theorem exists_linearSeries_frobeniusTwist_of_forall_mem_compositumFrobenius
    (p : ℕ) [Fact p.Prime] [CharP k p] (hS : IsInCharacteristic (Spec (.of k)) p)
    {X : Scheme.{u}} (pX : X ⟶ Spec (.of k)) [IsCurve k pX] [Smooth pX] [IsProper pX]
    (hdim : topologicalKrullDim X ≤ 1) {d r : ℕ} (E : LinearSeries k pX hdim d r)
    [Stacks.Ample.IsInvertibleModule X E.L] (b : Module.Basis (Fin (r + 1)) k E.V)
    (hη : genericPoint X ∈ nvCover (seriesSections E b) 0)
    (hall : letI : Algebra k X.functionField :=
        varietyFunctionFieldAlgebra ({ toScheme := X, structureMap := pX } : Variety k)
      ∀ j, X.presheaf.germ (nvCover (seriesSections E b) 0) (genericPoint X) hη
          (ratio (seriesSections E b) 0 j) ∈ compositumFrobenius k X.functionField p) :
    letI : IsCurve k ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom :=
      isCurve_frobeniusTwist_curve p hS pX
    letI : IsProper ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom :=
      isProper_frobeniusTwist_curve p hS pX
    ∃ d' : ℕ, p * d' ≤ d ∧ d' ≤ d / p ∧
      Nonempty (LinearSeries k ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom
        (IsCurve.topologicalKrullDim_eq_one (k := k)
          (f := ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom)).le d' r) := by
  let : Algebra k X.functionField :=
    varietyFunctionFieldAlgebra ({ toScheme := X, structureMap := pX } : Variety k)
  let : IsCurve k ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom :=
    isCurve_frobeniusTwist_curve p hS pX
  let : IsProper ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom :=
    isProper_frobeniusTwist_curve p hS pX
  let : Smooth ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom :=
    smooth_frobeniusTwist_curve p hS pX
  let : IsNormal ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).left :=
    isNormal_frobeniusTwist_curve p hS pX
  let : IsDominant (relativeFrobenius (Spec (.of k)) p hS (Over.mk pX)).left :=
    isDominant_of_not_constant k pX ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom
      (relativeFrobenius (Spec (.of k)) p hS (Over.mk pX)).left
      (not_constant_relativeFrobenius_curve p hS pX)
  have hreg : IsRegular X := isRegular_of_smooth_over_field pX
  have : IsLocallyNoetherian X :=
    Stacks.AlgebraicGeometry.CurveEulerBridge.isLocallyNoetherian_of_isProper_over_field k pX
  -- The subsheaf generated by the basis sections, with its generating family.
  obtain ⟨L', hL', j₀, s', hgen', hj₀⟩ := hasGeneratingInvertibleLift_seriesSections hreg E b
  let := hL'
  have hs0 : seriesSections E b 0 ≠ 0 := seriesSections_ne_zero E b 0
  have hs'0 : s' 0 ≠ 0 := fun h0 => hs0 (by rw [← hj₀ 0, h0, map_zero])
  have hη' : genericPoint X ∈ nvCover s' 0 := genericPoint_mem_nvCover_zero_of_ne_zero s' hs'0
  have hratio : ∀ j, X.presheaf.germ (nvCover s' 0) (genericPoint X) hη' (ratio s' 0 j) =
      X.presheaf.germ (nvCover (seriesSections E b) 0) (genericPoint X) hη
        (ratio (seriesSections E b) 0 j) := fun j =>
    germ_ratio_eq_of_app_eq j₀ s' (seriesSections E b) hj₀ 0 j hη' hη
  -- The morphism to `ℙ^r_k` descends along the relative Frobenius.
  obtain ⟨ψ, hψ, hψfac⟩ := exists_hom_over_comp_eq_toProjectiveSpaceOver pX
    ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom
    (relativeFrobenius (Spec (.of k)) p hS (Over.mk pX)).left
    (relativeFrobenius_curve_comp p hS pX) s' hgen' hη'
    (fun j => RingHom.mem_range.mpr (by
      rw [hratio j]
      exact (mem_compositumFrobenius_iff_exists_functionFieldMap_relativeFrobenius
        p hS pX _).mpr (hall j)))
  -- The classes of the generating sections are linearly independent.
  have hbli : LinearIndependent k fun j => ((b j : cohomologyOverField k pX E.L 0)) :=
    b.linearIndependent.map' E.V.subtype (Submodule.ker_subtype _)
  have hli : LinearIndependent k fun j =>
      (cohomologyOverFieldZeroEquivSections k pX L').symm (s' j) := by
    have hcomp : (cohomologyOverFieldMap k pX j₀ 0).hom ∘
        (fun j => (cohomologyOverFieldZeroEquivSections k pX L').symm (s' j)) =
        fun j => ((b j : cohomologyOverField k pX E.L 0)) := by
      funext j
      have h := cohomologyOverFieldZeroEquivSections_cohomologyOverFieldMap k pX j₀
        ((cohomologyOverFieldZeroEquivSections k pX L').symm (s' j))
      rw [Equiv.apply_symm_apply, hj₀ j] at h
      exact (cohomologyOverFieldZeroEquivSections k pX E.L).injective h
    exact LinearIndependent.of_comp (cohomologyOverFieldMap k pX j₀ 0).hom
      (by rwa [hcomp])
  -- The descended linear series and its degree.
  obtain ⟨d', hd', hne⟩ := exists_linearSeries_of_comp_eq_toProjectiveSpaceOver pX
    ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom hdim
    (IsCurve.topologicalKrullDim_eq_one (k := k)
      (f := ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom)).le
    (relativeFrobenius (Spec (.of k)) p hS (Over.mk pX)).left
    (relativeFrobenius_curve_comp p hS pX) (not_constant_relativeFrobenius_curve p hS pX)
    p (degreeOver_relativeFrobenius_curve p hS pX) (Fact.out : p.Prime).one_lt.le
    s' hgen' hli ψ hψ hψfac
  have hj₀ne : j₀ ≠ 0 := by
    intro h0
    refine hs0 ?_
    rw [← hj₀ 0, h0, Scheme.Modules.Hom.zero_app]
    rfl
  have hdegle := invertibleCurveDegree_le_of_hom_ne_zero k pX hdim L' E.L j₀ hj₀ne
  rw [← hd', E.degree_eq] at hdegle
  have hpd : p * d' ≤ d := by exact_mod_cast hdegle
  exact ⟨d', hpd, (Nat.le_div_iff_mul_le (Fact.out : p.Prime).pos).mpr
    (by rwa [mul_comm] at hpd), hne⟩

/-! ### The first alternative: a generically etale pencil -/

open Stacks.LinearSeriesMorphism in
/-- **The first alternative of [Stacks, Tag 0CD3].** If some ratio `s_j / s_0` of a basis of the
linear series escapes the compositum of `k` with the `p`-th powers of `k(X)`, then the pencil
spanned by `s_0` and `s_j` is a `𝔤¹_d` whose morphism to `ℙ¹_k` — the one
[Stacks, Tag 0CCP] attaches to the pencil's basis, pinned here by the comparison `α` — is
generically etale. Nonconstancy of that morphism is
`not_constant_toProjectiveSpaceOver_of_notMem_compositumFrobenius`, hence it is dominant; the
extension of function fields is finite because both are curves and separable by
`isSeparable_of_notMem_compositumFrobenius`, which is clause (5) of the [Stacks, Tag 0C1C]
list. -/
private theorem exists_genericallyEtale_pencil_of_notMem_compositumFrobenius
    (p : ℕ) [Fact p.Prime] [CharP k p]
    {X : Scheme.{u}} (pX : X ⟶ Spec (.of k)) [IsCurve k pX] [Smooth pX] [IsProper pX]
    (hdim : topologicalKrullDim X ≤ 1) {d r : ℕ} (E : LinearSeries k pX hdim d r)
    [Stacks.Ample.IsInvertibleModule X E.L] (b : Module.Basis (Fin (r + 1)) k E.V)
    (hη : genericPoint X ∈ nvCover (seriesSections E b) 0)
    {j : Fin (r + 1)} (hj0 : (0 : Fin (r + 1)) ≠ j)
    (hj : letI : Algebra k X.functionField :=
        varietyFunctionFieldAlgebra ({ toScheme := X, structureMap := pX } : Variety k)
      X.presheaf.germ (nvCover (seriesSections E b) 0) (genericPoint X) hη
        (ratio (seriesSections E b) 0 j) ∉ compositumFrobenius k X.functionField p) :
    ∃ (E₁ : LinearSeries k pX hdim d 1) (b₁ : Module.Basis (Fin 2) k E₁.V)
        (q : X ⟶ projectiveSpaceOver 1 (Spec (.of k)))
        (_ : q ≫ (projectiveSpaceOver 1 (Spec (.of k)) ↘ Spec (.of k)) = pX)
        (α : (Scheme.Modules.pullback
            (q ≫ projectiveSpaceOver.toIntegralAtUniverse 1 (Spec (.of k)))).obj
              (twistingSheafAtUniverse.{u} 1) ⟶ E₁.L),
        (∀ i, α.app ⊤ (pullbackCoordSection.{u}
            (q ≫ projectiveSpaceOver.toIntegralAtUniverse 1 (Spec (.of k))) i) =
          seriesSections E₁ b₁ i) ∧
          ∃ U : X.Opens, Nonempty U ∧ Etale (U.ι ≫ q) := by
  let VX : Variety k := { toScheme := X, structureMap := pX }
  let : Algebra k X.functionField := varietyFunctionFieldAlgebra VX
  let : IsCurve k (projectiveSpaceOver 1 (Spec (.of k)) ↘ Spec (.of k)) :=
    isCurve_projectiveSpaceOver_one k
  let VY : Variety k :=
    { toScheme := projectiveSpaceOver 1 (Spec (.of k))
      structureMap := projectiveSpaceOver 1 (Spec (.of k)) ↘ Spec (.of k) }
  let : Algebra k (projectiveSpaceOver 1 (Spec (.of k))).functionField :=
    varietyFunctionFieldAlgebra VY
  have hreg : IsRegular X := isRegular_of_smooth_over_field pX
  have : IsLocallyNoetherian X :=
    Stacks.AlgebraicGeometry.CurveEulerBridge.isLocallyNoetherian_of_isProper_over_field k pX
  have : Stacks.Ample.IsInvertibleModule X (E.pencil b hj0).L := (E.pencil b hj0).isInvertible
  -- The pencil spanned by the two basis vectors, with its pinned basis.
  obtain ⟨b₁, hb₁⟩ := LinearSeries.exists_basis_seriesSections_pencil E b hj0
  -- The subsheaf generated by the two sections, with its generating pair.
  obtain ⟨L'', hL'', j₁, tt, hgen₁, hj₁⟩ :=
    hasGeneratingInvertibleLift_seriesSections hreg (E.pencil b hj0) b₁
  let := hL''
  have ht0 : tt 0 ≠ 0 := fun h0 =>
    seriesSections_ne_zero (E.pencil b hj0) b₁ 0 (by rw [← hj₁ 0, h0, map_zero])
  have hη₁ : genericPoint X ∈ nvCover tt 0 := genericPoint_mem_nvCover_zero_of_ne_zero tt ht0
  -- The ratio of the pencil's two sections is the ratio `s_j / s_0`.
  have hgermeq : X.presheaf.germ (nvCover tt 0) (genericPoint X) hη₁ (ratio tt 0 1) =
      X.presheaf.germ (nvCover (seriesSections E b) 0) (genericPoint X) hη
        (ratio (seriesSections E b) 0 j) :=
    germ_ratio_eq_of_app_eq j₁ tt (fun i : Fin 2 => seriesSections E b (if i = 0 then 0 else j))
      (fun i => (hj₁ i).trans (hb₁ i)) 0 1 hη₁ hη
  -- The morphism of Tag 0CCP for the pencil, and its dominance.
  have hdom : IsDominant (toProjectiveSpaceOver tt hgen₁ pX) :=
    isDominant_of_not_constant k pX (projectiveSpaceOver 1 (Spec (.of k)) ↘ Spec (.of k))
      (toProjectiveSpaceOver tt hgen₁ pX)
      (not_constant_toProjectiveSpaceOver_of_notMem_compositumFrobenius p pX tt hgen₁ hη₁
        (by rwa [hgermeq]))
  have hq : toProjectiveSpaceOver tt hgen₁ pX ≫
      (projectiveSpaceOver 1 (Spec (.of k)) ↘ Spec (.of k)) = pX :=
    toProjectiveSpaceOver_fst tt hgen₁ pX
  refine ⟨E.pencil b hj0, b₁, toProjectiveSpaceOver tt hgen₁ pX, hq, ?_⟩
  -- The pinned twist comparison of Tag 0CCP.
  obtain ⟨α, hα⟩ : ∃ α : (Scheme.Modules.pullback (toProjectiveSpaceOver tt hgen₁ pX ≫
        projectiveSpaceOver.toIntegralAtUniverse 1 (Spec (.of k)))).obj
          (twistingSheafAtUniverse.{u} 1) ⟶ (E.pencil b hj0).L,
      ∀ i, α.app ⊤ (pullbackCoordSection.{u} (toProjectiveSpaceOver tt hgen₁ pX ≫
          projectiveSpaceOver.toIntegralAtUniverse 1 (Spec (.of k))) i) =
        seriesSections (E.pencil b hj0) b₁ i := by
    rw [toProjectiveSpaceOver_snd tt hgen₁ pX]
    obtain ⟨α₀, hiso, hα₀⟩ :=
      exists_iso_twistingSheafAtUniverse_toProjectiveSpaceAtUniverse tt hgen₁
    exact ⟨α₀ ≫ j₁, fun i => by
      rw [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply, hα₀ i, hj₁ i]⟩
  refine ⟨α, hα, ?_⟩
  -- Generic etaleness, through clause (5) of the Tag 0C1C list.
  have : IsDominant (CategoryTheory.Over.homMk (toProjectiveSpaceOver tt hgen₁ pX) hq :
      Over.mk pX ⟶ Over.mk (projectiveSpaceOver 1 (Spec (.of k)) ↘ Spec (.of k))).left := hdom
  let : Algebra (projectiveSpaceOver 1 (Spec (.of k))).functionField X.functionField :=
    (functionFieldMap (toProjectiveSpaceOver tt hgen₁ pX)).toAlgebra
  have : Module.Finite (projectiveSpaceOver 1 (Spec (.of k))).functionField X.functionField :=
    finiteDimensional_functionField_of_isCurve pX
      (projectiveSpaceOver 1 (Spec (.of k)) ↘ Spec (.of k))
      (toProjectiveSpaceOver tt hgen₁ pX) hq
  have : CharP X.functionField p := charP_functionField p pX
  obtain ⟨ξ, hξ⟩ := germ_ratio_mem_range_functionFieldMap pX tt hgen₁ 0 1 hη₁
  have hsep : Algebra.IsSeparable (projectiveSpaceOver 1 (Spec (.of k))).functionField
      X.functionField :=
    isSeparable_of_notMem_compositumFrobenius p
      (finrank_compositumFrobenius_functionField p pX)
      (fun a => RingHom.mem_fieldRange.mpr ⟨algebraMap k _ a,
        functionFieldMap_algebraMap VX VY (CategoryTheory.Over.homMk _ hq) a⟩)
      (f := ξ) (by rwa [show algebraMap (projectiveSpaceOver 1 (Spec (.of k))).functionField
        X.functionField ξ = functionFieldMap (toProjectiveSpaceOver tt hgen₁ pX) ξ from rfl,
        hξ, hgermeq])
  have htfae := (genericallyEtale_tfae pX
    (projectiveSpaceOver 1 (Spec (.of k)) ↘ Spec (.of k))
    (toProjectiveSpaceOver tt hgen₁ pX) hq).out 5 4
  exact htfae.mp ⟨hdom, genericFiniteSeparable_of_functionField
    (toProjectiveSpaceOver tt hgen₁ pX) inferInstance hsep⟩

/-! ### Stacks Project, Tag 0CD3 -/

open Stacks.LinearSeriesMorphism in
/-- **Stacks Project, Tag 0CD3.** Let `k` be a field of characteristic `p > 0`, let `X` be a
smooth proper curve over `k` and let `(ℒ, V)` be a `𝔤^r_d` on `X` with `r ≥ 1`. Then one of the
following holds: there is a `𝔤¹_d` on `X` whose corresponding morphism `X ⟶ ℙ¹_k` of
[Stacks, Tag 0CCP] is generically etale, or there is a `𝔤^r_{d'}` on the Frobenius twist
`X^{(p)}` with `d' ≤ d / p`.

Which alternative holds is decided by the ratios `s_j / s_0` of a basis `s_0, …, s_r` of `V`,
read at the generic point of `X` as elements of `k(X)`: if they all lie in the compositum of `k`
with the `p`-th powers of `k(X)` — the image of `k(X^{(p)})` — the morphism to `ℙ^r_k` factors
through the relative Frobenius and the second alternative holds; otherwise the pencil spanned by
`s_0` and an offending `s_j` gives the first. -/
@[stacks 0CD3 "both alternatives: a pencil of the same degree whose morphism to the projective \
line is generically etale, or a linear series of the same dimension and degree at most d / p on \
the Frobenius twist"]
theorem exists_genericallyEtale_pencil_or_linearSeries_frobeniusTwist
    (p : ℕ) [Fact p.Prime] [CharP k p] (hS : IsInCharacteristic (Spec (.of k)) p)
    {X : Scheme.{u}} (pX : X ⟶ Spec (.of k)) [IsCurve k pX] [Smooth pX] [IsProper pX]
    (hdim : topologicalKrullDim X ≤ 1) {d r : ℕ} (_hr : 1 ≤ r)
    (E : LinearSeries k pX hdim d r) :
    (∃ (E₁ : LinearSeries k pX hdim d 1) (b₁ : Module.Basis (Fin 2) k E₁.V)
        (q : X ⟶ projectiveSpaceOver 1 (Spec (.of k)))
        (_ : q ≫ (projectiveSpaceOver 1 (Spec (.of k)) ↘ Spec (.of k)) = pX)
        (α : (Scheme.Modules.pullback
            (q ≫ projectiveSpaceOver.toIntegralAtUniverse 1 (Spec (.of k)))).obj
              (twistingSheafAtUniverse.{u} 1) ⟶ E₁.L),
        (∀ i, α.app ⊤ (pullbackCoordSection.{u}
            (q ≫ projectiveSpaceOver.toIntegralAtUniverse 1 (Spec (.of k))) i) =
          seriesSections E₁ b₁ i) ∧
          ∃ U : X.Opens, Nonempty U ∧ Etale (U.ι ≫ q)) ∨
      (letI : IsCurve k ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom :=
          isCurve_frobeniusTwist_curve p hS pX
       letI : IsProper ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom :=
          isProper_frobeniusTwist_curve p hS pX
       ∃ d' : ℕ, p * d' ≤ d ∧ d' ≤ d / p ∧
         Nonempty (LinearSeries k ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom
           (IsCurve.topologicalKrullDim_eq_one (k := k)
             (f := ((frobeniusTwist (Spec (.of k)) p hS).obj (Over.mk pX)).hom)).le d' r)) := by
  classical
  let : Algebra k X.functionField :=
    varietyFunctionFieldAlgebra ({ toScheme := X, structureMap := pX } : Variety k)
  have : Stacks.Ample.IsInvertibleModule X E.L := E.isInvertible
  have : IsLocallyNoetherian X :=
    Stacks.AlgebraicGeometry.CurveEulerBridge.isLocallyNoetherian_of_isProper_over_field k pX
  obtain ⟨b⟩ := nonempty_basis E
  have hη : genericPoint X ∈ nvCover (seriesSections E b) 0 :=
    genericPoint_mem_nvCover_zero_of_ne_zero _ (seriesSections_ne_zero E b 0)
  by_cases hall : ∀ j, X.presheaf.germ (nvCover (seriesSections E b) 0) (genericPoint X) hη
      (ratio (seriesSections E b) 0 j) ∈ compositumFrobenius k X.functionField p
  · exact Or.inr (exists_linearSeries_frobeniusTwist_of_forall_mem_compositumFrobenius
      p hS pX hdim E b hη hall)
  · obtain ⟨j, hj⟩ := not_forall.mp hall
    have hj0 : (0 : Fin (r + 1)) ≠ j := by
      rintro rfl
      apply hj
      rw [ratio_self, map_one]
      exact one_mem _
    exact Or.inl (exists_genericallyEtale_pencil_of_notMem_compositumFrobenius
      p pX hdim E b hη hj0 hj)

end AlgebraicGeometry

