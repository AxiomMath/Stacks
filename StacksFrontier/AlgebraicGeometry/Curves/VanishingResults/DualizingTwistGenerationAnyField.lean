/-!
# Global generation of `ω_X ⊗ ℒ` over an arbitrary base field

In Situation [Stacks, Tag 0B5D], let `ω_X = H^{-1}(f^×(𝒪_{Spec k}))` be the dualizing sheaf of
[Stacks, Tag 0BS2] and let `ℒ` be a very ample invertible `𝒪_X`-module with `deg(ℒ) ≥ 2`.
[Stacks, Tag 0B5H] says that `ω_X ⊗ ℒ` is generated by its global sections. The source proves it
over an algebraically closed field and reduces the general case to that one by base change to
`k̄`; this file performs the reduction, with every ingredient proved.

## Main results

* `CohenMacaulayCurveSituation.nonempty_generatingSections_dualizing_tensorSheaf_anyField`:
  [Stacks, Tag 0B5H] over an arbitrary base field.

## The reduction

* Situation [Stacks, Tag 0B5D] at `X_{k̄}` ([Stacks, Tags 02KH, 01W4, 02FY]) is
  `AlgebraicGeometry.CohenMacaulayCurveSituation.algebraicClosure`;
* very ampleness and the degree of the inverse image of `ℒ` ([Stacks, Tags 0B3F, 0B59]) are
  `isRelativelyVeryAmple_baseChange` and `invertibleCurveDegree_baseChange`;
* the inverse image of `ω_X` is the dualizing sheaf of `X_{k̄}`, part (2) of [Stacks, Tag 0E32],
  is `AlgebraicGeometry.CohenMacaulayCurveSituation.dualizingSheafPullbackIso` of
  `DualizingSheafFieldExtension.lean`;
* `(ω_X ⊗ ℒ)|_{X_{k̄}} = ω_X|_{X_{k̄}} ⊗ ℒ|_{X_{k̄}}` is [Stacks, Tag 01CD],
  `Stacks.RelativeVeryAmple.pullbackTensorModulesIso`;
* global generation descends along the faithfully flat `X_{k̄} ⟶ X` ([Stacks, Tag 0B57]),
  `nonempty_generatingSections_pullback_baseChangeProj_iff`.

The algebraically closed case is
`nonempty_generatingSections_dualizing_tensorSheaf_of_isAlgClosed_coherent`
of `DualizingTwistGenerationCoherent.lean`.

`hFft`, finite type of `ω_X ⊗ ℒ`, is the coherence of `ω_X` (clause (2) of [Stacks, Tag 0BS2]),
equivalently so by `isFiniteType_tensorSheaf_dualizingSheafOverField_iff_isCoherent`; it is part
of the statement.

## References

* [Stacks Project, Tag 0B5H](https://stacks.math.columbia.edu/tag/0B5H)
* [Stacks Project, Tag 0E32](https://stacks.math.columbia.edu/tag/0E32)
* [Stacks Project, Tag 0B57](https://stacks.math.columbia.edu/tag/0B57)
* [Stacks Project, Tag 0B59](https://stacks.math.columbia.edu/tag/0B59)
* [Stacks Project, Tag 0B3F](https://stacks.math.columbia.edu/tag/0B3F)
* [Stacks Project, Tag 01CD](https://stacks.math.columbia.edu/tag/01CD)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

namespace CohenMacaulayCurveSituation

variable (S : CohenMacaulayCurveSituation.{u})

/-- **The inverse image of `ℱ ⊗ ℒ` along `X_K ⟶ X` is of finite type**, for `ℱ ⊗ ℒ` of finite
type on `X` and `ℱ'` identified with the inverse image of `ℱ`: [Stacks, Tag 01B6] and
[Stacks, Tag 01CD]. -/
theorem isFiniteType_tensorSheaf_pullback_baseChangeProj (K : Type u) [Field K] [Algebra S.k K]
    (F L : S.X.Modules)
    (hFL : ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
      Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
        (S.X.ringCatSheaf.property)⟩).obj (F)).obj (L))).IsFiniteType)
    (F' : (S.baseChange K).X.Modules)
    (e : (Scheme.Modules.pullback (S.baseChangeProj K)).obj F ≅ F') :
    ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨(S.baseChange K).X.presheaf,
      Presheaf.isSheaf_of_isSheaf_comp _ ((S.baseChange K).X.presheaf)
        (forget₂ CommRingCat RingCat)
        ((S.baseChange K).X.ringCatSheaf.property)⟩).obj (F')).obj
      ((Scheme.Modules.pullback (S.baseChangeProj K)).obj L))).IsFiniteType :=
  Stacks.Coherent.isFiniteType_of_iso_local
    (Stacks.RelativeVeryAmple.pullbackTensorModulesIso (S.baseChangeProj K) F L ≪≫
      Stacks.RelativeVeryAmple.tensorModulesMapIso (S.baseChange K).X e (Iso.refl _))
    (@SheafOfModules.pullback_isFiniteType _ _ (S.baseChangeProj K).toLRSHom.toShHom _ hFL)

/-- **[Stacks, Tag 0B5H] over an arbitrary base field.** In Situation [Stacks, Tag 0B5D], let
`ω_X = H^{-1}(f^×(𝒪_{Spec k}))` be the dualizing sheaf of [Stacks, Tag 0BS2] and let `ℒ` be a
very ample invertible `𝒪_X`-module with `deg(ℒ) ≥ 2`. Then `ω_X ⊗ ℒ` is generated by its global
sections.

This is the source's reduction to the algebraically closed case by base change to `k̄`, with
part (2) of [Stacks, Tag 0E32] proved as `dualizingSheafPullbackIso`. `hFft` is the coherence of
`ω_X`. -/
theorem nonempty_generatingSections_dualizing_tensorSheaf_anyField
    (L : S.X.Modules) [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L]
    (hL : Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple S.f L)
    (hFft : ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
      Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
        (S.X.ringCatSheaf.property)⟩).obj
      ((Stacks.Duality.dualizingSheafOverField S.f))).obj (L))).IsFiniteType)
    (hd : 2 ≤ invertibleCurveDegree S.k S.f (le_of_eq S.dimension_one) L) :
    Nonempty ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
      Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
        (S.X.ringCatSheaf.property)⟩).obj
      ((Stacks.Duality.dualizingSheafOverField S.f))).obj (L))).GeneratingSections := by
  let : SheafOfModules.IsInvertible S.algebraicClosure.X.presheaf
      S.algebraicClosure.X.ringCatSheaf.2
      ((Scheme.Modules.pullback S.algebraicClosureProj).obj L) :=
    S.isInvertible_pullback_baseChangeProj (AlgebraicClosure S.k) L
  let e := S.dualizingSheafPullbackIso (AlgebraicClosure S.k)
  obtain ⟨G⟩ :=
    S.algebraicClosure.nonempty_generatingSections_dualizing_tensorSheaf_of_isAlgClosed_coherent
      ((Scheme.Modules.pullback S.algebraicClosureProj).obj L)
      (S.isRelativelyVeryAmple_baseChange (AlgebraicClosure S.k) L hL)
      (S.isFiniteType_tensorSheaf_pullback_baseChangeProj (AlgebraicClosure S.k) _ L hFft _ e)
      (hd.trans_eq (S.invertibleCurveDegree_baseChange (AlgebraicClosure S.k) L).symm)
  refine (@nonempty_generatingSections_pullback_baseChangeProj_iff S (AlgebraicClosure S.k) _ _
    _ (S.isQuasicoherent_tensorSheaf_dualizingSheafOverField L)).2 ⟨?_⟩
  refine SheafOfModules.GeneratingSections.equivOfIso ?_ G
  exact (Stacks.RelativeVeryAmple.tensorModulesMapIso S.algebraicClosure.X e (Iso.refl _)).symm ≪≫
    (Stacks.RelativeVeryAmple.pullbackTensorModulesIso S.algebraicClosureProj
      (Stacks.Duality.dualizingSheafOverField S.f) L).symm

end CohenMacaulayCurveSituation

end AlgebraicGeometry

end
