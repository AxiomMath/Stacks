/-- **The inverse image of `ℱ ⊗ ℒ` on `X_{k̄}` is of finite type**, for `ℱ ⊗ ℒ` of finite type on
`X` and `ℱ'` identified with the inverse image of `ℱ`. This is [Stacks, Tag 01B6] for the
inverse image, [Stacks, Tag 01CD] for the inverse image of a tensor product, and transport of
finite type along the resulting isomorphism.

Stated at an arbitrary pair `ℱ, ℒ` of modules rather than at `ω_X` and the module of interest:
at the dualizing sheaf the two sides are large enough terms that unification does not terminate
inside the heartbeat limit. -/
theorem isFiniteType_tensorSheaf_pullback_algebraicClosure (F L : S.X.Modules)
    (hFL : ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
          CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp _ S.X.presheaf
            (CategoryTheory.forget₂ CommRingCat RingCat)
            S.X.ringCatSheaf.property⟩).obj F).obj L)).IsFiniteType)
    (F' : S.algebraicClosure.X.Modules)
    (e : (Scheme.Modules.pullback S.algebraicClosureProj).obj F ≅ F') :
    ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.algebraicClosure.X.presheaf,
          CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp _ S.algebraicClosure.X.presheaf
            (CategoryTheory.forget₂ CommRingCat RingCat)
            S.algebraicClosure.X.ringCatSheaf.property⟩).obj F').obj
        ((Scheme.Modules.pullback S.algebraicClosureProj).obj L))).IsFiniteType :=
  Stacks.Coherent.isFiniteType_of_iso_local
    (Stacks.RelativeVeryAmple.pullbackTensorModulesIso S.algebraicClosureProj F L ≪≫
      Stacks.RelativeVeryAmple.tensorModulesMapIso S.algebraicClosure.X e (Iso.refl _))
    (@SheafOfModules.pullback_isFiniteType _ _ S.algebraicClosureProj.toLRSHom.toShHom _ hFL)

/-- **[Stacks, Tag 0B5H] over an arbitrary base field, granted [Stacks, Tag 0E32].** In Situation
[Stacks, Tag 0B5D], for `ℒ` a very ample invertible `𝒪_X`-module of degree at least two, the
tensor product `ω_X ⊗ ℒ` with the dualizing sheaf of [Stacks, Tag 0BS2] is generated by its
global sections — provided the inverse image of `ω_X` along `X_{k̄} ⟶ X` is the dualizing sheaf
of the base change, which is the isomorphism `e` and is [Stacks, Tag 0E32].

This is the source's own reduction to the algebraically closed case. The base-changed situation,
the very ampleness and degree of the inverse image of `ℒ`, the descent of global generation along
`X_{k̄} ⟶ X` and the identification of the inverse image of `ω_X ⊗ ℒ` with the tensor product of
the inverse images are all discharged; see the module documentation for which tag each is. No
`@[stacks 0B5H]` attribute is attached, because `e` is carried. -/
theorem nonempty_generatingSections_dualizing_tensorSheaf_of_isoAlgebraicClosure_of_isFiniteType
    (L : S.X.Modules) [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L]
    (hL : Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple S.f L)
    (hd : 2 ≤ invertibleCurveDegree S.k S.f (le_of_eq S.dimension_one) L)
    [hFq : ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
          CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp _ S.X.presheaf
            (CategoryTheory.forget₂ CommRingCat RingCat)
            S.X.ringCatSheaf.property⟩).obj
        (Stacks.Duality.dualizingSheafOverField S.f)).obj L)).IsQuasicoherent]
    [hFft : ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
          CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp _ S.X.presheaf
            (CategoryTheory.forget₂ CommRingCat RingCat)
            S.X.ringCatSheaf.property⟩).obj
        (Stacks.Duality.dualizingSheafOverField S.f)).obj L)).IsFiniteType]
    (e : (Scheme.Modules.pullback S.algebraicClosureProj).obj
          (Stacks.Duality.dualizingSheafOverField S.f) ≅
        Stacks.Duality.dualizingSheafOverField S.algebraicClosure.f) :
    Nonempty ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
          CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp _ S.X.presheaf
            (CategoryTheory.forget₂ CommRingCat RingCat)
            S.X.ringCatSheaf.property⟩).obj
        (Stacks.Duality.dualizingSheafOverField S.f)).obj L)).GeneratingSections := by
  let : SheafOfModules.IsInvertible S.algebraicClosure.X.presheaf
      S.algebraicClosure.X.ringCatSheaf.2
      ((Scheme.Modules.pullback S.algebraicClosureProj).obj L) :=
    S.isInvertible_pullback_baseChangeProj (AlgebraicClosure S.k) L
  obtain ⟨G⟩ := S.algebraicClosure.nonempty_generatingSections_dualizing_tensorSheaf_of_isAlgClosed
    ((Scheme.Modules.pullback S.algebraicClosureProj).obj L)
    (S.isRelativelyVeryAmple_baseChange (AlgebraicClosure S.k) L hL)
    (S.isFiniteType_tensorSheaf_pullback_algebraicClosure _ L hFft _ e)
    (hd.trans_eq (S.invertibleCurveDegree_baseChange (AlgebraicClosure S.k) L).symm)
  refine (@nonempty_generatingSections_pullback_baseChangeProj_iff S (AlgebraicClosure S.k) _ _
    ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
          CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp _ S.X.presheaf
            (CategoryTheory.forget₂ CommRingCat RingCat)
            S.X.ringCatSheaf.property⟩).obj
        (Stacks.Duality.dualizingSheafOverField S.f)).obj L)) hFq).2 ⟨?_⟩
  refine SheafOfModules.GeneratingSections.equivOfIso ?_ G
  exact (Stacks.RelativeVeryAmple.tensorModulesMapIso S.algebraicClosure.X e (Iso.refl _)).symm ≪≫
    (Stacks.RelativeVeryAmple.pullbackTensorModulesIso S.algebraicClosureProj
      (Stacks.Duality.dualizingSheafOverField S.f) L).symm

end CohenMacaulayCurveSituation

