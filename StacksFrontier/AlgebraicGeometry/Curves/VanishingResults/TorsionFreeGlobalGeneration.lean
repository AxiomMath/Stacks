/-!
# Global generation of a torsion-free extension of the dualizing sheaf

In Situation [Stacks, Tag 0B5D] — a field `k` and a proper one-dimensional `k`-scheme `X` with
`H⁰(X, 𝒪_X) = k` — assume `X` integral, let `ω_X = H^{-1}(f^×(𝒪_{Spec k}))` be the dualizing
sheaf of [Stacks, Tag 0BS2], and let `0 ⟶ ω_X ⟶ ℱ ⟶ 𝒬 ⟶ 0` be a short exact sequence of
coherent modules with `ℱ` torsion free, `dim Supp 𝒬 ≤ 0` and `dim_k H⁰(X, 𝒬) ≥ 2`.
[Stacks, Tag 0B5G] says that `ℱ` is globally generated. This file runs the source's argument
from the one local fact it needs about `ω_X`: its stalk at the generic point is a simple module
over the function field (that `ω_X` has rank one, proved in
`StacksFrontier/AlgebraicGeometry/Curves/VanishingResults/DualizingSheafGenericStalk.lean`, where
the tag is registered).

## Main definitions

* `AlgebraicGeometry.genericStalkFunctor`: the stalk at the generic point of an integral scheme,
  as a module over the function field. It is exact.

## Main results

The prefix `AlgebraicGeometry.CohenMacaulayCurveSituation` is elided from the last three.

* `AlgebraicGeometry.genericPoint_mem_supp_of_mono_of_isTorsionFree`: a nonzero submodule of a
  torsion-free coherent module on a locally Noetherian integral scheme contains the generic point
  in its support.
* `topologicalKrullDim_supp_le_zero_iff`: on the integral curve, a coherent module has
  zero-dimensional support exactly when its generic stalk vanishes.
* `isZero_cokernel_of_globalSectionsHom_eq`: the core of the source's proof — the submodule
  generated by the global sections is everything.
* `epi_globalSectionsHom_of_isSimpleModule_genericStalk`: [Stacks, Tag 0B5G] from the simplicity
  of the generic stalk of `ω_X`.

## Implementation notes

*Rank one.* The source's two appeals to rank — "`ℱ' ⊆ ℱ` is an inclusion of rank one sheaves, so
`ℱ/ℱ'` is supported in finitely many points" and "a nonzero endomorphism of a torsion-free rank one
sheaf on a proper curve is an automorphism (details omitted)" — are both read at the generic point
`η`. The stalk functor at `η` is exact (`genericStalkFunctor`), the stalk of `ℱ` at `η` is that of
`ω_X` because `𝒬` vanishes there, and every nonzero submodule of `ℱ` has nonzero stalk at `η`
(torsion freeness, through associated points: [Stacks, Tags 05AE, 05AG, 0AXY]). So a nonzero
submodule of `ℱ` has the whole stalk at `η`, and its cokernel has zero-dimensional support. For the
endomorphism `ψ` of `ℱ'` the omitted details are: `ψ` is injective (it is so at `η`, and its kernel
is a submodule of `ℱ`), its cokernel `𝒞` has zero-dimensional support, and in the long exact
sequence of `0 ⟶ ℱ' ⟶ ℱ' ⟶ 𝒞 ⟶ 0` the endomorphisms `H⁰(ψ)` and `H¹(ψ)` of finite-dimensional
spaces ([Stacks, Tag 02O6]) are injective, resp. surjective, hence bijective, which leaves
`H⁰(X, 𝒞) = 0`, so `𝒞 = 0`.

*The submodule generated by global sections.* It is presented as a monomorphism `ι : ℱ' ⟶ ℱ`
with an epimorphism `e` from the free module on `Γ(X, ℱ)` and `e ≫ ι = globalSectionsHom ℱ`; the
abelian image of `globalSectionsHom ℱ` is one such presentation. A morphism into `ℱ` whose source
is a quotient of that free module lands in `ℱ'` (`comp_eq_zero_of_globalSectionsHom_comp_eq_zero`).

## References

* [Stacks Project, Tag 0B5G](https://stacks.math.columbia.edu/tag/0B5G)
* [Stacks Project, Tag 0B5F](https://stacks.math.columbia.edu/tag/0B5F)
* [Stacks Project, Tag 0BS2](https://stacks.math.columbia.edu/tag/0BS2)
* [Stacks Project, Tag 02O6](https://stacks.math.columbia.edu/tag/02O6)
* [Stacks Project, Tag 0AVR](https://stacks.math.columbia.edu/tag/0AVR)
* [Stacks Project, Tag 0AXY](https://stacks.math.columbia.edu/tag/0AXY)
-/

@[expose] public noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits

/-! ### Simple modules -/

namespace ModuleCat

/-- A monomorphism from a nonzero module into a simple module is an epimorphism. -/
public theorem epi_of_mono_of_isSimpleModule {R : Type u} [Ring R]
    {M N : ModuleCat.{u} R} [IsSimpleModule R N] (f : M ⟶ N) [Mono f] (hM : Nontrivial M) :
    Epi f := by
  have hinj : Function.Injective f.hom := (ModuleCat.mono_iff_injective f).mp inferInstance
  rcases IsSimpleOrder.eq_bot_or_eq_top (LinearMap.range f.hom) with h | h
  · exfalso
    obtain ⟨m, hm⟩ := exists_ne (0 : M)
    have hmem : f.hom m ∈ LinearMap.range f.hom := LinearMap.mem_range_self _ m
    rw [h, Submodule.mem_bot] at hmem
    exact hm (hinj (hmem.trans (map_zero f.hom).symm))
  · exact (ModuleCat.epi_iff_surjective f).mpr (LinearMap.range_eq_top.mp h)

/-- A nonzero morphism out of a simple module is a monomorphism. -/
public theorem mono_of_ne_zero_of_isSimpleModule {R : Type u} [Ring R]
    {M N : ModuleCat.{u} R} [IsSimpleModule R M] (f : M ⟶ N) (hf : f ≠ 0) : Mono f := by
  rcases IsSimpleOrder.eq_bot_or_eq_top (LinearMap.ker f.hom) with h | h
  · exact (ModuleCat.mono_iff_injective f).mpr (LinearMap.ker_eq_bot.mp h)
  · exfalso
    refine hf (ModuleCat.hom_ext (LinearMap.ext fun m => ?_))
    have hm : m ∈ LinearMap.ker f.hom := by simp [h]
    simpa using hm

/-- A monomorphism of modules which is zero has zero source. The monomorphism is an explicit
argument, which is how the callers below supply it. -/
public theorem isZero_of_mono_of_eq_zero {R : Type u} [Ring R] {M N : ModuleCat.{u} R}
    (f : M ⟶ N) (hf : Mono f) (h : f = 0) : IsZero M :=
  IsZero.of_mono_eq_zero f h

end ModuleCat

namespace AlgebraicGeometry

/-! ### The support at the generic point -/

/-- A point lies in the support of a module exactly when the stalk there, read as a module over
the local ring, is nonzero. -/
public theorem mem_supp_iff_not_isZero_schemeStalkModuleFunctor_obj {X : Scheme.{u}}
    (G : X.Modules) (x : X) :
    x ∈ SheafOfModules.supp G ↔ ¬ IsZero ((Stacks.Duality.schemeStalkModuleFunctor x).obj G) := by
  rw [ModuleCat.isZero_iff_subsingleton, not_subsingleton_iff_nontrivial]
  exact SheafOfModules.mem_supp_iff_nontrivial_stalk G x

/-- On an integral scheme a closed set containing the generic point is everything. -/
public theorem eq_univ_of_isClosed_of_genericPoint_mem {X : Scheme.{u}} [IsIntegral X]
    {Z : Set X} (hZ : IsClosed Z) (hη : genericPoint X ∈ Z) : Z = Set.univ :=
  Set.eq_univ_of_univ_subset (((genericPoint_spec X).mem_closed_set_iff hZ).mp hη)

/-- **A nonzero submodule of a torsion-free coherent module on a locally Noetherian integral
scheme is supported at the generic point.** Its associated points are associated points of the
ambient module ([Stacks, Tag 05AE]), which is the generic point alone by [Stacks, Tag 0AXY], and
a nonzero quasi-coherent module has an associated point ([Stacks, Tag 05AG]). -/
public theorem genericPoint_mem_supp_of_mono_of_isTorsionFree {X : Scheme.{u}}
    [IsLocallyNoetherian X] [IsIntegral X] {M F : X.Modules} [M.IsQuasicoherent]
    (hF : F.IsCoherent) (hTF : Stacks.AlgebraicGeometry.ReflexiveModules.IsTorsionFree F)
    (u : M ⟶ F) [Mono u] (hM : ¬ IsZero M) : genericPoint X ∈ SheafOfModules.supp M := by
  obtain ⟨x, hx⟩ : (Stacks.Divisors.associatedPoints M).Nonempty :=
    Set.nonempty_iff_ne_empty.mpr fun h => hM ((isZero_iff_associatedPoints_eq_empty X M).mpr h)
  have hxF := associatedPoints_subset_of_mono u hx
  have hsupp : (SheafOfModules.supp F).Nonempty := ⟨x, associatedPoints_subset_support F hxF⟩
  have h12 := ((Stacks.AlgebraicGeometry.ReflexiveModules.isTorsionFree_tfae X F hsupp).out
    1 2).mp hTF
  rw [h12, Set.mem_singleton_iff] at hxF
  subst hxF
  exact associatedPoints_subset_support M hx

/-! ### The stalk at the generic point -/

/-- The stalk at the generic point of an integral scheme, as a module over the function field:
`Stacks.Duality.schemeStalkModuleFunctor` at the generic point, read on `X.Modules`. -/
public def genericStalkFunctor (X : Scheme.{u}) [IsIntegral X] :
    X.Modules ⥤ ModuleCat.{u} X.functionField :=
  Stacks.Duality.schemeStalkModuleFunctor (genericPoint X)

/-- The generic stalk functor preserves finite limits. -/
public instance genericStalkFunctor_preservesFiniteLimits (X : Scheme.{u}) [IsIntegral X] :
    PreservesFiniteLimits (genericStalkFunctor X) :=
  Stacks.Duality.schemeStalkModuleFunctor_preservesFiniteLimits _

/-- The generic stalk functor preserves finite colimits. -/
public instance genericStalkFunctor_preservesFiniteColimits (X : Scheme.{u}) [IsIntegral X] :
    PreservesFiniteColimits (genericStalkFunctor X) :=
  Stacks.Duality.schemeStalkModuleFunctor_preservesFiniteColimits _

/-- The generic stalk functor is additive. -/
public instance genericStalkFunctor_additive (X : Scheme.{u}) [IsIntegral X] :
    (genericStalkFunctor X).Additive :=
  Stacks.Duality.schemeStalkModuleFunctor_additive _

/-- The generic point lies in the support of a module exactly when its generic stalk is
nonzero. -/
public theorem genericPoint_mem_supp_iff {X : Scheme.{u}} [IsIntegral X] (G : X.Modules) :
    genericPoint X ∈ SheafOfModules.supp G ↔ ¬ IsZero ((genericStalkFunctor X).obj G) :=
  mem_supp_iff_not_isZero_schemeStalkModuleFunctor_obj G _

/-- The cokernel of a morphism that becomes an epimorphism at the generic point is not supported
there. -/
public theorem genericPoint_notMem_supp_cokernel {X : Scheme.{u}} [IsIntegral X]
    {M F : X.Modules} (u : M ⟶ F) [Epi ((genericStalkFunctor X).map u)] :
    genericPoint X ∉ SheafOfModules.supp (cokernel u) := by
  refine fun h => (genericPoint_mem_supp_iff _).mp h ?_
  have h0 : (genericStalkFunctor X).map (cokernel.π u) = 0 := by
    rw [← cancel_epi ((genericStalkFunctor X).map u), ← Functor.map_comp, cokernel.condition,
      Functor.map_zero, comp_zero]
  have hsurj : Function.Surjective ((genericStalkFunctor X).map (cokernel.π u)).hom :=
    (ModuleCat.epi_iff_surjective _).mp (Functor.map_epi _ _)
  rw [ModuleCat.isZero_iff_subsingleton]
  refine ⟨fun a b => ?_⟩
  obtain ⟨a, rfl⟩ := hsurj a
  obtain ⟨b, rfl⟩ := hsurj b
  rw [h0]
  rfl

namespace CohenMacaulayCurveSituation

variable {S : CohenMacaulayCurveSituation.{u}}

/-- **In Situation [Stacks, Tag 0B5D] with `X` integral, a coherent module has support of
dimension at most zero exactly when the generic point is not in its support.** The support is
closed; a closed set containing the generic point is all of `X`, of dimension one, and a closed
set missing it is a proper closed subset of an irreducible space of dimension one. -/
public theorem topologicalKrullDim_supp_le_zero_iff [IsIntegral S.X] {G : S.X.Modules}
    (hG : G.IsCoherent) :
    topologicalKrullDim (SheafOfModules.supp G) ≤ 0 ↔
      genericPoint S.X ∉ SheafOfModules.supp G := by
  have hcl := Stacks.AlgebraicGeometry.DevissageNoetherian.isClosed_supp_of_isCoherent G hG
  refine ⟨fun h hη => ?_, fun hη => topologicalKrullDim_le_zero_of_isClosed_of_ne_univ
    S.dimension_one.le _ hcl fun h => hη (h ▸ Set.mem_univ _)⟩
  have huniv := eq_univ_of_isClosed_of_genericPoint_mem hcl hη
  have hd : topologicalKrullDim (SheafOfModules.supp G) = 1 := by
    rw [← S.dimension_one]
    have e : SheafOfModules.supp G ≃ₜ S.X := (Homeomorph.setCongr huniv).trans
      (Homeomorph.Set.univ S.X)
    exact IsHomeomorph.topologicalKrullDim_eq e e.isHomeomorph
  rw [hd] at h
  exact absurd h (by decide)

/-- The cokernel of a monomorphism sits in a short exact sequence. -/
private theorem shortExact_cokernel_sequence {X : Scheme.{u}} {M F : X.Modules} (u : M ⟶ F)
    [Mono u] : (ShortComplex.mk u (cokernel.π u) (cokernel.condition u)).ShortExact :=
  ShortComplex.ShortExact.mk' (ShortComplex.cokernelSequence_exact u) inferInstance inferInstance

/-- The cokernel of a morphism into a coherent module that is onto at the generic point is
coherent with zero-dimensional support. -/
private theorem isCoherent_and_dim_supp_cokernel_le_zero [IsIntegral S.X]
    [IsLocallyNoetherian S.X] {M F : S.X.Modules}
    [M.IsQuasicoherent] [F.IsQuasicoherent] (hF : F.IsCoherent) (u : M ⟶ F)
    [Epi ((genericStalkFunctor S.X).map u)] :
    (cokernel u).IsCoherent ∧ topologicalKrullDim (SheafOfModules.supp (cokernel u)) ≤ 0 := by
  have hc : (cokernel u).IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_epi_of_isQuasicoherent hF
      (cokernel.π u)
  exact ⟨hc, (topologicalKrullDim_supp_le_zero_iff hc).mpr (genericPoint_notMem_supp_cokernel u)⟩

/-- A monomorphism out of a module supported at the generic point is nonzero at the generic
stalk. -/
private theorem genericStalkFunctor_map_ne_zero_of_mono {X : Scheme.{u}} [IsIntegral X]
    {M F : X.Modules} (u : M ⟶ F) [Mono u] (h : genericPoint X ∈ SheafOfModules.supp M) :
    (genericStalkFunctor X).map u ≠ 0 := fun h0 =>
  (genericPoint_mem_supp_iff _).mp h
    (ModuleCat.isZero_of_mono_of_eq_zero _ (Functor.map_mono (genericStalkFunctor X) u) h0)

/-- **A morphism out of a free module factors through the module of global sections.** For
`h : 𝒪_X^{(J)} ⟶ ℱ`, the images of the basis vectors are global sections of `ℱ`, so `h` is the
map `𝒪_X^{(J)} ⟶ 𝒪_X^{(Γ(X, ℱ))}` they define followed by `globalSectionsHom ℱ`. -/
public theorem eq_freeMap_comp_globalSectionsHom {X : Scheme.{u}} {F : X.Modules}
    (h : globalSectionsFree F ⟶ F) :
    h = (SheafOfModules.freeMap (R := X.ringCatSheaf)
        ((F : SheafOfModules X.ringCatSheaf).freeHomEquiv h) :
          globalSectionsFree F ⟶ globalSectionsFree F) ≫ globalSectionsHom F := by
  apply (F : SheafOfModules X.ringCatSheaf).freeHomEquiv.injective
  funext j
  refine Eq.trans ?_ (SheafOfModules.freeHomEquiv_comp_apply (R := X.ringCatSheaf)
    (SheafOfModules.freeMap (R := X.ringCatSheaf)
      ((F : SheafOfModules X.ringCatSheaf).freeHomEquiv h)) (globalSectionsHom F) j).symm
  rw [SheafOfModules.freeHomEquiv_freeMap, Function.comp_apply]
  exact (SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection (R := X.ringCatSheaf)
    (fun s => s) _).symm

/-- A morphism killed by `globalSectionsHom ℱ` kills every morphism into `ℱ` out of the free
module on the global sections of `ℱ`. -/
public theorem comp_eq_zero_of_globalSectionsHom_comp_eq_zero {X : Scheme.{u}} {F G : X.Modules}
    (p : F ⟶ G) (hp : globalSectionsHom F ≫ p = 0) (h : globalSectionsFree F ⟶ F) :
    h ≫ p = 0 := by
  obtain ⟨t, rfl⟩ : ∃ t : globalSectionsFree F ⟶ globalSectionsFree F,
      h = t ≫ globalSectionsHom F := ⟨_, eq_freeMap_comp_globalSectionsHom h⟩
  rw [Category.assoc, hp, comp_zero]

/-- **The rank-one step.** In Situation [Stacks, Tag 0B5D] with `X` integral, let `ℱ` be a
torsion-free coherent module whose stalk at the generic point is a simple module. Then a nonzero
quasi-coherent submodule of `ℱ` has the same stalk at the generic point. -/
public theorem isIso_map_genericStalk_of_mono [IsIntegral S.X] {M F : S.X.Modules}
    [M.IsQuasicoherent] (hF : F.IsCoherent)
    (hTF : Stacks.AlgebraicGeometry.ReflexiveModules.IsTorsionFree F)
    (hsimple : IsSimpleModule S.X.functionField ((genericStalkFunctor S.X).obj F))
    (u : M ⟶ F) [Mono u] (hM : ¬ IsZero M) :
    IsIso ((genericStalkFunctor S.X).map u) := by
  have : IsLocallyNoetherian S.X := LocallyOfFiniteType.isLocallyNoetherian S.f
  have hη := (genericPoint_mem_supp_iff M).mp
    (genericPoint_mem_supp_of_mono_of_isTorsionFree hF hTF u hM)
  rw [ModuleCat.isZero_iff_subsingleton, not_subsingleton_iff_nontrivial] at hη
  have : Epi ((genericStalkFunctor S.X).map u) :=
    ModuleCat.epi_of_mono_of_isSimpleModule _ hη
  exact isIso_of_mono_of_epi _

/-- **The core of the proof of [Stacks, Tag 0B5G].** In Situation [Stacks, Tag 0B5D] with `X`
integral, let `0 ⟶ ω_X ⟶ ℱ ⟶ 𝒬 ⟶ 0` be short exact with `ℱ` coherent and torsion free and
`𝒬 ≠ 0`, and let `ℱ' ⊆ ℱ` be the submodule generated by the global sections, presented as
`ι : ℱ' ⟶ ℱ` together with an epimorphism `e` from the free module on `Γ(X, ℱ)` with
`e ≫ ι = globalSectionsHom ℱ`. If `ℱ' ⟶ 𝒬` is onto and the generic stalk of `ℱ'` is simple,
then `ℱ' = ℱ`.

The quotient `𝒬' = ℱ/ℱ'` vanishes at the generic point, so it has zero-dimensional support.
Were it nonzero, it would have a nonzero global section, which, since every global section of
`ℱ` lies in `ℱ'`, gives `H¹(X, ℱ') ≠ 0`, hence a nonzero `φ : ℱ' ⟶ ω_X` by duality. The composite
`ℱ' ⟶ ω_X ⟶ ℱ` lands in `ℱ'` (its source is generated by global sections), giving an
endomorphism `ψ` of `ℱ'`. Both `φ` and `ψ` are injective, because a nonzero submodule of `ω_X`
and every nonzero submodule of `ℱ` live at the generic point, where all stalks are the same
simple module; and `ψ` is onto, because its cokernel has zero-dimensional support and the long
exact sequence of `0 ⟶ ℱ' ⟶ ℱ' ⟶ coker ψ ⟶ 0` leaves it no global sections. So `ℱ' ⊆ ω_X`,
and `ℱ' ⟶ 𝒬` is zero, which it is not. -/
public theorem isZero_cokernel_of_globalSectionsHom_eq [IsIntegral S.X] {F Q I : S.X.Modules}
    (hFc : F.IsCoherent) (hTF : Stacks.AlgebraicGeometry.ReflexiveModules.IsTorsionFree F)
    (α : Stacks.Duality.dualizingSheafOverField S.f ⟶ F) (β : F ⟶ Q) (hαβ : α ≫ β = 0)
    [Mono α] (hQnz : ¬ IsZero Q) (hIc : I.IsCoherent) (ι : I ⟶ F) [Mono ι]
    (e : globalSectionsFree F ⟶ I) [Epi e] (he : e ≫ ι = globalSectionsHom F)
    (hιβ : Epi (ι ≫ β))
    (hsimpleI : IsSimpleModule S.X.functionField ((genericStalkFunctor S.X).obj I))
    (hιiso : IsIso ((genericStalkFunctor S.X).map ι)) :
    IsZero (cokernel ι) := by
  have : IsLocallyNoetherian S.X := LocallyOfFiniteType.isLocallyNoetherian S.f
  have := Stacks.Duality.isQuasicoherent_dualizingSheafOverField S.f
  have hωc : (Stacks.Duality.dualizingSheafOverField S.f).IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_mono_of_isQuasicoherent hFc α
  have hFq : F.IsQuasicoherent :=
    (Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent F).1
  have hIq : I.IsQuasicoherent :=
    (Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent I).1
  have hfin : ∀ (G : S.X.Modules), G.IsCoherent → ∀ n,
      FiniteDimensional S.k (cohomologyOverField S.k S.f G n) :=
    forall_finiteDimensional_cohomologyOverField_of_isProper S.k S.f
  have hInt : Nontrivial ((genericStalkFunctor S.X).obj I) :=
    IsSimpleModule.nontrivial S.X.functionField ((genericStalkFunctor S.X).obj I)
  /- `𝒬' = ℱ/ℱ'` has zero-dimensional support. -/
  obtain ⟨hQ'c, hQ'dim⟩ := isCoherent_and_dim_supp_cokernel_le_zero (S := S) hFc ι
  by_contra hQ'nz
  /- Then `H¹(X, ℱ') ≠ 0`. -/
  have hH0 : ¬ IsZero (cohomologyOverField S.k S.f (cokernel ι) 0) := fun h =>
    hQ'nz (isZero_of_supp_dim_le_zero_of_isZero_sections hQ'c hQ'dim h)
  have hT := shortExact_cokernel_sequence ι
  have hgπ : globalSectionsHom F ≫ cokernel.π ι = 0 := by
    rw [← he, Category.assoc, cokernel.condition, comp_zero]
  have hzero : ∀ a, cohomologyOverFieldMap S.k S.f (cokernel.π ι) 0 a = 0 :=
    cohomologyOverFieldMap_zero_eq_zero_of_globalSectionsHom_comp S.f (cokernel.π ι) hgπ
  have hle := finrank_zeroth_le_finrank_first hT (hfin _ hIc 1) hzero
  dsimp only at hle
  have hpos : 0 < Module.finrank S.k (cohomologyOverField S.k S.f (cokernel ι) 0) := by
    have := hfin _ hQ'c 0
    have : Nontrivial (cohomologyOverField S.k S.f (cokernel ι) 0) :=
      not_subsingleton_iff_nontrivial.mp fun h => hH0 (ModuleCat.isZero_of_subsingleton _)
    exact Module.finrank_pos
  have hH1 : Nontrivial (cohomologyOverField S.k S.f I 1) :=
    Module.nontrivial_of_finrank_pos (R := S.k) (lt_of_lt_of_le hpos hle)
  /- A nonzero map `φ : ℱ' ⟶ ω_X`, by duality. -/
  obtain ⟨v, hv⟩ := exists_ne (0 : cohomologyOverField S.k S.f I 1)
  obtain ⟨φf, hφf⟩ : ∃ φf : Module.Dual S.k (cohomologyOverField S.k S.f I 1), φf v ≠ 0 := by
    by_contra h
    push Not at h
    exact hv ((Module.forall_dual_apply_eq_zero_iff S.k v).mp h)
  obtain ⟨φ, hφ⟩ : ∃ φ : I ⟶ Stacks.Duality.dualizingSheafOverField S.f, φ ≠ 0 := by
    refine ⟨((firstCohomologyDuality_dualizingSheafOverField S).dual I hIq).symm φf, fun h => ?_⟩
    have h1 := AddEquiv.apply_symm_apply ((firstCohomologyDuality_dualizingSheafOverField S).dual
      I hIq) φf
    rw [h, map_zero] at h1
    exact hφf (by rw [← h1]; rfl)
  /- `ℱ' ⟶ ω_X ⟶ ℱ` lands in `ℱ'`, giving an endomorphism `ψ` of `ℱ'`. -/
  have hfac : (φ ≫ α) ≫ cokernel.π ι = 0 := by
    rw [← cancel_epi e, comp_zero, ← Category.assoc, ← Category.assoc]
    exact comp_eq_zero_of_globalSectionsHom_comp_eq_zero (cokernel.π ι) hgπ _
  obtain ⟨ψ, hψ⟩ : ∃ ψ : I ⟶ I, ψ ≫ ι = φ ≫ α :=
    ⟨Abelian.monoLift ι (φ ≫ α) hfac, Abelian.monoLift_comp ι (φ ≫ α) hfac⟩
  /- `φ` is a monomorphism: its image is a nonzero submodule of `ω_X`, so it is nonzero at the
  generic point, hence injective there, and its kernel, a submodule of `ℱ`, vanishes. -/
  have hφmono : Mono φ := by
    have hJc : (Abelian.image φ).IsCoherent :=
      Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_mono_of_isQuasicoherent hωc
        (Abelian.image.ι φ)
    have hJnz : ¬ IsZero (Abelian.image φ) := fun hJ => hφ (by
      rw [← Abelian.image.fac φ, hJ.eq_of_src (Abelian.image.ι φ) 0, comp_zero])
    have hηJ : genericPoint S.X ∈ SheafOfModules.supp (Abelian.image φ) := by
      by_contra hη
      exact hJnz (Stacks.Duality.isZero_of_mono_dualizingSheafOverField_of_supp_dim_le_zero S.f
        (le_of_eq S.dimension_one) _ (Abelian.image.ι φ) (by infer_instance) hJc
        ((topologicalKrullDim_supp_le_zero_iff hJc).mpr hη))
    have hStφ : (genericStalkFunctor S.X).map φ ≠ 0 := by
      intro h0
      rw [← Abelian.image.fac φ, Functor.map_comp] at h0
      have : Epi ((genericStalkFunctor S.X).map (Abelian.factorThruImage φ)) :=
        Functor.map_epi _ _
      have h1 : (genericStalkFunctor S.X).map (Abelian.image.ι φ) = 0 := by
        rw [← cancel_epi ((genericStalkFunctor S.X).map (Abelian.factorThruImage φ)), h0,
          comp_zero]
      exact genericStalkFunctor_map_ne_zero_of_mono (Abelian.image.ι φ) hηJ h1
    have : Mono ((genericStalkFunctor S.X).map φ) :=
      ModuleCat.mono_of_ne_zero_of_isSimpleModule _ hStφ
    have hK : IsZero (kernel φ) := by
      by_contra hKnz
      have hη := genericPoint_mem_supp_of_mono_of_isTorsionFree hFc hTF (kernel.ι φ ≫ ι) hKnz
      refine genericStalkFunctor_map_ne_zero_of_mono (kernel.ι φ) hη ?_
      rw [← cancel_mono ((genericStalkFunctor S.X).map φ), ← Functor.map_comp,
        kernel.condition, Functor.map_zero, zero_comp]
    exact Abelian.mono_of_kernel_ι_eq_zero φ (hK.eq_of_src _ _)
  have hψmono : Mono ψ := by
    have : Mono (ψ ≫ ι) := by rw [hψ]; exact mono_comp φ α
    exact mono_of_mono ψ ι
  /- `ψ` is an isomorphism: it is one at the generic point, so its cokernel has
  zero-dimensional support, and the long exact sequence forces that cokernel to vanish. -/
  have : Mono ((genericStalkFunctor S.X).map ψ) := Functor.map_mono _ _
  have : Epi ((genericStalkFunctor S.X).map ψ) :=
    ModuleCat.epi_of_mono_of_isSimpleModule _ hInt
  obtain ⟨hCc, hCdim⟩ := isCoherent_and_dim_supp_cokernel_le_zero (S := S) hIc ψ
  have hC : IsZero (cokernel ψ) := by
    have hT2 := shortExact_cokernel_sequence ψ
    obtain ⟨d, hinj0, hfg, hgd, hdf⟩ := exists_cohomologyOverField_longExactSequence S.k S.f hT2
    have := hfin _ hIc 0
    have := hfin _ hIc 1
    have hsurj0 : Function.Surjective (cohomologyOverFieldMap S.k S.f ψ 0) :=
      LinearMap.injective_iff_surjective.mp hinj0
    have hinj1 : Function.Injective (cohomologyOverFieldMap S.k S.f ψ 1) :=
      LinearMap.injective_iff_surjective.mpr
        (surjective_cohomologyOverFieldMap_f_of_isZero hT2 1
          (isZero_firstCohomology_of_supp_dim_le_zero hCc hCdim))
    refine isZero_of_supp_dim_le_zero_of_isZero_sections hCc hCdim ?_
    rw [ModuleCat.isZero_iff_subsingleton]
    have hall : ∀ c : cohomologyOverField S.k S.f (cokernel ψ) 0, c = 0 := by
      intro c
      have hdc : d 0 c = 0 := by
        have h1 : cohomologyOverFieldMap S.k S.f ψ 1 (d 0 c) = 0 := (hdf 0 (d 0 c)).mpr ⟨c, rfl⟩
        exact hinj1 (h1.trans (map_zero _).symm)
      obtain ⟨x, rfl⟩ := (hgd 0 c).mp hdc
      obtain ⟨y, rfl⟩ := hsurj0 x
      exact (hfg 0 _).mpr ⟨y, rfl⟩
    exact ⟨fun a b => (hall a).trans (hall b).symm⟩
  have : Epi ψ := epi_of_isZero_cokernel ψ hC
  have : IsIso ψ := isIso_of_mono_of_epi ψ
  /- Then `ℱ' ⊆ ω_X`, so `ℱ' ⟶ 𝒬` vanishes, which it does not. -/
  have hι : ι = inv ψ ≫ φ ≫ α := by rw [← hψ, IsIso.inv_hom_id_assoc]
  have hιβ0 : ι ≫ β = 0 := by
    rw [hι, Category.assoc, Category.assoc, hαβ, comp_zero, comp_zero]
  exact hQnz (IsZero.of_epi_eq_zero (ι ≫ β) hιβ0)

/-- **Stacks Project, Tag 0B5G, granted that the generic stalk of `ω_X` is simple.** In
Situation [Stacks, Tag 0B5D] with `X` integral, let `0 ⟶ ω_X ⟶ ℱ ⟶ 𝒬 ⟶ 0` be a short exact
sequence of coherent modules with `ℱ` torsion free, `dim Supp 𝒬 ≤ 0` and `dim_k H⁰(X, 𝒬) ≥ 2`.
If the stalk of `ω_X` at the generic point is a simple module over the function field, then `ℱ`
is generated by its global sections.

The submodule `ℱ'` generated by the global sections surjects onto `𝒬` by [Stacks, Tag 0B5F],
whose hypothesis holds because a submodule of `ℱ` injecting into `𝒬` has zero-dimensional
support, and `ℱ` is torsion free. The generic stalk of `ℱ` is that of `ω_X`, since `𝒬` vanishes
there, and `ℱ' ≠ 0`; the rest is
`AlgebraicGeometry.CohenMacaulayCurveSituation.isZero_cokernel_of_globalSectionsHom_eq`. -/
public theorem epi_globalSectionsHom_of_isSimpleModule_genericStalk [IsIntegral S.X]
    (hsimple : IsSimpleModule S.X.functionField
      ((genericStalkFunctor S.X).obj (Stacks.Duality.dualizingSheafOverField S.f)))
    {F Q : S.X.Modules} (hFq : F.IsQuasicoherent) (hFft : F.IsFiniteType)
    (hQq : Q.IsQuasicoherent) (α : Stacks.Duality.dualizingSheafOverField S.f ⟶ F) (β : F ⟶ Q)
    (hαβ : α ≫ β = 0) (hS : (ShortComplex.mk α β hαβ).ShortExact)
    (hTF : Stacks.AlgebraicGeometry.ReflexiveModules.IsTorsionFree F)
    (hQdim : topologicalKrullDim (SheafOfModules.supp Q) ≤ 0)
    (htwo : 2 ≤ Module.finrank S.k (cohomologyOverField S.k S.f Q 0)) :
    Epi (globalSectionsHom F) := by
  have : IsLocallyNoetherian S.X := LocallyOfFiniteType.isLocallyNoetherian S.f
  have hωq := Stacks.Duality.isQuasicoherent_dualizingSheafOverField S.f
  have : Mono α := hS.mono_f
  have : Epi β := hS.epi_g
  have hFc : F.IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_isQuasicoherent_of_isFiniteType F
  have hQc : Q.IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_epi_of_isQuasicoherent hFc β
  have hQnz : ¬ IsZero Q := fun hQ => by
    have h0 := isZero_cohomologyOverField_of_isZero S.k S.f hQ 0
    have : Subsingleton (cohomologyOverField S.k S.f Q 0) := ModuleCat.subsingleton_of_isZero h0
    rw [Module.finrank_zero_of_subsingleton] at htwo
    omega
  /- The generic stalk of `ℱ` is that of `ω_X`. -/
  have hηQ : genericPoint S.X ∉ SheafOfModules.supp Q :=
    (topologicalKrullDim_supp_le_zero_iff hQc).mp hQdim
  have hsimpleF : IsSimpleModule S.X.functionField ((genericStalkFunctor S.X).obj F) := by
    have hSt := hS.map_of_exact (genericStalkFunctor S.X)
    have hz : IsZero ((genericStalkFunctor S.X).obj Q) :=
      not_not.mp fun h => hηQ ((genericPoint_mem_supp_iff Q).mpr h)
    have : IsIso ((genericStalkFunctor S.X).map α) := hSt.isIso_f_iff.mpr hz
    have := hsimple
    exact IsSimpleModule.congr (asIso ((genericStalkFunctor S.X).map α)).symm.toLinearEquiv
  /- The hypothesis of Tag 0B5F: a coherent submodule of `ℱ` injecting into `𝒬` is zero. -/
  have hnosub : ∀ (M : S.X.Modules) (u : M ⟶ F), M.IsCoherent → Mono u → Mono (u ≫ β) →
      IsZero M := by
    intro M u hMc hu huβ
    by_contra hMz
    have := hMc
    have : M.IsQuasicoherent :=
      (Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent M).1
    have := hu
    exact (topologicalKrullDim_supp_le_zero_iff hMc).mp
      (topologicalKrullDim_supp_le_zero_of_mono (u ≫ β) huβ hQdim)
      (genericPoint_mem_supp_of_mono_of_isTorsionFree hFc hTF u hMz)
  have hgen : Epi (globalSectionsHom F ≫ β) :=
    epi_globalSectionsHom_comp_of_isCoherent hωq hFq hFft hQq
      (firstCohomologyDuality_dualizingSheafOverField S)
      (finrank_cohomologyOverField_one_dualizingSheafOverField_eq_one S) α β hαβ hS.exact hQdim
      htwo hnosub
  /- The submodule `ℱ'` generated by the global sections, with `ℱ' ⟶ 𝒬` onto. -/
  have hCc : (cokernel (globalSectionsHom F)).IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_epi_of_isQuasicoherent hFc
      (cokernel.π (globalSectionsHom F))
  obtain ⟨I, ι, e, hmono, hepi, he, hIc⟩ : ∃ (I : S.X.Modules) (ι : I ⟶ F)
      (e : globalSectionsFree F ⟶ I), Mono ι ∧ Epi e ∧ e ≫ ι = globalSectionsHom F ∧
        I.IsCoherent :=
    ⟨_, Abelian.image.ι _, Abelian.factorThruImage _, inferInstance, inferInstance,
      Abelian.image.fac _,
      Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_mono_of_isQuasicoherent hFc
        (Abelian.image.ι (globalSectionsHom F))⟩
  have hιβ : Epi (ι ≫ β) := by
    have : Epi (e ≫ ι ≫ β) := by rw [← Category.assoc, he]; exact hgen
    exact epi_of_epi e (ι ≫ β)
  have hInz : ¬ IsZero I := fun hI =>
    hQnz (IsZero.of_epi_eq_zero (ι ≫ β) (hI.eq_of_src _ _))
  have hIq : I.IsQuasicoherent :=
    (Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent I).1
  have hιiso : IsIso ((genericStalkFunctor S.X).map ι) :=
    isIso_map_genericStalk_of_mono hFc hTF hsimpleF ι hInz
  have hsimpleI : IsSimpleModule S.X.functionField ((genericStalkFunctor S.X).obj I) :=
    IsSimpleModule.congr (asIso ((genericStalkFunctor S.X).map ι)).toLinearEquiv
  have hQ' := isZero_cokernel_of_globalSectionsHom_eq hFc hTF α β hαβ hQnz hIc ι e he hιβ
    hsimpleI hιiso
  have : Epi ι := epi_of_isZero_cokernel ι hQ'
  rw [← he]
  exact epi_comp e ι

end CohenMacaulayCurveSituation

