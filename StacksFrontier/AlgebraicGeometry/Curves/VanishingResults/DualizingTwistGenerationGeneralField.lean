module

public import StacksFrontier.AlgebraicGeometry.Curves.VanishingResults.DualizingTwistGenerationAlgClosed
public import StacksFrontier.AlgebraicGeometry.Curves.VanishingResults.SituationBaseChangeTwist
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CoherentAdicSystem.AffineComparison
public import StacksFrontier.AlgebraicGeometry.RelativeVeryAmple.TensorPower

/-!
# Global generation of `ω_X ⊗ ℒ` over an arbitrary base field, by base change to `k̄`

In Situation [Stacks, Tag 0B5D], let `ω_X = H^{-1}(f^×(𝒪_{Spec k}))` be the dualizing sheaf of
[Stacks, Tag 0BS2] and let `ℒ` be a very ample invertible `𝒪_X`-module with `deg(ℒ) ≥ 2`.
[Stacks, Tag 0B5H] says that `ω_X ⊗ ℒ` is generated by its global sections. The source proves it
over an algebraically closed field and reduces the general case to that one by base change to
`k̄`; this file performs the reduction.

## Main results

* `AlgebraicGeometry.CohenMacaulayCurveSituation`
  `.nonempty_generatingSections_dualizing_tensorSheaf_of_isoAlgebraicClosure`: the reduction.

## What it consumes

Situation [Stacks, Tag 0B5D] at `X_{k̄}` ([Stacks, Tags 01W4, 02FY, 02KH]) is
`AlgebraicGeometry.CohenMacaulayCurveSituation.algebraicClosure`; very ampleness
([Stacks, Tag 0B3F]) and degree ([Stacks, Tag 0B59]) of the inverse image of `ℒ`, and the descent
of global generation ([Stacks, Tag 0B57]), are in `SituationBaseChangeTwist.lean`; the inverse
image of a tensor product is `Stacks.RelativeVeryAmple.pullbackTensorModulesIso`
([Stacks, Tag 01CD]).

Two inputs are arguments. `e` is the isomorphism of part (2) of [Stacks, Tag 0E32] at the
sheaf `ω_X`: the inverse image of `ω_X` along `X_{k̄} ⟶ X` is the dualizing sheaf of `X_{k̄}`.
`hω` is the coherence of `ω_X` (clause (2) of [Stacks, Tag 0BS2]); coherence of `ω_{X_{k̄}}` is
deduced from it through `e`. No `stacks 0B5H` attribute is attached, because both are carried.

## References

* [Stacks Project, Tag 0B5H](https://stacks.math.columbia.edu/tag/0B5H)
* [Stacks Project, Tag 0E32](https://stacks.math.columbia.edu/tag/0E32)
* [Stacks Project, Tag 0BS2](https://stacks.math.columbia.edu/tag/0BS2)
* [Stacks Project, Tag 0B57](https://stacks.math.columbia.edu/tag/0B57)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

namespace CohenMacaulayCurveSituation

variable (S : CohenMacaulayCurveSituation.{u})

/-- **The dualizing sheaf of `X_{k̄}` is coherent when `ω_X` is**, given that it is the inverse
image of `ω_X`: inverse images of modules of finite type are of finite type
([Stacks, Tag 01B6]), and a quasi-coherent module of finite type on the locally Noetherian
`X_{k̄}` is coherent. -/
theorem isCoherent_dualizingSheafOverField_algebraicClosure
    (hω : (Stacks.Duality.dualizingSheafOverField S.f).IsCoherent)
    (e : (Scheme.Modules.pullback S.algebraicClosureProj).obj
          (Stacks.Duality.dualizingSheafOverField S.f) ≅
        Stacks.Duality.dualizingSheafOverField S.algebraicClosure.f) :
    (Stacks.Duality.dualizingSheafOverField S.algebraicClosure.f).IsCoherent := by
  have : IsLocallyNoetherian S.algebraicClosure.X :=
    LocallyOfFiniteType.isLocallyNoetherian S.algebraicClosure.f
  have hft : (Stacks.Duality.dualizingSheafOverField S.f).IsFiniteType :=
    have := hω
    SheafOfModules.IsCoherent.isFiniteType
  have hft' : (Stacks.Duality.dualizingSheafOverField S.algebraicClosure.f).IsFiniteType :=
    Stacks.Coherent.isFiniteType_of_iso_local e
      (@SheafOfModules.pullback_isFiniteType _ _ S.algebraicClosureProj.toLRSHom.toShHom _ hft)
  have := hft'
  have := Stacks.Duality.isQuasicoherent_dualizingSheafOverField S.algebraicClosure.f
  exact Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_isQuasicoherent_of_isFiniteType
    _

/-- **[Stacks, Tag 0B5H] over an arbitrary base field, granted part (2) of [Stacks, Tag 0E32]
for `ω_X` and the coherence of `ω_X`.** In Situation [Stacks, Tag 0B5D], for `ℒ` a very ample
invertible `𝒪_X`-module of degree at least two, `ω_X ⊗ ℒ` is generated by its global sections,
provided `ω_X` is coherent (`hω`) and its inverse image along `X_{k̄} ⟶ X` is the dualizing sheaf
of `X_{k̄}` (`e`).

This is the source's reduction to the algebraically closed case,
`nonempty_generatingSections_dualizing_tensorSheaf_of_isAlgClosed_of_isCoherent`. -/
theorem nonempty_generatingSections_dualizing_tensorSheaf_of_isoAlgebraicClosure
    (L : S.X.Modules) [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L]
    (hL : Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple S.f L)
    (hd : 2 ≤ invertibleCurveDegree S.k S.f (le_of_eq S.dimension_one) L)
    (hω : (Stacks.Duality.dualizingSheafOverField S.f).IsCoherent)
    (e : (Scheme.Modules.pullback S.algebraicClosureProj).obj
          (Stacks.Duality.dualizingSheafOverField S.f) ≅
        Stacks.Duality.dualizingSheafOverField S.algebraicClosure.f) :
    Nonempty ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj
        ((Stacks.Duality.dualizingSheafOverField S.f))).obj (L))).GeneratingSections := by
  let : SheafOfModules.IsInvertible S.algebraicClosure.X.presheaf
      S.algebraicClosure.X.ringCatSheaf.2
      ((Scheme.Modules.pullback S.algebraicClosureProj).obj L) :=
    S.isInvertible_pullback_baseChangeProj (AlgebraicClosure S.k) L
  have hFq := S.isQuasicoherent_tensorSheaf_dualizingSheafOverField L
  obtain ⟨G⟩ :=
   S.algebraicClosure.nonempty_generatingSections_dualizing_tensorSheaf_of_isAlgClosed_of_isCoherent
      ((Scheme.Modules.pullback S.algebraicClosureProj).obj L)
      (S.isRelativelyVeryAmple_baseChange (AlgebraicClosure S.k) L hL)
      (S.isCoherent_dualizingSheafOverField_algebraicClosure hω e)
      (hd.trans_eq (S.invertibleCurveDegree_baseChange (AlgebraicClosure S.k) L).symm)
  refine (@nonempty_generatingSections_pullback_baseChangeProj_iff S (AlgebraicClosure S.k) _ _
    ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
      Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
        (S.X.ringCatSheaf.property)⟩).obj
      ((Stacks.Duality.dualizingSheafOverField S.f))).obj (L))) hFq).2 ⟨?_⟩
  refine SheafOfModules.GeneratingSections.equivOfIso ?_ G
  exact (Stacks.RelativeVeryAmple.tensorModulesMapIso S.algebraicClosure.X e (Iso.refl _)).symm ≪≫
    (Stacks.RelativeVeryAmple.pullbackTensorModulesIso S.algebraicClosureProj
      (Stacks.Duality.dualizingSheafOverField S.f) L).symm

end CohenMacaulayCurveSituation

end AlgebraicGeometry

end
