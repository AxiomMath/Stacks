variable (S : CohenMacaulayCurveSituation.{u})

/-- **The curve of Situation [Stacks, Tag 0B5D] is a Noetherian scheme.** It is proper over a
field, hence locally of finite type over a field and quasi-compact. -/
public theorem isNoetherian : IsNoetherian S.X :=
  have : IsLocallyNoetherian S.X := LocallyOfFiniteType.isLocallyNoetherian S.f
  have : CompactSpace S.X := QuasiCompact.compactSpace_of_compactSpace S.f
  ⟨⟩

/-- **The section of `ℒ` that the proof of [Stacks, Tag 0B5H] chooses at a closed point.** Over
an algebraically closed field, for a very ample invertible `ℒ` on the curve of Situation
[Stacks, Tag 0B5D] and a closed point `x`, there is a global section of `ℒ` vanishing at `x` and
vanishing at no generic point of an irreducible component of `X` other than `x` itself.

This is [Stacks, Tag 0B58], whose two hypotheses on the base field — that it be infinite and
that `x` be rational — are both automatic over an algebraically closed field. -/
public theorem exists_globalSection_vanishing_genericPoint [IsAlgClosed S.k] (L : S.X.Modules)
    [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L]
    (hL : Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple S.f L)
    (x : S.X) (hx : IsClosed ({x} : Set S.X)) :
    ∃ s : Γ(L, ⊤), x ∉ nonvanishingLocus L s ∧
      ∀ Z ∈ irreducibleComponents S.X, ∀ y, IsGenericPoint y Z → y ≠ x →
        y ∈ nonvanishingLocus L s :=
  have := S.isNoetherian
  exists_globalSection_vanishing_at_isClosed_nonvanishing_genericPoint S.f L hL x hx

/-- **`ω_X` has no nonzero coherent submodule with zero-dimensional support**: the
Cohen--Macaulay assertion of clause (2) of [Stacks, Tag 0BS2], in the shape that
`AlgebraicGeometry.CohenMacaulayCurveSituation.exists_shortExact_sectionMul` consumes. -/
public theorem isZero_of_mono_dualizingSheafOverField (M : S.X.Modules)
    (u : M ⟶ Stacks.Duality.dualizingSheafOverField S.f) (hu : Mono u) (hM : M.IsCoherent)
    (hsupp : topologicalKrullDim (SheafOfModules.supp M) ≤ 0) : IsZero M :=
  Stacks.Duality.isZero_of_mono_dualizingSheafOverField_of_supp_dim_le_zero S.f
    (le_of_eq S.dimension_one) M u hu hM hsupp

/-- **`ω_X ⊗ ℒ` has no nonzero coherent submodule with zero-dimensional support**, for `ℒ`
invertible. Tensoring by `ℒ^{⊗ -1}` is faithful (it is an equivalence), so it injects
`Hom(ℳ, ω_X ⊗ ℒ)` into `Hom(ℳ ⊗ ℒ^{⊗ -1}, ω_X)`; `ℳ ⊗ ℒ^{⊗ -1} ≅ ℳ` because an invertible
module does not move a coherent module with zero-dimensional support ([Stacks, Tag 0AYT] at
rank one); and `Hom(ℳ, ω_X) = 0` by clause (5) of [Stacks, Tag 0BS2], since `H¹(X, ℳ) = 0`. -/
public theorem isZero_of_mono_tensorSheaf_dualizingSheafOverField (L : S.X.Modules)
    [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L] (M : S.X.Modules)
    (u : M ⟶ ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj
        ((Stacks.Duality.dualizingSheafOverField S.f))).obj (L))))
    (hu : Mono u) (hM : M.IsCoherent)
    (hsupp : topologicalKrullDim (SheafOfModules.supp M) ≤ 0) : IsZero M := by
  have : IsLocallyNoetherian S.X := LocallyOfFiniteType.isLocallyNoetherian S.f
  have := hM
  have hinv : SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2
      (tensorPowerModule L (-1)) :=
    (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry S.X.presheaf
        S.X.ringCatSheaf.property (tensorPowerModule L (-1))).1
      (Stacks.SheafOfModules.Invertible.tensorPower_isInvertible S.X.presheaf
        S.X.ringCatSheaf.property L (-1))
  have hinv' : Stacks.SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2
      (tensorPowerModule L (-1)) :=
    Stacks.SheafOfModules.Invertible.tensorPower_isInvertible S.X.presheaf
      S.X.ringCatSheaf.property L (-1)
  let T := (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} S.X.sheaf).flip.obj
      (tensorPowerModule L (-1))
  have heq : T.IsEquivalence :=
    CoherentModuleFunctors.tensorRightFunctor_isEquivalence (tensorPowerModule L (-1))
  obtain ⟨e⟩ := nonempty_tensorModulesIso_of_topologicalKrullDim_supp_le_zero M hsupp
    (tensorPowerModule L (-1))
  have hsub : Subsingleton (M ⟶ Stacks.Duality.dualizingSheafOverField S.f) :=
    Stacks.Duality.subsingleton_hom_dualizingSheafOverField_of_supp_dim_le_zero S.f
      (le_of_eq S.dimension_one) M hM hsupp
  have hinj : Function.Injective fun v : M ⟶
      ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj
        ((Stacks.Duality.dualizingSheafOverField S.f))).obj (L))) =>
      e.inv ≫ T.map v ≫
        (tensorSheafMulNegOneIso (Stacks.Duality.dualizingSheafOverField S.f) L).hom :=
    fun v₁ v₂ hv => T.map_injective ((Iso.cancel_iso_hom_right _ _ _).mp
      ((Iso.cancel_iso_inv_left _ _ _).mp hv))
  have := hinj.subsingleton
  exact (IsZero.iff_id_eq_zero M).mpr (hu.right_cancellation (𝟙 M) 0 (Subsingleton.elim _ _))

/-- The cokernel of the map from the free module on all global sections is of finite type. -/
private theorem isFiniteType_cokernel_globalSectionsHom {X : Scheme.{u}} {F : X.Modules}
    (hF : F.IsFiniteType) :
    (cokernel (globalSectionsHom F)).IsFiniteType :=
  @Scheme.Modules.isFiniteType_of_epi _ _ _ (cokernel.π (globalSectionsHom _))
    ⟨fun _ _ h => Cofork.IsColimit.hom_ext (cokernelIsCokernel _) h⟩ hF

/-- **The closed-point step of [Stacks, Tag 0B5H] over an algebraically closed field.** At a
closed point `x`, the section of `ℒ` of [Stacks, Tag 0B58] vanishing at `x` gives
`0 ⟶ ω_X ⟶ ω_X ⊗ ℒ ⟶ 𝒬 ⟶ 0` with `𝒬` of zero-dimensional support and `deg ℒ ≥ 2` global sections
(Section [Stacks, Tag 0B5B]); [Stacks, Tag 0B5F] makes the global sections of `ω_X ⊗ ℒ` surject
onto `𝒬`, and since the section vanishes at `x`, Nakayama kills the stalk at `x` of the cokernel
of the map from the free module on all global sections. -/
public theorem subsingleton_modulesStalk_cokernel_globalSectionsHom [IsAlgClosed S.k]
    (L : S.X.Modules) [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L]
    (hL : Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple S.f L)
    (hω : (Stacks.Duality.dualizingSheafOverField S.f).IsCoherent)
    (hd : 2 ≤ invertibleCurveDegree S.k S.f (le_of_eq S.dimension_one) L)
    (x : S.X) (hx : IsClosed ({x} : Set S.X)) :
    Subsingleton ((Stacks.ModuleSkyscraper.modulesStalkFunctor S.X x).obj
      (cokernel (globalSectionsHom ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
          Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
            (S.X.ringCatSheaf.property)⟩).obj
          ((Stacks.Duality.dualizingSheafOverField S.f))).obj (L)))))) := by
  have hFft := S.isFiniteType_tensorSheaf_dualizingSheafOverField_of_isCoherent L hω
  have hFc := S.isCoherent_tensorSheaf_dualizingSheafOverField_of_isFiniteType L hFft
  have hCft := isFiniteType_cokernel_globalSectionsHom hFft
  have := hω
  obtain ⟨s, hsx, hgen⟩ := S.exists_globalSection_vanishing_genericPoint L hL x hx
  obtain ⟨Q, α, β, hc, hT, hQc, hQq, hQdim, hrange⟩ :=
    S.exists_shortExact_sectionMul (Stacks.Duality.dualizingSheafOverField S.f) L
      (S.isZero_of_mono_dualizingSheafOverField) x hx s hsx hgen
  have := hQc
  have := hFc
  have hcount := @finrank_cohomologyOverField_zero_eq_invertibleCurveDegree S L _
    (Stacks.Duality.dualizingSheafOverField S.f)
    ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
      Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
        (S.X.ringCatSheaf.property)⟩).obj
      ((Stacks.Duality.dualizingSheafOverField S.f))).obj (L)))
    Q hω hFc hQc α β hc hT hQdim rfl rfl
    (S.subsingleton_globalSections_tensorPowerModule_neg_one L hL hd)
    (S.isZero_cohomologyOverField_one_dualizing_tensorSheaf L hL hd)
  have htwo : 2 ≤ Module.finrank S.k (cohomologyOverField S.k S.f Q 0) := by omega
  have := hT.epi_g
  have hepi : Epi (globalSectionsHom ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj
        ((Stacks.Duality.dualizingSheafOverField S.f))).obj (L))) ≫ β) :=
    epi_globalSectionsHom_comp_of_isCoherent
      (Stacks.Duality.isQuasicoherent_dualizingSheafOverField S.f)
      (S.isQuasicoherent_tensorSheaf_dualizingSheafOverField L) hFft hQq
      (S.firstCohomologyDuality_dualizingSheafOverField)
      (S.finrank_cohomologyOverField_one_dualizingSheafOverField_eq_one) α β hc hT.exact hQdim htwo
      fun M u hMc hu huβ => S.isZero_of_mono_tensorSheaf_dualizingSheafOverField L M u hu hMc
        ((topologicalKrullDim_supp_le_of_supp_subset (@supp_subset_of_mono _ _ _ (u ≫ β) huβ)).trans
          hQdim)
  exact subsingleton_modulesStalk_of_epi_of_range_le_maximalIdeal_smul x α
    (cokernel.π (globalSectionsHom ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj
        ((Stacks.Duality.dualizingSheafOverField S.f))).obj (L)))))
    hCft
    (epi_comp_cokernelπ_of_epi_comp α β hc hT.exact (globalSectionsHom
      ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj
        ((Stacks.Duality.dualizingSheafOverField S.f))).obj (L)))) hepi) hrange

/-- **Stacks Project, Tag 0B5H over an algebraically closed field, for a coherent `ω_X`.** In
Situation [Stacks, Tag 0B5D] with `k` algebraically closed, let `ω_X = H^{-1}(f^×(𝒪_{Spec k}))` be
the dualizing sheaf of [Stacks, Tag 0BS2] and let `ℒ` be a very ample invertible `𝒪_X`-module
with `deg(ℒ) ≥ 2`. Then `ω_X ⊗ ℒ` is generated by its global sections.

The coherence of `ω_X` (clause (2) of [Stacks, Tag 0BS2]) is the argument `hω`; see the module
documentation. Everything else is proved: the section of [Stacks, Tag 0B58] at each closed point,
the exact sequence and section count of Section [Stacks, Tag 0B5B], [Stacks, Tag 0B5F], the
duality and `dim H¹(X, ω_X) = 1` of clause (5) of [Stacks, Tag 0BS2] and Nakayama. -/
public theorem nonempty_generatingSections_dualizing_tensorSheaf_of_isAlgClosed_of_isCoherent
    [IsAlgClosed S.k] (L : S.X.Modules)
    [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L]
    (hL : Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple S.f L)
    (hω : (Stacks.Duality.dualizingSheafOverField S.f).IsCoherent)
    (hd : 2 ≤ invertibleCurveDegree S.k S.f (le_of_eq S.dimension_one) L) :
    Nonempty ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
          Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
            (S.X.ringCatSheaf.property)⟩).obj
          ((Stacks.Duality.dualizingSheafOverField S.f))).obj (L))).GeneratingSections := by
  have hFft := S.isFiniteType_tensorSheaf_dualizingSheafOverField_of_isCoherent L hω
  have : CompactSpace S.X := QuasiCompact.compactSpace_of_compactSpace S.f
  refine nonempty_generatingSections_of_epi_globalSectionsHom _ (epi_of_isZero_cokernel _ ?_)
  refine Stacks.AlgebraicGeometry.DevissageNoetherian.isZero_of_supp_eq_empty _ ?_
  have hCft := isFiniteType_cokernel_globalSectionsHom hFft
  have hCcl : IsClosed (SheafOfModules.supp (cokernel (globalSectionsHom
      ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj
        ((Stacks.Duality.dualizingSheafOverField S.f))).obj (L)))))) :=
    @SheafOfModules.isClosed_supp _ _ _ hCft
  by_contra hne
  obtain ⟨x, hx, hxcl⟩ := Stacks.SerreAffinenessCriterion.exists_isClosed_singleton_mem
    hCcl (Set.nonempty_iff_ne_empty.mpr hne)
  obtain ⟨a, ha⟩ := hx
  exact ha (@Subsingleton.elim _
    (S.subsingleton_modulesStalk_cokernel_globalSectionsHom L hL hω hd x hxcl) a 0)

variable {S} in
/-- **The duality of clause (5) of [Stacks, Tag 0BS2] determines `ω` up to isomorphism.** Two
quasi-coherent modules `ω`, `ω'` each carrying functorial isomorphisms
`Hom(ℱ, -) ≅ Hom_k(H¹(X, ℱ), k)` on quasi-coherent `ℱ` are isomorphic, by the Yoneda argument of
the footnote to [Stacks, Tag 0BS2]: the map `ω ⟶ ω'` is the one corresponding to the functional
that `𝟙_ω` corresponds to, and symmetrically. -/
def FirstCohomologyDuality.iso {ω ω' : S.X.Modules} (hω : ω.IsQuasicoherent)
    (hω' : ω'.IsQuasicoherent) (h : S.FirstCohomologyDuality ω)
    (h' : S.FirstCohomologyDuality ω') : ω ≅ ω' where
  hom := (h'.dual ω hω).symm (h.dual ω hω (𝟙 ω))
  inv := (h.dual ω' hω').symm (h'.dual ω' hω' (𝟙 ω'))
  hom_inv_id := by
    apply (h.dual ω hω).injective
    rw [h.dual_comp ω ω' hω hω', AddEquiv.apply_symm_apply,
      ← h'.dual_comp ω ω' hω hω', Category.comp_id, AddEquiv.apply_symm_apply]
  inv_hom_id := by
    apply (h'.dual ω' hω').injective
    rw [h'.dual_comp ω' ω hω' hω, AddEquiv.apply_symm_apply,
      ← h.dual_comp ω' ω hω' hω, Category.comp_id, AddEquiv.apply_symm_apply]

/-- **[Stacks, Tag 0B5H] over an algebraically closed field, for any coherent dualizing module.**
In Situation [Stacks, Tag 0B5D] with `k` algebraically closed, let `ω` be a coherent
`𝒪_X`-module with the functorial duality `Hom(ℱ, ω) = Hom_k(H¹(X, ℱ), k)` of clause (5) of
[Stacks, Tag 0BS2] — that is, a dualizing module of `X` in the sense of that lemma — and let `ℒ`
be a very ample invertible `𝒪_X`-module with `deg(ℒ) ≥ 2`. Then `ω ⊗ ℒ` is globally generated.

`ω` is isomorphic to the canonical `ω_X = H^{-1}(f^×(𝒪_{Spec k}))` by
`AlgebraicGeometry.CohenMacaulayCurveSituation.FirstCohomologyDuality.iso`, which is therefore
coherent, and the statement is
`nonempty_generatingSections_dualizing_tensorSheaf_of_isAlgClosed_of_isCoherent`. -/
public theorem nonempty_generatingSections_tensorSheaf_of_isAlgClosed [IsAlgClosed S.k]
    (ω L : S.X.Modules) [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L]
    (hωc : ω.IsCoherent) (hdual : S.FirstCohomologyDuality ω)
    (hL : Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple S.f L)
    (hd : 2 ≤ invertibleCurveDegree S.k S.f (le_of_eq S.dimension_one) L) :
    Nonempty ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj (ω)).obj (L))).GeneratingSections := by
  have : IsLocallyNoetherian S.X := LocallyOfFiniteType.isLocallyNoetherian S.f
  have hωq : ω.IsQuasicoherent :=
    (Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent ω).1
  let e := FirstCohomologyDuality.iso hωq
    (Stacks.Duality.isQuasicoherent_dualizingSheafOverField S.f) hdual
    S.firstCohomologyDuality_dualizingSheafOverField
  have hD : (Stacks.Duality.dualizingSheafOverField S.f).IsCoherent := by
    have := Stacks.Duality.isQuasicoherent_dualizingSheafOverField S.f
    have := hωc
    have := Stacks.Coherent.isFiniteType_of_iso_local e SheafOfModules.IsCoherent.isFiniteType
    exact
      Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_isQuasicoherent_of_isFiniteType _
  obtain ⟨G⟩ :=
    S.nonempty_generatingSections_dualizing_tensorSheaf_of_isAlgClosed_of_isCoherent L hL hD hd
  exact ⟨SheafOfModules.GeneratingSections.equivOfIso
    (Stacks.RelativeVeryAmple.tensorModulesMapIso S.X e (Iso.refl _)).symm G⟩

end CohenMacaulayCurveSituation

end AlgebraicGeometry

