-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry

/-- **Pulling back global sections along an isomorphism followed by a morphism is surjective as
soon as pulling back along the second one is.** -/
theorem surjective_pullbackSectionTop_comp_of_isIso {X Y Z : Scheme.{u}} (f : X ⟶ Y) [IsIso f]
    (g : Y ⟶ Z) (M : Z.Modules) (hg : Function.Surjective (pullbackSectionTop g M)) :
    Function.Surjective (pullbackSectionTop (f ≫ g) M) := by
  intro σ
  have hu := Stacks.AlgebraicGeometry.RelativeProjChain.isIso_pullbackPushforwardAdjunction_unit_app
    f ((Scheme.Modules.pullback g).obj M)
  obtain ⟨y, hy⟩ := SheafOfModules.iso_hom_app_surjective
    (@asIso _ _ _ _ ((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app
      ((Scheme.Modules.pullback g).obj M)) hu) (op ⊤)
    (((Scheme.Modules.pullbackComp f g).inv.app M).val.app (op ⊤) σ)
  obtain ⟨s, rfl⟩ := hg y
  refine ⟨s, Scheme.Modules.inv_app_injective ((Scheme.Modules.pullbackComp f g).app M) (op ⊤)
    ?_⟩
  exact (pullbackSectionTop_comp f g M s).trans hy

/-- **A module generated by its global sections is generated stalkwise by all of them**
([Stacks, Tag 01AN]). -/
theorem generatesStalks_id_of_isGeneratedByGlobalSections {X : Scheme.{u}} (L : X.Modules)
    (h : SheafOfModules.IsGeneratedByGlobalSections L) :
    Stacks.ProjectiveFromSections.GeneratesStalks (id : Γ(L, ⊤) → Γ(L, ⊤)) := by
  obtain ⟨σ⟩ := h
  have hσ := (generates_iff_stalkwise_generates X.ringCatSheaf L σ.s).mp σ.epi
  refine Stacks.StalkwiseGeneration.generatesStalks_of_span_eq_top _ fun x =>
    eq_top_iff.mpr ((hσ x).ge.trans (Submodule.span_mono ?_))
  rintro _ ⟨i, rfl⟩
  exact ⟨(σ.s i).eval (op ⊤), rfl⟩

namespace CohenMacaulayCurveSituation

variable {S : CohenMacaulayCurveSituation.{u}}

/-- **Restricting sections to a closed subscheme by pulling back is surjective when
`H⁰(X, ℒ) ⟶ H⁰(X, ℒ|_Z)` is**, where `ℒ|_Z = ℒ ⊗ i_* 𝒪_Z`. -/
theorem surjective_pullbackSectionTop_subschemeι (Z : S.X.IdealSheafData) (L : S.X.Modules)
    (h : Function.Surjective ((S.subschemeRestrictionπ Z L).val.app (op ⊤))) :
    Function.Surjective (pullbackSectionTop Z.subschemeι L) := by
  let N := Stacks.SheafOfModules.Invertible.tensorLeftIsoTensorRight S.X.presheaf
    S.X.ringCatSheaf.2 L
  let q := Stacks.AffineClosedUnion.unitToPushforwardStructureSheaf Z.subschemeι
  have hunit : pullbackSectionTop Z.subschemeι L =
      (Stacks.AffineClosedUnion.twistedUnit Z.subschemeι L).val.app (op ⊤) := by
    rw [Stacks.AffineClosedUnion.twistedUnit_eq_unit]; rfl
  have htw : Stacks.AffineClosedUnion.twistedUnit Z.subschemeι L =
      (Stacks.AffineClosedUnion.twistUnitIso L).inv ≫ (N.inv.app _ ≫
        S.tensorDivisorQuotientMap Z L ≫ N.hom.app _) ≫
          (Stacks.AffineClosedUnion.twistPushforwardIso Z.subschemeι L).hom := by
    have hnat : (Stacks.AffineClosedUnion.twistFunctor S.X L).map q =
        N.inv.app _ ≫ S.tensorDivisorQuotientMap Z L ≫ N.hom.app _ :=
      (NatIso.naturality_1 N q).symm
    rw [Stacks.AffineClosedUnion.twistedUnit, hnat]
    rfl
  have hπ : ∀ x, (S.subschemeRestrictionπ Z L).val.app (op ⊤) x =
      (S.tensorDivisorQuotientMap Z L).val.app (op ⊤)
        ((S.tensorStructureSheafIso L).inv.val.app (op ⊤) x) := fun _ => rfl
  rw [hunit, htw]
  intro y
  obtain ⟨y₁, rfl⟩ := SheafOfModules.iso_hom_app_surjective
    (Stacks.AffineClosedUnion.twistPushforwardIso Z.subschemeι L) (op ⊤) y
  obtain ⟨y₂, rfl⟩ := SheafOfModules.iso_hom_app_surjective (N.app _) (op ⊤) y₁
  obtain ⟨x, rfl⟩ := h y₂
  obtain ⟨w, hw⟩ := SheafOfModules.iso_hom_app_surjective
    ((Stacks.AffineClosedUnion.twistUnitIso L).symm ≪≫ (N.app _).symm) (op ⊤)
    ((S.tensorStructureSheafIso L).inv.val.app (op ⊤) x)
  refine ⟨w, ?_⟩
  rw [hπ, ← hw]
  rfl

/-- **A zero-dimensional closed subscheme of degree `d` is cut out by its ideal with the same
dimension and degree**: for a closed immersion `r : Z ⟶ X` with `Z` zero-dimensional of degree
`d`, the closed subscheme cut out by the kernel of `r` has dimension at most zero and degree
`d`. -/
theorem subschemeDegree_ker_eq_of_isZeroDimensionalOfDegree {Z : Scheme.{u}} (r : Z ⟶ S.X)
    [IsClosedImmersion r] {d : ℕ} (hdeg : IsZeroDimensionalOfDegree (r ≫ S.f) d) :
    topologicalKrullDim r.ker.subscheme ≤ 0 ∧ S.subschemeDegree r.ker = d := by
  obtain ⟨hdim, hfin⟩ := hdeg
  refine ⟨?_, ?_⟩
  · rwa [← IsHomeomorph.topologicalKrullDim_eq _ (Scheme.Hom.homeomorph r.toImage).isHomeomorph]
  · let : Algebra S.k Γ(r.ker.subscheme, ⊤) :=
      ((Scheme.ΓSpecIso (.of S.k)).inv ≫ (r.ker.subschemeι ≫ S.f).appTop).hom.toAlgebra
    let : Algebra S.k Γ(Z, ⊤) :=
      ((Scheme.ΓSpecIso (.of S.k)).inv ≫ (r ≫ S.f).appTop).hom.toAlgebra
    have key : (Scheme.ΓSpecIso (.of S.k)).inv ≫ (r.ker.subschemeι ≫ S.f).appTop ≫
        r.toImage.appTop = (Scheme.ΓSpecIso (.of S.k)).inv ≫ (r ≫ S.f).appTop := by
      rw [← Scheme.Hom.comp_appTop, ← Category.assoc, Scheme.Hom.toImage_imageι]
    let e : Γ(r.ker.subscheme, ⊤) ≃ₐ[S.k] Γ(Z, ⊤) :=
      AlgEquiv.ofRingEquiv
        (f := (Scheme.Γ.mapIso (asIso r.toImage).op).commRingCatIsoToRingEquiv)
        (fun c => congrArg (fun φ => φ.hom c) key)
    exact e.toLinearEquiv.finrank_eq.trans hfin

/-- **The hypothesis of [Stacks, Tag 0E8T] from surjectivity onto `H⁰(X, ℒ|_Z)`.** In Situation
[Stacks, Tag 0B5D], if `H⁰(X, ℒ) ⟶ H⁰(X, ℒ ⊗ i_* 𝒪_Z)` is surjective for every nonempty
zero-dimensional closed subscheme `Z` of degree two, then `ℒ` restricts surjectively to every
zero-dimensional closed subscheme of degree two in the sense of
`AlgebraicGeometry.SurjectsOnDegreeTwo`. -/
theorem surjectsOnDegreeTwo_of_forall_surjective_subschemeRestrictionπ (L : S.X.Modules)
    (h : ∀ Z : S.X.IdealSheafData, topologicalKrullDim Z.subscheme ≤ 0 → Nonempty Z.subscheme →
      S.subschemeDegree Z = 2 →
        Function.Surjective (cohomologyOverFieldMap S.k S.f (S.subschemeRestrictionπ Z L) 0)) :
    SurjectsOnDegreeTwo S.f L := by
  intro Z r hr hdeg
  have hne : Nonempty Z := by
    obtain ⟨-, hfin⟩ := hdeg
    by_contra h
    rw [not_nonempty_iff] at h
    let := ((Scheme.ΓSpecIso (.of S.k)).inv ≫ (r ≫ S.f).appTop).hom.toAlgebra
    rw [Module.finrank_zero_of_subsingleton] at hfin
    omega
  obtain ⟨hZ, hd⟩ := S.subschemeDegree_ker_eq_of_isZeroDimensionalOfDegree r hdeg
  have hsurj := h r.ker hZ ⟨r.toImage hne.some⟩ hd
  have h1 : Function.Surjective ((S.subschemeRestrictionπ r.ker L).val.app (op ⊤)) := by
    intro y
    obtain ⟨a, ha⟩ := hsurj ((cohomologyOverFieldZeroEquivSections S.k S.f _).symm y)
    refine ⟨cohomologyOverFieldZeroEquivSections S.k S.f L a, ?_⟩
    have := cohomologyOverFieldZeroEquivSections_cohomologyOverFieldMap S.k S.f
      (S.subschemeRestrictionπ r.ker L) a
    rw [ha] at this
    exact (this.symm.trans (Equiv.apply_symm_apply _ y) :)
  rw [← Scheme.Hom.toImage_imageι r]
  exact surjective_pullbackSectionTop_comp_of_isIso _ _ L
    (surjective_pullbackSectionTop_subschemeι r.ker L h1)

/-- **The hypothesis of [Stacks, Tag 0E8T] from the vanishing of `H¹(X, ℐ_Z ℒ)`.** In Situation
[Stacks, Tag 0B5D], with no integrality assumption, if `H¹(X, ℐ_Z ℒ) = 0` for every nonempty
zero-dimensional closed subscheme `Z` of degree two, then `ℒ` restricts surjectively to every
such subscheme. -/
theorem surjectsOnDegreeTwo_of_forall_isZero_cohomology_idealTwist (L : S.X.Modules)
    [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L]
    (h : ∀ Z : S.X.IdealSheafData, topologicalKrullDim Z.subscheme ≤ 0 → Nonempty Z.subscheme →
      S.subschemeDegree Z = 2 → IsZero (cohomologyOverField S.k S.f (S.idealTwist Z L) 1)) :
    SurjectsOnDegreeTwo S.f L :=
  S.surjectsOnDegreeTwo_of_forall_surjective_subschemeRestrictionπ L fun Z hZ hne hd =>
    surjective_cohomologyOverFieldMap_g_of_isZero
      (S.shortExact_idealTwistι_subschemeRestrictionπ Z L) 0 (h Z hZ hne hd)

/-- **The hypothesis of [Stacks, Tag 0E8T] from [Stacks, Tag 0E3D].** In Situation
[Stacks, Tag 0B5D] with `X` integral of genus `g`, an invertible `ℒ` of degree at least `2g + 1`
restricts surjectively to every zero-dimensional closed subscheme of degree two. -/
theorem surjectsOnDegreeTwo_of_two_mul_genus_add_one_le [IsIntegral S.X] (L : S.X.Modules)
    [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L]
    (hL : 2 * (genus S.f : ℤ) + 1 ≤ invertibleCurveDegree S.k S.f (le_of_eq S.dimension_one) L) :
    SurjectsOnDegreeTwo S.f L :=
  S.surjectsOnDegreeTwo_of_forall_surjective_subschemeRestrictionπ L fun Z hZ hne hd =>
    (S.isGeneratedByGlobalSections_and_surjective_subschemeRestrictionπ L Z hZ hne
      (by rw [hd]; push_cast; omega)).2

/-! ### Extension of the ground field -/

section BaseChange

variable (S) {K : Type u} [Field K] [Algebra S.k K] {X' : Scheme.{u}} {g' : X' ⟶ S.X}
  {f' : X' ⟶ Spec (.of K)}

/-- **Situation [Stacks, Tag 0B5D] after extension of the ground field** to `K ⊇ k`: a base
change `X' = X ×_k K ⟶ Spec K` is again proper, of dimension one, with `H⁰(X', 𝒪) = K`
([Stacks, Tag 0BY9]). -/
def ofIsPullback (h : IsPullback g' f' S.f (Spec.map (CommRingCat.ofHom (algebraMap S.k K)))) :
    CohenMacaulayCurveSituation.{u} where
  k := K
  X := X'
  f := f'
  proper := MorphismProperty.of_isPullback (P := @IsProper) h inferInstance
  dimension_one := (topologicalKrullDim_baseChange S.k K g' f' S.f h).trans S.dimension_one
  isIso_globalSections := isIso_globalSections_baseChange S.k K g' f' S.f h

variable (h : IsPullback g' f' S.f (Spec.map (CommRingCat.ofHom (algebraMap S.k K))))

/-- The inverse image of an invertible module on `X` is invertible on the base change. -/
instance isInvertible_pullback_ofIsPullback (L : S.X.Modules)
    [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L] :
    SheafOfModules.IsInvertible (S.ofIsPullback h).X.presheaf (S.ofIsPullback h).X.ringCatSheaf.2
      ((Scheme.Modules.pullback g').obj L) :=
  Stacks.InvertiblePullback.isInvertibleModule_pullback g' L

/-- **The degree of an invertible module is unchanged by extension of the ground field**
([Stacks, Tag 0B59] for an invertible module). -/
theorem invertibleCurveDegree_ofIsPullback (L : S.X.Modules)
    [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L] :
    invertibleCurveDegree (S.ofIsPullback h).k (S.ofIsPullback h).f
        (le_of_eq (S.ofIsPullback h).dimension_one) ((Scheme.Modules.pullback g').obj L) =
      invertibleCurveDegree S.k S.f (le_of_eq S.dimension_one) L := by
  have hLc : L.IsCoherent :=
    Stacks.AlgebraicGeometry.CurveEulerBridge.isCoherent_of_isFiniteLocallyFreeOfRank S.k S.f L 1
  have hLq : L.IsQuasicoherent := isQuasicoherent_of_isCoherent L
  have hE : ∀ (M : S.X.Modules) [M.IsQuasicoherent] (M' : X'.Modules),
      ((Scheme.Modules.pullback g').obj M ≅ M') → ∀ n : ℕ, (-1 : ℤ) ^ n * (Module.finrank K
      (cohomologyOverField K f' M' n) : ℤ) =
      (-1 : ℤ) ^ n * (Module.finrank S.k (cohomologyOverField S.k S.f M n) : ℤ) :=
    fun M _ M' e n => by
    rw [(finrank_cohomologyOverField_eq_of_iso K f' e n).symm.trans
      (finrank_cohomologyOverField_baseChange_field S.k K _ _ S.f h M n)]
  exact congrArg₂ (· - ·) (finsum_congr (hE L _ (Iso.refl _)))
    (finsum_congr (hE _ _ (Scheme.Modules.pullbackUnitIso _)))

/-- A geometrically integral `X` stays integral after extension of the ground field. -/
theorem isIntegral_ofIsPullback [AlgebraicGeometry.GeometricallyIntegral S.f] :
    IsIntegral (S.ofIsPullback h).X :=
  @AlgebraicGeometry.GeometricallyIntegral.isIntegral_of_subsingleton _ _ f'
    (MorphismProperty.of_isPullback (P := @AlgebraicGeometry.GeometricallyIntegral) h
      inferInstance) _ _

end BaseChange

/-! ### Very ampleness -/

/-- **Invertible modules of degree at least `2g + 1` are very ample.** In Situation
[Stacks, Tag 0B5D] — a proper one-dimensional scheme `X` over a field `k` with `H⁰(X, 𝒪_X) = k` —
assume `X` geometrically integral over `k` of genus `g`, and let `ℒ` be an invertible
`𝒪_X`-module. If `deg(ℒ) ≥ 2g + 1`, then `ℒ` is very ample. -/
@[stacks 0H2V]
theorem isRelativelyVeryAmple_of_two_mul_genus_add_one_le
    [AlgebraicGeometry.GeometricallyIntegral S.f] (L : S.X.Modules)
    [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L]
    (hL : 2 * (genus S.f : ℤ) + 1 ≤
      invertibleCurveDegree S.k S.f (le_of_eq S.dimension_one) L) :
    Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple S.f L := by
  have : IsIntegral S.X := AlgebraicGeometry.GeometricallyIntegral.isIntegral_of_subsingleton S.f
  refine isRelativelyVeryAmple_of_generatesStalks_of_surjectsOnDegreeTwo_baseChange S.f L
    (generatesStalks_id_of_isGeneratedByGlobalSections L
      (S.isGeneratedByGlobalSections_of_two_mul_genus_le L (by omega))) fun X' g' f' h => ?_
  have : IsIntegral (S.ofIsPullback h).X := S.isIntegral_ofIsPullback h
  refine (S.ofIsPullback h).surjectsOnDegreeTwo_of_two_mul_genus_add_one_le _ ?_
  rw [S.invertibleCurveDegree_ofIsPullback h L]
  change 2 * (genus f' : ℤ) + 1 ≤ _
  rwa [genus_baseChange S.k _ g' f' S.f h]

end CohenMacaulayCurveSituation

end AlgebraicGeometry
