variable {S : CohenMacaulayCurveSituation.{u}}

/-! ### Stacks Tag 0B5F, with the hypothesis on coherent submodules -/

/-- **`H¹` vanishes on a coherent submodule of `ℱ` containing the image of `ω` and mapping
nontrivially to `𝒬`**, when the support of `𝒬` has dimension at most zero and no nonzero
*coherent* submodule of `ℱ` injects into `𝒬`.

The proof is that of
`AlgebraicGeometry.CohenMacaulayCurveSituation.isZero_firstCohomology_of_mono_of_supp_dim_le_zero`:
the only submodule of `ℱ` the hypothesis is applied to is `coker(ω ⟶ ℱ')`, which is coherent as
a quotient of the coherent `ℱ'`. -/
public theorem isZero_firstCohomology_of_mono_of_supp_dim_le_zero_of_coherent
    {ω F F' Q : S.X.Modules}
    (hωq : ω.IsQuasicoherent) (hF'c : F'.IsCoherent)
    (hdual : S.FirstCohomologyDuality ω)
    (hone : Module.finrank S.k (cohomologyOverField S.k S.f ω 1) = 1)
    (α : ω ⟶ F) (β : F ⟶ Q) (hαβ : α ≫ β = 0) (hex : (ShortComplex.mk α β hαβ).Exact)
    (ι : F' ⟶ F) [Mono ι] (α' : ω ⟶ F') (hα'ι : α' ≫ ι = α) (hne : ι ≫ β ≠ 0)
    (hQdim : topologicalKrullDim (SheafOfModules.supp Q) ≤ 0)
    (hnosub : ∀ (M : S.X.Modules) (u : M ⟶ F), Mono u → M.IsCoherent → Mono (u ≫ β) →
      IsZero M) :
    IsZero (cohomologyOverField S.k S.f F' 1) := by
  have : IsLocallyNoetherian S.X := LocallyOfFiniteType.isLocallyNoetherian S.f
  have := hωq
  have := hF'c
  have hF'q : F'.IsQuasicoherent :=
    (Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent F').1
  have := hF'q
  have hα'β : α' ≫ (ι ≫ β) = 0 := by rw [← Category.assoc, hα'ι, hαβ]
  have hjmono : Mono (cokernel.desc α' (ι ≫ β) hα'β) :=
    mono_cokernel_desc_of_exact α β hαβ hex ι α' hα'ι hα'β
  have hπj : cokernel.π α' ≫ cokernel.desc α' (ι ≫ β) hα'β = ι ≫ β := cokernel.π_desc _ _ _
  have hCc : (cokernel α').IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_epi_of_isQuasicoherent hF'c
      (cokernel.π α')
  have hCdim : topologicalKrullDim (SheafOfModules.supp (cokernel α')) ≤ 0 :=
    topologicalKrullDim_supp_le_zero_of_mono (cokernel.desc α' (ι ≫ β) hα'β) hjmono hQdim
  rcases isZero_firstCohomology_or_iso_biprod hωq hF'q hdual S.secondCohomologyVanishing hone α'
    (cokernel.π α') (cokernel.condition α') (ShortComplex.cokernelSequence_exact α')
    (isZero_firstCohomology_of_supp_dim_le_zero hCc hCdim) with h | ⟨e, he1, he2⟩
  · exact h
  · exfalso
    have hu : (biprod.inr ≫ e.inv) ≫ cokernel.π α' = 𝟙 (cokernel α') := by
      rw [← he2]
      simp
    have heq : (biprod.inr ≫ e.inv ≫ ι) ≫ β = cokernel.desc α' (ι ≫ β) hα'β := by
      have h1 : (biprod.inr ≫ e.inv ≫ ι) ≫ β = (biprod.inr ≫ e.inv) ≫ (ι ≫ β) := by simp
      rw [h1]
      conv_lhs => rw [← hπj]
      rw [← Category.assoc, hu, Category.id_comp]
    have hmono1 : Mono ((biprod.inr ≫ e.inv ≫ ι) ≫ β) := by rwa [heq]
    have hmono2 : Mono (biprod.inr ≫ e.inv ≫ ι) := mono_of_mono _ β
    have hzQ : IsZero (cokernel α') :=
      hnosub (cokernel α') (biprod.inr ≫ e.inv ≫ ι) hmono2 hCc hmono1
    refine hne ?_
    rw [← hπj, hzQ.eq_of_tgt (cokernel.π α') 0, zero_comp]

/-- **[Stacks, Tag 0B5F], with the hypothesis on submodules asked of coherent submodules.** In
Situation [Stacks, Tag 0B5D], let `ω` satisfy the first-cohomology duality `hdual` with
`dim_k H¹(X, ω) = 1`, and let `ω ⟶ ℱ ⟶ 𝒬 ⟶ 0` be exact with `ℱ` coherent, `𝒬` supported in
dimension zero with `dim_k H⁰(X, 𝒬) ≥ 2`, and no nonzero coherent submodule of `ℱ` injecting into
`𝒬`. Then the global sections of `ℱ` surject onto `𝒬`.

The proof is that of `AlgebraicGeometry.CohenMacaulayCurveSituation.epi_globalSectionsHom_comp`,
whose hypothesis on submodules is used only through
`isZero_firstCohomology_of_mono_of_supp_dim_le_zero_of_coherent`. -/
public theorem epi_globalSectionsHom_comp_of_coherent {ω F Q : S.X.Modules}
    (hωq : ω.IsQuasicoherent) (hFq : F.IsQuasicoherent) (hFft : F.IsFiniteType)
    (hQq : Q.IsQuasicoherent) (hdual : S.FirstCohomologyDuality ω)
    (hone : Module.finrank S.k (cohomologyOverField S.k S.f ω 1) = 1)
    (α : ω ⟶ F) (β : F ⟶ Q) (hαβ : α ≫ β = 0)
    (hex : (ShortComplex.mk α β hαβ).Exact) [Epi β]
    (hQdim : topologicalKrullDim (SheafOfModules.supp Q) ≤ 0)
    (htwo : 2 ≤ Module.finrank S.k (cohomologyOverField S.k S.f Q 0))
    (hnosub : ∀ (M : S.X.Modules) (u : M ⟶ F), Mono u → M.IsCoherent → Mono (u ≫ β) →
      IsZero M) :
    Epi (globalSectionsHom F ≫ β) := by
  have : IsLocallyNoetherian S.X := LocallyOfFiniteType.isLocallyNoetherian S.f
  have := hFq
  have := hFft
  have := hQq
  have hFc : F.IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_isQuasicoherent_of_isFiniteType F
  have hQc : Q.IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_epi_of_isQuasicoherent hFc β
  have hγ0 : globalSectionsHom F ≫ (β ≫ cokernel.π (globalSectionsHom F ≫ β)) = 0 := by
    rw [← Category.assoc]; exact cokernel.condition _
  have hα0 : α ≫ (β ≫ cokernel.π (globalSectionsHom F ≫ β)) = 0 := by
    rw [← Category.assoc, hαβ, zero_comp]
  have hepiδ : Epi (β ≫ cokernel.π (globalSectionsHom F ≫ β)) := epi_comp _ _
  have hev : kernel.lift (β ≫ cokernel.π (globalSectionsHom F ≫ β)) (globalSectionsHom F) hγ0 ≫
      kernel.ι (β ≫ cokernel.π (globalSectionsHom F ≫ β)) = globalSectionsHom F :=
    kernel.lift_ι _ _ _
  have hα'ι : kernel.lift (β ≫ cokernel.π (globalSectionsHom F ≫ β)) α hα0 ≫
      kernel.ι (β ≫ cokernel.π (globalSectionsHom F ≫ β)) = α := kernel.lift_ι _ _ _
  have hne : kernel.ι (β ≫ cokernel.π (globalSectionsHom F ≫ β)) ≫ β ≠ 0 := by
    intro h
    refine globalSectionsHom_comp_ne_zero S.secondCohomologyVanishing hone α β hαβ hex htwo ?_
    rw [← hev, Category.assoc, h, comp_zero]
  have hCc : (cokernel (globalSectionsHom F ≫ β)).IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_epi_of_isQuasicoherent hQc
      (cokernel.π (globalSectionsHom F ≫ β))
  have hF'c : (kernel (β ≫ cokernel.π (globalSectionsHom F ≫ β))).IsCoherent :=
    have := hCc
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_mono_of_isQuasicoherent hFc
      (kernel.ι (β ≫ cokernel.π (globalSectionsHom F ≫ β)))
  have hF'1 : IsZero (cohomologyOverField S.k S.f
      (kernel (β ≫ cokernel.π (globalSectionsHom F ≫ β))) 1) :=
    isZero_firstCohomology_of_mono_of_supp_dim_le_zero_of_coherent hωq hF'c hdual hone α β hαβ
      hex (kernel.ι _) (kernel.lift _ α hα0) hα'ι hne hQdim hnosub
  have hsurj0 : Function.Surjective (cohomologyOverFieldMap S.k S.f
      (β ≫ cokernel.π (globalSectionsHom F ≫ β)) 0) :=
    surjective_cohomologyOverFieldMap_g_of_isZero
      (T := ShortComplex.mk (kernel.ι (β ≫ cokernel.π (globalSectionsHom F ≫ β)))
        (β ≫ cokernel.π (globalSectionsHom F ≫ β)) (kernel.condition _))
      (ShortComplex.shortExact_mk_kernel_ι _) 0 hF'1
  have hzero0 : ∀ a, cohomologyOverFieldMap S.k S.f
      (β ≫ cokernel.π (globalSectionsHom F ≫ β)) 0 a = 0 := fun a =>
    cohomologyOverFieldMap_zero_eq_zero_of_globalSectionsHom_comp S.f _ hγ0 a
  have hC0 : IsZero (cohomologyOverField S.k S.f (cokernel (globalSectionsHom F ≫ β)) 0) := by
    refine @ModuleCat.isZero_of_subsingleton _ _ _ ⟨fun a b => ?_⟩
    obtain ⟨a', rfl⟩ := hsurj0 a
    obtain ⟨b', rfl⟩ := hsurj0 b
    rw [hzero0, hzero0]
  have hπepi : Epi (cokernel.π (globalSectionsHom F ≫ β)) := inferInstance
  have hCdim : topologicalKrullDim
      (SheafOfModules.supp (cokernel (globalSectionsHom F ≫ β))) ≤ 0 :=
    topologicalKrullDim_supp_le_zero_of_epi (cokernel.π (globalSectionsHom F ≫ β)) hπepi hQdim
  exact epi_of_isZero_cokernel _
    (isZero_of_supp_dim_le_zero_of_isZero_sections hCc hCdim hC0)

/-! ### The coherent forms of the two carried inputs -/

variable (S) in
/-- **A module with no nonzero coherent submodule supported in dimension zero.** This is the
form in which [Stacks, Tag 0B5F] uses such a hypothesis. -/
public def NoCoherentSubmoduleOfZeroDimensionalSupport (F : S.X.Modules) : Prop :=
  ∀ (M : S.X.Modules) (u : M ⟶ F), Mono u → M.IsCoherent →
    topologicalKrullDim (SheafOfModules.supp M) ≤ 0 → IsZero M

variable (S) in
/-- **The presentation of `ℱ` produced by a section of `ℒ` vanishing at `x`**: an exact sequence
`ω ⟶ ℱ ⟶ 𝒬 ⟶ 0` whose quotient `𝒬` is quasi-coherent with zero-dimensional support and `d`
global sections, and whose first map has image inside `𝔪_x ℱ_x` at `x`. This is
`AlgebraicGeometry.CohenMacaulayCurveSituation.VanishingSectionData` without its two fields about
arbitrary submodules and quotients of `𝒬`, which the coherent form of [Stacks, Tag 0B5F] does not
need. -/
public structure CoherentVanishingSectionData (ω F : S.X.Modules) (d : ℤ) (x : S.X) where
  /-- The quotient of `ℱ` by the image of `ω`. -/
  Q : S.X.Modules
  /-- Multiplication by the chosen section of `ℒ`. -/
  α : ω ⟶ F
  /-- The quotient map. -/
  β : F ⟶ Q
  /-- The two maps compose to zero. -/
  comp_eq_zero : α ≫ β = 0
  /-- The sequence `ω ⟶ ℱ ⟶ 𝒬` is exact at `ℱ`. -/
  exact : (ShortComplex.mk α β comp_eq_zero).Exact
  /-- `𝒬` is a quotient of `ℱ`. -/
  epi : Epi β
  /-- `𝒬` is quasi-coherent. -/
  isQuasicoherent : Q.IsQuasicoherent
  /-- The support of `𝒬` has dimension zero. -/
  supp_dim_le : topologicalKrullDim (SheafOfModules.supp Q) ≤ 0
  /-- `𝒬` has `d` global sections. -/
  finrank_cohomology_zero : (Module.finrank S.k (cohomologyOverField S.k S.f Q 0) : ℤ) = d
  /-- The chosen section vanishes at `x`. -/
  range_modulesStalk_le :
    LinearMap.range ((modulesStalkFunctor S.X x).map α).hom ≤
      IsLocalRing.maximalIdeal (S.X.presheaf.stalk x) •
        (⊤ : Submodule (S.X.presheaf.stalk x) ((modulesStalkFunctor S.X x).obj F))

/-- The cokernel of the map from the free module on all global sections of a module of finite
type is of finite type, being a quotient of it. -/
private theorem isFiniteType_cokernel_globalSectionsHom {X : Scheme.{u}} (F : X.Modules)
    (hF : F.IsFiniteType) : (cokernel (globalSectionsHom F)).IsFiniteType :=
  have := hF
  @Stacks.SheafOfModules.isFiniteType_of_epi'.{u} _ _ _ _ _ _ _ _ _
    (cokernel.π (globalSectionsHom F)) inferInstance
    ⟨fun g₁ g₂ hg => (inferInstance : Epi (cokernel.π (globalSectionsHom F))).left_cancellation
      g₁ g₂ hg⟩

/-- The support of that cokernel is closed. -/
private theorem isClosed_supp_cokernel_globalSectionsHom {X : Scheme.{u}} (F : X.Modules)
    (hF : F.IsFiniteType) : IsClosed (SheafOfModules.supp (cokernel (globalSectionsHom F))) := by
  have key : ∀ {Y : TopCat.{u}} {O : Sheaf (Opens.grothendieckTopology Y) RingCat.{u}}
      (M : SheafOfModules.{u} O), M.IsFiniteType → IsClosed (SheafOfModules.supp M) :=
    fun M hM => by
      have := hM
      exact SheafOfModules.isClosed_supp M
  exact key (O := X.ringCatSheaf) _ (isFiniteType_cokernel_globalSectionsHom F hF)

/-- **No nonzero coherent submodule of `ℱ` injects into `𝒬`**: such a submodule has support
inside that of `𝒬`, hence of dimension zero. -/
public theorem CoherentVanishingSectionData.isZero_of_mono {ω F : S.X.Modules} {d : ℤ}
    {x : S.X} (D : S.CoherentVanishingSectionData ω F d x)
    (hnosub : S.NoCoherentSubmoduleOfZeroDimensionalSupport F)
    (M : S.X.Modules) (u : M ⟶ F) (hu : Mono u) (hMc : M.IsCoherent)
    (huβ : Mono (u ≫ D.β)) : IsZero M :=
  have := huβ
  hnosub M u hu hMc ((topologicalKrullDim_supp_le_of_supp_subset
    (supp_subset_of_mono (u ≫ D.β))).trans D.supp_dim_le)

/-- **The cokernel of the map from the free module on all global sections of `ℱ` vanishes at
`x`**, from [Stacks, Tag 0B5F] and Nakayama. -/
public theorem CoherentVanishingSectionData.subsingleton_modulesStalk_cokernel
    {ω F : S.X.Modules} {d : ℤ} {x : S.X} (D : S.CoherentVanishingSectionData ω F d x)
    (hωq : ω.IsQuasicoherent) (hFq : F.IsQuasicoherent) (hFft : F.IsFiniteType)
    (hdual : S.FirstCohomologyDuality ω)
    (hone : Module.finrank S.k (cohomologyOverField S.k S.f ω 1) = 1)
    (hnosub : S.NoCoherentSubmoduleOfZeroDimensionalSupport F) (hd : 2 ≤ d) :
    Subsingleton ((modulesStalkFunctor S.X x).obj (cokernel (globalSectionsHom F))) :=
  have := D.epi
  have htwo : 2 ≤ Module.finrank S.k (cohomologyOverField S.k S.f D.Q 0) := by
    have h := D.finrank_cohomology_zero
    omega
  subsingleton_modulesStalk_of_epi_of_range_le_maximalIdeal_smul x D.α
    (cokernel.π (globalSectionsHom F))
    (isFiniteType_cokernel_globalSectionsHom F hFft)
    (epi_comp_cokernelπ_of_epi_comp D.α D.β D.comp_eq_zero D.exact (globalSectionsHom F)
      (epi_globalSectionsHom_comp_of_coherent hωq hFq hFft D.isQuasicoherent hdual hone D.α D.β
        D.comp_eq_zero D.exact D.supp_dim_le htwo (D.isZero_of_mono hnosub)))
    D.range_modulesStalk_le

/-- **The global sections of `ℱ` generate `ℱ`**, given a vanishing section at every closed
point of `X`. -/
public theorem epi_globalSectionsHom_of_forall_isClosed_of_coherent {ω F : S.X.Modules}
    (hωq : ω.IsQuasicoherent) (hFq : F.IsQuasicoherent) (hFft : F.IsFiniteType)
    (hdual : S.FirstCohomologyDuality ω)
    (hone : Module.finrank S.k (cohomologyOverField S.k S.f ω 1) = 1)
    (hnosub : S.NoCoherentSubmoduleOfZeroDimensionalSupport F) {d : ℤ} (hd : 2 ≤ d)
    (hsec : ∀ x : S.X, IsClosed ({x} : Set S.X) → S.CoherentVanishingSectionData ω F d x) :
    Epi (globalSectionsHom F) := by
  have : CompactSpace S.X := QuasiCompact.compactSpace_of_compactSpace S.f
  refine epi_of_isZero_cokernel _ ?_
  refine Stacks.AlgebraicGeometry.DevissageNoetherian.isZero_of_supp_eq_empty _ ?_
  by_contra hne
  obtain ⟨x, hx, hxcl⟩ := Stacks.SerreAffinenessCriterion.exists_isClosed_singleton_mem
    (isClosed_supp_cokernel_globalSectionsHom F hFft)
    (Set.nonempty_iff_ne_empty.mpr hne)
  have hsub := (hsec x hxcl).subsingleton_modulesStalk_cokernel hωq hFq hFft hdual hone
    hnosub hd
  obtain ⟨a, ha⟩ := hx
  exact ha (Subsingleton.elim (α := (modulesStalkFunctor S.X x).obj
    (cokernel (globalSectionsHom F))) a 0)

/-- **A twist of a module with first-cohomology duality has no nonzero coherent submodule
supported in dimension zero.** A coherent `ℳ` supported in dimension zero has `H¹(X, ℳ) = 0`
([Stacks, Tag 0B3J]), so clause (5) of [Stacks, Tag 0BS2] makes `Hom(ℳ, ω)` trivial; tensoring
by a tensor inverse `𝒩` of `ℒ` injects `Hom(ℳ, ω ⊗ ℒ)` into `Hom(ℳ ⊗ 𝒩, ω)`, and `ℳ ⊗ 𝒩 ≅ ℳ`
([Stacks, Tag 0AYT] at rank one). -/
public theorem noCoherentSubmoduleOfZeroDimensionalSupport_tensorSheaf (ω L : S.X.Modules)
    [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L]
    (hdual : S.FirstCohomologyDuality ω) :
    S.NoCoherentSubmoduleOfZeroDimensionalSupport
      ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj (ω)).obj (L))) := by
  intro M u hu hMc hdim
  have : IsLocallyNoetherian S.X := LocallyOfFiniteType.isLocallyNoetherian S.f
  have := hMc
  let N : S.X.Modules := Stacks.SheafOfModules.Invertible.tensorPowerModule L (-1)
  have : SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.property N :=
    (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry S.X.presheaf
        S.X.ringCatSheaf.property (Stacks.SheafOfModules.Invertible.tensorPowerModule L (-1))).1
      (Stacks.SheafOfModules.Invertible.tensorPower_isInvertible S.X.presheaf
        S.X.ringCatSheaf.property L (-1))
  obtain ⟨e⟩ := nonempty_tensorModulesIso_of_topologicalKrullDim_supp_le_zero M hdim N
  have hMq : M.IsQuasicoherent :=
    (Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent M).1
  have hlin : Subsingleton (cohomologyOverField S.k S.f M 1 →ₗ[S.k] S.k) :=
    have hz := ModuleCat.subsingleton_of_isZero
      (isZero_firstCohomology_of_supp_dim_le_zero hMc hdim)
    ⟨fun a b => LinearMap.ext fun z => by rw [Subsingleton.elim z 0, map_zero, map_zero]⟩
  have hMsub : Subsingleton (M ⟶ ω) := (hdual.dual M hMq).injective.subsingleton
  let g : (M ⟶ (((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj (ω)).obj (L))) → (M ⟶ ω) := fun v =>
    e.inv ≫ (Stacks.SheafOfModules.Invertible.tensorModuleFunctor N).map v ≫
      (tensorSheafMulNegOneIso ω L).hom
  have hginj : Function.Injective g := fun _ _ hv =>
    (Stacks.SheafOfModules.Invertible.tensorModuleFunctor N).map_injective
      ((Iso.cancel_iso_hom_right _ _ (tensorSheafMulNegOneIso ω L)).mp
        ((Iso.cancel_iso_inv_left e _ _).mp hv))
  have := hginj.subsingleton
  exact (IsZero.iff_id_eq_zero M).mpr (hu.right_cancellation (𝟙 M) 0 (Subsingleton.elim _ _))

/-- **The extension of `ω` produced by a section of `ℒ` vanishing at a closed point**, with the
hypothesis on `ω` asked of coherent submodules: this is
`AlgebraicGeometry.CohenMacaulayCurveSituation.exists_shortExact_sectionMul`, whose only use of
that hypothesis is at the kernel of multiplication by `s`, which is coherent. -/
public theorem exists_shortExact_sectionMul_of_coherent (ω L : S.X.Modules)
    [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L] [ω.IsCoherent]
    [((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj (ω)).obj (L))).IsCoherent]
    (hnosub : S.NoCoherentSubmoduleOfZeroDimensionalSupport ω)
    (x : S.X) (hx : IsClosed ({x} : Set S.X)) (s : Γ(L, ⊤))
    (hsx : x ∉ nonvanishingLocus L s)
    (hgen : ∀ Z ∈ irreducibleComponents S.X, ∀ y, IsGenericPoint y Z → y ≠ x →
      y ∈ nonvanishingLocus L s) :
    ∃ (Q : S.X.Modules) (α : ω ⟶ (((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj (ω)).obj (L)))
      (β : (((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj (ω)).obj (L)) ⟶ Q) (hc : α ≫ β = 0),
      (ShortComplex.mk α β hc).ShortExact ∧ Q.IsCoherent ∧ Q.IsQuasicoherent ∧
      topologicalKrullDim (SheafOfModules.supp Q) ≤ 0 ∧
      LinearMap.range ((modulesStalkFunctor S.X x).map α).hom ≤
        IsLocalRing.maximalIdeal (S.X.presheaf.stalk x) •
          (⊤ : Submodule (S.X.presheaf.stalk x)
            ((modulesStalkFunctor S.X x).obj
              ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
                Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
                  (S.X.ringCatSheaf.property)⟩).obj (ω)).obj (L))))) := by
  have hdim1 : topologicalKrullDim (S.X : Type u) ≤ 1 := S.dimension_one.le
  have hgenAll : ∀ y ∈ Stacks.AlgebraicGeometry.ComponentDegrees.genericPointsOne S.X,
      y ∈ nonvanishingLocus L s :=
    fun y hy => mem_nonvanishingLocus_of_mem_genericPointsOne L s hx hgen hy
  have hbij : ∀ y ∈ nonvanishingLocus L s,
      Function.Bijective (Stacks.ModuleStalk.mapFun (sectionMulHom ω L s) y) :=
    fun y hy => bijective_mapFun_sectionMulHom ω L s hy
  have hkercoh : (kernel (sectionMulHom ω L s)).IsCoherent :=
    isCoherent_kernel_of_isCoherent ‹ω.IsCoherent› ‹_› (sectionMulHom ω L s)
  have hkerdim : topologicalKrullDim
      (SheafOfModules.supp (kernel (sectionMulHom ω L s))) ≤ 0 :=
    topologicalKrullDim_supp_le_zero_of_forall_notMem_genericPointsOne hdim1 _ hkercoh
      fun y hy => notMem_supp_kernel_of_injective_mapFun _ y (hbij y (hgenAll y hy)).1
  have hmonoι : Mono (kernel.ι (sectionMulHom ω L s)) :=
    ⟨fun _ _ h => Fork.IsLimit.hom_ext (kernelIsKernel (sectionMulHom ω L s)) h⟩
  have hkerzero : IsZero (kernel (sectionMulHom ω L s)) :=
    hnosub _ (kernel.ι (sectionMulHom ω L s)) hmonoι hkercoh hkerdim
  have hmono : Mono (sectionMulHom ω L s) :=
    (Preadditive.mono_iff_isZero_kernel _).mpr hkerzero
  have hepi : Epi (cokernel.π (sectionMulHom ω L s)) :=
    ⟨fun _ _ h => Cofork.IsColimit.hom_ext (cokernelIsCokernel (sectionMulHom ω L s)) h⟩
  have hcokcoh : (cokernel (sectionMulHom ω L s)).IsCoherent :=
    isCoherent_cokernel_of_isCoherent ‹ω.IsCoherent› ‹_› (sectionMulHom ω L s)
  have hcokqc : (cokernel (sectionMulHom ω L s)).IsQuasicoherent :=
    (@Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent
      _ _ hcokcoh).1
  refine ⟨cokernel (sectionMulHom ω L s), sectionMulHom ω L s,
    cokernel.π (sectionMulHom ω L s), cokernel.condition (sectionMulHom ω L s),
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono hepi, hcokcoh, hcokqc,
    ?_, range_modulesStalkFunctor_map_sectionMulHom_le ω L s hsx⟩
  exact topologicalKrullDim_supp_le_zero_of_forall_notMem_genericPointsOne hdim1 _ hcokcoh
    fun y hy => notMem_supp_cokernel_of_surjective_mapFun _ y (hbij y (hgenAll y hy)).2

/-! ### At the canonical dualizing sheaf, over an algebraically closed field -/

variable (S)

/-- **`ω_X` has no nonzero coherent submodule with zero-dimensional support**: the
Cohen--Macaulay assertion of clause (2) of [Stacks, Tag 0BS2]. -/
public theorem noCoherentSubmoduleOfZeroDimensionalSupport_dualizingSheafOverField :
    S.NoCoherentSubmoduleOfZeroDimensionalSupport (Stacks.Duality.dualizingSheafOverField S.f) :=
  fun M u hu hM hsupp =>
    Stacks.Duality.isZero_of_mono_dualizingSheafOverField_of_supp_dim_le_zero S.f
      (S.dimension_one.le) M u hu hM hsupp

/-- **The curve of Situation [Stacks, Tag 0B5D] is a Noetherian scheme.** -/
public theorem isNoetherian' : IsNoetherian S.X :=
  have : IsLocallyNoetherian S.X := LocallyOfFiniteType.isLocallyNoetherian S.f
  have : CompactSpace S.X := QuasiCompact.compactSpace_of_compactSpace S.f
  ⟨⟩

/-- **What Section [Stacks, Tag 0B5B] attaches to the section of [Stacks, Tag 0B58] at a closed
point**, over an algebraically closed field: the exact sequence `ω_X ⟶ ω_X ⊗ ℒ ⟶ 𝒬 ⟶ 0` with `𝒬`
supported in dimension zero with `deg(ℒ)` global sections, the first map vanishing at `x`. -/
public def coherentVanishingSectionData_dualizing_tensorSheaf [IsAlgClosed S.k]
    (L : S.X.Modules) [SheafOfModules.IsInvertible S.X.presheaf S.X.ringCatSheaf.2 L]
    (hL : Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple S.f L)
    (hFft : ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj
          (Stacks.Duality.dualizingSheafOverField S.f)).obj (L))).IsFiniteType)
    (hd : 2 ≤ invertibleCurveDegree S.k S.f (le_of_eq S.dimension_one) L)
    (x : S.X) (hx : IsClosed ({x} : Set S.X)) :
    S.CoherentVanishingSectionData (Stacks.Duality.dualizingSheafOverField S.f)
      ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj
          (Stacks.Duality.dualizingSheafOverField S.f)).obj (L)))
      (invertibleCurveDegree S.k S.f (le_of_eq S.dimension_one) L) x :=
  have hωc : (Stacks.Duality.dualizingSheafOverField S.f).IsCoherent :=
    S.isCoherent_dualizingSheafOverField_of_isFiniteType_tensorSheaf L hFft
  have hFc : ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
          (S.X.ringCatSheaf.property)⟩).obj
          (Stacks.Duality.dualizingSheafOverField S.f)).obj (L))).IsCoherent :=
    S.isCoherent_tensorSheaf_dualizingSheafOverField_of_isFiniteType L hFft
  have := S.isNoetherian'
  have hs := exists_globalSection_vanishing_at_isClosed_nonvanishing_genericPoint S.f L hL x hx
  have hdata := @exists_shortExact_sectionMul_of_coherent S
    (Stacks.Duality.dualizingSheafOverField S.f) L _ hωc hFc
    S.noCoherentSubmoduleOfZeroDimensionalSupport_dualizingSheafOverField x hx hs.choose
    hs.choose_spec.1 hs.choose_spec.2
  { Q := hdata.choose
    α := hdata.choose_spec.choose
    β := hdata.choose_spec.choose_spec.choose
    comp_eq_zero := hdata.choose_spec.choose_spec.choose_spec.choose
    exact := hdata.choose_spec.choose_spec.choose_spec.choose_spec.1.exact
    epi := hdata.choose_spec.choose_spec.choose_spec.choose_spec.1.epi_g
    isQuasicoherent := hdata.choose_spec.choose_spec.choose_spec.choose_spec.2.2.1
    supp_dim_le := hdata.choose_spec.choose_spec.choose_spec.choose_spec.2.2.2.1
    finrank_cohomology_zero :=
      @CohenMacaulayCurveSituation.finrank_cohomologyOverField_zero_eq_invertibleCurveDegree
        S L _ (Stacks.Duality.dualizingSheafOverField S.f)
        ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨S.X.presheaf,
          Presheaf.isSheaf_of_isSheaf_comp _ (S.X.presheaf) (forget₂ CommRingCat RingCat)
            (S.X.ringCatSheaf.property)⟩).obj
            (Stacks.Duality.dualizingSheafOverField S.f)).obj (L)))
        hdata.choose hωc hFc hdata.choose_spec.choose_spec.choose_spec.choose_spec.2.1
        hdata.choose_spec.choose hdata.choose_spec.choose_spec.choose
        hdata.choose_spec.choose_spec.choose_spec.choose
        hdata.choose_spec.choose_spec.choose_spec.choose_spec.1
        hdata.choose_spec.choose_spec.choose_spec.choose_spec.2.2.2.1 rfl rfl
        (S.subsingleton_globalSections_tensorPowerModule_neg_one L hL hd)
        (S.isZero_cohomologyOverField_one_dualizing_tensorSheaf L hL hd)
    range_modulesStalk_le :=
      hdata.choose_spec.choose_spec.choose_spec.choose_spec.2.2.2.2 }

/-- **[Stacks, Tag 0B5H] over an algebraically closed field.** In Situation
[Stacks, Tag 0B5D] with `k` algebraically closed, let `ω_X = H^{-1}(f^×(𝒪_{Spec k}))` be the
