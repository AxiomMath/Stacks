/-!
# Global sections generating a zero-dimensional quotient of the dualizing sheaf

In Situation [Stacks, Tag 0B5D] — a field `k` and a proper one-dimensional `k`-scheme `X` with
`H⁰(X, 𝒪_X) = k` — let `ω` be the dualizing sheaf and let `ω ⟶ ℱ ⟶ 𝒬 ⟶ 0` be an exact sequence
of coherent `𝒪_X`-modules with `𝒬` supported in dimension zero, `dim_k H⁰(X, 𝒬) ≥ 2`, and no
nonzero submodule of `ℱ` injecting into `𝒬`. [Stacks, Tag 0B5F] asserts that the submodule of
`ℱ` generated by the global sections of `ℱ` surjects onto `𝒬`.

## Main definitions

* `AlgebraicGeometry.globalSectionsHom`: the canonical map from the free module on all global
  sections of a module to that module; its image is the submodule generated by the global
  sections.
* `AlgebraicGeometry.CohenMacaulayCurveSituation.FirstCohomologyVanishingOnSub` and
  `AlgebraicGeometry.CohenMacaulayCurveSituation.IsZeroOnQuotientsWithoutSections`: `H¹` vanishes
  on every submodule of `𝒬`, and a quotient of `𝒬` with no global sections is zero.

## Main results

* `AlgebraicGeometry.mono_cokernel_desc_of_exact`: for an exact sequence `ω ⟶ ℱ ⟶ 𝒬` and a
  submodule `ℱ' ⊆ ℱ` containing the image of `ω`, the quotient `ℱ'/ω` is a submodule of `𝒬`.
* `AlgebraicGeometry.topologicalKrullDim_supp_le_zero_of_mono` and
  `AlgebraicGeometry.topologicalKrullDim_supp_le_zero_of_epi`: a submodule and a quotient module
  of a module whose support has dimension at most zero again have such a support.
* `AlgebraicGeometry.cohomologyOverFieldMap_zero_eq_zero_of_globalSectionsHom_comp`: a morphism
  killing every global section induces the zero map on `H⁰`.
* `AlgebraicGeometry.CohenMacaulayCurveSituation.globalSectionsHom_comp_ne_zero`: the global
  sections of `ℱ` do not all die in `𝒬`.
* `AlgebraicGeometry.isZero_of_isZero_cohomologyOverField_zero_of_supp_dim_le_zero`: a coherent
  module whose support has dimension at most zero and whose `H⁰` vanishes is zero, on a proper
  scheme over a field.
* `AlgebraicGeometry.CohenMacaulayCurveSituation.isZero_firstCohomology_of_supp_dim_le_zero` and
  `AlgebraicGeometry.CohenMacaulayCurveSituation.isZero_of_supp_dim_le_zero_of_isZero_sections`:
  the two clauses of [Stacks, Tag 0B3J] for a coherent module with zero-dimensional support.
* `AlgebraicGeometry.CohenMacaulayCurveSituation.isZero_firstCohomology_of_mono` and its variant
  `isZero_firstCohomology_of_mono_of_supp_dim_le_zero`: `H¹` vanishes on a submodule of `ℱ`
  which contains the image of `ω` and maps nontrivially to `𝒬`, the first from the two
  properties of `𝒬` above and the second when `dim Supp 𝒬 ≤ 0`.
* `AlgebraicGeometry.CohenMacaulayCurveSituation.epi_globalSectionsHom_comp`: the submodule of
  `ℱ` generated by its global sections surjects onto `𝒬`.

## References

* [Stacks Project, Tag 0B5F](https://stacks.math.columbia.edu/tag/0B5F)
* [Stacks Project, Tag 0B5D](https://stacks.math.columbia.edu/tag/0B5D)
* [Stacks Project, Tag 0B5E](https://stacks.math.columbia.edu/tag/0B5E)
* [Stacks Project, Tag 0B3J](https://stacks.math.columbia.edu/tag/0B3J)
* [Stacks Project, Tag 0AYT](https://stacks.math.columbia.edu/tag/0AYT)
* [Stacks Project, Tag 01Y1](https://stacks.math.columbia.edu/tag/01Y1)
* [Stacks Project, Tag 0BS2](https://stacks.math.columbia.edu/tag/0BS2)
* [Stacks Project, Tag 0B5B](https://stacks.math.columbia.edu/tag/0B5B)
* [Stacks Project, Tag 02UZ](https://stacks.math.columbia.edu/tag/02UZ)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry

/-! ### A quotient of a submodule is a submodule of the quotient -/

section Abelian

attribute [local instance] CategoryTheory.Abelian.Pseudoelement.homToFun

/-- **A quotient of a submodule of `ℱ` containing the image of `ω` is a submodule of the
quotient of `ℱ` by `ω`.** Precisely: for an exact `ω ⟶ ℱ ⟶ 𝒬` in an abelian category, a
monomorphism `ι : ℱ' ⟶ ℱ` and a factorization `α' ≫ ι = α` of `ω ⟶ ℱ` through it, the induced
map `coker(α') ⟶ 𝒬` is a monomorphism. -/
public theorem mono_cokernel_desc_of_exact {A : Type*} [Category* A] [Abelian A]
    {W F F' Q : A} (α : W ⟶ F) (β : F ⟶ Q) (hαβ : α ≫ β = 0)
    (hex : (ShortComplex.mk α β hαβ).Exact) (ι : F' ⟶ F) [Mono ι] (α' : W ⟶ F')
    (hα' : α' ≫ ι = α) (h0 : α' ≫ (ι ≫ β) = 0) :
    Mono (cokernel.desc α' (ι ≫ β) h0) := by
  refine Abelian.Pseudoelement.mono_of_zero_of_map_zero _ fun a ha => ?_
  obtain ⟨x, hx⟩ := Abelian.Pseudoelement.pseudo_surjective_of_epi (cokernel.π α') a
  have hπd : cokernel.π α' ≫ cokernel.desc α' (ι ≫ β) h0 = ι ≫ β := cokernel.π_desc _ _ _
  have h1 : β (ι x) = 0 := by
    rw [← Abelian.Pseudoelement.comp_apply, ← hπd, Abelian.Pseudoelement.comp_apply, hx, ha]
  obtain ⟨w, hw⟩ := Abelian.Pseudoelement.pseudo_exact_of_exact hex _ h1
  have hw' : ι (α' w) = ι x := by
    rw [← Abelian.Pseudoelement.comp_apply, hα']; exact hw
  have hxw : α' w = x := Abelian.Pseudoelement.pseudo_injective_of_mono ι hw'
  rw [← hx, ← hxw, ← Abelian.Pseudoelement.comp_apply, cokernel.condition,
    Abelian.Pseudoelement.zero_apply]

end Abelian

/-- A morphism with zero cokernel is an epimorphism. -/
public theorem epi_of_isZero_cokernel {A : Type*} [Category* A] [Abelian A] {M N : A}
    (f : M ⟶ N) (h : IsZero (cokernel f)) : Epi f :=
  Preadditive.epi_of_isZero_cokernel f h

/-! ### Supports of submodules and of quotient modules -/

/-- The support of a submodule is contained in the support of the module. -/
theorem supp_subset_of_mono_stalkwise {Y : TopCat.{u}}
    {O : Sheaf (Opens.grothendieckTopology Y) RingCat.{u}}
    {M N : SheafOfModules.{u} O} (v : M ⟶ N) (hv : Mono v) :
    SheafOfModules.supp M ⊆ SheafOfModules.supp N := by
  have hm : Mono ((SheafOfModules.toSheaf O).map v) := (SheafOfModules.toSheaf O).map_mono v
  rintro x ⟨a, ha⟩
  have hs : Mono ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
      ((SheafOfModules.toSheaf O).map v).hom) :=
    (TopCat.Presheaf.mono_iff_stalk_mono _).mp hm x
  have hinj := (AddCommGrpCat.mono_iff_injective _).mp hs
  refine ⟨((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
      ((SheafOfModules.toSheaf O).map v).hom).hom a, fun h0 => ha (hinj ?_)⟩
  rw [h0]
  exact (map_zero _).symm

private theorem supp_subset_of_epi_stalkwise {Y : TopCat.{u}}
    {O : Sheaf (Opens.grothendieckTopology Y) RingCat.{u}}
    {M N : SheafOfModules.{u} O} (p : M ⟶ N) (hp : Epi p) :
    SheafOfModules.supp N ⊆ SheafOfModules.supp M := by
  rintro x ⟨a, ha⟩
  obtain ⟨b, hb⟩ := Stacks.SheafOfModules.StalkEpiMono.stalk_surjective_of_epi p x a
  exact ⟨b, fun h0 => ha (by rw [← hb, h0, map_zero])⟩

/-- A submodule of a module whose support has dimension at most zero has such a support too. -/
public theorem topologicalKrullDim_supp_le_zero_of_mono {X : Scheme.{u}} {M N : X.Modules}
    (v : M ⟶ N) (hv : Mono v) (hN : topologicalKrullDim (SheafOfModules.supp N) ≤ 0) :
    topologicalKrullDim (SheafOfModules.supp M) ≤ 0 := by
  have hsub : SheafOfModules.supp M ⊆ SheafOfModules.supp N :=
    supp_subset_of_mono_stalkwise (O := X.ringCatSheaf) v
      ⟨fun g₁ g₂ hg => hv.right_cancellation g₁ g₂ hg⟩
  exact le_trans (Topology.IsEmbedding.inclusion hsub).isInducing.topologicalKrullDim_le hN

/-- A quotient of a module whose support has dimension at most zero has such a support too. -/
public theorem topologicalKrullDim_supp_le_zero_of_epi {X : Scheme.{u}} {M N : X.Modules}
    (p : M ⟶ N) (hp : Epi p) (hM : topologicalKrullDim (SheafOfModules.supp M) ≤ 0) :
    topologicalKrullDim (SheafOfModules.supp N) ≤ 0 := by
  have hsub : SheafOfModules.supp N ⊆ SheafOfModules.supp M :=
    supp_subset_of_epi_stalkwise (O := X.ringCatSheaf) p
      ⟨fun g₁ g₂ hg => hp.left_cancellation g₁ g₂ hg⟩
  exact le_trans (Topology.IsEmbedding.inclusion hsub).isInducing.topologicalKrullDim_le hM

/-! ### The submodule generated by the global sections -/

/-- The free `𝒪_X`-module on the set of all global sections of `ℱ`. -/
public def globalSectionsFree {X : Scheme.{u}} (F : X.Modules) : X.Modules :=
  SheafOfModules.free (R := X.ringCatSheaf) F.sections

/-- The free `𝒪_X`-module on the global sections of `ℱ` is quasi-coherent. -/
public instance isQuasicoherent_globalSectionsFree {X : Scheme.{u}} (F : X.Modules) :
    (globalSectionsFree F).IsQuasicoherent :=
  Stacks.AlgebraicGeometry.AffineQcohEquivalence.isQuasicoherent_free F.sections

/-- The canonical map `⨁_{s ∈ Γ(X, ℱ)} 𝒪_X ⟶ ℱ` sending the basis vector at a global section
`s` to `s`. Its image is the submodule of `ℱ` generated by the global sections of `ℱ`. -/
public def globalSectionsHom {X : Scheme.{u}} (F : X.Modules) : globalSectionsFree F ⟶ F :=
  F.freeHomEquiv.symm id

private lemma sectionsMap_globalSectionsHom {X : Scheme.{u}} (F : X.Modules) (x : F.sections) :
    SheafOfModules.sectionsMap (globalSectionsHom F) (SheafOfModules.freeSection x) = x :=
  SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection _ _

private lemma app_top_eval {X : Scheme.{u}} {F G : X.Modules} (φ : F ⟶ G) (x : F.sections) :
    φ.app ⊤ (x.eval (op ⊤)) = (SheafOfModules.sectionsMap φ x).eval (op ⊤) := rfl

/-- If `globalSectionsHom ℱ ≫ φ = 0`, then `H⁰(X, φ)` is the zero map. -/
public theorem cohomologyOverFieldMap_zero_eq_zero_of_globalSectionsHom_comp
    {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) {F G : X.Modules}
    (φ : F ⟶ G) (h : globalSectionsHom F ≫ φ = 0) (a : cohomologyOverField k f F 0) :
    cohomologyOverFieldMap k f φ 0 a = 0 := by
  have happ : ∀ t : Γ(F, ⊤), φ.app ⊤ t = 0 := by
    intro t
    have e2 : SheafOfModules.sectionsMap (globalSectionsHom F ≫ φ)
        (SheafOfModules.freeSection (sectionOfGlobalValue F t))
        = SheafOfModules.sectionsMap φ (sectionOfGlobalValue F t) :=
      (SheafOfModules.sectionsMap_comp (globalSectionsHom F) φ _).trans
        (congrArg (SheafOfModules.sectionsMap φ)
          (sectionsMap_globalSectionsHom F (sectionOfGlobalValue F t)))
    have e3 : SheafOfModules.sectionsMap (globalSectionsHom F ≫ φ)
        (SheafOfModules.freeSection (sectionOfGlobalValue F t))
        = SheafOfModules.sectionsMap (0 : globalSectionsFree F ⟶ G)
            (SheafOfModules.freeSection (sectionOfGlobalValue F t)) :=
      congrArg (fun ψ : globalSectionsFree F ⟶ G =>
        SheafOfModules.sectionsMap ψ (SheafOfModules.freeSection (sectionOfGlobalValue F t))) h
    have e4 := congrArg (fun y : G.sections => y.eval (op ⊤)) (e2.symm.trans e3)
    have e5 : (0 : globalSectionsFree F ⟶ G).app ⊤
        ((SheafOfModules.freeSection (sectionOfGlobalValue F t)).eval (op ⊤)) = 0 := rfl
    exact (congrArg (fun z => φ.app ⊤ z) (sectionOfGlobalValue_eval_top F t).symm).trans
      ((app_top_eval φ (sectionOfGlobalValue F t)).trans (e4.trans
        ((app_top_eval (0 : globalSectionsFree F ⟶ G) _).symm.trans e5)))
  have h0 : cohomologyOverFieldMap k f φ 0 (0 : cohomologyOverField k f F 0) = 0 := by simp
  refine Eq.trans ?_ h0
  refine (cohomologyOverFieldZeroEquivSections k f G).injective ?_
  rw [cohomologyOverFieldZeroEquivSections_cohomologyOverFieldMap,
    cohomologyOverFieldZeroEquivSections_cohomologyOverFieldMap, happ, happ]

/-! ### A coherent module with zero-dimensional support and no global sections -/

/-- On a proper scheme over a field, a coherent module whose support has dimension at most zero
and which has no global sections is zero. -/
public theorem isZero_of_isZero_cohomologyOverField_zero_of_supp_dim_le_zero
    {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProper f] {M : X.Modules}
    (hM : M.IsCoherent) (hdim : topologicalKrullDim (SheafOfModules.supp M) ≤ 0)
    (h0 : IsZero (cohomologyOverField k f M 0)) : IsZero M := by
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  obtain ⟨G⟩ := nonempty_generatingSections_of_support_dim_le_zero M hdim
  have h0' := ModuleCat.subsingleton_of_isZero h0
  have hΓ : Subsingleton Γ(M, ⊤) :=
    (cohomologyOverFieldZeroEquivSections k f M).symm.subsingleton
  have hsec : Subsingleton (M.val.obj (op ⊤)) := hΓ
  refine Stacks.AlgebraicGeometry.DevissageNoetherian.isZero_of_supp_eq_empty M ?_
  refine Set.eq_empty_iff_forall_notMem.mpr fun x hx => ?_
  obtain ⟨a, ha⟩ := hx
  have hspan := (generates_iff_stalkwise_generates (O_X := X.ringCatSheaf) (F := M) G.s).mp
    G.epi x
  have hzero : Submodule.span (R := (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat))
      (Set.range fun i ↦ (TopCat.Presheaf.Γgerm M.val.presheaf x).hom
        ((G.s i).eval (op ⊤))) = ⊥ := by
    refine Submodule.span_eq_bot.mpr ?_
    rintro y ⟨i, rfl⟩
    simp only [show (G.s i).eval (op ⊤) = 0 from Subsingleton.elim _ _]
    exact map_zero _
  rw [hzero] at hspan
  refine ha ?_
  have hmem : a ∈ (⊥ : Submodule (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat) _) := by
    rw [hspan]; trivial
  simpa using hmem

/-- If `F' ⊆ F` contains the image of `α' : W ⟶ F'` and `F' ≅ W ⊞ coker α'` compatibly with the
projection to `coker α'`, then a `coker α' ↪ Q` forces `F' ⟶ Q` to vanish, provided no nonzero
submodule of `F` injects into `Q`. -/
private theorem ι_comp_eq_zero_of_iso_biprod_cokernel {A : Type*} [Category* A] [Abelian A]
    {W F F' Q : A} (β : F ⟶ Q) (ι : F' ⟶ F) [Mono ι] (α' : W ⟶ F')
    (h : α' ≫ (ι ≫ β) = 0) (hj : Mono (cokernel.desc α' (ι ≫ β) h)) (e : F' ≅ W ⊞ cokernel α')
    (he : e.hom ≫ biprod.snd = cokernel.π α')
    (hnosub : ∀ (M : A) (u : M ⟶ F), Mono u → Mono (u ≫ β) → IsZero M) : ι ≫ β = 0 := by
  have hπj : cokernel.π α' ≫ cokernel.desc α' (ι ≫ β) h = ι ≫ β := cokernel.π_desc _ _ _
  have hu : (biprod.inr ≫ e.inv) ≫ cokernel.π α' = 𝟙 (cokernel α') := by
    rw [← he]; simp
  have heq : (biprod.inr ≫ e.inv ≫ ι) ≫ β = cokernel.desc α' (ι ≫ β) h := by
    conv_lhs => rw [Category.assoc, Category.assoc, ← hπj]
    simp only [← Category.assoc, hu, Category.id_comp]
  have hmono1 : Mono ((biprod.inr ≫ e.inv ≫ ι) ≫ β) := by rw [heq]; exact hj
  have hmono2 : Mono (biprod.inr ≫ e.inv ≫ ι) :=
    have := hmono1
    mono_of_mono _ β
  have hzQ : IsZero (cokernel α') := hnosub (cokernel α') _ hmono2 hmono1
  rw [← hπj, hzQ.eq_of_tgt (cokernel.π α') 0, zero_comp]

namespace CohenMacaulayCurveSituation

variable (S : CohenMacaulayCurveSituation.{u})

/-! ### The two consequences of a zero-dimensional support, as properties of `𝒬` -/

/-- `H¹(X, -)` vanishes on every submodule of `𝒬`. -/
public def FirstCohomologyVanishingOnSub (Q : S.X.Modules) : Prop :=
  ∀ (M : S.X.Modules) (j : M ⟶ Q), Mono j → IsZero (cohomologyOverField S.k S.f M 1)

/-- Every quotient of `𝒬` with no global sections is zero. -/
public def IsZeroOnQuotientsWithoutSections (Q : S.X.Modules) : Prop :=
  ∀ (M : S.X.Modules) (q : Q ⟶ M), Epi q → IsZero (cohomologyOverField S.k S.f M 0) → IsZero M

/-! ### Global sections of `ℱ` and `H¹` of submodules of `ℱ` -/

variable {S}

/-- For an exact sequence `ω ⟶ ℱ ⟶ 𝒬 ⟶ 0` with `dim_k H⁰(X, 𝒬) ≥ 2` and `dim_k H¹(X, ω) = 1`,
the global sections of `ℱ` do not all map to zero in `𝒬`. -/
public theorem globalSectionsHom_comp_ne_zero (hH2 : S.SecondCohomologyVanishing)
    {ω F Q : S.X.Modules} (hone : Module.finrank S.k (cohomologyOverField S.k S.f ω 1) = 1)
    (α : ω ⟶ F) (β : F ⟶ Q) (hαβ : α ≫ β = 0) (hex : (ShortComplex.mk α β hαβ).Exact) [Epi β]
    (htwo : 2 ≤ Module.finrank S.k (cohomologyOverField S.k S.f Q 0)) :
    globalSectionsHom F ≫ β ≠ 0 := by
  intro h0
  have hzmap : ∀ a, cohomologyOverFieldMap S.k S.f β 0 a = 0 := fun a =>
    cohomologyOverFieldMap_zero_eq_zero_of_globalSectionsHom_comp S.f β h0 a
  have hρepi : Epi (kernel.lift β α hαβ) := hex.epi_kernelLift
  have hsurj : Function.Surjective
      (cohomologyOverFieldMap S.k S.f (kernel.lift β α hαβ) 1) :=
    surjective_cohomologyOverFieldMap_g_of_isZero
      (T := ShortComplex.mk (kernel.ι (kernel.lift β α hαβ)) (kernel.lift β α hαβ)
        (kernel.condition _))
      (ShortComplex.shortExact_mk_kernel_ι (kernel.lift β α hαβ)) 1
      (hH2 (kernel (kernel.lift β α hαβ)))
  have hfinω : FiniteDimensional S.k (cohomologyOverField S.k S.f ω 1) :=
    FiniteDimensional.of_finrank_pos (by omega)
  have hfink : FiniteDimensional S.k (cohomologyOverField S.k S.f (kernel β) 1) :=
    Module.Finite.of_surjective
      (cohomologyOverFieldMap S.k S.f (kernel.lift β α hαβ) 1).hom hsurj
  have hle1 : Module.finrank S.k (cohomologyOverField S.k S.f (kernel β) 1) ≤
      Module.finrank S.k (cohomologyOverField S.k S.f ω 1) :=
    LinearMap.finrank_le_finrank_of_surjective
      (f := (cohomologyOverFieldMap S.k S.f (kernel.lift β α hαβ) 1).hom) hsurj
  have hle2 : Module.finrank S.k (cohomologyOverField S.k S.f Q 0) ≤
      Module.finrank S.k (cohomologyOverField S.k S.f (kernel β) 1) :=
    finrank_zeroth_le_finrank_first
      (T := ShortComplex.mk (kernel.ι β) β (kernel.condition β))
      (ShortComplex.shortExact_mk_kernel_ι β) hfink hzmap
  omega

/-- If `H¹(X, -)` vanishes on every submodule of `𝒬`, then `H¹` vanishes on a submodule of `ℱ`
containing the image of `ω` and mapping nontrivially to `𝒬`. -/
public theorem isZero_firstCohomology_of_mono {ω F F' Q : S.X.Modules}
    (hωq : ω.IsQuasicoherent) (hF'q : F'.IsQuasicoherent)
    (hdual : S.FirstCohomologyDuality ω) (hH2 : S.SecondCohomologyVanishing)
    (hone : Module.finrank S.k (cohomologyOverField S.k S.f ω 1) = 1)
    (α : ω ⟶ F) (β : F ⟶ Q) (hαβ : α ≫ β = 0) (hex : (ShortComplex.mk α β hαβ).Exact)
    (ι : F' ⟶ F) [Mono ι] (α' : ω ⟶ F') (hα'ι : α' ≫ ι = α) (hne : ι ≫ β ≠ 0)
    (hsub : S.FirstCohomologyVanishingOnSub Q)
    (hnosub : ∀ (M : S.X.Modules) (u : M ⟶ F), Mono u → Mono (u ≫ β) → IsZero M) :
    IsZero (cohomologyOverField S.k S.f F' 1) := by
  have hα'β : α' ≫ (ι ≫ β) = 0 := by rw [← Category.assoc, hα'ι, hαβ]
  have hjmono : Mono (cokernel.desc α' (ι ≫ β) hα'β) :=
    mono_cokernel_desc_of_exact α β hαβ hex ι α' hα'ι hα'β
  rcases isZero_firstCohomology_or_iso_biprod hωq hF'q hdual hH2 hone α' (cokernel.π α')
    (cokernel.condition α') (ShortComplex.cokernelSequence_exact α')
    (hsub (cokernel α') (cokernel.desc α' (ι ≫ β) hα'β) hjmono) with h | ⟨e, he1, he2⟩
  · exact h
  · exact (hne (ι_comp_eq_zero_of_iso_biprod_cokernel β ι α' hα'β hjmono e he2 hnosub)).elim

/-! ### Coherent modules with zero-dimensional support -/

/-- `H¹(X, -)` vanishes on a coherent module whose support has dimension at most zero. -/
public theorem isZero_firstCohomology_of_supp_dim_le_zero {M : S.X.Modules} (hM : M.IsCoherent)
    (hdim : topologicalKrullDim (SheafOfModules.supp M) ≤ 0) :
    IsZero (cohomologyOverField S.k S.f M 1) :=
  isZero_cohomologyOverField_of_topologicalKrullDim_supp_le_zero S.k S.f M hdim 1 Nat.one_pos

/-- A coherent module whose support has dimension at most zero and which has no global sections
is zero. -/
public theorem isZero_of_supp_dim_le_zero_of_isZero_sections {M : S.X.Modules}
    (hM : M.IsCoherent) (hdim : topologicalKrullDim (SheafOfModules.supp M) ≤ 0)
    (h0 : IsZero (cohomologyOverField S.k S.f M 0)) : IsZero M :=
  isZero_of_isZero_cohomologyOverField_zero_of_supp_dim_le_zero S.f hM hdim h0

/-- When the support of `𝒬` has dimension at most zero, `H¹` vanishes on a coherent submodule
of `ℱ` containing the image of `ω` and mapping nontrivially to `𝒬`. -/
public theorem isZero_firstCohomology_of_mono_of_supp_dim_le_zero {ω F F' Q : S.X.Modules}
    (hωq : ω.IsQuasicoherent) (hF'c : F'.IsCoherent)
    (hdual : S.FirstCohomologyDuality ω)
    (hone : Module.finrank S.k (cohomologyOverField S.k S.f ω 1) = 1)
    (α : ω ⟶ F) (β : F ⟶ Q) (hαβ : α ≫ β = 0) (hex : (ShortComplex.mk α β hαβ).Exact)
    (ι : F' ⟶ F) [Mono ι] (α' : ω ⟶ F') (hα'ι : α' ≫ ι = α) (hne : ι ≫ β ≠ 0)
    (hQdim : topologicalKrullDim (SheafOfModules.supp Q) ≤ 0)
    (hnosub : ∀ (M : S.X.Modules) (u : M ⟶ F), Mono u → Mono (u ≫ β) → IsZero M) :
    IsZero (cohomologyOverField S.k S.f F' 1) := by
  have : IsLocallyNoetherian S.X := LocallyOfFiniteType.isLocallyNoetherian S.f
  have hF'q : F'.IsQuasicoherent :=
    (Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent F').1
  have hα'β : α' ≫ (ι ≫ β) = 0 := by rw [← Category.assoc, hα'ι, hαβ]
  have hjmono : Mono (cokernel.desc α' (ι ≫ β) hα'β) :=
    mono_cokernel_desc_of_exact α β hαβ hex ι α' hα'ι hα'β
  have hCc : (cokernel α').IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_epi_of_isQuasicoherent hF'c
      (cokernel.π α')
  have hCdim : topologicalKrullDim (SheafOfModules.supp (cokernel α')) ≤ 0 :=
    topologicalKrullDim_supp_le_zero_of_mono (cokernel.desc α' (ι ≫ β) hα'β) hjmono hQdim
  rcases isZero_firstCohomology_or_iso_biprod hωq hF'q hdual S.secondCohomologyVanishing hone α'
    (cokernel.π α') (cokernel.condition α') (ShortComplex.cokernelSequence_exact α')
    (isZero_firstCohomology_of_supp_dim_le_zero hCc hCdim) with h | ⟨e, he1, he2⟩
  · exact h
  · exact (hne (ι_comp_eq_zero_of_iso_biprod_cokernel β ι α' hα'β hjmono e he2 hnosub)).elim

/-! ### Global generation onto `𝒬` -/

/-- In Situation [Stacks, Tag 0B5D], let `ω` be the dualizing sheaf of `X` and let
`ω ⟶ ℱ ⟶ 𝒬 ⟶ 0` be an exact sequence of coherent `𝒪_X`-modules such that the support of `𝒬` has
dimension at most zero, `dim_k H⁰(X, 𝒬) ≥ 2`, and no nonzero submodule of `ℱ` maps injectively
to `𝒬`. Then the submodule of `ℱ` generated by the global sections of `ℱ` surjects onto `𝒬`. -/
@[stacks 0B5F "two properties of ω are arguments, neither of them an assertion of this tag, \
because the library has no dualizing sheaf of a proper curve over a field: clause (5) of \
Tag 0BS2 is hdual and dim_k H¹(X, ω) = 1 of Section 0B5B is hone. The rest is proved here: \
both clauses of Tag 0B3J are applied to the zero-dimensional support of Q, as the source does, \
and the vanishing of H²(X, -) of Tag 02UZ comes from secondCohomologyVanishing"]
public theorem epi_globalSectionsHom_comp {ω F Q : S.X.Modules}
    (hωq : ω.IsQuasicoherent) (hFq : F.IsQuasicoherent) (hFft : F.IsFiniteType)
    (hQq : Q.IsQuasicoherent) (hdual : S.FirstCohomologyDuality ω)
    (hone : Module.finrank S.k (cohomologyOverField S.k S.f ω 1) = 1)
    (α : ω ⟶ F) (β : F ⟶ Q) (hαβ : α ≫ β = 0)
    (hex : (ShortComplex.mk α β hαβ).Exact) [Epi β]
    (hQdim : topologicalKrullDim (SheafOfModules.supp Q) ≤ 0)
    (htwo : 2 ≤ Module.finrank S.k (cohomologyOverField S.k S.f Q 0))
    (hnosub : ∀ (M : S.X.Modules) (u : M ⟶ F), Mono u → Mono (u ≫ β) → IsZero M) :
    Epi (globalSectionsHom F ≫ β) := by
  have : IsLocallyNoetherian S.X := LocallyOfFiniteType.isLocallyNoetherian S.f
  have hFc : F.IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_isQuasicoherent_of_isFiniteType F
  have hQc : Q.IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_epi_of_isQuasicoherent hFc β
  have hγ0 : globalSectionsHom F ≫ (β ≫ cokernel.π (globalSectionsHom F ≫ β)) = 0 := by
    rw [← Category.assoc, cokernel.condition]
  have hα0 : α ≫ (β ≫ cokernel.π (globalSectionsHom F ≫ β)) = 0 := by
    rw [← Category.assoc, hαβ, zero_comp]
  have hepiδ : Epi (β ≫ cokernel.π (globalSectionsHom F ≫ β)) := epi_comp _ _
  have hev : kernel.lift (β ≫ cokernel.π (globalSectionsHom F ≫ β)) (globalSectionsHom F) hγ0 ≫
      kernel.ι (β ≫ cokernel.π (globalSectionsHom F ≫ β)) = globalSectionsHom F :=
    kernel.lift_ι _ _ _
  have hα'ι : kernel.lift (β ≫ cokernel.π (globalSectionsHom F ≫ β)) α hα0 ≫
      kernel.ι (β ≫ cokernel.π (globalSectionsHom F ≫ β)) = α := kernel.lift_ι _ _ _
  have hne : kernel.ι (β ≫ cokernel.π (globalSectionsHom F ≫ β)) ≫ β ≠ 0 := by
    intro h
    refine globalSectionsHom_comp_ne_zero S.secondCohomologyVanishing hone α β hαβ hex htwo ?_
    rw [← hev, Category.assoc, h, comp_zero]
  have hCc : (cokernel (globalSectionsHom F ≫ β)).IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_epi_of_isQuasicoherent hQc
      (cokernel.π (globalSectionsHom F ≫ β))
  have hF'c : (kernel (β ≫ cokernel.π (globalSectionsHom F ≫ β))).IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_mono_of_isQuasicoherent hFc
      (kernel.ι (β ≫ cokernel.π (globalSectionsHom F ≫ β)))
  have hF'1 : IsZero (cohomologyOverField S.k S.f
      (kernel (β ≫ cokernel.π (globalSectionsHom F ≫ β))) 1) :=
    isZero_firstCohomology_of_mono_of_supp_dim_le_zero hωq hF'c hdual hone α β hαβ hex
      (kernel.ι _) (kernel.lift _ α hα0) hα'ι hne hQdim hnosub
  have hsurj0 : Function.Surjective (cohomologyOverFieldMap S.k S.f
      (β ≫ cokernel.π (globalSectionsHom F ≫ β)) 0) :=
    surjective_cohomologyOverFieldMap_g_of_isZero
      (T := ShortComplex.mk (kernel.ι (β ≫ cokernel.π (globalSectionsHom F ≫ β)))
        (β ≫ cokernel.π (globalSectionsHom F ≫ β)) (kernel.condition _))
      (ShortComplex.shortExact_mk_kernel_ι _) 0 hF'1
  have hzero0 : ∀ a, cohomologyOverFieldMap S.k S.f
      (β ≫ cokernel.π (globalSectionsHom F ≫ β)) 0 a = 0 := fun a =>
    cohomologyOverFieldMap_zero_eq_zero_of_globalSectionsHom_comp S.f _ hγ0 a
  have hC0 : IsZero (cohomologyOverField S.k S.f (cokernel (globalSectionsHom F ≫ β)) 0) := by
    refine @ModuleCat.isZero_of_subsingleton _ _ _ ⟨fun a b => ?_⟩
    obtain ⟨a', rfl⟩ := hsurj0 a
    obtain ⟨b', rfl⟩ := hsurj0 b
    rw [hzero0, hzero0]
  have hπepi : Epi (cokernel.π (globalSectionsHom F ≫ β)) := inferInstance
  have hCdim : topologicalKrullDim
      (SheafOfModules.supp (cokernel (globalSectionsHom F ≫ β))) ≤ 0 :=
    topologicalKrullDim_supp_le_zero_of_epi (cokernel.π (globalSectionsHom F ≫ β)) hπepi hQdim
  exact epi_of_isZero_cokernel _
    (isZero_of_supp_dim_le_zero_of_isZero_sections hCc hCdim hC0)

