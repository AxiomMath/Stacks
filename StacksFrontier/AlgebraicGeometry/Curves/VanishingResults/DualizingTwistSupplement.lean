namespace AlgebraicGeometry

/-- **An integer tensor power of an invertible `𝒪_X`-module is quasi-coherent.** Every tensor
power of an invertible module is invertible ([Stacks, Tag 01CU]), and an invertible module on a
scheme is finite locally free of rank one ([Stacks, Tag 0B8M]), hence locally free, hence
quasi-coherent ([Stacks, Tag 01C7]).

The invertibility predicate has two byte-identical spellings in this library, and
`Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry` is the bridge between the one a
consumer carries and the one the quasi-coherence is stated for. -/
public theorem isQuasicoherent_tensorPowerModule {X : Scheme.{u}} (L : X.Modules)
    [IsInvertible X.presheaf X.ringCatSheaf.property L] (n : ℤ) :
    (tensorPowerModule L n).IsQuasicoherent :=
  have : Stacks.SheafOfModules.IsInvertible X.presheaf
      (Stacks.SheafOfModules.TensorSheafification.structureSheaf X.presheaf
        X.ringCatSheaf.property).property (tensorPowerModule L n) :=
    (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry X.presheaf
      X.ringCatSheaf.property (tensorPowerModule L n)).2 inferInstance
  Stacks.SheafOfModules.Scheme.isQuasicoherent_of_isInvertible X (tensorPowerModule L n)

namespace CohenMacaulayCurveSituation

variable (S : CohenMacaulayCurveSituation.{u})

variable {S}

variable (S)

/-- **[Stacks, Tag 0B62] for a module for which duality holds**, which is the shape a consumer
with a dualizing sheaf of its own needs: granted `DualityVanishing ω`, the tag's conclusion
`H¹(X, ω ⊗ ℒ) = 0` holds for an invertible `ℒ` which is generated by its global sections and is
not isomorphic to `𝒪_X`.

This is the reduction of the tag to `H⁰(X, ℒ^{⊗ -1}) = 0`, which is
`subsingleton_globalSections_inverse_of_generatingSections`, and nothing else. At the canonical
dualizing sheaf the hypothesis is discharged by `dualityVanishing_dualizingSheafOverField` and the
result is `isZero_firstCohomology_dualizing_tensor_unconditional`; the tag itself is registered at
`isZero_firstCohomology_dualizingSheafOverField_tensor`.

The consumer is
`AlgebraicGeometry.BlowUpDualizing.isZero_firstCohomology_curveTwist_of_dualityVanishing` of
`…/RationalSingularities/ExceptionalTwistGlobalGeneration.lean`, at the exceptional curve of a
blow-up. -/
public theorem isZero_firstCohomology_tensor_of_dualityVanishing (ω : S.X.Modules)
    (hdual : S.DualityVanishing ω)
    (L : S.X.Modules) [IsInvertible S.X.presheaf S.X.ringCatSheaf.property L]
    (σ : L.GeneratingSections)
    (hne : ¬ IsTrivial S.X.presheaf S.X.ringCatSheaf.property L) :
    IsZero (cohomologyOverField S.k S.f
      ((((Stacks.SheafOfModules.Tensor.sheafTensor
            ⟨S.X.presheaf, CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp _ S.X.presheaf
              (CategoryTheory.forget₂ CommRingCat RingCat)
              S.X.ringCatSheaf.property⟩).obj ω).obj L)) 1) :=
  hdual L (subsingleton_globalSections_inverse_of_generatingSections L σ hne)

/-- **[Stacks, Tag 0B62] at the canonical dualizing sheaf `ω_X`**, obtained from
`isZero_firstCohomology_tensor_of_dualityVanishing` and
`dualityVanishing_dualizingSheafOverField`: for an invertible `ℒ` generated by its global
sections and not isomorphic to `𝒪_X`, `H¹(X, ω_X ⊗ ℒ) = 0`. The tag is registered at
`isZero_firstCohomology_dualizingSheafOverField_tensor`. -/
public theorem isZero_firstCohomology_dualizing_tensor_unconditional
    (L : S.X.Modules) [IsInvertible S.X.presheaf S.X.ringCatSheaf.property L]
    (σ : L.GeneratingSections)
    (hne : ¬ IsTrivial S.X.presheaf S.X.ringCatSheaf.property L) :
    IsZero (cohomologyOverField S.k S.f
      ((((Stacks.SheafOfModules.Tensor.sheafTensor
            ⟨S.X.presheaf, CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp _ S.X.presheaf
              (CategoryTheory.forget₂ CommRingCat RingCat)
              S.X.ringCatSheaf.property⟩).obj
          (Stacks.Duality.dualizingSheafOverField S.f)).obj L)) 1) :=
  S.isZero_firstCohomology_tensor_of_dualityVanishing _
    S.dualityVanishing_dualizingSheafOverField L σ hne

