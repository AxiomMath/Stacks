/-!
# A genus-zero curve with an invertible module of degree one is the projective line

Let `X` be a proper integral scheme of dimension at most one over a field `k` with
`H⁰(X, 𝒪_X) = k` and genus `0`, and let `ℒ` be an invertible `𝒪_X`-module of degree `d > 0`.
For a basis `s₀, …, s_d` of `H⁰(X, ℒ)` (of dimension `d + 1`, by
`AlgebraicGeometry.finrank_globalSections_eq_invertibleCurveDegree_add_one`) the morphism
`φ : X ⟶ ℙ^d_k` of the basis is a closed immersion
(`AlgebraicGeometry.ProjectiveLineCriterion.isClosedImmersion_toPolynomialModel_of_basis`, the
closed immersion of [Stacks, Tag 0C6T] (2)). For `d = 1` it is an isomorphism, since its image is
an irreducible closed subset of dimension one of `ℙ¹_k`. Hence `X ≅ ℙ¹_k` over `k`
(`ProjectiveLineCriterion.exists_iso_projectiveLine_of_invertibleCurveDegree_eq_one`).
This is the step of the proof of [Stacks, Tag 0C6U] (and of [Stacks, Tag 0C6N]) that identifies
the curve with `ℙ¹_k`.

The closed immersion is checked on the standard charts `D₊(Tᵢ)`, whose preimages are the charts
`X_{sᵢ}`: these are affine because `φ` is finite, and `Γ(X_{sᵢ}, 𝒪_X)` is generated by the ratios
`sⱼ / sᵢ` by the pole-order induction of
`AlgebraicGeometry.ProjectiveLineCriterion.adjoin_ratio_eq_top_of_chart`, whose dimension input
is that the zero scheme of `sᵢ` has degree `d`.

## References

* [Stacks Project, Tag 0C6T](https://stacks.math.columbia.edu/tag/0C6T)
* [Stacks Project, Tag 0C6U](https://stacks.math.columbia.edu/tag/0C6U)
* [Stacks Project, Tag 01NE](https://stacks.math.columbia.edu/tag/01NE)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.ProjectiveFromSections

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

namespace AlgebraicGeometry.ProjectiveLineCriterion

variable {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))

/-- A member of an independent family of global sections is nonzero. -/
theorem ne_zero_of_independent {n : ℕ} (L : X.Modules) (s : Fin (n + 1) → Γ(L, ⊤))
    (hind : ∀ c : Fin (n + 1) → k,
      ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) • s j = 0 → c = 0)
    (i : Fin (n + 1)) : s i ≠ 0 := by
  intro h0
  have := hind (Pi.single i 1) (by
    rw [Finset.sum_eq_single i (fun j _ hj => by simp [Pi.single_eq_of_ne hj]) (by simp)]
    simp [h0])
  simpa using congrFun this i

/-- Two nonvanishing opens covering an irreducible scheme, neither of them everything, meet. -/
theorem nonempty_inter_of_sup_eq_top [IrreducibleSpace X] (U V : X.Opens) (h : U ⊔ V = ⊤)
    (hU : U ≠ ⊤) (hV : V ≠ ⊤) : ((U : Set X) ∩ V).Nonempty := by
  have hUne : (U : Set X).Nonempty := by
    rw [Set.nonempty_iff_ne_empty]
    intro hU'
    apply hV
    rw [← h, show U = ⊥ from SetLike.coe_injective hU', bot_sup_eq]
  have hVne : (V : Set X).Nonempty := by
    rw [Set.nonempty_iff_ne_empty]
    intro hV'
    apply hU
    rw [← h, show V = ⊥ from SetLike.coe_injective hV', sup_bot_eq]
  exact nonempty_preirreducible_inter U.2 V.2 hUne hVne

/-- **The chart rings of a basis of sections are generated by the ratios.** Let `X` be a proper
integral scheme of dimension at most one over `k` with `H⁰(X, 𝒪_X) = k` and genus `0`, and let
`s₀, …, s_d` be a basis of the global sections of an invertible module of degree `d > 0`. Then
`Γ(X_{sᵢ}, 𝒪_X)` is generated over `k` by the ratios `sⱼ / sᵢ`, for every `i`: a section `t`
without common zero with `sᵢ` has affine chart `X_t` (a chart of the finite morphism of the
family `(t, s₀, …, s_d)`), and the zero scheme of `sᵢ` read on `X_t` has dimension `d`. -/
theorem adjoin_ratio_eq_top_of_basis [IsProper f] [IsIntegral X]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)] (hdim : topologicalKrullDim X ≤ 1)
    (hgenus : genus f = 0) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L] {d : ℕ}
    (hdeg : invertibleCurveDegree k f hdim L = d) (hd : 0 < d) (s : Fin (d + 1) → Γ(L, ⊤))
    (hind : ∀ c : Fin (d + 1) → k,
      ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) • s j = 0 → c = 0)
    (hspan : ∀ σ : Γ(L, ⊤), ∃ c : Fin (d + 1) → k,
      σ = ∑ j, ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom (c j) • s j)
    (i : Fin (d + 1)) :
    letI := (chartConstants f (nvCover s i)).toAlgebra
    Algebra.adjoin k (Set.range (ratio s i)) = ⊤ := by
  have hpos : 0 < invertibleCurveDegree k f hdim L := by rw [hdeg]; exact_mod_cast hd
  have hvan : ∀ σ : Γ(L, ⊤), nvOpen L σ ≠ ⊤ :=
    AlgebraicGeometry.nvOpen_ne_top_of_invertibleCurveDegree_pos f hdim L hpos
  have hsi : s i ≠ 0 := ne_zero_of_independent f L s hind i
  have hH1 := isZero_cohomologyOverField_unit_one_of_genus_eq_zero k f hgenus
  obtain ⟨t, ht⟩ := exists_sup_nvOpen_eq_top f hdim hH1 L (s i) hsi
  let s' : Fin (d + 2) → Γ(L, ⊤) := Fin.cons t s
  have hs' : IsOpenCover (nvCover s') := by
    change (⨆ j, nvCover s' j) = ⊤
    refine eq_top_iff.mpr (ht ▸ sup_le ?_ ?_)
    · exact le_iSup (nvCover s') i.succ
    · exact le_iSup (nvCover s') 0
  have hV : IsAffineOpen (nvOpen L t) :=
    AlgebraicGeometry.PlaneConic.isAffineOpen_nvCover_of_isOpenCover f s' hdim hs'
      (fun j => hvan _) 0
  have hne : ((nvCover s i : Set X) ∩ nvOpen L t).Nonempty :=
    nonempty_inter_of_sup_eq_top _ _ ht (hvan _) (hvan _)
  have hfin := AlgebraicGeometry.finiteDimensional_quotient_span_ratio f hdim L (s i) t hsi ht hV
  have hle := AlgebraicGeometry.finrank_quotient_span_ratio_le f hdim L (s i) t hsi ht hV
  rw [hdeg] at hle
  exact adjoin_ratio_eq_top_of_chart f L s i t ht hV hne hind (hspan t) (hfin := hfin)
    (by exact_mod_cast hle)

/-- **The morphism of a basis of sections of a positive-degree invertible module on a genus-zero
curve is a closed immersion into `ℙ^d_k`** (the closed immersion of [Stacks, Tag 0C6T] (2)).
Let `X` be a proper integral scheme of dimension at most one over a field `k` with
`H⁰(X, 𝒪_X) = k` and genus `0`, and let `ℒ` be invertible of degree `d > 0`. For every basis
`s₀, …, s_d` of `H⁰(X, ℒ)` the sections generate `ℒ`, and their morphism to `ℙ^d_k` is a closed
immersion. -/
theorem isClosedImmersion_toPolynomialModel_of_basis [IsProper f] [IsIntegral X]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)] (hdim : topologicalKrullDim X ≤ 1)
    (hgenus : genus f = 0) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L] {d : ℕ}
    (hdeg : invertibleCurveDegree k f hdim L = d) (hd : 0 < d)
    (b : Module.Basis (Fin (d + 1)) k ((restrictScalarsOverBase k f).obj
      ((SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).obj L))) :
    ∃ hs : GeneratesStalks (fun j => (show Γ(L, ⊤) from b j)),
      IsClosedImmersion (Stacks.ProjectiveSpaceChartRatio.toPolynomialModel
        (fun j => (show Γ(L, ⊤) from b j)) hs f) := by
  set s : Fin (d + 1) → Γ(L, ⊤) := fun j => (show Γ(L, ⊤) from b j) with hsdef
  obtain ⟨hind, hspan⟩ := independent_and_spanning_of_basis f L b
  have hpos : 0 < invertibleCurveDegree k f hdim L := by rw [hdeg]; exact_mod_cast hd
  have hvan : ∀ σ : Γ(L, ⊤), nvOpen L σ ≠ ⊤ :=
    AlgebraicGeometry.nvOpen_ne_top_of_invertibleCurveDegree_pos f hdim L hpos
  have hH1 := isZero_cohomologyOverField_unit_one_of_genus_eq_zero k f hgenus
  have hcov : IsOpenCover (nvCover s) :=
    iSup_nvCover_eq_top_of_spanning f hdim hH1 L s 0 (ne_zero_of_independent f L s hind 0) hspan
  have hs := Stacks.AmpleImmersionReduction.generatesStalks_of_isOpenCover s hcov
  have hgen : ∀ i, ∀ a : Γ(X, nvCover s i),
      a ∈ Subring.closure
        (Set.range (chartConstants f (nvCover s i)) ∪ Set.range (ratio s i)) := by
    intro i a
    let := (chartConstants f (nvCover s i)).toAlgebra
    have hadj := adjoin_ratio_eq_top_of_basis f hdim hgenus L hdeg hd s hind hspan i
    have hmem : a ∈ (Algebra.adjoin k (Set.range (ratio s i))).toSubring := by
      rw [hadj]; exact trivial
    rwa [Algebra.adjoin_eq_ring_closure] at hmem
  exact ⟨hs, isClosedImmersion_toPolynomialModel f s hs hdim (fun i => hvan _) hgen⟩

/-- **A positive-degree invertible module on a genus-zero curve forces dimension one.** A nonzero
section `s` (which exists by Riemann-Roch) and a section `t` without common zero with it, neither
of them nowhere vanishing, give a zero of `s` that is not the generic point. -/
theorem topologicalKrullDim_eq_one_of_degree_pos [IsProper f] [IsIntegral X]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)] (hdim : topologicalKrullDim X ≤ 1)
    (hgenus : genus f = 0) (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (hpos : 0 < invertibleCurveDegree k f hdim L) :
    topologicalKrullDim X = 1 := by
  have : Stacks.Ample.IsInvertibleModule X L := ‹_›
  obtain ⟨s, hs⟩ :=
    AlgebraicGeometry.exists_eval_top_ne_zero_of_invertibleCurveDegree_pos k f hdim L hgenus hpos
  have hH1 := isZero_cohomologyOverField_unit_one_of_genus_eq_zero k f hgenus
  obtain ⟨t, ht⟩ := exists_sup_nvOpen_eq_top f hdim hH1 L (s.eval (op ⊤)) hs
  exact le_antisymm hdim (one_le_topologicalKrullDim_of_sup_nvOpen_eq_top L _ t ht
    (AlgebraicGeometry.nvOpen_ne_top_of_invertibleCurveDegree_pos f hdim L hpos _)
    (AlgebraicGeometry.nvOpen_ne_top_of_invertibleCurveDegree_pos f hdim L hpos _))

/-- **The morphism of a basis of sections of a degree-one module on a genus-zero curve is an
isomorphism onto `ℙ¹_k`.** It is a closed immersion
(`isClosedImmersion_toPolynomialModel_of_basis`); its image is closed and of dimension one in the
irreducible one-dimensional `ℙ¹_k`, hence everything, and a surjective closed immersion into a
reduced scheme is an isomorphism. -/
theorem isIso_toPolynomialModel_of_degree_eq_one [IsProper f] [IsIntegral X]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)] (hdim : topologicalKrullDim X ≤ 1)
    (hgenus : genus f = 0) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
    (hdeg : invertibleCurveDegree k f hdim L = 1)
    (b : Module.Basis (Fin (1 + 1)) k ((restrictScalarsOverBase k f).obj
      ((SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).obj L)))
    (hs : GeneratesStalks (fun j => (show Γ(L, ⊤) from b j))) :
    IsIso (Stacks.ProjectiveSpaceChartRatio.toPolynomialModel
      (fun j => (show Γ(L, ⊤) from b j)) hs f) := by
  have hdim1 : topologicalKrullDim X = 1 :=
    topologicalKrullDim_eq_one_of_degree_pos f hdim hgenus L (by rw [hdeg]; norm_num)
  obtain ⟨hs', himm⟩ := isClosedImmersion_toPolynomialModel_of_basis f hdim hgenus L
    (d := 1) (by exact_mod_cast hdeg) one_pos b
  set φ := Stacks.ProjectiveSpaceChartRatio.toPolynomialModel
    (fun j => (show Γ(L, ⊤) from b j)) hs f with hφ
  have : IsClosedImmersion φ := himm
  have := Stacks.AlgebraicGeometry.ProjPolyChart.isIntegral_proj k 1
  have hsurj : Function.Surjective φ := by
    have hclosed : IsClosed (Set.range φ) := φ.isClosedEmbedding.isClosed_range
    by_contra hns
    have hne : Set.range φ ≠ Set.univ := fun h => hns (Set.range_eq_univ.mp h)
    have hP : topologicalKrullDim
        (AlgebraicGeometry.Proj (Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading k 1)) = 1 := by
      have := Stacks.ProjectiveSpace.topologicalKrullDim_proj_fin k (r := 2) two_pos
      simpa using this
    have hnd : IsNowhereDense (Set.range φ) := by
      rw [hclosed.isNowhereDense_iff]
      by_contra hint
      have hdense := (isOpen_interior).dense (Set.nonempty_iff_ne_empty.mpr hint)
      apply hne
      have := hdense.closure_eq
      exact Set.eq_univ_of_univ_subset (this ▸ (closure_minimal interior_subset hclosed))
    have hlt := hnd.topologicalKrullDim_lt hclosed inferInstance (by rw [hP]; decide)
    have hX : topologicalKrullDim X = topologicalKrullDim (Set.range φ) :=
      IsHomeomorph.topologicalKrullDim_eq _
        φ.isClosedEmbedding.isEmbedding.toHomeomorph.isHomeomorph
    rw [hP, ← hX, hdim1] at hlt
    exact lt_irrefl _ hlt
  have : Surjective φ := ⟨hsurj⟩
  exact isIso_of_isClosedImmersion_of_surjective φ

/-- **A genus-zero curve with an invertible module of degree one is the projective line**, in the
polynomial model `Proj k[T₀, T₁]`: let `X` be a proper integral scheme of dimension at most one
over a field `k` with `H⁰(X, 𝒪_X) = k` and genus `0`, carrying an invertible module of degree
`1`. Then `X ≅ Proj k[T₀, T₁]` over `k`, by the morphism of a basis of `H⁰(X, ℒ)`. -/
theorem exists_iso_proj_of_invertibleCurveDegree_eq_one [IsProper f] [IsIntegral X]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)] (hdim : topologicalKrullDim X ≤ 1)
    (hgenus : genus f = 0) (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (hdeg : invertibleCurveDegree k f hdim L = 1) :
    ∃ e : X ≅ AlgebraicGeometry.Proj (Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading k 1),
      e.hom ≫ Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff k 1 = f := by
  have : Stacks.Ample.IsInvertibleModule X L := ‹_›
  let M := (restrictScalarsOverBase k f).obj
    ((SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).obj L)
  have hfin : Module.finrank k M = 2 := by
    have := AlgebraicGeometry.finrank_globalSections_eq_invertibleCurveDegree_add_one k f hdim L
      hgenus (by rw [hdeg]; norm_num)
    rw [hdeg] at this
    exact_mod_cast this
  have : Module.Finite k M := Module.finite_of_finrank_eq_succ hfin
  let b : Module.Basis (Fin (1 + 1)) k M := Module.finBasisOfFinrankEq k M hfin
  obtain ⟨hs, -⟩ := isClosedImmersion_toPolynomialModel_of_basis f hdim hgenus L
    (d := 1) (by exact_mod_cast hdeg) one_pos b
  have := isIso_toPolynomialModel_of_degree_eq_one f hdim hgenus L hdeg b hs
  exact ⟨asIso (Stacks.ProjectiveSpaceChartRatio.toPolynomialModel _ hs f),
    Stacks.ProjectiveSpaceChartRatio.toPolynomialModel_comp_projToSpecCoeff _ hs f⟩

/-- **A genus-zero curve with an invertible module of degree one is isomorphic to `ℙ¹_k` over
`k`.** Let `X` be a proper integral scheme of dimension at most one over a field `k` with
`H⁰(X, 𝒪_X) = k` and genus `0`, and let `ℒ` be an invertible `𝒪_X`-module of degree `1`. Then
`X ≅ ℙ¹_k` as schemes over `k`. The isomorphism is the morphism of a basis of `H⁰(X, ℒ)`
(`exists_iso_proj_of_invertibleCurveDegree_eq_one`), read in the base-change model
`ℙ¹_k = Spec k ×_{Spec ℤ} ℙ¹_ℤ` through
`Stacks.AlgebraicGeometry.ProjBaseChange.polynomialComparison`. -/
@[stacks 0C6U "condition (6) implies condition (1)"]
theorem exists_iso_projectiveLine_of_invertibleCurveDegree_eq_one [IsProper f] [IsIntegral X]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop)] (hdim : topologicalKrullDim X ≤ 1)
    (hgenus : genus f = 0) (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (hdeg : invertibleCurveDegree k f hdim L = 1) :
    Nonempty (Over.mk f ≅ Over.mk (projectiveSpaceOver 1 (Spec (.of k)) ↘ Spec (.of k))) := by
  obtain ⟨e, he⟩ := exists_iso_proj_of_invertibleCurveDegree_eq_one f hdim hgenus L hdeg
  let c := (Stacks.AlgebraicGeometry.ProjBaseChange.polynomialComparison k 1).iso
  refine ⟨Over.isoMk (e ≪≫ c.symm) ?_⟩
  change (e.hom ≫ c.inv) ≫ pullback.fst _ _ = f
  rw [← he, Category.assoc,
    ← Stacks.ProjectiveSpaceChartRatio.polynomialComparison_iso_hom_comp_projToSpecCoeff k 1,
    Iso.inv_hom_id_assoc]

end AlgebraicGeometry.ProjectiveLineCriterion

end
