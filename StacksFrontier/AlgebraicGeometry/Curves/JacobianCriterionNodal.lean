module

public import StacksFrontier.AlgebraicGeometry.Curves.JacobianCriterionPlane
public import StacksFrontier.AlgebraicGeometry.Curves.Node.Algebra
public import StacksFrontier.FieldTheory.Separable.TFAE
public import StacksFrontier.RingTheory.GeometricallyReduced.TensorProduct
public import StacksFrontier.RingTheory.LocalRing.CotangentQuotient

/-!
# The Jacobian criterion for a node, reduced to a statement about one ideal

Let `k` be a field, `A = k[[x_0, …, x_{n-1}]]` and `I ⊆ 𝔪_A` an ideal generated by a finite
family `f`. Stacks 0C4C asserts the equivalence of

1. `A/I` is a nodal `k`-algebra,
2. `A/I` is reduced and the Jacobian-minor ideal of Tag 0C4B at `n - 1` is `𝔪_{A/I}`,
3. `A/I` has depth one and that same Jacobian condition holds.

This file carries out the part of that equivalence which is *formal*, in the sense that it uses
no property of the Jacobian-minor ideal beyond a single equivalence, and isolates the
mathematical content in that one statement.

## Main results

* `Stacks.Curves.isSeparableExtension_residueField_quotient` — the residue field of `A/I` is `k`
  itself, so the separability clause of `IsNodalAlgebra` is automatic here. This is why the
  source's statement of 0C4C makes no mention of separability, although 0C49 does.
* `Stacks.Curves.isNodalAlgebra_quotient_iff` — consequently `A/I` is a nodal `k`-algebra exactly
  when it is reduced and carries a nondegenerate quadratic relation on its cotangent space.
* `Stacks.Curves.isNodalAlgebra_tfae_of_jacobianMinorIdeal_iff` — **the reduction.** Given the
  single equivalence

      jacobianMinorIdealModulo I f (n - 1) = 𝔪_{A/I} ↔ HasNodalQuadraticRelation (A/I)

  the three conditions of Tag 0C4C are equivalent. The remaining ingredients are Tag 0C49
  (`Stacks.Curves.isNodalAlgebra_tfae`), which supplies the passage between reducedness and depth
  one, and the separability statement above.

## Implementation notes

The hypothesis of `isNodalAlgebra_tfae_of_jacobianMinorIdeal_iff` is stated with the
`Nontrivial` and `IsLocalRing` instances on `A ⧸ I` as instance arguments rather than derived
inside the statement, so that a caller which has already fixed those instances — as the statement
of Tag 0C4C does, by `Ideal.Quotient.nontrivial_iff` and `IsLocalRing.of_surjective'` — can apply
it without an instance mismatch in `maximalIdeal (A ⧸ I)`.

Separability of the residue-field extension is `Algebra.IsSeparableExtension` of
[Stacks 030O], not Mathlib's `Algebra.IsSeparable`; the two agree for algebraic extensions, and
the bridge used here is the equivalence with geometric reducedness.

## References

* [Stacks Project, Tag 0C4C](https://stacks.math.columbia.edu/tag/0C4C)
* [Stacks Project, Tag 0C49](https://stacks.math.columbia.edu/tag/0C49)
-/

@[expose] public section

open IsLocalRing MvPowerSeries

namespace Stacks.Curves

universe u

variable {k : Type u} [Field k]

/-! ### Separability of a residue field reached by a surjection from the base field -/

/-- A field extension whose structure map is surjective is separable in the sense of Mathlib:
every element has minimal polynomial `X - a`. -/
theorem isSeparable_of_surjective_algebraMap {K : Type*} [Field K] [Algebra k K]
    (h : Function.Surjective (algebraMap k K)) : Algebra.IsSeparable k K := by
  constructor
  intro x
  obtain ⟨a, rfl⟩ := h x
  show (minpoly k ((algebraMap k K) a)).Separable
  rw [minpoly.eq_X_sub_C]
  exact Polynomial.separable_X_sub_C

/-- A separable algebraic extension is separable in the sense of [Stacks 030O]. -/
theorem isSeparableExtension_of_isSeparable {K : Type*} [Field K] [Algebra k K]
    [Algebra.IsSeparable k K] : Algebra.IsSeparableExtension k K :=
  ((Algebra.isSeparableExtension_tfae k K (ringExpChar k)).out 1 4).mpr
    (Algebra.IsGeometricallyReduced.of_isSeparable k K)

/-- A field extension whose structure map is surjective is separable in the sense of
[Stacks 030O]. -/
theorem isSeparableExtension_of_surjective_algebraMap {K : Type*} [Field K] [Algebra k K]
    (h : Function.Surjective (algebraMap k K)) : Algebra.IsSeparableExtension k K :=
  let := isSeparable_of_surjective_algebraMap h
  isSeparableExtension_of_isSeparable

/-! ### The residue field of a quotient of a power-series ring -/

variable {n : ℕ}

/-- For an ideal `I ⊆ 𝔪` of `A = k[[x_0, …, x_{n-1}]]`, the structure map from `k` to the residue
field of `A ⧸ I` is surjective: the residue of a power series is the residue of its constant
term. -/
theorem surjective_algebraMap_residueField_quotient (I : Ideal (MvPowerSeries (Fin n) k))
    [IsLocalRing (MvPowerSeries (Fin n) k ⧸ I)] :
    Function.Surjective (algebraMap k (ResidueField (MvPowerSeries (Fin n) k ⧸ I))) := by
  intro x
  obtain ⟨q, rfl⟩ := residue_surjective (R := MvPowerSeries (Fin n) k ⧸ I) x
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective q
  refine ⟨MvPowerSeries.constantCoeff a, ?_⟩
  have hmem : a - MvPowerSeries.C (MvPowerSeries.constantCoeff a) ∈
      maximalIdeal (MvPowerSeries (Fin n) k) := by
    refine (Stacks.MvPowerSeries.RegularParameters.mem_maximalIdeal_iff_constantCoeff_eq_zero_field
      _).2 ?_
    simp
  have hmap : Ideal.Quotient.mk I (a - MvPowerSeries.C (MvPowerSeries.constantCoeff a)) ∈
      maximalIdeal (MvPowerSeries (Fin n) k ⧸ I) := by
    rw [← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective]
    exact Ideal.mem_map_of_mem _ hmem
  have hzero : residue (MvPowerSeries (Fin n) k ⧸ I)
      (Ideal.Quotient.mk I (a - MvPowerSeries.C (MvPowerSeries.constantCoeff a))) = 0 :=
    (residue_eq_zero_iff _).2 hmap
  rw [map_sub, map_sub, sub_eq_zero] at hzero
  rw [hzero]
  rfl

/-- **The residue field of `k[[x_0, …, x_{n-1}]]/I` is separable over `k`** for every ideal
`I ⊆ 𝔪`: it is `k` itself. This is the clause of `IsNodalAlgebra` that Tag 0C4C does not have to
mention. -/
theorem isSeparableExtension_residueField_quotient (I : Ideal (MvPowerSeries (Fin n) k))
    [IsLocalRing (MvPowerSeries (Fin n) k ⧸ I)] :
    Algebra.IsSeparableExtension k (ResidueField (MvPowerSeries (Fin n) k ⧸ I)) :=
  isSeparableExtension_of_surjective_algebraMap
    (surjective_algebraMap_residueField_quotient I)

/-- For a quotient of a power-series ring over `k` by an ideal inside the maximal ideal, being a
nodal `k`-algebra is exactly being reduced and carrying a nondegenerate quadratic relation: the
separability clause is automatic. -/
theorem isNodalAlgebra_quotient_iff (I : Ideal (MvPowerSeries (Fin n) k))
    [IsLocalRing (MvPowerSeries (Fin n) k ⧸ I)] :
    IsNodalAlgebra k (MvPowerSeries (Fin n) k ⧸ I) ↔
      IsReduced (MvPowerSeries (Fin n) k ⧸ I) ∧
        HasNodalQuadraticRelation (MvPowerSeries (Fin n) k ⧸ I) :=
  ⟨fun h => ⟨h.2.1, h.2.2⟩,
    fun h => ⟨isSeparableExtension_residueField_quotient I, h.1, h.2⟩⟩

/-! ### The criterion, reduced to one equivalence -/

/-- **Tag 0C4C, reduced to the Jacobian-versus-relation equivalence.** For `A = k[[x_0, …,
x_{n-1}]]` and an ideal `I ⊆ 𝔪_A` generated by `f`, suppose that the Jacobian-minor ideal of
Tag 0C4B at `n - 1` is the maximal ideal of `A/I` exactly when `A/I` carries a nondegenerate
quadratic relation on its cotangent space. Then the three conditions of Tag 0C4C are equivalent.

Everything else the criterion needs is already available: Tag 0C49
(`Stacks.Curves.isNodalAlgebra_tfae`) exchanges reducedness for depth one, and
`Stacks.Curves.isSeparableExtension_residueField_quotient` discharges the separability clause of
`IsNodalAlgebra`. In particular neither Tag 0C48 nor any replacement of a regular system of
parameters enters: the source uses them only to reduce the defining ideal to a single equation,
and the equivalence hypothesised here does not pass through such a reduction. -/
theorem isNodalAlgebra_tfae_of_jacobianMinorIdeal_iff {m : ℕ}
    (I : Ideal (MvPowerSeries (Fin n) k)) (f : Fin m → MvPowerSeries (Fin n) k)
    [IsLocalRing (MvPowerSeries (Fin n) k ⧸ I)]
    (hkey : jacobianMinorIdealModulo I f (n - 1) =
        maximalIdeal (MvPowerSeries (Fin n) k ⧸ I) ↔
      HasNodalQuadraticRelation (MvPowerSeries (Fin n) k ⧸ I)) :
    List.TFAE [
      IsNodalAlgebra k (MvPowerSeries (Fin n) k ⧸ I),
      IsReduced (MvPowerSeries (Fin n) k ⧸ I) ∧
        jacobianMinorIdealModulo I f (n - 1) =
          maximalIdeal (MvPowerSeries (Fin n) k ⧸ I),
      Module.depth (MvPowerSeries (Fin n) k ⧸ I)
          (maximalIdeal (MvPowerSeries (Fin n) k ⧸ I))
          (MvPowerSeries (Fin n) k ⧸ I) = 1 ∧
        jacobianMinorIdealModulo I f (n - 1) =
          maximalIdeal (MvPowerSeries (Fin n) k ⧸ I)] := by
  have hsep : Algebra.IsSeparableExtension k
      (ResidueField (MvPowerSeries (Fin n) k ⧸ I)) :=
    isSeparableExtension_residueField_quotient I
  have hnodal := isNodalAlgebra_tfae k (MvPowerSeries (Fin n) k ⧸ I)
  set P₁ := IsNodalAlgebra k (MvPowerSeries (Fin n) k ⧸ I) with hP₁
  set P₂ := IsReduced (MvPowerSeries (Fin n) k ⧸ I) ∧
    jacobianMinorIdealModulo I f (n - 1) =
      maximalIdeal (MvPowerSeries (Fin n) k ⧸ I) with hP₂
  set P₃ := Module.depth (MvPowerSeries (Fin n) k ⧸ I)
      (maximalIdeal (MvPowerSeries (Fin n) k ⧸ I)) (MvPowerSeries (Fin n) k ⧸ I) = 1 ∧
    jacobianMinorIdealModulo I f (n - 1) =
      maximalIdeal (MvPowerSeries (Fin n) k ⧸ I) with hP₃
  have hiff : P₁ ↔ Algebra.IsSeparableExtension k
        (ResidueField (MvPowerSeries (Fin n) k ⧸ I)) ∧
      Module.depth (MvPowerSeries (Fin n) k ⧸ I)
          (maximalIdeal (MvPowerSeries (Fin n) k ⧸ I)) (MvPowerSeries (Fin n) k ⧸ I) = 1 ∧
        HasNodalQuadraticRelation (MvPowerSeries (Fin n) k ⧸ I) :=
    hnodal.out 1 2
  have h12 : P₁ → P₂ := by
    rintro ⟨-, hred, hrel⟩
    exact ⟨hred, hkey.2 hrel⟩
  have h23 : P₂ → P₃ := by
    rintro ⟨hred, hjac⟩
    exact ⟨(hiff.1 ((isNodalAlgebra_quotient_iff I).2 ⟨hred, hkey.1 hjac⟩)).2.1, hjac⟩
  have h31 : P₃ → P₁ := by
    rintro ⟨hdepth, hjac⟩
    exact hiff.2 ⟨hsep, hdepth, hkey.1 hjac⟩
  show List.TFAE [P₁, P₂, P₃]
  exact List.tfae_of_cycle
    (by simpa [List.isChain_cons_cons] using (⟨h12, h23⟩ : (P₁ → P₂) ∧ (P₂ → P₃))) h31

end Stacks.Curves

end
