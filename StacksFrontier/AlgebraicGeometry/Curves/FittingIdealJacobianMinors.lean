* [Stacks Project, Tag 07Z9](https://stacks.math.columbia.edu/tag/07Z9)
-/

@[expose] public section

open Algebra MvPolynomial KaehlerDifferential

namespace Stacks.Curves

universe u v w

/-- The image of the naive cotangent complex of an extension is spanned, over the quotient, by
the differentials `1 ⊗ dg_j` of any finite family `g` generating the kernel. -/
theorem range_cotangentComplex_eq_span_tmul_D {R : Type u} {S : Type v} [CommRing R]
    [CommRing S] [Algebra R S] {E : Algebra.Extension R S} {m : ℕ} (g : Fin m → E.Ring)
    (hspan : Ideal.span (Set.range g) = E.ker) :
    LinearMap.range E.cotangentComplex =
      Submodule.span S (Set.range fun j : Fin m =>
        (1 : S) ⊗ₜ[E.Ring] (D R E.Ring) (g j)) := by
  classical
  have hmem : ∀ j, g j ∈ E.ker := fun j => hspan ▸ Ideal.subset_span ⟨j, rfl⟩
  apply le_antisymm
  · rintro x ⟨c, rfl⟩
    obtain ⟨y, rfl⟩ := Algebra.Extension.Cotangent.mk_surjective c
    rw [Algebra.Extension.cotangentComplex_mk]
    have hy : (y : E.Ring) ∈ Ideal.span (Set.range g) := by rw [hspan]; exact y.2
    obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp hy
    have hD : (D R E.Ring) ((y : E.Ring)) =
        ∑ j, (a j • (D R E.Ring) (g j) + g j • (D R E.Ring) (a j)) := by
      rw [← ha, map_sum]
      exact Finset.sum_congr rfl fun j _ => (D R E.Ring).leibniz _ _
    rw [hD, TensorProduct.tmul_sum]
    refine Submodule.sum_mem _ fun j _ => ?_
    rw [TensorProduct.tmul_add]
    have h1 : (g j) • (1 : S) = 0 := by
      rw [Algebra.smul_def, mul_one]
      exact RingHom.mem_ker.mp (hmem j)
    have h2 : (a j) • (1 : S) = (algebraMap E.Ring S (a j)) • (1 : S) := by
      rw [Algebra.smul_def, smul_eq_mul]
    have h3 : (((algebraMap E.Ring S) (a j) • (1 : S)) ⊗ₜ[E.Ring] (D R E.Ring) (g j)) =
        (algebraMap E.Ring S) (a j) • ((1 : S) ⊗ₜ[E.Ring] (D R E.Ring) (g j)) :=
      TensorProduct.smul_tmul' _ _ _
    rw [← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul, h1,
      TensorProduct.zero_tmul, add_zero, h2, h3]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
  · rw [Submodule.span_le]
    rintro x ⟨j, rfl⟩
    exact ⟨Algebra.Extension.Cotangent.mk ⟨g j, hmem j⟩, by
      rw [Algebra.Extension.cotangentComplex_mk]⟩

/-- **The Fitting ideals of a module of differentials are the ideals of minors of a Jacobian
matrix.** For a presentation of `S` over `R` with `n` generators `x_i` and `m` relations `f_j`,
the `r`-th Fitting ideal of `Ω_{S/R}` is generated by the `(n - r) × (n - r)` minors of
`(∂f_j/∂x_i)`. -/
theorem fittingIdeal_kaehlerDifferential_eq_minorIdeal_jacobian {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] [Algebra R S] {n m : ℕ}
    (P : Algebra.Presentation R S (Fin n) (Fin m)) (r : ℕ) :
    letI : Algebra.FinitePresentation R S := P.finitePresentation_of_isFinite
    fittingIdeal (R := S) (M := Ω[S⁄R]) (r : ℤ) =
      minorIdeal (Matrix.of fun (i : Fin n) (j : Fin m) =>
        aeval P.val (pderiv i (P.relation j))) (n - r) := by
  have : Algebra.FinitePresentation R S := P.finitePresentation_of_isFinite
  classical
  set A : Matrix (Fin n) (Fin m) S :=
    Matrix.of fun (i : Fin n) (j : Fin m) => aeval P.val (pderiv i (P.relation j))
  let E : P.toExtension.CotangentSpace ≃ₗ[S] (Fin n → S) :=
    P.cotangentSpaceBasis.repr ≪≫ₗ Finsupp.linearEquivFunOnFinite S S (Fin n)
  have hEapply : ∀ x : P.toExtension.Ring,
      E ((1 : S) ⊗ₜ[P.toExtension.Ring] (D R P.toExtension.Ring) x) =
        fun i => aeval P.val (pderiv i x) := by
    intro x
    funext i
    simpa [E] using P.cotangentSpaceBasis_repr_one_tmul x i
  have hker : LinearMap.ker P.toExtension.toKaehler =
      LinearMap.range P.toExtension.cotangentComplex :=
    LinearMap.exact_iff.mp P.toExtension.exact_cotangentComplex_toKaehler
  have hmapE : Submodule.map (E : P.toExtension.CotangentSpace →ₗ[S] (Fin n → S))
      (LinearMap.ker P.toExtension.toKaehler) =
      Submodule.span S (Set.range fun (j : Fin m) (i : Fin n) => A i j) := by
    have hsetE : (Set.range ((E : P.toExtension.CotangentSpace →ₗ[S] (Fin n → S)) ∘
          fun (j : Fin m) => ((1 : S) ⊗ₜ[P.toExtension.Ring]
            (D R P.toExtension.Ring) (P.relation j))))
        = Set.range fun (j : Fin m) (i : Fin n) => A i j :=
      congrArg Set.range (funext fun j => hEapply (P.relation j))
    rw [hker, range_cotangentComplex_eq_span_tmul_D P.relation P.span_range_relation_eq_ker,
      Submodule.map_span, ← Set.range_comp]
    exact congrArg (Submodule.span S) hsetE
  let e : ((Fin n → S) ⧸ Submodule.span S (Set.range fun (j : Fin m) (i : Fin n) => A i j))
      ≃ₗ[S] Ω[S⁄R] :=
    (Submodule.Quotient.equiv (LinearMap.ker P.toExtension.toKaehler) _ E hmapE).symm ≪≫ₗ
      LinearMap.quotKerEquivOfSurjective P.toExtension.toKaehler
        P.toExtension.toKaehler_surjective
  exact fittingIdeal_eq_minorIdeal_of_presentation A r e

variable {k : Type u} [Field k]

/-- For a family of polynomials, the Jacobian-minor ideal of Tag 0C4B in a quotient of the
power-series ring is the image of the ideal of minors of the polynomial Jacobian matrix. -/
theorem jacobianMinorIdealModulo_coe_eq_map_minorIdeal {n m : ℕ}
    (f : Fin m → MvPolynomial (Fin n) k) (I : Ideal (MvPowerSeries (Fin n) k)) (r : ℕ) :
    jacobianMinorIdealModulo I (fun j => ((f j : MvPowerSeries (Fin n) k))) r =
      (minorIdeal (Matrix.of fun (i : Fin n) (j : Fin m) => pderiv i (f j)) r).map
        ((Ideal.Quotient.mk I).comp (MvPolynomial.coeToMvPowerSeries.ringHom (R := k))) := by
  have hmat : (fun (i : Fin n) (j : Fin m) =>
        MvPowerSeries.pderiv i ((f j : MvPowerSeries (Fin n) k))) =
      (Matrix.of fun (i : Fin n) (j : Fin m) => pderiv i (f j)).map
        (MvPolynomial.coeToMvPowerSeries.ringHom (R := k)) := by
    funext i j
    simpa using MvPowerSeries.pderiv_coe (R := k) (i := i) (f j)
  rw [jacobianMinorIdealModulo, hmat, ← minorIdeal_map_matrix, Ideal.map_map]

/-- The Fitting ideals of `Ω_{S/k}` for `S = k[x_1, …, x_n]/(f_1, …, f_m)` are the images in `S`
of the ideals of minors of the polynomial Jacobian matrix. -/
theorem fittingIdeal_kaehlerDifferential_quotient_eq_map_minorIdeal {n m : ℕ}
    (f : Fin m → MvPolynomial (Fin n) k) (r : ℕ) :
    letI : Algebra.FinitePresentation k (MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f)) :=
      (Algebra.Presentation.naive (v := f)).finitePresentation_of_isFinite
    fittingIdeal (R := MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f))
        (M := Ω[(MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f))⁄k]) (r : ℤ) =
      (minorIdeal (Matrix.of fun (i : Fin n) (j : Fin m) => pderiv i (f j)) (n - r)).map
        (Ideal.Quotient.mk (Ideal.span (Set.range f))) := by
  classical
  set J : Ideal (MvPolynomial (Fin n) k) := Ideal.span (Set.range f) with hJ
  set P : Algebra.Presentation k (MvPolynomial (Fin n) k ⧸ J) (Fin n) (Fin m) :=
    Algebra.Presentation.naive (v := f) with hP
  have haeval : ∀ y : MvPolynomial (Fin n) k, aeval P.val y = Ideal.Quotient.mk J y := by
    intro y
    rw [← Algebra.Generators.algebraMap_apply]
    rfl
  have hmat : (Matrix.of fun (i : Fin n) (j : Fin m) =>
        aeval P.val (pderiv i (P.relation j))) =
      (Matrix.of fun (i : Fin n) (j : Fin m) => pderiv i (f j)).map
        (Ideal.Quotient.mk J) := by
    funext i j
    exact haeval (pderiv i (f j))
  rw [fittingIdeal_kaehlerDifferential_eq_minorIdeal_jacobian P r, hmat,
    ← minorIdeal_map_matrix]

/-- **The Jacobian-minor ideal of Tag 0C4B is the Fitting ideal of the module of
differentials.** For a family `f` of polynomials, write `S = k[x_1, …, x_n]/(f)` and
`T = k[[x_1, …, x_n]]/(f)`. Along any ring map `S → T` compatible with the inclusion of the
polynomial ring into the power-series ring, the image of the `r`-th Fitting ideal of `Ω_{S/k}`
is the Jacobian-minor ideal of `f` at `n - r`. -/
theorem jacobianMinorIdealModulo_coe_eq_map_fittingIdeal {n m : ℕ}
    (f : Fin m → MvPolynomial (Fin n) k) (r : ℕ)
    (φ : (MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f)) →+*
      (MvPowerSeries (Fin n) k ⧸
        Ideal.span (Set.range fun j => ((f j : MvPowerSeries (Fin n) k)))))
    (hφ : φ.comp (Ideal.Quotient.mk (Ideal.span (Set.range f))) =
      (Ideal.Quotient.mk (Ideal.span (Set.range fun j =>
          ((f j : MvPowerSeries (Fin n) k))))).comp
        (MvPolynomial.coeToMvPowerSeries.ringHom (R := k))) :
    letI : Algebra.FinitePresentation k (MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f)) :=
      (Algebra.Presentation.naive (v := f)).finitePresentation_of_isFinite
    jacobianMinorIdealModulo
        (Ideal.span (Set.range fun j => ((f j : MvPowerSeries (Fin n) k))))
        (fun j => ((f j : MvPowerSeries (Fin n) k))) (n - r) =
      (fittingIdeal (R := MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f))
        (M := Ω[(MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f))⁄k]) (r : ℤ)).map φ := by
  rw [fittingIdeal_kaehlerDifferential_quotient_eq_map_minorIdeal f r, Ideal.map_map, hφ,
    jacobianMinorIdealModulo_coe_eq_map_minorIdeal f _ (n - r)]

/-- **The Jacobian condition of Tag 0C4C for a polynomial family, read in the polynomial ring.**
The `r × r` Jacobian minors of a family `f` of polynomials without constant term generate the
maximal ideal of `k[[x_1, …, x_n]] / (f)` exactly when, together with `f`, they generate the
ideal of variables modulo its square. -/
theorem jacobianMinorIdealModulo_coe_eq_maximalIdeal_iff {n m : ℕ}
    (f : Fin m → MvPolynomial (Fin n) k) (r : ℕ)
    (hf : ∀ j, f j ∈ MvPolynomial.idealOfVars (Fin n) k) :
    letI : Nontrivial (MvPowerSeries (Fin n) k ⧸ (Ideal.span (Set.range f)).map
        (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := k))) :=
      Ideal.Quotient.nontrivial_iff.mpr
        (Stacks.MvPowerSeries.map_ne_top_of_le_idealOfVars
          (Ideal.span_le.2 (by rintro _ ⟨j, rfl⟩; exact hf j)))
    letI : IsLocalRing (MvPowerSeries (Fin n) k ⧸ (Ideal.span (Set.range f)).map
        (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := k))) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    (jacobianMinorIdealModulo ((Ideal.span (Set.range f)).map
            (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := k)))
          (fun j => ((f j : MvPowerSeries (Fin n) k))) r =
        IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) k ⧸ (Ideal.span (Set.range f)).map
          (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := k))) ↔
      minorIdeal (Matrix.of fun (i : Fin n) (j : Fin m) => pderiv i (f j)) r ⊔
          Ideal.span (Set.range f) ⊔ MvPolynomial.idealOfVars (Fin n) k ^ 2 =
        MvPolynomial.idealOfVars (Fin n) k) := by
  have hJ : Ideal.span (Set.range f) ≤ MvPolynomial.idealOfVars (Fin n) k :=
    Ideal.span_le.2 (by rintro _ ⟨j, rfl⟩; exact hf j)
  rw [jacobianMinorIdealModulo_coe_eq_map_minorIdeal f _ r,
    Stacks.MvPowerSeries.map_quotient_coe_eq_maximalIdeal_iff hJ]

/-! ### Presentations centred at a maximal ideal -/

/-- The ideal of variables is the kernel of evaluation at the origin. -/
theorem idealOfVars_eq_ker_aeval_zero (n : ℕ) :
    MvPolynomial.idealOfVars (Fin n) k =
      RingHom.ker (aeval (0 : Fin n → k)).toRingHom := by
  apply le_antisymm
  · rw [MvPolynomial.idealOfVars, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simp [RingHom.mem_ker]
  · intro q hq
    rw [RingHom.mem_ker] at hq
    rw [show MvPolynomial.idealOfVars (Fin n) k = MvPolynomial.idealOfVars (Fin n) k ^ 1 by
      rw [pow_one], MvPolynomial.mem_pow_idealOfVars_iff']
    intro x hx
    have hx0 : x = 0 := (Finsupp.degree_eq_zero_iff x).1 (by omega)
    subst hx0
    have hval : (aeval (0 : Fin n → k)) q = q.coeff 0 := by
      rw [MvPolynomial.aeval_zero]
      simp [MvPolynomial.constantCoeff_eq]
    rwa [← hval]

/-- The ideal of variables of a polynomial ring over a field is maximal. -/
instance isMaximal_idealOfVars_fin (n : ℕ) :
    (MvPolynomial.idealOfVars (Fin n) k).IsMaximal := by
  rw [idealOfVars_eq_ker_aeval_zero]
  exact RingHom.ker_isMaximal_of_surjective (aeval (0 : Fin n → k)).toRingHom
    fun y => ⟨MvPolynomial.C y, by simp⟩

/-- If the chosen generators of a `k`-algebra all lie in a maximal ideal `p`, then the preimage
of `p` in the polynomial ring is the ideal of variables: the presentation is centred at `p`. -/
theorem comap_eq_idealOfVars {A : Type v} [CommRing A] [Algebra k A] {n : ℕ} (v : Fin n → A)
    {p : Ideal A} [p.IsMaximal] (hv : ∀ i, v i ∈ p) :
    p.comap (aeval (R := k) v).toRingHom = MvPolynomial.idealOfVars (Fin n) k := by
  symm
  refine (isMaximal_idealOfVars_fin n).eq_of_le ?_ ?_
  · intro htop
    rw [Ideal.eq_top_iff_one, Ideal.mem_comap] at htop
    exact ‹p.IsMaximal›.ne_top ((Ideal.eq_top_iff_one _).2 (by simpa using htop))
  · rw [MvPolynomial.idealOfVars, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simpa [Ideal.mem_comap] using hv i

/-- Along a surjection, generating an ideal modulo its square is detected upstairs, where the
kernel joins the generators. -/
theorem map_sup_sq_eq_iff_of_surjective {B : Type v} {A : Type w} [CommRing B] [CommRing A]
    (φ : B →+* A) (hφ : Function.Surjective φ) {q : Ideal B} (hq : RingHom.ker φ ≤ q)
    {N : Ideal B} :
    N.map φ ⊔ (q.map φ) ^ 2 = q.map φ ↔ N ⊔ RingHom.ker φ ⊔ q ^ 2 = q := by
  have hcomap : ∀ I : Ideal B, (I.map φ).comap φ = I ⊔ RingHom.ker φ := fun I => by
    rw [Ideal.comap_map_of_surjective _ hφ, ← RingHom.ker_eq_comap_bot]
  have hpow : (q.map φ) ^ 2 = (q ^ 2).map φ := (Ideal.map_pow φ q 2).symm
  constructor
  · intro h
    rw [hpow, ← Ideal.map_sup] at h
    have h1 := congrArg (Ideal.comap φ) h
    rw [hcomap, hcomap] at h1
    rw [sup_right_comm, h1, sup_eq_left.2 hq]
  · intro h
    have hmapped := congrArg (fun I : Ideal B => I.map φ) h
    rw [Ideal.map_sup, Ideal.map_sup, (Ideal.map_eq_bot_iff_le_ker φ).2 le_rfl,
      sup_bot_eq] at hmapped
    rwa [hpow]

/-- The kernel of the structure map of a presentation is spanned by its relations. -/
theorem ker_aeval_val_eq_span {A : Type v} [CommRing A] [Algebra k A] {n m : ℕ}
    (P : Algebra.Presentation k A (Fin n) (Fin m)) :
    RingHom.ker (aeval (R := k) P.val).toRingHom = Ideal.span (Set.range P.relation) := by
  rw [P.span_range_relation_eq_ker, Algebra.Generators.ker_eq_ker_aeval_val]
  rfl

/-- For a presentation whose generators lie in a maximal ideal, the relations lie in the ideal of
variables. -/
theorem span_range_relation_le_idealOfVars {A : Type v} [CommRing A] [Algebra k A] {n m : ℕ}
    (P : Algebra.Presentation k A (Fin n) (Fin m)) {p : Ideal A} [p.IsMaximal]
    (hv : ∀ i, P.val i ∈ p) :
    Ideal.span (Set.range P.relation) ≤ MvPolynomial.idealOfVars (Fin n) k := by
  rw [← ker_aeval_val_eq_span P, ← comap_eq_idealOfVars (k := k) P.val hv]
  intro z hz
  rw [Ideal.mem_comap, RingHom.mem_ker.1 hz]
  exact p.zero_mem

/-- **The Jacobian condition at a point with residue field `k`.** Let `A` be a `k`-algebra with a
presentation by `n` generators lying in a maximal ideal `p` and `m` relations. The `r × r`
Jacobian minors generate `p` modulo `p ^ 2` exactly when they satisfy the Jacobian condition of
Tag 0C4C for the power-series model `k[[x_1, …, x_n]] / (f)`. -/
theorem sup_sq_eq_iff_jacobianMinorIdealModulo {A : Type u} [CommRing A] [Algebra k A]
    {n m : ℕ} (P : Algebra.Presentation k A (Fin n) (Fin m))
    (hJ : Ideal.span (Set.range P.relation) ≤ MvPolynomial.idealOfVars (Fin n) k)
    {p : Ideal A} [p.IsMaximal] (hv : ∀ i, P.val i ∈ p) (r : ℕ) :
    letI : Nontrivial (MvPowerSeries (Fin n) k ⧸ (Ideal.span (Set.range P.relation)).map
        (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := k))) :=
      Ideal.Quotient.nontrivial_iff.mpr
        (Stacks.MvPowerSeries.map_ne_top_of_le_idealOfVars hJ)
    letI : IsLocalRing (MvPowerSeries (Fin n) k ⧸ (Ideal.span (Set.range P.relation)).map
        (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := k))) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    (minorIdeal (Matrix.of fun (i : Fin n) (j : Fin m) =>
          aeval P.val (pderiv i (P.relation j))) r ⊔ p ^ 2 = p ↔
      jacobianMinorIdealModulo
          ((Ideal.span (Set.range P.relation)).map
            (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := k)))
          (fun j => ((P.relation j : MvPowerSeries (Fin n) k))) r =
        IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) k ⧸
          (Ideal.span (Set.range P.relation)).map
            (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := k)))) := by
  classical
  have hcomap : p.comap (aeval (R := k) P.val).toRingHom =
      MvPolynomial.idealOfVars (Fin n) k := comap_eq_idealOfVars P.val hv
  have hsurj : Function.Surjective (aeval (R := k) P.val) := P.aeval_val_surjective
  have hker := ker_aeval_val_eq_span P
  have hpeq : p = (MvPolynomial.idealOfVars (Fin n) k).map
      (aeval (R := k) P.val).toRingHom := by
    rw [← hcomap]
    exact (Ideal.map_comap_of_surjective _ hsurj p).symm
  have hmat : (Matrix.of fun (i : Fin n) (j : Fin m) => aeval P.val (pderiv i (P.relation j))) =
      (Matrix.of fun (i : Fin n) (j : Fin m) => pderiv i (P.relation j)).map
        (aeval (R := k) P.val).toRingHom := rfl
  rw [hmat, ← minorIdeal_map_matrix, hpeq,
    map_sup_sq_eq_iff_of_surjective _ hsurj (by rw [hker]; exact hJ), hker,
    ← Stacks.MvPowerSeries.map_quotient_coe_eq_maximalIdeal_iff hJ,
    jacobianMinorIdealModulo_coe_eq_map_minorIdeal P.relation _ r]

/-! ### Changing the coefficient ring of a presentation -/

/-- Formal partial differentiation commutes with a coefficient ring map. -/
theorem map_pderiv {R : Type v} {K : Type w} [CommRing R] [CommRing K] (φ : R →+* K)
    {n : ℕ} (i : Fin n) (g : MvPolynomial (Fin n) R) :
    MvPolynomial.map φ (pderiv i g) = pderiv i (MvPolynomial.map φ g) := by
  classical
  ext d
  rw [MvPolynomial.coeff_map, MvPolynomial.coeff_pderiv, MvPolynomial.coeff_pderiv,
    MvPolynomial.coeff_map]
  simp

/-- The ideal of variables is preserved by a coefficient ring isomorphism. -/
theorem map_idealOfVars_mapEquiv {R : Type v} {K : Type v} [CommRing R] [CommRing K]
    (e : R ≃+* K) (n : ℕ) :
    (MvPolynomial.idealOfVars (Fin n) R).map (MvPolynomial.mapEquiv (Fin n) e).toRingHom =
      MvPolynomial.idealOfVars (Fin n) K := by
  rw [MvPolynomial.idealOfVars, MvPolynomial.idealOfVars, Ideal.map_span, ← Set.range_comp]
  congr 2
  funext i
  simp [MvPolynomial.mapEquiv_apply]

/-- Two ideals agree exactly when their images under a bijective ring map agree. -/
theorem ideal_eq_iff_map_eq {R : Type v} {K : Type w} [CommRing R] [CommRing K] (φ : R →+* K)
    (hφ : Function.Bijective φ) (I J : Ideal R) : I = J ↔ I.map φ = J.map φ := by
  refine ⟨fun h => by rw [h], fun h => ?_⟩
  have h1 := congrArg (Ideal.comap φ) h
  rwa [Ideal.comap_map_of_bijective φ hφ, Ideal.comap_map_of_bijective φ hφ] at h1

/-- **The Jacobian condition at a point, with the base only isomorphic to a field.** Let `A` be
an `R`-algebra with a presentation by `n` generators lying in a maximal ideal `p` and `m`
relations, and let `e : R ≃+* K` with `K` a field. The `r × r` Jacobian minors generate `p`
modulo `p ^ 2` exactly when the relations transported along `e` satisfy the Jacobian condition of
Tag 0C4C for `K[[x_1, …, x_n]] / (f)`. -/
theorem sup_sq_eq_iff_jacobianMinorIdealModulo_of_ringEquiv
    {R : Type u} {A : Type u} [CommRing R] [CommRing A] [Algebra R A]
    (K : Type u) [Field K] (e : R ≃+* K) {n m : ℕ}
    (P : Algebra.Presentation R A (Fin n) (Fin m))
    {p : Ideal A} [p.IsMaximal] (hv : ∀ i, P.val i ∈ p) (r : ℕ)
    (hJ : Ideal.span (Set.range fun j => MvPolynomial.map (e : R →+* K) (P.relation j)) ≤
      MvPolynomial.idealOfVars (Fin n) K) :
    letI : Nontrivial (MvPowerSeries (Fin n) K ⧸
        (Ideal.span (Set.range fun j => MvPolynomial.map (e : R →+* K) (P.relation j))).map
          (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := K))) :=
      Ideal.Quotient.nontrivial_iff.mpr
        (Stacks.MvPowerSeries.map_ne_top_of_le_idealOfVars hJ)
    letI : IsLocalRing (MvPowerSeries (Fin n) K ⧸
        (Ideal.span (Set.range fun j => MvPolynomial.map (e : R →+* K) (P.relation j))).map
          (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := K))) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    (minorIdeal (Matrix.of fun (i : Fin n) (j : Fin m) =>
          aeval P.val (pderiv i (P.relation j))) r ⊔ p ^ 2 = p ↔
      jacobianMinorIdealModulo
          ((Ideal.span (Set.range fun j => MvPolynomial.map (e : R →+* K) (P.relation j))).map
            (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := K)))
          (fun j => ((MvPolynomial.map (e : R →+* K) (P.relation j) :
            MvPowerSeries (Fin n) K))) r =
        IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K ⧸
          (Ideal.span (Set.range fun j => MvPolynomial.map (e : R →+* K) (P.relation j))).map
            (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n) (R := K)))) := by
  classical
  set Φ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) K :=
    (MvPolynomial.mapEquiv (Fin n) e).toRingHom with hΦ
  have hΦbij : Function.Bijective Φ := (MvPolynomial.mapEquiv (Fin n) e).bijective
  have hsurj : Function.Surjective (aeval (R := R) P.val) := P.aeval_val_surjective
  set q : Ideal (MvPolynomial (Fin n) R) := p.comap (aeval (R := R) P.val).toRingHom with hq
  have hqmax : q.IsMaximal := Ideal.comap_isMaximal_of_surjective _ hsurj
  have hvars : MvPolynomial.idealOfVars (Fin n) R ≤ q := by
    rw [MvPolynomial.idealOfVars, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simpa [hq, Ideal.mem_comap] using hv i
  have hker : RingHom.ker (aeval (R := R) P.val).toRingHom ≤ q := by
    intro z hz
    rw [RingHom.mem_ker] at hz
    rw [hq, Ideal.mem_comap, hz]
    exact p.zero_mem
  have hpeq : p = q.map (aeval (R := R) P.val).toRingHom :=
    (Ideal.map_comap_of_surjective _ hsurj p).symm
  have hmat : (Matrix.of fun (i : Fin n) (j : Fin m) => aeval P.val (pderiv i (P.relation j))) =
      (Matrix.of fun (i : Fin n) (j : Fin m) => pderiv i (P.relation j)).map
        (aeval (R := R) P.val).toRingHom := rfl
  have hqK : q.map Φ = MvPolynomial.idealOfVars (Fin n) K := by
    refine ((isMaximal_idealOfVars_fin (k := K) n).eq_of_le ?_ ?_).symm
    · intro htop
      refine hqmax.ne_top ?_
      have hc := congrArg (Ideal.comap Φ) htop
      rwa [Ideal.comap_map_of_bijective Φ hΦbij, Ideal.comap_top] at hc
    · rw [← map_idealOfVars_mapEquiv e n]
      exact Ideal.map_mono hvars
  have hkerK : (RingHom.ker (aeval (R := R) P.val).toRingHom).map Φ =
      Ideal.span (Set.range fun j => MvPolynomial.map (e : R →+* K) (P.relation j)) := by
    have hkerspan : RingHom.ker (aeval (R := R) P.val).toRingHom =
        Ideal.span (Set.range P.relation) := by
      rw [P.span_range_relation_eq_ker, Algebra.Generators.ker_eq_ker_aeval_val]
      rfl
    rw [hkerspan, Ideal.map_span, ← Set.range_comp]
    rfl
  have hNK : (minorIdeal (Matrix.of fun (i : Fin n) (j : Fin m) =>
        pderiv i (P.relation j)) r).map Φ =
      minorIdeal (Matrix.of fun (i : Fin n) (j : Fin m) =>
        pderiv i (MvPolynomial.map (e : R →+* K) (P.relation j))) r := by
    have hmatK : (Matrix.of fun (i : Fin n) (j : Fin m) => pderiv i (P.relation j)).map Φ =
        Matrix.of fun (i : Fin n) (j : Fin m) =>
          pderiv i (MvPolynomial.map (e : R →+* K) (P.relation j)) := by
      funext i j
      exact map_pderiv (e : R →+* K) i (P.relation j)
    rw [minorIdeal_map_matrix, hmatK]
  rw [hmat, ← minorIdeal_map_matrix, hpeq,
    map_sup_sq_eq_iff_of_surjective _ hsurj hker,
    ideal_eq_iff_map_eq Φ hΦbij, Ideal.map_sup, Ideal.map_sup, Ideal.map_pow, hqK, hkerK, hNK,
    ← Stacks.MvPowerSeries.map_quotient_coe_eq_maximalIdeal_iff hJ,
    jacobianMinorIdealModulo_coe_eq_map_minorIdeal _ _ r]

end Stacks.Curves

