/-!
# The uniformizer sequence of an invertible module on a regular model

In the situation of [Stacks, Tag 0C61] let `ℱ` be an invertible module on the model `X` and
`ι : X_k ⟶ X` the closed immersion of the special fibre. Multiplication by the uniformizer `π`
gives the short exact sequence

`0 ⟶ ℱ --π--> ℱ ⟶ ι_* ι^* ℱ ⟶ 0`:

`π` is a nonzerodivisor on the functions of every open of the flat model, hence on the sections
of `ℱ` (locally the structure sheaf), and the cokernel is killed by the ideal of the special
fibre, which is generated by `π` over every affine open
(`Stacks.Models.specialFiberIdeal_ideal_eq_span`), so the unit `ℱ ⟶ ι_* ι^* ℱ` realizes it
([Stacks, Tag 08KS]). Its long exact cohomology sequence, the invariance of cohomology along the
closed immersion `ι`, the finiteness of `H¹(X, ℱ)` over the discrete valuation ring
([Stacks, Tag 02O6]) and Nakayama's lemma give:

* `H¹(X_k, ι^* ℱ) = 0 ⟹ H¹(X, ℱ) = 0`, and then
* every global section of `ι^* ℱ` lifts to a global section of `ℱ`.

## Main definitions

* `Stacks.Models.RegularProperModelSituation.mulUniformizer`: multiplication by `π`.

## Main results

* `Stacks.Models.RegularProperModelSituation.shortExact_mulUniformizer`: the uniformizer
  sequence.
* `Stacks.Models.RegularProperModelSituation.isZero_rightDerived_one_of_isZero_specialFiber`:
  vanishing of `H¹` on the model from vanishing on the special fibre.
* `Stacks.Models.RegularProperModelSituation.surjective_pullbackGlobalSections_specialFiberι`:
  lifting of sections from the special fibre.

## References

* [Stacks Project, Tag 0C61](https://stacks.math.columbia.edu/tag/0C61)
* [Stacks Project, Tag 08KS](https://stacks.math.columbia.edu/tag/08KS)
* [Stacks Project, Tag 02O6](https://stacks.math.columbia.edu/tag/02O6)
-/

-- This file uses the locally small derived-category models below, which are not
-- global instances (see `StacksFrontier.Homology.DerivedCategory.LocallySmall`):
-- `D(R)` for `R`-modules.
-- `D(R)` for sheaves of modules on a small site.
-- `D(𝒪_X)` for a scheme.
attribute [local instance] ModuleCat.hasDerivedCategory
attribute [local instance] SheafOfModules.hasDerivedCategory
attribute [local instance] AlgebraicGeometry.Scheme.Modules.hasDerivedCategory

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite TopologicalSpace

universe u

namespace Stacks.Models.RegularProperModelSituation

variable (S : RegularProperModelSituation.{u})

/-- The uniformizer, as a global function on the model. -/
abbrev uniformizerFunction : Γ(S.X, ⊤) := (chartHom S.X_to_R ⊤).hom S.π

/-- **Multiplication by the uniformizer** on a sheaf of modules on the model. -/
def mulUniformizer (F : S.X.Modules) : F ⟶ F := S.uniformizerFunction • 𝟙 F

/-- Multiplication by the uniformizer acts on sections over `U` by the function the uniformizer
cuts out on `U`. -/
theorem mulUniformizer_app (F : S.X.Modules) (U : S.X.Opens) (m : Γ(F, U)) :
    (mulUniformizer S F).app U m = (chartHom S.X_to_R U).hom S.π • m := by
  have h := Stacks.SheafOfModules.smul_val_app S.X.ringCatSheaf Γ(S.X, ⊤) ⊤ isTerminalTop
    (RingHom.id _) S.uniformizerFunction (𝟙 F) (op U) m
  refine h.trans ?_
  congr 1
  exact congrArg (fun ψ : CommRingCat.of S.R ⟶ Γ(S.X, U) ↦ ψ.hom S.π)
    (chartHom_comp_map S.X_to_R (isTerminalTop.from U).op)

/-- The uniformizer dies on the special fibre. -/
theorem specialFiberι_appTop_uniformizerFunction :
    S.specialFiberι.appTop.hom S.uniformizerFunction = 0 := by
  have h : chartHom S.X_to_R ⊤ ≫ S.specialFiberι.appTop =
      CommRingCat.ofHom (algebraMap S.R S.k) ≫ (Scheme.ΓSpecIso (.of S.k)).inv ≫
        S.specialFiberToSpec.appTop := by
    rw [chartHom, AlgebraicGeometry.appLE_top_top_eq_appTop, Category.assoc,
      ← Scheme.Hom.comp_appTop, pullback.condition, Scheme.Hom.comp_appTop,
      ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality, Category.assoc]
  have h2 := congrArg (fun ψ ↦ ψ.hom S.π) h
  simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
  rw [uniformizerFunction, h2, (S.algebraMap_eq_zero_iff S.π).mpr
    (by rw [S.maximalIdeal_eq_span_pi]; exact Ideal.mem_span_singleton_self _), map_zero, map_zero]

/-- The function the uniformizer cuts out on any open dies on the special fibre. -/
theorem specialFiberι_app_chartHom_uniformizer (U : S.X.Opens) :
    (S.specialFiberι.app U).hom ((chartHom S.X_to_R U).hom S.π) = 0 := by
  have hc := congrArg (fun ψ : CommRingCat.of S.R ⟶ Γ(S.X, U) ↦ ψ.hom S.π)
    (chartHom_comp_map S.X_to_R (homOfLE (le_top : U ≤ ⊤)).op)
  simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hc
  rw [← hc]
  have hn := congrArg (fun ψ ↦ ψ.hom ((chartHom S.X_to_R ⊤).hom S.π))
    (S.specialFiberι.naturality (homOfLE (le_top : U ≤ ⊤)).op)
  simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hn
  have h0 := specialFiberι_appTop_uniformizerFunction S
  simp only [uniformizerFunction] at h0
  have h0' : (S.specialFiberι.app ⊤).hom ((chartHom S.X_to_R ⊤).hom S.π) = 0 := h0
  rw [hn, h0', map_zero]

/-- **A module killed by the uniformizer is killed by the ideal of the special fibre.** Over an
affine open the ideal of the special fibre is generated by the uniformizer
(`Stacks.Models.specialFiberIdeal_ideal_eq_span`), and the vanishing of a section is local. -/
theorem smul_eq_zero_of_app_specialFiberι_eq_zero (Q : S.X.Modules)
    (hQ : mulUniformizer S Q = 0) (U : S.X.Opens) (a : Γ(S.X, U))
    (ha : (S.specialFiberι.app U).hom a = 0) (m : Γ(Q, U)) : a • m = 0 := by
  refine TopCat.Presheaf.IsSheaf.section_ext (F := Scheme.Modules.presheaf Q) Q.isSheaf
    (U := op U) (s := a • m) (t := 0) ?_
  intro x hx
  obtain ⟨-, ⟨W, hW, rfl⟩, hxW, hWU⟩ :=
    S.X.isBasis_affineOpens.exists_subset_of_mem_open hx U.isOpen
  have hWU' : W ≤ U := hWU
  refine ⟨W, hWU', hxW, ?_⟩
  have haW : (S.specialFiberι.app W).hom (S.X.presheaf.map (homOfLE hWU').op a) = 0 := by
    have hn := congrArg (fun ψ ↦ ψ.hom a) (S.specialFiberι.naturality (homOfLE hWU').op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hn
    rw [hn, ha, map_zero]
  have hmem : S.X.presheaf.map (homOfLE hWU').op a ∈ S.specialFiberι.ker.ideal ⟨W, hW⟩ := by
    rw [Scheme.Hom.ker_apply]
    exact haW
  rw [specialFiberIdeal_ideal_eq_span (k := S.k) S.residueEquiv S.X_to_R S.uniformizer W hW]
    at hmem
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hmem
  show Q.presheaf.map (homOfLE hWU').op (a • m) = Q.presheaf.map (homOfLE hWU').op 0
  rw [Scheme.Modules.map_smul, ← hb, mul_smul, ← mulUniformizer_app, hQ,
    Scheme.Modules.Hom.zero_app]
  simp

/-- **The cokernel of multiplication by the uniformizer is killed by the uniformizer.** -/
theorem mulUniformizer_cokernel (F : S.X.Modules) :
    mulUniformizer S (cokernel (mulUniformizer S F)) = 0 := by
  rw [← cancel_epi (cokernel.π (mulUniformizer S F)), comp_zero]
  show cokernel.π _ ≫ (S.uniformizerFunction • 𝟙 _) = 0
  rw [Linear.comp_smul, Category.comp_id, ← Category.id_comp (cokernel.π _), ← Linear.smul_comp]
  exact cokernel.condition _

/-- **The uniformizer acts by zero on a module pushed forward from the special fibre.** -/
theorem mulUniformizer_pushforward (G : S.specialFiber.Modules) :
    mulUniformizer S ((Scheme.Modules.pushforward S.specialFiberι).obj G) = 0 := by
  ext U m
  rw [mulUniformizer_app]
  show (S.specialFiberι.app U).hom ((chartHom S.X_to_R U).hom S.π) •
    (show Γ(G, S.specialFiberι ⁻¹ᵁ U) from m) = 0
  rw [specialFiberι_app_chartHom_uniformizer, zero_smul]

/-- Multiplication by the uniformizer followed by restriction to the special fibre is zero. -/
theorem mulUniformizer_comp_unit (F : S.X.Modules) :
    mulUniformizer S F ≫
      (Scheme.Modules.pullbackPushforwardAdjunction S.specialFiberι).unit.app F = 0 := by
  show (S.uniformizerFunction • 𝟙 F) ≫ _ = 0
  rw [Linear.smul_comp, Category.id_comp, ← Category.comp_id
    ((Scheme.Modules.pullbackPushforwardAdjunction S.specialFiberι).unit.app F),
    ← Linear.comp_smul]
  have h := mulUniformizer_pushforward S ((Scheme.Modules.pullback S.specialFiberι).obj F)
  show _ ≫ mulUniformizer S ((Scheme.Modules.pushforward S.specialFiberι).obj
    ((Scheme.Modules.pullback S.specialFiberι).obj F)) = 0
  rw [h, comp_zero]

/-- **The uniformizer is a nonzerodivisor on the functions of every open of the model**, the
model being flat over the discrete valuation ring. -/
theorem injective_mul_chartHom_uniformizer (W : S.X.Opens) :
    Function.Injective (fun c : Γ(S.X, W) ↦ c * (chartHom S.X_to_R W).hom S.π) := by
  have hinj := Scheme.Modules.injective_unitHomEquiv_symm_app_of_isRegularSection
    (L := SheafOfModules.unit S.X.ringCatSheaf) (uniformizerSection S.X_to_R S.π)
    (isRegularSection_uniformizerSection (k := S.k) S.residueEquiv S.X_to_R S.uniformizer) W
  intro c d h
  apply hinj
  have h1 := Scheme.Modules.unitHomEquiv_symm_app_apply (SheafOfModules.unit S.X.ringCatSheaf)
    (uniformizerSection S.X_to_R S.π) W c
  have h2 := Scheme.Modules.unitHomEquiv_symm_app_apply (SheafOfModules.unit S.X.ringCatSheaf)
    (uniformizerSection S.X_to_R S.π) W d
  refine h1.trans (Eq.trans ?_ h2.symm)
  have hX : (Scheme.Modules.presheaf (SheafOfModules.unit S.X.ringCatSheaf)).map
      (homOfLE (le_top : W ≤ ⊤)).op ((uniformizerSection S.X_to_R S.π).eval (op ⊤)) =
      (chartHom S.X_to_R W).hom S.π :=
    Scheme.Modules.map_eval_top (SheafOfModules.unit S.X.ringCatSheaf)
      (uniformizerSection S.X_to_R S.π) W
  rw [hX]
  exact h

variable (F : S.X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsInvertible S.X.sheaf.obj S.X.ringCatSheaf.property F]

/-- **Multiplication by the uniformizer is injective on the sections of an invertible module.**
Locally the module is the structure sheaf, on which the uniformizer is a nonzerodivisor. -/
theorem injective_mulUniformizer_app (U : S.X.Opens) :
    Function.Injective ((mulUniformizer S F).app U) := by
  rw [injective_iff_map_eq_zero]
  intro m hm
  rw [mulUniformizer_app] at hm
  refine TopCat.Presheaf.IsSheaf.section_ext (F := Scheme.Modules.presheaf F) F.isSheaf
    (U := op U) (s := m) (t := 0) ?_
  intro x hx
  obtain ⟨W, hxW, hWU, ⟨e⟩⟩ := exists_affineOpens_linearEquiv_le S.X F x U hx
  refine ⟨W.1, hWU, hxW, ?_⟩
  show F.presheaf.map (homOfLE hWU).op m = F.presheaf.map (homOfLE hWU).op 0
  rw [map_zero]
  have hres := congrArg (F.presheaf.map (homOfLE hWU).op) hm
  rw [Scheme.Modules.map_smul, map_zero] at hres
  have hc := congrArg (fun ψ : CommRingCat.of S.R ⟶ Γ(S.X, W.1) ↦ ψ.hom S.π)
    (chartHom_comp_map S.X_to_R (homOfLE hWU).op)
  simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hc
  rw [hc] at hres
  have he := congrArg e hres
  rw [map_smul, map_zero, smul_eq_mul, mul_comm] at he
  have h0 : e (F.presheaf.map (homOfLE hWU).op m) = 0 :=
    injective_mul_chartHom_uniformizer S W.1 (he.trans (zero_mul _).symm)
  exact (map_eq_zero_iff e e.injective).mp h0

/-- **Multiplication by the uniformizer is a monomorphism on an invertible module.** -/
theorem mono_mulUniformizer : Mono (mulUniformizer S F) := by
  refine ⟨fun g h hgh => ?_⟩
  ext U x
  apply injective_mulUniformizer_app S F U
  exact congr(($hgh).app U x)

/-- **The uniformizer sequence** `0 ⟶ ℱ --π--> ℱ ⟶ ι_* ι^* ℱ ⟶ 0` of an invertible module on the
model, `ι` the closed immersion of the special fibre. -/
theorem shortExact_mulUniformizer :
    (ShortComplex.mk (mulUniformizer S F)
      ((Scheme.Modules.pullbackPushforwardAdjunction S.specialFiberι).unit.app F)
      (mulUniformizer_comp_unit S F)).ShortExact := by
  have hiso : IsIso ((Scheme.Modules.pullbackPushforwardAdjunction S.specialFiberι).unit.app
      (cokernel (mulUniformizer S F))) :=
    Stacks.ClosedImmersion.isIso_unit_app_of_smul_eq_zero S.specialFiberι _
      (fun U a ha m ↦ smul_eq_zero_of_app_specialFiberι_eq_zero S _
        (mulUniformizer_cokernel S F) U a ha m)
  obtain ⟨e, he⟩ := AlgebraicGeometry.exists_cokernelIso_of_isIso_unit_app
    (Scheme.Modules.pullbackPushforwardAdjunction S.specialFiberι) (mulUniformizer S F)
    (mulUniformizer_comp_unit S F)
  obtain ⟨_, hS⟩ := CategoryTheory.ShortComplex.shortExact_of_cokernelIso _
    (mono_mulUniformizer S F) e he
  exact hS

/-- `H¹` of a module pushed forward from the special fibre vanishes with `H¹` on the fibre. -/
theorem isZero_rightDerived_pushforward_specialFiberι (n : ℕ) (G : S.specialFiber.Modules)
    (h : IsZero (((moduleGlobalSections S.specialFiber).rightDerived n).obj G)) :
    IsZero (((moduleGlobalSections S.X).rightDerived n).obj
      ((Scheme.Modules.pushforward S.specialFiberι).obj G)) :=
  IsZero.of_iso ((ModuleCat.restrictScalars _).map_isZero h)
    (Stacks.Cohomology.ClosedImmersion.cohomologyObjIsoPushforward S.specialFiberι G n)

/-- **`H¹` of an invertible module on the model vanishes as soon as it vanishes on the special
fibre.** The uniformizer sequence makes multiplication by `π` surjective on `H¹(X, ℱ)`, which is a
finite module over the discrete valuation ring ([Stacks, Tag 02O6]); Nakayama's lemma concludes. -/
theorem isZero_rightDerived_one_of_isZero_specialFiber
    (h : IsZero (((moduleGlobalSections S.specialFiber).rightDerived 1).obj
      ((Scheme.Modules.pullback S.specialFiberι).obj F))) :
    IsZero (((moduleGlobalSections S.X).rightDerived 1).obj F) := by
  have hS := shortExact_mulUniformizer S F
  have h3 := isZero_rightDerived_pushforward_specialFiberι S 1 _ h
  have hepi := Stacks.AlgebraicGeometry.TopDegreeBaseChange.epi_map_rightDerived_f_of_isZero
    S.X hS 1 h3
  set H := ((moduleGlobalSections S.X).rightDerived 1).obj F with hHdef
  have hmap : ((moduleGlobalSections S.X).rightDerived 1).map (mulUniformizer S F) =
      S.uniformizerFunction • 𝟙 H := by
    rw [mulUniformizer, Functor.map_smul, CategoryTheory.Functor.map_id]
  have hsurj : ∀ x : H, ∃ y : H, S.uniformizerFunction • y = x := by
    intro x
    obtain ⟨y, hy⟩ := (ModuleCat.epi_iff_surjective _).1 hepi x
    exact ⟨y, by rw [hmap] at hy; exact hy⟩
  have : IsLocallyNoetherian S.X := LocallyOfFiniteType.isLocallyNoetherian S.X_to_R
  have : F.IsCoherent :=
    @Stacks.AlgebraicGeometry.CoherentKernel.isCoherent_of_isInvertible S.X _ F ‹_›
  set φ : S.R →+* ↥Γ(S.X, ⊤) := ((Scheme.ΓSpecIso (.of S.R)).inv ≫ S.X_to_R.appTop).hom
    with hφ
  let : Module S.R ↥H := ((ModuleCat.restrictScalars φ).obj H).isModule
  have : Module.Finite S.R ↥H := by
    have h1 := AlgebraicGeometry.ProperCoherenceWitness.moduleFinite_cohomology S.X_to_R F 1
    have hsurjΓ : Function.Surjective (Scheme.ΓSpecIso (CommRingCat.of S.R)).inv.hom :=
      (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of S.R)).inv).2
    exact Stacks.AlgebraicGeometry.ProperCohomologyFinite.moduleFinite_compHom_of_surjective
      (Scheme.ΓSpecIso (CommRingCat.of S.R)).inv.hom hsurjΓ
      ((ModuleCat.restrictScalars (Scheme.Hom.appTop S.X_to_R).hom).obj H)
  have hπ : S.uniformizerFunction = φ S.π := by
    rw [uniformizerFunction, chartHom, AlgebraicGeometry.appLE_top_top_eq_appTop]
  have hle : (⊤ : Submodule ↥Γ(S.X, ⊤) ↥H) ≤
      Ideal.map φ (IsLocalRing.maximalIdeal S.R) • (⊤ : Submodule ↥Γ(S.X, ⊤) ↥H) := by
    intro x _
    obtain ⟨y, rfl⟩ := hsurj x
    rw [hπ]
    exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem φ
      (by rw [S.maximalIdeal_eq_span_pi]; exact Ideal.mem_span_singleton_self _))
      Submodule.mem_top
  refine ModuleCat.isZero_iff_subsingleton.mpr ⟨fun x y ↦ ?_⟩
  have hz : ∀ z : ↥H, z = 0 := fun z ↦
    Stacks.AlgebraicGeometry.TopDegreeBaseChange.eq_zero_of_top_le_smul_map_maximalIdeal φ
      (fun _ _ ↦ rfl) hle z
  rw [hz x, hz y]

/-- **Sections of an invertible module on the special fibre lift to the model** as soon as `H¹`
of its restriction to the special fibre vanishes: `H¹(X, ℱ) = 0` by
`isZero_rightDerived_one_of_isZero_specialFiber`, and the uniformizer sequence makes
`H⁰(X, ℱ) ⟶ H⁰(X_k, ℱ|_{X_k})` surjective. -/
theorem surjective_pullbackGlobalSections_specialFiberι
    (h : IsZero (((moduleGlobalSections S.specialFiber).rightDerived 1).obj
      ((Scheme.Modules.pullback S.specialFiberι).obj F))) :
    Function.Surjective (pullbackGlobalSections S.specialFiberι F) := by
  have hS := shortExact_mulUniformizer S F
  have h1 := isZero_rightDerived_one_of_isZero_specialFiber S F h
  set D := Stacks.DerivedIndexing.rightDerivedDeltaFunctorOfEnoughInjectives
    (moduleGlobalSections S.X)
  have hex := D.exact_δ₁ hS 0
  have hδ : D.δ hS 0 = 0 := h1.eq_of_tgt _ _
  have hepi : Epi (((moduleGlobalSections S.X).rightDerived 0).map
      ((Scheme.Modules.pullbackPushforwardAdjunction S.specialFiberι).unit.app F)) :=
    hex.epi_f hδ
  refine
    Cohomology.ClosedImmersion.surjective_pullbackGlobalSections_of_surjective_rightDerivedZero
      S.specialFiberι F ?_
  rw [← ModuleCat.epi_iff_surjective]
  exact epi_comp _ _

end Stacks.Models.RegularProperModelSituation

end
