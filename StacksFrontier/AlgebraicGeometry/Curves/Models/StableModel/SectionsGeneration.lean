/-!
# A morphism of the model to projective space through the stable contraction

In the situation of [Stacks, Tag 0C61] let `c₀ : X_k ⟶ Y₀` be a stable contraction of the special
fibre ([Stacks, Tag 0E7Q]) and let `ℳ` be an invertible `𝒪_X`-module with `ℳ|_{X_k} ≅ c₀^*ℒ₀`,
`ℒ₀` ample on `Y₀`. For `n` large, `ℒ₀^{⊗ n}` is generated by finitely many global sections
([Stacks, Tag 01Q3]) and `H¹(Y₀, ℒ₀^{⊗ n}) = 0` ([Stacks, Tag 0B5U]). Pullback commutes with
tensor powers, so `c₀^*ℒ₀^{⊗ n} ≅ ℳ^{⊗ n}|_{X_k}`, and `H¹(X_k, c₀^*ℒ₀^{⊗ n}) = 0` because `c₀` is
a stable contraction (`IsStableContraction.isZero_rightDerived_one_pullback`). The uniformizer
sequence `0 ⟶ ℳ^{⊗ n} --π--> ℳ^{⊗ n} ⟶ ι_* (ℳ^{⊗ n}|_{X_k}) ⟶ 0` and Nakayama's lemma give
`H¹(X, ℳ^{⊗ n}) = 0`, so the restriction `H⁰(X, ℳ^{⊗ n}) ⟶ H⁰(X_k, ℳ^{⊗ n}|_{X_k})` is surjective
(`StableModel/SectionsGeneration/UniformizerSequence.lean`). Lifts of the pulled-back generators
do not vanish simultaneously at any point of `X_k`, hence at any point of `X`: the common
vanishing locus is closed, its image in `Spec R` is closed and misses the closed point. They define
a morphism `φ : X ⟶ ℙᴺ_R` over `R` with `φ^*𝒪(1) ≅ ℳ^{⊗ n}` ([Stacks, Tag 01NE]); `ℙᴺ_R` is proper
and Noetherian over `R`, `𝒪(1)` is ample on it, and `ℒ₀^{⊗ n}` is ample on `Y₀`.

## Main results

* `Stacks.Models.RegularProperModelSituation.exists_mem_nonvanishingLocus_of_forall_specialFiber`:
  a family of global sections of an invertible module on the model with no common zero on the
  special fibre has no common zero at all.
* `Stacks.Models.RegularProperModelSituation.generatesStalks_of_forall_specialFiber`: such a
  finite family generates the module.
* `Stacks.Models.RegularProperModelSituation.exists_projectiveSpace_pullback_iso`.

## References

* [Stacks Project, Tag 0C61](https://stacks.math.columbia.edu/tag/0C61)
* [Stacks Project, Tag 0E7Q](https://stacks.math.columbia.edu/tag/0E7Q)
* [Stacks Project, Tag 01NE](https://stacks.math.columbia.edu/tag/01NE)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace Stacks.Models.RegularProperModelSituation

variable (S : RegularProperModelSituation.{u})

/-- The point of `Spec k` lies over the closed point of `Spec R`. -/
theorem specMap_residueField_eq_closedPoint (pt : Spec (.of S.k)) :
    (Spec.map (CommRingCat.ofHom (algebraMap S.R S.k))).base pt =
      IsLocalRing.closedPoint S.R := by
  have := pt.isPrime
  refine PrimeSpectrum.ext ?_
  rw [Spec.map_apply]
  change Ideal.comap (algebraMap S.R S.k) pt.asIdeal = IsLocalRing.maximalIdeal S.R
  rw [Ideal.eq_bot_of_prime pt.asIdeal, ← RingHom.ker_eq_comap_bot]
  ext r
  rw [RingHom.mem_ker]
  exact S.algebraMap_eq_zero_iff r

/-- **Nonvanishing along the special fibre is nonvanishing everywhere.** If at every point of the
special fibre one of a family of global sections of an invertible module on the model does not
vanish, then the same holds at every point of the model: the common vanishing locus is closed,
its image in `Spec R` is closed because the model is proper, and a nonempty closed subset of the
spectrum of a local ring contains the closed point, over which lies the special fibre. -/
theorem exists_mem_nonvanishingLocus_of_forall_specialFiber {ι : Type*} (F : S.X.Modules)
    [Stacks.Ample.IsInvertibleModule S.X F] (s : ι → Γ(F, ⊤))
    (h : ∀ z : S.specialFiber, ∃ i,
      S.specialFiberι.base z ∈ Stacks.Ample.nonvanishingLocus F (s i))
    (x : S.X) : ∃ i, x ∈ Stacks.Ample.nonvanishingLocus F (s i) := by
  by_contra hx
  push Not at hx
  set Z : Set S.X := (⋃ i, Stacks.Ample.nonvanishingLocus F (s i))ᶜ with hZdef
  have hZ : IsClosed Z := (isOpen_iUnion fun i ↦
    Stacks.NonvanishingOpen.isOpen_nonvanishingLocus S.X F (s i)).isClosed_compl
  have hxZ : x ∈ Z := by
    rw [hZdef, Set.mem_compl_iff, Set.mem_iUnion, not_exists]
    exact hx
  have hfZ : IsClosed (S.X_to_R.base '' Z) := S.X_to_R.isClosedMap _ hZ
  have hc : IsLocalRing.closedPoint S.R ∈ S.X_to_R.base '' Z :=
    (hfZ.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr ⟨x, hxZ, rfl⟩))
      ((PrimeSpectrum.le_iff_mem_closure _ _).mp
        (IsLocalRing.le_maximalIdeal (S.X_to_R.base x).2.ne_top))
  obtain ⟨y, hyZ, hy⟩ := hc
  have hrange : y ∈ Set.range S.specialFiberι.base := by
    rw [Scheme.Pullback.range_fst S.X_to_R (Spec.map (CommRingCat.ofHom (algebraMap S.R S.k)))]
    obtain ⟨pt⟩ : Nonempty (Spec (.of S.k)) := inferInstance
    exact ⟨pt, (specMap_residueField_eq_closedPoint S pt).trans hy.symm⟩
  obtain ⟨z, rfl⟩ := hrange
  obtain ⟨i, hi⟩ := h z
  exact hyZ (Set.mem_iUnion.mpr ⟨i, hi⟩)

/-- **A family of global sections nonvanishing along the special fibre generates an invertible
module on the model.** -/
theorem generatesStalks_of_forall_specialFiber {N : ℕ} (F : S.X.Modules)
    [Stacks.Ample.IsInvertibleModule S.X F] (s : Fin (N + 1) → Γ(F, ⊤))
    (h : ∀ z : S.specialFiber, ∃ i,
      S.specialFiberι.base z ∈ Stacks.Ample.nonvanishingLocus F (s i)) :
    Stacks.ProjectiveFromSections.GeneratesStalks s := by
  refine Stacks.StalkwiseGeneration.generatesStalks_of_span_eq_top s fun x ↦ ?_
  obtain ⟨i, hi⟩ := exists_mem_nonvanishingLocus_of_forall_specialFiber S F s h x
  have hspan := Stacks.FinGenFromCover.span_eq_top_of_mem_nonvanishingLocus F
    (fun j : ULift.{u} (Fin (N + 1)) ↦ s j.down) (i := ⟨i⟩) hi
  have hrange : (Set.range fun j : ULift.{u} (Fin (N + 1)) ↦ (F.presheaf.Γgerm x).hom (s j.down)) =
      Set.range fun j ↦ (F.presheaf.Γgerm x).hom (s j) := by
    ext w
    exact ⟨fun ⟨j, hj⟩ ↦ ⟨j.down, hj⟩, fun ⟨j, hj⟩ ↦ ⟨⟨j⟩, hj⟩⟩
  rw [hrange] at hspan
  exact hspan

/-- **A morphism to projective space whose `𝒪(1)` restricts on the special fibre to the pullback
of an ample module along the stable contraction.** -/
theorem exists_projectiveSpace_pullback_iso
    {Y₀ : Scheme.{u}} {g₀ : Y₀ ⟶ Spec (.of S.k)} {c₀ : S.specialFiber ⟶ Y₀}
    (hc₀ : Stacks.Curves.StableModel.IsStableContraction S.specialFiberToSpec g₀ c₀)
    (M : S.X.Modules) [SheafOfModules.IsInvertible S.X.toRingedSpace.presheaf
      (structureSheafRing S.X.toRingedSpace).property M]
    (L₀ : Y₀.Modules) [SheafOfModules.IsInvertible Y₀.toRingedSpace.presheaf
      (structureSheafRing Y₀.toRingedSpace).property L₀]
    (hL₀ : Scheme.Modules.IsAmple Y₀ L₀)
    (α : (Scheme.Modules.pullback c₀).obj L₀ ≅ (Scheme.Modules.pullback S.specialFiberι).obj M) :
    ∃ (L₀' : Y₀.Modules) (_ : SheafOfModules.IsInvertible Y₀.toRingedSpace.presheaf
        (structureSheafRing Y₀.toRingedSpace).property L₀')
      (P : Scheme.{u}) (q : P ⟶ Spec (.of S.R)) (_ : IsProper q) (_ : IsLocallyNoetherian P)
      (φ : S.X ⟶ P) (A : P.Modules) (_ : SheafOfModules.IsInvertible P.toRingedSpace.presheaf
        (structureSheafRing P.toRingedSpace).property A),
      Scheme.Modules.IsAmple Y₀ L₀' ∧ φ ≫ q = S.X_to_R ∧ Scheme.Modules.IsAmple P A ∧
        Nonempty ((Scheme.Modules.pullback c₀).obj L₀' ≅
          (Scheme.Modules.pullback S.specialFiberι).obj ((Scheme.Modules.pullback φ).obj A)) := by
  classical
  have hMinv : Stacks.Ample.IsInvertibleModule S.X M := ‹_›
  have hL₀inv : Stacks.Ample.IsInvertibleModule Y₀ L₀ := ‹_›
  have : IsProper g₀ := hc₀.isProper
  have hL₀s : Stacks.Ample.IsAmple Y₀ L₀ :=
    Stacks.PowerFamilyBridge.isAmple_of_modulesIsAmple Y₀ L₀ hL₀
  obtain ⟨d₁, hd₁⟩ := Stacks.StalkwiseGeneration.eventuallyGeneratesStalksPowers_of_isAmple L₀ hL₀s
  obtain ⟨d₂, hd₂⟩ :=
    AlgebraicGeometry.ExceptionalCurveContraction.exists_isZero_rightDerived_one_tensorPowModule
      g₀ L₀ hL₀
  set n : ℕ := max (max d₁.toNat d₂) 1 with hn
  set L₀' := Stacks.Ample.tensorPowModule Y₀ L₀ (n : ℤ) with hL₀'
  set F := Stacks.Ample.tensorPowModule S.X M (n : ℤ) with hF
  obtain ⟨m, t, ht⟩ := hd₁ (n : ℤ) (by omega)
  have hH1 := hd₂ n (by omega)
  have hL₀'inv : Stacks.Ample.IsInvertibleModule Y₀ L₀' :=
    Stacks.Ample.isInvertibleModule_tensorPowModule Y₀ L₀ n
  have hFinv : Stacks.Ample.IsInvertibleModule S.X F :=
    Stacks.Ample.isInvertibleModule_tensorPowModule S.X M n
  -- restriction to the special fibre and pullback along the contraction agree on the powers
  have β : (Scheme.Modules.pullback c₀).obj L₀' ≅ (Scheme.Modules.pullback S.specialFiberι).obj F :=
    Stacks.RelativeVeryAmple.pullbackTensorPowModuleIso c₀ L₀ n ≪≫
      Stacks.RelativeVeryAmple.tensorPowModuleIsoOfIso S.specialFiber _ _ α n ≪≫
      (Stacks.RelativeVeryAmple.pullbackTensorPowModuleIso S.specialFiberι M n).symm
  -- `H¹` of the restriction of `F` to the special fibre vanishes
  have hdim : topologicalKrullDim S.specialFiber ≤ 1 :=
    (S.toRegularModelSituation.topologicalKrullDim_specialFiber S.nonempty_specialFiber).le
  have hH1k : IsZero (((moduleGlobalSections S.specialFiber).rightDerived 1).obj
      ((Scheme.Modules.pullback S.specialFiberι).obj F)) :=
    have : SheafOfModules.IsInvertible Y₀.toRingedSpace.presheaf
        (structureSheafRing Y₀.toRingedSpace).property L₀' := hL₀'inv
    IsZero.of_iso (hc₀.isZero_rightDerived_one_pullback hdim L₀' hH1)
      (((moduleGlobalSections S.specialFiber).rightDerived 1).mapIso β.symm)
  -- sections of the restriction lift
  have hsurj := @surjective_pullbackGlobalSections_specialFiberι S F hFinv hH1k
  -- lifts of the pulled-back generators generate `F`
  choose s hs using fun j ↦ hsurj (β.hom.app ⊤ (pullbackGlobalSections c₀ L₀' (t j)))
  have hgen : Stacks.ProjectiveFromSections.GeneratesStalks s :=
    generatesStalks_of_forall_specialFiber S F s fun z ↦ by
      obtain ⟨j, hj⟩ :=
        Stacks.ProjectiveFromSections.exists_mem_nvCover_of_generatesStalks t ht (c₀.base z)
      refine ⟨j, ?_⟩
      have h1 : z ∈ c₀.base ⁻¹' Stacks.Ample.nonvanishingLocus L₀' (t j) := hj
      rw [Stacks.NonvanishingPullback.preimage_nonvanishingLocus_pullbackGlobalSections,
        ← Stacks.Ample.nonvanishingLocus_congr β, ← hs j,
        ← Stacks.NonvanishingPullback.preimage_nonvanishingLocus_pullbackGlobalSections] at h1
      exact h1
  -- the morphism to projective space
  obtain ⟨p, hp, α', hα', -⟩ :=
    Stacks.TwistPullbackPinned.exists_hom_over_and_iso_pullback_twistingSheafAtUniverse s hgen
      S.X_to_R
  have := hα'
  have : IsProper (projectiveSpaceOver m (Spec (.of S.R)) ↘ Spec (.of S.R)) :=
    isProper_projectiveSpaceOver m _
  have hAinv : Stacks.Ample.IsInvertibleModule (projectiveSpaceOver m (Spec (.of S.R)))
      (Stacks.AmpleProjectiveImmersion.projectiveSpaceTwistingSheaf m (Spec (.of S.R))) :=
    Stacks.InvertiblePullback.isInvertibleModule_pullback
      (projectiveSpaceOver.toIntegralAtUniverse m (Spec (.of S.R)))
      (Stacks.AmpleProjectiveImmersion.twistingSheafAtUniverse.{u} m)
  refine ⟨L₀', hL₀'inv, projectiveSpaceOver m (Spec (.of S.R)),
    projectiveSpaceOver m (Spec (.of S.R)) ↘ Spec (.of S.R), inferInstance,
    LocallyOfFiniteType.isLocallyNoetherian
      (projectiveSpaceOver m (Spec (.of S.R)) ↘ Spec (.of S.R)),
    p, Stacks.AmpleProjectiveImmersion.projectiveSpaceTwistingSheaf m (Spec (.of S.R)), hAinv,
    (Stacks.AmpleBridge.isAmple_iff_isAmple Y₀ L₀').mp
      (Stacks.AmplePositivePower.isAmple_tensorPowModule_of_isAmple L₀ n (by omega) hL₀s),
    hp,
    (Stacks.AmpleBridge.isAmple_iff_isAmple _ _).mp
      (Stacks.ProjectiveSpace.isAmple_projectiveSpaceTwistingSheaf m (Spec (.of S.R))),
    ⟨β ≪≫ (Scheme.Modules.pullback S.specialFiberι).mapIso ((asIso α').symm ≪≫
      ((Scheme.Modules.pullbackComp p
        (projectiveSpaceOver.toIntegralAtUniverse m (Spec (.of S.R)))).app
          (Stacks.AmpleProjectiveImmersion.twistingSheafAtUniverse.{u} m)).symm)⟩⟩

end Stacks.Models.RegularProperModelSituation

end
