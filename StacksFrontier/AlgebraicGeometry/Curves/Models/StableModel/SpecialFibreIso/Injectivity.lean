/-!
# Injectivity of `𝒪_{Y_k} ⟶ c_{k*}𝒪_{X_k}`

In the situation of [Stacks, Tag 0C61] let `c : X ⟶ Y` be a morphism over `Spec R` with
`𝒪_Y = c_*𝒪_X`. The map `𝒪_{Y_k} ⟶ c_{k*}𝒪_{X_k}` of special fibres is injective, because a
function on an open of `Y` whose pullback vanishes on `X_k` is divisible by the uniformizer `π`.

The divisibility holds over *every* open `W ⊆ X`, not only over affine ones: a function on `W`
vanishing on `X_k` is `π` times a function on each affine open of `W`, where the ideal of `X_k` is
generated by `π` (`Stacks.Models.specialFiberIdeal_ideal_eq_span`), and these quotients glue
because `π` is a nonzerodivisor on every open, `X` being flat over `R`. Then for an affine open
`U ⊆ Y`, a function `a` on `U` with `c_k^♯(a|_{Y_k}) = 0` has `c^♯ a = π b` on `c⁻¹U`, and
`b = c^♯ a'` gives `a = π a'`, which vanishes on `Y_k`. Such opens `U ∩ Y_k` cover `Y_k`, so the
map of sheaves is a monomorphism.

## Main results

* `Stacks.Models.RegularProperModelSituation.eq_zero_of_chartHom_uniformizer_mul_eq_zero`: `π` is
  a nonzerodivisor on every open of `X`.
* `Stacks.Models.RegularProperModelSituation.exists_eq_chartHom_uniformizer_mul`: a function on an
  open of `X` vanishing on `X_k` is divisible by `π`.
* `Stacks.Models.RegularProperModelSituation.injective_app_specialFiberMap`: injectivity on the
  sections over `U ∩ Y_k`, `U ⊆ Y` affine.
* `Stacks.Models.RegularProperModelSituation.mono_unitToPushforwardUnit_specialFiberMap`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

universe u

namespace Stacks.Models

/-- Functions coming from the base ring are compatible with pullback of functions:
`f^♯` carries the function `r` cuts out on `U` to the one it cuts out on `f⁻¹U`. -/
theorem chartHom_comp_app {R : Type u} [CommRing R] {X Y : Scheme.{u}} (f : X ⟶ Y)
    (p : Y ⟶ Spec (.of R)) (U : Y.Opens) :
    chartHom p U ≫ f.app U = chartHom (f ≫ p) (f ⁻¹ᵁ U) := by
  rw [chartHom, chartHom, Category.assoc, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]

/-- Functions coming from the base ring through a ring map `R ⟶ A`: on a scheme over `Spec A`,
viewed over `Spec R`, the function cut out by `r` is the one cut out by its image in `A`. -/
theorem chartHom_comp_specMap {R A : Type u} [CommRing R] [CommRing A] {X : Scheme.{u}}
    (q : X ⟶ Spec (.of A)) (φ : R →+* A) (U : X.Opens) :
    chartHom (q ≫ Spec.map (CommRingCat.ofHom φ)) U = CommRingCat.ofHom φ ≫ chartHom q U := by
  rw [chartHom, chartHom, Scheme.Hom.comp_appLE, ← Category.assoc (CommRingCat.ofHom φ),
    Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ), Category.assoc]
  rfl

namespace RegularProperModelSituation

variable (S : RegularProperModelSituation.{u})

/-- The uniformizer maps to zero in the residue field. -/
alias algebraMap_uniformizer := Stacks.Models.algebraMap_pi_eq_zero

/-- The function cut out by the uniformizer is compatible with restriction. -/
theorem map_chartHom_uniformizer {V W : S.X.Opens} (i : V ≤ W) :
    S.X.presheaf.map (homOfLE i).op ((chartHom S.X_to_R W).hom S.π) =
      (chartHom S.X_to_R V).hom S.π :=
  congrArg (fun φ : CommRingCat.of S.R ⟶ Γ(S.X, V) ↦ φ.hom S.π)
    (chartHom_comp_map S.X_to_R (homOfLE i).op)

/-- Restriction maps of the structure sheaf compose. -/
theorem map_map_apply {W V V' : S.X.Opens} (h₁ : V ≤ W) (h₂ : V' ≤ V) (s : Γ(S.X, W)) :
    S.X.presheaf.map (homOfLE h₂).op (S.X.presheaf.map (homOfLE h₁).op s) =
      S.X.presheaf.map (homOfLE (h₂.trans h₁)).op s := by
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

/-- **The uniformizer is a nonzerodivisor on every affine open of the model**, which is flat over
the discrete valuation ring. -/
theorem eq_zero_of_chartHom_uniformizer_mul_eq_zero_of_isAffineOpen {V : S.X.Opens}
    (hV : IsAffineOpen V) {b : Γ(S.X, V)} (hb : (chartHom S.X_to_R V).hom S.π * b = 0) :
    b = 0 := by
  let φ := chartHom S.X_to_R V
  let : Algebra S.R Γ(S.X, V) := φ.hom.toAlgebra
  have hj : hV.fromSpec ≫ S.X_to_R = Spec.map (CommRingCat.ofHom (algebraMap S.R Γ(S.X, V))) := by
    change hV.fromSpec ≫ S.X_to_R = Spec.map φ
    dsimp [φ, chartHom]
    rw [Spec.map_comp]
    simpa [Scheme.isoSpec_Spec_inv, IsAffineOpen.fromSpec_top] using
      (IsAffineOpen.SpecMap_appLE_fromSpec S.X_to_R (isAffineOpen_top (Spec (.of S.R))) hV
        (by simp)).symm
  have hnzd := map_mem_nonZeroDivisors_of_flat S.π
    (mem_nonZeroDivisors_of_ne_zero S.uniformizer.ne_zero) S.X_to_R hV.fromSpec hj
  exact (mem_nonZeroDivisors_iff_right.mp hnzd) b (by rw [mul_comm]; exact hb)

/-- **The uniformizer is a nonzerodivisor on every open of the model**: a function killed by it
restricts to zero on every affine open, hence has zero germs. -/
theorem eq_zero_of_chartHom_uniformizer_mul_eq_zero {W : S.X.Opens} {b : Γ(S.X, W)}
    (hb : (chartHom S.X_to_R W).hom S.π * b = 0) : b = 0 := by
  refine TopCat.Presheaf.section_ext S.X.sheaf W b 0 fun x hx => ?_
  obtain ⟨V, hV, hxV, hVW' : V ≤ W⟩ := exists_isAffineOpen_mem_and_subset (U := W) hx
  have hres : S.X.presheaf.map (homOfLE hVW').op b = 0 := by
    refine S.eq_zero_of_chartHom_uniformizer_mul_eq_zero_of_isAffineOpen hV ?_
    rw [← S.map_chartHom_uniformizer hVW', ← map_mul, hb, map_zero]
  change S.X.presheaf.germ W x hx b = S.X.presheaf.germ W x hx 0
  rw [← S.X.presheaf.germ_res_apply (homOfLE hVW') x hxV b, hres, map_zero, map_zero]

/-- **A function on an open of the model vanishing on the special fibre is divisible by the
uniformizer.** On each affine open the ideal of `X_k` is generated by `π`; the local quotients
are unique, `π` being a nonzerodivisor, so they glue. -/
theorem exists_eq_chartHom_uniformizer_mul {W : S.X.Opens} (s : Γ(S.X, W))
    (hs : S.specialFiberι.app W s = 0) :
    ∃ b : Γ(S.X, W), s = (chartHom S.X_to_R W).hom S.π * b := by
  have hloc : ∀ V : S.X.affineOpens, ∀ hVW : V.1 ≤ W, ∃ b : Γ(S.X, V.1),
      S.X.presheaf.map (homOfLE hVW).op s = (chartHom S.X_to_R V.1).hom S.π * b := by
    intro V hVW
    have hker : S.X.presheaf.map (homOfLE hVW).op s ∈
        RingHom.ker (S.specialFiberι.app V.1).hom := by
      rw [RingHom.mem_ker]
      refine (congrArg (fun φ => φ.hom s) (S.specialFiberι.naturality (homOfLE hVW).op)).trans ?_
      change S.specialFiber.presheaf.map _ (S.specialFiberι.app W s) = 0
      rw [hs, map_zero]
    rw [← Scheme.Hom.ker_apply, specialFiberIdeal_ideal_eq_span S.residueEquiv S.X_to_R
      S.uniformizer V.1 V.2] at hker
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hker
    exact ⟨a, by rw [← ha, mul_comm]⟩
  choose b hb using hloc
  let ι := {V : S.X.affineOpens // V.1 ≤ W}
  let U : ι → S.X.Opens := fun i => i.1.1
  let sf : ∀ i : ι, Γ(S.X, U i) := fun i => b i.1 i.2
  have hcover : W ≤ iSup U := by
    intro x hx
    obtain ⟨V, hV, hxV, hVW⟩ := exists_isAffineOpen_mem_and_subset (U := W) hx
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨V, hV⟩, hVW⟩, hxV⟩
  have hrestr : ∀ (i : ι) {V' : S.X.Opens} (h : V' ≤ U i),
      (chartHom S.X_to_R V').hom S.π * S.X.presheaf.map (homOfLE h).op (sf i) =
        S.X.presheaf.map (homOfLE (h.trans i.2)).op s := by
    intro i V' h
    rw [← S.map_chartHom_uniformizer h, ← map_mul]
    change S.X.presheaf.map (homOfLE h).op ((chartHom S.X_to_R (U i)).hom S.π * b i.1 i.2) = _
    rw [← hb i.1 i.2, S.map_map_apply]
  have hcompat : TopCat.Presheaf.IsCompatible S.X.sheaf.1 U sf := by
    intro i j
    have key : S.X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (sf i) =
        S.X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (sf j) :=
      sub_eq_zero.mp <| S.eq_zero_of_chartHom_uniformizer_mul_eq_zero <| by
        rw [mul_sub, sub_eq_zero]
        exact (hrestr i inf_le_left).trans (hrestr j inf_le_right).symm
    exact key
  obtain ⟨g, hg, -⟩ := S.X.sheaf.existsUnique_gluing' U W (fun i => homOfLE i.2) hcover sf
    hcompat
  let g' : Γ(S.X, W) := g
  have hg' : ∀ i : ι, S.X.presheaf.map (homOfLE i.2).op g' = sf i := hg
  refine ⟨g', S.X.sheaf.eq_of_locally_eq' U W (fun i => homOfLE i.2) hcover s
    ((chartHom S.X_to_R W).hom S.π * g') fun i => ?_⟩
  change S.X.presheaf.map (homOfLE i.2).op s =
    S.X.presheaf.map (homOfLE i.2).op ((chartHom S.X_to_R W).hom S.π * g')
  rw [map_mul, S.map_chartHom_uniformizer, hg' i, hb i.1 i.2]

/-- The uniformizer vanishes on the special fibre of any scheme over `Spec R`. -/
theorem chartHom_uniformizer_comp_app_pullbackFst {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of S.R))
    (U : Y.Opens) :
    (pullback.fst pY (Spec.map (CommRingCat.ofHom (algebraMap S.R S.k)))).app U
      ((chartHom pY U).hom S.π) = 0 := by
  refine (congrArg (fun φ => φ.hom S.π) (chartHom_comp_app
    (pullback.fst pY (Spec.map (CommRingCat.ofHom (algebraMap S.R S.k)))) pY U)).trans ?_
  rw [pullback.condition, chartHom_comp_specMap]
  change (chartHom _ _).hom (algebraMap S.R S.k S.π) = 0
  rw [S.algebraMap_uniformizer, map_zero]

/-- **`c_k^♯` is injective on the sections over `U ∩ Y_k`, for `U ⊆ Y` affine.** A function `a` on
`U` with `c_k^♯(a|_{Y_k}) = 0` has `c^♯ a` vanishing on `X_k`, so `c^♯ a = π · c^♯ a'`; as
`𝒪_Y = c_*𝒪_X`, `a = π a'`, which vanishes on `Y_k`. -/
theorem injective_app_specialFiberMap {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of S.R)) (c : S.X ⟶ Y)
    (hc : c ≫ pY = S.X_to_R)
    (hO : IsIso (SheafOfModules.unitToPushforwardObjUnit c.toRingCatSheafHom))
    (U : Y.Opens) (hU : IsAffineOpen U) :
    Function.Injective ((S.specialFiberMap pY c hc).app
      (pullback.fst pY (Spec.map (CommRingCat.ofHom (algebraMap S.R S.k))) ⁻¹ᵁ U)) := by
  have : IsClosedImmersion (Spec.map (CommRingCat.ofHom (algebraMap S.R S.k))) :=
    IsClosedImmersion.spec_of_surjective _ S.surjective_algebraMap_residueField
  set j := pullback.fst pY (Spec.map (CommRingCat.ofHom (algebraMap S.R S.k)))
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨a, rfl⟩ := j.app_surjective U hU x
  have hι : S.specialFiberι.app (c ⁻¹ᵁ U) (c.app U a) = 0 := by
    refine (congrArg (fun φ => φ.hom a)
      (Scheme.Hom.congr_app (S.specialFiberMap_fst pY c hc).symm U)).trans ?_
    change S.specialFiber.presheaf.map _
      ((S.specialFiberMap pY c hc).app (j ⁻¹ᵁ U) (j.app U a)) = 0
    rw [hx, map_zero]
  obtain ⟨b, hb⟩ := S.exists_eq_chartHom_uniformizer_mul (c.app U a) hι
  have hbij : Function.Bijective (c.app U) := by
    have := Stacks.Curves.DualizingPullback.isIso_app_of_isIso_unitToPushforwardObjUnit c hO U
    exact ConcreteCategory.bijective_of_isIso _
  obtain ⟨a', rfl⟩ := hbij.2 b
  have hπ : c.app U ((chartHom pY U).hom S.π) = (chartHom S.X_to_R (c ⁻¹ᵁ U)).hom S.π := by
    refine (congrArg (fun φ => φ.hom S.π) (chartHom_comp_app c pY U)).trans ?_
    rw [hc]
  have ha : a = (chartHom pY U).hom S.π * a' := hbij.1 (by rw [map_mul, hπ, hb])
  rw [ha, map_mul, S.chartHom_uniformizer_comp_app_pullbackFst pY U, zero_mul]

/-- **`𝒪_{Y_k} ⟶ c_{k*}𝒪_{X_k}` is a monomorphism**: it is injective on the sections over the opens
`U ∩ Y_k`, `U ⊆ Y` affine, which cover every open of `Y_k`. -/
theorem mono_unitToPushforwardUnit_specialFiberMap {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of S.R))
    (c : S.X ⟶ Y) (hc : c ≫ pY = S.X_to_R)
    (hO : IsIso (SheafOfModules.unitToPushforwardObjUnit c.toRingCatSheafHom)) :
    Mono (Scheme.Modules.unitToPushforwardUnit (S.specialFiberMap pY c hc)) := by
  have : IsClosedImmersion (Spec.map (CommRingCat.ofHom (algebraMap S.R S.k))) :=
    IsClosedImmersion.spec_of_surjective _ S.surjective_algebraMap_residueField
  set j := pullback.fst pY (Spec.map (CommRingCat.ofHom (algebraMap S.R S.k)))
  refine SheafOfModules.mono_of_injective_app_of_cover _ fun W => ?_
  refine ⟨{U : Y.affineOpens // j ⁻¹ᵁ U.1 ≤ W}, fun i => j ⁻¹ᵁ i.1.1, fun i => homOfLE i.2,
    ?_, fun i => S.injective_app_specialFiberMap pY c hc hO i.1.1 i.1.2⟩
  intro x hx
  obtain ⟨W', hW', hWW'⟩ := (j.isEmbedding.isInducing.isOpen_iff).mp W.isOpen
  have hjx : j x ∈ W' := show x ∈ j ⁻¹' W' by rwa [hWW']
  obtain ⟨U, hU, hxU, hUW'⟩ := exists_isAffineOpen_mem_and_subset (U := ⟨W', hW'⟩) hjx
  have hle : j ⁻¹ᵁ U ≤ W := fun z hz => by
    have : z ∈ j ⁻¹' W' := hUW' hz
    rwa [hWW'] at this
  exact ⟨j ⁻¹ᵁ U, homOfLE hle, Sieve.ofArrows_mk (I := {U : Y.affineOpens // j ⁻¹ᵁ U.1 ≤ W})
    (fun i => j ⁻¹ᵁ i.1.1) (fun i => homOfLE i.2) ⟨⟨U, hU⟩, hle⟩, hxU⟩

end RegularProperModelSituation

end Stacks.Models

