/-!
# A component meeting another one in a single rational point

In the situation of [Stacks, Tag 0C61] let `C_Z ≠ C_W` be irreducible components of the special
fibre, and let `κ_Z = Γ(C_Z, 𝒪)`, a finite field extension of `k` of degree `w_Z`. If the
intersection number `(C_Z · C_W)` equals `w_Z`, then the scheme-theoretic intersection
`C_Z ∩ C_W` is the spectrum of `κ_Z`: a single point `c` of `C_Z` with residue field `κ_Z`, at
which the local equation of the Cartier divisor `C_W` generates the maximal ideal of `𝒪_{C_Z, c}`.
So `𝒪_{C_Z, c}` is regular and `C_Z ⟶ Spec κ_Z` is smooth at the `κ_Z`-rational point `c`.
This is the step of the proof of [Stacks, Tag 0CEE] producing a rational point on a component
which is not the one through the given rational point.

## Main results

In the namespace `Stacks.Models.RegularProperModelSituation`:

* `isFinite_componentIntersectionIdeal`: the intersection `C_Z ∩ C_W` of two distinct components
  is finite over `k`.
* `exists_isRationalPoint_smoothAt_toSpecΓ_of_componentIntersection_eq_weight`:
  if `(C_Z · C_W) = [κ_Z : k]`, then `C_Z` has a `κ_Z`-rational point at which it is smooth over
  `κ_Z`.

## References

* [Stacks Project, Tag 0CEE](https://stacks.math.columbia.edu/tag/0CEE)
* [Stacks Project, Tag 00NQ](https://stacks.math.columbia.edu/tag/00NQ)
* [Stacks Project, Tag 00TV](https://stacks.math.columbia.edu/tag/00TV)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits IsLocalRing Opposite

universe u

namespace Stacks.Models

/-- **A Noetherian local ring whose maximal ideal is generated by a nonzerodivisor is regular**:
the maximal ideal needs one generator and has height at least one. -/
theorem isRegularLocalRing_of_maximalIdeal_eq_span_of_mem_nonZeroDivisors
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R] {x : R}
    (hm : maximalIdeal R = Ideal.span {x}) (hxreg : x ∈ nonZeroDivisors R) :
    IsRegularLocalRing R := by
  have hx : x ∈ maximalIdeal R := hm ▸ Ideal.subset_span rfl
  have hprincipal : (maximalIdeal R).IsPrincipal := ⟨⟨x, hm⟩⟩
  have hdim : (1 : WithBot ℕ∞) ≤ ringKrullDim R := by
    rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim]
    exact_mod_cast (Ideal.one_le_height_span_singleton_of_mem_nonZeroDivisors hxreg).trans
      (Ideal.height_mono (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hx)))
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  apply le_trans (b := (1 : WithBot ℕ∞)) ?_ hdim
  rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
  exact_mod_cast (IsLocalRing.finrank_cotangentSpace_le_one_iff.mpr hprincipal)

/-- On an affine scheme whose global functions form a field, the germ of the global functions at
any point is bijective: the local ring is a localization of a field at its zero ideal. -/
theorem bijective_germ_top_of_isField {Y : Scheme.{u}} [IsAffine Y] (hF : IsField Γ(Y, ⊤))
    (y : Y) : Function.Bijective (Y.presheaf.germ ⊤ y trivial).hom := by
  let := hF.toField
  have hU := isAffineOpen_top Y
  let := Y.presheaf.algebra_section_stalk (U := ⊤) ⟨y, trivial⟩
  have := hU.isLocalization_stalk ⟨y, trivial⟩
  have H : (hU.primeIdealOf ⟨y, trivial⟩).asIdeal.primeCompl ≤ IsUnit.submonoid Γ(Y, ⊤) := by
    intro a ha
    refine isUnit_iff_ne_zero.mpr fun h0 => ha ?_
    rw [h0]
    exact zero_mem _
  exact (IsLocalization.atUnits Γ(Y, ⊤) _ (S := Y.presheaf.stalk y) H).bijective

/-- On an affine scheme whose global functions form a field, every local ring is that field. -/
theorem isField_stalk_of_isField {Y : Scheme.{u}} [IsAffine Y] (hF : IsField Γ(Y, ⊤)) (y : Y) :
    IsField (Y.presheaf.stalk y) :=
  (RingEquiv.ofBijective _ (bijective_germ_top_of_isField hF y)).symm.toMulEquiv.isField hF

/-- On an affine scheme whose global functions form a field, evaluation at any point is a
bijection onto the residue field. -/
theorem bijective_Γevaluation_of_isField {Y : Scheme.{u}} [IsAffine Y] (hF : IsField Γ(Y, ⊤))
    (y : Y) : Function.Bijective (Y.Γevaluation y).hom := by
  let := hF.toField
  refine ⟨RingHom.injective _, ?_⟩
  have h := (Y.residue_surjective y).comp (bijective_germ_top_of_isField hF y).2
  exact h

/-- **A point is rational as soon as the ground field maps isomorphically onto its residue field
through the global functions.** -/
theorem isRationalPoint_of_isIso_Γevaluation {k : Type u} [Field k] {Y : Scheme.{u}}
    (f : Y ⟶ Spec (.of k)) (y : Y)
    (h : IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ Y.Γevaluation y)) :
    IsRationalPoint f y := by
  have key : Spec.preimage (Y.fromSpecResidueField y ≫ f) =
      (Scheme.ΓSpecIso (.of k)).inv ≫ (Y.fromSpecResidueField y ≫ f).appTop ≫
        (Scheme.ΓSpecIso _).hom := by
    conv_rhs => rw [← Spec.map_preimage (Y.fromSpecResidueField y ≫ f)]
    rw [Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]
  rw [Scheme.Hom.comp_appTop, Category.assoc, fromSpecResidueField_appTop] at key
  unfold IsRationalPoint
  rw [key]
  exact h

end Stacks.Models

attribute [local instance] AlgebraicGeometry.isIso_residueFieldMap_of_isClosedImmersion

namespace Stacks.Models.RegularProperModelSituation

variable (S : RegularProperModelSituation.{u})

/-- The intersection of two distinct components is finite over `k`: it is the zero scheme of a
nonzero section of an invertible module on the integral proper curve `C_Z`. -/
theorem isFinite_componentIntersectionIdeal {Z W : irreducibleComponents S.specialFiber}
    (hZW : Z ≠ W) :
    IsFinite ((S.componentIntersectionIdeal Z W).subschemeι ≫ S.specialFiberComponentToSpec Z) := by
  have := S.isEffectiveCartierDivisor_specialFiberComponent W
  have h := isFinite_zeroScheme_of_eval_top_ne_zero S.k (S.specialFiberComponentToSpec Z)
    (S.toRegularModelSituation.topologicalKrullDim_specialFiberComponent Z)
    ((Scheme.Modules.pullback (S.specialFiberComponentIdeal Z).subschemeι).obj
      (Stacks.Divisors.invertibleSheaf' (S.specialFiberComponentIdeal W)))
    (Stacks.Divisors.sectionsOfTop _ (Stacks.Divisors.pullbackCanonicalSection
      (S.specialFiberComponentIdeal Z).subschemeι (S.specialFiberComponentIdeal W)))
    (by
      rw [Stacks.Divisors.sectionsOfTop_eval_top]
      exact pullbackCanonicalSection_subschemeι_ne_zero _ _
        (S.not_supportSet_specialFiberComponentIdeal_subset hZW))
  have e := Stacks.Divisors.zeroScheme_sectionsOfTop_pullbackCanonicalSection
    (S.specialFiberComponentIdeal Z).subschemeι (S.specialFiberComponentIdeal W)
  rw [componentIntersectionIdeal, ← e]
  exact h


/-- **A component meeting another one with intersection number its weight has a smooth rational
point over its field of constants.** Let `C_Z ≠ C_W` be components of the special fibre with
`(C_Z · C_W) = w_Z = [κ_Z : k]`, where `κ_Z = Γ(C_Z, 𝒪)`. The scheme-theoretic intersection
`C_Z ∩ C_W` is finite over `k`, its ring of functions is a `κ_Z`-algebra of `k`-dimension `w_Z`,
hence equal to `κ_Z`; so the intersection is a single point `c` with residue field `κ_Z`, and the
maximal ideal of `𝒪_{C_Z, c}` is generated by the local equation of the Cartier divisor `C_W`.
Thus `𝒪_{C_Z, c}` is regular, and `C_Z ⟶ Spec κ_Z` is smooth at the `κ_Z`-rational point `c`. -/
theorem exists_isRationalPoint_smoothAt_toSpecΓ_of_componentIntersection_eq_weight
    {Z W : irreducibleComponents S.specialFiber} (hZW : Z ≠ W)
    (h : S.specialFiberIntersectionMatrix Z W = S.specialFiberComponentWeight Z) :
    letI : Field Γ((S.specialFiberComponentIdeal Z).subscheme, ⊤) :=
      (S.isField_and_finite_globalSections_specialFiberComponent Z).1.toField
    ∃ c : (S.specialFiberComponentIdeal Z).subscheme,
      IsRationalPoint (S.specialFiberComponentIdeal Z).subscheme.toSpecΓ c ∧
        InfinitesimalLifting.SmoothAt (S.specialFiberComponentIdeal Z).subscheme.toSpecΓ c := by
  let : Field Γ((S.specialFiberComponentIdeal Z).subscheme, ⊤) :=
    (S.isField_and_finite_globalSections_specialFiberComponent Z).1.toField
  let : Algebra S.k Γ((S.specialFiberComponentIdeal Z).subscheme, ⊤) :=
    ((Scheme.ΓSpecIso (.of S.k)).inv ≫ (S.specialFiberComponentToSpec Z).appTop).hom.toAlgebra
  let : Algebra S.k Γ((S.componentIntersectionIdeal Z W).subscheme, ⊤) :=
    ((Scheme.ΓSpecIso (.of S.k)).inv ≫
      ((S.componentIntersectionIdeal Z W).subschemeι ≫
        S.specialFiberComponentToSpec Z).appTop).hom.toAlgebra
  have : FiniteDimensional S.k Γ((S.specialFiberComponentIdeal Z).subscheme, ⊤) :=
    (S.isField_and_finite_globalSections_specialFiberComponent Z).2
  -- the ring of functions of the intersection has dimension `w_Z` over `k`
  have hdimI : Module.finrank S.k Γ((S.componentIntersectionIdeal Z W).subscheme, ⊤) =
      Module.finrank S.k Γ((S.specialFiberComponentIdeal Z).subscheme, ⊤) := by
    have h1 := S.specialFiberIntersectionMatrix_eq_finrank_globalSections hZW
    rw [h] at h1
    exact_mod_cast h1.symm
  have hpos : 0 < Module.finrank S.k Γ((S.componentIntersectionIdeal Z W).subscheme, ⊤) :=
    hdimI ▸ S.specialFiberComponentWeight_pos Z
  have : Nontrivial Γ((S.componentIntersectionIdeal Z W).subscheme, ⊤) :=
    Module.nontrivial_of_finrank_pos hpos
  have : FiniteDimensional S.k Γ((S.componentIntersectionIdeal Z W).subscheme, ⊤) :=
    Module.finite_of_finrank_pos hpos
  -- restriction of functions from `C_Z` to the intersection is bijective
  let φ : Γ((S.specialFiberComponentIdeal Z).subscheme, ⊤) →ₐ[S.k]
      Γ((S.componentIntersectionIdeal Z W).subscheme, ⊤) :=
    { (S.componentIntersectionIdeal Z W).subschemeι.appTop.hom with
      commutes' := fun c => rfl }
  have hφinj : Function.Injective φ := φ.toRingHom.injective
  have hφ : Function.Bijective φ :=
    ⟨hφinj, (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (f := φ.toLinearMap)
      hdimI.symm).mp hφinj⟩
  have hFI : IsField Γ((S.componentIntersectionIdeal Z W).subscheme, ⊤) :=
    (RingEquiv.ofBijective φ.toRingHom hφ).symm.toMulEquiv.isField (Field.toIsField _)
  -- the intersection is affine, with a point `p`
  have : IsFinite
      ((S.componentIntersectionIdeal Z W).subschemeι ≫ S.specialFiberComponentToSpec Z) :=
    S.isFinite_componentIntersectionIdeal hZW
  have : IsAffine (S.componentIntersectionIdeal Z W).subscheme :=
    isAffine_of_isAffineHom
      ((S.componentIntersectionIdeal Z W).subschemeι ≫ S.specialFiberComponentToSpec Z)
  obtain ⟨p⟩ : Nonempty (S.componentIntersectionIdeal Z W).subscheme := by
    by_contra hne
    have : IsEmpty (S.componentIntersectionIdeal Z W).subscheme := not_nonempty_iff.mp hne
    exact not_subsingleton Γ((S.componentIntersectionIdeal Z W).subscheme, ⊤) inferInstance
  set c := (S.componentIntersectionIdeal Z W).subschemeι p with hc
  -- `c` is a `κ_Z`-rational point
  have hev : Function.Bijective
      ((S.specialFiberComponentIdeal Z).subscheme.Γevaluation c).hom := by
    have hnat := congrArg (fun φ => φ.hom)
      (Scheme.Γevaluation_naturality (S.componentIntersectionIdeal Z W).subschemeι p)
    have hres :
        Function.Bijective ((S.componentIntersectionIdeal Z W).subschemeι.residueFieldMap p).hom :=
      ConcreteCategory.bijective_of_isIso _
    have hR : Function.Bijective
        (((S.componentIntersectionIdeal Z W).subschemeι.appTop ≫
          (S.componentIntersectionIdeal Z W).subscheme.Γevaluation p).hom) :=
      (bijective_Γevaluation_of_isField hFI p).comp hφ
    rw [← hnat] at hR
    exact (Function.Bijective.of_comp_iff' hres _).mp hR
  have hrat : IsRationalPoint (S.specialFiberComponentIdeal Z).subscheme.toSpecΓ c := by
    refine isRationalPoint_of_isIso_Γevaluation _ c ?_
    rw [Scheme.toSpecΓ_appTop]
    show IsIso ((Scheme.ΓSpecIso Γ((S.specialFiberComponentIdeal Z).subscheme, ⊤)).inv ≫
      (Scheme.ΓSpecIso Γ((S.specialFiberComponentIdeal Z).subscheme, ⊤)).hom ≫
        (S.specialFiberComponentIdeal Z).subscheme.Γevaluation c)
    rw [Iso.inv_hom_id_assoc, ConcreteCategory.isIso_iff_bijective]
    exact hev
  refine ⟨c, hrat, ?_⟩
  -- the local ring at `c` is regular
  have : IsLocallyNoetherian (S.specialFiberComponentIdeal Z).subscheme :=
    LocallyOfFiniteType.isLocallyNoetherian (S.specialFiberComponentToSpec Z)
  have : IsProper (S.specialFiberComponentIdeal Z).subscheme.toSpecΓ :=
    Stacks.AlgebraicGeometry.ProperGeomConnected.isProper_toSpecΓ
      (S.specialFiberComponentToSpec Z)
  have hFp := isField_stalk_of_isField hFI p
  let := hFp.toField
  have hker := IsLocalRing.ker_eq_maximalIdeal _
    ((S.componentIntersectionIdeal Z W).subschemeι.stalkMap_surjective p)
  rw [IdealSheafData.ker_stalkMap_subschemeι_eq_stalk] at hker
  obtain ⟨g, hg, hgreg⟩ := exists_stalk_eq_span_of_isEffectiveCartierDivisor
    (S.isPullbackDefined_specialFiberComponentIdeal hZW) c
  rw [← hc, hg] at hker
  have hreg : IsRegularLocalRing
      ((S.specialFiberComponentIdeal Z).subscheme.presheaf.stalk c) :=
    isRegularLocalRing_of_maximalIdeal_eq_span_of_mem_nonZeroDivisors hker.symm hgreg
  exact (smoothAt_iff_isRegularLocalRing_stalk _ c
    (isSeparableExtension_residueField_of_isRationalPoint _ c hrat)).mpr hreg

end Stacks.Models.RegularProperModelSituation
