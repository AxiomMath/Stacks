module

public import Mathlib.AlgebraicGeometry.Morphisms.Flat
public import Mathlib.AlgebraicGeometry.Pullbacks
public import Mathlib.RingTheory.Flat.TorsionFree
public import Mathlib.RingTheory.TensorProduct.Quotient
public import StacksCore.Tactic.StacksAttribute

/-!
# The local equation of a special fibre

Let `X ⟶ Spec(R)` be flat and let `π ∈ R` be a nonzerodivisor. On an affine open chart
`Spec A ⊆ X` the image of `π` is again a nonzerodivisor, because flatness makes `π` act
regularly on `A`; and the part of the closed subscheme `V(π) ⊆ Spec(R)` lying over that chart is
`Spec(A/πA)`, because `A ⊗_R R/(π) = A/πA`.

For `R` a discrete valuation ring with uniformizer `π` this says that the special fibre of a
flat model is cut out, on every affine chart, by the single nonzerodivisor `π` — the local
computation behind Tag 0C5Z part (1).

## Main results

* `Stacks.Models.map_mem_nonZeroDivisors_of_flat` — a nonzerodivisor of the base remains a
  nonzerodivisor on an affine open chart of a flat scheme.
* `Stacks.Models.quotSpanEquivTensorQuotSpan` — the base-change identification
  `A/πA ≅ A ⊗_R R/(π)`.
* `Stacks.Models.specialFiberAffineOpenIso` — the restriction of the special fibre to an affine
  chart is the spectrum of the quotient by the image of the uniformizer.
* `Stacks.Models.specialFiberAffineOpenIso_hom_fst` — that identification is compatible with the
  closed immersions of both sides into the chart.

## Implementation notes

An affine open `Spec A ⊆ X` is represented by an open immersion `j : Spec A ⟶ X` together with
the equation `hj` identifying `j ≫ f` with the morphism induced by the `R`-algebra structure on
`A`; its intersection with `V(π)` is then the corresponding fibre product. The nonzerodivisor
statement is given for an arbitrary nonzerodivisor of the base rather than specifically for a
uniformizer, since that is all the proof uses: a uniformizer of a discrete valuation ring is a
nonzerodivisor because the ring is a domain.

The Stacks source states the equality `X_k ∩ U = Spec(A/πA)` of affine schemes; here it is an
isomorphism of schemes, which is the same information in Lean.

## References

* [Stacks Project, Tag 0AUW](https://stacks.math.columbia.edu/tag/0AUW)
* [Stacks Project, Tag 0C5Z](https://stacks.math.columbia.edu/tag/0C5Z)
-/

@[expose] public section

open CategoryTheory Limits
open AlgebraicGeometry
open scoped TensorProduct

namespace Stacks.Models

universe u

/-- A nonzerodivisor of the base ring remains a nonzerodivisor on every affine open chart of a
scheme flat over that ring: flatness of `R ⟶ A` makes multiplication by `π` injective on `A`. -/
public theorem map_mem_nonZeroDivisors_of_flat
    {R A : Type u} [CommRing R] [CommRing A] [Algebra R A]
    (π : R) (hπ : π ∈ nonZeroDivisors R)
    {X : Scheme.{u}} (f : X ⟶ Spec (.of R)) [Flat f]
    (j : Spec (.of A) ⟶ X) [IsOpenImmersion j]
    (hj : j ≫ f = Spec.map (CommRingCat.ofHom (algebraMap R A))) :
    algebraMap R A π ∈ nonZeroDivisors A := by
  have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R A))) := hj ▸ inferInstance
  have hflat : RingHom.Flat (algebraMap R A) := Flat.SpecMap_iff.mp hf
  rw [RingHom.flat_algebraMap_iff] at hflat
  let _ : Module.Flat R A := hflat
  rw [mem_nonZeroDivisors_iff_left]
  intro a ha
  apply Module.Flat.isSMulRegular_of_nonZeroDivisors hπ
  simpa [Algebra.smul_def] using ha

/-- The image under `algebraMap R A` of the ideal generated by `π` is the ideal generated by the
image of `π`. -/
public theorem map_span_singleton_eq_span_singleton_algebraMap
    {R A : Type u} [CommRing R] [CommRing A] [Algebra R A] (π : R) :
    Ideal.map (algebraMap R A) (Ideal.span ({π} : Set R)) =
      Ideal.span ({algebraMap R A π} : Set A) := by
  rw [Ideal.map_span]
  exact congrArg Ideal.span Set.image_singleton

/-- The quotient of an algebra by the ideal generated by the image of `π` is the base change of
the quotient of the base by `π`: `A/πA ≅ A ⊗_R R/(π)`. -/
public noncomputable def quotSpanEquivTensorQuotSpan
    {R A : Type u} [CommRing R] [CommRing A] [Algebra R A] (π : R) :
    (A ⧸ Ideal.span ({algebraMap R A π} : Set A)) ≃+*
      A ⊗[R] (R ⧸ Ideal.span ({π} : Set R)) :=
  (Ideal.quotEquivOfEq (map_span_singleton_eq_span_singleton_algebraMap (A := A) π).symm).trans
    (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A
      (Ideal.span ({π} : Set R))).toRingEquiv

/-- On an affine open chart `Spec A ⊆ X` of a scheme over `R`, the part of the closed subscheme
`V(π) ⊆ Spec(R)` lying over the chart is the spectrum of the quotient of `A` by the image of
`π`. For a discrete valuation ring with uniformizer `π` this is the local equation of the
special fibre, `X_k ∩ Spec A = Spec(A/πA)`. -/
public noncomputable def specialFiberAffineOpenIso
    {R A : Type u} [CommRing R] [CommRing A] [Algebra R A]
    (π : R) {X : Scheme.{u}} (f : X ⟶ Spec (.of R))
    (j : Spec (.of A) ⟶ X)
    (hj : j ≫ f = Spec.map (CommRingCat.ofHom (algebraMap R A))) :
    pullback (j ≫ f)
        (Spec.map (CommRingCat.ofHom
          (Ideal.Quotient.mk (Ideal.span ({π} : Set R))))) ≅
      Spec (.of (A ⧸ Ideal.span ({algebraMap R A π} : Set A))) :=
  pullback.congrHom hj rfl ≪≫
    pullbackSpecIso R A (R ⧸ Ideal.span ({π} : Set R)) ≪≫
      Scheme.Spec.mapIso (quotSpanEquivTensorQuotSpan (R := R) (A := A) π).toCommRingCatIso.op

/-- The identification `X_k ∩ Spec A ≅ Spec(A/πA)` is compatible with the two closed
immersions into `Spec A`: composing it with `Spec(A/πA) ⟶ Spec A` gives the first projection
of the fibre product. -/
public theorem specialFiberAffineOpenIso_hom_fst
    {R A : Type u} [CommRing R] [CommRing A] [Algebra R A]
    (π : R) {X : Scheme.{u}} (f : X ⟶ Spec (.of R))
    (j : Spec (.of A) ⟶ X)
    (hj : j ≫ f = Spec.map (CommRingCat.ofHom (algebraMap R A))) :
    (specialFiberAffineOpenIso π f j hj).hom ≫ Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (Ideal.span ({algebraMap R A π} : Set A)))) =
      pullback.fst (j ≫ f) (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (Ideal.span ({π} : Set R))))) := by
  have hring : (quotSpanEquivTensorQuotSpan (R := R) (A := A) π).toRingHom.comp
        (Ideal.Quotient.mk (Ideal.span ({algebraMap R A π} : Set A))) =
      Algebra.TensorProduct.includeLeftRingHom := by
    ext a
    simp [quotSpanEquivTensorQuotSpan, Algebra.TensorProduct.includeLeftRingHom]
  have hspec :
      Spec.map (quotSpanEquivTensorQuotSpan (R := R) (A := A) π).toCommRingCatIso.hom.op.unop ≫
          Spec.map (CommRingCat.ofHom
            (Ideal.Quotient.mk (Ideal.span ({algebraMap R A π} : Set A)))) =
        Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) := by
    simpa [← Spec.map_comp, ← CommRingCat.ofHom_comp] using
      congrArg (fun φ ↦ Spec.map (CommRingCat.ofHom φ)) hring
  show (pullback.congrHom hj rfl).hom ≫
    (pullbackSpecIso R A (R ⧸ Ideal.span ({π} : Set R))).hom ≫
      Spec.map (quotSpanEquivTensorQuotSpan (R := R) (A := A) π).toCommRingCatIso.hom.op.unop ≫
        Spec.map (CommRingCat.ofHom
          (Ideal.Quotient.mk (Ideal.span ({algebraMap R A π} : Set A)))) = _
  rw [hspec, pullbackSpecIso_hom_fst]
  dsimp [pullback.congrHom, pullback.map]
  rw [pullback.lift_fst]
  simp

end Stacks.Models

end
