/-!
# Nodes are étale-local

Let `X` be a scheme locally of finite type over a field and let `g : Y ⟶ X` be étale. A point
of `Y` is a node exactly when its image in `X` is one.

Both halves of the proof are local: an étale morphism is quasi-finite, so closed points
correspond to closed points, and the stalk map of an étale morphism is flat with the maximal
ideal of the source generated by that of the target and an isomorphism on residue fields over
an algebraically closed base. The completed local rings are therefore isomorphic as algebras
over the base field, and being a node is a condition on the completed local ring.

## Main results

* `Stacks.Curves.isClosed_singleton_iff_of_etale`: closed points correspond under an étale
  morphism over a field.
* `Stacks.Curves.isNode_iff_of_etale`: nodes are étale-local.

## Implementation notes

The structure morphism of `Y` is the composite of the étale morphism with that of `X`, which is
what makes the two node conditions comparable. Closedness of the point is part of
`Stacks.Curves.IsNode`, so the two closed-point conditions of the source are carried by the node
predicates themselves rather than stated separately. The passage to an algebraic closure that
`Stacks.Curves.IsNode` performs is reproduced on both sides by base change, and the étale
morphism between the two base changes is obtained from
`AlgebraicGeometry.pullbackRightPullbackFstIso`.

## References

* [Stacks Project, Tag 0C57](https://stacks.math.columbia.edu/tag/0C57)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace Stacks.Curves

/-- A flat local homomorphism of Noetherian local algebras over a field which carries the
maximal ideal onto the maximal ideal and induces a bijection on residue fields identifies the
completions, compatibly both with the given homomorphism and with the base field. -/
private theorem exists_adicCompletionRingEquiv_of_flat
    {K A B : Type u} [Field K] [CommRing A] [CommRing B]
    [Algebra K A] [Algebra K B] [IsLocalRing A] [IsLocalRing B]
    [IsNoetherianRing A] [IsNoetherianRing B] [Algebra A B]
    [IsScalarTower K A B] [Module.Flat A B] [IsLocalHom (algebraMap A B)]
    (hfg : (IsLocalRing.maximalIdeal A).FG)
    (hmax : Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A) =
      IsLocalRing.maximalIdeal B)
    (hres : Function.Bijective ⇑(IsLocalRing.ResidueField.map (algebraMap A B))) :
    ∃ e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B,
      (∀ a, e (algebraMap A _ a) = algebraMap B _ (algebraMap A B a)) ∧
      (∀ r, e (AdicCompletion.of (IsLocalRing.maximalIdeal A) A (algebraMap K A r)) =
        AdicCompletion.of (IsLocalRing.maximalIdeal B) B (algebraMap K B r)) := by
  obtain ⟨e, he⟩ := exists_adicCompletion_ringEquiv_of_flat hfg hmax hres
  refine ⟨e, he, fun r => ?_⟩
  simpa only [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self_apply,
    IsScalarTower.algebraMap_apply K A B] using he (algebraMap K A r)

/-- **A point of the source of an étale morphism lying over a closed point is closed.** The
morphism is quasi-finite, so the point is isolated in its fibre, and the fibre over a closed
point is closed in the source. -/
theorem isClosed_singleton_of_quasiFinite_preimage
    {X Y : Scheme.{u}} (g : Y ⟶ X) [Etale g] (y : Y)
    (hx : IsClosed ({g.base y} : Set X)) : IsClosed ({y} : Set Y) := by
  have hqf : g.QuasiFiniteAt y := by
    show RingHom.QuasiFinite (g.stalkMap y).hom
    have hess := LocallyOfFiniteType.stalkMap g y
    have hform := FormallyUnramified.stalkMap g y
    algebraize [(g.stalkMap y).hom]
    let _ : Algebra.EssFiniteType (X.presheaf.stalk (g y)) (Y.presheaf.stalk y) :=
      RingHom.essFiniteType_algebraMap.mp hess
    let _ : Algebra.FormallyUnramified (X.presheaf.stalk (g y)) (Y.presheaf.stalk y) :=
      RingHom.formallyUnramified_algebraMap.mp hform
    exact RingHom.quasiFinite_algebraMap.mpr inferInstance
  have hclosedFiber : IsClosed ({g.asFiber y} : Set (g.fiber (g y))) :=
    (Scheme.Hom.QuasiFiniteAt.isClopen_singleton_asFiber g hqf).1
  have hrange : IsClosed (Set.range (g.fiberι (g y))) := by
    rw [g.range_fiberι]
    exact hx.preimage (Scheme.Hom.continuous g)
  have himage : (g.fiberι (g y)) '' {g.asFiber y} = {y} := by
    rw [Set.image_singleton, g.fiberι_asFiber]
  rw [← himage]
  exact (g.fiberι (g y)).isEmbedding.isInducing.isClosedMap hrange _ hclosedFiber

/-- **Closed points correspond under an étale morphism over a field.** One direction is
quasi-finiteness of an étale morphism; the other is that an étale morphism carries closed points
to closed points of a Jacobson space. -/
theorem isClosed_singleton_iff_of_etale
    {k : Type u} [Field k] {X Y : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f]
    (g : Y ⟶ X) [Etale g] (y : Y) :
    IsClosed ({g.base y} : Set X) ↔ IsClosed ({y} : Set Y) := by
  have : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace f
  refine ⟨isClosed_singleton_of_quasiFinite_preimage g y, fun hy => ?_⟩
  have hy' : y ∈ closedPoints Y := by simpa [closedPoints] using hy
  simpa [closedPoints] using g.closePoints_subset_preimage_closedPoints hy'

/-- **The stalk map of an étale morphism identifies the completed local rings**, compatibly with
the two structure maps from the base field. The stalk map is flat and local, carries the maximal
ideal onto the maximal ideal, and is assumed to induce a bijection on residue fields. -/
theorem exists_stalkCompletionAlgEquiv_of_etale
    {K : Type u} [Field K] {X Y : Scheme.{u}}
    (pX : X ⟶ Spec (.of K)) [LocallyOfFiniteType pX]
    (pY : Y ⟶ Spec (.of K)) [LocallyOfFiniteType pY]
    (g : Y ⟶ X) [Etale g] (y : Y)
    (kA : K →+* X.presheaf.stalk (g y))
    (kB : K →+* Y.presheaf.stalk y)
    (hk : (g.stalkMap y).hom.comp kA = kB)
    (hres : Function.Bijective ⇑(IsLocalRing.ResidueField.map (g.stalkMap y).hom)) :
    ∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk (g y)))
          (X.presheaf.stalk (g y)) ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk y))
          (Y.presheaf.stalk y),
      (∀ a, e (algebraMap (X.presheaf.stalk (g y)) _ a) =
        algebraMap (Y.presheaf.stalk y) _ ((g.stalkMap y).hom a)) ∧
      (∀ r, e (AdicCompletion.of _ _ (kA r)) = AdicCompletion.of _ _ (kB r)) := by
  let A := X.presheaf.stalk (g y)
  let B := Y.presheaf.stalk y
  let _ : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian pX
  let _ : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  let _ : Algebra K A := kA.toAlgebra
  let _ : Algebra K B := kB.toAlgebra
  let _ : Algebra A B := (g.stalkMap y).hom.toAlgebra
  have hmap : algebraMap K B = (algebraMap A B).comp (algebraMap K A) := by
    ext r
    show kB r = (g.stalkMap y).hom (kA r)
    exact (congrArg (fun f : K →+* B => f r) hk).symm
  have : IsScalarTower K A B := IsScalarTower.of_algebraMap_eq' hmap
  have : Module.Flat A B := RingHom.flat_algebraMap_iff.mpr (Flat.stalkMap g y)
  have : IsLocalHom (algebraMap A B) := inferInstanceAs (IsLocalHom (g.stalkMap y).hom)
  have hmax : Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A) =
      IsLocalRing.maximalIdeal B := by
    apply map_maximalIdeal_eq_of_etale_fibers
    intro z
    infer_instance
  obtain ⟨e, heA, heK⟩ := exists_adicCompletionRingEquiv_of_flat (K := K)
    (IsLocalRing.maximalIdeal A).fg_of_isNoetherianRing hmax hres
  exact ⟨e, fun a => by simpa only [RingHom.algebraMap_toAlgebra] using heA a, heK⟩

/-- The structure map of the base field into the local ring at a point of a scheme over that
field. -/
private def fieldStalkMap {K : Type u} [Field K] {X : Scheme.{u}}
    (p : X ⟶ Spec (.of K)) (x : X) : K →+* X.presheaf.stalk x :=
  ((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x (by simp)).hom

/-- **Over an algebraically closed field, ordinary double points correspond under an étale
morphism inducing a bijection on residue fields.** The two completed local rings are isomorphic
as algebras over the base field, and being an ordinary double point is a condition on that
algebra. -/
theorem isOrdinaryDoublePoint_iff_of_etale_over_field
    {K : Type u} [Field K] [IsAlgClosed K] {X Y : Scheme.{u}}
    (pX : X ⟶ Spec (.of K)) [LocallyOfFiniteType pX]
    (pY : Y ⟶ Spec (.of K)) [LocallyOfFiniteType pY]
    (g : Y ⟶ X) [Etale g] (hcomp : g ≫ pX = pY) (y : Y)
    (hclosed : IsClosed ({g.base y} : Set X) ↔ IsClosed ({y} : Set Y))
    (hres : Function.Bijective ⇑(IsLocalRing.ResidueField.map (g.stalkMap y).hom)) :
    letI : X.Over (Spec (.of K)) := ⟨pX⟩
    letI : Y.Over (Spec (.of K)) := ⟨pY⟩
    IsOrdinaryDoublePoint K X (g.base y) ↔ IsOrdinaryDoublePoint K Y y := by
  let A := X.presheaf.stalk (g y)
  let B := Y.presheaf.stalk y
  let kA := fieldStalkMap pX (g y)
  let kB := fieldStalkMap pY y
  have hgm : (g.stalkMap y).hom.comp (X.presheaf.germ ⊤ (g y) (by simp)).hom =
      (Y.presheaf.germ ⊤ y (by simp)).hom.comp g.appTop.hom :=
    congrArg (fun f : CommRingCat.Hom _ _ => f.hom)
      (Scheme.Hom.germ_stalkMap (f := g) (U := ⊤) (x := y) (by simp))
  have hApp : pY.appTop = pX.appTop ≫ g.appTop := by
    rw [← hcomp, Scheme.Hom.comp_appTop]
  have hk : (g.stalkMap y).hom.comp kA = kB := by
    ext r
    show (g.stalkMap y).hom ((X.presheaf.germ ⊤ (g y) (by simp)).hom
        ((pX.appTop).hom ((Scheme.ΓSpecIso (.of K)).inv.hom r))) =
      (Y.presheaf.germ ⊤ y (by simp)).hom
        ((pY.appTop).hom ((Scheme.ΓSpecIso (.of K)).inv.hom r))
    calc
      _ = ((Y.presheaf.germ ⊤ y (by simp)).hom.comp g.appTop.hom)
          ((pX.appTop).hom ((Scheme.ΓSpecIso (.of K)).inv.hom r)) :=
        congrArg (fun f => f ((pX.appTop).hom ((Scheme.ΓSpecIso (.of K)).inv.hom r))) hgm
      _ = (Y.presheaf.germ ⊤ y (by simp)).hom
          ((pY.appTop).hom ((Scheme.ΓSpecIso (.of K)).inv.hom r)) := by
        have hv : (pY.appTop).hom ((Scheme.ΓSpecIso (.of K)).inv.hom r) =
            (g.appTop).hom ((pX.appTop).hom ((Scheme.ΓSpecIso (.of K)).inv.hom r)) := by
          simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using
            congrArg (fun f : CommRingCat.Hom _ _ => f.hom
              ((Scheme.ΓSpecIso (.of K)).inv.hom r)) hApp
        exact (congrArg (Y.presheaf.germ ⊤ y (by simp)).hom hv).symm
  obtain ⟨er, her, herK⟩ := exists_stalkCompletionAlgEquiv_of_etale pX pY g y kA kB hk hres
  let _ : Algebra K A := kA.toAlgebra
  let _ : Algebra K B := kB.toAlgebra
  let erK : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃ₐ[K]
      AdicCompletion (IsLocalRing.maximalIdeal B) B :=
    AlgEquiv.ofRingEquiv (f := er) fun r => by
      simpa only [AdicCompletion.algebraMap_apply, RingHom.algebraMap_toAlgebra] using herK r
  let _ : X.Over (Spec (.of K)) := ⟨pX⟩
  let _ : Y.Over (Spec (.of K)) := ⟨pY⟩
  let _ : Algebra K (multicross K 2) := multicrossAlgebra K 2
  have hiff : Nonempty (AdicCompletion (IsLocalRing.maximalIdeal A) A ≃ₐ[K] multicross K 2) ↔
      Nonempty (AdicCompletion (IsLocalRing.maximalIdeal B) B ≃ₐ[K] multicross K 2) :=
    ⟨fun ⟨e⟩ => ⟨erK.symm.trans e⟩, fun ⟨e⟩ => ⟨erK.trans e⟩⟩
  exact and_congr hclosed hiff

/-- **Over an algebraically closed field, an étale morphism induces a bijection on the residue
fields at a point lying over a closed point.** The residue field below is the base field, which
is algebraically closed, and the extension above is finite. -/
theorem residueFieldMap_bijective_of_etale_closed
    {K : Type u} [Field K] [IsAlgClosed K] {X Y : Scheme.{u}}
    (pX : X ⟶ Spec (.of K)) [LocallyOfFiniteType pX]
    (pY : Y ⟶ Spec (.of K)) [LocallyOfFiniteType pY]
    (g : Y ⟶ X) [Etale g] (y : Y)
    (hx : IsClosed ({g.base y} : Set X)) :
    Function.Bijective ⇑(IsLocalRing.ResidueField.map (g.stalkMap y).hom) := by
  let _ : Algebra (X.residueField (g y)) (Y.residueField y) :=
    (g.residueFieldMap y).hom.toAlgebra
  have hfinite : Module.Finite (X.residueField (g y)) (Y.residueField y) :=
    finite_residueField_of_etale_fibers g (fun _ => inferInstance) y
  have : IsAlgClosed (IsLocalRing.ResidueField (X.presheaf.stalk (g y))) :=
    .of_ringEquiv K _ (residueFieldIsoBase pX (g y) hx).commRingCatIsoToRingEquiv.symm
  have hmapFinite : (IsLocalRing.ResidueField.map (g.stalkMap y).hom).Finite := hfinite
  exact IsAlgClosed.ringHom_bijective_of_isIntegral
    (IsLocalRing.ResidueField.map (g.stalkMap y).hom)
    (RingHom.IsIntegral.of_finite hmapFinite)

/-- **Stacks Project, Tag 0C57.** For an étale morphism `g : Y ⟶ X` of schemes over a field with
`X` of dimension one and locally of finite type, a point of `Y` is a node exactly when its image
in `X` is a node. -/
@[stacks 0C57]
theorem isNode_iff_of_etale
    (k : Type u) [Field k]
    (X Y : Scheme.{u}) (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f]
    (_hdim : topologicalKrullDim X = 1)
    (g : Y ⟶ X) [Etale g] (y : Y) :
    letI : X.Over (Spec (.of k)) := ⟨f⟩
    letI : Y.Over (Spec (.of k)) := ⟨g ≫ f⟩
    IsNode k X (g.base y) ↔ IsNode k Y y := by
  let _ : X.Over (Spec (.of k)) := ⟨f⟩
  let _ : Y.Over (Spec (.of k)) := ⟨g ≫ f⟩
  let K := AlgebraicClosure k
  let s : Spec (.of K) ⟶ Spec (.of k) := Spec.map (CommRingCat.ofHom (algebraMap k K))
  let Xbar : Scheme := pullback f s
  let Ybar : Scheme := pullback (g ≫ f) s
  let xproj : Xbar ⟶ X := pullback.fst f s
  let pXbar : Xbar ⟶ Spec (.of K) := pullback.snd f s
  let pYbar : Ybar ⟶ Spec (.of K) := pullback.snd (g ≫ f) s
  let e : pullback g xproj ≅ Ybar := pullbackRightPullbackFstIso f s g
  let q : Ybar ⟶ Xbar := e.inv ≫ pullback.snd g xproj
  let _ : IsAlgClosed K := inferInstance
  let _ : Xbar.Over (Spec (.of K)) := ⟨pXbar⟩
  let _ : Ybar.Over (Spec (.of K)) := ⟨pYbar⟩
  have hcomp : q ≫ pXbar = pYbar := by
    dsimp [q, pXbar, pYbar, e, Xbar, Ybar]
    exact pullbackRightPullbackFstIso_inv_snd_snd f s g
  have hxcomp : q ≫ xproj = pullback.fst (g ≫ f) s ≫ g := by
    dsimp [q, xproj, e, Xbar, Ybar]
    exact pullbackRightPullbackFstIso_inv_snd_fst f s g
  let _ : LocallyOfFiniteType pXbar := by dsimp [pXbar, Xbar]; infer_instance
  let _ : LocallyOfFiniteType pYbar := by dsimp [pYbar, Ybar]; infer_instance
  let _ : Etale q := by dsimp [q, e, xproj, Xbar, Ybar]; infer_instance
  have hclosed := isClosed_singleton_iff_of_etale f g y
  show (IsClosed ({g.base y} : Set X) ∧
      ∃ xb : Xbar, xproj.base xb = g.base y ∧ IsOrdinaryDoublePoint K Xbar xb) ↔
    (IsClosed ({y} : Set Y) ∧
      ∃ yb : Ybar, (pullback.fst (g ≫ f) s).base yb = y ∧ IsOrdinaryDoublePoint K Ybar yb)
  have hpt : ∀ yb : Ybar, IsClosed ({q.base yb} : Set Xbar) →
      (IsOrdinaryDoublePoint K Xbar (q.base yb) ↔ IsOrdinaryDoublePoint K Ybar yb) := fun yb hx =>
    isOrdinaryDoublePoint_iff_of_etale_over_field pXbar pYbar q hcomp yb
      (isClosed_singleton_iff_of_etale pXbar q yb)
      (residueFieldMap_bijective_of_etale_closed pXbar pYbar q yb hx)
  constructor
  · rintro ⟨hx, xb, hxb, hnode⟩
    have hy : IsClosed ({y} : Set Y) := hclosed.mp hx
    obtain ⟨z, hzy, hzx⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := g) (g := xproj) y xb hxb.symm
    let yb : Ybar := e.hom z
    have hproj : (pullback.fst (g ≫ f) s).base yb = y := by
      show (pullback.fst (g ≫ f) s) (e.hom z) = y
      rw [← Scheme.Hom.comp_apply, pullbackRightPullbackFstIso_hom_fst]
      exact hzy
    have hq : q.base yb = xb := by
      dsimp [yb, q]
      simp [hzx]
    have hxGeom : IsClosed ({q.base yb} : Set Xbar) := by
      simpa [hq] using hnode.1
    exact ⟨hy, yb, hproj, (hpt yb hxGeom).mp (by simpa [hq] using hnode)⟩
  · rintro ⟨hy, yb, hyb, hnode⟩
    let xb : Xbar := q.base yb
    have hxb : xproj.base xb = g.base y := by
      have h := congrArg (fun t : Scheme.Hom Ybar X => t.base yb) hxcomp
      simpa [Scheme.Hom.comp_base, hyb] using h
    exact ⟨hclosed.mpr hy, xb, hxb,
      (hpt yb ((isClosed_singleton_iff_of_etale pXbar q yb).mpr hnode.1)).mpr hnode⟩

end Stacks.Curves

