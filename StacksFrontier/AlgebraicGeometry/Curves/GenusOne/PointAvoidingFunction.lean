/-!
# A point of a genus-one curve at which no function on an open subcurve vanishes alone

Let `X` be a smooth proper curve of genus one over an uncountable algebraically closed field `k`
and let `U ⊆ X` be an open subset with finite complement. Then there is a closed point `x ∈ U`
such that no regular function on `U` vanishes on `U` exactly at `x`.

This is the choice of the point `y` in the construction of Stacks 0D5E: the source chooses `y` on
the central fibre `Y₀` with `𝒪_{Y₀}(n y)` outside the image of `Pic(Y) → Pic(Y₀)` for every
`n > 0`, using that `Pic` of the rational surface `Y` is countable, that `Y₀(k)` is uncountable and
that `Y₀(k) → Pic(Y₀)` is injective in genus `≥ 1`. Here the countable subgroup is the one
generated by the classes `[𝒪_X(p)]` of the finitely many points `p ∉ U`: if a function `a` on `U`
vanishes on `U` exactly at `x`, then `n [𝒪_X(x)]` lies in that subgroup for some `n ≥ 1`
(`AlgebraicGeometry.IsCurve.exists_nsmul_pointPicardClass_mem_closure`). For every `n ≥ 1` and
every class `c` only finitely many points `x` have `n [𝒪_X(x)] = c`, because `Pic(X)[n]` is finite
(`Stacks.Picard.finite_setOf_nsmul_eq_zero_of_isCurve`) and `x ↦ [𝒪_X(x)]` is injective in genus
one (`AlgebraicGeometry.IsCurve.eq_of_pointPicardClass_eq`). So the bad points are countable, and
`U` has uncountably many closed points.

## Main results

* `Stacks.Curves.exists_mem_forall_nsmul_notMem`: the counting argument, for an injective map
  from an uncountable set into an abelian group with finite `n`-torsion for every `n ≥ 1`.
* `Stacks.Curves.countable_addSubgroupClosure`: a countable subset generates a countable
  subgroup.
* `AlgebraicGeometry.IsCurve.exists_isClosed_forall_basicOpen_ne`: the statement above.

## References

* [Stacks Project, Tag 0D5E](https://stacks.math.columbia.edu/tag/0D5E)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace

universe u

namespace Stacks.Curves

/-- **The counting argument of Stacks 0D5E.** Let `cls : ι → P` be injective on an uncountable
set `S`, with values in an abelian group whose `n`-torsion is finite for every `n ≥ 1`, and let
`Γ ⊆ P` be countable. Then some `x ∈ S` has `n • cls x ∉ Γ` for every `n ≥ 1`. -/
theorem exists_mem_forall_nsmul_notMem {ι P : Type*} [AddCommGroup P] {S : Set ι} (cls : ι → P)
    (hinj : Set.InjOn cls S) (htors : ∀ n : ℕ, 0 < n → {c : P | n • c = 0}.Finite) {Γ : Set P}
    (hΓ : Γ.Countable) (hS : ¬ S.Countable) : ∃ x ∈ S, ∀ n : ℕ, 0 < n → n • cls x ∉ Γ := by
  by_contra! hcon
  apply hS
  have hsub : S ⊆ ⋃ n : ℕ, ⋃ γ ∈ Γ, {x | x ∈ S ∧ (n + 1) • cls x = γ} := by
    intro x hx
    obtain ⟨n, hn, hmem⟩ := hcon x hx
    obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_lt hn
    simp only [Set.mem_iUnion, Set.mem_ofPred_eq]
    exact ⟨m, _, hmem, hx, by rw [zero_add]⟩
  refine Set.Countable.mono hsub (Set.countable_iUnion fun n => hΓ.biUnion fun γ _ => ?_)
  refine Set.Finite.countable ?_
  set T := {x | x ∈ S ∧ (n + 1) • cls x = γ}
  rcases T.eq_empty_or_nonempty with hT | ⟨x₀, hx₀⟩
  · rw [hT]
    exact Set.finite_empty
  refine Set.Finite.of_finite_image ?_ (hinj.mono fun x hx => hx.1)
  refine ((htors (n + 1) n.succ_pos).image (· + cls x₀)).subset ?_
  rintro _ ⟨x, hx, rfl⟩
  refine ⟨cls x - cls x₀, ?_, sub_add_cancel _ _⟩
  rw [Set.mem_ofPred_eq, nsmul_sub, hx.2, hx₀.2, sub_self]

/-- A countable subset of an abelian group generates a countable subgroup. -/
theorem countable_addSubgroupClosure {P : Type*} [AddCommGroup P] {s : Set P}
    (hs : s.Countable) : (AddSubgroup.closure s : Set P).Countable := by
  have : Countable s := hs.to_subtype
  refine (Set.countable_range (fun a : s →₀ ℤ => a.sum fun i n => n • (i : P))).mono ?_
  intro x hx
  rw [SetLike.mem_coe, ← Subtype.range_coe (s := s)] at hx
  obtain ⟨a, rfl⟩ := AddSubgroup.mem_closure_range_iff.mp hx
  exact ⟨a, rfl⟩

end Stacks.Curves

namespace AlgebraicGeometry.IsCurve

variable (k : Type u) [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsCurve k f] [Smooth f]

/-- **A point of a genus-one curve avoided by the functions of an open subcurve.** Let `X` be a
smooth proper curve of genus one over an algebraically closed field `k`, and `U ⊆ X` an open
subset with finite complement containing uncountably many closed points (which holds as soon as
`k` is uncountable). Then there is a closed point `x ∈ U` such that no regular function on `U`
vanishes on `U` exactly at `x`. -/
theorem exists_isClosed_forall_basicOpen_ne [IsAlgClosed k] [IsProper f] (hg : genus f = 1)
    (U : X.Opens) (hUc : ((U : Set X)ᶜ).Finite)
    (hunc : ¬ {x : X | x ∈ U ∧ IsClosed ({x} : Set X)}.Countable) :
    ∃ x ∈ U, IsClosed ({x} : Set X) ∧
      ∀ a : Γ(X, U), (X.basicOpen a : Set X) ≠ (U : Set X) \ {x} := by
  classical
  set S := {x : X | x ∈ U ∧ IsClosed ({x} : Set X)}
  let cls : X → Stacks.Picard.ofScheme X := fun x =>
    if h : IsClosed ({x} : Set X) then pointPicardClass k f h else 0
  have hcls : ∀ x (h : IsClosed ({x} : Set X)), cls x = pointPicardClass k f h := fun x h => by
    simp only [cls, h, ↓reduceDIte]
  have hinj : Set.InjOn cls S := fun x hx y hy hxy => by
    rw [hcls x hx.2, hcls y hy.2] at hxy
    exact eq_of_pointPicardClass_eq k f hg hx.2 hy.2 hxy
  set gens := {c | ∃ (p : X) (hp : IsClosed ({p} : Set X)), p ∉ U ∧ c = pointPicardClass k f hp}
  have hgens : gens.Countable := by
    refine ((hUc.image cls).countable).mono ?_
    rintro _ ⟨p, hp, hpU, rfl⟩
    exact ⟨p, hpU, hcls p hp⟩
  obtain ⟨x, hxS, hx⟩ := Stacks.Curves.exists_mem_forall_nsmul_notMem cls hinj
    (fun n hn => Stacks.Picard.finite_setOf_nsmul_eq_zero_of_isCurve f n hn)
    (Stacks.Curves.countable_addSubgroupClosure hgens) hunc
  refine ⟨x, hxS.1, hxS.2, fun a ha => ?_⟩
  obtain ⟨n, hn, hmem⟩ := exists_nsmul_pointPicardClass_mem_closure k f U hxS.1 hxS.2 a ha
  exact hx n hn (by rw [hcls x hxS.2]; exact hmem)

end AlgebraicGeometry.IsCurve

end
