module

public import StacksFrontier.AlgebraicGeometry.Blowup.ProjBaseChangeGlobal
public import StacksFrontier.AlgebraicGeometry.Limits.ProjGradedSurjection01N0
public import StacksFrontier.AlgebraicGeometry.Stacks.WeierstrassFamily

/-!
# A graded presentation by a Weierstrass cubic gives an isomorphism of projective spectra

Let `A` be a graded ring which is a `k`-algebra with `k` in degree zero, and let
`φ : k[x, y, z] → A` be a surjective `k`-algebra map sending the three variables to degree one,
whose kernel is generated by the homogeneous Weierstrass polynomial of a Weierstrass curve `C`.
Then `φ` induces an isomorphism of graded rings from the homogeneous coordinate ring of the plane
cubic of `C` onto `A`, and hence an isomorphism of `Proj A` with the plane cubic.

## Main definitions

* `AlgebraicGeometry.GenusOne.weierstrassGradedHom`: the graded ring map
  `k[x, y, z]/(F) → A` induced by `φ`.
* `AlgebraicGeometry.GenusOne.weierstrassGradedInv`: its graded inverse.

## Main results

* `AlgebraicGeometry.GenusOne.aeval_mem_of_isHomogeneous`: `φ` carries homogeneous polynomials of
  degree `n` into degree `n`.
* `AlgebraicGeometry.GenusOne.isIso_map_weierstrassGradedHom`: the induced morphism
  `Proj A ⟶ Proj (k[x, y, z]/(F))` is an isomorphism.
-/

@[expose] public noncomputable section

open CategoryTheory HomogeneousIdeal MvPolynomial
open AlgebraicGeometry.ModuliEllipticCurves.Weierstrass

universe u

namespace AlgebraicGeometry.GenusOne

attribute [local instance] MvPolynomial.gradedAlgebra

variable {k : Type u} [Field k] {A : Type u} [CommRing A] [Algebra k A]
  (ℬ : ℕ → AddSubgroup A) [GradedRing ℬ]

/-- **A `k`-algebra map sending the variables to degree one, and `k` to degree zero, carries a
homogeneous polynomial of degree `n` to degree `n`.** -/
theorem aeval_mem_of_isHomogeneous (hk : ∀ c : k, algebraMap k A c ∈ ℬ 0) {v : Fin 3 → A}
    (hv : ∀ i, v i ∈ ℬ 1) {n : ℕ} {p : MvPolynomial (Fin 3) k} (hp : p.IsHomogeneous n) :
    aeval v p ∈ ℬ n := by
  classical
  rw [p.as_sum, map_sum]
  refine AddSubgroup.sum_mem _ fun s hs => ?_
  rw [aeval_monomial]
  have hdeg : n = 0 + ∑ i ∈ s.support, s i * 1 := by
    rw [zero_add, ← hp (mem_support_iff.mp hs), Finsupp.weight_apply]
    simp [Finsupp.sum]
  rw [hdeg]
  refine SetLike.GradedMul.mul_mem (hk _) ?_
  rw [Finsupp.prod]
  exact SetLike.prod_mem_graded ℬ (fun i => s i * 1) (fun i => v i ^ s i)
    fun i _ => SetLike.pow_mem_graded _ (hv i)

variable (C : WeierstrassCurve k) (φ : MvPolynomial (Fin 3) k →ₐ[k] A)
  (hker : RingHom.ker φ = Ideal.span {C.toProjective.polynomial})

include hker in
/-- **The ideal generated by the Weierstrass cubic `F` of `C` lies in the kernel of `φ`.** -/
theorem le_ker_weierstrass : (cubicIdealOf C).toIdeal ≤ RingHom.ker φ := by
  rw [hker]
  exact le_rfl

/-- **The ring map `k[x, y, z]/(F) → A` induced by `φ`.** -/
def weierstrassRingHom : coordRingOf C →+* A :=
  Ideal.Quotient.lift _ φ.toRingHom fun a ha => le_ker_weierstrass C φ hker ha

/-- **The map `weierstrassRingHom` sends the class of a polynomial `a` to `φ a`.** -/
@[simp] theorem weierstrassRingHom_mk (a : MvPolynomial (Fin 3) k) :
    weierstrassRingHom C φ hker (Ideal.Quotient.mk _ a) = φ a := rfl

include hker in
/-- **If `φ` is surjective, the induced map `k[x, y, z]/(F) → A` is bijective.** -/
theorem bijective_weierstrassRingHom (hsurj : Function.Surjective φ) :
    Function.Bijective (weierstrassRingHom C φ hker) := by
  refine ⟨fun a b hab => ?_, fun b => ?_⟩
  · obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [weierstrassRingHom_mk, weierstrassRingHom_mk] at hab
    rw [Ideal.Quotient.eq]
    exact hker.le (by rw [RingHom.mem_ker, map_sub, hab, sub_self])
  · obtain ⟨a, rfl⟩ := hsurj b
    exact ⟨Ideal.Quotient.mk _ a, rfl⟩

/-- **The graded ring map `k[x, y, z]/(F) → A`.** -/
def weierstrassGradedHom (hk : ∀ c : k, algebraMap k A c ∈ ℬ 0)
    (hv : ∀ i, φ (X i) ∈ ℬ 1) : gradingOf C →+*ᵍ ℬ where
  __ := weierstrassRingHom C φ hker
  map_mem {i x} hx := by
    obtain ⟨a, ha, rfl⟩ := hx
    change φ a ∈ ℬ i
    have hφ : φ = aeval fun j => φ (X j) := by ext j; simp
    rw [hφ]
    exact aeval_mem_of_isHomogeneous ℬ hk hv ((mem_homogeneousSubmodule _ _).mp ha)

/-- **The graded inverse.** -/
def weierstrassGradedInv (hk : ∀ c : k, algebraMap k A c ∈ ℬ 0)
    (hv : ∀ i, φ (X i) ∈ ℬ 1) (hsurj : Function.Surjective φ) : ℬ →+*ᵍ gradingOf C where
  __ := (RingEquiv.ofBijective _ (bijective_weierstrassRingHom C φ hker hsurj)).symm.toRingHom
  map_mem {i b} hb := by
    obtain ⟨a, ha⟩ := Proj.gradedAddHom_surjective_of_surjective
      (weierstrassGradedHom ℬ C φ hker hk hv) (bijective_weierstrassRingHom C φ hker hsurj).2 i
      ⟨b, hb⟩
    have hab : weierstrassRingHom C φ hker (a : coordRingOf C) = b := congrArg Subtype.val ha
    change (RingEquiv.ofBijective _ (bijective_weierstrassRingHom C φ hker hsurj)).symm b ∈ _
    rw [← hab]
    change (RingEquiv.ofBijective _ (bijective_weierstrassRingHom C φ hker hsurj)).symm
      ((RingEquiv.ofBijective _ (bijective_weierstrassRingHom C φ hker hsurj)) a) ∈ _
    rw [RingEquiv.symm_apply_apply]
    exact a.2

/-- **The induced morphism `Proj A ⟶ Proj (k[x, y, z]/(F))` is an isomorphism.** -/
theorem isIso_map_weierstrassGradedHom (hk : ∀ c : k, algebraMap k A c ∈ ℬ 0)
    (hv : ∀ i, φ (X i) ∈ ℬ 1) (hsurj : Function.Surjective φ) :
    IsIso (Proj.map (weierstrassGradedHom ℬ C φ hker hk hv)
      (Proj.irrelevant_le_map_of_surjective _
        (bijective_weierstrassRingHom C φ hker hsurj).2)) := by
  set e := RingEquiv.ofBijective _ (bijective_weierstrassRingHom C φ hker hsurj)
  refine Proj.isIso_map _ (g := weierstrassGradedInv ℬ C φ hker hk hv hsurj)
    (Proj.irrelevant_le_map_of_surjective _ e.symm.surjective) ?_ ?_
  · ext a
    exact e.symm_apply_apply a
  · ext b
    exact e.apply_symm_apply b

end AlgebraicGeometry.GenusOne

end
