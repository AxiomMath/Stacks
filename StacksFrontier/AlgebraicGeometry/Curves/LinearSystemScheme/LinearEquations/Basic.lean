module

public import StacksFrontier.AlgebraicGeometry.Curves.LinearSystemScheme.LinearSubsystem
public import StacksFrontier.AlgebraicGeometry.Curves.LinearSystemScheme.LinearEquations.ChartKernel
public import StacksFrontier.AlgebraicGeometry.ProjIdealSheaf.Basic
public import StacksFrontier.AlgebraicGeometry.Variety.Projective.LinesAvoidingSubvariety
public import StacksFrontier.LinearAlgebra.SymmetricPower.DegreeOneGeneration
public import StacksCore.Tactic.StacksAttribute

/-!
# The closed subscheme of `𝐏(W)` cut out by a space of linear equations

Let `W` be a vector space over a field `k` and `E ⊆ W` a subspace. The elements of `E` are linear
forms on `𝐏(W) = Proj Sym(W)`, that is global sections of `𝒪(1)`, and the closed subscheme they
cut out is the one whose ideal sheaf is generated by them: the sum of the ideal sheaves of the
zero schemes `Z(e)`, `e ∈ E`. On the standard chart `D₊(g)` of a degree-one `g` this ideal is
generated by the fractions `e / g`.

This file proves that the closed immersion `𝐏(W / E) ⟶ 𝐏(W)` cuts out exactly that closed
subscheme: over `D₊(g)` the kernel of `Proj` of the graded surjection `Sym(W) → Sym(W / E)` is
generated by the fractions `e / g`, because the kernel of `Sym(W) → Sym(W / E)` is the ideal
generated by `E` (`Stacks.LinearSystemScheme.ker_app_projMap_basicOpen_eq_span`). For a smooth
projective curve this identifies `Stacks.LinearSystemScheme.linearEquationsSubscheme E ⊆ |D|`
with the closed subscheme of `|D|` cut out by the linear equations in `E`, which is how
[Stacks, Tag 0CCT] describes a linear system.

## Main results

* `Stacks.LinearSystemScheme.ker_linearImmersion_mkQ_ideal_basicOpen`: on `D₊(g)` the ideal of
  `𝐏(W / E)` in `𝐏(W)` is generated by the fractions `e / g`, `e ∈ E`.
* `Stacks.LinearSystemScheme.ker_linearImmersion_mkQ_eq_iSup_zeroScheme`: the ideal sheaf of
  `𝐏(W / E)` in `𝐏(W)` is the sum of the ideal sheaves of the zero schemes of the `e ∈ E`.
* `Stacks.LinearSystemScheme.linearEquationsSubscheme_eq_iSup_zeroScheme`: the same for the
  linear subsystems of `|D|`.
* `Stacks.LinearSystemScheme.isLinearSystem_iff_exists_eq_iSup_zeroScheme`: a linear system is
  exactly an integral closed subscheme of `|D|` whose ideal sheaf is generated by linear forms.

## References

* [Stacks Project, Tag 0CCT](https://stacks.math.columbia.edu/tag/0CCT)
* [Stacks Project, Tag 02OQ](https://stacks.math.columbia.edu/tag/02OQ)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace
open AlgebraicGeometry.ProjectiveSpectrum.Proj

universe u

namespace Stacks.LinearSystemScheme

-- As in `StacksFrontier/AlgebraicGeometry/ProjectiveSpace/HyperplaneIsProjectiveSpace.lean`: without
-- these the invertibility class that `AlgebraicGeometry.zeroScheme` asks for cannot be stated at
-- `twistingSheaf`, because the two descriptions of the structure sheaf of `Proj` agree only up to
-- unfolding.
attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf
attribute [local instance_reducible] ProjectiveSpectrum.top

section Linear

variable (k : Type u) [Field k] {V : Type u} [AddCommGroup V] [Module k V]

/-- The kernel of `Sym(V) → Sym(V / E)` is the ideal generated by the degree-one elements of
`E`. -/
theorem ker_gradedSymAlgMap_mkQ (E : Submodule k V) :
    RingHom.ker (SymPow.gradedSymAlgMap E.mkQ :
        SymmetricAlgebra k V →+* SymmetricAlgebra k (V ⧸ E))
      = Ideal.span (SymmetricAlgebra.ι k V '' (E : Set V)) := by
  have := Stacks.Chow.GenuineChern.ker_symAlgMap_eq_span E.mkQ E.mkQ_surjective
  rw [Submodule.ker_mkQ] at this
  exact this

/-- The linear forms in `E` are degree-one elements of `Sym(V)`. -/
theorem image_ι_subset_symmetricPower_one (E : Submodule k V) :
    SymmetricAlgebra.ι k V '' (E : Set V) ⊆ (SymPow.symmetricPower 1 k V : Set _) := by
  rintro _ ⟨v, -, rfl⟩
  exact ProjectiveSpaceOfModule.ι_mem_symmetricPower_one k V v

/-- **The ideal of `𝐏(V / E)` in `𝐏(V)` on a standard chart.** Over the standard open `D₊(g)` of
a degree-one element `g` of `Sym(V)`, the ideal sheaf of the closed immersion
`𝐏(V / E) ⟶ 𝐏(V)` is generated by the fractions `e / g`, `e ∈ E`. -/
theorem ker_linearImmersion_mkQ_ideal_basicOpen (E : Submodule k V) {g : SymmetricAlgebra k V}
    (hg : g ∈ SymPow.symmetricPower 1 k V) :
    (linearImmersion E.mkQ E.mkQ_surjective).ker.ideal
        ⟨Proj.basicOpen (fun n => SymPow.symmetricPower n k V) g,
          Proj.isAffineOpen_basicOpen _ g hg Nat.one_pos⟩ =
      Ideal.span (Set.range fun e : E =>
        Stacks.ProjectiveSpace.degreeOneChartFraction (fun n => SymPow.symmetricPower n k V) hg
          (ProjectiveSpaceOfModule.ι_mem_symmetricPower_one k V (e : V))) := by
  rw [Scheme.Hom.ker_apply]
  unfold linearImmersion
  rw [ker_app_projMap_basicOpen_eq_span (fun n => SymPow.symmetricPower n k V)
    (fun n => SymPow.symmetricPower n k (V ⧸ E)) _ _ (image_ι_subset_symmetricPower_one k E)
    (ker_gradedSymAlgMap_mkQ k E) hg]
  congr 1
  ext x
  constructor
  · rintro ⟨⟨_, ⟨v, hv, rfl⟩⟩, rfl⟩
    exact ⟨⟨v, hv⟩, rfl⟩
  · rintro ⟨⟨v, hv⟩, rfl⟩
    exact ⟨⟨_, ⟨v, hv, rfl⟩⟩, rfl⟩

variable (V) in
/-- The twisting sheaves of `𝐏(V)` are invertible. -/
theorem isInvertible_twistingSheaf_projectiveSpaceOfModule (n : ℤ) :
    AlgebraicGeometry.SheafOfModules.IsInvertible
      (AlgebraicGeometry.Proj (fun n => SymPow.symmetricPower n k V)).sheaf.obj
      (AlgebraicGeometry.Proj (fun n => SymPow.symmetricPower n k V)).ringCatSheaf.property
      (twistingSheaf (fun n => SymPow.symmetricPower n k V) n) :=
  algebraicGeometry_isInvertible_twistingSheaf (fun n => SymPow.symmetricPower n k V)
    (SymmetricAlgebra.adjoin_symmetricPower_one_eq_top k V) n

/-- **The closed subscheme of `𝐏(V)` cut out by a space `E` of linear equations is `𝐏(V / E)`.**
The ideal sheaf of the closed immersion `𝐏(V / E) ⟶ 𝐏(V)` is the ideal sheaf generated by the
linear forms in `E`: the sum, over `e ∈ E`, of the ideal sheaves of the zero schemes of the
global sections of `𝒪(1)` they define. -/
theorem ker_linearImmersion_mkQ_eq_iSup_zeroScheme (E : Submodule k V) :
    haveI := isInvertible_twistingSheaf_projectiveSpaceOfModule k V ((1 : ℕ) : ℤ)
    (linearImmersion E.mkQ E.mkQ_surjective).ker =
      ⨆ e : E, AlgebraicGeometry.zeroScheme (projectiveSpaceOfModule k V)
        (twistingSheafModule (fun n => SymPow.symmetricPower n k V) ((1 : ℕ) : ℤ))
        (degreeSection (fun n => SymPow.symmetricPower n k V) 1
          ⟨SymmetricAlgebra.ι k V e,
            ProjectiveSpaceOfModule.ι_mem_symmetricPower_one k V (e : V)⟩) := by
  have := isInvertible_twistingSheaf_projectiveSpaceOfModule k V ((1 : ℕ) : ℤ)
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top
    (fun g : SymPow.symmetricPower 1 k V => (⟨Proj.basicOpen _ (g : SymmetricAlgebra k V),
      Proj.isAffineOpen_basicOpen _ (g : SymmetricAlgebra k V) g.2 Nat.one_pos⟩ :
        (projectiveSpaceOfModule k V).affineOpens)) ?_ fun g => ?_
  · refine Proj.iSup_basicOpen_eq_top' _ (fun g : SymPow.symmetricPower 1 k V =>
      (g : SymmetricAlgebra k V)) (fun g => ⟨1, g.2⟩) ?_
    rw [show Set.range (fun g : SymPow.symmetricPower 1 k V => (g : SymmetricAlgebra k V)) =
      (SymPow.symmetricPower 1 k V : Set _) from Subtype.range_coe]
    exact SymmetricAlgebra.adjoin_symmetricPower_one_eq_top k V
  · rw [ker_linearImmersion_mkQ_ideal_basicOpen k E g.2, Scheme.IdealSheafData.ideal_iSup,
      iSup_apply, ← Set.iUnion_singleton_eq_range, Ideal.span_iUnion]
    refine iSup_congr fun e => ?_
    rw [zeroScheme_degreeSection_ideal_basicOpen_of_degree_eq
      (fun n => SymPow.symmetricPower n k V) g.2 Nat.one_pos 1 (m := 1) (by simp)
      ⟨SymmetricAlgebra.ι k V e,
        ProjectiveSpaceOfModule.ι_mem_symmetricPower_one k V (e : V)⟩
      (by rw [one_smul]; exact ProjectiveSpaceOfModule.ι_mem_symmetricPower_one k V (e : V))]
    rfl

end Linear

variable (k : Type u) [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
  [IsAlgClosed k] [IsCurve k f] [IsProjectiveVariety k f] [Smooth f]
  (D : X.IdealSheafData) [Stacks.Divisors.IsEffectiveCartierDivisor D]

omit [IsAlgClosed k] [IsCurve k f] [IsProjectiveVariety k f] [Smooth f]
  [Stacks.Divisors.IsEffectiveCartierDivisor D] in
/-- **Stacks Project, Tag 0CCT.** The closed subscheme `linearEquationsSubscheme E` of
`|D| = 𝐏(W)`, `W = H⁰(X, 𝒪_X(D))^∨`, is the closed subscheme cut out by the linear equations
`e ∈ E ⊆ W`: its ideal sheaf is generated by the global sections of `𝒪(1)` given by the elements
of `E`, the sum of the ideal sheaves of their zero schemes. On the standard chart `D₊(g)` of a
degree-one `g` it is generated by the fractions `e / g`
(`Stacks.LinearSystemScheme.ker_linearImmersion_mkQ_ideal_basicOpen`). -/
theorem linearEquationsSubscheme_eq_iSup_zeroScheme (E : Submodule k (dualSections k f D)) :
    haveI := isInvertible_twistingSheaf_projectiveSpaceOfModule k (dualSections k f D)
      ((1 : ℕ) : ℤ)
    linearEquationsSubscheme k f D E =
      ⨆ e : E, AlgebraicGeometry.zeroScheme (linearSystemScheme k f D)
        (twistingSheafModule (fun n => SymPow.symmetricPower n k (dualSections k f D))
          ((1 : ℕ) : ℤ))
        (degreeSection (fun n => SymPow.symmetricPower n k (dualSections k f D)) 1
          ⟨SymmetricAlgebra.ι k (dualSections k f D) e,
            ProjectiveSpaceOfModule.ι_mem_symmetricPower_one k (dualSections k f D)
              (e : dualSections k f D)⟩) :=
  ker_linearImmersion_mkQ_eq_iSup_zeroScheme k E

omit [IsAlgClosed k] [IsCurve k f] [IsProjectiveVariety k f] [Smooth f]
  [Stacks.Divisors.IsEffectiveCartierDivisor D] in
/-- **Stacks Project, Tag 0CCT.** A closed subscheme `L ⊆ |D|` is a linear system exactly when it
is a closed subvariety cut out by linear equations: `L` is integral, and its ideal sheaf is
generated by the global sections of `𝒪(1)` given by the elements of a subspace
`E ⊆ W = H⁰(X, 𝒪_X(D))^∨` of linear forms on `|D| = 𝐏(W)`, that is
`L = ⨆_{e ∈ E} Z(e)`. -/
@[stacks 0CCT "a linear system on X is a closed subvariety L of |D| which can be cut out by \
linear equations, the ideal sheaf of L being generated by linear forms"]
theorem isLinearSystem_iff_exists_eq_iSup_zeroScheme
    (L : (linearSystemScheme k f D).IdealSheafData) :
    haveI := isInvertible_twistingSheaf_projectiveSpaceOfModule k (dualSections k f D)
      ((1 : ℕ) : ℤ)
    IsLinearSystem k f D L ↔
      (∃ E : Submodule k (dualSections k f D),
        L = ⨆ e : E, AlgebraicGeometry.zeroScheme (linearSystemScheme k f D)
          (twistingSheafModule (fun n => SymPow.symmetricPower n k (dualSections k f D))
            ((1 : ℕ) : ℤ))
          (degreeSection (fun n => SymPow.symmetricPower n k (dualSections k f D)) 1
            ⟨SymmetricAlgebra.ι k (dualSections k f D) e,
              ProjectiveSpaceOfModule.ι_mem_symmetricPower_one k (dualSections k f D)
                (e : dualSections k f D)⟩)) ∧
        IsIntegral L.subscheme := by
  refine ⟨fun h => ⟨?_, h.isIntegral⟩, fun h => ⟨?_, h.2⟩⟩
  · obtain ⟨E, hE⟩ := h.exists_eq_linearEquationsSubscheme
    exact ⟨E, hE.trans (linearEquationsSubscheme_eq_iSup_zeroScheme k f D E)⟩
  · obtain ⟨E, hE⟩ := h.1
    exact ⟨E, hE.trans (linearEquationsSubscheme_eq_iSup_zeroScheme k f D E).symm⟩

end Stacks.LinearSystemScheme

end
