module

public import StacksFrontier.AlgebraicGeometry.ProjectiveSpace.HyperplaneIsProjectiveSpace

/-!
# The kernel of `Proj ψ` on a standard chart, for a kernel generated in degree one

Let `ψ : 𝒮 → ℬ` be a homomorphism of graded rings whose kernel is the ideal generated by a set
`L` of elements of degree one. Over the standard open `D₊(f)` of a degree-one element `f`, the
kernel of `Proj ψ` on sections is generated by the chart fractions `l / f`, `l ∈ L`. This extends
`Stacks.ProjectiveSpace.ker_app_projMap_basicOpen`, the case of a single `l`.

## Main results

* `Stacks.LinearSystemScheme.exists_sum_mul_eq_of_mem_span_degreeOne`: a homogeneous element of
  degree `D + 1` in the ideal generated by degree-one elements is a sum `∑ lᵢ cᵢ` with `lᵢ ∈ L`
  and `cᵢ` homogeneous of degree `D`.
* `Stacks.LinearSystemScheme.ker_app_projMap_basicOpen_eq_span`: the chart kernel is generated by
  the fractions `l / f`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory HomogeneousLocalization
open AlgebraicGeometry.ProjectiveSpectrum.Proj

namespace Stacks.LinearSystemScheme

universe u

variable {S B σ τ : Type u} [CommRing S] [CommRing B] [SetLike σ S] [AddSubgroupClass σ S]
  [SetLike τ B] [AddSubgroupClass τ B]
  (𝒮 : ℕ → σ) (ℬ : ℕ → τ) [GradedRing 𝒮] [GradedRing ℬ]

/-- **A homogeneous element of the ideal generated by degree-one elements is a combination of
them with homogeneous coefficients.** If `x` is homogeneous of degree `D + 1` and lies in the
ideal generated by a set `L` of degree-one elements, then `x = ∑ lᵢ cᵢ` with `lᵢ ∈ L` and each
`cᵢ` homogeneous of degree `D`. -/
theorem exists_sum_mul_eq_of_mem_span_degreeOne {L : Set S} (hL : L ⊆ 𝒮 1) {D : ℕ} {x : S}
    (hx : x ∈ 𝒮 (D + 1)) (hmem : x ∈ Ideal.span L) :
    ∃ (m : ℕ) (l c : Fin m → S), (∀ i, l i ∈ L) ∧ (∀ i, c i ∈ 𝒮 D) ∧
      ∑ i, l i * c i = x := by
  classical
  obtain ⟨m, a, g, hsum⟩ := Submodule.mem_span_set'.1 hmem
  refine ⟨m, fun i => (g i : S), fun i => (DirectSum.decompose 𝒮 (a i) D : S),
    fun i => (g i).2, fun i => (DirectSum.decompose 𝒮 (a i) D).2, ?_⟩
  calc ∑ i, (g i : S) * (DirectSum.decompose 𝒮 (a i) D : S)
      = ∑ i, (DirectSum.decompose 𝒮 (a i * (g i : S)) (D + 1) : S) := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [DirectSum.coe_decompose_mul_add_of_right_mem 𝒮 (hL (g i).2), mul_comm]
    _ = (DirectSum.decompose 𝒮 (∑ i, a i * (g i : S)) (D + 1) : S) := by
        simp [DirectSum.decompose_sum]
    _ = x := by
        rw [show ∑ i, a i * (g i : S) = x from hsum]
        exact DirectSum.decompose_of_mem_same 𝒮 hx

/-- A sum of products of the fractions `lᵢ / f` and `cᵢ / f ^ (k + n)` is `a / f ^ n` as soon as
`∑ lᵢ cᵢ = f ^ (k + 1) * a`. -/
theorem sum_awayMk_degreeOne_mul {f : S} (hf : f ∈ 𝒮 1) {k n m : ℕ} (l c : Fin m → S)
    (hl : ∀ i, l i ∈ 𝒮 (1 • 1)) (hc : ∀ i, c i ∈ 𝒮 ((k + n) • 1)) {a : S}
    (ha : a ∈ 𝒮 (n • 1)) (h : ∑ i, l i * c i = f ^ (k + 1) * a) :
    ∑ i, Away.mk 𝒮 hf 1 (l i) (hl i) * Away.mk 𝒮 hf (k + n) (c i) (hc i) =
      Away.mk 𝒮 hf n a ha := by
  apply HomogeneousLocalization.val_injective
  have hval : ∀ x : Away 𝒮 f, x.val = algebraMap (Away 𝒮 f) (Localization.Away f) x :=
    fun _ => rfl
  rw [hval, map_sum]
  simp only [← hval, HomogeneousLocalization.val_mul, Away.val_mk, Localization.mk_mul]
  rw [← Localization.mk_sum, h, Localization.mk_eq_mk_iff]
  refine Localization.r_of_eq ?_
  show f ^ n * (f ^ (k + 1) * a) = f ^ 1 * f ^ (k + n) * a
  ring

/-- **The kernel of `Proj ψ` on a standard chart, for a kernel generated in degree one.** If the
kernel of a graded homomorphism `ψ` is the ideal generated by a set `L` of degree-one elements,
then over the standard open of a degree-one element `f` the kernel of `Proj ψ` on sections is
generated by the fractions `l / f`, `l ∈ L`. -/
theorem ker_app_projMap_basicOpen_eq_span (ψ : 𝒮 →+*ᵍ ℬ)
    (hψ : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒮).map ψ)
    {L : Set S} (hL : L ⊆ 𝒮 1) (hker : RingHom.ker (ψ : S →+* B) = Ideal.span L)
    {f : S} (hf : f ∈ 𝒮 1) :
    RingHom.ker ((Proj.map ψ hψ).app (Proj.basicOpen 𝒮 f)).hom =
      Ideal.span (Set.range fun l : L =>
        Stacks.ProjectiveSpace.degreeOneChartFraction 𝒮 hf (hL l.2)) := by
  have hiso : IsIso (Proj.awayToSection 𝒮 f) :=
    Stacks.ProjQuotientChartIdeal.isIso_awayToSection hf Nat.one_pos
  have hchart : ∀ (l : S) (hl : l ∈ 𝒮 1) (hl' : l ∈ 𝒮 (1 • 1)),
      Stacks.ProjectiveSpace.degreeOneChartFraction 𝒮 hf hl =
        (Proj.awayToSection 𝒮 f).hom (Away.mk 𝒮 hf 1 l hl') := fun _ _ _ => rfl
  refine le_antisymm (fun x hx => ?_) (Ideal.span_le.mpr ?_)
  · obtain ⟨z, rfl⟩ := (ConcreteCategory.bijective_of_isIso (Proj.awayToSection 𝒮 f)).2 x
    have hz := (Stacks.ProjQuotientChartIdeal.awayToSection_mem_ker_app_projMap_iff
      ψ hψ hf Nat.one_pos z).1 hx
    obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective 𝒮 hf z
    obtain ⟨k, hk⟩ :=
      (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff ψ hf n a ha).1 hz
    rw [hker] at hk
    have hk1 : f ^ (k + 1) * a ∈ Ideal.span L := by
      have he : f ^ (k + 1) * a = f * (f ^ k * a) := by ring
      rw [he]
      exact Ideal.mul_mem_left _ _ hk
    have ha' : a ∈ 𝒮 n := by simpa using ha
    have hdeg : f ^ (k + 1) * a ∈ 𝒮 (k + n + 1) := by
      have h1 : f ^ (k + 1) ∈ 𝒮 (k + 1) := by simpa using SetLike.pow_mem_graded (k + 1) hf
      have h2 := SetLike.mul_mem_graded h1 ha'
      rwa [show k + 1 + n = k + n + 1 by omega] at h2
    obtain ⟨m, l, c, hlL, hc, hsum⟩ := exists_sum_mul_eq_of_mem_span_degreeOne 𝒮 hL hdeg hk1
    have hl' : ∀ i, l i ∈ 𝒮 (1 • 1) := fun i => by simpa using hL (hlL i)
    have hc' : ∀ i, c i ∈ 𝒮 ((k + n) • 1) := fun i => by simpa using hc i
    rw [← sum_awayMk_degreeOne_mul 𝒮 hf l c hl' hc' ha hsum, map_sum]
    refine Ideal.sum_mem _ fun i _ => ?_
    rw [map_mul, ← hchart (l i) (hL (hlL i)) (hl' i)]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨⟨l i, hlL i⟩, rfl⟩)
  · rintro _ ⟨⟨l, hl⟩, rfl⟩
    have hl' : l ∈ 𝒮 (1 • 1) := by simpa using hL hl
    show Stacks.ProjectiveSpace.degreeOneChartFraction 𝒮 hf (hL hl) ∈ _
    rw [hchart l (hL hl) hl']
    refine (Stacks.ProjQuotientChartIdeal.awayToSection_mem_ker_app_projMap_iff
      ψ hψ hf Nat.one_pos _).2 ?_
    refine (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff
      ψ hf 1 l hl').2 ⟨0, ?_⟩
    rw [pow_zero, one_mul, hker]
    exact Ideal.subset_span hl

end Stacks.LinearSystemScheme

end
