/-!
# Linear systems inside `|D|` ([Stacks, Tag 0CCT])

Let `X` be a smooth projective curve over an algebraically closed field `k` and `D ⊆ X` an
effective Cartier divisor of degree `d`, so that `|D| = 𝐏(W)` with `W = H⁰(X, 𝒪_X(D))^∨`
(`Stacks.LinearSystemScheme.linearSystemScheme`). The linear forms on `𝐏(W) = Proj Sym(W)` are
the elements of `W = Sym¹(W)`, and a subspace `E ⊆ W` of linear equations cuts out the closed
subscheme `V₊(E) = Proj(Sym(W) / (E))`. Since the kernel of `Sym(W) → Sym(W / E)` is the ideal
generated by `E` (`Stacks.LinearSystemScheme.ker_symAlgMap_mkQ`), this is the image of the closed
immersion `𝐏(W / E) ⟶ 𝐏(W)`, which is how `Stacks.LinearSystemScheme.linearEquationsSubscheme`
is defined.

## Main definitions

* `Stacks.LinearSystemScheme.linearImmersion`: the closed immersion `𝐏(V') ⟶ 𝐏(V)` induced by a
  surjection `V → V'`.
* `Stacks.LinearSystemScheme.linearEquationsSubscheme`: the closed subscheme of `|D|` cut out by a
  space of linear equations.
* `Stacks.LinearSystemScheme.IsLinearSystem`: **a linear system on `X`**, a closed subvariety of
  `|D|` which can be cut out by linear equations.
* `Stacks.LinearSystemScheme.IsLinearSystem.linearSeries`: the linear series `(𝒪_X(D), V)` of
  [Stacks, Tag 0CCN] corresponding to a linear system of dimension `r`.

## Main results

* `Stacks.LinearSystemScheme.IsLinearSystem.exists_eq_projectiveSpace`: a linear system `L` of
  dimension `r` is `𝐏(V^∨)` for a linear subspace `V ⊆ H⁰(X, 𝒪_X(D))` of dimension `r + 1`.

## References

* [Stacks Project, Tag 0CCT](https://stacks.math.columbia.edu/tag/0CCT)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace Stacks.LinearSystemScheme

section Linear

variable {k : Type u} [Field k] {V V' V'' : Type u} [AddCommGroup V] [Module k V]
  [AddCommGroup V'] [Module k V'] [AddCommGroup V''] [Module k V'']

/-- `Sym` of a surjective linear map is surjective. -/
theorem symAlgMap_surjective (g : V →ₗ[k] V') (hg : Function.Surjective g) :
    Function.Surjective (SymPow.symAlgMap g) := by
  intro y
  induction y using SymmetricAlgebra.induction with
  | algebraMap r => exact ⟨algebraMap k _ r, AlgHom.commutes _ r⟩
  | ι x =>
    obtain ⟨m, rfl⟩ := hg x
    exact ⟨SymmetricAlgebra.ι k V m, SymPow.symAlgMap_ι g m⟩
  | mul a b ha hb =>
    obtain ⟨a', rfl⟩ := ha
    obtain ⟨b', rfl⟩ := hb
    exact ⟨a' * b', map_mul _ _ _⟩
  | add a b ha hb =>
    obtain ⟨a', rfl⟩ := ha
    obtain ⟨b', rfl⟩ := hb
    exact ⟨a' + b', map_add _ _ _⟩

/-- The morphism `𝐏(V') ⟶ 𝐏(V)` induced by a surjection `g : V → V'`: `Proj` of the graded
surjection `Sym(g) : Sym(V) → Sym(V')`. -/
def linearImmersion (g : V →ₗ[k] V') (hg : Function.Surjective g) :
    projectiveSpaceOfModule k V' ⟶ projectiveSpaceOfModule k V :=
  Proj.map (SymPow.gradedSymAlgMap g)
    (Proj.irrelevant_le_map_of_surjective _ (symAlgMap_surjective g hg))

/-- The morphism `𝐏(V') ⟶ 𝐏(V)` induced by a surjection `V → V'` is a closed immersion. -/
instance isClosedImmersion_linearImmersion (g : V →ₗ[k] V') (hg : Function.Surjective g) :
    IsClosedImmersion (linearImmersion g hg) :=
  Proj.isClosedImmersion_map_of_surjective' _ (symAlgMap_surjective g hg)

/-- For surjections `g : V → V'` and `h : V' → V''`, the morphism `𝐏(V'') ⟶ 𝐏(V)` induced by
`h ∘ g` is the composite `𝐏(V'') ⟶ 𝐏(V') ⟶ 𝐏(V)` of the morphisms induced by `h` and `g`. -/
theorem linearImmersion_comp (g : V →ₗ[k] V') (hg : Function.Surjective g) (h : V' →ₗ[k] V'')
    (hh : Function.Surjective h) :
    linearImmersion (h ∘ₗ g) (hh.comp hg) = linearImmersion h hh ≫ linearImmersion g hg := by
  unfold linearImmersion
  rw [← Proj.map_comp]
  congr 1
  exact SymPow.gradedSymAlgMap_comp g h

/-- The morphism `𝐏(V) ⟶ 𝐏(V)` induced by the identity of `V` is the identity. -/
theorem linearImmersion_id :
    linearImmersion (LinearMap.id : V →ₗ[k] V) Function.surjective_id = 𝟙 _ := by
  unfold linearImmersion
  rw [← Proj.map_id]
  congr 1
  exact SymPow.gradedSymAlgMap_id

/-- The morphism `𝐏(V') ⟶ 𝐏(V)` induced by a linear isomorphism `V ≃ V'` is an isomorphism. -/
instance isIso_linearImmersion (e : V ≃ₗ[k] V') :
    IsIso (linearImmersion (e : V →ₗ[k] V') e.surjective) :=
  ⟨⟨linearImmersion (e.symm : V' →ₗ[k] V) e.symm.surjective, by
    rw [← linearImmersion_comp, ← linearImmersion_id]
    congr 1
    exact LinearMap.ext e.apply_symm_apply, by
    rw [← linearImmersion_comp, ← linearImmersion_id]
    congr 1
    exact LinearMap.ext e.symm_apply_apply⟩⟩

/-- The closed subscheme cut out by `Sym(g)` depends only on the kernel of `g`. -/
theorem ker_linearImmersion_eq (g : V →ₗ[k] V') (hg : Function.Surjective g) (E : Submodule k V)
    (hE : LinearMap.ker g = E) :
    (linearImmersion g hg).ker = (linearImmersion E.mkQ E.mkQ_surjective).ker := by
  let e : (V ⧸ E) ≃ₗ[k] V' :=
    (Submodule.quotEquivOfEq _ _ hE.symm).trans (g.quotKerEquivOfSurjective hg)
  have : linearImmersion g hg =
      linearImmersion (e : (V ⧸ E) →ₗ[k] V') e.surjective ≫
        linearImmersion E.mkQ E.mkQ_surjective := by
    rw [← linearImmersion_comp]
    congr 1
  rw [this, Scheme.Hom.ker_comp_of_isIso]

/-- The projective space of a zero module is empty, so a nonempty one has a nontrivial
module. -/
theorem nontrivial_of_nonempty_projectiveSpaceOfModule
    (x : projectiveSpaceOfModule k V) : Nontrivial V := by
  by_contra h
  rw [not_nontrivial_iff_subsingleton] at h
  refine x.not_irrelevant_le ?_
  rw [HomogeneousIdeal.irrelevant_le]
  intro i hi y hy
  have : SymPow.symmetricPower i k V = ⊥ := by
    show LinearMap.range (SymmetricAlgebra.ι k V) ^ i = ⊥
    have h0 : LinearMap.range (SymmetricAlgebra.ι k V) = ⊥ := by
      rw [eq_bot_iff]
      rintro _ ⟨v, rfl⟩
      rw [Subsingleton.elim v 0, map_zero]
      exact Submodule.zero_mem _
    rw [h0]
    obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hi.ne'
    rw [pow_succ, Submodule.mul_bot]
  rw [this] at hy
  obtain rfl : y = 0 := hy
  exact Submodule.zero_mem _

/-- The image of `𝐏(V') ⟶ 𝐏(V)` is integral when `V'` is finite dimensional and nonzero. -/
theorem isIntegral_ker_linearImmersion (g : V →ₗ[k] V') (hg : Function.Surjective g)
    [FiniteDimensional k V'] [Nontrivial V'] : IsIntegral (linearImmersion g hg).ker.subscheme := by
  have : Nonempty (projectiveSpaceOfModule k V') := by
    rw [← not_isEmpty_iff, ← topologicalKrullDim_eq_bot_iff_isEmpty]
    intro h
    have hfin := topologicalKrullDim_projectiveSpaceOfModule_add_one (k := k) (V := V')
    rw [h] at hfin
    exact WithBot.bot_ne_coe ((WithBot.bot_add _).symm.trans hfin)
  have : IsReduced (projectiveSpaceOfModule k V') :=
    ProjectiveSpaceOfModule.isReduced_projectiveSpaceOfModule k _
  have : IsIntegral (projectiveSpaceOfModule k V') :=
    isIntegral_of_irreducibleSpace_of_isReduced _
  have : Nonempty (linearImmersion g hg).ker.subscheme :=
    ⟨(linearImmersion g hg).toImage (Classical.arbitrary _)⟩
  exact isIntegral_of_isOpenImmersion (inv (linearImmersion g hg).toImage)

/-- A linear form `w` vanishes at the image of a point `p` of `𝐏(V')` in `𝐏(V)` exactly when
`g w` vanishes at `p`. -/
theorem ι_mem_linearImmersion_iff (g : V →ₗ[k] V') (hg : Function.Surjective g)
    (p : projectiveSpaceOfModule k V') (w : V) :
    SymmetricAlgebra.ι k V w ∈ ((linearImmersion g hg) p).asHomogeneousIdeal ↔
      SymmetricAlgebra.ι k V' (g w) ∈ p.asHomogeneousIdeal := by
  rw [← SymPow.symAlgMap_ι g w]
  exact Iff.rfl

/-- The image of a closed immersion is the support of its ideal sheaf. -/
theorem range_eq_support_ker {Y Z : Scheme.{u}} (i : Y ⟶ Z) [IsClosedImmersion i] :
    Set.range i = i.ker.support := by
  rw [Scheme.Hom.support_ker, i.isClosedEmbedding.isClosed_range.closure_eq]

end Linear

variable (k : Type u) [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
  [IsAlgClosed k] [IsCurve k f] [IsProjectiveVariety k f] [Smooth f]
  (D : X.IdealSheafData) [Stacks.Divisors.IsEffectiveCartierDivisor D]

omit [IsAlgClosed k] [IsCurve k f] [IsProjectiveVariety k f] [Smooth f]
  [Divisors.IsEffectiveCartierDivisor D] in
/-- The kernel of `Sym(W) → Sym(W / E)` is the ideal generated by the linear forms in `E`. -/
theorem ker_symAlgMap_mkQ (E : Submodule k (dualSections k f D)) :
    RingHom.ker (SymPow.symAlgMap E.mkQ) =
      Ideal.span (SymmetricAlgebra.ι k (dualSections k f D) '' (E : Set (dualSections k f D))) := by
  rw [Stacks.Chow.GenuineChern.ker_symAlgMap_eq_span E.mkQ E.mkQ_surjective, Submodule.ker_mkQ]

/-- The closed subscheme `V₊(E) = Proj(Sym(W) / (E))` of `|D| = 𝐏(W)` cut out by a space
`E ⊆ W = H⁰(X, 𝒪_X(D))^∨` of linear equations: the image of the closed immersion
`𝐏(W / E) ⟶ 𝐏(W)`, `Sym(W / E)` being `Sym(W) / (E)` by
`Stacks.LinearSystemScheme.ker_symAlgMap_mkQ`. -/
def linearEquationsSubscheme (E : Submodule k (dualSections k f D)) :
    (linearSystemScheme k f D).IdealSheafData :=
  (linearImmersion E.mkQ E.mkQ_surjective).ker

/-- A *linear system* (or *linear series*) on `X` is a closed subvariety `L ⊆ |D|` which can be
cut out by linear equations: `L` is the closed subscheme `V₊(E)` of a space `E` of linear forms
on `|D| = 𝐏(H⁰(X, 𝒪_X(D))^∨)`, and it is integral. -/
@[stacks 0CCT "a linear system on X is a closed subvariety L of |D| which can be cut out by \
linear equations"]
structure IsLinearSystem (L : (linearSystemScheme k f D).IdealSheafData) : Prop where
  exists_eq_linearEquationsSubscheme :
    ∃ E : Submodule k (dualSections k f D), L = linearEquationsSubscheme k f D E
  isIntegral : IsIntegral L.subscheme

omit [IsAlgClosed k] [IsCurve k f] [Smooth f] in
/-- The closed subscheme of `|D|` cut out by a proper subspace of linear equations is a linear
system; for instance `|D|` itself, cut out by no equations. -/
theorem isLinearSystem_linearEquationsSubscheme (E : Submodule k (dualSections k f D))
    (hE : E ≠ ⊤) : IsLinearSystem k f D (linearEquationsSubscheme k f D E) := by
  have : Nontrivial (dualSections k f D ⧸ E) := Submodule.Quotient.nontrivial_iff.mpr hE
  exact ⟨⟨E, rfl⟩, isIntegral_ker_linearImmersion _ _⟩

/-- The closed immersion `𝐏(V^∨) ⟶ |D| = 𝐏(H⁰(X, 𝒪_X(D))^∨)` of a linear subspace
`V ⊆ H⁰(X, 𝒪_X(D))`, induced by the restriction `H⁰(X, 𝒪_X(D))^∨ → V^∨`. -/
def subspaceImmersion
    (V : Submodule k (cohomologyOverField k f (Stacks.Divisors.modulesInvertibleSheaf D) 0)) :
    projectiveSpaceOfModule k (Module.Dual k V) ⟶ linearSystemScheme k f D :=
  linearImmersion V.subtype.dualMap (LinearMap.dualMap_surjective_of_injective V.injective_subtype)

/-- The morphism `𝐏(V^∨) ⟶ |D|` of a linear subspace `V ⊆ H⁰(X, 𝒪_X(D))` is a closed
immersion. -/
instance isClosedImmersion_subspaceImmersion
    (V : Submodule k (cohomologyOverField k f (Stacks.Divisors.modulesInvertibleSheaf D) 0)) :
    IsClosedImmersion (subspaceImmersion k f D V) :=
  isClosedImmersion_linearImmersion _ _

omit [IsAlgClosed k] [IsCurve k f] [Smooth f] in
/-- The subspace `V ⊆ H⁰(X, 𝒪_X(D))` is determined by the closed subscheme `𝐏(V^∨)` of `|D|`. -/
theorem eq_of_ker_subspaceImmersion_eq
    {V₁ V₂ : Submodule k (cohomologyOverField k f (Stacks.Divisors.modulesInvertibleSheaf D) 0)}
    (h : (subspaceImmersion k f D V₁).ker = (subspaceImmersion k f D V₂).ker) : V₁ = V₂ := by
  suffices H : ∀ {V₁ V₂ : Submodule k
      (cohomologyOverField k f (Stacks.Divisors.modulesInvertibleSheaf D) 0)},
      (subspaceImmersion k f D V₁).ker = (subspaceImmersion k f D V₂).ker → V₁ ≤ V₂ from
    le_antisymm (H h) (H h.symm)
  intro V₁ V₂ h v hv
  by_contra hv₂
  obtain ⟨χ, hχv, hχ⟩ := Submodule.exists_dual_map_eq_bot_of_notMem hv₂ inferInstance
  let ev : Module.Dual k (Module.Dual k V₁) := Module.Dual.eval k V₁ ⟨v, hv⟩
  have hev : ev (V₁.subtype.dualMap χ) ≠ 0 := hχv
  have hev0 : ev ≠ 0 := fun h0 => hev (by rw [h0, LinearMap.zero_apply])
  let p := ProjectiveSpaceOfModule.linearFunctionalPoint k (Module.Dual k V₁) ev hev0
  obtain ⟨p', hp'⟩ : (subspaceImmersion k f D V₁) p ∈ Set.range (subspaceImmersion k f D V₂) := by
    rw [range_eq_support_ker, ← h, ← range_eq_support_ker]
    exact ⟨p, rfl⟩
  have h₁ : SymmetricAlgebra.ι k (dualSections k f D) χ ∉
      ((subspaceImmersion k f D V₁) p).asHomogeneousIdeal := by
    unfold subspaceImmersion
    rwa [ι_mem_linearImmersion_iff, ProjectiveSpaceOfModule.linearFunctionalPoint_ι_mem]
  have h₂ : SymmetricAlgebra.ι k (dualSections k f D) χ ∈
      ((subspaceImmersion k f D V₂) p').asHomogeneousIdeal := by
    unfold subspaceImmersion
    rw [ι_mem_linearImmersion_iff]
    have : V₂.subtype.dualMap χ = 0 := by
      ext ⟨w, hw⟩
      have : χ w ∈ V₂.map χ := Submodule.mem_map_of_mem hw
      rwa [hχ, Submodule.mem_bot] at this
    rw [this, map_zero]
    exact Submodule.zero_mem _
  exact h₁ (hp' ▸ h₂)

/-- If a linear system `L ⊆ |D|` has dimension `r`, then `L = 𝐏(V^∨)` for a linear subspace
`V ⊆ H⁰(X, 𝒪_X(D))` of dimension `r + 1`: `L` is the image of the closed immersion
`𝐏(V^∨) ⟶ 𝐏(H⁰(X, 𝒪_X(D))^∨)` induced by `V ⊆ H⁰(X, 𝒪_X(D))`, and it is isomorphic to
`𝐏(V^∨)` through that immersion. The subspace `V` is determined by `L`. -/
@[stacks 0CCT "if L has dimension r, then L = P(V^dual) where V is a linear subspace of \
H^0(X, O_X(D)) of dimension r + 1"]
theorem IsLinearSystem.exists_eq_projectiveSpace {L : (linearSystemScheme k f D).IdealSheafData}
    (hL : IsLinearSystem k f D L) {r : ℕ} (hr : topologicalKrullDim L.subscheme = r) :
    ∃ (V : Submodule k (cohomologyOverField k f (Stacks.Divisors.modulesInvertibleSheaf D) 0))
      (_ : Module.finrank k V = r + 1),
      L = (subspaceImmersion k f D V).ker ∧
        (∀ V' : Submodule k
            (cohomologyOverField k f (Stacks.Divisors.modulesInvertibleSheaf D) 0),
          L = (subspaceImmersion k f D V').ker → V' = V) ∧
        ∃ φ : L.subscheme ≅ projectiveSpaceOfModule k (Module.Dual k V),
          φ.inv ≫ L.subschemeι = subspaceImmersion k f D V := by
  obtain ⟨E, rfl⟩ := hL.exists_eq_linearEquationsSubscheme
  set V := E.dualCoannihilator
  have hker : LinearMap.ker V.subtype.dualMap = E := by
    rw [LinearMap.ker_dualMap_eq_dualAnnihilator_range, Submodule.range_subtype,
      Subspace.dualCoannihilator_dualAnnihilator_eq]
  have hEV : linearEquationsSubscheme k f D E = (subspaceImmersion k f D V).ker :=
    (ker_linearImmersion_eq _ _ E hker).symm
  rw [hEV] at hr ⊢
  let φ : (subspaceImmersion k f D V).ker.subscheme ≅
      projectiveSpaceOfModule k (Module.Dual k V) :=
    (asIso (subspaceImmersion k f D V).toImage).symm
  have hdim : topologicalKrullDim (projectiveSpaceOfModule k (Module.Dual k V)) = r := by
    rwa [← IsHomeomorph.topologicalKrullDim_eq _ φ.inv.homeomorph.isHomeomorph] at hr
  have : Nonempty (projectiveSpaceOfModule k (Module.Dual k V)) :=
    not_isEmpty_iff.mp fun h => WithBot.bot_ne_coe
      (((topologicalKrullDim_eq_bot_iff_isEmpty _).mpr h).symm.trans hdim)
  have := nontrivial_of_nonempty_projectiveSpaceOfModule this.some
  have hfin := topologicalKrullDim_projectiveSpaceOfModule_add_one (k := k) (V := Module.Dual k V)
  rw [hdim, Subspace.dual_finrank_eq] at hfin
  refine ⟨V, ?_, rfl, fun V' hV' => eq_of_ker_subspaceImmersion_eq k f D hV'.symm, φ, ?_⟩
  · have : ((r + 1 : ℕ) : WithBot ℕ∞) = (Module.finrank k V : WithBot ℕ∞) := by
      rw [← hfin]
      rfl
    exact_mod_cast this.symm
  · exact (subspaceImmersion k f D V).toImage_imageι

/-- The linear series `(𝒪_X(D), V)` of [Stacks, Tag 0CCN] corresponding to a linear system
`L ⊆ |D|` of dimension `r`, with `L = 𝐏(V^∨)` as in
`Stacks.LinearSystemScheme.IsLinearSystem.exists_eq_projectiveSpace`. -/
@[stacks 0CCT "the classical linear series L in |D| corresponds to the linear series \
(O_X(D), V)"]
def IsLinearSystem.linearSeries {L : (linearSystemScheme k f D).IdealSheafData}
    (hL : IsLinearSystem k f D L) {r : ℕ} (hr : topologicalKrullDim L.subscheme = r) {d : ℕ}
    (hd : invertibleCurveDegree k f (topologicalKrullDim_le_one k f)
      (Stacks.Divisors.modulesInvertibleSheaf D) = d) :
    LinearSeries k f (topologicalKrullDim_le_one k f) d r :=
  Stacks.Divisors.linearSeriesOfDivisor k f _ D hd
    (hL.exists_eq_projectiveSpace k f D hr).choose
    (hL.exists_eq_projectiveSpace k f D hr).choose_spec.choose

/-- The linear series of a linear system `L ⊆ |D|` has invertible sheaf `𝒪_X(D)`, and `L` is
the image of `𝐏(V^∨) ⟶ |D|` for its space of sections `V`. -/
theorem IsLinearSystem.linearSeries_spec {L : (linearSystemScheme k f D).IdealSheafData}
    (hL : IsLinearSystem k f D L) {r : ℕ} (hr : topologicalKrullDim L.subscheme = r) {d : ℕ}
    (hd : invertibleCurveDegree k f (topologicalKrullDim_le_one k f)
      (Stacks.Divisors.modulesInvertibleSheaf D) = d) :
    (hL.linearSeries k f D hr hd).L = Stacks.Divisors.modulesInvertibleSheaf D ∧
      L = (subspaceImmersion k f D (hL.linearSeries k f D hr hd).V).ker :=
  ⟨rfl, (hL.exists_eq_projectiveSpace k f D hr).choose_spec.choose_spec.1⟩

end Stacks.LinearSystemScheme

end
