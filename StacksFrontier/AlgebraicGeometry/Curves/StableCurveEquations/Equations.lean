module

public import StacksFrontier.AlgebraicGeometry.ClosedSubschemeProjectiveSpace.Basic
public import StacksFrontier.AlgebraicGeometry.Curves.StableCurveEquations.IdealGenerationStep
public import StacksFrontier.AlgebraicGeometry.Descent.EffectiveEpi.QuasicoherentSectionsEqualizer
public import StacksFrontier.AlgebraicGeometry.HomogeneousQuotient.Factor
public import StacksFrontier.AlgebraicGeometry.ProjModelStructureMap.ComparisonNatural
public import StacksFrontier.AlgebraicGeometry.ProjQuotientChartIdeal.Basic
public import StacksFrontier.AlgebraicGeometry.ProjectiveSpace.UniversalFormsStrata

/-!
# A closed subscheme of `ℙⁿ_k` with regular ideal sheaf is cut out by forms of one degree

Let `φ : X ⟶ ℙⁿ_k` be a closed immersion over a field whose ideal sheaf `ℐ` is `d`-regular for
every `d ≥ m`. Then `X` is, over `k`, the scheme `Proj (k[T₀, …, Tₙ] ⧸ (s_1, …, s_M))` for forms
`s_j` of degree `m`, with `M = dim_k k[T₀, …, Tₙ]_m` depending only on `n` and `m`.

The homogeneous ideal `I(X)` of [Stacks, Tag 03GL] has `X = Proj (k[T] ⧸ I(X))`, and its degree-`d`
part is the space of forms whose sections pull back to zero on `X` (the comparison of the two
models of projective space is canonical on sections). By [Stacks, Tag 08A7]
(`AlgebraicGeometry.mem_span_mul_of_isMRegular`) its part of degree `d + 1` is spanned by linear
multiples of its part of degree `d` for `d ≥ m`, so the ideal `J` generated by the degree-`m` part
agrees with `I(X)` in all degrees `≥ m`, and `Proj (k[T] ⧸ J) = Proj (k[T] ⧸ I(X))` by
[Stacks, Tag 07ZE].

## Main results

* `AlgebraicGeometry.pullbackGlobalSections_gammaTopIsoOfPullbackIso_eq_zero_iff`: a transported
  section pulls back to zero exactly when the original one does.
* `AlgebraicGeometry.mem_homogeneousIdealOfClosedSubscheme_iff`: the degree-`d` part of the
  homogeneous ideal of `X` is the space of forms whose sections pull back to zero on `X`.
* `AlgebraicGeometry.exists_iso_proj_formsGrading_of_isMRegular`: the statement above.

## References

* [Stacks Project, Tag 03GL](https://stacks.math.columbia.edu/tag/03GL)
* [Stacks Project, Tag 08A7](https://stacks.math.columbia.edu/tag/08A7)
* [Stacks Project, Tag 07ZE](https://stacks.math.columbia.edu/tag/07ZE)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.AlgebraicGeometry.ProjTwistTensorPow (twistOver)

universe u

namespace AlgebraicGeometry

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **A section transported across an isomorphism of schemes pulls back to zero exactly when the
original one does.** For `c : X ⟶ Y` an isomorphism, `κ : c^* M ≅ N` and `j : Z ⟶ X`, the
transport of `t ∈ Γ(M, ⊤)` pulls back to zero along `j` iff `t` pulls back to zero along
`j ≫ c`. -/
theorem pullbackGlobalSections_gammaTopIsoOfPullbackIso_eq_zero_iff {Z X Y : Scheme.{u}}
    (j : Z ⟶ X) (c : X ⟶ Y) [IsIso c] {M : Y.Modules} {N : X.Modules}
    (κ : (Scheme.Modules.pullback c).obj M ≅ N) (t : Γ(M, ⊤)) :
    pullbackGlobalSections j N ((Scheme.Modules.gammaTopIsoOfPullbackIso c κ).hom t) = 0 ↔
      pullbackGlobalSections (j ≫ c) M t = 0 := by
  have hcancel : ∀ {W : Scheme.{u}} {A B : W.Modules} (e : A ≅ B) (y : Γ(A, ⊤)),
      e.inv.app ⊤ (e.hom.app ⊤ y) = y := fun e y => by
    rw [← CategoryTheory.comp_apply, ← Scheme.Modules.Hom.comp_app, Iso.hom_inv_id,
      Scheme.Modules.Hom.id_app, CategoryTheory.id_apply]
  have hiff : ∀ {W : Scheme.{u}} {A B : W.Modules} (g : A ⟶ B) [IsIso g] (y : Γ(A, ⊤)),
      g.app ⊤ y = 0 ↔ y = 0 := fun g _ y =>
    map_eq_zero_iff _ (Function.LeftInverse.injective (hcancel (asIso g)))
  rw [Scheme.Modules.gammaTopIsoOfPullbackIso_hom_apply]
  have hnat := ConcreteCategory.congr_hom
    (Stacks.AlgebraicGeometry.IdealOfClosedSubscheme.pullbackGlobalSections_naturality_app j κ.hom)
    (pullbackGlobalSections c M t)
  rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply] at hnat
  rw [← hnat, hiff ((Scheme.Modules.pullback j).map κ.hom),
    ← hiff ((Scheme.Modules.pullbackComp j c).hom.app M),
    AlgebraicGeometry.SectionsEqualizer.pullbackGlobalSections_comp]

variable {k : Type u} [Field k] {n : ℕ} {X : Scheme.{u}}
  (φ : X ⟶ projectiveSpaceOverRing n (.of k)) [IsClosedImmersion φ]

/-- The closed immersion `φ` read in the `Proj k[T₀, …, Tₙ]` model of projective space, through
the coordinate-pinned comparison of [Stacks, Tag 03GL]. -/
abbrev projModelEmbedding : X ⟶ Proj (Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading k n) :=
  φ ≫ (Stacks.ClosedSubschemeProjectiveSpace.comparisonIso k n).hom

/-- **The degree-`d` part of the homogeneous ideal of `X` consists of the forms whose sections
pull back to zero on `X`.** The homogeneous ideal is the one of [Stacks, Tag 03GL], for `X` read
in the model `Proj k[T₀, …, Tₙ]`; the sections are read on the base-change model, the comparison
of the two models being canonical on sections. -/
theorem mem_homogeneousIdealOfClosedSubscheme_iff (d : ℕ)
    (b : MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k d) :
    (b : MvPolynomial (Fin (n + 1)) k) ∈
        (Stacks.ClosedSubschemeProjQuotient.homogeneousIdealOfClosedSubscheme
          (Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading k n)
          (projModelEmbedding φ)).toIdeal ↔
      pullbackGlobalSections φ (twistOver n (Spec (.of k)) (d : ℤ))
        (formsLinearEquivTwistOverSections k n d b) = 0 := by
  rw [← Ideal.Quotient.eq_zero_iff_mem, ← Stacks.RingTheory.HomogeneousQuotient.quotientMk_apply,
    Stacks.ClosedSubschemeProjQuotient.quotientMk_coe_eq_zero_iff
      (Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading k n) (projModelEmbedding φ) d b,
    ← canonicalTwistGammaTopIso_hom_formsLinearEquivTwistOverSections k n d b]
  show pullbackGlobalSections (projModelEmbedding φ) _
      ((Scheme.Modules.gammaTopIsoOfPullbackIso (Stacks.ProjectiveCohomology.projModelIso k n).hom
        (Stacks.ProjectiveCohomology.canonicalPullbackProjModelIsoHomTwistOverIso k n d)).hom
          (formsLinearEquivTwistOverSections k n d b)) = 0 ↔ _
  have h : projModelEmbedding φ ≫ (Stacks.ProjectiveCohomology.projModelIso k n).hom = φ := by
    rw [projModelEmbedding, Category.assoc,
      ← Stacks.ProjectiveCohomology.polynomialComparison_iso_inv k n]
    exact (Category.assoc _ _ _).symm.trans (by
      rw [Category.assoc, Stacks.ClosedSubschemeProjectiveSpace.comparisonIso, Iso.hom_inv_id,
        Category.comp_id])
  refine (pullbackGlobalSections_gammaTopIsoOfPullbackIso_eq_zero_iff (projModelEmbedding φ)
    (Stacks.ProjectiveCohomology.projModelIso k n).hom
    (Stacks.ProjectiveCohomology.canonicalPullbackProjModelIsoHomTwistOverIso k n d)
    (formsLinearEquivTwistOverSections k n d b)).trans ?_
  rw [h]

/-- The forms of degree `d` whose sections pull back to zero along `φ`: the equations of `X` of
degree `d`. -/
def equationsOfDegree (d : ℕ) : Set (MvPolynomial (Fin (n + 1)) k) :=
  {b | ∃ hb : b ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k d,
    pullbackGlobalSections φ (twistOver n (Spec (.of k)) (d : ℤ))
      (formsLinearEquivTwistOverSections k n d ⟨b, hb⟩) = 0}

/-- **Above the regularity, every equation lies in the ideal generated by the equations of the
lowest degree.** If the ideal sheaf of `X` is `d`-regular for every `d ≥ m`, every equation of
`X` of degree `d ≥ m` is in the ideal generated by the equations of degree `m`
([Stacks, Tag 08A7], by induction on the degree). -/
theorem mem_span_equationsOfDegree_of_isMRegular (m : ℕ)
    (hreg : ∀ d : ℕ, m ≤ d → IsMRegular k n (kernel (closedImmersionQuotient φ)) d) :
    ∀ d : ℕ, m ≤ d → ∀ b ∈ equationsOfDegree φ d, b ∈ Ideal.span (equationsOfDegree φ m) := by
  intro d hd
  induction d, hd using Nat.le_induction with
  | base => exact fun b hb => Ideal.subset_span hb
  | succ d hmd ih =>
    rintro b ⟨hb, hb0⟩
    have h := mem_span_mul_of_isMRegular φ d (hreg d hmd) ⟨b, hb⟩ hb0
    refine Submodule.span_le.2 ?_ (Submodule.span_subset_span k _ _ h)
    rintro _ ⟨p, c, hp, hc, rfl⟩
    exact Ideal.mul_mem_left _ p (ih c ⟨c.2, hc⟩)

/-- **Every set of forms of degree `m` spans the same ideal as a family of `M` forms of degree
`m`**, `M = dim_k k[T₀, …, Tₙ]_m`. -/
private theorem exists_fin_isHomogeneous_span_eq (m : ℕ) {T : Set (MvPolynomial (Fin (n + 1)) k)}
    (hT : T ⊆ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k m) :
    ∃ s : Fin ((n + 1 + m - 1).choose m) → MvPolynomial (Fin (n + 1)) k,
      (∀ j, (s j).IsHomogeneous m) ∧ Ideal.span (Set.range s) = Ideal.span T := by
  classical
  let V := Submodule.span k T
  have hVle : V ≤ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k m := Submodule.span_le.2 hT
  have hSm : Module.finrank k (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k m) =
      (n + 1 + m - 1).choose m := by
    rw [MvPolynomial.finrank_homogeneousSubmodule, Fintype.card_fin]
  have : Module.Finite k (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k m) :=
    Module.finite_of_finrank_pos (hSm ▸ Nat.choose_pos (by omega))
  have : Module.Finite k V := Submodule.finiteDimensional_of_le hVle
  have hr : Module.finrank k V ≤ (n + 1 + m - 1).choose m :=
    hSm ▸ Submodule.finrank_mono hVle
  let bV := Module.finBasis k V
  let s : Fin ((n + 1 + m - 1).choose m) → MvPolynomial (Fin (n + 1)) k := fun j =>
    if h : (j : ℕ) < Module.finrank k V then (bV ⟨j, h⟩ : MvPolynomial (Fin (n + 1)) k) else 0
  have hsV : ∀ j, s j ∈ V := fun j => by
    simp only [s]
    split_ifs
    · exact (bV _).2
    · exact V.zero_mem
  refine ⟨s, fun j => hVle (hsV j), le_antisymm ?_ ?_⟩
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨j, rfl⟩
    exact Submodule.span_subset_span k _ T (hsV j)
  · refine Ideal.span_le.2 fun b hb => ?_
    have hbV : (⟨b, Submodule.subset_span hb⟩ : V) ∈ Submodule.span k (Set.range bV) := by
      rw [bV.span_eq]
      trivial
    refine Submodule.span_le (p := ((Ideal.span (Set.range s)).restrictScalars k).comap
      V.subtype) |>.2 ?_ hbV
    rintro _ ⟨i, rfl⟩
    refine Ideal.subset_span ⟨⟨i, i.2.trans_le hr⟩, ?_⟩
    simp only [s, dite_eq_left i.2]
    rfl

/-- The comparison of the two models of `ℙⁿ_k` commutes with their structure morphisms to
`Spec k`. -/
private theorem comparisonIso_inv_comp_toSpec :
    (Stacks.ClosedSubschemeProjectiveSpace.comparisonIso k n).inv ≫
        (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k)) =
      Proj.toSpecZero (Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading k n) ≫
        Spec.map (CommRingCat.ofHom ((GradedRing.projZeroRingHom'
          (Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading k n)).comp
            (algebraMap k (MvPolynomial (Fin (n + 1)) k)))) := by
  rw [Iso.inv_comp_eq]
  exact (Stacks.AlgebraicGeometry.ProjBaseChange.polynomialComparison k n).toBase.symm

/-- **A closed subscheme of `ℙⁿ_k` whose ideal sheaf is `d`-regular for every `d ≥ m` is cut out
by `M` forms of degree `m`**, `M = dim_k k[T₀, …, Tₙ]_m`: there are forms `s_1, …, s_M` of
degree `m` and an isomorphism `X ≅ Proj (k[T₀, …, Tₙ] ⧸ (s_1, …, s_M))` over `k`. -/
theorem exists_iso_proj_formsGrading_of_isMRegular (m : ℕ)
    (hreg : ∀ d : ℕ, m ≤ d → IsMRegular k n (kernel (closedImmersionQuotient φ)) d) :
    ∃ (s : Fin ((n + 1 + m - 1).choose m) → MvPolynomial (Fin (n + 1)) k)
      (hs : ∀ j, (s j).IsHomogeneous m)
      (e : X ≅ Proj (Stacks.UniversalForms.formsGrading k s hs)),
      e.hom ≫ Stacks.UniversalForms.formsToSpec k s hs =
        φ ≫ (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k)) := by
  classical
  let 𝒮 := Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading k n
  let IX := Stacks.ClosedSubschemeProjQuotient.homogeneousIdealOfClosedSubscheme 𝒮
    (projModelEmbedding φ)
  obtain ⟨s, hs, hspan⟩ := exists_fin_isHomogeneous_span_eq (T := equationsOfDegree φ m) m
    fun _ ⟨hb, _⟩ => hb
  have h_le : Stacks.UniversalForms.formsIdeal k s hs ≤ IX := by
    show Ideal.span (Set.range s) ≤ IX.toIdeal
    rw [hspan]
    exact Ideal.span_le.2 fun b ⟨hb, hb0⟩ =>
      (mem_homogeneousIdealOfClosedSubscheme_iff φ m ⟨b, hb⟩).2 hb0
  have hm : ∀ d, m ≤ d → ∀ a ∈ 𝒮 d, a ∈ IX.toIdeal →
      a ∈ (Stacks.UniversalForms.formsIdeal k s hs).toIdeal := by
    intro d hd a ha haX
    show a ∈ Ideal.span (Set.range s)
    rw [hspan]
    exact mem_span_equationsOfDegree_of_isMRegular φ m hreg d hd a
      ⟨ha, (mem_homogeneousIdealOfClosedSubscheme_iff φ d ⟨a, ha⟩).1 haX⟩
  have := Stacks.RingTheory.HomogeneousQuotient.isIso_projMap_quotientFactor 𝒮 h_le m hm
  obtain ⟨e₁, he₁⟩ :=
    Stacks.ClosedSubschemeProjectiveSpace.closedSubscheme_iso_projQuotient (R := k) (n := n) φ
  refine ⟨s, hs, e₁ ≪≫ asIso (Proj.map
    (Stacks.RingTheory.HomogeneousQuotient.quotientFactor 𝒮 h_le)
    (Stacks.RingTheory.HomogeneousQuotient.irrelevant_le_map_quotientFactor 𝒮 h_le)), ?_⟩
  have hring : CommRingCat.ofHom (algebraMap k
        ↥(Stacks.UniversalForms.formsGrading k s hs 0)) ≫
      CommRingCat.ofHom
        (Stacks.RingTheory.HomogeneousQuotient.quotientFactor 𝒮 h_le).gradedZeroRingHom =
    CommRingCat.ofHom ((GradedRing.projZeroRingHom' 𝒮).comp
        (algebraMap k (MvPolynomial (Fin (n + 1)) k))) ≫
      CommRingCat.ofHom
        (Stacks.RingTheory.HomogeneousQuotient.quotientMk 𝒮 IX).gradedZeroRingHom := by
    ext c
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp, Function.comp_apply,
      GradedRingHom.gradedZeroRingHom_apply_coe, SetLike.GradeZero.coe_algebraMap,
      GradedRing.coe_projZeroRingHom'_apply, GradedRing.projZeroRingHom_apply,
      DirectSum.decompose_of_mem_same 𝒮 (SetLike.algebraMap_mem_graded 𝒮 c)]
    rfl
  have hkey : Proj.map (Stacks.RingTheory.HomogeneousQuotient.quotientFactor 𝒮 h_le)
        (Stacks.RingTheory.HomogeneousQuotient.irrelevant_le_map_quotientFactor 𝒮 h_le) ≫
          Stacks.UniversalForms.formsToSpec k s hs =
      Stacks.ClosedSubschemeProjQuotient.ambientHom 𝒮 (projModelEmbedding φ) ≫
        (Stacks.ClosedSubschemeProjectiveSpace.comparisonIso k n).inv ≫
          (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k)) := by
    unfold Stacks.UniversalForms.formsToSpec
    rw [comparisonIso_inv_comp_toSpec, Stacks.ProjQuotientChartIdeal.ambientHom_eq_projMap,
      Proj.map_toSpecZero_assoc, Proj.map_toSpecZero_assoc, ← Spec.map_comp, ← Spec.map_comp, hring]
  rw [Iso.trans_hom, asIso_hom, Category.assoc, hkey, reassoc_of% he₁]

end AlgebraicGeometry

end
