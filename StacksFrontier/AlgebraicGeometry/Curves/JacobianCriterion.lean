module

public import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
public import Mathlib.LinearAlgebra.Prod
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.Tactic.FieldSimp
public import Mathlib.Tactic.LinearCombination
public import StacksFrontier.LinearAlgebra.Matrix.MinorIdeal

/-!
# The linear algebra behind the Jacobian criterion for a node

Stacks Tag 0C4C characterises the nodal quotients `k[[x_1, …, x_n]]/I` of a formal power series
ring by the condition that the `(n-1) × (n-1)` minors of a Jacobian matrix of generators of `I`
generate the maximal ideal modulo `I`. Two pieces of linear algebra carry that criterion, and
both are collected here.

The first is a computation of the ideal of minors. If a matrix over a ring is presented in
blocks with an invertible square block `P` of size `r` in the upper left corner, then its
`(r + s) × (r + s)` minors generate the same ideal as the `s × s` minors of the Schur
complement `D - B P⁻¹ Q` (`minorIdeal_fromBlocks_isUnit_det`). For a Jacobian matrix whose
reduction modulo the maximal ideal has rank exactly `r`, this reduces the ideal of
`(n-1) × (n-1)` minors to the ideal generated by the entries of a small matrix, and that small
matrix is congruent modulo `𝔪²` to the block of partial derivatives of the generators lying in
`𝔪²`.

The second is the two-variable quadratic form computation. A binary quadratic form
`a X² + b XY + c Y²` over a field is nondegenerate — it has two distinct roots — exactly when
`4ac - b² ≠ 0`, which is exactly when its two partial derivatives `2aX + bY` and `bX + 2cY` are
linearly independent. The criterion of 0C4C needs the version of this statement for a whole
space of quadratic forms, and that version is true:
`span_derivSet_eq_top_iff_exists_nondegenerate` says that the partial derivatives of a subspace
`V` of binary quadratic forms span the space of linear forms if and only if `V` contains a single
nondegenerate form. The reason is that the degenerate forms are cut out by the quadratic
equation `4ac - b² = 0`, whose polarisation forces the derivative vectors of any two degenerate
forms in a common subspace to be proportional (`mixed_eq_zero_of_degenerate` and
`antisym_eq_zero_of_degenerate`).

## Main results

* `minorIdeal_mul_left_eq`, `minorIdeal_mul_right_eq` — the ideal of `r × r` minors is unchanged
  by multiplication by an invertible square matrix on either side.
* `minorIdeal_fromBlocks_isUnit_det` — the Schur complement computation of the ideal of minors.
* `minorIdeal_le_pow_of_entries_mem` — if all entries of a matrix lie in an ideal `J`, the ideal
  of `r × r` minors is contained in `J ^ r`.
* `minorIdeal_mul_rect_le`, `minorIdeal_mul_rect_right_le` — the rectangular form of
  Stacks 07Z7 (3), which is what a change of generating family of an ideal needs.
* `minorIdeal_map_matrix` — the ideal of minors commutes with a ring homomorphism.
* `entries_mul_mul_mem_sq` — the Schur correction term `B P⁻¹ Q` has entries in `𝔪 ^ 2` when
  those of `B` and `Q` lie in `𝔪`, so the Schur complement agrees with `D` modulo `𝔪 ^ 2`.
* `span_derivSet_eq_top_iff_exists_nondegenerate` — a space of binary quadratic forms has
  spanning partial derivatives if and only if it contains a nondegenerate form.

## Implementation notes

A binary quadratic form `a X² + b X Y + c Y²` is encoded by its coefficient triple
`(a, b, c) : k × k × k`, and a linear form `p X + q Y` by `(p, q) : k × k`; `derivSet V` is the
set of partial derivatives of the forms in `V`. This keeps the statements free of any choice of
model for symmetric powers; the space of quadratic forms on an abstract two-dimensional space is
identified with `k × k × k` by choosing a basis, and nondegeneracy is invariant under that
choice because the discriminant of a form transforms by the square of the determinant.

## References

* [Stacks Project, Tag 0C4C](https://stacks.math.columbia.edu/tag/0C4C)
* [Stacks Project, Tag 07Z7](https://stacks.math.columbia.edu/tag/07Z7)
-/

@[expose] public section

namespace Stacks.Curves

/-! ### Ideals of minors under invertible changes of basis -/

variable {R : Type*} [CommRing R]

/-- Transposing a matrix does not enlarge its ideal of `r × r` minors. -/
private theorem minorIdeal_transpose_le {ι κ : Type*} (A : Matrix ι κ R) (r : ℕ) :
    minorIdeal A.transpose r ≤ minorIdeal A r := by
  rw [minorIdeal, Ideal.span_le]
  rintro x ⟨f, g, rfl⟩
  exact Ideal.subset_span ⟨g, f, by
    rw [show A.transpose.submatrix f g = (A.submatrix g f).transpose by ext; rfl,
      Matrix.det_transpose]⟩

/-- Transposing a matrix does not change its ideal of `r × r` minors. -/
theorem minorIdeal_transpose {ι κ : Type*} (A : Matrix ι κ R) (r : ℕ) :
    minorIdeal A.transpose r = minorIdeal A r :=
  le_antisymm (minorIdeal_transpose_le A r) (by simpa using minorIdeal_transpose_le A.transpose r)

/-- The ideal of minors of a product `A * C` is that of `C.transpose * A.transpose`. -/
private theorem minorIdeal_mul_eq_transpose_mul {l m o : Type*} [Fintype m] (A : Matrix l m R)
    (C : Matrix m o R) (r : ℕ) :
    minorIdeal (A * C) r = minorIdeal (C.transpose * A.transpose) r := by
  rw [← Matrix.transpose_mul, minorIdeal_transpose]

/-- The ideals of minors of a fixed matrix decrease with the size of the minor:
`I_b(A) ⊆ I_a(A)` for `a ≤ b`. -/
theorem minorIdeal_antitone {ι κ : Type*} (A : Matrix ι κ R) {a b : ℕ} (h : a ≤ b) :
    minorIdeal A b ≤ minorIdeal A a :=
  antitone_nat_of_succ_le (minorIdeal_succ_le A) h

/-- Multiplying on the left by an invertible square matrix does not change the ideal of
`r × r` minors. -/
theorem minorIdeal_mul_left_eq {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    (U : Matrix ι ι R) (hU : IsUnit U.det) (A : Matrix ι κ R) (r : ℕ) :
    minorIdeal (U * A) r = minorIdeal A r := by
  refine le_antisymm (minorIdeal_mul_le U A r) ?_
  calc minorIdeal A r = minorIdeal (U⁻¹ * (U * A)) r := by
        rw [← Matrix.mul_assoc, Matrix.nonsing_inv_mul U hU, Matrix.one_mul]
    _ ≤ minorIdeal (U * A) r := minorIdeal_mul_le U⁻¹ (U * A) r

/-- Multiplying on the right by an invertible square matrix does not change the ideal of
`r × r` minors. -/
theorem minorIdeal_mul_right_eq {ι κ : Type*} [Fintype κ] [DecidableEq κ]
    (A : Matrix ι κ R) (V : Matrix κ κ R) (hV : IsUnit V.det) (r : ℕ) :
    minorIdeal (A * V) r = minorIdeal A r := by
  have hVt : IsUnit V.transpose.det := by rwa [Matrix.det_transpose]
  calc minorIdeal (A * V) r = minorIdeal (V.transpose * A.transpose) r :=
        minorIdeal_mul_eq_transpose_mul _ _ r
    _ = minorIdeal A.transpose r := minorIdeal_mul_left_eq _ hVt _ r
    _ = minorIdeal A r := minorIdeal_transpose _ _

/-- An invertible square matrix of size `N` has unit ideal of `r × r` minors for every
`r ≤ N`. -/
theorem minorIdeal_eq_top_of_isUnit_det {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : Matrix ι ι R) (hP : IsUnit P.det) {r : ℕ} (hr : r ≤ Fintype.card ι) :
    minorIdeal P r = ⊤ := by
  have hcard : minorIdeal P (Fintype.card ι) = ⊤ := by
    refine Ideal.eq_top_of_isUnit_mem _ ?_ hP
    rw [minorIdeal]
    refine Ideal.subset_span ⟨(Fintype.equivFin ι).symm, (Fintype.equivFin ι).symm, ?_⟩
    rw [Matrix.det_submatrix_equiv_self]
  exact top_le_iff.mp (hcard ▸ minorIdeal_antitone P hr)

/-- If all entries of `A` lie in an ideal `J`, then every `r × r` minor of `A` lies in `J ^ r`,
so `I_r(A) ⊆ J ^ r`. -/
theorem minorIdeal_le_pow_of_entries_mem {ι κ : Type*} (A : Matrix ι κ R) (J : Ideal R)
    (hA : ∀ i j, A i j ∈ J) (r : ℕ) : minorIdeal A r ≤ J ^ r := by
  classical
  rw [minorIdeal, Ideal.span_le]
  rintro x ⟨f, g, rfl⟩
  rw [Matrix.det_apply']
  refine Ideal.sum_mem _ fun σ _ => Ideal.mul_mem_left _ _ ?_
  have hprod : ∏ i : Fin r, (A.submatrix f g) (σ i) i ∈ ∏ _i : Fin r, J :=
    Ideal.prod_mem_prod (fun i _ => hA _ _)
  simpa [Finset.prod_const] using hprod

/-- **Stacks 07Z7** (part 3), for a rectangular left factor. For `C` of size `l × m` and `A` of
size `m × o`, `I_r(C * A) ⊆ I_r(A)`. This is the Cauchy–Binet expansion of an `r × r` minor of
`C * A` over the maps `φ : Fin r → m` picking `r` rows of `A`.

The square case is `minorIdeal_mul_le`; this version is what the independence of the Jacobian
ideal from the chosen generators of the defining ideal needs, since two generating families can
have different sizes. -/
theorem minorIdeal_mul_rect_le {l m o : Type*} [Fintype m]
    (C : Matrix l m R) (A : Matrix m o R) (r : ℕ) :
    minorIdeal (C * A) r ≤ minorIdeal A r := by
  classical
  rw [minorIdeal, Ideal.span_le]
  rintro x ⟨f, g, rfl⟩
  have key : ((C * A).submatrix f g).det
      = ∑ φ : Fin r → m, (∏ i, C (f i) (φ i)) * (A.submatrix φ g).det := by
    have h1 : ((C * A).submatrix f g)
        = Matrix.of (fun i k => ∑ j, C (f i) j * A j (g k)) := by
      ext i k
      simp [Matrix.mul_apply, Matrix.submatrix]
    rw [h1]
    change (Matrix.detRowAlternating) (fun i k => ∑ j, C (f i) j * A j (g k)) = _
    have h2 : (fun i => (fun k => ∑ j, C (f i) j * A j (g k)))
        = (fun i => ∑ j, C (f i) j • (fun k => A j (g k))) := by
      funext i
      funext k
      simp [Finset.sum_apply]
    rw [h2]
    change (Matrix.detRowAlternating).toMultilinearMap
        (fun i => ∑ j, C (f i) j • (fun k => A j (g k))) = _
    rw [MultilinearMap.map_sum (Matrix.detRowAlternating).toMultilinearMap
        (fun i j => C (f i) j • (fun k => A j (g k)))]
    apply Finset.sum_congr rfl
    intro φ _
    have heq : (Matrix.of fun i k => C (f i) (φ i) * (A.submatrix φ g) i k).det
        = (∏ i, C (f i) (φ i)) * (A.submatrix φ g).det := Matrix.det_mul_column _ _
    rw [← heq]
    rfl
  rw [key]
  exact Ideal.sum_mem _ fun φ _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨φ, g, rfl⟩)

/-- `I_r(A * C) ⊆ I_r(A)` for a rectangular right factor `C`, by transposing
`minorIdeal_mul_rect_le`. -/
theorem minorIdeal_mul_rect_right_le {l m o : Type*} [Fintype m]
    (A : Matrix l m R) (C : Matrix m o R) (r : ℕ) :
    minorIdeal (A * C) r ≤ minorIdeal A r := by
  calc minorIdeal (A * C) r = minorIdeal (C.transpose * A.transpose) r :=
        minorIdeal_mul_eq_transpose_mul _ _ r
    _ ≤ minorIdeal A.transpose r := minorIdeal_mul_rect_le C.transpose A.transpose r
    _ = minorIdeal A r := minorIdeal_transpose _ _

/-- The ideal of minors is compatible with a ring homomorphism: the image of `I_r(A)` under `φ`
is the ideal of `r × r` minors of the matrix of images. This is how a statement about the
Jacobian matrix over `k[[x_1, …, x_n]]` is transported to the quotient `k[[x_1, …, x_n]]/I`. -/
theorem minorIdeal_map_matrix {S : Type*} [CommRing S] (φ : R →+* S) {ι κ : Type*}
    (A : Matrix ι κ R) (r : ℕ) :
    (minorIdeal A r).map φ = minorIdeal (A.map φ) r := by
  classical
  rw [minorIdeal, minorIdeal, Ideal.map_span]
  congr 1
  ext x
  simp only [Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨x, ⟨f, g, rfl⟩, rfl⟩
    refine ⟨f, g, ?_⟩
    rw [RingHom.map_det]
    congr 1
  · rintro ⟨f, g, rfl⟩
    refine ⟨(A.submatrix f g).det, ⟨f, g, rfl⟩, ?_⟩
    rw [RingHom.map_det]
    congr 1

/-! ### The Schur complement computation of the ideal of minors -/

/-- The block `LDU` factorisation: a block matrix with invertible upper left block `P` is the
product of a lower unipotent block matrix, the block diagonal matrix with blocks `P` and the
Schur complement `D - B P⁻¹ Q`, and an upper unipotent block matrix. -/
theorem fromBlocks_eq_lower_mul_diag_mul_upper {r : ℕ} {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ]
    (P : Matrix (Fin r) (Fin r) R) (Q : Matrix (Fin r) κ R)
    (B : Matrix ι (Fin r) R) (D : Matrix ι κ R) (hP : IsUnit P.det) :
    Matrix.fromBlocks P Q B D =
      (Matrix.fromBlocks 1 0 (B * P⁻¹) 1 : Matrix (Fin r ⊕ ι) (Fin r ⊕ ι) R) *
        ((Matrix.fromBlocks P 0 0 (D - B * P⁻¹ * Q) : Matrix (Fin r ⊕ ι) (Fin r ⊕ κ) R) *
          (Matrix.fromBlocks 1 (P⁻¹ * Q) 0 1 : Matrix (Fin r ⊕ κ) (Fin r ⊕ κ) R)) := by
  have h1 : P * P⁻¹ = 1 := Matrix.mul_nonsing_inv P hP
  have h2 : P⁻¹ * P = 1 := Matrix.nonsing_inv_mul P hP
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, Matrix.mul_one, Matrix.one_mul, add_zero, zero_add]
  congr 1
  · rw [← Matrix.mul_assoc, h1, Matrix.one_mul]
  · rw [Matrix.mul_assoc, h2, Matrix.mul_one]
  · rw [show P * (P⁻¹ * Q) = Q by rw [← Matrix.mul_assoc, h1, Matrix.one_mul]]
    abel

/-- For a block diagonal matrix whose first block `P` is an invertible matrix of size `r`, the
ideal of `(r + s) × (r + s)` minors is the ideal of `s × s` minors of the second block. -/
theorem minorIdeal_fromBlocks_diag_isUnit_det {r s : ℕ} {ι κ : Type*}
    (P : Matrix (Fin r) (Fin r) R) (T : Matrix ι κ R) (hP : IsUnit P.det) :
    minorIdeal (Matrix.fromBlocks P 0 0 T) (r + s) = minorIdeal T s := by
  classical
  rw [minorIdeal_fromBlocks]
  apply le_antisymm
  · refine Finset.sum_induction
      (fun p : ℕ × ℕ => minorIdeal P p.1 * minorIdeal T p.2)
      (fun J => J ≤ minorIdeal T s) (fun a b ha hb => sup_le ha hb) bot_le ?_
    rintro ⟨p1, p2⟩ hp
    have hsum : p1 + p2 = r + s := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
    by_cases hp1 : p1 ≤ r
    · exact Ideal.mul_le_right.trans (minorIdeal_antitone T (by omega))
    · rw [minorIdeal_eq_bot_of_card_lt P p1 (Or.inl (by simpa using Nat.lt_of_not_le hp1)),
        Ideal.bot_mul]
      exact bot_le
  · have hmem : ((r, s) : ℕ × ℕ) ∈ Finset.HasAntidiagonal.antidiagonal (r + s) :=
      Finset.HasAntidiagonal.mem_antidiagonal.mpr rfl
    set F : ℕ × ℕ → Ideal R := fun p => minorIdeal P p.1 * minorIdeal T p.2
    have hval : F (r, s) = minorIdeal T s := by
      change minorIdeal P r * minorIdeal T s = minorIdeal T s
      rw [minorIdeal_eq_top_of_isUnit_det P hP (by simp), Ideal.top_mul]
    exact hval ▸ Finset.single_le_sum (f := F) (fun _ _ => bot_le) hmem

/-- **The Schur complement computation of the ideal of minors.** If a block matrix has an
invertible upper left block `P` of size `r`, then its ideal of `(r + s) × (r + s)` minors is the
ideal of `s × s` minors of the Schur complement `D - B P⁻¹ Q`.

Applied to a Jacobian matrix whose reduction modulo the maximal ideal has rank `r`, this says
that the ideal of `(r + s) × (r + s)` minors is generated by the `s × s` minors of a matrix of
size `(n - r)` by `(number of generators) - r`, all of whose entries lie in the maximal
ideal. -/
theorem minorIdeal_fromBlocks_isUnit_det {r s : ℕ} {ι κ : Type*} [Finite ι] [Finite κ]
    (P : Matrix (Fin r) (Fin r) R) (Q : Matrix (Fin r) κ R)
    (B : Matrix ι (Fin r) R) (D : Matrix ι κ R) (hP : IsUnit P.det) :
    minorIdeal (Matrix.fromBlocks P Q B D) (r + s) = minorIdeal (D - B * P⁻¹ * Q) s := by
  classical
  have _ : Fintype ι := Fintype.ofFinite ι
  have _ : Fintype κ := Fintype.ofFinite κ
  have hLdet : IsUnit
      (Matrix.fromBlocks 1 0 (B * P⁻¹) 1 : Matrix (Fin r ⊕ ι) (Fin r ⊕ ι) R).det := by
    rw [Matrix.det_fromBlocks_zero₁₂]; simp
  have hNdet : IsUnit
      (Matrix.fromBlocks 1 (P⁻¹ * Q) 0 1 : Matrix (Fin r ⊕ κ) (Fin r ⊕ κ) R).det := by
    rw [Matrix.det_fromBlocks_zero₂₁]; simp
  rw [fromBlocks_eq_lower_mul_diag_mul_upper P Q B D hP,
    minorIdeal_mul_left_eq _ hLdet _ (r + s), minorIdeal_mul_right_eq _ _ hNdet (r + s),
    minorIdeal_fromBlocks_diag_isUnit_det P _ hP]

/-- If the entries of `B` and of `Q` lie in an ideal `J`, then the entries of `B * M * Q` lie in
`J ^ 2`, whatever the middle factor `M` is.

For the Schur complement `D - B P⁻¹ Q` of a Jacobian matrix this says that the correction term
is congruent to `0` modulo `𝔪 ^ 2`, so that the Schur complement and the block `D` of partial
derivatives have the same image in `𝔪 / 𝔪 ^ 2`. That is what turns the Jacobian condition of
Stacks 0C4C into a statement about the quadratic parts of the defining ideal. -/
theorem entries_mul_mul_mem_sq {ι μ ν κ : Type*} [Fintype μ] [Fintype ν]
    (B : Matrix ι μ R) (M : Matrix μ ν R) (Q : Matrix ν κ R) (J : Ideal R)
    (hB : ∀ i j, B i j ∈ J) (hQ : ∀ i j, Q i j ∈ J) (i : ι) (j : κ) :
    (B * M * Q) i j ∈ J ^ 2 := by
  rw [Matrix.mul_apply]
  refine Ideal.sum_mem _ fun l _ => ?_
  have hBM : (B * M) i l ∈ J := by
    rw [Matrix.mul_apply]
    exact Ideal.sum_mem _ fun t _ => Ideal.mul_mem_right _ _ (hB i t)
  simpa [pow_two] using Ideal.mul_mem_mul hBM (hQ l j)

/-! ### Nondegenerate binary quadratic forms

A binary quadratic form `a X² + b X Y + c Y²` over a field is recorded by its coefficient
triple `(a, b, c)`, and a linear form `p X + q Y` by the pair `(p, q)`.
-/

variable {k : Type*} [Field k]

/-- The discriminant-type invariant `4ac - b²` of the binary quadratic form with coefficient
triple `(a, b, c)`. The form is nondegenerate, that is, it is a product of two linear forms that
are not proportional, exactly when this is nonzero. -/
def quadDisc (q : k × k × k) : k := 4 * q.1 * q.2.2 - q.2.1 ^ 2

/-- The value of `quadDisc` on the coefficient triple `(a, b, c)` is `4ac - b²`. -/
@[simp]
theorem quadDisc_apply (a b c : k) : quadDisc ((a, b, c) : k × k × k) = 4 * a * c - b ^ 2 := rfl

/-- The two partial derivatives `(2a, b)` and `(b, 2c)` of the forms in a space `V` of binary
quadratic forms. -/
def derivSet (V : Submodule k (k × k × k)) : Set (k × k) :=
  {v | ∃ q ∈ V, v = (2 * q.1, q.2.1) ∨ v = (q.2.1, 2 * q.2.2)}

/-- The alternating form `(v, w) ↦ v₁w₂ - v₂w₁` on the plane, as a linear map in its second
argument. -/
noncomputable def altForm (v : k × k) : (k × k) →ₗ[k] k where
  toFun w := v.1 * w.2 - v.2 * w.1
  map_add' w w' := by simp [Prod.fst_add, Prod.snd_add]; ring
  map_smul' a w := by simp; ring

/-- The value of `altForm v` at `w` is `v₁w₂ - v₂w₁`. -/
theorem altForm_apply (v w : k × k) : altForm v w = v.1 * w.2 - v.2 * w.1 := rfl

/-- A set of vectors in the plane on which the alternating form vanishes identically does not
span the plane. -/
theorem span_ne_top_of_altForm_eq_zero (D : Set (k × k))
    (h : ∀ v ∈ D, ∀ w ∈ D, altForm v w = 0) : Submodule.span k D ≠ ⊤ := by
  have step1 : ∀ v ∈ D, ∀ w ∈ Submodule.span k D, altForm v w = 0 := by
    intro v hv
    have hker : Submodule.span k D ≤ LinearMap.ker (altForm v) :=
      Submodule.span_le.mpr fun w hw => by simpa using h v hv w hw
    intro w hw
    simpa using hker hw
  have step2 : ∀ w ∈ Submodule.span k D, ∀ v ∈ Submodule.span k D, altForm v w = 0 := by
    intro w hw
    set g : (k × k) →ₗ[k] k :=
      { toFun := fun v => altForm v w
        map_add' := fun v v' => by simp [altForm_apply, Prod.fst_add, Prod.snd_add]; ring
        map_smul' := fun a v => by simp [altForm_apply]; ring } with hg
    have hker : Submodule.span k D ≤ LinearMap.ker g :=
      Submodule.span_le.mpr fun v hv => by
        simp only [SetLike.mem_coe, LinearMap.mem_ker, hg]
        exact step1 v hv w hw
    intro v hv
    simpa [hg] using hker hv
  intro htop
  have h1 : ((1 : k), (0 : k)) ∈ Submodule.span k D := htop ▸ Submodule.mem_top
  have h2 : ((0 : k), (1 : k)) ∈ Submodule.span k D := htop ▸ Submodule.mem_top
  simpa [altForm_apply] using step2 _ h2 _ h1

/-- The polarisation identity for the discriminant: if two binary quadratic forms and their sum
all have vanishing discriminant, then the mixed term `4ac' - bb'` vanishes. -/
theorem mixed_eq_zero_of_degenerate (a b c a' b' c' : k)
    (h1 : 4 * a * c - b ^ 2 = 0) (h2 : 4 * a' * c' - b' ^ 2 = 0)
    (h3 : 4 * (a + a') * (c + c') - (b + b') ^ 2 = 0) :
    4 * a * c' - b * b' = 0 := by
  have hp : 4 * a * c' + 4 * a' * c = 2 * (b * b') := by linear_combination h3 - h1 - h2
  have hXY : (4 * a * c') * (4 * a' * c) = (b * b') ^ 2 := by
    linear_combination (4 * a' * c') * h1 + b ^ 2 * h2
  have key : (4 * a * c' - b * b') * (4 * a' * c - b * b') = 0 := by
    linear_combination hXY - (b * b') * hp
  rcases mul_eq_zero.mp key with h | h
  · exact h
  · linear_combination hp - h

/-- If two binary quadratic forms and their sum all have vanishing discriminant, then the
determinant formed by the first partial derivative of each of them vanishes. -/
theorem antisym_eq_zero_of_degenerate (a b c a' b' c' : k)
    (h1 : 4 * a * c - b ^ 2 = 0) (h2 : 4 * a' * c' - b' ^ 2 = 0)
    (h3 : 4 * (a + a') * (c + c') - (b + b') ^ 2 = 0) :
    2 * a * b' - 2 * a' * b = 0 := by
  refine (pow_eq_zero_iff two_ne_zero).mp ?_
  linear_combination (-4 * a' ^ 2) * h1 - 4 * a ^ 2 * h2 + 4 * a * a' * (h3 - h1 - h2)

/-- The partial derivatives of a nondegenerate binary quadratic form span the plane of linear
forms. -/
theorem span_derivSet_eq_top_of_nondegenerate {V : Submodule k (k × k × k)} {q : k × k × k}
    (hq : q ∈ V) (hd : quadDisc q ≠ 0) : Submodule.span k (derivSet V) = ⊤ := by
  obtain ⟨a, b, c⟩ := q
  rw [quadDisc_apply] at hd
  have hv : ((2 * a : k), b) ∈ derivSet V := ⟨(a, b, c), hq, Or.inl rfl⟩
  have hw : ((b : k), 2 * c) ∈ derivSet V := ⟨(a, b, c), hq, Or.inr rfl⟩
  set D : k := 4 * a * c - b ^ 2 with hDdef
  have hD : D ≠ 0 := hd
  rw [eq_top_iff]
  intro x _
  obtain ⟨x1, x2⟩ := x
  have key : ((x1, x2) : k × k)
      = ((2 * c * x1 - b * x2) / D) • ((2 * a : k), b) +
        ((2 * a * x2 - b * x1) / D) • ((b : k), 2 * c) := by
    apply Prod.ext <;>
      simp only [Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul] <;>
      field_simp <;> rw [hDdef] <;> ring
  rw [key]
  exact Submodule.add_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span hv))
    (Submodule.smul_mem _ _ (Submodule.subset_span hw))

/-- **The quadratic form criterion.** The partial derivatives of a space `V` of binary quadratic
forms span the plane of linear forms if and only if `V` contains a nondegenerate form.

This is the two-variable heart of the Jacobian criterion of Stacks 0C4C: the quadratic parts of
the defining ideal of a quotient of `k[[x, y]]` span a subspace `V` of the three-dimensional
space of binary quadratic forms, the Jacobian minors generate the maximal ideal exactly when the
derivatives of `V` span, and the quotient is nodal exactly when `V` contains a nondegenerate
form. -/
theorem span_derivSet_eq_top_iff_exists_nondegenerate (V : Submodule k (k × k × k)) :
    Submodule.span k (derivSet V) = ⊤ ↔ ∃ q ∈ V, quadDisc q ≠ 0 := by
  refine ⟨fun hspan => ?_, fun ⟨q, hq, hd⟩ => span_derivSet_eq_top_of_nondegenerate hq hd⟩
  by_contra hno
  simp only [not_exists, not_and, not_not] at hno
  refine span_ne_top_of_altForm_eq_zero (derivSet V) ?_ hspan
  rintro v ⟨q, hqV, hqv⟩ w ⟨q', hq'V, hq'w⟩
  obtain ⟨a, b, c⟩ := q
  obtain ⟨a', b', c'⟩ := q'
  have h1 : 4 * a * c - b ^ 2 = 0 := by simpa using hno _ hqV
  have h2 : 4 * a' * c' - b' ^ 2 = 0 := by simpa using hno _ hq'V
  have hsum : ((a + a', b + b', c + c') : k × k × k) ∈ V := V.add_mem hqV hq'V
  have h3 : 4 * (a + a') * (c + c') - (b + b') ^ 2 = 0 := by simpa using hno _ hsum
  have h1' : 4 * c * a - b ^ 2 = 0 := by linear_combination h1
  have h2' : 4 * c' * a' - b' ^ 2 = 0 := by linear_combination h2
  have h3' : 4 * (c + c') * (a + a') - (b + b') ^ 2 = 0 := by linear_combination h3
  rcases hqv with rfl | rfl <;> rcases hq'w with rfl | rfl <;> rw [altForm_apply] <;>
      simp only
  · linear_combination antisym_eq_zero_of_degenerate a b c a' b' c' h1 h2 h3
  · linear_combination mixed_eq_zero_of_degenerate a b c a' b' c' h1 h2 h3
  · linear_combination -mixed_eq_zero_of_degenerate a' b' c' a b c h2 h1 (by linear_combination h3)
  · linear_combination -antisym_eq_zero_of_degenerate c b a c' b' a' h1' h2' h3'

end Stacks.Curves

end
