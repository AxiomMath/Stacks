module

public import StacksFrontier.AlgebraicGeometry.AmpleDimensionOne.Basic
public import StacksFrontier.AlgebraicGeometry.Curves.GenusCurve.SmoothCurveDifferentials
public import StacksFrontier.AlgebraicGeometry.Curves.RiemannHurwitzDegree
public import StacksFrontier.AlgebraicGeometry.Curves.SingularGenusZero
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierStalk.Stalkwise

/-!
# The ramification term of the Riemann–Hurwitz formula

Let `f : X → Y` be a generically étale morphism of smooth curves over a field `k`, with `X`
proper, and let `R ⊆ X` be the closed subscheme cut out by the different of `f`. Then
`dim_k H⁰(X, Ω_{X/Y}) = dim_k Γ(R, 𝒪_R) = ∑_x d_x [κ(x) : k]`, where
`d_x = length_{𝒪_{X,x}} 𝒪_{R,x}`.

## Main results

* `AlgebraicGeometry.finrank_eq_length_mul_finrank_residueField_of_isLocalRing`: the dimension
  over `k` of a module over a local `k`-algebra is its length times the residue degree.
* `AlgebraicGeometry.mem_supp_relativeDifferentials_iff`: the support of `Ω_{X/Y}` is the closed
  subscheme cut out by the Kähler different.
* `AlgebraicGeometry.isFinite_kaehlerDifferent_subscheme`: that subscheme is finite over `k`.
* `AlgebraicGeometry.finrank_cohomologyOverField_relativeDifferentials_eq_finrank_sections`:
  `dim_k H⁰(X, Ω_{X/Y}) = dim_k Γ(R, 𝒪_R)`.
* `AlgebraicGeometry.curveDegree_relativeDifferentials_eq_degreeOver_mul_add`:
  `deg(Ω_{X/k}) = deg(f) · deg(Ω_{Y/k}) + deg(R)` for a morphism of smooth proper curves with
  nonzero differential.
* `AlgebraicGeometry.finrank_sections_kaehlerDifferent_subscheme_eq_finsum_isClosed`:
  `deg(R) = ∑_x d_x [κ(x) : k]` over the closed points `x` of `X`.
* `AlgebraicGeometry.two_mul_genus_sub_two_eq_degreeOver_mul_add`: the Riemann–Hurwitz formula
  `2g_X - 2 = (2g_Y - 2) deg(f) + deg(R)`, [Stacks, Tag 0C1D], from the previous identity and
  `deg(Ω_{X/k}) = 2g_X - 2` ([Stacks, Tag 0C1A]).
* `AlgebraicGeometry.two_mul_genus_sub_two_eq_degreeOver_mul_add_finsum`: the same with
  `deg(R) = ∑_x d_x [κ(x) : k]`, the formula of [Stacks, Tag 0C1F].

## References

* [Stacks Project, Tag 0C1D](https://stacks.math.columbia.edu/tag/0C1D)
* [Stacks Project, Tag 0C1F](https://stacks.math.columbia.edu/tag/0C1F)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Stacks.Discriminant

universe u

namespace AlgebraicGeometry

/-- Over a field the dimension of a module is the natural-number part of its length (both are
zero for an infinite-dimensional module). -/
theorem finrank_eq_length_toNat (k : Type u) [Field k] (M : Type u) [AddCommGroup M]
    [Module k M] : Module.finrank k M = (Module.length k M).toNat := by
  by_cases h : Module.Finite k M
  · rw [Module.length_eq_finrank k M, ENat.toNat_natCast]
  · rw [Module.finrank_of_not_finite h]
    have : Module.length k M = ⊤ := by
      by_contra hne
      have := (isFiniteLength_iff_isNoetherian_isArtinian.mp (Module.length_ne_top_iff.mp hne)).1
      exact h (Module.IsNoetherian.finite k M)
    rw [this, ENat.toNat_top]

/-- **The dimension of a module over a local algebra over a field.** For a local `k`-algebra `O`
with residue field finite over `k` and an `O`-module `M`,
`dim_k M = length_O(M) · [κ(O) : k]` (both sides vanish when `M` has infinite length). -/
theorem finrank_eq_length_mul_finrank_residueField_of_isLocalRing (k : Type u) [Field k]
    (O : Type u) [CommRing O] [IsLocalRing O] [Algebra k O] (M : Type u) [AddCommGroup M]
    [Module O M] [Module k M] [IsScalarTower k O M] :
    Module.finrank k M =
      (Module.length O M).toNat * Module.finrank k (IsLocalRing.ResidueField O) := by
  have hlocal : IsLocalHom (algebraMap k O) :=
    ⟨fun a ha ↦ by
      rcases eq_or_ne a 0 with rfl | h
      · rw [map_zero] at ha
        exact absurd ha not_isUnit_zero
      · exact isUnit_iff_ne_zero.2 h⟩
  have key := IsLocalRing.length_restrictScalars k O M
  rw [← Module.length_eq_of_surjective (S := k) (M := IsLocalRing.ResidueField O)
      IsLocalRing.residue_surjective] at key
  rw [finrank_eq_length_toNat, key, ENat.toNat_mul, ← finrank_eq_length_toNat]

/-- **The zeroth Fitting ideal of a finite module is the unit ideal exactly when the module
vanishes.** It is contained in the annihilator, and a module generated by no element has unit
zeroth Fitting ideal. -/
theorem fittingIdeal_zero_eq_top_iff {R : Type u} [CommRing R] (M : Type u) [AddCommGroup M]
    [Module R M] [Module.Finite R M] :
    _root_.fittingIdeal (R := R) (M := M) 0 = ⊤ ↔ Subsingleton M := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · have hann := (fittingIdeal_basic_properties.{u, u, u, u} (R := R) (M := M)).2.2.2.2.2.1
    rwa [h, top_le_iff, Module.annihilator_eq_top_iff] at hann
  · simpa using (fittingIdeal_basic_properties.{u, u, u, u} (R := R) (M := M)).1 0
      ⟨Fin.elim0, Subsingleton.elim _ _⟩

/-- **The support of `Ω_{X/Y}` is the closed subscheme cut out by the Kähler different**, its
zeroth Fitting ideal sheaf: at a point both say that `Ω_{𝒪_{X,x}/𝒪_{Y,f(x)}}` is nonzero. -/
theorem mem_supp_relativeDifferentials_iff {X Y : Scheme.{u}} (f : X ⟶ Y) [LocallyOfFiniteType f]
    (x : X) :
    x ∈ _root_.SheafOfModules.supp (Scheme.Hom.relativeDifferentials f) ↔
      x ∈ (kaehlerDifferent f).support := by
  classical
  let : DecidableEq (OrderDual (TopologicalSpace.OpenNhds x)) := Classical.decEq _
  let := (f.stalkMap x).hom.toAlgebra
  have := essFiniteType_stalkMap f x
  refine (_root_.SheafOfModules.mem_supp_iff_nontrivial_stalk _ x).trans ?_
  rw [← not_iff_not, not_nontrivial_iff_subsingleton,
    ← Stacks.Divisors.stalk_eq_top_iff_notMem_support,
    stalk_kaehlerDifferent_eq_fittingIdeal f x, fittingIdeal_zero_eq_top_iff]
  exact Equiv.subsingleton_congr
    (Stacks.RelativeDifferentialStalkMap.relativeDifferentialsStalkKaehlerEquiv f x).toEquiv

section Morphism

variable {k : Type u} [Field k] {X Y : Scheme.{u}} (pX : X ⟶ Spec (.of k))
  (pY : Y ⟶ Spec (.of k)) [IsCurve k pX] [IsCurve k pY] [Smooth pX] [Smooth pY] [IsProper pX]
  (f : X ⟶ Y) (hf : f ≫ pY = pX)

include hf in
/-- For a generically étale morphism of smooth curves with proper source, `Ω_{X/Y}` is coherent
and supported in dimension zero, away from the generic point. -/
theorem relativeDifferentials_supp_of_ne_zero
    (hdf : Scheme.Hom.relativeDifferentialsMap f pY pX (𝟙 (Spec (.of k)))
      (by simpa using hf) ≠ 0) :
    (Scheme.Hom.relativeDifferentials f).IsCoherent ∧
      genericPoint X ∉ _root_.SheafOfModules.supp (Scheme.Hom.relativeDifferentials f) ∧
      topologicalKrullDim (_root_.SheafOfModules.supp (Scheme.Hom.relativeDifferentials f)) ≤
        0 := by
  have : LocallyOfFiniteType f := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
  have : LocallyOfFiniteType pX := ‹IsProper pX›.toLocallyOfFiniteType
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian pX
  have : IsNoetherian X := isNoetherian_of_locallyOfFiniteType pX
  have : (Scheme.Hom.relativeDifferentials f).IsQuasicoherent :=
    Scheme.Hom.isQuasicoherent_relativeDifferentials f
  have hη : genericPoint X ∉ SheafOfModules.supp (Scheme.Hom.relativeDifferentials f) :=
    (exists_proper_closed_supset_supp_iff_genericPoint_notMem _).mp
      (((genericallyEtale_tfae pX pY f hf).out 1 2).mp hdf)
  exact ⟨Stacks.AlgebraicGeometry.CoherentTFAE.isCoherent'_of_isQuasicoherent_of_isFiniteType _,
    hη, topologicalKrullDim_supp_le_zero_of_genericPoint_notMem
    (IsCurve.topologicalKrullDim_eq_one (f := pX)).le
    (Scheme.Hom.relativeDifferentials f) inferInstance hη⟩

include hf in
/-- **The closed subscheme cut out by the different is finite over `k`**, for a generically étale
morphism of smooth curves with proper source: it is proper over `k` and, its points being the
finitely many points of the support of `Ω_{X/Y}`, of dimension zero. -/
theorem isFinite_kaehlerDifferent_subscheme
    (hdf : Scheme.Hom.relativeDifferentialsMap f pY pX (𝟙 (Spec (.of k)))
      (by simpa using hf) ≠ 0) :
    letI := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
    IsFinite ((kaehlerDifferent f).subschemeι ≫ pX) := by
  let := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
  obtain ⟨-, -, h0⟩ := relativeDifferentials_supp_of_ne_zero pX pY f hf hdf
  set R := kaehlerDifferent f
  have hind : Topology.IsInducing (fun z : R.subscheme ↦
      (⟨R.subschemeι z, (mem_supp_relativeDifferentials_iff f _).mpr z.2⟩ :
        _root_.SheafOfModules.supp (Scheme.Hom.relativeDifferentials f))) :=
    R.subschemeι.isClosedEmbedding.isInducing.codRestrict _
  have hdimR : topologicalKrullDim R.subscheme ≤ 0 := hind.topologicalKrullDim_le.trans h0
  have : LocallyOfFiniteType pX := ‹IsProper pX›.toLocallyOfFiniteType
  have : LocallyOfFiniteType R.subschemeι :=
    ((IsFinite.iff_isIntegralHom_and_locallyOfFiniteType _).mp inferInstance).2
  have : LocallyOfFiniteType (R.subschemeι ≫ pX) :=
    MorphismProperty.comp_mem _ _ _ inferInstance inferInstance
  have : QuasiCompact (R.subschemeι ≫ pX) :=
    MorphismProperty.comp_mem _ _ _ inferInstance inferInstance
  cases isEmpty_or_nonempty R.subscheme with
  | inl h => infer_instance
  | inr h =>
    have hdimR0 : topologicalKrullDim R.subscheme = 0 := by
      refine le_antisymm hdimR ?_
      obtain ⟨x⟩ := h
      have : Nonempty (TopologicalSpace.IrreducibleCloseds R.subscheme) :=
        ⟨⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
      exact Order.krullDim_nonneg
    exact isFinite_of_finiteType_of_dimension_zero k (R.subschemeι ≫ pX) hdimR0

include hf in
/-- **The stalk of `Ω_{X/Y}` at a point of its support has dimension `d_x [κ(x) : k]`**, where
`d_x` is the multiplicity of `x` in the closed subscheme cut out by the different
([Stacks, Tag 0C1F] (1)). -/
theorem finrank_stalk_relativeDifferentials_eq
    (hdf : Scheme.Hom.relativeDifferentialsMap f pY pX (𝟙 (Spec (.of k)))
      (by simpa using hf) ≠ 0)
    (x : X) (hx : x ∈ _root_.SheafOfModules.supp (Scheme.Hom.relativeDifferentials f)) :
    letI := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
    letI : Algebra k (X.presheaf.stalk x) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ pX.appTop ≫ X.presheaf.germ ⊤ x (by simp)).hom.toAlgebra
    Module.finrank k
        ((ModuleCat.restrictScalars ((Scheme.ΓSpecIso (.of k)).inv ≫ pX.appLE ⊤ ⊤ (by simp) ≫
          X.presheaf.germ ⊤ x trivial).hom).obj
            (OXModule.stalk (Scheme.Hom.relativeDifferentials f) x)) =
      (Module.length (X.presheaf.stalk x)
          (X.presheaf.stalk x ⧸ IdealSheafData.stalk (kaehlerDifferent f) x)).toNat *
        Module.finrank k (IsLocalRing.ResidueField (X.presheaf.stalk x)) := by
  let := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
  classical
  let : DecidableEq (OrderDual (TopologicalSpace.OpenNhds x)) := Classical.decEq _
  obtain ⟨-, hη, -⟩ := relativeDifferentials_supp_of_ne_zero pX pY f hf hdf
  have hxη : x ≠ genericPoint X := fun h ↦ hη (h ▸ hx)
  have hB := IsCurve.isDiscreteValuationRing_stalk k pX hxη
  have happ : pX.appLE ⊤ ⊤ (by simp) = pX.appTop := Scheme.Hom.appLE_eq_app _
  rw [happ]
  let : Algebra k (X.presheaf.stalk x) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ pX.appTop ≫ X.presheaf.germ ⊤ x (by simp)).hom.toAlgebra
  let : Module k (OXModule.stalk (Scheme.Hom.relativeDifferentials f) x) :=
    Module.compHom _ (algebraMap k (X.presheaf.stalk x))
  have : IsScalarTower k (X.presheaf.stalk x)
      (OXModule.stalk (Scheme.Hom.relativeDifferentials f) x) :=
    IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  refine (finrank_eq_length_mul_finrank_residueField_of_isLocalRing k (X.presheaf.stalk x)
    (OXModule.stalk (Scheme.Hom.relativeDifferentials f) x)).trans ?_
  congr 2
  let := (f.stalkMap x).hom.toAlgebra
  have := essFiniteType_stalkMap f x
  rw [stalk_kaehlerDifferent_eq_fittingIdeal, length_quotient_fittingIdeal_zero_eq_length]
  exact (Stacks.RelativeDifferentialStalkMap.relativeDifferentialsStalkKaehlerEquiv
    f x).length_eq

include hf in
/-- **`dim_k H⁰(X, Ω_{X/Y}) = dim_k Γ(R, 𝒪_R)`** for a generically étale morphism `f : X → Y` of
smooth curves over `k` with `X` proper, where `R` is the closed subscheme cut out by the
different of `f`: both are `∑_x d_x [κ(x) : k]` over the points of `R`, which are the points of
the support of `Ω_{X/Y}` ([Stacks, Tag 0AYT] (2) and [Stacks, Tag 0C1F] (1)). -/
theorem finrank_cohomologyOverField_relativeDifferentials_eq_finrank_sections
    (hdf : Scheme.Hom.relativeDifferentialsMap f pY pX (𝟙 (Spec (.of k)))
      (by simpa using hf) ≠ 0) :
    letI := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
    letI : Algebra k Γ((kaehlerDifferent f).subscheme, ⊤) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ ((kaehlerDifferent f).subschemeι ≫ pX).appTop).hom.toAlgebra
    Module.finrank k (cohomologyOverField k pX (Scheme.Hom.relativeDifferentials f) 0) =
      Module.finrank k Γ((kaehlerDifferent f).subscheme, ⊤) := by
  let := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
  obtain ⟨hc, -, h0⟩ := relativeDifferentials_supp_of_ne_zero pX pY f hf hdf
  have := isFinite_kaehlerDifferent_subscheme pX pY f hf hdf
  let : Fintype ↥(_root_.SheafOfModules.supp (Scheme.Hom.relativeDifferentials f)) :=
    (finite_supp_of_supp_le_zero k pX _ h0).fintype
  rw [finrank_cohomologyOverField_zero_eq_sum_finrank_stalk k pX _ h0,
    finrank_sections_subscheme_eq_finsum pX (kaehlerDifferent f), ← finsum_eq_sum_of_fintype]
  let e : ↥(_root_.SheafOfModules.supp (Scheme.Hom.relativeDifferentials f)) ≃
      (kaehlerDifferent f).subscheme :=
    Equiv.subtypeEquivRight fun x ↦ mem_supp_relativeDifferentials_iff f x
  rw [← finsum_comp_equiv e]
  exact finsum_congr fun x ↦ finrank_stalk_relativeDifferentials_eq pX pY f hf hdf x.1 x.2

omit [IsProper pX] in
include hf in
/-- A morphism of smooth curves with nonzero differential is dominant ([Stacks, Tag 0C1C]). -/
theorem isDominant_of_relativeDifferentialsMap_ne_zero
    (hdf : Scheme.Hom.relativeDifferentialsMap f pY pX (𝟙 (Spec (.of k)))
      (by simpa using hf) ≠ 0) : IsDominant f := by
  have h5 := ((genericallyEtale_tfae pX pY f hf).out 1 5).mp hdf
  exact h5.1

include hf in
/-- A dominant morphism of curves over `k` is not constant: a closed point of `X` would map to
the generic point of `Y`, which is not closed. -/
theorem not_constant_of_isDominant [IsDominant f] : ¬ ∃ y : Y, ∀ x : X, f.base x = y := by
  rintro ⟨y, hy⟩
  have : LocallyOfFiniteType pX := ‹IsProper pX›.toLocallyOfFiniteType
  have : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace pX
  obtain ⟨x₀, -, hx₀⟩ := nonempty_inter_closedPoints (X := X) (Z := Set.univ) Set.univ_nonempty
    isClosed_univ.isLocallyClosed
  have hcl := isClosed_map_of_isClosed pX pY f hf hx₀
  have hη : f (genericPoint X) = genericPoint Y := map_genericPoint_of_isDominant f
  have hy₀ : f x₀ = genericPoint Y := (hy x₀).trans ((hy (genericPoint X)).symm.trans hη)
  rw [hy₀] at hcl
  have hone : topologicalKrullDim (closure ({genericPoint (Y : Type u)} : Set Y)) = 1 :=
    (Stacks.AlgebraicGeometry.ComponentDegrees.mem_genericPointsOne_iff.mp
      (Stacks.AlgebraicGeometry.ComponentDegrees.genericPoint_self_mem_genericPointsOne Y
      (IsCurve.topologicalKrullDim_eq_one (f := pY)))).2
  rw [hcl.closure_eq] at hone
  have : Subsingleton ({genericPoint (Y : Type u)} : Set Y) :=
    Set.subsingleton_singleton.coe_sort
  have : DiscreteTopology ({genericPoint (Y : Type u)} : Set Y) := ⟨Subsingleton.elim _ _⟩
  have hzero : topologicalKrullDim ({genericPoint (Y : Type u)} : Set Y) ≤ 0 :=
    topologicalKrullDim_zero_of_discreteTopology _
  rw [hone] at hzero
  norm_num at hzero

include hf in
/-- **The Riemann–Hurwitz identity before computing the degrees of the differentials**
([Stacks, Tag 0C1D], all but [Stacks, Tag 0C1A]). Let `f : X → Y` be a morphism of smooth proper
curves over `k` whose differential `f^*Ω_{Y/k} → Ω_{X/k}` is nonzero, and let `R ⊆ X` be the
closed subscheme cut out by the different of `f`. Then
`deg(Ω_{X/k}) = deg(f) · deg(Ω_{Y/k}) + deg(R)`, where `deg(R) = dim_k Γ(R, 𝒪_R)`. -/
theorem curveDegree_relativeDifferentials_eq_degreeOver_mul_add [IsProper pY]
    (hdf : Scheme.Hom.relativeDifferentialsMap f pY pX (𝟙 (Spec (.of k)))
      (by simpa using hf) ≠ 0) :
    letI := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
    letI : IsDominant f := isDominant_of_relativeDifferentialsMap_ne_zero pX pY f hf hdf
    letI := isFiniteLocallyFreeOfRank_one_relativeDifferentials pX
    letI := isFiniteLocallyFreeOfRank_one_relativeDifferentials pY
    letI : Algebra k Γ((kaehlerDifferent f).subscheme, ⊤) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ ((kaehlerDifferent f).subschemeι ≫ pX).appTop).hom.toAlgebra
    curveDegree k pX (le_of_eq (IsCurve.topologicalKrullDim_eq_one (f := pX)))
        (Scheme.Hom.relativeDifferentials pX) 1 =
      (degreeOver f : ℤ) *
          curveDegree k pY (le_of_eq (IsCurve.topologicalKrullDim_eq_one (f := pY)))
            (Scheme.Hom.relativeDifferentials pY) 1 +
        Module.finrank k Γ((kaehlerDifferent f).subscheme, ⊤) := by
  let := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
  let : IsDominant f := isDominant_of_relativeDifferentialsMap_ne_zero pX pY f hf hdf
  let := isFiniteLocallyFreeOfRank_one_relativeDifferentials pX
  let := isFiniteLocallyFreeOfRank_one_relativeDifferentials pY
  rw [curveDegree_relativeDifferentials_eq_add_finrank pX pY f hf hdf,
    curveDegree_pullback_eq_degreeOver_mul k pX pY f hf (not_constant_of_isDominant pX pY f hf)
      (Scheme.Hom.relativeDifferentials pY) 1,
    finrank_cohomologyOverField_relativeDifferentials_eq_finrank_sections pX pY f hf hdf]

include hf in
/-- **The degree of the ramification divisor as a sum over closed points.** For a generically
étale morphism `f : X → Y` of smooth curves over `k` with `X` proper,
`deg(R) = dim_k Γ(R, 𝒪_R) = ∑_x d_x [κ(x) : k]`, the sum over the closed points `x` of `X`, where
`d_x = length_{𝒪_{X,x}}(𝒪_{X,x} / 𝓘_{R,x})` is the multiplicity of `x` in `R`. Only finitely many
terms are nonzero: `d_x = 0` off `R`, whose points are closed. -/
theorem finrank_sections_kaehlerDifferent_subscheme_eq_finsum_isClosed
    (hdf : Scheme.Hom.relativeDifferentialsMap f pY pX (𝟙 (Spec (.of k)))
      (by simpa using hf) ≠ 0) :
    letI := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
    letI : Algebra k Γ((kaehlerDifferent f).subscheme, ⊤) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ ((kaehlerDifferent f).subschemeι ≫ pX).appTop).hom.toAlgebra
    Module.finrank k Γ((kaehlerDifferent f).subscheme, ⊤) =
      ∑ᶠ x : {x : X // IsClosed ({x} : Set X)},
        letI : Algebra k (X.presheaf.stalk x.1) :=
          ((Scheme.ΓSpecIso (.of k)).inv ≫ pX.appTop ≫
            X.presheaf.germ ⊤ x.1 (by simp)).hom.toAlgebra
        (Module.length (X.presheaf.stalk x.1)
            (X.presheaf.stalk x.1 ⧸ IdealSheafData.stalk (kaehlerDifferent f) x.1)).toNat *
          Module.finrank k (IsLocalRing.ResidueField (X.presheaf.stalk x.1)) := by
  let := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
  have := isFinite_kaehlerDifferent_subscheme pX pY f hf hdf
  obtain ⟨-, hη, -⟩ := relativeDifferentials_supp_of_ne_zero pX pY f hf hdf
  set R := kaehlerDifferent f
  let F : X → ℕ := fun x ↦
    let : Algebra k (X.presheaf.stalk x) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ pX.appTop ≫ X.presheaf.germ ⊤ x (by simp)).hom.toAlgebra
    (Module.length (X.presheaf.stalk x)
        (X.presheaf.stalk x ⧸ IdealSheafData.stalk R x)).toNat *
      Module.finrank k (IsLocalRing.ResidueField (X.presheaf.stalk x))
  have hF : Function.support F ⊆ (R.support : Set X) := by
    intro x hx
    by_contra hxR
    refine hx ?_
    have hlen : Module.length (X.presheaf.stalk x)
        (X.presheaf.stalk x ⧸ IdealSheafData.stalk R x) = 0 := by
      rw [(Stacks.Divisors.stalk_eq_top_iff_notMem_support R x).mpr hxR]
      exact Module.length_eq_zero_iff.mpr (Ideal.Quotient.subsingleton_iff.mpr rfl)
    simp only [F, hlen, ENat.toNat_zero, zero_mul]
  have hcl : (R.support : Set X) ⊆ {x : X | IsClosed ({x} : Set X)} := fun x hx ↦
    Stacks.AlgebraicGeometry.AmpleDimensionOne.isClosed_singleton_of_ne_genericPoint X
      (IsCurve.topologicalKrullDim_eq_one (f := pX))
      (fun h ↦ hη (h ▸ (mem_supp_relativeDifferentials_iff f x).mpr hx))
  rw [finrank_sections_subscheme_eq_finsum pX R]
  change ∑ᶠ z : R.subscheme, F (R.subschemeι z) = ∑ᶠ x : {x : X // IsClosed ({x} : Set X)}, F x.1
  calc ∑ᶠ z : R.subscheme, F (R.subschemeι z)
      = ∑ᶠ x ∈ Set.range R.subschemeι, F x :=
        (finsum_mem_range R.subschemeι.isClosedEmbedding.injective).symm
    _ = ∑ᶠ x ∈ {x : X | IsClosed ({x} : Set X)}, F x := by
        rw [R.range_subschemeι, ← finsum_mem_inter_support F,
          ← finsum_mem_inter_support F {x : X | IsClosed ({x} : Set X)},
          Set.inter_eq_right.mpr hF, Set.inter_eq_right.mpr (hF.trans hcl)]
    _ = ∑ᶠ x : {x : X // IsClosed ({x} : Set X)}, F x.1 :=
        (finsum_set_coe_eq_finsum_mem {x : X | IsClosed ({x} : Set X)}).symm

include hf in
/-- **Stacks Project, Tag 0C1D (Riemann–Hurwitz).** Let `f : X → Y` be a morphism of smooth
proper curves over a field `k` whose differential `f^*Ω_{Y/k} → Ω_{X/k}` is nonzero (condition (1)
of [Stacks, Tag 0C1C]), with `H⁰(X, 𝒪_X) = k = H⁰(Y, 𝒪_Y)`, and let `R ⊆ X` be the closed
subscheme cut out by the different of `f`. Then `2g_X - 2 = (2g_Y - 2) deg(f) + deg(R)`, where
`deg(R) = dim_k Γ(R, 𝒪_R)`. -/
@[stacks 0C1D "the different is the Kähler different, which is the different of Tag 0BW4 by \
Tag 0BWG; the conditions of Tag 0C1C are stated as its condition (1)"]
theorem two_mul_genus_sub_two_eq_degreeOver_mul_add [IsProper pY]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ pX.appTop)]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ pY.appTop)]
    (hdf : Scheme.Hom.relativeDifferentialsMap f pY pX (𝟙 (Spec (.of k)))
      (by simpa using hf) ≠ 0) :
    letI := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
    letI : IsDominant f := isDominant_of_relativeDifferentialsMap_ne_zero pX pY f hf hdf
    letI : Algebra k Γ((kaehlerDifferent f).subscheme, ⊤) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ ((kaehlerDifferent f).subschemeι ≫ pX).appTop).hom.toAlgebra
    2 * (genus pX : ℤ) - 2 =
      (2 * (genus pY : ℤ) - 2) * (degreeOver f : ℤ) +
        Module.finrank k Γ((kaehlerDifferent f).subscheme, ⊤) := by
  let := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
  let : IsDominant f := isDominant_of_relativeDifferentialsMap_ne_zero pX pY f hf hdf
  let := isFiniteLocallyFreeOfRank_one_relativeDifferentials pX
  let := isFiniteLocallyFreeOfRank_one_relativeDifferentials pY
  have h := curveDegree_relativeDifferentials_eq_degreeOver_mul_add pX pY f hf hdf
  rw [curveDegree_relativeDifferentials_eq_two_mul_genus_sub_two pX,
    curveDegree_relativeDifferentials_eq_two_mul_genus_sub_two pY] at h
  linear_combination h

include hf in
/-- **Stacks Project, Tag 0C1F, the formula.** Under the assumptions of [Stacks, Tag 0C1D],
`2g_X - 2 = (2g_Y - 2) deg(f) + ∑_x d_x [κ(x) : k]`, the sum over the closed points `x` of `X`,
where `d_x = length_{𝒪_{X,x}}(𝒪_{X,x} / 𝓘_{R,x})` is the multiplicity of `x` in the closed
subscheme `R` cut out by the different of `f`. -/
@[stacks 0C1F "the formula 2g_X - 2 = (2g_Y - 2) deg(f) + Σ d_x [κ(x) : k] over the closed \
points x; the different is the Kähler different, which is the different of Tag 0BW4 by Tag 0BWG"]
theorem two_mul_genus_sub_two_eq_degreeOver_mul_add_finsum [IsProper pY]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ pX.appTop)]
    [IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ pY.appTop)]
    (hdf : Scheme.Hom.relativeDifferentialsMap f pY pX (𝟙 (Spec (.of k)))
      (by simpa using hf) ≠ 0) :
    letI := locallyOfFiniteType_of_isCurve_comp k pX pY f hf
    letI : IsDominant f := isDominant_of_relativeDifferentialsMap_ne_zero pX pY f hf hdf
    2 * (genus pX : ℤ) - 2 =
      (2 * (genus pY : ℤ) - 2) * (degreeOver f : ℤ) +
        ((∑ᶠ x : {x : X // IsClosed ({x} : Set X)},
          letI : Algebra k (X.presheaf.stalk x.1) :=
            ((Scheme.ΓSpecIso (.of k)).inv ≫ pX.appTop ≫
              X.presheaf.germ ⊤ x.1 (by simp)).hom.toAlgebra
          (Module.length (X.presheaf.stalk x.1)
              (X.presheaf.stalk x.1 ⧸ IdealSheafData.stalk (kaehlerDifferent f) x.1)).toNat *
            Module.finrank k (IsLocalRing.ResidueField (X.presheaf.stalk x.1)) : ℕ) : ℤ) := by
  rw [two_mul_genus_sub_two_eq_degreeOver_mul_add pX pY f hf hdf,
    finrank_sections_kaehlerDifferent_subscheme_eq_finsum_isClosed pX pY f hf hdf]

end Morphism

