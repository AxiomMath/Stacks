module

public import StacksFrontier.AlgebraicGeometry.RegularIdealSheafAffine.Algebra
public import StacksFrontier.AlgebraicGeometry.RegularImmersion.GermNonZeroDivisor
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The germwise regularity condition on an affine open is regularity in the ring of sections

Let `X` be a scheme, `U ⊆ X` an affine open and `f₀, …, f_{r-1}` sections of `O_X` over `U`.
The germwise condition appearing in the stalkwise form of Stacks tag 063D — that the germ of
`f i` at every point of `U` carries nothing into the ideal generated by the germs of its
predecessors from outside that ideal — is exactly the same relation condition for `f i` in the
ring `O_X(U)`.

Both directions are the local-global principle of
`StacksFrontier/AlgebraicGeometry/RegularIdealSheafAffine/Algebra.lean`: the stalk of `X` at a
point of an affine open `U` is the localization of `O_X(U)` at the corresponding prime, so the
relation condition over `O_X(U)` localizes to every stalk, and conversely a relation over
`O_X(U)` can be checked at the maximal ideals, each of which is the prime of a point of `U`
because `U` is affine.

## Main results

* `precedingFamilyIdeal_eq_span_image`: the ideal of the stalk generated by the germs of the
  predecessors is the span of the image of the predecessors under the germ map.
* `forall_isRegularRel_germFamily_iff`: the germwise relation condition over `U` is the relation
  condition in `O_X(U)`.
* `forall_mem_nonZeroDivisors_germFamily_iff_isWeaklyRegular`: the germwise condition of
  `isRegularSequenceOn_iff_germFamily`, for all indices at once, is
  `RingTheory.Sequence.IsWeaklyRegular` of the sequence in `O_X(U)`.

## Implementation notes

The `Algebra (O_X(U)) (O_{X,y})` instance and the `IsLocalization` statement for it are
introduced inside the proofs, by `let` and `have`: the instance of
`TopCat.Presheaf.algebra_section_stalk` is indexed by a point *of the subtype* `↥U`, so it is
not found by instance search at a stalk written at a point of `X` together with a membership
proof.  For that reason no statement here mentions `algebraMap`; they are all phrased with
`germFamily` and `precedingFamilyIdeal`, which is also the vocabulary of
`isRegularSequenceOn_iff_germFamily`.

The surjection from the points of `U` onto the primes of `O_X(U)` is the underlying map of
`IsAffineOpen.isoSpec`, which is an isomorphism of schemes, so its underlying continuous map is
bijective.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.AlgebraicGeometry.RegularIdealSheaf
open Stacks.RingTheory.RegularIdealSheafAffine

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheafAffine

variable (X : Scheme.{u}) (U : X.Opens) {r : ℕ} (f : Fin r → Γ(X, U))

/-- The ideal of the stalk at a point of `U` generated by the germs of the members of `f`
preceding `f i` is the image of `precedingIdeal f i` under the germ map. -/
theorem precedingFamilyIdeal_eq_span_image (i : Fin r) (y : X) (hy : y ∈ U) :
    precedingFamilyIdeal X.toRingedSpace U f i y hy
      = Ideal.span ((X.presheaf.germ U y hy).hom '' (Set.range fun j : Fin i.val =>
          f ⟨j.val, j.isLt.trans i.isLt⟩)) := by
  rw [precedingFamilyIdeal, Jid, ← Set.range_comp]
  rfl

/-- Over the stalk at a point of `U`, the ideal generated by the germs of the predecessors is the
extension of `precedingIdeal f i` along the algebra map from the sections. -/
private theorem precedingFamilyIdeal_eq_map (i : Fin r) (z : ↥U) :
    letI := TopCat.Presheaf.algebra_section_stalk X.presheaf z
    precedingFamilyIdeal X.toRingedSpace U f i z.1 z.2
      = Ideal.map (algebraMap Γ(X, U) (X.presheaf.stalk z.1))
        (RingTheory.RegularIdealSheafAffine.precedingIdeal f i) := by
  rw [precedingFamilyIdeal_eq_span_image, RingTheory.RegularIdealSheafAffine.precedingIdeal,
    Ideal.map_span]
  rfl

/-- **The germwise relation condition on an affine open.** The germ of `f i` at every point of
an affine open `U` carries nothing into the ideal generated by the germs of its predecessors
from outside it exactly when `f i` does so in `O_X(U)`. -/
theorem forall_isRegularRel_germFamily_iff (hU : IsAffineOpen U) (i : Fin r) :
    (∀ (y : X) (hy : y ∈ U),
        IsRegularRel (germFamily X.toRingedSpace U f y hy i)
          (precedingFamilyIdeal X.toRingedSpace U f i y hy)) ↔
      IsRegularRel (f i) (RingTheory.RegularIdealSheafAffine.precedingIdeal f i) := by
  refine ⟨fun h a ha => ?_, fun h y hy => ?_⟩
  · refine Stacks.RingTheory.RegularIdealSheaf.mem_of_forall_maximal
      (RingTheory.RegularIdealSheafAffine.precedingIdeal f i) a fun m hm => ?_
    obtain ⟨z, hz⟩ := (ConcreteCategory.bijective_of_isIso
      (Scheme.forgetToTop.map hU.isoSpec.hom)).2 (⟨m, hm.isPrime⟩ : PrimeSpectrum Γ(X, U))
    let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf z
    have _ := hU.isLocalization_stalk z
    have hmz : (hU.primeIdealOf z).asIdeal = m := congrArg PrimeSpectrum.asIdeal hz
    have hstalk : IsRegularRel (algebraMap Γ(X, U) (X.presheaf.stalk z.1) (f i))
        (Ideal.map (algebraMap Γ(X, U) (X.presheaf.stalk z.1))
          (RingTheory.RegularIdealSheafAffine.precedingIdeal f i)) := by
      rw [← precedingFamilyIdeal_eq_map X U f i z]
      exact h z.1 z.2
    obtain ⟨t, htT, hta⟩ := exists_mul_mem_of_isRegularRel_localization
      (hU.primeIdealOf z).asIdeal.primeCompl (X.presheaf.stalk z.1) hstalk a ha
    exact ⟨t, hmz ▸ htT, hta⟩
  · let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨y, hy⟩ : ↥U)
    have _ := hU.isLocalization_stalk (⟨y, hy⟩ : ↥U)
    rw [precedingFamilyIdeal_eq_map X U f i ⟨y, hy⟩]
    exact IsRegularRel.localization (hU.primeIdealOf (⟨y, hy⟩ : ↥U)).asIdeal.primeCompl
      (X.presheaf.stalk y) h

/-- **The germwise condition of Stacks tag 063D on an affine open is weak regularity in the ring
of sections.** -/
@[ega "IV 20.1.3" "special case"]
theorem forall_mem_nonZeroDivisors_germFamily_iff_isWeaklyRegular (hU : IsAffineOpen U) :
    (∀ (i : Fin r) (y : X) (hy : y ∈ U),
        Ideal.Quotient.mk (precedingFamilyIdeal X.toRingedSpace U f i y hy)
            (germFamily X.toRingedSpace U f y hy i) ∈
          nonZeroDivisors (X.presheaf.stalk y ⧸
            precedingFamilyIdeal X.toRingedSpace U f i y hy)) ↔
      RingTheory.Sequence.IsWeaklyRegular Γ(X, U) (List.ofFn f) := by
  rw [isWeaklyRegular_ofFn_iff]
  refine forall_congr' fun i => ?_
  rw [← forall_isRegularRel_germFamily_iff X U f hU i]
  exact forall_congr' fun y => forall_congr' fun hy =>
    mem_nonZeroDivisors_quotient_iff_forall _ _

end Stacks.AlgebraicGeometry.RegularIdealSheafAffine

end
