module

public import Mathlib.Data.Fin.Tuple.Take
public import Mathlib.RingTheory.Regular.RegularSequence
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Algebra
public import StacksFrontier.RingTheory.Sequence.Regular.Basic

/-!
# Regularity of a sequence as a relation condition, and its local-global principle

Let `R` be a commutative ring and `f : Fin r → R` a finite sequence.  Weak regularity of `f`
asks that each `f i` be a nonzerodivisor on `R / (f₀, …, f_{i-1})`, which spelled out on
elements is the *relation condition* `IsRegularRel (f i) (precedingIdeal f i)`: an element
carried into the ideal generated by the predecessors by multiplication by `f i` already lies in
that ideal.

Being a condition on elements and ideals, it transports to a localization by clearing
denominators, and conversely a relation over `R` which holds at the localization at every maximal
ideal holds over `R`, by the local nature of ideal membership.  Neither direction uses flatness or
finite generation.

## Main definitions

* `precedingIdeal f i`: the ideal generated by the members of `f` strictly preceding `f i`.
* `IsRegularRel x I`: multiplication by `x` carries nothing into `I` from outside `I`.

## Main results

* `isRegularRel_iff_isSMulRegular`: the relation condition is Mathlib's `IsSMulRegular` on the
  quotient by the ideal.
* `isWeaklyRegular_ofFn_iff` and `isRegular_ofFn_iff`: `RingTheory.Sequence.IsWeaklyRegular` and
  `RingTheory.Sequence.IsRegular` of `List.ofFn f` in the relation vocabulary.
* `IsRegularRel.localization`: the relation condition passes to any localization of `R`.
* `exists_mul_mem_of_isRegularRel_localization`: the converse step, which produces from the
  relation condition at one localization an element of the localizing submonoid carrying the
  witness into the ideal; combined with
  `Stacks.RingTheory.RegularIdealSheaf.mem_of_forall_maximal` over the maximal ideals this is
  the local-global principle.

## Implementation notes

`Ideal.ofList ((List.ofFn f).take i)` is converted to `precedingIdeal f i` through
`Fin.ofFn_take_eq_take_ofFn`, so no list induction appears.  The index of
`RingTheory.Sequence.isWeaklyRegular_iff_Fin` lives in `Fin (List.ofFn f).length` rather than
`Fin r`, and the two are related by `finCongr List.length_ofFn`; the equivalence is used through
`Equiv.forall_congr` rather than by rewriting the length, which would have to transport the
`getElem` proofs.

Both localization statements are about `Ideal.map (algebraMap R S) I` rather than about
`Submodule.localized`.
-/

@[expose] public section

open RingTheory.Sequence
open scoped Pointwise

namespace Stacks.RingTheory.RegularIdealSheafAffine

variable {R : Type*} [CommRing R] {r : ℕ}

section Defs

/-- The ideal of `R` generated by the members of `f` strictly preceding `f i`. -/
def precedingIdeal (f : Fin r → R) (i : Fin r) : Ideal R :=
  Ideal.span (Set.range fun j : Fin i.val => f ⟨j.val, j.isLt.trans i.isLt⟩)

/-- **The relation form of regularity of `x` modulo `I`.** Multiplication by `x` carries no
element into `I` from outside `I`; equivalently `x` is a nonzerodivisor on `R / I`. -/
def IsRegularRel (x : R) (I : Ideal R) : Prop :=
  ∀ a : R, x * a ∈ I → a ∈ I

/-- `IsRegularRel x I` holds exactly when `x` is `IsSMulRegular` on the quotient of `R` by the
submodule `I • ⊤`. -/
theorem isRegularRel_iff_isSMulRegular (x : R) (I : Ideal R) :
    IsRegularRel x I ↔ IsSMulRegular (R ⧸ (I • (⊤ : Submodule R R))) x := by
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  have hI : (I • (⊤ : Submodule R R)) = (I : Submodule R R) := by simp
  rw [hI]
  simp only [smul_eq_mul]
  rfl

/-- `IsRegularRel x I` holds exactly when `x` is `IsSMulRegular` on the quotient ring `R ⧸ I`. -/
theorem isRegularRel_iff_isSMulRegular_quotient (x : R) (I : Ideal R) :
    IsRegularRel x I ↔ IsSMulRegular (R ⧸ I) x :=
  (isSMulRegular_quotient_iff_mem_of_smul_mem (I : Submodule R R) x).symm

end Defs

section Lists

/-- The ideal generated by an initial segment of a sequence. -/
theorem ofList_take_ofFn (f : Fin r → R) {k : ℕ} (hk : k ≤ r) :
    Ideal.ofList ((List.ofFn f).take k)
      = Ideal.span (Set.range fun j : Fin k => f (Fin.castLE hk j)) := by
  rw [← Fin.ofFn_take_eq_take_ofFn hk f, Ideal.ofList_ofFn]
  rfl

/-- The ideal generated by the members preceding `f i`, as an initial segment. -/
theorem ofList_take_ofFn_val (f : Fin r → R) (i : Fin r) :
    Ideal.ofList ((List.ofFn f).take i.val) = precedingIdeal f i :=
  ofList_take_ofFn f i.isLt.le

end Lists

section WeaklyRegular

/-- **Weak regularity in the relation form.** The sequence `f` is weakly regular on `R` exactly
when each member carries nothing into the ideal of its predecessors from outside it. -/
theorem isWeaklyRegular_ofFn_iff (f : Fin r → R) :
    IsWeaklyRegular R (List.ofFn f) ↔ ∀ i : Fin r, IsRegularRel (f i) (precedingIdeal f i) := by
  rw [isWeaklyRegular_iff_Fin]
  have hlen : (List.ofFn f).length = r := List.length_ofFn
  refine (finCongr hlen).forall_congr fun i => ?_
  have hget : (List.ofFn f)[i] = f (finCongr hlen i) := by
    simp only [Fin.getElem_fin, List.getElem_ofFn, finCongr_apply]
    rfl
  have hideal : (Ideal.ofList ((List.ofFn f).take i.val) • (⊤ : Submodule R R))
      = ((precedingIdeal f (finCongr hlen i) : Ideal R) • (⊤ : Submodule R R)) := by
    congr 1
    rw [ofList_take_ofFn f (by simpa [hlen] using i.isLt.le), precedingIdeal]
    rfl
  rw [isRegularRel_iff_isSMulRegular, hget, hideal]

/-- **Regularity in the relation form.** Mathlib's `IsRegular` adds to weak regularity that the
quotient by the whole sequence is nonzero, which for `R` as a module over itself is that the
sequence does not generate the unit ideal. -/
theorem isRegular_ofFn_iff (f : Fin r → R) :
    IsRegular R (List.ofFn f) ↔
      (∀ i : Fin r, IsRegularRel (f i) (precedingIdeal f i)) ∧
        Ideal.span (Set.range f) ≠ ⊤ := by
  rw [isRegular_iff, isWeaklyRegular_ofFn_iff]
  refine and_congr_right' ?_
  have h : (Ideal.ofList (List.ofFn f) • (⊤ : Submodule R R))
      = ((Ideal.span (Set.range f) : Ideal R) : Submodule R R) := by
    simp [Ideal.ofList_ofFn]
  rw [h]
  exact ne_comm

end WeaklyRegular

section Localization

variable (T : Submonoid R) (S : Type*) [CommRing S] [Algebra R S] [IsLocalization T S]

include T in
/-- **The relation condition passes to a localization.** Clearing denominators reduces the
relation over `S` to one over `R`. -/
theorem IsRegularRel.localization {x : R} {I : Ideal R} (h : IsRegularRel x I) :
    IsRegularRel (algebraMap R S x) (Ideal.map (algebraMap R S) I) := by
  intro v hv
  obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj T v
  have hb : algebraMap R S x * algebraMap R S b ∈ Ideal.map (algebraMap R S) I := by
    rw [← hbs, ← mul_assoc]
    exact Ideal.mul_mem_right _ _ hv
  rw [← map_mul] at hb
  obtain ⟨t, htT, hta⟩ :=
    Stacks.RingTheory.RegularIdealSheaf.exists_mul_mem_of_algebraMap_mem T S I _ hb
  have htb : t * b ∈ I := h _ (by rwa [← mul_assoc, mul_comm x t, mul_assoc])
  have hmem : (algebraMap R S t * algebraMap R S (s : R)) * v
      ∈ Ideal.map (algebraMap R S) I := by
    have hr : (algebraMap R S t * algebraMap R S (s : R)) * v
        = algebraMap R S t * (v * algebraMap R S (s : R)) := by ring
    rw [hr, hbs, ← map_mul]
    exact Ideal.mem_map_of_mem _ htb
  have hunit : IsUnit (algebraMap R S t * algebraMap R S (s : R)) :=
    (IsLocalization.map_units S (⟨t, htT⟩ : T)).mul (IsLocalization.map_units S s)
  exact ((Ideal.map (algebraMap R S) I).unit_mul_mem_iff_mem hunit).mp hmem

/-- **The local-global step.** From the relation condition at one localization, an element of
the localizing submonoid carries the witness into the ideal over `R`. -/
theorem exists_mul_mem_of_isRegularRel_localization {x : R} {I : Ideal R}
    (h : IsRegularRel (algebraMap R S x) (Ideal.map (algebraMap R S) I))
    (a : R) (ha : x * a ∈ I) : ∃ t ∈ T, t * a ∈ I := by
  refine Stacks.RingTheory.RegularIdealSheaf.exists_mul_mem_of_algebraMap_mem T S I a (h _ ?_)
  rw [← map_mul]
  exact Ideal.mem_map_of_mem _ ha

end Localization

end Stacks.RingTheory.RegularIdealSheafAffine

end
