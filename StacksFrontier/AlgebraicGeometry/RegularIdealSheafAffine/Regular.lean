module

public import StacksFrontier.AlgebraicGeometry.RegularIdealSheafAffine.Affine
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheafAffine.Support
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularImmersion.AffineRegular
public import StacksCore.Tactic.StacksAttribute

/-!
# Affine-local characterization of regular ideal sheaves

Let `X` be a scheme and `J ⊆ O_X` a sheaf of ideals.  Then `J` is regular if and only if, around
each point of the support of `O_X / J`, it is generated on an affine open by a sequence which is
a regular sequence in the ring of sections of that open.

The sheaf side is a condition on monomorphisms of the quotient sheaves of Stacks tag 0639, and
the library already reduces it to a germwise nonzerodivisor condition at the points of the
witness open (`isRegularSequenceOn_iff_germFamily`).  Over an affine open those germwise
conditions are weak regularity of the sequence in the ring of sections, which is the content of
`Affine.lean`.  What remains, and is the only use made of the support hypothesis, is the
nondegeneracy clause of a regular sequence: `O_X(U) / (f₀, …, f_{r-1}) ≠ 0`.  Were the sequence
to generate the unit ideal, the ideal sheaf would be all of `O_X` on every subopen of the
witness open, and then the quotient would have no support there, by `Support.lean`.

## Main results

* `isRegularSequenceOn_iff_isRegularRel`: the germwise form of the regular condition in the
  relation vocabulary.
* `isRegularIdealSheaf_iff_exists_affine_generators`: **Stacks tag 063G**, the regular case.

## Implementation notes

The nondegeneracy clause is where the two sides are genuinely not equivalent pointwise: the
sheaf condition of tag 063D says nothing about the quotient being nonzero, and a sequence
generating the unit ideal satisfies it vacuously.  It is the support hypothesis that rules that
out, and only in the forward direction; the converse discards the clause.

The affine open produced in the forward direction is a basis element contained in the given
witness open, so the generating sequence is restricted to it;
`Stacks.AlgebraicGeometry.RegularIdealSheaf.isGeneratedByOn_of_le` and
`Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularSequenceOn_of_le` carry the two hypotheses
across that restriction.

Over an affine open the regular condition is weak regularity in the ring of sections, which is
`Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularSequenceOn_iff_isWeaklyRegular`; the
statement below differs from that one only in the nondegeneracy clause, which is what makes it
the faithful reading of tag 063G.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.AlgebraicGeometry.RegularIdealSheaf
open Stacks.RingTheory.RegularIdealSheafAffine
open Stacks.RingedSpace

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheafAffine

section Pointwise

variable (X : RingedSpace.{u, u}) (U : Opens X) {r : ℕ} (g : Fin r → X.presheaf.obj (op U))

/-- **The regular condition of Stacks tag 063D in the relation vocabulary.** -/
theorem isRegularSequenceOn_iff_isRegularRel :
    IsRegularSequenceOn X U g ↔ ∀ (i : Fin r) (y : X) (hy : y ∈ U),
      IsRegularRel (germFamily X U g y hy i) (precedingFamilyIdeal X U g i y hy) := by
  rw [isRegularSequenceOn_iff_germFamily]
  exact forall_congr' fun i => forall_congr' fun y => forall_congr' fun hy =>
    mem_nonZeroDivisors_quotient_iff_forall _ _

/-- The ideal of the stalk generated by the germs of a family is the image of the ideal the
family generates. -/
theorem Jid_germFamily_eq_map (y : X) (hy : y ∈ U) :
    Jid (germFamily X U g y hy)
      = Ideal.map (X.presheaf.germ U y hy).hom (Ideal.span (Set.range g)) := by
  rw [Jid, Ideal.map_span, ← Set.range_comp]
  rfl

/-- **A sequence generating the unit ideal generates everything.** If the sections `g` generate
the unit ideal of `O_X(U)` and generate `J` over `U`, then `J` has all sections of `O_X` over
every subopen of `U`. -/
theorem eq_top_of_span_eq_top {J : (structureSheafModule X).Submodule}
    (hgen : IsGeneratedByOn X J U g) (hspan : Ideal.span (Set.range g) = ⊤)
    (V : Opens X) (hVU : V ≤ U) : J.obj (op V) = ⊤ := by
  rw [hgen V hVU]
  refine le_antisymm le_top fun s _ => ?_
  refine (mem_generatedIdealOn_iff U g V hVU s).mpr fun y hy => ?_
  rw [Jid_germFamily_eq_map X U g y (hVU hy), hspan, Ideal.map_top]
  exact Submodule.mem_top

end Pointwise

/-- **Stacks Project, Tag 063G (regular).** A sheaf of ideals on a scheme is regular if and only
if, around each point of the support of its quotient, it is generated on an affine open by a
regular sequence in the ring of sections of that open. -/
@[stacks 063G "regular"]
theorem isRegularIdealSheaf_iff_exists_affine_generators (X : Scheme.{u})
    (J : (structureSheafModule X.toRingedSpace).Submodule) :
    IsRegularIdealSheaf X.toRingedSpace J ↔
      ∀ x : X, x ∈ idealQuotientSupport X.toRingedSpace J →
        ∃ (U : Opens X) (_hx : x ∈ U) (_hU : IsAffineOpen U) (r : ℕ)
          (f : Fin r → X.presheaf.obj (op U)),
          RingTheory.Sequence.IsRegular (X.presheaf.obj (op U)) (List.ofFn f) ∧
            IsGeneratedByOn X.toRingedSpace J U f := by
  refine ⟨fun h x hx => ?_, fun h x hx => ?_⟩
  · obtain ⟨U₀, hxU₀, r, f, hreg, hgen⟩ := h x hx
    obtain ⟨V, hV, hxV, hVU₀⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens hxU₀
    have hgen' := isGeneratedByOn_of_le U₀ f hgen V hVU₀
    refine ⟨V, hxV, hV, r, fun i => X.presheaf.map (homOfLE hVU₀).op (f i), ?_, hgen'⟩
    have hwr : RingTheory.Sequence.IsWeaklyRegular Γ(X, V)
        (List.ofFn fun i => X.presheaf.map (homOfLE hVU₀).op (f i)) :=
      (isRegularSequenceOn_iff_isWeaklyRegular X V hV _).mp
        (isRegularSequenceOn_of_le X.toRingedSpace hVU₀ f hreg)
    refine (isRegular_ofFn_iff _).mpr
      ⟨(isWeaklyRegular_ofFn_iff _).mp hwr, fun hspan => ?_⟩
    exact notMem_idealQuotientSupport X.toRingedSpace J V
      (eq_top_of_span_eq_top X.toRingedSpace V _ hgen' hspan) x hxV hx
  · obtain ⟨U, hxU, hU, r, f, hreg, hgen⟩ := h x hx
    exact ⟨U, hxU, r, f,
      (isRegularSequenceOn_iff_isWeaklyRegular X U hU f).mpr hreg.toIsWeaklyRegular, hgen⟩

end Stacks.AlgebraicGeometry.RegularIdealSheafAffine

end
