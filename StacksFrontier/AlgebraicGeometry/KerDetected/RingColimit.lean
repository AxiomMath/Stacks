module

public import Mathlib.Algebra.Category.Ring.Colimits
public import Mathlib.CategoryTheory.Filtered.Basic
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Defs
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Kernels in a filtered colimit of rings, and in a pushout along a surjection

Two ring-theoretic inputs for Stacks 0CNQ, both about a *given* colimit or pushout cocone
rather than about `CategoryTheory.Limits.colimit`, because the cocones they are applied to
arise as `AlgebraicGeometry.Scheme.Γ.mapCocone` of a limit cone of schemes.

## Main results

* `AlgebraicGeometry.GoodDiagramKer.exists_ι_app_eq`: every element of the vertex of a
  filtered colimit cocone of rings is in the image of one of the cocone maps.
* `AlgebraicGeometry.GoodDiagramKer.ker_desc_eq_iSup_map`: the kernel of the morphism out
  of a filtered colimit of rings induced by a cone of ring maps to a fixed ring is the
  supremum of the images of the kernels at the stages.
* `AlgebraicGeometry.GoodDiagramKer.ker_eq_map_of_isPushout_of_surjective`: in a pushout
  square of commutative rings whose left-hand map is surjective, the kernel of the opposite
  edge is the image of the kernel of that map.

## Route

Joint surjectivity is proved by exhibiting the subring generated by the images of the
cocone maps as a cocone itself: the descent morphism into it, followed by the inclusion, is
the identity on the vertex, so every element of the vertex lies in that subring, which for
a directed family of subrings means it lies in one of them.

The kernel identity then follows: an element of the kernel comes from some stage, where it
lies in the kernel at that stage by the factorisation of the descent morphism.

For the pushout square, the ideal generated by the image of the kernel is contained in the
kernel of the opposite edge because the square commutes; for the converse the quotient by
that ideal receives compatible maps from both sides of the square — from the surjection's
source by `RingHom.liftOfSurjective` — so the pushout property produces a retraction of the
quotient map through that edge.

## References

* [Stacks Project, Tag 0CNQ](https://stacks.math.columbia.edu/tag/0CNQ).
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe w v u

namespace AlgebraicGeometry.GoodDiagramKer

variable {J : Type v} [Category.{w} J] [IsFiltered J] {F : J ⥤ CommRingCat.{u}}

/-- Every element of the vertex of a filtered colimit cocone of commutative rings is the
image of an element at some stage. -/
theorem exists_ι_app_eq (c : Cocone F) (hc : IsColimit c) (x : c.pt) :
    ∃ (j : J) (a : F.obj j), (c.ι.app j).hom a = x := by
  let S (j : J) : Subring c.pt := (c.ι.app j).hom.range
  let R : Subring c.pt := ⨆ j, S j
  have hR (j : J) : (c.ι.app j).hom.range ≤ R := le_iSup S j
  let ι : CommRingCat.of R ⟶ c.pt := CommRingCat.ofHom R.subtype
  let d : Cocone F :=
    { pt := CommRingCat.of R
      ι :=
      { app j := CommRingCat.ofHom
          ((Subring.inclusion (S := (c.ι.app j).hom.range) (T := R) (hR j)).comp
            (c.ι.app j).hom.rangeRestrict)
        naturality := by
          intro i j g
          ext a
          exact Subtype.ext (congrArg (fun h : F.obj i ⟶ c.pt => h.hom a) (c.w g)) } }
  have h : hc.desc d ≫ ι = 𝟙 c.pt := by
    refine hc.hom_ext fun j => ?_
    rw [← Category.assoc, hc.fac]
    rfl
  have hx : x ∈ R := by
    have hval := congrArg (fun h : c.pt ⟶ c.pt => h.hom x) h
    change ((hc.desc d).hom x : c.pt) = x at hval
    rw [← hval]
    exact ((hc.desc d).hom x).property
  have hd : Directed (· ≤ ·) S := by
    intro i j
    obtain ⟨k, gi, gj, -⟩ := IsFilteredOrEmpty.cocone_objs i j
    refine ⟨k, ?_, ?_⟩
    · rintro _ ⟨a, rfl⟩
      exact ⟨(F.map gi).hom a, congrArg (fun h : F.obj i ⟶ c.pt => h.hom a) (c.w gi)⟩
    · rintro _ ⟨a, rfl⟩
      exact ⟨(F.map gj).hom a, congrArg (fun h : F.obj j ⟶ c.pt => h.hom a) (c.w gj)⟩
  have : Nonempty J := IsFiltered.nonempty
  exact (Subring.mem_iSup_of_directed hd).mp hx

/-- The kernel of the morphism out of a filtered colimit of rings determined by a family of
ring maps to a fixed ring is the supremum of the images of the kernels at the stages. -/
theorem ker_desc_eq_iSup_map {A : CommRingCat.{u}} (c : Cocone F) (hc : IsColimit c)
    (g : F ⟶ (Functor.const J).obj A) :
    RingHom.ker (hc.desc (Cocone.mk A g)).hom =
      ⨆ j : J, Ideal.map (R := F.obj j) (S := c.pt) (c.ι.app j).hom
        (RingHom.ker (g.app j).hom) := by
  let d := hc.desc (Cocone.mk A g)
  have hfac (j : J) : d.hom.comp (c.ι.app j).hom = (g.app j).hom :=
    congrArg CommRingCat.Hom.hom (hc.fac _ j)
  refine le_antisymm (fun x hx => ?_) (iSup_le fun j => ?_)
  · obtain ⟨j, a, ha⟩ := exists_ι_app_eq c hc x
    have hga : (g.app j).hom a = 0 := by
      have h := congrArg d.hom ha
      rw [← RingHom.comp_apply, hfac j] at h
      rw [RingHom.mem_ker] at hx
      exact h.trans hx
    rw [← ha]
    exact Submodule.mem_iSup_of_mem j (Ideal.mem_map_of_mem _ (RingHom.mem_ker.mpr hga))
  · refine Ideal.map_le_iff_le_comap.mpr fun a ha => ?_
    show (c.ι.app j).hom a ∈ RingHom.ker d.hom
    rw [RingHom.mem_ker, ← RingHom.comp_apply, hfac j]
    exact RingHom.mem_ker.mp ha

/-- In a pushout square of commutative rings whose left-hand edge `f` is surjective, the
kernel of the edge opposite to `f` is the image under the top edge of the kernel of `f`. -/
theorem ker_eq_map_of_isPushout_of_surjective {A B C E : Type u} [CommRing A] [CommRing B]
    [CommRing C] [CommRing E] (f : A →+* B) (g : A →+* C) (h : B →+* E) (k : C →+* E)
    (sq : IsPushout (CommRingCat.ofHom f) (CommRingCat.ofHom g)
      (CommRingCat.ofHom h) (CommRingCat.ofHom k))
    (hf : Function.Surjective f) :
    RingHom.ker k = Ideal.map g (RingHom.ker f) := by
  let Jd : Ideal C := Ideal.map g (RingHom.ker f)
  have hJ : Jd ≤ RingHom.ker k := by
    refine Ideal.map_le_iff_le_comap.mpr fun x hx => ?_
    show k (g x) = 0
    have heq : h.comp f = k.comp g := by
      simpa using congrArg CommRingCat.Hom.hom sq.w
    rw [← RingHom.comp_apply, ← heq, RingHom.comp_apply]
    simp [RingHom.mem_ker.mp hx]
  let q : C →+* C ⧸ Jd := Ideal.Quotient.mk Jd
  have hker : RingHom.ker f ≤ RingHom.ker (q.comp g) := fun x hx =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem g hx)
  let l : B →+* C ⧸ Jd := (f.liftOfSurjective hf) ⟨q.comp g, hker⟩
  have hl : l.comp f = q.comp g := f.liftOfSurjective_comp hf ⟨q.comp g, hker⟩
  let t : E →+* C ⧸ Jd :=
    (sq.desc (CommRingCat.ofHom l) (CommRingCat.ofHom q) (CommRingCat.hom_ext hl)).hom
  have ht : t.comp k = q :=
    congrArg CommRingCat.Hom.hom
      (sq.inr_desc (CommRingCat.ofHom l) (CommRingCat.ofHom q) (CommRingCat.hom_ext hl))
  refine le_antisymm (fun x hx => Ideal.Quotient.eq_zero_iff_mem.mp ?_) hJ
  show q x = 0
  rw [← ht]
  simp [RingHom.mem_ker.mp hx]

end AlgebraicGeometry.GoodDiagramKer

end
