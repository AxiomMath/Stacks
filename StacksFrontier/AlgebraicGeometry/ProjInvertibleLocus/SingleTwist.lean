module

public import StacksFrontier.AlgebraicGeometry.GoodOpenClose.Pointwise
public import StacksFrontier.AlgebraicGeometry.GoodOpenClose.Restrict
public import StacksFrontier.AlgebraicGeometry.InvertibleTrivialization.Basic
public import StacksFrontier.AlgebraicGeometry.ProjInvertibleLocus.Basic
public import StacksFrontier.AlgebraicGeometry.ProjStalkGlobalSections.Stalk

/-!
# The locus on `Proj S` where a single twist is invertible

Let `S` be a graded ring, `X = Proj(S)` and `n` an integer. The open subset of `X` on which the
single sheaf `𝒪_X(n)` is invertible is the union of the opens `U` such that the restriction
`𝒪_X(n)|_U` is an invertible `𝒪_U`-module. This is the locus the source means when it speaks of
"the locus where the sheaf `𝒪_X(1)` is invertible" (Tag 01NL). It contains Tag 01MU's open
`W_1`, on which in addition every other twist is invertible and every multiplication map is an
isomorphism, and it can be strictly larger.

At a point `x` of this locus the module `𝒪_X(n)` is free of rank one near `x` (Tag 0B8M), so its
stalk is generated by a single element over the local ring `𝒪_{X,x}`. Through the identification
of that stalk with the degree-zero localization `S(n)₍x₎` (Tag 01M7), every element of
`S(n)₍x₎` is then a multiple of a single one. This is the necessary condition for invertibility
that a proof of non-invertibility checks.

## Main definitions

* `Stacks.AlgebraicGeometry.ProjInvertibleLocus.twistInvertibleLocus`: the open subset of
  `Proj S` on which `𝒪(n)` is invertible.

## Main results

* `Stacks.AlgebraicGeometry.ProjInvertibleLocus.mem_twistInvertibleLocus_iff`: a point lies in the
  locus exactly when it has an open neighbourhood on which `𝒪(n)` is invertible.
* `Stacks.AlgebraicGeometry.ProjInvertibleLocus.whereInvertible_le_twistInvertibleLocus`: Tag
  01MU's `W_1` lies in the locus where `𝒪(1)` is invertible.
* `Stacks.AlgebraicGeometry.ProjInvertibleLocus.exists_forall_eq_smul_of_mem_twistInvertibleLocus`:
  at a point of the locus, the degree-zero localization `S(n)₍x₎` is generated by one element
  over `S₍x₎`.

## References

* [Stacks Project, Tag 01NL](https://stacks.math.columbia.edu/tag/01NL)
* [Stacks Project, Tag 01MU](https://stacks.math.columbia.edu/tag/01MU)
* [Stacks Project, Tag 0B8M](https://stacks.math.columbia.edu/tag/0B8M)
* [Stacks Project, Tag 01M7](https://stacks.math.columbia.edu/tag/01M7)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite
open AlgebraicGeometry
open AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjStalkGlobalSections

namespace Stacks.AlgebraicGeometry.ProjInvertibleLocus

universe u w

variable {S : Type u} {σ : Type w} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf

attribute [local instance] instVAddNatInt GoodOpenClose.instIsPrime

/-- The open subset of `Proj S` on which the single twist `𝒪(n)` is invertible: the union of the
opens `U` such that the restriction of `𝒪(n)` to `U` is an invertible `𝒪_U`-module. -/
def twistInvertibleLocus (n : ℤ) : (AlgebraicGeometry.Proj 𝒮).Opens :=
  sSup {U | SheafOfModules.IsInvertible U.toScheme.presheaf U.toScheme.ringCatSheaf.2
    ((Scheme.Modules.pullback U.ι).obj (twistingSheaf 𝒮 n))}

/-- A point lies in the locus where `𝒪(n)` is invertible exactly when it has an open
neighbourhood on which `𝒪(n)` is invertible. -/
theorem mem_twistInvertibleLocus_iff (n : ℤ) (x : AlgebraicGeometry.Proj 𝒮) :
    x ∈ twistInvertibleLocus 𝒮 n ↔ ∃ U : (AlgebraicGeometry.Proj 𝒮).Opens, x ∈ U ∧
      SheafOfModules.IsInvertible U.toScheme.presheaf U.toScheme.ringCatSheaf.2
        ((Scheme.Modules.pullback U.ι).obj (twistingSheaf 𝒮 n)) := by
  rw [twistInvertibleLocus, Opens.mem_sSup]
  exact ⟨fun ⟨U, hU, hx⟩ => ⟨U, hx, hU⟩, fun ⟨U, hx, hU⟩ => ⟨U, hU, hx⟩⟩

/-- Tag 01MU's open `W_1`, on which every twist is invertible and every multiplication map is an
isomorphism, lies in the locus where the single twist `𝒪(1)` is invertible. -/
theorem whereInvertible_le_twistInvertibleLocus :
    whereInvertible 𝒮 1 ≤ twistInvertibleLocus 𝒮 1 := by
  refine sSup_le fun U hU => le_sSup ?_
  simpa using hU.1 1

/-- **A twist is cyclic on stalks where it is invertible.** At a point `x` of the locus where
`𝒪(n)` is invertible, the degree-zero localization `S(n)₍x₎`, which is the stalk of `𝒪(n)` at
`x`, is generated over `S₍x₎` by a single element: `𝒪(n)` is free of rank one near `x` by Tag
0B8M, and the value at `x` of a trivializing section generates. -/
theorem exists_forall_eq_smul_of_mem_twistInvertibleLocus {n : ℤ}
    {x : ProjectiveSpectrum.top 𝒮} (hx : x ∈ twistInvertibleLocus 𝒮 n) :
    ∃ z₀ ∈ degreeZeroModuleAt 𝒮 (twistGrading (S := S) 𝒮 n) x,
      ∀ z ∈ degreeZeroModuleAt 𝒮 (twistGrading (S := S) 𝒮 n) x,
        ∃ r : HomogeneousLocalization.AtPrime 𝒮 x.asHomogeneousIdeal.toIdeal, z = r.val • z₀ := by
  obtain ⟨U, hxU, hU⟩ := (mem_twistInvertibleLocus_iff 𝒮 n x).mp hx
  set M : (AlgebraicGeometry.Proj 𝒮).Modules := twistingSheaf 𝒮 n with hM
  have hR : SheafOfModules.IsInvertible U.toScheme.presheaf U.toScheme.ringCatSheaf.2
      ((Scheme.Modules.restrictFunctor U.ι).obj M) :=
    GoodOpenClose.isInvertible_of_iso _ _
      ((Scheme.Modules.restrictFunctorIsoPullback U.ι).app M).symm hU
  have hloc : ∀ z : U.toScheme.toRingedSpace.carrier,
      IsLocalRing (Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk
        U.toScheme.toRingedSpace z) := fun z => U.toScheme.isLocalRing z
  obtain ⟨W, hxW, a, ha⟩ := Stacks.SheafOfModules.exists_bijective_smul_of_isInvertible
    (X := U.toScheme.toRingedSpace) ((Scheme.Modules.restrictFunctor U.ι).obj M) ⟨x, hxU⟩
  have hxW' : x ∈ U.ι ''ᵁ W := ⟨⟨x, hxU⟩, hxW, rfl⟩
  let a' : (associatedModuleSheaf 𝒮 (twistGrading (S := S) 𝒮 n)).val.obj (op (U.ι ''ᵁ W)) := a
  let z₀ := associatedModuleSheafStalkEval 𝒮 (twistGrading (S := S) 𝒮 n) x
    (associatedModuleSheafGerm 𝒮 _ x _ hxW' a')
  refine ⟨z₀.1, z₀.2, fun z hz => ?_⟩
  obtain ⟨g, hg⟩ := associatedModuleSheafStalkEval_surjective 𝒮 _ x ⟨z, hz⟩
  obtain ⟨V₀, hxV₀, t, rfl⟩ := associatedModuleSheafStalk_exists_germ 𝒮 _ x g
  let V : U.toScheme.Opens := W ⊓ U.ι ⁻¹ᵁ V₀
  have hVW : V ≤ W := inf_le_left
  have hxV : x ∈ U.ι ''ᵁ V := ⟨⟨x, hxU⟩, ⟨hxW, hxV₀⟩, rfl⟩
  have himg : U.ι ''ᵁ V ≤ V₀ := (U.ι.image_mono inf_le_right).trans (U.ι.image_preimage_le V₀)
  have himgW : U.ι ''ᵁ V ≤ U.ι ''ᵁ W := U.ι.image_mono hVW
  obtain ⟨c, hc⟩ := (ha V hVW).2 (M.val.map (homOfLE himg).op t)
  have hsmul := Scheme.Modules.smul_restrictAppIso_hom_apply U.ι M V c
    (((Scheme.Modules.restrictFunctor U.ι).obj M).val.map (homOfLE hVW).op a)
  rw [Scheme.Opens.ι_appIso] at hsmul
  let c' : (ProjectiveSpectrum.Proj.structureSheaf 𝒮).obj.obj (op (U.ι ''ᵁ V)) := c
  let aV : (associatedModuleSheaf 𝒮 (twistGrading (S := S) 𝒮 n)).val.obj (op (U.ι ''ᵁ V)) :=
    (associatedModuleSheaf 𝒮 _).val.map (homOfLE himgW).op a'
  have hkey :
      (associatedModuleSheaf 𝒮 (twistGrading (S := S) 𝒮 n)).val.presheaf.map (homOfLE himg).op t =
        c' • aV :=
    hc.symm.trans hsmul
  refine ⟨c'.1 ⟨x, hxV⟩, ?_⟩
  have h1 := associatedModuleSheafGerm_res 𝒮 (twistGrading (S := S) 𝒮 n) x (homOfLE himg) hxV t
  have h2 := associatedModuleSheafGerm_res 𝒮 (twistGrading (S := S) 𝒮 n) x (homOfLE himgW) hxV a'
  have h3 := associatedModuleSheafStalkEquiv_germ_smul 𝒮 (twistGrading (S := S) 𝒮 n) x _ hxV c' aV
  have h4 := Proj.stalkIso'_germ 𝒮 (U.ι ''ᵁ V) x hxV c'
  rw [h4] at h3
  have h3' : (associatedModuleSheafStalkEval 𝒮 (twistGrading (S := S) 𝒮 n) x
      (associatedModuleSheafGerm 𝒮 (twistGrading (S := S) 𝒮 n) x _ hxV (c' • aV))).1 =
      (c'.1 ⟨x, hxV⟩).val • (associatedModuleSheafStalkEval 𝒮 (twistGrading (S := S) 𝒮 n) x
        (associatedModuleSheafGerm 𝒮 (twistGrading (S := S) 𝒮 n) x _ hxV aV)).1 :=
    congrArg Subtype.val h3
  have hz' : z = (associatedModuleSheafStalkEval 𝒮 (twistGrading (S := S) 𝒮 n) x
      (associatedModuleSheafGerm 𝒮 (twistGrading (S := S) 𝒮 n) x V₀ hxV₀ t)).1 := by
    rw [hg]
  let ev := fun {V' : Opens (ProjectiveSpectrum.top 𝒮)} (hV' : x ∈ V')
      (s : (associatedModuleSheaf 𝒮 (twistGrading (S := S) 𝒮 n)).val.obj (op V')) =>
    (associatedModuleSheafStalkEval 𝒮 (twistGrading (S := S) 𝒮 n) x
      (associatedModuleSheafGerm 𝒮 (twistGrading (S := S) 𝒮 n) x V' hV' s)).1
  calc z = ev hxV₀ t := hz'
    _ = ev hxV ((associatedModuleSheaf 𝒮 (twistGrading (S := S) 𝒮 n)).val.presheaf.map
          (homOfLE himg).op t) :=
        congrArg (fun g => (associatedModuleSheafStalkEval 𝒮 _ x g).1) h1.symm
    _ = ev hxV (c' • aV) := congrArg (ev hxV) hkey
    _ = (c'.1 ⟨x, hxV⟩).val • ev hxV aV := h3'
    _ = (c'.1 ⟨x, hxV⟩).val • z₀.1 :=
        congrArg (fun g => (c'.1 ⟨x, hxV⟩).val • (associatedModuleSheafStalkEval 𝒮 _ x g).1) h2

end Stacks.AlgebraicGeometry.ProjInvertibleLocus

end
