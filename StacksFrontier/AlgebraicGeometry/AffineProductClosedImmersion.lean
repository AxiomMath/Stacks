module

public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Pullbacks

/-!
# Closed immersions into a product of two affine schemes

A pair of morphisms `p : P ⟶ U` and `q : P ⟶ V` of schemes induces a morphism from `P` into
the absolute product `U ×_{Spec ℤ} V`, and on global sections a `ℤ`-algebra map
`Γ(U, ⊤) ⊗_ℤ Γ(V, ⊤) ⟶ Γ(P, ⊤)` sending `a ⊗ b` to the product of the pullback of `a` along
`p` and the pullback of `b` along `q`.

When `U` and `V` are affine, so is the product, and its ring of global sections is generated
by the images of `Γ(U, ⊤)` and `Γ(V, ⊤)`. Consequently the morphism to the product is a
closed immersion exactly when `P` is affine and the algebra map on global sections is
surjective.

## Main definitions

* `AlgebraicGeometry.globalSectionsTensorLift`: the `ℤ`-algebra map
  `Γ(U, ⊤) ⊗_ℤ Γ(V, ⊤) ⟶ Γ(P, ⊤)` attached to a pair of morphisms out of `P`.

## Main results

* `AlgebraicGeometry.surjective_globalSectionsTensorLift_pullback_terminal`: for affine `U`
  and `V` the two projections of `U ×_{Spec ℤ} V` give a surjection on global sections.
* `AlgebraicGeometry.isClosedImmersion_pullbackLift_terminal_iff`: the morphism
  `P ⟶ U ×_{Spec ℤ} V` determined by `p` and `q` is a closed immersion if and only if `P` is
  affine and `globalSectionsTensorLift p q` is surjective.

## Implementation notes

The absolute product is written as the fibre product over the terminal scheme, which is
`Spec ℤ`; `CategoryTheory.Limits.prodIsoPullback` identifies it with the categorical binary
product when that is the form a client needs.

Surjectivity on global sections of the two projections is read off from the fact that the
cartesian square of affine schemes becomes a pushout square of rings
(`AlgebraicGeometry.isPushout_appTop_of_isPullback`), whose target is therefore generated as
a subring by the two images (`CommRingCat.closure_range_union_range_eq_top_of_isPushout`).
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct

universe u

namespace AlgebraicGeometry

variable {U V P : Scheme.{u}}

/-- The canonical `ℤ`-algebra map `Γ(U, ⊤) ⊗_ℤ Γ(V, ⊤) ⟶ Γ(P, ⊤)` attached to a pair of
morphisms `p : P ⟶ U` and `q : P ⟶ V`: it sends a pure tensor `a ⊗ b` to the product of the
pullback of `a` along `p` and the pullback of `b` along `q`. Every ring of global sections is
a `ℤ`-algebra in exactly one way, so no compatibility between `p` and `q` is needed. -/
noncomputable def globalSectionsTensorLift (p : P ⟶ U) (q : P ⟶ V) :
    Γ(U, ⊤) ⊗[ℤ] Γ(V, ⊤) →ₐ[ℤ] Γ(P, ⊤) :=
  Algebra.TensorProduct.lift p.appTop.hom.toIntAlgHom q.appTop.hom.toIntAlgHom
    fun _ _ => Commute.all _ _

/-- The map `globalSectionsTensorLift p q` sends `a ⊗ b` to the product of the pullback of `a`
along `p` and the pullback of `b` along `q`. -/
@[simp]
theorem globalSectionsTensorLift_tmul (p : P ⟶ U) (q : P ⟶ V) (a : Γ(U, ⊤)) (b : Γ(V, ⊤)) :
    globalSectionsTensorLift p q (a ⊗ₜ[ℤ] b) = p.appTop.hom a * q.appTop.hom b :=
  Algebra.TensorProduct.lift_tmul _ _ _ _ _

/-- Precomposing both morphisms with `r : P ⟶ T` precomposes the map on global sections with
the pullback along `r`. -/
theorem globalSectionsTensorLift_comp {T : Scheme.{u}} (r : P ⟶ T) (i : T ⟶ U) (j : T ⟶ V) :
    globalSectionsTensorLift (r ≫ i) (r ≫ j) =
      r.appTop.hom.toIntAlgHom.comp (globalSectionsTensorLift i j) :=
  Algebra.TensorProduct.ext' fun a b => by
    simp only [globalSectionsTensorLift_tmul, AlgHom.comp_apply, map_mul,
      Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply,
      RingHom.toIntAlgHom_coe]

/-- **The product of two affine schemes has its global sections generated by the two
factors.** For affine `U` and `V` the map on global sections induced by the two projections
of `U ×_{Spec ℤ} V` is surjective. -/
theorem surjective_globalSectionsTensorLift_pullback_terminal
    (U V : Scheme.{u}) [IsAffine U] [IsAffine V] :
    Function.Surjective (globalSectionsTensorLift
      (pullback.fst (terminal.from U) (terminal.from V))
      (pullback.snd (terminal.from U) (terminal.from V))) := by
  set i := pullback.fst (terminal.from U) (terminal.from V)
  set j := pullback.snd (terminal.from U) (terminal.from V)
  set ψ := globalSectionsTensorLift i j with hψ
  have hleft : Set.range i.appTop.hom ⊆ RingHom.range ψ.toRingHom := by
    rintro x ⟨a, rfl⟩
    exact ⟨a ⊗ₜ[ℤ] (1 : Γ(V, ⊤)), by simp [hψ]⟩
  have hright : Set.range j.appTop.hom ⊆ RingHom.range ψ.toRingHom := by
    rintro x ⟨a, rfl⟩
    exact ⟨(1 : Γ(U, ⊤)) ⊗ₜ[ℤ] a, by simp [hψ]⟩
  have hclose := CommRingCat.closure_range_union_range_eq_top_of_isPushout
    (isPushout_appTop_of_isPullback
      (IsPullback.of_hasPullback (terminal.from U) (terminal.from V)))
  exact RingHom.range_eq_top.mp (top_le_iff.mp
    (hclose.symm.trans_le (Subring.closure_le.2 (Set.union_subset hleft hright))))

/-- **The criterion for the morphism into a product of affines to be a closed immersion.**
Let `U` and `V` be affine schemes and let `p : P ⟶ U` and `q : P ⟶ V` be arbitrary morphisms.
The induced morphism `P ⟶ U ×_{Spec ℤ} V` is a closed immersion if and only if `P` is affine
and the induced map `Γ(U, ⊤) ⊗_ℤ Γ(V, ⊤) ⟶ Γ(P, ⊤)` is surjective. -/
theorem isClosedImmersion_pullbackLift_terminal_iff [IsAffine U] [IsAffine V]
    (p : P ⟶ U) (q : P ⟶ V) :
    IsClosedImmersion (pullback.lift p q (terminal.hom_ext _ _) :
        P ⟶ pullback (terminal.from U) (terminal.from V)) ↔
      IsAffine P ∧ Function.Surjective (globalSectionsTensorLift p q) := by
  set i := pullback.fst (terminal.from U) (terminal.from V)
  set j := pullback.snd (terminal.from U) (terminal.from V)
  set r : P ⟶ pullback (terminal.from U) (terminal.from V) :=
    pullback.lift p q (terminal.hom_ext _ _)
  have hri : r ≫ i = p := pullback.lift_fst _ _ _
  have hrj : r ≫ j = q := pullback.lift_snd _ _ _
  have hfactor : globalSectionsTensorLift p q =
      r.appTop.hom.toIntAlgHom.comp (globalSectionsTensorLift i j) := by
    rw [← hri, ← hrj]
    exact globalSectionsTensorLift_comp r i j
  constructor
  · intro h
    obtain ⟨hP, hsurj⟩ := IsClosedImmersion.isAffine_surjective_of_isAffine r
    refine ⟨hP, ?_⟩
    rw [hfactor]
    exact hsurj.comp (surjective_globalSectionsTensorLift_pullback_terminal U V)
  · rintro ⟨hP, hsurj⟩
    refine IsClosedImmersion.of_surjective_of_isAffine r fun y => ?_
    obtain ⟨z, hz⟩ := hsurj y
    exact ⟨globalSectionsTensorLift i j z, by rw [← hz, hfactor]; rfl⟩

end AlgebraicGeometry

end
