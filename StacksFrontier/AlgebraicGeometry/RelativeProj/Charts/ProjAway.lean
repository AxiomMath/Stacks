module

public import Mathlib.AlgebraicGeometry.Morphisms.OpenImmersion
public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor
public import StacksFrontier.AlgebraicGeometry.Blowup.RelativeProj
public import StacksFrontier.AlgebraicGeometry.RelativeProj.Charts.AwayLocalization

/-!
# `Proj` of a degreewise localization is a standard open

Let `φ : 𝒜 →+*ᵍ ℬ` be a homomorphism of nonnegatively graded rings which is, in each degree, the
localization away from a degree-zero element `g` of `𝒜`
(`Stacks.GradedLocalization.IsAwayDegreewise`), and suppose the irrelevant ideal of `ℬ` is
contained in the ideal generated by the image of the irrelevant ideal of `𝒜`, so that
`AlgebraicGeometry.Proj.map φ` exists. This file proves that `Proj.map φ` identifies `Proj ℬ`
with the standard open `D₊(g)` of `Proj 𝒜`: it is an open immersion, and its image is exactly
that standard open.

Geometrically: `Proj 𝒜` is a scheme over `Spec (𝒜 0)`, the nonvanishing locus of `g` in the base
pulls back to `D₊(g)`, and inverting `g` on the graded ring restricts `Proj` to that locus. This
is the local statement behind Stacks tag 01NO for an inclusion of a standard open of the base.

## Main results

* `Stacks.ProjAway.isOpenImmersion_map`: `Proj.map φ` is an open immersion.
* `Stacks.ProjAway.opensRange_map`: its image is the standard open `D₊(g)`.
* `Stacks.ProjAway.isOpenImmersion_specMap_awayMap` and
  `Stacks.ProjAway.range_specMap_awayMap`: the same two statements on a standard affine chart,
  where they are the corresponding statements for a localization of rings.

## Implementation notes

The open-immersion property is checked on the standard affine charts of the *target*, using that
`AlgebraicGeometry.IsOpenImmersion` is `IsZariskiLocalAtTarget`. On the chart `D₊(b)` the
restriction of `Proj.map φ` is `Spec` of `HomogeneousLocalization.Away.map φ b`, which is `Spec`
of a localization away from `g / 1` by
`Stacks.GradedLocalization.IsAwayDegreewise.isLocalization_awayMap`, hence an open immersion by
`AlgebraicGeometry.IsOpenImmersion.of_isLocalization`. The passage from `Proj.map φ ∣_ D₊(b)` to
that chart statement is `AlgebraicGeometry.morphismRestrict_ι` followed by
`AlgebraicGeometry.IsOpenImmersion.of_comp`, with the chart identification supplied by
`AlgebraicGeometry.Proj.awayι_comp_map`.

The image is computed chart by chart with
`AlgebraicGeometry.Proj.opens_eq_of_awayι_preimage_eq`. On a chart the image of `Proj.map φ` is
the image of `Spec` of the localization map, which is the standard open of `g / 1` by
`PrimeSpectrum.localization_away_comap_range`, and that standard open is the chart-local
description of `D₊(g)` by
`AlgebraicGeometry.Proj.awayι_preimage_basicOpen_zero`.

Those two chart computations are stated with `Set.range` of the underlying map rather than with
`AlgebraicGeometry.Scheme.Hom.opensRange`, which needs an `IsOpenImmersion` instance in the
statement; and the step identifying the two is `Eq.trans` rather than `rewrite`, because the
carrier of `Spec R` is a structure copy of `PrimeSpectrum R` and a motive mentioning an open of
one does not typecheck against the other at `implicit` transparency.

## References

* [Stacks Project, Tag 01NO](https://stacks.math.columbia.edu/tag/01NO)
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry HomogeneousLocalization HomogeneousIdeal Graded
open Stacks.GradedLocalization

universe u

namespace Stacks.ProjAway

variable {A B : Type u} {σ τ : Type u} [CommRing A] [CommRing B]
  [SetLike σ A] [AddSubgroupClass σ A] [SetLike τ B] [AddSubgroupClass τ B]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
  {φ : 𝒜 →+*ᵍ ℬ} {g b : A} {d : ℕ}

/-- **The chart map of a degreewise localization is an open immersion.** On the standard affine
chart at `b`, `Proj.map φ` is `Spec` of a localization away from `g / 1`. -/
public theorem isOpenImmersion_specMap_awayMap (h : IsAwayDegreewise φ g) (hg : g ∈ 𝒜 0)
    (hb : b ∈ 𝒜 d) :
    IsOpenImmersion (Spec.map (CommRingCat.ofHom (Away.map φ b))) := by
  let := (Away.map φ b).toAlgebra
  have := h.isLocalization_awayMap hg hb
  exact IsOpenImmersion.of_isLocalization (chartElem hg hb)

/-- **The image of the chart map is the standard open of `g / 1`.** -/
public theorem range_specMap_awayMap (h : IsAwayDegreewise φ g) (hg : g ∈ 𝒜 0)
    (hb : b ∈ 𝒜 d) :
    Set.range (Spec.map (CommRingCat.ofHom (Away.map φ b))).base =
      (PrimeSpectrum.basicOpen (chartElem hg hb) : Set (PrimeSpectrum (Away 𝒜 b))) := by
  let := (Away.map φ b).toAlgebra
  have := h.isLocalization_awayMap hg hb
  exact PrimeSpectrum.localization_away_comap_range _ _

/-- The fraction `g / 1` is the image of `g` under the canonical map from the degree-zero part. -/
public theorem chartElem_eq_fromZeroRingHom (hg : g ∈ 𝒜 0) (hb : b ∈ 𝒜 d) :
    chartElem hg hb = fromZeroRingHom 𝒜 (Submonoid.powers b) ⟨g, hg⟩ := by
  apply HomogeneousLocalization.val_injective
  rw [val_chartElem]
  rfl

/-- `Proj.map φ` restricted to the standard open `D₊(φ b)` of the source is, through the two
chart identifications, `Spec` of `HomogeneousLocalization.Away.map φ b`. -/
public theorem basicOpen_ι_comp_map {hirr : irrelevant ℬ ≤ (irrelevant 𝒜).map φ}
    (hb : b ∈ 𝒜 d) (hd : 0 < d) :
    (Proj.basicOpen ℬ (φ b)).ι ≫ Proj.map φ hirr =
      (Proj.basicOpenIsoSpec ℬ (φ b) (φ.map_mem hb) hd).hom ≫
        Spec.map (CommRingCat.ofHom (Away.map φ b)) ≫ Proj.awayι 𝒜 b hb hd := by
  rw [← Proj.awayι_comp_map φ hirr hd b hb, ← Proj.basicOpenIsoSpec_inv_ι ℬ (φ b)
    (φ.map_mem hb) hd, Category.assoc, Iso.hom_inv_id_assoc]


/-- The standard opens of the homogeneous elements of positive degree cover `Proj 𝒜`. -/
public theorem iSup_basicOpen_hom_eq_top :
    (⨆ i : Σ i : PNat, 𝒜 i, Proj.basicOpen 𝒜 (i.2 : A)) = ⊤ := by
  rw [← (Proj.affineOpenCover 𝒜).openCover.iSup_opensRange]
  exact iSup_congr fun i => (Proj.opensRange_awayι 𝒜 _ i.2.2 i.1.2).symm

/-- `Proj.map φ` is an open immersion over each standard open of the target. -/
private theorem isOpenImmersion_morphismRestrict (h : IsAwayDegreewise φ g) (hg : g ∈ 𝒜 0)
    (hirr : irrelevant ℬ ≤ (irrelevant 𝒜).map φ) (hb : b ∈ 𝒜 d) (hd : 0 < d) :
    IsOpenImmersion (Proj.map φ hirr ∣_ Proj.basicOpen 𝒜 b) := by
  have := isOpenImmersion_specMap_awayMap h hg hb
  have : IsOpenImmersion ((Proj.map φ hirr ∣_ Proj.basicOpen 𝒜 b) ≫ (Proj.basicOpen 𝒜 b).ι) := by
    rw [morphismRestrict_ι, Proj.map_preimage_basicOpen, basicOpen_ι_comp_map hb hd]
    infer_instance
  exact IsOpenImmersion.of_comp _ (Proj.basicOpen 𝒜 b).ι

/-- **`Proj` of a degreewise localization is an open subscheme.** Being an open immersion is
local at the target, and over each standard affine chart of `Proj 𝒜` the morphism is `Spec` of a
localization. -/
public theorem isOpenImmersion_map (h : IsAwayDegreewise φ g) (hg : g ∈ 𝒜 0)
    (hirr : irrelevant ℬ ≤ (irrelevant 𝒜).map φ) :
    IsOpenImmersion (Proj.map φ hirr) := by
  refine IsZariskiLocalAtTarget.of_iSup_eq_top
    (fun i : Σ i : PNat, 𝒜 i => Proj.basicOpen 𝒜 (i.2 : A)) iSup_basicOpen_hom_eq_top ?_
  intro i
  exact isOpenImmersion_morphismRestrict h hg hirr i.2.2 i.1.2


/-- **The image of `Proj ℬ` in `Proj 𝒜` is the standard open cut out by `g`.** -/
public theorem opensRange_map (h : IsAwayDegreewise φ g) (hg : g ∈ 𝒜 0)
    (hirr : irrelevant ℬ ≤ (irrelevant 𝒜).map φ) :
    letI := isOpenImmersion_map h hg hirr
    (Proj.map φ hirr).opensRange = Proj.basicOpen 𝒜 g := by
  have hoi := isOpenImmersion_map h hg hirr
  refine Proj.opens_eq_of_awayι_preimage_eq 𝒜 fun {i} hi b hb => ?_
  rw [Proj.awayι_preimage_basicOpen_zero 𝒜 b hb hi ⟨g, hg⟩,
    ← chartElem_eq_fromZeroRingHom hg hb]
  apply TopologicalSpace.Opens.ext
  refine Eq.trans ?_ (range_specMap_awayMap h hg hb)
  have key (z) : Proj.map φ hirr (Proj.awayι ℬ (φ b) (φ.map_mem hb) hi z) =
      Proj.awayι 𝒜 b hb hi (Spec.map (CommRingCat.ofHom (Away.map φ b)) z) := by
    rw [← Scheme.Hom.comp_apply, Proj.awayι_comp_map φ hirr hi b hb, Scheme.Hom.comp_apply]
  refine Set.ext fun x => ⟨?_, ?_⟩
  · rintro ⟨y, hy⟩
    obtain ⟨z, rfl⟩ : y ∈ Set.range (Proj.awayι ℬ (φ b) (φ.map_mem hb) hi) := by
      rw [← Scheme.Hom.coe_opensRange, Proj.opensRange_awayι ℬ (φ b) (φ.map_mem hb) hi,
        ← Proj.map_preimage_basicOpen φ hirr b]
      change (Proj.map φ hirr) y ∈ Proj.basicOpen 𝒜 b
      rw [hy, ← Proj.opensRange_awayι 𝒜 b hb hi]
      exact ⟨x, rfl⟩
    exact ⟨z, (Proj.awayι 𝒜 b hb hi).isOpenEmbedding.injective (by rw [← key, hy])⟩
  · rintro ⟨z, rfl⟩
    exact ⟨_, key z⟩

end Stacks.ProjAway
end
