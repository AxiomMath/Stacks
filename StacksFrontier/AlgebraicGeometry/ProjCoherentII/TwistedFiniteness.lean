/-! ### The degree bookkeeping -/

/-- The degree bookkeeping of the two index conventions for a Veronese twist: the Veronese
comparison lands in degree `m · d`, while the twist-of-a-twist isomorphism is indexed by
`d · m`. -/
public theorem veroneseIterateDegree (d : ℕ) (m : ℤ) : m * (d : ℤ) = (d : ℤ) * m :=
  mul_comm m (d : ℤ)

/-- The degree bookkeeping of the residue convention: the twist-of-a-twist isomorphism lands
in degree `d · m + q`, while the residue transport reads that degree as `m · d + q`. -/
public theorem iterateResidueDegree (d q : ℕ) (m : ℤ) :
    (d : ℤ) * m + (q : ℤ) = m * (d : ℤ) + (q : ℤ) := by
  rw [mul_comm]

variable {S : Type u} {σ : Type u} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

/-! ### Transporting a twisted global section along an equality of degrees -/

section Transport

variable (G : SheafOfModules.{u}
  ((sheafCompose (Opens.grothendieckTopology (ProjectiveSpectrum.top 𝒮))
    (forget₂ CommRingCat.{u} RingCat.{u})).obj (ProjectiveSpectrum.Proj.structureSheaf 𝒮)))

/-- Transporting a twisted global section along an equality of degrees, as an isomorphism of
additive groups `Γ(X, 𝒢(a)) ≃+ Γ(X, 𝒢(b))` for `a = b`. It is `cast` on the component type. -/
public def twistedSectionsCastEquiv {a b : ℤ} (h : a = b) :
    twistedSectionsComponent 𝒮 G a ≃+ twistedSectionsComponent 𝒮 G b where
  toFun := cast (congrArg (twistedSectionsComponent 𝒮 G) h)
  invFun := cast (congrArg (twistedSectionsComponent 𝒮 G) h.symm)
  left_inv _ := by subst h; rfl
  right_inv _ := by subst h; rfl
  map_add' _ _ := by subst h; rfl

/-- The degree transport acts on a twisted global section as the `cast` of the component type. -/
@[simp] public theorem twistedSectionsCastEquiv_apply {a b : ℤ} (h : a = b)
    (x : twistedSectionsComponent 𝒮 G a) :
    twistedSectionsCastEquiv 𝒮 G h x = cast (congrArg (twistedSectionsComponent 𝒮 G) h) x :=
  rfl

/-- A sheaf-level transport of degrees is a `cast` on global sections: the twists `𝒢(a)` and
`𝒢(b)` of a module are equal sheaves when `a = b`, and the morphism `eqToHom` of that equality
acts on the sections over `⊤` as the transport of the component type. -/
public theorem eqToHom_twistSheafOfModules_app_top {a b : ℤ} (h : a = b)
    (y : twistedSectionsComponent 𝒮 G a) :
    ((eqToHom (congrArg (twistSheafOfModules 𝒮 G) h)).val.app (op ⊤)).hom y =
      cast (congrArg (twistedSectionsComponent 𝒮 G) h) y := by
  subst h
  rfl

/-- The homogeneous scalar action commutes with a transport of degrees: acting by `a ∈ 𝒮 i`
on a section transported from degree `a₀` to degree `b₀` is the transport, from `i + a₀` to
`i + b₀`, of the action on the untransported section. -/
public theorem homogeneousScalarTwistedSections_cast (i : ℕ) {a b : ℤ} (h : a = b) (x : 𝒮 i)
    (s : twistedSectionsComponent 𝒮 G a) :
    homogeneousScalarTwistedSections 𝒮 G i b x
        (cast (congrArg (twistedSectionsComponent 𝒮 G) h) s) =
      cast (congrArg (fun n : ℤ => twistedSectionsComponent 𝒮 G ((i : ℤ) + n)) h)
        (homogeneousScalarTwistedSections 𝒮 G i a x s) := by
  subst h
  rfl

/-- Transport along an isomorphism of modules commutes with a transport of degrees. -/
public theorem twistedSectionsIsoTransport_cast
    {G' : SheafOfModules.{u}
      ((sheafCompose (Opens.grothendieckTopology (ProjectiveSpectrum.top 𝒮))
        (forget₂ CommRingCat.{u} RingCat.{u})).obj (ProjectiveSpectrum.Proj.structureSheaf 𝒮))}
    (ψ : G ≅ G') {a b : ℤ} (h : a = b) (s : twistedSectionsComponent 𝒮 G a) :
    twistedSectionsIsoTransport 𝒮 ψ b (cast (congrArg (twistedSectionsComponent 𝒮 G) h) s) =
      cast (congrArg (twistedSectionsComponent 𝒮 G') h)
        (twistedSectionsIsoTransport 𝒮 ψ a s) := by
  subst h
  rfl

end Transport

/-! ### The Veronese comparison, with the degrees scaled on the left -/

section VeroneseComparison

variable (d : ℕ) (hdpos : 0 < d)
  (G' : letI := veroneseGradingGradedRing 𝒮 d hdpos
    SheafOfModules.{u}
      ((sheafCompose (Opens.grothendieckTopology
          (ProjectiveSpectrum.top (veroneseGrading 𝒮 d)))
        (forget₂ CommRingCat.{u} RingCat.{u})).obj
        (ProjectiveSpectrum.Proj.structureSheaf (veroneseGrading 𝒮 d))))
  (G : SheafOfModules.{u}
    ((sheafCompose (Opens.grothendieckTopology (ProjectiveSpectrum.top 𝒮))
      (forget₂ CommRingCat.{u} RingCat.{u})).obj (ProjectiveSpectrum.Proj.structureSheaf 𝒮)))
  (φ : letI := veroneseGradingGradedRing 𝒮 d hdpos
    pullbackProjModule 𝒮 (veroneseGrading 𝒮 d) (veroneseProjIso 𝒮 d hdpos).hom G' ≅ G)

/-- The Veronese comparison on twisted global sections of a sheaf identified with a pullback:
`Γ(X', ℱ'(m)) ≃+ Γ(X, 𝒢(dm))`, for `φ : i^*ℱ' ≅ 𝒢`.

It is the comparison of [Stacks, Tag 0B5J] on twisted sections
(`Stacks.Veronese.veroneseTwistedSectionsAddEquiv`), followed by the transport along `φ`
(`Stacks.AlgebraicGeometry.ProjTwistedSections.twistedSectionsIsoTransport`), followed by the
transport of the degree `m · d` to `d · m`. -/
public def veroneseSectionsComparison (m : ℤ) :
    letI := veroneseGradingGradedRing 𝒮 d hdpos
    twistedSectionsComponent (veroneseGrading 𝒮 d) G' m ≃+
      twistedSectionsComponent 𝒮 G ((d : ℤ) * m) :=
  letI := veroneseGradingGradedRing 𝒮 d hdpos
  ((veroneseTwistedSectionsAddEquiv 𝒮 d hdpos G' m).trans
      (twistedSectionsIsoTransport 𝒮 φ (m * (d : ℤ)))).trans
    (twistedSectionsCastEquiv 𝒮 G (veroneseIterateDegree d m))

/-- The Veronese comparison is semilinear over the inclusion of the Veronese subring: a
scalar `a ∈ S_{ed}`, read as an element of `S⁽ᵈ⁾` homogeneous of Veronese degree `e`, acts on
`Γ(X', ℱ'(m))` and on `Γ(X, 𝒢(dm))`, and the comparison carries the one action to the other once
the degrees `ed + dm` and `d(e + m)` are identified. -/
public theorem veroneseSectionsComparison_homogeneousScalarTwistedSections (e : ℕ) (m : ℤ)
    (a : veroneseSubring 𝒮 d) (ha : (a : S) ∈ 𝒮 (e * d))
    (y : letI := veroneseGradingGradedRing 𝒮 d hdpos
      twistedSectionsComponent (veroneseGrading 𝒮 d) G' m) :
    letI := veroneseGradingGradedRing 𝒮 d hdpos
    veroneseSectionsComparison 𝒮 d hdpos G' G φ ((e : ℤ) + m)
        (homogeneousScalarTwistedSections (veroneseGrading 𝒮 d) G' e m ⟨a, ha⟩ y) =
      cast (congrArg (twistedSectionsComponent 𝒮 G) (twistIterateScalarDegree d e m))
        (homogeneousScalarTwistedSections 𝒮 G (e * d) ((d : ℤ) * m) ⟨(a : S), ha⟩
          (veroneseSectionsComparison 𝒮 d hdpos G' G φ m y)) := by
  let := veroneseGradingGradedRing 𝒮 d hdpos
  have hdef : ∀ (n : ℤ) (z : twistedSectionsComponent (veroneseGrading 𝒮 d) G' n),
      veroneseSectionsComparison 𝒮 d hdpos G' G φ n z =
        cast (congrArg (twistedSectionsComponent 𝒮 G) (veroneseIterateDegree d n))
          (twistedSectionsIsoTransport 𝒮 φ (n * (d : ℤ))
            (veroneseTwistedSectionsComparison 𝒮 d hdpos G' n z)) :=
    fun _ _ => rfl
  rw [hdef, hdef,
    veroneseTwistedSectionsComparison_homogeneousScalarTwistedSections 𝒮 d hdpos G' e m a ha y,
    eqToHom_twistSheafOfModules_app_top 𝒮 _ (veroneseScalarDegree e m d),
    twistedSectionsIsoTransport_cast 𝒮 _ φ (veroneseScalarDegree e m d),
    twistedSectionsIsoTransport_homogeneousScalarTwistedSections,
    homogeneousScalarTwistedSections_cast 𝒮 G (e * d) (veroneseIterateDegree d m),
    cast_cast, cast_cast]

end VeroneseComparison

/-! ### One residue class of the twisted global sections -/

section ResidueComparison

variable (d : ℕ) (hdpos : 0 < d)
  (G' : letI := veroneseGradingGradedRing 𝒮 d hdpos
    SheafOfModules.{u}
      ((sheafCompose (Opens.grothendieckTopology
          (ProjectiveSpectrum.top (veroneseGrading 𝒮 d)))
        (forget₂ CommRingCat.{u} RingCat.{u})).obj
        (ProjectiveSpectrum.Proj.structureSheaf (veroneseGrading 𝒮 d))))
  (F : SheafOfModules.{u}
    ((sheafCompose (Opens.grothendieckTopology (ProjectiveSpectrum.top 𝒮))
      (forget₂ CommRingCat.{u} RingCat.{u})).obj (ProjectiveSpectrum.Proj.structureSheaf 𝒮)))
  (q : ℕ)
  (φ : letI := veroneseGradingGradedRing 𝒮 d hdpos
    pullbackProjModule 𝒮 (veroneseGrading 𝒮 d) (veroneseProjIso 𝒮 d hdpos).hom G' ≅
      twistSheafOfModules 𝒮 F (q : ℤ))
  (hratio : ProjShared.ratioLocus 𝒮 d = ⊤)

/-- The comparison of one residue class: `Γ(X', ℱ'(m)) ≃+ Γ(X, ℱ(md + q))`, for an
identification `φ : i^*ℱ' ≅ ℱ(q)`.

It is `Stacks.AlgebraicGeometry.ProjCoherentII.veroneseSectionsComparison` at `𝒢 = ℱ(q)`,
followed by the twist-of-a-twist isomorphism `(ℱ(q))(dm) ≅ ℱ(dm + q)` of [Stacks, Tag 03GJ] on
global sections, followed by the transport of the degree `dm + q` to `md + q`. -/
public def residueSectionsComparison (m : ℤ) :
    letI := veroneseGradingGradedRing 𝒮 d hdpos
    twistedSectionsComponent (veroneseGrading 𝒮 d) G' m ≃+
      twistedSectionsComponent 𝒮 F (m * (d : ℤ) + (q : ℤ)) :=
  letI := veroneseGradingGradedRing 𝒮 d hdpos
  ((veroneseSectionsComparison 𝒮 d hdpos G' (twistSheafOfModules 𝒮 F (q : ℤ)) φ m).trans
      (twistSheafIterateSections 𝒮 F hratio m (q : ℤ))).trans
    (twistedSectionsCastEquiv 𝒮 F (iterateResidueDegree d q m))

/-- The residue comparison is semilinear over the inclusion of the Veronese subring: a scalar
`a ∈ S_{ed}`, read as an element of `S⁽ᵈ⁾` homogeneous of Veronese degree `e`, acts on both sides,
and the comparison carries the one action to the other once the degrees `ed + (md + q)` and
`(e + m)d + q` are identified. -/
public theorem residueSectionsComparison_homogeneousScalarTwistedSections (e : ℕ) (m : ℤ)
    (a : veroneseSubring 𝒮 d) (ha : (a : S) ∈ 𝒮 (e * d))
    (y : letI := veroneseGradingGradedRing 𝒮 d hdpos
      twistedSectionsComponent (veroneseGrading 𝒮 d) G' m) :
    letI := veroneseGradingGradedRing 𝒮 d hdpos
    residueSectionsComparison 𝒮 d hdpos G' F q φ hratio ((e : ℤ) + m)
        (homogeneousScalarTwistedSections (veroneseGrading 𝒮 d) G' e m ⟨a, ha⟩ y) =
      cast (congrArg (twistedSectionsComponent 𝒮 F) (residueScalarDegree e m d q))
        (homogeneousScalarTwistedSections 𝒮 F (e * d) (m * (d : ℤ) + (q : ℤ)) ⟨(a : S), ha⟩
          (residueSectionsComparison 𝒮 d hdpos G' F q φ hratio m y)) := by
  let := veroneseGradingGradedRing 𝒮 d hdpos
  have hdef : ∀ (n : ℤ) (z : twistedSectionsComponent (veroneseGrading 𝒮 d) G' n),
      residueSectionsComparison 𝒮 d hdpos G' F q φ hratio n z =
        cast (congrArg (twistedSectionsComponent 𝒮 F) (iterateResidueDegree d q n))
          (twistSheafIterateSections 𝒮 F hratio n (q : ℤ)
            (veroneseSectionsComparison 𝒮 d hdpos G' (twistSheafOfModules 𝒮 F (q : ℤ)) φ n z)) :=
    fun _ _ => rfl
  rw [hdef, hdef,
    veroneseSectionsComparison_homogeneousScalarTwistedSections 𝒮 d hdpos G'
      (twistSheafOfModules 𝒮 F (q : ℤ)) φ e m a ha y,
    twistSheafIterateSections_homogeneousScalarTwistedSections 𝒮 F hratio m (q : ℤ) e
      ⟨(a : S), ha⟩,
    homogeneousScalarTwistedSections_cast 𝒮 F (e * d) (iterateResidueDegree d q m),
    cast_cast, cast_cast]

end ResidueComparison

/-! ### The two truncation bounds -/

/-- The two truncation bounds correspond: the degree-`≥ k` truncation downstairs meets the
residue class of `q` in the degrees `md + q` with `m ≥ ⌊(k - q - 1)/d⌋ + 1`, so that is the bound
the truncation upstairs is taken at. -/
public theorem residueBoundIff {d : ℕ} (hd : 0 < d) (k : ℤ) (q : ℕ) (m : ℤ) :
    (k - (q : ℤ) - 1) / (d : ℤ) + 1 ≤ m ↔ k ≤ m * (d : ℤ) + (q : ℤ) := by
  have hdz : (0 : ℤ) < (d : ℤ) := by exact_mod_cast hd
  constructor
  · intro hm
    have h2 := (Int.ediv_lt_iff_lt_mul hdz).mp (Int.lt_iff_add_one_le.mpr hm)
    linarith
  · intro hm
    have h2 : k - (q : ℤ) - 1 < m * (d : ℤ) := by linarith
    exact Int.lt_iff_add_one_le.mp ((Int.ediv_lt_iff_lt_mul hdz).mpr h2)

/-! ### The theorem -/

/-- Clause (4) of [Stacks, Tag 0B5Q], equivalently part (2) of [Stacks, Tag 0B5R]. For `S` a
Noetherian graded ring, `X = Proj S`, `ℱ` a coherent `𝒪_X`-module and `k ∈ ℤ`, the graded
`S`-module `⨁_{n ≥ k} Γ(X, ℱ(n))` is a finite `S`-module.

No generation hypothesis on `S` is assumed. The proof is the source's Veronese reduction: a
degree `d` is chosen by
`Stacks.AlgebraicGeometry.ProjCoherentII.exists_reductionDegree`, the degrees are split into the
`d` residue classes, each class is compared with the twisted global sections of a coherent sheaf
on `X' = Proj S⁽ᵈ⁾` where [Stacks, Tag 0AG6] (4) applies, and the `d` resulting finite families
are assembled over `S` by
`Stacks.AlgebraicGeometry.ProjTwistedSections.moduleFinite_gradedActionTruncation_of_residues`. -/
@[stacks 0B5Q "clause (4)", sga "2 XII 5.3" "clause (a), special case"]
public theorem moduleFinite_truncation_of_isCoherent [IsNoetherianRing S]
    (F : (AlgebraicGeometry.Proj 𝒮).Modules) (hF : _root_.SheafOfModules.IsCoherent F) (k : ℤ) :
    letI := (twistedGlobalSectionsModule 𝒮 F).moduleInst
    Module.Finite S ((twistedGlobalSectionsModule 𝒮 F).truncation 𝒮 F k) := by
  classical
  let := (twistedGlobalSectionsModule 𝒮 F).moduleInst
  obtain ⟨r, f, deg, d, hdeg, hfdeg, hgen, hdpos, -, hVgen, -, hratio⟩ :=
    exists_reductionDegree 𝒮
  let : GradedRing (veroneseGrading 𝒮 d) := veroneseGradingGradedRing 𝒮 d hdpos
  have : IsNoetherianRing (𝒮 0) := isNoetherianRing_gradeZero 𝒮
  have : IsNoetherianRing ((veroneseGrading 𝒮 d) 0) :=
    isNoetherianRing_veroneseGrading_zero 𝒮 d
  obtain ⟨n₀, y₀, hy₀, hy₀gen⟩ :=
    exists_finite_degreeOne_generators_veroneseSubring 𝒮 d f deg hdeg hfdeg hgen hVgen
  obtain ⟨n₁, y₁, hy₁, hy₁gen⟩ :=
    Stacks.ProjCoherentDegreeOne.exists_two_le_generators (veroneseGrading 𝒮 d) y₀ hy₀ hy₀gen
  refine moduleFinite_gradedActionTruncation_of_residues 𝒮
    (homogeneousScalarTwistedSections 𝒮 F)
    (twistedGlobalSectionsModule 𝒮 F).smul_homogeneous hdpos k fun q _ => ?_
  -- the coherent sheaf upstairs
  have hFqcoh : _root_.SheafOfModules.IsCoherent (twistSheafOfModules 𝒮 F (q : ℤ)) :=
    AlgebraicGeometry.ProjectiveSpectrum.Proj.isCoherent_twistSheafOfModules_of_isNoetherianRing
      𝒮 F hF (q : ℤ)
  let G' := veronesePushforward 𝒮 d hdpos (twistSheafOfModules 𝒮 F (q : ℤ))
  have hGqcoh : _root_.SheafOfModules.IsCoherent G' :=
