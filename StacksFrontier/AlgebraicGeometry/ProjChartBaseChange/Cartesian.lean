module

public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.AlgebraicGeometry.Pullbacks
public import StacksFrontier.AlgebraicGeometry.ProjBaseChange.Generic
public import StacksFrontier.AlgebraicGeometry.ProjChartBaseChange.Basic

/-!
# The base-change square of projective spectra is cartesian

Let `A` be a graded `R`-algebra with grading `𝒜 : ℕ → Submodule R A` and let `S` be an
`R`-algebra. `StacksFrontier/AlgebraicGeometry/Blowup/ProjBaseChange.lean` builds the morphism
`Stacks.ProjBaseChange.map : Proj (S ⊗[R] A) ⟶ Proj A` and shows
(`Stacks.ProjBaseChange.map_toSpecZero`) that it is a morphism over
`Spec ((S ⊗[R] 𝒜) 0) ⟶ Spec (𝒜 0)`. This file proves that square **cartesian**, which is the
chart-level content of Stacks tag 01NO.

## Main definitions

* `Stacks.AlgebraicGeometry.ProjChartBaseChange.specZeroMap`: the degree-zero leg
  `Spec ((S ⊗[R] 𝒜) 0) ⟶ Spec (𝒜 0)`.
* `Stacks.AlgebraicGeometry.ProjChartBaseChange.projCompare`: the canonical morphism from
  `Proj (S ⊗[R] A)` to the fibre product.
* `Stacks.AlgebraicGeometry.ProjChartBaseChange.chartIndex` and
  `Stacks.AlgebraicGeometry.ProjChartBaseChange.chartOpen`: the cover of the fibre product by the
  base changes of the standard affine charts of `Proj A`.

## Main results

* `Stacks.AlgebraicGeometry.ProjChartBaseChange.isPushout_awayMap`: **the chart square of rings is
  a pushout**, i.e. `Away (S ⊗[R] 𝒜) (1 ⊗ₜ a)` is the base change of `Away 𝒜 a` along
  `𝒜 0 ⟶ (S ⊗[R] 𝒜) 0`. This is the chart isomorphism
  `Stacks.AlgebraicGeometry.ProjChartBaseChange.chartEquiv` transported along
  `CommRingCat.isPushout_tensorProduct`.
* `Stacks.AlgebraicGeometry.ProjChartBaseChange.isIso_projCompare`: the comparison with the fibre
  product is an isomorphism.
* `Stacks.AlgebraicGeometry.ProjChartBaseChange.isPullback_map_toSpecZero`: **the base-change
  square of projective spectra is cartesian.**

## Implementation notes

The proof is the one that
`StacksFrontier/AlgebraicGeometry/ProjBaseChange/IsIso.lean` runs for polynomial rings, with the
polynomial-specific chart pushout replaced by
`Stacks.AlgebraicGeometry.ProjChartBaseChange.isPushout_awayMap`: the base-changed chart is
exhibited twice as a fibre product over the cospan
`Spec ((S ⊗[R] 𝒜) 0) ⟶ Spec (𝒜 0) ⟵ Spec (Away 𝒜 a)` — once by pasting the chart square of
`Stacks.AlgebraicGeometry.ProjBaseChange.isPullback_awayι_projMap` onto the fibre-product square,
once by `Stacks.AlgebraicGeometry.ProjChartBaseChange.isPullback_specAwayMap` — and the resulting
isomorphism is fed to
`Stacks.AlgebraicGeometry.ProjBaseChange.isIso_of_isPullback_cover`. Unlike the polynomial case
there is no terminal-object bookkeeping, because the cospan's apex is `Spec (𝒜 0)` on the nose.

The cover is indexed by *all* pairs `(d, a)` with `0 < d` and `a ∈ 𝒜 d`
(`Stacks.AlgebraicGeometry.ProjChartBaseChange.chartIndex`) rather than by a chosen generating set
of the irrelevant ideal: `AlgebraicGeometry.Proj.iSup_basicOpen_eq_top` then applies with no
generation hypothesis at all, since the irrelevant ideal is by definition generated by its
homogeneous elements of positive degree.

The three `𝒜 0`-algebra structures of
`StacksFrontier/AlgebraicGeometry/ProjChartBaseChange/Basic.lean` are re-declared as local
instances here, because the *proof* of the pushout square mentions
`(S ⊗[R] 𝒜) 0 ⊗_{𝒜 0} Away 𝒜 a`. The statements of the two main results do not, so consumers of
this file need no such declaration.

## Not done here

Nothing here concerns relative `Proj` over a non-affine base: this is not the base-change
comparison for the relative `Proj` of a quasi-coherent graded algebra along a morphism of bases.

## References

* [Stacks Project, Tag 01NO](https://stacks.math.columbia.edu/tag/01NO)
* [Stacks Project, Tag 0EVH](https://stacks.math.columbia.edu/tag/0EVH)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open HomogeneousIdeal HomogeneousLocalization TensorProduct
open Stacks.ProjBaseChange Stacks.AlgebraicGeometry.ProjAwayBaseChange

universe u

namespace Stacks.AlgebraicGeometry.ProjChartBaseChange

section Cartesian

variable {R A : Type u} [CommRing R] [CommRing A] [Algebra R A]
  (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] (S : Type u) [CommRing S] [Algebra R S]

attribute [local instance] zeroAlgebra chartAlgebra isScalarTower_chart

/-! ### The chart square of rings is a pushout -/

section Pushout

variable {d : ℕ} {a : A}

/-- **The chart square of the base change is a pushout of rings.** The base-changed standard chart
`Away (S ⊗[R] 𝒜) (1 ⊗ₜ a)` is the base change of `Away 𝒜 a` along `𝒜 0 ⟶ (S ⊗[R] 𝒜) 0`. This is
`Stacks.AlgebraicGeometry.ProjChartBaseChange.chartEquiv` transported along
`CommRingCat.isPushout_tensorProduct`. -/
public theorem isPushout_awayMap (ha : a ∈ 𝒜 d) :
    IsPushout (CommRingCat.ofHom (gradedZeroMap 𝒜 S))
      (CommRingCat.ofHom (algebraMap (𝒜 0) (Away 𝒜 a)))
      (CommRingCat.ofHom
        (algebraMap (grading 𝒜 S 0) (Away (grading 𝒜 S) ((1 : S) ⊗ₜ[R] a))))
      (CommRingCat.ofHom (awayMap 𝒜 S a)) := by
  refine (CommRingCat.isPushout_tensorProduct (𝒜 0) (grading 𝒜 S 0) (Away 𝒜 a)).of_iso
    (Iso.refl _) (Iso.refl _) (Iso.refl _) (chartEquiv 𝒜 S ha).toCommRingCatIso
    (by simp) (by simp) ?_ ?_ <;>
  simp only [Iso.refl_hom, Category.id_comp] <;>
  refine CommRingCat.hom_ext (RingHom.ext fun s => ?_)
  · show chartEquiv 𝒜 S ha (s ⊗ₜ[𝒜 0] (1 : Away 𝒜 a)) =
      algebraMap (grading 𝒜 S 0) (Away (grading 𝒜 S) ((1 : S) ⊗ₜ[R] a)) s
    rw [chartEquiv_tmul, map_one, Algebra.smul_def, mul_one]
  · show chartEquiv 𝒜 S ha ((1 : grading 𝒜 S 0) ⊗ₜ[𝒜 0] s) = awayMap 𝒜 S a s
    rw [chartEquiv_tmul, one_smul]

/-- **The chart square of the base change is a cartesian square of affine schemes.** -/
public theorem isPullback_specAwayMap (ha : a ∈ 𝒜 d) :
    IsPullback
      (Spec.map (CommRingCat.ofHom
        (algebraMap (grading 𝒜 S 0) (Away (grading 𝒜 S) ((1 : S) ⊗ₜ[R] a)))))
      (Spec.map (CommRingCat.ofHom (awayMap 𝒜 S a)))
      (Spec.map (CommRingCat.ofHom (gradedZeroMap 𝒜 S)))
      (Spec.map (CommRingCat.ofHom (algebraMap (𝒜 0) (Away 𝒜 a)))) :=
  isPullback_SpecMap_of_isPushout _ _ _ _ (isPushout_awayMap 𝒜 S ha)

end Pushout

/-! ### The comparison with the fibre product -/

/-- The degree-zero leg of the base-change square of projective spectra. -/
public abbrev specZeroMap :
    Spec (CommRingCat.of (grading 𝒜 S 0)) ⟶ Spec (CommRingCat.of (𝒜 0)) :=
  Spec.map (CommRingCat.ofHom (gradedZeroMap 𝒜 S))

/-- **The canonical morphism from `Proj (S ⊗[R] A)` to the fibre product** of `Proj A` with
`Spec ((S ⊗[R] 𝒜) 0)` over `Spec (𝒜 0)`. -/
public def projCompare :
    Proj (grading 𝒜 S) ⟶ pullback (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S) :=
  pullback.lift (Stacks.ProjBaseChange.map 𝒜 S) (Proj.toSpecZero (grading 𝒜 S))
    (map_toSpecZero 𝒜 S)

/-- The first component of `projCompare` is the base-change morphism
`Proj (S ⊗[R] A) ⟶ Proj A`. -/
@[reassoc (attr := simp)]
public theorem projCompare_fst :
    projCompare 𝒜 S ≫ pullback.fst (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S) =
      Stacks.ProjBaseChange.map 𝒜 S :=
  pullback.lift_fst _ _ _

/-- The second component of `projCompare` is the structure morphism
`Proj (S ⊗[R] A) ⟶ Spec ((S ⊗[R] 𝒜) 0)`. -/
@[reassoc (attr := simp)]
public theorem projCompare_snd :
    projCompare 𝒜 S ≫ pullback.snd (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S) =
      Proj.toSpecZero (grading 𝒜 S) :=
  pullback.lift_snd _ _ _

/-! ### The cover by the standard charts -/

/-- The index set of the cover of `Proj 𝒜` by standard affine charts: the homogeneous elements of
positive degree. -/
public abbrev chartIndex : Type u := {p : ℕ × A // 0 < p.1 ∧ p.2 ∈ 𝒜 p.1}

/-- The opens of the fibre product covered by the base changes of the standard charts. -/
public def chartOpen (p : chartIndex 𝒜) :
    (pullback (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S)).Opens :=
  pullback.fst (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S) ⁻¹ᵁ Proj.basicOpen 𝒜 p.1.2

/-- **The standard charts cover `Proj 𝒜`**: a homogeneous element of positive degree lies in the
ideal generated by all of them. -/
public theorem iSup_basicOpen_chartIndex_eq_top :
    (⨆ p : chartIndex 𝒜, Proj.basicOpen 𝒜 p.1.2) = ⊤ :=
  Proj.iSup_basicOpen_eq_top 𝒜 (fun p : chartIndex 𝒜 => p.1.2)
    ((HomogeneousIdeal.toIdeal_irrelevant_le _).mpr fun i hi x hx =>
      Ideal.subset_span ⟨⟨(i, x), hi, hx⟩, rfl⟩)

/-- **The base changes of the standard charts cover the fibre product.** -/
public theorem iSup_chartOpen_eq_top :
    (⨆ p : chartIndex 𝒜, chartOpen 𝒜 S p) = ⊤ :=
  Scheme.Hom.iSup_preimage_eq_top _ (iSup_basicOpen_chartIndex_eq_top 𝒜)

/-! ### The chart of `Proj (S ⊗[R] A)` is the fibre product -/

section Chart

variable {d : ℕ} {a : A}

/-- **On a standard chart the comparison is an isomorphism onto the fibre product.** The chart
`Spec (Away (S ⊗[R] 𝒜) (1 ⊗ₜ a))` of `Proj (S ⊗[R] A)` is the fibre product of the comparison
with the base change of the chart `Spec (Away 𝒜 a)` of `Proj A`. -/
public theorem exists_isIso_chartCompare (hd : 0 < d) (ha : a ∈ 𝒜 d) :
    ∃ q : Spec (CommRingCat.of (Away (grading 𝒜 S) ((1 : S) ⊗ₜ[R] a))) ⟶
        pullback (Proj.awayι 𝒜 a ha hd)
          (pullback.fst (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S)),
      IsIso q ∧
        IsPullback (Proj.awayι (grading 𝒜 S) ((1 : S) ⊗ₜ[R] a) (tmul_one_mem 𝒜 S ha) hd) q
          (projCompare 𝒜 S)
          (pullback.snd (Proj.awayι 𝒜 a ha hd)
            (pullback.fst (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S))) := by
  -- the base-changed chart is the fibre product of `Spec ((S ⊗[R] 𝒜) 0)` with `Spec (Away 𝒜 a)`
  have hZ : IsPullback
      (pullback.snd (Proj.awayι 𝒜 a ha hd)
          (pullback.fst (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S)) ≫
        pullback.snd (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S))
      (pullback.fst (Proj.awayι 𝒜 a ha hd)
        (pullback.fst (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S)))
      (specZeroMap 𝒜 S)
      (Spec.map (CommRingCat.ofHom (algebraMap (𝒜 0) (Away 𝒜 a)))) := by
    have h := (IsPullback.of_hasPullback (Proj.awayι 𝒜 a ha hd)
        (pullback.fst (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S))).flip.paste_horiz
      (IsPullback.of_hasPullback (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S)).flip
    rwa [Proj.awayι_toSpecZero] at h
  refine ⟨((isPullback_specAwayMap 𝒜 S ha).isoIsPullback _ _ hZ).hom, inferInstance, ?_⟩
  have hfst := IsPullback.isoIsPullback_hom_fst _ _ (isPullback_specAwayMap 𝒜 S ha) hZ
  have hsnd := IsPullback.isoIsPullback_hom_snd _ _ (isPullback_specAwayMap 𝒜 S ha) hZ
  -- the chart square of the morphism of projective spectra
  have hA0 : IsPullback
      (Proj.awayι (grading 𝒜 S) ((1 : S) ⊗ₜ[R] a) (tmul_one_mem 𝒜 S ha) hd)
      (Spec.map (CommRingCat.ofHom (awayMap 𝒜 S a)))
      (Stacks.ProjBaseChange.map 𝒜 S) (Proj.awayι 𝒜 a ha hd) :=
    ProjBaseChange.isPullback_awayι_projMap 𝒜 (grading 𝒜 S) (includeRight 𝒜 S)
      (irrelevant_le_map 𝒜 S) hd ha (tmul_one_mem 𝒜 S ha) rfl (awayMap 𝒜 S a)
      fun k b hb _ => awayMap_mk 𝒜 S ha k b hb
  have hA : IsPullback
      (Proj.awayι (grading 𝒜 S) ((1 : S) ⊗ₜ[R] a) (tmul_one_mem 𝒜 S ha) hd)
      (((isPullback_specAwayMap 𝒜 S ha).isoIsPullback _ _ hZ).hom ≫
        pullback.fst (Proj.awayι 𝒜 a ha hd)
          (pullback.fst (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S)))
      (projCompare 𝒜 S ≫ pullback.fst (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S))
      (Proj.awayι 𝒜 a ha hd) := by
    rw [hsnd, projCompare_fst]
    exact hA0
  refine IsPullback.of_bot hA ?_ (IsPullback.of_hasPullback _ _).flip
  refine pullback.hom_ext ?_ ?_
  · have hw := hA.w
    simp only [Category.assoc] at hw ⊢
    rw [← pullback.condition]
    exact hw
  · simp only [Category.assoc]
    rw [projCompare_snd, Proj.awayι_toSpecZero]
    exact hfst.symm

end Chart

/-! ### The cartesian square -/

/-- **The comparison with the fibre product is an isomorphism**, by gluing over the cover by the
base changes of the standard charts. -/
public instance isIso_projCompare : IsIso (projCompare 𝒜 S) := by
  choose q hq hpb using fun p : chartIndex 𝒜 =>
    exists_isIso_chartCompare 𝒜 S p.2.1 p.2.2
  refine ProjBaseChange.isIso_of_isPullback_cover (projCompare 𝒜 S) (chartOpen 𝒜 S)
    (iSup_chartOpen_eq_top 𝒜 S) _
    (fun p : chartIndex 𝒜 => pullback.snd (Proj.awayι 𝒜 p.1.2 p.2.2 p.2.1)
      (pullback.fst (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S)))
    (fun p => inferInstance) (fun p => ?_) _ _ q hpb hq
  rw [IsOpenImmersion.range_pullbackSnd, Proj.opensRange_awayι]
  rfl

/-- **The base-change square of projective spectra is cartesian.** For a graded `R`-algebra `A`
and an `R`-algebra `S`, the square
`Proj (S ⊗[R] A) ⟶ Proj A`, `Proj (S ⊗[R] A) ⟶ Spec ((S ⊗[R] 𝒜) 0)`,
`Proj A ⟶ Spec (𝒜 0)`, `Spec ((S ⊗[R] 𝒜) 0) ⟶ Spec (𝒜 0)` is a pullback square. -/
public theorem isPullback_map_toSpecZero :
    IsPullback (Stacks.ProjBaseChange.map 𝒜 S) (Proj.toSpecZero (grading 𝒜 S))
      (Proj.toSpecZero 𝒜) (specZeroMap 𝒜 S) :=
  IsPullback.of_iso_pullback ⟨map_toSpecZero 𝒜 S⟩ (asIso (projCompare 𝒜 S))
    (projCompare_fst 𝒜 S) (projCompare_snd 𝒜 S)

end Cartesian

end Stacks.AlgebraicGeometry.ProjChartBaseChange

end
