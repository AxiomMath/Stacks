/-!
# Commuting families of quasi-coherent modules on a Noetherian scheme

Let `Z` be a Noetherian scheme and `G` a commuting family (`Stacks.CommutingFamily`) of
quasi-coherent `𝒪_Z`-modules of finite type, generated in bounded degree: the shape of a
quasi-coherent graded module of finite type over `𝒪_Z[T₀, …, T_r]` with all variables in degree
one.  This file proves that the kernel family of the last map is again generated in bounded
degree, which is the Noetherian input `hnoeth` of
`Stacks.CommutingFamily.exists_forall_isZero_of_isGenerated`.

## Main results

* `Stacks.CommutingFamily.isZero_of_isQuasicoherent_of_finset_affine`: a quasi-coherent module
  whose sections vanish over the members of a finite affine open cover is zero.
* `Stacks.CommutingFamily.isGenerated_kernelFamily_of_isNoetherian`: **the kernel family is
  generated in bounded degree.**

## The argument

Cover `Z` by finitely many affine opens `W`.  Over each of them the sections of the family form a
graded module over `Γ(Z, W)[T₀, …, T_r]` satisfying the hypotheses of
`Stacks.CommutingFamilyAlgebra.exists_ker_le_iSup_map_ker`: the sections of the members are
finite over the Noetherian ring `Γ(Z, W)` ([Stacks, Tag 01PB]), and generation passes to sections
because an epimorphism of quasi-coherent modules is surjective on the sections over an affine
open.  That gives a bound on each `W`; above the largest of them the sections of the kernel family
over every `W` are generated by the lower degrees, the sections of a kernel being the kernel of
the sections.  So the cokernel of the map that generation asks to be an epimorphism has no
sections over any `W`, and being quasi-coherent it is zero.

## References

* [Stacks Project, Tag 01PB](https://stacks.math.columbia.edu/tag/01PB)
* [Stacks Project, Tag 0897](https://stacks.math.columbia.edu/tag/0897)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry TensorProduct

universe u

attribute [local instance] HasFiniteBiproducts.of_hasFiniteProducts

namespace Stacks.CommutingFamily

variable {Z : Scheme.{u}}

/-- A quasi-coherent module whose sections vanish over the members of a family of affine opens
covering the scheme is zero: over a basic open of a member the sections are a base change of
the sections over the member. -/
theorem isZero_of_isQuasicoherent_of_finset_affine (C : Z.Modules) [C.IsQuasicoherent]
    (W : Finset Z.affineOpens) (hW : ∀ x : Z, ∃ w ∈ W, x ∈ (w : Z.Opens))
    (hC : ∀ w ∈ W, ∀ s : Γ(C, (w : Z.Opens)), s = 0) : IsZero C := by
  have hsec : ∀ (U : Z.affineOpens) (s t : Γ(C, (U : Z.Opens))), s = t := by
    intro U s t
    refine TopCat.Presheaf.section_ext ⟨C.presheaf, C.isSheaf⟩ U.1 s t fun x hx => ?_
    obtain ⟨w, hw, hxw⟩ := hW x
    obtain ⟨g, hgle, hxg⟩ := w.2.exists_basicOpen_le (V := U.1 ⊓ (w : Z.Opens)) ⟨x, ⟨hx, hxw⟩⟩
      hxw
    -- The sections over the basic open `D(g)` of `w` vanish.
    have hsub : Subsingleton Γ(C, Z.basicOpen g) := by
      let e := AlgebraicGeometry.basicOpenSectionsBaseChangeIso C w.2 g
      refine ⟨fun a b => (e.toLinearEquiv.symm.injective) ?_⟩
      have hzero : ∀ z : (ModuleCat.extendScalars (Scheme.Hom.appLE (𝟙 Z) (w : Z.Opens)
          (Z.basicOpen g) (AlgebraicGeometry.basicOpen_le_id_preimage g)).hom).obj
            (ModuleCat.of Γ(Z, (w : Z.Opens)) Γ(C, (w : Z.Opens))), z = 0 := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => rfl
        | tmul a m => rw [hC w hw m]; exact TensorProduct.tmul_zero _ _
        | add y z hy hz => rw [hy, hz]; exact zero_add _
      rw [hzero (e.toLinearEquiv.symm a), hzero (e.toLinearEquiv.symm b)]
    have hle : Z.basicOpen g ≤ U.1 := hgle.trans inf_le_left
    rw [← C.presheaf.germ_res_apply (homOfLE hle) x hxg s,
      ← C.presheaf.germ_res_apply (homOfLE hle) x hxg t,
      Subsingleton.elim (C.presheaf.map (homOfLE hle).op s) (C.presheaf.map (homOfLE hle).op t)]
  exact Stacks.Coherent.isZero_of_affine_sections C fun U =>
    @ModuleCat.isZero_of_subsingleton _ _ _ ⟨hsec U⟩

/-- A noetherian scheme is covered by finitely many affine opens. -/
theorem exists_finset_affineOpens_cover [CompactSpace Z] :
    ∃ W : Finset Z.affineOpens, ∀ x : Z, ∃ w ∈ W, x ∈ (w : Z.Opens) := by
  obtain ⟨W, hW⟩ := isCompact_univ.elim_finite_subcover
    (fun U : Z.affineOpens => ((U : Z.Opens) : Set Z)) (fun U => U.1.isOpen) (by
      intro x _
      have hx : x ∈ (⊤ : Z.Opens) := trivial
      rw [← AlgebraicGeometry.iSup_affineOpens_eq_top Z] at hx
      obtain ⟨U, hU⟩ := TopologicalSpace.Opens.mem_iSup.1 hx
      exact Set.mem_iUnion.2 ⟨U, hU⟩)
  refine ⟨W, fun x => ?_⟩
  obtain ⟨w, hw, hxw⟩ := Set.mem_iUnion₂.1 (hW (Set.mem_univ x))
  exact ⟨w, hw, hxw⟩

/-- A finite sum of morphisms of `𝒪_Z`-modules acts on sections as the sum of the actions. -/
theorem app_sum_apply {M N : Z.Modules} {ι : Type*} (s : Finset ι) (f : ι → (M ⟶ N))
    (U : Z.Opens) (x : Γ(M, U)) :
    (∑ i ∈ s, f i).app U x = ∑ i ∈ s, (f i).app U x := by
  classical
  induction s using Finset.induction_on with
  | empty => rfl
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha, Scheme.Modules.Hom.add_app,
      AddCommGrpCat.hom_add_apply, ih]

/-- In an abelian category, maps of a commuting family that are jointly epimorphic make the map
out of the biproduct an epimorphism, and conversely. -/
theorem generatedFrom_iff_epi_biproduct_desc {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜]
    [HasFiniteBiproducts 𝒜] {r : ℕ}
    (G : CommutingFamily 𝒜 r) (N : ℕ) :
    G.GeneratedFrom N ↔ ∀ n, N ≤ n → Epi (biproduct.desc fun i => G.act i n) := by
  constructor
  · intro hG n hn
    refine ⟨fun {Q} g h g_eq => ?_⟩
    rw [← sub_eq_zero]
    refine hG n hn _ fun i => ?_
    have := congrArg (fun k => biproduct.ι (fun _ : Fin r => G.obj n) i ≫ k) g_eq
    simp only [biproduct.ι_desc_assoc] at this
    rw [Preadditive.comp_sub, this, sub_self]
  · intro hG n hn Q g hg
    have := hG n hn
    refine (cancel_epi (biproduct.desc fun i => G.act i n)).1 ?_
    rw [comp_zero]
    exact biproduct.hom_ext' _ _ fun i => by simp [hg i]

/-- A composite of morphisms of `𝒪_Z`-modules acts on sections as the composite of the actions. -/
private theorem app_comp_apply {M N P : Z.Modules} (f : M ⟶ N) (g : N ⟶ P) (U : Z.Opens)
    (x : Γ(M, U)) : (f ≫ g).app U x = g.app U (f.app U x) := rfl

variable [IsNoetherian Z]

/-- **The kernel family of a generated commuting family of quasi-coherent modules of finite type
on a Noetherian scheme is generated.** -/
theorem isGenerated_kernelFamily_of_isNoetherian {r : ℕ} (G : CommutingFamily Z.Modules (r + 1))
    [hqc : ∀ n, (G.obj n).IsQuasicoherent] [hft : ∀ n, (G.obj n).IsFiniteType]
    (hG : G.IsGenerated) : G.kernelFamily.IsGenerated := by
  classical
  obtain ⟨N, hN⟩ := hG
  obtain ⟨W, hW⟩ := exists_finset_affineOpens_cover (Z := Z)
  -- The bound on each affine open of the cover.
  have hbound : ∀ w : Z.affineOpens, ∃ N' : ℕ, ∀ n, N' ≤ n →
      LinearMap.ker (Scheme.Modules.sectionsLinearMap (G.act (Fin.last r) (n + 1)) w.1) ≤
        ⨆ i : Fin r, (LinearMap.ker (Scheme.Modules.sectionsLinearMap
          (G.act (Fin.last r) n) w.1)).map
          (Scheme.Modules.sectionsLinearMap (G.act i.castSucc n) w.1) := by
    intro w
    have : IsNoetherianRing Γ(Z, w.1) := IsLocallyNoetherian.component_noetherian w
    have : ∀ n, Module.Finite Γ(Z, w.1) Γ(G.obj n, w.1) := fun n =>
      Stacks.AlgebraicGeometry.CoherentFinite.finite_sections (G.obj n) w.2
    refine Stacks.CommutingFamilyAlgebra.exists_ker_le_iSup_map_ker
      (fun i n => Scheme.Modules.sectionsLinearMap (G.act i n) w.1) (fun i j n => ?_)
      (N := N) fun n hn => ?_
    · refine LinearMap.ext fun x => ?_
      simpa only [LinearMap.comp_apply, Scheme.Modules.sectionsLinearMap_apply,
        ← app_comp_apply] using
        congrArg (fun k => Scheme.Modules.Hom.app k w.1 x) (G.comm i j n)
    · -- Generation passes to sections over the affine open.
      have := (generatedFrom_iff_epi_biproduct_desc G N).1 hN n hn
      rw [eq_top_iff]
      rintro x -
      obtain ⟨z, rfl⟩ : ∃ z : Γ(⨁ fun _ : Fin (r + 1) => G.obj n, w.1),
          (biproduct.desc fun i => G.act i n).app w.1 z = x :=
        Stacks.SectionEpiAffine.surjective_app_of_isAffineOpen Z
          (biproduct.desc fun i => G.act i n) w.1 w.2 x
      have htot : biproduct.desc (fun i => G.act i n) =
          ∑ i : Fin (r + 1), biproduct.π (fun _ : Fin (r + 1) => G.obj n) i ≫ G.act i n := by
        refine biproduct.hom_ext' _ _ fun j => ?_
        rw [biproduct.ι_desc, Preadditive.comp_sum]
        simp [biproduct.ι_π_assoc, ite_comp]
      rw [htot, app_sum_apply]
      exact Submodule.sum_mem _ fun i _ => Submodule.mem_iSup_of_mem i ⟨_, rfl⟩
  choose Nw hNw using hbound
  refine ⟨W.sup Nw, (generatedFrom_iff_epi_biproduct_desc _ _).2 fun n hn => ?_⟩
  have : ∀ m, (G.kernelFamily.obj m).IsQuasicoherent := fun m =>
    Stacks.AlgebraicGeometry.QcohLimits.isQuasicoherent_kernel _
  let d := biproduct.desc fun i => G.kernelFamily.act i n
  have : (cokernel d).IsQuasicoherent :=
    Stacks.AlgebraicGeometry.QuasicoherentColimits.isQuasicoherent_cokernel d
  refine Preadditive.epi_of_isZero_cokernel d ?_
  refine isZero_of_isQuasicoherent_of_finset_affine (cokernel d) W hW fun w hw s => ?_
  obtain ⟨t, rfl⟩ : ∃ t : Γ(kernel (G.act (Fin.last r) (n + 1)), w.1),
      (cokernel.π d).app w.1 t = s :=
    Stacks.SectionEpiAffine.surjective_app_of_isAffineOpen Z (cokernel.π d) w.1 w.2 s
  -- Every element of the kernel generated by the lower degree comes from the biproduct.
  have hlift : ∀ y ∈ ⨆ i : Fin r, (LinearMap.ker (Scheme.Modules.sectionsLinearMap
        (G.act (Fin.last r) n) w.1)).map
        (Scheme.Modules.sectionsLinearMap (G.act i.castSucc n) w.1),
      ∃ z : Γ(⨁ fun _ : Fin r => G.kernelFamily.obj n, w.1),
        (kernel.ι (G.act (Fin.last r) (n + 1))).app w.1 (d.app w.1 z) = y := by
    intro y hy
    induction hy using Submodule.iSup_induction' with
    | mem i y hy =>
      obtain ⟨y', hy', rfl⟩ := hy
      obtain ⟨k, hk⟩ := (Stacks.AlgebraicGeometry.QcohLimits.exact_app_kernel
        (G.act (Fin.last r) n) w.1 y').1 hy'
      refine ⟨(biproduct.ι (fun _ : Fin r => G.kernelFamily.obj n) i).app w.1 k, ?_⟩
      rw [← app_comp_apply, ← app_comp_apply, biproduct.ι_desc_assoc, kernelFamily_act_ι,
        app_comp_apply, hk]
      rfl
    | zero => exact ⟨0, by simp⟩
    | add y₁ y₂ _ _ h₁ h₂ =>
      obtain ⟨z₁, hz₁⟩ := h₁
      obtain ⟨z₂, hz₂⟩ := h₂
      exact ⟨z₁ + z₂, by rw [map_add, map_add, hz₁, hz₂]⟩
  have hker : (kernel.ι (G.act (Fin.last r) (n + 1))).app w.1 t ∈
      LinearMap.ker (Scheme.Modules.sectionsLinearMap (G.act (Fin.last r) (n + 1)) w.1) := by
    rw [LinearMap.mem_ker, Scheme.Modules.sectionsLinearMap_apply, ← app_comp_apply,
      kernel.condition]
    rfl
  obtain ⟨z, hz⟩ := hlift _ (hNw w (n := n) ((Finset.le_sup hw).trans hn) hker)
  have hzt : d.app w.1 z = t :=
    Stacks.AlgebraicGeometry.QcohLimits.injective_app_kernel_ι _ w.1 hz
  rw [← hzt, ← app_comp_apply, cokernel.condition]
  rfl

end Stacks.CommutingFamily

end
