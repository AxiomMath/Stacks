module

public import Mathlib.AlgebraicGeometry.Noetherian
public import StacksFrontier.AlgebraicGeometry.Cohomology.Coherent.FiniteTilde
public import StacksFrontier.AlgebraicGeometry.AffinePushforward.Basic
public import StacksFrontier.AlgebraicGeometry.Modules.TildeExactness
public import StacksFrontier.AlgebraicGeometry.Modules.TildeFiniteness

/-!
# Relations among sections over an affine open of a locally Noetherian scheme

Let `X` be a locally Noetherian scheme, `F` a quasi-coherent `𝒪_X`-module and `V ⊆ X` an affine
open. This file proves that for every finite index type `I` and every map `φ : 𝒪_V^I ⟶ F|_V` of
modules on the slice site at `V`, the kernel of `φ` is of finite type. It is the affine input to
[Stacks, Tag 01XZ] in the direction *into* coherence, and the only place in that argument where
the Noetherian hypothesis is used.

The mathematics is the second paragraph of the source's proof, read backwards. Over
`A = Γ(X, V)`, which is Noetherian, `F|_V` becomes a quasi-coherent module on `Spec A`, hence the
sheaf `M^~` associated with its module of global sections, and `𝒪^I` becomes `(I →₀ A)^~`. Since
`M ↦ M^~` is fully faithful, `φ` is `h^~` for an `A`-linear map `h : (I →₀ A) → M`; since it is
exact, the kernel of `φ` is `(ker h)^~`; and `ker h` is a submodule of the finite module
`I →₀ A` over a Noetherian ring, hence finite. A finite module has finitely many global
generating sections, and those transport back to the slice site at `V`.

Note what is *not* needed: no finiteness of `M`, so [Stacks, Tag 01PB] is not an input here.

## Main definitions

* `Stacks.AlgebraicGeometry.CoherentOfFiniteType.restrictEquivOfIso`: restriction of modules
  along an isomorphism of schemes, as an equivalence of categories.
* `Stacks.AlgebraicGeometry.CoherentOfFiniteType.specEquiv`: the equivalence between modules on
  the slice site at an affine open `V` and modules on `Spec Γ(X, V)`, together with the
  identifications `specEquivUnit`, `specEquivObj` and `specEquivFree` of the structure sheaf, of
  `F|_V` and of the finite free modules, and the transport `generatingSectionsInverse` of
  generating sections back to the slice site.

## Main results

* `Stacks.AlgebraicGeometry.CoherentOfFiniteType.exists_generatingSections_kernel_free_spec`: on
  the spectrum of a Noetherian ring, the kernel of a map from a finite free module into a
  quasi-coherent module is generated by finitely many global sections.
* `Stacks.AlgebraicGeometry.CoherentOfFiniteType.isFiniteType_kernel_free_isAffineOpen`: the
  same statement over an affine open of a locally Noetherian scheme, as finiteness of type on
  the slice site.

## Implementation notes

`AlgebraicGeometry.Scheme.Modules` is a `def` for `SheafOfModules _`, and the two agree only at
default transparency. Consequently several `Epi`, `Mono` and `IsIso` instances on morphisms of
`(Spec A).Modules` are not found by instance synthesis even though they are the plain
`Iso.isIso_hom`, and the colimit-preservation instances of an equivalence are not found once a
functor into `(Spec A).Modules` has been reinterpreted as a functor into `SheafOfModules _`.
Every such instance is therefore supplied explicitly here — positionally, or through
`inferInstanceAs` stated at the `(Spec A).Modules` spelling. This is the same workaround as in
`StacksFrontier/AlgebraicGeometry/CoherentTFAE/Affine.lean`, and it needs no elaboration
options.

For the same reason the comparison of kernels is assembled from `Limits.kernelIsoOfEq`,
`Limits.kernelIsIsoComp` and `Limits.kernelCompMono` rather than from `Limits.kernel.mapIso`:
those three need no commuting square, and the squares one would otherwise have to discharge are
exactly the ones `simp` cannot close across the two spellings of the category.

## References

* [Stacks Project, Tag 01XZ](https://stacks.math.columbia.edu/tag/01XZ)
* [Stacks Project, Tag 01BV](https://stacks.math.columbia.edu/tag/01BV)
* [Stacks Project, Tag 01HV](https://stacks.math.columbia.edu/tag/01HV)
-/
@[expose] public section

open CategoryTheory Limits TopologicalSpace SheafOfModules
open AlgebraicGeometry

universe u

namespace Stacks.AlgebraicGeometry.CoherentOfFiniteType

/-! ### Restriction along an isomorphism of schemes -/

/-- Restriction of modules along an isomorphism of schemes is an equivalence. -/
noncomputable def restrictEquivOfIso {Y Z : Scheme.{u}} (e : Y ≅ Z) : Y.Modules ≌ Z.Modules :=
  CategoryTheory.Equivalence.mk (Scheme.Modules.restrictFunctor e.inv)
    (Scheme.Modules.restrictFunctor e.hom)
    ((Scheme.Modules.restrictFunctorId (X := Y)).symm ≪≫
      Scheme.Modules.restrictFunctorCongr e.hom_inv_id.symm ≪≫
      Scheme.Modules.restrictFunctorComp e.hom e.inv)
    ((Scheme.Modules.restrictFunctorComp e.inv e.hom).symm ≪≫
      Scheme.Modules.restrictFunctorCongr e.inv_hom_id ≪≫
      Scheme.Modules.restrictFunctorId (X := Z))

section Transport

variable {X : Scheme.{u}}

/-- Modules on the slice site at an affine open `V` are modules on `Spec Γ(X, V)`. -/
noncomputable def specEquiv {V : X.Opens} (hV : IsAffineOpen V) :
    SheafOfModules.{u} (X.ringCatSheaf.over V) ≌ (Spec Γ(X, V)).Modules :=
  (Scheme.Modules.overEquiv V).trans (restrictEquivOfIso hV.isoSpec)

/-- `specEquiv` carries the structure sheaf to the structure sheaf. -/
noncomputable def specEquivUnit {V : X.Opens} (hV : IsAffineOpen V) :
    unit.{u} (Spec Γ(X, V)).ringCatSheaf ≅
      (specEquiv hV).functor.obj (unit.{u} (X.ringCatSheaf.over V)) :=
  (((Scheme.Modules.restrictFunctor hV.isoSpec.inv).mapIso
      ((Scheme.Modules.overEquiv V).functor.mapIso
          (Stacks.AlgebraicGeometry.AffinePushforward.overInverseUnitIso V) ≪≫
        (Scheme.Modules.overEquiv V).counitIso.app
          (unit.{u} V.toScheme.ringCatSheaf))) ≪≫
    Scheme.Modules.restrictUnitIso hV.isoSpec.inv).symm

/-- `specEquiv` carries `F|_V` to `F` read on `Spec Γ(X, V)`. -/
noncomputable def specEquivObj {V : X.Opens} (hV : IsAffineOpen V) (F : X.Modules) :
    (specEquiv hV).functor.obj (F.over V) ≅
      Stacks.AlgebraicGeometry.CoherentTFAE.specRestrict F hV :=
  (Scheme.Modules.restrictFunctor hV.isoSpec.inv).mapIso
    ((Scheme.Modules.overFunctorEquiv V).app F)

/-- The free module of finite rank, transported along `specEquiv`. -/
noncomputable def specEquivFree {V : X.Opens} (hV : IsAffineOpen V) (I : Type u) :
    (free I : (Spec Γ(X, V)).Modules) ≅ (specEquiv hV).functor.obj (free I) :=
  @mapFreeIso _ _ _ _ _ _ _ _ _ _ _ _ (specEquiv hV).functor I
    (inferInstanceAs (PreservesColimitsOfShape (Discrete I) (specEquiv hV).functor))
    (specEquivUnit hV)

/-- `specEquiv` carries the structure sheaf of `Spec Γ(X, V)` back to the structure sheaf. -/
noncomputable def specEquivUnitInverse {V : X.Opens} (hV : IsAffineOpen V) :
    unit.{u} (X.ringCatSheaf.over V) ≅
      (specEquiv hV).inverse.obj (unit.{u} (Spec Γ(X, V)).ringCatSheaf) :=
  (specEquiv hV).unitIso.app _ ≪≫ ((specEquiv hV).inverse.mapIso (specEquivUnit hV)).symm

/-- Generating sections transport from `Spec Γ(X, V)` back to the slice site at `V`, with the
same index type. -/
noncomputable def generatingSectionsInverse {V : X.Opens} (hV : IsAffineOpen V)
    {N : (Spec Γ(X, V)).Modules} (σ : N.GeneratingSections) :
    ((specEquiv hV).inverse.obj N).GeneratingSections :=
  @GeneratingSections.map _ _ _ _ _ _ _ _ _ _ _ _ _ σ (specEquiv hV).inverse
    (inferInstanceAs (PreservesColimitsOfSize.{u, u} (specEquiv hV).inverse))
    (specEquivUnitInverse hV)

/-- The transported generating sections `generatingSectionsInverse hV σ` have the same index
type as `σ`. -/
@[simp]
theorem generatingSectionsInverse_I {V : X.Opens} (hV : IsAffineOpen V)
    {N : (Spec Γ(X, V)).Modules} (σ : N.GeneratingSections) :
    (generatingSectionsInverse hV σ).I = σ.I :=
  rfl

end Transport

/-! ### The affine computation -/

section Spec

variable {A : CommRingCat.{u}}

/-- A finite module has finitely many global generating sections after passing to `Spec`. -/
theorem exists_generatingSections_tilde (K : ModuleCat.{u} A) [Module.Finite A K] :
    ∃ σ : (tilde K).GeneratingSections, Finite σ.I := by
  classical
  obtain ⟨s, hsfin, hs⟩ := Submodule.fg_def.mp (Module.finite_def.mp ‹Module.Finite A K›)
  have hfin : Finite ↥s := hsfin
  exact ⟨Stacks.AlgebraicGeometry.CoherentTFAE.tildeGeneratingSections K _
    (by rwa [Subtype.range_coe]), hfin⟩

/-- On the spectrum of a Noetherian ring the kernel of a map from a finite free module into a
quasi-coherent module is generated by finitely many global sections. -/
theorem exists_generatingSections_kernel_free_spec [IsNoetherianRing A] (T : (Spec A).Modules)
    [T.IsQuasicoherent] {I : Type u} [Finite I] (ρ : (free I : (Spec A).Modules) ⟶ T) :
    ∃ σ : (kernel ρ).GeneratingSections, Finite σ.I := by
  have hiso : IsIso T.fromTildeΓ := inferInstance
  let εT : (tilde (moduleSpecΓFunctor.obj T) : (Spec A).Modules) ≅ T :=
    @asIso _ _ _ _ T.fromTildeΓ hiso
  let ρ₂ : (free I : (Spec A).Modules) ⟶ tilde (moduleSpecΓFunctor.obj T) := ρ ≫ εT.inv
  let h : ModuleCat.of A (I →₀ A) ⟶ moduleSpecΓFunctor.obj T :=
    (tilde.functor A).preimage ((tildeFinsupp (R := A) I).hom ≫ ρ₂)
  have hh : (tilde.functor A).map h = (tildeFinsupp (R := A) I).hom ≫ ρ₂ :=
    (tilde.functor A).map_preimage _
  have h1 : Module.Finite A (ModuleCat.of A (I →₀ A)) :=
    Module.Finite.of_basis Finsupp.basisSingleOne
  have h2 : Module.Finite A (ModuleCat.of A (LinearMap.ker h.hom)) := inferInstance
  let e₃ : (tilde (ModuleCat.of A (LinearMap.ker h.hom)) : (Spec A).Modules) ≅
      kernel ((tilde.functor A).map h) :=
    ((tilde.functor A).mapIso (ModuleCat.kernelIsoKer h)).symm ≪≫
      PreservesKernel.iso (tilde.functor A) h
  let e₄ : (kernel ((tilde.functor A).map h) : (Spec A).Modules) ≅ kernel ρ :=
    kernelIsoOfEq hh ≪≫
      @kernelIsIsoComp _ _ _ _ _ _ (tildeFinsupp (R := A) I).hom ρ₂ (Iso.isIso_hom _) _ ≪≫
      @kernelCompMono _ _ _ _ _ _ ρ εT.inv _ (@IsIso.mono_of_iso _ _ _ _ εT.inv (Iso.isIso_inv εT))
  obtain ⟨σ, hσ⟩ := exists_generatingSections_tilde (ModuleCat.of A (LinearMap.ker h.hom))
  exact ⟨GeneratingSections.equivOfIso (e₃ ≪≫ e₄) σ, hσ⟩

end Spec

/-! ### The affine open of a locally Noetherian scheme -/

section Noetherian

variable {X : Scheme.{u}} [IsLocallyNoetherian X]

/-- **The relations among finitely many sections over an affine open are locally finitely
generated.** -/
theorem isFiniteType_kernel_free_isAffineOpen (F : X.Modules) [F.IsQuasicoherent]
    {V : X.Opens} (hV : IsAffineOpen V) {I : Type u} [Finite I]
    (χ : (free I : SheafOfModules.{u} (X.ringCatSheaf.over V)) ⟶ F.over V) :
    (kernel χ).IsFiniteType := by
  have hnoeth : IsNoetherianRing Γ(X, V) :=
    _root_.AlgebraicGeometry.IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  have hT : ((specEquiv hV).functor.obj (F.over V)).IsQuasicoherent :=
    (SheafOfModules.isQuasicoherent (Spec Γ(X, V)).ringCatSheaf).prop_of_iso
      (specEquivObj hV F).symm inferInstance
  let ρ : (free I : (Spec Γ(X, V)).Modules) ⟶ (specEquiv hV).functor.obj (F.over V) :=
    (specEquivFree hV I).hom ≫ (specEquiv hV).functor.map χ
  have hker : (specEquiv hV).functor.obj (kernel χ) ≅ kernel ρ :=
    PreservesKernel.iso (specEquiv hV).functor χ ≪≫
      (@kernelIsIsoComp _ _ _ _ _ _ (specEquivFree hV I).hom ((specEquiv hV).functor.map χ)
        (Iso.isIso_hom _) _).symm
  obtain ⟨σ, hσ⟩ :=
    @exists_generatingSections_kernel_free_spec (Γ(X, V)) hnoeth _ hT I _ ρ
  let σ₃ : (kernel χ).GeneratingSections :=
    GeneratingSections.equivOfIso ((specEquiv hV).unitIso.app (kernel χ)).symm
      (generatingSectionsInverse hV (GeneratingSections.equivOfIso hker.symm σ))
  have hfin : Finite σ₃.I := hσ
  exact Stacks.AlgebraicGeometry.CoherentTFAE.isFiniteType_of_generatingSections
    (M := kernel χ) σ₃

end Noetherian

end Stacks.AlgebraicGeometry.CoherentOfFiniteType

end
