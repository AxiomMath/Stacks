module

public import Mathlib.RingTheory.AdicCompletion.Basic
public import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
public import Mathlib.RingTheory.KrullDimension.Field
public import Mathlib.RingTheory.KrullDimension.NonZeroDivisors
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import StacksFrontier.RingTheory.AdicCompletion.NoetherianRing
public import StacksFrontier.RingTheory.CompleteLocalRing.Noetherian
public import StacksCore.Tactic.StacksAttribute

/-!
# Filtrations whose graded pieces are the monomials in two elements

Let `A` be a commutative ring and let `x, y ∈ A`.  A *monomial filtration* on `A` with
generators `x, y` is a decreasing chain of ideals `A = I₀ ⊇ I₁ ⊇ I₂ ⊇ ⋯` which is
multiplicative (`Iₘ · Iₙ ⊆ Iₘ₊ₙ`), separated (`⋂ Iₙ = 0`) and complete (a series whose
`n`-th term lies in `Iₙ` converges), such that `(x, y) ⊆ I₁`, such that `Iₙ` is generated
by `(x, y)ⁿ` modulo `Iₙ₊₁`, and such that the `d + 1` monomials `xᵈ, xᵈ⁻¹y, …, yᵈ` are
linearly independent over `A / I₁` modulo `I_{d+1}`.

This is exactly the structure that the Stacks proof of tag 0C2K extracts from the
inverse system of an exceptional curve of the first kind: there `A = lim H⁰(Eₙ, 𝒪ₙ)`,
`Iₙ` is the kernel of the projection to `H⁰(Eₙ, 𝒪ₙ)`, and `x, y` are lifts of a basis of
`H⁰(E, 𝒪_E(-E)) = H⁰(𝐏¹, 𝒪(1))`.  The conclusion of that proof is purely commutative
algebra, and it is what this file proves: `Iₙ = (x, y)ⁿ`, the ring is `(x, y)`-adically
complete, local with maximal ideal `(x, y)`, Noetherian, of Krull dimension two, and
regular.

The argument for `Iₙ = (x, y)ⁿ` is the convergent-series argument of the source: an
element of `I_d` is peeled degree by degree against the monomial basis, and the `d + 1`
resulting coefficient series converge because their `e`-th terms lie in `I_{e-d}`.  Krull
dimension two comes from the fact that `x, y` is a regular sequence, which the linear
independence of the monomials gives by a leading-form computation
(`MonomialFiltration.mem_genIdeal_pow_succ_of_mul_gen₂`).

## Main definitions

* `AlgebraicGeometry.SemistableReduction.MonomialFiltration` — the structure above.

## Main results

* `MonomialFiltration.ideal_eq_genIdeal_pow` — `Iₙ = (x, y)ⁿ`.
* `MonomialFiltration.isAdicComplete` — `A` is `(x, y)`-adically complete.
* `MonomialFiltration.isLocalRing`, `MonomialFiltration.genIdeal_eq_maximalIdeal` — `A` is
  local with maximal ideal `(x, y)`.
* `MonomialFiltration.isNoetherianRing` — `A` is Noetherian.
* `MonomialFiltration.isNoetherianCompleteLocalRing` — the three preceding facts packaged
  as the predicate used by Stacks 0C2K.
* `MonomialFiltration.ideal_eq_maximalIdeal_pow` — `Iₙ` is the `n`-th power of the maximal
  ideal, which is the last clause of Stacks 0C2K.
* `MonomialFiltration.ringKrullDim_eq_two` — `A` has Krull dimension two.
* `MonomialFiltration.isRegularLocalRing` — `A` is a regular local ring.

## References

* [Stacks Project, Tag 0C2K](https://stacks.math.columbia.edu/tag/0C2K)
-/

@[expose] public noncomputable section

universe u

namespace AlgebraicGeometry.SemistableReduction

section Monomials

variable {A : Type u} [CommRing A] (x y : A)

/-- The degree-`n` monomials in `x` and `y`: `genMonomial x y n j = x ^ (n - j) * y ^ j`. -/
public def genMonomial (n j : ℕ) : A := x ^ (n - j) * y ^ j

/-- The unique monomial of degree zero is `1`. -/
@[simp]
public theorem genMonomial_zero_zero : genMonomial x y 0 0 = 1 := by simp [genMonomial]

/-- A degree-`n` monomial lies in the `n`-th power of the ideal generated by `x` and `y`. -/
public theorem genMonomial_mem_span_pow {n j : ℕ} (hj : j ≤ n) :
    genMonomial x y n j ∈ Ideal.span {x, y} ^ n := by
  have hx : x ∈ Ideal.span ({x, y} : Set A) :=
    Ideal.subset_span (by simp)
  have hy : y ∈ Ideal.span ({x, y} : Set A) :=
    Ideal.subset_span (by simp)
  have := Ideal.mul_mem_mul (Ideal.pow_mem_pow hx (n - j)) (Ideal.pow_mem_pow hy j)
  rwa [← pow_add, Nat.sub_add_cancel hj] at this

/-- Multiplying a degree-`n` monomial by `x` gives the monomial of the same `y`-exponent in
degree `n + 1`. -/
public theorem genMonomial_mul_gen₁ {n j : ℕ} (hj : j ≤ n) :
    genMonomial x y n j * x = genMonomial x y (n + 1) j := by
  have h : n + 1 - j = (n - j) + 1 := by omega
  simp only [genMonomial, h, pow_succ]
  ring

/-- Multiplying a degree-`n` monomial by `y` raises the `y`-exponent by one. -/
public theorem genMonomial_mul_gen₂ (n j : ℕ) :
    genMonomial x y n j * y = genMonomial x y (n + 1) (j + 1) := by
  have h : n + 1 - (j + 1) = n - j := by omega
  simp only [genMonomial, h, pow_succ]
  ring

/-- The `n`-th power of the ideal generated by `x` and `y` is spanned by the degree-`n`
monomials in `x` and `y`. -/
public theorem span_pow_eq_span_range_genMonomial (n : ℕ) :
    Ideal.span ({x, y} : Set A) ^ n =
      Ideal.span (Set.range fun j : Fin (n + 1) => genMonomial x y n j) := by
  induction n with
  | zero =>
    refine le_antisymm ?_ (Ideal.span_le.2 ?_)
    · rw [pow_zero, Ideal.one_eq_top, ← Ideal.span_singleton_one]
      refine Ideal.span_le.2 ?_
      rintro a rfl
      exact Ideal.subset_span ⟨0, by simp⟩
    · rintro a ⟨j, rfl⟩
      simp
  | succ n ih =>
    refine le_antisymm ?_ (Ideal.span_le.2 ?_)
    · rw [pow_succ, ih, Ideal.span_mul_span]
      refine Ideal.span_le.2 ?_
      rintro a ⟨m, ⟨j, rfl⟩, g, hg, rfl⟩
      have hj : (j : ℕ) ≤ n := Nat.lt_succ_iff.1 j.2
      rcases hg with hg | hg
      · rw [hg]
        exact Ideal.subset_span ⟨⟨(j : ℕ), by omega⟩, (genMonomial_mul_gen₁ x y hj).symm⟩
      · rw [hg]
        exact Ideal.subset_span
          ⟨⟨(j : ℕ) + 1, by omega⟩, (genMonomial_mul_gen₂ x y n (j : ℕ)).symm⟩
    · rintro a ⟨j, rfl⟩
      exact genMonomial_mem_span_pow x y (Nat.lt_succ_iff.1 j.2)

/-- Every element of `(x, y) ^ n` is an `A`-linear combination of the degree-`n` monomials
in `x` and `y`. -/
public theorem exists_repr_of_mem_span_pow {n : ℕ} {a : A}
    (ha : a ∈ Ideal.span ({x, y} : Set A) ^ n) :
    ∃ c : ℕ → A, a = ∑ j ∈ Finset.range (n + 1), c j * genMonomial x y n j := by
  rw [span_pow_eq_span_range_genMonomial] at ha
  obtain ⟨c, hc⟩ := Submodule.mem_span_range_iff_exists_fun A |>.1 ha
  refine ⟨fun j => if h : j < n + 1 then c ⟨j, h⟩ else 0, ?_⟩
  rw [← hc, Finset.sum_range fun j => (if h : j < n + 1 then c ⟨j, h⟩ else 0) * genMonomial x y n j]
  exact Finset.sum_congr rfl fun j _ => by simp [j.2]

/-- Any `A`-linear combination of the degree-`n` monomials in `x` and `y` lies in
`(x, y) ^ n`. -/
public theorem sum_genMonomial_mem_span_pow (n : ℕ) (c : ℕ → A) :
    ∑ j ∈ Finset.range (n + 1), c j * genMonomial x y n j ∈ Ideal.span ({x, y} : Set A) ^ n :=
  Submodule.sum_mem _ fun _ hj =>
    Ideal.mul_mem_left _ _
      (genMonomial_mem_span_pow x y (Nat.lt_succ_iff.1 (Finset.mem_range.1 hj)))

/-- Every element of `K · (x, y) ^ d` is a combination of the degree-`d` monomials with
coefficients in `K`. -/
public theorem exists_repr_of_mem_mul_span_pow {K : Ideal A} {d : ℕ} {w : A}
    (hw : w ∈ K * Ideal.span ({x, y} : Set A) ^ d) :
    ∃ c : ℕ → A, (∀ j, c j ∈ K) ∧
      w = ∑ j ∈ Finset.range (d + 1), c j * genMonomial x y d j := by
  refine Submodule.mul_induction_on hw ?_ ?_
  · intro u hu v hv
    obtain ⟨c, hc⟩ := exists_repr_of_mem_span_pow x y hv
    refine ⟨fun j => u * c j, fun j => Ideal.mul_mem_right _ _ hu, ?_⟩
    rw [hc, Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => by ring
  · rintro a b ⟨ca, hca, rfl⟩ ⟨cb, hcb, rfl⟩
    refine ⟨fun j => ca j + cb j, fun j => add_mem (hca j) (hcb j), ?_⟩
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun j _ => by ring

end Monomials

/-- A *monomial filtration* on a commutative ring `A` is a decreasing, multiplicative,
separated and complete filtration `A = I₀ ⊇ I₁ ⊇ ⋯` by ideals together with two elements
`x = gen₁` and `y = gen₂` of `I₁` such that `Iₙ` is spanned by `(x, y)ⁿ` modulo `Iₙ₊₁` and
the degree-`d` monomials in `x` and `y` are linearly independent over `A / I₁` modulo
`I_{d+1}`.

This is the structure that the Stacks proof of tag 0C2K extracts from the inverse system
of thickenings of an exceptional curve of the first kind. -/
public structure MonomialFiltration (A : Type u) [CommRing A] where
  /-- The filtering ideals `Iₙ`. -/
  ideal : ℕ → Ideal A
  /-- The first generator, a lift of the first basis vector of `H⁰(E, 𝒪_E(-E))`. -/
  gen₁ : A
  /-- The second generator. -/
  gen₂ : A
  /-- The filtration starts at the whole ring. -/
  ideal_zero : ideal 0 = ⊤
  /-- The filtration decreases. -/
  ideal_succ_le : ∀ n, ideal (n + 1) ≤ ideal n
  /-- The filtration is multiplicative. -/
  mul_le : ∀ m n, ideal m * ideal n ≤ ideal (m + n)
  /-- Both generators lie in `I₁`. -/
  span_le_ideal_one : Ideal.span {gen₁, gen₂} ≤ ideal 1
  /-- `Iₙ` is spanned by the degree-`n` monomials modulo `Iₙ₊₁`. -/
  le_span_pow_sup : ∀ n, ideal n ≤ Ideal.span {gen₁, gen₂} ^ n ⊔ ideal (n + 1)
  /-- The filtration is separated. -/
  iInf_eq_bot : ⨅ n, ideal n = ⊥
  /-- The filtration is complete: a series whose `n`-th term lies in `Iₙ` converges. -/
  exists_sum : ∀ c : ℕ → A, (∀ n, c n ∈ ideal n) →
    ∃ s, ∀ n, s - ∑ e ∈ Finset.range n, c e ∈ ideal n
  /-- The degree-`d` monomials in the generators are linearly independent over `A / I₁`
  modulo `I_{d+1}`. -/
  monomials_indep : ∀ (d : ℕ) (c : ℕ → A),
    (∑ j ∈ Finset.range (d + 1), c j * genMonomial gen₁ gen₂ d j) ∈ ideal (d + 1) →
    ∀ j ≤ d, c j ∈ ideal 1
  /-- The residue ring `A / I₁` is a field. -/
  quotient_isField : IsField (A ⧸ ideal 1)

namespace MonomialFiltration

variable {A : Type u} [CommRing A] (F : MonomialFiltration A)

/-- The ideal generated by the two distinguished elements. -/
public abbrev genIdeal : Ideal A := Ideal.span {F.gen₁, F.gen₂}

/-- The filtration is antitone. -/
public theorem ideal_antitone {m n : ℕ} (h : m ≤ n) : F.ideal n ≤ F.ideal m := by
  induction n, h using Nat.le_induction with
  | base => exact le_rfl
  | succ k _ ih => exact (F.ideal_succ_le k).trans ih

/-- The `n`-th power of `(x, y)` is contained in `Iₙ`. -/
public theorem genIdeal_pow_le (n : ℕ) : F.genIdeal ^ n ≤ F.ideal n := by
  induction n with
  | zero => simp [F.ideal_zero]
  | succ n ih =>
    rw [pow_succ]
    exact (Ideal.mul_mono ih F.span_le_ideal_one).trans (F.mul_le n 1)

/-- Each generator lies in `I₁`. -/
public theorem gen₁_mem : F.gen₁ ∈ F.ideal 1 :=
  F.span_le_ideal_one (Ideal.subset_span (by simp))

/-- Each generator lies in `I₁`. -/
public theorem gen₂_mem : F.gen₂ ∈ F.ideal 1 :=
  F.span_le_ideal_one (Ideal.subset_span (by simp))

/-- An element lying in every member of a family of ideals with trivial intersection is zero. -/
private theorem eq_zero_of_forall_mem_of_iInf_eq_bot {ι : Type*} {I : ι → Ideal A}
    (h : ⨅ i, I i = ⊥) {a : A} (ha : ∀ i, a ∈ I i) : a = 0 := by
  have := Ideal.mem_iInf.2 ha
  rw [h] at this
  simpa using this

/-- **The key step of Stacks 0C2K.** Every element of `I_d` is already a combination of
the degree-`d` monomials in `x` and `y`: peel the element against the monomials degree by
degree and sum the `d + 1` coefficient series, which converge because their `e`-th terms
lie in `I_{e-d}`. -/
public theorem ideal_le_genIdeal_pow (d : ℕ) : F.ideal d ≤ F.genIdeal ^ d := by
  intro z hz
  -- One peeling step: split an element of `I_{d+n}` into a monomial combination with
  -- coefficients in `(x, y)ⁿ` plus a remainder in `I_{d+n+1}`.
  have step : ∀ (n : ℕ) (w : A), ∃ p : A × (ℕ → A), w ∈ F.ideal (d + n) →
      p.1 ∈ F.ideal (d + n + 1) ∧ (∀ j, p.2 j ∈ F.genIdeal ^ n) ∧
        w = (∑ j ∈ Finset.range (d + 1), p.2 j * genMonomial F.gen₁ F.gen₂ d j) + p.1 := by
    intro n w
    by_cases hw : w ∈ F.ideal (d + n)
    · obtain ⟨u, hu, r, hr, hur⟩ := Submodule.mem_sup.1 (F.le_span_pow_sup (d + n) hw)
      have hu' : u ∈ F.genIdeal ^ n * F.genIdeal ^ d := by
        rw [← pow_add]
        have : n + d = d + n := by omega
        rwa [this]
      obtain ⟨c, hc, hcs⟩ := exists_repr_of_mem_mul_span_pow F.gen₁ F.gen₂ hu'
      exact ⟨(r, c), fun _ => ⟨hr, hc, by rw [← hur, hcs]⟩⟩
    · exact ⟨(0, 0), fun h => absurd h hw⟩
  choose f hf using step
  -- The sequence of remainders.
  set Z : ℕ → A := fun n => Nat.rec (motive := fun _ => A) z (fun n zn => (f n zn).1) n with hZdef
  have hZsucc : ∀ n, Z (n + 1) = (f n (Z n)).1 := fun n => rfl
  have hZmem : ∀ n, Z n ∈ F.ideal (d + n) := by
    intro n
    induction n with
    | zero => simpa [hZdef] using hz
    | succ n ih => exact (hf n (Z n) ih).1
  have ha : ∀ n j, (f n (Z n)).2 j ∈ F.genIdeal ^ n := fun n => (hf n (Z n) (hZmem n)).2.1
  have hdecomp : ∀ n, Z n =
      (∑ j ∈ Finset.range (d + 1), (f n (Z n)).2 j * genMonomial F.gen₁ F.gen₂ d j) + Z (n + 1) :=
    fun n => by rw [hZsucc]; exact (hf n (Z n) (hZmem n)).2.2
  -- The `d + 1` coefficient series converge.
  have hser : ∀ j, ∃ b : A, ∀ N,
      b - ∑ n ∈ Finset.range N, (f n (Z n)).2 j ∈ F.ideal N := fun j =>
    F.exists_sum (fun n => (f n (Z n)).2 j) fun n => F.genIdeal_pow_le n (ha n j)
  choose b hb using hser
  -- Telescoping.
  have htel : ∀ N, z =
      (∑ j ∈ Finset.range (d + 1),
        (∑ n ∈ Finset.range N, (f n (Z n)).2 j) * genMonomial F.gen₁ F.gen₂ d j) + Z N := by
    intro N
    induction N with
    | zero => simp [hZdef]
    | succ N ih =>
      rw [ih, hdecomp N, ← add_assoc, ← Finset.sum_add_distrib]
      refine congrArg (· + Z (N + 1)) (Finset.sum_congr rfl fun j _ => ?_)
      rw [Finset.sum_range_succ, add_mul]
  -- The difference between `z` and the limiting combination lies in every `Iₙ`.
  have hfin : ∀ N, z - ∑ j ∈ Finset.range (d + 1), b j * genMonomial F.gen₁ F.gen₂ d j
      ∈ F.ideal N := by
    intro N
    have h2 : ∑ j ∈ Finset.range (d + 1),
          (b j - ∑ n ∈ Finset.range N, (f n (Z n)).2 j) * genMonomial F.gen₁ F.gen₂ d j
        = (∑ j ∈ Finset.range (d + 1), b j * genMonomial F.gen₁ F.gen₂ d j) -
          ∑ j ∈ Finset.range (d + 1),
            (∑ n ∈ Finset.range N, (f n (Z n)).2 j) * genMonomial F.gen₁ F.gen₂ d j := by
      rw [← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun j _ => by ring
    have h1 : z - ∑ j ∈ Finset.range (d + 1), b j * genMonomial F.gen₁ F.gen₂ d j
        = Z N - ∑ j ∈ Finset.range (d + 1),
            (b j - ∑ n ∈ Finset.range N, (f n (Z n)).2 j) * genMonomial F.gen₁ F.gen₂ d j := by
      rw [h2, htel N]; ring
    rw [h1]
    refine sub_mem (F.ideal_antitone (by omega) (hZmem N)) (Submodule.sum_mem _ fun j hj => ?_)
    have hmem := Ideal.mul_mem_mul (hb j N)
      (F.genIdeal_pow_le d (genMonomial_mem_span_pow F.gen₁ F.gen₂
        (Nat.lt_succ_iff.1 (Finset.mem_range.1 hj))))
    exact F.ideal_antitone (by omega) (F.mul_le N d hmem)
  have hzero := eq_zero_of_forall_mem_of_iInf_eq_bot F.iInf_eq_bot hfin
  rw [sub_eq_zero] at hzero
  rw [hzero]
  exact sum_genMonomial_mem_span_pow F.gen₁ F.gen₂ d b

/-- **Stacks 0C2K, the filtration identification.** The filtering ideals are exactly the
powers of the ideal generated by the two distinguished elements. -/
public theorem ideal_eq_genIdeal_pow (n : ℕ) : F.ideal n = F.genIdeal ^ n :=
  le_antisymm (F.ideal_le_genIdeal_pow n) (F.genIdeal_pow_le n)

/-- The first step of the filtration is the ideal generated by the two distinguished
elements. -/
public theorem ideal_one_eq : F.ideal 1 = F.genIdeal := by
  rw [F.ideal_eq_genIdeal_pow 1, pow_one]

/-- The ideal generated by the two distinguished elements is maximal. -/
public theorem genIdeal_isMaximal : F.genIdeal.IsMaximal := by
  have h := Ideal.Quotient.maximal_of_isField _ F.quotient_isField
  rwa [F.ideal_one_eq] at h

include F in
/-- A ring carrying a monomial filtration is nontrivial, since `(x, y)` is a proper
ideal. -/
public theorem nontrivial : Nontrivial A := by
  refine nontrivial_of_ne 1 0 fun h => F.genIdeal_isMaximal.ne_top ?_
  rw [Ideal.eq_top_iff_one, h]
  exact zero_mem _

/-- The powers of `(x, y)` intersect in zero. -/
public theorem iInf_genIdeal_pow_eq_bot : ⨅ n, F.genIdeal ^ n = ⊥ := by
  rw [← F.iInf_eq_bot]
  exact iInf_congr fun n => (F.ideal_eq_genIdeal_pow n).symm

/-- A geometric series argument: `1 - c` is a unit for every `c` in the ideal generated by
the two distinguished elements. -/
public theorem isUnit_one_sub_of_mem_genIdeal {c : A} (hc : c ∈ F.genIdeal) :
    IsUnit (1 - c) := by
  obtain ⟨s, hs⟩ := F.exists_sum (fun n => c ^ n) fun n =>
    F.genIdeal_pow_le n (Ideal.pow_mem_pow hc n)
  have key : ∀ N, (1 - c) * s - 1 ∈ F.ideal N := by
    intro N
    have h : (1 - c) * s - 1
        = (1 - c) * (s - ∑ e ∈ Finset.range N, c ^ e) - c ^ N := by
      rw [mul_sub, mul_neg_geom_sum]; ring
    rw [h]
    exact sub_mem (Ideal.mul_mem_left _ _ (hs N))
      (F.genIdeal_pow_le N (Ideal.pow_mem_pow hc N))
  have hzero := eq_zero_of_forall_mem_of_iInf_eq_bot F.iInf_eq_bot key
  exact IsUnit.of_mul_eq_one s (by linear_combination hzero)

/-- Everything outside the ideal generated by the two distinguished elements is a unit. -/
public theorem isUnit_of_notMem_genIdeal {a : A} (ha : a ∉ F.genIdeal) : IsUnit a := by
  obtain ⟨b, i, hi, hbi⟩ := F.genIdeal_isMaximal.exists_inv ha
  have h : b * a = 1 - i := by linear_combination hbi
  exact isUnit_of_mul_isUnit_right
    (h ▸ F.isUnit_one_sub_of_mem_genIdeal hi : IsUnit (b * a))

include F in
/-- **Stacks 0C2K, locality.** A ring carrying a monomial filtration is local. -/
public theorem isLocalRing : IsLocalRing A := by
  have := F.nontrivial
  refine IsLocalRing.of_nonunits_add fun a b ha hb => ?_
  have ha' : a ∈ F.genIdeal := by
    by_contra h
    exact ha (F.isUnit_of_notMem_genIdeal h)
  have hb' : b ∈ F.genIdeal := by
    by_contra h
    exact hb (F.isUnit_of_notMem_genIdeal h)
  intro hab
  exact F.genIdeal_isMaximal.ne_top
    (Ideal.eq_top_of_isUnit_mem _ (add_mem ha' hb') hab)

/-- **Stacks 0C2K, adic completeness.** A ring carrying a monomial filtration is
`(x, y)`-adically complete. -/
public theorem isAdicComplete : IsAdicComplete F.genIdeal A := by
  have : IsHausdorff F.genIdeal A := by
    refine ⟨fun a ha => ?_⟩
    exact eq_zero_of_forall_mem_of_iInf_eq_bot F.iInf_genIdeal_pow_eq_bot fun n => by
      simpa using SModEq.sub_mem.1 (ha n)
  have : IsPrecomplete F.genIdeal A := by
    refine ⟨fun g hg => ?_⟩
    have hc : ∀ n, g (n + 1) - g n ∈ F.ideal n := by
      intro n
      have h := SModEq.sub_mem.1 (hg (Nat.le_succ n))
      simp only [smul_eq_mul, Ideal.mul_top] at h
      rw [F.ideal_eq_genIdeal_pow]
      simpa using neg_mem h
    obtain ⟨s, hs⟩ := F.exists_sum (fun n => g (n + 1) - g n) hc
    refine ⟨s + g 0, fun n => ?_⟩
    have htel : ∑ e ∈ Finset.range n, (g (e + 1) - g e) = g n - g 0 :=
      Finset.sum_range_sub g n
    have := hs n
    rw [htel, F.ideal_eq_genIdeal_pow] at this
    refine SModEq.sub_mem.2 ?_
    simp only [smul_eq_mul, Ideal.mul_top]
    have h : g n - (s + g 0) = -(s - (g n - g 0)) := by ring
    rw [h]
    exact neg_mem this
  exact ⟨⟩

include F in
/-- **Stacks 0C2K, Noetherianity.** A ring carrying a monomial filtration is Noetherian:
it is `(x, y)`-adically complete, `(x, y)` is generated by two elements, and the residue
ring is a field. -/
public theorem isNoetherianRing : IsNoetherianRing A := by
  have hmax := F.genIdeal_isMaximal
  let : Field (A ⧸ F.genIdeal) := Ideal.Quotient.field _
  exact noetherian_of_isAdicComplete_fg A F.genIdeal
    (Submodule.fg_span (Set.toFinite _)) F.isAdicComplete inferInstance

/-- The maximal ideal of a ring carrying a monomial filtration is the ideal generated by
the two distinguished elements.  The locality instance is `MonomialFiltration.isLocalRing`. -/
public theorem genIdeal_eq_maximalIdeal [IsLocalRing A] :
    F.genIdeal = IsLocalRing.maximalIdeal A :=
  IsLocalRing.eq_maximalIdeal F.genIdeal_isMaximal

/-- The ideal generated by the second distinguished element lies in `(x, y)`. -/
private theorem span_gen₂_le_genIdeal : Ideal.span ({F.gen₂} : Set A) ≤ F.genIdeal :=
  (Ideal.span_singleton_le_iff_mem _).2 (Ideal.subset_span (by simp))

/-- The ideal generated by the second distinguished element is proper. -/
private theorem span_gen₂_ne_top : Ideal.span ({F.gen₂} : Set A) ≠ ⊤ := fun hc =>
  F.genIdeal_isMaximal.ne_top (top_le_iff.1 (hc ▸ F.span_gen₂_le_genIdeal))

include F in
/-- **The leading-form computation.** If `a ∈ (x, y)ᵐ` and `a·y` agrees with `c·x^{m+1}`
modulo `(x, y)^{m+2}`, then both the leading form of `a` and `c` vanish in the residue
field: `a ∈ (x, y)^{m+1}` and `c ∈ (x, y)`.

Written out, `a·y - c·x^{m+1}` is a combination of the degree-`(m+1)` monomials whose
coefficient at `x^{m+1}` is `-c` and whose remaining coefficients are those of `a`, so
linear independence of the monomials applies. -/
public theorem mem_genIdeal_pow_succ_of_mul_gen₂ {m : ℕ} {a c : A}
    (ha : a ∈ F.genIdeal ^ m)
    (h : a * F.gen₂ - c * F.gen₁ ^ (m + 1) ∈ F.genIdeal ^ (m + 2)) :
    a ∈ F.genIdeal ^ (m + 1) ∧ c ∈ F.genIdeal := by
  obtain ⟨e, he⟩ := exists_repr_of_mem_span_pow F.gen₁ F.gen₂ ha
  set b : ℕ → A := fun j => Nat.rec (motive := fun _ => A) (-c) (fun j _ => e j) j with hbdef
  have hb0 : b 0 = -c := rfl
  have hbsucc : ∀ j, b (j + 1) = e j := fun _ => rfl
  have hsum : ∑ j ∈ Finset.range (m + 1 + 1), b j * genMonomial F.gen₁ F.gen₂ (m + 1) j
      = a * F.gen₂ - c * F.gen₁ ^ (m + 1) := by
    rw [Finset.sum_range_succ' (fun j => b j * genMonomial F.gen₁ F.gen₂ (m + 1) j) (m + 1), hb0]
    have h1 : ∀ j ∈ Finset.range (m + 1),
        b (j + 1) * genMonomial F.gen₁ F.gen₂ (m + 1) (j + 1)
          = e j * genMonomial F.gen₁ F.gen₂ m j * F.gen₂ := by
      intro j _
      rw [hbsucc, ← genMonomial_mul_gen₂]
      ring
    rw [Finset.sum_congr rfl h1, ← Finset.sum_mul, ← he,
      show genMonomial F.gen₁ F.gen₂ (m + 1) 0 = F.gen₁ ^ (m + 1) from by simp [genMonomial]]
    ring
  have hmem : ∑ j ∈ Finset.range (m + 1 + 1), b j * genMonomial F.gen₁ F.gen₂ (m + 1) j
      ∈ F.ideal (m + 1 + 1) := by
    rw [hsum, F.ideal_eq_genIdeal_pow]
    exact h
  have hcoef := F.monomials_indep (m + 1) b hmem
  refine ⟨?_, ?_⟩
  · rw [he, pow_succ']
    refine Submodule.sum_mem _ fun j hj => ?_
    have hj' : j ≤ m := Nat.lt_succ_iff.1 (Finset.mem_range.1 hj)
    have hej : e j ∈ F.genIdeal := by
      rw [← F.ideal_one_eq, ← hbsucc j]
      exact hcoef (j + 1) (by omega)
    exact Ideal.mul_mem_mul hej (genMonomial_mem_span_pow F.gen₁ F.gen₂ hj')
  · have hb := hcoef 0 (by omega)
    rw [F.ideal_one_eq, hb0] at hb
    simpa using neg_mem hb

include F in
/-- **Stacks 0C2K, first half of the regular sequence.** The second distinguished element
is a nonzerodivisor: an annihilator of `y` has vanishing leading form in every degree,
hence lies in `⋂ (x, y)ⁿ = 0`. -/
public theorem gen₂_mem_nonZeroDivisors : F.gen₂ ∈ nonZeroDivisors A := by
  have key : ∀ a : A, a * F.gen₂ = 0 → a = 0 := by
    intro a ha
    have hpow : ∀ m, a ∈ F.genIdeal ^ m := by
      intro m
      induction m with
      | zero => simp
      | succ m ih =>
        refine (F.mem_genIdeal_pow_succ_of_mul_gen₂ (c := 0) ih ?_).1
        simp [ha]
    exact eq_zero_of_forall_mem_of_iInf_eq_bot F.iInf_genIdeal_pow_eq_bot hpow
  exact mem_nonZeroDivisors_iff_right.2 key

include F in
/-- No power of the first distinguished element is divisible by the second: otherwise the
leading-form computation, iterated, forces `1 ∈ (x, y)`. -/
public theorem gen₁_pow_notMem_span_gen₂ (N : ℕ) :
    F.gen₁ ^ N ∉ Ideal.span {F.gen₂} := by
  intro hmem
  have hLle := F.span_gen₂_le_genIdeal
  rcases Nat.eq_zero_or_pos N with hN | hN
  · refine F.genIdeal_isMaximal.ne_top ((Ideal.eq_top_iff_one _).2 (hLle ?_))
    rw [hN, pow_zero] at hmem
    exact hmem
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.1 hmem
  have ha' : a * F.gen₂ = F.gen₁ ^ N := by rw [mul_comm]; exact ha.symm
  have claim : ∀ m, m + 1 ≤ N → a ∈ F.genIdeal ^ m →
      a ∈ F.genIdeal ^ (m + 1) ∧ F.gen₁ ^ (N - (m + 1)) ∈ F.genIdeal := by
    intro m hm hprev
    refine F.mem_genIdeal_pow_succ_of_mul_gen₂ hprev ?_
    have hx : F.gen₁ ^ (N - (m + 1)) * F.gen₁ ^ (m + 1) = F.gen₁ ^ N := by
      rw [← pow_add]
      congr 1
      omega
    rw [hx, ha', sub_self]
    exact zero_mem _
  have hstep : ∀ m, m ≤ N → a ∈ F.genIdeal ^ m := by
    intro m
    induction m with
    | zero => intro _; simp
    | succ m ih => intro hm; exact (claim m hm (ih (by omega))).1
  obtain ⟨-, h1⟩ := claim (N - 1) (by omega) (hstep (N - 1) (by omega))
  rw [show N - (N - 1 + 1) = 0 from by omega, pow_zero] at h1
  exact F.genIdeal_isMaximal.ne_top ((Ideal.eq_top_iff_one _).2 h1)

include F in
/-- **Stacks 0C2K, second half of the regular sequence.** The first distinguished element
is a nonzerodivisor modulo the second. -/
public theorem mem_span_gen₂_of_mul_gen₁_mem {a : A}
    (h : a * F.gen₁ ∈ Ideal.span {F.gen₂}) : a ∈ Ideal.span {F.gen₂} := by
  have hloc := F.isLocalRing
  have hnoeth := F.isNoetherianRing
  set L : Ideal A := Ideal.span {F.gen₂} with hLdef
  have hLle : L ≤ F.genIdeal := F.span_gen₂_le_genIdeal
  have hmono : ∀ n j : ℕ, genMonomial F.gen₁ F.gen₂ n (j + 1) ∈ L := by
    intro n j
    refine Ideal.mem_span_singleton.2 ⟨F.gen₁ ^ (n - (j + 1)) * F.gen₂ ^ j, ?_⟩
    simp only [genMonomial, pow_succ]
    ring
  -- Successive approximation: `a` is congruent to an element of `(x, y)ⁿ` modulo `(y)`.
  have approx : ∀ n, a ∈ L ⊔ F.genIdeal ^ n := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      obtain ⟨v, hv, r, hr, hvr⟩ := Submodule.mem_sup.1 ih
      have hrx : r * F.gen₁ ∈ L := by
        have hr' : r * F.gen₁ = a * F.gen₁ - v * F.gen₁ := by rw [← hvr]; ring
        rw [hr']
        exact sub_mem h (Ideal.mul_mem_right _ _ hv)
      obtain ⟨e, he⟩ := exists_repr_of_mem_span_pow F.gen₁ F.gen₂ hr
      set t : A := ∑ j ∈ Finset.range n, e (j + 1) * genMonomial F.gen₁ F.gen₂ n (j + 1) with htdef
      have hts : t ∈ L :=
        Submodule.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hmono n j)
      have hrt : r = e 0 * F.gen₁ ^ n + t := by
        rw [he, Finset.sum_range_succ' (fun j => e j * genMonomial F.gen₁ F.gen₂ n j) n, htdef,
          show genMonomial F.gen₁ F.gen₂ n 0 = F.gen₁ ^ n from by simp [genMonomial]]
        ring
      have he0x : e 0 * F.gen₁ ^ (n + 1) ∈ L := by
        have hsplit : e 0 * F.gen₁ ^ (n + 1) = r * F.gen₁ - t * F.gen₁ := by
          rw [hrt]; ring
        rw [hsplit]
        exact sub_mem hrx (Ideal.mul_mem_right _ _ hts)
      have he0 : e 0 ∈ F.genIdeal := by
        by_contra hc
        obtain ⟨u, hu⟩ := F.isUnit_of_notMem_genIdeal hc
        refine F.gen₁_pow_notMem_span_gen₂ (n + 1) ?_
        have hx : F.gen₁ ^ (n + 1) = (↑u⁻¹ : A) * (e 0 * F.gen₁ ^ (n + 1)) := by
          rw [← hu]
          rw [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul]
        rw [hx]
        exact Ideal.mul_mem_left _ _ he0x
      refine Submodule.mem_sup.2 ⟨v + t, add_mem hv hts, e 0 * F.gen₁ ^ n, ?_, ?_⟩
      · rw [pow_succ']
        exact Ideal.mul_mem_mul he0 (Ideal.pow_mem_pow (Ideal.subset_span (by simp)) n)
      · rw [← hvr, hrt]; ring
  -- Krull's intersection theorem in `A ⧸ (y)` closes the ideal `(y)`.
  have : Nontrivial (A ⧸ L) := Ideal.Quotient.nontrivial_iff.mpr F.span_gen₂_ne_top
  have : IsLocalRing (A ⧸ L) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk L) Ideal.Quotient.mk_surjective
  have hJtop : F.genIdeal.map (Ideal.Quotient.mk L) ≠ ⊤ := by
    intro hc
    obtain ⟨w, hw, hw1⟩ := (Ideal.mem_map_iff_of_surjective _
      Ideal.Quotient.mk_surjective).1 (hc ▸ Submodule.mem_top : (1 : A ⧸ L) ∈ _)
    have h1w : (1 : A) - w ∈ L := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      simp [hw1]
    refine F.genIdeal_isMaximal.ne_top ((Ideal.eq_top_iff_one _).2 ?_)
    simpa using add_mem (hLle h1w) hw
  have hbot := Ideal.iInf_pow_eq_bot_of_isLocalRing _ hJtop
  have hzero : Ideal.Quotient.mk L a ∈ ⨅ i, F.genIdeal.map (Ideal.Quotient.mk L) ^ i := by
    refine Ideal.mem_iInf.2 fun i => ?_
    rw [← Ideal.map_pow]
    obtain ⟨v, hv, r, hr, hvr⟩ := Submodule.mem_sup.1 (approx i)
    have hmk : Ideal.Quotient.mk L a = Ideal.Quotient.mk L r := by
      rw [← hvr]
      simp [Ideal.Quotient.eq_zero_iff_mem.2 hv]
    rw [hmk]
    exact Ideal.mem_map_of_mem _ hr
  rw [hbot] at hzero
  exact Ideal.Quotient.eq_zero_iff_mem.1 (by simpa using hzero)

include F in
/-- The image of the first distinguished element is a nonzerodivisor in `A / (y)`. -/
public theorem mk_gen₁_mem_nonZeroDivisors :
    Ideal.Quotient.mk (Ideal.span ({F.gen₂} : Set A)) F.gen₁ ∈
      nonZeroDivisors (A ⧸ Ideal.span ({F.gen₂} : Set A)) := by
  have key : ∀ z : A ⧸ Ideal.span ({F.gen₂} : Set A),
      z * Ideal.Quotient.mk (Ideal.span ({F.gen₂} : Set A)) F.gen₁ = 0 → z = 0 := by
    intro z hz
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hz
    exact Ideal.Quotient.eq_zero_iff_mem.2 (F.mem_span_gen₂_of_mul_gen₁_mem hz)
  exact mem_nonZeroDivisors_iff_right.2 key

include F in
/-- The maximal ideal is generated by two elements, so its minimal number of generators is
at most two. -/
public theorem spanFinrank_maximalIdeal_le_two [IsLocalRing A] :
    (IsLocalRing.maximalIdeal A).spanFinrank ≤ 2 := by
  rw [← F.genIdeal_eq_maximalIdeal]
  refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)).trans ?_
  calc ({F.gen₁, F.gen₂} : Set A).ncard ≤ ({F.gen₂} : Set A).ncard + 1 :=
        Set.ncard_insert_le _ _
    _ = 2 := by simp

include F in
/-- **Stacks 0C2K, dimension at least two.** The two distinguished elements form a regular
sequence cutting out the residue field, so `dim A ≥ 0 + 1 + 1 = 2`. -/
public theorem two_le_ringKrullDim : 2 ≤ ringKrullDim A := by
  have hloc := F.isLocalRing
  have hnoeth := F.isNoetherianRing
  have hnt : Nontrivial (A ⧸ Ideal.span ({F.gen₂} : Set A)) :=
    Ideal.Quotient.nontrivial_iff.mpr F.span_gen₂_ne_top
  have hmapeq : (Ideal.span ({F.gen₁} : Set A)).map
      (Ideal.Quotient.mk (Ideal.span ({F.gen₂} : Set A)))
      = Ideal.span {Ideal.Quotient.mk (Ideal.span ({F.gen₂} : Set A)) F.gen₁} := by
    rw [Ideal.map_span, Set.image_singleton]
  have hsup : Ideal.span ({F.gen₂} : Set A) ⊔ Ideal.span ({F.gen₁} : Set A) = F.genIdeal := by
    rw [show F.genIdeal = Ideal.span (insert F.gen₁ ({F.gen₂} : Set A)) from rfl,
      Ideal.span_insert]
    exact sup_comm _ _
  have hdim0 : ringKrullDim ((A ⧸ Ideal.span ({F.gen₂} : Set A)) ⧸
      Ideal.span {Ideal.Quotient.mk (Ideal.span ({F.gen₂} : Set A)) F.gen₁}) = 0 := by
    have e1 := Ideal.quotEquivOfEq hmapeq.symm
    have e2 := DoubleQuot.quotQuotEquivQuotSup
      (Ideal.span ({F.gen₂} : Set A)) (Ideal.span ({F.gen₁} : Set A))
    have e3 := Ideal.quotEquivOfEq hsup
    rw [ringKrullDim_eq_of_ringEquiv (e1.trans (e2.trans e3))]
    have hmax := F.genIdeal_isMaximal
    let : Field (A ⧸ F.genIdeal) := Ideal.Quotient.field _
    exact ringKrullDim_eq_zero_of_field _
  have h2 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor F.mk_gen₁_mem_nonZeroDivisors
  rw [hdim0, zero_add] at h2
  calc (2 : WithBot ℕ∞) = 1 + 1 := by norm_num
    _ ≤ ringKrullDim (A ⧸ Ideal.span ({F.gen₂} : Set A)) + 1 := by gcongr
    _ ≤ ringKrullDim A :=
        ringKrullDim_quotient_succ_le_of_nonZeroDivisor F.gen₂_mem_nonZeroDivisors

include F in
/-- **Stacks 0C2K, dimension two.** A ring carrying a monomial filtration has Krull
dimension two. -/
public theorem ringKrullDim_eq_two : ringKrullDim A = 2 := by
  have hloc := F.isLocalRing
  have hnoeth := F.isNoetherianRing
  refine le_antisymm ((ringKrullDim_le_spanFinrank_maximalIdeal A).trans ?_)
    F.two_le_ringKrullDim
  exact_mod_cast F.spanFinrank_maximalIdeal_le_two

include F in
/-- **Stacks 0C2K, Noetherian complete local.** A ring carrying a monomial filtration is a
Noetherian complete local ring. -/
public theorem isNoetherianCompleteLocalRing : IsNoetherianCompleteLocalRing A := by
  have hloc := F.isLocalRing
  refine ⟨F.isNoetherianRing, hloc, ?_⟩
  rw [← F.genIdeal_eq_maximalIdeal]
  exact F.isAdicComplete

include F in
/-- **Stacks 0C2K, the projection kernels.** The `n`-th step of the filtration is the
`n`-th power of the maximal ideal.  The locality instance is
`MonomialFiltration.isLocalRing`. -/
public theorem ideal_eq_maximalIdeal_pow [IsLocalRing A] (n : ℕ) :
    F.ideal n = IsLocalRing.maximalIdeal A ^ n := by
  rw [F.ideal_eq_genIdeal_pow, F.genIdeal_eq_maximalIdeal]

include F in
/-- **Stacks 0C2K, regularity.** A ring carrying a monomial filtration is a regular local
ring: its maximal ideal is generated by two elements and its dimension is two. -/
public theorem isRegularLocalRing : IsRegularLocalRing A := by
  have hloc := F.isLocalRing
  have hnoeth := F.isNoetherianRing
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le A ?_
  rw [F.ringKrullDim_eq_two]
  exact_mod_cast F.spanFinrank_maximalIdeal_le_two

end MonomialFiltration

