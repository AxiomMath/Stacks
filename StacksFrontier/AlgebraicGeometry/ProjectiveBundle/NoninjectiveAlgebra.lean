module

public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Tactic.LinearCombination
public import StacksFrontier.RingTheory.MvPolynomial.HomogeneousCoeff

/-!
# A module with a nonzero element dying in the first twist of its projective bundle

Over a base ring `R` set
`A = R[u, v, s₁, s₂, t₁, t₂] / (-u s₁ + v t₁ + u t₂, v s₁ + u s₂ - v t₂, v s₂, u t₁)`
and let `M = (A x ⊕ A y) / A (ū x + v̄ y)`. The distinguished element is the class
`m = ū s̄₁ x + v̄ t̄₂ y`. It is nonzero, yet `x m` and `y m` are multiples of the relation
`ū x + v̄ y` in `A[x, y]`, so `m` vanishes on both charts of the projective bundle of `M`.

## Main definitions

* `relationIdeal`: the ideal of the four relations.
* `coefficientRing`: the ring `A`.
* `relationSubmodule`, `presentedModule`: the relation `ū x + v̄ y` and the module `M`.
* `counterexampleSection`: the element `m`.
* `relationForm`, `counterexampleForm`: the linear forms `ū x + v̄ y` and `ū s̄₁ x + v̄ t̄₂ y` in
  `A[x, y]`, whose classes are the relation of `M` and the element `m`.

## Main results

* `counterexampleSection_ne_zero`: `m ≠ 0`, for any nontrivial `R`.
* `X_zero_mul_counterexampleForm` and `X_one_mul_counterexampleForm`: the identities
  `x (ū s̄₁ x + v̄ t̄₂ y) = (s̄₁ x + s̄₂ y)(ū x + v̄ y)` and
  `y (ū s̄₁ x + v̄ t̄₂ y) = (t̄₁ x + t̄₂ y)(ū x + v̄ y)` in `A[x, y]`.
* `coefficient_relation_one` through `coefficient_relation_four`: the four defining relations of
  `A`, as identities in `A`.

## Implementation notes

The six variables are indexed by `Fin 6` in the order `u, v, s₁, s₂, t₁, t₂`, and the two module
generators `x, y` by `Fin 2`.

## References

* [Stacks Project, Tag 01OC](https://stacks.math.columbia.edu/tag/01OC)
-/

@[expose] public noncomputable section

namespace Stacks.ProjectiveBundle.Noninjective

open MvPolynomial

variable (R : Type*) [CommRing R]

/-- The polynomial ring `R[u, v, s₁, s₂, t₁, t₂]`, with the six variables indexed by `Fin 6` in
the order `u, v, s₁, s₂, t₁, t₂`. -/
public abbrev polyRing := MvPolynomial (Fin 6) R

/-- The four relations `-u s₁ + v t₁ + u t₂`, `v s₁ + u s₂ - v t₂`, `v s₂` and `u t₁`. All four
are homogeneous of degree two. -/
public def relationSet : Set (polyRing R) :=
  {-(X 0 * X 2) + X 1 * X 4 + X 0 * X 5,
    X 1 * X 2 + X 0 * X 3 - X 1 * X 5,
    X 1 * X 3,
    X 0 * X 4}

/-- The ideal `I` generated by `relationSet`. -/
public def relationIdeal : Ideal (polyRing R) := Ideal.span (relationSet R)

/-- The ring `A = R[u, v, s₁, s₂, t₁, t₂] / I`. -/
public abbrev coefficientRing := polyRing R ⧸ relationIdeal R

/-- The class in `A` of the `i`-th variable: `coefficient R 0` is `ū`, `coefficient R 1` is `v̄`,
and so on. -/
public abbrev coefficient (i : Fin 6) : coefficientRing R :=
  Ideal.Quotient.mk (relationIdeal R) (X i)

section Relations

/-- A multidegree `xᵢ xⱼ` of total degree two. -/
private def degTwo (i j : Fin 6) : Fin 6 →₀ ℕ := Finsupp.single i 1 + Finsupp.single j 1

private lemma degree_degTwo (i j : Fin 6) : (degTwo i j).degree = 2 := by
  simp [degTwo]

/-- Two degree-two multidegrees agree exactly when they do so variable by variable. -/
private lemma degTwo_eq_iff (i j a b : Fin 6) :
    degTwo i j = degTwo a b ↔
      ∀ x : Fin 6, (if i = x then 1 else 0) + (if j = x then 1 else 0)
        = (if a = x then 1 else 0) + (if b = x then 1 else 0) := by
  simp [degTwo, Finsupp.ext_iff, Finsupp.single_apply]

private lemma X_mul_X_eq_monomial (a b : Fin 6) :
    (X a * X b : polyRing R) = monomial (degTwo a b) 1 := by
  rw [show (X a : polyRing R) = monomial (Finsupp.single a 1) 1 by
        rw [← X_pow_eq_monomial, pow_one],
    show (X b : polyRing R) = monomial (Finsupp.single b 1) 1 by
        rw [← X_pow_eq_monomial, pow_one],
    monomial_mul_monomial, mul_one, degTwo]

private lemma coeff_degTwo_X_mul_X (i j a b : Fin 6) :
    (X a * X b : polyRing R).coeff (degTwo i j) = if degTwo a b = degTwo i j then 1 else 0 := by
  rw [X_mul_X_eq_monomial, coeff_monomial]

/-- A degree-two coefficient of `p * xᵢ` is the coefficient of `p` at the complementary
variable. -/
private lemma coeff_degTwo_mul_X (p : polyRing R) (i j : Fin 6) :
    (p * X i).coeff (degTwo i j) = p.coeff (Finsupp.single j 1) := by
  rw [degTwo, add_comm, coeff_mul_X]

/-- A degree-two coefficient of `p * xₐ` vanishes when `xₐ` does not occur in the
multidegree. -/
private lemma coeff_degTwo_mul_X_eq_zero (p : polyRing R) {i j a : Fin 6}
    (hi : a ≠ i) (hj : a ≠ j) : (p * X a).coeff (degTwo i j) = 0 := by
  rw [coeff_mul_X']
  simp [degTwo, Finsupp.mem_support_iff, Ne.symm hi, Ne.symm hj]

/-- The functional `⟨u s₁⟩ + ⟨v t₁⟩` on the polynomial ring. -/
private def coeffA (p : polyRing R) : R := p.coeff (degTwo 0 2) + p.coeff (degTwo 1 4)

/-- The functional `⟨v s₁⟩ - ⟨u s₂⟩` on the polynomial ring. -/
private def coeffB (p : polyRing R) : R := p.coeff (degTwo 1 2) - p.coeff (degTwo 0 3)

private lemma coeffA_add (p q : polyRing R) : coeffA R (p + q) = coeffA R p + coeffA R q := by
  simp only [coeffA, coeff_add]; ring

private lemma coeffB_add (p q : polyRing R) : coeffB R (p + q) = coeffB R p + coeffB R q := by
  simp only [coeffB, coeff_add]; ring

private lemma isHomogeneous_X_mul_X (i j : Fin 6) :
    (X i * X j : polyRing R).IsHomogeneous 2 := by
  simpa using (isHomogeneous_X R i).mul (isHomogeneous_X R j)

private lemma isHomogeneous_of_mem_relationSet {x : polyRing R} (hx : x ∈ relationSet R) :
    x.IsHomogeneous 2 := by
  simp only [relationSet, Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl | rfl
  · exact (((isHomogeneous_X_mul_X R 0 2).neg).add
      (isHomogeneous_X_mul_X R 1 4)).add (isHomogeneous_X_mul_X R 0 5)
  · exact ((isHomogeneous_X_mul_X R 1 2).add (isHomogeneous_X_mul_X R 0 3)).sub
      (isHomogeneous_X_mul_X R 1 5)
  · exact isHomogeneous_X_mul_X R 1 3
  · exact isHomogeneous_X_mul_X R 0 4

private lemma coeffA_mul {x : polyRing R} (hx : x.IsHomogeneous 2) (a : polyRing R) :
    coeffA R (a * x) = a.coeff 0 * coeffA R x := by
  simp only [coeffA, hx.coeff_mul_of_degree_eq a (degree_degTwo 0 2),
    hx.coeff_mul_of_degree_eq a (degree_degTwo 1 4), mul_add]

private lemma coeffB_mul {x : polyRing R} (hx : x.IsHomogeneous 2) (a : polyRing R) :
    coeffB R (a * x) = a.coeff 0 * coeffB R x := by
  simp only [coeffB, hx.coeff_mul_of_degree_eq a (degree_degTwo 1 2),
    hx.coeff_mul_of_degree_eq a (degree_degTwo 0 3), mul_sub]

private lemma coeffA_eq_zero_of_mem_relationSet {x : polyRing R} (hx : x ∈ relationSet R) :
    coeffA R x = 0 := by
  simp only [relationSet, Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl | rfl <;>
    simp +decide [coeffA, coeff_degTwo_X_mul_X, degTwo_eq_iff]

private lemma coeffB_eq_zero_of_mem_relationSet {x : polyRing R} (hx : x ∈ relationSet R) :
    coeffB R x = 0 := by
  simp only [relationSet, Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl | rfl <;>
    simp +decide [coeffB, coeff_degTwo_X_mul_X, degTwo_eq_iff]

/-- An additive function that kills all multiples of the generators kills the relation ideal. -/
private lemma eq_zero_of_mem_relationIdeal {f : polyRing R → R} (h0 : f 0 = 0)
    (hadd : ∀ p q, f (p + q) = f p + f q) (hgen : ∀ x ∈ relationSet R, ∀ a, f (a * x) = 0)
    {p : polyRing R} (hp : p ∈ relationIdeal R) : f p = 0 := by
  have key : ∀ a : polyRing R, f (a * p) = 0 := by
    refine Submodule.span_induction
      (p := fun x _ => ∀ a : polyRing R, f (a * x) = 0) ?_ ?_ ?_ ?_ hp
    · exact hgen
    · simpa using h0
    · intro x y _ _ ihx ihy a
      rw [mul_add, hadd, ihx a, ihy a, add_zero]
    · intro c x _ ih a
      rw [smul_eq_mul, ← mul_assoc]
      exact ih (a * c)
  simpa using key 1

private lemma coeffA_eq_zero_of_mem {p : polyRing R} (hp : p ∈ relationIdeal R) :
    coeffA R p = 0 :=
  eq_zero_of_mem_relationIdeal R (by simp [coeffA]) (coeffA_add R) (fun x hx a => by
    rw [coeffA_mul R (isHomogeneous_of_mem_relationSet R hx) a,
      coeffA_eq_zero_of_mem_relationSet R hx, mul_zero]) hp

private lemma coeffB_eq_zero_of_mem {p : polyRing R} (hp : p ∈ relationIdeal R) :
    coeffB R p = 0 :=
  eq_zero_of_mem_relationIdeal R (by simp [coeffB]) (coeffB_add R) (fun x hx a => by
    rw [coeffB_mul R (isHomogeneous_of_mem_relationSet R hx) a,
      coeffB_eq_zero_of_mem_relationSet R hx, mul_zero]) hp

/-- The class of a generator of the relation ideal vanishes in `A`. -/
private lemma mk_eq_zero_of_mem_relationSet {x : polyRing R} (hx : x ∈ relationSet R) :
    Ideal.Quotient.mk (relationIdeal R) x = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span hx)

/-- Cancelling `ū`-type relations in `A` lifts to membership in the relation ideal. -/
private lemma X_mul_X_sub_mul_X_mem {f : polyRing R} {i j : Fin 6}
    (h : Ideal.Quotient.mk (relationIdeal R) f * coefficient R i =
      coefficient R i * coefficient R j) :
    X i * X j - f * X i ∈ relationIdeal R := by
  refine Ideal.Quotient.eq_zero_iff_mem.mp ?_
  rw [map_sub, map_mul, map_mul]
  exact sub_eq_zero.mpr h.symm

end Relations

section CoefficientRelations

/-- The first relation holds in `A`: `-ū s̄₁ + v̄ t̄₁ + ū t̄₂ = 0`. -/
public theorem coefficient_relation_one :
    -(coefficient R 0 * coefficient R 2) + coefficient R 1 * coefficient R 4 +
      coefficient R 0 * coefficient R 5 = 0 := by
  have h : (-(X 0 * X 2) + X 1 * X 4 + X 0 * X 5 : polyRing R) ∈ relationSet R := by
    simp [relationSet]
  simpa using mk_eq_zero_of_mem_relationSet R h

/-- The second relation holds in `A`: `v̄ s̄₁ + ū s̄₂ - v̄ t̄₂ = 0`. -/
public theorem coefficient_relation_two :
    coefficient R 1 * coefficient R 2 + coefficient R 0 * coefficient R 3 -
      coefficient R 1 * coefficient R 5 = 0 := by
  have h : (X 1 * X 2 + X 0 * X 3 - X 1 * X 5 : polyRing R) ∈ relationSet R := by
    simp [relationSet]
  simpa using mk_eq_zero_of_mem_relationSet R h

/-- The third relation holds in `A`: `v̄ s̄₂ = 0`. -/
public theorem coefficient_relation_three : coefficient R 1 * coefficient R 3 = 0 := by
  have h : (X 1 * X 3 : polyRing R) ∈ relationSet R := by simp [relationSet]
  simpa using mk_eq_zero_of_mem_relationSet R h

/-- The fourth relation holds in `A`: `ū t̄₁ = 0`. -/
public theorem coefficient_relation_four : coefficient R 0 * coefficient R 4 = 0 := by
  have h : (X 0 * X 4 : polyRing R) ∈ relationSet R := by simp [relationSet]
  simpa using mk_eq_zero_of_mem_relationSet R h

end CoefficientRelations

/-- The relation vector `(ū, v̄)`, spanning the submodule by which `A x ⊕ A y` is divided. -/
public def relationVector : Fin 2 → coefficientRing R := ![coefficient R 0, coefficient R 1]

/-- The submodule `A (ū x + v̄ y)` of `A x ⊕ A y`. -/
public def relationSubmodule : Submodule (coefficientRing R) (Fin 2 → coefficientRing R) :=
  Submodule.span (coefficientRing R) {relationVector R}

/-- The module `M = (A x ⊕ A y) / A (ū x + v̄ y)`. -/
public abbrev presentedModule := (Fin 2 → coefficientRing R) ⧸ relationSubmodule R

/-- The element `m = ū s̄₁ x + v̄ t̄₂ y` of `M`. -/
public def counterexampleSection : presentedModule R :=
  (relationSubmodule R).mkQ ![coefficient R 0 * coefficient R 2, coefficient R 1 * coefficient R 5]

section Nonvanishing

variable [Nontrivial R]

/-- For a nontrivial ring `R`, the element `m = ū s̄₁ x + v̄ t̄₂ y` of `M` is nonzero. -/
@[stacks 01OC "the section is nonzero"]
public theorem counterexampleSection_ne_zero : counterexampleSection R ≠ 0 := by
  intro h
  rw [counterexampleSection, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    relationSubmodule, Submodule.mem_span_singleton] at h
  obtain ⟨c, hc⟩ := h
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective c
  have hp0 := X_mul_X_sub_mul_X_mem R (f := f) (i := 0) (j := 2)
    (by simpa [relationVector, smul_eq_mul] using congrFun hc (0 : Fin 2))
  have hp1 := X_mul_X_sub_mul_X_mem R (f := f) (i := 1) (j := 5)
    (by simpa [relationVector, smul_eq_mul] using congrFun hc (1 : Fin 2))
  have eA : coeffA R (X 0 * X 2 - f * X 0) = 1 - f.coeff (Finsupp.single (2 : Fin 6) 1) := by
    rw [coeffA, coeff_sub, coeff_sub, coeff_degTwo_X_mul_X R 0 2 0 2,
      coeff_degTwo_X_mul_X R 1 4 0 2, coeff_degTwo_mul_X R f 0 2,
      coeff_degTwo_mul_X_eq_zero R f (i := 1) (j := 4) (a := 0) (by decide) (by decide)]
    simp +decide [degTwo_eq_iff]
  have eB : coeffB R (X 1 * X 5 - f * X 1) = -f.coeff (Finsupp.single (2 : Fin 6) 1) := by
    rw [coeffB, coeff_sub, coeff_sub, coeff_degTwo_X_mul_X R 1 2 1 5,
      coeff_degTwo_X_mul_X R 0 3 1 5, coeff_degTwo_mul_X R f 1 2,
      coeff_degTwo_mul_X_eq_zero R f (i := 0) (j := 3) (a := 1) (by decide) (by decide)]
    simp +decide [degTwo_eq_iff]
  exact one_ne_zero (α := R) (by
    linear_combination eA.symm.trans (coeffA_eq_zero_of_mem R hp0) -
      eB.symm.trans (coeffB_eq_zero_of_mem R hp1))

end Nonvanishing

section PolynomialCongruences

/-- The polynomial ring `A[x, y]`, with `x, y` indexed by `Fin 2`. -/
public abbrev twoVarRing := MvPolynomial (Fin 2) (coefficientRing R)

/-- The linear form `ū x + v̄ y`, whose class generates the relation of `M`. -/
public def relationForm : twoVarRing R :=
  C (coefficient R 0) * X 0 + C (coefficient R 1) * X 1

/-- The linear form `ū s̄₁ x + v̄ t̄₂ y`, whose class in `M` is the element `m`. -/
public def counterexampleForm : twoVarRing R :=
  C (coefficient R 0 * coefficient R 2) * X 0 + C (coefficient R 1 * coefficient R 5) * X 1

private lemma C_relation_one :
    -(C (coefficient R 0) * C (coefficient R 2)) + C (coefficient R 1) * C (coefficient R 4) +
      C (coefficient R 0) * C (coefficient R 5) = (0 : twoVarRing R) := by
  simpa using congrArg (C : coefficientRing R → twoVarRing R) (coefficient_relation_one R)

private lemma C_relation_two :
    C (coefficient R 1) * C (coefficient R 2) + C (coefficient R 0) * C (coefficient R 3) -
      C (coefficient R 1) * C (coefficient R 5) = (0 : twoVarRing R) := by
  simpa using congrArg (C : coefficientRing R → twoVarRing R) (coefficient_relation_two R)

private lemma C_relation_three :
    C (coefficient R 1) * C (coefficient R 3) = (0 : twoVarRing R) := by
  simpa using congrArg (C : coefficientRing R → twoVarRing R) (coefficient_relation_three R)

private lemma C_relation_four :
    C (coefficient R 0) * C (coefficient R 4) = (0 : twoVarRing R) := by
  simpa using congrArg (C : coefficientRing R → twoVarRing R) (coefficient_relation_four R)

/-- In `A[x, y]`, `x (ū s̄₁ x + v̄ t̄₂ y) = (s̄₁ x + s̄₂ y)(ū x + v̄ y)`. -/
@[stacks 01OC "the first displayed congruence"]
public theorem X_zero_mul_counterexampleForm :
    X 0 * counterexampleForm R =
      (C (coefficient R 2) * X 0 + C (coefficient R 3) * X 1) * relationForm R := by
  simp only [counterexampleForm, relationForm, map_mul]
  linear_combination (-(X 0 * X 1 : twoVarRing R)) * C_relation_two R -
    (X 1 ^ 2 : twoVarRing R) * C_relation_three R

/-- In `A[x, y]`, `y (ū s̄₁ x + v̄ t̄₂ y) = (t̄₁ x + t̄₂ y)(ū x + v̄ y)`. -/
@[stacks 01OC "the second displayed congruence"]
public theorem X_one_mul_counterexampleForm :
    X 1 * counterexampleForm R =
      (C (coefficient R 4) * X 0 + C (coefficient R 5) * X 1) * relationForm R := by
  simp only [counterexampleForm, relationForm, map_mul]
  linear_combination (-(X 0 * X 1 : twoVarRing R)) * C_relation_one R -
    (X 0 ^ 2 : twoVarRing R) * C_relation_four R

end PolynomialCongruences

end Stacks.ProjectiveBundle.Noninjective

end
