module

public import StacksFrontier.AlgebraicGeometry.ProjectiveBundle.Completion.Chart
public import StacksFrontier.AlgebraicGeometry.Chow.AffineBundle.VectorBundleAffineSpaceBundle
public import StacksFrontier.AlgebraicGeometry.Chow.AffineBundle.BaseChange
public import StacksFrontier.AlgebraicGeometry.ProjBundleSurjection.Basic
public import StacksFrontier.AlgebraicGeometry.RelativeProjTwistGlue.Basic

/-!
# The vector bundle is the complement of the divisor at infinity

Let `ℰ` be a finite locally free module on a scheme `X`, `p : E = Spec_X(Sym(ℰ)) ⟶ X` its vector
bundle and `π : P = 𝐏(ℰ ⊕ 𝒪_X) ⟶ X` its projective completion, with the divisor at infinity
`i : 𝐏(ℰ) ⟶ P`. This file proves the geometric half of the proof of [Stacks, Tag 02TY]:

  `E ≅ P ∖ i(𝐏(ℰ))`

compatibly with the projections to `X`. The open immersion `j : E ⟶ P` is glued from the charts
`Spec Γ(U, Sym(ℰ)) ⟶ P` over the affine opens `U` of `X`
(`Stacks.ProjectiveCompletion.chartToCompletion`), which are compatible with restriction
(`Stacks.ProjectiveCompletion.specMap_comp_chartToCompletion`); over `U` it is the standard open
`D₊(T)` of `Proj Γ(U, Sym(ℰ ⊕ 𝒪_X))`, and the divisor at infinity is there the closed subscheme
`V₊(T) = Proj Γ(U, Sym(ℰ))`, its complement.

## Main definitions

* `Stacks.ProjectiveCompletion.toCompletion`: the open immersion `j : E ⟶ P`.
* `Stacks.ProjectiveCompletion.complementOpen`: the open `P ∖ i(𝐏(ℰ))`, the image of `j`.
* `Stacks.ProjectiveCompletion.complementIso`: the isomorphism `E ≅ P ∖ i(𝐏(ℰ))`.

## Main results

* `Stacks.ProjectiveCompletion.toCompletion_comp_projectiveCompletionProj`: `j` lies over `X`.
* `Stacks.ProjectiveCompletion.isOpenImmersion_toCompletion`: `j` is an open immersion.
* `Stacks.ProjectiveCompletion.range_infinityEmbedding`: the image of the divisor at infinity is
  the complement of the image of `j`.
* `Stacks.ProjectiveCompletion.isAffineSpaceBundle_complementOpen`: `P ∖ i(𝐏(ℰ)) ⟶ X` is an
  affine-space bundle of rank `r` when `ℰ` has rank `r`.

## Implementation notes

The vector bundle is the relative spectrum of `Sym(ℰ)`, and the relative spectrum is the colimit
of the schemes `Spec Γ(U, Sym(ℰ))` over the affine opens of `X`; so `j` is a morphism out of a
colimit, and nothing is glued by hand. That `j` is an open immersion with the stated image is
checked over the charts `Proj Γ(U, Sym(ℰ ⊕ 𝒪_X)) ⟶ P`, which cover `P`.

## References

* [Stacks Project, Tag 02TY](https://stacks.math.columbia.edu/tag/02TY)
* [Stacks Project, Tag 01M2](https://stacks.math.columbia.edu/tag/01M2)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.SymGraded Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.AlgebraicGeometry.RelativeProj Stacks.AffineAlgebraEquivalence

universe u

namespace Stacks.ProjectiveCompletion

variable {X : Scheme.{u}} (E : X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]

/-! ### The image of `Proj` of a graded quotient by one degree-one element -/

section ProjMapRange

variable {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  [CommRing B] [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ}
  [GradedRing 𝒜] [GradedRing ℬ] (q : 𝒜 →+*ᵍ ℬ)
  (hq : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map q)

/-- A homogeneous element of positive degree killed by `q` lies in every point of the image of
`Proj q`. -/
theorem mem_of_mem_range_map {t : A} {d : ℕ} (_ht : t ∈ 𝒜 d) (_hd : 0 < d) (hqt : q t = 0)
    {y : AlgebraicGeometry.Proj 𝒜} (hy : y ∈ Set.range (Proj.map q hq).base) :
    t ∈ y.asHomogeneousIdeal := by
  obtain ⟨z, rfl⟩ := hy
  by_contra hty
  have hmem : z ∈ Proj.map q hq ⁻¹ᵁ Proj.basicOpen 𝒜 t := hty
  rw [Proj.map_preimage_basicOpen, hqt, Proj.basicOpen_zero] at hmem
  exact hmem

/-- A graded ring homomorphism carries the irrelevant ideal into the irrelevant ideal. -/
theorem irrelevant_le_comap_irrelevant :
    (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
      ((HomogeneousIdeal.irrelevant ℬ).toIdeal).comap (q : A →+* B) := by
  refine (HomogeneousIdeal.toIdeal_irrelevant_le _).2 fun i hi x hx => ?_
  exact HomogeneousIdeal.mem_irrelevant_of_mem _ hi (GradedRingHom.map_mem q hx)

/-- **The image of `Proj` of a graded quotient.** If `q` is surjective with kernel contained in the
ideal generated by `t`, every point of `Proj 𝒜` containing `t` is in the image of `Proj q`. -/
theorem mem_range_map_of_mem (hsurj : Function.Surjective q) {t : A}
    (hker : RingHom.ker (q : A →+* B) ≤ Ideal.span {t}) (y : ProjectiveSpectrum 𝒜)
    (hty : t ∈ y.asHomogeneousIdeal) :
    (y : AlgebraicGeometry.Proj 𝒜) ∈ Set.range (Proj.map q hq).base := by
  have hkery : RingHom.ker (q : A →+* B) ≤ y.asHomogeneousIdeal.toIdeal :=
    hker.trans ((Ideal.span_singleton_le_iff_mem _).2 hty)
  have hcomap : (y.asHomogeneousIdeal.toIdeal.map (q : A →+* B)).comap (q : A →+* B) =
      y.asHomogeneousIdeal.toIdeal := by
    refine (Ideal.comap_map_of_surjective (q : A →+* B) hsurj _).trans ?_
    rw [← RingHom.ker_eq_comap_bot]
    exact sup_eq_left.2 hkery
  have : y.asHomogeneousIdeal.toIdeal.IsPrime := y.isPrime
  have hprime : (y.asHomogeneousIdeal.toIdeal.map (q : A →+* B)).IsPrime :=
    Ideal.map_isPrime_of_surjective hsurj hkery
  let z : ProjectiveSpectrum ℬ :=
    { asHomogeneousIdeal := y.asHomogeneousIdeal.map q
      isPrime := hprime
      not_irrelevant_le := fun hle => y.not_irrelevant_le (by
        intro a ha
        have h1 : a ∈ ((HomogeneousIdeal.irrelevant ℬ).toIdeal).comap (q : A →+* B) :=
          irrelevant_le_comap_irrelevant q ha
        have h2 : a ∈ (y.asHomogeneousIdeal.toIdeal.map (q : A →+* B)).comap (q : A →+* B) :=
          Ideal.comap_mono hle h1
        rw [hcomap] at h2
        exact h2) }
  exact ⟨z, ProjectiveSpectrum.ext (HomogeneousIdeal.ext hcomap)⟩

end ProjMapRange

/-! ### The open immersion of the vector bundle -/

/-- **The open immersion `j : Spec_X(Sym(ℰ)) ⟶ 𝐏(ℰ ⊕ 𝒪_X)`** of the vector bundle into its
projective completion, glued from the charts `Stacks.ProjectiveCompletion.chartToCompletion`. -/
def toCompletion : Scheme.Modules.vectorBundle X E ⟶ projectiveCompletion E :=
  colimit.desc (relativeSpecGluingData (Scheme.Modules.symmetricAlgebraSheaf X E)).functor
    { pt := projectiveCompletion E
      ι :=
        { app := fun U => chartToCompletion (E := E) (U := (U : X.affineOpens).1) U.2
          naturality := fun U V h => by
            refine (specMap_comp_chartToCompletion (E := E) U.2 V.2 (leOfHom h)).trans ?_
            exact (Category.comp_id _).symm } }

/-- The restriction of `j` to the part of the vector bundle over an affine open `U` is the chart
`Stacks.ProjectiveCompletion.chartToCompletion` over `U`. -/
@[reassoc]
theorem ι_toCompletion (U : X.affineOpens) :
    colimit.ι (relativeSpecGluingData (Scheme.Modules.symmetricAlgebraSheaf X E)).functor U ≫
        toCompletion E = chartToCompletion (E := E) U.2 :=
  colimit.ι_desc _ _

/-- The chart `Spec Γ(U, Sym(ℰ)) ⟶ P` lies over the affine open `U`. -/
theorem chartToCompletion_comp_projectiveCompletionProj (U : X.affineOpens) :
    chartToCompletion (E := E) U.2 ≫ projectiveCompletionProj E =
      Spec.map ((Scheme.Modules.symmetricAlgebraSheaf X E).hom.hom.app (op U.1)) ≫
        U.2.isoSpec.inv ≫ U.1.ι := by
  have hchart := ((relativeProj (completionAlgebra E)).chart_isPullback U.1 U.2).w
  have hring : CommRingCat.ofHom ((GradedRing.projZeroRingHom'
        ((completionAlgebra E).grading U.1)).comp ((completionAlgebra E).strHom U.1)) ≫
      CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
        ((completionAlgebra E).grading U.1) (Submonoid.powers (infinitySection E U.1))) ≫
      CommRingCat.ofHom
        (R := HomogeneousLocalization.Away ((completionAlgebra E).grading U.1)
          (infinitySection E U.1))
        (S := ((Scheme.Modules.symmetricAlgebraSheaf X E).right.obj.obj (op U.1) : CommRingCat))
        (chartRingEquiv U.2).symm.toRingHom =
      (Scheme.Modules.symmetricAlgebraSheaf X E).hom.hom.app (op U.1) := by
    ext r
    change (chartRingEquiv U.2).symm (HomogeneousLocalization.fromZeroRingHom _ _ _) = _
    have hz := Stacks.SymmetricAway.away_mk_zero ((completionAlgebra E).grading U.1)
      (infinitySection_mem E U.1) ((completionAlgebra E).strHom U.1 r)
      (by simpa using (completionAlgebra E).strHom_mem U.1 r)
    have hc : (GradedRing.projZeroRingHom' ((completionAlgebra E).grading U.1))
        ((completionAlgebra E).strHom U.1 r) =
        (⟨(completionAlgebra E).strHom U.1 r,
          by simpa using (completionAlgebra E).strHom_mem U.1 r⟩ :
            (completionAlgebra E).grading U.1 0) :=
      Subtype.ext (Stacks.AlgebraicGeometry.RelativeProj.projZeroRingHom'_coe_of_mem _
        ((completionAlgebra E).strHom_mem U.1 r))
    exact (congrArg (chartRingEquiv U.2).symm
      ((congrArg (HomogeneousLocalization.fromZeroRingHom _ _) hc).trans hz.symm)).trans
        ((chartRingEquiv_symm_mk U.2 0 _ _).trans (sectionsDehomogenize_strHom U.2 r))
  have hι : U.1.ι = (𝟙 _) ≫ U.1.ι := (Category.id_comp _).symm
  calc chartToCompletion (E := E) U.2 ≫ projectiveCompletionProj E
      = Spec.map (CommRingCat.ofHom
            (R := HomogeneousLocalization.Away ((completionAlgebra E).grading U.1)
              (infinitySection E U.1))
            (S := ((Scheme.Modules.symmetricAlgebraSheaf X E).right.obj.obj (op U.1) :
              CommRingCat)) (chartRingEquiv U.2).symm.toRingHom) ≫
          Proj.awayι ((completionAlgebra E).grading U.1) (infinitySection E U.1)
            (infinitySection_mem E U.1) one_pos ≫
          ((relativeProj (completionAlgebra E)).chart U.1 U.2 ≫
            (relativeProj (completionAlgebra E)).toBase) := by
        unfold chartToCompletion
        simp only [Category.assoc]
        rfl
    _ = Spec.map (CommRingCat.ofHom
            (R := HomogeneousLocalization.Away ((completionAlgebra E).grading U.1)
              (infinitySection E U.1))
            (S := ((Scheme.Modules.symmetricAlgebraSheaf X E).right.obj.obj (op U.1) :
              CommRingCat)) (chartRingEquiv U.2).symm.toRingHom) ≫
          (Proj.awayι ((completionAlgebra E).grading U.1) (infinitySection E U.1)
            (infinitySection_mem E U.1) one_pos ≫ Proj.toSpecZero _) ≫
          Spec.map (CommRingCat.ofHom ((GradedRing.projZeroRingHom'
            ((completionAlgebra E).grading U.1)).comp ((completionAlgebra E).strHom U.1))) ≫
          U.2.isoSpec.inv ≫ U.1.ι := by
        rw [hchart]
        simp only [Category.assoc]
        rfl
    _ = Spec.map ((Scheme.Modules.symmetricAlgebraSheaf X E).hom.hom.app (op U.1)) ≫
          U.2.isoSpec.inv ≫ U.1.ι := by
        have hspec : (Spec.map (CommRingCat.ofHom
              (R := HomogeneousLocalization.Away ((completionAlgebra E).grading U.1)
                (infinitySection E U.1))
              (S := ((Scheme.Modules.symmetricAlgebraSheaf X E).right.obj.obj (op U.1) :
                CommRingCat)) (chartRingEquiv U.2).symm.toRingHom) ≫
            Spec.map (CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
              ((completionAlgebra E).grading U.1) (Submonoid.powers (infinitySection E U.1))))) ≫
            Spec.map (CommRingCat.ofHom ((GradedRing.projZeroRingHom'
              ((completionAlgebra E).grading U.1)).comp ((completionAlgebra E).strHom U.1))) =
            Spec.map ((Scheme.Modules.symmetricAlgebraSheaf X E).hom.hom.app (op U.1)) := by
          rw [Category.assoc, ← Spec.map_comp, ← Spec.map_comp, Category.assoc]
          exact congrArg Spec.map hring
        rw [Proj.awayι_toSpecZero]
        exact (Category.assoc _ _ _).symm.trans ((Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ U.2.isoSpec.inv ≫ U.1.ι) hspec))

/-- **`j` lies over `X`**: `j ≫ π = p`. -/
@[reassoc (attr := simp)]
theorem toCompletion_comp_projectiveCompletionProj :
    toCompletion E ≫ projectiveCompletionProj E = Scheme.Modules.vectorBundleToBase X E := by
  refine colimit.hom_ext fun U => ?_
  refine (ι_toCompletion_assoc E U _).trans ?_
  refine (chartToCompletion_comp_projectiveCompletionProj E U).trans ?_
  exact (Category.assoc _ _ _).symm.trans
    (Scheme.Cover.RelativeGluingData.ι_toBase
      (relativeSpecGluingData (Scheme.Modules.symmetricAlgebraSheaf X E)) U).symm

/-! ### `j` is an open immersion -/

/-- The standard open `D₊(T) ≅ Spec Γ(U, Sym(ℰ))` of the chart of the projective completion over
an affine open `U`. -/
abbrev chartAway (U : X.affineOpens) :
    Spec ((Scheme.Modules.symmetricAlgebraSheaf X E).right.obj.obj (op U.1)) ⟶
      Proj ((completionAlgebra E).grading U.1) :=
  Spec.map (CommRingCat.ofHom
      (R := HomogeneousLocalization.Away ((completionAlgebra E).grading U.1)
        (infinitySection E U.1))
      (S := ((Scheme.Modules.symmetricAlgebraSheaf X E).right.obj.obj (op U.1) : CommRingCat))
      (chartRingEquiv U.2).symm.toRingHom) ≫
    Proj.awayι ((completionAlgebra E).grading U.1) (infinitySection E U.1)
      (infinitySection_mem E U.1) one_pos

/-- The ring map from the degree-zero part of the localisation at `T` to `Γ(U, Sym(ℰ))` given by
the inverse of `chartRingEquiv` is an isomorphism of commutative rings. -/
instance isIso_chartRingHom (U : X.affineOpens) :
    IsIso (CommRingCat.ofHom
      (R := HomogeneousLocalization.Away ((completionAlgebra E).grading U.1)
        (infinitySection E U.1))
      (S := ((Scheme.Modules.symmetricAlgebraSheaf X E).right.obj.obj (op U.1) : CommRingCat))
      (chartRingEquiv U.2).symm.toRingHom) :=
  (RingEquiv.toCommRingCatIso (chartRingEquiv U.2).symm).isIso_hom

/-- The standard open `D₊(T) ≅ Spec Γ(U, Sym(ℰ))` is an open immersion into the chart. -/
instance isOpenImmersion_chartAway (U : X.affineOpens) : IsOpenImmersion (chartAway E U) := by
  unfold chartAway
  infer_instance

/-- The chart of the projective completion over an affine open is an open immersion, stated at
the projective completion as its target. -/
instance isOpenImmersion_completionChart (U : X.Opens) (hU : IsAffineOpen U) :
    @IsOpenImmersion _ (projectiveCompletion E) ((relativeProj (completionAlgebra E)).chart U hU) :=
  Stacks.AlgebraicGeometry.RelativeProjTwistGlue.isOpenImmersion_chart _ U hU

/-- The part of the vector bundle over an affine open is an open subscheme, stated at the vector
bundle as its target. -/
instance isOpenImmersion_ι_vectorBundle (U : X.directedAffineCover.I₀) :
    IsOpenImmersion (colimit.ι (relativeSpecGluingData
        (Scheme.Modules.symmetricAlgebraSheaf X E)).functor U) :=
  inferInstance

/-- The chart `Spec Γ(U, Sym(ℰ)) ⟶ 𝐏(ℰ ⊕ 𝒪_X)` is the standard open `D₊(T)` followed by the
chart of the projective completion over `U`. -/
theorem chartToCompletion_eq (U : X.affineOpens) :
    chartToCompletion (E := E) U.2 =
      chartAway E U ≫ (relativeProj (completionAlgebra E)).chart U.1 U.2 := by
  unfold chartToCompletion chartAway
  exact (Category.assoc _ _ _).symm

/-- The part of the vector bundle over an affine open `U` is the part of the projective completion
over `U` met with the image of `j`: **over `U`, `j` is the standard open `D₊(T)` of the chart.** -/
theorem isPullback_toCompletion (U : X.directedAffineCover.I₀) :
    IsPullback (colimit.ι (relativeSpecGluingData
        (Scheme.Modules.symmetricAlgebraSheaf X E)).functor U)
      (chartAway E U) (toCompletion E) ((relativeProj (completionAlgebra E)).chart U.1 U.2) := by
  refine (@IsOpenImmersion.isPullback _ _ _ _ (chartAway E U)
    (colimit.ι (relativeSpecGluingData (Scheme.Modules.symmetricAlgebraSheaf X E)).functor U)
    ((relativeProj (completionAlgebra E)).chart U.1 U.2) (toCompletion E)
    (isOpenImmersion_ι_vectorBundle E U) (isOpenImmersion_completionChart E U.1 U.2) ?_ ?_).flip
  · exact (ι_toCompletion E U).trans (chartToCompletion_eq E U)
  · have h1 := (@Scheme.Hom.image_top_eq_opensRange _ _
      ((relativeProj (completionAlgebra E)).chart U.1 U.2)
      (isOpenImmersion_completionChart E U.1 U.2)).symm.trans
        (Stacks.AlgebraicGeometry.RelativeProjTwistGlue.chart_image_top _ U.1 U.2)
    have h2 : Scheme.Modules.vectorBundleToBase X E ⁻¹ᵁ U.1 =
        (colimit.ι (relativeSpecGluingData
          (Scheme.Modules.symmetricAlgebraSheaf X E)).functor U).opensRange := by
      have h := (relativeSpecGluingData
        (Scheme.Modules.symmetricAlgebraSheaf X E)).toBase_preimage_eq_opensRange_ι U
      rw [show (X.directedAffineCover.f U).opensRange = U.1 from
        Scheme.Opens.opensRange_ι _] at h
      exact h
    refine (congrArg (toCompletion E ⁻¹ᵁ ·) h1).trans ?_
    refine Eq.trans ?_ h2
    exact congrArg (· ⁻¹ᵁ U.1) (toCompletion_comp_projectiveCompletionProj E)

/-- **`j : Spec_X(Sym(ℰ)) ⟶ 𝐏(ℰ ⊕ 𝒪_X)` is an open immersion.** Over the chart of an affine open
`U` of `X` it is the standard open `D₊(T) ≅ Spec Γ(U, Sym(ℰ))`. -/
instance isOpenImmersion_toCompletion : IsOpenImmersion (toCompletion E) := by
  refine IsZariskiLocalAtTarget.of_iSup_eq_top
    (fun U : Stacks.AlgebraicGeometry.RelativeProjMapDomain.AffineOpen X =>
      ((relativeProj (completionAlgebra E)).chart U.1 U.2).opensRange)
    (Stacks.AlgebraicGeometry.ProjBundleSurjection.iSup_opensRange_chart_eq_top
      (relativeProj (completionAlgebra E))) fun U => ?_
  have := isOpenImmersion_completionChart E U.1 U.2
  have h₂ := isPullback_toCompletion E ⟨U.1, U.2⟩
  have h₁ : IsPullback (pullback.fst (toCompletion E)
        ((relativeProj (completionAlgebra E)).chart U.1 U.2))
      (pullback.snd (toCompletion E) ((relativeProj (completionAlgebra E)).chart U.1 U.2))
      (toCompletion E) ((relativeProj (completionAlgebra E)).chart U.1 U.2) :=
    IsPullback.of_hasPullback _ _
  have e₁ : Arrow.mk (chartAway E ⟨U.1, U.2⟩) ≅
      Arrow.mk (pullback.snd (toCompletion E)
        ((relativeProj (completionAlgebra E)).chart U.1 U.2)) :=
    Arrow.isoMk (h₂.isoIsPullback _ _ h₁) (Iso.refl _) (by
      rw [Iso.refl_hom, Category.comp_id]
      exact IsPullback.isoIsPullback_hom_snd _ _ h₂ h₁)
  have e₂ := morphismRestrictOpensRange (toCompletion E)
    ((relativeProj (completionAlgebra E)).chart U.1 U.2)
  exact (MorphismProperty.arrow_mk_iso_iff (P := @IsOpenImmersion)
    (e₁.trans e₂.symm)).mp (isOpenImmersion_chartAway E ⟨U.1, U.2⟩)

end Stacks.ProjectiveCompletion

end
