module

public import StacksFrontier.AlgebraicGeometry.ProjectiveBundle.Completion.VectorBundle

/-!
# The divisor at infinity and its complement

Let `ℰ` be a finite locally free module on a scheme `X`, `P = 𝐏(ℰ ⊕ 𝒪_X)` its projective
completion, `i : 𝐏(ℰ) ⟶ P` the divisor at infinity and `j : Spec_X(Sym(ℰ)) ⟶ P` the open
immersion of the vector bundle. This file proves that the image of `i` is exactly the complement
of the image of `j`, and draws the consequences used in the proof of [Stacks, Tag 02TY]: the
complement `V = P ∖ i(𝐏(ℰ))` of the divisor at infinity is, over `X`, the vector bundle of `ℰ`,
and its projection to `X` is an affine-space bundle of rank `r` when `ℰ` has rank `r`.

Over an affine open `U` of `X` the projective completion is `Proj Γ(U, Sym(ℰ ⊕ 𝒪_X))`, the divisor
at infinity is `Proj Γ(U, Sym(ℰ))`, the image of the quotient map killing the degree-one element
`T` attached to the section `(0, 1)`, and the vector bundle is `D₊(T)`. A point of `Proj` lies on
the closed subscheme cut out by `T` exactly when it does not lie in `D₊(T)`.

## Main definitions

* `Stacks.ProjectiveCompletion.complementOpen`: the open `V = P ∖ i(𝐏(ℰ))`.
* `Stacks.ProjectiveCompletion.complementIso`: the isomorphism `Spec_X(Sym(ℰ)) ≅ V`.

## Main results

* `Stacks.ProjectiveCompletion.range_infinityEmbedding`: `i(𝐏(ℰ)) = P ∖ V`.
* `Stacks.ProjectiveCompletion.complementIso_hom_comp`: the isomorphism `Spec_X(Sym(ℰ)) ≅ V` lies
  over `X`.
* `Stacks.ProjectiveCompletion.isAffineSpaceBundle_complementOpen`: `V ⟶ X` is an affine-space
  bundle of rank `r`.

## References

* [Stacks Project, Tag 02TY](https://stacks.math.columbia.edu/tag/02TY)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.SymGraded Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.AlgebraicGeometry.RelativeProj Stacks.AffineAlgebraEquivalence

universe u

namespace Stacks.ProjectiveCompletion

variable {X : Scheme.{u}} (E : X.Modules)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]

/-! ### The kernel of `Γ(U, Sym(ℰ ⊕ 𝒪_X)) ⟶ Γ(U, Sym(ℰ))` -/

/-- **The kernel of `Γ(U, Sym(ℰ ⊕ 𝒪_X)) ⟶ Γ(U, Sym(ℰ))` is generated by `T`, and `T` is a
nonzerodivisor**, over an affine open `U`. -/
theorem ker_sectionHom_eq_span_and_isRegular (U : X.Opens) (hU : IsAffineOpen U) :
    RingHom.ker ((schemeSheafGradedAlgebraHom (completionProjection E)
        (Stacks.Chow.bundlePieces (completionModule E)) (Stacks.Chow.bundlePieces E)).sectionHom U :
          (completionAlgebra E).sectionRing U →+*
            (schemeSheafGradedAlgebra E (Stacks.Chow.bundlePieces E)).sectionRing U) =
      Ideal.span {infinitySection E U} ∧ IsRegular (infinitySection E U) := by
  have hsurj : Function.Surjective (Stacks.SymGraded.AffinePieces.sectionsLinearMap
      (completionProjection E) U) := fun m =>
    ⟨(sectionsSplitting E U).j m, (sectionsSplitting E U).p_j m⟩
  have hexact : LinearMap.ker (Stacks.SymGraded.AffinePieces.sectionsLinearMap
      (completionProjection E) U) =
      Submodule.span Γ(X, U) {(sectionsSplitting E U).t₀} := by
    ext n
    rw [LinearMap.mem_ker, Submodule.mem_span_singleton]
    constructor
    · intro hn
      refine ⟨(sectionsSplitting E U).q n, ?_⟩
      have h := (sectionsSplitting E U).j_p_add_q_smul n
      have hp : (sectionsSplitting E U).p n = 0 := hn
      rw [hp, map_zero, zero_add] at h
      exact h
    · rintro ⟨c, rfl⟩
      change (sectionsSplitting E U).p (c • (sectionsSplitting E U).t₀) = 0
      rw [map_smul, (sectionsSplitting E U).p_t₀, smul_zero]
  have h := Stacks.SymGraded.AffinePieces.ker_sectionHom_eq_span_of_split
    (completionProjection E) (Stacks.Chow.bundlePieces (completionModule E))
    (Stacks.Chow.bundlePieces E) hU (sectionsSplitting E U).t₀ hsurj hexact
    (sectionsSplitting E U).q (sectionsSplitting E U).q_t₀
  have hT : (Stacks.SymGraded.AffinePieces.symSectionRingEquiv (completionModule E) hU
      (Stacks.Chow.bundlePieces (completionModule E))).symm
        (SymmetricAlgebra.ι _ _ (sectionsSplitting E U).t₀) = infinitySection E U :=
    (RingEquiv.symm_apply_eq _).2 (sectionRingEquiv_infinitySection hU).symm
  rw [← hT]
  exact ⟨h.1, h.2.1⟩

/-- **The kernel of `Γ(U, Sym(ℰ ⊕ 𝒪_X)) ⟶ Γ(U, Sym(ℰ))` is generated by `T`**, over an affine
open `U`. -/
theorem ker_sectionHom_eq_span (U : X.Opens) (hU : IsAffineOpen U) :
    RingHom.ker ((schemeSheafGradedAlgebraHom (completionProjection E)
        (Stacks.Chow.bundlePieces (completionModule E)) (Stacks.Chow.bundlePieces E)).sectionHom U :
          (completionAlgebra E).sectionRing U →+*
            (schemeSheafGradedAlgebra E (Stacks.Chow.bundlePieces E)).sectionRing U) =
      Ideal.span {infinitySection E U} :=
  (ker_sectionHom_eq_span_and_isRegular E U hU).1

/-- **`T` is a nonzerodivisor** of `Γ(U, Sym(ℰ ⊕ 𝒪_X))`, over an affine open `U`. -/
theorem isRegular_infinitySection (U : X.Opens) (hU : IsAffineOpen U) :
    IsRegular (infinitySection E U) :=
  (ker_sectionHom_eq_span_and_isRegular E U hU).2

/-- In a pullback square of schemes, `g z` lies in the range of `f` exactly when `z` lies in the
range of the projection `snd`. -/
private theorem mem_range_iff_of_isPullback {A B C D : Scheme.{u}} {fst : A ⟶ B} {snd : A ⟶ D}
    {f : B ⟶ C} {g : D ⟶ C} (hpb : IsPullback fst snd f g) (z : D) :
    g.base z ∈ Set.range f.base ↔ z ∈ Set.range snd.base := by
  constructor
  · rintro ⟨w, hw⟩
    obtain ⟨v, -, hv⟩ := Scheme.exists_preimage_of_isPullback hpb w z hw
    exact ⟨v, hv⟩
  · rintro ⟨v, rfl⟩
    exact ⟨fst.base v, (Scheme.Hom.comp_apply _ _ v).symm.trans
      ((congrArg (fun f => f.base v) hpb.w).trans (Scheme.Hom.comp_apply _ _ v))⟩

/-! ### The image of the divisor at infinity, chart by chart -/

/-- Over the chart of an affine open `U`, a point lies in the image of `j` exactly when it lies in
`D₊(T)`. -/
theorem chart_mem_range_toCompletion_iff (U : X.affineOpens)
    (z : AlgebraicGeometry.Proj ((completionAlgebra E).grading U.1)) :
    ((relativeProj (completionAlgebra E)).chart U.1 U.2).base z ∈
        Set.range (toCompletion E).base ↔
      z ∈ Proj.basicOpen ((completionAlgebra E).grading U.1) (infinitySection E U.1) := by
  have hpb := isPullback_toCompletion E U
  have hrange : Set.range (chartAway E U).base =
      (Proj.basicOpen ((completionAlgebra E).grading U.1) (infinitySection E U.1) :
        Set (AlgebraicGeometry.Proj ((completionAlgebra E).grading U.1))) :=
    congrArg (fun W : (AlgebraicGeometry.Proj ((completionAlgebra E).grading U.1)).Opens =>
      (W : Set (AlgebraicGeometry.Proj ((completionAlgebra E).grading U.1))))
      ((Scheme.Hom.opensRange_comp_of_isIso _ _).trans (Proj.opensRange_awayι _ _ _ _))
  exact (mem_range_iff_of_isPullback hpb z).trans (Set.ext_iff.1 hrange z)

/-- Over the chart of an affine open `U`, a point lies in the image of the divisor at infinity
exactly when `T` vanishes there. -/
theorem chart_mem_range_infinityEmbedding_iff (U : X.Opens) (hU : IsAffineOpen U)
    (z : AlgebraicGeometry.Proj ((completionAlgebra E).grading U)) :
    ((relativeProj (completionAlgebra E)).chart U hU).base z ∈
        Set.range (infinityEmbedding E).base ↔
      infinitySection E U ∈ z.asHomogeneousIdeal := by
  have hψ := Stacks.Chow.GenuineChern.surjectiveOnAffineSections_bundle
    (completionProjection E)
  have hpb := Stacks.AlgebraicGeometry.ProjBundleSurjection.isPullback_chart hψ U hU
  have hmap := Stacks.AlgebraicGeometry.ProjBundleSurjection.chartMap_eq_map hψ U hU
  have hker := ker_sectionHom_eq_span E U hU
  have hT : (schemeSheafGradedAlgebraHom (completionProjection E)
      (Stacks.Chow.bundlePieces (completionModule E)) (Stacks.Chow.bundlePieces E)).sectionHom U
        (infinitySection E U) = 0 := by
    have hmem : infinitySection E U ∈ RingHom.ker ((schemeSheafGradedAlgebraHom
        (completionProjection E) (Stacks.Chow.bundlePieces (completionModule E))
          (Stacks.Chow.bundlePieces E)).sectionHom U :
            (completionAlgebra E).sectionRing U →+*
              (schemeSheafGradedAlgebra E (Stacks.Chow.bundlePieces E)).sectionRing U) := by
      rw [hker]
      exact Ideal.subset_span rfl
    exact hmem
  refine (mem_range_iff_of_isPullback hpb z).trans ?_
  rw [hmap]
  exact ⟨fun h => mem_of_mem_range_map _
      (Stacks.AlgebraicGeometry.ProjBundleSurjection.irrelevant_le_map_sectionHom hψ hU)
      (infinitySection_mem E U) one_pos hT h,
    fun hz => mem_range_map_of_mem _
      (Stacks.AlgebraicGeometry.ProjBundleSurjection.irrelevant_le_map_sectionHom hψ hU)
      (Stacks.AlgebraicGeometry.ProjBundleSurjection.surjective_sectionHom hψ hU)
      hker.le z hz⟩

/-- **The image of the divisor at infinity is the complement of the image of the vector
bundle**: `i(𝐏(ℰ)) = P ∖ j(Spec_X(Sym(ℰ)))`. -/
theorem range_infinityEmbedding_eq_compl :
    Set.range (infinityEmbedding E).base = (Set.range (toCompletion E).base)ᶜ := by
  ext y
  obtain ⟨U, hU, hyU, -⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
    (x := (projectiveCompletionProj E).base y) (U := ⊤) trivial
  have hy : y ∈ ((relativeProj (completionAlgebra E)).chart U hU) ''ᵁ ⊤ := by
    rw [Stacks.AlgebraicGeometry.RelativeProjTwistGlue.chart_image_top]
    exact hyU
  obtain ⟨z, -, rfl⟩ := hy
  refine (chart_mem_range_infinityEmbedding_iff E U hU z).trans ?_
  refine Iff.trans ?_ (not_congr (chart_mem_range_toCompletion_iff E ⟨U, hU⟩ z)).symm
  exact not_not.symm

/-! ### The complement of the divisor at infinity -/

/-- **The complement `V = P ∖ i(𝐏(ℰ))` of the divisor at infinity**, the image of the open
immersion `j` of the vector bundle. -/
def complementOpen : (projectiveCompletion E).Opens :=
  (toCompletion E).opensRange

/-- The underlying set of `complementOpen E` is the image of `toCompletion E`. -/
theorem coe_complementOpen :
    (complementOpen E : Set (projectiveCompletion E)) = Set.range (toCompletion E).base :=
  rfl

/-- **The image of the divisor at infinity is the complement of `V`.** -/
theorem range_infinityEmbedding :
    Set.range (infinityEmbedding E).base = (Set.range (complementOpen E).ι.base)ᶜ := by
  rw [Scheme.Opens.range_ι, coe_complementOpen]
  exact range_infinityEmbedding_eq_compl E

/-- **The vector bundle is the complement of the divisor at infinity**:
`Spec_X(Sym(ℰ)) ≅ V = P ∖ i(𝐏(ℰ))`. -/
def complementIso : Scheme.Modules.vectorBundle X E ≅ complementOpen E :=
  (toCompletion E).isoOpensRange

/-- The isomorphism `complementIso E` followed by the inclusion of `complementOpen E` is
`toCompletion E`. -/
@[reassoc (attr := simp)]
theorem complementIso_hom_ι : (complementIso E).hom ≫ (complementOpen E).ι = toCompletion E :=
  (toCompletion E).isoOpensRange_hom_ι

/-- **The isomorphism `Spec_X(Sym(ℰ)) ≅ V` lies over `X`.** -/
@[reassoc]
theorem complementIso_hom_comp :
    (complementIso E).hom ≫ (complementOpen E).ι ≫ projectiveCompletionProj E =
      Scheme.Modules.vectorBundleToBase X E := by
  rw [complementIso_hom_ι_assoc, toCompletion_comp_projectiveCompletionProj]

/-- The inverse isomorphism `V ≅ Spec_X(Sym(ℰ))` lies over `X`. -/
@[reassoc]
theorem complementIso_inv_comp :
    (complementIso E).inv ≫ Scheme.Modules.vectorBundleToBase X E =
      (complementOpen E).ι ≫ projectiveCompletionProj E := by
  rw [← complementIso_hom_comp, Iso.inv_hom_id_assoc]

/-- **The complement of the divisor at infinity is an affine-space bundle of rank `r` over `X`**,
when `ℰ` has rank `r`: it is the vector bundle of `ℰ` over `X`. -/
theorem isAffineSpaceBundle_complementOpen (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] :
    Stacks.Chow.IsAffineSpaceBundle ((complementOpen E).ι ≫ projectiveCompletionProj E) r :=
  Stacks.Chow.isAffineSpaceBundle_of_isPullback
    (IsPullback.of_horiz_isIso (fst := (complementIso E).inv)
      (snd := (complementOpen E).ι ≫ projectiveCompletionProj E)
      (f := Scheme.Modules.vectorBundleToBase X E) (g := 𝟙 X)
      ⟨(complementIso_inv_comp E).trans (Category.comp_id _).symm⟩)
    (Stacks.Chow.isAffineSpaceBundle_vectorBundleToBase E r)

end Stacks.ProjectiveCompletion

end
