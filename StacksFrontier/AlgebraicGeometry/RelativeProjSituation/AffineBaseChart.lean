module

public import StacksFrontier.AlgebraicGeometry.ProjBundleProjectiveSpace.AffineBase
public import StacksFrontier.AlgebraicGeometry.ProjectiveBundle.SectionRings

/-!
# The chart over `⊤` of a relative `Proj` situation, and a finite generating family

Two facts about a relative `Proj` situation over a base whose top open is affine, both of them
read off results that already exist but that no statement names.

The first is that the chart over `⊤` is an isomorphism, so that over an affine base the relative
homogeneous spectrum *is* the absolute `Proj` of its graded ring of global sections. This is
`Stacks.AlgebraicGeometry.RelativeProjAffineBase.isIso_chart_top` for the assembled graded-algebra
substrate; the `Stacks.RelativeProj.Situation` substrate has the same cartesian chart square, so
the same one-line base-change argument applies to it.

The second is the generation statement hidden inside the proof of
`Stacks.RelativeProj.Situation.finiteType_sectionRing`: a finite family of degree-one local
sections spanning the degree-one sections over the functions on the base generates the whole
section ring over its degree-zero part. That proof uses it and discards it; it is pulled out here
because it is exactly the hypothesis `hgen` of
`Stacks.AlgebraicGeometry.RelativeProjChain.polyGradedHom`, through which a situation over an
affine base becomes a closed subscheme of a projective space.

## Main results

* `Stacks.RelativeProj.Situation.adjoin_image_of_one_eq_top`: **a finite spanning family of
  degree-one local sections generates the section ring** over its degree-zero part.
* `Stacks.RelativeProj.Situation.isIso_relativeProjChart_top`: **over a base whose top open is
  affine the chart over `⊤` is an isomorphism.**
* `Stacks.RelativeProj.Situation.relativeProjChartTopIso` and
  `relativeProjChartTopIso_hom_comp_toBase`: that isomorphism, and the fact that it lies over the
  base.

## Implementation notes

The spanning hypothesis is phrased over `s.base.ringCatSheaf.obj.obj (op U)` rather than over
`Γ(S, U)`, because that is the ring the homogeneous pieces are modules over and the ring in which
`Stacks.RelativeProj.Situation.exists_finset_span_reesSituation_degreeOne` delivers its family.
The two are definitionally equal.

## References

* [Stacks Project, Tag 01NQ](https://stacks.math.columbia.edu/tag/01NQ)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite DirectSum

universe u

namespace Stacks.RelativeProj.Situation

variable (s : Situation.{u})

/-! ### A finite spanning family of degree-one sections generates the section ring -/

/-- **A finite family of degree-one local sections spanning the degree-one sections over the
functions on the base generates the section ring over its degree-zero part.**

This is the first half of the proof of `Stacks.RelativeProj.Situation.finiteType_sectionRing`,
named: the subalgebra generated by the family contains every degree-one element, by induction over
the span, and the degree-one elements generate everything by
`Stacks.RelativeProj.Situation.adjoin_sectionRingGrading_one_eq_top_of_isGeneratedInDegreeOne`. -/
theorem adjoin_image_of_one_eq_top (U : s.base.Opens)
    (hgen : s.algebra.IsGeneratedInDegreeOne (op U)) (g : Finset (s.sectionPieces U 1))
    (hg : Submodule.span (s.base.ringCatSheaf.obj.obj (op U))
      (g : Set (s.sectionPieces U 1)) = ⊤) :
    Algebra.adjoin (s.sectionRingGrading U 0)
        ((fun x : s.sectionPieces U 1 => DirectSum.of (s.sectionPieces U) 1 x) ''
          (g : Set (s.sectionPieces U 1))) = ⊤ := by
  have key : (s.sectionRingGrading U 1 : Set (s.sectionRing U)) ⊆
      (Algebra.adjoin (s.sectionRingGrading U 0)
        ((fun x : s.sectionPieces U 1 => DirectSum.of (s.sectionPieces U) 1 x) ''
          (g : Set (s.sectionPieces U 1))) : Set (s.sectionRing U)) := by
    rintro z ⟨x, rfl⟩
    have hx : x ∈ Submodule.span (s.base.ringCatSheaf.obj.obj (op U))
        (g : Set (s.sectionPieces U 1)) := hg ▸ trivial
    induction hx using Submodule.span_induction with
    | mem y hy => exact Algebra.subset_adjoin ⟨y, hy, rfl⟩
    | zero => rw [map_zero]; exact Subalgebra.zero_mem _
    | add y w _ _ ihy ihw => rw [map_add]; exact Subalgebra.add_mem _ ihy ihw
    | smul r y _ ih =>
        have h0 : s.sectionRingBaseMap U r ∈
            Algebra.adjoin (s.sectionRingGrading U 0)
              ((fun x : s.sectionPieces U 1 => DirectSum.of (s.sectionPieces U) 1 x) ''
                (g : Set (s.sectionPieces U 1))) :=
          Subalgebra.algebraMap_mem _
            (⟨s.sectionRingBaseMap U r, sectionRingBaseMap_mem_zero s U r⟩ :
              s.sectionRingGrading U 0)
        rw [← sectionRingBaseMap_mul_of s U 1 r y]
        exact Subalgebra.mul_mem _ h0 ih
  refine top_unique ?_
  rw [← adjoin_sectionRingGrading_one_eq_top_of_isGeneratedInDegreeOne s U hgen]
  exact Algebra.adjoin_le key

/-! ### The chart over `⊤` -/

/-- **Over a base whose top open is affine the chart over `⊤` is an isomorphism.** The chart
square of [Stacks, Tag 01NQ] is cartesian, and the leg it is a base change of is the inclusion
`⊤ ⊆ S`, which is an isomorphism. -/
theorem isIso_relativeProjChart_top (hS : IsAffineOpen (⊤ : s.base.Opens)) :
    IsIso (relativeProjChart s ⟨⊤, hS⟩) :=
  MorphismProperty.of_isPullback (P := MorphismProperty.isomorphisms Scheme.{u})
    (relativeProjChart_isPullback s ⟨⊤, hS⟩).flip
    (Stacks.AlgebraicGeometry.RelativeProjAffineBase.isIso_ι_top (S := s.base))

/-- **Over a base whose top open is affine the relative homogeneous spectrum is the absolute
`Proj` of its graded ring of global sections.** -/
def relativeProjChartTopIso (hS : IsAffineOpen (⊤ : s.base.Opens)) :
    AlgebraicGeometry.Proj (s.sectionRingGrading ⊤) ≅ relativeProj s :=
  haveI := isIso_relativeProjChart_top s hS
  asIso (relativeProjChart s ⟨⊤, hS⟩)

/-- The isomorphism of `Stacks.RelativeProj.Situation.relativeProjChartTopIso` is the chart
itself. -/
@[simp] theorem relativeProjChartTopIso_hom (hS : IsAffineOpen (⊤ : s.base.Opens)) :
    (relativeProjChartTopIso s hS).hom = relativeProjChart s ⟨⊤, hS⟩ := rfl

/-- The isomorphism of `Stacks.RelativeProj.Situation.relativeProjChartTopIso` is one over the
base: the chart lies over the inclusion of `⊤`, which cancels. -/
theorem relativeProjChartTopIso_hom_comp_toBase (hS : IsAffineOpen (⊤ : s.base.Opens)) :
    (relativeProjChartTopIso s hS).hom ≫ relativeProjToBase s =
      projInclusionToOpen s ⊤ hS ≫ (⊤ : s.base.Opens).ι :=
  (relativeProjChart_isPullback s ⟨⊤, hS⟩).w

end Stacks.RelativeProj.Situation

end
