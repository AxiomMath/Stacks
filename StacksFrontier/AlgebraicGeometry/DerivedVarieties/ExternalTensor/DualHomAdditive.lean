-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits MonoidalCategory
open Stacks.FiniteLocallyFree

universe v u

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] [Preadditive C] [MonoidalCategory C]
  [MonoidalPreadditive C]

/-- **The hom-set bijection of an exact pairing is additive.** `tensorRightHomEquiv` sends `f` to
`(ρ_ X).inv ≫ X ◁ η_ Y Y' ≫ (α_ X Y Y').inv ≫ f ▷ Y'`, and in a monoidal preadditive category
whiskering and composition are both additive. -/
theorem tensorRightHomEquiv_add (X Y Y' Z : C) [ExactPairing Y Y'] (f g : X ⊗ Y ⟶ Z) :
    tensorRightHomEquiv X Y Y' Z (f + g) =
      tensorRightHomEquiv X Y Y' Z f + tensorRightHomEquiv X Y Y' Z g := by
  simp only [tensorRightHomEquiv, Equiv.coe_fn_mk, MonoidalPreadditive.add_whiskerRight,
    Preadditive.comp_add]

/-- **The hom-set bijection of an exact pairing is `R`-linear**, in an `R`-linear monoidal
category whose tensor product is `R`-bilinear on morphisms. This is
`CategoryTheory.tensorRightHomEquiv_add` with `CategoryTheory.MonoidalLinear.smul_whiskerRight`
in place of `CategoryTheory.MonoidalPreadditive.add_whiskerRight`. -/
theorem tensorRightHomEquiv_smul {R : Type*} [Semiring R] [Linear R C] [MonoidalLinear R C]
    (X Y Y' Z : C) [ExactPairing Y Y'] (c : R) (f : X ⊗ Y ⟶ Z) :
    tensorRightHomEquiv X Y Y' Z (c • f) = c • tensorRightHomEquiv X Y Y' Z f := by
  simp only [tensorRightHomEquiv, Equiv.coe_fn_mk, MonoidalLinear.smul_whiskerRight,
    Linear.comp_smul]

end CategoryTheory

namespace AlgebraicGeometry

open Stacks.AlgebraicGeometry.ReflexiveModules AlgebraicGeometry.VectorBundleKZero

attribute [local instance] onSpaceModulesMonoidal

/-- **The tensor product of modules on a scheme is biadditive**, at the spelling
`AlgebraicGeometry.onSpaceModulesMonoidal` of the monoidal structure of [Stacks, Tag 01CA]. It is
`Stacks.SheafOfModules.OnSpace.monoidalPreadditive` at the underlying ringed space; the type
`AlgebraicGeometry.Scheme.Modules` is the same by `rfl`, but instance search does not unfold the
`def`, so the structure has to be named here as well. -/
theorem modulesMonoidalPreadditive (W : Scheme.{u}) : MonoidalPreadditive W.Modules :=
  Stacks.SheafOfModules.OnSpace.monoidalPreadditive W.toRingedSpace

attribute [local instance] modulesMonoidalPreadditive

/-- The duality bijection written out: it is the hom-set bijection of the exact pairing between
`P` and `P^∨` applied to the morphism read along the left unitor `𝒪_W ⊗ P ≅ P`. -/
theorem dualTensorHomEquiv_apply (W : Scheme.{u}) (P F : W.Modules)
    (hP : IsFiniteLocallyFree.{u, u, u} (R := W.ringCatSheaf) P) (q : P ⟶ F) :
    dualTensorHomEquiv W P F hP q =
      @tensorRightHomEquiv W.Modules _ (onSpaceModulesMonoidal W) (𝟙_ W.Modules) P (dualSheaf P) F
        (dualSheafExactPairing W P hP) ((Iso.homFromEquiv (λ_ P)).symm q) :=
  rfl

/-- **`Hom(P, ℱ) ≃ Γ(W, ℱ ⊗ P^∨)` is additive.** Both steps of the bijection are: the first is
composition with the left unitor, the second is
`CategoryTheory.tensorRightHomEquiv_add` for the pairing between `P` and `P^∨`, the tensor
product of modules on a scheme being biadditive. -/
theorem dualTensorHomEquiv_add (W : Scheme.{u}) (P F : W.Modules)
    (hP : IsFiniteLocallyFree.{u, u, u} (R := W.ringCatSheaf) P) (q q' : P ⟶ F) :
    dualTensorHomEquiv W P F hP (q + q') =
      dualTensorHomEquiv W P F hP q + dualTensorHomEquiv W P F hP q' := by
  have hadd : ∀ r r' : P ⟶ F, (Iso.homFromEquiv (λ_ P)).symm (r + r')
      = (Iso.homFromEquiv (λ_ P)).symm r + (Iso.homFromEquiv (λ_ P)).symm r' := fun r r' =>
    Preadditive.comp_add _ _ _ (λ_ P).hom r r'
  rw [dualTensorHomEquiv_apply, dualTensorHomEquiv_apply, dualTensorHomEquiv_apply, hadd]
  exact @tensorRightHomEquiv_add W.Modules _ _ (onSpaceModulesMonoidal W)
    (modulesMonoidalPreadditive W) (𝟙_ W.Modules) P (dualSheaf P) F
    (dualSheafExactPairing W P hP) _ _

/-! ### The two duality bijections are `R`-linear over an affine base -/

section Linear

open Stacks.RegularSequence (globalSmulCenter)

variable (R : Type u) [CommRing R] (W : Over (Spec (.of R)))

/-- **A base scalar on the first tensor factor is that scalar on the tensor product.** Whiskering
`c • 𝟙` on the right is the tensor product of maps at `(c • 𝟙, 𝟙)`, and
`AlgebraicGeometry.tensorSheafMap_globalSmulCenter_left` evaluates that: the scalar action of
`AlgebraicGeometry.modulesLinear` is multiplication by a global function. -/
theorem smul_id_whiskerRight (c : R) (A B : W.left.Modules) :
    letI := modulesLinear R W
    (c • 𝟙 A) ▷ B = c • 𝟙 (A ⊗ B) := by
  let := modulesLinear R W
  refine (tensorHom_id (c • 𝟙 A) B).symm.trans
    ((Stacks.SheafOfModules.OnSpace.tensorHom_eq_tensorSheafMap W.left.toRingedSpace
      ((globalSmulCenter W.left (baseRingToGlobalSections R W c)).app A) (𝟙 B)).trans ?_)
  exact tensorSheafMap_globalSmulCenter_left W.left (baseRingToGlobalSections R W c) A B

/-- **A base scalar on the second tensor factor is that scalar on the tensor product**, the
mirror of `AlgebraicGeometry.smul_id_whiskerRight`. -/
theorem whiskerLeft_smul_id (c : R) (A B : W.left.Modules) :
    letI := modulesLinear R W
    A ◁ (c • 𝟙 B) = c • 𝟙 (A ⊗ B) := by
  let := modulesLinear R W
  refine (id_tensorHom A (c • 𝟙 B)).symm.trans
    ((Stacks.SheafOfModules.OnSpace.tensorHom_eq_tensorSheafMap W.left.toRingedSpace
      (𝟙 A) ((globalSmulCenter W.left (baseRingToGlobalSections R W c)).app B)).trans ?_)
  exact tensorSheafMap_globalSmulCenter_right W.left (baseRingToGlobalSections R W c) A B

/-- **The tensor product of modules on an `R`-scheme is `R`-bilinear on morphisms**, which is
`CategoryTheory.MonoidalLinear` for `AlgebraicGeometry.onSpaceModulesMonoidal`. Each of the two
whiskering laws follows from its value at `c • 𝟙`, a scalar being by definition `c • 𝟙`
composed. -/
theorem modulesMonoidalLinear :
    letI := modulesLinear R W
    MonoidalLinear R W.left.Modules := by
  let := modulesLinear R W
  have h : ∀ (c : R) {B C' : W.left.Modules} (f : B ⟶ C'), c • f = f ≫ (c • 𝟙 C') := by simp
  refine ⟨fun A B C' c f => ?_, fun c {B C'} f A => ?_⟩
  · rw [h c f, MonoidalCategory.whiskerLeft_comp, whiskerLeft_smul_id R W, Linear.comp_smul,
      Category.comp_id]
  · rw [h c f, MonoidalCategory.comp_whiskerRight, smul_id_whiskerRight R W, Linear.comp_smul,
      Category.comp_id]

/-- **`Hom(P, ℱ) ≃ Γ(W, ℱ ⊗ P^∨)` is `R`-linear** for `W` a scheme over `R`. Both steps are:
the first is composition with the left unitor, the second is
`CategoryTheory.tensorRightHomEquiv_smul` for the pairing between `P` and `P^∨`, the tensor
product of modules on an `R`-scheme being `R`-bilinear by
`AlgebraicGeometry.modulesMonoidalLinear`. -/
theorem dualTensorHomEquiv_smul (P F : W.left.Modules)
    (hP : IsFiniteLocallyFree.{u, u, u} (R := W.left.ringCatSheaf) P) (c : R) (q : P ⟶ F) :
    letI := modulesLinear R W
    dualTensorHomEquiv W.left P F hP (c • q) = c • dualTensorHomEquiv W.left P F hP q := by
  let := modulesLinear R W
  have hsmul : (Iso.homFromEquiv (λ_ P)).symm (c • q)
      = c • (Iso.homFromEquiv (λ_ P)).symm q := Linear.comp_smul _ _ _ (λ_ P).hom c q
  rw [dualTensorHomEquiv_apply, dualTensorHomEquiv_apply, hsmul]
  exact @CategoryTheory.tensorRightHomEquiv_smul W.left.Modules _ _ (onSpaceModulesMonoidal W.left)
    (modulesMonoidalPreadditive W.left) R _ (modulesLinear R W) (modulesMonoidalLinear R W)
    (𝟙_ W.left.Modules) P (dualSheaf P) F (dualSheafExactPairing W.left P hP) c _

/-- **`Hom(ℰ ⊠ 𝒢, ℱ) ≃ Γ(X ×_R Y, ℱ ⊗ (ℰ^∨ ⊠ 𝒢^∨))` is `R`-linear.** It is
`AlgebraicGeometry.dualTensorHomEquiv_smul` at `P = ℰ ⊠ 𝒢` on the fibre product read as an
`R`-scheme, followed by composition with the isomorphism `(ℰ ⊠ 𝒢)^∨ ≅ ℰ^∨ ⊠ 𝒢^∨` whiskered into
the second factor, and composition is `R`-linear.

Together with `AlgebraicGeometry.externalTensorProductMap_smul_left` and `_smul_right` of
`StacksFrontier.AlgebraicGeometry.ResolutionsAndBounds.ExternalTensorFunctorial` this is what makes
a statement about the subgroup of `R`-bilinearity relations in `Hom(ℰ ⊠ 𝒢, ℱ)` into one about
the global sections of `ℱ ⊗ (ℰ^∨ ⊠ 𝒢^∨)`; additivity alone transports only the subgroup
generated by sums. -/
theorem externalTensorDualTensorHomEquiv_smul (X Y : Over (Spec (.of R)))
    (E : X.left.Modules) (G : Y.left.Modules)
    (F : (Limits.pullback X.hom Y.hom).Modules)
    (hE : IsFiniteLocallyFree.{u, u, u} (R := X.left.ringCatSheaf) E)
    (hG : IsFiniteLocallyFree.{u, u, u} (R := Y.left.ringCatSheaf) G)
    (c : R) (q : externalTensorProduct X.hom Y.hom E G ⟶ F) :
    letI : Linear R (Limits.pullback X.hom Y.hom).Modules :=
      modulesLinear R (externalTensorOver R X Y)
    externalTensorDualTensorHomEquiv X.hom Y.hom E G F hE hG (c • q)
      = c • externalTensorDualTensorHomEquiv X.hom Y.hom E G F hE hG q := by
  let : Linear R (Limits.pullback X.hom Y.hom).Modules :=
    modulesLinear R (externalTensorOver R X Y)
  have h : dualTensorHomEquiv (Limits.pullback X.hom Y.hom)
        (externalTensorProduct X.hom Y.hom E G) F
        (isFiniteLocallyFree_externalTensorProduct X.hom Y.hom E G hE hG) (c • q)
      = c • dualTensorHomEquiv (Limits.pullback X.hom Y.hom)
        (externalTensorProduct X.hom Y.hom E G) F
        (isFiniteLocallyFree_externalTensorProduct X.hom Y.hom E G hE hG) q :=
    dualTensorHomEquiv_smul R (externalTensorOver R X Y) _ F _ c q
  show (Iso.homToEquiv _) (dualTensorHomEquiv (Limits.pullback X.hom Y.hom)
      (externalTensorProduct X.hom Y.hom E G) F _ (c • q)) = _
  rw [h]
  simp only [Iso.homToEquiv, Equiv.coe_fn_mk]
  exact Linear.smul_comp _ _ _ c _ _

end Linear

variable {X Y S : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S)

/-- **`Hom(ℰ ⊠ 𝒢, ℱ) ≃ Γ(X ×_S Y, ℱ ⊗ (ℰ^∨ ⊠ 𝒢^∨))` is additive.** It is
`AlgebraicGeometry.dualTensorHomEquiv_add` at `P = ℰ ⊠ 𝒢` followed by composition with the
isomorphism `(ℰ ⊠ 𝒢)^∨ ≅ ℰ^∨ ⊠ 𝒢^∨` whiskered into the second factor, and composition is
additive.

This is the form in which a spanning statement about `Hom(ℰ ⊠ 𝒢, ℱ)` becomes a spanning
statement about the global sections of `ℱ ⊗ (ℰ^∨ ⊠ 𝒢^∨)`. -/
theorem externalTensorDualTensorHomEquiv_add (E : X.Modules) (G : Y.Modules)
    (F : (Limits.pullback f g).Modules)
    (hE : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) E)
    (hG : IsFiniteLocallyFree.{u, u, u} (R := Y.ringCatSheaf) G)
    (q q' : externalTensorProduct f g E G ⟶ F) :
    externalTensorDualTensorHomEquiv f g E G F hE hG (q + q') =
      externalTensorDualTensorHomEquiv f g E G F hE hG q +
        externalTensorDualTensorHomEquiv f g E G F hE hG q' := by
  show (Iso.homToEquiv _) (AlgebraicGeometry.dualTensorHomEquiv (Limits.pullback f g)
      (externalTensorProduct f g E G) F _ (q + q')) = _
  rw [dualTensorHomEquiv_add]
  simp only [Iso.homToEquiv, Equiv.coe_fn_mk]
  exact Preadditive.add_comp _ _ _ _ _ _

end AlgebraicGeometry

end
