module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.LocalCompleteIntersection.SmoothDiagonal
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularImmersion.PerfectFactor

/-!
# The diagonal of a smooth morphism, read in a local ring

Let `π : Y ⟶ T` be a smooth morphism of finite type between locally Noetherian schemes. By
[Stacks, Tag 0FDP] its diagonal `Δ : Y ⟶ Y ×_T Y` is a regular immersion, and a regular immersion
generates the kernel of each of its maps of local rings by a regular sequence
(`Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_isRegular_ker_stalkMap_of_isRegularImmersion`).
So at every point `y` of `Y` the ideal of the diagonal in `𝒪_{Y ×_T Y, Δ(y)}` is generated by a
regular sequence.

This is the sentence that opens Case II of [Stacks, Tag 0G0R]: "Since `Y_s` is smooth over `k` we
know that `Δ_{Y_s/k} : Y_s → Y_s × Y_s` is a regular immersion... Choose a regular sequence
`f̄_1, …, f̄_r ∈ 𝒪_{Y_s × Y_s, z}` cutting out the ideal sheaf of `Δ_{Y_s/k}(Y_s)`."

## Main results

* `AlgebraicGeometry.exists_isRegular_ker_stalkMap_diagonal_of_smooth`: the regular sequence, as a
  list.
* `AlgebraicGeometry.exists_isRegular_span_ker_stalkMap_diagonal_of_smooth`: the same sequence
  indexed by `Fin r`, with its ideal written as the span of its range. This is the shape
  `AlgebraicGeometry.FlatLocalKoszulDeformationSituation` and the Koszul machinery take.

## Implementation notes

The fibre product is `CategoryTheory.Limits.pullback` and the diagonal is
`CategoryTheory.Limits.pullback.diagonal`, which Mathlib already knows to be an immersion; so
[Stacks, Tag 0FDP] applies with no separatedness hypothesis, and its second condition is read off
the `List.TFAE` with `List.TFAE.out`.

The conversion between a list and a `Fin r`-indexed family is `List.ofFn_get` together with
`List.mem_ofFn`, which identifies `Ideal.ofList` of a list with the span of the range of the
corresponding family.

## References

* [Stacks Project, Tag 0FDP](https://stacks.math.columbia.edu/tag/0FDP)
* [Stacks Project, Tag 0G0R](https://stacks.math.columbia.edu/tag/0G0R)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits RingTheory.Sequence

universe u

namespace AlgebraicGeometry

variable {Y T : Scheme.{u}} (π : Y ⟶ T) [IsLocallyNoetherian Y] [IsLocallyNoetherian T]
  [LocallyOfFiniteType π] [QuasiCompact π] [Smooth π]

/-- **The ideal of the diagonal of a smooth morphism is generated, in each local ring, by a
regular sequence.** -/
theorem exists_isRegular_ker_stalkMap_diagonal_of_smooth (y : Y) :
    ∃ rs : List ((pullback π π).presheaf.stalk ((pullback.diagonal π).base y)),
      IsRegular ((pullback π π).presheaf.stalk ((pullback.diagonal π).base y)) rs ∧
        Ideal.ofList rs = RingHom.ker ((pullback.diagonal π).stalkMap y).hom := by
  have h : Flat π ∧ Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularImmersion
      (pullback.diagonal π) := ((smooth_tfae_diagonal π).out 1 2).mp ‹Smooth π›
  exact
    Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_isRegular_ker_stalkMap_of_isRegularImmersion
      (pullback.diagonal π) h.2 y

/-- **The regular sequence cutting out the diagonal, indexed by `Fin r`.** The ideal of the
diagonal in `𝒪_{Y ×_T Y, Δ(y)}` is the span of the range of a regular sequence
`f̄_1, …, f̄_r`. -/
theorem exists_isRegular_span_ker_stalkMap_diagonal_of_smooth (y : Y) :
    ∃ (r : ℕ) (f : Fin r → (pullback π π).presheaf.stalk ((pullback.diagonal π).base y)),
      IsRegular ((pullback π π).presheaf.stalk ((pullback.diagonal π).base y)) (List.ofFn f) ∧
        Ideal.span (Set.range f) = RingHom.ker ((pullback.diagonal π).stalkMap y).hom := by
  obtain ⟨rs, hreg, hspan⟩ := exists_isRegular_ker_stalkMap_diagonal_of_smooth π y
  refine ⟨rs.length, rs.get, ?_, ?_⟩
  · rwa [List.ofFn_get]
  · rw [← hspan]
    show Ideal.span (Set.range rs.get) = Ideal.span {x | x ∈ rs}
    congr 1
    ext x
    simp

end AlgebraicGeometry

end
