/-!
# A lifted Koszul description of a flat local deformation

In a flat local deformation of a regular Koszul complex, the lifted equations remain a regular
sequence, and the perfect complex being deformed is represented in the derived category by the
Koszul complex of those lifts. The proof lifts the augmentation of the Koszul complex through a
finite-free representative, reduces modulo the ideal of the base to see that the comparison is an
isomorphism in degree zero, and then propagates invertibility to every degree by Nakayama.

## Main results

* `Module.Flat.isRegular_and_flat_quotient_ofList_smul_of_isRegular_maximalIdeal` gives regularity
  of the lifted sequence, and flatness of the partial quotients.
* `AlgebraicGeometry.derivedIso_koszulOfLift` identifies the deformed perfect complex with the
  Koszul complex of its lifted first differential.

## Implementation notes

The regularity conclusion is the ring case of the module-form result for a flat local ring map; it
does not depend on a perfect complex. The complex and sequence in the second result are those
supplied by the finite-free lifting result: a finite-free representative, its closed-fibre
identification, and its first differential in chosen bases. The Koszul complex is placed in
cohomological degrees by the standard embedding `ComplexShape.embeddingDownNat`.

## References

* [Stacks Project, Tag 0G0N](https://stacks.math.columbia.edu/tag/0G0N)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u v

namespace AlgebraicGeometry

attribute [local instance] HasDerivedCategory.standard

/-- The Koszul augmentation, transported to cochain complexes in cohomological degrees. -/
private noncomputable def koszulAugmentationCochain
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat) ⟶
      (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).obj
        (ModuleCat.of A (A ⧸ Ideal.span (Set.range f))) :=
  HomologicalComplex.extendMap (Koszul.koszulAugmentation f) ComplexShape.embeddingDownNat ≫
    (HomologicalComplex.extendSingleIso ComplexShape.embeddingDownNat
      (ModuleCat.of A (A ⧸ Ideal.span (Set.range f))) 0 0 rfl).hom

/-- The cochain Koszul augmentation of a Koszul-regular sequence is a quasi-isomorphism. -/
private theorem koszulAugmentationCochain_quasiIso
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (hf : Koszul.IsKoszulRegular f) : QuasiIso (koszulAugmentationCochain f) := by
  change QuasiIso (HomologicalComplex.extendMap (Koszul.koszulAugmentation f)
    ComplexShape.embeddingDownNat ≫
      (HomologicalComplex.extendSingleIso ComplexShape.embeddingDownNat
        (ModuleCat.of A (A ⧸ Ideal.span (Set.range f))) 0 0 rfl).hom)
  rw [quasiIso_iff_comp_right, HomologicalComplex.quasiIso_extendMap_iff]
  exact Koszul.koszulAugmentation_quasiIso f hf

/-- The augmentation of a finite-free complex whose first differential realises the sequence `f`
onto the quotient by the ideal generated by `f`. -/
private noncomputable def comparisonAugmentation
    {A : Type u} [CommRing A] {r : ℕ}
    (P : CochainComplex (ModuleCat.{u} A) ℤ) (f : Fin r → A)
    (e₀ : P.X 0 ≅ ModuleCat.of A A)
    (e₁ : P.X (-1) ≅ ModuleCat.of A (Fin r → A))
    (hf : ∀ i, f i = e₀.hom.hom ((P.d (-1) 0).hom
      (e₁.inv.hom (Pi.single i 1)))) :
    P ⟶ (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).obj
      (ModuleCat.of A (A ⧸ Ideal.span (Set.range f))) := by
  classical
  let q : ModuleCat.of A A ⟶ ModuleCat.of A (A ⧸ Ideal.span (Set.range f)) :=
    ModuleCat.ofHom (Ideal.Quotient.mkₐ A (Ideal.span (Set.range f))).toLinearMap
  refine HomologicalComplex.mkHomToSingle (e₀.hom ≫ q) ?_
  intro i hi
  obtain rfl : i = -1 := by
    simp only [ComplexShape.up_Rel] at hi
    omega
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply]
  change (Ideal.Quotient.mk (Ideal.span (Set.range f)))
    (e₀.hom.hom ((P.d (-1) 0).hom x)) = 0
  let y := e₁.hom.hom x
  rw [show x = e₁.inv.hom y by simp [y]]
  have hy : y = ∑ i : Fin r, y i • Pi.single i (1 : A) := by
    ext i
    simp [Pi.single_apply]
  rw [hy]
  simp only [map_sum, map_smul]
  refine Finset.sum_eq_zero fun i _ => ?_
  rw [← hf i, smul_eq_mul]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_range_self i)))

/-- A map of finite projective modules which becomes an isomorphism after reduction modulo an
ideal in the Jacobson radical is an isomorphism. -/
@[ega "0 19.1.10" "special case"]
private lemma isIso_of_isIso_reduction
    {A : Type u} [CommRing A] (I : Ideal A)
    (hI : ∀ x ∈ I, IsUnit (1 + x))
    {M N : ModuleCat.{max v u} A}
    [Module.Finite A M] [Module.Projective A M]
    [Module.Finite A N] [Module.Projective A N]
    (f : M ⟶ N)
    [IsIso ((ModuleCat.extendScalars (Ideal.Quotient.mk I)).map f)] : IsIso f := by
  rw [ConcreteCategory.isIso_iff_bijective]
  apply lift_iso_of_quot_iso I hI f.hom
  let eM := TensorProduct.quotTensorEquivQuotSMul M I
  let eN := TensorProduct.quotTensorEquivQuotSMul N I
  have h : inducedQuot I f.hom = eN.toLinearMap ∘ₗ
      ((f.hom.baseChange (A ⧸ I)).restrictScalars A) ∘ₗ eM.symm.toLinearMap := by
    apply LinearMap.ext
    intro x
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective (I • (⊤ : Submodule A M)) x
    simp [eM, eN, inducedQuot]
  rw [h]
  exact eN.bijective.comp (((ConcreteCategory.isIso_iff_bijective
    ((ModuleCat.extendScalars (Ideal.Quotient.mk I)).map f)).mp inferInstance).comp
      eM.symm.bijective)

open HomologicalComplex

/-- Extension of scalars sends the Koszul complex of a sequence to the Koszul complex of its
image. -/
private theorem koszul_seqComplex_extendScalars_iso
    {A : Type u} [CommRing A] (L : Type u) [CommRing L] (q : A →+* L)
    {r : ℕ} (f : Fin r → A) :
    Nonempty
      (((ModuleCat.extendScalars q).mapHomologicalComplex
          (ComplexShape.down ℕ)).obj (Koszul.seqComplex f) ≅
        Koszul.seqComplex (fun i => q (f i))) := by
  let : Algebra A L := q.toAlgebra
  let F := ModuleCat.extendScalars q
  choose β hβ using fun n => KoszulC.extPow_baseChange_natEquiv (R := A) (S := L) (r := r) n
  refine ⟨HomologicalComplex.Hom.isoOfComponents
    (fun n => by
      let e₀ : (F.obj (ModuleCat.of A (⋀[A]^n (Fin r → A))) : Type u) ≃ₗ[L]
          (TensorProduct A L (⋀[A]^n (Fin r → A))) :=
        { toFun := id
          invFun := id
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      exact (e₀.trans (β n)).toModuleIso) ?_⟩
  intro i j hij
  obtain rfl : j + 1 = i := hij
  simp only [Functor.mapHomologicalComplex_obj_d, Koszul.seqComplex_d]
  apply ModuleCat.ExtendScalars.hom_ext
  intro z
  change Koszul.d (Koszul.seqDual (fun k => q (f k))) j
      (β (j + 1) (1 ⊗ₜ[A] z)) =
    β j (1 ⊗ₜ[A] Koszul.d (Koszul.seqDual f) j z)
  exact (KoszulC.d_baseChange_comm f β hβ j z).symm

/-- The degree-zero term of the cochain Koszul complex is the ring. -/
private noncomputable def koszulCochainZeroIso
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat).X 0 ≅ ModuleCat.of A A :=
  HomologicalComplex.extendXIso _ _ (show ComplexShape.embeddingDownNat.f 0 = 0 by rfl) ≪≫
    (exteriorPower.zeroEquiv A (Fin r → A)).toModuleIso

/-- An endomorphism of a module isomorphic to the ring is multiplication by a scalar. -/
private lemma end_eq_smul_id {A : Type u} [CommRing A]
    {M : ModuleCat.{u} A} (e : M ≅ ModuleCat.of A A) (g : M ⟶ M) :
    ∃ a : A, g = a • 𝟙 M := by
  let l := (e.inv ≫ g ≫ e.hom).hom
  refine ⟨l 1, ?_⟩
  apply (cancel_epi e.inv).1
  apply (cancel_mono e.hom).1
  simp only [Category.assoc, Linear.comp_smul, Linear.smul_comp,
    Category.id_comp, Iso.inv_hom_id]
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  change l x = (l 1) • x
  simpa [smul_eq_mul, mul_comm] using l.map_smul x (1 : A)

/-- A scalar acting invertibly on the ring is a unit. -/
private lemma isUnit_of_isIso_smul_id {A : Type u} [CommRing A]
    (a : A) [IsIso (a • 𝟙 (ModuleCat.of A A))] : IsUnit a := by
  obtain ⟨b, hb⟩ := ((ModuleCat.epi_iff_surjective (a • 𝟙 (ModuleCat.of A A))).mp
    inferInstance) 1
  exact isUnit_iff_exists_inv.mpr ⟨b, hb⟩

/-- In degree zero the cochain Koszul augmentation is the quotient map. -/
private lemma koszulAugmentationCochain_f_zero
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    (koszulAugmentationCochain f).f 0 =
      (koszulCochainZeroIso f).hom ≫
        ModuleCat.ofHom (Ideal.span (Set.range f)).mkQ ≫
          (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0
            (ModuleCat.of A (A ⧸ Ideal.span (Set.range f)))).inv := by
  dsimp [koszulAugmentationCochain]
  rw [HomologicalComplex.extendMap_f _ _
    (show ComplexShape.embeddingDownNat.f 0 = 0 by simp),
    HomologicalComplex.extendSingleIso_hom_f ComplexShape.embeddingDownNat
    (ModuleCat.of A (A ⧸ Ideal.span (Set.range f))) 0 0
    (show ComplexShape.embeddingDownNat.f 0 = 0 by simp)]
  simp only [Category.assoc, Iso.inv_hom_id_assoc]
  rfl

/-- Endomorphisms of a regular Koszul resolution are homotopic to scalar multiplication. -/
private lemma koszulEnd_homotopy_smul
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (hf : Koszul.IsKoszulRegular f)
    (g : (Koszul.seqComplex f).extend ComplexShape.embeddingDownNat ⟶
      (Koszul.seqComplex f).extend ComplexShape.embeddingDownNat) :
    ∃ a : A, g.f 0 = a • 𝟙 _ ∧ Nonempty (Homotopy g (a • 𝟙 _)) := by
  let K : CochainComplex (ModuleCat A) ℤ :=
    (Koszul.seqComplex f).extend ComplexShape.embeddingDownNat
  obtain ⟨a, ha⟩ := end_eq_smul_id (koszulCochainZeroIso f) (g.f 0)
  refine ⟨a, ha, ?_⟩
  have : ∀ n : ℕ, Projective ((Koszul.seqComplex f).X n) := fun n =>
    ModuleCat.projective_of_free ((Pi.basisFun A (Fin r)).exteriorPower n)
  have : K.IsKProjective := inferInstance
  have : QuasiIso (koszulAugmentationCochain f) := koszulAugmentationCochain_quasiIso f hf
  have heq : g ≫ koszulAugmentationCochain f =
      (a • 𝟙 K) ≫ koszulAugmentationCochain f := by
    apply HomologicalComplex.Hom.ext
    funext i
    by_cases hi : i = 0
    · subst i
      simp [ha]
    · exact (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0
        (ModuleCat.of A (A ⧸ Ideal.span (Set.range f))) i hi).eq_of_tgt _ _
  exact CochainComplex.IsKProjective.nonempty_homotopy_of_comp_quasiIso
    (koszulAugmentationCochain f) (Homotopy.ofEq heq)

/-- Extension of scalars sends the cochain Koszul complex of a sequence to that of its image. -/
private lemma koszulCochain_extendScalars_iso
    {A : Type u} [CommRing A] (L : Type u) [CommRing L] (q : A →+* L)
    {r : ℕ} (f : Fin r → A) :
    Nonempty
      (((ModuleCat.extendScalars q).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat) ≅
        (Koszul.seqComplex (fun i => q (f i))).extend ComplexShape.embeddingDownNat) :=
  ⟨(HomologicalComplex.mapHomologicalComplexExtendIso (ModuleCat.extendScalars q)
      (Koszul.seqComplex f) ComplexShape.embeddingDownNat).symm ≪≫
    (ComplexShape.embeddingDownNat.extendFunctor _).mapIso
      (koszul_seqComplex_extendScalars_iso L q f).some⟩

/-- The Koszul complex of the zero sequence has zero differentials. -/
private lemma koszul_zero_d {A : Type u} [CommRing A] (r : ℕ) (i j : ℕ) :
    (Koszul.seqComplex (0 : Fin r → A)).d i j = 0 := by
  by_cases h : j + 1 = i
  · subst i
    rw [Koszul.seqComplex_d]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    change Koszul.contraction (Koszul.seqDual (0 : Fin r → A)) _ = 0
    have hdual : Koszul.seqDual (0 : Fin r → A) = 0 := by
      ext x
      simp [Koszul.seqDual_apply]
    simp [hdual, Koszul.contraction]
  · exact HomologicalComplex.shape _ i j h

/-- The extension of a complex with zero differentials has zero differentials. -/
private lemma extend_zero_d {C : Type*} [Category C] [HasZeroMorphisms C] [HasZeroObject C]
    {ι ι' : Type*} {c : ComplexShape ι} {c' : ComplexShape ι'}
    (K : HomologicalComplex C c) (e : c.Embedding c')
    (hK : ∀ i j, K.d i j = 0) (i j : ι') : (K.extend e).d i j = 0 := by
  change HomologicalComplex.extend.d K (e.r i) (e.r j) = 0
  cases e.r i <;> cases e.r j <;> first | rfl | exact hK _ _

/-- A complex isomorphic to one with zero differentials has zero differentials. -/
private lemma zero_d_of_iso {C : Type*} [Category C] [HasZeroMorphisms C]
    {ι : Type*} {c : ComplexShape ι} {K L : HomologicalComplex C c}
    (e : K ≅ L) (hL : ∀ i j, L.d i j = 0) (i j : ι) : K.d i j = 0 := by
  apply (cancel_mono (e.hom.f j)).1
  rw [← e.hom.comm, hL, comp_zero, zero_comp]

/-- Reducing the cochain Koszul complex modulo the ideal generated by the sequence kills its
differentials. -/
private lemma koszulCochain_reduction_d
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) (i j : ℤ) :
    (ModuleCat.extendScalars (Ideal.Quotient.mk (Ideal.span (Set.range f)))).map
      (((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat).d i j) = 0 := by
  let J := Ideal.span (Set.range f)
  obtain ⟨e⟩ := koszulCochain_extendScalars_iso (A ⧸ J) (Ideal.Quotient.mk J) f
  have hseq : (fun i => Ideal.Quotient.mk J (f i)) = 0 := by
    funext i
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i))
  have hzero : ∀ i j, ((Koszul.seqComplex (fun i => Ideal.Quotient.mk J (f i))).extend
      ComplexShape.embeddingDownNat).d i j = 0 := by
    rw [hseq]
    exact extend_zero_d _ _ (koszul_zero_d r)
  exact zero_d_of_iso e hzero i j

/-- Every term of the cochain Koszul complex is a finite projective module. -/
private lemma koszulCochain_finite_projective
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) (i : ℤ) :
    Module.Finite A (((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat).X i) ∧
      Module.Projective A (((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat).X i) := by
  by_cases hi : ∃ n, ComplexShape.embeddingDownNat.f n = i
  · obtain ⟨n, hn⟩ := hi
    let e := (Koszul.seqComplex f).extendXIso ComplexShape.embeddingDownNat hn
    have : Module.Finite A ((Koszul.seqComplex f).X n) :=
      Module.Finite.of_basis ((Pi.basisFun A (Fin r)).exteriorPower n)
    have : Module.Free A ((Koszul.seqComplex f).X n) :=
      Module.Free.of_basis ((Pi.basisFun A (Fin r)).exteriorPower n)
    exact ⟨Module.Finite.equiv e.symm.toLinearEquiv,
      Module.Projective.of_equiv e.symm.toLinearEquiv⟩
  · have hz := (Koszul.seqComplex f).isZero_extend_X ComplexShape.embeddingDownNat i
      (fun n hn => hi ⟨n, hn⟩)
    have := ModuleCat.subsingleton_of_isZero hz
    exact ⟨inferInstance, inferInstance⟩

/-- A unit acts invertibly on every module. -/
private lemma isIso_smul_id {A : Type u} [CommRing A] (a : A) (ha : IsUnit a)
    (M : ModuleCat.{u} A) : IsIso (a • 𝟙 M) := by
  obtain ⟨a, rfl⟩ := ha
  exact ⟨(↑(a⁻¹) : A) • 𝟙 M, by simp [smul_smul], by simp [smul_smul]⟩

/-- For a Koszul ideal in the Jacobson radical, an invertible degree-zero component
forces an endomorphism of the regular Koszul complex to be invertible in every degree. -/
private lemma koszulEnd_isIso
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (hf : Koszul.IsKoszulRegular f)
    (hJ : ∀ x ∈ Ideal.span (Set.range f), IsUnit (1 + x))
    (g : (Koszul.seqComplex f).extend ComplexShape.embeddingDownNat ⟶
      (Koszul.seqComplex f).extend ComplexShape.embeddingDownNat)
    [IsIso (g.f 0)] : IsIso g := by
  obtain ⟨a, ha, ⟨h⟩⟩ := koszulEnd_homotopy_smul f hf g
  have hascalar : IsIso (a • 𝟙 (ModuleCat.of A A)) := by
    have heq : (koszulCochainZeroIso f).inv ≫ g.f 0 ≫ (koszulCochainZeroIso f).hom =
        a • 𝟙 (ModuleCat.of A A) := by simp [ha]
    rw [← heq]
    infer_instance
  have hau : IsUnit a := isUnit_of_isIso_smul_id a
  let J := Ideal.span (Set.range f)
  let F := ModuleCat.extendScalars (Ideal.Quotient.mk J)
  have hr := F.mapHomotopy h
  have hi (i : ℤ) : IsIso (g.f i) := by
    have heq : F.map (g.f i) = F.map (a • 𝟙 _) := by
      simpa [dNext, prevD, F, J, koszulCochain_reduction_d] using hr.comm i
    have : IsIso (a • 𝟙 (((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat).X i)) :=
      isIso_smul_id a hau _
    have : IsIso (F.map (g.f i)) := by
      rw [heq]
      infer_instance
    have := (koszulCochain_finite_projective f i).1
    have := (koszulCochain_finite_projective f i).2
    exact isIso_of_isIso_reduction J hJ (g.f i)
  exact HomologicalComplex.Hom.isIso_of_components g

/-- For an ideal of a local ring contained in the maximal ideal, `1 + x` is a unit for every `x`
in it. -/
private lemma isUnit_one_add_of_le_maximalIdeal
    {A : Type u} [CommRing A] [IsLocalRing A] (J : Ideal A)
    (hJ : J ≤ IsLocalRing.maximalIdeal A) : ∀ x ∈ J, IsUnit (1 + x) := by
  intro x hx
  rw [← IsLocalRing.notMem_maximalIdeal]
  intro h
  have hone : (1 : A) ∈ IsLocalRing.maximalIdeal A := by
    simpa using (IsLocalRing.maximalIdeal A).sub_mem h (hJ hx)
  exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).2 hone)

/-- A map between modules isomorphic to the ring which is compatible with the quotient maps modulo
an ideal in the Jacobson radical is an isomorphism. -/
private lemma isIso_of_comp_mkQ_eq
    {A : Type u} [CommRing A] (J : Ideal A)
    (hJ : ∀ x ∈ J, IsUnit (1 + x))
    {M N : ModuleCat.{u} A} (eM : M ≅ ModuleCat.of A A)
    (eN : N ≅ ModuleCat.of A A) (g : M ⟶ N)
    (hg : g ≫ eN.hom ≫ ModuleCat.ofHom J.mkQ = eM.hom ≫ ModuleCat.ofHom J.mkQ) :
    IsIso g := by
  let t := eM.inv ≫ g ≫ eN.hom
  obtain ⟨a, ha⟩ := end_eq_smul_id (Iso.refl (ModuleCat.of A A)) t
  have ht : t.hom 1 = a := by simpa using congrArg (fun k => k.hom 1) ha
  have hq : Ideal.Quotient.mk J a = 1 := by
    have h := congrArg (fun k : M ⟶ ModuleCat.of A (A ⧸ J) => k.hom (eM.inv.hom 1)) hg
    simpa [ModuleCat.hom_comp, LinearMap.comp_apply, ← ht, t] using h
  have hau : IsUnit a := by
    have hmem : a - 1 ∈ J := Ideal.Quotient.eq_zero_iff_mem.mp (by simp [hq])
    simpa using hJ (a - 1) hmem
  have : IsIso t := by
    rw [ha]
    exact isIso_smul_id a hau _
  rw [show g = eM.hom ≫ t ≫ eN.inv by simp [t]]
  infer_instance

/-- The ideal generated by a regular sequence in a local ring is contained in the maximal ideal. -/
private lemma isUnit_one_add_span_of_regular
    {A : Type u} [CommRing A] [IsLocalRing A] {r : ℕ} (f : Fin r → A)
    (hf : RingTheory.Sequence.IsRegular A (List.ofFn f)) :
    ∀ x ∈ Ideal.span (Set.range f), IsUnit (1 + x) := by
  apply isUnit_one_add_of_le_maximalIdeal
  apply IsLocalRing.le_maximalIdeal
  have heq : Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) := by
    change Ideal.span {x | x ∈ List.ofFn f} = _
    congr 1
    exact Set.ext fun x => List.mem_ofFn
  intro h
  apply hf.top_ne_smul
  rw [heq, h, Submodule.top_smul]

/-- The chosen finite-free lift of the closed-fibre Koszul complex represents the Koszul
complex of its lifted first differential. -/
@[stacks 0G0N "lifted_koszul"]
public lemma derivedIso_koszulOfLift
    (S : FlatLocalKoszulDeformationSituation.{u}) :
    letI : CommRing S.A := S.commRingA
    let I := Ideal.map (algebraMap S.R S.A) (IsLocalRing.maximalIdeal S.R)
    ∀ (P : CochainComplex (ModuleCat.{u} S.A) ℤ)
      (f : Fin S.r → S.A),
      Nonempty (DerivedCategory.Q.obj P ≅ S.K) →
      Nonempty
        (((ModuleCat.extendScalars (Ideal.Quotient.mk I)).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj P ≅
          (Koszul.seqComplex S.residueSequence).extend ComplexShape.embeddingDownNat) →
      (∀ n : ℕ,
        Nonempty (P.X (-(n : ℤ)) ≅
          ModuleCat.of S.A (Fin (S.r.choose n) → S.A))) →
      (∀ i : ℤ, 0 < i → IsZero (P.X i)) →
      (∃ (e₀ : P.X 0 ≅ ModuleCat.of S.A S.A)
        (e₁ : P.X (-1) ≅ ModuleCat.of S.A (Fin S.r → S.A)),
        (∀ i, f i = e₀.hom.hom ((P.d (-1) 0).hom
          (e₁.inv.hom (Pi.single i 1)))) ∧
        (∀ i, Ideal.Quotient.mk I (f i) = S.residueSequence i)) →
      Nonempty
        (S.K ≅ DerivedCategory.Q.obj
          ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat)) := by
  classical
  intro I P f hPK hPf hterms hpositive hdata
  let : CommRing S.A := S.commRingA
  rcases hdata with ⟨e₀, e₁, hf, hfbar⟩
  have hreg : RingTheory.Sequence.IsRegular S.A (List.ofFn f) := by
    have hfp : (algebraMap S.R S.A).EssentiallyOfFinitePresentation := by
      rcases S.essentiallyOfFinitePresentation with
        ⟨T, hT, hRT, hfin, M, hTS, hTower, hLoc⟩
      let : CommRing T := hT
      let : Algebra S.R T := hRT
      let : Algebra T S.A := hTS
      exact ⟨T, inferInstance, inferInstance, inferInstance, hTower, hfin, M, hLoc⟩
    have hbase' : RingTheory.Sequence.IsRegular
        (S.A ⧸ (Ideal.map (algebraMap S.R S.A) (IsLocalRing.maximalIdeal S.R) •
          (⊤ : Submodule S.A S.A))) (List.ofFn f) := by
      let L := S.A ⧸ I
      let : Algebra S.A L := inferInstance
      let : IsScalarTower S.A L L := inferInstance
      have hmap : List.map (Ideal.Quotient.mk I) (List.ofFn f) =
          List.ofFn S.residueSequence := by
        rw [List.map_ofFn]
        congr 1
        funext i
        exact hfbar i
      have hweak : RingTheory.Sequence.IsWeaklyRegular L (List.ofFn f) := by
        have hmapweak : RingTheory.Sequence.IsWeaklyRegular L
            ((List.ofFn f).map (Ideal.Quotient.mk I)) := by
          rw [hmap]
          exact S.residueSequence_regular.toIsWeaklyRegular
        exact (RingTheory.Sequence.isWeaklyRegular_map_algebraMap_iff
          (S := L) (M := L) (List.ofFn f)).mp hmapweak
      have htop : (⊤ : Submodule S.A L) ≠
          Ideal.ofList (List.ofFn f) • (⊤ : Submodule S.A L) := by
        intro h
        have hmapIdeal : Ideal.ofList (List.ofFn S.residueSequence) =
            (Ideal.ofList (List.ofFn f)).map (Ideal.Quotient.mk I) := by
          rw [Ideal.map_ofList, hmap]
        have heq :
            (Ideal.ofList (List.ofFn S.residueSequence) • (⊤ : Submodule L L)).restrictScalars S.A =
              Ideal.ofList (List.ofFn f) • (⊤ : Submodule S.A L) := by
          rw [hmapIdeal]
          exact (Ideal.smul_restrictScalars (Ideal.ofList (List.ofFn f))
            (⊤ : Submodule L L)).trans (by simp)
        have hrestrict : (⊤ : Submodule L L).restrictScalars S.A =
            (Ideal.ofList (List.ofFn S.residueSequence) •
              (⊤ : Submodule L L)).restrictScalars S.A := by
          rw [Submodule.restrictScalars_top, h]
          exact heq.symm
        have hquot : (⊤ : Submodule L L) =
            Ideal.ofList (List.ofFn S.residueSequence) • (⊤ : Submodule L L) :=
          (Submodule.restrictScalars_inj S.A L L
            (V₁ := (⊤ : Submodule L L))
            (V₂ := Ideal.ofList (List.ofFn S.residueSequence) • (⊤ : Submodule L L))).mp hrestrict
        exact S.residueSequence_regular.top_ne_smul hquot
      have hregular : RingTheory.Sequence.IsRegular L (List.ofFn f) := ⟨hweak, htop⟩
      rw [show I • (⊤ : Submodule S.A S.A) = I by simp]
      exact hregular
    exact (Module.Flat.isRegular_and_flat_quotient_ofList_smul_of_isRegular_maximalIdeal
      (M := S.A) hfp (List.ofFn f) hbase').1
  let α := koszulAugmentationCochain f
  let γ := comparisonAugmentation P f e₀ e₁ hf
  have : QuasiIso α := koszulAugmentationCochain_quasiIso f
    ((Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular (M := S.A)).2.2 hreg)
  have : P.IsStrictlyLE 0 := by
    rw [CochainComplex.isStrictlyLE_iff]
    intro i hi
    exact hpositive i (by omega)
  have hP (i : ℤ) : Module.Finite S.A (P.X i) ∧ Module.Projective S.A (P.X i) := by
    by_cases hi : i ≤ 0
    · obtain ⟨e⟩ := hterms (-i).toNat
      rw [show -((-i).toNat : ℤ) = i by omega] at e
      exact ⟨Module.Finite.equiv e.symm.toLinearEquiv,
        Module.Projective.of_equiv e.symm.toLinearEquiv⟩
    · have := ModuleCat.subsingleton_of_isZero (hpositive i (by omega))
      exact ⟨inferInstance, inferInstance⟩
  have hPproj (i : ℤ) : Projective (P.X i) := by
    have := (hP i).2
    infer_instance
  have : P.IsKProjective := CochainComplex.isKProjective_of_projective P 0
  have hαepi : ∀ i : ℤ, Epi (α.f i) := by
    intro i
    by_cases hi : i = 0
    · subst i
      dsimp [α, koszulAugmentationCochain]
      rw [HomologicalComplex.extendMap_f _ _ (show ComplexShape.embeddingDownNat.f 0 = 0 by simp)]
      have : Epi ((Koszul.koszulAugmentation f).f 0) := by
        change Epi (ModuleCat.ofHom ((Ideal.span (Set.range f)).mkQ.comp
          (exteriorPower.zeroEquiv S.A (Fin S.r → S.A)).toLinearMap))
        rw [ModuleCat.epi_iff_surjective]
        intro y
        obtain ⟨a, ha⟩ := Submodule.mkQ_surjective (Ideal.span (Set.range f)) y
        refine ⟨(exteriorPower.zeroEquiv S.A (Fin S.r → S.A)).symm a, ?_⟩
        simpa [ModuleCat.hom_comp, LinearMap.comp_apply] using ha
      infer_instance
    · let Q := ModuleCat.of S.A (S.A ⧸ Ideal.span (Set.range f))
      have hz : IsZero
          (((HomologicalComplex.single (ModuleCat.{u} S.A) (ComplexShape.up ℤ) 0).obj Q).X i) :=
        HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 Q i hi
      have : Subsingleton
          (((HomologicalComplex.single (ModuleCat.{u} S.A) (ComplexShape.up ℤ) 0).obj Q).X i) :=
        ModuleCat.subsingleton_of_isZero hz
      exact (ModuleCat.epi_iff_surjective _).2 fun _ => ⟨0, Subsingleton.elim _ _⟩
  obtain ⟨φ, hφ⟩ :=
    (CochainComplex.IsKProjective.exists_lift_of_quasiIso α γ).2 hPproj hαepi
  have hφeq : φ ≫ α = γ := hφ
  have hIle : I ≤ IsLocalRing.maximalIdeal S.A := by
    apply Ideal.map_le_iff_le_comap.mpr
    rw [IsLocalRing.maximalIdeal_comap]
  have hI := isUnit_one_add_of_le_maximalIdeal I hIle
  have hJ := isUnit_one_add_span_of_regular f hreg
  have hφzero : IsIso (φ.f 0) := by
    apply isIso_of_comp_mkQ_eq (Ideal.span (Set.range f)) hJ e₀
      (koszulCochainZeroIso f)
    have heq := congrArg (fun k => k.f 0 ≫
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0
        (ModuleCat.of S.A (S.A ⧸ Ideal.span (Set.range f)))).hom) hφeq
    dsimp only [HomologicalComplex.comp_f, α] at heq
    rw [koszulAugmentationCochain_f_zero] at heq
    have hq : (Ideal.Quotient.mkₐ S.A (Ideal.span (Set.range f))).toLinearMap =
        (Ideal.span (Set.range f)).mkQ := by
      ext
      rfl
    simpa [γ, comparisonAugmentation, HomologicalComplex.mkHomToSingle_f,
      Category.assoc, hq] using heq
  let L := S.A ⧸ I
  let q := Ideal.Quotient.mk I
  let F := ModuleCat.extendScalars q
  let FC := F.mapHomologicalComplex (ComplexShape.up ℤ)
  have hseq : (fun i : Fin S.r => q (f i)) = S.residueSequence := funext hfbar
  let eK : FC.obj ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat) ≅
      (Koszul.seqComplex S.residueSequence).extend ComplexShape.embeddingDownNat :=
    (koszulCochain_extendScalars_iso L q f).some ≪≫
      eqToIso (congrArg (fun s => (Koszul.seqComplex s).extend
        ComplexShape.embeddingDownNat) hseq)
  let eP := hPf.some
  let t := eP.inv ≫ FC.map φ ≫ eK.hom
  have : Nontrivial L := Ideal.Quotient.nontrivial_iff.mpr
    (ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal S.A).ne_top hIle)
  have : IsLocalRing L := IsLocalRing.of_surjective' q Ideal.Quotient.mk_surjective
  have htzero : IsIso (t.f 0) := by
    dsimp [t, FC]
    infer_instance
  have ht : IsIso t := koszulEnd_isIso S.residueSequence
    ((Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular
      (M := L)).2.2 S.residueSequence_regular)
    (isUnit_one_add_span_of_regular S.residueSequence S.residueSequence_regular) t
  have hbar : IsIso (FC.map φ) := by
    rw [show FC.map φ = eP.hom ≫ t ≫ eK.inv by simp [t]]
    infer_instance
  have hφiso : IsIso φ := by
    have hi (i : ℤ) : IsIso (φ.f i) := by
      have := (hP i).1
      have := (hP i).2
      have := (koszulCochain_finite_projective f i).1
      have := (koszulCochain_finite_projective f i).2
      have : IsIso (F.map (φ.f i)) := (HomologicalComplex.eval _ _ i).map_isIso (FC.map φ)
      exact isIso_of_isIso_reduction I hI (φ.f i)
    exact HomologicalComplex.Hom.isIso_of_components φ
  exact ⟨hPK.some.symm ≪≫ asIso (DerivedCategory.Q.map φ)⟩

end AlgebraicGeometry
