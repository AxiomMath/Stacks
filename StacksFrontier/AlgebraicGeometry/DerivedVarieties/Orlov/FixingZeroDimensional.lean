    Module.rank_lt_aleph0_iff.mp ((Cardinal.le_sum _ i).trans_lt hsum)
  have : FiniteDimensional k ((ObjectProperty.ι _).obj A ⟶ ((ObjectProperty.ι _).obj B)⟦i⟧) :=
    hfin
