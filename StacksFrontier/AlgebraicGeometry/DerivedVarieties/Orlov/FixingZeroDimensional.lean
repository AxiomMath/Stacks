/-- **Hom spaces between shifts of perfect complexes on a proper scheme over a field are
finite-dimensional** ([Stacks, Tag 0FYC]). -/
theorem finite_hom_shift_perfect (A B : PerfectDerivedCategory X.left) (i : ℤ) :
    letI : Linear k X.left.Modules := modulesLinear k X
    Module.Finite k (A ⟶ B⟦i⟧) := by
