  intro ξ hξ
  let P := perfectPointSheaf X.left hX x hx
  obtain ⟨eP⟩ := nonempty_iso_map_perfectPointSheaf hX F hfix x hx
  by_contra hne
  obtain ⟨B, f, g, hT⟩ := distinguished_cocone_triangle₂ ξ
  let T := Triangle.mk f g ξ
  let T' := (ObjectProperty.ι _).mapTriangle.obj T
  have hT' : T' ∈ distTriang (DerivedCategory X.left.Modules) :=
    (ObjectProperty.ι _).map_distinguished _ hT
  have hLE : B.obj.IsLE 0 := DerivedCategory.TStructure.t.isLE₂ T' hT' 0
    (DerivedCategory.instIsLEObjSingleFunctor (residueFieldSkyscraperSheaf X.left x) 0)
    (DerivedCategory.instIsLEObjSingleFunctor (residueFieldSkyscraperSheaf X.left x) 0)
  have hGE : B.obj.IsGE 0 := DerivedCategory.TStructure.t.isGE₂ T' hT' 0
    (DerivedCategory.instIsGEObjSingleFunctor (residueFieldSkyscraperSheaf X.left x) 0)
    (DerivedCategory.instIsGEObjSingleFunctor (residueFieldSkyscraperSheaf X.left x) 0)
  obtain ⟨M, ⟨e⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE B.obj 0
  have hbc := Stacks.AlgebraicGeometry.PerfectCohomology.isBoundedCoherent_of_isPerfect X.left
    B.obj B.property
  have hMcoh : M.IsCoherent := @ObjectProperty.prop_of_iso _ _
    (fun M : SheafOfModules.{u} X.left.ringCatSheaf => M.IsCoherent)
    AlgebraicGeometry.CoherentAbelian.coherentModules_isClosedUnderIsomorphisms _ _
    ((DerivedCategory.homologyFunctor X.left.Modules 0).mapIso e ≪≫
      (DerivedCategory.singleFunctorCompHomologyFunctorIso X.left.Modules 0).app M) (hbc.2 0)
  obtain ⟨eB⟩ := nonempty_iso_map_of_supp_subset_singleton hX F hfix x M hMcoh
    (supp_subset_of_distTriang_pointSheaf X.left x hx T' hT' (Iso.refl _) (Iso.refl _) M e) B e
  have : FiniteDimensional k (T.obj₃ ⟶ T.obj₁) := finite_hom_perfect X P P
  have : FiniteDimensional k (T.obj₃ ⟶ T.obj₂) := finite_hom_perfect X P B
  have : FiniteDimensional k (T.obj₃ ⟶ T.obj₃) := finite_hom_perfect X P P
  exact map_mor₃_ne_zero_of_iso k F T hT eP eB eP hne hξ

/-- **The Ext computations of [Stacks, Tag 0G26].** Let `X` be proper and regular over a field
`k` and `F` a `k`-linear exact endofunctor of `D_perf(𝒪_X)` with `F(𝓕) ≅ 𝓕` for every coherent
`𝓕` with zero-dimensional support. Then for all closed points `x, x'` and all `i ∈ ℤ`, `F`
induces a bijection `Ext^i(𝒪_x, 𝒪_{x'}) ⟶ Ext^i(F(𝒪_x), F(𝒪_{x'}))`. -/
theorem bijective_map_shift_perfectPointSheaf_of_fixes_zeroDimensional (hX : IsRegular X.left)
    (F : PerfectDerivedCategory X.left ⥤ PerfectDerivedCategory X.left) [F.CommShift ℤ]
    [F.IsTriangulated]
    (hlin : letI : Linear k X.left.Modules := modulesLinear k X; F.Linear k)
    (hfix : ∀ (𝓕 : X.left.Modules), 𝓕.IsCoherent →
      topologicalKrullDim (SheafOfModules.supp 𝓕) = 0 →
      ∀ h𝓕 : IsPerfect (X := X.left.toRingedSpace)
          ((DerivedCategory.singleFunctor X.left.Modules 0).obj 𝓕),
        Nonempty ((F.obj ⟨_, h𝓕⟩).obj ≅ (DerivedCategory.singleFunctor X.left.Modules 0).obj 𝓕))
    (x x' : X.left) (hx : IsClosed ({x} : Set X.left)) (hx' : IsClosed ({x'} : Set X.left))
    (i : ℤ) :
    haveI : IsNoetherian X.left := isNoetherian_of_locallyOfFiniteType X.hom
    Function.Bijective (fun f : perfectPointSheaf X.left hX x hx ⟶
        (perfectPointSheaf X.left hX x' hx')⟦i⟧ =>
      F.map f ≫ (F.commShiftIso i).hom.app (perfectPointSheaf X.left hX x' hx')) := by
  have : IsNoetherian X.left := isNoetherian_of_locallyOfFiniteType X.hom
  let : Linear k X.left.Modules := modulesLinear k X
  have : F.Linear k := hlin
  obtain ⟨eP⟩ := nonempty_iso_map_perfectPointSheaf hX F hfix x hx
  obtain ⟨eP'⟩ := nonempty_iso_map_perfectPointSheaf hX F hfix x' hx'
  have : Nonempty (perfectPointSheaf X.left hX x hx ⟶ (perfectPointSheaf X.left hX x' hx')⟦i⟧) :=
    ⟨0⟩
  by_cases h : i < 0 ∨ x ≠ x'
  · have : Subsingleton ((perfectPointSheaf X.left hX x hx).obj ⟶
        ((perfectPointSheaf X.left hX x' hx').obj)⟦i⟧) :=
      h.elim (subsingleton_hom_singleFunctor_shift_of_neg (residueFieldSkyscraperSheaf X.left x)
        (residueFieldSkyscraperSheaf X.left x') i)
        (subsingleton_hom_pointSheaf_shift_of_ne X.left x hx · i)
    have := (perfectHomShiftEquiv X.left (perfectPointSheaf X.left hX x hx)
      (perfectPointSheaf X.left hX x' hx') i).injective.subsingleton
    exact bijective_map_shift_of_subsingleton F eP eP' i
  push Not at h
  obtain ⟨hi, rfl⟩ := h
  let P := perfectPointSheaf X.left hX x hx
  have hfin : ∀ j : ℤ, FiniteDimensional k (P ⟶ P⟦j⟧) := fun j => finite_hom_shift_perfect X P P j
  have h1 : Function.Bijective (fun f : P ⟶ P⟦(1 : ℤ)⟧ =>
      F.map f ≫ (F.commShiftIso (1 : ℤ)).hom.app P) := by
    have := hfin 1
    refine (bijective_map_shift_iff_injective_or_surjective k F eP eP 1).2 (Or.inl ?_)
    change Function.Injective (mapShiftLinearMap k F P P 1)
    rw [injective_iff_map_eq_zero]
    exact eq_zero_of_map_shift_one_eq_zero hX F hlin hfix x hx
  have := hfin i
  change Function.Bijective (fun f : P ⟶ P⟦i⟧ => F.map f ≫ (F.commShiftIso i).hom.app P)
  rcases (show i = 0 ∨ i = 1 ∨ 1 < i by omega) with rfl | rfl | hi1
  · -- degree zero: nonzero endomorphisms are isomorphisms
    exact (bijective_map_shift_iff_injective_or_surjective k F eP eP 0).2 (Or.inl
      (injective_map_shift_zero_of_isIso k F eP (isIso_of_ne_zero_perfectPointSheaf hX x hx)))
  · exact h1
  · -- degrees `≥ 2`: generation by degree one
    refine (bijective_map_shift_iff_injective_or_surjective k F eP eP i).2 (Or.inr ?_)
    have h1' : Function.Surjective (fun f : ShiftedHom P P ((1 : ℕ) : ℤ) => f.map F) := by
      rw [Nat.cast_one]
      exact h1.2
    obtain ⟨n, rfl⟩ : ∃ n : ℕ, i = ((n + 1 : ℕ) : ℤ) := ⟨(i - 1).toNat, by omega⟩
    exact surjective_shiftedHomMap_succ_of_compGenerates F P h1' (fun n =>
      ((compGenerates_pointSheaf X.left x hX n).of_map (A := P) (ObjectProperty.ι _)
        (ObjectProperty.fullyFaithfulι _)).of_iso eP) n

/-- **[Stacks, Tag 0G26].** Let `k` be a field, let `X` be a proper scheme over `k` which is
regular, and let `F : D_perf(𝒪_X) ⥤ D_perf(𝒪_X)` be a `k`-linear exact functor. Assume that for
every coherent `𝒪_X`-module `𝓕` with `dim Supp(𝓕) = 0` there is an isomorphism `𝓕 ≅ F(𝓕)`. Then
`F` is fully faithful.

Here `𝓕` is read in `D_perf(𝒪_X)` placed in degree zero (it is perfect, `X` being regular, and the
hypothesis is asked for every proof of that); the isomorphism is taken in `D(𝒪_X)`, which is the
same as one in the full subcategory `D_perf(𝒪_X)`. "Exact" is a triangulated functor, and
`k`-linearity is for the structure induced by the structure morphism
(`AlgebraicGeometry.modulesLinear`). By [Stacks, Tag 0G25] it suffices that `F` is bijective on
`Ext` between closed-point skyscrapers, which is
`bijective_map_shift_perfectPointSheaf_of_fixes_zeroDimensional`. -/
@[stacks 0G26]
theorem fullyFaithful_of_fixes_zeroDimensional (hX : IsRegular X.left)
    (F : PerfectDerivedCategory X.left ⥤ PerfectDerivedCategory X.left) [F.CommShift ℤ]
    [F.IsTriangulated]
    (hlin : letI : Linear k X.left.Modules := modulesLinear k X; F.Linear k)
    (hfix : ∀ (𝓕 : X.left.Modules), 𝓕.IsCoherent →
      topologicalKrullDim (SheafOfModules.supp 𝓕) = 0 →
      ∀ h𝓕 : IsPerfect (X := X.left.toRingedSpace)
          ((DerivedCategory.singleFunctor X.left.Modules 0).obj 𝓕),
        Nonempty ((F.obj ⟨_, h𝓕⟩).obj ≅ (DerivedCategory.singleFunctor X.left.Modules 0).obj 𝓕)) :
    Nonempty F.FullyFaithful := by
  let : Linear k X.left.Modules := modulesLinear k X
  have : F.Linear k := hlin
  exact (fullyFaithful_iff_bijective_ext_perfectPointSheaf X X hX F).2
    (bijective_map_shift_perfectPointSheaf_of_fixes_zeroDimensional hX F hlin hfix)

end Field

