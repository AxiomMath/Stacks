/-! ### Shifted morphisms: comparing a functor with an isomorphic copy -/

section Comparison

variable {C : Type*} [Category* C] [HasShift C ℤ]

/-- If `A ≅ F(A)`, `B ≅ F(B)` and `Hom(A, B[i])` is a singleton, the map induced by `F` on
`Hom(A, B[i])` is bijective. -/
theorem bijective_map_shift_of_subsingleton (F : C ⥤ C) [F.CommShift ℤ] {A B : C}
    (eA : A ≅ F.obj A) (eB : B ≅ F.obj B) (i : ℤ) [Subsingleton (A ⟶ B⟦i⟧)]
    [Nonempty (A ⟶ B⟦i⟧)] :
    Function.Bijective (fun f : A ⟶ B⟦i⟧ => F.map f ≫ (F.commShiftIso i).hom.app B) := by
  have hS : Subsingleton (F.obj A ⟶ (F.obj B)⟦i⟧) :=
    (Iso.homCongr eA ((shiftFunctor C i).mapIso eB)).symm.injective.subsingleton
  exact ⟨fun _ _ _ => Subsingleton.elim _ _, fun f =>
    ⟨Classical.choice inferInstance, hS.elim _ _⟩⟩

variable (k : Type*) [Field k] [Preadditive C] [Linear k C]

/-- The `k`-linear map `Hom(A, B[i]) ⟶ Hom(F A, (F B)[i])` induced by a `k`-linear functor
commuting with the shift. -/
def mapShiftLinearMap {D : Type*} [Category* D] [Preadditive D] [Linear k D] [HasShift D ℤ]
    (F : C ⥤ D) [F.Additive] [F.Linear k] [F.CommShift ℤ] (A B : C) (i : ℤ) :
    (A ⟶ B⟦i⟧) →ₗ[k] (F.obj A ⟶ (F.obj B)⟦i⟧) :=
  (Linear.rightComp k _ ((F.commShiftIso i).hom.app B)).comp (F.mapLinearMap k)

/-- `mapShiftLinearMap k F A B i` sends `f` to `F.map f` followed by the commutation of `F` with
the shift. -/
@[simp]
theorem mapShiftLinearMap_apply {D : Type*} [Category* D] [Preadditive D] [Linear k D]
    [HasShift D ℤ] (F : C ⥤ D) [F.Additive] [F.Linear k] [F.CommShift ℤ] (A B : C) (i : ℤ)
    (f : A ⟶ B⟦i⟧) : mapShiftLinearMap k F A B i f = F.map f ≫ (F.commShiftIso i).hom.app B :=
  rfl

/-- If `A ≅ F(A)`, `B ≅ F(B)` and `Hom(A, B[i])` is finite-dimensional, the map induced by a
`k`-linear `F` on `Hom(A, B[i])` is bijective as soon as it is injective or surjective. -/
theorem bijective_map_shift_iff_injective_or_surjective (F : C ⥤ C) [F.Additive] [F.Linear k]
    [F.CommShift ℤ] {A B : C} (eA : A ≅ F.obj A) (eB : B ≅ F.obj B) (i : ℤ)
    [FiniteDimensional k (A ⟶ B⟦i⟧)] :
    Function.Bijective (fun f : A ⟶ B⟦i⟧ => F.map f ≫ (F.commShiftIso i).hom.app B) ↔
      Function.Injective (fun f : A ⟶ B⟦i⟧ => F.map f ≫ (F.commShiftIso i).hom.app B) ∨
        Function.Surjective (fun f : A ⟶ B⟦i⟧ => F.map f ≫ (F.commShiftIso i).hom.app B) := by
  let e := Linear.homCongr k eA ((shiftFunctor C i).mapIso eB)
  have : FiniteDimensional k (F.obj A ⟶ (F.obj B)⟦i⟧) := Module.Finite.equiv e
  have h := LinearMap.injective_iff_surjective_of_finrank_eq_finrank e.finrank_eq
    (f := mapShiftLinearMap k F A B i)
  exact ⟨fun h => Or.inl h.1, fun h' => h'.elim
    (fun hg => ⟨hg, h.mp hg⟩) (fun hg => ⟨h.mpr hg, hg⟩)⟩

/-- If `P ≅ F(P)` and every nonzero endomorphism of `P` is an isomorphism, the map induced by a
`k`-linear `F` on `Hom(P, P[0])` is injective. -/
private theorem injective_map_shift_zero_of_isIso (F : C ⥤ C) [F.Additive] [F.Linear k]
    [F.CommShift ℤ] {P : C} (eP : P ≅ F.obj P) (hP : ∀ f : P ⟶ P, f ≠ 0 → IsIso f) :
    Function.Injective
      (fun f : P ⟶ P⟦(0 : ℤ)⟧ => F.map f ≫ (F.commShiftIso (0 : ℤ)).hom.app P) := by
  change Function.Injective (mapShiftLinearMap k F P P 0)
  rw [injective_iff_map_eq_zero]
  intro f hf
  by_contra hne
  let g := f ≫ (shiftFunctorZero C ℤ).hom.app P
  have hg : g ≠ 0 := fun h => hne (by
    simpa [g] using congrArg (· ≫ (shiftFunctorZero C ℤ).inv.app P) h)
  have := hP g hg
  have hFf : F.map f = 0 := (Preadditive.IsIso.comp_right_eq_zero _ _).mp hf
  have hFg : F.map g = 0 := by simp [g, hFf]
  have : IsIso (0 : F.obj P ⟶ F.obj P) := hFg ▸ (inferInstance : IsIso (F.map g))
  have hFP : IsZero (F.obj P) := (IsZero.iff_id_eq_zero _).2 (by
    rw [← IsIso.hom_inv_id (0 : F.obj P ⟶ F.obj P), Limits.zero_comp])
  exact hg ((hFP.of_iso eP).eq_of_src _ _)

end Comparison

/-! ### The dimension test for the third morphism of a triangle -/

section Triangle

variable (k : Type*) [Field k] {C : Type*} [Category* C] [Preadditive C] [Linear k C]
  [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]

/-- **The third morphism of a distinguished triangle vanishes exactly when the dimensions of the
Hom spaces out of its third object add up**: `T.mor₃ = 0` if and only if
`dim Hom(T₃, T₂) = dim Hom(T₃, T₁) + dim Hom(T₃, T₃)`. -/
theorem mor₃_eq_zero_iff_finrank (T : Triangle C) (hT : T ∈ distTriang C)
    [FiniteDimensional k (T.obj₃ ⟶ T.obj₁)] [FiniteDimensional k (T.obj₃ ⟶ T.obj₂)]
    [FiniteDimensional k (T.obj₃ ⟶ T.obj₃)] :
    T.mor₃ = 0 ↔ Module.finrank k (T.obj₃ ⟶ T.obj₂) =
      Module.finrank k (T.obj₃ ⟶ T.obj₁) + Module.finrank k (T.obj₃ ⟶ T.obj₃) := by
  let a := Linear.rightComp k T.obj₃ T.mor₁
  let b := Linear.rightComp k T.obj₃ T.mor₂
  have hex : LinearMap.ker b = LinearMap.range a := by
    ext f
    constructor
    · intro hf
      obtain ⟨g, hg⟩ := T.coyoneda_exact₂ hT f hf
      exact ⟨g, hg.symm⟩
    · rintro ⟨g, rfl⟩
      change (g ≫ T.mor₁) ≫ T.mor₂ = 0
      rw [Category.assoc, comp_distTriang_mor_zero₁₂ T hT, comp_zero]
  have hn := b.finrank_range_add_finrank_ker
  rw [hex] at hn
  constructor
  · intro h
    have : Mono T.mor₁ := T.mono₁ hT h
    have ha : Function.Injective a := fun _ _ h => (cancel_mono T.mor₁).mp h
    have hb : Function.Surjective b := by
      intro f
      obtain ⟨g, hg⟩ := T.coyoneda_exact₃ hT f (by rw [h, comp_zero])
      exact ⟨g, hg.symm⟩
    rw [LinearMap.finrank_range_of_inj ha, LinearMap.range_eq_top.mpr hb, finrank_top] at hn
    omega
  · intro h
    have ha := a.finrank_range_le
    have hr : Module.finrank k (LinearMap.range b) = Module.finrank k (T.obj₃ ⟶ T.obj₃) := by
      have := Submodule.finrank_le (LinearMap.range b)
      omega
    obtain ⟨g, hg⟩ := LinearMap.range_eq_top.mp (Submodule.eq_top_of_finrank_eq hr) (𝟙 T.obj₃)
    calc T.mor₃ = (g ≫ T.mor₂) ≫ T.mor₃ := by
          rw [show g ≫ T.mor₂ = 𝟙 T.obj₃ from hg, Category.id_comp]
      _ = 0 := by rw [Category.assoc, comp_distTriang_mor_zero₂₃ T hT, comp_zero]

/-- **An exact functor preserving the objects of a triangle up to isomorphism does not kill its
third morphism**, the Hom spaces out of the third object being finite-dimensional. -/
theorem map_mor₃_ne_zero_of_iso (F : C ⥤ C) [F.CommShift ℤ] [F.IsTriangulated]
    (T : Triangle C) (hT : T ∈ distTriang C) (e₁ : T.obj₁ ≅ F.obj T.obj₁)
    (e₂ : T.obj₂ ≅ F.obj T.obj₂) (e₃ : T.obj₃ ≅ F.obj T.obj₃)
    [FiniteDimensional k (T.obj₃ ⟶ T.obj₁)] [FiniteDimensional k (T.obj₃ ⟶ T.obj₂)]
    [FiniteDimensional k (T.obj₃ ⟶ T.obj₃)] (h : T.mor₃ ≠ 0) :
    (F.mapTriangle.obj T).mor₃ ≠ 0 := by
  let l₁ := Linear.homCongr k e₃ e₁
  let l₂ := Linear.homCongr k e₃ e₂
  let l₃ := Linear.homCongr k e₃ e₃
  have : FiniteDimensional k ((F.mapTriangle.obj T).obj₃ ⟶ (F.mapTriangle.obj T).obj₁) :=
    Module.Finite.equiv l₁
  have : FiniteDimensional k ((F.mapTriangle.obj T).obj₃ ⟶ (F.mapTriangle.obj T).obj₂) :=
    Module.Finite.equiv l₂
  have : FiniteDimensional k ((F.mapTriangle.obj T).obj₃ ⟶ (F.mapTriangle.obj T).obj₃) :=
    Module.Finite.equiv l₃
  refine fun hz => h ((mor₃_eq_zero_iff_finrank k T hT).mpr ?_)
  have he := (mor₃_eq_zero_iff_finrank k (F.mapTriangle.obj T) (F.map_distinguished T hT)).mp hz
  change Module.finrank k (F.obj T.obj₃ ⟶ F.obj T.obj₂) =
    Module.finrank k (F.obj T.obj₃ ⟶ F.obj T.obj₁) +
      Module.finrank k (F.obj T.obj₃ ⟶ F.obj T.obj₃) at he
  rwa [← l₁.finrank_eq, ← l₂.finrank_eq, ← l₃.finrank_eq] at he

end Triangle

/-! ### Generation of self-`Ext` by degree one, transported -/

section Generation

variable {C : Type*} [Category* C] [Preadditive C] [HasShift C ℤ]

/-- `Hom(A, A[a]) × Hom(A, A[b])` composes to `Hom(A, A[c])` generating it as an abelian
group. -/
def CompGenerates (A : C) (a b c : ℤ) (h : b + a = c) : Prop :=
  AddSubgroup.closure (Set.range (fun p : ShiftedHom A A a × ShiftedHom A A b =>
    p.1.comp p.2 h)) = ⊤

/-- The additive map on shifted morphisms induced by an additive functor commuting with the
shift. -/
def shiftedHomMapAddHom {D : Type*} [Category* D] [Preadditive D] [HasShift D ℤ] (G : C ⥤ D)
    [G.Additive] [G.CommShift ℤ] (A B : C) (n : ℤ) :
    ShiftedHom A B n →+ ShiftedHom (G.obj A) (G.obj B) n :=
  AddMonoidHom.mk' (fun f => f.map G) (fun f g => by
    simp [ShiftedHom.map, Preadditive.add_comp])

/-- `shiftedHomMapAddHom G A B n` sends `f` to `f.map G`. -/
theorem shiftedHomMapAddHom_apply {D : Type*} [Category* D] [Preadditive D] [HasShift D ℤ]
    (G : C ⥤ D) [G.Additive] [G.CommShift ℤ] (A B : C) (n : ℤ) (f : ShiftedHom A B n) :
    shiftedHomMapAddHom G A B n f = f.map G :=
  rfl

/-- `CompGenerates` transports along additive maps `ShiftedHom A A n ⟶ ShiftedHom B B n` that
are compatible with composition and surjective in degree `c`. -/
private theorem compGenerates_of_surjective_comp {D : Type*} [Category* D] [Preadditive D]
    [HasShift D ℤ] {A : C} {B : D} {a b c : ℤ} {h : b + a = c}
    (Φ : ∀ n, ShiftedHom A A n →+ ShiftedHom B B n)
    (hΦ : ∀ (f : ShiftedHom A A a) (g : ShiftedHom A A b),
      Φ c (f.comp g h) = (Φ a f).comp (Φ b g) h)
    (hs : Function.Surjective (Φ c)) (hgen : CompGenerates A a b c h) :
    CompGenerates B a b c h := by
  rw [CompGenerates, eq_top_iff, ← AddMonoidHom.range_eq_top.mpr hs, AddMonoidHom.range_eq_map,
    ← show AddSubgroup.closure _ = ⊤ from hgen, AddMonoidHom.map_closure, AddSubgroup.closure_le]
  rintro _ ⟨_, ⟨⟨f, g⟩, rfl⟩, rfl⟩
  exact AddSubgroup.subset_closure ⟨⟨Φ a f, Φ b g⟩, (hΦ f g).symm⟩

omit [Preadditive C] in
/-- A fully faithful functor commuting with the shift induces bijections
`ShiftedHom A B n ⟶ ShiftedHom (G A) (G B) n`. -/
theorem bijective_shiftedHomMap_of_fullyFaithful {D : Type*} [Category* D] [HasShift D ℤ]
    (G : C ⥤ D) (hG : G.FullyFaithful) [G.CommShift ℤ] (A B : C) (n : ℤ) :
    Function.Bijective (fun f : ShiftedHom A B n => f.map G) :=
  ((G.commShiftIso n).app B).homToEquiv.bijective.comp (hG.map_bijective A (B⟦n⟧))

variable [∀ n : ℤ, (shiftFunctor C n).Additive]

omit [∀ (n : ℤ), (shiftFunctor C n).Additive] in
/-- **Surjectivity propagates along a generating composition**: if `G` is surjective on
`Hom(A, A[a])` and on `Hom(A, A[b])`, and the composites generate `Hom(GA, GA[c])`, then `G` is
surjective on `Hom(A, A[c])`. -/
theorem surjective_shiftedHomMap_of_compGenerates {D : Type*} [Category* D] [Preadditive D]
    [HasShift D ℤ] (G : C ⥤ D) [G.Additive] [G.CommShift ℤ] (A : C) (a b c : ℤ) (h : b + a = c)
    (ha : Function.Surjective (fun f : ShiftedHom A A a => f.map G))
    (hb : Function.Surjective (fun f : ShiftedHom A A b => f.map G))
    (hgen : CompGenerates (G.obj A) a b c h) :
    Function.Surjective (fun f : ShiftedHom A A c => f.map G) := by
  change Function.Surjective (shiftedHomMapAddHom G A A c)
  rw [← AddMonoidHom.range_eq_top, eq_top_iff, ← hgen, AddSubgroup.closure_le]
  rintro _ ⟨⟨f, g⟩, rfl⟩
  obtain ⟨f', rfl⟩ := ha f
  obtain ⟨g', rfl⟩ := hb g
  exact ⟨f'.comp g' h, ShiftedHom.map_comp f' g' h G⟩

omit [∀ (n : ℤ), (shiftFunctor C n).Additive] in
/-- **Surjectivity in degree one propagates to every positive degree** when `Hom(GA, GA[1+n])` is
generated by the composites of `Hom(GA, GA[1])` and `Hom(GA, GA[n])` for all `n`. -/
private theorem surjective_shiftedHomMap_succ_of_compGenerates {D : Type*} [Category* D]
    [Preadditive D] [HasShift D ℤ] (G : C ⥤ D) [G.Additive] [G.CommShift ℤ] (A : C)
    (h1 : Function.Surjective (fun f : ShiftedHom A A ((1 : ℕ) : ℤ) => f.map G))
    (hgen : ∀ n : ℕ,
      CompGenerates (G.obj A) ((1 : ℕ) : ℤ) (n : ℤ) ((1 + n : ℕ) : ℤ) (by omega)) (n : ℕ) :
    Function.Surjective (fun f : ShiftedHom A A ((n + 1 : ℕ) : ℤ) => f.map G) := by
  induction n with
  | zero =>
    rw [show ((0 + 1 : ℕ) : ℤ) = ((1 : ℕ) : ℤ) by norm_num]
    exact h1
  | succ n ih =>
    rw [show ((n + 1 + 1 : ℕ) : ℤ) = ((1 + (n + 1) : ℕ) : ℤ) by omega]
    exact surjective_shiftedHomMap_of_compGenerates G A ((1 : ℕ) : ℤ) ((n + 1 : ℕ) : ℤ)
      ((1 + (n + 1) : ℕ) : ℤ) (by omega) h1 ih (hgen (n + 1))

omit [∀ (n : ℤ), (shiftFunctor C n).Additive] in
/-- `CompGenerates` is invariant under isomorphism. -/
theorem CompGenerates.of_iso {A B : C} (e : A ≅ B) {a b c : ℤ} {h : b + a = c}
    (hgen : CompGenerates A a b c h) : CompGenerates B a b c h := by
  let E (n : ℤ) : ShiftedHom A A n ≃+ ShiftedHom B B n :=
    AddEquiv.mk' (Iso.homCongr e ((shiftFunctor C n).mapIso e)) (fun f g => by
      simp [Iso.homCongr_apply, Preadditive.add_comp, Preadditive.comp_add])
  have hE : ∀ (f : ShiftedHom A A a) (g : ShiftedHom A A b),
      E c (f.comp g h) = (E a f).comp (E b g) h := by
    intro f g
    change (Iso.homCongr e ((shiftFunctor C c).mapIso e)) (f.comp g h) =
      ShiftedHom.comp (Iso.homCongr e ((shiftFunctor C a).mapIso e) f)
        (Iso.homCongr e ((shiftFunctor C b).mapIso e) g) h
    simp only [Iso.homCongr_apply, Functor.mapIso_hom, ShiftedHom.comp, Functor.map_comp,
      Category.assoc]
    rw [← (shiftFunctor C a).map_comp_assoc, e.hom_inv_id, CategoryTheory.Functor.map_id,
      Category.id_comp, ← NatTrans.naturality (shiftFunctorAdd' C b a c h).inv e.hom]
    rfl
  exact compGenerates_of_surjective_comp (fun n => (E n).toAddMonoidHom) hE (E c).surjective hgen

variable {D : Type*} [Category* D] [Preadditive D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive]

omit [∀ (n : ℤ), (shiftFunctor C n).Additive] [∀ (n : ℤ), (shiftFunctor D n).Additive] in
/-- `CompGenerates` transported forward along a fully faithful additive functor commuting with
the shift. -/
theorem CompGenerates.map (G : C ⥤ D) (hG : G.FullyFaithful) [G.Additive] [G.CommShift ℤ]
    {A : C} {a b c : ℤ} {h : b + a = c} (hgen : CompGenerates A a b c h) :
    CompGenerates (G.obj A) a b c h := by
  exact compGenerates_of_surjective_comp (shiftedHomMapAddHom G A A)
    (fun f g => ShiftedHom.map_comp f g h G)
    (bijective_shiftedHomMap_of_fullyFaithful G hG A A c).2 hgen

omit [∀ (n : ℤ), (shiftFunctor C n).Additive] [∀ (n : ℤ), (shiftFunctor D n).Additive] in
/-- `CompGenerates` transported backward along a fully faithful additive functor commuting with
the shift. -/
theorem CompGenerates.of_map (G : C ⥤ D) (hG : G.FullyFaithful) [G.Additive] [G.CommShift ℤ]
    {A : C} {a b c : ℤ} {h : b + a = c} (hgen : CompGenerates (G.obj A) a b c h) :
    CompGenerates A a b c h := by
  have hbij : ∀ n, Function.Bijective (shiftedHomMapAddHom G A A n) :=
    fun n => bijective_shiftedHomMap_of_fullyFaithful G hG A A n
  let E (n : ℤ) := AddEquiv.ofBijective _ (hbij n)
  refine compGenerates_of_surjective_comp (fun n => (E n).symm.toAddMonoidHom) (fun f g => ?_)
    (E c).symm.surjective hgen
  obtain ⟨f', rfl⟩ := (E a).surjective f
  obtain ⟨g', rfl⟩ := (E b).surjective g
  simp only [AddEquiv.coe_toAddMonoidHom, AddEquiv.symm_apply_apply, AddEquiv.symm_apply_eq]
  exact (ShiftedHom.map_comp f' g' h G).symm

end Generation

/-- **From `Ext` to shifted morphisms**: generation of `Ext^{a+b}(M, M)` by Yoneda composites
gives generation of `Hom(M, M[a+b])` in the derived category. -/
theorem compGenerates_singleFunctor_of_closure_ext {C : Type*} [Category* C] [Abelian C]
    [HasDerivedCategory C] [HasExt C] (M : C) (a b : ℕ)
    (hgen : AddSubgroup.closure (Set.range (fun p :
      Abelian.Ext M M a × Abelian.Ext M M b => p.1.comp p.2 rfl)) = ⊤) :
    CompGenerates ((DerivedCategory.singleFunctor C 0).obj M) (a : ℤ) (b : ℤ) ((a + b : ℕ) : ℤ)
      (by omega) := by
  let A := (DerivedCategory.singleFunctor C 0).obj M
  let S := AddSubgroup.closure (Set.range (fun p : ShiftedHom A A (a : ℤ) ×
      ShiftedHom A A (b : ℤ) =>
    p.1.comp p.2 (show (b : ℤ) + a = ((a + b : ℕ) : ℤ) by omega)))
  apply top_unique
  intro z hz
  clear hz
  obtain ⟨z, rfl⟩ := (Abelian.Ext.homAddEquiv (X := M) (Y := M) (n := a + b)).surjective z
  have hz : z ∈ AddSubgroup.closure (Set.range (fun p :
      Abelian.Ext M M a × Abelian.Ext M M b => p.1.comp p.2 rfl)) := by
    rw [hgen]
    trivial
  change Abelian.Ext.homAddEquiv z ∈ S
  induction hz using AddSubgroup.closure_induction with
  | mem z hz =>
    obtain ⟨⟨f, g⟩, rfl⟩ := hz
    change (f.comp g rfl).hom ∈ S
    rw [Abelian.Ext.comp_hom]
    exact AddSubgroup.subset_closure ⟨⟨f.hom, g.hom⟩, rfl⟩
  | zero => simpa only [map_zero] using S.zero_mem
  | add x y _ _ hx hy => simpa only [map_add] using S.add_mem hx hy
  | neg x _ hx => simpa only [map_neg] using S.neg_mem hx

/-- In the derived category, there are no nonzero morphisms from an object placed in degree zero
to a negative shift of another. -/
theorem subsingleton_hom_singleFunctor_shift_of_neg {C : Type*} [Category* C] [Abelian C]
    [HasDerivedCategory C] (M N : C) (i : ℤ) (hi : i < 0) :
    Subsingleton ((DerivedCategory.singleFunctor C 0).obj M ⟶
      ((DerivedCategory.singleFunctor C 0).obj N)⟦i⟧) := by
  have : (((DerivedCategory.singleFunctor C 0).obj N)⟦i⟧).IsGE (-i) :=
    DerivedCategory.TStructure.t.isGE_shift _ 0 i (-i) (by omega)
  exact ⟨fun f g => (DerivedCategory.TStructure.t.zero f 0 (-i) (by omega)).trans
    (DerivedCategory.TStructure.t.zero g 0 (-i) (by omega)).symm⟩

/-! ### Nonzero endomorphisms that are isomorphisms -/

section Simple

/-- Every nonzero endomorphism of `G(A)` is an isomorphism if this holds for `A` and `G` is fully
faithful. -/
theorem isIso_of_ne_zero_of_fullyFaithful {C D : Type*} [Category* C] [Category* D]
    [Preadditive C] [Preadditive D] (G : C ⥤ D) (hG : G.FullyFaithful) [G.Additive] (A : C)
    (hA : ∀ f : A ⟶ A, f ≠ 0 → IsIso f) (g : G.obj A ⟶ G.obj A) (hg : g ≠ 0) : IsIso g := by
  have := hG.full
  have := hG.faithful
  rw [← hG.map_preimage g]
  refine @Functor.map_isIso _ _ _ _ _ _ G _ (hA _ fun h => hg ?_)
  rw [← hG.map_preimage g, h, G.map_zero]

/-- Every nonzero endomorphism of `B ≅ A` is an isomorphism if this holds for `A`. -/
theorem isIso_of_ne_zero_of_iso {C : Type*} [Category* C] [Preadditive C] {A B : C} (e : A ≅ B)
    (hA : ∀ f : A ⟶ A, f ≠ 0 → IsIso f) (g : B ⟶ B) (hg : g ≠ 0) : IsIso g := by
  have h : IsIso (e.hom ≫ g ≫ e.inv) := hA _ fun h => hg (by
    simpa using congrArg (fun t => e.inv ≫ t ≫ e.hom) h)
  rw [show g = e.inv ≫ (e.hom ≫ g ≫ e.inv) ≫ e.hom by simp]
  infer_instance

/-- The residue field of a local ring, as a module over it, is a quotient of the ring by the
maximal ideal. -/
def quotientLinearEquivResidueField (R : Type u) [CommRing R] [IsLocalRing R] :
    (R ⧸ IsLocalRing.maximalIdeal R) ≃ₗ[R] (IsLocalRing.maximalIdeal R).ResidueField :=
  LinearEquiv.ofBijective
    (IsScalarTower.toAlgHom R (R ⧸ IsLocalRing.maximalIdeal R)
      (IsLocalRing.maximalIdeal R).ResidueField).toLinearMap
    (IsLocalRing.maximalIdeal R).bijective_algebraMap_quotient_residueField

/-- The residue field of a local ring `R` is a simple `R`-module. -/
instance isSimpleModule_residueField (R : Type u) [CommRing R] [IsLocalRing R] :
    IsSimpleModule R (IsLocalRing.maximalIdeal R).ResidueField := by
  have : IsSimpleModule R (R ⧸ IsLocalRing.maximalIdeal R) :=
    isSimpleModule_iff_isCoatom.mpr (Ideal.isMaximal_def.mp inferInstance)
  exact IsSimpleModule.congr (quotientLinearEquivResidueField R).symm

/-- **Every nonzero endomorphism of the residue field placed in degree zero is an isomorphism**,
the residue field being a simple module. -/
theorem isIso_of_ne_zero_singleFunctor_residueField (R : Type u) [CommRing R] [IsLocalRing R]
    (f : (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
        (residueFieldModuleCat (IsLocalRing.maximalIdeal R)) ⟶
      (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
        (residueFieldModuleCat (IsLocalRing.maximalIdeal R)))
    (hf : f ≠ 0) : IsIso f := by
  refine isIso_of_ne_zero_of_fullyFaithful (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0)
    (Functor.FullyFaithful.ofFullyFaithful _) _ (fun g hg => ?_) f hf
  have hg' : g.hom ≠ 0 := fun h => hg (ModuleCat.hom_ext h)
  have : IsSimpleModule R (residueFieldModuleCat (IsLocalRing.maximalIdeal R)) :=
    isSimpleModule_residueField R
  rw [ConcreteCategory.isIso_iff_bijective]
  exact LinearMap.bijective_of_ne_zero hg'

/-- **Over a regular local ring, `Hom(κ, κ[1+n])` in the derived category is generated by the
composites of `Hom(κ, κ[1])` and `Hom(κ, κ[n])`.** -/
theorem compGenerates_singleFunctor_residueField (R : Type u) [CommRing R] [IsRegularLocalRing R]
    (n : ℕ) :
    CompGenerates ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
        (residueFieldModuleCat (IsLocalRing.maximalIdeal R))) ((1 : ℕ) : ℤ) (n : ℤ)
      ((1 + n : ℕ) : ℤ) (by omega) := by
  let : HasExt (ModuleCat.{u} R) := hasExt_of_hasDerivedCategory _
  exact (compGenerates_singleFunctor_of_closure_ext _ 1 n
    (IsRegularLocalRing.closure_range_ext_comp_residueField_eq_top R n)).of_iso
    ((DerivedCategory.singleFunctor _ 0).mapIso (quotientLinearEquivResidueField R).toModuleIso)

end Simple

/-! ### `Ext` between closed-point skyscrapers -/

section PointSheaf

variable (X : Scheme.{u}) (x : X)

/-- The derived skyscraper at `x` is fully faithful: the counit of the derived stalk-skyscraper
adjunction is an isomorphism. -/
def derivedSkyscraperFullyFaithful :
    (SheafOfModules.skyscraperFunctor X.ringCatSheaf x).mapDerivedCategory.FullyFaithful :=
  haveI := isIso_derivedStalkAdjunction_counit X x
  (derivedStalkAdjunction X x).fullyFaithfulROfIsIsoCounit

/-- `𝒪_x` is the derived skyscraper of `κ(x)`. -/
def derivedSkyscraperResidueFieldIso :
    (SheafOfModules.skyscraperFunctor X.ringCatSheaf x).mapDerivedCategory.obj
        ((DerivedCategory.singleFunctor _ 0).obj (residueFieldStalkModule X x)) ≅
      pointSheaf X x :=
  ((SheafOfModules.skyscraperFunctor X.ringCatSheaf x).mapDerivedCategorySingleFunctor 0).app
    (residueFieldStalkModule X x)

/-- **Distinct closed points have orthogonal skyscrapers**: `Hom(𝒪_x, 𝒪_{x'}[i]) = 0` for
`x ≠ x'`, `x` closed. -/
theorem subsingleton_hom_pointSheaf_shift_of_ne (hx : IsClosed ({x} : Set X)) {x' : X}
    (hxx' : x ≠ x') (i : ℤ) : Subsingleton (pointSheaf X x ⟶ (pointSheaf X x')⟦i⟧) := by
  have h := isZero_derivedStalk_pointSheaf_of_ne X x hx (Ne.symm hxx')
  have : Subsingleton ((derivedStalk X x').obj (pointSheaf X x) ⟶
      ((DerivedCategory.singleFunctor _ 0).obj (residueFieldStalkModule X x'))⟦i⟧) :=
    ⟨fun a b => h.eq_of_src a b⟩
  exact (homPointSheafShiftEquiv X x' (pointSheaf X x) i).injective.subsingleton

/-- **Every nonzero endomorphism of `𝒪_x` is an isomorphism.** -/
theorem isIso_of_ne_zero_pointSheaf (f : pointSheaf X x ⟶ pointSheaf X x) (hf : f ≠ 0) :
    IsIso f :=
  isIso_of_ne_zero_of_iso (derivedSkyscraperResidueFieldIso X x)
    (isIso_of_ne_zero_of_fullyFaithful _ (derivedSkyscraperFullyFaithful X x) _
      (isIso_of_ne_zero_singleFunctor_residueField _)) f hf

/-- **On a regular scheme, `Ext^*(𝒪_x, 𝒪_x)` is generated in degree one**: `Hom(𝒪_x, 𝒪_x[1+n])`
is generated by the composites of `Hom(𝒪_x, 𝒪_x[1])` and `Hom(𝒪_x, 𝒪_x[n])`. -/
theorem compGenerates_pointSheaf (hX : IsRegular X) (n : ℕ) :
    CompGenerates (pointSheaf X x) ((1 : ℕ) : ℤ) (n : ℤ) ((1 + n : ℕ) : ℤ) (by omega) := by
  have := isRegularLocalRing_stalkRing X x hX
  exact ((compGenerates_singleFunctor_residueField _ n).map _
    (derivedSkyscraperFullyFaithful X x)).of_iso (derivedSkyscraperResidueFieldIso X x)

/-- **An extension of `𝒪_x` by `𝒪_x` is supported at `x`**: if the middle term of a distinguished
triangle with outer terms `𝒪_x` is a sheaf `M` in degree zero, then `Supp(M) ⊆ {x}`. -/
private theorem supp_subset_of_distTriang_pointSheaf (hx : IsClosed ({x} : Set X))
    (T : Triangle (DerivedCategory X.Modules)) (hT : T ∈ distTriang _)
    (e₁ : T.obj₁ ≅ pointSheaf X x) (e₃ : T.obj₃ ≅ pointSheaf X x) (M : X.Modules)
    (e : T.obj₂ ≅ (DerivedCategory.singleFunctor X.Modules 0).obj M) :
    SheafOfModules.supp M ⊆ {x} := fun y hy => by
  by_contra hyx
  refine (mem_supp_iff_not_isZero_stalkFunctor X M y).1 hy ?_
  have h₂ : IsZero ((derivedStalk X y).obj T.obj₂) :=
    Triangle.isZero₂_of_isZero₁₃ _
      ((SheafOfModules.stalkFunctor X.ringCatSheaf y).mapDerivedCategory.map_distinguished _ hT)
      ((isZero_derivedStalk_pointSheaf_of_ne X x hx hyx).of_iso ((derivedStalk X y).mapIso e₁))
      ((isZero_derivedStalk_pointSheaf_of_ne X x hx hyx).of_iso ((derivedStalk X y).mapIso e₃))
  exact ((DerivedCategory.homologyFunctor _ 0).map_isZero
    (h₂.of_iso ((derivedStalk X y).mapIso e.symm))).of_iso
    (((DerivedCategory.singleFunctorCompHomologyFunctorIso _ 0).app _).symm ≪≫
      (DerivedCategory.homologyFunctor _ 0).mapIso
        (((SheafOfModules.stalkFunctor X.ringCatSheaf y).mapDerivedCategorySingleFunctor
          0).app M).symm)

end PointSheaf

