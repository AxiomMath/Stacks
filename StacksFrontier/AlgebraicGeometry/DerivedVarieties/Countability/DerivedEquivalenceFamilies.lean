namespace AlgebraicGeometry

attribute [local instance 100000] HasDerivedCategory.standard

/-! ### Proper smooth models over a stage -/

/-- The base change of a pullback square over a stage `i` along a transition `j ⟶ i` is a pullback
square over the stage `j`. -/
private theorem isPullback_lift_snd_of_isPullback {I : Type u} [Category.{u} I]
    (D : I ⥤ Scheme.{u}) (c : Cone D) {X X₁ : Scheme.{u}} {i j : I} (k : j ⟶ i) (f : X ⟶ c.pt)
    {f₁ : X₁ ⟶ D.obj i} (g : X ⟶ X₁) (h : IsPullback g f f₁ (c.π.app i)) :
    IsPullback (pullback.lift g (f ≫ c.π.app j) (by rw [h.w, Category.assoc, c.w k])) f
      (pullback.snd f₁ (D.map k)) (c.π.app j) := by
  refine IsPullback.of_right ?_ (pullback.lift_snd _ _ _) (IsPullback.of_hasPullback _ _)
  rwa [pullback.lift_fst, c.w k]

/-- **A proper smooth morphism to the limit of a cofiltered system of affine schemes is the base
change of a proper smooth morphism to some stage.** The proper flat model of
`AlgebraicGeometry.exists_stage_properFlatModel` ([Stacks, Tag 01ZM] with [Stacks, Tag 081F])
is made smooth at a later stage by [Stacks, Tag 0C0C]. -/
theorem exists_stage_properSmoothModel {I : Type u} [Category.{u} I] [IsCofiltered I]
    (D : I ⥤ Scheme.{u}) [∀ i, IsAffine (D.obj i)] (c : Cone D) (hc : IsLimit c)
    {X : Scheme.{u}} (f : X ⟶ c.pt) [IsProper f] [Smooth f] :
    ∃ (i : I) (Xᵢ : Scheme.{u}) (fᵢ : Xᵢ ⟶ D.obj i) (g : X ⟶ Xᵢ),
      IsProper fᵢ ∧ Smooth fᵢ ∧ IsPullback g f fᵢ (c.π.app i) := by
  obtain ⟨i, X₁, f₁, g₁, hpr₁, hfl₁, hfp₁, hpb₁⟩ :=
    exists_stage_properFlatModel D c hc f ⟨inferInstance, inferInstance, inferInstance⟩
  have : LocallyOfFinitePresentation f₁ := hfp₁.1
  have : QuasiCompact f₁ := hfp₁.2.1
  have : QuasiSeparated f₁ := hfp₁.2.2
  have : CompactSpace X₁ := QuasiCompact.compactSpace_of_compactSpace f₁
  have : QuasiSeparatedSpace X₁ := quasiSeparatedSpace_of_quasiSeparated f₁
  have : ∀ {i j : I} (k : i ⟶ j), IsAffineHom (D.map k) := fun _ => inferInstance
  have : MorphismProperty.RespectsIso (@Smooth.{u}) :=
    MorphismProperty.IsStableUnderBaseChange.respectsIso
  let X₀ : Over (D.obj i) := Over.mk f₁
  let Y₀ : Over (D.obj i) := Over.mk (𝟙 (D.obj i))
  let a : X₀ ⟶ Y₀ := Over.homMk f₁ (Category.comp_id f₁)
  have : CompactSpace X₀.left := inferInstanceAs (CompactSpace X₁)
  have : QuasiSeparatedSpace X₀.left := inferInstanceAs (QuasiSeparatedSpace X₁)
  have : CompactSpace Y₀.left := inferInstanceAs (CompactSpace (D.obj i))
  have : QuasiSeparatedSpace Y₀.left := inferInstanceAs (QuasiSeparatedSpace (D.obj i))
  have : LocallyOfFinitePresentation a.left := inferInstanceAs (LocallyOfFinitePresentation f₁)
  have key : ∀ {T : Scheme.{u}} (b : T ⟶ D.obj i),
      Smooth ((Over.pullback b).map a).left ↔ Smooth (pullback.snd f₁ b) := by
    intro T b
    have hw : ((Over.pullback b).map a).left ≫ pullback.snd (𝟙 (D.obj i)) b =
        pullback.snd f₁ b := Over.w ((Over.pullback b).map a)
    rw [← hw]
    exact (MorphismProperty.cancel_right_of_respectsIso (@Smooth.{u}) _ _).symm
  have hsm : Smooth ((Over.pullback (c.π.app i)).map a).left := by
    rw [key, ← MorphismProperty.cancel_left_of_respectsIso (@Smooth.{u}) hpb₁.isoPullback.hom,
      hpb₁.isoPullback_hom_snd]
    exact ‹Smooth f›
  obtain ⟨j, k, hj⟩ := exists_smooth_baseChange_of_smooth_limitBaseChange D c i X₀ Y₀ a hc
  rw [key] at hj
  have hsq : IsPullback (pullback.fst f₁ (D.map k)) (pullback.snd f₁ (D.map k)) f₁ (D.map k) :=
    IsPullback.of_hasPullback f₁ (D.map k)
  exact ⟨j, pullback f₁ (D.map k), pullback.snd f₁ (D.map k), _,
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @IsProper) hsq hpr₁, hj,
    isPullback_lift_snd_of_isPullback D c k f g₁ hpb₁⟩

/-- A property stable under base change passes from `f` to `pullback.snd f g`. -/
lemma bc {P : MorphismProperty Scheme.{u}} [P.IsStableUnderBaseChange] {X Y S : Scheme.{u}}
    (f : X ⟶ S) (g : Y ⟶ S) (hf : P f) : P (pullback.snd f g) :=
  MorphismProperty.IsStableUnderBaseChange.of_isPullback (IsPullback.of_hasPullback f g) hf

/-- **Two proper smooth morphisms to the limit of a cofiltered system of affine schemes are base
changes of proper smooth morphisms to one common stage.** -/
theorem exists_common_stage_properSmoothModels {I : Type u} [Category.{u} I] [IsCofiltered I]
    (D : I ⥤ Scheme.{u}) [∀ i, IsAffine (D.obj i)] (c : Cone D) (hc : IsLimit c)
    (X Y : Over c.pt) (hXp : IsProper X.hom) (hXs : Smooth X.hom) (hYp : IsProper Y.hom)
    (hYs : Smooth Y.hom) :
    ∃ (j : I) (X₁ : Scheme.{u}) (x : X₁ ⟶ D.obj j) (gX : X.left ⟶ X₁)
      (Y₁ : Scheme.{u}) (y : Y₁ ⟶ D.obj j) (gY : Y.left ⟶ Y₁),
      IsProper x ∧ Smooth x ∧ IsProper y ∧ Smooth y ∧
        IsPullback gX X.hom x (c.π.app j) ∧ IsPullback gY Y.hom y (c.π.app j) := by
  obtain ⟨jX, X₁, x₁, gX, hx₁p, hx₁s, hpbX⟩ := exists_stage_properSmoothModel D c hc X.hom
  obtain ⟨jY, Y₁, y₁, gY, hy₁p, hy₁s, hpbY⟩ := exists_stage_properSmoothModel D c hc Y.hom
  obtain ⟨j, kX, kY, -⟩ := IsCofilteredOrEmpty.cone_objs jX jY
  exact ⟨j, _, _, _, _, _, _, bc (P := @IsProper) _ _ hx₁p, bc (P := @Smooth) _ _ hx₁s,
    bc (P := @IsProper) _ _ hy₁p, bc (P := @Smooth) _ _ hy₁s,
    isPullback_lift_snd_of_isPullback D c kX X.hom gX hpbX,
    isPullback_lift_snd_of_isPullback D c kY Y.hom gY hpbY⟩

/-! ### The stages `Spec ℤ[i]` of `Spec K` -/

/-- A ring of finite type over `ℤ` is countable: it is a quotient of a polynomial ring in finitely
many variables over `ℤ`. -/
theorem countable_of_finiteType_int (A : Type u) [CommRing A] [Algebra.FiniteType ℤ A] :
    Countable A := by
  obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹Algebra.FiniteType ℤ A›
  have : Countable (MvPolynomial (Fin n) ℤ) :=
    show Countable (AddMonoidAlgebra ℤ (Fin n →₀ ℕ)) from inferInstance
  exact hf.countable

section Stages

variable (K : Type u) [CommRing K]

/-- The Noetherian approximation of `Spec K` by the spectra of the subrings `ℤ[i]`, `i ⊂ K`
finite, as a situation of [Stacks, Tag 09RD] with base index `j`. -/
def finsetDescentSituation (j : Finset K) : DescentSituation.{u, u} (Finset K) where
  system := specAdjoinFinsetDiagram K
  transition_affine f := isAffineHom_specAdjoinFinsetDiagram_map K f
  quasiCompact _ := inferInstance
  quasiSeparated _ := inferInstance
  limitCone := specAdjoinFinsetCone K
  isLimit := isLimit_specAdjoinFinsetCone K
  base := j

/-- The bottom ring `ℤ[∅] ⊂ K`, the countable Noetherian base ring of the construction. -/
abbrev bottomRing : Type u := Algebra.adjoin ℤ ((∅ : Finset K) : Set K)

/-- The ring `ℤ[∅] ⊂ K` is countable. -/
instance : Countable (bottomRing K) :=
  have := finiteType_adjoinFinset_int K ∅
  countable_of_finiteType_int _

/-- The ring `ℤ[∅] ⊂ K` is Noetherian. -/
instance : IsNoetherianRing (bottomRing K) := isNoetherianRing_adjoinFinset_int K ∅

/-- The structure morphism `Spec ℤ[i] ⟶ Spec ℤ[∅]` of a stage. -/
def stageToBottom (i : Finset K) :
    (specAdjoinFinsetDiagram K).obj (op i) ⟶ Spec (CommRingCat.of (bottomRing K)) :=
  (specAdjoinFinsetDiagram K).map (homOfLE (Finset.empty_subset i)).op

/-- The morphism `Spec ℤ[i] ⟶ Spec ℤ[∅]` is locally of finite type. -/
instance (i : Finset K) : LocallyOfFiniteType (stageToBottom K i) := by
  have hi := finiteType_adjoinFinset_int K i
  change LocallyOfFiniteType (Spec.map ((Algebra.adjoinFinsetDiagram ℤ K).map
    (homOfLE (Finset.empty_subset i))))
  refine HasRingHomProperty.Spec_iff.mpr ?_
  apply RingHom.FiniteType.of_comp_finiteType
    (f := algebraMap ℤ (Algebra.adjoin ℤ ((∅ : Finset K) : Set K)))
  have he : ((Algebra.adjoinFinsetDiagram ℤ K).map (homOfLE (Finset.empty_subset i))).hom.comp
      (algebraMap ℤ (Algebra.adjoin ℤ ((∅ : Finset K) : Set K))) =
      algebraMap ℤ (Algebra.adjoin ℤ ((i : Finset K) : Set K)) := RingHom.ext_int _ _
  have h := RingHom.finiteType_algebraMap.mpr hi
  rwa [← he] at h

/-- The morphism `Spec ℤ[i] ⟶ Spec ℤ[∅]` is quasi-compact. -/
instance (i : Finset K) : QuasiCompact (stageToBottom K i) :=
  have := isAffineHom_specAdjoinFinsetDiagram_map K (homOfLE (Finset.empty_subset i)).op
  inferInstanceAs (QuasiCompact ((specAdjoinFinsetDiagram K).map
    (homOfLE (Finset.empty_subset i)).op))

/-- The stage maps to the bottom stage commute with the transitions. -/
lemma transition_comp_stageToBottom {i j : Finset K} (h : i ≤ j) :
    (finsetDescentSituation K ∅).transition h ≫ stageToBottom K i = stageToBottom K j := by
  show (specAdjoinFinsetDiagram K).map _ ≫ (specAdjoinFinsetDiagram K).map _ =
    (specAdjoinFinsetDiagram K).map _
  rw [← Functor.map_comp]
  rfl

/-- The morphism `Spec K ⟶ Spec ℤ[∅]`. -/
def pointToBottom : Spec (CommRingCat.of K) ⟶ Spec (CommRingCat.of (bottomRing K)) :=
  (specAdjoinFinsetCone K).π.app (op ∅)

/-- The projection `Spec K ⟶ Spec ℤ[i]` followed by `Spec ℤ[i] ⟶ Spec ℤ[∅]` is
`AlgebraicGeometry.pointToBottom`. -/
lemma projection_comp_stageToBottom (i : Finset K) :
    (specAdjoinFinsetCone K).π.app (op i) ≫ stageToBottom K i = pointToBottom K :=
  (specAdjoinFinsetCone K).w _

end Stages

/-! ### Systems over a base and their isomorphisms -/

/-- A *system* over a scheme `B`: a scheme `S` over `B` with two schemes `X` and `Y` over `S`. -/
structure RelativeSystem (B : Scheme.{u}) where
  /-- The base of the system. -/
  S : Over B
  /-- The first family. -/
  X : Over S.left
  /-- The second family. -/
  Y : Over S.left

namespace RelativeSystem

variable {B : Scheme.{u}}

/-- An isomorphism of systems over `B`. -/
structure Iso (τ τ' : RelativeSystem B) where
  /-- The isomorphism of bases over `B`. -/
  eS : τ.S ≅ τ'.S
  /-- The isomorphism of the first families. -/
  eX : τ.X.left ≅ τ'.X.left
  /-- The isomorphism of the second families. -/
  eY : τ.Y.left ≅ τ'.Y.left
  wX : eX.hom ≫ τ'.X.hom = τ.X.hom ≫ eS.hom.left
  wY : eY.hom ≫ τ'.Y.hom = τ.Y.hom ≫ eS.hom.left

/-- The inverse isomorphism of systems. -/
def Iso.symm {τ τ' : RelativeSystem B} (e : Iso τ τ') : Iso τ' τ where
  eS := e.eS.symm
  eX := e.eX.symm
  eY := e.eY.symm
  wX := by
    change e.eX.inv ≫ τ.X.hom = τ'.X.hom ≫ e.eS.inv.left
    rw [Iso.inv_comp_eq, reassoc_of% e.wX, ← Over.comp_left, Iso.hom_inv_id, Over.id_left,
      Category.comp_id]
  wY := by
    change e.eY.inv ≫ τ.Y.hom = τ'.Y.hom ≫ e.eS.inv.left
    rw [Iso.inv_comp_eq, reassoc_of% e.wY, ← Over.comp_left, Iso.hom_inv_id, Over.id_left,
      Category.comp_id]

/-- The composite of two isomorphisms of systems. -/
def Iso.trans {τ τ' τ'' : RelativeSystem B} (e : Iso τ τ') (e' : Iso τ' τ'') : Iso τ τ'' where
  eS := e.eS ≪≫ e'.eS
  eX := e.eX ≪≫ e'.eX
  eY := e.eY ≪≫ e'.eY
  wX := by
    simp only [Iso.trans_hom, Category.assoc, Over.comp_left, e'.wX, reassoc_of% e.wX]
  wY := by
    simp only [Iso.trans_hom, Category.assoc, Over.comp_left, e'.wY, reassoc_of% e.wY]

/-- A system is *good* if its base is of finite type over `B`, both families are smooth and
proper, and there is a Fourier-Mukai kernel of a relative equivalence from the first to the
second. -/
def IsGood (τ : RelativeSystem B) : Prop :=
  (LocallyOfFiniteType τ.S.hom ∧ QuasiCompact τ.S.hom) ∧
    (Smooth τ.X.hom ∧ IsProper τ.X.hom) ∧ (Smooth τ.Y.hom ∧ IsProper τ.Y.hom) ∧
      ∃ M : DerivedCategory (pullback τ.X.hom τ.Y.hom).Modules,
        IsRelativeEquivalenceKernel τ.X.hom τ.Y.hom M

/-- The base change of a system along a point `p : T ⟶ B`, regarded over `T`. -/
def baseS (τ : RelativeSystem B) {T : Scheme.{u}} (p : T ⟶ B) : Over T :=
  (Over.pullback p).obj τ.S

/-- The first family of the base change of a system. -/
def baseX (τ : RelativeSystem B) {T : Scheme.{u}} (p : T ⟶ B) : Over (τ.baseS p).left :=
  (Over.pullback (pullback.fst τ.S.hom p)).obj τ.X

/-- The second family of the base change of a system. -/
def baseY (τ : RelativeSystem B) {T : Scheme.{u}} (p : T ⟶ B) : Over (τ.baseS p).left :=
  (Over.pullback (pullback.fst τ.S.hom p)).obj τ.Y

/-- **The fibres of the base change of a system at a point coming from an isomorphic system.**
If `e : τ ≅ τ'`, and `p₀ : T ⟶ τ'.S` lies over `p`, then the fibre of the first family of the
base change of `τ` along `p` at the induced section is the base change of `τ'.X` along `p₀`. -/
lemma exists_section_fibre_iso {τ τ' : RelativeSystem B} (e : Iso τ τ') {T : Scheme.{u}}
    (p : T ⟶ B) (p₀ : T ⟶ τ'.S.left) (hp₀ : p₀ ≫ τ'.S.hom = p) :
    ∃ s : Over.mk (𝟙 T) ⟶ τ.baseS p,
      Nonempty ((Over.pullback p₀).obj τ'.X ≅ (Over.pullback s.left).obj (τ.baseX p)) ∧
      Nonempty ((Over.pullback p₀).obj τ'.Y ≅ (Over.pullback s.left).obj (τ.baseY p)) := by
  let q : T ⟶ τ.S.left := p₀ ≫ e.eS.inv.left
  have hq : q ≫ τ.S.hom = p := by
    simp only [q, Category.assoc, Over.w e.eS.inv, hp₀]
  let sl : T ⟶ pullback τ.S.hom p := pullback.lift q (𝟙 T) (by rw [hq, Category.id_comp])
  have hsl : sl ≫ pullback.snd τ.S.hom p = (Over.mk (𝟙 T)).hom := pullback.lift_snd _ _ _
  let s : Over.mk (𝟙 T) ⟶ τ.baseS p := Over.homMk sl hsl
  have hsq : s.left ≫ pullback.fst τ.S.hom p = q := pullback.lift_fst _ _ _
  -- transport of a family along the isomorphism of the two systems
  have transport : ∀ (Z : Over τ.S.left) (Z' : Over τ'.S.left) (eZ : Z.left ≅ Z'.left),
      eZ.hom ≫ Z'.hom = Z.hom ≫ e.eS.hom.left →
      Nonempty ((Over.pullback p₀).obj Z' ≅
        (Over.pullback s.left).obj ((Over.pullback (pullback.fst τ.S.hom p)).obj Z)) := by
    intro Z Z' eZ wZ
    have h₂ : (s.left ≫ pullback.fst τ.S.hom p) ≫ e.eS.hom.left = 𝟙 T ≫ p₀ := by
      rw [hsq]
      simp only [q, Category.assoc, Category.id_comp]
      rw [← Over.comp_left, e.eS.inv_hom_id, Over.id_left, Category.comp_id]
    have hP : IsPullback (pullback.fst Z.hom (s.left ≫ pullback.fst τ.S.hom p) ≫ eZ.hom)
        (pullback.snd Z.hom (s.left ≫ pullback.fst τ.S.hom p)) Z'.hom p₀ :=
      (IsPullback.of_hasPullback Z.hom (s.left ≫ pullback.fst τ.S.hom p)).of_iso (Iso.refl _) eZ
        (Iso.refl _) ((Over.forget B).mapIso e.eS) (by simp) (by simp) wZ.symm h₂
    let eφ : (Over.pullback (s.left ≫ pullback.fst τ.S.hom p)).obj Z ≅
        (Over.pullback p₀).obj Z' :=
      Over.isoMk hP.isoPullback hP.isoPullback_hom_snd
    exact ⟨eφ.symm ≪≫ (Over.pullbackComp s.left (pullback.fst τ.S.hom p)).app Z⟩
  exact ⟨s, transport τ.X τ'.X e.eX e.wX, transport τ.Y τ'.Y e.eY e.wY⟩

end RelativeSystem

/-! ### The inputs -/

/-- **The second paragraph of the source's proof of [Stacks, Tag 0G0Y].** For smooth proper
schemes `X` and `Y` over a field `K`, a `K`-linear exact equivalence
`D_perf(𝒪_X) ≌ D_perf(𝒪_Y)` yields a Fourier-Mukai kernel of a relative equivalence from `X` to
`Y` over `Spec K`. The source deduces this from [Stacks, Tag 0G0D], [Stacks, Tag 0FYY] and
[Stacks, Tag 0G0E]. -/
def DerivedEquivalenceHasRelativeKernel (K : Type u) [Field K] : Prop :=
  ∀ A B : Over (Spec (CommRingCat.of K)),
    Smooth A.hom → IsProper A.hom → Smooth B.hom → IsProper B.hom →
      (letI : Linear K A.left.Modules := modulesLinear K A
       letI : Linear K B.left.Modules := modulesLinear K B
       ∃ e : Stacks.Perfect.BoundedLocallyFreeComplexes.PerfectDerivedCategory A.left ≌
           Stacks.Perfect.BoundedLocallyFreeComplexes.PerfectDerivedCategory B.left,
         e.functor.Linear K ∧
           ∃ h : e.functor.CommShift ℤ,
             letI := h
             e.functor.IsTriangulated) →
        ∃ M : DerivedCategory (pullback A.hom B.hom).Modules,
          IsRelativeEquivalenceKernel A.hom B.hom M

/-! ### The descent of a kernel over `Spec K` to a good system over `Spec ℤ[∅]` -/

/-- **A relative equivalence between smooth proper `K`-schemes comes from a good system over
`Spec ℤ[∅]`.** Let `X` and `Y` be smooth proper over `Spec K` and let `M` be the kernel of a
relative equivalence from `X` to `Y` over `Spec K`. Then there are a good system `τ₀` over
`Spec ℤ[∅]` and a morphism `p₀ : Spec K ⟶ τ₀.S` over `Spec ℤ[∅]` along which the two families of
`τ₀` become `X` and `Y`. -/
theorem exists_goodSystem_of_isRelativeEquivalenceKernel
    (h09RFobj : PerfectDescendsAlongBaseChangedTower.{u, u})
    (h09RFiso : PerfectIsoDescendsAlongBaseChangedTower.{u, u})
    {K : Type u} [Field K] (X Y : Over (Spec (CommRingCat.of K)))
    [Smooth X.hom] [IsProper X.hom] [Smooth Y.hom] [IsProper Y.hom]
    {M : DerivedCategory (pullback X.hom Y.hom).Modules}
    (hM : IsRelativeEquivalenceKernel X.hom Y.hom M) :
    ∃ (τ₀ : RelativeSystem (Spec (CommRingCat.of (bottomRing K)))) (p₀ : Spec (.of K) ⟶ τ₀.S.left),
      τ₀.IsGood ∧ p₀ ≫ τ₀.S.hom = pointToBottom K ∧
        Nonempty (X ≅ (Over.pullback p₀).obj τ₀.X) ∧
        Nonempty (Y ≅ (Over.pullback p₀).obj τ₀.Y) := by
  obtain ⟨j, X₁, x, gX, Y₁, y, gY, hxp, hxs, hyp, hys, hX₂, hY₂⟩ :=
    exists_common_stage_properSmoothModels (specAdjoinFinsetDiagram K) (specAdjoinFinsetCone K)
      (isLimit_specAdjoinFinsetCone K) X Y ‹_› ‹_› ‹_› ‹_›
  let c := specAdjoinFinsetCone K
  have := hxp
  have := hxs
  have := hyp
  have := hys
  -- the descent situation with base `j`
  let DS := finsetDescentSituation K j.unop
  have : @Smooth X₁ (DS.stage DS.base) x := hxs
  have : @IsProper X₁ (DS.stage DS.base) x := hxp
  have : @Smooth Y₁ (DS.stage DS.base) y := hys
  have : @IsProper Y₁ (DS.stage DS.base) y := hyp
  -- the kernel, moved onto the limit of the tower
  have hM' := isRelativeEquivalenceKernel_derivedPullback_of_iso X.hom Y.hom
    hX₂.isoPullback.symm hY₂.isoPullback.symm (f₁ := pullback.snd x (c.π.app j))
    (g₁ := pullback.snd y (c.π.app j)) hX₂.isoPullback_inv_snd hY₂.isoPullback_inv_snd hM
  obtain ⟨i, hi, Ki, hKi⟩ := exists_isRelativeEquivalenceKernel_of_descentSituation_of_isNoetherian
    DS h09RFobj h09RFiso (fun i => isNoetherian_specAdjoinFinsetDiagram_obj K (Opposite.op i))
    diagonalKernelAndConvolutionPerfectOfNoetherian x y hM'
  let S₀ : Over (Spec (CommRingCat.of (bottomRing K))) := Over.mk (stageToBottom K i)
  let τ₀ : RelativeSystem (Spec (CommRingCat.of (bottomRing K))) :=
    ⟨S₀, Over.mk (pullback.snd x (DS.transition hi)), Over.mk (pullback.snd y (DS.transition hi))⟩
  have hgood : τ₀.IsGood :=
    ⟨⟨inferInstanceAs (LocallyOfFiniteType (stageToBottom K i)),
      inferInstanceAs (QuasiCompact (stageToBottom K i))⟩,
      ⟨bc (P := @Smooth) _ _ ‹_›, bc (P := @IsProper) _ _ ‹_›⟩,
      ⟨bc (P := @Smooth) _ _ ‹_›, bc (P := @IsProper) _ _ ‹_›⟩, Ki, hKi⟩
  let p₀ : Spec (CommRingCat.of K) ⟶ τ₀.S.left := c.π.app (op i)
  have hp₀ : p₀ ≫ τ₀.S.hom = pointToBottom K := projection_comp_stageToBottom K i
  have hpt : p₀ ≫ DS.transition hi = c.π.app j := DS.projection_comp_transition hi
  have fibre : ∀ (Z : Over (Spec (CommRingCat.of K))) {Z₁ : Scheme.{u}}
      (z : Z₁ ⟶ DS.stage DS.base) (g : Z.left ⟶ Z₁), IsPullback g Z.hom z (c.π.app j) →
      Nonempty (Z ≅ (Over.pullback p₀).obj (Over.mk (pullback.snd z (DS.transition hi)))) := by
    intro Z Z₁ z g hpb
    have hpb' : IsPullback g Z.hom z (p₀ ≫ DS.transition hi) := by
      rwa [hpt]
    let e₁ : Z ≅ (Over.pullback (p₀ ≫ DS.transition hi)).obj (Over.mk z) :=
      Over.isoMk hpb'.isoPullback hpb'.isoPullback_hom_snd
    exact ⟨e₁ ≪≫ (Over.pullbackComp p₀ (DS.transition hi)).app (Over.mk z)⟩
  exact ⟨τ₀, p₀, hgood, hp₀, fibre X x _ hX₂, fibre Y y _ hY₂⟩

/-! ### The assembly -/

/-- **[Stacks, Tag 0G0Y], from its inputs.** Let `K` be a field. There are a countable type `I`
and, for `i : I`, a scheme `S i` of finite type over `K`, smooth proper `X i ⟶ S i` and
`Y i ⟶ S i`, and a Fourier-Mukai kernel `M i` of a relative equivalence from `X i` to `Y i` over
`S i`, such that for all smooth proper `A`, `B` over `K` with a `K`-linear exact equivalence
`D_perf(𝒪_A) ≌ D_perf(𝒪_B)` there are `i` and a `K`-point `s` of `S i` with `A ≅ (X i)_s` and
`B ≅ (Y i)_s`.

The inputs are listed in the module docstring; none of them mentions the countable family. -/
theorem exists_countable_relativeEquivalenceKernels_of_hasRelativeKernel
    (h09RFobj : PerfectDescendsAlongBaseChangedTower.{u, u})
    (h09RFiso : PerfectIsoDescendsAlongBaseChangedTower.{u, u})
    (K : Type u) [Field K] (hkernel : DerivedEquivalenceHasRelativeKernel K) :
    ∃ (I : Type (u + 1)) (_ : Countable I)
      (S : I → Over (Spec (.of K)))
      (X Y : (i : I) → Over (S i).left)
      (M : (i : I) → DerivedCategory (pullback (X i).hom (Y i).hom).Modules)
      (_ : ∀ i, LocallyOfFiniteType (S i).hom ∧ QuasiCompact (S i).hom)
      (_ : ∀ i, Smooth (X i).hom ∧ IsProper (X i).hom)
      (_ : ∀ i, Smooth (Y i).hom ∧ IsProper (Y i).hom)
      (_ : ∀ i, IsRelativeEquivalenceKernel (X i).hom (Y i).hom (M i)),
      ∀ (A B : Over (Spec (.of K))),
        Smooth A.hom → IsProper A.hom → Smooth B.hom → IsProper B.hom →
          (letI : Linear K A.left.Modules := modulesLinear K A
           letI : Linear K B.left.Modules := modulesLinear K B
           ∃ e : Stacks.Perfect.BoundedLocallyFreeComplexes.PerfectDerivedCategory A.left ≌
               Stacks.Perfect.BoundedLocallyFreeComplexes.PerfectDerivedCategory B.left,
             e.functor.Linear K ∧
               ∃ h : e.functor.CommShift ℤ,
                 letI := h
                 e.functor.IsTriangulated) →
            ∃ (i : I) (s : Over.mk (𝟙 (Spec (.of K))) ⟶ S i),
              Nonempty (A ≅ (Over.pullback s.left).obj (X i)) ∧
                Nonempty (B ≅ (Over.pullback s.left).obj (Y i)) := by
  classical
  let Bs := Spec (CommRingCat.of (bottomRing K))
  -- representatives of the isomorphism classes of finite-type schemes over `Bs`
  let P : Over Bs → Prop := fun Z => LocallyOfFiniteType Z.hom ∧ QuasiCompact Z.hom
  let Q := Quotient (isIsomorphicSetoid (ObjectProperty.FullSubcategory P))
  have hQ : Countable Q := countable_isomorphismClasses_of_finiteType (bottomRing K)
  let rep (q : Q) : Over Bs := (Quotient.out q).obj
  have hrep (q : Q) : LocallyOfFiniteType (rep q).hom ∧ QuasiCompact (rep q).hom :=
    (Quotient.out q).property
  have hHom (q q' : Q) : Countable (rep q ⟶ rep q') := by
    have := (hrep q).1
    have := (hrep q).2
    have := (hrep q').1
    have := (hrep q').2
    exact countable_hom_of_finiteType (rep q) (rep q')
  -- the countable type of triples of representatives
  let C := Σ q : Q × Q × Q, (rep q.2.1 ⟶ rep q.1) × (rep q.2.2 ⟶ rep q.1)
  have : Countable C := by
    have : ∀ q : Q × Q × Q, Countable ((rep q.2.1 ⟶ rep q.1) × (rep q.2.2 ⟶ rep q.1)) :=
      fun q => by
        have := hHom q.2.1 q.1
        have := hHom q.2.2 q.1
        infer_instance
    infer_instance
  let sys (t : C) : RelativeSystem Bs := ⟨rep t.1.1, Over.mk t.2.1.left, Over.mk t.2.2.left⟩
  let I := {t : C // ∃ τ : RelativeSystem Bs, τ.IsGood ∧ Nonempty (RelativeSystem.Iso τ (sys t))}
  let τ (i : I) : RelativeSystem Bs := Classical.choose i.2
  have hτ (i : I) : (τ i).IsGood ∧ Nonempty (RelativeSystem.Iso (τ i) (sys i.1)) :=
    Classical.choose_spec i.2
  let p := pointToBottom K
  refine ⟨I, inferInstance, fun i => (τ i).baseS p, fun i => (τ i).baseX p,
    fun i => (τ i).baseY p, fun i => ?_, fun i => ?_, fun i => ?_, fun i => ?_, fun i => ?_, ?_⟩
  · exact (derivedPullback (fourierMukaiBaseChangeMap (τ i).X.hom (τ i).Y.hom
      (pullback.fst (τ i).S.hom p)).toLRSHom.toShHom).obj (Classical.choose (hτ i).1.2.2.2)
  · obtain ⟨⟨h₁, h₂⟩, -⟩ := (hτ i).1
    have := h₁
    have := h₂
    exact ⟨bc (P := @LocallyOfFiniteType) _ _ h₁, bc (P := @QuasiCompact) _ _ h₂⟩
  · obtain ⟨-, ⟨h₁, h₂⟩, -⟩ := (hτ i).1
    have := h₁
    have := h₂
    exact ⟨bc (P := @Smooth) _ _ h₁, bc (P := @IsProper) _ _ h₂⟩
  · obtain ⟨-, -, ⟨h₁, h₂⟩, -⟩ := (hτ i).1
    have := h₁
    have := h₂
    exact ⟨bc (P := @Smooth) _ _ h₁, bc (P := @IsProper) _ _ h₂⟩
  · obtain ⟨-, ⟨hXs, hXp⟩, ⟨hYs, hYp⟩, -⟩ := (hτ i).1
    have := hXs
    have := hXp
    have := hYs
    have := hYp
    exact isRelativeEquivalenceKernel_derivedPullback derivedBaseChangeIsIsoOnQuasicoherent
      (τ i).X.hom (τ i).Y.hom (pullback.fst (τ i).S.hom p) (Classical.choose_spec (hτ i).1.2.2.2)
  · intro A B hAs hAp hBs hBp hequiv
    have := hAs
    have := hAp
    have := hBs
    have := hBp
    obtain ⟨M, hM⟩ := hkernel A B hAs hAp hBs hBp hequiv
    obtain ⟨τ₀, p₀, hgood, hp₀, ⟨eA⟩, ⟨eB⟩⟩ :=
      exists_goodSystem_of_isRelativeEquivalenceKernel h09RFobj h09RFiso A B hM
    obtain ⟨⟨hSft, hSqc⟩, ⟨hXs, hXp⟩, ⟨hYs, hYp⟩, -⟩ := id hgood
    have := hSft
    have := hSqc
    have := hXs
    have := hXp
    have := hYs
    have := hYp
    -- the class of `τ₀` among the triples of representatives
    let ZS : ObjectProperty.FullSubcategory P := ⟨τ₀.S, hSft, hSqc⟩
    have repIso : ∀ Z : ObjectProperty.FullSubcategory P,
        Nonempty (rep (Quotient.mk _ Z) ≅ Z.obj) := fun Z => by
      obtain ⟨e⟩ : Nonempty (Quotient.out (Quotient.mk (isIsomorphicSetoid _) Z) ≅ Z) :=
        Quotient.exact (Quotient.out_eq (Quotient.mk (isIsomorphicSetoid _) Z))
      exact ⟨(ObjectProperty.ι P).mapIso e⟩
    obtain ⟨e₁⟩ := repIso ZS
    -- a smooth proper family over `τ₀.S` is isomorphic to a family over a representative
    have family : ∀ Z : Over τ₀.S.left, Smooth Z.hom → IsProper Z.hom →
        ∃ (q : Q) (m : rep q ⟶ rep (Quotient.mk _ ZS)) (e : Z.left ≅ (rep q).left),
          e.hom ≫ m.left = Z.hom ≫ e₁.inv.left := by
      intro Z hZs hZp
      let ZZ : ObjectProperty.FullSubcategory P := ⟨Over.mk (Z.hom ≫ τ₀.S.hom),
        inferInstanceAs (LocallyOfFiniteType (Z.hom ≫ τ₀.S.hom)),
        inferInstanceAs (QuasiCompact (Z.hom ≫ τ₀.S.hom))⟩
      obtain ⟨e₂⟩ := repIso ZZ
      exact ⟨_, e₂.hom ≫ Over.homMk Z.hom rfl ≫ e₁.inv, (Over.forget _).mapIso e₂.symm, by
        change e₂.inv.left ≫ (e₂.hom ≫ Over.homMk Z.hom rfl ≫ e₁.inv).left = _
        rw [← Over.comp_left, e₂.inv_hom_id_assoc, Over.comp_left]
        rfl⟩
    obtain ⟨qX, mX, eX, wX⟩ := family τ₀.X hXs hXp
    obtain ⟨qY, mY, eY, wY⟩ := family τ₀.Y hYs hYp
    let t : C := ⟨(Quotient.mk _ ZS, qX, qY), (mX, mY)⟩
    let e₀ : RelativeSystem.Iso τ₀ (sys t) := ⟨e₁.symm, eX, eY, wX, wY⟩
    let i : I := ⟨t, τ₀, hgood, ⟨e₀⟩⟩
    obtain ⟨eτ⟩ := (hτ i).2
    obtain ⟨s, ⟨fX⟩, ⟨fY⟩⟩ :=
      RelativeSystem.exists_section_fibre_iso (eτ.trans e₀.symm) p p₀ hp₀
    exact ⟨i, s, ⟨eA ≪≫ fX⟩, ⟨eB ≪≫ fY⟩⟩

end AlgebraicGeometry
