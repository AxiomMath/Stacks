variable (k : Type u) [Field k] (n : ℕ)

/-- The category of `𝒪_{ℙⁿ_k}`-modules, in the `Scheme.Modules` spelling. -/
abbrev PMods := (projOver k n).left.Modules

/-- `𝒪(d)`, as an object of `PMods k n`. -/
abbrev twistM (d : ℤ) : PMods k n := ProjectiveSpectrum.Proj.twistingSheaf (polyGrading k n) d

/-- `𝒪(d)[0]` in the locally small derived category of `PMods k n`. -/
abbrev twistD (d : ℤ) : DerivedCategory (PMods k n) :=
  (DerivedCategory.singleFunctor (PMods k n) 0).obj (twistM k n d)

/-- The exceptional sequence `𝒪(-n), …, 𝒪(-1), 𝒪`, indexed by `a = 0, …, n`. -/
abbrev seq (a : Fin (n + 1)) : DerivedCategory (PMods k n) := twistD k n ((a : ℤ) - n)

attribute [local instance] AlgebraicGeometry.modulesLinear

/-- The scalar action of `r` on `𝒪(d)` through the structure morphism is `r • 𝟙`. -/
theorem twistBaseScalar_eq_smul' (d : ℤ) (r : k) :
    (twistBaseScalar k n r d : twistM k n d ⟶ twistM k n d) = r • 𝟙 (twistM k n d) :=
  (Category.comp_id _).symm

/-- Multiplication by the constant `r` on `𝒪(d)` is `r • 𝟙`. -/
theorem twistScalar_eq_smul' (d : ℤ) (r : k) :
    (twistScalar k n r d : twistM k n d ⟶ twistM k n d) = r • 𝟙 (twistM k n d) :=
  (twistScalar_eq_twistBaseScalar k n r d).trans (twistBaseScalar_eq_smul' k n d r)

/-- Multiplication by a polynomial of degree `c ≥ 0`, as a map from the degree-`c` part of
`k[T₀, …, Tₙ]` to `Hom(𝒪(d), 𝒪(e))`, `c + d = e`. -/
def twistMulHom' (c : ℕ) (d e : ℤ) (he : (c : ℤ) + d = e) :
    MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k c →+ (twistM k n d ⟶ twistM k n e) where
  toFun p := Stacks.AlgebraicGeometry.ProjectiveGenerator.twistMul (polyGrading k n) p.1 c d e
    (Stacks.AlgebraicGeometry.ProjectiveGenerator.mem_integerGrading_of_mem _ p.2) he
  map_zero' := Stacks.AlgebraicGeometry.ProjectiveGenerator.twistMul_zero _ _ _ _ he
  map_add' p q := Stacks.AlgebraicGeometry.ProjectiveGenerator.twistMul_add _ p.1 q.1 _ _ _ _ _ he

open Stacks.AlgebraicGeometry.ProjectiveGenerator in
/-- Multiplication by `r • p` is `r` times multiplication by `p`. -/
theorem twistMulHom'_smul (c : ℕ) (d e : ℤ) (he : (c : ℤ) + d = e) (r : k)
    (p : MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k c) :
    twistMulHom' k n c d e he (r • p) = r • twistMulHom' k n c d e he p := by
  have hC := mem_integerGrading_of_mem (polyGrading k n)
    (Stacks.ProjectiveSpace.Cohomology.C_mem_polyGrading_zero k n r)
  have h1 : twistMulHom' k n c d e he (r • p) =
      twistMulHom' k n c d e he p ≫ (twistScalar k n r e : twistM k n e ⟶ twistM k n e) :=
    (twistMul_congr (polyGrading k n) (mem_integerGrading_of_mem _ (r • p).2)
        (mul_mem_integerGrading' _ hC (mem_integerGrading_of_mem _ p.2)) he (by omega)
        (by simp [MvPolynomial.smul_eq_C_mul])).trans
      (twistMul_comp (polyGrading k n) p.1 (MvPolynomial.C r) c 0 d e e
        (mem_integerGrading_of_mem _ p.2) hC he (zero_add e)).symm
  have h3 : twistMulHom' k n c d e he p ≫ (r • 𝟙 (twistM k n e)) =
      r • twistMulHom' k n c d e he p := by
    rw [Linear.comp_smul, Category.comp_id]
  exact h1.trans
    ((congrArg (twistMulHom' k n c d e he p ≫ ·) (twistScalar_eq_smul' k n e r)).trans h3)

open Stacks.AlgebraicGeometry.ProjectiveGenerator in
/-- **`Hom(𝒪(d), 𝒪(e))` is finite dimensional** for `e - d ≥ 0`. -/
theorem moduleFinite_hom_twist (d e : ℤ) (hde : 0 ≤ e - d) :
    Module.Finite k (twistM k n d ⟶ twistM k n e) := by
  obtain ⟨c, hc⟩ : ∃ c : ℕ, (c : ℤ) = e - d := ⟨(e - d).toNat, Int.toNat_of_nonneg hde⟩
  have he : (c : ℤ) + d = e := by omega
  let Φ : MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k c →ₗ[k]
      (twistM k n d ⟶ twistM k n e) :=
    { twistMulHom' k n c d e he with map_smul' := twistMulHom'_smul k n c d e he }
  refine Module.Finite.of_surjective Φ fun φ => ?_
  obtain ⟨p, hp, rfl⟩ := exists_twistMul_eq k n he (Or.inl (by omega)) φ
  rw [AlgebraicGeometry.ProjectiveSpectrum.Proj.integerGrading_natCast] at hp
  exact ⟨⟨p, hp⟩, rfl⟩

section Model

variable [hD : HasDerivedCategory.{w} (PMods k n)]

/-- `𝒪(d)[0]` in a model of the derived category of `PMods k n`. -/
abbrev twistE (d : ℤ) : DerivedCategory (PMods k n) :=
  (DerivedCategory.singleFunctor (PMods k n) 0).obj (twistM k n d)

/-- **`Hom(𝒪(d)[0], 𝒪(e)[0])` is finite dimensional** for `e - d ≥ 0`. -/
theorem moduleFinite_hom_twistE_shift_zero (d e : ℤ) (hde : 0 ≤ e - d) :
    Module.Finite k (twistE k n d ⟶ (twistE k n e)⟦(0 : ℤ)⟧) := by
  have := moduleFinite_hom_twist k n d e hde
  let F := DerivedCategory.singleFunctor (PMods k n) 0
  let Φ : (twistM k n d ⟶ twistM k n e) →ₗ[k] (twistE k n d ⟶ (twistE k n e)⟦(0 : ℤ)⟧) :=
    (Linear.rightComp k _ ((shiftFunctorZero (DerivedCategory (PMods k n)) ℤ).inv.app _)).comp
      (F.mapLinearMap k)
  refine Module.Finite.of_surjective Φ fun g => ?_
  refine ⟨F.preimage (g ≫ (shiftFunctorZero (DerivedCategory (PMods k n)) ℤ).hom.app _), ?_⟩
  show F.map (F.preimage _) ≫ _ = g
  rw [Functor.map_preimage, Category.assoc, Iso.hom_inv_id_app, Category.comp_id]

/-- **Every endomorphism of `𝒪(d)[0]` is a scalar.** -/
theorem exists_eq_smul_id_twistE (d : ℤ) (e : twistE k n d ⟶ twistE k n d) :
    ∃ r : k, e = r • 𝟙 (twistE k n d) := by
  let F := DerivedCategory.singleFunctor (PMods k n) 0
  obtain ⟨r, hr⟩ := exists_eq_twistScalar k n d
    (F.preimage (X := twistM k n d) (Y := twistM k n d) e)
  refine ⟨r, (F.map_preimage (X := twistM k n d) (Y := twistM k n d) e).symm.trans ?_⟩
  exact (congrArg F.map (hr.trans (twistScalar_eq_smul' k n d r))).trans
    ((Functor.linear_iff k F).1 inferInstance _ r)

/-- **A coherent module in degree zero lies in `D^b_Coh`**, at an arbitrary model of the derived
category. -/
theorem derivedCategoryBBounded_singleFunctor_obj (F : PMods k n) (hF : F.IsCoherent) :
    DerivedCategoryB.derivedCategoryBBounded (fun M : PMods k n => M.IsCoherent)
      ((DerivedCategory.singleFunctor (PMods k n) 0).obj F) := by
  have hCS := Stacks.AlgebraicGeometry.ProperSupportCoherent.isCoherent_isWeakSerre
    (projOver k n).left
  have e : ∀ i : ℤ, (DerivedCategory.homologyFunctor (PMods k n) i).obj
      ((DerivedCategory.singleFunctor (PMods k n) 0).obj F) ≅
      ((CochainComplex.singleFunctor (PMods k n) 0).obj F).homology i :=
    fun i => (DerivedCategory.homologyFunctorFactors (PMods k n) i).app _
  have hzero : ∀ i : ℤ, i ≠ 0 → IsZero
      ((DerivedCategory.homologyFunctor (PMods k n) i).obj
        ((DerivedCategory.singleFunctor (PMods k n) 0).obj F)) :=
    fun i hi => (HomologicalComplex.isZero_single_obj_homology _ _ _ _ hi).of_iso (e i)
  refine ⟨⟨⟨0, fun n hn => hzero n (by omega)⟩, ⟨0, fun n hn => hzero n (by omega)⟩⟩, fun m => ?_⟩
  by_cases hm : m = 0
  · subst hm
    exact hCS.isClosedUnderIsomorphisms.of_iso
      (e 0 ≪≫ HomologicalComplex.singleObjHomologySelfIso _ _ _).symm hF
  · exact DerivedCategoryB.zero_mem_of_isWeakSerre _ hCS _ (hzero m hm)

/-- The exceptional sequence `𝒪(-n), …, 𝒪(-1), 𝒪` in a model of the derived category. -/
abbrev seqE (a : Fin (n + 1)) : DerivedCategory (PMods k n) := twistE k n ((a : ℤ) - n)

/-- **On `ℙⁿ_k`, finite total `Hom` from the exceptional sequence forces `D^b_Coh`**, granted
that the sequence generates `D_QCoh` at the model at hand (`hgen`; this is
`Stacks.AlgebraicGeometry.TwistGeneration.isZero_of_subsingleton_hom_twist` at the locally small
model, and is transported to the others). -/
theorem derivedCategoryBBounded_of_hasFiniteTotalHom_seqE
    (hgen : ∀ M : DerivedCategory (PMods k n),
      DerivedCategoryB.derivedCategoryB (A := PMods k n)
        (SheafOfModules.isQuasicoherent (projOver k n).left.ringCatSheaf) M →
      (∀ (a : Fin (n + 1)) (j : ℤ), Subsingleton (seqE k n a ⟶ M⟦j⟧)) → IsZero M)
    (M : DerivedCategory (PMods k n))
    (hQM : DerivedCategoryB.derivedCategoryB (A := PMods k n)
      (SheafOfModules.isQuasicoherent (projOver k n).left.ringCatSheaf) M)
    (hM : ∀ a, HasFiniteTotalHom k (seqE k n a) M) :
    DerivedCategoryB.derivedCategoryBBounded (fun F : PMods k n => F.IsCoherent) M := by
  have hQS :=
    Stacks.AlgebraicGeometry.QuasicoherentWeakSerre.isQuasicoherent_isWeakSerre (projOver k n).left
  have hCS :=
    Stacks.AlgebraicGeometry.ProperSupportCoherent.isCoherent_isWeakSerre (projOver k n).left
  let := DerivedCategoryB.derivedCategoryB_isTriangulated (A := PMods k n)
    (SheafOfModules.isQuasicoherent (projOver k n).left.ringCatSheaf) hQS
  let := DerivedCategoryB.derivedCategoryB_isClosedUnderIsomorphisms (A := PMods k n)
    (SheafOfModules.isQuasicoherent (projOver k n).left.ringCatSheaf) hQS
  let := DerivedCategoryB.derivedCategoryBBounded_isTriangulated
    (fun F : PMods k n => F.IsCoherent) hCS
  let := DerivedCategoryB.derivedCategoryBBounded_isClosedUnderIsomorphisms
    (fun F : PMods k n => F.IsCoherent) hCS
  have hsub : ∀ (d e j : ℤ), -(n : ℤ) ≤ e - d → (j ≠ 0 ∨ e - d < 0) →
      Subsingleton (twistE k n d ⟶ (twistE k n e)⟦j⟧) := fun d e j h1 h2 =>
    @Stacks.AlgebraicGeometry.TwistExt.subsingleton_hom_twist_shift_of_le k _ n
      hD d e j h1 h2
  refine prop_of_hasFiniteTotalHom_of_exceptional k (seqE k n)
    (fun a e => exists_eq_smul_id_twistE k n _ e)
    (fun a j hj => hsub _ _ j (by omega) (Or.inl hj))
    (fun a b hab j => have := Fin.lt_def.1 hab; hsub _ _ j (by omega) (Or.inr (by omega)))
    (fun a b hab => ?_) _ (fun a => ?_) hgen _ (fun a => ?_) M hQM hM
  · have hab' := Fin.lt_def.1 hab
    have hs : ∀ j : ℤ, j ≠ 0 → Subsingleton (seqE k n a ⟶ (seqE k n b)⟦j⟧) := fun j hj =>
      hsub _ _ j (by omega) (Or.inl hj)
    refine ⟨fun j => ?_, ?_⟩
    · by_cases hj : j = 0
      · subst hj
        exact moduleFinite_hom_twistE_shift_zero k n _ _ (by omega)
      · have := hs j hj
        infer_instance
    · refine (Set.finite_singleton (0 : ℤ)).subset fun j hj => ?_
      by_contra h
      have := hs j h
      exact not_nontrivial _ hj
  · exact Stacks.Duality.DerivedPushforward.derivedCategoryB_singleFunctor_obj
      (X := (projOver k n).left) _
      (Stacks.AlgebraicGeometry.TwistChartLocality.isQuasicoherent_twistingSheaf _ _)
  · exact derivedCategoryBBounded_singleFunctor_obj k n _
      (AlgebraicGeometry.ProjectiveSpectrum.Proj.isCoherent_twistingSheaf_polyGrading k n _)

end Model

/-- Morphisms out of `A[0]` into `M[j]` are morphisms out of `A[-j]`, that is `A` placed in
degree `j`, into `M`. -/
def homSingleShiftEquiv {C : Type*} [Category C] [Abelian C]
    [HasDerivedCategory.{w} C] (A : C) (M : DerivedCategory C) (j : ℤ) :
    ((DerivedCategory.singleFunctor C 0).obj A ⟶ M⟦j⟧) ≃
      ((DerivedCategory.singleFunctor C j).obj A ⟶ M) :=
  (Functor.FullyFaithful.ofFullyFaithful (shiftFunctor (DerivedCategory C) (-j))).homEquiv.trans
    (Iso.homCongr (((DerivedCategory.singleFunctors C).shiftIso (-j) j 0 (by omega)).app A)
      ((shiftFunctorCompIsoId (DerivedCategory C) j (-j) (by omega)).app M))

/-- **The exceptional sequence generates `D_QCoh(𝒪_{ℙⁿ_k})`**, at the locally small model: an
object with quasi-coherent cohomology receiving no nonzero morphism from any shift of `𝒪(-a)`,
`0 ≤ a ≤ n`, is zero. By the Koszul complex every `𝒪(-m)`, `m ≥ 0`, is built from these
([Stacks, Tag 0A9V]), and the negative twists generate
(`Stacks.AlgebraicGeometry.TwistGeneration.isZero_of_subsingleton_hom_twist`). -/
theorem isZero_of_subsingleton_hom_seqE_locallySmall (M : DerivedCategory (PMods k n))
    (hQ : DerivedCategoryB.derivedCategoryB (A := PMods k n)
      (SheafOfModules.isQuasicoherent (projOver k n).left.ringCatSheaf) M)
    (h : ∀ (a : Fin (n + 1)) (j : ℤ), Subsingleton (seqE k n a ⟶ M⟦j⟧)) : IsZero M := by
  refine Stacks.AlgebraicGeometry.TwistGeneration.isZero_of_subsingleton_hom_twist k n M hQ
    fun m p => ?_
  refine (homSingleShiftEquiv (twistM k n (-(m : ℤ))) M p).subsingleton_congr.1 ⟨fun f g => ?_⟩
  have hvan : ∀ (f : twist k n (-(m : ℤ)) ⟶ M⟦p⟧), f = 0 := by
    refine (Stacks.TriangulatedGenerators.hom_vanishing_iff_gen (twistSum k n) (M⟦p⟧)).1 ?_ _
      (twist_neg_mem_gen k n m)
    intro i f
    refine biproduct.hom_ext' _ _ fun b => ?_
    refine Eq.trans ?_ comp_zero.symm
    have hb' : Subsingleton (twist k n (-(b : ℤ)) ⟶ M⟦p⟧⟦i⟧) := by
      refine (Iso.homCongr (eqToIso ?_)
        ((shiftFunctorAdd (DerivedCategory (PMods k n)) p i).app M)).subsingleton_congr.1
          (h ⟨n - b, by omega⟩ (p + i))
      simp only [seqE, twistE, twist]
      congr 2
      omega
    exact Subsingleton.elim _ _
  exact (hvan f).trans (hvan g).symm

section Transport

variable {C : Type*} [Category C] [Abelian C] (h₁ : HasDerivedCategory.{w} C)
  (h₂ : HasDerivedCategory.{w'} C)

/-- The comparison of two models carries an object in a single degree to the same object. -/
def modelEquivSingleIso (p : ℤ) (A : C) :
    (StacksDraft.DerivedModel.modelEquiv h₁ h₂).functor.obj
        (@DerivedCategory.singleFunctor C _ _ h₁ p |>.obj A) ≅
      (@DerivedCategory.singleFunctor C _ _ h₂ p).obj A :=
  (StacksDraft.DerivedModel.modelEquiv h₁ h₂).functor.mapIso
      ((@DerivedCategory.singleFunctorIsoCompQ C _ _ h₁ p).app A) ≪≫
    (StacksDraft.DerivedModel.modelCompQIso h₁ h₂).app _ ≪≫
    ((@DerivedCategory.singleFunctorIsoCompQ C _ _ h₂ p).app A).symm

/-- The comparison of two models preserves cohomology objects. -/
theorem nonempty_homology_modelEquiv_iso (M : @DerivedCategory C _ _ h₁) (i : ℤ) :
    Nonempty ((@DerivedCategory.homologyFunctor C _ _ h₂ i).obj
        ((StacksDraft.DerivedModel.modelEquiv h₁ h₂).functor.obj M) ≅
      (@DerivedCategory.homologyFunctor C _ _ h₁ i).obj M) := by
  let Q₁ := @DerivedCategory.Q C _ _ h₁
  obtain ⟨K, ⟨e⟩⟩ : ∃ K, Nonempty (Q₁.obj K ≅ M) := ⟨_, ⟨Q₁.objObjPreimageIso M⟩⟩
  exact ⟨(@DerivedCategory.homologyFunctor C _ _ h₂ i).mapIso
      ((StacksDraft.DerivedModel.modelEquiv h₁ h₂).functor.mapIso e.symm ≪≫
        (StacksDraft.DerivedModel.modelCompQIso h₁ h₂).app K) ≪≫
      (@DerivedCategory.homologyFunctorFactors C _ _ h₂ i).app K ≪≫
      ((@DerivedCategory.homologyFunctorFactors C _ _ h₁ i).app K).symm ≪≫
      (@DerivedCategory.homologyFunctor C _ _ h₁ i).mapIso e⟩

end Transport

/-- **The exceptional sequence generates `D_QCoh(𝒪_{ℙⁿ_k})`**, at every model of the derived
category: `isZero_of_subsingleton_hom_seqE_locallySmall` transported along the comparison of
models. -/
theorem isZero_of_subsingleton_hom_seqE [hD : HasDerivedCategory.{w} (PMods k n)]
    (M : DerivedCategory (PMods k n))
    (hQ : DerivedCategoryB.derivedCategoryB (A := PMods k n)
      (SheafOfModules.isQuasicoherent (projOver k n).left.ringCatSheaf) M)
    (h : ∀ (a : Fin (n + 1)) (j : ℤ), Subsingleton (seqE k n a ⟶ M⟦j⟧)) : IsZero M := by
  let h₂ : HasDerivedCategory.{u} (PMods k n) := Scheme.Modules.hasDerivedCategory _
  let E := StacksDraft.DerivedModel.modelEquiv hD h₂
  have hQ' : @DerivedCategoryB.derivedCategoryB (PMods k n) _ _ h₂
      (SheafOfModules.isQuasicoherent (projOver k n).left.ringCatSheaf) (E.functor.obj M) :=
    fun i => (SheafOfModules.isQuasicoherent (projOver k n).left.ringCatSheaf).prop_of_iso
      (nonempty_homology_modelEquiv_iso hD h₂ M i).some.symm (hQ i)
  have h' : ∀ (a : Fin (n + 1)) (j : ℤ),
      Subsingleton (@seqE k _ n h₂ a ⟶ (E.functor.obj M)⟦j⟧) := by
    intro a j
    refine (@homSingleShiftEquiv _ _ _ h₂ _ (E.functor.obj M) j).subsingleton_congr.2 ?_
    refine (Iso.homCongr (modelEquivSingleIso hD h₂ j _) (Iso.refl _)).subsingleton_congr.1 ?_
    refine (E.fullyFaithfulFunctor.homEquiv).subsingleton_congr.1 ?_
    exact (@homSingleShiftEquiv _ _ _ hD _ M j).subsingleton_congr.1 (h a j)
  exact ((E.inverse.map_isZero
    (@isZero_of_subsingleton_hom_seqE_locallySmall k _ n (E.functor.obj M) hQ' h')).of_iso
      (E.unitIso.app M))

/-- **On `ℙⁿ_k`, an object of `D_QCoh` with finite total `Hom` from each of
`𝒪(-n), …, 𝒪(-1), 𝒪` lies in `D^b_Coh`**, at every model of the derived category. -/
theorem derivedCategoryBBounded_of_hasFiniteTotalHom [hD : HasDerivedCategory.{w} (PMods k n)]
    (M : DerivedCategory (PMods k n))
    (hQM : DerivedCategoryB.derivedCategoryB (A := PMods k n)
      (SheafOfModules.isQuasicoherent (projOver k n).left.ringCatSheaf) M)
    (hM : ∀ a, HasFiniteTotalHom k (seqE k n a) M) :
    DerivedCategoryB.derivedCategoryBBounded (fun F : PMods k n => F.IsCoherent) M :=
  derivedCategoryBBounded_of_hasFiniteTotalHom_seqE k n
    (fun M' hQ' h' => isZero_of_subsingleton_hom_seqE k n M' hQ' h') M hQM hM

end Stacks.AlgebraicGeometry.ProjectiveSpacePerfect

