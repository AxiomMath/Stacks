module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Blowup.AffinePointBlowup
public import StacksFrontier.AlgebraicGeometry.Blowup.PicardGroupGeneration
public import StacksFrontier.AlgebraicGeometry.Surfaces.ContractionPicardDecomposition

/-!
# Exactness at `Pic(X)` of the Picard sequence of an exceptional curve

Let `D` cut out an exceptional curve of the first kind `E ⊆ X`, presented by an isomorphism
`e : 𝐏¹_k ≅ E`. If `Pic(X)` is generated by the class of `𝒪_X(E)` then a class of degree zero on
`E` is zero, hence pulled back along *any* morphism out of `X`; so the clause
`Scheme.IdealSheafData.ContractionPicardExactness` of the short exact sequence of
[Stacks, Tag 0C5L] holds.

The hypothesis is the generation half of [Stacks, Tag 0C5G], which holds for the blowup of a
regular local ring of dimension two in its maximal ideal
(`AlgebraicGeometry.surjective_zsmul_picardClass_exceptionalIdealData`). For that blowup this
gives the clause, and with it the Picard sequence of Tag 0C5L and the decomposition
`Pic(X) = Pic(X') ⊕ ℤ` of [Stacks, Tag 0C5M].

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.contractionPicardExactness_of_surjective_zsmul` —
  **exactness at `Pic(X)` when `Pic(X)` is generated by the class of `𝒪_X(E)`**, and
  `Scheme.IdealSheafData.contractionPicardExactness_of_subsingleton_picardGroup_compl` — the same
  when `Pic(X ∖ E)` is trivial.
* `AlgebraicGeometry.contractionPicardExactness_exceptionalIdealData` — **exactness at `Pic(X)`
  for the blowup of a regular local ring of dimension two in its maximal ideal.**
* `AlgebraicGeometry.isContractionOfExceptionalCurve_toSpec_maximalIdeal` — that blowup
  contracts its exceptional divisor.
* `AlgebraicGeometry.picardDecomposition_exceptionalIdealData`,
  `AlgebraicGeometry.contractedPicardHom_exceptionalIdealData` and
  `AlgebraicGeometry.nonempty_picardDecomposition_exceptionalIdealData` — **the decomposition
  `Pic(X) = Pic(Spec A) ⊕ ℤ` of [Stacks, Tag 0C5M] for that blowup.**

## Implementation notes

The degree of `𝒪_X(E)` on `E` is `-1`
(`AlgebraicGeometry.Scheme.IdealSheafData.exceptionalDegree_picardClass`), so under generation the
degree map is the inverse of `n ↦ n • [𝒪_X(E)]` up to sign and in particular injective. That is
the whole content: the kernel of the degree is trivial, and `0` is the pullback of `0`. The
statement is therefore proved for an arbitrary `b : X ⟶ X'`, with no hypothesis relating `b` to
`D` — `ContractionPicardExactness` mentions `b` only through its pullback on Picard classes.

The argument does not extend to a general contraction `b : X ⟶ X'`: it concludes that a class of
degree zero is zero, which is false as soon as `Pic(X')` is nonzero — for `X'` a projective plane
and `X` its blowup at a point, the kernel of the degree is `b^*Pic(X') ≅ ℤ`.
`Scheme.IdealSheafData.contractionPicardExactness_of_subsingleton_picardGroup_compl` states the
sharp hypothesis that the argument can use: triviality of `Pic(X ∖ E)` on an integral, locally
Noetherian, normal `X`.

## References

* [Stacks Project, Tag 0C5L](https://stacks.math.columbia.edu/tag/0C5L)
* [Stacks Project, Tag 0C5G](https://stacks.math.columbia.edu/tag/0C5G)
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing TopologicalSpace

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

namespace AlgebraicGeometry

namespace Scheme.IdealSheafData

variable {X X' : Scheme.{u}} (D : X.IdealSheafData) (k : Type u) [Field k]
  [Stacks.Divisors.IsEffectiveCartierDivisor D] (e : projectiveLineProj k ≅ D.subscheme)
  (b : X ⟶ X')

/-- **A Picard class of degree zero on an exceptional curve generating `Pic(X)` is zero.** -/
public theorem eq_zero_of_exceptionalDegree_eq_zero
    (hE : D.IsExceptionalCurveOfFirstKind k e)
    (hgen : Function.Surjective fun n : ℤ => n • Stacks.Divisors.picardClass D)
    (L : Stacks.Picard.ofScheme X) (hL : D.exceptionalDegree k e L = 0) : L = 0 := by
  obtain ⟨n, hn⟩ := hgen L
  have hn' : n • Stacks.Divisors.picardClass D = L := hn
  have hdeg : D.exceptionalDegree k e (n • Stacks.Divisors.picardClass D) = -n := by
    rw [map_zsmul, exceptionalDegree_picardClass D k e hE, smul_neg, smul_eq_mul, mul_one]
  rw [hn', hL] at hdeg
  rw [← hn', show n = 0 from by omega, zero_zsmul]

/-- **Stacks Project, Tag 0C5L, exactness at `Pic(X)` under generation.** Let `D` cut out an
exceptional curve of the first kind, and suppose every Picard class of `X` is an integral multiple
of the class of `𝒪_X(E)`. Then every class of degree zero on `E` is pulled back along any
`b : X ⟶ X'`. -/
public theorem contractionPicardExactness_of_surjective_zsmul
    (hE : D.IsExceptionalCurveOfFirstKind k e)
    (hgen : Function.Surjective fun n : ℤ => n • Stacks.Divisors.picardClass D) :
    D.ContractionPicardExactness k e b := fun L hL =>
  ⟨0, by rw [map_zero, D.eq_zero_of_exceptionalDegree_eq_zero k e hE hgen L hL]⟩

/-- **Exactness at `Pic(X)` when the Picard group of `X ∖ E` is trivial.** Let `X` be integral,
locally Noetherian and normal, and let `D` cut out an exceptional curve of the first kind `E`. If
`Pic(X ∖ E)` is trivial then every class of degree zero on `E` is pulled back along any
`b : X ⟶ X'`. -/
public theorem contractionPicardExactness_of_subsingleton_picardGroup_compl
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (hE : D.IsExceptionalCurveOfFirstKind k e)
    (hPic : Subsingleton
      (Scheme.Opens.toScheme (Closeds.compl (D.support : Closeds X))).picardGroup) :
    D.ContractionPicardExactness k e b :=
  have := isIntegral_subscheme_of_iso_projectiveLineProj D k e
  D.contractionPicardExactness_of_surjective_zsmul k e b hE
    (surjective_zsmul_picardClass_of_subsingleton_picardGroup_compl D hPic)

end Scheme.IdealSheafData

/-! ### The blowup of a regular local ring of dimension two -/

/-- Let `(A, 𝔪, κ)` be a regular local ring of dimension two, let `X ⟶ Spec A` be the blowing up of
`Spec A` in `𝔪` and let `E` be its exceptional divisor, presented as an exceptional curve of the
first kind by `e : 𝐏¹_k ≅ E`. Then every Picard class of `X` of degree zero on `E` is pulled back
along any morphism out of `X`. -/
@[stacks 0C5L "exactness at Pic(X), the inclusion of the kernel of the degree in the image of \
b^*, for the blowup of a regular local ring of dimension two in its maximal ideal: with nothing \
assumed"]
public theorem contractionPicardExactness_exceptionalIdealData (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) (k : Type u) [Field k]
    {e : projectiveLineProj k ≅
      (Stacks.Blowup.exceptionalIdealData (maximalIdeal A)).subscheme}
    (hE : (Stacks.Blowup.exceptionalIdealData (maximalIdeal A)).IsExceptionalCurveOfFirstKind k e)
    {X' : Scheme.{u}} (b : Stacks.Blowup.blowUpSpec (maximalIdeal A) ⟶ X') :
    (Stacks.Blowup.exceptionalIdealData (maximalIdeal A)).ContractionPicardExactness k e b :=
  Scheme.IdealSheafData.contractionPicardExactness_of_surjective_zsmul _ k e b hE
    (surjective_zsmul_picardClass_exceptionalIdealData A hdim)

/-! ### The blowup as a contraction of its exceptional curve -/

/-- **The blowup of a regular local ring of dimension two in its maximal ideal contracts its
exceptional divisor.** -/
public theorem isContractionOfExceptionalCurve_toSpec_maximalIdeal (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) :
    IsContractionOfExceptionalCurve (Stacks.Blowup.exceptionalIdealData (maximalIdeal A))
      (Stacks.Blowup.toSpec (maximalIdeal A)) := by
  have hz : IsClosed ({closedPoint (CommRingCat.of A)} : Set (Spec (CommRingCat.of A))) :=
    isClosed_singleton_closedPoint (CommRingCat.of A)
  have hstalk :
      (Spec (CommRingCat.of A)).presheaf.stalk (closedPoint (CommRingCat.of A)) ≃+* A :=
    (stalkClosedPointIso (CommRingCat.of A)).commRingCatIsoToRingEquiv
  have hvi := vanishingIdeal_singleton_eq_ofIdealTop (closedPoint (CommRingCat.of A)) hz
  refine ⟨inferInstance, _, hz, IsRegularLocalRing.of_ringEquiv hstalk.symm,
    (ringKrullDim_eq_of_ringEquiv hstalk).trans hdim, ?_, ?_⟩
  · have h1 := congrArg (fun J : (Spec (CommRingCat.of A)).IdealSheafData =>
      J.comap (Stacks.Blowup.toSpec (maximalIdeal A))) hvi
    have h2 : (Scheme.IdealSheafData.ofIdealTop (Ideal.map
          (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (maximalIdeal A))).comap
            (Stacks.Blowup.toSpec (maximalIdeal A)) =
        Stacks.Blowup.exceptionalIdealData (maximalIdeal A) := by
      rw [ideal_map_ΓSpecIso_inv_eq_comap_hom]
      rfl
    exact (h1.trans h2).symm
  · obtain ⟨φ⟩ := nonempty_over_iso_blowUpToBase_vanishingIdeal A _ hz
    exact ⟨(Over.forget _).mapIso φ, Over.w φ.hom⟩

/-- Let `(A, 𝔪, κ)` be a regular local ring of dimension two and let `b : X ⟶ Spec A` be the
blowing up of `Spec A` in `𝔪`, with exceptional divisor `E` presented as an exceptional curve of
the first kind by `e : 𝐏¹_k ≅ E`. Then `Pic(X) ≃+ Pic(Spec A) × ℤ`, a class `ℒ` corresponding to
the pair `(ℒ', n)` with `n` the degree of `ℒ` on `E` exactly when `ℒ = (b^*ℒ')(-nE)`. -/
@[stacks 0C5M "the identification Pic(X) = Pic(X') ⊕ Z for the blowup of a regular local ring of \
dimension two in its maximal ideal: with nothing assumed, both hypotheses of the general \
decomposition discharged"]
public def picardDecomposition_exceptionalIdealData (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) (k : Type u) [Field k]
    {e : projectiveLineProj k ≅
      (Stacks.Blowup.exceptionalIdealData (maximalIdeal A)).subscheme}
    (hE : (Stacks.Blowup.exceptionalIdealData (maximalIdeal A)).IsExceptionalCurveOfFirstKind
      k e) :
    Stacks.Picard.ofScheme (Stacks.Blowup.blowUpSpec (maximalIdeal A)) ≃+
      Stacks.Picard.ofScheme (Spec (CommRingCat.of A)) × ℤ :=
  haveI := hE.isEffectiveCartierDivisor
  (Stacks.Blowup.exceptionalIdealData (maximalIdeal A)).picardDecompositionOfExactness k e
    (Stacks.Blowup.toSpec (maximalIdeal A))
    (isContractionOfExceptionalCurve_toSpec_maximalIdeal A hdim)
    (contractionPicardExactness_exceptionalIdealData A hdim k hE _) hE

/-- The homomorphism `ℒ ↦ ℒ'` of the blowup of a regular local ring of dimension two in its maximal
ideal. It sends a Picard class `ℒ` of the blowup to the unique class `ℒ'` on `Spec A` with
`ℒ(nE) = b^*ℒ'`, where `n` is the degree of `ℒ` on the exceptional curve. It is the
`Pic(Spec A)`-component of `AlgebraicGeometry.picardDecomposition_exceptionalIdealData`. -/
@[stacks 0C5M "the assignment L ↦ L' is a group homomorphism, for the blowup of a regular local \
ring of dimension two in its maximal ideal: with nothing assumed"]
public def contractedPicardHom_exceptionalIdealData (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) (k : Type u) [Field k]
    {e : projectiveLineProj k ≅
      (Stacks.Blowup.exceptionalIdealData (maximalIdeal A)).subscheme}
    (hE : (Stacks.Blowup.exceptionalIdealData (maximalIdeal A)).IsExceptionalCurveOfFirstKind
      k e) :
    Stacks.Picard.ofScheme (Stacks.Blowup.blowUpSpec (maximalIdeal A)) →+
      Stacks.Picard.ofScheme (Spec (CommRingCat.of A)) :=
  haveI := hE.isEffectiveCartierDivisor
  (Stacks.Blowup.exceptionalIdealData (maximalIdeal A)).contractedPicardHomOfExactness k e
    (Stacks.Blowup.toSpec (maximalIdeal A))
    (isContractionOfExceptionalCurve_toSpec_maximalIdeal A hdim)
    (contractionPicardExactness_exceptionalIdealData A hdim k hE _) hE

/-- The homomorphism `ℒ ↦ ℒ'` of the blowup is the `Pic(Spec A)`-component of the
decomposition. -/
public theorem picardDecomposition_exceptionalIdealData_apply_fst (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) (k : Type u) [Field k]
    {e : projectiveLineProj k ≅
      (Stacks.Blowup.exceptionalIdealData (maximalIdeal A)).subscheme}
    (hE : (Stacks.Blowup.exceptionalIdealData (maximalIdeal A)).IsExceptionalCurveOfFirstKind
      k e)
    (L : Stacks.Picard.ofScheme (Stacks.Blowup.blowUpSpec (maximalIdeal A))) :
    (picardDecomposition_exceptionalIdealData A hdim k hE L).1 =
      contractedPicardHom_exceptionalIdealData A hdim k hE L :=
  rfl

/-- **Stacks Project, Tag 0C5M for the blowup.** For a regular local ring `A` of dimension two, the
blowup `X` of `Spec A` in its maximal ideal satisfies `Pic(X) ≃+ Pic(Spec A) × ℤ`. -/
public theorem nonempty_picardDecomposition_exceptionalIdealData (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) :
    Nonempty (Stacks.Picard.ofScheme (Stacks.Blowup.blowUpSpec (maximalIdeal A)) ≃+
      Stacks.Picard.ofScheme (Spec (CommRingCat.of A)) × ℤ) :=
  ⟨picardDecomposition_exceptionalIdealData A hdim (ResidueField A)
    (Stacks.Blowup.exists_isExceptionalCurveOfFirstKind_exceptionalIdealData A hdim).choose_spec⟩

end AlgebraicGeometry

end
