module

public import StacksFrontier.AlgebraicGeometry.Surfaces.BlowUpNormality
public import StacksFrontier.RingTheory.Blowup.IntegrallyClosed

/-!
# Normality of a blowup from integral closedness of the powers of its centre

## Main results

* `AlgebraicGeometry.isNormal_blowUp_ofIdealTop_of_forall_isIntegrallyClosed_pow`: the blowup of
  an affine scheme whose global functions form an integrally closed domain, in an ideal all of
  whose powers are integrally closed ideals, is normal.
* `AlgebraicGeometry.isNormal_blowUp_maximalIdeal_of_forall_isIntegrallyClosed_pow` and
  `AlgebraicGeometry.isNormal_blowUp_maximalIdeal_of_forall_two_le_isIntegrallyClosed_pow`: the
  blowup of the spectrum of a local integrally closed domain in its maximal ideal `𝔪` is normal
  as soon as `𝔪ⁿ` is an integrally closed ideal for every `n ≥ 2`.
* `AlgebraicGeometry.isNormal_blowUp_ofIdealTop_span_singleton` and
  `AlgebraicGeometry.isNormal_blowUp_maximalIdeal_of_maximalIdeal_eq_span_singleton`: the blowup
  in a principal ideal of an integrally closed domain is normal; in particular so is the blowup of
  a discrete valuation ring in its maximal ideal.
* `AlgebraicGeometry.isNormal_blowUp_maximalIdeal_of_forall_two_le_isIntegral_affineBlowup`: the
  blowup of the spectrum of a local integrally closed domain in its maximal ideal `𝔪` is normal as
  soon as, for each `n ≥ 2`, some chart `A[𝔪/t]` separates `𝔪ⁿ`: every `x` with `x / tⁿ`
  integral over `A[𝔪/t]` lies in `𝔪ⁿ`.
-/

@[expose] public noncomputable section

universe v u

namespace AlgebraicGeometry

open CategoryTheory TopologicalSpace

/-- The blowup of an affine scheme `X` in an ideal `J` of `Γ(X, ⊤)` all of whose powers are
integrally closed ideals is normal, when `Γ(X, ⊤)` is an integrally closed domain. -/
public theorem isNormal_blowUp_ofIdealTop_of_forall_isIntegrallyClosed_pow {X : Scheme.{u}}
    [IsAffine X] [IsDomain Γ(X, ⊤)] [IsIntegrallyClosed Γ(X, ⊤)] (J : Ideal Γ(X, ⊤))
    (hclosed : ∀ n : ℕ, (J ^ n).IsIntegrallyClosed) :
    IsNormal (blowUp (Scheme.IdealSheafData.ofIdealTop J)) := by
  refine (isNormal_blowUp_ofIdealTop_iff J).2 fun a ha => ?_
  rw [affineBlowupAlgebra_eq_basicBlowup]
  by_cases h0 : a = 0
  · subst h0
    have : Subsingleton (Localization.Away (0 : Γ(X, ⊤))) :=
      IsLocalization.subsingleton (M := Submonoid.powers (0 : Γ(X, ⊤))) ⟨1, pow_one 0⟩
    exact isNormalRing_of_subsingleton _
  · let : IsDomain (affineBlowup J a) := affineBlowup_isDomain J a h0
    let : IsIntegrallyClosed (affineBlowup J a) := isIntegrallyClosed_affineBlowup ha h0 hclosed
    exact IsNormalRing.of_isIntegrallyClosed _

/-- The blowup of the spectrum of a local integrally closed domain `A` in its maximal ideal is
normal as soon as every power of the maximal ideal is an integrally closed ideal. The centre is
the ideal of `Γ(Spec A, ⊤)` generated by the image of the maximal ideal under the inverse of
`Γ(Spec A, ⊤) ≅ A`. -/
public theorem isNormal_blowUp_maximalIdeal_of_forall_isIntegrallyClosed_pow (A : Type u)
    [CommRing A] [IsLocalRing A] [IsDomain A] [IsIntegrallyClosed A]
    (hclosed : ∀ n : ℕ, ((IsLocalRing.maximalIdeal A) ^ n).IsIntegrallyClosed) :
    IsNormal (blowUp (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom (IsLocalRing.maximalIdeal A)))) := by
  let : IsDomain Γ(Spec (CommRingCat.of A), ⊤) :=
    Function.Injective.isDomain
      ((Scheme.ΓSpecIso (CommRingCat.of A)).commRingCatIsoToRingEquiv : _ →+* A)
      (Scheme.ΓSpecIso (CommRingCat.of A)).commRingCatIsoToRingEquiv.injective
  let : IsIntegrallyClosed Γ(Spec (CommRingCat.of A), ⊤) :=
    (IsNormalRing.congr (Scheme.ΓSpecIso (CommRingCat.of A)).symm.commRingCatIsoToRingEquiv
      (IsNormalRing.of_isIntegrallyClosed A)).isIntegrallyClosed
  refine isNormal_blowUp_ofIdealTop_of_forall_isIntegrallyClosed_pow _ fun n => ?_
  rw [← Ideal.map_pow]
  exact Ideal.isIntegrallyClosed_map_of_inverse _ (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom
    (fun x => by simp) (fun y => by simp) (hclosed n)

/-- The blowup of the spectrum of a local integrally closed domain `A` in its maximal ideal `𝔪` is
normal as soon as `𝔪ⁿ` is an integrally closed ideal for every `n ≥ 2`. -/
public theorem isNormal_blowUp_maximalIdeal_of_forall_two_le_isIntegrallyClosed_pow (A : Type u)
    [CommRing A] [IsLocalRing A] [IsDomain A] [IsIntegrallyClosed A]
    (hclosed : ∀ n : ℕ, 2 ≤ n → ((IsLocalRing.maximalIdeal A) ^ n).IsIntegrallyClosed) :
    IsNormal (blowUp (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom (IsLocalRing.maximalIdeal A)))) := by
  refine isNormal_blowUp_maximalIdeal_of_forall_isIntegrallyClosed_pow A fun n => ?_
  match n, hclosed with
  | 0, _ => simpa only [pow_zero, Ideal.one_eq_top] using Ideal.isIntegrallyClosed_top
  | 1, _ => simpa only [pow_one] using Ideal.isIntegrallyClosed_maximalIdeal A
  | (n + 2), h => exact h (n + 2) (by omega)

/-- The blowup of an affine scheme `X` in a principal ideal of `Γ(X, ⊤)` is normal, when
`Γ(X, ⊤)` is an integrally closed domain. -/
public theorem isNormal_blowUp_ofIdealTop_span_singleton {X : Scheme.{u}} [IsAffine X]
    [IsDomain Γ(X, ⊤)] [IsIntegrallyClosed Γ(X, ⊤)] (a : Γ(X, ⊤)) :
    IsNormal (blowUp (Scheme.IdealSheafData.ofIdealTop (Ideal.span {a}))) :=
  isNormal_blowUp_ofIdealTop_of_forall_isIntegrallyClosed_pow _
    (Ideal.isIntegrallyClosed_pow_span_singleton a)

/-- The blowup of the spectrum of an integrally closed local domain whose maximal ideal is
principal, for instance a discrete valuation ring, in its maximal ideal is normal. -/
public theorem isNormal_blowUp_maximalIdeal_of_maximalIdeal_eq_span_singleton (A : Type u)
    [CommRing A] [IsLocalRing A] [IsDomain A] [IsIntegrallyClosed A] (t : A)
    (ht : IsLocalRing.maximalIdeal A = Ideal.span {t}) :
    IsNormal (blowUp (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom (IsLocalRing.maximalIdeal A)))) := by
  refine isNormal_blowUp_maximalIdeal_of_forall_isIntegrallyClosed_pow A fun n => ?_
  rw [ht]
  exact Ideal.isIntegrallyClosed_pow_span_singleton t n

/-- Let `A` be a local integrally closed domain with maximal ideal `𝔪`. If for each `n ≥ 2`
there is `t : A` such that every `x : A` with `x / tⁿ` integral over the affine blowup algebra
`A[𝔪/t]` lies in `𝔪ⁿ`, then the blowup of `Spec A` in `𝔪` is normal. -/
public theorem isNormal_blowUp_maximalIdeal_of_forall_two_le_isIntegral_affineBlowup (A : Type u)
    [CommRing A] [IsLocalRing A] [IsDomain A] [IsIntegrallyClosed A]
    (hchart : ∀ n : ℕ, 2 ≤ n → ∃ t : A, ∀ x : A,
      _root_.IsIntegral ↥(affineBlowup (IsLocalRing.maximalIdeal A) t)
          (Localization.mk x ⟨t ^ n, n, rfl⟩ : Localization.Away t) →
        x ∈ IsLocalRing.maximalIdeal A ^ n) :
    IsNormal (blowUp (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom (IsLocalRing.maximalIdeal A)))) := by
  refine isNormal_blowUp_maximalIdeal_of_forall_two_le_isIntegrallyClosed_pow A fun n hn => ?_
  obtain ⟨t, ht⟩ := hchart n hn
  exact Ideal.isIntegrallyClosed_pow_of_isIntegral_affineBlowup _ t n ht


end AlgebraicGeometry

end
