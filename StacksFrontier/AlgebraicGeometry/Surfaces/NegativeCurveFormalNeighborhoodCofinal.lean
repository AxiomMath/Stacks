module

public import StacksFrontier.AlgebraicGeometry.Surfaces.NegativeCurveFormalNeighborhoodConormalPowers
public import StacksFrontier.AlgebraicGeometry.Surfaces.NegativeCurveFormalNeighborhoodTopology

/-!
# `I² ⊆ 𝔪 · 𝒪` near a curve of genus one with conormal bundle `𝒪(p)`

Let `D` be an effective Cartier divisor on a scheme `X`, with subscheme `C`, conormal sheaf `L` and
ring of compatible functions `A` on the thickenings, with maximal ideal `𝔪` when `A` is local.

* `AlgebraicGeometry.Scheme.IdealSheafData.pow_le_comap_map_formalNeighborhoodChart_of_chart`:
  over an affine open `V`, if the presentations of the symbols of the global sections of `Lⁿ⁺¹`
  generate `I(V)ⁿ⁺¹` modulo `I(V)ⁿ⁺²`, then `I(V)ⁿ⁺¹ ⊆ F₁ · Γ(X, V) + I(V)^{M+1}` for every `M`.
* `AlgebraicGeometry.Scheme.IdealSheafData.le_span_chartGlobalSymbols_of_nonvanishing`: on a chart
  where `D` is cut out by a nonzerodivisor, that generation holds as soon as **`Lⁿ⁺¹` is generated
  by global sections at every point of `C` over the chart**.
* `AlgebraicGeometry.Scheme.IdealSheafData.pow_le_comap_map_maximalIdeal_pow_of_genusOne`: for `C`
  a curve of genus one and `L ≅ 𝒪_C(p)`, `L² = 𝒪_C(2p)` is globally generated (by `s²` off `p`,
  for `s` the canonical section of `𝒪(p)`, and by a section of order `0` at `p`), hence
  `I(V)^{2k} ⊆ 𝔪^k · Γ(X, V) + I(V)^{M+1}` on every chart `V` where `D` is principal. These charts
  cover `C`, so the closed subschemes `V(𝔪^k 𝒪)` of the formal neighbourhood are cofinal with the
  thickenings `C_M`.
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite Stacks.Divisors
open AlgebraicGeometry.GenusOne
open Stacks.TensorPowers (natTensorPow)
open Stacks.SectionProduct (globalSection)

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}} (D : X.IdealSheafData) [IsEffectiveCartierDivisor D]

/-! ### Cofinality over one chart -/

/-- **`Iⁿ⁺¹ ⊆ F₁ 𝒪_X` over one affine open.** If the transition maps of the thickenings are
surjective and, over the affine open `V`, the presentations of the symbols of the global sections
of `Lⁿ⁺¹` generate `I(V)ⁿ⁺¹` modulo `I(V)ⁿ⁺²`, then for every `M` the ideal `I(V)ⁿ⁺¹` maps into the
ideal of `Γ(X, V) / I(V)^{M+1}` generated by the image of `F₁`. -/
public theorem pow_le_comap_map_formalNeighborhoodChart_of_chart
    (hsurj : ∀ m, Function.Surjective (thickeningRestriction D m)) {n : ℕ}
    (V : X.affineOpens)
    (hgg : D.ideal V ^ (n + 1) ≤ Ideal.span (chartGlobalSymbols D V n) ⊔ D.ideal V ^ (n + 2))
    (M : ℕ) :
    D.ideal V ^ (n + 1) ≤ Ideal.comap (Ideal.Quotient.mk (D.ideal V ^ (M + 1)))
      (Ideal.map (formalNeighborhoodChart D V M) (formalNeighborhoodFiltration D 1)) := by
  obtain ⟨K, hK⟩ : ∃ K : Ideal Γ(X, V.1), K = Ideal.comap
      (Ideal.Quotient.mk (D.ideal V ^ (M + 1)))
      (Ideal.map (formalNeighborhoodChart D V M) (formalNeighborhoodFiltration D 1)) := ⟨_, rfl⟩
  rw [← hK]
  have hker : D.ideal V ^ (M + 1) ≤ K := fun b hb => by
    rw [hK, Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.2 hb]
    exact zero_mem _
  rcases lt_or_ge M (n + 1) with hM | hM
  · exact (Ideal.pow_le_pow_right (by omega)).trans hker
  have hstep : D.ideal V ^ (n + 1) ≤ K ⊔ D.ideal V ^ (n + 1 + 1) := by
    refine hgg.trans (sup_le ?_ le_sup_right)
    rw [Ideal.span_le]
    rintro b ⟨x, hx⟩
    obtain ⟨a, ha, hax⟩ := exists_projection_eq_of_thickeningRestriction_eq_zero D n hsurj
      ((gradedSectionsHom_eq_iff D n _).2 ⟨x, rfl⟩)
    obtain ⟨b', hb'⟩ := Ideal.Quotient.mk_surjective (formalNeighborhoodChart D V M a)
    have hb'c := (formalNeighborhoodChart_eq_mk_iff D V M a b').1 hb'.symm
    have hle := thickeningChartSection_eq_of_le D V hM _ b' hb'c
    rw [thickeningRestrictionLE_formalNeighborhoodProjection, hax] at hle
    have hdiff : b - b' ∈ D.ideal V ^ (n + 1 + 1) := by
      rw [← thickeningChartSection_eq_zero_iff, map_sub, hx, hle, sub_self]
    refine Submodule.mem_sup.2 ⟨b', ?_, b - b', hdiff, by ring⟩
    rw [hK, Ideal.mem_comap, hb']
    exact Ideal.mem_map_of_mem _
      ((isCompleteFiltration_formalNeighborhoodFiltration D).antitone (by omega) ha)
  have h := Ideal.pow_le_sup_pow_add_of_le_sup_pow_succ hstep (M + 1 - (n + 1))
  rw [show n + 1 + (M + 1 - (n + 1)) = M + 1 by omega] at h
  exact h.trans (sup_le le_rfl hker)

/-! ### Global generation gives the generation hypothesis -/

/-- The point of an affine open `V` over a prime of `Γ(X, V)`, with that prime as its
`AlgebraicGeometry.Scheme.IdealSheafData.chartPrime`. -/
private theorem exists_mem_chartPrime_eq (V : X.affineOpens) (P : Ideal Γ(X, V.1)) [P.IsPrime] :
    ∃ (x : X) (hx : x ∈ V.1), chartPrime V.1 x hx = P := by
  have hV : IsAffineOpen V.1 := V.2
  set y : Spec Γ(X, V.1) := (⟨P, inferInstance⟩ : PrimeSpectrum Γ(X, V.1))
  have hx : hV.fromSpec y ∈ V.1 := by
    have h : hV.fromSpec y ∈ Set.range hV.fromSpec := ⟨y, rfl⟩
    rwa [hV.range_fromSpec] at h
  refine ⟨hV.fromSpec y, hx, ?_⟩
  have := hV.isOpenImmersion_fromSpec
  have hinj : hV.primeIdealOf ⟨hV.fromSpec y, hx⟩ = y :=
    hV.fromSpec.isOpenEmbedding.injective (hV.fromSpec_primeIdealOf ⟨hV.fromSpec y, hx⟩)
  have h := congrArg PrimeSpectrum.asIdeal hinj
  rw [IsAffineOpen.primeIdealOf_eq_map_closedPoint] at h
  exact h

/-- A global section of `Lⁿ⁺¹` lifts to `a ∈ Fₙ₊₁` presented over a principal chart by `tⁿ⁺¹ h`,
and `tⁿ⁺¹ h` presents the symbol of the section. -/
private theorem exists_lift_presentation
    (hsurj : ∀ m, Function.Surjective (thickeningRestriction D m)) {V : X.affineOpens}
    {t : Γ(X, V.1)} (hVt : D.ideal V = Ideal.span {t}) {n : ℕ}
    (σ : conormalPowSections D n) :
    ∃ (a : formalNeighborhoodRing D) (h : Γ(X, V.1)),
      a ∈ formalNeighborhoodFiltration D (n + 1) ∧
      gradedSectionsHom D n σ = formalNeighborhoodProjection D (n + 1) a ∧
      formalNeighborhoodChart D V (n + 1) a = Ideal.Quotient.mk _ (t ^ (n + 1) * h) ∧
      t ^ (n + 1) * h ∈ chartGlobalSymbols D V n := by
  obtain ⟨a, ha, haσ⟩ := exists_projection_eq_of_thickeningRestriction_eq_zero D n hsurj
    ((gradedSectionsHom_eq_iff D n _).2 ⟨σ, rfl⟩)
  obtain ⟨h, hh⟩ := exists_formalNeighborhoodChart_eq_mk_pow_mul hVt (N := n + 1)
    (by omega) ha
  refine ⟨a, h, ha, haσ.symm, hh, σ, ?_⟩
  have hc := (formalNeighborhoodChart_eq_mk_iff D V (n + 1) a _).1 hh
  rwa [haσ] at hc

/-- **Global generation of `Lⁿ⁺¹` over a principal chart gives the generation hypothesis of the
cofinality theorem.** On an affine open `V` where `D` is cut out by a nonzerodivisor `t`, if every
point of `C` over `V` has a global section of `Lⁿ⁺¹` not vanishing there, the presentations of the
symbols of the global sections generate `I(V)ⁿ⁺¹` modulo `I(V)ⁿ⁺²`. -/
public theorem le_span_chartGlobalSymbols_of_nonvanishing
    (hsurj : ∀ m, Function.Surjective (thickeningRestriction D m)) {V : X.affineOpens}
    {t : Γ(X, V.1)} (ht : t ∈ nonZeroDivisors Γ(X, V.1)) (hVt : D.ideal V = Ideal.span {t})
    {n : ℕ}
    (hnv : ∀ (x' : D.subscheme), D.subschemeι.base x' ∈ V.1 → ∃ σ : conormalPowSections D n,
      (((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (n + 1)))).presheaf.Γgerm
        x').hom σ ∉ Stacks.ModuleStalk.maximalSmul
          ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (n + 1)))) x') :
    D.ideal V ^ (n + 1) ≤ Ideal.span (chartGlobalSymbols D V n) ⊔ D.ideal V ^ (n + 2) := by
  have hJ : ∀ m, D.ideal V ^ m = Ideal.span {t ^ m} := fun m => by
    rw [hVt, Ideal.span_singleton_pow]
  have hpres := fun σ => exists_lift_presentation D hsurj hVt (n := n) σ
  choose a h ha haσ hach hasym using hpres
  -- The coefficients `h σ` and `t` generate the unit ideal.
  have htop : Ideal.span (Set.range h) ⊔ Ideal.span {t} = ⊤ := by
    by_contra hne
    obtain ⟨P, hPmax, hP⟩ := Ideal.exists_le_maximal _ hne
    obtain ⟨x, hx, hxP⟩ := exists_mem_chartPrime_eq V P
    have htP : t ∈ chartPrime V.1 x hx := hxP ▸ hP (le_sup_right (b := Ideal.span {t})
      (Ideal.mem_span_singleton_self t))
    have hxD : x ∈ D.support := by
      rw [mem_support_iff_of_mem hx, Scheme.mem_zeroLocus_iff]
      intro f hf hxf
      have hf' : f ∈ D.ideal V := hf
      rw [hVt, Ideal.mem_span_singleton'] at hf'
      obtain ⟨c, rfl⟩ := hf'
      clear hf
      rw [Scheme.mem_basicOpen _ _ _ hx, map_mul] at hxf
      exact (IsLocalRing.mem_maximalIdeal _).1 htP (isUnit_of_mul_isUnit_right hxf)
    obtain ⟨x', rfl⟩ : x ∈ Set.range D.subschemeι.base := by rwa [range_subschemeι]
    obtain ⟨σ, hσ⟩ := hnv x' hx
    have hval := mt (germ_mem_maximalSmul_iff_chartPointValue_eq_zero ht hVt x' hx n σ
      (haσ σ)).2 hσ
    rw [chartPointValue, chartLeadingCoeff_eq ht hVt le_rfl (hach σ), Ideal.Quotient.factor_mk,
      Ideal.Quotient.eq_zero_iff_mem] at hval
    exact hval (hxP ▸ hP (le_sup_left (a := Ideal.span (Set.range h))
      (Ideal.subset_span ⟨σ, rfl⟩)))
  rw [hJ (n + 1), hJ (n + 2), ← Ideal.mul_top (Ideal.span {t ^ (n + 1)}), ← htop, Ideal.mul_sup]
  refine sup_le_sup ?_ ?_
  · rw [Ideal.span_mul_span, Ideal.span_le]
    rintro _ ⟨_, rfl, _, ⟨σ, rfl⟩, rfl⟩
    exact Ideal.subset_span (hasym σ)
  · rw [Ideal.span_singleton_mul_span_singleton, ← pow_succ]

/-! ### Curves of genus one -/

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

attribute [local implicit_reducible] Stacks.TensorPowers.natTensorPow

section GenusOne

variable {k : Type u} [Field k] {X : Scheme.{u}} {D : X.IdealSheafData}
  [IsEffectiveCartierDivisor D] [D.subscheme.Over (Spec (.of k))]
  [IsProper (D.subscheme ↘ Spec (.of k))] [SmoothOfRelativeDimension 1 (D.subscheme ↘ Spec (.of k))]
  (h0 : Module.finrank k (structureSheafCohomology (D.subscheme ↘ Spec (.of k)) 0) = 1)
  (hg : genus (D.subscheme ↘ Spec (.of k)) = 1) (p : Spec (.of k) ⟶ D.subscheme)
  (hp : p ≫ (D.subscheme ↘ Spec (.of k)) = 𝟙 _)
  [IsEffectiveCartierDivisor (vanishingIdeal
    (⟨{point p}, isClosed_point (D.subscheme ↘ Spec (.of k)) p hp⟩ : Closeds D.subscheme) ^ 1)]
  (φ : ∀ n : ℕ, (Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (n + 1))) ≅
    natTensorPow (pointDivisorSheaf p hp 1) (n + 1))

omit [IsEffectiveCartierDivisor D] [SmoothOfRelativeDimension 1 (D.subscheme ↘ Spec (.of k))] in
include φ in
/-- **The canonical section of `L ≅ 𝒪(p)` vanishes only at `p`.** -/
private theorem exists_conormal_section_nonvanishing_off :
    ∃ s : conormalPowSections D 0, ∀ x' : D.subscheme, x' ≠ point p →
      (((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (0 + 1)))).presheaf.Γgerm
        x').hom s ∉ Stacks.ModuleStalk.maximalSmul
          ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (0 + 1)))) x' := by
  set τ := globalSection D.subscheme _
    (pointSection (isClosed_point (D.subscheme ↘ Spec (.of k)) p hp) 1)
  refine ⟨(φ 0).inv.app ⊤ τ, fun x' hx' => ?_⟩
  rw [← Stacks.ModuleStalk.mem_maximalSmul_mapFun_iff (φ 0), Stacks.ModuleStalk.mapFun_Γgerm]
  change ((natTensorPow (pointDivisorSheaf p hp 1) (0 + 1)).presheaf.Γgerm x').hom
    (((φ 0).inv ≫ (φ 0).hom).app ⊤ τ) ∉ _
  rw [(φ 0).inv_hom_id]
  exact mem_nonvanishingOpen_pointSection (isClosed_point (D.subscheme ↘ Spec (.of k)) p hp) 1
    one_pos x' hx'

include h0 hg φ in
/-- **`L² ≅ 𝒪(2p)` is generated by global sections at every point of a principal chart**: by a
section of order `0` at `p`, and by `s²` off `p`. -/
private theorem nonvanishing_conormal_sq
    (hsurj : ∀ m, Function.Surjective (thickeningRestriction D m))
    {V : X.affineOpens} {t : Γ(X, V.1)} (ht : t ∈ nonZeroDivisors Γ(X, V.1))
    (hVt : D.ideal V = Ideal.span {t}) (x' : D.subscheme) (hx : D.subschemeι.base x' ∈ V.1) :
    ∃ σ : conormalPowSections D 1,
      (((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (1 + 1)))).presheaf.Γgerm
        x').hom σ ∉ Stacks.ModuleStalk.maximalSmul
          ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (1 + 1)))) x' := by
  by_cases hxp : x' = point p
  · subst hxp
    exact exists_germ_notMem_maximalSmul_conormal h0 hg p hp φ le_rfl
  obtain ⟨s, hs⟩ := exists_conormal_section_nonvanishing_off p hp φ
  obtain ⟨a, ha, has⟩ := exists_projection_eq_of_thickeningRestriction_eq_zero D 0 hsurj
    ((gradedSectionsHom_eq_iff D 0 _).2 ⟨s, rfl⟩)
  have hP := ideal_le_chartPrime D V hx (subschemeι_mem_support x')
  have hdom : IsDomain (Γ(X, V.1) ⧸ chartPrime V.1 (D.subschemeι.base x') hx) :=
    Ideal.Quotient.isDomain _
  have hva : chartPointValue D V t hP (0 + 1) a ≠ 0 := fun h =>
    hs x' hxp ((germ_mem_maximalSmul_iff_chartPointValue_eq_zero ht hVt x' hx 0 s has.symm).2 h)
  have haa : a * a ∈ formalNeighborhoodFiltration D (1 + 1) :=
    (isCompleteFiltration_formalNeighborhoodFiltration D).mul_le 1 1 (Ideal.mul_mem_mul ha ha)
  obtain ⟨σ, hσ⟩ := (gradedSectionsHom_eq_iff D 1 _).1
    (thickeningRestriction_projection_eq_zero D 1 haa)
  refine ⟨σ, fun hmem => ?_⟩
  have hv := (germ_mem_maximalSmul_iff_chartPointValue_eq_zero ht hVt x' hx 1 σ hσ).1 hmem
  rw [chartPointValue_mul hP ht hVt (show 1 + 1 = 1 + 1 from rfl) ha ha] at hv
  exact hva (mul_self_eq_zero.1 hv)

include h0 hg φ in
/-- **`I² ⊆ 𝔪 · 𝒪` near a curve of genus one with conormal bundle `𝒪(p)`.** On every affine open
`V` of `X` on which `D` is cut out by a nonzerodivisor (these cover `C`), for all `M` and `k`,
`I(V)^{2k}` maps into `𝔪^k · Γ(X, V) / I(V)^{M+1}`, where `𝔪` is the maximal ideal of the complete
Noetherian local ring of compatible functions. -/
public theorem pow_le_comap_map_maximalIdeal_pow_of_genusOne {V : X.affineOpens}
    {t : Γ(X, V.1)} (ht : t ∈ nonZeroDivisors Γ(X, V.1)) (hVt : D.ideal V = Ideal.span {t})
    (M k : ℕ) :
    letI := (formalNeighborhoodRing_of_genusOne h0 hg p hp φ).1.isLocal
    D.ideal V ^ (2 * k) ≤ Ideal.comap (Ideal.Quotient.mk (D.ideal V ^ (M + 1)))
      (Ideal.map (formalNeighborhoodChart D V M)
        (IsLocalRing.maximalIdeal (formalNeighborhoodRing D) ^ k)) := by
  let _ := (formalNeighborhoodRing_of_genusOne h0 hg p hp φ).1.isLocal
  have hsurj := surjective_thickeningRestriction_of_isZero D
    (isZero_H1_conormalPow_of_genusOne h0 hg p hp φ)
  have hA := isField_quotient_formalNeighborhoodFiltration_one_of_isField D
    (surjective_formalNeighborhoodProjection D hsurj 0) (isField_sections_of_genusOne (D := D) h0)
  have hm : IsLocalRing.maximalIdeal (formalNeighborhoodRing D) =
      formalNeighborhoodFiltration D 1 :=
    (IsLocalRing.eq_maximalIdeal (Ideal.Quotient.maximal_of_isField _ hA)).symm
  have hgg := le_span_chartGlobalSymbols_of_nonvanishing D hsurj ht hVt (n := 1)
    (nonvanishing_conormal_sq h0 hg p hp φ hsurj ht hVt)
  have base := pow_le_comap_map_formalNeighborhoodChart_of_chart D hsurj V hgg M
  rw [pow_mul, hm, Ideal.map_pow]
  exact (Ideal.pow_right_mono base k).trans (Ideal.le_comap_pow _ k)

end GenusOne

/-- **`I² ⊆ 𝔪 · 𝒪` near a curve of genus one with conormal bundle `𝒪(p)`, from the one
isomorphism `𝒪_X(-D)|_C ≅ 𝒪_C(p)`.** On every affine open `V` of `X` on which `D` is cut out by a
nonzerodivisor, for all `M` and `k`, `I(V)^{2k}` maps into `𝔪^k · Γ(X, V) / I(V)^{M+1}`. -/
public theorem pow_le_comap_map_maximalIdeal_pow_of_genusOne_of_iso {k : Type u} [Field k]
    {X : Scheme.{u}} {D : X.IdealSheafData} [IsEffectiveCartierDivisor D]
    [D.subscheme.Over (Spec (.of k))] [IsProper (D.subscheme ↘ Spec (.of k))]
    [SmoothOfRelativeDimension 1 (D.subscheme ↘ Spec (.of k))]
    (h0 : Module.finrank k (structureSheafCohomology (D.subscheme ↘ Spec (.of k)) 0) = 1)
    (hg : genus (D.subscheme ↘ Spec (.of k)) = 1) (p : Spec (.of k) ⟶ D.subscheme)
    (hp : p ≫ (D.subscheme ↘ Spec (.of k)) = 𝟙 _)
    [IsEffectiveCartierDivisor (vanishingIdeal
      (⟨{point p}, isClosed_point (D.subscheme ↘ Spec (.of k)) p hp⟩ : Closeds D.subscheme) ^ 1)]
    (ψ : (Scheme.Modules.pullback D.subschemeι).obj (negativeTwist D) ≅
      pointDivisorSheaf p hp 1)
    {V : X.affineOpens} {t : Γ(X, V.1)} (ht : t ∈ nonZeroDivisors Γ(X, V.1))
    (hVt : D.ideal V = Ideal.span {t}) (M k' : ℕ) :
    letI := (formalNeighborhoodRing_of_genusOne_of_iso h0 hg p hp ψ).1.isLocal
    D.ideal V ^ (2 * k') ≤ Ideal.comap (Ideal.Quotient.mk (D.ideal V ^ (M + 1)))
      (Ideal.map (formalNeighborhoodChart D V M)
        (IsLocalRing.maximalIdeal (formalNeighborhoodRing D) ^ k')) :=
  pow_le_comap_map_maximalIdeal_pow_of_genusOne h0 hg p hp
    (fun n => (nonempty_pullback_negativeTwist_pow_iso D _ ψ n).some) ht hVt M k'

end AlgebraicGeometry.Scheme.IdealSheafData

end
