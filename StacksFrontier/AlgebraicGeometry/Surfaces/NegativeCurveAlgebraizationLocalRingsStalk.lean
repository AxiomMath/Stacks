module

public import StacksFrontier.AlgebraicGeometry.F6Rank89.IdealSheafStalk
public import StacksFrontier.AlgebraicGeometry.Morphisms.Support.TestModuleStalk
public import StacksFrontier.AlgebraicGeometry.Picard.FamilyFittingIdeal
public import StacksFrontier.AlgebraicGeometry.Groupoids.More.LocalStructure.StalkConormal

/-!
# Kernels of the maps on local rings of closed immersions

For a closed subscheme `X' ⊆ Y` the map `𝒪_{Y, y} ⟶ 𝒪_{X', y}` of local rings is surjective,
and this file bounds its kernel in two situations met in the construction of Stacks 0D5E:

* when `X' = Y ×_{Spec R} Spec (R ⧸ J)` is the base change of `Spec (R ⧸ J) ⟶ Spec R` along a
  morphism `f : Y ⟶ Spec R`, the kernel is the ideal generated by the image of `J`; so for
  `J = K ^ (m + 1)` it lies in `𝔪_{Y, y} ^ (m + 1)`;
* when `X' = V(J ^ (m + 1))` is cut out by a power of an ideal sheaf, the kernel lies in
  `𝔪_{Y, y} ^ (m + 1)`.

## Main results

* `AlgebraicGeometry.ker_comp_le_maximalIdeal_pow`: kernels in powers of the maximal ideals
  compose along a surjection.
* `AlgebraicGeometry.ker_stalkMap_eq_map_of_isPullback`: the kernel of the map of local rings
  of a base change of `Spec (R ⧸ J) ⟶ Spec R` is generated by the image of `J`.
* `AlgebraicGeometry.ker_stalkMap_le_maximalIdeal_pow_of_isPullback`: for `J = K ^ (m + 1)` it
  lies in the `(m + 1)`-st power of the maximal ideal.
* `AlgebraicGeometry.ker_stalkMap_subschemeι_pow_le_maximalIdeal_pow`: the same for the closed
  subscheme cut out by the `(m + 1)`-st power of an ideal sheaf.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u

namespace AlgebraicGeometry

/-- The kernel of a local homomorphism of local rings lies in the maximal ideal. -/
theorem ker_le_maximalIdeal_of_isLocalHom {B T : Type*} [CommRing B] [CommRing T]
    [IsLocalRing B] [IsLocalRing T] (g : B →+* T) [IsLocalHom g] :
    RingHom.ker g ≤ maximalIdeal B := by
  intro b hb
  rw [← maximalIdeal_comap g, Ideal.mem_comap, RingHom.mem_ker.mp hb]
  exact zero_mem _

/-- If the kernel of a local homomorphism of local rings is the `(m + 1)`-st power of an ideal,
it lies in the `(m + 1)`-st power of the maximal ideal. -/
theorem ker_le_maximalIdeal_pow_of_eq_pow {B T : Type*} [CommRing B] [CommRing T]
    [IsLocalRing B] [IsLocalRing T] (g : B →+* T) [IsLocalHom g] {K : Ideal B} {m : ℕ}
    (hK : RingHom.ker g = K ^ (m + 1)) : RingHom.ker g ≤ maximalIdeal B ^ (m + 1) := by
  have h := ker_le_maximalIdeal_of_isLocalHom g
  rw [hK] at h ⊢
  exact Ideal.pow_right_mono (Ideal.IsPrime.le_of_pow_le h) _

/-- A composite `A ⟶ B ⟶ C` of a surjection of local rings with kernel in `𝔪_A ^ m` and a map
with kernel in `𝔪_B ^ m` has kernel in `𝔪_A ^ m`. -/
theorem ker_comp_le_maximalIdeal_pow {A B C : Type*} [CommRing A] [CommRing B] [CommRing C]
    [IsLocalRing A] [IsLocalRing B] (ρ : A →+* B) (hρ : Function.Surjective ρ) (σ : B →+* C)
    {m : ℕ} (h₁ : RingHom.ker σ ≤ maximalIdeal B ^ m) (h₂ : RingHom.ker ρ ≤ maximalIdeal A ^ m) :
    RingHom.ker (σ.comp ρ) ≤ maximalIdeal A ^ m := by
  intro r hr
  have h : ρ r ∈ (maximalIdeal A ^ m).map ρ := by
    rw [Ideal.map_pow, map_maximalIdeal_of_surjective ρ hρ]
    exact h₁ (by simpa using hr)
  rw [← Ideal.mem_comap, Ideal.comap_map_of_surjective' ρ hρ] at h
  exact sup_le le_rfl h₂ h

/-- The stalk map of a preimmersion at a prescribed image point is surjective. -/
theorem Scheme.Hom.surjective_stalkMapAt {X Y : Scheme.{u}} (f : X ⟶ Y) [IsPreimmersion f]
    (x : X) (y : Y) (h : f x = y) : Function.Surjective (f.stalkMapAt x y h) := by
  subst h
  simpa [Scheme.Hom.stalkMapAt] using f.stalkMap_surjective x

/-- A bound on the kernel of a stalk map transfers to the stalk map at a prescribed image
point. -/
theorem Scheme.Hom.ker_stalkMapAt_le {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X) (y : Y)
    (h : f x = y) {m : ℕ}
    (H : RingHom.ker (f.stalkMap x).hom ≤ maximalIdeal (Y.presheaf.stalk (f x)) ^ m) :
    RingHom.ker (f.stalkMapAt x y h) ≤ maximalIdeal (Y.presheaf.stalk y) ^ m := by
  subst h
  simpa [Scheme.Hom.stalkMapAt] using H

/-- **The kernel of the map of local rings of a base change of `Spec (R ⧸ J) ⟶ Spec R`.** Let
`f : Y ⟶ Spec R` and let `X' = Y ×_{Spec R} Spec (R ⧸ J)` with projection `i : X' ⟶ Y`. Then
the kernel of `𝒪_{Y, i x} ⟶ 𝒪_{X', x}` is the ideal generated by the image of `J` under
`R ⟶ Γ(Y, 𝒪_Y) ⟶ 𝒪_{Y, i x}`. -/
theorem ker_stalkMap_eq_map_of_isPullback {R : CommRingCat.{u}} {Y X' : Scheme.{u}}
    (f : Y ⟶ Spec R) (J : Ideal R) (i : X' ⟶ Y) (j : X' ⟶ Spec (.of (R ⧸ J)))
    (h : IsPullback i j f (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))) (x : X') :
    RingHom.ker (i.stalkMap x).hom =
      J.map ((Scheme.ΓSpecIso R).inv ≫ f.appTop ≫ Y.presheaf.germ ⊤ (i x) trivial).hom := by
  let ι := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))
  have : IsClosedImmersion ι :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  have hi : i = h.isoPullback.hom ≫ pullback.fst f ι := (h.isoPullback_hom_fst).symm
  have : IsClosedImmersion i := by
    rw [hi]
    infer_instance
  have hker : i.ker = ι.ker.comap f := by
    rw [hi, Scheme.Hom.ker_comp_of_isIso, Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (i x)) isOpen_univ
  rw [← IdealSheafData.stalk_ker_of_isClosedImmersion i x,
    IdealSheafData.stalk_eq_map_germ _ _ ⟨U, hU⟩ hxU, hker,
    Stacks.FamilyFitting.ideal_comap_of_le _ f ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ le_top,
    Scheme.ker_SpecMap, Scheme.IdealSheafData.ofIdealTop_ideal, CommRingCat.hom_ofHom, Ideal.mk_ker,
    Ideal.map_map,
    Ideal.map_map, Ideal.map_map, ← CommRingCat.hom_comp, ← CommRingCat.hom_comp,
    ← CommRingCat.hom_comp]
  congr 2
  simp only [Category.assoc, Scheme.Hom.appLE, TopCat.Presheaf.germ_res]
  rw [show (homOfLE (le_top (a := (⊤ : (Spec R).Opens)))) = 𝟙 _ from rfl, op_id,
    CategoryTheory.Functor.map_id, Category.id_comp]
  rfl

/-- **The kernel of the map of local rings of a base change of `Spec (R ⧸ K ^ (m + 1))`** lies
in the `(m + 1)`-st power of the maximal ideal. -/
theorem ker_stalkMap_le_maximalIdeal_pow_of_isPullback {R : CommRingCat.{u}} {Y X' : Scheme.{u}}
    (f : Y ⟶ Spec R) (K : Ideal R) (m : ℕ) (i : X' ⟶ Y) (j : X' ⟶ Spec (.of (R ⧸ K ^ (m + 1))))
    (h : IsPullback i j f (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (K ^ (m + 1))))))
    (x : X') : RingHom.ker (i.stalkMap x).hom ≤ maximalIdeal (Y.presheaf.stalk (i x)) ^ (m + 1) :=
  ker_le_maximalIdeal_pow_of_eq_pow _
    ((ker_stalkMap_eq_map_of_isPullback f _ i j h x).trans (Ideal.map_pow _ _ _))

/-- **The kernel of the map of local rings of `V(J ^ (m + 1))`** lies in the `(m + 1)`-st power
of the maximal ideal: it is generated by the `(m + 1)`-st powers of the germs of the sections of
`J`. -/
theorem ker_stalkMap_subschemeι_pow_le_maximalIdeal_pow {X : Scheme.{u}} (J : X.IdealSheafData)
    (m : ℕ) (z : (J ^ (m + 1)).subscheme) :
    RingHom.ker ((J ^ (m + 1)).subschemeι.stalkMap z).hom ≤
      maximalIdeal (X.presheaf.stalk ((J ^ (m + 1)).subschemeι z)) ^ (m + 1) := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ ((J ^ (m + 1)).subschemeι z)) isOpen_univ
  refine ker_le_maximalIdeal_pow_of_eq_pow _ (K := (J.ideal ⟨U, hU⟩).map
    (X.presheaf.germ U _ hxU).hom) ?_
  rw [IdealSheafData.ker_stalkMap_subschemeι, IdealSheafData.stalk_eq_map_germ _ _ ⟨U, hU⟩ hxU,
    Scheme.IdealSheafData.ideal_pow, Pi.pow_apply, Ideal.map_pow]

end AlgebraicGeometry

end
