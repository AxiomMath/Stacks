module

public import Mathlib.Algebra.MvPolynomial.CommRing
public import StacksFrontier.AlgebraicGeometry.Surfaces.FormalNeighborhoodSymbol

/-!
# A monomial symbol system on the polynomial ring in two variables

`AlgebraicGeometry.SemistableReduction.MonomialSymbol` is an axiom bundle, and the three
geometric inputs of [Stacks, Tag 0C2K] derived from it in
`StacksFrontier.AlgebraicGeometry.Surfaces.FormalNeighborhoodSymbol` are only worth something if the
bundle is satisfiable.  This file exhibits a witness, so that those three are honest conditional
theorems rather than consequences of an inconsistent hypothesis.

The witness is the *leading-form* system on `A = k[T₀, T₁]`: the filtration is by the powers of
the ideal `𝔪 = (T₀, T₁)` generated by the two variables, and the symbol `σₙ` is the degree-`n`
homogeneous component.  This is the affine shadow of the intended geometric example, where `A` is
the ring of compatible functions on the thickenings of an exceptional curve, `Iₙ` is the
projection kernel and `σₙ` is the leading form of a function vanishing to order `n`.  The
properties the geometric example has and this one lacks — separatedness and completeness of the
filtration — are not axioms of a monomial symbol system, so they are not needed here.

Everything rests on one description of the filtration: `𝔪ⁿ` is exactly the set of polynomials all
of whose terms have degree at least `n`, `coordIdeal_pow_eq_lowDegreeIdeal`.  Both inclusions are
proved from `MvPolynomial.coeff_mul`: the forward one by induction on `n`, the backward one by
splitting a polynomial into its monomials.

Both axioms most at risk of being subtly wrong hold on the nose, with no adjustment to their
statements: `symbol_eq_zero_iff`, that `ker σₙ = Iₙ₊₁`, is
`homogeneousComponent_eq_zero_iff_mem_coordIdeal_pow_succ`, and `symbol_mul`, that
`σ_{m+n}(fg) = σₘ(f) σₙ(g)`, is `homogeneousComponent_mul_of_mem_coordIdeal_pow`, proved by
splitting `f = σₘ f + (f - σₘ f)` and `g = σₙ g + (g - σₙ g)` and observing that the three cross
terms lie in `𝔪^{m+n+1}`.

## Main definitions

* `AlgebraicGeometry.SemistableReduction.BinaryPolynomialSymbol.coordIdeal` — the ideal
  `(T₀, T₁)`.
* `AlgebraicGeometry.SemistableReduction.BinaryPolynomialSymbol.lowDegreeIdeal` — the polynomials
  with no term of degree below `n`.
* `AlgebraicGeometry.SemistableReduction.binaryPolynomialMonomialSymbol` — **the witness**: the
  leading-form monomial symbol system on `k[T₀, T₁]`.

## Main results

* `AlgebraicGeometry.SemistableReduction.BinaryPolynomialSymbol.coordIdeal_pow_eq_lowDegreeIdeal`
  — `(T₀, T₁)ⁿ` is the polynomials with no term of degree below `n`.
* `AlgebraicGeometry.SemistableReduction.BinaryPolynomialSymbol`
  `.homogeneousComponent_mul_of_mem_coordIdeal_pow` — the leading form is multiplicative.
* `AlgebraicGeometry.SemistableReduction.nonempty_monomialSymbol_mvPolynomial_finTwo` — a
  monomial symbol system exists, so the structure is not an inconsistent bundle.

## References

* [Stacks Project, Tag 0C2K](https://stacks.math.columbia.edu/tag/0C2K)
-/

@[expose] public noncomputable section

open MvPolynomial

universe u

namespace AlgebraicGeometry.SemistableReduction

namespace BinaryPolynomialSymbol

/-! ### Degrees of exponent vectors in two variables -/

/-- The total degree of an exponent vector in two variables. -/
theorem degree_finTwo (e : Fin 2 →₀ ℕ) : Finsupp.degree e = e 0 + e 1 := by
  rw [Finsupp.degree_eq_sum, Fin.sum_univ_two]

/-- The total degree of exponent vectors in two variables is additive. -/
theorem degree_add_finTwo (a b : Fin 2 →₀ ℕ) :
    Finsupp.degree (a + b) = Finsupp.degree a + Finsupp.degree b := by
  simp only [degree_finTwo, Finsupp.add_apply]
  omega

/-! ### The filtration by the powers of `(T₀, T₁)` -/

variable (k : Type u) [CommRing k]

/-- The ideal of `k[T₀, T₁]` generated by the two variables. -/
def coordIdeal : Ideal (MvPolynomial (Fin 2) k) := Ideal.span {X 0, X 1}

/-- The polynomials in two variables with no term of degree below `n`. -/
def lowDegreeIdeal (n : ℕ) : Ideal (MvPolynomial (Fin 2) k) where
  carrier := {f | ∀ e : Fin 2 →₀ ℕ, Finsupp.degree e < n → f.coeff e = 0}
  zero_mem' := by intro e _; simp
  add_mem' := by intro a b ha hb e he; simp [ha e he, hb e he]
  smul_mem' := by
    classical
    intro c f hf e he
    rw [smul_eq_mul, coeff_mul]
    refine Finset.sum_eq_zero fun p hp => ?_
    have hsum : Finsupp.degree p.1 + Finsupp.degree p.2 = Finsupp.degree e := by
      rw [← degree_add_finTwo, Finset.mem_antidiagonal.1 hp]
    rw [hf p.2 (by omega), mul_zero]

/-- A polynomial lies in `lowDegreeIdeal k n` iff all its coefficients of degree below `n`
vanish. -/
theorem mem_lowDegreeIdeal {n : ℕ} {f : MvPolynomial (Fin 2) k} :
    f ∈ lowDegreeIdeal k n ↔ ∀ e : Fin 2 →₀ ℕ, Finsupp.degree e < n → f.coeff e = 0 := Iff.rfl

/-- Each variable has no term of degree zero. -/
theorem coordIdeal_le_lowDegreeIdeal_one : coordIdeal k ≤ lowDegreeIdeal k 1 := by
  rw [coordIdeal, Ideal.span_le]
  rintro a (rfl | rfl) <;>
  · intro e he
    rw [Nat.lt_one_iff, Finsupp.degree_eq_zero_iff] at he
    subst he
    simp

/-- **A product of `n` elements of `(T₀, T₁)` has no term of degree below `n`.** -/
theorem coordIdeal_pow_le_lowDegreeIdeal (n : ℕ) : coordIdeal k ^ n ≤ lowDegreeIdeal k n := by
  classical
  induction n with
  | zero => intro f _ e he; exact absurd he (Nat.not_lt_zero _)
  | succ n ih =>
    rw [pow_succ]
    refine Ideal.mul_le.2 fun r hr s hs => ?_
    have hr' := ih hr
    have hs' := coordIdeal_le_lowDegreeIdeal_one k hs
    intro e he
    rw [coeff_mul]
    refine Finset.sum_eq_zero fun p hp => ?_
    have hsum : Finsupp.degree p.1 + Finsupp.degree p.2 = Finsupp.degree e := by
      rw [← degree_add_finTwo, Finset.mem_antidiagonal.1 hp]
    rcases Nat.eq_zero_or_pos (Finsupp.degree p.2) with h2 | h2
    · rw [hs' p.2 (by omega), mul_zero]
    · rw [hr' p.1 (by omega), zero_mul]

/-- A monomial of degree `d` lies in the `d`-th power of `(T₀, T₁)`. -/
theorem monomial_mem_coordIdeal_pow_degree (e : Fin 2 →₀ ℕ) (c : k) :
    monomial e c ∈ coordIdeal k ^ (Finsupp.degree e) := by
  have he : Finsupp.single (0 : Fin 2) (e 0) + Finsupp.single 1 (e 1) = e := by
    refine Finsupp.ext fun i => ?_
    fin_cases i <;> simp
  have hmono : (X 0 : MvPolynomial (Fin 2) k) ^ (e 0) * X 1 ^ (e 1) = monomial e 1 := by
    rw [X_pow_eq_monomial, X_pow_eq_monomial, monomial_mul_monomial, he, one_mul]
  have hx : (X 0 : MvPolynomial (Fin 2) k) ∈ coordIdeal k := Ideal.subset_span (by simp)
  have hy : (X 1 : MvPolynomial (Fin 2) k) ∈ coordIdeal k := Ideal.subset_span (by simp)
  have hmem := Ideal.mul_mem_mul (Ideal.pow_mem_pow hx (e 0)) (Ideal.pow_mem_pow hy (e 1))
  rw [← pow_add] at hmem
  rw [degree_finTwo, show (monomial e c : MvPolynomial (Fin 2) k)
    = C c * (X 0 ^ (e 0) * X 1 ^ (e 1)) from by rw [hmono, C_mul_monomial, mul_one]]
  exact Ideal.mul_mem_left _ _ hmem

/-- **A polynomial with no term of degree below `n` lies in the `n`-th power of `(T₀, T₁)`.** -/
theorem lowDegreeIdeal_le_coordIdeal_pow (n : ℕ) : lowDegreeIdeal k n ≤ coordIdeal k ^ n := by
  intro f hf
  rw [← support_sum_monomial_coeff f]
  refine Submodule.sum_mem _ fun e he => ?_
  have hdeg : n ≤ Finsupp.degree e := by
    by_contra hlt
    exact (MvPolynomial.mem_support_iff.1 he) (hf e (by omega))
  exact Ideal.pow_le_pow_right hdeg (monomial_mem_coordIdeal_pow_degree k e (f.coeff e))

/-- **The `n`-th power of `(T₀, T₁)` is exactly the polynomials with no term of degree below
`n`.** -/
theorem coordIdeal_pow_eq_lowDegreeIdeal (n : ℕ) : coordIdeal k ^ n = lowDegreeIdeal k n :=
  le_antisymm (coordIdeal_pow_le_lowDegreeIdeal k n) (lowDegreeIdeal_le_coordIdeal_pow k n)

variable {k}

/-- An element of `(T₀, T₁)ⁿ` has zero coefficient at every exponent of degree below `n`. -/
theorem coeff_eq_zero_of_mem_coordIdeal_pow {n : ℕ} {f : MvPolynomial (Fin 2) k}
    (hf : f ∈ coordIdeal k ^ n) {e : Fin 2 →₀ ℕ} (he : Finsupp.degree e < n) :
    f.coeff e = 0 := by
  rw [coordIdeal_pow_eq_lowDegreeIdeal] at hf
  exact hf e he

/-- A polynomial with zero coefficient at every exponent of degree below `n` lies in
`(T₀, T₁)ⁿ`. -/
theorem mem_coordIdeal_pow_of_coeff_eq_zero {n : ℕ} {f : MvPolynomial (Fin 2) k}
    (hf : ∀ e : Fin 2 →₀ ℕ, Finsupp.degree e < n → f.coeff e = 0) :
    f ∈ coordIdeal k ^ n := by
  rw [coordIdeal_pow_eq_lowDegreeIdeal]
  exact hf

/-! ### The leading form -/

/-- A homogeneous component of degree `n` has no term of degree below `n`. -/
theorem homogeneousComponent_mem_coordIdeal_pow (n : ℕ) (f : MvPolynomial (Fin 2) k) :
    homogeneousComponent n f ∈ coordIdeal k ^ n := by
  refine mem_coordIdeal_pow_of_coeff_eq_zero fun e he => ?_
  simp only [coeff_homogeneousComponent, ite_eq_right_iff]
  exact fun h => absurd h (by omega)

/-- **A function vanishing to order `n + 1` has vanishing degree-`n` leading form.** -/
theorem homogeneousComponent_eq_zero_of_mem_coordIdeal_pow_succ {n : ℕ}
    {f : MvPolynomial (Fin 2) k} (hf : f ∈ coordIdeal k ^ (n + 1)) :
    homogeneousComponent n f = 0 := by
  refine MvPolynomial.ext _ _ fun e => ?_
  rw [AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply, coeff_homogeneousComponent]
  split_ifs with h
  · exact coeff_eq_zero_of_mem_coordIdeal_pow hf (by omega)
  · rfl

/-- Subtracting its degree-`n` leading form raises the vanishing order of an element of
`(T₀, T₁)ⁿ`. -/
theorem sub_homogeneousComponent_mem_coordIdeal_pow_succ {n : ℕ} {f : MvPolynomial (Fin 2) k}
    (hf : f ∈ coordIdeal k ^ n) : f - homogeneousComponent n f ∈ coordIdeal k ^ (n + 1) := by
  refine mem_coordIdeal_pow_of_coeff_eq_zero fun e he => ?_
  rw [coeff_sub, coeff_homogeneousComponent]
  split_ifs with h
  · exact sub_self _
  · rw [coeff_eq_zero_of_mem_coordIdeal_pow hf (by omega), sub_zero]

/-- **The `symbol_eq_zero_iff` axiom for the leading-form system**: an element of `(T₀, T₁)ⁿ` has
vanishing degree-`n` leading form exactly when it lies in `(T₀, T₁)ⁿ⁺¹`. -/
theorem homogeneousComponent_eq_zero_iff_mem_coordIdeal_pow_succ {n : ℕ}
    {f : MvPolynomial (Fin 2) k} (hf : f ∈ coordIdeal k ^ n) :
    homogeneousComponent n f = 0 ↔ f ∈ coordIdeal k ^ (n + 1) := by
  refine ⟨fun h => ?_, fun h => homogeneousComponent_eq_zero_of_mem_coordIdeal_pow_succ h⟩
  have hsub := sub_homogeneousComponent_mem_coordIdeal_pow_succ hf
  rwa [h, sub_zero] at hsub

/-- **The `symbol_mul` axiom for the leading-form system**: the degree-`(m+n)` leading form of a
product of elements of `(T₀, T₁)ᵐ` and `(T₀, T₁)ⁿ` is the product of their leading forms.  The
three cross terms of `f = σₘ f + (f - σₘ f)` against `g = σₙ g + (g - σₙ g)` all lie in
`(T₀, T₁)^{m+n+1}`, so they contribute nothing in degree `m + n`. -/
theorem homogeneousComponent_mul_of_mem_coordIdeal_pow {m n : ℕ} {f g : MvPolynomial (Fin 2) k}
    (hf : f ∈ coordIdeal k ^ m) (hg : g ∈ coordIdeal k ^ n) :
    homogeneousComponent (m + n) (f * g)
      = homogeneousComponent m f * homogeneousComponent n g := by
  have hmul : ∀ {a b : MvPolynomial (Fin 2) k} {i j : ℕ}, a ∈ coordIdeal k ^ i →
      b ∈ coordIdeal k ^ j → m + n + 1 ≤ i + j → a * b ∈ coordIdeal k ^ (m + n + 1) :=
    fun ha hb h => Ideal.pow_le_pow_right h (pow_add (coordIdeal k) _ _ ▸ Ideal.mul_mem_mul ha hb)
  have hF := homogeneousComponent_mem_coordIdeal_pow m f
  have hG := homogeneousComponent_mem_coordIdeal_pow n g
  have hf' := sub_homogeneousComponent_mem_coordIdeal_pow_succ hf
  have hg' := sub_homogeneousComponent_mem_coordIdeal_pow_succ hg
  have h1 := hmul hF hg' (by omega)
  have h2 := hmul hf' hG (by omega)
  have h3 := hmul hf' hg' (by omega)
  have hsplit : f * g = homogeneousComponent m f * homogeneousComponent n g +
      (homogeneousComponent m f * (g - homogeneousComponent n g) +
        (f - homogeneousComponent m f) * homogeneousComponent n g +
        (f - homogeneousComponent m f) * (g - homogeneousComponent n g)) := by ring
  rw [hsplit, map_add,
    homogeneousComponent_eq_zero_of_mem_coordIdeal_pow_succ (add_mem (add_mem h1 h2) h3), add_zero,
    homogeneousComponent_eq_self
      ((homogeneousComponent_isHomogeneous m f).mul (homogeneousComponent_isHomogeneous n g))]

end BinaryPolynomialSymbol

/-! ### The witness -/

open BinaryPolynomialSymbol in
/-- **A monomial symbol system on `k[T₀, T₁]`.**  The filtration is by the powers of the ideal
`(T₀, T₁)` generated by the two variables, and the symbol of an element of `(T₀, T₁)ⁿ` is its
degree-`n` leading form.

This witnesses that `AlgebraicGeometry.SemistableReduction.MonomialSymbol` is a consistent axiom
bundle, so that the three geometric inputs of [Stacks, Tag 0C2K] derived from it are honest
conditional theorems. -/
def binaryPolynomialMonomialSymbol (k : Type u) [CommRing k] :
    MonomialSymbol (MvPolynomial (Fin 2) k) k where
  ideal n := coordIdeal k ^ n
  symbol n f := homogeneousComponent n f
  ideal_zero := by rw [pow_zero, Ideal.one_eq_top]
  mul_le m n := le_of_eq (pow_add (coordIdeal k) m n).symm
  symbol_mem := by
    intro n a _
    exact (mem_homogeneousSubmodule _ _).2 (homogeneousComponent_isHomogeneous n a)
  symbol_add := by intro n a b _ _; exact map_add _ a b
  symbol_eq_zero_iff := by
    intro n a ha
    exact homogeneousComponent_eq_zero_iff_mem_coordIdeal_pow_succ ha
  symbol_mul := by
    intro m n a b ha hb
    exact homogeneousComponent_mul_of_mem_coordIdeal_pow ha hb
  symbol_one := homogeneousComponent_eq_self (isHomogeneous_one (Fin 2) k)
  surjective_symbol_zero c := ⟨C c, homogeneousComponent_eq_self (isHomogeneous_C (Fin 2) c)⟩
  exists_symbol_one_eq_X := by
    refine ⟨X 0, X 1, ?_, ?_, homogeneousComponent_eq_self (isHomogeneous_X k 0),
      homogeneousComponent_eq_self (isHomogeneous_X k 1)⟩
    · rw [pow_one, coordIdeal]
      exact Ideal.subset_span (by simp)
    · rw [pow_one, coordIdeal]
      exact Ideal.subset_span (by simp)

/-- The `n`-th ideal of the filtration of `binaryPolynomialMonomialSymbol k` is `(T₀, T₁)ⁿ`. -/
@[simp]
theorem binaryPolynomialMonomialSymbol_ideal (k : Type u) [CommRing k] (n : ℕ) :
    (binaryPolynomialMonomialSymbol k).ideal n = BinaryPolynomialSymbol.coordIdeal k ^ n := rfl

/-- The `n`-th symbol map of `binaryPolynomialMonomialSymbol k` is the degree-`n` homogeneous
component. -/
@[simp]
theorem binaryPolynomialMonomialSymbol_symbol (k : Type u) [CommRing k] (n : ℕ)
    (f : MvPolynomial (Fin 2) k) :
    (binaryPolynomialMonomialSymbol k).symbol n f = homogeneousComponent n f := rfl

/-- **A monomial symbol system exists.**  So
`AlgebraicGeometry.SemistableReduction.MonomialSymbol` is not an inconsistent bundle of axioms,
and the conclusions drawn from it are not vacuous. -/
theorem nonempty_monomialSymbol_mvPolynomial_finTwo (k : Type u) [CommRing k] :
    Nonempty (MonomialSymbol (MvPolynomial (Fin 2) k) k) :=
  ⟨binaryPolynomialMonomialSymbol k⟩

/-- **The witness is not degenerate.**  Over a nontrivial `k` the first step of its filtration is
a proper ideal, so the filtration really does drop between step `0` and step `1`; in particular
the witness is not the collapsed system in which every ideal is the whole ring. -/
theorem binaryPolynomialMonomialSymbol_ideal_one_ne_top (k : Type u) [CommRing k]
    [Nontrivial k] : (binaryPolynomialMonomialSymbol k).ideal 1 ≠ ⊤ := by
  intro h
  have h1 : (1 : MvPolynomial (Fin 2) k) ∈ (binaryPolynomialMonomialSymbol k).ideal 1 := by
    rw [h]; trivial
  rw [binaryPolynomialMonomialSymbol_ideal, pow_one] at h1
  have h0 := BinaryPolynomialSymbol.coordIdeal_le_lowDegreeIdeal_one k h1 0 (by simp)
  simp at h0

end AlgebraicGeometry.SemistableReduction
