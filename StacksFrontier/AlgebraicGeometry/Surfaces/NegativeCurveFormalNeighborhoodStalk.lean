module

public import StacksFrontier.AlgebraicGeometry.AmplePowers.ModuleStalk
public import StacksFrontier.AlgebraicGeometry.Divisors.IdealSheafGlobalSectionGenerators
public import StacksFrontier.AlgebraicGeometry.NonvanishingPullback.Nonvanishing
public import StacksFrontier.AlgebraicGeometry.Surfaces.GradedSectionsLocal
public import StacksFrontier.AlgebraicGeometry.Surfaces.NegativeCurveFormalNeighborhoodPointValue

/-!
# The value at a point of a section of a conormal power, read on its germ

Let `D` be an effective Cartier divisor on a scheme `X`, with subscheme `C` and conormal sheaf
`L = 𝒪_X(-D)|_C`, and let `V = Spec B` be an affine open of `X` on which `D` is cut out by a
nonzerodivisor `t`. For a point `x'` of `C` over `V` write `𝔭 ⊂ B` for the prime of its image.
`AlgebraicGeometry.Scheme.IdealSheafData.chartPointValue` attaches to an element `a ∈ Fₙ₊₁` of the
formal neighbourhood its value at `x'`: on `Spec B / tⁿ⁺²` the element `a` is the class of
`tⁿ⁺¹ h`, and the value is `h mod 𝔭`.

This file identifies that value with the intrinsic notion: **the value of `a` vanishes exactly when
the section `gradedSymbol a` of `Lⁿ⁺¹` vanishes at `x'`**, i.e. when its germ lies in
`𝔪_{x'} · (Lⁿ⁺¹)_{x'}` (`Stacks.ModuleStalk.maximalSmul`).

## The steps

* On an affine open `V` where an ideal sheaf `J` is generated by a nonzerodivisor `f`, the stalk of
  the ideal sheaf at a point of `V` is generated by the germ of the section `f`, and that germ does
  not lie in `𝔪 · J_x` (`AlgebraicGeometry.Scheme.IdealSheafData.germ_mem_maximalSmul_iff`). So a
  section `y` with `y = h f` vanishes at `x` exactly when `h` does.
* The pullback-unit section of `y` to `C` vanishes at `x'` exactly when `y` vanishes at the image
  of `x'` ([Stacks, Tag 0H78], over an open:
  `AlgebraicGeometry.Scheme.IdealSheafData.germ_pullbackUnit_mem_maximalSmul_iff`).
* Over `V` every section of `Lⁿ⁺¹ = i^*𝒪_X(-D ^ (n + 1))` is a pullback-unit section, and its symbol
  on the thickening is the class of the corresponding section of the ideal sheaf
  (`AlgebraicGeometry.Scheme.IdealSheafData.gradedSectionsHom_restrict_of_pullbackUnit`).

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.germ_gradedSymbol_mem_maximalSmul_iff`.
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite Stacks.Divisors
open scoped Stacks.ModuleStalk

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-! ### The stalk of an ideal sheaf with a local generator -/

/-- The ideal sheaf of `J`, as an `𝒪_X`-module. -/
public abbrev idealModule (J : X.IdealSheafData) : X.Modules := idealSheafOfModules J

section IdealStalk

variable (J : X.IdealSheafData) (V : X.affineOpens) {f : Γ(X, V.1)}
  (hf : J.ideal V = Ideal.span {f}) (hfnzd : f ∈ nonZeroDivisors Γ(X, V.1))
  (y₀ : (idealSheafOfModules J).val.obj (op V.1)) (hy₀ : idealSheafSection J y₀ = f)
  {x : X} (hx : x ∈ V.1)

include hf hfnzd hy₀ in
/-- **The stalk of an ideal sheaf at a point of an affine open on which it is generated by a
nonzerodivisor `f` is generated by the germ of `f`**: every element of the stalk is a multiple of
the germ of the section `y₀` of the ideal sheaf with `y₀ = f`. -/
public theorem exists_eq_smul_germ_of_idealSheafSection_eq
    (m : TopCat.Presheaf.stalk (C := Ab.{u})
      (idealModule J).presheaf x) :
    ∃ r : X.presheaf.stalk x,
      m = r • ((idealModule J).presheaf.germ V.1 x hx).hom y₀ := by
  obtain ⟨W, hxW, z, hzm⟩ := TopCat.Presheaf.exists_germ_eq (idealModule J).presheaf m
  have hW'V : W ⊓ V.1 ≤ V.1 := inf_le_right
  have hxW' : x ∈ W ⊓ V.1 := ⟨hxW, hx⟩
  set z' : (idealSheafOfModules J).val.obj (op (W ⊓ V.1)) :=
    ((idealModule J).presheaf.map (homOfLE (inf_le_left : W ⊓ V.1 ≤ W)).op).hom z
  set y₀' : (idealSheafOfModules J).val.obj (op (W ⊓ V.1)) :=
    ((idealModule J).presheaf.map (homOfLE hW'V).op).hom y₀
  have hr' : J.subschemeι.app (W ⊓ V.1) (idealSheafSection J z') = 0 :=
    subschemeι_app_idealSheafSection J z'
  obtain ⟨c, hc⟩ := exists_mul_of_subschemeι_app_eq_zero J V hf hfnzd hW'V _ hr'
  have hy₀' : idealSheafSection J y₀' = X.presheaf.map (homOfLE hW'V).op f := by
    rw [← hy₀]
    exact idealSheafSection_resSection J (op (Over.mk (homOfLE hW'V))) y₀
  have hz' : z' = unitSectionOfFun c • y₀' := by
    refine idealSheafSection_injective J ?_
    rw [idealSheafSection_smul, hy₀', ← hc]
  refine ⟨(X.presheaf.germ (W ⊓ V.1) x hxW').hom c, ?_⟩
  rw [← hzm, show ((idealModule J).presheaf.germ W x hxW).hom z =
      ((idealModule J).presheaf.germ (W ⊓ V.1) x hxW').hom z' from
      (TopCat.Presheaf.germ_res_apply (idealModule J).presheaf
        (homOfLE (inf_le_left : W ⊓ V.1 ≤ W)) x hxW' z).symm,
    show ((idealModule J).presheaf.germ V.1 x hx).hom y₀ =
      ((idealModule J).presheaf.germ (W ⊓ V.1) x hxW').hom y₀' from
      (TopCat.Presheaf.germ_res_apply (idealModule J).presheaf (homOfLE hW'V) x hxW'
        (show Γ(idealModule J, V.1) from y₀)).symm]
  rw [hz']
  exact Stacks.ModuleStalk.germ_smul (idealModule J) x (W ⊓ V.1) hxW' c y₀'

include hf hfnzd hy₀ in
/-- **The germ of a local generator of an ideal sheaf does not vanish.** -/
public theorem germ_notMem_maximalSmul_of_idealSheafSection_eq :
    ((idealModule J).presheaf.germ V.1 x hx).hom y₀ ∉
      Stacks.ModuleStalk.maximalSmul (idealModule J) x := by
  set g := ((idealModule J).presheaf.germ V.1 x hx).hom y₀
  intro hg
  have htop : (⊤ : Submodule (X.presheaf.stalk x)
      (TopCat.Presheaf.stalk (C := Ab.{u}) (idealModule J).presheaf x)) = Submodule.span _ {g} := by
    refine (eq_top_iff.2 fun m _ => ?_).symm
    obtain ⟨r, rfl⟩ := exists_eq_smul_germ_of_idealSheafSection_eq J V hf hfnzd y₀ hy₀ hx m
    exact Submodule.smul_mem _ r (Submodule.mem_span_singleton_self g)
  rw [Stacks.ModuleStalk.maximalSmul, htop, Submodule.mem_smul_span_singleton] at hg
  obtain ⟨μ, hμ, hμg⟩ := hg
  have hunit : IsUnit (1 - μ) := by
    by_contra hnu
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top (Ideal.eq_top_of_isUnit_mem _
      (show (1 - μ) + μ ∈ IsLocalRing.maximalIdeal _ from
        add_mem ((IsLocalRing.mem_maximalIdeal _).2 hnu) hμ) (by rw [sub_add_cancel]; exact
          isUnit_one))
  have hg0 : g = 0 := by
    have h1 : (1 - μ) • g = 0 := by rw [sub_smul, one_smul, hμg, sub_self]
    obtain ⟨v, hv⟩ := hunit
    rw [← hv] at h1
    have := congrArg (fun w => (↑v⁻¹ : X.presheaf.stalk x) • w) h1
    simpa [smul_smul] using this
  obtain ⟨W, hxW, iU, iV, hW⟩ := TopCat.Presheaf.germ_eq (idealModule J).presheaf x hx hx y₀ 0
    (by rw [map_zero]; exact hg0)
  have hWV : W ≤ V.1 := iU.le
  have hres : idealSheafSection J (((idealModule J).presheaf.map iU.op).hom y₀) =
      X.presheaf.map (homOfLE hWV).op f := by
    rw [← hy₀]
    exact idealSheafSection_resSection J (op (Over.mk (homOfLE hWV))) y₀
  have h0 : idealSheafSection J (((idealModule J).presheaf.map iU.op).hom y₀) = 0 := by
    rw [hW, map_zero]
    exact idealSheafSection_zero J W
  rw [h0] at hres
  have hnzd := mem_nonZeroDivisors_res V.2 hfnzd hWV
  rw [← hres] at hnzd
  have hsub : Subsingleton Γ(X, W) := by
    refine ⟨fun a b => ?_⟩
    have ha := (mem_nonZeroDivisors_iff.1 hnzd).1 a (zero_mul a)
    have hb := (mem_nonZeroDivisors_iff.1 hnzd).1 b (zero_mul b)
    rw [ha, hb]
  have h10 : (1 : Γ(X, W)) = 0 := Subsingleton.elim _ _
  have := congrArg (X.presheaf.germ W x hxW).hom h10
  rw [map_one, map_zero] at this
  exact one_ne_zero this

include hf hfnzd in
/-- **A section `h f` of an ideal sheaf generated by a nonzerodivisor `f` vanishes at `x` exactly
when `h` does.** -/
public theorem germ_mem_maximalSmul_iff (y : (idealSheafOfModules J).val.obj (op V.1))
    {h : Γ(X, V.1)} (hy : idealSheafSection J y = h * f) :
    ((idealModule J).presheaf.germ V.1 x hx).hom y ∈
        Stacks.ModuleStalk.maximalSmul (idealModule J) x ↔
      (X.presheaf.germ V.1 x hx).hom h ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
  obtain ⟨y₀, hy₀⟩ := (mem_ideal_iff_exists_idealSheafSection J V f).1
    (hf ▸ Ideal.mem_span_singleton_self f)
  have hyy : y = unitSectionOfFun h • y₀ := by
    refine idealSheafSection_injective J ?_
    rw [idealSheafSection_smul, hy₀]
    exact hy
  have hgerm : ((idealModule J).presheaf.germ V.1 x hx).hom y =
      (X.presheaf.germ V.1 x hx).hom h • ((idealModule J).presheaf.germ V.1 x hx).hom y₀ := by
    rw [hyy]
    exact Stacks.ModuleStalk.germ_smul (idealModule J) x V.1 hx h y₀
  rw [hgerm, Stacks.ModuleStalk.smul_mem_maximalSmul_iff, IsLocalRing.mem_maximalIdeal,
    mem_nonunits_iff]
  exact or_iff_left (germ_notMem_maximalSmul_of_idealSheafSection_eq J V hf hfnzd y₀ hy₀ hx)

end IdealStalk

/-! ### Nonvanishing of a pulled-back section over an open -/

open RingedSpaceModuleAdjunction Stacks.NonvanishingPullback in
/-- **[Stacks, Tag 0H78] over an open.** For a morphism of schemes `i : X' ⟶ X`, an
`𝒪_X`-module `M`, a section `y` of `M` over an open `V` and a point `x'` of `X'` over `V`, the
pullback-unit section `i^* y` vanishes at `x'` exactly when `y` vanishes at `i x'`. -/
public theorem germ_pullbackUnit_mem_maximalSmul_iff {X' : Scheme.{u}} (i : X' ⟶ X)
    (M : X.Modules) (V : X.Opens) (y : M.val.obj (op V)) (x' : X') (hx : i.base x' ∈ V) :
    (((Scheme.Modules.pullback i).obj M).presheaf.germ (i ⁻¹ᵁ V) x' hx).hom
        (Stacks.RingedSpace.pullbackUnit i.toLRSHom.toShHom M (op V) y) ∈
        Stacks.ModuleStalk.maximalSmul ((Scheme.Modules.pullback i).obj M) x' ↔
      (M.presheaf.germ V (i.base x') hx).hom y ∈ Stacks.ModuleStalk.maximalSmul M (i.base x') := by
  refine (Iff.trans ?_ (mem_maximalSmul_iff M (i.base x') _).symm)
  refine Iff.trans (mem_maximalSmul_iff ((Scheme.Modules.pullback i).obj M) x' _) ?_
  refine Iff.trans ?_ (mem_maximalIdeal_smul_iff_one_tmul
      (instAlg := Stacks.PullbackTensorIso.commStalkAlgebra i.toLRSHom.toShHom x')
      (instLoc := isLocalHom_commStalkRingMap i x')
      (instMod := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule X.toRingedSpace M.val
        (i.base x'))
      ((M.presheaf.germ V (i.base x') hx).hom y)).symm
  refine Iff.trans ?_ (mem_ideal_smul_top_iff_of_linearEquiv _
      (Stacks.PullbackTensorIso.pullbackStalkEquiv i.toLRSHom.toShHom x' M) _).symm
  exact Iff.of_eq (congrArg (fun z => z ∈
    IsLocalRing.maximalIdeal (Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk
      X'.toRingedSpace x') • ⊤)
    (Stacks.PullbackTensorIso.pullbackStalkEquiv_one_tmul i.toLRSHom.toShHom x' M V hx y)).symm

/-! ### The value at a point of a section of a conormal power -/

/-- The prime of `Γ(X, V)` at a point `x ∈ V`: the functions whose germ at `x` is not a unit. -/
public def chartPrime (V : X.Opens) (x : X) (hx : x ∈ V) : Ideal Γ(X, V) :=
  Ideal.comap (X.presheaf.germ V x hx).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk x))

public instance (V : X.Opens) (x : X) (hx : x ∈ V) : (chartPrime V x hx).IsPrime :=
  Ideal.comap_isPrime _ _

/-- At a point of the support of `D`, the ideal of `D` lies in the prime of the point. -/
public theorem ideal_le_chartPrime (D : X.IdealSheafData) (V : X.affineOpens) {x : X}
    (hx : x ∈ V.1) (hxD : x ∈ D.support) : D.ideal V ≤ chartPrime V.1 x hx := by
  intro f hf
  have hz := (mem_support_iff_of_mem hx).1 hxD
  rw [Scheme.mem_zeroLocus_iff] at hz
  have hnu := hz f hf
  rw [Scheme.mem_basicOpen _ _ _ hx] at hnu
  exact (IsLocalRing.mem_maximalIdeal _).2 hnu

variable {D : X.IdealSheafData} {V : X.affineOpens} {t : Γ(X, V.1)}

/-- A point of `C = V(D)` maps into the support of `D`. -/
public theorem subschemeι_mem_support (x' : D.subscheme) : D.subschemeι.base x' ∈ D.support := by
  have h : D.subschemeι.base x' ∈ Set.range D.subschemeι.base := ⟨x', rfl⟩
  rwa [range_subschemeι] at h

/-- **The value at a point of `C` of an element of `Fₙ₊₁` vanishes exactly when the section of
`Lⁿ⁺¹` it represents vanishes there.** For `a` (necessarily in `Fₙ₊₁`) with symbol
`σ ∈ H⁰(C, Lⁿ⁺¹)` and a point `x'` of `C` over the chart `V`, the germ of `σ` at `x'` lies in
`𝔪_{x'} · (Lⁿ⁺¹)_{x'}` exactly when `AlgebraicGeometry.Scheme.IdealSheafData.chartPointValue`
of `a` at the prime of `x'` vanishes. -/
public theorem germ_mem_maximalSmul_iff_chartPointValue_eq_zero [IsEffectiveCartierDivisor D]
    (ht : t ∈ nonZeroDivisors Γ(X, V.1)) (hVt : D.ideal V = Ideal.span {t}) (x' : D.subscheme)
    (hx : D.subschemeι.base x' ∈ V.1) (n : ℕ) {a : formalNeighborhoodRing D}
    (σ : conormalPowSections D n)
    (hσ : gradedSectionsHom D n σ = formalNeighborhoodProjection D (n + 1) a) :
    (((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (n + 1)))).presheaf.Γgerm
        x').hom σ ∈ Stacks.ModuleStalk.maximalSmul
          ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (n + 1)))) x' ↔
      chartPointValue D V t (ideal_le_chartPrime D V hx (subschemeι_mem_support x')) (n + 1) a =
        0 := by
  set L := (Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (n + 1)))
  obtain ⟨y, hy⟩ := exists_pullbackUnit_eq D (D ^ (n + 1)) V.1 V.2
    (L.val.map (homOfLE le_top).op σ)
  have hJ : (D ^ (n + 1)).ideal V = Ideal.span {t ^ (n + 1)} := by
    have h : (D ^ (n + 1)).ideal V = (D.ideal V) ^ (n + 1) := rfl
    rw [h, hVt, Ideal.span_singleton_pow]
  have hfnzd : t ^ (n + 1) ∈ nonZeroDivisors Γ(X, V.1) := pow_mem ht _
  obtain ⟨h, hh⟩ : ∃ h, idealSheafSection (D ^ (n + 1)) y = h * t ^ (n + 1) := by
    have hm := (mem_ideal_iff_exists_idealSheafSection (D ^ (n + 1)) V _).2 ⟨y, rfl⟩
    rw [hJ, Ideal.mem_span_singleton'] at hm
    obtain ⟨h, hh⟩ := hm
    exact ⟨h, hh.symm⟩
  -- The germ of `σ` is the germ of the pulled-back section.
  have hgerm : (L.presheaf.Γgerm x').hom σ =
      (L.presheaf.germ (D.subschemeι ⁻¹ᵁ V.1) x' hx).hom
        (Stacks.RingedSpace.pullbackUnit D.subschemeι.toLRSHom.toShHom
          (negativeTwist (D ^ (n + 1))) (op V.1) y) := by
    rw [hy]
    exact (TopCat.Presheaf.germ_res_apply L.presheaf (homOfLE le_top) x' hx σ).symm
  rw [hgerm, germ_pullbackUnit_mem_maximalSmul_iff D.subschemeι (negativeTwist (D ^ (n + 1)))
    V.1 y x' hx, germ_mem_maximalSmul_iff (D ^ (n + 1)) V hJ hfnzd hx y hh]
  -- The chart image of `a` is the class of `h tⁿ⁺¹`.
  have hchart : formalNeighborhoodChart D V (n + 1) a =
      Ideal.Quotient.mk _ (t ^ (n + 1) * h) := by
    rw [formalNeighborhoodChart_eq_mk_iff, mul_comm, ← hh, ← hσ]
    exact gradedSectionsHom_restrict_of_pullbackUnit D n V.1 σ y hy.symm
  rw [chartPointValue, chartLeadingCoeff_eq ht hVt le_rfl hchart, Ideal.Quotient.factor_mk,
    Ideal.Quotient.eq_zero_iff_mem]
  rfl

end AlgebraicGeometry.Scheme.IdealSheafData

end
