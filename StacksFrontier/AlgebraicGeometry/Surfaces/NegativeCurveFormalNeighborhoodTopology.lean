module

public import StacksFrontier.AlgebraicGeometry.Surfaces.ExceptionalCurveFormalNeighborhoodUnconditional
public import StacksFrontier.AlgebraicGeometry.Surfaces.NegativeCurveFormalNeighborhood

/-!
# The `𝔪`-adic and `I`-adic topologies on the formal neighbourhood of a curve agree

Let `D` be an effective Cartier divisor on a scheme `X`, cut out by `I`, with subscheme `C`, ring of
compatible functions `A = lim Γ(Cₙ, 𝒪)` and filtration `Fₙ₊₁ = ker (A ⟶ Γ(Cₙ₊₁, 𝒪))`. Over an affine
open `V` of `X` the `M`-th thickening is `Spec Γ(X, V) / I(V)^{M+1}` and `A` maps to it
(`AlgebraicGeometry.Scheme.IdealSheafData.formalNeighborhoodChart`).

`StacksFrontier/AlgebraicGeometry/Surfaces/NegativeCurveFormalNeighborhood.lean` shows that for a curve
with positive conormal bundle `A` is a complete Noetherian local ring with maximal ideal `𝔪 = F₁`
and `𝔪ⁿ ⊆ Fₙ`: the `M`-th thickening lies over `Spec A / 𝔪^{M+1}`. This file proves the converse
inclusion of thickenings, on `X`: if some power `L^N = I^N / I^{N+1}` of the conormal sheaf is
generated by its global sections, then

`I(V)^N ⊆ 𝔪 · 𝒪(V) + I(V)^{M+1}`  for every affine open `V` and every `M`,

i.e. `I^N ⊆ 𝔪 𝒪_X` near `C`, and so `I^{N k} ⊆ 𝔪^k 𝒪_X` near `C`. The closed subschemes
`V(𝔪^k 𝒪)` of the formal neighbourhood are therefore cofinal with the thickenings `Cₙ`.

## The generation hypothesis

Over an affine open `V` of `X`, `Γ(C ∩ V, L^N) = I(V)^N / I(V)^{N+1}`, and the global section `x` of
`L^N` restricts over `V` to the class of every `b ∈ Γ(X, V)` presenting its symbol
`AlgebraicGeometry.Scheme.IdealSheafData.gradedSectionsHom D (N - 1) x` over `V`. Global generation
of `L^N` over `V` is therefore the statement that these `b` generate `I(V)^N` modulo `I(V)^{N+1}`,
which is the hypothesis `hgg` below. For an elliptic curve and `L` of degree one it holds with
`N = 2`.

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.pow_le_comap_map_formalNeighborhoodChart` — the
  inclusion `I(V)^N ⊆ F₁ 𝒪(V) + I(V)^{M+1}`.
* `AlgebraicGeometry.Scheme.IdealSheafData.IsPositiveConormal.pow_le_comap_map_maximalIdeal_pow` —
  `I(V)^{N k} ⊆ 𝔪^k 𝒪(V) + I(V)^{M+1}`.
-/

@[expose] public noncomputable section

open CategoryTheory Stacks.Divisors

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}} (D : X.IdealSheafData)

/-- If `I^N ⊆ K + I^{N+1}` then `I^N ⊆ K + I^{N+j}` for every `j`. -/
public theorem _root_.Ideal.pow_le_sup_pow_add_of_le_sup_pow_succ {R : Type*} [CommRing R]
    {I K : Ideal R} {N : ℕ} (h : I ^ N ≤ K ⊔ I ^ (N + 1)) (j : ℕ) :
    I ^ N ≤ K ⊔ I ^ (N + j) := by
  induction j with
  | zero => exact le_sup_right
  | succ j ih =>
    refine ih.trans (sup_le le_sup_left ?_)
    calc I ^ (N + j) = I ^ j * I ^ N := by rw [← pow_add, add_comm]
      _ ≤ I ^ j * (K ⊔ I ^ (N + 1)) := Ideal.mul_mono_right h
      _ = I ^ j * K ⊔ I ^ (N + (j + 1)) := by
          rw [Ideal.mul_sup, ← pow_add, show j + (N + 1) = N + (j + 1) by omega]
      _ ≤ K ⊔ I ^ (N + (j + 1)) := sup_le_sup_right Ideal.mul_le_right _

variable [IsEffectiveCartierDivisor D]

/-- The elements of `Γ(X, V)` presenting over `V` the symbol of a global section of
`L^{n+1} = 𝒪_X(-D ^ (n + 1))|_C`. -/
public def chartGlobalSymbols (V : X.affineOpens) (n : ℕ) : Set Γ(X, V.1) :=
  {b | ∃ x : Γ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (n + 1))),
      (⊤ : D.subscheme.Opens)),
    thickeningChartSection D V (n + 1) b =
      thickeningChartRestrict D V (n + 1) (gradedSectionsHom D n x)}

/-- **`I^{n+1} ⊆ F₁ 𝒪_X` near `C`, when `L^{n+1}` is globally generated.** If the transition maps
of the thickenings are surjective and, over every affine open `V`, the presentations of the symbols
of the global sections of `L^{n+1}` generate `I(V)^{n+1}` modulo `I(V)^{n+2}`, then for every `M`
the ideal `I(V)^{n+1}` maps into the ideal of `Γ(X, V) / I(V)^{M+1}` generated by the image of
`F₁`. -/
public theorem pow_le_comap_map_formalNeighborhoodChart
    (hsurj : ∀ m, Function.Surjective (thickeningRestriction D m)) {n : ℕ}
    (hgg : ∀ V : X.affineOpens, D.ideal V ^ (n + 1) ≤
      Ideal.span (chartGlobalSymbols D V n) ⊔ D.ideal V ^ (n + 2))
    (M : ℕ) (V : X.affineOpens) :
    D.ideal V ^ (n + 1) ≤ Ideal.comap (Ideal.Quotient.mk (D.ideal V ^ (M + 1)))
      (Ideal.map (formalNeighborhoodChart D V M) (formalNeighborhoodFiltration D 1)) := by
  obtain ⟨K, hK⟩ : ∃ K : Ideal Γ(X, V.1), K = Ideal.comap
      (Ideal.Quotient.mk (D.ideal V ^ (M + 1)))
      (Ideal.map (formalNeighborhoodChart D V M) (formalNeighborhoodFiltration D 1)) := ⟨_, rfl⟩
  rw [← hK]
  have hker : D.ideal V ^ (M + 1) ≤ K := fun b hb => by
    rw [hK, Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.2 hb]
    exact zero_mem _
  rcases lt_or_ge M (n + 1) with hM | hM
  · exact (Ideal.pow_le_pow_right (by omega)).trans hker
  have hstep : D.ideal V ^ (n + 1) ≤ K ⊔ D.ideal V ^ (n + 1 + 1) := by
    refine (hgg V).trans (sup_le ?_ le_sup_right)
    rw [Ideal.span_le]
    rintro b ⟨x, hx⟩
    obtain ⟨a, ha, hax⟩ := exists_projection_eq_of_thickeningRestriction_eq_zero D n hsurj
      ((gradedSectionsHom_eq_iff D n _).2 ⟨x, rfl⟩)
    obtain ⟨b', hb'⟩ := Ideal.Quotient.mk_surjective (formalNeighborhoodChart D V M a)
    have hb'c := (formalNeighborhoodChart_eq_mk_iff D V M a b').1 hb'.symm
    have hle := thickeningChartSection_eq_of_le D V hM _ b' hb'c
    rw [thickeningRestrictionLE_formalNeighborhoodProjection, hax] at hle
    have hdiff : b - b' ∈ D.ideal V ^ (n + 1 + 1) := by
      rw [← thickeningChartSection_eq_zero_iff, map_sub, hx, hle, sub_self]
    refine Submodule.mem_sup.2 ⟨b', ?_, b - b', hdiff, by ring⟩
    rw [hK, Ideal.mem_comap, hb']
    exact Ideal.mem_map_of_mem _
      ((isCompleteFiltration_formalNeighborhoodFiltration D).antitone (by omega) ha)
  have h := Ideal.pow_le_sup_pow_add_of_le_sup_pow_succ hstep (M + 1 - (n + 1))
  rw [show n + 1 + (M + 1 - (n + 1)) = M + 1 by omega] at h
  exact h.trans (sup_le le_rfl hker)

variable {D} {c : ℕ} (hD : IsPositiveConormal D c)
include hD

/-- **The `𝔪`-adic and `I`-adic topologies on the formal neighbourhood agree.** For a curve with
positive conormal bundle `L` whose power `L^{n+1}` is globally generated (in the sense of
`AlgebraicGeometry.Scheme.IdealSheafData.pow_le_comap_map_formalNeighborhoodChart`), over every
affine open `V` of `X` and for every `M` and `k`,

`I(V)^{(n+1) k} ⊆ 𝔪^k · Γ(X, V) + I(V)^{M+1}`,

where `𝔪` is the maximal ideal of `A`. Together with `𝔪^{M+1} ⊆ ker (A ⟶ Γ(C_M, 𝒪))`
(`AlgebraicGeometry.Scheme.IdealSheafData.IsPositiveConormal.maximalIdeal_pow_le_ker`) this says
that the closed subschemes `V(𝔪^k 𝒪)` are cofinal with the thickenings `C_M`. -/
public theorem IsPositiveConormal.pow_le_comap_map_maximalIdeal_pow {n : ℕ}
    (hgg : ∀ V : X.affineOpens, D.ideal V ^ (n + 1) ≤
      Ideal.span (chartGlobalSymbols D V n) ⊔ D.ideal V ^ (n + 2))
    (M k : ℕ) (V : X.affineOpens) :
    letI := hD.isLocalRing
    D.ideal V ^ ((n + 1) * k) ≤ Ideal.comap (Ideal.Quotient.mk (D.ideal V ^ (M + 1)))
      (Ideal.map (formalNeighborhoodChart D V M)
        (IsLocalRing.maximalIdeal (formalNeighborhoodRing D) ^ k)) := by
  let _ := hD.isLocalRing
  rw [pow_mul, hD.maximalIdeal_eq, Ideal.map_pow]
  exact (Ideal.pow_right_mono (pow_le_comap_map_formalNeighborhoodChart D
    hD.surjective_thickeningRestriction hgg M V) k).trans (Ideal.le_comap_pow _ k)

end AlgebraicGeometry.Scheme.IdealSheafData

end
