/-!
# A large cofiltered system of affine schemes whose limit is the empty scheme

Stacks Tag 06AC lives in Situation 081D, which takes `S = lim S_i` to be the limit of a
*directed system* of quasi-compact and quasi-separated schemes with affine transition morphisms.
A statement of 06AC which leaves the index category's universe free of the scheme universe, and
adds no smallness condition on the index, is **false**. This file carries the construction that
refutes it.

## The construction

Let `F` be a field which is not `u`-small — `bigField`, the rational function field in `Type u`
many variables, is one. Index by the finite subsets of `F` ordered by inclusion, read
contravariantly: `(Finset F)ᵒᵖ` is cofiltered and lives in `Type (u+1)`. The stage at `T` is the
spectrum of `stage F T`, a `Type u` copy (via `Shrink`) of the subring of `F` generated by `T`,
which is `u`-small because a finitely generated `ℤ`-algebra is countable. Every stage is a
nonempty affine scheme, hence quasi-compact and quasi-separated, and every transition morphism is
affine.

The limit of this system in `Scheme.{u}` is the **empty** scheme. The reason is a universe
collapse: a cone with vertex `Z` gives, by the `Γ ⊣ Spec` adjunction, a family of ring
homomorphisms from the finitely generated subrings of `F` to `Γ(Z, ⊤)`, compatible with the
inclusions; if `Γ(Z, ⊤)` were nonzero these would assemble into an injection of `F` into a
`Type u`, making `F` be `u`-small. So `Γ(Z, ⊤)` is the zero ring, `Z` has no points, and `Z` is
initial.

## Main results

* `small_of_compatible_closureMaps`: the universe collapse, in ring-theoretic form.
* `isEmpty_of_compatible_closureMaps`: its geometric form, for the global sections of a scheme.
* `schemeDiagram`: the system of affine schemes.
* `isLimitEmptyCone`, `isLimitEmptyConeBigField`: the cone with empty vertex is a limit cone.
* `isEmpty_limit_of_nonempty_stages`: the three facts together — limiting cone, empty vertex,
  nonempty stages.

## References

* [The Stacks Project, Tag 06AC](https://stacks.math.columbia.edu/tag/06AC)
* [The Stacks Project, Tag 081D](https://stacks.math.columbia.edu/tag/081D)
* [The Stacks Project, Tag 01Z0](https://stacks.math.columbia.edu/tag/01Z0)
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

universe w u

namespace Stacks.EmptyLimitCounterexample

/-- **The universe collapse.** Let `F` be a field and let a commutative ring `A` carry a
family of ring homomorphisms out of the subrings of `F` generated by finite subsets,
compatible with the inclusions. If `A` is nonzero then `F` is no larger than `A`'s universe. -/
theorem small_of_compatible_closureMaps
    {F : Type w} [Field F] {A : Type u} [CommRing A] [Nontrivial A]
    (ψ : (T : Finset F) → Subring.closure (↑T : Set F) →+* A)
    (hψ : ∀ (T T' : Finset F), T ⊆ T' → ∀ (x : F) (hx : x ∈ Subring.closure (↑T : Set F))
        (hx' : x ∈ Subring.closure (↑T' : Set F)), ψ T' ⟨x, hx'⟩ = ψ T ⟨x, hx⟩) :
    Small.{u} F := by
  classical
  have hinj : Function.Injective (fun x : F => ψ {x} ⟨x, Subring.subset_closure (by simp)⟩) := by
    intro x y hxy
    simp only at hxy
    by_contra hne
    have hd : x - y ≠ 0 := sub_ne_zero_of_ne hne
    set T : Finset F := {x, y, (x - y)⁻¹} with hT
    have hmem : ∀ z ∈ T, z ∈ Subring.closure (↑T : Set F) := fun z hz =>
      Subring.subset_closure (by simpa using hz)
    have hsing (z : F) (hz : z ∈ T) :
        ψ T ⟨z, hmem z hz⟩ = ψ {z} ⟨z, Subring.subset_closure (by simp)⟩ :=
      hψ {z} T (by simpa using hz) z _ _
    have hx : x ∈ T := by simp [hT]
    have hy : y ∈ T := by simp [hT]
    have hi : (x - y)⁻¹ ∈ T := by simp [hT]
    have key : (⟨x, hmem x hx⟩ - ⟨y, hmem y hy⟩ : Subring.closure (↑T : Set F)) *
        ⟨(x - y)⁻¹, hmem _ hi⟩ = 1 := by
      apply Subtype.ext
      push_cast
      field_simp
    have hcon := congrArg (ψ T) key
    rw [map_one, map_mul, map_sub, hsing x hx, hsing y hy, hxy] at hcon
    simp at hcon
  exact small_of_injective hinj

/-- A scheme with a point has nonzero global sections. -/
theorem nontrivial_Γ_of_nonempty (Z : Scheme.{u}) (z : Z) : Nontrivial Γ(Z, ⊤) := by
  refine ⟨1, 0, fun h => ?_⟩
  have hg := congrArg (Z.presheaf.germ ⊤ z trivial) h
  rw [map_one, map_zero] at hg
  exact one_ne_zero hg

/-- **The geometric form of the collapse.** A scheme carrying a compatible family of ring
homomorphisms from the finitely generated subrings of a field `F` into its global sections is
empty, as soon as `F` is not `u`-small. -/
theorem isEmpty_of_compatible_closureMaps {F : Type w} [Field F] (hF : ¬ Small.{u} F)
    (Z : Scheme.{u})
    (ψ : (T : Finset F) → Subring.closure (↑T : Set F) →+* Γ(Z, ⊤))
    (hψ : ∀ (T T' : Finset F), T ⊆ T' → ∀ (x : F) (hx : x ∈ Subring.closure (↑T : Set F))
        (hx' : x ∈ Subring.closure (↑T' : Set F)), ψ T' ⟨x, hx'⟩ = ψ T ⟨x, hx⟩) :
    IsEmpty Z := by
  by_contra hne
  obtain ⟨z⟩ := not_isEmpty_iff.mp hne
  have := nontrivial_Γ_of_nonempty Z z
  exact hF (small_of_compatible_closureMaps ψ hψ)

section Diagram

variable (F : Type (u + 1)) [Field F]

/-- The subring of `F` generated by a finite set is `u`-small, being countable. -/
instance smallClosure (T : Finset F) : Small.{u} (Subring.closure (↑T : Set F)) := by
  have hset : ((Subring.closure (↑T : Set F) : Subring F) : Set F)
      = Set.range (MvPolynomial.aeval (R := ℤ) (Subtype.val : (↑T : Set F) → F)) := by
    have h := Algebra.adjoin_eq_range ℤ (↑T : Set F)
    rw [Algebra.adjoin_int] at h
    exact congrArg (fun S : Subalgebra ℤ F => (S : Set F)) h
  have hc : Countable (MvPolynomial (↑T : Set F) ℤ) :=
    Function.Injective.countable (f := AddMonoidAlgebra.coeff)
      fun a b h => by cases a; cases b; simp_all
  have : Countable ((Subring.closure (↑T : Set F) : Subring F) : Set F) := by
    rw [hset]; exact (Set.countable_range _).to_subtype
  infer_instance

/-- A `Type u` copy of the subring of `F` generated by the finite set `T`. -/
abbrev stage (T : Finset F) : Type u := Shrink.{u} (Subring.closure (↑T : Set F))

/-- The chosen ring isomorphism of the stage ring onto the subring itself. -/
abbrev stageEquiv (T : Finset F) : stage F T ≃+* Subring.closure (↑T : Set F) :=
  Shrink.ringEquiv _

/-- The transition homomorphism of stage rings along an inclusion of finite sets. -/
def stageMap {T T' : Finset F} (h : T ≤ T') : stage F T →+* stage F T' :=
  ((stageEquiv F T').symm.toRingHom).comp
    ((Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))).comp
      (stageEquiv F T).toRingHom)

/-- The transition homomorphism of stage rings is the identity on underlying elements of `F`. -/
@[simp] theorem stageEquiv_stageMap {T T' : Finset F} (h : T ≤ T') (x : stage F T) :
    ((stageEquiv F T' (stageMap F h x) : F)) = (stageEquiv F T x : F) := by
  simp [stageMap]

/-- The transition homomorphism of stage rings corresponds, under `stageEquiv`, to the inclusion
of subrings. -/
theorem stageMap_stageEquiv_symm {T T' : Finset F} (h : T ≤ T')
    (y : Subring.closure (↑T : Set F)) :
    stageMap F h ((stageEquiv F T).symm y)
      = (stageEquiv F T').symm (Subring.inclusion (Subring.closure_mono
          (Finset.coe_subset.mpr h)) y) := by
  simp [stageMap]

/-- The transition homomorphism along `T ≤ T` is the identity. -/
theorem ofHom_stageMap_id (T : Finset F) :
    CommRingCat.ofHom (stageMap F (le_refl T)) = 𝟙 (CommRingCat.of (stage F T)) := by
  ext x; simp [stageMap, RingEquiv.symm_apply_eq, Subtype.ext_iff]

/-- The transition homomorphism along a composite inclusion is the composite of the transition
homomorphisms. -/
theorem ofHom_stageMap_comp {T₁ T₂ T₃ : Finset F} (h₁ : T₁ ≤ T₂) (h₂ : T₂ ≤ T₃) :
    CommRingCat.ofHom (stageMap F (h₁.trans h₂)) =
      CommRingCat.ofHom (stageMap F h₁) ≫ CommRingCat.ofHom (stageMap F h₂) := by
  ext x; simp [stageMap, Subtype.ext_iff]

/-- The cofiltered system of affine schemes: the spectra of the stage rings, indexed by the
finite subsets of `F` ordered by inclusion, read contravariantly. -/
def schemeDiagram : (Finset F)ᵒᵖ ⥤ Scheme.{u} where
  obj T := Spec (CommRingCat.of (stage F T.unop))
  map {T T'} f := Spec.map (CommRingCat.ofHom (stageMap F (leOfHom f.unop)))
  map_id T := by rw [ofHom_stageMap_id, Spec.map_id]
  map_comp f g := by rw [← Spec.map_comp, ← ofHom_stageMap_comp]

/-- The stage of `schemeDiagram` at `T` is the spectrum of `stage F T`. -/
@[simp] theorem schemeDiagram_obj (T : Finset F) :
    (schemeDiagram F).obj (op T) = Spec (CommRingCat.of (stage F T)) := rfl

/-- Every transition morphism of `schemeDiagram` is affine. -/
instance isAffineHom_schemeDiagram_map {i j : (Finset F)ᵒᵖ} (g : i ⟶ j) :
    IsAffineHom ((schemeDiagram F).map g) :=
  inferInstanceAs (IsAffineHom (Spec.map _))

/-- Every stage of `schemeDiagram` is an affine scheme. -/
instance isAffine_schemeDiagram_obj (i : (Finset F)ᵒᵖ) : IsAffine ((schemeDiagram F).obj i) :=
  inferInstanceAs (IsAffine (Spec _))

/-- The cone over the system with the empty scheme as vertex. -/
def emptyCone : Cone (schemeDiagram F) where
  pt := ∅
  π :=
    { app := fun _ => emptyIsInitial.to _
      naturality := fun _ _ _ => emptyIsInitial.hom_ext _ _ }

/-- The leg of a cone at the stage `T`, with its target spelled as a spectrum. -/
def coneLeg (s : Cone (schemeDiagram F)) (T : Finset F) :
    s.pt ⟶ Spec (CommRingCat.of (stage F T)) := s.π.app (op T)

/-- The legs of a cone over `schemeDiagram` commute with the transition morphisms. -/
theorem coneLeg_w (s : Cone (schemeDiagram F)) {T T' : Finset F} (h : T ≤ T') :
    coneLeg F s T' ≫ Spec.map (CommRingCat.ofHom (stageMap F h)) = coneLeg F s T :=
  s.w (homOfLE h).op

/-- The ring homomorphism from the subring of `F` generated by `T` to the global sections of the
vertex of a cone, read off the cone's leg at the stage `T`. -/
def coneMap (s : Cone (schemeDiagram F)) (T : Finset F) :
    Subring.closure (↑T : Set F) →+* Γ(s.pt, ⊤) :=
  (((Scheme.ΓSpecIso (CommRingCat.of (stage F T))).inv ≫
    (coneLeg F s T).appTop).hom).comp (stageEquiv F T).symm.toRingHom

/-- The ring homomorphisms `coneMap` are compatible with the inclusions of subrings of `F`. -/
theorem coneMap_compat (s : Cone (schemeDiagram F)) (T T' : Finset F) (h : T ⊆ T')
    (x : F) (hx : x ∈ Subring.closure (↑T : Set F))
    (hx' : x ∈ Subring.closure (↑T' : Set F)) :
    coneMap F s T' ⟨x, hx'⟩ = coneMap F s T ⟨x, hx⟩ := by
  have key : (Scheme.ΓSpecIso (CommRingCat.of (stage F T))).inv ≫ (coneLeg F s T).appTop =
      CommRingCat.ofHom (stageMap F h) ≫
        (Scheme.ΓSpecIso (CommRingCat.of (stage F T'))).inv ≫ (coneLeg F s T').appTop := by
    rw [← Category.assoc, Scheme.ΓSpecIso_inv_naturality, Category.assoc,
      ← Scheme.Hom.comp_appTop, coneLeg_w F s h]
  change ((Scheme.ΓSpecIso (CommRingCat.of (stage F T'))).inv ≫ (coneLeg F s T').appTop).hom
        ((stageEquiv F T').symm ⟨x, hx'⟩)
      = ((Scheme.ΓSpecIso (CommRingCat.of (stage F T))).inv ≫ (coneLeg F s T).appTop).hom
        ((stageEquiv F T).symm ⟨x, hx⟩)
  have harg : (⟨x, hx'⟩ : Subring.closure (↑T' : Set F))
      = Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h)) ⟨x, hx⟩ :=
    Subtype.ext rfl
  rw [key]
  simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
    stageMap_stageEquiv_symm, ← harg]

/-- **The limit of the system is empty.** Any cone over the system has an empty vertex, as soon as
`F` is not `u`-small. -/
theorem isEmpty_cone_pt (hF : ¬ Small.{u} F) (s : Cone (schemeDiagram F)) : IsEmpty s.pt :=
  isEmpty_of_compatible_closureMaps hF s.pt (coneMap F s)
    fun T T' h x hx hx' => coneMap_compat F s T T' h x hx hx'

/-- **The empty cone is a limit cone.** -/
def isLimitEmptyCone (hF : ¬ Small.{u} F) : IsLimit (emptyCone F) where
  lift s := by
    haveI := isEmpty_cone_pt F hF s
    exact isInitialOfIsEmpty.to _
  fac s j := by
    have := isEmpty_cone_pt F hF s
    exact (isInitialOfIsEmpty (X := s.pt)).hom_ext _ _
  uniq s m _ := by
    have := isEmpty_cone_pt F hF s
    exact (isInitialOfIsEmpty (X := s.pt)).hom_ext _ _

/-- Every stage ring is nonzero. -/
instance nontrivial_stage (T : Finset F) : Nontrivial (stage F T) :=
  (stageEquiv F T).toEquiv.nontrivial

/-- Every stage of the system is a nonempty scheme. -/
instance nonempty_schemeDiagram_obj (T : Finset F) : Nonempty ((schemeDiagram F).obj (op T)) :=
  inferInstanceAs (Nonempty (PrimeSpectrum (stage F T)))

end Diagram

section BigField

/-- A field in the universe above `u` which is not `u`-small: the field of rational functions in
`Type u` many variables over the rationals. -/
abbrev bigField : Type (u + 1) := FractionRing (MvPolynomial (Type u) ℚ)

/-- The field `bigField` is not `u`-small. -/
theorem not_small_bigField : ¬ Small.{u} bigField.{u} := by
  intro _
  have hinj : Function.Injective (fun S : Type u =>
      algebraMap (MvPolynomial (Type u) ℚ) bigField.{u} (MvPolynomial.X S)) :=
    (IsFractionRing.injective (MvPolynomial (Type u) ℚ) bigField.{u}).comp
      MvPolynomial.X_injective
  exact not_small_type (small_of_injective hinj)

/-- **A cofiltered system of nonempty affine schemes whose limit is the empty scheme.**

The index category `(Finset bigField)ᵒᵖ` is cofiltered and lives in `Type (u+1)`; every stage is
the spectrum of a nonzero ring, hence a nonempty affine — so quasi-compact and quasi-separated —
scheme; every transition morphism is affine; and the cone with vertex `∅` is a limit cone. -/
def isLimitEmptyConeBigField : IsLimit (emptyCone bigField.{u}) :=
  isLimitEmptyCone _ not_small_bigField

/-- The counterexample, packaged: the cone is limiting, its vertex is empty, and every stage of
the system is nonempty. -/
theorem isEmpty_limit_of_nonempty_stages :
    Nonempty (IsLimit (emptyCone bigField.{u})) ∧
      IsEmpty (emptyCone bigField.{u}).pt ∧
      ∀ T : Finset bigField.{u}, Nonempty ((schemeDiagram bigField.{u}).obj (op T)) :=
  ⟨⟨isLimitEmptyConeBigField⟩, inferInstanceAs (IsEmpty (∅ : Scheme.{u})), fun _ => inferInstance⟩

/-- The system satisfies every hypothesis Situation 081D imposes on it: the index category is
cofiltered, the transition morphisms are affine, and every stage is quasi-compact and
quasi-separated. -/
theorem schemeDiagram_hypotheses :
    IsCofiltered (Finset bigField.{u})ᵒᵖ ∧
      (∀ (i j : (Finset bigField.{u})ᵒᵖ) (g : i ⟶ j),
        IsAffineHom ((schemeDiagram bigField.{u}).map g)) ∧
      (∀ i : (Finset bigField.{u})ᵒᵖ, CompactSpace ((schemeDiagram bigField.{u}).obj i)) ∧
      (∀ i : (Finset bigField.{u})ᵒᵖ, QuasiSeparatedSpace ((schemeDiagram bigField.{u}).obj i)) :=
  ⟨inferInstance, fun _ _ _ => inferInstance, fun _ => inferInstance, fun _ => inferInstance⟩

end BigField

end Stacks.EmptyLimitCounterexample

end
