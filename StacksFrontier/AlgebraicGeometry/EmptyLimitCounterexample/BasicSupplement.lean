namespace Stacks.EmptyLimitCounterexample

/-- **The collapse.** Let `F` be a field and let a commutative ring `A` carry a family of ring
homomorphisms out of the subrings of `F` generated by finite subsets, compatible with the
inclusions. If `A` is nonzero then `F` injects into `A`, by `x ↦ ψ {x} x`: two elements with the
same image cannot differ, because the inverse of their difference lies in a larger finitely
generated subring and would be carried to an inverse of `0`. -/
theorem exists_injective_of_compatible_closureMaps
    {F : Type w} [Field F] {A : Type u} [CommRing A] [Nontrivial A]
    (ψ : (T : Finset F) → Subring.closure (↑T : Set F) →+* A)
    (hψ : ∀ (T T' : Finset F), T ⊆ T' → ∀ (x : F) (hx : x ∈ Subring.closure (↑T : Set F))
        (hx' : x ∈ Subring.closure (↑T' : Set F)), ψ T' ⟨x, hx'⟩ = ψ T ⟨x, hx⟩) :
    ∃ f : F → A, Function.Injective f := by
  classical
  refine ⟨fun x : F => ψ {x} ⟨x, Subring.subset_closure (by simp)⟩, ?_⟩
  · intro x y hxy
    simp only at hxy
    by_contra hne
    have hd : x - y ≠ 0 := sub_ne_zero_of_ne hne
    set T : Finset F := {x, y, (x - y)⁻¹} with hT
    have hmem : ∀ z ∈ T, z ∈ Subring.closure (↑T : Set F) := fun z hz => Subring.subset_closure hz
    have hψT : ∀ z (hz : z ∈ T), ψ T ⟨z, hmem z hz⟩
        = ψ {z} ⟨z, Subring.subset_closure (by simp)⟩ := fun z hz =>
      hψ {z} T (by simpa using hz) z _ _
    have hxT : x ∈ T := by simp [hT]
    have hyT : y ∈ T := by simp [hT]
    have hiT : (x - y)⁻¹ ∈ T := by simp [hT]
    have key : (⟨x, hmem x hxT⟩ - ⟨y, hmem y hyT⟩ : Subring.closure (↑T : Set F)) *
        ⟨(x - y)⁻¹, hmem _ hiT⟩ = 1 := by
      apply Subtype.ext
      push_cast
      field_simp
    have hcon := congrArg (ψ T) key
    rw [map_one, map_mul, map_sub, hψT x hxT, hψT y hyT, hxy] at hcon
    simp at hcon

/-- **The collapse measured by cardinality.** In the situation of
`Stacks.EmptyLimitCounterexample.exists_injective_of_compatible_closureMaps`, with the field and
the ring in the same universe, the field is no larger than the ring. -/
theorem mk_le_of_compatible_closureMaps
    {F : Type u} [Field F] {A : Type u} [CommRing A] [Nontrivial A]
    (ψ : (T : Finset F) → Subring.closure (↑T : Set F) →+* A)
    (hψ : ∀ (T T' : Finset F), T ⊆ T' → ∀ (x : F) (hx : x ∈ Subring.closure (↑T : Set F))
        (hx' : x ∈ Subring.closure (↑T' : Set F)), ψ T' ⟨x, hx'⟩ = ψ T ⟨x, hx⟩) :
    Cardinal.mk F ≤ Cardinal.mk A :=
  let ⟨_, hf⟩ := exists_injective_of_compatible_closureMaps ψ hψ
  Cardinal.mk_le_of_injective hf

/-- **The geometric form of the collapse, measured by cardinality.** A scheme whose global
sections are fewer than the elements of a field `F` carries no compatible family of ring
homomorphisms from the finitely generated subrings of `F` into them unless it is empty. -/
theorem isEmpty_of_compatible_closureMaps_of_mk_lt {F : Type u} [Field F] (Z : Scheme.{u})
    (hF : Cardinal.mk Γ(Z, ⊤) < Cardinal.mk F)
    (ψ : (T : Finset F) → Subring.closure (↑T : Set F) →+* Γ(Z, ⊤))
    (hψ : ∀ (T T' : Finset F), T ⊆ T' → ∀ (x : F) (hx : x ∈ Subring.closure (↑T : Set F))
        (hx' : x ∈ Subring.closure (↑T' : Set F)), ψ T' ⟨x, hx'⟩ = ψ T ⟨x, hx⟩) :
    IsEmpty Z := by
  by_contra hne
  obtain ⟨z⟩ := not_isEmpty_iff.mp hne
  have := nontrivial_Γ_of_nonempty Z z
  exact absurd (mk_le_of_compatible_closureMaps ψ hψ) (not_le_of_gt hF)

section Diagram

variable (F : Type w) [Field F]

/-- **The subring of `F` generated by a finite set is countable**: it is the image of a
polynomial ring over `ℤ` in finitely many variables, and such a ring is countable. -/
instance countableClosure (T : Finset F) : Countable (Subring.closure (↑T : Set F)) := by
  have hset : ((Subring.closure (↑T : Set F) : Subring F) : Set F)
      = Set.range (MvPolynomial.aeval (R := ℤ) (Subtype.val : (↑T : Set F) → F)) := by
    have h := Algebra.adjoin_eq_range ℤ (↑T : Set F)
    rw [Algebra.adjoin_int] at h
    exact congrArg (fun S : Subalgebra ℤ F => (S : Set F)) h
  have hc : Countable (MvPolynomial (↑T : Set F) ℤ) :=
    Function.Injective.countable (f := AddMonoidAlgebra.coeff)
      fun a b h => by cases a; cases b; simp_all
  have : Countable ((Subring.closure (↑T : Set F) : Subring F) : Set F) := by
    rw [hset]; exact (Set.countable_range _).to_subtype
  infer_instance

/-- The subring of `F` generated by a finite set is `u`-small for every universe `u`. -/
instance smallClosure_univ (T : Finset F) : Small.{u} (Subring.closure (↑T : Set F)) :=
  inferInstance

/-- A `Type u` copy of the subring of `F` generated by the finite set `T`. -/
abbrev stageUniv (T : Finset F) : Type u := Shrink.{u} (Subring.closure (↑T : Set F))

/-- The chosen ring isomorphism of `stageUniv F T` onto the subring of `F` generated by `T`. -/
abbrev stageEquivUniv (T : Finset F) : stageUniv F T ≃+* Subring.closure (↑T : Set F) :=
  Shrink.ringEquiv _

/-- The ring `stageUniv F T` is countable. -/
instance countableStage (T : Finset F) : Countable (stageUniv F T) :=
  Countable.of_equiv _ (stageEquivUniv F T).toEquiv.symm

/-- The transition homomorphism `stageUniv F T →+* stageUniv F T'` along an inclusion `T ≤ T'`. -/
def stageMapUniv {T T' : Finset F} (h : T ≤ T') : stageUniv F T →+* stageUniv F T' :=
  ((stageEquivUniv F T').symm.toRingHom).comp
    ((Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))).comp
      (stageEquivUniv F T).toRingHom)

/-- Under the identifications with subrings of `F`, the transition map `stageMapUniv F h` is the
inclusion. -/
@[simp] theorem stageEquiv_stageMap_univ {T T' : Finset F} (h : T ≤ T') (x : stageUniv F T) :
    ((stageEquivUniv F T' (stageMapUniv F h x) : F)) = (stageEquivUniv F T x : F) := by
  simp [stageMapUniv]

/-- The transition map `stageMapUniv F h` carries the copy of `y` to the copy of its image under
the inclusion of subrings. -/
theorem stageMap_stageEquiv_symm_univ {T T' : Finset F} (h : T ≤ T')
    (y : Subring.closure (↑T : Set F)) :
    stageMapUniv F h ((stageEquivUniv F T).symm y)
      = (stageEquivUniv F T').symm (Subring.inclusion (Subring.closure_mono
          (Finset.coe_subset.mpr h)) y) := by
  simp [stageMapUniv]

/-- The transition map along `T ≤ T` is the identity of `CommRingCat.of (stageUniv F T)`. -/
theorem ofHom_stageMap_id_univ (T : Finset F) :
    CommRingCat.ofHom (stageMapUniv F (le_refl T)) = 𝟙 (CommRingCat.of (stageUniv F T)) := by
  ext x; simp [stageMapUniv, RingEquiv.symm_apply_eq, Subtype.ext_iff]

/-- The transition map along `T₁ ≤ T₃` is the composite of the transition maps along `T₁ ≤ T₂`
and `T₂ ≤ T₃`. -/
theorem ofHom_stageMap_comp_univ {T₁ T₂ T₃ : Finset F} (h₁ : T₁ ≤ T₂) (h₂ : T₂ ≤ T₃) :
    CommRingCat.ofHom (stageMapUniv F (h₁.trans h₂)) =
      CommRingCat.ofHom (stageMapUniv F h₁) ≫ CommRingCat.ofHom (stageMapUniv F h₂) := by
  ext x; simp [stageMapUniv, Subtype.ext_iff]

/-- The cofiltered system of affine schemes: the spectra of the rings `stageUniv F T`, indexed by
the finite subsets `T` of `F` ordered by inclusion, read contravariantly. -/
def schemeDiagramUniv : (Finset F)ᵒᵖ ⥤ Scheme.{u} where
  obj T := Spec (CommRingCat.of (stageUniv F T.unop))
  map {T T'} f := Spec.map (CommRingCat.ofHom (stageMapUniv F (leOfHom f.unop)))
  map_id T := by rw [ofHom_stageMap_id_univ, Spec.map_id]
  map_comp f g := by rw [← Spec.map_comp, ← ofHom_stageMap_comp_univ]

/-- The scheme of the system at `T` is the spectrum of `stageUniv F T`. -/
@[simp] theorem schemeDiagram_obj_univ (T : Finset F) :
    (schemeDiagramUniv F).obj (op T) = Spec (CommRingCat.of (stageUniv F T)) := rfl

/-- Every transition morphism of the system is affine. -/
instance isAffineHom_schemeDiagram_map_univ {i j : (Finset F)ᵒᵖ} (g : i ⟶ j) :
    IsAffineHom ((schemeDiagramUniv F).map g) :=
  inferInstanceAs (IsAffineHom (Spec.map _))

/-- Every scheme of the system is affine. -/
instance isAffine_schemeDiagram_obj_univ (i : (Finset F)ᵒᵖ) :
    IsAffine ((schemeDiagramUniv F).obj i) :=
  inferInstanceAs (IsAffine (Spec _))

/-- The cone over the system with the empty scheme as vertex. -/
def emptyConeUniv : Cone (schemeDiagramUniv F) where
  pt := ∅
  π :=
    { app := fun _ => emptyIsInitial.to _
      naturality := fun _ _ _ => emptyIsInitial.hom_ext _ _ }

/-- The leg of a cone over the system at `T`, with its target spelled as the spectrum of
`stageUniv F T`. -/
def coneLegUniv (s : Cone (schemeDiagramUniv F)) (T : Finset F) :
    s.pt ⟶ Spec (CommRingCat.of (stageUniv F T)) := s.π.app (op T)

/-- The legs of a cone at `T ≤ T'` commute with the transition morphism. -/
theorem coneLeg_w_univ (s : Cone (schemeDiagramUniv F)) {T T' : Finset F} (h : T ≤ T') :
    coneLegUniv F s T' ≫ Spec.map (CommRingCat.ofHom (stageMapUniv F h)) = coneLegUniv F s T :=
  s.w (homOfLE h).op

/-- The ring homomorphism from the subring of `F` generated by `T` to the global sections of the
vertex of a cone, given by the cone's leg at `T`. -/
def coneMapUniv (s : Cone (schemeDiagramUniv F)) (T : Finset F) :
    Subring.closure (↑T : Set F) →+* Γ(s.pt, ⊤) :=
  (((Scheme.ΓSpecIso (CommRingCat.of (stageUniv F T))).inv ≫
    (coneLegUniv F s T).appTop).hom).comp (stageEquivUniv F T).symm.toRingHom

/-- The ring homomorphisms `coneMapUniv F s T` are compatible with the inclusions of subrings. -/
theorem coneMap_compat_univ (s : Cone (schemeDiagramUniv F)) (T T' : Finset F) (h : T ⊆ T')
    (x : F) (hx : x ∈ Subring.closure (↑T : Set F))
    (hx' : x ∈ Subring.closure (↑T' : Set F)) :
    coneMapUniv F s T' ⟨x, hx'⟩ = coneMapUniv F s T ⟨x, hx⟩ := by
  have key : (Scheme.ΓSpecIso (CommRingCat.of (stageUniv F T))).inv ≫ (coneLegUniv F s T).appTop =
      CommRingCat.ofHom (stageMapUniv F h) ≫
        (Scheme.ΓSpecIso (CommRingCat.of (stageUniv F T'))).inv ≫ (coneLegUniv F s T').appTop := by
    rw [← Category.assoc, Scheme.ΓSpecIso_inv_naturality, Category.assoc,
      ← Scheme.Hom.comp_appTop, coneLeg_w_univ F s h]
  change ((Scheme.ΓSpecIso (CommRingCat.of (stageUniv F T'))).inv ≫ (coneLegUniv F s T').appTop).hom
        ((stageEquivUniv F T').symm ⟨x, hx'⟩)
      = ((Scheme.ΓSpecIso (CommRingCat.of (stageUniv F T))).inv ≫ (coneLegUniv F s T).appTop).hom
        ((stageEquivUniv F T).symm ⟨x, hx⟩)
  have harg : (⟨x, hx'⟩ : Subring.closure (↑T' : Set F))
      = Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h)) ⟨x, hx⟩ :=
    Subtype.ext rfl
  rw [key]
  simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
    stageMap_stageEquiv_symm_univ, ← harg]

/-- **The limit of the system is empty.** Any cone over the system has an empty vertex, as soon as
`F` is not `u`-small. -/
theorem isEmpty_cone_pt_univ (hF : ¬ Small.{u} F) (s : Cone (schemeDiagramUniv.{w, u} F)) :
    IsEmpty s.pt :=
  isEmpty_of_compatible_closureMaps hF s.pt (coneMapUniv F s)
    fun T T' h x hx hx' => coneMap_compat_univ F s T T' h x hx hx'

/-- **The limit of the system is empty, measured by cardinality.** A cone over the system whose
vertex has fewer global sections than `F` has elements has an empty vertex. -/
theorem isEmpty_cone_pt_of_mk_lt {K : Type u} [Field K] (s : Cone (schemeDiagramUniv K))
    (hK : Cardinal.mk Γ(s.pt, ⊤) < Cardinal.mk K) : IsEmpty s.pt :=
  isEmpty_of_compatible_closureMaps_of_mk_lt s.pt hK (coneMapUniv K s)
    fun T T' h x hx hx' => coneMap_compat_univ K s T T' h x hx hx'

/-- **The empty cone is a limit cone** of the system when `F` is not `u`-small. -/
def isLimitEmptyConeUniv (hF : ¬ Small.{u} F) : IsLimit (emptyConeUniv.{w, u} F) where
  lift s := by
    haveI := isEmpty_cone_pt_univ F hF s
    exact isInitialOfIsEmpty.to _
  fac s j := by
    have := isEmpty_cone_pt_univ F hF s
    exact (isInitialOfIsEmpty (X := s.pt)).hom_ext _ _
  uniq s m _ := by
    have := isEmpty_cone_pt_univ F hF s
    exact (isInitialOfIsEmpty (X := s.pt)).hom_ext _ _

/-- The ring `stageUniv F T` is nonzero. -/
instance nontrivial_stage_univ (T : Finset F) : Nontrivial (stageUniv F T) :=
  (stageEquivUniv F T).toEquiv.nontrivial

/-- Every scheme of the system is nonempty. -/
instance nonempty_schemeDiagram_obj_univ (T : Finset F) :
    Nonempty ((schemeDiagramUniv F).obj (op T)) :=
  inferInstanceAs (Nonempty (PrimeSpectrum (stageUniv F T)))

end Diagram

section BigField

/-- **A cofiltered system of nonempty affine schemes whose limit is the empty scheme.**

The index category `(Finset bigField)ᵒᵖ` is cofiltered and lives in `Type (u+1)`; every scheme of
the system is the spectrum of a nonzero ring, hence a nonempty affine — so quasi-compact and
quasi-separated — scheme; every transition morphism is affine; and the cone with vertex `∅` is a
limit cone. -/
def isLimitEmptyConeBigFieldUniv : IsLimit (emptyConeUniv.{u + 1, u} bigField.{u}) :=
  isLimitEmptyConeUniv _ not_small_bigField

/-- For `bigField`, the empty cone is a limit cone, its vertex is empty, and every scheme of the
system is nonempty. -/
theorem isEmpty_limit_of_nonempty_stages_univ :
    Nonempty (IsLimit (emptyConeUniv.{u + 1, u} bigField.{u})) ∧
      IsEmpty (emptyConeUniv.{u + 1, u} bigField.{u}).pt ∧
      ∀ T : Finset bigField.{u},
        Nonempty ((schemeDiagramUniv.{u + 1, u} bigField.{u}).obj (op T)) :=
  ⟨⟨isLimitEmptyConeBigFieldUniv⟩, inferInstanceAs (IsEmpty (∅ : Scheme.{u})),
    fun _ => inferInstance⟩

/-- For `bigField`, the system satisfies the hypotheses of Situation 081D: the index category is
cofiltered, the transition morphisms are affine, and every scheme of the system is quasi-compact
and quasi-separated. -/
theorem schemeDiagram_hypotheses_univ :
    IsCofiltered (Finset bigField.{u})ᵒᵖ ∧
      (∀ (i j : (Finset bigField.{u})ᵒᵖ) (g : i ⟶ j),
        IsAffineHom ((schemeDiagramUniv.{u + 1, u} bigField.{u}).map g)) ∧
      (∀ i : (Finset bigField.{u})ᵒᵖ,
        CompactSpace ((schemeDiagramUniv.{u + 1, u} bigField.{u}).obj i)) ∧
      (∀ i : (Finset bigField.{u})ᵒᵖ,
        QuasiSeparatedSpace ((schemeDiagramUniv.{u + 1, u} bigField.{u}).obj i)) :=
  ⟨inferInstance, fun _ _ _ => inferInstance, fun _ => inferInstance, fun _ => inferInstance⟩

end BigField

end Stacks.EmptyLimitCounterexample

