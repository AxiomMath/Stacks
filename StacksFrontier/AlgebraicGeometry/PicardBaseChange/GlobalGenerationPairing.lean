module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.InvertibleTrivialization
public import StacksFrontier.AlgebraicGeometry.Cohomology.GlobalGeneration.Stalks
public import StacksFrontier.AlgebraicGeometry.NonvanishingSpelling.Basic
public import StacksFrontier.AlgebraicGeometry.PicardBaseChange.InversePairingLinear
public import StacksFrontier.AlgebraicGeometry.PicardBaseChange.MulIsomorphism
public import StacksFrontier.AlgebraicGeometry.StalkwiseGeneration.Basic
public import StacksFrontier.AlgebraicGeometry.Variety.Curve.SectionDegree

/-!
# A global section of `ℒ` pairing nontrivially with a given section of `ℒ^{⊗ -1}`

Let `ℒ` be an invertible `𝒪_X`-module on a scheme `X` which is generated by its global
sections, and let `t` be a nonzero global section of `ℒ^{⊗ -1}`. Then some global section `s`
of `ℒ` has `s t ≠ 0` in `Γ(X, 𝒪_X)`, the product being the canonical multiplication
`Stacks.SheafOfModules.Invertible.globalSectionsMulNegOne` of [Stacks, Tag 01CU].

## Main results

* `AlgebraicGeometry.exists_mem_nonvanishingLocus_of_generatingSections`: the nonvanishing loci
  of a generating family of global sections of an invertible module cover `X`.
* `AlgebraicGeometry.exists_globalSectionsMulNegOne_ne_zero`: a nonzero global section of
  `ℒ^{⊗ -1}` pairs nontrivially with some global section of `ℒ`.

## References

* [Stacks Project, Tag 01CU](https://stacks.math.columbia.edu/tag/01CU)
* [Stacks Project, Tag 01CY](https://stacks.math.columbia.edu/tag/01CY)
* [Stacks Project, Tag 01AN](https://stacks.math.columbia.edu/tag/01AN)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.SheafOfModules (tensorPairing nonvanishingLocus nonvanishingOpen)
open Stacks.SheafOfModules.Invertible (tensorPowerModule globalSectionsMulNegOne mulNegOneIso)

universe u

namespace AlgebraicGeometry

variable {X : Scheme.{u}}

/-- The nonvanishing loci of a generating family of global sections of an invertible module
cover `X`. -/
theorem exists_mem_nonvanishingLocus_of_generatingSections (L : X.Modules)
    [hL : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.property L]
    (σ : L.GeneratingSections) (x : X) :
    ∃ i, x ∈ nonvanishingLocus (X := X.toRingedSpace) L (σ.s i) := by
  have hLM : Stacks.Ample.IsInvertibleModule X L := hL
  have hspan := (generates_iff_stalkwise_generates X.ringCatSheaf L σ.s).mp σ.epi
  obtain ⟨i, hi⟩ := Stacks.StalkwiseGeneration.exists_mem_nvOpen_of_span_eq_top L
    (fun j => (σ.s j).eval (op ⊤)) x (hspan x)
  refine ⟨i, ?_⟩
  rwa [Stacks.NonvanishingSpelling.stalkNonvanishingLocus_eq X L (σ.s i),
    Stacks.NonvanishingSpelling.sectionsEquiv_apply]

/-- A nonzero global section of `ℒ^{⊗ -1}` pairs nontrivially with some global section of `ℒ`,
when `ℒ` is invertible and generated by its global sections. -/
theorem exists_globalSectionsMulNegOne_ne_zero (L : X.Modules)
    [hL : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.property L]
    (σ : L.GeneratingSections) (t : Γ(tensorPowerModule L (-1), ⊤)) (ht : t ≠ 0) :
    ∃ s : Γ(L, ⊤), globalSectionsMulNegOne L s t ≠ 0 := by
  by_contra hcon
  simp only [not_exists, ne_eq, not_not] at hcon
  have hN : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.property
      (tensorPowerModule L (-1)) :=
    Stacks.SheafOfModules.Invertible.tensorPower_isInvertible X.presheaf X.ringCatSheaf.property
      L (-1)
  set ψ := mulNegOneIso X.presheaf X.ringCatSheaf.property L
  have key : ∀ (i : σ.I) (V : X.Opens),
      (∀ y ∈ V, y ∈ nonvanishingLocus (X := X.toRingedSpace) L (σ.s i)) →
      ((tensorPowerModule L (-1)).val.map (homOfLE (le_top (a := V))).op).hom t = 0 := by
    intro i V hV
    have hinc : V ⟶ (⊤ : X.Opens) := homOfLE le_top
    have htop : tensorPairing ψ ⊤ ((σ.s i).eval (op ⊤)) t = 0 :=
      (Stacks.SheafOfModules.Invertible.mulNegOneIso_toSheafify X.presheaf
        X.ringCatSheaf.property L (op ⊤) ((σ.s i).eval (op ⊤)) t).trans (hcon _)
    have hres := Stacks.SheafOfModules.tensorPairing_res ψ hinc ((σ.s i).eval (op ⊤)) t
    rw [htop, map_zero] at hres
    have hSV : (σ.s i).eval (op V) = (L.val.map hinc.op).hom ((σ.s i).eval (op ⊤)) := by
      simp [PresheafOfModules.sections.eval]
    have h0 : tensorPairing ψ V ((σ.s i).eval (op V))
        (((tensorPowerModule L (-1)).val.map hinc.op).hom t) = 0 := hSV ▸ hres.symm
    exact Stacks.SheafOfModules.tensorPairing_left_injective ψ (σ.s i) V hV
      (h0.trans (tensorPairing_zero_right ψ V ((σ.s i).eval (op V))).symm)
  have hcover : (⊤ : X.Opens) ≤ ⨆ i, nonvanishingOpen (X := X.toRingedSpace) L (σ.s i) := by
    intro x _
    obtain ⟨i, hi⟩ := exists_mem_nonvanishingLocus_of_generatingSections L σ x
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hi⟩
  refine ht (TopCat.Sheaf.eq_of_locally_eq'
    ((_root_.SheafOfModules.toSheaf (structureSheafRing X.toRingedSpace)).obj
      (tensorPowerModule L (-1)))
    (fun i => nonvanishingOpen (X := X.toRingedSpace) L (σ.s i)) ⊤
    (fun _ => homOfLE le_top) hcover t 0 fun i => ?_)
  rw [map_zero]
  exact key i (nonvanishingOpen (X := X.toRingedSpace) L (σ.s i)) fun _ hy => hy

end AlgebraicGeometry

end
