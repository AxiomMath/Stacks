module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import StacksFrontier.AlgebraicGeometry.GradedQuotient
public import StacksCore.Tactic.StacksAttribute

/-!
# The two-generator almost blowup square

For elements `f₁, f₂` of a commutative ring `A`, the projective spectrum of
`A[T₀,T₁]/(f₂T₀-f₁T₁)` maps to `Spec A`. Its inverse image over the center
`Spec (A/(f₁,f₂))` is `Proj (A/(f₁,f₂))[T₀,T₁]`. This is an almost blowup square.

## Main definitions

* `Stacks.AlmostBlowUp.relationIdeal` is the ideal generated by `f₂T₀-f₁T₁`.
* `Stacks.AlmostBlowUp.modificationGrading` is the grading of `A[T₀,T₁]/(f₂T₀-f₁T₁)` by the
  images of the homogeneous pieces of the polynomial grading.
* `Stacks.AlmostBlowUp.TwoGeneratorSquare` records the coordinate-pinned graded maps of the
  square.
* `Stacks.AlmostBlowUp.twoGeneratorSquare` is the canonical square.

## Main results

* `Stacks.AlmostBlowUp.modificationGradedRing` is the graded-ring structure on
  `A[T₀,T₁]/(f₂T₀-f₁T₁)`: the relation is homogeneous of degree one, so the degreewise images
  of the polynomial grading grade the quotient.
* `Stacks.AlmostBlowUp.irrelevant_le_map` is the condition on irrelevant ideals that makes the
  reduction map induce a morphism `Proj (A/(f₁,f₂))[T₀,T₁] ⟶ Proj A[T₀,T₁]/(f₂T₀-f₁T₁)`.

## Implementation notes

The grading on the relation quotient is the degreewise image of the usual
polynomial grading. The coordinate equations on the graded homomorphisms pin
down all maps in the displayed diagram. The ideal sheaf of the center is the
ideal sheaf associated to `(f₁,f₂)` on `Spec A`.

Mathlib has no grading on a quotient by a homogeneous ideal; that general construction is
`Stacks.GradedQuotient.gradedRingOfCoeEq`, and `modificationGradedRing` is its instance here.

The surjectivity of the reduction map `A[T₀,T₁]/(f₂T₀-f₁T₁) → (A/(f₁,f₂))[T₀,T₁]` in each
degree, which is what gives the irrelevant-ideal inclusion, is obtained by lifting a
homogeneous polynomial and then taking the homogeneous component of the same degree of an
arbitrary lift; `map_homogeneousComponent` is the commutation needed for that.

## References

* [Stacks Project, Tag 0EVH](https://stacks.math.columbia.edu/tag/0EVH)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

namespace Stacks.AlmostBlowUp

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

/-! ### Homogeneous components and coefficient maps -/

variable {R S ν : Type*} [CommRing R] [CommRing S]

/-- Reducing the coefficients of a polynomial commutes with taking homogeneous components. -/
theorem map_homogeneousComponent (g : R →+* S) (n : ℕ) (p : MvPolynomial ν R) :
    MvPolynomial.map g (MvPolynomial.homogeneousComponent n p) =
      MvPolynomial.homogeneousComponent n (MvPolynomial.map g p) :=
  MvPolynomial.ext _ _ fun c => by
    simp [MvPolynomial.coeff_map, MvPolynomial.coeff_homogeneousComponent, apply_ite g]

/-- Reducing the coefficients of a homogeneous polynomial gives a homogeneous polynomial of the
same degree. -/
theorem map_mem_homogeneousSubmodule (g : R →+* S) {n : ℕ} {p : MvPolynomial ν R}
    (hp : p ∈ MvPolynomial.homogeneousSubmodule ν R n) :
    MvPolynomial.map g p ∈ MvPolynomial.homogeneousSubmodule ν S n := by
  rw [MvPolynomial.mem_homogeneousSubmodule] at hp ⊢
  exact hp.map g

/-- A homogeneous polynomial over `S` lifts to a homogeneous polynomial of the same degree over
`R` along any surjection `R → S`. -/
theorem exists_homogeneous_preimage (g : R →+* S) (hg : Function.Surjective g) {n : ℕ}
    {q : MvPolynomial ν S} (hq : q ∈ MvPolynomial.homogeneousSubmodule ν S n) :
    ∃ p ∈ MvPolynomial.homogeneousSubmodule ν R n, MvPolynomial.map g p = q := by
  obtain ⟨p, hp⟩ := MvPolynomial.map_surjective g hg q
  refine ⟨MvPolynomial.homogeneousComponent n p, MvPolynomial.homogeneousComponent_mem n p, ?_⟩
  rw [map_homogeneousComponent, hp, MvPolynomial.homogeneousComponent_eq_self hq]

/-! ### The two rings of the square -/

variable (A : Type u) [CommRing A] (f₁ f₂ : A)

/-- The ideal `(f₁,f₂)`. -/
abbrev centerIdeal : Ideal A := Ideal.span {f₁, f₂}

/-- The coordinate ring of the center. -/
abbrev centerRing := A ⧸ centerIdeal A f₁ f₂

/-- The single homogeneous equation `f₂T₀-f₁T₁`. -/
def relationIdeal : Ideal (MvPolynomial (Fin 2) A) :=
  Ideal.span {MvPolynomial.C f₂ * MvPolynomial.X 0 -
    MvPolynomial.C f₁ * MvPolynomial.X 1}

/-- The coordinate ring of the modification. -/
abbrev modificationRing := MvPolynomial (Fin 2) A ⧸ relationIdeal A f₁ f₂

/-- The grading of the homogeneous relation quotient. -/
abbrev modificationGrading : ℕ → AddSubgroup (modificationRing A f₁ f₂) :=
  fun d => ((MvPolynomial.homogeneousSubmodule (Fin 2) A) d).toAddSubgroup.map
    (Ideal.Quotient.mk (relationIdeal A f₁ f₂)).toAddMonoidHom

/-- The ideal sheaf defining the center inside `Spec A`. -/
def centerIdealSheaf : (Spec (.of A)).IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop
    (Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom (centerIdeal A f₁ f₂))

/-- The standard grading on the projective line over the center ring. -/
abbrev exceptionalGrading : ℕ → Submodule (centerRing A f₁ f₂)
    (MvPolynomial (Fin 2) (centerRing A f₁ f₂)) :=
  MvPolynomial.homogeneousSubmodule (Fin 2) (centerRing A f₁ f₂)

/-! ### The grading of the relation quotient -/

/-- The relation `f₂T₀-f₁T₁` is homogeneous of degree one. -/
theorem relation_mem_homogeneousSubmodule :
    MvPolynomial.C f₂ * MvPolynomial.X (0 : Fin 2) -
        MvPolynomial.C f₁ * MvPolynomial.X (1 : Fin 2) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) A 1 := by
  have h : ∀ (a : A) (i : Fin 2),
      (MvPolynomial.C a * MvPolynomial.X i : MvPolynomial (Fin 2) A) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) A 1 := fun a i => by
    simpa using (MvPolynomial.isHomogeneous_C _ a).mul (MvPolynomial.isHomogeneous_X _ i)
  exact sub_mem (h f₂ 0) (h f₁ 1)

/-- The relation ideal is homogeneous, being generated by a homogeneous element. -/
theorem relationIdeal_isHomogeneous :
    (relationIdeal A f₁ f₂).IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin 2) A) :=
  Ideal.homogeneous_span _ _ fun x hx => by
    rw [Set.mem_singleton_iff] at hx
    exact ⟨1, hx ▸ relation_mem_homogeneousSubmodule A f₁ f₂⟩

/-- The degreewise images of the polynomial grading grade `A[T₀,T₁]/(f₂T₀-f₁T₁)`. -/
@[instance_reducible]
def modificationGradedRing : GradedRing (modificationGrading A f₁ f₂) :=
  Stacks.GradedQuotient.gradedRingOfCoeEq _ _ (relationIdeal_isHomogeneous A f₁ f₂) _
    fun _ => AddSubgroup.coe_map _ _

/-! ### The three structure maps -/

/-- The ring map `A[T₀,T₁]/(f₂T₀-f₁T₁) → (A/(f₁,f₂))[T₀,T₁]` reducing the coefficients. -/
def exceptionalRingHom :
    modificationRing A f₁ f₂ →+* MvPolynomial (Fin 2) (centerRing A f₁ f₂) :=
  Ideal.Quotient.lift (relationIdeal A f₁ f₂)
    (MvPolynomial.map (Ideal.Quotient.mk (centerIdeal A f₁ f₂))) <| by
      have h₁ : Ideal.Quotient.mk (centerIdeal A f₁ f₂) f₁ = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
      have h₂ : Ideal.Quotient.mk (centerIdeal A f₁ f₂) f₂ = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
      have hle : relationIdeal A f₁ f₂ ≤
          RingHom.ker (MvPolynomial.map (Ideal.Quotient.mk (centerIdeal A f₁ f₂))) := by
        rw [relationIdeal, Ideal.span_le]
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        simp [hx, RingHom.mem_ker, h₁, h₂]
      exact fun p hp => RingHom.mem_ker.mp (hle hp)

/-- The map `exceptionalRingHom` sends the class of a polynomial `p` to `p` with its coefficients
reduced modulo `(f₁, f₂)`. -/
@[simp]
theorem exceptionalRingHom_mk (p : MvPolynomial (Fin 2) A) :
    exceptionalRingHom A f₁ f₂ (Ideal.Quotient.mk (relationIdeal A f₁ f₂) p) =
      MvPolynomial.map (Ideal.Quotient.mk (centerIdeal A f₁ f₂)) p := rfl

/-- The reduction map as a homomorphism of graded rings. -/
def exceptionalGradedHom : modificationGrading A f₁ f₂ →+*ᵍ exceptionalGrading A f₁ f₂ where
  __ := exceptionalRingHom A f₁ f₂
  map_mem := by
    intro d x hx
    obtain ⟨p, hp, rfl⟩ := AddSubgroup.mem_map.mp hx
    exact map_mem_homogeneousSubmodule _ (Iff.mp (Submodule.mem_toAddSubgroup _) hp)

/-- The map `exceptionalGradedHom` sends the class of a polynomial `p` to `p` with its
coefficients reduced modulo `(f₁, f₂)`. -/
@[simp]
theorem exceptionalGradedHom_mk (p : MvPolynomial (Fin 2) A) :
    exceptionalGradedHom A f₁ f₂ (Ideal.Quotient.mk (relationIdeal A f₁ f₂) p) =
      MvPolynomial.map (Ideal.Quotient.mk (centerIdeal A f₁ f₂)) p := rfl

/-- The reduction map is surjective in every degree. -/
theorem exceptionalGradedHom_gradedAddHom_surjective (d : ℕ) :
    Function.Surjective ((exceptionalGradedHom A f₁ f₂).gradedAddHom d) := by
  rintro ⟨q, hq⟩
  obtain ⟨p, hp, hpq⟩ :=
    exists_homogeneous_preimage (Ideal.Quotient.mk (centerIdeal A f₁ f₂))
      Ideal.Quotient.mk_surjective hq
  exact ⟨⟨Ideal.Quotient.mk (relationIdeal A f₁ f₂) p,
    AddSubgroup.mem_map_of_mem _ (Iff.mpr (Submodule.mem_toAddSubgroup _) hp)⟩,
    Subtype.ext (by simpa using hpq)⟩

section Graded

variable [GradedRing (modificationGrading A f₁ f₂)]

/-- The coefficient map `A → A[T₀,T₁]/(f₂T₀-f₁T₁)` onto the degree-zero part. -/
def baseRingHom : A →+* modificationGrading A f₁ f₂ 0 where
  toFun a := ⟨Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.C a),
    AddSubgroup.mem_map_of_mem _ (Iff.mpr (Submodule.mem_toAddSubgroup _)
      (MvPolynomial.isHomogeneous_C _ a))⟩
  map_one' := Subtype.ext (by simp)
  map_mul' _ _ := Subtype.ext (by simp)
  map_zero' := Subtype.ext (by simp)
  map_add' _ _ := Subtype.ext (by simp)

/-- The irrelevant ideal of the exceptional projective line is contained in the image of the
irrelevant ideal of the modification, because the reduction map is surjective in every degree. -/
theorem irrelevant_le_map :
    HomogeneousIdeal.irrelevant (exceptionalGrading A f₁ f₂) ≤
      (HomogeneousIdeal.irrelevant (modificationGrading A f₁ f₂)).map
        (exceptionalGradedHom A f₁ f₂) := by
  rw [HomogeneousIdeal.irrelevant_le]
  intro i hi x hx
  obtain ⟨a, ha⟩ := exceptionalGradedHom_gradedAddHom_surjective A f₁ f₂ i ⟨x, hx⟩
  have hax : exceptionalGradedHom A f₁ f₂ a.1 = x := congrArg Subtype.val ha
  exact hax ▸ Ideal.mem_map_of_mem _ (HomogeneousIdeal.mem_irrelevant_of_mem _ hi a.2)

end Graded

/-- The coefficient map `A/(f₁,f₂) → (A/(f₁,f₂))[T₀,T₁]` onto the degree-zero part. -/
def centerRingHom : centerRing A f₁ f₂ →+* exceptionalGrading A f₁ f₂ 0 where
  toFun a := ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C _ a⟩
  map_one' := Subtype.ext (by simp)
  map_mul' _ _ := Subtype.ext (by simp)
  map_zero' := Subtype.ext (by simp)
  map_add' _ _ := Subtype.ext (by simp)

/-! ### The square -/

/-- Coordinate-pinned data for the two-generator square. The equations ensure that
all arrows arise from the quotient map and the coefficient maps, rather than
from arbitrary maps between the same schemes. -/
structure TwoGeneratorSquare where
  /-- The grading of `A[T₀,T₁]/(f₂T₀-f₁T₁)` by the degreewise images of the polynomial
  grading, which makes the upper-right corner of the square a `Proj`. -/
  modificationGraded : GradedRing (modificationGrading A f₁ f₂)
  /-- The map of `A` into the degree-zero part of `A[T₀,T₁]/(f₂T₀-f₁T₁)`, which makes the
  upper-right corner a scheme over `Spec A`. -/
  baseMap : letI := modificationGraded; A →+* modificationGrading A f₁ f₂ 0
  /-- The map of `A` into degree zero is the one induced by the constants. -/
  baseMap_apply (a : A) :
    (baseMap a : modificationRing A f₁ f₂) =
      Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.C a)
  /-- The graded map of `A[T₀,T₁]/(f₂T₀-f₁T₁)` onto `(A/(f₁,f₂))[T₀,T₁]`, which cuts out the
  upper-left corner of the square inside the upper-right one. -/
  exceptionalMap : letI := modificationGraded; modificationGrading A f₁ f₂ →+*ᵍ
    exceptionalGrading A f₁ f₂
  /-- The graded map onto `(A/(f₁,f₂))[T₀,T₁]` is the one reducing the coefficients. -/
  exceptionalMap_apply (p : MvPolynomial (Fin 2) A) :
    exceptionalMap (Ideal.Quotient.mk (relationIdeal A f₁ f₂) p) =
      MvPolynomial.map (Ideal.Quotient.mk (centerIdeal A f₁ f₂)) p
  /-- The irrelevant-ideal condition under which `exceptionalMap` induces a morphism of
  projective spectra. -/
  exceptionalDomain : letI := modificationGraded;
    HomogeneousIdeal.irrelevant (exceptionalGrading A f₁ f₂) ≤
      (HomogeneousIdeal.irrelevant (modificationGrading A f₁ f₂)).map exceptionalMap
  /-- The map of `A/(f₁,f₂)` into the degree-zero part of `(A/(f₁,f₂))[T₀,T₁]`, which makes the
  upper-left corner a scheme over the center. -/
  centerMap : centerRing A f₁ f₂ →+* exceptionalGrading A f₁ f₂ 0
  /-- The map of `A/(f₁,f₂)` into degree zero is the one induced by the constants. -/
  centerMap_apply (a : centerRing A f₁ f₂) :
    (centerMap a : MvPolynomial (Fin 2) (centerRing A f₁ f₂)) =
      MvPolynomial.C a

/-- The canonical coordinate-pinned square associated to two elements. -/
def twoGeneratorSquare : TwoGeneratorSquare A f₁ f₂ :=
  letI := modificationGradedRing A f₁ f₂
  { modificationGraded := modificationGradedRing A f₁ f₂
    baseMap := baseRingHom A f₁ f₂
    baseMap_apply := fun _ => rfl
    exceptionalMap := exceptionalGradedHom A f₁ f₂
    exceptionalMap_apply := fun _ => rfl
    exceptionalDomain := irrelevant_le_map A f₁ f₂
    centerMap := centerRingHom A f₁ f₂
    centerMap_apply := fun _ => rfl }

/-- The morphism from the projective hypersurface to `Spec A`. -/
def modificationToBase :
    letI := (twoGeneratorSquare A f₁ f₂).modificationGraded
    AlgebraicGeometry.Proj (modificationGrading A f₁ f₂) ⟶ Spec (.of A) :=
  letI := (twoGeneratorSquare A f₁ f₂).modificationGraded
  Proj.toSpecZero (modificationGrading A f₁ f₂) ≫
    Spec.map (CommRingCat.ofHom (twoGeneratorSquare A f₁ f₂).baseMap)

/-- The canonical exceptional scheme map into the projective hypersurface. -/
def exceptionalToModification :
    letI := (twoGeneratorSquare A f₁ f₂).modificationGraded
    AlgebraicGeometry.Proj (exceptionalGrading A f₁ f₂) ⟶
      AlgebraicGeometry.Proj (modificationGrading A f₁ f₂) :=
  letI := (twoGeneratorSquare A f₁ f₂).modificationGraded
  Proj.map (twoGeneratorSquare A f₁ f₂).exceptionalMap
    (twoGeneratorSquare A f₁ f₂).exceptionalDomain

/-- The canonical map of the exceptional projective line to the center. -/
def exceptionalToCenter :
    AlgebraicGeometry.Proj (exceptionalGrading A f₁ f₂) ⟶
      Spec (.of (centerRing A f₁ f₂)) :=
  Proj.toSpecZero (exceptionalGrading A f₁ f₂) ≫
    Spec.map (CommRingCat.ofHom (twoGeneratorSquare A f₁ f₂).centerMap)

/-- The map of the center to `Spec A`. -/
def centerToBase :
    Spec (.of (centerRing A f₁ f₂)) ⟶ Spec (.of A) :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (centerIdeal A f₁ f₂)))

end Stacks.AlmostBlowUp

end
