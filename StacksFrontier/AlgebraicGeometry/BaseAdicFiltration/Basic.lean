module

public import Mathlib.AlgebraicGeometry.Morphisms.Flat
public import Mathlib.RingTheory.Flat.Localization
public import StacksFrontier.AlgebraicGeometry.DivisorFlatPullback.Basic
public import StacksFrontier.AlgebraicGeometry.Divisors.FittingIdeals.Basic
public import StacksFrontier.AlgebraicGeometry.Scheme.AffineOpenNeighborhood
public import StacksFrontier.AlgebraicGeometry.Scheme.AffineOpenSectionExt

/-!
# The ideal sheaf generated by an ideal of the base ring

Let `A` be a commutative ring, `U` a scheme and `p : U ⟶ Spec A` a morphism.  An ideal `I ⊆ A`
generates a quasi-coherent ideal sheaf `I 𝒪_U` on `U`.  This file describes its sections over an
affine open, the `k`-th power of its ideal as it meets the global functions coming from `Iᵏ`, and
its stalks.  The `A`-algebra structures on the sections of `𝒪_U` over an open and on a stalk are
those induced by `Stacks.BaseAdicFiltration.baseScalarMap`, and for a flat `p` every stalk of `𝒪_U`
is a flat `A`-module.

## Main definitions

* `Stacks.BaseAdicFiltration.baseScalarMap`: the ring map `A → Γ(U, 𝒪_U)` attached to `p`.
* `Stacks.BaseAdicFiltration.baseIdeal`: the ideal sheaf `I 𝒪_U`.
* `Stacks.BaseAdicFiltration.sectionsAlgebra` and `Stacks.BaseAdicFiltration.stalkAlgebra`: the
  `A`-algebra structures on the sections over an open and on a stalk, both induced by
  `baseScalarMap`.

## Main results

* `Stacks.BaseAdicFiltration.baseIdeal_ideal`: the sections of `I 𝒪_U` over an affine open `V` are
  generated by the image of `I` under `A → Γ(U, V)`.
* `Stacks.BaseAdicFiltration.restrictMemIdealPow_baseScalarMap`: the global function determined by
  an element of `Iᵏ` has all its restrictions in the `k`-th power of the ideal of `I 𝒪_U`.
* `Stacks.BaseAdicFiltration.stalk_baseIdeal`: the stalk of `I 𝒪_U` at `x` is the image of `I` in
  `𝒪_{U,x}`.
* `Stacks.BaseAdicFiltration.flat_stalk_of_flat`: for a flat `p` every stalk of `𝒪_U` is a flat
  `A`-module.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped AlgebraicGeometry

universe u

namespace Stacks.BaseAdicFiltration

variable {A : Type u} [CommRing A] {U : Scheme.{u}}

/-! ### The scalar map and the ideal sheaf -/

/-- The ring homomorphism `A → Γ(U, 𝒪_U)` attached to a morphism `p : U ⟶ Spec A`. -/
def baseScalarMap (p : U ⟶ Spec (CommRingCat.of A)) : A →+* Γ(U, ⊤) :=
  ((Scheme.ΓSpecIso (.of A)).inv ≫ p.appTop).hom

/-- The ideal sheaf `I 𝒪_U` generated by an ideal `I` of the base ring, for a morphism
`p : U ⟶ Spec A`: the inverse image along `p` of the ideal sheaf on `Spec A` determined by `I`. -/
def baseIdeal (p : U ⟶ Spec (CommRingCat.of A)) (I : Ideal A) : U.IdealSheafData :=
  (Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap p

/-- The ideal of `I 𝒪_U` on an affine open `V` is generated by the image of `I` under the
composite `A → Γ(Spec A, ⊤) → Γ(U, V)`. -/
theorem baseIdeal_ideal (p : U ⟶ Spec (CommRingCat.of A)) (I : Ideal A) (V : U.affineOpens) :
    (baseIdeal p I).ideal V =
      I.map ((p.appLE ⊤ V.1 le_top).hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) := by
  have htop : (Scheme.IdealSheafData.ofIdealTop
        (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).ideal
        ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of A))⟩ =
      I.map (Scheme.ΓSpecIso (.of A)).inv.hom := by
    rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    simp
  rw [baseIdeal, Stacks.IdealSheaf.ideal_comap_appLE _ p
      ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of A))⟩ V le_top, htop, Ideal.map_map]

/-- The restriction of `Stacks.BaseAdicFiltration.baseScalarMap` to an open is the map of
sections of `p` there. -/
theorem map_baseScalarMap (p : U ⟶ Spec (CommRingCat.of A)) {V : U.Opens} (a : A) :
    (U.presheaf.map (homOfLE (le_top (a := V))).op).hom (baseScalarMap p a) =
      (p.appLE ⊤ V le_top).hom ((Scheme.ΓSpecIso (.of A)).inv.hom a) :=
  rfl

/-- The global function on `U` determined by an element of `Iᵏ` has all its restrictions to affine
opens in the `k`-th power of the ideal of `I 𝒪_U` there. -/
theorem restrictMemIdealPow_baseScalarMap (p : U ⟶ Spec (CommRingCat.of A)) {I : Ideal A}
    (k : ℕ) {a : A} (ha : a ∈ I ^ k) (V : U.affineOpens) :
    (U.presheaf.map (homOfLE (le_top (a := V.1))).op).hom (baseScalarMap p a) ∈
      (baseIdeal p I).ideal V ^ k := by
  rw [baseIdeal_ideal, ← Ideal.map_pow, map_baseScalarMap]
  exact Ideal.mem_map_of_mem _ ha

/-! ### The algebra structures -/

/-- The `A`-algebra structure on the sections of `𝒪_U` over an open, induced by
`Stacks.BaseAdicFiltration.baseScalarMap`. -/
@[instance_reducible]
def sectionsAlgebra (p : U ⟶ Spec (CommRingCat.of A)) (V : U.Opens) :
    Algebra A Γ(U, V) :=
  (((U.presheaf.map (homOfLE (le_top (a := V))).op).hom).comp (baseScalarMap p)).toAlgebra

/-- The `A`-algebra structure on a stalk of `𝒪_U`, induced by
`Stacks.BaseAdicFiltration.baseScalarMap`. -/
@[instance_reducible]
def stalkAlgebra (p : U ⟶ Spec (CommRingCat.of A)) (x : U) :
    Algebra A (U.presheaf.stalk x) :=
  (((U.presheaf.germ ⊤ x trivial).hom).comp (baseScalarMap p)).toAlgebra

/-- For the algebra structure `Stacks.BaseAdicFiltration.stalkAlgebra`, the image of `a : A` in the
stalk `𝒪_{U,x}` is the germ at `x` of the global function `baseScalarMap p a`. -/
theorem stalkAlgebra_algebraMap (p : U ⟶ Spec (CommRingCat.of A)) (x : U) (a : A) :
    letI := stalkAlgebra p x
    algebraMap A (U.presheaf.stalk x) a =
      (U.presheaf.germ ⊤ x trivial).hom (baseScalarMap p a) :=
  rfl

/-- For the algebra structure `Stacks.BaseAdicFiltration.sectionsAlgebra`, the image of `a : A` in
`Γ(U, V)` is the restriction to `V` of the global function `baseScalarMap p a`. -/
theorem sectionsAlgebra_algebraMap (p : U ⟶ Spec (CommRingCat.of A)) (V : U.Opens) (a : A) :
    letI := sectionsAlgebra p V
    algebraMap A Γ(U, V) a =
      (U.presheaf.map (homOfLE (le_top (a := V))).op).hom (baseScalarMap p a) :=
  rfl

/-- The germ map at `x` is a morphism of `A`-algebras from the sections over a neighbourhood of
`x` to the stalk. -/
theorem germ_algebraMap (p : U ⟶ Spec (CommRingCat.of A)) {V : U.Opens} {x : U} (hx : x ∈ V)
    (a : A) :
    letI := sectionsAlgebra p V
    letI := stalkAlgebra p x
    (U.presheaf.germ V x hx).hom (algebraMap A Γ(U, V) a) =
      algebraMap A (U.presheaf.stalk x) a := by
  let := sectionsAlgebra p V
  let := stalkAlgebra p x
  rw [sectionsAlgebra_algebraMap, stalkAlgebra_algebraMap]
  exact TopCat.Presheaf.germ_res_apply U.presheaf (homOfLE (le_top (a := V))) x hx _

/-! ### The stalk of the ideal sheaf -/

/-- The stalk of `I 𝒪_U` at a point is the image of `I` in the local ring. -/
theorem stalk_baseIdeal (p : U ⟶ Spec (CommRingCat.of A)) (I : Ideal A) (x : U) :
    letI := stalkAlgebra p x
    IdealSheafData.stalk (baseIdeal p I) x =
      I.map (algebraMap A (U.presheaf.stalk x)) := by
  let := stalkAlgebra p x
  obtain ⟨V, hxV, -⟩ := exists_affineOpen_mem_le x ⊤ trivial
  rw [IdealSheafData.stalk_eq_map_germ _ _ V hxV, baseIdeal_ideal, Ideal.map_map]
  refine congrArg (Ideal.map · I) (RingHom.ext fun a => ?_)
  let := sectionsAlgebra p V.1
  exact germ_algebraMap p hxV a

/-- The `n`-th power of the stalk of `I 𝒪_U` is the image of `Iⁿ`. -/
theorem stalk_baseIdeal_pow (p : U ⟶ Spec (CommRingCat.of A)) (I : Ideal A) (n : ℕ) (x : U) :
    letI := stalkAlgebra p x
    IdealSheafData.stalk (baseIdeal p I) x ^ n =
      (I.map (algebraMap A (U.presheaf.stalk x))) ^ n :=
  congrArg (· ^ n) (stalk_baseIdeal p I x)

/-! ### Flatness of the stalks -/

/-- For a flat morphism `p : U ⟶ Spec A` the sections of `𝒪_U` over an affine open form a flat
`A`-algebra. -/
theorem flat_sections_of_flat (p : U ⟶ Spec (CommRingCat.of A)) [AlgebraicGeometry.Flat p]
    (V : U.affineOpens) :
    letI := sectionsAlgebra p V.1
    Module.Flat A Γ(U, V.1) := by
  let := sectionsAlgebra p V.1
  have hflat : (p.appLE ⊤ V.1 le_top).hom.Flat :=
    AlgebraicGeometry.Flat.flat_appLE p (isAffineOpen_top (Spec (CommRingCat.of A))) V.2 le_top
  have halg : (RingHom.Flat (algebraMap A Γ(U, V.1))) := by
    have hcomp : (algebraMap A Γ(U, V.1)) =
        (p.appLE ⊤ V.1 le_top).hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom := rfl
    rw [hcomp]
    exact RingHom.Flat.comp
      (RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso _)) hflat
  exact RingHom.flat_algebraMap_iff.mp halg

/-- For a flat morphism `p : U ⟶ Spec A` every stalk of `𝒪_U` is a flat `A`-module. -/
theorem flat_stalk_of_flat (p : U ⟶ Spec (CommRingCat.of A)) [AlgebraicGeometry.Flat p] (x : U) :
    letI := stalkAlgebra p x
    Module.Flat A (U.presheaf.stalk x) := by
  let := stalkAlgebra p x
  obtain ⟨V, hxV, -⟩ := exists_affineOpen_mem_le x ⊤ trivial
  let := sectionsAlgebra p V.1
  have hVflat := flat_sections_of_flat p V
  let : Algebra Γ(U, V.1) (U.presheaf.stalk x) :=
    (U.presheaf.germ V.1 x hxV).hom.toAlgebra
  have : IsScalarTower A Γ(U, V.1) (U.presheaf.stalk x) :=
    IsScalarTower.of_algebraMap_eq fun a => (germ_algebraMap p hxV a).symm
  have : IsLocalization (V.2.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl
      (U.presheaf.stalk x) :=
    V.2.isLocalization_stalk ⟨x, hxV⟩
  have : Module.Flat Γ(U, V.1) (U.presheaf.stalk x) :=
    IsLocalization.flat (U.presheaf.stalk x) (V.2.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl
  exact Module.Flat.trans A Γ(U, V.1) (U.presheaf.stalk x)

end Stacks.BaseAdicFiltration

end
