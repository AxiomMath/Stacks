/-!
# The twisted inverse image of a Koszul-regular closed immersion: the vanishing

Let `i : Z ⟶ X` be a closed immersion of schemes, `X` quasi-compact and quasi-separated, whose
defining ideal sheaf `J` is, near every point of `Z`, generated by a Koszul-regular sequence of
`r` sections. Let `c` be the right adjoint of `Ri_*` on `D_QCoh`. Then the cohomology sheaves of
`c(𝒪_X)` vanish in every degree `n ≠ r`, so `c(𝒪_X)` is its degree-`r` cohomology sheaf placed
in degree `r`.

The argument: `c(𝒪_X) = R ℰom(𝒪_Z, 𝒪_X)` is represented by `ℰom(𝒪_Z, I)` for a K-injective
resolution `I` of `𝒪_X`, whose direct image is `𝓗om^•(i_*𝒪_Z[0], I)`; the cohomology sheaves of
the latter are the Ext sheaves `𝓔xtⁿ(𝒪_X/J, 𝒪_X)`, which vanish for `n ≠ r`, and `i_*` reflects
zero objects.

## Main results

* `Stacks.Duality.KoszulRegular.isZero_homology_twistedInverseImage`
* `Stacks.Duality.KoszulRegular.nonempty_iso_singleFunctor_twistedInverseImage`
-/

-- This file uses the locally small derived-category models below, which are not
-- global instances (see `StacksFrontier.Homology.DerivedCategory.LocallySmall`):
-- `D(R)` for sheaves of modules on a small site.
-- `D(𝒪_X)` for a scheme.
attribute [local instance] SheafOfModules.hasDerivedCategory
attribute [local instance] AlgebraicGeometry.Scheme.Modules.hasDerivedCategory

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits RingedSpaceModuleAdjunction
open HomologicalComplex

universe u

namespace Stacks.Duality.KoszulRegular

open Stacks.AlgebraicGeometry.RegularIdealSheaf

variable {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]

/-- The defining ideal sheaf of a closed immersion, on the target. -/
abbrev idealOf : (RingedSpace.structureSheafModule X.toRingedSpace).Submodule :=
  definingIdealOfHom i

/-- The direct image of the structure sheaf along a closed immersion is the quotient of the
structure sheaf by the defining ideal sheaf. -/
def cokernelIsoPushforwardUnit :
    cokernel (idealOf i).ι ≅
      (modulePushforward (Stacks.Duality.closedQuotient i).i).obj
        (SheafOfModules.unit (structureSheafRing (Stacks.Duality.closedQuotient i).Z)) :=
  haveI : Epi (SheafOfModules.unitToPushforwardObjUnit
      (structureSheafHom i.toLRSHom.toShHom)) :=
    AlgebraicGeometry.Scheme.Modules.epi_unitToPushforwardObjUnit i
  (cokernelIsCokernel (idealOf i).ι).coconePointUniqueUpToIso
    (Abelian.epiIsCokernelOfKernel _
      (SheafOfModules.Submodule.isLimitKernelFork
        (SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i.toLRSHom.toShHom))))

end Stacks.Duality.KoszulRegular

namespace Stacks.Duality.KoszulRegular

open Stacks.AlgebraicGeometry.RegularIdealSheaf

variable {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]

/-- `i_* ℰom(𝒪_Z, I) ≅ 𝓗om^•(i_*(𝒪_Z[0]), I)` on complexes. -/
def pushforwardSheafHomExactSupportIso
    (I : CochainComplex (SheafOfModules.{u} (structureSheafRing X.toRingedSpace)) ℤ) :
    ((modulePushforward (Stacks.Duality.closedQuotient i).i).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj
      (((Stacks.Duality.closedQuotient i).sheafHomExactSupport.mapHomologicalComplex
        (ComplexShape.up ℤ)).obj I) ≅
      (RingedSite.sheafHomComplex (Stacks.SheafOfModules.ringedSite X.sheaf)
        (((modulePushforward (Stacks.Duality.closedQuotient i).i).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj
          (RingedSite.structureSheafComplex (Stacks.SheafOfModules.ringedSite Z.sheaf))) I).obj :=
  ((modulePushforward (Stacks.Duality.closedQuotient i).i).mapHomologicalComplex
      (ComplexShape.up ℤ)).mapIso
      (RingedSite.structureSheafHomIso (Stacks.SheafOfModules.ringedSite Z.sheaf) _).symm ≪≫
    (Stacks.Duality.closedQuotient i).pushforwardSheafHomComplexIsoSite _ I

end Stacks.Duality.KoszulRegular

namespace Stacks.Duality.KoszulRegular

open Stacks.AlgebraicGeometry.RegularIdealSheaf

variable {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]

/-- The direct image of `𝒪_Z[0]` presents the quotient of `𝒪_X` by the defining ideal sheaf. -/
def pushforwardStructureSheafComplexIso :
    ((modulePushforward (Stacks.Duality.closedQuotient i).i).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj
      (RingedSite.structureSheafComplex (Stacks.SheafOfModules.ringedSite Z.sheaf)) ≅
      (HomologicalComplex.single (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
        (ComplexShape.up ℤ) 0).obj (cokernel (idealOf i).ι) :=
  (HomologicalComplex.singleMapHomologicalComplex
      (modulePushforward (Stacks.Duality.closedQuotient i).i) (ComplexShape.up ℤ) 0).app _ ≪≫
    (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).mapIso (cokernelIsoPushforwardUnit i).symm

end Stacks.Duality.KoszulRegular

namespace Stacks.Duality.KoszulRegular

open Stacks.AlgebraicGeometry.RegularIdealSheaf

variable {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]

/-- The category of sheaves of `𝒪_X`-modules on a scheme `X` is Grothendieck abelian. -/
instance isGrothendieckAbelian_modules (X : Scheme.{u}) :
    IsGrothendieckAbelian.{u} (SheafOfModules.{u} (structureSheafRing X.toRingedSpace)) :=
  inferInstance

/-- The chosen K-injective resolution of `𝒪_X[0]`. -/
abbrev unitResolution :
    CochainComplex (SheafOfModules.{u} (structureSheafRing X.toRingedSpace)) ℤ :=
  (Stacks.Injectives.kInjectiveResolutionFunctor _).obj
    ((HomologicalComplex.single (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
      (ComplexShape.up ℤ) 0).obj (SheafOfModules.unit (structureSheafRing X.toRingedSpace)))

/-- The augmentation of the chosen resolution of `𝒪_X[0]`. -/
abbrev unitResolutionι :
    (HomologicalComplex.single (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
      (ComplexShape.up ℤ) 0).obj (SheafOfModules.unit (structureSheafRing X.toRingedSpace)) ⟶
      unitResolution (X := X) :=
  (Stacks.Injectives.kInjectiveResolutionInclusion _).app _

/-- `c(𝒪_X)` is represented by `ℰom(𝒪_Z, I)` for the chosen K-injective resolution `I` of
`𝒪_X[0]`. -/
def twistedInverseImageIsoSheafHomExactSupport [CompactSpace X] [QuasiSeparatedSpace X]
    (hpc : PseudoCoherent i) :
    ((twistedInverseImage i (hpushClosedImmersion i)).obj
        (DerivedPushforward.derivedStructureSheaf X)).obj ≅
      DerivedCategory.Q.obj
        (((Stacks.Duality.closedQuotient i).sheafHomExactSupport.mapHomologicalComplex
          (ComplexShape.up ℤ)).obj (unitResolution (X := X))) :=
  twistedInverseImageStructureSheafIso i hpc ≪≫
    (LocallySmall.derivedSheafHomExactSupport i).mapIso
      (show (DerivedPushforward.derivedStructureSheaf X).obj ≅ _ from
        ((DerivedCategory.quotientCompQhIso
          (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))).app
          ((HomologicalComplex.single (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
            (ComplexShape.up ℤ) 0).obj
              (SheafOfModules.unit (structureSheafRing X.toRingedSpace)))).symm) ≪≫
    AnyModel.derivedSheafHomExactSupportObjIso (Stacks.Duality.closedQuotient i)
      (unitResolutionι (X := X))
      (Stacks.Injectives.kInjectiveResolutionFunctor_obj_isKInjective
        (SheafOfModules.{u} (structureSheafRing X.toRingedSpace)) _)
      (Stacks.Injectives.kInjectiveResolutionInclusion_quasiIso
        (SheafOfModules.{u} (structureSheafRing X.toRingedSpace)) _)

end Stacks.Duality.KoszulRegular

namespace Stacks.Duality.KoszulRegular

open Stacks.AlgebraicGeometry.RegularIdealSheaf

variable {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]

/-- `i_*` of the cohomology sheaves of `ℰom(𝒪_Z, I)` are the cohomology sheaves of
`𝓗om^•(i_*(𝒪_Z[0]), I)`. -/
def pushforwardHomologyIso
    (I : CochainComplex (SheafOfModules.{u} (structureSheafRing X.toRingedSpace)) ℤ) (n : ℤ) :
    (modulePushforward (Stacks.Duality.closedQuotient i).i).obj
        ((((Stacks.Duality.closedQuotient i).sheafHomExactSupport.mapHomologicalComplex
          (ComplexShape.up ℤ)).obj I).homology n) ≅
      (RingedSite.sheafHomComplex (Stacks.SheafOfModules.ringedSite X.sheaf)
        (((modulePushforward (Stacks.Duality.closedQuotient i).i).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj
          (RingedSite.structureSheafComplex
            (Stacks.SheafOfModules.ringedSite Z.sheaf))) I).obj.homology
        n :=
  ((Stacks.Homology.exactHomologyIso (modulePushforward (Stacks.Duality.closedQuotient i).i) n).app
      _).symm ≪≫
    (HomologicalComplex.homologyFunctor _ (ComplexShape.up ℤ) n).mapIso
      (pushforwardSheafHomExactSupportIso i I)

/-- An object whose direct image along a closed immersion is zero is zero. -/
theorem isZero_of_isZero_modulePushforward
    {M : SheafOfModules.{u} (structureSheafRing (Stacks.Duality.closedQuotient i).Z)}
    (h : IsZero ((modulePushforward (Stacks.Duality.closedQuotient i).i).obj M)) : IsZero M :=
  (IsZero.iff_id_eq_zero M).2
    ((modulePushforward (Stacks.Duality.closedQuotient i).i).map_injective (h.eq_of_src _ _))

section Standard

attribute [local instance 10000] HasDerivedCategory.standard

/-- The augmentation of the chosen resolution of `𝒪_X[0]` is an isomorphism in the derived
category. -/
instance isIso_Q_map_unitResolutionι :
    IsIso (DerivedCategory.Q.map (unitResolutionι (X := X))) :=
  (DerivedCategory.isIso_Q_map_iff_quasiIso _ _).2
    (Stacks.Injectives.kInjectiveResolutionInclusion_quasiIso
      (SheafOfModules.{u} (structureSheafRing X.toRingedSpace)) _)

/-- The chosen resolution of `𝒪_X[0]`, in the derived category. -/
def unitResolutionIso :
    DerivedCategory.Q.obj
        ((HomologicalComplex.single (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
          (ComplexShape.up ℤ) 0).obj (SheafOfModules.unit (structureSheafRing X.toRingedSpace))) ≅
      DerivedCategory.Q.obj (unitResolution (X := X)) :=
  asIso (DerivedCategory.Q.map (unitResolutionι (X := X)))

/-- The cohomology sheaves of `𝓗om^•(i_*(𝒪_Z[0]), I)` vanish off the length of the Koszul
presentations. -/
theorem isZero_homology_sheafHomComplex_unitResolution {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport X.toRingedSpace (idealOf i),
      ∃ d : KoszulPresentation X.toRingedSpace (idealOf i), x ∈ d.U ∧ d.r = r)
    {n : ℤ} (hn : n ≠ r) :
    IsZero ((RingedSite.sheafHomComplex (Stacks.SheafOfModules.ringedSite X.sheaf)
        (((modulePushforward (Stacks.Duality.closedQuotient i).i).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj
          (RingedSite.structureSheafComplex (Stacks.SheafOfModules.ringedSite Z.sheaf)))
        (unitResolution (X := X))).obj.homology n) :=
  isZero_homology_sheafHomComplex_of_ne (idealOf i) (pushforwardStructureSheafComplexIso i)
    (unitResolution (X := X))
    (Stacks.Injectives.kInjectiveResolutionFunctor_obj_isKInjective
      (SheafOfModules.{u} (structureSheafRing X.toRingedSpace)) _)
    unitResolutionIso hr hn

/-- The chosen K-injective model of `𝒪_X/J`: the one the self-Ext algebra of [Stacks, Tag 0BQY]
is formed from. -/
abbrev quotientModel (i : Z ⟶ X) [IsClosedImmersion i] :
    CochainComplex (SheafOfModules.{u} (structureSheafRing X.toRingedSpace)) ℤ :=
  koszulQuotientModel (Y := X.toRingedSpace) (idealOf i)

/-- A morphism from the resolution of `𝒪_X` to the model of `𝒪_X/J` lying over the quotient
map. -/
theorem exists_unitResolution_hom :
    ∃ g : unitResolution (X := X) ⟶ quotientModel i,
      unitResolutionIso.hom ≫ DerivedCategory.Q.map g ≫
        (koszulQuotientModelIso (Y := X.toRingedSpace) (idealOf i)).inv =
      DerivedCategory.Q.map ((HomologicalComplex.single
        (SheafOfModules.{u} (structureSheafRing X.toRingedSpace)) (ComplexShape.up ℤ) 0).map
          (quotientπ (idealOf i))) := by
  have := isKInjective_koszulQuotientModel (Y := X.toRingedSpace) (idealOf i)
  obtain ⟨g, hg⟩ := (CochainComplex.IsKInjective.Qh_map_bijective
      ((HomotopyCategory.quotient _ (ComplexShape.up ℤ)).obj (unitResolution (X := X)))
      (quotientModel i)).surjective
    ((DerivedCategory.quotientCompQhIso _).hom.app _ ≫
      (inv (DerivedCategory.Q.map (unitResolutionι (X := X))) ≫
        DerivedCategory.Q.map ((HomologicalComplex.single
          (SheafOfModules.{u} (structureSheafRing X.toRingedSpace)) (ComplexShape.up ℤ) 0).map
            (quotientπ (idealOf i))) ≫
        (koszulQuotientModelIso (Y := X.toRingedSpace) (idealOf i)).hom) ≫
      (DerivedCategory.quotientCompQhIso _).inv.app _)
  obtain ⟨g, rfl⟩ := (HomotopyCategory.quotient _ (ComplexShape.up ℤ)).map_surjective g
  refine ⟨g, ?_⟩
  have h := DerivedCategory.quotientCompQhIso_hom_naturality
    (C := SheafOfModules.{u} (structureSheafRing X.toRingedSpace)) g
  rw [hg] at h
  simp only [Category.assoc, Iso.inv_hom_id_app, Category.comp_id] at h
  have hQ := (cancel_epi _).1 h
  rw [show unitResolutionIso.hom = DerivedCategory.Q.map (unitResolutionι (X := X)) from rfl,
    ← hQ]
  simp

end Standard

/-- **The cohomology sheaves of `c(𝒪_X)` vanish off the length of the Koszul presentations.** -/
theorem isZero_homology_twistedInverseImage [CompactSpace X] [QuasiSeparatedSpace X]
    (hpc : PseudoCoherent i) {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport X.toRingedSpace (idealOf i),
      ∃ d : KoszulPresentation X.toRingedSpace (idealOf i), x ∈ d.U ∧ d.r = r)
    {n : ℤ} (hn : n ≠ r) :
    IsZero ((DerivedCategory.homologyFunctor Z.Modules n).obj
      ((twistedInverseImage i (hpushClosedImmersion i)).obj
        (DerivedPushforward.derivedStructureSheaf X)).obj) := by
  refine IsZero.of_iso ?_ ((DerivedCategory.homologyFunctor Z.Modules n).mapIso
    (twistedInverseImageIsoSheafHomExactSupport i hpc) ≪≫
      (DerivedCategory.homologyFunctorFactors _ n).app _)
  exact isZero_of_isZero_modulePushforward i (IsZero.of_iso
    (isZero_homology_sheafHomComplex_unitResolution i hr hn) (pushforwardHomologyIso i _ n))

end Stacks.Duality.KoszulRegular

namespace Stacks.Duality.KoszulRegular

open Stacks.AlgebraicGeometry.RegularIdealSheaf

variable {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]

/-- An object of the derived category whose cohomology sheaves vanish off degree `r` is its
degree-`r` cohomology sheaf placed in degree `r`. -/
theorem nonempty_iso_singleFunctor_homology {C : Type*} [Category C] [Abelian C]
    [HasDerivedCategory C] (K : DerivedCategory C) (r : ℤ)
    (h : ∀ n, n ≠ r → IsZero ((DerivedCategory.homologyFunctor C n).obj K)) :
    Nonempty (K ≅ (DerivedCategory.singleFunctor C r).obj
      ((DerivedCategory.homologyFunctor C r).obj K)) := by
  have : K.IsGE r := (DerivedCategory.isGE_iff K r).2 fun n hn => h n (ne_of_lt hn)
  have : K.IsLE r := (DerivedCategory.isLE_iff K r).2 fun n hn => h n (ne_of_gt hn)
  obtain ⟨Y, ⟨e⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE K r
  exact ⟨e ≪≫ (DerivedCategory.singleFunctor C r).mapIso
    ((DerivedCategory.homologyFunctor C r).mapIso e ≪≫
      (DerivedCategory.singleFunctorCompHomologyFunctorIso C r).app Y).symm⟩

/-- **`c(𝒪_X)` is concentrated in degree `r`**: it is its degree-`r` cohomology sheaf placed in
degree `r`. -/
theorem nonempty_iso_singleFunctor_twistedInverseImage [CompactSpace X] [QuasiSeparatedSpace X]
    (hpc : PseudoCoherent i) {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport X.toRingedSpace (idealOf i),
      ∃ d : KoszulPresentation X.toRingedSpace (idealOf i), x ∈ d.U ∧ d.r = r) :
    Nonempty (((twistedInverseImage i (hpushClosedImmersion i)).obj
        (DerivedPushforward.derivedStructureSheaf X)).obj ≅
      (DerivedCategory.singleFunctor Z.Modules r).obj
        ((DerivedCategory.homologyFunctor Z.Modules r).obj
          ((twistedInverseImage i (hpushClosedImmersion i)).obj
            (DerivedPushforward.derivedStructureSheaf X)).obj)) :=
  nonempty_iso_singleFunctor_homology _ _ fun _ hn =>
    isZero_homology_twistedInverseImage i hpc hr hn

end Stacks.Duality.KoszulRegular
