attribute [local instance 10000] HasDerivedCategory.standard

/-- **The degree-one self-Ext sheaf of `𝒪_X/J` is `𝓗om(J, 𝒪_X/J)`.** -/
def selfExtModelOneIso :
    (selfExtModel i).piece 1 ≅
      (internalHomSecondFunctor.{u, u, u, u} (Opens.grothendieckTopology X) X.sheaf
        (idealOf i).toSheafOfModules).obj (cokernel (idealOf i).ι) := by
  haveI := isKInjective_koszulQuotientModel (Y := X.toRingedSpace) (idealOf i)
  haveI := Stacks.Duality.isIso_normalSheafToSheafExtOne X.toRingedSpace (idealOf i)
  let Q' : CochainComplex (Stacks.SheafOfModules.StructureSheafModules X.sheaf) ℤ :=
    koszulQuotientModel (idealOf i)
  haveI : Q'.IsKInjective := isKInjective_koszulQuotientModel (Y := X.toRingedSpace) (idealOf i)
  exact endComplexHomologyIso (idealOf i) (Iso.refl _) (koszulQuotientModel (idealOf i))
      (isKInjective_koszulQuotientModel (idealOf i)) (koszulQuotientModelIso (idealOf i)) 1 ≪≫
    Stacks.RegularSequence.KoszulChainData.homologySheafHomComplexIsoDerivedSheafExt X.sheaf
      (Am := (single _ (ComplexShape.up ℤ) 0).obj (cokernel (idealOf i).ι))
      (J := Q') 1 ≪≫
    Stacks.SheafOfModules.derivedSheafExtMapIso X.sheaf 1 (Iso.refl _)
      (koszulQuotientModelIso (idealOf i)).symm ≪≫
    (Stacks.RingedSpace.sheafExtIsoDerivedSheafExt X.toRingedSpace (cokernel (idealOf i).ι)
      (cokernel (idealOf i).ι) 1).symm ≪≫
    (asIso (Stacks.Duality.normalSheafToSheafExtOne X.toRingedSpace (idealOf i))).symm ≪≫
    @asIso _ _ _ _ ((internalHomMapLeftNatTrans X.sheaf (cokernel.π
      (Stacks.Duality.idealSquareInclusion X.toRingedSpace (idealOf i)))).app
        (cokernel (idealOf i).ι))
      (Stacks.Duality.isIso_internalHomMapLeft_cokernelπ_idealSquareInclusion
        X.toRingedSpace (idealOf i))

end

/-- `i^*J` is the conormal sheaf of `i`. -/
def pullbackIdealIsoConormal :
    (modulePullback (Stacks.Duality.closedQuotient i).i).obj (idealOf i).toSheafOfModules ≅
      (modulePullback i.liftCoborder.toLRSHom.toShHom).obj
        (Stacks.ClosedImmersion.idealSheaf i.liftCoborder.toLRSHom.toShHom) :=
  (modulePullback (Stacks.Duality.closedQuotient i).i).mapIso
      (SheafOfModules.Submodule.kerIsoKernel
        (SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i.toLRSHom.toShHom))) ≪≫
    Stacks.Conormal.pullbackIdealSheafIsoOfCompEq i.liftCoborder i.coborderRange.ι i
      (Scheme.Hom.liftCoborder_ι i)

/-- **`i_*` of the normal sheaf is `𝓗om(J, 𝒪_X/J)`.** -/
def pushforwardNormalSheafIso :
    (modulePushforward (Stacks.Duality.closedQuotient i).i).obj (Stacks.Divisors.normalSheaf i) ≅
      (internalHomSecondFunctor.{u, u, u, u} (Opens.grothendieckTopology X) X.sheaf
        (idealOf i).toSheafOfModules).obj (cokernel (idealOf i).ι) :=
  ((modulePushforward (Stacks.Duality.closedQuotient i).i).mapIso
      (Stacks.SheafOfModules.dualSheafIso _ _ (pullbackIdealIsoConormal i))).symm ≪≫
    ((Stacks.PullbackSheafTensor.pushforwardInternalHomPullbackIso
      (Stacks.Duality.closedQuotient i).i (idealOf i).toSheafOfModules).app
        (SheafOfModules.unit (structureSheafRing (Stacks.Duality.closedQuotient i).Z))).symm ≪≫
    (internalHomSecondFunctor.{u, u, u, u} (Opens.grothendieckTopology X) X.sheaf
      (idealOf i).toSheafOfModules).mapIso (cokernelIsoPushforwardUnit i).symm

/-- The direct image `i_*N` of the normal sheaf is the degree-one piece of the self-Ext algebra
of `𝒪_X/J`. -/
def pushforwardNormalSheafIsoSelfExtOne :
    (modulePushforward (Stacks.Duality.closedQuotient i).i).obj (Stacks.Divisors.normalSheaf i) ≅
      (selfExtModel i).piece 1 :=
  pushforwardNormalSheafIso i ≪≫ (selfExtModelOneIso i).symm

/-- `i_*(⋀ʳ N) ≅ i_* Hʳ(c(𝒪_X))`. -/
def pushforwardExteriorPowerIsoTop [CompactSpace X] [QuasiSeparatedSpace X]
    (hpc : PseudoCoherent i) {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport X.toRingedSpace (idealOf i),
      ∃ d : KoszulPresentation X.toRingedSpace (idealOf i), x ∈ d.U ∧ d.r = r) :
    (modulePushforward (Stacks.Duality.closedQuotient i).i).obj
        (Scheme.Modules.exteriorPower (Stacks.Divisors.normalSheaf i) r) ≅
      (modulePushforward (Stacks.Duality.closedQuotient i).i).obj
        ((DerivedCategory.homologyFunctor Z.Modules r).obj
          ((twistedInverseImage i (hpushClosedImmersion i)).obj
            (DerivedPushforward.derivedStructureSheaf X)).obj) :=
  pushforwardExteriorPowerIso i hr (Stacks.Divisors.normalSheaf i)
      (pushforwardNormalSheafIsoSelfExtOne i) r ≪≫
    (_root_.SheafOfModules.GradedAlgebra.restrictScalars_descend_piece_iso
      (quotientRingHom (idealOf i)) (selfExtModel i) (smul_selfExtModel_eq_zero i hr) r).symm ≪≫
    restrictScalarsSelfExtTopIsoPushforward i hpc hr

/-- **The top cohomology sheaf of `c(𝒪_X)` is `⋀ʳ N`.** -/
def exteriorPowerIsoTop [CompactSpace X] [QuasiSeparatedSpace X]
    (hpc : PseudoCoherent i) {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport X.toRingedSpace (idealOf i),
      ∃ d : KoszulPresentation X.toRingedSpace (idealOf i), x ∈ d.U ∧ d.r = r) :
    Scheme.Modules.exteriorPower (Stacks.Divisors.normalSheaf i) r ≅
      (DerivedCategory.homologyFunctor Z.Modules r).obj
        ((twistedInverseImage i (hpushClosedImmersion i)).obj
          (DerivedPushforward.derivedStructureSheaf X)).obj :=
  (Functor.FullyFaithful.ofFullyFaithful
    (modulePushforward (Stacks.Duality.closedQuotient i).i)).preimageIso
      (pushforwardExteriorPowerIsoTop i hpc hr)

/-- **`c(𝒪_X) ≅ ⋀ʳ N [-r]`** for a closed immersion with Koszul presentations of constant
length `r` near the support. -/
def twistedInverseImageIso [CompactSpace X] [QuasiSeparatedSpace X]
    (hpc : PseudoCoherent i) {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport X.toRingedSpace (idealOf i),
      ∃ d : KoszulPresentation X.toRingedSpace (idealOf i), x ∈ d.U ∧ d.r = r) :
    (DerivedCategory.singleFunctor Z.Modules r).obj
        (Scheme.Modules.exteriorPower (Stacks.Divisors.normalSheaf i) r) ≅
      ((twistedInverseImage i (hpushClosedImmersion i)).obj
        (DerivedPushforward.derivedStructureSheaf X)).obj :=
  (DerivedCategory.singleFunctor Z.Modules r).mapIso (exteriorPowerIsoTop i hpc hr) ≪≫
    (nonempty_iso_singleFunctor_twistedInverseImage i hpc hr).some.symm

end Stacks.Duality.KoszulRegular
