universe u

namespace Stacks.Duality.KoszulRegular

open Stacks.AlgebraicGeometry.RegularIdealSheaf Stacks.Sites

variable {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]

omit [IsClosedImmersion i] in
/-- Koszul presentations of constant length near the support make the ideal sheaf
Koszul-regular. -/
theorem isKoszulRegularIdealSheaf_of_presentations {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport X.toRingedSpace (idealOf i),
      ∃ d : KoszulPresentation X.toRingedSpace (idealOf i), x ∈ d.U ∧ d.r = r) :
    IsKoszulRegularIdealSheaf X.toRingedSpace (idealOf i) := fun x hx =>
  let ⟨d, hxd, _⟩ := hr x hx
  ⟨d.U, hxd, d.r, d.f, d.koszulExact, d.generated⟩

/-- The self-Ext algebra of `𝒪_X/J`. -/
abbrev selfExt {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport X.toRingedSpace (idealOf i),
      ∃ d : KoszulPresentation X.toRingedSpace (idealOf i), x ∈ d.U ∧ d.r = r) :=
  koszulRegularSelfExtAlgebra (Y := X.toRingedSpace) (idealOf i)
    (isKoszulRegularIdealSheaf_of_presentations i hr)

section Standard

attribute [local instance 10000] HasDerivedCategory.standard

/-- **The top self-Ext sheaf of `𝒪_X/J` is the top cohomology sheaf of
`𝓗om^•(i_*(𝒪_Z[0]), I)`**, as `𝒪_X`-modules. -/
def restrictScalarsSelfExtTopIso {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport X.toRingedSpace (idealOf i),
      ∃ d : KoszulPresentation X.toRingedSpace (idealOf i), x ∈ d.U ∧ d.r = r) :
    (SheafOfModules.restrictScalars (quotientRingHom (idealOf i))).obj
        ((selfExt i hr).piece r) ≅
      (RingedSite.sheafHomComplex (Stacks.SheafOfModules.ringedSite X.sheaf)
        (((modulePushforward (Stacks.Duality.closedQuotient i).i).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj
          (RingedSite.structureSheafComplex (Stacks.SheafOfModules.ringedSite Z.sheaf)))
        (unitResolution (X := X))).obj.homology r :=
  SheafOfModules.GradedAlgebra.restrictScalars_descend_piece_iso _ _ _ _ ≪≫
    (homologyTopIso (idealOf i) (pushforwardStructureSheafComplexIso i) (unitResolution (X := X))
      (Stacks.Injectives.kInjectiveResolutionFunctor_obj_isKInjective
        (SheafOfModules.{u} (structureSheafRing X.toRingedSpace)) _)
      unitResolutionIso (quotientModel i)
      (isKInjective_koszulQuotientModel (Y := X.toRingedSpace) (idealOf i))
      (koszulQuotientModelIso (Y := X.toRingedSpace) (idealOf i)) hr
      (exists_unitResolution_hom i).choose (exists_unitResolution_hom i).choose_spec).symm

end Standard

/-- **The top self-Ext sheaf is the direct image of the top cohomology sheaf of `c(𝒪_X)`**, as
`𝒪_X`-modules. -/
def restrictScalarsSelfExtTopIsoPushforward [CompactSpace X] [QuasiSeparatedSpace X]
    (hpc : PseudoCoherent i) {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport X.toRingedSpace (idealOf i),
      ∃ d : KoszulPresentation X.toRingedSpace (idealOf i), x ∈ d.U ∧ d.r = r) :
    (SheafOfModules.restrictScalars (quotientRingHom (idealOf i))).obj
        ((selfExt i hr).piece r) ≅
      (modulePushforward (Stacks.Duality.closedQuotient i).i).obj
        ((DerivedCategory.homologyFunctor Z.Modules r).obj
          ((twistedInverseImage i (hpushClosedImmersion i)).obj
            (DerivedPushforward.derivedStructureSheaf X)).obj) :=
  restrictScalarsSelfExtTopIso i hr ≪≫ (pushforwardHomologyIso i _ r).symm ≪≫
    (modulePushforward (Stacks.Duality.closedQuotient i).i).mapIso
      ((DerivedCategory.homologyFunctor Z.Modules r).mapIso
        (twistedInverseImageIsoSheafHomExactSupport i hpc) ≪≫
        (DerivedCategory.homologyFunctorFactors _ (r : ℤ)).app _).symm

/-- The direct image `i_*𝒪_Z`, as a sheaf of commutative rings on `X`. -/
abbrev pushforwardRing : Sheaf (Opens.grothendieckTopology X) CommRingCat.{u} :=
  Stacks.SheafOfModules.pushforwardCommRingSheaf (Opens.grothendieckTopology X)
    (Opens.map i.base) (Osharp := Z.sheaf)

/-- The comorphism `𝒪_X ⟶ i_*𝒪_Z`, as a morphism of sheaves of commutative rings. -/
def comorphism : X.sheaf ⟶ pushforwardRing i :=
  ObjectProperty.homMk i.toLRSHom.toShHom.hom.c

omit [IsClosedImmersion i] in
/-- The kernel of `𝒪_X ⟶ i_*𝒪_Z` over an open is the defining ideal there. -/
theorem ker_comorphism (V : (Opens X)ᵒᵖ) :
    RingHom.ker ((comorphism i).hom.app V).hom = sectionIdeal (idealOf i) V := by
  ext s
  rfl

/-- The comorphism of a closed immersion is locally surjective. -/
instance isLocallySurjective_comorphism :
    Presheaf.IsLocallySurjective (Opens.grothendieckTopology X) (comorphism i).hom :=
  Stacks.ClosedImmersion.isLocallySurjective_c_toShHom i

/-- **`𝒪_X/J ≅ i_*𝒪_Z`**, compatibly with the two maps out of `𝒪_X`. -/
def quotientRingIso : quotientRingSheaf.{u, u, u} (idealOf i) ≅ pushforwardRing i :=
  quotientRingSheafIso (comorphism i) (idealOf i) (ker_comorphism i)

/-- The comorphism `𝒪_X ⟶ i_*𝒪_Z`, as a morphism of sheaves of rings. -/
abbrev comorphismRing :=
  (sheafCompose (Opens.grothendieckTopology X) (forget₂ CommRingCat RingCat)).map (comorphism i)

/-- `𝒪_X/J ≅ i_*𝒪_Z`, as a morphism of sheaves of rings. -/
abbrev quotientRingIsoRing :=
  (sheafCompose (Opens.grothendieckTopology X) (forget₂ CommRingCat RingCat)).map
    (quotientRingIso i).hom

/-- `𝒪_X ⟶ 𝒪_X/J ≅ i_*𝒪_Z` is the comorphism. -/
theorem quotientRingHom_comp_quotientRingIsoRing :
    quotientRingHom (idealOf i) ≫ quotientRingIsoRing i = comorphismRing i :=
  ((sheafCompose (Opens.grothendieckTopology X)
    (forget₂ CommRingCat RingCat)).map_comp _ _).symm.trans
    (congrArg (sheafCompose (Opens.grothendieckTopology X) (forget₂ CommRingCat RingCat)).map
      (toQuotientRingSheaf_comp_quotientRingSheafIso_hom (comorphism i) (idealOf i)
        (ker_comorphism i)))

/-- The comorphism of a closed immersion is locally surjective, as a map of sheaves of rings. -/
instance isLocallySurjective_comorphismRing :
    Presheaf.IsLocallySurjective (Opens.grothendieckTopology X) (comorphismRing i).hom :=
  ⟨fun s => (isLocallySurjective_comorphism i).imageSieve_mem s⟩

/-- The identification `𝒪_X/J ≅ i_*𝒪_Z` is an isomorphism of presheaves of rings. -/
instance isIso_quotientRingIsoRing_hom : IsIso (quotientRingIsoRing i).hom :=
  inferInstanceAs (IsIso ((sheafToPresheaf _ _).map (quotientRingIsoRing i)))

section Exterior

open _root_.SheafOfModules.GradedAlgebra

attribute [local instance 10000] HasDerivedCategory.standard

variable {r : ℕ}
  (hr : ∀ x ∈ idealQuotientSupport X.toRingedSpace (idealOf i),
    ∃ d : KoszulPresentation X.toRingedSpace (idealOf i), x ∈ d.U ∧ d.r = r)

/-- The composition-product algebra of the K-injective model of `𝒪_X/J`, over `𝒪_X`. -/
abbrev selfExtModel :
    _root_.SheafOfModules.GradedAlgebra.{u, u} (structureSheafRing X.toRingedSpace) :=
  globalHomologyGradedAlgebra (X := X.toRingedSpace)
    (koszulQuotientModel (Y := X.toRingedSpace) (idealOf i))

omit [IsClosedImmersion i] in
include hr in
/-- `J` annihilates the self-Ext algebra of `𝒪_X/J`. -/
theorem smul_selfExtModel_eq_zero :
    ∀ (n : ℤ) (W : (Opens X)ᵒᵖ) (b : (structureSheafRing X.toRingedSpace).obj.obj W),
      b ∈ RingHom.ker ((quotientRingHom (idealOf i)).hom.app W).hom →
        ∀ m : ((selfExtModel i).piece n).val.obj W, b • m = 0 :=
  fun n W b hb m =>
    smul_globalHomologyPiece_eq_zero (Y := X.toRingedSpace) (idealOf i)
      (koszulQuotientModel (idealOf i))
      (isKInjective_koszulQuotientModel (idealOf i)) (koszulQuotientModelIso (idealOf i))
      (isKoszulRegularIdealSheaf_of_presentations i hr) n W b hb m

/-- The comorphism and the quotient map `𝒪_X ⟶ 𝒪_X/J` have the same kernel. -/
theorem ker_comorphismRing (W : (Opens X)ᵒᵖ) :
    RingHom.ker ((comorphismRing i).hom.app W).hom =
      RingHom.ker ((quotientRingHom (idealOf i)).hom.app W).hom :=
  @Stacks.SheafOfModules.ChangeOfRings.ker_eq_ker_of_ringIso _ _ _ _ _ _
    (quotientRingHom (idealOf i)) (comorphismRing i) (quotientRingIsoRing i)
    (quotientRingHom_comp_quotientRingIsoRing i)
    ((sheafCompose (Opens.grothendieckTopology X) (forget₂ CommRingCat RingCat)).mapIso
      (quotientRingIso i)) rfl W

include hr in
/-- The kernel of `𝒪_X ⟶ i_*𝒪_Z` annihilates the self-Ext algebra of `𝒪_X/J`. -/
theorem smul_selfExtModel_eq_zero' :
    ∀ (n : ℤ) (W : (Opens X)ᵒᵖ) (b : (structureSheafRing X.toRingedSpace).obj.obj W),
      b ∈ RingHom.ker ((comorphismRing i).hom.app W).hom →
        ∀ m : ((selfExtModel i).piece n).val.obj W, b • m = 0 := fun n W b hb m =>
  smul_selfExtModel_eq_zero i hr n W b (ker_comorphismRing i W ▸ hb) m

/-- The self-Ext algebra of `𝒪_X/J`, descended to an algebra over `i_*𝒪_Z`. -/
abbrev selfExtPushforward :=
  descend (comorphismRing i) (selfExtModel i) (smul_selfExtModel_eq_zero' i hr)

omit [IsClosedImmersion i] in
/-- **[Stacks, Tag 0BQY]**: the self-Ext algebra of `𝒪_X/J` is the exterior algebra of its
degree-one piece. -/
theorem isExteriorAlgebra_selfExt :
    IsExteriorAlgebra (selfExt i hr) (𝟙 ((selfExt i hr).piece 1)) :=
  let A0 := _root_.SheafOfModules.algebras (Opens.grothendieckTopology X)
    (Osharp := quotientRingSheaf.{u, u, u} (idealOf i)) ((selfExt i hr).piece 1)
  IsExteriorAlgebra.of_desc_isIso A0.exterior_isExteriorAlgebra (𝟙 _)
    (squareZero_id_koszulRegularSelfExtAlgebra (Y := X.toRingedSpace) (idealOf i)
      (isKoszulRegularIdealSheaf_of_presentations i hr))
    (isIso_desc_app_isKoszulRegularIdealSheaf (Y := X.toRingedSpace) (idealOf i)
      (isKoszulRegularIdealSheaf_of_presentations i hr) A0.exterior A0.exteriorGenerator
      A0.exterior_isExteriorAlgebra)

/-- The self-Ext algebra descended to `i_*𝒪_Z` is the exterior algebra of anything isomorphic to
its degree-one piece. -/
theorem isExteriorAlgebra_selfExtPushforward {M : _root_.SheafOfModules.{u}
      ((sheafCompose (Opens.grothendieckTopology X) (forget₂ CommRingCat RingCat)).obj
        (pushforwardRing i))}
    (ι : M ⟶ (selfExtPushforward i hr).piece 1) [hι : IsIso ι] :
    IsExteriorAlgebra (selfExtPushforward i hr) ι :=
  have hd := @isIso_descendRingIsoHom_app _ _ _ _ _ _ (quotientRingHom (idealOf i)) _
    (comorphismRing i) (isLocallySurjective_comorphismRing i) (quotientRingIsoRing i)
    (quotientRingHom_comp_quotientRingIsoRing i) (selfExtModel i)
    (smul_selfExtModel_eq_zero i hr) (smul_selfExtModel_eq_zero' i hr) 1
  @isExteriorAlgebra_descend_of_ringIso _ _ _ _ _ _ (quotientRingHom (idealOf i)) _
    (comorphismRing i) (isLocallySurjective_comorphismRing i)
    (quotientRingIsoRing i) (quotientRingHom_comp_quotientRingIsoRing i) (selfExtModel i)
    (smul_selfExtModel_eq_zero i hr) (smul_selfExtModel_eq_zero' i hr)
    (Presheaf.isLocallySurjective_of_iso _ (quotientRingIsoRing i).hom) M ι
    (@IsExteriorAlgebra.of_id_comp_isIso _ _ _ _ _ _ _ _ (Functor.map_isIso
      (F := _root_.SheafOfModules.restrictScalars.{u} (quotientRingIsoRing i)) (f := ι)) _ hd
      (isExteriorAlgebra_selfExt i hr))

/-- **The exterior powers of a sheaf of `𝒪_Z`-modules `N`, pushed forward, are the pieces of
the self-Ext algebra of `𝒪_X/J`**, as soon as the degree-one piece is `i_*N`. -/
def pushforwardExteriorPowerIso
    (N : _root_.SheafOfModules.{u} (structureSheafRing Z.toRingedSpace))
    (e1 : (modulePushforward (Stacks.Duality.closedQuotient i).i).obj N ≅ (selfExtModel i).piece 1)
    (n : ℕ) :
    (modulePushforward (Stacks.Duality.closedQuotient i).i).obj
        (Scheme.Modules.exteriorPower N n) ≅ (selfExtModel i).piece n := by
  haveI := Stacks.ClosedImmersion.preservesModuleSheafification_opensMap i.base
    i.isClosedEmbedding (toRingCat (Opens.grothendieckTopology Z) Z.sheaf)
  haveI := Stacks.ClosedImmersion.preservesModuleSheafification_opensMap i.base
    i.isClosedEmbedding (toRingCat (Opens.grothendieckTopology Z)
      ⟨Z.toRingedSpace.presheaf, Z.toRingedSpace.IsSheaf⟩)
  haveI : Presheaf.IsLocallySurjective
      (Opens.grothendieckTopology X.toRingedSpace.toPresheafedSpace) (comorphismRing i).hom :=
    isLocallySurjective_comorphismRing i
  let M : _root_.SheafOfModules.{u}
      ((sheafCompose (Opens.grothendieckTopology X) (forget₂ CommRingCat RingCat)).obj
        (pushforwardRing i)) :=
    (Stacks.SheafOfModules.PushforwardSheafification.sheafPushforwardFunctor.{u}
      (Opens.grothendieckTopology X) (Opens.map i.base)
      (toRingCat (Opens.grothendieckTopology Z) Z.sheaf)).obj N
  let e1' : (_root_.SheafOfModules.restrictScalars.{u} (comorphismRing i)).obj M ≅
      (_root_.SheafOfModules.restrictScalars.{u} (comorphismRing i)).obj
        ((selfExtPushforward i hr).piece 1) :=
    e1 ≪≫ (restrictScalars_descend_piece_iso (comorphismRing i) (selfExtModel i)
      (smul_selfExtModel_eq_zero' i hr) 1).symm
  let ι := ((Stacks.SheafOfModules.ChangeOfRings.fullyFaithfulOfIsLocallySurjective.{u}
    (comorphismRing i)).preimageIso e1').hom
  haveI (n : ℕ) : IsIso (Stacks.SheafOfModules.PushforwardSheafification.pushforwardSheafifyHom
      (Opens.grothendieckTopology X) (Opens.map i.base)
      (toRingCat (Opens.grothendieckTopology Z)
        ⟨Z.toRingedSpace.presheaf, Z.toRingedSpace.IsSheaf⟩) (PresheafOfModules.extPow n N.val)) :=
    SheafOfModules.PushforwardSheafification.isIso_pushforwardSheafifyHom_of_isClosedEmbedding
      i.base i.isClosedEmbedding ⟨Z.toRingedSpace.presheaf, Z.toRingedSpace.IsSheaf⟩ _
  exact (_root_.SheafOfModules.restrictScalars.{u} (comorphismRing i)).mapIso
      (_root_.SheafOfModules.ContinuousPushforward.exteriorPushforwardIso.{u}
        (Opens.grothendieckTopology X)
        (Opens.map i.base) N (Scheme.Modules.exteriorAlgebra N)
        (Scheme.Modules.exteriorGenerator N) (Scheme.Modules.isExteriorAlgebra_exteriorAlgebra N)
        (selfExtPushforward i hr) ι
        (isExteriorAlgebra_selfExtPushforward i hr ι) n) ≪≫
    restrictScalars_descend_piece_iso (comorphismRing i) (selfExtModel i)
      (smul_selfExtModel_eq_zero' i hr) n

end Exterior

