section Detection

variable {C : Type*} [Category C] [Abelian C] [HasDerivedCategory C]

/-- **A nonzero map into the lowest cohomology object lifts.** If `Z` is `≥ k` in the derived
category of an abelian category and `g : X ⟶ H^k(Z)` is nonzero, then some map
`X[-k] ⟶ Z` is nonzero: compose `g[-k]` with `H^k(Z)[-k] ≅ τ^{≥k} τ^{<k+1} Z = τ^{<k+1} Z ⟶ Z`,
which is an isomorphism on `H^k`. Valid for any choice of derived category. -/
theorem exists_hom_singleFunctor_ne_zero_of_isGE (Z : DerivedCategory C) (k : ℤ)
    (hZ : Z.IsGE k) {X : C} (g : X ⟶ (DerivedCategory.homologyFunctor C k).obj Z)
    (hg : g ≠ 0) : ∃ f : (DerivedCategory.singleFunctor C k).obj X ⟶ Z, f ≠ 0 := by
  let Y := (DerivedCategory.TStructure.t.truncLT (k + 1)).obj Z
  have hY : Y.IsGE k := by
    rw [DerivedCategory.isGE_iff]
    intro i hi
    have := DerivedCategory.isIso_homologyMap_truncLTι_app (k + 1) i (by omega) Z
    exact (DerivedCategory.isZero_of_isGE Z k i hi).of_iso
      (asIso ((DerivedCategory.homologyFunctor C i).map
        ((DerivedCategory.TStructure.t.truncLTι (k + 1)).app Z)))
  have : IsIso ((DerivedCategory.TStructure.t.truncGEπ k).app Y) := inferInstance
  let u : (DerivedCategory.singleFunctor C k).obj ((DerivedCategory.homologyFunctor C k).obj Z) ⟶
      Z :=
    (DerivedCategory.truncGELTIsoHomologyFunctorCompSingleFunctor k).inv.app Z ≫
      inv ((DerivedCategory.TStructure.t.truncGEπ k).app Y) ≫
        (DerivedCategory.TStructure.t.truncLTι (k + 1)).app Z
  have hu : IsIso ((DerivedCategory.homologyFunctor C k).map u) := by
    have := DerivedCategory.isIso_homologyMap_truncLTι_app (k + 1) k (by omega) Z
    simp only [u, Functor.map_comp]
    infer_instance
  refine ⟨(DerivedCategory.singleFunctor C k).map g ≫ u, fun hf => hg ?_⟩
  have h1 := congrArg (DerivedCategory.homologyFunctor C k).map hf
  rw [Functor.map_zero, Functor.map_comp] at h1
  have h2 : (DerivedCategory.homologyFunctor C k).map
      ((DerivedCategory.singleFunctor C k).map g) = 0 := by
    simpa using h1 =≫ inv ((DerivedCategory.homologyFunctor C k).map u)
  have h4 := (DerivedCategory.singleFunctorCompHomologyFunctorIso C k).hom.naturality g
  simp only [Functor.comp_map, Functor.id_map, h2, zero_comp] at h4
  exact zero_of_epi_comp _ h4.symm

end Detection

variable (R : Type u) [CommRing R] (n : ℕ)

open Stacks.AlgebraicGeometry.ExampleGenerator in
/-- A map out of `𝒪 ⊕ 𝒪(-1) ⊕ ⋯ ⊕ 𝒪(-n)` vanishes when it vanishes on each summand. -/
theorem twistSum_hom_ext {W : DerivedCategory (Mods R n)} (f : twistSum R n ⟶ W)
    (hf : ∀ b : Fin (n + 1),
      biproduct.ι (fun i : Fin (n + 1) => twist R n (-(i : ℤ))) b ≫ f = 0) : f = 0 :=
  biproduct.hom_ext' _ _ fun b => (hf b).trans (comp_zero).symm

open Stacks.AlgebraicGeometry.ExampleGenerator in
/-- A map `X ⟶ Z⟦i⟧` vanishes when its adjoint `X⟦-i⟧ ⟶ Z` does. -/
theorem eq_zero_of_shift_comp_eq_zero {X Z : DerivedCategory (Mods R n)} (i : ℤ)
    (g : X ⟶ (shiftFunctor _ i).obj Z)
    (h : (shiftFunctor _ (-i)).map g ≫ (shiftFunctorCompIsoId _ i (-i) (by omega)).hom.app Z = 0) :
    g = 0 := by
  have h3 := (shiftFunctor (DerivedCategory (Mods R n)) (-i)).map_zero X ((shiftFunctor _ i).obj Z)
  exact (shiftFunctor (DerivedCategory (Mods R n)) (-i)).map_injective
    ((zero_of_comp_mono _ h).trans h3.symm)

open Stacks.AlgebraicGeometry.ExampleGenerator in
/-- **Generation, at the `SheafOfModules` spelling.** If every map from a shift of one of the
twists `𝒪, …, 𝒪(-n)` to `Z` vanishes, so does every map from a shift of any `𝒪(-m)`, `m ≥ 0`:
those twists lie in `⟨E⟩` ([Stacks, Tag 0A9V], `twist_neg_mem_gen`) and [Stacks, Tag 09SK]
propagates the vanishing to `⟨E⟩`. -/
theorem hom_twist_neg_eq_zero_mods (Z : DerivedCategory (Mods R n))
    (h : ∀ (i : Fin (n + 1)) (j : ℤ) (φ : (twist R n (-(i : ℤ)))⟦j⟧ ⟶ Z), φ = 0)
    (m : ℕ) (j : ℤ) (φ : (twist R n (-(m : ℤ)))⟦j⟧ ⟶ Z) : φ = 0 := by
  have hE : ∀ (i : ℤ) (f : twistSum R n ⟶ (shiftFunctor _ i).obj Z), f = 0 := fun i f =>
    twistSum_hom_ext R n f fun b => eq_zero_of_shift_comp_eq_zero R n i _ (h b (-i) _)
  exact (Stacks.TriangulatedGenerators.hom_vanishing_iff_gen (twistSum R n) Z).1 hE _
    (Stacks.TriangulatedGenerators.shift_mem_gen_of_mem j (twist_neg_mem_gen R n m)) φ

/-- **Generation.** On `ℙⁿ_R`, if every map `𝒪(-i)[0]⟦j⟧ ⟶ Z` with `0 ≤ i ≤ n` vanishes, then
so does every map `𝒪(-m)[0]⟦j⟧ ⟶ Z` with `m ≥ 0`. -/
theorem hom_twist_neg_eq_zero (Z : DerivedCategory (P R n).Modules)
    (h : ∀ (i : Fin (n + 1)) (j : ℤ)
      (φ : ((DerivedCategory.singleFunctor (P R n).Modules 0).obj (O R n (-(i : ℤ))))⟦j⟧ ⟶ Z),
      φ = 0)
    (m : ℕ) (j : ℤ)
    (φ : ((DerivedCategory.singleFunctor (P R n).Modules 0).obj (O R n (-(m : ℤ))))⟦j⟧ ⟶ Z) :
    φ = 0 :=
  hom_twist_neg_eq_zero_mods R n Z h m j φ

section Nonvanishing

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

/-- **A nonzero quasi-coherent module on `ℙⁿ_R` receives a nonzero map from a negative twist.**
By the module form of [Stacks, Tag 0BQR] at the ample sheaf `𝒪(1)`, some `F ⊗ 𝒪(1)^{⊗ m}` has a
nonzero global section; `𝒪(1)^{⊗ m} ≅ 𝒪(m)`, a global section is a map `𝒪 ⟶ F ⊗ 𝒪(m)`, and
tensoring with `𝒪(-m)` (an equivalence) turns it into a nonzero map `𝒪(-m) ⟶ F`. -/
theorem exists_hom_twist_ne_zero (F : (P R n).Modules) [F.IsQuasicoherent] (hF : ¬ IsZero F) :
    ∃ (m : ℕ) (g : O R n (-(m : ℤ)) ⟶ F), g ≠ 0 := by
  obtain ⟨p, -, -, τ, -, -, -, -, hτ, -⟩ :=
    Stacks.AmpleNonvanishingChart.exists_twistedSection_restrict_eq_tensorSection (O R n 1)
      (Stacks.ProjectiveSpace.isAmple_twistingSheaf_one R n) F hF
  let e := Stacks.AmplePullbackPart1.tensorIsoTensorModules (P R n) F
      (Stacks.Ample.tensorPowModule (P R n) (O R n 1) (p : ℤ)) ≪≫
    Stacks.RelativeVeryAmple.tensorModulesMapIso (P R n) (Iso.refl F)
      (Stacks.AlgebraicGeometry.ProjTwistPowers.tensorPowModuleIsoTwistingSheaf (polyGrading R n)
        (MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top
          (Fin (n + 1)) R) (p : ℤ))
  let A : (P R n).Modules := (tensorRightModules (P R n) (O R n p)).obj F
  let τ' : A.val.obj (op ⊤) := (e.hom.val.app (op ⊤)).hom τ
  have hτ' : τ' ≠ 0 := by
    intro h0
    have h1 : (e.hom ≫ e.inv).val.app (op ⊤) = 𝟙 _ := by rw [e.hom_inv_id]; rfl
    have h2 := congrArg (fun f => f.hom τ) h1
    refine hτ (h2.symm.trans ?_)
    show (e.inv.val.app (op ⊤)).hom τ' = 0
    rw [h0, map_zero]
  let U : (P R n).Modules := SheafOfModules.unit (P R n).ringCatSheaf
  let h : U ⟶ A := Stacks.Cohomology.LeftDualPerfect.unitHomOfTop A τ'
  have hh : h ≠ 0 := by
    intro h0
    have h1 := Stacks.Cohomology.LeftDualPerfect.unitHomOfTop_app_top A τ'
    refine hτ' (h1.symm.trans ?_)
    show (h.val.app (op ⊤)).hom (1 : (P R n).ringCatSheaf.obj.obj (op ⊤)) = 0
    have h2 : h.val.app (op ⊤) = 0 := by rw [h0]; rfl
    rw [h2]; rfl
  let Tw := tensorRightModules (P R n) (O R n p)
  refine ⟨p, Tw.preimage ((twistInvTensorIso R n p).hom ≫ h), fun hg => hh ?_⟩
  have h1 := Tw.map_preimage ((twistInvTensorIso R n p).hom ≫ h)
  rw [hg, Functor.map_zero] at h1
  exact (Iso.cancel_iso_hom_left _ _ _).1 (h1.symm.trans comp_zero.symm)

end Nonvanishing

/-- **Zero objects of `D(𝒪_{ℙⁿ_R})` are detected by `𝒪, …, 𝒪(-n)`, on bounded below objects
with quasi-coherent cohomology.** If `Z` is bounded below, has quasi-coherent cohomology sheaves,
and every map `𝒪(-i)[0]⟦j⟧ ⟶ Z` with `0 ≤ i ≤ n`, `j ∈ ℤ` vanishes, then `Z ≅ 0`.

Proof: by `hom_twist_neg_eq_zero` all maps from shifts of every `𝒪(-m)`, `m ≥ 0`, vanish; by
induction from the lower bound, `Z` is `≥ k` for every `k`, since a nonzero `H^k(Z)` with `Z ≥ k`
would receive a nonzero map from some `𝒪(-m)` (`exists_hom_twist_ne_zero`), which lifts to a
nonzero map `𝒪(-m)[-k] ⟶ Z` (`exists_hom_singleFunctor_ne_zero_of_isGE`). -/
theorem isZero_of_hom_twist_eq_zero (Z : DerivedCategory (P R n).Modules)
    (hqc : ∀ k : ℤ, ((DerivedCategory.homologyFunctor (P R n).Modules k).obj Z).IsQuasicoherent)
    (hb : ∃ b : ℤ, Z.IsGE b)
    (h : ∀ (i : Fin (n + 1)) (j : ℤ)
      (φ : ((DerivedCategory.singleFunctor (P R n).Modules 0).obj (O R n (-(i : ℤ))))⟦j⟧ ⟶ Z),
      φ = 0) :
    IsZero Z := by
  obtain ⟨b, hb⟩ := hb
  have key : ∀ N : ℕ, Z.IsGE (b + N) := by
    intro N
    induction N with
    | zero => simpa using hb
    | succ N ih =>
      rw [DerivedCategory.isGE_iff]
      intro i hi
      rcases lt_or_eq_of_le (show i ≤ b + N by push_cast at hi; omega) with hlt | rfl
      · exact DerivedCategory.isZero_of_isGE Z (b + N) i hlt
      · by_contra hne
        have := hqc (b + N)
        obtain ⟨m, g, hg⟩ := exists_hom_twist_ne_zero R n _ hne
        obtain ⟨f, hf⟩ := exists_hom_singleFunctor_ne_zero_of_isGE Z (b + N) ih g hg
        let e := ((DerivedCategory.singleFunctors (P R n).Modules).shiftIso (-(b + N : ℤ))
          (b + N) 0 (by omega)).app (O R n (-(m : ℤ)))
        have h0 := hom_twist_neg_eq_zero R n Z h m (-(b + N : ℤ)) (e.hom ≫ f)
        exact hf (zero_of_epi_comp e.hom h0)
  refine Stacks.Duality.isZero_of_forall_isZero_homology Z fun q => ?_
  rcases lt_or_ge q b with hq | hq
  · exact DerivedCategory.isZero_of_isGE Z b q hq
  · obtain ⟨N, hN⟩ := Int.eq_ofNat_of_zero_le (sub_nonneg.2 hq)
    have := key (N + 1)
    exact DerivedCategory.isZero_of_isGE Z (b + (N + 1 : ℕ)) q (by push_cast; omega)

end Stacks.Duality.ProjCoeff
