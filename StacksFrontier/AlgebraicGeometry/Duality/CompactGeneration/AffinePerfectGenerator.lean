/-!
# A perfect generator for `D_{QCoh,T}(𝒪_X)` on an affine scheme

[Stacks, Tag 0A9A] reads, for `X` a quasi-compact and quasi-separated scheme and `T ⊆ X` a closed
subset whose complement is quasi-compact:

> the category `D_{QCoh,T}(𝒪_X)` is generated by a single perfect object.

This file proves the case `X = Spec A`. There a closed subset `T` with quasi-compact complement
is the common zero locus `V(f₁, …, f_r)` of a finite sequence, and the generator is the sheafified
Koszul complex `Stacks.Koszul.Truncation.koszulObject` of that sequence: it is perfect in the sense
of [Stacks, Tag 08CM], it lies in `D_{QCoh,T}(𝒪_X)`, and every object `E` of `D_{QCoh,T}(𝒪_X)`
with `Hom_{D(𝒪_X)}(K[n], E) = 0` for all integers `n` is zero ([Stacks, Tag 09SJ](3)).

The derived category of `𝒪_X`-modules is the locally small model
`AlgebraicGeometry.Scheme.Modules.hasDerivedCategory`.

## Main results

* `Stacks.Duality.Supported.isZero_derivedRestrict_of_derivedSupported` and
  `Stacks.Duality.Supported.derivedSupported_of_isZero_derivedRestrict` — the two directions of
  the comparison between "every cohomology sheaf has vanishing stalks off `T`" and "the complex
  restricts to zero on an open contained in the complement of `T`".
* `Stacks.Duality.Supported.exists_coe_openComplement_eq_compl` — a closed subset of `Spec A`
  with quasi-compact complement is the common zero locus of a finite sequence in `A`, in the
  shape `Stacks.Koszul.Truncation.openComplement` takes.
* `Stacks.Duality.Supported.isPerfect_koszulObject`,
  `Stacks.Duality.Supported.derivedQuasiCoherent_koszulObject` and
  `Stacks.Duality.Supported.derivedSupported_koszulObject` — the sheafified Koszul object is
  perfect and lies in `D_{QCoh,T}(𝒪_{Spec A})` for `T` the common zero locus of the sequence.
* `Stacks.Duality.Supported.isZero_of_quasiCoherentSupported_of_forall_hom_koszulObject_eq_zero` —
  it generates.
* `Stacks.Duality.Supported.exists_isPerfect_quasiCoherentSupported_isWeakGenerator` —
  [Stacks, Tag 0A9A] for an affine scheme.

## References

* [Stacks Project, Tag 0A9A](https://stacks.math.columbia.edu/tag/0A9A)
* [Stacks Project, Tag 09IR](https://stacks.math.columbia.edu/tag/09IR)
* [Stacks Project, Tag 09IS](https://stacks.math.columbia.edu/tag/09IS)
* [Stacks Project, Tag 08CM](https://stacks.math.columbia.edu/tag/08CM)
* [Stacks Project, Tag 08DR](https://stacks.math.columbia.edu/tag/08DR)
* [Stacks Project, Tag 09SJ](https://stacks.math.columbia.edu/tag/09SJ)
-/

-- This file uses the locally small derived-category models below, which are not
-- global instances (see `StacksFrontier.Homology.DerivedCategory.LocallySmall`):
-- `D(R)` for sheaves of modules on a small site.
-- `D(𝒪_X)` for a scheme.
attribute [local instance] SheafOfModules.hasDerivedCategory
attribute [local instance] AlgebraicGeometry.Scheme.Modules.hasDerivedCategory

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.ObjectProperty
open CategoryTheory.Pretriangulated TopologicalSpace
open Stacks.Duality.OpenImmersion

universe u

namespace Stacks.Duality.Supported

/-! ### Support and vanishing on an open contained in the complement -/

section Bridge

variable {Z : Scheme.{u}} (U : Z.Opens) (T : Set Z)

/-- A sheaf of modules whose stalks vanish on an open `U` restricts to zero on `U`. -/
theorem isZero_restrictFunctor_obj_of_forall_isZero_stalk (M : Z.Modules)
    (hM : ∀ y : U.toScheme, IsZero ((SheafOfModules.stalkAddCommGroupFunctor Z.ringCatSheaf
      (U.ι y)).obj M)) :
    IsZero ((Scheme.Modules.restrictFunctor U.ι).obj M) :=
  Stacks.Cohomology.PushforwardRestriction.isZero_sheafOfModules_of_stalk_isZero
    U.toScheme.ringCatSheaf _
    fun y => IsZero.of_iso (hM y) ((Scheme.Modules.restrictStalkNatIso U.ι y).app M)

/-- An object of `D(𝒪_Z)` restricts to zero on `U` iff all its cohomology sheaves do. -/
private theorem isZero_derivedRestrict_iff (E : DerivedCategory Z.Modules) :
    IsZero ((derivedRestrict U.ι).obj E) ↔ ∀ n, IsZero ((Scheme.Modules.restrictFunctor U.ι).obj
      ((DerivedCategory.homologyFunctor Z.Modules n).obj E)) :=
  (DerivedCategory.isZero_iff_forall_isZero_homology _).trans <| forall_congr' fun n =>
    ((StacksDraft.DerivedCategoryHomology.mapDerivedCategoryHomologyIso
      (Scheme.Modules.restrictFunctor U.ι) n).app E).isZero_iff

/-- An object of `D_T(𝒪_Z)` restricts to zero on an open contained in the complement of `T`. -/
theorem isZero_derivedRestrict_of_derivedSupported (hUT : (U : Set Z) ⊆ Tᶜ)
    (E : DerivedCategory Z.Modules) (hE : derivedSupported Z.ringCatSheaf T E) :
    IsZero ((derivedRestrict U.ι).obj E) :=
  (isZero_derivedRestrict_iff U E).2 fun n =>
    isZero_restrictFunctor_obj_of_forall_isZero_stalk U _ fun y => hE n (U.ι y) (hUT y.2)

/-- An object restricting to zero on an open containing the complement of `T` lies in
`D_T(𝒪_Z)`. -/
theorem derivedSupported_of_isZero_derivedRestrict (hTU : Tᶜ ⊆ (U : Set Z))
    (E : DerivedCategory Z.Modules) (h : IsZero ((derivedRestrict U.ι).obj E)) :
    derivedSupported Z.ringCatSheaf T E := fun n x hx =>
  have h₁ := (isZero_derivedRestrict_iff U E).1 h n
  have _hpz := AlgebraicGeometry.SheafOfModules.stalkAddCommGroupFunctor_preservesZeroMorphisms
    U.toScheme.ringCatSheaf (⟨x, hTU hx⟩ : U.toScheme)
  IsZero.of_iso
    (Functor.map_isZero (SheafOfModules.stalkAddCommGroupFunctor U.toScheme.ringCatSheaf
      (⟨x, hTU hx⟩ : U.toScheme)) h₁)
    ((Scheme.Modules.restrictStalkNatIso U.ι (⟨x, hTU hx⟩ : U.toScheme)).app
      ((DerivedCategory.homologyFunctor Z.Modules n).obj E)).symm

end Bridge

/-! ### The cohomology sheaves of a sheafified complex -/

/-- The cohomology sheaves of the complex of `𝒪_{Spec R}`-modules associated to a complex of
`R`-modules `M` are the sheaves associated to the cohomology modules of `M`, for any model of the
derived category. -/
theorem nonempty_homology_Q_obj_tildeComplex_iso {R : CommRingCat.{u}}
    [HasDerivedCategory.{u} (Spec R).Modules]
    (M : CochainComplex (ModuleCat.{u} R) ℤ) (n : ℤ) :
    Nonempty ((DerivedCategory.homologyFunctor (Spec R).Modules n).obj
        (DerivedCategory.Q.obj (Stacks.AffineTilde.tildeComplex M)) ≅
      (tilde.functor R).obj (M.homology n)) :=
  have : PreservesFiniteLimits (tilde.functor R) := AlgebraicGeometry.tilde.preservesFiniteLimits R
  have : PreservesFiniteColimits (tilde.functor R) :=
    Stacks.AffineTilde.preservesFiniteColimits_tildeFunctor R
  ⟨(DerivedCategory.homologyFunctorFactors.{u} (Spec R).Modules n).app
      (Stacks.AffineTilde.tildeComplex M) ≪≫
    (M.sc n).mapHomologyIso (tilde.functor R)⟩

/-! ### The affine case of [Stacks, Tag 0A9A] -/

section Affine

open Stacks.Koszul.Truncation

variable {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)

/-- A point of `Spec A` lies in the open subscheme `⋃ᵢ D(f_i)` exactly when one of the `f_i` is
outside its prime ideal. -/
theorem mem_openComplement_iff (x : Spec (CommRingCat.of A)) :
    x ∈ (openComplement f : (Spec (CommRingCat.of A)).Opens) ↔ ∃ i, f i ∉ x.asIdeal := by
  refine TopologicalSpace.Opens.mem_iSup.trans (exists_congr fun i => ?_)
  refine Iff.trans (iff_of_eq (congrArg
    (fun U : (Spec (CommRingCat.of A)).Opens => x ∈ U)
    (AlgebraicGeometry.basicOpen_eq_of_affine (R := CommRingCat.of A) (f i)))) ?_
  exact PrimeSpectrum.mem_basicOpen (f i) x

/-- A closed subset of `Spec A` with quasi-compact complement is the common zero locus of a
finite sequence `f₁, …, f_r`: its complement is `⋃ᵢ D(f_i)`. -/
theorem exists_coe_openComplement_eq_compl (T : Set (Spec (CommRingCat.of A)))
    (hT : IsClosed T) (hTc : IsCompact Tᶜ) :
    ∃ (r : ℕ) (f : Fin r → A),
      ((openComplement f : (Spec (CommRingCat.of A)).Opens) :
        Set (Spec (CommRingCat.of A))) = Tᶜ := by
  classical
  obtain ⟨t, ht⟩ := PrimeSpectrum.isCompact_isOpen_iff.1 ⟨hTc, hT.isOpen_compl⟩
  refine ⟨t.card, fun i => ((t.equivFin.symm i : {x // x ∈ t}) : A), ?_⟩
  have hr : Set.range (fun i => ((t.equivFin.symm i : {x // x ∈ t}) : A)) = (t : Set A) := by
    rw [show (fun i => ((t.equivFin.symm i : {x // x ∈ t}) : A)) =
        (Subtype.val ∘ t.equivFin.symm) from rfl, Set.range_comp, Equiv.range_eq_univ,
      Set.image_univ, Subtype.range_coe]
  have ht' : ∀ y : Spec (CommRingCat.of A),
      y ∉ PrimeSpectrum.zeroLocus (t : Set A) ↔ y ∉ T := fun y => Set.ext_iff.1 ht y
  refine Set.ext fun x => ?_
  refine (mem_openComplement_iff _ x).trans (Iff.trans ?_ (ht' x))
  constructor
  · rintro ⟨i, hi⟩ hc
    exact hi ((PrimeSpectrum.mem_zeroLocus x (t : Set A)).1 hc
      ((Set.ext_iff.1 hr _).1 (Set.mem_range_self i)))
  · intro hns
    by_contra hcon
    refine hns ((PrimeSpectrum.mem_zeroLocus x (t : Set A)).2 fun a ha => ?_)
    obtain ⟨i, rfl⟩ := (Set.ext_iff.1 hr a).2 ha
    exact not_not.1 fun hni => hcon ⟨i, hni⟩

/-- The sheafified Koszul object is perfect ([Stacks, Tag 08CM]). -/
theorem isPerfect_koszulObject :
    AlgebraicGeometry.RingedSpace.IsPerfect (X := (Spec (CommRingCat.of A)).toRingedSpace)
      (koszulObject f) :=
  AlgebraicGeometry.RingedSpace.isPerfect_Q_obj_of_isStrictlyPerfect
    (X := (Spec (CommRingCat.of A)).toRingedSpace)
    (Stacks.AffineTilde.isStrictlyPerfect_tildeComplex_extend_seqComplex
      (R := CommRingCat.of A) f)

/-- The cohomology sheaves of the sheafified Koszul object are quasi-coherent. -/
theorem derivedQuasiCoherent_koszulObject :
    derivedQuasiCoherent (Spec (CommRingCat.of A)) (koszulObject f) := fun n => by
  obtain ⟨e⟩ := nonempty_homology_Q_obj_tildeComplex_iso (R := CommRingCat.of A)
    ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat) n
  exact (SheafOfModules.isQuasicoherent (Spec (CommRingCat.of A)).ringCatSheaf).prop_of_iso
    e.symm inferInstance

/-- The cohomology of the sheafified Koszul object is supported on the common zero locus of the
sequence. -/
theorem derivedSupported_koszulObject :
    derivedSupported (Spec (CommRingCat.of A)).ringCatSheaf
      (((openComplement f : (Spec (CommRingCat.of A)).Opens) :
        Set (Spec (CommRingCat.of A)))ᶜ) (koszulObject f) :=
  derivedSupported_of_isZero_derivedRestrict (openComplement f) _ (compl_compl _).subset _
    (Stacks.Koszul.OpenComplement.isZero_derivedRestrict_koszulObject f)

/-- The sheafified Koszul object generates `D_{QCoh,T}(𝒪_{Spec A})` for `T` the common zero
locus of the sequence: an object of that category receiving only zero maps from the integer shifts
of the Koszul object is zero. -/
theorem isZero_of_quasiCoherentSupported_of_forall_hom_koszulObject_eq_zero
    (E : DerivedCategory (Spec (CommRingCat.of A)).Modules)
    (hE : quasiCoherentSupported (Spec (CommRingCat.of A))
      (((openComplement f : (Spec (CommRingCat.of A)).Opens) :
        Set (Spec (CommRingCat.of A)))ᶜ) E)
    (h : ∀ (n : ℤ) (g : (koszulObject f)⟦n⟧ ⟶ E), g = 0) :
    IsZero E :=
  have _hiso := isIso_unit_of_hom_koszulObject_eq_zero f E hE.1 h
  have hres : IsZero ((derivedRestrict (openComplement f).ι).obj E) :=
    isZero_derivedRestrict_of_derivedSupported (openComplement f) _
      (compl_compl _).symm.subset E hE.2
  have := Functor.preservesZeroMorphisms_of_isRightAdjoint
    (Stacks.Duality.derivedPushforward (openComplement f).ι)
  IsZero.of_iso (Functor.map_isZero _ hres)
    (asIso ((derivedRestrictPushforwardAdjunction (openComplement f).ι).unit.app E))

/-- Let `A` be a commutative ring and let `T ⊆ Spec A` be a closed subset whose complement is
quasi-compact. Then there is a perfect object `P` of `D(𝒪_{Spec A})` lying in
`D_{QCoh,T}(𝒪_{Spec A})` which generates that category: an object of `D_{QCoh,T}(𝒪_{Spec A})`
receiving only zero morphisms from the integer shifts of `P` is zero. -/
theorem exists_isPerfect_quasiCoherentSupported_isWeakGenerator
    (T : Set (Spec (CommRingCat.of A))) (hT : IsClosed T) (hTc : IsCompact Tᶜ) :
    ∃ P : DerivedCategory (Spec (CommRingCat.of A)).Modules,
      AlgebraicGeometry.RingedSpace.IsPerfect
          (X := (Spec (CommRingCat.of A)).toRingedSpace) P ∧
        quasiCoherentSupported (Spec (CommRingCat.of A)) T P ∧
        ∀ E : DerivedCategory (Spec (CommRingCat.of A)).Modules,
          quasiCoherentSupported (Spec (CommRingCat.of A)) T E →
            (∀ (n : ℤ) (g : P⟦n⟧ ⟶ E), g = 0) → IsZero E := by
  obtain ⟨s, g, hg⟩ := exists_coe_openComplement_eq_compl T hT hTc
  have hT' : T = ((openComplement g : (Spec (CommRingCat.of A)).Opens) :
      Set (Spec (CommRingCat.of A)))ᶜ := by rw [hg, compl_compl]
  subst hT'
  exact ⟨koszulObject g, isPerfect_koszulObject g,
    ⟨derivedQuasiCoherent_koszulObject g, derivedSupported_koszulObject g⟩,
    isZero_of_quasiCoherentSupported_of_forall_hom_koszulObject_eq_zero g⟩

end Affine

end Stacks.Duality.Supported

end
