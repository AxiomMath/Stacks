module

public import StacksFrontier.AlgebraicGeometry.Duality.CompactGeneration.SupportedCompactGeneration
public import StacksFrontier.AlgebraicGeometry.Perfect.QcqsPerfectGenerator
public import StacksFrontier.AlgebraicGeometry.Duality.CompactGeneration.SupportedDirectSums
public import StacksFrontier.AlgebraicGeometry.Duality.DerivedPushforward.DirectSums

/-!
# A single compact generator for the kernel of restriction to a quasi-compact open

Let `X` be a quasi-compact quasi-separated scheme and `j : U ⟶ X` a quasi-compact open immersion.
Finitely many compact objects of `D_QCoh(𝒪_X)` killed by `j^*` detect the kernel of `j^*`, and so
does their direct sum, a single compact object. With the perfectness of compact objects this gives
the perfect generator of `D_{QCoh,T}(𝒪_X)` of [Stacks, Tag 0A9A].

## Main definitions

* `Stacks.Duality.SupportedGeneration.FiniteKernelDetected`: the kernel of `j^*` is detected by
  finitely many compact objects killed by `j^*`.

## Main results

* `Stacks.Duality.SupportedGeneration.finiteKernelDetected`: every quasi-compact open immersion
  into a quasi-compact quasi-separated scheme has this property.
* `Stacks.Duality.SupportedGeneration.exists_isCompactObject_generator_kernel`: there is a single
  compact object of `D_QCoh(𝒪_X)`, killed by `j^*`, which detects the kernel of `j^*`.
* `Stacks.Duality.SupportedGeneration.exists_isPerfect_generator_quasiCoherentSupported`: for a
  closed `T ⊆ X` with quasi-compact complement, `D_{QCoh,T}(𝒪_X)` is generated by a single perfect
  object, which is compact in `D_{QCoh,T}(𝒪_X)`.

## References

* [Stacks Project, Tag 0A9A](https://stacks.math.columbia.edu/tag/0A9A)
* [Stacks Project, Tag 08EK](https://stacks.math.columbia.edu/tag/08EK)
* [Stacks Project, Tag 09IR](https://stacks.math.columbia.edu/tag/09IR)
-/

-- This file uses the locally small derived-category models below, which are not
-- global instances (see `StacksFrontier.Homology.DerivedCategory.LocallySmall`):
-- `D(R)` for sheaves of modules on a small site.
-- `D(𝒪_X)` for a scheme.
attribute [local instance] SheafOfModules.hasDerivedCategory
attribute [local instance] AlgebraicGeometry.Scheme.Modules.hasDerivedCategory

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.ObjectProperty
open CategoryTheory.Pretriangulated ZeroObject

universe u

namespace Stacks.Duality.SupportedGeneration

open Stacks.Duality.OpenImmersion Stacks.Duality.QcqsGeneration

/-- **Finitely many compact objects killed by `j^*` detect the kernel of `j^*`.** There is a
finite family of compact objects of `D_QCoh(𝒪_X)`, each restricting to zero on `U`, such that an
object receiving no nonzero morphism from any shift of any of them has invertible unit
`E ⟶ Rj_*(E|_U)`. This is `Stacks.Duality.SupportedGeneration.KernelDetected` with a finite
index type. -/
def FiniteKernelDetected {X U : Scheme.{u}} (j : U ⟶ X) [IsOpenImmersion j]
    [AlgebraicGeometry.QuasiCompact j] [CompactSpace X] : Prop :=
  ∃ (ι : Type u) (_ : Finite ι) (K : ι → Stacks.Duality.quasiCoherentDerivedCategory X),
    (∀ i, IsCompactObject.{u} (K i)) ∧ (∀ i, IsZero ((restrictedDerivedRestrict j).obj (K i))) ∧
    ∀ E : Stacks.Duality.quasiCoherentDerivedCategory X,
      (∀ (i : ι) (n : ℤ) (g : (K i)⟦n⟧ ⟶ E), g = 0) →
        IsIso ((restrictedDerivedRestrictAdjunction j).unit.app E)

/-- An object whose unit is invertible and whose image under the left adjoint is zero is zero. -/
private theorem isZero_of_isIso_unit_of_isZero_obj {C D : Type*} [Category C] [Category D]
    [HasZeroMorphisms C] [HasZeroMorphisms D] {L : C ⥤ D} {R : D ⥤ C} (adj : L ⊣ R)
    [R.PreservesZeroMorphisms] {X : C} (hX : IsIso (adj.unit.app X)) (h : IsZero (L.obj X)) :
    IsZero X :=
  (R.map_isZero h).of_iso (asIso (adj.unit.app X))

/-- If `P` is a retract of `F Q`, a morphism out of a shift of `P` vanishes as soon as all
morphisms out of `F (Q⟦n⟧)` to the same target do. -/
private theorem eq_zero_of_retract_of_forall_eq_zero {C D : Type*} [Category C] [Category D]
    [HasZeroMorphisms D] [HasShift C ℤ] [HasShift D ℤ] (F : C ⥤ D) [F.CommShift ℤ] {Q : C}
    {P N : D} (s : P ⟶ F.obj Q) (r : F.obj Q ⟶ P) (hsr : s ≫ r = 𝟙 P) (n : ℤ) (g : P⟦n⟧ ⟶ N)
    (h : ∀ k : F.obj (Q⟦n⟧) ⟶ N, k = 0) : g = 0 := by
  have : g = (shiftFunctor D n).map s ≫ (F.commShiftIso n).inv.app Q ≫
      ((F.commShiftIso n).hom.app Q ≫ (shiftFunctor D n).map r ≫ g) := by
    simp [← Functor.map_comp_assoc, hsr]
  rw [this, h ((F.commShiftIso n).hom.app Q ≫ (shiftFunctor D n).map r ≫ g), comp_zero,
    comp_zero]

/-- **The cone of the unit `E ⟶ Rj_*(E|_U)` is orthogonal to a family killed by `j^*`.** If `E`
is right orthogonal to all shifts of a family `R` killed by `j^*`, the cone of the unit at `E`
is killed by `j^*` and right orthogonal to all shifts of `R`. -/
private theorem exists_cone_unit_isZero_restrict_rightOrthogonal {Y B : Scheme.{u}} (jB : B ⟶ Y)
    [IsOpenImmersion jB] [AlgebraicGeometry.QuasiCompact jB] [CompactSpace Y] {ι : Type u}
    (R : ι → Stacks.Duality.quasiCoherentDerivedCategory Y)
    (hR0 : ∀ i, IsZero ((restrictedDerivedRestrict jB).obj (R i)))
    (E : Stacks.Duality.quasiCoherentDerivedCategory Y)
    (hE : ∀ (i : ι) (n : ℤ) (g : (R i)⟦n⟧ ⟶ E), g = 0) :
    ∃ (Cn : Stacks.Duality.quasiCoherentDerivedCategory Y) (π : _ ⟶ Cn) (δ : Cn ⟶ E⟦(1 : ℤ)⟧),
      Triangle.mk ((restrictedDerivedRestrictAdjunction jB).unit.app E) π δ ∈ distTriang _ ∧
      IsZero ((restrictedDerivedRestrict jB).obj Cn) ∧ ∀ (i : ι) (n : ℤ) (g : (R i)⟦n⟧ ⟶ Cn),
        g = 0 := by
  let adjB := restrictedDerivedRestrictAdjunction jB
  obtain ⟨Cn, π, δ, hT⟩ := distinguished_cocone_triangle (adjB.unit.app E)
  refine ⟨Cn, π, δ, hT, Triangle.isZero₃_of_isIso₁ _
    ((restrictedDerivedRestrict jB).map_distinguished _ hT)
    (isIso_map_unit_of_isIso_counit adjB E inferInstance), ?_⟩
  have hEo : ((ofObj R).shiftClosure ℤ).rightOrthogonal E := by
    rwa [rightOrthogonal_shiftClosure_ofObj_iff]
  have hMo : ((ofObj R).shiftClosure ℤ).rightOrthogonal
      ((Stacks.Duality.quasiCoherentDerivedPushforward jB
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jB)).obj
          ((restrictedDerivedRestrict jB).obj E)) := by
    rw [rightOrthogonal_shiftClosure_ofObj_iff]
    exact fun i n g => eq_zero_of_isZero_restrict jB (hR0 i) n _ g
  rw [← rightOrthogonal_shiftClosure_ofObj_iff]
  exact ObjectProperty.ext_of_isTriangulatedClosed₃ _ _ hT hEo hMo

section Excision

variable {Y A B C : Scheme.{u}} (jA : A ⟶ Y) (jB : B ⟶ Y) (iA : C ⟶ A) (iB : C ⟶ B)
  [IsOpenImmersion jA] [IsOpenImmersion jB] [IsOpenImmersion iA] [IsOpenImmersion iB]
  [CompactSpace Y] [CompactSpace A] [CompactSpace B]
  [AlgebraicGeometry.QuasiCompact jA] [AlgebraicGeometry.QuasiCompact jB]
  [AlgebraicGeometry.QuasiCompact iA] [AlgebraicGeometry.QuasiCompact iB]
  (hsq : IsPullback iA iB jA jB) (hcov : ∀ y : Y, (∃ x, jA x = y) ∨ (∃ x, jB x = y))

include hsq hcov in
/-- **Excision.** Let `Y = A ∪ B` be a cover by two quasi-compact opens with overlap `C`. If the
kernel of restriction from `A` to `C` is detected by finitely many compact objects, so is the
kernel of restriction from `Y` to `B`. -/
theorem finiteKernelDetected_of_excision (h : FiniteKernelDetected iA) :
    FiniteKernelDetected jB := by
  obtain ⟨ι, hι, P, hPc, hP0, hPdet⟩ := h
  let adjA := restrictedDerivedRestrictAdjunction jA
  let adjB := restrictedDerivedRestrictAdjunction jB
  let adjA' := restrictedDerivedRestrictAdjunction iA
  let adjB' := restrictedDerivedRestrictAdjunction iB
  let : (Stacks.Duality.quasiCoherentDerivedPushforward jA
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jA)).CommShift ℤ :=
    adjA.rightAdjointCommShift ℤ
  let : adjA.CommShift ℤ := adjA.commShift_of_leftAdjoint ℤ
  let : (Stacks.Duality.quasiCoherentDerivedPushforward jB
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jB)).CommShift ℤ :=
    adjB.rightAdjointCommShift ℤ
  let : adjB.CommShift ℤ := adjB.commShift_of_leftAdjoint ℤ
  let : adjB.IsTriangulated := Adjunction.IsTriangulated.mk' adjB
  have := adjB.isTriangulated_rightAdjoint
  have : (Stacks.Duality.quasiCoherentDerivedPushforward jA
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jA)).Additive :=
    adjA.right_adjoint_additive
  have : (Stacks.Duality.quasiCoherentDerivedPushforward jB
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jB)).Additive :=
    adjB.right_adjoint_additive
  have : (Stacks.Duality.quasiCoherentDerivedPushforward iA
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs iA)).Additive :=
    adjA'.right_adjoint_additive
  have : ∀ α : Type u, PreservesColimitsOfShape (Discrete α)
      (Stacks.Duality.quasiCoherentDerivedPushforward jA
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jA)) :=
    preservesColimitsOfShape_discrete_restrictedDerivedPushforward jA
  have : ∀ α : Type u, PreservesColimitsOfShape (Discrete α)
      (Stacks.Duality.quasiCoherentDerivedPushforward jB
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jB)) :=
    preservesColimitsOfShape_discrete_restrictedDerivedPushforward jB
  let βBA : ∀ A' : Stacks.Duality.quasiCoherentDerivedCategory A,
      (restrictedDerivedRestrict jB).obj ((Stacks.Duality.quasiCoherentDerivedPushforward jA
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jA)).obj A') ≅
      (Stacks.Duality.quasiCoherentDerivedPushforward iB
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs iB)).obj
          ((restrictedDerivedRestrict iA).obj A') := fun A' =>
    (DerivedCategoryB.derivedCategoryB (A := B.Modules)
      (SheafOfModules.isQuasicoherent B.ringCatSheaf)).fullyFaithfulι.preimageIso
      (baseChangeIso jA iA jB iB hsq A'.obj)
  let βAB : ∀ B' : Stacks.Duality.quasiCoherentDerivedCategory B,
      (restrictedDerivedRestrict jA).obj ((Stacks.Duality.quasiCoherentDerivedPushforward jB
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jB)).obj B') ≅
      (Stacks.Duality.quasiCoherentDerivedPushforward iA
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs iA)).obj
          ((restrictedDerivedRestrict iB).obj B') := fun B' =>
    (DerivedCategoryB.derivedCategoryB (A := A.Modules)
      (SheafOfModules.isQuasicoherent A.ringCatSheaf)).fullyFaithfulι.preimageIso
      (baseChangeIso jB iB jA iA hsq.flip B'.obj)
  have hker : ∀ N : Stacks.Duality.quasiCoherentDerivedCategory Y,
      IsZero ((restrictedDerivedRestrict jB).obj N) → IsIso (adjA.unit.app N) :=
    fun N hN => isIso_unit_of_isZero_restrict_two jA jB iA iB hsq hcov N hN
  choose R hRA hRB using fun i => exists_glue adjA adjB adjB' βBA βAB (P i) 0
    ((hP0 i).iso ((restrictedDerivedRestrict iB).map_isZero (isZero_zero _)))
  have hR0 : ∀ i, IsZero ((restrictedDerivedRestrict jB).obj (R i)) := fun i =>
    (isZero_zero _).of_iso (hRB i).some
  refine ⟨ι, hι, R, fun i => ?_, hR0, fun E hE => ?_⟩
  · exact isCompactObject_of_isCompactObject_restrict adjA adjB hker (R i)
      (isCompactObject_of_iso (hRA i).some (hPc i))
      (isCompactObject_of_iso (hRB i).some
        (isCompactObject_zero' (T := Stacks.Duality.quasiCoherentDerivedCategory B)))
  · obtain ⟨Cn, π, δ, hT, hCB, hCo⟩ := exists_cone_unit_isZero_restrict_rightOrthogonal jB R
      (fun i => hR0 i) E hE
    have hCA : IsIso (adjA.unit.app Cn) := hker Cn hCB
    have hCAo : ∀ (i : ι) (n : ℤ) (g : (P i)⟦n⟧ ⟶ (restrictedDerivedRestrict jA).obj Cn),
        g = 0 := fun i n g => by
      obtain ⟨e⟩ := hRA i
      exact eq_zero_of_retract_of_forall_eq_zero (restrictedDerivedRestrict jA) e.inv e.hom
        e.inv_hom_id n g (eq_zero_of_isIso_unit adjA hCA (hCo i n))
    have hCA' : IsIso (adjA'.unit.app ((restrictedDerivedRestrict jA).obj Cn)) := hPdet _ hCAo
    have hCC : IsZero
        ((restrictedDerivedRestrict iA).obj ((restrictedDerivedRestrict jA).obj Cn)) :=
      isZero_fullSubcategory_of_isZero_obj
        (isZero_derivedRestrict_comp_of_isZero iA iB jA jB hsq.w
          ((DerivedCategoryB.derivedCategoryB (A := B.Modules)
            (SheafOfModules.isQuasicoherent B.ringCatSheaf)).ι.map_isZero hCB))
    exact (Triangle.isZero₃_iff_isIso₁ _ hT).1 (isZero_of_isIso_unit_of_isZero_obj adjA hCA
      (isZero_of_isIso_unit_of_isZero_obj adjA' hCA' hCC))

end Excision

/-! ### Transitivity -/

section Transitivity

variable {Y W U : Scheme.{u}} (j : W ⟶ Y) (i : U ⟶ W) [IsOpenImmersion j] [IsOpenImmersion i]
  [CompactSpace Y] [QuasiSeparatedSpace Y] [CompactSpace W]
  [AlgebraicGeometry.QuasiCompact j] [AlgebraicGeometry.QuasiCompact i]

/-- **Transitivity.** For quasi-compact open immersions `U ⟶ W ⟶ Y` into a quasi-compact
quasi-separated scheme, if the kernels of restriction from `Y` to `W` and from `W` to `U` are
detected by finitely many compact objects, so is the kernel of restriction from `Y` to `U`. -/
theorem finiteKernelDetected_comp (hj : FiniteKernelDetected j) (hi : FiniteKernelDetected i) :
    FiniteKernelDetected (i ≫ j) := by
  obtain ⟨ι₁, hι₁, K, hKc, hK0, hKdet⟩ := hj
  obtain ⟨ι₂, hι₂, P, hPc, hP0, hPdet⟩ := hi
  let adjj := restrictedDerivedRestrictAdjunction j
  let adji := restrictedDerivedRestrictAdjunction i
  let adjc := restrictedDerivedRestrictAdjunction (i ≫ j)
  have : (Stacks.Duality.quasiCoherentDerivedPushforward j
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs j)).Additive :=
    adjj.right_adjoint_additive
  have : (Stacks.Duality.quasiCoherentDerivedPushforward i
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs i)).Additive :=
    adji.right_adjoint_additive
  have : ∀ α : Type u, PreservesColimitsOfShape (Discrete α)
      (Stacks.Duality.quasiCoherentDerivedPushforward j
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs j)) :=
    preservesColimitsOfShape_discrete_restrictedDerivedPushforward j
  obtain ⟨ι₀, G, hGc, hGgen⟩ :=
    Stacks.Duality.QcqsGeneration.isCompactlyGenerated_quasiCoherentDerivedCategory Y
  let G' : Option ι₀ → Stacks.Duality.quasiCoherentDerivedCategory Y := fun o => o.elim 0 G
  have hG'c : ∀ o, IsCompactObject.{u} (G' o) := fun o => by
    cases o with
    | none => exact isCompactObject_zero' (T := Stacks.Duality.quasiCoherentDerivedCategory Y)
    | some k => exact hGc k
  have hG'gen : (ofObj G').IsWeakTriangulatedGenerator := by
    intro E hE
    refine hGgen E ?_
    rw [rightOrthogonal_shiftClosure_ofObj_iff] at hE ⊢
    exact fun k n g => hE (some k) n g
  choose c hcc hcP using fun k => exists_isCompactObject_iso_biprod_shift adjj K hKc hK0
    hKdet G' hG'c hG'gen (P k) (hPc k)
  have hc0 : ∀ k, IsZero ((restrictedDerivedRestrict (i ≫ j)).obj (c k)) := fun k => by
    rw [isZero_restrictedDerivedRestrict_comp_iff]
    refine IsZero.of_iso ?_ ((restrictedDerivedRestrict i).mapIso (hcP k).some)
    have : PreservesBinaryBiproducts (restrictedDerivedRestrict i) :=
      have := adji.leftAdjoint_preservesColimits
      preservesBinaryBiproducts_of_preservesBinaryCoproducts _
    refine IsZero.of_iso ?_ ((restrictedDerivedRestrict i).mapBiprod _ _)
    exact (biprod_isZero_iff _ _).2 ⟨hP0 k, isZero_map_shift_of_isZero_map (hP0 k) 1⟩
  have hK0' : ∀ k, IsZero ((restrictedDerivedRestrict (i ≫ j)).obj (K k)) := fun k => by
    rw [isZero_restrictedDerivedRestrict_comp_iff]
    exact (restrictedDerivedRestrict i).map_isZero (hK0 k)
  let F : ι₁ ⊕ ι₂ → Stacks.Duality.quasiCoherentDerivedCategory Y := Sum.elim K c
  have hF0 : ∀ k, IsZero ((restrictedDerivedRestrict (i ≫ j)).obj (F k)) := fun k => by
    cases k with
    | inl k => exact hK0' k
    | inr k => exact hc0 k
  refine ⟨ι₁ ⊕ ι₂, inferInstance, F, fun k => ?_, hF0, fun E hE => ?_⟩
  · cases k with
    | inl k => exact hKc k
    | inr k => exact hcc k
  · obtain ⟨Cn, π, δ, hT, hCc, hCo⟩ := exists_cone_unit_isZero_restrict_rightOrthogonal (i ≫ j) F
      hF0 E hE
    have hCj : IsIso (adjj.unit.app Cn) := hKdet Cn fun k n g => hCo (Sum.inl k) n g
    have hCPo : ∀ (k : ι₂) (n : ℤ) (g : (P k)⟦n⟧ ⟶ (restrictedDerivedRestrict j).obj Cn),
        g = 0 := fun k n g => by
      obtain ⟨e⟩ := hcP k
      exact eq_zero_of_retract_of_forall_eq_zero (restrictedDerivedRestrict j)
        (biprod.inl ≫ e.inv) (e.hom ≫ biprod.fst) (by simp) n g
        (eq_zero_of_isIso_unit adjj hCj (hCo (Sum.inr k) n))
    have hCi : IsIso (adji.unit.app ((restrictedDerivedRestrict j).obj Cn)) := hPdet _ hCPo
    have hCU : IsZero ((restrictedDerivedRestrict i).obj ((restrictedDerivedRestrict j).obj Cn)) :=
      (isZero_restrictedDerivedRestrict_comp_iff i j Cn).1 hCc
    exact (Triangle.isZero₃_iff_isIso₁ _ hT).1 (isZero_of_isIso_unit_of_isZero_obj adjj hCj
      (isZero_of_isIso_unit_of_isZero_obj adji hCi hCU))

end Transitivity

/-! ### Three base cases -/

section Base

/-- `Stacks.Duality.SupportedGeneration.FiniteKernelDetected` depends on the open immersion only up
to equality. -/
theorem finiteKernelDetected_congr {X U : Scheme.{u}} {j j' : U ⟶ X} [IsOpenImmersion j]
    [IsOpenImmersion j'] [AlgebraicGeometry.QuasiCompact j] [AlgebraicGeometry.QuasiCompact j']
    [CompactSpace X] (h : FiniteKernelDetected j) (e : j = j') : FiniteKernelDetected j' := by
  subst e
  exact h

/-- `Stacks.Duality.SupportedGeneration.FiniteKernelDetected` for the inclusion of an open
depends on the open only up to equality. -/
theorem finiteKernelDetected_opens_congr {X : Scheme.{u}} [CompactSpace X] {S S' : X.Opens}
    [AlgebraicGeometry.QuasiCompact S.ι] [AlgebraicGeometry.QuasiCompact S'.ι]
    (h : FiniteKernelDetected S.ι) (e : S = S') : FiniteKernelDetected S'.ι := by
  subst e
  exact h

/-- **The affine case** ([Stacks, Tag 09IR]): on `Spec A` the kernel of restriction to
`D(f₁) ∪ … ∪ D(f_r)` is detected by the Koszul complex on the `fᵢ`. -/
theorem finiteKernelDetected_openComplement {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    FiniteKernelDetected (Stacks.Koszul.Truncation.openComplement f).ι :=
  ⟨PUnit, inferInstance, fun _ => koszulQC f, fun _ => isCompactObject_koszulQC f,
    fun _ => isZero_restrictedDerivedRestrict_koszulQC f,
    fun E hE => isIso_unit_of_forall_hom_koszulQC_eq_zero f E fun n g => hE PUnit.unit n g⟩

/-- **The affine case for an arbitrary quasi-compact open**: on `Spec A` the kernel of restriction
to a quasi-compact open is detected by finitely many compact objects. -/
theorem finiteKernelDetected_of_isAffine {A : Type u} [CommRing A]
    (S : (Spec (CommRingCat.of A)).Opens)
    (hS : IsCompact (S : Set (Spec (CommRingCat.of A)))) [AlgebraicGeometry.QuasiCompact S.ι] :
    FiniteKernelDetected S.ι := by
  obtain ⟨s, hs⟩ := Stacks.AlgebraicGeometry.InductionPrinciple.exists_finset_basicOpen_of_isCompact
    (isAffineOpen_top (Spec (CommRingCat.of A))) hS le_top
  let e := s.equivFin
  let f : Fin s.card → A := fun i => (Scheme.ΓSpecIso (CommRingCat.of A)).hom (e.symm i)
  have hW : Stacks.Koszul.Truncation.openComplement f = S := by
    rw [hs]
    refine le_antisymm (iSup_le fun i => ?_) (iSup₂_le fun g hg => ?_)
    · refine le_trans (le_of_eq ?_)
        (le_iSup₂ (f := fun g _ => (Spec (CommRingCat.of A)).basicOpen g) (e.symm i).1 (e.symm i).2)
      congr 1
      simp [f]
    · refine le_trans (le_of_eq ?_) (le_iSup _ (e ⟨g, hg⟩))
      congr 1
      simp [f]
  exact finiteKernelDetected_opens_congr (finiteKernelDetected_openComplement f) hW

/-- **A surjective open immersion**: its kernel is detected by the empty family. -/
theorem finiteKernelDetected_of_surjective {X U : Scheme.{u}} (j : U ⟶ X) [IsOpenImmersion j]
    [AlgebraicGeometry.QuasiCompact j] [CompactSpace X] (hj : ∀ x : X, ∃ y, j y = x) :
    FiniteKernelDetected j := by
  refine ⟨PEmpty, inferInstance, PEmpty.elim, fun k => k.elim, fun k => k.elim, fun E _ => ?_⟩
  rw [isIso_restrictedDerivedRestrictAdjunction_unit_app_iff]
  refine isIso_of_isIso_derivedRestrict _ (fun _ : PUnit.{u + 1} => j)
    (fun x => ⟨PUnit.unit, hj x⟩) fun _ => ?_
  exact isIso_map_unit_of_isIso_counit (derivedRestrictPushforwardAdjunction j) E.obj
    inferInstance

end Base

/-! ### The induction -/

section Induction

/-- **The induction step**: if a quasi-compact open `W ⊆ X` and an affine open `V` cover `X`, the
kernel of restriction to `W` is detected by finitely many compact objects. -/
theorem finiteKernelDetected_of_sup_affine {X : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X]
    (W : X.Opens) (hW : IsCompact (W : Set X)) {V : X.Opens} (hV : IsAffineOpen V)
    (hcov : ∀ x : X, x ∈ W ∨ x ∈ V) :
    haveI : CompactSpace W.toScheme := isCompact_iff_compactSpace.mp hW
    FiniteKernelDetected W.ι := by
  have : CompactSpace W.toScheme := isCompact_iff_compactSpace.mp hW
  let jV := hV.fromSpec
  have hC : IsCompact ((jV ⁻¹ᵁ W : (Spec Γ(X, V)).Opens) : Set (Spec Γ(X, V))) :=
    jV.isCompact_preimage hW
  have : CompactSpace (jV ⁻¹ᵁ W).toScheme := isCompact_iff_compactSpace.mp hC
  refine finiteKernelDetected_of_excision jV W.ι (jV ⁻¹ᵁ W).ι (jV ∣_ W)
    (isPullback_morphismRestrict jV W).flip (fun x => ?_)
    (finiteKernelDetected_of_isAffine (A := Γ(X, V)) (jV ⁻¹ᵁ W) hC)
  rcases hcov x with h | h
  · exact Or.inr ⟨⟨x, h⟩, rfl⟩
  · exact Or.inl (by rwa [hV.range_fromSpec] : x ∈ Set.range jV)

/-- **The kernel of restriction along a quasi-compact open immersion is detected by finitely many
compact objects**, for a quasi-compact quasi-separated scheme whose points outside the image are
covered by `m` affine opens. -/
theorem finiteKernelDetected_of_affineCover : ∀ (m : ℕ) {X U : Scheme.{u}} [CompactSpace X]
    [QuasiSeparatedSpace X] (j : U ⟶ X) [IsOpenImmersion j] [AlgebraicGeometry.QuasiCompact j]
    (V : Fin m → X.Opens), (∀ i, IsAffineOpen (V i)) →
    (∀ x : X, (∃ y, j y = x) ∨ ∃ i, x ∈ V i) → FiniteKernelDetected j
  | 0, X, U, _, _, j, _, _, V, _, hcov =>
      finiteKernelDetected_of_surjective j fun x => (hcov x).resolve_right fun ⟨i, _⟩ => i.elim0
  | m + 1, X, U, _, _, j, _, _, V, hV, hcov => by
      have : CompactSpace U := QuasiCompact.compactSpace_of_compactSpace j
      let W : X.Opens := j.opensRange ⊔ ⨆ i : Fin m, V i.castSucc
      have hWc : IsCompact (W : Set X) := by
        refine IsCompact.union (isCompact_range j.continuous) ?_
        rw [TopologicalSpace.Opens.coe_iSup]
        exact isCompact_iUnion fun i => (hV _).isCompact
      have : CompactSpace W.toScheme := isCompact_iff_compactSpace.mp hWc
      have : QuasiSeparatedSpace W.toScheme := W.ι.isOpenEmbedding.quasiSeparatedSpace
      have hjW : Set.range j ⊆ Set.range W.ι := by
        rw [Scheme.Opens.range_ι]
        exact fun x hx => Or.inl hx
      let i := IsOpenImmersion.lift W.ι j hjW
      have hfac : i ≫ W.ι = j := IsOpenImmersion.lift_fac _ _ _
      have hW : FiniteKernelDetected W.ι :=
        finiteKernelDetected_of_sup_affine W hWc (hV (Fin.last m)) fun x => by
          rcases hcov x with h | ⟨k, hk⟩
          · exact Or.inl (Or.inl h)
          · refine Fin.lastCases (motive := fun k => x ∈ V k → x ∈ W ∨ x ∈ V (Fin.last m))
              (fun h => Or.inr h) (fun k h => Or.inl ?_) k hk
            exact Or.inr (TopologicalSpace.Opens.mem_iSup.mpr ⟨k, h⟩)
      have hi : FiniteKernelDetected i := finiteKernelDetected_of_affineCover m i
        (fun k => W.ι ⁻¹ᵁ V k.castSucc)
        (fun k => (hV k.castSucc).preimage_of_isOpenImmersion W.ι (by
          rw [Scheme.Opens.opensRange_ι]
          exact le_sup_of_le_right (le_iSup (fun k : Fin m => V k.castSucc) k)))
        (fun x => by
          rcases x.2 with h | h
          · obtain ⟨y, hy⟩ := h
            exact Or.inl ⟨y, W.ι.isOpenEmbedding.injective (by rwa [← Scheme.Hom.comp_apply, hfac])⟩
          · obtain ⟨k, hk⟩ := TopologicalSpace.Opens.mem_iSup.mp h
            exact Or.inr ⟨k, hk⟩)
      exact finiteKernelDetected_congr (finiteKernelDetected_comp W.ι i hW hi) hfac

/-- **The kernel of restriction to a quasi-compact open is detected by finitely many compact
objects**: for a quasi-compact open immersion `j : U ⟶ X` into a quasi-compact quasi-separated
scheme, there is a finite family of compact objects of `D_QCoh(𝒪_X)` restricting to zero on `U`
such that an object right orthogonal to all their shifts is `Rj_*` of its restriction to `U`. -/
theorem finiteKernelDetected {X U : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X] (j : U ⟶ X)
    [IsOpenImmersion j] [AlgebraicGeometry.QuasiCompact j] : FiniteKernelDetected j := by
  obtain ⟨s, hs, hX⟩ := (isCompact_iff_finite_and_eq_biUnion_affineOpens
    (U := (⊤ : X.Opens))).mp (by rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ)
  let t := hs.toFinset
  let e := t.equivFin
  refine finiteKernelDetected_of_affineCover t.card j (fun k => ((e.symm k).1 : X.Opens))
    (fun k => (e.symm k).1.2) fun x => Or.inr ?_
  have hx : x ∈ (⊤ : X.Opens) := trivial
  rw [hX, TopologicalSpace.Opens.mem_iSup] at hx
  obtain ⟨W, hx⟩ := hx
  obtain ⟨hW, hx⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  exact ⟨e ⟨W, hs.mem_toFinset.mpr hW⟩, by simpa using hx⟩

end Induction

/-! ### Support on a closed subset and restriction to the complement -/

section Support

/-- **A sheaf of modules on a scheme with vanishing stalks is zero.** -/
theorem isZero_of_forall_isZero_stalk {X : Scheme.{u}} (M : X.Modules)
    (h : ∀ x : X, IsZero ((TopCat.Presheaf.stalkFunctor Ab.{u} x).obj M.presheaf)) :
    IsZero M := by
  have : IsIso (0 : M ⟶ 0) := Stacks.AlgebraicGeometry.AffineBaseChange.isIso_of_isIso_stalk _
    fun x => isIso_of_source_target_iso_zero _ (h x).isoZero
      (((Scheme.Modules.toPresheaf X ⋙ TopCat.Presheaf.stalkFunctor Ab.{u} x).map_isZero
        (isZero_zero _))).isoZero
  exact (isZero_zero _).of_iso (asIso (0 : M ⟶ 0))

/-- **Restriction along an open immersion kills an object of `D(𝒪_X)` exactly when the
cohomology sheaves of that object have vanishing stalks at every point of the image.** -/
theorem isZero_derivedRestrict_iff {X U : Scheme.{u}} (j : U ⟶ X) [IsOpenImmersion j]
    (E : DerivedCategory X.Modules) :
    IsZero ((derivedRestrict j).obj E) ↔ ∀ (n : ℤ) (y : U),
      IsZero ((TopCat.Presheaf.stalkFunctor Ab.{u} (j y)).obj
        ((DerivedCategory.homologyFunctor X.Modules n).obj E).presheaf) := by
  rw [DerivedCategory.isZero_iff_forall_isZero_homology]
  refine forall_congr' fun n => ?_
  let M := (DerivedCategory.homologyFunctor X.Modules n).obj E
  have e : (DerivedCategory.homologyFunctor U.Modules n).obj ((derivedRestrict j).obj E) ≅
      (Scheme.Modules.restrictFunctor j).obj M :=
    ((Scheme.Modules.restrictFunctor j).mapDerivedCategoryHomologyIso n).app E
  have hst : ∀ y : U, (TopCat.Presheaf.stalkFunctor Ab.{u} y).obj
      ((Scheme.Modules.restrictFunctor j).obj M).presheaf ≅
        (TopCat.Presheaf.stalkFunctor Ab.{u} (j y)).obj M.presheaf :=
    fun y => (Scheme.Modules.restrictStalkNatIso j y).app M
  exact ⟨fun h y => (Functor.map_isZero
      (Scheme.Modules.toPresheaf U ⋙ TopCat.Presheaf.stalkFunctor Ab.{u} y)
      (h.of_iso e.symm)).of_iso (hst y).symm,
    fun h => (isZero_of_forall_isZero_stalk _ fun y => (h y).of_iso (hst y)).of_iso e⟩

end Support

/-! ### A single generator -/

section Single

variable {X U : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X] (j : U ⟶ X)
  [IsOpenImmersion j] [AlgebraicGeometry.QuasiCompact j]

/-- **A single compact object killed by `j^*` detects the kernel of `j^*`.** For a quasi-compact
open immersion `j : U ⟶ X` into a quasi-compact quasi-separated scheme there is a compact object
`G` of `D_QCoh(𝒪_X)` with `G|_U = 0` such that an object receiving no nonzero morphism from any
shift of `G` has invertible unit `E ⟶ Rj_*(E|_U)`. -/
theorem exists_isCompactObject_generator_kernel :
    ∃ G : Stacks.Duality.quasiCoherentDerivedCategory X, IsCompactObject.{u} G ∧
      IsZero ((restrictedDerivedRestrict j).obj G) ∧
      ∀ E : Stacks.Duality.quasiCoherentDerivedCategory X,
        (∀ (n : ℤ) (g : G⟦n⟧ ⟶ E), g = 0) →
          IsIso ((restrictedDerivedRestrictAdjunction j).unit.app E) := by
  obtain ⟨ι, hι, K, hKc, hK0, hKdet⟩ := finiteKernelDetected j
  let adj := restrictedDerivedRestrictAdjunction j
  classical
  refine ⟨∐ K, isCompactObject_sigma K hKc, ?_, fun E hE => hKdet E fun i n g => ?_⟩
  · have := adj.leftAdjoint_preservesColimits
    refine IsZero.of_iso ?_ (PreservesCoproduct.iso (restrictedDerivedRestrict j) K)
    rw [IsZero.iff_id_eq_zero]
    exact Sigma.hom_ext _ _ fun i => (hK0 i).eq_of_src _ _
  · have h := hE n ((shiftFunctor _ n).map (Sigma.π K i) ≫ g)
    calc g = (shiftFunctor _ n).map (Sigma.ι K i) ≫
          ((shiftFunctor _ n).map (Sigma.π K i) ≫ g) := by
          rw [← Category.assoc, ← Functor.map_comp, Sigma.ι_π_eq_id]
          simp
      _ = 0 := by rw [h, comp_zero]

end Single

/-! ### A perfect generator of the complexes supported on a closed subset -/

section Supported

variable (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (T : Set X)

/-- **A perfect generator of the objects of `D_QCoh(𝒪_X)` with cohomology supported on `T`.** Let
`X` be a quasi-compact quasi-separated scheme and `T ⊆ X` a closed subset with quasi-compact
complement. There is a compact object `G` of `D_QCoh(𝒪_X)` which is perfect, whose cohomology
sheaves have vanishing stalks off `T`, and which generates the objects of `D_QCoh(𝒪_X)` with
cohomology supported on `T`: such an object receiving no nonzero morphism from any shift of `G` is
zero. -/
theorem exists_isPerfect_generator_supported_modules (hT : IsClosed T)
    (hTc : IsCompact (Tᶜ : Set X)) :
    ∃ G : Stacks.Duality.quasiCoherentDerivedCategory X, IsCompactObject.{u} G ∧
      Stacks.Cohomology.PerfectComplexes.IsPerfect (X := X.toRingedSpace) G.obj ∧
      (∀ (n : ℤ) (x : X), x ∉ T → IsZero ((TopCat.Presheaf.stalkFunctor Ab.{u} x).obj
        ((DerivedCategory.homologyFunctor X.Modules n).obj G.obj).presheaf)) ∧
      ∀ E : Stacks.Duality.quasiCoherentDerivedCategory X,
        (∀ (n : ℤ) (x : X), x ∉ T → IsZero ((TopCat.Presheaf.stalkFunctor Ab.{u} x).obj
          ((DerivedCategory.homologyFunctor X.Modules n).obj E.obj).presheaf)) →
        (∀ (n : ℤ) (g : G⟦n⟧ ⟶ E), g = 0) → IsZero E := by
  let V : X.Opens := ⟨Tᶜ, hT.isOpen_compl⟩
  have : CompactSpace V := isCompact_iff_compactSpace.mp hTc
  have : AlgebraicGeometry.QuasiCompact V.ι := quasiCompact_of_compactSpace _
  have hsupp : ∀ E : Stacks.Duality.quasiCoherentDerivedCategory X,
      IsZero ((restrictedDerivedRestrict V.ι).obj E) ↔
        ∀ (n : ℤ) (x : X), x ∉ T → IsZero ((TopCat.Presheaf.stalkFunctor Ab.{u} x).obj
          ((DerivedCategory.homologyFunctor X.Modules n).obj E.obj).presheaf) := by
    intro E
    refine ⟨fun h n x hx => ?_, fun h => isZero_fullSubcategory_of_isZero_obj
      ((isZero_derivedRestrict_iff V.ι E.obj).2 fun n y => h n _ y.2)⟩
    exact (isZero_derivedRestrict_iff V.ι E.obj).1
      ((DerivedCategoryB.derivedCategoryB (A := V.toScheme.Modules)
        (SheafOfModules.isQuasicoherent V.toScheme.ringCatSheaf)).ι.map_isZero h) n ⟨x, hx⟩
  obtain ⟨G, hGc, hG0, hGdet⟩ := exists_isCompactObject_generator_kernel V.ι
  refine ⟨G, hGc, Stacks.Duality.QcqsPerfect.isPerfect_of_isCompactObject_of_qcqs X G hGc,
    (hsupp G).1 hG0, fun E hE hEG => ?_⟩
  have hiso := hGdet E hEG
  exact ((Stacks.Duality.quasiCoherentDerivedPushforward V.ι
    (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs V.ι)).map_isZero
      ((hsupp E).2 hE)).of_iso (asIso ((restrictedDerivedRestrictAdjunction V.ι).unit.app E))

/-- **The inclusion `D_{QCoh,T}(𝒪_X) ⥤ D_QCoh(𝒪_X)`.** -/
abbrev quasiCoherentSupportedToQuasiCoherent :
    Stacks.Duality.QuasiCoherentSupportedDerivedCategory X T ⥤
      Stacks.Duality.quasiCoherentDerivedCategory X :=
  ObjectProperty.lift _ (Stacks.Duality.quasiCoherentSupported X T).ι fun G => G.property.1

omit [CompactSpace X] [QuasiSeparatedSpace X] in
/-- **Compactness in `D_QCoh(𝒪_X)` implies compactness in `D_{QCoh,T}(𝒪_X)`.** -/
theorem isCompactObject_quasiCoherentSupported_of_isCompactObject
    (G : Stacks.Duality.QuasiCoherentSupportedDerivedCategory X T)
    (hG : IsCompactObject.{u} ((quasiCoherentSupportedToQuasiCoherent X T).obj G)) :
    IsCompactObject.{u} G := by
  let F := quasiCoherentSupportedToQuasiCoherent X T
  let ιQ := (DerivedCategoryB.derivedCategoryB (A := X.Modules)
    (SheafOfModules.isQuasicoherent X.ringCatSheaf)).ι
  have : (F ⋙ ιQ).Full := inferInstanceAs (Stacks.Duality.quasiCoherentSupported X T).ι.Full
  have : (F ⋙ ιQ).Faithful :=
    inferInstanceAs (Stacks.Duality.quasiCoherentSupported X T).ι.Faithful
  have : F.Full := Functor.Full.of_comp_faithful F ιQ
  have : F.Faithful := Functor.Faithful.of_comp F ιQ
  have : F.Additive := ⟨rfl⟩
  have : ∀ I : Type u, PreservesColimitsOfShape (Discrete I) F := fun I => by
    have := Stacks.Duality.Supported.quasiCoherentSupported_isClosedUnderCoproducts X T I
    have := Stacks.Duality.DerivedPushforward.derivedQuasicoherent_isClosedUnderCoproducts X I
    have : PreservesColimitsOfShape (Discrete I) (F ⋙ ιQ) :=
      inferInstanceAs (PreservesColimitsOfShape (Discrete I)
        (Stacks.Duality.quasiCoherentSupported X T).ι)
    exact preservesColimitsOfShape_of_reflects_of_preserves F ιQ
  exact isCompactObject_of_fullyFaithful F G hG

/-- **[Stacks, Tag 0A9A].** Let `X` be a quasi-compact and quasi-separated scheme and let
`T ⊆ X` be a closed subset such that `X ∖ T` is quasi-compact. Then `D_{QCoh,T}(𝒪_X)` is generated
by a single perfect object: there is an object `G` of `D_{QCoh,T}(𝒪_X)` which is perfect as an
object of `D(𝒪_X)` and such that every object `K` of `D(𝒪_X)` with quasi-coherent cohomology
supported on `T` receiving no nonzero morphism from any shift `G⟦n⟧` is zero. Moreover `G` is a
compact object of `D_{QCoh,T}(𝒪_X)`. -/
theorem exists_isPerfect_generator_quasiCoherentSupported (hT : IsClosed T)
    (hTc : IsCompact (Tᶜ : Set X)) :
    ∃ G : Stacks.Duality.QuasiCoherentSupportedDerivedCategory X T,
      Stacks.Cohomology.PerfectComplexes.IsPerfect (X := X.toRingedSpace) G.obj ∧
      IsCompactObject.{u} G ∧
      ∀ K : DerivedCategory (SheafOfModules.{u} X.ringCatSheaf),
        Stacks.Duality.quasiCoherentSupported X T K →
        (∀ (n : ℤ) (f : G.obj⟦n⟧ ⟶ K), f = 0) → IsZero K := by
  obtain ⟨G, hGc, hGp, hGs, hGgen⟩ := exists_isPerfect_generator_supported_modules X T hT hTc
  let ιQ := (DerivedCategoryB.derivedCategoryB (A := X.Modules)
    (SheafOfModules.isQuasicoherent X.ringCatSheaf)).ι
  refine ⟨⟨G.obj, G.property, hGs⟩, hGp,
    isCompactObject_quasiCoherentSupported_of_isCompactObject X T ⟨G.obj, G.property, hGs⟩ hGc,
    fun K hK hKG => ?_⟩
  let K' : Stacks.Duality.quasiCoherentDerivedCategory X := ⟨K, hK.1⟩
  have hz : IsZero K' := by
    refine hGgen K' hK.2 fun n g => ?_
    apply ιQ.map_injective
    rw [Functor.map_zero, ← cancel_epi ((ιQ.commShiftIso n).inv.app G), comp_zero]
    exact hKG n _
  exact ιQ.map_isZero hz

/-- **[Stacks, Tag 0A9A], inside `D_{QCoh,T}(𝒪_X)`.** The perfect object `G` of
`exists_isPerfect_generator_quasiCoherentSupported` is a weak generator of the triangulated
category `D_{QCoh,T}(𝒪_X)` itself: an object of `D_{QCoh,T}(𝒪_X)` receiving no nonzero morphism
from any shift of `G` is zero. -/
theorem exists_isPerfect_isWeakGenerator_quasiCoherentSupported (hT : IsClosed T)
    (hTc : IsCompact (Tᶜ : Set X)) :
    ∃ G : Stacks.Duality.QuasiCoherentSupportedDerivedCategory X T,
      Stacks.Cohomology.PerfectComplexes.IsPerfect (X := X.toRingedSpace) G.obj ∧
      IsCompactObject.{u} G ∧
      ∀ K : Stacks.Duality.QuasiCoherentSupportedDerivedCategory X T,
        (∀ (n : ℤ) (f : G⟦n⟧ ⟶ K), f = 0) → IsZero K := by
  obtain ⟨G, hGp, hGc, hGgen⟩ := exists_isPerfect_generator_quasiCoherentSupported X T hT hTc
  let ιP := (Stacks.Duality.quasiCoherentSupported X T).ι
  refine ⟨G, hGp, hGc, fun K hK => isZero_fullSubcategory_of_isZero_obj
    (hGgen K.obj K.property fun n f => ?_)⟩
  have h := congrArg ιP.map (hK n (ιP.preimage ((ιP.commShiftIso n).hom.app G ≫ f)))
  rw [Functor.map_preimage, Functor.map_zero] at h
  rwa [← cancel_epi ((ιP.commShiftIso n).hom.app G), comp_zero]

end Supported

end Stacks.Duality.SupportedGeneration

