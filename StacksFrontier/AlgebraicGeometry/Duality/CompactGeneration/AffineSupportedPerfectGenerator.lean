/-!
# A perfect generator of `D_{QCoh,T}(𝒪_X)` on an affine scheme, and restriction to an open

Let `X` be an affine scheme and `T ⊆ X` a closed subset with quasi-compact complement. Write
`X ∖ T = D(f₁) ∪ ⋯ ∪ D(f_r)` and let `K` be the Koszul complex on `f₁, …, f_r`, a perfect object of
`D(𝒪_X)` supported on `T`. Then an object `F` of `D(𝒪_X)` with quasi-coherent cohomology
supported on `T` and with `Hom(K[n], F) = 0` for every `n` is zero. This is the case of an affine
scheme of [Stacks, Tag 0A9A]: `D_{QCoh,T}(𝒪_X)` is generated by the single perfect object `K`.

The second statement is the form in which the proof of [Stacks, Tag 0AEC] uses this on the affine
member `V` of an elementary distinguished square: for `O ⊆ X` a quasi-compact open and `T ⊆ X`
closed with `X ∖ ((X ∖ O) ∩ T)` quasi-compact, there is a perfect `K` supported on
`(X ∖ O) ∩ T` such that for every `G` with quasi-coherent cohomology supported on `T` and
`Hom(K[n], G) = 0` for all `n`, restriction `Hom(A, G) ⟶ Hom(A|_O, G|_O)` is bijective for every
`A`. This is the step "by 09IR we have `E|_V = Rj_*E|_W`" of the source, followed by its use of
[Stacks, Tag 08DF].

## Main results

* `CategoryTheory.isZero_of_forall_hom_eq_zero_of_functor` and
  `CategoryTheory.bijective_map_of_iso_comp`: transport of a detection statement, and of a
  bijectivity statement, along a functor.
* `Stacks.Duality.AffineSupportedGenerator.exists_isPerfect_detecting_of_isAffine`: the affine
  case of Stacks 0A9A.
* `Stacks.Duality.AffineSupportedGenerator.exists_isPerfect_bijective_restrict_of_isAffine`: the
  restriction statement.

## References

* [Stacks Project, Tag 0A9A](https://stacks.math.columbia.edu/tag/0A9A)
* [Stacks Project, Tag 09IR](https://stacks.math.columbia.edu/tag/09IR)
* [Stacks Project, Tag 08D5](https://stacks.math.columbia.edu/tag/08D5)
* [Stacks Project, Tag 0AEC](https://stacks.math.columbia.edu/tag/0AEC)
* [Stacks Project, Tag 08DF](https://stacks.math.columbia.edu/tag/08DF)
-/

-- This file uses the locally small derived-category models below, which are not
-- global instances (see `StacksFrontier.Homology.DerivedCategory.LocallySmall`):
-- `D(R)` for sheaves of modules on a small site.
-- `D(𝒪_X)` for a scheme.
attribute [local instance] SheafOfModules.hasDerivedCategory
attribute [local instance] AlgebraicGeometry.Scheme.Modules.hasDerivedCategory

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.ObjectProperty
open CategoryTheory.Pretriangulated AlgebraicGeometry

universe w w' u

namespace CategoryTheory

section Transport

variable {D₁ D₂ : Type*} [Category D₁] [Category D₂] [Preadditive D₁] [Preadditive D₂]
  [HasShift D₁ ℤ] [HasShift D₂ ℤ]

/-- **A detection statement transported along a functor.** Let `Φ : D₁ ⥤ D₂` commute with the
shift, let `P₁`, `P₂` be properties of objects such that every object with `P₂` is `Φ` of an
object with `P₁`, and suppose `Φ` kills no nonzero morphism out of a shift of `K` into an object
with `P₁`. If `K` detects the objects with `P₁` (an object with `P₁` receiving no nonzero map from
any shift of `K` is zero), then `Φ K` detects the objects with `P₂`. -/
theorem isZero_of_forall_hom_eq_zero_of_functor (Φ : D₁ ⥤ D₂) [Φ.CommShift ℤ]
    [Φ.PreservesZeroMorphisms] (K : D₁) (P₁ : ObjectProperty D₁) (P₂ : ObjectProperty D₂)
    (hess : ∀ F, P₂ F → ∃ F₁, P₁ F₁ ∧ Nonempty (Φ.obj F₁ ≅ F))
    (hfaith : ∀ F₁, P₁ F₁ → ∀ (n : ℤ) (g : K⟦n⟧ ⟶ F₁), Φ.map g = 0 → g = 0)
    (hK : ∀ F₁, P₁ F₁ → (∀ (n : ℤ) (g : K⟦n⟧ ⟶ F₁), g = 0) → IsZero F₁)
    (F : D₂) (hF : P₂ F) (h : ∀ (n : ℤ) (g : (Φ.obj K)⟦n⟧ ⟶ F), g = 0) : IsZero F := by
  obtain ⟨F₁, hF₁, ⟨e⟩⟩ := hess F hF
  refine (Φ.map_isZero (hK F₁ hF₁ fun n g => hfaith F₁ hF₁ n g ?_)).of_iso e.symm
  calc Φ.map g = (Φ.commShiftIso n).hom.app K ≫
        ((Φ.commShiftIso n).inv.app K ≫ Φ.map g ≫ e.hom) ≫ e.inv := by simp
    _ = 0 := by rw [h n ((Φ.commShiftIso n).inv.app K ≫ Φ.map g ≫ e.hom)]; simp

end Transport

/-- **Bijectivity of a functor on a hom set, transported along a square.** Let
`σ : R₀ ⋙ ε' ≅ ε ⋙ R` and let `A₀`, `G₀` be objects such that `ε` is bijective on
`A₀ ⟶ G₀`, `ε'` is bijective on `R₀ A₀ ⟶ R₀ G₀` and `R₀` is bijective on `A₀ ⟶ G₀`. Then `R`
is bijective on `A ⟶ G` for all `A ≅ ε A₀` and `G ≅ ε G₀`. -/
theorem bijective_map_of_iso_comp {D₀ D₀' D D' : Type*} [Category D₀] [Category D₀']
    [Category D] [Category D'] (ε : D₀ ⥤ D) (ε' : D₀' ⥤ D') (R₀ : D₀ ⥤ D₀') (R : D ⥤ D')
    (σ : R₀ ⋙ ε' ≅ ε ⋙ R) {A₀ G₀ : D₀}
    (hε : Function.Bijective (fun x : A₀ ⟶ G₀ => ε.map x))
    (hε' : Function.Bijective (fun x : R₀.obj A₀ ⟶ R₀.obj G₀ => ε'.map x))
    (hR₀ : Function.Bijective (fun x : A₀ ⟶ G₀ => R₀.map x)) {A G : D}
    (eA : ε.obj A₀ ≅ A) (eG : ε.obj G₀ ≅ G) :
    Function.Bijective (fun x : A ⟶ G => R.map x) := by
  let α : (A₀ ⟶ G₀) → (A ⟶ G) := (eA.homCongr eG) ∘ fun x => ε.map x
  have hα : Function.Bijective α := (eA.homCongr eG).bijective.comp hε
  let β : (A₀ ⟶ G₀) → (R.obj A ⟶ R.obj G) :=
    ((R.mapIso eA).homCongr (R.mapIso eG)) ∘ ((σ.app A₀).homCongr (σ.app G₀)) ∘
      (fun y => ε'.map y) ∘ fun x => R₀.map x
  have hβ : Function.Bijective β :=
    ((R.mapIso eA).homCongr (R.mapIso eG)).bijective.comp
      (((σ.app A₀).homCongr (σ.app G₀)).bijective.comp (hε'.comp hR₀))
  have hcomp : (fun x : A ⟶ G => R.map x) ∘ α = β := by
    funext x
    have hnat : R.map (ε.map x) = σ.inv.app A₀ ≫ ε'.map (R₀.map x) ≫ σ.hom.app G₀ := by
      have := σ.hom.naturality x
      simp only [Functor.comp_obj, Functor.comp_map] at this
      rw [this, Iso.inv_hom_id_app_assoc]
    simp only [α, β, Function.comp_apply, Iso.homCongr_apply, Functor.map_comp, hnat,
      Functor.mapIso_inv, Functor.mapIso_hom, Iso.app_inv, Iso.app_hom, Category.assoc]
  rw [← Function.Bijective.of_comp_iff _ hα, hcomp]
  exact hβ

end CategoryTheory

namespace Stacks.Duality.AffineSupportedGenerator

open Stacks.Duality.OpenImmersion Stacks.Koszul.Truncation

/-! ### Support along an open immersion, at any model -/

section Support

variable {A B : Scheme.{u}} (g : A ⟶ B) [IsOpenImmersion g]

/-- **Restriction along an open immersion pulls a support back.** -/
theorem derivedSupported_derivedRestrict (T : Set B) (S : Set A)
    (hS : ∀ x : A, x ∉ S → g.base x ∉ T) (E : DerivedCategory B.Modules)
    (hE : derivedSupported B.ringCatSheaf T E) :
    derivedSupported A.ringCatSheaf S ((derivedRestrict g).obj E) := fun n x hx =>
  (hE n (g.base x) (hS x hx)).of_iso
    (Stacks.Duality.OpenImmersion.stalkHomologyDerivedRestrictIso g E n x)

/-- **An object restricting to zero along an open immersion has its support off the image.** -/
theorem derivedSupported_compl_range_of_isZero (E : DerivedCategory B.Modules)
    (hE : IsZero ((derivedRestrict g).obj E)) :
    derivedSupported B.ringCatSheaf (Set.range g.base)ᶜ E := by
  intro n y hy
  simp only [Set.mem_compl_iff, not_not] at hy
  obtain ⟨x, rfl⟩ := hy
  have h1 : IsZero ((DerivedCategory.homologyFunctor A.Modules n).obj
      ((derivedRestrict g).obj E)) := (DerivedCategory.homologyFunctor A.Modules n).map_isZero hE
  exact IsZero.of_iso ((SheafOfModules.stalkAddCommGroupFunctor A.ringCatSheaf x).map_isZero h1)
    (Stacks.Duality.OpenImmersion.stalkHomologyDerivedRestrictIso g E n x).symm

end Support

/-- An object of `D(𝒪_X)` supported on the empty set is zero. -/
theorem isZero_of_derivedSupported_empty {X : Scheme.{u}}
    (E : DerivedCategory X.Modules) (hE : derivedSupported X.ringCatSheaf ∅ E) : IsZero E :=
  Stacks.Duality.isZero_of_forall_isZero_homology E fun n =>
    Stacks.Cohomology.PushforwardRestriction.isZero_sheafOfModules_of_stalk_isZero _ _
      fun x => hE n x (Set.notMem_empty x)

/-- **An object supported away from the image of an open immersion restricts to zero.** -/
theorem isZero_derivedRestrict_of_derivedSupported {A B : Scheme.{u}} (g : A ⟶ B)
    [IsOpenImmersion g] (T : Set B) (hT : ∀ x : A, g.base x ∉ T) (E : DerivedCategory B.Modules)
    (hE : derivedSupported B.ringCatSheaf T E) : IsZero ((derivedRestrict g).obj E) :=
  isZero_of_derivedSupported_empty _
    (derivedSupported_derivedRestrict g T ∅ (fun x _ => hT x) E hE)

/-- **Right orthogonality to the shifts of one object, written out.** -/
theorem rightOrthogonal_singleton_iff {C : Type*} [Category C] [Preadditive C] [HasShift C ℤ]
    (K E : C) :
    ((singleton K).shiftClosure ℤ).rightOrthogonal E ↔ ∀ (n : ℤ) (g : K⟦n⟧ ⟶ E), g = 0 := by
  refine ⟨fun h n g => h g ⟨K, n, Iso.refl _, ofObj_apply _ ()⟩, ?_⟩
  rintro h Z g ⟨W, n, e, hW⟩
  rw [singleton_iff] at hW
  subst hW
  rw [← cancel_epi e.inv, comp_zero]
  exact h n _

/-! ### The affine case of Stacks 0A9A -/

/-- The points of an affine scheme `Y` outside a closed `C` are those mapped by `Y ≅ Spec Γ(Y, ⊤)`
into `D(f₁) ∪ ⋯ ∪ D(f_r)`, for global sections `fᵢ` with `Y ∖ C = Y_{f₁} ∪ ⋯ ∪ Y_{f_r}`. -/
theorem notMem_iff_isoSpec_mem_openComplement (Y : Scheme.{u}) [IsAffine Y] (C : Set Y)
    {r : ℕ} (f : Fin r → Γ(Y, ⊤)) (hf : ∀ x : Y, x ∉ C ↔ ∃ i, x ∈ Y.basicOpen (f i)) (x : Y) :
    x ∉ C ↔ Y.isoSpec.hom.base x ∈ (openComplement (A := Γ(Y, ⊤)) f : Set _) := by
  rw [hf x]
  simp only [openComplement, TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion, SetLike.mem_coe]
  refine exists_congr fun i => ?_
  have h := Scheme.preimage_basicOpen_top Y.isoSpec.hom ((Scheme.ΓSpecIso Γ(Y, ⊤)).inv (f i))
  have h2 : Y.isoSpec.hom.appTop ((Scheme.ΓSpecIso Γ(Y, ⊤)).inv (f i)) = f i := by
    rw [Scheme.isoSpec_hom, Scheme.toSpecΓ_appTop]
    exact (Scheme.ΓSpecIso Γ(Y, ⊤)).inv_hom_id_apply (f i)
  rw [h2] at h
  rw [← h]
  rfl

/-- **The affine case of [Stacks, Tag 0A9A].** Let `Y` be an affine scheme and `C ⊆ Y` a closed
subset with quasi-compact complement. There is a perfect object `K` of `D(𝒪_Y)` supported on `C`
such that every object of `D(𝒪_Y)` with quasi-coherent cohomology supported on `C` receiving no
nonzero morphism from any shift of `K` is zero. `K` is the Koszul complex on global sections
`f₁, …, f_r` with `Y ∖ C = Y_{f₁} ∪ ⋯ ∪ Y_{f_r}`, read on `Y` through `Y ≅ Spec Γ(Y, ⊤)`. -/
theorem exists_isPerfect_detecting_of_isAffine (Y : Scheme.{u}) [IsAffine Y] (C : Set Y)
    (hC : IsClosed C) (hCc : IsCompact Cᶜ) :
    ∃ K : DerivedCategory Y.Modules,
      Stacks.Cohomology.PerfectComplexes.IsPerfect (X := Y.toRingedSpace) K ∧
      derivedSupported Y.ringCatSheaf C K ∧
      ∀ F : DerivedCategory Y.Modules,
        DerivedCategoryB.derivedCategoryB (A := Y.Modules)
          (SheafOfModules.isQuasicoherent Y.ringCatSheaf) F →
        derivedSupported Y.ringCatSheaf C F → (∀ (n : ℤ) (g : K⟦n⟧ ⟶ F), g = 0) → IsZero F := by
  classical
  obtain ⟨s, hs, hseq⟩ := (isCompact_and_isOpen_iff_finite_and_eq_biUnion_basicOpen
    (X := Y) (U := Cᶜ)).mp ⟨hCc, hC.isOpen_compl⟩
  let : Fintype s := hs.fintype
  let eS : Fin (Fintype.card s) ≃ s := (Fintype.equivFin s).symm
  let f : Fin (Fintype.card s) → Γ(Y, ⊤) := fun i => (eS i).val
  have hf : ∀ x : Y, x ∉ C ↔ ∃ i, x ∈ Y.basicOpen (f i) := by
    intro x
    rw [← Set.mem_compl_iff, hseq]
    simp only [Set.mem_iUnion, SetLike.mem_coe]
    exact ⟨fun ⟨g, hg, hx⟩ => ⟨eS.symm ⟨g, hg⟩, by simpa [f] using hx⟩,
      fun ⟨i, hx⟩ => ⟨(eS i).val, (eS i).property, hx⟩⟩
  have hpts := notMem_iff_isoSpec_mem_openComplement Y C f hf
  let φ : Y ≅ Spec Γ(Y, ⊤) := Y.isoSpec
  let W := openComplement (A := Γ(Y, ⊤)) f
  let EM := Stacks.DerivedQCoh.modulesRestrictionEquivalence φ.symm
  have : EM.functor.Additive := Stacks.DerivedQCoh.modulesRestrictAlong_additive φ.hom
  have : PreservesFiniteLimits EM.functor :=
    Stacks.DerivedQCoh.modulesRestrictAlong_preservesFiniteLimits φ.hom
  have : PreservesFiniteColimits EM.functor :=
    Stacks.DerivedQCoh.modulesRestrictAlong_preservesFiniteColimits φ.hom
  have : EM.inverse.Additive := Stacks.DerivedQCoh.modulesRestrictAlong_additive φ.inv
  have : PreservesFiniteLimits EM.inverse :=
    Stacks.DerivedQCoh.modulesRestrictAlong_preservesFiniteLimits φ.inv
  have : PreservesFiniteColimits EM.inverse :=
    Stacks.DerivedQCoh.modulesRestrictAlong_preservesFiniteColimits φ.inv
  let ED := Stacks.DerivedQCoh.Equivalence.mapDerivedCategory EM
  let Φ := (Stacks.DerivedQCoh.modulesRestrictAlong φ.hom).mapDerivedCategory
  let Ψ := (Stacks.DerivedQCoh.modulesRestrictAlong φ.inv).mapDerivedCategory
  let KS := koszulObject (A := Γ(Y, ⊤)) f
  have hKS : Stacks.Cohomology.PerfectComplexes.IsPerfect (X := (Spec Γ(Y, ⊤)).toRingedSpace) KS :=
    @RingedSpace.isPerfect_Q_obj_of_isStrictlyPerfect _
      (Scheme.Modules.hasDerivedCategory (Spec Γ(Y, ⊤))) _
      (Stacks.AffineTilde.isStrictlyPerfect_tildeComplex_extend_seqComplex f)
  have hKSs : derivedSupported (Spec Γ(Y, ⊤)).ringCatSheaf (Set.range W.ι.base)ᶜ KS :=
    derivedSupported_compl_range_of_isZero W.ι KS
      (Stacks.Koszul.OpenComplement.isZero_derivedRestrict_koszulObject f)
  have hrange : Set.range W.ι.base = (W : Set (Spec Γ(Y, ⊤))) := Scheme.Opens.range_ι W
  refine ⟨Φ.obj KS, ?_, ?_, ?_⟩
  · exact Stacks.DerivedQCoh.isPerfect_derivedRestrict_of_isOpenImmersion_of_model φ.hom KS hKS
  · intro n x hx
    refine (hKSs n (φ.hom.base x) ?_).of_iso
      (Stacks.Duality.OpenImmersion.stalkHomologyDerivedRestrictIso φ.hom KS n x)
    rw [hrange]
    exact fun h => h ((hpts x).1 hx)
  · intro F hFq hFs h
    let P₁ : ObjectProperty (DerivedCategory (Spec Γ(Y, ⊤)).Modules) := fun M =>
      DerivedCategoryB.derivedCategoryB (A := (Spec Γ(Y, ⊤)).Modules)
        (SheafOfModules.isQuasicoherent (Spec Γ(Y, ⊤)).ringCatSheaf) M ∧
        IsZero ((derivedRestrict W.ι).obj M)
    let P₂ : ObjectProperty (DerivedCategory Y.Modules) := fun F =>
      DerivedCategoryB.derivedCategoryB (A := Y.Modules)
        (SheafOfModules.isQuasicoherent Y.ringCatSheaf) F ∧ derivedSupported Y.ringCatSheaf C F
    refine CategoryTheory.isZero_of_forall_hom_eq_zero_of_functor Φ KS P₁ P₂ ?_ ?_ ?_ F
      ⟨hFq, hFs⟩ h
    · rintro F ⟨hq, hsupp⟩
      refine ⟨Ψ.obj F,
        ⟨Stacks.Duality.OpenImmersion.derivedCategoryB_derivedRestrict φ.inv F hq, ?_⟩,
        ⟨(ED.counitIso.app F : _)⟩⟩
      refine isZero_derivedRestrict_of_derivedSupported W.ι (W : Set _)ᶜ
        (fun x hx => hx x.2) _ ?_
      refine derivedSupported_derivedRestrict φ.inv C (W : Set _)ᶜ ?_ F hsupp
      intro y hy
      simp only [Set.mem_compl_iff, not_not] at hy
      rw [hpts]
      have : φ.hom.base (φ.inv.base y) = y := by
        rw [← Scheme.Hom.comp_apply, φ.inv_hom_id]
        rfl
      rwa [this]
    · intro F₁ _ n g hg
      exact ED.functor.map_injective (hg.trans (ED.functor.map_zero _ _).symm)
    · rintro F₁ ⟨hq, hres⟩ hK
      exact isZero_of_forall_hom_koszulObject_eq_zero f F₁ hq hres hK

/-! ### Restriction to a quasi-compact open -/

/-- **Derived direct image along the inclusion of an open preserves support in a closed set**, at
the locally small model. -/
theorem derivedSupported_derivedPushforward {Y : Scheme.{u}} (U : Y.Opens) (T : Set Y)
    (hT : IsClosed T) (E : DerivedCategory U.toScheme.Modules)
    (hE : derivedSupported U.toScheme.ringCatSheaf (Subtype.val ⁻¹' T) E) :
    derivedSupported Y.ringCatSheaf T ((Stacks.Duality.derivedPushforward U.ι).obj E) := by
  refine Stacks.DerivedModel.derivedCategoryB_derivedPushforward_of_model U.ι.toLRSHom.toShHom
    (Scheme.Modules.hasDerivedCategory U.toScheme) (Scheme.Modules.hasDerivedCategory Y)
    (HasDerivedCategory.standard _) (HasDerivedCategory.standard _)
    (supportedModules U.toScheme.ringCatSheaf (Subtype.val ⁻¹' T))
    (supportedModules_isClosedUnderIsomorphisms _ _)
    (supportedModules Y.ringCatSheaf T) (supportedModules_isClosedUnderIsomorphisms _ _) ?_ E hE
  intro E₂ hE₂
  let := HasDerivedCategory.standard U.toScheme.Modules
  let := HasDerivedCategory.standard Y.Modules
  exact Stacks.DerivedQCoh.cohomologySupportedOn_derivedPushforward U T hT _
    ((Stacks.Duality.homotopyPushforward U.ι).totalRightDerivedUnit DerivedCategory.Qh
      (HomotopyCategory.quasiIso U.toScheme.Modules (ComplexShape.up ℤ))) E₂ hE₂

/-- **Restriction to a quasi-compact open is bijective against `D_{QCoh,T}` objects orthogonal to
a Koszul complex.** Let `Y` be affine, `O ⊆ Y` a quasi-compact open, `T ⊆ Y` closed with
`Y ∖ ((Y ∖ O) ∩ T)` quasi-compact. There is a perfect object `K` of `D(𝒪_Y)` supported on
`(Y ∖ O) ∩ T` such that for every `G` with quasi-coherent cohomology supported on `T` and with
`Hom(K[n], G) = 0` for all `n`, and for every object `A`, restriction
`Hom(A, G) ⟶ Hom(A|_O, G|_O)` is bijective. -/
theorem exists_isPerfect_bijective_restrict_of_isAffine (Y : Scheme.{u}) [IsAffine Y]
    (O : Y.Opens) (hO : IsCompact (O : Set Y)) (T : Set Y) (hT : IsClosed T)
    (hc : IsCompact ((O : Set Y)ᶜ ∩ T)ᶜ) :
    ∃ K : DerivedCategory Y.Modules,
      Stacks.Cohomology.PerfectComplexes.IsPerfect (X := Y.toRingedSpace) K ∧
      derivedSupported Y.ringCatSheaf ((O : Set Y)ᶜ ∩ T) K ∧
      ∀ G : DerivedCategory Y.Modules,
        DerivedCategoryB.derivedCategoryB (A := Y.Modules)
          (SheafOfModules.isQuasicoherent Y.ringCatSheaf) G →
        derivedSupported Y.ringCatSheaf T G → (∀ (n : ℤ) (g : K⟦n⟧ ⟶ G), g = 0) →
        ∀ A : DerivedCategory Y.Modules,
          Function.Bijective (fun x : A ⟶ G => (derivedRestrict O.ι).map x) := by
  obtain ⟨K, hKp, hKs, hKdet⟩ := exists_isPerfect_detecting_of_isAffine Y ((O : Set Y)ᶜ ∩ T)
    (O.isOpen.isClosed_compl.inter hT) hc
  refine ⟨K, hKp, hKs, fun G hGq hGs hG A => ?_⟩
  have : QuasiCompact O.ι := quasiCompact_opens_ι hO
  let adj := derivedRestrictPushforwardAdjunction O.ι
  obtain ⟨M, v, w, hTr⟩ := distinguished_cocone_triangle (adj.unit.app G)
  have hKO : IsZero ((derivedRestrict O.ι).obj K) :=
    isZero_derivedRestrict_of_derivedSupported O.ι _ (fun x hx => hx.1 x.2) K hKs
  have hMO : IsZero ((derivedRestrict O.ι).obj M) :=
    Triangle.isZero₃_of_isIso₁ _ ((derivedRestrict O.ι).map_distinguished _ hTr)
      (isIso_map_unit_of_isIso_counit adj G inferInstance)
  have hMs₁ : derivedSupported Y.ringCatSheaf (Set.range O.ι.base)ᶜ M :=
    derivedSupported_compl_range_of_isZero O.ι M hMO
  have hRs : derivedSupported Y.ringCatSheaf T ((Stacks.Duality.derivedPushforward O.ι).obj
      ((derivedRestrict O.ι).obj G)) :=
    derivedSupported_derivedPushforward O T hT _
      (derivedSupported_derivedRestrict O.ι T _ (fun _ hx => hx) G hGs)
  have hMs₂ : derivedSupported Y.ringCatSheaf T M :=
    ObjectProperty.ext_of_isTriangulatedClosed₃ (derivedSupported Y.ringCatSheaf T) _ hTr hGs hRs
  have hMs : derivedSupported Y.ringCatSheaf ((O : Set Y)ᶜ ∩ T) M := by
    intro n x hx
    by_cases hxO : x ∈ O
    · refine hMs₁ n x ?_
      rw [Scheme.Opens.range_ι]
      exact fun h => h hxO
    · exact hMs₂ n x fun h => hx ⟨hxO, h⟩
