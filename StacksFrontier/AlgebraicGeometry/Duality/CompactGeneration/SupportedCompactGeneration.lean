module

public import StacksFrontier.AlgebraicGeometry.Duality.CompactGeneration.QcqsCompactGeneration

/-!
# Compact objects supported away from a quasi-compact open detect the kernel of restriction

Let `X` be a quasi-compact quasi-separated scheme and `j : U ⟶ X` a quasi-compact open
immersion. The compact objects of `D_QCoh(𝒪_X)` which restrict to zero on `U` detect the kernel
of `j^* : D_QCoh(𝒪_X) ⥤ D_QCoh(𝒪_U)`: an object receiving no nonzero morphism from any shift of
any of them is `Rj_*` of its restriction. This is the content of [Stacks, Tag 0A9A] (the category
`D_{QCoh, X ∖ U}(𝒪_X)` is generated by compact objects) in the form consumed by the lifting
lemmas of `StacksFrontier/CategoryTheory/Triangulated/CompactLift.lean`.

The proof is the induction of [Stacks, Tag 0A9A] over the number of affine opens covering `X`,
organised in three moves: the affine case is [Stacks, Tag 09IR] (Koszul complexes); *excision*
transports detection from `C ⊆ A` to `B ⊆ A ∪ B` along a cover with overlap `C`, by glueing with
zero; and *transitivity* composes `U ⊆ W ⊆ X`, lifting compact objects from `W` to `X` up to a sum
with a shift ([Stacks, Tag 08EK]). For `X = X₁ ∪ V` with `V` affine and `U ⊆ X`, set
`W = U ∪ X₁`: then `W ⊆ X` is excision from the affine `V`, and `U ⊆ W` is excision from
`U ∩ X₁ ⊆ X₁`, which is the induction hypothesis.

## Main results

* `Stacks.Duality.SupportedGeneration.KernelDetected` — the property.
* `Stacks.Duality.SupportedGeneration.kernelDetected_of_excision` and
  `Stacks.Duality.SupportedGeneration.kernelDetected_comp` — excision and transitivity.
* `Stacks.Duality.SupportedGeneration.kernelDetected` — every quasi-compact open immersion into a
  quasi-compact quasi-separated scheme has the property.

No `@[stacks]` attribute: [Stacks, Tag 0A9A] asks for a single *perfect* generator, and the passage
from compact to perfect objects is [Stacks, Tag 09M1].
-/

-- This file uses the locally small derived-category models below, which are not
-- global instances (see `StacksFrontier.Homology.DerivedCategory.LocallySmall`):
-- `D(𝒪_X)` for a scheme.
attribute [local instance] AlgebraicGeometry.Scheme.Modules.hasDerivedCategory

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.ObjectProperty
open CategoryTheory.Pretriangulated ZeroObject

universe u

namespace Stacks.Duality.SupportedGeneration

open Stacks.Duality.OpenImmersion Stacks.Duality.QcqsGeneration

/-! ### A cover by two open subschemes -/

section TwoCover

variable {Y A B C : Scheme.{u}} (jA : A ⟶ Y) (jB : B ⟶ Y) (iA : C ⟶ A) (iB : C ⟶ B)
  [IsOpenImmersion jA] [IsOpenImmersion jB] [IsOpenImmersion iA] [IsOpenImmersion iB]

/-- Two open immersions covering `Y` jointly detect isomorphisms of `D(𝒪_Y)`. -/
theorem isIso_of_isIso_derivedRestrict_two {E F : DerivedCategory Y.Modules} (φ : E ⟶ F)
    (hA : IsIso ((derivedRestrict jA).map φ)) (hB : IsIso ((derivedRestrict jB).map φ))
    (hcov : ∀ y : Y, (∃ x, jA x = y) ∨ (∃ x, jB x = y)) : IsIso φ := by
  let Us : Bool → Scheme.{u} := fun b => cond b A B
  let js : ∀ b, Us b ⟶ Y := fun b => match b with
    | true => jA
    | false => jB
  have : ∀ b, IsOpenImmersion (js b) := fun b => by cases b <;> (dsimp [js]; infer_instance)
  refine isIso_of_isIso_derivedRestrict φ js (fun y => ?_) fun b => ?_
  · rcases hcov y with ⟨x, hx⟩ | ⟨x, hx⟩
    · exact ⟨true, x, hx⟩
    · exact ⟨false, x, hx⟩
  · cases b
    · exact hB
    · exact hA

/-- Two open immersions covering `Y` jointly detect the zero objects of `D(𝒪_Y)`. -/
theorem isZero_of_isZero_derivedRestrict_two {E : DerivedCategory Y.Modules}
    (hA : IsZero ((derivedRestrict jA).obj E)) (hB : IsZero ((derivedRestrict jB).obj E))
    (hcov : ∀ y : Y, (∃ x, jA x = y) ∨ (∃ x, jB x = y)) : IsZero E := by
  have : IsIso (0 : (0 : DerivedCategory Y.Modules) ⟶ E) :=
    isIso_of_isIso_derivedRestrict_two jA jB _
      (isIso_of_source_target_iso_zero _
        (((derivedRestrict jA).map_isZero (isZero_zero _)).isoZero) hA.isoZero)
      (isIso_of_source_target_iso_zero _
        (((derivedRestrict jB).map_isZero (isZero_zero _)).isoZero) hB.isoZero) hcov
  exact (isZero_zero _).of_iso (asIso (0 : (0 : DerivedCategory Y.Modules) ⟶ E)).symm

/-- An object of `D_QCoh` killed by `restrictedDerivedRestrict` is killed by `derivedRestrict`. -/
private theorem isZero_derivedRestrict_obj_of_isZero {X U : Scheme.{u}} (j : U ⟶ X)
    [IsOpenImmersion j] {N : Stacks.Duality.quasiCoherentDerivedCategory X}
    (h : IsZero ((restrictedDerivedRestrict j).obj N)) : IsZero ((derivedRestrict j).obj N.obj) :=
  (DerivedCategoryB.derivedCategoryB (A := U.Modules)
    (SheafOfModules.isQuasicoherent U.ringCatSheaf)).ι.map_isZero h

/-- An object whose unit is invertible and whose image under the left adjoint vanishes is zero. -/
private theorem isZero_of_isIso_unit_of_isZero {C D : Type*} [Category C] [Category D]
    [HasZeroMorphisms C] [HasZeroMorphisms D] {F : C ⥤ D} {G : D ⥤ C}
    [G.PreservesZeroMorphisms] (adj : F ⊣ G) {N : C} (hN : IsIso (adj.unit.app N))
    (h : IsZero (F.obj N)) : IsZero N :=
  (G.map_isZero h).of_iso (asIso (adj.unit.app N))

/-- If `P` is a retract of `L R`, a morphism from `P⟦n⟧` into `T` vanishes as soon as every
morphism `L (R⟦n⟧) ⟶ T` does. -/
private theorem eq_zero_of_retract_of_forall_eq_zero {C D : Type*} [Category C] [Category D]
    [HasShift C ℤ] [HasShift D ℤ] [Preadditive D] (L : C ⥤ D) [L.CommShift ℤ] {P T : D} {R : C}
    (s : P ⟶ L.obj R) (r : L.obj R ⟶ P) (hsr : s ≫ r = 𝟙 P) (n : ℤ)
    (h : ∀ k : L.obj (R⟦n⟧) ⟶ T, k = 0) (g : P⟦n⟧ ⟶ T) : g = 0 := by
  have : g = (shiftFunctor _ n).map s ≫ (L.commShiftIso n).inv.app R ≫
      ((L.commShiftIso n).hom.app R ≫ (shiftFunctor _ n).map r ≫ g) := by
    simp [← Functor.map_comp_assoc, hsr]
  rw [this, h ((L.commShiftIso n).hom.app R ≫ (shiftFunctor _ n).map r ≫ g), comp_zero,
    comp_zero]

variable [CompactSpace Y] [CompactSpace A] [CompactSpace B]
  [AlgebraicGeometry.QuasiCompact jA] [AlgebraicGeometry.QuasiCompact jB]
  [AlgebraicGeometry.QuasiCompact iA] [AlgebraicGeometry.QuasiCompact iB]
  (hsq : IsPullback iA iB jA jB) (hcov : ∀ y : Y, (∃ x, jA x = y) ∨ (∃ x, jB x = y))

omit [CompactSpace A] [CompactSpace B] [AlgebraicGeometry.QuasiCompact jB]
  [AlgebraicGeometry.QuasiCompact iA] [AlgebraicGeometry.QuasiCompact iB] in
include hsq hcov in
/-- **An object vanishing on one member of a cover by two opens comes from the other**: if
`N|_B = 0` then the unit `N ⟶ Rj_{A,*}(N|_A)` is invertible. It is so on `A` because `Rj_{A,*}` is
fully faithful, and on `B` both sides vanish, the target by base change to the overlap. -/
theorem isIso_unit_of_isZero_restrict_two (N : Stacks.Duality.quasiCoherentDerivedCategory Y)
    (hN : IsZero ((restrictedDerivedRestrict jB).obj N)) :
    IsIso ((restrictedDerivedRestrictAdjunction jA).unit.app N) := by
  rw [isIso_restrictedDerivedRestrictAdjunction_unit_app_iff]
  have hNB : IsZero ((derivedRestrict jB).obj N.obj) := isZero_derivedRestrict_obj_of_isZero jB hN
  refine isIso_of_isIso_derivedRestrict_two jA jB _ ?_ ?_ hcov
  · exact isIso_map_unit_of_isIso_counit (derivedRestrictPushforwardAdjunction jA) N.obj
      inferInstance
  · refine isIso_of_source_target_iso_zero _ hNB.isoZero ?_
    exact baseChangeIso jA iA jB iB hsq _ ≪≫
      ((Stacks.Duality.derivedPushforward iB).map_isZero
        (isZero_derivedRestrict_comp_of_isZero iA iB jA jB hsq.w hNB)).isoZero

/-! ### The kernel of restriction to a quasi-compact open is detected by compact objects -/

/-- **The compact objects killed by `j^*` detect the kernel of `j^*`.** There is a family of
compact objects of `D_QCoh(𝒪_X)`, each restricting to zero on `U`, such that an object receiving
no nonzero morphism from any shift of any of them has invertible unit `E ⟶ Rj_*(E|_U)`. This is the
hypothesis `hloc` of `CategoryTheory.Pretriangulated.exists_roof`. -/
def KernelDetected {X U : Scheme.{u}} (j : U ⟶ X) [IsOpenImmersion j]
    [AlgebraicGeometry.QuasiCompact j] [CompactSpace X] : Prop :=
  ∃ (ι : Type u) (K : ι → Stacks.Duality.quasiCoherentDerivedCategory X),
    (∀ i, IsCompactObject.{u} (K i)) ∧ (∀ i, IsZero ((restrictedDerivedRestrict j).obj (K i))) ∧
    ∀ E : Stacks.Duality.quasiCoherentDerivedCategory X,
      (∀ (i : ι) (n : ℤ) (g : (K i)⟦n⟧ ⟶ E), g = 0) →
        IsIso ((restrictedDerivedRestrictAdjunction j).unit.app E)

/-- A morphism from a shift of an object killed by `j^*` into an object in the image of `Rj_*`
vanishes. -/
theorem eq_zero_of_isZero_restrict {X U : Scheme.{u}} (j : U ⟶ X) [IsOpenImmersion j]
    [AlgebraicGeometry.QuasiCompact j] [CompactSpace X]
    {K : Stacks.Duality.quasiCoherentDerivedCategory X}
    (hK : IsZero ((restrictedDerivedRestrict j).obj K)) (n : ℤ)
    (M : Stacks.Duality.quasiCoherentDerivedCategory U)
    (g : K⟦n⟧ ⟶ (Stacks.Duality.quasiCoherentDerivedPushforward j
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs j)).obj M) : g = 0 :=
  (Stacks.DerivedTruncation.subsingleton_hom_rightAdjoint_obj_of_isZero
    (restrictedDerivedRestrictAdjunction j) (isZero_map_shift_of_isZero_map hK n) M).allEq g 0

/-- Restriction along a composite of open immersions kills an object exactly when restriction
along the two in turn does. -/
theorem isZero_derivedRestrict_comp_iff {W₀ U₀ Y : Scheme.{u}} (a : W₀ ⟶ U₀) (p : U₀ ⟶ Y)
    [IsOpenImmersion a] [IsOpenImmersion p] (E : DerivedCategory Y.Modules) :
    IsZero ((derivedRestrict (a ≫ p)).obj E) ↔
      IsZero ((derivedRestrict a).obj ((derivedRestrict p).obj E)) := by
  simp only [DerivedCategory.isZero_iff_forall_isZero_homology]
  refine forall_congr' fun n => ?_
  have e : (DerivedCategory.homologyFunctor W₀.Modules n).obj ((derivedRestrict (a ≫ p)).obj E) ≅
      (DerivedCategory.homologyFunctor W₀.Modules n).obj
        ((derivedRestrict a).obj ((derivedRestrict p).obj E)) :=
    ((Scheme.Modules.restrictFunctor (a ≫ p)).mapDerivedCategoryHomologyIso n).app E ≪≫
      (Scheme.Modules.restrictFunctorComp a p).app _ ≪≫
      (Scheme.Modules.restrictFunctor a).mapIso
        (((Scheme.Modules.restrictFunctor p).mapDerivedCategoryHomologyIso n).app E).symm ≪≫
      (((Scheme.Modules.restrictFunctor a).mapDerivedCategoryHomologyIso n).app _).symm
  exact ⟨fun h => h.of_iso e.symm, fun h => h.of_iso e⟩

/-- `restrictedDerivedRestrict` along a composite of open immersions kills an object exactly when
restriction along the two in turn does. -/
theorem isZero_restrictedDerivedRestrict_comp_iff {W₀ U₀ Y : Scheme.{u}} (a : W₀ ⟶ U₀)
    (p : U₀ ⟶ Y) [IsOpenImmersion a] [IsOpenImmersion p]
    (E : Stacks.Duality.quasiCoherentDerivedCategory Y) :
    IsZero ((restrictedDerivedRestrict (a ≫ p)).obj E) ↔
      IsZero ((restrictedDerivedRestrict a).obj ((restrictedDerivedRestrict p).obj E)) :=
  ⟨fun h => isZero_fullSubcategory_of_isZero_obj ((isZero_derivedRestrict_comp_iff a p E.obj).1
      (isZero_derivedRestrict_obj_of_isZero _ h)),
    fun h => isZero_fullSubcategory_of_isZero_obj ((isZero_derivedRestrict_comp_iff a p E.obj).2
      (isZero_derivedRestrict_obj_of_isZero _ h))⟩

end TwoCover

section Excision

variable {Y A B C : Scheme.{u}} (jA : A ⟶ Y) (jB : B ⟶ Y) (iA : C ⟶ A) (iB : C ⟶ B)
  [IsOpenImmersion jA] [IsOpenImmersion jB] [IsOpenImmersion iA] [IsOpenImmersion iB]
  [CompactSpace Y] [CompactSpace A] [CompactSpace B]
  [AlgebraicGeometry.QuasiCompact jA] [AlgebraicGeometry.QuasiCompact jB]
  [AlgebraicGeometry.QuasiCompact iA] [AlgebraicGeometry.QuasiCompact iB]
  (hsq : IsPullback iA iB jA jB) (hcov : ∀ y : Y, (∃ x, jA x = y) ∨ (∃ x, jB x = y))

include hsq hcov in
/-- **Excision.** Let `Y = A ∪ B` be a cover by two quasi-compact opens with overlap `C`. If the
kernel of restriction from `A` to `C` is detected by compact objects, so is the kernel of
restriction from `Y` to `B`: a compact object `P` of `D_QCoh(𝒪_A)` killed on `C` glues with `0` on
`B` to a compact object of `D_QCoh(𝒪_Y)` killed on `B`. -/
theorem kernelDetected_of_excision (h : KernelDetected iA) : KernelDetected jB := by
  obtain ⟨ι, P, hPc, hP0, hPdet⟩ := h
  let adjA := restrictedDerivedRestrictAdjunction jA
  let adjB := restrictedDerivedRestrictAdjunction jB
  let adjA' := restrictedDerivedRestrictAdjunction iA
  let adjB' := restrictedDerivedRestrictAdjunction iB
  let : (Stacks.Duality.quasiCoherentDerivedPushforward jA
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jA)).CommShift ℤ :=
    adjA.rightAdjointCommShift ℤ
  let : adjA.CommShift ℤ := adjA.commShift_of_leftAdjoint ℤ
  let : (Stacks.Duality.quasiCoherentDerivedPushforward jB
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jB)).CommShift ℤ :=
    adjB.rightAdjointCommShift ℤ
  let : adjB.CommShift ℤ := adjB.commShift_of_leftAdjoint ℤ
  let : adjB.IsTriangulated := Adjunction.IsTriangulated.mk' adjB
  have := adjB.isTriangulated_rightAdjoint
  have : (Stacks.Duality.quasiCoherentDerivedPushforward jA
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jA)).Additive :=
    adjA.right_adjoint_additive
  have : (Stacks.Duality.quasiCoherentDerivedPushforward jB
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jB)).Additive :=
    adjB.right_adjoint_additive
  have : (Stacks.Duality.quasiCoherentDerivedPushforward iA
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs iA)).Additive :=
    adjA'.right_adjoint_additive
  have : ∀ α : Type u, PreservesColimitsOfShape (Discrete α)
      (Stacks.Duality.quasiCoherentDerivedPushforward jA
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jA)) :=
    preservesColimitsOfShape_discrete_restrictedDerivedPushforward jA
  have : ∀ α : Type u, PreservesColimitsOfShape (Discrete α)
      (Stacks.Duality.quasiCoherentDerivedPushforward jB
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jB)) :=
    preservesColimitsOfShape_discrete_restrictedDerivedPushforward jB
  let βBA : ∀ A' : Stacks.Duality.quasiCoherentDerivedCategory A,
      (restrictedDerivedRestrict jB).obj ((Stacks.Duality.quasiCoherentDerivedPushforward jA
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jA)).obj A') ≅
      (Stacks.Duality.quasiCoherentDerivedPushforward iB
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs iB)).obj
          ((restrictedDerivedRestrict iA).obj A') := fun A' =>
    (DerivedCategoryB.derivedCategoryB (A := B.Modules)
      (SheafOfModules.isQuasicoherent B.ringCatSheaf)).fullyFaithfulι.preimageIso
      (baseChangeIso jA iA jB iB hsq A'.obj)
  let βAB : ∀ B' : Stacks.Duality.quasiCoherentDerivedCategory B,
      (restrictedDerivedRestrict jA).obj ((Stacks.Duality.quasiCoherentDerivedPushforward jB
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jB)).obj B') ≅
      (Stacks.Duality.quasiCoherentDerivedPushforward iA
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs iA)).obj
          ((restrictedDerivedRestrict iB).obj B') := fun B' =>
    (DerivedCategoryB.derivedCategoryB (A := A.Modules)
      (SheafOfModules.isQuasicoherent A.ringCatSheaf)).fullyFaithfulι.preimageIso
      (baseChangeIso jB iB jA iA hsq.flip B'.obj)
  have hker : ∀ N : Stacks.Duality.quasiCoherentDerivedCategory Y,
      IsZero ((restrictedDerivedRestrict jB).obj N) → IsIso (adjA.unit.app N) :=
    fun N hN => isIso_unit_of_isZero_restrict_two jA jB iA iB hsq hcov N hN
  choose R hRA hRB using fun i => exists_glue adjA adjB adjB' βBA βAB (P i) 0
    ((hP0 i).iso ((restrictedDerivedRestrict iB).map_isZero (isZero_zero _)))
  have hR0 : ∀ i, IsZero ((restrictedDerivedRestrict jB).obj (R i)) := fun i =>
    (isZero_zero _).of_iso (hRB i).some
  refine ⟨ι, R, fun i => ?_, hR0, fun E hE => ?_⟩
  · exact isCompactObject_of_isCompactObject_restrict adjA adjB hker (R i)
      (isCompactObject_of_iso (hRA i).some (hPc i))
      (isCompactObject_of_iso (hRB i).some
        (isCompactObject_zero' (T := Stacks.Duality.quasiCoherentDerivedCategory B)))
  · obtain ⟨Cn, π, δ, hT⟩ := distinguished_cocone_triangle (adjB.unit.app E)
    have hCB : IsZero ((restrictedDerivedRestrict jB).obj Cn) :=
      Triangle.isZero₃_of_isIso₁ _ ((restrictedDerivedRestrict jB).map_distinguished _ hT)
        (isIso_map_unit_of_isIso_counit adjB E inferInstance)
    have hCA : IsIso (adjA.unit.app Cn) := hker Cn hCB
    -- `Cn` is right orthogonal to the shifts of the `R i`
    have hEo : ((ofObj R).shiftClosure ℤ).rightOrthogonal E := by
      rwa [rightOrthogonal_shiftClosure_ofObj_iff]
    have hMo : ((ofObj R).shiftClosure ℤ).rightOrthogonal
        ((Stacks.Duality.quasiCoherentDerivedPushforward jB
          (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs jB)).obj
            ((restrictedDerivedRestrict jB).obj E)) := by
      rw [rightOrthogonal_shiftClosure_ofObj_iff]
      intro i n g
      exact eq_zero_of_isZero_restrict jB (hR0 i) n _ g
    have hCo : ((ofObj R).shiftClosure ℤ).rightOrthogonal Cn :=
      ObjectProperty.ext_of_isTriangulatedClosed₃ _ _ hT hEo hMo
    rw [rightOrthogonal_shiftClosure_ofObj_iff] at hCo
    -- so `Cn|_A` is right orthogonal to the shifts of the `P i`
    have hCAo : ∀ (i : ι) (n : ℤ) (g : (P i)⟦n⟧ ⟶ (restrictedDerivedRestrict jA).obj Cn),
        g = 0 := by
      intro i n g
      obtain ⟨e⟩ := hRA i
      exact eq_zero_of_retract_of_forall_eq_zero (restrictedDerivedRestrict jA) e.inv e.hom
        e.inv_hom_id n (eq_zero_of_isIso_unit adjA hCA (fun g' => hCo i n g')) g
    have hCA' : IsIso (adjA'.unit.app ((restrictedDerivedRestrict jA).obj Cn)) := hPdet _ hCAo
    have hCC : IsZero
        ((restrictedDerivedRestrict iA).obj ((restrictedDerivedRestrict jA).obj Cn)) :=
      isZero_fullSubcategory_of_isZero_obj
        (isZero_derivedRestrict_comp_of_isZero iA iB jA jB hsq.w
          (isZero_derivedRestrict_obj_of_isZero jB hCB))
    have hCA0 : IsZero ((restrictedDerivedRestrict jA).obj Cn) :=
      isZero_of_isIso_unit_of_isZero adjA' hCA' hCC
    exact (Triangle.isZero₃_iff_isIso₁ _ hT).1 (isZero_of_isIso_unit_of_isZero adjA hCA hCA0)

end Excision

/-! ### Transitivity -/

section Transitivity

variable {Y W U : Scheme.{u}} (j : W ⟶ Y) (i : U ⟶ W) [IsOpenImmersion j] [IsOpenImmersion i]
  [CompactSpace Y] [QuasiSeparatedSpace Y] [CompactSpace W]
  [AlgebraicGeometry.QuasiCompact j] [AlgebraicGeometry.QuasiCompact i]

/-- **Transitivity.** For quasi-compact open immersions `U ⟶ W ⟶ Y` into a quasi-compact
quasi-separated scheme, if the kernels of restriction from `Y` to `W` and from `W` to `U` are
detected by compact objects, so is the kernel of restriction from `Y` to `U`. A compact object `P`
of `D_QCoh(𝒪_W)` killed on `U` lifts to a compact object of `D_QCoh(𝒪_Y)` restricting to
`P ⊕ P[1]` ([Stacks, Tag 08EK] in the form of
`CategoryTheory.Pretriangulated.exists_isCompactObject_iso_biprod_shift`), which is killed on `U`;
together with the objects detecting the first kernel these detect the composite. -/
theorem kernelDetected_comp (hj : KernelDetected j) (hi : KernelDetected i) :
    KernelDetected (i ≫ j) := by
  obtain ⟨ι₁, K, hKc, hK0, hKdet⟩ := hj
  obtain ⟨ι₂, P, hPc, hP0, hPdet⟩ := hi
  let adjj := restrictedDerivedRestrictAdjunction j
  let adji := restrictedDerivedRestrictAdjunction i
  let adjc := restrictedDerivedRestrictAdjunction (i ≫ j)
  have : (Stacks.Duality.quasiCoherentDerivedPushforward j
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs j)).Additive :=
    adjj.right_adjoint_additive
  have : (Stacks.Duality.quasiCoherentDerivedPushforward i
      (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs i)).Additive :=
    adji.right_adjoint_additive
  have : ∀ α : Type u, PreservesColimitsOfShape (Discrete α)
      (Stacks.Duality.quasiCoherentDerivedPushforward j
        (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs j)) :=
    preservesColimitsOfShape_discrete_restrictedDerivedPushforward j
  obtain ⟨ι₀, G, hGc, hGgen⟩ :=
    Stacks.Duality.QcqsGeneration.isCompactlyGenerated_quasiCoherentDerivedCategory Y
  let G' : Option ι₀ → Stacks.Duality.quasiCoherentDerivedCategory Y := fun o => o.elim 0 G
  have hG'c : ∀ o, IsCompactObject.{u} (G' o) := fun o => by
    cases o with
    | none => exact isCompactObject_zero' (T := Stacks.Duality.quasiCoherentDerivedCategory Y)
    | some k => exact hGc k
  have hG'gen : (ofObj G').IsWeakTriangulatedGenerator := by
    intro E hE
    refine hGgen E ?_
    rw [rightOrthogonal_shiftClosure_ofObj_iff] at hE ⊢
    exact fun k n g => hE (some k) n g
  choose c hcc hcP using fun k => exists_isCompactObject_iso_biprod_shift adjj K hKc hK0
    hKdet G' hG'c hG'gen (P k) (hPc k)
  have hc0 : ∀ k, IsZero ((restrictedDerivedRestrict (i ≫ j)).obj (c k)) := fun k => by
    rw [isZero_restrictedDerivedRestrict_comp_iff]
    refine IsZero.of_iso ?_ ((restrictedDerivedRestrict i).mapIso (hcP k).some)
    have : PreservesBinaryBiproducts (restrictedDerivedRestrict i) :=
      have := adji.leftAdjoint_preservesColimits
      preservesBinaryBiproducts_of_preservesBinaryCoproducts _
    refine IsZero.of_iso ?_ ((restrictedDerivedRestrict i).mapBiprod _ _)
    exact (biprod_isZero_iff _ _).2 ⟨hP0 k, isZero_map_shift_of_isZero_map (hP0 k) 1⟩
  have hK0' : ∀ k, IsZero ((restrictedDerivedRestrict (i ≫ j)).obj (K k)) := fun k => by
    rw [isZero_restrictedDerivedRestrict_comp_iff]
    exact (restrictedDerivedRestrict i).map_isZero (hK0 k)
  let F : ι₁ ⊕ ι₂ → Stacks.Duality.quasiCoherentDerivedCategory Y := Sum.elim K c
  refine ⟨ι₁ ⊕ ι₂, F, fun k => ?_, fun k => ?_, fun E hE => ?_⟩
  · cases k with
    | inl k => exact hKc k
    | inr k => exact hcc k
  · cases k with
    | inl k => exact hK0' k
    | inr k => exact hc0 k
  · obtain ⟨Cn, π, δ, hT⟩ := distinguished_cocone_triangle (adjc.unit.app E)
    have hCc : IsZero ((restrictedDerivedRestrict (i ≫ j)).obj Cn) :=
      Triangle.isZero₃_of_isIso₁ _ ((restrictedDerivedRestrict (i ≫ j)).map_distinguished _ hT)
        (isIso_map_unit_of_isIso_counit adjc E inferInstance)
    have hEo : ((ofObj F).shiftClosure ℤ).rightOrthogonal E := by
      rwa [rightOrthogonal_shiftClosure_ofObj_iff]
    have hMo : ((ofObj F).shiftClosure ℤ).rightOrthogonal
        ((Stacks.Duality.quasiCoherentDerivedPushforward (i ≫ j)
          (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs (i ≫ j))).obj
            ((restrictedDerivedRestrict (i ≫ j)).obj E)) := by
      rw [rightOrthogonal_shiftClosure_ofObj_iff]
      intro k n g
      cases k with
      | inl k => exact eq_zero_of_isZero_restrict (i ≫ j) (hK0' k) n _ g
      | inr k => exact eq_zero_of_isZero_restrict (i ≫ j) (hc0 k) n _ g
    have hCo : ((ofObj F).shiftClosure ℤ).rightOrthogonal Cn :=
      ObjectProperty.ext_of_isTriangulatedClosed₃ _ _ hT hEo hMo
    rw [rightOrthogonal_shiftClosure_ofObj_iff] at hCo
    have hCj : IsIso (adjj.unit.app Cn) := hKdet Cn fun k n g => hCo (Sum.inl k) n g
    have hCPo : ∀ (k : ι₂) (n : ℤ) (g : (P k)⟦n⟧ ⟶ (restrictedDerivedRestrict j).obj Cn),
        g = 0 := by
      intro k n g
      obtain ⟨e⟩ := hcP k
      exact eq_zero_of_retract_of_forall_eq_zero (restrictedDerivedRestrict j)
        (biprod.inl ≫ e.inv) (e.hom ≫ biprod.fst) (by simp) n
        (eq_zero_of_isIso_unit adjj hCj (fun g' => hCo (Sum.inr k) n g')) g
    have hCi : IsIso (adji.unit.app ((restrictedDerivedRestrict j).obj Cn)) := hPdet _ hCPo
    have hCU : IsZero ((restrictedDerivedRestrict i).obj ((restrictedDerivedRestrict j).obj Cn)) :=
      (isZero_restrictedDerivedRestrict_comp_iff i j Cn).1 hCc
    have hCW : IsZero ((restrictedDerivedRestrict j).obj Cn) :=
      isZero_of_isIso_unit_of_isZero adji hCi hCU
    exact (Triangle.isZero₃_iff_isIso₁ _ hT).1 (isZero_of_isIso_unit_of_isZero adjj hCj hCW)

end Transitivity

/-! ### Three base cases -/

section Base

/-- `Stacks.Duality.SupportedGeneration.KernelDetected` depends on the open immersion only up to
equality. -/
theorem kernelDetected_congr {X U : Scheme.{u}} {j j' : U ⟶ X} [IsOpenImmersion j]
    [IsOpenImmersion j'] [AlgebraicGeometry.QuasiCompact j] [AlgebraicGeometry.QuasiCompact j']
    [CompactSpace X] (h : KernelDetected j) (e : j = j') : KernelDetected j' :=
  e ▸ h

/-- `Stacks.Duality.SupportedGeneration.KernelDetected` for the inclusion of an open depends on the
open only up to equality. -/
theorem kernelDetected_opens_congr {X : Scheme.{u}} [CompactSpace X] {S S' : X.Opens}
    [AlgebraicGeometry.QuasiCompact S.ι] [AlgebraicGeometry.QuasiCompact S'.ι]
    (h : KernelDetected S.ι) (e : S = S') : KernelDetected S'.ι :=
  e ▸ h

/-- **The affine case** ([Stacks, Tag 09IR]): on `Spec A` the kernel of restriction to
`D(f₁) ∪ … ∪ D(f_r)` is detected by the Koszul complex on the `fᵢ`. -/
theorem kernelDetected_openComplement {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    KernelDetected (Stacks.Koszul.Truncation.openComplement f).ι :=
  ⟨PUnit, fun _ => koszulQC f, fun _ => isCompactObject_koszulQC f,
    fun _ => isZero_restrictedDerivedRestrict_koszulQC f,
    fun E hE => isIso_unit_of_forall_hom_koszulQC_eq_zero f E fun n g => hE PUnit.unit n g⟩

/-- **The affine case for an arbitrary quasi-compact open** of an affine scheme `Spec A`: it is a
finite union of basic opens. -/
theorem kernelDetected_of_isAffine {A : Type u} [CommRing A] (S : (Spec (CommRingCat.of A)).Opens)
    (hS : IsCompact (S : Set (Spec (CommRingCat.of A)))) [AlgebraicGeometry.QuasiCompact S.ι] :
    KernelDetected S.ι := by
  obtain ⟨s, hs⟩ := Stacks.AlgebraicGeometry.InductionPrinciple.exists_finset_basicOpen_of_isCompact
    (isAffineOpen_top (Spec (CommRingCat.of A))) hS le_top
  let e := s.equivFin
  let f : Fin s.card → A := fun i => (Scheme.ΓSpecIso (CommRingCat.of A)).hom (e.symm i)
  have hW : Stacks.Koszul.Truncation.openComplement f = S := by
    rw [hs]
    refine le_antisymm (iSup_le fun i => ?_) (iSup₂_le fun g hg => ?_)
    · refine le_trans (le_of_eq ?_)
        (le_iSup₂ (f := fun g _ => (Spec (CommRingCat.of A)).basicOpen g) (e.symm i).1 (e.symm i).2)
      congr 1
      simp [f]
    · refine le_trans (le_of_eq ?_) (le_iSup _ (e ⟨g, hg⟩))
      congr 1
      simp [f]
  exact kernelDetected_opens_congr (kernelDetected_openComplement f) hW

/-- **A surjective open immersion**: its kernel is zero, detected by the empty family. -/
theorem kernelDetected_of_surjective {X U : Scheme.{u}} (j : U ⟶ X) [IsOpenImmersion j]
    [AlgebraicGeometry.QuasiCompact j] [CompactSpace X] (hj : ∀ x : X, ∃ y, j y = x) :
    KernelDetected j := by
  refine ⟨PEmpty, PEmpty.elim, fun k => k.elim, fun k => k.elim, fun E _ => ?_⟩
  rw [isIso_restrictedDerivedRestrictAdjunction_unit_app_iff]
  exact isIso_of_isIso_derivedRestrict _ (fun _ : PUnit.{u + 1} => j)
    (fun x => ⟨PUnit.unit, hj x⟩) fun _ =>
      isIso_map_unit_of_isIso_counit (derivedRestrictPushforwardAdjunction j) E.obj inferInstance

end Base

/-! ### The induction -/

section Induction

/-- **The induction step**: if a quasi-compact open `W ⊆ X` and an affine open `V` cover `X`, the
kernel of restriction to `W` is detected by compact objects. This is excision from the affine case
on `V`. -/
theorem kernelDetected_of_sup_affine {X : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X]
    (W : X.Opens) (hW : IsCompact (W : Set X)) {V : X.Opens} (hV : IsAffineOpen V)
    (hcov : ∀ x : X, x ∈ W ∨ x ∈ V) :
    haveI : CompactSpace W.toScheme := isCompact_iff_compactSpace.mp hW
    KernelDetected W.ι := by
  have : CompactSpace W.toScheme := isCompact_iff_compactSpace.mp hW
  let jV := hV.fromSpec
  have hC : IsCompact ((jV ⁻¹ᵁ W : (Spec Γ(X, V)).Opens) : Set (Spec Γ(X, V))) :=
    jV.isCompact_preimage hW
  have : CompactSpace (jV ⁻¹ᵁ W).toScheme := isCompact_iff_compactSpace.mp hC
  refine kernelDetected_of_excision jV W.ι (jV ⁻¹ᵁ W).ι (jV ∣_ W)
    (isPullback_morphismRestrict jV W).flip (fun x => ?_)
    (kernelDetected_of_isAffine (A := Γ(X, V)) (jV ⁻¹ᵁ W) hC)
  rcases hcov x with h | h
  · exact Or.inr ⟨⟨x, h⟩, rfl⟩
  · exact Or.inl (show x ∈ Set.range jV by rwa [hV.range_fromSpec])

/-- **The kernel of restriction along a quasi-compact open immersion is detected by compact
objects**, for a quasi-compact quasi-separated scheme whose complement of the image is covered by
`m` affine opens; by induction on `m`. -/
theorem kernelDetected_of_affineCover : ∀ (m : ℕ) {X U : Scheme.{u}} [CompactSpace X]
    [QuasiSeparatedSpace X] (j : U ⟶ X) [IsOpenImmersion j] [AlgebraicGeometry.QuasiCompact j]
    (V : Fin m → X.Opens), (∀ i, IsAffineOpen (V i)) →
    (∀ x : X, (∃ y, j y = x) ∨ ∃ i, x ∈ V i) → KernelDetected j
  | 0, X, U, _, _, j, _, _, V, _, hcov =>
      kernelDetected_of_surjective j fun x => (hcov x).resolve_right fun ⟨i, _⟩ => i.elim0
  | m + 1, X, U, _, _, j, _, _, V, hV, hcov => by
      have : CompactSpace U := QuasiCompact.compactSpace_of_compactSpace j
      let W : X.Opens := j.opensRange ⊔ ⨆ i : Fin m, V i.castSucc
      have hWc : IsCompact (W : Set X) := by
        refine IsCompact.union (isCompact_range j.continuous) ?_
        rw [TopologicalSpace.Opens.coe_iSup]
        exact isCompact_iUnion fun i => (hV _).isCompact
      have : CompactSpace W.toScheme := isCompact_iff_compactSpace.mp hWc
      have : QuasiSeparatedSpace W.toScheme := W.ι.isOpenEmbedding.quasiSeparatedSpace
      have hjW : Set.range j ⊆ Set.range W.ι := by
        rw [Scheme.Opens.range_ι]
        exact fun x hx => Or.inl hx
      let i := IsOpenImmersion.lift W.ι j hjW
      have hfac : i ≫ W.ι = j := IsOpenImmersion.lift_fac _ _ _
      have hW : KernelDetected W.ι := kernelDetected_of_sup_affine W hWc (hV (Fin.last m))
        fun x => by
          rcases hcov x with h | ⟨k, hk⟩
          · exact Or.inl (Or.inl h)
          · refine Fin.lastCases (motive := fun k => x ∈ V k → x ∈ W ∨ x ∈ V (Fin.last m))
              (fun h => Or.inr h) (fun k h => Or.inl ?_) k hk
            exact Or.inr (TopologicalSpace.Opens.mem_iSup.mpr ⟨k, h⟩)
      have hi : KernelDetected i := kernelDetected_of_affineCover m i
        (fun k => W.ι ⁻¹ᵁ V k.castSucc)
        (fun k => (hV k.castSucc).preimage_of_isOpenImmersion W.ι (by
          rw [Scheme.Opens.opensRange_ι]
          exact le_sup_of_le_right (le_iSup (fun k : Fin m => V k.castSucc) k)))
        (fun x => by
          rcases x.2 with ⟨y, hy⟩ | h
          · refine Or.inl ⟨y, W.ι.isOpenEmbedding.injective ?_⟩
            rwa [← Scheme.Hom.comp_apply, hfac]
          · obtain ⟨k, hk⟩ := TopologicalSpace.Opens.mem_iSup.mp h
            exact Or.inr ⟨k, hk⟩)
      exact kernelDetected_congr (kernelDetected_comp W.ι i hW hi) hfac

/-- **The kernel of restriction to a quasi-compact open is detected by compact objects**: for a
quasi-compact open immersion `j : U ⟶ X` into a quasi-compact quasi-separated scheme, there is a
family of compact objects of `D_QCoh(𝒪_X)` restricting to zero on `U` such that an object right
orthogonal to all their shifts is `Rj_*` of its restriction to `U`. With [Stacks, Tag 09M1] this is
[Stacks, Tag 0A9A]: `D_{QCoh, X ∖ U}(𝒪_X)` is generated by compact objects. -/
theorem kernelDetected {X U : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X] (j : U ⟶ X)
    [IsOpenImmersion j] [AlgebraicGeometry.QuasiCompact j] : KernelDetected j := by
  obtain ⟨s, hs, hX⟩ := (isCompact_iff_finite_and_eq_biUnion_affineOpens
    (U := (⊤ : X.Opens))).mp (by simpa using isCompact_univ)
  let t := hs.toFinset
  let e := t.equivFin
  refine kernelDetected_of_affineCover t.card j (fun k => ((e.symm k).1 : X.Opens))
    (fun k => (e.symm k).1.2) fun x => Or.inr ?_
  have hx : x ∈ (⊤ : X.Opens) := trivial
  simp only [hX, TopologicalSpace.Opens.mem_iSup] at hx
  obtain ⟨W, hW, hx⟩ := hx
  exact ⟨e ⟨W, hs.mem_toFinset.mpr hW⟩, by simpa using hx⟩

end Induction

/-! ### Consequences -/

section Consequences

variable {X U : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X] (j : U ⟶ X)
  [IsOpenImmersion j] [AlgebraicGeometry.QuasiCompact j]

/-- **A morphism from a compact object into an object killed on `U` dies on a compact
neighbourhood of `X ∖ U`.** For `c` compact in `D_QCoh(𝒪_X)`, `K` with `K|_U = 0` and `α : c ⟶ K`,
there is a distinguished triangle `I ⟶ c ⟶ Z ⟶ I[1]` with `Z` compact, `Z|_U = 0` (so that
`I|_U ⟶ c|_U` is invertible) and `I ⟶ c ⟶ K` zero. This is the core of the proof of
[Stacks, Tag 0A9C]: `α` factors through a compact object killed on `U` (Neeman's factorization,
`CategoryTheory.Pretriangulated.exists_fac_triangEnvelope_of_localizingClosure`), because `K` lies
in the localizing subcategory generated by such objects. -/
theorem exists_distTriang_comp_eq_zero {c K : Stacks.Duality.quasiCoherentDerivedCategory X}
    [IsCompactObject.{u} c] (hK : IsZero ((restrictedDerivedRestrict j).obj K)) (α : c ⟶ K) :
    ∃ (I Z : Stacks.Duality.quasiCoherentDerivedCategory X) (u : I ⟶ c) (v : c ⟶ Z)
      (w : Z ⟶ I⟦(1 : ℤ)⟧), Triangle.mk u v w ∈ distTriang _ ∧ IsCompactObject.{u} Z ∧
        IsZero ((restrictedDerivedRestrict j).obj Z) ∧ u ≫ α = 0 := by
  obtain ⟨ι, K₀, hKc, hK0, hKdet⟩ := kernelDetected j
  let adj := restrictedDerivedRestrictAdjunction j
  have := hKc
  have hN := localizingClosure_of_isZero adj K₀ hKc hK0 hKdet hK
  obtain ⟨σ, Z, hZ, a, b, hab⟩ := exists_fac_triangEnvelope_of_localizingClosure K₀ hN α
  obtain ⟨hiso, htri, -, -⟩ :=
   isClosedUnderIsomorphisms_isTriangulated_isSaturated_and_isIdempotentComplete_isCompactObject.{u}
      (D := Stacks.Duality.quasiCoherentDerivedCategory X)
  have hZc : IsCompactObject.{u} Z := by
    have hret : ObjectProperty.IsStableUnderRetracts
        (IsCompactObject.{u, _, _} (C := Stacks.Duality.quasiCoherentDerivedCategory X)) :=
      ⟨fun r hB => isCompactObject_of_retract hB r.i r.r r.retract⟩
    have hle : (ObjectProperty.singleton (∐ fun i : σ ↦ K₀ i)).triangEnvelope ≤
        IsCompactObject.{u, _, _} (C := Stacks.Duality.quasiCoherentDerivedCategory X) := by
      rw [triangEnvelope_le_iff, singleton_le_iff]
      exact isCompactObject_sigma (fun i : σ ↦ K₀ i) (fun _ => inferInstance)
    exact hle _ hZ
  obtain ⟨hk₁, hk₂, hk₃⟩ := kerProp_isTriangulated (L := restrictedDerivedRestrict j)
  have hZj : IsZero ((restrictedDerivedRestrict j).obj Z) := by
    have hle : (ObjectProperty.singleton (∐ fun i : σ ↦ K₀ i)).triangEnvelope ≤
        kerProp (restrictedDerivedRestrict j) := by
      rw [triangEnvelope_le_iff, singleton_le_iff]
      have := adj.leftAdjoint_preservesColimits
      change IsZero ((restrictedDerivedRestrict j).obj _)
      refine IsZero.of_iso ?_ (PreservesCoproduct.iso (restrictedDerivedRestrict j) _)
      rw [IsZero.iff_id_eq_zero]
      refine Sigma.hom_ext _ _ fun i => ?_
      simp only [Category.comp_id, comp_zero]
      exact (hK0 i.1).eq_of_src _ _
    exact hle _ hZ
  obtain ⟨I, u, w, hT⟩ := distinguished_cocone_triangle₁ a
  refine ⟨I, Z, u, a, w, hT, hZc, hZj, ?_⟩
  rw [← hab, ← Category.assoc, show u ≫ a = 0 from comp_distTriang_mor_zero₁₂ _ hT, zero_comp]

/-- **An object vanishes on `U` as soon as every morphism into it from a compact object does.**
The restrictions of compact generators of `D_QCoh(𝒪_X)` generate `D_QCoh(𝒪_U)`, `Rj_*` being
conservative, and every morphism `j^* c ⟶ j^* E` with `c` compact is `j^* g ∘ (j^* s)⁻¹` for a
morphism `g : c' ⟶ E` out of a compact object (`CategoryTheory.Pretriangulated.exists_roof`). -/
theorem isZero_restrict_of_forall_isCompactObject
    (E : Stacks.Duality.quasiCoherentDerivedCategory X)
    (h : ∀ c : Stacks.Duality.quasiCoherentDerivedCategory X, IsCompactObject.{u} c →
      ∀ g : c ⟶ E, (restrictedDerivedRestrict j).map g = 0) :
    IsZero ((restrictedDerivedRestrict j).obj E) := by
  obtain ⟨ι, K₀, hKc, hK0, hKdet⟩ := kernelDetected j
  obtain ⟨ι₀, G, hGc, hGgen⟩ :=
    Stacks.Duality.QcqsGeneration.isCompactlyGenerated_quasiCoherentDerivedCategory X
  let adj := restrictedDerivedRestrictAdjunction j
  refine Stacks.Duality.OpenImmersion.isZero_of_isZero_quasiCoherentDerivedPushforward j
    (Stacks.Duality.isQuasicoherent_homology_derivedPushforward_of_qcqs j) _ (hGgen _ ?_)
  rw [rightOrthogonal_shiftClosure_ofObj_iff]
  intro k n g'
  have : IsCompactObject.{u} ((G k)⟦n⟧) := isCompactObject_shift (hGc k) n
  obtain ⟨c, s, g'', hc, hs, hfac⟩ := exists_roof adj K₀ hKc hK0 hKdet
    ((adj.homEquiv _ _).symm g')
  have h0 : (adj.homEquiv _ _).symm g' = 0 := by
    rw [h c hc g''] at hfac
    rw [← cancel_epi ((restrictedDerivedRestrict j).map s), ← hfac, comp_zero]
  rw [← (adj.homEquiv _ _).apply_symm_apply g', h0, Adjunction.homEquiv_unit, Functor.map_zero,
    comp_zero]

end Consequences

end Stacks.Duality.SupportedGeneration

