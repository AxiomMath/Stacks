universe v u u₁ u₂

namespace Stacks.Duality.AffineGeneration

/-! ### Two transfer lemmas -/

/-- A constant family indexed by a nonempty type cuts out the same objects as its single member.
This is what makes the one-element generating family of
`CategoryTheory.Pretriangulated.IsCompactlyGenerated` and a single generator interchangeable. -/
theorem ofObj_const_eq_singleton {D : Type u₁} [Category.{v} D] {ι : Type*} [Nonempty ι]
    (E : D) : ObjectProperty.ofObj (fun _ : ι => E) = ObjectProperty.singleton E := by
  ext Y
  rw [ObjectProperty.ofObj_iff, ObjectProperty.singleton_iff]
  exact ⟨fun ⟨_, hi⟩ => hi, fun hE => ⟨Classical.arbitrary ι, hE⟩⟩

/-- **Generation by a single object transfers along an equivalence** whose functor is additive and
commutes with the shift. This is
`Stacks.Duality.isZero_of_rightOrthogonal_shiftClosure_map_of_equivalence` for the one-element
family, read through `Stacks.Duality.AffineGeneration.ofObj_const_eq_singleton`. -/
theorem isWeakTriangulatedGenerator_singleton_map_of_equivalence {D : Type u₁} {D' : Type u₂}
    [Category.{v} D] [Category.{v} D'] [Preadditive D] [Preadditive D'] [HasShift D ℤ]
    [HasShift D' ℤ] (e : D ≌ D') [e.functor.Additive] [e.functor.CommShift ℤ] {Q : D}
    (hQ : (ObjectProperty.singleton Q).IsWeakTriangulatedGenerator) :
    (ObjectProperty.singleton (e.functor.obj Q)).IsWeakTriangulatedGenerator := by
  intro Y hY
  refine isZero_of_rightOrthogonal_shiftClosure_map_of_equivalence e (fun _ : PUnit.{1} => Q)
    (fun Z hZ => hQ Z (by rwa [← ofObj_const_eq_singleton (ι := PUnit.{1}) Q])) Y ?_
  rwa [ofObj_const_eq_singleton (ι := PUnit.{1})]

/-! ### The derived category of a ring is compactly generated -/

/-- The regular module in degree zero is a compact object of `D(A)`. -/
private theorem isCompactObject_single_regularModule (A : Type u) [Ring A] :
    IsCompactObject.{u} ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj
      (ModuleCat.of A A)) := by
  have hcop := Stacks.SmallDerivedCategory.hasCoproducts_derivedCategory (ModuleCat.{u} A)
  have : IsCompactObject.{u} (ModuleCat.of A A) :=
    StacksDraft.Perfect.isCompactObject_regularModule
  exact StacksDraft.Perfect.isCompactObject_derived_single _ 0

/-- **`D(A)` is compactly generated**, in the sense of [Stacks, Tag 09SQ]: the regular module in
degree zero is a compact object (`StacksDraft.Perfect.isCompactObject_regularModule` and
`StacksDraft.Perfect.isCompactObject_derived_single`) and a weak generator
(`StacksDraft.Perfect.isWeakTriangulatedGenerator_regularModule`), and one compact weak generator
is a compact generating family by [Stacks, Tag 09SR].

This is the algebraic side of the base case of [Stacks, Tag 09IS]; the direct sums are indexed by
the universe of `A`, which at the locally small derived category is also the morphism universe of
`D(A)`. -/
theorem isCompactlyGenerated_derivedCategory_moduleCat (A : Type u) [Ring A] :
    IsCompactlyGenerated.{u} (DerivedCategory (ModuleCat.{u} A)) := by
  have hcop := Stacks.SmallDerivedCategory.hasCoproducts_derivedCategory (ModuleCat.{u} A)
  have := isCompactObject_single_regularModule.{u} A
  exact
    ((isWeakTriangulatedGenerator_iff_triangEnvelope_eq_isCompactObject_and_isCompactlyGenerated
      _).mp StacksDraft.Perfect.isWeakTriangulatedGenerator_regularModule).2

/-! ### The comparison chain on an affine scheme -/

/-- **The equivalence `QCoh(𝒪_X) ≌ QCoh(𝒪_Y)` attached to an isomorphism of schemes.** It is
`Stacks.DerivedQCoh.modulesRestrictionEquivalence`, which restricts modules along `e.inv` and
`e.hom`, cut down to the quasi-coherent ones: restriction along a morphism of schemes preserves
quasi-coherence. -/
def qcohEquivOfSchemeIso {X Y : Scheme.{u}} (e : X ≅ Y) :
    (SheafOfModules.isQuasicoherent X.ringCatSheaf).FullSubcategory ≌
      (SheafOfModules.isQuasicoherent Y.ringCatSheaf).FullSubcategory :=
  Stacks.DerivedQCoh.liftObjectPropertyEquivalence
    (Stacks.DerivedQCoh.modulesRestrictionEquivalence e) _ _
    (fun M hM => by
      have : M.IsQuasicoherent := hM
      exact Scheme.Modules.isQuasicoherent_restrictFunctor e.inv M)
    (fun M hM => by
      have : M.IsQuasicoherent := hM
      exact Scheme.Modules.isQuasicoherent_restrictFunctor e.hom M)

/-- `Stacks.Duality.AffineGeneration.qcohEquivOfSchemeIso` is additive: it preserves binary
products, being an equivalence of additive categories. -/
instance qcohEquivOfSchemeIso_functor_additive {X Y : Scheme.{u}} (e : X ≅ Y) :
    (qcohEquivOfSchemeIso e).functor.Additive :=
  Functor.additive_of_preserves_binary_products _

/-- **The comparison functor `D(Γ(X, ⊤)) ⥤ D_QCoh(𝒪_X)` of an affine scheme.** It is the `~` edge
of [Stacks, Tag 06Z0] into `D(QCoh(𝒪_{Spec Γ(X, ⊤)}))`, followed by the transport along
`AlgebraicGeometry.Scheme.isoSpec` and by the comparison functor of [Stacks, Tag 06VT]. Each of
the three is an equivalence, additive, and commutes with the shift. -/
def affineComparison (X : Scheme.{u}) [IsAffine X] :
    DerivedCategory (ModuleCat.{u} Γ(X, ⊤)) ⥤
      (DerivedCategoryB.derivedCategoryB
        (SheafOfModules.isQuasicoherent X.ringCatSheaf)).FullSubcategory :=
  (tildeEquiv (R := Γ(X, ⊤))).functor.mapDerivedCategory ⋙
    (qcohEquivOfSchemeIso X.isoSpec.symm).functor.mapDerivedCategory ⋙
      derivedQuasicoherentComparison.{u} X

/-- `Stacks.Duality.AffineGeneration.affineComparison` is an additive functor. -/
instance affineComparison_additive (X : Scheme.{u}) [IsAffine X] :
    (affineComparison X).Additive := by
  unfold affineComparison; infer_instance

/-- `Stacks.Duality.AffineGeneration.affineComparison` commutes with the shift by `ℤ`. -/
instance affineComparison_commShift (X : Scheme.{u}) [IsAffine X] :
    (affineComparison X).CommShift ℤ := by
  unfold affineComparison; infer_instance

/-- `Stacks.Duality.AffineGeneration.affineComparison` is an equivalence of categories. -/
instance affineComparison_isEquivalence (X : Scheme.{u}) [IsAffine X] :
    (affineComparison X).IsEquivalence := by
  have : (tildeEquiv (R := Γ(X, ⊤))).functor.mapDerivedCategory.IsEquivalence :=
    Stacks.Cohomology.isEquivalence_mapDerivedCategory _
  have : (qcohEquivOfSchemeIso X.isoSpec.symm).functor.IsEquivalence :=
    (qcohEquivOfSchemeIso X.isoSpec.symm).isEquivalence_functor
  have : (qcohEquivOfSchemeIso X.isoSpec.symm).functor.mapDerivedCategory.IsEquivalence :=
    Stacks.Cohomology.isEquivalence_mapDerivedCategory _
  have := Stacks.DerivedQCoh.derivedQuasicoherentComparison_isEquivalence_of_isAffine X
  unfold affineComparison; infer_instance

/-! ### Tag 09IS for an affine scheme -/

/-- **[Stacks, Tag 09IS] for an affine scheme.** `D_QCoh(𝒪_X)` is generated by a single compact
object: there is an object `P` of `D_QCoh(𝒪_X)` which is compact and such that an object of
`D_QCoh(𝒪_X)` receiving only zero morphisms from the shifts of `P` is zero.

The object produced is the image under
`Stacks.Duality.AffineGeneration.affineComparison` of the regular module in degree zero, which is
the structure sheaf in degree zero — the source's own generator for an affine scheme. See the
implementation notes for why it is exhibited as compact rather than as perfect, and for what
separates this from the tag's quasi-compact quasi-separated statement. -/
@[stacks 09IS "FOR AN AFFINE SCHEME ONLY, and with the generator exhibited as a COMPACT rather \
  than a perfect object. The source's induction over the quasi-compact opens, Tag 08DR, is \
  available and so is its generation step, but two of its inputs are not: Tag 09IQ at a \
  quasi-compact quasi-separated scheme (the library has only the affine case, \
  Stacks.DerivedQCoh.OpenLift.exists_isPerfectComplex_retract_restrict_of_isPerfect; the source \
  deduces the rest from Tag 09IM, needing Tags 08EK and 08EH, none of the three being present), \
  and the implication perfect implies compact of Tag 09M1, which the source draws from the Hom \
  formula of Tag 08DQ, absent. The generator here is the image of the regular module in degree \
  zero under the comparison of Tag 06Z0, that is the structure sheaf in degree zero, which is \
  the source's generator for an affine scheme; that it is perfect as well as compact is Tag \
  07LT carried across Tag 06Z0, which is not done here because the library's statement of the \
  affine case of Tag 09M1, AlgebraicGeometry.isCompactObject_iff_isPerfect_spec, is pinned to \
  CategoryTheory.HasDerivedCategory.standard and so speaks of a different derived category. \
  Compactness is what the consumers of the tag ask for"]
theorem exists_isCompactObject_isWeakTriangulatedGenerator_of_isAffine (X : Scheme.{u})
    [IsAffine X] :
    ∃ P : (DerivedCategoryB.derivedCategoryB
        (SheafOfModules.isQuasicoherent X.ringCatSheaf)).FullSubcategory,
      IsCompactObject.{u} P ∧ (ObjectProperty.singleton P).IsWeakTriangulatedGenerator := by
  have hc := isCompactObject_single_regularModule.{u} Γ(X, ⊤)
  have : (affineComparison X).asEquivalence.functor.Additive :=
    inferInstanceAs (affineComparison X).Additive
  have : (affineComparison X).asEquivalence.functor.CommShift ℤ :=
    inferInstanceAs ((affineComparison X).CommShift ℤ)
  exact ⟨(affineComparison X).obj _,
    (isCompactObject_iff_isCompactObject_obj (affineComparison X) _).mp hc,
    isWeakTriangulatedGenerator_singleton_map_of_equivalence (affineComparison X).asEquivalence
      StacksDraft.Perfect.isWeakTriangulatedGenerator_regularModule⟩

/-- **[Stacks, Tag 09IS] for an affine scheme, in the form [Stacks, Tag 09SQ] defines and Brown
representability consumes.** `D_QCoh(𝒪_X)` is compactly generated: the one-element family
consisting of the generator of
`Stacks.Duality.AffineGeneration.exists_isCompactObject_isWeakTriangulatedGenerator_of_isAffine`
is a family of compact objects which jointly generate.

The category is spelled over `AlgebraicGeometry.SheafOfModules X.ringCatSheaf`, which is the
spelling the hypothesis of [Stacks, Tag 0CR0] uses. -/
@[stacks 09IS "FOR AN AFFINE SCHEME ONLY, in the IsCompactlyGenerated form of Tag 09SQ and with \
  the generator exhibited as compact rather than perfect; see \
  Stacks.Duality.AffineGeneration.exists_isCompactObject_isWeakTriangulatedGenerator_of_isAffine \
  for the full caveat"]
theorem isCompactlyGenerated_derivedQuasiCoherent_of_isAffine (X : Scheme.{u}) [IsAffine X] :
    IsCompactlyGenerated.{u}
      (DerivedCategoryB.derivedCategoryB
        (SheafOfModules.isQuasicoherent X.ringCatSheaf)).FullSubcategory := by
  obtain ⟨P, hc, hg⟩ := exists_isCompactObject_isWeakTriangulatedGenerator_of_isAffine X
  exact ⟨PUnit.{u + 1}, fun _ => P, fun _ => hc, by
    rw [ofObj_const_eq_singleton (ι := PUnit.{u + 1})]; exact hg⟩

/-- **[Stacks, Tag 09IS] for an affine scheme**, at the spelling of `D_QCoh(𝒪_X)` over
`AlgebraicGeometry.Scheme.Modules X` — the one the statement of [Stacks, Tag 0A9E] uses. The two
spellings are the same type with separately declared `HasDerivedCategory` instances; see the
implementation notes. -/
@[stacks 09IS "FOR AN AFFINE SCHEME ONLY, in the IsCompactlyGenerated form of Tag 09SQ at the \
  Scheme.Modules spelling of the category, which is the one Tag 0A9E's statement uses; see \
  Stacks.Duality.AffineGeneration.exists_isCompactObject_isWeakTriangulatedGenerator_of_isAffine \
  for the full caveat"]
theorem isCompactlyGenerated_quasiCoherentDerivedCategory_of_isAffine (X : Scheme.{u})
    [IsAffine X] :
    IsCompactlyGenerated.{u} (Stacks.Duality.quasiCoherentDerivedCategory X) :=
  isCompactlyGenerated_derivedQuasiCoherent_of_isAffine X

/-! ### The consequences: Tags 0A9E and 0CR0 without hypotheses -/

section Consequences

variable {X Y : Scheme.{u}} (f : X ⟶ Y) [AlgebraicGeometry.QuasiCompact f]
  [AlgebraicGeometry.QuasiSeparated f] [CompactSpace Y] [IsAffine X]

/-- **`Rf_*` has a right adjoint for a morphism out of an affine scheme.** Let
`f : X ⟶ Y` be a quasi-compact quasi-separated morphism of schemes with `X` affine and `Y`
quasi-compact. Then `Rf_* : D_QCoh(𝒪_X) ⥤ D_QCoh(𝒪_Y)` has a right adjoint — the twisted inverse
image `f^×`.

This is
`DerivedPushforward.isLeftAdjoint_qcqsRestrictedDerivedPushforward_of_isCompactlyGenerated`
with its one hypothesis, the compact generation of `D_QCoh(𝒪_X)`, discharged by
`Stacks.Duality.AffineGeneration.isCompactlyGenerated_quasiCoherentDerivedCategory_of_isAffine`.

This special case is not registered as [Stacks, Tag 0A9E]; the tag, for a morphism of
quasi-compact quasi-separated schemes, is
`Stacks.Duality.DerivedPushforward.isLeftAdjoint_qcqsRestrictedDerivedPushforward_of_qcqs`. Here
the target need only be quasi-compact. -/
theorem isLeftAdjoint_qcqsRestrictedDerivedPushforward_of_isAffine :
    (Stacks.Duality.DerivedPushforward.qcqsRestrictedDerivedPushforward f).IsLeftAdjoint :=
  DerivedPushforward.isLeftAdjoint_qcqsRestrictedDerivedPushforward_of_isCompactlyGenerated
    f (isCompactlyGenerated_quasiCoherentDerivedCategory_of_isAffine X)

/-- **`Rf_*` has an exact right adjoint for a morphism out of an affine scheme.** Under the
hypotheses of `isLeftAdjoint_qcqsRestrictedDerivedPushforward_of_isAffine`, `Rf_*` has a right
adjoint `a` commuting with the shift by `ℤ`, and the adjunction `Rf_* ⊣ a` is triangulated.
This is the extra information Brown representability returns and that the source records
alongside existence. -/
theorem exists_isTriangulated_rightAdjoint_qcqsRestrictedDerivedPushforward_of_isAffine :
    ∃ (a : _) (adj : Stacks.Duality.DerivedPushforward.qcqsRestrictedDerivedPushforward f ⊣ a)
      (_ : a.CommShift ℤ), adj.IsTriangulated :=
  open Stacks.Duality.DerivedPushforward in
  exists_isTriangulated_rightAdjoint_qcqsRestrictedDerivedPushforward_of_isCompactlyGenerated
    f (isCompactlyGenerated_quasiCoherentDerivedCategory_of_isAffine X)

end Consequences

/-- **[Stacks, Tag 0CR0] with no hypothesis, for an affine scheme.** The inclusion
`D_QCoh(𝒪_X) ⥤ D(𝒪_X)` has a right adjoint, the coherator `DQ_X`.

This is `Stacks.Duality.Coherator.isLeftAdjoint_derivedQuasiCoherentι` with its compact-generation
hypothesis discharged by
`Stacks.Duality.AffineGeneration.isCompactlyGenerated_derivedQuasiCoherent_of_isAffine`. On an
affine scheme the source's own first proof is the affine coherator [Stacks, Tag 08D9] on its own;
what is run here is the second proof, Brown representability.

This declaration is not registered as [Stacks, Tag 0CR0]: the tag for every quasi-compact
quasi-separated scheme, with no compact-generation hypothesis, is
`Stacks.Duality.Coherator.isLeftAdjoint_quasiCoherentι` in
`StacksFrontier/AlgebraicGeometry/Duality/CompactGeneration/QcqsCoherator.lean`. -/
theorem isLeftAdjoint_derivedQuasiCoherentι_of_isAffine (X : Scheme.{u}) [IsAffine X] :
    (Stacks.Duality.derivedQuasiCoherent.{u, u} X).ι.IsLeftAdjoint :=
  Stacks.Duality.Coherator.isLeftAdjoint_derivedQuasiCoherentι X
    (isCompactlyGenerated_derivedQuasiCoherent_of_isAffine X)

/-- **[Stacks, Tag 0CR0] with the coherator exhibited as exact, with no hypothesis, for an affine
scheme.**

This declaration is not registered as [Stacks, Tag 0CR0]: the tag for every quasi-compact
quasi-separated scheme, with no compact-generation hypothesis, is
`Stacks.Duality.Coherator.isLeftAdjoint_quasiCoherentι` in
`StacksFrontier/AlgebraicGeometry/Duality/CompactGeneration/QcqsCoherator.lean`. -/
theorem exists_isTriangulated_rightAdjoint_derivedQuasiCoherentι_of_isAffine (X : Scheme.{u})
    [IsAffine X] :
    ∃ (DQ : DerivedCategory (SheafOfModules.{u} X.ringCatSheaf) ⥤
        (Stacks.Duality.derivedQuasiCoherent.{u, u} X).FullSubcategory)
      (adj : (Stacks.Duality.derivedQuasiCoherent.{u, u} X).ι ⊣ DQ) (_ : DQ.CommShift ℤ),
      adj.IsTriangulated :=
  Stacks.Duality.Coherator.exists_isTriangulated_rightAdjoint_derivedQuasiCoherentι X
    (isCompactlyGenerated_derivedQuasiCoherent_of_isAffine X)

end Stacks.Duality.AffineGeneration

end
