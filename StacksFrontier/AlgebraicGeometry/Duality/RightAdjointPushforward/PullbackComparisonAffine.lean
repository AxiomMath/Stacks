/-!
# Equation 48.8.0.1 over an affine base

Let `f : X ⟶ Spec R` be a perfect proper morphism of Noetherian schemes. Over the affine base
`Spec R` the category `D_QCoh(𝒪_{Spec R})` is generated by the single compact object
`𝒪_{Spec R}`, and every shift `𝒪[n]` is invertible, hence dualizable, with inverse `𝒪[-n]`.
So the dévissage of [Stacks, Tag 0A9U] needs no duality for general perfect complexes, and the
comparison map `Lf^*K ⊗ᴸ f^×𝒪 ⟶ f^×K` of [Stacks, Tag 0A9S] is invertible for every `K` given
the projection formula.

## Main results

* `Stacks.Duality.quasiCoherentDerivedTensorStructureSheafShiftIso`: `M ⊗ᴸ 𝒪[n] ≅ M[n]`.
* `Stacks.Duality.hasInverseStructureSheafShift`: `𝒪[n]` is invertible with inverse `𝒪[-n]`.
* `Stacks.Duality.isIso_twistedInverseImageCompareWithPullback_of_specTarget`: the comparison map
  over `Spec R`.

## References

* [Stacks Project, Tag 0A9U](https://stacks.math.columbia.edu/tag/0A9U)
* [Stacks Project, Tag 0A9S](https://stacks.math.columbia.edu/tag/0A9S)
-/

-- This file uses the locally small derived-category models below, which are not
-- global instances (see `StacksFrontier.Homology.DerivedCategory.LocallySmall`):
-- `D(R)` for `R`-modules.
-- `D(R)` for sheaves of modules on a small site.
-- `D(𝒪_X)` for a scheme.
attribute [local instance] ModuleCat.hasDerivedCategory
attribute [local instance] SheafOfModules.hasDerivedCategory
attribute [local instance] AlgebraicGeometry.Scheme.Modules.hasDerivedCategory

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.ObjectProperty
open CategoryTheory.MonoidalCategory Stacks.Duality.DerivedPushforward

universe u

namespace Stacks.Duality

/-- The structure sheaf of `Spec P` is the associated sheaf of `P` in degree zero. -/
def derivedStructureSheafIsoDerivedTilde (P : CommRingCat.{u}) :
    DerivedPushforward.derivedStructureSheaf (Spec P) ≅
      (derivedTilde P).obj ((DerivedCategory.singleFunctor (ModuleCat.{u} P) 0).obj
        (ModuleCat.of P P)) :=
  ObjectProperty.isoMk _
    ((DerivedCategory.singleFunctor (Spec P).Modules 0).mapIso tildeSelf.symm ≪≫
      (((tilde.functor P).mapDerivedCategorySingleFunctor 0).app (ModuleCat.of P P)).symm)

/-- **Tensoring with a shift of the structure sheaf on `D_QCoh`**: `M ⊗ᴸ 𝒪_Z[n] ≅ M[n]`. -/
def quasiCoherentDerivedTensorStructureSheafShiftIso (Z : Scheme.{u})
    (M : quasiCoherentDerivedCategory Z) (n : ℤ) :
    ((quasiCoherentDerivedTensor Z).obj M).obj
        ((DerivedPushforward.derivedStructureSheaf Z)⟦n⟧) ≅ M⟦n⟧ :=
  letI hcs : ((derivedTensor Z).obj M.obj).CommShift ℤ :=
    (Stacks.Cohomology.TorAmplitude.derTensor Z.toRingedSpace).commShift_right M.obj
  ObjectProperty.isoMk _
    (((derivedTensor Z).obj M.obj).mapIso
        (((ObjectProperty.ι _).commShiftIso n).app
          (DerivedPushforward.derivedStructureSheaf Z)) ≪≫
      ((Functor.commShiftIso (self := hcs) ((derivedTensor Z).obj M.obj) n)).app
        (DerivedPushforward.derivedStructureSheaf Z).obj ≪≫
      (shiftFunctor _ n).mapIso
        ((ObjectProperty.ι _).mapIso ((quasiCoherentDerivedTensorRightUnitor Z).app M)) ≪≫
      (((ObjectProperty.ι _).commShiftIso n).app M).symm)

/-- `𝒪_Z[m] ⊗ 𝒪_Z[n] ≅ 𝟙` in the monoidal category `D_QCoh(𝒪_Z)` when `m + n = 0`. -/
def structureSheafShiftTensorIsoUnit (Z : Scheme.{u}) (m n : ℤ) (h : m + n = 0) :
    (DerivedPushforward.derivedStructureSheaf Z)⟦m⟧ ⊗
        (DerivedPushforward.derivedStructureSheaf Z)⟦n⟧ ≅
      𝟙_ (quasiCoherentDerivedCategory Z) :=
  (((quasiCoherentDerivedTensorIsoCurriedTensor Z).app _).app _).symm ≪≫
    quasiCoherentDerivedTensorStructureSheafShiftIso Z _ n ≪≫
    (shiftFunctorCompIsoId _ m n h).app _ ≪≫
    eqToIso (tensorUnit_quasiCoherentDerivedCategory Z).symm

/-- **`𝒪_Z[n]` is an invertible object of `D_QCoh(𝒪_Z)`**, with inverse `𝒪_Z[-n]`. -/
def hasInverseStructureSheafShift (Z : Scheme.{u}) (n : ℤ) :
    HasInverse ((DerivedPushforward.derivedStructureSheaf Z)⟦n⟧) where
  inv := (DerivedPushforward.derivedStructureSheaf Z)⟦-n⟧
  isoLeft := structureSheafShiftTensorIsoUnit Z n (-n) (add_neg_cancel n)
  isoRight := structureSheafShiftTensorIsoUnit Z (-n) n (neg_add_cancel n)

/-- An object isomorphic to one with a right dual has a right dual. -/
theorem nonempty_hasRightDual_of_iso {C : Type*} [Category C] [MonoidalCategory C] {P Q : C}
    (e : P ≅ Q) (h : Nonempty (HasRightDual Q)) : Nonempty (HasRightDual P) :=
  h.elim fun _ => ⟨@HasRightDual.mk _ _ _ _ Qᘁ (exactPairingCongrLeft e)⟩

/-- **Every shift of the structure sheaf has a right dual** in `D_QCoh(𝒪_Z)`. -/
theorem nonempty_hasRightDual_structureSheaf_shift (Z : Scheme.{u}) (n : ℤ) :
    Nonempty (HasRightDual ((DerivedPushforward.derivedStructureSheaf Z)⟦n⟧)) :=
  ⟨@HasRightDual.mk _ _ _ _ _ (hasInverseStructureSheafShift Z n).exactPairing⟩

/-- Alias of `AlgebraicGeometry.isCompactObject_derivedTildeUnit`. -/
alias isCompactObject_derivedTilde_unit := AlgebraicGeometry.isCompactObject_derivedTildeUnit

/-- The associated sheaf of `R` in degree zero generates `D_QCoh(𝒪_{Spec R})`: an object
receiving only zero morphisms from its shifts is zero. -/
theorem isZero_of_rightOrthogonal_derivedTilde_unit (R : CommRingCat.{u})
    (Z : quasiCoherentDerivedCategory (Spec R))
    (hZ : ((ofObj fun _ : PUnit.{u + 1} => (derivedTilde R).obj
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
        (ModuleCat.of R R))).shiftClosure ℤ).rightOrthogonal Z) :
    IsZero Z := by
  have : (derivedTilde R).asEquivalence.functor.Additive :=
    inferInstanceAs (derivedTilde R).Additive
  have : (derivedTilde R).asEquivalence.functor.CommShift ℤ :=
    inferInstanceAs ((derivedTilde R).CommShift ℤ)
  have h := AffineGeneration.isWeakTriangulatedGenerator_singleton_map_of_equivalence
    (derivedTilde R).asEquivalence StacksDraft.Perfect.isWeakTriangulatedGenerator_regularModule
  rw [← AffineGeneration.ofObj_const_eq_singleton (ι := PUnit.{u + 1})] at h
  exact h Z hZ

/-- Every shift of the associated sheaf of `R` in degree zero has a right dual. -/
private theorem nonempty_hasRightDual_derivedTilde_unit_shift (R : CommRingCat.{u}) (n : ℤ) :
    Nonempty (HasRightDual (((derivedTilde R).obj
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj (ModuleCat.of R R)))⟦n⟧)) :=
  nonempty_hasRightDual_of_iso
    ((shiftFunctor _ n).mapIso (derivedStructureSheafIsoDerivedTilde R).symm)
    (nonempty_hasRightDual_structureSheaf_shift _ n)

section SpecTarget

variable {X : Scheme.{u}} {R : CommRingCat.{u}} (f : X ⟶ Spec R)
  [IsNoetherian X] [IsNoetherian (Spec R)] [Perfect f] [IsProper f]
  (hpush : ∀ (K : quasiCoherentDerivedCategory X) (i : ℤ),
    ((DerivedCategory.homologyFunctor (Spec R).Modules i).obj
      ((derivedPushforward f).obj K.obj)).IsQuasicoherent)
  (α : quasiCoherentDerivedTensorSwap (Spec R) ⋙ quasiCoherentDerivedPullback' f ⟶
      (quasiCoherentDerivedPullback' f).prod (quasiCoherentDerivedPullback' f) ⋙
        quasiCoherentDerivedTensorSwap X)
  [∀ (E : quasiCoherentDerivedCategory X) (K : quasiCoherentDerivedCategory (Spec R)),
    IsIso (projectionFormulaMap f hpush α E K)]
  (ρ : (quasiCoherentDerivedTensor (Spec R)).flip.obj (derivedStructureSheaf (Spec R)) ≅ 𝟭 _)

/-- **Equation 48.8.0.1 for a perfect proper morphism of Noetherian schemes to an affine
scheme.** If `α` is the oplax structure of the strong monoidal functor `Lf^*`, then
`Lf^*K ⊗ᴸ f^×𝒪 ⟶ f^×K` is an isomorphism for every `K ∈ D_QCoh(𝒪_{Spec R})`. -/
theorem isIso_twistedInverseImageCompareWithPullback_of_specTarget
    [(quasiCoherentDerivedPullback' f).Monoidal]
    (hα : ∀ P Q : quasiCoherentDerivedCategory (Spec R), α.app (P, Q) =
      (quasiCoherentDerivedPullback' f).map
          (((quasiCoherentDerivedTensorIsoCurriedTensor (Spec R)).hom.app Q).app P) ≫
        Functor.OplaxMonoidal.δ (quasiCoherentDerivedPullback' f) Q P ≫
        ((quasiCoherentDerivedTensorIsoCurriedTensor X).inv.app
          ((quasiCoherentDerivedPullback' f).obj Q)).app
          ((quasiCoherentDerivedPullback' f).obj P))
    (K : quasiCoherentDerivedCategory (Spec R)) :
    IsIso (twistedInverseImageCompareWithPullback f hpush α ρ K) :=
  isIso_twistedInverseImageCompareWithPullback_of_isCompactlyGenerated f hpush α ρ hα
    (fun _ : PUnit.{u + 1} => (derivedTilde R).obj
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj (ModuleCat.of R R)))
    (fun _ => isCompactObject_derivedTilde_unit R) (isZero_of_rightOrthogonal_derivedTilde_unit R)
    (fun _ => nonempty_hasRightDual_derivedTilde_unit_shift R) K

end SpecTarget

/-! ### The comparison map of the monoidal adjunction over an affine base -/

section ComparisonMapOfSums

variable {X : Scheme.{u}} {R : CommRingCat.{u}} (f : X ⟶ Spec R) [CompactSpace X]
  [QuasiSeparatedSpace X]
  [∀ (K : quasiCoherentDerivedCategory (Spec R)) (M : quasiCoherentDerivedCategory X),
    IsIso ((quasiCoherentDerivedAdjunction f (isQuasicoherent_homology_derivedPullback' f)
      (isQuasicoherent_homology_derivedPushforward_of_qcqs f)).projectionMap K M)]

/-- **The comparison map `Lf^*K ⊗ a(L) ⟶ a(K ⊗ L)` over an affine base, in both variables, when
`a` commutes with direct sums.** For `f : X ⟶ Spec R` with `X` quasi-compact and quasi-separated,
the projection formula for `Lf^* ⊣ Rf_*`, and `a` commuting with direct sums, the comparison map
of the monoidal adjunction is an isomorphism for every `K` and `L`: `D_QCoh(𝒪_{Spec R})` is
generated by the compact object `𝒪`, whose shifts are invertible. -/
theorem isIso_comparisonMap_of_specTarget_of_preservesColimitsOfShape
    (hsum : ∀ J : Type u, PreservesColimitsOfShape (Discrete J)
      (twistedInverseImage f (isQuasicoherent_homology_derivedPushforward_of_qcqs f)))
    (L : quasiCoherentDerivedCategory (Spec R)) (K : quasiCoherentDerivedCategory (Spec R)) :
    IsIso ((quasiCoherentDerivedAdjunction f (isQuasicoherent_homology_derivedPullback' f)
      (isQuasicoherent_homology_derivedPushforward_of_qcqs f)).comparisonMap
        (twistedInverseImageAdjunction f (isQuasicoherent_homology_derivedPushforward_of_qcqs f))
        K L) := by
  let hpull := isQuasicoherent_homology_derivedPullback' f
  let hpush := isQuasicoherent_homology_derivedPushforward_of_qcqs f
  let α := (quasiCoherentDerivedPullbackTensorIso f).hom
  have hα : ∀ P Q : quasiCoherentDerivedCategory (Spec R), α.app (P, Q) =
      (quasiCoherentDerivedPullback' f).map
          (((quasiCoherentDerivedTensorIsoCurriedTensor (Spec R)).hom.app Q).app P) ≫
        Functor.OplaxMonoidal.δ (quasiCoherentDerivedPullback' f) Q P ≫
        ((quasiCoherentDerivedTensorIsoCurriedTensor X).inv.app
          ((quasiCoherentDerivedPullback' f).obj Q)).app
          ((quasiCoherentDerivedPullback' f).obj P) := fun _ _ => rfl
  have : ∀ (E : quasiCoherentDerivedCategory X) (K : quasiCoherentDerivedCategory (Spec R)),
      IsIso (projectionFormulaMap f hpush α E K) := fun E K =>
    ((quasiCoherentDerivedAdjunction f hpull hpush).isIso_projectionMap_iff _
      (quasiCoherentDerivedTensorIsoCurriedTensor (Spec R)) _
      (quasiCoherentDerivedTensorIsoCurriedTensor X) α hα E K).2 inferInstance
  let adj := twistedInverseImageAdjunction f hpush
  let := adj.rightAdjointCommShift ℤ
  let := adj.commShift_of_leftAdjoint ℤ
  have : (twistedInverseImage f hpush).IsTriangulated := adj.isTriangulated_rightAdjoint
  have : ∀ J : Type u, PreservesColimitsOfShape (Discrete J)
      (quasiCoherentDerivedTensorRight (Spec R) L ⋙ twistedInverseImage f hpush) := fun J =>
    have := hsum J
    inferInstance
  have h := isIso_compareWithPullbackTensor_of_isCompactlyGenerated f hpush α adj L hα
    (fun _ : PUnit.{u + 1} => (derivedTilde R).obj
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj (ModuleCat.of R R)))
    (fun _ => isCompactObject_derivedTilde_unit R) (isZero_of_rightOrthogonal_derivedTilde_unit R)
    (fun _ => nonempty_hasRightDual_derivedTilde_unit_shift R) K
  rw [compareWithPullbackTensor_eq_comparisonMap f hpush α hα adj K L] at h
  have h' : IsIso ((quasiCoherentDerivedAdjunction f hpull hpush).comparisonMap adj K L ≫
      (twistedInverseImage f hpush).map
        (((quasiCoherentDerivedTensorIsoCurriedTensor (Spec R)).inv.app K).app L)) :=
    IsIso.of_isIso_comp_left
      (((quasiCoherentDerivedTensorIsoCurriedTensor X).hom.app
        ((quasiCoherentDerivedPullback' f).obj K)).app ((twistedInverseImage f hpush).obj L)) _
  exact IsIso.of_isIso_comp_right _
    ((twistedInverseImage f hpush).map
      (((quasiCoherentDerivedTensorIsoCurriedTensor (Spec R)).inv.app K).app L))


end ComparisonMapOfSums


section ComparisonMap

variable {X : Scheme.{u}} {R : CommRingCat.{u}} (f : X ⟶ Spec R)
  [IsNoetherian X] [IsNoetherian (Spec R)] [Perfect f] [IsProper f]
  [∀ (K : quasiCoherentDerivedCategory (Spec R)) (M : quasiCoherentDerivedCategory X),
    IsIso ((quasiCoherentDerivedAdjunction f (isQuasicoherent_homology_derivedPullback' f)
      (isQuasicoherent_homology_derivedPushforward_of_qcqs f)).projectionMap K M)]

/-- **The comparison map `Lf^*K ⊗ a(L) ⟶ a(K ⊗ L)` over an affine base, in both variables.** For
`f : X ⟶ Spec R` perfect and proper with `X` and `Spec R` Noetherian and the projection formula
for `Lf^* ⊣ Rf_*`, and fixed `L`, the comparison map of the monoidal adjunction is an isomorphism
for every `K`. -/
theorem isIso_comparisonMap_of_specTarget (L : quasiCoherentDerivedCategory (Spec R))
    (K : quasiCoherentDerivedCategory (Spec R)) :
    IsIso ((quasiCoherentDerivedAdjunction f (isQuasicoherent_homology_derivedPullback' f)
      (isQuasicoherent_homology_derivedPushforward_of_qcqs f)).comparisonMap
        (twistedInverseImageAdjunction f (isQuasicoherent_homology_derivedPushforward_of_qcqs f))
        K L) :=
  isIso_comparisonMap_of_specTarget_of_preservesColimitsOfShape f
    (preservesColimitsOfShape_rightAdjoint_quasiCoherentDerivedPushforward_of_hpush f
      (isQuasicoherent_homology_derivedPushforward_of_qcqs f)
      (twistedInverseImageAdjunction f (isQuasicoherent_homology_derivedPushforward_of_qcqs f)))
    L K

/-- **The comparison map `Lf^*K ⊗ a(𝒪) ⟶ a(K ⊗ 𝒪)` over an affine base** ([Stacks, Tag 0A9U]
at `Spec R`, in the spelling of the monoidal adjunction): for `f : X ⟶ Spec R` perfect and proper
with `X` and `Spec R` Noetherian and the projection formula for `Lf^* ⊣ Rf_*`, the comparison
map is an isomorphism for every `K`. -/
theorem isIso_comparisonMap_structureSheaf_of_specTarget
    (K : quasiCoherentDerivedCategory (Spec R)) :
    IsIso ((quasiCoherentDerivedAdjunction f (isQuasicoherent_homology_derivedPullback' f)
      (isQuasicoherent_homology_derivedPushforward_of_qcqs f)).comparisonMap
        (twistedInverseImageAdjunction f (isQuasicoherent_homology_derivedPushforward_of_qcqs f))
        K (derivedStructureSheaf (Spec R))) :=
  isIso_comparisonMap_of_specTarget f _ K

end ComparisonMap

