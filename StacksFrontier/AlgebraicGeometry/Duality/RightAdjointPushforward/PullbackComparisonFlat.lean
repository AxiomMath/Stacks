module

public import StacksFrontier.AlgebraicGeometry.Duality.RightAdjointPushforward.ProjectionFormulaQuasiCoherent
public import StacksFrontier.AlgebraicGeometry.Duality.RightAdjointPushforward.RightAdjointDirectSumsFlat
public import StacksFrontier.AlgebraicGeometry.Duality.UpperShriekComparisonCharts
public import StacksFrontier.AlgebraicGeometry.Duality.TwistedInverseImage.ProperFlatSupport

/-!
# Equation 48.8.0.1 for a proper flat morphism of finite presentation

Let `f : X ⟶ Y` be proper, flat and of finite presentation. Then `a` commutes with direct sums
([Stacks, Tag 0E4I]), so the dévissage of [Stacks, Tag 0E4K] applies: over an affine base, where
`D_QCoh(𝒪_Y)` is generated by `𝒪_Y` whose shifts are invertible, the comparison map
`Lf^*K ⊗ᴸ a(L) ⟶ a(K ⊗ᴸ L)` of [Stacks, Tag 0A9S] is invertible for all `K` and `L`.

## Main results

* `Stacks.Duality.isIso_comparisonMap_of_isAffine_of_flat` — the two-variable comparison map over
  an affine base.
-/

-- This file uses the locally small derived-category models below, which are not
-- global instances (see `StacksFrontier.Homology.DerivedCategory.LocallySmall`):
-- `D(𝒪_X)` for a scheme.
attribute [local instance] AlgebraicGeometry.Scheme.Modules.hasDerivedCategory

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MonoidalCategory
open Stacks.Duality.DerivedPushforward

universe u

namespace Stacks.Duality

/-- **[Stacks, Tag 0E4K] over an affine target, in two variables**: for `q : A ⟶ B` proper, flat
and of finite presentation with `B` affine, the comparison map `Lq^*K ⊗ a(L) ⟶ a(K ⊗ L)` is
invertible, `a` commuting with direct sums ([Stacks, Tag 0E4I]); along `B ≅ Spec Γ(B)`. -/
theorem isIso_comparisonMap_of_isAffine_of_flat {A B : Scheme.{u}} (q : A ⟶ B) [IsProper q]
    [Flat q] [LocallyOfFinitePresentation q] [IsAffine B] [CompactSpace A] [QuasiSeparatedSpace A]
    (K L : quasiCoherentDerivedCategory B) :
    IsIso ((quasiCoherentDerivedAdjunction q (isQuasicoherent_homology_derivedPullback' q)
      (isQuasicoherent_homology_derivedPushforward_of_qcqs q)).comparisonMap
      (twistedInverseImageAdjunction q (isQuasicoherent_homology_derivedPushforward_of_qcqs q))
        K L) := by
  let e := B.isoSpec
  let q' := q ≫ e.hom
  have hq : q = q' ≫ e.inv := by simp [q']
  have h := isIso_map_comparisonMap_congr hq (𝟭 _) K L
  simp only [Functor.id_map] at h
  rw [h, isIso_comparisonMap_comp_iso_iff q' e.inv]
  exact isIso_comparisonMap_of_specTarget_of_preservesColimitsOfShape q'
    (fun J => preservesColimitsOfShape_rightAdjoint_quasiCoherentDerivedPushforward_of_flat q'
      (twistedInverseImageAdjunction q' _) J) _ _

section BaseChange

variable {U X V Y : Scheme.{u}} (j' : U ⟶ X) (f' : U ⟶ V) (f : X ⟶ Y) (j : V ⟶ Y)
  [IsOpenImmersion j] [CompactSpace Y] [QuasiSeparatedSpace Y] [IsProper f] [Flat f]
  [LocallyOfFinitePresentation f] [AlgebraicGeometry.QuasiCompact j]

/-- **Invertibility of the comparison map is compatible with restriction to a quasi-compact open
of the base** for `f` proper, flat and of finite presentation over a quasi-compact quasi-separated
base: a functor `H` out of `D_QCoh(𝒪_U)` inverts `L(j')^*` of the comparison map
`Lf^*K ⊗ a(L) ⟶ a(K ⊗ L)` exactly when it inverts the comparison map of the base change `f'` at
`(Lj^*K, Lj^*L)`. The base change map of the twisted inverse image along `j` is invertible at
every object ([Stacks, Tag 0E4J]). -/
theorem isIso_map_comparisonMap_baseChange_iff_of_flat (sq : IsPullback j' f' f j)
    {E : Type*} [Category E] (H : quasiCoherentDerivedCategory U ⥤ E)
    (K L : quasiCoherentDerivedCategory Y) :
    haveI : IsOpenImmersion j' := MorphismProperty.of_isPullback sq.flip inferInstance
    haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
    haveI : CompactSpace V := QuasiCompact.compactSpace_of_compactSpace j
    haveI : CompactSpace U := compactSpace_of_isPullback sq
    haveI : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated f
    haveI : QuasiSeparatedSpace V := j.isOpenEmbedding.quasiSeparatedSpace
    haveI : QuasiSeparatedSpace U := j'.isOpenEmbedding.quasiSeparatedSpace
    IsIso (H.map ((quasiCoherentDerivedPullback' j').map
        ((quasiCoherentDerivedAdjunction f (isQuasicoherent_homology_derivedPullback' f)
          (isQuasicoherent_homology_derivedPushforward_of_qcqs f)).comparisonMap
          (twistedInverseImageAdjunction f
            (isQuasicoherent_homology_derivedPushforward_of_qcqs f)) K L))) ↔
      IsIso (H.map ((quasiCoherentDerivedAdjunction f'
          (isQuasicoherent_homology_derivedPullback' f')
          (isQuasicoherent_homology_derivedPushforward_of_qcqs f')).comparisonMap
          (twistedInverseImageAdjunction f'
            (isQuasicoherent_homology_derivedPushforward_of_qcqs f'))
          ((quasiCoherentDerivedPullback' j).obj K)
          ((quasiCoherentDerivedPullback' j).obj L))) := by
  have : IsOpenImmersion j' := MorphismProperty.of_isPullback sq.flip inferInstance
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  have : CompactSpace V := QuasiCompact.compactSpace_of_compactSpace j
  have : CompactSpace U := compactSpace_of_isPullback sq
  have : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated f
  have : QuasiSeparatedSpace V := j.isOpenEmbedding.quasiSeparatedSpace
  have : QuasiSeparatedSpace U := j'.isOpenEmbedding.quasiSeparatedSpace
  have := isIso_twoSquare_of_isOpenImmersion j' f' f j sq
  have := isIso_rightAdjointBaseChange_app_of_isOpenImmersion_of_flat j' f' f j sq L
  have := isIso_rightAdjointBaseChange_app_of_isOpenImmersion_of_flat j' f' f j sq (K ⊗ L)
  have hδ : ∀ {S T : Scheme.{u}} (g : S ⟶ T) (A B : quasiCoherentDerivedCategory T),
      IsIso (Functor.OplaxMonoidal.δ (quasiCoherentDerivedPullback' g) A B) := fun g A B =>
    ⟨⟨Functor.LaxMonoidal.μ _ _ _, Functor.Monoidal.δ_μ _ _ _, Functor.Monoidal.μ_δ _ _ _⟩⟩
  have := hδ j
  have := hδ j'
  have : NatTrans.IsMonoidal
      (quasiCoherentDerivedPullbackCompIso j' f ≪≫ quasiCoherentDerivedPullbackCongr sq.w).hom :=
    inferInstanceAs (NatTrans.IsMonoidal ((quasiCoherentDerivedPullbackCompIso j' f).hom ≫
      (quasiCoherentDerivedPullbackCongr sq.w).hom))
  exact Stacks.CategoryTheory.BaseChange.isIso_map_comparisonMap_iff
    (quasiCoherentDerivedAdjunction f (isQuasicoherent_homology_derivedPullback' f)
      (isQuasicoherent_homology_derivedPushforward_of_qcqs f))
    (quasiCoherentDerivedAdjunction f' (isQuasicoherent_homology_derivedPullback' f')
      (isQuasicoherent_homology_derivedPushforward_of_qcqs f'))
    (quasiCoherentDerivedAdjunction j (isQuasicoherent_homology_derivedPullback' j)
      (isQuasicoherent_homology_derivedPushforward_of_qcqs j))
    (quasiCoherentDerivedAdjunction j' (isQuasicoherent_homology_derivedPullback' j')
      (isQuasicoherent_homology_derivedPushforward_of_qcqs j'))
    (quasiCoherentDerivedPullbackCompIso f' j)
    (quasiCoherentDerivedPullbackCompIso j' f ≪≫ quasiCoherentDerivedPullbackCongr sq.w)
    (Stacks.CategoryTheory.BaseChange.squareComposite_δ_compat _ _
      (NatTrans.IsMonoidal.δ_comp_tensorHom (quasiCoherentDerivedPullbackCompIso f' j).hom)
      (NatTrans.IsMonoidal.δ_comp_tensorHom
        (quasiCoherentDerivedPullbackCompIso j' f ≪≫ quasiCoherentDerivedPullbackCongr sq.w).hom))
    (twistedInverseImageAdjunction f (isQuasicoherent_homology_derivedPushforward_of_qcqs f))
    (twistedInverseImageAdjunction f' (isQuasicoherent_homology_derivedPushforward_of_qcqs f'))
    H K L

end BaseChange

section Qcqs

variable {X Y : Scheme.{u}} (f : X ⟶ Y) [CompactSpace Y] [QuasiSeparatedSpace Y] [IsProper f]
  [Flat f] [LocallyOfFinitePresentation f]

/-- **The comparison map `Lf^*K ⊗ a(L) ⟶ a(K ⊗ L)` in two variables** for `f` proper, flat and of
finite presentation over a quasi-compact quasi-separated base: invertibility is local on the base
([Stacks, Tag 0E4J]) and holds over affine opens. -/
theorem isIso_comparisonMap_of_flat (K L : quasiCoherentDerivedCategory Y) :
    haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
    haveI : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated f
    IsIso ((quasiCoherentDerivedAdjunction f (isQuasicoherent_homology_derivedPullback' f)
      (isQuasicoherent_homology_derivedPushforward_of_qcqs f)).comparisonMap
      (twistedInverseImageAdjunction f (isQuasicoherent_homology_derivedPushforward_of_qcqs f))
        K L) := by
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  have : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated f
  refine isIso_of_forall_isIso_quasiCoherentDerivedPullback (fun V : Y.affineOpens => f ⁻¹ᵁ V.1)
    (TopologicalSpace.IsOpenCover.comap (iSup_affineOpens_eq_top Y) f.base.1) _ fun V => ?_
  have : IsAffine V.1.toScheme := V.2
  have sq := (isPullback_morphismRestrict f V.1).flip
  have : IsProper (f ∣_ V.1) := MorphismProperty.of_isPullback sq inferInstance
  have : Flat (f ∣_ V.1) := MorphismProperty.of_isPullback sq inferInstance
  have : LocallyOfFinitePresentation (f ∣_ V.1) := MorphismProperty.of_isPullback sq inferInstance
  have : CompactSpace (f ⁻¹ᵁ V.1).toScheme := compactSpace_of_isPullback sq
  have : QuasiSeparatedSpace (f ⁻¹ᵁ V.1).toScheme :=
    (f ⁻¹ᵁ V.1).ι.isOpenEmbedding.quasiSeparatedSpace
  exact (isIso_map_comparisonMap_baseChange_iff_of_flat (f ⁻¹ᵁ V.1).ι (f ∣_ V.1) f V.1.ι sq
    (𝟭 _) K L).2 (isIso_comparisonMap_of_isAffine_of_flat (f ∣_ V.1) _ _)

/-- **[Stacks, Tag 0E4K].** Let `Y` be a quasi-compact and quasi-separated scheme and
`f : X ⟶ Y` proper, flat and of finite presentation. The map `Lf^*K ⊗ᴸ a(𝒪_Y) ⟶ a(K)` of
Equation 48.8.0.1 is an isomorphism for every `K ∈ D_QCoh(𝒪_Y)`. -/
@[stacks 0E4K]
theorem isIso_twistedInverseImageCompareWithPullback_of_flat (K : quasiCoherentDerivedCategory Y) :
    haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
    haveI : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated f
    IsIso (twistedInverseImageCompareWithPullback f
      (isQuasicoherent_homology_derivedPushforward_of_qcqs f)
      (quasiCoherentDerivedPullbackTensorIso f).hom
      (quasiCoherentDerivedTensorRightUnitor Y) K) := by
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  have : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated f
  let hpush := isQuasicoherent_homology_derivedPushforward_of_qcqs f
  let α := (quasiCoherentDerivedPullbackTensorIso f).hom
  let ρ := quasiCoherentDerivedTensorRightUnitor Y
  let adj := twistedInverseImageAdjunction f hpush
  have : IsIso (compareWithPullbackTensor f hpush α adj K (derivedStructureSheaf Y)) := by
    rw [compareWithPullbackTensor_eq_comparisonMap f hpush α (fun _ _ => rfl) adj]
    have := isIso_comparisonMap_of_flat f K (derivedStructureSheaf Y)
    infer_instance
  change IsIso (compareWithPullbackTensor f hpush α adj K (derivedStructureSheaf Y) ≫
    (twistedInverseImage f hpush).map (ρ.hom.app K))
  infer_instance

end Qcqs

end Stacks.Duality
