/-!
# The rank of the normal sheaf of a Koszul-regular closed immersion

Let `i : X ⟶ Y` be a Koszul-regular closed immersion of schemes with ideal sheaf `𝓘 ⊆ 𝒪_Y`, and
let `𝒩 = 𝓗om_{𝒪_X}(𝒞_{X/Y}, 𝒪_X)` be its normal sheaf, finite locally free of locally constant
rank `r`. [Stacks, Tag 0BQZ] writes `r` for the minimal number of local generators of `𝓘` near a
point of `Y`. The two agree: at `x ∈ X`, near `i(x)` the ideal `𝓘` is generated by a
Koszul-regular sequence `f₁, …, f_c`, whose length is the minimal number of local generators at
`i(x)`, and the sections of `𝒞_{X/Y} = 𝓘/𝓘²` over an affine chart are `I/I²`, free on the classes
of the `fⱼ` because a Koszul-regular sequence is quasi-regular. Hence `𝒞_{X/Y}`, and with it its
dual `𝒩`, is free of rank `c` near `x`. Consequently the locus `X_n ⊆ X` where `𝒩` has rank `n`
is the preimage of the locus of `Y` where `𝓘` needs `n` local generators.

## Main results

* `Stacks.Duality.KoszulRegular.normalRank_eq_localGeneratorCount`: the rank of `𝒩` at `x` is the
  minimal number of local generators of `𝓘` at `i(x)`.
* `Stacks.Duality.KoszulRegular.preimage_rankLocus_definingIdealOfHom`: the preimage of the
  rank-`n` locus of `𝓘` is the rank-`n` locus of `𝒩`.
* `Stacks.Duality.KoszulRegular.pushforwardExtensionByZeroIso`: `i_*` commutes with extension by
  zero from an open of `Y` and its preimage in `X`.
* `Stacks.Conormal.fiberRank_conormalSheaf_eq_of_isQuasiRegular`: over an affine chart on which
  the ideal of an immersion is generated by a quasi-regular sequence of length `c`, the conormal
  sheaf has fibre rank `c`.
* `AlgebraicGeometry.Scheme.Modules.fiberRank_dualSheaf`: a finite locally free module and its
  dual have the same fibre rank at every point.
* `RingTheory.Sequence.nonempty_basis_of_isQuasiRegular`: the conormal module `I/I²` of an ideal
  generated by a quasi-regular sequence of length `c` is free of rank `c` over the quotient.

## Implementation notes

The rank of `𝒩` is compared with the fibre rank `AlgebraicGeometry.Scheme.Modules.fiberRank`, by
`Stacks.Chow.fiberRank_eq_moduleRank`. The fibre rank is local and invariant under isomorphism,
so over an affine chart `U = i⁻¹(V)` it is read off the sheaf associated with the module of
sections over `U`, which is free.

## References

* [Stacks Project, Tag 0BR0](https://stacks.math.columbia.edu/tag/0BR0)
* [Stacks Project, Tag 0BQZ](https://stacks.math.columbia.edu/tag/0BQZ)
* [Stacks Project, Tag 063K](https://stacks.math.columbia.edu/tag/063K)
* [Stacks Project, Tag 01R3](https://stacks.math.columbia.edu/tag/01R3)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

universe u

namespace RingTheory.Sequence

/-- **The conormal module of a quasi-regular ideal is free on the generators.** Let
`φ : A ⟶ B` be surjective with kernel `I`, generated by a quasi-regular sequence `f₁, …, f_c`.
A `B`-module `M` identified with `I/I²` compatibly with the scalar actions through `φ` is free of
rank `c`: the classes of the `fⱼ` span `I/I²`, and a relation `∑ aⱼ fⱼ ∈ I²` forces every `aⱼ`
into `I`. -/
@[sga "7 VI 4.14" "partial"]
theorem nonempty_basis_of_isQuasiRegular {A B M : Type*} [CommRing A] [CommRing B]
    [AddCommGroup M] [Module B M] (φ : A →+* B) (hφ : Function.Surjective φ) {r : ℕ}
    (f : Fin r → A) (hf : IsQuasiRegular A (List.ofFn f)) {I : Ideal A}
    (hI : Ideal.span (Set.range f) = I) (hker : RingHom.ker φ = I)
    (ψ : M ≃+ I.Cotangent) (hψ : ∀ (a : A) (m : M), ψ (φ a • m) = a • ψ m) :
    Nonempty (Module.Basis (Fin r) B M) := by
  classical
  have hfI : ∀ k, f k ∈ I := fun k => hI ▸ Ideal.subset_span (Set.mem_range_self k)
  let v : Fin r → M := fun k => ψ.symm (I.toCotangent ⟨f k, hfI k⟩)
  have hsum : ∀ a : Fin r → A, ψ (∑ k, φ (a k) • v k) = I.toCotangent ⟨∑ k, a k * f k,
      Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ (hfI k)⟩ := by
    intro a
    rw [map_sum]
    simp only [hψ, v, AddEquiv.apply_symm_apply, ← map_smul, ← map_sum]
    congr 1
    apply Subtype.ext
    simp
  refine ⟨Module.Basis.mk (v := v) ?_ ?_⟩
  · rw [Fintype.linearIndependent_iff]
    intro c hc k
    choose a ha using fun k => hφ (c k)
    have h0 : ψ (∑ k, φ (a k) • v k) = 0 := by
      simp only [ha, hc, map_zero]
    rw [hsum, Ideal.toCotangent_eq_zero] at h0
    rw [← ha k, ← RingHom.mem_ker, hker, ← hI]
    exact hf.coeff_mem_Jid a (by rwa [Jid, hI]) k
  · intro m _
    obtain ⟨x, hx⟩ := I.toCotangent_surjective (ψ m)
    obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp (hI ▸ x.2 :
      (x : A) ∈ Ideal.span (Set.range f))
    have hm : m = ∑ k, φ (a k) • v k := by
      apply ψ.injective
      rw [hsum, ← hx]
      congr 1
      apply Subtype.ext
      simp only [← ha, smul_eq_mul]
    rw [hm]
    exact Submodule.sum_mem _ fun k _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩)

end RingTheory.Sequence

namespace AlgebraicGeometry.Scheme.Modules

/-- **The fibre rank on a trivializing open.** If the restriction of `M` to the slice site over an
open `U` is free on a finite index type `I`, the fibre rank of `M` at every point of `U` is the
cardinality of `I`. -/
theorem fiberRank_eq_card_of_freeIsoOver {X : Scheme.{u}} (M : X.Modules) {U : X.Opens}
    (I : Type u) [Finite I]
    (e : _root_.SheafOfModules.free (R := X.ringCatSheaf.over U) I ≅ M.over U)
    {x : X} (hx : x ∈ U) : fiberRank M x = Nat.card I := by
  let G := (_root_.SheafOfModules.free.generatingSections I).ofEpi e.hom
  have hG : IsIso G.π := by
    rw [_root_.SheafOfModules.GeneratingSections.ofEpi_π,
      _root_.SheafOfModules.free.generatingSections_π]
    exact IsIso.comp_isIso' (IsIso.id _) inferInstance
  have h : Finite (Stacks.StalkFreeBridge.trivializationOfGeneratingSections U M G).ι :=
    inferInstanceAs (Finite I)
  exact fiberRank_eq_card_of_trivialization M x hx
    (Stacks.StalkFreeBridge.trivializationOfGeneratingSections U M G)

/-- **A finite locally free module and its dual have the same fibre rank.** Near every point the
module is free on a finite index type, and there its dual is free on the same index type. -/
theorem fiberRank_dualSheaf {X : Scheme.{u}} (E : X.Modules)
    (hE : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
      (R := X.ringCatSheaf) E) (x : X) :
    fiberRank (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf E) x = fiberRank E x := by
  obtain ⟨q, hq, hqf⟩ := hE.exists_isFiniteLocallyFreeData
  obtain ⟨idx, hxi⟩ := ((Opens.coversTop_iff _ q.X).1 q.coversTop).exists_mem x
  have hiso : IsIso (q.generators idx).π := hq.isIso idx
  have hfin : Finite (q.generators idx).I := (hqf.isFiniteType idx).finite
  exact (fiberRank_eq_card_of_freeIsoOver (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf E)
      _ (Stacks.AlgebraicGeometry.ReflexiveModules.freeIsoDualSheafOver X (q.X idx) E
        (asIso (q.generators idx).π)) hxi).trans
    (fiberRank_eq_card_of_freeIsoOver E _ (asIso (q.generators idx).π) hxi).symm

end AlgebraicGeometry.Scheme.Modules

namespace Stacks.Conormal

open AlgebraicGeometry.Scheme.Modules RingedSpaceModuleAdjunction

/-- **The fibre rank of the conormal sheaf on a quasi-regular chart.** Let `i : Z ⟶ X` be an
immersion and `V` an affine open of `X` inside the coborder of the image of `i` on which the
kernel of `Γ(X, V) ⟶ Γ(Z, i⁻¹V)` is generated by a quasi-regular sequence of length `c`. Then the
conormal sheaf of `i` has fibre rank `c` at every point of `i⁻¹V`: its sections over the affine
open `i⁻¹V` are `I/I²` ([Stacks, Tag 01R3]), free of rank `c`, so its restriction to
`Spec Γ(Z, i⁻¹V)` is free of rank `c`. -/
theorem fiberRank_conormalSheaf_eq_of_isQuasiRegular {Z X : Scheme.{u}} (i : Z ⟶ X)
    [IsImmersion i] {V : X.Opens} (hV : IsAffineOpen V) (hVc : V ≤ i.coborderRange) {r : ℕ}
    (f : Fin r → Γ(X, V)) (hf : RingTheory.Sequence.IsQuasiRegular Γ(X, V) (List.ofFn f))
    (hker : RingHom.ker (i.app V).hom = Ideal.span (Set.range f)) {z : Z} (hz : z ∈ i ⁻¹ᵁ V) :
    fiberRank (conormalSheaf i) z = r := by
  obtain ⟨I, e, he⟩ := Stacks.Immersion.exists_affineModel_of_le_coborderRange i V hV hVc
  have hI : RingHom.ker (i.app V).hom = I := by
    have hk := ker_appLE_eq_of_affineModel i V hV I e he
    rwa [Scheme.Hom.appLE_eq_app] at hk
  have hsurj : Function.Surjective (i.app V).hom := by
    have hs := surjective_appLE_of_affineModel i V hV I e he
    rwa [Scheme.Hom.appLE_eq_app] at hs
  have hU : IsAffineOpen (i ⁻¹ᵁ V) := isAffineOpen_preimage_of_affineModel i V I e
  obtain ⟨C, hC⟩ : ∃ C : Z.Modules, C = conormalSheaf i := ⟨_, rfl⟩
  obtain ⟨c⟩ : Nonempty ((ModuleCat.restrictScalars (i.app V).hom).obj
      (ModuleCat.of Γ(Z, i ⁻¹ᵁ V) Γ(C, i ⁻¹ᵁ V)) ≅ ModuleCat.of Γ(X, V) I.Cotangent) := by
    subst hC
    exact ⟨Stacks.Conormal.CotangentAppIso.conormalAffineSectionsIsoCotangent i V hV I e he⟩
  have : C.IsQuasicoherent := by
    subst hC
    exact conormalSheaf_isQuasicoherent i
  rw [← hC]
  let ψ : Γ(C, i ⁻¹ᵁ V) ≃+ I.Cotangent :=
    { toFun := fun m => c.hom m
      invFun := fun t => c.inv t
      left_inv := c.hom_inv_id_apply
      right_inv := c.inv_hom_id_apply
      map_add' := fun m m' => c.hom.hom.map_add m m' }
  obtain ⟨b⟩ := RingTheory.Sequence.nonempty_basis_of_isQuasiRegular (i.app V).hom hsurj f hf
    (hker.symm.trans hI) hI ψ (fun a m => c.hom.hom.map_smul a m)
  obtain ⟨t⟩ := (tilde_fixed_free_iff_basis Γ(Z, i ⁻¹ᵁ V) Γ(C, i ⁻¹ᵁ V)
    (ULift.{u} (Fin r))).mpr ⟨b.reindex Equiv.ulift.symm⟩
  obtain ⟨y, rfl⟩ : z ∈ Set.range hU.fromSpec := by rwa [hU.range_fromSpec]
  have := AlgebraicGeometry.SheafOfModules.isFiniteLocallyFreeOfRank_free_of_equiv
    (X := Spec Γ(Z, i ⁻¹ᵁ V)) (ULift.{u} (Fin r)) r Equiv.ulift
  rw [← Stacks.FiniteLocallyFree.Reduced.fiberRank_restrict hU.fromSpec,
    ← fiberRank_eq_of_iso (Stacks.Modules.tildeIsoRestrictFromSpec C hU),
    fiberRank_eq_of_iso t]
  exact fiberRank_eq_rank_of_isFiniteLocallyFreeOfRank _ r y

end Stacks.Conormal

namespace Stacks.Duality.KoszulRegular

open Stacks.AlgebraicGeometry.RegularIdealSheaf AlgebraicGeometry.Scheme.Modules
open ExtensionByZeroModules

variable {X Y : Scheme.{u}} (i : X ⟶ Y) [IsClosedImmersion i]

/-- Near `i(x)`, the ideal of a Koszul-regular closed immersion is generated over an affine open
by a Koszul-regular sequence, whose length is the local generator count and whose open lies in the
corresponding rank locus. -/
private theorem exists_koszulRegular_chart (hi : IsKoszulRegularImmersion i) (x : X) :
    ∃ (V : Y.affineOpens) (r : ℕ) (f : Fin r → Γ(Y, V.1)), i x ∈ V.1 ∧
      RingHom.ker (i.app V.1).hom = Ideal.span (Set.range f) ∧ Koszul.IsKoszulRegular f ∧
      localGeneratorCount (Y := Y.toRingedSpace) (definingIdealOfHom i) (i x) = r ∧
      V.1 ≤ rankLocus (Y := Y.toRingedSpace) (definingIdealOfHom i) r := by
  have hcl : i x ∈ closure (Set.range i.base) := subset_closure ⟨x, rfl⟩
  have hyS := (mem_idealQuotientSupport_definingIdealOfHom_iff i (i x)).mpr hcl
  obtain ⟨V, hxV, r, f, hker, hreg⟩ := (isKoszulRegularIdealSheaf_iff_kerGeneratedBy i).mp
    (isKoszulRegularIdealSheaf_definingIdealOfHom i hi) (i x) hcl
  have hK := (isKoszulSequenceExactOn_iff_forall_germ_isKoszulRegular _ V.1 f).mpr
    ((forall_isKoszulRegular_germFamily_iff Y V.2 f).mpr hreg)
  have hG := Stacks.AlgebraicGeometry.isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span i
    V.2 f hker
  exact ⟨V, r, f, hxV, hker, hreg, localGeneratorCount_eq hK hG (i x) hxV hyS,
    le_rankLocus hK hG⟩

/-- **The rank of the normal sheaf is the local number of generators of the ideal.** For a
Koszul-regular closed immersion `i : X ⟶ Y` with ideal sheaf `𝓘` and a point `x` of `X`, the rank
of the normal sheaf at `x` is the minimal number of local generators of `𝓘` at `i(x)`
([Stacks, Tag 0BQZ]). Near `i(x)` the ideal is generated over an affine open by a Koszul-regular,
hence quasi-regular, sequence; its length is the number of local generators, and the conormal
sheaf, hence its dual, is free of that rank near `x`. -/
theorem normalRank_eq_localGeneratorCount (hi : IsKoszulRegularImmersion i) (x : X) :
    normalRank i hi x =
      localGeneratorCount (Y := Y.toRingedSpace) (definingIdealOfHom i) (i x) := by
  obtain ⟨V, r, f, hxV, hker, hreg, hcount, -⟩ := exists_koszulRegular_chart i hi x
  rw [hcount]
  have hq : RingTheory.Sequence.IsQuasiRegular Γ(Y, V.1) (List.ofFn f) :=
    Koszul.isQuasiRegular_of_isH1RegularOn ((Koszul.isH1RegularOn_self_iff f).2 hreg.isH1Regular)
  have hC := isFiniteLocallyFree_conormalSheaf_of_isQuasiRegularImmersion i
    (isQuasiRegularImmersion_of_isH1RegularImmersion i
      (isH1RegularImmersion_of_isKoszulRegularImmersion i hi))
  calc normalRank i hi x = fiberRank (Stacks.Divisors.normalSheaf i) x :=
        (@Stacks.Chow.fiberRank_eq_moduleRank X (Stacks.Divisors.normalSheaf i)
          (isFiniteLocallyFree_normalSheaf i hi) x).symm
    _ = fiberRank (Stacks.Conormal.conormalSheaf i) x := fiberRank_dualSheaf _ hC x
    _ = r := Stacks.Conormal.fiberRank_conormalSheaf_eq_of_isQuasiRegular i V.2
        (le_top.trans_eq (Stacks.Conormal.coborderRange_eq_top i).symm) f hq hker hxV

/-- **The rank loci of the ideal and of the normal sheaf correspond.** For a Koszul-regular closed
immersion `i : X ⟶ Y` with ideal sheaf `𝓘`, the preimage of the largest open of `Y` on which `𝓘`
needs `n` local generators at the points of `i(X)` is the locus of `X` where the normal sheaf has
rank `n`. -/
theorem preimage_rankLocus_definingIdealOfHom (hi : IsKoszulRegularImmersion i) (n : ℤ) :
    i ⁻¹ᵁ (rankLocus (Y := Y.toRingedSpace) (definingIdealOfHom i) n) = normalRankLocus i hi n := by
  ext x
  show i x ∈ rankLocus (Y := Y.toRingedSpace) (definingIdealOfHom i) n ↔
    x ∈ normalRankLocus i hi n
  rw [mem_normalRankLocus, normalRank_eq_localGeneratorCount i hi x]
  have hyS := (mem_idealQuotientSupport_definingIdealOfHom_iff i (i x)).mpr
    (subset_closure ⟨x, rfl⟩)
  refine ⟨fun h => localGeneratorCount_eq_of_mem_rankLocus h hyS, fun h => ?_⟩
  obtain ⟨V, r, f, hxV, -, -, hcount, hle⟩ := exists_koszulRegular_chart i hi x
  rw [← h, hcount]
  exact hle hxV

/-- **Pushforward along a closed immersion of schemes commutes with extension by zero.** For an
open `U ⊆ Y` with preimage `V ⊆ X` and a sheaf of `𝒪_X`-modules `M`,
`i_*(j_{V,!} j_V^* M) ≅ j_{U,!} j_U^* (i_* M)`. This is
`ExtensionByZeroModules.modulePushforwardExtensionRestrictionIso` for `i` read as a closed
quotient morphism of ringed spaces. -/
def pushforwardExtensionByZeroIso (U : Y.Opens) (V : X.Opens) (hUV : i ⁻¹ᵁ U = V)
    (M : SheafOfModules.{u} (structureSheaf X.toRingedSpace.sheaf)) :
    (RingedSpaceModuleAdjunction.modulePushforward
        (Stacks.Duality.closedQuotient i).i).obj
        ((jShriek V (structureSheaf X.toRingedSpace.sheaf)).obj
          ((jStar V (structureSheaf X.toRingedSpace.sheaf)).obj M)) ≅
      (jShriek U (structureSheaf Y.toRingedSpace.sheaf)).obj
        ((jStar U (structureSheaf Y.toRingedSpace.sheaf)).obj
          ((RingedSpaceModuleAdjunction.modulePushforward
            (Stacks.Duality.closedQuotient i).i).obj M)) :=
  (modulePushforwardExtensionRestrictionIso (Stacks.Duality.closedQuotient i).i
    (Stacks.Duality.closedQuotient i).isClosedEmbedding U V hUV).app M

end Stacks.Duality.KoszulRegular
