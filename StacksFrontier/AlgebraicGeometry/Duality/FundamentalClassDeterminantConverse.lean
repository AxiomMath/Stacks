module

public import StacksFrontier.AlgebraicGeometry.Duality.FundamentalClassDeterminantStalk
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FinitePresentationCokernel
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.StalkFreeCover
public import StacksFrontier.Topology.Sheaves.Functors.Module.SemilinearStalk
public import StacksFrontier.Topology.Sheaves.Modules.FiniteLocallyFreePresentation
import StacksCore.Tactic.StacksAttribute

/-!
# The converse half of the isomorphism criterion of [Stacks, Tag 0E9Y]

Let `(X, O_X)` be a locally ringed space and let

`E₁ --α--> E₀ --π--> F ⟶ 0`

be a right-exact sequence of sheaves of `O_X`-modules with `E₁` finite locally free of rank
`r₁` and `E₀` finite locally free of rank `r₀ = r₁ + r`. This file proves that if the pairing

`⋀^{r₁} E₁ ⊗_{O_X} ⋀^{r} F ⟶ ⋀^{r₀} E₀`

is bijective on the stalk at `x`, then `Fₓ` is free of rank `r`, and `F` is free of rank `r` on
an open neighbourhood of `x`. Together with the converse implication this gives the criterion as
an equivalence (`Stacks.Duality.bijective_stalkMapL_detSheafPairing_iff`).

## Main definitions

* `Stacks.Duality.basisRingCatStalk`: a basis of a stalk of a sheaf of modules over the
  `CommRingCat`-valued stalk of the sheaf of rings, read over the `RingCat`-valued stalk.

## Main results

* `Stacks.Duality.exists_isUnit_det_of_surjective_wedge_formula`: over a local ring, if a map
  `⋀^{r₁} M₁ ⊗ ⋀^{r} F ⟶ ⋀^{r₁+r} M₀` satisfying the wedge-and-lift formula of Tag 0E9Y is
  surjective, some family `α(b₁), …, α(b_{r₁}), w₁, …, w_r` has unit determinant in a given basis
  of `M₀`.
* `Stacks.Duality.exists_adapted_basis_of_surjective_wedge_formula`: under the same hypotheses,
  `M₀` has a basis adapted to the presentation.
* `Stacks.Duality.nonempty_basis_of_surjective_wedge_formula`: under the same hypotheses, for a
  right-exact presentation, `F` is free of rank `r`.
* `Stacks.Duality.bijective_wedge_formula_iff`: over a local ring, such a map is bijective if and
  only if it is surjective, if and only if `F` is free of rank `r`.
* `Stacks.Duality.nonempty_basis_stalk_of_surjective_detStalkPairing` and
  `Stacks.Duality.nonempty_basis_stalk_of_bijective_stalkMapL_detSheafPairing`: the converse half
  of the criterion at a point, for the transported stalk map and for the stalk map of the sheaf
  morphism itself.
* `Stacks.Duality.isIso_detSheafPairing_iff`: on a space with local stalks the pairing is an
  isomorphism of sheaves of modules if and only if every stalk of `F` is free of rank `r`.
* `Stacks.Duality.nonempty_basis_stalk_of_isIso_detSheafPairing`: if the pairing is an
  isomorphism of sheaves of modules, every stalk of `F` is free of rank `r`.
* `Stacks.Duality.bijective_stalkMapL_detSheafPairing_iff`,
  `Stacks.Duality.bijective_stalkMapL_ringedSpaceDetSheafPairing_iff` and
  `Stacks.Duality.bijective_stalkMapL_locallyRingedSpaceDetSheafPairing_iff`: the pairing is
  bijective on the stalk at `x` if and only if `Fₓ` is free of rank `r`; the last on a
  `LocallyRingedSpace`.
* `Stacks.Duality.isFinitePresentation_of_exact`: `F` is of finite presentation.
* `Stacks.Duality.exists_nhd_iso_free_of_bijective_stalkMapL_detSheafPairing` and its ringed-space
  and locally-ringed-space forms: bijectivity of the stalk map at `x` gives an open neighbourhood
  of `x` on which `F` is isomorphic to the free sheaf of modules of rank `r`.

## References

* [Stacks Project, Tag 0E9Y](https://stacks.math.columbia.edu/tag/0E9Y)
* [Stacks Project, Tag 0B8J](https://stacks.math.columbia.edu/tag/0B8J)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace CategoryTheory.Sheaf
open Stacks.DeRham Stacks.SheafOfModules.TopWedge
open scoped TensorProduct

universe u v w x

attribute [local implicit_reducible] structureSheafRing AlgebraicGeometry.SheafedSpace.sheaf

namespace Stacks.Duality

/-! ### The converse over a local ring -/

section LocalRing

variable {R : Type u} [CommRing R] {M₁ : Type v} {M₀ : Type w} {F : Type x}
  [AddCommGroup M₁] [Module R M₁] [AddCommGroup M₀] [Module R M₀]
  [AddCommGroup F] [Module R F]

/-- **If `A` is generated by a single element `a`, every element of `A ⊗ B` is `a ⊗ y`.** -/
theorem exists_tmul_of_span_singleton_eq_top {A : Type v} {B : Type w} [AddCommGroup A]
    [Module R A] [AddCommGroup B] [Module R B] (a : A) (ha : Submodule.span R {a} = ⊤)
    (z : A ⊗[R] B) : ∃ y : B, z = a ⊗ₜ[R] y := by
  induction z using TensorProduct.inductionOn with
  | tmul p q =>
    obtain ⟨t, rfl⟩ :=
      Submodule.mem_span_singleton.1 (ha.ge (Submodule.mem_top : p ∈ (⊤ : Submodule R A)))
    exact ⟨t • q, TensorProduct.smul_tmul t a q⟩
  | add z z' hz hz' =>
    obtain ⟨y, rfl⟩ := hz
    obtain ⟨y', rfl⟩ := hz'
    exact ⟨y + y', (TensorProduct.tmul_add a y y').symm⟩

/-- Let `M₁ --α--> M₀ --π--> F ⟶ 0` be a presentation with `π` surjective, `b` a basis of `M₁` of
cardinality `r₁` and `c₀` a basis of `M₀` of cardinality `r₁ + r`, over a **local** ring. If
some map `Ψ : ⋀^{r₁} M₁ ⊗ ⋀^{r} F ⟶ ⋀^{r₁+r} M₀` satisfying the wedge-and-lift formula of
Tag 0E9Y is surjective, then there is a family `w : Fin r → M₀` for which

`α(b₁), …, α(b_{r₁}), w₁, …, w_r`

has unit determinant in the basis `c₀`, i.e. is itself a basis of `M₀`. -/
theorem exists_isUnit_det_of_surjective_wedge_formula [IsLocalRing R] {r₁ r : ℕ}
    (α : M₁ →ₗ[R] M₀) (b : Module.Basis (Fin r₁) R M₁) (π : M₀ →ₗ[R] F)
    (hπ : Function.Surjective π) (c₀ : Module.Basis (Fin (r₁ + r)) R M₀)
    (Ψ : ((⋀[R]^r₁ M₁) ⊗[R] (⋀[R]^r F)) →ₗ[R] ⋀[R]^(r₁ + r) M₀)
    (hΨ : ∀ (v : Fin r₁ → M₁) (u : Fin r → M₀),
      Ψ (exteriorPower.ιMulti R r₁ v ⊗ₜ[R] exteriorPower.ιMulti R r fun i => π (u i)) =
        exteriorPower.ιMulti R (r₁ + r) (Fin.append (fun j => α (v j)) u))
    (hsurj : Function.Surjective Ψ) :
    ∃ w : Fin r → M₀, IsUnit (c₀.det (Fin.append (fun j => α (b j)) w)) := by
  classical
  by_contra hcon
  simp only [not_exists] at hcon
  have hdual : ∀ v : Fin (r₁ + r) → M₀,
      basisTopDual c₀ (exteriorPower.ιMulti R (r₁ + r) v) = c₀.det v :=
    fun v => exteriorPower.alternatingMapLinearEquiv_apply_ιMulti c₀.det v
  set φ : (⋀[R]^r F) →ₗ[R] R :=
    (basisTopDual c₀).comp (Ψ.comp (TensorProduct.mk R (⋀[R]^r₁ M₁) (⋀[R]^r F)
      (exteriorPower.ιMulti R r₁ (b : Fin r₁ → M₁))))
  have hφapp : ∀ y : ⋀[R]^r F,
      φ y = basisTopDual c₀ (Ψ (exteriorPower.ιMulti R r₁ (b : Fin r₁ → M₁) ⊗ₜ[R] y)) :=
    fun _ => rfl
  have hmem : ∀ y : ⋀[R]^r F, φ y ∈ IsLocalRing.maximalIdeal R := by
    intro y
    have hy : y ∈ Submodule.span R (Set.range (exteriorPower.ιMulti R r (M := F))) := by
      rw [exteriorPower.ιMulti_span]
      exact Submodule.mem_top
    induction hy using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨f, rfl⟩ := hz
      choose u hu using fun i => hπ (f i)
      have hf : (fun i => π (u i)) = f := funext hu
      rw [← hf, hφapp, hΨ, hdual]
      exact (IsLocalRing.mem_maximalIdeal _).2 (hcon u)
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | add z z' _ _ hz hz' => rw [map_add]; exact Submodule.add_mem _ hz hz'
    | smul t z _ hz => rw [map_smul]; exact Submodule.smul_mem _ _ hz
  obtain ⟨z, hz⟩ := hsurj (exteriorPower.ιMulti R (r₁ + r) (c₀ : Fin (r₁ + r) → M₀))
  obtain ⟨y, rfl⟩ := exists_tmul_of_span_singleton_eq_top
    (exteriorPower.ιMulti R r₁ (b : Fin r₁ → M₁)) (span_singleton_ιMulti_basis b) z
  have h1 : φ y = 1 := by rw [hφapp, hz, basisTopDual_apply]
  exact mem_nonunits_iff.1 ((IsLocalRing.mem_maximalIdeal 1).1 (h1 ▸ hmem y)) isUnit_one

/-- **Over a local ring, surjectivity of a map satisfying the wedge-and-lift formula of
[Stacks, Tag 0E9Y] produces an adapted basis of `M₀`**: a basis whose first `r₁` members are the
images under `α` of a basis of `M₁`. -/
theorem exists_adapted_basis_of_surjective_wedge_formula [IsLocalRing R] {r₁ r : ℕ}
    (α : M₁ →ₗ[R] M₀) (b : Module.Basis (Fin r₁) R M₁) (π : M₀ →ₗ[R] F)
    (hπ : Function.Surjective π) (c₀ : Module.Basis (Fin (r₁ + r)) R M₀)
    (Ψ : ((⋀[R]^r₁ M₁) ⊗[R] (⋀[R]^r F)) →ₗ[R] ⋀[R]^(r₁ + r) M₀)
    (hΨ : ∀ (v : Fin r₁ → M₁) (u : Fin r → M₀),
      Ψ (exteriorPower.ιMulti R r₁ v ⊗ₜ[R] exteriorPower.ιMulti R r fun i => π (u i)) =
        exteriorPower.ιMulti R (r₁ + r) (Fin.append (fun j => α (v j)) u))
    (hsurj : Function.Surjective Ψ) :
    ∃ (w : Fin r → M₀) (c : Module.Basis (Fin (r₁ + r)) R M₀),
      ∀ i, c i = Fin.append (fun j => α (b j)) w i := by
  classical
  obtain ⟨w, hw⟩ := exists_isUnit_det_of_surjective_wedge_formula α b π hπ c₀ Ψ hΨ hsurj
  obtain ⟨hind, hspan⟩ := (Module.Basis.is_basis_iff_det c₀).2 hw
  exact ⟨w, Module.Basis.mk hind hspan.ge, fun i => Module.Basis.mk_apply _ _ i⟩

/-- **The converse half of the criterion of [Stacks, Tag 0E9Y], over a local ring: the cokernel
is free of rank `r`.** Let `M₁ --α--> M₀ --π--> F ⟶ 0` be right exact over a local ring with
`M₁` free of rank `r₁` and `M₀` free of rank `r₁ + r`. If **some** linear map

`Ψ : ⋀^{r₁} M₁ ⊗ ⋀^{r} F ⟶ ⋀^{r₁+r} M₀`

satisfying the wedge-and-lift formula of Tag 0E9Y is surjective, then `F` is free of rank `r`. -/
theorem nonempty_basis_of_surjective_wedge_formula [IsLocalRing R] {r₁ r : ℕ}
    (α : M₁ →ₗ[R] M₀) (b : Module.Basis (Fin r₁) R M₁) (π : M₀ →ₗ[R] F)
    (hπ : Function.Surjective π) (hex : LinearMap.range α = LinearMap.ker π)
    (c₀ : Module.Basis (Fin (r₁ + r)) R M₀)
    (Ψ : ((⋀[R]^r₁ M₁) ⊗[R] (⋀[R]^r F)) →ₗ[R] ⋀[R]^(r₁ + r) M₀)
    (hΨ : ∀ (v : Fin r₁ → M₁) (u : Fin r → M₀),
      Ψ (exteriorPower.ιMulti R r₁ v ⊗ₜ[R] exteriorPower.ιMulti R r fun i => π (u i)) =
        exteriorPower.ιMulti R (r₁ + r) (Fin.append (fun j => α (v j)) u))
    (hsurj : Function.Surjective Ψ) :
    Nonempty (Module.Basis (Fin r) R F) := by
  obtain ⟨w, c, hc⟩ := exists_adapted_basis_of_surjective_wedge_formula α b π hπ c₀ Ψ hΨ hsurj
  exact ⟨basisOfAdapted α b π hπ hex w c hc⟩

/-- **The criterion of [Stacks, Tag 0E9Y] over a local ring, as an equivalence.** For a
right-exact presentation `M₁ --α--> M₀ --π--> F ⟶ 0` over a local ring with `M₁` free of rank
`r₁` and `M₀` free of rank `r₁ + r`, and any map satisfying the wedge-and-lift formula of
Tag 0E9Y, the following are equivalent: the map is bijective, the map is surjective, and `F` is
free of rank `r`. -/
theorem bijective_wedge_formula_iff [IsLocalRing R] {r₁ r : ℕ}
    (α : M₁ →ₗ[R] M₀) (b : Module.Basis (Fin r₁) R M₁) (π : M₀ →ₗ[R] F)
    (hπ : Function.Surjective π) (hex : LinearMap.range α = LinearMap.ker π)
    (c₀ : Module.Basis (Fin (r₁ + r)) R M₀)
    (Ψ : ((⋀[R]^r₁ M₁) ⊗[R] (⋀[R]^r F)) →ₗ[R] ⋀[R]^(r₁ + r) M₀)
    (hΨ : ∀ (v : Fin r₁ → M₁) (u : Fin r → M₀),
      Ψ (exteriorPower.ιMulti R r₁ v ⊗ₜ[R] exteriorPower.ιMulti R r fun i => π (u i)) =
        exteriorPower.ιMulti R (r₁ + r) (Fin.append (fun j => α (v j)) u)) :
    Function.Bijective Ψ ↔ Nonempty (Module.Basis (Fin r) R F) :=
  ⟨fun h => nonempty_basis_of_surjective_wedge_formula α b π hπ hex c₀ Ψ hΨ h.surjective,
    fun ⟨d⟩ => bijective_of_wedge_formula α b π hπ hex c₀ d Ψ hΨ⟩

end LocalRing

/-! ### The converse half of the criterion at a point of a space -/

section Space

variable {X : TopCat.{u}} {Osharp : Sheaf (Opens.grothendieckTopology ↥X) CommRingCat.{u}}
  {E₁ E₀ F : _root_.SheafOfModules.{u} (toRingCat (Opens.grothendieckTopology ↥X) Osharp)}

variable (A₁ : _root_.SheafOfModules.TensorExteriorSymmetricAlgebras
    (Opens.grothendieckTopology ↥X) E₁)
  (A₀ : _root_.SheafOfModules.TensorExteriorSymmetricAlgebras
    (Opens.grothendieckTopology ↥X) E₀)
  (AF : _root_.SheafOfModules.TensorExteriorSymmetricAlgebras
    (Opens.grothendieckTopology ↥X) F)
  (α : E₁ ⟶ E₀) (π : E₀ ⟶ F) (hαπ : α ≫ π = 0)
  (hS : (ShortComplex.mk α π hαπ).Exact) (r₁ r : ℕ)

/-- **The converse half of the isomorphism criterion of [Stacks, Tag 0E9Y] at a point**, for the
transported stalk map: if the stalk of the sheaf of rings is a local ring, the stalks of `E₁`
and `E₀` are free of ranks `r₁` and `r₁ + r`, and the stalk of the pairing is
surjective, then the stalk `Fₓ` is free of rank `r`. -/
theorem nonempty_basis_stalk_of_surjective_detStalkPairing [Epi π]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r₁]
    (x : ↥X) [IsLocalRing ↑(TopCat.Presheaf.stalk Osharp.obj x)]
    (b : Module.Basis (Fin r₁) ↑(TopCat.Presheaf.stalk Osharp.obj x)
      ↑(TopCat.Presheaf.stalk E₁.val.presheaf x))
    (c₀ : Module.Basis (Fin (r₁ + r)) ↑(TopCat.Presheaf.stalk Osharp.obj x)
      ↑(TopCat.Presheaf.stalk E₀.val.presheaf x))
    (hsurj : Function.Surjective (detStalkPairing A₁ A₀ AF α π hαπ hS r₁ r x)) :
    Nonempty (Module.Basis (Fin r) ↑(TopCat.Presheaf.stalk Osharp.obj x)
      ↑(TopCat.Presheaf.stalk F.val.presheaf x)) :=
  nonempty_basis_of_surjective_wedge_formula (PresheafOfModules.stalkMapL x α.val) b
    (PresheafOfModules.stalkMapL x π.val) (surjective_stalkMapL π x)
    (range_stalkMapL_eq_ker_stalkMapL α π hαπ hS x) c₀
    (detStalkPairing A₁ A₀ AF α π hαπ hS r₁ r x)
    (detStalkPairing_wedge A₁ A₀ AF α π hαπ hS r₁ r x) hsurj

/-- **The converse half of the isomorphism criterion of [Stacks, Tag 0E9Y] at a point**, as a
statement about the stalk map of the sheaf morphism itself: if the stalk of the sheaf of rings
is a local ring, the stalks of `E₁` and `E₀` are free of ranks `r₁` and `r₁ + r`, and
`Stacks.Duality.detSheafPairing` is bijective on the stalk at `x`, then `Fₓ` is free of rank
`r`. -/
theorem nonempty_basis_stalk_of_bijective_stalkMapL_detSheafPairing [Epi π]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r₁]
    (x : ↥X) [IsLocalRing ↑(TopCat.Presheaf.stalk Osharp.obj x)]
    (b : Module.Basis (Fin r₁) ↑(TopCat.Presheaf.stalk Osharp.obj x)
      ↑(TopCat.Presheaf.stalk E₁.val.presheaf x))
    (c₀ : Module.Basis (Fin (r₁ + r)) ↑(TopCat.Presheaf.stalk Osharp.obj x)
      ↑(TopCat.Presheaf.stalk E₀.val.presheaf x))
    (hbij : Function.Bijective (PresheafOfModules.stalkMapL x
      (detSheafPairing A₁ A₀ AF α π hαπ hS r₁ r).val)) :
    Nonempty (Module.Basis (Fin r) ↑(TopCat.Presheaf.stalk Osharp.obj x)
      ↑(TopCat.Presheaf.stalk F.val.presheaf x)) := by
  refine nonempty_basis_stalk_of_surjective_detStalkPairing A₁ A₀ AF α π hαπ hS r₁ r x b c₀ ?_
  have h : Function.Bijective
      ((A₀.exteriorPowerStalkEquiv (r₁ + r) x) ∘
        (PresheafOfModules.stalkMapL x (detSheafPairing A₁ A₀ AF α π hαπ hS r₁ r).val) ∘
          (detStalkSource A₁ AF r₁ r x)) :=
    (A₀.exteriorPowerStalkEquiv (r₁ + r) x).bijective.comp
      (hbij.comp (detStalkSource A₁ AF r₁ r x).bijective)
  exact h.surjective

/-- **The isomorphism criterion of [Stacks, Tag 0E9Y] at a point, as an equivalence.** For a
right-exact sequence `E₁ ⟶ E₀ ⟶ F ⟶ 0` of sheaves of modules on a space, with `E₁` and `E₀`
finite locally free of ranks `r₁` and `r₁ + r` and the stalk of the sheaf of rings at `x` a
local ring, the pairing

`⋀^{r₁} E₁ ⊗ ⋀^{r} F ⟶ ⋀^{r₁+r} E₀`

is bijective on the stalk at `x` **if and only if** the stalk `Fₓ` is free of rank `r`. -/
theorem bijective_stalkMapL_detSheafPairing_iff [Epi π]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₀ (r₁ + r)]
    (x : ↥X) [IsLocalRing ↑(TopCat.Presheaf.stalk Osharp.obj x)] :
    Function.Bijective (PresheafOfModules.stalkMapL x
        (detSheafPairing A₁ A₀ AF α π hαπ hS r₁ r).val) ↔
      Nonempty (Module.Basis (Fin r) ↑(TopCat.Presheaf.stalk Osharp.obj x)
        ↑(TopCat.Presheaf.stalk F.val.presheaf x)) := by
  obtain ⟨e₁⟩ := nonempty_stalkLinearEquiv_finsupp E₁ r₁ x
  obtain ⟨e₀⟩ := nonempty_stalkLinearEquiv_finsupp E₀ (r₁ + r) x
  refine ⟨fun hbij => nonempty_basis_stalk_of_bijective_stalkMapL_detSheafPairing A₁ A₀ AF α π
      hαπ hS r₁ r x (Module.Basis.ofRepr e₁) (Module.Basis.ofRepr e₀) hbij, fun hF => ?_⟩
  obtain ⟨dF⟩ := hF
  exact bijective_stalkMapL_detSheafPairing A₁ A₀ AF α π hαπ hS r₁ r x
    (Module.Basis.ofRepr e₁) (Module.Basis.ofRepr e₀) dF

/-- **The criterion of [Stacks, Tag 0E9Y] for an isomorphism of sheaves, as an equivalence.** On
a space all of whose structure-sheaf stalks are local rings, with `E₁` and `E₀` finite locally
free of ranks `r₁` and `r₁ + r`, the pairing is an isomorphism of sheaves of modules
**if and only if** every stalk of `F` is free of rank `r`. -/
theorem isIso_detSheafPairing_iff [Epi π]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₀ (r₁ + r)]
    (hloc : ∀ x : ↥X, IsLocalRing ↑(TopCat.Presheaf.stalk Osharp.obj x)) :
    IsIso (detSheafPairing A₁ A₀ AF α π hαπ hS r₁ r) ↔
      ∀ x : ↥X, Nonempty (Module.Basis (Fin r) ↑(TopCat.Presheaf.stalk Osharp.obj x)
        ↑(TopCat.Presheaf.stalk F.val.presheaf x)) := by
  rw [AlgebraicGeometry.SheafOfModules.isIso_iff_bijective_stalkMap
    (detSheafPairing A₁ A₀ AF α π hαπ hS r₁ r)]
  refine forall_congr' fun x => ?_
  have := hloc x
  exact bijective_stalkMapL_detSheafPairing_iff A₁ A₀ AF α π hαπ hS r₁ r x

/-- **The converse half of the criterion of [Stacks, Tag 0E9Y] for an isomorphism of sheaves**:
if the pairing is an isomorphism of sheaves of modules, then every stalk of `F` is free of
rank `r`. -/
theorem nonempty_basis_stalk_of_isIso_detSheafPairing [Epi π]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₀ (r₁ + r)]
    (hiso : IsIso (detSheafPairing A₁ A₀ AF α π hαπ hS r₁ r))
    (x : ↥X) [IsLocalRing ↑(TopCat.Presheaf.stalk Osharp.obj x)] :
    Nonempty (Module.Basis (Fin r) ↑(TopCat.Presheaf.stalk Osharp.obj x)
      ↑(TopCat.Presheaf.stalk F.val.presheaf x)) :=
  (bijective_stalkMapL_detSheafPairing_iff A₁ A₀ AF α π hαπ hS r₁ r x).1
    ((AlgebraicGeometry.SheafOfModules.isIso_iff_bijective_stalkMap
      (detSheafPairing A₁ A₀ AF α π hαπ hS r₁ r)).1 hiso x)

/-! ### From freeness of the stalk to freeness on a neighbourhood -/

section Neighbourhood

/-- **A basis of the stalk of a sheaf of modules, read over the `RingCat`-valued stalk of the
sheaf of rings.** A basis of the stalk of `M` at `x` over the stalk of the `CommRingCat`-valued
sheaf of rings `Osharp`, transported along `SemilinearStalk.commStalkRingEquiv` to a basis over
the stalk of the `RingCat`-valued sheaf of rings `(toRingCat _ Osharp).obj`. -/
noncomputable def basisRingCatStalk
    (M : _root_.SheafOfModules.{u} (toRingCat (Opens.grothendieckTopology ↥X) Osharp))
    (x : ↥X) {ρ : Type u}
    (b : Module.Basis ρ ↑(TopCat.Presheaf.stalk Osharp.obj x)
      ↑(TopCat.Presheaf.stalk M.val.presheaf x)) :
    Module.Basis ρ (ToType (TopCat.Presheaf.stalk
        (toRingCat (Opens.grothendieckTopology ↥X) Osharp).obj x))
      (ToType (TopCat.Presheaf.stalk M.val.presheaf x)) :=
  b.mapCoeffs (SemilinearStalk.commStalkRingEquiv Osharp.obj x).symm fun c m => by
    rw [← SemilinearStalk.comm_smul_eq Osharp.obj x M.val
      ((SemilinearStalk.commStalkRingEquiv Osharp.obj x).symm c) m,
      RingEquiv.apply_symm_apply]

include hS in
/-- **`F` is of finite presentation**, for a right-exact sequence `E₁ ⟶ E₀ ⟶ F ⟶ 0` with `E₁`
and `E₀` finite locally free of ranks `r₁` and `r₀`. -/
theorem isFinitePresentation_of_exact [Epi π] (r₀ : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₀ r₀] :
    F.IsFinitePresentation := by
  let : HasSheafify (Opens.grothendieckTopology ↥X) AddCommGrpCat.{u} :=
    AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective
  let : E₀.IsFinitePresentation :=
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFinitePresentation E₀ r₀
  let := AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteType E₁ r₁
  have e : CategoryTheory.Limits.cokernel α ≅ F :=
    (CategoryTheory.Limits.cokernelIsCokernel α).coconePointUniqueUpToIso hS.gIsCokernel
  let : (CategoryTheory.Limits.cokernel α).IsFinitePresentation :=
    Stacks.SheafOfModules.isFinitePresentation_cokernel α
  exact (_root_.SheafOfModules.isFinitePresentation
    (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).prop_of_iso e inferInstance

/-- **The converse half of the isomorphism criterion of [Stacks, Tag 0E9Y] on a neighbourhood:
`F` is free of rank `r` on an open neighbourhood of `x`.** If the stalk of the
sheaf of rings at `x` is a local ring, `E₁` and `E₀` are finite locally free of ranks `r₁` and
`r₁ + r` and the pairing is bijective on the stalk at `x`, then `F` restricted to some
open neighbourhood of `x` is isomorphic to the free sheaf of modules of rank `r`. -/
theorem exists_nhd_iso_free_of_bijective_stalkMapL_detSheafPairing [Epi π]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₀ (r₁ + r)]
    (x : ↥X) [IsLocalRing ↑(TopCat.Presheaf.stalk Osharp.obj x)]
    (hbij : Function.Bijective (PresheafOfModules.stalkMapL x
      (detSheafPairing A₁ A₀ AF α π hαπ hS r₁ r).val)) :
    ∃ U : Opens ↥X, x ∈ U ∧
      Nonempty (F.over U ≅ _root_.SheafOfModules.free (ULift.{u} (Fin r))) := by
  let : F.IsFinitePresentation := isFinitePresentation_of_exact α π hαπ hS r₁ (r₁ + r)
  obtain ⟨dF⟩ := (bijective_stalkMapL_detSheafPairing_iff A₁ A₀ AF α π hαπ hS r₁ r x).1 hbij
  exact Stacks.SheafOfModules.nonempty_over_iso_free_of_stalk_basis F x
    (basisRingCatStalk F x (dF.reindex Equiv.ulift.symm))

end Neighbourhood

end Space

/-! ### The criterion as an equivalence on a ringed space and on a locally ringed space -/

section RingedSpace

open _root_.Stacks.AlgebraicGeometry RingedSpaceModuleAdjunction

variable (Y : AlgebraicGeometry.RingedSpace.{u, u})
  {E₁ E₀ F : _root_.SheafOfModules.{u}
    (toRingCat (Opens.grothendieckTopology ↥Y.carrier) Y.sheaf)}
  (α : E₁ ⟶ E₀) (π : E₀ ⟶ F) (hαπ : α ≫ π = 0)
  (hS : (ShortComplex.mk α π hαπ).Exact) (r₁ r : ℕ)

/-- **The isomorphism criterion of [Stacks, Tag 0E9Y] at a point, as an equivalence, for *the*
exterior powers of a ringed space.** The criterion
`Stacks.Duality.bijective_stalkMapL_detSheafPairing_iff` for the exterior powers
`SheafOfModules.ringedSpaceAlgebras` of the ringed space `Y`. -/
theorem bijective_stalkMapL_ringedSpaceDetSheafPairing_iff [Epi π]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₀ (r₁ + r)]
    (x : ↥Y.carrier) (hloc : IsLocalRing ↑(TopCat.Presheaf.stalk Y.sheaf.obj x)) :
    Function.Bijective (PresheafOfModules.stalkMapL x
        (ringedSpaceDetSheafPairing Y α π hαπ hS r₁ r).val) ↔
      Nonempty (Module.Basis (Fin r) ↑(TopCat.Presheaf.stalk Y.sheaf.obj x)
        ↑(TopCat.Presheaf.stalk F.val.presheaf x)) :=
  have : IsLocalRing ↑(TopCat.Presheaf.stalk Y.presheaf x) := hloc
  bijective_stalkMapL_detSheafPairing_iff (_root_.SheafOfModules.ringedSpaceAlgebras Y E₁)
    (_root_.SheafOfModules.ringedSpaceAlgebras Y E₀)
    (_root_.SheafOfModules.ringedSpaceAlgebras Y F) α π hαπ hS r₁ r x

/-- **The converse half of the criterion of [Stacks, Tag 0E9Y] on a neighbourhood, for *the*
exterior powers of a ringed space**: `F` is free of rank `r` on an open neighbourhood of `x`. -/
theorem exists_nhd_iso_free_of_bijective_stalkMapL_ringedSpaceDetSheafPairing [Epi π]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₀ (r₁ + r)]
    (x : ↥Y.carrier) (hloc : IsLocalRing ↑(TopCat.Presheaf.stalk Y.sheaf.obj x))
    (hbij : Function.Bijective (PresheafOfModules.stalkMapL x
      (ringedSpaceDetSheafPairing Y α π hαπ hS r₁ r).val)) :
    ∃ U : Opens ↥Y.carrier, x ∈ U ∧
      Nonempty (F.over U ≅ _root_.SheafOfModules.free (ULift.{u} (Fin r))) :=
  have : IsLocalRing ↑(TopCat.Presheaf.stalk Y.presheaf x) := hloc
  exists_nhd_iso_free_of_bijective_stalkMapL_detSheafPairing
    (_root_.SheafOfModules.ringedSpaceAlgebras Y E₁)
    (_root_.SheafOfModules.ringedSpaceAlgebras Y E₀)
    (_root_.SheafOfModules.ringedSpaceAlgebras Y F) α π hαπ hS r₁ r x hbij

end RingedSpace

section LocallyRingedSpace

open _root_.Stacks.AlgebraicGeometry RingedSpaceModuleAdjunction

variable (Y : AlgebraicGeometry.LocallyRingedSpace.{u})
  {E₁ E₀ F : _root_.SheafOfModules.{u}
    (toRingCat (Opens.grothendieckTopology ↥Y.toRingedSpace.carrier) Y.toRingedSpace.sheaf)}
  (α : E₁ ⟶ E₀) (π : E₀ ⟶ F) (hαπ : α ≫ π = 0)
  (hS : (ShortComplex.mk α π hαπ).Exact) (r₁ r : ℕ)

/-- **The isomorphism criterion of [Stacks, Tag 0E9Y] on a locally ringed space, as an
equivalence.** For a right-exact sequence
`E₁ ⟶ E₀ ⟶ F ⟶ 0` of sheaves of modules on a `LocallyRingedSpace` with `E₁` and `E₀` finite
locally free of ranks `r₁` and `r₁ + r`, the pairing

`⋀^{r₁} E₁ ⊗ ⋀^{r} F ⟶ ⋀^{r₁+r} E₀`

is bijective on the stalk at `x` **if and only if** the stalk `Fₓ` is free of rank `r`. -/
theorem bijective_stalkMapL_locallyRingedSpaceDetSheafPairing_iff [Epi π]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₀ (r₁ + r)]
    (x : ↥Y.toRingedSpace.carrier) :
    Function.Bijective (PresheafOfModules.stalkMapL x
        (ringedSpaceDetSheafPairing Y.toRingedSpace α π hαπ hS r₁ r).val) ↔
      Nonempty (Module.Basis (Fin r)
        ↑(TopCat.Presheaf.stalk Y.toRingedSpace.sheaf.obj x)
        ↑(TopCat.Presheaf.stalk F.val.presheaf x)) :=
  bijective_stalkMapL_ringedSpaceDetSheafPairing_iff Y.toRingedSpace α π hαπ hS r₁ r x
    (Y.isLocalRing x)

/-- **The converse half of the isomorphism criterion of [Stacks, Tag 0E9Y] on a locally ringed
space, on a neighbourhood.** For a right-exact sequence `E₁ ⟶ E₀ ⟶ F ⟶ 0` of
sheaves of modules on a `LocallyRingedSpace` with `E₁` and `E₀` finite locally free of ranks `r₁`
and `r₁ + r`, bijectivity of the pairing on the stalk at `x` implies that `F` is free
of rank `r` on an open neighbourhood of `x`. -/
theorem exists_nhd_iso_free_of_bijective_stalkMapL_locallyRingedSpaceDetSheafPairing [Epi π]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ r₁]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₀ (r₁ + r)]
    (x : ↥Y.toRingedSpace.carrier)
    (hbij : Function.Bijective (PresheafOfModules.stalkMapL x
      (ringedSpaceDetSheafPairing Y.toRingedSpace α π hαπ hS r₁ r).val)) :
    ∃ U : Opens ↥Y.toRingedSpace.carrier, x ∈ U ∧
      Nonempty (F.over U ≅ _root_.SheafOfModules.free (ULift.{u} (Fin r))) :=
  exists_nhd_iso_free_of_bijective_stalkMapL_ringedSpaceDetSheafPairing Y.toRingedSpace α π hαπ hS
    r₁ r x (Y.isLocalRing x) hbij

end LocallyRingedSpace

end Stacks.Duality

