module

public import StacksFrontier.AlgebraicGeometry.Duality.BlowupBaseChange.Setup
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.ProjectiveSpace.IdealSheafOfHypersurface
public import StacksFrontier.AlgebraicGeometry.Blowup.ProjectiveLineIdealOfEquations
public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.Cover
public import StacksFrontier.RingTheory.MvPolynomial.VariablesRegular

/-!
# The blowup of the affine plane is an effective Cartier divisor in `𝐏¹`

Let `k` be a field, `Y = 𝐀²_k = Spec k[x, y]` and `X` the blowup of `Y` in the origin. The
generators `x, y` of the ideal of the origin present the Rees algebra as
`k[x, y][T₀, T₁] / (yT₀ - xT₁)`, because `y, x` is a regular sequence; and this relation ideal is
saturated. Hence the closed immersion `ι : X ⟶ 𝐏¹_Y` has homogeneous ideal `(yT₀ - xT₁)`, and on
the standard chart `D₊(Tⱼ)` its ideal sheaf is generated by `(yT₀ - xT₁)/Tⱼ`. The chart ring is a
polynomial ring over `k[x, y]`, a domain, and this fraction is nonzero, so it is a nonzerodivisor:
`X` is an effective Cartier divisor in `𝐏¹_Y`. The blowup morphism `X ⟶ Y` is `ι` followed by the
structure morphism of `𝐏¹_Y`.

## Main results

* `Stacks.Duality.BlowupBaseChange.idealOfClosedSubscheme_ι`: the homogeneous ideal of `X` inside
  `𝐏¹_Y` is generated by `yT₀ - xT₁`.
* `Stacks.Duality.BlowupBaseChange.isEffectiveCartierDivisor_ker_ι`: `X` is an effective Cartier
  divisor in `𝐏¹_Y`.
* `Stacks.Duality.BlowupBaseChange.f_eq_ι_comp`: the blowup morphism factors through `𝐏¹_Y`.

## References

* [Stacks Project, Tag 0AAC](https://stacks.math.columbia.edu/tag/0AAC)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open Stacks.AlgebraicGeometry.ProjPolyChart

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

namespace Stacks.Duality.BlowupBaseChange

variable (k : Type u) [Field k]

/-- The coordinates `x, y` of `𝐀²_k`, in the order `y, x`, form a weakly regular sequence. -/
theorem isWeaklyRegular_X_one_X_zero :
    RingTheory.Sequence.IsWeaklyRegular (A k)
      [(MvPolynomial.X 1 : A k), MvPolynomial.X 0] := by
  rw [RingTheory.Sequence.isWeaklyRegular_iff]
  intro i hi
  rw [MvPolynomial.ideal_smul_top, isSMulRegular_iff_right_eq_zero_of_smul]
  intro z hz
  obtain ⟨g, rfl⟩ := Submodule.Quotient.mk_surjective _ z
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hz
  rw [Submodule.Quotient.mk_eq_zero]
  simp only [List.length_cons, List.length_nil] at hi
  interval_cases i
  · simp only [List.take_zero, Ideal.ofList_nil, List.getElem_cons_zero, smul_eq_mul,
      Ideal.mem_bot, mul_eq_zero, MvPolynomial.X_ne_zero, false_or] at hz ⊢
    exact hz
  · have hset : {r : A k | r ∈ ([MvPolynomial.X 1, MvPolynomial.X 0] : List (A k)).take 1} =
        (MvPolynomial.X '' {(1 : Fin 2)} : Set (A k)) := by
      ext r; simp
    simp only [Ideal.ofList, hset, List.getElem_cons_succ, List.getElem_cons_zero,
      smul_eq_mul] at hz ⊢
    exact MvPolynomial.mem_span_X_image_of_X_mul_mem (by simp) hz

/-- The defining equation `y T₀ - x T₁` of the blowup inside `𝐏¹_{𝐀²_k}`. -/
abbrev relation : MvPolynomial (Fin 2) (A k) :=
  MvPolynomial.C (MvPolynomial.X 1) * MvPolynomial.X 0 -
    MvPolynomial.C (MvPolynomial.X 0) * MvPolynomial.X 1

/-- The homogeneous ideal of the blowup inside `𝐏¹_{𝐀²_k}` is generated by `y T₀ - x T₁`. -/
theorem idealOfClosedSubscheme_ι :
    ProjectiveSpectrum.Proj.idealOfClosedSubscheme (polyGrading (A k) 1) (ι k) =
      Ideal.span {relation k} := by
  have hx : ∀ i, (MvPolynomial.X i : A k) ∈ origin k := fun i => Ideal.subset_span ⟨i, rfl⟩
  have hreg := isWeaklyRegular_X_one_X_zero k
  have hle := AlgebraicGeometry.Proj.irrelevant_le_map_of_surjective
    (Stacks.Blowup.reesPresentation (origin k) MvPolynomial.X hx)
    (Stacks.Blowup.surjective_reesPresentation (origin k) MvPolynomial.X hx rfl)
  have : IsClosedImmersion (AlgebraicGeometry.Proj.map _ hle) :=
    Stacks.Blowup.isClosedImmersion_blowUpSpecToProjSpace (origin k) MvPolynomial.X hx rfl
  exact ProjectiveSpectrum.Proj.idealOfClosedSubscheme_map_eq_of_ker_eq_of_saturated _
    (Stacks.Blowup.reesGrading (origin k))
    (Stacks.Blowup.reesPresentation (origin k) MvPolynomial.X hx) hle
    (MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top (Fin 2) (A k)) _
    (Stacks.Blowup.ker_reesPresentation_eq_span_relation MvPolynomial.X (origin k) hx hreg)
    (fun _ ⟨_, h⟩ => Stacks.Blowup.mem_span_relation_of_forall_homogeneous_mul_mem
      MvPolynomial.X hreg (fun a ha => by simpa using ha) h)

/-- The blowup is cut out of `𝐏¹_{𝐀²_k}` by one local equation, a nonzerodivisor. -/
theorem isEffectiveCartierDivisor_ker_ι :
    Stacks.Divisors.IsEffectiveCartierDivisor (ι k).ker := by
  refine Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen _ fun p => ?_
  have hp : p ∈ (⨆ j : Fin (1 + 1),
      AlgebraicGeometry.Proj.basicOpen (polyGrading (A k) 1) (MvPolynomial.X j)) := by
    rw [iSup_basicOpen_X_eq_top]; trivial
  obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.1 hp
  have hf := X_mem_one (A k) 1 j
  have hF : relation k ∈ polyGrading (A k) 1 (1 • 1) := by
    simpa using Stacks.Blowup.isHomogeneous_relation (MvPolynomial.X : Fin 2 → A k)
  have hU := AlgebraicGeometry.Proj.isAffineOpen_basicOpen (polyGrading (A k) 1)
    (MvPolynomial.X j) hf Nat.one_pos
  refine ⟨_, hU, hj, ProjectiveSpectrum.Proj.chartFraction _ hf 1 ⟨relation k, hF⟩, ?_, ?_⟩
  · have : Nonempty (AlgebraicGeometry.Proj.basicOpen (polyGrading (A k) 1)
        (MvPolynomial.X j)) := ⟨⟨genericPoint (A k) 1, genericPoint_mem_basicOpen_X _ _ j⟩⟩
    refine isRegular_iff_ne_zero.mpr ?_
    intro h0
    have hinj : Function.Injective
        (AlgebraicGeometry.Proj.awayToSection (polyGrading (A k) 1) (MvPolynomial.X j)).hom :=
      (AlgebraicGeometry.Proj.basicOpenIsoAway (polyGrading (A k) 1) (MvPolynomial.X j) hf
        Nat.one_pos).commRingCatIsoToRingEquiv.injective
    have h1 := hinj (h0.trans (map_zero _).symm)
    have h2 := congrArg HomogeneousLocalization.val h1
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_zero,
      Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff] at h2
    obtain ⟨⟨m, ⟨e, rfl⟩⟩, hm⟩ := h2
    have hne : relation k ≠ 0 := by
      intro hz
      have := congrArg (MvPolynomial.eval ![(1 : A k), 0]) hz
      simp at this
    exact hne ((mul_eq_zero.1 hm).resolve_left (pow_ne_zero _ (MvPolynomial.X_ne_zero _)))
  · rw [Scheme.Hom.ker_apply]
    exact ProjectiveSpectrum.Proj.ker_app_basicOpen_of_idealOfClosedSubscheme_eq_span _
      (MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top (Fin (1 + 1)) (A k)) hf (ι k)
      ⟨relation k, hF⟩ (idealOfClosedSubscheme_ι k)

/-- The structure morphism `Proj R[T₀, T₁] ⟶ Spec R` of the blowup file and that of the
projective chart file agree. -/
theorem projSpaceToSpec_eq_projToSpecCoeff (R : Type u) [CommRing R] :
    Stacks.Blowup.projSpaceToSpec R 2 = projToSpecCoeff R 1 := by
  rw [Stacks.Blowup.projSpaceToSpec, projToSpecCoeff]
  congr 3
  ext r : 1
  change AlgebraicGeometry.ProjectiveSpace.gradeZeroEquiv (Fin 2) R r =
    GradedRing.projZeroRingHom' (MvPolynomial.homogeneousSubmodule (Fin 2) R)
      (algebraMap R (MvPolynomial (Fin 2) R) r)
  rw [← SetLike.GradeZero.coe_algebraMap (MvPolynomial.homogeneousSubmodule (Fin 2) R) r,
    GradedRing.projZeroRingHom'_apply_coe]
  rfl

/-- The blowup morphism factors through `𝐏¹_{𝐀²_k}`. -/
theorem f_eq_ι_comp : f k = ι k ≫ projToSpecCoeff (A k) 1 := by
  rw [← projSpaceToSpec_eq_projToSpecCoeff]
  exact (Stacks.Blowup.blowUpSpecToProjSpace_comp_projSpaceToSpec (origin k) MvPolynomial.X
    (fun i => Ideal.subset_span ⟨i, rfl⟩) rfl).symm

end Stacks.Duality.BlowupBaseChange
