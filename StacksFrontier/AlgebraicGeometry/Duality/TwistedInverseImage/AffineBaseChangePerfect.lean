module

public import StacksFrontier.AlgebraicGeometry.Duality.TwistedInverseImage.AffineBaseChange
public import StacksFrontier.AlgebraicGeometry.Duality.UpperShriekComparisonCharts

/-!
# Base change of the twisted inverse image over an affine base: the perfect case

For a cartesian square of quasi-compact and quasi-separated schemes with `g : Y' ⟶ Y` a morphism
of affine schemes, `f` proper and perfect, `Y` Noetherian and `f`, `g` Tor independent, the base
change map `L(g')^* a(K) ⟶ a'(Lg^*K)` of [Stacks, Tag 0AA6] is invertible for every
`K ∈ D_QCoh(𝒪_Y)`: part (2) of [Stacks, Tag 0AA8].

By `Stacks.Duality.isIso_twistedInverseImageBaseChangeMap_app_of_isIso_compareWithPullbackTensor`
this is the invertibility of the comparison map `Lf^*J ⊗ᴸ a(K) ⟶ a(J ⊗ᴸ K)` at
`J = Rg_*𝒪_{Y'}`, which over an affine Noetherian base holds for all `J` and `K` because `a`
commutes with direct sums ([Stacks, Tag 0A9R]) and `D_QCoh(𝒪_Y)` is generated by `𝒪_Y`, whose
shifts are invertible: `Stacks.Duality.isIso_comparisonMap_of_isAffine`.
-/

-- This file uses the locally small derived-category models below, which are not
-- global instances (see `StacksFrontier.Homology.DerivedCategory.LocallySmall`):
-- `D(𝒪_X)` for a scheme.
attribute [local instance] AlgebraicGeometry.Scheme.Modules.hasDerivedCategory

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MonoidalCategory

universe u

namespace Stacks.Duality

variable {X' X Y' Y : Scheme.{u}} [CompactSpace X'] [QuasiSeparatedSpace X'] [CompactSpace X]
  [QuasiSeparatedSpace X] [CompactSpace Y'] [QuasiSeparatedSpace Y'] [CompactSpace Y]
  [QuasiSeparatedSpace Y] {g' : X' ⟶ X} {f' : X' ⟶ Y'} {f : X ⟶ Y} {g : Y' ⟶ Y}

/-- **The case of [Stacks, Tag 0AA8] (2) that [Stacks, Tag 0BZG] needs.** In a cartesian square
of quasi-compact and quasi-separated schemes, let `g : Y' ⟶ Y` be a morphism of affine schemes,
`f : X ⟶ Y` proper, and `f`, `g` Tor independent. If `f` is perfect and `Y` is Noetherian, the
base change map `L(g')^* a(K) ⟶ a'(Lg^*K)` of [Stacks, Tag 0AA6] is an isomorphism for every
`K ∈ D_QCoh(𝒪_Y)`. -/
theorem isIso_twistedInverseImageBaseChangeMap_app_of_perfect (sq : IsPullback g' f' f g)
    [IsAffine Y] [IsAffine Y'] [IsProper f] [AlgebraicGeometry.Perfect f] [IsNoetherian Y]
    (hTor : TorIndependent f g) (K : quasiCoherentDerivedCategory Y) :
    haveI := isIso_twistedInverseImagePushforwardBaseChange_of_torIndependent sq hTor
    IsIso ((twistedInverseImageBaseChangeMap g' f' f g
      (isQuasicoherent_homology_derivedPushforward_of_qcqs g')
      (isQuasicoherent_homology_derivedPushforward_of_qcqs f)
      (isQuasicoherent_homology_derivedPushforward_of_qcqs f')
      (isQuasicoherent_homology_derivedPushforward_of_qcqs g)
      sq).app K) := by
  refine isIso_twistedInverseImageBaseChangeMap_app_of_isIso_compareWithPullbackTensor sq
    hTor K ?_
  rw [compareWithPullbackTensor_eq_comparisonMap f _ _ (fun _ _ => rfl)]
  have := isIso_comparisonMap_of_isAffine f
    ((quasiCoherentDerivedPushforward g (isQuasicoherent_homology_derivedPushforward_of_qcqs g)).obj
      (𝟙_ (quasiCoherentDerivedCategory Y'))) K
  infer_instance

end Stacks.Duality
