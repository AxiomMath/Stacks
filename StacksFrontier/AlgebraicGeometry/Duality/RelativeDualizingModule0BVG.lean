* [Stacks Project, Tag 0BSZ](https://stacks.math.columbia.edu/tag/0BSZ)
* [Stacks Project, Tag 0BVG](https://stacks.math.columbia.edu/tag/0BVG)
-/

@[expose] public section

open Topology

universe u

namespace Stacks.Discriminant

section AwayCover

variable {R B : Type*} [CommRing R] [CommRing B] {φ : R →+* B}
  {ι : Type*} {ρ : ι → R}

/-- If the elements `φ (ρ i)` generate the unit ideal of `B`, then no prime of `B` contains
all of them. -/
theorem exists_notMem_of_span_eq_top
    (hspan : Ideal.span (Set.range fun i ↦ φ (ρ i)) = ⊤) (p : PrimeSpectrum B) :
    ∃ i, φ (ρ i) ∉ p.asIdeal := by
  by_contra! h
  refine p.isPrime.ne_top (top_le_iff.1 ?_)
  rw [← hspan, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  exact h i

variable (φ) in
/-- The square relating the two structure maps of the away localizations at `r` and at `φ r`:
`Localization.awayMap φ r` is a map of `R`-algebras over `φ`. -/
theorem awayMap_comp_algebraMap (r : R) :
    (Localization.awayMap φ r).comp (algebraMap R (Localization.Away r)) =
      (algebraMap B (Localization.Away (φ r))).comp φ :=
  IsLocalization.map_comp _

variable (φ) in
/-- The same square read on prime spectra: the chart `Spec B[1/φ r] → Spec R` factors both
through `Spec B` and through `Spec R[1/r]`. -/
theorem comap_comp_eq_of_away (r : R) :
    PrimeSpectrum.comap (algebraMap R (Localization.Away r)) ∘
        PrimeSpectrum.comap (Localization.awayMap φ r) =
      PrimeSpectrum.comap φ ∘
        PrimeSpectrum.comap (algebraMap B (Localization.Away (φ r))) := by
  rw [← PrimeSpectrum.comap_comp, ← PrimeSpectrum.comap_comp, awayMap_comp_algebraMap]

/-- The image of `Spec B` in `Spec R` is the union of the basic opens `D(rᵢ)`, when the
`D(φ rᵢ)` cover `Spec B` and `φ` becomes an isomorphism after inverting each `rᵢ`. -/
theorem range_comap_eq_iUnion_basicOpen_of_awayCover
    (hspan : Ideal.span (Set.range fun i ↦ φ (ρ i)) = ⊤)
    (hbij : ∀ i, Function.Bijective (Localization.awayMap φ (ρ i))) :
    Set.range (PrimeSpectrum.comap φ) =
      ⋃ i, (PrimeSpectrum.basicOpen (ρ i) : Set (PrimeSpectrum R)) := by
  apply Set.Subset.antisymm
  · rintro q ⟨p, rfl⟩
    obtain ⟨i, hi⟩ := exists_notMem_of_span_eq_top hspan p
    exact Set.mem_iUnion.2 ⟨i, (PrimeSpectrum.mem_basicOpen _ _).2 hi⟩
  · intro q hq
    obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hq
    rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away (ρ i)) (ρ i)] at hi
    obtain ⟨x, hx⟩ := hi
    obtain ⟨y, hy⟩ := (PrimeSpectrum.isHomeomorph_comap_of_bijective (hbij i)).bijective.2 x
    refine ⟨PrimeSpectrum.comap (algebraMap B (Localization.Away (φ (ρ i)))) y, ?_⟩
    have hsq := congrFun (comap_comp_eq_of_away φ (ρ i)) y
    simp only [Function.comp_apply] at hsq
    rw [← hsq, hy, hx]

/-- `PrimeSpectrum.comap φ` is an open embedding as soon as the basic opens `D(φ rᵢ)` cover
`Spec B` and `φ` becomes an isomorphism after inverting each `rᵢ`. -/
theorem isOpenEmbedding_comap_of_awayCover
    (hspan : Ideal.span (Set.range fun i ↦ φ (ρ i)) = ⊤)
    (hbij : ∀ i, Function.Bijective (Localization.awayMap φ (ρ i))) :
    IsOpenEmbedding (PrimeSpectrum.comap φ) := by
  have hmem : ∀ (i : ι) (p : PrimeSpectrum B), φ (ρ i) ∉ p.asIdeal →
      p ∈ Set.range (PrimeSpectrum.comap
        (algebraMap B (Localization.Away (φ (ρ i))))) := by
    intro i p hp
    rw [PrimeSpectrum.localization_away_comap_range _ (φ (ρ i))]
    exact (PrimeSpectrum.mem_basicOpen _ _).2 hp
  have hcomp : ∀ i, IsOpenEmbedding (PrimeSpectrum.comap φ ∘
      PrimeSpectrum.comap (algebraMap B (Localization.Away (φ (ρ i))))) := by
    intro i
    rw [← comap_comp_eq_of_away φ (ρ i)]
    exact (PrimeSpectrum.localization_away_isOpenEmbedding _ (ρ i)).comp
      (PrimeSpectrum.isHomeomorph_comap_of_bijective (hbij i)).isOpenEmbedding
  have hinj : Function.Injective (PrimeSpectrum.comap φ) := by
    intro p₁ p₂ h
    obtain ⟨i, hi⟩ := exists_notMem_of_span_eq_top hspan p₁
    have hi₂ : φ (ρ i) ∉ p₂.asIdeal := by
      intro hmem₂
      refine hi ?_
      have h₂ : ρ i ∈ (PrimeSpectrum.comap φ p₂).asIdeal := hmem₂
      rw [← h] at h₂
      exact h₂
    obtain ⟨q₁, hq₁⟩ := hmem i p₁ hi
    obtain ⟨q₂, hq₂⟩ := hmem i p₂ hi₂
    have hq : q₁ = q₂ :=
      (hcomp i).injective (by simpa only [Function.comp_apply, hq₁, hq₂] using h)
    rw [← hq₁, ← hq₂, hq]
  refine IsOpenEmbedding.of_continuous_injective_isOpenMap
    (PrimeSpectrum.continuous_comap φ) hinj ?_
  intro W hW
  have hcover : PrimeSpectrum.comap φ '' W =
      ⋃ i, (PrimeSpectrum.comap φ ∘
        PrimeSpectrum.comap (algebraMap B (Localization.Away (φ (ρ i))))) ''
          (PrimeSpectrum.comap (algebraMap B (Localization.Away (φ (ρ i)))) ⁻¹' W) := by
    refine Set.Subset.antisymm ?_ (Set.iUnion_subset fun i ↦ ?_)
    · rintro y ⟨p, hpW, rfl⟩
      obtain ⟨i, hi⟩ := exists_notMem_of_span_eq_top hspan p
      obtain ⟨q, hq⟩ := hmem i p hi
      refine Set.mem_iUnion.2 ⟨i, q, ?_, ?_⟩
      · rwa [Set.mem_preimage, hq]
      · simp only [Function.comp_apply, hq]
    · rintro y ⟨q, hq, rfl⟩
      exact ⟨_, hq, rfl⟩
  rw [hcover]
  exact isOpen_iUnion fun i ↦ (hcomp i).isOpenMap _
    (hW.preimage (PrimeSpectrum.continuous_comap _))

/-- If `D(g)` lies in the image of `Spec B`, then `g` lies in the radical of the ideal
generated by the `rᵢ`. -/
theorem mem_radical_span_of_basicOpen_subset_range
    (hspan : Ideal.span (Set.range fun i ↦ φ (ρ i)) = ⊤)
    (hbij : ∀ i, Function.Bijective (Localization.awayMap φ (ρ i)))
    {g : R}
    (hg : (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum R)) ⊆
      Set.range (PrimeSpectrum.comap φ)) :
    g ∈ (Ideal.span (Set.range ρ)).radical := by
  rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
  rintro J ⟨hJle, hJp⟩
  by_contra hgJ
  have hJmem : (⟨J, hJp⟩ : PrimeSpectrum R) ∈
      (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum R)) :=
    (PrimeSpectrum.mem_basicOpen _ _).2 hgJ
  have hrange := hg hJmem
  rw [range_comap_eq_iUnion_basicOpen_of_awayCover hspan hbij] at hrange
  obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hrange
  exact (PrimeSpectrum.mem_basicOpen _ _).1 hi (hJle (Ideal.subset_span ⟨i, rfl⟩))

/-- The away localization map of an injective ring map is injective. -/
private theorem awayMap_injective_of_injective (hinj : Function.Injective φ) (r : R) :
    Function.Injective (Localization.awayMap φ r) := by
  rw [Localization.awayMap_injective_iff]
  intro a ha
  exact ⟨0, by rw [hinj (ha.trans (map_zero φ).symm), mul_zero]⟩

/-- The away localization at any `g` whose basic open lies in the image of `Spec B` is
bijective. -/
theorem awayMap_bijective_of_awayCover [Finite ι]
    (hinj : Function.Injective φ)
    (hspan : Ideal.span (Set.range fun i ↦ φ (ρ i)) = ⊤)
    (hbij : ∀ i, Function.Bijective (Localization.awayMap φ (ρ i)))
    (g : R)
    (hg : (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum R)) ⊆
      Set.range (PrimeSpectrum.comap φ)) :
    Function.Bijective (Localization.awayMap φ g) := by
  classical
  let : Fintype ι := Fintype.ofFinite ι
  refine ⟨awayMap_injective_of_injective hinj g, ?_⟩
  · rw [Localization.awayMap_surjective_iff]
    intro a
    choose b m hbm using fun i ↦ Localization.awayMap_surjective_iff.1 (hbij i).2 a
    set N := Finset.univ.sup m
    have hmN : ∀ i, m i ≤ N := fun i ↦ Finset.le_sup (Finset.mem_univ i)
    have hs : ∀ i, φ (ρ i ^ (N - m i) * b i) = φ (ρ i) ^ N * a := by
      intro i
      rw [map_mul, map_pow, hbm i, ← mul_assoc, ← pow_add, Nat.sub_add_cancel (hmN i)]
    have hle : Ideal.span (Set.range ρ) ≤
        (Ideal.span (Set.range fun i ↦ ρ i ^ N)).radical := by
      rw [Ideal.span_le]
      rintro x ⟨i, rfl⟩
      exact ⟨N, Ideal.subset_span ⟨i, rfl⟩⟩
    have hrad : g ∈ (Ideal.span (Set.range fun i ↦ ρ i ^ N)).radical := by
      have hmono := Ideal.radical_mono hle
      rw [Ideal.radical_idem] at hmono
      exact hmono (mem_radical_span_of_basicOpen_subset_range hspan hbij hg)
    obtain ⟨k, hk⟩ := hrad
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).1 hk
    have hsum : (∑ i, c i * ρ i ^ N) = g ^ k := by
      simpa [smul_eq_mul] using hc
    refine ⟨∑ i, c i * (ρ i ^ (N - m i) * b i), k, ?_⟩
    calc φ (∑ i, c i * (ρ i ^ (N - m i) * b i))
        = ∑ i, φ (c i) * (φ (ρ i) ^ N * a) := by
          rw [map_sum]
          exact Finset.sum_congr rfl fun i _ ↦ by rw [map_mul, hs i]
      _ = (∑ i, φ (c i) * φ (ρ i) ^ N) * a := by
          rw [Finset.sum_mul]
          exact Finset.sum_congr rfl fun i _ ↦ by ring
      _ = φ (∑ i, c i * ρ i ^ N) * a := by
          rw [map_sum]
          refine congrArg (· * a) (Finset.sum_congr rfl fun i _ ↦ ?_)
          rw [map_mul, map_pow]
      _ = φ g ^ k * a := by rw [hsum, map_pow]

end AwayCover

section Assemble

/-- Assembling a finite-open factorization from a finite family of `A`-subalgebras `Sᵢ ⊆ B`,
each finite over `A`, together with elements `rᵢ ∈ Sᵢ` generating the unit ideal of `B` such
that every element of `B` is brought into `Sᵢ` by a power of `rᵢ`.

The intermediate algebra is the `A`-subalgebra of `B` generated by the `Sᵢ`; it is still
finite over `A`, being generated by finitely many integral elements. -/
theorem exists_finiteOpenFactorization_of_awayCover
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {ι : Type*} [Finite ι] (S : ι → Subalgebra A B) (ρ : ι → B)
    (hfg : ∀ i, (S i).toSubmodule.FG)
    (hmem : ∀ i, ρ i ∈ S i)
    (hdom : ∀ (i : ι) (a : B), ∃ m : ℕ, ρ i ^ m * a ∈ S i)
    (hspan : Ideal.span (Set.range ρ) = ⊤) :
    Nonempty (FiniteOpenFactorization.{u, u, u} A B) := by
  classical
  choose G hG using fun i ↦ hfg i
  have hintegral : ∀ i, ∀ x ∈ (G i : Set B), IsIntegral A x := by
    intro i x hx
    have hxS : x ∈ Subalgebra.toSubmodule (S i) := by
      rw [← hG i]
      exact Submodule.subset_span hx
    exact IsIntegral.of_mem_of_fg (S i) (hfg i) x hxS
  set C : Set B := ⋃ i, (G i : Set B)
  have hCfin : C.Finite := Set.finite_iUnion fun i ↦ (G i).finite_toSet
  have hCint : ∀ x ∈ C, IsIntegral A x := fun x hx ↦
    (Set.mem_iUnion.1 hx).elim fun i hi ↦ hintegral i x hi
  set M : Subalgebra A B := Algebra.adjoin A C
  have hfinM : Module.Finite A M := Algebra.finite_adjoin_of_finite_of_isIntegral hCfin hCint
  have hSle : ∀ i, S i ≤ M := by
    intro i x hx
    have hx' : x ∈ Submodule.span A (G i : Set B) := by
      rw [hG i]
      simpa using hx
    have hxM : x ∈ Subalgebra.toSubmodule M := by
      refine Submodule.span_le.2 (fun y hy ↦ ?_) hx'
      exact Algebra.subset_adjoin (Set.mem_iUnion.2 ⟨i, hy⟩)
    simpa using hxM
  -- the data, transported to the intermediate algebra
  set φ : (↥M) →+* B := algebraMap (↥M) B
  have hinj : Function.Injective φ := Subtype.val_injective
  set ρ' : ι → ↥M := fun i ↦ ⟨ρ i, hSle i (hmem i)⟩
  have hφρ : ∀ i, φ (ρ' i) = ρ i := fun _ ↦ rfl
  have hspan' : Ideal.span (Set.range fun i ↦ φ (ρ' i)) = ⊤ := by
    simpa only [hφρ] using hspan
  have hbij' : ∀ i, Function.Bijective (Localization.awayMap φ (ρ' i)) := by
    intro i
    refine ⟨awayMap_injective_of_injective hinj _, ?_⟩
    rw [Localization.awayMap_surjective_iff]
    intro a
    obtain ⟨m, hm⟩ := hdom i a
    exact ⟨⟨ρ i ^ m * a, hSle i hm⟩, m, rfl⟩
  exact ⟨{ middle := ↥M
           commRingMiddle := inferInstance
           algebraMiddle := inferInstance
           algebraTarget := inferInstance
           scalarTower := inferInstance
           finite_middle := hfinM
           isOpenEmbedding_comap := isOpenEmbedding_comap_of_awayCover hspan' hbij'
           awayMap_bijective := fun g hg ↦
             awayMap_bijective_of_awayCover hinj hspan' hbij' g hg }⟩

end Assemble

section ZariskiMainTheorem

/-- **Zariski's main theorem**, global form: a quasi-finite algebra of finite type admits a
factorization through a finite algebra whose second map induces an open immersion on prime
spectra, i.e. a `FiniteOpenFactorization`.

Mathlib's `Algebra.QuasiFiniteAt.exists_fg_and_exists_notMem_and_awayMap_bijective` is the
statement at a single prime; the globalisation is carried out here. -/
theorem exists_finiteOpenFactorization {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    [Algebra.FiniteType A B] [Algebra.QuasiFinite A B] :
    Nonempty (FiniteOpenFactorization.{u, u, u} A B) := by
  classical
  have hZMT : ∀ p : PrimeSpectrum B, ∃ S' : Subalgebra A B, (Subalgebra.toSubmodule S').FG ∧
      ∃ r : B, r ∈ S' ∧ r ∉ p.asIdeal ∧ ∀ a : B, ∃ m : ℕ, r ^ m * a ∈ S' := by
    intro p
    obtain ⟨S', hfg, r, hrp, hbij⟩ :=
      Algebra.QuasiFiniteAt.exists_fg_and_exists_notMem_and_awayMap_bijective
        (R := A) p.asIdeal
    refine ⟨S', hfg, r.1, r.2, hrp, fun a ↦ ?_⟩
    obtain ⟨x, m, hx⟩ := Localization.awayMap_surjective_iff.1 hbij.2 a
    have hx' : (r : B) ^ m * a = (x : B) := by simpa using hx.symm
    exact ⟨m, hx' ▸ x.2⟩
  choose S hfg ρ₀ hmem hnotmem hdom using hZMT
  have hspan : Ideal.span (Set.range ρ₀) = ⊤ := by
    by_contra hne
    obtain ⟨q, hq, hqle⟩ := Ideal.exists_le_maximal _ hne
    exact hnotmem ⟨q, hq.isPrime⟩ (hqle (Ideal.subset_span ⟨⟨q, hq.isPrime⟩, rfl⟩))
  obtain ⟨T, hTsub, hT1⟩ :=
    Submodule.mem_span_finite_of_mem_span ((Ideal.eq_top_iff_one _).1 hspan)
  choose π hπ using fun x : {y : B // y ∈ T} ↦ hTsub x.2
  refine exists_finiteOpenFactorization_of_awayCover
    (ι := {y : B // y ∈ T}) (fun i ↦ S (π i)) (fun i ↦ i.1)
    (fun i ↦ hfg (π i)) (fun i ↦ ?_) (fun i a ↦ ?_) ?_
  · rw [← hπ i]
    exact hmem (π i)
  · rw [← hπ i]
    exact hdom (π i) a
  · refine (Ideal.eq_top_iff_one _).2 ?_
    have hr : (Set.range fun i : {y : B // y ∈ T} ↦ (i.1 : B)) = (T : Set B) :=
      Subtype.range_coe
    rw [hr]
    exact hT1

end ZariskiMainTheorem

end Stacks.Discriminant
