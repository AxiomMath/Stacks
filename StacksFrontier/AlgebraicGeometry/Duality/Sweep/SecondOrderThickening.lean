module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Abelian
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Submodule
public import Mathlib.CategoryTheory.Abelian.ShortExact
public import Mathlib.CategoryTheory.Abelian.DiagramLemmas.KernelCokernelComp
public import Mathlib.CategoryTheory.Abelian.CommSq
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Topology.Sheaves.Functors.Module.RingedSpace

/-!
# The second-order thickening sequence

For an ideal sheaf `I` on a ringed space, its square, the quotient by its square, and the
quotient by `I` fit into the canonical short exact sequence
`0 ⟶ I / I² ⟶ 𝒪 / I² ⟶ 𝒪 / I ⟶ 0`.

## Main definitions

* `Stacks.Duality.idealSquare` — the ideal subsheaf locally generated by products of two
  sections of `I`.

## Main results

* `Stacks.Duality.secondOrderThickening_shortExact` — the canonical second-order thickening
  sequence is short exact.

## Implementation notes

The square is defined intrinsically as the infimum of all ideal subsheaves containing every
local product of two sections of `I`. Quotient sheaves are represented categorically as
cokernels. The commuting equations in the result characterize both arrows canonically.

## References

* [Stacks Project, Tag 0BQX](https://stacks.math.columbia.edu/tag/0BQX)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open RingedSpaceModuleAdjunction

universe u

namespace Stacks.Duality

noncomputable section

/-- The square of an ideal sheaf: the smallest ideal subsheaf containing every product of
two local sections of the ideal. -/
public noncomputable def idealSquare (Y : RingedSpace.{u, u})
    (I : (SheafOfModules.unit (structureSheafRing Y)).Submodule) :
    (SheafOfModules.unit (structureSheafRing Y)).Submodule :=
  sInf { J | ∀ (U : (TopologicalSpace.Opens Y.carrier)ᵒᵖ)
    (a b : (structureSheafRing Y).obj.obj U),
      a ∈ I.toSubmodule.obj U → b ∈ I.toSubmodule.obj U →
        a * b ∈ J.toSubmodule.obj U }

private lemma idealSquare_le (Y : RingedSpace.{u, u})
    (I : (SheafOfModules.unit (structureSheafRing Y)).Submodule) : idealSquare Y I ≤ I :=
  sInf_le fun U a _ _ hb => (I.toSubmodule.obj U).smul_mem a hb

private lemma cokernel_comp_shortExact_of_eq {C : Type*} [Category C] [Abelian C]
    {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z) [Mono g]
    (k : X ⟶ Z) (h : f ≫ g = k) :
    (ShortComplex.mk
      (cokernel.map f k (𝟙 X) g (by simpa only [Category.id_comp] using h))
      (cokernel.map k g f (𝟙 Z) (by simpa only [Category.comp_id] using h.symm))
      (by
        apply (cancel_epi (cokernel.π f)).1
        simp [cokernel.map, Category.assoc])).ShortExact := by
  subst k
  apply ShortComplex.ShortExact.mk'
  · have h := (kernelCokernelCompSequence_exact f g).exact 3
    dsimp [kernelCokernelCompSequence, ComposableArrows.sc,
      ComposableArrows.sc'] at h
    exact h
  · exact Abelian.mono_cokernel_map_of_isPullback
      (IsPullback.of_vert_isIso_mono (by simp : CommSq f (𝟙 X) g (f ≫ g)))
  · infer_instance

/-- **Stacks Project, Tag 0BQX.** For an ideal sheaf `I` on a ringed space, the canonical
sequence
`0 ⟶ I / I² ⟶ 𝒪_Y / I² ⟶ 𝒪_Y / I ⟶ 0`
is short exact. The displayed equations say that its arrows are induced by the inclusion
`I ⟶ 𝒪_Y` and the identity of `𝒪_Y`, respectively. -/
@[stacks 0BQX]
public theorem secondOrderThickening_shortExact (Y : RingedSpace.{u, u})
    (I : (SheafOfModules.unit (structureSheafRing Y)).Submodule) :
    let I2 := idealSquare Y I
    ∃ (j : I2.toSheafOfModules ⟶ I.toSheafOfModules)
      (_hj : j ≫ I.ι = I2.ι)
      (f : cokernel j ⟶ cokernel I2.ι)
      (g : cokernel I2.ι ⟶ cokernel I.ι)
      (hzero : f ≫ g = 0),
      (cokernel.π j ≫ f = I.ι ≫ cokernel.π I2.ι) ∧
        (cokernel.π I2.ι ≫ g = cokernel.π I.ι) ∧
          (ShortComplex.mk f g hzero).ShortExact := by
  dsimp
  let I2 := idealSquare Y I
  let j : I2.toSheafOfModules ⟶ I.toSheafOfModules :=
    ⟨PresheafOfModules.Submodule.homOfLE
      (SheafOfModules.Submodule.le_iff.mp (idealSquare_le Y I))⟩
  have hj : j ≫ I.ι = I2.ι := rfl
  let f := cokernel.map j I2.ι (𝟙 _) I.ι (by simp [hj])
  let g := cokernel.map I2.ι I.ι j (𝟙 _) (by simp [hj])
  have hf : cokernel.π j ≫ f = I.ι ≫ cokernel.π I2.ι := by simp [f]
  have hg : cokernel.π I2.ι ≫ g = cokernel.π I.ι := by simp [g]
  exact ⟨j, hj, f, g, _, hf, hg, cokernel_comp_shortExact_of_eq j I.ι I2.ι hj⟩

end

end Stacks.Duality

end
