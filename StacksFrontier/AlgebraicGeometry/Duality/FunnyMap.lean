module

public import Mathlib.LinearAlgebra.Alternating.DomCoprod
public import Mathlib.LinearAlgebra.Determinant
public import Mathlib.LinearAlgebra.Contraction
public import Mathlib.LinearAlgebra.ExteriorPower.Basis
public import StacksFrontier.LinearAlgebra.ExteriorPower.Wedge
public import StacksCore.Tactic.StacksAttribute

/-!
# The canonical exterior-power map of a two-term diagram

For a short exact sequence `0 → K → L → M⁰ → 0` of modules over a commutative ring `R` and a
compatible two-term complex `M⁻¹ → M⁰`, with `M⁰` and `M⁻¹` finite free of the same rank `n`,
we construct the canonical maps
`cᵖ : ⋀ᵖ(L / d(M⁻¹)) → ⋀ᵖK ⊗ det(M⁻¹ → M⁰)`
of Stacks Project, Tag 0FL8.

Here the zeroth cohomology of the two-term complex is the quotient of `L` by the range of its
differential, a finite free module of rank `n` is one admitting a basis indexed by `Fin n`, and
the inverse determinant line is the linear dual of the top exterior power. The maps are computed
through the projection `π_p : ⋀^{p+n} L → ⋀ᵖK ⊗ ⋀ⁿM⁰` attached to a retraction of `K → L`, which
does not depend on the retraction.

## Main definitions

* `Stacks.DeRham.twoTermDeterminant`, `Stacks.DeRham.twoTermDeterminantElement` — the
  determinant line of a two-term complex and its canonical element.
* `Stacks.DeRham.basisTopDual` — the dual of the top wedge of a basis.
* `Stacks.DeRham.topWedgeProjection` — the projection `π_p`.
* `Stacks.DeRham.funnyMapLift` — the top-wedge expression before descent.
* `Stacks.DeRham.funnyMap` — the canonical family of maps.

## Main results

* `Stacks.DeRham.exists_wedge_descent` — right-exactness of the exterior power, in the form
  "wedging with a fixed top form descends to the quotient by the span of its factors".
* `Stacks.DeRham.topWedgeProjection_congr` — the projection `π_p` is independent of the
  retraction.
* `Stacks.DeRham.exists_funnyMap` — the construction claim of Tag 0FL8.
* `Stacks.DeRham.funnyMap_zero`, `Stacks.DeRham.funnyMap_comp` — the value in degree zero and
  the restriction to `⋀ᵖK`.

## References

* [Stacks Project, Tag 0FL8](https://stacks.math.columbia.edu/tag/0FL8)
-/

@[expose] public section

namespace Stacks.DeRham

open scoped TensorProduct

universe u v w x y

section Append

/-- Composition commutes with `Fin.append`. -/
theorem comp_append {α : Type*} {β : Type*} (f : α → β) {m n : ℕ} (u : Fin m → α)
    (v : Fin n → α) : f ∘ Fin.append u v = Fin.append (f ∘ u) (f ∘ v) := by
  funext j
  refine Fin.addCases (fun a => ?_) (fun a => ?_) j <;> simp

end Append

section TopPower

variable {R : Type u} [CommRing R] {M : Type x} [AddCommGroup M] [Module R M]

/-- The top exterior power of a free module of rank `n` is generated by the wedge of a basis. -/
theorem span_singleton_ιMulti_basis {n : ℕ} (b : Module.Basis (Fin n) R M) :
    Submodule.span R {exteriorPower.ιMulti R n b} = (⊤ : Submodule R (⋀[R]^n M)) := by
  classical
  refine top_unique ?_
  rw [← exteriorPower.ιMulti_span_of_span (R := R) (n := n) (M := M) (s := Set.range b)
    b.span_eq, Submodule.span_le]
  rintro - ⟨a, ha, rfl⟩
  choose σ hσ using fun i => ha (Set.mem_range_self i)
  have hab : a = b ∘ σ := funext fun i => (hσ i).symm
  by_cases hinj : Function.Injective σ
  · have hbij : Function.Bijective σ := (Finite.injective_iff_bijective).1 hinj
    set e : Equiv.Perm (Fin n) := Equiv.ofBijective σ hbij with he
    have hae : a = b ∘ e := hab
    have hperm : exteriorPower.ιMulti R n a =
        (Equiv.Perm.sign e) • exteriorPower.ιMulti R n b := by
      rw [hae]; exact (exteriorPower.ιMulti R n).map_perm b e
    refine SetLike.mem_coe.2 ?_
    rw [hperm, Units.smul_def, ← Int.cast_smul_eq_zsmul R]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
  · obtain ⟨i, j, hij, hne⟩ := Function.not_injective_iff.1 hinj
    have : exteriorPower.ιMulti R n a = 0 := by
      refine (exteriorPower.ιMulti R n).map_eq_zero_of_eq a (i := i) (j := j) ?_ hne
      rw [hab]; simp [hij]
    rw [SetLike.mem_coe, this]
    exact Submodule.zero_mem _

/-- The dual basis element of the top exterior power attached to a basis. -/
noncomputable def basisTopDual {n : ℕ} (b : Module.Basis (Fin n) R M) :
    Module.Dual R (⋀[R]^n M) :=
  exteriorPower.alternatingMapLinearEquiv b.det

/-- The dual basis element `basisTopDual b` takes the value `1` on the wedge of the basis `b`. -/
@[simp]
theorem basisTopDual_apply {n : ℕ} (b : Module.Basis (Fin n) R M) :
    basisTopDual b (exteriorPower.ιMulti R n b) = 1 := by
  simp [basisTopDual, Module.Basis.det_self]

/-- A linear map out of the top exterior power of a free module of rank `n` is determined by
its value on the wedge of a basis. -/
theorem eq_basisTopDual_smul {n : ℕ} (b : Module.Basis (Fin n) R M) {Y : Type y}
    [AddCommGroup Y] [Module R Y] (F : (⋀[R]^n M) →ₗ[R] Y) (x : ⋀[R]^n M) :
    F x = (basisTopDual b x) • F (exteriorPower.ιMulti R n b) := by
  have hx : x ∈ Submodule.span R {exteriorPower.ιMulti R n b} := by
    rw [span_singleton_ιMulti_basis b]; exact Submodule.mem_top
  obtain ⟨t, rfl⟩ := Submodule.mem_span_singleton.1 hx
  simp [map_smul]

/-- Two linear maps out of the top exterior power of a free module of rank `n` agree as soon
as they agree on the wedge of a basis. -/
theorem linearMap_top_ext {n : ℕ} (b : Module.Basis (Fin n) R M) {Y : Type y}
    [AddCommGroup Y] [Module R Y] {F G : (⋀[R]^n M) →ₗ[R] Y}
    (h : F (exteriorPower.ιMulti R n b) = G (exteriorPower.ιMulti R n b)) : F = G := by
  refine LinearMap.ext fun x => ?_
  rw [eq_basisTopDual_smul b F, eq_basisTopDual_smul b G, h]

end TopPower

section Descent

variable {R : Type u} [CommRing R] {L : Type w} [AddCommGroup L] [Module R L]

omit [AddCommGroup L] [Module R L] in
/-- Updating `Fin.append v f` at the index `Fin.castAdd n k` is the same as appending `f` to `v`
updated at `k`. -/
theorem update_append_left {n p : ℕ} [DecidableEq (Fin p)] [DecidableEq (Fin (p + n))]
    (v : Fin p → L) (f : Fin n → L) (k : Fin p) (z : L) :
    Function.update (Fin.append v f) (Fin.castAdd n k) z =
      Fin.append (Function.update v k z) f := by
  funext j
  refine Fin.addCases (fun a => ?_) (fun a => ?_) j
  · rcases eq_or_ne a k with rfl | hak
    · simp
    · rw [Function.update_of_ne (by simpa using hak), Fin.append_left, Fin.append_left,
        Function.update_of_ne hak]
  · rw [Function.update_of_ne (by simp [Fin.ext_iff, Fin.natAdd, Fin.castAdd]; omega),
      Fin.append_right, Fin.append_right]

/-- Wedging a tuple with `f₀ ∧ ⋯ ∧ fₙ₋₁` kills any coordinate lying in the span of the `f`'s. -/
theorem ιMulti_append_eq_zero_of_mem_span {n p : ℕ} (f : Fin n → L) (v : Fin p → L)
    (k : Fin p) {z : L} (hz : z ∈ Submodule.span R (Set.range f)) :
    exteriorPower.ιMulti R (p + n) (Fin.append (Function.update v k z) f) = 0 := by
  classical
  set g : L →ₗ[R] ⋀[R]^(p + n) L :=
    (exteriorPower.ιMulti R (p + n)).toMultilinearMap.toLinearMap
      (Fin.append v f) (Fin.castAdd n k) with hg
  have hgapp : ∀ z : L, g z =
      exteriorPower.ιMulti R (p + n) (Fin.append (Function.update v k z) f) := by
    intro z
    rw [hg]
    simp only [MultilinearMap.toLinearMap_apply, AlternatingMap.coe_multilinearMap]
    rw [update_append_left]
  have hle : Submodule.span R (Set.range f) ≤ LinearMap.ker g := by
    refine Submodule.span_le.2 ?_
    rintro - ⟨m, rfl⟩
    refine SetLike.mem_coe.2 (LinearMap.mem_ker.2 ?_)
    rw [hgapp]
    refine (exteriorPower.ιMulti R (p + n)).map_eq_zero_of_eq _
      (i := Fin.castAdd n k) (j := Fin.natAdd p m) ?_ ?_
    · rw [Fin.append_left, Fin.append_right, Function.update_self]
    · refine Fin.ne_of_val_ne ?_
      have := k.isLt
      simp only [Fin.val_castAdd, Fin.val_natAdd]
      omega
  rw [← hgapp]
  exact LinearMap.mem_ker.1 (hle hz)

/-- Changing one coordinate by an element of the span of the `f`'s leaves the wedge unchanged. -/
theorem ιMulti_append_update_congr {n p : ℕ} (f : Fin n → L) (v : Fin p → L) (k : Fin p)
    {z : L} (hz : z - v k ∈ Submodule.span R (Set.range f)) :
    exteriorPower.ιMulti R (p + n) (Fin.append (Function.update v k z) f) =
      exteriorPower.ιMulti R (p + n) (Fin.append v f) := by
  classical
  have h1 : z = v k + (z - v k) := by abel
  have h2 := ιMulti_append_eq_zero_of_mem_span f v k hz
  have h3 : exteriorPower.ιMulti R (p + n)
      (Fin.append (Function.update v k (v k + (z - v k))) f) =
      exteriorPower.ιMulti R (p + n) (Fin.append (Function.update v k (v k)) f) +
      exteriorPower.ιMulti R (p + n) (Fin.append (Function.update v k (z - v k)) f) := by
    rw [← update_append_left, ← update_append_left, ← update_append_left]
    exact (exteriorPower.ιMulti R (p + n)).map_update_add _ _ _ _
  rw [h1, h3, h2, add_zero, Function.update_eq_self]

/-- Two tuples with the same image in `L ⧸ span f` have the same wedge with `f₀ ∧ ⋯ ∧ fₙ₋₁`. -/
theorem ιMulti_append_congr {n p : ℕ} (f : Fin n → L) (v v' : Fin p → L)
    (h : ∀ k, v' k - v k ∈ Submodule.span R (Set.range f)) :
    exteriorPower.ιMulti R (p + n) (Fin.append v' f) =
      exteriorPower.ιMulti R (p + n) (Fin.append v f) := by
  classical
  suffices H : ∀ s : Finset (Fin p),
      exteriorPower.ιMulti R (p + n)
          (Fin.append (fun k => if k ∈ s then v' k else v k) f) =
        exteriorPower.ιMulti R (p + n) (Fin.append v f) by
    simpa using H Finset.univ
  intro s
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
      have hupd : (fun k => if k ∈ insert a s then v' k else v k) =
          Function.update (fun k => if k ∈ s then v' k else v k) a (v' a) := by
        funext k
        rcases eq_or_ne k a with rfl | hka
        · simp
        · simp [Finset.mem_insert, hka]
      rw [hupd]
      exact (ιMulti_append_update_congr f _ a (by simpa [ha] using h a)).trans ih

/-- Wedging with a fixed family `f`, as a multilinear map of `p` variables. -/
noncomputable def appendMultilinear (n p : ℕ) (f : Fin n → L) :
    MultilinearMap R (fun _ : Fin p => L) (⋀[R]^(p + n) L) where
  toFun v := exteriorPower.ιMulti R (p + n) (Fin.append v f)
  map_update_add' := by
    intro _ v k x y
    simp only [← update_append_left]
    exact (exteriorPower.ιMulti R (p + n)).map_update_add _ _ _ _
  map_update_smul' := by
    intro _ v k t x
    simp only [← update_append_left]
    exact (exteriorPower.ιMulti R (p + n)).map_update_smul _ _ _ _

/-- `appendMultilinear n p f` sends `v` to the wedge of the concatenated family
`Fin.append v f`. -/
@[simp]
theorem appendMultilinear_apply (n p : ℕ) (f : Fin n → L) (v : Fin p → L) :
    appendMultilinear (R := R) n p f v =
      exteriorPower.ιMulti R (p + n) (Fin.append v f) := rfl

/-- For any linear map `S` out of `⋀^{p+n} L`, the map `η ↦ S (η ∧ f₀ ∧ ⋯ ∧ fₙ₋₁)` factors
through the quotient `⋀^p (L ⧸ span f)`, where the span is taken over the family `f`. -/
theorem exists_wedge_descent {Z : Type v} [AddCommGroup Z] [Module R Z] (n p : ℕ)
    (f : Fin n → L) (S : (⋀[R]^(p + n) L) →ₗ[R] Z) :
    ∃ c : (⋀[R]^p (L ⧸ Submodule.span R (Set.range f))) →ₗ[R] Z,
      ∀ η : ⋀[R]^p L,
        c (exteriorPower.map p (Submodule.span R (Set.range f)).mkQ η) =
          S (exteriorPower.wedgeMul (R := R) p n η (exteriorPower.ιMulti R n f)) := by
  classical
  set N := Submodule.span R (Set.range f) with hN
  set lift : (L ⧸ N) → L := Function.surjInv N.mkQ_surjective with hlift
  have hliftspec : ∀ q : L ⧸ N, N.mkQ (lift q) = q :=
    Function.surjInv_eq N.mkQ_surjective
  set Φ : MultilinearMap R (fun _ : Fin p => L) Z :=
    S.compMultilinearMap (appendMultilinear n p f) with hΦ
  have hΦapp : ∀ v : Fin p → L,
      Φ v = S (exteriorPower.ιMulti R (p + n) (Fin.append v f)) := fun v => rfl
  have hdep : ∀ v v' : Fin p → L, (∀ k, N.mkQ (v k) = N.mkQ (v' k)) → Φ v = Φ v' := by
    intro v v' h
    rw [hΦapp, hΦapp]
    refine congrArg S (ιMulti_append_congr f v' v fun k => ?_)
    have hk : (N.mkQ) (v k - v' k) = 0 := by rw [map_sub, h k, sub_self]
    simpa [Submodule.ker_mkQ] using LinearMap.mem_ker.2 hk
  have e : ∀ [DecidableEq (Fin p)] (w : Fin p → L ⧸ N) (k : Fin p) (z : L ⧸ N)
      (a : L), N.mkQ a = z →
      Φ (lift ∘ Function.update w k z) = Φ (Function.update (lift ∘ w) k a) := by
    intro _ w k z a ha
    refine hdep _ _ fun j => ?_
    rcases eq_or_ne j k with rfl | hjk
    · simp [hliftspec, ha]
    · simp [Function.update_of_ne hjk]
  set G : (L ⧸ N) [⋀^Fin p]→ₗ[R] Z :=
    { toFun := fun w => Φ (lift ∘ w)
      map_update_add' := by
        intro _ w k xx yy
        rw [e w k (xx + yy) (lift xx + lift yy) (by rw [map_add, hliftspec, hliftspec]),
          e w k xx (lift xx) (hliftspec xx), e w k yy (lift yy) (hliftspec yy)]
        exact Φ.map_update_add _ _ _ _
      map_update_smul' := by
        intro _ w k t xx
        rw [e w k (t • xx) (t • lift xx) (by rw [map_smul, hliftspec]),
          e w k xx (lift xx) (hliftspec xx)]
        exact Φ.map_update_smul _ _ _ _
      map_eq_zero_of_eq' := by
        intro w k l hkl hne
        rw [hΦapp]
        refine congrArg S ((exteriorPower.ιMulti R (p + n)).map_eq_zero_of_eq _
          (i := Fin.castAdd n k) (j := Fin.castAdd n l) ?_ ?_) |>.trans (map_zero S)
        · simp only [Fin.append_left, Function.comp_apply, hkl]
        · exact fun hc => hne (by simpa using hc) } with hG
  refine ⟨exteriorPower.alternatingMapLinearEquiv G, fun η => ?_⟩
  have hext : (exteriorPower.alternatingMapLinearEquiv G).comp
        (exteriorPower.map p N.mkQ) =
      S.comp ((exteriorPower.wedgeMul (R := R) p n).flip (exteriorPower.ιMulti R n f)) := by
    refine exteriorPower.linearMap_ext ?_
    ext v
    simp only [LinearMap.compAlternatingMap_apply, LinearMap.coe_comp, Function.comp_apply,
      exteriorPower.map_apply_ιMulti, exteriorPower.alternatingMapLinearEquiv_apply_ιMulti,
      LinearMap.flip_apply, exteriorPower.wedgeMul_ιMulti]
    rw [hG]
    refine (hdep (lift ∘ fun k => N.mkQ (v k)) v fun k => ?_).trans (hΦapp v)
    simp [hliftspec]
  exact congrFun (congrArg DFunLike.coe hext) η

/-- The range of a linear map out of a free module is the span of the images of a basis. -/
theorem range_eq_span_comp_basis {n : ℕ} {Mneg : Type y} [AddCommGroup Mneg] [Module R Mneg]
    (d : Mneg →ₗ[R] L) (b : Module.Basis (Fin n) R Mneg) :
    LinearMap.range d = Submodule.span R (Set.range (d ∘ b)) := by
  rw [LinearMap.range_eq_map, ← b.span_eq, Submodule.map_span, ← Set.range_comp]

/-- `exists_wedge_descent` for a submodule presented as the span of the family. -/
theorem exists_wedge_descent' {Z : Type v} [AddCommGroup Z] [Module R Z] (n p : ℕ)
    (f : Fin n → L) (N : Submodule R L) (hN : N = Submodule.span R (Set.range f))
    (S : (⋀[R]^(p + n) L) →ₗ[R] Z) :
    ∃ c : (⋀[R]^p (L ⧸ N)) →ₗ[R] Z,
      ∀ η : ⋀[R]^p L,
        c (exteriorPower.map p N.mkQ η) =
          S (exteriorPower.wedgeMul (R := R) p n η (exteriorPower.ιMulti R n f)) := by
  subst hN
  exact exists_wedge_descent n p f S

end Descent

section TwoTerm

variable {R : Type u} [CommRing R] {K : Type v} {L : Type w} {Mzero : Type x}
variable [AddCommGroup K] [Module R K] [AddCommGroup L] [Module R L]
variable [AddCommGroup Mzero] [Module R Mzero]

/-- The projection `π_p` in the proof of Tag 0FL8, computed using a retraction
`r : L → K`. The signed shuffle product selects `p` factors in `K` and `n`
factors in `M⁰`. -/
noncomputable def topWedgeProjection (p n : ℕ) (r : L →ₗ[R] K) (π : L →ₗ[R] Mzero) :
    (⋀[R]^(p + n) L) →ₗ[R] (⋀[R]^p K) ⊗[R] (⋀[R]^n Mzero) :=
  exteriorPower.alternatingMapLinearEquiv (R := R) (M := L) (n := p + n)
    (N := (⋀[R]^p K) ⊗[R] (⋀[R]^n Mzero))
    (AlternatingMap.domDomCongr finSumFinEquiv
      (((exteriorPower.ιMulti R p).compLinearMap r).domCoprod
        ((exteriorPower.ιMulti R n).compLinearMap π)))

/-- `topWedgeProjection p n r π` sends `v₀ ∧ ⋯ ∧ vₚ₊ₙ₋₁` to the value at `v ∘ finSumFinEquiv` of
the coproduct of the alternating maps `ιMulti ∘ r` on `p` vectors and `ιMulti ∘ π` on `n`
vectors. -/
theorem topWedgeProjection_apply_ιMulti (p n : ℕ) (r : L →ₗ[R] K)
    (π : L →ₗ[R] Mzero) (v : Fin (p + n) → L) :
    topWedgeProjection p n r π (exteriorPower.ιMulti R (p + n) v) =
      (((exteriorPower.ιMulti R p).compLinearMap r).domCoprod
        ((exteriorPower.ιMulti R n).compLinearMap π)) (v ∘ finSumFinEquiv) := by
  simp [topWedgeProjection]

/-- A summand of the coproduct defining `topWedgeProjection` vanishes as soon as `π` kills one of
the vectors sent to the right-hand block. -/
private theorem summand_eq_zero_of_map_inr {p n : ℕ} (r : L →ₗ[R] K) (π : L →ₗ[R] Mzero)
    (σ : Equiv.Perm (Fin p ⊕ Fin n)) (v : Fin p ⊕ Fin n → L) (j : Fin n)
    (h : π (v (σ (Sum.inr j))) = 0) :
    AlternatingMap.domCoprod.summand ((exteriorPower.ιMulti R p).compLinearMap r)
      ((exteriorPower.ιMulti R n).compLinearMap π) (Quotient.mk'' σ) v = 0 := by
  have hzero : ((exteriorPower.ιMulti R n).compLinearMap π)
      (fun t => v (σ (Sum.inr t))) = 0 := by
    rw [AlternatingMap.compLinearMap_apply]
    exact AlternatingMap.map_coord_zero _ j h
  rw [AlternatingMap.domCoprod.summand_mk'']
  simp only [smul_apply, MultilinearMap.domDomCongr_apply,
    MultilinearMap.domCoprod_apply, AlternatingMap.coe_multilinearMap]
  rw [hzero, TensorProduct.tmul_zero, smul_zero]

/-- Property (ii) of the projection `π_p` of Tag 0FL8: it kills every wedge more than `p` of
whose factors lie in the kernel of `π`. -/
theorem topWedgeProjection_eq_zero_of_card_lt {p n : ℕ} (r : L →ₗ[R] K) (π : L →ₗ[R] Mzero)
    (w : Fin (p + n) → L) (S : Finset (Fin (p + n))) (hcard : p < S.card)
    (hS : ∀ j ∈ S, π (w j) = 0) :
    topWedgeProjection p n r π (exteriorPower.ιMulti R (p + n) w) = 0 := by
  classical
  rw [topWedgeProjection_apply_ιMulti, AlternatingMap.domCoprod_apply, _root_.sum_apply]
  apply Finset.sum_eq_zero
  intro τ _
  induction τ using Quotient.inductionOn' with | _ σ
  set v : Fin p ⊕ Fin n → L := (w ∘ finSumFinEquiv) with hv
  set A : Finset (Fin p ⊕ Fin n) := S.image finSumFinEquiv.symm with hA
  have hAcard : A.card = S.card :=
    Finset.card_image_of_injective _ finSumFinEquiv.symm.injective
  have hAmem : ∀ a ∈ A, π (v a) = 0 := by
    intro a ha
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.1 ha
    simpa [hv, Function.comp_apply] using hS j hj
  obtain ⟨j, hj⟩ : ∃ j : Fin n, σ (Sum.inr j) ∈ A := by
    by_contra hcon
    simp only [not_exists] at hcon
    have hsub : A.image σ.symm ⊆ Finset.univ.image (Sum.inl : Fin p → Fin p ⊕ Fin n) := by
      intro y hy
      obtain ⟨a, haA, rfl⟩ := Finset.mem_image.1 hy
      rcases h3 : σ.symm a with c | c
      · exact Finset.mem_image.2 ⟨c, Finset.mem_univ _, rfl⟩
      · refine absurd ?_ (hcon c)
        have hac : σ (Sum.inr c) = a := by rw [← h3]; simp
        rw [hac]
        exact haA
    have h1 : (A.image σ.symm).card = S.card := by
      rw [Finset.card_image_of_injective _ σ.symm.injective, hAcard]
    have h2 : (Finset.univ.image (Sum.inl : Fin p → Fin p ⊕ Fin n)).card = p := by
      rw [Finset.card_image_of_injective _ Sum.inl_injective, Finset.card_univ,
        Fintype.card_fin]
    have := Finset.card_le_card hsub
    rw [h1, h2] at this
    omega
  exact summand_eq_zero_of_map_inr r π σ v j (hAmem _ hj)

/-- A permutation of `Fin p ⊕ Fin n` preserving the right summand is trivial modulo the
subgroup of block permutations. -/
private theorem mk_eq_one_of_inr {p n : ℕ} (σ : Equiv.Perm (Fin p ⊕ Fin n))
    (h : ∀ j : Fin n, ∃ j' : Fin n, σ (Sum.inr j) = Sum.inr j') :
    (Quotient.mk'' σ : Equiv.Perm.ModSumCongr (Fin p) (Fin n)) = Quotient.mk'' 1 := by
  classical
  choose g hg using h
  have hginj : Function.Injective g := by
    intro a c hac
    have h1 : σ (Sum.inr a) = σ (Sum.inr c) := by rw [hg a, hg c, hac]
    exact Sum.inr_injective (σ.injective h1)
  set σ₂ : Equiv.Perm (Fin n) := Equiv.ofBijective g (Finite.injective_iff_bijective.1 hginj)
    with hσ₂def
  have hσ₂ : ∀ j, σ (Sum.inr j) = Sum.inr (σ₂ j) := hg
  have hleft : ∀ a : Fin p, ∃ a' : Fin p, σ (Sum.inl a) = Sum.inl a' := by
    intro a
    rcases hc : σ (Sum.inl a) with a' | j'
    · exact ⟨a', rfl⟩
    · refine absurd ?_ (Sum.inl_ne_inr (a := a) (b := σ₂.symm j'))
      refine σ.injective ?_
      rw [hc, hσ₂]
      simp
  choose h' hh' using hleft
  have hh'inj : Function.Injective h' := by
    intro a c hac
    have h1 : σ (Sum.inl a) = σ (Sum.inl c) := by rw [hh' a, hh' c, hac]
    exact Sum.inl_injective (σ.injective h1)
  set σ₁ : Equiv.Perm (Fin p) := Equiv.ofBijective h' (Finite.injective_iff_bijective.1 hh'inj)
    with hσ₁def
  have hσ₁ : ∀ a, σ (Sum.inl a) = Sum.inl (σ₁ a) := hh'
  have hcongr : Equiv.Perm.sumCongrHom (Fin p) (Fin n) (σ₁, σ₂) = σ := by
    ext s
    rcases s with a | j
    · simpa using (hσ₁ a).symm
    · simpa using (hσ₂ j).symm
  refine Quotient.sound' ?_
  rw [QuotientGroup.leftRel_apply]
  exact ⟨(σ₁, σ₂)⁻¹, by rw [map_inv, hcongr]; simp⟩

/-- Property (i) of the projection `π_p` of Tag 0FL8: on a wedge whose first `p` factors come
from `K`, it is the evident tensor. -/
theorem topWedgeProjection_apply_append {p n : ℕ} {i : K →ₗ[R] L} (r : L →ₗ[R] K)
    (π : L →ₗ[R] Mzero) (hr : r.comp i = LinearMap.id) (hπi : π.comp i = 0)
    (k : Fin p → K) (l : Fin n → L) :
    topWedgeProjection p n r π
        (exteriorPower.ιMulti R (p + n) (Fin.append (i ∘ k) l)) =
      (exteriorPower.ιMulti R p k) ⊗ₜ[R] (exteriorPower.ιMulti R n (π ∘ l)) := by
  classical
  have hri : ∀ y : K, r (i y) = y := fun y => DFunLike.congr_fun hr y
  have hπii : ∀ y : K, π (i y) = 0 := fun y => DFunLike.congr_fun hπi y
  rw [topWedgeProjection_apply_ιMulti, AlternatingMap.domCoprod_apply, _root_.sum_apply]
  set w : Fin (p + n) → L := Fin.append (i ∘ k) l with hw
  set v : Fin p ⊕ Fin n → L := w ∘ finSumFinEquiv with hv
  have hvl : ∀ a : Fin p, v (Sum.inl a) = i (k a) := by
    intro a; simp [hv, hw]
  have hvr : ∀ j : Fin n, v (Sum.inr j) = l j := by
    intro j; simp [hv, hw]
  refine (Finset.sum_eq_single_of_mem (Quotient.mk'' 1) (Finset.mem_univ _) ?_).trans ?_
  · intro τ _ hτ
    induction τ using Quotient.inductionOn' with | _ σ
    obtain ⟨j, a, hja⟩ : ∃ (j : Fin n) (a : Fin p), σ (Sum.inr j) = Sum.inl a := by
      by_contra hcon
      refine hτ (mk_eq_one_of_inr σ fun j => ?_)
      rcases hc : σ (Sum.inr j) with a | j'
      · exact absurd ⟨j, a, hc⟩ hcon
      · exact ⟨j', rfl⟩
    exact summand_eq_zero_of_map_inr r π σ v j (by rw [hja, hvl, hπii])
  · rw [AlternatingMap.domCoprod.summand_mk'']
    simp only [MultilinearMap.domDomCongr_apply, MultilinearMap.domCoprod_apply,
      AlternatingMap.coe_multilinearMap, Equiv.Perm.sign_one, one_smul, Equiv.Perm.coe_one,
      id_eq, AlternatingMap.compLinearMap_apply]
    congr 1
    · congr 1
      funext a
      rw [hvl, hri]
    · congr 1
      funext j
      rw [hvr]
      rfl

/-- Precomposing `topWedgeProjection` with the functorial map of a linear endomorphism of the
source amounts to precomposing `r` and `π` with that endomorphism. -/
theorem topWedgeProjection_comp_map (p n : ℕ) (r : L →ₗ[R] K) (π : L →ₗ[R] Mzero)
    (u : L →ₗ[R] L) :
    (topWedgeProjection p n r π) ∘ₗ exteriorPower.map (p + n) u =
      topWedgeProjection p n (r ∘ₗ u) (π ∘ₗ u) := by
  refine LinearMap.ext_on (exteriorPower.ιMulti_span (R := R) (n := p + n) (M := L)) ?_
  rintro - ⟨w, rfl⟩
  simp only [LinearMap.coe_comp, Function.comp_apply, exteriorPower.map_apply_ιMulti,
    topWedgeProjection_apply_ιMulti]
  rw [AlternatingMap.domCoprod_apply, AlternatingMap.domCoprod_apply, _root_.sum_apply,
    _root_.sum_apply]
  refine Finset.sum_congr rfl fun τ _ => ?_
  induction τ using Quotient.inductionOn' with | _ σ
  rw [AlternatingMap.domCoprod.summand_mk'', AlternatingMap.domCoprod.summand_mk'']
  simp only [smul_apply, MultilinearMap.domDomCongr_apply, MultilinearMap.domCoprod_apply,
    AlternatingMap.coe_multilinearMap, AlternatingMap.compLinearMap_apply, LinearMap.coe_comp]
  rfl

/-- A family of `p + n` elements, all but fewer than `p` of which lie in the range of a family
of `n` elements, has a repeated entry. -/
private theorem exists_ne_eq_of_card_lt {α : Type*} {p n : ℕ} (g : Fin n → α) (w : Fin (p + n) → α)
    (A : Finset (Fin (p + n))) (hA : A.card < p) (hw : ∀ j ∉ A, w j ∈ Set.range g) :
    ∃ j₁ j₂, j₁ ≠ j₂ ∧ w j₁ = w j₂ := by
  classical
  have hmaps : ∀ j ∈ Aᶜ, w j ∈ Finset.univ.image g := fun j hj => by
    obtain ⟨k, hk⟩ := hw j (Finset.mem_compl.1 hj)
    exact Finset.mem_image.2 ⟨k, Finset.mem_univ _, hk⟩
  have hcard : (Finset.univ.image g).card < Aᶜ.card :=
    Finset.card_image_le.trans_lt (by rw [Finset.card_compl]; simp; omega)
  obtain ⟨j₁, -, j₂, -, hne, heqw⟩ := Finset.exists_ne_map_eq_of_card_lt_of_maps_to hcard hmaps
  exact ⟨j₁, j₂, hne, heqw⟩

/-- A basis of `M⁰` lifts to a splitting `s` of `π` such that `L` is spanned by the image of `i`
and the lifted basis `g`. -/
private theorem exists_section_span_eq_top {n : ℕ} {i : K →ₗ[R] L} {π : L →ₗ[R] Mzero}
    (hexact : Function.Exact i π) (hπ : Function.Surjective π) (b : Module.Basis (Fin n) R Mzero) :
    ∃ (g : Fin n → L) (s : Mzero →ₗ[R] L), (∀ y, π (s y) = y) ∧
      (∀ x : L, ∃ k : K, x = i k + s (π x)) ∧
      Submodule.span R (Set.range i ∪ Set.range g) = ⊤ := by
  obtain ⟨g, hg⟩ : ∃ g : Fin n → L, ∀ k, π (g k) = b k :=
    ⟨fun k => (hπ (b k)).choose, fun k => (hπ (b k)).choose_spec⟩
  set s : Mzero →ₗ[R] L := b.constr R g with hsdef
  have hπs : ∀ y, π (s y) = y := by
    have h : π ∘ₗ s = LinearMap.id := b.ext fun k => by simp [hsdef, hg]
    intro y
    simpa using LinearMap.congr_fun h y
  have hsrange : ∀ y, s y ∈ Submodule.span R (Set.range g) := by
    intro y
    rw [hsdef, ← b.constr_range (S := R)]
    exact ⟨y, rfl⟩
  have hsplit : ∀ x : L, ∃ k : K, x = i k + s (π x) := by
    intro x
    obtain ⟨k, hk⟩ := (hexact (x - s (π x))).1 (by simp [hπs])
    exact ⟨k, by rw [hk]; abel⟩
  refine ⟨g, s, hπs, hsplit, Submodule.eq_top_iff'.2 fun l => ?_⟩
  obtain ⟨k, hk⟩ := hsplit l
  rw [hk]
  refine Submodule.add_mem _ (Submodule.subset_span (Or.inl ⟨k, rfl⟩)) ?_
  exact Submodule.span_mono Set.subset_union_right (hsrange (π l))

/-- The projection `π_p` of Tag 0FL8 does not depend on the retraction `r`. -/
theorem topWedgeProjection_congr {p n : ℕ}
    {i : K →ₗ[R] L} {π : L →ₗ[R] Mzero} (r r' : L →ₗ[R] K)
    (hexact : Function.Exact i π) (hπ : Function.Surjective π)
    (hr : r.comp i = LinearMap.id) (hr' : r'.comp i = LinearMap.id)
    (b : Module.Basis (Fin n) R Mzero) :
    topWedgeProjection p n r π = topWedgeProjection p n r' π := by
  classical
  have hπi : ∀ k : K, π (i k) = 0 := fun k => (hexact (i k)).2 ⟨k, rfl⟩
  have hri : ∀ k : K, r (i k) = k := fun k => LinearMap.congr_fun hr k
  have hr'i : ∀ k : K, r' (i k) = k := fun k => LinearMap.congr_fun hr' k
  obtain ⟨g, s, hπs, hsplit, hspan⟩ := exists_section_span_eq_top hexact hπ b
  set φ : Mzero →ₗ[R] K := (r' - r) ∘ₗ s with hφdef
  have hφ : ∀ x : L, r' x = r x + φ (π x) := by
    intro x
    obtain ⟨k, hk⟩ := hsplit x
    have e1 : r' x = r' (i k) + r' (s (π x)) := by rw [← map_add, ← hk]
    have e2 : r x = r (i k) + r (s (π x)) := by rw [← map_add, ← hk]
    have e3 : φ (π x) = r' (s (π x)) - r (s (π x)) := by
      simp [hφdef]
    rw [e1, e2, e3, hri, hr'i]
    abel
  set u : L →ₗ[R] L := LinearMap.id + i ∘ₗ φ ∘ₗ π with hudef
  have huapp : ∀ x : L, u x = x + i (φ (π x)) := by
    intro x; simp [hudef]
  have hπu : π ∘ₗ u = π := by
    refine LinearMap.ext fun x => ?_
    rw [LinearMap.comp_apply, huapp, map_add, hπi, add_zero]
  have hru : r ∘ₗ u = r' := by
    refine LinearMap.ext fun x => ?_
    rw [LinearMap.comp_apply, huapp, map_add, hri, hφ x]
  have key : (topWedgeProjection p n r π) ∘ₗ exteriorPower.map (p + n) u
      = topWedgeProjection p n r π := by
    refine LinearMap.ext_on (exteriorPower.ιMulti_span_of_span (R := R) (n := p + n)
      (M := L) hspan) ?_
    rintro - ⟨w, hw, rfl⟩
    simp only [LinearMap.coe_comp, Function.comp_apply, exteriorPower.map_apply_ιMulti]
    set A : Finset (Fin (p + n)) := Finset.univ.filter (fun j => π (w j) = 0) with hAdef
    have hAmem : ∀ j, j ∈ A ↔ π (w j) = 0 := by
      intro j; simp [hAdef]
    rcases lt_trichotomy A.card p with hlt | heq | hgt
    · obtain ⟨j₁, j₂, hne, heqw⟩ := exists_ne_eq_of_card_lt g w A hlt fun j hj => by
        rcases hw (Set.mem_range_self j) with ⟨k, hk⟩ | h
        · exact absurd ((hAmem j).2 (by rw [← hk]; exact hπi k)) hj
        · exact h
      have h1 : exteriorPower.ιMulti R (p + n) (⇑u ∘ w) = 0 :=
        (exteriorPower.ιMulti R (p + n)).map_eq_zero_of_eq _
          (i := j₁) (j := j₂) (by simp only [Function.comp_apply, heqw]) hne
      have h2 : exteriorPower.ιMulti R (p + n) w = 0 :=
        (exteriorPower.ιMulti R (p + n)).map_eq_zero_of_eq _ (i := j₁) (j := j₂) heqw hne
      rw [h1, h2]
    · set z : Fin (p + n) → L := fun j => i (φ (π (w j))) with hzdef
      have hπz : ∀ j, π (z j) = 0 := fun j => hπi _
      have hzw : (⇑u ∘ w) = z + w := by
        funext j
        simp only [Function.comp_apply, huapp, hzdef, Pi.add_apply]
        abel
      have hexp : exteriorPower.ιMulti R (p + n) (z + w)
          = ∑ S : Finset (Fin (p + n)),
              exteriorPower.ιMulti R (p + n) (S.piecewise z w) := by
        simpa using (exteriorPower.ιMulti R (p + n)).toMultilinearMap.map_add_univ z w
      have hvanish : ∀ S : Finset (Fin (p + n)), S ∈ (Finset.univ : Finset _) → S ≠ ∅ →
          topWedgeProjection p n r π
            (exteriorPower.ιMulti R (p + n) (S.piecewise z w)) = 0 := by
        intro S _ hSne
        obtain ⟨j₀, hj₀⟩ := Finset.nonempty_iff_ne_empty.2 hSne
        by_cases hsub : S ⊆ A
        · have hz0 : S.piecewise z w j₀ = 0 := by
            rw [Finset.piecewise_eq_of_mem _ _ _ hj₀]
            have h4 : π (w j₀) = 0 := (hAmem j₀).1 (hsub hj₀)
            simp [hzdef, h4]
          rw [(exteriorPower.ιMulti R (p + n)).map_coord_zero j₀ hz0, map_zero]
        · obtain ⟨j₁, hj₁S, hj₁A⟩ := Finset.not_subset.1 hsub
          refine topWedgeProjection_eq_zero_of_card_lt r π _ (S ∪ A) ?_ ?_
          · have hss : A ⊂ S ∪ A :=
              (Finset.ssubset_iff_of_subset Finset.subset_union_right).2
                ⟨j₁, Finset.mem_union_left _ hj₁S, hj₁A⟩
            have h5 := Finset.card_lt_card hss
            omega
          · intro j hj
            by_cases hjS : j ∈ S
            · rw [Finset.piecewise_eq_of_mem _ _ _ hjS]; exact hπz j
            · rw [Finset.piecewise_eq_of_notMem _ _ _ hjS]
              rcases Finset.mem_union.1 hj with h6 | h6
              · exact absurd h6 hjS
              · exact (hAmem j).1 h6
      rw [hzw, hexp, map_sum,
        Finset.sum_eq_single_of_mem ∅ (Finset.mem_univ _) hvanish, Finset.piecewise_empty]
    · have h1 : topWedgeProjection p n r π
          (exteriorPower.ιMulti R (p + n) (⇑u ∘ w)) = 0 := by
        refine topWedgeProjection_eq_zero_of_card_lt r π (⇑u ∘ w) A hgt fun j hj => ?_
        simp only [Function.comp_apply]
        rw [← LinearMap.comp_apply, hπu]
        exact (hAmem j).1 hj
      have h2 : topWedgeProjection p n r π (exteriorPower.ιMulti R (p + n) w) = 0 :=
        topWedgeProjection_eq_zero_of_card_lt r π w A hgt fun j hj => (hAmem j).1 hj
      rw [h1, h2]
  have hA' : topWedgeProjection p n r' π
      = (topWedgeProjection p n r π) ∘ₗ exteriorPower.map (p + n) u := by
    rw [topWedgeProjection_comp_map, hru, hπu]
  rw [hA', key]

/-- Exterior multiplication `⋀^q L × ⋀^(p+n) L → ⋀^(q+p+n) L`: the right-hand grouping
`q + (p + n)` on the source, the left-hand grouping `(q + p) + n` on the target. -/
noncomputable def wedgeAssoc (q p n : ℕ) :
    (⋀[R]^q L) →ₗ[R] (⋀[R]^(p + n) L) →ₗ[R] (⋀[R]^(q + p + n) L) :=
  LinearMap.mk₂ R
    (fun a c => ⟨(a : ExteriorAlgebra R L) * (c : ExteriorAlgebra R L), by
      rw [Nat.add_assoc]
      exact SetLike.mul_mem_graded a.2 c.2⟩)
    (fun a a' c => Subtype.ext (add_mul _ _ _))
    (fun t a c => Subtype.ext (smul_mul_assoc _ _ _))
    (fun a c c' => Subtype.ext (mul_add _ _ _))
    (fun t a c => Subtype.ext (mul_smul_comm _ _ _))

/-- In the exterior algebra, `wedgeAssoc q p n a c` is the product `a * c`. -/
@[simp]
theorem wedgeAssoc_coe (q p n : ℕ) (a : ⋀[R]^q L) (c : ⋀[R]^(p + n) L) :
    ((wedgeAssoc q p n a c : ⋀[R]^(q + p + n) L) : ExteriorAlgebra R L) =
      (a : ExteriorAlgebra R L) * (c : ExteriorAlgebra R L) := rfl

/-- `wedgeAssoc` on generators: it concatenates the three families, with the
associativity of `Fin.append` taken care of by the grouping of the indices. -/
theorem wedgeAssoc_ιMulti (q p n : ℕ) (u : Fin q → L) (v : Fin p → L) (l : Fin n → L) :
    wedgeAssoc q p n (exteriorPower.ιMulti R q u)
        (exteriorPower.ιMulti R (p + n) (Fin.append v l)) =
      exteriorPower.ιMulti R (q + p + n) (Fin.append (Fin.append u v) l) :=
  Subtype.ext (by
    simp only [wedgeAssoc_coe, exteriorPower.ιMulti_apply_coe]
    rw [← ExteriorAlgebra.ιMulti_mul_ιMulti (R := R) v l,
      ← ExteriorAlgebra.ιMulti_mul_ιMulti (R := R) (Fin.append u v) l,
      ← ExteriorAlgebra.ιMulti_mul_ιMulti (R := R) u v, mul_assoc])

/-- The set of exterior products of `p + n` vectors whose first `p` factors lie in the image
of `i`. -/
def appendSet (p n : ℕ) (i : K →ₗ[R] L) : Set (⋀[R]^(p + n) L) :=
  {x | ∃ (k : Fin p → K) (l : Fin n → L),
    x = exteriorPower.ιMulti R (p + n) (Fin.append (i ∘ k) l)}

/-- If `L` is spanned by the image of `i` together with `n` vectors `g 0, …, g (n-1)`, then
`⋀^(p+n) L` is spanned by the exterior products of `p + n` vectors whose first `p` factors lie in
the image of `i`. -/
theorem span_appendSet (p n : ℕ) {i : K →ₗ[R] L} (g : Fin n → L)
    (hspan : Submodule.span R (Set.range i ∪ Set.range g) = ⊤) :
    Submodule.span R (appendSet p n i) = ⊤ := by
  classical
  refine top_unique ?_
  rw [← exteriorPower.ιMulti_span_of_span R (p + n) L hspan, Submodule.span_le]
  rintro - ⟨w, hw, rfl⟩
  set A : Finset (Fin (p + n)) := Finset.univ.filter (fun j => w j ∈ Set.range i) with hAdef
  have hAmem : ∀ j, j ∈ A ↔ w j ∈ Set.range i := by intro j; simp [hAdef]
  rcases lt_or_ge A.card p with hlt | hge
  · obtain ⟨j₁, j₂, hne, heqw⟩ := exists_ne_eq_of_card_lt g w A hlt fun j hj => by
      rcases hw (Set.mem_range_self j) with h | h
      · exact absurd ((hAmem j).2 h) hj
      · exact h
    have hzero : exteriorPower.ιMulti R (p + n) w = 0 :=
      (exteriorPower.ιMulti R (p + n)).map_eq_zero_of_eq w heqw hne
    rw [SetLike.mem_coe, hzero]
    exact Submodule.zero_mem _
  · obtain ⟨A', hA'sub, hA'card⟩ := Finset.exists_subset_card_eq hge
    set B : Finset (Fin (p + n)) :=
      Finset.univ.image (Fin.castAdd n : Fin p → Fin (p + n)) with hBdef
    have hBcard : B.card = p := by
      rw [hBdef, Finset.card_image_of_injective _ (Fin.castAdd_injective p n), Finset.card_univ,
        Fintype.card_fin]
    have hcardeq : Fintype.card {j : Fin (p + n) // j ∈ B} =
        Fintype.card {j : Fin (p + n) // j ∈ A'} := by
      simp only [Fintype.card_coe, hBcard, hA'card]
    set e := Fintype.equivOfCardEq hcardeq with hedef
    set σ : Equiv.Perm (Fin (p + n)) := e.extendSubtype with hσdef
    have hmemA : ∀ j : Fin p, w (σ (Fin.castAdd n j)) ∈ Set.range i := by
      intro j
      have h1 : (Fin.castAdd n j : Fin (p + n)) ∈ B :=
        Finset.mem_image.2 ⟨j, Finset.mem_univ _, rfl⟩
      have h2 : σ (Fin.castAdd n j) ∈ A' := Equiv.extendSubtype_mem e _ h1
      exact (hAmem _).1 (hA'sub h2)
    choose kk hkk using hmemA
    have hwσ : w ∘ σ = Fin.append (i ∘ kk) (fun j => w (σ (Fin.natAdd p j))) := by
      funext j
      refine Fin.addCases (fun a => ?_) (fun a => ?_) j
      · rw [Fin.append_left]
        simpa using (hkk a).symm
      · rw [Fin.append_right]
        rfl
    have hmem0 : exteriorPower.ιMulti R (p + n) (w ∘ σ) ∈ appendSet p n i :=
      ⟨kk, _, by rw [hwσ]⟩
    have hperm : exteriorPower.ιMulti R (p + n) (w ∘ σ) =
        Equiv.Perm.sign σ • exteriorPower.ιMulti R (p + n) w :=
      (exteriorPower.ιMulti R (p + n)).map_perm w σ
    have heq2 : exteriorPower.ιMulti R (p + n) w =
        Equiv.Perm.sign σ • exteriorPower.ιMulti R (p + n) (w ∘ σ) := by
      rw [hperm, smul_smul, Int.units_mul_self, one_smul]
    rw [SetLike.mem_coe, heq2, Units.smul_def, ← Int.cast_smul_eq_zsmul R]
    exact Submodule.smul_mem _ _ (Submodule.subset_span hmem0)

/-- The `⋀^* K`-linearity of the projection, as an identity of linear maps: wedging on the left
with `i ω` and then projecting is the same as projecting and then wedging the `K`-factor with
`ω`. -/
theorem topWedgeProjection_comp_wedgeAssoc {q p n : ℕ} {i : K →ₗ[R] L} (r : L →ₗ[R] K)
    (π : L →ₗ[R] Mzero) (hr : r.comp i = LinearMap.id) (hπi : π.comp i = 0) (g : Fin n → L)
    (hspan : Submodule.span R (Set.range i ∪ Set.range g) = ⊤) (ω : ⋀[R]^q K) :
    (topWedgeProjection (q + p) n r π).comp (wedgeAssoc q p n (exteriorPower.map q i ω)) =
      (TensorProduct.map (exteriorPower.wedgeMul (R := R) q p ω) LinearMap.id).comp
        (topWedgeProjection p n r π) := by
  classical
  refine LinearMap.ext_on (span_appendSet p n g hspan) ?_
  rintro - ⟨k, l, rfl⟩
  simp only [LinearMap.comp_apply]
  rw [topWedgeProjection_apply_append r π hr hπi k l, TensorProduct.map_tmul,
    LinearMap.id_coe, id_eq]
  have hmem : ω ∈ Submodule.span R (Set.range (exteriorPower.ιMulti R q)) := by
    rw [exteriorPower.ιMulti_span]; exact Submodule.mem_top
  induction hmem using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨κ, rfl⟩ := hx
      rw [exteriorPower.map_apply_ιMulti, wedgeAssoc_ιMulti, ← comp_append,
        topWedgeProjection_apply_append r π hr hπi (Fin.append κ k) l,
        exteriorPower.wedgeMul_ιMulti]
  | zero => simp
  | add x y _ _ hx hy =>
      simp only [map_add, LinearMap.add_apply, TensorProduct.add_tmul]
      rw [hx, hy]
  | smul t x _ hx =>
      simp only [map_smul, LinearMap.smul_apply]
      rw [hx, TensorProduct.smul_tmul']

/-- If `ξ = i(ω) ∧ ζ` in the exterior algebra, then `π_{q+p} ξ` is obtained from `π_p ζ` by
wedging the `K`-factor with `ω`. -/
theorem topWedgeProjection_wedge {q p n : ℕ} {i : K →ₗ[R] L} (r : L →ₗ[R] K)
    (π : L →ₗ[R] Mzero) (hr : r.comp i = LinearMap.id) (hπi : π.comp i = 0)
    (b : Module.Basis (Fin n) R Mzero) (hπsurj : Function.Surjective π)
    (hexact : Function.Exact i π)
    (ω : ⋀[R]^q K) (ζ : ⋀[R]^(p + n) L) (ξ : ⋀[R]^(q + p + n) L)
    (hξ : (ξ : ExteriorAlgebra R L) =
      (exteriorPower.map q i ω : ExteriorAlgebra R L) * (ζ : ExteriorAlgebra R L)) :
    topWedgeProjection (q + p) n r π ξ =
      (TensorProduct.map (exteriorPower.wedgeMul (R := R) q p ω) LinearMap.id)
        (topWedgeProjection p n r π ζ) := by
  classical
  obtain ⟨g, -, -, -, hspan⟩ := exists_section_span_eq_top hexact hπsurj b
  have hxi : ξ = wedgeAssoc q p n (exteriorPower.map q i ω) ζ := Subtype.ext hξ
  rw [hxi]
  exact LinearMap.congr_fun (topWedgeProjection_comp_wedgeAssoc r π hr hπi g hspan ω) ζ

end TwoTerm

section Determinant

variable (R : Type u) [CommRing R]

/-- The determinant line of a two-term complex `M⁻¹ → M⁰`, when both modules have rank `n`. -/
abbrev twoTermDeterminant (n : ℕ) (Mneg : Type y) (Mzero : Type x)
    [AddCommGroup Mneg] [Module R Mneg] [AddCommGroup Mzero] [Module R Mzero] :=
  (⋀[R]^n Mzero) ⊗[R] Module.Dual R (⋀[R]^n Mneg)

/-- The canonical determinant element associated to the differential of a two-term complex. -/
noncomputable def twoTermDeterminantElement {n : ℕ} {Mneg : Type y} {Mzero : Type x}
    [AddCommGroup Mneg] [Module R Mneg] [AddCommGroup Mzero] [Module R Mzero]
    (d : Mneg →ₗ[R] Mzero) (hneg : Nonempty (Module.Basis (Fin n) R Mneg)) :
    twoTermDeterminant R n Mneg Mzero :=
  letI := Module.Free.of_basis (Classical.choice hneg)
  letI := Module.Finite.of_basis (Classical.choice hneg)
  (TensorProduct.comm R _ _)
    ((dualTensorHomEquiv R (⋀[R]^n Mneg) (⋀[R]^n Mzero)).symm (exteriorPower.map n d))

variable {R}
variable {Mneg : Type y} [AddCommGroup Mneg] [Module R Mneg]

/-- The pair consisting of the top wedge of `D ∘ b` and the dual of the top wedge of `b` does
not depend on the basis `b`. -/
theorem ιMulti_tmul_basisTopDual_eq {n : ℕ} {Y : Type x} [AddCommGroup Y] [Module R Y]
    (D : Mneg →ₗ[R] Y) (b b' : Module.Basis (Fin n) R Mneg) :
    exteriorPower.ιMulti R n (D ∘ b') ⊗ₜ[R] basisTopDual b' =
      exteriorPower.ιMulti R n (D ∘ b) ⊗ₜ[R] basisTopDual b := by
  classical
  have h1 : exteriorPower.ιMulti R n (b' : Fin n → Mneg)
      = (b.det b') • exteriorPower.ιMulti R n (b : Fin n → Mneg) := by
    have h := eq_basisTopDual_smul b (LinearMap.id) (exteriorPower.ιMulti R n b')
    simpa [basisTopDual] using h
  have h2 : exteriorPower.ιMulti R n (D ∘ b')
      = (b.det b') • exteriorPower.ιMulti R n (D ∘ b) := by
    have h := congrArg (exteriorPower.map n D) h1
    simpa [exteriorPower.map_apply_ιMulti, Function.comp_def] using h
  have h3 : basisTopDual b' = (b'.det b) • basisTopDual b := by
    rw [basisTopDual, basisTopDual, ← map_smul]
    exact congrArg _ ((Module.Basis.det b').eq_smul_basis_det b)
  have h4 : (b.det b') * (b'.det b) = 1 := by
    rw [Module.Basis.det_apply, Module.Basis.det_apply, ← Matrix.det_mul,
      Module.Basis.toMatrix_mul_toMatrix_flip, Matrix.det_one]
  have h4' : (b'.det b) * (b.det b') = 1 := by rw [mul_comm]; exact h4
  rw [h2, h3, TensorProduct.tmul_smul, TensorProduct.smul_tmul', smul_smul, h4', one_smul]

/-- The canonical determinant element is computed by any basis of `M⁻¹`. -/
theorem twoTermDeterminantElement_eq {n : ℕ} {Mzero : Type x} [AddCommGroup Mzero]
    [Module R Mzero] (d : Mneg →ₗ[R] Mzero)
    (hneg : Nonempty (Module.Basis (Fin n) R Mneg)) (b : Module.Basis (Fin n) R Mneg) :
    twoTermDeterminantElement R d hneg =
      exteriorPower.ιMulti R n (d ∘ b) ⊗ₜ[R] basisTopDual b := by
  let _ := Module.Free.of_basis (Classical.choice hneg)
  let _ := Module.Finite.of_basis (Classical.choice hneg)
  have hkey : (dualTensorHomEquiv R (⋀[R]^n Mneg) (⋀[R]^n Mzero)).symm (exteriorPower.map n d)
      = basisTopDual b ⊗ₜ[R] exteriorPower.ιMulti R n (d ∘ b) := by
    rw [LinearEquiv.symm_apply_eq]
    refine linearMap_top_ext b ?_
    simp [dualTensorHomEquiv, dualTensorHom_apply, exteriorPower.map_apply_ιMulti]
  rw [twoTermDeterminantElement, hkey]
  simp

end Determinant

section FunnyMapLift

variable {R : Type u} [CommRing R] {K : Type v} {L : Type w} {Mzero : Type x} {Mneg : Type y}
variable [AddCommGroup K] [Module R K] [AddCommGroup L] [Module R L]
variable [AddCommGroup Mzero] [Module R Mzero] [AddCommGroup Mneg] [Module R Mneg]

/-- The expression in the proof of Tag 0FL8 before descending to `H⁰`: wedge with
`d(b₁) ∧ ⋯ ∧ d(bₙ)`, apply `π_p`, and tensor with the inverse of `b₁ ∧ ⋯ ∧ bₙ`. -/
noncomputable def funnyMapLift (p n : ℕ) (r : L →ₗ[R] K)
    (π : L →ₗ[R] Mzero) (d : Mneg →ₗ[R] L) (b : Module.Basis (Fin n) R Mneg) :
    (⋀[R]^p L) →ₗ[R] (⋀[R]^p K) ⊗[R] twoTermDeterminant R n Mneg Mzero :=
  (TensorProduct.assoc R (⋀[R]^p K) (⋀[R]^n Mzero)
      (Module.Dual R (⋀[R]^n Mneg))).toLinearMap.comp
    (((TensorProduct.mk R _ _).flip (basisTopDual b)).comp
      ((topWedgeProjection p n r π).comp
        ((exteriorPower.wedgeMul (R := R) p n).flip (exteriorPower.ιMulti R n (d ∘ b)))))

/-- `funnyMapLift` sends `η` to the image under the tensor associator of
`topWedgeProjection p n r π (η ∧ d(b₀) ∧ ⋯ ∧ d(bₙ₋₁)) ⊗ basisTopDual b`. -/
theorem funnyMapLift_apply (p n : ℕ) (r : L →ₗ[R] K)
    (π : L →ₗ[R] Mzero) (d : Mneg →ₗ[R] L) (b : Module.Basis (Fin n) R Mneg)
    (η : ⋀[R]^p L) :
    funnyMapLift p n r π d b η =
      TensorProduct.assoc R (⋀[R]^p K) (⋀[R]^n Mzero)
        (Module.Dual R (⋀[R]^n Mneg))
        (topWedgeProjection p n r π
          (exteriorPower.wedgeMul (R := R) p n η (exteriorPower.ιMulti R n (d ∘ b))) ⊗ₜ[R]
            basisTopDual b) := rfl

/-- The lift expression does not depend on the chosen basis of `M⁻¹`. -/
theorem funnyMapLift_eq_of_basis (p n : ℕ) (r : L →ₗ[R] K) (π : L →ₗ[R] Mzero)
    (d : Mneg →ₗ[R] L) (b b' : Module.Basis (Fin n) R Mneg) :
    funnyMapLift p n r π d b = funnyMapLift p n r π d b' := by
  refine LinearMap.ext fun η => ?_
  have key : ∀ c : Module.Basis (Fin n) R Mneg,
      funnyMapLift p n r π d c η =
        (TensorProduct.assoc R (⋀[R]^p K) (⋀[R]^n Mzero) (Module.Dual R (⋀[R]^n Mneg)))
          ((TensorProduct.map ((topWedgeProjection p n r π).comp
                (exteriorPower.wedgeMul (R := R) p n η))
              LinearMap.id)
            (exteriorPower.ιMulti R n (d ∘ c) ⊗ₜ[R] basisTopDual c)) := by
    intro c
    rw [funnyMapLift_apply]
    simp
  rw [key b, key b', ιMulti_tmul_basisTopDual_eq d b b']

/-- On a wedge of elements of `K`, the lift expression of Tag 0FL8 is the tensor with the
determinant element. -/
theorem funnyMapLift_map (p n : ℕ) {i : K →ₗ[R] L} (r : L →ₗ[R] K) (π : L →ₗ[R] Mzero)
    (d : Mneg →ₗ[R] L) (dM : Mneg →ₗ[R] Mzero) (b : Module.Basis (Fin n) R Mneg)
    (hr : r.comp i = LinearMap.id) (hπi : π.comp i = 0) (hsquare : π.comp d = dM)
    (hneg : Nonempty (Module.Basis (Fin n) R Mneg)) (ω : ⋀[R]^p K) :
    funnyMapLift p n r π d b (exteriorPower.map p i ω) =
      ω ⊗ₜ[R] twoTermDeterminantElement R dM hneg := by
  have hdb : π ∘ (d ∘ (b : Fin n → Mneg)) = dM ∘ (b : Fin n → Mneg) := by
    funext j
    exact DFunLike.congr_fun hsquare (b j)
  have hmem : ω ∈ Submodule.span R (Set.range (exteriorPower.ιMulti R p)) := by
    rw [exteriorPower.ιMulti_span]; exact Submodule.mem_top
  induction hmem using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨k, rfl⟩ := hx
      rw [funnyMapLift_apply, twoTermDeterminantElement_eq dM hneg b,
        exteriorPower.map_apply_ιMulti, exteriorPower.wedgeMul_ιMulti,
        topWedgeProjection_apply_append r π hr hπi k (d ∘ b), hdb]
      simp
  | zero => simp
  | add x y _ _ hx hy =>
      rw [map_add, map_add, hx, hy, TensorProduct.add_tmul]
  | smul t x _ hx =>
      rw [map_smul, map_smul, hx, TensorProduct.smul_tmul']

end FunnyMapLift

section FunnyMap

variable {R : Type u} [CommRing R] {K : Type v} {L : Type w} {Mzero : Type x} {Mneg : Type y}
variable [AddCommGroup K] [Module R K] [AddCommGroup L] [Module R L]
variable [AddCommGroup Mzero] [Module R Mzero] [AddCommGroup Mneg] [Module R Mneg]

/-- An injection `i` whose cokernel `π` is free of finite rank admits a retraction. -/
theorem exists_retraction (n : ℕ) (i : K →ₗ[R] L) (π : L →ₗ[R] Mzero)
    (hi : Function.Injective i) (hexact : Function.Exact i π)
    (hπ : Function.Surjective π) (hzero : Nonempty (Module.Basis (Fin n) R Mzero)) :
    ∃ r : L →ₗ[R] K, r.comp i = LinearMap.id := by
  let _ := Module.Free.of_basis (Classical.choice hzero)
  exact ((hexact.split_tfae hi hπ).out 1 2).mp
    (π.exists_rightInverse_of_surjective (LinearMap.range_eq_top.mpr hπ))

/-- An exact pair of maps composes to zero. -/
theorem comp_eq_zero_of_exact {i : K →ₗ[R] L} {π : L →ₗ[R] Mzero}
    (hexact : Function.Exact i π) : π.comp i = 0 :=
  LinearMap.ext fun k => (hexact (i k)).2 ⟨k, rfl⟩

/-- The lift expression depends on the retraction only through the projection `π_p`. -/
theorem funnyMapLift_congr (p n : ℕ) (r r' : L →ₗ[R] K) (π : L →ₗ[R] Mzero)
    (d : Mneg →ₗ[R] L) (b : Module.Basis (Fin n) R Mneg)
    (h : topWedgeProjection p n r π = topWedgeProjection p n r' π) :
    funnyMapLift p n r π d b = funnyMapLift p n r' π d b := by
  simp only [funnyMapLift, h]

/-- The top-wedge construction descends to `⋀ᵖ(L / d(M⁻¹))`, independently of both the
retraction and the basis: there is a family of maps whose value on the image of every
`η : ⋀ᵖ L` is `funnyMapLift p n r π d b η`. -/
@[stacks 0FL8 "top-wedge construction"]
theorem exists_funnyMap (n : ℕ)
    (i : K →ₗ[R] L) (π : L →ₗ[R] Mzero)
    (d : Mneg →ₗ[R] L) (dM : Mneg →ₗ[R] Mzero)
    (_hi : Function.Injective i) (_hexact : Function.Exact i π)
    (_hπ : Function.Surjective π) (_hsquare : π.comp d = dM)
    (_hzero : Nonempty (Module.Basis (Fin n) R Mzero))
    (_hneg : Nonempty (Module.Basis (Fin n) R Mneg)) :
    ∃ c : ∀ p : ℕ, (⋀[R]^p (L ⧸ LinearMap.range d)) →ₗ[R]
        (⋀[R]^p K) ⊗[R] twoTermDeterminant R n Mneg Mzero,
      ∀ (p : ℕ) (r : L →ₗ[R] K), r.comp i = LinearMap.id →
        ∀ (b : Module.Basis (Fin n) R Mneg) (η : ⋀[R]^p L),
          c p (exteriorPower.map p (LinearMap.range d).mkQ η) =
            funnyMapLift p n r π d b η := by
  obtain ⟨r₀, hr₀⟩ := exists_retraction n i π _hi _hexact _hπ _hzero
  let b₀ : Module.Basis (Fin n) R Mneg := Classical.choice _hneg
  let bz : Module.Basis (Fin n) R Mzero := Classical.choice _hzero
  have hex : ∀ p : ℕ, ∃ cp : (⋀[R]^p (L ⧸ LinearMap.range d)) →ₗ[R]
      (⋀[R]^p K) ⊗[R] twoTermDeterminant R n Mneg Mzero,
      ∀ η : ⋀[R]^p L, cp (exteriorPower.map p (LinearMap.range d).mkQ η) =
        funnyMapLift p n r₀ π d b₀ η := fun p =>
    exists_wedge_descent' (Z := (⋀[R]^p K) ⊗[R] twoTermDeterminant R n Mneg Mzero)
      n p (d ∘ b₀) (LinearMap.range d) (range_eq_span_comp_basis d b₀)
      ((TensorProduct.assoc R (⋀[R]^p K) (⋀[R]^n Mzero)
          (Module.Dual R (⋀[R]^n Mneg))).toLinearMap.comp
        (((TensorProduct.mk R _ _).flip (basisTopDual b₀)).comp (topWedgeProjection p n r₀ π)))
  choose c hc using hex
  refine ⟨c, fun p r hr b η => ?_⟩
  rw [hc p η, funnyMapLift_eq_of_basis p n r π d b b₀,
    funnyMapLift_congr p n r₀ r π d b₀
      (topWedgeProjection_congr r₀ r _hexact _hπ hr₀ hr bz)]

/-- The canonical maps `cᵖ : ⋀ᵖ(L / d(M⁻¹)) → ⋀ᵖK ⊗ det(M⁻¹ → M⁰)` attached to the exact
two-term diagram, characterized by `funnyMap_apply_lift`. -/
@[stacks 0FL8 "canonical maps"]
noncomputable def funnyMap (n : ℕ)
    (i : K →ₗ[R] L) (π : L →ₗ[R] Mzero)
    (d : Mneg →ₗ[R] L) (dM : Mneg →ₗ[R] Mzero)
    (hi : Function.Injective i) (hexact : Function.Exact i π)
    (hπ : Function.Surjective π) (hsquare : π.comp d = dM)
    (hzero : Nonempty (Module.Basis (Fin n) R Mzero))
    (hneg : Nonempty (Module.Basis (Fin n) R Mneg)) :
    ∀ p : ℕ, (⋀[R]^p (L ⧸ LinearMap.range d)) →ₗ[R]
      (⋀[R]^p K) ⊗[R] twoTermDeterminant R n Mneg Mzero :=
  (exists_funnyMap n i π d dM hi hexact hπ hsquare hzero hneg).choose

/-- The canonical map on any lift is the top-wedge expression from the proof of Tag 0FL8, for
any basis and any retraction of `K → L`. -/
theorem funnyMap_apply_lift (n p : ℕ)
    (i : K →ₗ[R] L) (π : L →ₗ[R] Mzero)
    (d : Mneg →ₗ[R] L) (dM : Mneg →ₗ[R] Mzero)
    (hi : Function.Injective i) (hexact : Function.Exact i π)
    (hπ : Function.Surjective π) (hsquare : π.comp d = dM)
    (hzero : Nonempty (Module.Basis (Fin n) R Mzero))
    (hneg : Nonempty (Module.Basis (Fin n) R Mneg))
    (r : L →ₗ[R] K) (hr : r.comp i = LinearMap.id)
    (b : Module.Basis (Fin n) R Mneg) (η : ⋀[R]^p L) :
    funnyMap n i π d dM hi hexact hπ hsquare hzero hneg p
        (exteriorPower.map p (LinearMap.range d).mkQ η) =
      funnyMapLift p n r π d b η :=
  (exists_funnyMap n i π d dM hi hexact hπ hsquare hzero hneg).choose_spec p r hr b η

/-- Restricting the degree-`p` canonical map to `K` is tensoring with the determinant
element. -/
@[stacks 0FL8 "restriction to K"]
theorem funnyMap_comp (n p : ℕ)
    (i : K →ₗ[R] L) (π : L →ₗ[R] Mzero)
    (d : Mneg →ₗ[R] L) (dM : Mneg →ₗ[R] Mzero)
    (hi : Function.Injective i) (hexact : Function.Exact i π)
    (hπ : Function.Surjective π) (hsquare : π.comp d = dM)
    (hzero : Nonempty (Module.Basis (Fin n) R Mzero))
    (hneg : Nonempty (Module.Basis (Fin n) R Mneg)) (ω : ⋀[R]^p K) :
    funnyMap n i π d dM hi hexact hπ hsquare hzero hneg p
        (exteriorPower.map p ((LinearMap.range d).mkQ.comp i) ω) =
      ω ⊗ₜ[R] twoTermDeterminantElement R dM hneg := by
  obtain ⟨r, hr⟩ := exists_retraction n i π hi hexact hπ hzero
  let b : Module.Basis (Fin n) R Mneg := Classical.choice hneg
  rw [exteriorPower.map_comp, LinearMap.comp_apply,
    funnyMap_apply_lift n p i π d dM hi hexact hπ hsquare hzero hneg r hr b,
    funnyMapLift_map p n r π d dM b hr (comp_eq_zero_of_exact hexact) hsquare hneg]

/-- The canonical map on exterior generators of `⋀ᵖ(L / d(M⁻¹))`. -/
theorem funnyMap_apply_ιMulti (n p : ℕ)
    (i : K →ₗ[R] L) (π : L →ₗ[R] Mzero)
    (d : Mneg →ₗ[R] L) (dM : Mneg →ₗ[R] Mzero)
    (hi : Function.Injective i) (hexact : Function.Exact i π)
    (hπ : Function.Surjective π) (hsquare : π.comp d = dM)
    (hzero : Nonempty (Module.Basis (Fin n) R Mzero))
    (hneg : Nonempty (Module.Basis (Fin n) R Mneg))
    (r : L →ₗ[R] K) (hr : r.comp i = LinearMap.id)
    (b : Module.Basis (Fin n) R Mneg) (v : Fin p → L) :
    funnyMap n i π d dM hi hexact hπ hsquare hzero hneg p
        (exteriorPower.ιMulti R p (fun j ↦ (LinearMap.range d).mkQ (v j))) =
      funnyMapLift p n r π d b (exteriorPower.ιMulti R p v) := by
  simpa only [exteriorPower.map_apply_ιMulti, Function.comp_def] using
    funnyMap_apply_lift n p i π d dM hi hexact hπ hsquare hzero hneg
    r hr b (exteriorPower.ιMulti R p v)

/-- A map satisfying the lift formula of `funnyMap_apply_lift` for one retraction and one basis
is the canonical map. -/
theorem funnyMap_unique (n p : ℕ)
    (i : K →ₗ[R] L) (π : L →ₗ[R] Mzero)
    (d : Mneg →ₗ[R] L) (dM : Mneg →ₗ[R] Mzero)
    (hi : Function.Injective i) (hexact : Function.Exact i π)
    (hπ : Function.Surjective π) (hsquare : π.comp d = dM)
    (hzero : Nonempty (Module.Basis (Fin n) R Mzero))
    (hneg : Nonempty (Module.Basis (Fin n) R Mneg))
    (r : L →ₗ[R] K) (hr : r.comp i = LinearMap.id)
    (b : Module.Basis (Fin n) R Mneg)
    (c : (⋀[R]^p (L ⧸ LinearMap.range d)) →ₗ[R]
      (⋀[R]^p K) ⊗[R] twoTermDeterminant R n Mneg Mzero)
    (hc : ∀ η : ⋀[R]^p L,
      c (exteriorPower.map p (LinearMap.range d).mkQ η) = funnyMapLift p n r π d b η) :
    c = funnyMap n i π d dM hi hexact hπ hsquare hzero hneg p := by
  refine LinearMap.ext fun η => ?_
  obtain ⟨η, rfl⟩ := exteriorPower.map_surjective (LinearMap.range d).mkQ_surjective η
  exact (hc η).trans
    (funnyMap_apply_lift n p i π d dM hi hexact hπ hsquare hzero hneg r hr b η).symm

/-- In degree zero, the canonical map takes `1` to the determinant element. -/
@[stacks 0FL8 "degree zero"]
theorem funnyMap_zero (n : ℕ)
    (i : K →ₗ[R] L) (π : L →ₗ[R] Mzero)
    (d : Mneg →ₗ[R] L) (dM : Mneg →ₗ[R] Mzero)
    (hi : Function.Injective i) (hexact : Function.Exact i π)
    (hπ : Function.Surjective π) (hsquare : π.comp d = dM)
    (hzero : Nonempty (Module.Basis (Fin n) R Mzero))
    (hneg : Nonempty (Module.Basis (Fin n) R Mneg)) :
    funnyMap n i π d dM hi hexact hπ hsquare hzero hneg 0
        (exteriorPower.ιMulti R 0 (fun j ↦ Fin.elim0 j)) =
      (exteriorPower.ιMulti R 0 (fun j ↦ Fin.elim0 j)) ⊗ₜ[R]
        twoTermDeterminantElement R dM hneg := by
  have hω : exteriorPower.map 0 ((LinearMap.range d).mkQ.comp i)
        (exteriorPower.ιMulti R 0 (fun j : Fin 0 ↦ Fin.elim0 j)) =
      exteriorPower.ιMulti R 0 (fun j : Fin 0 ↦ Fin.elim0 j) := by
    rw [exteriorPower.map_apply_ιMulti]
    congr 1
    funext j
    exact Fin.elim0 j
  rw [← hω, funnyMap_comp n 0 i π d dM hi hexact hπ hsquare hzero hneg]

/-- The canonical maps commute with wedging on the left by an exterior power of `K`. -/
@[stacks 0FL8 "wedge compatibility"]
theorem funnyMap_wedge (n q p : ℕ)
    (i : K →ₗ[R] L) (π : L →ₗ[R] Mzero)
    (d : Mneg →ₗ[R] L) (dM : Mneg →ₗ[R] Mzero)
    (hi : Function.Injective i) (hexact : Function.Exact i π)
    (hπ : Function.Surjective π) (hsquare : π.comp d = dM)
    (hzero : Nonempty (Module.Basis (Fin n) R Mzero))
    (hneg : Nonempty (Module.Basis (Fin n) R Mneg))
    (ω : ⋀[R]^q K) (η : ⋀[R]^p (L ⧸ LinearMap.range d)) :
    funnyMap n i π d dM hi hexact hπ hsquare hzero hneg (q + p)
        (exteriorPower.wedgeMul (R := R) q p
          (exteriorPower.map q ((LinearMap.range d).mkQ.comp i) ω) η) =
      (exteriorPower.wedgeMul (R := R) q p ω).rTensor
        (twoTermDeterminant R n Mneg Mzero)
        (funnyMap n i π d dM hi hexact hπ hsquare hzero hneg p η) := by
  classical
  obtain ⟨r, hr⟩ := exists_retraction n i π hi hexact hπ hzero
  let b : Module.Basis (Fin n) R Mneg := Classical.choice hneg
  let bz : Module.Basis (Fin n) R Mzero := Classical.choice hzero
  obtain ⟨ηt, rfl⟩ := exteriorPower.map_surjective (LinearMap.range d).mkQ_surjective η
  set Ω : ⋀[R]^q L := exteriorPower.map q i ω with hΩ
  have hmapcomp : exteriorPower.map q ((LinearMap.range d).mkQ.comp i) ω =
      exteriorPower.map q (LinearMap.range d).mkQ Ω := by
    rw [hΩ, exteriorPower.map_comp, LinearMap.comp_apply]
  rw [hmapcomp, ← exteriorPower.wedgeMul_map,
    funnyMap_apply_lift n (q + p) i π d dM hi hexact hπ hsquare hzero hneg r hr b,
    funnyMap_apply_lift n p i π d dM hi hexact hπ hsquare hzero hneg r hr b,
    funnyMapLift_apply, funnyMapLift_apply]
  set F : ⋀[R]^n L := exteriorPower.ιMulti R n (d ∘ b) with hF
  set ζ : ⋀[R]^(p + n) L := exteriorPower.wedgeMul (R := R) p n ηt F with hζ
  have hξ : ((exteriorPower.wedgeMul (R := R) (q + p) n
          (exteriorPower.wedgeMul (R := R) q p Ω ηt) F :
        ⋀[R]^(q + p + n) L) : ExteriorAlgebra R L) =
      (Ω : ExteriorAlgebra R L) * (ζ : ExteriorAlgebra R L) := by
    rw [exteriorPower.wedgeMul_apply_coe, exteriorPower.wedgeMul_apply_coe, hζ,
      exteriorPower.wedgeMul_apply_coe, mul_assoc]
  rw [topWedgeProjection_wedge r π hr (comp_eq_zero_of_exact hexact) bz hπ hexact ω ζ _ hξ]
  generalize topWedgeProjection p n r π ζ = y
  induction y using TensorProduct.inductionOn with
  | tmul a c => simp
  | add a c ha hc => simp only [map_add, TensorProduct.add_tmul, ha, hc]

end FunnyMap

end Stacks.DeRham
