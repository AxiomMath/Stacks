/-!
# The determinant pairing of a finite locally free sheaf of modules with its dual

Let `(X, O_X)` be a ringed space and `E` a sheaf of `O_X`-modules with dual
`E^∨ = SheafHom(E, O_X)`. This file constructs the determinant pairing

`⋀ⁿ(E^∨) ⊗ ⋀ⁿ E ⟶ O_X`,  `(λ₁ ∧ ⋯ ∧ λₙ) ⊗ (e₁ ∧ ⋯ ∧ eₙ) ↦ det(λᵢ(eⱼ))`,

and proves that it is an isomorphism when `E` is finite locally free of rank `n`. This is the
identification `⋀ⁿ(E^∨) ≅ (⋀ⁿ E)^∨` used by [Stacks, Tag 0E9Y] to write its canonical map with
target `⋀^{r₁}(E₁^∨) ⊗ ⋀^{r₀} E₀`.

## The construction

On sections over an open `V` the pairing is Mathlib's `exteriorPower.pairingDual` composed with
the exterior power of `λ ↦ λ(-) : E^∨(V) → Hom(E(V), O(V))`; it commutes with restriction
(`Stacks.Duality.detPairingSections_naturality`), so it is a bilinear map of the presheaves of
sectionwise exterior powers (`Stacks.Duality.detBilinear`). By [Stacks, Tag 01CG] the exterior
powers of a sheaf of modules are the sheafifications of the sectionwise ones, the comparison
being locally bijective (`Stacks.Duality.isLocallyInjective_extCmp`,
`Stacks.Duality.isLocallySurjective_extCmp`), so the bilinear map extends uniquely to the
exterior power sheaves, and descends to the tensor product sheaf
(`Stacks.Duality.detDualPairing`).

## Isomorphism

Near any point a sheaf finite locally free of rank `n` has a local frame
(`Stacks.Duality.exists_localFrame`): sections `e₁, …, eₙ` with dual sections `λ₁, …, λₙ` of
`E^∨`, `λᵢ(eⱼ) = δᵢⱼ`, such that every local section of `E` is `∑ λᵢ(g) eᵢ`. Their germs span
the stalks of `E` and of `E^∨` (`Stacks.Duality.LocalFrame.span_germ_e`,
`Stacks.Duality.LocalFrame.span_germ_lam`), so the stalks of `⋀ⁿ E` and of `⋀ⁿ(E^∨)` are cyclic,
generated by the germs of `e₁ ∧ ⋯ ∧ eₙ` and `λ₁ ∧ ⋯ ∧ λₙ`, and the pairing sends the tensor of
the two generators to `det(δᵢⱼ) = 1`. A map between cyclic modules taking a generator to a
torsion-free generator is bijective, so the pairing is bijective on stalks
(`Stacks.Duality.bijective_stalkMapL_detDualPairing`), hence an isomorphism
(`Stacks.Duality.isIso_detDualPairing`), and the stalks of `⋀ⁿ(E^∨)` are free of rank one
(`Stacks.Duality.nonempty_stalk_exteriorPower_dual_linearEquiv`).

## References

* [Stacks Project, Tag 0E9Y](https://stacks.math.columbia.edu/tag/0E9Y)
* [Stacks Project, Tag 01CG](https://stacks.math.columbia.edu/tag/01CG)
* [Stacks Project, Tag 0FNV](https://stacks.math.columbia.edu/tag/0FNV)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace CategoryTheory.Sheaf
open scoped TensorProduct

universe u

namespace ExteriorAlgebra

variable {R S : Type*} [CommRing R] [CommRing S] {M N : Type*} [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N] {M' N' : Type*} [AddCommGroup M'] [Module S M']
  [AddCommGroup N'] [Module S N']

/-- **Naturality of the determinant pairing under a semilinear base change.** -/
theorem pairingDual_map_powMapₛₗ (ρ : R →+* S) (φ : M →ₗ[R] Module.Dual R N)
    (φ' : M' →ₗ[S] Module.Dual S N') (uM : M →ₛₗ[ρ] M') (uN : N →ₛₗ[ρ] N')
    (h : ∀ m n, φ' (uM m) (uN n) = ρ (φ m n)) (k : ℕ) (ω : ⋀[R]^k M) (η : ⋀[R]^k N) :
    ρ ((exteriorPower.pairingDual R N k ∘ₗ exteriorPower.map k φ) ω η) =
      (exteriorPower.pairingDual S N' k ∘ₗ exteriorPower.map k φ')
        (powMapₛₗ k ρ uM ω) (powMapₛₗ k ρ uN η) := by
  have hω : ω ∈ (⊤ : Submodule R (⋀[R]^k M)) := Submodule.mem_top
  rw [← exteriorPower.ιMulti_span] at hω
  induction hω using Submodule.span_induction generalizing η with
  | mem x hx =>
    obtain ⟨s, rfl⟩ := hx
    have hη : η ∈ (⊤ : Submodule R (⋀[R]^k N)) := Submodule.mem_top
    rw [← exteriorPower.ιMulti_span] at hη
    induction hη using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨t, rfl⟩ := hy
      simp only [LinearMap.comp_apply, exteriorPower.map_apply_ιMulti, powMapₛₗ_ιMulti,
        exteriorPower.pairingDual_ιMulti_ιMulti, Function.comp_apply, RingHom.map_det]
      congr 1
      ext i j
      exact (h (s j) (t i)).symm
    | zero => simp
    | add y y' _ _ hy hy' => simp only [map_add, hy, hy']
    | smul a y _ hy => simp only [map_smul, LinearMap.map_smulₛₗ, smul_eq_mul, map_mul, hy]
  | zero => simp
  | add x x' _ _ hx hx' => simp only [map_add, LinearMap.add_apply, hx, hx']
  | smul a x _ hx =>
    simp only [map_smul, LinearMap.map_smulₛₗ, LinearMap.smul_apply, smul_eq_mul, map_mul, hx]

/-- The determinant pairing on wedges. -/
theorem pairingDual_map_ιMulti_ιMulti (φ : M →ₗ[R] Module.Dual R N) (k : ℕ) (s : Fin k → M)
    (t : Fin k → N) :
    (exteriorPower.pairingDual R N k ∘ₗ exteriorPower.map k φ) (exteriorPower.ιMulti R k s)
        (exteriorPower.ιMulti R k t) =
      Matrix.det (Matrix.of fun i j => φ (s j) (t i)) := by
  simp only [LinearMap.comp_apply, exteriorPower.map_apply_ιMulti,
    exteriorPower.pairingDual_ιMulti_ιMulti, Function.comp_apply]

/-- **The top wedge of a spanning family of `n` vectors generates the `n`-th exterior power.** -/
theorem span_singleton_ιMulti_eq_top {k : ℕ} (v : Fin k → M)
    (hv : Submodule.span R (Set.range v) = ⊤) :
    Submodule.span R {exteriorPower.ιMulti R k v} = (⊤ : Submodule R (⋀[R]^k M)) := by
  classical
  refine eq_top_iff.2 ?_
  rw [← exteriorPower.ιMulti_span_of_span (R := R) (n := k) (M := M) (hs := hv), Submodule.span_le]
  rintro - ⟨a, ha, rfl⟩
  choose σ hσ using fun i => ha ⟨i, rfl⟩
  obtain rfl : a = v ∘ σ := funext fun i => (hσ i).symm
  by_cases hinj : Function.Injective σ
  · have hbij : Function.Bijective σ := Finite.injective_iff_bijective.1 hinj
    have h := (exteriorPower.ιMulti R k).map_perm v (Equiv.ofBijective σ hbij)
    refine Eq.mpr (congrArg (· ∈ (Submodule.span R {exteriorPower.ιMulti R k v} : Set _))
      (h : exteriorPower.ιMulti R k (v ∘ σ) = _)) ?_
    exact Submodule.smul_of_tower_mem _ _ (Submodule.mem_span_singleton_self _)
  · obtain ⟨i, i', hii', hne⟩ := Function.not_injective_iff.1 hinj
    have h0 := (exteriorPower.ιMulti R k).map_eq_zero_of_eq (v ∘ σ)
      (show (v ∘ σ) i = (v ∘ σ) i' by simp [hii']) hne
    rw [SetLike.mem_coe, h0]
    exact Submodule.zero_mem _

/-- A generator of a cyclic module is carried to a generator by a linear equivalence. -/
theorem span_singleton_linearEquiv_symm_eq_top (e : M ≃ₗ[R] N) (b : N)
    (h : Submodule.span R {b} = ⊤) : Submodule.span R {e.symm b} = ⊤ := by
  have h3 := congrArg (Submodule.map e.symm.toLinearMap) h
  rwa [Submodule.map_span, Set.image_singleton, Submodule.map_top,
    LinearMap.range_eq_top.2 e.symm.surjective] at h3

/-- **A linear map between cyclic modules sending a generator to a torsion-free generator is
bijective.** -/
theorem bijective_of_span_singleton {T U : Type*} [AddCommGroup T] [Module R T] [AddCommGroup U]
    [Module R U] (f : T →ₗ[R] U) (τ : T) (u : U) (hτ : Submodule.span R {τ} = ⊤)
    (hu : Submodule.span R {u} = ⊤) (hfree : ∀ a : R, a • u = 0 → a = 0) (hf : f τ = u) :
    Function.Bijective f := by
  refine ⟨fun z z' hzz' => ?_, fun y => ?_⟩
  · obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.1 (hτ.ge (Submodule.mem_top : z ∈ ⊤))
    obtain ⟨a', rfl⟩ := Submodule.mem_span_singleton.1 (hτ.ge (Submodule.mem_top : z' ∈ ⊤))
    rw [map_smul, map_smul, hf, ← sub_eq_zero, ← sub_smul] at hzz'
    rw [sub_eq_zero.1 (hfree _ hzz')]
  · obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.1 (hu.ge (Submodule.mem_top : y ∈ ⊤))
    exact ⟨a • τ, by rw [map_smul, hf]⟩

/-- A linear map conjugated by identifications with tensor products is a left tensoring as soon
as it is one on pure tensors. -/
theorem linearEquiv_comp_eq_lTensor {A B B' S S' : Type*} [AddCommGroup A] [Module R A]
    [AddCommGroup B] [Module R B] [AddCommGroup B'] [Module R B'] [AddCommGroup S] [Module R S]
    [AddCommGroup S'] [Module R S'] (e : S ≃ₗ[R] A ⊗[R] B) (e' : S' ≃ₗ[R] A ⊗[R] B')
    (φ : S →ₗ[R] S') (g : B →ₗ[R] B') (h : ∀ a b, e' (φ (e.symm (a ⊗ₜ b))) = a ⊗ₜ g b)
    (z : S) : e' (φ z) = LinearMap.lTensor A g (e z) := by
  have key : ∀ w, e' (φ (e.symm w)) = LinearMap.lTensor A g w := by
    intro w
    induction w using TensorProduct.inductionOn with
    | add w w' hw hw' => simp only [map_add, hw, hw']
    | tmul a b => exact (h a b).trans (LinearMap.lTensor_tmul A g a b).symm
  simpa only [LinearEquiv.symm_apply_apply] using key (e z)

/-- **Tensoring with a free module of rank one detects bijectivity.** -/
theorem bijective_lTensor_iff {A B B' : Type*} [AddCommGroup A] [Module R A] [AddCommGroup B]
    [Module R B] [AddCommGroup B'] [Module R B'] (e : A ≃ₗ[R] R) (g : B →ₗ[R] B') :
    Function.Bijective (LinearMap.lTensor A g) ↔ Function.Bijective g := by
  let eB := (TensorProduct.congr e (LinearEquiv.refl R B)).trans (TensorProduct.lid R B)
  let eB' := (TensorProduct.congr e (LinearEquiv.refl R B')).trans (TensorProduct.lid R B')
  have h : ∀ z, eB' (LinearMap.lTensor A g z) = g (eB z) := by
    intro z
    induction z using TensorProduct.inductionOn with
    | add z z' hz hz' => simp only [map_add, hz, hz']
    | tmul a b =>
      simp only [eB, eB', LinearMap.lTensor_tmul, LinearEquiv.trans_apply,
        TensorProduct.congr_tmul, LinearEquiv.refl_apply, TensorProduct.lid_tmul, map_smul]
  have hfun : (eB' ∘ LinearMap.lTensor A g) = g ∘ eB := funext h
  rw [← Function.Bijective.of_comp_iff' eB'.bijective (LinearMap.lTensor A g), hfun]
  exact Function.Bijective.of_comp_iff g eB.bijective

end ExteriorAlgebra

namespace Stacks.Duality


section DualPairing

variable {X : TopCat.{u}} {Osharp : Sheaf (Opens.grothendieckTopology ↥X) CommRingCat.{u}}

/-- The dual `E^∨ = SheafHom(E, O_X)` of a sheaf of modules on a space. -/
noncomputable abbrev dualMod
    (E : _root_.SheafOfModules.{u} (toRingCat (Opens.grothendieckTopology ↥X) Osharp)) :
    _root_.SheafOfModules.{u} (toRingCat (Opens.grothendieckTopology ↥X) Osharp) :=
  Stacks.SheafOfModules.dualSheaf Osharp.obj
    (toRingCat (Opens.grothendieckTopology ↥X) Osharp).property E

variable (E : _root_.SheafOfModules.{u} (toRingCat (Opens.grothendieckTopology ↥X) Osharp))

/-- The value of a local section of the dual on a local section. -/
noncomputable def dualEvalLinear (V : (Opens ↥X)ᵒᵖ) :
    (dualMod E).val.obj V →ₗ[(Osharp.obj ⋙ forget₂ CommRingCat RingCat).obj V]
      Module.Dual ((Osharp.obj ⋙ forget₂ CommRingCat RingCat).obj V) (E.val.obj V) where
  toFun lam :=
    { toFun := fun e => Stacks.SheafOfModules.evalSection Osharp.obj E.val
        (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val V lam e
      map_add' := fun e e' => Stacks.SheafOfModules.evalSection_add_right _ _ _ V lam e e'
      map_smul' := fun a e => Stacks.SheafOfModules.evalSection_smul_right _ _ _ V a lam e }
  map_add' lam lam' := LinearMap.ext fun e =>
    Stacks.SheafOfModules.evalSection_add_left _ _ _ V lam lam' e
  map_smul' a lam := LinearMap.ext fun e =>
    Stacks.SheafOfModules.evalSection_smul_left _ _ _ V a lam e

example (n : ℕ) (V : (Opens ↥X)ᵒᵖ) :
    (PresheafOfModules.extPow n (dualMod E).val).obj V =
      (PresheafOfModules.extPow n (dualMod E).val).obj V := rfl

/-- The sectionwise determinant pairing. -/
noncomputable def detPairingSections (n : ℕ) (V : (Opens ↥X)ᵒᵖ) :
    ⋀[(Osharp.obj ⋙ forget₂ CommRingCat RingCat).obj V]^n ((dualMod E).val.obj V) →ₗ[
      (Osharp.obj ⋙ forget₂ CommRingCat RingCat).obj V]
      Module.Dual ((Osharp.obj ⋙ forget₂ CommRingCat RingCat).obj V)
        (⋀[(Osharp.obj ⋙ forget₂ CommRingCat RingCat).obj V]^n (E.val.obj V)) :=
  exteriorPower.pairingDual _ _ n ∘ₗ exteriorPower.map n (dualEvalLinear E V)

/-- The value of a restricted dual section on a restricted section is the restriction. -/
theorem dualEvalLinear_restrict {V W : (Opens ↥X)ᵒᵖ} (f : V ⟶ W) (lam : (dualMod E).val.obj V)
    (e : E.val.obj V) :
    dualEvalLinear E W ((dualMod E).val.restrictₛₗ f lam) (E.val.restrictₛₗ f e) =
      ((Osharp.obj ⋙ forget₂ CommRingCat RingCat).map f).hom (dualEvalLinear E V lam e) :=
  Stacks.SheafOfModules.evalSection_naturality Osharp.obj E.val
    (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val f lam e

/-- **The sectionwise determinant pairing commutes with restriction.** -/
theorem detPairingSections_naturality (n : ℕ) {V W : (Opens ↥X)ᵒᵖ} (f : V ⟶ W)
    (ω : ⋀[(Osharp.obj ⋙ forget₂ CommRingCat RingCat).obj V]^n ((dualMod E).val.obj V))
    (η : ⋀[(Osharp.obj ⋙ forget₂ CommRingCat RingCat).obj V]^n (E.val.obj V)) :
    ((Osharp.obj ⋙ forget₂ CommRingCat RingCat).map f).hom (detPairingSections E n V ω η) =
      detPairingSections E n W
        (ExteriorAlgebra.powMapₛₗ n ((Osharp.obj ⋙ forget₂ CommRingCat RingCat).map f).hom
          ((dualMod E).val.restrictₛₗ f) ω)
        (ExteriorAlgebra.powMapₛₗ n ((Osharp.obj ⋙ forget₂ CommRingCat RingCat).map f).hom
          (E.val.restrictₛₗ f) η) :=
  ExteriorAlgebra.pairingDual_map_powMapₛₗ _ (dualEvalLinear E V) (dualEvalLinear E W)
    ((dualMod E).val.restrictₛₗ f) (E.val.restrictₛₗ f) (dualEvalLinear_restrict E f) n ω η

/-- **The determinant pairing on the presheaves of sectionwise exterior powers**,
`⋀ⁿ_{O(V)}(E^∨(V)) × ⋀ⁿ_{O(V)}(E(V)) → O(V)`,
`(λ₁ ∧ ⋯ ∧ λₙ, e₁ ∧ ⋯ ∧ eₙ) ↦ det(λᵢ(eⱼ))`. -/
noncomputable def detBilinear (n : ℕ) :
    Stacks.BilinearMap (PresheafOfModules.extPow n (dualMod E).val)
      (PresheafOfModules.extPow n E.val)
      (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val where
  app V := AddMonoidHom.mk' (fun ω => (detPairingSections E n V ω).toAddMonoidHom)
    (fun ω ω' => AddMonoidHom.ext fun η =>
      LinearMap.congr_fun (map_add (detPairingSections E n V) ω ω') η)
  map_smul_left V r ω η :=
    LinearMap.congr_fun (LinearMap.map_smul (detPairingSections E n V) r ω) η
  map_smul_right V r ω η := LinearMap.map_smul (detPairingSections E n V ω) r η
  naturality f ω η := detPairingSections_naturality E n f ω η

/-- On sections over `V`, `detBilinear E n` is the determinant pairing `detPairingSections`. -/
theorem detBilinear_app (n : ℕ) (V : (Opens ↥X)ᵒᵖ)
    (ω : (PresheafOfModules.extPow n (dualMod E).val).obj V)
    (η : (PresheafOfModules.extPow n E.val).obj V) :
    (detBilinear E n).app V ω η = detPairingSections E n V ω η := rfl

end DualPairing

/-! ### The comparison of Tag 01CG is locally bijective -/

section Comparison

variable {X : TopCat.{u}} {Osharp : Sheaf (Opens.grothendieckTopology ↥X) CommRingCat.{u}}
  {M : _root_.SheafOfModules.{u} (toRingCat (Opens.grothendieckTopology ↥X) Osharp)}
  (A : _root_.SheafOfModules.TensorExteriorSymmetricAlgebras (Opens.grothendieckTopology ↥X) M)

/-- The comparison morphism of Tag 01CG from the presheaf of sectionwise exterior powers to
the exterior power. -/
noncomputable abbrev extCmp (n : ℕ) :
    PresheafOfModules.extPow n M.val ⟶ (A.exteriorPower n).val :=
  A.exterior.extPowCmp (hO := (toRingCat (Opens.grothendieckTopology ↥X) Osharp).property)
    A.exteriorGenerator A.exterior_isExteriorAlgebra.1 n

/-- The comparison `extCmp A n` sends `s₁ ∧ ⋯ ∧ sₙ` to the wedge section of `s`. -/
theorem extCmp_ιMulti (n : ℕ) (V : (Opens ↥X)ᵒᵖ) (s : Fin n → M.val.obj V) :
    (extCmp A n).app V (exteriorPower.ιMulti _ n s) =
      Stacks.SheafOfModules.TopWedge.wedgeSec A V n s :=
  Stacks.GradedAlgebra.extCmpSections_ιMulti A.exterior.toPresheafGradedAlgebra
    A.exteriorGenerator.val (fun X x => A.exterior_isExteriorAlgebra.1 X x) n V s

/-- The comparison morphism `extCmp A n` is locally injective. -/
theorem isLocallyInjective_extCmp (n : ℕ) :
    PresheafOfModules.IsLocallyInjective (Opens.grothendieckTopology ↥X) (extCmp A n) := by
  have hfac := congrArg (fun h => (PresheafOfModules.toPresheaf _).map h)
    (_root_.SheafOfModules.extPowCmp_eq_sheafifyUnit_comp M A.exterior A.exteriorGenerator
      A.exterior_isExteriorAlgebra.1 A.exterior_isExteriorAlgebra n)
  have hiso : Presheaf.IsLocallyInjective (Opens.grothendieckTopology ↥X)
      ((PresheafOfModules.toPresheaf (toRingCat (Opens.grothendieckTopology ↥X) Osharp).obj).map
        ((_root_.SheafOfModules.forget (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).map
          (_root_.SheafOfModules.exteriorPieceIso M A.exterior A.exteriorGenerator
            A.exterior_isExteriorAlgebra (n : ℤ)).hom)) := inferInstance
  exact Stacks.TensorCoherence.isLocallyInjective_of_fac _ _
    (((PresheafOfModules.toPresheaf _).map_comp _ _).symm.trans hfac.symm) inferInstance hiso

/-- The comparison morphism `extCmp A n` is locally surjective. -/
theorem isLocallySurjective_extCmp (n : ℕ) :
    PresheafOfModules.IsLocallySurjective (Opens.grothendieckTopology ↥X) (extCmp A n) := by
  have hfac := congrArg (fun h => (PresheafOfModules.toPresheaf _).map h)
    (_root_.SheafOfModules.extPowCmp_eq_sheafifyUnit_comp M A.exterior A.exteriorGenerator
      A.exterior_isExteriorAlgebra.1 A.exterior_isExteriorAlgebra n)
  have hiso : Presheaf.IsLocallySurjective (Opens.grothendieckTopology ↥X)
      ((PresheafOfModules.toPresheaf (toRingCat (Opens.grothendieckTopology ↥X) Osharp).obj).map
        ((_root_.SheafOfModules.forget (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).map
          (_root_.SheafOfModules.exteriorPieceIso M A.exterior A.exteriorGenerator
            A.exterior_isExteriorAlgebra (n : ℤ)).hom)) := inferInstance
  exact Stacks.TensorCoherence.isLocallySurjective_of_fac _ _
    (((PresheafOfModules.toPresheaf _).map_comp _ _).symm.trans hfac.symm) inferInstance hiso

end Comparison

/-! ### The determinant pairing of sheaves of modules -/

section SheafPairing

variable {X : TopCat.{u}} {Osharp : Sheaf (Opens.grothendieckTopology ↥X) CommRingCat.{u}}
  {E : _root_.SheafOfModules.{u} (toRingCat (Opens.grothendieckTopology ↥X) Osharp)}
  (BD : _root_.SheafOfModules.TensorExteriorSymmetricAlgebras (Opens.grothendieckTopology ↥X)
    (dualMod E))
  (BE : _root_.SheafOfModules.TensorExteriorSymmetricAlgebras (Opens.grothendieckTopology ↥X) E)

/-- The determinant pairing on local sections of the two exterior powers, extended from the
sectionwise exterior powers along the comparison of Tag 01CG in each variable. -/
noncomputable def detSheafBilinear (n : ℕ) :
    Stacks.BilinearMap (BD.exteriorPower n).val (BE.exteriorPower n).val
      (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val :=
  haveI := isLocallyInjective_extCmp BD n
  haveI := isLocallySurjective_extCmp BD n
  haveI := isLocallyInjective_extCmp BE n
  haveI := isLocallySurjective_extCmp BE n
  (Stacks.BilinearMap.compLeftEquiv
      (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).isSheaf
      (extCmp BD n)).symm
    ((Stacks.BilinearMap.compRightEquiv
      (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).isSheaf
      (extCmp BE n)).symm (detBilinear E n))

/-- On images of the comparison morphisms, `detSheafBilinear BD BE n` agrees with the
determinant pairing `detBilinear E n`. -/
theorem detSheafBilinear_extCmp (n : ℕ) (V : (Opens ↥X)ᵒᵖ)
    (ω : (PresheafOfModules.extPow n (dualMod E).val).obj V)
    (η : (PresheafOfModules.extPow n E.val).obj V) :
    (detSheafBilinear BD BE n).app V ((extCmp BD n).app V ω) ((extCmp BE n).app V η) =
      (detBilinear E n).app V ω η := by
  have := isLocallyInjective_extCmp BD n
  have := isLocallySurjective_extCmp BD n
  have := isLocallyInjective_extCmp BE n
  have := isLocallySurjective_extCmp BE n
  have h1 := Stacks.BilinearMap.extendVal_app
    (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).isSheaf
    (extCmp BD n) ((Stacks.BilinearMap.compRightEquiv
      (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).isSheaf
      (extCmp BE n)).symm (detBilinear E n)) ω ((extCmp BE n).app V η)
  have h2 := Stacks.BilinearMap.extendVal_app
    (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).isSheaf
    (extCmp BE n) (detBilinear E n).flip η ω
  exact h1.trans h2

/-- **The determinant pairing** `⋀ⁿ(E^∨) ⊗ ⋀ⁿ E ⟶ O_X`, locally
`(λ₁ ∧ ⋯ ∧ λₙ) ⊗ (e₁ ∧ ⋯ ∧ eₙ) ↦ det(λᵢ(eⱼ))`. -/
noncomputable def detDualPairing (n : ℕ) :
    ((Stacks.SheafOfModules.Tensor.sheafTensor Osharp).obj (BD.exteriorPower n)).obj
        (BE.exteriorPower n) ⟶
      _root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp) :=
  PresheafOfModules.tensorSheafDesc (F := BD.exteriorPower n) (G := BE.exteriorPower n)
    (Q := _root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp))
    (PresheafOfModules.ofBilinear (detSheafBilinear BD BE n))

/-- **The determinant pairing on wedges of local sections** is the determinant of the matrix of
values. -/
theorem detDualPairing_wedge (n : ℕ) (V : (Opens ↥X)ᵒᵖ) (s : Fin n → (dualMod E).val.obj V)
    (t : Fin n → E.val.obj V) :
    (detDualPairing BD BE n).val.app V
        ((PresheafOfModules.tensorSheafUnit (BD.exteriorPower n) (BE.exteriorPower n)).app V
          (Stacks.SheafOfModules.TopWedge.wedgeSec BD V n s ⊗ₜ
            Stacks.SheafOfModules.TopWedge.wedgeSec BE V n t)) =
      Matrix.det (Matrix.of fun i j => dualEvalLinear E V (s j) (t i)) := by
  refine (PresheafOfModules.tensorSheafDesc_unit (F := BD.exteriorPower n)
    (G := BE.exteriorPower n)
    (Q := _root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp))
    (PresheafOfModules.ofBilinear (detSheafBilinear BD BE n)) V
    (Stacks.SheafOfModules.TopWedge.wedgeSec BD V n s)
    (Stacks.SheafOfModules.TopWedge.wedgeSec BE V n t)).trans ?_
  refine (PresheafOfModules.ofBilinear_tmul (detSheafBilinear BD BE n) V
    (Stacks.SheafOfModules.TopWedge.wedgeSec BD V n s)
    (Stacks.SheafOfModules.TopWedge.wedgeSec BE V n t)).trans ?_
  have h3 := detSheafBilinear_extCmp BD BE n V (exteriorPower.ιMulti _ n s)
    (exteriorPower.ιMulti _ n t)
  have h4 := congrArg₂ (fun a b => (detSheafBilinear BD BE n).app V a b)
    (extCmp_ιMulti BD n V s) (extCmp_ιMulti BE n V t)
  exact h4.symm.trans
    (h3.trans (ExteriorAlgebra.pairingDual_map_ιMulti_ιMulti (dualEvalLinear E V) n s t))

end SheafPairing

/-! ### Local frames of a finite locally free sheaf of modules -/

section Frame

variable {X : TopCat.{u}} {Osharp : Sheaf (Opens.grothendieckTopology ↥X) CommRingCat.{u}}
  {E : _root_.SheafOfModules.{u} (toRingCat (Opens.grothendieckTopology ↥X) Osharp)}

/-- A local frame of `E` on an open `V`: a finite dual basis indexed by `Fin n` whose dual
coordinates are dual to its sections. -/
structure LocalFrame (E : _root_.SheafOfModules.{u}
    (toRingCat (Opens.grothendieckTopology ↥X) Osharp)) (n : ℕ) (V : Opens ↥X) where
  /-- The underlying finite dual basis. -/
  b : Stacks.SheafOfModules.FiniteDualBasis Osharp.obj
    (toRingCat (Opens.grothendieckTopology ↥X) Osharp).property E V (Fin n)
  /-- The dual coordinates are dual to the sections. -/
  eval_e (i j : Fin n) : Stacks.SheafOfModules.dualEval (b.lam i) (b.e j) =
    if j = i then 1 else 0

/-- Reindexing a finite dual basis along an equivalence of index types. -/
noncomputable def finiteDualBasisReindex {V : Opens ↥X} {I I' : Type*} [Fintype I] [Fintype I']
    (b : Stacks.SheafOfModules.FiniteDualBasis Osharp.obj
      (toRingCat (Opens.grothendieckTopology ↥X) Osharp).property E V I) (σ : I ≃ I') :
    Stacks.SheafOfModules.FiniteDualBasis Osharp.obj
      (toRingCat (Opens.grothendieckTopology ↥X) Osharp).property E V I' where
  e k := b.e (σ.symm k)
  lam k := b.lam (σ.symm k)
  span W g := (Fintype.sum_equiv σ.symm _ _ fun _ => rfl).trans (b.span W g)

/-- For a retract `E|_V` of a free module with `r ≫ i = 𝟙`, the dual coordinates of
`FiniteDualBasis.ofRetract` evaluate on its sections as the Kronecker delta. -/
theorem dualEval_retract {V : Opens ↥X} {I : Type u} [Fintype I] [DecidableEq I]
    (h : Retract (E.over V) (_root_.SheafOfModules.free
      (R := (toRingCat (Opens.grothendieckTopology ↥X) Osharp).over V) I))
    (hri : h.r ≫ h.i = 𝟙 _) (i j : I) :
    Stacks.SheafOfModules.dualEval
        ((Stacks.SheafOfModules.FiniteDualBasis.ofRetract Osharp.obj
          (toRingCat (Opens.grothendieckTopology ↥X) Osharp).property h).lam i)
        ((Stacks.SheafOfModules.FiniteDualBasis.ofRetract Osharp.obj
          (toRingCat (Opens.grothendieckTopology ↥X) Osharp).property h).e j) =
      if j = i then 1 else 0 := by
  have key : (_root_.SheafOfModules.ιFree j ≫ h.r ≫ h.i ≫
      Stacks.SheafOfModules.freeProj i).val.app (op (Over.mk (𝟙 V)))
        (Stacks.SheafOfModules.unitOne (op (Over.mk (𝟙 V)))) =
      (if j = i then (1 : (toRingCat (Opens.grothendieckTopology ↥X) Osharp).obj.obj (op V))
        else 0) := by
    rw [← Category.assoc h.r, hri, Category.id_comp,
      Stacks.SheafOfModules.ιFree_comp_freeProj]
    split_ifs <;> rfl
  exact key

/-- **A finite locally free sheaf of modules of rank `n` has local frames around every
point.** -/
theorem exists_localFrame (n : ℕ)
    [hE : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E n] (x : ↥X) :
    ∃ (V : Opens ↥X) (_ : x ∈ V), Nonempty (LocalFrame E n V) := by
  classical
  obtain ⟨q, hq, hr⟩ := hE.exists_isFiniteLocallyFreeOfRankData
  have hxcover : x ∈ ⨆ i, q.X i := by
    rw [(Opens.coversTop_iff X q.X).mp q.coversTop]
    trivial
  obtain ⟨i, hi⟩ := Opens.mem_iSup.1 hxcover
  have hiso : IsIso (q.generators i).π := hq.isIso i
  let σ : (q.generators i).I ≃ Fin n := (hr i).some
  let : Fintype (q.generators i).I := Fintype.ofEquiv (Fin n) σ.symm
  let h : Retract (E.over (q.X i)) (_root_.SheafOfModules.free
      (R := (toRingCat (Opens.grothendieckTopology ↥X) Osharp).over (q.X i))
      (q.generators i).I) :=
    ⟨inv (q.generators i).π, (q.generators i).π, IsIso.inv_hom_id _⟩
  let b := Stacks.SheafOfModules.FiniteDualBasis.ofRetract Osharp.obj
    (toRingCat (Opens.grothendieckTopology ↥X) Osharp).property h
  refine ⟨q.X i, hi, ⟨⟨finiteDualBasisReindex b σ, fun k l => ?_⟩⟩⟩
  have := dualEval_retract h (IsIso.hom_inv_id _) (σ.symm k) (σ.symm l)
  refine this.trans ?_
  simp only [σ.symm.injective.eq_iff]

/-- **Germs of a locally generating family span the stalk.** If every section of `M` over an
open `W ⊆ V` is a combination of the restrictions of a family of sections over `V`, the germs
of that family span the stalk at any point of `V`. -/
theorem span_germ_of_forall_eq_sum
    (M : PresheafOfModules.{u} (Osharp.obj ⋙ forget₂ CommRingCat RingCat)) {V : Opens ↥X}
    {I : Type*} [Fintype I] (s : I → M.obj (op V))
    (hs : ∀ (W : Opens ↥X) (hle : W ≤ V) (g : M.obj (op W)),
      ∃ c : I → (Osharp.obj ⋙ forget₂ CommRingCat RingCat).obj (op W),
        ∑ i, c i • M.map (homOfLE hle).op (s i) = g)
    (x : ↥X) (hx : x ∈ V) :
    Submodule.span ↑(TopCat.Presheaf.stalk Osharp.obj x)
      (Set.range fun i => TopCat.Presheaf.germ M.presheaf V x hx (s i)) = ⊤ := by
  refine eq_top_iff.2 fun z _ => ?_
  obtain ⟨W, hle, hxW, g, rfl⟩ := TopCat.Presheaf.exists_le_germ_eq M.presheaf z hx
  obtain ⟨c, rfl⟩ := hs W hle g
  refine (congrArg (· ∈ _)
    (map_sum (ConcreteCategory.hom (TopCat.Presheaf.germ M.presheaf W x hxW))
      (fun i => (c i • M.map (homOfLE hle).op (s i) : M.obj (op W))) Finset.univ)).mpr ?_
  refine Submodule.sum_mem _ fun i _ => ?_
  erw [PresheafOfModules.germ_smul, TopCat.Presheaf.germ_res_apply]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

/-- **The germs of a local frame span the stalk.** -/
theorem LocalFrame.span_germ_e {n : ℕ} {V : Opens ↥X} (F : LocalFrame E n V) (x : ↥X)
    (hx : x ∈ V) :
    Submodule.span ↑(TopCat.Presheaf.stalk Osharp.obj x)
      (Set.range fun i => TopCat.Presheaf.germ E.val.presheaf V x hx (F.b.e i)) = ⊤ :=
  span_germ_of_forall_eq_sum E.val F.b.e
    (fun _ hle g => ⟨_, F.b.span (op (Over.mk (homOfLE hle))) g⟩) x hx

/-- **The germs of the dual coordinates of a local frame span the stalk of the dual.** -/
theorem LocalFrame.span_germ_lam {n : ℕ} {V : Opens ↥X} (F : LocalFrame E n V) (x : ↥X)
    (hx : x ∈ V) :
    Submodule.span ↑(TopCat.Presheaf.stalk Osharp.obj x)
      (Set.range fun i => TopCat.Presheaf.germ (dualMod E).val.presheaf V x hx (F.b.lam i)) =
        ⊤ :=
  span_germ_of_forall_eq_sum (dualMod E).val F.b.lam
    (fun _ hle g => ⟨_, Stacks.SheafOfModules.FiniteDualBasis.eq_sum_smul_lam Osharp.obj
      (toRingCat (Opens.grothendieckTopology ↥X) Osharp).property
      (Stacks.SheafOfModules.FiniteDualBasis.restrict Osharp.obj
        (toRingCat (Opens.grothendieckTopology ↥X) Osharp).property F.b (homOfLE hle)) g⟩) x hx

end Frame

/-! ### The determinant pairing is perfect for a finite locally free sheaf -/

section Perfect

variable {X : TopCat.{u}} {Osharp : Sheaf (Opens.grothendieckTopology ↥X) CommRingCat.{u}}

/-- **The germ of the wedge of a family whose germs span generates the stalk of the exterior
power.** -/
theorem span_germ_wedgeSec_eq_top
    {M : _root_.SheafOfModules.{u} (toRingCat (Opens.grothendieckTopology ↥X) Osharp)}
    (A : _root_.SheafOfModules.TensorExteriorSymmetricAlgebras (Opens.grothendieckTopology ↥X) M)
    {n : ℕ} {V : Opens ↥X} (s : Fin n → M.val.obj (op V)) (x : ↥X) (hx : x ∈ V)
    (hs : Submodule.span ↑(TopCat.Presheaf.stalk Osharp.obj x)
      (Set.range fun i => TopCat.Presheaf.germ M.val.presheaf V x hx (s i)) = ⊤) :
    Submodule.span ↑(TopCat.Presheaf.stalk Osharp.obj x)
      {TopCat.Presheaf.germ (A.exteriorPower n).val.presheaf V x hx
        (Stacks.SheafOfModules.TopWedge.wedgeSec A (op V) n s)} = ⊤ := by
  have h1 := ExteriorAlgebra.span_singleton_ιMulti_eq_top
    (fun i => TopCat.Presheaf.germ M.val.presheaf V x hx (s i)) hs
  have h2 := _root_.SheafOfModules.exteriorPowerStalkEquiv_symm_ιMulti_germ A n x V hx s
  have h3 := ExteriorAlgebra.span_singleton_linearEquiv_symm_eq_top
    (A.exteriorPowerStalkEquiv n x) _ h1
  exact Eq.trans (congrArg (fun z => Submodule.span ↑(TopCat.Presheaf.stalk Osharp.obj x) {z})
    h2.symm) h3

/-- The unit section of the structure sheaf over an open, as a section of the unit sheaf of
modules. -/
noncomputable abbrev unitOneAt (V : Opens ↥X) :
    (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.obj
      (op V) :=
  Stacks.SheafOfModules.unitOne (op V)

/-- The germ of a section `c` of the unit sheaf of modules is the germ of `c` in the
structure sheaf acting on the germ of `1`. -/
theorem germ_unit_eq_smul (V : Opens ↥X) (x : ↥X) (hx : x ∈ V)
    (c : (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.obj
      (op V)) :
    TopCat.Presheaf.germ
        (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf
        V x hx c =
      TopCat.Presheaf.germ Osharp.obj V x hx c • TopCat.Presheaf.germ
        (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf
        V x hx (unitOneAt V) := by
  refine Eq.trans ?_ (PresheafOfModules.germ_smul
    (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val x V hx
    c (unitOneAt V))
  exact congrArg (TopCat.Presheaf.germ
    (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf
    V x hx) (mul_one (M := (Osharp.obj ⋙ forget₂ CommRingCat RingCat).obj (op V)) c).symm

/-- The germ of `1` at a point does not depend on the open neighbourhood. -/
theorem germ_unitOneAt_res {V W : Opens ↥X} (hle : W ≤ V) (x : ↥X) (hx : x ∈ W) :
    TopCat.Presheaf.germ
        (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf
        W x hx (unitOneAt W) =
      TopCat.Presheaf.germ
        (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf
        V x (hle hx) (unitOneAt V) := by
  refine Eq.trans ?_ (TopCat.Presheaf.germ_res_apply
    (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf
    (homOfLE hle) x hx (unitOneAt V))
  exact congrArg _ (map_one ((Osharp.obj ⋙ forget₂ CommRingCat RingCat).map
    (homOfLE hle).op).hom).symm

/-- The germ of `1` generates the stalk of the structure sheaf viewed as a module. -/
theorem span_germ_unitOneAt (V : Opens ↥X) (x : ↥X) (hx : x ∈ V) :
    Submodule.span ↑(TopCat.Presheaf.stalk Osharp.obj x)
      {TopCat.Presheaf.germ
        (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf
        V x hx (unitOneAt V)} = ⊤ := by
  refine eq_top_iff.2 fun z _ => ?_
  obtain ⟨W, hle, hxW, c, rfl⟩ := TopCat.Presheaf.exists_le_germ_eq _ z hx
  rw [germ_unit_eq_smul W x hxW c, germ_unitOneAt_res hle x hxW]
  exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

/-- The germ of `1` in the stalk of the structure sheaf viewed as a module is torsion-free. -/
theorem eq_zero_of_smul_germ_unitOneAt (V : Opens ↥X) (x : ↥X) (hx : x ∈ V)
    (a : ↑(TopCat.Presheaf.stalk Osharp.obj x))
    (ha : a • TopCat.Presheaf.germ
        (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf
        V x hx (unitOneAt V) = 0) : a = 0 := by
  obtain ⟨W, hle, hxW, c, rfl⟩ := TopCat.Presheaf.exists_le_germ_eq Osharp.obj a hx
  rw [← germ_unitOneAt_res hle x hxW, ← germ_unit_eq_smul W x hxW c] at ha
  have ha' := ha.trans (map_zero (ConcreteCategory.hom (TopCat.Presheaf.germ
      (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf
      W x hxW))).symm
  obtain ⟨W', hxW', i, i', h⟩ := TopCat.Presheaf.germ_eq
    (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf
    x hxW hxW c 0 ha'
  have h0 : Osharp.obj.map i.op c = 0 := h.trans (map_zero _)
  rw [← TopCat.Presheaf.germ_res_apply Osharp.obj i x hxW', h0, map_zero]

variable {E : _root_.SheafOfModules.{u} (toRingCat (Opens.grothendieckTopology ↥X) Osharp)}
  (BD : _root_.SheafOfModules.TensorExteriorSymmetricAlgebras (Opens.grothendieckTopology ↥X)
    (dualMod E))
  (BE : _root_.SheafOfModules.TensorExteriorSymmetricAlgebras (Opens.grothendieckTopology ↥X) E)

/-- On a local frame the determinant of the matrix of values is one. -/
theorem LocalFrame.det_eq_one {n : ℕ} {V : Opens ↥X} (F : LocalFrame E n V) :
    Matrix.det (Matrix.of fun i j => dualEvalLinear E (op V) (F.b.lam j) (F.b.e i)) = 1 := by
  have h : (Matrix.of fun i j => dualEvalLinear E (op V) (F.b.lam j) (F.b.e i)) = 1 := by
    ext i j
    exact (F.eval_e j i).trans Matrix.one_apply.symm
  rw [h, Matrix.det_one]

/-- The determinant pairing sends the tensor of the germs of the two frame wedges to the germ
of `1`. -/
private theorem stalkMapL_detDualPairing_germ_wedge {n : ℕ} {V : Opens ↥X} (F : LocalFrame E n V)
    (x : ↥X) (hx : x ∈ V) :
    PresheafOfModules.stalkMapL x (detDualPairing BD BE n).val
        ((PresheafOfModules.tensorSheafStalkEquiv Osharp (BD.exteriorPower n)
          (BE.exteriorPower n) x).symm
          (TopCat.Presheaf.germ (BD.exteriorPower n).val.presheaf V x hx
              (Stacks.SheafOfModules.TopWedge.wedgeSec BD (op V) n F.b.lam) ⊗ₜ
            TopCat.Presheaf.germ (BE.exteriorPower n).val.presheaf V x hx
              (Stacks.SheafOfModules.TopWedge.wedgeSec BE (op V) n F.b.e))) =
      TopCat.Presheaf.germ
        (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf
        V x hx (unitOneAt V) := by
  have hsymm := (LinearEquiv.symm_apply_eq _).2
    (PresheafOfModules.tensorSheafStalkEquiv_tensorSheafGerm Osharp (BD.exteriorPower n)
      (BE.exteriorPower n) x V hx (Stacks.SheafOfModules.TopWedge.wedgeSec BD (op V) n F.b.lam)
      (Stacks.SheafOfModules.TopWedge.wedgeSec BE (op V) n F.b.e)).symm
  rw [hsymm]
  refine (PresheafOfModules.stalkMapL_germ x (detDualPairing BD BE n).val V hx _).trans ?_
  refine congrArg (TopCat.Presheaf.germ
    (_root_.SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf
    V x hx) ?_
  exact (detDualPairing_wedge BD BE n (op V) F.b.lam F.b.e).trans F.det_eq_one

/-- **The determinant pairing is bijective on stalks** when `E` is finite locally free of
rank `n`. -/
theorem bijective_stalkMapL_detDualPairing (n : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E n] (x : ↥X) :
    Function.Bijective (PresheafOfModules.stalkMapL x (detDualPairing BD BE n).val) := by
  obtain ⟨V, hx, ⟨F⟩⟩ := exists_localFrame (E := E) n x
  have hD := span_germ_wedgeSec_eq_top BD F.b.lam x hx (F.span_germ_lam x hx)
  have hL := span_germ_wedgeSec_eq_top BE F.b.e x hx (F.span_germ_e x hx)
  have hDL := Stacks.Duality.span_singleton_tmul_eq_top _ _ hD hL
  have hτ := ExteriorAlgebra.span_singleton_linearEquiv_symm_eq_top
    (PresheafOfModules.tensorSheafStalkEquiv Osharp (BD.exteriorPower n) (BE.exteriorPower n) x)
    _ hDL
  change Function.Bijective (PresheafOfModules.stalkMapL
    (P := PresheafOfModules.tensorSheafVal Osharp (BD.exteriorPower n) (BE.exteriorPower n)) x
    (detDualPairing BD BE n).val)
  refine ExteriorAlgebra.bijective_of_span_singleton _ _ _ hτ (span_germ_unitOneAt V x hx)
    (eq_zero_of_smul_germ_unitOneAt V x hx) ?_
  exact stalkMapL_detDualPairing_germ_wedge BD BE F x hx

/-- **The determinant pairing is an isomorphism** when `E` is finite locally free of rank `n`:
`⋀ⁿ(E^∨) ⊗ ⋀ⁿ E ≅ O_X`. -/
theorem isIso_detDualPairing (n : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E n] :
    IsIso (detDualPairing BD BE n) :=
  (AlgebraicGeometry.SheafOfModules.isIso_iff_bijective_stalkMap (detDualPairing BD BE n)).2
    fun x => bijective_stalkMapL_detDualPairing BD BE n x

include BE in
/-- **The stalk of the top exterior power of the dual is free of rank one.** -/
theorem nonempty_stalk_exteriorPower_dual_linearEquiv (n : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E n] (x : ↥X) :
    Nonempty (↑(TopCat.Presheaf.stalk (BD.exteriorPower n).val.presheaf x) ≃ₗ[
      ↑(TopCat.Presheaf.stalk Osharp.obj x)] ↑(TopCat.Presheaf.stalk Osharp.obj x)) := by
  obtain ⟨V, hx, ⟨F⟩⟩ := exists_localFrame (E := E) n x
  have hD := span_germ_wedgeSec_eq_top BD F.b.lam x hx (F.span_germ_lam x hx)
  -- the stalk of the structure sheaf viewed as a module is the stalk ring
  have hP := ExteriorAlgebra.bijective_of_span_singleton
    (LinearMap.toSpanSingleton ↑(TopCat.Presheaf.stalk Osharp.obj x) _
      (TopCat.Presheaf.germ (_root_.SheafOfModules.unit
        (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf V x hx (unitOneAt V)))
    1 _ (Submodule.span_singleton_eq_top_iff _ _ |>.2 fun a => ⟨a, by simp⟩)
    (span_germ_unitOneAt V x hx) (eq_zero_of_smul_germ_unitOneAt V x hx) (one_smul _ _)
  let eP := LinearEquiv.ofBijective _ hP
  let l0 := TopCat.Presheaf.germ (BE.exteriorPower n).val.presheaf V x hx
    (Stacks.SheafOfModules.TopWedge.wedgeSec BE (op V) n F.b.e)
  let φ : ↑(TopCat.Presheaf.stalk (BD.exteriorPower n).val.presheaf x) →ₗ[
      ↑(TopCat.Presheaf.stalk Osharp.obj x)] ↑(TopCat.Presheaf.stalk (_root_.SheafOfModules.unit
        (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).val.presheaf x) :=
    PresheafOfModules.stalkMapL x (detDualPairing BD BE n).val ∘ₗ
      (PresheafOfModules.tensorSheafStalkEquiv Osharp (BD.exteriorPower n) (BE.exteriorPower n)
        x).symm.toLinearMap ∘ₗ (TensorProduct.mk _ _ _).flip l0
  have hφ := ExteriorAlgebra.bijective_of_span_singleton φ _ _ hD (span_germ_unitOneAt V x hx)
    (eq_zero_of_smul_germ_unitOneAt V x hx) ?_
  · exact ⟨(LinearEquiv.ofBijective φ hφ).trans eP.symm⟩
  exact stalkMapL_detDualPairing_germ_wedge BD BE F x hx

end Perfect

