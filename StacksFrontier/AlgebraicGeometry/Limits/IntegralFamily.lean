/-!
# Families of points parametrised by an integral algebra over a field

Let `k` be a field and let `A` be an integral `k`-algebra, so that `A` is the union of its
finite `k`-subalgebras. A morphism `Spec A ⟶ X` into a scheme that is locally of finite
presentation over `ℤ` has finite image: it factors through `Spec` of one finite `k`-subalgebra,
whose spectrum is a finite set because a finite algebra over a field is Artinian. For an ample
invertible sheaf on such a scheme, the image of `Spec A` therefore lies in an affine
nonvanishing open of a section of some positive tensor power.

## Main definitions

* `Algebra.adjoinFinsetDiagram`: the filtered diagram `Finset A ⥤ CommRingCat` of the
  subalgebras `k[T]` generated by the finite subsets `T ⊆ A`.
* `Algebra.adjoinFinsetCocone`: its tautological cocone with vertex `A`.

## Main results

* `Algebra.isColimitAdjoinFinsetCocone`: an algebra is the filtered colimit of the subalgebras
  generated by its finite subsets.
* `AlgebraicGeometry.Scheme.finite_range_of_integral_of_locallyOfFinitePresentation`: the image
  of a morphism `Spec A ⟶ X` is finite when `A` is an integral algebra over a field and `X` is
  locally of finite presentation over `ℤ`.
* `AlgebraicGeometry.Scheme.Modules.exists_affine_nonvanishingOpen_containing_range`: for an
  ample invertible sheaf `L` on a scheme `X` locally of finite presentation over `ℤ`, an open
  `W ⊆ X` and a morphism `Spec A ⟶ W`, some positive tensor power of `L` has a global section
  `s` with `X_s` affine, `X_s ⊆ W`, and `X_s` containing the image of `Spec A`.

## Implementation notes

The statement of [Stacks, Tag 0E21] has no finite-presentation hypothesis on `X`; the source
removes it by Noetherian approximation ([Stacks, Tag 07RN]).

The nonvanishing open `X_s` needs `Stacks.SheafOfModules.IsInvertible` for the tensor power,
while the hypothesis on `L` is `AlgebraicGeometry.SheafOfModules.IsInvertible`; the instance
`AlgebraicGeometry.Scheme.Modules.isInvertible_tensorPower` supplies the former from the latter.

## References

* [Stacks Project, Tag 0E21](https://stacks.math.columbia.edu/tag/0E21)
* [Stacks Project, Tag 09NV](https://stacks.math.columbia.edu/tag/09NV)
* [Stacks Project, Tag 01ZC](https://stacks.math.columbia.edu/tag/01ZC)
* [Stacks Project, Tag 01ZA](https://stacks.math.columbia.edu/tag/01ZA)
* [Stacks Project, Tag 07RN](https://stacks.math.columbia.edu/tag/07RN)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

universe v u

namespace Algebra

/-- The diagram of the subalgebras generated by the finite subsets of an algebra, indexed by
the finite subsets ordered by inclusion. -/
def adjoinFinsetDiagram (k : Type v) (A : Type u) [CommRing k] [CommRing A] [Algebra k A] :
    Finset A ⥤ CommRingCat.{u} where
  obj i := CommRingCat.of (Algebra.adjoin k (i : Set A))
  map {i j} h := CommRingCat.ofHom
    (Subalgebra.inclusion (Algebra.adjoin_mono (show (i : Set A) ⊆ j from
      fun x hx => leOfHom h hx))).toRingHom
  map_id i := by ext x; simp [Subalgebra.inclusion]
  map_comp f g := by ext x; simp [Subalgebra.inclusion]

/-- The tautological cocone on `Algebra.adjoinFinsetDiagram` with vertex the algebra itself. -/
def adjoinFinsetCocone (k : Type v) (A : Type u) [CommRing k] [CommRing A] [Algebra k A] :
    Cocone (adjoinFinsetDiagram k A) where
  pt := CommRingCat.of A
  ι :=
    { app i := CommRingCat.ofHom (Algebra.adjoin k (i : Set A)).val.toRingHom
      naturality := by intro i j h; ext x; rfl }

/-- An algebra is the filtered colimit of the subalgebras generated by its finite subsets. -/
noncomputable def isColimitAdjoinFinsetCocone (k : Type v) (A : Type u)
    [CommRing k] [CommRing A] [Algebra k A] : IsColimit (adjoinFinsetCocone k A) := by
  let F := adjoinFinsetDiagram k A
  let c := adjoinFinsetCocone k A
  letI := reflectsColimit_of_reflectsIsomorphisms F (forget CommRingCat)
  apply isColimitOfReflects (forget CommRingCat)
  refine Types.FilteredColimit.isColimitOf' (F := F ⋙ forget CommRingCat)
    ((forget CommRingCat).mapCocone c) (fun x => ?_) (fun i x y h => ?_)
  · exact ⟨{x}, ⟨x, Algebra.subset_adjoin (Finset.mem_coe.2 (Finset.mem_singleton_self _))⟩, rfl⟩
  · exact ⟨i, 𝟙 i, Subtype.ext h⟩

end Algebra

namespace AlgebraicGeometry

/-- A family of points of a scheme parametrised by the spectrum of an integral algebra over a
field has finite image, provided the scheme is locally of finite presentation over `ℤ`. -/
theorem Scheme.finite_range_of_integral_of_locallyOfFinitePresentation
    (k : Type v) (A : Type u) [Field k] [CommRing A] [Algebra k A] [Algebra.IsIntegral k A]
    (X : Scheme.{u}) [LocallyOfFinitePresentation (terminal.from X)]
    (a : Spec (CommRingCat.of A) ⟶ X) : (Set.range a.base).Finite := by
  classical
  let F : Finset A ⥤ CommRingCat.{u} := Algebra.adjoinFinsetDiagram k A
  let S : (Finset A)ᵒᵖ ⥤ Scheme.{u} := F.op ⋙ Scheme.Spec
  let c : Cone S := Scheme.Spec.mapCone (Algebra.adjoinFinsetCocone k A).op
  have hc : IsLimit c :=
    isLimitOfPreserves Scheme.Spec (Algebra.isColimitAdjoinFinsetCocone k A).op
  let t : S ⟶ (Functor.const ((Finset A)ᵒᵖ)).obj (⊤_ Scheme.{u}) :=
    { app := fun i => terminal.from (S.obj i)
      naturality _ _ _ := terminal.hom_ext _ _ }
  have : ∀ i : (Finset A)ᵒᵖ, Finite (S.obj i) := fun i => by
    change Finite (PrimeSpectrum (Algebra.adjoin k ((i.unop : Finset A) : Set A)))
    exact Stacks.IntegralFamilyFiniteRange.finite_spec_adjoin_finset k A i.unop
  have : ∀ {i j : (Finset A)ᵒᵖ} (f : i ⟶ j), IsAffineHom (S.map f) := by
    intro i j f
    dsimp [S, F, Algebra.adjoinFinsetDiagram]
    infer_instance
  have ha : c.π ≫ t = (Functor.const ((Finset A)ᵒᵖ)).map (a ≫ terminal.from X) := by
    ext i
    exact terminal.hom_ext _ _
  obtain ⟨j, q, hfactor, -⟩ :=
    Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation S t (terminal.from X) c hc a ha
  refine (Set.finite_range q.base).subset ?_
  rintro y ⟨z, rfl⟩
  refine ⟨(c.π.app j).base z, ?_⟩
  change q.base.hom ((c.π.app j).base.hom z) = a.base.hom z
  exact congrArg (fun h : Spec (CommRingCat.of A) ⟶ X => h.base.hom z) hfactor

namespace Scheme.Modules

open Stacks.SheafOfModules Stacks.SheafOfModules.Invertible

/-- Let `L` be an ample invertible sheaf on a scheme `X` locally of finite presentation over
`ℤ`, let `W ⊆ X` be open and let `Spec A ⟶ W` be a family of points of `W` parametrised by an
integral algebra over a field. Then some positive tensor power of `L` has a global section `s`
with `X_s` affine, `X_s ⊆ W`, and `X_s` containing the image of `Spec A`. -/
theorem exists_affine_nonvanishingOpen_containing_range
    (k : Type v) (A : Type u) [Field k] [CommRing A] [Algebra k A] [Algebra.IsIntegral k A]
    (X : Scheme.{u}) [LocallyOfFinitePresentation (terminal.from X)] (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.toRingedSpace.presheaf
      (structureSheafRing X.toRingedSpace).property L]
    (hL : IsAmple X L)
    (W : X.Opens) (f : Spec (CommRingCat.of A) ⟶ (W : Scheme.{u})) :
    ∃ n : ℕ, 0 < n ∧
      ∃ s : (tensorPower X.toRingedSpace.presheaf
        (structureSheafRing X.toRingedSpace).property L (n : ℤ)).sections,
        IsAffineOpen (nonvanishingOpen (X := X.toLocallyRingedSpace.toRingedSpace)
          (tensorPower X.toRingedSpace.presheaf
            (structureSheafRing X.toRingedSpace).property L (n : ℤ)) s) ∧
        nonvanishingOpen (X := X.toLocallyRingedSpace.toRingedSpace)
          (tensorPower X.toRingedSpace.presheaf
            (structureSheafRing X.toRingedSpace).property L (n : ℤ)) s ≤ W ∧
        Set.range (f ≫ W.ι) ⊆
          (nonvanishingOpen (X := X.toLocallyRingedSpace.toRingedSpace)
            (tensorPower X.toRingedSpace.presheaf
              (structureSheafRing X.toRingedSpace).property L (n : ℤ)) s : Set X) := by
  have hfin : (Set.range (f ≫ W.ι).base).Finite :=
    Scheme.finite_range_of_integral_of_locallyOfFinitePresentation k A X (f ≫ W.ι)
  have hsub : Set.range (f ≫ W.ι).base ⊆ (W : Set X) := by
    rintro x ⟨y, rfl⟩
    exact (f.base y).property
  obtain ⟨n, hn, s, haff, hEs, hsW⟩ :=
    exists_sections_finite_subset_nonvanishingOpen_le_of_isAmple L hL hfin W hsub
  exact ⟨n, hn, s, haff, hsW, hEs⟩

end Scheme.Modules

end AlgebraicGeometry

end
