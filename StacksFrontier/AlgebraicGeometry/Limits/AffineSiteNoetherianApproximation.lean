module

public import StacksFrontier.AlgebraicGeometry.AffineStageDescent.Basic
public import StacksFrontier.AlgebraicGeometry.Quot.CurveFamilies
public import StacksFrontier.AlgebraicGeometry.Spaces.PrimeResidueFieldSite

/-!
# Noetherian approximation of an affine object of the big fppf site of `Spec(ℤ)`

Let `T` be an object of the big fppf site of `Spec(ℤ)` whose underlying scheme is affine, with
ring of global sections `R`. Then `T` is the limit of the spectra `Spec ℤ[i]` of the subalgebras
of `R` generated by its finite subsets (`AlgebraicGeometry.affineStageCone`, the affine case of
Stacks 01ZA). This file reads that presentation inside the big affine fppf site: every stage is
contained in the site (it has fewer elements than `R`), so the system is a cofiltered diagram of
the big affine fppf category of `Spec(ℤ)` with a cone of vertex `T` that becomes limiting in
schemes, as in the definition of limit preservation of a category fibred in groupoids (Artin's
Axioms, Definition 07XL). Every stage is affine, Noetherian and of finite type over `ℤ`.

## Main definitions

* `AlgebraicGeometry.affineSiteStageDiagram`: the diagram of the stages in the big affine fppf
  category of `Spec(ℤ)`.
* `AlgebraicGeometry.affineSiteStageCone`: its cone with vertex `T`.
* `AlgebraicGeometry.isLimit_affineSiteStageCone`: the cone is limiting in schemes.

## References

* [Stacks Project, Tag 01ZA](https://stacks.math.columbia.edu/tag/01ZA)
* [Stacks Project, Tag 07XL](https://stacks.math.columbia.edu/tag/07XL)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry

variable (B : BigFppfSite.{u}) (hZ : B.Contains integerBase)

/-- The unique morphism from a scheme of the site to `Spec(ℤ)`. -/
noncomputable def toIntegerBaseSite (X : B.Schemes) : X ⟶ B.obj hZ :=
  B.inclusion.preimage (specULiftZIsTerminal.from (B.inclusion.obj X))

/-- Any two morphisms from a scheme of the site to `Spec(ℤ)` agree. -/
theorem toIntegerBaseSite_ext {X : B.Schemes} (f g : X ⟶ B.obj hZ) : f = g :=
  B.inclusion.map_injective (specULiftZIsTerminal.hom_ext _ _)

variable (T : BigFppfOver B integerBase hZ)
  [IsAffine ((BigFppfOver.toScheme B integerBase hZ).obj T)]

/-- **The stages are contained in the site.** A subalgebra of the ring of global sections of a
contained affine scheme has fewer elements than the cutoff. -/
theorem contains_spec_adjoinFinset
    (i : Finset Γ((BigFppfOver.toScheme B integerBase hZ).obj T, ⊤)) :
    B.Contains (Spec (CommRingCat.of (Algebra.adjoin ℤ
      (i : Set Γ((BigFppfOver.toScheme B integerBase hZ).obj T, ⊤))))) := by
  set X := (BigFppfOver.toScheme B integerBase hZ).obj T
  have hX : X.size < B.cutoff := T.left.2
  have hR : Cardinal.mk Γ(X, ⊤) < B.cutoff := by
    have h := Scheme.size_congr X.isoSpec
    rw [Scheme.size_Spec] at h
    exact lt_of_le_of_lt (le_max_right _ _) (h ▸ hX)
  exact BigFppfSite.contains_spec_of_mk_lt_cutoff B
    (lt_of_le_of_lt (Cardinal.mk_le_of_injective Subtype.val_injective) hR)

/-- The stages `Spec ℤ[i]`, as schemes of the site. -/
noncomputable abbrev affineSiteStageSchemes :
    (Finset Γ((BigFppfOver.toScheme B integerBase hZ).obj T, ⊤))ᵒᵖ ⥤ B.Schemes :=
  (schemeSizeBelow B.cutoff).lift
    (specAdjoinFinsetDiagram Γ((BigFppfOver.toScheme B integerBase hZ).obj T, ⊤))
    (fun i => contains_spec_adjoinFinset B hZ T i.unop)

/-- **The stages of the Noetherian approximation of `T`, in the big affine fppf category of
`Spec(ℤ)`.** -/
noncomputable def affineSiteStageDiagram :
    (Finset Γ((BigFppfOver.toScheme B integerBase hZ).obj T, ⊤))ᵒᵖ ⥤
      BigAffineFppf B integerBase hZ :=
  (IsAffineOver B integerBase hZ).lift
    ((affineSiteStageSchemes B hZ T).toOver (B.obj hZ)
      (fun _ => toIntegerBaseSite B hZ _) (fun _ => toIntegerBaseSite_ext B hZ _ _))
    (fun i => isAffine_specAdjoinFinsetDiagram_obj _ i)

/-- The underlying scheme of a stage is `Spec ℤ[i]`. -/
theorem affineSiteStageDiagram_toScheme_obj
    (i : (Finset Γ((BigFppfOver.toScheme B integerBase hZ).obj T, ⊤))ᵒᵖ) :
    (BigAffineFppf.toScheme B integerBase hZ).obj ((affineSiteStageDiagram B hZ T).obj i) =
      (specAdjoinFinsetDiagram Γ((BigFppfOver.toScheme B integerBase hZ).obj T, ⊤)).obj i :=
  rfl

/-- `T` as an object of the big affine fppf category. -/
abbrev affineSiteObj : BigAffineFppf B integerBase hZ :=
  ⟨T, (inferInstance : IsAffine ((BigFppfOver.toScheme B integerBase hZ).obj T))⟩

/-- **The cone with vertex `T` over the stages.** Its legs are those of
`AlgebraicGeometry.affineStageCone`. -/
noncomputable def affineSiteStageCone : Cone (affineSiteStageDiagram B hZ T) where
  pt := affineSiteObj B hZ T
  π :=
    { app i := ObjectProperty.homMk (Over.homMk
        (ObjectProperty.homMk
          ((affineStageCone ((BigFppfOver.toScheme B integerBase hZ).obj T)).π.app i))
        (toIntegerBaseSite_ext B hZ _ _))
      naturality {i j} f := by
        apply ObjectProperty.hom_ext
        apply Over.OverMorphism.ext
        apply ObjectProperty.hom_ext
        change 𝟙 _ ≫ (affineStageCone ((BigFppfOver.toScheme B integerBase hZ).obj T)).π.app j =
          (affineStageCone ((BigFppfOver.toScheme B integerBase hZ).obj T)).π.app i ≫
            (specAdjoinFinsetDiagram Γ((BigFppfOver.toScheme B integerBase hZ).obj T, ⊤)).map f
        rw [Category.id_comp]
        exact ((affineStageCone ((BigFppfOver.toScheme B integerBase hZ).obj T)).w f).symm }

/-- **`T` is the limit of its Noetherian approximation, read in schemes.** -/
noncomputable def isLimit_affineSiteStageCone :
    IsLimit ((BigAffineFppf.toScheme B integerBase hZ).mapCone (affineSiteStageCone B hZ T)) :=
  isLimit_affineStageCone ((BigFppfOver.toScheme B integerBase hZ).obj T)

/-- Every stage is a Noetherian scheme. -/
instance isNoetherian_affineSiteStageDiagram_obj
    (i : (Finset Γ((BigFppfOver.toScheme B integerBase hZ).obj T, ⊤))ᵒᵖ) :
    IsNoetherian ((BigAffineFppf.toScheme B integerBase hZ).obj
      ((affineSiteStageDiagram B hZ T).obj i)) :=
  isNoetherian_specAdjoinFinsetDiagram_obj _ i

end AlgebraicGeometry

end
