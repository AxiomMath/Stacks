module

public import StacksFrontier.AlgebraicGeometry.Limits.AffineSiteNoetherianApproximation

/-!
# Noetherian approximation of an affine object over an affine Noetherian object

Let `Λ → R` be a ring map. Then `R` is the filtered colimit of its `Λ`-subalgebras `Λ[i]`
generated by the finite subsets `i ⊆ R`, so `Spec R` is the limit of the spectra `Spec Λ[i]`,
and every stage lies over `Spec Λ`. When `Λ` is Noetherian every `Λ[i]` is a finitely generated
`Λ`-algebra, hence Noetherian (the affine case of Stacks 01ZA, relative to a Noetherian base).

This file reads that presentation inside the big fppf site of a scheme `S`. For a morphism
`m : T ⟶ W` between affine objects of the site, the stages `Spec Γ(W)[i]` of `Γ(T)` are contained
in the site, so they form a cofiltered diagram of affine objects of the site whose cone with
vertex `T` is limiting in schemes, and every leg of the cone followed by the structure morphism
of its stage to `W` is `m`. This is the shape in which limit preservation of a category fibred
in groupoids over the site is stated.

## Main definitions

* `AlgebraicGeometry.specAdjoinFinsetDiagramOver`: the spectra of the `Λ`-subalgebras of `R`
  generated by finite subsets, and `AlgebraicGeometry.specAdjoinFinsetConeOver` its cone with
  vertex `Spec R`.
* `AlgebraicGeometry.relativeAffineSiteStageDiagram`: for `m : T ⟶ W` between affine objects of
  the big fppf site of `S`, the stages of `Γ(T)` over `Γ(W)` as affine objects of the site, and
  `AlgebraicGeometry.relativeAffineSiteStageCone` the cone with vertex `T`.
* `AlgebraicGeometry.relativeAffineSiteStageToTarget`: the morphism from a stage to `W`.

## Main results

* `AlgebraicGeometry.isLimit_specAdjoinFinsetConeOver`: `Spec R` is the limit of the stages.
* `AlgebraicGeometry.isLimit_relativeAffineSiteStageCone`: `T` is the limit of the stages of the
  site, read in schemes.
* `AlgebraicGeometry.relativeAffineSiteStageCone_π_comp_toTarget`: the legs of the cone followed
  by the morphisms to `W` are `m`.
* `AlgebraicGeometry.isNoetherian_relativeAffineSiteStageDiagram_obj`: the stages are Noetherian
  when `W` is.

## References

* [Stacks Project, Tag 01ZA](https://stacks.math.columbia.edu/tag/01ZA)
* [Stacks Project, Tag 07XL](https://stacks.math.columbia.edu/tag/07XL)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry

/-! ### The stages of an algebra over a base ring -/

section Algebra

variable (Λ R : Type u) [CommRing Λ] [CommRing R] [Algebra Λ R]

/-- A `Λ`-subalgebra generated by a finite subset is of finite type over `Λ`. -/
theorem finiteType_adjoinFinset (i : Finset R) :
    Algebra.FiniteType Λ (Algebra.adjoin Λ (i : Set R)) :=
  (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset i)

/-- Over a Noetherian ring, a subalgebra generated by a finite subset is Noetherian. -/
theorem isNoetherianRing_adjoinFinset [IsNoetherianRing Λ] (i : Finset R) :
    IsNoetherianRing (Algebra.adjoin Λ (i : Set R)) :=
  have := finiteType_adjoinFinset Λ R i
  Algebra.FiniteType.isNoetherianRing Λ _

/-- **The inverse system of the spectra of the `Λ`-subalgebras of `R` generated by its finite
subsets.** -/
def specAdjoinFinsetDiagramOver : (Finset R)ᵒᵖ ⥤ Scheme.{u} :=
  (Algebra.adjoinFinsetDiagram Λ R).op ⋙ Scheme.Spec

/-- The stage at `i` is the spectrum of the `Λ`-subalgebra of `R` generated by `i`. -/
lemma specAdjoinFinsetDiagramOver_obj (i : (Finset R)ᵒᵖ) :
    (specAdjoinFinsetDiagramOver Λ R).obj i =
      Spec (CommRingCat.of (Algebra.adjoin Λ ((i.unop : Finset R) : Set R))) := rfl

/-- Every stage is an affine scheme. -/
instance isAffine_specAdjoinFinsetDiagramOver_obj (i : (Finset R)ᵒᵖ) :
    IsAffine ((specAdjoinFinsetDiagramOver Λ R).obj i) := by
  rw [specAdjoinFinsetDiagramOver_obj]
  infer_instance

/-- Over a Noetherian ring every stage is a Noetherian scheme. -/
instance isNoetherian_specAdjoinFinsetDiagramOver_obj [IsNoetherianRing Λ]
    (i : (Finset R)ᵒᵖ) : IsNoetherian ((specAdjoinFinsetDiagramOver Λ R).obj i) := by
  have := isNoetherianRing_adjoinFinset Λ R i.unop
  rw [specAdjoinFinsetDiagramOver_obj]
  infer_instance

/-- The cone with vertex `Spec R` over the stages: the image under `Spec` of the cocone
exhibiting `R` as the filtered colimit of its finitely generated `Λ`-subalgebras. -/
def specAdjoinFinsetConeOver : Cone (specAdjoinFinsetDiagramOver Λ R) :=
  Scheme.Spec.mapCone (Algebra.adjoinFinsetCocone Λ R).op

/-- **`Spec R` is the limit of the spectra of its finitely generated `Λ`-subalgebras.** -/
def isLimit_specAdjoinFinsetConeOver : IsLimit (specAdjoinFinsetConeOver Λ R) :=
  isLimitOfPreserves Scheme.Spec (Algebra.isColimitAdjoinFinsetCocone Λ R).op

/-- The structure morphism of a stage to `Spec Λ`. -/
def specAdjoinFinsetDiagramOverToBase (i : (Finset R)ᵒᵖ) :
    (specAdjoinFinsetDiagramOver Λ R).obj i ⟶ Spec (CommRingCat.of Λ) :=
  Spec.map (CommRingCat.ofHom (algebraMap Λ (Algebra.adjoin Λ ((i.unop : Finset R) : Set R))))

/-- The transition morphisms of the stages lie over `Spec Λ`. -/
theorem specAdjoinFinsetDiagramOver_map_toBase {i j : (Finset R)ᵒᵖ} (f : i ⟶ j) :
    (specAdjoinFinsetDiagramOver Λ R).map f ≫ specAdjoinFinsetDiagramOverToBase Λ R j =
      specAdjoinFinsetDiagramOverToBase Λ R i :=
  (Spec.map_comp _ _).symm.trans (congrArg Spec.map (by ext; rfl))

/-- The legs of the cone followed by the structure morphisms of the stages are the morphism
`Spec R ⟶ Spec Λ`. -/
theorem specAdjoinFinsetConeOver_π_toBase (i : (Finset R)ᵒᵖ) :
    (specAdjoinFinsetConeOver Λ R).π.app i ≫ specAdjoinFinsetDiagramOverToBase Λ R i =
      Spec.map (CommRingCat.ofHom (algebraMap Λ R)) :=
  (Spec.map_comp _ _).symm.trans (congrArg Spec.map (by ext; rfl))

end Algebra

/-! ### The stages inside the big fppf site -/

section Site

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {T W : BigFppfOver B S hS} [IsAffine ((BigFppfOver.toScheme B S hS).obj T)]
  [IsAffine ((BigFppfOver.toScheme B S hS).obj W)] (m : T ⟶ W)

/-- The `Γ(W)`-algebra structure on `Γ(T)` given by `m`. -/
abbrev relativeAffineSiteAlgebra :
    Algebra Γ((BigFppfOver.toScheme B S hS).obj W, ⊤) Γ((BigFppfOver.toScheme B S hS).obj T, ⊤) :=
  ((BigFppfOver.toScheme B S hS).map m).appTop.hom.toAlgebra

omit [IsAffine ((BigFppfOver.toScheme B S hS).obj W)] in
/-- The stages of `Γ(T)` over `Γ(W)` are contained in the site: a subalgebra of the ring of global
sections of a contained affine scheme has fewer elements than the cutoff. -/
theorem contains_spec_relativeAdjoinFinset
    (i : Finset Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)) :
    letI := relativeAffineSiteAlgebra B S hS m
    B.Contains (Spec (CommRingCat.of (Algebra.adjoin Γ((BigFppfOver.toScheme B S hS).obj W, ⊤)
      (i : Set Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))))) := by
  let := relativeAffineSiteAlgebra B S hS m
  set X := (BigFppfOver.toScheme B S hS).obj T
  have hX : X.size < B.cutoff := T.left.2
  have hR : Cardinal.mk Γ(X, ⊤) < B.cutoff := by
    have h := Scheme.size_congr X.isoSpec
    rw [Scheme.size_Spec] at h
    exact lt_of_le_of_lt (le_max_right _ _) (h ▸ hX)
  exact BigFppfSite.contains_spec_of_mk_lt_cutoff B
    (lt_of_le_of_lt (Cardinal.mk_le_of_injective Subtype.val_injective) hR)

/-- The stages, as schemes of the site. -/
abbrev relativeAffineSiteStageSchemes :
    (Finset Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))ᵒᵖ ⥤ B.Schemes :=
  letI := relativeAffineSiteAlgebra B S hS m
  (schemeSizeBelow B.cutoff).lift
    (specAdjoinFinsetDiagramOver Γ((BigFppfOver.toScheme B S hS).obj W, ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))
    (fun i => contains_spec_relativeAdjoinFinset B S hS m i.unop)

/-- The morphism of schemes from a stage to `W`. -/
def relativeAffineSiteStageToTargetScheme
    (i : (Finset Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))ᵒᵖ) :
    (relativeAffineSiteStageSchemes B S hS m).obj i ⟶ W.left :=
  letI := relativeAffineSiteAlgebra B S hS m
  ObjectProperty.homMk (specAdjoinFinsetDiagramOverToBase
    Γ((BigFppfOver.toScheme B S hS).obj W, ⊤) Γ((BigFppfOver.toScheme B S hS).obj T, ⊤) i ≫
      ((BigFppfOver.toScheme B S hS).obj W).isoSpec.inv)

/-- The transition morphisms of the stages commute with the morphisms to `W`. -/
theorem relativeAffineSiteStageSchemes_map_toTarget
    {i j : (Finset Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))ᵒᵖ} (f : i ⟶ j) :
    (relativeAffineSiteStageSchemes B S hS m).map f ≫
        relativeAffineSiteStageToTargetScheme B S hS m j =
      relativeAffineSiteStageToTargetScheme B S hS m i := by
  let := relativeAffineSiteAlgebra B S hS m
  apply ObjectProperty.hom_ext
  show (specAdjoinFinsetDiagramOver _ _).map f ≫ (specAdjoinFinsetDiagramOverToBase _ _ j ≫ _) =
    specAdjoinFinsetDiagramOverToBase _ _ i ≫ _
  rw [← Category.assoc, specAdjoinFinsetDiagramOver_map_toBase]

/-- **The stages of `Γ(T)` over `Γ(W)`, in the big affine fppf category of `S`.** Each lies over
`S` through its morphism to `W`. -/
def relativeAffineSiteStageDiagram :
    (Finset Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))ᵒᵖ ⥤ BigAffineFppf B S hS :=
  letI := relativeAffineSiteAlgebra B S hS m
  (IsAffineOver B S hS).lift
    ((relativeAffineSiteStageSchemes B S hS m).toOver (B.obj hS)
      (fun i => relativeAffineSiteStageToTargetScheme B S hS m i ≫ W.hom)
      (fun f => by rw [← Category.assoc, relativeAffineSiteStageSchemes_map_toTarget]))
    (fun i => isAffine_specAdjoinFinsetDiagramOver_obj _ _ i)

/-- The underlying scheme of a stage is `Spec Γ(W)[i]`. -/
theorem relativeAffineSiteStageDiagram_toScheme_obj
    (i : (Finset Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))ᵒᵖ) :
    letI := relativeAffineSiteAlgebra B S hS m
    (BigAffineFppf.toScheme B S hS).obj ((relativeAffineSiteStageDiagram B S hS m).obj i) =
      (specAdjoinFinsetDiagramOver Γ((BigFppfOver.toScheme B S hS).obj W, ⊤)
        Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)).obj i :=
  rfl

/-- The morphism from a stage to `W`, in the big fppf site of `S`. -/
def relativeAffineSiteStageToTarget (i : (Finset Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))ᵒᵖ) :
    (BigAffineFppf.inclusion B S hS).obj ((relativeAffineSiteStageDiagram B S hS m).obj i) ⟶ W :=
  Over.homMk (relativeAffineSiteStageToTargetScheme B S hS m i) rfl

/-- The cone of schemes with vertex `T` over the stages: the cone of
`AlgebraicGeometry.specAdjoinFinsetConeOver` at `Γ(T)`, extended along the identification of `T`
with the spectrum of its global sections. -/
def relativeAffineSiteSchemeCone :
    letI := relativeAffineSiteAlgebra B S hS m
    Cone (specAdjoinFinsetDiagramOver Γ((BigFppfOver.toScheme B S hS).obj W, ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj T, ⊤)) :=
  letI := relativeAffineSiteAlgebra B S hS m
  (specAdjoinFinsetConeOver _ _).extend ((BigFppfOver.toScheme B S hS).obj T).isoSpec.hom

/-- The legs `T ⟶ Spec Γ(W)[i]` composed with the structure morphisms to `W` are `m`, as morphisms
of schemes. -/
theorem relativeAffineSiteSchemeCone_π_toTarget
    (i : (Finset Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))ᵒᵖ) :
    letI := relativeAffineSiteAlgebra B S hS m
    (relativeAffineSiteSchemeCone B S hS m).π.app i ≫
      specAdjoinFinsetDiagramOverToBase Γ((BigFppfOver.toScheme B S hS).obj W, ⊤)
        Γ((BigFppfOver.toScheme B S hS).obj T, ⊤) i ≫
      ((BigFppfOver.toScheme B S hS).obj W).isoSpec.inv =
      (BigFppfOver.toScheme B S hS).map m :=
  let := relativeAffineSiteAlgebra B S hS m
  have e₁ : (relativeAffineSiteSchemeCone B S hS m).π.app i ≫
      specAdjoinFinsetDiagramOverToBase Γ((BigFppfOver.toScheme B S hS).obj W, ⊤)
        Γ((BigFppfOver.toScheme B S hS).obj T, ⊤) i =
      ((BigFppfOver.toScheme B S hS).obj T).isoSpec.hom ≫
        Spec.map ((BigFppfOver.toScheme B S hS).map m).appTop :=
    (Category.assoc _ _ _).trans (congrArg (((BigFppfOver.toScheme B S hS).obj T).isoSpec.hom ≫ ·)
      (specAdjoinFinsetConeOver_π_toBase _ _ i))
  ((Category.assoc _ _ _).symm.trans
    (congrArg (· ≫ ((BigFppfOver.toScheme B S hS).obj W).isoSpec.inv)
      (e₁.trans (Scheme.isoSpec_hom_naturality _)))).trans
      ((Category.assoc _ _ _).trans ((congrArg ((BigFppfOver.toScheme B S hS).map m ≫ ·)
        (Iso.hom_inv_id _)).trans (Category.comp_id _)))

/-- **The cone with vertex `T` over the stages of `Γ(T)` over `Γ(W)`.** -/
def relativeAffineSiteStageCone : Cone (relativeAffineSiteStageDiagram B S hS m) where
  pt := ⟨T, inferInstance⟩
  π :=
    { app i := ObjectProperty.homMk (Over.homMk
        (ObjectProperty.homMk ((relativeAffineSiteSchemeCone B S hS m).π.app i))
        (by
          change ObjectProperty.homMk _ ≫ (relativeAffineSiteStageToTargetScheme B S hS m i ≫
            W.hom) = T.hom
          rw [← Category.assoc, ← Over.w m]
          exact congrArg (· ≫ _) <|
            ObjectProperty.hom_ext _ (relativeAffineSiteSchemeCone_π_toTarget B S hS m i)))
      naturality {i j} f := ObjectProperty.hom_ext _ <| Over.OverMorphism.ext <|
        ObjectProperty.hom_ext _ <|
          (Category.id_comp _).trans ((relativeAffineSiteSchemeCone B S hS m).w f).symm }

/-- **`T` is the limit of its stages over `W`, read in schemes.** -/
def isLimit_relativeAffineSiteStageCone :
    IsLimit ((BigAffineFppf.toScheme B S hS).mapCone (relativeAffineSiteStageCone B S hS m)) :=
  letI := relativeAffineSiteAlgebra B S hS m
  IsLimit.ofIsoLimit (isLimit_specAdjoinFinsetConeOver _ _)
    (Cone.extendIso (specAdjoinFinsetConeOver _ _)
      ((BigFppfOver.toScheme B S hS).obj T).isoSpec.symm :
        _ ≅ relativeAffineSiteSchemeCone B S hS m)

/-- **The legs of the cone followed by the morphisms of the stages to `W` are `m`.** -/
theorem relativeAffineSiteStageCone_π_comp_toTarget
    (i : (Finset Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))ᵒᵖ) :
    (BigAffineFppf.inclusion B S hS).map ((relativeAffineSiteStageCone B S hS m).π.app i) ≫
      relativeAffineSiteStageToTarget B S hS m i = m :=
  Over.OverMorphism.ext <| ObjectProperty.hom_ext _ <|
    relativeAffineSiteSchemeCone_π_toTarget B S hS m i

/-- **The stages are Noetherian when `W` is.** -/
theorem isNoetherian_relativeAffineSiteStageDiagram_obj
    [IsNoetherian ((BigFppfOver.toScheme B S hS).obj W)]
    (i : (Finset Γ((BigFppfOver.toScheme B S hS).obj T, ⊤))ᵒᵖ) :
    IsNoetherian ((BigAffineFppf.toScheme B S hS).obj
      ((relativeAffineSiteStageDiagram B S hS m).obj i)) := by
  let := relativeAffineSiteAlgebra B S hS m
  have : IsNoetherianRing Γ((BigFppfOver.toScheme B S hS).obj W, ⊤) :=
    IsLocallyNoetherian.component_noetherian ⟨⊤, isAffineOpen_top _⟩
  exact isNoetherian_specAdjoinFinsetDiagramOver_obj _ _ i

end Site

end AlgebraicGeometry

end
