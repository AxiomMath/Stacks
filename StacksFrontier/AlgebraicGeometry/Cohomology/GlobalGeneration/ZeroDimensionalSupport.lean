/-!
# Global generation of a coherent sheaf with zero-dimensional support

A coherent sheaf on a locally Noetherian scheme whose support has dimension at most zero is
generated by global sections.

## Main results

* `AlgebraicGeometry.nonempty_generatingSections_of_support_dim_le_zero` gives global generators
  for a coherent sheaf with zero-dimensional support.

## Implementation notes

The support is the stalkwise support `SheafOfModules.supp`, viewed as a topological subspace,
and global generation is represented by the existence of a
`SheafOfModules.GeneratingSections` structure.

A Noetherian space of topological Krull dimension at most zero is discrete, so the support meets
a small enough affine neighbourhood of each of its points in that point alone. Gluing a local
section over such a neighbourhood with the zero section on the complement of the point therefore
produces a global section with any prescribed germ, because the two agree on the overlap: there
the stalks vanish, so the sections over the overlap form a subsingleton. Taking one global
section for every germ at every point gives a family whose germs span every stalk, which is
global generation.

## References

* [Stacks Project, Tag 0B3J](https://stacks.math.columbia.edu/tag/0B3J)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace TopologicalSpace.IrreducibleCloseds
open scoped AlgebraicGeometry

universe u

namespace AlgebraicGeometry

/-- A Noetherian `T0` space of topological Krull dimension at most zero is discrete: it is
covered by finitely many closed irreducible subsets, each of which is a single point, so the
space is finite and its points are closed. -/
theorem discrete_of_noetherian_topologicalKrullDim_le_zero
    {Y : Type u} [TopologicalSpace Y] [T0Space Y] [NoetherianSpace Y]
    (hY : topologicalKrullDim Y ≤ 0) : DiscreteTopology Y := by
  classical
  obtain ⟨T, hTfin, hTclosed, hTirr, hTcover⟩ :=
    NoetherianSpace.exists_finite_set_isClosed_irreducible isClosed_univ (α := Y)
  have hsub (s : T) : Subsingleton s.1 := by
    obtain ⟨x, hx⟩ := (hTirr s.1 s.2).nonempty
    refine ⟨fun y z ↦ ?_⟩
    have hle : (⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩ :
      IrreducibleCloseds Y) ≤ ⟨s.1, hTirr s.1 s.2, hTclosed s.1 s.2⟩ := by
      change closure {x} ⊆ s.1
      exact closure_minimal (Set.singleton_subset_iff.mpr hx) (hTclosed s.1 s.2)
    have hdim' : Order.krullDim (IrreducibleCloseds Y) ≤ 0 := hY
    have hmax := (Order.krullDim_nonpos_iff_forall_isMax.mp hdim')
      (⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩ :
        IrreducibleCloseds Y)
    have heq : closure {x} = s.1 := by
      have hle' : (⟨s.1, hTirr s.1 s.2, hTclosed s.1 s.2⟩ :
          IrreducibleCloseds Y) ≤ ⟨closure {x}, isIrreducible_singleton.closure,
            isClosed_closure⟩ := hmax hle
      exact Set.Subset.antisymm hle hle'
    have hx_eq (w : s.1) : x = w :=
      Stacks.Topology.Dimension.eq_of_specializes_of_topologicalKrullDim_le_zero hY
        (specializes_iff_mem_closure.mpr (by rw [heq]; exact w.2))
    exact Subtype.ext ((hx_eq y).symm.trans (hx_eq z))
  have : Finite T := hTfin.to_subtype
  let T' : Type u := Σ s : T, s.1
  have (s : T) : Subsingleton s.1 := hsub s
  have (s : T) : Finite s.1 := inferInstance
  have : Finite T' := inferInstance
  have hsurj : Function.Surjective (fun p : T' ↦ (p.2 : Y)) := by
    intro y
    have hy : y ∈ ⋃₀ T := by simp [← hTcover]
    obtain ⟨s, hs, hys⟩ := Set.mem_sUnion.mp hy
    exact ⟨⟨⟨s, hs⟩, ⟨y, hys⟩⟩, rfl⟩
  let : Finite Y := Finite.of_surjective (fun p : T' ↦ (p.2 : Y)) hsurj
  exact DiscreteTopology.of_finite_of_isClosed_singleton fun x ↦
    Stacks.Topology.Dimension.isClosed_singleton_of_topologicalKrullDim_le_zero hY x

private def subtypeInterHomeomorph {Y : Type u} [TopologicalSpace Y]
    (S U : Set Y) : {x : S // (x : Y) ∈ U} ≃ₜ {x : U // (x : Y) ∈ S} where
  toEquiv := {
    toFun := fun x ↦ ⟨⟨x.1.1, x.2⟩, x.1.2⟩
    invFun := fun x ↦ ⟨⟨x.1.1, x.2⟩, x.1.2⟩
    left_inv := by intro x; cases x; rfl
    right_inv := by intro x; cases x; rfl }
  continuous_toFun := by fun_prop
  continuous_invFun := by fun_prop

/-- If the support of a coherent sheaf on a locally Noetherian scheme has dimension at most
zero, then every point `x` of the support has an open neighbourhood meeting the support in `x`
alone. -/
theorem exists_open_neighborhood_meets_support_singleton
    {X : Scheme.{u}} [IsLocallyNoetherian X] (F : X.Modules) [F.IsCoherent]
    (hF : topologicalKrullDim (SheafOfModules.supp F) ≤ 0)
    (x : ↥(SheafOfModules.supp F)) :
    ∃ U : X.Opens, (x.1 : X) ∈ U ∧
      ∀ y : X, y ∈ U → y ∈ SheafOfModules.supp F → y = x.1 := by
  classical
  let S := SheafOfModules.supp F
  let : F.IsFiniteType := SheafOfModules.IsCoherent.isFiniteType
  have hSclosed : IsClosed S := SheafOfModules.isClosed_supp F
  obtain ⟨U, hUaff, hxU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (X := X) (x := x.1) (U := ⊤) (by simp)
  let V : Type u := {y : S // (y.1 : X) ∈ U}
  let W : Type u := {y : U // (y.1 : X) ∈ S}
  let e := subtypeInterHomeomorph S (U : Set X)
  have hWclosed : IsClosed {y : U | (y.1 : X) ∈ S} :=
    hSclosed.preimage continuous_subtype_val
  let : IsNoetherianRing Γ(X, U) :=
    IsLocallyNoetherian.component_noetherian ⟨U, hUaff⟩
  let : NoetherianSpace U := noetherianSpace_of_isAffineOpen U hUaff
  let : NoetherianSpace W :=
    Topology.IsInducing.noetherianSpace (α := U)
      hWclosed.isClosedEmbedding_subtypeVal.isInducing
  let : NoetherianSpace V := (noetherianSpace_iff_of_homeomorph e).2 inferInstance
  have hVdim : topologicalKrullDim V ≤ 0 :=
    (Topology.IsInducing.subtypeVal.topologicalKrullDim_le).trans hF
  let : DiscreteTopology V := discrete_of_noetherian_topologicalKrullDim_le_zero hVdim
  let v : V := ⟨x, hxU⟩
  have hVopen : IsOpen {y : S | (y.1 : X) ∈ U} := U.2.preimage continuous_subtype_val
  have hsingle : IsOpen ({v} : Set V) := isOpen_discrete _
  have hsingleS : IsOpen ({x} : Set S) := by
    have himage : IsOpen ((fun y : V ↦ (y.1 : S)) '' ({v} : Set V)) :=
      hVopen.isOpenEmbedding_subtypeVal.isOpenMap _ hsingle
    simpa [v] using himage
  obtain ⟨O, hOopen, hOpre⟩ := (isOpen_induced_iff.mp hsingleS)
  refine ⟨⟨O, hOopen⟩, ?_, ?_⟩
  · change (x : S) ∈ (fun y : S ↦ (y.1 : X)) ⁻¹' O
    rw [hOpre]
    exact Set.mem_singleton _
  · intro y hy hyS
    have hy' : (⟨y, hyS⟩ : S) ∈ (fun z : S ↦ (z.1 : X)) ⁻¹' O := hy
    have heq : (⟨y, hyS⟩ : S) = x := by simpa [hOpre] using hy'
    exact congrArg Subtype.val heq

/-- A stalk of a sheaf of modules at a point outside its support is zero. -/
private theorem stalk_eq_zero_of_notMem_supp
    {X : Scheme.{u}} {F : X.Modules} {x : X} (hx : x ∉ SheafOfModules.supp F)
    (a : F.presheaf.stalk x) : a = 0 := by
  by_contra hne
  exact hx ⟨a, hne⟩

/-- A sheaf of modules has only the zero section over an open set disjoint from its support. -/
lemma subsingleton_sections_of_avoiding_support
    {X : Scheme.{u}} (F : X.Modules) (U : X.Opens)
    (hU : ∀ x : X, x ∈ U → x ∉ SheafOfModules.supp F) :
    Subsingleton (F.presheaf.obj (op U)) := by
  let Fsh : TopCat.Sheaf AddCommGrpCat X := ⟨F.presheaf, F.isSheaf⟩
  refine ⟨fun s t ↦ ?_⟩
  apply TopCat.Presheaf.section_ext Fsh U s t
  intro x hx
  exact ((stalk_eq_zero_of_notMem_supp (hU x hx) _).trans
    (stalk_eq_zero_of_notMem_supp (hU x hx) _).symm)

/-- The element of `F.sections` determined by a section of `F` over the whole scheme: its value
on an open set is the restriction of that section. -/
public noncomputable def sectionOfGlobalValue
    {X : Scheme.{u}} (F : X.Modules) (s : Γ(F, ⊤)) : F.sections :=
  F.val.sectionsMk
    (fun U ↦ F.presheaf.map (homOfLE (show U.unop ≤ ⊤ from le_top)).op s)
    (by
      intro U V f
      change F.presheaf.map f
          (F.presheaf.map (homOfLE (show U.unop ≤ ⊤ from le_top)).op s) =
        F.presheaf.map (homOfLE (show V.unop ≤ ⊤ from le_top)).op s
      have hcomp : (homOfLE (show U.unop ≤ ⊤ from le_top)).op ≫ f =
          (homOfLE (show V.unop ≤ ⊤ from le_top)).op := Subsingleton.elim _ _
      simp only [← ConcreteCategory.comp_apply, ← F.presheaf.map_comp, hcomp])

/-- The value of `sectionOfGlobalValue F s` on the whole scheme is `s`. -/
public lemma sectionOfGlobalValue_eval_top
    {X : Scheme.{u}} (F : X.Modules) (s : Γ(F, ⊤)) :
    (sectionOfGlobalValue F s).eval (Opposite.op ⊤) = s := by
  change F.presheaf.map (homOfLE (show ⊤ ≤ ⊤ from le_rfl)).op s = s
  simp

private lemma exists_global_section_with_stalk_value
    {X : Scheme.{u}} [IsLocallyNoetherian X] (F : X.Modules) [F.IsCoherent]
    (hF : topologicalKrullDim (SheafOfModules.supp F) ≤ 0)
    (x : X) (a : F.presheaf.stalk x) :
    ∃ s : F.sections,
      ConcreteCategory.hom (F.presheaf.Γgerm x) (s.eval (Opposite.op ⊤)) = a := by
  classical
  by_cases hx : x ∈ SheafOfModules.supp F
  · obtain ⟨N, hxN, hN⟩ := exists_open_neighborhood_meets_support_singleton F hF ⟨x, hx⟩
    obtain ⟨W, hWN, hxW, sW, hsW⟩ := F.presheaf.exists_le_germ_eq a hxN
    let S := SheafOfModules.supp F
    let : F.IsFiniteType := SheafOfModules.IsCoherent.isFiniteType
    have hSclosed : IsClosed S := SheafOfModules.isClosed_supp F
    have hpointClosedS : IsClosed ({⟨x, hx⟩} : Set S) :=
      Stacks.Topology.Dimension.isClosed_singleton_of_topologicalKrullDim_le_zero hF ⟨x, hx⟩
    have hpointClosedX : IsClosed ({x} : Set X) := by
      simpa using hSclosed.isClosedEmbedding_subtypeVal.isClosedMap _ hpointClosedS
    let C : X.Opens := ⟨({x}ᶜ : Set X),
      hpointClosedX.isOpen_compl⟩
    let 𝒰 : Bool → X.Opens := fun b ↦ if b then W else C
    let s𝒰 : ∀ b : Bool, F.presheaf.obj (op (𝒰 b)) := fun
      | true => sW
      | false => 0
    have havoid (y : X) (hyC : y ∈ C) (hyW : y ∈ W) : y ∉ SheafOfModules.supp F :=
      fun hyS ↦ hyC (hN y (hWN hyW) hyS)
    have hcompat : TopCat.Presheaf.IsCompatible F.presheaf 𝒰 s𝒰 := by
      intro i j
      cases i <;> cases j
      · rfl
      · dsimp [𝒰, s𝒰]
        have : Subsingleton (F.presheaf.obj (op (C ⊓ W))) :=
          subsingleton_sections_of_avoiding_support F (C ⊓ W) fun y hy ↦ havoid y hy.1 hy.2
        exact Subsingleton.elim _ _
      · dsimp [𝒰, s𝒰]
        have : Subsingleton (F.presheaf.obj (op (W ⊓ C))) :=
          subsingleton_sections_of_avoiding_support F (W ⊓ C) fun y hy ↦ havoid y hy.2 hy.1
        exact Subsingleton.elim _ _
      · rfl
    have hcover : iSup 𝒰 = ⊤ := by
      ext y
      by_cases hy : y = x
      · subst y
        simp [𝒰, C, hxW]
      · simp [𝒰, C, hy]
    let Fsh : TopCat.Sheaf AddCommGrpCat X := ⟨F.presheaf, F.isSheaf⟩
    obtain ⟨sTop, hsTop, -⟩ := Fsh.existsUnique_gluing' 𝒰 ⊤
      (fun b ↦ homOfLE (le_top)) (by rw [hcover]) s𝒰 hcompat
    refine ⟨sectionOfGlobalValue F sTop, ?_⟩
    have hres := hsTop true
    have hres' : F.presheaf.map (homOfLE (show W ≤ ⊤ from le_top)).op sTop = sW := by
      simpa [𝒰, s𝒰] using hres
    have hstalk : ConcreteCategory.hom (F.presheaf.Γgerm x) sTop = a := calc
      _ = ConcreteCategory.hom (F.presheaf.germ W x hxW)
          (F.presheaf.map (homOfLE (show W ≤ ⊤ from le_top)).op sTop) := by
            simp [TopCat.Presheaf.Γgerm,
              F.presheaf.germ_res_apply (homOfLE (show W ≤ ⊤ from le_top)) x hxW sTop]
      _ = a := by rwa [hres']
    simpa only [sectionOfGlobalValue_eval_top] using hstalk
  · have ha : a = 0 := stalk_eq_zero_of_notMem_supp hx a
    refine ⟨sectionOfGlobalValue F 0, ?_⟩
    have hzero : ConcreteCategory.hom (F.presheaf.Γgerm x) (0 : Γ(F, ⊤)) = a := by
      simp [ha]
    simpa only [sectionOfGlobalValue_eval_top] using hzero

/-- A coherent sheaf with support of dimension at most zero on a locally Noetherian
scheme is generated by global sections.

This is also clause (1) of Stacks 0AYT, in a form more general than that clause states it: Stacks
0AYT takes `X` proper over a field `k`, which gives `IsLocallyNoetherian X` through
`LocallyOfFiniteType.isLocallyNoetherian`, so the condition here is strictly weaker than the
clause's and the clause follows by instantiation. -/
@[stacks 0B3J "global_generation",
  stacks 0AYT "(1), ℱ is generated by global sections.  Stated for a locally Noetherian X, which
is weaker than the clause's `X proper over a field k` (properness gives IsLocallyNoetherian via
LocallyOfFiniteType.isLocallyNoetherian), so the clause follows by instantiation"]
public theorem nonempty_generatingSections_of_support_dim_le_zero
    {X : Scheme.{u}} [IsLocallyNoetherian X] (F : X.Modules) [F.IsCoherent]
    (hF : topologicalKrullDim (SheafOfModules.supp F) ≤ 0) :
    Nonempty F.GeneratingSections := by
  classical
  let I : Type u := Σ x : X, F.presheaf.stalk x
  let s : I → F.sections := fun i ↦
    Classical.choose (exists_global_section_with_stalk_value F hF i.1 i.2)
  have hs (i : I) :
      ConcreteCategory.hom (F.presheaf.Γgerm i.1) ((s i).eval (Opposite.op ⊤)) = i.2 :=
    Classical.choose_spec (exists_global_section_with_stalk_value F hF i.1 i.2)
  refine ⟨⟨I, s, ?_⟩⟩
  rw [AlgebraicGeometry.generates_iff_stalkwise_generates
    (O_X := X.ringCatSheaf) (F := F) s]
  intro x
  apply Submodule.eq_top_iff'.2
  intro a
  let i : I := ⟨x, a⟩
  have hi :
      ConcreteCategory.hom (TopCat.Presheaf.Γgerm F.val.presheaf x)
        ((s i).eval (Opposite.op ⊤)) = a := by
    change ConcreteCategory.hom (F.presheaf.Γgerm x) ((s i).eval (Opposite.op ⊤)) = a
    simpa [i] using hs i
  have hmem :
      ConcreteCategory.hom (TopCat.Presheaf.Γgerm F.val.presheaf x)
        ((s i).eval (Opposite.op ⊤)) ∈
        Submodule.span (R := (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat))
          (Set.range fun j : I ↦
            ConcreteCategory.hom (TopCat.Presheaf.Γgerm F.val.presheaf x)
              ((s j).eval (Opposite.op ⊤))) :=
    Submodule.subset_span ⟨i, by simp [i]⟩
  rwa [hi] at hmem

end AlgebraicGeometry
