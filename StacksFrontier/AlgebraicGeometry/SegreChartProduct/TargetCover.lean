module

public import StacksFrontier.AlgebraicGeometry.SegreChartProduct.Covers
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.AlgebraicGeometry.Pullbacks

/-!
# The product cover of a fibre product of two projective spaces

`StacksFrontier/AlgebraicGeometry/SegreChartProduct/Prod.lean` computes the inverse image under
the Segre projection of a product `D₊(x_i) × D₊(y_j)` of standard opens of the two factors.  For
that computation to be of use to `CategoryTheory.MorphismProperty.IsLocalAtTarget` those opens
have to cover the target, which is what this file proves.

## Main results

* `Stacks.AlgebraicGeometry.SegreChartProduct.irrelevant_le_span_X`: the variables span the
  irrelevant ideal of a polynomial ring.  This is `MvPolynomial.mem_ideal_span_X_image`: a
  monomial of positive total degree has some exponent nonzero.

* `Stacks.AlgebraicGeometry.SegreChartProduct.iSup_basicOpen_X_eq_top`: hence the standard opens
  `D₊(x_i)` cover `AlgebraicGeometry.Proj` of a polynomial ring graded by total degree.  This is
  the standard affine cover of projective space, which this development did not have: the Segre
  product's own cover is `Stacks.AlgebraicGeometry.SegreCharts.iSup_basicOpen_genSub_eq_top`, but
  the two *factors* were never covered.

* `Stacks.AlgebraicGeometry.SegreChartProduct.iSup_pullbackOpens_eq_top`: the products
  `pullback.fst ⁻¹ᵁ D₊(x_i) ⊓ pullback.snd ⁻¹ᵁ D₊(y_j)` cover any fibre product of the two
  projective spaces.  Both factors are covered and `TopologicalSpace.Opens` is a frame, so the
  pairwise intersections cover.

## References

* [Stacks Project, Tag 01WD](https://stacks.math.columbia.edu/tag/01WD)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MvPolynomial

namespace Stacks.AlgebraicGeometry.SegreChartProduct

universe u v

/-! ### The standard affine cover of projective space -/

section PolyCover

variable (R : Type u) [CommRing R] (ι : Type v)
  [GradedAlgebra (MvPolynomial.homogeneousSubmodule ι R)]

omit [GradedAlgebra (MvPolynomial.homogeneousSubmodule ι R)] in
/-- A polynomial that is homogeneous of positive degree lies in the ideal generated by the
variables: each of its monomials has some exponent nonzero. -/
public theorem mem_span_X_of_isHomogeneous {d : ℕ} (hd : 0 < d) {p : MvPolynomial ι R}
    (hp : p.IsHomogeneous d) :
    p ∈ Ideal.span (Set.range (MvPolynomial.X : ι → MvPolynomial ι R)) := by
  rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
  intro mdeg hmdeg
  have hw : Finsupp.weight 1 mdeg = d := hp (MvPolynomial.mem_support_iff.mp hmdeg)
  have hne : mdeg ≠ 0 := by
    intro h
    rw [h, map_zero] at hw
    exact absurd hw.symm (Nat.pos_iff_ne_zero.mp hd)
  obtain ⟨k, hk⟩ := Finsupp.support_nonempty_iff.mpr hne
  exact ⟨k, Set.mem_univ k, Finsupp.mem_support_iff.mp hk⟩

/-- **The variables span the irrelevant ideal of a polynomial ring.**  This is the hypothesis of
`AlgebraicGeometry.Proj.iSup_basicOpen_eq_top` for the standard cover of projective space. -/
public theorem irrelevant_le_span_X :
    (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule ι R)).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : ι → MvPolynomial ι R)) :=
  (HomogeneousIdeal.toIdeal_irrelevant_le _).mpr fun _ hd _ hp =>
    mem_span_X_of_isHomogeneous R ι hd
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mp hp)

/-- **The standard affine cover of projective space.**  The loci `D₊(x_i)` cover
`AlgebraicGeometry.Proj` of a polynomial ring graded by total degree. -/
public theorem iSup_basicOpen_X_eq_top :
    (⨆ i : ι, AlgebraicGeometry.Proj.basicOpen (MvPolynomial.homogeneousSubmodule ι R)
      (MvPolynomial.X i)) = ⊤ :=
  AlgebraicGeometry.Proj.iSup_basicOpen_eq_top _ _ (irrelevant_le_span_X R ι)

end PolyCover

/-! ### The product cover of a fibre product -/

section ProductCover

variable (R : Type u) [CommRing R] (X Y : Type v)
  [GradedAlgebra (MvPolynomial.homogeneousSubmodule X R)]
  [GradedAlgebra (MvPolynomial.homogeneousSubmodule Y R)]

/-- The preimages of the standard opens `D₊(x_i)` under any morphism into projective space
cover the source. -/
private theorem iSup_preimage_basicOpen_X_eq_top {S : Scheme.{max u v}} {ι : Type v}
    [GradedAlgebra (MvPolynomial.homogeneousSubmodule ι R)]
    (f : S ⟶ AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule ι R)) :
    (⨆ i : ι, f ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule ι R) (MvPolynomial.X i)) = ⊤ := by
  rw [← Scheme.Hom.preimage_iSup, iSup_basicOpen_X_eq_top R ι, Scheme.Hom.preimage_top]

/-- **The products of standard opens cover a fibre product of two projective spaces.** -/
public theorem iSup_pullbackOpens_eq_top {T : Scheme.{max u v}}
    (a : AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule X R) ⟶ T)
    (b : AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule Y R) ⟶ T) :
    (⨆ p : X × Y,
        ((pullback.fst a b ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule X R) (MvPolynomial.X p.1)) ⊓
          (pullback.snd a b ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule Y R) (MvPolynomial.X p.2)))) = ⊤ := by
  rw [← iSup_inf_iSup
      (f := fun i : X => pullback.fst a b ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule X R) (MvPolynomial.X i))
      (g := fun j : Y => pullback.snd a b ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule Y R) (MvPolynomial.X j)),
    iSup_preimage_basicOpen_X_eq_top R (pullback.fst a b),
    iSup_preimage_basicOpen_X_eq_top R (pullback.snd a b), top_inf_eq]

end ProductCover

end Stacks.AlgebraicGeometry.SegreChartProduct

end
