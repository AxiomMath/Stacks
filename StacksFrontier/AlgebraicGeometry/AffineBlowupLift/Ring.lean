module

public import Mathlib.RingTheory.Localization.Away.Basic
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Blowup.Defs

/-!
# The universal property of the affine blowup algebra

Let `R` be a ring, `I ⊆ R` an ideal and `a : R`, and let `R[I/a]` be the affine blowup algebra
`AlgebraicGeometry.affineBlowupAlgebra I a Rₐ`, realized inside a localization `Rₐ` of `R` away
from `a` as the `R`-subalgebra generated by the fractions `y/a` with `y ∈ I`.

This file proves that `R[I/a]` is the *universal* `R`-algebra in which the ideal `I` becomes
principal, generated by the image of `a`, with that image a nonzerodivisor: for every
`R`-algebra `B` such that the image of `a` in `B` is a nonzerodivisor and `I·B = a·B`, there is
exactly one `R`-algebra map `R[I/a] → B`.

This is the ring-level content of the existence half of the universal property of blowing up,
[Stacks, Tag 0806]: the affine chart of the blowup of `Spec R` in `I` attached to a section `a`
is `Spec R[I/a]` (`AlgebraicGeometry.affineBlowupStandardOpenIso`), so a morphism
`Spec B → Spec R[I/a]` over `Spec R` is exactly such an `R`-algebra map.

## Main results

* `Stacks.AlgebraicGeometry.AffineBlowupLift.lift`: the `R`-algebra map `R[I/a] → B`.
* `Stacks.AlgebraicGeometry.AffineBlowupLift.mul_apply_mk'`: every such map is pinned on the
  generators — `a · g (y/a) = y`.
* `Stacks.AlgebraicGeometry.AffineBlowupLift.ext`: uniqueness, from the nonzerodivisor
  hypothesis alone.
* `Stacks.AlgebraicGeometry.AffineBlowupLift.uniqueAlgHom`: existence and uniqueness together,
  as a `Unique` structure on the type of `R`-algebra maps `R[I/a] → B`.

## Implementation notes

The map is not constructed from a presentation of `R[I/a]`. Instead the hypothesis that the
image of `a` is a nonzerodivisor is used twice over, through the localization `Bₐ` of `B` away
from that image:

* `B → Bₐ` is **injective**, because the powers of a nonzerodivisor are nonzerodivisors;
* the image of `a` is a **unit** in `Bₐ`, so the localization `Rₐ` maps to `Bₐ` canonically
  (`IsLocalization.Away.lift`).

Every generator `y/a` of `R[I/a]`, `y ∈ I`, goes to an element of the image of `B` under that
canonical map: the hypothesis `I·B = a·B` writes the image of `y` as `c · a`, and then `y/a`
goes to the image of `c`. The image of `B` is a subring, so the whole of `R[I/a]` lands in it,
and injectivity turns "lands in the image" into a well-defined function to `B`. Each ring-hom
axiom for that function is checked after applying the injection, where it is an axiom for the
canonical map.

The construction therefore needs no finite generation of `I`, no `a ∈ I`, and no Noetherian or
domain hypothesis; `a ∈ I` is not an argument of `affineBlowupAlgebra` either.

Uniqueness needs even less: only that the image of `a` is a nonzerodivisor. Two `R`-algebra
maps agree on the generators because `a · g (y/a) = g (y)` holds for either of them, and `a` can
be cancelled; `Algebra.adjoin_induction` then propagates the agreement.

## References

* [Stacks Project, Tag 0806](https://stacks.math.columbia.edu/tag/0806)
* [Stacks Project, Tag 052Q](https://stacks.math.columbia.edu/tag/052Q)
* [Stacks Project, Tag 07Z3](https://stacks.math.columbia.edu/tag/07Z3)
-/

@[expose] public section

universe u

namespace Stacks.AlgebraicGeometry.AffineBlowupLift

variable {R : Type u} [CommRing R] {I : Ideal R} {a : R}
  {Rₐ : Type*} [CommRing Rₐ] [Algebra R Rₐ] [IsLocalization.Away a Rₐ]
  {B : Type*} [CommRing B] [Algebra R B]

section Target

/-- The localization of the target away from the image of `a`. -/
public abbrev Loc (B : Type*) [CommRing B] [Algebra R B] (a : R) : Type _ :=
  Localization.Away (algebraMap R B a)

/-- The image of `a` in the localization of `B` away from it is a unit, so the canonical
ring map `Rₐ → Bₐ` exists. This needs no hypothesis. -/
public theorem isUnit_toLoc :
    IsUnit (((algebraMap B (Loc B a)).comp (algebraMap R B)) a) :=
  IsLocalization.Away.algebraMap_isUnit (algebraMap R B a)

/-- The canonical ring map from the localization of `R` away from `a` to the localization of `B`
away from the image of `a`. -/
public noncomputable def toLoc : Rₐ →+* Loc B a :=
  IsLocalization.Away.lift (g := (algebraMap B (Loc B a)).comp (algebraMap R B)) a
    isUnit_toLoc

/-- The map `toLoc` is compatible with the structure maps from `R`. -/
public theorem toLoc_algebraMap (r : R) :
    toLoc (Rₐ := Rₐ) (algebraMap R Rₐ r) = algebraMap B (Loc B a) (algebraMap R B r) :=
  IsLocalization.Away.lift_eq _ _ _

/-- The powers of the image of `a` are nonzerodivisors, so `B` injects into its localization
away from that image. -/
public theorem injective_toLoc (hnzd : algebraMap R B a ∈ nonZeroDivisors B) :
    Function.Injective (algebraMap B (Loc B a)) :=
  IsLocalization.injective (M := Submonoid.powers (algebraMap R B a)) _
    (Submonoid.powers_le.mpr hnzd)

end Target

section Existence

variable (hnzd : algebraMap R B a ∈ nonZeroDivisors B)
  (hIB : I.map (algebraMap R B) = Ideal.span {algebraMap R B a})

include hnzd hIB

omit hnzd in
/-- Every element of the affine blowup algebra maps into the image of `B` inside the
localization of `B` away from the image of `a`. Only `I·B = a·B` is used: the nonzerodivisor
hypothesis enters afterwards, to make the preimage unique. -/
public theorem exists_toLoc_eq (z : Rₐ) (hz : z ∈ affineBlowupAlgebra I a Rₐ) :
    ∃ b : B, algebraMap B (Loc B a) b = toLoc z := by
  classical
  induction hz using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨y, hyI, rfl⟩ := hx
      -- `I·B = a·B` writes the image of `y` as a multiple of the image of `a`.
      have hmem : algebraMap R B y ∈ Ideal.span {algebraMap R B a} := by
        rw [← hIB]; exact Ideal.mem_map_of_mem _ hyI
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
      -- Both sides become equal after multiplying by the unit `a`.
      have hu : IsUnit (algebraMap B (Loc B a) (algebraMap R B a)) :=
        IsLocalization.Away.algebraMap_isUnit (algebraMap R B a)
      have hspec : IsLocalization.mk' Rₐ y ⟨a, Submonoid.mem_powers a⟩ *
          algebraMap R Rₐ a = algebraMap R Rₐ y :=
        IsLocalization.mk'_spec_mk Rₐ y a (Submonoid.mem_powers a)
      have h1 : toLoc (Rₐ := Rₐ)
          (IsLocalization.mk' Rₐ y ⟨a, Submonoid.mem_powers a⟩) *
            algebraMap B (Loc B a) (algebraMap R B a) =
          algebraMap B (Loc B a) (algebraMap R B y) := by
        rw [← toLoc_algebraMap (Rₐ := Rₐ) a, ← map_mul, hspec,
          toLoc_algebraMap (Rₐ := Rₐ) y]
      exact ⟨c, hu.mul_right_cancel (by rw [← map_mul, hc, h1])⟩
  | algebraMap r => exact ⟨algebraMap R B r, (toLoc_algebraMap (Rₐ := Rₐ) r).symm⟩
  | add x y _ _ hx hy =>
      obtain ⟨bx, hbx⟩ := hx
      obtain ⟨by', hby⟩ := hy
      exact ⟨bx + by', by rw [map_add, hbx, hby, map_add]⟩
  | mul x y _ _ hx hy =>
      obtain ⟨bx, hbx⟩ := hx
      obtain ⟨by', hby⟩ := hy
      exact ⟨bx * by', by rw [map_mul, hbx, hby, map_mul]⟩

omit hnzd in
/-- The underlying function of the lift: the unique element of `B` whose image in the
localization is the image of `z` under the canonical map. -/
public noncomputable def liftFun (z : affineBlowupAlgebra I a Rₐ) : B :=
  (exists_toLoc_eq hIB z.1 z.2).choose

omit hnzd in
/-- The defining property of `liftFun`: its value maps to the image of `z` in the localization. -/
public theorem liftFun_spec (z : affineBlowupAlgebra I a Rₐ) :
    algebraMap B (Loc B a) (liftFun hIB z) = toLoc z.1 :=
  (exists_toLoc_eq hIB z.1 z.2).choose_spec

/-- **The universal property of the affine blowup algebra `R[I/a]`.** If the image of `a` in an
`R`-algebra `B` is a nonzerodivisor and `I·B` is the principal ideal it generates, then there is
an `R`-algebra map `R[I/a] → B`.

This is the ring-level existence statement behind the existence half of [Stacks, Tag 0806]: the
affine chart of the blowup at `a` is `Spec R[I/a]` over `Spec R`. -/
public noncomputable def lift : affineBlowupAlgebra I a Rₐ →ₐ[R] B where
  toFun := liftFun hIB
  map_one' := injective_toLoc hnzd <| by
    rw [liftFun_spec, map_one]; exact map_one _
  map_mul' x y := injective_toLoc hnzd <| by
    rw [map_mul, liftFun_spec, liftFun_spec, liftFun_spec]
    exact map_mul _ _ _
  map_zero' := injective_toLoc hnzd <| by
    rw [liftFun_spec, map_zero]; exact map_zero _
  map_add' x y := injective_toLoc hnzd <| by
    rw [map_add, liftFun_spec, liftFun_spec, liftFun_spec]
    exact map_add _ _ _
  commutes' r := injective_toLoc hnzd <| by
    rw [liftFun_spec]
    exact toLoc_algebraMap (Rₐ := Rₐ) r

end Existence

section Uniqueness

variable (hnzd : algebraMap R B a ∈ nonZeroDivisors B)

include hnzd

omit hnzd in
/-- On a generator `y/a` of the affine blowup algebra, every `R`-algebra map `g` to `B`
satisfies `a · g (y/a) = y`: the relation `a · (y/a) = y` already holds in `R[I/a]`, so this
needs no hypothesis at all — neither `y ∈ I` nor the nonzerodivisor property of `a`. -/
public theorem mul_apply_mk' (g : affineBlowupAlgebra I a Rₐ →ₐ[R] B) {y : R}
    (hmem : IsLocalization.mk' Rₐ y ⟨a, Submonoid.mem_powers a⟩ ∈ affineBlowupAlgebra I a Rₐ) :
    algebraMap R B a * g ⟨IsLocalization.mk' Rₐ y ⟨a, Submonoid.mem_powers a⟩, hmem⟩ =
      algebraMap R B y := by
  have hspec : (⟨IsLocalization.mk' Rₐ y ⟨a, Submonoid.mem_powers a⟩, hmem⟩ *
      algebraMap R (affineBlowupAlgebra I a Rₐ) a : affineBlowupAlgebra I a Rₐ) =
      algebraMap R (affineBlowupAlgebra I a Rₐ) y := by
    ext
    simp
  have := congrArg g hspec
  rw [map_mul, AlgHom.commutes, AlgHom.commutes] at this
  rw [mul_comm]
  exact this

/-- **Uniqueness in the universal property of `R[I/a]`.** Two `R`-algebra maps from the affine
blowup algebra to an `R`-algebra in which the image of `a` is a nonzerodivisor are equal. Only
the nonzerodivisor hypothesis is used; `I·B = a·B` is not needed. -/
public theorem ext (g₁ g₂ : affineBlowupAlgebra I a Rₐ →ₐ[R] B) : g₁ = g₂ := by
  refine AlgHom.ext fun z => ?_
  obtain ⟨z, hz⟩ := z
  induction hz using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨y, hyI, rfl⟩ := hx
      exact (mul_cancel_left_mem_nonZeroDivisors hnzd).mp
        ((mul_apply_mk' g₁ _).trans (mul_apply_mk' g₂ _).symm)
  | algebraMap r => rw [show (⟨algebraMap R Rₐ r, _⟩ : affineBlowupAlgebra I a Rₐ) =
      algebraMap R (affineBlowupAlgebra I a Rₐ) r from rfl, AlgHom.commutes, AlgHom.commutes]
  | add x y hx hy ihx ihy =>
      rw [show (⟨x + y, _⟩ : affineBlowupAlgebra I a Rₐ) = ⟨x, hx⟩ + ⟨y, hy⟩ from rfl,
        map_add, map_add, ihx, ihy]
  | mul x y hx hy ihx ihy =>
      rw [show (⟨x * y, _⟩ : affineBlowupAlgebra I a Rₐ) = ⟨x, hx⟩ * ⟨y, hy⟩ from rfl,
        map_mul, map_mul, ihx, ihy]

/-- **The universal property of `R[I/a]`, both halves at once.** If the image of `a` in `B` is a
nonzerodivisor and `I·B` is the principal ideal it generates, then there is *exactly one*
`R`-algebra map `R[I/a] → B`. -/
@[instance_reducible]
public noncomputable def uniqueAlgHom
    (hIB : I.map (algebraMap R B) = Ideal.span {algebraMap R B a}) :
    Unique (affineBlowupAlgebra I a Rₐ →ₐ[R] B) where
  default := lift hnzd hIB
  uniq g := ext hnzd g (lift hnzd hIB)

end Uniqueness

end Stacks.AlgebraicGeometry.AffineBlowupLift

end
