module

public import StacksFrontier.AlgebraicGeometry.WeilCohomology.CohomologicalChernCharacterAdams
public import StacksFrontier.AlgebraicGeometry.WeilDeRham.TraceAxiomAlgClosedProjectiveSpace
public import StacksFrontier.AlgebraicGeometry.PicardUFD.ProjectiveSpaceCocycle

/-!
# The top coefficient of the Chern character of `𝒪(1)` on `ℙ^d_k`

Let `k` be a field, `F` a field of characteristic zero and `𝔇` data (D0), (D1), (D2') as in
Section 45.14 of the Stacks Project satisfying (A1), (A2), (A3) and (A5), and let `ch^H` be a
cohomological Chern character of Tag 0FIE (a rule `ch` with
`h : 𝔇.IsCohomologicalChernCharacter ch`, read in coordinates as `h.lift`). The proof of axiom
(A6) in Proposition 0FWD uses that `c₁^H(𝒪(1))^d ≠ 0` on `ℙ^d_k`; this file proves it, in the
form that the degree `d` coefficient `(1/d!) c₁^H(𝒪(1))^d` of `ch^H(𝒪(1)) = exp(c₁^H(𝒪(1)))` is
nonzero.

## The argument

* On the projective bundle `B = 𝐏(𝒪^{d+1}) ⟶ Spec(k)`, with `ξ = c₁^H(𝒪_B(1))`, the projective
  bundle formula (A3) sends `(0, …, 0, 1)` to `ξ^d`; as `H^*(Spec k) = F ≠ 0` by (A5), `ξ^d ≠ 0`
  (`Stacks.WeilDeRham.bundleClassU_projectiveSpaceModule_pow_ne_zero`).
* Let `e : ℙ^d_k ⟶ B` be the identification of Tag 01OE. By (A2), `e^*ξ = c₁^H(e^*𝒪_B(1))`, and
  `Pic(ℙ^d_k)` is generated by `𝒪(1)` (Tag 0BXJ), so `e^*ξ = m c` with `c = c₁^H(𝒪(1))` and
  `m ∈ ℤ`. Hence `e^*(ξ^d) = m^d c^d`, and `e^*` is injective, so `c^d ≠ 0`
  (`Stacks.WeilDeRham.coord_c₁_twistingSheaf_pow_ne_zero`).

## Main results

* `Stacks.WeilDeRham.coeff_cohomologicalChernCharacter_projectiveSpaceTwistClass_ne_zero`: the
  degree `d` coefficient of `ch^H(𝒪(1))` on `ℙ^d_k` is nonzero.
* `Stacks.WeilDeRham.cohomologicalChernCharacter_projectiveSpaceTwistClass_ne_zero`: the same,
  for `ch^H_d(𝒪(1)) ∈ H^{2d}(ℙ^d_k)(d)`.

## References

* [Stacks Project, Tag 0FWD](https://stacks.math.columbia.edu/tag/0FWD)
* [Stacks Project, Tag 0FIE](https://stacks.math.columbia.edu/tag/0FIE)
* [Stacks Project, Tag 01OE](https://stacks.math.columbia.edu/tag/01OE)
* [Stacks Project, Tag 0BXJ](https://stacks.math.columbia.edu/tag/0BXJ)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open Stacks.WeilCohomology Stacks.WeilCohomology.SmoothProjectiveScheme
open Stacks.AlgebraicGeometry.ProjPolyChart

universe u w

namespace Stacks.WeilDeRham

attribute [local instance] MvPolynomial.gradedAlgebra

variable {k : Type u} [Field k] {F : Type w} [Field F] (𝔇 : FirstChernClassData k F)

/-- **`ξ^d ≠ 0` for `ξ = c₁^H(𝒪_B(1))` on `B = 𝐏(𝒪^{d+1}) ⟶ Spec(k)`**, in coordinates: the
projective bundle formula (A3) sends `(0, …, 0, 1)` to `ξ^d`, and `H^*(Spec k) ≠ 0` by (A5). -/
theorem bundleClassU_projectiveSpaceModule_pow_ne_zero (hA3 : 𝔇.ProjectiveBundleAxiom)
    (hA5 : 𝔇.KunnethAxiom) (d : ℕ) :
    𝔇.bundleClassU (point k) (projectiveSpaceModule k d) d ^ d ≠ 0 := by
  intro hξ
  have := nontrivial_H_point 𝔇 hA5
  set a : Fin (d + 1) → 𝔇.H (point k) := Pi.single (Fin.last d) 1
  have h := (𝔇.bijective_bundleFormulaU hA3 (point k) (projectiveSpaceModule k d) d).1
    (a₁ := a) (a₂ := 0) (by
      beta_reduce
      rw [Fintype.sum_eq_single (Fin.last d) fun i hi => by simp [a, hi]]
      simp [a, hξ])
  exact one_ne_zero (α := 𝔇.H (point k)) (by simpa [a] using congrFun h (Fin.last d))

/-- **`c₁^H(𝒪(1))^d ≠ 0` on `ℙ^d_k`**, in coordinates. Pulling back along `ℙ^d_k ≅ 𝐏(𝒪^{d+1})`
carries `ξ = c₁^H(𝒪_B(1))` to an integer multiple of `c₁^H(𝒪(1))`, since `Pic(ℙ^d_k)` is generated
by `𝒪(1)`, and the pullback is injective. -/
theorem coord_c₁_twistingSheaf_pow_ne_zero (hA2 : 𝔇.PullbackAxiom)
    (hA3 : 𝔇.ProjectiveBundleAxiom) (hA5 : 𝔇.KunnethAxiom) (d : ℕ) :
    𝔇.κ (projectiveSpace k d) 1 (𝔇.c₁ (projectiveSpace k d)
      (Stacks.PicardUFD.twistPicardHom k d 1)) ^ d ≠ 0 := by
  intro hc
  set M := projectiveSpaceModule k d
  set P := projectiveSpace k d
  have := AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree M (d + 1)
  have hpull := hA2 (projectiveSpaceBundleInv k d) (Stacks.Chow.bundleTwist M)
    (Stacks.Chow.isInvertible_bundleTwist M)
  set L := picardClassOf ((toScheme k).obj P)
    ((Scheme.Modules.pullback ((toScheme k).map (projectiveSpaceBundleInv k d))).obj
      (Stacks.Chow.bundleTwist M)) (isInvertible_pullback_obj _ _
        (Stacks.Chow.isInvertible_bundleTwist M))
  obtain ⟨m, hm⟩ := Stacks.PicardUFD.twistPicardHom_surjective_general k d L
  have hm' : (L : ((toScheme k).obj P).picardGroup) =
      m • Stacks.PicardUFD.twistPicardHom k d 1 := by
    rw [← map_zsmul, smul_eq_mul, mul_one]
    exact hm.symm
  have hξ : 𝔇.pull (projectiveSpaceBundleInv k d) (𝔇.bundleClassU (point k) M d) =
      m • 𝔇.κ P 1 (𝔇.c₁ P (Stacks.PicardUFD.twistPicardHom k d 1)) := by
    have h1 := congrArg (𝔇.κ P 1) hpull
    rw [FirstChernClassData.κ_pullTw] at h1
    refine h1.trans ((congrArg (fun L => 𝔇.κ P 1 (𝔇.c₁ P L)) hm').trans ?_)
    exact (congrArg (𝔇.κ P 1) (map_zsmul (𝔇.c₁ P) m _)).trans (map_zsmul (𝔇.κ P 1) m _)
  apply bundleClassU_projectiveSpaceModule_pow_ne_zero 𝔇 hA3 hA5 d
  have hinj : ∀ x, 𝔇.pull (projectiveSpaceBundleHom k d)
      (𝔇.pull (projectiveSpaceBundleInv k d) x) = x := fun x => by
    rw [← AlgHom.comp_apply, ← 𝔇.pull_comp, projectiveSpaceBundleHom_inv, 𝔇.pull_id]
    rfl
  rw [← hinj (_ ^ d), map_pow, hξ, smul_pow, hc, smul_zero, map_zero]

/-- **The degree `d` coefficient of `ch^H(𝒪(1))` on `ℙ^d_k` is nonzero**, for data satisfying
(A1), (A2), (A3) and (A5) and a cohomological Chern character `ch^H` of Tag 0FIE: it is
`(1/d!) c₁^H(𝒪(1))^d`, and `c₁^H(𝒪(1))^d ≠ 0`. -/
theorem coeff_cohomologicalChernCharacter_projectiveSpaceTwistClass_ne_zero [CharZero F]
    {𝔇 : FirstChernClassData k F}
    {ch : ∀ X : (SmoothProjectiveScheme k).FullSubcategory,
      VectorBundleKZero ((toScheme k).obj X) → ∀ n : ℕ, tateTwist F 𝔇.tate (𝔇.H X) n}
    (h : 𝔇.IsCohomologicalChernCharacter ch) (hA1 : 𝔇.CoproductAxiom)
    (hA2 : 𝔇.PullbackAxiom) (hA3 : 𝔇.ProjectiveBundleAxiom) (hA5 : 𝔇.KunnethAxiom) (d : ℕ) :
    PowerSeries.coeff d (h.lift (projectiveSpace k d) (projectiveSpaceTwistClass k d)) ≠ 0 := by
  have hL := (Stacks.InvertiblePullback.stacksIsInvertible_iff_algebraicGeometryIsInvertible _ _
    _).mp (Stacks.PicardUFD.isInvertible_twistingSheaf k (n := d) 1)
  intro h0
  have hch := h.lift_classOf hA1 hA3 (projectiveSpace k d)
    (ProjectiveSpectrum.Proj.twistingSheaf (polyGrading k d) 1) hL
  have h2 := (Weak.coeff_expFirstChernClass (𝔚 := 𝔇.toChernSetup hA1 hA3) (projectiveSpace k d)
    (Stacks.PicardUFD.twistPicardHom k d 1) d).symm.trans
      ((congrArg (PowerSeries.coeff d) hch).symm.trans h0)
  have hu : IsUnit (algebraMap ℚ ((𝔇.toChernSetup hA1 hA3).A (projectiveSpace k d))
      ((d.factorial : ℚ)⁻¹)) :=
    (isUnit_iff_ne_zero.mpr (inv_ne_zero (Nat.cast_ne_zero.mpr d.factorial_ne_zero))).map _
  replace h2 := hu.mul_right_eq_zero.mp h2
  apply coord_c₁_twistingSheaf_pow_ne_zero 𝔇 hA2 hA3 hA5 d
  have h3 : 𝔇.c₁A (projectiveSpace k d) (Stacks.PicardUFD.twistPicardHom k d 1) ^ d = 0 := h2
  have h' := congrArg (fun x : 𝔇.A (projectiveSpace k d) => (x : 𝔇.H (projectiveSpace k d))) h3
  simp only [SubmonoidClass.coe_pow, ZeroMemClass.coe_zero] at h'
  exact h'

/-- **`ch^H_d(𝒪(1)) ≠ 0` on `ℙ^d_k`**, in `H^{2d}(ℙ^d_k)(d)`: its coordinate is the coefficient
of `Stacks.WeilDeRham.coeff_cohomologicalChernCharacter_projectiveSpaceTwistClass_ne_zero`. -/
theorem cohomologicalChernCharacter_projectiveSpaceTwistClass_ne_zero [CharZero F]
    {𝔇 : FirstChernClassData k F}
    {ch : ∀ X : (SmoothProjectiveScheme k).FullSubcategory,
      VectorBundleKZero ((toScheme k).obj X) → ∀ n : ℕ, tateTwist F 𝔇.tate (𝔇.H X) n}
    (h : 𝔇.IsCohomologicalChernCharacter ch) (hA1 : 𝔇.CoproductAxiom)
    (hA2 : 𝔇.PullbackAxiom) (hA3 : 𝔇.ProjectiveBundleAxiom) (hA5 : 𝔇.KunnethAxiom) (d : ℕ) :
    ch (projectiveSpace k d) (projectiveSpaceTwistClass k d) d ≠ 0 := by
  intro h0
  apply coeff_cohomologicalChernCharacter_projectiveSpaceTwistClass_ne_zero h hA1 hA2 hA3 hA5 d
  apply Subtype.ext
  rw [h.coeff_lift, h0, map_zero]
  rfl

end Stacks.WeilDeRham

end
