module

public import Mathlib.AlgebraicGeometry.AlgClosed.Basic
public import StacksFrontier.AlgebraicGeometry.WeilDeRham.TraceAxiomAlgClosedKunneth
public import StacksFrontier.AlgebraicGeometry.WeilDeRham.PushforwardCalculus.IsoTrace
public import StacksFrontier.AlgebraicGeometry.WeilDeRham.KunnethOfIsPullback
public import StacksFrontier.AlgebraicGeometry.WeilDeRham.PushforwardCalculus.Chow
public import StacksFrontier.AlgebraicGeometry.Chow.ZeroCyclesSeparablePoints
public import StacksFrontier.AlgebraicGeometry.Chow.RelativeCycles.CycleCapRuleGeneric

/-!
# Zero cycles over an algebraically closed field are generated by rational points

Let `k` be an algebraically closed field and `X` a smooth projective scheme over `k`,
equidimensional of dimension `d`. Then `CH^d(X) = CH_0(X)` is generated by the classes `[x]` of
the rational points `x` of `X`.

## Main results

* `Stacks.WeilDeRham.properPushforward_fundamentalCycle_eq_cycleAssociatedToIntegralComponentAt`:
  for a rational point `x`, the pushforward `x_*[Spec(k)]` is the prime cycle of the image of `x`.
* `Stacks.WeilDeRham.mem_closure_properChowPushforward_fundamentalChowClass`: for `X`
  quasi-compact, `CH_0(X)` is generated by the classes `x_*[Spec(k)]` of the rational points.
* `Stacks.WeilDeRham.chowCodimTotal_injective`: on `X` equidimensional of dimension `d`, the map
  `CH^d(X) ⟶ CH_0(X)`, `α ↦ α_{(0)}`, is injective.
* `Stacks.WeilDeRham.chowCodimTotal_pointChowClass`: that map carries the class `[x] ∈ CH^d(X)`
  of a rational point `x` to `x_*[Spec(k)]`.
* `Stacks.WeilDeRham.mem_closure_pointChowClass`: `CH^d(X)` is generated by the classes of the
  rational points.

## References

* [Stacks Project, Tag 0FWD](https://stacks.math.columbia.edu/tag/0FWD)
* [Stacks Project, Tag 02QR](https://stacks.math.columbia.edu/tag/02QR)
* [Stacks Project, Tag 02RW](https://stacks.math.columbia.edu/tag/02RW)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Stacks.Chow Stacks.WeilCohomology
open Stacks.WeilCohomology.SmoothProjectiveScheme

universe u

namespace Stacks.WeilDeRham

variable {k : Type u} [Field k]

/-! ### Zero cycles and rational points -/

section ZeroCycles

variable {X : Scheme.{u}} (sX : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType sX]

/-- `Spec(k)` has `δ`-dimension `0` over itself. -/
theorem schemeDeltaDimension_id_fieldChowSituation :
    schemeDeltaDimension (fieldChowSituation k) (𝟙 (Spec (.of k))) = ((0 : ℤ) : EInt) := by
  rw [schemeDeltaDimension_eq_genericPoint, relativeDimension_id,
    fieldChowSituation_dimensionFunction]

open Classical in
/-- For a rational point `x` of `X` over `k` with image `z`, the pushforward `x_*[Spec(k)]` of
the fundamental cycle of `Spec(k)` is the prime cycle of `z`. -/
theorem properPushforward_fundamentalCycle_eq_cycleAssociatedToIntegralComponentAt
    [IsSeparated sX] (x : Spec (.of k) ⟶ X) (hx : x ≫ sX = 𝟙 _) :
    haveI : IsProper x := isProper_of_comp_eq_id hx
    properPushforward (fieldChowSituation k) (𝟙 _) sX x hx 0
        (fundamentalCycle (fieldChowSituation k) (𝟙 _) 0) =
      cycleAssociatedToClosedSubscheme (fieldChowSituation k) sX
        (integralComponentAt (x.base (genericPoint (Spec (.of k))))).subschemeι 0 := by
  have : IsProper x := isProper_of_comp_eq_id hx
  have : IsClosedImmersion x := isClosedImmersion_of_comp_eq_id sX x hx
  have happ := properPushforward_fundamentalCycle_apply (fieldChowSituation k) (𝟙 _) sX x hx
    schemeDeltaDimension_id_fieldChowSituation
  have hdim : relativeDimension (fieldChowSituation k).dimensionFunction sX
      (x.base (genericPoint (Spec (.of k)))) = 0 :=
    (mem_cyclesOfDimension_iff_forall_point _ sX 0 _).mp
      (properPushforward (fieldChowSituation k) (𝟙 _) sX x hx 0
        (fundamentalCycle (fieldChowSituation k) (𝟙 _) 0)).2 _
      (by rw [happ, if_pos rfl]; exact one_ne_zero)
  refine Subtype.ext (Function.locallyFinsuppWithin.ext fun w ↦ ?_)
  rw [happ]
  split_ifs with hw
  · subst hw
    exact (cycleAssociatedToIntegralComponentAt_apply_self _ sX hdim).symm
  · exact (cycleAssociatedToIntegralComponentAt_apply_of_ne _ sX 0 _ hw).symm

/-- Over an algebraically closed field `k`, for `X` quasi-compact, separated and locally of finite
type over `k`, every class of `CH_0(X)` lies in the subgroup generated by the classes
`x_*[Spec(k)]` of the rational points `x` of `X`. -/
theorem mem_closure_properChowPushforward_fundamentalChowClass [IsAlgClosed k] [IsSeparated sX]
    [CompactSpace X] (α : chowGroup (fieldChowSituation k) sX 0) :
    α ∈ AddSubgroup.closure {α' | ∃ (x : Spec (.of k) ⟶ X) (hx : x ≫ sX = 𝟙 _),
      α' = haveI : IsProper x := isProper_of_comp_eq_id hx
        properChowPushforward (fieldChowSituation k) (𝟙 _) sX x hx 0
          (properPushforwardDescends _ _ _ _ _ _)
          (fundamentalChowClass (fieldChowSituation k) (𝟙 _) 0)} := by
  induction α using QuotientAddGroup.induction_on with
  | H β =>
    rw [show QuotientAddGroup.mk β =
      QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation k) sX 0) β from rfl]
    have hfin := finite_support_of_compactSpace (fieldChowSituation k) sX 0 β
    rw [eq_finsetSum_cycleAssociatedToIntegralComponentAt (fieldChowSituation k) sX 0 β hfin,
      map_sum]
    refine AddSubgroup.sum_mem _ fun y hy ↦ ?_
    rw [map_zsmul]
    refine AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure ?_) _
    have hdim := (mem_cyclesOfDimension_iff_forall_point (fieldChowSituation k) sX 0 β.1).mp β.2 y
      (hfin.mem_toFinset.mp hy)
    have hcl := isClosed_singleton_of_relativeDimension_eq_zero k sX hdim
    have hx := pointOfClosedPoint_comp sX y hcl
    have : IsProper (pointOfClosedPoint sX y hcl) := isProper_of_comp_eq_id hx
    refine ⟨pointOfClosedPoint sX y hcl, hx, ?_⟩
    rw [fundamentalChowClass, properChowPushforward_mk,
      properPushforward_fundamentalCycle_eq_cycleAssociatedToIntegralComponentAt sX _ hx,
      pointOfClosedPoint_apply]

end ZeroCycles

/-! ### Rational points generate `CH^d(X)` -/

section Codim

/-- On `X` smooth over `k` and equidimensional of dimension `d`, the map `CH^d(X) ⟶ CH_0(X)`
taking a class to its component in dimension `0` is injective. -/
theorem chowCodimTotal_injective {X : Scheme.{u}} (sX : X ⟶ (fieldChowSituation k).S) [Smooth sX]
    {d : ℕ} (hX : RelativeDimension sX d) : Function.Injective (chowCodimTotal k sX d 0) := by
  intro a b h
  rw [← chowCodimPart_chowCodimTotal k sX d a, ← chowCodimPart_chowCodimTotal k sX d b]
  congr 1
  funext n
  by_cases hn : n = (d : ℤ) - (d : ℕ)
  · obtain rfl : n = 0 := by lia
    exact h
  · rw [chowCodimTotal_eq_zero_of_ne k sX hX d hn, chowCodimTotal_eq_zero_of_ne k sX hX d hn]

/-- On `X` equidimensional of dimension `d`, the class in dimension `0` of the class
`[x] ∈ CH^d(X)` of a rational point `x` is `x_*[Spec(k)] ∈ CH_0(X)`. -/
theorem chowCodimTotal_pointChowClass (X : (SmoothProjectiveScheme k).FullSubcategory) {d : ℕ}
    (hd : RelativeDimension X.obj.hom d) (x : Spec (.of k) ⟶ (toScheme k).obj X)
    (hx : x ≫ X.obj.hom = 𝟙 _) :
    haveI : IsSeparated X.obj.hom := (isProjective X).isSeparated
    haveI : IsProper x := isProper_of_comp_eq_id hx
    chowCodimTotal k X.obj.hom d 0 (pointChowClass x hx d) =
      properChowPushforward (fieldChowSituation k) (𝟙 _) X.obj.hom x hx 0
        (properPushforwardDescends _ _ _ _ _ _)
        (fundamentalChowClass (fieldChowSituation k) (𝟙 _) 0) := by
  have : IsSeparated X.obj.hom := (isProjective X).isSeparated
  have : IsProper x := isProper_of_comp_eq_id hx
  rw [pointChowClass, chowCodimTotal_chowCodimPushforward k (𝟙 _) X.obj.hom
      (relativeDimension_identity _) hd x hx 0 d (by simp) 0,
    chowCodimTotal_chowCodimFundamental (𝟙 _) (relativeDimension_identity _) 0]

/-- Over an algebraically closed field `k`, for `X` smooth projective over `k` and equidimensional
of dimension `d`, the classes `[x] ∈ CH^d(X)` of the rational points `x` of `X` generate
`CH^d(X) = CH_0(X)`. -/
theorem mem_closure_pointChowClass [IsAlgClosed k]
    (X : (SmoothProjectiveScheme k).FullSubcategory) {d : ℕ} (hd : RelativeDimension X.obj.hom d)
    (β : Stacks.Chow.codimensionChowGroup k X.obj.hom d) :
    β ∈ AddSubgroup.closure {β' | ∃ (x : Spec (.of k) ⟶ (toScheme k).obj X)
      (hx : x ≫ X.obj.hom = 𝟙 _), β' = pointChowClass x hx d} := by
  have : IsSeparated X.obj.hom := (isProjective X).isSeparated
  have hT := mem_closure_properChowPushforward_fundamentalChowClass X.obj.hom
    (chowCodimTotal k X.obj.hom d 0 β)
  have hle : AddSubgroup.closure {α' | ∃ (x : Spec (.of k) ⟶ (toScheme k).obj X)
      (hx : x ≫ X.obj.hom = 𝟙 _), α' = have : IsProper x := isProper_of_comp_eq_id hx
        properChowPushforward (fieldChowSituation k) (𝟙 _) X.obj.hom x hx 0
          (properPushforwardDescends _ _ _ _ _ _)
          (fundamentalChowClass (fieldChowSituation k) (𝟙 _) 0)} ≤
      (AddSubgroup.closure {β' | ∃ (x : Spec (.of k) ⟶ (toScheme k).obj X)
        (hx : x ≫ X.obj.hom = 𝟙 _), β' = pointChowClass x hx d}).map
        (chowCodimTotal k X.obj.hom d 0) := by
    rw [AddMonoidHom.map_closure]
    refine AddSubgroup.closure_mono ?_
    rintro _ ⟨x, hx, rfl⟩
    exact ⟨pointChowClass x hx d, ⟨x, hx, rfl⟩, chowCodimTotal_pointChowClass X hd x hx⟩
  obtain ⟨γ, hγ, hγβ⟩ := hle hT
  rwa [chowCodimTotal_injective X.obj.hom hd hγβ] at hγ

end Codim

end Stacks.WeilDeRham

end
