/-! ### Chases at variables -/

/-- Two commuting squares pasted horizontally, at variables. -/
private lemma square_paste {C : Type*} [Category* C] {a b c a' b' c' : C} (x : a ⟶ a')
    (P : a ⟶ b) (P' : a' ⟶ b') (y : b ⟶ b') (H : b ⟶ c) (H' : b' ⟶ c') (z : c ⟶ c')
    (h₁ : x ≫ P' = P ≫ y) (h₂ : y ≫ H' = H ≫ z) : x ≫ (P' ≫ H') = (P ≫ H) ≫ z := by
  rw [← Category.assoc, h₁, Category.assoc, h₂, Category.assoc]

/-- A square whose left half is rewritten along three equations, at variables. -/
private lemma square_paste_of_eq {C : Type*} [Category* C] {a b c d a' b' c' d' : C}
    (P₁ P₁' : a ⟶ b) (R₁ : b ⟶ c) (Γ₁ : c ⟶ d) (D : d ⟶ d') (DW : c ⟶ c')
    (Γ₂ : c' ⟶ d') (DX DX' : a ⟶ a') (P₂ P₂' : a' ⟶ b') (R₂ : b' ⟶ c')
    (hA : (P₁ ≫ R₁) ≫ DW = DX ≫ P₂ ≫ R₂) (e₁ : P₁ = P₁') (e₂ : P₂ = P₂') (e₃ : DX = DX')
    (hK : Γ₁ ≫ D = DW ≫ Γ₂) : ((P₁' ≫ R₁) ≫ Γ₁) ≫ D = DX' ≫ (P₂' ≫ R₂) ≫ Γ₂ := by
  subst e₁ e₂ e₃
  rw [Category.assoc, hK, ← Category.assoc, hA]
  simp only [Category.assoc]

section DerivedScalar

variable {R : Type*} [CommRing R] {C : Type*} [Category* C] [Abelian C] [Linear R C]
  [HasDerivedCategory C]

/-- **Scalars commute with every morphism of the derived category between single complexes**:
if `ψ` and `ψ'` are multiplication by `r` on `M` and `N`, then
`ψ[-a] ≫ Φ = Φ ≫ ψ'[-b]` for every `Φ : M[-a] ⟶ N[-b]`. -/
theorem singleFunctor_map_comp_eq_of_eq_smul (a b : ℤ) {M N : C} (r : R) {ψ : M ⟶ M}
    {ψ' : N ⟶ N} (hψ : ψ = r • 𝟙 M) (hψ' : ψ' = r • 𝟙 N)
    (Φ : (DerivedCategory.singleFunctor C a).obj M ⟶ (DerivedCategory.singleFunctor C b).obj N) :
    (DerivedCategory.singleFunctor C a).map ψ ≫ Φ =
      Φ ≫ (DerivedCategory.singleFunctor C b).map ψ' := by
  subst hψ hψ'
  rw [Functor.map_smul, CategoryTheory.Functor.map_id, Functor.map_smul,
    CategoryTheory.Functor.map_id, Linear.smul_comp, Linear.comp_smul, Category.id_comp,
    Category.comp_id]

end DerivedScalar

section GysinScalar

attribute [local instance] Stacks.Topology.RingedSpaceSheafifyOpens.opensHasSheafifyAddCommGrpCat
  Stacks.Topology.RingedSpaceSheafifyOpens.opensWEqualsLocallyBijectiveAddCommGrpCat
attribute [local instance] Stacks.DeRham.CohomologicalGysin.moduleSheavesHasDerivedCategory
attribute [local instance] AlgebraicGeometry.SheafOfModules.abelianModules
  AlgebraicGeometry.SheafOfModules.hasSheafifyOpens
  AlgebraicGeometry.SheafOfModules.wEqualsLocallyBijectiveOpens

/-- **The Gysin map on cohomology commutes with multiplication by a global function.** -/
theorem gysinCohomologyMap_globalSmul {X : Scheme.{u}} (Z : Set X.carrier) (hZ : IsClosed Z)
    (c : ℕ) (A F : RModules X.toRingedSpace)
    (hvan : ∀ i : ℤ, i < (c : ℤ) → IsZero (localCohomologySheafOfComplex X.toRingedSpace Z hZ i
      ((DerivedCategory.singleFunctor _ (0 : ℤ)).obj F)))
    (γ : A ⟶ (modulePushforward (closedSubsetInclusion X.toRingedSpace Z)).obj
      (localCohomologySheafOfComplex X.toRingedSpace Z hZ (c : ℤ)
        ((DerivedCategory.singleFunctor _ (0 : ℤ)).obj F)))
    (q : ℕ) (r : Γ(X, ⊤)) :
    (Hfunctor X.ringCatSheaf ⊤ q).map (globalSmul r A) ≫
        gysinCohomologyMap Z hZ c A F hvan γ q =
      gysinCohomologyMap Z hZ c A F hvan γ q ≫
        (Hfunctor X.ringCatSheaf ⊤ (q + c)).map (globalSmul r F) := by
  let : Linear Γ(X, ⊤) (RModules X.toRingedSpace) := AlgebraicGeometry.linearModules (X := X)
  have h1 := Stacks.DeRham.GysinProjection.comparisonIsNatural X.toRingedSpace c q A A
    (globalSmul r A)
  have h2 := Stacks.DeRham.GysinProjection.cohomologyMapOfSingleHom_single_comp X.toRingedSpace
    A A F c q (globalSmul r A) ((DerivedCategory.singleFunctor _ (c : ℤ)).map γ ≫
      supportedGysinEdge Z hZ (c : ℤ) ((DerivedCategory.singleFunctor _ (0 : ℤ)).obj F) hvan)
  have h3 := Stacks.DeRham.GysinCupHodge.cohomologyMapOfSingleHom_comp_single
    (Y := X.toRingedSpace) A F F c q ((DerivedCategory.singleFunctor _ (c : ℤ)).map γ ≫
      supportedGysinEdge Z hZ (c : ℤ) ((DerivedCategory.singleFunctor _ (0 : ℤ)).obj F) hvan)
    (globalSmul r F)
  have h4 := singleFunctor_map_comp_eq_of_eq_smul (c : ℤ) (0 : ℤ) r
    (globalSmul_eq_smul_id r A) (globalSmul_eq_smul_id r F)
    ((DerivedCategory.singleFunctor _ (c : ℤ)).map γ ≫
      supportedGysinEdge Z hZ (c : ℤ) ((DerivedCategory.singleFunctor _ (0 : ℤ)).obj F) hvan)
  exact (congrArg (· ≫ _) h1.symm).trans (h2.symm.trans ((congrArg _ h4).trans h3))

end GysinScalar

section AmbientScalar

variable {A : Type u} [CommRing A] {X W : Scheme.{u}} (f : X ⟶ Spec (.of A))
  (πW : W ⟶ Spec (.of A)) (i : X ⟶ W) (G : W ⟶ X) (wG : G ≫ f = πW ≫ 𝟙 _)

/-- **The ambient copy is `A`-linear**: it carries multiplication by `c ∈ A` on
`Hᵠ(X, Ωᵖ_{X/A})` to multiplication by `c` on `Hᵠ(W, i_*Ωᵖ_{X/A})`. -/
theorem ambientCopy_globalSmul (hG : G ≫ f = πW) (p q : ℕ) (c : A) :
    (Hfunctor X.ringCatSheaf ⊤ q).map
        (globalSmul ((Stacks.Cech.globalRingHom f).hom c) (f.relativeDifferentialForms (p : ℤ))) ≫
      ambientCopy f πW i G wG p q =
    ambientCopy f πW i G wG p q ≫
      (Hfunctor W.ringCatSheaf ⊤ q).map
        (globalSmul ((Stacks.Cech.globalRingHom πW).hom c)
          (pushforwardRelativeForms i πW (p : ℤ))) := by
  refine square_paste _ _ _ _ _ _ _ (pullbackHgroup_naturality _ 0 (q : ℤ) q (by simp) _ _ _ _
    (formsBaseChangeHom_comp_globalSmul_of_comp f πW G hG wG (p : ℤ) c)) ?_
  exact (Functor.map_comp _ _ _).symm.trans ((congrArg (Hfunctor W.ringCatSheaf ⊤ q).map
    (comp_globalSmul _ (formRestrictionModules i πW (p : ℤ)))).symm.trans (Functor.map_comp _ _ _))

end AmbientScalar

section GysinComposite

attribute [local instance] Stacks.Topology.RingedSpaceSheafifyOpens.opensHasSheafifyAddCommGrpCat
  Stacks.Topology.RingedSpaceSheafifyOpens.opensWEqualsLocallyBijectiveAddCommGrpCat
attribute [local instance] Stacks.DeRham.CohomologicalGysin.moduleSheavesHasDerivedCategory
attribute [local instance] AlgebraicGeometry.SheafOfModules.abelianModules
  AlgebraicGeometry.SheafOfModules.hasSheafifyOpens
  AlgebraicGeometry.SheafOfModules.wEqualsLocallyBijectiveOpens

variable {A : Type u} [CommRing A] {X W : Scheme.{u}} (f : X ⟶ Spec (.of A))
  (πW : W ⟶ Spec (.of A)) [Smooth πW] (i : X ⟶ W) [IsClosedImmersion i]
  [LocallyOfFinitePresentation i] (G : W ⟶ X) (wG : G ≫ f = πW ≫ 𝟙 _)
  (hK : IsKoszulRegularImmersion i) {c : ℕ} (hE : ConormalRank i c)

/-- **The Gysin map of a class of `X` is `A`-linear**: `θ ↦ γ^{p,q}_i(G^*θ|_i)` carries
multiplication by `c ∈ A` on `Hᵠ(X, Ωᵖ_{X/A})` to multiplication by `c` on
`H^{q+c}(W, Ω^{p+c}_{W/A})`. -/
theorem ambientCopy_comp_formsGysinMap_globalSmul (hG : G ≫ f = πW) (p q : ℕ) (a : A) :
    (Hfunctor X.ringCatSheaf ⊤ q).map
        (globalSmul ((Stacks.Cech.globalRingHom f).hom a) (f.relativeDifferentialForms (p : ℤ))) ≫
      ambientCopy f πW i G wG p q ≫ formsGysinMap i πW hK hE p q =
    (ambientCopy f πW i G wG p q ≫ formsGysinMap i πW hK hE p q) ≫
      (Hfunctor W.ringCatSheaf ⊤ (q + c)).map
        (globalSmul ((Stacks.Cech.globalRingHom πW).hom a)
          (πW.relativeDifferentialForms ((p : ℤ) + (c : ℤ)))) :=
  square_paste _ _ _ _ _ _ _ (ambientCopy_globalSmul f πW i G wG hG p q a)
    (gysinCohomologyMap_globalSmul _ _ c _ _ _ _ q _)

/-- **The Gysin map of a class of `X` commutes with the de Rham differentials** ([Stacks,
Tag 0G8B] read on classes of `X`): for `θ ∈ Hᵠ(X, Ωᵖ_{X/A})`,
`d(γ^{p,q}_i(G^*θ|_i)) = γ^{p+1,q}_i(G^*(dθ)|_i)`. -/
theorem ambientCopy_comp_formsGysinMap_comm_deRham (p q : ℕ) :
    (ambientCopy f πW i G wG p q ≫ formsGysinMap i πW hK hE p q) ≫
        abelianHgroupMap W.toRingedSpace (0 : ℤ) ((q : ℤ) + (c : ℤ)) (q + c) (by omega)
          (ambientDeRhamShiftAbHom πW c p) =
      abelianHgroupMap X.toRingedSpace 0 (q : ℤ) q (by simp) (deRhamDifferentialAbHom f p) ≫
        ambientCopy f πW i G wG (p + 1) q ≫ formsGysinMap i πW hK hE (p + 1) q := by
  unfold ambientCopy
  refine square_paste_of_eq _ _ _ _ _ _ _ _ _ _ _ _
    (ambientCopy_comm_deRham i πW f G wG (c : ℤ) ((q : ℤ) + (c : ℤ)) q (by omega) p) ?_ ?_ ?_
    (koszulGysinCohomologyMap_comm_deRham i πW hK p q hE)
  · exact pullbackHgroup_canonical_eq _ _ _ _ _ _
  · exact pullbackHgroup_canonical_eq _ _ _ _ _ _
  · exact abelianHgroupMap_deRham_eq f (c : ℤ) 0 ((q : ℤ) + (c : ℤ)) (q : ℤ) q (by omega)
      (by simp) p

end GysinComposite

section ThreeMaps

variable {A : Type u} [CommRing A] {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) [IsProper f]
  (n : ℕ) [SmoothOfRelativeDimension n f] (σ : Spec (.of A) ⟶ X) (hσ : σ ≫ f = 𝟙 _)

/-- **The Gysin map of the diagonal commutes with the de Rham differentials.** -/
theorem diagonalGysin_comm_deRham (p q : ℕ) :
    diagonalGysin f n p q ≫
        abelianHgroupMap (pullback f f).toRingedSpace (0 : ℤ) ((q : ℤ) + (n : ℤ)) (q + n)
          (by omega) (ambientDeRhamShiftAbHom (prodStructure f) n p) =
      abelianHgroupMap X.toRingedSpace 0 (q : ℤ) q (by simp) (deRhamDifferentialAbHom f p) ≫
        diagonalGysin f n (p + 1) q :=
  have := smooth_prodStructure f n
  ambientCopy_comp_formsGysinMap_comm_deRham f (prodStructure f) (pullback.diagonal f)
    (pullback.fst f f) (fst_comp_eq_prodStructure f) (diagonal_koszul_and_conormalRank f n).1
    (diagonal_koszul_and_conormalRank f n).2 p q

/-- **The Gysin map of the diagonal is `A`-linear.** -/
theorem diagonalGysin_globalSmul (p q : ℕ) (a : A) :
    (Hfunctor X.ringCatSheaf ⊤ q).map
        (globalSmul ((Stacks.Cech.globalRingHom f).hom a) (f.relativeDifferentialForms (p : ℤ))) ≫
      diagonalGysin f n p q =
    diagonalGysin f n p q ≫
      (Hfunctor (pullback f f).ringCatSheaf ⊤ (q + n)).map
        (globalSmul ((Stacks.Cech.globalRingHom (prodStructure f)).hom a)
          ((prodStructure f).relativeDifferentialForms ((p : ℤ) + (n : ℤ)))) :=
  have := smooth_prodStructure f n
  ambientCopy_comp_formsGysinMap_globalSmul f (prodStructure f) (pullback.diagonal f)
    (pullback.fst f f) (fst_comp_eq_prodStructure f) (diagonal_koszul_and_conormalRank f n).1
    (diagonal_koszul_and_conormalRank f n).2 rfl p q a

variable [IsClosedImmersion σ] [LocallyOfFinitePresentation σ]

