section Generator

variable {A : Type u} [CommRing A] {X : Scheme.{u}} (f : X ⟶ Spec (.of A))

/-- **Two `A`-linear maps out of a cohomology group generated by one class agree if they agree on
it.** Let `X` be quasi-compact and separated over `Spec A` and `ξ ∈ Hᵈ(X, 𝒢)` a class whose image
generates the Čech cohomology `Hᵈ(Č(𝒰, 𝒢))` as an `A`-module for every finite affine covering
`𝒰`. Two additive maps `φ, ψ` out of `Hᵈ(X, 𝒢)` intertwining multiplication by every `a ∈ A`
with the same endomorphisms `Λ a` of the target and agreeing on `ξ` are equal. -/
theorem hom_eq_of_span_eq_top [IsSeparated f] [CompactSpace X] (G : X.Modules)
    [G.IsQuasicoherent] (d : ℕ) (ξ : Hgroup X.ringCatSheaf ⊤ d G)
    (hspan : ∀ {I : Type u} [Fintype I] [LinearOrder I] (U : I → X.Opens)
      (hU : (⊤ : X.Opens) = ⨆ i, U i) (hUaff : ∀ i, IsAffineOpen (U i)),
      Submodule.span A {show ↑((Stacks.Cech.alternatingCechModuleComplex f U G).homology d) from
        (Stacks.Cech.hgroupIsoAlternatingCechModuleHomology f U hU
          (fun _ s => Stacks.Cech.inter_isAffineOpen f U hUaff s) G d).hom ξ} = ⊤)
    {T : AddCommGrpCat.{u}} (φ ψ : Hgroup X.ringCatSheaf ⊤ d G ⟶ T) (Λ : A → (T ⟶ T))
    (hφ : ∀ a, (Hfunctor X.ringCatSheaf ⊤ d).map
      (globalSmul ((Stacks.Cech.globalRingHom f).hom a) G) ≫ φ = φ ≫ Λ a)
    (hψ : ∀ a, (Hfunctor X.ringCatSheaf ⊤ d).map
      (globalSmul ((Stacks.Cech.globalRingHom f).hom a) G) ≫ ψ = ψ ≫ Λ a)
    (h : φ.hom ξ = ψ.hom ξ) : φ = ψ := by
  classical
  obtain ⟨s, hs⟩ :=
    Stacks.AlgebraicGeometry.Tag01PFAffineExtend.exists_finset_affineOpens_iSup_eq_top (X := X)
  let : LinearOrder s := linearOrderOfSTO WellOrderingRel
  let U : s → X.Opens := fun i => i.1.1
  have hU : (⊤ : X.Opens) = ⨆ i, U i := hs.symm.trans iSup_subtype'
  have hUaff : ∀ i, IsAffineOpen (U i) := fun i => i.1.2
  set E := Stacks.Cech.hgroupIsoAlternatingCechModuleHomology f U hU
    (fun _ s => Stacks.Cech.inter_isAffineOpen f U hUaff s) G d
  ext x
  have hx : (show ↑((Stacks.Cech.alternatingCechModuleComplex f U G).homology d) from E.hom x) ∈
      Submodule.span A {show ↑((Stacks.Cech.alternatingCechModuleComplex f U G).homology d) from
        E.hom ξ} := by
    rw [hspan U hU hUaff]
    exact Submodule.mem_top
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.1 hx
  have hax : ((Hfunctor X.ringCatSheaf ⊤ d).map
      (globalSmul ((Stacks.Cech.globalRingHom f).hom a) G)).hom ξ = x :=
    (ConcreteCategory.bijective_of_isIso E.hom).1
      ((Stacks.Cech.hgroupIsoAlternatingCechModuleHomology_hom_globalSmul f U hU
        (fun _ s => Stacks.Cech.inter_isAffineOpen f U hUaff s) G a d ξ).trans ha)
  rw [← hax]
  change ((Hfunctor X.ringCatSheaf ⊤ d).map
      (globalSmul ((Stacks.Cech.globalRingHom f).hom a) G) ≫ φ).hom ξ =
    ((Hfunctor X.ringCatSheaf ⊤ d).map
      (globalSmul ((Stacks.Cech.globalRingHom f).hom a) G) ≫ ψ).hom ξ
  rw [hφ, hψ, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
    AddMonoidHom.comp_apply, h]

end Generator

section TopDegree

attribute [local instance] Scheme.Hom.isQuasicoherent_relativeDifferentialForms

variable {A : Type u} [CommRing A] [IsNoetherianRing A] {X : Scheme.{u}}
  (f : X ⟶ Spec (.of A)) [IsProper f] (e : ℕ) [SmoothOfRelativeDimension (e + 1) f]
  [IsIso f.appTop] (σ : Spec (.of A) ⟶ X) (hσ : σ ≫ f = 𝟙 _)
  [IsClosedImmersion σ] [LocallyOfFinitePresentation σ] [Smooth (σ ≫ f)]
  [FormallyUnramified (σ ≫ f)]

/-- The diagonal Gysin map equals an `A`-linear map `ψ` (in degree `0 + n`) once they agree on
the Gysin class `ξ` of the section, which generates `Hⁿ(X, Ωⁿ_{X/A})`. -/
private theorem diagonalGysin_zero_add_eq_of_eq_class (hσ : σ ≫ f = 𝟙 _)
    (ψ : _ ⟶ (Hfunctor (pullback f f).ringCatSheaf ⊤ (0 + (e + 1) + (e + 1))).obj
      ((prodStructure f).relativeDifferentialForms
        (((0 + (e + 1) : ℕ) : ℤ) + ((e + 1 : ℕ) : ℤ))))
    (hψ : ∀ a, (Hfunctor X.ringCatSheaf ⊤ (0 + (e + 1))).map
        (globalSmul ((Stacks.Cech.globalRingHom f).hom a)
          (f.relativeDifferentialForms (((0 + (e + 1) : ℕ) : ℤ)))) ≫ ψ =
      ψ ≫ (Hfunctor (pullback f f).ringCatSheaf ⊤ (0 + (e + 1) + (e + 1))).map
        (globalSmul ((Stacks.Cech.globalRingHom (prodStructure f)).hom a)
          ((prodStructure f).relativeDifferentialForms
            (((0 + (e + 1) : ℕ) : ℤ) + ((e + 1 : ℕ) : ℤ)))))
    (h : (diagonalGysin f (e + 1) (0 + (e + 1)) (0 + (e + 1))).hom (sectionGysinClass f σ (e + 1)) =
      ψ.hom (sectionGysinClass f σ (e + 1))) :
    diagonalGysin f (e + 1) (0 + (e + 1)) (0 + (e + 1)) = ψ := by
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  exact hom_eq_of_span_eq_top f _ (0 + (e + 1)) (sectionGysinClass f σ (e + 1))
    (fun U hU hUaff => Stacks.Cech.span_sectionGysinClass_eq_top f e σ hσ U hU hUaff) _ _
    (fun a => (Hfunctor (pullback f f).ringCatSheaf ⊤ (0 + (e + 1) + (e + 1))).map
      (globalSmul ((Stacks.Cech.globalRingHom (prodStructure f)).hom a)
        ((prodStructure f).relativeDifferentialForms
          (((0 + (e + 1) : ℕ) : ℤ) + ((e + 1 : ℕ) : ℤ)))))
    (diagonalGysin_globalSmul f (e + 1) _ _) hψ h

include hσ in
/-- **The Gysin maps of the diagonal and of `j = (σ ∘ f, id)` agree in top degree**, in the degree
spelling `0 + n` of the Gysin class `ξ`: both are `A`-linear, they agree on `ξ`
(`Stacks.DeRham.CohomologicalGysin.formsGysinMap_diagonal_eq_sectionFst`), and `ξ` generates
`Hⁿ(X, Ωⁿ_{X/A})` (`Stacks.Cech.span_sectionGysinClass_eq_top`). -/
theorem diagonalGysin_eq_sectionFstGysin_zero_add :
    diagonalGysin f (e + 1) (0 + (e + 1)) (0 + (e + 1)) =
      sectionFstGysin f (e + 1) σ hσ (0 + (e + 1)) (0 + (e + 1)) :=
  diagonalGysin_zero_add_eq_of_eq_class f e σ hσ _ (sectionFstGysin_globalSmul f (e + 1) σ hσ _ _)
    (formsGysinMap_diagonal_eq_sectionFst f (e + 1) σ hσ)

include hσ in
/-- **The Gysin maps of the diagonal and of `j' = (id, σ ∘ f)` agree in top degree**, in the
degree spelling `0 + n` of the Gysin class `ξ`. On `ξ` this is
`Stacks.DeRham.CohomologicalGysin.formsGysinMap_diagonal_eq_sectionSnd`, once the ambient copy
along the diagonal is read along the second projection rather than the first
(`Stacks.DeRham.CohomologicalGysin.formRestriction_comp_retraction_eq`). -/
theorem diagonalGysin_eq_sectionSndGysin_zero_add :
    diagonalGysin f (e + 1) (0 + (e + 1)) (0 + (e + 1)) =
      sectionSndGysin f (e + 1) σ hσ (0 + (e + 1)) (0 + (e + 1)) := by
  refine diagonalGysin_zero_add_eq_of_eq_class f e σ hσ _
    (sectionSndGysin_globalSmul f (e + 1) σ hσ _ _) ?_
  have hr : ambientCopy f (prodStructure f) (pullback.diagonal f) (pullback.fst f f)
      (fst_comp_eq_prodStructure f) (0 + (e + 1)) (0 + (e + 1)) =
      ambientCopy f (prodStructure f) (pullback.diagonal f) (pullback.snd f f)
        (snd_comp_eq_prodStructure f) (0 + (e + 1)) (0 + (e + 1)) :=
    formRestriction_comp_retraction_eq (pullback.diagonal f) (prodStructure f) f
      (pullback.fst f f) (fst_comp_eq_prodStructure f) (pullback.diagonal_fst f)
      (by rw [prodStructure, pullback.diagonal_fst_assoc]) (pullback.snd f f)
      (snd_comp_eq_prodStructure f)
      (pullback.diagonal_snd f) 0 _ _ (by simp) _
  have hD : diagonalGysin f (e + 1) (0 + (e + 1)) (0 + (e + 1)) =
      ambientCopy f (prodStructure f) (pullback.diagonal f) (pullback.snd f f)
        (snd_comp_eq_prodStructure f) (0 + (e + 1)) (0 + (e + 1)) ≫
      (have := smooth_prodStructure f (e + 1)
       formsGysinMap (pullback.diagonal f) (prodStructure f)
        (diagonal_koszul_and_conormalRank f (e + 1)).1
        (diagonal_koszul_and_conormalRank f (e + 1)).2 (0 + (e + 1)) (0 + (e + 1))) :=
    congrArg (· ≫ _) hr
  exact (congrArg (fun φ => φ.hom (sectionGysinClass f σ (e + 1))) hD).trans
    (formsGysinMap_diagonal_eq_sectionSnd f (e + 1) σ hσ)

/-- **The Gysin maps of the diagonal and of `j = (σ ∘ f, id)` agree on
`Hⁿ(X, Ωⁿ_{X/A})`**, `n = e + 1`. -/
theorem diagonalGysin_top_eq_sectionFstGysin :
    diagonalGysin f (e + 1) (e + 1) (e + 1) = sectionFstGysin f (e + 1) σ hσ (e + 1) (e + 1) := by
  have h := diagonalGysin_eq_sectionFstGysin_zero_add f e σ hσ
  rwa [Nat.zero_add] at h

/-- **The Gysin maps of the diagonal and of `j' = (id, σ ∘ f)` agree on
`Hⁿ(X, Ωⁿ_{X/A})`**, `n = e + 1`. -/
theorem diagonalGysin_top_eq_sectionSndGysin :
    diagonalGysin f (e + 1) (e + 1) (e + 1) = sectionSndGysin f (e + 1) σ hσ (e + 1) (e + 1) := by
  have h := diagonalGysin_eq_sectionSndGysin_zero_add f e σ hσ
  rwa [Nat.zero_add] at h

/-! ### The vanishing of the top de Rham differential -/

/-- **The vanishing of the top de Rham differential, from the diagonal claim** (the case of
[Stacks, Tag 0G8J] with a section and `Γ(X, 𝒪_X) = A`). Let `A` be Noetherian,
`f : X ⟶ Spec A` proper and smooth of relative dimension `n = e + 1` with `A ⟶ Γ(X, 𝒪_X)`
bijective and with a section `σ`. If the Gysin map of the diagonal is the sum of those of
`j' = (id, σ ∘ f)` and `j = (σ ∘ f, id)` on `Hⁿ(X, Ω^{n-1}_{X/A})`, and `γ_j` is injective on
`Hⁿ(X, Ωⁿ_{X/A})`, then `d : Hⁿ(X, Ω^{n-1}_{X/A}) ⟶ Hⁿ(X, Ωⁿ_{X/A})` vanishes.

For `θ ∈ Hⁿ(X, Ω^{n-1})` the three Gysin maps commute with `d`, so applying `d` to the diagonal
claim gives `γ_Δ(dθ) = γ_{j'}(dθ) + γ_j(dθ)`; in top degree the three maps agree, so
`γ_j(dθ) = 2 γ_j(dθ)`, hence `γ_j(dθ) = 0` and `dθ = 0`. -/
theorem topDifferentialVanishes_of_diagonalClaim (hC : DiagonalClaim f e σ hσ)
    (hI : TopInjective f e σ hσ) :
    AlgebraicGeometry.TopDegreeDifferential.TopDifferentialVanishes f (e + 1) := by
  rw [AlgebraicGeometry.TopDegreeDifferential.topDifferentialVanishes_succ_iff_abelianHgroupMap]
  ext θ
  have hΔ := congrArg (fun k => k.hom θ) (diagonalGysin_comm_deRham f (e + 1) e (e + 1))
  have hj := congrArg (fun k => k.hom θ) (sectionFstGysin_comm_deRham f (e + 1) σ hσ e (e + 1))
  have hjs := congrArg (fun k => k.hom θ) (sectionSndGysin_comm_deRham f (e + 1) σ hσ e (e + 1))
  simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at hΔ hj hjs
  have hsum := congrArg (abelianHgroupMap (pullback f f).toRingedSpace (0 : ℤ)
    (((e + 1 : ℕ) : ℤ) + ((e + 1 : ℕ) : ℤ)) ((e + 1) + (e + 1)) (by omega)
    (ambientDeRhamShiftAbHom (prodStructure f) (e + 1) e)).hom (hC θ)
  rw [map_add, hΔ, hj, hjs, diagonalGysin_top_eq_sectionFstGysin f e σ hσ,
    ← diagonalGysin_top_eq_sectionSndGysin f e σ hσ,
    diagonalGysin_top_eq_sectionFstGysin f e σ hσ, left_eq_add] at hsum
  rw [AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply]
  have hfin := hI _ hsum
  exact hfin

end TopDegree

end Stacks.WeilDeRham

