/-! ### Top-degree injectivity over a ring -/

section TopDegree

variable {R : Type u} [CommRing R]

/-- **Tensoring with a generator is injective.** If `M₂` is generated by `e` and `φ₂ e` generates
`N`, then `φ₁ ⊗ φ₂ : M₁ ⊗ M₂ ⟶ N ⊗ N` is injective for every injective `φ₁`. -/
theorem injective_tensorMap_of_span_eq_top {M₁ M₂ N : Type u} [AddCommGroup M₁] [Module R M₁]
    [AddCommGroup M₂] [Module R M₂] [AddCommGroup N] [Module R N] (φ₁ : M₁ →ₗ[R] N)
    (φ₂ : M₂ →ₗ[R] N) (hφ₁ : Function.Injective φ₁) (e : M₂)
    (he : Submodule.span R {e} = ⊤) (hg : Submodule.span R {φ₂ e} = ⊤) :
    Function.Injective (TensorProduct.map φ₁ φ₂) := by
  have hsurj : ∀ τ : M₁ ⊗[R] M₂, ∃ m : M₁, m ⊗ₜ[R] e = τ := by
    intro τ
    induction τ using TensorProduct.inductionOn with
    | tmul m y =>
      have hy : y ∈ Submodule.span R {e} := he ▸ Submodule.mem_top
      obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.1 hy
      exact ⟨r • m, by rw [TensorProduct.smul_tmul]⟩
    | add τ τ' hτ hτ' =>
      obtain ⟨m, rfl⟩ := hτ
      obtain ⟨m', rfl⟩ := hτ'
      exact ⟨m + m', TensorProduct.add_tmul _ _ _⟩
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro τ hτ
  obtain ⟨m, rfl⟩ := hsurj τ
  rw [TensorProduct.map_tmul] at hτ
  have h := congrArg (TensorProduct.comm R N N) hτ
  rw [TensorProduct.comm_tmul, map_zero] at h
  have hm : φ₁ m = 0 :=
    Module.eq_zero_of_tmul_eq_zero_of_span_eq_top (φ₂ e) hg (φ₁ m) h
  rw [hφ₁ (hm.trans (map_zero φ₁).symm), TensorProduct.zero_tmul]

/-- The image of a generator under a surjective linear map is a generator. -/
private theorem span_singleton_eq_top_of_surjective {M M' : Type u} [AddCommGroup M] [Module R M]
    [AddCommGroup M'] [Module R M'] (φ : M →ₗ[R] M') (hφ : Function.Surjective φ) {x : M}
    (hx : Submodule.span R {x} = ⊤) : Submodule.span R {φ x} = ⊤ := by
  rw [← Set.image_singleton, ← Submodule.map_span, hx, Submodule.map_top, LinearMap.range_eq_top]
  exact hφ

/-- **Top-degree injectivity of tensoring with a morphism.** Let `K, N ∈ D^{≤ n}(R)`, let
`v : N ⟶ K`, and let `e` generate `Hⁿ(N)` with `Hⁿ(v)(e)` generating `Hⁿ(K)`. Then
`H^{2n}(K ⊗^𝐋 v) : H^{2n}(K ⊗^𝐋 N) ⟶ H^{2n}(K ⊗^𝐋 K)` is injective: in the top degree both sides
are `Hⁿ(K) ⊗ Hⁿ(-)` ([Stacks, Tag 068H]), and there the map is `x ⊗ e ↦ x ⊗ Hⁿ(v)(e)`. -/
theorem injective_homology_map_tensor_top (n : ℤ) (K N : DerivedCategory (ModuleCat.{u} R))
    [K.IsLE n] [N.IsLE n] (v : N ⟶ K)
    (e : (DerivedCategory.homologyFunctor (ModuleCat.{u} R) n).obj N)
    (he : Submodule.span R {e} = ⊤)
    (hg : Submodule.span R
      {((DerivedCategory.homologyFunctor (ModuleCat.{u} R) n).map v).hom e} = ⊤) :
    Function.Injective ((DerivedCategory.homologyFunctor (ModuleCat.{u} R) (n + n)).map
      (((CochainComplex.DerivedTensor.canonicalDerivedTensorProductFunctor R).obj K).map
        v)).hom := by
  obtain ⟨P, hP, hPn, ⟨eK⟩⟩ := StacksDraft.TorAmplitude.exists_projective_representative_of_isLE
    K n ((DerivedCategory.isLE_iff K n).1 inferInstance)
  obtain ⟨Q₀, hQ, hQn, ⟨eN⟩⟩ :=
    StacksDraft.TorAmplitude.exists_projective_representative_of_isLE
      N n ((DerivedCategory.isLE_iff N n).1 inferInstance)
  have := hPn
  have := hQn
  have : ∀ i, Projective (P.X i) := hP
  have : ∀ i, Projective (Q₀.X i) := hQ
  have : P.IsKProjective := CochainComplex.isKProjective_of_projective P n
  have : Q₀.IsKProjective := CochainComplex.isKProjective_of_projective Q₀ n
  have hPf : P.KFlat := CochainComplex.DerivedTensor.kFlat_of_projective_isStrictlyLE P n hP
  have hQf : Q₀.KFlat := CochainComplex.DerivedTensor.kFlat_of_projective_isStrictlyLE Q₀ n hQ
  have : (DerivedCategory.Q.obj P).IsLE n := DerivedCategory.TStructure.t.isLE_of_iso eK n
  have : (DerivedCategory.Q.obj Q₀).IsLE n := DerivedCategory.TStructure.t.isLE_of_iso eN n
  let T := CochainComplex.DerivedTensor.canonicalDerivedTensorProductFunctor R
  let H := fun k : ℤ => DerivedCategory.homologyFunctor (ModuleCat.{u} R) k
  have hnat := RingTheory.TorProducts.cohomologyTensorProduct_naturality_of_isKProjective P Q₀
    hPf hQf eK.inv (eN.inv ≫ v) n n
  have hKK := CochainComplex.Kunneth.isIso_cohomologyTensorProduct_map_top K K n n
  have hPQ := CochainComplex.Kunneth.isIso_cohomologyTensorProduct_map_top
    (DerivedCategory.Q.obj P) (DerivedCategory.Q.obj Q₀) n n
  have hcomp : ((RingTheory.TorProducts.cohomologyTensorProduct (DerivedCategory.Q.obj P)
      (DerivedCategory.Q.obj Q₀) n n).map ≫ (H (n + n)).map
        ((T.map eK.inv).app (DerivedCategory.Q.obj Q₀) ≫ (T.obj K).map eN.inv)) ≫
      (H (n + n)).map ((T.obj K).map v) =
      ((H n).map eK.inv ⊗ₘ (H n).map (eN.inv ≫ v)) ≫
        (RingTheory.TorProducts.cohomologyTensorProduct K K n n).map := by
    rw [hnat, Category.assoc, ← Functor.map_comp, Category.assoc, ← Functor.map_comp]
  have hinj : Function.Injective (((H n).map eK.inv ⊗ₘ (H n).map (eN.inv ≫ v)) ≫
      (RingTheory.TorProducts.cohomologyTensorProduct K K n n).map).hom := by
    rw [ModuleCat.hom_comp, LinearMap.coe_comp]
    refine ((ConcreteCategory.bijective_of_isIso _).1).comp ?_
    rw [ModuleCat.hom_tensorHom]
    refine injective_tensorMap_of_span_eq_top _ _
      ((ConcreteCategory.bijective_of_isIso ((H n).map eK.inv)).1) (((H n).map eN.hom).hom e)
      ?_ ?_
    · exact span_singleton_eq_top_of_surjective _
        (ConcreteCategory.bijective_of_isIso ((H n).map eN.hom)).2 he
    · have h₁ : ((H n).map (eN.inv ≫ v)).hom (((H n).map eN.hom).hom e) =
          ((H n).map v).hom e := by
        rw [← ModuleCat.comp_apply, ← Functor.map_comp, ← Category.assoc, Iso.hom_inv_id,
          Category.id_comp]
      rwa [h₁]
  refine (Function.Injective.of_comp_iff' _ (ConcreteCategory.bijective_of_isIso
    ((RingTheory.TorProducts.cohomologyTensorProduct (DerivedCategory.Q.obj P)
      (DerivedCategory.Q.obj Q₀) n n).map ≫ (H (n + n)).map
        ((T.map eK.inv).app (DerivedCategory.Q.obj Q₀) ≫ (T.obj K).map eN.inv)))).1 ?_
  rw [← LinearMap.coe_comp, ← ModuleCat.hom_comp, hcomp]
  exact hinj

/-- A multiple of `y` generating the module forces `y` to generate it. -/
private theorem span_singleton_eq_top_of_smul {M : Type u} [AddCommGroup M] [Module R M] (r : R)
    (y : M)
    (h : Submodule.span R {r • y} = ⊤) : Submodule.span R {y} = ⊤ :=
  top_le_iff.1 (h ▸ Submodule.span_le.2 (Set.singleton_subset_iff.2
    (Submodule.smul_mem _ r (Submodule.mem_span_singleton_self y))))

/-- The class of `1` generates `Hⁿ(R[-n])`. -/
private theorem exists_span_homology_single_eq_top (n : ℤ) :
    ∃ e : (DerivedCategory.homologyFunctor (ModuleCat.{u} R) n).obj
        ((DerivedCategory.singleFunctor (ModuleCat.{u} R) n).obj (ModuleCat.of R R)),
      Submodule.span R {e} = ⊤ :=
  ⟨((DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{u} R) n).inv.app
      (ModuleCat.of R R)).hom (1 : R),
    span_singleton_eq_top_of_surjective _ (ConcreteCategory.bijective_of_isIso
      ((DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{u} R) n).inv.app
        (ModuleCat.of R R))).2 (x := (1 : R)) (Ideal.span_singleton_one)⟩

end TopDegree

/-! ### Elementwise bookkeeping -/

section Elementwise

variable {C : Type*} [Category C] {R : Type u} [Ring R] (H : C ⥤ ModuleCat.{u} R)


/-- `H` of an isomorphism has trivial kernel. -/
private theorem eq_zero_of_map_hom_eq_zero {P Q : C} (x : P ⟶ Q) (hx : IsIso x) {z : H.obj P}
    (hz : (H.map x).hom z = 0) : z = 0 :=
  (ConcreteCategory.bijective_of_isIso (H.map x)).1 (hz.trans (map_zero _).symm)

/-- An element killed by `H (x ≫ y)` with `y` invertible is killed by `H x`. -/
private theorem map_hom_eq_zero_of_comp {P Q Z : C} (x : P ⟶ Q) (y : Q ⟶ Z) (w : P ⟶ Z)
    (hy : IsIso y) (h : x ≫ y = w) {z : H.obj P} (hz : (H.map w).hom z = 0) :
    (H.map x).hom z = 0 := by
  subst h
  rw [map_comp_hom_apply] at hz
  exact eq_zero_of_map_hom_eq_zero H y hy hz

/-- An element killed by `H x` is killed by `H (x ≫ y)`. -/
private theorem map_hom_eq_zero_comp {P Q Z : C} (x : P ⟶ Q) (y : Q ⟶ Z) (w : P ⟶ Z)
    (h : x ≫ y = w) {z : H.obj P} (hz : (H.map x).hom z = 0) : (H.map w).hom z = 0 := by
  subst h
  rw [map_comp_hom_apply, hz, map_zero]

end Elementwise

/-! ### Restriction along a section kills nothing in the top degree -/

section Core

variable {S X W : RingedSpace.{u, u}}

/-- **Injectivity of the cup with `t` through the restriction to a section, on ringed spaces.**
In the situation of `Stacks.WeilDeRham.homology_map_tensor_eq_of_pullbackSections_eq`, assume
moreover that `RΓ(X, K)` lies in degrees `≤ n`, that some class `Hⁿ(RΓ(X, t))(z)` generates
`Hⁿ(RΓ(X, K))`, and that the Künneth map through `W` at `(K, K)` is invertible. Then a class `w`
of `H^{2n}(RΓ(W, Lq^*K ⊗^𝐋 Lp^*O))` with `(1 ⊗ Lp^*t)(w) = 0` restricts to zero along `j`. -/
theorem pullbackSections_eq_zero_of_homology_map_tensor_eq_zero (a : X ⟶ S) (σ : S ⟶ X)
    (hσ : σ ≫ a = 𝟙 S) (q p : W ⟶ X) (g : W ⟶ S) (hq : q ≫ a = g) (hp : p ≫ a = g)
    (j : X ⟶ W) (hjq : j ≫ q = 𝟙 X) (hjp : j ≫ p = a ≫ σ) (n : ℕ)
    (K O : DerivedCategory (SheafOfModules.{u} (structureSheafRing X)))
    (OS : DerivedCategory (SheafOfModules.{u} (structureSheafRing S)))
    (e : (derivedPullback σ).obj O ≅ OS) (ea : (derivedPullback a).obj OS ≅ O)
    (E : (sectionsOverBase (σ ≫ a)).obj OS ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} (baseRing S)) (n : ℤ)).obj
        (ModuleCat.of (baseRing S) (baseRing S)))
    (hκW : IsIso (kunnethGlobalMapCanonical a a q p g hq hp K O))
    (hκK : IsIso (kunnethGlobalMapCanonical a a q p g hq hp K K))
    [((sectionsOverBase a).obj K).IsLE (n : ℤ)] (t : O ⟶ K)
    (hvan : ∀ (u : (DerivedCategory.singleFunctor (ModuleCat.{u} (baseRing S)) (n : ℤ)).obj
        (ModuleCat.of (baseRing S) (baseRing S)) ⟶ (sectionsOverBase a).obj O)
      (s : (sectionsOverBase a).obj O ⟶
        (DerivedCategory.singleFunctor (ModuleCat.{u} (baseRing S)) (n : ℤ)).obj
          (ModuleCat.of (baseRing S) (baseRing S))),
      u ≫ s = 𝟙 _ → s ≫ u ≫ (sectionsOverBase a).map t = (sectionsOverBase a).map t)
    (z : (DerivedCategory.homologyFunctor (ModuleCat.{u} (baseRing S)) (n : ℤ)).obj
      ((sectionsOverBase a).obj O))
    (hz : Submodule.span (baseRing S)
      {((DerivedCategory.homologyFunctor (ModuleCat.{u} (baseRing S)) (n : ℤ)).map
      ((sectionsOverBase a).map t)).hom z} = ⊤)
    (w : (DerivedCategory.homologyFunctor (ModuleCat.{u} (baseRing S)) ((n : ℤ) + (n : ℤ))).obj
      ((sectionsOverBase g).obj (((derivedTensorProductFunctor W.sheaf).obj
        ((derivedPullback q).obj K)).obj ((derivedPullback p).obj O))))
    (hw : ((DerivedCategory.homologyFunctor (ModuleCat.{u} (baseRing S)) ((n : ℤ) + (n : ℤ))).map
        ((sectionsOverBase g).map (((derivedTensorProductFunctor W.sheaf).obj
          ((derivedPullback q).obj K)).map ((derivedPullback p).map t)))).hom w = 0) :
    ((DerivedCategory.homologyFunctor (ModuleCat.{u} (baseRing S)) ((n : ℤ) + (n : ℤ))).map
        (pullbackSections g j (j ≫ g) rfl (((derivedTensorProductFunctor W.sheaf).obj
          ((derivedPullback q).obj K)).obj ((derivedPullback p).obj O)))).hom w = 0 := by
  obtain ⟨d, hd⟩ := (ConcreteCategory.bijective_of_isIso
    ((DerivedCategory.homologyFunctor (ModuleCat.{u} (baseRing S)) ((n : ℤ) + (n : ℤ))).map
      (kunnethGlobalMapCanonical a a q p g hq hp K O))).2 w
  subst hd
  -- naturality in the second variable and the Künneth map at `(K, K)`
  have hnat : ((tensorBase S).obj ((sectionsOverBase a).obj K)).map ((sectionsOverBase a).map t) ≫
      kunnethGlobalMapCanonical a a q p g hq hp K K =
      kunnethGlobalMapCanonical a a q p g hq hp K O ≫
        (sectionsOverBase g).map (((derivedTensorProductFunctor W.sheaf).obj
          ((derivedPullback q).obj K)).map ((derivedPullback p).map t)) :=
    kunnethGlobalMap_naturality_right a a q p g hq hp (globalCupProductCanonical S) K t
  have h₂ := map_hom_eq_zero_of_comp _ _ _ _ hκK hnat ((map_comp_hom_apply _ _ _ d).trans hw)
  -- the vanishing
  have hex := exists_comp_pullbackSections_section_eq_id a σ hσ O OS _ e ea E
  obtain ⟨u, hus⟩ := hex
  have hv := hvan u _ hus
  have h₃ := (congrArg (fun φ => ((DerivedCategory.homologyFunctor (ModuleCat.{u} (baseRing S))
    ((n : ℤ) + (n : ℤ))).map (((tensorBase S).obj ((sectionsOverBase a).obj K)).map φ)).hom d)
      hv).trans h₂
  have h₃' := (map_comp_hom_apply _ _ _ d).symm.trans
    ((congrArg (fun ψ => ((DerivedCategory.homologyFunctor (ModuleCat.{u} (baseRing S))
      ((n : ℤ) + (n : ℤ))).map ψ).hom d) (Functor.map_comp _ _ _)).symm.trans h₃)
  -- the top degree
  have hex₀ := exists_span_homology_single_eq_top (R := baseRing S) (n : ℤ)
  have he₀ := hex₀.choose_spec
  have hsz : ((DerivedCategory.homologyFunctor (ModuleCat.{u} (baseRing S)) (n : ℤ)).map
      ((pullbackSections a σ (σ ≫ a) rfl O ≫ (sectionsOverBase (σ ≫ a)).map e.hom) ≫
        E.hom)).hom z ∈ Submodule.span (baseRing S) {hex₀.choose} := by
    rw [he₀]
    exact Submodule.mem_top
  have hr := Submodule.mem_span_singleton.1 hsz
  have hg : Submodule.span (baseRing S)
      {((DerivedCategory.homologyFunctor (ModuleCat.{u} (baseRing S)) (n : ℤ)).map
        (u ≫ (sectionsOverBase a).map t)).hom hex₀.choose} = ⊤ := by
    refine span_singleton_eq_top_of_smul hr.choose _ ?_
    rw [← map_smul, hr.choose_spec, ← map_comp_hom_apply, hv]
    exact hz
  have h₄ := injective_homology_map_tensor_top (n : ℤ) ((sectionsOverBase a).obj K) _
    (u ≫ (sectionsOverBase a).map t) hex₀.choose he₀ hg (h₃'.trans (map_zero _).symm)
  -- the pullback along the section
  have hiso : IsIso (((tensorBase S).obj ((sectionsOverBase a).obj K)).map
      ((sectionsOverBase (σ ≫ a)).map e.hom ≫ E.hom)) :=
    (((tensorBase S).obj ((sectionsOverBase a).obj K)).mapIso
      ((sectionsOverBase (σ ≫ a)).mapIso e ≪≫ E)).isIso_hom
  have h₅ := map_hom_eq_zero_of_comp _ (((tensorBase S).obj ((sectionsOverBase a).obj K)).map
      (pullbackSections a σ (σ ≫ a) rfl O)) _ _ hiso
    (by simp only [← Functor.map_comp, Category.assoc]) h₄
  have hq₂ : (a ≫ σ) ≫ a = a := by rw [Category.assoc, hσ, Category.comp_id]
  have hq' : a ≫ σ ≫ a = a := by rw [hσ, Category.comp_id]
  have hpr := kunnethGlobalMapCanonical_precomp_right a a (𝟙 X) a (Category.id_comp a) σ a hq' K O
  have h₆ := map_hom_eq_zero_comp _ _ _ _ hpr.symm h₅
  have h₇ := ((kunnethGlobalMapCanonical_homology_eq_iff a a (by rw [Category.assoc, hq])
    (by rw [Category.assoc, hp]) (Category.id_comp a) hq₂ hjq hjp K O _ d 0).2
      (h₆.trans (map_zero _).symm)).trans (map_zero _)
  -- the restriction along `j`
  have hKP := kunnethGlobalMapCanonical_comp_pullbackSections a a q p g hq hp j K O
  have hc : IsIso ((Stacks.Cohomology.DerivedProjectionFormula.pullbackTensorComparison j).app
      ((derivedPullback q).obj K, (derivedPullback p).obj O)) :=
    Stacks.Cohomology.DerivedProjectionFormula.isIso_pullbackTensorComparison_app j _
  have hR' : IsIso ((sectionsOverBase (j ≫ g)).map
      ((Stacks.Cohomology.DerivedProjectionFormula.pullbackTensorComparison j).app
          ((derivedPullback q).obj K, (derivedPullback p).obj O) ≫
        (Functor.uncurry.obj (derivedTensorProductFunctor X.sheaf)).map
          ((Stacks.DerivedPullback.Composition.derivedPullbackCompIsoCanonical j q).hom.app K ×ₘ
            (Stacks.DerivedPullback.Composition.derivedPullbackCompIsoCanonical j p).hom.app
              O))) :=
    ((sectionsOverBase (j ≫ g)).mapIso
      (asIso ((Stacks.Cohomology.DerivedProjectionFormula.pullbackTensorComparison j).app
          ((derivedPullback q).obj K, (derivedPullback p).obj O)) ≪≫
        (Functor.uncurry.obj (derivedTensorProductFunctor X.sheaf)).mapIso
          (Iso.prod ((Stacks.DerivedPullback.Composition.derivedPullbackCompIsoCanonical j q).app
            K) ((Stacks.DerivedPullback.Composition.derivedPullbackCompIsoCanonical j p).app
              O)))).isIso_hom
  have h₈ := (map_comp_hom_apply _ _ _ d).symm.trans
    ((congrArg (fun φ => ((DerivedCategory.homologyFunctor (ModuleCat.{u} (baseRing S))
      ((n : ℤ) + (n : ℤ))).map φ).hom d) hKP).trans h₇)
  exact map_hom_eq_zero_of_comp _ _ _ _ hR' rfl h₈

end Core

/-! ### The cup product with a represented class, with explicit factors -/

section Cup

open Stacks.DeRham.CohomologicalGysin Stacks.DeRham.GysinCupHodge
open Stacks.SheafOfModules.Tensor (sheafTensor)
open Stacks.Cohomology.DerivedGlobalCupProduct (cohomologyModule)
open AlgebraicGeometry.SheafOfModules (moduleDerived canonicalPairingModule tensorBifunctorNat
  baseRingedSpace multiplicationInt)
open Stacks.DerivedTensor.RingedSite (canonicalDerivedTensorProduct)
open _root_.Stacks.DerivedCategory _root_.AlgebraicGeometry.DerivedCategory
  _root_.CategoryTheory.DerivedCategory

attribute [local implicit_reducible] TopCat.Sheaf CategoryTheory.sheafCompose
  Stacks.SheafOfModules.Tensor.ringSheaf

attribute [local instance] Stacks.Topology.RingedSpaceSheafifyOpens.opensHasSheafifyAddCommGrpCat
  Stacks.Topology.RingedSpaceSheafifyOpens.opensWEqualsLocallyBijectiveAddCommGrpCat
attribute [local instance] Stacks.DeRham.CohomologicalGysin.moduleSheavesHasDerivedCategory
attribute [local instance] AlgebraicGeometry.SheafOfModules.abelianModules
  AlgebraicGeometry.SheafOfModules.hasSheafifyOpens
  AlgebraicGeometry.SheafOfModules.wEqualsLocallyBijectiveOpens

variable {X : RingedSpace.{u, u}}

/-- **Right multiplication by `1` is the inverse right unitor** `G ≅ G ⊗ 𝒪`. -/
theorem rightMulUnit_eq (G : _root_.SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} X.sheaf)) :
    rightMulUnit (X := X) G =
      (AlgebraicGeometry.SheafOfModules.tensorSheafUnitRightIso X G).inv := by
  ext U x
  exact (AlgebraicGeometry.SheafOfModules.tensorSheafUnitRightIso_inv_app X G U x).symm

/-- Right multiplication by `1` is an isomorphism. -/
instance isIso_rightMulUnit (G : _root_.SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} X.sheaf)) :
    IsIso (rightMulUnit (X := X) G) := by
  rw [rightMulUnit_eq]
  exact Iso.isIso_inv _

/-- **The first factor `G[-n] ⟶ G[0] ⊗^𝐋 𝒪[-n]` of the cup product is an isomorphism.** -/
theorem isIso_cupEdgeLeft (G : _root_.SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} X.sheaf)) (n : ℕ) :
    IsIso (cupEdgeLeft G n) := by
  have a1 : IsIso ((DerivedCategory.singleFunctor
      (_root_.SheafOfModules.{u} (structureSheafRing X)) (n : ℤ)).map (rightMulUnit G)) :=
    ((DerivedCategory.singleFunctor _ (n : ℤ)).mapIso (asIso (rightMulUnit G))).isIso_hom
  have a2 : IsIso (((derivedTensorProductFunctor (baseRingedSpace X.sheaf).sheaf).obj
        (moduleDerived (A := X.sheaf) (singleNat G 0))).map
          (moduleDerivedSingleIso (X := X) (unitModule X) n).hom) :=
    (((derivedTensorProductFunctor (baseRingedSpace X.sheaf).sheaf).obj
        (moduleDerived (A := X.sheaf) (singleNat G 0))).mapIso
          (moduleDerivedSingleIso (X := X) (unitModule X) n)).isIso_hom
  unfold cupEdgeLeft moduleDerivedMap
  exact IsIso.comp_isIso' (Iso.isIso_inv _) (IsIso.comp_isIso'
    (IsIso.comp_isIso' (Iso.isIso_hom _) (IsIso.comp_isIso' a1 (Iso.isIso_inv _)))
    (IsIso.comp_isIso' (Iso.isIso_inv _) a2))




/-- **The cup product with the class of a morphism `𝒪[-n] ⟶ L[0]`, with explicit factors**: the
statement of `Stacks.WeilDeRham.exists_cup_eq_cohomologyMapOfSingleHom` at its witnesses
`cupEdgeLeft` and `cupEdgeRight` and the sign `(-1)^{n·n}`. -/
theorem cup_eq_cohomologyMapOfSingleHom_cupEdge (G L : _root_.SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} X.sheaf)) (n : ℕ)
    (eL : (DerivedCategory.singleFunctor (_root_.SheafOfModules.{u} (structureSheafRing X))
          (n : ℤ)).obj (unitModule X) ⟶
        (DerivedCategory.singleFunctor (_root_.SheafOfModules.{u} (structureSheafRing X))
          ((0 : ℕ) : ℤ)).obj L)
    (ε : Hgroup (structureSheafRing X) ⊤ n G) :
    (canonicalPairingModule (A := X.sheaf)
        (singleTensorMult (X := X) (𝟙 (((sheafTensor.{u, u, u, u, u} X.sheaf).obj G).obj L))
          0 0 0 rfl) (n : ℤ) (n : ℤ)).hom
        ((hgroupModuleShiftIso (X := X) G 0 n n (by simp)).hom ε ⊗ₜ
          (hgroupModuleShiftIso (X := X) L 0 (0 + n) n (by simp)).hom
            (cohomologyMapOfSingleHom X (unitModule X) L n 0 eL (sectionClass unitSection))) =
      ((n : ℤ) * (n : ℤ)).negOnePow •
        (hgroupModuleShiftIso (X := X) (((sheafTensor.{u, u, u, u, u} X.sheaf).obj G).obj L) 0
          (n + n) ((n : ℤ) + (n : ℤ)) (by push_cast; ring)).hom
        (cohomologyMapOfSingleHom X G _ n n
          (cupEdgeLeft G n ≫ ((derivedTensorProductFunctor (baseRingedSpace X.sheaf).sheaf).obj
            (moduleDerived (A := X.sheaf) (singleNat G 0))).map eL ≫ cupEdgeRight G L) ε) := by
  let dT := derivedTensorProductFunctor (baseRingedSpace X.sheaf).sheaf
  let F₀ := moduleDerived (A := X.sheaf) (singleNat G 0)
  let r := rightMulTensor (X := X)
    (𝟙 (((sheafTensor.{u, u, u, u, u} X.sheaf).obj G).obj (unitModule X))) unitSection
  let hG := moduleDerivedSingleIso (X := X) G 0
  have hb := hgroupModuleShiftIso_cohomologyMapOfSingleHom (X := X) (unitModule X) L n 0 (n : ℤ)
    (by simp) (by simp) eL (sectionClass unitSection)
  rw [hb]
  refine Eq.trans ?_ (congrArg _ (hgroupModuleShiftIso_cohomologyMapOfSingleHom (X := X) G
    (((sheafTensor.{u, u, u, u, u} X.sheaf).obj G).obj L) n n ((n : ℤ) + (n : ℤ)) rfl
    (by push_cast; ring) _ ε).symm)
  -- the cup product with the class of `1` placed in degree `n`
  have hS := canonicalPairingModule_sectionClass (X := X)
    (𝟙 (((sheafTensor.{u, u, u, u, u} X.sheaf).obj G).obj (unitModule X))) unitSection n n ε
  have hN := hgroupModuleShiftIso_naturality (X := X) r n n ((n : ℤ) + (n : ℤ)) rfl ε
  rw [hN] at hS
  have hS' := congrArg (derivedSectionsHomologyMap ((n : ℤ) + (n : ℤ))
    (unitTensorComparisonIso G n).inv).hom hS
  replace hS' := hS'.trans (moduleCat_hom_units_smul _ _ _)
  have hT : ∀ z, (derivedSectionsHomologyMap ((n : ℤ) + (n : ℤ))
      (unitTensorComparisonIso G n).inv).hom
        ((derivedSectionsHomologyMap ((n : ℤ) + (n : ℤ)) (unitTensorComparison G n)).hom z) = z :=
    fun z => ConcreteCategory.congr_hom (((DerivedCategory.homologyFunctor
      (ModuleCat.{u} (baseRing (baseRingedSpace X.sheaf))) ((n : ℤ) + (n : ℤ))).mapIso
        ((baseSections (baseRingedSpace X.sheaf)).mapIso
          (unitTensorComparisonIso G n))).hom_inv_id) z
  rw [show (canonicalPairingModule (A := X.sheaf) (singleTensorMult (X := X)
      (𝟙 (((sheafTensor.{u, u, u, u, u} X.sheaf).obj G).obj (unitModule X))) 0 n n (zero_add n))
      (n : ℤ) (n : ℤ)) = _ from rfl] at hS'
  have hP := (hT ((Stacks.Cohomology.DerivedGlobalCupProduct.cupPairing
    (Stacks.Cohomology.DerivedGlobalCupProduct.cupProductOnSpace (baseRingedSpace X.sheaf))
    (moduleDerived (A := X.sheaf) (singleNat G 0))
    (moduleDerived (A := X.sheaf) (singleNat (unitModule X) n)) (n : ℤ) (n : ℤ)).hom
      ((hgroupModuleShiftIso (X := X) G 0 n n (by simp)).hom ε ⊗ₜ
        (hgroupModuleShiftIso (X := X) (unitModule X) n 0 (n : ℤ) (by simp)).hom
          (sectionClass unitSection)))).symm.trans hS'
  refine (congrArg (derivedSectionsHomologyMap ((n : ℤ) + (n : ℤ))
    (identityTensorComparison G L)).hom (cupPairing_naturality_right_apply
      (Stacks.Cohomology.DerivedGlobalCupProduct.cupProductOnSpace (baseRingedSpace X.sheaf))
      (moduleDerivedMap eL) (n : ℤ) (n : ℤ) _ _)).trans ?_
  refine Eq.trans (congrArg (ModuleCat.Hom.hom _) (congrArg (ModuleCat.Hom.hom _) hP)) ?_
  refine (congrArg (ModuleCat.Hom.hom _) (moduleCat_hom_units_smul _ _ _)).trans ?_
  refine (moduleCat_hom_units_smul _ _ _).trans ?_
  refine congrArg (((n : ℤ) * (n : ℤ)).negOnePow • ·) ?_
  have h := congrArg (baseSections (baseRingedSpace X.sheaf) ⋙ DerivedCategory.homologyFunctor
    (ModuleCat.{u} (baseRing (baseRingedSpace X.sheaf))) ((n : ℤ) + (n : ℤ))).map
      ((moduleDerivedMap_cupEdge G L n eL).trans (congrArg (fun t =>
        moduleDerivedMap ((DerivedCategory.singleFunctor _ (n : ℤ)).map (rightMulUnit G)) ≫
          (unitTensorComparisonIso G n).inv ≫ t ≫ identityTensorComparison G L)
        (Stacks.Cohomology.DerivedProjectionFormula.uncurry_map_id_left
          (derivedTensorProductFunctor (baseRingedSpace X.sheaf).sheaf)
          (moduleDerived (A := X.sheaf) (singleNat G 0)) (moduleDerivedMap eL)).symm))
  exact (functor_map_comp_four_apply (baseSections (baseRingedSpace X.sheaf) ⋙
    DerivedCategory.homologyFunctor (ModuleCat.{u} (baseRing (baseRingedSpace X.sheaf)))
      ((n : ℤ) + (n : ℤ))) _ _ _ _ _).symm.trans
    (ConcreteCategory.congr_hom h ((hgroupModuleShiftIso (X := X) G n n
      ((n : ℤ) + (n : ℤ)) rfl).hom ε)).symm


/-- **The last factor `G[0] ⊗^𝐋 L[0] ⟶ (G ⊗ L)[0]` of the cup product is an isomorphism when `L`
is flat**: `L[0]` is then K-flat, so the derived tensor product is the total tensor complex. -/
theorem isIso_cupEdgeRight (G L : _root_.SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf.{u, u, u} X.sheaf))
    (hL : AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := X.sheaf) L) :
    IsIso (cupEdgeRight G L) := by
  have hK : Stacks.SheafOfModules.KFlat X.sheaf
      ((singleNat L 0).extend ComplexShape.embeddingUpNat) :=
    CochainComplex.KFlatBifunctor.KFlat.of_iso (sheafTensor.{u, u, u, u, u} X.sheaf)
      (Stacks.SheafOfModules.KFlatResolution.kFlat_single_of_isFlat X.sheaf L hL 0)
      (extendSingleIsoNat L 0).symm
  have h₁ : IsIso ((canonicalDerivedTensorProduct (baseRingedSpace X.sheaf).sheaf).toTensor
      ((singleNat G 0).extend ComplexShape.embeddingUpNat)
      ((singleNat L 0).extend ComplexShape.embeddingUpNat)) :=
    isIso_toTensor_of_kFlat_right _ _ _ hK
  have h₂ : IsIso (DerivedCategory.Q.map (multiplicationInt (singleTensorMult
      (𝟙 (((sheafTensor.{u, u, u, u, u} X.sheaf).obj G).obj L)) 0 0 0 rfl))) :=
    @Functor.map_isIso _ _ _ _ _ _ _ _ (isIso_multiplicationInt_singleTensorMult_id G L 0)
  have h₀ : IsIso (((derivedTensorProductFunctor (baseRingedSpace X.sheaf).sheaf).obj
      (moduleDerived (A := X.sheaf) (singleNat G 0))).map
        (moduleDerivedSingleIso (X := X) L 0).inv) :=
    (((derivedTensorProductFunctor (baseRingedSpace X.sheaf).sheaf).obj
      (moduleDerived (A := X.sheaf) (singleNat G 0))).mapIso
        (moduleDerivedSingleIso (X := X) L 0).symm).isIso_hom
  unfold cupEdgeRight identityTensorComparison
  exact IsIso.comp_isIso' h₀ (IsIso.comp_isIso' (IsIso.comp_isIso' h₁ h₂) (Iso.isIso_hom _))

end Cup

/-! ### Top-degree injectivity of the cup product on `X ×_A X` -/

section Forms

open AlgebraicGeometry.Scheme.Hom
open Stacks.DeRham.CohomologicalGysin Stacks.DeRham.GysinCupHodge

attribute [local implicit_reducible] TopCat.Sheaf CategoryTheory.sheafCompose
  Stacks.SheafOfModules.Tensor.ringSheaf

attribute [local instance] Stacks.Topology.RingedSpaceSheafifyOpens.opensHasSheafifyAddCommGrpCat
  Stacks.Topology.RingedSpaceSheafifyOpens.opensWEqualsLocallyBijectiveAddCommGrpCat
attribute [local instance] Stacks.DeRham.CohomologicalGysin.moduleSheavesHasDerivedCategory
attribute [local instance] AlgebraicGeometry.SheafOfModules.abelianModules
  AlgebraicGeometry.SheafOfModules.hasSheafifyOpens
  AlgebraicGeometry.SheafOfModules.wEqualsLocallyBijectiveOpens

variable {A : Type u} [CommRing A] {X : Scheme.{u}} (f : X ⟶ Spec (.of A))

/-- `Hⁿ(RΓ_S(X, Ωⁿ))` as a module over `Γ(Spec A, 𝒪)`. -/
abbrev topFormsSections (n : ℕ) : ModuleCat.{u} (baseRing (Spec (.of A)).toRingedSpace) :=
  (DerivedCategory.homologyFunctor _ (n : ℤ)).obj
    ((Stacks.Cohomology.GlobalKunneth.sectionsOverBase f.toLRSHom.toShHom).obj
      ((DerivedCategory.singleFunctor (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
        (((0 : ℕ) : ℤ))).obj (relativeDifferentialForms f (n : ℤ))))

/-- An element of the underlying group, read in the module. -/
abbrev asTopForms (n : ℕ)
    (z : (forget₂ (ModuleCat.{u} (baseRing (Spec (.of A)).toRingedSpace)) AddCommGrpCat.{u}).obj
      (topFormsSections f n)) : topFormsSections f n := z

/-- **Top-degree injectivity of the cup product with `p₁^*ξ`**: if every class of
`Hⁿ(X, Ωⁿ_{X/A})` is a multiple of `ξ`, read in `Hⁿ(RΓ_S(X, Ωⁿ))`, then
`x ↦ p₂^*x ∪ p₁^*ξ`, `Hⁿ(X, Ωⁿ) ⟶ H^{2n}(X ×_A X, p₂^*Ωⁿ ⊗ p₁^*Ωⁿ)`, is injective. -/
def PullbackCupTopInjective (n : ℕ)
    (ξ : Hgroup (structureSheafRing X.toRingedSpace) ⊤ n (relativeDifferentialForms f (n : ℤ))) :
    Prop :=
  (∀ x : Hgroup (structureSheafRing X.toRingedSpace) ⊤ n (relativeDifferentialForms f (n : ℤ)),
    ∃ r : baseRing (Spec (.of A)).toRingedSpace,
      asTopForms f n ((hgroupSectionsOverBaseIso f.toLRSHom.toShHom
        (relativeDifferentialForms f (n : ℤ)) 0 n n (by simp)).hom x) =
      r • asTopForms f n ((hgroupSectionsOverBaseIso f.toLRSHom.toShHom
        (relativeDifferentialForms f (n : ℤ)) 0 n n (by simp)).hom ξ)) →
  ∀ x : Hgroup (structureSheafRing X.toRingedSpace) ⊤ n (relativeDifferentialForms f (n : ℤ)),
    pullbackCup (pullback.snd f f) (pullback.fst f f) (relativeDifferentialForms f (n : ℤ))
        (relativeDifferentialForms f (n : ℤ)) n n
        ((unitPullback (pullback.snd f f) _ n).hom x)
        ((unitPullback (pullback.fst f f) _ n).hom ξ) = 0 →
      x = 0

/-- An isomorphism of abelian groups has trivial kernel. -/
private theorem iso_hom_eq_zero {M N : AddCommGrpCat.{u}} (e : M ≅ N) {x : M}
    (h : e.hom.hom x = 0) :
    x = 0 := by
  simpa only [Iso.hom_inv_id_apply, map_zero] using congrArg e.inv.hom h

/-- Two classes identified by the bridge `hgroupModuleShiftIso` in two spellings of the degree are
identified by `hgroupSectionsOverBaseIso`. -/
theorem hgroupSectionsOverBaseIso_eq_of_eq {S V : RingedSpace.{u, u}} (c : V ⟶ S)
    (F : SheafOfModules.{u} (structureSheafRing V)) (n q : ℕ) (hq : q = n)
    (ξ : Hgroup (structureSheafRing V) ⊤ n F) (z : Hgroup (structureSheafRing V) ⊤ q F)
    (h : (hgroupModuleShiftIso (X := V) F 0 n n (by simp)).hom ξ =
      (hgroupModuleShiftIso (X := V) F 0 q n (by simp [hq])).hom z) :
    (hgroupSectionsOverBaseIso c F 0 n n (by simp)).hom ξ =
      (hgroupSectionsOverBaseIso c F 0 q n (by simp [hq])).hom z := by
  subst hq
  rw [(ConcreteCategory.bijective_of_isIso _).1 h]

/-- **The derived form of top-degree injectivity on `X ×_A X`.** Let `F` be an `𝒪_X`-module with
`RΓ(X, F)` in degrees `≤ n`, let `t : 𝒪_X[-n] ⟶ F[0]` be such that `Hⁿ(RΓ(X, t))` reaches a
generator of `Hⁿ(RΓ(X, F))`, and assume the Künneth maps through `X ×_A X` at `(F[0], 𝒪_X[-n])`
and `(F[0], F[0])` are invertible. Let `Φ : (p₂^*F)[-n] ⟶ P[0]` be a morphism of `D(𝒪_{X ×_A X})`
which, after `Lp₂^*(F[-n]) ⟶ (p₂^*F)[-n]`, is `Lp₂^*F[0] ⊗^𝐋 Lp₁^*t` up to isomorphisms on both
sides. Then `x ↦ H^{2n}(Φ)(p₂^*x)` is injective on `Hⁿ(X, F)`. -/
theorem eq_zero_of_cohomologyMapOfSingleHom_eq_zero [IsProper f] [Smooth f] [IsIso f.appTop]
    (σ : Spec (.of A) ⟶ X) (hσ : σ ≫ f = 𝟙 _) (n : ℕ) (F : X.Modules)
    [((sectionsOverBase f.toLRSHom.toShHom).obj
      ((DerivedCategory.singleFunctor (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
        ((0 : ℕ) : ℤ)).obj F)).IsLE (n : ℤ)]
    (t : unitInDegree X n ⟶
      (DerivedCategory.singleFunctor (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
        ((0 : ℕ) : ℤ)).obj F)
    (z : (DerivedCategory.homologyFunctor (ModuleCat.{u} (baseRing (Spec (.of A)).toRingedSpace))
      (n : ℤ)).obj ((sectionsOverBase f.toLRSHom.toShHom).obj (unitInDegree X n)))
    (hz : Submodule.span (baseRing (Spec (.of A)).toRingedSpace)
      {((DerivedCategory.homologyFunctor _ (n : ℤ)).map
        ((sectionsOverBase f.toLRSHom.toShHom).map t)).hom z} = ⊤)
    (hκW : IsIso (kunnethGlobalMapCanonical f.toLRSHom.toShHom f.toLRSHom.toShHom
      (pullback.snd f f).toLRSHom.toShHom (pullback.fst f f).toLRSHom.toShHom
      (pullback.snd f f ≫ f).toLRSHom.toShHom rfl (by rw [← pullback.condition]; rfl)
      ((DerivedCategory.singleFunctor (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
        ((0 : ℕ) : ℤ)).obj F) (unitInDegree X n)))
    (hκK : IsIso (kunnethGlobalMapCanonical f.toLRSHom.toShHom f.toLRSHom.toShHom
      (pullback.snd f f).toLRSHom.toShHom (pullback.fst f f).toLRSHom.toShHom
      (pullback.snd f f ≫ f).toLRSHom.toShHom rfl (by rw [← pullback.condition]; rfl)
      ((DerivedCategory.singleFunctor (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
        ((0 : ℕ) : ℤ)).obj F)
      ((DerivedCategory.singleFunctor (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
        ((0 : ℕ) : ℤ)).obj F)))
    (P : SheafOfModules.{u} (structureSheafRing (pullback f f).toRingedSpace))
    (Φ : (DerivedCategory.singleFunctor
        (SheafOfModules.{u} (structureSheafRing (pullback f f).toRingedSpace)) (n : ℤ)).obj
        ((Scheme.Modules.pullback (pullback.snd f f)).obj F) ⟶
      (DerivedCategory.singleFunctor
        (SheafOfModules.{u} (structureSheafRing (pullback f f).toRingedSpace)) ((0 : ℕ) : ℤ)).obj P)
    (Θ : (derivedPullback (pullback.snd f f).toLRSHom.toShHom).obj
        ((DerivedCategory.singleFunctor (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
          (n : ℤ)).obj F) ⟶
      ((derivedTensorProductFunctor (pullback f f).sheaf).obj
        ((derivedPullback (pullback.snd f f).toLRSHom.toShHom).obj
          ((DerivedCategory.singleFunctor (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
            ((0 : ℕ) : ℤ)).obj F))).obj
        ((derivedPullback (pullback.fst f f).toLRSHom.toShHom).obj (unitInDegree X n)))
    (hΘ : IsIso Θ)
    (Ξ : ((derivedTensorProductFunctor (pullback f f).sheaf).obj
        ((derivedPullback (pullback.snd f f).toLRSHom.toShHom).obj
          ((DerivedCategory.singleFunctor (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
            ((0 : ℕ) : ℤ)).obj F))).obj
        ((derivedPullback (pullback.fst f f).toLRSHom.toShHom).obj
          ((DerivedCategory.singleFunctor (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
            ((0 : ℕ) : ℤ)).obj F)) ⟶
      (DerivedCategory.singleFunctor
        (SheafOfModules.{u} (structureSheafRing (pullback f f).toRingedSpace)) ((0 : ℕ) : ℤ)).obj P)
    (hΞ : IsIso Ξ)
    (hΦ : singleDegreePullbackComparison (pullback.snd f f).toLRSHom.toShHom F (n : ℤ) ≫ Φ =
      Θ ≫ ((derivedTensorProductFunctor (pullback f f).sheaf).obj
        ((derivedPullback (pullback.snd f f).toLRSHom.toShHom).obj
          ((DerivedCategory.singleFunctor (SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
            ((0 : ℕ) : ℤ)).obj F))).map
