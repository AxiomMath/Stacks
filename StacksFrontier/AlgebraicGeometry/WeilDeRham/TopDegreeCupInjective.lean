theorem pullbackCupTopInjective [IsNoetherianRing A] [IsProper f] (n : ℕ)
    [SmoothOfRelativeDimension n f] [IsIso f.appTop] (σ : Spec (.of A) ⟶ X)
    (hσ : σ ≫ f = 𝟙 _)
    (ξ : Hgroup (structureSheafRing X.toRingedSpace) ⊤ n (relativeDifferentialForms f (n : ℤ))) :
    PullbackCupTopInjective f n ξ := by
  have : Smooth f := SmoothOfRelativeDimension.smooth n f
  have := Scheme.Hom.isQuasicoherent_relativeDifferentialForms f n
  have := AlgebraicGeometry.ProperSmoothDeRham.isFiniteLocallyFree_relativeDifferentialForms f n
  exact pullbackCupTopInjective_of_isIso f n σ hσ ξ
    (isIso_kunnethGlobalMapCanonical_forms f n n (pullback.snd f f) (pullback.fst f f)
      pullback.condition.symm (pullbackSymmetry f f) (pullbackSymmetry_hom_comp_fst f f)
      (pullbackSymmetry_hom_comp_snd f f))
    (kunnethSingleIso f f (relativeDifferentialForms f (n : ℤ))
      (relativeDifferentialForms f (n : ℤ))
      (AlgebraicGeometry.VectorBundleCodimensionOne.isFlatOver_of_isFiniteLocallyFree f _) 0 0
      (pullback.snd f f) (pullback.fst f f) (pullbackSymmetry f f)
      (pullbackSymmetry_hom_comp_fst f f) (pullbackSymmetry_hom_comp_snd f f)
      pullback.condition.symm)

end Forms

