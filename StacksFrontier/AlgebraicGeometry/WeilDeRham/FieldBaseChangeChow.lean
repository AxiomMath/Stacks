/-!
# Chow groups of smooth projective schemes along a field extension

Let `k'/k` be an extension of fields and `g : Spec(k') → Spec(k)`. Chow Homology, Lemma 0FVJ
gives the base change `g^* : CH_n(X) → CH_n(X_{k'})` for `X` locally of finite type over `k`
(`Stacks.Chow.baseChangeChowPullback`, here with dimension shift zero). The proof of Lemma 0FVT
of the Stacks Project uses three properties of it, for `X` smooth projective over `k`:

* it is compatible with capping with Chern characters (Chow Homology, Lemma 0FVN) and takes
  `[X]` to `[X_{k'}]`, so that `g^*(ch(β) ∩ [X]) = ch((X_{k'} → X)^*β) ∩ [X_{k'}]`;
* read on `CH^i(X) = ∏_d CH_{d-i}(X_d)` it is a map `CH^i(X) → CH^i(X_{k'})`, the part of
  dimension `d` of `X_{k'}` being the preimage of `X_d`;
* it takes the class of the diagonal to the class of the diagonal.

This file proves them.

## Main definitions

* `Stacks.WeilDeRham.chowBaseChange`: `g^* : CH_n(X) → CH_n(X_{k'})`.
* `Stacks.WeilDeRham.rationalChowBaseChange`: `g^*` on `CH_*(X) ⊗ 𝐐`.
* `Stacks.WeilDeRham.codimensionChowBaseChange`, `Stacks.WeilDeRham.chowCodimBaseChange`:
  `g^* : CH^i(X) → CH^i(X_{k'})`.
* `Stacks.WeilDeRham.rationalChowRingBaseChange`: `g^*` on `CH^*(X) ⊗ 𝐐`.

## Main results

* `Stacks.WeilDeRham.rationalChowBaseChange_chernCharacterCap`: `g^*(ch(β) ∩ α) =
  ch((X_{k'} → X)^*β) ∩ g^*α` (Tag 0FVN for the Chern character). The Chern classes are
  compatible by Tag 0FVN; the power sums are the same polynomial in them, which is evaluated in
  the commutative ring generated by the pairs of Chern classes; a module whose rank is not
  constant is handled on its rank loci by the projection formula.
* `Stacks.WeilDeRham.chowBaseChange_fundamentalChowClass`: `g^*[X]_n = [X_{k'}]_n`.
* `Stacks.WeilDeRham.preimage_dimPart`: the parts of `X_{k'}` are the preimages of those of `X`.
* `Stacks.WeilDeRham.rationalChowRingBaseChange_rationalChernCharacterEquiv`:
  `g^*(ch(β) ∩ [X]) = ch((X_{k'} → X)^*β) ∩ [X_{k'}]`.
* `Stacks.WeilDeRham.codimensionClass_chowCodimBaseChange`: `g^*` on `CH^i` and on
  `CH^*(-) ⊗ 𝐐` agree.
* `Stacks.WeilDeRham.chowCodimBaseChange_diagonalChowClass`: `g^*(δ_*[X]) = (δ_{k'})_*[X_{k'}]`.
* `Stacks.WeilDeRham.chowCodimBaseChange_closedSubschemeClass`: `g^*[Z] = [Z_{k'}]` for a closed
  immersion `Z ⟶ P` of smooth projective schemes of constant dimensions, for instance the class
  `[Δ]` of the diagonal (`Stacks.WeilCohomology.SmoothProjectiveScheme.diagonalClass`).

## References

* [Stacks Project, Tag 0FVT](https://stacks.math.columbia.edu/tag/0FVT)
* [Stacks Project, Tag 0FVJ](https://stacks.math.columbia.edu/tag/0FVJ)
* [Stacks Project, Tag 0FVN](https://stacks.math.columbia.edu/tag/0FVN)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped TensorProduct

universe u

namespace Stacks.WeilDeRham

open Stacks.Chow Stacks.WeilCohomology

/-! ### The base change of Chow groups -/

section ChowBaseChange

variable (k k' : Type u) [Field k] [Field k'] [Algebra k k']

/-- The flat base change of Chow situations along `Spec(k') → Spec(k)`. -/
local notation "B₀" => fieldExtensionBaseChangeSituation k k'

variable {X : Scheme.{u}} (sX : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType sX]

/-- **The base change `g^* : CH_n(X) → CH_n(X_{k'})` of Tag 0FVJ** along `Spec(k') → Spec(k)`,
whose dimension shift is zero, read in the same degree `n`. -/
def chowBaseChange (n : ℤ) :
    chowGroup (fieldChowSituation k) sX n →+
      chowGroup (fieldChowSituation k') (pullback.snd sX (B₀).g) n :=
  (chowGroupCast _ _ (add_zero n)).toAddMonoidHom.comp (baseChangeChowPullback B₀ sX n)

/-- `g^*` is the base change of Tag 0FVJ, read in the same degree. -/
theorem chowBaseChange_apply (n : ℤ) (α : chowGroup (fieldChowSituation k) sX n) :
    chowBaseChange k k' sX n α =
      chowGroupCast _ _ (add_zero n) (baseChangeChowPullback B₀ sX n α) :=
  rfl

/-- `g^*` on `CH_*(X) ⊗ 𝐐 = ⨁_n CH_n(X) ⊗ 𝐐`, degree by degree. -/
def rationalChowBaseChange :
    (DirectSum ℤ fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation k) sX j) →ₗ[ℚ]
      DirectSum ℤ fun j : ℤ =>
        ℚ ⊗[ℤ] chowGroup (fieldChowSituation k') (pullback.snd sX (B₀).g) j :=
  DirectSum.toModule ℚ ℤ _ fun n =>
    DirectSum.lof ℚ ℤ
        (fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation k') (pullback.snd sX (B₀).g) j) n ∘ₗ
      (chowBaseChange k k' sX n).toIntLinearMap.baseChange ℚ

/-- `g^*` on `CH_*(X) ⊗ 𝐐` is `g^* ⊗ 𝐐` on `CH_n(X) ⊗ 𝐐`. -/
theorem rationalChowBaseChange_lof (n : ℤ)
    (t : ℚ ⊗[ℤ] chowGroup (fieldChowSituation k) sX n) :
    rationalChowBaseChange k k' sX
        (DirectSum.lof ℚ ℤ (fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation k) sX j) n t) =
      DirectSum.lof ℚ ℤ
        (fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation k') (pullback.snd sX (B₀).g) j) n
        ((chowBaseChange k k' sX n).toIntLinearMap.baseChange ℚ t) := by
  simp only [rationalChowBaseChange, DirectSum.toModule_lof, LinearMap.comp_apply]

/-- `g^*` on `CH_*(X) ⊗ 𝐐` sends `q ⊗ α` to `q ⊗ g^*α`. -/
theorem rationalChowBaseChange_of_tmul (n : ℤ) (q : ℚ)
    (α : chowGroup (fieldChowSituation k) sX n) :
    rationalChowBaseChange k k' sX
        (DirectSum.of (fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation k) sX j) n (q ⊗ₜ α)) =
      DirectSum.of
        (fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation k') (pullback.snd sX (B₀).g) j) n
        (q ⊗ₜ chowBaseChange k k' sX n α) := by
  rw [← DirectSum.lof_eq_of ℚ, rationalChowBaseChange_lof, LinearMap.baseChange_tmul,
    AddMonoidHom.coe_toIntLinearMap, DirectSum.lof_eq_of]

/-! ### Proper pushforward -/

/-- **`g^*` commutes with proper pushforward** (Tag 0FVL): for `f : Y → X` proper,
`g^*(f_*α) = (f_{k'})_*(g^*α)`. -/
theorem chowBaseChange_properChowPushforward {Y : Scheme.{u}} (f : Y ⟶ X) [IsProper f]
    (n : ℤ) (α : chowGroup (fieldChowSituation k) (f ≫ sX) n) :
    haveI : IsProper (baseChangeMorphism B₀ sX f) := isProper_baseChangeMorphism B₀ sX f
    chowBaseChange k k' sX n
        (properChowPushforward (fieldChowSituation k) (f ≫ sX) sX f rfl n
          (properPushforwardDescends _ _ _ _ _ _) α) =
      properChowPushforward (fieldChowSituation k') (pullback.snd (f ≫ sX) (B₀).g)
        (pullback.snd sX (B₀).g) (baseChangeMorphism B₀ sX f)
        (baseChangeMorphism_comp_snd B₀ sX f) n
        (properPushforwardDescends _ _ _ _ _ _) (chowBaseChange k k' (f ≫ sX) n α) := by
  have : IsProper (baseChangeMorphism B₀ sX f) := isProper_baseChangeMorphism B₀ sX f
  rw [chowBaseChange_apply, chowBaseChange_apply, ← Stacks.Chow.properChowPushforward_chowGroupCast]
  congr 1
  exact (properChowPushforward_baseChangeChowPullback B₀ sX f n
    (fun sW _ j => baseChangeChowPullback B₀ sW j) (fun _ _ _ _ => rfl) α).symm

/-- **`g^*` commutes with proper pushforward on `CH_*(-) ⊗ 𝐐`.** -/
theorem rationalChowBaseChange_rationalProperChowPushforward {Y : Scheme.{u}} (f : Y ⟶ X)
    [IsProper f]
    (t : DirectSum ℤ fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation k) (f ≫ sX) j) :
    haveI : IsProper (baseChangeMorphism B₀ sX f) := isProper_baseChangeMorphism B₀ sX f
    rationalChowBaseChange k k' sX
        (rationalProperChowPushforward (fieldChowSituation k) (f ≫ sX) sX rfl t) =
      rationalProperChowPushforward (fieldChowSituation k') (pullback.snd (f ≫ sX) (B₀).g)
        (pullback.snd sX (B₀).g) (baseChangeMorphism_comp_snd B₀ sX f)
        (rationalChowBaseChange k k' (f ≫ sX) t) := by
  have : IsProper (baseChangeMorphism B₀ sX f) := isProper_baseChangeMorphism B₀ sX f
  refine LinearMap.congr_fun (f := rationalChowBaseChange k k' sX ∘ₗ
      rationalProperChowPushforward (fieldChowSituation k) (f ≫ sX) sX rfl)
    (g := rationalProperChowPushforward (fieldChowSituation k') (pullback.snd (f ≫ sX) (B₀).g)
        (pullback.snd sX (B₀).g) (baseChangeMorphism_comp_snd B₀ sX f) ∘ₗ
      rationalChowBaseChange k k' (f ≫ sX))
    (rationalChowHomology_linearMap_ext _ _ fun n q α => ?_) t
  simp only [LinearMap.comp_apply]
  rw [rationalProperChowPushforward_of_tmul, rationalChowBaseChange_of_tmul,
    rationalChowBaseChange_of_tmul, rationalProperChowPushforward_of_tmul,
    chowBaseChange_properChowPushforward]

/-! ### Compatibility of caps with the base change -/

/-- **`c` and `c'` are compatible with `g^*`**: for every degree `p`, capping with `c_p` on `X` and
with `c'_p` on `X_{k'}` commutes with `g^*` on `CH_*(-) ⊗ 𝐐`. -/
def CapCompatible (c : TotalChowClass (fieldChowSituation k) sX)
    (c' : TotalChowClass (fieldChowSituation k') (pullback.snd sX (B₀).g)) : Prop :=
  ∀ p : ℕ, rationalChowBaseChange k k' sX ∘ₗ
      rationalChowCap (fieldChowSituation k) (gysinSystemOfInvertible _) sX p (1 ⊗ₜ c p) =
    rationalChowCap (fieldChowSituation k') (gysinSystemOfInvertible _) (pullback.snd sX (B₀).g) p
      (1 ⊗ₜ c' p) ∘ₗ rationalChowBaseChange k k' sX

/-- The cap of the unit class in degree `0` is the identity of `CH_*(X) ⊗ 𝐐`. -/
theorem rationalChowCap_one_zero (C : ChowSituation.{u}) {Y : Scheme.{u}} (sY : Y ⟶ C.S)
    [LocallyOfFiniteType sY] :
    rationalChowCap C (gysinSystemOfInvertible C) sY ((0 : ℕ) : ℤ)
      (1 ⊗ₜ (1 : TotalChowClass C sY) 0) = 1 := by
  refine rationalChowHomology_linearMap_ext C sY fun n q α => ?_
  rw [rationalChowCap_of_tmul, one_mul, Module.End.one_apply]
  refine of_tmul_eq_of_tmul_of_heq C sY (by simp) q ?_
  refine (chowCohomologyCap_heq_idRule_ofGysinSystem C _ sY _ _ n α).trans ?_
  show (1 : TotalChowClass C sY).op (𝟙 Y) n 0 _ ≍ α
  rw [TotalChowClass.op_one, gradedCap_one_apply_zero]
  exact (gradedDegreeCast_heq _ _).trans (chowGroupCongr_heq C _ n α)

/-- **The pairs of compatible total classes form a subring** of the product ring: capping with a
sum or a product is the sum or composite of the caps (Stacks 0B75). -/
def capCompatibleSubring :
    Subring (TotalChowClass (fieldChowSituation k) sX ×
      TotalChowClass (fieldChowSituation k') (pullback.snd sX (B₀).g)) where
  carrier := {x | CapCompatible k k' sX x.1 x.2}
  zero_mem' p := by
    simp only [Prod.fst_zero, Prod.snd_zero, TotalChowClass.zero_apply, TensorProduct.tmul_zero,
      map_zero, LinearMap.comp_zero, LinearMap.zero_comp]
  add_mem' {x y} hx hy p := by
    simp only [Prod.fst_add, Prod.snd_add, TotalChowClass.add_apply, TensorProduct.tmul_add,
      map_add, LinearMap.comp_add, LinearMap.add_comp, hx p, hy p]
  neg_mem' {x} hx p := by
    simp only [Prod.fst_neg, Prod.snd_neg, TotalChowClass.neg_apply, TensorProduct.tmul_neg,
      map_neg, LinearMap.comp_neg, LinearMap.neg_comp, hx p]
  one_mem' p := by
    rcases eq_or_ne p 0 with rfl | hp
    · simp only [Prod.fst_one, Prod.snd_one, rationalChowCap_one_zero]
      rfl
    · simp only [Prod.fst_one, Prod.snd_one, TotalChowClass.one_apply_of_ne hp,
        TensorProduct.tmul_zero, map_zero, LinearMap.comp_zero, LinearMap.zero_comp]
  mul_mem' {x y} hx hy p := by
    have h1 := rationalChowCap_tmul_mul_apply (fieldChowSituation k) sX x.1 y.1 1 1 p
    have h2 := rationalChowCap_tmul_mul_apply (fieldChowSituation k') (pullback.snd sX (B₀).g)
      x.2 y.2 1 1 p
    rw [one_mul] at h1 h2
    simp only [Prod.fst_mul, Prod.snd_mul, h1, h2]
    refine LinearMap.ext fun t => ?_
    simp only [LinearMap.comp_apply, LinearMap.sum_apply, map_sum,
      Module.End.mul_apply]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← LinearMap.comp_apply (rationalChowBaseChange k k' sX), hx (p - j), LinearMap.comp_apply,
      ← LinearMap.comp_apply (rationalChowBaseChange k k' sX), hy j, LinearMap.comp_apply]

/-! ### Chern classes -/

/-- Equal arguments in equal degrees of a degree-indexed family of additive maps have
heterogeneously equal images. -/
theorem heq_apply_of_degree_eq {A B : ℤ → Type*} [∀ d, AddCommGroup (A d)]
    [∀ d, AddCommGroup (B d)] (F : ∀ d, A d →+ B d) {d₁ d₂ : ℤ} (hd : d₁ = d₂) {x : A d₁}
    {y : A d₂} (hxy : x ≍ y) : F d₁ x ≍ F d₂ y := by
  subst hd
  cases hxy
  rfl

/-- **The cap of `c_j(ℰ)` on `X` itself is `c_j(ℰ) ∩ -`** of Stacks 02U6
(`Stacks.Chow.GenuineChern.chernCap`). -/
theorem chowCohomologyCap_totalChern_heq (C : ChowSituation.{u}) {Y : Scheme.{u}}
    (sY : Y ⟶ C.S) [LocallyOfFiniteType sY] (E : Y.Modules) (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r] (j : Fin (r + 1))
    (n : ℤ) (α : chowGroup C sY n) :
    chowCohomologyCap C (gysinSystemOfInvertible C) sY ((j : ℕ) : ℤ)
        (totalChern C sY E r (j : ℕ)) n α ≍ GenuineChern.chernCap C r sY E n j α := by
  rw [totalChern_apply]
  refine (chowCohomologyCap_heq_idRule_ofGysinSystem C _ sY _ _ n α).trans ?_
  have := pullbackPreservesRank_of_isFiniteLocallyFreeOfRank E r (𝟙 Y)
  rw [GenuineChern.idRule_chernClass]
  exact chernCap_heq_of_iso C (Category.id_comp sY) (F' := E) r
    ((Scheme.Modules.pullbackId Y).app E) n j (chowGroupCongr_heq C _ n α)

variable (E : X.Modules) (r : ℕ)
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]

/-- **Tag 0FVN for the Chern classes of the library**: `g^*(c_j(ℰ) ∩ α) = c_j(ℰ_{k'}) ∩ g^*α`. -/
theorem chowBaseChange_chowCohomologyCap_totalChern (j : Fin (r + 1)) (n : ℤ)
    (α : chowGroup (fieldChowSituation k) sX n) :
    haveI := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback (pullback.fst sX (B₀).g) E r
    chowBaseChange k k' sX (n - ((j : ℕ) : ℤ))
        (chowCohomologyCap (fieldChowSituation k) (gysinSystemOfInvertible _) sX ((j : ℕ) : ℤ)
          (totalChern (fieldChowSituation k) sX E r (j : ℕ)) n α) =
      chowCohomologyCap (fieldChowSituation k') (gysinSystemOfInvertible _)
        (pullback.snd sX (B₀).g) ((j : ℕ) : ℤ)
        (totalChern (fieldChowSituation k') (pullback.snd sX (B₀).g)
          ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E) r (j : ℕ)) n
        (chowBaseChange k k' sX n α) := by
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback (pullback.fst sX (B₀).g) E r
  refine eq_of_heq ?_
  rw [chowBaseChange_apply, chowBaseChange_apply]
  refine (chowGroupCast_heq _ _ _ _).trans ?_
  refine HEq.trans (heq_apply_of_degree_eq (fun d => baseChangeChowPullback B₀ sX d) rfl
    (chowCohomologyCap_totalChern_heq _ sX E r j n α)) ?_
  refine HEq.trans ?_ (chowCohomologyCap_totalChern_heq _ _ _ r j n _).symm
  refine HEq.trans ?_ (heq_apply_of_degree_eq
    (fun d => GenuineChern.chernCap (fieldChowSituation k') r (pullback.snd sX (B₀).g)
      ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E) d j)
    (add_zero n) (chowGroupCast_heq _ _ _ _).symm)
  rw [baseChange_chernCap B₀ sX E r n j α]
  exact (chowGroupCast_heq _ _ _ _).symm

/-- **The Chern classes of `ℰ` and of `ℰ_{k'}` are compatible with `g^*`**, degree by degree. -/
theorem capCompatible_homComponent_totalChern (i : ℕ) :
    haveI := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback (pullback.fst sX (B₀).g) E r
    CapCompatible k k' sX (TotalChowClass.homComponent i (totalChern _ sX E r))
      (TotalChowClass.homComponent i (totalChern _ (pullback.snd sX (B₀).g)
        ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E) r)) := by
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback (pullback.fst sX (B₀).g) E r
  intro p
  simp only [TotalChowClass.homComponent_apply]
  by_cases hp : p = i
  · subst hp
    simp only [if_true]
    by_cases hpr : p ≤ r
    · refine rationalChowHomology_linearMap_ext _ _ fun n q α => ?_
      simp only [LinearMap.comp_apply]
      rw [rationalChowCap_of_tmul, rationalChowBaseChange_of_tmul, rationalChowBaseChange_of_tmul,
        rationalChowCap_of_tmul]
      congr 2
      exact chowBaseChange_chowCohomologyCap_totalChern k k' sX E r ⟨p, Nat.lt_succ_of_le hpr⟩ n α
    · rw [totalChern_apply_of_lt _ _ _ _ (by omega), totalChern_apply_of_lt _ _ _ _ (by omega)]
      simp only [TensorProduct.tmul_zero, map_zero, LinearMap.comp_zero, LinearMap.zero_comp]
  · simp only [if_neg hp, TensorProduct.tmul_zero, map_zero, LinearMap.comp_zero,
      LinearMap.zero_comp]

/-! ### Power sums and the Chern character of a module of constant rank -/

/-- The pairs `(c_i(ℰ), c_i(ℰ_{k'}))` of homogeneous Chern classes. -/
def chernPairSet :
    Set (TotalChowClass (fieldChowSituation k) sX ×
      TotalChowClass (fieldChowSituation k') (pullback.snd sX (B₀).g)) :=
  haveI := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback (pullback.fst sX (B₀).g) E r
  Set.range fun i : ℕ => (TotalChowClass.homComponent i (totalChern _ sX E r),
    TotalChowClass.homComponent i (totalChern _ (pullback.snd sX (B₀).g)
      ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E) r))

/-- The pairs of Chern classes commute with each other (Stacks 02UA, on `X` and on `X_{k'}`). -/
theorem chernPairSet_commute :
    ∀ x ∈ chernPairSet k k' sX E r, ∀ y ∈ chernPairSet k k' sX E r, x * y = y * x := by
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback (pullback.fst sX (B₀).g) E r
  rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
  refine Prod.ext ?_ ?_
  · exact chernSet_commute _ sX _ (homPart_totalChern_mem_chernSet _ sX E r i) _
      (homPart_totalChern_mem_chernSet _ sX E r j)
  · exact chernSet_commute _ _ _ (homPart_totalChern_mem_chernSet _ _ _ r i) _
      (homPart_totalChern_mem_chernSet _ _ _ r j)

/-- The (commutative) ring generated by the pairs of Chern classes. -/
abbrev chernPairRing :
    Subring (TotalChowClass (fieldChowSituation k) sX ×
      TotalChowClass (fieldChowSituation k') (pullback.snd sX (B₀).g)) :=
  Subring.closure (chernPairSet k k' sX E r)

/-- The ring generated by the pairs of Chern classes is commutative. -/
instance : CommRing (chernPairRing k k' sX E r) :=
  Subring.closureCommRingOfComm (chernPairSet_commute k k' sX E r)

/-- The pairs of classes in the ring generated by the pairs of Chern classes are compatible
with `g^*`, the generators being so (Tag 0FVN). -/
theorem chernPairRing_le_capCompatibleSubring :
    chernPairRing k k' sX E r ≤ capCompatibleSubring k k' sX := by
  refine Subring.closure_le.mpr ?_
  rintro _ ⟨i, rfl⟩
  exact capCompatible_homComponent_totalChern k k' sX E r i

/-- The first projection of the ring of pairs, into the ring of Chern classes of `X`. -/
def chernPairFst : chernPairRing k k' sX E r →+* chernRing (fieldChowSituation k) sX :=
  RingHom.codRestrict ((RingHom.fst _ _).comp (Subring.subtype _)) (chernRing _ sX) fun x => by
    have hx : x.1 ∈ Subring.comap (RingHom.fst _ _) (chernRing _ sX) := by
      refine Subring.closure_le.mpr ?_ x.2
      rintro _ ⟨i, rfl⟩
      exact Subring.subset_closure (homPart_totalChern_mem_chernSet _ sX E r i)
    exact hx

/-- The second projection of the ring of pairs, into the ring of Chern classes of `X_{k'}`. -/
def chernPairSnd : chernPairRing k k' sX E r →+*
    chernRing (fieldChowSituation k') (pullback.snd sX (B₀).g) :=
  RingHom.codRestrict ((RingHom.snd _ _).comp (Subring.subtype _)) (chernRing _ _) fun x => by
    have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback (pullback.fst sX (B₀).g) E r
    have hx : x.1 ∈ Subring.comap (RingHom.snd _ _) (chernRing _ (pullback.snd sX (B₀).g)) := by
      refine Subring.closure_le.mpr ?_ x.2
      rintro _ ⟨i, rfl⟩
      exact Subring.subset_closure (homPart_totalChern_mem_chernSet _ _ _ r i)
    exact hx

/-- **The power sums `P_p(ℰ)` and `P_p(ℰ_{k'})` are compatible with `g^*`**: they are the same
universal polynomial (Stacks 0F9B) in the Chern classes, which are compatible (Tag 0FVN). -/
theorem capCompatible_powerSumTotal (p : ℕ) :
    haveI := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback (pullback.fst sX (B₀).g) E r
    CapCompatible k k' sX (powerSumTotal _ sX E r p)
      (powerSumTotal _ (pullback.snd sX (B₀).g)
        ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E) r p) := by
  have := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback (pullback.fst sX (B₀).g) E r
  rcases eq_or_ne p 0 with rfl | hp
  · simp only [powerSumTotal, if_true]
    have h : CapCompatible k k' sX ((r : TotalChowClass _ sX × TotalChowClass _ _).1)
        ((r : TotalChowClass _ sX × TotalChowClass _ _).2) :=
      natCast_mem (capCompatibleSubring k k' sX) r
    simpa only [Prod.fst_natCast, Prod.snd_natCast] using h
  · let a : ℕ → chernPairRing k k' sX E r := fun i =>
      ⟨(TotalChowClass.homComponent i (totalChern _ sX E r),
        TotalChowClass.homComponent i (totalChern _ (pullback.snd sX (B₀).g)
          ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E) r)),
        Subring.subset_closure ⟨i, rfl⟩⟩
    have h1 : chernPairFst k k' sX E r (powerSumEval a p) = powerSumEval (chernSeq _ sX E r) p := by
      rw [map_powerSumEval]
      rfl
    have h2 : chernPairSnd k k' sX E r (powerSumEval a p) =
        powerSumEval (chernSeq _ _ ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E) r)
          p := by
      rw [map_powerSumEval]
      rfl
    have hmem := chernPairRing_le_capCompatibleSubring k k' sX E r (powerSumEval a p).2
    simp only [powerSumTotal, if_neg hp, ← h1, ← h2]
    exact hmem

/-- Capping commutes with `g^*` for a rational multiple of a compatible class. -/
theorem CapCompatible.rationalChowCap_tmul {c : TotalChowClass (fieldChowSituation k) sX}
    {c' : TotalChowClass (fieldChowSituation k') (pullback.snd sX (B₀).g)}
    (h : CapCompatible k k' sX c c') (p : ℕ) (q : ℚ) :
    rationalChowBaseChange k k' sX ∘ₗ
        rationalChowCap (fieldChowSituation k) (gysinSystemOfInvertible _) sX p (q ⊗ₜ c p) =
      rationalChowCap (fieldChowSituation k') (gysinSystemOfInvertible _)
        (pullback.snd sX (B₀).g) p (q ⊗ₜ c' p) ∘ₗ rationalChowBaseChange k k' sX := by
  have hq : ∀ {M : Type _} [AddCommGroup M] (m : M), (q ⊗ₜ[ℤ] m : ℚ ⊗[ℤ] M) = q • (1 ⊗ₜ m) :=
    fun m => by rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  rw [hq, hq, map_smul, map_smul, LinearMap.comp_smul, LinearMap.smul_comp, h p]

include r in
/-- **Tag 0FVN for the Chern character of a module of constant rank**:
`g^*(ch(ℰ) ∩ α) = ch(ℰ_{k'}) ∩ g^*α` on `CH_*(X) ⊗ 𝐐`. -/
theorem rationalChowBaseChange_chernCharacterCap_of_rank
    (t : DirectSum ℤ fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation k) sX j) :
    rationalChowBaseChange k k' sX
        (chernCharacterCap (fieldChowSituation k) sX (VectorBundleKZero.classOf X E) t) =
      chernCharacterCap (fieldChowSituation k') (pullback.snd sX (B₀).g)
        (VectorBundleKZero.classOf _ ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E))
        (rationalChowBaseChange k k' sX t) := by
  have hE' := AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback (pullback.fst sX (B₀).g) E r
  have := AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree E r
  have := AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree
    ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E) r
  refine LinearMap.congr_fun (f := rationalChowBaseChange k k' sX ∘ₗ
      chernCharacterCap (fieldChowSituation k) sX (VectorBundleKZero.classOf X E))
    (g := chernCharacterCap (fieldChowSituation k') (pullback.snd sX (B₀).g)
        (VectorBundleKZero.classOf _ ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E)) ∘ₗ
      rationalChowBaseChange k k' sX)
    (DirectSum.linearMap_ext ℚ fun n => LinearMap.ext fun t => ?_) t
  simp only [LinearMap.comp_apply]
  rw [chernCharacterCap_lof_eq_sum _ sX 0 (relativeDimension_fieldChowSituation_nonneg k sX) _ n t
      (Finset.range (n.toNat + 1)) (fun p hp => by rw [Finset.mem_range]; omega),
    rationalChowBaseChange_lof,
    chernCharacterCap_lof_eq_sum _ _ 0 (relativeDimension_fieldChowSituation_nonneg k' _) _ n _
      (Finset.range (n.toNat + 1)) (fun p hp => by rw [Finset.mem_range]; omega),
    map_sum]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [chernCharacterVectorBundle_classOf, chernCharacterVectorBundle_classOf,
    chernCharacterOfFiniteLocallyFree, chernCharacterOfFiniteLocallyFree,
    powerSumClassOfFiniteLocallyFree, powerSumClassOfFiniteLocallyFree,
    powerSumOfFiniteLocallyFree_eq_powerSumTotal _ sX E r,
    powerSumOfFiniteLocallyFree_eq_powerSumTotal _ _ _ r, ← rationalChowBaseChange_lof,
    ← LinearMap.comp_apply (rationalChowBaseChange k k' sX),
    (capCompatible_powerSumTotal k k' sX E r p).rationalChowCap_tmul, LinearMap.comp_apply]

end ChowBaseChange

/-! ### Decomposing Chow classes along an open and closed decomposition -/

section Decomposition

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (sX : X ⟶ C.S) [LocallyOfFiniteType sX]
  {I : Type u} {U : I → X.Opens} (hU : IsClopenDecomposition U)

include hU in
/-- On a quasi-compact scheme only finitely many pieces of an open and closed decomposition are
nonempty. -/
theorem finite_nonempty_of_isClopenDecomposition [CompactSpace X] :
    {i | (U i : Set X).Nonempty}.Finite :=
  (Stacks.Topology.locallyFinite_of_disjoint_open_cover _ (fun i ↦ (U i).2) hU.exists_mem
    fun _ _ hij ↦ TopologicalSpace.Opens.coe_disjoint.2
      (hU.disjoint _ _ hij)).finite_nonempty_of_compact

/-- **The pieces of an open and closed decomposition decompose `CH_m(X)`**: a class is the sum,
over any finite set of indices containing the nonempty pieces, of the pushforwards of its
restrictions. -/
theorem sum_properChowPushforward_chowGroupRestrict (S : Finset I)
    (hS : ∀ i, (U i : Set X).Nonempty → i ∈ S) (m : ℤ) (α : chowGroup C sX m) :
    ∑ i ∈ S, (haveI := hU.isProper_ι i
      properChowPushforward C ((U i).ι ≫ sX) sX (U i).ι rfl m
        (properPushforwardDescends _ _ _ _ _ _)
        (chowGroupRestrict C sX ((U i).ι ≫ sX) (U i).ι rfl m α)) = α := by
  rw [← sub_eq_zero]
  refine eq_zero_of_chowGroupRestrict_eq_zero C sX (fun i ↦ (U i).ι ≫ sX) (fun i ↦ (U i).ι)
    (fun _ ↦ rfl) ⟨fun i j hij ↦ by
      simpa only [Scheme.Opens.opensRange_ι] using hU.disjoint i j hij, by
      simp only [Scheme.Opens.opensRange_ι]
      exact hU.iSup_eq_top⟩ m _ fun i ↦ ?_
  rw [map_sub, map_sum, sub_eq_zero]
  by_cases hi : (U i : Set X).Nonempty
  · rw [Finset.sum_eq_single i]
    · have := hU.isProper_ι i
      exact chowGroupRestrict_properChowPushforward_opens_self _ _ _ _ _ _
    · intro j _ hj
      have := hU.isProper_ι j
      exact chowGroupRestrict_properChowPushforward_opens_of_disjoint _ _ _ _
        (hU.disjoint j i hj) _ _ _
    · exact fun h ↦ (h (hS i hi)).elim
  · have : IsEmpty (U i).toScheme := ⟨fun y ↦ hi ⟨y.1, y.2⟩⟩
    have := subsingleton_chowGroup_of_isEmpty C ((U i).ι ≫ sX) m
    exact Subsingleton.elim _ _

end Decomposition

/-! ### The Chern character of a finite locally free module -/

section ChernCharacter

variable (k k' : Type u) [Field k] [Field k'] [Algebra k k']

local notation "B₀" => fieldExtensionBaseChangeSituation k k'

variable {X : Scheme.{u}} (sX : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType sX]

/-- **`g^*` and capping with `ch(ℰ)` commute on the pushforward of a class from an open and
closed subscheme on which `ℰ` has constant rank**, by the projection formula on both sides. -/
theorem rationalChowBaseChange_chernCharacterCap_rationalProperChowPushforward
    (E : X.Modules) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]
    (V : X.Opens) [IsProper V.ι] (r : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback V.ι).obj E) r]
    (z : DirectSum ℤ fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation k) (V.ι ≫ sX) j) :
    rationalChowBaseChange k k' sX (chernCharacterCap (fieldChowSituation k) sX
        (VectorBundleKZero.classOf X E)
        (rationalProperChowPushforward (fieldChowSituation k) (V.ι ≫ sX) sX rfl z)) =
      chernCharacterCap (fieldChowSituation k') (pullback.snd sX (B₀).g)
        (VectorBundleKZero.classOf _ ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E))
        (rationalChowBaseChange k k' sX
          (rationalProperChowPushforward (fieldChowSituation k) (V.ι ≫ sX) sX rfl z)) := by
  have : IsProper (baseChangeMorphism B₀ sX V.ι) := isProper_baseChangeMorphism B₀ sX V.ι
  have hb : ∀ {T : Scheme.{u}} {K : Type u} [Field K] (s : T ⟶ (fieldChowSituation K).S),
      BddBelow (Set.range (relativeDimension (fieldChowSituation K).dimensionFunction s)) :=
    fun s => ⟨0, by rintro _ ⟨x, rfl⟩; exact relativeDimension_fieldChowSituation_nonneg _ s x⟩
  have := AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree
    ((Scheme.Modules.pullback V.ι).obj E) r
  have hE := (Stacks.FiniteLocallyFree.isFiniteLocallyFree_iff_algebraicGeometry E).mpr
    inferInstance
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
      ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E) :=
    (Stacks.FiniteLocallyFree.isFiniteLocallyFree_iff_algebraicGeometry _).mp
      (VectorBundleKZero.isFiniteLocallyFree_pullback _ E hE)
  -- the class of the base change of `ℰ|_V`, read along `V_{k'} → X_{k'}`
  have hK : VectorBundleKZero.classOf _ ((Scheme.Modules.pullback
        (pullback.fst (V.ι ≫ sX) (B₀).g)).obj ((Scheme.Modules.pullback V.ι).obj E)) =
      VectorBundleKZero.pullback (baseChangeMorphism B₀ sX V.ι)
        (VectorBundleKZero.classOf _
          ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E)) := by
    refine Eq.trans ?_ (VectorBundleKZero.pullback_eq_pullbackRingHom _ _).symm
    show _ = VectorBundleKZero.pullbackRingHom (baseChangeMorphism B₀ sX V.ι) _
    rw [← VectorBundleKZero.pullbackRingHom_classOf (pullback.fst sX (B₀).g) E hE,
      ← VectorBundleKZero.pullbackRingHom_classOf (pullback.fst (V.ι ≫ sX) (B₀).g) _
        (VectorBundleKZero.isFiniteLocallyFree_pullback V.ι E hE),
      ← VectorBundleKZero.pullbackRingHom_classOf V.ι E hE,
      ← VectorBundleKZero.pullbackRingHom_comp_apply,
      ← VectorBundleKZero.pullbackRingHom_comp_apply, baseChangeMorphism_comp_fst]
  rw [← rationalProperChowPushforward_chernCharacterCap _ _ _ rfl (hb _) (hb _),
    VectorBundleKZero.pullback_classOf, rationalChowBaseChange_rationalProperChowPushforward,
    rationalChowBaseChange_chernCharacterCap_of_rank k k' (V.ι ≫ sX) _ r, hK,
    rationalProperChowPushforward_chernCharacterCap _ _ _ _ (hb _) (hb _),
    rationalChowBaseChange_rationalProperChowPushforward]

/-- **Tag 0FVN for the Chern character of a finite locally free module**, of a rank which need
not be constant: `g^*(ch(ℰ) ∩ α) = ch(ℰ_{k'}) ∩ g^*α` on `CH_*(X) ⊗ 𝐐`, for `X` quasi-compact.
`CH_*(X)` is spanned by the pushforwards from the finitely many nonempty loci where `ℰ` has
constant rank, on which this is the case of constant rank, by the projection formula. -/
theorem rationalChowBaseChange_chernCharacterCap_classOf [CompactSpace X] (E : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]
    (t : DirectSum ℤ fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation k) sX j) :
    rationalChowBaseChange k k' sX (chernCharacterCap (fieldChowSituation k) sX
        (VectorBundleKZero.classOf X E) t) =
      chernCharacterCap (fieldChowSituation k') (pullback.snd sX (B₀).g)
        (VectorBundleKZero.classOf _ ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E))
        (rationalChowBaseChange k k' sX t) := by
  have hU := isClopenDecomposition_rankLociFamily E
  let S := (finite_nonempty_of_isClopenDecomposition hU).toFinset
  have hS : ∀ i, ((rankLociFamily E i : X.Opens) : Set X).Nonempty → i ∈ S :=
    fun i hi => (Set.Finite.mem_toFinset _).mpr hi
  refine LinearMap.congr_fun (f := rationalChowBaseChange k k' sX ∘ₗ
      chernCharacterCap (fieldChowSituation k) sX (VectorBundleKZero.classOf X E))
    (g := chernCharacterCap (fieldChowSituation k') (pullback.snd sX (B₀).g)
        (VectorBundleKZero.classOf _ ((Scheme.Modules.pullback (pullback.fst sX (B₀).g)).obj E)) ∘ₗ
      rationalChowBaseChange k k' sX)
    (rationalChowHomology_linearMap_ext _ _ fun n q α => ?_) t
  rw [← sum_properChowPushforward_chowGroupRestrict (fieldChowSituation k) sX hU S hS n α,
    TensorProduct.tmul_sum, map_sum, map_sum, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  have := hU.isProper_ι i
  have := isFiniteLocallyFreeOfRank_pullback_rankLociFamily E i
  rw [← rationalProperChowPushforward_of_tmul]
  exact rationalChowBaseChange_chernCharacterCap_rationalProperChowPushforward k k' sX E
    (rankLociFamily E i) i.down _

/-- **Tag 0FVN for the Chern character**: `g^*(ch(β) ∩ α) = ch((X_{k'} → X)^*β) ∩ g^*α` on
`CH_*(X) ⊗ 𝐐`, for every `β ∈ K₀(Vect(X))` and `X` quasi-compact. -/
theorem rationalChowBaseChange_chernCharacterCap [CompactSpace X]
    (a : VectorBundleKZero X)
    (t : DirectSum ℤ fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation k) sX j) :
    rationalChowBaseChange k k' sX (chernCharacterCap (fieldChowSituation k) sX a t) =
      chernCharacterCap (fieldChowSituation k') (pullback.snd sX (B₀).g)
        (VectorBundleKZero.pullback (pullback.fst sX (B₀).g) a)
        (rationalChowBaseChange k k' sX t) := by
  let φ : VectorBundleKZero X →+ ((DirectSum ℤ fun j : ℤ =>
      ℚ ⊗[ℤ] chowGroup (fieldChowSituation k) sX j) →ₗ[ℚ]
        DirectSum ℤ fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation k')
          (pullback.snd sX (B₀).g) j) :=
    AddMonoidHom.mk' (fun a => rationalChowBaseChange k k' sX ∘ₗ
      chernCharacterCap (fieldChowSituation k) sX a) fun a b => by
        rw [← chernCharacterCapHom_apply, map_add, chernCharacterCapHom_apply,
          chernCharacterCapHom_apply, LinearMap.comp_add]
  let ψ : VectorBundleKZero X →+ ((DirectSum ℤ fun j : ℤ =>
      ℚ ⊗[ℤ] chowGroup (fieldChowSituation k) sX j) →ₗ[ℚ]
        DirectSum ℤ fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation k')
          (pullback.snd sX (B₀).g) j) :=
    AddMonoidHom.mk' (fun a => chernCharacterCap (fieldChowSituation k') (pullback.snd sX (B₀).g)
      (VectorBundleKZero.pullback (pullback.fst sX (B₀).g) a) ∘ₗ rationalChowBaseChange k k' sX)
      fun a b => by
        rw [map_add, ← chernCharacterCapHom_apply, map_add, chernCharacterCapHom_apply,
          chernCharacterCapHom_apply, LinearMap.add_comp]
  have hφψ : φ = ψ := VectorBundleKZero.addHom_ext fun M hM => by
    have := (Stacks.FiniteLocallyFree.isFiniteLocallyFree_iff_algebraicGeometry M).mp hM
    refine LinearMap.ext fun t => ?_
    show rationalChowBaseChange k k' sX (chernCharacterCap _ sX _ t) =
      chernCharacterCap _ _ (VectorBundleKZero.pullback _ _) (rationalChowBaseChange k k' sX t)
    rw [VectorBundleKZero.pullback_classOf]
    exact rationalChowBaseChange_chernCharacterCap_classOf k k' sX M t
  exact LinearMap.congr_fun (DFunLike.congr_fun hφψ a) t

end ChernCharacter

/-! ### Open subschemes and restriction -/

section Restriction

variable (k k' : Type u) [Field k] [Field k'] [Algebra k k']

local notation "B₀" => fieldExtensionBaseChangeSituation k k'

variable {X : Scheme.{u}} (sX : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType sX]

/-- The base change of an open immersion is an open immersion. -/
instance isOpenImmersion_baseChangeMorphism {Y : Scheme.{u}} (j : Y ⟶ X) [IsOpenImmersion j] :
    IsOpenImmersion (baseChangeMorphism B₀ sX j) := by
  rw [← (isPullback_baseChangeMorphism B₀ sX j).isoPullback_hom_snd]
  infer_instance

omit [LocallyOfFiniteType sX] in
/-- The base change `U_{k'} → X_{k'}` of an open subscheme `U ⊆ X` is the inclusion of the
preimage of `U`. -/
theorem opensRange_baseChangeMorphism (U : X.Opens) :
    (baseChangeMorphism B₀ sX U.ι).opensRange = (pullback.fst sX (B₀).g) ⁻¹ᵁ U := by
  have h := isPullback_baseChangeMorphism B₀ sX U.ι
  have e := Scheme.Hom.opensRange_comp_of_isIso h.isoPullback.hom
    (pullback.snd U.ι (pullback.fst sX (B₀).g))
  rw [Scheme.Hom.opensRange_pullbackSnd, Scheme.Opens.opensRange_ι] at e
  refine Eq.trans ?_ e
  apply TopologicalSpace.Opens.ext
  simp only [Scheme.Hom.coe_opensRange]
  rw [h.isoPullback_hom_snd]

/-- **`g^*` commutes with restriction to an open subscheme** (Tag 0FVK for the open immersion):
the restriction to `U_{k'}` of `g^*α` is `g^*` of the restriction of `α` to `U`. -/
theorem chowGroupRestrict_chowBaseChange {Y : Scheme.{u}} (j : Y ⟶ X) [IsOpenImmersion j]
    (n : ℤ) (α : chowGroup (fieldChowSituation k) sX n) :
    chowGroupRestrict (fieldChowSituation k') (pullback.snd sX (B₀).g)
        (pullback.snd (j ≫ sX) (B₀).g) (baseChangeMorphism B₀ sX j)
        (baseChangeMorphism_comp_snd B₀ sX j) n (chowBaseChange k k' sX n α) =
      chowBaseChange k k' (j ≫ sX) n
        (chowGroupRestrict (fieldChowSituation k) sX (j ≫ sX) j rfl n α) := by
  have hk : ∀ m : ℤ, m + ((0 : ℕ) : ℤ) = m := fun m => by simp
  have hres : ∀ {C : ChowSituation.{u}} {A Z : Scheme.{u}} (sA : A ⟶ C.S)
      [LocallyOfFiniteType sA] (sZ : Z ⟶ C.S) [LocallyOfFiniteType sZ] (i : Z ⟶ A)
      [IsOpenImmersion i] (hi : i ≫ sA = sZ) (m : ℤ) (x : chowGroup C sA m),
      flatPullbackChowOfRelativeDimension C sZ sA i hi 0 (relativeDimension_of_isOpenImmersion i)
        m x ≍ chowGroupRestrict C sA sZ i hi m x := by
    intro C A Z sA _ sZ _ i _ hi m x
    rw [← cast_flatPullbackChow_eq_chowGroupRestrict C sA sZ i hi m (hk m)]
    exact (eqRec_heq _ _).symm
  refine eq_of_heq ?_
  rw [chowBaseChange_apply, chowBaseChange_apply]
  refine HEq.trans (heq_apply_of_degree_eq (fun d => chowGroupRestrict (fieldChowSituation k')
    (pullback.snd sX (B₀).g) (pullback.snd (j ≫ sX) (B₀).g) (baseChangeMorphism B₀ sX j)
    (baseChangeMorphism_comp_snd B₀ sX j) d) (add_zero n).symm (chowGroupCast_heq _ _ _ _)) ?_
  refine (hres _ _ _ _ _ _).symm.trans ?_
  rw [← baseChange_flatPullbackChow_apply B₀ (j ≫ sX) sX j rfl (baseChangeMorphism B₀ sX j)
    (baseChangeMorphism_comp_snd B₀ sX j) (baseChangeMorphism_comp_fst B₀ sX j).symm 0
    (relativeDimension_of_isOpenImmersion j) (relativeDimension_of_isOpenImmersion _) n
    (by simp) α]
  refine (chowGroupCast_heq _ _ _ _).trans ?_
  refine HEq.trans ?_ (chowGroupCast_heq _ _ _ _).symm
  exact heq_apply_of_degree_eq (fun d => baseChangeChowPullback B₀ (j ≫ sX) d) (hk n)
    (hres _ _ _ _ _ _)

/-! ### The parts of constant dimension -/

section Parts

open Stacks.WeilCohomology (dimPart partBase isClopenDecomposition_dimPart)

variable [Smooth sX]

/-- A point of `X_{k'}` lying over the part `X_d` lies in the part of dimension `d` of `X_{k'}`:
`(X_d)_{k'}` is an open subscheme of `X_{k'}` of relative dimension `d` over `k'`. -/
theorem mem_dimPart_of_fst_mem {d : ℕ} {x : (pullback sX (B₀).g : Scheme.{u})}
    (hx : (pullback.fst sX (B₀).g).base x ∈ dimPart sX d) :
    x ∈ dimPart (pullback.snd sX (B₀).g) d := by
  have hrange : x ∈ (baseChangeMorphism B₀ sX (dimPart sX d).ι).opensRange := by
    rw [opensRange_baseChangeMorphism]
    exact hx
  obtain ⟨y, rfl⟩ := hrange
  have hsq : IsPullback (pullback.fst (partBase sX d) (B₀).g)
      (baseChangeMorphism B₀ sX (dimPart sX d).ι ≫ pullback.snd sX (B₀).g) (partBase sX d)
      (B₀).g := by
    rw [baseChangeMorphism_comp_snd]
    exact IsPullback.of_hasPullback _ _
  have hrel : RelativeDimension (baseChangeMorphism B₀ sX (dimPart sX d).ι ≫
      pullback.snd sX (B₀).g) d :=
    RelativeDimension.of_isPullback hsq (Stacks.WeilCohomology.relativeDimension_partBase sX d)
  have h1 := topologicalKrullDimAt_fiber_eq_of_relativeDimension _ ⊤ d
    (hrel.comp_isOpenImmersion (⊤ : Scheme.Opens _).ι) y trivial
  rw [fiberDimensionAt_comp_openImmersion] at h1
  have h2 := relativeDimensionFunction_apply (pullback.snd sX (B₀).g)
    (fun s ↦ isCohenMacaulay_fiber_of_smooth (pullback.snd sX (B₀).g) s)
    ((baseChangeMorphism B₀ sX (dimPart sX d).ι).base y)
  rw [Stacks.WeilCohomology.dimPart, mem_relativeDimensionOpen]
  exact_mod_cast h2.symm.trans h1

/-- **The part of dimension `d` of `X_{k'}` is the preimage of the part `X_d` of `X`.** -/
theorem preimage_dimPart (d : ℕ) :
    (pullback.fst sX (B₀).g) ⁻¹ᵁ dimPart sX d = dimPart (pullback.snd sX (B₀).g) d := by
  ext x
  refine ⟨fun hx => mem_dimPart_of_fst_mem k k' sX hx, fun hx => ?_⟩
  obtain ⟨e, he⟩ := (isClopenDecomposition_dimPart sX).exists_mem ((pullback.fst sX (B₀).g).base x)
  have hxe := mem_dimPart_of_fst_mem k k' sX he
  by_cases hed : e = d
  · subst hed
    exact he
  · exact absurd hx (Set.disjoint_left.mp (TopologicalSpace.Opens.coe_disjoint.mpr
      ((isClopenDecomposition_dimPart (pullback.snd sX (B₀).g)).disjoint e d hed)) hxe)

end Parts

/-! ### The fundamental class -/

section Fundamental

open Stacks.WeilCohomology (dimPart partBase isClopenDecomposition_dimPart)

/-- The δ-dimension of a scheme over `k` of constant relative dimension `d` is at most `d`, whatever
structure morphism equal to the given one is used. -/
private theorem schemeDeltaDimension_le_of_eq_of_relativeDimension {Y : Scheme.{u}}
    {q q' : Y ⟶ (fieldChowSituation k).S} [LocallyOfFiniteType q] [Flat q]
    [LocallyOfFiniteType q'] [Flat q'] (h : q = q') {d : ℕ} (hq' : RelativeDimension q' d) :
    schemeDeltaDimension (fieldChowSituation k) q ≤ ((d : ℤ) : EInt) := by
  subst h
  exact Stacks.WeilCohomology.schemeDeltaDimension_le_of_relativeDimension q hq'

/-- **`g^*[Y]_n = [Y_{k'}]_n`** for `Y` flat over `k` of constant relative dimension: in degree
`d = dim Y` this is Chow Homology, Lemma 0FVI for `Y ⊆ Y`, in the other degrees both classes
vanish. -/
theorem chowBaseChange_fundamentalChowClass_of_relativeDimension {Y : Scheme.{u}}
    (sY : Y ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType sY] [Flat sY] {d : ℕ}
    (hY : RelativeDimension sY d) (n : ℤ) :
    chowBaseChange k k' sY n (fundamentalChowClass (fieldChowSituation k) sY n) =
      fundamentalChowClass (fieldChowSituation k') (pullback.snd sY (B₀).g) n := by
  have hY' : RelativeDimension (pullback.snd sY (B₀).g) d :=
    RelativeDimension.of_isPullback (IsPullback.of_hasPullback sY (B₀).g) hY
  by_cases hn : n = d
  · subst hn
    rw [chowBaseChange_apply, fundamentalChowClass, baseChangeChowPullback_mk, fundamentalCycle,
      baseChangeCyclePullback_cycleAssociatedToClosedSubscheme B₀ sY (𝟙 Y) d
        (schemeDeltaDimension_le_of_eq_of_relativeDimension k (Category.id_comp sY) hY),
      SectionZeroScheme.chowGroupCast_mk_cycle, fundamentalChowClass, fundamentalCycle,
      cycleAssociatedToClosedSubscheme_eq_of_iso _ _ (pullback.snd (𝟙 Y) (pullback.fst sY (B₀).g))
        (𝟙 _) (asIso (pullback.snd (𝟙 Y) (pullback.fst sY (B₀).g))) (Category.comp_id _)]
  · rw [Stacks.Chow.fundamentalChowClass_eq_zero_of_relativeDimension k sY hY hn, map_zero,
      Stacks.Chow.fundamentalChowClass_eq_zero_of_relativeDimension k' _ hY' hn]

variable [Smooth sX]

omit [LocallyOfFiniteType sX] in
/-- The open and closed decomposition of `X_{k'}` by the base changes of the parts of `X`. -/
theorem isClopenDecomposition_opensRange_baseChangeMorphism_dimPart :
    IsClopenDecomposition fun i : ULift.{u} ℕ =>
      (baseChangeMorphism B₀ sX (dimPart sX i.down).ι).opensRange := by
  have hU : IsClopenDecomposition fun i : ULift.{u} ℕ => dimPart sX i.down :=
    ⟨fun i j hij => (isClopenDecomposition_dimPart sX).disjoint i.down j.down
      fun h => hij (ULift.ext _ _ h),
      (ULift.down_surjective.iSup_comp (dimPart sX)).trans
        (isClopenDecomposition_dimPart sX).iSup_eq_top⟩
  simp only [opensRange_baseChangeMorphism]
  exact hU.preimage (pullback.fst sX (B₀).g)

/-- **`g^*[X]_n = [X_{k'}]_n`** for `X` smooth over `k`: both restrict to `[(X_d)_{k'}]_n` on
the base change of each part `X_d`. -/
theorem chowBaseChange_fundamentalChowClass (n : ℤ) :
    chowBaseChange k k' sX n (fundamentalChowClass (fieldChowSituation k) sX n) =
      fundamentalChowClass (fieldChowSituation k') (pullback.snd sX (B₀).g) n := by
  rw [← sub_eq_zero]
  refine eq_zero_of_chowGroupRestrict_eq_zero (fieldChowSituation k') (pullback.snd sX (B₀).g)
    (fun i : ULift.{u} ℕ => pullback.snd (partBase sX i.down) (B₀).g)
    (fun i => baseChangeMorphism B₀ sX (dimPart sX i.down).ι)
    (fun i => baseChangeMorphism_comp_snd B₀ sX _)
    (isClopenDecomposition_opensRange_baseChangeMorphism_dimPart k k' sX) n _ fun i => ?_
  rw [map_sub, sub_eq_zero, chowGroupRestrict_chowBaseChange,
    chowGroupRestrict_fundamentalChowClass_of_isOpenImmersion,
    chowGroupRestrict_fundamentalChowClass_of_isOpenImmersion]
  exact chowBaseChange_fundamentalChowClass_of_relativeDimension k k' (partBase sX i.down)
    (Stacks.WeilCohomology.relativeDimension_partBase sX i.down) n

/-- **`g^*[X] = [X_{k'}]`** in `CH_*(-) ⊗ 𝐐`, for `X` smooth over `k`. -/
theorem rationalChowBaseChange_rationalFundamentalClass [IsNoetherian X]
    [IsNoetherian (pullback sX (B₀).g : Scheme.{u})] :
    rationalChowBaseChange k k' sX (rationalFundamentalClass (fieldChowSituation k) sX) =
      rationalFundamentalClass (fieldChowSituation k') (pullback.snd sX (B₀).g) := by
  classical
  have hsum : ∀ {K : Type u} [Field K] {Z : Scheme.{u}} (s : Z ⟶ (fieldChowSituation K).S)
      [LocallyOfFiniteType s] [IsNoetherian Z] (T : Finset ℤ),
      (fundamentalClassDegrees_finite (fieldChowSituation K) s).toFinset ⊆ T →
      rationalFundamentalClass (fieldChowSituation K) s = ∑ n ∈ T,
        DirectSum.of (fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation K) s j) n
          ((1 : ℚ) ⊗ₜ[ℤ] fundamentalChowClass (fieldChowSituation K) s n) := by
    intro K _ Z s _ _ T hT
    rw [rationalFundamentalClass_eq]
    refine Finset.sum_subset hT fun n _ hn => ?_
    rw [fundamentalChowClass, fundamentalCycle_eq_zero_of_notMem_fundamentalClassDegrees _ s
      fun h => hn ((Set.Finite.mem_toFinset _).mpr h), map_zero, TensorProduct.tmul_zero, map_zero]
  rw [hsum sX _ (Finset.subset_union_left (s₂ := (fundamentalClassDegrees_finite
      (fieldChowSituation k') (pullback.snd sX (B₀).g)).toFinset)),
    hsum _ _ Finset.subset_union_right, map_sum]
  refine Finset.sum_congr rfl fun n _ => ?_
  rw [rationalChowBaseChange_of_tmul]
  exact congrArg _ (congrArg _ (chowBaseChange_fundamentalChowClass k k' sX n))

/-- **`g^*(ch(β) ∩ [X]) = ch((X_{k'} → X)^*β) ∩ [X_{k'}]`** in `CH_*(X_{k'}) ⊗ 𝐐`, for
`β ∈ K₀(Vect(X)) ⊗ 𝐐` and `X` smooth and Noetherian over `k`. -/
theorem rationalChowBaseChange_rationalChernCharacterCap [IsNoetherian X]
    [IsNoetherian (pullback sX (B₀).g : Scheme.{u})]
    (a : ℚ ⊗[ℤ] VectorBundleKZero X) :
    rationalChowBaseChange k k' sX (rationalChernCharacterCap (fieldChowSituation k) sX a
        (rationalFundamentalClass (fieldChowSituation k) sX)) =
      rationalChernCharacterCap (fieldChowSituation k') (pullback.snd sX (B₀).g)
        ((VectorBundleKZero.pullback (pullback.fst sX (B₀).g)).toIntLinearMap.baseChange ℚ a)
        (rationalFundamentalClass (fieldChowSituation k') (pullback.snd sX (B₀).g)) := by
  induction a using TensorProduct.induction_on with
  | zero => simp only [map_zero, LinearMap.zero_apply]
  | add a b ha hb => simp only [map_add, LinearMap.add_apply, ha, hb]
  | tmul q α =>
    rw [LinearMap.baseChange_tmul, rationalChernCharacterCap_tmul,
      rationalChernCharacterCap_tmul, LinearMap.smul_apply, LinearMap.smul_apply, map_smul,
      rationalChowBaseChange_chernCharacterCap, rationalChowBaseChange_rationalFundamentalClass]
    rfl

end Fundamental

/-! ### Classes of codimension `i` -/

section Codimension

open Stacks.WeilCohomology (dimPart partBase isClopenDecomposition_dimPart)

section General

variable (K : Type u) [Field K] {Z : Scheme.{u}} (sZ : Z ⟶ (fieldChowSituation K).S) [Smooth sZ]

/-- The class `α_{(n)}` of dimension `n` of `α ∈ CH^i(Z)` restricts to zero on the parts `Z_e`
with `e - i ≠ n`. -/
theorem chowGroupRestrict_dimPart_chowCodimTotal_of_ne {i : ℕ} {n : ℤ} {e : ℕ}
    (h : (e : ℤ) - i ≠ n) (α : codimensionChowGroup K sZ i) :
    chowGroupRestrict (fieldChowSituation K) sZ (partBase sZ e) (dimPart sZ e).ι rfl n
      (chowCodimTotal K sZ i n α) = 0 := by
  rw [← chowGroupDimPartEquiv_apply K sZ n _ ⟨e⟩]
  show chowGroupDimPartEquiv K sZ n ((chowGroupDimPartEquiv K sZ n).symm _) ⟨e⟩ = 0
  rw [AddEquiv.apply_symm_apply, dif_neg h]

/-- **`(chowCodimPart γ i)_{(n)} = γ_n`** for a family `γ` whose class `γ_n` vanishes on the parts
`Z_e` with `e - i ≠ n`. -/
theorem chowCodimTotal_chowCodimPart_of_restrict_eq_zero
    (γ : ∀ n : ℤ, chowGroup (fieldChowSituation K) sZ n) (i : ℕ) (n : ℤ)
    (hγ : ∀ e : ℕ, (e : ℤ) - i ≠ n → chowGroupRestrict (fieldChowSituation K) sZ (partBase sZ e)
      (dimPart sZ e).ι rfl n (γ n) = 0) :
    chowCodimTotal K sZ i n (chowCodimPart K sZ γ i) = γ n := by
  refine (chowGroupDimPartEquiv K sZ n).injective (funext fun d' ↦ ?_)
  show chowGroupDimPartEquiv K sZ n ((chowGroupDimPartEquiv K sZ n).symm _) d' = _
  rw [AddEquiv.apply_symm_apply, chowGroupDimPartEquiv_apply]
  by_cases h : (d'.down : ℤ) - i = n
  · rw [dif_pos h]
    subst h
    rfl
  · rw [dif_neg h]
    exact (hγ d'.down h).symm

/-- **The class in `CH_*(Z) ⊗ 𝐐` of `α ∈ CH^i(Z)`** is `∑_d 1 ⊗ α_{(d-i)}`, over any finite set
of dimensions containing those of the nonempty parts of `Z`. -/
theorem codimensionToRationalChow_eq_sum [CompactSpace Z] (i : ℕ) (S : Finset ℕ)
    (hS : nonemptyDimParts K sZ ⊆ S) (α : codimensionChowGroup K sZ i) :
    codimensionToRationalChow K sZ i α = ∑ d ∈ S,
      DirectSum.of (fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation K) sZ j) ((d : ℤ) - i)
        ((1 : ℚ) ⊗ₜ chowCodimTotal K sZ i ((d : ℤ) - i) α) := by
  rw [codimensionToRationalChow_apply]
  have hterm : ∀ d : ℕ, have := (isClopenDecomposition_dimPart sZ).isProper_ι d
      rationalIncludePart K sZ d (DirectSum.of (fun j : ℤ => ℚ ⊗[ℤ]
        chowGroup (fieldChowSituation K) (partBase sZ d) j) ((d : ℤ) - i) ((1 : ℚ) ⊗ₜ[ℤ] α d)) =
      DirectSum.of (fun j : ℤ => ℚ ⊗[ℤ] chowGroup (fieldChowSituation K) sZ j) ((d : ℤ) - i)
        ((1 : ℚ) ⊗ₜ chowCodimTotal K sZ i ((d : ℤ) - i) α) := fun d => by
    have := (isClopenDecomposition_dimPart sZ).isProper_ι d
    rw [rationalProperChowPushforward_of_tmul, properChowPushforward_dimPart_eq_chowCodimTotal]
  rw [Finset.sum_congr rfl fun d _ => hterm d]
  refine Finset.sum_subset hS fun d _ hd => ?_
  have := (isClopenDecomposition_dimPart sZ).isProper_ι d
  have : IsEmpty (dimPart sZ d).toScheme :=
    ⟨fun y ↦ hd ((mem_nonemptyDimParts K sZ).2 ⟨y.1, y.2⟩)⟩
  have := subsingleton_chowGroup_of_isEmpty (fieldChowSituation K) (partBase sZ d)
    ((d : ℤ) - i)
  rw [← properChowPushforward_dimPart_eq_chowCodimTotal, Subsingleton.elim (α d) 0, map_zero,
    TensorProduct.tmul_zero, map_zero]

end General

variable [Smooth sX]

/-- **`g^*` preserves classes supported on a part**: if `z` restricts to zero on `X_e`, then
`g^*z` restricts to zero on the part `(X_{k'})_e`, the preimage of `X_e`. -/
theorem chowGroupRestrict_dimPart_chowBaseChange_eq_zero {n : ℤ} {e : ℕ}
    {z : chowGroup (fieldChowSituation k) sX n}
    (hz : chowGroupRestrict (fieldChowSituation k) sX (partBase sX e) (dimPart sX e).ι rfl n z
      = 0) :
    chowGroupRestrict (fieldChowSituation k') (pullback.snd sX (B₀).g)
      (partBase (pullback.snd sX (B₀).g) e) (dimPart (pullback.snd sX (B₀).g) e).ι rfl n
      (chowBaseChange k k' sX n z) = 0 := by
  have h1 := chowGroupRestrict_chowBaseChange k k' sX (dimPart sX e).ι n z
  rw [hz, map_zero, chowGroupRestrict_eq_chowPushforwardOfIso, AddMonoidHom.comp_apply] at h1
  have h2 := chowPushforwardOfIso_injective _ _ _ _ _ _ (h1.trans (map_zero _).symm)
  have hW : (baseChangeMorphism B₀ sX (dimPart sX e).ι).opensRange =
      dimPart (pullback.snd sX (B₀).g) e := by
    rw [opensRange_baseChangeMorphism, preimage_dimPart]
  have key : ∀ W : (pullback sX (B₀).g : Scheme.{u}).Opens,
      W = dimPart (pullback.snd sX (B₀).g) e →
      chowGroupOpensRestrictOfIsOpenImmersion (fieldChowSituation k') (pullback.snd sX (B₀).g) W n
        (chowBaseChange k k' sX n z) = 0 →
      chowGroupRestrict (fieldChowSituation k') (pullback.snd sX (B₀).g)
        (partBase (pullback.snd sX (B₀).g) e) (dimPart (pullback.snd sX (B₀).g) e).ι rfl n
        (chowBaseChange k k' sX n z) = 0 := by
    intro W hW h
    subst hW
    rw [chowGroupRestrict_opensι]
    exact h
  exact key _ hW h2

/-- **The base change `g^* : CH^i(X) → CH^i(X_{k'})`** of Tag 0FVJ read on classes of codimension
`i`: the class of dimension `n` of `α` is base changed in each dimension, and the result is read on
the parts of `X_{k'}`, the preimages of the parts of `X`. -/
def codimensionChowBaseChange (i : ℕ) :
    codimensionChowGroup k sX i →+ codimensionChowGroup k' (pullback.snd sX (B₀).g) i where
  toFun α := chowCodimPart k' (pullback.snd sX (B₀).g)
    (fun n => chowBaseChange k k' sX n (chowCodimTotal k sX i n α)) i
  map_zero' := by
    simp only [map_zero]
    exact chowCodimPart_zero k' _ i
  map_add' α β := by
    simp only [map_add]
    exact chowCodimPart_add k' _ _ _ i

/-- `g^*` on `CH^i(X)`, unfolded. -/
theorem codimensionChowBaseChange_apply (i : ℕ) (α : codimensionChowGroup k sX i) :
    codimensionChowBaseChange k k' sX i α = chowCodimPart k' (pullback.snd sX (B₀).g)
      (fun n => chowBaseChange k k' sX n (chowCodimTotal k sX i n α)) i :=
  rfl

/-- The class of dimension `n` of `g^*α ∈ CH^i(X_{k'})` is `g^*` of that of `α`. -/
theorem chowCodimTotal_codimensionChowBaseChange (i : ℕ) (n : ℤ)
    (α : codimensionChowGroup k sX i) :
    chowCodimTotal k' (pullback.snd sX (B₀).g) i n (codimensionChowBaseChange k k' sX i α) =
      chowBaseChange k k' sX n (chowCodimTotal k sX i n α) := by
  rw [codimensionChowBaseChange_apply]
  exact chowCodimTotal_chowCodimPart_of_restrict_eq_zero k' (pullback.snd sX (B₀).g)
    (fun n => chowBaseChange k k' sX n (chowCodimTotal k sX i n α)) i n fun e he =>
      chowGroupRestrict_dimPart_chowBaseChange_eq_zero k k' sX
        (chowGroupRestrict_dimPart_chowCodimTotal_of_ne k sX he α)

/-- **`g^*` on `CH^i` and on `CH_*(-) ⊗ 𝐐` agree**: the class in `CH_*(X_{k'}) ⊗ 𝐐` of `g^*α` is
`g^*` of the class of `α`. -/
theorem codimensionToRationalChow_codimensionChowBaseChange [CompactSpace X]
    [CompactSpace (pullback sX (B₀).g : Scheme.{u})] (i : ℕ) (α : codimensionChowGroup k sX i) :
    codimensionToRationalChow k' (pullback.snd sX (B₀).g) i
        (codimensionChowBaseChange k k' sX i α) =
      rationalChowBaseChange k k' sX (codimensionToRationalChow k sX i α) := by
  classical
  let S := nonemptyDimParts k sX ∪ nonemptyDimParts k' (pullback.snd sX (B₀).g)
  rw [codimensionToRationalChow_eq_sum k' _ i S Finset.subset_union_right,
    codimensionToRationalChow_eq_sum k sX i S Finset.subset_union_left, map_sum]
  refine Finset.sum_congr rfl fun d _ => ?_
  rw [rationalChowBaseChange_of_tmul, chowCodimTotal_codimensionChowBaseChange]

end Codimension

end Restriction

/-! ### Smooth projective schemes -/

section SmoothProjective

open Stacks.WeilCohomology.SmoothProjectiveScheme

variable {k k' : Type u} [Field k] [Field k'] [Algebra k k']

/-- **The base change `g^* : CH^i(X) → CH^i(X_{k'})`** of Tag 0FVJ, for `X` smooth projective
over `k`: the map of Chow groups of Chow Homology, Lemma 0FVJ, for `g : Spec(k') → Spec(k)`,
read on `CH^i(X) = ∏_d CH_{d-i}(X_d)`, the part of dimension `d` of `X_{k'}` being the preimage of
`X_d` (`Stacks.WeilDeRham.preimage_dimPart`). -/
def chowCodimBaseChange (X : (SmoothProjectiveScheme k).FullSubcategory) (i : ℕ) :
    codimensionChowGroup k X.obj.hom i →+
      codimensionChowGroup k' ((fieldBaseChange k k').obj X).obj.hom i :=
  codimensionChowBaseChange k k' X.obj.hom i

/-- **`g^*` on `CH^*(X) ⊗ 𝐐`**, for `X` smooth projective over `k`. -/
def rationalChowRingBaseChange (X : (SmoothProjectiveScheme k).FullSubcategory) :
    smoothRationalChowRing (k := k) X.obj.hom →ₗ[ℚ]
      smoothRationalChowRing (k := k') ((fieldBaseChange k k').obj X).obj.hom :=
  rationalChowBaseChange k k' X.obj.hom

/-- **The class in `CH^*(X_{k'}) ⊗ 𝐐` of `g^*α` is `g^*` of the class of `α`**, for
`α ∈ CH^i(X)`. -/
theorem codimensionClass_chowCodimBaseChange (X : (SmoothProjectiveScheme k).FullSubcategory)
    (i : ℕ) (α : codimensionChowGroup k X.obj.hom i) :
    smoothChowEquiv ((fieldBaseChange k k').obj X).obj.hom
        (codimensionToRationalChow k' ((fieldBaseChange k k').obj X).obj.hom i
          (chowCodimBaseChange X i α)) =
      rationalChowRingBaseChange X
        (smoothChowEquiv X.obj.hom (codimensionToRationalChow k X.obj.hom i α)) := by
  have : CompactSpace (pullback X.obj.hom (fieldExtensionBaseChangeSituation k k').g :
      Scheme.{u}) := compactSpace_left ((fieldBaseChange k k').obj X)
  exact codimensionToRationalChow_codimensionChowBaseChange k k' X.obj.hom i α

/-- **`g^*(ch(β) ∩ [X]) = ch((X_{k'} → X)^*β) ∩ [X_{k'}]`** in `CH^*(X_{k'}) ⊗ 𝐐`, for
`β ∈ K₀(Vect(X)) ⊗ 𝐐`: Chow Homology, Lemmas 0FVN and 0FVI. -/
theorem rationalChowRingBaseChange_rationalChernCharacterEquiv
    (X : (SmoothProjectiveScheme k).FullSubcategory)
    (a : ℚ ⊗[ℤ] VectorBundleKZero ((toScheme k).obj X)) :
    rationalChowRingBaseChange X (rationalChernCharacterAlgEquiv
        (isRegular_of_smooth_over_field X.obj.hom)
        (exists_bounds_relativeDimension_fieldChowSituation k X.obj.hom) a) =
      rationalChernCharacterAlgEquiv
        (isRegular_of_smooth_over_field ((fieldBaseChange k k').obj X).obj.hom)
        (exists_bounds_relativeDimension_fieldChowSituation k'
          ((fieldBaseChange k k').obj X).obj.hom)
        ((VectorBundleKZero.pullback (fieldBaseChangeProj X)).toIntLinearMap.baseChange ℚ a) := by
  have : IsNoetherian (pullback X.obj.hom (fieldExtensionBaseChangeSituation k k').g :
      Scheme.{u}) := isNoetherian_left ((fieldBaseChange k k').obj X)
  exact rationalChowBaseChange_rationalChernCharacterCap k k' X.obj.hom a

/-- `g^*` commutes with proper pushforward, for the structure morphism of the source an
independent morphism. -/
theorem chowBaseChange_properChowPushforward_of_base {X Y : Scheme.{u}}
    (sX : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType sX]
    (sY : Y ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType sY] (f : X ⟶ Y) [IsProper f]
    (hbase : f ≫ sY = sX)
    (f' : (pullback sX (fieldExtensionBaseChangeSituation k k').g : Scheme.{u}) ⟶
      (pullback sY (fieldExtensionBaseChangeSituation k k').g : Scheme.{u})) [IsProper f']
    (hfst : f' ≫ pullback.fst sY (fieldExtensionBaseChangeSituation k k').g =
      pullback.fst sX (fieldExtensionBaseChangeSituation k k').g ≫ f)
    (hsnd : f' ≫ pullback.snd sY (fieldExtensionBaseChangeSituation k k').g =
      pullback.snd sX (fieldExtensionBaseChangeSituation k k').g) (n : ℤ)
    (α : chowGroup (fieldChowSituation k) sX n) :
    chowBaseChange k k' sY n (properChowPushforward (fieldChowSituation k) sX sY f hbase n
        (properPushforwardDescends _ _ _ _ _ _) α) =
      properChowPushforward (fieldChowSituation k')
        (pullback.snd sX (fieldExtensionBaseChangeSituation k k').g)
        (pullback.snd sY (fieldExtensionBaseChangeSituation k k').g) f' hsnd n
        (properPushforwardDescends _ _ _ _ _ _) (chowBaseChange k k' sX n α) := by
  rw [chowBaseChange_apply, chowBaseChange_apply, ← Stacks.Chow.properChowPushforward_chowGroupCast]
  exact congrArg (chowGroupCast _ _ (add_zero n))
    (properChowPushforward_baseChangeChowPullback_of_base (fieldExtensionBaseChangeSituation k k')
      sX sY f hbase f' hfst hsnd n α).symm

/-- The class of dimension `n` of `[X] ∈ CH^0(X)` is `[X]_n`, for `X` smooth over `k`. -/
theorem chowCodimTotal_chowCodimFundamental_of_smooth {K : Type u} [Field K] {Z : Scheme.{u}}
    (sZ : Z ⟶ (fieldChowSituation K).S) [Smooth sZ] (n : ℤ) :
    chowCodimTotal K sZ 0 n (chowCodimFundamental K sZ) =
      fundamentalChowClass (fieldChowSituation K) sZ n := by
  have hF : chowCodimFundamental K sZ =
      chowCodimPart K sZ (fun n ↦ fundamentalChowClass (fieldChowSituation K) sZ n) 0 := by
    funext d
    exact (chowGroupRestrict_fundamentalChowClass_of_isOpenImmersion _ sZ (partBase sZ d)
      (dimPart sZ d).ι rfl _).symm
  rw [hF]
  refine chowCodimTotal_chowCodimPart_of_restrict_eq_zero K sZ _ 0 n fun e he => ?_
  rw [chowGroupRestrict_fundamentalChowClass_of_isOpenImmersion]
  exact Stacks.Chow.fundamentalChowClass_eq_zero_of_relativeDimension K _
    (Stacks.WeilCohomology.relativeDimension_partBase sZ e) (by simpa using he.symm)

/-- `g^*` of a class of codimension `i` given by its classes in each dimension. -/
theorem codimensionChowBaseChange_chowCodimPart {X : Scheme.{u}}
    (sX : X ⟶ (fieldChowSituation k).S) [Smooth sX]
    (Q : ∀ n : ℤ, chowGroup (fieldChowSituation k) sX n) (i : ℕ) :
    codimensionChowBaseChange k k' sX i (chowCodimPart k sX Q i) =
      chowCodimPart k' (pullback.snd sX (fieldExtensionBaseChangeSituation k k').g)
        (fun n => chowBaseChange k k' sX n (Q n)) i := by
  rw [codimensionChowBaseChange_apply]
  funext e
  show chowGroupRestrict _ _ _ _ _ _ _ = chowGroupRestrict _ _ _ _ _ _ _
  rw [← sub_eq_zero, ← map_sub, ← map_sub]
  refine chowGroupRestrict_dimPart_chowBaseChange_eq_zero k k' sX ?_
  rw [map_sub, sub_eq_zero, ← chowGroupDimPartEquiv_apply k sX _ _ ⟨e⟩]
  show chowGroupDimPartEquiv k sX _ ((chowGroupDimPartEquiv k sX _).symm _) ⟨e⟩ = _
  rw [AddEquiv.apply_symm_apply, dif_pos rfl]
  rfl

/-- **`g^*[Δ] = [Δ_{k'}]`**: for `δ : X ⟶ P` in the category of smooth projective schemes over
`k` (for instance the diagonal of a fibre product `P` of `X` with itself), `g^*(δ_*[X]) =
(δ_{k'})_*[X_{k'}]` in `CH^d(P_{k'})`, the pushforward `chowCodimPushforward` read in codimension
`d`. Flat base change commutes with proper pushforward (Tag 0FVL) and takes `[X]` to `[X_{k'}]`
(Tag 0FVI). -/
theorem chowCodimBaseChange_diagonalChowClass {X P : (SmoothProjectiveScheme k).FullSubcategory}
    (δ : X ⟶ P) (d : ℕ) :
    chowCodimBaseChange P d (chowCodimPushforward k X.obj.hom P.obj.hom ((toScheme k).map δ)
        (w δ) 0 d (chowCodimFundamental k X.obj.hom)) =
      chowCodimPushforward k' ((fieldBaseChange k k').obj X).obj.hom
        ((fieldBaseChange k k').obj P).obj.hom ((toScheme k').map ((fieldBaseChange k k').map δ))
        (w ((fieldBaseChange k k').map δ)) 0 d
        (chowCodimFundamental k' ((fieldBaseChange k k').obj X).obj.hom) := by
  have hP : IsProper ((toScheme k').map ((fieldBaseChange k k').map δ)) := inferInstance
  have : IsProper (show (pullback X.obj.hom (fieldExtensionBaseChangeSituation k k').g :
      Scheme.{u}) ⟶ pullback P.obj.hom (fieldExtensionBaseChangeSituation k k').g from
        (toScheme k').map ((fieldBaseChange k k').map δ)) := hP
  show codimensionChowBaseChange k k' P.obj.hom d (chowCodimPart k P.obj.hom
      (fun n => properChowPushforward (fieldChowSituation k) X.obj.hom P.obj.hom
        ((toScheme k).map δ) (w δ) n (properPushforwardDescends _ _ _ _ _ _)
        (chowCodimTotal k X.obj.hom 0 n (chowCodimFundamental k X.obj.hom))) d) =
    chowCodimPart k' ((fieldBaseChange k k').obj P).obj.hom
      (fun n => properChowPushforward (fieldChowSituation k')
        ((fieldBaseChange k k').obj X).obj.hom ((fieldBaseChange k k').obj P).obj.hom
        ((toScheme k').map ((fieldBaseChange k k').map δ)) (w ((fieldBaseChange k k').map δ)) n
        (properPushforwardDescends _ _ _ _ _ _)
        (chowCodimTotal k' ((fieldBaseChange k k').obj X).obj.hom 0 n
          (chowCodimFundamental k' ((fieldBaseChange k k').obj X).obj.hom))) d
  rw [codimensionChowBaseChange_chowCodimPart]
  refine congrArg (fun Q => chowCodimPart k' (pullback.snd P.obj.hom
    (fieldExtensionBaseChangeSituation k k').g) Q d) (funext fun n => ?_)
  rw [chowCodimTotal_chowCodimFundamental_of_smooth,
    chowBaseChange_properChowPushforward_of_base X.obj.hom P.obj.hom ((toScheme k).map δ) (w δ)
      ((toScheme k').map ((fieldBaseChange k k').map δ)) (fieldBaseChange_map_comp_proj δ)
      (w ((fieldBaseChange k k').map δ)),
    chowBaseChange_fundamentalChowClass]
  exact congrArg (properChowPushforward (fieldChowSituation k')
    ((fieldBaseChange k k').obj X).obj.hom ((fieldBaseChange k k').obj P).obj.hom
    ((toScheme k').map ((fieldBaseChange k k').map δ)) (w ((fieldBaseChange k k').map δ)) n
    (properPushforwardDescends _ _ _ _ _ _))
    (chowCodimTotal_chowCodimFundamental_of_smooth ((fieldBaseChange k k').obj X).obj.hom n).symm

/-- **`g^*[Z]_n = [Z_{k'}]_n`** on cycles of a closed subscheme `i : Z ⟶ X` of δ-dimension at
most `n` (Tag 0FVI, part (1)): the base change of the class of `[Z]_n` is the class of the cycle
of the scheme-theoretic inverse image `Z ×_X X_{k'}`. -/
theorem chowBaseChange_mk_cycleAssociatedToClosedSubscheme {X Z : Scheme.{u}}
    (sX : X ⟶ (fieldChowSituation k).S) [LocallyOfFiniteType sX] (i : Z ⟶ X) [IsClosedImmersion i]
    (n : ℤ) (hZ : schemeDeltaDimension (fieldChowSituation k) (i ≫ sX) ≤ (n : EInt)) :
    chowBaseChange k k' sX n
        (QuotientAddGroup.mk (cycleAssociatedToClosedSubscheme (fieldChowSituation k) sX i n)) =
      QuotientAddGroup.mk (cycleAssociatedToClosedSubscheme (fieldChowSituation k')
        (pullback.snd sX (fieldExtensionBaseChangeSituation k k').g)
        (pullback.snd i (pullback.fst sX (fieldExtensionBaseChangeSituation k k').g)) n) := by
  rw [chowBaseChange_apply]
  have h1 := baseChangeChowPullback_mk (fieldExtensionBaseChangeSituation k k') sX n
    (cycleAssociatedToClosedSubscheme (fieldChowSituation k) sX i n)
  rw [baseChangeCyclePullback_cycleAssociatedToClosedSubscheme
    (fieldExtensionBaseChangeSituation k k') sX i n hZ] at h1
  exact (congrArg (chowGroupCast _ _ (add_zero n)) h1).trans
    (SectionZeroScheme.chowGroupCast_mk_cycle _ _ _ _)

/-- **`g^*[Z] = [Z_{k'}]`** in `CH^c`, for a closed subscheme `i : Z ⟶ X` of a scheme `X` smooth
over `k` of constant dimension `e`, of δ-dimension at most `e - c`: `g^*` of the class of the
closed subscheme `Z` is the class of its scheme-theoretic inverse image `Z ×_X X_{k'}`
(Tag 0FVI, part (1), on each part of `X_{k'}`). -/
theorem codimensionChowBaseChange_closedSubschemeClass {X Z : Scheme.{u}}
    (sX : X ⟶ (fieldChowSituation k).S) [Smooth sX] (i : Z ⟶ X) [IsClosedImmersion i] (c : ℕ)
    {e : ℕ} (hX : RelativeDimension sX e)
    (hZ : schemeDeltaDimension (fieldChowSituation k) (i ≫ sX) ≤ (((e : ℤ) - c : ℤ) : EInt)) :
    codimensionChowBaseChange k k' sX c (closedSubschemeClass sX i c) =
      closedSubschemeClass (pullback.snd sX (fieldExtensionBaseChangeSituation k k').g)
        (pullback.snd i (pullback.fst sX (fieldExtensionBaseChangeSituation k k').g)) c := by
  have hX' : RelativeDimension (pullback.snd sX (fieldExtensionBaseChangeSituation k k').g) e :=
    RelativeDimension.of_isPullback (IsPullback.of_hasPullback sX _) hX
  have h1 : closedSubschemeClass sX i c = chowCodimPart k sX (fun n => QuotientAddGroup.mk
      (cycleAssociatedToClosedSubscheme (fieldChowSituation k) sX i n)) c := rfl
  rw [h1, codimensionChowBaseChange_chowCodimPart]
  funext e'
  by_cases he : e' = e
  · subst he
    show chowGroupRestrict _ _ _ _ _ _ (chowBaseChange k k' sX _ _) =
      chowGroupRestrict _ _ _ _ _ _ _
    rw [chowBaseChange_mk_cycleAssociatedToClosedSubscheme sX i _ hZ]
  · have := Stacks.WeilCohomology.isEmpty_dimPart_of_ne _ hX' he
    exact @Subsingleton.elim _ (subsingleton_chowGroup_of_isEmpty _ _ _) _ _

/-- **`g^*[Z] = [Z_{k'}]`** in `CH^c(P_{k'})`, for a closed immersion `δ : Z ⟶ P` of smooth
projective schemes over `k`, `P` of constant dimension `e` and `Z` of constant dimension
`e - c` (for instance the diagonal `X ⟶ X × X`): `g^*` of the class of the closed subscheme `Z`
is the class of the closed subscheme `δ_{k'} : Z_{k'} ⟶ P_{k'}`. -/
theorem chowCodimBaseChange_closedSubschemeClass {Z P : (SmoothProjectiveScheme k).FullSubcategory}
    (δ : Z ⟶ P) [IsClosedImmersion δ.hom.left]
    [IsClosedImmersion ((fieldBaseChange k k').map δ).hom.left] (c : ℕ) {e n : ℕ}
    (hP : RelativeDimension P.obj.hom e) (hZ : RelativeDimension Z.obj.hom n)
    (hn : (n : ℤ) = e - c) :
    chowCodimBaseChange P c (closedSubschemeClass P.obj.hom δ.hom.left c) =
      closedSubschemeClass ((fieldBaseChange k k').obj P).obj.hom
        ((fieldBaseChange k k').map δ).hom.left c := by
  refine (codimensionChowBaseChange_closedSubschemeClass P.obj.hom δ.hom.left c hP
    (by rw [← hn]; exact schemeDeltaDimension_le_of_eq_of_relativeDimension k (w δ) hZ)).trans ?_
  have hsq : IsPullback (fieldBaseChangeProj Z) ((fieldBaseChange k k').map δ).hom.left
      δ.hom.left (pullback.fst P.obj.hom (fieldExtensionBaseChangeSituation k k').g) :=
    (isPullback_fieldBaseChange_map (k' := k') δ).flip
  have hc := @cycleAssociatedToClosedSubscheme_eq_of_iso (fieldChowSituation k') _ _ _
    (pullback.snd P.obj.hom (fieldExtensionBaseChangeSituation k k').g) _
    (pullback.snd δ.hom.left (pullback.fst P.obj.hom (fieldExtensionBaseChangeSituation k k').g))
    inferInstance ((fieldBaseChange k k').map δ).hom.left ‹_› hsq.isoPullback.symm
    hsq.isoPullback_inv_snd
  funext e'
  rw [closedSubschemeClass_apply, closedSubschemeClass_apply, hc]
  rfl

end SmoothProjective

