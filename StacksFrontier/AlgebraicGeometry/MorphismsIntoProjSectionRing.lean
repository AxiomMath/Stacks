namespace Stacks.AlgebraicGeometry.MorphismsIntoProj

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

universe u

/-! ### The carrier bridge is multiplicative -/

section Bridge

variable {Y : Scheme.{u}} (L : Y.Modules)

/-- `Stacks.AlgebraicGeometry.ProjChartFromRatios.secOf`, as an additive map
`Γ(Y, L^{⊗ n}) ⟶ (𝟙 ⟶ L^{⊗ n})`. -/
def secOfHom (n : ℕ) : Γ(natTensorPow L n, ⊤) →+ powSections L n :=
  (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv Y
    (natTensorPow L n)).symm.toAddMonoidHom

/-- `secOfHom` is `secOf`. -/
@[simp] theorem secOfHom_apply {n : ℕ} (s : Γ(natTensorPow L n, ⊤)) :
    secOfHom L n s = secOf L s := rfl

/-- The product `mulSections` of honest global sections of tensor powers is carried by `secOf` to
the product of the section ring `Γ_*(Y, L)` of Tag 01CV. -/
theorem secOf_mulSections {n m : ℕ} (s : Γ(natTensorPow L n, ⊤)) (t : Γ(natTensorPow L m, ⊤)) :
    secOf L (mulSections L s t) = Stacks.GradedSections.mul (secOf L s) (secOf L t) := by
  rw [← globalSection_secOf L s, ← globalSection_secOf L t, mulSections_globalSection,
    secOf_globalSection, secOf_globalSection, secOf_globalSection]

end Bridge

/-! ### The degreewise maps of `ψ^d_φ` on the tensor powers -/

variable {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] {Y : Scheme.{u}} {d : ℕ}

/-- **The invertible module `L = φ⁎𝒪_{U_d}(d)`** on `Y`, for a morphism `φ : Y ⟶ U_d`. -/
abbrev pullbackUniversalTwist (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) : Y.Modules :=
  (Scheme.Modules.pullback φ).obj (universalTwist 𝒜 d)

/-- **The degreewise maps `S_{nd} ⟶ Γ(Y, L^{⊗ n})` of `ψ^d_φ`**: the graded map `ψ^d` of the
universal family on `U_d`, followed by the pullback of global sections of tensor powers along `φ`.
They are multiplicative across degrees. -/
def psiPullbackPowSections (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) :
    VeroneseSections 𝒜 d (pullbackUniversalTwist 𝒜 φ) :=
  pullbackSections 𝒜 (universalVeroneseSections 𝒜 d) φ

/-- The degreewise value of `ψ^d_φ`: the section of `𝒪_{U_d}(nd)` attached to `a`, read on
`𝒪_{U_d}(d)^{⊗ n}` through `θ⁻¹`, then pulled back along `φ`. -/
theorem psiPullbackPowSections_toFun (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) (n : ℕ)
    (a : 𝒜 (n * d)) :
    (psiPullbackPowSections 𝒜 φ).toFun n a =
      pullSection φ (universalTwist 𝒜 d) n
        ((Stacks.AlgebraicGeometry.ProjTwistTensorPowDegreeOpen.thetaNat 𝒜 d n).inv.val.app (op ⊤)
          (Stacks.AlgebraicGeometry.CommonDegreeTwist.restrictedDegreeSection 𝒜
            (degreeOpen 𝒜 d) (n * d) a)) :=
  rfl

/-- **`L` is generated by the sections `ψ^d_φ(f)`, `f ∈ S_d`**, in the geometric form: their
nonvanishing opens cover `Y`. -/
theorem iSup_nonvanishingOpen_psiPullbackPowSections (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) :
    (⨆ f : 𝒜 d, nonvanishingOpen Y (pullbackUniversalTwist 𝒜 φ)
      (psiSection 𝒜 (psiPullbackPowSections 𝒜 φ) f)) = ⊤ :=
  iSup_nonvanishingOpen_pullbackSections 𝒜 (universalVeroneseSections 𝒜 d) φ
    (iSup_nonvanishingOpen_psiSection_universalVeroneseSections_eq_top 𝒜 d)

/-- **`L` is generated by the sections `ψ^d_φ(f)`, `f ∈ S_d`**, stalkwise: every element of every
stalk of `L` is an `𝒪_{Y,y}`-combination of their germs. -/
theorem generatesStalks_psiPullbackPowSections (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) :
    Stacks.ProjectiveFromSections.GeneratesStalks (L := pullbackUniversalTwist 𝒜 φ)
      (fun f : 𝒜 d => psiSection 𝒜 (psiPullbackPowSections 𝒜 φ) f) := by
  intro y w
  have hy : y ∈ (⨆ f : 𝒜 d, nonvanishingOpen Y (pullbackUniversalTwist 𝒜 φ)
      (psiSection 𝒜 (psiPullbackPowSections 𝒜 φ) f)) := by
    rw [iSup_nonvanishingOpen_psiPullbackPowSections]; trivial
  obtain ⟨f, hf⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
  obtain ⟨r, hr⟩ := Stacks.SectionProduct.exists_smul_Γgerm (pullbackUniversalTwist 𝒜 φ)
    (psiSection 𝒜 (psiPullbackPowSections 𝒜 φ) f) hf w
  exact ⟨{f}, fun _ => r, by rw [Finset.sum_singleton]; exact hr⟩

/-- The degree `n` component of `ψ^d_φ`, from the degree `n` piece of the Veronese subring to the
degree `n` piece `𝟙 ⟶ L^{⊗ n}` of the section ring. -/
def psiPullbackPowHom (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) (n : ℕ) :
    veroneseGrading 𝒜 d n →+ powSections (pullbackUniversalTwist 𝒜 φ) n :=
  (secOfHom (pullbackUniversalTwist 𝒜 φ) n).comp
    (((psiPullbackPowSections 𝒜 φ).toFun n).comp (veroneseToGrade 𝒜 d n))

/-- `psiPullbackPowHom` is `secOf` of the degreewise value. -/
theorem psiPullbackPowHom_apply (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) (n : ℕ)
    (a : veroneseGrading 𝒜 d n) :
    psiPullbackPowHom 𝒜 φ n a =
      secOf (pullbackUniversalTwist 𝒜 φ)
        ((psiPullbackPowSections 𝒜 φ).toFun n (veroneseToGrade 𝒜 d n a)) :=
  rfl

/-- **Multiplicativity of the degreewise maps**, in the section ring. -/
theorem psiPullbackPowHom_mul (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) (n m : ℕ)
    (a : veroneseGrading 𝒜 d n) (b : veroneseGrading 𝒜 d m) :
    psiPullbackPowHom 𝒜 φ (n + m)
        (GradedMonoid.GMul.mul (A := fun i => (veroneseGrading 𝒜 d i : Type u)) a b) =
      Stacks.GradedSections.mul (psiPullbackPowHom 𝒜 φ n a) (psiPullbackPowHom 𝒜 φ m b) := by
  rw [psiPullbackPowHom_apply, psiPullbackPowHom_apply, psiPullbackPowHom_apply,
    ← secOf_mulSections]
  exact congrArg (secOf (pullbackUniversalTwist 𝒜 φ))
    ((psiPullbackPowSections 𝒜 φ).map_mul n m _ _ _ rfl)

/-- **Unitality of the degreewise maps**: the unit of `S^{(d)}` goes to the unit `𝟙` of the
section ring. -/
theorem psiPullbackPowHom_one (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) :
    psiPullbackPowHom 𝒜 φ 0 1 = 𝟙 (𝟙_ Y.Modules) := by
  rw [psiPullbackPowHom_apply,
    Stacks.AlgebraicGeometry.ProjTripleUnitSection.toFun_zero_eq_unitGlobal 𝒜
      (psiPullbackPowSections 𝒜 φ) (iSup_nonvanishingOpen_psiPullbackPowSections 𝒜 φ) _ rfl]
  exact secOf_globalSection _ _

/-- The ring homomorphism `⨁_n (S^{(d)})_n ⟶ Γ_*(Y, L)` assembled from the degreewise maps. -/
def psiPullbackSectionSumHom (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) :
    (⨁ n : ℕ, veroneseGrading 𝒜 d n) →+* sectionRing (pullbackUniversalTwist 𝒜 φ) :=
  DirectSum.toSemiring
    (fun n => (DirectSum.of (powSections (pullbackUniversalTwist 𝒜 φ)) n).comp
      (psiPullbackPowHom 𝒜 φ n))
    ((congrArg (DirectSum.of (powSections (pullbackUniversalTwist 𝒜 φ)) 0)
        (psiPullbackPowHom_one 𝒜 φ)).trans
      (DirectSum.one_def (powSections (pullbackUniversalTwist 𝒜 φ))).symm)
    (fun {n m} a b =>
      (congrArg (DirectSum.of (powSections (pullbackUniversalTwist 𝒜 φ)) (n + m))
          (psiPullbackPowHom_mul 𝒜 φ n m a b)).trans
        (DirectSum.of_mul_of (A := powSections (pullbackUniversalTwist 𝒜 φ))
          (psiPullbackPowHom 𝒜 φ n a) (psiPullbackPowHom 𝒜 φ m b)).symm)

/-- On a homogeneous summand the assembled ring map is the degreewise map. -/
theorem psiPullbackSectionSumHom_of (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) (n : ℕ)
    (a : veroneseGrading 𝒜 d n) :
    psiPullbackSectionSumHom 𝒜 φ
        (DirectSum.of (fun i => (veroneseGrading 𝒜 d i : Type u)) n a) =
      DirectSum.of (powSections (pullbackUniversalTwist 𝒜 φ)) n (psiPullbackPowHom 𝒜 φ n a) :=
  DirectSum.toAddMonoid_of
    (fun n => (DirectSum.of (powSections (pullbackUniversalTwist 𝒜 φ)) n).comp
      (psiPullbackPowHom 𝒜 φ n))
    n a

/-- **The graded ring homomorphism `ψ^d_φ : S^{(d)} ⟶ Γ_*(Y, L)`**, `L = φ⁎𝒪_{U_d}(d)`, from the
`d`-th Veronese subring of `S`, graded by `n ↦ S_{nd}`, to the section ring of Tag 01CV of `L`,
graded by `n ↦ Γ(Y, L^{⊗ n})`. -/
def psiPullbackSectionRing (hd : 0 < d) (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) :
    letI := veroneseGradingGradedRing 𝒜 d hd
    veroneseGrading 𝒜 d →+*ᵍ
      Stacks.ExternalGrading.summand (powSections (pullbackUniversalTwist 𝒜 φ)) :=
  let := veroneseGradingGradedRing 𝒜 d hd
  { __ := (psiPullbackSectionSumHom 𝒜 φ).comp
      (DirectSum.decomposeRingEquiv (veroneseGrading 𝒜 d)).toRingHom
    map_mem := fun {n x} hx =>
      ⟨psiPullbackPowHom 𝒜 φ n ⟨x, hx⟩,
        (Eq.trans
          (congrArg (psiPullbackSectionSumHom 𝒜 φ)
            (DirectSum.decompose_of_mem (veroneseGrading 𝒜 d) hx))
          (psiPullbackSectionSumHom_of 𝒜 φ n ⟨x, hx⟩)).symm⟩ }

/-- On a homogeneous element `a` of Veronese degree `n`, `ψ^d_φ(a)` is the degreewise value placed
in the degree `n` summand. -/
theorem psiPullbackSectionRing_apply_homogeneous (hd : 0 < d)
    (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) (n : ℕ) (a : veroneseGrading 𝒜 d n) :
    letI := veroneseGradingGradedRing 𝒜 d hd
    psiPullbackSectionRing 𝒜 hd φ (a : veroneseSubring 𝒜 d) =
      DirectSum.of (powSections (pullbackUniversalTwist 𝒜 φ)) n
        (secOf (pullbackUniversalTwist 𝒜 φ)
          (pullSection φ (universalTwist 𝒜 d) n
            ((universalVeroneseSections 𝒜 d).toFun n (veroneseToGrade 𝒜 d n a)))) :=
  let := veroneseGradingGradedRing 𝒜 d hd
  Eq.trans
    (congrArg (psiPullbackSectionSumHom 𝒜 φ)
      (DirectSum.decompose_of_mem (veroneseGrading 𝒜 d) a.2))
    (psiPullbackSectionSumHom_of 𝒜 φ n a)

/-! ### Equation 27.12.0.3 in one statement -/

/-- Let `S` be a graded ring, `X = Proj(S)`, let `d ≥ 1`, let `U_d ⊆ X` be the degree `d` open and
let `φ : Y ⟶ U_d` be a morphism of schemes. Put `L = φ⁎𝒪_{U_d}(d)`. Composing the graded ring map
`ψ^d : S^{(d)} ⟶ Γ_*(U_d, 𝒪_{U_d}(d))` with pullback along `φ` gives a graded ring homomorphism

`ψ^d_φ : S^{(d)} ⟶ Γ_*(Y, L) = ⨁_{n ≥ 0} Γ(Y, L^{⊗ n})`

into the section ring of Tag 01CV: a homogeneous `a ∈ S_{nd}` is sent to the pullback along `φ`
of the section of `𝒪_{U_d}(d)^{⊗ n}` corresponding, under `θ : 𝒪_{U_d}(d)^{⊗ n} ≅ 𝒪_{U_d}(nd)`,
to the global section of `𝒪_{U_d}(nd)` attached to `a`, placed in degree `n`. Moreover `L` is an
invertible `𝒪_Y`-module, and it is generated by the global sections `ψ^d_φ(f)`, `f ∈ S_d`. -/
@[stacks 01N7 "the graded ring homomorphism ψ^d_φ : S^(d) ⟶ Γ_*(Y, L) = ⨁_n Γ(Y, L^{⊗ n}) into \
the section ring of the invertible sheaf L = φ⁎O_{U_d}(d), obtained by composing ψ^d with \
pullback along φ : Y ⟶ U_d, together with invertibility of L and its generation by the sections \
ψ^d_φ(f), f ∈ S_d"]
theorem psiPullbackSectionRing_spec (hd : 0 < d) (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) :
    (letI := veroneseGradingGradedRing 𝒜 d hd
     ∃ ψ : veroneseGrading 𝒜 d →+*ᵍ
         Stacks.ExternalGrading.summand (powSections (pullbackUniversalTwist 𝒜 φ)),
       ∀ (n : ℕ) (a : veroneseGrading 𝒜 d n),
         ψ (a : veroneseSubring 𝒜 d) =
           DirectSum.of (powSections (pullbackUniversalTwist 𝒜 φ)) n
             (secOf (pullbackUniversalTwist 𝒜 φ)
               (pullSection φ (universalTwist 𝒜 d) n
                 ((universalVeroneseSections 𝒜 d).toFun n (veroneseToGrade 𝒜 d n a))))) ∧
      Stacks.Ample.IsInvertibleModule Y (pullbackUniversalTwist 𝒜 φ) ∧
      Stacks.ProjectiveFromSections.GeneratesStalks (L := pullbackUniversalTwist 𝒜 φ)
        (fun f : 𝒜 d => psiSection 𝒜 (psiPullbackPowSections 𝒜 φ) f) :=
  ⟨⟨psiPullbackSectionRing 𝒜 hd φ, psiPullbackSectionRing_apply_homogeneous 𝒜 hd φ⟩,
    inferInstance, generatesStalks_psiPullbackPowSections 𝒜 φ⟩

end Stacks.AlgebraicGeometry.MorphismsIntoProj

end
