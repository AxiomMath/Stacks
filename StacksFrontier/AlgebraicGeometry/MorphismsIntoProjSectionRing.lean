open Stacks.AlgebraicGeometry.ProjChartFromRatios (VeroneseSections mulSections secOf
  globalSection_secOf secOf_globalSection mulSections_globalSection)
open Stacks.AlgebraicGeometry.ProjChartRatioPullback (pullSection)
open Stacks.AlgebraicGeometry.ProjDegreeOpenRepresents (universalTwist)
