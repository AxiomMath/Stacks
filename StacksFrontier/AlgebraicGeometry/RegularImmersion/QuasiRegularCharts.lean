module

public import StacksFrontier.AlgebraicGeometry.ConormalAlgebra.Immersion
public import StacksFrontier.AlgebraicGeometry.Descent.LocalOnTarget.RegularImmersion
public import StacksFrontier.AlgebraicGeometry.Divisors.NormalCone.SymmetricQuotient
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.QuasiRegular
public import StacksFrontier.AlgebraicGeometry.RegularImmersion.Affine

/-!
# Quasi-regular affine charts of a quasi-regular immersion are a basis

Let `i : Z ⟶ X` be an immersion of schemes.  An *affine chart* of `i` is an affine open `U` of
`X` over which `i` restricts to a closed immersion; the ideal it carries is
`Stacks.Conormal.chartIdeal i U = ker (i.app U)`, and
`Stacks.Conormal.exists_affineChart_mem` says that the preimages of the affine charts are a
basis of opens of `Z`.

This file refines that statement for a **quasi-regular** immersion: the affine charts whose
chart ideal is generated by a quasi-regular sequence are *already* a basis of opens of `Z`.
This is the shrinking step that affine-local arguments about quasi-regular immersions need: the
condition of [Stacks, Tag 063J] part (4) produces *some* affine open carrying a quasi-regular
generating sequence, with no control on where it sits, while a sheaf-theoretic statement proved
chart by chart needs charts inside a prescribed open.

## Main results

* `…RegularIdealSheaf.exists_affineOpen_le_isQuasiRegular`: **[Stacks, Tag 063G] with a
  containment** — a quasi-regular ideal sheaf has, around each point of the support of its
  quotient *and inside any prescribed open neighbourhood of that point*, an affine open carrying
  a quasi-regular generating sequence.
* `…RegularIdealSheaf.exists_affineOpen_le_ker_app_eq_span_isQuasiRegular`: the same statement
  for the defining ideal sheaf of a quasi-compact morphism, in the `ker (j.app U)` form of
  `AlgebraicGeometry.KerGeneratedBy`.
* `Stacks.Conormal.isQuasiRegular_ringEquiv`: quasi-regularity of a finite sequence transports
  along a ring isomorphism.
* `Stacks.Conormal.exists_quasiRegular_affineChart_mem`: **the quasi-regular affine charts of a
  quasi-regular immersion are a basis of opens of the source.**

## Implementation notes

The shrinking in `exists_affineOpen_le_isQuasiRegular` costs nothing beyond what the proof of
[Stacks, Tag 063G] already does: that proof shrinks the open produced by the definition of a
quasi-regular ideal sheaf to an affine open inside it, using
`Stacks.AlgebraicGeometry.RegularIdealSheaf.isGeneratedByOn_of_le` for the generation and
`Stacks.AlgebraicGeometry.QuasiRegular.germFamily_res` for the germs, and the affine open may
just as well be taken inside the intersection with a prescribed neighbourhood.

The passage from the closed factor `i.liftCoborder : Z ⟶ i.coborderRange` to `X` runs through
`AlgebraicGeometry.affineOpensRestrict`: an affine open `W` of `i.coborderRange` is the preimage
of the affine open `U = i.coborderRange.ι ''ᵁ W` of `X`, the map on functions
`i.coborderRange.ι.app U` is then an isomorphism, and `i.app U` factors as that isomorphism
followed by `i.liftCoborder.app W`.  So the chart ideal of `U` is carried onto the kernel of the
closed factor over `W` by a ring isomorphism, and a quasi-regular generating sequence for the
latter pulls back to one for the former.

The auxiliary statement that does the transport takes the open `W` together with an equation
`i.coborderRange.ι ⁻¹ᵁ U = W`, which is substituted away immediately; stating it with the
preimage directly would force the caller to transport its sequence across that equation.

## References

* [Stacks Project, Lemma 31.20.2 (Tag 063G)](https://stacks.math.columbia.edu/tag/063G)
* [Stacks Project, Lemma 31.21.1 (Tag 063J)](https://stacks.math.columbia.edu/tag/063J)
* [Stacks Project, Lemma 31.22.5 (Tag 063M)](https://stacks.math.columbia.edu/tag/063M)
* [Stacks Project, Lemma 29.3.2 (Tag 01R2)](https://stacks.math.columbia.edu/tag/01R2)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.RingTheory.RegularIdealSheaf
open Stacks.RingedSpace

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

/-! ### Stacks tag 063G with a containment -/

/-- **[Stacks, Tag 063G] with a containment.**  A quasi-regular sheaf of ideals on a scheme is,
around each point of the support of its quotient and *inside any prescribed open neighbourhood*
of that point, generated on an affine open by a sequence which is quasi-regular in the ring of
sections there.

The definition of a quasi-regular ideal sheaf produces some open `U₀` around the point carrying a
generating sequence whose sheaf quasi-regularity morphism is an isomorphism; an affine open
inside `U₀ ⊓ Ω` then carries the restricted sequence, which still generates and whose germs still
satisfy the elementary relation condition, so it is quasi-regular in the sections over that
affine open. -/
theorem exists_affineOpen_le_isQuasiRegular (X : Scheme.{u})
    (J : (structureSheafModule X.toRingedSpace).Submodule)
    (h : IsQuasiRegularIdealSheaf X.toRingedSpace J) (Ω : X.Opens) (x : X) (hxΩ : x ∈ Ω)
    (hx : x ∈ idealQuotientSupport X.toRingedSpace J) :
    ∃ (U : X.affineOpens) (_ : x ∈ (U : Set X)) (_ : U.1 ≤ Ω) (r : ℕ)
      (f : Fin r → X.toRingedSpace.presheaf.obj (op U.1)),
      IsGeneratedByOn X.toRingedSpace J U.1 f ∧
        RingTheory.Sequence.IsQuasiRegular
          (X.toRingedSpace.presheaf.obj (op U.1)) (List.ofFn f) := by
  obtain ⟨U₀, hxU₀, r, f, hiso, hgen⟩ := h x hx
  obtain ⟨V, hV, hxV, hVU₀⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
      (show x ∈ U₀ ⊓ Ω from ⟨hxU₀, hxΩ⟩)
  have hVle : V ≤ U₀ := hVU₀.trans inf_le_left
  refine ⟨⟨V, hV⟩, hxV, hVU₀.trans inf_le_right, r,
    fun i => X.presheaf.map (homOfLE hVle).op (f i),
    isGeneratedByOn_of_le U₀ f hgen V hVle, ?_⟩
  refine (forall_isQuasiRegularRel_germ_iff X V hV _).mp fun y hy => ?_
  rw [germFamily_res U₀ V hVle f y hy]
  exact (isQuasiRegularMapIso_iff_forall_germ X.toRingedSpace U₀ f).mp hiso y (hVle hy)

/-- **[Stacks, Tag 063G] with a containment, for the defining ideal sheaf of a morphism.**  If
the defining ideal sheaf of a quasi-compact morphism `j : Z ⟶ X` is quasi-regular, then around
each point of the closure of the image of `j` and inside any prescribed open neighbourhood of it
there is an affine open on which the kernel of `j` on sections is generated by a quasi-regular
sequence.

This is `AlgebraicGeometry.isQuasiRegularIdealSheaf_iff_kerGeneratedBy` with the containment
carried along. -/
theorem exists_affineOpen_le_ker_app_eq_span_isQuasiRegular {Z X : Scheme.{u}} (j : Z ⟶ X)
    [QuasiCompact j]
    (h : IsQuasiRegularIdealSheaf X.toLocallyRingedSpace.toRingedSpace (definingIdealOfHom j))
    (Ω : X.Opens) (x : X) (hxΩ : x ∈ Ω) (hx : x ∈ closure (Set.range j.base)) :
    ∃ (U : X.affineOpens) (_ : x ∈ (U : Set X)) (_ : U.1 ≤ Ω) (r : ℕ) (f : Fin r → Γ(X, U.1)),
      RingHom.ker (j.app U.1).hom = Ideal.span (Set.range f) ∧
        RingTheory.Sequence.IsQuasiRegular Γ(X, U.1) (List.ofFn f) := by
  obtain ⟨U, hxU, hUΩ, r, f, hgen, hqr⟩ :=
    exists_affineOpen_le_isQuasiRegular X (definingIdealOfHom j) h Ω x hxΩ
      ((mem_idealQuotientSupport_definingIdealOfHom_iff j x).mpr hx)
  exact ⟨U, hxU, hUΩ, r, f, ker_app_eq_span_range j U.2 f hgen, hqr⟩

end Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.Conormal

variable {Z X : Scheme.{u}}

/-! ### Transport of quasi-regularity along a ring isomorphism -/

/-- **Quasi-regularity of a finite sequence transports along a ring isomorphism.**  Both sides
are bijectivity of the quasi-regularity map of [Stacks, Tag 061N], and the elementary relation
form of the condition is invariant under a ring isomorphism. -/
theorem isQuasiRegular_ringEquiv {R S : Type u} [CommRing R] [CommRing S] (ε : R ≃+* S) {c : ℕ}
    (f : Fin c → R) (h : RingTheory.Sequence.IsQuasiRegular R (List.ofFn f)) :
    RingTheory.Sequence.IsQuasiRegular S (List.ofFn fun k => ε (f k)) :=
  (Stacks.RingTheory.RegularIdealSheaf.isQuasiRegular_ofFn_iff _).mpr
    ((Stacks.RingTheory.RegularIdealSheaf.isQuasiRegularRel_iff_bijective _).mp
      (Stacks.RingTheory.RegularIdealSheaf.isQuasiRegularRel_ringEquiv ε f
        ((Stacks.RingTheory.RegularIdealSheaf.isQuasiRegularRel_iff_bijective f).mpr
          ((Stacks.RingTheory.RegularIdealSheaf.isQuasiRegular_ofFn_iff f).mp h))))

/-! ### From the closed factor to an affine chart of the target -/

/-- Transport of a quasi-regular generating sequence for the kernel of the closed factor over an
open `W` of `i.coborderRange` to the chart ideal of an affine open `U` of `X` whose preimage in
`i.coborderRange` is `W`, along the isomorphism `i.coborderRange.ι.app U` on functions. -/
private theorem exists_span_chartIdeal_of_ker_app_eq_span (i : Z ⟶ X) [IsImmersion i]
    (U : X.affineOpens) (W : (i.coborderRange.toScheme).Opens)
    (hW : i.coborderRange.ι ⁻¹ᵁ U.1 = W)
    (hiso : IsIso (i.coborderRange.ι.app U.1)) {r : ℕ}
    (g : Fin r → Γ(i.coborderRange.toScheme, W))
    (hker : RingHom.ker (i.liftCoborder.app W).hom = Ideal.span (Set.range g))
    (hqr : RingTheory.Sequence.IsQuasiRegular Γ(i.coborderRange.toScheme, W) (List.ofFn g)) :
    ∃ f : Fin r → Γ(X, U.1), chartIdeal i U = Ideal.span (Set.range f) ∧
      RingTheory.Sequence.IsQuasiRegular Γ(X, U.1) (List.ofFn f) := by
  subst hW
  obtain ⟨ε, hεapp⟩ :
      ∃ ε : Γ(X, U.1) ≃+* Γ(i.coborderRange.toScheme, i.coborderRange.ι ⁻¹ᵁ U.1),
        ∀ a : Γ(X, U.1), ε a = (i.coborderRange.ι.app U.1).hom a :=
    ⟨(asIso (i.coborderRange.ι.app U.1)).commRingCatIsoToRingEquiv, fun _ => rfl⟩
  refine ⟨fun k => ε.symm (g k), ?_, isQuasiRegular_ringEquiv ε.symm g hqr⟩
  have hkercomp : RingHom.ker (i.app U.1).hom =
      RingHom.ker ((i.liftCoborder ≫ i.coborderRange.ι).app U.1).hom :=
    congrArg (fun f : Z ⟶ X => RingHom.ker (f.app U.1).hom) i.liftCoborder_ι.symm
  have hmem : ∀ a : Γ(X, U.1), a ∈ chartIdeal i U ↔
      ε a ∈ RingHom.ker (i.liftCoborder.app (i.coborderRange.ι ⁻¹ᵁ U.1)).hom := by
    intro a
    rw [chartIdeal, hkercomp, Scheme.Hom.comp_app, hεapp a]
    rfl
  have hmap : Ideal.map ε (Ideal.span (Set.range fun k => ε.symm (g k)))
      = Ideal.span (Set.range g) := by
    simp [Ideal.map_span, ← Set.range_comp, Function.comp_def]
  refine Ideal.ext fun a => ?_
  rw [hmem a, hker, ← hmap]
  exact Ideal.apply_mem_of_equiv_iff

/-- **The quasi-regular affine charts of a quasi-regular immersion are a basis of opens of the
source.**  Every point of an open `V` of `Z` lies in the preimage of an affine open `U` of `X`
whose preimage is contained in `V`, over which `i` restricts to a closed immersion, and whose
chart ideal `ker (i.app U)` is generated by a quasi-regular sequence of functions on `U`.

The affine charts alone are a basis by `Stacks.Conormal.exists_affineChart_mem`; one of them,
`U₀`, is shrunk using [Stacks, Tag 063G] with a containment, applied to the closed factor
`i.liftCoborder` on `i.coborderRange` inside the preimage of `U₀`.  The resulting affine open of
`i.coborderRange` is the preimage of an affine open of `X`, and the quasi-regular generating
sequence is carried to the chart ideal of the latter by the isomorphism on functions. -/
theorem exists_quasiRegular_affineChart_mem (i : Z ⟶ X) [IsImmersion i]
    (h : Stacks.AlgebraicGeometry.RegularIdealSheaf.IsQuasiRegularImmersion i)
    (V : Z.Opens) (x : Z) (hx : x ∈ V) :
    ∃ (U : X.affineOpens) (_ : IsClosedImmersion (i.resLE U.1 (i ⁻¹ᵁ U.1) le_rfl))
      (_ : x ∈ i ⁻¹ᵁ U.1) (_ : i ⁻¹ᵁ U.1 ≤ V) (r : ℕ) (f : Fin r → Γ(X, U.1)),
      chartIdeal i U = Ideal.span (Set.range f) ∧
        RingTheory.Sequence.IsQuasiRegular Γ(X, U.1) (List.ofFn f) := by
  obtain ⟨U₀, hxU₀, hU₀V, -⟩ := exists_affineChart_mem i V x hx
  have hpreι : ∀ U' : X.Opens,
      i.liftCoborder ⁻¹ᵁ (i.coborderRange.ι ⁻¹ᵁ U') = i ⁻¹ᵁ U' := fun U' => by
    rw [← Scheme.Hom.comp_preimage, i.liftCoborder_ι]
  have hxpre : x ∈ i.liftCoborder ⁻¹ᵁ (i.coborderRange.ι ⁻¹ᵁ U₀.1) := by
    rwa [hpreι]
  obtain ⟨W, hxW, hWΩ, r, g, hker, hqr⟩ :=
    Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_affineOpen_le_ker_app_eq_span_isQuasiRegular
      i.liftCoborder h (i.coborderRange.ι ⁻¹ᵁ U₀.1) (i.liftCoborder.base x) hxpre
      (subset_closure ⟨x, rfl⟩)
  obtain ⟨U, hUcob, hUeq⟩ : ∃ U : X.affineOpens, U.1 ≤ i.coborderRange ∧
      U.1 = i.coborderRange.ι ''ᵁ W.1 :=
    ⟨(AlgebraicGeometry.affineOpensRestrict i.coborderRange W).1,
      (AlgebraicGeometry.affineOpensRestrict i.coborderRange W).2,
      AlgebraicGeometry.affineOpensRestrict_apply_coe_coe i.coborderRange W⟩
  have hpre : i.coborderRange.ι ⁻¹ᵁ U.1 = W.1 := by
    rw [hUeq]
    exact Scheme.Hom.preimage_image_eq i.coborderRange.ι W.1
  have hiso : IsIso (i.coborderRange.ι.app U.1) := by
    rw [hUeq]
    infer_instance
  have hpreU : i ⁻¹ᵁ U.1 = i.liftCoborder ⁻¹ᵁ W.1 := by
    rw [← hpre, hpreι]
  obtain ⟨f, hspan, hfqr⟩ :=
    exists_span_chartIdeal_of_ker_app_eq_span i U W.1 hpre hiso g hker hqr
  refine ⟨U, AlgebraicGeometry.isClosedImmersion_resLE_of_le_coborderRange i U.1 hUcob, ?_, ?_,
    r, f, hspan, hfqr⟩
  · rw [hpreU]; exact hxW
  · rw [hpreU]
    exact fun y hy => hU₀V ((hpreι _).le (hWΩ hy))

end Stacks.Conormal

end
