module

public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Immersion
public import StacksFrontier.AlgebraicGeometry.RegularImmersion.Stalkwise

/-!
# Regularity of a sequence of sections as a nonzerodivisor condition on the stalks

Let `X` be a ringed space, `U` an open of `X` and `f₁, …, f_r` sections of `O_X` over `U`.  The
regular condition of Stacks tag 063D, part (1) — multiplication by `fᵢ` on the quotient sheaf
`O_X|_U / (f₁, …, f_{i-1})` of Stacks tag 0639 is a monomorphism for every `i` — is read on the
stalks by `Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularSequenceOn_iff_germ` as an
implication between memberships of the ideal generated by the germs of the predecessors.  This
file records the same condition in the `nonZeroDivisors` vocabulary: the class of the germ of
`fᵢ` is a nonzerodivisor of `O_{X,y}` modulo the ideal generated by the germs of its
predecessors, at every point `y` of `U`.  That is the form in which the affine comparison with
`RingTheory.Sequence.IsWeaklyRegular` and the quasi-regular side of Stacks tag 063G are stated.

## Main definitions

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.precedingFamilyIdeal`: the ideal of the stalk at a
  point of `U` generated by the germs of the members of the family preceding the `i`-th.

## Main results

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.mem_nonZeroDivisors_quotient_iff_forall`: an
  element is a nonzerodivisor of a quotient ring exactly when it carries nothing into the ideal
  from outside it.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularSequenceOn_iff_germFamily`: the regular
  condition on `U`, as a nonzerodivisor condition in the stalks of `X` itself.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularSequenceOn_iff_stalk`: the same condition
  read in the stalks of the restriction of `X` to `U`, on which the sheaf condition is stated.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularImmersion_of_forall_germFamily`: a
  germwise sufficient criterion for an immersion to be regular, Stacks tag 063J part (1).

## Implementation notes

`precedingFamilyIdeal` is the ideal `Jid (precedingFamily (germFamily X U f y hy) i)` under a
name, so that the statements below and their consumers need not repeat that expression; the two
are definitionally equal, which is why the translations here are `Iff` manipulations with no
rewriting of the ideal.

The condition in the stalks of the restriction and the condition in the stalks of `X` differ
only by `restrictStalkEquiv`; the transport is carried out once, inside
`isRegularSequenceOn_iff_germ`, so neither statement here repeats it.

Only the sufficient direction of the immersion criterion is stated, because the equivalence it
rests on, `isRegularSequenceOn_iff_germFamily`, is itself an `Iff`.

## References

* [Stacks Project, Definition 31.21.2 (Tag 063D)](https://stacks.math.columbia.edu/tag/063D)
* [Stacks Project, Definition 31.21.4 (Tag 063J)](https://stacks.math.columbia.edu/tag/063J)
* [Stacks Project, Tag 0639](https://stacks.math.columbia.edu/tag/0639)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.RingedSpace

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

section Quotient

/-- An element is a nonzerodivisor in a quotient ring exactly when it carries nothing into the
ideal from outside it. -/
theorem mem_nonZeroDivisors_quotient_iff_forall {A : Type*} [CommRing A] (I : Ideal A) (a : A) :
    Ideal.Quotient.mk I a ∈ nonZeroDivisors (A ⧸ I) ↔ ∀ u : A, a * u ∈ I → u ∈ I := by
  refine ⟨fun hnzd u hu => ?_, fun h => ?_⟩
  · refine Ideal.Quotient.eq_zero_iff_mem.1 ((mem_nonZeroDivisors_iff.1 hnzd).1 _ ?_)
    rwa [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
  · have key : ∀ w : A ⧸ I, Ideal.Quotient.mk I a * w = 0 → w = 0 := by
      intro w hw
      obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective w
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hw
      exact Ideal.Quotient.eq_zero_iff_mem.2 (h v hw)
    exact mem_nonZeroDivisors_iff.2 ⟨key, fun w hw => key w (by rwa [mul_comm])⟩

end Quotient

section Sequences

variable (X : RingedSpace.{u}) (U : Opens X) {r : ℕ} (g : Fin r → X.presheaf.obj (op U))

/-- The ideal of the stalk of `X` at a point `y` of `U` generated by the germs over `U` of the
members of `g` strictly preceding `g i`. -/
noncomputable def precedingFamilyIdeal (i : Fin r) (y : X) (hy : y ∈ U) :
    Ideal (X.presheaf.stalk y) :=
  Jid (precedingFamily (germFamily X U g y hy) i)

/-- The ideal generated by the germs of the predecessors does not change when the generating
family is restricted to a smaller open. -/
theorem precedingFamilyIdeal_res (U' : Opens X) (hU' : U' ≤ U) (i : Fin r) (y : X)
    (hy : y ∈ U') :
    precedingFamilyIdeal X U' (fun j => X.presheaf.map (homOfLE hU').op (g j)) i y hy
      = precedingFamilyIdeal X U g i y (hU' hy) := by
  unfold precedingFamilyIdeal
  rw [germFamily_res U U' hU' g y hy]

/-- **The regular condition of Stacks tag 063D on the stalks of the ambient space.** A sequence
of sections over `U` is a regular sequence exactly when, at every point `y` of `U` and for every
index, the germ of that member is a nonzerodivisor in the quotient of the stalk `O_{X,y}` by the
ideal generated by the germs of its predecessors. -/
theorem isRegularSequenceOn_iff_germFamily :
    IsRegularSequenceOn X U g ↔ ∀ (i : Fin r) (y : X) (hy : y ∈ U),
      Ideal.Quotient.mk (precedingFamilyIdeal X U g i y hy) (germFamily X U g y hy i) ∈
        nonZeroDivisors (X.presheaf.stalk y ⧸ precedingFamilyIdeal X U g i y hy) := by
  rw [isRegularSequenceOn_iff_germ]
  exact ⟨fun h i y hy => (mem_nonZeroDivisors_quotient_iff_forall _ _).2 (h y hy i),
    fun h y hy i => (mem_nonZeroDivisors_quotient_iff_forall _ _).1 (h i y hy)⟩

/-- **The regular condition of Stacks tag 063D on the stalks of the restriction.** The same
condition, read at the points of `X` restricted to `U`, on whose quotient sheaves the condition
is stated. -/
theorem isRegularSequenceOn_iff_stalk :
    IsRegularSequenceOn X U g ↔ ∀ (i : Fin r) (y : X.restrict U.isOpenEmbedding),
      Ideal.Quotient.mk
          (Jid (precedingFamily (germSequence (X.restrict U.isOpenEmbedding)
            (fun j => sectionOnRestriction X U (g j)) y) i))
          (germSequence (X.restrict U.isOpenEmbedding)
            (fun j => sectionOnRestriction X U (g j)) y i) ∈
        nonZeroDivisors ((X.restrict U.isOpenEmbedding).presheaf.stalk y ⧸
          Jid (precedingFamily (germSequence (X.restrict U.isOpenEmbedding)
            (fun j => sectionOnRestriction X U (g j)) y) i)) :=
  forall_congr' fun i =>
    (mono_regularSequenceMultiplication_iff_germ _ _ i).trans
      (forall_congr' fun _ => (mem_nonZeroDivisors_quotient_iff_forall _ _).symm)

end Sequences

section Immersions

/-- **A germwise sufficient criterion for regularity of an immersion.** If near every point of
the support of the quotient by the defining ideal there are generators of that ideal on an open
set whose germs are, at every point of that open set, nonzerodivisors modulo the germs of their
predecessors, then the immersion is regular in the sense of Stacks tag 063J part (1). -/
theorem isRegularImmersion_of_forall_germFamily {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i]
    (h : ∀ x : i.coborderRange.toScheme.toLocallyRingedSpace.toRingedSpace,
      x ∈ idealQuotientSupport
          i.coborderRange.toScheme.toLocallyRingedSpace.toRingedSpace (definingIdeal i) →
        ∃ (U : Opens i.coborderRange.toScheme.toLocallyRingedSpace.toRingedSpace)
          (_hx : x ∈ U) (r : ℕ)
          (g : Fin r →
            i.coborderRange.toScheme.toLocallyRingedSpace.toRingedSpace.presheaf.obj (op U)),
          IsGeneratedByOn i.coborderRange.toScheme.toLocallyRingedSpace.toRingedSpace
              (definingIdeal i) U g ∧
            ∀ (j : Fin r)
              (y : i.coborderRange.toScheme.toLocallyRingedSpace.toRingedSpace) (hy : y ∈ U),
              Ideal.Quotient.mk
                  (precedingFamilyIdeal
                    i.coborderRange.toScheme.toLocallyRingedSpace.toRingedSpace U g j y hy)
                  (germFamily
                    i.coborderRange.toScheme.toLocallyRingedSpace.toRingedSpace U g y hy j) ∈
                nonZeroDivisors
                  (i.coborderRange.toScheme.toLocallyRingedSpace.toRingedSpace.presheaf.stalk y ⧸
                    precedingFamilyIdeal
                      i.coborderRange.toScheme.toLocallyRingedSpace.toRingedSpace U g j y hy)) :
    IsRegularImmersion i := by
  intro x hx
  obtain ⟨U, hxU, r, g, hgen, hgerm⟩ := h x hx
  exact ⟨U, hxU, r, g, (isRegularSequenceOn_iff_germFamily _ U g).2 hgerm, hgen⟩

end Immersions

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
