module

public import Mathlib.Algebra.Category.Grp.EpiMono
public import Mathlib.Data.Fin.Tuple.Take
public import Mathlib.RingTheory.Regular.Flat
public import StacksFrontier.AlgebraicGeometry.RegularImmersion.IdealSheaf

/-!
# Regularity of a sequence of sections is a condition on the stalks

Let `X` be a ringed space, `U` an open of `X` and `f₁, …, f_r` sections of `O_X` over `U`.  The
sequence is regular on `U` (Stacks tag 063D, part (1)) when, for each `i`, multiplication by
`fᵢ` on the quotient sheaf `O_X|_U / (f₁, …, f_{i-1})` of Stacks tag 0639 is a monomorphism.
That quotient is a sheaf, so the condition may be read one stalk at a time: it holds exactly
when, for every `y ∈ U`, the germ of `fᵢ` is a nonzerodivisor on
`O_{X,y} / (germ f₁, …, germ f_{i-1})`.

## Main results

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.mono_regularSequenceMultiplication_iff_germ`: for
  global sections of a ringed space, multiplication by `fᵢ` on `O_X / (f₁, …, f_{i-1})` is a
  monomorphism exactly when every germ of `fᵢ` is a nonzerodivisor modulo the germs of the
  preceding sections.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularSequenceOn_iff_germ`: the same for a
  family of sections over an open set, in terms of the stalks of `X` at the points of that open.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularSequenceOn_of_isWeaklyRegular`: over an
  affine open of a scheme it suffices that the family be weakly regular in the ring of sections.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularIdealSheaf_of_forall_germ`: an ideal
  sheaf generated near each point of the support by a family whose germs form a regular sequence
  is a regular ideal sheaf.

## References

* [Stacks Project, Definition 31.20.1 (Tag 063D)](https://stacks.math.columbia.edu/tag/063D)
* [Stacks Project, Lemma 31.20.4 (Tag 063C)](https://stacks.math.columbia.edu/tag/063C)
* [Stacks Project, Tag 0639](https://stacks.math.columbia.edu/tag/0639)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.RingTheory.QuasiRegular
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.RingedSpace

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

/-- The members of a finite family strictly preceding the `i`-th one. -/
def precedingFamily {α : Type*} {n : ℕ} (f : Fin n → α) (i : Fin n) : Fin i.val → α :=
  fun j => f ⟨j.val, j.isLt.trans i.isLt⟩

/-- Taking germs commutes with passing to the preceding members of a family. -/
theorem germSequence_precedingFamily (X : RingedSpace.{u}) {n : ℕ}
    (f : Fin n → X.presheaf.obj (op (⊤ : Opens X))) (i : Fin n) (y : X) :
    germSequence X (precedingFamily f i) y = precedingFamily (germSequence X f y) i := rfl

/-- The germ at `y` of a section lies locally in the ideal generated by the sections preceding
`f i` exactly when it lies in the ideal generated by their germs. -/
theorem mem_isLocallyInPrecedingIdeal_iff_forall_germ (X : RingedSpace.{u}) {n : ℕ}
    (f : Fin n → X.presheaf.obj (op (⊤ : Opens X))) (i : Fin n) (U : Opens X)
    (s : X.presheaf.obj (op U)) :
    IsLocallyInPrecedingIdeal X f i U s ↔
      ∀ (y : X) (hy : y ∈ U), X.presheaf.germ U y hy s ∈
        Jid (precedingFamily (germSequence X f y) i) := by
  classical
  constructor
  · intro hs y hy
    obtain ⟨V, hyV, hVU, a, ha⟩ := hs y hy
    have hgerm := congrArg (X.presheaf.germ V y hyV) ha
    rw [TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hVU) y hyV s, map_sum] at hgerm
    rw [hgerm]
    refine Ideal.sum_mem _ fun j _ => ?_
    rw [map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span
      ⟨j, (TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE le_top) y hyV _).symm⟩)
  · intro hs y hy
    obtain ⟨cc, hcc⟩ := Ideal.mem_span_range_iff_exists_fun.mp (hs y hy)
    obtain ⟨V₀, hyV₀, b, hb⟩ := exists_nhds_germ_eq (Finset.univ : Finset (Fin i.val)) y cc
    have hyW : y ∈ U ⊓ V₀ := ⟨hy, hyV₀⟩
    have hWU : U ⊓ V₀ ≤ U := inf_le_left
    have hWV₀ : U ⊓ V₀ ≤ V₀ := inf_le_right
    set d : X.presheaf.obj (op (U ⊓ V₀)) :=
      X.presheaf.map (homOfLE hWU).op s -
        ∑ j, X.presheaf.map (homOfLE hWV₀).op (b j) *
          X.presheaf.map (homOfLE (le_top (a := U ⊓ V₀))).op (precedingFamily f i j) with hd
    have hdgerm : X.presheaf.germ (U ⊓ V₀) y hyW d = 0 := by
      rw [hd, map_sub, map_sum, sub_eq_zero,
        TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hWU) y hyW s, ← hcc]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul,
        TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hWV₀) y hyW (b j),
        TopCat.Presheaf.germ_res_apply X.presheaf
          (homOfLE (le_top (a := U ⊓ V₀))) y hyW (precedingFamily f i j),
        hb j (Finset.mem_univ j)]
      rfl
    obtain ⟨V, hyV, hVW, hdV⟩ :=
      exists_nhds_eq_zero_of_germ_eq_zero (U ⊓ V₀) d y hyW hdgerm
    refine ⟨V, hyV, hVW.trans hWU, fun j => X.presheaf.map (homOfLE (hVW.trans hWV₀)).op (b j), ?_⟩
    rw [hd, map_sub, map_sum, sub_eq_zero] at hdV
    rw [← AlgebraicGeometry.res_res X U (U ⊓ V₀) V hWU hVW s, hdV]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_mul, AlgebraicGeometry.res_res, AlgebraicGeometry.res_res]
    rfl

/-- For global sections `f` of a ringed space `X`, the endomorphism
`f i : O_X/(f₁, …, f_{i-1}) ⟶ O_X/(f₁, …, f_{i-1})` of Stacks tag 0639 is a monomorphism if and
only if, at every point `y`, the germ of `f i` is a nonzerodivisor modulo the ideal generated by
the germs of the preceding sections. -/
theorem mono_regularSequenceMultiplication_iff_germ (X : RingedSpace.{u}) {n : ℕ}
    (f : Fin n → X.presheaf.obj (op (⊤ : Opens X))) (i : Fin n) :
    Mono (regularSequenceMultiplication X f i).multiplication ↔
      ∀ (y : X) (τ : X.presheaf.stalk y),
        germSequence X f y i * τ ∈ Jid (precedingFamily (germSequence X f y) i) →
          τ ∈ Jid (precedingFamily (germSequence X f y) i) := by
  set D := regularSequenceMultiplication X f i with hD
  have hq : ∀ (V : Opens X) (s : X.presheaf.obj (op V)), D.quotientMap V s = 0 ↔
      ∀ (y : X) (hy : y ∈ V), X.presheaf.germ V y hy s ∈
        Jid (precedingFamily (germSequence X f y) i) := fun V s => by
    rw [D.quotientMap_eq_zero_iff, D.mem_precedingIdeal_iff,
      mem_isLocallyInPrecedingIdeal_iff_forall_germ]
  have hf : ∀ (W : Opens X) (y : X) (hy : y ∈ W),
      X.presheaf.germ W y hy (X.presheaf.map (homOfLE (le_top (a := W))).op (f i)) =
        germSequence X f y i := fun W y hy =>
    TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE le_top) y hy (f i)
  constructor
  · intro hmono y τ hτ
    obtain ⟨W₀, hyW₀, t, rfl⟩ := X.presheaf.exists_germ_eq τ
    obtain ⟨V, hyV, hVW₀, hV⟩ := exists_nhds_germ_mem_Jid_pow (precedingFamily f i) W₀
      (X.presheaf.map (homOfLE (le_top (a := W₀))).op (f i) * t) 1 y hyW₀
      (by rwa [pow_one, map_mul, hf])
    have hquot : D.quotientMap V (X.presheaf.map (homOfLE hVW₀).op t) = 0 := by
      have hinj : Function.Injective (D.multiplication.app (op V)) :=
        (AddCommGrpCat.mono_iff_injective _).mp
          ((NatTrans.mono_iff_mono_app D.multiplication).mp hmono (op V))
      refine hinj ?_
      rw [D.multiplication_quotientMap, map_zero, hq]
      intro z hz
      simpa [hf, TopCat.Presheaf.germ_res_apply, germSequence_precedingFamily] using hV z hz
    simpa [TopCat.Presheaf.germ_res_apply] using (hq _ _).mp hquot y hyV
  · intro h
    suffices happ : ∀ V : (Opens X)ᵒᵖ, Mono (D.multiplication.app V) from
      NatTrans.mono_of_mono_app _
    rintro ⟨V⟩
    rw [AddCommGrpCat.mono_iff_injective, injective_iff_map_eq_zero]
    intro s hs
    refine TopCat.Presheaf.section_ext D.quotientSheaf V s 0 fun x hx => ?_
    rw [map_zero]
    obtain ⟨W, hxW, hWV, t, ht⟩ := D.quotientMap_locallySurjective V s x hx
    have hzero : D.quotientMap W t = 0 := by
      rw [hq]
      intro y hy
      refine h y _ ?_
      have hnat := NatTrans.naturality_apply D.multiplication (homOfLE hWV).op s
      rw [hs, map_zero] at hnat
      have hmul : D.quotientMap W
          (X.presheaf.map (homOfLE (le_top (a := W))).op (f i) * t) = 0 := by
        rw [← D.multiplication_quotientMap, ht]
        exact hnat
      simpa [hf] using (hq W _).mp hmul y hy
    rw [← TopCat.Presheaf.germ_res_apply D.quotientSheaf.presheaf (homOfLE hWV) x hxW s, ← ht,
      hzero, map_zero]

/-- A ring isomorphism carries the ideal generated by a family onto the ideal generated by its
image. -/
theorem mem_Jid_ringEquiv {R S : Type*} [CommRing R] [CommRing S] (e : R ≃+* S) {c : ℕ}
    (g : Fin c → R) (x : R) : x ∈ Jid g ↔ e x ∈ Jid (fun j => e (g j)) := by
  have himg : Ideal.map (e : R →+* S) (Jid g) = Jid (fun j => e (g j)) := by
    rw [Jid, Jid, Ideal.map_span, ← Set.range_comp]
    rfl
  rw [← himg, Ideal.mem_map_iff_of_surjective (e : R →+* S) e.surjective]
  exact ⟨fun hx => ⟨x, hx, rfl⟩, fun ⟨z, hz, hez⟩ => e.injective hez ▸ hz⟩

/-- The nonzerodivisor condition modulo an ideal generated by a family transports along a ring
isomorphism. -/
theorem forall_mul_mem_Jid_ringEquiv {R S : Type*} [CommRing R] [CommRing S] (e : R ≃+* S)
    {c : ℕ} (g : Fin c → R) (a : R) :
    (∀ τ : R, a * τ ∈ Jid g → τ ∈ Jid g) ↔
      ∀ σ : S, e a * σ ∈ Jid (fun j => e (g j)) → σ ∈ Jid (fun j => e (g j)) := by
  constructor
  · intro h σ hσ
    rw [← e.apply_symm_apply σ, ← mem_Jid_ringEquiv]
    exact h _ (by rwa [mem_Jid_ringEquiv e, map_mul, e.apply_symm_apply])
  · intro h τ hτ
    rw [mem_Jid_ringEquiv e]
    exact h _ (by rw [← map_mul]; exact (mem_Jid_ringEquiv e g _).mp hτ)

/-- A family of sections
of `O_X` over an open `U` is a regular sequence on `U` in the sense of Stacks tag 063D, part (1),
exactly when at every point of `U` the germ of each member is a nonzerodivisor modulo the ideal
generated by the germs of its predecessors. -/
theorem isRegularSequenceOn_iff_germ (X : RingedSpace.{u}) (U : Opens X) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op U)) :
    IsRegularSequenceOn X U f ↔
      ∀ (y : X) (hy : y ∈ U) (i : Fin r) (τ : X.presheaf.stalk y),
        germFamily X U f y hy i * τ ∈ Jid (precedingFamily (germFamily X U f y hy) i) →
          τ ∈ Jid (precedingFamily (germFamily X U f y hy) i) := by
  have key : ∀ (y : X) (hy : y ∈ U) (i : Fin r),
      (∀ τ : (X.restrict U.isOpenEmbedding).presheaf.stalk (⟨y, hy⟩ : ↥U),
          germSequence (X.restrict U.isOpenEmbedding)
              (fun j => sectionOnRestriction X U (f j)) ⟨y, hy⟩ i * τ ∈
            Jid (precedingFamily (germSequence (X.restrict U.isOpenEmbedding)
              (fun j => sectionOnRestriction X U (f j)) ⟨y, hy⟩) i) →
            τ ∈ Jid (precedingFamily (germSequence (X.restrict U.isOpenEmbedding)
              (fun j => sectionOnRestriction X U (f j)) ⟨y, hy⟩) i)) ↔
        ∀ τ : X.presheaf.stalk y,
          germFamily X U f y hy i * τ ∈ Jid (precedingFamily (germFamily X U f y hy) i) →
            τ ∈ Jid (precedingFamily (germFamily X U f y hy) i) := by
    intro y hy i
    have hfam : (fun j => restrictStalkEquiv X U y hy
        (precedingFamily (germSequence (X.restrict U.isOpenEmbedding)
          (fun k => sectionOnRestriction X U (f k)) ⟨y, hy⟩) i j)) =
        precedingFamily (germFamily X U f y hy) i :=
      funext fun _ => restrictStalkEquiv_germSequence X U f y hy _
    have ha : restrictStalkEquiv X U y hy (germSequence (X.restrict U.isOpenEmbedding)
        (fun j => sectionOnRestriction X U (f j)) ⟨y, hy⟩ i) = germFamily X U f y hy i :=
      restrictStalkEquiv_germSequence X U f y hy i
    rw [forall_mul_mem_Jid_ringEquiv (restrictStalkEquiv X U y hy), hfam, ha]
  rw [IsRegularSequenceOn]
  simp only [mono_regularSequenceMultiplication_iff_germ]
  exact ⟨fun h y hy i => (key y hy i).mp fun τ => h i ⟨y, hy⟩ τ,
    fun h i y' τ => (key y'.1 y'.2 i).mpr (h y'.1 y'.2 i) τ⟩

/-- The ideal generated by the members of a family preceding the `i`-th is the ideal of the
corresponding initial segment of the list of its members. -/
theorem ofList_take_ofFn {R : Type*} [CommRing R] {c : ℕ} (g : Fin c → R) (i : Fin c) :
    Ideal.ofList ((List.ofFn g).take i.val) • (⊤ : Submodule R R) =
      Jid (precedingFamily g i) := by
  rw [Ideal.smul_eq_mul, Ideal.mul_top,
    show (List.ofFn g).take i.val = List.ofFn (precedingFamily g i) from
      (Fin.ofFn_take_eq_take_ofFn i.isLt.le g).symm]
  refine congrArg Ideal.span ?_
  ext x
  simp [List.mem_ofFn]

/-- In a weakly regular sequence each member is a nonzerodivisor modulo the ideal generated by
the preceding members. -/
theorem forall_mul_mem_Jid_of_isWeaklyRegular {R : Type*} [CommRing R] {c : ℕ} (g : Fin c → R)
    (h : RingTheory.Sequence.IsWeaklyRegular R (List.ofFn g)) (i : Fin c) (τ : R)
    (hτ : g i * τ ∈ Jid (precedingFamily g i)) : τ ∈ Jid (precedingFamily g i) := by
  have hreg : IsSMulRegular (R ⧸ Jid (precedingFamily g i)) (g i) := by
    have hidx : (List.ofFn g)[i.val]'(by simp) = g i := by simp
    rw [← ofList_take_ofFn g i, ← hidx]
    exact h.regular_mod_prev i.val (by simp)
  refine (Submodule.Quotient.mk_eq_zero _).mp (hreg (a₂ := 0) ?_)
  show g i • (Submodule.Quotient.mk τ : R ⧸ Jid (precedingFamily g i)) =
    g i • (0 : R ⧸ Jid (precedingFamily g i))
  rw [smul_zero, ← Submodule.Quotient.mk_smul]
  exact (Submodule.Quotient.mk_eq_zero _).mpr (by rwa [smul_eq_mul])

/-- A sequence of sections of `O_X` over an affine open `U` of a scheme which is weakly
regular in `Γ(X, U)` is a regular sequence on `U` in the sense of Stacks tag 063D, part (1). -/
theorem isRegularSequenceOn_of_isWeaklyRegular (X : Scheme.{u}) (U : X.Opens)
    (hU : IsAffineOpen U) {r : ℕ} (f : Fin r → Γ(X, U))
    (h : RingTheory.Sequence.IsWeaklyRegular Γ(X, U) (List.ofFn f)) :
    IsRegularSequenceOn X.toRingedSpace U f := by
  refine (isRegularSequenceOn_iff_germ X.toRingedSpace U f).mpr fun y hy i τ hτ => ?_
  let _ := X.presheaf.algebra_section_stalk (⟨y, hy⟩ : ↥U)
  have _ := hU.isLocalization_stalk (⟨y, hy⟩ : ↥U)
  have hwr : RingTheory.Sequence.IsWeaklyRegular (X.presheaf.stalk y)
      (List.ofFn (germFamily X.toRingedSpace U f y hy)) := by
    have hloc := h.of_isLocalization (X.presheaf.stalk y)
      (hU.primeIdealOf (⟨y, hy⟩ : ↥U)).asIdeal.primeCompl
    rwa [List.map_ofFn] at hloc
  exact forall_mul_mem_Jid_of_isWeaklyRegular _ hwr i τ hτ

/-- If near every point of the support of `O_X / J` the ideal sheaf `J` is generated by a family of
sections whose germs form a regular sequence in each stalk, then `J` is a regular ideal sheaf in
the sense of Stacks tag 063D, part (1). -/
theorem isRegularIdealSheaf_of_forall_germ (X : RingedSpace.{u})
    (J : (structureSheafModule X).Submodule)
    (h : ∀ x : X, x ∈ idealQuotientSupport X J →
      ∃ (U : Opens X) (_hx : x ∈ U) (r : ℕ) (f : Fin r → X.presheaf.obj (op U)),
        (∀ (y : X) (hy : y ∈ U) (i : Fin r) (τ : X.presheaf.stalk y),
          germFamily X U f y hy i * τ ∈ Jid (precedingFamily (germFamily X U f y hy) i) →
            τ ∈ Jid (precedingFamily (germFamily X U f y hy) i)) ∧
          IsGeneratedByOn X J U f) :
    IsRegularIdealSheaf X J := by
  intro x hx
  obtain ⟨U, hxU, r, f, hgerm, hgen⟩ := h x hx
  exact ⟨U, hxU, r, f, (isRegularSequenceOn_iff_germ X U f).mpr hgerm, hgen⟩

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
