/-!
# A relative quasi-regular immersion into a flat family of finite presentation is regular

Let `g : Y ⟶ S` be flat and locally of finite presentation and let `j : Z ⟶ Y` be a closed
immersion such that `Z ⟶ S` is flat.  If the defining ideal of `j` is quasi-regular, then it is
regular.

## Main results

* `Stacks.AlgebraicGeometry.isRegularImmersion_of_isRelativeQuasiRegularImmersion`: a relative
  quasi-regular immersion into a flat scheme locally of finite presentation is regular.
* `Stacks.AlgebraicGeometry.isRegularIdealSheaf_definingIdealOfHom`: the same for a closed
  immersion `j : Z ⟶ Y` over `S`: if its defining ideal is quasi-regular, it is regular.
* `Stacks.AlgebraicGeometry.exists_affineOpen_isWeaklyRegular_generators`: a quasi-regular
  generating family over an affine open gives, near every point, an affine open over which the
  defining ideal has a weakly regular generating family.

## References

* [Stacks Project, Lemma 31.22.4 (Tag 063U)](https://stacks.math.columbia.edu/tag/063U)
* [Stacks Project, Lemma 31.20.2 (Tag 063G)](https://stacks.math.columbia.edu/tag/063G)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry RingTheory.Sequence
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.RingTheory.QuasiRegular

namespace Stacks.AlgebraicGeometry

open RegularIdealSheaf

universe u

section Dictionary

variable {S Y Z : Scheme.{u}} (g : Y ⟶ S) (j : Z ⟶ Y)

/-- Let `j : Z ⟶ Y` be a closed immersion of schemes over `S`, let `W` be an open of `S` and `U` an
affine open of `Y` mapping into `W`, and let `b` be a family of sections generating the defining
ideal of `j` over `U`.  Then the quotient of `Γ(Y, U)` by the ideal generated by `b` is, as a
`Γ(S, W)`-algebra, the ring of sections of `Z` over `j⁻¹U`. -/
def quotientSpanRangeAlgEquiv [IsClosedImmersion j] {W : S.Opens} {U : Y.Opens}
    (hU : IsAffineOpen U) (hUW : U ≤ g ⁻¹ᵁ W) {r : ℕ} (b : Fin r → Γ(Y, U))
    (hgen : IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom j) U b)
    [Algebra Γ(S, W) Γ(Y, U)]
    (halg : ∀ t : Γ(S, W), algebraMap Γ(S, W) Γ(Y, U) t = (g.appLE W U hUW).hom t)
    [Algebra Γ(S, W) Γ(Z, j ⁻¹ᵁ U)]
    (halg' : ∀ t : Γ(S, W), algebraMap Γ(S, W) Γ(Z, j ⁻¹ᵁ U) t =
      ((j ≫ g).appLE W (j ⁻¹ᵁ U) (fun _ hz => hUW hz)).hom t) :
    (Γ(Y, U) ⧸ Ideal.span (Set.range b)) ≃ₐ[Γ(S, W)] Γ(Z, j ⁻¹ᵁ U) := by
  refine AlgEquiv.ofRingEquiv
    (f := (Ideal.quotEquivOfEq (ker_app_eq_span_range j hU b hgen).symm).trans
      (quotientDefiningIdealEquiv j hU)) fun t => ?_
  have hcomp : (j ≫ g).appLE W (j ⁻¹ᵁ U) (fun _ hz => hUW hz) =
      g.appLE W U hUW ≫ j.app U := by
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
  rw [halg', hcomp, CommRingCat.hom_comp, RingHom.comp_apply, ← halg t]
  rfl

/-- Let `j : Z ⟶ Y` be a closed immersion of schemes over `S` with `Z ⟶ S` flat, let `W` be an
affine open of `S` and `U` an affine open of `Y` mapping into `W`, and let `b` be a family of
sections generating the defining ideal of `j` over `U`.  Then the quotient of `Γ(Y, U)` by the
ideal generated by `b` is a flat `Γ(S, W)`-module. -/
theorem flat_quotient_span_range_of_flat_comp [IsClosedImmersion j] [Flat (j ≫ g)]
    {W : S.Opens} (hW : IsAffineOpen W) {U : Y.Opens} (hU : IsAffineOpen U)
    (hUW : U ≤ g ⁻¹ᵁ W) {r : ℕ} (b : Fin r → Γ(Y, U))
    (hgen : IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom j) U b)
    [Algebra Γ(S, W) Γ(Y, U)]
    (halg : ∀ t : Γ(S, W), algebraMap Γ(S, W) Γ(Y, U) t = (g.appLE W U hUW).hom t) :
    Module.Flat Γ(S, W) (Γ(Y, U) ⧸ Ideal.span (Set.range b)) := by
  let _ : Algebra Γ(S, W) Γ(Z, j ⁻¹ᵁ U) :=
    ((j ≫ g).appLE W (j ⁻¹ᵁ U) (fun _ hz => hUW hz)).hom.toAlgebra
  have : Module.Flat Γ(S, W) Γ(Z, j ⁻¹ᵁ U) :=
    (j ≫ g).flat_appLE hW (hU.preimage j) (fun _ hz => hUW hz)
  exact Module.Flat.of_linearEquiv
    (quotientSpanRangeAlgEquiv g j hU hUW b hgen halg (fun _ => rfl)).toLinearEquiv

/-- Let `U` be an affine open of `Y` and `s ∈ Γ(Y, U)`.  If the image of a sequence `b` in
`Localization.Away s` is weakly regular, then its restriction to the basic open of `s` is weakly
regular in `Γ(Y, Y.basicOpen s)`. -/
theorem isWeaklyRegular_res_basicOpen_of_away {Y : Scheme.{u}} {U : Y.Opens}
    (hU : IsAffineOpen U) (s : Γ(Y, U)) {r : ℕ} (b : Fin r → Γ(Y, U))
    (h : IsWeaklyRegular (Localization.Away s)
      (List.ofFn fun k => algebraMap Γ(Y, U) (Localization.Away s) (b k))) :
    IsWeaklyRegular Γ(Y, Y.basicOpen s)
      (List.ofFn fun k => Y.presheaf.map (homOfLE (Y.basicOpen_le s)).op (b k)) := by
  have := hU.isLocalization_basicOpen s
  rw [show (List.ofFn fun k => algebraMap Γ(Y, U) (Localization.Away s) (b k)) =
      (List.ofFn b).map (algebraMap Γ(Y, U) (Localization.Away s)) from
    (List.map_ofFn).symm] at h
  have h₁ : IsWeaklyRegular (Localization.Away s) (List.ofFn b) :=
    (isWeaklyRegular_map_algebraMap_iff (Localization.Away s) (Localization.Away s)
      (List.ofFn b)).mp h
  have h₂ : IsWeaklyRegular Γ(Y, Y.basicOpen s) (List.ofFn b) :=
    (LinearEquiv.isWeaklyRegular_congr
      (IsLocalization.algEquiv (Submonoid.powers s) (Localization.Away s)
        Γ(Y, Y.basicOpen s)).toLinearEquiv (List.ofFn b)).mp h₁
  have h₃ := (isWeaklyRegular_map_algebraMap_iff Γ(Y, Y.basicOpen s) Γ(Y, Y.basicOpen s)
    (List.ofFn b)).mpr h₂
  rwa [List.map_ofFn] at h₃

end Dictionary

section Affine

variable {S Y Z : Scheme.{u}} (g : Y ⟶ S) (j : Z ⟶ Y)

/-- The ideal subsheaf generated over `U` by a family `b` has all sections over every open
`V' ⊆ Y.basicOpen (b k)`. -/
private theorem generatedIdealOn_obj_eq_top_of_le_basicOpen {U : Y.Opens} {r : ℕ}
    (b : Fin r → Γ(Y, U)) (k : Fin r) {V' : Y.Opens} (hV' : V' ≤ Y.basicOpen (b k)) :
    (generatedIdealOn Y.toRingedSpace U b).obj (op V') = ⊤ := by
  have hVU : V' ≤ U := hV'.trans (Y.basicOpen_le (b k))
  refine top_unique fun t _ => (mem_generatedIdealOn_iff U b V' hVU t).mpr fun y hy => ?_
  have hone : Jid (germFamily Y.toRingedSpace U b y (hVU hy)) = ⊤ :=
    Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨k, rfl⟩)
      ((Y.mem_basicOpen (b k) y (hVU hy)).mp (hV' hy))
  exact hone ▸ Submodule.mem_top

/-- The ideal subsheaf generated over `V` by the one-element family `1` has all sections over
every `V' ≤ V`. -/
theorem generatedIdealOn_one_obj_eq_top {V V' : Y.Opens} (hV' : V' ≤ V) :
    (generatedIdealOn Y.toRingedSpace V (fun _ : Fin 1 => (1 : Γ(Y, V)))).obj (op V') = ⊤ :=
  generatedIdealOn_obj_eq_top_of_le_basicOpen _ 0 (by rwa [Scheme.basicOpen_one])

/-- If the defining ideal of `j : Z ⟶ Y` is generated over `U` by a family `b`, then it has all
sections over every open `V' ⊆ Y.basicOpen (b k)`. -/
theorem definingIdealOfHom_obj_eq_top_of_le_basicOpen {U : Y.Opens} {r : ℕ}
    (b : Fin r → Γ(Y, U)) (hgen : IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom j) U b)
    (k : Fin r) {V' : Y.Opens} (hV' : V' ≤ Y.basicOpen (b k)) :
    (definingIdealOfHom j).obj (op V') = ⊤ := by
  rw [hgen V' (hV'.trans (Y.basicOpen_le (b k)))]
  exact generatedIdealOn_obj_eq_top_of_le_basicOpen b k hV'

/-- Let `g : Y ⟶ S` be flat and locally of finite presentation, let `j : Z ⟶ Y` be a closed
immersion with `Z ⟶ S` flat, and suppose the defining ideal of `j` is generated over an affine
open `U₀` by a family which is quasi-regular in `Γ(Y, U₀)`.  Then every point of `U₀` has an
affine open neighbourhood over which the defining ideal is generated by a family weakly regular in
the ring of sections. -/
theorem exists_affineOpen_isWeaklyRegular_generators [IsClosedImmersion j] [Flat g]
    [LocallyOfFinitePresentation g] [Flat (j ≫ g)]
    {U₀ : Y.Opens} (hU₀ : IsAffineOpen U₀) {r : ℕ} (a : Fin r → Γ(Y, U₀))
    (hgen₀ : IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom j) U₀ a)
    (hqr₀ : IsQuasiRegular Γ(Y, U₀) (List.ofFn a)) {x : Y} (hx : x ∈ U₀) :
    ∃ (V : Y.Opens) (_hV : IsAffineOpen V) (_hxV : x ∈ V) (s : ℕ) (c : Fin s → Γ(Y, V)),
      IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom j) V c ∧
        IsWeaklyRegular Γ(Y, V) (List.ofFn c) := by
  classical
  obtain ⟨W, hW, hxW, -⟩ := Opens.isBasis_iff_nbhd.mp S.isBasis_affineOpens
    (show g.base x ∈ (⊤ : S.Opens) from trivial)
  obtain ⟨U, hU, hxU, hUle⟩ := Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens
    (show x ∈ U₀ ⊓ g ⁻¹ᵁ W from ⟨hx, hxW⟩)
  have hUU₀ : U ≤ U₀ := hUle.trans inf_le_left
  have hUW : U ≤ g ⁻¹ᵁ W := hUle.trans inf_le_right
  set b : Fin r → Γ(Y, U) := fun k => Y.presheaf.map (homOfLE hUU₀).op (a k) with hbdef
  have hgen : IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom j) U b :=
    isGeneratedByOn_of_le U₀ a hgen₀ U hUU₀
  have hqr : IsQuasiRegular Γ(Y, U) (List.ofFn b) := by
    refine (forall_isQuasiRegularRel_germ_iff Y U hU b).mp fun y hy => ?_
    rw [hbdef, germFamily_res U₀ U hUU₀ a y hy]
    exact (forall_isQuasiRegularRel_germ_iff Y U₀ hU₀ a).mpr hqr₀ y (hUU₀ hy)
  let _ : Algebra Γ(S, W) Γ(Y, U) := (g.appLE W U hUW).hom.toAlgebra
  have : Module.Flat Γ(S, W) Γ(Y, U) := g.flat_appLE hW hU hUW
  have : Algebra.FinitePresentation Γ(S, W) Γ(Y, U) := g.finitePresentation_appLE hW hU hUW
  have : Module.Flat Γ(S, W) (Γ(Y, U) ⧸ Ideal.span (Set.range b)) :=
    flat_quotient_span_range_of_flat_comp g j hW hU hUW b hgen (fun _ => rfl)
  set q : Ideal Γ(Y, U) := (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).asIdeal
  have : q.IsPrime := (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).isPrime
  have hmem : ∀ t : Γ(Y, U), t ∉ q → x ∈ Y.basicOpen t := by
    intro t ht
    let _ := Y.presheaf.algebra_section_stalk (⟨x, hxU⟩ : ↥U)
    have := hU.isLocalization_stalk (⟨x, hxU⟩ : ↥U)
    rw [Y.mem_basicOpen t x hxU]
    exact (IsLocalization.AtPrime.isUnit_to_map_iff _ q t).mpr ht
  by_cases hall : ∀ k, b k ∈ q
  · obtain ⟨s, hsq, hwr⟩ := Stacks.RingTheory.SpreadingOut.exists_notMem_isWeaklyRegular_away
      (A := Γ(S, W)) q b hall hqr ‹_›
    exact ⟨Y.basicOpen s, hU.basicOpen s, hmem s hsq, r, _,
      isGeneratedByOn_of_le U b hgen _ (Y.basicOpen_le s),
      isWeaklyRegular_res_basicOpen_of_away hU s b hwr⟩
  · obtain ⟨k, hk⟩ := not_forall.mp hall
    refine ⟨Y.basicOpen (b k), hU.basicOpen (b k), hmem _ hk, 1, fun _ => 1, fun V' hV' => ?_, ?_⟩
    · rw [definingIdealOfHom_obj_eq_top_of_le_basicOpen j b hgen k hV',
        generatedIdealOn_one_obj_eq_top hV']
    · rw [List.ofFn_succ, List.ofFn_zero]
      exact IsWeaklyRegular.cons (IsSMulRegular.one _) (IsWeaklyRegular.nil _ _)

/-- Let `g : Y ⟶ S` be flat and locally of finite presentation and let `j : Z ⟶ Y` be a closed
immersion with `Z ⟶ S` flat.  If the defining ideal of `j` is quasi-regular, then it is
regular. -/
theorem isRegularIdealSheaf_definingIdealOfHom [IsClosedImmersion j] [Flat g]
    [LocallyOfFinitePresentation g] [Flat (j ≫ g)]
    (h : IsQuasiRegularIdealSheaf Y.toRingedSpace (definingIdealOfHom j)) :
    IsRegularIdealSheaf Y.toRingedSpace (definingIdealOfHom j) := by
  refine RegularIdealSheaf.isRegularIdealSheaf_of_exists_affine_generators Y _ fun x hx => ?_
  obtain ⟨U₀, hxU₀, r, a, hgen₀, hqr₀⟩ :=
    (RegularIdealSheaf.isQuasiRegularIdealSheaf_iff_exists_affine_generators Y _).mp h x hx
  exact exists_affineOpen_isWeaklyRegular_generators g j U₀.2 a hgen₀ hqr₀ hxU₀

end Affine

/-- A relative quasi-regular immersion into a scheme flat and locally of finite presentation over
the base is a regular immersion. -/
@[stacks 063U "regularity of the immersion", ega "IV 19.2.4" "c') => c)"]
theorem isRegularImmersion_of_isRelativeQuasiRegularImmersion {S X Z : Scheme.{u}} (f : X ⟶ S)
    (i : Z ⟶ X) [IsImmersion i] [Flat f] [LocallyOfFinitePresentation f]
    (hi : IsRelativeQuasiRegularImmersion f i) : IsRegularImmersion i := by
  have : Flat (i.liftCoborder ≫ i.coborderRange.ι ≫ f) := by
    rw [← Category.assoc, i.liftCoborder_ι]
    exact hi.1
  exact isRegularIdealSheaf_definingIdealOfHom (i.coborderRange.ι ≫ f) i.liftCoborder hi.2

end Stacks.AlgebraicGeometry

end
