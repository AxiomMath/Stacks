module

public import StacksFrontier.AlgebraicGeometry.Descent.LocalOnTarget.RegularImmersion
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularImmersion.RegularOpenIndependence
public import StacksFrontier.AlgebraicGeometry.RegularSequence.ExtVanishingImmersion
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Regular closed immersions of a fixed codimension are local on the target

A closed immersion `j : Z ⟶ X` is regular of codimension `c`
(`Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularClosedImmersionOfCodim`) when its defining
ideal sheaf is locally generated by a regular sequence of `c` sections. As for the other
regularity conditions of Stacks tag 063D, this may be read off affine opens (Stacks tag 063G):
around every point of the image there is an affine open over which the kernel of `j` on sections
is generated by a weakly regular sequence of length `c`. In that form the condition is invariant
under an isomorphism of the source and stable under flat base change, in particular under
restriction to an open subscheme of the target.

## Main results

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularClosedImmersionOfCodim_iff_kerGeneratedBy`:
  the affine-open form of the condition (Stacks tag 063G).
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularClosedImmersionOfCodim.iso_comp` and
  `Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularClosedImmersionOfCodim_iso_comp_iff`:
  invariance under an isomorphism of the source.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularClosedImmersionOfCodim.of_isPullback`:
  stability under flat base change, so in particular under restriction to an open subscheme of
  the target.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularClosedImmersionOfCodim.isRegularImmersion`:
  such an immersion is a regular immersion in the sense of Stacks tag 063J.

## References

* [Stacks Project, Tag 063D](https://stacks.math.columbia.edu/tag/063D)
* [Stacks Project, Tag 063G](https://stacks.math.columbia.edu/tag/063G)
* [Stacks Project, Tag 063J](https://stacks.math.columbia.edu/tag/063J)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

/-- **Stacks tag 063G for a regular closed immersion of codimension `c`.** The defining ideal
sheaf of a quasi-compact morphism `j` is regular of codimension `c` exactly when, around every
point of the closure of the image of `j`, some affine open carries a weakly regular sequence of
length `c` generating the kernel of `j` on sections there. -/
@[sga "6 0 3.2" "special case"]
theorem isRegularClosedImmersionOfCodim_iff_kerGeneratedBy {Z X : Scheme.{u}} (j : Z ⟶ X)
    [QuasiCompact j] (c : ℕ) :
    IsRegularClosedImmersionOfCodim j c ↔
      KerGeneratedBy
        (fun {A} _ {r} f => r = c ∧ RingTheory.Sequence.IsWeaklyRegular A (List.ofFn f)) j := by
  constructor
  · intro h x hx
    obtain ⟨U₀, hxU₀, f, hreg, hgen⟩ :=
      h x ((mem_idealQuotientSupport_definingIdealOfHom_iff j x).mpr hx)
    obtain ⟨V, hV, hxV, hVU₀⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens hxU₀
    exact ⟨⟨V, hV⟩, hxV, c, fun i => X.presheaf.map (homOfLE hVU₀).op (f i),
      ker_app_eq_span_range j hV _ (isGeneratedByOn_of_le U₀ f hgen V hVU₀),
      rfl, isWeaklyRegular_of_isRegularSequenceOn X V hV _
        (isRegularSequenceOn_of_le X.toRingedSpace hVU₀ f hreg)⟩
  · intro h x hx
    obtain ⟨U, hxU, r, f, hker, rfl, hwr⟩ :=
      h x ((mem_idealQuotientSupport_definingIdealOfHom_iff j x).mp hx)
    exact ⟨U.1, hxU, f, isRegularSequenceOn_of_isWeaklyRegular X U.1 U.2 f hwr,
      isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span j U.2 f hker⟩

/-- **A regular closed immersion of codimension `c` stays one after an isomorphism of the
source.** -/
theorem IsRegularClosedImmersionOfCodim.iso_comp {Z Z' X : Scheme.{u}} (ε : Z' ≅ Z)
    (j : Z ⟶ X) [QuasiCompact j] {c : ℕ} (h : IsRegularClosedImmersionOfCodim j c) :
    IsRegularClosedImmersionOfCodim (ε.hom ≫ j) c := by
  rw [isRegularClosedImmersionOfCodim_iff_kerGeneratedBy] at h ⊢
  exact kerGeneratedBy_iso_comp ε j h

/-- **Being a regular closed immersion of codimension `c` is invariant under an isomorphism of
the source.** -/
theorem isRegularClosedImmersionOfCodim_iso_comp_iff {Z Z' X : Scheme.{u}} (ε : Z' ≅ Z)
    (j : Z ⟶ X) [QuasiCompact j] (c : ℕ) :
    IsRegularClosedImmersionOfCodim (ε.hom ≫ j) c ↔ IsRegularClosedImmersionOfCodim j c := by
  refine ⟨fun h => ?_, IsRegularClosedImmersionOfCodim.iso_comp ε j⟩
  simpa using IsRegularClosedImmersionOfCodim.iso_comp ε.symm (ε.hom ≫ j) h

/-- **Flat base change of a regular closed immersion of codimension `c`.** In a cartesian square
whose bottom arrow is flat, the base change of a regular closed immersion of codimension `c` is
a regular closed immersion of codimension `c`. In particular this applies to the restriction of
a regular closed immersion to an open subscheme of its target. -/
theorem IsRegularClosedImmersionOfCodim.of_isPullback {Z Z' W W' : Scheme.{u}} {a : Z' ⟶ Z}
    {j' : Z' ⟶ W'} {j : Z ⟶ W} {pr : W' ⟶ W} (sq : IsPullback a j' j pr) [IsClosedImmersion j]
    [Flat pr] {c : ℕ} (h : IsRegularClosedImmersionOfCodim j c) :
    IsRegularClosedImmersionOfCodim j' c := by
  have : IsClosedImmersion j' := MorphismProperty.of_isPullback sq inferInstance
  rw [isRegularClosedImmersionOfCodim_iff_kerGeneratedBy] at h ⊢
  refine kerGeneratedBy_of_isPullback ?_ sq h
  intro A B _ _ φ hφ r f hf
  exact ⟨hf.1, Stacks.AlgebraicGeometry.isWeaklyRegular_ofFn_map_of_flat φ hφ f hf.2⟩

/-- **A regular closed immersion of codimension `c` is a regular immersion** in the sense of
Stacks tag 063J, part (1) (`Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularImmersion`):
forgetting the length of the local regular sequences, and reading the defining ideal on the
canonical open `i.coborderRange` rather than on the whole target. -/
theorem IsRegularClosedImmersionOfCodim.isRegularImmersion {Z X : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] {c : ℕ} (h : IsRegularClosedImmersionOfCodim i c) :
    IsRegularImmersion i := by
  have e := i.liftCoborder_ι
  have : IsClosedImmersion (i.liftCoborder ≫ i.coborderRange.ι) := by
    rw [e]
    infer_instance
  have hreg : IsRegularIdealSheaf X.toRingedSpace
      (definingIdealOfHom (i.liftCoborder ≫ i.coborderRange.ι)) := by
    rw [e]
    exact h.isRegularIdealSheaf
  exact (Stacks.AlgebraicGeometry.isRegularIdealSheaf_comp_open_iff i.liftCoborder
    i.coborderRange.ι).mp hreg

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
