import StacksCore.Tactic.EgaSgaAttribute

/-!
# The kernel of multiplication by an element with flat quotient is finitely generated

Let `A → B` be of finite presentation and let `h ∈ B` be an element such that `B/hB` is flat
over `A`.  Then `K = ker(h · : B → B)` is a finitely generated `B`-module, with no Noetherian
hypothesis on `A` or `B`.

## Main results

* `Stacks.RingTheory.SpreadingOut.fg_ker_lsmul_of_isPushout`: if `B = A ⊗_{A₂} B₂` is a base
  change, `h₂ ∈ B₂` lifts `h`, the kernel of `h₂ ·` is a finitely generated `B₂`-module, and
  `B₂/h₂B₂` is `A₂`-flat, then `ker(h ·)` is generated over `B` by the images of generators of
  `ker(h₂ ·)`.
* `Stacks.RingTheory.SpreadingOut.fg_ker_lsmul_of_flat_quotient`: the statement above, for
  `A → B` of finite presentation with `B/hB` flat over `A`.

## References

* [Stacks Project, Tag 062Y](https://stacks.math.columbia.edu/tag/062Y)
* [Stacks Project, Tag 02JO](https://stacks.math.columbia.edu/tag/02JO)
* [Stacks Project, Tag 00R1](https://stacks.math.columbia.edu/tag/00R1)
-/

@[expose] public section

universe u v

open scoped TensorProduct

namespace Stacks.RingTheory.SpreadingOut

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- If `ker(h' ·)` is spanned by a finset `s`, then the image of `s` under a ring map `f` lies
in `ker(f h' ·)` and spans a submodule containing the image of `ker(h' ·)`. -/
private lemma span_image_le_ker_lsmul {B' B : Type*} [CommRing B'] [CommRing B] [DecidableEq B]
    (f : B' →+* B) (h' : B') (s : Finset B')
    (hs : Submodule.span B' (↑s : Set B') = LinearMap.ker (LinearMap.lsmul B' B' h')) :
    Submodule.span B ↑(s.image f) ≤ LinearMap.ker (LinearMap.lsmul B B (f h')) ∧
      ∀ y ∈ LinearMap.ker (LinearMap.lsmul B' B' h'), f y ∈ Submodule.span B ↑(s.image f) := by
  refine ⟨?_, fun y hy => ?_⟩
  · rw [Submodule.span_le]
    intro x hx
    simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe] at hx
    obtain ⟨k, hk, rfl⟩ := hx
    have hhk : h' * k = 0 := by
      have := hs ▸ Submodule.subset_span (Finset.mem_coe.mpr hk)
      simpa [LinearMap.mem_ker] using this
    simp [LinearMap.mem_ker, smul_eq_mul, ← map_mul, hhk]
  · rw [← hs] at hy
    have := Ideal.mem_map_of_mem f hy
    rwa [Ideal.map_span, ← Finset.coe_image] at this

/-- Let `B = A ⊗_{A₂} B₂` be a base change, let `h₂ ∈ B₂` and let `h`
be its image in `B`.  If `ker(h₂ · : B₂ → B₂)` is a finitely generated `B₂`-module and
`B₂/h₂B₂` — presented as a surjection `π : B₂ → Q` with kernel `h₂B₂` — is flat over `A₂`, then
`ker(h · : B → B)` is a finitely generated `B`-module, generated by the images of generators of
`ker(h₂ ·)`. -/
theorem fg_ker_lsmul_of_isPushout
    {A₂ A B₂ B : Type*} [CommRing A₂] [CommRing A] [CommRing B₂] [CommRing B]
    [Algebra A₂ A] [Algebra A₂ B₂] [Algebra A₂ B] [Algebra A B] [Algebra B₂ B]
    [IsScalarTower A₂ A B] [IsScalarTower A₂ B₂ B] [Algebra.IsPushout A₂ A B₂ B]
    (h₂ : B₂) (hfg : (LinearMap.ker (LinearMap.lsmul B₂ B₂ h₂)).FG)
    (Q : Type*) [AddCommGroup Q] [Module A₂ Q] [Module.Flat A₂ Q]
    (π : B₂ →ₗ[A₂] Q) (hπ : Function.Surjective π)
    (hker : ∀ y : B₂, π y = 0 ↔ ∃ b : B₂, h₂ * b = y) :
    (LinearMap.ker (LinearMap.lsmul B B (algebraMap B₂ B h₂))).FG := by
  classical
  obtain ⟨s, hs⟩ := hfg
  obtain ⟨hle, hmemN⟩ := span_image_le_ker_lsmul (algebraMap B₂ B) h₂ s hs
  set N : Submodule B B := Submodule.span B ↑(s.image (algebraMap B₂ B)) with hN
  refine ⟨s.image (algebraMap B₂ B), le_antisymm hle ?_⟩
  · intro x hx
    have hx0 : algebraMap B₂ B h₂ * x = 0 := by
      simpa [LinearMap.mem_ker, smul_eq_mul] using hx
    set K₂ : Submodule A₂ B₂ := (LinearMap.ker (LinearMap.lsmul B₂ B₂ h₂)).restrictScalars A₂
      with hK₂
    set J₂ : Submodule A₂ B₂ := LinearMap.range (LinearMap.mulLeft A₂ h₂) with hJ₂
    set ι : K₂ →ₗ[A₂] B₂ := K₂.subtype with hι
    set fr : B₂ →ₗ[A₂] J₂ := (LinearMap.mulLeft A₂ h₂).rangeRestrict with hfr
    have hfrsurj : Function.Surjective fr := LinearMap.surjective_rangeRestrict _
    have hkerfr : LinearMap.ker fr = K₂ := by
      rw [hfr, LinearMap.ker_rangeRestrict, hK₂]
      ext y
      simp [LinearMap.mem_ker, smul_eq_mul]
    have hex1 : Function.Exact ι fr := by
      rw [LinearMap.exact_iff, hkerfr, hι, Submodule.range_subtype]
    have hkerpi : LinearMap.ker π = J₂ := by
      ext y
      rw [LinearMap.mem_ker, hker y, hJ₂]
      exact ⟨fun ⟨b, hb⟩ => ⟨b, hb⟩, fun ⟨b, hb⟩ => ⟨b, hb⟩⟩
    have hex2 : Function.Exact J₂.subtype π := by
      rw [LinearMap.exact_iff, hkerpi, Submodule.range_subtype]
    have hinj : Function.Injective (J₂.subtype.lTensor A) :=
      LinearMap.lTensor_injective_of_exact_of_flat π hπ J₂.subtype J₂.injective_subtype hex2 A
    have hexT : Function.Exact (ι.lTensor A) (fr.lTensor A) := lTensor_exact A hex1 hfrsurj
    set e := Algebra.IsPushout.equiv A₂ A B₂ B with he
    have key : ∀ y : A ⊗[A₂] B₂,
        e ((LinearMap.mulLeft A₂ h₂).lTensor A y) = algebraMap B₂ B h₂ * e y := by
      intro y
      induction y using TensorProduct.inductionOn with
      | tmul a b =>
          simp only [LinearMap.lTensor_tmul, LinearMap.mulLeft_apply, he,
            Algebra.IsPushout.equiv_tmul, map_mul]
          ring
      | add u v hu hv => simp only [map_add, hu, hv, mul_add]
    have hy0 : (LinearMap.mulLeft A₂ h₂).lTensor A (e.symm x) = 0 := by
      refine e.injective ?_
      rw [key, e.apply_symm_apply, hx0, map_zero]
    have hcomp : (LinearMap.mulLeft A₂ h₂).lTensor A
        = (J₂.subtype.lTensor A) ∘ₗ (fr.lTensor A) := by
      rw [← LinearMap.lTensor_comp]; rfl
    have hfr0 : fr.lTensor A (e.symm x) = 0 :=
      hinj (by rw [← LinearMap.comp_apply, ← hcomp, hy0, map_zero])
    obtain ⟨z, hz⟩ := (hexT _).mp hfr0
    have hgen : ∀ w : A ⊗[A₂] K₂, e (ι.lTensor A w) ∈ N := by
      intro w
      induction w using TensorProduct.inductionOn with
      | tmul a k =>
          have hk : (k : B₂) ∈ LinearMap.ker (LinearMap.lsmul B₂ B₂ h₂) := k.2
          have := N.smul_mem (algebraMap A B a) (hmemN _ hk)
          simpa [hι, he, Algebra.IsPushout.equiv_tmul, smul_eq_mul] using this
      | add u v hu hv => simpa [map_add] using N.add_mem hu hv
    simpa only [hz, e.apply_symm_apply] using hgen z


/-- Tensoring a quotient `S₀ ⧸ I` up to an `S₀`-algebra `C` is the quotient of `C` by the
extension of `I`, so flatness over a base of one is flatness of the other. -/
private lemma flat_tensorQuotient {A C S₀ : Type*} [CommRing A] [CommRing C] [CommRing S₀]
    [Algebra A C] [Algebra S₀ C] (I : Ideal S₀)
    (hflat : Module.Flat A (C ⧸ I.map (algebraMap S₀ C))) :
    Module.Flat A (C ⊗[S₀] (S₀ ⧸ I)) :=
  Module.Flat.of_linearEquiv
    ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot C I).toLinearEquiv.restrictScalars A).symm

/-- If `B ⧸ I` is flat over `A`, then so is `B_q ⧸ I B_q` for every prime `q` of `B`. -/
lemma flat_quotient_localization {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    (I : Ideal B) (q : Ideal B) [q.IsPrime] (hflat : Module.Flat A (B ⧸ I)) :
    Module.Flat A (Localization.AtPrime q ⧸ I.map (algebraMap B (Localization.AtPrime q))) := by
  have : IsScalarTower A (B ⧸ I)
      (Localization.AtPrime q ⧸ I.map (algebraMap B (Localization.AtPrime q))) :=
    .of_algebraMap_eq fun a => by
      change Ideal.Quotient.mk _ (algebraMap A (Localization.AtPrime q) a) = _
      rw [IsScalarTower.algebraMap_apply A B (Localization.AtPrime q)]
      rfl
  exact Module.Flat.of_isLocalizedModule_of_tower
    (Algebra.algebraMapSubmonoid (B ⧸ I) q.primeCompl)
    (Algebra.linearMap (B ⧸ I)
      (Localization.AtPrime q ⧸ I.map (algebraMap B (Localization.AtPrime q))))

/-- If `B ⧸ I₀B` is flat over `A`, then so is `B_q ⊗_{S₀} (S₀ ⧸ I₀)` for every prime `q`
of `B`. -/
private lemma flat_tensorQuotient_localization {A B S₀ : Type*} [CommRing A] [CommRing B]
    [CommRing S₀] [Algebra A B] [Algebra S₀ B] (I₀ : Ideal S₀) (q : Ideal B) [q.IsPrime]
    (hflat : Module.Flat A (B ⧸ I₀.map (algebraMap S₀ B))) :
    Module.Flat A (Localization.AtPrime q ⊗[S₀] (S₀ ⧸ I₀)) := by
  refine flat_tensorQuotient I₀ ?_
  have hmap : I₀.map (algebraMap S₀ (Localization.AtPrime q)) =
      (I₀.map (algebraMap S₀ B)).map (algebraMap B (Localization.AtPrime q)) := by
    rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq S₀ B (Localization.AtPrime q)]
  rw [hmap]
  exact flat_quotient_localization _ q hflat

/-- The surjection `C → C ⊗_{S₀} (S₀ ⧸ (h₀))`, `c ↦ c ⊗ 1`, is linear over any base of `C` and
has kernel the ideal generated by the image of `h₀`. -/
private lemma exists_linearMap_tensorQuotient {S₀ C A₂ : Type*} [CommRing S₀] [CommRing C]
    [CommRing A₂] [Algebra S₀ C] [Algebra A₂ C] (h₀ : S₀) :
    ∃ π : C →ₗ[A₂] (C ⊗[S₀] (S₀ ⧸ Ideal.span {h₀})),
      Function.Surjective π ∧
      ∀ y : C, π y = 0 ↔ ∃ b, (algebraMap S₀ C h₀) * b = y := by
  classical
  set I : Ideal S₀ := Ideal.span {h₀} with hI
  set e := Algebra.TensorProduct.quotIdealMapEquivTensorQuot C I with he
  refine ⟨{ toFun := fun b => b ⊗ₜ (1 : S₀ ⧸ I)
            map_add' := fun x y => by rw [TensorProduct.add_tmul]
            map_smul' := fun a x => by rw [TensorProduct.smul_tmul']; rfl }, ?_, ?_⟩
  · intro x
    obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (e.symm x)
    exact ⟨b, by
      change b ⊗ₜ (1 : S₀ ⧸ I) = x
      rw [show b ⊗ₜ (1 : S₀ ⧸ I) = e (Ideal.Quotient.mk _ b) from rfl, hb,
        e.apply_symm_apply]⟩
  · intro y
    have hmapI : I.map (algebraMap S₀ C) = Ideal.span {algebraMap S₀ C h₀} := by
      rw [hI, Ideal.map_span, Set.image_singleton]
    constructor
    · intro hy
      have h0 : e (Ideal.Quotient.mk _ y) = 0 := hy
      have hq0 : (Ideal.Quotient.mk (I.map (algebraMap S₀ C)) y) = 0 :=
        e.injective (by rw [h0]; simp)
      rw [Ideal.Quotient.eq_zero_iff_mem, hmapI, Ideal.mem_span_singleton'] at hq0
      obtain ⟨c, hc⟩ := hq0
      exact ⟨c, by rwa [mul_comm]⟩
    · rintro ⟨b, hb⟩
      have hq0 : (Ideal.Quotient.mk (I.map (algebraMap S₀ C)) y) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem, hmapI, Ideal.mem_span_singleton']
        exact ⟨b, by rwa [mul_comm]⟩
      change e (Ideal.Quotient.mk _ y) = 0
      rw [hq0, map_zero]

/-- Finite generation of the kernel of multiplication by an element is invariant under a ring
isomorphism. -/
private lemma fg_ker_lsmul_of_ringEquiv {B' B : Type*} [CommRing B'] [CommRing B]
    (e : B' ≃+* B) (h' : B') (hfg : (LinearMap.ker (LinearMap.lsmul B' B' h')).FG) :
    (LinearMap.ker (LinearMap.lsmul B B (e h'))).FG := by
  classical
  obtain ⟨s, hs⟩ := hfg
  obtain ⟨hle, hmem⟩ := span_image_le_ker_lsmul (e : B' →+* B) h' s hs
  refine ⟨s.image e, le_antisymm hle fun x hx => ?_⟩
  have hx0 : e h' * x = 0 := by simpa [LinearMap.mem_ker, smul_eq_mul] using hx
  have hh : h' * e.symm x = 0 :=
    e.injective (by rw [map_mul, e.apply_symm_apply, hx0, map_zero])
  have := hmem _ (by rwa [LinearMap.mem_ker, LinearMap.lsmul_apply, smul_eq_mul] : e.symm x ∈ _)
  simpa using this

open Algebra.FiniteTypeSystem in
/-- `fg_ker_lsmul_of_flat_quotient` for `A` and `B` in the same universe. -/
private theorem fg_ker_lsmul_of_flat_quotient_aux {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B] [Algebra.FinitePresentation A B] (h : B)
    (hflat : Module.Flat A (B ⧸ Ideal.span {h})) :
    (LinearMap.ker (LinearMap.lsmul B B h)).FG := by
  obtain ⟨R₀, S₀, M₀, _, _, _, _, _, _, _, _, f, hft0, hft1, hfin, hpush, hbc⟩ :=
    Algebra.exists_subring_finiteType_int_isPushout_isBaseChange (R := A) (S := B) B
  obtain ⟨i, h₀, hh₀⟩ := (ring_colimit R₀ S₀ (S := B)).1 h
  let _instR₀R₁ : Algebra ↥R₀ ↥(i.1.toSubring) := inferInstanceAs (Algebra ↥R₀ (Base R₀ i))
  let _instR₁S₁ : Algebra ↥(i.1.toSubring) (Ring R₀ S₀ i) :=
    inferInstanceAs (Algebra (Base R₀ i) (Ring R₀ S₀ i))
  have _t1 : IsScalarTower ↥R₀ ↥(i.1.toSubring) A :=
    inferInstanceAs (IsScalarTower ↥R₀ (Base R₀ i) A)
  have _t2 : IsScalarTower ↥R₀ ↥(i.1.toSubring) (Ring R₀ S₀ i) :=
    inferInstanceAs (IsScalarTower ↥R₀ (Base R₀ i) (Ring R₀ S₀ i))
  have _t3 : Algebra.IsPushout ↥R₀ ↥(i.1.toSubring) S₀ (Ring R₀ S₀ i) :=
    inferInstanceAs (Algebra.IsPushout ↥R₀ (Base R₀ i) S₀ (Ring R₀ S₀ i))
  have _t4 : IsScalarTower ↥(i.1.toSubring) A B := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have _t5 : IsScalarTower ↥(i.1.toSubring) (Ring R₀ S₀ i) B := by
    refine IsScalarTower.of_algebraMap_eq fun x => ?_
    change algebraMap A B x.1 = algebraMap (Ring R₀ S₀ i) B (x ⊗ₜ 1)
    have h1 := ringToRing_tmul R₀ S₀ (S := B) i x 1
    rw [map_one, mul_one] at h1
    exact h1.symm
  have _t6 : Algebra.FiniteType ℤ ↥(i.1.toSubring) :=
    inferInstanceAs (Algebra.FiniteType ℤ (Base R₀ i))
  have _t7 : Algebra.FiniteType ↥(i.1.toSubring) (Ring R₀ S₀ i) :=
    inferInstanceAs (Algebra.FiniteType (Base R₀ i) (Ring R₀ S₀ i))
  have _t8 : Algebra.IsPushout ↥(i.1.toSubring) A (Ring R₀ S₀ i) B :=
    (Algebra.IsPushout.comp_iff ↥R₀ ↥(i.1.toSubring) S₀ (S' := Ring R₀ S₀ i)
      (T := A) (T' := B)).mp inferInstance
  have hh₀' : algebraMap (Ring R₀ S₀ i) B h₀ = h := hh₀
  have hmapB : (Ideal.span {h₀}).map (algebraMap (Ring R₀ S₀ i) B) = Ideal.span {h} := by
    rw [Ideal.map_span, Set.image_singleton, hh₀']
  obtain ⟨j, hj⟩ := exists_flat_stage (R := A) (S := B) (i.1.toSubring) (Ring R₀ S₀ i)
    (Ring R₀ S₀ i ⧸ Ideal.span {h₀}) fun q =>
      flat_tensorQuotient_localization (Ideal.span {h₀}) q.asIdeal (by rw [hmapB]; exact hflat)
  have : IsNoetherianRing (Base (i.1.toSubring) j) := Algebra.FiniteType.isNoetherianRing ℤ _
  have : IsNoetherianRing (Ring (i.1.toSubring) (Ring R₀ S₀ i) j) :=
    Algebra.FiniteType.isNoetherianRing (Base (i.1.toSubring) j) _
  have : Algebra.IsPushout (Base (i.1.toSubring) j) A
      (Ring (i.1.toSubring) (Ring R₀ S₀ i) j) B :=
    ringToRing_isPushout (i.1.toSubring) (Ring R₀ S₀ i) j
  obtain ⟨π, hπ, hkerπ⟩ := exists_linearMap_tensorQuotient (S₀ := Ring R₀ S₀ i)
    (C := Ring (i.1.toSubring) (Ring R₀ S₀ i) j) (A₂ := Base (i.1.toSubring) j) h₀
  have hres := fg_ker_lsmul_of_isPushout (A := A) (B := B)
    (algebraMap (Ring R₀ S₀ i) (Ring (i.1.toSubring) (Ring R₀ S₀ i) j) h₀)
    (IsNoetherian.noetherian _) _ π hπ hkerπ
  have himg : algebraMap (Ring (i.1.toSubring) (Ring R₀ S₀ i) j) B
      (algebraMap (Ring R₀ S₀ i) (Ring (i.1.toSubring) (Ring R₀ S₀ i) j) h₀) = h := by
    rw [← IsScalarTower.algebraMap_apply, hh₀']
  rwa [himg] at hres

/-- Let `A → B` be of finite presentation and let `h ∈ B` be such that `B/hB` is flat over `A`.
Then `ker(h · : B → B)` is a finitely generated `B`-module. -/
@[ega "IV 11.3.9.1" "(h), special case"]
theorem fg_ker_lsmul_of_flat_quotient {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    [Algebra A B] [Algebra.FinitePresentation A B] (h : B)
    (hflat : Module.Flat A (B ⧸ Ideal.span {h})) :
    (LinearMap.ker (LinearMap.lsmul B B h)).FG := by
  have : Small.{u} B := Algebra.FiniteType.small (R := A)
  set e : Shrink.{u} B ≃ₐ[A] B := Shrink.algEquiv A B with he
  have : Algebra.FinitePresentation A (Shrink.{u} B) :=
    Algebra.FinitePresentation.equiv e.symm
  have hspan : Ideal.span {h} = (Ideal.span {e.symm h}).map (e : Shrink.{u} B →+* B) := by
    rw [Ideal.map_span, Set.image_singleton]
    simp
  have hflat' : Module.Flat A (Shrink.{u} B ⧸ Ideal.span {e.symm h}) :=
    Module.Flat.of_linearEquiv
      (Ideal.quotientEquivAlg (R₁ := A) (Ideal.span {e.symm h}) (Ideal.span {h}) e
        hspan).toLinearEquiv
  simpa using fg_ker_lsmul_of_ringEquiv e.toRingEquiv (e.symm h)
    (fg_ker_lsmul_of_flat_quotient_aux (A := A) (e.symm h) hflat')

end Stacks.RingTheory.SpreadingOut

