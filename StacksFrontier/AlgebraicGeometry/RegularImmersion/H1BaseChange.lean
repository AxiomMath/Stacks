module

public import StacksFrontier.AlgebraicGeometry.Descent.LocalOnTarget.RegularImmersion
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Independence
public import StacksCore.Tactic.StacksAttribute

/-!
# Base change of an `H₁`-regular immersion

Let `i : Z ⟶ X` be an immersion of schemes over a base `S` whose source is flat over `S`.  If `i`
is an `H₁`-regular immersion, then so is its base change along any `S' ⟶ S`.  This is the
`H₁`-regular half of Stacks tag 063R, the quasi-regular half being
`Stacks.AlgebraicGeometry.isQuasiRegularImmersion_baseChange_of_flat`.

## Main results

* `Stacks.AlgebraicGeometry.isH1RegularImmersion_baseChange_iff`: the base change of an immersion
  is `H₁`-regular exactly when the defining ideal of its closed factor through the preimage of
  `i.coborderRange` is `H₁`-regular.
* `Stacks.AlgebraicGeometry.isH1RegularIdealSheaf_definingIdealOfHom_of_isPullback`: for a closed
  immersion `j : Z ⟶ Y` of schemes over `S` with `Z ⟶ S` flat, `H₁`-regularity of the defining
  ideal of `j` is inherited by the defining ideal of its base change along `S' ⟶ S`.
* `Stacks.AlgebraicGeometry.isH1RegularImmersion_of_isPullback`: the same for an arbitrary
  immersion and an arbitrary cartesian square.
* `Stacks.AlgebraicGeometry.isH1RegularImmersion_baseChange_of_flat`: **the `H₁`-regular half of
  Stacks tag 063R**, in the `pullback` spelling.

## Implementation notes

The argument is the one of
`StacksFrontier.AlgebraicGeometry.RegularImmersion.BaseChange`, run on the `H₁` condition: near a
point of the base-changed subscheme one chooses an affine open `V` of `S`, an affine open `U` of
`Y` over `V` on which the defining ideal of `j` is generated by an `H₁`-regular family `s`, an
affine open `W` of `S'` over `V` and the affine open `U' = a⁻¹U ⊓ h'⁻¹W` of `Y'`, and reads the
two resulting pushout squares of rings through the `H₁` half of Stacks tag 0CEP
(`Stacks.AlgebraicGeometry.isQuasiRegular_and_isH1Regular_of_isPushout_of_ker_eq_span`) and
through `Stacks.Flatness.ker_inl_of_isPushout`.

Two things differ from the quasi-regular half, and they are why this is a separate file.  The
`H₁`-regularity of an ideal sheaf is a condition on Koszul homology of germs, so the passage
between it and ring-level `H₁`-regularity of a family of sections over an affine open is not the
form of Stacks tag 063G available for the quasi-regular condition but
`AlgebraicGeometry.isH1RegularIdealSheaf_iff_kerGeneratedBy`, which is proved downstream of the
quasi-regular half; and that criterion is phrased on the closure of the image of `j` rather than
on the support of the quotient, which for a closed immersion is the image itself.

## References

* [Stacks Project, Lemma 31.22.1 (Tag 063R)](https://stacks.math.columbia.edu/tag/063R)
* [Stacks Project, Lemma 31.21.2 (Tag 063J)](https://stacks.math.columbia.edu/tag/063J)
* [Stacks Project, Lemma 15.84.4 (Tag 0CEP)](https://stacks.math.columbia.edu/tag/0CEP)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.AlgebraicGeometry

universe u

section BaseChangeOpen

variable {Z X X' Z' : Scheme.{u}} {i : Z ⟶ X} [IsImmersion i] {p : X' ⟶ X} {i' : Z' ⟶ X'}
  {q : Z' ⟶ Z} (H : IsPullback i' q p i)

/-- **The base change of an immersion is `H₁`-regular exactly when its defining ideal on the
preimage of `i.coborderRange` is `H₁`-regular.**  The `H₁` counterpart of
`Stacks.AlgebraicGeometry.isQuasiRegularImmersion_baseChange_iff`, and like it an instance of the
independence of the chosen open, part (3) of Stacks tag 063J. -/
theorem isH1RegularImmersion_baseChange_iff [IsImmersion i'] :
    IsH1RegularImmersion i' ↔
      IsH1RegularIdealSheaf
        (p ⁻¹ᵁ i.coborderRange).toScheme.toLocallyRingedSpace.toRingedSpace
        (definingIdealOfHom (baseChangeLiftCoborder H)) :=
  isH1RegularImmersion_iff_of_open i' (p ⁻¹ᵁ i.coborderRange)
    (baseChangeLiftCoborder H) (baseChangeLiftCoborder_ι H)

end BaseChangeOpen

section ClosedImmersion

/-- **Base change of an `H₁`-regular defining ideal, for a closed immersion.**  Let `j : Z ⟶ Y` be
a closed immersion of schemes over `S` with `Z ⟶ S` flat, let `Y' = S' ×_S Y` and let
`j' : Z' ⟶ Y'` be the base change of `j`.  If the defining ideal of `j` is `H₁`-regular, so is the
defining ideal of `j'`. -/
theorem isH1RegularIdealSheaf_definingIdealOfHom_of_isPullback
    {S S' Y Y' Z Z' : Scheme.{u}} {σ : S' ⟶ S} {h : Y ⟶ S} {h' : Y' ⟶ S'} {a : Y' ⟶ Y}
    (HY : IsPullback h' a σ h) {j : Z ⟶ Y} [IsClosedImmersion j] {j' : Z' ⟶ Y'} {q : Z' ⟶ Z}
    (HZ : IsPullback j' q a j) [Flat (j ≫ h)]
    (hH1 : IsH1RegularIdealSheaf Y.toRingedSpace (definingIdealOfHom j)) :
    IsH1RegularIdealSheaf Y'.toRingedSpace (definingIdealOfHom j') := by
  have _ : IsClosedImmersion j' := MorphismProperty.of_isPullback HZ.flip inferInstance
  rw [isH1RegularIdealSheaf_iff_kerGeneratedBy] at hH1 ⊢
  intro y' hy'
  -- the image of a closed immersion is closed, so the point lies in the image of `j'`
  obtain ⟨z', rfl⟩ : y' ∈ Set.range j'.base := by
    rwa [← j'.isClosedEmbedding.isClosed_range.closure_eq]
  have hay : a (j' z') = j (q z') := congrArg (fun F : Z' ⟶ Y => F.base z') HZ.w
  have hsupp : a (j' z') ∈ closure (Set.range j.base) := subset_closure ⟨q z', hay.symm⟩
  obtain ⟨U₀, hyU₀, r, s₀, hker₀, hH1₀⟩ := hH1 _ hsupp
  -- affine opens: `V` of `S`, `U ≤ U₀ ⊓ h⁻¹V` of `Y`, `W ≤ σ⁻¹V` of `S'`
  obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset
    (U := (⊤ : S.Opens)) (x := h (a (j' z'))) trivial
  obtain ⟨U, hU, hyU, hUle⟩ := exists_isAffineOpen_mem_and_subset
    (show a (j' z') ∈ U₀.1 ⊓ h ⁻¹ᵁ V from ⟨hyU₀, hxV⟩)
  have hUU₀ : U ≤ U₀.1 := hUle.trans inf_le_left
  have hUV : U ≤ h ⁻¹ᵁ V := hUle.trans inf_le_right
  have hσ : σ (h' (j' z')) = h (a (j' z')) :=
    congrArg (fun F : Y' ⟶ S => F.base (j' z')) HY.w
  obtain ⟨W, hW, hzW, hWV⟩ := exists_isAffineOpen_mem_and_subset
    (show h' (j' z') ∈ σ ⁻¹ᵁ V from by change σ (h' (j' z')) ∈ V; rw [hσ]; exact hxV)
  -- the restriction of the generating family to `U`, still generating and `H₁`-regular
  set s : Fin r → Γ(Y, U) := fun b => Y.presheaf.map (homOfLE hUU₀).op (s₀ b) with hs
  have hgen : IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom j) U s :=
    isGeneratedByOn_of_le U₀.1 s₀
      (isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span j U₀.2 s₀ hker₀) U hUU₀
  have hH1s : Koszul.IsH1Regular s := by
    refine (forall_isH1Regular_germFamily_iff Y hU s).mp fun y hy => ?_
    rw [hs, germFamily_res U₀.1 U hUU₀ s₀ y hy]
    exact (forall_isH1Regular_germFamily_iff Y U₀.2 s₀).mpr hH1₀ y (hUU₀ hy)
  -- the affine open `U'` of `Y'`
  set U' : Y'.Opens := a ⁻¹ᵁ U ⊓ h' ⁻¹ᵁ W with hU'def
  have hU' : IsAffineOpen U' :=
    isAffineOpen_inf_preimage_of_isPullback HY.flip hV hU hW hUV hWV
  have hyU' : j' z' ∈ U' := ⟨by change a (j' z') ∈ U; exact hyU, hzW⟩
  have hU'U : U' ≤ a ⁻¹ᵁ U := inf_le_left
  -- the two pushout squares
  have hPY := isPushout_appLE_of_isPullback_affineOpens HY.flip hV hU hW hUV hWV
    (Q := U') hU'def
  have hTU' : j' ⁻¹ᵁ U' ≤ q ⁻¹ᵁ (j ⁻¹ᵁ U) := by
    have hcomp : j' ⁻¹ᵁ (a ⁻¹ᵁ U) = q ⁻¹ᵁ (j ⁻¹ᵁ U) := by
      rw [← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage, HZ.w]
    exact hcomp.le.trans' (j'.preimage_mono hU'U)
  have hPZ := isPushout_appLE_of_isPullback_affineOpens HZ.flip hU (hU.preimage j) hU'
    le_rfl hU'U (Q := j' ⁻¹ᵁ U') (inf_eq_right.mpr hTU').symm
  -- the kernel of `j.app U` is the ideal generated by `s`
  set φ := j.appLE U (j ⁻¹ᵁ U) le_rfl with hφ
  have hkerU : RingHom.ker φ.hom = Ideal.span (Set.range s) := by
    rw [hφ, Scheme.Hom.appLE_eq_app]
    exact ker_app_eq_span_range j hU s hgen
  have hsurj : Function.Surjective φ.hom := by
    rw [hφ, Scheme.Hom.appLE_eq_app]
    exact j.app_surjective U hU
  -- `H₁`-regularity of the image family, by Stacks tag 0CEP
  have hflat : ((h.appLE V U hUV) ≫ φ).hom.Flat := by
    rw [hφ, Scheme.Hom.appLE_comp_appLE]
    exact (j ≫ h).flat_appLE hV (hU.preimage j) _
  have hH1' := (isQuasiRegular_and_isH1Regular_of_isPushout_of_ker_eq_span (h.appLE V U hUV)
    (σ.appLE V W hWV) φ hPY hsurj hflat s hkerU).2 hH1s
  -- and the kernel of `j'.app U'` is generated by that family
  have hkerU' : RingHom.ker (j'.app U').hom =
      Ideal.span (Set.range fun b => (a.appLE U U' hU'U).hom (s b)) := by
    have hk := Stacks.Flatness.ker_inl_of_isPushout hPZ.flip hsurj
    rw [Scheme.Hom.appLE_eq_app (f := j') (U := U')] at hk
    rw [hk, hkerU, Ideal.map_span, ← Set.range_comp]
    rfl
  exact ⟨⟨U', hU'⟩, hyU', r, _, hkerU', hH1'⟩

end ClosedImmersion

section Immersion

/-- **Base change of an `H₁`-regular immersion, for an arbitrary cartesian square.**  Let
`i : Z ⟶ X` be an immersion of schemes over `S` with `Z ⟶ S` flat, let `X' = S' ×_S X` and let
`i' : Z' ⟶ X'` be the base change of `i`.  If `i` is an `H₁`-regular immersion, so is `i'`. -/
theorem isH1RegularImmersion_of_isPullback {S S' X X' Z Z' : Scheme.{u}} {f : X ⟶ S}
    {σ : S' ⟶ S} {fX : X' ⟶ S'} {p : X' ⟶ X} (HX : IsPullback fX p σ f)
    {i : Z ⟶ X} [IsImmersion i] {i' : Z' ⟶ X'} [IsImmersion i'] {q : Z' ⟶ Z}
    (HZ : IsPullback i' q p i) [Flat (i ≫ f)] (hi : IsH1RegularImmersion i) :
    IsH1RegularImmersion i' := by
  have hflat : Flat (i.liftCoborder ≫ i.coborderRange.ι ≫ f) := by
    rw [← Category.assoc, i.liftCoborder_ι]
    infer_instance
  rw [isH1RegularImmersion_baseChange_iff HZ]
  exact isH1RegularIdealSheaf_definingIdealOfHom_of_isPullback
    ((isPullback_morphismRestrict p i.coborderRange).flip.paste_horiz HX)
    (isPullback_baseChangeLiftCoborder HZ) hi

/-- **Stacks Project, Tag 063R, the `H₁`-regular half.**  An `H₁`-regular immersion whose source
is flat over the base remains `H₁`-regular after any base change of the base scheme. -/
@[stacks 063R "h1_base_change"]
theorem isH1RegularImmersion_baseChange_of_flat {S X Z S' : Scheme.{u}} (f : X ⟶ S)
    (i : Z ⟶ X) [IsImmersion i] [Flat (i ≫ f)] (hi : IsH1RegularImmersion i) (g : S' ⟶ S) :
    IsH1RegularImmersion (pullback.fst (pullback.snd g f) i) :=
  isH1RegularImmersion_of_isPullback (IsPullback.of_hasPullback g f)
    (IsPullback.of_hasPullback (pullback.snd g f) i) hi

end Immersion

end Stacks.AlgebraicGeometry

end
