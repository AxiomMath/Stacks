module

public import StacksFrontier.AlgebraicGeometry.RegularImmersion.Basic
public import StacksFrontier.AlgebraicGeometry.RegularImmersion.Stalkwise
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Immersion

/-!
# The defining ideal of an immersion over an affine open

Let `j : Z ⟶ U` be a morphism of schemes.  Its defining ideal is the sectionwise kernel of
`O_U ⟶ j_* O_Z`, whose map on sections is `j.app`, so the sections of the defining ideal over an
open `V` are the kernel of `j.app V`.  When `j` is a closed immersion and `V` is affine, `j.app V`
is surjective, so the ring of sections of `Z` over `j⁻¹V` is the quotient of `Γ(U, V)` by the
defining ideal.

## Main results

* `Stacks.AlgebraicGeometry.mem_definingIdealOfHom_iff_app`: a section lies in the defining ideal
  exactly when `j.app` kills it.
* `Stacks.AlgebraicGeometry.quotientDefiningIdealEquiv`: for a closed immersion and an affine
  open, `Γ(U, V) / ker (j.app V) ≃+* Γ(Z, j⁻¹V)`.
* `Stacks.AlgebraicGeometry.ker_app_eq_span_range`: over an affine open on which the defining
  ideal is generated by a family of sections, the kernel of `j.app` is the ideal they generate.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularIdealSheaf_of_exists_affine_generators`:
  an ideal sheaf generated near each point of the support, on an affine open, by a weakly regular
  sequence in the ring of sections is a regular ideal sheaf (Stacks tag 063D, part (1)).

## References

* [Stacks Project, Definition 31.21.1 (Tag 063J)](https://stacks.math.columbia.edu/tag/063J)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry RingedSpaceModuleAdjunction
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.RingedSpace
open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.AlgebraicGeometry

universe u

/-- A section of `O_U` over `V`
belongs to the defining ideal of `j : Z ⟶ U` exactly when its image under `j.app V` vanishes. -/
theorem mem_definingIdealOfHom_iff_app {Z U : Scheme.{u}} (j : Z ⟶ U)
    (V : Opens U.toLocallyRingedSpace.toRingedSpace)
    (s : (structureSheafModule U.toLocallyRingedSpace.toRingedSpace).val.obj (op V)) :
    s ∈ (definingIdealOfHom j).obj (op V) ↔ (j.app V).hom s = 0 :=
  Iff.rfl

/-- For a closed immersion `j : Z ⟶ U` and an affine open `V` of `U`, the ring of sections of `Z`
over `j⁻¹V` is the quotient of `Γ(U, V)` by the defining ideal. -/
def quotientDefiningIdealEquiv {Z U : Scheme.{u}} (j : Z ⟶ U) [IsClosedImmersion j]
    {V : U.Opens} (hV : IsAffineOpen V) :
    (Γ(U, V) ⧸ RingHom.ker (j.app V).hom) ≃+* Γ(Z, j ⁻¹ᵁ V) :=
  RingHom.quotientKerEquivOfSurjective (Scheme.Hom.app_surjective j V hV)

/-- The germs of a family of sections generate the extension of the ideal it generates. -/
theorem map_germ_span_range {X : Scheme.{u}} {V : X.Opens} {r : ℕ} (f : Fin r → Γ(X, V))
    (y : X) (hy : y ∈ V) :
    (Ideal.span (Set.range f)).map (X.presheaf.germ V y hy).hom =
      _root_.Jid (RegularIdealSheaf.germFamily X.toRingedSpace V f y hy) := by
  rw [Ideal.map_span, _root_.Jid, ← Set.range_comp]
  rfl

/-- If the defining ideal of `j : Z ⟶ U` is generated over an affine open `V` by a family `f` of
sections, then the kernel of `j.app V` is the ideal of `Γ(U, V)` generated by the `fᵢ`. -/
theorem ker_app_eq_span_range {Z U : Scheme.{u}} (j : Z ⟶ U) {V : U.Opens}
    (hV : IsAffineOpen V) {r : ℕ} (f : Fin r → Γ(U, V))
    (hgen : RegularIdealSheaf.IsGeneratedByOn U.toRingedSpace (definingIdealOfHom j) V f) :
    RingHom.ker (j.app V).hom = Ideal.span (Set.range f) := by
  have hker : RingHom.ker (j.app V).hom = (definingIdealOfHom j).obj (op V) := rfl
  rw [hker, hgen V le_rfl]
  refine le_antisymm (fun s hs => ?_) (Ideal.span_le.mpr ?_)
  · exact hV.mem_ideal_iff.mpr fun y hy => by
      rw [map_germ_span_range f y hy]
      exact (RegularIdealSheaf.mem_generatedIdealOn_iff V f V le_rfl s).mp hs y hy
  · rintro _ ⟨i, rfl⟩
    exact RegularIdealSheaf.mem_generatedIdealOn U.toRingedSpace V f i

namespace RegularIdealSheaf

/-- If near every point of the support of `O_X / J` the ideal sheaf `J` is generated on an affine
open by a family of sections which is weakly regular in the ring of sections of that open, then
`J` is a regular ideal sheaf in the sense of Stacks tag 063D, part (1). -/
theorem isRegularIdealSheaf_of_exists_affine_generators (X : Scheme.{u})
    (J : (structureSheafModule X.toRingedSpace).Submodule)
    (h : ∀ x : X, x ∈ idealQuotientSupport X.toRingedSpace J →
      ∃ (U : X.Opens) (_hU : IsAffineOpen U) (_hx : x ∈ U) (r : ℕ) (f : Fin r → Γ(X, U)),
        IsGeneratedByOn X.toRingedSpace J U f ∧
          RingTheory.Sequence.IsWeaklyRegular Γ(X, U) (List.ofFn f)) :
    IsRegularIdealSheaf X.toRingedSpace J := by
  intro x hx
  obtain ⟨U, hU, hxU, r, f, hgen, hwr⟩ := h x hx
  exact ⟨U, hxU, r, f, isRegularSequenceOn_of_isWeaklyRegular X U hU f hwr, hgen⟩

end RegularIdealSheaf

end Stacks.AlgebraicGeometry

end
