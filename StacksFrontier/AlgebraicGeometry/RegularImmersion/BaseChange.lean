namespace Stacks.AlgebraicGeometry

universe u

section Pushout

/-- **A cartesian square of schemes is a pushout square on sections over affine opens.**  Given a
cartesian square with vertices `P`, `X`, `Y`, `S`, an affine open `U` of the base `S`, affine
opens `V` of `X` and `W` of `Y` lying over it, and the affine open `Q = a⁻¹V ⊓ b⁻¹W` of `P`, the
rings of sections form a pushout square. -/
lemma isPushout_appLE_of_isPullback_affineOpens {S X Y P : Scheme.{u}} {f : X ⟶ S}
    {g : Y ⟶ S} {a : P ⟶ X} {b : P ⟶ Y} (hp : IsPullback a b f g)
    {U : S.Opens} (hU : IsAffineOpen U) {V : X.Opens} (hV : IsAffineOpen V)
    {W : Y.Opens} (hW : IsAffineOpen W) (hVU : V ≤ f ⁻¹ᵁ U) (hWU : W ≤ g ⁻¹ᵁ U)
    {Q : P.Opens} (hQ : Q = a ⁻¹ᵁ V ⊓ b ⁻¹ᵁ W) :
    IsPushout (f.appLE U V hVU) (g.appLE U W hWU)
      (a.appLE V Q (hQ.le.trans inf_le_left)) (b.appLE W Q (hQ.le.trans inf_le_right)) := by
  have _ : IsAffine U.toScheme := hU
  have _ : IsAffine V.toScheme := hV
  have _ : IsAffine W.toScheme := hW
  exact (isPushout_appTop_of_isPullback
      (Scheme.Hom.isPullback_resLE hp hWU hVU hQ)).of_iso
    U.topIso V.topIso W.topIso Q.topIso
    (arrowResLEAppIso f U V hVU).hom.w.symm
    (arrowResLEAppIso g U W hWU).hom.w.symm
    (arrowResLEAppIso a V Q (hQ.le.trans inf_le_left)).hom.w.symm
    (arrowResLEAppIso b W Q (hQ.le.trans inf_le_right)).hom.w.symm

/-- The open `a⁻¹V ⊓ b⁻¹W` of the vertex of a cartesian square is affine when the three other
opens involved are. -/
lemma isAffineOpen_inf_preimage_of_isPullback {S X Y P : Scheme.{u}} {f : X ⟶ S}
    {g : Y ⟶ S} {a : P ⟶ X} {b : P ⟶ Y} (hp : IsPullback a b f g)
    {U : S.Opens} (hU : IsAffineOpen U) {V : X.Opens} (hV : IsAffineOpen V)
    {W : Y.Opens} (hW : IsAffineOpen W) (hVU : V ≤ f ⁻¹ᵁ U) (hWU : W ≤ g ⁻¹ᵁ U) :
    IsAffineOpen (a ⁻¹ᵁ V ⊓ b ⁻¹ᵁ W) := by
  have _ : IsAffine U.toScheme := hU
  have _ : IsAffine V.toScheme := hV
  have _ : IsAffine W.toScheme := hW
  exact IsAffine.of_isPullback (Scheme.Hom.isPullback_resLE hp hWU hVU rfl)

end Pushout

section Ring

/-- **Stacks tag 0CEP read off a pushout square of rings.**  Let
```
A ⟶ B
↓    ↓
A' ⟶ D
```
be a pushout square of commutative rings, let `q : B ⟶ C` be surjective with kernel generated by
a family `s`, and suppose `C` is flat over `A`.  Then the image of `s` in `D` is quasi-regular if
`s` is, and `H₁`-regular if `s` is.

The quotient `B/(s)` is `C`, hence flat over `A`, which is the hypothesis of Stacks tag 0CEP; and
`D` is `B ⊗_A A'` by the universal property of the tensor product, under an isomorphism carrying
`b ⊗ 1` to the image of `b`. -/
theorem isQuasiRegular_and_isH1Regular_of_isPushout_of_ker_eq_span {A B C A' D : CommRingCat.{u}}
    (φ : A ⟶ B) (ψ : A ⟶ A') (q : B ⟶ C) {k : B ⟶ D} {l : A' ⟶ D}
    (H : IsPushout φ ψ k l) (hq : Function.Surjective q.hom) (hf : (φ ≫ q).hom.Flat)
    {r : ℕ} (s : Fin r → B) (hker : RingHom.ker q.hom = Ideal.span (Set.range s)) :
    (IsQuasiRegular B (List.ofFn s) → IsQuasiRegular D (List.ofFn fun a => k.hom (s a))) ∧
      (Koszul.IsH1Regular s → Koszul.IsH1Regular fun a => k.hom (s a)) := by
  let _ : Algebra A B := φ.hom.toAlgebra
  let _ : Algebra A A' := ψ.hom.toAlgebra
  let _ : Algebra B C := q.hom.toAlgebra
  let _ : Algebra A C := (φ ≫ q).hom.toAlgebra
  have _ : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' rfl
  have hflatC : Module.Flat A C := hf
  -- `B/(s) ≃ C` as an `A`-algebra, so the quotient is flat over `A`
  have hflat : Module.Flat A (B ⧸ Ideal.span (Set.range s)) := by
    let e₁ : (B ⧸ Ideal.span (Set.range s)) ≃ₐ[A] (B ⧸ RingHom.ker q.hom) :=
      Ideal.quotientEquivAlgOfEq A hker.symm
    let e₂ : (B ⧸ RingHom.ker q.hom) ≃ₐ[A] C :=
      Ideal.quotientKerAlgEquivOfSurjective (f := ({ q.hom with commutes' := fun _ => rfl } :
        B →ₐ[A] C)) hq
    exact Module.Flat.of_linearEquiv (e₁.trans e₂).toLinearEquiv
  -- Stacks tag 0CEP in `B ⊗[A] A'`
  have h0CEP := Koszul.quasiRegular_and_h1Regular_baseChange_of_quotient_flat
    (A := A) (A' := A') s hflat
  -- transport along the canonical isomorphism `B ⊗[A] A' ≅ D`
  let e := ((CommRingCat.isPushout_tensorProduct A B A').isoIsPushout B A' H :
    CommRingCat.of (TensorProduct A B A') ≅ D).commRingCatIsoToRingEquiv
  have he (b : B) : e (Algebra.TensorProduct.includeLeftRingHom b) = k.hom b :=
    congrArg (fun F : B ⟶ D => F.hom b)
      ((CommRingCat.isPushout_tensorProduct A B A').inl_isoIsPushout_hom B A' H)
  have hefun : (fun a => k.hom (s a)) =
      fun a => e.toRingHom (KoszulH1.fp (A := A) (A' := A') s a) :=
    funext fun b => (he (s b)).symm
  have hflate : (e.toRingHom).Flat := RingHom.Flat.of_bijective e.bijective
  refine ⟨fun hs => ?_, fun hs => ?_⟩
  · rw [hefun]
    have := Koszul.isQuasiRegular_map_of_flat e.toRingHom hflate (h0CEP.1 hs)
    rwa [List.map_ofFn] at this
  · let _ : Algebra (TensorProduct A B A') D := e.toRingHom.toAlgebra
    have _ : Module.Flat (TensorProduct A B A') D := hflate
    rw [hefun]
    simpa only [RingHom.algebraMap_toAlgebra] using Koszul.isH1Regular_map_of_flat (S := D)
      (KoszulH1.fp (A := A) (A' := A') s) (h0CEP.2 hs)

end Ring

section Generated

variable {Z U : Scheme.{u}}

/-- **The converse of `Stacks.AlgebraicGeometry.ker_app_eq_span_range`.**  If over an affine open
`V` the kernel of `j.app V` is the ideal generated by a family `f` of sections, then `f` generates
the defining ideal sheaf of `j` over `V`.

One inclusion is minimality of the generated ideal sheaf.  For the other, the defining ideal is
the kernel ideal sheaf `j.ker` of `j`, which is quasi-coherent: over an affine open `W` of `V` its
sections are the extension of its sections over `V` along the restriction map
(`AlgebraicGeometry.Scheme.IdealSheafData.map_ideal`).  So a section of the defining ideal over an
arbitrary open `V' ≤ V` lies in the generated ideal sheaf on each affine open of a cover of `V'`,
and the sheaf condition for an embedded submodule sheaf finishes the argument. -/
theorem isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span (j : Z ⟶ U) [QuasiCompact j]
    {V : U.Opens} (hV : IsAffineOpen V) {r : ℕ} (f : Fin r → Γ(U, V))
    (hker : RingHom.ker (j.app V).hom = Ideal.span (Set.range f)) :
    IsGeneratedByOn U.toRingedSpace (definingIdealOfHom j) V f := by
  set K := generatedIdealOn U.toRingedSpace V f with hK
  have hle : K ≤ definingIdealOfHom j := by
    refine generatedIdealOn_le _ _ _ _ fun a => ?_
    refine (mem_definingIdealOfHom_iff_app j V (f a)).mpr (RingHom.mem_ker.mp ?_)
    rw [hker]
    exact Ideal.subset_span (Set.mem_range_self a)
  intro V' hV'V
  refine le_antisymm (fun t ht => ?_) (hle (op V'))
  refine K.isSheaf t ?_
  rw [Opens.mem_grothendieckTopology]
  intro x hx
  obtain ⟨W, hW, hxW, hWV'⟩ := exists_isAffineOpen_mem_and_subset (X := U) hx
  have hWV' : W ≤ V' := hWV'
  refine ⟨W, homOfLE hWV', ?_, hxW⟩
  change (U.presheaf.map (homOfLE hWV').op).hom t ∈ K.obj (op W)
  -- the restriction of `t` to `W` is killed by `j.app W`
  have htW : (U.presheaf.map (homOfLE hWV').op).hom t ∈ RingHom.ker (j.app W).hom :=
    (definingIdealOfHom j).toSubmodule.map_mem (homOfLE hWV').op ht
  -- and that kernel is the extension of `span (range f)` along the restriction map
  have heq : RingHom.ker (j.app W).hom =
      Ideal.map (U.presheaf.map (homOfLE (hWV'.trans hV'V)).op).hom
        (Ideal.span (Set.range f)) := by
    rw [← hker, ← Scheme.Hom.ker_apply j ⟨W, hW⟩, ← Scheme.Hom.ker_apply j ⟨V, hV⟩]
    exact (j.ker.map_ideal (U := ⟨W, hW⟩) (V := ⟨V, hV⟩) (hWV'.trans hV'V)).symm
  rw [heq] at htW
  refine (show Ideal.map (U.presheaf.map (homOfLE (hWV'.trans hV'V)).op).hom
      (Ideal.span (Set.range f)) ≤ K.obj (op W) from ?_) htW
  refine Ideal.map_le_iff_le_comap.mpr (Ideal.span_le.mpr ?_)
  rintro _ ⟨a, rfl⟩
  exact K.toSubmodule.map_mem (homOfLE (hWV'.trans hV'V)).op
    (mem_generatedIdealOn U.toRingedSpace V f a)

end Generated

section ClosedImmersion

/-- **Base change of a quasi-regular defining ideal, for a closed immersion.**  Let `j : Z ⟶ Y` be
a closed immersion of schemes over `S` with `Z ⟶ S` flat, let `Y' = S' ×_S Y` and let
`j' : Z' ⟶ Y'` be the base change of `j`.  If the defining ideal of `j` is quasi-regular, so is
the defining ideal of `j'`.

This is the content of the quasi-regular half of Stacks tag 063R;  the version for an arbitrary
immersion, `isQuasiRegularImmersion_of_isPullback`, is deduced from it. -/
theorem isQuasiRegularIdealSheaf_definingIdealOfHom_of_isPullback
    {S S' Y Y' Z Z' : Scheme.{u}} {σ : S' ⟶ S} {h : Y ⟶ S} {h' : Y' ⟶ S'} {a : Y' ⟶ Y}
    (HY : IsPullback h' a σ h) {j : Z ⟶ Y} [IsClosedImmersion j] {j' : Z' ⟶ Y'} {q : Z' ⟶ Z}
    (HZ : IsPullback j' q a j) [Flat (j ≫ h)]
    (hqr : IsQuasiRegularIdealSheaf Y.toRingedSpace (definingIdealOfHom j)) :
    IsQuasiRegularIdealSheaf Y'.toRingedSpace (definingIdealOfHom j') := by
  have _ : IsClosedImmersion j' := MorphismProperty.of_isPullback HZ.flip inferInstance
  refine (isQuasiRegularIdealSheaf_iff_exists_affine_generators Y' _).mpr fun y' hy' => ?_
  -- the point lies in the image of `j'`, so its image in `Y` lies in the image of `j`
  rw [definingIdealQuotient_support_eq_range j'] at hy'
  obtain ⟨z', rfl⟩ := hy'
  have hay : a (j' z') = j (q z') := congrArg (fun F : Z' ⟶ Y => F.base z') HZ.w
  have hsupp : a (j' z') ∈ idealQuotientSupport Y.toRingedSpace (definingIdealOfHom j) := by
    rw [definingIdealQuotient_support_eq_range j, hay]
    exact Set.mem_range_self _
  obtain ⟨U₀, hyU₀, r, s₀, hgen₀, hqr₀⟩ := (isQuasiRegularIdealSheaf_iff_exists_affine_generators
    Y (definingIdealOfHom j)).mp hqr _ hsupp
  -- affine opens: `V` of `S`, `U ≤ U₀ ⊓ h⁻¹V` of `Y`, `W ≤ σ⁻¹V` of `S'`
  obtain ⟨V, hV, hxV, -⟩ := Opens.isBasis_iff_nbhd.mp S.isBasis_affineOpens
    (show h (a (j' z')) ∈ (⊤ : S.Opens) from trivial)
  obtain ⟨U, hU, hyU, hUle⟩ := Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens
    (show a (j' z') ∈ U₀.1 ⊓ h ⁻¹ᵁ V from ⟨hyU₀, hxV⟩)
  have hUU₀ : U ≤ U₀.1 := hUle.trans inf_le_left
  have hUV : U ≤ h ⁻¹ᵁ V := hUle.trans inf_le_right
  have hσ : σ (h' (j' z')) = h (a (j' z')) :=
    congrArg (fun F : Y' ⟶ S => F.base (j' z')) HY.w
  obtain ⟨W, hW, hzW, hWV⟩ := Opens.isBasis_iff_nbhd.mp S'.isBasis_affineOpens
    (show h' (j' z') ∈ σ ⁻¹ᵁ V from by change σ (h' (j' z')) ∈ V; rw [hσ]; exact hxV)
  -- the restriction of the generating family to `U`, still generating and quasi-regular
  set s : Fin r → Γ(Y, U) := fun b => Y.presheaf.map (homOfLE hUU₀).op (s₀ b) with hs
  have hgen : IsGeneratedByOn Y.toRingedSpace (definingIdealOfHom j) U s :=
    isGeneratedByOn_of_le U₀.1 s₀ hgen₀ U hUU₀
  have hqrs : IsQuasiRegular Γ(Y, U) (List.ofFn s) := by
    refine (forall_isQuasiRegularRel_germ_iff Y U hU s).mp fun y hy => ?_
    rw [hs, germFamily_res U₀.1 U hUU₀ s₀ y hy]
    exact (forall_isQuasiRegularRel_germ_iff Y U₀.1 U₀.2 s₀).mpr hqr₀ y (hUU₀ hy)
  -- the affine open `U'` of `Y'`
  set U' : Y'.Opens := a ⁻¹ᵁ U ⊓ h' ⁻¹ᵁ W with hU'def
  have hU' : IsAffineOpen U' :=
    isAffineOpen_inf_preimage_of_isPullback HY.flip hV hU hW hUV hWV
  have hyU' : j' z' ∈ U' := ⟨by change a (j' z') ∈ U; exact hyU, hzW⟩
  have hU'U : U' ≤ a ⁻¹ᵁ U := inf_le_left
  -- the two pushout squares
  have hPY := isPushout_appLE_of_isPullback_affineOpens HY.flip hV hU hW hUV hWV
    (Q := U') hU'def
  have hTU' : j' ⁻¹ᵁ U' ≤ q ⁻¹ᵁ (j ⁻¹ᵁ U) := by
    have hcomp : j' ⁻¹ᵁ (a ⁻¹ᵁ U) = q ⁻¹ᵁ (j ⁻¹ᵁ U) := by
      rw [← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage, HZ.w]
    exact hcomp.le.trans' (j'.preimage_mono hU'U)
  have hPZ := isPushout_appLE_of_isPullback_affineOpens HZ.flip hU (hU.preimage j) hU'
    le_rfl hU'U (Q := j' ⁻¹ᵁ U') (inf_eq_right.mpr hTU').symm
  -- the kernel of `j.app U` is the ideal generated by `s`
  have hkerU : RingHom.ker (j.appLE U (j ⁻¹ᵁ U) le_rfl).hom = Ideal.span (Set.range s) := by
    rw [Scheme.Hom.appLE_eq_app]
    exact ker_app_eq_span_range j hU s hgen
  have hsurj : Function.Surjective (j.appLE U (j ⁻¹ᵁ U) le_rfl).hom := by
    rw [Scheme.Hom.appLE_eq_app]
    exact j.app_surjective U hU
  -- quasi-regularity of the image family, by Stacks tag 0CEP
  have hflat : ((h.appLE V U hUV) ≫ j.appLE U (j ⁻¹ᵁ U) le_rfl).hom.Flat := by
    rw [Scheme.Hom.appLE_comp_appLE]
    exact (j ≫ h).flat_appLE hV (hU.preimage j) _
  have hqr' := (isQuasiRegular_and_isH1Regular_of_isPushout_of_ker_eq_span (h.appLE V U hUV)
    (σ.appLE V W hWV) (j.appLE U (j ⁻¹ᵁ U) le_rfl) hPY hsurj hflat s hkerU).1 hqrs
  -- and the kernel of `j'.app U'` is generated by that family
  have hkerU' : RingHom.ker (j'.app U').hom =
      Ideal.span (Set.range fun b => (a.appLE U U' hU'U).hom (s b)) := by
    have hk := Stacks.Flatness.ker_inl_of_isPushout hPZ.flip hsurj
    rw [Scheme.Hom.appLE_eq_app (f := j') (U := U')] at hk
    rw [hk, hkerU, Ideal.map_span, ← Set.range_comp]
    rfl
  exact ⟨⟨U', hU'⟩, hyU', r, _,
    isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span j' hU' _ hkerU', hqr'⟩

end ClosedImmersion

section Immersion

/-- **Base change of a quasi-regular immersion, for an arbitrary cartesian square.**  Let
`i : Z ⟶ X` be an immersion of schemes over `S` with `Z ⟶ S` flat, let `X' = S' ×_S X` and let
`i' : Z' ⟶ X'` be the base change of `i`.  If `i` is a quasi-regular immersion, so is `i'`.

The base change of the canonical closed factor of `i` is a closed immersion into
`p ⁻¹ᵁ i.coborderRange`, which is *not* `i'.coborderRange`; part (4) of Stacks tag 063J
(`isQuasiRegularImmersion_baseChange_iff`) is what lets quasi-regularity be read there. -/
theorem isQuasiRegularImmersion_of_isPullback {S S' X X' Z Z' : Scheme.{u}} {f : X ⟶ S}
    {σ : S' ⟶ S} {fX : X' ⟶ S'} {p : X' ⟶ X} (HX : IsPullback fX p σ f)
    {i : Z ⟶ X} [IsImmersion i] {i' : Z' ⟶ X'} [IsImmersion i'] {q : Z' ⟶ Z}
    (HZ : IsPullback i' q p i) [Flat (i ≫ f)] (hi : IsQuasiRegularImmersion i) :
    IsQuasiRegularImmersion i' := by
  have hflat : Flat (i.liftCoborder ≫ i.coborderRange.ι ≫ f) := by
    rw [← Category.assoc, i.liftCoborder_ι]
    infer_instance
  rw [isQuasiRegularImmersion_baseChange_iff HZ]
  exact isQuasiRegularIdealSheaf_definingIdealOfHom_of_isPullback
    ((isPullback_morphismRestrict p i.coborderRange).flip.paste_horiz HX)
    (isPullback_baseChangeLiftCoborder HZ) hi

/-- **Flatness of the source over the base survives base change.**  In the situation of
`isQuasiRegularImmersion_of_isPullback`, if `Z` is flat over `S` then `Z'` is flat over `S'`.

This is not an instance search away even when both squares are the standard `pullback` ones:  the
two cartesian squares have to be pasted first, and it is the pasted square that exhibits
`Z' ⟶ S'` as a base change of `Z ⟶ S`. -/
theorem flat_comp_of_isPullback {S S' X X' Z Z' : Scheme.{u}} {f : X ⟶ S} {σ : S' ⟶ S}
    {fX : X' ⟶ S'} {p : X' ⟶ X} (HX : IsPullback fX p σ f) {i : Z ⟶ X} {i' : Z' ⟶ X'}
    {q : Z' ⟶ Z} (HZ : IsPullback i' q p i) [Flat (i ≫ f)] : Flat (i' ≫ fX) :=
  MorphismProperty.of_isPullback (HZ.paste_horiz HX).flip ‹Flat (i ≫ f)›

/-- **Stacks Project, Tag 063R, the quasi-regular half.**  A quasi-regular immersion whose source
is flat over the base remains quasi-regular after any base change of the base scheme.

The `H₁`-regular half of the tag is
`Stacks.AlgebraicGeometry.isH1RegularImmersion_baseChange_of_flat`, in
`StacksFrontier.AlgebraicGeometry.RegularImmersion.H1BaseChange`. -/
@[stacks 063R "quasi_base_change"]
theorem isQuasiRegularImmersion_baseChange_of_flat {S X Z S' : Scheme.{u}} (f : X ⟶ S)
    (i : Z ⟶ X) [IsImmersion i] [Flat (i ≫ f)] (hi : IsQuasiRegularImmersion i) (g : S' ⟶ S) :
    IsQuasiRegularImmersion (pullback.fst (pullback.snd g f) i) :=
  isQuasiRegularImmersion_of_isPullback (IsPullback.of_hasPullback g f)
    (IsPullback.of_hasPullback (pullback.snd g f) i) hi

/-- **Stacks Project, Tag 063U, regularity after an arbitrary base change.**  A relative
quasi-regular immersion into a scheme flat and locally of finite presentation over the base
remains a regular immersion after any change of the base.

The base change is again a relative quasi-regular immersion over `S'`:  its quasi-regularity is
the quasi-regular half of Stacks tag 063R and the flatness of its source over `S'` is
`flat_comp_of_isPullback`.  Flatness and local finite presentation of `S' ×_S X ⟶ S'` are base
changes of those of `X ⟶ S`.  So the already-proved
`isRegularImmersion_of_isRelativeQuasiRegularImmersion` applies over `S'`. -/
@[stacks 063U "regularity after arbitrary base change", ega "IV 19.2.4" "c') => b')"]
theorem isRegularImmersion_baseChange_of_isRelativeQuasiRegularImmersion {S X Z S' : Scheme.{u}}
    (f : X ⟶ S) (i : Z ⟶ X) [IsImmersion i] [Flat f] [LocallyOfFinitePresentation f]
    (hi : IsRelativeQuasiRegularImmersion f i) (g : S' ⟶ S) :
    IsRegularImmersion (pullback.fst (pullback.snd g f) i) := by
  have : Flat (i ≫ f) := hi.1
  exact isRegularImmersion_of_isRelativeQuasiRegularImmersion (pullback.fst g f) _
    ⟨flat_comp_of_isPullback (IsPullback.of_hasPullback g f)
        (IsPullback.of_hasPullback (pullback.snd g f) i),
      isQuasiRegularImmersion_baseChange_of_flat f i hi.2 g⟩

end Immersion

end Stacks.AlgebraicGeometry

