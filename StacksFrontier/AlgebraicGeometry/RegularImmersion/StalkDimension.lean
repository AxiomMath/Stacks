/-!
# The local dimension drop along a regular immersion

Let `i : Z ⟶ X` be a regular immersion (Stacks 063J) into a locally Noetherian scheme, and let
`z ∈ Z`. Near `i z` the ideal of `Z` is generated by a regular sequence of sections of length
`s`; the germs of that sequence form a regular sequence of the local ring `𝒪_{X, i z}` cutting
out `𝒪_{Z, z}`, so `dim 𝒪_{X, i z} = dim 𝒪_{Z, z} + s` (Stacks 00KW), and on the chart the
conormal sheaf `𝒞_{Z/X}` is free of rank `s` (Stacks 063N). Hence

  `dim 𝒪_{X, i z} = dim 𝒪_{Z, z} + rk_z 𝒞_{Z/X}`.

## Main results

* `Stacks.AlgebraicGeometry.ringKrullDim_stalk_eq_add_fiberRank_conormalModule` — the
  displayed formula.

## References

* [Stacks Project, Tag 063J](https://stacks.math.columbia.edu/tag/063J)
* [Stacks Project, Tag 063N](https://stacks.math.columbia.edu/tag/063N)
* [Stacks Project, Tag 00KW](https://stacks.math.columbia.edu/tag/00KW)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry RingTheory.Sequence
open Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

namespace Stacks.AlgebraicGeometry

/-- **The local dimension drop along a regular immersion is the rank of the conormal sheaf.**
For a regular immersion `i : Z ⟶ X` into a locally Noetherian scheme and `z ∈ Z`,
`dim 𝒪_{X, i z} = dim 𝒪_{Z, z} + rk_z 𝒞_{Z/X}`: a regular sequence of length `s` generating the
ideal of `Z` near `i z` has germs forming a regular sequence of `𝒪_{X, i z}` with quotient
`𝒪_{Z, z}`, and the conormal sheaf has rank `s` there. -/
theorem ringKrullDim_stalk_eq_add_fiberRank_conormalModule {Z X : Scheme.{u}}
    [IsLocallyNoetherian X] (i : Z ⟶ X) [IsImmersion i] (hi : IsRegularImmersion i) (z : Z) :
    ringKrullDim (X.presheaf.stalk (i z)) =
      ringKrullDim (Z.presheaf.stalk z) +
        (Scheme.Modules.fiberRank (Stacks.Chow.conormalModule i) z : WithBot ℕ∞) := by
  set U := i.coborderRange
  set j : Z ⟶ U.toScheme := i.liftCoborder
  have hij : j ≫ U.ι = i := i.liftCoborder_ι
  have hreg : IsRegularIdealSheaf U.toScheme.toLocallyRingedSpace.toRingedSpace
      (definingIdealOfHom j) := (isRegularImmersion_iff_of_open i U j hij).mp hi
  have hx : j z ∈ idealQuotientSupport U.toScheme.toLocallyRingedSpace.toRingedSpace
      (definingIdealOfHom j) :=
    (mem_idealQuotientSupport_definingIdealOfHom_iff j (j z)).mpr (subset_closure ⟨z, rfl⟩)
  obtain ⟨U₀, hxU₀, s, g, hgreg, hgen⟩ := hreg (j z) hx
  -- the fibre rank of the conormal sheaf is the length `s`
  have hrank : Scheme.Modules.fiberRank (Stacks.Chow.conormalModule i) z = s := by
    rw [Scheme.Modules.fiberRank_eq_of_iso (Stacks.Chow.immersionConormalSheafFactorIso U j hij) z]
    obtain ⟨V, hV, hxV, hVU₀⟩ :=
      Opens.isBasis_iff_nbhd.mp U.toScheme.isBasis_affineOpens hxU₀
    have hker := ker_app_eq_span_range j hV _ (isGeneratedByOn_of_le U₀ g hgen V hVU₀)
    have hq := isQuasiRegular_of_isWeaklyRegular _ (isWeaklyRegular_of_isRegularSequenceOn
      U.toScheme V hV _ (isRegularSequenceOn_of_le _ hVU₀ g hgreg))
    exact Stacks.Conormal.fiberRank_conormalSheaf_eq_of_isQuasiRegular j hV
      (by rw [Stacks.Conormal.coborderRange_eq_top j]; exact le_top) _ hq hker hxV
  -- the germs of the sequence form a regular sequence of the local ring cutting out `𝒪_{Z, z}`
  set rs := List.ofFn (germFamily U.toScheme.toLocallyRingedSpace.toRingedSpace U₀ g (j z) hxU₀)
  have hspan : Ideal.ofList rs = RingHom.ker (j.stalkMap z).hom := by
    rw [ideal_ofList_ofFn, ← stalkIdeal_definingIdealOfHom_eq_ker,
      stalkIdeal_eq_Jid_germFamily _ U₀ g hgen (j z) hxU₀]
    rfl
  have hrs : IsRegular (U.toScheme.presheaf.stalk (j z)) rs := by
    refine (isRegular_iff _ _).mpr ⟨isWeaklyRegular_germFamily_of_isRegularSequenceOn _ U₀ g
      hgreg (j z) hxU₀, ?_⟩
    intro htop
    rw [show Ideal.ofList rs • (⊤ : Submodule (U.toScheme.presheaf.stalk (j z))
        (U.toScheme.presheaf.stalk (j z))) = Ideal.ofList rs from by simp, hspan] at htop
    exact RingHom.ker_ne_top _ htop.symm
  have hdim := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular rs hrs
  rw [hspan, ringKrullDim_eq_of_ringEquiv
    (RingHom.quotientKerEquivOfSurjective (j.stalkMap_surjective z)), List.length_ofFn] at hdim
  have hpt : i z = U.ι (j z) := by rw [← hij]; rfl
  rw [hrank, hpt, ringKrullDim_eq_of_ringEquiv
    (asIso (U.ι.stalkMap (j z))).commRingCatIsoToRingEquiv, ← hdim]

end Stacks.AlgebraicGeometry

end
