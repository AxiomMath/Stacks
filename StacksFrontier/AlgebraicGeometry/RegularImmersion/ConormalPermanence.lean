/-! ### Generators differing by an invertible matrix -/

/-- An invertible square matrix of ring elements does not change the ideal generated by a finite
family. -/
theorem span_range_mulVec_eq {R : Type*} [CommRing R] {r : ℕ}
    {a : Matrix (Fin r) (Fin r) R} (ha : IsUnit a) (g : Fin r → R) :
    Ideal.span (Set.range (a.mulVec g)) = Ideal.span (Set.range g) := by
  have hle : ∀ (b : Matrix (Fin r) (Fin r) R) (v : Fin r → R),
      Ideal.span (Set.range (b.mulVec v)) ≤ Ideal.span (Set.range v) := by
    intro b v
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    have hsum : b.mulVec v i = ∑ k, b i k * v k := rfl
    rw [hsum]
    exact Submodule.sum_mem _ fun k _ ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)
  refine le_antisymm (hle a g) ?_
  have hinv : (↑ha.unit⁻¹ : Matrix (Fin r) (Fin r) R).mulVec (a.mulVec g) = g := by
    rw [Matrix.mulVec_mulVec]
    have h1 : (↑ha.unit⁻¹ : Matrix (Fin r) (Fin r) R) * a = 1 := by
      simpa using ha.unit.inv_mul
    rw [h1, Matrix.one_mulVec]
  conv_lhs => rw [← hinv]
  exact hle _ (a.mulVec g)

/-- The entries of a family obtained from another by an invertible matrix. -/
theorem mulVec_apply_eq_sum {R : Type*} [CommRing R] {r : ℕ}
    (a : Matrix (Fin r) (Fin r) R) (g : Fin r → R) (i : Fin r) :
    a.mulVec g i = ∑ k, a i k * g k := rfl

/-! ### Extending a linearly independent family to a basis indexed by a sum -/

/-- A linearly independent finite family in a vector space with a finite basis extends to a basis
indexed by a sum whose left summand is the given family. -/
theorem exists_basis_sum_of_linearIndependent {k W : Type*} [Field k] [AddCommGroup W]
    [Module k W] {n N : ℕ} (bW : Module.Basis (Fin N) k W) {v : Fin n → W}
    (hv : LinearIndependent k v) :
    ∃ (m : ℕ) (b : Module.Basis (Fin n ⊕ Fin m) k W), ∀ a, b (Sum.inl a) = v a := by
  classical
  have _ : Module.Finite k W := Module.Finite.of_basis bW
  obtain ⟨T, hT⟩ := (Submodule.span k (Set.range v)).exists_isCompl
  let bS : Module.Basis (Fin n) k (Submodule.span k (Set.range v)) := Module.Basis.span hv
  let bT : Module.Basis (Fin (Module.finrank k T)) k T := Module.finBasis k T
  refine ⟨Module.finrank k T,
    (bS.prod bT).map (Submodule.prodEquivOfIsCompl _ T hT), fun a ↦ ?_⟩
  have h1 : ((bS.prod bT) (Sum.inl a)).1 = bS a := Module.Basis.prod_apply_inl_fst _ _ _
  have h2 : ((bS.prod bT) (Sum.inl a)).2 = 0 := Module.Basis.prod_apply_inl_snd _ _ _
  rw [Module.Basis.map_apply, Submodule.coe_prodEquivOfIsCompl', h1, h2]
  simp [bS]

/-! ### The cotangent fibre of an ideal -/

variable {R : Type*} [CommRing R] [IsLocalRing R]

/-- The map `I/𝔪I → J/𝔪J` of cotangent fibres induced by an inclusion `I ≤ J` of ideals of a
local ring. -/
def cotangentFibreMap {I J : Ideal R} (h : I ≤ J) :
    (I ⧸ (IsLocalRing.maximalIdeal R • (⊤ : Submodule R I))) →ₗ[R]
      (J ⧸ (IsLocalRing.maximalIdeal R • (⊤ : Submodule R J))) :=
  (IsLocalRing.maximalIdeal R • (⊤ : Submodule R I)).mapQ
    (IsLocalRing.maximalIdeal R • (⊤ : Submodule R J)) (Submodule.inclusion h)
    (Submodule.smul_top_le_comap_smul_top _ _)

/-- `cotangentFibreMap h` sends the class of `x ∈ I` to the class of `x` regarded as an element
of `J`. -/
@[simp]
theorem cotangentFibreMap_mk {I J : Ideal R} (h : I ≤ J) (x : I) :
    cotangentFibreMap h (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk ⟨(x : R), h x.2⟩ :=
  rfl

/-! ### Local Koszul-regular generators from a basis of the cotangent fibre -/

/-- **[Stacks Project, Tag 067N] part (3).** Let `J` be an ideal subsheaf of the structure sheaf
of a locally ringed space, generated on a neighbourhood of `x` by a sequence that is
Koszul-regular at every point.  Then any lift of a basis of the cotangent fibre `J_x/𝔪_x J_x` is
realised on a neighbourhood of `x` by sections that generate `J` and are Koszul-regular at every
point.

Koszul-regularity of a family on an open is taken germwise, which
`isKoszulSequenceExactOn_iff_forall_germ_isKoszulRegular` identifies with exactness of its sheaf
Koszul complex.

Two departures from the source.  The hypothesis is the local witness at `x` that Koszul-regularity
of `J` supplies there, rather than Koszul-regularity of `J` itself; that is weaker, so a caller
with the source's hypothesis can supply it.  And `J_x ≠ 𝒪_{X,x}` is assumed, which the source does
not assume: in the excluded case the cotangent fibre is the residue field, so `r = 1` and `f 0` is
a unit, and the source's conclusion holds there too. -/
@[stacks 067N "part (3), with the local witness at x in place of Koszul-regularity of J, and \
assuming J_x is not the whole local ring", sga "6 VII 1.4" "1.4.2"]
theorem exists_koszulRegular_sections_of_basis {X : LocallyRingedSpace.{u}}
    (J : (structureSheafModule X.toRingedSpace).Submodule) (x : X) {r : ℕ}
    (f : Fin r → stalkIdeal J x)
    (b : Module.Basis (Fin r)
      (X.presheaf.stalk x ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk x))
      (idealCotangentFiber J x))
    (hf : ∀ i, b i = Submodule.Quotient.mk (f i))
    (hsupp : stalkIdeal J x ≠ ⊤)
    (V : Opens X) (hxV : x ∈ V) {s : ℕ} (g : Fin s → X.presheaf.obj (op V))
    (hgen : IsGeneratedByOn X.toRingedSpace J V g)
    (hK : ∀ (y : X) (hy : y ∈ V), Koszul.IsKoszulRegular (germFamily X.toRingedSpace V g y hy)) :
    ∃ (U : Opens X) (hxU : x ∈ U) (fU : Fin r → X.presheaf.obj (op U)),
      (∀ i, X.presheaf.germ U x hxU (fU i) = (f i : X.presheaf.stalk x)) ∧
      IsGeneratedByOn X.toRingedSpace J U fU ∧
      ∀ (y : X) (hy : y ∈ U), Koszul.IsKoszulRegular (germFamily X.toRingedSpace U fU y hy) := by
  have hgen' : ∀ (y : X) (hy : y ∈ V), stalkIdeal J y =
      Jid (fun k ↦ X.presheaf.germ V y hy (g k)) :=
    fun y hy ↦ stalkIdeal_eq_jid_of_isGeneratedByOn J g hgen y hy
  have hqr : ∀ (y : X) (hy : y ∈ V), IsQuasiRegular (X.presheaf.stalk y)
      (List.ofFn fun k ↦ X.presheaf.germ V y hy (g k)) := fun y hy ↦
    Koszul.isQuasiRegular_of_isH1RegularOn
      ((Koszul.isH1RegularOn_self_iff _).2 (hK y hy).isH1Regular)
  obtain ⟨hrs, U, hxU, iUV, fU, a, haunit, hgerm, heq⟩ :=
    exists_invertible_change_of_local_generators J x f b hf hsupp V hxV g hgen' hqr
  subst hrs
  replace heq : ∀ i, (fU i).1 = ∑ k, a i k * X.presheaf.map iUV.op (g k) := by
    simpa using heq
  have hUV : U ≤ V := leOfHom iUV
  have hres : iUV = homOfLE hUV := Subsingleton.elim _ _
  have key : ∀ (y : X) (hy : y ∈ U),
      Jid (germFamily X.toRingedSpace U (fun i ↦ (fU i).1) y hy) =
        Jid (fun k ↦ X.presheaf.germ V y (hUV hy) (g k)) := by
    intro y hy
    have hunit : IsUnit (a.map (X.presheaf.germ U y hy).hom) := by
      simpa [RingHom.mapMatrix_apply] using
        haunit.map (RingHom.mapMatrix (X.presheaf.germ U y hy).hom)
    have hfam : germFamily X.toRingedSpace U (fun i ↦ (fU i).1) y hy =
        (a.map (X.presheaf.germ U y hy).hom).mulVec
          (fun k ↦ X.presheaf.germ V y (hUV hy) (g k)) := by
      funext i
      have h1 : germFamily X.toRingedSpace U (fun i ↦ (fU i).1) y hy i =
          X.presheaf.germ U y hy (fU i).1 := rfl
      have h2 : (a.map (X.presheaf.germ U y hy).hom).mulVec
            (fun k ↦ X.presheaf.germ V y (hUV hy) (g k)) i =
          ∑ k, X.presheaf.germ U y hy (a i k) * X.presheaf.germ V y (hUV hy) (g k) := rfl
      rw [h1, h2, heq i, map_sum]
      refine Finset.sum_congr rfl fun k _ ↦ ?_
      rw [map_mul, hres, X.presheaf.germ_res_apply]
    rw [hfam, Jid, Jid, span_range_mulVec_eq hunit]
  refine ⟨U, hxU, fun i ↦ (fU i).1, hgerm, ?_, fun y hy ↦ ?_⟩
  · exact isGeneratedByOn_of_forall_stalkIdeal_eq J _ fun y hy ↦ by
      rw [key y hy, hgen' y (hUV hy)]
  · exact (Koszul.regularity_of_generators_of_eq_span_range
      (Jid (fun k ↦ X.presheaf.germ V y (hUV hy) (g k)))
      (germFamily X.toRingedSpace U (fun i ↦ (fU i).1) y hy) (key y hy)).2.2
      ⟨_, rfl, hK y (hUV hy)⟩

/-! ### Linear independence of the image of a basis of the cotangent fibre -/

/-- The residue-field action on a cotangent fibre is the one induced by the ring. -/
theorem mk_smul_eq_smul {M : Type*} [AddCommGroup M] [Module R M] (lam : R)
    (z : M ⧸ (IsLocalRing.maximalIdeal R • (⊤ : Submodule R M))) :
    (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) lam) • z = lam • z := by
  rw [← Ideal.Quotient.algebraMap_eq]
  exact algebraMap_smul _ lam z

/-- If the map of cotangent fibres attached to an inclusion `I ≤ J` of ideals of a local ring is
injective, the image of a basis of `I/𝔪I` is linearly independent in `J/𝔪J`. -/
theorem linearIndependent_cotangentFibreMap {I J : Ideal R} (h : I ≤ J)
    (hinj : Function.Injective (cotangentFibreMap h)) {n : ℕ}
    (bI : Module.Basis (Fin n) (R ⧸ IsLocalRing.maximalIdeal R)
      (I ⧸ (IsLocalRing.maximalIdeal R • (⊤ : Submodule R I)))) :
    LinearIndependent (R ⧸ IsLocalRing.maximalIdeal R)
      fun i ↦ cotangentFibreMap h (bI i) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro c hc i
  choose lam hlam using fun k ↦ Ideal.Quotient.mk_surjective
    (I := IsLocalRing.maximalIdeal R) (c k)
  have hzero : cotangentFibreMap h (∑ k, c k • bI k) = 0 := by
    rw [map_sum]
    refine hc.symm ▸ Finset.sum_congr rfl fun k _ ↦ ?_
    rw [← hlam k, mk_smul_eq_smul, map_smul, ← mk_smul_eq_smul, hlam k]
  have hsum : ∑ k, c k • bI k = 0 := hinj (by rw [hzero, map_zero])
  exact Fintype.linearIndependent_iff.mp bI.linearIndependent c hsum i

/-- A linearly independent family in the cotangent fibre of an ideal of a local ring extends to
a basis indexed by a sum whose left summand is the given family. -/
theorem exists_basis_sum_cotangentFibre {J : Ideal R} {n N : ℕ}
    (bJ : Module.Basis (Fin N) (R ⧸ IsLocalRing.maximalIdeal R)
      (J ⧸ (IsLocalRing.maximalIdeal R • (⊤ : Submodule R J))))
    {v : Fin n → (J ⧸ (IsLocalRing.maximalIdeal R • (⊤ : Submodule R J)))}
    (hv : LinearIndependent (R ⧸ IsLocalRing.maximalIdeal R) v) :
    ∃ (m : ℕ) (b : Module.Basis (Fin n ⊕ Fin m) (R ⧸ IsLocalRing.maximalIdeal R)
      (J ⧸ (IsLocalRing.maximalIdeal R • (⊤ : Submodule R J)))), ∀ a, b (Sum.inl a) = v a := by
  let : Field (R ⧸ IsLocalRing.maximalIdeal R) := Ideal.Quotient.field _
  exact exists_basis_sum_of_linearIndependent bJ hv

/-! ### Monotonicity of the stalk of an ideal subsheaf -/

variable {X : LocallyRingedSpace.{u}}

/-! ### Adapted local generators -/

/-- Restricting a family of local generators with germwise Koszul-regularity to a smaller open. -/
private theorem isGeneratedByOn_and_koszulRegular_of_le {Y : RingedSpace.{u}}
    {J : (structureSheafModule Y).Submodule} {U : Opens Y} {r : ℕ}
    (f : Fin r → Y.presheaf.obj (op U))
    (hgen : IsGeneratedByOn Y J U f)
    (hK : ∀ (y : Y) (hy : y ∈ U), Koszul.IsKoszulRegular (germFamily Y U f y hy))
    (U' : Opens Y) (h : U' ≤ U) :
    IsGeneratedByOn Y J U' (fun i ↦ Y.presheaf.map (homOfLE h).op (f i)) ∧
      ∀ (y : Y) (hy : y ∈ U'),
        Koszul.IsKoszulRegular
          (germFamily Y U' (fun i ↦ Y.presheaf.map (homOfLE h).op (f i)) y hy) :=
  ⟨isGeneratedByOn_of_le U f hgen U' h, fun y hy ↦ by
    rw [germFamily_res U U' h f y hy]; exact hK y (h hy)⟩

/-- Applying a function to each entry commutes with `Fin.append`. -/
private theorem comp_fin_append {α β : Type*} (φ : α → β) {m n : ℕ} (f : Fin m → α)
    (g : Fin n → α) : φ ∘ Fin.append f g = Fin.append (φ ∘ f) (φ ∘ g) := by
  funext k
  refine Fin.addCases (fun a ↦ ?_) (fun b ↦ ?_) k <;> simp [Fin.append_left, Fin.append_right]

/-- **The local step of [Stacks Project, Tag 068Z].** Let `I ≤ J` be ideal subsheaves of the
structure sheaf of a locally ringed space, each generated near `x` by a sequence which is
Koszul-regular at every point, and suppose the map of cotangent fibres
`I_x/𝔪_x I_x → J_x/𝔪_x J_x` is injective.  Then on a neighbourhood of `x` there are sections `f`
generating `I` and sections `g` such that `f` followed by `g` generates `J`, both families being
Koszul-regular at every point. -/
theorem exists_adapted_koszulRegular_sections
    {I J : (structureSheafModule X.toRingedSpace).Submodule} (hIJ : I ≤ J)
    (x : X) (hI : stalkIdeal I x ≠ ⊤) (hJ : stalkIdeal J x ≠ ⊤)
    (hinj : Function.Injective (cotangentFibreMap (stalkIdeal_mono hIJ x)))
    {VI : Opens X} (hxVI : x ∈ VI) {nI : ℕ} (gI : Fin nI → X.presheaf.obj (op VI))
    (hgenI : IsGeneratedByOn X.toRingedSpace I VI gI)
    (hKI : ∀ (y : X) (hy : y ∈ VI),
      Koszul.IsKoszulRegular (germFamily X.toRingedSpace VI gI y hy))
    {VJ : Opens X} (hxVJ : x ∈ VJ) {nJ : ℕ} (gJ : Fin nJ → X.presheaf.obj (op VJ))
    (hgenJ : IsGeneratedByOn X.toRingedSpace J VJ gJ)
    (hKJ : ∀ (y : X) (hy : y ∈ VJ),
      Koszul.IsKoszulRegular (germFamily X.toRingedSpace VJ gJ y hy)) :
    ∃ (U : Opens X) (_ : x ∈ U) (m : ℕ) (f : Fin nI → X.presheaf.obj (op U))
      (g : Fin m → X.presheaf.obj (op U)),
      IsGeneratedByOn X.toRingedSpace I U f ∧
      (∀ (y : X) (hy : y ∈ U),
        Koszul.IsKoszulRegular (germFamily X.toRingedSpace U f y hy)) ∧
      IsGeneratedByOn X.toRingedSpace J U (Fin.append f g) ∧
      (∀ (y : X) (hy : y ∈ U),
        Koszul.IsKoszulRegular (germFamily X.toRingedSpace U (Fin.append f g) y hy)) := by
  classical
  have _ : Field (X.presheaf.stalk x ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk x)) :=
    Ideal.Quotient.field _
  have hgenI' := stalkIdeal_eq_jid_of_isGeneratedByOn I gI hgenI x hxVI
  have hgenJ' := stalkIdeal_eq_jid_of_isGeneratedByOn J gJ hgenJ x hxVJ
  obtain ⟨bI, hbI⟩ := exists_basis_idealCotangentFiber I hI
    (germFamily X.toRingedSpace VI gI x hxVI) hgenI'
    (Koszul.isQuasiRegular_of_isH1RegularOn
      ((Koszul.isH1RegularOn_self_iff _).2 (hKI x hxVI).isH1Regular))
  obtain ⟨bJ0, -⟩ := exists_basis_idealCotangentFiber J hJ
    (germFamily X.toRingedSpace VJ gJ x hxVJ) hgenJ'
    (Koszul.isQuasiRegular_of_isH1RegularOn
      ((Koszul.isH1RegularOn_self_iff _).2 (hKJ x hxVJ).isH1Regular))
  have hle := stalkIdeal_mono hIJ x
  obtain ⟨m, bJ, hbJl⟩ := exists_basis_sum_cotangentFibre bJ0
    (linearIndependent_cotangentFibreMap hle hinj bI)
  set fI : Fin nI → stalkIdeal I x := fun a ↦
    ⟨germFamily X.toRingedSpace VI gI x hxVI a, by
      rw [hgenI']; exact Ideal.subset_span ⟨a, rfl⟩⟩ with hfIdef
  have hbI' : ∀ a, bI a = Submodule.Quotient.mk (fI a) := hbI
  choose w hw using fun b : Fin m ↦ Submodule.Quotient.mk_surjective
    (IsLocalRing.maximalIdeal (X.presheaf.stalk x) •
      (⊤ : Submodule (X.presheaf.stalk x) (stalkIdeal J x))) (bJ (Sum.inr b))
  set fJ : Fin (nI + m) → stalkIdeal J x :=
    Fin.append (fun a ↦ ⟨(fI a : X.presheaf.stalk x), hle (fI a).2⟩) w with hfJdef
  set bJ' := bJ.reindex finSumFinEquiv with hbJ'def
  have hfJ : ∀ k, bJ' k = Submodule.Quotient.mk (fJ k) := by
    intro k
    refine Fin.addCases (fun a ↦ ?_) (fun b ↦ ?_) k
    · have h1 : bJ' (Fin.castAdd m a) = bJ (Sum.inl a) := by
        rw [hbJ'def, Module.Basis.reindex_apply, finSumFinEquiv_symm_apply_castAdd]
      rw [h1, hbJl a, hbI' a, cotangentFibreMap_mk, hfJdef, Fin.append_left]
    · have h1 : bJ' (Fin.natAdd nI b) = bJ (Sum.inr b) := by
        rw [hbJ'def, Module.Basis.reindex_apply, finSumFinEquiv_symm_apply_natAdd]
      rw [h1, hfJdef, Fin.append_right, hw b]
  obtain ⟨U₁, hxU₁, F, hgermF, hgenF, hKF⟩ :=
    exists_koszulRegular_sections_of_basis I x fI bI hbI' hI VI hxVI gI hgenI hKI
  obtain ⟨U₂, hxU₂, S, hgermS, hgenS, hKS⟩ :=
    exists_koszulRegular_sections_of_basis J x fJ bJ' hfJ hJ VJ hxVJ gJ hgenJ hKJ
  have hxU : x ∈ U₁ ⊓ U₂ := ⟨hxU₁, hxU₂⟩
  have hd : ∀ a ∈ (Finset.univ : Finset (Fin nI)),
      X.presheaf.germ (U₁ ⊓ U₂) x hxU
        (X.presheaf.map (homOfLE (inf_le_right : U₁ ⊓ U₂ ≤ U₂)).op (S (Fin.castAdd m a)) -
          X.presheaf.map (homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op (F a)) = 0 := by
    intro a _
    rw [map_sub, TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE inf_le_right) x hxU,
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE inf_le_left) x hxU,
      hgermS, hgermF, hfJdef, Fin.append_left, sub_eq_zero]
  obtain ⟨W, hxW, hWU, hW⟩ :=
    exists_nhds_forall_restrict_eq_zero (X := X.toRingedSpace) x hxU Finset.univ _ hd
  have hWU₁ : W ≤ U₁ := hWU.trans inf_le_left
  have hWU₂ : W ≤ U₂ := hWU.trans inf_le_right
  set f : Fin nI → X.presheaf.obj (op W) :=
    fun a ↦ X.presheaf.map (homOfLE hWU₁).op (F a) with hfdef
  set g : Fin m → X.presheaf.obj (op W) :=
    fun b ↦ X.presheaf.map (homOfLE hWU₂).op (S (Fin.natAdd nI b)) with hgdef
  have happ : Fin.append f g = fun k ↦ X.presheaf.map (homOfLE hWU₂).op (S k) := by
    funext k
    refine Fin.addCases (fun a ↦ ?_) (fun b ↦ ?_) k
    · have h0 := hW a (Finset.mem_univ a)
      rw [map_sub, sub_eq_zero, Stacks.AlgebraicGeometry.QuasiRegular.res_res,
        Stacks.AlgebraicGeometry.QuasiRegular.res_res] at h0
      rw [Fin.append_left]
      exact h0.symm
    · rw [Fin.append_right]
  have hF := isGeneratedByOn_and_koszulRegular_of_le F hgenF hKF W hWU₁
  have hS := isGeneratedByOn_and_koszulRegular_of_le S hgenS hKS W hWU₂
  rw [← happ] at hS
  exact ⟨W, hxW, m, f, g, hF.1, hF.2, hS.1, hS.2⟩

/-! ### Descending Koszul-regularity along a closed immersion -/

section Schemes

variable {Z Y X : Scheme.{u}}

/-- The map of cotangent fibres from the defining ideal of `j` to the defining ideal of `i ≫ j`
at the image in `X` of a point of `Z`. -/
def conormalFibreMap (i : Z ⟶ Y) (j : Y ⟶ X) (z : Z) :=
  cotangentFibreMap
    (stalkIdeal_mono (W := X.toLocallyRingedSpace) (definingIdealOfHom_le_comp i j) (j.base (i z)))

/-- **[Stacks Project, Tag 068Z] part (3) for closed immersions, from injectivity on cotangent
fibres.** Let `Z --i--→ Y --j--→ X` be closed immersions with Koszul-regular defining ideal
sheaves for `j` and for `i ≫ j`.  If at every point of `Z` the induced map of cotangent fibres
`I_x/𝔪_x I_x → J_x/𝔪_x J_x` of the two defining ideals is injective, then the defining ideal
sheaf of `i` is Koszul-regular.

Over an affine open `U` of `X` around the image of the point, local generators `f` of the ideal
of `Y` extend to local generators `f, g` of the ideal of `Z`, both Koszul-regular, and the
images of the `g` under `j` on sections generate the ideal of `Z` in `Y` and are Koszul-regular
by [Stacks Project, Tag 068M]. -/
@[stacks 068Z "part (3) for closed immersions: Koszul-regularity of `j` and of `i ≫ j` together \
with injectivity of the cotangent-fibre map `I_x/𝔪_x I_x ⟶ J_x/𝔪_x J_x` gives Koszul-regularity \
of `i`. That injectivity is a hypothesis here, not derived from exactness and local splitness of \
the conormal sequence"]
theorem isKoszulRegularIdealSheaf_of_comp (i : Z ⟶ Y) (j : Y ⟶ X)
    [IsClosedImmersion i] [IsClosedImmersion j]
    (hinj : ∀ z : Z, Function.Injective (conormalFibreMap i j z))
    (hj : IsKoszulRegularIdealSheaf X.toRingedSpace (definingIdealOfHom j))
    (hij : IsKoszulRegularIdealSheaf X.toRingedSpace (definingIdealOfHom (i ≫ j))) :
    IsKoszulRegularIdealSheaf Y.toRingedSpace (definingIdealOfHom i) := by
  classical
  rw [isKoszulRegularIdealSheaf_iff_kerGeneratedBy i]
  intro y hy
  rw [(IsClosedImmersion.isClosedEmbedding i).isClosed_range.closure_eq] at hy
  obtain ⟨z, rfl⟩ := hy
  have hxij : (i ≫ j) z = j (i z) := Scheme.Hom.comp_apply i j z
  obtain ⟨VI, hxVI, nI, gI, hKI0, hgenI⟩ := hj (j (i z))
    ((mem_idealQuotientSupport_definingIdealOfHom_iff j (j (i z))).mpr
      (subset_closure ⟨i z, rfl⟩))
  obtain ⟨VJ, hxVJ, nJ, gJ, hKJ0, hgenJ⟩ := hij (j (i z))
    ((mem_idealQuotientSupport_definingIdealOfHom_iff (i ≫ j) (j (i z))).mpr
      (subset_closure ⟨z, hxij⟩))
  have hIne : stalkIdeal (X := X.toLocallyRingedSpace) (definingIdealOfHom j) (j (i z)) ≠ ⊤ :=
    stalkIdeal_definingIdealOfHom_ne_top j (i z)
  have hJne :
      stalkIdeal (X := X.toLocallyRingedSpace) (definingIdealOfHom (i ≫ j)) (j (i z)) ≠ ⊤ := by
    have h := stalkIdeal_definingIdealOfHom_ne_top (i ≫ j) z
    rwa [hxij] at h
  obtain ⟨W, hxW, m, f, g, hgenf, hKf, hgenfg, hKfg⟩ :=
    exists_adapted_koszulRegular_sections (X := X.toLocallyRingedSpace)
      (definingIdealOfHom_le_comp i j) (j (i z)) hIne hJne (hinj z) hxVI gI hgenI
      ((isKoszulSequenceExactOn_iff_forall_germ_isKoszulRegular _ VI gI).mp hKI0) hxVJ gJ hgenJ
      ((isKoszulSequenceExactOn_iff_forall_germ_isKoszulRegular _ VJ gJ).mp hKJ0)
  obtain ⟨U, hUaff, hxU, hUW⟩ := exists_isAffineOpen_mem_and_subset hxW
  have hUle : U ≤ W := hUW
  set fU : Fin nI → Γ(X, U) := fun a ↦ X.presheaf.map (homOfLE hUle).op (f a) with hfUdef
  set gU : Fin m → Γ(X, U) := fun b ↦ X.presheaf.map (homOfLE hUle).op (g b) with hgUdef
  have happU :
      (fun k ↦ X.presheaf.map (homOfLE hUle).op (Fin.append f g k)) = Fin.append fU gU :=
    comp_fin_append (fun s ↦ X.presheaf.map (homOfLE hUle).op s) f g
  have hfU := isGeneratedByOn_and_koszulRegular_of_le f hgenf hKf U hUle
  have hfgU := isGeneratedByOn_and_koszulRegular_of_le (Fin.append f g) hgenfg hKfg U hUle
  rw [happU] at hfgU
  have hgenfU : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom j) U fU := hfU.1
  have hgenfgU :
      IsGeneratedByOn X.toRingedSpace (definingIdealOfHom (i ≫ j)) U (Fin.append fU gU) := hfgU.1
  have hkerf : RingHom.ker (j.app U).hom = Ideal.span (Set.range fU) :=
    ker_app_eq_span_range j hUaff fU hgenfU
  have hkerfg :
      RingHom.ker ((i ≫ j).app U).hom = Ideal.span (Set.range (Fin.append fU gU)) :=
    ker_app_eq_span_range (i ≫ j) hUaff _ hgenfgU
  have hKfU : Koszul.IsKoszulRegular fU :=
    (forall_isKoszulRegular_germFamily_iff X hUaff fU).mp hfU.2
  have hKfgU : Koszul.IsKoszulRegular (Fin.append fU gU) :=
    (forall_isKoszulRegular_germFamily_iff X hUaff _).mp hfgU.2
  -- Stacks 068M in the quotient by the ideal of `Y`
  have hquot := Koszul.koszulRegular_quotient_of_koszulRegular_append fU gU hKfU hKfgU
  rw [← hkerf] at hquot
  have hsurj : Function.Surjective (j.app U).hom := j.app_surjective U hUaff
  have hKgY : Koszul.IsKoszulRegular fun b ↦ (j.app U).hom (gU b) := by
    have h := AlgebraicGeometry.isKoszulRegular_of_ringHomFlat
      (quotientDefiningIdealEquiv j hUaff).toRingHom
      (RingHom.Flat.of_bijective (quotientDefiningIdealEquiv j hUaff).bijective) _ hquot
    have heq : (fun b ↦ (quotientDefiningIdealEquiv j hUaff).toRingHom
          (Ideal.Quotient.mk (RingHom.ker (j.app U).hom) (gU b)))
        = fun b ↦ (j.app U).hom (gU b) := by
      funext b
      simp only [quotientDefiningIdealEquiv, RingEquiv.toRingHom_eq_coe,
        RingEquiv.coe_toRingHom, RingHom.quotientKerEquivOfSurjective_apply_mk]
    rwa [heq] at h
  -- the kernel of `i` on sections over the preimage of `U`
  have hkeri : RingHom.ker (i.app (j ⁻¹ᵁ U)).hom =
      Ideal.span (Set.range fun b ↦ (j.app U).hom (gU b)) := by
    have hcomp : ∀ a : Γ(X, U),
        ((i ≫ j).app U).hom a = (i.app (j ⁻¹ᵁ U)).hom ((j.app U).hom a) := fun _ ↦ rfl
    have hmap : RingHom.ker (i.app (j ⁻¹ᵁ U)).hom =
        Ideal.map (j.app U).hom (RingHom.ker ((i ≫ j).app U).hom) := by
      refine le_antisymm (fun b hb ↦ ?_) ?_
      · obtain ⟨a, rfl⟩ := hsurj b
        refine Ideal.mem_map_of_mem _ ?_
        rw [RingHom.mem_ker, hcomp]
        exact hb
      · rw [Ideal.map_le_iff_le_comap]
        intro a ha
        rw [RingHom.mem_ker, hcomp] at ha
        exact ha
    have hzero : (j.app U).hom ∘ fU = 0 := funext fun a ↦ by
      rw [Function.comp_apply, Pi.zero_apply, ← RingHom.mem_ker, hkerf]
      exact Ideal.subset_span ⟨a, rfl⟩
    rw [hmap, hkerfg, Ideal.map_span, ← Set.range_comp, comp_fin_append, hzero]
    refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
    · rintro _ ⟨k, rfl⟩
      refine Fin.addCases (fun a ↦ ?_) (fun b ↦ ?_) k
      · rw [Fin.append_left]
        exact Submodule.zero_mem _
      · rw [Fin.append_right]
        exact Ideal.subset_span ⟨b, rfl⟩
    · rintro _ ⟨b, rfl⟩
      exact Ideal.subset_span ⟨Fin.natAdd nI b, Fin.append_right _ _ b⟩
  exact ⟨⟨j ⁻¹ᵁ U, hUaff.preimage j⟩, hxU, m, (fun b ↦ (j.app U).hom (gU b)), hkeri, hKgY⟩

end Schemes

end Stacks.AlgebraicGeometry.RegularIdealSheaf

