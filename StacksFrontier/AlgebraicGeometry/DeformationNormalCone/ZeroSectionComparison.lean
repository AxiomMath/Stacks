module

public import StacksFrontier.AlgebraicGeometry.DeformationNormalCone.BaseIdeal
public import StacksFrontier.AlgebraicGeometry.Divisors.NormalCone.NormalConeZeroSectionAffineCriterion
public import StacksFrontier.AlgebraicGeometry.Divisors.NormalCone.NormalConeNestedZeroSection
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionFullyFaithful.SectionsComplete
public import StacksFrontier.AlgebraicGeometry.Blowup.ClassifyingMorphism

/-!
# The zero section of `C_YX` inside the deformation space

Let `Y ⊆ X` be an effective Cartier divisor with ideal `ℐ`, `D = D(ℐ)` its deformation space,
`κ : C_YX ⟶ D` the normal cone in the fibre `t⁻¹ = 0`, and `E ⊆ D` the strict part of the
inverse image of `Y` (`Stacks.Deformation.strictDivisor`), generated on a chart by `g t`. Then
`κ⁻¹E` is the image `o(Y)` of the zero section of the line bundle `C_YX`:

  `(Stacks.Deformation.strictDivisor ℐ).comap κ = o.ker`.

Indeed on a chart `κ⁻¹E` is generated by the class of `g` in degree one, which generates the
degree-one part of `𝒞_{Y/X,*}`; a morphism into `C_YX` factors through `o` exactly when it kills
the degree-one functions (`Stacks.Conormal.eq_comp_normalConeZeroSection_iff`).
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.AffineAlgebraEquivalence Stacks.RelativeSpec Stacks.Blowup Stacks.Conormal

universe u

namespace Stacks.Deformation

variable {X : Scheme.{u}} (DY : X.IdealSheafData)
  [hDY : Stacks.Divisors.IsEffectiveCartierDivisor DY]

/-- The ideal of the closed factorization of `Y ⟶ X` is an effective Cartier divisor. -/
theorem isEffectiveCartierDivisor_coborderIdeal :
    Stacks.Divisors.IsEffectiveCartierDivisor (coborderIdeal DY.subschemeι) := by
  have h := Stacks.Algebraization.ker_liftCoborder_eq_comap DY.subschemeι
  rw [Scheme.IdealSheafData.ker_subschemeι] at h
  change Stacks.Divisors.IsEffectiveCartierDivisor DY.subschemeι.liftCoborder.ker
  rw [h]
  exact Stacks.Blowup.isEffectiveCartierDivisor_comap_of_isOpenImmersion DY hDY _

/-- The strict part `E` of the inverse image of `Y` on its deformation space. -/
abbrev divisorStrict : (deformationSpace (coborderIdeal DY.subschemeι)).IdealSheafData :=
  strictDivisor (coborderIdeal DY.subschemeι) (isEffectiveCartierDivisor_coborderIdeal DY)

/-! ### Degree-one functions on the normal cone and the zero section -/

/-- **A morphism into `C_YX` kills a degree-one function exactly when the corresponding datum of
the affine criterion vanishes.** -/
theorem pullback_vectorBundlePair_eq_zero_iff {T : Scheme.{u}}
    (m : T ⟶ normalCone DY.subschemeι) (U : DY.subscheme.Opens)
    (x : (conormalSheafDegreeOne DY.subschemeι).val.obj (op U)) :
    ((RelativeSpecPair.pullback (m ≫ normalConeToNormalBundle DY.subschemeι)
        (conormalSituation DY).vectorBundlePair).2.right.app (op U)).hom
        ((conormalSituation DY).algebraSheafIncl 1 U
          ((conormalSituation DY).symmetricAlgebraGen.val.app (op U) x)) = 0 ↔
      (m.app (normalConeToBase DY.subschemeι ⁻¹ᵁ U)).hom
        (coneIncl DY.subschemeι 1 U x) = 0 := by
  have hval :
      (((conormalSymmetricAlgebraSheafHom DY.subschemeι).right.hom.app (op U)).hom
          ((((conormalSituation DY).algebraSheafIsoSymmetricAlgebraSheaf.hom.right.hom).app
              (op U)).hom
            ((conormalSituation DY).algebraSheafIncl 1 U
              ((conormalSituation DY).symmetricAlgebraGen.val.app (op U) x)))) =
        (conormalAlgebra DY.subschemeι).algebra.ungradedIncl 1 x :=
    ((congrArg (((conormalSymmetricAlgebraSheafHom DY.subschemeι).right.hom.app (op U)).hom)
        (Stacks.RelativeSpec.ungradedToGradedRight_ungradedAlgebraSheafIncl DY.subscheme
          (conormalSituation DY).symmetricAlgebra
          (conormalSituation DY).symmetricAlgebra_mul_comm 1 U
          ((conormalSituation DY).symmetricAlgebraGen.val.app (op U) x))).trans
      (conormalSymmetricAlgebraSheafHom_ungradedIncl DY.subschemeι 1 U
        ((conormalSituation DY).symmetricAlgebraGen.val.app (op U) x))).trans
      (congrArg ((conormalAlgebra DY.subschemeι).algebra.ungradedIncl 1)
        (conormalSymmetricHom_app_one_symmetricAlgebraGen DY.subschemeι U x))
  rw [normalConeToNormalBundle_eq_pairToHom]
  refine (pullback_comp_pairToHom_algebraHomPair_app_eq_zero_iff ..).trans ?_
  change ((RelativeSpecPair.pullback m (universalRelativeSpecPair
      (normalConeSituation DY.subschemeι))).2.right.app (op U)).hom
      (((conormalSymmetricAlgebraSheafHom DY.subschemeι).right.hom.app (op U)).hom
        ((((conormalSituation DY).algebraSheafIsoSymmetricAlgebraSheaf.hom.right.hom).app
          (op U)).hom ((conormalSituation DY).algebraSheafIncl 1 U
            ((conormalSituation DY).symmetricAlgebraGen.val.app (op U) x)))) = 0 ↔ _
  rw [hval, coneIncl_eq]
  rfl

/-- **The affine criterion for factoring through the zero section, on a basis of opens.** -/
theorem eq_comp_normalConeZeroSection_of_basis {T : Scheme.{u}}
    (m : T ⟶ normalCone DY.subschemeι) (g : T ⟶ DY.subscheme)
    (hbase : m ≫ normalConeToBase DY.subschemeι = g) {ι : Type*} (B : ι → DY.subscheme.Opens)
    (hB : Opens.IsBasis (Set.range B))
    (h : ∀ a (x : (conormalSheafDegreeOne DY.subschemeι).val.obj (op (B a))),
      (m.app (normalConeToBase DY.subschemeι ⁻¹ᵁ B a)).hom (coneIncl DY.subschemeι 1 (B a) x) = 0) :
    m = g ≫ normalConeZeroSection DY := by
  refine (eq_comp_normalConeZeroSection_iff DY m g hbase).mpr ?_
  have hassoc : m ≫ (totalSpaceIsoNormalCone DY).inv =
      (m ≫ normalConeToNormalBundle DY.subschemeι) ≫
        (conormalSituation DY).vectorBundleToTotalSpace :=
    (congrArg (m ≫ ·) (totalSpaceIsoNormalCone_inv_eq DY)).trans (Category.assoc _ _ _).symm
  set k := m ≫ normalConeToNormalBundle DY.subschemeι
  refine (iff_of_eq (congrArg (fun z => (((conormalSituation DY).totalSpaceHomEquiv T z).2 = 0))
    (hassoc.trans ((congrArg (k ≫ ·)
      (conormalSituation DY).vectorBundleToTotalSpace_eq_pairToHom).trans
      (comp_pairToHom k (conormalSituation DY).vectorBundlePair))))).mpr ?_
  refine ((conormalSituation DY).totalSpaceHomEquiv_snd_eq_zero_iff _).mpr ?_
  set q := RelativeSpecPair.pullback k (conormalSituation DY).vectorBundlePair
  have key (ψ : (conormalSituation DY).L ⟶ (Scheme.Modules.pushforward q.1).obj
        (SheafOfModules.unit T.ringCatSheaf))
      (hψ : ∀ a, ((conormalSituation DY).algebraPairEquiv q.1 q.2).val.app (op (B a)) =
        ψ.val.app (op (B a))) :
      (conormalSituation DY).algebraPairEquiv q.1 q.2 = ψ :=
    Stacks.BasisRestriction.moduleSheafHom_ext_onBasis (conormalSituation DY).L _ B hB _ ψ hψ
  refine key _ fun a => ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
  refine ((conormalSituation DY).algebraPairEquiv_val_app q.1 q.2 (B a) x).trans ?_
  exact ((pullback_vectorBundlePair_eq_zero_iff DY m (B a) x).mpr (h a x)).trans rfl

/-- **The zero section kills the degree-one functions.** -/
theorem normalConeZeroSection_app_coneIncl (U : DY.subscheme.affineOpens)
    (x : (conormalSheafDegreeOne DY.subschemeι).val.obj (op U.1)) :
    ((normalConeZeroSection DY).app (normalConeToBase DY.subschemeι ⁻¹ᵁ U.1)).hom
      (coneIncl DY.subschemeι 1 U.1 x) = 0 := by
  have h := (eq_comp_normalConeZeroSection_iff_affineOpens DY (normalConeZeroSection DY) (𝟙 _)
    (normalConeZeroSection_comp_normalConeToBase DY)).mp (Category.id_comp _).symm U x
  exact (pullback_vectorBundlePair_eq_zero_iff DY _ U.1 x).mp h

/-! ### The comparison -/

/-- **The charts of `ℐ` give a basis of opens of `Y`.** -/
theorem isBasis_chart_preimage :
    Opens.IsBasis (Set.range fun c : Chart (coborderIdeal DY.subschemeι) =>
      DY.subschemeι.liftCoborder ⁻¹ᵁ c.W.1) := by
  refine Opens.isBasis_iff_nbhd.2 fun {O y} hy => ?_
  obtain ⟨O', hO'⟩ := exists_opens_preimage_eq DY.subschemeι.liftCoborder O
  have hy' : DY.subschemeι.liftCoborder y ∈ O' :=
    show y ∈ DY.subschemeι.liftCoborder ⁻¹ᵁ O' from hO' ▸ hy
  obtain ⟨U, hU, hxU, g, hg, hspan⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor _
      (isEffectiveCartierDivisor_coborderIdeal DY) (DY.subschemeι.liftCoborder y)
  obtain ⟨f, hfO, hyf⟩ := hU.exists_basicOpen_le ⟨_, hy'⟩ hxU
  have hle : (DY.subschemeι.coborderRange.toScheme).basicOpen f ≤ U :=
    (DY.subschemeι.coborderRange.toScheme).basicOpen_le f
  let c : Chart (coborderIdeal DY.subschemeι) :=
    ⟨⟨_, hU.basicOpen f⟩,
      ((DY.subschemeι.coborderRange.toScheme).presheaf.map (homOfLE hle).op).hom g,
      AlgebraicGeometry.isRegular_res_of_isAffineOpen hU hg hle, by
        rw [← Scheme.IdealSheafData.map_ideal (U := ⟨_, hU.basicOpen f⟩) (V := ⟨U, hU⟩) _ hle,
          hspan, Ideal.map_span, Set.image_singleton]; rfl⟩
  refine ⟨_, ⟨c, rfl⟩, hyf, ?_⟩
  rw [← hO']
  exact Scheme.Hom.preimage_mono _ hfO

/-- On a chart, every homogeneous section of degree one is a multiple of `g t`. -/
theorem chartIncl_mem_strictDivisor (c : Chart (coborderIdeal DY.subschemeι))
    (y : ((extReesGradedAlgebra (coborderIdeal DY.subschemeι)).piece 1).val.obj (op c.W.1)) :
    chartIncl (coborderIdeal DY.subschemeι) 1 c.W.1 y ∈ (divisorStrict DY).ideal c.toAffine := by
  rw [strictDivisor_ideal]
  have hmem := reesPieceAmbient_mem_affine (coborderIdeal DY.subschemeι) (1 : ℤ) zero_le_one c.W y
  rw [show Int.toNat 1 = 1 from rfl, pow_one, c.span] at hmem
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.1 hmem
  have : chartIncl (coborderIdeal DY.subschemeι) 1 c.W.1 y =
      chartIncl (coborderIdeal DY.subschemeι) 0 c.W.1
        (extReesOfMem (coborderIdeal DY.subschemeι) c.W 0 r (by simp)) * c.strictGen := by
    refine Eq.trans ?_ (chartIncl_mul _ c.W.1 0 ((1 : ℕ) : ℤ) _ _).symm
    refine chartIncl_congr _ (by norm_num) c.W.1 _ _ ?_
    refine Eq.trans ?_ (extReesAmbient_extReesMul _ 0 ((1 : ℕ) : ℤ) c.W.1 _ _).symm
    refine hr.symm.trans ?_
    exact congrArg₂ (· * ·) (extReesAmbient_extReesOfMem _ c.W 0 r _).symm
      (extReesAmbient_extReesOfMem _ c.W 1 c.g _).symm
  rw [this]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

omit hDY in
/-- `κ` sends `x t` to the degree-one function of `x`. -/
theorem normalConeToDeformation_appLE_chartIncl_one (c : Chart (coborderIdeal DY.subschemeι))
    (y : ((extReesGradedAlgebra (coborderIdeal DY.subschemeι)).piece 1).val.obj (op c.W.1))
    (hle) :
    ((normalConeToDeformation DY.subschemeι).appLE _
        ((normalConeToBase DY.subschemeι ≫ DY.subschemeι.liftCoborder) ⁻¹ᵁ c.W.1) hle).hom
        (chartIncl (coborderIdeal DY.subschemeι) 1 c.W.1 y) =
      coneIncl DY.subschemeι 1 (DY.subschemeι.liftCoborder ⁻¹ᵁ c.W.1)
        (Scheme.Modules.pullbackSection DY.subschemeι.liftCoborder
          (reesPiece (coborderIdeal DY.subschemeι) ((1 : ℕ) : ℤ)) c.W.1
          (DY.subschemeι.liftCoborder ⁻¹ᵁ c.W.1) le_rfl y) := by
  refine (normalConeToDeformation_appLE_chartIncl DY.subschemeι c.W 1 y hle).trans ?_
  rw [toConormalExtAdd_of_nonneg _ zero_le_one]
  rfl

/-- The affine open `π⁻¹ g⁻¹ W` of the normal cone over a chart. -/
abbrev Chart.coneAffine (c : Chart (coborderIdeal DY.subschemeι)) :
    (normalCone DY.subschemeι).affineOpens :=
  ⟨(normalConeToBase DY.subschemeι ≫ DY.subschemeι.liftCoborder) ⁻¹ᵁ c.W.1,
    Stacks.RelativeSpec.isAffineOpen_toBase_preimage (normalConeSituation DY.subschemeι)
      ⟨DY.subschemeι.liftCoborder ⁻¹ᵁ c.W.1, c.W.2.preimage _⟩⟩

omit hDY in
/-- The affine open `c.coneAffine` lies in the preimage under `κ` of the chart `c.toAffine`. -/
theorem coneAffine_le (c : Chart (coborderIdeal DY.subschemeι)) :
    (c.coneAffine DY).1 ≤ normalConeToDeformation DY.subschemeι ⁻¹ᵁ c.toAffine.1 := by
  rw [← Scheme.Hom.comp_preimage (normalConeToDeformation DY.subschemeι),
    normalConeToDeformation_toBase]

/-- **`κ⁻¹E` is the image of the zero section.** -/
theorem comap_divisorStrict_eq_ker :
    (divisorStrict DY).comap (normalConeToDeformation DY.subschemeι) =
      (normalConeZeroSection DY).ker := by
  set A := (divisorStrict DY).comap (normalConeToDeformation DY.subschemeι)
  have hmemA : ∀ (c : Chart (coborderIdeal DY.subschemeι))
      (y : ((extReesGradedAlgebra (coborderIdeal DY.subschemeι)).piece 1).val.obj (op c.W.1)),
      coneIncl DY.subschemeι 1 (DY.subschemeι.liftCoborder ⁻¹ᵁ c.W.1)
        (Scheme.Modules.pullbackSection DY.subschemeι.liftCoborder
          (reesPiece (coborderIdeal DY.subschemeι) ((1 : ℕ) : ℤ)) c.W.1
          (DY.subschemeι.liftCoborder ⁻¹ᵁ c.W.1) le_rfl y) ∈ A.ideal (c.coneAffine DY) := by
    intro c y
    rw [Stacks.IdealSheaf.ideal_comap_appLE _ _ c.toAffine (c.coneAffine DY) (coneAffine_le DY c),
      ← normalConeToDeformation_appLE_chartIncl_one DY c y (coneAffine_le DY c)]
    exact Ideal.mem_map_of_mem _ (chartIncl_mem_strictDivisor DY c y)
  apply le_antisymm
  · -- `A` lies in the ideal of `o(Y)`
    rw [← Scheme.IdealSheafData.map_bot, Scheme.IdealSheafData.le_map_iff_comap_le]
    have hcover : ⨆ c : Chart (coborderIdeal DY.subschemeι),
        (DY.subschemeι.liftCoborder ⁻¹ᵁ c.W.1) = ⊤ := by
      refine eq_top_iff.2 fun y _ => ?_
      obtain ⟨_, ⟨c, rfl⟩, hy, -⟩ := Opens.isBasis_iff_nbhd.1 (isBasis_chart_preimage DY)
        (show y ∈ (⊤ : DY.subscheme.Opens) from trivial)
      exact Opens.mem_iSup.2 ⟨c, hy⟩
    refine Scheme.IdealSheafData.le_of_iSup_eq_top
      (fun c : Chart (coborderIdeal DY.subschemeι) =>
        (⟨DY.subschemeι.liftCoborder ⁻¹ᵁ c.W.1, c.W.2.preimage _⟩ : DY.subscheme.affineOpens))
      hcover fun c => ?_
    have hle : DY.subschemeι.liftCoborder ⁻¹ᵁ c.W.1 ≤
        normalConeZeroSection DY ⁻¹ᵁ (c.coneAffine DY).1 := by
      change _ ≤ (normalConeZeroSection DY ≫ normalConeToBase DY.subschemeι ≫
        DY.subschemeι.liftCoborder) ⁻¹ᵁ c.W.1
      rw [← Category.assoc, normalConeZeroSection_comp_normalConeToBase, Category.id_comp]
    rw [Stacks.IdealSheaf.ideal_comap_appLE _ _ (c.coneAffine DY) _ hle,
      Stacks.IdealSheaf.ideal_comap_appLE _ _ c.toAffine (c.coneAffine DY) (coneAffine_le DY c),
      strictDivisor_ideal, Ideal.map_span, Set.image_singleton, Ideal.map_span,
      Set.image_singleton, normalConeToDeformation_appLE_chartIncl_one]
    have h0 := normalConeZeroSection_app_coneIncl DY
      ⟨DY.subschemeι.liftCoborder ⁻¹ᵁ c.W.1, c.W.2.preimage _⟩
      (Scheme.Modules.pullbackSection DY.subschemeι.liftCoborder
        (reesPiece (coborderIdeal DY.subschemeι) ((1 : ℕ) : ℤ)) c.W.1
        (DY.subschemeι.liftCoborder ⁻¹ᵁ c.W.1) le_rfl
        (extReesOfMem (coborderIdeal DY.subschemeι) c.W 1 c.g
          (by rw [pow_one, c.span]; exact Ideal.mem_span_singleton_self _)))
    refine Ideal.span_le.2 ?_
    rintro _ rfl
    have hz := (congrArg (DY.subscheme.presheaf.map (homOfLE hle).op).hom h0).trans (map_zero _)
    exact hz ▸ Ideal.zero_mem _
  · -- the ideal of `o(Y)` lies in `A`
    have hfac := eq_comp_normalConeZeroSection_of_basis DY A.subschemeι
      (A.subschemeι ≫ normalConeToBase DY.subschemeι) rfl
      (fun c : Chart (coborderIdeal DY.subschemeι) => DY.subschemeι.liftCoborder ⁻¹ᵁ c.W.1)
      (isBasis_chart_preimage DY) fun c x => by
        have hsurj : Function.Surjective (DY.subschemeι.liftCoborder.appLE c.W.1
            (DY.subschemeι.liftCoborder ⁻¹ᵁ c.W.1) le_rfl).hom := by
          rw [Scheme.Hom.appLE_preimage_self]
          exact DY.subschemeι.liftCoborder.app_surjective c.W.1 c.W.2
        have : (reesPiece (coborderIdeal DY.subschemeι) ((1 : ℕ) : ℤ)).IsQuasicoherent :=
          reesPiece_isQuasicoherent _ _
        obtain ⟨y, rfl⟩ := Stacks.Conormal.pullbackSection_surjective DY.subschemeι.liftCoborder
          (reesPiece (coborderIdeal DY.subschemeι) ((1 : ℕ) : ℤ)) le_rfl c.W.2
          (c.W.2.preimage _) hsurj x
        have hmem := hmemA c y
        exact (RingHom.mem_ker).1
          ((Scheme.IdealSheafData.ker_subschemeι_app A (c.coneAffine DY)).ge hmem)
    calc (normalConeZeroSection DY).ker
        ≤ ((A.subschemeι ≫ normalConeToBase DY.subschemeι) ≫ normalConeZeroSection DY).ker :=
          Scheme.Hom.le_ker_comp _ _
      _ = A.subschemeι.ker := by rw [← hfac]
      _ = A := Scheme.IdealSheafData.ker_subschemeι A

end Stacks.Deformation

end
