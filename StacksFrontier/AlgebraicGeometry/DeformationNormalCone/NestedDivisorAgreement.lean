module

public import StacksFrontier.AlgebraicGeometry.DeformationNormalCone.NestedDivisorCharts

/-!
# `E_Z` and `D(Z ⊆ Y)` agree away from `t⁻¹ = 0`

In the deformation space `M = D(Z ⊆ X)` of a nested pair `Z ⊆ Y ⊆ X` of effective Cartier
divisors, the divisor `E_Z` (generated by `g t` where `ℐ_Y = (g)`) contains the closed subscheme
`D(Z ⊆ Y)`, and the two have the same ideal after inverting `t⁻¹`: a homogeneous section `x t^k`
vanishing on `D(Z ⊆ Y)` has `x ∈ (g)`, and then `t^{-(k-1)} · x t^k = x t` is a multiple of `g t`
for `k ≥ 1`, while `x t^k` itself is one for `k ≤ 0`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.AffineAlgebraEquivalence Stacks.RelativeSpec Stacks.Blowup Stacks.Conormal

universe u

namespace Stacks.Deformation

variable {X : Scheme.{u}} (DY DZ : X.IdealSheafData) [Stacks.Divisors.IsEffectiveCartierDivisor DY]
  (hZY : DY ≤ DZ)

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- **The base map `U_{Z ⊆ Y} ⟶ U_{Z ⊆ X}` is the closed immersion of `Y`.** -/
theorem ker_innerBase :
    (innerBase DY DZ hZY).ker = (idealYX DY).comap (outerBase DY DZ) := by
  have := Stacks.Divisors.isIso_coborderRange_ι DZ.subschemeι
  have := Stacks.Divisors.isIso_coborderRange_ι DY.subschemeι
  have := Stacks.Divisors.isIso_coborderRange_ι (Scheme.IdealSheafData.inclusion hZY)
  have h1 : (innerBase DY DZ hZY).ker =
      ((innerBase DY DZ hZY).ker.map DZ.subschemeι.coborderRange.ι).comap
        DZ.subschemeι.coborderRange.ι :=
    (Scheme.IdealSheafData.comap_map_of_isIso _ _).symm
  rw [h1, Scheme.IdealSheafData.map_ker, coborderMap_ι, Scheme.Hom.ker_comp_of_isIso,
    Scheme.IdealSheafData.ker_subschemeι]
  change _ = (coborderIdeal DY.subschemeι).comap _
  rw [coborderIdeal_eq_comap, Scheme.IdealSheafData.ker_subschemeι,
    ← Scheme.IdealSheafData.comap_comp, coborderMap_ι, Category.comp_id]

/-- The map on sections over `U` agrees with the map `appLE` into the preimage of `U`. -/
private theorem hom_app_apply_eq_appLE {A B : Scheme.{u}} (f : A ⟶ B) (U : B.Opens)
    (a : Γ(B, U)) : (f.app U).hom a = (f.appLE U (f ⁻¹ᵁ U) le_rfl).hom a :=
  congrArg (fun q : Γ(B, U) ⟶ Γ(A, f ⁻¹ᵁ U) => q.hom a) (Scheme.Hom.app_eq_appLE f)

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- On a chart, the functions on `U_{Z ⊆ X}` vanishing on `Y` are the multiples of `g`. -/
theorem mem_span_of_innerBase_app_eq_zero (c : Chart (idealYX DY))
    (t : Γ(DZ.subschemeι.coborderRange.toScheme, outerBase DY DZ ⁻¹ᵁ c.W.1))
    (ht : ((innerBase DY DZ hZY).app (outerBase DY DZ ⁻¹ᵁ c.W.1)).hom t = 0) :
    t ∈ Ideal.span {((outerBase DY DZ).app c.W.1).hom c.g} := by
  have hW : IsAffineOpen (outerBase DY DZ ⁻¹ᵁ c.W.1) := c.W.2.preimage _
  have hker := Scheme.Hom.ker_apply (innerBase DY DZ hZY) ⟨_, hW⟩
  rw [ker_innerBase, Stacks.IdealSheaf.ideal_comap_appLE _ _ c.W ⟨_, hW⟩ le_rfl, c.span,
    Ideal.map_span, Set.image_singleton] at hker
  have : t ∈ RingHom.ker ((innerBase DY DZ hZY).app (outerBase DY DZ ⁻¹ᵁ c.W.1)).hom := ht
  rw [← hker] at this
  rwa [hom_app_apply_eq_appLE]

/-! ### Multiples of `g t` after inverting `t⁻¹` -/

section Degree

variable {U : Scheme.{u}} (I : U.IdealSheafData) (W : U.affineOpens) (g' : Γ(U, W.1))
  (hg' : g' ∈ I.ideal W)

include hg' in
/-- **A homogeneous section whose underlying function is a multiple of `g'` becomes a multiple of
`g' t` after multiplication by a power of `t⁻¹`.** -/
theorem exists_param_pow_mul_mem_span (k : ℤ)
    (x : ((extReesGradedAlgebra I).piece k).val.obj (op W.1))
    (r : Γ(U, W.1)) (hr : extReesAmbient I k W.1 x = r * g') :
    paramChartOf I W.1 ^ (k - 1).toNat * chartIncl I k W.1 x ∈
      Ideal.span {chartIncl I 1 W.1 (extReesOfMem I W 1 g' (by rwa [pow_one]))} := by
  obtain ⟨z₁, hz₁, hza₁⟩ := pow_chartIncl_eq I W (-1) (paramPiece I W.1) (k - 1).toNat
  obtain ⟨z₂, hz₂, hza₂⟩ := pow_chartIncl_eq I W (-1) (paramPiece I W.1) (1 - k).toNat
  have key : paramChartOf I W.1 ^ (k - 1).toNat * chartIncl I k W.1 x =
      (((deformationSpaceToBase I).app W.1).hom r * paramChartOf I W.1 ^ (1 - k).toNat) *
        chartIncl I 1 W.1 (extReesOfMem I W 1 g' (by rwa [pow_one])) := by
    rw [paramChartOf_eq_chartIncl, hz₁, hz₂, deformationSpaceToBase_app_eq_chartIncl,
      chartIncl_mul, chartIncl_mul, chartIncl_mul]
    refine chartIncl_congr I (by omega) W.1 _ _ ?_
    refine (extReesAmbient_extReesMul I _ k W.1 z₁ x).trans ?_
    refine Eq.trans ?_ (extReesAmbient_extReesMul I _ 1 W.1 _ _).symm
    refine Eq.trans ?_ (congrArg (· * _) (extReesAmbient_extReesMul I 0 _ W.1 _ z₂).symm)
    rw [hza₁, hza₂, hr, extReesAmbient_paramPiece, one_pow, one_pow]
    have e0 := extReesAmbient_extReesOfMem I W 0 r (by simp)
    have e1 := extReesAmbient_extReesOfMem I W 1 g' (by rwa [pow_one])
    refine Eq.trans ?_ (congrArg₂ (fun u v => u * 1 * v) e0.symm e1.symm)
    ring
  rw [key]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

/-- **A section of a chart lands in an ideal after multiplication by a power of `t⁻¹`** as soon as
each homogeneous component of the total section it comes from does: a total section is the finite
sum of its components, and the exponents of `t⁻¹` can be added. -/
private theorem exists_param_pow_mul_mem_of_components
    (a : Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ W.1))
    (J : Ideal Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ W.1))
    (t : (extReesGradedAlgebra I).toPresheafGradedAlgebra.Total (op W.1))
    (h : ∀ k : ℤ, ∃ N : ℕ, a ^ N * chartIncl I k W.1
      ((show DirectSum ℤ fun k =>
        ((extReesGradedAlgebra I).piece k).val.obj (op W.1) from t) k) ∈ J) :
    ∃ N : ℕ, a ^ N * chartRingHom I W.1 t ∈ J := by
  classical
  have hsum : t = ∑ k ∈ (show DirectSum ℤ fun k =>
      ((extReesGradedAlgebra I).piece k).val.obj (op W.1) from t).support,
      (extReesGradedAlgebra I).toPresheafGradedAlgebra.incl k
        ((show DirectSum ℤ fun k => ((extReesGradedAlgebra I).piece k).val.obj
          (op W.1) from t) k) :=
    (DirectSum.sum_support_of _).symm
  rw [hsum, map_sum]
  refine Finset.sum_induction _ (fun z => ∃ N : ℕ, a ^ N * z ∈ J) ?_ ?_ ?_
  · rintro z₁ z₂ ⟨N₁, h₁⟩ ⟨N₂, h₂⟩
    refine ⟨N₁ + N₂, ?_⟩
    have : a ^ (N₁ + N₂) * (z₁ + z₂) = a ^ N₂ * (a ^ N₁ * z₁) + a ^ N₁ * (a ^ N₂ * z₂) := by ring
    rw [this]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ h₁) (Ideal.mul_mem_left _ _ h₂)
  · exact ⟨0, by rw [mul_zero]; exact Ideal.zero_mem _⟩
  · intro k _
    exact h k

end Degree

/-! ### The functions vanishing on `D(Z ⊆ Y)` -/

/-- The affine chart `outerBase⁻¹ W` of the base of `D(Z ⊆ X)`. -/
abbrev Chart.baseAffine (c : Chart (idealYX DY)) :
    DZ.subschemeι.coborderRange.toScheme.affineOpens :=
  ⟨outerBase DY DZ ⁻¹ᵁ c.W.1, c.W.2.preimage _⟩

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
include hZY in
/-- The pullback of the local equation `g` of `Y` to `U_{Z ⊆ X}` lies in the ideal of `Z`. -/
theorem Chart.gen_mem (c : Chart (idealYX DY)) :
    ((outerBase DY DZ).app c.W.1).hom c.g ∈ (idealZX DZ).ideal (c.baseAffine DY DZ) := by
  refine outer_le DY DZ hZY _ ?_
  rw [Stacks.IdealSheaf.ideal_comap_appLE _ _ c.W (c.baseAffine DY DZ) le_rfl, c.span]
  rw [hom_app_apply_eq_appLE]
  exact Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self _)

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- The generator `g t` of `E_Z` on a chart is the degree-one element `g t` of the extended Rees
algebra of `Z ⊆ X`. -/
theorem Chart.nestedGen_eq' (c : Chart (idealYX DY)) :
    c.nestedGen DY DZ hZY = chartIncl (idealZX DZ) 1 (outerBase DY DZ ⁻¹ᵁ c.W.1)
      (extReesOfMem (idealZX DZ) (c.baseAffine DY DZ) 1 (((outerBase DY DZ).app c.W.1).hom c.g)
        (by rw [pow_one]; exact c.gen_mem DY DZ hZY)) := by
  rw [c.nestedGen_eq]
  refine chartIncl_congr _ rfl _ _ _ ?_
  exact (extReesAmbient_extReesPullback _ _ _ _ 1 c.W.1 _).trans
    ((congrArg _ (extReesAmbient_extReesOfMem (idealYX DY) c.W 1 c.g _)).trans
      (extReesAmbient_extReesOfMem (idealZX DZ) (c.baseAffine DY DZ) 1
        (((outerBase DY DZ).app c.W.1).hom c.g) _).symm)

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- **A homogeneous section on a chart of `D(Z ⊆ X)` whose pullback to `D(Z ⊆ Y)` vanishes becomes
a multiple of `g t` after multiplication by `t⁻¹` to the power `k - 1`**: its underlying function
vanishes on `Y`, hence is a multiple of `g`. -/
private theorem exists_param_pow_mul_mem_span_nestedGen_homogeneous (c : Chart (idealYX DY))
    (k : ℤ)
    (x : ((extReesGradedAlgebra (idealZX DZ)).piece k).val.obj (op (c.baseAffine DY DZ).1))
    (hx : extReesPullback (innerBase DY DZ hZY) (idealZX DZ) (idealZY DY DZ hZY)
      (inner_le DY DZ hZY) k (c.baseAffine DY DZ).1 x = 0) :
    paramChartOf (idealZX DZ) (c.baseAffine DY DZ).1 ^ (k - 1).toNat *
        chartIncl (idealZX DZ) k (c.baseAffine DY DZ).1 x ∈
      Ideal.span {c.nestedGen DY DZ hZY} := by
  have hamb : ((innerBase DY DZ hZY).app (c.baseAffine DY DZ).1).hom
      (extReesAmbient (idealZX DZ) k (c.baseAffine DY DZ).1 x) = 0 :=
    (extReesAmbient_extReesPullback _ _ _ _ k (c.baseAffine DY DZ).1 x).symm.trans
      ((congrArg _ hx).trans (extReesAmbient_zero _ _ _))
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.1
    (mem_span_of_innerBase_app_eq_zero DY DZ hZY c _ hamb)
  rw [c.nestedGen_eq' DY DZ hZY]
  exact exists_param_pow_mul_mem_span (idealZX DZ) (c.baseAffine DY DZ) _
    (c.gen_mem DY DZ hZY) k x r hr.symm

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- **A function on a chart of `D(Z ⊆ X)` vanishing on `D(Z ⊆ Y)` becomes a multiple of `g t`
after multiplication by a power of `t⁻¹`.** -/
theorem exists_param_pow_mul_mem_span_nestedGen (c : Chart (idealYX DY))
    (y : Γ(deformationSpace (idealZX DZ), (c.nestedAffine DY DZ).1))
    (hy : ((nestedInnerMap DY DZ hZY).appLE _ _ (innerToBase_preimage_le DY DZ hZY c)).hom y = 0) :
    ∃ N : ℕ, paramChartOf (idealZX DZ) (outerBase DY DZ ⁻¹ᵁ c.W.1) ^ N * y ∈
      Ideal.span {c.nestedGen DY DZ hZY} := by
  classical
  set W' := c.baseAffine DY DZ
  set T : (extReesGradedAlgebra (idealZX DZ)).toPresheafGradedAlgebra.Total (op W'.1) →+
      (extReesGradedAlgebra (idealZY DY DZ hZY)).toPresheafGradedAlgebra.Total
        (op (innerBase DY DZ hZY ⁻¹ᵁ W'.1)) :=
    DirectSum.map fun k => extReesPullback (innerBase DY DZ hZY) (idealZX DZ) (idealZY DY DZ hZY)
      (inner_le DY DZ hZY) k W'.1
  have hcomm : ∀ t, ((nestedInnerMap DY DZ hZY).appLE _ _ (innerToBase_preimage_le DY DZ hZY c)).hom
      (chartRingHom (idealZX DZ) W'.1 t) =
      chartRingHom (idealZY DY DZ hZY) (innerBase DY DZ hZY ⁻¹ᵁ W'.1) (T t) := by
    intro t
    induction t using Stacks.GradedAlgebra.incl_induction with
    | zero =>
      rw [map_zero (chartRingHom (idealZX DZ) W'.1), map_zero T,
        map_zero (chartRingHom (idealZY DY DZ hZY) (innerBase DY DZ hZY ⁻¹ᵁ W'.1))]
      exact map_zero _
    | incl k x =>
      rw [chartRingHom_incl]
      refine (deformationMap_appLE_chartIncl' (innerBase DY DZ hZY) (idealZX DZ)
        (idealZY DY DZ hZY) (inner_le DY DZ hZY) W' k x _).trans ?_
      exact (congrArg (chartRingHom (idealZY DY DZ hZY) (innerBase DY DZ hZY ⁻¹ᵁ W'.1))
        (DirectSum.map_of (α := fun k =>
            ((extReesGradedAlgebra (idealZX DZ)).piece k).val.obj (op W'.1))
          (β := fun k => ((extReesGradedAlgebra (idealZY DY DZ hZY)).piece k).val.obj
            (op (innerBase DY DZ hZY ⁻¹ᵁ W'.1)))
          (fun k => extReesPullback (innerBase DY DZ hZY) (idealZX DZ) (idealZY DY DZ hZY)
            (inner_le DY DZ hZY) k W'.1) k x)).symm
    | add t t' ht ht' =>
      rw [map_add (chartRingHom (idealZX DZ) W'.1), map_add, ht, ht', map_add T, map_add]
  obtain ⟨t, rfl⟩ := (bijective_chartRingHom (idealZX DZ) W').2 y
  have hT : T t = 0 := (bijective_chartRingHom (idealZY DY DZ hZY)
    ⟨innerBase DY DZ hZY ⁻¹ᵁ W'.1, W'.2.preimage _⟩).1 (((hcomm t).symm.trans hy).trans
      (map_zero _).symm)
  refine exists_param_pow_mul_mem_of_components (idealZX DZ) W' _ _ t fun k => ⟨(k - 1).toNat, ?_⟩
  refine exists_param_pow_mul_mem_span_nestedGen_homogeneous DY DZ hZY c k _ ?_
  exact (DirectSum.map_apply (α := fun k =>
        ((extReesGradedAlgebra (idealZX DZ)).piece k).val.obj (op W'.1))
      (β := fun k => ((extReesGradedAlgebra (idealZY DY DZ hZY)).piece k).val.obj
        (op (innerBase DY DZ hZY ⁻¹ᵁ W'.1)))
      (fun k => extReesPullback (innerBase DY DZ hZY) (idealZX DZ) (idealZY DY DZ hZY)
        (inner_le DY DZ hZY) k W'.1) k t).symm.trans
    (congrArg (fun S : DirectSum ℤ (fun k => ((extReesGradedAlgebra (idealZY DY DZ hZY)).piece
      k).val.obj (op (innerBase DY DZ hZY ⁻¹ᵁ W'.1))) => S k) hT)

/-! ### Agreement away from `t⁻¹ = 0` -/

/-- **`E_Z` and `D(Z ⊆ Y)` have the same ideal on the basic open of `t⁻¹` in a chart**: a
function vanishing on `D(Z ⊆ Y)` becomes a multiple of `g t` after multiplication by a power of
`t⁻¹`, which is a unit there. -/
theorem ker_nestedInnerMap_ideal_basicOpen (c : Chart (idealYX DY)) :
    (nestedInnerMap DY DZ hZY).ker.ideal
        ((deformationSpace (idealZX DZ)).affineBasicOpen (U := c.nestedAffine DY DZ)
          (paramChartOf (idealZX DZ) (outerBase DY DZ ⁻¹ᵁ c.W.1))) =
      (nestedDivisor DY DZ hZY).ideal
        ((deformationSpace (idealZX DZ)).affineBasicOpen (U := c.nestedAffine DY DZ)
          (paramChartOf (idealZX DZ) (outerBase DY DZ ⁻¹ᵁ c.W.1))) := by
  refine le_antisymm ?_ (nestedDivisor_le_ker DY DZ hZY _)
  refine ((nestedInnerMap DY DZ hZY).ker.map_ideal_basicOpen (c.nestedAffine DY DZ) _).symm.trans_le
    (le_of_le_of_eq ?_ ((nestedDivisor DY DZ hZY).map_ideal_basicOpen (c.nestedAffine DY DZ) _))
  rw [nestedDivisor_ideal, Ideal.map_le_iff_le_comap]
  intro y hy
  rw [Scheme.Hom.ker_apply] at hy
  have hy' : ((nestedInnerMap DY DZ hZY).appLE _ _
      (innerToBase_preimage_le DY DZ hZY c)).hom y = 0 := by
    rw [Scheme.Hom.appLE, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.mem_ker.1 hy, map_zero]
  obtain ⟨N, hN⟩ := exists_param_pow_mul_mem_span_nestedGen DY DZ hZY c y hy'
  have hunit := (deformationSpace (idealZX DZ)).toRingedSpace.isUnit_res_basicOpen
    (paramChartOf (idealZX DZ) (outerBase DY DZ ⁻¹ᵁ c.W.1))
  rw [Ideal.mem_comap]
  have h2 := Ideal.mem_map_of_mem ((deformationSpace (idealZX DZ)).presheaf.map
    (homOfLE ((deformationSpace (idealZX DZ)).basicOpen_le
      (paramChartOf (idealZX DZ) (outerBase DY DZ ⁻¹ᵁ c.W.1)))).op).hom hN
  rw [map_mul, map_pow] at h2
  exact (Ideal.unit_mul_mem_iff_mem _ (hunit.pow N)).1 h2

/-- Two ideal sheaves with the same ideal on an affine open agree on that open. -/
theorem comap_ι_eq_of_ideal_eq {T : Scheme.{u}} {I J : T.IdealSheafData} (W : T.affineOpens)
    (h : I.ideal W = J.ideal W) : I.comap W.1.ι = J.comap W.1.ι := by
  refine Scheme.IdealSheafData.ext (funext fun U => ?_)
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
    Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion]
  have hle : (⟨W.1.ι ''ᵁ U.1, U.2.image_of_isOpenImmersion _⟩ : T.affineOpens) ≤ W :=
    W.1.ι_image_le U.1
  rw [← I.map_ideal hle, ← J.map_ideal hle, h]

/-- **Away from `t⁻¹ = 0`, `E_Z` and `D(Z ⊆ Y)` agree**: every point of `D(Z ⊆ X)` off
`Z(t⁻¹)` has an affine neighbourhood on which the two ideals coincide. -/
theorem exists_affineOpen_ker_nestedInnerMap_eq (x : deformationSpace (idealZX DZ))
    (hx : x ∉ (Stacks.Divisors.zeroScheme (deformationSpace (idealZX DZ))
      (Scheme.unitModule (deformationSpace (idealZX DZ))) (paramGlobal (idealZX DZ))).support) :
    ∃ W : (deformationSpace (idealZX DZ)).affineOpens, x ∈ W.1 ∧
      (nestedInnerMap DY DZ hZY).ker.ideal W = (nestedDivisor DY DZ hZY).ideal W := by
  obtain ⟨c, hc⟩ := Opens.mem_iSup.1 ((iSup_nestedAffine_eq_top DY DZ).ge (Set.mem_univ x))
  refine ⟨_, ?_, ker_nestedInnerMap_ideal_basicOpen DY DZ hZY c⟩
  rw [Scheme.IdealSheafData.mem_support_iff_of_mem (U := c.nestedAffine DY DZ) hc] at hx
  have hz := zeroScheme_paramGlobal_ideal (idealZX DZ) (c.baseAffine DY DZ)
  change x ∉ (deformationSpace (idealZX DZ)).zeroLocus (U := (c.nestedAffine DY DZ).1)
    ((Stacks.Divisors.zeroScheme (deformationSpace (idealZX DZ))
      (Scheme.unitModule (deformationSpace (idealZX DZ))) (paramGlobal (idealZX DZ))).ideal
        (c.nestedAffine DY DZ)) at hx
  rw [hz, Scheme.zeroLocus_span, Scheme.zeroLocus_singleton] at hx
  simpa using hx

end Stacks.Deformation

end
