module

public import StacksFrontier.AlgebraicGeometry.DeformationNormalCone.ConormalNaturality
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartier.Difference

/-!
# The pulled-back divisor and its strict part on the deformation space

Let `ℐ` be the ideal sheaf of an effective Cartier divisor on `U` and `π : D(ℐ) ⟶ U` the
deformation space. On a chart `π⁻¹W` with `ℐ(W) = (g)` the inverse image `π⁻¹ℐ` is generated by
`g = t⁻¹ · (g t)`. So `π⁻¹ℐ` is an effective Cartier divisor contained in `Z(t⁻¹)`, and the
difference `E = π⁻¹ℐ - Z(t⁻¹)` of [Stacks, Tag 02ON] is the effective Cartier divisor generated
by `g t` on that chart.

## Main definitions

* `Stacks.Deformation.chartRingHom`: the ring map from the homogeneous sections over `W` to the
  functions on `π⁻¹W`, bijective for `W` affine.
* `Stacks.Deformation.strictDivisor`: the divisor `E`.

## Main results

* `Stacks.Deformation.strictDivisor_ideal`: `E` is generated by `g t` on the chart `π⁻¹W`.
* `Stacks.Deformation.isEffectiveCartierDivisor_strictDivisor`: `E` is an effective Cartier
  divisor.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.AffineAlgebraEquivalence Stacks.RelativeSpec Stacks.Blowup

universe u

namespace Stacks.Deformation

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-! ### The chart ring map -/

/-- The ring map from the homogeneous sections of the extended Rees algebra over `W` to the
functions on the chart `π⁻¹W`. -/
def chartRingHom (W : X.Opens) :
    (extReesGradedAlgebra I).toPresheafGradedAlgebra.Total (op W) →+*
      Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ W) :=
  ((universalAlgebraMap (extReesSituation I)).right.app (op W)).hom.comp
    ((((ungradedAlgebraSheafIsoGradedAlgebraSheaf X (extReesGradedAlgebra I)
      (extReesGradedAlgebra_mul_comm I)).hom.right.hom.app (op W)).hom).comp
      (ungradedCommUnit X (extReesGradedAlgebra I) (extReesGradedAlgebra_mul_comm I) W).hom)

/-- `chartRingHom` sends the homogeneous section `x` of degree `k` to `chartIncl I k W x`. -/
theorem chartRingHom_incl (W : X.Opens) (k : ℤ)
    (x : ((extReesGradedAlgebra I).piece k).val.obj (op W)) :
    chartRingHom I W ((extReesGradedAlgebra I).toPresheafGradedAlgebra.incl k x) =
      chartIncl I k W x := rfl

/-- `chartRingHom` is bijective over an affine open `W`. -/
theorem bijective_chartRingHom (W : X.affineOpens) : Function.Bijective (chartRingHom I W.1) := by
  have := isIso_universalAlgebraMap_app (extReesSituation I) W
  exact (ConcreteCategory.bijective_of_isIso
    ((universalAlgebraMap (extReesSituation I)).right.app (op W.1))).comp
      ((bijective_algebraSheafIso_app (ungradedAlgebraSheafIsoGradedAlgebraSheaf X
        (extReesGradedAlgebra I) (extReesGradedAlgebra_mul_comm I)) W.1).comp
        (bijective_ungradedCommUnit_of_isAffineOpen X (extReesGradedAlgebra I)
          (extReesGradedAlgebra_mul_comm I) W.2))

/-- `chartIncl` is multiplicative: the product of the images of homogeneous sections of degrees
`k` and `l` is the image of their product in degree `k + l`. -/
theorem chartIncl_mul (W : X.Opens) (k l : ℤ)
    (x : ((extReesGradedAlgebra I).piece k).val.obj (op W))
    (y : ((extReesGradedAlgebra I).piece l).val.obj (op W)) :
    chartIncl I k W x * chartIncl I l W y =
      chartIncl I (k + l) W (((extReesGradedAlgebra I).mul k l).app (op W) x y) := by
  rw [← chartRingHom_incl, ← chartRingHom_incl, ← map_mul,
    Stacks.GradedAlgebra.incl_mul_incl]
  rfl

/-- `chartIncl` depends on the degree only up to equality. -/
theorem chartIncl_congr {k l : ℤ} (h : k = l) (W : X.Opens)
    (x : ((extReesGradedAlgebra I).piece k).val.obj (op W))
    (y : ((extReesGradedAlgebra I).piece l).val.obj (op W))
    (hxy : extReesAmbient I k W x = extReesAmbient I l W y) :
    chartIncl I k W x = chartIncl I l W y := by
  subst h
  rw [extReesAmbient_injective I k W hxy]

/-! ### Nonzerodivisors -/

/-- `C g * T^k` is a nonzerodivisor of `R[T, T⁻¹]` when `g` is a nonzerodivisor of `R`. -/
theorem isRegular_C_mul_T {R : Type*} [CommRing R] {g : R} (hg : IsRegular g) (k : ℤ) :
    IsRegular (LaurentPolynomial.C g * LaurentPolynomial.T k : LaurentPolynomial R) := by
  refine IsRegular.mul ?_ (LaurentPolynomial.isUnit_T k).isRegular
  have hl : IsLeftRegular (LaurentPolynomial.C g : LaurentPolynomial R) := fun p q h => by
    have h' : g • p = g • q := by
      rw [LaurentPolynomial.smul_eq_C_mul, LaurentPolynomial.smul_eq_C_mul]; exact h
    apply AddMonoidAlgebra.coeffEquiv.injective
    ext n
    have := congrArg (fun r : LaurentPolynomial R => r.coeff n) h'
    simp only [AddMonoidAlgebra.coeff_smul_apply, smul_eq_mul] at this
    exact hg.1 this
  exact ⟨hl, fun p q h => hl (by simpa only [mul_comm] using h)⟩

/-- A homogeneous section of degree `k ≥ 0` over an affine open, from an element of `ℐ(W)ᵏ`. -/
def extReesOfMem (W : X.affineOpens) (k : ℕ) (g : Γ(X, W.1)) (hg : g ∈ I.ideal W ^ k) :
    ((extReesGradedAlgebra I).piece (k : ℤ)).val.obj (op W.1) :=
  (reesPieceAffineEquiv I (k : ℤ) (Int.natCast_nonneg k) W).symm ⟨g, by simpa using hg⟩

/-- The underlying function of `extReesOfMem I W k g hg` is `g`. -/
theorem extReesAmbient_extReesOfMem (W : X.affineOpens) (k : ℕ) (g : Γ(X, W.1))
    (hg : g ∈ I.ideal W ^ k) :
    extReesAmbient I (k : ℤ) W.1 (extReesOfMem I W k g hg) = g := by
  have := reesPieceAffineEquiv_coe I (k : ℤ) (Int.natCast_nonneg k) W (extReesOfMem I W k g hg)
  refine this.symm.trans ?_
  simp only [extReesOfMem, AddEquiv.apply_symm_apply]

/-- **The image of a function on the base is its homogeneous section of degree `0`.** -/
theorem deformationSpaceToBase_app_eq_chartIncl (W : X.affineOpens) (g : Γ(X, W.1)) :
    ((deformationSpaceToBase I).app W.1).hom g =
      chartIncl I 0 W.1 (extReesOfMem I W 0 g (by simp)) := by
  refine (congrArg (fun q => q.hom g) (toBase_app (extReesSituation I) W.1)).trans ?_
  show ((universalAlgebraMap (extReesSituation I)).right.app (op W.1)).hom
    (((extReesAlgebraSheaf I).hom.hom.app (op W.1)).hom g) = _
  congr 1
  have hw := ConcreteCategory.congr_hom (NatTrans.congr_app (congrArg (fun φ => φ.hom)
    (Under.w (ungradedAlgebraSheafIsoGradedAlgebraSheaf X (extReesGradedAlgebra I)
      (extReesGradedAlgebra_mul_comm I)).hom)) (op W.1)) g
  refine hw.symm.trans ?_
  show ((ungradedAlgebraSheafIsoGradedAlgebraSheaf X (extReesGradedAlgebra I)
      (extReesGradedAlgebra_mul_comm I)).hom.right.hom.app (op W.1)).hom
    ((ungradedCommUnit X (extReesGradedAlgebra I) (extReesGradedAlgebra_mul_comm I) W.1).hom
      ((extReesGradedAlgebra I).toPresheafGradedAlgebra.structureMap (op W.1) g)) = _
  congr 2
  show (show X.ringCatSheaf.obj.obj (op W.1) from g) •
    (1 : (extReesGradedAlgebra I).toPresheafGradedAlgebra.Total (op W.1)) = _
  rw [Stacks.GradedAlgebra.one_eq_incl, ← Stacks.GradedAlgebra.incl_smul]
  congr 1
  refine extReesAmbient_injective I 0 W.1 ?_
  refine (extReesAmbient_smul I 0 W.1 _ _).trans ?_
  refine (congrArg _ (extReesAmbient_extReesOne I (op W.1))).trans ?_
  exact (mul_one _).trans (extReesAmbient_extReesOfMem I W 0 g _).symm

/-- **On a chart, a function of the base factors as `t⁻¹ · (g t)`.** -/
theorem deformationSpaceToBase_app_eq_param_mul (W : X.affineOpens) (g : Γ(X, W.1))
    (hg : g ∈ I.ideal W) :
    ((deformationSpaceToBase I).app W.1).hom g =
      paramChartOf I W.1 * chartIncl I 1 W.1 (extReesOfMem I W 1 g (by simpa using hg)) := by
  refine (deformationSpaceToBase_app_eq_chartIncl I W g).trans ?_
  refine Eq.trans ?_ (chartIncl_mul I W.1 (-1) ((1 : ℕ) : ℤ) (paramPiece I W.1) _).symm
  refine chartIncl_congr I (by norm_num) W.1 _ _ ?_
  exact (extReesAmbient_extReesOfMem I W 0 g _).trans (((one_mul g).symm.trans
    (congrArg₂ (· * ·) (extReesAmbient_paramPiece I W.1).symm
      (extReesAmbient_extReesOfMem I W 1 g _).symm)).trans
    (extReesAmbient_extReesMul I (-1) ((1 : ℕ) : ℤ) W.1 _ _).symm)

/-- **The section `g t` is a nonzerodivisor when `g` is.** -/
theorem isRegular_chartIncl_extReesOfMem (W : X.affineOpens) (g : Γ(X, W.1))
    (hg : g ∈ I.ideal W) (hreg : IsRegular g) :
    IsRegular (chartIncl I 1 W.1 (extReesOfMem I W 1 g (by simpa using hg))) := by
  rw [← chartRingHom_incl]
  refine isRegular_map_of_bijective _ (bijective_chartRingHom I W) ?_
  refine isRegular_of_injective _ (extReesLaurent_injective I W.1) ?_
  rw [extReesLaurent_incl]
  have : extReesAmbient I ((1 : ℕ) : ℤ) W.1 (extReesOfMem I W 1 g (by simpa using hg)) = g :=
    extReesAmbient_extReesOfMem I W 1 g _
  exact (congrArg (fun r => _root_.IsRegular (LaurentPolynomial.C r *
    LaurentPolynomial.T ((1 : ℕ) : ℤ))) this).mpr (isRegular_C_mul_T hreg _)

/-! ### The inverse image of the divisor and its strict part -/

variable (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)

/-- The data of a principal chart. -/
structure Chart where
  /-- The affine open. -/
  W : X.affineOpens
  /-- The generator. -/
  g : Γ(X, W.1)
  /-- It is a nonzerodivisor. -/
  reg : IsRegular g
  /-- It generates the ideal. -/
  span : I.ideal W = Ideal.span {g}

/-- The chart `π⁻¹W` of a principal chart, as an affine open of the deformation space. -/
abbrev Chart.toAffine {I : X.IdealSheafData} (c : Chart I) : (deformationSpace I).affineOpens :=
  ⟨deformationSpaceToBase I ⁻¹ᵁ c.W.1,
    Stacks.RelativeSpec.isAffineOpen_toBase_preimage (extReesSituation I) c.W⟩

/-- The section `g t` of a principal chart. -/
abbrev Chart.strictGen {I : X.IdealSheafData} (c : Chart I) :
    Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ c.W.1) :=
  chartIncl I 1 c.W.1
    (extReesOfMem I c.W 1 c.g (by rw [pow_one, c.span]; exact Ideal.mem_span_singleton_self _))

include hI in
/-- The charts `π⁻¹W` of the principal charts cover the deformation space. -/
theorem iSup_chart_eq_top : ⨆ c : Chart I, c.toAffine.1 = ⊤ := by
  refine eq_top_iff.2 fun x _ => ?_
  obtain ⟨U, hU, hxU, g, hg, hspan⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor I hI
      (deformationSpaceToBase I x)
  exact Opens.mem_iSup.2 ⟨⟨⟨U, hU⟩, g, hg, hspan⟩, hxU⟩

/-- **The inverse image of `ℐ` on a chart is generated by `t⁻¹ · (g t)`.** -/
theorem comap_toBase_ideal (c : Chart I) :
    (I.comap (deformationSpaceToBase I)).ideal c.toAffine =
      Ideal.span {paramChartOf I c.W.1 * c.strictGen} := by
  refine (Stacks.IdealSheaf.ideal_comap_appLE _ _ c.W c.toAffine le_rfl).trans ?_
  rw [c.span, Ideal.map_span, Set.image_singleton]
  congr 2
  exact (congrArg (fun q : Γ(X, c.W.1) ⟶ Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ c.W.1)
    => q.hom c.g) (Scheme.Hom.app_eq_appLE (deformationSpaceToBase I))).symm.trans
    (deformationSpaceToBase_app_eq_param_mul I c.W c.g
      (by rw [c.span]; exact Ideal.mem_span_singleton_self _))

include hI in
/-- The inverse image of `ℐ` is an effective Cartier divisor. -/
theorem isEffectiveCartierDivisor_comap_toBase :
    Stacks.Divisors.IsEffectiveCartierDivisor (I.comap (deformationSpaceToBase I)) := by
  refine Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen _ fun x => ?_
  obtain ⟨U, hU, hxU, g, hg, hspan⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor I hI
      (deformationSpaceToBase I x)
  let c : Chart I := ⟨⟨U, hU⟩, g, hg, hspan⟩
  exact ⟨c.toAffine.1, c.toAffine.2, hxU, _, (isRegular_paramChartOf I c.W).mul
    (isRegular_chartIncl_extReesOfMem I c.W c.g
      (by rw [c.span]; exact Ideal.mem_span_singleton_self _) c.reg), comap_toBase_ideal I c⟩

include hI in
/-- The inverse image of `ℐ` is contained in the ideal sheaf of `Z(t⁻¹)`. -/
theorem comap_toBase_le_zeroScheme :
    I.comap (deformationSpaceToBase I) ≤
      Stacks.Divisors.zeroScheme (deformationSpace I) (Scheme.unitModule (deformationSpace I))
        (paramGlobal I) := by
  refine Scheme.IdealSheafData.le_of_iSup_eq_top (fun c : Chart I => c.toAffine)
    (iSup_chart_eq_top I hI) fun c => ?_
  rw [comap_toBase_ideal]
  refine (Ideal.span_le.2 ?_).trans (zeroScheme_paramGlobal_ideal I c.W).ge
  rintro _ rfl
  exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

include hI in
/-- There is an effective Cartier divisor `E` on the deformation space with
`π⁻¹ℐ = Z(t⁻¹) · E`. -/
theorem exists_strictDivisor :
    ∃ E : (deformationSpace I).IdealSheafData, Stacks.Divisors.IsEffectiveCartierDivisor E ∧
      I.comap (deformationSpaceToBase I) =
        Stacks.Divisors.zeroScheme (deformationSpace I) (Scheme.unitModule (deformationSpace I))
          (paramGlobal I) * E :=
  AlgebraicGeometry.exists_isEffectiveCartierDivisor_mul_eq_of_le _ _
    (isEffectiveCartierDivisor_zeroScheme_paramGlobal I)
    (isEffectiveCartierDivisor_comap_toBase I hI) (comap_toBase_le_zeroScheme I hI)

/-- **The strict part `E = π⁻¹ℐ - Z(t⁻¹)` of the inverse image of `ℐ`.** -/
def strictDivisor : (deformationSpace I).IdealSheafData :=
  Classical.choose (exists_strictDivisor I hI)

/-- The strict part `strictDivisor I hI` is an effective Cartier divisor. -/
theorem isEffectiveCartierDivisor_strictDivisor :
    Stacks.Divisors.IsEffectiveCartierDivisor (strictDivisor I hI) :=
  (Classical.choose_spec (exists_strictDivisor I hI)).1

/-- The inverse image of `ℐ` is the product of `Z(t⁻¹)` and the strict part. -/
theorem comap_toBase_eq_mul_strictDivisor :
    I.comap (deformationSpaceToBase I) =
      Stacks.Divisors.zeroScheme (deformationSpace I) (Scheme.unitModule (deformationSpace I))
        (paramGlobal I) * strictDivisor I hI :=
  (Classical.choose_spec (exists_strictDivisor I hI)).2

/-- **On a chart the strict part is generated by `g t`.** -/
theorem strictDivisor_ideal (c : Chart I) :
    (strictDivisor I hI).ideal c.toAffine = Ideal.span {c.strictGen} := by
  have hprod := congrArg (fun J : (deformationSpace I).IdealSheafData => J.ideal c.toAffine)
    (comap_toBase_eq_mul_strictDivisor I hI)
  simp only [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply] at hprod
  rw [comap_toBase_ideal] at hprod
  have hz : (Stacks.Divisors.zeroScheme (deformationSpace I)
      (Scheme.unitModule (deformationSpace I)) (paramGlobal I)).ideal c.toAffine =
      Ideal.span {paramChartOf I c.W.1} := zeroScheme_paramGlobal_ideal I c.W
  rw [hz] at hprod
  have ha := isRegular_paramChartOf I c.W
  apply le_antisymm
  · intro y hy
    have hmem : paramChartOf I c.W.1 * y ∈ Ideal.span {paramChartOf I c.W.1 * c.strictGen} := by
      rw [hprod]; exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _) hy
    obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.1 hmem
    rw [Ideal.mem_span_singleton']
    refine ⟨z, ha.1 ?_⟩
    simp only
    rw [← hz]
    ring
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    have hmem : paramChartOf I c.W.1 * c.strictGen ∈
        Ideal.span {paramChartOf I c.W.1} * (strictDivisor I hI).ideal c.toAffine := by
      rw [← hprod]; exact Ideal.mem_span_singleton_self _
    obtain ⟨z, hz, hz'⟩ := Ideal.mem_span_singleton_mul.1 hmem
    rw [ha.1 hz'] at hz
    exact hz

end Stacks.Deformation

namespace Stacks.Deformation

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- **A homogeneous section with a nonzerodivisor underlying function is a nonzerodivisor on the
chart.** -/
theorem isRegular_chartIncl_of_ambient (W : X.affineOpens) (k : ℤ)
    (x : ((extReesGradedAlgebra I).piece k).val.obj (op W.1))
    (hreg : IsRegular (extReesAmbient I k W.1 x)) :
    IsRegular (chartIncl I k W.1 x) := by
  rw [← chartRingHom_incl]
  refine isRegular_map_of_bijective _ (bijective_chartRingHom I W) ?_
  refine isRegular_of_injective _ (extReesLaurent_injective I W.1) ?_
  rw [extReesLaurent_incl]
  exact isRegular_C_mul_T hreg k

/-- A homogeneous section with vanishing underlying function vanishes on the chart. -/
theorem chartIncl_eq_zero_of_ambient (W : X.Opens) (k : ℤ)
    (x : ((extReesGradedAlgebra I).piece k).val.obj (op W))
    (h0 : extReesAmbient I k W x = 0) : chartIncl I k W x = 0 := by
  have : x = 0 := extReesAmbient_injective I k W (h0.trans (extReesAmbient_zero I k W).symm)
  rw [this, ← chartRingHom_incl, Stacks.GradedAlgebra.incl_zero, map_zero]

end Stacks.Deformation

end
