module

public import StacksFrontier.AlgebraicGeometry.DeformationNormalCone.Parameter

/-!
# The normal cone is the fibre `t⁻¹ = 0` of the deformation space

Let `i : Z ⟶ X` be an immersion and `κ : C_ZX ⟶ D` the closed immersion of the normal cone into
the deformation space over `U = i.coborderRange`. This file identifies the ideal sheaf of `κ`
over each affine chart `π⁻¹(W)`, `W ⊆ U` affine: it is generated by the parameter `t⁻¹`.

## Main definitions

* `Stacks.Deformation.paramSection`: `t⁻¹` as a section of the algebra sheaf
  `𝒪_U[t⁻¹, ℐt]`, and `Stacks.Deformation.paramChartSection` its image in `Γ(D, π⁻¹W)`.

## Main results

* `Stacks.Deformation.ker_normalConeToDeformation_ideal`: the ideal of `κ` over the affine chart
  `π⁻¹(W)` is generated by `t⁻¹`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.AffineAlgebraEquivalence Stacks.SymAlgSheaf Stacks.RelativeSpec Stacks.Blowup
  Stacks.Conormal

universe u

namespace Stacks.Deformation

variable {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i]

/-- `t⁻¹` as a section, over `W`, of the extended Rees algebra sheaf. -/
def paramSection (W : i.coborderRange.toScheme.Opens) :
    AlgebraSheaf.sections (extReesAlgebraSheaf (coborderIdeal i)) W :=
  ((ungradedAlgebraSheafIsoGradedAlgebraSheaf i.coborderRange.toScheme
    (extReesGradedAlgebra (coborderIdeal i)) (extReesGradedAlgebra_mul_comm _)).hom.right.hom.app
      (op W)).hom (paramUngraded (coborderIdeal i) W)

/-- `t⁻¹` as a function on the chart `π⁻¹(W)` of the deformation space. -/
def paramChartSection (W : i.coborderRange.toScheme.Opens) :
    Γ(deformationSpace (coborderIdeal i), deformationSpaceToBase (coborderIdeal i) ⁻¹ᵁ W) :=
  ((universalAlgebraMap (deformationSituation i)).right.app (op W)).hom (paramSection i W)

/-- The kernel of `Ψ` over an affine open, in the spelling the deformation space is built from. -/
theorem ker_normalConeToDeformationAlgebraHom_app (W : i.coborderRange.toScheme.affineOpens) :
    RingHom.ker ((normalConeToDeformationAlgebraHom i).right.hom.app (op W.1)).hom =
      Ideal.span {paramSection i W.1} := by
  set e₁ := (ungradedAlgebraSheafIsoGradedAlgebraSheaf i.coborderRange.toScheme
    (extReesGradedAlgebra (coborderIdeal i)) (extReesGradedAlgebra_mul_comm _))
  set e₂ := (algebraPushforward i.liftCoborder).mapIso (ungradedAlgebraSheafIsoGradedAlgebraSheaf Z
      (conormalAlgebra i).algebra (conormalAlgebra i).mul_comm_int)
  set e₃ := (algebraPushforward i.liftCoborder).mapIso
      (pushforwardAlgebraIso (conormalAlgebraSheaf i)).symm
  have hdecomp : ∀ x, ((normalConeToDeformationAlgebraHom i).right.hom.app (op W.1)).hom x =
      (e₃.hom.right.hom.app (op W.1)).hom ((e₂.hom.right.hom.app (op W.1)).hom
        (((toConormalUngradedHom i).right.hom.app (op W.1)).hom
          ((e₁.inv.right.hom.app (op W.1)).hom x))) := fun x => rfl
  have hrt : ∀ {A B : AlgebraSheaf i.coborderRange.toScheme} (e : A ≅ B) (c),
      (e.inv.right.hom.app (op W.1)).hom ((e.hom.right.hom.app (op W.1)).hom c) = c :=
    fun e c => congrArg (fun k => (k.right.hom.app (op W.1)).hom c) e.hom_inv_id
  have hinj := fun {A B : AlgebraSheaf i.coborderRange.toScheme} (e : A ≅ B) =>
    Function.LeftInverse.injective (hrt e)
  apply le_antisymm
  · intro x hx
    rw [RingHom.mem_ker, hdecomp] at hx
    have h0 : ((toConormalUngradedHom i).right.hom.app (op W.1)).hom
        ((e₁.inv.right.hom.app (op W.1)).hom x) = 0 :=
      hinj e₂ (hinj e₃ (hx.trans (map_zero _).symm) |>.trans (map_zero _).symm)
    have hmem : (e₁.inv.right.hom.app (op W.1)).hom x ∈
        Ideal.span {paramUngraded (coborderIdeal i) W.1} := ker_toConormalUngradedHom_app i W ▸ h0
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 hmem
    rw [Ideal.mem_span_singleton']
    refine ⟨(e₁.hom.right.hom.app (op W.1)).hom c, ?_⟩
    rw [← hrt e₁.symm x]
    erw [← hc, map_mul]
    rfl
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    change ((normalConeToDeformationAlgebraHom i).right.hom.app (op W.1)).hom
      (paramSection i W.1) = 0
    rw [hdecomp]
    have : (e₁.inv.right.hom.app (op W.1)).hom (paramSection i W.1) =
        paramUngraded (coborderIdeal i) W.1 := hrt e₁ _
    rw [this, toConormalUngradedHom_paramUngraded]
    exact (congrArg _ (map_zero _)).trans (map_zero _)

/-- **The ideal of the normal cone in the deformation space, over an affine chart, is generated
by `t⁻¹`.** -/
theorem ker_normalConeToDeformation_ideal (W : i.coborderRange.toScheme.affineOpens) :
    (normalConeToDeformation i).ker.ideal
        ⟨deformationSpaceToBase (coborderIdeal i) ⁻¹ᵁ W.1,
          Stacks.RelativeSpec.isAffineOpen_toBase_preimage (deformationSituation i) W⟩ =
      Ideal.span {paramChartSection i W.1} := by
  have hpre : normalConeToDeformation i ⁻¹ᵁ (deformationSpaceToBase (coborderIdeal i) ⁻¹ᵁ W.1) =
      (normalConeToBase i ≫ i.liftCoborder) ⁻¹ᵁ W.1 := by
    rw [← Scheme.Hom.comp_preimage, normalConeToDeformation_toBase]
  have hle : (normalConeToBase i ≫ i.liftCoborder) ⁻¹ᵁ W.1 ≤
      normalConeToDeformation i ⁻¹ᵁ (deformationSpaceToBase (coborderIdeal i) ⁻¹ᵁ W.1) := hpre.ge
  have happLE := pairToHom_appLE (s := deformationSituation i)
    ⟨normalConeToBase i ≫ i.liftCoborder,
      (extReesAlgebraSheaf (coborderIdeal i)).pairHomEquiv (normalConeToBase i ≫ i.liftCoborder)
        (normalConeToDeformationAlgebraHom i)⟩ W hle
  have hmapinj : Function.Injective ((normalCone i).presheaf.map (homOfLE hle).op).hom := by
    have : IsIso ((normalCone i).presheaf.map (homOfLE hle).op) := by
      have he : (homOfLE hle).op = eqToHom (congrArg op hpre) := Subsingleton.elim _ _
      rw [he]
      infer_instance
    exact (ConcreteCategory.bijective_of_isIso _).1
  have := isIso_universalAlgebraMap_app (deformationSituation i) W
  have hu : Function.Bijective
      ((universalAlgebraMap (deformationSituation i)).right.app (op W.1)).hom :=
    ConcreteCategory.bijective_of_isIso _
  refine (Scheme.Hom.ker_apply (normalConeToDeformation i) _).trans ?_
  ext y
  obtain ⟨x, rfl⟩ := hu.2 y
  have key : ((normalConeToDeformation i).app _).hom
      (((universalAlgebraMap (deformationSituation i)).right.app (op W.1)).hom x) = 0 ↔
      ((normalConeToDeformationAlgebraHom i).right.hom.app (op W.1)).hom x = 0 := by
    have h3 : ((normalConeToDeformationAlgebraHom i).right.hom.app (op W.1)).hom x =
        ((normalCone i).presheaf.map (homOfLE hle).op).hom (((normalConeToDeformation i).app
          (deformationSpaceToBase (coborderIdeal i) ⁻¹ᵁ W.1)).hom
          (((universalAlgebraMap (deformationSituation i)).right.app (op W.1)).hom x)) :=
      (congrArg (fun φ => φ.hom x) happLE).symm
    exact ⟨fun h => h3.trans ((congrArg _ h).trans (map_zero _)),
      fun h => hmapinj ((h3.symm.trans h).trans (map_zero _).symm)⟩
  refine RingHom.mem_ker.trans (key.trans (RingHom.mem_ker.symm.trans ?_))
  rw [ker_normalConeToDeformationAlgebraHom_app]
  refine ⟨fun h => ?_, fun h => ?_⟩
  · obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 h
    rw [map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
  · obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 h
    obtain ⟨c', rfl⟩ := hu.2 c
    exact Ideal.mem_span_singleton'.2 ⟨c', hu.1 (by rwa [map_mul])⟩

end Stacks.Deformation

end
