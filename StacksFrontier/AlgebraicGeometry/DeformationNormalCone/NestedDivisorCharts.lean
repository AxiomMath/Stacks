module

public import StacksFrontier.AlgebraicGeometry.DeformationNormalCone.NestedDivisors

/-!
# The divisor `E` on the deformation space of `Z ⊆ X`

For effective Cartier divisors `Z ⊆ Y ⊆ X`, let `E ⊆ D(Y ⊆ X)` be the strict part of the inverse
image of `Y` and `E_Z = φ⁻¹E ⊆ D(Z ⊆ X)` its inverse image along `φ : D(Z ⊆ X) ⟶ D(Y ⊆ X)`. On a
chart where `ℐ_Y = (g)` the divisor `E_Z` is generated by `g t`, a nonzerodivisor, so `E_Z` is an
effective Cartier divisor; and it contains the closed subscheme `D(Z ⊆ Y)`, on which `g` vanishes.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.AffineAlgebraEquivalence Stacks.RelativeSpec Stacks.Blowup Stacks.Conormal

universe u

namespace Stacks.Deformation

variable {X : Scheme.{u}} (DY DZ : X.IdealSheafData) [Stacks.Divisors.IsEffectiveCartierDivisor DY]
  (hZY : DY ≤ DZ)

/-- The base map `U_{Z ⊆ X} ⟶ U_{Y ⊆ X}` is an isomorphism. -/
instance isIso_outerBase : IsIso (outerBase DY DZ) := by
  have := Stacks.Divisors.isIso_coborderRange_ι DZ.subschemeι
  have := Stacks.Divisors.isIso_coborderRange_ι DY.subschemeι
  dsimp only [outerBase, coborderMap]
  infer_instance

/-- **The divisor `E_Z = φ⁻¹E` on `D(Z ⊆ X)`.** -/
def nestedDivisor : (deformationSpace (idealZX DZ)).IdealSheafData :=
  (divisorStrict DY).comap (nestedOuterMap DY DZ hZY)

/-- The chart of `D(Z ⊆ X)` over a principal chart of `ℐ_Y`. -/
abbrev Chart.nestedAffine (c : Chart (idealYX DY)) : (deformationSpace (idealZX DZ)).affineOpens :=
  ⟨deformationSpaceToBase (idealZX DZ) ⁻¹ᵁ (outerBase DY DZ ⁻¹ᵁ c.W.1),
    Stacks.RelativeSpec.isAffineOpen_toBase_preimage (extReesSituation (idealZX DZ))
      ⟨outerBase DY DZ ⁻¹ᵁ c.W.1, c.W.2.preimage _⟩⟩

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- The morphism `φ : D(Z ⊆ X) ⟶ D(Y ⊆ X)` lies over the base map `U_{Z ⊆ X} ⟶ U_{Y ⊆ X}`. -/
theorem nestedOuterMap_toBase' :
    nestedOuterMap DY DZ hZY ≫ deformationSpaceToBase (idealYX DY) =
      deformationSpaceToBase (idealZX DZ) ≫ outerBase DY DZ :=
  deformationMap_toBase _ _ _ _

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- The chart of `D(Z ⊆ X)` over `c` lies in the inverse image under `φ` of the chart of
`D(Y ⊆ X)` over `c`. -/
theorem Chart.nestedAffine_le (c : Chart (idealYX DY)) :
    (c.nestedAffine DY DZ).1 ≤ nestedOuterMap DY DZ hZY ⁻¹ᵁ c.toAffine.1 := by
  intro y hy
  change ((nestedOuterMap DY DZ hZY ≫ deformationSpaceToBase (idealYX DY))) y ∈ c.W.1
  rw [nestedOuterMap_toBase']
  exact hy

/-- The generator `g t` of `E_Z` on a chart. -/
def Chart.nestedGen (c : Chart (idealYX DY)) :
    Γ(deformationSpace (idealZX DZ), (c.nestedAffine DY DZ).1) :=
  ((nestedOuterMap DY DZ hZY).appLE _ _ (c.nestedAffine_le DY DZ hZY)).hom c.strictGen

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- The generator `g t` of `E_Z` on a chart is the image in degree `1` of the section `g` of
`ℐ_Y`. -/
theorem Chart.nestedGen_eq (c : Chart (idealYX DY)) :
    c.nestedGen DY DZ hZY = chartIncl (idealZX DZ) 1 (outerBase DY DZ ⁻¹ᵁ c.W.1)
      (extReesPullback (outerBase DY DZ) (idealYX DY) (idealZX DZ) (outer_le DY DZ hZY) 1 c.W.1
        (extReesOfMem (idealYX DY) c.W 1 c.g
          (by rw [pow_one, c.span]; exact Ideal.mem_span_singleton_self _))) :=
  deformationMap_appLE_chartIncl' _ _ _ _ c.W 1 _ _

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- The generator `g t` of `E_Z` on a chart is a nonzerodivisor. -/
theorem Chart.isRegular_nestedGen (c : Chart (idealYX DY)) :
    IsRegular (c.nestedGen DY DZ hZY) := by
  rw [c.nestedGen_eq]
  refine isRegular_chartIncl_of_ambient (idealZX DZ) ⟨outerBase DY DZ ⁻¹ᵁ c.W.1, c.W.2.preimage _⟩
    1 _ ?_
  refine (congrArg _root_.IsRegular ((extReesAmbient_extReesPullback _ _ _ _ 1 c.W.1 _).trans
    (congrArg _ (extReesAmbient_extReesOfMem (idealYX DY) c.W 1 c.g _)))).mpr ?_
  exact isRegular_map_of_bijective _ (ConcreteCategory.bijective_of_isIso _) c.reg

/-- On the chart of `D(Z ⊆ X)` over `c`, the ideal of `E_Z` is generated by `g t`. -/
theorem nestedDivisor_ideal (c : Chart (idealYX DY)) :
    (nestedDivisor DY DZ hZY).ideal (c.nestedAffine DY DZ) =
      Ideal.span {c.nestedGen DY DZ hZY} := by
  refine (Stacks.IdealSheaf.ideal_comap_appLE _ _ c.toAffine _
    (c.nestedAffine_le DY DZ hZY)).trans ?_
  rw [strictDivisor_ideal, Ideal.map_span, Set.image_singleton]
  rfl

/-- Every point of the base `U_{Y ⊆ X}` lies in the affine open of some principal chart of `ℐ_Y`. -/
private theorem exists_chart_mem (x : DY.subschemeι.coborderRange.toScheme) :
    ∃ c : Chart (idealYX DY), x ∈ c.W.1 := by
  obtain ⟨U, hU, hxU, g, hg, hspan⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor _
      (isEffectiveCartierDivisor_coborderIdeal DY) x
  exact ⟨⟨⟨U, hU⟩, g, hg, hspan⟩, hxU⟩

/-- The charts of `D(Z ⊆ X)` over the principal charts of `ℐ_Y` cover `D(Z ⊆ X)`. -/
theorem iSup_nestedAffine_eq_top :
    ⨆ c : Chart (idealYX DY), (c.nestedAffine DY DZ).1 = ⊤ := by
  refine eq_top_iff.2 fun x _ => ?_
  obtain ⟨c, hc⟩ := exists_chart_mem DY ((deformationSpaceToBase (idealZX DZ) ≫ outerBase DY DZ) x)
  exact Opens.mem_iSup.2 ⟨c, hc⟩

/-- **`E_Z` is an effective Cartier divisor.** -/
theorem isEffectiveCartierDivisor_nestedDivisor :
    Stacks.Divisors.IsEffectiveCartierDivisor (nestedDivisor DY DZ hZY) := by
  refine Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen _ fun x => ?_
  obtain ⟨c, hc⟩ := exists_chart_mem DY ((deformationSpaceToBase (idealZX DZ) ≫ outerBase DY DZ) x)
  exact ⟨(c.nestedAffine DY DZ).1, (c.nestedAffine DY DZ).2, hc, _,
    c.isRegular_nestedGen DY DZ hZY, nestedDivisor_ideal DY DZ hZY c⟩

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- `g` vanishes on `Y`: the composite of the two base maps factors through `Y`. -/
theorem innerBase_comp_outerBase :
    innerBase DY DZ hZY ≫ outerBase DY DZ =
      (Scheme.IdealSheafData.inclusion hZY).coborderRange.ι ≫ DY.subschemeι.liftCoborder := by
  refine (cancel_mono DY.subschemeι.coborderRange.ι).1 ?_
  simp only [Category.assoc, coborderMap_ι, Category.comp_id, Scheme.Hom.liftCoborder_ι]

alias nestedOuterMap_toBase := Stacks.Deformation.nestedOuterMap_toBase'

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- The morphism `D(Z ⊆ Y) ⟶ D(Z ⊆ X)` lies over the base map `U_{Z ⊆ Y} ⟶ U_{Z ⊆ X}`. -/
theorem nestedInnerMap_toBase :
    nestedInnerMap DY DZ hZY ≫ deformationSpaceToBase (idealZX DZ) =
      deformationSpaceToBase (idealZY DY DZ hZY) ≫ innerBase DY DZ hZY :=
  deformationMap_toBase _ _ _ _

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- The function `g` vanishes on the base of `D(Z ⊆ Y)`. -/
theorem innerBase_app_outerBase_app_gen (c : Chart (idealYX DY)) :
    ((innerBase DY DZ hZY).app (outerBase DY DZ ⁻¹ᵁ c.W.1)).hom
      (((outerBase DY DZ).app c.W.1).hom c.g) = 0 := by
  have hg : c.g ∈ RingHom.ker (DY.subschemeι.liftCoborder.app c.W.1).hom := by
    rw [← coborderIdeal_ideal, c.span]; exact Ideal.mem_span_singleton_self _
  have hcomp := Scheme.Hom.congr_app (innerBase_comp_outerBase DY DZ hZY) c.W.1
  have e1 : ((innerBase DY DZ hZY ≫ outerBase DY DZ).app c.W.1).hom c.g =
      ((innerBase DY DZ hZY).app _).hom (((outerBase DY DZ).app c.W.1).hom c.g) := by
    rw [Scheme.Hom.comp_app]; rfl
  rw [← e1, hcomp]
  change ((Scheme.IdealSheafData.inclusion hZY).coborderRange.toScheme.presheaf.map _).hom
    (((Scheme.IdealSheafData.inclusion hZY).coborderRange.ι.app _).hom
      ((DY.subschemeι.liftCoborder.app c.W.1).hom c.g)) = 0
  rw [RingHom.mem_ker.1 hg, map_zero, map_zero]

/-- The base of `D(Z ⊆ Y)` over `Y ⊆ X`. -/
abbrev innerToBase : deformationSpace (idealZY DY DZ hZY) ⟶ DY.subschemeι.coborderRange.toScheme :=
  deformationSpaceToBase (idealZY DY DZ hZY) ≫ innerBase DY DZ hZY ≫ outerBase DY DZ

/-- The chart of `D(Z ⊆ Y)` over a principal chart of `ℐ_Y`. -/
abbrev Chart.innerOpen (c : Chart (idealYX DY)) : (deformationSpace (idealZY DY DZ hZY)).Opens :=
  deformationSpaceToBase (idealZY DY DZ hZY) ⁻¹ᵁ (innerBase DY DZ hZY ⁻¹ᵁ
    (outerBase DY DZ ⁻¹ᵁ c.W.1))

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- The chart of `D(Z ⊆ Y)` over `c` lies in the inverse image under `D(Z ⊆ Y) ⟶ D(Z ⊆ X)` of
the chart of `D(Z ⊆ X)` over `c`. -/
theorem innerToBase_preimage_le (c : Chart (idealYX DY)) :
    c.innerOpen DY DZ hZY ≤ nestedInnerMap DY DZ hZY ⁻¹ᵁ (c.nestedAffine DY DZ).1 := by
  intro y hy
  change ((nestedInnerMap DY DZ hZY ≫ deformationSpaceToBase (idealZX DZ))) y ∈
    outerBase DY DZ ⁻¹ᵁ c.W.1
  rw [nestedInnerMap_toBase]
  exact hy

omit [Stacks.Divisors.IsEffectiveCartierDivisor DY] in
/-- **`g t` vanishes on `D(Z ⊆ Y)`.** -/
theorem nestedInnerMap_appLE_nestedGen (c : Chart (idealYX DY)) :
    ((nestedInnerMap DY DZ hZY).appLE _ _ (innerToBase_preimage_le DY DZ hZY c)).hom
      (c.nestedGen DY DZ hZY) = 0 := by
  rw [c.nestedGen_eq]
  have hW : IsAffineOpen (outerBase DY DZ ⁻¹ᵁ c.W.1) := c.W.2.preimage _
  refine (deformationMap_appLE_chartIncl' (innerBase DY DZ hZY) (idealZX DZ)
    (idealZY DY DZ hZY) (inner_le DY DZ hZY) ⟨_, hW⟩ 1 _
    (innerToBase_preimage_le DY DZ hZY c)).trans ?_
  refine chartIncl_eq_zero_of_ambient (idealZY DY DZ hZY) _ 1 _ ?_
  refine (extReesAmbient_extReesPullback _ _ _ _ 1 _ _).trans ?_
  refine (congrArg _ (extReesAmbient_extReesPullback _ _ _ _ 1 c.W.1 _)).trans ?_
  refine (congrArg (fun r => ((innerBase DY DZ hZY).app _).hom (((outerBase DY DZ).app _).hom r))
    (extReesAmbient_extReesOfMem (idealYX DY) c.W 1 c.g _)).trans ?_
  exact innerBase_app_outerBase_app_gen DY DZ hZY c

/-- **`D(Z ⊆ Y)` lies in `E_Z`.** -/
theorem nestedDivisor_le_ker :
    nestedDivisor DY DZ hZY ≤ (nestedInnerMap DY DZ hZY).ker := by
  rw [← Scheme.IdealSheafData.map_bot, Scheme.IdealSheafData.le_map_iff_comap_le]
  have hcover : ⨆ c : Chart (idealYX DY), c.innerOpen DY DZ hZY = ⊤ := by
    refine eq_top_iff.2 fun x _ => ?_
    obtain ⟨c, hc⟩ := exists_chart_mem DY (innerToBase DY DZ hZY x)
    exact Opens.mem_iSup.2 ⟨c, hc⟩
  refine Scheme.IdealSheafData.le_of_iSup_eq_top (fun c : Chart (idealYX DY) =>
    (⟨c.innerOpen DY DZ hZY,
      Stacks.RelativeSpec.isAffineOpen_toBase_preimage (extReesSituation (idealZY DY DZ hZY))
        ⟨innerBase DY DZ hZY ⁻¹ᵁ (outerBase DY DZ ⁻¹ᵁ c.W.1), (c.W.2.preimage _).preimage _⟩⟩ :
      (deformationSpace (idealZY DY DZ hZY)).affineOpens)) hcover fun c => ?_
  rw [Stacks.IdealSheaf.ideal_comap_appLE _ _ (c.nestedAffine DY DZ) _
      (innerToBase_preimage_le DY DZ hZY c), nestedDivisor_ideal, Ideal.map_span,
    Set.image_singleton]
  refine Ideal.span_le.2 ?_
  rintro _ rfl
  exact (congrArg (· ∈ _) (nestedInnerMap_appLE_nestedGen DY DZ hZY c)).mpr (Ideal.zero_mem _)

end Stacks.Deformation

end
