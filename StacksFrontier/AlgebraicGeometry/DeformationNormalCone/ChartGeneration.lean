public import StacksFrontier.AlgebraicGeometry.DeformationNormalCone.BaseIdeal
public import StacksFrontier.AlgebraicGeometry.Morphisms.FiniteType.DimensionFormulaGeneral
public import StacksFrontier.AlgebraicGeometry.Chow.ProperPushforwardChow.Functoriality
public import StacksFrontier.RingTheory.DimensionFormula

/-!
# The charts of the deformation space of a Cartier divisor

Let `ℐ ⊆ 𝒪_U` be the ideal of an effective Cartier divisor and `W ⊆ U` an affine open with
`ℐ(W) = (g)`. Then the ring of functions on the chart `π⁻¹W` of the deformation space is
generated over `Γ(U, W)` by `t⁻¹` and `g t`, whose product is `g`.

Consequently the deformation space is locally of finite type over `U`, and the residue fields of
its points have transcendence degree at most one over those of their images.

## Main results

* `Stacks.Deformation.adjoin_param_gen_eq_top`: the generation statement.
* `Stacks.Deformation.locallyOfFiniteType_deformationSpaceToBase`: the deformation space of a
  locally principal ideal is locally of finite type over the base.
* `Stacks.Deformation.relativeDimension_le_add_one`: `δ(x) ≤ δ(π x) + 1`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.AffineAlgebraEquivalence Stacks.RelativeSpec Stacks.Blowup

universe u

/-! ### Transcendence degree of a ring generated by two elements with product in the base -/

/-- **A ring generated over `A` by two elements whose product comes from `A` has residue field
extensions of transcendence degree at most one.** -/
theorem trdeg_residueField_le_one_of_adjoin {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    (a c : B) (hgen : Algebra.adjoin A {a, c} = ⊤) (r : A) (hr : a * c = algebraMap A B r)
    (p : Ideal A) (q : Ideal B) [p.IsPrime] [q.IsPrime] [q.LiesOver p] :
    letI := Ideal.ResidueField.algebraOfLiesOver p q
    Algebra.trdeg p.ResidueField q.ResidueField ≤ 1 := by
  let := Ideal.ResidueField.algebraOfLiesOver p q
  set K := p.ResidueField
  set L := q.ResidueField
  set φ : B →+* L := algebraMap B L
  have hcomp : ∀ x : A, φ (algebraMap A B x) = algebraMap K L (algebraMap A K x) := fun x =>
    (Ideal.ResidueField.map_algebraMap p q (algebraMap A B) Ideal.LiesOver.over x).symm
  have key : ∀ e : L, (∀ b : B, IsAlgebraic (Algebra.adjoin K {e}) (φ b)) →
      Algebra.trdeg K L ≤ 1 := by
    intro e he
    set S := Algebra.adjoin K {e}
    have hall : Algebra.IsAlgebraic S L := by
      refine ⟨fun x => ?_⟩
      obtain ⟨r₀, s₀, hs₀, rfl⟩ := IsFractionRing.div_surjective (A := B ⧸ q) x
      obtain ⟨r', rfl⟩ := Ideal.Quotient.mk_surjective r₀
      obtain ⟨s', rfl⟩ := Ideal.Quotient.mk_surjective s₀
      have h1 : algebraMap (B ⧸ q) L (Ideal.Quotient.mk q r') = φ r' :=
        Ideal.algebraMap_quotient_residueField_mk q r'
      have h2 : algebraMap (B ⧸ q) L (Ideal.Quotient.mk q s') = φ s' :=
        Ideal.algebraMap_quotient_residueField_mk q s'
      rw [h1, h2, div_eq_mul_inv]
      exact (Subalgebra.algebraicClosure S L).mul_mem (he r') (he s').inv
    calc Algebra.trdeg K L ≤ Cardinal.mk ({e} : Set L) :=
          Algebra.IsAlgebraic.trdeg_le_cardinalMk K {e}
      _ = 1 := Cardinal.mk_singleton e
  have hinS : ∀ e : L, IsAlgebraic (Algebra.adjoin K {e}) e := fun e =>
    isAlgebraic_algebraMap (⟨e, Algebra.self_mem_adjoin_singleton K e⟩ : Algebra.adjoin K {e})
  have hbase : ∀ (e : L) (y : K), IsAlgebraic (Algebra.adjoin K {e}) (algebraMap K L y) :=
    fun e y => isAlgebraic_algebraMap (algebraMap K (Algebra.adjoin K {e}) y)
  have hind : ∀ (e : L), IsAlgebraic (Algebra.adjoin K {e}) (φ a) →
      IsAlgebraic (Algebra.adjoin K {e}) (φ c) →
      ∀ b : B, IsAlgebraic (Algebra.adjoin K {e}) (φ b) := by
    intro e ha hc b
    have hb : b ∈ Algebra.adjoin A {a, c} := hgen ▸ Algebra.mem_top
    induction hb using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · exact ha
      · exact hc
    | algebraMap x => rw [hcomp]; exact hbase e _
    | add x y _ _ hx hy =>
      rw [map_add]
      exact (Subalgebra.algebraicClosure _ L).add_mem hx hy
    | mul x y _ _ hx hy =>
      rw [map_mul]
      exact (Subalgebra.algebraicClosure _ L).mul_mem hx hy
  by_cases ha : φ a = 0
  · refine key (φ c) (hind _ ?_ (hinS _))
    rw [ha]; exact isAlgebraic_zero
  · refine key (φ a) (hind _ (hinS _) ?_)
    have hcval : φ c = (φ a)⁻¹ * algebraMap K L (algebraMap A K r) := by
      rw [← hcomp, ← hr, map_mul, ← mul_assoc, inv_mul_cancel₀ ha, one_mul]
    rw [hcval]
    exact (Subalgebra.algebraicClosure _ L).mul_mem (hinS _).inv (hbase _ _)

namespace Stacks.Deformation

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- A homogeneous section of any degree `k` over an affine open, from an element of
`ℐ(W)^{max(k,0)}`. -/
def extReesOfMemZ (W : X.affineOpens) (k : ℤ) (g : Γ(X, W.1)) (hg : g ∈ I.ideal W ^ k.toNat) :
    ((extReesGradedAlgebra I).piece k).val.obj (op W.1) :=
  (reesPieceAffineEquiv I (k.toNat : ℤ) (Int.natCast_nonneg _) W).symm
    ⟨g, by rw [Int.toNat_natCast]; exact hg⟩

/-- The element of `Γ(X, W)` underlying `extReesOfMemZ I W k g hg` is `g`. -/
theorem extReesAmbient_extReesOfMemZ (W : X.affineOpens) (k : ℤ) (g : Γ(X, W.1))
    (hg : g ∈ I.ideal W ^ k.toNat) :
    extReesAmbient I k W.1 (extReesOfMemZ I W k g hg) = g := by
  have := reesPieceAffineEquiv_coe I (k.toNat : ℤ) (Int.natCast_nonneg _) W
    (extReesOfMemZ I W k g hg)
  refine this.symm.trans ?_
  simp only [extReesOfMemZ, AddEquiv.apply_symm_apply]

/-- The image of a function on the base, on a chart, in the algebra structure given by `π`. -/
theorem toBase_appLE_eq_chartIncl (W : X.affineOpens) (r : Γ(X, W.1)) :
    ((deformationSpaceToBase I).appLE W.1 (deformationSpaceToBase I ⁻¹ᵁ W.1) le_rfl).hom r =
      chartIncl I 0 W.1 (extReesOfMem I W 0 r (by simp)) :=
  (congrArg (fun q : Γ(X, W.1) ⟶ Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ W.1) =>
    q.hom r) (Scheme.Hom.app_eq_appLE (deformationSpaceToBase I))).symm.trans
    (deformationSpaceToBase_app_eq_chartIncl I W r)

/-- The `n`-th power of the image on a chart of a homogeneous section `y` of degree `k` is the
image of a homogeneous section of degree `n * k` whose underlying element is the `n`-th power of
that of `y`. -/
theorem pow_chartIncl_eq (W : X.affineOpens) (k : ℤ) (y : ((extReesGradedAlgebra I).piece k).val.obj
    (op W.1)) (n : ℕ) :
    ∃ z : ((extReesGradedAlgebra I).piece ((n : ℤ) * k)).val.obj (op W.1),
      chartIncl I k W.1 y ^ n = chartIncl I ((n : ℤ) * k) W.1 z ∧
        extReesAmbient I ((n : ℤ) * k) W.1 z = extReesAmbient I k W.1 y ^ n := by
  induction n with
  | zero =>
    refine ⟨extReesOfMemZ I W _ 1 (by simp), ?_, ?_⟩
    · rw [pow_zero]
      refine Eq.trans ?_ (chartIncl_congr I (by simp) W.1 (extReesOfMem I W 0 1 (by simp)) _ ?_)
      · exact (map_one _).symm.trans (toBase_appLE_eq_chartIncl I W 1)
      · exact (extReesAmbient_extReesOfMem I W 0 1 _).trans
          (extReesAmbient_extReesOfMemZ I W _ 1 _).symm
    · rw [extReesAmbient_extReesOfMemZ, pow_zero]
  | succ n ih =>
    obtain ⟨z, hz, hza⟩ := ih
    have hd : (n : ℤ) * k + k = ((n + 1 : ℕ) : ℤ) * k := by push_cast; ring
    refine ⟨cast (congrArg (fun d => ↥((extReesPiece I d).val.obj (op W.1))) hd)
      ((extReesMul I ((n : ℤ) * k) k).app (op W.1) z y), ?_, ?_⟩
    · rw [pow_succ, hz, chartIncl_mul]
      refine chartIncl_congr I hd W.1 _ _ ?_
      exact (extReesAmbient_cast I hd W.1 _).symm
    · refine (extReesAmbient_cast I hd W.1 _).trans ?_
      refine (extReesAmbient_extReesMul I _ k W.1 z y).trans ?_
      rw [hza, pow_succ]

/-- A generator `g` of `ℐ(W)` lies in `ℐ(W) ^ 1`. -/
private theorem mem_ideal_pow_one_of_eq_span (W : X.affineOpens) {g : Γ(X, W.1)}
    (hspan : I.ideal W = Ideal.span {g}) : g ∈ I.ideal W ^ 1 := by
  rw [pow_one, hspan]; exact Ideal.mem_span_singleton_self _

/-- A homogeneous section `x` of degree `n * k` whose underlying element is `r` times the `n`-th
power of that of `y` has image `π^♯(r)` times the `n`-th power of that of `y`. -/
private theorem chartIncl_eq_appLE_mul_pow (W : X.affineOpens) {k d : ℤ} (n : ℕ)
    (hd : d = (n : ℤ) * k) (x : ((extReesGradedAlgebra I).piece d).val.obj (op W.1))
    (y : ((extReesGradedAlgebra I).piece k).val.obj (op W.1)) (r : Γ(X, W.1))
    (hxr : extReesAmbient I d W.1 x = r * extReesAmbient I k W.1 y ^ n) :
    chartIncl I d W.1 x =
      ((deformationSpaceToBase I).appLE W.1 (deformationSpaceToBase I ⁻¹ᵁ W.1) le_rfl).hom r *
        chartIncl I k W.1 y ^ n := by
  obtain ⟨z, hz, hza⟩ := pow_chartIncl_eq I W k y n
  rw [hz, toBase_appLE_eq_chartIncl, chartIncl_mul]
  refine chartIncl_congr I (by rw [zero_add, hd]) W.1 _ _ ?_
  refine Eq.trans ?_ (extReesAmbient_extReesMul I 0 _ W.1 _ z).symm
  refine Eq.trans ?_ (congrArg₂ (· * ·) (extReesAmbient_extReesOfMem I W 0 _ _).symm hza.symm)
  exact hxr

/-- **On a principal chart, the functions on `π⁻¹W` are generated over `Γ(U, W)` by `t⁻¹` and
`g t`.** -/
theorem adjoin_param_gen_eq_top (W : X.affineOpens) (g : Γ(X, W.1))
    (hspan : I.ideal W = Ideal.span {g}) :
    letI : Algebra Γ(X, W.1) Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ W.1) :=
      ((deformationSpaceToBase I).appLE W.1 (deformationSpaceToBase I ⁻¹ᵁ W.1) le_rfl).hom.toAlgebra
    Algebra.adjoin Γ(X, W.1) {paramChartOf I W.1, chartIncl I 1 W.1
      (extReesOfMem I W 1 g (by rw [pow_one, hspan]; exact Ideal.mem_span_singleton_self _))} =
        ⊤ := by
  let : Algebra Γ(X, W.1) Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ W.1) :=
    ((deformationSpaceToBase I).appLE W.1 (deformationSpaceToBase I ⁻¹ᵁ W.1) le_rfl).hom.toAlgebra
  have hg := mem_ideal_pow_one_of_eq_span I W hspan
  set S := Algebra.adjoin Γ(X, W.1)
    {paramChartOf I W.1, chartIncl I 1 W.1 (extReesOfMem I W 1 g hg)}
  have hs : paramChartOf I W.1 ∈ S := Algebra.subset_adjoin (Set.mem_insert _ _)
  have hu : chartIncl I 1 W.1 (extReesOfMem I W 1 g hg) ∈ S :=
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ rfl)
  suffices hall : ∀ y, y ∈ S from eq_top_iff.2 fun y _ => hall y
  intro y
  induction y using chartIncl_induction I W with
  | h0 => exact S.zero_mem
  | hadd a b ha hb => exact S.add_mem ha hb
  | hincl k x =>
    rcases lt_or_ge k 0 with hk | hk
    · -- negative degree: `x = π^♯(x) · (t⁻¹)^{-k}`
      have := chartIncl_eq_appLE_mul_pow I W (-k).toNat (by omega) x (paramPiece I W.1)
        (extReesAmbient I k W.1 x) (by rw [extReesAmbient_paramPiece, one_pow, mul_one])
      rw [← paramChartOf_eq_chartIncl] at this
      rw [this]
      exact S.mul_mem (S.algebraMap_mem _) (S.pow_mem hs _)
    · -- nonnegative degree: `x = π^♯(r) · (g t)^k` with `x = r gᵏ`
      obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hk
      have hmem := reesPieceAmbient_mem_affine I (n : ℤ) (Int.natCast_nonneg n) W x
      rw [Int.toNat_natCast, hspan, Ideal.span_singleton_pow] at hmem
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.1 hmem
      have := chartIncl_eq_appLE_mul_pow I W n (by ring) x (extReesOfMem I W 1 g hg) r
        (by rw [extReesAmbient_extReesOfMem]; exact hr.symm)
      rw [this]
      exact S.mul_mem (S.algebraMap_mem _) (S.pow_mem hu _)

/-- `t⁻¹ · (g t) = g` on a principal chart, in the algebra structure given by `π`. -/
theorem param_mul_gen_eq_algebraMap (W : X.affineOpens) (g : Γ(X, W.1))
    (hspan : I.ideal W = Ideal.span {g}) :
    paramChartOf I W.1 * chartIncl I 1 W.1
      (extReesOfMem I W 1 g (by rw [pow_one, hspan]; exact Ideal.mem_span_singleton_self _)) =
      ((deformationSpaceToBase I).appLE W.1 (deformationSpaceToBase I ⁻¹ᵁ W.1) le_rfl).hom g :=
  ((congrArg (fun q : Γ(X, W.1) ⟶ Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ W.1) =>
    q.hom g) (Scheme.Hom.app_eq_appLE (deformationSpaceToBase I))).symm.trans
    (deformationSpaceToBase_app_eq_param_mul I W g
      (by rw [hspan]; exact Ideal.mem_span_singleton_self _))).symm

/-- Every point of the base lies on a principal chart of `ℐ`. -/
abbrev IsLocallyPrincipalIdeal : Prop :=
  ∀ y : X, ∃ (W : X.affineOpens) (g : Γ(X, W.1)), y ∈ W.1 ∧ I.ideal W = Ideal.span {g}

variable {I}

/-- **The deformation space of a locally principal ideal is locally of finite type.** -/
theorem locallyOfFiniteType_deformationSpaceToBase (hI : IsLocallyPrincipalIdeal I) :
    LocallyOfFiniteType (deformationSpaceToBase I) := by
  classical
  refine (HasRingHomProperty.iff_exists_appLE (P := @LocallyOfFiniteType)
    (RingHom.finiteType_stableUnderComposition.stableUnderCompositionWithLocalizationAway
      RingHom.finiteType_holdsForLocalizationAway).left).2 fun x => ?_
  obtain ⟨W, g, hxW, hspan⟩ := hI (deformationSpaceToBase I x)
  refine ⟨W, ⟨deformationSpaceToBase I ⁻¹ᵁ W.1,
    Stacks.RelativeSpec.isAffineOpen_toBase_preimage (extReesSituation I) W⟩, hxW, le_rfl, ?_⟩
  let : Algebra Γ(X, W.1) Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ W.1) :=
    ((deformationSpaceToBase I).appLE W.1 (deformationSpaceToBase I ⁻¹ᵁ W.1) le_rfl).hom.toAlgebra
  exact ⟨⟨{paramChartOf I W.1, chartIncl I 1 W.1
    (extReesOfMem I W 1 g (mem_ideal_pow_one_of_eq_span I W hspan))}, by
      rw [Finset.coe_pair]; exact adjoin_param_gen_eq_top I W g hspan⟩⟩

/-- **The residue fields of the deformation space have transcendence degree at most one over
those of the base.** -/
theorem residueTrdeg_le_one (hI : IsLocallyPrincipalIdeal I) (x : deformationSpace I) :
    Stacks.Chow.residueTrdeg (deformationSpaceToBase I) x ≤ 1 := by
  obtain ⟨W, g, hxW, hspan⟩ := hI (deformationSpaceToBase I x)
  have hV : IsAffineOpen (deformationSpaceToBase I ⁻¹ᵁ W.1) :=
    Stacks.RelativeSpec.isAffineOpen_toBase_preimage (extReesSituation I) W
  have h := AlgebraicGeometry.toNat_trdeg_residueField_eq_affine (deformationSpaceToBase I) W.1
    W.2 (deformationSpaceToBase I ⁻¹ᵁ W.1) hV le_rfl x hxW
  unfold Stacks.Chow.residueTrdeg
  rw [← h]
  let : Algebra Γ(X, W.1) Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ W.1) :=
    ((deformationSpaceToBase I).appLE W.1 (deformationSpaceToBase I ⁻¹ᵁ W.1) le_rfl).hom.toAlgebra
  let : (hV.primeIdealOf ⟨x, hxW⟩).asIdeal.LiesOver
      (W.2.primeIdealOf ⟨deformationSpaceToBase I x, hxW⟩).asIdeal :=
    ⟨congr($(IsAffineOpen.comap_primeIdealOf_appLE W.1 W.2 _ hV le_rfl hxW).1).symm⟩
  exact trdeg_residueField_le_one_of_adjoin _ _ (adjoin_param_gen_eq_top I W g hspan) g
    (param_mul_gen_eq_algebraMap I W g hspan) _ _

/-- **`δ(x) ≤ δ(π x) + 1` on the deformation space.** -/
theorem relativeDimension_le_add_one (hI : IsLocallyPrincipalIdeal I) {S : Scheme.{u}}
    (δ : TopologicalSpace.DimensionFunction S) (s : X ⟶ S) [LocallyOfFiniteType s]
    (x : deformationSpace I) :
    haveI := locallyOfFiniteType_deformationSpaceToBase hI
    Stacks.Chow.relativeDimension δ (deformationSpaceToBase I ≫ s) x ≤
      Stacks.Chow.relativeDimension δ s (deformationSpaceToBase I x) + 1 := by
  have := locallyOfFiniteType_deformationSpaceToBase hI
  rw [Stacks.Chow.relativeDimension_comp_eq_add_trdeg]
  have h := residueTrdeg_le_one hI x
  have hfin := Stacks.Chow.residueTrdeg_lt_aleph0 (deformationSpaceToBase I) x
  have : Cardinal.toNat (Stacks.Chow.residueTrdeg (deformationSpaceToBase I) x) ≤ 1 := by
    have := Cardinal.toNat_le_toNat h Cardinal.one_lt_aleph0
    simpa using this
  omega

end Stacks.Deformation

namespace Stacks.Deformation

variable {X : Scheme.{u}} {I : X.IdealSheafData}

/-- **The deformation space of a locally principal ideal has δ-dimension at most one more than
the base.** -/
theorem schemeDeltaDimension_deformationSpace_le (hI : IsLocallyPrincipalIdeal I)
    (C : Stacks.Chow.ChowSituation.{u}) (s : X ⟶ C.S) [LocallyOfFiniteType s] {m : ℤ}
    (hm : Stacks.Chow.schemeDeltaDimension C s ≤ (m : EInt)) :
    haveI := locallyOfFiniteType_deformationSpaceToBase hI
    Stacks.Chow.schemeDeltaDimension C (deformationSpaceToBase I ≫ s) ≤ ((m + 1 : ℤ) : EInt) := by
  have := locallyOfFiniteType_deformationSpaceToBase hI
  have h := Stacks.Chow.schemeDeltaDimension_le_of_forall_relativeDimension_le C
    (deformationSpaceToBase I ≫ s) (𝟙 _) (k := m + 1) fun x => by
      refine (relativeDimension_le_add_one hI C.dimensionFunction s x).trans ?_
      have := Stacks.Chow.relativeDimension_le_of_schemeDeltaDimension_le' C s hm
        (deformationSpaceToBase I x)
      omega
  simpa using h

/-- An ideal pulled back along an affine morphism from a locally principal ideal is locally
principal. -/
theorem isLocallyPrincipalIdeal_comap {Y : Scheme.{u}} (hI : IsLocallyPrincipalIdeal I)
    (h : Y ⟶ X) [IsAffineHom h] : IsLocallyPrincipalIdeal (I.comap h) := by
  intro y
  obtain ⟨W, g, hyW, hspan⟩ := hI (h y)
  refine ⟨⟨h ⁻¹ᵁ W.1, W.2.preimage h⟩, (h.app W.1).hom g, hyW, ?_⟩
  rw [Stacks.IdealSheaf.ideal_comap_appLE _ _ W ⟨h ⁻¹ᵁ W.1, W.2.preimage h⟩ le_rfl, hspan,
    Ideal.map_span, Set.image_singleton, ← Scheme.Hom.app_eq_appLE]

/-- An effective Cartier divisor is locally principal. -/
theorem isLocallyPrincipalIdeal_of_isEffectiveCartierDivisor
    (hI : Stacks.Divisors.IsEffectiveCartierDivisor I) : IsLocallyPrincipalIdeal I := by
  intro y
  obtain ⟨U, hU, hyU, g, -, hspan⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor I hI y
  exact ⟨⟨U, hU⟩, g, hyU, hspan⟩

end Stacks.Deformation

end
