module

public import StacksFrontier.AlgebraicGeometry.Limits.DescendingMorphisms.Flat
public import StacksFrontier.AlgebraicGeometry.Morphisms.FiniteLocallyFreeOfRank

/-!
# Finite locally free morphisms in a cofiltered limit of schemes

Let `D` be a cofiltered diagram of schemes and let `f₀` be a morphism over a stage `i₀` which is
locally of finite presentation. If the base change of `f₀` to the limit is finite locally free,
then so is its base change to some later stage. This is proved here for an essentially small index
with affine transition morphisms and quasi-compact quasi-separated stages, taking as hypotheses
that a morphism of schemes is finite locally free exactly when it is finite, flat and locally of
finite presentation, and that the base change of `f₀` is finite at some stage.

## Main results

* `AlgebraicGeometry.exists_isFiniteLocallyFree_baseChange`: for an arbitrary cofiltered
  diagram, if the base change of `f₀` is flat at some stage and finite at some stage, then it is
  finite locally free at some stage, given the characterization of finite locally free morphisms
  above.
* `AlgebraicGeometry.exists_isFiniteLocallyFree_baseChange_of_limitBaseChange`: if the base
  change of `f₀` to the limit is finite locally free, then so is its base change to some stage,
  given the characterization of finite locally free morphisms and finiteness at some stage.

## Implementation notes

The index carries the hypothesis `CategoryTheory.EssentiallySmall` in the universe of the
schemes, with the index object and morphism universes otherwise free. Without any smallness
condition the statement is false: for a field `F` that is not `u`-small, the diagram on
`(Finset F)ᵒᵖ` sending `T` to the spectrum of a `u`-small copy of the subring of `F` generated by
`T` has the empty scheme as a limit, and the base change of the affine line over the stage at `∅`
is finite locally free at the limit but not finite at any stage.

## References

* [Stacks Project, Tag 06AC](https://stacks.math.columbia.edu/tag/06AC)
* [Stacks Project, Tag 081D](https://stacks.math.columbia.edu/tag/081D)
* [Stacks Project, Tag 02KA](https://stacks.math.columbia.edu/tag/02KA)
* [Stacks Project, Tag 02KB](https://stacks.math.columbia.edu/tag/02KB)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe w v u

namespace AlgebraicGeometry

/-- Two properties of morphisms of schemes, each stable under base change and each holding for
the base change of `f₀` to some stage over `i₀`, hold together for the base change of `f₀` to a
single stage over `i₀`. -/
private theorem exists_common_stage_of_two_props {I : Type v} [Category.{w} I] [IsCofiltered I]
    (D : I ⥤ Scheme.{u}) {i₀ : I} {X₀ Y₀ : Over (D.obj i₀)} (f₀ : X₀ ⟶ Y₀)
    (P Q : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] [Q.IsStableUnderBaseChange]
    (hP : ∃ (i : I) (g : i ⟶ i₀), P ((Over.pullback (D.map g)).map f₀).left)
    (hQ : ∃ (i : I) (g : i ⟶ i₀), Q ((Over.pullback (D.map g)).map f₀).left) :
    ∃ (i : I) (g : i ⟶ i₀), P ((Over.pullback (D.map g)).map f₀).left ∧
      Q ((Over.pullback (D.map g)).map f₀).left := by
  obtain ⟨i₁, g₁, hP⟩ := hP
  obtain ⟨i₂, g₂, hQ⟩ := hQ
  refine ⟨(IsCofiltered.min (Over.mk g₁) (Over.mk g₂)).left,
    (IsCofiltered.min (Over.mk g₁) (Over.mk g₂)).hom, ?_, ?_⟩
  · rw [← Over.w (IsCofiltered.minToLeft (Over.mk g₁) (Over.mk g₂)), D.map_comp]
    exact overPullback_map_comp P (D.map g₁) _ f₀ hP
  · rw [← Over.w (IsCofiltered.minToRight (Over.mk g₁) (Over.mk g₂)), D.map_comp]
    exact overPullback_map_comp Q (D.map g₂) _ f₀ hQ

/-- Let `D` be a cofiltered diagram of schemes and let `f₀` be a morphism over the stage `i₀`
which is locally of finite presentation. Assume that a morphism of schemes is finite locally free
if and only if it is finite, flat and locally of finite presentation (`h02KB`), and that the base
change of `f₀` is flat at some stage (`h04AI`) and finite at some stage (`h01ZO`). Then the base
change of `f₀` is finite locally free at some stage. -/
theorem exists_isFiniteLocallyFree_baseChange
    {I : Type v} [Category.{w} I] [IsCofiltered I]
    (D : I ⥤ Scheme.{u}) {i₀ : I} {X₀ Y₀ : Over (D.obj i₀)} (f₀ : X₀ ⟶ Y₀)
    [LocallyOfFinitePresentation f₀.left]
    (h02KB : ∀ {A B : Scheme.{u}} (p : A ⟶ B), Stacks.Morphisms.IsFiniteLocallyFree p ↔
      IsFinite p ∧ Flat p ∧ LocallyOfFinitePresentation p)
    (h04AI : ∃ (i : I) (g : i ⟶ i₀), Flat ((Over.pullback (D.map g)).map f₀).left)
    (h01ZO : ∃ (i : I) (g : i ⟶ i₀), IsFinite ((Over.pullback (D.map g)).map f₀).left) :
    ∃ (i : I) (g : i ⟶ i₀),
      Stacks.Morphisms.IsFiniteLocallyFree ((Over.pullback (D.map g)).map f₀).left := by
  obtain ⟨i, g, hfin, hfl⟩ :=
    exists_common_stage_of_two_props D f₀ (@IsFinite) (@Flat) h01ZO h04AI
  exact ⟨i, g, (h02KB _).2 ⟨hfin, hfl,
    MorphismProperty.overPullbackMap (P := @LocallyOfFinitePresentation) _ _ ‹_›⟩⟩

/-- Let `D` be a cofiltered diagram of schemes with affine transition morphisms, essentially small
in the universe of the schemes, with limit cone `c`, and let `f₀` be a morphism over the stage
`i₀` which is locally of finite presentation, where `D.obj i₀` and the source and target of `f₀`
are quasi-compact and quasi-separated. Assume that a morphism of schemes is finite locally free if
and only if it is finite, flat and locally of finite presentation (`h02KB`), and that the base
change of `f₀` is finite at some stage (`h01ZO`). If the base change of `f₀` to the limit is
finite locally free, then so is its base change to some stage. -/
theorem exists_isFiniteLocallyFree_baseChange_of_limitBaseChange
    {I : Type v} [Category.{w} I] [EssentiallySmall.{u} I]
    (D : I ⥤ Scheme.{u}) (c : Cone D) (i₀ : I)
    (X₀ Y₀ : Over (D.obj i₀)) (f₀ : X₀ ⟶ Y₀)
    [IsCofiltered I]
    [∀ {i j : I} (g : i ⟶ j), IsAffineHom (D.map g)]
    [CompactSpace (D.obj i₀)] [QuasiSeparatedSpace (D.obj i₀)]
    [CompactSpace X₀.left] [QuasiSeparatedSpace X₀.left]
    [CompactSpace Y₀.left] [QuasiSeparatedSpace Y₀.left]
    [LocallyOfFinitePresentation f₀.left]
    (hc : IsLimit c)
    [Stacks.Morphisms.IsFiniteLocallyFree ((Over.pullback (c.π.app i₀)).map f₀).left]
    (h02KB : ∀ {A B : Scheme.{u}} (p : A ⟶ B), Stacks.Morphisms.IsFiniteLocallyFree p ↔
      IsFinite p ∧ Flat p ∧ LocallyOfFinitePresentation p)
    (h01ZO : ∃ (i : I) (g : i ⟶ i₀), IsFinite ((Over.pullback (D.map g)).map f₀).left) :
    ∃ (i : I) (g : i ⟶ i₀),
      Stacks.Morphisms.IsFiniteLocallyFree ((Over.pullback (D.map g)).map f₀).left := by
  have hflat : Flat ((Over.pullback (c.π.app i₀)).map f₀).left := ((h02KB _).1 ‹_›).2.1
  exact exists_isFiniteLocallyFree_baseChange D f₀ h02KB
    (exists_flat_baseChange_of_limitBaseChange D c i₀ X₀ Y₀ f₀ hc) h01ZO

/-- `AlgebraicGeometry.exists_isFiniteLocallyFree_baseChange_of_limitBaseChange` for an index
category whose objects and morphisms lie in the same universe. -/
example
    {I : Type v} [Category.{v} I] [EssentiallySmall.{u} I]
    (D : I ⥤ Scheme.{u}) (c : Cone D) (i₀ : I)
    (X₀ Y₀ : Over (D.obj i₀)) (f₀ : X₀ ⟶ Y₀)
    [IsCofiltered I]
    [∀ {i j : I} (g : i ⟶ j), IsAffineHom (D.map g)]
    [CompactSpace (D.obj i₀)] [QuasiSeparatedSpace (D.obj i₀)]
    [CompactSpace X₀.left] [QuasiSeparatedSpace X₀.left]
    [CompactSpace Y₀.left] [QuasiSeparatedSpace Y₀.left]
    [LocallyOfFinitePresentation f₀.left]
    (hc : IsLimit c)
    [Stacks.Morphisms.IsFiniteLocallyFree ((Over.pullback (c.π.app i₀)).map f₀).left]
    (h02KB : ∀ {A B : Scheme.{u}} (p : A ⟶ B), Stacks.Morphisms.IsFiniteLocallyFree p ↔
      IsFinite p ∧ Flat p ∧ LocallyOfFinitePresentation p)
    (h01ZO : ∃ (i : I) (g : i ⟶ i₀), IsFinite ((Over.pullback (D.map g)).map f₀).left) :
    ∃ (i : I) (g : i ⟶ i₀),
      Stacks.Morphisms.IsFiniteLocallyFree ((Over.pullback (D.map g)).map f₀).left :=
  exists_isFiniteLocallyFree_baseChange_of_limitBaseChange D c i₀ X₀ Y₀ f₀ hc h02KB h01ZO

end AlgebraicGeometry

end
