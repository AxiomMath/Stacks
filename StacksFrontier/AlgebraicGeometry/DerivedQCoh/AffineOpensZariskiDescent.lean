-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace AlgebraicGeometry

variable {X : Scheme.{u}} {U : X.Opens}

/-! ### The two ring-theoretic inputs -/

/-- **The intersection of two basic opens of an affine open is a pushout on rings.** For
`a b : Γ(X, U)` with `U` affine, the square of restriction maps

`Γ(X, U) ⟶ Γ(X, D(a))`, `Γ(X, U) ⟶ Γ(X, D(b))`, `Γ(X, D(a)) ⟶ Γ(X, D(a) ⊓ D(b))`,
`Γ(X, D(b)) ⟶ Γ(X, D(a) ⊓ D(b))`

is a pushout in `CommRingCat`, the intersection being presented as the basic open of the
restriction `ab` of `a` to `D(b)`.

Both vertical maps are localizations away from one element — `Γ(X, D(a))` away from `a` and
`Γ(X, D(a) ⊓ D(b))` away from the image of `a` — by
`AlgebraicGeometry.IsAffineOpen.isLocalization_basicOpen`, so this is
`CategoryTheory.CommRingCat.isPushout_of_isLocalization`. -/
theorem isPushout_presheaf_map_basicOpen (hU : IsAffineOpen U) (a b : Γ(X, U))
    (ab : Γ(X, X.basicOpen b)) (hab : ab = X.presheaf.map (homOfLE (X.basicOpen_le b)).op a)
    (h1 : X.basicOpen ab ≤ X.basicOpen a) :
    IsPushout (X.presheaf.map (homOfLE (X.basicOpen_le a)).op)
      (X.presheaf.map (homOfLE (X.basicOpen_le b)).op)
      (X.presheaf.map (homOfLE h1).op)
      (X.presheaf.map (homOfLE (X.basicOpen_le ab)).op) := by
  have := hU.isLocalization_basicOpen a
  have := (hU.basicOpen b).isLocalization_basicOpen ab
  have hmap : (Submonoid.powers a).map (X.presheaf.map (homOfLE (X.basicOpen_le b)).op).hom =
      Submonoid.powers ab := hab ▸ Submonoid.map_powers _ _
  have hloc : IsLocalization ((Submonoid.powers a).map
      (X.presheaf.map (homOfLE (X.basicOpen_le b)).op).hom) Γ(X, X.basicOpen ab) := by
    rw [hmap]; infer_instance
  refine (CommRingCat.isPushout_of_isLocalization
    (X.presheaf.map (homOfLE (X.basicOpen_le b)).op).hom
    (X.presheaf.map (homOfLE h1).op).hom ?_ (Submonoid.powers a)).flip
  ext x
  show (X.presheaf.map (homOfLE (X.basicOpen_le a)).op ≫ X.presheaf.map (homOfLE h1).op).hom x =
    (X.presheaf.map (homOfLE (X.basicOpen_le b)).op ≫
      X.presheaf.map (homOfLE (X.basicOpen_le ab)).op).hom x
  rw [← X.presheaf.map_comp, ← X.presheaf.map_comp]
  rfl

/-- **A family of basic opens generating the unit ideal is faithfully flat on sections.** For `U`
an affine open of `X` and a finite family `g` of sections over `U` with
`Ideal.span (Set.range g) = ⊤`, the product of the restriction maps
`Γ(X, U) ⟶ Γ(X, X.basicOpen (g i))` is faithfully flat.

Each factor is a localization away from one element, hence flat, and the product is surjective on
spectra: a prime of `Γ(X, U)` cannot contain every `g i`, and the image of the spectrum of a
localization away from `g i` is the basic open of `g i`. -/
theorem faithfullyFlat_pi_presheaf_map_basicOpen (hU : IsAffineOpen U) {I : Type*} [Finite I]
    (g : I → Γ(X, U)) (hg : Ideal.span (Set.range g) = ⊤) :
    (RingHom.pi
      (fun i ↦ (X.presheaf.map (homOfLE (X.basicOpen_le (g i))).op).hom)).FaithfullyFlat := by
  refine RingHom.FaithfullyFlat.pi _ (fun i ↦ ?_) (fun p ↦ ?_)
  · have := hU.isLocalization_basicOpen (g i)
    exact RingHom.flat_algebraMap_iff.mpr (IsLocalization.flat _ (Submonoid.powers (g i)))
  · have hex : ∃ i, g i ∉ p.asIdeal := by
      by_contra h
      simp only [not_exists, not_not] at h
      refine p.2.ne_top (top_le_iff.mp ?_)
      rw [← hg, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact h i
    obtain ⟨i, hi⟩ := hex
    have := hU.isLocalization_basicOpen (g i)
    have hr := PrimeSpectrum.localization_away_comap_range Γ(X, X.basicOpen (g i)) (g i)
    obtain ⟨q, hq⟩ := hr.ge (show p ∈ PrimeSpectrum.basicOpen (g i) from hi)
    exact ⟨i, q, hq⟩

/-! ### Sieves on the poset of affine opens -/

/-- **The sieve generated by a family of affine opens contained in `U` is "being contained in one
of them".** In the poset `X.affineOpens` an arrow is an inclusion and any two arrows with the
same source and target are equal, so a factorization through a member of the family is exactly an
inclusion into it. -/
theorem Scheme.mem_generate_ofArrows_affineOpens_iff (U : X.affineOpens)
    {I : Type*} (V : I → X.affineOpens) (h : ∀ i, V i ≤ U)
    {W : X.affineOpens} (k : W ⟶ U) :
    (Sieve.generate (Presieve.ofArrows V (fun i ↦ homOfLE (h i)))).arrows k ↔
      ∃ i, (W : X.Opens) ≤ (V i : X.Opens) := by
  constructor
  · rintro ⟨Z, p, q, hq, -⟩
    cases hq with
    | mk i => exact ⟨i, leOfHom p⟩
  · rintro ⟨i, hi⟩
    exact ⟨V i, homOfLE hi, homOfLE (h i), Presieve.ofArrows.mk i, Subsingleton.elim _ _⟩

/-- **A Zariski covering sieve of an affine open is refined by a finite family of basic opens
generating the unit ideal.** For `U` an affine open of `X` and `S` a covering sieve of `U` for
`AlgebraicGeometry.Scheme.affineOpensTopology` there is a finite family `g` of sections over `U`
with `Ideal.span (Set.range g) = ⊤` all of whose basic opens are members of `S`.

Around each point of `U` a member of `S` contains a basic open of `U`, by
`AlgebraicGeometry.IsAffineOpen.exists_basicOpen_le`, and that basic open is itself a member of
`S` because `S` is a sieve. The chosen sections span the unit ideal by
`AlgebraicGeometry.IsAffineOpen.self_le_iSup_basicOpen_iff`, and `Ideal.span_eq_top_iff_finite`
cuts the family down to a finite one — which is where quasi-compactness of an affine scheme
enters. -/
theorem Scheme.exists_spanning_basicOpen_family (U : X.affineOpens)
    (S : Sieve U) (hS : S ∈ X.affineOpensTopology U) :
    ∃ (I : Type u) (_ : Finite I) (g : I → Γ(X, U)),
      Ideal.span (Set.range g) = ⊤ ∧
        ∀ i, S.arrows (homOfLE (X.affineBasicOpen_le (g i))) := by
  rw [Scheme.mem_affineOpensTopology] at hS
  have hchoice : ∀ x : (U : X.Opens), ∃ a : Γ(X, (U : X.Opens)),
      (x : X) ∈ X.basicOpen a ∧ S.arrows (homOfLE (X.affineBasicOpen_le a)) := by
    intro x
    obtain ⟨V, f, hf, hxV⟩ := hS x x.2
    obtain ⟨a, hle, hxa⟩ := U.2.exists_basicOpen_le (V := (V : X.Opens)) ⟨x, hxV⟩ x.2
    refine ⟨a, hxa, ?_⟩
    have harr : (homOfLE (X.affineBasicOpen_le a) : X.affineBasicOpen a ⟶ U) =
        (homOfLE hle : X.affineBasicOpen a ⟶ V) ≫ f := Subsingleton.elim _ _
    rw [harr]
    exact S.downward_closed hf _
  choose a ha1 ha2 using hchoice
  have hspan : Ideal.span (Set.range a) = ⊤ := by
    rw [← U.2.self_le_iSup_basicOpen_iff]
    intro x hx
    rw [Opens.mem_iSup]
    exact ⟨⟨a ⟨x, hx⟩, Set.mem_range_self _⟩, ha1 ⟨x, hx⟩⟩
  obtain ⟨t, hts, ht⟩ := (Ideal.span_eq_top_iff_finite _).mp hspan
  refine ⟨↥t, inferInstance, fun i ↦ (i : Γ(X, (U : X.Opens))), ?_, ?_⟩
  · rw [show Set.range (fun i : ↥t ↦ (i : Γ(X, (U : X.Opens)))) = (↑t : Set _) from
      Subtype.range_coe]
    exact ht
  · rintro ⟨_, hi⟩
    obtain ⟨x, rfl⟩ := hts (Finset.mem_coe.mpr hi)
    exact ha2 x

/-! ### Descent -/

/-- **A cartesian presheaf of modules satisfies the sheaf axiom for a family of basic opens
generating the unit ideal.** This is
`Stacks.PresheafOfModules.isSheafFor_of_cartesian` at the family
`X.basicOpen (g i) ⟶ U`, whose double overlaps are the basic opens of the restricted sections;
the two inputs are `AlgebraicGeometry.faithfullyFlat_pi_presheaf_map_basicOpen` and
`AlgebraicGeometry.isPushout_presheaf_map_basicOpen`. -/
theorem Scheme.isSheafFor_ofArrows_affineBasicOpen (X : Scheme.{u})
    (M : _root_.PresheafOfModules.{u}
      ((X.affineOpensToOpens.op ⋙ X.presheaf) ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {A B : (X.affineOpens)ᵒᵖ} (k : A ⟶ B),
      IsIso (Stacks.PresheafOfModules.restrictionBaseChange M k))
    (U : X.affineOpens) {I : Type*} [Finite I] (g : I → Γ(X, U))
    (hg : Ideal.span (Set.range g) = ⊤) :
    Presieve.IsSheafFor (M.presheaf ⋙ CategoryTheory.forget AddCommGrpCat)
      (Presieve.ofArrows (fun i ↦ X.affineBasicOpen (g i))
        (fun i ↦ homOfLE (X.affineBasicOpen_le (g i)))) := by
  have hres : ∀ i j : I,
      (X.affineBasicOpen (U := X.affineBasicOpen (g j))
        (X.presheaf.map (homOfLE (X.basicOpen_le (g j))).op (g i)) : X.affineOpens) ≤
        X.affineBasicOpen (g i) :=
    fun i j ↦ X.basicOpen_restrict (homOfLE (X.basicOpen_le (g j))) (g i)
  refine Stacks.PresheafOfModules.isSheafFor_of_cartesian
    (X.affineOpensToOpens.op ⋙ X.presheaf) M
    (fun i ↦ X.affineBasicOpen (g i)) (fun i ↦ homOfLE (X.affineBasicOpen_le (g i)))
    (fun i j ↦ X.affineBasicOpen (U := X.affineBasicOpen (g j))
      (X.presheaf.map (homOfLE (X.basicOpen_le (g j))).op (g i)))
    (fun i j ↦ homOfLE (hres i j))
    (fun i j ↦ homOfLE (X.affineBasicOpen_le _))
    (fun i j ↦ rfl) ?_ (fun i j ↦ ?_) hM
  · exact faithfullyFlat_pi_presheaf_map_basicOpen U.2 g hg
  · exact isPushout_presheaf_map_basicOpen U.2 (g i) (g j) _ rfl (hres i j)

/-- **A cartesian presheaf of modules on the affine opens of a scheme is a Zariski sheaf.** Let
`X` be a scheme and `M` a presheaf of modules on the affine opens of `X` over the restriction of
the structure sheaf whose base-change comparisons
`M(U) ⊗_{Γ(X, U)} Γ(X, V) ⟶ M(V)` are all isomorphisms. Then `M` is a sheaf for
`AlgebraicGeometry.Scheme.affineOpensTopology`.

This is the sheaf half of the implication (1) ⟹ (2) of [Stacks, Tag 0GZX] for the Zariski
topology on a scheme, which the source states for both topologies and proves for the étale one.
A covering sieve is refined by a finite family of basic opens, by
`AlgebraicGeometry.Scheme.exists_spanning_basicOpen_family`; the sheaf axiom for such a family is
`AlgebraicGeometry.Scheme.isSheafFor_ofArrows_affineBasicOpen`; and the pullback of such a family
along an inclusion of affine opens is again one, which is what
`CategoryTheory.Presieve.isSheafFor_subsieve` needs.

[Stacks, Tag 0GZX] (not registered here: this is not the whole statement of the tag): the
sheaf-property half of the implication (1) implies (2), Zariski case
-/
theorem Scheme.isSheaf_affineOpensTopology_of_cartesian (X : Scheme.{u})
    (M : _root_.PresheafOfModules.{u}
      ((X.affineOpensToOpens.op ⋙ X.presheaf) ⋙ forget₂ CommRingCat RingCat))
    (hM : ∀ {A B : (X.affineOpens)ᵒᵖ} (k : A ⟶ B),
      IsIso (Stacks.PresheafOfModules.restrictionBaseChange M k)) :
    Presheaf.IsSheaf X.affineOpensTopology M.presheaf := by
  apply (Presheaf.isSheaf_iff_isSheaf_comp X.affineOpensTopology M.presheaf
    (CategoryTheory.forget AddCommGrpCat.{u})).mpr
  rw [isSheaf_iff_isSheaf_of_type]
  intro U S hS
  obtain ⟨I, hI, g, hspan, hin⟩ := X.exists_spanning_basicOpen_family U S hS
  refine Presieve.isSheafFor_subsieve _
    (S := Sieve.generate (Presieve.ofArrows (fun i ↦ X.affineBasicOpen (g i))
      (fun i ↦ homOfLE (X.affineBasicOpen_le (g i))))) ?_ ?_
  · exact (Sieve.generate_le_iff _ S).mpr (by rintro V f ⟨i⟩; exact hin i)
  · intro V' k
    have hVU : (V' : X.Opens) ≤ (U : X.Opens) := leOfHom k
    set φ := (X.presheaf.map (homOfLE hVU).op).hom with hφ
    set g' : I → Γ(X, (V' : X.Opens)) := fun i ↦ φ (g i) with hg'
    have hspan' : Ideal.span (Set.range g') = ⊤ := by
      rw [show Set.range g' = φ '' Set.range g from Set.range_comp φ g, ← Ideal.map_span, hspan,
        Ideal.map_top]
    have hbo : ∀ i, X.basicOpen (g' i) = (V' : X.Opens) ⊓ X.basicOpen (g i) := fun i ↦
      Scheme.basicOpen_res _ _ _
    have heq : (Sieve.generate (Presieve.ofArrows (fun i ↦ X.affineBasicOpen (g i))
          (fun i ↦ homOfLE (X.affineBasicOpen_le (g i))))).pullback k =
        Sieve.generate (Presieve.ofArrows (fun i ↦ X.affineBasicOpen (g' i))
          (fun i ↦ homOfLE (X.affineBasicOpen_le (g' i)))) := by
      refine Sieve.ext fun W j ↦ ?_
      rw [show ((Sieve.generate (Presieve.ofArrows (fun i ↦ X.affineBasicOpen (g i))
          (fun i ↦ homOfLE (X.affineBasicOpen_le (g i))))).pullback k).arrows j =
          (Sieve.generate (Presieve.ofArrows (fun i ↦ X.affineBasicOpen (g i))
          (fun i ↦ homOfLE (X.affineBasicOpen_le (g i))))).arrows (j ≫ k) from rfl,
        X.mem_generate_ofArrows_affineOpens_iff, X.mem_generate_ofArrows_affineOpens_iff]
      refine exists_congr fun i ↦ ?_
      show (W : X.Opens) ≤ X.basicOpen (g i) ↔ (W : X.Opens) ≤ X.basicOpen (g' i)
      rw [hbo i]
      exact ⟨fun hw ↦ le_inf (leOfHom j) hw, fun hw ↦ hw.trans inf_le_right⟩
    rw [heq]
    exact (Presieve.isSheafFor_iff_generate _).mp
      (X.isSheafFor_ofArrows_affineBasicOpen M hM V' g' hspan')

end AlgebraicGeometry

end
