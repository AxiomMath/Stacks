module

public import StacksFrontier.AlgebraicGeometry.RegularImmersionResidues.Basic

/-!
# The stalk of the defining ideal of a closed immersion

Let `j : Z ⟶ W` be a closed immersion whose defining ideal is generated on an open `U` of `W` by
sections `g`. At a point `j z` of `U`, the ideal of `𝒪_{W, j z}` generated by the germs of the
`g i` is the kernel of `j.stalkMap z`, so the quotient of `𝒪_{W, j z}` by these germs is
`𝒪_{Z, z}`. Consequently, if `j ≫ p` is flat, these quotients are flat over the stalks of the base.

## Main results

* `mem_definingIdealOfHom_iff`: a section lies in the defining ideal of `j` exactly when `j.app`
  kills it.
* `exists_mem_definingIdealOfHom_of_stalkMap_germ_eq_zero`: for a closed embedding `j`, a germ
  killed by `j.stalkMap z` is the germ of a section of the defining ideal on a smaller open.
* `span_germFamily_eq_ker_stalkMap`: the ideal generated by the germs of the generators is the
  kernel of the stalk map.
* `exists_preimage_of_forall_germFamily_mem_maximalIdeal`: a point at which every germ of the
  generators lies in the maximal ideal lies in the image of `j`.
* `quotientStalkFlat_definingIdealOfHom`, `quotientStalkFlat_definingIdeal`: if the composite of
  the immersion with the structure morphism is flat, the quotients of the stalks by the germs of
  the generators are flat over the stalks of the base.

## References

* [Stacks Project, Definition 31.22.1 (Tag 063S)](https://stacks.math.columbia.edu/tag/063S)
* [Stacks Project, Lemma 31.23.4 (Tag 063U)](https://stacks.math.columbia.edu/tag/063U)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open RingedSpaceModuleAdjunction
open Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

namespace Stacks.AlgebraicGeometry.Tag063UQuotientStalk

section Bridge

/-- A section lies in the defining ideal of `j`, the kernel sheaf of `𝒪_W ⟶ j_* 𝒪_Z`, exactly
when `j.app` kills it. -/
theorem mem_definingIdealOfHom_iff {Z W : Scheme.{u}} (j : Z ⟶ W) (V : W.Opens) (s : Γ(W, V)) :
    s ∈ (definingIdealOfHom j).obj (op V) ↔ j.app V s = 0 :=
  Iff.rfl

/-- The generators of the defining ideal over the open on which they generate it are themselves
sections of it. -/
theorem mem_definingIdealOfHom_of_isGeneratedByOn {Z W : Scheme.{u}} (j : Z ⟶ W) {U : W.Opens}
    {r : ℕ} {g : Fin r → Γ(W, U)}
    (hgen : IsGeneratedByOn W.toRingedSpace (definingIdealOfHom j) U g) (i : Fin r) :
    j.app U (g i) = 0 := by
  rw [← mem_definingIdealOfHom_iff, hgen U le_rfl]
  exact mem_generatedIdealOn W.toRingedSpace U g i

end Bridge

section Shrink

variable {Z W : Scheme.{u}} (j : Z ⟶ W)

/-- If `j.app V s` restricts to zero on `V'` and the preimage of `V₀ ≤ V` is contained in `V'`,
then `j.app V₀` kills the restriction of `s` to `V₀`. -/
theorem app_eq_zero_of_preimage_le {V V₀ : W.Opens} (hle : V₀ ≤ V) {V' : Opens Z}
    (hV'le : V' ≤ j ⁻¹ᵁ V) (hpre : j ⁻¹ᵁ V₀ ≤ V') (s : Γ(W, V))
    (hzero : Z.presheaf.map (homOfLE hV'le).op (j.app V s) = 0) :
    j.app V₀ (W.presheaf.map (homOfLE hle).op s) = 0 := by
  have hnat := congrArg (fun φ => φ s) (Scheme.Hom.naturality j (homOfLE hle).op)
  simp only [CommRingCat.comp_apply] at hnat
  rw [hnat, show ((Opens.map j.base).map (homOfLE hle).op.unop).op
      = ((homOfLE hV'le).op ≫ (homOfLE hpre).op) from rfl,
    Functor.map_comp, CommRingCat.comp_apply, hzero, map_zero]

/-- If `j` is a closed embedding and the germ at `j z` of a section `s` over `V` is killed by
`j.stalkMap z`, then `s` lies in the defining ideal after restriction to any open inside some
smaller neighbourhood of `j z`. -/
theorem exists_mem_definingIdealOfHom_of_stalkMap_germ_eq_zero
    (hcl : Topology.IsClosedEmbedding j.base) (z : Z) (V : W.Opens) (hV : j z ∈ V) (s : Γ(W, V))
    (h0 : j.stalkMap z (W.presheaf.germ V (j z) hV s) = 0) :
    ∃ (V₀ : W.Opens) (_ : j z ∈ V₀) (_ : V₀ ≤ V),
      ∀ (V₁ : W.Opens) (hle₁ : V₁ ≤ V), V₁ ≤ V₀ →
        W.presheaf.map (homOfLE hle₁).op s ∈ (definingIdealOfHom j).obj (op V₁) := by
  classical
  rw [Scheme.Hom.germ_stalkMap_apply] at h0
  obtain ⟨V', hzV', hV'le, hzero⟩ :=
    Stacks.AlgebraicGeometry.QuasiRegular.exists_nhds_eq_zero_of_germ_eq_zero
      (X := Z.toRingedSpace) (j ⁻¹ᵁ V) (j.app V s) z hV h0
  have hclosed : IsClosed (j.base '' ((V' : Set Z)ᶜ)) :=
    hcl.isClosedMap _ (isClosed_compl_iff.2 V'.isOpen)
  have hpre : j ⁻¹ᵁ (V ⊓ ⟨(j.base '' ((V' : Set Z)ᶜ))ᶜ, hclosed.isOpen_compl⟩) ≤ V' :=
    fun w hw => by_contra fun hwV' => hw.2 ⟨w, hwV', rfl⟩
  refine ⟨V ⊓ ⟨(j.base '' ((V' : Set Z)ᶜ))ᶜ, hclosed.isOpen_compl⟩, ⟨hV, ?_⟩, inf_le_left,
    fun V₁ hle₁ hsub => ?_⟩
  · rintro ⟨w, hw, hwz⟩
    exact hw (hcl.injective hwz ▸ hzV')
  rw [mem_definingIdealOfHom_iff]
  exact app_eq_zero_of_preimage_le j hle₁ hV'le
    (fun w hw => hpre (hsub hw)) s hzero

end Shrink

section Stalk

variable {Z W : Scheme.{u}} (j : Z ⟶ W) [IsClosedImmersion j]

/-- If the defining ideal of a closed immersion `j` is generated on an open `U` by sections `g`,
then at a point `j z` of `U` the ideal of `𝒪_{W, j z}` generated by the germs of the `g i` is
exactly the kernel of `j.stalkMap z`. -/
theorem span_germFamily_eq_ker_stalkMap {U : W.Opens} {r : ℕ} {g : Fin r → Γ(W, U)}
    (hgen : IsGeneratedByOn W.toRingedSpace (definingIdealOfHom j) U g) (z : Z) (hz : j z ∈ U) :
    Ideal.span (Set.range (germFamily W.toRingedSpace U g (j z) hz))
      = RingHom.ker (j.stalkMap z).hom := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro a ⟨i, rfl⟩
    simp only [SetLike.mem_coe, RingHom.mem_ker]
    change j.stalkMap z (W.presheaf.germ U (j z) hz (g i)) = 0
    rw [Scheme.Hom.germ_stalkMap_apply,
      mem_definingIdealOfHom_of_isGeneratedByOn j hgen i, map_zero]
  · intro a ha
    obtain ⟨V, hV, s, hs⟩ := W.presheaf.exists_germ_eq a
    have h0 : j.stalkMap z (W.presheaf.germ V (j z) hV s) = 0 := by rwa [hs]
    obtain ⟨V₀, hzV₀, _, hmem⟩ :=
      exists_mem_definingIdealOfHom_of_stalkMap_germ_eq_zero j
        (Scheme.Hom.isClosedEmbedding j) z V hV s h0
    have hleV : V₀ ⊓ U ≤ V := le_trans inf_le_left ‹V₀ ≤ V›
    have hmem' := hmem (V₀ ⊓ U) hleV inf_le_left
    rw [hgen (V₀ ⊓ U) inf_le_right] at hmem'
    have hgerm :=
      (mem_generatedIdealOn_iff U g (V₀ ⊓ U) inf_le_right _).1 hmem' (j z) ⟨hzV₀, hz⟩
    have hres : W.presheaf.germ (V₀ ⊓ U) (j z) ⟨hzV₀, hz⟩
        (W.presheaf.map (homOfLE hleV).op s) = a :=
      (TopCat.Presheaf.germ_res_apply W.presheaf (homOfLE hleV) (j z) ⟨hzV₀, hz⟩ s).trans hs
    rwa [hres] at hgerm

/-- If a generator family of the defining ideal of `j` has all its germs at `y` inside the maximal
ideal of `𝒪_{W, y}`, then `y` is in the image of `j`. -/
theorem exists_preimage_of_forall_germFamily_mem_maximalIdeal {U : W.Opens} {r : ℕ}
    {g : Fin r → Γ(W, U)}
    (hgen : IsGeneratedByOn W.toRingedSpace (definingIdealOfHom j) U g) (y : W) (hy : y ∈ U)
    (hmem : ∀ i, germFamily W.toRingedSpace U g y hy i ∈
      IsLocalRing.maximalIdeal (W.presheaf.stalk y)) :
    ∃ z : Z, j z = y := by
  by_contra hno
  have hnr : y ∉ Set.range (j.base) := fun ⟨z, hz⟩ => hno ⟨z, hz⟩
  have hclosed : IsClosed (Set.range (j.base)) :=
    (Scheme.Hom.isClosedEmbedding j).isClosed_range
  have hbot : j ⁻¹ᵁ (U ⊓ ⟨(Set.range (j.base))ᶜ, hclosed.isOpen_compl⟩) = ⊥ :=
    le_bot_iff.mp fun w hw => absurd (Set.mem_range_self w) hw.2
  have hsub : Subsingleton Γ(Z, j ⁻¹ᵁ (U ⊓ ⟨(Set.range (j.base))ᶜ, hclosed.isOpen_compl⟩)) :=
    hbot ▸ (inferInstance : Subsingleton Γ(Z, ⊥))
  have hone : (1 : Γ(W, U ⊓ ⟨(Set.range (j.base))ᶜ, hclosed.isOpen_compl⟩)) ∈
      (definingIdealOfHom j).obj
        (op (U ⊓ ⟨(Set.range (j.base))ᶜ, hclosed.isOpen_compl⟩)) := by
    rw [mem_definingIdealOfHom_iff]
    exact hsub.elim _ _
  rw [hgen _ inf_le_left] at hone
  have hgerm := (mem_generatedIdealOn_iff U g _ inf_le_left _).1 hone y ⟨hy, hnr⟩
  rw [map_one] at hgerm
  have hle : Jid (germFamily W.toRingedSpace U g y hy) ≤
      IsLocalRing.maximalIdeal (W.presheaf.stalk y) := by
    rw [Jid, Ideal.span_le]
    rintro a ⟨i, rfl⟩
    exact hmem i
  exact (IsLocalRing.maximalIdeal.isMaximal (W.presheaf.stalk y)).ne_top
    ((Ideal.eq_top_iff_one _).2 (hle hgerm))

end Stalk

section Flat

/-- If the composite of a ring map `f` with a ring isomorphism `e` is flat, then `f` is flat. -/
theorem flat_of_flat_comp_equiv {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
    (f : A →+* B) (e : B ≃+* C) (h : (e.toRingHom.comp f).Flat) : f.Flat := by
  have h' := RingHom.Flat.respectsIso.1 (e.toRingHom.comp f) e.symm h
  have hcomp : e.symm.toRingHom.comp (e.toRingHom.comp f) = f := by
    ext a
    simp
  rwa [hcomp] at h'

/-- If `I` is the kernel of a surjection `st` and `st ∘ q` is flat, then `mk I ∘ q` is flat. -/
theorem flat_quotientMk_comp_of_eq_ker {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
    (q : A →+* B) (st : B →+* C) (hsurj : Function.Surjective st) (I : Ideal B)
    (hI : I = RingHom.ker st) (h : (st.comp q).Flat) :
    ((Ideal.Quotient.mk I).comp q).Flat := by
  subst hI
  refine flat_of_flat_comp_equiv _ (RingHom.quotientKerEquivOfSurjective hsurj) ?_
  have hmk : (RingHom.quotientKerEquivOfSurjective hsurj).toRingHom.comp
      ((Ideal.Quotient.mk (RingHom.ker st)).comp q) = st.comp q := by
    ext a
    simp [RingHom.quotientKerEquivOfSurjective_apply_mk]
  rwa [hmk]

/-- If `j : Z ⟶ W` is a closed immersion and `j ≫ p` is flat, then at every point of `W` at which
the germs of the generators of the defining ideal lie in the maximal ideal, the quotient of the
stalk by those germs is flat over the stalk of the base. -/
theorem quotientStalkFlat_definingIdealOfHom {S W Z : Scheme.{u}} (p : W ⟶ S) (j : Z ⟶ W)
    [IsClosedImmersion j] (hflat : Flat (j ≫ p)) :
    Tag063URegularImmersion.QuotientStalkFlat p (definingIdealOfHom j) := by
  intro U r g hgen y hy hmem
  obtain ⟨z, rfl⟩ :=
    exists_preimage_of_forall_germFamily_mem_maximalIdeal j hgen y hy hmem
  refine flat_quotientMk_comp_of_eq_ker _ (j.stalkMap z).hom (j.stalkMap_surjective z) _
    (span_germFamily_eq_ker_stalkMap j hgen z hy) ?_
  have h := AlgebraicGeometry.Flat.stalkMap (f := j ≫ p) z
  rwa [Scheme.Hom.stalkMap_comp] at h

/-- For an immersion `i : Z ⟶ X` such that `i ≫ f` is flat, the quotients of the stalks of the
ambient open `i.coborderRange` by the germs of the generators of the defining ideal are flat over
the stalks of the base. -/
theorem quotientStalkFlat_definingIdeal {S X Z : Scheme.{u}} (f : X ⟶ S) (i : Z ⟶ X)
    [IsImmersion i] (hflat : Flat (i ≫ f)) :
    Tag063URegularImmersion.QuotientStalkFlat (i.coborderRange.ι ≫ f)
      (definingIdeal i) := by
  refine quotientStalkFlat_definingIdealOfHom (i.coborderRange.ι ≫ f) i.liftCoborder ?_
  rwa [← Category.assoc, Scheme.Hom.liftCoborder_ι]

end Flat

end Stacks.AlgebraicGeometry.Tag063UQuotientStalk

end
