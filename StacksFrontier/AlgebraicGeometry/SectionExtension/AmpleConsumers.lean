-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open Stacks.Ample

universe u

namespace Stacks.SectionExtension

/-! ### Clauses (3) and (4) of Stacks Tag 01Q3 -/

section Clauses

variable (X : Scheme.{u}) (L : X.Modules) [IsInvertibleModule X L]

/-- **Stacks Tag 01Q3, clause (1) implies clause (3)**, with no premise: for `L` ample the opens
`X_s`, with `s` a global section of a positive tensor power of `L`, form a basis for the topology
of `X`. The premise of
`Stacks.SectionExtension.isBasisNonvanishing_of_isSectionRatio` is discharged by
`Stacks.SectionExtension.isSectionRatio_of_isAmple`, whose own hypothesis is the ampleness already
present. -/
theorem isBasisNonvanishing_of_isAmple (hL : IsAmple X L) :
    Stacks.AmpleTheory.IsBasisNonvanishing X L :=
  isBasisNonvanishing_of_isSectionRatio X L (isSectionRatio_of_isAmple L hL) hL

/-- **Stacks Tag 01Q3, clause (1) implies clause (4)**, with no premise: the affine `X_s` form a
basis for the topology. Clause (3) above followed by Stacks Tag 01PX, which is unconditional in
this repository because Tag 01PV is proved. -/
theorem isBasisAffineNonvanishing_of_isAmple (hL : IsAmple X L) :
    Stacks.AmpleTheory.IsBasisAffineNonvanishing X L :=
  isBasisAffineNonvanishing_of_isSectionRatio X L (isSectionRatio_of_isAmple L hL) hL

/-- **Stacks Tag 01Q3, (1) if and only if (3)**, for an arbitrary invertible `𝒪_X`-module and with
no premise. The forward direction has the ampleness it needs in hand; the converse is Stacks Tag
01PX followed by Tag 01PV. -/
theorem isAmple_iff_compactSpace_and_isBasisNonvanishing :
    IsAmple X L ↔ CompactSpace X ∧ Stacks.AmpleTheory.IsBasisNonvanishing X L :=
  ⟨fun hL => ⟨hL.1, isBasisNonvanishing_of_isAmple X L hL⟩, fun hb =>
    Stacks.AmpleTheory.isAmple_of_isBasisAffineNonvanishing X L hb.1
      (Stacks.NonvanishingAffineIntersection.isBasisAffineNonvanishing_of_isBasisNonvanishing
        X L hb.2)⟩

/-- **Stacks Tag 01Q3, (1) if and only if (4)**, for an arbitrary invertible `𝒪_X`-module and with
no premise. `Stacks.AmpleTheory.isAmple_iff_isBasisAffineNonvanishing` proves the same equivalence
for a module with a nowhere-vanishing global basis in every degree; this drops that
restriction. -/
theorem isAmple_iff_compactSpace_and_isBasisAffineNonvanishing :
    IsAmple X L ↔ CompactSpace X ∧ Stacks.AmpleTheory.IsBasisAffineNonvanishing X L :=
  ⟨fun hL => ⟨hL.1, isBasisAffineNonvanishing_of_isAmple X L hL⟩, fun hb =>
    Stacks.AmpleTheory.isAmple_of_isBasisAffineNonvanishing X L hb.1 hb.2⟩

/-- **Every basic open of an `X_s` is itself an `X_u`**, for `L` ample, with no affineness
hypothesis on `X_s`. This is `Stacks.AmpleQuasiAffinePullback.BasicOpenIsPow` for an ample module.
-/
theorem basicOpenIsPow_of_isAmple (hL : IsAmple X L) :
  Stacks.AmpleQuasiAffinePullback.BasicOpenIsPow X L :=
  basicOpenIsPow_of_isSectionRatio X L (isSectionRatio_of_isAmple L hL)

/-- `Stacks.AmplePullback.BasicOpenIsPowNonvanishing` for an ample module: the same statement with
`X_s` assumed affine. -/
theorem basicOpenIsPowNonvanishing_of_isAmple (hL : IsAmple X L) :
    Stacks.AmplePullback.BasicOpenIsPowNonvanishing X L :=
  basicOpenIsPowNonvanishing_of_isSectionRatio X L (isSectionRatio_of_isAmple L hL)

end Clauses

/-! ### Stacks Tag 0B3E and Stacks Tag 01VN -/

/-- **Stacks Tag 0B3E in general, with no premise.** The pullback of an ample invertible module
along a morphism which is a quasi-compact immersion, an immersion of a quasi-compact scheme, a
quasi-compact topological embedding, or a topological embedding of a quasi-compact scheme, is
ample. The four unconditional reductions are `Stacks.AmplePullback.isAmple_modulePullback`'s; the
premise is discharged by `Stacks.SectionExtension.isSectionRatio_of_isAmple`, which has the same
ampleness hypothesis. -/
theorem isAmple_pullbackModule {X' X : Scheme.{u}} (i : X' ⟶ X) (L : X.Modules)
    [IsInvertibleModule X L] (hL : IsAmple X L)
    (hi : (QuasiCompact i ∧ IsImmersion i) ∨ (CompactSpace X' ∧ IsImmersion i) ∨
      (QuasiCompact i ∧ Topology.IsEmbedding i) ∨
      (CompactSpace X' ∧ Topology.IsEmbedding i)) :
    IsAmple X' (Stacks.AmpleLocallyClosed.pullbackModule i L) :=
  isAmple_modulePullback_of_isSectionRatio i L hL hi (isSectionRatio_of_isAmple L hL)

/-- **`Stacks.RelativeVeryAmple.AmplePullbackGap` is a theorem.** The gap quantifies the section
extension premise over every scheme and every *ample* invertible module, which is exactly the
generality `Stacks.SectionExtension.isSectionRatio_of_isAmple` supplies. -/
theorem amplePullbackGap : Stacks.RelativeVeryAmple.AmplePullbackGap.{u} :=
  amplePullbackGap_of_isSectionRatio fun B N inst hN =>
    @isSectionRatio_of_isAmple B N inst hN

/-- **The content of Stacks Tag 01VN, with no premise**: relative ampleness is inherited by an
immersion over the base. -/
theorem isRelativelyAmple_of_relativeTwistImmersion {Y S : Scheme.{u}} (f : Y ⟶ S)
    (M : Y.Modules) [IsInvertibleModule Y M] (hf : QuasiCompact f)
    (hr : Stacks.RelativeVeryAmple.HasRelativeTwistImmersion f M) :
    Stacks.RelativeAmple.IsRelativelyAmple f M :=
  isRelativelyAmple_of_hasRelativeTwistImmersion
    (fun B N inst hN => @isSectionRatio_of_isAmple B N inst hN) f M hf hr

/-! ### Stacks Tag 09NV -/

section AmpleFiniteAffineNonvanishing

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

variable {X : Scheme.{u}} (L : X.Modules) [IsInvertibleModule X L]

/-- **The conclusion of Stacks Tag 09NV, with no premise.** A finite subset `E` of an open `W` of
a scheme carrying an ample invertible module `L` lies in an *affine* `X_a ≤ W`, for `a` a
homogeneous element of the section ring of positive degree.

`Stacks.AmpleAffineAvoidance.exists_affine_nvOpen_containing_finite_le_of_ample` proves this on
the single hypothesis that the `X_s` form a basis for the topology — clause (3) of Stacks Tag
01Q3 — and that is now `Stacks.SectionExtension.isBasisNonvanishing_of_isAmple`. -/
theorem exists_affine_nvOpen_containing_finite_le_of_isAmple (hL : IsAmple X L) {E : Set X}
    (hE : E.Finite) (W : X.Opens) (hEW : E ⊆ (W : Set X)) :
    ∃ (d : ℕ) (a : Stacks.GradedSections.powSections L d), 1 ≤ d ∧
      E ⊆ (Stacks.AmpleFiniteAvoidance.nvOpen L a : Set X) ∧
        Stacks.AmpleFiniteAvoidance.nvOpen L a ≤ W ∧
          IsAffineOpen (Stacks.AmpleFiniteAvoidance.nvOpen L a) :=
  Stacks.AmpleAffineAvoidance.exists_affine_nvOpen_containing_finite_le_of_ample L
    (isBasisNonvanishing_of_isAmple X L hL) hL hE W hEW

end AmpleFiniteAffineNonvanishing

end Stacks.SectionExtension

end
