module

public import Mathlib.LinearAlgebra.TensorProduct.Pi
public import StacksFrontier.AlgebraicGeometry.ModuleLimits.MapDescent
public import StacksFrontier.RingTheory.Module.DirectLimit.FinitePresentation
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Eventual projectivity of a finitely presented module over a colimit of rings

Let `M` be a finitely presented module over a commutative ring `A`, and let `Rc` be a filtered
colimit of `A`-algebras `S i`.  This file proves that if `Rc ⊗_A M` is a projective
`Rc`-module, then `S i ⊗_A M` is already a projective `S i`-module for some stage `i`.

Together with [Stacks Project, Tag 00NX] — which identifies "finitely presented and flat" with
"finite and projective" — this is the module-theoretic content of [Stacks Project, Tag 02JO] in
the form in which the descent of finite locally free sheaves through a limit of schemes uses
it.  The proof given here does not go through flatness at all.

## Main results

* `Stacks.RingFilteredColimits.exists_projective_of_directed`: the statement for a directed
  system of `A`-algebras presented in the form of [Stacks Project, Tag 05LI].
* `Stacks.RingFilteredColimits.exists_projective_tensor_of_isColimit`: the statement for a
  colimit cocone on a filtered diagram of commutative rings, which is the shape in which a
  cofiltered limit of affine schemes presents itself.

## Implementation notes

The mathematical content is a spreading-out argument for a *splitting*, and it is elementary.
Choose a finite free presentation `A^n ↠ M`.  Its base change `Rc^n ↠ Rc ⊗_A M` is a surjection
onto a projective module, so it splits; let `g` be a splitting.  Tag 05LI (3),
`Stacks.FinitePresentation.ColimitDescent.statement_three`, descends `g` to a map `gᵢ` at some
stage `i`, and then
`u := p ⊗ Rc_i ∘ gᵢ` is an endomorphism of `S i ⊗_A M` which becomes the identity in the
colimit.  Because `M` is finite over `A`, the module `S i ⊗_A M` is generated over `S i` by the
elements `1 ⊗ m` for `m` in a finite generating set of `M`, so the equalizer half of
`Stacks.FinitePresentation.ColimitDescent.IsModuleColimit` turns "`u` is the identity in the
colimit" into "`u` is the identity after one further transition map", one generator at a time.
Base changing `gᵢ` along that transition map therefore splits the presentation at that stage.

The passage from a filtered diagram to a directed system is the one already used by
`Stacks.RingFilteredColimits.exists_descend_rTensor`:
`CategoryTheory.IsFiltered.exists_directed_final` provides a directed partially ordered final
model of the index category, and the joint
surjectivity and equalizer conditions are read off the whiskered colimit cocone by
`CategoryTheory.Limits.Concrete.isColimit_exists_rep` and
`CategoryTheory.Limits.Concrete.isColimit_exists_of_rep_eq`.

## References

* [Stacks Project, Tag 02JO](https://stacks.math.columbia.edu/tag/02JO)
* [Stacks Project, Tag 00NX](https://stacks.math.columbia.edu/tag/00NX)
* [Stacks Project, Tag 05LI](https://stacks.math.columbia.edu/tag/05LI)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct

universe u

namespace Stacks.RingFilteredColimits

section Spanning

variable {A : Type*} [CommRing A] {B : Type*} [CommRing B] [Algebra A B]
  {M : Type*} [AddCommGroup M] [Module A M]

/-- Base change is generated by the images of a generating set. -/
theorem span_one_tmul_eq_top (s : Set M) (hs : Submodule.span A s = ⊤) :
    Submodule.span B ((fun m => (1 : B) ⊗ₜ[A] m) '' s) = ⊤ := by
  rw [eq_top_iff]
  rintro x -
  induction x using TensorProduct.inductionOn with
  | add x y hx hy => exact Submodule.add_mem _ hx hy
  | tmul b m =>
    have hm : m ∈ Submodule.span A s := hs ▸ Submodule.mem_top
    induction hm using Submodule.span_induction with
    | mem m hm =>
      have hb : b ⊗ₜ[A] m = b • ((1 : B) ⊗ₜ[A] m) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [hb]
      exact Submodule.smul_mem _ b (Submodule.subset_span (Set.mem_image_of_mem _ hm))
    | zero =>
      rw [TensorProduct.tmul_zero]
      exact Submodule.zero_mem _
    | add x y _ _ hx hy =>
      rw [TensorProduct.tmul_add]
      exact Submodule.add_mem _ hx hy
    | smul a x _ hx =>
      have : b ⊗ₜ[A] (a • x) = algebraMap A B a • (b ⊗ₜ[A] x) := by
        rw [TensorProduct.tmul_smul, algebraMap_smul]
      rw [this]
      exact Submodule.smul_mem _ _ hx

/-- Two `B`-linear maps out of a base change agreeing on the image of a generating set of the
original module are equal. -/
theorem linearMap_ext_of_span {N : Type*} [AddCommGroup N] [Module B N]
    (s : Set M) (hs : Submodule.span A s = ⊤) {f g : B ⊗[A] M →ₗ[B] N}
    (h : ∀ m ∈ s, f ((1 : B) ⊗ₜ[A] m) = g ((1 : B) ⊗ₜ[A] m)) : f = g := by
  refine LinearMap.ext fun x => ?_
  have hx : x ∈ Submodule.span B ((fun m => (1 : B) ⊗ₜ[A] m) '' s) :=
    (span_one_tmul_eq_top (B := B) s hs) ▸ Submodule.mem_top
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨m, hm, rfl⟩ := hy
    exact h m hm
  | zero => simp
  | add x y _ _ hx hy => simp [hx, hy]
  | smul b x _ hx => simp [hx]

end Spanning


section Directed

open Stacks.FinitePresentation.ColimitDescent

variable {A : Type u} [CommRing A] {J : Type u} [Preorder J] [IsDirectedOrder J] [Nonempty J]
  {S : J → Type u} [∀ j, CommRing (S j)] [∀ j, Algebra A (S j)]
  {Rc : Type u} [CommRing Rc] [Algebra A Rc] [∀ j, Algebra (S j) Rc]
  [∀ j, IsScalarTower A (S j) Rc]

variable (φ : ∀ ⦃i j : J⦄, i ≤ j → S i →ₐ[A] S j)

omit [IsDirectedOrder J] [Nonempty J] in
/-- The transition maps of a base-changed system compose. -/
theorem transMod_trans (htrans : TransitionSystem φ) (P : Type*) [AddCommGroup P] [Module A P]
    {i j k : J} (hij : i ≤ j) (hjk : j ≤ k) (y : S i ⊗[A] P) :
    transMod φ P hjk (transMod φ P hij y) = transMod φ P (hij.trans hjk) y := by
  induction y using TensorProduct.inductionOn with
  | tmul r x => simp [transMod_tmul, htrans.trans hij hjk r]
  | add x y hx hy => simp [map_add, hx, hy]

omit [IsDirectedOrder J] [Nonempty J] in
/-- The transition maps of a base-changed system are semilinear. -/
theorem transMod_smul (P : Type*) [AddCommGroup P] [Module A P] {i j : J} (hij : i ≤ j)
    (t : S i) (y : S i ⊗[A] P) :
    transMod φ P hij (t • y) = φ hij t • transMod φ P hij y := by
  induction y using TensorProduct.inductionOn with
  | tmul r x =>
    rw [TensorProduct.smul_tmul', smul_eq_mul, transMod_tmul, transMod_tmul,
      TensorProduct.smul_tmul', smul_eq_mul, map_mul]
  | add x y hx hy => simp [smul_add, map_add, hx, hy]


omit [∀ j, Algebra (S j) Rc] [∀ j, IsScalarTower A (S j) Rc] in
/-- An endomorphism of `S i ⊗_A M`, for `M` finite, which becomes the identity in the colimit
is already the identity after some transition map. -/
theorem exists_transMod_comp_eq_of_canonMod_comp_eq (htrans : TransitionSystem φ)
    {ψ : ∀ j, S j →ₐ[A] Rc} {M : Type*} [AddCommGroup M] [Module A M] [Module.Finite A M]
    (hcM : IsModuleColimit φ ψ M) {i : J} (u : S i ⊗[A] M →ₗ[S i] S i ⊗[A] M)
    (hu : ∀ y, canonMod ψ M i (u y) = canonMod ψ M i y) :
    ∃ k, ∃ hik : i ≤ k, ∀ y, transMod φ M hik (u y) = transMod φ M hik y := by
  classical
  obtain ⟨sgen, hsgen⟩ := Module.Finite.fg_top (R := A) (M := M)
  choose jm hjm hjmeq using fun m : M => hcM.exists_eq_of_canonMod_eq i _ _ (hu ((1 : S i) ⊗ₜ[A] m))
  obtain ⟨k, hk⟩ := Finset.exists_le (insert i (sgen.image jm))
  have hik : i ≤ k := hk i (Finset.mem_insert_self _ _)
  refine ⟨k, hik, fun y => ?_⟩
  have hy : y ∈ Submodule.span (S i) ((fun m => (1 : S i) ⊗ₜ[A] m) '' (sgen : Set M)) :=
    (span_one_tmul_eq_top (B := S i) (sgen : Set M) hsgen) ▸ Submodule.mem_top
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨m, hm, rfl⟩ := hy
    have hjk : jm m ≤ k :=
      hk _ (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (Finset.mem_coe.mp hm)))
    have := congrArg (transMod φ M hjk) (hjmeq m)
    rwa [transMod_trans φ htrans M (hjm m) hjk, transMod_trans φ htrans M (hjm m) hjk,
      Subsingleton.elim ((hjm m).trans hjk) hik] at this
  | zero => simp
  | add x y _ _ hx hy => simp [map_add, hx, hy]
  | smul t x _ hx => rw [map_smul u, transMod_smul φ M hik, transMod_smul φ M hik, hx]

omit [IsDirectedOrder J] [Nonempty J] [∀ j, Algebra (S j) Rc] [∀ j, IsScalarTower A (S j) Rc] in
/-- Cancelling a base change along a transition map is that transition map, up to scalars. -/
theorem cancelBaseChange_tmul_eq_smul_transMod {i k : J} (hik : i ≤ k)
    [Algebra (S i) (S k)] [IsScalarTower A (S i) (S k)]
    (halg : ∀ x, algebraMap (S i) (S k) x = φ hik x) (P : Type*) [AddCommGroup P] [Module A P]
    (t : S k) (z : S i ⊗[A] P) :
    TensorProduct.AlgebraTensorModule.cancelBaseChange A (S i) (S k) (S k) P (t ⊗ₜ z) =
      t • transMod φ P hik z := by
  induction z using TensorProduct.inductionOn with
  | tmul r x =>
    rw [TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, transMod_tmul,
      TensorProduct.smul_tmul', smul_eq_mul]
    congr 1
    rw [Algebra.smul_def, halg, mul_comm]
  | add z₁ z₂ h₁ h₂ => rw [TensorProduct.tmul_add, map_add, h₁, h₂, map_add, smul_add]

/-- **Eventual projectivity of a finitely presented module over a directed colimit of rings.**
If `M` is a finitely presented `A`-module whose base change to the colimit `Rc` of a directed
system of `A`-algebras `S` is projective, then its base change to `S i` is already projective
for some stage `i`. -/
@[ega "IV 11.2.6.1" "(ii), special case"]
theorem exists_projective_of_directed (f : ∀ i j : J, i ≤ j → S i →ₐ[A] S j)
    [DirectedSystem S fun i j h => f i j h]
    (hf : ∀ i j (h : i ≤ j) (x : S i), algebraMap (S j) Rc (f i j h x) = algebraMap (S i) Rc x)
    (hsurj : ∀ r : Rc, ∃ j s, algebraMap (S j) Rc s = r)
    (hinj : ∀ (j : J) (s : S j), algebraMap (S j) Rc s = 0 → ∃ k, ∃ h : j ≤ k, f j k h s = 0)
    (M : Type u) [AddCommGroup M] [Module A M] [Module.FinitePresentation A M]
    [Module.Projective Rc (Rc ⊗[A] M)] :
    ∃ i : J, Module.Projective (S i) (S i ⊗[A] M) := by
  set φ : ∀ ⦃i j : J⦄, i ≤ j → S i →ₐ[A] S j := fun i j h => f i j h
  set ψ : ∀ j : J, S j →ₐ[A] Rc := fun j => IsScalarTower.toAlgHom A (S j) Rc
  have htrans : TransitionSystem φ :=
    ⟨fun i x => DirectedSystem.map_self' (fun i j h => f i j h) x,
      fun _ _ _ hij hjk x => DirectedSystem.map_map' (fun i j h => f i j h) hij hjk x⟩
  have hcocone : IsCoconeAlg φ ψ := fun _ _ hij x => hf _ _ hij x
  have hcM : IsModuleColimit φ ψ M := Stacks.ColimitPresentation.FPModules.isModuleColimit f hf
    hsurj hinj M
  obtain ⟨n, p, hp⟩ := Module.Finite.exists_fin' A M
  have hPsurj : Function.Surjective (p.baseChange Rc) := by
    rw [LinearMap.baseChange_eq_lTensor]
    exact LinearMap.lTensor_surjective Rc hp
  obtain ⟨g, hg⟩ := (Module.Projective.iff_split_of_projective (p.baseChange Rc) hPsurj).mp ‹_›
  obtain ⟨i, gi, hgi⟩ := statement_three φ ψ htrans hcocone
    (Stacks.ColimitPresentation.FPModules.isModuleColimit f hf hsurj hinj (Fin n → A))
    ‹Module.FinitePresentation A M› g
  set u : S i ⊗[A] M →ₗ[S i] S i ⊗[A] M := (p.baseChange (S i)).comp gi
  have hu : ∀ y : S i ⊗[A] M, canonMod ψ M i (u y) = canonMod ψ M i y := by
    intro y
    have h1 : canonMod ψ M i (u y) = (p.baseChange Rc) (canonMod ψ (Fin n → A) i (gi y)) :=
      canonMod_baseChange ψ p i (gi y)
    have h2 : canonMod ψ (Fin n → A) i (gi y) = g (canonMod ψ M i y) :=
      (LinearMap.congr_fun hgi y).symm
    rw [h1, h2, ← LinearMap.comp_apply, hg, LinearMap.id_apply]
  obtain ⟨k, hik, hall⟩ := exists_transMod_comp_eq_of_canonMod_comp_eq φ htrans hcM u hu
  let _ : Algebra (S i) (S k) := (f i k hik).toRingHom.toAlgebra
  let _ : IsScalarTower A (S i) (S k) :=
    IsScalarTower.of_algebraMap_eq fun x => ((f i k hik).commutes x).symm
  have halg : ∀ x, algebraMap (S i) (S k) x = φ hik x := fun _ => rfl
  set eM := TensorProduct.AlgebraTensorModule.cancelBaseChange A (S i) (S k) (S k) M with heM
  set eN := TensorProduct.AlgebraTensorModule.cancelBaseChange A (S i) (S k) (S k) (Fin n → A)
    with heN
  have hmain : ∀ w : S k ⊗[S i] (S i ⊗[A] M),
      (p.baseChange (S k)) (eN (LinearMap.baseChange (S k) gi w)) = eM w := by
    intro w
    induction w using TensorProduct.inductionOn with
    | tmul t y =>
      rw [LinearMap.baseChange_tmul, heN, cancelBaseChange_tmul_eq_smul_transMod φ hik halg,
        map_smul, ← transMod_baseChange φ p hik, heM,
        cancelBaseChange_tmul_eq_smul_transMod φ hik halg]
      exact congrArg (fun z => t • z) (hall y)
    | add w₁ w₂ h₁ h₂ => rw [map_add, map_add, map_add, h₁, h₂, map_add]
  refine ⟨k, Module.Projective.of_split
    (eN.toLinearMap ∘ₗ LinearMap.baseChange (S k) gi ∘ₗ eM.symm.toLinearMap)
    (p.baseChange (S k)) (LinearMap.ext fun x => ?_)⟩
  simpa using (hmain (eM.symm x)).trans (eM.apply_symm_apply x)

end Directed


section Filtered

variable {K : Type u} [Category.{u} K] [IsFiltered K] {G : K ⥤ CommRingCat.{u}}
  {d : Cocone G} {A : Type u} [CommRing A] [∀ l, Algebra A (G.obj l)] [Algebra A d.pt]

variable (haR : ∀ (l : K) (x : A), d.ι.app l (algebraMap A (G.obj l) x) = algebraMap A d.pt x)

variable (ha : ∀ {l m : K} (e : l ⟶ m) (x : A),
    G.map e (algebraMap A (G.obj l) x) = algebraMap A (G.obj m) x)

include haR ha in
/-- **Eventual projectivity of a finitely presented module over a filtered colimit of rings.**
Let `d` be a colimit cocone on a filtered diagram `G` of commutative rings, all of them algebras
over a fixed ring `A` compatibly with the transition maps and the legs.  If `M` is a finitely
presented `A`-module whose base change to the apex is projective, then its base change to some
stage of the diagram is already projective. -/
@[ega "IV 11.2.6.1" "(ii), special case"]
theorem exists_projective_tensor_of_isColimit (hd : IsColimit d)
    (M : Type u) [AddCommGroup M] [Module A M] [Module.FinitePresentation A M]
    [Module.Projective d.pt (d.pt ⊗[A] M)] :
    ∃ l : K, Module.Projective (G.obj l) (G.obj l ⊗[A] M) := by
  obtain ⟨J, _, _, _, GJ, _⟩ := IsFiltered.exists_directed_final K
  let _ : ∀ j : J, Algebra (G.obj (GJ.obj j)) d.pt :=
    fun j => (d.ι.app (GJ.obj j)).hom.toAlgebra
  let _ : ∀ j : J, IsScalarTower A (G.obj (GJ.obj j)) d.pt := fun j =>
    IsScalarTower.of_algebraMap_eq fun x => (haR (GJ.obj j) x).symm
  set f : ∀ i j : J, i ≤ j → (G.obj (GJ.obj i)) →ₐ[A] (G.obj (GJ.obj j)) :=
    fun i j h => mapAlgHom ha (GJ.map (homOfLE h))
  have hds : DirectedSystem (fun j : J => (G.obj (GJ.obj j) : Type u))
      (fun i j h => (f i j h : G.obj (GJ.obj i) → G.obj (GJ.obj j))) := by
    refine ⟨fun i x => ?_, fun {i j k} hij hjk x => ?_⟩
    · change G.map (GJ.map (homOfLE (le_refl i))) x = x
      rw [Subsingleton.elim (homOfLE (le_refl i)) (𝟙 i), GJ.map_id, G.map_id]
      rfl
    · change G.map (GJ.map (homOfLE hjk)) (G.map (GJ.map (homOfLE hij)) x) = _
      rw [← ConcreteCategory.comp_apply, ← G.map_comp, ← GJ.map_comp]
      rfl
  have hf : ∀ (i j : J) (h : i ≤ j) (x : G.obj (GJ.obj i)),
      algebraMap (G.obj (GJ.obj j)) d.pt (f i j h x) = algebraMap (G.obj (GJ.obj i)) d.pt x := by
    intro i j h x
    change d.ι.app (GJ.obj j) (G.map (GJ.map (homOfLE h)) x) = d.ι.app (GJ.obj i) x
    rw [← ConcreteCategory.comp_apply, d.w]
  have hdJ : IsColimit (d.whisker GJ) := (Functor.Final.isColimitWhiskerEquiv GJ d).symm hd
  have hsurj : ∀ r : d.pt, ∃ (j : J) (s : G.obj (GJ.obj j)),
      algebraMap (G.obj (GJ.obj j)) d.pt s = r := by
    intro r
    obtain ⟨j, y, hy⟩ := Concrete.isColimit_exists_rep (GJ ⋙ G) hdJ r
    exact ⟨j, y, hy⟩
  have hinj : ∀ (j : J) (s : G.obj (GJ.obj j)), algebraMap (G.obj (GJ.obj j)) d.pt s = 0 →
      ∃ (k : J) (hjk : j ≤ k), f j k hjk s = 0 := by
    intro j s hs
    have h0 : (d.whisker GJ).ι.app j s = (d.whisker GJ).ι.app j 0 := by
      change d.ι.app (GJ.obj j) s = d.ι.app (GJ.obj j) 0
      rwa [map_zero]
    obtain ⟨k, g₁, g₂, hg⟩ := Concrete.isColimit_exists_of_rep_eq (GJ ⋙ G) hdJ s 0 h0
    refine ⟨k, leOfHom g₁, ?_⟩
    have hg₁ : homOfLE (leOfHom g₁) = g₁ := Subsingleton.elim _ _
    have hg' : G.map (GJ.map g₁) s = G.map (GJ.map g₂) (0 : G.obj (GJ.obj j)) := hg
    change G.map (GJ.map (homOfLE (leOfHom g₁))) s = 0
    rw [hg₁, hg', map_zero]
  obtain ⟨j, hj⟩ := exists_projective_of_directed f hf hsurj hinj M
  exact ⟨GJ.obj j, hj⟩

end Filtered

end Stacks.RingFilteredColimits

end
