module

public import Mathlib.RingTheory.DedekindDomain.Different
public import Mathlib.RingTheory.DedekindDomain.PID
public import Mathlib.RingTheory.Ideal.Norm.RelNorm
public import Mathlib.RingTheory.Localization.BaseChange
public import StacksFrontier.AlgebraicGeometry.Discriminant.NormDifferent

/-!
# The discriminant of an extension of Dedekind domains is the norm of the different

Let `A → B` be a finite extension of Dedekind domains whose extension of fraction fields is
separable. Then `B` is finite projective over `A`, and its discriminant ideal — the zeroth Fitting
ideal of the cokernel of the trace pairing `B → Hom_A(B, A)`, the ideal defining the discriminant
of the finite locally free morphism `Spec(B) → Spec(A)` — is the relative norm of the Dedekind
different `𝔇_{B/A}`.

## Main results

* `FractionalIdeal.mem_dual_one_iff`: membership in the trace dual of `B` tested on `B`.
* `Stacks.Discriminant.algebraDiscriminantIdeal_eq_relNorm_differentIdeal_of_free`: the identity
  when `B` is free over `A` and the different is principal.
* `differentIdeal_eq_map_of_isLocalization`: the different commutes with localization of the
  base.
* `Stacks.Discriminant.algebraDiscriminantIdeal_eq_relNorm_differentIdeal`: the discriminant ideal
  is the relative norm of the different.

## Implementation notes

Both sides are compared after localizing at each maximal ideal `𝔭` of `A`. The discriminant ideal
commutes with base change (`Stacks.Discriminant.algebraDiscriminantIdeal_map`), the relative norm
commutes with localization (`Ideal.spanIntNorm_localization`), and so does the different
(`differentIdeal_eq_map_of_isLocalization`). Over the discrete valuation ring `A_𝔭` the
localization `B_𝔭` is free and a principal ideal domain, where the free case applies. The case of
a field `A` is the free case itself.

The norm is Mathlib's `Ideal.relNorm`, the ideal generated by the norms of the elements; for an
invertible ideal it is, locally on `A`, generated by the norm of a local generator, which is the
norm of the effective Cartier divisor it defines.

## References

* [The Stacks Project, Tag 024Z](https://stacks.math.columbia.edu/tag/024Z)
* [The Stacks Project, Tag 0BWA](https://stacks.math.columbia.edu/tag/0BWA)
-/

@[expose] public noncomputable section

open scoped nonZeroDivisors TensorProduct

universe u v

open Algebra FractionalIdeal

attribute [local instance] FractionRing.liftAlgebra

/-- Membership in the trace dual of `B`, tested against the elements of `B`. -/
theorem FractionalIdeal.mem_dual_one_iff {A K L B : Type*} [CommRing A] [Field K] [CommRing B]
    [Field L] [Algebra A K] [Algebra B L] [Algebra A B] [Algebra K L] [Algebra A L]
    [IsScalarTower A K L] [IsScalarTower A B L] [IsDomain A] [IsFractionRing A K]
    [FiniteDimensional K L] [Algebra.IsSeparable K L] [IsIntegralClosure B A L]
    [IsFractionRing B L] [IsIntegrallyClosed A] [IsDedekindDomain B] (y : L) :
    y ∈ dual A K (1 : FractionalIdeal B⁰ L) ↔
      ∀ x : B, Algebra.trace K L (y * algebraMap B L x) ∈ (algebraMap A K).range := by
  rw [mem_dual (one_ne_zero (α := FractionalIdeal B⁰ L))]
  refine ⟨fun hy x => hy _ ((mem_one_iff _).mpr ⟨x, rfl⟩), fun hy a ha => ?_⟩
  obtain ⟨x, rfl⟩ := (mem_one_iff _).mp ha
  exact hy x

/-- Multiplying by the image of `a : A` in `L` is the scalar action of its image in `K`. -/
private theorem algebraMap_mul_eq_algebraMap_smul {A : Type*} (K L : Type*) [CommSemiring A]
    [CommSemiring K] [CommSemiring L] [Algebra A K] [Algebra K L] [Algebra A L]
    [IsScalarTower A K L] (a : A) (z : L) : algebraMap A L a * z = algebraMap A K a • z := by
  rw [Algebra.smul_def, ← IsScalarTower.algebraMap_apply]

/-- If `u * m = b` in `B_M`, then `u * m = b` in `L`. -/
private theorem algebraMap_mul_algebraMap_eq_of_mul_eq {A B Bₘ L : Type*} [CommSemiring A]
    [CommSemiring B] [CommSemiring Bₘ] [CommSemiring L] [Algebra A B] [Algebra B Bₘ]
    [Algebra B L] [Algebra Bₘ L] [Algebra A L] [IsScalarTower A B L] [IsScalarTower B Bₘ L]
    (m : A) (u : Bₘ) (b : B) (h : u * algebraMap B Bₘ (algebraMap A B m) = algebraMap B Bₘ b) :
    algebraMap Bₘ L u * algebraMap A L m = algebraMap B L b := by
  rw [IsScalarTower.algebraMap_apply A B L, IsScalarTower.algebraMap_apply B Bₘ L, ← map_mul, h,
    ← IsScalarTower.algebraMap_apply]

namespace Stacks.Discriminant

attribute [local instance] algebraDualModule

/-- A nonzero element of `L` pairs nontrivially with `B` under `Tr_{L/K}`. -/
private theorem eq_zero_of_forall_trace_mul_algebraMap_eq_zero
    (A : Type u) (B : Type v) [CommRing A] [CommRing B] [Algebra A B]
    [IsDedekindDomain A] [IsDedekindDomain B] [Module.Finite A B] [Module.IsTorsionFree A B]
    (K L : Type*) [Field K] [Field L] [Algebra A K] [IsFractionRing A K] [Algebra B L]
    [IsFractionRing B L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [IsScalarTower A B L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L] {z : L}
    (hz : ∀ x : B, Algebra.trace K L (z * algebraMap B L x) = 0) : z = 0 := by
  have : IsIntegralClosure B A L := IsIntegralClosure.of_isIntegrallyClosed B A L
  have : IsLocalization (Algebra.algebraMapSubmonoid B A⁰) L :=
    IsIntegralClosure.isLocalization A K L B
  refine (traceForm_nondegenerate K L).1 _ fun n => ?_
  obtain ⟨⟨x, s⟩, hs⟩ := IsLocalization.surj (Algebra.algebraMapSubmonoid B A⁰) n
  obtain ⟨a, ha, hsa⟩ := s.2
  have key : algebraMap A K a • Algebra.trace K L (z * n) = 0 := by
    rw [← map_smul, Algebra.smul_def, ← IsScalarTower.algebraMap_apply A K L,
      IsScalarTower.algebraMap_apply A B L, hsa, mul_comm, mul_assoc, hs, hz]
  rw [Algebra.traceForm_apply]
  exact (smul_eq_zero.mp key).resolve_left
    ((map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr (nonZeroDivisors.ne_zero ha))

/-- An element of the trace dual of `B` defines the `A`-linear functional `Tr_{L/K}(y · -)`
on `B`. -/
private theorem exists_dual_algebraMap_eq_trace_of_mem_dual
    (A : Type u) (B : Type v) [CommRing A] [CommRing B] [Algebra A B]
    [IsDedekindDomain A] [IsDedekindDomain B] [Module.Finite A B] [Module.IsTorsionFree A B]
    (K L : Type*) [Field K] [Field L] [Algebra A K] [IsFractionRing A K] [Algebra B L]
    [IsFractionRing B L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [IsScalarTower A B L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L] (y : L)
    (hy : y ∈ dual A K (1 : FractionalIdeal B⁰ L)) :
    ∃ φ : Module.Dual A B, ∀ x : B,
      algebraMap A K (φ x) = Algebra.trace K L (y * algebraMap B L x) := by
  have : IsIntegralClosure B A L := IsIntegralClosure.of_isIntegrallyClosed B A L
  have htr (x : B) : ∃ a : A, algebraMap A K a = Algebra.trace K L (y * algebraMap B L x) :=
    (FractionalIdeal.mem_dual_one_iff y).mp hy x
  choose g hg using htr
  refine ⟨{ toFun := g, map_add' := fun x x' => ?_, map_smul' := fun a x => ?_ }, hg⟩
  · apply IsFractionRing.injective A K
    rw [map_add, hg, hg, hg, map_add, mul_add, map_add]
  · apply IsFractionRing.injective A K
    rw [RingHom.id_apply, smul_eq_mul, map_mul, hg, hg, Algebra.smul_def,
      map_mul (algebraMap B L), mul_left_comm, ← IsScalarTower.algebraMap_apply A B L,
      algebraMap_mul_eq_algebraMap_smul K L, map_smul, smul_eq_mul]

/-- When `B` is free over `A`, every `A`-linear functional on `B` is `Tr_{L/K}(y · -)` for some
`y : L`. -/
private theorem exists_trace_mul_eq_of_free
    (A : Type u) (B : Type v) [CommRing A] [CommRing B] [Algebra A B]
    [IsDedekindDomain A] [IsDedekindDomain B] [Module.Finite A B] [Module.IsTorsionFree A B]
    (K L : Type*) [Field K] [Field L] [Algebra A K] [IsFractionRing A K] [Algebra B L]
    [IsFractionRing B L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [IsScalarTower A B L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L] [Module.Free A B] (φ : Module.Dual A B) :
    ∃ y : L, ∀ x : B, Algebra.trace K L (y * algebraMap B L x) = algebraMap A K (φ x) := by
  classical
  have : IsIntegralClosure B A L := IsIntegralClosure.of_isIntegrallyClosed B A L
  have : IsLocalization (Algebra.algebraMapSubmonoid B A⁰) L :=
    IsIntegralClosure.isLocalization A K L B
  let bas := Module.Free.chooseBasis A B
  let bL := bas.localizationLocalization K A⁰ L
  let dv := (Algebra.traceForm K L).dualBasis (traceForm_nondegenerate K L) bL
  let y : L := ∑ i, algebraMap A K (φ (bas i)) • dv i
  refine ⟨y, fun x => ?_⟩
  let f₁ : B →ₗ[A] K := ((Algebra.traceForm K L y).restrictScalars A).comp
    (IsScalarTower.toAlgHom A B L).toLinearMap
  let f₂ : B →ₗ[A] K := (Algebra.linearMap A K).comp φ
  have hf : f₁ = f₂ := by
    refine bas.ext fun i => ?_
    change Algebra.traceForm K L y (algebraMap B L (bas i)) = algebraMap A K (φ (bas i))
    rw [← Module.Basis.localizationLocalization_apply K A⁰ L bas i]
    simp only [y, map_sum, map_smul, LinearMap.sum_apply, LinearMap.smul_apply]
    simp only [bL, dv, LinearMap.BilinForm.apply_dualBasis_left, smul_eq_mul, mul_ite,
      mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  exact LinearMap.congr_fun hf x

/-- If the different is principal, generated by `b`, then the trace dual of `B` is generated
by `b⁻¹`. -/
private theorem dual_one_eq_spanSingleton_inv_of_differentIdeal_eq_span
    (A : Type u) (B : Type v) [CommRing A] [CommRing B] [Algebra A B]
    [IsDedekindDomain A] [IsDedekindDomain B] [Module.Finite A B] [Module.IsTorsionFree A B]
    (K L : Type*) [Field K] [Field L] [Algebra A K] [IsFractionRing A K] [Algebra B L]
    [IsFractionRing B L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [IsScalarTower A B L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L] {b : B}
    (hb : differentIdeal A B = Ideal.span {b}) :
    dual A K (1 : FractionalIdeal B⁰ L) = spanSingleton B⁰ (algebraMap B L b)⁻¹ := by
  have : IsIntegralClosure B A L := IsIntegralClosure.of_isIntegrallyClosed B A L
  have h1 := coeIdeal_differentIdeal (A := A) (K := K) (L := L) (B := B)
  rw [hb, FractionalIdeal.coeIdeal_span_singleton] at h1
  rw [← FractionalIdeal.spanSingleton_inv, h1, inv_inv]

/-- **The discriminant is the norm of the different, in the free case with principal
different.** Let `A → B` be a finite extension of Dedekind domains with `B` free over `A` and with
principal different `𝔇_{B/A} = (b)`. Then the discriminant ideal of `B` over `A` is generated by
the norm of `b`, so it is the relative norm of the different.

The functional `λ = Tr_{L/K}(b⁻¹ · -)` takes values in `A`, because `b⁻¹` generates the trace
dual `𝔇_{B/A}⁻¹`; every `A`-linear functional on `B` is `Tr_{L/K}(y · -)` for some `y` in the
trace dual, so `c ↦ c • λ` identifies `B` with its `A`-linear dual, and `Tr_{B/A} = b • λ`. This is
the situation of `Stacks.Discriminant.algebraDiscriminantIdeal_eq_span_norm_of_dualGenerator`. -/
theorem algebraDiscriminantIdeal_eq_relNorm_differentIdeal_of_free
    (A : Type u) (B : Type v) [CommRing A] [CommRing B] [Algebra A B]
    [IsDedekindDomain A] [IsDedekindDomain B] [Module.Finite A B] [Module.IsTorsionFree A B]
    (K L : Type*) [Field K] [Field L] [Algebra A K] [IsFractionRing A K] [Algebra B L]
    [IsFractionRing B L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [IsScalarTower A B L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [Module.Free A B] (h : (differentIdeal A B).IsPrincipal) :
    algebraDiscriminantIdeal A B = Ideal.relNorm A (differentIdeal A B) := by
  classical
  have : IsIntegralClosure B A L := IsIntegralClosure.of_isIntegrallyClosed B A L
  have : IsLocalization (Algebra.algebraMapSubmonoid B A⁰) L :=
    IsIntegralClosure.isLocalization A K L B
  obtain ⟨b, hb⟩ := h
  have hb' : differentIdeal A B = Ideal.span {b} := hb
  have hbL : algebraMap B L b ≠ 0 := by
    rw [map_ne_zero_iff _ (IsFractionRing.injective B L)]
    rintro rfl
    have h1 := coeIdeal_differentIdeal (A := A) (K := K) (L := L) (B := B)
    rw [hb', Ideal.span_singleton_eq_bot.mpr rfl, FractionalIdeal.coeIdeal_bot,
      eq_comm, inv_eq_zero] at h1
    exact FractionalIdeal.dual_ne_zero A K (one_ne_zero (α := FractionalIdeal B⁰ L)) h1
  set binv : L := (algebraMap B L b)⁻¹ with hbinv
  have hdual : FractionalIdeal.dual A K (1 : FractionalIdeal B⁰ L) =
      FractionalIdeal.spanSingleton B⁰ binv :=
    dual_one_eq_spanSingleton_inv_of_differentIdeal_eq_span A B K L hb'
  obtain ⟨lam, hspec⟩ := exists_dual_algebraMap_eq_trace_of_mem_dual A B K L binv
    (by rw [hdual]; exact FractionalIdeal.mem_spanSingleton_self _ _)
  have htrace (x : B) : algebraMap A K (Algebra.trace A B x) =
      Algebra.trace K L (algebraMap B L x) :=
    (Algebra.trace_localization A A⁰ x).symm
  have hlamtr : finiteProjectiveTraceForm A B 1 = b • lam := by
    refine LinearMap.ext fun x => IsFractionRing.injective A K ?_
    rw [algebraDualModule_smul_apply, hspec, finiteProjectiveTraceForm_eq_traceForm,
      Algebra.traceForm_apply, one_mul, htrace, map_mul (algebraMap B L), ← mul_assoc, hbinv,
      inv_mul_cancel₀ hbL, one_mul]
  have hinj : Function.Injective fun c : B => c • lam := by
    intro c c' hcc
    have hm := eq_zero_of_forall_trace_mul_algebraMap_eq_zero A B K L
      (z := binv * algebraMap B L (c - c')) fun x => by
        have := congrArg (fun f : Module.Dual A B => algebraMap A K (f x)) hcc
        simp only [algebraDualModule_smul_apply, hspec] at this
        rw [map_sub, mul_sub, sub_mul, map_sub, mul_assoc, mul_assoc,
          ← map_mul (algebraMap B L), ← map_mul (algebraMap B L), this, sub_self]
    exact sub_eq_zero.mp ((map_eq_zero_iff _ (IsFractionRing.injective B L)).mp
      ((mul_eq_zero.mp hm).resolve_left (inv_ne_zero hbL)))
  have hsurj : Function.Surjective fun c : B => c • lam := by
    intro φ
    obtain ⟨y, hy⟩ := exists_trace_mul_eq_of_free A B K L φ
    have hymem : y ∈ FractionalIdeal.dual A K (1 : FractionalIdeal B⁰ L) :=
      (FractionalIdeal.mem_dual_one_iff y).mpr fun x => ⟨φ x, (hy x).symm⟩
    rw [hdual, FractionalIdeal.mem_spanSingleton] at hymem
    obtain ⟨c, hc⟩ := hymem
    refine ⟨c, LinearMap.ext fun x => IsFractionRing.injective A K ?_⟩
    change algebraMap A K (lam (c * x)) = _
    rw [hspec, ← hy, ← hc, Algebra.smul_def, map_mul (algebraMap B L)]
    congr 1
    ring
  rw [algebraDiscriminantIdeal_eq_span_norm_of_dualGenerator (Module.finBasis A B) lam
    ⟨hinj, hsurj⟩ hlamtr, hb', Ideal.relNorm_singleton, Algebra.intNorm_eq_norm]

end Stacks.Discriminant

/-- An element of the trace dual of `M⁻¹B` over `M⁻¹A` is a multiple of an element of the trace
dual of `B` over `A`. -/
private theorem FractionalIdeal.exists_eq_smul_of_mem_dual_one_of_isLocalization
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsDedekindDomain A] [IsDedekindDomain B] [Module.Finite A B] [Module.IsTorsionFree A B]
    (M : Submonoid A)
    (Aₘ Bₘ : Type*) [CommRing Aₘ] [CommRing Bₘ] [Algebra A Aₘ] [Algebra B Bₘ] [Algebra Aₘ Bₘ]
    [Algebra A Bₘ] [IsScalarTower A Aₘ Bₘ] [IsScalarTower A B Bₘ] [IsLocalization M Aₘ]
    [IsLocalization (Algebra.algebraMapSubmonoid B M) Bₘ] [IsDedekindDomain Aₘ]
    [IsDedekindDomain Bₘ] [Module.IsTorsionFree Aₘ Bₘ]
    (K L : Type*) [Field K] [Field L] [Algebra A K] [Algebra Aₘ K] [Algebra B L] [Algebra Bₘ L]
    [Algebra K L] [Algebra A L] [Algebra Aₘ L] [IsFractionRing A K] [IsFractionRing Aₘ K]
    [IsFractionRing B L] [IsFractionRing Bₘ L] [IsScalarTower A Aₘ K] [IsScalarTower B Bₘ L]
    [IsScalarTower A K L] [IsScalarTower A B L] [IsScalarTower Aₘ K L] [IsScalarTower Aₘ Bₘ L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L] [Module.Finite Aₘ Bₘ] {x : L}
    (hx : x ∈ dual Aₘ K (1 : FractionalIdeal Bₘ⁰ L)) :
    ∃ c : Bₘ, ∃ y ∈ dual A K (1 : FractionalIdeal B⁰ L), x = c • y := by
  classical
  have : IsIntegralClosure B A L := IsIntegralClosure.of_isIntegrallyClosed B A L
  have : IsIntegralClosure Bₘ Aₘ L := IsIntegralClosure.of_isIntegrallyClosed Bₘ Aₘ L
  obtain ⟨t, ht⟩ := Module.Finite.fg_top (R := A) (M := B)
  have hz (u : B) : ∃ z : Aₘ, algebraMap Aₘ K z = Algebra.trace K L (x * algebraMap B L u) := by
    have := (mem_dual_one_iff (A := Aₘ) (K := K) (B := Bₘ) x).mp hx (algebraMap B Bₘ u)
    rwa [← IsScalarTower.algebraMap_apply] at this
  choose z hz using hz
  obtain ⟨⟨m, hm⟩, hmz⟩ := IsLocalization.exist_integer_multiples_of_finset M (t.image z)
  choose a ha using fun u (hu : u ∈ t) => hmz (z u) (Finset.mem_image_of_mem z hu)
  set y : L := algebraMap A L m * x with hy
  have hymem : y ∈ dual A K (1 : FractionalIdeal B⁰ L) := by
    rw [mem_dual_one_iff]
    let f₁ : B →ₗ[A] K := ((Algebra.traceForm K L y).restrictScalars A).comp
      (IsScalarTower.toAlgHom A B L).toLinearMap
    let N : Submodule A B := (LinearMap.range (Algebra.linearMap A K)).comap f₁
    have hN : (⊤ : Submodule A B) ≤ N := by
      rw [← ht, Submodule.span_le]
      intro u hu
      refine ⟨a u hu, ?_⟩
      change algebraMap A K (a u hu) = Algebra.trace K L (y * algebraMap B L u)
      rw [IsScalarTower.algebraMap_apply A Aₘ K, ha u hu, Algebra.smul_def, map_mul,
        ← IsScalarTower.algebraMap_apply, hz, hy, mul_assoc,
        algebraMap_mul_eq_algebraMap_smul K L, map_smul, smul_eq_mul]
    intro u
    obtain ⟨c, hc⟩ := hN (Submodule.mem_top (x := u))
    exact ⟨c, hc⟩
  have hmB : algebraMap A B m ∈ Algebra.algebraMapSubmonoid B M := ⟨m, hm, rfl⟩
  have hspec := IsLocalization.mk'_spec Bₘ (1 : B)
    (⟨_, hmB⟩ : Algebra.algebraMapSubmonoid B M)
  have hinv : algebraMap Bₘ L (IsLocalization.mk' Bₘ (1 : B) ⟨_, hmB⟩) *
      algebraMap A L m = 1 := by
    simpa using algebraMap_mul_algebraMap_eq_of_mul_eq (L := L) m _ _ hspec
  refine ⟨IsLocalization.mk' Bₘ (1 : B) ⟨_, hmB⟩, y, hymem, ?_⟩
  rw [Algebra.smul_def, hy, ← mul_assoc, hinv, one_mul]

/-- The trace dual of `B` over `A` lies in the trace dual of `M⁻¹B` over `M⁻¹A`. -/
private theorem FractionalIdeal.mem_dual_one_of_isLocalization
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsDedekindDomain A] [IsDedekindDomain B] [Module.Finite A B] [Module.IsTorsionFree A B]
    (M : Submonoid A) (hM : M ≤ A⁰)
    (Aₘ Bₘ : Type*) [CommRing Aₘ] [CommRing Bₘ] [Algebra A Aₘ] [Algebra B Bₘ] [Algebra Aₘ Bₘ]
    [Algebra A Bₘ] [IsScalarTower A Aₘ Bₘ] [IsScalarTower A B Bₘ] [IsLocalization M Aₘ]
    [IsLocalization (Algebra.algebraMapSubmonoid B M) Bₘ] [IsDedekindDomain Aₘ]
    [IsDedekindDomain Bₘ] [Module.IsTorsionFree Aₘ Bₘ]
    (K L : Type*) [Field K] [Field L] [Algebra A K] [Algebra Aₘ K] [Algebra B L] [Algebra Bₘ L]
    [Algebra K L] [Algebra A L] [Algebra Aₘ L] [IsFractionRing A K] [IsFractionRing Aₘ K]
    [IsFractionRing B L] [IsFractionRing Bₘ L] [IsScalarTower A Aₘ K] [IsScalarTower B Bₘ L]
    [IsScalarTower A K L] [IsScalarTower A B L] [IsScalarTower Aₘ K L] [IsScalarTower Aₘ Bₘ L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L] [Module.Finite Aₘ Bₘ] {y : L}
    (hy : y ∈ dual A K (1 : FractionalIdeal B⁰ L)) :
    y ∈ dual Aₘ K (1 : FractionalIdeal Bₘ⁰ L) := by
  have : IsIntegralClosure B A L := IsIntegralClosure.of_isIntegrallyClosed B A L
  have : IsIntegralClosure Bₘ Aₘ L := IsIntegralClosure.of_isIntegrallyClosed Bₘ Aₘ L
  rw [mem_dual_one_iff]
  intro u
  obtain ⟨⟨s, _, m, hm, rfl⟩, hs⟩ :=
    IsLocalization.surj (Algebra.algebraMapSubmonoid B M) u
  obtain ⟨a, ha⟩ := (mem_dual_one_iff y).mp hy s
  refine ⟨IsLocalization.mk' Aₘ a ⟨m, hm⟩, ?_⟩
  apply mul_right_cancel₀ (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (hM hm))
  have h1 : algebraMap Bₘ L u * algebraMap A L m = algebraMap B L s := by
    exact algebraMap_mul_algebraMap_eq_of_mul_eq m u s hs
  rw [IsScalarTower.algebraMap_apply A Aₘ K m, ← map_mul, IsLocalization.mk'_spec,
    ← IsScalarTower.algebraMap_apply, ha, ← IsScalarTower.algebraMap_apply A Aₘ K m, ← h1,
    ← mul_assoc, mul_comm (y * _) (algebraMap A L m),
    algebraMap_mul_eq_algebraMap_smul K L, map_smul, smul_eq_mul,
    mul_comm]

/-- **The different commutes with localization of the base.** For a finite extension `A → B`
of Dedekind domains with separable extension of fraction fields and a submonoid `M` of
nonzerodivisors of `A`, the different of `M⁻¹B` over `M⁻¹A` is the extension of the different of
`B` over `A`: the trace dual of `M⁻¹B` over `M⁻¹A` is generated by the trace dual of `B` over `A`,
and extension of fractional ideals commutes with inverses. -/
theorem differentIdeal_eq_map_of_isLocalization
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsDedekindDomain A] [IsDedekindDomain B] [Module.Finite A B] [Module.IsTorsionFree A B]
    (M : Submonoid A) (hM : M ≤ A⁰)
    (Aₘ Bₘ : Type*) [CommRing Aₘ] [CommRing Bₘ] [Algebra A Aₘ] [Algebra B Bₘ] [Algebra Aₘ Bₘ]
    [Algebra A Bₘ] [IsScalarTower A Aₘ Bₘ] [IsScalarTower A B Bₘ] [IsLocalization M Aₘ]
    [IsLocalization (Algebra.algebraMapSubmonoid B M) Bₘ] [IsDedekindDomain Aₘ]
    [IsDedekindDomain Bₘ] [Module.IsTorsionFree Aₘ Bₘ]
    (K L : Type*) [Field K] [Field L] [Algebra A K] [Algebra Aₘ K] [Algebra B L] [Algebra Bₘ L]
    [Algebra K L] [Algebra A L] [Algebra Aₘ L] [IsFractionRing A K] [IsFractionRing Aₘ K]
    [IsFractionRing B L] [IsFractionRing Bₘ L] [IsScalarTower A Aₘ K] [IsScalarTower B Bₘ L]
    [IsScalarTower A K L] [IsScalarTower A B L] [IsScalarTower Aₘ K L] [IsScalarTower Aₘ Bₘ L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L] :
    differentIdeal Aₘ Bₘ = (differentIdeal A B).map (algebraMap B Bₘ) := by
  classical
  have : IsIntegralClosure B A L := IsIntegralClosure.of_isIntegrallyClosed B A L
  have : Module.Finite Aₘ Bₘ := Module.Finite.of_isLocalization A B M
  have : IsIntegralClosure Bₘ Aₘ L := IsIntegralClosure.of_isIntegrallyClosed Bₘ Aₘ L
  have hf : B⁰ ≤ Submonoid.comap (algebraMap B Bₘ) Bₘ⁰ :=
    nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _
      (IsLocalization.injective Bₘ (algebraMapSubmonoid_le_nonZeroDivisors_of_faithfulSMul B hM))
  -- the map of fraction fields induced by `B → Bₘ` is the identity of `L`
  have hid : (IsLocalization.map L (algebraMap B Bₘ) hf : L →+* L) = RingHom.id L := by
    apply IsLocalization.ringHom_ext B⁰
    ext b
    rw [RingHom.comp_apply, IsLocalization.map_eq, RingHom.comp_apply, RingHom.id_apply,
      ← IsScalarTower.algebraMap_apply]
  -- the trace dual of `Bₘ` over `Aₘ` is generated by the trace dual of `B` over `A`
  have hdual : dual Aₘ K (1 : FractionalIdeal Bₘ⁰ L) =
      (dual A K (1 : FractionalIdeal B⁰ L)).extended L hf := by
    ext x
    rw [mem_extended_iff, hid, RingHom.coe_id, Set.image_id]
    constructor
    · intro hx
      obtain ⟨c, y, hy, rfl⟩ :=
        exists_eq_smul_of_mem_dual_one_of_isLocalization (B := B) M Aₘ Bₘ K L hx
      exact Submodule.smul_mem _ _ (Submodule.subset_span hy)
    · intro hx
      refine Submodule.span_le.mpr (fun y hy => ?_) hx
      change y ∈ dual Aₘ K (1 : FractionalIdeal Bₘ⁰ L)
      exact mem_dual_one_of_isLocalization (B := B) M hM Aₘ Bₘ K L hy
  rw [← coeIdeal_inj (K := L), coeIdeal_differentIdeal Aₘ K L Bₘ,
    ← extended_coeIdeal_eq_map (K := L) L hf, coeIdeal_differentIdeal A K L B, hdual,
    ← extendedHom'_apply (K := L) L hf, ← extendedHom'_apply (K := L) L hf, map_inv₀]

namespace Stacks.Discriminant

/-- **The discriminant is the norm of the different, locally.** If `M⁻¹B` is free over `M⁻¹A`
and a principal ideal domain, the discriminant ideal and the relative norm of the different of
`B` over `A` have the same extension to `M⁻¹A`. -/
private theorem algebraDiscriminantIdeal_map_eq_relNorm_map_of_isLocalization
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsDedekindDomain A] [IsDedekindDomain B] [Module.Finite A B] [Module.IsTorsionFree A B]
    (M : Submonoid A) (hM : M ≤ A⁰)
    (Aₘ Bₘ : Type*) [CommRing Aₘ] [CommRing Bₘ] [Algebra A Aₘ] [Algebra B Bₘ] [Algebra Aₘ Bₘ]
    [Algebra A Bₘ] [IsScalarTower A Aₘ Bₘ] [IsScalarTower A B Bₘ] [IsLocalization M Aₘ]
    [IsLocalization (Algebra.algebraMapSubmonoid B M) Bₘ] [IsDedekindDomain Aₘ]
    [IsDedekindDomain Bₘ] [Module.IsTorsionFree Aₘ Bₘ]
    (K L : Type*) [Field K] [Field L] [Algebra A K] [Algebra Aₘ K] [Algebra B L] [Algebra Bₘ L]
    [Algebra K L] [Algebra A L] [Algebra Aₘ L] [IsFractionRing A K] [IsFractionRing Aₘ K]
    [IsFractionRing B L] [IsFractionRing Bₘ L] [IsScalarTower A Aₘ K] [IsScalarTower B Bₘ L]
    [IsScalarTower A K L] [IsScalarTower A B L] [IsScalarTower Aₘ K L] [IsScalarTower Aₘ Bₘ L]
    [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [Module.Free Aₘ Bₘ] [IsPrincipalIdealRing Bₘ] :
    (algebraDiscriminantIdeal A B).map (algebraMap A Aₘ) =
      (Ideal.relNorm A (differentIdeal A B)).map (algebraMap A Aₘ) := by
  have : Module.FinitePresentation A B := Module.finitePresentation_of_finite A B
  have : Module.Projective A B := Module.Flat.projective_of_finitePresentation
  have : Module.Finite Aₘ Bₘ := Module.Finite.of_isLocalization A B M
  have : Algebra.IsPushout A Aₘ B Bₘ := (Algebra.isPushout_of_isLocalization M Aₘ B Bₘ).symm
  calc (algebraDiscriminantIdeal A B).map (algebraMap A Aₘ)
      = algebraDiscriminantIdeal Aₘ (Aₘ ⊗[A] B) := algebraDiscriminantIdeal_map A B Aₘ
    _ = algebraDiscriminantIdeal Aₘ Bₘ :=
      algebraDiscriminantIdeal_algEquiv Aₘ _ _ (Algebra.IsPushout.equiv A Aₘ B Bₘ)
    _ = Ideal.relNorm Aₘ (differentIdeal Aₘ Bₘ) :=
      algebraDiscriminantIdeal_eq_relNorm_differentIdeal_of_free Aₘ Bₘ K L
        (IsPrincipalIdealRing.principal _)
    _ = Ideal.relNorm Aₘ ((differentIdeal A B).map (algebraMap B Bₘ)) := by
      rw [differentIdeal_eq_map_of_isLocalization (B := B) M hM Aₘ Bₘ K L]
    _ = (Ideal.relNorm A (differentIdeal A B)).map (algebraMap A Aₘ) := by
      rw [← Ideal.spanNorm_eq, ← Ideal.spanNorm_eq,
        Ideal.spanIntNorm_localization A (differentIdeal A B) M hM (Rₘ := Aₘ) Bₘ]

/-- **The discriminant is the norm of the different.** For a finite extension `A → B` of
Dedekind domains with separable extension of fraction fields, the discriminant ideal of `B` over
`A` (the zeroth Fitting ideal of the cokernel of the trace pairing) is the relative norm of the
Dedekind different. -/
theorem algebraDiscriminantIdeal_eq_relNorm_differentIdeal
    (A : Type u) (B : Type v) [CommRing A] [CommRing B] [Algebra A B]
    [IsDedekindDomain A] [IsDedekindDomain B] [Module.Finite A B] [Module.IsTorsionFree A B]
    [Algebra.IsSeparable (FractionRing A) (FractionRing B)] :
    algebraDiscriminantIdeal A B = Ideal.relNorm A (differentIdeal A B) := by
  classical
  have : FiniteDimensional (FractionRing A) (FractionRing B) := .of_isLocalization A B A⁰
  by_cases hA : IsField A
  · have : IsPrincipalIdealRing A := hA.isPrincipalIdealRing
    have : Module.Free A B := Module.free_of_finite_type_torsion_free'
    have hB : IsField B := (Algebra.IsIntegral.isField_iff_isField
      (FaithfulSMul.algebraMap_injective A B)).mp hA
    exact algebraDiscriminantIdeal_eq_relNorm_differentIdeal_of_free A B
      (FractionRing A) (FractionRing B) (hB.isPrincipalIdealRing.principal _)
  refine Ideal.eq_of_localization_maximal fun P hP => ?_
  have hP0 : P ≠ ⊥ := fun h => hA (Ring.isField_iff_maximal_bot.mpr (h ▸ hP))
  let M := P.primeCompl
  have hM : M ≤ A⁰ := P.primeCompl_le_nonZeroDivisors
  let Aₘ := Localization.AtPrime P
  let Bₘ := Localization (Algebra.algebraMapSubmonoid B M)
  let K := FractionRing A
  let L := FractionRing B
  have hMB := algebraMapSubmonoid_le_nonZeroDivisors_of_faithfulSMul B hM
  let f : Aₘ →+* K := IsLocalization.map _ (T := A⁰) (RingHom.id A) hM
  let g : Bₘ →+* L := IsLocalization.map _ (M := Algebra.algebraMapSubmonoid B M) (T := B⁰)
      (RingHom.id B) hMB
  algebraize [f, g, (algebraMap K L).comp f]
  have : IsScalarTower A Aₘ K := IsScalarTower.of_algebraMap_eq fun a =>
    (IsLocalization.map_eq (Q := K) (g := RingHom.id A) (T := A⁰) hM a).symm
  have : IsFractionRing Aₘ K := IsFractionRing.isFractionRing_of_isDomain_of_isLocalization M Aₘ K
  have : IsScalarTower B Bₘ L := IsScalarTower.of_algebraMap_eq fun b =>
    (IsLocalization.map_eq (Q := L) (g := RingHom.id B) (T := B⁰) hMB b).symm
  have : IsScalarTower A Aₘ L := IsScalarTower.of_algebraMap_eq fun a => by
    rw [IsScalarTower.algebraMap_apply Aₘ K L, ← IsScalarTower.algebraMap_apply A Aₘ K,
      ← IsScalarTower.algebraMap_apply A K L]
  have : IsScalarTower Aₘ Bₘ L := by
    apply IsScalarTower.of_algebraMap_eq'
    apply IsLocalization.ringHom_ext M
    ext a
    simp only [RingHom.comp_apply]
    rw [← IsScalarTower.algebraMap_apply A Aₘ L, ← IsScalarTower.algebraMap_apply A Aₘ Bₘ,
      IsScalarTower.algebraMap_apply A B Bₘ, ← IsScalarTower.algebraMap_apply B Bₘ L]
    exact IsScalarTower.algebraMap_apply A B L a
  have : IsFractionRing Bₘ L :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
      (Algebra.algebraMapSubmonoid B M) Bₘ L
  have : FiniteDimensional K L := .of_isLocalization A B A⁰
  have : IsDomain Bₘ := IsLocalization.isDomain_localization hMB
  have : IsDedekindDomain Aₘ := IsLocalization.AtPrime.isDedekindDomain A P Aₘ
  have : IsDedekindDomain Bₘ := IsLocalization.isDedekindDomain B hMB Bₘ
  have : Module.IsTorsionFree Aₘ Bₘ := Module.IsTorsionFree.of_isLocalization A B hM
  have : Module.Finite Aₘ Bₘ := Module.Finite.of_isLocalization A B M
  have : IsDiscreteValuationRing Aₘ :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain A hP0 Aₘ
  have : Module.Free Aₘ Bₘ := Module.free_of_finite_type_torsion_free'
  have : IsPrincipalIdealRing Bₘ :=
    IsDedekindDomain.isPrincipalIdealRing_localization_over_prime B P hP0
  exact algebraDiscriminantIdeal_map_eq_relNorm_map_of_isLocalization (B := B) M hM Aₘ Bₘ K L

end Stacks.Discriminant
