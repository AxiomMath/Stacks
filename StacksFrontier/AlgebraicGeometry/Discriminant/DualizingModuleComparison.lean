module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Discriminant.DualizingModuleChange

/-!
# The relative dualizing module does not depend on the finite-open factorization

Let `A → B` be a quasi-finite map of Noetherian rings. A finite-open factorization
`A → B' → B` determines a relative dualizing module `ω = Hom_A(B', A) ⊗_{B'} B`, and this file
proves that two such factorizations give canonically isomorphic modules over `B`.

The comparison is built from the *common subalgebra* of the target: the subalgebra generated by
the images of the two intermediate algebras. It is finite over `A` because `A` is Noetherian,
and both factorizations compute `ω` through it, by
`Stacks.Discriminant.finiteSubalgebraChangeToF`. The comparison is characterized on pure tensors
whose functional comes from a common refinement, and the comparisons are reflexive and
transitive, so they identify the dualizing modules coherently.

## Main definitions

* `Stacks.Discriminant.commonSubalgebra` is the subalgebra of the target generated by the images
  of two intermediate algebras, with `Stacks.Discriminant.commonSubalgebra_fromF` and
  `Stacks.Discriminant.commonSubalgebra_fromG` the maps into it.
* `Stacks.Discriminant.commonRefinementSubalgebra` is the corresponding subalgebra of a common
  refinement.
* `Stacks.Discriminant.dualizingModuleEquiv` is the canonical comparison of the two dualizing
  modules.

## Main results

* `Stacks.Discriminant.dualizingModuleEquiv_tmul`: the comparison carries a pure tensor whose
  functional is restricted from a common refinement to the pure tensor of the same functional
  restricted along the other factorization.
* `Stacks.Discriminant.dualizingModuleEquiv_refl` and
  `Stacks.Discriminant.dualizingModuleEquiv_trans`: the comparisons are coherent.

## Implementation notes

The source states that the two dualizing modules are equal; here the canonical identification is
a linear equivalence. The intermediate algebra of a factorization is allowed to live in its own
universe, so the subalgebra condition of the common refinement is recorded as injectivity of its
map to the target rather than as a subalgebra inclusion. An explicit finite-open factorization
already witnesses quasi-finiteness of the map, so no separate hypothesis is needed.

## References

* [Stacks Project, Tag 0BT1](https://stacks.math.columbia.edu/tag/0BT1)
-/

@[expose] public section

universe u v w x y

namespace Stacks.Discriminant

open scoped TensorProduct

/-- The subalgebra of the target generated by the images of the two intermediate algebras of
two finite-open factorizations. -/
def commonSubalgebra
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B) : Subalgebra A B :=
  (IsScalarTower.toAlgHom A F.middle B).range ⊔
    (IsScalarTower.toAlgHom A G.middle B).range

/-- Over a Noetherian base the common subalgebra of two finite-open factorizations is again
finite. -/
theorem commonSubalgebra_finite
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B) :
    Module.Finite A (commonSubalgebra F G) := by
  let f := IsScalarTower.toAlgHom A F.middle B
  let g := IsScalarTower.toAlgHom A G.middle B
  let : Module.Finite A f.range := Module.Finite.range f.toLinearMap
  let : Module.Finite A g.range := Module.Finite.range g.toLinearMap
  dsimp [commonSubalgebra]
  exact Subalgebra.finite_sup f.range g.range

/-- The first intermediate algebra maps to the common subalgebra. -/
def commonSubalgebra_fromF
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B) :
    F.middle →ₐ[A] commonSubalgebra F G := by
  let f := IsScalarTower.toAlgHom A F.middle B
  exact f.codRestrict (commonSubalgebra F G) (fun z =>
    (SetLike.le_def.mp (show f.range ≤ commonSubalgebra F G from le_sup_left))
      (f.mem_range_self z))

/-- The second intermediate algebra maps to the common subalgebra. -/
def commonSubalgebra_fromG
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B) :
    G.middle →ₐ[A] commonSubalgebra F G := by
  let g := IsScalarTower.toAlgHom A G.middle B
  exact g.codRestrict (commonSubalgebra F G) (fun z =>
    (SetLike.le_def.mp (show g.range ≤ commonSubalgebra F G from le_sup_right))
      (g.mem_range_self z))

/-- The map of the first intermediate algebra into the common subalgebra is compatible with
the maps to the target. -/
theorem commonSubalgebra_fromF_comp_val
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B) :
    (commonSubalgebra F G).val.comp (commonSubalgebra_fromF F G) =
      IsScalarTower.toAlgHom A F.middle B := by
  simp [commonSubalgebra_fromF]

/-- The map of the second intermediate algebra into the common subalgebra is compatible with
the maps to the target. -/
theorem commonSubalgebra_fromG_comp_val
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B) :
    (commonSubalgebra F G).val.comp (commonSubalgebra_fromG F G) =
      IsScalarTower.toAlgHom A G.middle B := by
  simp [commonSubalgebra_fromG]

/-- The subalgebra of a common refinement `H` generated by the images of the two intermediate
algebras. -/
def commonRefinementSubalgebra
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    {H : Type y} [CommRing H] [Algebra A H]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B)
    (rF : F.middle →ₐ[A] H) (rG : G.middle →ₐ[A] H) : Subalgebra A H :=
  Algebra.adjoin A (Set.range rF ∪ Set.range rG)

/-- The subalgebra generated inside a finite common refinement by the two intermediate algebras
is itself finite over the base. -/
theorem commonRefinementSubalgebra_finite
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A]
    {H : Type y} [CommRing H] [Algebra A H] [Module.Finite A H]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B)
    (rF : F.middle →ₐ[A] H) (rG : G.middle →ₐ[A] H) :
    Module.Finite A (commonRefinementSubalgebra F G rF rG) :=
  Module.Finite.of_injective (commonRefinementSubalgebra F G rF rG).val.toLinearMap
    Subtype.val_injective

/-- When a common refinement embeds in the target, the subalgebra it generates from the two
intermediate algebras is the common subalgebra of the target. -/
noncomputable def commonRefinementToCommonSubalgebra
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A]
    {H : Type y} [CommRing H] [Algebra A H] [Algebra H B]
    [IsScalarTower A H B] [Module.Finite A H]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B)
    (rF : F.middle →ₐ[A] H) (rG : G.middle →ₐ[A] H)
    (hF : ∀ c, algebraMap H B (rF c) = algebraMap F.middle B c)
    (hG : ∀ c, algebraMap H B (rG c) = algebraMap G.middle B c)
    (hH : Function.Injective (algebraMap H B)) :
    let D := commonRefinementSubalgebra F G rF rG
    D ≃ₐ[A] commonSubalgebra F G := by
  classical
  let D := commonRefinementSubalgebra F G rF rG
  let C := commonSubalgebra F G
  let s : H →ₐ[A] B := IsScalarTower.toAlgHom A H B
  have hD : ∀ z : D, s z.val ∈ C := by
    intro z
    exact Algebra.adjoin_induction (R := A) (A := H)
      (s := Set.range rF ∪ Set.range rG) (p := fun z _ => s z ∈ C)
      (by
        intro z hz
        rcases hz with ⟨c, rfl⟩ | ⟨c, rfl⟩
        · change algebraMap H B (rF c) ∈ _
          rw [hF c]
          exact (show (IsScalarTower.toAlgHom A F.middle B).range ≤
              (IsScalarTower.toAlgHom A F.middle B).range ⊔
                (IsScalarTower.toAlgHom A G.middle B).range from le_sup_left)
            ((IsScalarTower.toAlgHom A F.middle B).mem_range_self c)
        · change algebraMap H B (rG c) ∈ _
          rw [hG c]
          exact (show (IsScalarTower.toAlgHom A G.middle B).range ≤
              (IsScalarTower.toAlgHom A F.middle B).range ⊔
                (IsScalarTower.toAlgHom A G.middle B).range from le_sup_right)
            ((IsScalarTower.toAlgHom A G.middle B).mem_range_self c))
      (by
        intro a
        rw [s.commutes]
        exact C.algebraMap_mem a)
      (fun _ _ _ _ ha hb => by simpa only [map_add] using C.add_mem ha hb)
      (fun _ _ _ _ ha hb => by simpa only [map_mul] using C.mul_mem ha hb) z.property
  let f : D →ₐ[A] C := (s.comp D.val).codRestrict C hD
  let fB : D →ₐ[A] B := s.comp D.val
  have hf : Function.Bijective f := by
    refine ⟨fun d₁ d₂ h => Subtype.ext (hH (congrArg Subtype.val h)), fun c => ?_⟩
    have hFle : (IsScalarTower.toAlgHom A F.middle B).range ≤ fB.range := by
      intro b hb
      rcases (IsScalarTower.toAlgHom A F.middle B).mem_range.mp hb with ⟨a, rfl⟩
      apply fB.mem_range.mpr
      exact ⟨⟨rF a, Algebra.subset_adjoin (R := A)
        (Or.inl ⟨a, rfl⟩ : rF a ∈ Set.range rF ∪ Set.range rG)⟩, hF a⟩
    have hGle : (IsScalarTower.toAlgHom A G.middle B).range ≤ fB.range := by
      intro b hb
      rcases (IsScalarTower.toAlgHom A G.middle B).mem_range.mp hb with ⟨a, rfl⟩
      apply fB.mem_range.mpr
      exact ⟨⟨rG a, Algebra.subset_adjoin (R := A)
        (Or.inr ⟨a, rfl⟩ : rG a ∈ Set.range rF ∪ Set.range rG)⟩, hG a⟩
    have hC : C ≤ fB.range := by
      dsimp [C, commonSubalgebra]
      exact sup_le hFle hGle
    rcases fB.mem_range.mp (hC c.property) with ⟨d, hd⟩
    exact ⟨d, Subtype.ext hd⟩
  exact AlgEquiv.ofBijective f hf

/-- The common subalgebra of the target, transported into a common refinement that embeds in the
target. -/
noncomputable def commonRefinementIntoH
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A]
    {H : Type y} [CommRing H] [Algebra A H] [Algebra H B]
    [IsScalarTower A H B] [Module.Finite A H]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B)
    (rF : F.middle →ₐ[A] H) (rG : G.middle →ₐ[A] H)
    (hF : ∀ c, algebraMap H B (rF c) = algebraMap F.middle B c)
    (hG : ∀ c, algebraMap H B (rG c) = algebraMap G.middle B c)
    (hH : Function.Injective (algebraMap H B)) :
    let _D := commonRefinementSubalgebra F G rF rG
    commonSubalgebra F G →ₐ[A] H := by
  let e := commonRefinementToCommonSubalgebra F G rF rG hF hG hH
  let D := commonRefinementSubalgebra F G rF rG
  exact D.val.comp e.symm.toAlgHom

/-- **Stacks Project, Tag 0BT1.** The dualizing modules obtained from any two
finite-open factorizations are canonically equivalent as modules over the target. -/
@[stacks 0BT1 "canonical comparison"]
noncomputable def dualizingModuleEquiv
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B) :
    dualizingModule F ≃ₗ[B] dualizingModule G := by
  let C := commonSubalgebra F G
  let hfin := commonSubalgebra_finite F G
  let eF := finiteSubalgebraChangeToF F C (commonSubalgebra_fromF F G)
    (commonSubalgebra_fromF_comp_val F G) hfin
  let eG := finiteSubalgebraChangeToF G C (commonSubalgebra_fromG F G)
    (commonSubalgebra_fromG_comp_val F G) hfin
  exact eF.symm.trans eG

/-- The canonical comparison on a pure tensor whose functional is restricted from any finite
algebra `K` that dominates both intermediate algebras and embeds in the target. This is the
form of `Stacks.Discriminant.dualizingModuleEquiv_tmul` that does not require `K` to be the
intermediate algebra of a factorization. -/
theorem canonicalDualizingModuleEquiv_tmul_of_commonRefinement
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A]
    {K : Type y} [CommRing K] [Algebra A K] [Algebra K B]
    [IsScalarTower A K B] [Module.Finite A K]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B)
    (hK : Function.Injective (algebraMap K B))
    (rF : F.middle →ₐ[A] K) (rG : G.middle →ₐ[A] K)
    (hF : ∀ c : F.middle, algebraMap K B (rF c) = algebraMap F.middle B c)
    (hG : ∀ c : G.middle, algebraMap K B (rG c) = algebraMap G.middle B c)
    (φ : Module.Dual A K) (b : B) :
    dualizingModuleEquiv F G
        (dualizingModule.tmul F (φ.comp rF.toLinearMap) b) =
      dualizingModule.tmul G (φ.comp rG.toLinearMap) b := by
  let C := commonSubalgebra F G
  let hfin := commonSubalgebra_finite F G
  let rFc := commonSubalgebra_fromF F G
  let rGc := commonSubalgebra_fromG F G
  let e := commonRefinementToCommonSubalgebra F G rF rG hF hG hK
  let D := commonRefinementSubalgebra F G rF rG
  let j : C →ₐ[A] K := D.val.comp e.symm.toAlgHom
  let φC : Module.Dual A C := φ.comp j.toLinearMap
  let eF := finiteSubalgebraChangeToF F C rFc (commonSubalgebra_fromF_comp_val F G) hfin
  let eG := finiteSubalgebraChangeToF G C rGc (commonSubalgebra_fromG_comp_val F G) hfin
  let : Module C (Module.Dual A C) := algebraDualModule A C
  have hj (c : C) : algebraMap K B (j c) = C.val c := by
    show (IsScalarTower.toAlgHom A K B) (D.val (e.symm c)) = c.val
    exact congrArg C.val (e.apply_symm_apply c)
  have hjF (c : F.middle) : j (rFc c) = rF c := hK <| by
    rw [hj, hF]
    exact congrArg (fun f : F.middle →ₐ[A] B => f c) (commonSubalgebra_fromF_comp_val F G)
  have hjG (c : G.middle) : j (rGc c) = rG c := hK <| by
    rw [hj, hG]
    exact congrArg (fun f : G.middle →ₐ[A] B => f c) (commonSubalgebra_fromG_comp_val F G)
  have hFunctionalF : φC.comp rFc.toLinearMap = φ.comp rF.toLinearMap := by
    ext c
    exact congrArg φ (hjF c)
  have hFunctionalG : φC.comp rGc.toLinearMap = φ.comp rG.toLinearMap := by
    ext c
    exact congrArg φ (hjG c)
  have hFtmul : eF (φC ⊗ₜ[C] b) = dualizingModule.tmul F (φ.comp rF.toLinearMap) b := by
    simpa [eF, hFunctionalF] using finiteSubalgebraChangeToF_tmul F C rFc
      (commonSubalgebra_fromF_comp_val F G) hfin φC b
  have hGtmul : eG (φC ⊗ₜ[C] b) = dualizingModule.tmul G (φ.comp rG.toLinearMap) b := by
    simpa [eG, hFunctionalG] using finiteSubalgebraChangeToF_tmul G C rGc
      (commonSubalgebra_fromG_comp_val F G) hfin φC b
  rw [dualizingModuleEquiv, ← hFtmul]
  simpa [eF, eG, C, rFc, rGc, hfin, LinearEquiv.trans_apply,
    LinearEquiv.symm_apply_apply] using hGtmul

/-- The canonical comparison carries a tensor arising from a functional on a common finite-open
refinement inside the target to the tensor induced by the same functional in the other
factorization.  Injectivity of the map to the target expresses the subalgebra condition in
Tag 0BT0 used by the source proof. -/
@[stacks 0BT1 "characterization on a common refinement"]
theorem dualizingModuleEquiv_tmul
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B)
    (H : FiniteOpenFactorization.{u, v, y} A B)
    (hH : Function.Injective (algebraMap H.middle B))
    (rF : F.middle →ₐ[A] H.middle)
    (rG : G.middle →ₐ[A] H.middle)
    (hF : ∀ c : F.middle,
      algebraMap H.middle B (rF c) = algebraMap F.middle B c)
    (hG : ∀ c : G.middle,
      algebraMap H.middle B (rG c) = algebraMap G.middle B c)
    (φ : Module.Dual A H.middle) (b : B) :
    dualizingModuleEquiv F G
        (dualizingModule.tmul F (φ.comp rF.toLinearMap) b) =
      dualizingModule.tmul G (φ.comp rG.toLinearMap) b :=
  canonicalDualizingModuleEquiv_tmul_of_commonRefinement (K := H.middle) F G hH rF rG hF hG φ b

/-- The canonical comparison of a factorization with itself is the identity. -/
@[stacks 0BT1 "identity comparison"]
theorem dualizingModuleEquiv_refl
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A]
    (F : FiniteOpenFactorization.{u, v, w} A B) :
    dualizingModuleEquiv F F = LinearEquiv.refl B (dualizingModule F) := by
  ext m
  simp [dualizingModuleEquiv,
    commonSubalgebra_fromF, commonSubalgebra_fromG]

/-- Two factorizations that both factor through one finite algebra `D` embedded in the target
have their canonical comparison computed through `D`: the comparison carries the identification
of `Hom_A(D, A) ⊗_D B` with the first dualizing module to the identification with the second. -/
theorem dualizingModuleEquiv_finiteAlgebraChangeToF
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B)
    {D : Type y} [CommRing D] [Algebra A D] [Algebra D B] [IsScalarTower A D B]
    (hfin : Module.Finite A D) (hinj : Function.Injective (algebraMap D B))
    (rF : F.middle →ₐ[A] D) (rG : G.middle →ₐ[A] D)
    (hcompF : (IsScalarTower.toAlgHom A D B).comp rF = IsScalarTower.toAlgHom A F.middle B)
    (hcompG : (IsScalarTower.toAlgHom A D B).comp rG = IsScalarTower.toAlgHom A G.middle B) :
    letI : Module D (Module.Dual A D) := algebraDualModule A D
    letI : Module B (Module.Dual A D ⊗[D] B) :=
      (TensorProduct.comm D (Module.Dual A D) B).toAddEquiv.module B
    ∀ z : Module.Dual A D ⊗[D] B,
      dualizingModuleEquiv F G (finiteAlgebraChangeToF F hfin rF hcompF hinj z) =
        finiteAlgebraChangeToF G hfin rG hcompG hinj z := by
  let : Module.Finite A D := hfin
  let : Module D (Module.Dual A D) := algebraDualModule A D
  let : Module B (Module.Dual A D ⊗[D] B) :=
    (TensorProduct.comm D (Module.Dual A D) B).toAddEquiv.module B
  have key : ∀ (φ : Module.Dual A D) (b : B),
      dualizingModuleEquiv F G (dualizingModule.tmul F (φ.comp rF.toLinearMap) b) =
        dualizingModule.tmul G (φ.comp rG.toLinearMap) b := fun φ b =>
    canonicalDualizingModuleEquiv_tmul_of_commonRefinement (K := D) F G hinj rF rG
      (fun c => congrArg (fun f : F.middle →ₐ[A] B => f c) hcompF)
      (fun c => congrArg (fun f : G.middle →ₐ[A] B => f c) hcompG) φ b
  intro z
  induction z using TensorProduct.induction_on with
  | zero => simp
  | add z₁ z₂ h₁ h₂ => rw [map_add, map_add, map_add, h₁, h₂]
  | tmul φ b =>
      have hF : finiteAlgebraChangeToF F hfin rF hcompF hinj (φ ⊗ₜ[D] b) =
          dualizingModule.tmul F (φ.comp rF.toLinearMap) b :=
        finiteAlgebraChangeToF_tmul F hfin rF hcompF hinj φ b
      have hG : finiteAlgebraChangeToF G hfin rG hcompG hinj (φ ⊗ₜ[D] b) =
          dualizingModule.tmul G (φ.comp rG.toLinearMap) b :=
        finiteAlgebraChangeToF_tmul G hfin rG hcompG hinj φ b
      rw [hF, hG, key φ b]

/-- Canonical comparisons compose independently of an intermediate factorization. -/
@[stacks 0BT1 "composition of comparisons"]
theorem dualizingModuleEquiv_trans
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A]
    (F : FiniteOpenFactorization.{u, v, w} A B)
    (G : FiniteOpenFactorization.{u, v, x} A B)
    (H : FiniteOpenFactorization.{u, v, y} A B) :
    (dualizingModuleEquiv F G).trans (dualizingModuleEquiv G H) =
      dualizingModuleEquiv F H := by
  let C₁ := commonSubalgebra F G
  let C₂ := commonSubalgebra G H
  let D : Subalgebra A B := C₁ ⊔ C₂
  let : Module.Finite A C₁ := commonSubalgebra_finite F G
  let : Module.Finite A C₂ := commonSubalgebra_finite G H
  let hfin : Module.Finite A D := Subalgebra.finite_sup C₁ C₂
  have hinj : Function.Injective (algebraMap D B) := Subtype.val_injective
  let fF : F.middle →ₐ[A] B := IsScalarTower.toAlgHom A F.middle B
  let fG : G.middle →ₐ[A] B := IsScalarTower.toAlgHom A G.middle B
  let fH : H.middle →ₐ[A] B := IsScalarTower.toAlgHom A H.middle B
  have hFle : fF.range ≤ D := le_sup_left.trans le_sup_left
  have hGle : fG.range ≤ D := le_sup_right.trans le_sup_left
  have hHle : fH.range ≤ D := le_sup_right.trans le_sup_right
  let rF : F.middle →ₐ[A] D := fF.codRestrict D (fun c => hFle (fF.mem_range_self c))
  let rG : G.middle →ₐ[A] D := fG.codRestrict D (fun c => hGle (fG.mem_range_self c))
  let rH : H.middle →ₐ[A] D := fH.codRestrict D (fun c => hHle (fH.mem_range_self c))
  have hcompF : (IsScalarTower.toAlgHom A D B).comp rF = fF := AlgHom.ext fun _ => rfl
  have hcompG : (IsScalarTower.toAlgHom A D B).comp rG = fG := AlgHom.ext fun _ => rfl
  have hcompH : (IsScalarTower.toAlgHom A D B).comp rH = fH := AlgHom.ext fun _ => rfl
  have hFG := dualizingModuleEquiv_finiteAlgebraChangeToF F G hfin hinj rF rG hcompF hcompG
  have hGH := dualizingModuleEquiv_finiteAlgebraChangeToF G H hfin hinj rG rH hcompG hcompH
  have hFH := dualizingModuleEquiv_finiteAlgebraChangeToF F H hfin hinj rF rH hcompF hcompH
  ext m
  obtain ⟨z, rfl⟩ := (finiteAlgebraChangeToF F hfin rF hcompF hinj).surjective m
  rw [LinearEquiv.trans_apply, hFG z, hGH z, hFH z]

-- The comparison is characterized by `dualizingModuleEquiv_tmul`, `dualizingModuleEquiv_refl`
-- and `dualizingModuleEquiv_trans`; consumers should use those rather than its construction,
-- which unification cannot unfold at a reasonable cost.
attribute [irreducible] dualizingModuleEquiv

end Stacks.Discriminant
