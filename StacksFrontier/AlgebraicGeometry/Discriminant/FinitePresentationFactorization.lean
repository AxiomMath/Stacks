module

public import Mathlib.RingTheory.Finiteness.ModuleFinitePresentation
public import Mathlib.RingTheory.Localization.Away.AdjoinRoot
public import StacksFrontier.AlgebraicGeometry.Different.DualizingModulesQuasi.BaseChange
public import StacksFrontier.RingTheory.ZariskisMainTheorem

/-!
# Finite-open factorizations with a finitely presented intermediate algebra

Let `A → B` be a quasi-finite ring map of finite presentation. Zariski's main theorem factors it
as `A → C → B` with `C` finite over `A` and `Spec B → Spec C` an open immersion. Over a
non-Noetherian base the finite `A`-module `C` need not be finitely presented. This file shows
that `C` can be replaced by a finite `A`-algebra that is finitely presented as an `A`-module.

## Main results

* `Stacks.Discriminant.exists_fg_le_ker_forall_exists_pow_mul_mem`: for a map `ρ : P → B` of
  finitely presented `A`-algebras and finitely many `x_i ∈ P` with `P_{x_i} → B_{ρ(x_i)}`
  surjective, a finitely generated ideal `I ⊆ ker ρ` already accounts for `ker ρ` after
  inverting each `x_i`.
* `Stacks.Discriminant.bijective_awayMap_quotient`: for such an ideal the maps
  `(P/I)_{x_i} → B_{ρ(x_i)}` are bijective.
* `Stacks.Discriminant.exists_finiteOpenFactorization_finitePresentation`: a quasi-finite
  finitely presented algebra admits a finite-open factorization whose intermediate algebra is a
  finitely presented module over the base.

## Implementation notes

The finite subalgebra `C ⊆ B` of Zariski's main theorem comes with finitely many `c_i ∈ C`
whose images cover `Spec B` and with `C_{c_i} → B_{c_i}` bijective. A finite free, finitely
presented `A`-algebra `P` surjects onto `C`; lifting the `c_i` to `x_i ∈ P`, each
`P_{x_i} → B_{x_i}` is a surjection of finitely presented `A`-algebras, so its kernel
`(ker ρ)_{x_i}` is finitely generated. Finitely many elements of `ker ρ` therefore generate an
ideal `I` with `I_{x_i} = (ker ρ)_{x_i}` for every `i`, and `P/I` is the required algebra: it is
finite and finitely presented as an algebra, hence finitely presented as a module, and
`(P/I)_{x_i} → B_{x_i}` is bijective, which is the local criterion
`Stacks.Discriminant.FiniteOpenFactorization.ofLocalData` for a finite-open factorization.
-/

@[expose] public section

universe u v

namespace Stacks.Discriminant

/-- If the extension of an ideal `J` to a ring `S` over `R` is finitely generated, then it is
the extension of an ideal generated by finitely many elements of `J`. -/
theorem exists_finset_subset_map_le_map_span {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (J : Ideal R) (hJ : (J.map (algebraMap R S)).FG) :
    ∃ W : Finset R, (W : Set R) ⊆ J ∧
      J.map (algebraMap R S) ≤ (Ideal.span (W : Set R)).map (algebraMap R S) := by
  classical
  have hJ' : (Submodule.span S (algebraMap R S '' (J : Set R))).FG := hJ
  obtain ⟨s', hs', heq⟩ := (Submodule.fg_span_iff_fg_span_finset_subset _).mp hJ'
  obtain ⟨W, hWJ, rfl⟩ := Finset.subset_set_image_iff.mp hs'
  refine ⟨W, hWJ, ?_⟩
  rw [Ideal.map_span, ← Finset.coe_image]
  exact heq.le

/-- Localizing a finitely presented `A`-algebra at one element gives a finitely presented
`A`-algebra. -/
private theorem finitePresentation_away {R : Type*} [CommRing R] (A : Type*) [CommRing A]
    [Algebra A R] [Algebra.FinitePresentation A R] (r : R) :
    Algebra.FinitePresentation A (Localization.Away r) :=
  have : Algebra.FinitePresentation R (Localization.Away r) :=
    IsLocalization.Away.finitePresentation r
  Algebra.FinitePresentation.trans A R _

/-- Let `ρ : P → B` be a map of finitely presented `A`-algebras and let `x_i ∈ P` be finitely
many elements such that each `P_{x_i} → B_{ρ(x_i)}` is surjective. Then there is a finitely
generated ideal `I ⊆ ker ρ` such that for every `i` and every `p ∈ ker ρ` some power of `x_i`
multiplies `p` into `I`. -/
theorem exists_fg_le_ker_forall_exists_pow_mul_mem {A P B : Type*} [CommRing A] [CommRing P]
    [CommRing B] [Algebra A P] [Algebra A B] [Algebra.FinitePresentation A P]
    [Algebra.FinitePresentation A B] (ρ : P →ₐ[A] B) {ι : Type*} [Finite ι] (x : ι → P)
    (hx : ∀ i, Function.Surjective (Localization.awayMap ρ.toRingHom (x i))) :
    ∃ I : Ideal P, I.FG ∧ I ≤ RingHom.ker ρ ∧
      ∀ i, ∀ p, ρ p = 0 → ∃ n : ℕ, x i ^ n * p ∈ I := by
  classical
  have hfg (i : ι) :
      ((RingHom.ker ρ.toRingHom).map (algebraMap P (Localization.Away (x i)))).FG := by
    have := finitePresentation_away A (x i)
    have := finitePresentation_away A (ρ (x i))
    rw [← IsLocalization.ker_map (Localization.Away (ρ.toRingHom (x i))) ρ.toRingHom
      (Submonoid.map_powers ρ.toRingHom (x i))]
    exact Algebra.FinitePresentation.ker_fG_of_surjective (Localization.awayMapₐ ρ (x i)) (hx i)
  choose W hWJ hWle using fun i ↦ exists_finset_subset_map_le_map_span _ (hfg i)
  have := Fintype.ofFinite ι
  refine ⟨Ideal.span (⋃ i, (W i : Set P)), ⟨Finset.univ.biUnion W, by simp⟩, ?_, ?_⟩
  · exact Ideal.span_le.mpr (Set.iUnion_subset hWJ)
  · intro i p hp
    have hmem : algebraMap P (Localization.Away (x i)) p ∈
        (Ideal.span (⋃ i, (W i : Set P))).map (algebraMap P (Localization.Away (x i))) :=
      Ideal.map_mono (Ideal.span_mono (Set.subset_iUnion (fun i ↦ (W i : Set P)) i))
        (hWle i (Ideal.mem_map_of_mem _ (RingHom.mem_ker.mpr hp)))
    obtain ⟨_, ⟨n, rfl⟩, hm⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff (Submonoid.powers (x i)) _ _ _).mp hmem
    exact ⟨n, hm⟩

/-- Let `ρ : P → B` be a map of `A`-algebras, `I ⊆ ker ρ` an ideal and `x ∈ P` with
`P_x → B_{ρ(x)}` surjective and such that every `p ∈ ker ρ` is multiplied into `I` by a power of
`x`. Then the induced map `(P/I)_x → B_{ρ(x)}` is bijective. -/
theorem bijective_awayMap_quotient {A P B : Type*} [CommRing A] [CommRing P] [CommRing B]
    [Algebra A P] [Algebra A B] (ρ : P →ₐ[A] B) (I : Ideal P) (hI : ∀ a ∈ I, ρ a = 0) (x : P)
    (hs : Function.Surjective (Localization.awayMap ρ.toRingHom x))
    (hx : ∀ p, ρ p = 0 → ∃ n : ℕ, x ^ n * p ∈ I) :
    Function.Bijective (Localization.awayMap (Ideal.Quotient.liftₐ I ρ hI).toRingHom
      (Ideal.Quotient.mk I x)) := by
  refine ⟨Localization.awayMap_injective_iff.mpr fun a ha ↦ ?_,
    Localization.awayMap_surjective_iff.mpr fun b ↦ ?_⟩
  · obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨n, hn⟩ := hx p ha
    exact ⟨n, by rw [← map_pow, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]; exact hn⟩
  · obtain ⟨p, m, hp⟩ := Localization.awayMap_surjective_iff.mp hs b
    exact ⟨Ideal.Quotient.mk I p, m, hp⟩

/-- **A finitely presented intermediate algebra.** A quasi-finite algebra `B` of finite
presentation over a ring `A` admits a finite-open factorization `A → B' → B` whose intermediate
algebra `B'` is a finitely presented `A`-module. -/
theorem exists_finiteOpenFactorization_finitePresentation {A : Type u} {B : Type v}
    [CommRing A] [CommRing B] [Algebra A B] [Algebra.FinitePresentation A B]
    [Algebra.QuasiFinite A B] :
    ∃ F : FiniteOpenFactorization.{u, v, u} A B, Module.FinitePresentation A F.middle := by
  classical
  obtain ⟨T, hTbij, hTcov⟩ := exists_finset_awayMap_integralClosure_bijective (R := A) (S := B)
  obtain ⟨C, -, hCfin, hC⟩ := exists_finite_subalgebra_awayMap_bijective T hTbij
  choose hTC hCbij using hC
  obtain ⟨P, _, _, _, _, _, π, hπ⟩ := Module.Finite.exists_free_surjective A C
  let ρ : P →ₐ[A] B := C.val.comp π
  choose x hx using fun t : T ↦ hπ ⟨t.1, hTC t.1 t.2⟩
  have hρx (t : T) : ρ (x t) = t.1 := by simp [ρ, hx t]
  have hsurj (t : T) : Function.Surjective (Localization.awayMap ρ.toRingHom (x t)) := by
    refine Localization.awayMap_surjective_iff.mpr fun b ↦ ?_
    obtain ⟨c, m, hc⟩ := Localization.awayMap_surjective_iff.mp (hCbij t.1 t.2).2 b
    obtain ⟨p, rfl⟩ := hπ c
    exact ⟨p, m, by simpa [ρ, hx t] using hc⟩
  obtain ⟨I, hIfg, hIker, hI⟩ := exists_fg_le_ker_forall_exists_pow_mul_mem ρ x hsurj
  let ρ' : P ⧸ I →ₐ[A] B := Ideal.Quotient.liftₐ I ρ fun a ha ↦ hIker ha
  let : Algebra (P ⧸ I) B := ρ'.toRingHom.toAlgebra
  have : IsScalarTower A (P ⧸ I) B := IsScalarTower.of_algebraMap_eq fun a ↦ (ρ'.commutes a).symm
  have : Module.Finite A (P ⧸ I) :=
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ A I).toLinearMap Ideal.Quotient.mk_surjective
  have : Algebra.FinitePresentation A (P ⧸ I) := Algebra.FinitePresentation.quotient hIfg
  have H : ∀ q : PrimeSpectrum B, ∃ d : P ⧸ I, algebraMap (P ⧸ I) B d ∉ q.asIdeal ∧
      Function.Bijective (Localization.awayMap (algebraMap (P ⧸ I) B) d) := by
    intro q
    obtain ⟨t, htT, htq⟩ := hTcov q
    refine ⟨Ideal.Quotient.mk I (x ⟨t, htT⟩), ?_, ?_⟩
    · change ρ (x ⟨t, htT⟩) ∉ q.asIdeal
      rw [hρx]
      exact htq
    · exact bijective_awayMap_quotient ρ I _ (x ⟨t, htT⟩) (hsurj _) (hI _)
  exact ⟨FiniteOpenFactorization.ofLocalData (A := A) H,
    Module.FinitePresentation.of_finite_of_finitePresentation A (P ⧸ I)⟩

end Stacks.Discriminant

end
