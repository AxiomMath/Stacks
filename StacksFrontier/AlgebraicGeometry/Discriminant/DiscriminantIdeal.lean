/-!
# The discriminant ideal of a finite projective algebra

Let `A` be a finite projective algebra over a commutative ring `R`. Multiplication makes `A` act
on itself by `R`-linear endomorphisms, and taking traces of those endomorphisms gives an
`R`-linear trace `A → R` and a symmetric trace pairing `A × A → R`. Viewing the pairing as a map
`A → Hom_R(A, R)` between modules of the same rank, the *discriminant ideal* of `A` over `R` is
the zeroth Fitting ideal of the cokernel of that map. When `A` is free over `R` this is the ideal
generated by the determinant of the trace pairing, which is the classical discriminant.

The discriminant ideal is principal when `A` is free over `R` and commutes with base change, and
its image in a field is the unit ideal exactly when the corresponding fibre of `A` is étale.

## Main definitions

* `Stacks.Discriminant.finiteProjectiveTrace` is the trace of an endomorphism of a finite
  projective module, computed on a finite free module that the module splits off.
* `Stacks.Discriminant.finiteProjectiveTraceForm` is the trace pairing of a finite projective
  algebra.
* `Stacks.Discriminant.algebraDiscriminantIdeal` is the discriminant ideal: the zeroth Fitting
  ideal of the cokernel of the trace pairing.

## Main results

* `Stacks.Discriminant.finiteDimensional_etale_iff_traceForm_nondegenerate`: a finite-dimensional
  algebra over a field is étale exactly when its trace form is nondegenerate.
* `Stacks.Discriminant.algebraDiscriminantIdeal_map`: the discriminant ideal commutes with base
  change.
* `Stacks.Discriminant.algebraDiscriminantIdeal_map_eq_top_iff_etale_fiber`: the discriminant
  ideal generates the unit ideal in a field exactly when the corresponding fibre is étale.
* `Stacks.Discriminant.algebraDiscriminantIdeal_eq_top_of_etale`: an étale finite projective
  algebra has unit discriminant ideal.
* `Stacks.Discriminant.algebraDiscriminantIdeal_isPrincipal_of_free`: the discriminant ideal of a
  finite free algebra is principal.

## References

* [Stacks Project, Tag 0BJF](https://stacks.math.columbia.edu/tag/0BJF)
* [Stacks Project, Tag 0BIL](https://stacks.math.columbia.edu/tag/0BIL)
-/

@[expose] public noncomputable section

open scoped TensorProduct Matrix

universe u v w x

namespace Stacks.Discriminant

/-- The trace of an endomorphism of a finite projective module. It is computed on a finite free
module of which the given module is a direct summand. -/
@[sga "4½ Rapport 4.2" "special case"]
noncomputable def finiteProjectiveTrace (R : Type u) [CommRing R]
    (P : Type v) [AddCommGroup P] [Module R P] [Module.Finite R P]
    [Module.Projective R P] : Module.End R P →ₗ[R] R := by
  let h := Module.Finite.exists_comp_eq_id_of_projective R P
  let n := h.choose
  let p : (Fin n → R) →ₗ[R] P := h.choose_spec.choose
  let i : P →ₗ[R] (Fin n → R) := h.choose_spec.choose_spec.choose
  exact (LinearMap.trace R (Fin n → R)).comp
    ((LinearMap.llcomp R (Fin n → R) P (Fin n → R) i).comp
      (LinearMap.lcomp R P p))

/-- The trace pairing of a finite projective commutative algebra. -/
@[sga "1 I 4.10" "special case"]
noncomputable def finiteProjectiveTraceForm (R : Type u) (A : Type v)
    [CommRing R] [CommRing A] [Algebra R A] [Module.Finite R A]
    [Module.Projective R A] : LinearMap.BilinForm R A :=
  let trace := (finiteProjectiveTrace R A).comp (Algebra.lmul R A).toLinearMap
  (Algebra.lmul R A).toLinearMap.compr₂ trace

/-- The discriminant ideal of a commutative algebra. For a finite projective algebra it is the
zeroth Fitting ideal of the cokernel of the trace-pairing map; otherwise it is `⊥`. -/
noncomputable def algebraDiscriminantIdeal (R : Type u) (A : Type v)
    [CommRing R] [CommRing A] [Algebra R A] : Ideal R := by
  classical
  exact if h : Module.Finite R A ∧ Module.Projective R A then
    let := h.1
    let := h.2
    fittingIdeal (R := R)
      (M := Module.Dual R A ⧸ LinearMap.range (finiteProjectiveTraceForm R A)) 0
  else ⊥

/-- On a finite free module the projective trace is `LinearMap.trace`. -/
theorem finiteProjectiveTrace_eq_trace (R : Type u) (P : Type v)
    [CommRing R] [AddCommGroup P] [Module R P] [Module.Finite R P]
    [Module.Projective R P] [Module.Free R P] :
    finiteProjectiveTrace R P = LinearMap.trace R P := by
  classical
  let h := Module.Finite.exists_comp_eq_id_of_projective R P
  let n := h.choose
  let p : (Fin n → R) →ₗ[R] P := h.choose_spec.choose
  let i : P →ₗ[R] (Fin n → R) := h.choose_spec.choose_spec.choose
  have hi : p.comp i = LinearMap.id := h.choose_spec.choose_spec.choose_spec.2.2
  ext f
  show LinearMap.trace R (Fin n → R) (i.comp (f.comp p)) =
    LinearMap.trace R P f
  rw [← LinearMap.trace_comp_comm' i (f.comp p)]
  simp [LinearMap.comp_assoc, hi]

/-- The projective trace may be computed on any finite free module that the given module
splits off, not only on the one chosen in the definition. -/
theorem finiteProjectiveTrace_eq_trace_of_split (R : Type u) (P : Type v) (F : Type w)
    [CommRing R] [AddCommGroup P] [Module R P] [Module.Finite R P]
    [Module.Projective R P] [AddCommGroup F] [Module R F] [Module.Finite R F] [Module.Free R F]
    (p : F →ₗ[R] P) (i : P →ₗ[R] F) (hpi : p.comp i = LinearMap.id)
    (f : Module.End R P) :
    finiteProjectiveTrace R P f =
      LinearMap.trace R F (i.comp (f.comp p)) := by
  classical
  let h := Module.Finite.exists_comp_eq_id_of_projective R P
  let n₀ := h.choose
  let p₀ : (Fin n₀ → R) →ₗ[R] P := h.choose_spec.choose
  let i₀ : P →ₗ[R] (Fin n₀ → R) := h.choose_spec.choose_spec.choose
  have hp₀i₀ : p₀.comp i₀ = LinearMap.id := h.choose_spec.choose_spec.choose_spec.2.2
  have he₁ : i₀.comp (f.comp p₀) =
      (i₀.comp (f.comp p)).comp (i.comp p₀) := by
    apply LinearMap.ext
    intro x
    funext j
    have hx := LinearMap.congr_fun hpi (p₀ x)
    simp only [LinearMap.comp_apply, LinearMap.id_apply] at hx
    simp only [LinearMap.comp_apply]
    rw [hx]
  have he₂ : i.comp (f.comp p) =
      (i.comp p₀).comp (i₀.comp (f.comp p)) := by
    apply LinearMap.ext
    intro x
    have hx := LinearMap.congr_fun hp₀i₀ (f (p x))
    simpa only [LinearMap.comp_apply, LinearMap.id_apply] using (congrArg i hx).symm
  show LinearMap.trace R (Fin n₀ → R) (i₀.comp (f.comp p₀)) = _
  calc
    _ = LinearMap.trace R (Fin n₀ → R)
          ((i₀.comp (f.comp p)).comp (i.comp p₀)) := by rw [he₁]
    _ = LinearMap.trace R F
          ((i.comp p₀).comp (i₀.comp (f.comp p))) :=
      (LinearMap.trace_comp_comm' (i₀.comp (f.comp p)) (i.comp p₀)).symm
    _ = LinearMap.trace R F (i.comp (f.comp p)) := by rw [he₂]

/-- The projective trace commutes with base change: the trace of a base-changed endomorphism
is the image of the trace. -/
theorem finiteProjectiveTrace_baseChange
    (R : Type u) (P : Type v) (K : Type w)
    [CommRing R] [CommRing K] [Algebra R K]
    [AddCommGroup P] [Module R P] [Module.Finite R P] [Module.Projective R P]
    (f : Module.End R P) :
    finiteProjectiveTrace K (K ⊗[R] P) (f.baseChange K) =
      algebraMap R K (finiteProjectiveTrace R P f) := by
  classical
  obtain ⟨n, p, i, _, _, hi⟩ := Module.Finite.exists_comp_eq_id_of_projective R P
  let p' := p.baseChange K
  let i' := i.baseChange K
  have hi' : p'.comp i' = LinearMap.id := by
    dsimp [p', i']
    rw [← LinearMap.baseChange_comp, hi, LinearMap.baseChange_id]
  calc
    finiteProjectiveTrace K (K ⊗[R] P) (f.baseChange K) =
        LinearMap.trace K (K ⊗[R] (Fin n → R))
          (i'.comp ((f.baseChange K).comp p')) :=
      finiteProjectiveTrace_eq_trace_of_split K (K ⊗[R] P)
        (K ⊗[R] (Fin n → R)) p' i' hi'
        (f.baseChange K)
    _ = algebraMap R K (LinearMap.trace R (Fin n → R) (i.comp (f.comp p))) := by
      have hcomp : i'.comp ((f.baseChange K).comp p') =
          (i.comp (f.comp p)).baseChange K := by
        dsimp [i', p']
        simp [LinearMap.baseChange_comp]
      rw [hcomp, LinearMap.trace_baseChange]
    _ = algebraMap R K (finiteProjectiveTrace R P f) :=
      congrArg (algebraMap R K)
        (finiteProjectiveTrace_eq_trace_of_split R P (Fin n → R) p i hi f).symm

/-- For a finite free algebra the projective trace pairing is the usual algebra trace form. -/
theorem finiteProjectiveTraceForm_eq_traceForm (R : Type u) (A : Type v)
    [CommRing R] [CommRing A] [Algebra R A] [Module.Finite R A]
    [Module.Projective R A] [Module.Free R A] :
    finiteProjectiveTraceForm R A = Algebra.traceForm R A := by
  ext a b
  show finiteProjectiveTrace R A ((Algebra.lmul R A).toLinearMap (a * b)) =
    Algebra.trace R A (a * b)
  rw [finiteProjectiveTrace_eq_trace]
  rfl

/-- Multiplication by the pure tensor `1 ⊗ₜ a` on a scalar extension is the base change of
multiplication by `a`. -/
theorem lmul_scalarTensor
    (R : Type u) (A : Type v) (K : Type w)
    [CommRing R] [CommRing A] [Algebra R A] [CommRing K] [Algebra R K]
    (a : A) :
    (Algebra.lmul K (K ⊗[R] A)).toLinearMap (1 ⊗ₜ[R] a) =
      ((Algebra.lmul R A).toLinearMap a).baseChange K := by
  classical
  apply LinearMap.ext
  intro z
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · simp
  · intro k x
    show (1 ⊗ₜ[R] a) * (k ⊗ₜ[R] x) =
      ((Algebra.lmul R A).toLinearMap a).baseChange K (k ⊗ₜ[R] x)
    rw [Algebra.TensorProduct.tmul_mul_tmul, LinearMap.baseChange_tmul]
    simp [Algebra.coe_lmul_eq_mul]
  · intro x y hx hy
    simp only [map_add, hx, hy]

/-- The trace form of a scalar extension, evaluated on two pure tensors, is the image of the
projective trace pairing. -/
theorem traceForm_scalarTensor_apply
    (R : Type u) (A : Type v) (K : Type w)
    [CommRing R] [CommRing A] [Algebra R A] [Module.Finite R A]
    [Module.Projective R A] [CommRing K] [Algebra R K]
    [Module.Free K (K ⊗[R] A)]
    (a b : A) :
    Algebra.traceForm K (K ⊗[R] A) (1 ⊗ₜ[R] a) (1 ⊗ₜ[R] b) =
      algebraMap R K (finiteProjectiveTraceForm R A a b) := by
  classical
  let B := K ⊗[R] A
  have hab : ((1 : K) ⊗ₜ[R] a) * ((1 : K) ⊗ₜ[R] b) =
      ((1 : K) ⊗ₜ[R] (a * b)) := by
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
  rw [Algebra.traceForm_apply, Algebra.trace_apply]
  show LinearMap.trace K B
    ((Algebra.lmul K B).toLinearMap ((1 ⊗ₜ[R] a) * (1 ⊗ₜ[R] b))) = _
  rw [hab, lmul_scalarTensor, ← finiteProjectiveTrace_eq_trace K B,
    finiteProjectiveTrace_baseChange]
  rfl

/-- The projective trace pairing of a scalar extension, evaluated on two pure tensors, is the
image of the projective trace pairing. -/
theorem finiteProjectiveTraceForm_scalarTensor_tmul
    (R : Type u) (A : Type v) (S : Type w)
    [CommRing R] [CommRing A] [Algebra R A] [Module.Finite R A]
    [Module.Projective R A] [CommRing S] [Algebra R S] (a b : A) :
    finiteProjectiveTraceForm S (S ⊗[R] A) (1 ⊗ₜ[R] a) (1 ⊗ₜ[R] b) =
      algebraMap R S (finiteProjectiveTraceForm R A a b) := by
  classical
  have hab : ((1 : S) ⊗ₜ[R] a) * ((1 : S) ⊗ₜ[R] b) =
      ((1 : S) ⊗ₜ[R] (a * b)) := by
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
  rw [finiteProjectiveTraceForm, LinearMap.compr₂_apply]
  simp only [LinearMap.comp_apply]
  have hmul : ((Algebra.lmul S (S ⊗[R] A)).toLinearMap (1 ⊗ₜ[R] a))
      (1 ⊗ₜ[R] b) = (1 ⊗ₜ[R] a) * (1 ⊗ₜ[R] b) := rfl
  rw [hmul, hab]
  rw [lmul_scalarTensor, finiteProjectiveTrace_baseChange]
  rfl

/-- A finite projective module has a finite dual basis: finitely many elements and functionals
reproducing every element and every functional. -/
theorem exists_finite_dual_basis
    (R : Type u) (A : Type v) [CommRing R] [AddCommGroup A] [Module R A]
    [Module.Finite R A] [Module.Projective R A] :
    ∃ (n : ℕ) (b : Fin n → A) (φ : Fin n → Module.Dual R A),
      (∀ a, ∑ i, φ i a • b i = a) ∧
      (∀ ψ, ∑ i, ψ (b i) • φ i = ψ) := by
  classical
  obtain ⟨n, p, i, _, _, hi⟩ := Module.Finite.exists_comp_eq_id_of_projective R A
  let b := Pi.basisFun R (Fin n)
  let v : Fin n → A := fun j => p (b j)
  let ψ : Fin n → Module.Dual R A := fun j => (b.coord j).comp i
  have hsum (a : A) : ∑ j, ψ j a • v j = a := by
    calc
      ∑ j, ψ j a • v j = ∑ j, p (b.coord j (i a) • b j) := by
        apply Finset.sum_congr rfl
        intro j hj
        simp [ψ, v, LinearMap.comp_apply, map_smul]
      _ = p (∑ j, b.coord j (i a) • b j) := (map_sum p _ _).symm
      _ = p (i a) := by
        congr 1
        simpa only [b.coord_apply] using b.sum_repr (i a)
      _ = a := by
        have hia := LinearMap.congr_fun hi a
        simpa only [LinearMap.comp_apply, LinearMap.id_apply] using hia
  refine ⟨n, v, ψ, hsum, ?_⟩
  intro ψ'
  apply LinearMap.ext
  intro a
  have h : ∑ j, ψ j a * ψ' (v j) = ψ' a := by
    simpa [map_sum, map_smul, smul_eq_mul] using congrArg ψ' (hsum a)
  calc
    (∑ j, ψ' (v j) • ψ j) a = ∑ j, ψ' (v j) * ψ j a := by simp
    _ = ∑ j, ψ j a * ψ' (v j) := by
      apply Finset.sum_congr rfl
      intro j hj
      rw [mul_comm]
    _ = ψ' a := h

/-- The canonical map from the scalar extension of the dual to the dual of the scalar extension. -/
noncomputable def dualTensorBaseChange
    (R : Type u) (A : Type v) (S : Type w)
    [CommRing R] [CommRing A] [Algebra R A]
    [CommRing S] [Algebra R S] :
    S ⊗[R] Module.Dual R A →ₗ[S] Module.Dual S (S ⊗[R] A) := by
  classical
  let G : S →ₗ[S] (Module.Dual R A →ₗ[R] Module.Dual S (S ⊗[R] A)) :=
    { toFun := fun s =>
        { toFun := fun φ => s • Module.Dual.baseChange S φ
          map_add' := by intros; simp
          map_smul' := by
            intro r φ
            rw [map_smul]
            exact smul_comm _ _ _ }
      map_add' := by
        intro s t
        ext φ x
        simp [add_smul]
      map_smul' := by
        intro s t
        ext φ x
        simp [smul_smul] }
  exact TensorProduct.AlgebraTensorModule.lift G

/-- The canonical comparison map of duals, evaluated on a pure tensor. -/
theorem dualTensorBaseChange_tmul_apply
    (R : Type u) (A : Type v) (S : Type w)
    [CommRing R] [CommRing A] [Algebra R A]
    [CommRing S] [Algebra R S]
    (s : S) (φ : Module.Dual R A) (z : S ⊗[R] A) :
    dualTensorBaseChange R A S (s ⊗ₜ[R] φ) z =
      (s • Module.Dual.baseChange S φ) z := by
  simp [dualTensorBaseChange]

/-- A pure tensor `s ⊗ a` is `s` times the pure tensor `1 ⊗ a`. -/
private theorem tmul_eq_smul_one_tmul {R : Type u} {A : Type v} {S : Type w}
    [CommRing R] [CommRing S] [Algebra R S] [AddCommGroup A] [Module R A] (s : S) (a : A) :
    s ⊗ₜ[R] a = s • ((1 : S) ⊗ₜ[R] a) := by
  rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]

/-- The projective trace pairing of a scalar extension is the base change of the projective
trace pairing, followed by the canonical comparison of duals. -/
@[ega "IV 18.2.1" "more general"]
theorem finiteProjectiveTraceForm_scalarTensor_map
    (R : Type u) (A : Type v) (S : Type w)
    [CommRing R] [CommRing A] [Algebra R A] [Module.Finite R A]
    [Module.Projective R A] [CommRing S] [Algebra R S] :
    (finiteProjectiveTraceForm S (S ⊗[R] A) :
      (S ⊗[R] A) →ₗ[S] Module.Dual S (S ⊗[R] A)) =
      (dualTensorBaseChange R A S).comp
        ((finiteProjectiveTraceForm R A : A →ₗ[R] Module.Dual R A).baseChange S) := by
  classical
  apply TensorProduct.AlgebraTensorModule.ext
  intro s a
  apply LinearMap.ext
  intro z
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · simp [dualTensorBaseChange]
  · intro t b
    rw [tmul_eq_smul_one_tmul s a, tmul_eq_smul_one_tmul t b, map_smul, map_smul]
    simp [dualTensorBaseChange,
      Module.Dual.baseChange_apply_tmul, finiteProjectiveTraceForm_scalarTensor_tmul,
      LinearMap.baseChange_tmul, Algebra.smul_def, mul_left_comm, mul_comm]
  · intro z z' hz hz'
    simp [hz, hz']

/-- For a finite projective module the canonical comparison of duals is bijective. -/
theorem dualTensorBaseChange_bijective
    (R : Type u) (A : Type v) (S : Type w)
    [CommRing R] [CommRing A] [Algebra R A] [Module.Finite R A]
    [Module.Projective R A] [CommRing S] [Algebra R S] :
    Function.Bijective (dualTensorBaseChange R A S) := by
  classical
  obtain ⟨n, b, φ, hb, hφ⟩ := exists_finite_dual_basis R A
  let inv : Module.Dual S (S ⊗[R] A) →ₗ[S] S ⊗[R] Module.Dual R A :=
    { toFun := fun ψ => ∑ i, ψ (1 ⊗ₜ[R] b i) ⊗ₜ[R] φ i
      map_add' := by
        intro ψ ψ'
        simp only [LinearMap.add_apply, TensorProduct.add_tmul, Finset.sum_add_distrib]
      map_smul' := by
        intro s ψ
        calc
          (∑ i, (s • ψ (1 ⊗ₜ[R] b i)) ⊗ₜ[R] φ i) =
              ∑ i, s • (ψ (1 ⊗ₜ[R] b i) ⊗ₜ[R] φ i) := by
            apply Finset.sum_congr rfl
            intro i hi
            exact (TensorProduct.smul_tmul' s
              (ψ (1 ⊗ₜ[R] b i)) (φ i)).symm
          _ = s • ∑ i, ψ (1 ⊗ₜ[R] b i) ⊗ₜ[R] φ i := by rw [Finset.smul_sum] }
  have hinv : inv.comp (dualTensorBaseChange R A S) = LinearMap.id := by
    apply TensorProduct.AlgebraTensorModule.ext
    intro s ψ
    dsimp [dualTensorBaseChange, inv, TensorProduct.AlgebraTensorModule.lift_tmul]
    show (∑ i, (s * (ψ (b i) • (1 : S))) ⊗ₜ[R] φ i) = s ⊗ₜ[R] ψ
    calc
      (∑ i, (s * (ψ (b i) • (1 : S))) ⊗ₜ[R] φ i) =
          ∑ i, (s * algebraMap R S (ψ (b i))) ⊗ₜ[R] φ i := by
        apply Finset.sum_congr rfl
        intro i hi
        simp [Algebra.smul_def]
      _ =
          ∑ i, s ⊗ₜ[R] (ψ (b i) • φ i) := by
        apply Finset.sum_congr rfl
        intro i hi
        have hs : (ψ (b i)) • s = s * algebraMap R S (ψ (b i)) := by
          simp [Algebra.smul_def, mul_comm]
        rw [← hs]
        exact TensorProduct.smul_tmul (ψ (b i)) s (φ i)
      _ = s ⊗ₜ[R] ∑ i, ψ (b i) • φ i := by
        rw [← TensorProduct.tmul_sum]
      _ = s ⊗ₜ[R] ψ := by rw [hφ]
  have hout : (dualTensorBaseChange R A S).comp inv = LinearMap.id := by
    apply LinearMap.ext
    intro ψ
    apply LinearMap.ext
    intro z
    refine TensorProduct.induction_on z ?_ ?_ ?_
    · simp [inv]
    · intro s a
      show dualTensorBaseChange R A S
        (∑ i, ψ (1 ⊗ₜ[R] b i) ⊗ₜ[R] φ i) (s ⊗ₜ[R] a) = ψ (s ⊗ₜ[R] a)
      rw [map_sum]
      simp only [LinearMap.sum_apply, dualTensorBaseChange_tmul_apply,
        LinearMap.smul_apply, Module.Dual.baseChange_apply_tmul]
      have hrep :
          (∑ i, (s * algebraMap R S (φ i a)) ⊗ₜ[R] b i) = s ⊗ₜ[R] a := by
        calc
          (∑ i, (s * algebraMap R S (φ i a)) ⊗ₜ[R] b i) =
              ∑ i, s ⊗ₜ[R] (φ i a • b i) := by
            apply Finset.sum_congr rfl
            intro i hi
            have hs : (φ i a) • s = s * algebraMap R S (φ i a) := by
              simp [Algebra.smul_def, mul_comm]
            rw [← hs]
            exact TensorProduct.smul_tmul (φ i a) s (b i)
          _ = s ⊗ₜ[R] ∑ i, φ i a • b i := by rw [← TensorProduct.tmul_sum]
          _ = s ⊗ₜ[R] a := by rw [hb]
      calc
        (∑ i, ψ (1 ⊗ₜ[R] b i) • ((φ i a) • s)) =
            ∑ i, ψ (1 ⊗ₜ[R] b i) * s * algebraMap R S (φ i a) := by
          apply Finset.sum_congr rfl
          intro i hi
          simp [Algebra.smul_def, mul_assoc, mul_left_comm, mul_comm]
        _ =
            ∑ i, ψ ((s * algebraMap R S (φ i a)) ⊗ₜ[R] b i) := by
          apply Finset.sum_congr rfl
          intro i hi
          rw [tmul_eq_smul_one_tmul (s * algebraMap R S (φ i a)) (b i), map_smul]
          simp [mul_assoc, mul_left_comm, mul_comm]
        _ = ψ (s ⊗ₜ[R] a) := by
          rw [← map_sum, hrep]
    · intro z z' hz hz'
      rw [map_add, map_add, hz, hz']
  exact ⟨Function.LeftInverse.injective (g := inv) (LinearMap.congr_fun hinv),
    Function.RightInverse.surjective (LinearMap.congr_fun hout)⟩

/-- Scalar extension of a cokernel is the cokernel of the scalar extension. -/
noncomputable def cokerBaseChangeEquiv
    (R : Type u) (M : Type v) (N : Type w) (S : Type x)
    [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (f : M →ₗ[R] N) :
    S ⊗[R] (N ⧸ LinearMap.range f) ≃ₗ[R]
      (S ⊗[R] N) ⧸ LinearMap.range (LinearMap.lTensor S f) := by
  have hex : Function.Exact f (LinearMap.range f).mkQ := by
    rw [LinearMap.exact_iff, Submodule.ker_mkQ]
  have hq : Function.Surjective (LinearMap.range f).mkQ :=
    Submodule.mkQ_surjective _
  let e := _root_.lTensor.equiv S hex hq
  exact e.symm

/-- Scalar extension of a cokernel is the cokernel of the scalar extension, as modules over the
extended base ring. -/
noncomputable def cokerBaseChangeEquivScalars
    (R : Type u) (M : Type v) (N : Type w) (S : Type x)
    [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (f : M →ₗ[R] N) :
    S ⊗[R] (N ⧸ LinearMap.range f) ≃ₗ[S]
      (S ⊗[R] N) ⧸ LinearMap.range (TensorProduct.AlgebraTensorModule.lTensor S S f) := by
  classical
  let Q := N ⧸ LinearMap.range f
  let fS := TensorProduct.AlgebraTensorModule.lTensor S S f
  let rangeS := LinearMap.range fS
  let C := (S ⊗[R] N) ⧸ rangeS
  let g : N →ₗ[R] C :=
    { toFun := fun n => Submodule.Quotient.mk (p := rangeS)
        ((1 : S) ⊗ₜ[R] n)
      map_add' := by
        intro a b
        simp only [TensorProduct.tmul_add, Submodule.Quotient.mk_add]
      map_smul' := by
        intro r a
        rw [TensorProduct.tmul_smul, Submodule.Quotient.mk_smul]
        rfl }
  have hkill : LinearMap.range f ≤ LinearMap.ker g := by
    rw [LinearMap.range_le_ker_iff]
    ext m
    change Submodule.Quotient.mk ((1 : S) ⊗ₜ[R] f m) = 0
    apply (Submodule.Quotient.mk_eq_zero _).2
    exact ⟨(1 : S) ⊗ₜ[R] m, by simp [fS, TensorProduct.AlgebraTensorModule.lTensor_tmul]⟩
  let gQ : Q →ₗ[R] C := Submodule.liftQ _ g hkill
  let G : S →ₗ[S] (Q →ₗ[R] C) :=
    { toFun := fun s =>
        { toFun := fun q => s • gQ q
          map_add' := by intro a b; simp
          map_smul' := by
            intro r q
            change s • gQ (r • q) = r • (s • gQ q)
            rw [map_smul, smul_comm] }
      map_add' := by intro s t; ext q; simp [add_smul]
      map_smul' := by intro s t; ext q; simp [smul_smul] }
  let e : S ⊗[R] Q →ₗ[S] C := TensorProduct.AlgebraTensorModule.lift G
  have hmap : Submodule.map (LinearEquiv.refl R (S ⊗[R] N)).toLinearMap
      (LinearMap.range (LinearMap.lTensor S f)) = rangeS.restrictScalars R := by
    ext z
    simp [rangeS, fS]
  let eR : S ⊗[R] Q ≃ₗ[R] (S ⊗[R] N) ⧸ rangeS.restrictScalars R :=
    (cokerBaseChangeEquiv R M N S f).trans <|
      Submodule.Quotient.equiv _ _ (LinearEquiv.refl R _) hmap
  let eR' := eR.trans (Submodule.Quotient.restrictScalarsEquiv R rangeS)
  have he (x : S ⊗[R] Q) : e x = eR' x := by
    refine TensorProduct.induction_on x ?_ ?_ ?_
    · simp [e, eR']
    · intro s q
      induction q using Quotient.inductionOn with
      | _ n =>
        have hfg : Function.Exact f (LinearMap.range f).mkQ := by
          rw [LinearMap.exact_iff, Submodule.ker_mkQ]
        have hq : Function.Surjective (LinearMap.range f).mkQ :=
          Submodule.mkQ_surjective _
        have hinv : (cokerBaseChangeEquiv R M N S f)
            (s ⊗ₜ[R] (LinearMap.range f).mkQ n) =
              Submodule.Quotient.mk (s ⊗ₜ[R] n) := by
          unfold cokerBaseChangeEquiv
          change (_root_.lTensor.equiv S hfg hq).symm
            (s ⊗ₜ[R] (LinearMap.range f).mkQ n) = _
          rw [← LinearMap.lTensor_tmul]
          exact _root_.lTensor.inverse_apply S hfg hq (s ⊗ₜ[R] n)
        have hr : eR' (s ⊗ₜ[R] (LinearMap.range f).mkQ n) =
            Submodule.Quotient.mk (p := rangeS) (s ⊗ₜ[R] n) := by
          change (Submodule.Quotient.restrictScalarsEquiv R rangeS)
            ((Submodule.Quotient.equiv _ _ (LinearEquiv.refl R _) hmap)
              ((cokerBaseChangeEquiv R M N S f)
                (s ⊗ₜ[R] (LinearMap.range f).mkQ n))) = _
          rw [hinv]
          simp [Submodule.Quotient.restrictScalarsEquiv_mk]
        calc
          e (s ⊗ₜ[R] (LinearMap.range f).mkQ n) =
              Submodule.Quotient.mk (p := rangeS) (s ⊗ₜ[R] n) := by
            change s • gQ ((LinearMap.range f).mkQ n) = _
            have hmk : gQ ((LinearMap.range f).mkQ n) = g n :=
              LinearMap.congr_fun
                (Submodule.liftQ_mkQ (LinearMap.range f) g hkill) n
            rw [hmk]
            change s • Submodule.Quotient.mk ((1 : S) ⊗ₜ[R] n) = _
            have hst : s ⊗ₜ[R] n = s • ((1 : S) ⊗ₜ[R] n) := by
              calc
                s ⊗ₜ[R] n = (s • (1 : S)) ⊗ₜ[R] n := by simp
                _ = s • ((1 : S) ⊗ₜ[R] n) :=
                  (TensorProduct.smul_tmul' s 1 n).symm
            calc
              s • Submodule.Quotient.mk ((1 : S) ⊗ₜ[R] n) =
                  Submodule.Quotient.mk (s • ((1 : S) ⊗ₜ[R] n)) := by
                rw [Submodule.Quotient.mk_smul]
              _ = Submodule.Quotient.mk (s ⊗ₜ[R] n) := by rw [hst.symm]
          _ = eR' (s ⊗ₜ[R] (LinearMap.range f).mkQ n) := hr.symm
    · intro x y hx hy
      simp [hx, hy]
  exact LinearEquiv.ofBijective e (by rw [show ⇑e = ⇑eR' from funext he]; exact eR'.bijective)

/-- The discriminant ideal of a finite projective algebra is the zeroth Fitting ideal of the
cokernel of the trace pairing. -/
private theorem algebraDiscriminantIdeal_eq_fittingIdeal
    (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A] [Module.Finite R A]
    [Module.Projective R A] :
    algebraDiscriminantIdeal R A = fittingIdeal (R := R)
      (M := Module.Dual R A ⧸ LinearMap.range (finiteProjectiveTraceForm R A)) 0 := by
  unfold algebraDiscriminantIdeal
  rw [dite_eq_left ⟨inferInstance, inferInstance⟩]

/-- Extending scalars of the discriminant ideal gives the zeroth Fitting ideal of the scalar
extension of the cokernel of the trace pairing. -/
private theorem map_algebraDiscriminantIdeal_eq_fittingIdeal
    (R : Type u) (A : Type v) (S : Type w) [CommRing R] [CommRing A] [Algebra R A]
    [Module.Finite R A] [Module.Projective R A] [CommRing S] [Algebra R S] :
    Ideal.map (algebraMap R S) (algebraDiscriminantIdeal R A) = fittingIdeal (R := S)
      (M := S ⊗[R] (Module.Dual R A ⧸ LinearMap.range (finiteProjectiveTraceForm R A))) 0 := by
  rw [algebraDiscriminantIdeal_eq_fittingIdeal]
  exact (fittingIdeal_basic_properties.{u, max u v, u, w} (R := R)
    (M := Module.Dual R A ⧸ LinearMap.range (finiteProjectiveTraceForm R A))).2.2.1 S 0 |>.symm

/-- The discriminant ideal of a finite projective algebra commutes with base change. -/
theorem algebraDiscriminantIdeal_map
    (R : Type u) (A : Type v) (S : Type w)
    [CommRing R] [CommRing A] [Algebra R A] [Module.Finite R A]
    [Module.Projective R A] [CommRing S] [Algebra R S] :
    Ideal.map (algebraMap R S) (algebraDiscriminantIdeal R A) =
      algebraDiscriminantIdeal S (S ⊗[R] A) := by
  classical
  let Q := Module.Dual R A ⧸ LinearMap.range (finiteProjectiveTraceForm R A)
  let Φ : A →ₗ[R] Module.Dual R A := finiteProjectiveTraceForm R A
  let ΦS : (S ⊗[R] A) →ₗ[S] Module.Dual S (S ⊗[R] A) :=
    finiteProjectiveTraceForm S (S ⊗[R] A)
  let eDual : S ⊗[R] Module.Dual R A ≃ₗ[S] Module.Dual S (S ⊗[R] A) :=
    LinearEquiv.ofBijective (dualTensorBaseChange R A S)
      (dualTensorBaseChange_bijective R A S)
  have hbase : TensorProduct.AlgebraTensorModule.lTensor S S Φ = Φ.baseChange S :=
    LinearMap.ext fun x ↦ congrFun (LinearMap.baseChange_eq_ltensor Φ) x
  have hcomp : eDual.toLinearMap.comp
      (TensorProduct.AlgebraTensorModule.lTensor S S Φ) = ΦS := by
    rw [hbase]
    exact (finiteProjectiveTraceForm_scalarTensor_map R A S).symm
  have hrange : Submodule.map eDual.toLinearMap
      (LinearMap.range (TensorProduct.AlgebraTensorModule.lTensor S S Φ)) =
        LinearMap.range ΦS := by
    rw [← LinearMap.range_comp, hcomp]
  let eQ : S ⊗[R] Q ≃ₗ[S]
      (Module.Dual S (S ⊗[R] A) ⧸ LinearMap.range ΦS) :=
    (cokerBaseChangeEquivScalars R A (Module.Dual R A) S Φ).trans
      (Submodule.Quotient.equiv _ _ eDual hrange)
  rw [map_algebraDiscriminantIdeal_eq_fittingIdeal, algebraDiscriminantIdeal_eq_fittingIdeal S]
  exact fittingIdeal_eq_of_linearEquiv eQ 0

/-- The projective trace is invariant under conjugating an endomorphism by a linear equivalence. -/
@[sga "6 I 8.4" "special case"]
theorem finiteProjectiveTrace_conj
    (R : Type u) (P : Type v) (Q : Type w)
    [CommRing R] [AddCommGroup P] [Module R P] [Module.Finite R P]
    [Module.Projective R P] [AddCommGroup Q] [Module R Q] [Module.Finite R Q]
    [Module.Projective R Q] (e : P ≃ₗ[R] Q) (g : Module.End R P) :
    finiteProjectiveTrace R Q
        (e.toLinearMap.comp (g.comp e.symm.toLinearMap)) =
      finiteProjectiveTrace R P g := by
  classical
  obtain ⟨n, p, i, _, _, hpi⟩ := Module.Finite.exists_comp_eq_id_of_projective R P
  let F := Fin n → R
  let pQ : F →ₗ[R] Q := e.toLinearMap.comp p
  let iQ : Q →ₗ[R] F := i.comp e.symm.toLinearMap
  have hpQiQ : pQ.comp iQ = LinearMap.id := by
    ext x
    show e ((p.comp i) (e.symm x)) = x
    rw [hpi]
    simp
  have htrace : iQ.comp
      ((e.toLinearMap.comp (g.comp e.symm.toLinearMap)).comp pQ) =
        i.comp (g.comp p) := by
    ext x
    simp [pQ, iQ, LinearMap.comp_assoc]
  calc
    finiteProjectiveTrace R Q
        (e.toLinearMap.comp (g.comp e.symm.toLinearMap)) =
        LinearMap.trace R F
          (iQ.comp ((e.toLinearMap.comp (g.comp e.symm.toLinearMap)).comp pQ)) :=
      finiteProjectiveTrace_eq_trace_of_split R Q F pQ iQ hpQiQ _
    _ = LinearMap.trace R F (i.comp (g.comp p)) := by rw [htrace]
    _ = finiteProjectiveTrace R P g :=
      (finiteProjectiveTrace_eq_trace_of_split R P F p i hpi g).symm

/-- A linear equivalence induces an equivalence of the linear duals. -/
noncomputable def dualLinearEquivOfLinearEquiv
    (R : Type u) (P : Type v) (Q : Type w)
    [CommRing R] [AddCommGroup P] [Module R P] [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) : Module.Dual R P ≃ₗ[R] Module.Dual R Q :=
  e.symm.dualMap

/-- An algebra equivalence identifies the projective trace pairings of its source and target. -/
theorem finiteProjectiveTraceForm_algEquiv
    (R : Type u) (A : Type v) (B : Type w)
    [CommRing R] [CommRing A] [Algebra R A] [Module.Finite R A]
    [Module.Projective R A] [CommRing B] [Algebra R B] [Module.Finite R B]
    [Module.Projective R B] (e : A ≃ₐ[R] B) :
    (dualLinearEquivOfLinearEquiv R A B e.toLinearEquiv).toLinearMap.comp
        (finiteProjectiveTraceForm R A : A →ₗ[R] Module.Dual R A) =
      LinearMap.comp (finiteProjectiveTraceForm R B) e.toLinearMap := by
  apply LinearMap.ext
  intro a
  apply LinearMap.ext
  intro b
  show finiteProjectiveTrace R A
      ((Algebra.lmul R A).toLinearMap (a * e.symm b)) =
    finiteProjectiveTrace R B
      ((Algebra.lmul R B).toLinearMap (e a * b))
  have hmul : e.toLinearMap.comp
      (((Algebra.lmul R A).toLinearMap (a * e.symm b)).comp e.symm.toLinearMap) =
      (Algebra.lmul R B).toLinearMap (e a * b) := by
    ext c
    show e ((a * e.symm b) * e.symm c) = (e a * b) * c
    simp [map_mul]
  rw [← hmul]
  exact (finiteProjectiveTrace_conj R A B e.toLinearEquiv _).symm

/-- The discriminant ideal only depends on the isomorphism class of the algebra. -/
theorem algebraDiscriminantIdeal_algEquiv
    (R : Type u) (A : Type v) (B : Type w)
    [CommRing R] [CommRing A] [Algebra R A] [Module.Finite R A]
    [Module.Projective R A] [CommRing B] [Algebra R B] [Module.Finite R B]
    [Module.Projective R B] (e : A ≃ₐ[R] B) :
    algebraDiscriminantIdeal R A = algebraDiscriminantIdeal R B := by
  classical
  let ΦA : A →ₗ[R] Module.Dual R A := finiteProjectiveTraceForm R A
  let ΦB : B →ₗ[R] Module.Dual R B := finiteProjectiveTraceForm R B
  let eDual := dualLinearEquivOfLinearEquiv R A B e.toLinearEquiv
  have hcomp : eDual.toLinearMap.comp ΦA = ΦB.comp e.toLinearMap :=
    finiteProjectiveTraceForm_algEquiv R A B e
  have hrange : Submodule.map eDual.toLinearMap (LinearMap.range ΦA) =
      LinearMap.range ΦB := by
    calc
      _ = LinearMap.range (eDual.toLinearMap.comp ΦA) := by
        rw [← LinearMap.range_comp]
      _ = LinearMap.range (ΦB.comp e.toLinearMap) := by rw [hcomp]
      _ = LinearMap.range ΦB :=
        LinearMap.range_comp_of_range_eq_top _ e.toLinearEquiv.range
  let eQ : (Module.Dual R A ⧸ LinearMap.range ΦA) ≃ₗ[R]
      (Module.Dual R B ⧸ LinearMap.range ΦB) :=
    Submodule.Quotient.equiv _ _ eDual hrange
  rw [algebraDiscriminantIdeal_eq_fittingIdeal R A, algebraDiscriminantIdeal_eq_fittingIdeal R B]
  exact fittingIdeal_eq_of_linearEquiv eQ 0


/-- The projective trace pairing is symmetric. -/
theorem finiteProjectiveTraceForm_apply_symm
    (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A]
    [Module.Finite R A] [Module.Projective R A] (a b : A) :
    finiteProjectiveTraceForm R A a b = finiteProjectiveTraceForm R A b a := by
  show finiteProjectiveTrace R A
      ((Algebra.lmul R A).toLinearMap (a * b)) =
    finiteProjectiveTrace R A ((Algebra.lmul R A).toLinearMap (b * a))
  rw [mul_comm]

/-- Pairing against a pure tensor in a scalar extension is the base change of the functional
cut out by the projective trace pairing. -/
@[ega "IV 18.2.1" "more general"]
theorem traceForm_scalarTensor_right_eq_dualBaseChange
    (R : Type u) (A : Type v) (K : Type w)
    [CommRing R] [CommRing A] [Algebra R A] [Module.Finite R A]
    [Module.Projective R A] [CommRing K] [Algebra R K]
    [Module.Free K (K ⊗[R] A)]
    (a : A) (x : K ⊗[R] A) :
    Algebra.traceForm K (K ⊗[R] A) x (1 ⊗ₜ[R] a) =
      Module.Dual.baseChange K (finiteProjectiveTraceForm R A a) x := by
  classical
  refine TensorProduct.induction_on x ?_ ?_ ?_
  · simp
  · intro k b
    rw [tmul_eq_smul_one_tmul k b, map_smul]
    simp only [LinearMap.smul_apply]
    rw [traceForm_scalarTensor_apply]
    rw [finiteProjectiveTraceForm_apply_symm]
    simp [Module.Dual.baseChange_apply_tmul, Algebra.smul_def, mul_comm]
  · intro x y hx hy
    simp [hx, hy]

/-- A nonzero element of a scalar extension of a finite projective module by a field is detected
by the base change of some functional. -/
theorem exists_dual_baseChange_ne_zero
    (R : Type u) (P : Type v) (K : Type w)
    [CommRing R] [Field K] [Algebra R K]
    [AddCommGroup P] [Module R P] [Module.Finite R P] [Module.Projective R P]
    {x : K ⊗[R] P} (hx : x ≠ 0) :
    ∃ φ : Module.Dual R P, Module.Dual.baseChange K φ x ≠ 0 := by
  classical
  obtain ⟨n, p, i, _, _, hi⟩ := Module.Finite.exists_comp_eq_id_of_projective R P
  let iK := i.baseChange K
  have hix : iK x ≠ 0 := by
    intro hz
    apply hx
    have hpK : (p.baseChange K).comp iK = LinearMap.id := by
      rw [← LinearMap.baseChange_comp, hi, LinearMap.baseChange_id]
    calc
      x = (p.baseChange K) (iK x) := (LinearMap.congr_fun hpK x).symm
      _ = (p.baseChange K) 0 := congrArg (p.baseChange K) hz
      _ = 0 := map_zero _
  let e : K ⊗[R] (Fin n → R) ≃ₗ[K] (Fin n → K) :=
    (TensorProduct.piRight R K K (fun _ : Fin n => R)).trans
      (LinearEquiv.piCongrRight fun _ => TensorProduct.AlgebraTensorModule.rid R K K)
  have he : e (iK x) ≠ 0 := fun hz ↦ hix (e.injective (by simpa using hz))
  obtain ⟨j, hj⟩ := Function.ne_iff.mp he
  let φ : Module.Dual R P := (LinearMap.proj j).comp i
  have hcoord (z : K ⊗[R] (Fin n → R)) :
      (TensorProduct.piRightHom R K K (fun _ : Fin n => R) z) j =
        (LinearMap.baseChange K (LinearMap.proj j)) z := by
    refine TensorProduct.induction_on z ?_ ?_ ?_
    · simp [TensorProduct.piRightHom]
    · intro k y
      simp [TensorProduct.piRightHom_tmul, LinearMap.baseChange_tmul]
    · intro z z' hz hz'
      simp [hz, hz']
  have hφ : Module.Dual.baseChange K φ x = e (iK x) j := by
    simp only [Module.Dual.baseChange, LinearMap.coe_comp, Function.comp_apply,
      LinearMap.baseChangeHom_apply, LinearMap.baseChange_comp, LinearMap.compRight_apply,
      LinearEquiv.coe_coe, TensorProduct.piRight, TensorProduct.piRightHom,
      LinearEquiv.trans_apply, LinearEquiv.coe_ofLinearMap,
      TensorProduct.AlgebraTensorModule.lift_apply, LinearEquiv.piCongrRight_apply,
      EmbeddingLike.apply_eq_iff_eq, φ, e, iK]
    show (LinearMap.baseChange K (LinearMap.proj j)) (iK x) =
      (TensorProduct.piRightHom R K K (fun _ : Fin n => R) (iK x)) j
    exact (hcoord (iK x)).symm
  exact ⟨φ, hφ ▸ hj⟩

/-- If the projective trace pairing is surjective onto the dual, then the trace form of every
scalar extension by a field is nondegenerate. -/
theorem traceForm_scalarTensor_nondegenerate_of_surjective
    (R : Type u) (A : Type v) (K : Type w)
    [CommRing R] [CommRing A] [Algebra R A] [Module.Finite R A]
    [Module.Projective R A] [Field K] [Algebra R K]
    (hsurj : Function.Surjective (finiteProjectiveTraceForm R A)) :
    (Algebra.traceForm K (K ⊗[R] A)).Nondegenerate := by
  apply LinearMap.BilinForm.Nondegenerate.ofSeparatingLeft
  intro x hx
  by_contra hx0
  obtain ⟨φ, hφ⟩ := exists_dual_baseChange_ne_zero R A K hx0
  obtain ⟨a, ha⟩ := hsurj φ
  have hzero := hx ((1 : K) ⊗ₜ[R] a)
  rw [traceForm_scalarTensor_right_eq_dualBaseChange R A K a x, ha] at hzero
  exact hφ hzero

/-- Over a field the projective trace pairing is surjective exactly when it is nondegenerate. -/
theorem finiteProjectiveTraceForm_surjective_iff_nondegenerate
    (K : Type u) (A : Type v) [Field K] [CommRing A] [Algebra K A]
    [Module.Finite K A] [Module.Projective K A] [Module.Free K A] :
    Function.Surjective (finiteProjectiveTraceForm K A) ↔
      (finiteProjectiveTraceForm K A).Nondegenerate := by
  rw [finiteProjectiveTraceForm_eq_traceForm]
  have hdim : Module.finrank K A = Module.finrank K (Module.Dual K A) :=
    Subspace.dual_finrank_eq.symm
  show Function.Surjective (Algebra.traceForm K A) ↔
    (Algebra.traceForm K A).Nondegenerate
  rw [← LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim,
    ← LinearMap.ker_eq_bot, ← LinearMap.BilinForm.nondegenerate_iff_ker_eq_bot]

/-- An algebra over a field with nondegenerate trace form is reduced. -/
theorem isReduced_of_traceForm_nondegenerate
    (K : Type u) (A : Type v) [Field K] [CommRing A] [Algebra K A]
    (h : (Algebra.traceForm K A).Nondegenerate) :
    IsReduced A := by
  refine ⟨fun a ha => ?_⟩
  apply h.1 a
  intro b
  rw [Algebra.traceForm_apply]
  have hab : IsNilpotent (a * b) := (Commute.all a b).isNilpotent_mul_right ha
  exact IsNilpotent.eq_zero (Algebra.isNilpotent_trace_of_isNilpotent hab)

/-- The trace of a finite product of finite free algebras is the sum of the traces. -/
theorem algebraTrace_pi_eq_sum
    (K : Type u) (I : Type v) (A : I → Type w)
    [Field K] [Fintype I]
    [∀ i, CommRing (A i)] [∀ i, Algebra K (A i)]
    [∀ i, Module.Finite K (A i)] [∀ i, Module.Free K (A i)]
    (x : ∀ i, A i) :
    Algebra.trace K (∀ i, A i) x = ∑ i, Algebra.trace K (A i) (x i) := by
  classical
  let b := fun i => Module.Free.chooseBasis K (A i)
  let B := Pi.basis b
  rw [Algebra.trace_eq_matrix_trace B x]
  simp only [Matrix.trace, Matrix.diag_apply, Algebra.leftMulMatrix_eq_repr_mul]
  rw [Fintype.sum_sigma]
  congr 1
  ext i
  rw [Algebra.trace_eq_matrix_trace (b i) (x i)]
  simp [B, Matrix.trace, Matrix.diag_apply, Algebra.leftMulMatrix_eq_repr_mul,
    Pi.basis_apply, Pi.basis_repr]

/-- The trace form of a finite product, paired on the right against an element supported in one
factor. -/
theorem traceForm_pi_apply_single_right
    (K : Type u) (I : Type v) (A : I → Type w)
    [Field K] [Finite I] [DecidableEq I]
    [∀ i, CommRing (A i)] [∀ i, Algebra K (A i)]
    [∀ i, Module.Finite K (A i)] [∀ i, Module.Free K (A i)]
    (x : ∀ i, A i) (i : I) (y : A i) :
    Algebra.traceForm K (∀ i, A i) x (Pi.single i y) =
      Algebra.traceForm K (A i) (x i) y := by
  let : Fintype I := Fintype.ofFinite I
  rw [Algebra.traceForm_apply, algebraTrace_pi_eq_sum K I A,
    Algebra.traceForm_apply]
  rw [Finset.sum_eq_single i]
  · simp
  · intro j hj hji
    simp [hji]
  · simp

/-- The trace form of a finite product, paired on the left against an element supported in one
factor. -/
theorem traceForm_pi_apply_single_left
    (K : Type u) (I : Type v) (A : I → Type w)
    [Field K] [Finite I] [DecidableEq I]
    [∀ i, CommRing (A i)] [∀ i, Algebra K (A i)]
    [∀ i, Module.Finite K (A i)] [∀ i, Module.Free K (A i)]
    (i : I) (x : A i) (y : ∀ i, A i) :
    Algebra.traceForm K (∀ i, A i) (Pi.single i x) y =
      Algebra.traceForm K (A i) x (y i) := by
  rw [(Algebra.traceForm_isSymm K).eq, traceForm_pi_apply_single_right,
    (Algebra.traceForm_isSymm K).eq]

/-- The trace form of a finite product of finite field extensions is nondegenerate exactly when
every factor is separable. -/
theorem traceForm_pi_nondegenerate_iff
    (K : Type u) (I : Type v) (A : I → Type w)
    [Field K] [Finite I] [∀ i, Field (A i)] [∀ i, Algebra K (A i)]
    [∀ i, Module.Finite K (A i)] :
    (Algebra.traceForm K (∀ i, A i)).Nondegenerate ↔
      ∀ i, Algebra.IsSeparable K (A i) := by
  classical
  let : Fintype I := Fintype.ofFinite I
  have hfree (i : I) : Module.Free K (A i) := inferInstance
  constructor
  · intro h i
    have hi : (Algebra.traceForm K (A i)).Nondegenerate := by
      apply LinearMap.BilinForm.Nondegenerate.ofSeparatingLeft
      intro x hx
      by_contra hx0
      let x' : ∀ j, A j := Pi.single i x
      have hx' : x' ≠ 0 := fun hz ↦ hx0 (by simpa [x'] using congrFun hz i)
      exact hx' (h.1 x' fun y ↦ (traceForm_pi_apply_single_left K I A i x y).trans (hx (y i)))
    exact ((traceForm_nondegenerate_tfae K (A i)).out 3 1).mp hi
  · intro h
    apply LinearMap.BilinForm.Nondegenerate.ofSeparatingLeft
    intro x hx
    by_contra hx0
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hx0
    obtain ⟨y, hy⟩ : ∃ y : A i, Algebra.traceForm K (A i) (x i) y ≠ 0 :=
      not_forall.mp fun hz ↦ hi ((traceForm_nondegenerate K (A i)).1 (x i) hz)
    exact hy ((traceForm_pi_apply_single_right K I A x i y).symm.trans (hx (Pi.single i y)))

/-- Nondegeneracy of the trace form transfers along an algebra equivalence. -/
private theorem traceForm_nondegenerate_of_algEquiv
    (K : Type u) (A : Type v) (B : Type w) [Field K]
    [CommRing A] [Algebra K A] [Module.Finite K A]
    [CommRing B] [Algebra K B] [Module.Finite K B]
    (e : A ≃ₐ[K] B) (h : (Algebra.traceForm K A).Nondegenerate) :
    (Algebra.traceForm K B).Nondegenerate := by
  apply LinearMap.BilinForm.Nondegenerate.ofSeparatingLeft
  intro x hx
  apply e.symm.injective
  rw [map_zero]
  refine h.1 _ fun y ↦ ?_
  have hy := hx (e y)
  rw [Algebra.traceForm_apply] at hy ⊢
  rwa [← Algebra.trace_eq_of_algEquiv e, map_mul, e.apply_symm_apply]

/-- Nondegeneracy of the trace form only depends on the isomorphism class of the algebra. -/
theorem traceForm_nondegenerate_algEquiv_iff
    (K : Type u) (A : Type v) (B : Type w) [Field K]
    [CommRing A] [Algebra K A] [Module.Finite K A]
    [CommRing B] [Algebra K B] [Module.Finite K B]
    (e : A ≃ₐ[K] B) :
    (Algebra.traceForm K A).Nondegenerate ↔ (Algebra.traceForm K B).Nondegenerate :=
  ⟨traceForm_nondegenerate_of_algEquiv K A B e, traceForm_nondegenerate_of_algEquiv K B A e.symm⟩

attribute [local instance] IsArtinianRing.fieldOfSubtypeIsMaximal in
/-- A finite-dimensional algebra over a field is étale exactly when its trace pairing is
nondegenerate. -/
@[sga "1 I 4.10" "special case"]
theorem finiteDimensional_etale_iff_traceForm_nondegenerate
    (K : Type u) (A : Type v) [Field K] [CommRing A] [Algebra K A]
    [FiniteDimensional K A] :
    Algebra.Etale K A ↔ (Algebra.traceForm K A).Nondegenerate := by
  classical
  constructor
  · intro hA
    let : Algebra.FormallyEtale K A := inferInstance
    let : IsReduced A := Algebra.FormallyUnramified.isReduced_of_field K A
    let : IsArtinianRing A := isArtinian_of_tower K inferInstance
    let e : A ≃ₐ[K] ∀ I : MaximalSpectrum A, A ⧸ I.asIdeal :=
      (IsArtinianRing.equivPi A).restrictScalars K
    exact (traceForm_nondegenerate_algEquiv_iff K A _ e).mpr
      ((traceForm_pi_nondegenerate_iff K _ _).2 fun _ ↦ inferInstance)
  · intro hA
    let : IsArtinianRing A := isArtinian_of_tower K inferInstance
    let : IsReduced A := isReduced_of_traceForm_nondegenerate K A hA
    let e : A ≃ₐ[K] ∀ I : MaximalSpectrum A, A ⧸ I.asIdeal :=
      (IsArtinianRing.equivPi A).restrictScalars K
    have hsep := (traceForm_pi_nondegenerate_iff K _ _).mp
      ((traceForm_nondegenerate_algEquiv_iff K A _ e).mp hA)
    have hFEpi : Algebra.FormallyEtale K (∀ I : MaximalSpectrum A, A ⧸ I.asIdeal) := by
      simpa only [Algebra.FormallyEtale.pi_iff, Algebra.FormallyEtale.iff_isSeparable] using hsep
    have hFE : Algebra.FormallyEtale K A := hFEpi.of_equiv e.symm
    have hFP : Algebra.FinitePresentation K A :=
      (Algebra.FinitePresentation.of_finiteType (R := K) (A := A)).mp inferInstance
    exact (Algebra.etale_iff K A).mpr ⟨hFE, hFP⟩

/-- The zeroth Fitting ideal of a finite module is the unit ideal exactly when the module is
zero. -/
private theorem fittingIdeal_zero_eq_top_iff_subsingleton_aux
    (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M]
    [Module R M] [Module.Finite R M] :
    fittingIdeal (R := R) (M := M) 0 = ⊤ ↔ Subsingleton M := by
  classical
  refine ⟨fun h ↦ Module.annihilator_eq_top_iff.mp (top_unique (h ▸
    (fittingIdeal_basic_properties.{u, v, u, u} (R := R) (M := M)).2.2.2.2.2.1)),
    fun _ ↦ ?_⟩
  simpa using (fittingIdeal_basic_properties.{u, v, u, u} (R := R) (M := M)).1 0
    ⟨Fin.elim0, Subsingleton.elim _ _⟩

/-- The discriminant ideal of a finite projective algebra is the unit ideal exactly when the
projective trace pairing is surjective onto the dual. -/
theorem algebraDiscriminantIdeal_eq_top_iff_surjective
    (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A]
    [Module.Finite R A] [Module.Projective R A] :
    algebraDiscriminantIdeal R A = ⊤ ↔
      Function.Surjective (finiteProjectiveTraceForm R A) := by
  classical
  let : Module.Finite R (Module.Dual R A) := inferInstance
  let Φ : A →ₗ[R] Module.Dual R A := finiteProjectiveTraceForm R A
  let Q := Module.Dual R A ⧸ LinearMap.range Φ
  let : Module.Finite R Q := inferInstance
  have hquot : Subsingleton Q ↔ Function.Surjective Φ := by
    rw [Submodule.Quotient.subsingleton_iff, ← LinearMap.range_eq_top]
  rw [algebraDiscriminantIdeal_eq_fittingIdeal]
  exact (fittingIdeal_zero_eq_top_iff_subsingleton_aux R Q).trans hquot

/-- The zeroth Fitting ideal of a finite module is the unit ideal exactly when the module is
zero. -/
theorem fittingIdeal_zero_eq_top_iff_subsingleton
    (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M]
    [Module R M] [Module.Finite R M] :
    fittingIdeal (R := R) (M := M) 0 = ⊤ ↔ Subsingleton M :=
  fittingIdeal_zero_eq_top_iff_subsingleton_aux R M

/-- The discriminant ideal of a finite projective algebra generates the unit ideal in a field
exactly when the corresponding fibre algebra is étale. -/
theorem algebraDiscriminantIdeal_map_eq_top_iff_etale_fiber
    (R : Type u) (A : Type v) (K : Type u)
    [CommRing R] [CommRing A] [Algebra R A] [Module.Finite R A]
    [Module.Projective R A] [Field K] [Algebra R K] :
    Ideal.map (algebraMap R K) (algebraDiscriminantIdeal R A) = ⊤ ↔
      Algebra.Etale K (K ⊗[R] A) := by
  classical
  let : Module.Finite K (K ⊗[R] A) := inferInstance
  let : Module.Projective K (K ⊗[R] A) := inferInstance
  let Q := Module.Dual R A ⧸ LinearMap.range (finiteProjectiveTraceForm R A)
  let : Module.Finite R (Module.Dual R A) := inferInstance
  let : Module.Finite R Q := inferInstance
  let Φ : A →ₗ[R] Module.Dual R A := finiteProjectiveTraceForm R A
  let Ψ := LinearMap.baseChange K Φ
  have hquot :
      Subsingleton (K ⊗[R] Q) ↔ Function.Surjective Ψ := by
    rw [LinearMap.baseChange_eq_ltensor]
    let e := cokerBaseChangeEquiv R A (Module.Dual R A) K Φ
    have hcoker :
        Subsingleton ((K ⊗[R] Module.Dual R A) ⧸ LinearMap.range (LinearMap.lTensor K Φ)) ↔
          Function.Surjective (LinearMap.lTensor K Φ) := by
      rw [Submodule.Quotient.subsingleton_iff, LinearMap.range_eq_top]
    refine ⟨fun h ↦ hcoker.mp e.symm.injective.subsingleton, fun h ↦ ?_⟩
    have := hcoker.mpr h
    exact e.injective.subsingleton
  have hsurj :
      Function.Surjective Ψ ↔
        Function.Surjective (finiteProjectiveTraceForm K (K ⊗[R] A)) := by
    rw [show finiteProjectiveTraceForm K (K ⊗[R] A) =
      (dualTensorBaseChange R A K).comp
        ((finiteProjectiveTraceForm R A : A →ₗ[R] Module.Dual R A).baseChange K) from
          finiteProjectiveTraceForm_scalarTensor_map R A K]
    have hdual := dualTensorBaseChange_bijective R A K
    constructor
    · intro hs y
      obtain ⟨ψ, hψ⟩ := hdual.2 y
      obtain ⟨a, ha⟩ := hs ψ
      exact ⟨a, (congrArg (dualTensorBaseChange R A K) ha).trans hψ⟩
    · intro hs
      have hs' : Function.Surjective
          ((dualTensorBaseChange R A K).comp Ψ) := by simpa using hs
      intro ψ
      obtain ⟨a, ha⟩ := hs' (dualTensorBaseChange R A K ψ)
      exact ⟨a, hdual.1 ha⟩
  have hlast :
      Function.Surjective (finiteProjectiveTraceForm K (K ⊗[R] A)) ↔
        Algebra.Etale K (K ⊗[R] A) := by
    calc
      Function.Surjective (finiteProjectiveTraceForm K (K ⊗[R] A)) ↔
          (finiteProjectiveTraceForm K (K ⊗[R] A)).Nondegenerate :=
        finiteProjectiveTraceForm_surjective_iff_nondegenerate K (K ⊗[R] A)
      _ ↔ (Algebra.traceForm K (K ⊗[R] A)).Nondegenerate := by
        rw [finiteProjectiveTraceForm_eq_traceForm K (K ⊗[R] A)]
      _ ↔ Algebra.Etale K (K ⊗[R] A) :=
        (finiteDimensional_etale_iff_traceForm_nondegenerate K (K ⊗[R] A)).symm
  calc
    Ideal.map (algebraMap R K) (algebraDiscriminantIdeal R A) = ⊤ ↔
        fittingIdeal (R := K) (M := K ⊗[R] Q) 0 = ⊤ := by
      rw [map_algebraDiscriminantIdeal_eq_fittingIdeal]
    _ ↔ Subsingleton (K ⊗[R] Q) :=
      fittingIdeal_zero_eq_top_iff_subsingleton K (K ⊗[R] Q)
    _ ↔ Function.Surjective Ψ := hquot
    _ ↔ Function.Surjective (finiteProjectiveTraceForm K (K ⊗[R] A)) := hsurj
    _ ↔ Algebra.Etale K (K ⊗[R] A) := hlast

/-- An ideal maps to zero in a residue field exactly when it is contained in the corresponding
prime. -/
theorem ideal_map_residueField_eq_bot_iff
    (R : Type u) (K : Type v) [CommRing R] [Field K]
    (P : Ideal R) (φ : R →+* K) (hφ : RingHom.ker φ = P)
    (I : Ideal R) :
    I.map φ = ⊥ ↔ I ≤ P := by
  rw [Ideal.map_eq_bot_iff_le_ker, hφ]

/-- An ideal maps onto a residue field exactly when it is not contained in the corresponding
prime. -/
theorem ideal_map_residueField_eq_top_iff
    (R : Type u) (K : Type v) [CommRing R] [Field K]
    (P : Ideal R) (φ : R →+* K) (hφ : RingHom.ker φ = P)
    (I : Ideal R) :
    I.map φ = ⊤ ↔ ¬ I ≤ P := by
  rw [← ideal_map_residueField_eq_bot_iff R K P φ hφ I]
  rcases (I.map φ).eq_bot_or_top with h | h <;> simp [h]

/-- An étale finite projective algebra has unit discriminant ideal. -/
theorem algebraDiscriminantIdeal_eq_top_of_etale
    (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A]
    [Module.Finite R A] [Module.Projective R A]
    (h : Algebra.Etale R A) : algebraDiscriminantIdeal R A = ⊤ := by
  classical
  by_contra hne
  obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
  let K := m.ResidueField
  let : Algebra.Etale R A := h
  have hmap : Ideal.map (algebraMap R K) (algebraDiscriminantIdeal R A) ≤ ⊥ := by
    rw [Ideal.map_le_iff_le_comap]
    show algebraDiscriminantIdeal R A ≤ RingHom.ker (algebraMap R K)
    rwa [Ideal.ker_algebraMap_residueField]
  rw [(algebraDiscriminantIdeal_map_eq_top_iff_etale_fiber R A K).mpr inferInstance] at hmap
  exact top_ne_bot (le_bot_iff.mp hmap)

/-- The ideal of maximal minors of a square matrix is generated by its determinant, hence
principal. -/
theorem minorIdeal_fin_principal {R : Type u} [CommRing R] (n : ℕ)
    (A : Matrix (Fin n) (Fin n) R) : (minorIdeal A n).IsPrincipal := by
  classical
  have hspan : minorIdeal A n = Ideal.span {A.det} := by
    apply le_antisymm
    · rw [minorIdeal, Ideal.span_le]
      rintro x ⟨g, h, rfl⟩
      by_cases hg : Function.Injective g
      · by_cases hh : Function.Injective h
        · have hg' : Function.Surjective g := Finite.injective_iff_surjective.mp hg
          have hh' : Function.Surjective h := Finite.injective_iff_surjective.mp hh
          let eg : Fin n ≃ Fin n := Equiv.ofBijective g ⟨hg, hg'⟩
          let eh : Fin n ≃ Fin n := Equiv.ofBijective h ⟨hh, hh'⟩
          let σ := eh.trans eg.symm
          have hmat : A.submatrix g h = (A.submatrix eg eg).submatrix id σ := by
            ext i j
            show A (g i) (h j) = A (eg i) (eg (eg.symm (eh j)))
            rw [eg.apply_symm_apply]
            rfl
          rw [hmat, Matrix.det_permute', Matrix.det_submatrix_equiv_self]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
        · obtain ⟨i, j, heq, hij⟩ := Function.not_injective_iff.mp hh
          have hdet : (A.submatrix g h).det = 0 := by
            apply Matrix.det_zero_of_column_eq hij
            intro k
            simp [Matrix.submatrix_apply, heq]
          exact hdet ▸ Ideal.zero_mem _
      · obtain ⟨i, j, heq, hij⟩ := Function.not_injective_iff.mp hg
        have hdet : (A.submatrix g h).det = 0 := by
          apply Matrix.det_zero_of_row_eq hij
          ext k
          simp [Matrix.submatrix_apply, heq]
        exact hdet ▸ Ideal.zero_mem _
    · rw [minorIdeal, Ideal.span_le]
      rintro _ rfl
      exact Ideal.subset_span ⟨id, id, rfl⟩
  rw [hspan]
  infer_instance

/-- The zeroth Fitting ideal of the cokernel of a map between finite free modules of equal rank
is principal, generated by the determinant. -/
theorem fittingIdeal_coker_isPrincipal_of_free
    (R : Type u) (M : Type v) (N : Type w)
    [CommRing R] [StrongRankCondition R]
    [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.Free R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N] [Module.Free R N]
    (hfinrank : Module.finrank R M = Module.finrank R N) (f : M →ₗ[R] N) :
    (fittingIdeal (R := R) (M := N ⧸ LinearMap.range f) 0).IsPrincipal := by
  classical
  let bM := Module.finBasis R M
  let bN := Module.finBasisOfFinrankEq R N hfinrank.symm
  let A := LinearMap.toMatrix bM bN f
  let eM : (Fin (Module.finrank R M) → R) ≃ₗ[R] M := bM.equivFun.symm
  let eN : (Fin (Module.finrank R M) → R) ≃ₗ[R] N := bN.equivFun.symm
  have hF : eN.toLinearMap.comp A.mulVecLin = f.comp eM.toLinearMap := by
    apply LinearMap.ext
    intro x
    apply bN.equivFun.injective
    show bN.equivFun (eN (A.mulVecLin x)) = bN.equivFun (f (eM x))
    have hM : (bM.repr (eM x) : Fin (Module.finrank R M) → R) = x := by
      show bM.equivFun (eM x) = x
      exact LinearEquiv.apply_symm_apply bM.equivFun x
    have hm := LinearMap.toMatrix_mulVec_repr bM bN f (eM x)
    calc
      bN.equivFun (eN (A.mulVecLin x)) = A.mulVecLin x := by
        dsimp [eN]
        exact LinearEquiv.apply_symm_apply bN.equivFun _
      _ = A *ᵥ x := Matrix.mulVecLin_apply A x
      _ = A *ᵥ (bM.repr (eM x) : Fin (Module.finrank R M) → R) := by rw [hM]
      _ = (bN.repr (f (eM x)) : Fin (Module.finrank R M) → R) := by
        simpa [A] using hm
      _ = bN.equivFun (f (eM x)) := rfl
  have hmap : Submodule.map eN.toLinearMap
      (Submodule.span R (Set.range A.col)) = LinearMap.range f := by
    calc
      _ = Submodule.map eN.toLinearMap (LinearMap.range A.mulVecLin) := by
        rw [Matrix.range_mulVecLin]
      _ = LinearMap.range (eN.toLinearMap.comp A.mulVecLin) := by
        rw [← LinearMap.range_comp]
      _ = LinearMap.range (f.comp eM.toLinearMap) := by rw [hF]
      _ = LinearMap.range f := LinearMap.range_comp_of_range_eq_top _ eM.range
  let eQ := Submodule.Quotient.equiv _ _ eN hmap
  have hfit : fittingIdeal (R := R) (M := N ⧸ LinearMap.range f) 0 =
      minorIdeal A (Module.finrank R M) := by
    simpa [A] using (fittingIdeal_eq_minorIdeal_of_presentation A 0 eQ)
  exact hfit ▸ minorIdeal_fin_principal (Module.finrank R M) A

/-- The discriminant ideal of a finite free algebra is principal. -/
@[ega "IV 18.2.7" "special case"]
theorem algebraDiscriminantIdeal_isPrincipal_of_free
    (R : Type u) (A : Type v) [CommRing R] [StrongRankCondition R]
    [CommRing A] [Algebra R A]
    [Module.Finite R A] [Module.Projective R A] [Module.Free R A] :
    (algebraDiscriminantIdeal R A).IsPrincipal := by
  classical
  let b := Module.finBasis R A
  let : Module.Free R (Module.Dual R A) := inferInstance
  have hfinrank : Module.finrank R A = Module.finrank R (Module.Dual R A) := by
    rw [Module.finrank_eq_nat_card_basis b,
      Module.finrank_eq_nat_card_basis b.dualBasis]
  rw [algebraDiscriminantIdeal_eq_fittingIdeal]
  exact fittingIdeal_coker_isPrincipal_of_free R A (Module.Dual R A)
    hfinrank (finiteProjectiveTraceForm R A)

/-- A finite projective module becomes free after inverting a single element avoiding a given
prime. -/
theorem exists_away_free_at_prime
    (R : Type u) (A : Type v) [CommRing R] [AddCommGroup A] [Module R A]
    [Module.Finite R A] [Module.Projective R A] (p : PrimeSpectrum R) :
    ∃ f : R, f ∉ p.asIdeal ∧
      Module.Free (Localization.Away f) (LocalizedModule.Away f A) := by
  classical
  let : Module.FinitePresentation R A := Module.finitePresentation_of_projective R A
  let Mₚ := LocalizedModule p.asIdeal.primeCompl A
  let : Module.Finite (Localization.AtPrime p.asIdeal) Mₚ := inferInstance
  let : Module.Flat (Localization.AtPrime p.asIdeal) Mₚ := inferInstance
  let : Module.Free (Localization.AtPrime p.asIdeal) Mₚ :=
    Module.free_of_flat_of_isLocalRing
  obtain ⟨f, hf, hfree, _⟩ :=
    Module.FinitePresentation.exists_free_localizedModule_powers
      p.asIdeal.primeCompl (LocalizedModule.mkLinearMap p.asIdeal.primeCompl A)
      (Localization.AtPrime p.asIdeal)
  exact ⟨f, hf, hfree⟩

attribute [local instance] RingHomInvPair.of_ringEquiv in
/-- Freeness of an away localization transfers to any ring and module realizing the same
localizations. -/
theorem free_of_localized_free
    (R A R' A' : Type*) [CommRing R] [CommRing A] [CommRing R'] [CommRing A']
    (a : R) [Algebra R A] [Algebra R R'] [IsLocalization (.powers a) R']
    [Algebra A A'] [Algebra R A'] [IsScalarTower R A A']
    [IsLocalization (Algebra.algebraMapSubmonoid A (.powers a)) A']
    [Algebra R' A'] [IsScalarTower R R' A']
    (hfree : Module.Free (Localization.Away a) (LocalizedModule.Away a A)) :
    Module.Free R' A' := by
  let R₀ := Localization.Away a
  let e : R₀ ≃+* R' := (IsLocalization.algEquiv (.powers a) R₀ R').toRingEquiv
  let : Algebra R₀ A' := ((algebraMap R' A').comp e.toRingHom).toAlgebra
  let : IsScalarTower R R₀ A' := IsScalarTower.of_algebraMap_eq' (by
    ext r
    show algebraMap R A' r = algebraMap R' A' (e (algebraMap R R₀ r))
    show algebraMap R A' r = algebraMap R' A'
      ((IsLocalization.algEquiv (.powers a) R₀ R') (algebraMap R R₀ r))
    rw [AlgEquiv.commutes]
    exact IsScalarTower.algebraMap_apply R R' A' r)
  let g := (IsScalarTower.toAlgHom R A A').toLinearMap
  let : IsLocalizedModule (.powers a) g := inferInstance
  let e₀ := (IsLocalizedModule.iso (.powers a) g).extendScalarsOfIsLocalization (.powers a) R₀
  let : Module.Free R₀ (LocalizedModule.Away a A) := hfree
  let : Module.Free R₀ A' := Module.Free.of_equiv e₀
  let : RingHomInvPair e.toRingHom e.symm.toRingHom := RingHomInvPair.of_ringEquiv e
  let : RingHomInvPair e.symm.toRingHom e.toRingHom := RingHomInvPair.of_ringEquiv e.symm
  let e₁ : A' ≃ₛₗ[e.toRingHom] A' :=
    { Equiv.refl A' with
      map_add' := fun _ _ => rfl
      map_smul' := fun r x => by
        show algebraMap R' A' (e r) * x = e r • x
        rw [Algebra.smul_def] }
  exact Module.Free.of_equiv (R := R₀) (R' := R')
    (σ := e.toRingHom) (σ' := e.symm.toRingHom) e₁


end Stacks.Discriminant

end
