module

public import StacksFrontier.AlgebraicGeometry.ProjTwistDegreeOneStep.Functorial

/-!
# Degree-one generation of twisted global sections, as a subgroup, and over a finite direct sum

Let `S = ⨁_{d ≥ 0} 𝒮 d` be a graded ring, `X = Proj 𝒮` and `ℱ` an `𝒪_X`-module. The sections of
`ℱ(1 + d)` that are finite sums `∑ⱼ aⱼ · tⱼ` with `aⱼ ∈ 𝒮 1` and `tⱼ ∈ Γ(X, ℱ(d))`, the scalars
acting by the graded action of [Stacks, Tag 03GK], form a subgroup of `Γ(X, ℱ(1 + d))`. This file
introduces that subgroup and proves two closure properties:

* it is carried into the corresponding subgroup for `𝒢` by the map a morphism `ℱ ⟶ 𝒢` induces on
  twisted global sections;
* a finite direct sum of modules inherits it from its summands.

## Main definitions

* `Stacks.AlgebraicGeometry.ProjTwistDegreeOneStep.twistedSectionsAddHom`: the map on twisted
  global sections induced by a morphism of modules, as an additive homomorphism.
* `Stacks.AlgebraicGeometry.ProjTwistDegreeOneStep.degreeOneSections`: the subgroup of
  `Γ(X, ℱ(1 + d))` generated by the products of a degree-one scalar with a section of `ℱ(d)`.

## Main results

* `Stacks.AlgebraicGeometry.ProjTwistDegreeOneStep.eq_sum_map_bicone`: for an additive functor to
  module categories, an element of the image of the summit of a bicone is the sum of the images of
  its components.
* `Stacks.AlgebraicGeometry.ProjTwistDegreeOneStep.map_mem_degreeOneSections`: functoriality of
  the degree-one combinations in the module.
* `Stacks.AlgebraicGeometry.ProjTwistDegreeOneStep.eq_sum_bicone_twistedSections`: the
  decomposition above for the twisted global sections of a finite direct sum of modules.
* `Stacks.AlgebraicGeometry.ProjTwistDegreeOneStep.mem_degreeOneSections_of_isBilimit`: a finite
  direct sum inherits degree-one generation from its summands.

## Implementation notes

Degree-one generation is stated as membership in an `AddSubgroup` rather than as the existence of
a representation `s = ∑_{j < r} aⱼ · tⱼ` indexed by a `Fin r`.

The induced map on sections is bundled as an `AddMonoidHom` whose type is written with
`twistedSectionsComponent`, rather than with the defeq spelling
`((twistFunctor 𝒮 d).obj ℱ).val.obj (op ⊤)`.

The target degree is written `(1 : ℤ) + d` throughout.

## References

* [Stacks Project, Tag 03GK](https://stacks.math.columbia.edu/tag/03GK)
* [Stacks Project, Tag 01YS](https://stacks.math.columbia.edu/tag/01YS)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open AlgebraicGeometry AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjTwistFunctor (projRingSheaf twistFunctor)
open Stacks.AlgebraicGeometry.ProjTwistedSections

namespace Stacks.AlgebraicGeometry.ProjTwistDegreeOneStep

universe v₁ v₂ u₁ u₂ u w

/-! ### Additivity over a finite direct sum, for an abstract functor -/

/-- **An additive functor to modules turns a bicone into a decomposition of sections.** If `b` is
a bicone over `f : J → C` exhibiting the direct sum of the `f j` and `Q` is an additive functor to
a category of modules, then every element of `Q b.pt` is the sum of the images of its components
`Q(πⱼ) s`. -/
theorem eq_sum_map_bicone {C : Type u₁} [Category.{v₁} C] [Preadditive C] {A : Type u₂} [Ring A]
    (Q : C ⥤ ModuleCat.{v₂} A) [Q.Additive] {J : Type} [Fintype J] {f : J → C} {b : Bicone f}
    (hb : b.IsBilimit) (s : Q.obj b.pt) :
    s = ∑ j, (Q.map (b.ι j)).hom ((Q.map (b.π j)).hom s) := by
  have key : 𝟙 (Q.obj b.pt) = ∑ j, Q.map (b.π j) ≫ Q.map (b.ι j) := by
    simp only [← Q.map_comp, ← Q.map_sum, IsBilimit.total hb, Q.map_id]
  simpa [ModuleCat.hom_sum] using congrArg (fun m => m.hom s) key

/-! ### The degree-one combinations in a twisted section group -/

section Proj

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf
attribute [local instance_reducible] ProjectiveSpectrum.top

variable {S : Type u} {σ : Type w} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

/-- Evaluating a sheaf of `𝒪_{Proj 𝒮}`-modules on the whole space is an additive functor. -/
instance additive_evaluation_top :
    (_root_.SheafOfModules.evaluation.{u} (projRingSheaf 𝒮)
      (op (⊤ : Opens (ProjectiveSpectrum.top 𝒮)))).Additive := by
  unfold _root_.SheafOfModules.evaluation
  infer_instance

/-- **The map `Γ(X, ℱ(d)) → Γ(X, 𝒢(d))` induced by `φ : ℱ ⟶ 𝒢`**, as an additive homomorphism
whose type is written with `twistedSectionsComponent`. -/
def twistedSectionsAddHom {F G : SheafOfModules.{u} (projRingSheaf 𝒮)} (φ : F ⟶ G) (d : ℤ) :
    twistedSectionsComponent 𝒮 F d →+ twistedSectionsComponent 𝒮 G d :=
  (((twistFunctor 𝒮 d).map φ).val.app (op ⊤)).hom.toAddMonoidHom

/-- `twistedSectionsAddHom 𝒮 φ d` sends a section `s` of `ℱ(d)` over `Proj 𝒮` to its image under
the map of global sections induced by the twist of `φ`. -/
theorem twistedSectionsAddHom_apply {F G : SheafOfModules.{u} (projRingSheaf 𝒮)} (φ : F ⟶ G)
    (d : ℤ) (s : twistedSectionsComponent 𝒮 F d) :
    twistedSectionsAddHom 𝒮 φ d s = (((twistFunctor 𝒮 d).map φ).val.app (op ⊤)).hom s := rfl

/-- **The degree-one combinations inside `Γ(Proj 𝒮, ℱ(1 + d))`**: the subgroup generated by the
sections `a · t` with `a ∈ 𝒮 1` homogeneous of degree one and `t ∈ Γ(Proj 𝒮, ℱ(d))`, the product
being the graded action of [Stacks, Tag 03GK]. -/
def degreeOneSections (F : SheafOfModules.{u} (projRingSheaf 𝒮)) (d : ℤ) :
    AddSubgroup (twistedSectionsComponent 𝒮 F ((1 : ℤ) + d)) :=
  AddSubgroup.closure
    {x | ∃ (a : 𝒮 1) (t : twistedSectionsComponent 𝒮 F d),
      x = homogeneousScalarTwistedSections 𝒮 F 1 d a t}

/-- A single product of a degree-one scalar with a section of `ℱ(d)` is a degree-one
combination. -/
theorem homogeneousScalarTwistedSections_mem_degreeOneSections
    (F : SheafOfModules.{u} (projRingSheaf 𝒮)) (d : ℤ) (a : 𝒮 1)
    (t : twistedSectionsComponent 𝒮 F d) :
    homogeneousScalarTwistedSections 𝒮 F 1 d a t ∈ degreeOneSections 𝒮 F d :=
  AddSubgroup.subset_closure ⟨a, t, rfl⟩

/-- A finite sum `∑ⱼ aⱼ · tⱼ` of products of degree-one scalars with sections of `ℱ(d)` is a
degree-one combination. -/
theorem mem_degreeOneSections_of_sum (F : SheafOfModules.{u} (projRingSheaf 𝒮)) (d : ℤ) {r : ℕ}
    (a : Fin r → 𝒮 1) (t : Fin r → twistedSectionsComponent 𝒮 F d) :
    ∑ j, homogeneousScalarTwistedSections 𝒮 F 1 d (a j) (t j) ∈ degreeOneSections 𝒮 F d :=
  sum_mem fun j _ =>
    homogeneousScalarTwistedSections_mem_degreeOneSections 𝒮 F d (a j) (t j)

/-- **Degree-one generation is functorial in the module.** The map
`Γ(X, ℱ(1 + d)) → Γ(X, 𝒢(1 + d))` induced by `φ : ℱ ⟶ 𝒢` carries the degree-one combinations of
`ℱ` to those of `𝒢`. -/
theorem map_mem_degreeOneSections {F G : SheafOfModules.{u} (projRingSheaf 𝒮)} (φ : F ⟶ G)
    (d : ℤ) {s : twistedSectionsComponent 𝒮 F ((1 : ℤ) + d)}
    (hs : s ∈ degreeOneSections 𝒮 F d) :
    twistedSectionsAddHom 𝒮 φ ((1 : ℤ) + d) s ∈ degreeOneSections 𝒮 G d := by
  refine (AddSubgroup.closure_le
    (AddSubgroup.comap (twistedSectionsAddHom 𝒮 φ ((1 : ℤ) + d)) (degreeOneSections 𝒮 G d))).mpr
    ?_ hs
  rintro x ⟨a, t, rfl⟩
  exact AddSubgroup.subset_closure
    ⟨a, twistedSectionsAddHom 𝒮 φ d t, globalSections_map_homogeneousScalar 𝒮 φ 1 d a t⟩

/-- A twisted global section of a finite direct sum is the sum of the images of its components. -/
theorem eq_sum_bicone_twistedSections {r : ℕ}
    {f : Fin r → SheafOfModules.{u} (projRingSheaf 𝒮)} {b : Bicone f} (hb : b.IsBilimit) (d : ℤ)
    (s : twistedSectionsComponent 𝒮 b.pt d) :
    s = ∑ j, twistedSectionsAddHom 𝒮 (b.ι j) d (twistedSectionsAddHom 𝒮 (b.π j) d s) :=
  eq_sum_map_bicone (twistFunctor 𝒮 d ⋙ _root_.SheafOfModules.evaluation.{u} (projRingSheaf 𝒮)
    (op (⊤ : Opens (ProjectiveSpectrum.top 𝒮)))) hb s

/-- **A finite direct sum inherits degree-one generation from its summands.** If every section of
`ℱⱼ(1 + d)` is a degree-one combination of sections of `ℱⱼ(d)`, the same holds for the direct
sum. -/
theorem mem_degreeOneSections_of_isBilimit {r : ℕ}
    {f : Fin r → SheafOfModules.{u} (projRingSheaf 𝒮)} {b : Bicone f} (hb : b.IsBilimit) (d : ℤ)
    (hf : ∀ (j : Fin r) (z : twistedSectionsComponent 𝒮 (f j) ((1 : ℤ) + d)),
      z ∈ degreeOneSections 𝒮 (f j) d)
    (s : twistedSectionsComponent 𝒮 b.pt ((1 : ℤ) + d)) :
    s ∈ degreeOneSections 𝒮 b.pt d := by
  rw [eq_sum_bicone_twistedSections 𝒮 hb ((1 : ℤ) + d) s]
  exact sum_mem fun j _ => map_mem_degreeOneSections 𝒮 (b.ι j) d (hf j _)

end Proj

end Stacks.AlgebraicGeometry.ProjTwistDegreeOneStep

end
