variable {S : Type u} {σ : Type w} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

/-- **The twisted global sections of a twisting sheaf are generated in degree one, degreewise.**
On a `Proj` of a graded ring generated in degree one on which every nonnegative twist has its
global sections generated by the homogeneous elements, every global section of `𝒪(e)(1 + d)` is a
finite sum `∑ aⱼ · tⱼ` with `aⱼ ∈ 𝒮 1` and `tⱼ` a global section of `𝒪(e)(d)`, provided
`e + d ≥ 0` and that the degree `e + (1 + d)` is one where the generation hypothesis holds. -/
theorem exists_sum_homogeneousScalar_twistingSheaf_of_le (b₀ : ℤ)
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤)
    (hsurj : ∀ b : ℤ, b₀ ≤ b →
      Function.Surjective (degreeZeroToGlobalSections 𝒮 (twistGrading (S := S) 𝒮 b)))
    (e d : ℤ) (hed : 0 ≤ e + d) (hb : b₀ ≤ e + ((1 : ℤ) + d))
    (s : twistedSectionsComponent 𝒮 (twistingSheaf 𝒮 e) ((1 : ℤ) + d)) :
    ∃ (r : ℕ) (a : Fin r → 𝒮 1)
      (t : Fin r → twistedSectionsComponent 𝒮 (twistingSheaf 𝒮 e) d),
      s = ∑ j, homogeneousScalarTwistedSections 𝒮 (twistingSheaf 𝒮 e) 1 d (a j) (t j) := by
  classical
  have hek : ((1 : ℕ) : ℤ) + (e + d) = e + ((1 : ℤ) + d) := by push_cast; ring
  have hbij' := bijective_globalSections_twistMultiplicationMap 𝒮 hgen e ((1 : ℤ) + d)
  have hbij := bijective_globalSections_twistMultiplicationMap 𝒮 hgen e d
  obtain ⟨c, hc⟩ := hsurj (e + ((1 : ℤ) + d)) hb
    (((twistMultiplicationMap 𝒮 e ((1 : ℤ) + d)).val.app (op ⊤)).hom s)
  obtain ⟨cv, hcv⟩ := c
  have hcmem : cv ∈ 𝒮 ((e + d).toNat + 1) := by
    have h2 : cv ∈ integerGrading (S := S) 𝒮 (0 + (e + ((1 : ℤ) + d))) := hcv
    rw [show (0 : ℤ) + (e + ((1 : ℤ) + d)) = (((e + d).toNat + 1 : ℕ) : ℤ) by
      push_cast; omega, integerGrading_natCast] at h2
    exact h2
  obtain ⟨r, a, b, hsum⟩ := exists_sum_degreeOne_mul 𝒮 hgen ((e + d).toNat) hcmem
  have hbmem : ∀ j, (b j : S) ∈ twistGrading (S := S) 𝒮 (e + d) 0 := by
    intro j
    show (b j : S) ∈ integerGrading (S := S) 𝒮 (0 + (e + d))
    rw [show (0 : ℤ) + (e + d) = (((e + d).toNat : ℕ) : ℤ) by omega, integerGrading_natCast]
    exact (b j).2
  choose t ht using fun j : Fin r => hbij.surjective
    (degreeZeroToGlobalSections 𝒮 (twistGrading (S := S) 𝒮 (e + d)) ⟨(b j : S), hbmem j⟩)
  have hnat : ∀ (j : Fin r) (z : twistedSectionsComponent 𝒮 (twistingSheaf 𝒮 e) d),
      ((twistMultiplicationMap 𝒮 e ((1 : ℤ) + d)).val.app (op ⊤)).hom
          (homogeneousScalarTwistedSections 𝒮 (twistingSheaf 𝒮 e) 1 d (a j) z) =
        ((twistScalarSheafMap 𝒮 1 (e + d) (e + ((1 : ℤ) + d)) hek (a j)).val.app
          (op ⊤)).hom (((twistMultiplicationMap 𝒮 e d).val.app (op ⊤)).hom z) := by
    intro j z
    exact congrArg
      (fun F : twistSheafOfModules 𝒮 (twistingSheaf 𝒮 e) d ⟶
          twistingSheaf 𝒮 (e + ((1 : ℤ) + d)) => (F.val.app (op ⊤)).hom z)
      (mul_comp_twistMultiplicationMap 𝒮 e 1 d ((1 : ℤ) + d) rfl hek (a j))
  have hmul : ∀ j : Fin r,
      ((twistScalarSheafMap 𝒮 1 (e + d) (e + ((1 : ℤ) + d)) hek (a j)).val.app (op ⊤)).hom
          (degreeZeroToGlobalSections 𝒮 (twistGrading (S := S) 𝒮 (e + d))
            ⟨(b j : S), hbmem j⟩) =
        degreeZeroToGlobalSections 𝒮 (twistGrading (S := S) 𝒮 (e + ((1 : ℤ) + d)))
          ⟨(a j : S) * (b j : S), by
            exact homogeneousMul_mem_twistGrading 𝒮 1 (e + d) (e + ((1 : ℤ) + d)) hek (a j) 0
              (b j : S) (hbmem j)⟩ := by
    intro j
    exact ProjStalkGlobalSections.degreeZeroToGlobalSections_naturality 𝒮
      (twistGrading (S := S) 𝒮 (e + d)) (twistGrading (S := S) 𝒮 (e + ((1 : ℤ) + d)))
      (LinearMap.mul S S (a j : S))
      (homogeneousMul_mem_twistGrading 𝒮 1 (e + d) (e + ((1 : ℤ) + d)) hek (a j))
      ⟨(b j : S), hbmem j⟩
  refine ⟨r, a, t, hbij'.injective (Eq.trans hc.symm ?_)⟩
  refine Eq.trans ?_ (map_sum
    ((twistMultiplicationMap 𝒮 e ((1 : ℤ) + d)).val.app (op ⊤)).hom
    (fun j : Fin r =>
      homogeneousScalarTwistedSections 𝒮 (twistingSheaf 𝒮 e) 1 d (a j) (t j))
    Finset.univ).symm
  refine Eq.trans ?_ (Finset.sum_congr rfl fun j _ =>
    ((hnat j (t j)).trans ((congrArg
      (fun z => ((twistScalarSheafMap 𝒮 1 (e + d) (e + ((1 : ℤ) + d)) hek
        (a j)).val.app (op ⊤)).hom z) (ht j)).trans (hmul j))).symm)
  refine Eq.trans (congrArg
    (degreeZeroToGlobalSections 𝒮 (twistGrading (S := S) 𝒮 (e + ((1 : ℤ) + d)))) ?_)
    (map_sum (degreeZeroToGlobalSections 𝒮
      (twistGrading (S := S) 𝒮 (e + ((1 : ℤ) + d))))
      (fun j : Fin r => (⟨(a j : S) * (b j : S),
        homogeneousMul_mem_twistGrading 𝒮 1 (e + d) (e + ((1 : ℤ) + d)) hek (a j) 0
          (b j : S) (hbmem j)⟩ :
        twistGrading (S := S) 𝒮 (e + ((1 : ℤ) + d)) 0)) Finset.univ)
  exact Subtype.ext (hsum.trans (by simp))

end ThresholdForm

variable {S : Type u} {σ : Type w} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]
  [EnoughInjectives (SheafOfModules.{u} (projRingSheaf 𝒮))]
  [HasDerivedCategory (SheafOfModules.{u} (projRingSheaf 𝒮))]
  [HasDerivedCategory AddCommGrpCat.{u}]

omit [HasDerivedCategory (SheafOfModules.{u} (projRingSheaf 𝒮))]
  [HasDerivedCategory AddCommGrpCat.{u}] in
/-- **Sections of a surjection are surjective where the first cohomology of the kernel
vanishes.** For an epimorphism `φ : 𝒢 ⟶ ℱ` of `𝒪_{Proj 𝒮}`-modules whose kernel has
`H¹(Proj 𝒮, (ker φ)(d)) = 0`, the induced map `Γ(𝒢(d)) → Γ(ℱ(d))` is surjective: the twist of
the kernel sequence is short exact because `𝒮` is generated in degree one, and the long exact
sequence of sections then has nothing to obstruct the lift. -/
theorem surjective_twistedSectionsAddHom_of_isZero_firstCohomology
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤)
    {F G : SheafOfModules.{u} (projRingSheaf 𝒮)} (φ : G ⟶ F) [Epi φ] (d : ℤ)
    (hz : IsZero (Hgroup (projRingSheaf 𝒮) ⊤ 1 (twistSheafOfModules 𝒮 (kernel φ) d))) :
    Function.Surjective (twistedSectionsAddHom 𝒮 φ d) := by
  have hse : (ShortComplex.mk (kernel.ι φ) φ (kernel.condition φ)).ShortExact :=
    ShortComplex.shortExact_mk_kernel_ι φ
  have hgen' : Algebra.adjoin (𝒮 0) (Set.range fun f : 𝒮 1 => (f : S)) = ⊤ := by
    rw [Stacks.AlgebraicGeometry.ProjTwistMono.range_coe_degree_one 𝒮]
    exact hgen
  have hseT :=
    Stacks.AlgebraicGeometry.TwistFlatness.shortExact_map_twistFunctor_of_adjoin_degree_one
      𝒮 hgen' d hse
  have hzero : IsZero (((_root_.SheafOfModules.evaluation.{u} (projRingSheaf 𝒮)
        (op (⊤ : Opens (ProjectiveSpectrum.top 𝒮)))).rightDerived 1).obj
        ((ShortComplex.mk (kernel.ι φ) φ (kernel.condition φ)).map (twistFunctor 𝒮 d)).X₁) :=
    (Stacks.Cohomology.CechAcyclic.isZero_rightDerived_evaluation_iff_isZero_Hgroup
      (projRingSheaf 𝒮) ⊤ 1 (twistSheafOfModules 𝒮 (kernel φ) d)).mpr hz
  have hepi := Stacks.Cohomology.epi_map_of_isZero_rightDerived_one
    (_root_.SheafOfModules.evaluation.{u} (projRingSheaf 𝒮)
      (op (⊤ : Opens (ProjectiveSpectrum.top 𝒮)))) hseT hzero
  exact (ModuleCat.epi_iff_surjective _).1 hepi

omit [EnoughInjectives (SheafOfModules.{u} (projRingSheaf 𝒮))]
  [HasDerivedCategory (SheafOfModules.{u} (projRingSheaf 𝒮))]
  [HasDerivedCategory AddCommGrpCat.{u}] in
/-- **The twisted global sections of a twisting sheaf are generated in degree one**, in the
subgroup form: for `e + d ≥ 0` and `e + (1 + d)` a degree where the global sections of the twist
come from the homogeneous elements, every global section of `𝒪(e)(1 + d)` lies in the subgroup
generated by the degree-one combinations of global sections of `𝒪(e)(d)`. -/
theorem mem_degreeOneSections_twistingSheaf (b₀ : ℤ)
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤)
    (hsurj : ∀ b : ℤ, b₀ ≤ b →
      Function.Surjective (degreeZeroToGlobalSections 𝒮 (twistGrading (S := S) 𝒮 b)))
    (e d : ℤ) (hed : 0 ≤ e + d) (hb : b₀ ≤ e + ((1 : ℤ) + d))
    (s : twistedSectionsComponent 𝒮 (twistingSheaf 𝒮 e) ((1 : ℤ) + d)) :
    s ∈ degreeOneSections 𝒮 (twistingSheaf 𝒮 e) d := by
  obtain ⟨r, a, t, hs⟩ :=
    exists_sum_homogeneousScalar_twistingSheaf_of_le 𝒮 b₀ hgen hsurj e d hed hb s
  rw [hs]
  exact mem_degreeOneSections_of_sum 𝒮 (twistingSheaf 𝒮 e) d a t

omit [HasDerivedCategory (SheafOfModules.{u} (projRingSheaf 𝒮))]
  [HasDerivedCategory AddCommGrpCat.{u}] in
/-- **The twisted global sections of a coherent module are generated in degree one in all large
degrees.** There is a `B` such that for every `d ≥ B` each global section of `ℱ(1 + d)` is a
combination of global sections of `ℱ(d)` with degree-one coefficients.

This is the dévissage of [Stacks, Tag 01YS] clause (5): a presentation `φ : ⨁_j 𝒪(dⱼ) ⟶ ℱ` by
twists, the eventual vanishing of `H¹` of the twists of the coherent kernel, the degree-one
generation of each `𝒪(dⱼ)` above `-dⱼ`, and additivity over the finite direct sum. -/
theorem exists_forall_mem_degreeOneSections_of_hasTwistQuotients (b₀ : ℤ)
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤)
    (hsurj : ∀ b : ℤ, b₀ ≤ b →
      Function.Surjective (degreeZeroToGlobalSections 𝒮 (twistGrading (S := S) 𝒮 b)))
    (htw : ∀ n : ℤ, _root_.SheafOfModules.IsCoherent (twistingSheaf 𝒮 n))
    (hquot : HasTwistQuotients 𝒮)
    (hvan : ∀ G : SheafOfModules.{u} (projRingSheaf 𝒮), _root_.SheafOfModules.IsCoherent G →
      ∃ d₀ : ℤ, ∀ d : ℤ, d₀ ≤ d →
        IsZero (Hgroup (projRingSheaf 𝒮) ⊤ 1 (twistSheafOfModules 𝒮 G d)))
    (F : SheafOfModules.{u} (projRingSheaf 𝒮)) (hF : _root_.SheafOfModules.IsCoherent F) :
    ∃ B : ℤ, ∀ d : ℤ, B ≤ d →
      ∀ s : twistedSectionsComponent 𝒮 F ((1 : ℤ) + d), s ∈ degreeOneSections 𝒮 F d := by
  classical
  obtain ⟨r, dj, b, hb, φ, hφ⟩ := hquot F hF
  have : Epi φ := hφ
  have hpt : _root_.SheafOfModules.IsCoherent b.pt :=
    isCoherent_of_isBilimit 𝒮 hb fun j => htw (dj j)
  have hFc : _root_.SheafOfModules.IsCoherent F := hF
  have hker : _root_.SheafOfModules.IsCoherent (kernel φ) :=
    AlgebraicGeometry.CoherentAbelian.isCoherent_kernel φ
  obtain ⟨d₀, hd₀⟩ := hvan (kernel φ) hker
  refine ⟨max d₀ (max b₀ 0 + ∑ j : Fin r, max (-(dj j)) 0), fun d hd s => ?_⟩
  have hd₀d : d₀ ≤ (1 : ℤ) + d := by
    have := le_trans (le_max_left d₀ (max b₀ 0 + ∑ j : Fin r, max (-(dj j)) 0)) hd
    omega
  have hkey : ∀ j : Fin r, 0 ≤ dj j + d ∧ b₀ ≤ dj j + ((1 : ℤ) + d) := by
    intro j
    have h1 : max (-(dj j)) 0 ≤ ∑ k : Fin r, max (-(dj k)) 0 :=
      Finset.single_le_sum (f := fun k : Fin r => max (-(dj k)) 0)
        (fun k _ => le_max_right (-(dj k)) 0) (Finset.mem_univ j)
    have h2 : -(dj j) ≤ max (-(dj j)) 0 := le_max_left _ _
    have h3 : (max b₀ 0 + ∑ k : Fin r, max (-(dj k)) 0) ≤ d :=
      le_trans (le_max_right d₀ (max b₀ 0 + ∑ k : Fin r, max (-(dj k)) 0)) hd
    have h4 : b₀ ≤ max b₀ 0 := le_max_left _ _
    have h5 : (0 : ℤ) ≤ max b₀ 0 := le_max_right _ _
    omega
  obtain ⟨s', rfl⟩ := surjective_twistedSectionsAddHom_of_isZero_firstCohomology 𝒮 hgen φ
    ((1 : ℤ) + d) (hd₀ ((1 : ℤ) + d) hd₀d) s
  exact map_mem_degreeOneSections 𝒮 φ d
    (mem_degreeOneSections_of_isBilimit 𝒮 hb d
      (fun j z => mem_degreeOneSections_twistingSheaf 𝒮 b₀ hgen hsurj (dj j) d
        (hkey j).1 (hkey j).2 z) s')

end Stacks.AlgebraicGeometry.ProjTwistDegreeOneStep

end
