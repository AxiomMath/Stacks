module

public import StacksFrontier.AlgebraicGeometry.ProjRepresentsF1.TwistPowers
public import StacksFrontier.AlgebraicGeometry.ProjTwistDegreeOneStep.Graded
public import StacksFrontier.AlgebraicGeometry.ProjTwistDegreeOneStep.Naturality
public import StacksFrontier.AlgebraicGeometry.ProjTwistFunctor.Basic
public import StacksFrontier.AlgebraicGeometry.RelativeProjTwists.DegreeSection

/-!
# The twisted global sections of a twisting sheaf are generated in degree one

Let `S = ⨁_{d ≥ 0} 𝒮 d` be a graded ring generated in degree one over `𝒮 0`, `X = Proj 𝒮`, and
suppose that for every `b ≥ 0` the canonical map of [Stacks, Tag 01MP] from the degree-zero part
of the shift `S(b)` to `Γ(X, 𝒪(b))` is surjective. Then for `e + d ≥ 0` every global section
of `𝒪(e)(1 + d)` is a finite sum `∑ⱼ aⱼ · tⱼ` with `aⱼ ∈ 𝒮 1` and `tⱼ` a global section of
`𝒪(e)(d)`, the scalars acting by the graded action of [Stacks, Tag 03GK].

## Main results

* `bijective_globalSections_twistMultiplicationMap`: the multiplication of twists is bijective on
  global sections.
* `exists_sum_homogeneousScalar_twistingSheaf`: the generation statement above.

## References

* [Stacks Project, Tag 01MP](https://stacks.math.columbia.edu/tag/01MP)
* [Stacks Project, Tag 01MO](https://stacks.math.columbia.edu/tag/01MO)
* [Stacks Project, Tag 03GK](https://stacks.math.columbia.edu/tag/03GK)
* [Stacks Project, Tag 01YS](https://stacks.math.columbia.edu/tag/01YS)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite
open AlgebraicGeometry AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjSheafFunctoriality
open Stacks.AlgebraicGeometry.ProjInvertibleLocus
open Stacks.AlgebraicGeometry.ProjStalkGlobalSections (degreeZeroToGlobalSections)
open Stacks.AlgebraicGeometry.ProjTwistFunctor (projRingSheaf)
open Stacks.AlgebraicGeometry.ProjTwistedSections
open scoped TensorProduct

namespace Stacks.AlgebraicGeometry.ProjTwistDegreeOneStep

universe u w

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf
attribute [local instance_reducible] ProjectiveSpectrum.top
attribute [local instance] ProjectiveSpectrum.isPrime

variable {S : Type u} {σ : Type w} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

/-- On a `Proj` of a graded ring generated in degree one the multiplication of twists is
bijective on global sections. -/
theorem bijective_globalSections_twistMultiplicationMap
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤) (e d : ℤ) :
    Function.Bijective
      (fun s => ((twistMultiplicationMap 𝒮 e d).val.app (op ⊤)).hom s) := by
  have := ProjRepresentsF1.isIso_twistMultiplicationMap_of_adjoin 𝒮 hgen e d
  have hleft : ∀ w, ((inv (twistMultiplicationMap 𝒮 e d)).val.app (op ⊤)).hom
      (((twistMultiplicationMap 𝒮 e d).val.app (op ⊤)).hom w) = w := fun w =>
    congrArg (fun F => (F.val.app (op ⊤)).hom w)
      (IsIso.hom_inv_id (twistMultiplicationMap 𝒮 e d))
  have hright : ∀ z, ((twistMultiplicationMap 𝒮 e d).val.app (op ⊤)).hom
      (((inv (twistMultiplicationMap 𝒮 e d)).val.app (op ⊤)).hom z) = z := fun z =>
    congrArg (fun F => (F.val.app (op ⊤)).hom z)
      (IsIso.inv_hom_id (twistMultiplicationMap 𝒮 e d))
  exact Function.bijective_iff_has_inverse.mpr ⟨_, hleft, hright⟩

/-- Surjectivity of the canonical map of [Stacks, Tag 01MP] in all nonnegative integer degrees
is surjectivity of `AlgebraicGeometry.ProjectiveSpectrum.Proj.degreeSection` in every natural
degree, the nonnegative integers being the natural ones. -/
theorem surjective_degreeZeroToGlobalSections_of_degreeSection
    (h : ∀ k : ℕ, Function.Surjective (degreeSection 𝒮 k))
    (b : ℤ) (hb : 0 ≤ b) :
    Function.Surjective (degreeZeroToGlobalSections 𝒮 (twistGrading (S := S) 𝒮 b)) := by
  obtain ⟨k, rfl⟩ : ∃ k : ℕ, b = (k : ℤ) := ⟨b.toNat, (Int.toNat_of_nonneg hb).symm⟩
  intro s
  obtain ⟨a, ha⟩ := h k s
  exact ⟨⟨(a : S), ProjTwistSections.mem_twistGrading_zero 𝒮 a⟩, ha⟩

/-- Membership in the degree-zero part of the shift `S(m)` is membership in `𝒮 n` when `m = n`. -/
private theorem mem_twistGrading_zero_iff (𝒯 : ℕ → σ) {m : ℤ} {n : ℕ} (h : m = n) (x : S) :
    x ∈ twistGrading (S := S) 𝒯 m 0 ↔ x ∈ 𝒯 n := by
  subst h
  change x ∈ integerGrading (S := S) 𝒯 (0 + (n : ℤ)) ↔ _
  rw [zero_add, integerGrading_natCast]
  exact Iff.rfl

/-- **The twisted global sections of a twisting sheaf are generated in degree one, degreewise.**
On a `Proj` of a graded ring generated in degree one on which every nonnegative twist has its
global sections generated by the homogeneous elements, every global section of `𝒪(e)(1 + d)` is a
finite sum `∑ aⱼ · tⱼ` with `aⱼ ∈ 𝒮 1` and `tⱼ` a global section of `𝒪(e)(d)`, provided
`e + d ≥ 0`. -/
theorem exists_sum_homogeneousScalar_twistingSheaf
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤)
    (hsurj : ∀ b : ℤ, 0 ≤ b →
      Function.Surjective (degreeZeroToGlobalSections 𝒮 (twistGrading (S := S) 𝒮 b)))
    (e d : ℤ) (hed : 0 ≤ e + d)
    (s : twistedSectionsComponent 𝒮 (twistingSheaf 𝒮 e) ((1 : ℤ) + d)) :
    ∃ (r : ℕ) (a : Fin r → 𝒮 1)
      (t : Fin r → twistedSectionsComponent 𝒮 (twistingSheaf 𝒮 e) d),
      s = ∑ j, homogeneousScalarTwistedSections 𝒮 (twistingSheaf 𝒮 e) 1 d (a j) (t j) := by
  classical
  have hek : ((1 : ℕ) : ℤ) + (e + d) = e + ((1 : ℤ) + d) := by push_cast; ring
  have hbij' := bijective_globalSections_twistMultiplicationMap 𝒮 hgen e ((1 : ℤ) + d)
  have hbij := bijective_globalSections_twistMultiplicationMap 𝒮 hgen e d
  obtain ⟨c, hc⟩ := hsurj (e + ((1 : ℤ) + d)) (by omega)
    (((twistMultiplicationMap 𝒮 e ((1 : ℤ) + d)).val.app (op ⊤)).hom s)
  obtain ⟨cv, hcv⟩ := c
  have hcmem : cv ∈ 𝒮 ((e + d).toNat + 1) :=
    (mem_twistGrading_zero_iff 𝒮 (by push_cast; omega) cv).1 hcv
  obtain ⟨r, a, b, hsum⟩ := exists_sum_degreeOne_mul 𝒮 hgen ((e + d).toNat) hcmem
  have hbmem : ∀ j, (b j : S) ∈ twistGrading (S := S) 𝒮 (e + d) 0 := fun j =>
    (mem_twistGrading_zero_iff 𝒮 (by omega) _).2 (b j).2
  choose t ht using fun j : Fin r => hbij.surjective
    (degreeZeroToGlobalSections 𝒮 (twistGrading (S := S) 𝒮 (e + d)) ⟨(b j : S), hbmem j⟩)
  have hnat : ∀ (j : Fin r) (z : twistedSectionsComponent 𝒮 (twistingSheaf 𝒮 e) d),
      ((twistMultiplicationMap 𝒮 e ((1 : ℤ) + d)).val.app (op ⊤)).hom
          (homogeneousScalarTwistedSections 𝒮 (twistingSheaf 𝒮 e) 1 d (a j) z) =
        ((twistScalarSheafMap 𝒮 1 (e + d) (e + ((1 : ℤ) + d)) hek (a j)).val.app
          (op ⊤)).hom (((twistMultiplicationMap 𝒮 e d).val.app (op ⊤)).hom z) := fun j z =>
    congrArg
      (fun F : twistSheafOfModules 𝒮 (twistingSheaf 𝒮 e) d ⟶
          twistingSheaf 𝒮 (e + ((1 : ℤ) + d)) => (F.val.app (op ⊤)).hom z)
      (mul_comp_twistMultiplicationMap 𝒮 e 1 d ((1 : ℤ) + d) rfl hek (a j))
  have hmul : ∀ j : Fin r,
      ((twistScalarSheafMap 𝒮 1 (e + d) (e + ((1 : ℤ) + d)) hek (a j)).val.app (op ⊤)).hom
          (degreeZeroToGlobalSections 𝒮 (twistGrading (S := S) 𝒮 (e + d))
            ⟨(b j : S), hbmem j⟩) =
        degreeZeroToGlobalSections 𝒮 (twistGrading (S := S) 𝒮 (e + ((1 : ℤ) + d)))
          ⟨(a j : S) * (b j : S),
            homogeneousMul_mem_twistGrading 𝒮 1 (e + d) (e + ((1 : ℤ) + d)) hek (a j) 0
              (b j : S) (hbmem j)⟩ := fun j =>
    ProjStalkGlobalSections.degreeZeroToGlobalSections_naturality 𝒮
      (twistGrading (S := S) 𝒮 (e + d)) (twistGrading (S := S) 𝒮 (e + ((1 : ℤ) + d)))
      (LinearMap.mul S S (a j : S))
      (homogeneousMul_mem_twistGrading 𝒮 1 (e + d) (e + ((1 : ℤ) + d)) hek (a j))
      ⟨(b j : S), hbmem j⟩
  refine ⟨r, a, t, hbij'.injective (Eq.trans hc.symm ?_)⟩
  refine Eq.trans ?_ (map_sum
    ((twistMultiplicationMap 𝒮 e ((1 : ℤ) + d)).val.app (op ⊤)).hom
    (fun j : Fin r =>
      homogeneousScalarTwistedSections 𝒮 (twistingSheaf 𝒮 e) 1 d (a j) (t j))
    Finset.univ).symm
  refine Eq.trans ?_ (Finset.sum_congr rfl fun j _ =>
    ((hnat j (t j)).trans ((congrArg
      (fun z => ((twistScalarSheafMap 𝒮 1 (e + d) (e + ((1 : ℤ) + d)) hek
        (a j)).val.app (op ⊤)).hom z) (ht j)).trans (hmul j))).symm)
  refine Eq.trans (congrArg
    (degreeZeroToGlobalSections 𝒮 (twistGrading (S := S) 𝒮 (e + ((1 : ℤ) + d)))) ?_)
    (map_sum (degreeZeroToGlobalSections 𝒮
      (twistGrading (S := S) 𝒮 (e + ((1 : ℤ) + d))))
      (fun j : Fin r => (⟨(a j : S) * (b j : S),
        homogeneousMul_mem_twistGrading 𝒮 1 (e + d) (e + ((1 : ℤ) + d)) hek (a j) 0
          (b j : S) (hbmem j)⟩ :
        twistGrading (S := S) 𝒮 (e + ((1 : ℤ) + d)) 0)) Finset.univ)
  exact Subtype.ext (hsum.trans (by simp))

end Stacks.AlgebraicGeometry.ProjTwistDegreeOneStep

end
