module

public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.Groupoids.IdealSheafComap

/-!
# Ideal sheaves locally generated by a bounded number of sections

A quasi-coherent ideal sheaf `I` on a scheme `X` is *locally generated by at most `r` sections*
when every point of `X` has an affine open neighbourhood `U` on which `I` is generated by at
most `r` sections of `𝒪_X(U)`. Being locally generated by at most one section is being locally
principal. The property is stable under inverse images, and on an affine scheme it follows from
generation of the global sections by at most `r` elements.

## Main definitions

* `AlgebraicGeometry.Scheme.IdealSheafData.IsLocallyGeneratedByAtMost`: the property.

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.ideal_comap_top_eq_span_image`: the inverse image of
  an ideal sheaf generated by a finite set of global sections along a morphism of affine schemes
  is generated by the images of those sections.
* `AlgebraicGeometry.Scheme.IdealSheafData.IsLocallyGeneratedByAtMost.comap`: stability under
  inverse images.
* `AlgebraicGeometry.Scheme.IdealSheafData.isLocallyGeneratedByAtMost_of_isAffine`: the affine
  case.

## Implementation notes

The ideal on an affine open `U` is read on the open subscheme `U`, as the ideal of global
sections of the inverse image of `I` along the inclusion of `U`; this keeps the bound a statement
about global sections of affine schemes, for which the inverse image along a morphism is
`Stacks.IdealSheaf.ideal_comap_top_of_isAffine`.

## References

* [Stacks Project, Tag 0EVI](https://stacks.math.columbia.edu/tag/0EVI)
* [Stacks Project, Tag 01WR](https://stacks.math.columbia.edu/tag/01WR)
-/

@[expose] public section

open CategoryTheory

universe u v

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X Y : Scheme.{u}}

/-- A quasi-coherent ideal sheaf is *locally generated by at most `r` sections* when every point
has an affine open neighbourhood `U` on which the ideal, read on the open subscheme `U`, is
generated by at most `r` global sections. -/
def IsLocallyGeneratedByAtMost (I : X.IdealSheafData) (r : ℕ) : Prop :=
  ∀ x : X, ∃ U : X.affineOpens, x ∈ (U : Set X) ∧
    ∃ s : Finset Γ(U.1.toScheme, ⊤), s.card ≤ r ∧
      (I.comap U.1.ι).ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span s

/-- The inverse image of an ideal sheaf generated by a finite set of global sections along a
morphism of affine schemes is generated by the images of those sections. -/
theorem ideal_comap_top_eq_span_image [IsAffine X] [IsAffine Y] (I : Y.IdealSheafData)
    (f : X ⟶ Y) (s : Set Γ(Y, ⊤)) (h : I.ideal ⟨⊤, isAffineOpen_top Y⟩ = Ideal.span s) :
    (I.comap f).ideal ⟨⊤, isAffineOpen_top X⟩ = Ideal.span ((f.appTop).hom '' s) := by
  rw [Stacks.IdealSheaf.ideal_comap_top_of_isAffine, h, Ideal.map_span]

/-- The inverse image along a morphism of affine schemes of an ideal sheaf generated by the finite
set `s` of global sections is generated by at most `s.card` global sections. -/
private theorem exists_finset_ideal_comap_top [IsAffine X] [IsAffine Y] (I : Y.IdealSheafData)
    (f : X ⟶ Y) (s : Finset Γ(Y, ⊤)) (h : I.ideal ⟨⊤, isAffineOpen_top Y⟩ = Ideal.span s) :
    ∃ t : Finset Γ(X, ⊤), t.card ≤ s.card ∧
      (I.comap f).ideal ⟨⊤, isAffineOpen_top X⟩ = Ideal.span t := by
  classical
  exact ⟨_, Finset.card_image_le, by rw [ideal_comap_top_eq_span_image I f s h, Finset.coe_image]⟩

/-- The zero ideal sheaf is locally generated by no section. -/
theorem isLocallyGeneratedByAtMost_bot (r : ℕ) :
    (⊥ : X.IdealSheafData).IsLocallyGeneratedByAtMost r := by
  intro x
  obtain ⟨U, hU⟩ := Stacks.Divisors.exists_affineOpens_mem x
  refine ⟨U, hU, ∅, by simp, ?_⟩
  rw [Scheme.IdealSheafData.comap_bot, Finset.coe_empty, Ideal.span_empty]
  exact congrFun Scheme.IdealSheafData.ideal_bot _

/-- Local generation by at most `r` sections is weaker for larger `r`. -/
theorem IsLocallyGeneratedByAtMost.mono {I : X.IdealSheafData} {r r' : ℕ}
    (h : I.IsLocallyGeneratedByAtMost r) (hrr' : r ≤ r') : I.IsLocallyGeneratedByAtMost r' :=
  fun x ↦ (h x).imp fun _ ⟨hxU, s, hs, hI⟩ ↦ ⟨hxU, s, hs.trans hrr', hI⟩

/-- Local generation by at most `r` sections is stable under inverse images. -/
theorem IsLocallyGeneratedByAtMost.comap {I : X.IdealSheafData} {r : ℕ}
    (h : I.IsLocallyGeneratedByAtMost r) (f : Y ⟶ X) :
    (I.comap f).IsLocallyGeneratedByAtMost r := by
  intro y
  obtain ⟨U, hxU, s, hs, hI⟩ := h (f y)
  obtain ⟨_, ⟨V, hV, rfl⟩, hyV, hVU⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open
      (show y ∈ f ⁻¹ᵁ U.1 from hxU) (f ⁻¹ᵁ U.1).isOpen
  have hVU' : V ≤ f ⁻¹ᵁ U.1 := hVU
  let g : Scheme.Opens.toScheme V ⟶ U.1.toScheme := f.resLE U.1 V hVU'
  have hcomp : (I.comap f).comap (Scheme.Opens.ι V) = (I.comap U.1.ι).comap g := by
    rw [← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp,
      Scheme.Hom.resLE_comp_ι]
  have : IsAffine (Scheme.Opens.toScheme V) := hV
  have : IsAffine U.1.toScheme := U.2
  obtain ⟨t, ht, hI'⟩ := exists_finset_ideal_comap_top _ g s hI
  exact ⟨⟨V, hV⟩, hyV, t, ht.trans hs, by rw [← hI', hcomp]⟩

/-- On an affine scheme, an ideal sheaf whose global sections are generated
by at most `r` elements is locally generated by at most `r` sections. -/
theorem isLocallyGeneratedByAtMost_of_isAffine [IsAffine X] (I : X.IdealSheafData) (r : ℕ)
    (s : Finset Γ(X, ⊤)) (hs : s.card ≤ r)
    (h : I.ideal ⟨⊤, isAffineOpen_top X⟩ = Ideal.span s) : I.IsLocallyGeneratedByAtMost r := by
  intro x
  have : IsAffine (Scheme.Opens.toScheme (⊤ : X.Opens)) := isAffineOpen_top X
  obtain ⟨t, ht, hI⟩ := exists_finset_ideal_comap_top I (Scheme.Opens.ι (⊤ : X.Opens)) s h
  exact ⟨⟨⊤, isAffineOpen_top X⟩, trivial, t, ht.trans hs, hI⟩

/-- On an open subscheme, the ideal of global sections of the inverse image of an ideal sheaf is
principal as soon as the ideal on the corresponding affine open is. -/
theorem isPrincipal_ideal_comap_ι (J : X.IdealSheafData) (U : X.affineOpens)
    (h : (J.ideal U).IsPrincipal) :
    ((J.comap U.1.ι).ideal ⟨⊤, isAffineOpen_top U.1⟩).IsPrincipal := by
  have hA : Γ(U.1.toScheme, ⊤) = Γ(X, U.1) := by
    show Γ(X, (Scheme.Hom.opensFunctor U.1.ι).obj ⊤) = Γ(X, U.1)
    rw [Scheme.Opens.ι_image_top]
  have key : ∀ {A B : CommRingCat.{u}} (hAB : A = B) {P : Ideal A} {Q : Ideal B},
      HEq P Q → Q.IsPrincipal → P.IsPrincipal := by
    intro A B hAB P Q hPQ hQ
    cases hAB
    cases eq_of_heq hPQ
    exact hQ
  exact key hA (Stacks.Divisors.ideal_comap_top_heq J U) h

/-- A locally principal ideal sheaf is locally generated by at most one section. -/
theorem isLocallyGeneratedByAtMost_one_of_isLocallyPrincipal (J : X.IdealSheafData)
    (h : Stacks.Divisors.IsLocallyPrincipal J) : J.IsLocallyGeneratedByAtMost 1 := by
  intro x
  obtain ⟨U, hxU, hU⟩ := h x
  obtain ⟨a, ha⟩ := isPrincipal_ideal_comap_ι J U hU
  exact ⟨U, hxU, {a}, by simp, by rw [ha, Finset.coe_singleton, Ideal.submodule_span_eq]⟩

/-- An ideal generated by a finite set of at most one element is generated by a single
element. -/
theorem exists_eq_span_singleton_of_card_le_one {R : Type*} [CommRing R] {J : Ideal R}
    (s : Finset R) (hs : s.card ≤ 1) (h : J = Ideal.span s) : ∃ t : R, J = Ideal.span {t} := by
  rcases Finset.card_le_one_iff_subset_singleton.mp hs with ⟨t, ht⟩
  rcases Finset.subset_singleton_iff.mp ht with rfl | rfl
  · exact ⟨0, by rw [h]; simp⟩
  · exact ⟨t, by rw [h, Finset.coe_singleton]⟩

/-- An open cover of the scheme by affine opens on each of which the ideal sheaf is generated by
at most `r` global sections, as chosen by the definition of local generation, indexed by the
points of the scheme lifted to an arbitrary universe. -/
noncomputable def IsLocallyGeneratedByAtMost.openCover {I : X.IdealSheafData} {r : ℕ}
    (h : I.IsLocallyGeneratedByAtMost r) : X.OpenCover.{max u v} :=
  X.openCoverOfIsOpenCover (fun x : ULift.{v} X ↦ (h x.down).choose.1) (by
    refine top_le_iff.mp fun x _ ↦ ?_
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨⟨x⟩, (h x).choose_spec.1⟩)

/-- The members of `AlgebraicGeometry.Scheme.IdealSheafData.IsLocallyGeneratedByAtMost.openCover`
are affine, and the ideal sheaf pulls back to each of them with ideal of global sections generated
by at most `r` elements. -/
theorem IsLocallyGeneratedByAtMost.openCover_spec {I : X.IdealSheafData} {r : ℕ}
    (h : I.IsLocallyGeneratedByAtMost r) (i : (h.openCover.{u, v}).I₀) :
    ∃ _ : IsAffine (h.openCover.{u, v}.X i), ∃ s : Finset Γ(h.openCover.{u, v}.X i, ⊤),
      s.card ≤ r ∧ (I.comap (h.openCover.{u, v}.f i)).ideal ⟨⊤, isAffineOpen_top _⟩ =
        Ideal.span s :=
  ⟨(h i.down).choose.2, (h i.down).choose_spec.2⟩

end AlgebraicGeometry.Scheme.IdealSheafData

end
