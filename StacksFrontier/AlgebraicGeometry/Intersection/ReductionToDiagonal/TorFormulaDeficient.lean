* [Stacks Project, Tag 0B04](https://stacks.math.columbia.edu/tag/0B04)
* [Stacks Project, Tag 0A21](https://stacks.math.columbia.edu/tag/0A21)
* [Stacks Project, Section 43.14 (Tag 0AZ8)](https://stacks.math.columbia.edu/tag/0AZ8)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace
open Stacks.Chow

universe u

attribute [local instance 100000] HasDerivedCategory.standard

namespace Stacks.Intersection.ReductionToDiagonal

/-! ### The ideal sheaf of a product of two closed subschemes -/

/-- **The ideal sheaf cut out by a product of two closed subschemes.** For `I`, `J` two
quasi-coherent sheaves of ideals on a scheme `X` over `k`, the closed immersion
`I.subscheme ×ₖ J.subscheme ⟶ X ×ₖ X` has kernel `pr₁^* I ⊔ pr₂^* J`. -/
theorem ker_prodMap_subschemeι {k : Type u} [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (I J : X.IdealSheafData) :
    (Diagonal.prodMap f I.subschemeι J.subschemeι).ker =
      I.comap (pullback.fst f f) ⊔ J.comap (pullback.snd f f) := by
  have hcomm : (Scheme.IdealSheafData.productSubschemeIso f f I J).hom ≫
      Diagonal.prodMap f I.subschemeι J.subschemeι =
      (I.comap (pullback.fst f f) ⊔ J.comap (pullback.snd f f)).subschemeι := by
    refine pullback.hom_ext ?_ ?_
    · rw [Category.assoc, Diagonal.prodMap_comp_fst]
      exact Scheme.IdealSheafData.productSubschemeIso_hom_fst_subschemeι f f I J
    · rw [Category.assoc, Diagonal.prodMap_comp_snd]
      exact Scheme.IdealSheafData.productSubschemeIso_hom_snd_subschemeι f f I J
  rw [← Scheme.Hom.ker_comp_of_isIso (Scheme.IdealSheafData.productSubschemeIso f f I J).hom
    (Diagonal.prodMap f I.subschemeι J.subschemeι), hcomm,
    Scheme.IdealSheafData.ker_subschemeι]

/-- **A point of the scheme-theoretic intersection over a point of the support.** For `I`, `J`
two quasi-coherent sheaves of ideals on `X` and `z` a point of the support of `I ⊔ J`, the fibre
product `I.subscheme ×_X J.subscheme` has a point lying over `z`. -/
theorem exists_pullback_subschemeι_apply_eq {X : Scheme.{u}} (I J : X.IdealSheafData) {z : X}
    (hz : z ∈ ((I ⊔ J).support : Set X)) :
    ∃ ζ : ↑(pullback I.subschemeι J.subschemeι),
      I.subschemeι (pullback.fst I.subschemeι J.subschemeι ζ) = z := by
  obtain ⟨y, hy⟩ : z ∈ Set.range (I ⊔ J).subschemeι.base := by
    rwa [Scheme.IdealSheafData.range_subschemeι]
  refine ⟨(Scheme.IdealSheafData.isPullback_subscheme_sup X I J).isoPullback.hom y, ?_⟩
  have h1 : pullback.fst I.subschemeι J.subschemeι
      ((Scheme.IdealSheafData.isPullback_subscheme_sup X I J).isoPullback.hom y) =
      Scheme.IdealSheafData.inclusion (le_sup_left : I ≤ I ⊔ J) y := by
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
      (Scheme.IdealSheafData.isPullback_subscheme_sup X I J).isoPullback_hom_fst]
  rw [h1, ← AlgebraicGeometry.Scheme.Hom.comp_apply,
    Scheme.IdealSheafData.inclusion_subschemeι]
  exact hy

/-! ### Local dimensions from the delta-dimension -/

/-- On an irreducible scheme the only irreducible component is the whole space, so the relative
dimension at the generic point of a component is the relative dimension at the generic point. -/
theorem relativeDimension_genericPoint_of_irreducibleSpace (C : ChowSituation.{u})
    {Y : Scheme.{u}} (g : Y ⟶ C.S) [LocallyOfFiniteType g] [IrreducibleSpace Y] {n : ℤ}
    (hn : relativeDimension C.dimensionFunction g (genericPoint Y) = n)
    (W : irreducibleComponents Y) :
    relativeDimension C.dimensionFunction g W.2.1.genericPoint = n := by
  have hW : (W : Set Y) = Set.univ := by
    have h : (W : Set Y) ∈ ({Set.univ} : Set (Set Y)) := by
      rw [← irreducibleComponents_eq_singleton (X := Y)]
      exact W.2
    exact Set.mem_singleton_iff.mp h
  have h1 : IsGenericPoint W.2.1.genericPoint (W : Set Y) :=
    W.2.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents (W : Set Y) W.2)
  have h1' : IsGenericPoint W.2.1.genericPoint (Set.univ : Set Y) := h1.trans hW
  have h2 : W.2.1.genericPoint = genericPoint Y := h1'.eq (genericPoint_spec Y)
  rw [h2]
  exact hn

/-- **The dimension of the local ring of an integral closed subscheme.** If `V = I.subscheme` is
integral with generic point `a` in `X`, the local ring of `V` at a point `v` has dimension
`δ(a) - δ(ι v)`. This is Tag 0A21 in the form `dim 𝒪_{V, v} = dim V - dim closure {v}`. -/
theorem ringKrullDim_stalk_subscheme_eq_toNat_sub (C : ChowSituation.{u}) {X : Scheme.{u}}
    (f : X ⟶ C.S) [LocallyOfFiniteType f] (I : X.IdealSheafData)
    (hI : IsIntegral I.subscheme) (v : I.subscheme) :
    ringKrullDim (I.subscheme.presheaf.stalk v) =
      ((((relativeDimension C.dimensionFunction f (genericPointOf I hI) -
        relativeDimension C.dimensionFunction f (I.subschemeι v)).toNat : ℕ) : ℕ∞) :
          WithBot ℕ∞) := by
  let := hI
  have hgp : relativeDimension C.dimensionFunction (I.subschemeι ≫ f)
      (genericPoint I.subscheme) =
      relativeDimension C.dimensionFunction f (genericPointOf I hI) :=
    relativeDimension_comp_closedImmersion C.dimensionFunction I.subschemeι f _
  rw [ringKrullDim_stalk_eq_toNat_sub_relativeDimension C (I.subschemeι ≫ f)
      (relativeDimension_genericPoint_of_irreducibleSpace C (I.subschemeι ≫ f) hgp) v,
    relativeDimension_comp_closedImmersion]

/-! ### The two numerical hypotheses of the vanishing criterion -/

/-- **The zero-dimensionality hypothesis.** Let `V`, `W` be the closed subschemes cut out by `I`
and `J` and let `z` be a point of their intersection at which the relative dimension attains the
largest value `n` it takes on that intersection. Then `dim 𝒪_{V ∩ W, z} = 0`, that is, the
closure of `z` is an irreducible component of `V ∩ W`. -/
theorem ringKrullDim_quotient_stalk_sup_eq_zero (C : ChowSituation.{u}) {X : Scheme.{u}}
    (f : X ⟶ C.S) [LocallyOfFiniteType f] (I J : X.IdealSheafData) {n : ℤ} {z : X}
    (hz : z ∈ ((I ⊔ J).support : Set X))
    (hzn : relativeDimension C.dimensionFunction f z = n)
    (hub : ∀ w ∈ ((I ⊔ J).support : Set X),
      relativeDimension C.dimensionFunction f w ≤ n) :
    ringKrullDim (X.presheaf.stalk z ⧸
      AlgebraicGeometry.IdealSheafData.stalk (I ⊔ J) z) = 0 := by
  obtain ⟨y, hy⟩ : z ∈ Set.range (I ⊔ J).subschemeι.base := by
    rwa [Scheme.IdealSheafData.range_subschemeι]
  have key : ∀ w : X, (I ⊔ J).subschemeι.base y = w →
      ringKrullDim (X.presheaf.stalk w ⧸
          AlgebraicGeometry.IdealSheafData.stalk (I ⊔ J) w) =
        ringKrullDim ((I ⊔ J).subscheme.presheaf.stalk y) := by
    intro w hw
    subst hw
    rw [← AlgebraicGeometry.IdealSheafData.ker_stalkMap_subschemeι_eq_stalk (I ⊔ J) y]
    exact ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective
      ((I ⊔ J).subschemeι.stalkMap_surjective y))
  rw [key z hy, AlgebraicGeometry.ringKrullDim_stalk_eq_coheight y]
  have hyn : relativeDimension C.dimensionFunction ((I ⊔ J).subschemeι ≫ f) y = n := by
    rw [relativeDimension_comp_closedImmersion, hy]
    exact hzn
  have hubY : ∀ y' : (I ⊔ J).subscheme,
      relativeDimension C.dimensionFunction ((I ⊔ J).subschemeι ≫ f) y' ≤ n := by
    intro y'
    rw [relativeDimension_comp_closedImmersion]
    refine hub _ ?_
    rw [← Scheme.IdealSheafData.range_subschemeι]
    exact ⟨y', rfl⟩
  obtain ⟨d, hd⟩ := relativeDimension_isDimensionFunction C.isUniversallyCatenary
    C.dimensionFunction ((I ⊔ J).subschemeι ≫ f)
  have hmax : IsMax y := by
    intro y' hyy'
    by_cases hne : y' = y
    · exact hne.le
    · exfalso
      have hlt := d.strictAnti_specializes (Scheme.le_iff_specializes.mp hyy') hne
      rw [hd y, hd y', hyn] at hlt
      have hy' := hubY y'
      omega
  rw [Order.coheight_eq_zero.mpr hmax]
  rfl

/-- **The dimension-deficit hypothesis for the diagonal pair.** Let `X` be a variety of dimension
`dX` over a field `k`, let `V = I.subscheme` and `W = J.subscheme` be integral closed subschemes
with generic points `a`, `b` in `X`, and let `z` be a point of `V ∩ W` of relative dimension `n`.
If `dim V + dim W < dX + n`, then the local ideal of `V ×ₖ W` at `Δ(z)` has

`dim (𝒪_{X ×ₖ X, Δ(z)} ⧸ J') < dX`,

which is the deficit hypothesis of the Hilbert-polynomial vanishing criterion for the pair
`(Δ, V ×ₖ W)` on `X ×ₖ X`. -/
theorem ringKrullDim_quotient_stalk_sup_comap_lt (k : Type u) [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsVariety k f] (I J : X.IdealSheafData)
    (hI : IsIntegral I.subscheme) (hJ : IsIntegral J.subscheme) {n : ℤ} {dX : ℕ}
    (hdX : topologicalKrullDim X = (dX : WithBot ℕ∞)) {z : X}
    (hz : z ∈ ((I ⊔ J).support : Set X))
    (hzn : relativeDimension (fieldChowSituation k).dimensionFunction f z = n)
    (hdef : relativeDimension (fieldChowSituation k).dimensionFunction f (genericPointOf I hI) +
        relativeDimension (fieldChowSituation k).dimensionFunction f (genericPointOf J hJ) <
      (dX : ℤ) + n) :
    ringKrullDim ((pullback f f).presheaf.stalk (pullback.diagonal f z) ⧸
      AlgebraicGeometry.IdealSheafData.stalk
        (I.comap (pullback.fst f f) ⊔ J.comap (pullback.snd f f))
        (pullback.diagonal f z)) < (dX : WithBot ℕ∞) := by
  let := hI
  let := hJ
  obtain ⟨ζ, hζ⟩ := exists_pullback_subschemeι_apply_eq I J hz
  -- the relative dimension at `z` is at most each of the three global dimensions
  have hle : ∀ (K : X.IdealSheafData) (hK : IsIntegral K.subscheme), z ∈ (K.support : Set X) →
      n ≤ relativeDimension (fieldChowSituation k).dimensionFunction f (genericPointOf K hK) := by
    intro K hK hzK
    rw [← hzn]
    refine relativeDimension_le_of_mem_closure (fieldChowSituation k) f ?_
    rwa [← support_eq_closure_genericPointOf K hK]
  rw [Scheme.IdealSheafData.support_sup] at hz
  have hna := hle I hI hz.1
  have hnb := hle J hJ hz.2
  have hgX : relativeDimension (fieldChowSituation k).dimensionFunction f (genericPoint X) =
      dX := relativeDimension_genericPoint_eq f dX hdX
  have hnd : n ≤ (dX : ℤ) := by
    rw [← hzn, ← hgX]
    refine relativeDimension_le_of_mem_closure (fieldChowSituation k) f ?_
    rw [genericPoint_spec X]
    exact Set.mem_univ z
  -- the three local dimensions
  have hloc : ∀ (K : X.IdealSheafData) (hK : IsIntegral K.subscheme) (v : K.subscheme),
      K.subschemeι v = z → ringKrullDim (K.subscheme.presheaf.stalk v) =
      ((((relativeDimension (fieldChowSituation k).dimensionFunction f
        (genericPointOf K hK) - n).toNat : ℕ) : ℕ∞) : WithBot ℕ∞) := by
    intro K hK v hv
    rw [ringKrullDim_stalk_subscheme_eq_toNat_sub (fieldChowSituation k) f K hK, hv, hzn]
  have hV := hloc I hI _ hζ
  have hW := hloc J hJ (pullback.snd I.subschemeι J.subschemeι ζ)
    (by rw [Diagonal.image_eq_of_mem_pullback I.subschemeι J.subschemeι ζ]; exact hζ)
  have hXz : ringKrullDim (X.presheaf.stalk z) =
      (((((dX : ℤ) - n).toNat : ℕ) : ℕ∞) : WithBot ℕ∞) := by
    rw [ringKrullDim_stalk_eq_toNat_sub_relativeDimension (fieldChowSituation k) f
      (relativeDimension_genericPoint_of_irreducibleSpace (fieldChowSituation k) f hgX) z, hzn]
  -- the additivity of the dimensions of the diagonal pair
  have hadd := Diagonal.ringKrullDim_quotient_stalk_ker_prodMap_add f I.subschemeι J.subschemeι ζ
  rw [ker_prodMap_subschemeι f I J, hζ, hV, hW, hXz, hdX] at hadd
  -- the dimension of the quotient is finite
  obtain ⟨q, hq⟩ : ∃ q : ℕ, ringKrullDim ((pullback f f).presheaf.stalk
      (pullback.diagonal f z) ⧸ AlgebraicGeometry.IdealSheafData.stalk
        (I.comap (pullback.fst f f) ⊔ J.comap (pullback.snd f f))
        (pullback.diagonal f z)) = (q : WithBot ℕ∞) := by
    have hlnQ : IsLocallyNoetherian (pullback (I.subschemeι ≫ f) (J.subschemeι ≫ f)) :=
      LocallyOfFiniteType.isLocallyNoetherian
        (pullback.fst (I.subschemeι ≫ f) (J.subschemeι ≫ f) ≫ (I.subschemeι ≫ f))
    obtain ⟨q, hq⟩ := Diagonal.exists_ringKrullDim_eq_natCast
      ((pullback (I.subschemeι ≫ f) (J.subschemeι ≫ f)).presheaf.stalk
        (Diagonal.interToProd f I.subschemeι J.subschemeι ζ))
    refine ⟨q, ?_⟩
    rw [← hζ, ← ker_prodMap_subschemeι f I J,
      Diagonal.ringKrullDim_quotient_stalk_ker_prodMap f I.subschemeι J.subschemeι ζ]
    exact hq
  rw [hq] at hadd ⊢
  have hnat : q + (((dX : ℤ) - n).toNat) =
      (relativeDimension (fieldChowSituation k).dimensionFunction f
          (genericPointOf I hI) - n).toNat +
        (relativeDimension (fieldChowSituation k).dimensionFunction f
          (genericPointOf J hJ) - n).toNat + dX := by
    have h := hadd
    push_cast at h
    exact_mod_cast h
  have hlt : q < dX := by omega
  exact_mod_cast Nat.cast_lt.mpr hlt

/-! ### The vanishing of a deficient product -/

/-- **The vanishing of a deficient product of two closed subvarieties.** Let `X` be a nonsingular
variety of dimension `dX` over an algebraically closed field `k`, let `V = closure {a}` and
`W = closure {b}` be two closed subvarieties and let `n` be an integer. If every point of
`V ∩ W` has relative dimension at most `n`, and if `dim V + dim W < dX + n`, then the Section
43.14 product `V · W` in dimension `n` is the zero cycle.

This is the complementary case `dim V < r` or `dim W < s` of the dévissage of the Tor formula of
Tag 0B0W, with `n = r + s - dX`. It is not formal: for `X` a nonsingular surface and `V = W` a
closed point three of the `Tor` modules are nonzero, of lengths `1`, `2` and `1`, and only the
alternating sum vanishes. The proof is the source's, through the reduction to the diagonal of
Tag 0B0U and the Hilbert-polynomial criterion of Tag 0B04; see the module documentation. -/
theorem torSubvarietyProductOfBound_eq_zero_of_lt (k : Type u) [Field k] [IsAlgClosed k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsVariety k f] (hX : IsRegular X)
    [IsLocallyNoetherian X] (n : ℤ) (a b : X)
    (hab : AlgebraicGeometry.TorFormula.TorSupportBound (Stacks.Chow.fieldChowSituation k) f hX
      n a b)
    (dX : ℕ) (hdX : topologicalKrullDim X = (dX : WithBot ℕ∞))
    (hinter : ∀ w ∈ closure ({a} : Set X) ∩ closure ({b} : Set X),
      Stacks.Chow.relativeDimension (Stacks.Chow.fieldChowSituation k).dimensionFunction f w ≤ n)
    (hdef : Stacks.Chow.relativeDimension (Stacks.Chow.fieldChowSituation k).dimensionFunction f a
        + Stacks.Chow.relativeDimension (Stacks.Chow.fieldChowSituation k).dimensionFunction f b
        < (dX : ℤ) + n) :
    AlgebraicGeometry.TorFormula.torSubvarietyProductOfBound (Stacks.Chow.fieldChowSituation k) f
      hX n hab = 0 := by
  have hI : IsIntegral (integralComponentAt a).subscheme := isIntegral_integralComponentAt a
  have hJ : IsIntegral (integralComponentAt b).subscheme := isIntegral_integralComponentAt b
  have hsupp : (((integralComponentAt a ⊔ integralComponentAt b).support :
      TopologicalSpace.Closeds X) : Set X) =
      closure ({a} : Set X) ∩ closure ({b} : Set X) := by
    rw [Scheme.IdealSheafData.support_sup]
    simp [coe_support_integralComponentAt]
  have hgenI : genericPointOf (integralComponentAt a) hI = a :=
    genericPointOf_integralComponentAt a
  have hgenJ : genericPointOf (integralComponentAt b) hJ = b :=
    genericPointOf_integralComponentAt b
  refine Function.locallyFinsuppWithin.ext fun z => ?_
  show TorFormula.torSubvarietyProductOfBound (fieldChowSituation k) f hX n hab z = 0
  by_cases hzn : relativeDimension (fieldChowSituation k).dimensionFunction f z = n
  · by_cases hzab : z ∈ closure ({a} : Set X) ∩ closure ({b} : Set X)
    · have hzsup : z ∈ (((integralComponentAt a ⊔ integralComponentAt b).support :
          TopologicalSpace.Closeds X) : Set X) := by rw [hsupp]; exact hzab
      have hcoeff :=
        TorFormula.torSubvarietyProductOfBound_apply_eq_localIntersectionMultiplicity
          (fieldChowSituation k) f hX n hab dX hdX.le hzn hzab.1 hzab.2
      have hzero : (TorFormula.localIdealAt a z).localIntersectionMultiplicity
          (X.presheaf.stalk z ⧸ TorFormula.localIdealAt b z) = 0 := by
        show Ideal.localIntersectionMultiplicity
            (AlgebraicGeometry.IdealSheafData.stalk (integralComponentAt a) z)
            (X.presheaf.stalk z ⧸
              AlgebraicGeometry.IdealSheafData.stalk (integralComponentAt b) z) = 0
        have : Smooth (pullback.fst f f ≫ f) :=
          AlgebraicGeometry.smooth_pullback_of_isRegular f f hX hX
        have : IsRegularLocalRing
            ((pullback f f).presheaf.stalk (pullback.diagonal f z)) :=
          AlgebraicGeometry.isRegularLocalRing_stalk_of_smooth_over_field
            (pullback.fst f f ≫ f) _
        obtain ⟨g, hgreg, hgspan⟩ :=
          Diagonal.exists_isRegular_fin_generating_ker_stalkMap_diagonal f hX z hdX
        have h0 : ringKrullDim ((pullback f f).presheaf.stalk (pullback.diagonal f z) ⧸
            (RingHom.ker ((pullback.diagonal f).stalkMap z).hom ⊔
              AlgebraicGeometry.IdealSheafData.stalk
                ((integralComponentAt a).comap (pullback.fst f f) ⊔
                  (integralComponentAt b).comap (pullback.snd f f))
                (pullback.diagonal f z))) = 0 := by
          rw [Diagonal.ringKrullDim_quotient_sup_ker_stalkMap_diagonal f
            (integralComponentAt a) (integralComponentAt b) z]
          exact ringKrullDim_quotient_stalk_sup_eq_zero (fieldChowSituation k) f _ _ hzsup hzn
            (fun w hw => hinter w (by rwa [hsupp] at hw))
        have hlt := ringKrullDim_quotient_stalk_sup_comap_lt k f (integralComponentAt a)
          (integralComponentAt b) hI hJ hdX hzsup hzn (by rw [hgenI, hgenJ]; exact hdef)
        have hvan :=
          Stacks.Intersection.localIntersectionMultiplicity_eq_zero_of_isRegularSequence
            g (RingHom.ker ((pullback.diagonal f).stalkMap z).hom)
            (AlgebraicGeometry.IdealSheafData.stalk
              ((integralComponentAt a).comap (pullback.fst f f) ⊔
                (integralComponentAt b).comap (pullback.snd f f))
              (pullback.diagonal f z)) hgreg hgspan.symm h0 hlt
        rw [← Diagonal.localIntersectionMultiplicity_stalk_comap_diagonal_eq k f
          (integralComponentAt a) (integralComponentAt b) z]
        exact hvan
      rw [hzero] at hcoeff
      exact_mod_cast hcoeff
    · exact TorFormula.torSubvarietyProductOfBound_apply_eq_zero_of_notMem_inter
        (fieldChowSituation k) f hX n hab dX hdX.le hzab
  · exact TorFormula.torSubvarietyProductOfBound_apply_eq_zero_of_relativeDimension_ne
      (fieldChowSituation k) f hX n hab dX hdX.le hzn

end Stacks.Intersection.ReductionToDiagonal

