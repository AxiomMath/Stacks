/-!
# The multiplicity of the diagonal pair, at the local rings of `X × X`

Let `k` be a field, `A` a commutative `k`-algebra and `B` a localization of `A ⊗[k] A` through
`φ` which carries a retraction `d : B → A` of the multiplication map, that is `lmul' = d ∘ φ`.
For `A`-modules `M`, `N` the reduction to the diagonal
(`Stacks.Intersection.Diagonal.diagonalTorLocalizedIso`) gives, in every degree,

`Tor_i^B(A, B ⊗_{A ⊗[k] A} (M ⊗[k] N)) ≅ Tor_i^A(M, N)`

as `B`-modules, the `A`-modules being read over `B` through `d`. Hence the two sides have the
same *length*, and the alternating sums of lengths which are the intersection multiplicities of
Section 43.14 agree. For ideals `I`, `J` of `A` the conclusion is

`e(ker d, B ⧸ (I B + J B)) = e(I, A ⧸ J)`,

where `I B` and `J B` are the ideals of `B` generated by the images of `I` and of `J` under the
two maps `A → A ⊗[k] A → B`.

Geometrically, with `A = 𝒪_{X, ξ}` at the generic point `ξ` of an irreducible component `Z` of
`V ∩ W` and `B = 𝒪_{X × X, Δ(ξ)}`
(`Stacks.Intersection.Diagonal.diagonal_stalk_isLocalization`), the ideal `ker d` is the local
ideal of the diagonal, `I B + J B` is the ideal of `B` generated by the local ideals of `V` and
of `W` pulled back along the two projections, and the equality reads
`e(X × X, Δ · V × W, Δ(Z)) = e(X, V · W, Z)`.

## Main results

* `Ideal.localIntersectionMultiplicity_congr` — the Tor-formula multiplicity only depends on the
  isomorphism class of its module argument.
* `Stacks.Intersection.Diagonal.length_restrictScalars_of_surjective` — restriction of scalars
  along a surjection of commutative rings preserves length ([Stacks, Tag 00IX] part (2)).
* `Stacks.Intersection.Diagonal.surjective_of_lmul'_eq_comp` and
  `Stacks.Intersection.Diagonal.kerQuotIso` — a retraction of the multiplication map is
  surjective, and `B ⧸ ker d` is `A` read over `B` through `d`.
* `Stacks.Intersection.Diagonal.exteriorIdeal` — the ideal `I ⊗ A + A ⊗ J` of `A ⊗[k] A`, which
  cuts out the product of the two closed subschemes, together with
  `Stacks.Intersection.Diagonal.extendScalarsExtObjIso`, the identification
  `B ⊗_{A ⊗[k] A} ((A ⧸ I) ⊗[k] (A ⧸ J)) ≅ B ⧸ (I B + J B)`.
* `Stacks.Intersection.Diagonal.length_diagonalTor` — **the equality of lengths of the two `Tor`
  modules of the reduction to the diagonal, in every degree.**
* `Stacks.Intersection.Diagonal.localIntersectionMultiplicity_ker_eq` and
  `Stacks.Intersection.Diagonal.localIntersectionMultiplicity_sup_map_eq` — **the resulting
  equality of Tor-formula intersection multiplicities**, in the base-change form and with the
  second module presented as the quotient of `B` by `I B + J B`.
* `AlgebraicGeometry.IdealSheafData.stalk_comap_eq_map_of_stalkMap` and
  `Stacks.Intersection.Diagonal.stalk_sup_comap_diagonal_eq` — **the geometric identification**:
  the stalk at `Δ(x)` of the ideal sheaf `pr₁^* I ⊔ pr₂^* J` cutting out `V ×_Y W` is generated
  by the images of `I_x` and `J_x` under the two local ring maps of the projections, which under
  the presentation of `diagonal_stalk_isLocalization` is the ideal `I_x B + J_x B` of `B` above.

## References

* [Stacks Project, Lemma 43.19.2 (Tag 0B0U)](https://stacks.math.columbia.edu/tag/0B0U)
* [Stacks Project, Lemma 43.19.1 (Tag 0B0T)](https://stacks.math.columbia.edu/tag/0B0T)
* [Stacks Project, Tag 00IX](https://stacks.math.columbia.edu/tag/00IX)
* [Stacks Project, Tag 0AZR](https://stacks.math.columbia.edu/tag/0AZR)
-/

@[expose] public noncomputable section

open CategoryTheory TensorProduct

universe u

/-- **The Tor-formula multiplicity depends only on the isomorphism class of its module.** -/
theorem Ideal.localIntersectionMultiplicity_congr {R : Type u} [CommRing R] (I : Ideal R)
    {M N : ModuleCat.{u} R} (e : M ≅ N) :
    I.localIntersectionMultiplicity M = I.localIntersectionMultiplicity N :=
  tsum_congr fun i => by
    rw [ModuleCat.length_eq_of_iso
      (((Tor (ModuleCat.{u} R) i).obj (ModuleCat.of R (R ⧸ I))).mapIso e)]

namespace AlgebraicGeometry.IdealSheafData

/-- **Transport of an ideal sheaf's stalk along an equality of points.** Along `h : a = b`, the
stalk of `I` at `a` is the image of the stalk of `I` at `b` under the transport isomorphism of
local rings. -/
theorem stalk_eqToHom {X : AlgebraicGeometry.Scheme.{u}} (I : X.IdealSheafData) {a b : X}
    (h : a = b) :
    stalk I a =
      Ideal.map (eqToHom (congrArg X.presheaf.stalk h.symm)).hom (stalk I b) := by
  subst h
  simp

/-- **The stalk of a comap ideal sheaf, through a point transported to agree with a chosen
one.** If `p : Z ⟶ X` sends `z` to a point `x` of `X` (only up to the equality `hb`, not
necessarily `p.base z` literally), then the stalk at `z` of the inverse image of `I` along `p`
is the image of the stalk of `I` at `x` under `p`'s local ring map at `z`, composed with the
transport along `hb`. -/
theorem stalk_comap_eq_map_of_stalkMap {X Z : AlgebraicGeometry.Scheme.{u}}
    (I : X.IdealSheafData) (p : Z ⟶ X) (z : Z) {x : X} (hb : p.base z = x) :
    stalk (I.comap p) z =
      Ideal.map ((p.stalkMap z).hom.comp (eqToHom (congrArg X.presheaf.stalk hb.symm)).hom)
        (stalk I x) := by
  rw [stalk_comap, stalk_eqToHom I hb, Ideal.map_map]

end AlgebraicGeometry.IdealSheafData

namespace Stacks.Intersection.Diagonal

/-! ### Length along a surjective change of rings -/

/-- **Restriction of scalars along a surjection preserves length** ([Stacks, Tag 00IX] part (2)).
For a surjection `d : B → A` of commutative rings and an `A`-module `P`, the length of `P` read
over `B` through `d` is its length over `A`. -/
theorem length_restrictScalars_of_surjective {A B : Type u} [CommRing A] [CommRing B]
    (d : B →+* A) (hd : Function.Surjective d) (P : ModuleCat.{u} A) :
    Module.length B ((ModuleCat.restrictScalars d).obj P) = Module.length A P :=
  Module.length_eq_of_surjective_of_addEquiv d hd (AddEquiv.refl _) fun _ _ => rfl

/-! ### The kernel of a retraction of the multiplication map -/

/-- **A retraction of the multiplication map is surjective.** If `d : B → A` satisfies
`lmul' = d ∘ φ` for a ring map `φ : A ⊗[k] A → B`, then `a = d (φ (a ⊗ₜ 1))` for every `a`. -/
theorem surjective_of_lmul'_eq_comp {k A B : Type u} [CommRing k] [CommRing A] [Algebra k A]
    [CommRing B] {φ : A ⊗[k] A →+* B} {d : B →+* A}
    (hd : (Algebra.TensorProduct.lmul' k (S := A)).toRingHom = d.comp φ) :
    Function.Surjective d := by
  intro a
  refine ⟨φ (a ⊗ₜ[k] 1), ?_⟩
  have h := RingHom.congr_fun hd (a ⊗ₜ[k] (1 : A))
  simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.lmul'_apply_tmul,
    mul_one, RingHom.coe_comp, Function.comp_apply] at h
  exact h.symm

/-- **The quotient of `B` by the kernel of a retraction `d : B → A` is `A`.** As a `B`-module,
`B ⧸ ker d` is `A` read over `B` through `d`. Geometrically, with `B = 𝒪_{X × X, Δ(ξ)}` and `d`
the local ring map of the diagonal, this says that `ker d` is the local ideal of the diagonal and
that `𝒪_Δ` is its quotient. -/
def kerQuotIso {A B : Type u} [CommRing A] [CommRing B] (d : B →+* A)
    (hd : Function.Surjective d) :
    ModuleCat.of B (B ⧸ RingHom.ker d) ≅
      (ModuleCat.restrictScalars d).obj (ModuleCat.of A A) :=
  letI : Module B A := Module.compHom A d
  LinearEquiv.toModuleIso (X₁ := ModuleCat.of B (B ⧸ RingHom.ker d)) (X₂ := ModuleCat.of B A)
    (AddEquiv.toLinearEquiv (RingHom.quotientKerEquivOfSurjective hd).toAddEquiv
      (fun b x => by
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
        change d (b * y) = d b * d y
        exact d.map_mul b y))

/-! ### The ideal of the product of two closed subschemes -/

section Exterior

attribute [local instance] exteriorModule

variable {k A : Type u} [Field k] [CommRing A] [Algebra k A] (I J : Ideal A)

/-- **The ideal of `A ⊗[k] A` cutting out the product of two closed subschemes.** For ideals `I`,
`J` of `A` this is `I ⊗ A + A ⊗ J`, the ideal generated by the images of `I` and of `J` under the
two inclusions of `A` into `A ⊗[k] A`: on `Spec A × Spec A` it cuts out
`Spec (A ⧸ I) × Spec (A ⧸ J)`. -/
def exteriorIdeal : Ideal (A ⊗[k] A) :=
  I.map (algebraMap A (A ⊗[k] A)) ⊔
    J.map (Algebra.TensorProduct.includeRight (R := k) (A := A) (B := A)).toRingHom

/-- The quotient map `A ⊗[k] A → (A ⧸ I) ⊗[k] (A ⧸ J)`. -/
def exteriorQuotMap : (A ⊗[k] A) →ₐ[k] (A ⧸ I) ⊗[k] (A ⧸ J) :=
  Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k I) (Ideal.Quotient.mkₐ k J)

/-- **The exterior action of `A ⊗[k] A` on `(A ⧸ I) ⊗[k] (A ⧸ J)` is multiplication through the
quotient map.** -/
theorem exteriorModule_smul_eq_mul (r : A ⊗[k] A) (x : (A ⧸ I) ⊗[k] (A ⧸ J)) :
    r • x = exteriorQuotMap I J r * x := by
  induction r using TensorProduct.inductionOn with
  | add r₁ r₂ h₁ h₂ => rw [add_smul, h₁, h₂, map_add, add_mul]
  | tmul a b =>
    induction x using TensorProduct.inductionOn with
    | add x₁ x₂ h₁ h₂ => rw [smul_add, h₁, h₂, mul_add]
    | tmul m n =>
      rw [exteriorModule_smul_tmul, exteriorQuotMap, Algebra.TensorProduct.map_tmul,
        Algebra.TensorProduct.tmul_mul_tmul]
      congr 1

/-- The quotient of `(A ⧸ I) ⊗[k] A` by the image of `J`, transported along the presentation of
`(A ⧸ I) ⊗[k] A` as a quotient of `A ⊗[k] A`. -/
def exteriorQuotRingEquivAux :
    (((A ⧸ I) ⊗[k] A) ⧸
        (J.map (Algebra.TensorProduct.includeRight (R := k) (A := A ⧸ I) (B := A)).toRingHom)) ≃+*
      (((A ⊗[k] A) ⧸ I.map (algebraMap A (A ⊗[k] A))) ⧸
        (J.map (Algebra.TensorProduct.includeRight (R := k) (A := A) (B := A)).toRingHom).map
          (Ideal.Quotient.mk (I.map (algebraMap A (A ⊗[k] A))))) :=
  Ideal.quotientEquiv
    (J.map (Algebra.TensorProduct.includeRight (R := k) (A := A ⧸ I) (B := A)).toRingHom)
    ((J.map (Algebra.TensorProduct.includeRight (R := k) (A := A) (B := A)).toRingHom).map
      (Ideal.Quotient.mk (I.map (algebraMap A (A ⊗[k] A)))))
    (Algebra.TensorProduct.quotientTensorEquiv (R := k) k A A I).toRingEquiv
    (by
      rw [Ideal.map_map, Ideal.map_map]
      congr 1)

/-- **The tensor product of two quotients is the quotient by the exterior ideal:**
`(A ⧸ I) ⊗[k] (A ⧸ J) ≅ (A ⊗[k] A) ⧸ (I ⊗ A + A ⊗ J)`, as rings. -/
def exteriorQuotRingEquiv :
    (A ⧸ I) ⊗[k] (A ⧸ J) ≃+* (A ⊗[k] A) ⧸ exteriorIdeal (k := k) I J :=
  ((Algebra.TensorProduct.tensorQuotientEquiv (R := k) k A (A ⧸ I) J).toRingEquiv.trans
    (exteriorQuotRingEquivAux I J)).trans (DoubleQuot.quotQuotEquivQuotSup _ _)

/-- The isomorphism of `exteriorQuotRingEquiv` is the one induced by the quotient map. -/
theorem exteriorQuotRingEquiv_exteriorQuotMap (r : A ⊗[k] A) :
    exteriorQuotRingEquiv I J (exteriorQuotMap I J r) = Ideal.Quotient.mk _ r := by
  induction r using TensorProduct.inductionOn with
  | add r₁ r₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂, map_add]
  | tmul a b =>
    rw [exteriorQuotMap, Algebra.TensorProduct.map_tmul]
    rfl

/-- `exteriorQuotRingEquiv` is linear for the exterior action of `A ⊗[k] A`. -/
def exteriorQuotLinearEquiv :
    ((A ⧸ I) ⊗[k] (A ⧸ J)) ≃ₗ[A ⊗[k] A] ((A ⊗[k] A) ⧸ exteriorIdeal (k := k) I J) :=
  AddEquiv.toLinearEquiv (exteriorQuotRingEquiv I J).toAddEquiv (fun r x => by
    change exteriorQuotRingEquiv I J (r • x) = r • exteriorQuotRingEquiv I J x
    rw [exteriorModule_smul_eq_mul, map_mul, exteriorQuotRingEquiv_exteriorQuotMap,
      Algebra.smul_def, Ideal.Quotient.algebraMap_eq])

/-- The exterior tensor product of two quotients, as an `A ⊗[k] A`-module, is the quotient of
`A ⊗[k] A` by the exterior ideal. -/
def extObjExteriorIdealIso :
    extObj (k := k) (A ⧸ I) (A ⧸ J) ≅
      ModuleCat.of (A ⊗[k] A) ((A ⊗[k] A) ⧸ exteriorIdeal (k := k) I J) :=
  LinearEquiv.toModuleIso (exteriorQuotLinearEquiv I J)

/-- **The base change of the exterior tensor product of two quotients is a quotient of `B`:**
`B ⊗_{A ⊗[k] A} ((A ⧸ I) ⊗[k] (A ⧸ J)) ≅ B ⧸ (I ⊗ A + A ⊗ J) B` for any `A ⊗[k] A`-algebra
`B`. -/
def extendScalarsExtObjIso {B : Type u} [CommRing B] (φ : (A ⊗[k] A) →+* B) :
    (ModuleCat.extendScalars φ).obj (extObj (k := k) (A ⧸ I) (A ⧸ J)) ≅
      ModuleCat.of B (B ⧸ (exteriorIdeal (k := k) I J).map φ) :=
  letI := φ.toAlgebra
  (ModuleCat.extendScalars φ).mapIso (extObjExteriorIdealIso I J) ≪≫
    (LinearEquiv.toModuleIso
      (X₁ := ModuleCat.of B (B ⧸ (exteriorIdeal (k := k) I J).map φ))
      (X₂ := (ModuleCat.extendScalars φ).obj
        (ModuleCat.of (A ⊗[k] A) ((A ⊗[k] A) ⧸ exteriorIdeal (k := k) I J)))
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B
        (exteriorIdeal (k := k) I J)).toLinearEquiv).symm

/-- The image in `B` of the exterior ideal is generated by the images of `I` and of `J` under the
two maps `A → A ⊗[k] A → B`. -/
theorem map_exteriorIdeal {B : Type u} [CommRing B] (φ : (A ⊗[k] A) →+* B) :
    (exteriorIdeal (k := k) I J).map φ =
      I.map (φ.comp (algebraMap A (A ⊗[k] A))) ⊔
        J.map (φ.comp (Algebra.TensorProduct.includeRight
          (R := k) (A := A) (B := A)).toRingHom) := by
  rw [exteriorIdeal, Ideal.map_sup, Ideal.map_map, Ideal.map_map]

end Exterior

/-! ### The equality of lengths and of multiplicities -/

section Stalk

attribute [local instance] exteriorModule diagonalAlgebra diagonalModule diagonalIsScalarTower

variable {k A B : Type u} [Field k] [CommRing A] [Algebra k A] [CommRing B]

/-- **The reduction to the diagonal preserves the length of the `Tor` modules, in every degree.**
Let `k` be a field, `A` a commutative `k`-algebra and `B` a localization of `A ⊗[k] A` through
`φ` carrying a retraction `d : B → A` of the multiplication map. Then for `A`-modules `M`, `N`
and every degree `i`

`length_B Tor_i^B(B ⧸ ker d, B ⊗_{A ⊗[k] A} (M ⊗[k] N)) = length_A Tor_i^A(M, N)`. -/
theorem length_diagonalTor (φ : A ⊗[k] A →+* B) (T : Submonoid (A ⊗[k] A))
    (hT : letI := φ.toAlgebra; IsLocalization T B) (d : B →+* A)
    (hd : (Algebra.TensorProduct.lmul' k (S := A)).toRingHom = d.comp φ) (i : ℕ)
    (M N : Type u) [AddCommGroup M] [Module k M] [Module A M] [IsScalarTower k A M]
    [AddCommGroup N] [Module k N] [Module A N] [IsScalarTower k A N] :
    Module.length B (((Tor (ModuleCat.{u} B) i).obj
          (ModuleCat.of B (B ⧸ RingHom.ker d))).obj
        ((ModuleCat.extendScalars φ).obj (extObj (k := k) M N))) =
      Module.length A (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A M)).obj
        (ModuleCat.of A N)) := by
  have hsurj : Function.Surjective d := surjective_of_lmul'_eq_comp hd
  rw [ModuleCat.length_eq_of_iso
      (((Tor (ModuleCat.{u} B) i).mapIso (kerQuotIso d hsurj)).app
        ((ModuleCat.extendScalars φ).obj (extObj (k := k) M N))),
    ModuleCat.length_eq_of_iso (diagonalTorLocalizedIso φ T hT d hd i M N),
    length_restrictScalars_of_surjective d hsurj]

/-- **The reduction to the diagonal for the Tor-formula intersection multiplicity, in base-change
form.** Let `k` be a field, `A` a commutative `k`-algebra and `B` a localization of `A ⊗[k] A`
through `φ` carrying a retraction `d : B → A` of the multiplication map, and let `I`, `J` be
ideals of `A`. Then

`e(ker d, B ⊗_{A ⊗[k] A} ((A ⧸ I) ⊗[k] (A ⧸ J))) = e(I, A ⧸ J)`. -/
theorem localIntersectionMultiplicity_ker_eq (φ : A ⊗[k] A →+* B) (T : Submonoid (A ⊗[k] A))
    (hT : letI := φ.toAlgebra; IsLocalization T B) (d : B →+* A)
    (hd : (Algebra.TensorProduct.lmul' k (S := A)).toRingHom = d.comp φ) (I J : Ideal A) :
    (RingHom.ker d).localIntersectionMultiplicity
        ((ModuleCat.extendScalars φ).obj (extObj (k := k) (A ⧸ I) (A ⧸ J))) =
      I.localIntersectionMultiplicity (A ⧸ J) :=
  tsum_congr fun i => by
    rw [length_diagonalTor φ T hT d hd i (A ⧸ I) (A ⧸ J)]

/-- **The reduction to the diagonal for the Tor-formula intersection multiplicity.** Let `k` be a
field, `A` a commutative `k`-algebra and `B` a localization of `A ⊗[k] A` through `φ` carrying a
retraction `d : B → A` of the multiplication map, and let `I`, `J` be ideals of `A`. Write `I B`
and `J B` for the ideals of `B` generated by the images of `I` and of `J` under the two maps
`A → A ⊗[k] A → B`. Then

`e(ker d, B ⧸ (I B + J B)) = e(I, A ⧸ J)`.

Geometrically `A = 𝒪_{X, ξ}` at the generic point `ξ` of an irreducible component `Z` of
`V ∩ W`, `B = 𝒪_{X × X, Δ(ξ)}`, the ideal `ker d` is the local ideal of the diagonal and
`I B + J B` is the ideal generated by the local ideals of `V` and of `W` pulled back along the
two projections; the equality then reads `e(X × X, Δ · V × W, Δ(Z)) = e(X, V · W, Z)`. -/
theorem localIntersectionMultiplicity_sup_map_eq (φ : A ⊗[k] A →+* B)
    (T : Submonoid (A ⊗[k] A)) (hT : letI := φ.toAlgebra; IsLocalization T B) (d : B →+* A)
    (hd : (Algebra.TensorProduct.lmul' k (S := A)).toRingHom = d.comp φ) (I J : Ideal A) :
    (RingHom.ker d).localIntersectionMultiplicity
        (B ⧸ (I.map (φ.comp (algebraMap A (A ⊗[k] A))) ⊔
          J.map (φ.comp (Algebra.TensorProduct.includeRight
            (R := k) (A := A) (B := A)).toRingHom))) =
      I.localIntersectionMultiplicity (A ⧸ J) := by
  rw [← map_exteriorIdeal I J φ]
  exact ((RingHom.ker d).localIntersectionMultiplicity_congr
      (extendScalarsExtObjIso I J φ)).symm.trans
    (localIntersectionMultiplicity_ker_eq φ T hT d hd I J)

end Stalk

/-! ### The geometric instantiation: the stalk of the ideal sheaf of a fibre product -/

section Geometric

open _root_.Stacks.AlgebraicGeometry CategoryTheory.Limits

/-- **The stalk at `Δ(x)` of the ideal sheaf of the fibre product of two closed subschemes.**
Let `f : X ⟶ Y` be a morphism of schemes, `x` a point of `X`, and `I`, `J` two quasi-coherent
sheaves of ideals on `X`, cutting out closed subschemes `V`, `W`. Then the stalk at `Δ(x)` of
the ideal sheaf `pr₁^* I ⊔ pr₂^* J` cutting out `V ×_Y W` inside `X ×_Y X` is generated by the
images of the two local ideals `I_x`, `J_x` under the two local ring maps of the projections,
each transported along `pr_i(Δ(x)) = x`. -/
theorem stalk_sup_comap_diagonal_eq {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
    (I J : X.IdealSheafData) (x : X) :
    AlgebraicGeometry.IdealSheafData.stalk
        (I.comap (pullback.fst f f) ⊔ J.comap (pullback.snd f f)) (pullback.diagonal f x) =
      (AlgebraicGeometry.IdealSheafData.stalk I x).map
          (((pullback.fst f f).stalkMap (pullback.diagonal f x)).hom.comp
            (eqToHom (congrArg X.presheaf.stalk
              (pullback_fst_diagonal_apply f x).symm)).hom) ⊔
        (AlgebraicGeometry.IdealSheafData.stalk J x).map
          (((pullback.snd f f).stalkMap (pullback.diagonal f x)).hom.comp
            (eqToHom (congrArg X.presheaf.stalk
              (pullback_snd_diagonal_apply f x).symm)).hom) := by
  rw [AlgebraicGeometry.IdealSheafData.stalk_sup,
    AlgebraicGeometry.IdealSheafData.stalk_comap_eq_map_of_stalkMap I (pullback.fst f f)
      (pullback.diagonal f x) (pullback_fst_diagonal_apply f x),
    AlgebraicGeometry.IdealSheafData.stalk_comap_eq_map_of_stalkMap J (pullback.snd f f)
      (pullback.diagonal f x) (pullback_snd_diagonal_apply f x)]

end Geometric

end Stacks.Intersection.Diagonal

end
