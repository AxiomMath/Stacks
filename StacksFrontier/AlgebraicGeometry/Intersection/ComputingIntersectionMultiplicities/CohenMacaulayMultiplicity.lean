attribute [local instance] Classical.propDecidable

universe u

private lemma annihilator_le_of_linearFunctor {R : Type u} [CommRing R]
    (F : ModuleCat.{u} R ⥤ ModuleCat.{u} R) [F.Linear R] (M : ModuleCat.{u} R) :
    Module.annihilator R M ≤ Module.annihilator R (F.obj M) := by
  intro r hr
  have h : r • 𝟙 M = 0 := by
    ext m
    exact (Module.mem_annihilator.mp hr) m
  have hzero : F.map (0 : M ⟶ M) = 0 := by
    rw [← zero_smul R (𝟙 M), CategoryTheory.Functor.map_smul, zero_smul]
  have hh := congrArg F.map h
  rw [CategoryTheory.Functor.map_smul, CategoryTheory.Functor.map_id, hzero] at hh
  exact Module.mem_annihilator.mpr fun m => congrArg (fun f => (f : F.obj M ⟶ F.obj M) m) hh

private lemma sup_le_annihilator_tor {A : Type u} [CommRing A]
    (I J : Ideal A) (i : ℕ) :
    I ⊔ J ≤ Module.annihilator A
      (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A (A ⧸ I))).obj
        (ModuleCat.of A (A ⧸ J))) := by
  let := tor_linear A i
  let : ((evaluation (ModuleCat.{u} A) (ModuleCat.{u} A)).obj
      (ModuleCat.of A (A ⧸ J))).Linear A := ⟨fun _ _ => rfl⟩
  have hI := annihilator_le_of_linearFunctor
    (Tor (ModuleCat.{u} A) i ⋙ (evaluation _ _).obj (ModuleCat.of A (A ⧸ J)))
    (ModuleCat.of A (A ⧸ I))
  let := leftDerived_linear A (tensorLeft (ModuleCat.of A (A ⧸ I))) i
  have hJ := annihilator_le_of_linearFunctor
    ((tensorLeft (ModuleCat.of A (A ⧸ I))).leftDerived i) (ModuleCat.of A (A ⧸ J))
  rw [Ideal.annihilator_quotient] at hI hJ
  exact sup_le hI hJ

/-- Whether an ideal saturates a module is invariant under a linear equivalence. -/
private lemma smul_top_eq_top_congr_local
    {A : Type u} [CommRing A] (I : Ideal A)
    {M N : Type u} [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N] (e : M ≃ₗ[A] N) :
    I • (⊤ : Submodule A M) = ⊤ ↔ I • (⊤ : Submodule A N) = ⊤ := by
  rw [← Submodule.map_eq_top_iff (e := e), Submodule.map_smul'', Submodule.map_top,
    LinearEquiv.range]

private lemma depth_eq_of_linearEquiv_local
    {A : Type u} [CommRing A] (I : Ideal A)
    {M N : Type u} [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N] (e : M ≃ₗ[A] N) :
    Module.depth A I M = Module.depth A I N := by
  have hset : {rs : List A | (∀ r ∈ rs, r ∈ I) ∧ RingTheory.Sequence.IsRegular M rs} =
      {rs : List A | (∀ r ∈ rs, r ∈ I) ∧ RingTheory.Sequence.IsRegular N rs} := by
    ext rs
    simp only [Set.mem_ofPred_eq, e.isRegular_congr rs]
  simp only [Module.depth, hset, smul_top_eq_top_congr_local I e]

private lemma depth_le_depth_pi_fin
    {A : Type u} [CommRing A] [IsNoetherianRing A] (I : Ideal A)
    (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M] (n : ℕ) :
    Module.depth A I M ≤ Module.depth A I (Fin n → M) := by
  induction n with
  | zero =>
      have : Subsingleton (Fin 0 → M) := ⟨fun f g => funext fun i => i.elim0⟩
      exact le_top.trans (Module.depth_eq_top_of_subsingleton I).ge
  | succ n ih =>
      rw [← depth_eq_of_linearEquiv_local I
        (Fin.consLinearEquiv A (fun _ : Fin (n + 1) => M))]
      refine (le_min le_rfl ih).trans ?_
      exact (Module.min_depth_le_depth_of_exact I
        (f := (LinearMap.inl A M (Fin n → M)))
        (g := LinearMap.snd A M (Fin n → M)) Function.Exact.inl_snd
        (fun a b h => by simpa using congrArg Prod.fst h)
        (fun y => ⟨(0, y), rfl⟩)).1

private theorem depth_le_depth_tensor_product_of_free_finite
    {A P M : Type u} [CommRing A] [IsNoetherianRing A] (I : Ideal A)
    [AddCommGroup P] [Module A P] [Module.Free A P] [Module.Finite A P]
    [AddCommGroup M] [Module A M] [Module.Finite A M] :
    Module.depth A I M ≤ Module.depth A I (TensorProduct A P M) := by
  classical
  let : Fintype (Module.Free.ChooseBasisIndex A P) := Fintype.ofFinite _
  let b := Module.Free.chooseBasis A P
  let ι := Module.Free.ChooseBasisIndex A P
  let eFin : ι ≃ Fin (Fintype.card ι) := Fintype.equivFin ι
  let e := (TensorProduct.equivFinsuppOfBasisLeft b).trans
    ((Finsupp.linearEquivFunOnFinite A M ι).trans
      (LinearEquiv.piCongrLeft A (fun _ : Fin (Fintype.card ι) => M) eFin))
  rw [depth_eq_of_linearEquiv_local I e]
  exact depth_le_depth_pi_fin I M _

private theorem depth_quotient_eq_ringKrullDim_of_isCohenMacaulay
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (I : Ideal A) [IsNoetherianRing (A ⧸ I)] [IsLocalRing (A ⧸ I)] (hI : I ≠ ⊤)
    (hCM : IsCohenMacaulayLocalRing (A ⧸ I)) :
    (Module.depth A (IsLocalRing.maximalIdeal A) (A ⧸ I) : WithBot ℕ∞) =
      ringKrullDim (A ⧸ I) := by
  let B := A ⧸ I
  let q : A →+* B := Ideal.Quotient.mk I
  have : Nontrivial B := Ideal.Quotient.nontrivial_iff.mpr hI
  have : IsLocalRing B := IsLocalRing.of_surjective' q Ideal.Quotient.mk_surjective
  have hdepth : Module.depth A (IsLocalRing.maximalIdeal A) B =
      Module.depth B (IsLocalRing.maximalIdeal B) B := by
    rw [Stacks.CohenMacaulay.BaseFieldExtension.depth_eq_depth_map (f := q)
      Ideal.Quotient.mk_surjective
      (IsLocalRing.maximalIdeal A) (AddEquiv.refl B) (fun _ _ => rfl),
      IsLocalRing.map_maximalIdeal_of_surjective q Ideal.Quotient.mk_surjective]
  have hnot : IsLocalRing.maximalIdeal B • (⊤ : Submodule B B) ≠ ⊤ :=
    Ne.symm (Submodule.top_ne_ideal_smul_of_le_jacobson_annihilator (by
      rw [IsLocalRing.jacobson_eq_maximalIdeal _
        (Module.annihilator_eq_top_iff.not.mpr
          (not_subsingleton_iff_nontrivial.mpr (inferInstance : Nontrivial B)))]))
  have hdepthsup : Module.depth B (IsLocalRing.maximalIdeal B) B =
      Module.depthSup B (IsLocalRing.maximalIdeal B) B := by
    rw [Module.depth, ite_eq_right hnot, Module.depthSup_eq_iSup]
  have hCM' : Module.supportDim B B =
      (Module.depth B (IsLocalRing.maximalIdeal B) B : WithBot ℕ∞) := by
    rw [hdepthsup]
    exact hCM.supportDim_eq_depth
  rw [Module.supportDim_self_eq_ringKrullDim] at hCM'
  rw [hdepth]
  exact_mod_cast hCM'.symm

private noncomputable def torZero_quotientLinearEquiv
    {A : Type u} [CommRing A] (I : Ideal A)
    (M : Type u) [AddCommGroup M] [Module A M] :
    (((Tor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ I))).obj
      (ModuleCat.of A M) : Type u) ≃ₗ[A]
        M ⧸ I • (⊤ : Submodule A M) := by
  classical
  let X := ModuleCat.of A (A ⧸ I)
  let Y := ModuleCat.of A M
  change (((tensorLeft X).leftDerived 0).obj Y : Type u) ≃ₗ[A] _
  let he : ((tensorLeft X).leftDerived 0).obj Y ≅
      ModuleCat.of A (TensorProduct A (A ⧸ I) M) :=
    (Functor.leftDerivedZeroIsoSelf (tensorLeft X)).app Y
  exact (LinearEquiv.ofBijective he.hom.hom
      (CategoryTheory.ConcreteCategory.bijective_of_isIso he.hom)).trans
    (TensorProduct.quotTensorEquivQuotSMul M I)

private theorem module_supportDim_eq_zero_of_support_eq_maximal
    {A : Type u} [CommRing A] [IsLocalRing A]
    (M : Type u) [AddCommGroup M] [Module A M] [Nontrivial M]
    (h : ∀ q ∈ Module.support A M, q.asIdeal = IsLocalRing.maximalIdeal A) :
    Module.supportDim A M = 0 := by
  have hne : Module.supportDim A M ≠ ⊥ := Module.supportDim_ne_bot_of_nontrivial A M
  have hsub : Subsingleton (Module.support A M) :=
    ⟨fun a b => Subtype.ext (PrimeSpectrum.ext (by rw [h a.1 a.2, h b.1 b.2]))⟩
  rw [Module.supportDim] at hne ⊢
  have hnonempty : Nonempty (Module.support A M) := Order.krullDim_ne_bot_iff.mp hne
  exact Order.krullDim_eq_zero

private theorem depth_eq_zero_of_supportDim_eq_zero
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M] [Nontrivial M]
    (h : Module.supportDim A M = 0) :
    Module.depth A (IsLocalRing.maximalIdeal A) M = 0 := by
  have hle := Module.depth_le_supportDim A (IsLocalRing.maximalIdeal A) M
    (Ne.symm (Submodule.top_ne_ideal_smul_of_le_jacobson_annihilator (by
      rw [IsLocalRing.jacobson_eq_maximalIdeal _
        (Module.annihilator_eq_top_iff.not.mpr (not_subsingleton M))])))
  rw [h] at hle
  exact le_antisymm (by exact_mod_cast hle) zero_le

private theorem positive_homology_isZero_of_depth_and_supportDim
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (K : ChainComplex (ModuleCat.{u} A) ℕ)
    [∀ j, Module.Finite A (K.X j)] (e : ℕ)
    [∀ j, Module.Finite A (K.homology j)]
    (hK : ∀ j, e < j → CategoryTheory.Limits.IsZero (K.X j))
    (hdepth : ∀ j ≤ e,
      (j : ℕ∞) ≤ Module.depth A (IsLocalRing.maximalIdeal A) (K.X j))
    (hsupport : ∀ j, 0 < j → Nontrivial (K.homology j) →
      Module.supportDim A (K.homology j) = 0) :
    ∀ j, 0 < j → CategoryTheory.Limits.IsZero (K.homology j) := by
  classical
  intro j hj
  by_contra hnonzero
  let S : Finset ℕ := (Finset.range (e + 1)).filter
    (fun i => 0 < i ∧ ¬ K.ExactAt i)
  have hS : S.Nonempty := by
    refine ⟨j, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr ?_, hj, ?_⟩⟩
    · by_contra h
      have hExact : K.ExactAt j := by
        rw [HomologicalComplex.exactAt_iff_isZero_homology]
        exact (K.sc j).isZero_homology_of_isZero_X₂ (hK j (by omega))
      exact hnonzero ((HomologicalComplex.exactAt_iff_isZero_homology K j).mp hExact)
    · exact fun hExact => hnonzero ((HomologicalComplex.exactAt_iff_isZero_homology K j).mp hExact)
  let i := S.max' hS
  have hiS : i ∈ S := Finset.max'_mem S hS
  have hiPos : 0 < i := (Finset.mem_filter.mp hiS).2.1
  have hiLe : i ≤ e := by
    have := Finset.mem_range.mp (Finset.mem_filter.mp hiS).1
    omega
  have hiNot : ¬ K.ExactAt i := (Finset.mem_filter.mp hiS).2.2
  have hiGreat : IsGreatest {j : ℕ | ¬ K.ExactAt j} i := by
    refine ⟨hiNot, ?_⟩
    intro j hjNot
    by_cases hje : j ≤ e
    · by_cases hj0 : 0 < j
      · have hjS : j ∈ S := Finset.mem_filter.mpr
          ⟨Finset.mem_range.mpr (by omega), hj0, hjNot⟩
        exact Finset.le_max' S j hjS
      · omega
    · have hExact : K.ExactAt j := by
        rw [HomologicalComplex.exactAt_iff_isZero_homology]
        exact (K.sc j).isZero_homology_of_isZero_X₂ (hK j (by omega))
      exact (hjNot hExact).elim
  have hiDepth := Module.one_le_depth_homology_of_forall_le_depth_of_isGreatest_not_exactAt
    K e hK hdepth hiGreat (by omega)
  have hiNontrivial : Nontrivial (K.homology i) :=
    not_subsingleton_iff_nontrivial.mp fun hsub => hiNot
      ((HomologicalComplex.exactAt_iff_isZero_homology K i).mpr
        (ModuleCat.isZero_iff_subsingleton.mpr hsub))
  rw [depth_eq_zero_of_supportDim_eq_zero (K.homology i) (hsupport i hiPos hiNontrivial)]
    at hiDepth
  norm_num at hiDepth

private theorem tor_vanish_of_acyclic_tensor_resolution
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (I : Ideal A) (M : Type u) [AddCommGroup M] [Module A M]
    (e : ℕ) (K : ChainComplex (ModuleCat.{u} A) ℕ)
    [∀ j, Module.Finite A (K.X j)] [∀ j, Module.Finite A (K.homology j)]
    (hK : ∀ j, e < j → CategoryTheory.Limits.IsZero (K.X j))
    (hdepth : ∀ j ≤ e,
      (j : ℕ∞) ≤ Module.depth A (IsLocalRing.maximalIdeal A) (K.X j))
    (hsupport : ∀ j, 0 < j → Nontrivial (K.homology j) →
      Module.supportDim A (K.homology j) = 0)
    (hIso : ∀ j, (((Tor (ModuleCat.{u} A) j).obj (ModuleCat.of A (A ⧸ I))).obj
        (ModuleCat.of A M) : Type u) ≃ₗ[A] K.homology j) :
    ∀ j, 0 < j → Subsingleton
      (((Tor (ModuleCat.{u} A) j).obj (ModuleCat.of A (A ⧸ I))).obj
        (ModuleCat.of A M)) := by
  intro j hj
  have hzero := positive_homology_isZero_of_depth_and_supportDim
    K e hK hdepth hsupport j hj
  let eH := hIso j
  refine ⟨fun x y => eH.injective ?_⟩
  exact (ModuleCat.isZero_iff_subsingleton.mp hzero).elim (eH x) (eH y)

private noncomputable def torHomologyLinearEquiv_of_leftResolution
    {A : Type u} [CommRing A] (I : Ideal A)
    (M : Type u) [AddCommGroup M] [Module A M]
    (P : CategoryTheory.ObjectProperty.LeftResolution
      (fun N : ModuleCat.{u} A => Module.Free A N ∧ Module.Finite A N)
      (ModuleCat.of A (A ⧸ I))) (i : ℕ) :
    (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A (A ⧸ I))).obj
      (ModuleCat.of A M) : Type u) ≃ₗ[A]
    (((tensorRight (ModuleCat.of A M)).mapHomologicalComplex (ComplexShape.down ℕ)).obj
      P.complex).homology i := by
  let hP : ∀ j, Projective (P.complex.X j) := fun j => by
    let : Module.Free A (P.complex.X j) := (P.property j).1
    exact ModuleCat.projective_of_free (Module.Free.chooseBasis A (P.complex.X j : Type u))
  let Q := P.toProjectiveResolution hP
  let H := Q.isoLeftDerivedObj (tensorRight (ModuleCat.of A M)) i
  let E : (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A (A ⧸ I))).obj
      (ModuleCat.of A M)) ≅
      (((tensorRight (ModuleCat.of A M)).mapHomologicalComplex (ComplexShape.down ℕ)).obj
        P.complex).homology i :=
    (Tor_iso_Tor'.app A i (ModuleCat.of A (A ⧸ I))).app (ModuleCat.of A M) |>.trans H
  exact LinearEquiv.ofBijective E.hom.hom
    (CategoryTheory.ConcreteCategory.bijective_of_isIso E.hom)

private noncomputable def quotientQuotientEquivSup
    {A : Type u} [CommRing A] (I J : Ideal A) :
    ((A ⧸ J) ⧸ I • (⊤ : Submodule A (A ⧸ J))) ≃ₗ[A] A ⧸ (I ⊔ J) := by
  have hmap : Submodule.map (Submodule.mkQ (J : Submodule A A)) I =
      I • (⊤ : Submodule A (A ⧸ J)) := by
    calc
      Submodule.map (Submodule.mkQ (J : Submodule A A)) I =
          Submodule.map (Submodule.mkQ J) (I • (⊤ : Submodule A A)) := by
            congr 1
            ext x
            simp
      _ = I • Submodule.map (Submodule.mkQ J) (⊤ : Submodule A A) :=
            Submodule.map_smul'' I _ _
      _ = I • (⊤ : Submodule A (A ⧸ J)) := by simp [Submodule.range_mkQ]
  let e₀ := Submodule.quotientQuotientEquivQuotientSup
    (J : Submodule A A) (I : Submodule A A)
  have hsup : (J : Submodule A A) ⊔ (I : Submodule A A) =
      (I : Submodule A A) ⊔ (J : Submodule A A) := sup_comm _ _
  exact (Submodule.quotEquivOfEq _ _ hmap.symm).trans
    (e₀.trans (Submodule.quotEquivOfEq _ _ hsup))

private lemma exists_nat_ringKrullDim (A : Type u) [CommRing A]
    [IsNoetherianRing A] [IsLocalRing A] :
    ∃ n : ℕ, ringKrullDim A = (n : WithBot ℕ∞) := by
  have hbot := ringKrullDim_ne_bot (R := A)
  have htop := ringKrullDim_ne_top (R := A)
  generalize ringKrullDim A = d at hbot htop ⊢
  lift d to ℕ∞ using hbot
  have hd : d ≠ ⊤ := by exact_mod_cast htop
  lift d to ℕ using hd
  exact ⟨d, rfl⟩

/-- The depth over `A` of a Cohen-Macaulay quotient `A ⧸ I` is its Krull dimension. -/
private lemma depth_quotient_eq_of_isCohenMacaulay {A : Type u} [CommRing A]
    [IsNoetherianRing A] [IsLocalRing A] (I : Ideal A) [IsLocalRing (A ⧸ I)]
    (hI : IsCohenMacaulayLocalRing (A ⧸ I)) {b : ℕ} (hb : ringKrullDim (A ⧸ I) = b) :
    Module.depth A (IsLocalRing.maximalIdeal A) (A ⧸ I) = (b : ℕ∞) :=
  mod_cast (depth_quotient_eq_ringKrullDim_of_isCohenMacaulay I
    (Ideal.Quotient.nontrivial_iff.mp inferInstance) hI).trans hb

/-- If the maximal ideal is the radical of `I ⊔ J`, then `I ⊔ J` is proper. -/
private lemma sup_ne_top_of_radical_eq_maximalIdeal {A : Type u} [CommRing A] [IsLocalRing A]
    {I J : Ideal A} (hrad : (I ⊔ J).radical = IsLocalRing.maximalIdeal A) : I ⊔ J ≠ ⊤ := by
  intro h
  rw [h, Ideal.radical_top] at hrad
  exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top hrad.symm

/-- A nontrivial module killed by `I ⊔ J`, whose radical is the maximal ideal, has support
dimension zero. -/
private lemma supportDim_eq_zero_of_sup_le_annihilator {A : Type u} [CommRing A] [IsLocalRing A]
    {I J : Ideal A} (hrad : (I ⊔ J).radical = IsLocalRing.maximalIdeal A)
    (M : Type u) [AddCommGroup M] [Module A M] [Nontrivial M]
    (h : I ⊔ J ≤ Module.annihilator A M) : Module.supportDim A M = 0 := by
  refine module_supportDim_eq_zero_of_support_eq_maximal M fun q hq => ?_
  exact le_antisymm (IsLocalRing.le_maximalIdeal q.isPrime.ne_top)
    (hrad ▸ q.isPrime.radical_le_iff.mpr (h.trans (Module.annihilator_le_of_mem_support hq)))

private lemma tor_quotient_isZero_of_isCohenMacaulay
    {A : Type u} [CommRing A] [IsRegularLocalRing A]
    (I J : Ideal A) [IsLocalRing (A ⧸ I)] [IsLocalRing (A ⧸ J)]
    (hI : IsCohenMacaulayLocalRing (A ⧸ I))
    (hJ : IsCohenMacaulayLocalRing (A ⧸ J))
    (hdim : ringKrullDim A ≤ ringKrullDim (A ⧸ I) + ringKrullDim (A ⧸ J))
    (hrad : (I ⊔ J).radical = IsLocalRing.maximalIdeal A) :
    ∀ j, 0 < j → Subsingleton
      (((Tor (ModuleCat.{u} A) j).obj (ModuleCat.of A (A ⧸ I))).obj
        (ModuleCat.of A (A ⧸ J))) := by
  obtain ⟨d, hd⟩ := exists_nat_ringKrullDim A
  obtain ⟨b, hb⟩ := exists_nat_ringKrullDim (A ⧸ I)
  obtain ⟨c, hc⟩ := exists_nat_ringKrullDim (A ⧸ J)
  have hdb := depth_quotient_eq_of_isCohenMacaulay I hI hb
  have hdc := depth_quotient_eq_of_isCohenMacaulay J hJ hc
  have hle : d - b ≤ c := by
    rw [hd, hb, hc] at hdim
    have h : d ≤ b + c := by exact_mod_cast hdim
    omega
  obtain ⟨P, hP⟩ :=
    (IsRegularLocalRing.exists_leftResolution_free_finite_and_hasProjectiveDimensionLE hd.le).1
      (ModuleCat.of A (A ⧸ I)) b hdb.ge
  let K := ((tensorRight (ModuleCat.of A (A ⧸ J))).mapHomologicalComplex
    (ComplexShape.down ℕ)).obj P.complex
  let (j : ℕ) : Module.Free A (P.complex.X j) := (P.property j).1
  let (j : ℕ) : Module.Finite A (P.complex.X j) := (P.property j).2
  let (j : ℕ) : Module.Finite A (K.X j) := by
    change Module.Finite A (TensorProduct A (P.complex.X j) (A ⧸ J))
    infer_instance
  let (j : ℕ) : Module.Finite A (K.homology j) := homology_finite_of_term_finite K j
  apply tor_vanish_of_acyclic_tensor_resolution I (A ⧸ J) (d - b) K
  · intro j hj
    exact (tensorRight (ModuleCat.of A (A ⧸ J))).map_isZero (hP j hj)
  · intro j hj
    refine (show (j : ℕ∞) ≤ (c : ℕ∞) by exact_mod_cast hj.trans hle).trans ?_
    rw [← hdc]
    exact depth_le_depth_tensor_product_of_free_finite (P := P.complex.X j)
      (IsLocalRing.maximalIdeal A)
  · intro j _ hnontrivial
    let := hnontrivial
    exact supportDim_eq_zero_of_sup_le_annihilator hrad _ ((sup_le_annihilator_tor I J j).trans
      (torHomologyLinearEquiv_of_leftResolution I (A ⧸ J) P j).annihilator_eq.le)
  · exact torHomologyLinearEquiv_of_leftResolution I (A ⧸ J) P

private lemma depth_le_length_of_complex
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (K : ChainComplex (ModuleCat.{u} A) ℕ) [∀ j, Module.Finite A (K.X j)]
    [∀ j, Module.Finite A (K.homology j)] [Nontrivial (K.homology 0)]
    (e c : ℕ) (hK : ∀ j, e < j → CategoryTheory.Limits.IsZero (K.X j))
    (hdepth : ∀ j, (c : ℕ∞) ≤ Module.depth A (IsLocalRing.maximalIdeal A) (K.X j))
    (hpos : ∀ j, 0 < j → CategoryTheory.Limits.IsZero (K.homology j))
    (hdim : Module.supportDim A (K.homology 0) = 0) : c ≤ e := by
  by_contra hle
  let E := ComplexShape.embeddingDown'Add (1 : ℕ) 1
  let L := K.extend E
  have hL0 : CategoryTheory.Limits.IsZero (L.X 0) := K.isZero_extend_X E 0 (by simp [E])
  let eX (j : ℕ) : L.X (j + 1) ≅ K.X j := K.extendXIso E rfl
  let eH (j : ℕ) : L.homology (j + 1) ≅ K.homology j := K.extendHomologyIso E rfl
  let (j : ℕ) : Module.Finite A (L.X j) := by
    cases j with
    | zero =>
      let := ModuleCat.isZero_iff_subsingleton.mp hL0
      infer_instance
    | succ j => exact Module.Finite.equiv (eX j).toLinearEquiv.symm
  have hgreat : IsGreatest {j : ℕ | ¬ L.ExactAt j} 1 := by
    refine ⟨?_, ?_⟩
    · change ¬ L.ExactAt 1
      rw [HomologicalComplex.exactAt_iff_isZero_homology]
      intro h
      exact not_subsingleton (K.homology 0)
        (ModuleCat.isZero_iff_subsingleton.mp (h.of_iso (eH 0).symm))
    · intro j hj
      by_contra hj1
      obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : j ≠ 0)
      exact hj ((HomologicalComplex.exactAt_iff_isZero_homology L (n+1)).mpr
        ((hpos n (by omega)).of_iso (eH n)))
  have h := Module.one_le_depth_homology_of_forall_le_depth_of_isGreatest_not_exactAt
    L (e + 1) (fun j hj => by
      obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : j ≠ 0)
      exact (hK n (by omega)).of_iso (eX n))
    (fun j hj => by
      cases j with
      | zero => exact zero_le
      | succ j =>
        exact ((show (j + 1 : ℕ∞) ≤ (c : ℕ∞) by
            exact_mod_cast (by omega : j + 1 ≤ c)).trans (hdepth j)).trans
          (depth_eq_of_linearEquiv_local (IsLocalRing.maximalIdeal A)
            (eX j).toLinearEquiv).symm.le) hgreat (by omega)
  change 1 ≤ Module.depth A (IsLocalRing.maximalIdeal A) ↑(L.homology (0 + 1)) at h
  rw [depth_eq_of_linearEquiv_local (IsLocalRing.maximalIdeal A) (eH 0).toLinearEquiv,
    depth_eq_zero_of_supportDim_eq_zero (K.homology 0) hdim] at h
  norm_num at h

private lemma ringKrullDim_eq_add_of_isCohenMacaulay
    {A : Type u} [CommRing A] [IsRegularLocalRing A]
    (I J : Ideal A) [IsLocalRing (A ⧸ I)] [IsLocalRing (A ⧸ J)]
    (hI : IsCohenMacaulayLocalRing (A ⧸ I))
    (hJ : IsCohenMacaulayLocalRing (A ⧸ J))
    (hdim : ringKrullDim A ≤ ringKrullDim (A ⧸ I) + ringKrullDim (A ⧸ J))
    (hrad : (I ⊔ J).radical = IsLocalRing.maximalIdeal A) :
    ringKrullDim A = ringKrullDim (A ⧸ I) + ringKrullDim (A ⧸ J) := by
  obtain ⟨d, hd⟩ := exists_nat_ringKrullDim A
  obtain ⟨b, hb⟩ := exists_nat_ringKrullDim (A ⧸ I)
  obtain ⟨c, hc⟩ := exists_nat_ringKrullDim (A ⧸ J)
  have hdb := depth_quotient_eq_of_isCohenMacaulay I hI hb
  have hdc := depth_quotient_eq_of_isCohenMacaulay J hJ hc
  obtain ⟨P, hP⟩ :=
    (IsRegularLocalRing.exists_leftResolution_free_finite_and_hasProjectiveDimensionLE hd.le).1
      (ModuleCat.of A (A ⧸ I)) b hdb.ge
  let K := ((tensorRight (ModuleCat.of A (A ⧸ J))).mapHomologicalComplex
    (ComplexShape.down ℕ)).obj P.complex
  let (j : ℕ) : Module.Free A (P.complex.X j) := (P.property j).1
  let (j : ℕ) : Module.Finite A (P.complex.X j) := (P.property j).2
  let (j : ℕ) : Module.Finite A (K.X j) := by
    change Module.Finite A (TensorProduct A (P.complex.X j) (A ⧸ J))
    infer_instance
  let (j : ℕ) : Module.Finite A (K.homology j) := homology_finite_of_term_finite K j
  let E (j : ℕ) := torHomologyLinearEquiv_of_leftResolution I (A ⧸ J) P j
  let : Nontrivial (A ⧸ (I ⊔ J)) :=
    Ideal.Quotient.nontrivial_iff.mpr (sup_ne_top_of_radical_eq_maximalIdeal hrad)
  let e0 := (E 0).symm.trans ((torZero_quotientLinearEquiv I (A ⧸ J)).trans
    (quotientQuotientEquivSup I J))
  let : Nontrivial (K.homology 0) := e0.toEquiv.nontrivial
  have hpos : ∀ j, 0 < j → CategoryTheory.Limits.IsZero (K.homology j) := by
    intro j hj
    let := tor_quotient_isZero_of_isCohenMacaulay I J hI hJ hdim hrad j hj
    exact ModuleCat.isZero_iff_subsingleton.mpr (E j).symm.injective.subsingleton
  have hdim0 : Module.supportDim A (K.homology 0) = 0 := by
    exact supportDim_eq_zero_of_sup_le_annihilator hrad _
      ((sup_le_annihilator_tor I J 0).trans (E 0).annihilator_eq.le)
  have hcd := depth_le_length_of_complex K (d - b) c
    (fun j hj => (tensorRight (ModuleCat.of A (A ⧸ J))).map_isZero (hP j hj))
    (fun j => hdc ▸ depth_le_depth_tensor_product_of_free_finite
      (P := P.complex.X j) (IsLocalRing.maximalIdeal A)) hpos hdim0
  have hbd : b ≤ d := by
    have := ringKrullDim_quotient_le I
    rw [hd, hb] at this
    exact_mod_cast this
  rw [hd, hb, hc] at hdim ⊢
  have hdbc : d ≤ b + c := by exact_mod_cast hdim
  exact_mod_cast (by omega : d = b + c)

private theorem localIntersectionMultiplicity_eq_length_of_tor_vanish
    {A : Type u} [CommRing A] (I : Ideal A)
    (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M]
    (hTor : ∀ i : ℕ, 0 < i → Subsingleton
      (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A (A ⧸ I))).obj
        (ModuleCat.of A M))) :
    Ideal.localIntersectionMultiplicity I M =
      ((Module.length A (M ⧸ I • (⊤ : Submodule A M))).toNat : ℚ) := by
  classical
  rw [Ideal.localIntersectionMultiplicity, tsum_eq_single 0]
  · rw [← (torZero_quotientLinearEquiv I M).length_eq]
    simp
  · intro i hi
    rw [Module.length_eq_zero_iff.mpr (hTor i (Nat.pos_of_ne_zero hi))]
    simp

/-- An ideal of a Noetherian local ring whose quotient has Krull dimension zero has the maximal
ideal as its radical: the quotient is zero dimensional exactly when it is an ideal of
definition. -/
@[ega "IV 21.13.12.1" "partial", ega "IV 6.1.3" "partial"]
private lemma radical_eq_maximalIdeal_of_ringKrullDim_quotient_eq_zero
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A] (K : Ideal A)
    (h0 : ringKrullDim (A ⧸ K) = 0) : K.radical = IsLocalRing.maximalIdeal A := by
  have hsmul : K • (⊤ : Submodule A A) = (K : Submodule A A) := by simp
  let e : (A ⧸ (K • (⊤ : Submodule A A))) ≃ₗ[A] A ⧸ K := Submodule.quotEquivOfEq _ _ hsmul
  have hdim : Module.supportDim A (A ⧸ (K • (⊤ : Submodule A A))) = 0 := by
    rwa [Module.supportDim_eq_of_equiv e, Module.supportDim_quotient_eq_ringKrullDim]
  have hMI : Nontrivial (A ⧸ (K • (⊤ : Submodule A A))) :=
    (Module.supportDim_ne_bot_iff_nontrivial A _).mp (by rw [hdim]; norm_num)
  have hdef := ((Ideal.idealOfDefinition_support_length_tfae (R := A) (M := A) K hMI).out 4 1).mp
    (le_of_eq hdim)
  rw [isIdealOfDefinition_iff] at hdef
  simpa [Module.annihilator_eq_bot.mpr (inferInstance : FaithfulSMul A A)] using hdef

/-- The quotient of a regular local ring by a proper ideal generated by a regular sequence is a
Cohen-Macaulay local ring: a regular local ring is Cohen-Macaulay and cutting by a regular
sequence in the maximal ideal preserves that. -/
private lemma isCohenMacaulayLocalRing_quotient_span_range
    {A : Type u} [CommRing A] [IsRegularLocalRing A] {c : ℕ} (f : Fin c → A) (I : Ideal A)
    (hf : RingTheory.Sequence.IsRegular A (List.ofFn f))
    (hI : I = Ideal.span (Set.range f)) (hItop : I ≠ ⊤)
    [IsLocalRing (A ⧸ I)] : IsCohenMacaulayLocalRing (A ⧸ I) := by
  have hmem : ∀ x ∈ List.ofFn f, x ∈ IsLocalRing.maximalIdeal A := by
    intro x hx
    obtain ⟨i, rfl⟩ : ∃ i, f i = x := by simpa using hx
    exact IsLocalRing.le_maximalIdeal hItop (hI ▸ Ideal.subset_span ⟨i, rfl⟩)
  have hofl : Ideal.ofList (List.ofFn f) = I := by rw [Ideal.ofList_ofFn, hI]
  have key := exists_isLocalRing_and_isCohenMacaulayLocalRing_quotient_ofList
    (IsRegularLocalRing.isCohenMacaulayLocalRing A) (List.ofFn f) hmem hf
  rw [hofl] at key
  obtain ⟨_, hCM⟩ := key
  exact hCM

end Stacks.Intersection.CohenMacaulayMultiplicity

namespace Ideal

open Stacks.Intersection.CohenMacaulayMultiplicity

universe u

/-- **Stacks 0B02, the vanishing of the higher Tor modules.** Let `A` be a regular local ring and
let `I`, `J` be ideals such that `A ⧸ I` and `A ⧸ J` are Cohen-Macaulay local rings, such that
`dim A ≤ dim (A ⧸ I) + dim (A ⧸ J)`, and such that `I ⊔ J` has the maximal ideal of `A` as its
radical. Then `Tor_i^A(A ⧸ I, A ⧸ J) = 0` for every `i > 0`. Geometrically, for `A` the local ring
of a nonsingular variety `X` at the generic point `ξ` of an irreducible component of `V ∩ W` and
`I`, `J` the local ideals of two closed subvarieties intersecting properly with `𝒪_{V, ξ}` and
`𝒪_{W, ξ}` Cohen-Macaulay, only `Tor_0` contributes to `e(X, V · W, Z)`. -/
public theorem tor_subsingleton_of_isCohenMacaulayLocalRing {A : Type u} [CommRing A]
    [IsRegularLocalRing A] (I J : Ideal A) [IsLocalRing (A ⧸ I)] [IsLocalRing (A ⧸ J)]
    (hI : IsCohenMacaulayLocalRing (A ⧸ I)) (hJ : IsCohenMacaulayLocalRing (A ⧸ J))
    (hproper : ringKrullDim A ≤ ringKrullDim (A ⧸ I) + ringKrullDim (A ⧸ J))
    (hcomponent : (I ⊔ J).radical = IsLocalRing.maximalIdeal A) (i : ℕ) (hi : 0 < i) :
    Subsingleton (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A (A ⧸ I))).obj
      (ModuleCat.of A (A ⧸ J))) :=
  tor_quotient_isZero_of_isCohenMacaulay I J hI hJ hproper hcomponent i hi

/-- **The Tor-formula multiplicity when the higher Tor modules vanish.** For ideals `I`, `J` of a
commutative ring `A` with `Tor_i^A(A ⧸ I, A ⧸ J) = 0` for every `i > 0`, the alternating sum
defining the intersection multiplicity reduces to its degree zero term, the length of
`A ⧸ I ⊗_A A ⧸ J = A ⧸ (I ⊔ J)`. No regularity, Cohen-Macaulay or dimension hypothesis is
needed; this is the computation behind Tag 0B02 once the higher Tor modules are known to vanish,
whatever the reason they do. -/
public theorem localIntersectionMultiplicity_eq_length_quotient_sup_of_tor_subsingleton
    {A : Type u} [CommRing A] (I J : Ideal A)
    (hTor : ∀ i : ℕ, 0 < i → Subsingleton
      (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A (A ⧸ I))).obj
        (ModuleCat.of A (A ⧸ J)))) :
    I.localIntersectionMultiplicity (A ⧸ J) =
      ((Module.length A (A ⧸ (I ⊔ J))).toNat : ℚ) := by
  rw [localIntersectionMultiplicity_eq_length_of_tor_vanish I (A ⧸ J) hTor,
    (quotientQuotientEquivSup I J).length_eq]

/-- **Stacks 0B02.** Let `A` be a regular local ring and let `I`, `J` be ideals such that `A ⧸ I`
and `A ⧸ J` are Cohen-Macaulay local rings, such that `dim A ≤ dim (A ⧸ I) + dim (A ⧸ J)`, and
such that `I ⊔ J` has the maximal ideal of `A` as its radical. Then the intersection multiplicity
of the pair computed by the Tor formula is the length of `A ⧸ (I ⊔ J)`.

Geometrically: let `X` be a nonsingular variety and `W`, `V ⊂ X` closed subvarieties which
intersect properly, let `Z` be an irreducible component of `V ∩ W` with generic point `ξ`, and
assume `𝒪_{W, ξ}` and `𝒪_{V, ξ}` are Cohen-Macaulay. Then
`e(X, V · W, Z) = length_{𝒪_{X, ξ}}(𝒪_{V ∩ W, ξ})`, where `V ∩ W` is the scheme-theoretic
intersection. Here `A = 𝒪_{X, ξ}`, `I` and `J` cut out `V` and `W`, the dimension inequality is
proper intersection, the radical condition says `ξ` is the generic point of a component of
`V ∩ W`, and `A ⧸ (I ⊔ J) = 𝒪_{V ∩ W, ξ}`.

This is the multiplicity formula of Tag 0B02 on its own, in local form at the generic point: the
dimension inequality is the proper intersection of Tag 0B1I and the radical condition says that
`ξ` is the generic point of a component of `V ∩ W`. The tag is registered on the statement of
both of its clauses, where this formula is read at the stalks of a regular scheme and joined to
the source's final `In particular` clause,
`AlgebraicGeometry.TorFormula.cohenMacaulayIntersectionFormula`. -/
public theorem localIntersectionMultiplicity_eq_length_of_isCohenMacaulayLocalRing
    {A : Type u} [CommRing A] [IsRegularLocalRing A] (I J : Ideal A)
    [IsLocalRing (A ⧸ I)] [IsLocalRing (A ⧸ J)]
    (hI : IsCohenMacaulayLocalRing (A ⧸ I)) (hJ : IsCohenMacaulayLocalRing (A ⧸ J))
    (hproper : ringKrullDim A ≤ ringKrullDim (A ⧸ I) + ringKrullDim (A ⧸ J))
    (hcomponent : (I ⊔ J).radical = IsLocalRing.maximalIdeal A) :
    I.localIntersectionMultiplicity (A ⧸ J) =
      ((Module.length A (A ⧸ (I ⊔ J))).toNat : ℚ) :=
  localIntersectionMultiplicity_eq_length_quotient_sup_of_tor_subsingleton I J
    (tor_quotient_isZero_of_isCohenMacaulay I J hI hJ hproper hcomponent)

/-- The length appearing in `Stacks 0B02` is finite: if `I ⊔ J` has the maximal ideal of the
Noetherian local ring `A` as its radical, then `A ⧸ (I ⊔ J)` has finite length. This is what makes
the conversion of that length from `ℕ∞` to `ℕ` in the multiplicity formula faithful. -/
public theorem length_quotient_sup_ne_top_of_radical_eq_maximalIdeal {A : Type u} [CommRing A]
    [IsNoetherianRing A] [IsLocalRing A] (I J : Ideal A)
    (hcomponent : (I ⊔ J).radical = IsLocalRing.maximalIdeal A) :
    Module.length A (A ⧸ (I ⊔ J)) ≠ ⊤ := by
  have hne := sup_ne_top_of_radical_eq_maximalIdeal hcomponent
  have hsmul : (I ⊔ J) • (⊤ : Submodule A A) = ((I ⊔ J : Ideal A) : Submodule A A) := by simp
  have hnt : Nontrivial (A ⧸ (I ⊔ J)) := Ideal.Quotient.nontrivial_iff.mpr hne
  let e : (A ⧸ ((I ⊔ J) • (⊤ : Submodule A A))) ≃ₗ[A] A ⧸ (I ⊔ J) :=
    Submodule.quotEquivOfEq _ _ hsmul
  have hMI : Nontrivial (A ⧸ ((I ⊔ J) • (⊤ : Submodule A A))) := e.toEquiv.nontrivial
  have hdim : Module.supportDim A (A ⧸ ((I ⊔ J) • (⊤ : Submodule A A))) = 0 := by
    refine supportDim_eq_zero_of_sup_le_annihilator hcomponent _ ?_
    rw [e.annihilator_eq, Ideal.annihilator_quotient]
  have hlt : Module.length A (A ⧸ ((I ⊔ J) • (⊤ : Submodule A A))) < ⊤ :=
    ((Ideal.idealOfDefinition_support_length_tfae (R := A) (M := A) (I ⊔ J) hMI).out 4 5).mp
      (le_of_eq hdim)
  rw [← e.length_eq]
  exact hlt.ne

/-- **Stacks 0B02, the dimension equality.** Under the hypotheses of
`Ideal.localIntersectionMultiplicity_eq_length_of_isCohenMacaulayLocalRing` the dimension
inequality expressing proper intersection is in fact an equality,
`dim A = dim (A ⧸ I) + dim (A ⧸ J)`. Geometrically this says that the component `Z` has exactly
the expected dimension `dim V + dim W - dim X`. -/
public theorem ringKrullDim_eq_add_of_isCohenMacaulayLocalRing {A : Type u} [CommRing A]
    [IsRegularLocalRing A] (I J : Ideal A) [IsLocalRing (A ⧸ I)] [IsLocalRing (A ⧸ J)]
    (hI : IsCohenMacaulayLocalRing (A ⧸ I)) (hJ : IsCohenMacaulayLocalRing (A ⧸ J))
    (hproper : ringKrullDim A ≤ ringKrullDim (A ⧸ I) + ringKrullDim (A ⧸ J))
    (hcomponent : (I ⊔ J).radical = IsLocalRing.maximalIdeal A) :
    ringKrullDim A = ringKrullDim (A ⧸ I) + ringKrullDim (A ⧸ J) :=
  ringKrullDim_eq_add_of_isCohenMacaulay I J hI hJ hproper hcomponent

/-- **Stacks 0B06.** In the situation of Tag 0B04 — `A` a regular local ring, `I` generated by a
regular sequence `f₁, …, f_c`, `J` an ideal with `dim (A ⧸ (I ⊔ J)) = 0` and
`dim A ≤ dim (A ⧸ I) + dim (A ⧸ J)` — assume moreover that `A ⧸ J` is Cohen-Macaulay. Then the
Tor-formula intersection multiplicity of the pair is the single length
`length_A ((A ⧸ J) ⧸ (f₁, …, f_c)(A ⧸ J))`, with no Hilbert polynomial left over.

Geometrically, for `A = 𝒪_{X, ξ}` at the generic point `ξ` of an irreducible component `Z` of
`V ∩ W` and `I`, `J` the local ideals of two closed subvarieties intersecting properly with `V`
cut out at `ξ` by the regular sequence, this says
`e(X, V · W, Z) = length_{𝒪_{X, ξ}}(𝒪_{W, ξ} / f₁𝒪_{W, ξ} + … + f_c𝒪_{W, ξ})` as soon as
`𝒪_{W, ξ}` is Cohen-Macaulay. -/
@[stacks 0B06 "the multiplicity formula when the local ring of the second subvariety is \
Cohen-Macaulay, in local form at the generic point: for `I` generated by a regular sequence of \
length `c` in the regular local ring `A` and `A ⧸ J` Cohen-Macaulay, the Tor-formula \
multiplicity of the pair is `length_A ((A ⧸ J) ⧸ I (A ⧸ J))`. The source's hypotheses are those \
of Tag 0B04, transported to `A = 𝒪_{X, ξ}` exactly as there, with proper intersection the \
dimension inequality of Tag 0B1I and `ξ` being the generic point of a component of `V ∩ W` the \
vanishing of `dim (A ⧸ (I ⊔ J))`."]
public theorem localIntersectionMultiplicity_eq_length_quotient_smul_of_isCohenMacaulayLocalRing
    {A : Type u} [CommRing A] [IsRegularLocalRing A] {c : ℕ} (f : Fin c → A) (I J : Ideal A)
    [IsLocalRing (A ⧸ J)] (hJ : IsCohenMacaulayLocalRing (A ⧸ J))
    (hf : RingTheory.Sequence.IsRegular A (List.ofFn f))
    (hI : I = Ideal.span (Set.range f))
    (h0 : ringKrullDim (A ⧸ (I ⊔ J)) = 0)
    (hproper : ringKrullDim A ≤ ringKrullDim (A ⧸ I) + ringKrullDim (A ⧸ J)) :
    I.localIntersectionMultiplicity (A ⧸ J) =
      ((Module.length A ((A ⧸ J) ⧸ I • (⊤ : Submodule A (A ⧸ J)))).toNat : ℚ) := by
  have hne : Nontrivial (A ⧸ (I ⊔ J)) := by
    refine (Module.supportDim_ne_bot_iff_nontrivial A _).mp ?_
    rw [Module.supportDim_quotient_eq_ringKrullDim, h0]
    norm_num
  have hIJtop : I ⊔ J ≠ ⊤ := Ideal.Quotient.nontrivial_iff.mp hne
  have hItop : I ≠ ⊤ := fun h => hIJtop (top_le_iff.mp (h ▸ le_sup_left))
  have : Nontrivial (A ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hItop
  have : IsLocalRing (A ⧸ I) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  have hrad : (I ⊔ J).radical = IsLocalRing.maximalIdeal A :=
    radical_eq_maximalIdeal_of_ringKrullDim_quotient_eq_zero (I ⊔ J) h0
  rw [localIntersectionMultiplicity_eq_length_of_isCohenMacaulayLocalRing I J
      (isCohenMacaulayLocalRing_quotient_span_range f I hf hI hItop) hJ hproper hrad,
    ← (quotientQuotientEquivSup I J).length_eq]

end Ideal

