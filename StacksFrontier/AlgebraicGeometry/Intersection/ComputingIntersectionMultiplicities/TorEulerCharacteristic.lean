/-!
# Multiplicity of an ideal generated by a regular sequence

Let `I` be generated by a regular sequence of length `r` in a Noetherian local ring, and let
`M` be a finite module such that the support of `M / IM` has dimension zero. The generalized
Hilbert–Samuel multiplicity of `M` in degree `r` is the Euler characteristic of the Tor groups
of `A / I` and `M`.

The proof passes to the quotient `B = A / Ann(M)`, over which the image of `I` is an ideal of
definition, so the generalized multiplicity agrees with the ordinary Hilbert–Samuel
multiplicity in degree `r`; that one is the Euler characteristic of the Koszul homology by Tag
0AZZ. The Koszul complex of a regular sequence is a projective resolution of `A / I`, which
identifies the Koszul homology with Tor.

## Main results

* `Ideal.generalizedHilbertSamuelMultiplicity_eq_alternatingSum_tor_length` is the
  multiplicity formula.

## Implementation notes

The regular sequence is indexed by `Fin r`, and its generated ideal is specified explicitly.
Tor is Mathlib's derived tensor product in `ModuleCat`. Since the sequence has length `r`, the
Euler characteristic is summed over degrees `0` through `r`. The length of each Tor group is
converted from `ℕ∞` to `ℕ` before taking the alternating sum in `ℚ`; finiteness follows from
the hypotheses.

## References

* [Stacks Project, Tag 0B03](https://stacks.math.columbia.edu/tag/0B03)
-/

@[expose] public section

open CategoryTheory Filter Polynomial
open scoped TensorProduct

namespace Ideal

universe u

/-- The generalized Hilbert–Samuel multiplicity in degree `d` is `d !` times the coefficient
of degree `d` of any polynomial computing the generalized Hilbert function. -/
private theorem generalizedMultiplicity_eq_factorial_mul_coeff
    {R : Type*} [CommRing R] (I : Ideal R) (M : Type*) [AddCommGroup M] [Module R M]
    {P : ℚ[X]} (hP : ComputesGeneralizedHilbertPoly I M P) (d : ℕ) :
    I.generalizedHilbertSamuelMultiplicity M d = (d.factorial : ℚ) * P.coeff d := by
  classical
  have hex : ∃ Q : ℚ[X], ComputesGeneralizedHilbertPoly I M Q := ⟨P, hP⟩
  rw [Ideal.generalizedHilbertSamuelMultiplicity, dite_eq_left hex]
  congr 2
  exact ComputesGeneralizedHilbertPoly.unique hex.choose_spec hP

/-- Two ideals over possibly different rings with the same generalized Hilbert function have
the same generalized multiplicities. -/
private theorem generalizedMultiplicity_eq_of_quotientLengths
    {R S M : Type*} [CommRing R] [CommRing S]
    [AddCommGroup M] [Module R M] [Module S M]
    (I : Ideal R) (J : Ideal S) (d : ℕ)
    (hlen : ∀ n : ℕ,
      Module.length R (M ⧸ (I ^ n • (⊤ : Submodule R M))) =
        Module.length S (M ⧸ (J ^ n • (⊤ : Submodule S M))))
    (hS : ∃ P : ℚ[X], ComputesGeneralizedHilbertPoly J M P) :
    I.generalizedHilbertSamuelMultiplicity M d =
      J.generalizedHilbertSamuelMultiplicity M d := by
  obtain ⟨P, hP⟩ := hS
  rw [generalizedMultiplicity_eq_factorial_mul_coeff I M
      (hP.mono fun n ⟨p, hp, he⟩ => ⟨p, (hlen n).trans hp, he⟩) d,
    generalizedMultiplicity_eq_factorial_mul_coeff J M hP d]

/-- A backward unit shift does not change the coefficient of a polynomial in any degree at
least its own degree. -/
private lemma coeff_translate_eq_of_degree_le (P : ℚ[X]) (d : ℕ)
    (hP : P.degree ≤ (d : WithBot ℕ)) :
    (P.comp (Polynomial.X - Polynomial.C (1 : ℚ))).coeff d = P.coeff d := by
  have hc : (P.comp (Polynomial.X - Polynomial.C (1 : ℚ))).degree = P.degree := by
    rw [Polynomial.degree_comp (by rw [Polynomial.degree_X_sub_C]; norm_num),
      Polynomial.degree_X_sub_C, mul_one]
  have hlead : ∀ Q : ℚ[X], Q.degree = (d : WithBot ℕ) → Q.coeff d = Q.leadingCoeff := fun Q h => by
    rw [← Polynomial.natDegree_eq_of_degree_eq_some h]
    exact Polynomial.coeff_natDegree
  by_cases hdeg : P.degree = (d : WithBot ℕ)
  · rw [hlead _ (hc.trans hdeg), hlead P hdeg,
      Polynomial.leadingCoeff_comp
        (by rw [Polynomial.natDegree_X_sub_C]; exact one_ne_zero),
      (Polynomial.monic_X_sub_C (1 : ℚ)).leadingCoeff, one_pow, mul_one]
  · have hlt : P.degree < (d : WithBot ℕ) := lt_of_le_of_ne hP hdeg
    rw [Polynomial.coeff_eq_zero_of_degree_lt (hc.trans_lt hlt),
      Polynomial.coeff_eq_zero_of_degree_lt hlt]

/-- Shifting a polynomial computing the Hilbert–Samuel function back by one makes it compute
the generalized Hilbert function. -/
private lemma computesGeneralized_comp_X_sub_one
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] {I : Ideal R} {Q : ℚ[X]}
    (hQ : ComputesHilbertSamuelPoly I M Q) :
    ComputesGeneralizedHilbertPoly I M (Q.comp (Polynomial.X - Polynomial.C (1 : ℚ))) := by
  obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp hQ
  filter_upwards [Filter.eventually_ge_atTop (N + 1)] with n hn
  have hn1 : 1 ≤ n := by omega
  obtain ⟨p, hp, hpe⟩ := hN (n - 1) (by omega)
  refine ⟨p, by rwa [← Nat.sub_add_cancel hn1], ?_⟩
  have heval : (Q.comp (Polynomial.X - Polynomial.C (1 : ℚ))).eval (n : ℚ) =
      Q.eval ((n - 1 : ℕ) : ℚ) := by
    simp [Nat.cast_sub hn1]
  rw [heval, hpe]

/-- In a degree at least the Hilbert–Samuel degree, the generalized multiplicity of an ideal
of definition agrees with the ordinary Hilbert–Samuel multiplicity: the two computing
polynomials differ by a unit shift, which does not change that coefficient. -/
private theorem generalizedMultiplicity_eq_hilbertSamuelMultiplicity_of_degree_le
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (d : ℕ) (hI : IsIdealOfDefinition I) (hd : I.hilbertSamuelDegree M ≤ d) :
    I.generalizedHilbertSamuelMultiplicity M d = I.hilbertSamuelMultiplicity M d := by
  obtain ⟨Q, hQ⟩ := exists_computesHilbertSamuelPoly I hI M
  have hDegreeQ : Q.degree ≤ (d : WithBot ℕ) :=
    (hilbertSamuelDegree_eq_degree_of_computes hQ) ▸ hd
  rw [generalizedMultiplicity_eq_factorial_mul_coeff I M
      (computesGeneralized_comp_X_sub_one hQ) d,
    hilbertSamuelMultiplicity_eq_factorial_mul_coeff I M hQ d,
    coeff_translate_eq_of_degree_le Q d hDegreeQ]

/-- The lengths of Tor and of the Koszul homology agree. -/
private theorem torLength_eq_koszulLength {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (hf : RingTheory.Sequence.IsRegular A (List.ofFn f))
    (I : Ideal A) (hI : I = Ideal.span (Set.range f)) (M : Type u)
    [AddCommGroup M] [Module A M] (i : ℕ) :
    Module.length A (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A (A ⧸ I))).obj
      (ModuleCat.of A M)) =
      Module.length A ((Koszul.seqComplexTensor f M).homology i) :=
  (Koszul.torIsoHomologySeqComplexTensorOfIsRegular f hf I hI M i).toLinearEquiv.length_eq

/-- An ideal annihilating `M` annihilates every tensor product with `M`. -/
private theorem annihilator_smul_tensor_eq_bot
    {A M P : Type*} [CommRing A] [AddCommGroup M] [Module A M]
    [AddCommGroup P] [Module A P] (K : Ideal A)
    (hK : K ≤ Module.annihilator A M) :
    K • (⊤ : Submodule A (P ⊗[A] M)) = ⊥ := by
  refine le_antisymm (Submodule.smul_le.2 fun a ha x _ => ?_) bot_le
  have hkill : ∀ y : P ⊗[A] M, a • y = 0 := by
    intro y
    induction y using TensorProduct.induction_on with
    | zero => simp
    | add u v hu hv => simp [hu, hv]
    | tmul p m =>
      calc
        a • (p ⊗ₜ[A] m) = p ⊗ₜ[A] (a • m) := TensorProduct.smul_tmul a p m
        _ = 0 := by simp [Module.mem_annihilator.mp (hK ha) m]
  exact hkill x

/-- Base change along `A ↠ A / K` is the identity on a module that `K` annihilates. -/
private noncomputable def quotientBaseChangeModuleEquiv
    {A : Type*} [CommRing A] (K : Ideal A) (X : Type*)
    [AddCommGroup X] [Module A X]
    (hK : K • (⊤ : Submodule A X) = ⊥) : (A ⧸ K) ⊗[A] X ≃ₗ[A] X :=
  (TensorProduct.quotTensorEquivQuotSMul X K).trans
    (Submodule.quotEquivOfEqBot (K • (⊤ : Submodule A X)) hK)

/-- That identification is natural in the module. -/
private lemma quotientBaseChangeModuleEquiv_naturality
    {A : Type*} [CommRing A] (K : Ideal A)
    {X Y : Type*} [AddCommGroup X] [Module A X]
    [AddCommGroup Y] [Module A Y] (f : X →ₗ[A] Y)
    (hX : K • (⊤ : Submodule A X) = ⊥) (hY : K • (⊤ : Submodule A Y) = ⊥) :
    (quotientBaseChangeModuleEquiv K Y hY).toLinearMap ∘ₗ LinearMap.lTensor (A ⧸ K) f =
      f ∘ₗ (quotientBaseChangeModuleEquiv K X hX).toLinearMap := by
  apply TensorProduct.ext
  ext x
  simp [quotientBaseChangeModuleEquiv]

/-- The same naturality, applied to an element and written with `LinearMap.baseChange`. -/
private lemma quotientBaseChangeModuleEquiv_baseChange_naturality
    {A : Type*} [CommRing A] (K : Ideal A)
    {X Y : Type*} [AddCommGroup X] [Module A X]
    [AddCommGroup Y] [Module A Y] (f : X →ₗ[A] Y)
    (hX : K • (⊤ : Submodule A X) = ⊥) (hY : K • (⊤ : Submodule A Y) = ⊥)
    (z : (A ⧸ K) ⊗[A] X) :
    quotientBaseChangeModuleEquiv K Y hY (LinearMap.baseChange (A ⧸ K) f z) =
      f (quotientBaseChangeModuleEquiv K X hX z) := by
  simpa [LinearMap.baseChange_eq_ltensor] using
    LinearMap.congr_fun (quotientBaseChangeModuleEquiv_naturality K f hX hY) z

/-- The Koszul homology of `f` on a module annihilated by `K` may be computed over `A / K`,
for the image of `f`: base change along `A ↠ A / K` is the identity on such a module. -/
private theorem koszul_homology_length_quotient
    {A M : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    [AddCommGroup M] [Module A M] (K : Ideal A)
    [Module (A ⧸ K) M] [IsScalarTower A (A ⧸ K) M]
    (hK : K ≤ Module.annihilator A M) (i : ℕ) :
    Module.length A ((Koszul.seqComplexTensor f M).homology i) =
      Module.length (A ⧸ K)
        ((Koszul.seqComplexTensor (fun j => Ideal.Quotient.mk K (f j)) M).homology i) := by
  classical
  let B := A ⧸ K
  let : TensorProduct.CompatibleSMul A B B M :=
    TensorProduct.CompatibleSMul.of_algebraMap_surjective B M Ideal.Quotient.mk_surjective
  let eM : B ⊗[A] M ≃ₗ[B] M := TensorProduct.lidOfCompatibleSMul A B M
  let C := Koszul.seqComplexTensor f M
  let Cq := Koszul.seqComplexTensor (fun j => Ideal.Quotient.mk K (f j)) M
  let F := ModuleCat.restrictScalars (Ideal.Quotient.mk K)
  let D := (F.mapHomologicalComplex (ComplexShape.down ℕ)).obj Cq
  let : F.PreservesHomology := Functor.preservesHomologyOfExact F
  obtain ⟨eBase, heBase⟩ := KoszulC.koszulComplex_baseChange_chainComm (S := B) f M
  let eCoeff : ∀ n,
      (Cq.X n : Type u) ≃ₗ[B]
        ((Koszul.seqComplexTensor (fun j => Ideal.Quotient.mk K (f j))
          (B ⊗[A] M)).X n) := fun n => (eM.symm.lTensor (⋀[B]^n (Fin r → B)))
  have hkill : ∀ n, K • (⊤ : Submodule A ((⋀[A]^n (Fin r → A)) ⊗[A] M)) = ⊥ := fun n =>
    annihilator_smul_tensor_eq_bot K hK
  let qEquiv : ∀ n, (B ⊗[A] (C.X n : Type u)) ≃ₗ[A] (C.X n : Type u) := fun n =>
    quotientBaseChangeModuleEquiv K _ (hkill n)
  let eForward : ∀ n, (D.X n : Type u) ≃ₗ[A] (C.X n : Type u) := fun n => by
    let : Module A (Cq.X n) := Module.compHom (Cq.X n) (Ideal.Quotient.mk K)
    let : Module A ((KoszulC.koszulComplexBaseChange (S := B) f M).X n) :=
      Module.compHom _ (Ideal.Quotient.mk K)
    let : Module A ((Koszul.seqComplexTensor (fun j => Ideal.Quotient.mk K (f j))
        (B ⊗[A] M)).X n) := Module.compHom _ (Ideal.Quotient.mk K)
    let : IsScalarTower A B (Cq.X n) := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    let : IsScalarTower A B ((KoszulC.koszulComplexBaseChange (S := B) f M).X n) :=
      IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    let : IsScalarTower A B ((Koszul.seqComplexTensor (fun j => Ideal.Quotient.mk K (f j))
        (B ⊗[A] M)).X n) := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    change (Cq.X n : Type u) ≃ₗ[A] (C.X n : Type u)
    exact ((eCoeff n).restrictScalars A).trans ((eBase n).restrictScalars A) |>.trans (qEquiv n)
  have hCoeff : ∀ n m (x : Cq.X n),
      eCoeff m ((Cq.d n m).hom x) =
        ((Koszul.seqComplexTensor (fun j => Ideal.Quotient.mk K (f j))
          (B ⊗[A] M)).d n m).hom (eCoeff n x) := by
    intro n m x
    by_cases hnm : m + 1 = n
    · subst n
      rw [Koszul.seqComplexTensor_d, Koszul.seqComplexTensor_d]
      have he : (eM.symm.lTensor (⋀[B]^m (Fin r → B))).toLinearMap ∘ₗ
          (Koszul.d (Koszul.seqDual (fun j => Ideal.Quotient.mk K (f j))) m).rTensor M =
        (Koszul.d (Koszul.seqDual (fun j => Ideal.Quotient.mk K (f j))) m).rTensor
          (B ⊗[A] M) ∘ₗ
          (eM.symm.lTensor (⋀[B]^(m + 1) (Fin r → B))).toLinearMap := by
        apply TensorProduct.ext
        ext a b
        rfl
      exact LinearMap.congr_fun he x
    · rw [(Cq).shape n m hnm,
        (Koszul.seqComplexTensor (fun j => Ideal.Quotient.mk K (f j))
          (B ⊗[A] M)).shape n m hnm]
      exact (eCoeff m).toLinearMap.map_zero
  have hForward : ∀ n m (x : D.X n),
      eForward m ((D.d n m).hom x) = (C.d n m).hom (eForward n x) := by
    intro n m x
    change (Cq.X n : Type u) at x
    calc
      qEquiv m (eBase m (eCoeff m ((Cq.d n m).hom x))) =
          qEquiv m (((KoszulC.koszulComplexBaseChange (S := B) f M).d n m).hom
            (eBase n (eCoeff n x))) :=
        congrArg (qEquiv m) ((congrArg (eBase m) (hCoeff n m x)).trans (heBase n m (eCoeff n x)))
      _ = (C.d n m).hom (qEquiv n (eBase n (eCoeff n x))) := by
        rw [KoszulC.koszulComplexBaseChange_d_hom]
        exact quotientBaseChangeModuleEquiv_baseChange_naturality K
          ((C.d n m).hom) (hkill n) (hkill m) (eBase n (eCoeff n x))
  obtain ⟨eH⟩ := KoszulC.homologyTransport_of_degreewiseEquiv eForward hForward i
  calc
    Module.length A (C.homology i) = Module.length A (D.homology i) := eH.symm.length_eq
    _ = Module.length A (F.obj (Cq.homology i)) :=
      ((Cq.sc i).mapHomologyIso F).toLinearEquiv.length_eq
    _ = Module.length B (Cq.homology i) :=
      length_restrictScalars_eq_of_surjective A B (Ideal.Quotient.mk K)
        Ideal.Quotient.mk_surjective (Cq.homology i)

/-- The generalized multiplicity of an ideal generated by a regular sequence equals the
alternating sum of the lengths of the Tor groups of `A / I` and `M`. -/
@[stacks 0B03]
theorem generalizedHilbertSamuelMultiplicity_eq_alternatingSum_tor_length
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (I : Ideal A) (r : ℕ) (f : Fin r → A) (M : Type u)
    [AddCommGroup M] [Module A M] [Module.Finite A M]
    (hf : RingTheory.Sequence.IsRegular A (List.ofFn f))
    (hI : I = Ideal.span (Set.range f))
    (hM : Module.supportDim A (M ⧸ I • (⊤ : Submodule A M)) = 0) :
    I.generalizedHilbertSamuelMultiplicity M r =
      ∑ i : Fin (r + 1), (-1 : ℚ) ^ (i : ℕ) *
        ((Module.length A
          (((Tor (ModuleCat.{u} A) (i : ℕ)).obj (ModuleCat.of A (A ⧸ I))).obj
            (ModuleCat.of A M))).toNat : ℚ) := by
  classical
  have hNnt : Nontrivial (M ⧸ I • (⊤ : Submodule A M)) :=
    (Module.supportDim_ne_bot_iff_nontrivial A _).mp (by simp [hM])
  have : Nontrivial M := (I • (⊤ : Submodule A M)).mkQ_surjective.nontrivial
  let K : Ideal A := Module.annihilator A M
  let B : Type u := A ⧸ K
  let : Module B M := Module.quotientAnnihilator
  have : Nontrivial B := Ideal.Quotient.nontrivial_iff.mpr
    (mt Module.annihilator_eq_top_iff.mp (not_subsingleton M))
  have : IsLocalRing B :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk K) Ideal.Quotient.mk_surjective
  have : Module.Finite B M := Module.Finite.of_restrictScalars_finite A B M
  let J : Ideal B := Ideal.map (Ideal.Quotient.mk K) I
  have hJ : IsIdealOfDefinition J :=
    ((idealOfDefinition_support_length_tfae I hNnt).out 4 2).mp hM.le
  have hspan : J = Ideal.span (Set.range (fun i : Fin r => Ideal.Quotient.mk K (f i))) := by
    dsimp only [J]
    rw [hI, Ideal.map_span, ← Set.range_comp, Function.comp_def]
  have hlen (n : ℕ) : Module.length A (M ⧸ (I ^ n • (⊤ : Submodule A M))) =
      Module.length B (M ⧸ (J ^ n • (⊤ : Submodule B M))) :=
    (Submodule.quotEquivOfEq _ _
      (map_quotientAnnihilator_pow_smul_top (R := A) (M := M) I n).symm).length_eq.trans
      (length_restrictScalars_eq_of_surjective A B (Ideal.Quotient.mk K)
        Ideal.Quotient.mk_surjective (M ⧸ (J ^ n • (⊤ : Submodule B M))))
  obtain ⟨QJ, hQJ⟩ := exists_computesHilbertSamuelPoly J hJ M
  have hdeg : J.hilbertSamuelDegree M ≤ r := by
    have hrad : J.radical = IsLocalRing.maximalIdeal B := hJ
    have hm := (IsLocalRing.maximalIdeal.isMaximal B).isPrime.radical
    obtain ⟨Qm, hQm⟩ := exists_computesHilbertSamuelPoly (IsLocalRing.maximalIdeal B) hm M
    have hne : J ≠ ⊤ := fun htop =>
      (IsLocalRing.maximalIdeal.isMaximal B).ne_top (by rw [← hrad, htop, Ideal.radical_top])
    have hspanFin : J.spanFinrank ≤ r := by
      rw [hspan]
      let g : Fin r → B := fun i => Ideal.Quotient.mk K (f i)
      have henc : (Set.range g).encard ≤ (r : ℕ∞) := by
        rw [← Set.image_univ]
        exact (Set.encard_image_le g Set.univ).trans (by simp)
      exact_mod_cast (Submodule.spanFinrank_span_le_encard (Set.range g)).trans henc
    have hdimB : ringKrullDim B ≤ (r : WithBot ℕ∞) := by
      calc
        ringKrullDim B = ((IsLocalRing.maximalIdeal B).height : WithBot ℕ∞) :=
          IsLocalRing.maximalIdeal_height_eq_ringKrullDim.symm
        _ = ((J.height : ℕ∞) : WithBot ℕ∞) := by
          rw [← hrad, Ideal.height_eq_inf_minimalPrimes, Ideal.height_eq_inf_minimalPrimes,
            Ideal.radical_minimalPrimes]
        _ ≤ (r : WithBot ℕ∞) := by
          exact_mod_cast
            (Ideal.height_le_spanFinrank J hne).trans (ENat.natCast_le_natCast.mpr hspanFin)
    have hmapped : (J.hilbertSamuelDegree M).map (Nat.cast : ℕ → ℕ∞) ≤ (r : WithBot ℕ∞) := by
      calc
        (J.hilbertSamuelDegree M).map (Nat.cast : ℕ → ℕ∞) =
            (Module.hilbertSamuelDegree B M).map (Nat.cast : ℕ → ℕ∞) := by
          rw [hilbertSamuelDegree_eq_degree_of_computes hQJ,
            show Module.hilbertSamuelDegree B M =
              (IsLocalRing.maximalIdeal B).hilbertSamuelDegree M from rfl,
            hilbertSamuelDegree_eq_degree_of_computes hQm]
          obtain ⟨_, _, hdegree⟩ :=
            Ideal.exists_degree_eq_of_eventually_eval_eq_length_quotient_smul_pow (R := B) M
          rw [(hdegree J hrad QJ).2 hQJ, (hdegree _ hm _).2 hQm]
        _ = Module.supportDim B M := Module.hilbertSamuelDegree_eq_supportDim B M
        _ ≤ (r : WithBot ℕ∞) := (Module.supportDim_le_ringKrullDim B M).trans hdimB
    exact (WithBot.map_le_iff Nat.cast ENat.natCast_le_natCast).mp hmapped
  have hterm (i : Fin (r + 1)) :
      Module.length A (((Tor (ModuleCat.{u} A) (i : ℕ)).obj
        (ModuleCat.of A (A ⧸ I))).obj (ModuleCat.of A M)) =
        Module.length B ((Koszul.seqComplexTensor
          (fun j => Ideal.Quotient.mk K (f j)) M).homology (i : ℕ)) :=
    (torLength_eq_koszulLength f hf I hI M i).trans (koszul_homology_length_quotient f K le_rfl i)
  rw [generalizedMultiplicity_eq_of_quotientLengths I J r hlen
      ⟨_, computesGeneralized_comp_X_sub_one hQJ⟩,
