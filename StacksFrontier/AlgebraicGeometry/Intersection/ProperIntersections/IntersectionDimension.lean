/-!
# Dimension of the components of an intersection in a nonsingular variety

Let `X` be a nonsingular variety over an algebraically closed field and let `V, W ⊆ X` be closed
subvarieties of dimensions `r` and `s`. Then every irreducible component of `V ∩ W` has dimension
at least `r + s - dim X`.

## Main results

* `Stacks.Intersection.spanFinrank_ker_stalkMap_diagonal_le`: the ideal cutting out the diagonal
  of a nonsingular variety needs at most `dim X` generators at every point.
* `Stacks.Intersection.spanFinrank_ker_stalkMap_pullback_diagonal_le`: the same bound for the
  base change of the diagonal along any morphism into `X ×ₖ X`.
* `Stacks.Intersection.add_topologicalKrullDim_le_add_topologicalKrullDim_of_irreducibleComponent`:
  the dimension bound for every irreducible component of the intersection.

## Implementation notes

Closed subvarieties are recorded as ideal sheaves whose associated subscheme is integral, so that
`V ∩ W` is the underlying set `I.support ∩ J.support` and the two dimensions are those of
`I.subscheme` and `J.subscheme`. Dimensions are `topologicalKrullDim`, valued in `WithBot ℕ∞`,
which has no subtraction; the source's `dim Z ≥ r + s - dim X` is therefore written additively as
`r + s ≤ dim X + dim Z`, as elsewhere.

The argument is the source's reduction to the diagonal. Scheme theoretically `V ∩ W` is the fibre
product of `V ×ₖ W ⟶ X ×ₖ X` with the diagonal `Δ : X ⟶ X ×ₖ X`, so the dimension bound for a
preimage under a regular immersion applies with `V ×ₖ W` in place of the ambient variety; its
dimension is `r + s` because the dimension of a product is the sum of the dimensions.

What the bound consumes is a count of the equations cutting out the base change of `Δ`, point by
point. That count is produced here directly rather than from the rank of the conormal sheaf of
`Δ`: a regular immersion carries no codimension as part of its data, and nothing in this library
relates the rank of the conormal sheaf to the number of local equations. Instead, at a point of
the diagonal both local rings are regular — `X` is nonsingular and `X ×ₖ X` is then smooth over
the field, hence regular — and the kernel of a surjection between regular local rings is
generated by the difference of their dimensions, which the dimension formula for a variety and
the dimension of a product identify with `dim X`. The transport of that count along a base change
is `AlgebraicGeometry.ker_stalkMap_pullback_fst`, which computes the stalk kernel of a
base-changed closed immersion as the ideal generated by the image of the original.

## References

* [Stacks Project, Tag 0AZP](https://stacks.math.columbia.edu/tag/0AZP)
* [Stacks Project, Tag 0AZN](https://stacks.math.columbia.edu/tag/0AZN)
* [Stacks Project, Tag 0B0Q](https://stacks.math.columbia.edu/tag/0B0Q)
* [Stacks Project, Tag 00NR](https://stacks.math.columbia.edu/tag/00NR)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace
open AlgebraicGeometry

namespace Stacks.Intersection

universe u

variable {k : Type u} [Field k]

/-- A closed immersion induces an isomorphism on residue fields, so it preserves their
transcendence degree over the base field. Alias of `trdeg_residueField_of_isClosedImmersion`. -/
private alias trdeg_residueField_of_isClosedImmersion' := trdeg_residueField_of_isClosedImmersion

/-- Every irreducible component of a space is carried to an irreducible component by a
homeomorphism. -/
private theorem image_mem_irreducibleComponents {A B : Type*} [TopologicalSpace A]
    [TopologicalSpace B] (e : A ≃ₜ B) {Z : Set A} (hZ : Z ∈ irreducibleComponents A) :
    e '' Z ∈ irreducibleComponents B := by
  change Maximal IsIrreducible Z at hZ
  show Maximal IsIrreducible (e '' Z)
  refine ⟨hZ.1.image e e.continuous.continuousOn, fun T hT hsub y hy => ?_⟩
  have hZsub : Z ⊆ e.symm '' T := fun a ha => ⟨e a, hsub ⟨a, ha, rfl⟩, by simp⟩
  exact ⟨e.symm y, hZ.2 (hT.image e.symm e.symm.continuous.continuousOn) hZsub
    ⟨y, hy, rfl⟩, by simp⟩

/-- **The diagonal of a nonsingular variety is cut out by `dim X` equations at every point.**
Let `X` be a nonsingular variety of dimension `n` over a perfect field, let `x` be a point of `X`
and let `R` be a ring identified with the local ring of `X ×ₖ X` at `Δ(x)`. Then the kernel of
the induced surjection onto the local ring of `X` at `x` is generated by `n` elements: both local
rings are regular, so the kernel of the surjection between them is generated by the difference
of their dimensions, which the dimension formula identifies with `dim X`. -/
theorem spanFinrank_ker_comp_stalkMap_diagonal_le [PerfectField k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsVariety k f] (hX : IsRegular X) (n : ℕ)
    (hdim : topologicalKrullDim X = (n : WithBot ℕ∞)) (x : X) (R : CommRingCat.{u})
    (e : R ⟶ (pullback f f : Scheme.{u}).presheaf.stalk (pullback.diagonal f x)) [IsIso e] :
    (RingHom.ker (e ≫ (pullback.diagonal f).stalkMap x).hom).spanFinrank ≤ n := by
  classical
  let ee : R ≃+* ((pullback f f : Scheme.{u}).presheaf.stalk (pullback.diagonal f x)) :=
    (asIso e).commRingCatIsoToRingEquiv
  have heesurj : Function.Surjective (CommRingCat.Hom.hom e) :=
    fun b => ⟨ee.symm b, ee.apply_symm_apply b⟩
  have hdiag : IsClosedImmersion (pullback.diagonal f) := inferInstance
  -- Both local rings are regular.
  have hQreg : IsRegular (pullback f f : Scheme.{u}) := isRegular_pullback_of_isRegular f f hX hX
  have hQstalk : IsRegularLocalRing
      ((pullback f f : Scheme.{u}).presheaf.stalk (pullback.diagonal f x)) :=
    ((isRegular_iff_regular_stalks (pullback f f : Scheme.{u})).mp hQreg).2 _
  have hRreg : IsRegularLocalRing R := IsRegularLocalRing.of_ringEquiv ee.symm
  have hXstalk : IsRegularLocalRing (X.presheaf.stalk x) :=
    ((isRegular_iff_regular_stalks X).mp hX).2 x
  have hsurj : Function.Surjective (e ≫ (pullback.diagonal f).stalkMap x).hom :=
    ((pullback.diagonal f).stalkMap_surjective x).comp heesurj
  have hquotreg :
      IsRegularLocalRing (R ⧸ RingHom.ker (e ≫ (pullback.diagonal f).stalkMap x).hom) :=
    IsRegularLocalRing.of_ringEquiv (RingHom.quotientKerEquivOfSurjective hsurj).symm
  -- Stacks 00NR: the kernel is generated by `c` elements with `dim (R/I) + c = dim R`.
  obtain ⟨xs, -, -, c, -, hcI, hcdim⟩ :=
    IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq
      (RingHom.ker (e ≫ (pullback.diagonal f).stalkMap x).hom) hquotreg
  have hspan : (RingHom.ker (e ≫ (pullback.diagonal f).stalkMap x).hom).spanFinrank ≤ c := by
    rw [← hcI]
    exact (Stacks.RegularLocalRing.QuasiRegular.spanFinrank_ofList_le _).trans
      (by simp [List.length_take])
  rw [ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hsurj),
    ringKrullDim_eq_of_ringEquiv ee] at hcdim
  -- The dimension computation forces `c = n`.
  have hfin : LocallyOfFiniteType (pullback.diagonal f ≫ (pullback.fst f f ≫ f)) := by
    rw [← Category.assoc, pullback.diagonal_fst, Category.id_comp]; infer_instance
  let : Algebra k (X.residueField x) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ (pullback.diagonal f ≫ (pullback.fst f f ≫ f)).appTop ≫
      X.Γevaluation x).hom.toAlgebra
  let : Algebra k ((pullback f f : Scheme.{u}).residueField (pullback.diagonal f x)) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ (pullback.fst f f ≫ f).appTop ≫
      (pullback f f : Scheme.{u}).Γevaluation (pullback.diagonal f x)).hom.toAlgebra
  have htr : Algebra.trdeg k
        ((pullback f f : Scheme.{u}).residueField (pullback.diagonal f x)) =
      Algebra.trdeg k (X.residueField x) :=
    trdeg_residueField_of_isClosedImmersion' (pullback.fst f f ≫ f) (pullback.diagonal f) x
  have hQform := topologicalKrullDimAt_eq_trdeg_add_krullDim_stalk k
    (pullback f f : Scheme.{u}) (pullback.fst f f ≫ f) (pullback.diagonal f x)
  have hXform := topologicalKrullDimAt_eq_trdeg_add_krullDim_stalk k X
    (pullback.diagonal f ≫ (pullback.fst f f ≫ f)) x
  have hXn : topologicalKrullDimAt X x = (n : WithBot ℕ∞) := by
    rw [← topologicalKrullDim_eq_topologicalKrullDimAt_of_irreducible k X
      (pullback.diagonal f ≫ (pullback.fst f f ≫ f)) x, hdim]
  have hzfst : (pullback.fst f f) (pullback.diagonal f x) = x :=
    congr($(pullback.diagonal_fst f) x)
  have hzsnd : (pullback.snd f f) (pullback.diagonal f x) = x :=
    congr($(pullback.diagonal_snd f) x)
  have key : (n : WithBot ℕ∞) + (c : WithBot ℕ∞) = (n : WithBot ℕ∞) + (n : WithBot ℕ∞) := by
    calc (n : WithBot ℕ∞) + (c : WithBot ℕ∞)
        = ((Cardinal.toENat (Algebra.trdeg k (X.residueField x)) : WithBot ℕ∞) +
            ringKrullDim (X.presheaf.stalk x)) + (c : WithBot ℕ∞) := by rw [← hXform, hXn]
      _ = (Cardinal.toENat (Algebra.trdeg k (X.residueField x)) : WithBot ℕ∞) +
            (ringKrullDim (X.presheaf.stalk x) + (c : WithBot ℕ∞)) := add_assoc _ _ _
      _ = (Cardinal.toENat (Algebra.trdeg k
              ((pullback f f : Scheme.{u}).residueField (pullback.diagonal f x))) :
            WithBot ℕ∞) +
            ringKrullDim ((pullback f f : Scheme.{u}).presheaf.stalk
              (pullback.diagonal f x)) := by rw [htr, hcdim]
      _ = topologicalKrullDimAt (pullback f f : Scheme.{u}) (pullback.diagonal f x) :=
            hQform.symm
      _ = (n : WithBot ℕ∞) + (n : WithBot ℕ∞) := by
            rw [topologicalKrullDimAt_pullback k f f (pullback.diagonal f x), hzfst, hzsnd, hXn]
  have hcn : c = n := by
    have h : ((n + c : ℕ) : WithBot ℕ∞) = ((n + n : ℕ) : WithBot ℕ∞) := by push_cast; exact key
    have h' : n + c = n + n := by exact_mod_cast h
    omega
  exact hspan.trans hcn.le

/-- **The diagonal of a nonsingular variety is cut out by `dim X` equations at every point.**
The ideal cutting the diagonal out of `X ×ₖ X` needs at most `dim X` generators in the local ring
at every point of the diagonal. -/
theorem spanFinrank_ker_stalkMap_diagonal_le [PerfectField k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsVariety k f] (hX : IsRegular X) (n : ℕ)
    (hdim : topologicalKrullDim X = (n : WithBot ℕ∞)) (x : X) :
    (RingHom.ker ((pullback.diagonal f).stalkMap x).hom).spanFinrank ≤ n := by
  have h := spanFinrank_ker_comp_stalkMap_diagonal_le f hX n hdim x _ (𝟙 _)
  rwa [Category.id_comp] at h

/-- **The base change of the diagonal is cut out by `dim X` equations at every point.** For any
morphism `g : P ⟶ X ×ₖ X` out of a scheme `P`, the first projection of `P ×_{X ×ₖ X} X` is cut
out of `P` by at most `dim X` equations in the local ring at every point. -/
theorem spanFinrank_ker_stalkMap_pullback_diagonal_le [PerfectField k] {X P : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsVariety k f] (hX : IsRegular X) (n : ℕ)
    (hdim : topologicalKrullDim X = (n : WithBot ℕ∞))
    (g : P ⟶ (pullback f f : Scheme.{u})) (t : ↑(pullback g (pullback.diagonal f))) :
    (RingHom.ker ((pullback.fst g (pullback.diagonal f)).stalkMap t).hom).spanFinrank ≤ n := by
  let : IsClosedImmersion (pullback.diagonal f) := inferInstance
  have hNoeth : IsLocallyNoetherian (pullback f f : Scheme.{u}) :=
    LocallyOfFiniteType.isLocallyNoetherian (pullback.fst f f ≫ f)
  rw [ker_stalkMap_pullback_fst g (pullback.diagonal f) t]
  refine le_trans (Ideal.spanFinrank_map_le_of_fg _ (IsNoetherian.noetherian _)) ?_
  exact spanFinrank_ker_comp_stalkMap_diagonal_le f hX n hdim _ _ _

/-- **Stacks Project, Tag 0AZP.** Let `X` be a nonsingular variety over an algebraically closed
field and let `V, W ⊆ X` be closed subvarieties of dimensions `r` and `s`. Then every irreducible
component `Z` of `V ∩ W` satisfies `r + s ≤ dim X + dim Z`, that is, has dimension at least
`r + s - dim X`. -/
@[stacks 0AZP]
theorem add_topologicalKrullDim_le_add_topologicalKrullDim_of_irreducibleComponent
    [IsAlgClosed k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsVariety k f] (hX : IsRegular X)
    (I J : X.IdealSheafData) [IsIntegral I.subscheme] [IsIntegral J.subscheme]
    (Z : Set ↥((I.support : Set X) ∩ (J.support : Set X)))
    (hZ : Z ∈ irreducibleComponents ↥((I.support : Set X) ∩ (J.support : Set X))) :
    topologicalKrullDim I.subscheme + topologicalKrullDim J.subscheme ≤
      topologicalKrullDim X + topologicalKrullDim Z := by
  classical
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq_natCast f
  -- the two subvarieties and their product
  set iV : I.subscheme ⟶ X := I.subschemeι with hiV
  set iW : J.subscheme ⟶ X := J.subschemeι with hiW
  set fV : I.subscheme ⟶ Spec (.of k) := iV ≫ f with hfV
  set fW : J.subscheme ⟶ Spec (.of k) := iW ≫ f with hfW
  have hVvar : IsVariety k fV := ⟨⟩
  have hWvar : IsVariety k fW := ⟨⟩
  set g : (pullback fV fW : Scheme.{u}) ⟶ (pullback f f : Scheme.{u}) :=
    pullback.map fV fW f f iV iW (𝟙 _) (Category.comp_id _) (Category.comp_id _) with hg
  -- the scheme-theoretic intersection, as the base change of the diagonal
  set T := (pullback g (pullback.diagonal f) : Scheme.{u}) with hT
  have hsquare : IsPullback
      (pullback.map iV iW fV fW (𝟙 _) (𝟙 _) f (Category.id_comp _).symm (Category.id_comp _).symm)
      (pullback.fst iV iW ≫ iV) g (pullback.diagonal f) :=
    (pullback_map_diagonal_isPullback iV iW f).flip
  let eT : (pullback iV iW : Scheme.{u}) ≅ T := hsquare.isoPullback
  -- the underlying space of the intersection
  have hrange : Set.range (pullback.fst iV iW ≫ iV) =
      (I.support : Set X) ∩ (J.support : Set X) := by
    rw [Scheme.Pullback.range_fst_comp iV iW, hiV, hiW,
      Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.range_subschemeι]
  let eSet : (pullback iV iW : Scheme.{u}) ≃ₜ
      ↥((I.support : Set X) ∩ (J.support : Set X)) :=
    (IsClosedImmersion.isClosedEmbedding (pullback.fst iV iW ≫ iV)).isEmbedding.toHomeomorph.trans
      (Homeomorph.setCongr hrange)
  let eFull : ↥((I.support : Set X) ∩ (J.support : Set X)) ≃ₜ T :=
    eSet.symm.trans (Scheme.homeoOfIso eT)
  -- Noetherian and variety instances for the ambient product
  have hPvar : IsVariety k (pullback.fst fV fW ≫ fV) := inferInstance
  have hTfin : LocallyOfFiniteType (pullback.fst g (pullback.diagonal f) ≫
      (pullback.fst fV fW ≫ fV)) := inferInstance
  have hVcompact : CompactSpace ↥(I.subscheme) := QuasiCompact.compactSpace_of_compactSpace fV
  have hWcompact : CompactSpace ↥(J.subscheme) := QuasiCompact.compactSpace_of_compactSpace fW
  have hTnoeth : IsNoetherian T := by
    have : IsLocallyNoetherian T :=
      LocallyOfFiniteType.isLocallyNoetherian
        (pullback.fst g (pullback.diagonal f) ≫ (pullback.fst fV fW ≫ fV))
    have : CompactSpace ↥T :=
      QuasiCompact.compactSpace_of_compactSpace (pullback.fst g (pullback.diagonal f))
    exact ⟨⟩
  -- the bound of Tag 0AZN applied to the base change of the diagonal
  have hspan : ∀ t : T, (RingHom.ker
      ((pullback.fst g (pullback.diagonal f)).stalkMap t).hom).spanFinrank ≤ n :=
    fun t => spanFinrank_ker_stalkMap_pullback_diagonal_le f hX n hn g t
  have hcomp : eFull '' Z ∈ irreducibleComponents T :=
    image_mem_irreducibleComponents eFull hZ
  have hbound := topologicalKrullDim_le_topologicalKrullDim_component_add k
    (pullback.fst fV fW ≫ fV) (pullback.fst g (pullback.diagonal f)) (eFull '' Z) hcomp n hspan
  -- the dimension of the product and the dimension of the component
  rw [topologicalKrullDim_pullback k fV fW] at hbound
  have hZdim : topologicalKrullDim (eFull '' Z) = topologicalKrullDim Z :=
    (IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.image eFull Z).isHomeomorph).symm
  rw [hZdim] at hbound
  calc topologicalKrullDim I.subscheme + topologicalKrullDim J.subscheme
      ≤ topologicalKrullDim Z + (n : WithBot ℕ∞) := hbound
    _ = topologicalKrullDim X + topologicalKrullDim Z := by rw [hn, add_comm]

end Stacks.Intersection

