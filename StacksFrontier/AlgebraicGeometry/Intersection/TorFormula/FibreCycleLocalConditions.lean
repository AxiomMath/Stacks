/-!
# The local hypotheses of Tag 0B07 part (1)(a), discharged

Let `Y` be a scheme locally of finite type over the base of chapter 42, let `D ⊆ Y` be an
effective Cartier divisor and let `W = closure {x}` be the integral closed subscheme spanned by
a point `x` of delta-dimension `k + 1`. If the scheme-theoretic intersection `W ∩ D` has
delta-dimension at most `k` — which is exactly the proper-intersection hypothesis of Tag 0B07 —
then at every point `z` of `W ∩ D` of delta-dimension `k` the three local conditions of Tag
0B07 part (1)(a) hold:

* the local ring of `W` at `z` is a domain, because `W` is integral;
* the ideal of `D` at `z` is generated by a one-element regular sequence, because `D` is an
  effective Cartier divisor and `z` lies on it;
* the local ring of `W` at `z` has dimension one, because the delta-dimension drops by one from
  `x` to `z` and that drop *is* the dimension of the local ring (Tag 02JW);
* the local ring of `W ∩ D` at `z` has dimension zero, because `z` is then a generic point of an
  irreducible component of `W ∩ D`.

## Main results

* `Stacks.Chow.localConditions_integralComponentAt_of_isEffectiveCartierDivisor` — the
  conjunction of the four conditions, in the shape
  `AlgebraicGeometry.TorFormula.subschemeCycle_sup_eq_intersectionProductCycle_of_mem_support`
  consumes.
* `Stacks.Chow.localConditions_of_isEffectiveCartierDivisor` — the same for an integral closed
  subscheme `W` presented by its generic point, since `W` is the closure of that point.
* `Stacks.Chow.localConditions_ker_zeroSection` and its infinity twin — the same on
  `X ×_S ℙ¹_S` for `D` the image of a distinguished section, which is an effective Cartier
  divisor there.

## References

* [Stacks Project, Tag 0B07](https://stacks.math.columbia.edu/tag/0B07)
* [Stacks Project, Tag 02JW](https://stacks.math.columbia.edu/tag/02JW)
* [Stacks Project, Tag 02QT](https://stacks.math.columbia.edu/tag/02QT)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Chow

variable (C : ChowSituation.{u}) {Y : Scheme.{u}} (f : Y ⟶ C.S) [LocallyOfFiniteType f]

/-- The local ring of an integral closed subscheme, read as a quotient of the local ring of the
ambient scheme, is a domain. -/
theorem isDomain_quotient_idealStalk (J : Y.IdealSheafData) [IsIntegral J.subscheme] {z : Y}
    (hz : z ∈ J.support) :
    IsDomain (Y.presheaf.stalk z ⧸ IdealSheafData.stalk J z) := by
  have e := IdealSheafData.subschemeStalkQuotEquiv J (IdealSheafData.subschemePoint J z hz)
  exact e.injective.isDomain e.toRingHom

/-- The local ring of `closure {x}` at a point `z` of it has Krull dimension the drop of the
relative dimension from `x` to `z`, read as a quotient of the local ring of `Y`. -/
theorem ringKrullDim_quotient_idealStalk_integralComponentAt {x z : Y}
    (hz : z ∈ (integralComponentAt x).support) :
    ringKrullDim (Y.presheaf.stalk z ⧸ IdealSheafData.stalk (integralComponentAt x) z) =
      ((((relativeDimension C.dimensionFunction f x -
        relativeDimension C.dimensionFunction f z).toNat : ℕ) : ℕ∞) : WithBot ℕ∞) := by
  have hmem : z ∈ closure ({x} : Set Y) := by
    rw [← coe_support_integralComponentAt x]; exact hz
  have hspec : x ⤳ z := specializes_iff_mem_closure.mpr hmem
  obtain ⟨n, hdrop, hlocal⟩ := relativeDimension_drop_of_specialization
    C.isUniversallyCatenary C.dimensionFunction f hspec
  have h := ringKrullDim_quotient_idealStalk_eq (integralComponentAt x)
    (IdealSheafData.subschemePoint (integralComponentAt x) z hz)
  simp only [IdealSheafData.subschemeι_subschemePoint] at h
  refine h.trans (hlocal.trans ?_)
  rw [hdrop]
  simp

/-- **The local ring of `closure {x}` at a point of delta-dimension one less is
one-dimensional.** -/
theorem ringKrullDim_quotient_idealStalk_integralComponentAt_eq_one {x z : Y} {k : ℤ}
    (hz : z ∈ (integralComponentAt x).support)
    (hx : relativeDimension C.dimensionFunction f x = k + 1)
    (hzk : relativeDimension C.dimensionFunction f z = k) :
    ringKrullDim (Y.presheaf.stalk z ⧸ IdealSheafData.stalk (integralComponentAt x) z) = 1 := by
  rw [ringKrullDim_quotient_idealStalk_integralComponentAt C f hz, hx, hzk]
  norm_num

/-- **The local ring of a closed subscheme of delta-dimension at most `k` at a point of
delta-dimension `k` is zero-dimensional**: such a point is a generic point of an irreducible
component of the subscheme. -/
theorem ringKrullDim_quotient_idealStalk_eq_zero_of_relativeDimension_eq (J : Y.IdealSheafData)
    {k : ℤ} (hJ : schemeDeltaDimension C (J.subschemeι ≫ f) ≤ (k : EInt)) {z : Y}
    (hz : z ∈ J.support) (hzk : relativeDimension C.dimensionFunction f z = k) :
    ringKrullDim (Y.presheaf.stalk z ⧸ IdealSheafData.stalk J z) = 0 := by
  obtain ⟨V, hV⟩ := isGenericPoint_component_of_relativeDimension_eq C f J.subschemeι hJ
    (IdealSheafData.subschemePoint J z hz) hzk
  have hwgen : IdealSheafData.subschemePoint J z hz ∈ genericPoints J.subscheme := by
    show closure ({IdealSheafData.subschemePoint J z hz} : Set J.subscheme) ∈
      irreducibleComponents J.subscheme
    rw [hV]
    exact V.2
  have h := ringKrullDim_quotient_idealStalk_eq J (IdealSheafData.subschemePoint J z hz)
  simp only [IdealSheafData.subschemeι_subschemePoint] at h
  exact h.trans (ringKrullDim_stalk_eq_zero_of_mem_genericPoints ⟨_, hwgen⟩)

/-- **The ideal of an effective Cartier divisor at a point of it is generated by a one-element
regular sequence.** -/
theorem exists_regular_sequence_idealStalk_of_isEffectiveCartierDivisor (D : Y.IdealSheafData)
    (hD : Stacks.Divisors.IsEffectiveCartierDivisor D) {z : Y} (hz : z ∈ D.support) :
    ∃ g : Fin 1 → Y.presheaf.stalk z,
      RingTheory.Sequence.IsRegular (Y.presheaf.stalk z) (List.ofFn g) ∧
        IdealSheafData.stalk D z = Ideal.span (Set.range g) := by
  obtain ⟨a, ha, hDa⟩ :=
    Stacks.Divisors.exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor D hD z
  have hna : ¬ IsUnit a := fun hunit =>
    (IdealSheafData.stalk_eq_top_iff_not_mem_support D z).mp
      (hDa.trans (Ideal.span_singleton_eq_top.mpr hunit)) hz
  have ham : a ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z) :=
    (IsLocalRing.mem_maximalIdeal a).2 (by simpa [mem_nonunits_iff] using hna)
  have hweak : RingTheory.Sequence.IsWeaklyRegular (Y.presheaf.stalk z) [a] := by
    rw [RingTheory.Sequence.isWeaklyRegular_cons_iff]
    exact ⟨ha.left, RingTheory.Sequence.IsWeaklyRegular.nil _ _⟩
  refine ⟨fun _ => a, ?_, ?_⟩
  · simpa using RingTheory.Sequence.IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal
      (L := ↥(Y.presheaf.stalk z)) (rs := [a])
      (by rintro r hr; simp only [List.mem_singleton] at hr; exact hr ▸ ham) hweak
  · simpa using hDa

/-- **The local hypotheses of Stacks 0B07 part (1)(a), discharged.** Let `D ⊆ Y` be an effective
Cartier divisor and let `x` be a point of relative dimension `k + 1`, so that
`W = closure {x}` is an integral closed subscheme of delta-dimension `k + 1`. If `W ∩ D`, the
closed subscheme cut out by `integralComponentAt x ⊔ D`, has delta-dimension at most `k` — the
proper-intersection hypothesis of the tag — then at every point of `W ∩ D` of relative dimension
`k` the local ring of `W` is a one-dimensional domain, the ideal of `D` is generated by a
one-element regular sequence and the local ring of `W ∩ D` is zero-dimensional. -/
theorem localConditions_integralComponentAt_of_isEffectiveCartierDivisor (x : Y)
    (D : Y.IdealSheafData) (hD : Stacks.Divisors.IsEffectiveCartierDivisor D) {k : ℤ}
    (hx : relativeDimension C.dimensionFunction f x = k + 1)
    (hWD : schemeDeltaDimension C ((integralComponentAt x ⊔ D).subschemeι ≫ f) ≤ (k : EInt)) :
    ∀ z : Y, relativeDimension C.dimensionFunction f z = k →
      z ∈ (integralComponentAt x ⊔ D).support →
        IsDomain (Y.presheaf.stalk z ⧸ IdealSheafData.stalk (integralComponentAt x) z) ∧
        (∃ g : Fin 1 → Y.presheaf.stalk z,
          RingTheory.Sequence.IsRegular (Y.presheaf.stalk z) (List.ofFn g) ∧
            IdealSheafData.stalk D z = Ideal.span (Set.range g)) ∧
        ringKrullDim
          (Y.presheaf.stalk z ⧸ IdealSheafData.stalk (D ⊔ integralComponentAt x) z) = 0 ∧
        ringKrullDim (Y.presheaf.stalk z ⧸ IdealSheafData.stalk (integralComponentAt x) z) = 1 := by
  intro z hzk hzWD
  have hzsplit := hzWD
  rw [Scheme.IdealSheafData.support_sup] at hzsplit
  have hzW : z ∈ (integralComponentAt x).support := hzsplit.1
  have hzD : z ∈ D.support := hzsplit.2
  have : IsIntegral (integralComponentAt x).subscheme := isIntegral_integralComponentAt x
  refine ⟨isDomain_quotient_idealStalk (integralComponentAt x) hzW,
    exists_regular_sequence_idealStalk_of_isEffectiveCartierDivisor D hD hzD, ?_,
    ringKrullDim_quotient_idealStalk_integralComponentAt_eq_one C f hzW hx hzk⟩
  rw [sup_comm D (integralComponentAt x)]
  exact ringKrullDim_quotient_idealStalk_eq_zero_of_relativeDimension_eq C f
    (integralComponentAt x ⊔ D) hWD hzWD hzk

/-- **The local hypotheses of Stacks 0B07 part (1)(a) for a closed subvariety, discharged.** Let
`D ⊆ Y` be an effective Cartier divisor and let `W ⊆ Y` be an integral closed subscheme whose
generic point has delta-dimension `k + 1`, which is the source's `dim W = k + 1`. If the
scheme-theoretic intersection `W ∩ D`, cut out by `W ⊔ D`, has delta-dimension at most `k` — the
proper-intersection hypothesis of the tag — then at every point of `W ∩ D` of relative dimension
`k` the local ring of `W` is a one-dimensional domain, the ideal of `D` is generated by a
one-element regular sequence and the local ring of `W ∩ D` is zero-dimensional.

An integral closed subscheme is the closure of its generic point
(`Stacks.Chow.integralComponentAt_genericPointOf`), so this is
`Stacks.Chow.localConditions_integralComponentAt_of_isEffectiveCartierDivisor` read for `W`. -/
theorem localConditions_of_isEffectiveCartierDivisor (W D : Y.IdealSheafData)
    (hW : IsIntegral W.subscheme) (hD : Stacks.Divisors.IsEffectiveCartierDivisor D) {k : ℤ}
    (hDim : ∀ ξ : genericPoints W.subscheme,
      relativeDimension C.dimensionFunction (W.subschemeι ≫ f) ξ.1 = k + 1)
    (hWD : schemeDeltaDimension C ((W ⊔ D).subschemeι ≫ f) ≤ (k : EInt)) :
    ∀ z : Y, relativeDimension C.dimensionFunction f z = k →
      z ∈ (W ⊔ D).support →
        IsDomain (Y.presheaf.stalk z ⧸ IdealSheafData.stalk W z) ∧
        (∃ g : Fin 1 → Y.presheaf.stalk z,
          RingTheory.Sequence.IsRegular (Y.presheaf.stalk z) (List.ofFn g) ∧
            IdealSheafData.stalk D z = Ideal.span (Set.range g)) ∧
        ringKrullDim (Y.presheaf.stalk z ⧸ IdealSheafData.stalk (D ⊔ W) z) = 0 ∧
        ringKrullDim (Y.presheaf.stalk z ⧸ IdealSheafData.stalk W z) = 1 := by
  let := hW
  have hWeq : integralComponentAt (genericPointOf W hW) = W :=
    integralComponentAt_genericPointOf W hW
  have hgen : relativeDimension C.dimensionFunction f (genericPointOf W hW) = k + 1 := by
    have hmem : genericPoint W.subscheme ∈ genericPoints W.subscheme := by
      simp [genericPoints_eq_singleton]
    have h := hDim ⟨genericPoint W.subscheme, hmem⟩
    rwa [relativeDimension_comp_closedImmersion] at h
  have h := localConditions_integralComponentAt_of_isEffectiveCartierDivisor C f
    (genericPointOf W hW) D hD hgen (by rw [hWeq]; exact hWD)
  rwa [hWeq] at h

section ProjectiveLine

variable {X : Scheme.{u}} (p : X ⟶ C.S) [LocallyOfFiniteType p]
  (W : (projectiveLineProduct p).IdealSheafData)

/-- **The local hypotheses of Stacks 0B07 part (1)(a) at the zero section, discharged.** The
image of the zero section of `X ×_S ℙ¹_S` is an effective Cartier divisor
(`Stacks.Chow.isEffectiveCartierDivisor_ker_zeroSection`), so for a closed subvariety `W` of
delta-dimension `k + 1` meeting it properly the local conditions of part (1)(a) hold along the
intersection. -/
theorem localConditions_ker_zeroSection [IsIntegral W.subscheme] {k : ℤ}
    (hDim : ∀ ξ : genericPoints W.subscheme,
      relativeDimension C.dimensionFunction (familyBase p W) ξ.1 = k + 1)
    (hWD : schemeDeltaDimension C ((W ⊔ (zeroSection p).ker).subschemeι ≫
      (pullback.fst p (relativeProjectiveLine C.S ↘ C.S) ≫ p)) ≤ (k : EInt)) :
    ∀ z : projectiveLineProduct p,
      relativeDimension C.dimensionFunction
        (pullback.fst p (relativeProjectiveLine C.S ↘ C.S) ≫ p) z = k →
      z ∈ (W ⊔ (zeroSection p).ker).support →
        IsDomain ((projectiveLineProduct p).presheaf.stalk z ⧸ IdealSheafData.stalk W z) ∧
        (∃ g : Fin 1 → (projectiveLineProduct p).presheaf.stalk z,
          RingTheory.Sequence.IsRegular ((projectiveLineProduct p).presheaf.stalk z)
            (List.ofFn g) ∧
            IdealSheafData.stalk (zeroSection p).ker z = Ideal.span (Set.range g)) ∧
        ringKrullDim ((projectiveLineProduct p).presheaf.stalk z ⧸
          IdealSheafData.stalk ((zeroSection p).ker ⊔ W) z) = 0 ∧
        ringKrullDim ((projectiveLineProduct p).presheaf.stalk z ⧸
          IdealSheafData.stalk W z) = 1 :=
  localConditions_of_isEffectiveCartierDivisor C
    (pullback.fst p (relativeProjectiveLine C.S ↘ C.S) ≫ p) W (zeroSection p).ker inferInstance
    (isEffectiveCartierDivisor_ker_zeroSection p) hDim hWD

/-- **The local hypotheses of Stacks 0B07 part (1)(a) at the infinity section, discharged.** The
infinity-section twin of `Stacks.Chow.localConditions_ker_zeroSection`. -/
theorem localConditions_ker_infinitySection [IsIntegral W.subscheme] {k : ℤ}
    (hDim : ∀ ξ : genericPoints W.subscheme,
      relativeDimension C.dimensionFunction (familyBase p W) ξ.1 = k + 1)
    (hWD : schemeDeltaDimension C ((W ⊔ (infinitySection p).ker).subschemeι ≫
      (pullback.fst p (relativeProjectiveLine C.S ↘ C.S) ≫ p)) ≤ (k : EInt)) :
    ∀ z : projectiveLineProduct p,
      relativeDimension C.dimensionFunction
        (pullback.fst p (relativeProjectiveLine C.S ↘ C.S) ≫ p) z = k →
      z ∈ (W ⊔ (infinitySection p).ker).support →
        IsDomain ((projectiveLineProduct p).presheaf.stalk z ⧸ IdealSheafData.stalk W z) ∧
        (∃ g : Fin 1 → (projectiveLineProduct p).presheaf.stalk z,
          RingTheory.Sequence.IsRegular ((projectiveLineProduct p).presheaf.stalk z)
            (List.ofFn g) ∧
            IdealSheafData.stalk (infinitySection p).ker z = Ideal.span (Set.range g)) ∧
        ringKrullDim ((projectiveLineProduct p).presheaf.stalk z ⧸
          IdealSheafData.stalk ((infinitySection p).ker ⊔ W) z) = 0 ∧
        ringKrullDim ((projectiveLineProduct p).presheaf.stalk z ⧸
          IdealSheafData.stalk W z) = 1 :=
  localConditions_of_isEffectiveCartierDivisor C
    (pullback.fst p (relativeProjectiveLine C.S ↘ C.S) ≫ p) W (infinitySection p).ker
    inferInstance (isEffectiveCartierDivisor_ker_infinitySection p) hDim hWD

end ProjectiveLine

end Stacks.Chow

