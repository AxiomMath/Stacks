module

public import Mathlib.RingTheory.LocalRing.Length
public import Mathlib.RingTheory.TensorProduct.Quotient
public import StacksFrontier.AlgebraicGeometry.Intersection.RationalEquivalence.PrincipalQuotientTor
public import StacksFrontier.RingTheory.Tor.FlatExtendScalarsFirst

/-!
# The local identity behind Tag 0B60 at a point of a section

Let `σ : X → X × ℙ¹` be a section of the projection `pr` and let `y = σ x`. The local rings
`A = 𝒪_{X, x}` and `B = 𝒪_{X × ℙ¹, y}` are related by the flat local homomorphism
`pr^♯ : A → B` and its retraction `σ^♯ : B → A`, whose kernel is generated by a local equation
`t` of the image of the section. This file transports the local identity of
`StacksFrontier.AlgebraicGeometry.Intersection.RationalEquivalence.PrincipalQuotientTor` from `B` to
`A`: for ideals `I ⊆ A` and `J ⊆ B`, the lengths of `Torᵢᴬ(A ⧸ I, A ⧸ σ^♯(J))` are those of
`Torᵢᴮ(B ⧸ IB, B ⧸ (J + (t)))`. That is the flat base change of `Tor`,
`Stacks.TorFlatExtendScalars.torExtendScalarsIso`, together with the comparison of lengths along
a local homomorphism with trivial residue field extension.

## Main results

* `Stacks.Intersection.SectionLocalIdentity.length_tor_quotient_eq` — the comparison of lengths.
* `Stacks.Intersection.SectionLocalIdentity.sum_length_tor_section_eq` — the local identity behind
  Tag 0B60, read in `A`.

## References

* [Stacks Project, Tag 0B60](https://stacks.math.columbia.edu/tag/0B60)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits MonoidalCategory

universe u

namespace Stacks.Intersection.SectionLocalIdentity

open Stacks.TorFlatExtendScalars

variable {A B : Type u} [CommRing A] [CommRing B]

/-- `B ⊗_A (A ⧸ I) ≅ B ⧸ I B`, as an isomorphism in `ModuleCat B` with the extension of scalars
of Mathlib. -/
noncomputable def extendScalarsQuotientIso (ψ : A →+* B) (I : Ideal A) :
    ModuleCat.of B (B ⧸ I.map ψ) ≅
      (ModuleCat.extendScalars.{u, u, u} ψ).obj (ModuleCat.of A (A ⧸ I)) :=
  letI : Algebra A B := ψ.toAlgebra
  (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).toLinearEquiv.toModuleIso

/-- For a retraction `φ` of `ψ`, the `B`-module `B ⧸ (J ⊔ ker φ)`, read over `A` through `ψ`, is
`A ⧸ φ(J)`. -/
noncomputable def restrictQuotientIso (ψ : A →+* B) (φ : B →+* A) (h : φ.comp ψ = RingHom.id A)
    (J : Ideal B) :
    (ModuleCat.restrictScalars.{u} ψ).obj (ModuleCat.of B (B ⧸ (J ⊔ RingHom.ker φ))) ≅
      ModuleCat.of A (A ⧸ J.map φ) := by
  have hφψ : ∀ a, φ (ψ a) = a := fun a => by simpa using RingHom.congr_fun h a
  have hsurj : Function.Surjective φ := fun a => ⟨ψ a, hφψ a⟩
  let g : B ⧸ (J ⊔ RingHom.ker φ) →+* A ⧸ J.map φ :=
    Ideal.Quotient.lift (J ⊔ RingHom.ker φ) ((Ideal.Quotient.mk (J.map φ)).comp φ) (by
      intro b hb
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      rwa [← Ideal.comap_map_of_surjective' φ hsurj] at hb)
  have hg : ∀ b : B, g (Ideal.Quotient.mk _ b) = Ideal.Quotient.mk _ (φ b) := fun b => rfl
  have hbij : Function.Bijective g := by
    refine ⟨fun x y hxy => ?_, fun y => ?_⟩
    · obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨b', rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [hg, hg, Ideal.Quotient.eq] at hxy
      rw [Ideal.Quotient.eq, ← Ideal.comap_map_of_surjective' φ hsurj]
      simpa [map_sub] using hxy
    · obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨Ideal.Quotient.mk _ (ψ a), by rw [hg, hφψ]⟩
  let e := RingEquiv.ofBijective g hbij
  let e' : (ModuleCat.restrictScalars.{u} ψ).obj (ModuleCat.of B (B ⧸ (J ⊔ RingHom.ker φ))) ≃ₗ[A]
      (A ⧸ J.map φ) :=
    { toFun := fun x => e x
      invFun := fun y => e.symm y
      left_inv := fun x => e.symm_apply_apply x
      right_inv := fun y => e.apply_symm_apply y
      map_add' := fun x y => map_add e x y
      map_smul' := fun a x => by
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
        change g (Ideal.Quotient.mk (J ⊔ RingHom.ker φ) (ψ a * b)) =
          a • g (Ideal.Quotient.mk (J ⊔ RingHom.ker φ) b)
        rw [hg, hg, map_mul, hφψ, map_mul, Algebra.smul_def]
        rfl }
  exact e'.toModuleIso

/-- Elements of the kernel of a ring homomorphism of local rings lie in the maximal ideal. -/
private theorem mem_maximalIdeal_of_map_eq_zero [IsLocalRing A] [IsLocalRing B] (φ : B →+* A)
    {b : B} (hb : φ b = 0) : b ∈ IsLocalRing.maximalIdeal B := by
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  exact fun hu => by simpa [hb] using hu.map φ

section Local

variable [IsLocalRing A] [IsLocalRing B] [Algebra A B] [IsLocalHom (algebraMap A B)]

/-- If the local homomorphism `A → B` has a retraction, the residue field extension is trivial. -/
theorem length_residueField_eq_one (φ : B →+* A) (h : φ.comp (algebraMap A B) = RingHom.id A) :
    Module.length (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B) = 1 := by
  have hφψ : ∀ a, φ (algebraMap A B a) = a := fun a => by simpa using RingHom.congr_fun h a
  have hbij : Function.Bijective
      (algebraMap (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B)) := by
    refine ⟨(algebraMap (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B)).injective,
      fun y => ?_⟩
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective y
    refine ⟨IsLocalRing.residue A (φ b), ?_⟩
    rw [IsLocalRing.ResidueField.algebraMap_residue]
    refine Ideal.Quotient.eq.mpr ?_
    exact mem_maximalIdeal_of_map_eq_zero φ (by simp [hφψ])
  let e : IsLocalRing.ResidueField A ≃ₗ[IsLocalRing.ResidueField A]
      IsLocalRing.ResidueField B :=
    LinearEquiv.ofBijective (Algebra.linearMap _ _) hbij
  have : IsSimpleModule (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B) :=
    IsSimpleModule.congr e.symm
  exact Module.length_eq_one _ _

/-- **Flat base change of the `Tor` lengths along a local retraction.** Let `A → B` be a flat
local homomorphism of local rings with a retraction `φ : B → A`. For ideals `I ⊆ A` and
`J ⊆ B`, `length_A Torᵢᴬ(A ⧸ I, A ⧸ φ(J)) = length_B Torᵢᴮ(B ⧸ IB, B ⧸ (J + ker φ))`. -/
theorem length_tor_quotient_eq (hψ : (algebraMap A B).Flat) (φ : B →+* A)
    (h : φ.comp (algebraMap A B) = RingHom.id A) (I : Ideal A) (J : Ideal B) (i : ℕ) :
    Module.length A (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A (A ⧸ I))).obj
        (ModuleCat.of A (A ⧸ J.map φ))) =
      Module.length B (((Tor (ModuleCat.{u} B) i).obj
        (ModuleCat.of B (B ⧸ I.map (algebraMap A B)))).obj
          (ModuleCat.of B (B ⧸ (J ⊔ RingHom.ker φ)))) := by
  set N := ModuleCat.of B (B ⧸ (J ⊔ RingHom.ker φ))
  set T := ((Tor (ModuleCat.{u} B) i).obj N).obj
    ((ModuleCat.extendScalars.{u, u, u} (algebraMap A B)).obj (ModuleCat.of A (A ⧸ I)))
  have e₁ : ((Tor (ModuleCat.{u} B) i).obj (ModuleCat.of B (B ⧸ I.map (algebraMap A B)))).obj N ≅
      ((Tor (ModuleCat.{u} B) i).obj
        ((ModuleCat.extendScalars.{u, u, u} (algebraMap A B)).obj
          (ModuleCat.of A (A ⧸ I)))).obj N :=
    ((Tor (ModuleCat.{u} B) i).mapIso (extendScalarsQuotientIso (algebraMap A B) I)).app N
  let : Module A T := Module.compHom T (algebraMap A B)
  let : IsScalarTower A B T := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have hres := IsLocalRing.length_restrictScalars A B T
  rw [length_residueField_eq_one φ h, mul_one] at hres
  have e₂ := torExtendScalarsIso (algebraMap A B) hψ N (ModuleCat.of A (A ⧸ I)) i
  have e₃ : ((Tor (ModuleCat.{u} A) i).obj
      ((ModuleCat.restrictScalars.{u} (algebraMap A B)).obj N)).obj (ModuleCat.of A (A ⧸ I)) ≅
      ((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A (A ⧸ J.map φ))).obj
        (ModuleCat.of A (A ⧸ I)) :=
    ((Tor (ModuleCat.{u} A) i).mapIso (restrictQuotientIso (algebraMap A B) φ h J)).app _
  calc _ = Module.length A (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A (A ⧸ J.map φ))).obj
        (ModuleCat.of A (A ⧸ I))) := Module.length_tor_comm _ _ i
    _ = Module.length A ((ModuleCat.restrictScalars.{u} (algebraMap A B)).obj T) :=
        ((e₂ ≪≫ e₃).toLinearEquiv.length_eq).symm
    _ = Module.length B T := hres
    _ = _ := Module.length_tor_comm _ _ i
    _ = _ := e₁.toLinearEquiv.length_eq.symm

end Local

section Regular

variable [IsLocalRing A] [IsRegularLocalRing B] [Algebra A B] [IsLocalHom (algebraMap A B)]

/-- **The local identity behind Tag 0B60, at a point of a section.** Let `A → B` be a flat local
homomorphism of local rings with a retraction `φ : B → A` whose kernel is generated by a
nonzerodivisor `t`, with `B` regular of dimension at most `n`. For ideals `I ⊆ A` and `J ⊆ B` such
that `t` is regular on `B ⧸ J` and `V(IB) ∩ V(J) ∩ V(t)` is the closed point,

`∑ᵢ (-1)ⁱ length_A Torᵢᴬ(A ⧸ I, A ⧸ φ(J)) =
  ∑_Q ord_{B/Q}(t) · ∑ⱼ (-1)ʲ length_{B_Q} Torⱼᴮ(B ⧸ IB, B ⧸ J)_Q`,

`Q` running over the nonclosed points of `V(IB) ∩ V(J)`. -/
theorem sum_length_tor_section_eq (hψ : (algebraMap A B).Flat)
    (φ : B →+* A) (h : φ.comp (algebraMap A B) = RingHom.id A) (t : B)
    (hker : RingHom.ker φ = Ideal.span {t}) (htB : IsSMulRegular B t) (n : ℕ)
    (hdim : ringKrullDim B ≤ (n : WithBot ℕ∞)) (I : Ideal A) (J : Ideal B)
    (htJ : IsSMulRegular (B ⧸ J) t)
    (hsupp : Module.support B (B ⧸ I.map (algebraMap A B)) ∩ Module.support B (B ⧸ J) ∩
      PrimeSpectrum.zeroLocus {t} ⊆ {IsLocalRing.closedPoint B}) :
    ∑ i ∈ Finset.range (n + 2), (-1 : ℤ) ^ i * ((Module.length A
        (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A (A ⧸ I))).obj
          (ModuleCat.of A (A ⧸ J.map φ)))).toNat : ℤ) =
      ∑ᶠ Q ∈ {Q : PrimeSpectrum B | Q ∈ Module.support B (B ⧸ I.map (algebraMap A B)) ∩
          Module.support B (B ⧸ J) ∧ Q ≠ IsLocalRing.closedPoint B},
        ((Ring.ord (B ⧸ Q.asIdeal) (Ideal.Quotient.mk Q.asIdeal t)).toNat : ℤ) *
          ∑ j ∈ Finset.range (n + 2), (-1 : ℤ) ^ j *
            ((Module.length (Localization.AtPrime Q.asIdeal)
              (LocalizedModule Q.asIdeal.primeCompl
                (((Tor (ModuleCat.{u} B) j).obj
                  (ModuleCat.of B (B ⧸ I.map (algebraMap A B)))).obj
                    (ModuleCat.of B (B ⧸ J))))).toNat : ℤ) := by
  have htm : t ∈ IsLocalRing.maximalIdeal B :=
    mem_maximalIdeal_of_map_eq_zero φ
      (RingHom.mem_ker.mp (hker ▸ Ideal.mem_span_singleton_self t))
  have hJt : J ⊔ RingHom.ker φ = Ideal.span {t} ⊔ J := by rw [hker, sup_comm]
  let eN : ModuleCat.of B (B ⧸ (J ⊔ RingHom.ker φ)) ≅
      ModuleCat.of B (QuotSMulTop t (ModuleCat.of B (B ⧸ J))) :=
    ((Submodule.quotEquivOfEq _ _ hJt).trans
      (AlgebraicGeometry.quotSMulTopQuotientEquiv t J).symm).toModuleIso
  rw [← Stacks.Intersection.PrincipalQuotientTor.sum_length_tor_quotSMulTop_eq
    (ModuleCat.of B (B ⧸ I.map (algebraMap A B))) (ModuleCat.of B (B ⧸ J)) n hdim t htm htB htJ
    hsupp]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [length_tor_quotient_eq hψ φ h I J i,
    (((Tor (ModuleCat.{u} B) i).obj (ModuleCat.of B (B ⧸ I.map (algebraMap A B)))).mapIso
      eN).toLinearEquiv.length_eq]

end Regular

end Stacks.Intersection.SectionLocalIdentity

end
