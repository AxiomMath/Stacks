module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Blowup.TwoGeneratorQuotient
public import StacksFrontier.AlgebraicGeometry.CoherentDevissageGlue.Basic
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.Completion.AffineSpaceOrigin
public import StacksFrontier.AlgebraicGeometry.Intersection.TorFormulaMultiplicities.HigherTorsCompletion
public import StacksFrontier.AlgebraicGeometry.Intersection.TorFormulaMultiplicities.TwoPlanesFormalCoordinates
public import StacksFrontier.AlgebraicGeometry.Morphisms.Smooth.LocalizationAwayPolynomial

/-!
# An actual instance of the example of Tag 0B2S

The last sentences of Tag 0B2S assert that the situation of the example occurs: "To make an
actual example, take a general morphism `f : 𝐏² → 𝐏⁴` ... The image `V ⊂ 𝐏⁴ = X` will have
singularities of the type described above ... To find `W` take a general plane passing through such
a point." That is, there exist a nonsingular variety `X` of dimension `4` over `ℂ`, a closed point
`p ∈ X` and closed subvarieties `V, W ⊂ X` with an isomorphism `𝒪_{X, p}^∧ ≅ ℂ[[x, y, z, w]]`
carrying the ideal of `V` to `(xz, xw, yz, yw)` and the ideal of `W` to `(x - z, y - w)`.

This file proves that existence statement with one explicit instance, in place of the source's
general morphism:

* `X = 𝔸⁴_ℂ = Spec ℂ[a, b, c, d]`, a smooth variety of dimension `4`, and `p` its origin;
* `V` the image of `𝔸² → 𝔸⁴`, `(s, t) ↦ (s² - 1, t, s (s² - 1), s t)`, the closed subscheme cut
  out by the kernel of `nodalSurfaceParam`, which is prime, so `V` is integral; the two points
  `(±1, 0)` of `𝔸²` both map to `p`, and the two branches of `V` at `p` are two transverse smooth
  formal planes, exactly as for the general morphism of the source;
* `W` the plane `c = d = 0`, through `p` and transverse to both branches.

The completed local ring of `𝔸⁴` at the origin is `ℂ[[a, b, c, d]]`
(`Stacks.AffineSpaceOrigin.exists_ringEquiv_adicCompletion_stalk_origin`), and in the formal
coordinates `branchCoord` the two completed ideals become `(xz, xw, yz, yw)` and `(x - z, y - w)`
(`map_ker_nodalSurfaceParam`, `map_ker_planeParam`). Combined with
`length_stalk_quotient_sup_eq_three_and_intersectionMultiplicity_eq_two`, this instance has
`length 𝒪_{X, p} ⧸ (I_V + I_W) = 3` and `e(X, V · W, p) = 2`.

## Main definitions

* `Stacks.Intersection.TwoPlanes.affineSubscheme`: the closed subscheme of `𝔸⁴` cut out by an
  ideal of `ℂ[a, b, c, d]`.
* `Stacks.Intersection.TwoPlanes.nodalSurface`, `Stacks.Intersection.TwoPlanes.transversePlane`:
  the subvarieties `V` and `W`.

## Main results

* `Stacks.Intersection.TwoPlanes.exists_isSmoothVariety_closedPoint_subvarieties_completion`: the
  existence statement of Tag 0B2S, together with the two numbers for the instance constructed.

## References

* [Stacks Project, Tag 0B2S](https://stacks.math.columbia.edu/tag/0B2S)
-/

@[expose] public noncomputable section

open AlgebraicGeometry IsLocalRing CategoryTheory TopologicalSpace

namespace Stacks.Intersection.TwoPlanes

local notation "P" => MvPolynomial (Fin 4) ℂ

/-- Affine `4`-space over `ℂ`, `Spec ℂ[a, b, c, d]`. -/
local notation "𝔸⁴" => Spec (CommRingCat.of (MvPolynomial (Fin 4) ℂ))

/-- The closed subscheme of `𝔸⁴` cut out by an ideal `I` of `ℂ[a, b, c, d]`: the kernel of the
closed immersion `Spec (ℂ[a, b, c, d] ⧸ I) → 𝔸⁴`. -/
def affineSubscheme (I : Ideal P) : (𝔸⁴).IdealSheafData :=
  (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).ker

/-- The closed subscheme of `𝔸⁴` cut out by a prime ideal is integral: it is the closed subscheme
of the closed immersion of the integral scheme `Spec (ℂ[a, b, c, d] ⧸ I)`. -/
theorem isIntegral_subscheme_affineSubscheme (I : Ideal P) [I.IsPrime] :
    IsIntegral (affineSubscheme I).subscheme := by
  have : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  have : IsDomain (CommRingCat.of (P ⧸ I)) := Ideal.Quotient.isDomain I
  exact Stacks.AlgebraicGeometry.CoherentDevissageGlue.isIntegral_subscheme_ker _

/-- **The stalk of `affineSubscheme I` at a point** is the ideal generated by the germs of `I`. -/
theorem stalk_affineSubscheme (I : Ideal P) (x : 𝔸⁴) :
    IdealSheafData.stalk (affineSubscheme I) x =
      I.map (((𝔸⁴).presheaf.germ ⊤ x trivial).hom.comp
        (Scheme.ΓSpecIso (CommRingCat.of P)).inv.hom) := by
  rw [IdealSheafData.stalk_eq_map_germ _ x ⟨⊤, isAffineOpen_top _⟩ trivial, affineSubscheme,
    ker_Spec_map_quotient_mk, Scheme.IdealSheafData.ofIdealTop_ideal,
    Ideal.map_map, Ideal.map_map]
  congr 1

/-- **The surface `V`**: the image of `(s, t) ↦ (s² - 1, t, s (s² - 1), s t)`, the closed
subscheme of `𝔸⁴` cut out by the kernel of `nodalSurfaceParam`. -/
def nodalSurface : (𝔸⁴).IdealSheafData :=
  affineSubscheme (RingHom.ker (nodalSurfaceParam : P →+* MvPolynomial (Fin 2) ℂ))

/-- **The plane `W`**: `c = d = 0`, the closed subscheme of `𝔸⁴` cut out by the kernel of
`planeParam`. -/
def transversePlane : (𝔸⁴).IdealSheafData :=
  affineSubscheme (RingHom.ker (planeParam : P →+* MvPolynomial (Fin 2) ℂ))

/-- The closed subscheme of `𝔸⁴` cut out by the kernel of a map to a domain is integral. -/
private theorem isIntegral_subscheme_affineSubscheme_ker {R : Type} [CommRing R] [IsDomain R]
    (f : P →+* R) : IsIntegral (affineSubscheme (RingHom.ker f)).subscheme :=
  have := RingHom.ker_isPrime f
  isIntegral_subscheme_affineSubscheme _

/-- The surface `V` is integral. -/
theorem isIntegral_subscheme_nodalSurface : IsIntegral nodalSurface.subscheme :=
  isIntegral_subscheme_affineSubscheme_ker _

/-- The plane `W` is integral. -/
theorem isIntegral_subscheme_transversePlane : IsIntegral transversePlane.subscheme :=
  isIntegral_subscheme_affineSubscheme_ker _

/-- `𝔸⁴_ℂ` is a smooth variety over `ℂ`. -/
theorem isSmoothVariety_affineSpace :
    IsSmoothVariety ℂ (Spec.map (CommRingCat.ofHom (algebraMap ℂ P))) :=
  have : Algebra.Smooth ℂ P := smooth_mvPolynomial ℂ (Fin 4)
  (isSmoothVariety_iff ℂ _).mpr
    ⟨isVariety_Spec_map_algebraMap ℂ P, smooth_Spec_map_algebraMap ℂ P⟩

/-- `𝔸⁴_ℂ` has dimension `4`. -/
theorem topologicalKrullDim_affineSpace : topologicalKrullDim (𝔸⁴) = 4 := by
  show topologicalKrullDim (PrimeSpectrum P) = 4
  rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim,
    MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, Nat.card_fin]
  rfl

/-- The local ring of `𝔸⁴` at the origin. -/
abbrev originStalk : CommRingCat := (𝔸⁴).presheaf.stalk (AffineSpaceOrigin.origin ℂ 4)

/-- **The completed local ring of `𝔸⁴` at the origin, in the branch coordinates.** There is a ring
isomorphism `𝒪_{𝔸⁴, 0}^∧ ≅ ℂ[[x, y, z, w]]` carrying the ideal of the surface `V` to
`(xz, xw, yz, yw)` and the ideal of the plane `W` to `(x - z, y - w)`. -/
theorem exists_ringEquiv_adicCompletion_stalk_origin_nodalSurface :
    ∃ e : AdicCompletion (maximalIdeal ((𝔸⁴).presheaf.stalk (AffineSpaceOrigin.origin ℂ 4)))
        ((𝔸⁴).presheaf.stalk (AffineSpaceOrigin.origin ℂ 4)) ≃+* MvPowerSeries (Fin 4) ℂ,
      ((IdealSheafData.stalk nodalSurface (AffineSpaceOrigin.origin ℂ 4)).map
          (algebraMap _ (AdicCompletion _ _))).map e = unionOfPlanes ∧
        ((IdealSheafData.stalk transversePlane (AffineSpaceOrigin.origin ℂ 4)).map
          (algebraMap _ (AdicCompletion _ _))).map e = diagonalPlane := by
  obtain ⟨E, hE⟩ := AffineSpaceOrigin.exists_ringEquiv_adicCompletion_stalk_origin ℂ 4
  let e := E.trans branchCoordEquiv.symm.toRingEquiv
  have hcomp : ((e : AdicCompletion (maximalIdeal originStalk) originStalk →+*
      MvPowerSeries (Fin 4) ℂ).comp
        (algebraMap originStalk (AdicCompletion (maximalIdeal originStalk) originStalk))).comp
        (((𝔸⁴).presheaf.germ ⊤ (AffineSpaceOrigin.origin ℂ 4) trivial).hom.comp
          (Scheme.ΓSpecIso (CommRingCat.of P)).inv.hom) =
      branchCoordEquiv.symm.toRingEquiv.toRingHom.comp
        (polyToSeries : P →+* MvPowerSeries (Fin 4) ℂ) := by
    refine RingHom.ext fun q => ?_
    refine (congrArg branchCoordEquiv.symm (hE q)).trans ?_
    show branchCoordEquiv.symm _ = branchCoordEquiv.symm (polyToSeries q)
    rw [polyToSeries, MvPolynomial.coeToMvPowerSeries.algHom_apply, Algebra.algebraMap_self,
      MvPowerSeries.map_id, RingHom.id_apply]
  have key : ∀ I : Ideal P,
      ((I.map (((𝔸⁴).presheaf.germ ⊤ (AffineSpaceOrigin.origin ℂ 4) trivial).hom.comp
        (Scheme.ΓSpecIso (CommRingCat.of P)).inv.hom)).map
          (algebraMap originStalk (AdicCompletion (maximalIdeal originStalk) originStalk))).map e =
      ((I.map (polyToSeries : P →+* MvPowerSeries (Fin 4) ℂ)).map branchCoordEquiv.symm) := by
    intro I
    show ((I.map _).map _).map
        (e : AdicCompletion (maximalIdeal originStalk) originStalk →+*
          MvPowerSeries (Fin 4) ℂ) = _
    rw [Ideal.map_map, Ideal.map_map, hcomp, ← Ideal.map_map]
    rfl
  refine ⟨e, ?_, ?_⟩
  · rw [nodalSurface, stalk_affineSubscheme, key, map_ker_nodalSurfaceParam,
      map_symm_map_branchCoordEquiv]
  · rw [transversePlane, stalk_affineSubscheme, key, map_ker_planeParam,
      map_symm_map_branchCoordEquiv]

/-- **Tag 0B2S, "To make an actual example": the situation of the example exists.** There are a
smooth (that is, nonsingular) variety `X` of dimension `4` over `ℂ`, a closed point `p ∈ X`, and
integral closed subschemes (closed subvarieties) `V, W ⊂ X`, with a ring isomorphism
`e : 𝒪_{X, p}^∧ ≅ ℂ[[x, y, z, w]]` carrying the ideal of `V` to `(xz, xw, yz, yw)` and the ideal of
`W` to `(x - z, y - w)`; for them `length_{𝒪_{X, p}} 𝒪_{X, p} ⧸ (I_V + I_W) = 3` and
`e(X, V · W, p) = 2`.

The instance is `X = 𝔸⁴_ℂ`, `p` the origin, `V` the image of `𝔸² → 𝔸⁴`,
`(s, t) ↦ (s² - 1, t, s (s² - 1), s t)`, which identifies `(1, 0)` and `(-1, 0)` and has two
transverse smooth branches at `p`, and `W` the plane `c = d = 0` through `p`. -/
@[stacks 0B2S "the existence clause \"To make an actual example ...\": there exist a smooth \
variety X of dimension 4 over ℂ, a closed point p and integral closed subschemes V, W with an \
isomorphism of the completed local ring at p with ℂ[[x, y, z, w]] carrying I_V to \
(xz, xw, yz, yw) and I_W to (x - z, y - w), and for them the length is 3 and e(X, V · W, p) = 2; \
proved with one explicit instance in A^4 (V the image of (s, t) ↦ (s² - 1, t, s(s² - 1), st), W \
the plane c = d = 0) in place of the source's general morphism P^2 → P^4"]
theorem exists_isSmoothVariety_closedPoint_subvarieties_completion :
    ∃ (X : Scheme.{0}) (f : X ⟶ Spec (CommRingCat.of ℂ)), IsSmoothVariety ℂ f ∧
      topologicalKrullDim X = 4 ∧
      ∃ (p : X) (V W : X.IdealSheafData), IsClosed ({p} : Set X) ∧
        IsIntegral V.subscheme ∧ IsIntegral W.subscheme ∧
        (∃ e : AdicCompletion (maximalIdeal (X.presheaf.stalk p)) (X.presheaf.stalk p) ≃+*
            MvPowerSeries (Fin 4) ℂ,
          ((IdealSheafData.stalk V p).map (algebraMap _ (AdicCompletion _ _))).map e =
              unionOfPlanes ∧
            ((IdealSheafData.stalk W p).map (algebraMap _ (AdicCompletion _ _))).map e =
              diagonalPlane) ∧
        Module.length (X.presheaf.stalk p)
            ((X.presheaf.stalk p) ⧸ IdealSheafData.stalk (V ⊔ W) p) = 3 ∧
          Stacks.Intersection.intersectionMultiplicity V W p = 2 := by
  obtain ⟨e, hV, hW⟩ := exists_ringEquiv_adicCompletion_stalk_origin_nodalSurface
  exact ⟨𝔸⁴, Spec.map (CommRingCat.ofHom (algebraMap ℂ P)), isSmoothVariety_affineSpace,
    topologicalKrullDim_affineSpace, AffineSpaceOrigin.origin ℂ 4, nodalSurface, transversePlane,
    AffineSpaceOrigin.isClosed_singleton_origin ℂ 4, isIntegral_subscheme_nodalSurface,
    isIntegral_subscheme_transversePlane, ⟨e, hV, hW⟩,
    length_stalk_quotient_sup_eq_three_and_intersectionMultiplicity_eq_two _ _ _ e hV hW⟩

end Stacks.Intersection.TwoPlanes

end
