module

public import StacksFrontier.AlgebraicGeometry.Intersection.TorFormulaMultiplicities.TransversalIntersection

/-!
# Transversal intersections of closed subschemes

Let `X` be a nonsingular variety and let `Y`, `Z ⊆ X` be closed subschemes of dimension at most
`r`, resp. `s`, whose associated cycles `[Y]_r = ∑ nᵢ[Yᵢ]` and `[Z]_s = ∑ mⱼ[Zⱼ]` intersect
properly. Let `T` be an irreducible component of `Y_{i₀} ∩ Z_{j₀}` along which `Y ∩ Z` has
multiplicity one. Passing to the local ring `A = 𝒪_{X, ξ}` at the generic point `ξ` of `T`, which
is a regular local ring, the data becomes four ideals: the ideals `I`, `J` of `Y`, `Z` and the
ideals `I₀`, `J₀` of the two chosen components, with `I ⊆ I₀` and `J ⊆ J₀` because a component is
contained in the subscheme it comes from. The multiplicity-one hypothesis says that `A ⧸ (I ⊔ J)`
is the residue field, and proper intersection together with the dimension count of Varieties,
Lemma 0A21 says `dim A ≤ dim (A ⧸ I₀) + dim (A ⧸ J₀)` and `dim (A ⧸ I) = dim (A ⧸ I₀)`,
`dim (A ⧸ J) = dim (A ⧸ J₀)`.

Under these hypotheses `I` and `J` are generated by complementary parts of a single regular system
of parameters of `A`, so `A ⧸ I` and `A ⧸ J` are regular local rings and in particular domains.
A nested pair of ideals whose quotients are domains of the same finite dimension must be equal,
whence `I = I₀` and `J = J₀`: the subschemes already coincide with their components near `ξ`. That
identification is what makes the two subschemes nonsingular at the generic point of `T`, forces
the two cycle coefficients to be one, pins the Tor-formula intersection multiplicity of the pair
at `1` by Lemma 0B1I, and rules out any further component of either cycle passing through `ξ`.

## Main results

* `IsRegularLocalRing.eq_and_isRegularLocalRing_quotient_and_localIntersectionMultiplicity_eq_one`:
  the two subscheme ideals coincide with the ideals of their components, are prime, have regular
  local quotients, and the Tor-formula multiplicity of the pair is `1`.
* `IsRegularLocalRing.eq_of_le_of_ringKrullDim_quotient_eq_of_length_quotient_sup_eq_one`: any
  further cycle component meeting the generic point of `T` in the same dimension coincides with
  the chosen one.

## Implementation notes

The statements are local: the ambient nonsingular variety enters only through the regularity of
`A`, and the dimension bounds that the source derives from the global dimension hypotheses are
taken as hypotheses on the four ideals. Dimensions are `ringKrullDim`, valued in `WithBot ℕ∞`,
and the comparison with the source's `dim(T) = r + s - n` is the inequality
`dim A ≤ dim (A ⧸ I₀) + dim (A ⧸ J₀)`, which carries no subtraction.

The source's clauses are statements about algebraic cycles on `X`; this file proves the local
algebra the source's proof reduces them to, and
`StacksFrontier.AlgebraicGeometry.Intersection.TorFormulaMultiplicities.TransversalSubschemeCycles`
derives the lemma itself, for the cycles `[Y]_r` and `[Z]_s` on `X`, as the theorem
`torFormulaCycleIntersectionProduct_cycleAssociatedToClosedSubscheme_apply_eq_one` in the
namespace `AlgebraicGeometry.TorFormula`, discharging the dimension hypotheses above from the
global ones by Varieties, Lemma 0A21.

## References

* [Stacks Project, Tag 0B1J](https://stacks.math.columbia.edu/tag/0B1J)
* [Stacks Project, Tag 0B1I](https://stacks.math.columbia.edu/tag/0B1I)
-/

@[expose] public noncomputable section

universe u

namespace IsRegularLocalRing

/-- Nested ideals `I ≤ I'` of a commutative ring whose quotients have the same finite Krull
dimension are equal as soon as `R ⧸ I` is a domain: an element of `I' \ I` is a nonzerodivisor of
`R ⧸ I` killed by the surjection `R ⧸ I → R ⧸ I'`, which would force
`dim (R ⧸ I') < dim (R ⧸ I)`. -/
private lemma eq_of_le_of_ringKrullDim_quotient_eq {R : Type*} [CommRing R] {I I' : Ideal R}
    (hle : I ≤ I') (hdom : IsDomain (R ⧸ I)) {n : ℕ}
    (hI : ringKrullDim (R ⧸ I) = n) (hI' : ringKrullDim (R ⧸ I') = n) : I = I' := by
  have := hdom
  by_contra hne
  obtain ⟨x, hxI', hxI⟩ := IsConcreteLE.exists_of_lt (lt_of_le_of_ne hle hne)
  have hkill : ringKrullDim (R ⧸ I') + 1 ≤ ringKrullDim (R ⧸ I) :=
    ringKrullDim_succ_le_of_surjective (Ideal.Quotient.factor hle)
      (Ideal.Quotient.factor_surjective hle)
      (mem_nonZeroDivisors_of_ne_zero fun hcon => hxI (Ideal.Quotient.eq_zero_iff_mem.mp hcon))
      (by simp [Ideal.Quotient.eq_zero_iff_mem.mpr hxI'])
  rw [hI, hI'] at hkill
  have h : ((n + 1 : ℕ) : WithBot ℕ∞) ≤ ((n : ℕ) : WithBot ℕ∞) := by push_cast; exact hkill
  simpa using (Nat.cast_le (α := WithBot ℕ∞)).mp h

/-- If `A ⧸ (I ⊔ J)` has length one and the intersection is proper, then `A ⧸ I` is a regular local
ring and every ideal containing `I` with a quotient of the same dimension equals `I`. -/
private lemma isRegularLocalRing_quotient_and_eq_of_le_of_ringKrullDim_quotient_eq
    {A : Type u} [CommRing A] [IsRegularLocalRing A] (I J : Ideal A)
    (hmult : Module.length A (A ⧸ (I ⊔ J)) = 1)
    (hproper : ringKrullDim A ≤ ringKrullDim (A ⧸ I) + ringKrullDim (A ⧸ J)) :
    IsRegularLocalRing (A ⧸ I) ∧
      ∀ I' : Ideal A, I ≤ I' → ringKrullDim (A ⧸ I') = ringKrullDim (A ⧸ I) → I' = I := by
  obtain ⟨a, b, _f, _g, -, -, -, hdimIb, -⟩ :=
    exists_isRegularSystemOfParameters_of_length_quotient_sup_eq_one I J hmult hproper
  have hreg := isRegularLocalRing_quotient_of_length_quotient_sup_eq_one I J hmult hproper
  exact ⟨hreg, fun I' hle hdim => (eq_of_le_of_ringKrullDim_quotient_eq hle
    (_root_.IsRegularLocalRing.isDomain (A ⧸ I)) hdimIb (hdim.trans hdimIb)).symm⟩

/-- **The local computation behind Stacks 0B1J, clauses (1), (2) and (3).** Let `A` be a
regular local ring, let `I ≤ I₀` and `J ≤ J₀` be ideals with
`A ⧸ (I ⊔ J)` of length one, with `dim (A ⧸ I) = dim (A ⧸ I₀)` and `dim (A ⧸ J) = dim (A ⧸ J₀)`,
and with `dim A ≤ dim (A ⧸ I₀) + dim (A ⧸ J₀)`. Then `I = I₀` and `J = J₀`, both ideals are
prime with regular local quotients, and the Tor-formula intersection multiplicity of the pair is
`1`. Geometrically, for `A` the local ring of a nonsingular variety `X` at the generic point `ξ`
of an irreducible component `T` of `Y_{i₀} ∩ Z_{j₀}` with `Y ∩ Z` of multiplicity one along `T`:
the two closed subschemes agree with their components near `ξ`, so they are nonsingular there and
the coefficients `n_{i₀}`, `m_{j₀}` are one, and the coefficient of `T` in `[Y]_r ⋅ [Z]_s` is
one. -/
theorem eq_and_isRegularLocalRing_quotient_and_localIntersectionMultiplicity_eq_one
    {A : Type u} [CommRing A] [IsRegularLocalRing A] (I I₀ J J₀ : Ideal A)
    (hI : I ≤ I₀) (hJ : J ≤ J₀)
    (hmult : Module.length A (A ⧸ (I ⊔ J)) = 1)
    (hdimI : ringKrullDim (A ⧸ I) = ringKrullDim (A ⧸ I₀))
    (hdimJ : ringKrullDim (A ⧸ J) = ringKrullDim (A ⧸ J₀))
    (hproper : ringKrullDim A ≤ ringKrullDim (A ⧸ I₀) + ringKrullDim (A ⧸ J₀)) :
    I = I₀ ∧ J = J₀ ∧ I.IsPrime ∧ J.IsPrime ∧
      IsRegularLocalRing (A ⧸ I) ∧ IsRegularLocalRing (A ⧸ J) ∧
      I.localIntersectionMultiplicity (A ⧸ J) = 1 := by
  have hproper' : ringKrullDim A ≤ ringKrullDim (A ⧸ I) + ringKrullDim (A ⧸ J) := by
    rw [hdimI, hdimJ]; exact hproper
  obtain ⟨hregI, hI'⟩ :=
    isRegularLocalRing_quotient_and_eq_of_le_of_ringKrullDim_quotient_eq I J hmult hproper'
  obtain ⟨hregJ, hJ'⟩ := isRegularLocalRing_quotient_and_eq_of_le_of_ringKrullDim_quotient_eq J I
    (by rwa [sup_comm]) (by rwa [add_comm])
  have := hregI
  have := hregJ
  refine ⟨(hI' I₀ hI hdimI.symm).symm, (hJ' J₀ hJ hdimJ.symm).symm,
    (Ideal.Quotient.isDomain_iff_prime I).mp (_root_.IsRegularLocalRing.isDomain (A ⧸ I)),
    (Ideal.Quotient.isDomain_iff_prime J).mp (_root_.IsRegularLocalRing.isDomain (A ⧸ J)),
    hregI, hregJ,
    localIntersectionMultiplicity_eq_one_of_length_quotient_sup_eq_one I J hmult hproper'⟩

/-- **The local computation behind Stacks 0B1J, clause (4).** In the
situation of
`IsRegularLocalRing.eq_and_isRegularLocalRing_quotient_and_localIntersectionMultiplicity_eq_one`,
any ideal `I'` between `I` and the whole ring whose quotient has the same dimension as `A ⧸ I₀`
equals `I₀`, and likewise on the other side. Geometrically: a component `Yᵢ` of `[Y]_r` whose
closure contains `T` has local ideal containing that of `Y` and quotient of the same dimension,
so it coincides with `Y_{i₀}`; hence `T` is contained in no `Yᵢ` with `i ≠ i₀`, and in no `Zⱼ`
with `j ≠ j₀`. -/
theorem eq_of_le_of_ringKrullDim_quotient_eq_of_length_quotient_sup_eq_one
    {A : Type u} [CommRing A] [IsRegularLocalRing A] (I I₀ J J₀ : Ideal A)
    (hI : I ≤ I₀) (hJ : J ≤ J₀)
    (hmult : Module.length A (A ⧸ (I ⊔ J)) = 1)
    (hdimI : ringKrullDim (A ⧸ I) = ringKrullDim (A ⧸ I₀))
    (hdimJ : ringKrullDim (A ⧸ J) = ringKrullDim (A ⧸ J₀))
    (hproper : ringKrullDim A ≤ ringKrullDim (A ⧸ I₀) + ringKrullDim (A ⧸ J₀)) :
    (∀ I' : Ideal A, I ≤ I' → ringKrullDim (A ⧸ I') = ringKrullDim (A ⧸ I₀) → I' = I₀) ∧
      (∀ J' : Ideal A, J ≤ J' → ringKrullDim (A ⧸ J') = ringKrullDim (A ⧸ J₀) → J' = J₀) := by
  have hproper' : ringKrullDim A ≤ ringKrullDim (A ⧸ I) + ringKrullDim (A ⧸ J) := by
    rw [hdimI, hdimJ]; exact hproper
  obtain ⟨-, hI'⟩ :=
    isRegularLocalRing_quotient_and_eq_of_le_of_ringKrullDim_quotient_eq I J hmult hproper'
  obtain ⟨-, hJ'⟩ := isRegularLocalRing_quotient_and_eq_of_le_of_ringKrullDim_quotient_eq J I
    (by rwa [sup_comm]) (by rwa [add_comm])
  exact ⟨fun I' hle hdim =>
      (hI' I' hle (hdim.trans hdimI.symm)).trans (hI' I₀ hI hdimI.symm).symm,
    fun J' hle hdim =>
      (hJ' J' hle (hdim.trans hdimJ.symm)).trans (hJ' J₀ hJ hdimJ.symm).symm⟩


end IsRegularLocalRing

end
