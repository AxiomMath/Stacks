module

public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.KrullDimension.Basic
public import Mathlib.RingTheory.TensorProduct.Maps

/-!
# The ideal of a product of two closed subschemes, read along the diagonal

Let `R` be a commutative ring, `A` a commutative `R`-algebra and `I`, `J` two ideals of `A`. The
ideal

`prodIdeal I J = I (A ⊗_R A) + J (A ⊗_R A) ⊆ A ⊗_R A`,

generated by the images of `I` under the left inclusion and of `J` under the right inclusion, is
the ideal whose quotient is `(A ⧸ I) ⊗_R (A ⧸ J)`. Geometrically, for `A = 𝒪_{X, ξ}` the local
ring of a variety at a point and `I`, `J` the local ideals of two closed subschemes `V`, `W`, it
is the ideal of `V × W` inside `X × X` read in the presentation of `𝒪_{X × X, Δ(ξ)}` as a
localization of `A ⊗_R A` (`Stacks.Intersection.Diagonal.diagonal_stalk_isLocalization`).

What is proved here is the computation the reduction to the diagonal needs about this ideal
*together with the ideal of the diagonal*: the ideal of the diagonal is the kernel of a
retraction `d : B → A` of the structural map, and modulo that kernel the ideal of `V × W` becomes
`I + J`. So the quotient of `B` by the two of them together is `A ⧸ (I ⊔ J)`:

`dim (B ⧸ (ker d ⊔ (prodIdeal I J) B)) = dim (A ⧸ (I ⊔ J))`.

That is exactly the first numerical hypothesis of the multiplicity formula for a regular
sequence, `dim (B ⧸ (I_Δ ⊔ J')) = 0`, transported from the hypothesis `dim (A ⧸ (I ⊔ J)) = 0`
that says that the point is the generic point of an irreducible component of `V ∩ W`.

Everything here is about an abstract retraction `d` of `lmul' : A ⊗_R A → A`; no localization, no
Noetherian hypothesis and no geometry enters. The localization `B = 𝒪_{X × X, Δ(ξ)}` with its
retraction is supplied by
`Stacks.Intersection.Diagonal.diagonal_stalk_isLocalization`.

## Main definitions

* `Stacks.Intersection.Diagonal.prodIdeal` — the ideal `I (A ⊗_R A) + J (A ⊗_R A)` of `A ⊗_R A`.

## Main results

* `Stacks.Intersection.Diagonal.map_lmul'_prodIdeal` — the multiplication map carries
  `prodIdeal I J` onto `I ⊔ J`.
* `Stacks.Intersection.Diagonal.map_sup_ker_map_prodIdeal` — the same for a retraction `d` of the
  multiplication map through a ring map `φ : A ⊗_R A → B`: the image under `d` of
  `ker d ⊔ (prodIdeal I J) B` is `I ⊔ J`.
* `Stacks.Intersection.Diagonal.ringKrullDim_quotient_sup_ker_map_prodIdeal` — hence the
  dimension of `B ⧸ (ker d ⊔ (prodIdeal I J) B)` is the dimension of `A ⧸ (I ⊔ J)`.

## References

* [Stacks Project, Tag 0B0U](https://stacks.math.columbia.edu/tag/0B0U)
* [Stacks Project, Tag 0B04](https://stacks.math.columbia.edu/tag/0B04)
-/

@[expose] public section

open scoped TensorProduct

universe u

namespace Stacks.Intersection.Diagonal

variable {R A : Type u} [CommRing R] [CommRing A] [Algebra R A]

/-- **The ideal of `V × W` in `A ⊗_R A`.** For two ideals `I`, `J` of an `R`-algebra `A`, the
ideal of `A ⊗_R A` generated by the image of `I` under the left inclusion together with the image
of `J` under the right inclusion. Its quotient is `(A ⧸ I) ⊗_R (A ⧸ J)`, so for `A = 𝒪_{X, ξ}`
and `I`, `J` the local ideals of two closed subschemes `V`, `W` of `X` it is the local ideal of
`V × W` in the presentation of `𝒪_{X × X, Δ(ξ)}` as a localization of `A ⊗_R A`. -/
def prodIdeal (I J : Ideal A) : Ideal (A ⊗[R] A) :=
  I.map (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] A) ⊔
    J.map (Algebra.TensorProduct.includeRight : A →ₐ[R] A ⊗[R] A).toRingHom

/-- **The multiplication map carries the ideal of `V × W` onto `I ⊔ J`.** Both inclusions are
sections of `lmul' : A ⊗_R A → A`, so the image of `prodIdeal I J` is `I ⊔ J`. Geometrically this
is `Δ^{-1}(V × W) = V ∩ W`. -/
theorem map_lmul'_prodIdeal (I J : Ideal A) :
    Ideal.map (Algebra.TensorProduct.lmul' R (S := A)).toRingHom (prodIdeal (R := R) I J) =
      I ⊔ J := by
  have hL : ((Algebra.TensorProduct.lmul' R (S := A)).toRingHom).comp
      (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] A) = RingHom.id A := by
    ext a
    simp
  have hR : ((Algebra.TensorProduct.lmul' R (S := A)).toRingHom).comp
      (Algebra.TensorProduct.includeRight : A →ₐ[R] A ⊗[R] A).toRingHom = RingHom.id A := by
    ext a
    simp
  rw [prodIdeal, Ideal.map_sup, Ideal.map_map, Ideal.map_map, hL, hR, Ideal.map_id, Ideal.map_id]

variable {B : Type u} [CommRing B]

/-- **The ideal of `V × W` together with the ideal of the diagonal.** Let `φ : A ⊗_R A → B` be a
ring map admitting a retraction `d : B → A` of the multiplication map, `lmul' = d ∘ φ`. Then the
image under `d` of the ideal generated by `ker d` and by `φ(prodIdeal I J)` is `I ⊔ J`.

For `B = 𝒪_{X × X, Δ(ξ)}` the ideal `ker d` is the local ideal of the diagonal and the second is
the local ideal of `V × W`, so this says `Δ^{-1}(Δ ∩ V × W) = V ∩ W`. -/
theorem map_sup_ker_map_prodIdeal (φ : (A ⊗[R] A) →+* B) (d : B →+* A)
    (hd : (Algebra.TensorProduct.lmul' R (S := A)).toRingHom = d.comp φ) (I J : Ideal A) :
    Ideal.map d (RingHom.ker d ⊔ Ideal.map φ (prodIdeal (R := R) I J)) = I ⊔ J := by
  have hker : Ideal.map d (RingHom.ker d) = ⊥ :=
    (Ideal.map_eq_bot_iff_le_ker _).mpr le_rfl
  rw [Ideal.map_sup, Ideal.map_map, ← hd, map_lmul'_prodIdeal, hker, bot_sup_eq]

/-- **The quotient of `B` by the diagonal and by `V × W` is `A ⧸ (I ⊔ J)`.** With `φ`, `d` as in
`Stacks.Intersection.Diagonal.map_sup_ker_map_prodIdeal` and `d` surjective, there is a ring
isomorphism `B ⧸ (ker d ⊔ φ(prodIdeal I J) B) ≃+* A ⧸ (I ⊔ J)`.

This is the identification that transports the hypothesis "`ξ` is the generic point of an
irreducible component of `V ∩ W`", i.e. `dim (A ⧸ (I ⊔ J)) = 0`, to the pair
`(Δ, V × W)` on `X × X`, where it is the hypothesis `dim (B ⧸ (I_Δ ⊔ J')) = 0` of the
multiplicity formula for a regular sequence. -/
noncomputable def quotientSupKerMapProdIdealEquiv (φ : (A ⊗[R] A) →+* B) (d : B →+* A)
    (hd : (Algebra.TensorProduct.lmul' R (S := A)).toRingHom = d.comp φ)
    (hdsurj : Function.Surjective d) (I J : Ideal A) :
    (B ⧸ (RingHom.ker d ⊔ Ideal.map φ (prodIdeal (R := R) I J))) ≃+* (A ⧸ (I ⊔ J)) :=
  have hkerg : RingHom.ker ((Ideal.Quotient.mk (I ⊔ J)).comp d) =
      RingHom.ker d ⊔ Ideal.map φ (prodIdeal (R := R) I J) := by
    rw [← RingHom.comap_ker, Ideal.mk_ker, ← map_sup_ker_map_prodIdeal φ d hd I J,
      Ideal.comap_map_of_surjective d hdsurj]
    exact sup_eq_left.mpr ((RingHom.ker_eq_comap_bot d) ▸ le_sup_left)
  (Ideal.quotEquivOfEq hkerg.symm).trans
    (RingHom.quotientKerEquivOfSurjective
      (Ideal.Quotient.mk_surjective.comp hdsurj))

/-- The dimension form of `Stacks.Intersection.Diagonal.quotientSupKerMapProdIdealEquiv`. -/
theorem ringKrullDim_quotient_sup_ker_map_prodIdeal (φ : (A ⊗[R] A) →+* B) (d : B →+* A)
    (hd : (Algebra.TensorProduct.lmul' R (S := A)).toRingHom = d.comp φ)
    (hdsurj : Function.Surjective d) (I J : Ideal A) :
    ringKrullDim (B ⧸ (RingHom.ker d ⊔ Ideal.map φ (prodIdeal (R := R) I J))) =
      ringKrullDim (A ⧸ (I ⊔ J)) :=
  ringKrullDim_eq_of_ringEquiv (quotientSupKerMapProdIdealEquiv φ d hd hdsurj I J)

end Stacks.Intersection.Diagonal

end
