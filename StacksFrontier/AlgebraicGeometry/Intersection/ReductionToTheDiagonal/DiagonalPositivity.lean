module

public import Mathlib.RingTheory.TensorProduct.Quotient
public import StacksFrontier.AlgebraicGeometry.Intersection.ReductionToDiagonal.DiagonalLocalMultiplicity
public import StacksFrontier.AlgebraicGeometry.Intersection.ReductionToTheDiagonal.DiagonalLength
public import StacksFrontier.AlgebraicGeometry.Intersection.ReductionToTheDiagonal.DiagonalProductDimension
public import StacksFrontier.AlgebraicGeometry.Intersection.ReductionToTheDiagonal.DiagonalProductIdeal
public import StacksFrontier.AlgebraicGeometry.Intersection.ReductionToTheDiagonal.DiagonalRegularSequenceLength
public import StacksFrontier.AlgebraicGeometry.Intersection.ReductionToTheDiagonal.DiagonalStalk
public import StacksFrontier.AlgebraicGeometry.Intersection.ReductionToTheDiagonal.DiagonalTorStalk
public import StacksFrontier.AlgebraicGeometry.Intersection.ReductionToTheDiagonal.PositiveMultiplicity
