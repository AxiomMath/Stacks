module

public import StacksFrontier.AlgebraicGeometry.Chow.RationalEquivalence.GeometricRationalEquivalence
public import StacksFrontier.AlgebraicGeometry.Chow.FieldSituation.Base
public import StacksFrontier.AlgebraicGeometry.Intersection.TorFormula.CycleIntersectionProduct

/-!
# Rationally trivial cycles as a subgroup of all cycles

The cycles of delta-dimension `m` rationally equivalent to zero form a subgroup of the group of
all cycles. On a variety over an algebraically closed field, a cycle rationally equivalent to zero
is a finite `ℤ`-combination of the basic differences `[W₀] - [W_∞]`.

## Main definitions

* `Stacks.Intersection.RationalEquivalenceProduct.ratCycles`: the cycles of delta-dimension `m`
  rationally equivalent to zero, as a subgroup of all cycles.

## Main results

* `Stacks.Intersection.RationalEquivalenceProduct.exists_fibreDifferences_sum`: on a variety over
  an algebraically closed field, a rationally trivial `r`-cycle is a finite `ℤ`-combination of
  elements of `fibreDifferences`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace
open Stacks.Chow AlgebraicGeometry.TorFormula

universe u

namespace Stacks.Intersection.RationalEquivalenceProduct

variable (C : ChowSituation.{u}) {X : Scheme.{u}} (p : X ⟶ C.S) [LocallyOfFiniteType p]

/-- The cycles of delta-dimension `m` rationally equivalent to zero, as a subgroup of the group of
all cycles. -/
def ratCycles (m : ℤ) : AddSubgroup (AlgebraicCycle X ℤ) :=
  (rationalEquivalences C p m).map (cyclesOfDimension C p m).subtype

/-- A cycle lies in `ratCycles C p m` if and only if it has delta-dimension `m` and, as an element
of `CycleGroup C p m`, lies in `rationalEquivalences C p m`. -/
theorem mem_ratCycles_iff (m : ℤ) (γ : AlgebraicCycle X ℤ) :
    γ ∈ ratCycles C p m ↔
      ∃ h : γ ∈ cyclesOfDimension C p m,
        (⟨γ, h⟩ : CycleGroup C p m) ∈ rationalEquivalences C p m := by
  constructor
  · rintro ⟨δ, hδ, rfl⟩
    exact ⟨δ.2, hδ⟩
  · rintro ⟨h, hγ⟩
    exact ⟨⟨γ, h⟩, hγ, rfl⟩

/-- An element of `rationalEquivalences C p m` lies in `ratCycles C p m` as a cycle. -/
theorem mem_ratCycles_of_mem (m : ℤ) (γ : CycleGroup C p m)
    (hγ : γ ∈ rationalEquivalences C p m) : (γ : AlgebraicCycle X ℤ) ∈ ratCycles C p m :=
  ⟨γ, hγ, rfl⟩

/-- **A rationally trivial cycle is a finite combination of basic rational equivalences.** On a
variety over an algebraically closed field the rationally trivial `r`-cycles are the subgroup
generated by the differences `[W₀]_r - [W_∞]_r` (Tag 0AZI); every element of a subgroup generated
by a set is a finite `ℤ`-combination of elements of that set. -/
theorem exists_fibreDifferences_sum (K : Type u) [Field K] [IsAlgClosed K]
    (hC : C.S = AlgebraicGeometry.Spec (CommRingCat.of K))
    [AlgebraicGeometry.IsVariety K (p ≫ eqToHom hC)] (r : ℤ) (α : CycleGroup C p r)
    (hα : α ∈ rationalEquivalences C p r) :
    ∃ (N : ℕ) (c : Fin N → ℤ) (δ : Fin N → CycleGroup C p r),
      (∀ i, δ i ∈ fibreDifferences C p r) ∧ α = ∑ i, c i • δ i := by
  rw [rationalEquivalences_eq_rationalEquivalencesByFibres K C hC p r,
    rationalEquivalencesByFibres] at hα
  induction hα using AddSubgroup.closure_induction with
  | mem x hx => exact ⟨1, fun _ => 1, fun _ => x, fun _ => hx, by simp⟩
  | zero => exact ⟨0, Fin.elim0, Fin.elim0, fun i => i.elim0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨N, c, δ, hδ, rfl⟩ := hx
    obtain ⟨M, d, ε, hε, rfl⟩ := hy
    refine ⟨N + M, Fin.append c d, Fin.append δ ε, fun i => ?_, ?_⟩
    · refine Fin.addCases (fun j => ?_) (fun j => ?_) i
      · rw [Fin.append_left]; exact hδ j
      · rw [Fin.append_right]; exact hε j
    · rw [Fin.sum_univ_add]
      simp [Fin.append_left, Fin.append_right]
  | neg x _ hx =>
    obtain ⟨N, c, δ, hδ, rfl⟩ := hx
    exact ⟨N, fun i => -c i, δ, hδ, by simp [Finset.sum_neg_distrib, neg_smul]⟩

end Stacks.Intersection.RationalEquivalenceProduct

end
