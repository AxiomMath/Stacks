module

public import StacksFrontier.AlgebraicGeometry.Intersection.MovingLemma.ProjectionCone
public import StacksFrontier.AlgebraicGeometry.Intersection.Projections.BadLocusReducible
public import StacksFrontier.AlgebraicGeometry.Variety.Projective.LinearSubspaceQuotientMap

/-!
# The dimension of the cone over a closed subvariety

Let `W ≤ V` be a submodule of corank `c + 1` and let `Z` be an irreducible closed subset of
`𝐏(W)` of dimension at least `d`. The cone over `Z` with vertex the linear subspace cut out by
`W` — the closure in `𝐏(V)` of the generic point of `r_W^{-1}(Z)` — has dimension at least
`d + c + 1`.

This is the bound the proof of Stacks 0B0E needs on the subvariety `C ⊂ 𝐏^N` it constructs: with
`dim V = N + 1` and `dim W = n + 1` the corank of `W` is `N - n`, so `c + 1 = N - n` and the
bound reads `dim C ≥ d + (N - n)`. Together with `C ∩ X = π^{-1}(π(Z))`, whose dimension is `d`
because `π|_X` is finite, this is what makes `C` intersect `X` properly: proper intersection in
`𝐏^N` asks for `d + N ≤ dim C + n`.

## Main definitions

* `AlgebraicGeometry.ProjectiveSpaceOfModule.coneCl`: the cone over an irreducible closed subset
  of `𝐏(W)`, as an irreducible closed subset of `𝐏(V)`.

## Main results

* `AlgebraicGeometry.ProjectiveSpaceOfModule.coneCl_strictMono`: the cone construction is
  strictly monotone, so it carries a chain of irreducible closed subsets of `𝐏(W)` to a chain of
  the same length in `𝐏(V)`.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.closure_projectionPreimage_eq_coneCl`: `coneCl` is
  the closure of the cone, which is the subvariety `C` of Stacks 0B0E.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.le_topologicalKrullDim_coneCl`: the dimension bound.

## Implementation notes

**The chain.** Dimension is the Krull dimension of the lattice of irreducible closed subsets, so
a lower bound on `dim C` is exactly an explicit chain ending at `C`
(`AlgebraicGeometry.topologicalKrullDim_coe_eq_height` and `Order.length_le_height`). The chain
is built in two halves and spliced with `RelSeries.smash`:

* the **top** `d` steps are a chain inside `Z`, carried over by `coneCl`. That this is strictly
  monotone is the content of `coneGenericPoint`: the ideal generated by the homogeneous prime of
  `z` determines `z`, because it contracts back to it, so specialization in `𝐏(W)` and
  specialization of the cones' generic points are the same relation
  (`AlgebraicGeometry.ProjectiveSpaceOfModule.mem_closure_coneGenericPoint` in one direction,
  `AlgebraicGeometry.ProjectiveSpaceOfModule.mem_closure_of_coneGenericPoint_mem_closure` in the
  other).
* the **bottom** `c` steps are a chain inside the vertex. No flag of submodules is constructed
  for this: the vertex is itself an irreducible closed subset of `𝐏(V)` of dimension exactly `c`
  (`AlgebraicGeometry.ProjectiveSpaceOfModule.isIrreducible_linearSubspace` and
  `AlgebraicGeometry.ProjectiveSpaceOfModule.topologicalKrullDim_linearSubspace_of_finrank_eq`),
  so `Order.exists_series_of_le_height` produces the chain outright, and the strictness of each
  of its steps comes with it.

The one step joining the halves is `vertex ⊊ cone`: the vertex lies in the closure of the cone's
generic point by
`AlgebraicGeometry.ProjectiveSpaceOfModule.linearSubspace_subset_closure_coneGenericPoint`, and
the inclusion is strict because that generic point lies in the domain of definition of `r_W`,
which is the complement of the vertex.

**Why a lower bound only.** The proper-intersection criterion is an inequality in one direction,
so the exact dimension of `C` is never needed; the chain gives the bound with no upper bound to
prove.

## References

* [Stacks Project, Tag 0B0E](https://stacks.math.columbia.edu/tag/0B0E)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open Stacks.AlgebraicGeometry.ProjShared

namespace AlgebraicGeometry.ProjectiveSpaceOfModule

universe u

variable (k V : Type u) [Field k] [AddCommGroup V] [Module k V]

/-- **The cone over an irreducible closed subset of `𝐏(W)`.** The closure in `𝐏(V)` of the
generic point of the cone over `Z` with vertex the linear subspace cut out by `W`. By
`AlgebraicGeometry.ProjectiveSpaceOfModule.closure_projectionPreimage_inter_compl_eq` and
`AlgebraicGeometry.ProjectiveSpaceOfModule.linearSubspace_subset_closure_coneGenericPoint` it is
`r_W^{-1}(Z)` together with the whole vertex. -/
public def coneCl (W : Submodule k V)
    (Z : IrreducibleCloseds (projectiveSpaceOfModule k ↥W)) :
    IrreducibleCloseds (projectiveSpaceOfModule k V) where
  carrier := closure ({coneGenericPoint k V W Z.isIrreducible.genericPoint} :
    Set (projectiveSpaceOfModule k V))
  isIrreducible' := isIrreducible_singleton.closure
  isClosed' := isClosed_closure

/-- The underlying set of `coneCl k V W Z` is the closure in `𝐏(V)` of the generic point of the
cone over `Z`. -/
@[simp]
public theorem coe_coneCl (W : Submodule k V)
    (Z : IrreducibleCloseds (projectiveSpaceOfModule k ↥W)) :
    (coneCl k V W Z : Set (projectiveSpaceOfModule k V)) =
      closure ({coneGenericPoint k V W Z.isIrreducible.genericPoint} :
        Set (projectiveSpaceOfModule k V)) := rfl

/-- The generic point of the cone over `y` lies in the closure of the generic point of the cone over
`x` exactly when `y` lies in the closure of `x`. -/
private theorem coneGenericPoint_mem_closure_iff (W : Submodule k V)
    (x y : projectiveSpaceOfModule k ↥W) :
    coneGenericPoint k V W y ∈ closure {coneGenericPoint k V W x} ↔ y ∈ closure {x} :=
  ⟨mem_closure_of_coneGenericPoint_mem_closure k V W x y, fun h =>
    mem_closure_coneGenericPoint k V W x
      ⟨coneGenericPoint k V W y, coneGenericPoint_mem_projectionDomain k V W y⟩
      (by rwa [projection_base_coneGenericPoint])⟩

/-- **The cone construction is strictly monotone.** Two irreducible closed subsets of `𝐏(W)` are
nested exactly when the cones over them are, because the cone construction both preserves and
reflects specialization of generic points. So a chain of irreducible closed subsets of `𝐏(W)`
gives a chain of cones of the same length in `𝐏(V)`. -/
public theorem coneCl_strictMono (W : Submodule k V) : StrictMono (coneCl k V W) := by
  refine strictMono_of_le_iff_le fun Z Z' => ?_
  change (Z : Set (projectiveSpaceOfModule k ↥W)) ⊆ Z' ↔ closure _ ⊆ closure _
  rw [← specializes_iff_closure_subset, specializes_iff_mem_closure,
    coneGenericPoint_mem_closure_iff]
  conv_lhs => rw [← Z.isIrreducible.closure_genericPoint Z.isClosed',
    ← Z'.isIrreducible.closure_genericPoint Z'.isClosed', ← specializes_iff_closure_subset,
    specializes_iff_mem_closure]

/-- The generic point of the cone does not lie on the vertex, so the vertex is a *proper* closed
subset of the cone. -/
public theorem linearSubspace_lt_coneCl [FiniteDimensional k V] {W : Submodule k V} (hW : W ≠ ⊤)
    (Z : IrreducibleCloseds (projectiveSpaceOfModule k ↥W)) :
    (⟨linearSubspace k V W, isIrreducible_linearSubspace k V hW,
        isClosed_linearSubspace k V W⟩ : IrreducibleCloseds (projectiveSpaceOfModule k V)) <
      coneCl k V W Z := by
  refine lt_of_le_of_ne (linearSubspace_subset_closure_coneGenericPoint k V W _) fun heq => ?_
  have hle : coneCl k V W Z ≤ (⟨linearSubspace k V W, isIrreducible_linearSubspace k V hW,
      isClosed_linearSubspace k V W⟩ : IrreducibleCloseds (projectiveSpaceOfModule k V)) :=
    ge_of_eq heq
  have hsub : (coneCl k V W Z : Set (projectiveSpaceOfModule k V)) ⊆ linearSubspace k V W := hle
  have hdom : coneGenericPoint k V W Z.isIrreducible.genericPoint ∈
      ((projectionDomain k V W : (projectiveSpaceOfModule k V).Opens) :
        Set (projectiveSpaceOfModule k V)) :=
    coneGenericPoint_mem_projectionDomain k V W Z.isIrreducible.genericPoint
  rw [coe_mapDomain_subtype k V W] at hdom
  exact hdom (hsub (subset_closure rfl))

/-- **`coneCl` is the closure of the cone.** The cone over an irreducible closed subset `Z` of
`𝐏(W)` contains the generic point of the cone and is contained in its closure, so the two
closures agree. This is what makes the dimension bound below a bound on the subvariety `C` of
Stacks 0B0E, which is the closure of `r_W^{-1}(π(Z))`. -/
public theorem closure_projectionPreimage_eq_coneCl (W : Submodule k V)
    {Z : Set (projectiveSpaceOfModule k ↥W)} (hZ : IsIrreducible Z) (hZc : IsClosed Z) :
    closure (projectionPreimage k V W Z) =
      (coneCl k V W ⟨Z, hZ, hZc⟩ : Set (projectiveSpaceOfModule k V)) := by
  have hgen : closure ({hZ.genericPoint} : Set (projectiveSpaceOfModule k ↥W)) = Z :=
    hZ.closure_genericPoint hZc
  refine Set.Subset.antisymm (isClosed_closure.closure_subset_iff.mpr ?_)
    (isClosed_closure.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr (subset_closure ?_)))
  · rintro x ⟨y, hy, rfl⟩
    refine mem_closure_coneGenericPoint k V W hZ.genericPoint y ?_
    rwa [hgen]
  · refine ⟨⟨coneGenericPoint k V W hZ.genericPoint,
      coneGenericPoint_mem_projectionDomain k V W hZ.genericPoint⟩, ?_, rfl⟩
    show (projection k V W).base _ ∈ Z
    rw [projection_base_coneGenericPoint k V W hZ.genericPoint]
    exact hgen.subset (subset_closure rfl)

/-- **The dimension of the cone over a closed subvariety of `𝐏(W)`.** For `W` of corank `c + 1`
and `Z` an irreducible closed subset of `𝐏(W)` of dimension at least `d`, the cone over `Z` has
dimension at least `d + c + 1`.

In the proof of Stacks 0B0E this is the bound `dim C ≥ d + (N - n)` on the subvariety `C` of
`𝐏^N = 𝐏(V)`: there `W` has corank `N - n`, so `c + 1 = N - n`. -/
public theorem le_topologicalKrullDim_coneCl [FiniteDimensional k V] {W : Submodule k V} {c d : ℕ}
    (hc : Module.finrank k (V ⧸ W) = c + 1)
    (Z : IrreducibleCloseds (projectiveSpaceOfModule k ↥W))
    (hd : (d : WithBot ℕ∞) ≤
      topologicalKrullDim (Z : Set (projectiveSpaceOfModule k ↥W))) :
    ((d + c + 1 : ℕ) : WithBot ℕ∞) ≤
      topologicalKrullDim (coneCl k V W Z : Set (projectiveSpaceOfModule k V)) := by
  have hnt : Nontrivial (V ⧸ W) := Module.nontrivial_of_finrank_pos (R := k) (by rw [hc]; lia)
  have hW : W ≠ ⊤ := by
    intro h
    obtain ⟨u⟩ := (Submodule.unique_quotient_iff_eq_top (p := W)).mpr h
    exact not_subsingleton (V ⧸ W) (@Unique.instSubsingleton _ u)
  set L : IrreducibleCloseds (projectiveSpaceOfModule k V) :=
    ⟨linearSubspace k V W, isIrreducible_linearSubspace k V hW,
      isClosed_linearSubspace k V W⟩ with hLdef
  -- the bottom half of the chain: inside the vertex, which has dimension exactly `c`
  have hLheight : (c : ℕ∞) ≤ Order.height L := by
    have h := topologicalKrullDim_coe_eq_height L
    rw [show (L : Set (projectiveSpaceOfModule k V)) = linearSubspace k V W from rfl,
      topologicalKrullDim_linearSubspace_of_finrank_eq k V W hc] at h
    exact_mod_cast h.le
  obtain ⟨p, hplast, hplen⟩ := Order.exists_series_of_le_height L hLheight
  -- the top half: a chain inside `Z`, carried over by `coneCl`
  have hZheight : (d : ℕ∞) ≤ Order.height Z := by
    rw [topologicalKrullDim_coe_eq_height Z] at hd
    exact_mod_cast hd
  obtain ⟨q, hqlast, hqlen⟩ := Order.exists_series_of_le_height Z hZheight
  have hstep : p.last < coneCl k V W q.head := by
    rw [hplast, hLdef]
    exact linearSubspace_lt_coneCl k V hW q.head
  have hconnect : (p.snoc (coneCl k V W q.head) hstep).last =
      (q.map (coneCl k V W) (coneCl_strictMono k V W)).head := by simp
  set r := (p.snoc (coneCl k V W q.head) hstep).smash
    (q.map (coneCl k V W) (coneCl_strictMono k V W)) hconnect with hr
  have hrlast : r.last = coneCl k V W Z := by simp [hr, hqlast]
  have hrlen : r.length = d + c + 1 := by
    simp [hr, hplen, hqlen]
    lia
  have hle := Order.length_le_height (p := r) (x := coneCl k V W Z) (le_of_eq hrlast)
  rw [hrlen] at hle
  rw [topologicalKrullDim_coe_eq_height]
  exact_mod_cast hle

end AlgebraicGeometry.ProjectiveSpaceOfModule

end
