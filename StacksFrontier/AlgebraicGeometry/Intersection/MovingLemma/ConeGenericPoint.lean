module

public import StacksFrontier.AlgebraicGeometry.Intersection.Projections.LinearAction
public import StacksFrontier.AlgebraicGeometry.ProjShared.RelevantCover
public import StacksFrontier.AlgebraicGeometry.ProjTwistCompare.BaseMap
public import StacksFrontier.AlgebraicGeometry.Variety.Projective.AvoidingLines
public import StacksFrontier.LinearAlgebra.SymmetricPower.ComplementSplitting
public import StacksFrontier.Topology.Noetherian.IrreduciblePieceGenericPoint

/-!
# The generic point of the cone over a point of `𝐏(W)`

Let `W ≤ V` be a subspace and let `r_W : 𝐏(V) ∖ 𝐏(V/W) ⟶ 𝐏(W)` be the linear projection away
from the linear subspace cut out by `W`. A point `z` of `𝐏(W)` is a relevant homogeneous prime
`p ⊆ Sym(W)`, and the ideal `p·Sym(V)` it generates in `Sym(V)` is again a relevant homogeneous
prime: prime because `Sym(V)` is a polynomial ring over `Sym(W)`
(`SymPow.isPrime_map_symAlgMap_subtype`), relevant because the inclusion has a retraction, which
already forces `p·Sym(V)` to contract back to `p`.

The point of `𝐏(V)` it names lies off the linear subspace cut out by `W`, projects to `z`, and —
again because `p·Sym(V)` contracts to `p` — specializes to every point of `𝐏(V) ∖ 𝐏(V/W)` whose
projection specializes from `z`. It is therefore the generic point of the cone `r_W^{-1}(Z)` over
any closed subset `Z` of `𝐏(W)` with generic point `z`, which is what makes that cone
irreducible: this is the input to
`AlgebraicGeometry.ProjectiveSpaceOfModule.isIrreducible_projectionPreimage`, and the
irreducibility of the cone is needed twice in Stacks 0B0E — for `C` to be a subvariety of
`𝐏(V)`, and for the chain of nested cones which bounds `dim C` from below.

## Main definitions

* `AlgebraicGeometry.ProjectiveSpaceOfModule.coneGenericPoint`: the point of `𝐏(V)` cut out by
  the ideal of `Sym(V)` generated by the homogeneous prime of a point of `𝐏(W)`.

## Main results

* `AlgebraicGeometry.ProjectiveSpaceOfModule.comap_map_gradedSymAlgMap_subtype`: the ideal of
  `Sym(V)` generated by a homogeneous ideal of `Sym(W)` contracts along the inclusion back to it.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.coneGenericPoint_mem_projectionDomain`: the point
  lies in the domain of definition of `r_W`.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.projection_base_coneGenericPoint`: it projects to
  the point it was built from.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.mem_closure_coneGenericPoint`: every point of the
  domain of definition of `r_W` whose projection lies in the closure of `z` lies in the closure
  of the point.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.isPrime_map_asHomogeneousIdeal` and
  `AlgebraicGeometry.ProjectiveSpaceOfModule.not_irrelevant_le_map_asHomogeneousIdeal`: the two
  conditions making the generated ideal a point of `𝐏(V)`.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.linearSubspace_subset_closure_coneGenericPoint`: the
  whole vertex lies in the closure of the cone over a nonempty set.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.mem_closure_of_coneGenericPoint_mem_closure`: the
  cone construction reflects specialization, so a chain of irreducible closed subsets of `𝐏(W)`
  gives a chain of cones of the same length.

## Implementation notes

The contraction statement needs neither a basis nor the polynomial structure: a retraction
`q : V ⟶ W` of the inclusion induces, by `SymPow.gradedSymAlgMap_comp` and
`SymPow.gradedSymAlgMap_id`, a retraction `Sym(q)` of `Sym(W) ⟶ Sym(V)`, and `Sym(q)` carries
`p·Sym(V)` into `p`. Over a field a retraction exists for every subspace, so the statement
carries no hypotheses beyond `W` being a subspace.

The specialization statement is the Galois connection `Ideal.map_le_iff_le_comap` read through
`Stacks.AlgebraicGeometry.ProjTwistCompare.mapHom_base_asHomogeneousIdeal`, which identifies the
homogeneous prime at `r_W y` with the contraction of the homogeneous prime at `y`, together with
`ProjectiveSpectrum.le_iff_mem_closure`, which identifies specialization with containment of
homogeneous primes. No openness, flatness or fibre computation for `r_W` is involved.

## References

* [Stacks Project, Tag 0B0E](https://stacks.math.columbia.edu/tag/0B0E)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open Stacks.AlgebraicGeometry.ProjShared Stacks.AlgebraicGeometry.ProjTwistCompare

namespace AlgebraicGeometry.ProjectiveSpaceOfModule

universe u

variable (k V : Type u) [Field k] [AddCommGroup V] [Module k V]

/-- **The ideal of `Sym(V)` generated by a homogeneous ideal of `Sym(W)` contracts back to it.**
A retraction `V ⟶ W` of the inclusion of a subspace induces a retraction of `Sym(W) ⟶ Sym(V)`,
which carries the generated ideal into the ideal it was generated by. -/
public theorem comap_map_gradedSymAlgMap_subtype (W : Submodule k V)
    (p : HomogeneousIdeal (fun n => SymPow.symmetricPower n k ↥W)) :
    (p.map (SymPow.gradedSymAlgMap W.subtype)).comap (SymPow.gradedSymAlgMap W.subtype) = p := by
  obtain ⟨U, hU⟩ := exists_isCompl W
  have hqw : (W.projectionOnto U hU) ∘ₗ W.subtype = LinearMap.id := by
    refine LinearMap.ext fun w => ?_
    simp
  have hret : (SymPow.gradedSymAlgMap (W.projectionOnto U hU)).comp
      (SymPow.gradedSymAlgMap W.subtype) = .id _ := by
    rw [← SymPow.gradedSymAlgMap_comp, hqw, SymPow.gradedSymAlgMap_id]
  have hfun : ∀ x, (SymPow.gradedSymAlgMap (W.projectionOnto U hU))
      ((SymPow.gradedSymAlgMap W.subtype) x) = x := fun x => DFunLike.congr_fun hret x
  have hsub : Ideal.map (SymPow.gradedSymAlgMap W.subtype) p.toIdeal
      ≤ Ideal.comap (SymPow.gradedSymAlgMap (W.projectionOnto U hU)) p.toIdeal := by
    refine Ideal.map_le_iff_le_comap.mpr fun x hx => ?_
    change (SymPow.gradedSymAlgMap (W.projectionOnto U hU))
      ((SymPow.gradedSymAlgMap W.subtype) x) ∈ p.toIdeal
    rwa [hfun x]
  refine HomogeneousIdeal.toIdeal_injective
    (le_antisymm (fun a ha => ?_) Ideal.le_comap_map)
  have hmem : (SymPow.gradedSymAlgMap W.subtype) a
      ∈ Ideal.map (SymPow.gradedSymAlgMap W.subtype) p.toIdeal := ha
  have h2 : (SymPow.gradedSymAlgMap (W.projectionOnto U hU))
      ((SymPow.gradedSymAlgMap W.subtype) a) ∈ p.toIdeal := hsub hmem
  rwa [hfun a] at h2

/-- A positive-degree homogeneous element of `Sym(W)` omitted by a point of `𝐏(W)` has its image
in `Sym(V)` omitted by the ideal that point generates there. -/
private theorem notMem_map_asHomogeneousIdeal (W : Submodule k V)
    (z : projectiveSpaceOfModule k ↥W) {f : SymmetricAlgebra k ↥W}
    (hfz : f ∉ z.asHomogeneousIdeal) :
    (SymPow.gradedSymAlgMap W.subtype) f ∉
      z.asHomogeneousIdeal.map (SymPow.gradedSymAlgMap W.subtype) := by
  intro hmem
  refine hfz ?_
  have h : f ∈ (z.asHomogeneousIdeal.map (SymPow.gradedSymAlgMap W.subtype)).comap
      (SymPow.gradedSymAlgMap W.subtype) := hmem
  rwa [comap_map_gradedSymAlgMap_subtype k V W] at h

/-- The ideal of `Sym(V)` generated by the homogeneous prime of a point of `𝐏(W)` is prime. -/
public theorem isPrime_map_asHomogeneousIdeal (W : Submodule k V)
    (z : projectiveSpaceOfModule k ↥W) :
    (z.asHomogeneousIdeal.map (SymPow.gradedSymAlgMap W.subtype)).toIdeal.IsPrime := by
  rw [HomogeneousIdeal.toIdeal_map]
  exact SymPow.isPrime_map_symAlgMap_subtype W z.isPrime

/-- The ideal of `Sym(V)` generated by the homogeneous prime of a point of `𝐏(W)` is relevant:
the image of a positive-degree homogeneous element omitted by that prime is omitted by it. -/
public theorem not_irrelevant_le_map_asHomogeneousIdeal (W : Submodule k V)
    (z : projectiveSpaceOfModule k ↥W) :
    ¬ HomogeneousIdeal.irrelevant (fun n => SymPow.symmetricPower n k V) ≤
      z.asHomogeneousIdeal.map (SymPow.gradedSymAlgMap W.subtype) := by
  obtain ⟨n, f, hn, hf, hfz⟩ := exists_homogeneous_pos_notMem _ z
  intro hle
  refine notMem_map_asHomogeneousIdeal k V W z hfz ?_
  exact hle (HomogeneousIdeal.mem_irrelevant_of_mem _ hn
    ((SymPow.gradedSymAlgMap W.subtype).map_mem hf))

/-- **The generic point of the cone over a point of `𝐏(W)`.** The homogeneous prime of a point
`z` of `𝐏(W)` generates a relevant homogeneous prime of `Sym(V)`, hence a point of `𝐏(V)`: the
generic point of the cone `r_W^{-1}(closure {z})` with vertex the linear subspace cut out by
`W`. -/
public def coneGenericPoint (W : Submodule k V) (z : projectiveSpaceOfModule k ↥W) :
    projectiveSpaceOfModule k V :=
  (⟨z.asHomogeneousIdeal.map (SymPow.gradedSymAlgMap W.subtype),
    isPrime_map_asHomogeneousIdeal k V W z,
    not_irrelevant_le_map_asHomogeneousIdeal k V W z⟩ :
      ProjectiveSpectrum (fun n => SymPow.symmetricPower n k V))

/-- The homogeneous prime of `coneGenericPoint k V W z` is the ideal of `Sym(V)` generated by the
homogeneous prime of `z`. -/
@[simp]
public theorem asHomogeneousIdeal_coneGenericPoint (W : Submodule k V)
    (z : projectiveSpaceOfModule k ↥W) :
    (coneGenericPoint k V W z).asHomogeneousIdeal =
      z.asHomogeneousIdeal.map (SymPow.gradedSymAlgMap W.subtype) := rfl

/-- **The generic point of the cone lies off the vertex**, that is, in the domain of definition
of the projection away from `W`: the image of a positive-degree homogeneous element omitted by
`z` is omitted by it. -/
public theorem coneGenericPoint_mem_projectionDomain (W : Submodule k V)
    (z : projectiveSpaceOfModule k ↥W) :
    coneGenericPoint k V W z ∈ projectionDomain k V W := by
  obtain ⟨n, f, hn, hf, hfz⟩ := exists_homogeneous_pos_notMem _ z
  exact (mem_mapDomain_iff _ _ _ (coneGenericPoint k V W z)).mpr
    ⟨n, f, hn, hf, notMem_map_asHomogeneousIdeal k V W z hfz⟩

/-- **The generic point of the cone projects to the point it was built from.** The homogeneous
prime at the image is the contraction of the homogeneous prime at the point, and the ideal
generated by `z` contracts back to `z`. -/
public theorem projection_base_coneGenericPoint (W : Submodule k V)
    (z : projectiveSpaceOfModule k ↥W) :
    (projection k V W).base
        ⟨coneGenericPoint k V W z, coneGenericPoint_mem_projectionDomain k V W z⟩ = z :=
  ProjectiveSpectrum.ext
    ((mapHom_base_asHomogeneousIdeal _ _ (SymPow.gradedSymAlgMap W.subtype) _).trans
      (comap_map_gradedSymAlgMap_subtype k V W z.asHomogeneousIdeal))

/-- **The generic point of the cone specializes to every point of the cone.** A point of the
domain of definition of `r_W` whose projection lies in the closure of `z` lies in the closure of
the generic point of the cone over `z`: the homogeneous prime at the projection is the
contraction of the homogeneous prime at the point, so containing `z` is the same as containing
the ideal `z` generates. -/
public theorem mem_closure_coneGenericPoint (W : Submodule k V)
    (z : projectiveSpaceOfModule k ↥W) (y : (projectionDomain k V W).toScheme)
    (hy : (projection k V W).base y ∈ closure ({z} : Set (projectiveSpaceOfModule k ↥W))) :
    (y.1 : projectiveSpaceOfModule k V) ∈
      closure ({coneGenericPoint k V W z} : Set (projectiveSpaceOfModule k V)) := by
  have hle : z.asHomogeneousIdeal ≤ ((projection k V W).base y).asHomogeneousIdeal :=
    (ProjectiveSpectrum.le_iff_mem_closure _ z ((projection k V W).base y)).mpr hy
  have heq : ((projection k V W).base y).asHomogeneousIdeal
      = (y.1 : projectiveSpaceOfModule k V).asHomogeneousIdeal.comap
        (SymPow.gradedSymAlgMap W.subtype) :=
    mapHom_base_asHomogeneousIdeal _ _ (SymPow.gradedSymAlgMap W.subtype) y
  rw [heq] at hle
  refine (ProjectiveSpectrum.le_iff_mem_closure _ (coneGenericPoint k V W z) y.1).mp ?_
  exact HomogeneousIdeal.map_le_of_le_comap _ hle

/-- **A point of `𝐏(V)` contains no nonzero scalar**, so its homogeneous prime lies inside the
irrelevant ideal: the degree-zero component of any of its elements is a scalar belonging to it,
hence zero. -/
public theorem asHomogeneousIdeal_le_irrelevant (z : projectiveSpaceOfModule k V) :
    z.asHomogeneousIdeal ≤
      HomogeneousIdeal.irrelevant (fun n => SymPow.symmetricPower n k V) := by
  intro a ha
  rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
  exact eq_zero_of_mem_symmetricPower_zero k V z
    (DirectSum.decompose (fun n => SymPow.symmetricPower n k V) a 0).2
    (z.asHomogeneousIdeal.isHomogeneous 0 ha)

/-- **The vertex lies in the closure of the generic point of the cone.** A point of the linear
subspace cut out by `W` contains the image of the irrelevant ideal of `Sym(W)`, which contains
the ideal generated by the homogeneous prime of `z`; so the generic point of the cone specializes
to it.

Together with
`AlgebraicGeometry.ProjectiveSpaceOfModule.closure_projectionPreimage_inter_compl_eq` this says
that the closure of the cone over a nonempty set is the cone together with the whole vertex. -/
public theorem linearSubspace_subset_closure_coneGenericPoint (W : Submodule k V)
    (z : projectiveSpaceOfModule k ↥W) :
    linearSubspace k V W ⊆
      closure ({coneGenericPoint k V W z} : Set (projectiveSpaceOfModule k V)) := by
  intro y hy
  have hyv : y ∉ projectionDomain k V W := by
    intro hcon
    have hset : y ∈ (projectionDomain k V W : Set (projectiveSpaceOfModule k V)) := hcon
    rw [coe_mapDomain_subtype k V W] at hset
    exact hset hy
  have hirr := (notMem_mapDomain_iff _ _ (SymPow.gradedSymAlgMap W.subtype) y).mp hyv
  refine (ProjectiveSpectrum.le_iff_mem_closure _ (coneGenericPoint k V W z) y).mp
    ((ProjectiveSpectrum.as_ideal_le_as_ideal _ _ _).mp ?_)
  rw [asHomogeneousIdeal_coneGenericPoint]
  exact le_trans (HomogeneousIdeal.map_mono (SymPow.gradedSymAlgMap W.subtype)
    (asHomogeneousIdeal_le_irrelevant k ↥W z)) hirr

/-- **The cone construction reflects specialization.** If the generic point of the cone over `z'`
lies in the closure of the generic point of the cone over `z`, then `z'` lies in the closure of
`z`: the generated ideals are ordered as the ideals they are generated by, because each contracts
back to the one it came from.

With `AlgebraicGeometry.ProjectiveSpaceOfModule.mem_closure_coneGenericPoint` this makes the cone
construction an order embedding for specialization, so a strictly increasing chain of irreducible
closed subsets of `𝐏(W)` gives a strictly increasing chain of cones of the same length in
`𝐏(V)` — the chain which bounds `dim C` from below in Stacks 0B0E. -/
public theorem mem_closure_of_coneGenericPoint_mem_closure (W : Submodule k V)
    (z z' : projectiveSpaceOfModule k ↥W)
    (h : coneGenericPoint k V W z' ∈
      closure ({coneGenericPoint k V W z} : Set (projectiveSpaceOfModule k V))) :
    z' ∈ closure ({z} : Set (projectiveSpaceOfModule k ↥W)) := by
  have hle : (coneGenericPoint k V W z).asHomogeneousIdeal
      ≤ (coneGenericPoint k V W z').asHomogeneousIdeal :=
    (ProjectiveSpectrum.le_iff_mem_closure _ (coneGenericPoint k V W z)
      (coneGenericPoint k V W z')).mpr h
  rw [asHomogeneousIdeal_coneGenericPoint, asHomogeneousIdeal_coneGenericPoint] at hle
  have h1 := HomogeneousIdeal.comap_mono (SymPow.gradedSymAlgMap W.subtype) hle
  rw [comap_map_gradedSymAlgMap_subtype k V W, comap_map_gradedSymAlgMap_subtype k V W] at h1
  exact (ProjectiveSpectrum.le_iff_mem_closure _ z z').mp h1

end AlgebraicGeometry.ProjectiveSpaceOfModule

end
