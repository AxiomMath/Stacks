module

public import StacksFrontier.AlgebraicGeometry.Intersection.AlgebraicMultiplicities.FiniteLengthConditions

/-!
# Powers after adjoining or quotienting by the annihilator

For an ideal `I` acting on a module `M`, adjoining the annihilator of `M` to `I` does not
change the submodule generated by any power of `I`. Likewise, after viewing `M` as a module
over the quotient of the ring by its annihilator, the powers of the image of `I` generate the
same submodules. Together these let the generalized Hilbert–Samuel theory of a module be
transported to the quotient ring on which its annihilator vanishes.

## Main results

* `Ideal.add_annihilator_pow_smul_top` identifies the submodules generated before and after
  adjoining the annihilator.
* `Ideal.map_quotientAnnihilator_pow_smul_top` identifies the submodules generated over the
  ring and over its quotient by the module's annihilator.

## Implementation notes

The equalities of quotient modules in the source are expressed as equalities of their
denominator submodules. For the second equality, the submodule over the quotient ring is
restricted back to the original ring. The finite-length hypotheses of the surrounding result
are unnecessary for these equalities and are therefore omitted.

## References

* [Stacks Project, Tag 0B00](https://stacks.math.columbia.edu/tag/0B00)
-/

@[expose] public section

namespace Ideal

/-- **Stacks Project, Tag 0B00, quotient power equalities.** Adjoining the annihilator of a
module to an ideal does not change the submodule generated by any power of that ideal. -/
@[stacks 0B00 "quotient_power_equalities"]
lemma add_annihilator_pow_smul_top
    {R M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M]
    (I : Ideal R) (n : ℕ) :
    (I + Module.annihilator R M) ^ n • (⊤ : Submodule R M) =
      I ^ n • (⊤ : Submodule R M) := by
  suffices h : ∀ N : Submodule R M,
      (I + Module.annihilator R M) ^ n • N = I ^ n • N from h ⊤
  intro N
  induction n generalizing N with
  | zero => rfl
  | succ n hn =>
      have h : Module.annihilator R M • N = ⊥ := eq_bot_iff.mpr
        ((smul_mono_right _ le_top).trans_eq (by simpa [Submodule.annihilator_top] using
          (Submodule.annihilator_smul (⊤ : Submodule R M))))
      rw [pow_succ, Submodule.mul_smul, Ideal.add_eq_sup, Submodule.sup_smul,
        h, sup_bot_eq, ← Ideal.add_eq_sup, hn, ← Submodule.mul_smul, ← pow_succ]

/-- **Stacks Project, Tag 0B00, quotient power equalities.** If `M` is regarded as a module
over `R / Ann(M)`, the image of a power of `I` generates the same submodule as that power of
`I` does over `R`. -/
@[stacks 0B00 "quotient_power_equalities"]
lemma map_quotientAnnihilator_pow_smul_top
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (I : Ideal R) (n : ℕ) :
    letI : Module (R ⧸ Module.annihilator R M) M := Module.quotientAnnihilator
    ((Ideal.map (Ideal.Quotient.mk (Module.annihilator R M)) I) ^ n •
        (⊤ : Submodule (R ⧸ Module.annihilator R M) M)).restrictScalars R =
      I ^ n • (⊤ : Submodule R M) := by
  let _ : Module (R ⧸ Module.annihilator R M) M := Module.quotientAnnihilator
  rw [← Ideal.map_pow, ← Ideal.Quotient.algebraMap_eq,
    Ideal.smul_restrictScalars, Submodule.restrictScalars_top]

end Ideal
