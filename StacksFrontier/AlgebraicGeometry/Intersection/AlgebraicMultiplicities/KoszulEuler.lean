/-!
# Multiplicity as an Euler characteristic of Koszul homology

Let an ideal of definition of a Noetherian local ring be generated by a finite sequence. The
Hilbert–Samuel multiplicity in the length of that sequence is the Euler characteristic of the
homology of the corresponding Koszul complex with coefficients in a finite module.

The proof filters the Koszul complex by powers of the ideal, shifting the exponent by the
homological degree. The resulting alternating sum of colengths is, on one side, an
alternating binomial combination of the Hilbert–Samuel function and hence an iterated forward
difference of its computing polynomial, and on the other side the Euler characteristic of the
Koszul homology, because the filtration is eventually exact in each degree.

## Main results

* `Ideal.hilbertSamuelMultiplicity_eq_alternatingSum_koszulHomology_length` expresses
  Hilbert–Samuel multiplicity as the alternating sum of the lengths of Koszul homology.

## Implementation notes

The Koszul complex on a sequence indexed by `Fin r` is supported in degrees `0` through `r`,
so the source's unrestricted alternating sum is written as a sum over `Fin (r + 1)`. Module
length takes values in `ℕ∞`; the hypotheses imply that the homology modules have finite
length, and `ENat.toNat` records those finite values before coercion to `ℚ`.

## References

* [Stacks Project, Tag 0AZZ](https://stacks.math.columbia.edu/tag/0AZZ)
* [Serre, *Algèbre locale. Multiplicités*][Serre_algebre_locale]
-/

@[expose] public section

open CategoryTheory Filter Polynomial

namespace Ideal

open scoped TensorProduct ExteriorAlgebra

universe u v

/-- Tensoring with a fixed module, as a functor on modules. -/
private noncomputable def tensorCoefficients {A : Type u} [CommRing A]
    (M : Type v) [AddCommGroup M] [Module A M] :
    ModuleCat.{u} A ⥤ ModuleCat.{max u v} A where
  obj N := ModuleCat.of A (N ⊗[A] M)
  map g := ModuleCat.ofHom (LinearMap.rTensor M g.hom)
  map_id N := by ext; simp
  map_comp g h := by ext; simp [← LinearMap.rTensor_comp]

/-- Tensoring with a fixed module is additive. -/
private theorem tensorCoefficients_additive {A : Type u} [CommRing A]
    (M : Type v) [AddCommGroup M] [Module A M] :
    (tensorCoefficients (A := A) M).Additive where
  map_add := ModuleCat.hom_ext (LinearMap.rTensor_add M _ _)

/-- Tensoring with a fixed module is linear over the base ring. -/
private theorem tensorCoefficients_linear {A : Type u} [CommRing A]
    (M : Type v) [AddCommGroup M] [Module A M] :
    (tensorCoefficients (A := A) M).Linear A where
  map_smul f a := ModuleCat.hom_ext (LinearMap.rTensor_smul M a f.hom)

attribute [local instance] tensorCoefficients_additive tensorCoefficients_linear

/-- The Koszul complex with coefficients is the image of the Koszul complex under tensoring
with the coefficient module. -/
private noncomputable def koszulTensorFunctorIso {A : Type u} [CommRing A]
    {r : ℕ} (f : Fin r → A) (M : Type v) [AddCommGroup M] [Module A M] :
    Koszul.seqComplexTensor f M ≅
      ((tensorCoefficients (A := A) M).mapHomologicalComplex (.down ℕ)).obj
        (Koszul.seqComplex f) := by
  refine HomologicalComplex.Hom.isoOfComponents (fun _ => Iso.refl _) ?_
  intro i j hij
  obtain rfl : i = j + 1 := hij.symm
  simp only [Iso.refl_hom,
    Functor.mapHomologicalComplex_obj_d, Koszul.seqComplexTensor_d, Koszul.seqComplex_d]
  rfl

/-- The homology map induced by a scalar multiple of the identity is that scalar multiple of
the identity. -/
private lemma homologyMap_smul_id {A : Type*} [CommRing A] (a : A)
    (C : ChainComplex (ModuleCat.{v} A) ℕ) (n : ℕ) :
    HomologicalComplex.homologyMap (a • 𝟙 C) n = a • 𝟙 _ := by
  have hcyc : HomologicalComplex.cyclesMap (a • 𝟙 C) n = a • 𝟙 _ := by
    rw [← cancel_mono (C.iCycles n), HomologicalComplex.cyclesMap_i]
    simp [Linear.smul_comp, Linear.comp_smul]
  rw [← cancel_epi (C.homologyπ n), HomologicalComplex.homologyπ_naturality, hcyc]
  simp [Linear.smul_comp, Linear.comp_smul]

/-- Each generator acts null-homotopically on the Koszul complex with coefficients. -/
private lemma koszulTensor_nullHomotopic {A : Type u} [CommRing A]
    {r : ℕ} (f : Fin r → A) (M : Type v) [AddCommGroup M] [Module A M] (i : Fin r) :
    Nonempty (Homotopy (f i • 𝟙 (Koszul.seqComplexTensor f M)) 0) := by
  let F := tensorCoefficients (A := A) M
  let e := koszulTensorFunctorIso f M
  have hscalar : (F.mapHomologicalComplex (.down ℕ)).map (f i • 𝟙 (Koszul.seqComplex f)) =
      f i • 𝟙 _ := by simp
  exact ⟨by simpa only [hscalar, Functor.map_zero, Limits.comp_zero, Limits.zero_comp,
    Linear.comp_smul, Linear.smul_comp, Category.comp_id, Iso.hom_inv_id] using
      ((F.mapHomotopy ((Koszul.koszulSeq_smul_nullHomotopic_and_span_le_annihilator f).1
        i).some).compLeft e.hom |>.compRight e.inv)⟩

/-- The ideal generated by the sequence annihilates the Koszul homology. -/
private lemma koszulTensor_annihilator {A : Type u} [CommRing A]
    {r : ℕ} (f : Fin r → A) (M : Type v) [AddCommGroup M] [Module A M] (n : ℕ) :
    Ideal.span (Set.range f) ≤ Module.annihilator A
      ((Koszul.seqComplexTensor f M).homology n) := by
  apply Ideal.span_le.mpr
  rintro a ⟨i, rfl⟩
  have hm := (koszulTensor_nullHomotopic f M i).some.homologyMap_eq n
  rw [homologyMap_smul_id, HomologicalComplex.homologyMap_zero] at hm
  exact Module.mem_annihilator.mpr fun x => congrArg (fun q => q.hom x) hm

/-- The Koszul homology of a finite module over a Noetherian ring is finite. -/
private lemma koszulTensor_homology_finite {A : Type*} [CommRing A] [IsNoetherianRing A]
    {r : ℕ} (f : Fin r → A) (M : Type*) [AddCommGroup M] [Module A M]
    [Module.Finite A M] (n : ℕ) :
    Module.Finite A ((Koszul.seqComplexTensor f M).homology n) := by
  let C := Koszul.seqComplexTensor f M
  have : Module.Finite A (C.X n) :=
    inferInstanceAs (Module.Finite A ((⋀[A]^n (Fin r → A)) ⊗[A] M))
  have : Module.Finite A (C.cycles n) :=
    .of_injective (C.iCycles n).hom ((ModuleCat.mono_iff_injective _).mp inferInstance)
  exact .of_surjective (C.homologyπ n).hom ((ModuleCat.epi_iff_surjective _).mp inferInstance)

/-- A finite module annihilated by an ideal of definition has finite length. -/
private lemma length_lt_top_of_idealOfDefinition_le_annihilator
    {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (I : Ideal A) (hI : IsIdealOfDefinition I) (N : Type*)
    [AddCommGroup N] [Module A N] [Module.Finite A N]
    (hN : I ≤ Module.annihilator A N) : Module.length A N < ⊤ := by
  obtain ⟨k, hk⟩ := Ideal.exists_pow_le_of_le_radical_of_fg
    (show IsLocalRing.maximalIdeal A ≤ I.radical by rw [hI])
    (IsNoetherian.noetherian _)
  exact length_lt_top_of_pow_smul_eq_bot (IsLocalRing.maximalIdeal A) (IsNoetherian.noetherian _) k
    <| le_bot_iff.mp <| Submodule.smul_le.mpr fun a ha x _ =>
      Module.mem_annihilator.mp (hN (hk ha)) x

/-- The Koszul homology on a generating sequence of an ideal of definition has finite
length. -/
private lemma koszulTensor_homology_length_lt_top
    {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (I : Ideal A) {r : ℕ} (f : Fin r → A) (M : Type*)
    [AddCommGroup M] [Module A M] [Module.Finite A M]
    (hI : IsIdealOfDefinition I) (hf : I = Ideal.span (Set.range f)) (n : ℕ) :
    Module.length A ((Koszul.seqComplexTensor f M).homology n) < ⊤ := by
  have := koszulTensor_homology_finite f M n
  exact length_lt_top_of_idealOfDefinition_le_annihilator I hI _
    (hf ▸ koszulTensor_annihilator f M n)

/-- The Koszul differential of a sequence is the corresponding combination of the coordinate
differentials. -/
private lemma koszul_d_eq_sum {A : Type*} [CommRing A] {r : ℕ}
    (f : Fin r → A) (n : ℕ) :
    Koszul.d (Koszul.seqDual f) n = ∑ i, f i • Koszul.d (LinearMap.proj i) n := by
  refine LinearMap.ext fun x => Subtype.ext ?_
  simp [Koszul.d, Koszul.contraction, Koszul.seqDual_eq_sum_smul_proj, map_sum, map_smul]

/-- The same decomposition after tensoring with the coefficient module. -/
private lemma koszulTensor_d_eq_sum {A : Type*} [CommRing A] {r : ℕ}
    (f : Fin r → A) (M : Type*) [AddCommGroup M] [Module A M] (n : ℕ) :
    LinearMap.rTensor M (Koszul.d (Koszul.seqDual f) n) =
      ∑ i, f i • LinearMap.rTensor M (Koszul.d (LinearMap.proj i) n) := by
  rw [koszul_d_eq_sum]
  exact (map_sum (LinearMap.rTensorHom M) _ _).trans (by simp only [map_smul]; rfl)

/-- A combination of maps with coefficients in an ideal raises the filtration degree by
one. -/
private lemma sum_smul_mem_pow_smul {A U V : Type*} [CommRing A]
    [AddCommMonoid U] [Module A U] [AddCommMonoid V] [Module A V]
    {ι : Type*} [Fintype ι] (I : Ideal A) (f : ι → A) (g : ι → U →ₗ[A] V)
    (hf : ∀ i, f i ∈ I) (k : ℕ) (x : U) (hx : x ∈ I ^ k • (⊤ : Submodule A U)) :
    (∑ i, f i • g i) x ∈ I ^ (k + 1) • (⊤ : Submodule A V) := by
  simp only [LinearMap.sum_apply, LinearMap.smul_apply]
  refine Submodule.sum_mem _ fun i _ => ?_
  rw [pow_succ', mul_smul]
  exact Submodule.smul_mem_smul (hf i) (Submodule.smul_top_le_comap_smul_top (I ^ k) (g i) hx)

/-- The Koszul differential with coefficients raises the `I`-adic filtration degree by one. -/
private lemma koszulTensor_d_mem_pow_smul {A : Type*} [CommRing A]
    (I : Ideal A) {r : ℕ} (f : Fin r → A) (M : Type*) [AddCommGroup M] [Module A M]
    (hf : ∀ i, f i ∈ I) (n k : ℕ)
    {x : (⋀[A]^(n + 1) (Fin r → A)) ⊗[A] M}
    (hx : x ∈ I ^ k • (⊤ : Submodule A ((⋀[A]^(n + 1) (Fin r → A)) ⊗[A] M))) :
    (LinearMap.rTensor M (Koszul.d (Koszul.seqDual f) n)) x ∈
      I ^ (k + 1) • (⊤ : Submodule A ((⋀[A]^n (Fin r → A)) ⊗[A] M)) := by
  rw [koszulTensor_d_eq_sum]
  exact sum_smul_mem_pow_smul (U := (⋀[A]^(n + 1) (Fin r → A)) ⊗[A] M)
    (V := (⋀[A]^n (Fin r → A)) ⊗[A] M) I f
    (fun i => LinearMap.rTensor M
      (Koszul.d (LinearMap.proj i : (Fin r → A) →ₗ[A] A) n)) hf k x hx

/-- The `I`-adic filtration of the Koszul complex, shifted by the homological degree. -/
private noncomputable abbrev koszulFiltrationStep {A : Type*} [CommRing A] (I : Ideal A)
    {r : ℕ} (f : Fin r → A) (M : Type*) [AddCommGroup M] [Module A M]
    (p : ℤ) (n : ℕ) : Submodule A ((Koszul.seqComplexTensor f M).X n) :=
  I ^ (p - n).toNat • ⊤

/-- The shifted filtration is antitone in the filtration index. -/
private lemma koszulFiltrationStep_antitone {A : Type*} [CommRing A] (I : Ideal A)
    {r : ℕ} (f : Fin r → A) (M : Type*) [AddCommGroup M] [Module A M] (n : ℕ) :
    Antitone (fun p => koszulFiltrationStep I f M p n) :=
  fun _ _ _ => Submodule.smul_mono (Ideal.pow_le_pow_right (Int.toNat_le_toNat (by omega))) le_rfl

/-- The differential respects the shifted filtration. -/
private lemma koszulFiltrationStep_d {A : Type*} [CommRing A] (I : Ideal A)
    {r : ℕ} (f : Fin r → A) (M : Type*) [AddCommGroup M] [Module A M]
    (hf : ∀ i, f i ∈ I) (p : ℤ) (n : ℕ) :
    koszulFiltrationStep I f M p (n + 1) ≤
      (koszulFiltrationStep I f M p n).comap
        ((Koszul.seqComplexTensor f M).d (n + 1) n).hom := by
  intro x hx
  change ((Koszul.seqComplexTensor f M).d (n + 1) n).hom x ∈
    I ^ (p - n).toNat • (⊤ : Submodule A ((Koszul.seqComplexTensor f M).X n))
  rw [Koszul.seqComplexTensor_d]
  exact Submodule.smul_mono (Ideal.pow_le_pow_right (by omega)) le_rfl
    (koszulTensor_d_mem_pow_smul I f M hf n (p - (n + 1 : ℕ)).toNat hx)

/-- A null homotopy for multiplication by `a` exhibits `a` times a cycle as a boundary. -/
private lemma smul_cycle_eq_boundary {A : Type*} [CommRing A]
    (C : ChainComplex (ModuleCat.{v} A) ℕ) (a : A) (h : Homotopy (a • 𝟙 C) 0)
    (n : ℕ) (x : C.X n) (hx : (C.d n (n - 1)).hom x = 0) :
    a • x = (C.d (n + 1) n).hom ((h.hom n (n + 1)).hom x) := by
  have hc := h.comm n
  rw [dNext_nat, Homotopy.prevD_chainComplex] at hc
  simpa [ModuleCat.hom_add, ModuleCat.hom_comp, hx] using congrArg (fun g => g.hom x) hc

/-- The Artin–Rees property in the form needed for the filtration: eventually, intersecting a
power of `I` with a submodule is the same as multiplying the previous intersection by `I`. -/
private lemma exists_pow_succ_inf_eq_smul {A : Type*} [CommRing A] [IsNoetherianRing A]
    (I : Ideal A) (N : Type*) [AddCommGroup N] [Module A N] [Module.Finite A N]
    (S : Submodule A N) :
    ∃ k : ℕ, ∀ l ≥ k, I ^ (l + 1) • ⊤ ⊓ S = I • (I ^ l • ⊤ ⊓ S) := by
  obtain ⟨k, hk⟩ := I.exists_pow_inf_eq_pow_smul S
  refine ⟨k, fun l hl => ?_⟩
  rw [hk (l + 1) (by omega), hk l hl, ← mul_smul, ← pow_succ']
  congr 2
  omega

/-- Eventually, the filtered cycles in a degree are filtered boundaries: the null homotopies
of the generators convert a cycle multiplied by a generator into a boundary. -/
private lemma exists_pow_cycles_le_boundaries {A : Type*} [CommRing A] [IsNoetherianRing A]
    (C : ChainComplex (ModuleCat.{v} A) ℕ) (I : Ideal A) {r : ℕ} (f : Fin r → A)
    (hf : I = Ideal.span (Set.range f))
    (hh : ∀ i, Nonempty (Homotopy (f i • 𝟙 C) 0))
    (n : ℕ) [Module.Finite A (C.X n)] :
    ∃ k : ℕ, ∀ l ≥ k,
      I ^ (l + 1) • ⊤ ⊓ LinearMap.ker (C.d n (n - 1)).hom ≤
        (I ^ l • (⊤ : Submodule A (C.X (n + 1)))).map (C.d (n + 1) n).hom := by
  obtain ⟨k, hk⟩ := exists_pow_succ_inf_eq_smul I (C.X n)
    (LinearMap.ker (C.d n (n - 1)).hom)
  refine ⟨k, fun l hl => ?_⟩
  rw [hk l hl]
  refine Submodule.smul_le.mpr fun a ha z hz => ?_
  rw [hf] at ha
  induction ha using Submodule.span_induction with
  | mem a ha =>
    obtain ⟨i, rfl⟩ := ha
    let h := (hh i).some
    exact Submodule.mem_map.mpr ⟨(h.hom n (n + 1)).hom z,
      Submodule.smul_top_le_comap_smul_top (I ^ l) (h.hom n (n + 1)).hom hz.1,
      (smul_cycle_eq_boundary C (f i) h n z hz.2).symm⟩
  | zero => simp
  | add a b _ _ ha hb =>
    rw [add_smul]
    exact Submodule.add_mem _ ha hb
  | smul a b _ hb =>
    rw [smul_eq_mul, mul_smul]
    exact Submodule.smul_mem _ a hb

/-- Length is additive along a submodule and its quotient. -/
private lemma length_eq_length_sub_add_length_quot
    {A N : Type*} [Ring A] [AddCommGroup N] [Module A N] (S : Submodule A N) :
    Module.length A N = Module.length A S + Module.length A (N ⧸ S) :=
  Module.length_eq_add_of_exact S.subtype S.mkQ S.subtype_injective S.mkQ_surjective
    (LinearMap.exact_subtype_mkQ S)

/-- Splitting the colength of `P` along a submodule `S`. -/
private lemma length_quotient_eq_add
    {A N : Type*} [Ring A] [AddCommGroup N] [Module A N] (P S : Submodule A N) :
    Module.length A (N ⧸ P) =
      Module.length A (S ⧸ P.comap S.subtype) + Module.length A (N ⧸ (P ⊔ S)) := by
  rw [length_eq_length_sub_add_length_quot (S.map P.mkQ)]
  congr 1
  · let g : S →ₗ[A] S.map P.mkQ := (P.mkQ.comp S.subtype).codRestrict _
      (fun x => Submodule.mem_map.mpr ⟨x, x.2, rfl⟩)
    have hg : Function.Surjective g := by
      rintro ⟨y, x, hx, rfl⟩
      exact ⟨⟨x, hx⟩, rfl⟩
    have hker : LinearMap.ker g = P.comap S.subtype := by
      ext x
      simp [g, LinearMap.mem_ker]
    exact (g.quotKerEquivOfSurjective hg).length_eq.symm.trans (by rw [hker])
  · exact (P.quotientQuotientEquivQuotientSup S).length_eq

/-- The colength of the image of `P` under a surjection. -/
private lemma length_quotient_sup_ker
    {A U V : Type*} [Ring A] [AddCommGroup U] [Module A U]
    [AddCommGroup V] [Module A V] (g : U →ₗ[A] V) (hg : Function.Surjective g)
    (P : Submodule A U) :
    Module.length A (U ⧸ (P ⊔ LinearMap.ker g)) = Module.length A (V ⧸ P.map g) := by
  let q := (P.map g).mkQ.comp g
  have hker : LinearMap.ker q = P ⊔ LinearMap.ker g := by
    simp [q, LinearMap.ker_comp, Submodule.comap_map_eq]
  rw [← hker]
  exact (q.quotKerEquivOfSurjective ((P.map g).mkQ_surjective.comp hg)).length_eq

/-- The colength in the middle of a short complex, for filtration steps matched by the
differentials, splits as the homology plus two boundary terms. -/
private lemma length_quotient_shortComplex
    {A : Type*} [Ring A] (S : ShortComplex (ModuleCat.{v} A))
    (P₁ : Submodule A S.X₁) (P₂ : Submodule A S.X₂)
    (hP : P₂ ⊓ LinearMap.ker S.g.hom = P₁.map S.f.hom) :
    Module.length A (S.X₂ ⧸ P₂) = Module.length A S.homology +
      Module.length A (S.X₂ ⧸ (P₂ ⊔ LinearMap.ker S.g.hom)) +
      Module.length A (S.X₁ ⧸ (P₁ ⊔ LinearMap.ker S.f.hom)) := by
  let Z := LinearMap.ker S.g.hom
  let b := S.moduleCatToCycles
  let B := LinearMap.range b
  let PZ := P₂.comap Z.subtype
  have hPB : PZ ≤ B := by
    intro z hz
    obtain ⟨x, hx, hfx⟩ := Submodule.mem_map.mp (hP.le ⟨hz, z.2⟩)
    exact ⟨x, Subtype.ext hfx⟩
  have hmap : P₁.map b.rangeRestrict = PZ.comap B.subtype := by
    ext z
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact (hP.ge (Submodule.mem_map.mpr ⟨x, hx, rfl⟩)).1
    · intro hz
      obtain ⟨x, hx, hfx⟩ := Submodule.mem_map.mp (hP.le ⟨hz, z.1.2⟩)
      exact ⟨x, hx, Subtype.ext (Subtype.ext hfx)⟩
  have hker : LinearMap.ker b.rangeRestrict = LinearMap.ker S.f.hom := by
    ext x
    simp only [LinearMap.mem_ker]
    exact ⟨fun h => congrArg Subtype.val (congrArg Subtype.val h),
      fun h => Subtype.ext (Subtype.ext h)⟩
  have hb := length_quotient_sup_ker b.rangeRestrict b.surjective_rangeRestrict P₁
  rw [hmap, hker] at hb
  have hh : Module.length A (Z ⧸ B) = Module.length A S.homology :=
    (S.moduleCatHomologyIso.toLinearEquiv).length_eq.symm
  rw [length_quotient_eq_add P₂ Z, length_quotient_eq_add PZ B,
    sup_of_le_right hPB, hh, ← hb]
  ac_rfl

/-- Telescoping an alternating sum of consecutive pairs. -/
private lemma alternatingSum_add_next (b : ℕ → ℚ) (r : ℕ) :
    ∑ i ∈ Finset.range (r + 1), (-1 : ℚ) ^ i * (b i + b (i + 1)) =
      b 0 + (-1 : ℚ) ^ r * b (r + 1) := by
  induction r with
  | zero => simp
  | succ r ih =>
    rw [Finset.sum_range_succ, ih, pow_succ]
    ring

/-- The alternating sum of the colengths of a filtration that is exact in each degree is the
Euler characteristic of the homology. -/
private lemma alternatingSum_length_eq
    {A : Type*} [Ring A] (C : ChainComplex (ModuleCat.{v} A) ℕ) (r : ℕ)
    (P : ∀ n, Submodule A (C.X n))
    (hP : ∀ n ≤ r, P n ⊓ LinearMap.ker (C.d n (n - 1)).hom =
      (P (n + 1)).map (C.d (n + 1) n).hom)
    (hfin : ∀ n ≤ r, Module.length A (C.X n ⧸ P n) ≠ ⊤)
    (htop : Subsingleton (C.X (r + 1))) :
    ∑ n ∈ Finset.range (r + 1), (-1 : ℚ) ^ n *
      (Module.length A (C.X n ⧸ P n)).toNat =
    ∑ n ∈ Finset.range (r + 1), (-1 : ℚ) ^ n *
      (Module.length A (C.homology n)).toNat := by
  let b (n : ℕ) := Module.length A (C.X n ⧸ (P n ⊔ LinearMap.ker (C.d n (n - 1)).hom))
  have he (n : ℕ) (hn : n ≤ r) : Module.length A (C.X n ⧸ P n) =
      Module.length A (C.homology n) + b n + b (n + 1) := by
    rw [(C.homologyIsoSc' (n + 1) n (n - 1) (by simp)
      (by cases n <;> simp)).toLinearEquiv.length_eq]
    exact length_quotient_shortComplex (C.sc' (n + 1) n (n - 1)) (P (n + 1)) (P n) (hP n hn)
  have hb0 : b 0 = 0 := by simp [b, Module.length_eq_zero]
  have hbr : b (r + 1) = 0 := Module.length_eq_zero
  have hsum := alternatingSum_add_next (fun n => (b n).toNat) r
  rw [hb0, hbr] at hsum
  simp only [ENat.toNat_zero, Nat.cast_zero, mul_zero, add_zero] at hsum
  calc
    _ = ∑ n ∈ Finset.range (r + 1), (-1 : ℚ) ^ n *
        ((Module.length A (C.homology n)).toNat + ((b n).toNat + (b (n + 1)).toNat) : ℚ) := by
      refine Finset.sum_congr rfl fun n hn => ?_
      have h := he n (by simpa using hn)
      have hne := hfin n (by simpa using hn)
      rw [h] at hne
      simp only [ne_eq, ENat.add_eq_top, not_or] at hne
      rw [h, ENat.toNat_add
        (by simpa only [ne_eq, ENat.add_eq_top, not_or] using hne.1) hne.2,
        ENat.toNat_add hne.1.1 hne.1.2]
      push_cast
      ring
    _ = _ := by
      simp_rw [mul_add, Finset.sum_add_distrib]
      rw [← Finset.sum_add_distrib]
      conv_lhs => rhs; arg 2; ext n; rw [← mul_add]
      rw [hsum, add_zero]

/-- A power of an ideal acts on a finite product coordinatewise. -/
private lemma smul_top_pi {A M ι : Type*} [CommRing A] [AddCommGroup M] [Module A M]
    [Finite ι] (I : Ideal A) :
    I • (⊤ : Submodule A (ι → M)) =
      Submodule.pi Set.univ (fun _ => I • (⊤ : Submodule A M)) := by
  classical
  let := Fintype.ofFinite ι
  refine le_antisymm (fun x hx i _ => Submodule.smul_top_le_comap_smul_top I (LinearMap.proj i) hx)
    fun x hx => ?_
  rw [← Finset.univ_sum_single x]
  exact Submodule.sum_mem _ fun i _ =>
    Submodule.smul_top_le_comap_smul_top I (LinearMap.single A (fun _ : ι => M) i)
      (hx i (Set.mem_univ i))

/-- The colength of a power of an ideal on a finite product is the number of factors times
the colength on one factor. -/
private lemma length_quotient_smul_pi {A M ι : Type*} [CommRing A] [AddCommGroup M]
    [Module A M] [Fintype ι] (I : Ideal A) :
    Module.length A ((ι → M) ⧸ I • (⊤ : Submodule A (ι → M))) =
      Fintype.card ι * Module.length A (M ⧸ I • (⊤ : Submodule A M)) := by
  classical
  rw [smul_top_pi, (Submodule.quotientPi _).length_eq, Module.length_pi]
  simp

/-- Colengths of powers of an ideal are invariant under a linear equivalence. -/
private lemma length_quotient_smul_congr {A U V : Type*} [CommRing A]
    [AddCommGroup U] [Module A U] [AddCommGroup V] [Module A V]
    (e : U ≃ₗ[A] V) (I : Ideal A) :
    Module.length A (U ⧸ I • (⊤ : Submodule A U)) =
      Module.length A (V ⧸ I • (⊤ : Submodule A V)) := by
  apply LinearEquiv.length_eq (Submodule.Quotient.equiv _ _ e ?_)
  rw [Submodule.map_smul'', Submodule.map_top, e.range]

/-- Each term of the Koszul complex with coefficients is a direct sum of copies of the
coefficient module, so its colengths are binomial multiples. -/
private lemma koszulTensor_length_quotient {A : Type*} [CommRing A] [Nontrivial A]
    (I : Ideal A) {r : ℕ} (f : Fin r → A) (M : Type*) [AddCommGroup M] [Module A M]
    (n k : ℕ) :
    Module.length A ((Koszul.seqComplexTensor f M).X n ⧸
      I ^ k • (⊤ : Submodule A ((Koszul.seqComplexTensor f M).X n))) =
      r.choose n * Module.length A (M ⧸ I ^ k • (⊤ : Submodule A M)) := by
  let b := Module.finBasis A (⋀[A]^n (Fin r → A))
  let e := (b.equivFun.rTensor M).trans ((TensorProduct.piLeft A M (fun _ => A)).trans
    (LinearEquiv.piCongrRight fun _ => TensorProduct.lid A M))
  calc
    _ = _ := length_quotient_smul_congr e (I ^ k)
    _ = _ := by
      rw [length_quotient_smul_pi]
      congr 1
      simp [exteriorPower.finrank_eq]

/-- The Koszul complex on a sequence of length `r` vanishes above degree `r`. -/
public lemma koszulTensor_subsingleton_above {A : Type*} [CommRing A]
    {r : ℕ} (f : Fin r → A) (M : Type*) [AddCommGroup M] [Module A M]
    (n : ℕ) (hn : r < n) : Subsingleton ((Koszul.seqComplexTensor f M).X n) := by
  have := exteriorPower.subsingleton_of_span_eq_top_of_card_lt
    (Pi.basisFun A (Fin r)) (Pi.basisFun A (Fin r)).span_eq n (by simpa using hn)
  exact inferInstanceAs (Subsingleton ((⋀[A]^n (Fin r → A)) ⊗[A] M))

/-- Eventually the shifted filtration of the Koszul complex is exact in every degree up to
`r`. -/
private lemma koszulFiltration_exact_eventually
    {A : Type*} [CommRing A] [IsNoetherianRing A]
    (I : Ideal A) {r : ℕ} (f : Fin r → A) (M : Type*)
    [AddCommGroup M] [Module A M] [Module.Finite A M]
    (hf : I = Ideal.span (Set.range f)) :
    ∀ᶠ t : ℕ in Filter.atTop, ∀ n ≤ r,
      I ^ (t + r + 1 - n) • ⊤ ⊓ LinearMap.ker
        ((Koszul.seqComplexTensor f M).d n (n - 1)).hom =
      (I ^ (t + r + 1 - (n + 1)) •
          (⊤ : Submodule A ((Koszul.seqComplexTensor f M).X (n + 1)))).map
        ((Koszul.seqComplexTensor f M).d (n + 1) n).hom := by
  classical
  let C := Koszul.seqComplexTensor f M
  have he (n : Fin (r + 1)) : ∃ k : ℕ, ∀ l ≥ k,
      I ^ (l + 1) • ⊤ ⊓ LinearMap.ker (C.d n (n - 1)).hom ≤
        (I ^ l • (⊤ : Submodule A (C.X (n + 1)))).map (C.d (n + 1) n).hom := by
    have : Module.Finite A (C.X n) :=
      inferInstanceAs (Module.Finite A ((⋀[A]^(n : ℕ) (Fin r → A)) ⊗[A] M))
    exact exists_pow_cycles_le_boundaries C I f hf (koszulTensor_nullHomotopic f M) n
  choose k hk using he
  filter_upwards [Filter.eventually_ge_atTop (Finset.univ.sup k)] with t ht n hn
  have hn' : n < r + 1 := by omega
  have hkn : k ⟨n, hn'⟩ ≤ t + r - n := le_trans
    (Finset.le_sup (f := k) (s := Finset.univ)
      (Finset.mem_univ (⟨n, hn'⟩ : Fin (r + 1)))) (by omega)
  rw [show t + r + 1 - n = t + r - n + 1 by omega, show t + r + 1 - (n + 1) = t + r - n by omega]
  refine le_antisymm (hk ⟨n, hn'⟩ (t + r - n) hkn) ?_
  rintro x ⟨y, hy, rfl⟩
  constructor
  · change ((Koszul.seqComplexTensor f M).d (n + 1) n).hom y ∈ _
    rw [Koszul.seqComplexTensor_d]
    exact koszulTensor_d_mem_pow_smul I f M
      (fun i => hf ▸ Ideal.subset_span (Set.mem_range_self i)) n (t + r - n) hy
  · exact congrArg (fun q => q.hom y) (C.d_comp_d (n + 1) n (n - 1))

/-- Eventually, the alternating binomial combination of the Hilbert–Samuel function is the
Euler characteristic of the Koszul homology. -/
private lemma koszul_euler_eq_eventually
    {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (I : Ideal A) {r : ℕ} (f : Fin r → A) (M : Type*)
    [AddCommGroup M] [Module A M] [Module.Finite A M]
    (hI : IsIdealOfDefinition I) (hf : I = Ideal.span (Set.range f)) :
    ∀ᶠ t : ℕ in Filter.atTop,
      ∑ n ∈ Finset.range (r + 1), (-1 : ℚ) ^ n * (r.choose n : ℚ) *
        (Module.length A (M ⧸ I ^ (t + r - n + 1) • (⊤ : Submodule A M))).toNat =
      ∑ n ∈ Finset.range (r + 1), (-1 : ℚ) ^ n *
        (Module.length A ((Koszul.seqComplexTensor f M).homology n)).toNat := by
  filter_upwards [koszulFiltration_exact_eventually I f M hf] with t ht
  let C := Koszul.seqComplexTensor f M
  let P (n : ℕ) : Submodule A (C.X n) := I ^ (t + r + 1 - n) • ⊤
  have hlen (n : ℕ) (hn : n ≤ r) : Module.length A (C.X n ⧸ P n) =
      r.choose n * Module.length A (M ⧸ I ^ (t + r - n + 1) • (⊤ : Submodule A M)) := by
    rw [show P n = I ^ (t + r - n + 1) • ⊤ from congrArg (fun k => I ^ k • ⊤) (by omega)]
    exact koszulTensor_length_quotient I f M n _
  have hfin (n : ℕ) (hn : n ≤ r) : Module.length A (C.X n ⧸ P n) ≠ ⊤ := by
    rw [hlen n hn]
    exact WithTop.mul_ne_top (ENat.natCast_ne_top _)
      (HilbertSamuel.length_quotient_lt_top I hI M (t + r - n)).ne
  have he := alternatingSum_length_eq C r P ht hfin
    (koszulTensor_subsingleton_above f M (r + 1) (by omega))
  rw [← he]
  refine Finset.sum_congr rfl fun n hn => ?_
  rw [hlen n (by simpa using hn)]
  simp [ENat.toNat_mul, mul_assoc]

/-- A polynomial whose `r`-th forward difference is constant has `r !` times its degree-`r`
coefficient equal to that constant. -/
private lemma factorial_mul_coeff_eq_of_fwdDiff_const (P : ℚ[X]) (r : ℕ) (e : ℚ)
    (h : (fwdDiff (1 : ℚ))^[r] P.eval = fun _ => e) :
    (r.factorial : ℚ) * P.coeff r = e := by
  have hd : P.natDegree ≤ r := by
    by_contra! hlt
    obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_lt hlt
    have hh := P.fwdDiff_iter_degree_eq_factorial
    rw [hk, Nat.add_assoc, Nat.add_comm r (k + 1), Function.iterate_add_apply, h,
      Function.iterate_succ_apply, fwdDiff_const] at hh
    have hz : (fwdDiff (1 : ℚ))^[k] (fun _ : ℚ => (0 : ℚ)) = 0 :=
      Function.iterate_fixed (fwdDiff_const _ _) k
    have hh0 := congrFun hh 0
    simp only [hz, Pi.zero_apply, Pi.smul_apply, Pi.natCast_apply, smul_eq_mul] at hh0
    have hP : P ≠ 0 := by
      rintro rfl
      simp at hlt
    exact (mul_ne_zero (Polynomial.leadingCoeff_ne_zero.mpr hP) (by positivity)) hh0.symm
  rcases lt_or_eq_of_le hd with hlt | heq
  · have hh := P.fwdDiff_iter_eq_zero_of_degree_lt hlt
    rw [h] at hh
    rw [coeff_eq_zero_of_natDegree_lt hlt, mul_zero]
    exact (congrFun hh 0).symm
  · have hh := P.fwdDiff_iter_degree_eq_factorial
    rw [heq, h] at hh
    simpa [Polynomial.leadingCoeff, heq, mul_comm] using (congrFun hh 0).symm

/-- The same conclusion from an eventual constancy of the forward difference. -/
private lemma factorial_mul_coeff_eq_of_eventually_fwdDiff_const
    (P : ℚ[X]) (r : ℕ) (e : ℚ)
    (h : ∀ᶠ n : ℕ in atTop, (fwdDiff (1 : ℚ))^[r] P.eval n = e) :
    (r.factorial : ℚ) * P.coeff r = e := by
  let Q : ℚ[X] := ∑ i ∈ Finset.range (r + 1),
    C ((-1 : ℚ) ^ (r - i) * r.choose i) * P.comp (X + C (i : ℚ))
  have hQ (x : ℚ) : Q.eval x = (fwdDiff (1 : ℚ))^[r] P.eval x := by
    simp [Q, eval_finsetSum, fwdDiff_iter_eq_sum_shift, mul_assoc]
  have hQC : Q = C e := Polynomial.eq_of_eventually_eval_natCast_eq (h.mono fun n hn => by
    rw [hQ, hn, eval_C])
  apply factorial_mul_coeff_eq_of_fwdDiff_const
  funext x
  rw [← hQ, hQC, eval_C]

/-- The iterated forward difference as an alternating binomial sum of shifts. -/
private lemma fwdDiff_eq_alternatingSum (P : ℚ[X]) (r : ℕ) (x : ℚ) :
    (fwdDiff (1 : ℚ))^[r] P.eval x =
      ∑ i ∈ Finset.range (r + 1),
        (-1 : ℚ) ^ i * (r.choose i : ℚ) * P.eval (x + (r - i : ℕ)) := by
  rw [fwdDiff_iter_eq_sum_shift, ← Finset.sum_range_reflect
    (fun i => (-1 : ℚ) ^ i * (r.choose i : ℚ) * P.eval (x + (r - i : ℕ))) (r + 1)]
  refine Finset.sum_congr rfl fun i hi => ?_
  have hi' : i ≤ r := by simpa using hi
  simp only [Nat.add_sub_cancel, Nat.sub_sub_self hi', Nat.choose_symm hi',
    nsmul_eq_mul, mul_one, zsmul_eq_mul, Int.cast_mul, Int.cast_pow, Int.cast_neg,
    Int.cast_one, Int.cast_natCast]

/-- If an ideal of definition `I` is generated by `f : Fin r → A`, then its Hilbert–Samuel
multiplicity in degree `r` on a finite module is the Euler characteristic of the homology of
the Koszul complex on `f` with coefficients in that module. -/
@[stacks 0AZZ]
theorem hilbertSamuelMultiplicity_eq_alternatingSum_koszulHomology_length
    {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (I : Ideal A) (r : ℕ) (f : Fin r → A) (M : Type*)
    [AddCommGroup M] [Module A M] [Module.Finite A M]
    (hI : IsIdealOfDefinition I) (hf : I = Ideal.span (Set.range f)) :
    I.hilbertSamuelMultiplicity M r =
      ∑ i : Fin (r + 1), (-1 : ℚ) ^ (i : ℕ) *
        ((Module.length A ((Koszul.seqComplexTensor f M).homology (i : ℕ))).toNat : ℚ) := by
  classical
  obtain ⟨P, hP⟩ := exists_computesHilbertSamuelPoly I hI M
  rw [hilbertSamuelMultiplicity_eq_factorial_mul_coeff I M hP r]
  have hpn : ∀ᶠ n : ℕ in atTop, P.eval (n : ℚ) =
      (Module.length A (M ⧸ I ^ (n + 1) • (⊤ : Submodule A M))).toNat := by
    filter_upwards [hP] with n hn
    obtain ⟨p, hp, hval⟩ := hn
    simpa [hp] using hval
  obtain ⟨N, hN⟩ := eventually_atTop.mp hpn
  have he : (r.factorial : ℚ) * P.coeff r = ∑ n ∈ Finset.range (r + 1), (-1 : ℚ) ^ n *
      (Module.length A ((Koszul.seqComplexTensor f M).homology n)).toNat := by
    apply factorial_mul_coeff_eq_of_eventually_fwdDiff_const
    filter_upwards [koszul_euler_eq_eventually I f M hI hf,
      eventually_ge_atTop N] with t ht htN
    rw [fwdDiff_eq_alternatingSum, ← ht]
    refine Finset.sum_congr rfl fun n hn => ?_
    have hn' : n ≤ r := by simpa using hn
    have hcast : (t : ℚ) + ((r - n : ℕ) : ℚ) = ((t + r - n : ℕ) : ℚ) := by
      rw [show t + r - n = t + (r - n) by omega, Nat.cast_add]
    rw [hcast, hN (t + r - n) (by omega)]
  exact he.trans (Fin.sum_univ_eq_sum_range
    (fun n => (-1 : ℚ) ^ n *
      (Module.length A ((Koszul.seqComplexTensor f M).homology n)).toNat) (r + 1)).symm

end Ideal
