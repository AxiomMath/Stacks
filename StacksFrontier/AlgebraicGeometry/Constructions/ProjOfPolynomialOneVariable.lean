module

public import Mathlib.AlgebraicGeometry.OpenImmersion
public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
public import Mathlib.RingTheory.GradedAlgebra.HomogeneousLocalization
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Limits.AffineIntoProjective

/-!
# `Proj` of a polynomial ring in one variable

Let `A` be a commutative ring and let `S = A[T]` be the polynomial ring in one variable, graded by
total degree, so that `T` is homogeneous of degree one and the degree-zero part `S₀` is the ring of
constants. The irrelevant ideal of `S` is generated by `T`, so the single standard open `D₊(T)` is
the whole of `Proj S`, and dehomogenizing at `T` identifies the degree-zero part of the
localization `S_T` with `A`. Together these say that the canonical morphism `Proj S → Spec S₀` is
an isomorphism.

## Main definitions

* `AlgebraicGeometry.ProjectiveSpace.oneVariableFromZeroEquiv`: the degree-zero part of `A[T]` is
  the degree-zero part of the localization of `A[T]` away from `T`.
* `AlgebraicGeometry.ProjectiveSpace.oneVariableProjIsoSpec`: the isomorphism `Proj A[T] ≅ Spec A`.

## Main results

* `AlgebraicGeometry.ProjectiveSpace.oneVariable_basicOpen_X_zero_eq_top`: the standard open of
  `T` is the whole of `Proj A[T]`, whence the single chart `Spec (A[T]_T)₀ ⟶ Proj A[T]` is an
  isomorphism (`AlgebraicGeometry.ProjectiveSpace.isIso_awayι_oneVariable`).
* `AlgebraicGeometry.ProjectiveSpace.coe_oneVariableFromZeroEquiv`: the identification of the two
  degree-zero rings is `HomogeneousLocalization.fromZeroRingHom`, so it is an isomorphism of
  `CommRingCat` (`AlgebraicGeometry.ProjectiveSpace.isIso_ofHom_fromZeroRingHom_oneVariable`).
* `AlgebraicGeometry.ProjectiveSpace.isIso_toSpecZero_oneVariable`: **the canonical morphism
  `Proj A[T] ⟶ Spec A[T]₀` is an isomorphism.**
* `AlgebraicGeometry.ProjectiveSpace.oneVariableProjIsoSpec_hom`: the isomorphism onto `Spec A` is
  that canonical morphism followed by the identification of `A[T]₀` with `A`.

## Implementation notes

The one-variable polynomial ring is represented as `MvPolynomial (Fin 1) A`, so that the grading by
total degree supplied by `MvPolynomial.homogeneousSubmodule` is available; this is the
representation used by `AlgebraicGeometry.openProjAlgebra` and by
`AlgebraicGeometry.ProjectiveSpace.affineChart`, and the variable `T` is `MvPolynomial.X 0`. The
grading is kept a local instance, as it is in Mathlib.

The canonical morphism is Mathlib's `AlgebraicGeometry.Proj.toSpecZero`, whose target is `Spec` of
the degree-zero part of the grading. For a polynomial ring that part is the ring of constants
rather than literally the ring of coefficients, so the isomorphism onto `Spec A` carries one
further `Spec.map`.

## References

* [Stacks Project, Tag 01MI](https://stacks.math.columbia.edu/tag/01MI)
* [Stacks Project, Tag 01ME](https://stacks.math.columbia.edu/tag/01ME)
-/

@[expose] public section

open CategoryTheory HomogeneousLocalization MvPolynomial

namespace AlgebraicGeometry.ProjectiveSpace

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

variable (A : Type u) [CommRing A]

/-- **The irrelevant ideal of a polynomial ring in one variable is generated by that variable.**
Equivalently, the single standard open `D₊(T)` is the whole of `Proj A[T]`. -/
public theorem oneVariable_basicOpen_X_zero_eq_top :
    Proj.basicOpen (homogeneousSubmodule (Fin 1) A) (X 0) = ⊤ := by
  have h := Proj.iSup_basicOpen_eq_top' (𝒜 := homogeneousSubmodule (Fin 1) A)
    (X : Fin 1 → MvPolynomial (Fin 1) A)
    (fun i => ⟨1, X_mem_homogeneousSubmodule 0 _ i⟩)
    (adjoin_range_X_homogeneousSubmodule_zero 0 _)
  rw [← h, iSup_unique]
  rfl

/-- The standard chart `Spec (A[T]_T)₀ ⟶ Proj A[T]` at `T` is an isomorphism. -/
public instance isIso_awayι_oneVariable :
    IsIso (Proj.awayι (homogeneousSubmodule (Fin 1) A) (X 0)
      (X_mem_homogeneousSubmodule 0 A 0) Nat.one_pos) := by
  apply isIso_of_isOpenImmersion_of_opensRange_eq_top
  rw [Proj.opensRange_awayι, oneVariable_basicOpen_X_zero_eq_top]

/-- **Dehomogenizing a polynomial ring in one variable at that variable leaves the constants.**
The degree-zero part of the localization of `A[T]` away from `T` is the degree-zero part of `A[T]`
itself, both being copies of `A`: a fraction `a Tⁿ / Tⁿ` is the constant `a`. -/
public noncomputable def oneVariableFromZeroEquiv :
    ↥(homogeneousSubmodule (Fin 1) A 0) ≃+* Away (homogeneousSubmodule (Fin 1) A) (X 0) :=
  ((gradeZeroEquiv (Fin 1) A).symm.trans (MvPolynomial.isEmptyRingEquiv A (Fin 0)).symm).trans
    (awayChartEquiv 0 A)

/-- The identification `oneVariableFromZeroEquiv` of degree-zero rings is the canonical map
`a ↦ a / 1`. -/
public theorem coe_oneVariableFromZeroEquiv : ⇑(oneVariableFromZeroEquiv A) =
    fromZeroRingHom (homogeneousSubmodule (Fin 1) A) (Submonoid.powers (X 0)) := by
  funext b
  show awayChartInv 0 A (C ((gradeZeroEquiv (Fin 1) A).symm b)) = _
  rw [awayChartInv, eval₂Hom_C]
  show fromZeroRingHom _ _ ((algebraMap A _) _) = _
  congr 1
  exact (gradeZeroEquiv (Fin 1) A).apply_symm_apply b

/-- The canonical map from the degree-zero part of `A[T]` to the degree-zero part of the
localization away from `T` is an isomorphism of rings. -/
public instance isIso_ofHom_fromZeroRingHom_oneVariable : IsIso (CommRingCat.ofHom
    (fromZeroRingHom (homogeneousSubmodule (Fin 1) A) (Submonoid.powers (X 0)))) :=
  (ConcreteCategory.isIso_iff_bijective _).mpr (by
    simpa only [CommRingCat.hom_ofHom, ← coe_oneVariableFromZeroEquiv A] using
      (oneVariableFromZeroEquiv A).bijective)

/-- **`Proj` of a polynomial ring in one variable is the spectrum of the coefficient ring.** The
canonical morphism `Proj A[T] ⟶ Spec A[T]₀` of a graded ring to the spectrum of its degree-zero
part is an isomorphism when `A[T]` is the polynomial ring in one variable of degree one. -/
@[stacks 01MI]
public theorem isIso_toSpecZero_oneVariable :
    IsIso (Proj.toSpecZero (homogeneousSubmodule (Fin 1) A)) := by
  have h : Proj.toSpecZero (homogeneousSubmodule (Fin 1) A) =
      CategoryTheory.inv (Proj.awayι (homogeneousSubmodule (Fin 1) A) (X 0)
        (X_mem_homogeneousSubmodule 0 A 0) Nat.one_pos) ≫
      Spec.map (CommRingCat.ofHom
        (fromZeroRingHom (homogeneousSubmodule (Fin 1) A) (Submonoid.powers (X 0)))) := by
    rw [← Proj.awayι_toSpecZero (homogeneousSubmodule (Fin 1) A) (X 0)
      (X_mem_homogeneousSubmodule 0 A 0) Nat.one_pos, IsIso.inv_hom_id_assoc]
  rw [h]
  infer_instance

/-- **`Proj A[T] ≅ Spec A`**: the canonical isomorphism `Proj A[T] ≅ Spec A[T]₀` followed by
`Spec` of the identification of the ring of constants `A[T]₀` with `A`. -/
public noncomputable def oneVariableProjIsoSpec :
    Proj (homogeneousSubmodule (Fin 1) A) ≅ Spec (.of A) :=
  have := isIso_toSpecZero_oneVariable A
  asIso (Proj.toSpecZero (homogeneousSubmodule (Fin 1) A) ≫
    Spec.map (gradeZeroEquiv (Fin 1) A).toCommRingCatIso.hom)

/-- The isomorphism `Proj A[T] ≅ Spec A` is the canonical morphism to the spectrum of the
degree-zero part of `A[T]`, followed by the identification of that part with `A`. -/
public theorem oneVariableProjIsoSpec_hom : (oneVariableProjIsoSpec A).hom =
    Proj.toSpecZero (homogeneousSubmodule (Fin 1) A) ≫
      Spec.map (gradeZeroEquiv (Fin 1) A).toCommRingCatIso.hom :=
  rfl

end AlgebraicGeometry.ProjectiveSpace
