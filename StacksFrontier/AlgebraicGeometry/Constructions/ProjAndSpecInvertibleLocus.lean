module

public import StacksFrontier.AlgebraicGeometry.Constructions.ProjAndSpecInvertibleLocusComparison
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.GoodOpenClose.Basic

/-!
# Proj and Spec over the invertible locus: the cone is a line bundle

Let `A = ⨁_{n ≥ 0} 𝒜 n` be a graded ring, `P = Proj A`, `B = ⨁_{d ≥ 0} A_{≥ d}` its truncation
algebra, `π : L = Proj B ⟶ P` the cone, `0 : P ⟶ L` its zero section and `U ⊆ L` the punctured
cone, as in [Stacks, Tag 0EKF]. Let `W ⊆ P` be the largest open on which `𝒪_P(1)` is invertible
and the multiplication maps `𝒪_P(n) ⊗ 𝒪_P(m) ⟶ 𝒪_P(n + m)` are isomorphisms — the open of
[Stacks, Tag 01MU] for `d = 1`, `Stacks.AlgebraicGeometry.ProjInvertibleLocus.whereInvertible 𝒜 1`.
The section says that over `W` the cone is the line bundle `𝐕(𝒪_P(1)|_W)`, with `0|_W` its zero
section, so that `0(W)` is an effective Cartier divisor on `L|_W`, and that `U|_W` is the
complement of the zero section. This file proves these four statements.

## Main definitions

* `Stacks.AlgebraicGeometry.ProjAndSpecInvertibleLocus.coneRestrictIsoVectorBundle`:
  **`L|_W = π⁻¹(W) ≅ 𝐕(𝒪_P(1)|_W)`**, an isomorphism over `W`.
* `Stacks.AlgebraicGeometry.ProjAndSpecInvertibleLocus.zeroSectionRestrict`: the restriction
  `0|_W : W ⟶ L|_W` of the zero section.

## Main results

* `coneRestrictIsoVectorBundle_hom_comp_vectorBundleToBase`: the isomorphism lies over `W`.
* `zeroSectionRestrict_comp_coneRestrictIsoVectorBundle_hom`: **under it `0|_W` is the zero
  section of the vector bundle.**
* `isEffectiveCartierDivisor_ker_zeroSectionRestrict`: **`0(W)` is an effective Cartier divisor
  on `L|_W`.**
* `coe_preimage_openUInL_eq_compl_range_zeroSectionRestrict`: **`U|_W` is the complement of the
  zero section**.

## Implementation notes

The isomorphism is the restriction over `W` of the morphism `L ⟶ 𝐕(𝒪_P(1))` over all of `P`
classified by the degree-one inclusion `𝒪_P(1) ⟶ π_* 𝒪_L`
(`Stacks.AlgebraicGeometry.ProjAndSpecInvertibleLocus.coneToVectorBundle`), followed by the
base-change identification `𝐕(𝒪_P(1)) ×_P W = 𝐕(𝒪_P(1)|_W)`. It is an isomorphism over every
standard open `D₊(cb)` with `deg c = deg b + 1`, and these cover `W`
(`Stacks.AlgebraicGeometry.GoodOpenClose.whereInvertible_eq_iSup_basicOpen_mul`). The zero
section of `𝐕(𝒪_P(1)|_W)` used is `AlgebraicGeometry.Scheme.Modules.vectorBundleOverZeroSection`,
the point of the vector bundle whose module morphism is zero. The effective Cartier divisor is
checked on the charts `D₊(cb)` of the cone, where the ideal of the zero section is generated by
the fibre coordinate.

## References

* [Stacks Project, Tag 0EKF](https://stacks.math.columbia.edu/tag/0EKF)
* [Stacks Project, Tag 01MU](https://stacks.math.columbia.edu/tag/01MU)
* [Stacks Project, Tag 01M2](https://stacks.math.columbia.edu/tag/01M2)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open Stacks.AlgebraicGeometry.ProjAndSpecTruncation Stacks.Truncation
open AlgebraicGeometry.Scheme.Modules

namespace Stacks.AlgebraicGeometry.ProjAndSpecInvertibleLocus

universe u

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- The open `W ⊆ P` of [Stacks, Tag 01MU] for `d = 1`. -/
abbrev locus : (AlgebraicGeometry.Proj 𝒜).Opens :=
  ProjInvertibleLocus.whereInvertible 𝒜 1

/-- The restriction `𝒪_P(1)|_W` of the twisting sheaf to `W`. -/
abbrev twistOneRestrict : (locus 𝒜).toScheme.Modules :=
  (Scheme.Modules.pullback (locus 𝒜).ι).obj (twistOne 𝒜)

/-- `twistOne 𝒜` is the twisting sheaf `𝒪_P(1)`. -/
theorem twistOne_eq : twistOne 𝒜 = ProjectiveSpectrum.Proj.twistingSheaf 𝒜 1 := rfl

/-! ### `W` is covered by the standard opens `D₊(cb)`, `deg c = deg b + 1` -/

/-- A point of `W` lies in a standard open `D₊(cb)` with `deg c = deg b + 1`. -/
theorem exists_mem_basicOpen_mul {x : AlgebraicGeometry.Proj 𝒜} (hx : x ∈ locus 𝒜) :
    ∃ (m : ℕ) (c b : A), c ∈ 𝒜 (m + 1) ∧ b ∈ 𝒜 m ∧
      x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b) := by
  rw [locus, GoodOpenClose.whereInvertible_eq_iSup_basicOpen_mul] at hx
  obtain ⟨m, hx⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  obtain ⟨c, hx⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  obtain ⟨b, hx⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  exact ⟨m, c, b, c.2, b.2, hx⟩

/-- A standard open `D₊(cb)` with `deg c = deg b + 1` lies in `W`. -/
theorem basicOpen_mul_le {m : ℕ} {c b : A} (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m) :
    AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b) ≤ locus 𝒜 := by
  rw [locus, GoodOpenClose.whereInvertible_eq_iSup_basicOpen_mul]
  exact le_iSup_of_le m (le_iSup_of_le ⟨c, hc⟩ (le_iSup_of_le ⟨b, hb⟩ le_rfl))

/-! ### The comparison over `W` -/

/-- **The comparison `L ⟶ 𝐕(𝒪_P(1))` is an isomorphism over `W`.** -/
instance isIso_morphismRestrict_coneToVectorBundle_locus :
    IsIso ((coneToVectorBundle 𝒜).left ∣_ (vectorBundleToBase _ (twistOne 𝒜) ⁻¹ᵁ locus 𝒜)) := by
  set p := vectorBundleToBase _ (twistOne 𝒜)
  set O := p ⁻¹ᵁ locus 𝒜
  rw [← MorphismProperty.isomorphisms.iff]
  refine IsZariskiLocalAtTarget.of_forall_exists_morphismRestrict fun y => ?_
  have hy : p (O.ι y) ∈ locus 𝒜 := by
    have : O.ι y ∈ (O : Set _) := by rw [← Scheme.Opens.range_ι O]; exact ⟨y, rfl⟩
    exact this
  obtain ⟨m, c, b, hc, hb, hx⟩ := exists_mem_basicOpen_mul 𝒜 hy
  have hle : p ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b) ≤ O :=
    (Scheme.Hom.preimage_mono _ (basicOpen_mul_le 𝒜 hc hb))
  have himg : O.ι ''ᵁ (O.ι ⁻¹ᵁ (p ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b))) =
      p ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b) := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    exact inf_eq_right.mpr hle
  refine ⟨O.ι ⁻¹ᵁ (p ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b)), hx, ?_⟩
  refine ((MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
    (morphismRestrictRestrict _ _ _ ≪≫ morphismRestrictEq _ himg)).mpr ?_
  have := isIso_morphismRestrict_basicOpen_mul hc hb (rfl : c * b = c * b)
  exact this

/-- **`L|_W = π⁻¹(W) ≅ 𝐕(𝒪_P(1)|_W)`**: over the open `W` of [Stacks, Tag 01MU] for `d = 1` the
cone is the vector bundle of `𝒪_P(1)|_W`, the relative spectrum of its symmetric algebra. -/
@[stacks 0EKF "over the open W of Tag 01MU for d = 1, L|_W is the vector bundle V(O_P(1)|_W)"]
def coneRestrictIsoVectorBundle :
    (pi 𝒜 ⁻¹ᵁ locus 𝒜).toScheme ≅ vectorBundle (locus 𝒜).toScheme (twistOneRestrict 𝒜) :=
  (AlgebraicGeometry.Proj (Truncation.grading 𝒜)).isoOfEq
      (preimage_coneToVectorBundle 𝒜 (locus 𝒜)).symm ≪≫
    asIso ((coneToVectorBundle 𝒜).left ∣_ (vectorBundleToBase _ (twistOne 𝒜) ⁻¹ᵁ locus 𝒜)) ≪≫
    (isPullback_morphismRestrict (vectorBundleToBase _ (twistOne 𝒜)) (locus 𝒜)).flip.isoIsPullback
      _ _ (isPullback_vectorBundleBaseChangeMap (locus 𝒜).ι (twistOne 𝒜))

/-- The isomorphism `L|_W ≅ 𝐕(𝒪_P(1)|_W)` followed by the base-change morphism
`𝐕(𝒪_P(1)|_W) ⟶ 𝐕(𝒪_P(1))` is the comparison `L ⟶ 𝐕(𝒪_P(1))` on `L|_W`. -/
@[reassoc]
theorem coneRestrictIsoVectorBundle_hom_comp_vectorBundleBaseChangeMap :
    (coneRestrictIsoVectorBundle 𝒜).hom ≫ vectorBundleBaseChangeMap (locus 𝒜).ι (twistOne 𝒜) =
      (pi 𝒜 ⁻¹ᵁ locus 𝒜).ι ≫ (coneToVectorBundle 𝒜).left := by
  simp [coneRestrictIsoVectorBundle]

/-- **The isomorphism `L|_W ≅ 𝐕(𝒪_P(1)|_W)` lies over `W`**: followed by the projection of the
vector bundle it is the restriction `π|_W` of the cone projection. -/
@[stacks 0EKF "the identification L|_W = V(O_P(1)|_W) is one over W"]
theorem coneRestrictIsoVectorBundle_hom_comp_vectorBundleToBase :
    (coneRestrictIsoVectorBundle 𝒜).hom ≫ vectorBundleToBase _ (twistOneRestrict 𝒜) =
      pi 𝒜 ∣_ locus 𝒜 := by
  rw [← cancel_mono (locus 𝒜).ι]
  simp [coneRestrictIsoVectorBundle, coneToVectorBundle_left_comp]

/-! ### The zero section -/

/-- The zero section maps `W` into `L|_W`: `0⁻¹(π⁻¹ W) = W`. -/
theorem zeroSection_preimage_pi_preimage_locus :
    zeroSection 𝒜 ⁻¹ᵁ (pi 𝒜 ⁻¹ᵁ locus 𝒜) = locus 𝒜 := by
  rw [← Scheme.Hom.comp_preimage, zeroSection_comp_pi]
  rfl

/-- **The restriction `0|_W : W ⟶ L|_W` of the zero section.** -/
def zeroSectionRestrict : (locus 𝒜).toScheme ⟶ (pi 𝒜 ⁻¹ᵁ locus 𝒜).toScheme :=
  ((AlgebraicGeometry.Proj 𝒜).isoOfEq (zeroSection_preimage_pi_preimage_locus 𝒜)).inv ≫
    zeroSection 𝒜 ∣_ (pi 𝒜 ⁻¹ᵁ locus 𝒜)

/-- `0|_W` is the zero section on `W`. -/
@[reassoc]
theorem zeroSectionRestrict_comp_ι :
    zeroSectionRestrict 𝒜 ≫ (pi 𝒜 ⁻¹ᵁ locus 𝒜).ι = (locus 𝒜).ι ≫ zeroSection 𝒜 := by
  simp [zeroSectionRestrict]

/-- `0|_W` is a section of `π|_W`. -/
@[reassoc]
theorem zeroSectionRestrict_comp_pi :
    zeroSectionRestrict 𝒜 ≫ pi 𝒜 ∣_ locus 𝒜 = 𝟙 _ := by
  rw [← cancel_mono (locus 𝒜).ι, Category.assoc, morphismRestrict_ι,
    zeroSectionRestrict_comp_ι_assoc, zeroSection_comp_pi, Category.comp_id, Category.id_comp]

/-- **Under `L|_W ≅ 𝐕(𝒪_P(1)|_W)` the zero section `0|_W` is the zero section of the vector
bundle**, the point of `𝐕(𝒪_P(1)|_W)` over `W` whose module morphism is zero. -/
@[stacks 0EKF "under L|_W = V(O_P(1)|_W) the zero section 0|_W is the zero section of the \
vector bundle"]
theorem zeroSectionRestrict_comp_coneRestrictIsoVectorBundle_hom :
    zeroSectionRestrict 𝒜 ≫ (coneRestrictIsoVectorBundle 𝒜).hom =
      (vectorBundleOverZeroSection (twistOneRestrict 𝒜)).left := by
  refine (isPullback_vectorBundleBaseChangeMap (locus 𝒜).ι (twistOne 𝒜)).hom_ext ?_ ?_
  · rw [Category.assoc, coneRestrictIsoVectorBundle_hom_comp_vectorBundleBaseChangeMap,
      zeroSectionRestrict_comp_ι_assoc, zeroSection_comp_coneToVectorBundle,
      vectorBundleOverZeroSection_comp_vectorBundleBaseChangeMap]
  · rw [Category.assoc, coneRestrictIsoVectorBundle_hom_comp_vectorBundleToBase,
      zeroSectionRestrict_comp_pi, vectorBundleOverZeroSection_left_comp]

/-! ### The zero section is an effective Cartier divisor -/

/-- The square formed by `0|_W`, `0` and the two inclusions is cartesian. -/
theorem isPullback_zeroSectionRestrict :
    IsPullback (zeroSectionRestrict 𝒜) (locus 𝒜).ι (pi 𝒜 ⁻¹ᵁ locus 𝒜).ι (zeroSection 𝒜) :=
  (isPullback_morphismRestrict (zeroSection 𝒜) (pi 𝒜 ⁻¹ᵁ locus 𝒜)).of_iso
    ((AlgebraicGeometry.Proj 𝒜).isoOfEq (zeroSection_preimage_pi_preimage_locus 𝒜))
    (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp [zeroSectionRestrict]) (by simp)
    (by simp) (by simp)

/-- A regular element stays regular under a bijective ring homomorphism. -/
theorem isRegular_map_of_bijective {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (hφ : Function.Bijective φ) {f : R} (hf : _root_.IsRegular f) : _root_.IsRegular (φ f) := by
  refine ⟨fun a a' h => ?_, fun a a' h => ?_⟩
  · obtain ⟨b, rfl⟩ := hφ.2 a
    obtain ⟨b', rfl⟩ := hφ.2 a'
    have h' : φ (f * b) = φ (f * b') := by rw [map_mul, map_mul]; exact h
    exact congrArg φ (hf.1 (hφ.1 h'))
  · obtain ⟨b, rfl⟩ := hφ.2 a
    obtain ⟨b', rfl⟩ := hφ.2 a'
    have h' : φ (b * f) = φ (b' * f) := by rw [map_mul, map_mul]; exact h
    exact congrArg φ (hf.2 (hφ.1 h'))

variable {𝒜} in
/-- Over an open of `L` equal to `π⁻¹ D₊(cb)` with `deg c = deg b + 1` the ideal of the zero
section is generated by a nonzerodivisor. -/
theorem exists_isRegular_ker_zeroSection_app {m : ℕ} {c b : A} (hc : c ∈ 𝒜 (m + 1))
    (hb : b ∈ 𝒜 m) (O : (AlgebraicGeometry.Proj (Truncation.grading 𝒜)).Opens)
    (hO : O = pi 𝒜 ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b)) :
    ∃ f : Γ(AlgebraicGeometry.Proj (Truncation.grading 𝒜), O), _root_.IsRegular f ∧
      RingHom.ker ((zeroSection 𝒜).app O).hom = Ideal.span {f} := by
  subst hO
  obtain ⟨hreg, hker⟩ := ker_zeroSection_appLE_basicOpen_mul hc hb (rfl : c * b = c * b)
  refine ⟨_, hreg, Eq.trans ?_ hker⟩
  have h0 : zeroSection 𝒜 ⁻¹ᵁ (pi 𝒜 ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b)) =
      AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b) := by
    rw [← Scheme.Hom.comp_preimage, zeroSection_comp_pi]
    rfl
  have hEq := h0.symm
  have hinj : Function.Injective ((AlgebraicGeometry.Proj 𝒜).presheaf.map
      (homOfLE (ProjConeTwist.le_zeroSection_preimage_pi_preimage 𝒜
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b)))).op).hom := by
    rw [show homOfLE (ProjConeTwist.le_zeroSection_preimage_pi_preimage 𝒜
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b))) = eqToHom hEq from Subsingleton.elim _ _]
    exact (ConcreteCategory.bijective_of_isIso _).1
  exact (RingHom.ker_comp_of_injective _ hinj).symm

variable {𝒜} in
/-- The part of `L|_W` over a standard open `D₊(cb)` of `P`. -/
abbrev chartOpen (c b : A) : (pi 𝒜 ⁻¹ᵁ locus 𝒜).toScheme.Opens :=
  (pi 𝒜 ⁻¹ᵁ locus 𝒜).ι ⁻¹ᵁ (pi 𝒜 ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b))

variable {𝒜} in
/-- `π⁻¹ D₊(cb) ⊆ L|_W` when `deg c = deg b + 1`. -/
theorem pi_preimage_basicOpen_mul_le {m : ℕ} {c b : A} (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m) :
    pi 𝒜 ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b) ≤ pi 𝒜 ⁻¹ᵁ locus 𝒜 :=
  Scheme.Hom.preimage_mono _ (basicOpen_mul_le 𝒜 hc hb)

variable {𝒜} in
/-- The image in `L` of the part of `L|_W` over `D₊(cb)` is `π⁻¹ D₊(cb)`. -/
theorem image_chartOpen {m : ℕ} {c b : A} (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m) :
    (pi 𝒜 ⁻¹ᵁ locus 𝒜).ι ''ᵁ chartOpen c b =
      pi 𝒜 ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b) := by
  rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
  exact inf_eq_right.mpr (pi_preimage_basicOpen_mul_le hc hb)

variable {𝒜} in
/-- The part of `L|_W` over `D₊(cb)` is affine. -/
theorem isAffineOpen_chartOpen {m : ℕ} {c b : A} (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m) :
    IsAffineOpen (chartOpen (𝒜 := 𝒜) c b) := by
  have hg := DegreeOneUnitAway.mul_mem hc hb (rfl : c * b = c * b)
  have hD : IsAffineOpen (pi 𝒜 ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 (c * b)) := by
    rw [pi_preimage_basicOpen 𝒜 _ _ hg (Nat.succ_pos _)]
    exact AlgebraicGeometry.Proj.isAffineOpen_basicOpen _ _ ((psi 𝒜).map_mem hg)
      (Nat.succ_pos _)
  exact hD.preimage_of_isOpenImmersion _
    (by rw [Scheme.Opens.opensRange_ι]; exact pi_preimage_basicOpen_mul_le hc hb)

variable {𝒜} in
/-- **Over `D₊(cb)` the ideal of `0|_W` is generated by a nonzerodivisor.** -/
theorem exists_isRegular_ideal_ker_zeroSectionRestrict {m : ℕ} {c b : A}
    (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m) :
    ∃ f : Γ((pi 𝒜 ⁻¹ᵁ locus 𝒜).toScheme, chartOpen c b), _root_.IsRegular f ∧
      (zeroSectionRestrict 𝒜).ker.ideal ⟨_, isAffineOpen_chartOpen hc hb⟩ = Ideal.span {f} := by
  have := isClosedImmersion_zeroSection 𝒜
  obtain ⟨f, hf, hker⟩ := exists_isRegular_ker_zeroSection_app hc hb _ (image_chartOpen hc hb)
  let e := ((pi 𝒜 ⁻¹ᵁ locus 𝒜).ι.appIso (chartOpen (𝒜 := 𝒜) c b)).symm.commRingCatIsoToRingEquiv
  refine ⟨e.symm f, isRegular_map_of_bijective e.symm.toRingHom e.symm.bijective hf, ?_⟩
  have h1 := Scheme.ker_ideal_of_isPullback_of_isOpenImmersion (zeroSection 𝒜)
    (zeroSectionRestrict 𝒜) (locus 𝒜).ι (pi 𝒜 ⁻¹ᵁ locus 𝒜).ι (isPullback_zeroSectionRestrict 𝒜)
    ⟨_, isAffineOpen_chartOpen hc hb⟩
  have h2 := Scheme.Hom.ker_apply (zeroSection 𝒜)
    ⟨_, (isAffineOpen_chartOpen hc hb).image_of_isOpenImmersion (pi 𝒜 ⁻¹ᵁ locus 𝒜).ι⟩
  refine h1.trans ?_
  rw [h2, hker]
  exact (Ideal.comap_symm (I := Ideal.span {f}) e.symm).trans
    ((Ideal.map_span _ _).trans (congrArg Ideal.span (Set.image_singleton)))

/-- **`0(W)` is an effective Cartier divisor on `L|_W`**: the ideal sheaf of the closed
immersion `0|_W : W ⟶ L|_W` is invertible. Over the part of `L|_W` lying above a standard open
`D₊(cb)` with `deg c = deg b + 1` it is generated by the fibre coordinate. -/
@[stacks 0EKF "0(W) is an effective Cartier divisor on L|_W"]
theorem isEffectiveCartierDivisor_ker_zeroSectionRestrict :
    Stacks.Divisors.IsEffectiveCartierDivisor (zeroSectionRestrict 𝒜).ker := by
  refine Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen _ fun x => ?_
  obtain ⟨m, c, b, hc, hb, hxD⟩ := exists_mem_basicOpen_mul 𝒜 ((Scheme.Hom.mem_preimage _).mp x.2)
  exact ⟨_, isAffineOpen_chartOpen hc hb, hxD, exists_isRegular_ideal_ker_zeroSectionRestrict hc hb⟩

/-! ### The punctured cone over `W` -/

/-- **`U|_W` is the complement of the zero section**: a point of `L|_W` lies in the punctured
cone `U` exactly when it is not in the image of `0|_W`. -/
@[stacks 0EKF "U|_W is the complement of the zero section of L|_W"]
theorem coe_preimage_openUInL_eq_compl_range_zeroSectionRestrict :
    (((pi 𝒜 ⁻¹ᵁ locus 𝒜).ι ⁻¹ᵁ openUInL 𝒜 : (pi 𝒜 ⁻¹ᵁ locus 𝒜).toScheme.Opens) :
        Set (pi 𝒜 ⁻¹ᵁ locus 𝒜).toScheme) =
      (Set.range (zeroSectionRestrict 𝒜))ᶜ := by
  set Z := pi 𝒜 ⁻¹ᵁ locus 𝒜
  ext x
  have hpt : ∀ w, Z.ι (zeroSectionRestrict 𝒜 w) = zeroSection 𝒜 ((locus 𝒜).ι w) := fun w => by
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, zeroSectionRestrict_comp_ι]
  have hrange := congrArg (Z.ι x ∈ ·) (range_zeroSection 𝒜)
  simp only [Set.mem_compl_iff, SetLike.mem_coe] at hrange
  change Z.ι x ∈ openUInL 𝒜 ↔ x ∉ Set.range (zeroSectionRestrict 𝒜)
  rw [← not_iff_not, not_not, ← hrange]
  constructor
  · rintro ⟨p, hp⟩
    have hpW : p ∈ locus 𝒜 := by
      have : Z.ι x ∈ (Z : Set _) := by rw [← Scheme.Opens.range_ι Z]; exact ⟨x, rfl⟩
      change pi 𝒜 (Z.ι x) ∈ locus 𝒜 at this
      rwa [← hp, ← Scheme.Hom.comp_apply, zeroSection_comp_pi] at this
    obtain ⟨w, rfl⟩ : p ∈ Set.range (locus 𝒜).ι := by rwa [Scheme.Opens.range_ι]
    exact ⟨w, Z.ι.isOpenEmbedding.injective ((hpt w).trans hp)⟩
  · rintro ⟨w, rfl⟩
    exact ⟨_, (hpt w).symm⟩

end Stacks.AlgebraicGeometry.ProjAndSpecInvertibleLocus

end
