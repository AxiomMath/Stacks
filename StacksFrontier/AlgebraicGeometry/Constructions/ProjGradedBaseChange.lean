module

public import Mathlib.RingTheory.GradedAlgebra.TensorProduct
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.ProjShared.MapDomain

/-!
# The domain of the `Proj` morphism of a graded base change

A homomorphism `ψ : 𝒜 →+*ᵍ ℬ` of nonnegatively graded rings induces a morphism of schemes only
on the open `U(ψ) = ⋃ D₊(ψ f)`, `f` homogeneous of positive degree, which is
`Stacks.AlgebraicGeometry.ProjShared.mapDomain`. For the extension of scalars of a graded
algebra along `R → R'`, graded by the base changes `(𝒜 i) ⊗_R R'` of its homogeneous pieces,
that open is everything: the base-changed irrelevant ideal is generated by the images of the
homogeneous elements of positive degree, so already the standard opens `D₊(1 ⊗ f)` cover
`Proj (R' ⊗_R A)`.

## Main results

* `Stacks.AlgebraicGeometry.ProjShared.mapDomain_baseChange`: the domain of the `Proj`
  morphism of a graded base change is the whole base-changed projective spectrum.

## Implementation notes

The graded ring homomorphism is not constructed here but taken as given together with the
hypothesis that it is `a ↦ 1 ⊗ a`; that hypothesis is all the proof uses, and it leaves the
statement independent of any particular packaging of the canonical map. The covering criterion
is `AlgebraicGeometry.Proj.iSup_basicOpen_eq_top`, whose hypothesis — that the chosen family
spans the irrelevant ideal — is checked by `Submodule.baseChange_eq_span`: each homogeneous
piece of the base change is spanned by the image of the corresponding piece of `𝒜`.

## References

* [Stacks Project, Tag 01N2](https://stacks.math.columbia.edu/tag/01N2)
-/

@[expose] public noncomputable section

namespace Stacks.AlgebraicGeometry.ProjShared

open TensorProduct

universe u

variable {R R' A : Type u} [CommRing R] [CommRing R'] [CommRing A] [Algebra R R'] [Algebra R A]

/-- A graded base-change map has the whole projective spectrum as its domain. -/
@[ega "II 2.8.10" "U(ψ) = Y", ega "II 2.8.9" "G(φ)=Proj(S)"]
public theorem mapDomain_baseChange (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]
    (ψ : 𝒜 →+*ᵍ (fun i ↦ (𝒜 i).baseChange R'))
    (hψ : ∀ a : A, ψ a = 1 ⊗ₜ[R] a) :
    mapDomain 𝒜 (fun i ↦ (𝒜 i).baseChange R') ψ = ⊤ := by
  classical
  let ι := Σ n : {n : ℕ // 0 < n}, 𝒜 n.1
  let f : ι → TensorProduct R R' A := fun i => ψ (i.2 : A)
  have hf : (HomogeneousIdeal.irrelevant (fun i ↦ (𝒜 i).baseChange R')).toIdeal ≤
      Ideal.span (Set.range f) := by
    rw [HomogeneousIdeal.toIdeal_irrelevant_le]
    intro n hn x hx
    rw [Submodule.baseChange_eq_span] at hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      simp only [Submodule.map_coe, Set.mem_image, SetLike.mem_coe] at hx
      obtain ⟨a, ha, rfl⟩ := hx
      exact Ideal.subset_span ⟨⟨⟨n, hn⟩, ⟨a, ha⟩⟩, hψ a⟩
    | zero => exact Ideal.zero_mem _
    | add x y _ _ hx hy => exact Ideal.add_mem _ hx hy
    | smul c x _ hx =>
      rw [Algebra.smul_def]
      exact Ideal.mul_mem_left _ _ hx
  refine top_unique ?_
  rw [← AlgebraicGeometry.Proj.iSup_basicOpen_eq_top
    (𝒜 := fun i ↦ (𝒜 i).baseChange R') f hf]
  exact iSup_le fun i => le_iSup_of_le i.1.1 <| le_iSup_of_le i.1.2 <|
    le_iSup_of_le i.2 le_rfl

end Stacks.AlgebraicGeometry.ProjShared

end
