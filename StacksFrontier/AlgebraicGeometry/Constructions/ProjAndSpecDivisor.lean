module

public import StacksFrontier.AlgebraicGeometry.Constructions.ProjAndSpecChartIdeals
public import StacksFrontier.AlgebraicGeometry.Constructions.ProjQuasiCompact
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.ProjHyperplane
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.CohenMacaulaySlice.EffectiveCartierSlice

/-!
# The divisor `σ(A_d)𝒪_L` on the cone over a quasi-compact `Proj`

Let `A` be an `ℕ`-graded ring, `B = ⨁_{d ≥ 0} A_{≥ d}`, `L = Proj(B) → X = Spec(A)` the cone over
`P = Proj(A)` with zero section `0 : P → L`. For `d ≥ 0` let `D_d ⊆ L` be the closed subscheme
cut out by `σ(A_d)𝒪_L`, the inverse image along `L → X` of the closed subscheme of `X` cut out by
the ideal generated by `A_d`.

Stacks, Section 0EKF: **if `P` is quasi-compact, then for `d` sufficiently divisible `D_d` is an
effective Cartier divisor, `0 : P → L` factors through `D_d`, and `0(P) = D_d` set
theoretically.** Here "sufficiently divisible" means divisible by the least common multiple of
the degrees of finitely many homogeneous elements `f_i` of positive degree whose standard opens
cover `P` (Constructions, Lemma 01MD). With `h_i = f_i^{d / deg f_i} ∈ A_d`, the opens
`D₊(ψ(h_i))` cover `L`, and on `D₊(ψ(h_i)) = Spec((B[1/ψ h_i])₀)` the ideal of `D_d` is
`σ(A_d)(B[1/ψ h_i])₀ = σ(h_i)(B[1/ψ h_i])₀`, generated by a nonzerodivisor
(`Stacks.AlgebraicGeometry.ProjAndSpecChartIdeals`, items (2) and (3)).

## Main definitions

* `Stacks.AlgebraicGeometry.ProjAndSpecDivisor.sigmaIdealSheaf`: the ideal sheaf `σ(A_d)𝒪_L`.

## Main results

* `Stacks.AlgebraicGeometry.ProjAndSpecDivisor.comap_awayι_sigmaIdealSheaf`: on the chart
  `D₊(ψ h)`, `h ∈ A_d`, the ideal is generated by `σ(h)`.
* `Stacks.AlgebraicGeometry.ProjAndSpecDivisor.exists_isEffectiveCartierDivisor_sigmaIdealSheaf`:
  the statement of the section.

## References

* [Stacks Project, Tag 0EKF](https://stacks.math.columbia.edu/tag/0EKF)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory HomogeneousLocalization Stacks.Truncation
open Stacks.AlgebraicGeometry.ProjAndSpecTruncation Stacks.AlgebraicGeometry.ProjAndSpecChartIdeals

namespace Stacks.AlgebraicGeometry.ProjAndSpecDivisor

universe u

variable {A : Type u} {σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- The ideal sheaf `σ(A_d)𝒪_L` on the cone `L = Proj(B)`: the inverse image along `L → X` of the
ideal sheaf on `X = Spec(A)` of the ideal generated by `A_d`. -/
def sigmaIdealSheaf (d : ℕ) : (AlgebraicGeometry.Proj (grading 𝒜)).IdealSheafData :=
  (Scheme.IdealSheafData.ofIdealTop
    (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (Ideal.span (𝒜 d : Set A)))).comap
    (toSpecA 𝒜)

variable {𝒜}

/-- Transporting an ideal of `A` to `Γ(Spec A, ⊤)` and back gives the ideal back. -/
theorem map_hom_map_inv (I : Ideal A) :
    Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom I) = I := by
  rw [Ideal.map_map, ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id, Ideal.map_id]

/-- The chart `Spec((B[1/ψ h])₀) → L` followed by `L → X` is `Spec` of `σ`. -/
theorem awayι_comp_toSpecA {d : ℕ} {h : A} (hh : h ∈ 𝒜 d) (hd : 0 < d) :
    Proj.awayι (grading 𝒜) (psi 𝒜 h) (GradedRingHom.map_mem (psi 𝒜) hh) hd ≫ toSpecA 𝒜 =
      Spec.map (CommRingCat.ofHom (chartSigma 𝒜 h)) := by
  change _ ≫ ProjAndSpec.toSpecA (truncationConeData 𝒜) = _
  rw [ProjAndSpec.toSpecA, reassoc_of% Proj.awayι_toSpecZero, ← Spec.map_comp]
  rfl

/-- **On the chart `D₊(ψ h)`, `h ∈ A_d`, the ideal `σ(A_d)𝒪_L` is generated by `σ(h)`.** -/
theorem comap_awayι_sigmaIdealSheaf {d : ℕ} {h : A} (hh : h ∈ 𝒜 d) (hd : 0 < d) :
    (sigmaIdealSheaf 𝒜 d).comap
        (Proj.awayι (grading 𝒜) (psi 𝒜 h) (GradedRingHom.map_mem (psi 𝒜) hh) hd) =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (CommRingCat.of (Away (grading 𝒜) (psi 𝒜 h)))).inv.hom
          (chartSigma 𝒜 h h)}) := by
  rw [sigmaIdealSheaf, ← Scheme.IdealSheafData.comap_comp, awayι_comp_toSpecA hh hd]
  refine Scheme.IdealSheafData.ext_of_isAffine ?_
  rw [Stacks.IdealSheaf.ideal_comap_top_of_isAffine, Scheme.IdealSheafData.ofIdealTop_ideal,
    Scheme.IdealSheafData.ofIdealTop_ideal,
    show homOfLE (le_top (a := (⊤ : (Spec (CommRingCat.of A)).Opens))) = 𝟙 _ from rfl,
    show homOfLE (le_top (a := (⊤ : (Spec (CommRingCat.of
      (Away (grading 𝒜) (psi 𝒜 h)))).Opens))) = 𝟙 _ from rfl]
  simp only [op_id, CategoryTheory.Functor.map_id, CommRingCat.hom_id, Ideal.map_id]
  have happ : (Spec.map (CommRingCat.ofHom (chartSigma 𝒜 h))).appTop =
      (Scheme.ΓSpecIso (CommRingCat.of A)).hom ≫ CommRingCat.ofHom (chartSigma 𝒜 h) ≫
        (Scheme.ΓSpecIso (CommRingCat.of (Away (grading 𝒜) (psi 𝒜 h)))).inv := by
    rw [← Category.assoc, Iso.eq_comp_inv]
    exact Scheme.ΓSpecIso_naturality _
  rw [happ]
  change Ideal.map ((Scheme.ΓSpecIso (CommRingCat.of (Away (grading 𝒜) (psi 𝒜 h)))).inv.hom.comp
      ((chartSigma 𝒜 h).comp (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom)) _ = _
  have key : Ideal.map (chartSigma 𝒜 h) (Ideal.span (𝒜 d : Set A)) =
      Ideal.span {chartSigma 𝒜 h h} := (span_chartSigma_self_eq_map_span hh).symm
  rw [Ideal.map_map]
  calc _ = Ideal.map ((Scheme.ΓSpecIso (CommRingCat.of (Away (grading 𝒜) (psi 𝒜 h)))).inv.hom.comp
        (chartSigma 𝒜 h)) (Ideal.span (𝒜 d : Set A)) := by
          congr 1
          ext a
          simp
    _ = _ := by
          rw [← Ideal.map_map]
          refine (congrArg (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of
            (Away (grading 𝒜) (psi 𝒜 h)))).inv.hom) key).trans ?_
          exact (Ideal.map_span _ _).trans (congrArg Ideal.span (Set.image_singleton))

/-- `σ(A_d)𝒪_L` restricted to the zero section is zero for `d > 0`: the image of `A_d` under
`A → A₀` vanishes. -/
theorem comap_zeroSection_sigmaIdealSheaf {d : ℕ} (hd : 0 < d) :
    (sigmaIdealSheaf 𝒜 d).comap (zeroSection 𝒜) = ⊥ := by
  rw [sigmaIdealSheaf, ← Scheme.IdealSheafData.comap_comp, zeroSection_comp_toSpecA,
    Scheme.IdealSheafData.comap_comp]
  convert Scheme.IdealSheafData.comap_bot (Proj.toSpecZero 𝒜)
  refine Scheme.IdealSheafData.ext_of_isAffine ?_
  rw [Stacks.IdealSheaf.ideal_comap_top_of_isAffine, Scheme.IdealSheafData.ofIdealTop_ideal,
    Scheme.IdealSheafData.ideal_bot, Pi.bot_apply,
    show homOfLE (le_top (a := (⊤ : (Spec (CommRingCat.of A)).Opens))) = 𝟙 _ from rfl]
  simp only [op_id, CategoryTheory.Functor.map_id, CommRingCat.hom_id, Ideal.map_id]
  have happ : (ProjAndSpec.zToX 𝒜).appTop =
      (Scheme.ΓSpecIso (CommRingCat.of A)).hom ≫
        CommRingCat.ofHom (GradedRing.projZeroRingHom' 𝒜) ≫
          (Scheme.ΓSpecIso (CommRingCat.of (𝒜 0))).inv := by
    rw [← Category.assoc, Iso.eq_comp_inv]
    exact Scheme.ΓSpecIso_naturality _
  rw [happ]
  change Ideal.map ((Scheme.ΓSpecIso (CommRingCat.of (𝒜 0))).inv.hom.comp
      ((GradedRing.projZeroRingHom' 𝒜).comp (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom)) _ = _
  rw [Ideal.map_map]
  calc _ = Ideal.map ((Scheme.ΓSpecIso (CommRingCat.of (𝒜 0))).inv.hom.comp
        (GradedRing.projZeroRingHom' 𝒜)) (Ideal.span (𝒜 d : Set A)) := by
          congr 1
          ext a
          simp
    _ = ⊥ := ?_
  rw [Ideal.map_span, eq_bot_iff, Ideal.span_le]
  rintro _ ⟨a, ha, rfl⟩
  have hker : a ∈ RingHom.ker (GradedRing.projZeroRingHom' 𝒜) := by
    rw [ProjAndSpec.ker_projZeroRingHom']
    exact HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 hd ha
  rw [RingHom.mem_ker] at hker
  simp [hker]

/-- **Stacks, Section 0EKF: if `P` is quasi-compact, then for `d` sufficiently divisible the
closed subscheme `D ⊆ L` cut out by `σ(A_d)𝒪_L` is an effective Cartier divisor, `0 : P → L`
factors through `D`, and `0(P) = D` set theoretically.** "Sufficiently divisible" is divisibility
by a positive integer `d₀`, the product of the degrees of finitely many homogeneous elements of
positive degree whose standard opens cover `P`. -/
@[stacks 0EKF "if P is quasi-compact, then for d sufficiently divisible the closed subscheme \
D ⊆ L cut out by σ(A_d)𝒪_L is an effective Cartier divisor, 0 : P → L factors through D, and \
0(P) = D set theoretically"]
theorem exists_isEffectiveCartierDivisor_sigmaIdealSheaf
    [CompactSpace (AlgebraicGeometry.Proj 𝒜)] :
    ∃ d₀ : ℕ, 0 < d₀ ∧ ∀ d : ℕ, 0 < d → d₀ ∣ d →
      Stacks.Divisors.IsEffectiveCartierDivisor (sigmaIdealSheaf 𝒜 d) ∧
      (∃ g : AlgebraicGeometry.Proj 𝒜 ⟶ (sigmaIdealSheaf 𝒜 d).subscheme,
        g ≫ (sigmaIdealSheaf 𝒜 d).subschemeι = zeroSection 𝒜) ∧
      ((sigmaIdealSheaf 𝒜 d).support : Set (AlgebraicGeometry.Proj (grading 𝒜))) =
        Set.range (zeroSection 𝒜) := by
  classical
  obtain ⟨s, hs, hrad⟩ := (Proj.compactSpace_iff 𝒜).mp ‹_›
  choose! e he hfe using hs
  refine ⟨∏ f ∈ s, e f, Finset.prod_pos fun f hf => he f hf, fun d hd hdvd => ?_⟩
  have hed : ∀ f ∈ s, e f ∣ d := fun f hf => (Finset.dvd_prod_of_mem e hf).trans hdvd
  -- the elements `h_f = f ^ (d / deg f)` of degree `d`
  have hpos : ∀ f ∈ s, 0 < d / e f := fun f hf =>
    Nat.div_pos (Nat.le_of_dvd hd (hed f hf)) (he f hf)
  have hh : ∀ f ∈ s, f ^ (d / e f) ∈ 𝒜 d := fun f hf => by
    have := SetLike.pow_mem_graded (d / e f) (hfe f hf)
    rwa [smul_eq_mul, Nat.div_mul_cancel (hed f hf)] at this
  -- the opens `D₊(ψ h_f)` cover `L`
  have hcovP := Proj.iSup_basicOpen_eq_top_of_irrelevant_le_radical 𝒜 s hrad
  have hcov : ∀ y : AlgebraicGeometry.Proj (grading 𝒜), ∃ f ∈ s,
      psi 𝒜 (f ^ (d / e f)) ∉ y.asHomogeneousIdeal := by
    intro y
    have hy : (pi 𝒜).base y ∈ ⨆ f ∈ s, Proj.basicOpen 𝒜 f := by rw [hcovP]; trivial
    simp only [TopologicalSpace.Opens.mem_iSup] at hy
    obtain ⟨f, hf, hyf⟩ := hy
    have hyf' : y ∈ pi 𝒜 ⁻¹ᵁ Proj.basicOpen 𝒜 f := hyf
    rw [pi_preimage_basicOpen 𝒜 f (e f) (hfe f hf) (he f hf), Proj.mem_basicOpen] at hyf'
    refine ⟨f, hf, fun hmem => hyf' ?_⟩
    rw [map_pow] at hmem
    exact y.isPrime.mem_of_pow_mem _ hmem
  refine ⟨?_, ?_, ?_⟩
  · -- effective Cartier, chart by chart
    let j : ∀ i : s, Spec (CommRingCat.of (Away (grading 𝒜) (psi 𝒜 ((i : A) ^ (d / e i))))) ⟶
        AlgebraicGeometry.Proj (grading 𝒜) := fun i =>
      Proj.awayι (grading 𝒜) (psi 𝒜 ((i : A) ^ (d / e i)))
        (GradedRingHom.map_mem (psi 𝒜) (hh i i.2)) hd
    have hj : ⨆ i, (j i).opensRange = ⊤ := by
      refine top_unique fun y _ => ?_
      obtain ⟨f, hf, hyf⟩ := hcov y
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f, hf⟩, ?_⟩
      simp only [j, Proj.opensRange_awayι]
      exact hyf
    refine Stacks.Chow.GenuineChern.isEffectiveCartierDivisor_of_comap j hj _ fun i => ?_
    simp only [j]
    rw [comap_awayι_sigmaIdealSheaf (hh i i.2) hd]
    refine Stacks.AlgebraicGeometry.isEffectiveCartierDivisor_ofIdealTop_span_singleton ?_
    exact Stacks.Chow.GenuineChern.isRegular_ringEquiv
      (Scheme.ΓSpecIso (CommRingCat.of
        (Away (grading 𝒜) (psi 𝒜 ((i : A) ^ (d / e i)))))).symm.commRingCatIsoToRingEquiv
      (isRegular_iff_mem_nonZeroDivisors.mpr (chartSigma_self_mem_nonZeroDivisors (hh i i.2)))
  · -- `0` factors through `D`
    have hle : (sigmaIdealSheaf 𝒜 d).subschemeι.ker ≤ (zeroSection 𝒜).ker := by
      rw [Scheme.IdealSheafData.ker_subschemeι, ← Scheme.IdealSheafData.map_bot]
      refine Scheme.IdealSheafData.le_map_iff_comap_le.mpr ?_
      rw [comap_zeroSection_sigmaIdealSheaf hd]
    exact ⟨IsClosedImmersion.lift _ _ hle, IsClosedImmersion.lift_fac _ _ hle⟩
  · -- `0(P) = D` set theoretically
    ext y
    rw [range_zeroSection, sigmaIdealSheaf, Scheme.IdealSheafData.support_comap]
    change (toSpecA 𝒜).base y ∈ ((Scheme.IdealSheafData.ofIdealTop (Ideal.map
      (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (Ideal.span (𝒜 d : Set A)))).support :
        Set (Spec (CommRingCat.of A))) ↔ _
    rw [Scheme.IdealSheafData.coe_support_ofIdealTop, Ideal.map_span, Scheme.zeroLocus_span,
      Scheme.mem_zeroLocus_iff, Set.mem_compl_iff, SetLike.mem_coe, ProjAndSpec.mem_openUInL_iff]
    simp only [Set.forall_mem_image, SetLike.mem_coe, not_exists, not_and, not_not]
    have hiff : ∀ a : A, (toSpecA 𝒜).base y ∈
        (Spec (CommRingCat.of A)).basicOpen ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom a) ↔
          ((sigma 𝒜 a : grading 𝒜 0) : TruncationRing 𝒜) ∉ y.asHomogeneousIdeal := by
      intro a
      rw [basicOpen_eq_of_affine (R := CommRingCat.of A) a, ← Proj.mem_basicOpen]
      change y ∈ toSpecA 𝒜 ⁻¹ᵁ ProjAndSpec.specBasicOpen a ↔ _
      rw [ProjAndSpec.toSpecA_preimage_specBasicOpen]
      rfl
    simp only [hiff, not_not]
    constructor
    · intro hD n a hn ha
      obtain ⟨f, hf, hyf⟩ := hcov y
      obtain ⟨z, hz⟩ := (truncationConeData 𝒜).sigma_pow_mul_psi d n hn _ a (hh f hf) ha
      have h1 : ((sigma 𝒜 a : grading 𝒜 0) : TruncationRing 𝒜) ^ d * psi 𝒜 (f ^ (d / e f)) ∈
          y.asHomogeneousIdeal := by
        change ((truncationConeData 𝒜).sigma a : TruncationRing 𝒜) ^ d *
          (truncationConeData 𝒜).psi (f ^ (d / e f)) ∈ _
        rw [hz]
        exact Ideal.mul_mem_right _ _ (hD (hh f hf))
      rcases y.isPrime.mem_or_mem h1 with h2 | h2
      · exact y.isPrime.mem_of_pow_mem d h2
      · exact absurd h2 hyf
    · intro hU a ha
      exact hU d a hd ha

end Stacks.AlgebraicGeometry.ProjAndSpecDivisor

end
