module

public import StacksFrontier.AlgebraicGeometry.Constructions.VectorBundleMapClosedImmersion
public import StacksFrontier.AlgebraicGeometry.Chow.AffineBundle.VectorBundleAffineSpaceBundle
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.QcohLimits.Sections
public import StacksFrontier.AlgebraicGeometry.Chow.GenuineChern.SymRegular

/-!
# The vector bundle of a quotient by a line subbundle is an effective Cartier divisor

Let `X` be a scheme and `0 ⟶ ℒ ⟶ ℱ ⟶ 𝒬 ⟶ 0` a short exact sequence of quasi-coherent
`𝒪_X`-modules with `ℒ` finite locally free of rank one and `𝒬` finite locally free. The induced
morphism of vector bundles `𝐕(𝒬) ⟶ 𝐕(ℱ)` is a closed immersion
(`AlgebraicGeometry.Scheme.Modules.isClosedImmersion_vectorBundleMap_of_epi`), and its image is
an **effective Cartier divisor** on `𝐕(ℱ)`: over an affine open `V` of `X` on which `ℒ` and `𝒬`
are free, `𝐕(ℱ)` is the spectrum of `Sym_{Γ(X, V)}(Γ(ℱ, V))`, the sequence of sections splits as
`Γ(ℱ, V) ≅ Γ(𝒬, V) ⊕ Γ(X, V) e` with `e` a generator of `Γ(ℒ, V)`, and the ideal of `𝐕(𝒬)` there
is generated by `e`, a nonzerodivisor
(`Stacks.Chow.GenuineChern.ker_symAlgMap_eq_span_singleton_of_exact'`).

## Main results

* `AlgebraicGeometry.Scheme.Modules.exists_isAffineOpen_basis_sections_two` — two finite locally
  free sheaves are simultaneously free over small enough affine opens.
* `AlgebraicGeometry.Scheme.Modules.isEffectiveCartierDivisor_ker_vectorBundleMap` — **the image
  of `𝐕(𝒬) ⟶ 𝐕(ℱ)` is an effective Cartier divisor.**
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.AffineAlgebraEquivalence Stacks.SymAlgSections

universe u

namespace AlgebraicGeometry.Scheme.Modules

/-- **Two finite locally free sheaves are simultaneously free over small affine opens.** Around
every point there is an affine open `V` on which `Γ(ℰ, V)` and `Γ(ℰ', V)` are free of the ranks of
`ℰ` and `ℰ'`. -/
theorem exists_isAffineOpen_basis_sections_two {X : Scheme.{u}} (E E' : X.Modules)
    [E.IsQuasicoherent] [E'.IsQuasicoherent] (r r' : ℕ)
    [SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E r]
    [SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E' r'] (x : X) :
    ∃ V : X.Opens, IsAffineOpen V ∧ x ∈ V ∧
      Nonempty (Module.Basis (Fin r) Γ(X, V) Γ(E, V)) ∧
      Nonempty (Module.Basis (Fin r') Γ(X, V) Γ(E', V)) := by
  obtain ⟨U, hxU, ⟨e⟩⟩ := Scheme.Modules.isFiniteLocallyFreeOfRank_of_sheaf E r x
  obtain ⟨U', hxU', ⟨e'⟩⟩ := Scheme.Modules.isFiniteLocallyFreeOfRank_of_sheaf E' r' x
  obtain ⟨V, hV, hxV, hVU⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := U ⊓ U') ⟨hxU, hxU'⟩
  have hr : ∀ W : X.Opens, V ≤ W → Set.range hV.fromSpec.base ⊆ Set.range W.ι.base := fun W h => by
    rw [← Scheme.Hom.coe_opensRange, hV.opensRange_fromSpec, Scheme.Opens.range_ι]
    exact h
  obtain ⟨f⟩ := Stacks.Modules.nonempty_restrictIsoFree_of_range_subset U.ι hV.fromSpec E
    (ULift.{u} (Fin r)) (hr U (hVU.trans inf_le_left)) e
  obtain ⟨f'⟩ := Stacks.Modules.nonempty_restrictIsoFree_of_range_subset U'.ι hV.fromSpec E'
    (ULift.{u} (Fin r')) (hr U' (hVU.trans inf_le_right)) e'
  have hb := (tilde_fixed_free_iff_basis Γ(X, V) Γ(E, V) (ULift.{u} (Fin r))).mp
    ⟨Stacks.Modules.tildeIsoRestrictFromSpec E hV ≪≫ f⟩
  have hb' := (tilde_fixed_free_iff_basis Γ(X, V) Γ(E', V) (ULift.{u} (Fin r'))).mp
    ⟨Stacks.Modules.tildeIsoRestrictFromSpec E' hV ≪≫ f'⟩
  exact ⟨V, hV, hxV, hb.map fun b ↦ b.reindex Equiv.ulift, hb'.map fun b ↦ b.reindex Equiv.ulift⟩

/-- The ring isomorphism `vectorBundleSections` carries nonzerodivisors to nonzerodivisors. -/
private theorem isRegular_vectorBundleSections {X : Scheme.{u}} (F : X.Modules) [F.IsQuasicoherent]
    {V : X.Opens} (hV : IsAffineOpen V) {s : SymmetricAlgebra Γ(X, V) Γ(F, V)}
    (hs : IsRegular s) : IsRegular (vectorBundleSections F hV s) := by
  let θF := RingEquiv.ofBijective (vectorBundleSections F hV) (vectorBundleSections_bijective F hV)
  show IsRegular (θF s)
  refine (Commute.isRegular_iff fun _ => Commute.all _ _).2 fun z₁ z₂ hz => ?_
  obtain ⟨y₁, rfl⟩ := θF.surjective z₁
  obtain ⟨y₂, rfl⟩ := θF.surjective z₂
  exact congrArg θF (hs.1 (θF.injective (by simpa only [map_mul] using hz)))

section Divisor

variable {X : Scheme.{u}} {L F Q : X.Modules} [L.IsQuasicoherent] [F.IsQuasicoherent]
  [Q.IsQuasicoherent] (a : L ⟶ F) (b : F ⟶ Q) (w : a ≫ b = 0)
  (hS : (ShortComplex.mk a b w).ShortExact)

omit [L.IsQuasicoherent] [F.IsQuasicoherent] [Q.IsQuasicoherent] in
include hS in
/-- The sections of a short exact sequence of modules are left exact: over every open, `Γ(a)` is
injective with image the kernel of `Γ(b)`. -/
theorem sections_injective_and_exact (V : X.Opens) :
    Function.Injective (a.app V) ∧ ∀ x : Γ(F, V), b.app V x = 0 ↔ ∃ y, a.app V y = x := by
  have : Mono a := hS.mono_f
  let e := IsLimit.conePointUniqueUpToIso hS.exact.fIsKernel (kernelIsKernel b)
  have he : e.hom ≫ kernel.ι b = a :=
    IsLimit.conePointUniqueUpToIso_hom_comp hS.exact.fIsKernel (kernelIsKernel b)
      WalkingParallelPair.zero
  have hcompapp : ∀ {A B C : X.Modules} (f : A ⟶ B) (g : B ⟶ C) (z : Γ(A, V)),
      (f ≫ g).app V z = g.app V (f.app V z) := fun f g z => by
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have hbij : Function.Bijective (e.hom.app V) := by
    refine ⟨fun x y h => ?_, fun z => ⟨e.inv.app V z, ?_⟩⟩
    · have := congrArg (e.inv.app V) h
      rwa [← hcompapp, ← hcompapp, e.hom_inv_id] at this
    · rw [← hcompapp, e.inv_hom_id]
      rfl
  have hcomp : ∀ y, a.app V y = (kernel.ι b).app V (e.hom.app V y) := fun y => by
    rw [← hcompapp, he]
  refine ⟨fun x y h => hbij.1 (Stacks.AlgebraicGeometry.QcohLimits.injective_app_kernel_ι b V
    (by rw [← hcomp, ← hcomp, h])), fun x => ?_⟩
  rw [Stacks.AlgebraicGeometry.QcohLimits.exact_app_kernel b V x]
  constructor
  · rintro ⟨k, rfl⟩
    obtain ⟨y, rfl⟩ := hbij.2 k
    exact ⟨y, hcomp y⟩
  · rintro ⟨y, rfl⟩
    exact ⟨e.hom.app V y, (hcomp y).symm⟩

omit [L.IsQuasicoherent] in
include hS in
/-- Over an affine open on which `ℒ` and `𝒬` are free, the kernel of `Sym(Γ(b))` is generated by
the image `e` of a generator of `Γ(ℒ, V)`, and `e` is a nonzerodivisor of `Sym(Γ(ℱ, V))`. -/
private theorem ker_symAlgMap_appₗ_eq_span_and_isRegular {r : ℕ} {V : X.Opens} (hV : IsAffineOpen V)
    (bL : Module.Basis (Fin 1) Γ(X, V) Γ(L, V)) (bQ : Module.Basis (Fin r) Γ(X, V) Γ(Q, V)) :
    RingHom.ker (SymPow.symAlgMap (Stacks.AlgebraicGeometry.QcohLimits.appₗ b V)) =
        Ideal.span {SymmetricAlgebra.ι Γ(X, V) Γ(F, V) (a.app V (bL 0))} ∧
      IsRegular (SymmetricAlgebra.ι Γ(X, V) Γ(F, V) (a.app V (bL 0))) := by
  have : Epi b := hS.epi_g
  have hex := sections_injective_and_exact a b w hS V
  set e : Γ(F, V) := a.app V (bL 0) with he_def
  have hspan : ∀ y : Γ(L, V), ∃ c : Γ(X, V), c • bL 0 = y := fun y => by
    refine ⟨bL.repr y 0, ?_⟩
    conv_rhs => rw [← bL.sum_repr y]
    simp
  have hsurj : Function.Surjective (Stacks.AlgebraicGeometry.QcohLimits.appₗ b V) :=
    Stacks.SectionEpiAffine.surjective_app_of_isAffineOpen X b V hV
  have hexL : ∀ z, Stacks.AlgebraicGeometry.QcohLimits.appₗ b V z = 0 ↔
      ∃ c : Γ(X, V), c • e = z := fun z => by
    show b.app V z = 0 ↔ _
    rw [hex.2 z]
    constructor
    · rintro ⟨y, rfl⟩
      obtain ⟨c, rfl⟩ := hspan y
      exact ⟨c, by rw [he_def, Scheme.Modules.Hom.app_smul]⟩
    · rintro ⟨c, rfl⟩
      exact ⟨c • bL 0, by rw [he_def, Scheme.Modules.Hom.app_smul]⟩
  have hfree : ∀ c : Γ(X, V), c • e = 0 → c = 0 := fun c hc => by
    have h0 : a.app V (c • bL 0) = a.app V 0 := by
      rw [Scheme.Modules.Hom.app_smul, ← he_def, hc, map_zero]
    simpa using congrArg (fun z => bL.repr z 0) (hex.1 h0)
  obtain ⟨l, hl⟩ := SymmetricAlgebra.exists_apply_eq_one_of_splitLine
    (Stacks.AlgebraicGeometry.QcohLimits.appₗ b V) hsurj e hexL hfree bQ
  set i : Γ(X, V) →ₗ[Γ(X, V)] Γ(F, V) := LinearMap.toSpanSingleton _ _ e with hi_def
  have hi1 : i 1 = e := by simp [hi_def]
  have hinj : Function.Injective i := by
    refine (injective_iff_map_eq_zero i).2 fun c hc => hfree c ?_
    simpa [hi_def] using hc
  have hrange :
      LinearMap.range i = LinearMap.ker (Stacks.AlgebraicGeometry.QcohLimits.appₗ b V) := by
    ext z
    rw [LinearMap.mem_range, LinearMap.mem_ker, hexL z]
    simp [hi_def]
  obtain ⟨hker, hreg⟩ := Stacks.Chow.GenuineChern.ker_symAlgMap_eq_span_singleton_of_exact' i
    (Stacks.AlgebraicGeometry.QcohLimits.appₗ b V) hinj hsurj hrange l (by rw [hi1, hl])
  rw [hi1] at hker hreg
  exact ⟨hker, hreg⟩

/-- Over an affine open `V`, the ideal of `𝐕(𝒬)` in `𝐕(ℱ)` is generated by the image of a
generator of the kernel of `Sym(Γ(b))`. -/
private theorem ideal_ker_vectorBundleMap_eq_span [Epi b] {V : X.Opens} (hV : IsAffineOpen V)
    {s : SymmetricAlgebra Γ(X, V) Γ(F, V)}
    (hs : RingHom.ker (SymPow.symAlgMap (Stacks.AlgebraicGeometry.QcohLimits.appₗ b V)) =
      Ideal.span {s}) :
    (vectorBundleMap X b).left.ker.ideal
        ⟨vectorBundleToBase X F ⁻¹ᵁ V, isAffineOpen_preimage_vectorBundleToBase X F ⟨V, hV⟩⟩ =
      Ideal.span {vectorBundleSections F hV s} := by
  have := isClosedImmersion_vectorBundleMap_of_epi b
  let θF := RingEquiv.ofBijective (vectorBundleSections F hV) (vectorBundleSections_bijective F hV)
  have hpre : (vectorBundleMap X b).left ⁻¹ᵁ (vectorBundleToBase X F ⁻¹ᵁ V) =
      vectorBundleToBase X Q ⁻¹ᵁ V :=
    congrArg (fun g : vectorBundle X Q ⟶ X => g ⁻¹ᵁ V) (vectorBundleMap_left_comp X b)
  rw [Scheme.Hom.ker_apply]
  have hinjr : Function.Injective ((vectorBundle X Q).presheaf.map
      (homOfLE hpre.ge).op).hom := by
    rw [show homOfLE hpre.ge = eqToHom hpre.symm from Subsingleton.elim _ _]
    exact (ConcreteCategory.bijective_of_isIso _).1
  have hker' : RingHom.ker ((vectorBundleMap X b).left.app
        (vectorBundleToBase X F ⁻¹ᵁ V)).hom =
      RingHom.ker ((vectorBundleMap X b).left.appLE (vectorBundleToBase X F ⁻¹ᵁ V)
        (vectorBundleToBase X Q ⁻¹ᵁ V) hpre.ge).hom := by
    rw [Scheme.Hom.appLE]
    exact (RingHom.ker_comp_of_injective _ hinjr).symm
  rw [hker']
  ext y
  obtain ⟨t, rfl⟩ := θF.surjective y
  show (vectorBundleMap X b).left.appLE _ _ hpre.ge (vectorBundleSections F hV t) = 0 ↔
    vectorBundleSections F hV t ∈ _
  rw [vectorBundleMap_appLE_vectorBundleSections b hV _ t]
  have hz : vectorBundleSections Q hV
        (SymPow.symAlgMap (Stacks.AlgebraicGeometry.QcohLimits.appₗ b V) t) = 0 ↔
      SymPow.symAlgMap (Stacks.AlgebraicGeometry.QcohLimits.appₗ b V) t = 0 := by
    rw [← map_zero (vectorBundleSections Q hV)]
    exact (vectorBundleSections_bijective Q hV).1.eq_iff
  have hk' : SymPow.symAlgMap (Stacks.AlgebraicGeometry.QcohLimits.appₗ b V) t = 0 ↔
      t ∈ Ideal.span {s} := by
    rw [← hs, RingHom.mem_ker]
  rw [hz, hk', Ideal.mem_span_singleton, Ideal.mem_span_singleton]
  show _ ↔ θF s ∣ θF t
  exact ⟨map_dvd θF, fun h => by simpa using map_dvd θF.symm h⟩

include hS in
/-- **The image of `𝐕(𝒬) ⟶ 𝐕(ℱ)` is an effective Cartier divisor**, for a short exact sequence
`0 ⟶ ℒ ⟶ ℱ ⟶ 𝒬 ⟶ 0` of quasi-coherent modules with `ℒ` of rank one and `𝒬` finite locally free:
over an affine open on which `ℒ` and `𝒬` are free, the ideal of `𝐕(𝒬)` is generated by a generator
of `Γ(ℒ, V)`, a nonzerodivisor of `Sym_{Γ(X, V)}(Γ(ℱ, V))`. -/
theorem isEffectiveCartierDivisor_ker_vectorBundleMap (r : ℕ)
    [SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L 1]
    [SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} Q r] :
    haveI : Epi b := hS.epi_g
    Stacks.Divisors.IsEffectiveCartierDivisor (vectorBundleMap X b).left.ker := by
  have : Epi b := hS.epi_g
  refine Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen _ fun x => ?_
  obtain ⟨V, hV, hxV, ⟨bL⟩, ⟨bQ⟩⟩ :=
    exists_isAffineOpen_basis_sections_two L Q 1 r (vectorBundleToBase X F x)
  obtain ⟨hker, hreg⟩ := ker_symAlgMap_appₗ_eq_span_and_isRegular a b w hS hV bL bQ
  exact ⟨_, isAffineOpen_preimage_vectorBundleToBase X F ⟨V, hV⟩, hxV, _,
    isRegular_vectorBundleSections F hV hreg, ideal_ker_vectorBundleMap_eq_span b hV hker⟩

end Divisor

end AlgebraicGeometry.Scheme.Modules

end
