module

public import Mathlib.Algebra.Module.LocalizedModule.Basic
public import StacksFrontier.AlgebraicGeometry.Constructions.ProjLocalizedRingMap
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Restriction maps for graded modules at standard opens of Proj

Let `A = ⨁_{d ≥ 0} 𝒜 d` be a graded ring and let `M = ⨁_{i ∈ ℤ} 𝒨 i` be a graded `A`-module. For
a homogeneous `f` of positive degree, the localization `M_f` carries the degree-zero submodule
`M₍f₎` spanned by the fractions `x / f ^ n` whose numerator and denominator have equal degree;
this is the module of sections of the associated sheaf over `D₊(f)`.

A containment `D₊(g) ⊆ D₊(f)` of standard opens induces a compatible pair of maps `M_f → M_g`
and `M₍f₎ → M₍g₎`, both scalar-semilinear over the corresponding ring maps of
`ProjectiveSpectrum.localizedRingMap` and `ProjectiveSpectrum.degreeZeroRingMap`. The main
result is that the degree-zero map exhibits `M₍g₎` as the localization of `M₍f₎` at the single
degree-zero fraction `g ^ deg f / f ^ deg g` — the module-theoretic counterpart of
`ProjectiveSpectrum.isLocalizationAway_degreeZeroRingMap`, and what makes the associated sheaf
quasi-coherent.

## Main definitions

* `GradedModuleDegreeZeroLocalization`: the degree-zero part `M₍f₎` of a localized graded module.
* `GradedModuleRestrictionMaps`: a compatible pair of maps `M_f → M_g` and `M₍f₎ → M₍g₎`.
* `ProjectiveSpectrum.moduleRestrictionMaps`: the canonical such pair.

## Main results

* `ProjectiveSpectrum.isLocalizedModule_degreeZeroMap`: the restriction `M₍f₎ → M₍g₎` is a
  localization at `g ^ deg f / f ^ deg g`.
* `GradedModuleRestrictionMaps.localizedMap_unique`,
  `GradedModuleRestrictionMaps.degreeZeroMap_unique`: the defining fields pin the pair down.

The defining fields of `GradedModuleRestrictionMaps` say that both maps are induced by the
identity of `M` and that the degree-zero map is the restriction of the map of ordinary
localizations; together these pin the pair down uniquely.

## Implementation notes

The degree-zero submodule is described without choosing a degree for `f`: it is spanned by the
fractions `x / f ^ n` for which *some* `d` has `f ∈ 𝒜 d` and `x ∈ 𝒨 (n • d)`. The description is
independent of that choice, which is the content of `mem_degreeZero_iff`: if `f ^ n ≠ 0` then
`n • d` is determined, by uniqueness of the degree of a nonzero homogeneous element, and if
`f ^ n = 0` the localization is trivial.

A graded ring acts on a ℤ-graded module by `VAdd ℕ ℤ`, the degree of `a • x` being
`deg a + deg x`. That action is supplied as a file-local instance, since `ℕ` acting on `ℤ` by
addition is not an instance Mathlib wants globally.

Both maps are stated as semilinear maps rather than as maps of `A`-modules, so that the scalar
rings are the ones the sheaf uses: the pair is linear over `A_f` respectively `A₍f₎`, with the
scalars transported along the two ring maps of the preceding module.

## References

* [Stacks Project, Tag 01M4](https://stacks.math.columbia.edu/tag/01M4)
-/

@[expose] public section

universe u v w

open DirectSum

/-- The grading action used for a naturally graded ring acting on an integer-graded module. -/
local instance : VAdd ℕ ℤ where
  vadd n z := (n : ℤ) + z

/-- The degree-zero part `M_(f)` of the localization of a graded module `M` away from `f`.
It is generated by the homogeneous fractions whose numerator and denominator have the same
degree. -/
@[ega "II 2.2.7" "M_(f), special case"]
public noncomputable def GradedModuleDegreeZeroLocalization
    {S : Type u} {M : Type v} {σ : Type w} {τ : Type*}
    [CommRing S] [AddCommGroup M] [Module S M]
    [SetLike σ S] [AddSubgroupClass σ S] (𝒜 : ℕ → σ) [GradedRing 𝒜]
    [SetLike τ M] [AddSubgroupClass τ M] (𝒨 : ℤ → τ) [Decomposition 𝒨]
    [SetLike.GradedSMul 𝒜 𝒨] (f : S) :
    letI := Module.compHom (R := Localization.Away f)
      (LocalizedModule.Away (R := S) f M)
      (algebraMap (HomogeneousLocalization.Away 𝒜 f) (Localization.Away f))
    Submodule (HomogeneousLocalization.Away 𝒜 f) (LocalizedModule.Away (R := S) f M) :=
  letI := Module.compHom (R := Localization.Away f)
    (LocalizedModule.Away (R := S) f M)
    (algebraMap (HomogeneousLocalization.Away 𝒜 f) (Localization.Away f))
  Submodule.span (HomogeneousLocalization.Away 𝒜 f)
    {z | ∃ (d n : ℕ) (hf : f ∈ 𝒜 d) (x : M),
      x ∈ 𝒨 (n • (d : ℤ)) ∧ z = LocalizedModule.mk x ⟨f ^ n, by exact ⟨n, rfl⟩⟩}

/-- A compatible pair of restriction maps on an ordinary localized module and on its
degree-zero part.  Both maps are characterized as being induced by the identity of `M`. -/
public structure GradedModuleRestrictionMaps
    {S : Type u} {M : Type v} {σ : Type w} {τ : Type*}
    [CommRing S] [AddCommGroup M] [Module S M]
    [SetLike σ S] [AddSubgroupClass σ S] (𝒜 : ℕ → σ) [GradedRing 𝒜]
    [SetLike τ M] [AddSubgroupClass τ M] (𝒨 : ℤ → τ) [Decomposition 𝒨]
    [SetLike.GradedSMul 𝒜 𝒨] (f g : S)
    (φ : Localization.Away f →ₐ[S] Localization.Away g)
    (φ₀ : HomogeneousLocalization.Away 𝒜 f →ₐ[𝒜 0]
      HomogeneousLocalization.Away 𝒜 g) where
  /-- The map `M_f → M_g` of ordinary localizations, semilinear over `φ`. -/
  localizedMap :
    letI := Module.compHom (R := Localization.Away g) (S := Localization.Away f)
      (LocalizedModule.Away (R := S) g M) φ.toRingHom
    LocalizedModule.Away (R := S) f M →ₗ[Localization.Away f]
      LocalizedModule.Away (R := S) g M
  /-- The map of ordinary localizations is induced by the identity of `M`. -/
  map_mk (m : M) :
    localizedMap (LocalizedModule.mkLinearMap (Submonoid.powers f) M m) =
      LocalizedModule.mkLinearMap (Submonoid.powers g) M m
  /-- The map `M_(f) → M_(g)` of degree-zero parts, semilinear over `φ₀`. -/
  degreeZeroMap :
    letI := Module.compHom (R := Localization.Away f)
      (LocalizedModule.Away (R := S) f M)
      (algebraMap (HomogeneousLocalization.Away 𝒜 f) (Localization.Away f))
    letI := Module.compHom (R := Localization.Away g)
      (LocalizedModule.Away (R := S) g M)
      (algebraMap (HomogeneousLocalization.Away 𝒜 g) (Localization.Away g))
    letI := Module.compHom (R := HomogeneousLocalization.Away 𝒜 g)
      (GradedModuleDegreeZeroLocalization 𝒜 𝒨 g) φ₀.toRingHom
    GradedModuleDegreeZeroLocalization 𝒜 𝒨 f →ₗ[HomogeneousLocalization.Away 𝒜 f]
      GradedModuleDegreeZeroLocalization 𝒜 𝒨 g
  /-- The degree-zero map is the restriction of the map of ordinary localizations. -/
  degreeZeroMap_val (x : GradedModuleDegreeZeroLocalization 𝒜 𝒨 f) :
    (degreeZeroMap x : LocalizedModule.Away (R := S) g M) = localizedMap x

namespace GradedModuleRestrictionMaps

variable {S : Type u} {M : Type v} {σ : Type w} {τ : Type*}
  [CommRing S] [AddCommGroup M] [Module S M]
  [SetLike σ S] [AddSubgroupClass σ S] {𝒜 : ℕ → σ} [GradedRing 𝒜]
  [SetLike τ M] [AddSubgroupClass τ M] {𝒨 : ℤ → τ} [Decomposition 𝒨]
  [SetLike.GradedSMul 𝒜 𝒨] {f g : S}
  {φ : Localization.Away f →ₐ[S] Localization.Away g}
  {φ₀ : HomogeneousLocalization.Away 𝒜 f →ₐ[𝒜 0] HomogeneousLocalization.Away 𝒜 g}

/-- The map `M_f → M_g` of a compatible pair is the only map, semilinear over `φ`, that is
induced by the identity of `M`. -/
public theorem localizedMap_unique (P : GradedModuleRestrictionMaps 𝒜 𝒨 f g φ φ₀)
    (L :
      letI := Module.compHom (R := Localization.Away g) (S := Localization.Away f)
        (LocalizedModule.Away (R := S) g M) φ.toRingHom
      LocalizedModule.Away (R := S) f M →ₗ[Localization.Away f]
        LocalizedModule.Away (R := S) g M)
    (hL : ∀ m : M, L (LocalizedModule.mkLinearMap (Submonoid.powers f) M m) =
      LocalizedModule.mkLinearMap (Submonoid.powers g) M m) :
    L = P.localizedMap := by
  let := Module.compHom (R := Localization.Away g) (S := Localization.Away f)
    (LocalizedModule.Away (R := S) g M) φ.toRingHom
  refine LinearMap.ext fun x => ?_
  induction x using LocalizedModule.induction_on with
  | h m s =>
    have hx : LocalizedModule.mk m s =
        (Localization.mk 1 s : Localization.Away f) • LocalizedModule.mk m 1 := by
      rw [LocalizedModule.mk_smul_mk, one_smul, mul_one]
    rw [hx, L.map_smul, P.localizedMap.map_smul]
    exact congrArg _ ((hL m).trans (P.map_mk m).symm)

/-- The map `M_(f) → M_(g)` of a compatible pair is the only map, semilinear over `φ₀`, that
is the restriction of the map `M_f → M_g`. -/
public theorem degreeZeroMap_unique (P : GradedModuleRestrictionMaps 𝒜 𝒨 f g φ φ₀)
    (N :
      letI := Module.compHom (R := Localization.Away f)
        (LocalizedModule.Away (R := S) f M)
        (algebraMap (HomogeneousLocalization.Away 𝒜 f) (Localization.Away f))
      letI := Module.compHom (R := Localization.Away g)
        (LocalizedModule.Away (R := S) g M)
        (algebraMap (HomogeneousLocalization.Away 𝒜 g) (Localization.Away g))
      letI := Module.compHom (R := HomogeneousLocalization.Away 𝒜 g)
        (GradedModuleDegreeZeroLocalization 𝒜 𝒨 g) φ₀.toRingHom
      GradedModuleDegreeZeroLocalization 𝒜 𝒨 f →ₗ[HomogeneousLocalization.Away 𝒜 f]
        GradedModuleDegreeZeroLocalization 𝒜 𝒨 g)
    (hN : ∀ x : GradedModuleDegreeZeroLocalization 𝒜 𝒨 f,
      (N x : LocalizedModule.Away (R := S) g M) = P.localizedMap x) :
    N = P.degreeZeroMap := by
  let := Module.compHom (R := Localization.Away f)
    (LocalizedModule.Away (R := S) f M)
    (algebraMap (HomogeneousLocalization.Away 𝒜 f) (Localization.Away f))
  let := Module.compHom (R := Localization.Away g)
    (LocalizedModule.Away (R := S) g M)
    (algebraMap (HomogeneousLocalization.Away 𝒜 g) (Localization.Away g))
  let := Module.compHom (R := HomogeneousLocalization.Away 𝒜 g)
    (GradedModuleDegreeZeroLocalization 𝒜 𝒨 g) φ₀.toRingHom
  exact LinearMap.ext fun x => Subtype.ext ((hN x).trans (P.degreeZeroMap_val x).symm)

end GradedModuleRestrictionMaps

namespace ProjectiveSpectrum

variable {S : Type u} {M : Type v} {σ : Type w} {τ : Type*}
  [CommRing S] [AddCommGroup M] [Module S M]
  [SetLike σ S] [AddSubgroupClass σ S] (𝒜 : ℕ → σ) [GradedRing 𝒜]
  [SetLike τ M] [AddSubgroupClass τ M] (𝒨 : ℤ → τ) [Decomposition 𝒨]
  [SetLike.GradedSMul 𝒜 𝒨]

/-- For positive-degree homogeneous `f` and `g` with `D₊(g) ⊆ D₊(f)`, the canonical maps
`M_f → M_g` and `M_(f) → M_(g)` are compatible with each other and with the localization maps
from `M`. -/
public noncomputable def moduleRestrictionMaps (f g : S)
    (hf : ∃ d : ℕ, 0 < d ∧ f ∈ 𝒜 d) (hg : ∃ d : ℕ, 0 < d ∧ g ∈ 𝒜 d)
    (hfg : ProjectiveSpectrum.basicOpen 𝒜 g ≤ ProjectiveSpectrum.basicOpen 𝒜 f) :
    GradedModuleRestrictionMaps 𝒜 𝒨 f g
      (localizedRingMap 𝒜 f g hf hg hfg)
      (degreeZeroRingMap 𝒜 f g hf hg hfg) := by
  let φ := localizedRingMap 𝒜 f g hf hg hfg
  let φ₀ := degreeZeroRingMap 𝒜 f g hf hg hfg
  letI := Module.compHom (R := Localization.Away g)
    (LocalizedModule.Away (R := S) g M) φ.toRingHom
  let ⟨dm, hdm, hm⟩ := Classical.indefiniteDescription _ hf
  let ⟨dn, hdn, hn⟩ := Classical.indefiniteDescription _ hg
  let hex := exists_pow_eq_mul_of_basicOpen_le 𝒜 hm hdm hn hdn hfg
  let ⟨e, _, hex'⟩ := Classical.indefiniteDescription _ hex
  let ⟨a, ha, hpow⟩ := Classical.indefiniteDescription _ hex'
  have hfunit : IsUnit (algebraMap S (Localization.Away g) f) :=
    (IsLocalization.Away.algebraMap_isUnit_iff g).2 ⟨e, a, by simpa [mul_comm] using hpow⟩
  let lmS : LocalizedModule.Away (R := S) f M →ₗ[S] LocalizedModule.Away (R := S) g M :=
    IsLocalizedModule.lift (S := Submonoid.powers f)
      (f := LocalizedModule.mkLinearMap (Submonoid.powers f) M)
      (g := LocalizedModule.mkLinearMap (Submonoid.powers g) M) (by
        intro s
        change IsUnit (algebraMap S (Module.End S (LocalizedModule.Away (R := S) g M)) (s : S))
        rcases s.2 with ⟨n, hn⟩
        rw [← hn]
        have hscalar : algebraMap S (Module.End S (LocalizedModule.Away (R := S) g M)) f =
            (Algebra.lsmul S S (LocalizedModule.Away (R := S) g M))
              ((algebraMap S (Localization.Away g)) f) := by
          ext x
          simp only [Module.algebraMap_end_apply]
          exact (IsScalarTower.algebraMap_smul (Localization.Away g) f x).symm
        rw [map_pow, hscalar]
        simpa only [map_pow] using (hfunit.pow n).map
          (Algebra.lsmul S S (LocalizedModule.Away (R := S) g M)))
  letI : IsScalarTower S (Localization.Away f) (LocalizedModule.Away (R := S) g M) := ⟨by
        intro x y z
        change φ (x • y) • z = x • (φ y • z)
        rw [map_smul]
        exact smul_assoc x (φ y) z⟩
  let lm : LocalizedModule.Away (R := S) f M →ₗ[Localization.Away f]
      LocalizedModule.Away (R := S) g M :=
    lmS.extendScalarsOfIsLocalization (Submonoid.powers f) (Localization.Away f)
  refine { localizedMap := lm, map_mk := ?_, degreeZeroMap := ?_, degreeZeroMap_val := ?_ }
  · intro m
    dsimp [lm]
    exact IsLocalizedModule.lift_apply (Submonoid.powers f)
      (LocalizedModule.mkLinearMap (Submonoid.powers f) M)
      (LocalizedModule.mkLinearMap (Submonoid.powers g) M) _ m
  · let Nf := GradedModuleDegreeZeroLocalization 𝒜 𝒨 f
    let Ng := GradedModuleDegreeZeroLocalization 𝒜 𝒨 g
    letI := Module.compHom (R := Localization.Away f) (LocalizedModule.Away (R := S) f M)
      (algebraMap (HomogeneousLocalization.Away 𝒜 f) (Localization.Away f))
    letI := Module.compHom (R := Localization.Away g) (LocalizedModule.Away (R := S) g M)
      (algebraMap (HomogeneousLocalization.Away 𝒜 g) (Localization.Away g))
    letI := Module.compHom (R := HomogeneousLocalization.Away 𝒜 g)
      (GradedModuleDegreeZeroLocalization 𝒜 𝒨 g) φ₀.toRingHom
    let lmh : LocalizedModule.Away (R := S) f M →ₛₗ[φ₀.toRingHom]
        LocalizedModule.Away (R := S) g M :=
      { lm.toAddHom with
        map_smul' := by
          intro c x
          change lm ((algebraMap (HomogeneousLocalization.Away 𝒜 f)
            (Localization.Away f)) c • x) =
            (algebraMap (HomogeneousLocalization.Away 𝒜 g)
              (Localization.Away g)) (φ₀ c) • lm x
          rw [lm.map_smul]
          exact congrArg (fun r : Localization.Away g => r • lm x)
            (val_degreeZeroRingMap 𝒜 f g hf hg hfg c).symm }
    have hmem : ∀ x ∈ Nf, lmh x ∈ Ng := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem x hx =>
          rcases hx with ⟨d, n, hfd, x, hxd, rfl⟩
          by_cases hz : g ^ e = 0
          · have hsub : Subsingleton (LocalizedModule.Away (R := S) g M) :=
              LocalizedModule.subsingleton_iff.2 fun _ => ⟨g ^ e, ⟨e, rfl⟩, by simp [hz]⟩
            rw [hsub.elim (lmh _) 0]
            exact Ng.zero_mem
          · rcases ha with ⟨da, hda⟩
            have hdeg : e * dn = da + d :=
              degree_eq_of_mem_mem 𝒜 (by simpa [nsmul_eq_mul] using SetLike.pow_mem_graded e hn)
                (by rw [hpow]; exact SetLike.mul_mem_graded hda hfd) hz
            apply Submodule.subset_span
            refine ⟨dn, e * n, hn, a ^ n • x, ?_, ?_⟩
            · have hap : a ^ n ∈ 𝒜 (n * da) := by
                simpa [nsmul_eq_mul] using SetLike.pow_mem_graded n hda
              have := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨) hap hxd
              have hinat : (e * n) * dn = n * da + n * d := by
                simpa [mul_add, mul_comm, mul_left_comm, mul_assoc] using
                  congrArg (fun k => n * k) hdeg
              have hi : ((e * n : ℕ) * dn : ℤ) = (n * da : ℕ) + (n * d : ℕ) := mod_cast hinat
              simp only [nsmul_eq_mul]
              rw [hi]
              convert this using 1
              congr 1
            · change lmS (LocalizedModule.mk x ⟨f ^ n, by exact ⟨n, rfl⟩⟩) = _
              rw [← (hfunit.pow n).smul_left_cancel, ← map_pow, IsScalarTower.algebraMap_smul,
                ← lmS.map_smul, LocalizedModule.smul'_mk]
              let sf : Submonoid.powers f := ⟨f ^ n, ⟨n, rfl⟩⟩
              let saf : Submonoid.powers g :=
                ⟨(a * f) ^ n, ⟨e * n, by
                  simpa only [pow_mul] using congrArg (fun z : S => z ^ n) hpow⟩⟩
              rw [show LocalizedModule.mk (f ^ n • x) sf =
                  LocalizedModule.mk x 1 by
                convert LocalizedModule.mk_cancel_common_left sf 1 x <;>
                  simp [sf, Submonoid.smul_def]]
              dsimp [lmS]
              change (IsLocalizedModule.lift (Submonoid.powers f)
                (LocalizedModule.mkLinearMap (Submonoid.powers f) M)
                (LocalizedModule.mkLinearMap (Submonoid.powers g) M) _)
                (LocalizedModule.mkLinearMap (Submonoid.powers f) M x) = _
              rw [IsLocalizedModule.lift_apply, IsScalarTower.algebraMap_smul,
                LocalizedModule.smul'_mk, LocalizedModule.mkLinearMap_apply, smul_smul,
                mul_comm (f ^ n) (a ^ n), ← mul_pow]
              have hden : (⟨g ^ (e * n), by exact ⟨e * n, rfl⟩⟩ :
                  Submonoid.powers g) = saf := by
                apply Subtype.ext
                change g ^ (e * n) = (a * f) ^ n
                rw [pow_mul, hpow]
              rw [hden]
              simpa only [mul_one, Submonoid.smul_def] using
                (LocalizedModule.mk_cancel_common_left saf 1 x).symm
      | zero =>
          rw [map_zero]
          exact Ng.zero_mem
      | add x y _ _ ihx ihy =>
          rw [map_add]
          exact Ng.add_mem ihx ihy
      | smul c x _ ih =>
          change lmh (c • x) ∈ Ng
          rw [lmh.map_smulₛₗ]
          exact Ng.smul_mem (φ₀ c) ih
    let lmhN := lmh.domRestrict Nf
    let lmhN₀ := lmhN.codRestrict Ng (fun x => hmem x x.property)
    exact { lmhN₀.toAddHom with map_smul' := lmhN₀.map_smul' }
  · exact fun _ => rfl

/-- The degree-zero submodule `M_(f)` consists exactly of the fractions `x / f ^ n` whose
numerator has degree `n • deg f`: the degree `d` in its defining span may always be taken to be
a given one, since a nonzero homogeneous element has a unique degree. -/
private lemma mem_degreeZero_iff (f : S) (d : ℕ) (hf : f ∈ 𝒜 d)
    (y : LocalizedModule.Away f M) :
    y ∈ GradedModuleDegreeZeroLocalization 𝒜 𝒨 f ↔
      ∃ (n : ℕ) (x : M), x ∈ 𝒨 (n • (d : ℤ)) ∧
        y = LocalizedModule.mk x (⟨f ^ n, by exact ⟨n, rfl⟩⟩ : Submonoid.powers f) := by
  classical
  let := Module.compHom (R := Localization.Away f)
    (LocalizedModule.Away (R := S) f M)
    (algebraMap (HomogeneousLocalization.Away 𝒜 f) (Localization.Away f))
  have hsmul : ∀ {a : S} {x : M} {i : ℕ} {j k : ℤ}, a ∈ 𝒜 i → x ∈ 𝒨 j → (i : ℤ) + j = k →
      a • x ∈ 𝒨 k := fun ha hx h => h ▸ SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨) ha hx
  constructor
  · intro hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
        obtain ⟨d', n, hf', x, hx, rfl⟩ := hy
        by_cases hfn : f ^ n = 0
        · have : Subsingleton (LocalizedModule.Away f M) :=
            LocalizedModule.subsingleton (S := Submonoid.powers f) (M := M) (by
              rw [← hfn]
              exact ⟨n, rfl⟩)
          exact ⟨0, 0, by simp, Subsingleton.elim _ _⟩
        · have hdeg : n • d' = n • d :=
            DirectSum.degree_eq_of_mem_mem 𝒜
              (SetLike.pow_mem_graded n hf') (SetLike.pow_mem_graded n hf) hfn
          have hdeg' : n • (d' : ℤ) = n • (d : ℤ) := by
            simpa [nsmul_eq_mul] using congrArg (fun k : ℕ => (k : ℤ)) hdeg
          exact ⟨n, x, hdeg' ▸ hx, rfl⟩
    | zero => exact ⟨0, 0, by simp, by simp⟩
    | add y z _ _ hy hz =>
        obtain ⟨n, x, hx, rfl⟩ := hy
        obtain ⟨m, z, hz, rfl⟩ := hz
        refine ⟨n + m, (f ^ m) • x + (f ^ n) • z, ?_, ?_⟩
        · exact add_mem
            (hsmul (SetLike.pow_mem_graded m hf) hx
              (by simp only [nsmul_eq_mul]; push_cast; ring))
            (hsmul (SetLike.pow_mem_graded n hf) hz
              (by simp only [nsmul_eq_mul]; push_cast; ring))
        · rw [LocalizedModule.mk_add_mk]
          congr 1
          apply Subtype.ext
          simp [pow_add]
    | smul a y _ hy =>
        obtain ⟨n, x, hx, rfl⟩ := hy
        obtain ⟨m, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hf a
        refine ⟨m + n, b • x, ?_, ?_⟩
        · exact hsmul hb hx (by simp only [nsmul_eq_mul]; push_cast; ring)
        · show (HomogeneousLocalization.Away.mk 𝒜 hf m b hb).val •
              LocalizedModule.mk x (⟨f ^ n, by exact ⟨n, rfl⟩⟩ : Submonoid.powers f) = _
          rw [HomogeneousLocalization.Away.val_mk, LocalizedModule.mk_smul_mk]
          congr 1
          apply Subtype.ext
          simp [pow_add]
  · rintro ⟨n, x, hx, rfl⟩
    exact Submodule.subset_span ⟨d, n, hf, x, hx, rfl⟩

/-- For positive-degree homogeneous `f` and `g` with `D₊(g) ⊆ D₊(f)`, the canonical map
`M_(f) → M_(g)` exhibits `M_(g)` as the localization of `M_(f)` at
`g ^ deg(f) / f ^ deg(g)`. -/
public theorem isLocalizedModule_degreeZeroMap (f g : S) (d e : ℕ) (hd : 0 < d) (he : 0 < e)
    (hf : f ∈ 𝒜 d) (hg : g ∈ 𝒜 e)
    (hfg : ProjectiveSpectrum.basicOpen 𝒜 g ≤ ProjectiveSpectrum.basicOpen 𝒜 f) :
    let φ₀ := degreeZeroRingMap 𝒜 f g ⟨d, hd, hf⟩ ⟨e, he, hg⟩ hfg
    let maps := moduleRestrictionMaps 𝒜 𝒨 f g ⟨d, hd, hf⟩ ⟨e, he, hg⟩ hfg
    letI : Algebra (HomogeneousLocalization.Away 𝒜 f)
        (HomogeneousLocalization.Away 𝒜 g) := φ₀.toRingHom.toAlgebra
    letI := Module.compHom (R := HomogeneousLocalization.Away 𝒜 g)
      (GradedModuleDegreeZeroLocalization 𝒜 𝒨 g) φ₀.toRingHom
    IsLocalizedModule
      (Submonoid.powers (HomogeneousLocalization.Away.mk 𝒜 hf e (g ^ d) (by
        simpa [mul_comm] using SetLike.pow_mem_graded d hg)))
      maps.degreeZeroMap := by
  classical
  dsimp only
  let φ₀ := degreeZeroRingMap 𝒜 f g ⟨d, hd, hf⟩ ⟨e, he, hg⟩ hfg
  let maps := moduleRestrictionMaps 𝒜 𝒨 f g ⟨d, hd, hf⟩ ⟨e, he, hg⟩ hfg
  let φ := localizedRingMap 𝒜 f g ⟨d, hd, hf⟩ ⟨e, he, hg⟩ hfg
  let h : HomogeneousLocalization.Away 𝒜 f :=
    HomogeneousLocalization.Away.mk 𝒜 hf e (g ^ d) (by
      simpa [mul_comm] using SetLike.pow_mem_graded d hg)
  let : Algebra (HomogeneousLocalization.Away 𝒜 f)
      (HomogeneousLocalization.Away 𝒜 g) := φ₀.toRingHom.toAlgebra
  let := Module.compHom (R := HomogeneousLocalization.Away 𝒜 g)
    (GradedModuleDegreeZeroLocalization 𝒜 𝒨 g) φ₀.toRingHom
  let : Module (Localization.Away f) (LocalizedModule.Away (R := S) g M) :=
    Module.compHom (R := Localization.Away g)
      (LocalizedModule.Away (R := S) g M) φ.toRingHom
  let L : LocalizedModule.Away f M →ₗ[Localization.Away f]
      LocalizedModule.Away g M := maps.localizedMap
  have hloc : IsLocalization.Away h (HomogeneousLocalization.Away 𝒜 g) := by
    simpa [h, φ₀] using
      isLocalizationAway_degreeZeroRingMap 𝒜 f g d e hd he hf hg hfg
  let := hloc
  have hmap_cancel (N : ℕ) (x : M) :
      algebraMap S (Localization.Away g) (f ^ N) •
          L
            (LocalizedModule.mk x (⟨f ^ N, ⟨N, rfl⟩⟩ : Submonoid.powers f)) =
        LocalizedModule.mkLinearMap (Submonoid.powers g) M x := by
    rw [← (localizedRingMap 𝒜 f g ⟨d, hd, hf⟩ ⟨e, he, hg⟩ hfg).commutes (f ^ N)]
    let q : Submonoid.powers f := ⟨f ^ N, ⟨N, rfl⟩⟩
    show φ (algebraMap S (Localization.Away f) (f ^ N)) •
        L (LocalizedModule.mk x q) = _
    calc
      _ = L (algebraMap S (Localization.Away f) (f ^ N) •
            LocalizedModule.mk x q) := (L.map_smul _ _).symm
      _ = L (LocalizedModule.mkLinearMap (Submonoid.powers f) M x) := by
        congr 1
        rw [← Localization.mk_one_eq_algebraMap]
        rw [LocalizedModule.mk_smul_mk]
        apply LocalizedModule.mk_eq.mpr
        exact ⟨1, by simp [q, Submonoid.smul_def]⟩
      _ = _ := maps.map_mk x
  have hscalar_source :
      algebraMap S (Localization.Away f) (f ^ e) *
          HomogeneousLocalization.val h =
        algebraMap S (Localization.Away f) (g ^ d) := by
    show algebraMap S (Localization.Away f) (f ^ e) *
        (HomogeneousLocalization.Away.mk 𝒜 hf e (g ^ d) _).val = _
    rw [HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
      ← Localization.mk_one_eq_algebraMap, Localization.mk_mul,
      Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp [mul_comm]⟩
  have hscalar :
      algebraMap S (Localization.Away g) (f ^ e) *
          HomogeneousLocalization.val (φ₀ h) =
        algebraMap S (Localization.Away g) (g ^ d) := by
    calc
      _ = φ (algebraMap S (Localization.Away f) (f ^ e)) *
            φ (HomogeneousLocalization.val h) := by
          rw [φ.commutes, val_degreeZeroRingMap]
      _ = φ (algebraMap S (Localization.Away f) (f ^ e) *
            HomogeneousLocalization.val h) := (map_mul φ _ _).symm
      _ = φ (algebraMap S (Localization.Away f) (g ^ d)) := congrArg φ hscalar_source
      _ = _ := φ.commutes _
  refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
  · intro s
    rw [Module.End.isUnit_iff]
    show Function.Bijective (fun a : GradedModuleDegreeZeroLocalization 𝒜 𝒨 g =>
      φ₀ (s : HomogeneousLocalization.Away 𝒜 f) • a)
    exact (IsLocalization.map_units (HomogeneousLocalization.Away 𝒜 g) s).smul_bijective
  · intro y
    obtain ⟨n, x, hx, hy⟩ :=
      (mem_degreeZero_iff 𝒜 𝒨 g e hg (y : LocalizedModule.Away g M)).mp y.2
    let q := d * n - n
    have hq : q + n = d * n := Nat.sub_add_cancel (Nat.le_mul_of_pos_left n hd)
    have hnum : (g ^ q) • x ∈ 𝒨 ((e * n) • (d : ℤ)) := by
      have hx' := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨) (SetLike.pow_mem_graded q hg) hx
      have heq : (q • e : ℕ) +ᵥ (n • (e : ℤ)) = (e * n) • (d : ℤ) := by
        have hq' : (q : ℤ) + n = d * n := mod_cast hq
        simp only [nsmul_eq_mul]
        push_cast
        show (q : ℤ) * e + n * e = _
        linear_combination (e : ℤ) * hq'
      exact heq ▸ hx'
    let z : GradedModuleDegreeZeroLocalization 𝒜 𝒨 f :=
      ⟨LocalizedModule.mk ((g ^ q) • x)
          (⟨f ^ (e * n), ⟨e * n, rfl⟩⟩ : Submonoid.powers f),
        (mem_degreeZero_iff 𝒜 𝒨 f d hf _).mpr ⟨e * n, _, hnum, rfl⟩⟩
    refine ⟨⟨z, ⟨h ^ n, ⟨n, rfl⟩⟩⟩, ?_⟩
    apply Subtype.ext
    rw [maps.degreeZeroMap_val]
    show HomogeneousLocalization.val (φ₀ (h ^ n)) •
        (y : LocalizedModule.Away g M) = L (z : LocalizedModule.Away f M)
    have hfunit : IsUnit (algebraMap S (Localization.Away g) f) :=
      φ.commutes f ▸ (IsLocalization.Away.algebraMap_isUnit
        (S := Localization.Away f) f).map φ
    apply (hfunit.pow (e * n)).smul_bijective.injective
    show (algebraMap S (Localization.Away g) f) ^ (e * n) •
        (HomogeneousLocalization.val (φ₀ (h ^ n)) •
          (y : LocalizedModule.Away g M)) =
      (algebraMap S (Localization.Away g) f) ^ (e * n) • L (z : _)
    rw [← map_pow, ← smul_assoc, hmap_cancel]
    have hscalar_n :
        algebraMap S (Localization.Away g) (f ^ (e * n)) *
            HomogeneousLocalization.val (φ₀ (h ^ n)) =
          algebraMap S (Localization.Away g) (g ^ (d * n)) := by
      simpa only [map_pow, HomogeneousLocalization.val_pow, pow_mul, mul_pow] using
        congrArg (fun z : Localization.Away g => z ^ n) hscalar
    show (algebraMap S (Localization.Away g) (f ^ (e * n)) *
        HomogeneousLocalization.val (φ₀ (h ^ n))) • (y : LocalizedModule.Away g M) = _
    rw [hscalar_n, hy, ← Localization.mk_one_eq_algebraMap,
      LocalizedModule.mk_smul_mk]
    apply LocalizedModule.mk_eq.mpr
    refine ⟨1, ?_⟩
    simp only [one_smul, Submonoid.smul_def, smul_smul, one_mul]
    show g ^ (d * n) • x = (g ^ n * g ^ q) • x
    rw [← pow_add, Nat.add_comm n q, hq]
  · intro a b hab
    have hL : L ((a - b : GradedModuleDegreeZeroLocalization 𝒜 𝒨 f) :
        LocalizedModule.Away f M) = 0 := by
      rw [← maps.degreeZeroMap_val, map_sub, hab, sub_self]
      rfl
    obtain ⟨n, x, hx, hz⟩ := (mem_degreeZero_iff 𝒜 𝒨 f d hf
      ((a - b : GradedModuleDegreeZeroLocalization 𝒜 𝒨 f) :
        LocalizedModule.Away f M)).mp (a - b).2
    have hxzero : LocalizedModule.mkLinearMap (Submonoid.powers g) M x = 0 := by
      rw [← hmap_cancel n x, ← hz, hL, smul_zero]
    have hxzero' : LocalizedModule.mk x (1 : Submonoid.powers g) =
        LocalizedModule.mk (0 : M) (1 : Submonoid.powers g) := by
      simpa only [LocalizedModule.mkLinearMap_apply, LocalizedModule.zero_mk] using hxzero
    obtain ⟨⟨_, k, rfl⟩, hk⟩ := LocalizedModule.mk_eq.mp hxzero'
    have hk' : g ^ k • x = 0 := by
      simpa [Submonoid.smul_def] using hk
    have hxdk : (g ^ d) ^ k • x = 0 := by
      rw [← pow_mul, ← Nat.sub_add_cancel (Nat.le_mul_of_pos_left k hd),
        pow_add, mul_smul, hk', smul_zero]
    refine ⟨⟨h ^ k, ⟨k, rfl⟩⟩, ?_⟩
    show h ^ k • a = h ^ k • b
    apply sub_eq_zero.mp
    rw [← smul_sub]
    apply Subtype.ext
    show (h ^ k).val •
      ((a - b : GradedModuleDegreeZeroLocalization 𝒜 𝒨 f) :
        LocalizedModule.Away f M) = 0
    rw [hz, HomogeneousLocalization.val_pow]
    dsimp only [h]
    rw [HomogeneousLocalization.Away.val_mk, Localization.mk_pow,
      LocalizedModule.mk_smul_mk, hxdk, LocalizedModule.zero_mk]

end ProjectiveSpectrum
