module

public import StacksFrontier.AlgebraicGeometry.Constructions.ProjAndSpec
public import StacksFrontier.RingTheory.GradedAlgebra.Truncation

/-!
# The cone over a projective spectrum, for the truncation algebra

Let `A = ⨁_{d ≥ 0} A_d` be a nonnegatively graded ring and let

  `B = ⨁_{d ≥ 0} A_{≥ d}`

be its truncation graded ring, with `a⁽ᵈ⁾` denoting the element of `B_d` attached to
`a ∈ A_{≥ d}`, with `ψ : A → B` the graded map sending `a ∈ A_d` to `a⁽ᵈ⁾`, with
`τ : B → A` the graded map sending `a⁽ᵈ⁾` to the degree-`d` component of `a`, and with
`σ : A ≃ B₀` the isomorphism `a ↦ a⁽⁰⁾`.

The quadruple `(B, ψ, τ, σ)` satisfies the three divisibility conditions of
`Stacks.AlgebraicGeometry.ProjAndSpec.ConeData`, so the conclusions of Tag 0EKG hold for the
truncation algebra with no hypothesis. Writing `X = Spec A`, `Z = Spec A₀`, `P = Proj A` and
`L = Proj B`, the cone projection `π : L ⟶ P` is affine with `π⁻¹(D₊(f)) = D₊(ψ f)`, the zero
section `0 : P ⟶ L` is a closed immersion with `π ∘ 0 = id_P` whose image is the part of `L` not
lying over `U = X ∖ V(A₊)`, that part is affine over `P`, and the two squares relating `P`, `L`,
`Z` and `X` commute. Moreover `D₊(σ f) ⊆ D₊(ψ f)`, so the inverse image in `L` of a standard open
`D(f)` of `X` is the standard open `D₊(σ f · ψ f)`, and is affine.

## Main definitions

* `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.degElt` is the element `a⁽ᵈ⁾` of `B`.
* `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.psiSpan` and
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.sigmaSpan` are the ideals of `B`
  generated by the `ψ`-images, respectively the `σ`-images, of the positive-degree
  homogeneous elements of `A`.
* `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.truncationConeData` is the cone data of
  the truncation algebra.
* `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.pi`,
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.zeroSection`,
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.toSpecA`,
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.openU` and
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.openUInL` are the cone projection, the
  zero section, the structure morphism `L ⟶ X`, the open `U ⊆ X` and its inverse image in
  `L`, for the truncation algebra.

## Main results

* `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.degElt_mul` is the multiplication rule
  `a⁽ᵈ⁾ · b⁽ᵉ⁾ = (ab)⁽ᵈ⁺ᵉ⁾`, and
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.degElt_pow` its iterate
  `(a⁽ᵈ⁾) ^ n = (a ^ n)⁽ⁿᵈ⁾`.
* `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.exists_pow_mem_psiSpan`,
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.exists_pow_sub_psi_tau_mem` and
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.exists_sigma_pow_mul_psi` are the three
  divisibility conditions.
* `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.pi_preimage_basicOpen`,
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.isAffineHom_pi`,
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.zeroSection_comp_pi`,
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.isClosedImmersion_zeroSection`,
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.range_zeroSection`,
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.isAffineHom_pi_restrict`,
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.pi_comp_toSpecZero` and
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.zeroSection_comp_toSpecA` are the
  geometric conclusions of Tag 0EKG for the truncation algebra, with no hypothesis.
* `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.basicOpen_sigma_le_basicOpen_psi` is the
  inclusion `D₊(σ f) ⊆ D₊(ψ f)`, and
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.toSpecA_preimage_specBasicOpen` and
  `Stacks.AlgebraicGeometry.ProjAndSpecTruncation.isAffineOpen_toSpecA_preimage_specBasicOpen`
  identify the part of `L` lying over a standard open of `X` and show it affine.

## References

* [Stacks Project, Tag 0EKG](https://stacks.math.columbia.edu/tag/0EKG)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory
open Stacks.Truncation

namespace Stacks.AlgebraicGeometry.ProjAndSpecTruncation

universe u

/-! ### The elements `a⁽ᵈ⁾` of the truncation graded ring -/

section Elements

variable {A : Type u} {σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ)

/-- The element `a⁽ᵈ⁾` of `B = ⨁_{d ≥ 0} A_{≥ d}` attached to an element `a` of `A_{≥ d}`,
viewed in `B` rather than in the degree-`d` part `B_d`. -/
def degElt (d : ℕ) (a : A) (ha : a ∈ truncation 𝒜 d) : TruncationRing 𝒜 :=
  ((degreeEquiv 𝒜 d ⟨a, ha⟩ : grading 𝒜 d) : TruncationRing 𝒜)

omit [AddSubgroupClass σ A] in
/-- `a⁽ᵈ⁾` is the image of `a` under the `d`-th inclusion into the direct sum. -/
theorem degElt_eq_of (d : ℕ) (a : A) (ha : a ∈ truncation 𝒜 d) :
    degElt 𝒜 d a ha = DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d ⟨a, ha⟩ :=
  rfl

omit [AddSubgroupClass σ A] in
/-- `a⁽ᵈ⁾` lies in the degree-`d` part of `B`. -/
theorem degElt_mem_grading (d : ℕ) (a : A) (ha : a ∈ truncation 𝒜 d) :
    degElt 𝒜 d a ha ∈ grading 𝒜 d :=
  (degreeEquiv 𝒜 d ⟨a, ha⟩).2

omit [AddSubgroupClass σ A] in
/-- Equal degrees and equal elements give the same element `a⁽ᵈ⁾` of `B`. -/
theorem degElt_congr {d e : ℕ} {a b : A} (hde : d = e) (hab : a = b)
    (ha : a ∈ truncation 𝒜 d) (hb : b ∈ truncation 𝒜 e) :
    degElt 𝒜 d a ha = degElt 𝒜 e b hb := by
  subst hde hab
  rfl

omit [AddSubgroupClass σ A] in
/-- `0⁽ᵈ⁾ = 0`. -/
theorem degElt_zero (d : ℕ) (h : (0 : A) ∈ truncation 𝒜 d) : degElt 𝒜 d 0 h = 0 := by
  rw [degElt_eq_of, show (⟨0, h⟩ : truncation 𝒜 d) = 0 from rfl, map_zero]

omit [AddSubgroupClass σ A] in
/-- `(a + b)⁽ᵈ⁾ = a⁽ᵈ⁾ + b⁽ᵈ⁾`. -/
theorem degElt_add (d : ℕ) (a b : A) (ha : a ∈ truncation 𝒜 d) (hb : b ∈ truncation 𝒜 d)
    (hab : a + b ∈ truncation 𝒜 d) :
    degElt 𝒜 d (a + b) hab = degElt 𝒜 d a ha + degElt 𝒜 d b hb :=
  map_add (DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d) ⟨a, ha⟩ ⟨b, hb⟩

omit [AddSubgroupClass σ A] in
/-- `(-a)⁽ᵈ⁾ = -a⁽ᵈ⁾`. -/
theorem degElt_neg (d : ℕ) (a : A) (ha : a ∈ truncation 𝒜 d)
    (hna : -a ∈ truncation 𝒜 d) : degElt 𝒜 d (-a) hna = -degElt 𝒜 d a ha :=
  map_neg (DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d) ⟨a, ha⟩

omit [AddSubgroupClass σ A] in
/-- `(a - b)⁽ᵈ⁾ = a⁽ᵈ⁾ - b⁽ᵈ⁾`. -/
theorem degElt_sub (d : ℕ) (a b : A) (ha : a ∈ truncation 𝒜 d) (hb : b ∈ truncation 𝒜 d)
    (hab : a - b ∈ truncation 𝒜 d) :
    degElt 𝒜 d (a - b) hab = degElt 𝒜 d a ha - degElt 𝒜 d b hb :=
  map_sub (DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d) ⟨a, ha⟩ ⟨b, hb⟩

end Elements

section GradedRing

variable {A : Type u} {σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- The multiplication rule of the truncation graded ring: `a⁽ᵈ⁾ · b⁽ᵉ⁾ = (ab)⁽ᵈ⁺ᵉ⁾`. -/
theorem degElt_mul (d e : ℕ) (a b : A) (ha : a ∈ truncation 𝒜 d)
    (hb : b ∈ truncation 𝒜 e) :
    degElt 𝒜 d a ha * degElt 𝒜 e b hb =
      degElt 𝒜 (d + e) (a * b) (mul_mem_truncation 𝒜 ha hb) :=
  coe_degreeEquiv_mul 𝒜 d e a b ha hb _

/-- `1⁽⁰⁾ = 1`. -/
theorem degElt_one (h : (1 : A) ∈ truncation 𝒜 0) : degElt 𝒜 0 1 h = 1 :=
  coe_degreeEquiv_one 𝒜 (truncationAlgebra 𝒜)

/-- A power of an element of `A_{≥ m}` lies in `A_{≥ n·m}`. -/
theorem pow_mem_truncation {m : ℕ} {a : A} (ha : a ∈ truncation 𝒜 m) (n : ℕ) :
    a ^ n ∈ truncation 𝒜 (n * m) := by
  induction n with
  | zero => simpa using mem_truncation_zero 𝒜 1
  | succ n ih =>
    rw [pow_succ, show (n + 1) * m = n * m + m from by ring]
    exact mul_mem_truncation 𝒜 ih ha

/-- `(a⁽ᵈ⁾) ^ n = (a ^ n)⁽ⁿᵈ⁾`. -/
theorem degElt_pow (d : ℕ) (a : A) (ha : a ∈ truncation 𝒜 d) (n : ℕ) :
    degElt 𝒜 d a ha ^ n = degElt 𝒜 (n * d) (a ^ n) (pow_mem_truncation 𝒜 ha n) := by
  induction n with
  | zero =>
    rw [pow_zero, degElt_congr 𝒜 (Nat.zero_mul d) (pow_zero a)
      (pow_mem_truncation 𝒜 ha 0) (mem_truncation_zero 𝒜 1), degElt_one]
  | succ n ih =>
    rw [pow_succ, ih, degElt_mul]
    exact degElt_congr 𝒜 (by ring) (pow_succ a n).symm _ _

/-- A power of a homogeneous element of degree `e` lies in `A_{≥ k}` for `k ≤ n·e`. -/
private theorem pow_mem_truncation_of_mem {e k : ℕ} {a : A} (ha : a ∈ 𝒜 e) (n : ℕ)
    (hk : k ≤ n * e) : a ^ n ∈ truncation 𝒜 k :=
  truncation_le_truncation 𝒜 hk (pow_mem_truncation 𝒜 (mem_truncation_of_mem 𝒜 le_rfl ha) n)

/-! ### The maps `σ`, `ψ` and `τ` in terms of the elements `a⁽ᵈ⁾` -/

/-- `ψ a = a⁽ᵈ⁾` for `a` homogeneous of degree `d`. -/
theorem psi_eq_degElt {d : ℕ} (a : A) (ha : a ∈ 𝒜 d) :
    psi 𝒜 a = degElt 𝒜 d a (mem_truncation_of_mem 𝒜 le_rfl ha) :=
  psi_apply 𝒜 d a ha _

/-- `σ a = a⁽⁰⁾`. -/
theorem coe_sigma_eq_degElt (a : A) :
    ((sigma 𝒜 a : grading 𝒜 0) : TruncationRing 𝒜) =
      degElt 𝒜 0 a (mem_truncation_zero 𝒜 a) :=
  coe_sigma_apply 𝒜 a _

/-- `σ 0 = 0`. -/
theorem coe_sigma_zero : ((sigma 𝒜 (0 : A) : grading 𝒜 0) : TruncationRing 𝒜) = 0 :=
  congrArg Subtype.val (map_zero (sigma 𝒜))

/-- `σ (a + b) = σ a + σ b`. -/
theorem coe_sigma_add (a b : A) :
    ((sigma 𝒜 (a + b) : grading 𝒜 0) : TruncationRing 𝒜) =
      ((sigma 𝒜 a : grading 𝒜 0) : TruncationRing 𝒜) +
        ((sigma 𝒜 b : grading 𝒜 0) : TruncationRing 𝒜) :=
  congrArg Subtype.val (map_add (sigma 𝒜) a b)

/-- `σ (-a) = -σ a`. -/
theorem coe_sigma_neg (a : A) :
    ((sigma 𝒜 (-a) : grading 𝒜 0) : TruncationRing 𝒜) =
      -((sigma 𝒜 a : grading 𝒜 0) : TruncationRing 𝒜) :=
  congrArg Subtype.val (map_neg (sigma 𝒜) a)

/-- `τ (a⁽ᵈ⁾)` is the degree-`d` homogeneous component of `a`. -/
theorem tau_degElt (d : ℕ) (a : A) (ha : a ∈ truncation 𝒜 d) :
    tau 𝒜 (degElt 𝒜 d a ha) = GradedRing.proj 𝒜 d a :=
  tau_apply 𝒜 d a ha

/-- `τ ∘ ψ = id_A`. -/
theorem tau_psi_apply (a : A) : tau 𝒜 (psi 𝒜 a) = a :=
  GradedRingHom.congr_fun (tau_comp_psi 𝒜 (truncationAlgebra 𝒜)) a

/-! ### The two ideals generated by the positive-degree part of `A` -/

/-- The ideal of `B` generated by the `ψ`-images of the positive-degree homogeneous elements
of `A`: the ideal generated by the image of the irrelevant ideal of `A`. -/
def psiSpan : Ideal (TruncationRing 𝒜) :=
  Ideal.span (psi 𝒜 '' ⋃ n > 0, (𝒜 n : Set A))

/-- The ideal of `B` generated by the `σ`-images of the positive-degree homogeneous elements
of `A`. -/
def sigmaSpan : Ideal (TruncationRing 𝒜) :=
  Ideal.span ((fun a : A => ((sigma 𝒜 a : grading 𝒜 0) : TruncationRing 𝒜)) ''
    ⋃ n > 0, (𝒜 n : Set A))

/-- `ψ a` lies in `ψ (A₊) · B` for `a` homogeneous of positive degree. -/
theorem psi_mem_psiSpan {n : ℕ} (hn : 0 < n) (a : A) (ha : a ∈ 𝒜 n) :
    psi 𝒜 a ∈ psiSpan 𝒜 :=
  Ideal.subset_span ⟨a, Set.mem_iUnion₂.mpr ⟨n, hn, ha⟩, rfl⟩

/-- `σ a` lies in `σ (A₊) · B` for every `a` of `A_{≥ m}` with `m ≥ 1`. -/
theorem coe_sigma_mem_sigmaSpan {m : ℕ} (hm : 0 < m) (a : A) (ha : a ∈ truncation 𝒜 m) :
    ((sigma 𝒜 a : grading 𝒜 0) : TruncationRing 𝒜) ∈ sigmaSpan 𝒜 := by
  induction ha using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨e, he, hxe⟩ := hx
    exact Ideal.subset_span ⟨x, Set.mem_iUnion₂.mpr ⟨e, by omega, hxe⟩, rfl⟩
  | zero => rw [coe_sigma_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [coe_sigma_add]; exact add_mem hx hy
  | neg x _ hx => rw [coe_sigma_neg]; exact neg_mem hx

/-! ### The first divisibility condition -/

/-- A power of `a⁽ᵈ⁺¹⁾` is divisible by `ψ a`, for `a` homogeneous:
`(a⁽ᵈ⁺¹⁾) ^ (m+1) = (a ^ m)⁽⁽ᵐ⁺¹⁾ᵈ⁾ · ψ a` for `a ∈ A_{m+1}`. -/
theorem degElt_pow_eq_mul_psi (d m : ℕ) (a : A) (ha : a ∈ 𝒜 (m + 1))
    (ha' : a ∈ truncation 𝒜 (d + 1)) (h : a ^ m ∈ truncation 𝒜 ((m + 1) * d)) :
    degElt 𝒜 (d + 1) a ha' ^ (m + 1) =
      degElt 𝒜 ((m + 1) * d) (a ^ m) h * psi 𝒜 a := by
  rw [psi_eq_degElt 𝒜 a ha, degElt_mul, degElt_pow]
  exact degElt_congr 𝒜 (by ring) (pow_succ a m) _ _

/-- The `m`-th power of `a⁽ᵈ⁾` lies in `ψ (A₊) · B` for `a` homogeneous of degree `m` and
`1 ≤ d ≤ m`. -/
theorem degElt_pow_mem_psiSpan {d m : ℕ} (hd : 0 < d) (hdm : d ≤ m) (a : A) (ha : a ∈ 𝒜 m)
    (ha' : a ∈ truncation 𝒜 d) : degElt 𝒜 d a ha' ^ m ∈ psiSpan 𝒜 := by
  obtain ⟨d', rfl⟩ : ∃ d', d = d' + 1 := ⟨d - 1, by omega⟩
  obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
  have hp : a ^ m' ∈ truncation 𝒜 ((m' + 1) * d') :=
    pow_mem_truncation_of_mem 𝒜 ha m'
      ((Nat.mul_le_mul (le_refl (m' + 1)) (show d' ≤ m' by omega)).trans_eq (Nat.mul_comm _ _))
  rw [degElt_pow_eq_mul_psi 𝒜 d' m' a ha ha' hp]
  exact Ideal.mul_mem_left _ _ (psi_mem_psiSpan 𝒜 (Nat.succ_pos m') a ha)

/-- Every element of `B_d` with `d ≥ 1` has a power in `ψ (A₊) · B`. -/
theorem degElt_mem_radical_psiSpan {d : ℕ} (hd : 0 < d) (a : A) (ha : a ∈ truncation 𝒜 d) :
    degElt 𝒜 d a ha ∈ (psiSpan 𝒜).radical := by
  suffices h : ∀ x ∈ truncation 𝒜 d, ∀ hx : x ∈ truncation 𝒜 d,
      degElt 𝒜 d x hx ∈ (psiSpan 𝒜).radical from h a ha ha
  intro x hx
  induction hx using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨m, hm, hym⟩ := hy
    exact fun h => ⟨m, degElt_pow_mem_psiSpan 𝒜 hd hm y hym h⟩
  | zero => intro h; rw [degElt_zero 𝒜 d h]; exact zero_mem _
  | add y z hy hz ihy ihz =>
    intro h
    rw [degElt_add 𝒜 d y z hy hz h]
    exact add_mem (ihy hy) (ihz hz)
  | neg y hy ihy =>
    intro h
    rw [degElt_neg 𝒜 d y hy h]
    exact neg_mem (ihy hy)

/-- The first divisibility condition for the truncation algebra: every homogeneous
element of `B` of positive degree has a power in the ideal generated by the `ψ`-images of
the positive-degree homogeneous elements of `A`. -/
theorem exists_pow_mem_psiSpan (d : ℕ) (hd : 0 < d) (b : TruncationRing 𝒜)
    (hb : b ∈ grading 𝒜 d) :
    ∃ k : ℕ, b ^ k ∈ Ideal.span (psi 𝒜 '' ⋃ n > 0, (𝒜 n : Set A)) := by
  obtain ⟨⟨a, ha⟩, rfl⟩ := (mem_grading_iff 𝒜).mp hb
  rw [← degElt_eq_of 𝒜 d a ha]
  exact degElt_mem_radical_psiSpan 𝒜 hd a ha

/-! ### The second divisibility condition -/

/-- For `b = a⁽ᵈ⁾`, the difference `b - ψ (τ b)` is the element of `B_d` attached to
`a - a_d`. -/
theorem sub_psi_tau_degElt (d : ℕ) (a : A) (ha : a ∈ truncation 𝒜 d)
    (h : a - GradedRing.proj 𝒜 d a ∈ truncation 𝒜 d) :
    degElt 𝒜 d a ha - psi 𝒜 (tau 𝒜 (degElt 𝒜 d a ha)) =
      degElt 𝒜 d (a - GradedRing.proj 𝒜 d a) h := by
  rw [tau_degElt,
    psi_eq_degElt 𝒜 _ (show GradedRing.proj 𝒜 d a ∈ 𝒜 d from SetLike.coe_mem _), degElt_sub]

/-- A power of `a⁽ᵈ⁾` is divisible by `σ a`: `(a⁽ᵈ⁾) ^ (d+1) = (a ^ d)⁽ᵈ⁽ᵈ⁺¹⁾⁾ · σ a`
whenever `a ^ d` lies in `A_{≥ d(d+1)}`. -/
theorem degElt_pow_succ_eq_mul_sigma (d : ℕ) (a : A) (ha : a ∈ truncation 𝒜 d)
    (h : a ^ d ∈ truncation 𝒜 (d * (d + 1))) :
    degElt 𝒜 d a ha ^ (d + 1) =
      degElt 𝒜 (d * (d + 1)) (a ^ d) h *
        ((sigma 𝒜 a : grading 𝒜 0) : TruncationRing 𝒜) := by
  rw [coe_sigma_eq_degElt, degElt_mul, degElt_pow]
  exact degElt_congr 𝒜 (by ring) (pow_succ a d) _ _

/-- The second divisibility condition for the truncation algebra: for a homogeneous `b`
of `B` some power of `b - ψ (τ b)` lies in the ideal generated by the `σ`-images of the
positive-degree homogeneous elements of `A`. -/
theorem exists_pow_sub_psi_tau_mem (d : ℕ) (b : TruncationRing 𝒜) (hb : b ∈ grading 𝒜 d) :
    ∃ k : ℕ, (b - psi 𝒜 (tau 𝒜 b)) ^ k ∈
      Ideal.span ((fun a : A => ((sigma 𝒜 a : grading 𝒜 0) : TruncationRing 𝒜)) ''
        ⋃ n > 0, (𝒜 n : Set A)) := by
  obtain ⟨⟨a, ha⟩, rfl⟩ := (mem_grading_iff 𝒜).mp hb
  have hsucc : a - GradedRing.proj 𝒜 d a ∈ truncation 𝒜 (d + 1) :=
    sub_proj_mem_truncation_succ 𝒜 ha
  have h0 : a - GradedRing.proj 𝒜 d a ∈ truncation 𝒜 d :=
    truncation_le_truncation 𝒜 (by omega) hsucc
  refine ⟨d + 1, ?_⟩
  rw [← degElt_eq_of 𝒜 d a ha, sub_psi_tau_degElt 𝒜 d a ha h0,
    degElt_pow_succ_eq_mul_sigma 𝒜 d _ h0 (pow_mem_truncation 𝒜 hsucc d)]
  exact Ideal.mul_mem_left _ _ (coe_sigma_mem_sigmaSpan 𝒜 (Nat.succ_pos d) _ hsucc)

/-! ### The third divisibility condition -/

/-- The third divisibility condition for the truncation algebra: `σ f` divides
`(σ g) ^ d · ψ f` for `f` homogeneous of degree `d` and `g` homogeneous of positive degree. -/
theorem exists_sigma_pow_mul_psi (d e : ℕ) (he : 0 < e) (f g : A) (hf : f ∈ 𝒜 d)
    (hg : g ∈ 𝒜 e) :
    ∃ z : TruncationRing 𝒜,
      ((sigma 𝒜 g : grading 𝒜 0) : TruncationRing 𝒜) ^ d * psi 𝒜 f =
        ((sigma 𝒜 f : grading 𝒜 0) : TruncationRing 𝒜) * z := by
  have hgd : g ^ d ∈ truncation 𝒜 d :=
    pow_mem_truncation_of_mem 𝒜 hg d (Nat.le_mul_of_pos_right d he)
  refine ⟨degElt 𝒜 d (g ^ d) hgd, ?_⟩
  rw [coe_sigma_eq_degElt, coe_sigma_eq_degElt, psi_eq_degElt 𝒜 f hf, degElt_pow,
    degElt_mul, degElt_mul]
  exact degElt_congr 𝒜 (by ring) (by ring) _ _

/-! ### The cone data of the truncation algebra -/

/-- The truncation algebra `B = ⨁_{d ≥ 0} A_{≥ d}` is cone data over `A`: the maps `ψ`,
`τ` and `σ` satisfy `τ ∘ ψ = id`, the two formulas tying `σ` to `ψ` and `τ`, and the three
divisibility conditions. -/
@[stacks 0EKG "the truncation algebra B = ⨁_{d ≥ 0} A_{≥ d} is cone data over A",
  stacks 0EKF "the graded ring B = ⨁_{d ≥ 0} A_{≥ d} with σ : A → B₀, the graded ring maps \
ψ : A → B and τ : B → A, and τ ∘ ψ = id_A"]
def truncationConeData : ProjAndSpec.ConeData 𝒜 (grading 𝒜) where
  psi := psi 𝒜
  tau := tau 𝒜
  sigma := sigma 𝒜
  tau_psi a := tau_psi_apply 𝒜 a
  psi_pow d hd b hb := exists_pow_mem_psiSpan 𝒜 d hd b hb
  psi_apply_of_mem_zero a ha := by
    rw [coe_sigma_eq_degElt]
    exact psi_eq_degElt 𝒜 a ha
  tau_sigma a := by
    rw [coe_sigma_eq_degElt, tau_degElt]
    rfl
  sub_psi_tau_pow d b hb := exists_pow_sub_psi_tau_mem 𝒜 d b hb
  sigma_pow_mul_psi d e he f g hf hg := exists_sigma_pow_mul_psi 𝒜 d e he f g hf hg

/-! ### The geometry of the cone, unconditionally -/

/-- The cone projection `π : L = Proj B ⟶ P = Proj A` of the truncation algebra. -/
abbrev pi : AlgebraicGeometry.Proj (grading 𝒜) ⟶ AlgebraicGeometry.Proj 𝒜 :=
  ProjAndSpec.pi (truncationConeData 𝒜)

/-- The zero section `0 : P = Proj A ⟶ L = Proj B` of the truncation algebra. -/
abbrev zeroSection : AlgebraicGeometry.Proj 𝒜 ⟶ AlgebraicGeometry.Proj (grading 𝒜) :=
  ProjAndSpec.zeroSection (truncationConeData 𝒜)

/-- The structure morphism `L = Proj B ⟶ X = Spec A` of the truncation algebra. -/
abbrev toSpecA : AlgebraicGeometry.Proj (grading 𝒜) ⟶ Spec (CommRingCat.of A) :=
  ProjAndSpec.toSpecA (truncationConeData 𝒜)

/-- The open `U = X ∖ V(A₊)` of `X = Spec A`. -/
abbrev openU : (Spec (CommRingCat.of A)).Opens :=
  ProjAndSpec.openU 𝒜

/-- The inverse image in `L = Proj B` of the open `U = X ∖ V(A₊)`, for the truncation
algebra. -/
abbrev openUInL : (AlgebraicGeometry.Proj (grading 𝒜)).Opens :=
  ProjAndSpec.openUInL (truncationConeData 𝒜)

/-- The inverse image under `π` of a standard open of `P` is the standard open of the image
element: `π⁻¹(D₊(f)) = D₊(ψ f)`. -/
@[stacks 0EKF "ψ defines π : L → P, and π⁻¹(D₊(f)) = D₊(ψ(f)) for f ∈ A_d, d > 0"]
theorem pi_preimage_basicOpen (f : A) (d : ℕ) (hf : f ∈ 𝒜 d) (hd : 0 < d) :
    pi 𝒜 ⁻¹ᵁ Proj.basicOpen 𝒜 f = Proj.basicOpen (grading 𝒜) (psi 𝒜 f) :=
  ProjAndSpec.pi_preimage_basicOpen (truncationConeData 𝒜) f d hf hd

/-- The cone projection of the truncation algebra is affine. -/
@[stacks 0EKF "π : L → P is an affine morphism"]
theorem isAffineHom_pi : IsAffineHom (pi 𝒜) :=
  ProjAndSpec.isAffineHom_pi (truncationConeData 𝒜)

/-- `π ∘ 0 = id_P` for the truncation algebra. -/
theorem zeroSection_comp_pi :
    zeroSection 𝒜 ≫ pi 𝒜 = 𝟙 (AlgebraicGeometry.Proj 𝒜) :=
  ProjAndSpec.zeroSection_comp_pi (truncationConeData 𝒜)

/-- The zero section of the truncation algebra is a closed immersion. -/
@[stacks 0EKF "the surjection τ defines a closed immersion 0 : P → L"]
theorem isClosedImmersion_zeroSection : IsClosedImmersion (zeroSection 𝒜) :=
  ProjAndSpec.isClosedImmersion_zeroSection (truncationConeData 𝒜)

/-- The part of `L` lying over `U` is the union of the standard opens of the
`σ`-images of the positive-degree homogeneous elements of `A`. -/
@[stacks 0EKG "U ⊆ L is a union of standard opens, for the truncation algebra"]
theorem openUInL_eq_iSup :
    openUInL 𝒜 = ⨆ (d : ℕ) (_ : 0 < d) (f : 𝒜 d),
      Proj.basicOpen (grading 𝒜) ((sigma 𝒜 (f : A) : grading 𝒜 0) : TruncationRing 𝒜) :=
  ProjAndSpec.openUInL_eq_iSup (truncationConeData 𝒜)

/-- The image of the zero section of the truncation algebra is, set theoretically, the
complement of the part of `L` lying over `U = X ∖ V(A₊)`. -/
theorem range_zeroSection :
    Set.range (zeroSection 𝒜) =
      ((openUInL 𝒜 : Set (AlgebraicGeometry.Proj (grading 𝒜))))ᶜ :=
  ProjAndSpec.range_zeroSection (truncationConeData 𝒜)

/-- Over a standard open `D₊(f)` of `P` the part of `L` lying over `U` is the standard open
of `σ f · ψ f`. -/
@[stacks 0EKG "U ⊆ L over a standard open, for the truncation algebra"]
theorem openUInL_inf_basicOpen (f : A) (d : ℕ) (hf : f ∈ 𝒜 d) (hd : 0 < d) :
    openUInL 𝒜 ⊓ Proj.basicOpen (grading 𝒜) (psi 𝒜 f) =
      Proj.basicOpen (grading 𝒜)
        (((sigma 𝒜 f : grading 𝒜 0) : TruncationRing 𝒜) * psi 𝒜 f) :=
  ProjAndSpec.openUInL_inf_basicOpen (truncationConeData 𝒜) f d hf hd

/-- The punctured cone of the truncation algebra is affine over `P`. -/
theorem isAffineHom_pi_restrict : IsAffineHom ((openUInL 𝒜).ι ≫ pi 𝒜) :=
  ProjAndSpec.isAffineHom_pi_restrict (truncationConeData 𝒜)

/-- The right square commutes: `L → P → Z` equals `L → X → Z`. -/
theorem pi_comp_toSpecZero :
    pi 𝒜 ≫ Proj.toSpecZero 𝒜 = toSpecA 𝒜 ≫ ProjAndSpec.xToZ 𝒜 :=
  ProjAndSpec.pi_comp_toSpecZero (truncationConeData 𝒜)

/-- The left square commutes: `P → L → X` equals `P → Z → X`. -/
theorem zeroSection_comp_toSpecA :
    zeroSection 𝒜 ≫ toSpecA 𝒜 = Proj.toSpecZero 𝒜 ≫ ProjAndSpec.zToX 𝒜 :=
  ProjAndSpec.zeroSection_comp_toSpecA (truncationConeData 𝒜)

/-! ### The part of `L` lying over a standard open of `X` -/

/-- `(σ f) ^ (m+1) · (ψ b) ^ d = (f ^ m · b ^ d)⁽ᵈᵐ⁾ · ψ f` for `f ∈ A_d` and
`b ∈ A_{m+1}`. -/
theorem coe_sigma_pow_mul_psi_pow (d m : ℕ) (f b : A) (hf : f ∈ 𝒜 d) (hb : b ∈ 𝒜 (m + 1))
    (h : f ^ m * b ^ d ∈ truncation 𝒜 (d * m)) :
    ((sigma 𝒜 f : grading 𝒜 0) : TruncationRing 𝒜) ^ (m + 1) * psi 𝒜 b ^ d =
      degElt 𝒜 (d * m) (f ^ m * b ^ d) h * psi 𝒜 f := by
  rw [coe_sigma_eq_degElt, psi_eq_degElt 𝒜 b hb, psi_eq_degElt 𝒜 f hf, degElt_pow,
    degElt_pow, degElt_mul, degElt_mul]
  exact degElt_congr 𝒜 (by ring) (by ring) _ _

/-- `D₊(σ f) ⊆ D₊(ψ f)` for `f` homogeneous. -/
theorem basicOpen_sigma_le_basicOpen_psi {d : ℕ} (f : A) (hf : f ∈ 𝒜 d) :
    Proj.basicOpen (grading 𝒜) ((sigma 𝒜 f : grading 𝒜 0) : TruncationRing 𝒜) ≤
      Proj.basicOpen (grading 𝒜) (psi 𝒜 f) := by
  intro y hy
  rw [Proj.mem_basicOpen] at hy ⊢
  intro hfy
  obtain ⟨m, b, hm, hb, hby⟩ :=
    (ProjShared.mem_mapDomain_iff 𝒜 (grading 𝒜) (psi 𝒜) y).mp
      (by
        rw [show ProjShared.mapDomain 𝒜 (grading 𝒜) (psi 𝒜) = ⊤ from
          ProjAndSpec.projMapDomain_psi_eq_top (truncationConeData 𝒜)]
        trivial)
  obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
  have h : f ^ m' * b ^ d ∈ truncation 𝒜 (d * m') :=
    (Nat.add_zero (d * m')) ▸
      mul_mem_truncation 𝒜 (pow_mem_truncation_of_mem 𝒜 hf m' (Nat.mul_comm d m').le)
        (pow_mem_truncation_of_mem 𝒜 hb d (Nat.zero_le _))
  have hmem : ((sigma 𝒜 f : grading 𝒜 0) : TruncationRing 𝒜) ^ (m' + 1) * psi 𝒜 b ^ d ∈
      y.asHomogeneousIdeal.toIdeal := by
    rw [coe_sigma_pow_mul_psi_pow 𝒜 d m' f b hf hb h]
    exact Ideal.mul_mem_left _ _ hfy
  rcases y.isPrime.mem_or_mem hmem with h1 | h1
  · exact hy (y.isPrime.mem_of_pow_mem (m' + 1) h1)
  · exact hby (y.isPrime.mem_of_pow_mem d h1)

/-- The inverse image in `L` of a standard open of `X` is the standard open of
`σ f · ψ f`, a homogeneous element of positive degree, for `f` homogeneous of positive
degree. -/
@[stacks 0EKG "the inverse image in L of a standard open of X"]
theorem toSpecA_preimage_specBasicOpen (f : A) (d : ℕ) (hf : f ∈ 𝒜 d) :
    toSpecA 𝒜 ⁻¹ᵁ ProjAndSpec.specBasicOpen f =
      Proj.basicOpen (grading 𝒜)
        (((sigma 𝒜 f : grading 𝒜 0) : TruncationRing 𝒜) * psi 𝒜 f) := by
  rw [ProjAndSpec.toSpecA_preimage_specBasicOpen, Proj.basicOpen_mul,
    inf_eq_left.mpr (basicOpen_sigma_le_basicOpen_psi 𝒜 f hf)]
  rfl

/-- The part of `L` lying over a standard open of `X` is affine, for `f` homogeneous of
positive degree. -/
@[stacks 0EKG "the part of L over a standard open of X is affine"]
theorem isAffineOpen_toSpecA_preimage_specBasicOpen (f : A) (d : ℕ) (hf : f ∈ 𝒜 d)
    (hd : 0 < d) : IsAffineOpen (toSpecA 𝒜 ⁻¹ᵁ ProjAndSpec.specBasicOpen f) := by
  rw [toSpecA_preimage_specBasicOpen 𝒜 f d hf]
  exact Proj.isAffineOpen_basicOpen (grading 𝒜) _
    (by simpa using SetLike.mul_mem_graded (sigma 𝒜 f).2 ((psi 𝒜).map_mem hf)) hd

end GradedRing

end Stacks.AlgebraicGeometry.ProjAndSpecTruncation

