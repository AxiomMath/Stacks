/-!
# A valuative map to an infinite-dimensional projective space that does not extend

Let `S = ℂ[X₁, X₂, …]` be the polynomial algebra on countably many degree-one generators and let
`T = ℂ[t^α : α ∈ ℚ≥0]` be the monoid algebra on the nonnegative rationals. The algebra map
`X_{i+1} ↦ t^(1/(i+1))` identifies `T` with a ring in which the images of the generators have
exponents tending to zero. Localizing `T` at the prime ideal of positive-exponent monomials
produces a valuation ring `A` whose fraction field `K` receives `S`, hence a morphism
`Spec K ⟶ Proj S` built from the resulting family of global sections. That morphism does not
extend to `Spec A`: an extension would have to invert the ratio `X_{i+2} / X_{i+1}` for some `i`
on the chart where the closed point lands, and that ratio is `t^(1/(i+2) - 1/(i+1))`, a monomial
with negative exponent. So properness fails for projective space over an infinite set of
variables.

## Main definitions

* `AlgebraicGeometry.FractionalExponentExample.polynomialAlgebra` is the polynomial algebra
  `ℂ[X₁, X₂, …]`.
* `AlgebraicGeometry.FractionalExponentExample.fractionalExponentAlgebra` is the monoid algebra
  `ℂ[t^α : α ∈ ℚ≥0]`.
* `AlgebraicGeometry.FractionalExponentExample.positiveIdeal` is the ideal of
  positive-exponent monomials.
* `AlgebraicGeometry.FractionalExponentExample.exponent` is the exponent attached to the
  image of a generator.
* `AlgebraicGeometry.FractionalExponentExample.polynomialMap` is the displayed map of algebras.

## Main results

* `AlgebraicGeometry.FractionalExponentExample.exists_nonextendable_valuative_map` gives the
  valuation ring, its fraction-field map to `Proj`, and its failure to extend.

## Implementation notes

The natural-number index `i` stands for the variable `X_{i+1}` of the polynomial algebra, so the
exponent of the image of the `i`-th generator is `1 / (i + 1)`.

The existential witnesses of the main result include the primality of the positive-exponent ideal
and the unit-ideal condition required by the canonical `Proj.fromOfGlobalSections` construction;
both are properties of the specified rings and map rather than additional hypotheses.

## References

* [Stacks Project, Tag 01MG](https://stacks.math.columbia.edu/tag/01MG)
-/

@[expose] public section

noncomputable section

open AlgebraicGeometry CategoryTheory
open scoped NNRat

namespace AlgebraicGeometry.FractionalExponentExample

/-- The polynomial algebra `ℂ[X₁, X₂, …]`. -/
public abbrev polynomialAlgebra := MvPolynomial ℕ ℂ

/-- The monoid algebra `ℂ[t^α : α ∈ ℚ≥0]`. -/
public abbrev fractionalExponentAlgebra := AddMonoidAlgebra ℂ ℚ≥0

/-- The ideal generated by all monomials with positive rational exponent. -/
public def positiveIdeal : Ideal fractionalExponentAlgebra :=
  Ideal.span {b | ∃ q : ℚ≥0, 0 < q ∧ b = AddMonoidAlgebra.single q (1 : ℂ)}

/-- The exponent of the image of `X_{i+1}`. -/
public def exponent (i : ℕ) : ℚ≥0 := 1 / (i + 1)

/-- The map `X_{i+1} ↦ t^(1/(i+1))`. -/
public def polynomialMap : polynomialAlgebra →ₐ[ℂ] fractionalExponentAlgebra :=
  MvPolynomial.aeval (fun i : ℕ => AddMonoidAlgebra.single (exponent i) (1 : ℂ))

private def exponentZeroHom : Multiplicative ℚ≥0 →* ℂ where
  toFun q := if q.toAdd = 0 then 1 else 0
  map_one' := by simp
  map_mul' a b := by
    change (if a.toAdd + b.toAdd = 0 then (1 : ℂ) else 0) =
      (if a.toAdd = 0 then 1 else 0) * (if b.toAdd = 0 then 1 else 0)
    by_cases ha : a.toAdd = 0 <;> by_cases hb : b.toAdd = 0
    · simp [ha, hb]
    · simp [ha, hb]
    · simp [ha, hb]
    · have ha' : 0 < a.toAdd := lt_of_le_of_ne bot_le (Ne.symm ha)
      have hb' : 0 < b.toAdd := lt_of_le_of_ne bot_le (Ne.symm hb)
      have hsum : a.toAdd + b.toAdd ≠ 0 := (add_pos ha' hb').ne'
      simp [ha, hb, hsum]

private def constantTerm : fractionalExponentAlgebra →ₐ[ℂ] ℂ :=
  AddMonoidAlgebra.lift ℂ ℂ ℚ≥0 exponentZeroHom

/-- The constant term of an element is its coefficient at exponent `0`. -/
private lemma constantTerm_eq_coeff_zero (p : fractionalExponentAlgebra) :
    constantTerm p = p.coeff 0 := by
  simp [constantTerm, AddMonoidAlgebra.lift_apply', exponentZeroHom, eq_comm]

private lemma positiveIdeal_eq_constantTerm_ker :
    positiveIdeal = RingHom.ker constantTerm.toRingHom := by
  apply le_antisymm
  · apply Ideal.span_le.2
    rintro b ⟨q, hq, rfl⟩
    change constantTerm.toRingHom (AddMonoidAlgebra.single q (1 : ℂ)) = 0
    simp [constantTerm, exponentZeroHom, AddMonoidAlgebra.lift_single, hq.ne']
  · intro p hp
    have hp0 : p.coeff 0 = 0 := (constantTerm_eq_coeff_zero p).symm.trans hp
    classical
    rw [positiveIdeal, ← AddMonoidAlgebra.sum_coeff_single p]
    apply Ideal.sum_mem
    intro q hq
    have hqpos : 0 < q := pos_iff_ne_zero.mpr (by
      rintro rfl
      exact (Finsupp.mem_support_iff.mp hq) hp0)
    rw [show AddMonoidAlgebra.single q (p.coeff q) =
        AddMonoidAlgebra.single q (1 : ℂ) * AddMonoidAlgebra.single 0 (p.coeff q) by simp]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨q, hqpos, rfl⟩)

private lemma positiveIdeal_isPrime : positiveIdeal.IsPrime := by
  rw [positiveIdeal_eq_constantTerm_ker]
  exact RingHom.ker_isPrime constantTerm.toRingHom

private noncomputable def leastExponent (p : fractionalExponentAlgebra) (hp : p ≠ 0) : ℚ≥0 :=
  p.coeff.support.min' (Finsupp.support_nonempty_iff.mpr fun h =>
    hp (AddMonoidAlgebra.coeff_injective h))

private def shiftedPart (p : fractionalExponentAlgebra) (q : ℚ≥0) : fractionalExponentAlgebra :=
  p.coeff.sum fun r c => AddMonoidAlgebra.single (r - q) c

private lemma shiftedPart_coeff_zero (p : fractionalExponentAlgebra) (q : ℚ≥0)
    (hq : q ∈ p.coeff.support)
    (hle : ∀ r ∈ p.coeff.support, q ≤ r) :
    (shiftedPart p q).coeff 0 = p.coeff q := by
  classical
  rw [shiftedPart, AddMonoidAlgebra.coeff_finsuppSum, Finsupp.sum_apply]
  change (∑ r ∈ p.coeff.support,
      (AddMonoidAlgebra.single (r - q) (p.coeff r)).coeff 0) = p.coeff q
  rw [Finset.sum_eq_single q]
  · simp
  · intro r hr hrq
    have hdiff : r - q ≠ 0 := by
      intro hzero
      exact (not_le_of_gt (lt_of_le_of_ne (hle r hr) (Ne.symm hrq)))
        ((tsub_eq_zero_iff_le.mp hzero))
    simp [hdiff]
  · exact fun hq' => (hq' hq).elim

/-- Splitting the monomial `t^r` as `t^q * t^(r - q)` for `q ≤ r`. -/
private lemma single_mul_sub (q r : ℚ≥0) (c : ℂ) (hqr : q ≤ r) :
    AddMonoidAlgebra.single q (1 : ℂ) * AddMonoidAlgebra.single (r - q) c =
    AddMonoidAlgebra.single r c := by
  rw [AddMonoidAlgebra.single_mul_single, one_mul, add_tsub_cancel_of_le hqr]

private lemma factor_by_leastExponent (p : fractionalExponentAlgebra) (hp : p ≠ 0) :
    p = AddMonoidAlgebra.single (leastExponent p hp) (1 : ℂ) *
      shiftedPart p (leastExponent p hp) := by
  classical
  let q := leastExponent p hp
  have hle (r : ℚ≥0) (hr : r ∈ p.coeff.support) : q ≤ r :=
    Finset.min'_le _ _ hr
  calc
    p = p.coeff.sum (fun r c => AddMonoidAlgebra.single r c) :=
      (AddMonoidAlgebra.sum_coeff_single p).symm
    _ = AddMonoidAlgebra.single q (1 : ℂ) * shiftedPart p q := by
      change (∑ r ∈ p.coeff.support, AddMonoidAlgebra.single r (p.coeff r)) =
        AddMonoidAlgebra.single q (1 : ℂ) *
          ∑ r ∈ p.coeff.support, AddMonoidAlgebra.single (r - q) (p.coeff r)
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun r hr => (single_mul_sub q r _ (hle r hr)).symm

private lemma leastExponent_mem (p : fractionalExponentAlgebra) (hp : p ≠ 0) :
    leastExponent p hp ∈ p.coeff.support :=
  Finset.min'_mem _ _

private lemma leastExponent_le (p : fractionalExponentAlgebra) (hp : p ≠ 0) {r : ℚ≥0}
    (hr : r ∈ p.coeff.support) : leastExponent p hp ≤ r :=
  Finset.min'_le _ _ hr

private lemma shiftedPart_not_mem_positiveIdeal (p : fractionalExponentAlgebra) (hp : p ≠ 0) :
    shiftedPart p (leastExponent p hp) ∉ positiveIdeal := by
  rw [positiveIdeal_eq_constantTerm_ker]
  intro h
  have hval : (shiftedPart p (leastExponent p hp)).coeff 0 = 0 :=
    (constantTerm_eq_coeff_zero _).symm.trans h
  rw [shiftedPart_coeff_zero p _ (leastExponent_mem p hp)
    (fun r hr => leastExponent_le p hp hr)] at hval
  exact (Finsupp.mem_support_iff.mp (leastExponent_mem p hp)) hval

private lemma localization_factor (hm : positiveIdeal.IsPrime)
    (p : fractionalExponentAlgebra) (hp : p ≠ 0) :
    ∃ q : ℚ≥0, ∃ u : Localization positiveIdeal.primeCompl,
      IsUnit u ∧
        algebraMap fractionalExponentAlgebra (Localization positiveIdeal.primeCompl) p =
          algebraMap fractionalExponentAlgebra (Localization positiveIdeal.primeCompl)
            (AddMonoidAlgebra.single q (1 : ℂ)) * u := by
  let : positiveIdeal.IsPrime := hm
  let q := leastExponent p hp
  let u : Localization positiveIdeal.primeCompl :=
    algebraMap fractionalExponentAlgebra _ (shiftedPart p q)
  have hu : IsUnit u := by
    change IsUnit (algebraMap fractionalExponentAlgebra (Localization positiveIdeal.primeCompl)
      (shiftedPart p q))
    exact IsLocalization.map_units (Localization positiveIdeal.primeCompl)
      ⟨shiftedPart p q,
        Ideal.mem_primeCompl_iff.mpr (by
          simpa [q] using shiftedPart_not_mem_positiveIdeal p hp)⟩
  refine ⟨q, u, hu, ?_⟩
  change algebraMap fractionalExponentAlgebra (Localization positiveIdeal.primeCompl) p = _
  rw [factor_by_leastExponent p hp]
  simp [u, q]

private lemma localization_element_factor (hm : positiveIdeal.IsPrime)
    (a : Localization positiveIdeal.primeCompl) (ha : a ≠ 0) :
    ∃ q : ℚ≥0, ∃ u : Localization positiveIdeal.primeCompl,
      IsUnit u ∧
        a = algebraMap fractionalExponentAlgebra (Localization positiveIdeal.primeCompl)
          (AddMonoidAlgebra.single q (1 : ℂ)) * u := by
  let : positiveIdeal.IsPrime := hm
  obtain ⟨⟨p, s⟩, hrep⟩ := IsLocalization.surj positiveIdeal.primeCompl a
  have hmk_spec :
      IsLocalization.mk' (Localization positiveIdeal.primeCompl) p s *
          algebraMap fractionalExponentAlgebra (Localization positiveIdeal.primeCompl) s =
        algebraMap fractionalExponentAlgebra (Localization positiveIdeal.primeCompl) p :=
    IsLocalization.mk'_spec (Localization positiveIdeal.primeCompl) p s
  have hrepr : a = IsLocalization.mk' (Localization positiveIdeal.primeCompl) p s :=
    mul_right_cancel₀ (IsLocalization.map_units (Localization positiveIdeal.primeCompl) s).ne_zero
      (hrep.trans hmk_spec.symm)
  have hp : p ≠ 0 := by
    intro hzero
    have hzero' :
        a * algebraMap fractionalExponentAlgebra
          (Localization positiveIdeal.primeCompl) s = 0 := by
      simpa [hzero] using hrep
    rcases mul_eq_zero.mp hzero' with hz | hdenom_zero
    · exact ha hz
    · exact (IsLocalization.map_units (Localization positiveIdeal.primeCompl) s).ne_zero
        hdenom_zero
  obtain ⟨q, u, hu, hfactor⟩ := localization_factor hm p hp
  have hs : IsUnit (IsLocalization.mk' (Localization positiveIdeal.primeCompl)
      (1 : fractionalExponentAlgebra) s) := by
    apply isUnit_iff_exists_inv.mpr
    refine ⟨algebraMap fractionalExponentAlgebra (Localization positiveIdeal.primeCompl) s, ?_⟩
    rw [IsLocalization.mk'_spec (Localization positiveIdeal.primeCompl) 1 s]
    simp
  refine ⟨q, u * IsLocalization.mk' (Localization positiveIdeal.primeCompl) 1 s,
    hu.mul hs, ?_⟩
  rw [hrepr, IsLocalization.mk'_eq_mul_mk'_one
    (S := Localization positiveIdeal.primeCompl) p s,
    hfactor]
  ac_rfl

private lemma localization_divisibility (hm : positiveIdeal.IsPrime)
    (a b : Localization positiveIdeal.primeCompl) : a ∣ b ∨ b ∣ a := by
  let : positiveIdeal.IsPrime := hm
  obtain rfl | ha := eq_or_ne a 0
  · exact Or.inr ⟨0, by simp⟩
  obtain rfl | hb := eq_or_ne b 0
  · exact Or.inl ⟨0, by simp⟩
  obtain ⟨qa, ua, hua, hfa⟩ := localization_element_factor hm a ha
  obtain ⟨qb, ub, hub, hfb⟩ := localization_element_factor hm b hb
  have step (q r : ℚ≥0) (u v : Localization positiveIdeal.primeCompl)
      (hqr : q ≤ r) (hu : IsUnit u) :
      algebraMap fractionalExponentAlgebra (Localization positiveIdeal.primeCompl)
        (AddMonoidAlgebra.single q (1 : ℂ)) * u ∣
      algebraMap fractionalExponentAlgebra (Localization positiveIdeal.primeCompl)
        (AddMonoidAlgebra.single r (1 : ℂ)) * v := by
    exact hu.mul_right_dvd.2 (Dvd.dvd.mul_right
      ⟨algebraMap fractionalExponentAlgebra (Localization positiveIdeal.primeCompl)
        (AddMonoidAlgebra.single (r - q) (1 : ℂ)), by rw [← map_mul, single_mul_sub q r _ hqr]⟩ v)
  rcases le_total qa qb with hle | hle
  · left
    rw [hfa, hfb]
    exact step qa qb ua ub hle hua
  · right
    rw [hfa, hfb]
    exact step qb qa ub ua hle hub

private lemma localization_valuationRing (hm : positiveIdeal.IsPrime) :
    ValuationRing (Localization positiveIdeal.primeCompl) := by
  let : positiveIdeal.IsPrime := hm
  let : PreValuationRing (Localization positiveIdeal.primeCompl) := {
    cond' := by
      intro a b
      rcases localization_divisibility hm a b with ⟨c, hc⟩ | ⟨c, hc⟩
      · exact ⟨c, Or.inl (by simpa [mul_comm] using hc.symm)⟩
      · exact ⟨c, Or.inr hc.symm⟩
  }
  exact ValuationRing.mk

private lemma localization_isValuationRing (hm : positiveIdeal.IsPrime) :
    IsValuationRing (Localization positiveIdeal.primeCompl) := by
  let : positiveIdeal.IsPrime := hm
  let : ValuationRing (Localization positiveIdeal.primeCompl) := localization_valuationRing hm
  let A := Localization positiveIdeal.primeCompl
  change IsMax (LocalSubring.range (algebraMap A (FractionRing A)))
  let v := ValuationRing.valuation A (FractionRing A)
  apply (LocalSubring.isMax_iff).2
  refine ⟨v.valuationSubring, ?_⟩
  apply LocalSubring.toSubring_injective
  change v.valuationSubring.toSubring = (algebraMap A (FractionRing A)).range
  rw [← ValuationRing.range_algebraMap_eq A (FractionRing A)]
  rfl

private lemma target_algebraMap_fraction_injective (hm : positiveIdeal.IsPrime) :
    Function.Injective (algebraMap fractionalExponentAlgebra
      (FractionRing (Localization positiveIdeal.primeCompl))) := by
  let : positiveIdeal.IsPrime := hm
  let A := Localization positiveIdeal.primeCompl
  let K := FractionRing A
  have hM : positiveIdeal.primeCompl ≤ nonZeroDivisors fractionalExponentAlgebra := by
    intro s hs
    rw [mem_nonZeroDivisors_iff_ne_zero]
    intro hs0
    exact (Ideal.mem_primeCompl_iff.mp hs) (hs0 ▸ positiveIdeal.zero_mem)
  rw [IsScalarTower.algebraMap_eq fractionalExponentAlgebra A K]
  exact (IsFractionRing.injective A K).comp (IsLocalization.injective A hM)

private lemma projective_variables_cover
    [GradedRing (MvPolynomial.homogeneousSubmodule ℕ ℂ)] :
    (⨆ i : ℕ, Proj.basicOpen (MvPolynomial.homogeneousSubmodule ℕ ℂ)
      (MvPolynomial.X i)) = ⊤ := by
  classical
  apply Proj.iSup_basicOpen_eq_top'
  · exact fun i => ⟨1, MvPolynomial.isHomogeneous_X ℂ i⟩
  · apply top_unique
    intro p hp
    clear hp
    change p ∈ Algebra.adjoin
      (MvPolynomial.homogeneousSubmodule ℕ ℂ 0)
      (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ ℂ))
    induction p using MvPolynomial.induction_on with
    | C r =>
        let c : MvPolynomial.homogeneousSubmodule ℕ ℂ 0 := ⟨MvPolynomial.C r, by simp⟩
        change (c : MvPolynomial ℕ ℂ) ∈ _
        exact (Algebra.adjoin (MvPolynomial.homogeneousSubmodule ℕ ℂ 0)
          (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ ℂ))).algebraMap_mem c
    | add p q hp hq => exact (Algebra.adjoin _ _).add_mem hp hq
    | mul_X p i hp =>
        exact (Algebra.adjoin _ _).mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)

private lemma not_exists_monomial_ratio (hm : positiveIdeal.IsPrime)
    (q r : ℚ≥0) (hrq : r < q) :
    letI : positiveIdeal.IsPrime := hm
    let A := Localization positiveIdeal.primeCompl
    let K := FractionRing A
    ¬ ∃ a : A, algebraMap A K a *
        algebraMap fractionalExponentAlgebra K (AddMonoidAlgebra.single q (1 : ℂ)) =
      algebraMap fractionalExponentAlgebra K (AddMonoidAlgebra.single r (1 : ℂ)) := by
  let : positiveIdeal.IsPrime := hm
  let A := Localization positiveIdeal.primeCompl
  let K := FractionRing A
  change ¬ ∃ a : A, algebraMap A K a *
    algebraMap fractionalExponentAlgebra K (AddMonoidAlgebra.single q (1 : ℂ)) =
      algebraMap fractionalExponentAlgebra K (AddMonoidAlgebra.single r (1 : ℂ))
  rintro ⟨a, ha⟩
  let b : fractionalExponentAlgebra := AddMonoidAlgebra.single (q - r) (1 : ℂ)
  have hfactor : AddMonoidAlgebra.single q (1 : ℂ) =
      AddMonoidAlgebra.single r (1 : ℂ) * b :=
    (single_mul_sub r q 1 hrq.le).symm
  have hr : algebraMap fractionalExponentAlgebra K (AddMonoidAlgebra.single r (1 : ℂ)) ≠ 0 := by
    simpa only [map_zero] using (target_algebraMap_fraction_injective hm).ne
      (show AddMonoidAlgebra.single r (1 : ℂ) ≠ 0 by simp)
  have hab : algebraMap A K a * algebraMap fractionalExponentAlgebra K b = 1 := by
    apply mul_left_cancel₀ hr
    rw [mul_one, mul_left_comm]
    rwa [hfactor, map_mul] at ha
  have habA : a * algebraMap fractionalExponentAlgebra A b = 1 := by
    apply IsFractionRing.injective A K
    simpa only [map_mul, map_one,
      IsScalarTower.algebraMap_apply fractionalExponentAlgebra A K] using hab
  have hbunit : IsUnit (algebraMap fractionalExponentAlgebra A b) :=
    isUnit_iff_exists_inv.mpr ⟨a, by simpa [mul_comm] using habA⟩
  have hbmem : b ∈ positiveIdeal :=
    Ideal.subset_span ⟨q - r, tsub_pos_iff_lt.mpr hrq, rfl⟩
  exact (Ideal.mem_primeCompl_iff.mp
    ((IsLocalization.AtPrime.isUnit_to_map_iff A positiveIdeal b).mp hbunit)) hbmem

private lemma basicOpen_roundtrip (R : CommRingCat) (r : Γ(Spec R, ⊤))
    (h : (Spec R).basicOpen r = ⊤) :
    (Spec R).topIso.inv ≫ ((Spec R).isoOfEq h.symm).hom ≫
      ((Spec R).isoOfEq ((Spec R).toSpecΓ_preimage_basicOpen r)).inv ≫
      ((Spec R).toSpecΓ ∣_ PrimeSpectrum.basicOpen r) ≫
      (basicOpenIsoSpecAway r).hom ≫
      Spec.map ((Scheme.ΓSpecIso R).inv ≫
        (ConcreteCategory.ofHom (C := CommRingCat)
          (algebraMap (Γ(Spec R, ⊤)) (Localization.Away r)))) =
      𝟙 (Spec R) := by
  simp only [Scheme.isoOfEq_hom, Scheme.isoOfEq_inv, Spec.map_comp,
    basicOpenIsoSpecAway_hom_SpecMap_assoc, Scheme.homOfLE_homOfLE_assoc]
  have hrestrict := morphismRestrict_ι (Spec R).toSpecΓ (PrimeSpectrum.basicOpen r)
  rw [← Category.assoc ((Spec R).toSpecΓ ∣_ PrimeSpectrum.basicOpen r) _
    (Spec.map (Scheme.ΓSpecIso R).inv)]
  rw [hrestrict]
  simp only [← Category.assoc, Scheme.homOfLE_ι,
    ← Scheme.topIso_hom, Iso.inv_hom_id, Category.id_comp,
    toSpecΓ_SpecMap_ΓSpecIso_inv]

private lemma exponent_succ_lt (i : ℕ) : exponent (i + 1) < exponent i := by
  unfold exponent
  apply one_div_lt_one_div_of_lt
  · positivity
  · exact_mod_cast (show i + 1 < i + 1 + 1 by omega)

private lemma preimage_eq_lift_of_comp_eq_id (R : CommRingCat) (r : Γ(Spec R, ⊤))
    (hr : IsUnit ((Scheme.ΓSpecIso R).hom.hom r))
    (P : Spec R ⟶ Spec (CommRingCat.of (Localization.Away r)))
    (hP : P ≫ Spec.map ((Scheme.ΓSpecIso R).inv ≫
      (ConcreteCategory.ofHom (C := CommRingCat)
        (algebraMap (Γ(Spec R, ⊤)) (Localization.Away r)))) = 𝟙 _) :
    ((Spec.preimage P).hom : Localization.Away r →+* R) =
      IsLocalization.Away.lift (S := Localization.Away r) r hr := by
  have h := congrArg Spec.preimage hP
  rw [Spec.preimage_comp, Spec.preimage_map, Spec.preimage_id, Category.assoc,
    ← (Scheme.ΓSpecIso R).inv_hom_id, cancel_epi] at h
  apply IsLocalization.ringHom_ext (M := .powers r)
  rw [IsLocalization.Away.lift_comp]
  exact congrArg CommRingCat.Hom.hom h

section Chart

attribute [local instance] positiveIdeal_isPrime MvPolynomial.gradedAlgebra

local notation "𝒮" => MvPolynomial.homogeneousSubmodule ℕ ℂ
local notation "𝔸" => Localization positiveIdeal.primeCompl
local notation "𝕂" => FractionRing 𝔸
local notation "𝕏" => Spec (CommRingCat.of 𝕂)

private abbrev fractionMap : polynomialAlgebra →+* 𝕂 :=
  (algebraMap fractionalExponentAlgebra 𝕂).comp polynomialMap.toRingHom

private abbrev sectionMap : polynomialAlgebra →+* Γ(𝕏, ⊤) :=
  (Scheme.ΓSpecIso (CommRingCat.of 𝕂)).inv.hom.comp fractionMap

private lemma X_mem_one (i : ℕ) : (MvPolynomial.X i : polynomialAlgebra) ∈ 𝒮 1 := by
  rw [MvPolynomial.homogeneousSubmodule_one_eq_span_X]
  exact Submodule.subset_span ⟨i, rfl⟩

private lemma fractionMap_X_ne_zero (i : ℕ) : fractionMap (MvPolynomial.X i) ≠ 0 := by
  change algebraMap fractionalExponentAlgebra 𝕂 (polynomialMap (MvPolynomial.X i)) ≠ 0
  simpa using (target_algebraMap_fraction_injective positiveIdeal_isPrime).ne
    (show polynomialMap (MvPolynomial.X i) ≠ 0 by simp [polynomialMap, exponent])

private lemma sectionMap_X_isUnit (i : ℕ) : IsUnit (sectionMap (MvPolynomial.X i)) :=
  IsUnit.map (Scheme.ΓSpecIso (CommRingCat.of 𝕂)).inv.hom
    (isUnit_iff_ne_zero.mpr (fractionMap_X_ne_zero i))

private lemma irrelevant_map_sectionMap_eq_top :
    (HomogeneousIdeal.irrelevant 𝒮).toIdeal.map sectionMap = ⊤ :=
  Ideal.eq_top_of_isUnit_mem _
    (Ideal.mem_map_of_mem _ (HomogeneousIdeal.mem_irrelevant_of_mem _ (by norm_num) (X_mem_one 0)))
    (sectionMap_X_isUnit 0)

private abbrev genericMap : 𝕏 ⟶ Proj 𝒮 :=
  Proj.fromOfGlobalSections 𝒮 sectionMap irrelevant_map_sectionMap_eq_top

private lemma lift_genericMap_eq (i : ℕ)
    (h : Set.range genericMap ⊆ (Proj.basicOpen 𝒮 (MvPolynomial.X i)).ι.opensRange) :
    IsOpenImmersion.lift _ genericMap h = (𝕏).topIso.inv ≫
      ((𝕏).isoOfEq (Scheme.basicOpen_of_isUnit 𝕏 (sectionMap_X_isUnit i)).symm).hom ≫
        Proj.toBasicOpenOfGlobalSections (X := 𝕏) 𝒮 sectionMap rfl (by norm_num)
          (MvPolynomial.isHomogeneous_X ℂ i) := by
  refine (IsOpenImmersion.lift_uniq _ _ h _ ?_).symm
  rw [← Proj.fromOfGlobalSections_resLE 𝒮 sectionMap irrelevant_map_sectionMap_eq_top
    (by norm_num) (MvPolynomial.isHomogeneous_X ℂ i)]
  simp only [Category.assoc, Scheme.Hom.resLE_comp_ι]
  simp

private lemma preimage_chart_eq (i : ℕ)
    (h : Set.range genericMap ⊆ (Proj.basicOpen 𝒮 (MvPolynomial.X i)).ι.opensRange) :
    (Spec.preimage (IsOpenImmersion.lift _ genericMap h ≫
      (Proj.basicOpenIsoSpec 𝒮 (MvPolynomial.X i) (MvPolynomial.isHomogeneous_X ℂ i)
        (by norm_num)).hom)).hom =
      (IsLocalization.Away.lift (S := Localization.Away (MvPolynomial.X i : polynomialAlgebra))
        (MvPolynomial.X i)
        (g := fractionMap) (isUnit_iff_ne_zero.mpr (fractionMap_X_ne_zero i))).comp
        (algebraMap (HomogeneousLocalization.Away 𝒮 (MvPolynomial.X i))
          (Localization.Away (MvPolynomial.X i : polynomialAlgebra))) := by
  have hV := Scheme.basicOpen_of_isUnit 𝕏 (sectionMap_X_isUnit i)
  have hEF : (Scheme.ΓSpecIso (CommRingCat.of 𝕂)).hom.hom.comp sectionMap = fractionMap :=
    RingHom.ext fun z => congrArg (fun f : CommRingCat.of 𝕂 ⟶ CommRingCat.of 𝕂 =>
      f.hom (fractionMap z)) (Scheme.ΓSpecIso (CommRingCat.of 𝕂)).inv_hom_id
  have hu : IsUnit ((Scheme.ΓSpecIso (CommRingCat.of 𝕂)).hom.hom
      (sectionMap (MvPolynomial.X i))) := by
    rw [← RingHom.comp_apply, hEF]
    exact isUnit_iff_ne_zero.mpr (fractionMap_X_ne_zero i)
  have hmap : Submonoid.powers (MvPolynomial.X i) ≤
      Submonoid.comap sectionMap (Submonoid.powers (sectionMap (MvPolynomial.X i))) := by
    rintro z ⟨n, rfl⟩
    exact ⟨n, by simp⟩
  let P : 𝕏 ⟶ Spec (CommRingCat.of (Localization.Away (sectionMap (MvPolynomial.X i)))) :=
    (𝕏).topIso.inv ≫ ((𝕏).isoOfEq hV.symm).hom ≫
      ((𝕏).isoOfEq ((𝕏).toSpecΓ_preimage_basicOpen (sectionMap (MvPolynomial.X i)))).inv ≫
        ((𝕏).toSpecΓ ∣_ PrimeSpectrum.basicOpen (sectionMap (MvPolynomial.X i))) ≫
          (basicOpenIsoSpecAway (sectionMap (MvPolynomial.X i))).hom
  let chartRingMap : HomogeneousLocalization.Away 𝒮 (MvPolynomial.X i) →+*
      Localization.Away (sectionMap (MvPolynomial.X i)) :=
    (IsLocalization.map (M := .powers (MvPolynomial.X i : polynomialAlgebra))
      (T := .powers (sectionMap (MvPolynomial.X i))) _ sectionMap hmap).comp
        (algebraMap (HomogeneousLocalization.Away 𝒮 (MvPolynomial.X i))
          (Localization.Away (MvPolynomial.X i : polynomialAlgebra)))
  have hfactor : IsOpenImmersion.lift _ genericMap h ≫
      (Proj.basicOpenIsoSpec 𝒮 (MvPolynomial.X i) (MvPolynomial.isHomogeneous_X ℂ i)
        (by norm_num)).hom = P ≫ Spec.map (CommRingCat.ofHom chartRingMap) := by
    rw [lift_genericMap_eq]
    dsimp [P, chartRingMap, Proj.toBasicOpenOfGlobalSections]
    simp only [Scheme.isoOfEq_hom, Scheme.isoOfEq_inv, Category.assoc,
      Iso.inv_hom_id, Category.comp_id]
  rw [hfactor, Spec.preimage_comp, Spec.preimage_map]
  change (Spec.preimage P).hom.comp chartRingMap = _
  rw [preimage_eq_lift_of_comp_eq_id _ _ hu P (basicOpen_roundtrip _ _ hV)]
  dsimp only [chartRingMap]
  rw [← RingHom.comp_assoc]
  congr 1
  apply IsLocalization.ringHom_ext (M := .powers (MvPolynomial.X i : polynomialAlgebra))
  rw [RingHom.comp_assoc, IsLocalization.map_comp, ← RingHom.comp_assoc,
    IsLocalization.Away.lift_comp, IsLocalization.Away.lift_comp]
  exact hEF

private lemma awayLift_ratio (i : ℕ) :
    ((IsLocalization.Away.lift (S := Localization.Away (MvPolynomial.X i : polynomialAlgebra))
        (MvPolynomial.X i)
        (g := fractionMap) (isUnit_iff_ne_zero.mpr (fractionMap_X_ne_zero i))).comp
        (algebraMap (HomogeneousLocalization.Away 𝒮 (MvPolynomial.X i))
          (Localization.Away (MvPolynomial.X i : polynomialAlgebra))))
      (HomogeneousLocalization.Away.isLocalizationElem (X_mem_one i) (X_mem_one (i + 1))) =
      fractionMap (MvPolynomial.X (i + 1)) / fractionMap (MvPolynomial.X i) := by
  simp only [RingHom.coe_comp, Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
    HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk]
  rw [Localization.awayLift_mk fractionMap (MvPolynomial.X i) (MvPolynomial.X (i + 1) ^ 1)
    (fractionMap (MvPolynomial.X i))⁻¹ (mul_inv_cancel₀ (fractionMap_X_ne_zero i)) 1]
  simp [div_eq_mul_inv]

private lemma exists_ratio_of_extension (g : Spec (CommRingCat.of 𝔸) ⟶ Proj 𝒮)
    (hg : Spec.map (CommRingCat.ofHom (algebraMap 𝔸 𝕂)) ≫ g = genericMap) (i : ℕ)
    (hi : g (IsLocalRing.closedPoint 𝔸) ∈ Proj.basicOpen 𝒮 (MvPolynomial.X i)) :
    ∃ a : 𝔸, algebraMap 𝔸 𝕂 a =
      fractionMap (MvPolynomial.X (i + 1)) / fractionMap (MvPolynomial.X i) := by
  have hgRange : Set.range g ⊆ (Proj.basicOpen 𝒮 (MvPolynomial.X i)).ι.opensRange := by
    rw [Scheme.Opens.opensRange_ι]
    rintro _ ⟨y, rfl⟩
    have hy : y ∈ g ⁻¹ᵁ Proj.basicOpen 𝒮 (MvPolynomial.X i) := by
      rw [Scheme.preimage_eq_top_of_closedPoint_mem g hi]
      trivial
    exact hy
  have hψRange : Set.range genericMap ⊆ (Proj.basicOpen 𝒮 (MvPolynomial.X i)).ι.opensRange := by
    rintro _ ⟨y, rfl⟩
    change genericMap y ∈ (Proj.basicOpen 𝒮 (MvPolynomial.X i)).ι.opensRange
    rw [← hg]
    exact hgRange ⟨_, rfl⟩
  have hchart : Spec.map (CommRingCat.ofHom (algebraMap 𝔸 𝕂)) ≫
      IsOpenImmersion.lift _ g hgRange = IsOpenImmersion.lift _ genericMap hψRange :=
    IsOpenImmersion.lift_uniq _ _ hψRange _ ((Category.assoc _ _ _).trans
      ((congrArg (fun f => Spec.map (CommRingCat.ofHom (algebraMap 𝔸 𝕂)) ≫ f)
        (IsOpenImmersion.lift_fac _ g hgRange)).trans hg))
  have hring := congrArg (fun f => (Spec.preimage (f ≫ (Proj.basicOpenIsoSpec 𝒮
    (MvPolynomial.X i) (MvPolynomial.isHomogeneous_X ℂ i) (by norm_num)).hom)).hom
      (HomogeneousLocalization.Away.isLocalizationElem (X_mem_one i) (X_mem_one (i + 1)))) hchart
  simp only [Category.assoc, Spec.preimage_comp, Spec.preimage_map, preimage_chart_eq,
    CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at hring
  exact ⟨_, hring.trans (awayLift_ratio i)⟩

/-- The specified valuative example: the canonical generic-fibre morphism induced by
`polynomialMap` cannot be extended to the spectrum of the local valuation ring. -/
@[stacks 01MG]
theorem exists_nonextendable_valuative_map :
    ∃ hm : positiveIdeal.IsPrime,
      letI : positiveIdeal.IsPrime := hm
      letI : GradedRing (MvPolynomial.homogeneousSubmodule ℕ ℂ) :=
        MvPolynomial.gradedAlgebra
      let A := Localization positiveIdeal.primeCompl
      let K := FractionRing A
      let φ : polynomialAlgebra →+* K :=
        (algebraMap fractionalExponentAlgebra K).comp polynomialMap.toRingHom
      let F : polynomialAlgebra →+* Γ(Spec (CommRingCat.of K), ⊤) :=
        (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom.comp φ
      (IsValuationRing A) ∧
        ∃ hf : (HomogeneousIdeal.irrelevant
            (MvPolynomial.homogeneousSubmodule ℕ ℂ)).toIdeal.map F = ⊤,
          ¬ ∃ g : Spec (CommRingCat.of A) ⟶
              Proj (MvPolynomial.homogeneousSubmodule ℕ ℂ),
            Spec.map (CommRingCat.ofHom (algebraMap A K)) ≫ g =
              Proj.fromOfGlobalSections
                (MvPolynomial.homogeneousSubmodule ℕ ℂ) F hf := by
  refine ⟨positiveIdeal_isPrime, localization_isValuationRing positiveIdeal_isPrime,
    irrelevant_map_sectionMap_eq_top, ?_⟩
  rintro ⟨g, hg⟩
  have hclosed : g (IsLocalRing.closedPoint 𝔸) ∈ ⨆ i : ℕ, Proj.basicOpen 𝒮 (MvPolynomial.X i) := by
    rw [projective_variables_cover]
    trivial
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hclosed
  obtain ⟨a, ha⟩ := exists_ratio_of_extension g hg i hi
  exact not_exists_monomial_ratio positiveIdeal_isPrime (exponent i) (exponent (i + 1))
    (exponent_succ_lt i) ⟨a, by simpa [fractionMap, polynomialMap] using
      (eq_div_iff (fractionMap_X_ne_zero i)).mp ha⟩

end Chart

