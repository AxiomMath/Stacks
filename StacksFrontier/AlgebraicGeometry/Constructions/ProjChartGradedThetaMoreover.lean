section Coherence

open MonoidalCategory
open Stacks.GradedSections (natPowerSystem powCongr)
open Stacks.Monoidal (PowerSystem)
open Stacks.AlgebraicGeometry.ProjVeroneseRestrict (powVeroneseIso powVeroneseIso_succ
  powVeroneseIso_zero_inv)

/-- The comparison `(M ^⊗ d) ^⊗ 1 ≅ M ^⊗ (d * 1)` followed by the transport `d * 1 = d` is the
left unitor of `M ^⊗ d`. -/
theorem powVeroneseIso_one_hom_powCongr {Y : Scheme.{u}} (M : Y.Modules) (d : ℕ) :
    (powVeroneseIso M d 1).hom ≫ powCongr M (Nat.mul_one d) = (λ_ (natTensorPow M d)).hom := by
  have h0 : (powVeroneseIso M d 0).hom = 𝟙 _ := by
    have h := (powVeroneseIso M d 0).hom_inv_id
    rw [powVeroneseIso_zero_inv] at h
    exact (Category.comp_id _).symm.trans h
  have h1 : (powVeroneseIso M d 1).hom = ((natPowerSystem M).mulIso 0 d).hom := by
    have key := congrArg Iso.hom (powVeroneseIso_succ M d 0)
    simp only [Iso.trans_hom, tensorIso_hom, Iso.refl_hom] at key
    refine key.trans ?_
    refine Eq.trans (congrArg (· ≫ ((natPowerSystem M).mulIso (d * 0) d).hom)
      (congrArg (· ⊗ₘ 𝟙 (natTensorPow M d)) h0)) ?_
    exact (congrArg (· ≫ ((natPowerSystem M).mulIso (d * 0) d).hom)
      (MonoidalCategory.id_tensorHom_id _ _)).trans (Category.id_comp _)
  have hz := PowerSystem.mulIso_zeroLeft (natPowerSystem M) d
  have hA : (natPowerSystem M).objZeroIso.hom ▷ (natPowerSystem M).obj d = 𝟙 _ := by
    rw [Stacks.GradedSections.natPowerSystem_objZeroIso, Iso.refl_hom]
    exact MonoidalCategory.id_whiskerRight _ _
  have he : eqToHom (congrArg (natPowerSystem M).obj (Nat.zero_add d).symm)
      ≫ powCongr M (Nat.mul_one d) = 𝟙 ((natPowerSystem M).obj d) :=
    (eqToHom_trans (congrArg (natPowerSystem M).obj (Nat.zero_add d).symm)
      (congrArg (natTensorPow M) (Nat.mul_one d) :
        (natPowerSystem M).obj (0 + d) = natTensorPow M d)).trans (eqToHom_refl _ _)
  refine (congrArg (· ≫ powCongr M (Nat.mul_one d)) (h1.trans hz)).trans ?_
  refine (Category.assoc _ _ _).trans ?_
  refine (congrArg (fun t => (natPowerSystem M).objZeroIso.hom ▷ (natPowerSystem M).obj d ≫ t)
    (Category.assoc _ _ _)).trans ?_
  refine (congrArg (fun t => (natPowerSystem M).objZeroIso.hom ▷ (natPowerSystem M).obj d ≫
    (λ_ ((natPowerSystem M).obj d)).hom ≫ t) he).trans ?_
  refine (congrArg (fun t => t ≫ (λ_ ((natPowerSystem M).obj d)).hom ≫ 𝟙 _) hA).trans ?_
  exact (Category.id_comp _).trans (Category.comp_id _)

end Coherence

section VeronesePsi

open Stacks.GradedSections (powCongr)
open Stacks.AlgebraicGeometry.ProjVeroneseRestrict (powVeroneseIso hom_app_inv_app)
open Stacks.AlgebraicGeometry.ProjChartGradedVeronese (veroneseAt_pow powCongr_app_toFun)

variable {σ : Type w} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] {Y : Scheme.{u}} {M : Y.Modules}
  [Stacks.Ample.IsInvertibleModule Y M]

omit [Stacks.Ample.IsInvertibleModule Y M] in
/-- **The section `ψ(g)` of [Stacks, Tag 01N8] for the Veronese restriction of a graded map `φ`
is `φ(g)`.** -/
theorem psiSection_veroneseAt (φ : GradedSections 𝒜 M) {d : ℕ} (g : 𝒜 d) :
    psiSection 𝒜 (veroneseAt 𝒜 φ d) g = φ.toFun d g := by
  have hfn : ((g : A)) ^ 1 ∈ 𝒜 (d * 1) := by
    rw [pow_one, Nat.mul_one]; exact g.2
  have hfd : ((g : A)) ^ 1 ∈ 𝒜 d := by rw [pow_one]; exact g.2
  have hlam := congrArg (fun t => t.app ⊤ ((powVeroneseIso M d 1).inv.app ⊤
      (φ.toFun (d * 1) ⟨(g : A) ^ 1, hfn⟩))) (powVeroneseIso_one_hom_powCongr M d)
  simp only [Scheme.Modules.Hom.comp_app, CategoryTheory.comp_apply] at hlam
  refine (congrArg (fun z => (unitorPow (natTensorPow M d)).hom.app ⊤ z)
    (veroneseAt_pow 𝒜 φ g.2 1 hfn)).trans ?_
  refine hlam.symm.trans ?_
  refine (congrArg (fun z => (powCongr M (Nat.mul_one d)).app ⊤ z)
    (hom_app_inv_app (powVeroneseIso M d 1) _)).trans ?_
  exact (powCongr_app_toFun 𝒜 φ (Nat.mul_one d) _ hfn hfd).trans
    (congrArg (φ.toFun d) (Subtype.ext (pow_one _)))

end VeronesePsi

section Glued

open Stacks.AlgebraicGeometry.ProjChartFromRatios (VeroneseSections)

variable {σ : Type w} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] {Y : Scheme.{u}} {M : Y.Modules}
  [Stacks.Ample.IsInvertibleModule Y M]

/-- The glued chart morphism of [Stacks, Tag 01N8] depends on the covering family only through the
family itself. -/
theorem glued_congr {d : ℕ} (ψ : VeroneseSections 𝒜 d M) (hd : 0 < d) {W W' : 𝒜 d → Y.Opens}
    (h : W = W')
    (hWle : ∀ g : 𝒜 d, W g ≤ nonvanishingOpen Y (natTensorPow M 1) (ψ.pow g.2 1))
    (hcover : ⨆ g : 𝒜 d, W g = ⊤)
    (hWle' : ∀ g : 𝒜 d, W' g ≤ nonvanishingOpen Y (natTensorPow M 1) (ψ.pow g.2 1))
    (hcover' : ⨆ g : 𝒜 d, W' g = ⊤) :
    Stacks.AlgebraicGeometry.ProjChartCocycle.glued 𝒜 ψ hd hWle hcover
      = Stacks.AlgebraicGeometry.ProjChartCocycle.glued 𝒜 ψ hd hWle' hcover' := by
  subst h
  rfl

end Glued

section Steps

/-! ### Global sections followed through the structural isomorphisms of the inverse image -/

variable {X Y Z : Scheme.{u}}

/-- Evaluating a composite on a global section, one factor at a time. -/
theorem comp_app_top_apply {M N K : X.Modules} (f : M ⟶ N) (g : N ⟶ K) (x : Γ(M, ⊤))
    (y : Γ(N, ⊤)) (h : f.app ⊤ x = y) : (f ≫ g).app ⊤ x = g.app ⊤ y := by
  rw [← h]
  rfl

/-- The identification of the inverse images along two equal morphisms carries a pulled-back
global section to the pulled-back global section. -/
theorem pullbackCongr_hom_app_top {f g : X ⟶ Y} (h : f = g) (M : Y.Modules) (a : Γ(M, ⊤))
    (hf : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤) (hg : (⊤ : X.Opens) ≤ g ⁻¹ᵁ ⊤) :
    ((Scheme.Modules.pullbackCongr h).hom.app M).app ⊤
        (Scheme.Modules.pullbackSection f M ⊤ ⊤ hf a)
      = Scheme.Modules.pullbackSection g M ⊤ ⊤ hg a :=
  Scheme.Modules.pullbackSection_congr h M ⊤ ⊤ hf hg a

/-- A global section pulled back twice is the global section pulled back along the composite. -/
theorem pullbackComp_hom_app_top (f : X ⟶ Y) (g : Y ⟶ Z) (M : Z.Modules) (a : Γ(M, ⊤))
    (h₁ : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤) (h₂ : (⊤ : Y.Opens) ≤ g ⁻¹ᵁ ⊤)
    (h : (⊤ : X.Opens) ≤ (f ≫ g) ⁻¹ᵁ ⊤) :
    ((Scheme.Modules.pullbackComp f g).hom.app M).app ⊤
        (Scheme.Modules.pullbackSection f ((Scheme.Modules.pullback g).obj M) ⊤ ⊤ h₁
          (Scheme.Modules.pullbackSection g M ⊤ ⊤ h₂ a))
      = Scheme.Modules.pullbackSection (f ≫ g) M ⊤ ⊤ h a :=
  Scheme.Modules.pullbackSection_comp f g M ⊤ ⊤ ⊤ h₂ h₁ h a

/-- A global section pulled back along a composite is the global section pulled back twice. -/
theorem pullbackComp_inv_app_top (f : X ⟶ Y) (g : Y ⟶ Z) (M : Z.Modules) (a : Γ(M, ⊤))
    (h₁ : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤) (h₂ : (⊤ : Y.Opens) ≤ g ⁻¹ᵁ ⊤)
    (h : (⊤ : X.Opens) ≤ (f ≫ g) ⁻¹ᵁ ⊤) :
    ((Scheme.Modules.pullbackComp f g).inv.app M).app ⊤
        (Scheme.Modules.pullbackSection (f ≫ g) M ⊤ ⊤ h a)
      = Scheme.Modules.pullbackSection f ((Scheme.Modules.pullback g).obj M) ⊤ ⊤ h₁
          (Scheme.Modules.pullbackSection g M ⊤ ⊤ h₂ a) :=
  (congrArg (fun z => ((Scheme.Modules.pullbackComp f g).inv.app M).app ⊤ z)
      (pullbackComp_hom_app_top f g M a h₁ h₂ h).symm).trans
    (congrArg (fun ρ : (Scheme.Modules.pullback g ⋙ Scheme.Modules.pullback f).obj M ⟶
        (Scheme.Modules.pullback g ⋙ Scheme.Modules.pullback f).obj M => ρ.app ⊤
          (Scheme.Modules.pullbackSection f ((Scheme.Modules.pullback g).obj M) ⊤ ⊤ h₁
            (Scheme.Modules.pullbackSection g M ⊤ ⊤ h₂ a)))
      (Iso.hom_inv_id_app (Scheme.Modules.pullbackComp f g) M))

/-- The inverse image of a morphism carries a pulled-back global section to the pulled-back image
of the section. -/
theorem pullback_map_app_top (f : X ⟶ Y) {M N : Y.Modules} (t : M ⟶ N) (a : Γ(M, ⊤))
    (h : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤) :
    ((Scheme.Modules.pullback f).map t).app ⊤ (Scheme.Modules.pullbackSection f M ⊤ ⊤ h a)
      = Scheme.Modules.pullbackSection f N ⊤ ⊤ h (t.app ⊤ a) :=
  Scheme.Modules.pullbackSection_naturality f t ⊤ ⊤ h a

/-- The inverse image of a morphism carries a pulled-back global section to the pulled-back
global section of any `b` equal to the image of the section. -/
private theorem pullback_map_app_top_of_eq (f : X ⟶ Y) {M N : Y.Modules} (t : M ⟶ N)
    {a : Γ(M, ⊤)} {b : Γ(N, ⊤)} (hab : t.app ⊤ a = b) (h : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤) :
    ((Scheme.Modules.pullback f).map t).app ⊤ (Scheme.Modules.pullbackSection f M ⊤ ⊤ h a)
      = Scheme.Modules.pullbackSection f N ⊤ ⊤ h b :=
  (pullback_map_app_top f t a h).trans (congrArg _ hab)

/-- Along an open immersion, the comparison of restriction with inverse image carries the
restriction of a global section to the pulled-back global section. -/
theorem restrictFunctorIsoPullback_hom_app_top (f : X ⟶ Y) [IsOpenImmersion f] (M : Y.Modules)
    (a : Γ(M, ⊤)) (h : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤) :
    ((Scheme.Modules.restrictFunctorIsoPullback f).hom.app M).app ⊤
        (Stacks.TensorPowerTrivialize.resTop M a (f ''ᵁ ⊤))
      = Scheme.Modules.pullbackSection f M ⊤ ⊤ h a :=
  (congrArg (fun z => ((Scheme.Modules.restrictFunctorIsoPullback f).hom.app M).app ⊤ z)
      (Scheme.Modules.restrictFunctorIsoPullback_inv_pullbackSection f M ⊤ ⊤ h le_top a).symm).trans
    (congrArg (fun ρ : (Scheme.Modules.pullback f).obj M ⟶ (Scheme.Modules.pullback f).obj M =>
        ρ.app ⊤ (Scheme.Modules.pullbackSection f M ⊤ ⊤ h a))
      (Iso.inv_hom_id_app (Scheme.Modules.restrictFunctorIsoPullback f) M))

end Steps

section Ext

open Stacks.AlgebraicGeometry.ProjChartFromRatios (VeroneseSections)
open Stacks.AlgebraicGeometry.ProjChartAlphaInstance (pullbackDegreeSection)
open Stacks.AlgebraicGeometry.ProjVeroneseRestrict (inv_app_hom_app)

variable {σ : Type w} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] {Y : Scheme.{u}} {M : Y.Modules}
  [Stacks.Ample.IsInvertibleModule Y M]

/-- **A morphism `φ⁎𝒪_X(d) ⟶ M` agreeing with the `α` of a compatible pair on the pulled-back
degree-`d` sections is that `α`.** The values `ψ(g)` generate `M`, `α` is an isomorphism carrying
the pullback of the section of `g` to `ψ(g)`, so `α⁻¹` followed by the morphism fixes each `ψ(g)`
and is the identity. -/
theorem eq_hom_of_app_pullbackDegreeSection {d : ℕ} (ψ : VeroneseSections 𝒜 d M)
    (hgen : ⨆ g : 𝒜 d, nonvanishingOpen Y M (psiSection 𝒜 ψ g) = ⊤)
    (p : Pair 𝒜 M d) (hp : IsCompatible 𝒜 ψ p) (Φ : pullbackTwist 𝒜 p.1 (d : ℤ) ⟶ M)
    (h : ∀ g : 𝒜 d, Φ.app ⊤ (pullbackDegreeSection 𝒜 p.1 g) = psiSection 𝒜 ψ g) :
    Φ = p.2.hom := by
  have hinv : ∀ g : 𝒜 d, p.2.inv.app ⊤ (psiSection 𝒜 ψ g) = pullbackDegreeSection 𝒜 p.1 g :=
    fun g => by
      rw [← Stacks.AlgebraicGeometry.MorphismToProjUniversal.app_top_pullbackDegreeSection 𝒜 hp g]
      exact inv_app_hom_app p.2 _
  have h1 : p.2.inv ≫ Φ = 𝟙 _ :=
    Stacks.AlgebraicGeometry.ProjSectionsUnique.hom_ext_of_iSup_nonvanishingOpen_eq_top
      (psiSection 𝒜 ψ) hgen fun g => by
        simp only [Scheme.Modules.Hom.comp_app, CategoryTheory.comp_apply,
          Scheme.Modules.Hom.id_app, CategoryTheory.id_apply]
        rw [hinv, h]
  calc Φ = p.2.hom ≫ p.2.inv ≫ Φ := by rw [Iso.hom_inv_id_assoc]
    _ = p.2.hom := by rw [h1, Category.comp_id]

end Ext

section Main

variable {σ : Type w} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] {T : Scheme.{u}} {L : T.Modules}
  [Stacks.Ample.IsInvertibleModule T L] (ψ : GradedSections 𝒜 L)

/-- **[Stacks, Tag 01NK], the final assertion.** Let `d ≥ 1` and let `V ⊆ T` be an open on which
the sections `ψ(A_d)` generate `L^{⊗ d}`, i.e. `V ≤ ⨆_{g ∈ A_d} T_{ψ(g)}`; write
`j : V ⟶ U(ψ)` for the inclusion. Then

1. the pair `(φ, α)` of [Stacks, Tag 01N8] for `ψ|_{A^{(d)}} : A^{(d)} → Γ_*(V, L^{⊗ d})` — the
   Veronese restriction of the inverse image of `ψ` to `V` — exists and is unique; and
2. for that pair, **`r_{L, ψ}|_V = φ`** as morphisms `V ⟶ Proj A`, and **`θ|_V = α`** in degree
   `d`: the inverse image along `j` of the degree-`d` component of
   `θ : r_{L, ψ}^*(⨁_n 𝒪_X(n)) ⟶ ⨁_n L^{⊗ n}|_{U(ψ)}`, with its source identified with
   `φ^*𝒪_X(d)` through `r_{L, ψ} ∘ j = φ` and its target with `(L|_V)^{⊗ d}` through the canonical
   comparisons, is the morphism `α : φ^*𝒪_X(d) ⟶ (L|_V)^{⊗ d}` of sheaves of modules on `V`.

The comparisons on the target are, in order: restriction to `U(ψ)` is inverse image along its
inclusion, inverse image along `j` and then along `U(ψ) ⟶ T` is inverse image along `V ⟶ T`, the
integer tensor power is the iterated one in nonnegative degree, and inverse image commutes with
the iterated tensor power. -/
theorem moreover {d : ℕ} (hd : 0 < d) {V : T.Opens}
    (hVgen : V ≤ ⨆ g : 𝒜 d, nonvanishingOpen T (natTensorPow L d) (ψ.toFun d g)) :
    (∃! p : Pair 𝒜 (natTensorPow ((Scheme.Modules.pullback V.ι).obj L) d) d,
        IsCompatible 𝒜 (veroneseAt 𝒜 (GradedSections.pullback V.ι ψ) d) p) ∧
    ∀ p : Pair 𝒜 (natTensorPow ((Scheme.Modules.pullback V.ι).obj L) d) d,
      IsCompatible 𝒜 (veroneseAt 𝒜 (GradedSections.pullback V.ι ψ) d) p →
      ∃ h : T.homOfLE (hVgen.trans (iSup_nonvanishingOpen_le_coveringOpen 𝒜 ψ hd)) ≫ ψ.glued
          = toProj 𝒜 p.1,
        (Scheme.Modules.pullbackCongr h.symm).hom.app (twistM 𝒜 (d : ℤ))
          ≫ (Scheme.Modules.pullbackComp
              (T.homOfLE (hVgen.trans (iSup_nonvanishingOpen_le_coveringOpen 𝒜 ψ hd)))
              ψ.glued).inv.app (twistM 𝒜 (d : ℤ))
          ≫ (Scheme.Modules.pullback
              (T.homOfLE (hVgen.trans (iSup_nonvanishingOpen_le_coveringOpen 𝒜 ψ hd)))).map
              ((theta 𝒜 ψ).app (d : ℤ))
          ≫ (Scheme.Modules.pullback
              (T.homOfLE (hVgen.trans (iSup_nonvanishingOpen_le_coveringOpen 𝒜 ψ hd)))).map
              ((Scheme.Modules.restrictFunctorIsoPullback ψ.coveringOpen.ι).hom.app
                (tensorPowerModule T L (d : ℤ)))
          ≫ (Scheme.Modules.pullbackComp
              (T.homOfLE (hVgen.trans (iSup_nonvanishingOpen_le_coveringOpen 𝒜 ψ hd)))
              ψ.coveringOpen.ι).hom.app (tensorPowerModule T L (d : ℤ))
          ≫ (Scheme.Modules.pullbackCongr (T.homOfLE_ι _)).hom.app
              (tensorPowerModule T L (d : ℤ))
          ≫ (Scheme.Modules.pullback V.ι).map (powCompare L d).inv
          ≫ (pullbackNatTensorPowIso V.ι L d).inv
          = p.2.hom := by
  set ψV := GradedSections.pullback V.ι ψ
  have htop :=
    Stacks.AlgebraicGeometry.ProjChartGradedVeroneseOpen.iSup_nonvanishingOpen_pullback_eq_top
      𝒜 ψ hVgen
  have hpsi : ∀ g : 𝒜 d, psiSection 𝒜 (veroneseAt 𝒜 ψV d) g = ψV.toFun d g :=
    fun g => psiSection_veroneseAt 𝒜 ψV g
  have hgen : ⨆ g : 𝒜 d, nonvanishingOpen V.toScheme
      (natTensorPow ((Scheme.Modules.pullback V.ι).obj L) d)
      (psiSection 𝒜 (veroneseAt 𝒜 ψV d) g) = ⊤ :=
    (iSup_congr fun g => by rw [hpsi g]).trans htop
  refine ⟨Stacks.AlgebraicGeometry.MorphismToProjUniversal.existsUnique_pair 𝒜 hd _ hgen,
    fun p hp => ?_⟩
  have hp1 : p.1 = gluedVeronese 𝒜 ψV hd htop :=
    (Stacks.AlgebraicGeometry.ProjTripleClassifying.eq_classifyingHom_of_isCompatible 𝒜 hd _
      hgen p hp).trans
      ((Stacks.AlgebraicGeometry.ProjChartGradedClassifying.classifyingHom_eq_glued 𝒜 hd _
        hgen).trans
        (glued_congr 𝒜 _ hd (funext fun g => by rw [hpsi g]) _ _ _ _))
  have ha : T.homOfLE (hVgen.trans (iSup_nonvanishingOpen_le_coveringOpen 𝒜 ψ hd)) ≫ ψ.glued
      = toProj 𝒜 p.1 :=
    (Stacks.AlgebraicGeometry.ProjChartGradedVeroneseOpen.homOfLE_glued_eq_gluedVeronese_pullback
      𝒜 ψ hd hVgen).trans (congrArg (toProj 𝒜) hp1.symm)
  refine ⟨ha, ?_⟩
  refine eq_hom_of_app_pullbackDegreeSection 𝒜 _ hgen p hp _ fun g => ?_
  rw [hpsi g]
  have e0 : Stacks.AlgebraicGeometry.ProjChartAlphaInstance.pullbackDegreeSection 𝒜 p.1 g
      = Scheme.Modules.pullbackSection (toProj 𝒜 p.1) (twistM 𝒜 (d : ℤ)) ⊤ ⊤
          (fun _ _ => trivial) (AlgebraicGeometry.ProjectiveSpectrum.Proj.degreeSection 𝒜 d g) :=
    rfl
  rw [e0]
  set j := T.homOfLE (hVgen.trans (iSup_nonvanishingOpen_le_coveringOpen 𝒜 ψ hd))
  have hθ := Stacks.AlgebraicGeometry.ProjChartGradedTriple.isClauseTwo_theta ψ d g.2
  refine (comp_app_top_apply _ _ _ _
    (pullbackCongr_hom_app_top ha.symm _ _ _ (fun _ _ => trivial))).trans ?_
  refine (comp_app_top_apply _ _ _ _
    (pullbackComp_inv_app_top _ _ _ _ (fun _ _ => trivial) (fun _ _ => trivial) _)).trans ?_
  refine (comp_app_top_apply _ _ _ _
    (pullback_map_app_top_of_eq j ((theta 𝒜 ψ).app (d : ℤ)) hθ (fun _ _ => trivial))).trans ?_
  refine (comp_app_top_apply _ _ _ _
    (pullback_map_app_top_of_eq j _
      (restrictFunctorIsoPullback_hom_app_top _ _ _ (fun _ _ => trivial))
      (fun _ _ => trivial))).trans ?_
  refine (comp_app_top_apply _ _ _ _
    (pullbackComp_hom_app_top j _ _ _ _ _ (fun _ _ => trivial))).trans ?_
  refine (comp_app_top_apply _ _ _ _
    (pullbackCongr_hom_app_top (T.homOfLE_ι _) _ _ _ (fun _ _ => trivial))).trans ?_
  refine (comp_app_top_apply _ _ _ _
    (pullback_map_app_top_of_eq _ _
      (Stacks.AlgebraicGeometry.ProjVeroneseRestrict.inv_app_hom_app (powCompare L d) _)
      (fun _ _ => trivial))).trans ?_
  rfl

end Main

