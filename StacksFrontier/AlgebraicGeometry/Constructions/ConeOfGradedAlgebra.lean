-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry

universe u

/-- The input datum of **Stacks Project, Tag 062Q**: a quasi-coherent graded `𝒪_S`-algebra whose
structure map `𝒪_S ⟶ 𝒜₀` is an isomorphism.

Graded algebras in this chapter are commutative and concentrated in nonnegative degrees, which
is what `mul_comm` and `negative_isZero` record. Quasi-coherence is asked of the sheaf of
commutative `𝒪_S`-algebras `𝒜` realizes, whose underlying `𝒪_S`-module is the direct sum
`⨁_{n ≥ 0} 𝒜_n` by `Stacks.RelativeSpec.coprodIsoUnderlyingModule`; so this is quasi-coherence
of `⨁_{n ≥ 0} 𝒜_n`, and `Stacks.RelativeSpec.isQuasicoherent_ungradedAlgebraSheaf` supplies it
from quasi-coherence of that coproduct. It is asked in this form, and not degreewise, because
the warning of Tag 01CL is exactly that degreewise quasi-coherence does not by itself give it.

Nothing asks that `𝒜` be generated by `𝒜₁` over `𝒪_S`. The source omits that hypothesis
deliberately, so as to agree with [EGA II, (8.3.1)]. -/
public structure GradedConeAlgebra (S : Scheme.{u}) where
  /-- The homogeneous pieces and their multiplication. -/
  grading : SheafOfModules.GradedAlgebra S.ringCatSheaf
  /-- Homogeneous multiplication is commutative. -/
  mul_comm (i j : ℤ) (U : (S.Opens)ᵒᵖ) (a : (grading.piece i).val.obj U)
      (b : (grading.piece j).val.obj U) :
    HEq ((grading.mul i j).app U a b) ((grading.mul j i).app U b a)
  /-- Negative homogeneous pieces vanish. -/
  negative_isZero (n : ℤ) (hn : n < 0) : IsZero (grading.piece n)
  /-- `𝒜` is quasi-coherent: the `𝒪_S`-module underlying the sheaf of algebras it realizes —
  which is the direct sum of the homogeneous pieces, by
  `Stacks.RelativeSpec.coprodIsoUnderlyingModule` — is quasi-coherent. -/
  isQuasicoherent : Stacks.RelativeSpec.AlgebraSheaf.IsQuasicoherent
    (Stacks.RelativeSpec.ungradedAlgebraSheaf S grading mul_comm)
  /-- The degree-zero piece is the structure sheaf of the base. -/
  degreeZero : grading.piece 0 ≅ SheafOfModules.unit S.ringCatSheaf
  /-- The degree-zero identification carries the algebra unit to `1`. -/
  degreeZero_one : Stacks.RelativeSpec.PieceZeroUnit degreeZero

namespace GradedConeAlgebra

variable {S : Scheme.{u}} (A : GradedConeAlgebra S)

/-- The quasi-coherent sheaf of commutative `𝒪_S`-algebras underlying a graded cone algebra: the
sheafification of the direct sum of its homogeneous pieces, with the structure map `r ↦ r • 1`. -/
public noncomputable def algebraSheaf : Stacks.RelativeSpec.AlgebraSheaf S :=
  Stacks.RelativeSpec.ungradedAlgebraSheaf S A.grading A.mul_comm

/-- The sheaf of algebras underlying a graded cone algebra is quasi-coherent. -/
public instance isQuasicoherent_algebraSheaf :
    Stacks.RelativeSpec.AlgebraSheaf.IsQuasicoherent A.algebraSheaf :=
  A.isQuasicoherent

/-- The base scheme together with the quasi-coherent algebra `𝒜`, as a relative-spectrum
situation. -/
public noncomputable def situation : Stacks.RelativeSpec.RelativeSpecSituation.{u} where
  base := S
  algebra := A.algebraSheaf

/-- The base of the relative-spectrum situation of `𝒜` is `S`. -/
@[simp]
public theorem situation_base : A.situation.base = S := rfl

/-- The algebra of the relative-spectrum situation of `𝒜` is `A.algebraSheaf`. -/
@[simp]
public theorem situation_algebra : A.situation.algebra = A.algebraSheaf := rfl

/-- The cone, or affine cone, associated to a quasi-coherent graded `𝒪_S`-algebra `𝒜` whose
degree-zero part is `𝒪_S`: the relative spectrum `C(𝒜) = Spec_S(𝒜)`. -/
@[stacks 062Q,
  ega "II 8.3.1" "affine cone C=Spec(S)",
  ega "II 8.6.1" "partial",
  sga "7 XV 2.1.1" "more general"]
public noncomputable def cone : Scheme.{u} :=
  (Stacks.RelativeSpec.gluedSpectrum A.situation).scheme

/-- The projection of the cone `C(𝒜)` to its base, the structure morphism of the relative
spectrum. -/
public noncomputable def projection : A.cone ⟶ S :=
  (Stacks.RelativeSpec.gluedSpectrum A.situation).toBase

/-- The projection of a cone is an affine morphism, the relative spectrum of a quasi-coherent
algebra being affine over its base. -/
public instance isAffineHom_projection : IsAffineHom A.projection :=
  Stacks.RelativeSpec.isAffineHom_toBase A.situation

/-- The `𝒪_S`-module underlying the direct image `π_* 𝒪_{C(𝒜)}` is the direct image of the
structure sheaf of the relative spectrum, read through
`Stacks.AffineAlgebraEquivalence.pushforwardAlgebra`. -/
public theorem underlyingModule_pushforwardAlgebra_projection :
    Stacks.RelativeSpec.AlgebraSheaf.underlyingModule
        (Stacks.AffineAlgebraEquivalence.pushforwardAlgebra A.projection) =
      Stacks.Morphisms.pushforwardStructureSheaf A.projection :=
  rfl

/-- **The direct image of the structure sheaf of the cone is the algebra it was built from.**
The `𝒪_S`-module underlying `π_* 𝒪_{C(𝒜)}` is the sheafification of the direct sum of the
homogeneous pieces of `𝒜`. -/
public noncomputable def directSumIsoPushforward :
    (PresheafOfModules.sheafification (𝟙 S.ringCatSheaf.obj)).obj
        (Stacks.directSum fun n : ℤ => (A.grading.piece n).val) ≅
      Stacks.Morphisms.pushforwardStructureSheaf A.projection :=
  Stacks.RelativeSpec.directSumIsoUnderlyingModule S A.grading A.mul_comm ≪≫
    (Stacks.RelativeSpec.AlgebraSheaf.underlyingModuleIso
      (Stacks.AffineAlgebraEquivalence.pushforwardAlgebraIso A.algebraSheaf)).symm

/-- The identification of the module underlying the algebra sheaf `𝒜` with the direct image
`π_* 𝒪_{C(𝒜)}`, read on presheaves of modules. -/
public noncomputable def pushforwardValIso :
    (Stacks.RelativeSpec.AlgebraSheaf.underlyingModule A.algebraSheaf).val ≅
      (Stacks.Morphisms.pushforwardStructureSheaf A.projection).val :=
  ((SheafOfModules.forget S.ringCatSheaf).mapIso
    (Stacks.RelativeSpec.AlgebraSheaf.underlyingModuleIso
      (Stacks.AffineAlgebraEquivalence.pushforwardAlgebraIso A.algebraSheaf))).symm

/-- The forward map of `pushforwardValIso`, read on underlying presheaves of abelian groups, is
an isomorphism. -/
public instance isIso_toPresheaf_map_pushforwardValIso_hom :
    IsIso ((PresheafOfModules.toPresheaf S.ringCatSheaf.obj).map A.pushforwardValIso.hom) :=
  inferInstanceAs
    (IsIso ((PresheafOfModules.toPresheaf S.ringCatSheaf.obj).mapIso A.pushforwardValIso).hom)

/-- The comparison morphism from the objectwise direct sum of the homogeneous pieces of `𝒜` to
the direct image `π_* 𝒪_{C(𝒜)}`, the morphism of which `directSumIsoPushforward` is the
sheafification. -/
public noncomputable def directSumToPushforward :
    Stacks.directSum (fun k : ℤ => (A.grading.piece k).val) ⟶
      (Stacks.Morphisms.pushforwardStructureSheaf A.projection).val :=
  Stacks.RelativeSpec.ungradedDirectSumHom S A.grading A.mul_comm ≫ A.pushforwardValIso.hom

/-- The inclusion of the homogeneous piece of degree `n` of `𝒜` into the direct image
`π_* 𝒪_{C(𝒜)}`. -/
public noncomputable def ι (n : ℤ) :
    A.grading.piece n ⟶ Stacks.Morphisms.pushforwardStructureSheaf A.projection :=
  ⟨Stacks.inclHom (fun k : ℤ => (A.grading.piece k).val) n ≫ A.directSumToPushforward⟩

/-- The finite-support sum of homogeneous local sections of `𝒜` inside `π_* 𝒪_{C(𝒜)}` is the
comparison morphism `directSumToPushforward` on sections. -/
public theorem pushforwardHomogeneousSum_eq (U : S.Opens) :
    pushforwardHomogeneousSum A.projection A.grading A.ι U =
      Stacks.homToAddMonoidHom (fun k : ℤ => (A.grading.piece k).val)
        A.directSumToPushforward (op U) := by
  refine DFinsupp.addHom_ext fun n x => ?_
  simp only [pushforwardHomogeneousSum, DFinsupp.sumAddHom_single]
  rfl

/-- **Every local section of `π_* 𝒪_{C(𝒜)}` is locally a finite sum of homogeneous sections of
`𝒜`.** The direct image is the sheafification of the objectwise direct sum of the homogeneous
pieces, so the comparison morphism between them is locally surjective. -/
public theorem decomposition_locally (U : S.Opens)
    (a : (Stacks.Morphisms.pushforwardStructureSheaf A.projection).val.obj (op U)) (x : S)
    (hx : x ∈ U) :
    ∃ (V : S.Opens) (hVU : V ≤ U), x ∈ V ∧
      ∃ s : Π₀ n : ℤ, (A.grading.piece n).val.obj (op V),
        pushforwardHomogeneousSum A.projection A.grading A.ι V s =
          (Stacks.Morphisms.pushforwardStructureSheaf A.projection).val.map
            (homOfLE hVU).op a := by
  obtain ⟨V, f, ⟨s, hs⟩, hxV⟩ :=
    (Stacks.GradedAlgebra.isLocallySurjective_toPresheaf_map_directSumHom
      A.grading.toPresheafGradedAlgebra
      (Stacks.RelativeSpec.AlgebraSheaf.structureMap A.algebraSheaf)
      (Stacks.RelativeSpec.ungradedRingUnit S A.grading A.mul_comm)
      (Stacks.RelativeSpec.structureHom_comp_ungradedRingUnit S A.grading A.mul_comm)
      (Stacks.RelativeSpec.isLocallySurjective_ungradedRingUnit S A.grading
        A.mul_comm)).imageSieve_mem
      (PresheafOfModules.Hom.app A.pushforwardValIso.inv (op U) a) x hx
  refine ⟨V, leOfHom f, hxV, s, ?_⟩
  have key : PresheafOfModules.Hom.app
        (Stacks.RelativeSpec.ungradedDirectSumHom S A.grading A.mul_comm) (op V) s =
      (Stacks.RelativeSpec.AlgebraSheaf.underlyingModule A.algebraSheaf).val.map
        (homOfLE (leOfHom f)).op
        (PresheafOfModules.Hom.app A.pushforwardValIso.inv (op U) a) := hs
  have hid : PresheafOfModules.Hom.app A.pushforwardValIso.hom (op U)
      (PresheafOfModules.Hom.app A.pushforwardValIso.inv (op U) a) = a :=
    CategoryTheory.congr_fun (congrArg (fun φ => PresheafOfModules.Hom.app φ (op U))
      A.pushforwardValIso.inv_hom_id) a
  rw [A.pushforwardHomogeneousSum_eq]
  change PresheafOfModules.Hom.app A.pushforwardValIso.hom (op V)
      (PresheafOfModules.Hom.app
        (Stacks.RelativeSpec.ungradedDirectSumHom S A.grading A.mul_comm) (op V) s) = _
  rw [key, PresheafOfModules.naturality_apply, hid]

end GradedConeAlgebra

end AlgebraicGeometry

end
