* [Stacks Project, Tag 01CV](https://stacks.math.columbia.edu/tag/01CV)
-/

@[expose] public noncomputable section

open CategoryTheory MonoidalCategory
open AlgebraicGeometry
open TopologicalSpace
open Stacks.AlgebraicGeometry.MorphismToProjUniversal (psiSection unitorPow)
open Stacks.AlgebraicGeometry.ProjChartFromRatios
open Stacks.GradedSections (natPowerSystem powCongr)
open Stacks.Monoidal (PowerSystem)
open Stacks.NonvanishingOpen (nonvanishingOpen)
open Stacks.TensorPowers (natTensorPow)

universe u w

namespace Stacks.AlgebraicGeometry.ProjVeroneseRestrict

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory

variable {Y : Scheme.{u}}

/-! ### The comparison of the two presentations of the tensor powers of `L^{⊗ k}` -/

/-- **The comparison `(L^{⊗ k}) ^⊗ m ≅ L ^⊗ (km)`.** The iterated tensor powers of `L ^⊗ k` and
the Veronese presentation `m ↦ L ^⊗ (km)` are two power systems on the generator `L ^⊗ k`, and
this is the generic comparison of two power systems along the identity of their generators. -/
def powVeroneseIso (L : Y.Modules) (k m : ℕ) :
    natTensorPow (natTensorPow L k) m ≅ natTensorPow L (k * m) :=
  PowerSystem.compare (natPowerSystem (natTensorPow L k))
    ((natPowerSystem L).veronese k) (Iso.refl _) m

/-- The product of two global sections of a Veronese system is their product in the underlying
system, transported along `k p + k q = k (p + q)`. -/
theorem veronese_sectionMul (L : Y.Modules) (k p q : ℕ)
    (u : 𝟙_ Y.Modules ⟶ natTensorPow L (k * p)) (v : 𝟙_ Y.Modules ⟶ natTensorPow L (k * q)) :
    ((natPowerSystem L).veronese k).sectionMul (a := p) (b := q) u v
      = (natPowerSystem L).sectionMul (a := k * p) (b := k * q) u v ≫
          powCongr L (Nat.mul_add k p q).symm := by
  rw [PowerSystem.sectionMul, PowerSystem.sectionMul,
    PowerSystem.veronese_mulIso (natPowerSystem L) k p q]
  simp [powCongr]

/-- The product of two global sections of tensor powers, read as a morphism out of the monoidal
unit. -/
theorem mulSections_eq_globalSection (M : Y.Modules) {n m : ℕ} (x : Γ(natTensorPow M n, ⊤))
    (y : Γ(natTensorPow M m, ⊤)) :
    mulSections M x y
      = Stacks.SectionProduct.globalSection Y _
          (Stacks.GradedSections.mul (secOf M x) (secOf M y)) := by
  rw [← mulSections_globalSection M (secOf M x) (secOf M y), globalSection_secOf,
    globalSection_secOf]

/-- Reading the image of a global section under a morphism as a morphism out of the monoidal
unit postcomposes with that morphism. -/
theorem secOf_app (M N : Y.Modules) {n m : ℕ} (g : natTensorPow M n ⟶ natTensorPow N m)
    (x : Γ(natTensorPow M n, ⊤)) :
    secOf N (g.app ⊤ x) = secOf M x ≫ g := by
  have h : g.app ⊤ x = Stacks.SectionProduct.globalSection Y _ (secOf M x ≫ g) := by
    rw [Stacks.SectionProduct.globalSection_comp, globalSection_secOf]
  rw [h, secOf_globalSection]

/-- **The comparison `(L^{⊗ k}) ^⊗ m ≅ L ^⊗ (km)` is multiplicative** for the product of global
sections of tensor powers: it carries the product of a section of `(L^{⊗ k}) ^⊗ p` with one of
`(L^{⊗ k}) ^⊗ q` to the product of their images, transported along `kp + kq = k(p + q)`.

This is `Stacks.Monoidal.PowerSystem.compare_sectionMul` for the two power systems of
`powVeroneseIso`, read on honest sections. -/
theorem mulSections_powVeroneseIso (L : Y.Modules) (k p q : ℕ)
    (s : Γ(natTensorPow (natTensorPow L k) p, ⊤))
    (t : Γ(natTensorPow (natTensorPow L k) q, ⊤)) :
    (powVeroneseIso L k (p + q)).hom.app ⊤ (mulSections (natTensorPow L k) s t)
      = (powCongr L (Nat.mul_add k p q).symm).app ⊤
          (mulSections L ((powVeroneseIso L k p).hom.app ⊤ s)
            ((powVeroneseIso L k q).hom.app ⊤ t)) := by
  have key := PowerSystem.compare_sectionMul (natPowerSystem (natTensorPow L k))
    ((natPowerSystem L).veronese k) (Iso.refl _) (secOf (natTensorPow L k) s)
    (secOf (natTensorPow L k) t)
  rw [veronese_sectionMul L k p q, ← Stacks.GradedSections.mul_eq_sectionMul,
    ← Stacks.GradedSections.mul_eq_sectionMul] at key
  rw [mulSections_eq_globalSection, mulSections_eq_globalSection L, secOf_app, secOf_app]
  exact congrArg (Stacks.SectionProduct.globalSection Y (natTensorPow L (k * (p + q))))
    key.symm

/-! ### The restricted graded map -/

variable {σ : Type w} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- Transport of a homogeneous component along an equality of degrees. The two subgroups are
equal, so this is the identity on underlying elements. -/
def gradedCast {n n' : ℕ} (e : n = n') : 𝒜 n →+ 𝒜 n' where
  toFun x := ⟨(x : A), e ▸ x.2⟩
  map_zero' := rfl
  map_add' _ _ := rfl

omit [CommRing A] [AddSubgroupClass σ A] [GradedRing 𝒜] in
/-- Membership in a homogeneous component transports along an equality of degrees. -/
theorem mem_graded_of_eq {n n' : ℕ} (e : n = n') {x : A} (h : x ∈ 𝒜 n) : x ∈ 𝒜 n' := e ▸ h

variable {d : ℕ} {L : Y.Modules}

/-- A morphism of `𝒪_Y`-modules, as an additive map on global sections. -/
def appTopHom {M N : Y.Modules} (g : M ⟶ N) : Γ(M, ⊤) →+ Γ(N, ⊤) :=
  AddMonoidHom.mk' (fun x => g.app ⊤ x) fun x y => map_add _ x y

/-- The additive map `appTopHom g` sends a global section `x` to `g.app ⊤ x`. -/
@[simp] theorem appTopHom_apply {M N : Y.Modules} (g : M ⟶ N) (x : Γ(M, ⊤)) :
    appTopHom g x = g.app ⊤ x := rfl

/-- For an isomorphism `e` of `𝒪_Y`-modules, `e.inv` undoes `e.hom` on global sections. -/
theorem inv_app_hom_app {M N : Y.Modules} (e : M ≅ N) (z : Γ(M, ⊤)) :
    e.inv.app ⊤ (e.hom.app ⊤ z) = z := by
  have h := congrArg (fun φ : M ⟶ M => φ.app ⊤ z) e.hom_inv_id
  simp only [Scheme.Modules.Hom.comp_app, CategoryTheory.comp_apply,
    Scheme.Modules.Hom.id_app] at h
  simpa using h

/-- For an isomorphism `e` of `𝒪_Y`-modules, `e.hom` undoes `e.inv` on global sections. -/
theorem hom_app_inv_app {M N : Y.Modules} (e : M ≅ N) (z : Γ(N, ⊤)) :
    e.hom.app ⊤ (e.inv.app ⊤ z) = z := by
  simpa using inv_app_hom_app e.symm z

/-- The values of `ψ` are compatible with transport along an equality of degrees. -/
theorem powCongr_app_toFun (ψ : VeroneseSections 𝒜 d L) {n₁ n₂ : ℕ} (e : n₁ = n₂) (x : A)
    (h₁ : x ∈ 𝒜 (n₁ * d)) (h₂ : x ∈ 𝒜 (n₂ * d)) :
    (powCongr L e).app ⊤ (ψ.toFun n₁ ⟨x, h₁⟩) = ψ.toFun n₂ ⟨x, h₂⟩ := by
  subst e
  simp

/-- **The degree-`m` component of the Veronese restriction of `ψ` at a weight `k`**: the
degree-`km` component of `ψ`, read backwards through the comparison
`(L^{⊗ k}) ^⊗ m ≅ L ^⊗ (km)`. -/
def veroneseComp (ψ : VeroneseSections 𝒜 d L) (k m : ℕ) :
    𝒜 (m * (k * d)) →+ Γ(natTensorPow (natTensorPow L k) m, ⊤) :=
  (appTopHom (powVeroneseIso L k m).inv).comp
    ((ψ.toFun (k * m)).comp (gradedCast 𝒜 (by ring)))

/-- The value of the degree-`m` component of the restriction, with the homogeneous element of
degree `kmd` named explicitly rather than transported. -/
theorem veroneseComp_apply (ψ : VeroneseSections 𝒜 d L) (k m : ℕ) (x : 𝒜 (m * (k * d)))
    (y : 𝒜 (k * m * d)) (hxy : (y : A) = (x : A)) :
    veroneseComp 𝒜 ψ k m x
      = (powVeroneseIso L k m).inv.app ⊤ (ψ.toFun (k * m) y) :=
  congrArg _ (congrArg (ψ.toFun (k * m)) (Subtype.ext hxy.symm))

/-- **The Veronese restriction of `ψ` at a weight `k`**: the graded map
`A^{(kd)} ⟶ Γ_*(Y, L^{⊗ k})` whose degree-`m` component is the degree-`km` component of `ψ`,
read through the comparison `(L^{⊗ k}) ^⊗ m ≅ L ^⊗ (km)`. -/
def veroneseRestrict (ψ : VeroneseSections 𝒜 d L) (k : ℕ) :
    VeroneseSections 𝒜 (k * d) (natTensorPow L k) where
  toFun m := veroneseComp 𝒜 ψ k m
  map_mul n m a b ab hab := by
    have ha' : ((a : A)) ∈ 𝒜 (k * n * d) := mem_graded_of_eq 𝒜 (by ring) a.2
    have hb' : ((b : A)) ∈ 𝒜 (k * m * d) := mem_graded_of_eq 𝒜 (by ring) b.2
    have hab1 : ((ab : A)) ∈ 𝒜 ((k * n + k * m) * d) := mem_graded_of_eq 𝒜 (by ring) ab.2
    have hab2 : ((ab : A)) ∈ 𝒜 (k * (n + m) * d) := mem_graded_of_eq 𝒜 (by ring) ab.2
    rw [veroneseComp_apply 𝒜 ψ k (n + m) ab ⟨(ab : A), hab2⟩ rfl,
      veroneseComp_apply 𝒜 ψ k n a ⟨(a : A), ha'⟩ rfl,
      veroneseComp_apply 𝒜 ψ k m b ⟨(b : A), hb'⟩ rfl]
    refine Eq.trans (congrArg ((powVeroneseIso L k (n + m)).inv.app ⊤) ?_)
      (inv_app_hom_app (powVeroneseIso L k (n + m)) _)
    rw [mulSections_powVeroneseIso, hom_app_inv_app, hom_app_inv_app,
      ← ψ.map_mul (k * n) (k * m) ⟨(a : A), ha'⟩ ⟨(b : A), hb'⟩ ⟨(ab : A), hab1⟩ hab]
    exact (powCongr_app_toFun 𝒜 ψ (Nat.mul_add k n m).symm (ab : A) hab1 hab2).symm

/-- The degree-`m` component of `veroneseRestrict 𝒜 ψ k` is `veroneseComp 𝒜 ψ k m`. -/
@[simp] theorem veroneseRestrict_toFun (ψ : VeroneseSections 𝒜 d L) (k m : ℕ) :
    (veroneseRestrict 𝒜 ψ k).toFun m = veroneseComp 𝒜 ψ k m := rfl

/-! ### The generation condition for the restriction -/

variable [Stacks.Ample.IsInvertibleModule Y L]

omit [Stacks.Ample.IsInvertibleModule Y L] in
/-- The value of the Veronese restriction at `f ^ k`, for `f` homogeneous of degree `d`, is the
`k`-th power `ψ(f)^k` read through the comparison. -/
theorem veroneseRestrict_pow_pow (ψ : VeroneseSections 𝒜 d L) (k : ℕ) {f : A}
    (hf : f ∈ 𝒜 d) (hfk : f ^ k ∈ 𝒜 (k * d)) :
    (veroneseRestrict 𝒜 ψ k).pow hfk 1
      = (powVeroneseIso L k 1).inv.app ⊤
          ((powCongr L (Nat.mul_one k).symm).app ⊤ (ψ.pow hf k)) := by
  have hk1 : f ^ k ∈ 𝒜 (k * 1 * d) := mem_graded_of_eq 𝒜 (by ring) hfk
  rw [VeroneseSections.pow, veroneseRestrict_toFun,
    veroneseComp_apply 𝒜 ψ k 1 _ ⟨f ^ k, hk1⟩ (by simp)]
  exact congrArg _ (powCongr_app_toFun 𝒜 ψ (Nat.mul_one k).symm (f ^ k) hfk hk1).symm

/-- **The restricted map generates `L^{⊗ k}`.** The nonvanishing opens of the degree-`kd` values
of the Veronese restriction cover `Y` as soon as those of the degree-`d` values of `ψ` do: the
value at `f ^ k` is `ψ(f)^k`, which is nonvanishing wherever `ψ(f)` is. -/
theorem iSup_nonvanishingOpen_veroneseRestrict (ψ : VeroneseSections 𝒜 d L) (k : ℕ)
    (hgen : ⨆ f : 𝒜 d, nonvanishingOpen Y L (psiSection 𝒜 ψ f) = ⊤) :
    ⨆ g : 𝒜 (k * d), nonvanishingOpen Y (natTensorPow L k)
        (psiSection 𝒜 (veroneseRestrict 𝒜 ψ k) g) = ⊤ := by
  refine top_le_iff.mp (le_trans (le_of_eq hgen.symm) (iSup_le fun f => ?_))
  have hfk : (f : A) ^ k ∈ 𝒜 (k * d) :=
    Stacks.MorphismToProj.HomogeneousRatios.pow_mem f.2 k
  refine le_trans ?_ (le_iSup _ (⟨(f : A) ^ k, hfk⟩ : 𝒜 (k * d)))
  have e1 : nonvanishingOpen Y (natTensorPow L k)
        (psiSection 𝒜 (veroneseRestrict 𝒜 ψ k) ⟨(f : A) ^ k, hfk⟩)
      = nonvanishingOpen Y (natTensorPow L k) (ψ.pow f.2 k) := by
    rw [psiSection, veroneseRestrict_pow_pow 𝒜 ψ k f.2 hfk]
    refine Opens.ext ?_
    refine (Stacks.Ample.nonvanishingLocus_congr (unitorPow (natTensorPow L k)) _).trans ?_
    refine (Stacks.Ample.nonvanishingLocus_congr (powVeroneseIso L k 1).symm _).trans ?_
    exact Stacks.Ample.nonvanishingLocus_congr
      (eqToIso (congrArg (natTensorPow L) (Nat.mul_one k).symm)) _
  rw [e1, Stacks.AlgebraicGeometry.MorphismToProjUniversal.nonvanishingOpen_psiSection]
  exact ψ.le_nonvanishingOpen_pow f.2 k

end Stacks.AlgebraicGeometry.ProjVeroneseRestrict

end
