universe u

/-! ### The graded section ring of an invertible module on a scheme -/

section GammaStar

variable (Y : Scheme.{u}) (L : Y.Modules) [IsInvertibleModule Y L]

/-- The `n`-th tensor power `L^{⊗ n}` of an invertible `𝒪_Y`-module, Stacks Tag 01CU, at the
spelling the graded section ring of Tag 01CV is built over. -/
abbrev tensorPow (n : ℕ) : Y.Modules :=
  Stacks.SheafOfModules.TensorPower.tensorPower Y.presheaf
    (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf Y) L (n : ℤ)

/-- **`Γ_*(Y, L) = ⨁_{n ≥ 0} Γ(Y, L^{⊗ n})`**, the graded section ring of Stacks Tag 01CV. -/
abbrev gammaStar : Type u :=
  Stacks.SheafOfModules.sectionRing Y.presheaf
    (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf Y) L

/-- **The graded commutative ring structure on `Γ_*(Y, L)`**, Stacks Tag 01CV. This is
`Stacks.SheafOfModules.sectionRingGradedRing`, restated at the spelling instance search reaches
on a scheme: the library instance is indexed by a presheaf of commutative rings together with a
sheaf condition, and resolution does not get from `Y.Modules` to that shape. -/
@[ega "0 5.4.6" "partial"]
instance gammaStarGCommRing :
    DirectSum.GCommRing (fun n : ℕ => (tensorPow Y L n).val.obj (op (⊤_ (Opens Y)))) :=
  Stacks.SheafOfModules.sectionRingGradedRing Y.presheaf
    (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf Y) L

/-- The degree `n` homogeneous component of `Γ_*(Y, L)`, an additive subgroup of the section
ring: the image of the summand `Γ(Y, L^{⊗ n})`. -/
abbrev gammaStarGrading (n : ℕ) : AddSubgroup (gammaStar Y L) :=
  Stacks.SheafOfModules.sectionRingGrading Y.presheaf
    (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf Y) L n

/-- A section over the terminal object of the site of opens, read as a section over `⊤`: the
restriction along the unique morphism `⊤ ⟶ ⊤_`. The two opens are isomorphic but not
definitionally equal, and the graded section ring is indexed by the first while the nonvanishing
locus is stated for the second. -/
def toTopSection (M : Y.Modules) (s : M.val.obj (op (⊤_ (Opens Y)))) : Γ(M, ⊤) :=
  M.val.map (Limits.terminal.from (⊤ : Opens Y)).op s

/-- **The canonical isomorphism `L^{⊗ n} ≅ (L')^{⊗ n}` induced by an isomorphism `L ≅ L'`**, in
every nonnegative degree. It is `Stacks.RelativeVeryAmple.tensorPowModuleIsoOfIso`, read across
`Stacks.RelativeVeryAmple.cardTensorPowerIso` into the spelling of the graded section ring. -/
def tensorPowIsoOfIso (L' : Y.Modules) [IsInvertibleModule Y L'] (β : L ≅ L') (n : ℕ) :
    tensorPow Y L n ≅ tensorPow Y L' n :=
  Stacks.RelativeVeryAmple.cardTensorPowerIso Y L n ≪≫
    Stacks.RelativeVeryAmple.tensorPowModuleIsoOfIso Y L L' β n ≪≫
    (Stacks.RelativeVeryAmple.cardTensorPowerIso Y L' n).symm

end GammaStar

/-! ### Triples -/

section Triple

variable {S : Type u} {σ : Type u} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

/-- A homogeneous element of degree exactly `d` read as an element of the Veronese subring
`S^{(d)}`: it lies in the degree one piece `S_{1 · d}`. -/
def veroneseOfDegree (d : ℕ) (f : 𝒮 d) : veroneseSubring 𝒮 d :=
  ⟨(f : S), mem_veroneseSubring_of_mem 𝒮 (n := 1) (by rw [one_mul]; exact f.2)⟩

omit [AddSubgroupClass σ S] [GradedRing 𝒮] in
/-- The underlying element of `S` of `veroneseOfDegree 𝒮 d f` is `f`. -/
@[simp] theorem coe_veroneseOfDegree (d : ℕ) (f : 𝒮 d) :
    ((veroneseOfDegree 𝒮 d f : veroneseSubring 𝒮 d) : S) = (f : S) := rfl

variable (Y : Scheme.{u}) (L : Y.Modules) [IsInvertibleModule Y L] (d : ℕ)

/-- A graded ring map `ψ : S^{(d)} ⟶ Γ_*(Y, L)`, as the source states it: a ring map on the
Veronese subring carrying its degree `n` piece into the degree `n` piece of the graded section
ring. -/
abbrev PsiHom : Type u :=
  veroneseGrading 𝒮 d →+*ᵍ gammaStarGrading Y L

/-- The degree `n` component of `ψ`, a global section of `L^{⊗ n}`. -/
def psiComponent (psi : PsiHom 𝒮 Y L d) (n : ℕ) (a : veroneseSubring 𝒮 d) :
    (tensorPow Y L n).val.obj (op (⊤_ (Opens Y))) :=
  DirectSum.component ℕ ℕ _ n (psi.toRingHom a)

/-- **The global sections `ψ(f)`, `f ∈ S_d`, of the source.** The degree one component of `ψ` on
a homogeneous element of degree exactly `d`, read as a global section of `L^{⊗ 1}` over `⊤`. -/
def degreeOneSection (psi : PsiHom 𝒮 Y L d) (f : 𝒮 d) : Γ(tensorPow Y L 1, ⊤) :=
  toTopSection Y (tensorPow Y L 1) (psiComponent 𝒮 Y L d psi 1 (veroneseOfDegree 𝒮 d f))

/-- **A triple `(d, L, ψ)` of Stacks Tag 01N4**, with the integer `d` and the invertible
`𝒪_Y`-module `L` as parameters: a graded ring map `ψ : S^{(d)} ⟶ Γ_*(Y, L)` such that `L` is
generated by the global sections `ψ(f)` for `f` homogeneous of degree `d`.

Generation is the statement that the nonvanishing loci of those sections cover `Y`, which for an
invertible module is exactly generation: at a point of the nonvanishing locus of a section the
section generates the stalk (`Stacks.SectionProduct.mem_nonvanishingLocus_iff_generates`). -/
@[stacks 01N4 "triple"]
structure Triple where
  /-- The graded ring map `ψ : S^{(d)} ⟶ Γ_*(Y, L)`. -/
  psi : PsiHom 𝒮 Y L d
  /-- `L` is generated by the global sections `ψ(f)`, `f ∈ S_d`. -/
  generated : ∀ y : Y, ∃ f : 𝒮 d,
    y ∈ Stacks.Ample.nonvanishingLocus (tensorPow Y L 1) (degreeOneSection 𝒮 Y L d psi f)

end Triple

section Bundled

variable {S : Type u} {σ : Type u} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮] (Y : Scheme.{u})

/-- **A triple of Stacks Tag 01N4 in the literal shape of the source**: an integer `d ≥ 1`, an
invertible `𝒪_Y`-module `L`, and a graded ring map `ψ : S^{(d)} ⟶ Γ_*(Y, L)` for which `L` is
generated by the sections `ψ(f)`, `f ∈ S_d`. -/
@[stacks 01N4 "triple, bundled"]
structure BundledTriple where
  /-- The integer `d`. -/
  deg : ℕ
  /-- `d ≥ 1`. -/
  one_le_deg : 1 ≤ deg
  /-- The invertible `𝒪_Y`-module `L`. -/
  module : Y.Modules
  /-- `L` is invertible. -/
  isInvertible : IsInvertibleModule Y module
  /-- The graded ring map and the generation condition. -/
  toTriple : haveI := isInvertible; Triple 𝒮 Y module deg

end Bundled

/-! ### Strict equivalence -/

section StrictEquiv

variable {S : Type u} {σ : Type u} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮] (Y : Scheme.{u}) (d : ℕ)
  (L : Y.Modules) [IsInvertibleModule Y L] (L' : Y.Modules) [IsInvertibleModule Y L']

/-- **Strict equivalence of two triples with the same `d`**, Stacks Tag 01N4: there is an
isomorphism `β : L ⟶ L'` of invertible `𝒪_Y`-modules with `β ∘ ψ = ψ'`.

The condition `β ∘ ψ = ψ'` is written out degreewise: in degree `n` the induced isomorphism
`L^{⊗ n} ≅ (L')^{⊗ n}` carries the degree `n` component of `ψ` to that of `ψ'`. A graded map is
its family of components, so this is the source's condition and not a weakening of it. -/
@[stacks 01N4 "strict equivalence"]
def StrictEquiv (t : Triple 𝒮 Y L d) (t' : Triple 𝒮 Y L' d) : Prop :=
  ∃ β : L ≅ L', ∀ (n : ℕ) (a : veroneseSubring 𝒮 d),
    (tensorPowIsoOfIso Y L L' β n).hom.val.app (op (⊤_ (Opens Y)))
        (psiComponent 𝒮 Y L d t.psi n a) =
      psiComponent 𝒮 Y L' d t'.psi n a

end StrictEquiv

end Stacks.AlgebraicGeometry.ProjTriple

end
