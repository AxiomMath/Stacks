module

public import StacksFrontier.AlgebraicGeometry.Chow.UniversalPrincipalDivisor.ZeroIdeal
public import StacksFrontier.AlgebraicGeometry.Constructions.ProjAndSpec
public import StacksFrontier.AlgebraicGeometry.Groupoids.IdealSheafComap
public import StacksFrontier.AlgebraicGeometry.IdealSheafZariskiGluing
public import StacksFrontier.AlgebraicGeometry.Smooth.FormallySmoothScheme

/-!
# The zero section of a cone is the fibre product `L ×_X Z`

Let `L = Proj ℬ ⟶ X = Spec A` be the cone over `P = Proj 𝒜` attached to cone data `(ψ, τ, σ)`
(`Stacks.AlgebraicGeometry.ProjAndSpec.ConeData`), with zero section `0 : P ⟶ L` and the closed
subscheme `Z = Spec A₀ ⟶ X` cut out by the irrelevant ideal `A₊`. The square

```
P --0--> L
|        |
Z -----> X
```

commutes. If moreover every homogeneous element of the kernel of `τ : B ⟶ A` lies in the ideal
of `B` generated by `σ(A₊)` — as happens for the truncation algebra `B = ⨁_d A_{≥ d}` of a ring
generated over `A₀` in degree one, where the kernel of `τ` in degree `d` is `A_{≥ d+1} = A₊A_{≥ d}`
— then the square is cartesian: **the zero section is the scheme-theoretic inverse image of `Z`
in `L`**. For the blowup of `X = Spec A` along `Z` this is the statement that the exceptional
divisor is the zero section of the cone, which Section 50.16 of the source records as part of its
standing situation.

## Main results

* `Stacks.AlgebraicGeometry.ProjAndSpec.ker_awayMap_tau`: on the standard affine open `D₊(s)` of
  `L`, the kernel of `τ` localized is generated by the image of `A₊`.
* `Stacks.AlgebraicGeometry.ProjAndSpec.isPullback_zeroSection`: the cartesian square.

## References

* [Stacks Project, Tag 0EKG](https://stacks.math.columbia.edu/tag/0EKG)
* [Stacks Project, Tag 0FUB](https://stacks.math.columbia.edu/tag/0FUB)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory HomogeneousLocalization

namespace Stacks.AlgebraicGeometry.ProjAndSpec

universe u

section Cone

variable {A B : Type u} {σ τ : Type u} [CommRing A] [CommRing B]
  [SetLike σ A] [AddSubgroupClass σ A] [SetLike τ B] [AddSubgroupClass τ B]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ] (c : ConeData 𝒜 ℬ)

/-- The ring map `A ⟶ B₀ ⟶ ℬ_(s)`, through which the standard open `D₊(s)` of `L` lies over
`X = Spec A`. -/
abbrev awayFromBase (s : B) : A →+* Away ℬ s :=
  (fromZeroRingHom ℬ (Submonoid.powers s)).comp c.sigma.toRingHom

/-- The image of `A₊` in `ℬ_(s)` is killed by `τ`: `τ ∘ σ` is the projection onto degree zero. -/
theorem map_awayFromBase_le_ker_awayMap_tau (s : B) :
    Ideal.map (awayFromBase c s) (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
      RingHom.ker (Away.map c.tau s) := by
  refine Ideal.map_le_iff_le_comap.mpr fun a ha => ?_
  rw [Ideal.mem_comap, RingHom.mem_ker]
  have h0 : GradedRing.projZeroRingHom 𝒜 a = 0 :=
    (HomogeneousIdeal.mem_irrelevant_iff 𝒜 a).1 ha
  ext
  simp only [RingHom.comp_apply, Away.map, val_zero]
  show Localization.mk (c.tau (c.sigma a : B)) ⟨c.tau 1, _⟩ = 0
  rw [c.tau_sigma, h0, Localization.mk_zero]

/-- A homogeneous element of the ideal of `B` generated by degree-zero elements is a combination
of them with homogeneous coefficients of its own degree. -/
theorem exists_sum_of_mem_span_of_mem_zero {S : Set B} (hS : S ⊆ (ℬ 0 : Set B)) {d : ℕ}
    {b : B} (hb : b ∈ ℬ d) (hspan : b ∈ Ideal.span S) :
    ∃ (n : ℕ) (r : Fin n → B) (g : Fin n → S), (∀ i, r i ∈ ℬ d) ∧
      b = ∑ i, r i * (g i : B) := by
  classical
  obtain ⟨n, r, g, hrg⟩ := Submodule.mem_span_set'.1 hspan
  refine ⟨n, fun i => (DirectSum.decompose ℬ (r i) d : B), g, fun i => (DirectSum.decompose ℬ
    (r i) d).2, ?_⟩
  have hdec : GradedRing.proj ℬ d b = b := by
    rw [GradedRing.proj_apply]
    exact DirectSum.decompose_of_mem_same ℬ hb
  rw [← hdec, ← hrg, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [smul_eq_mul, GradedRing.proj_apply,
    DirectSum.coe_decompose_mul_of_right_mem ℬ d (hS (g i).2), ite_eq_left (Nat.zero_le d),
    Nat.sub_zero]

/-- **The kernel of `τ` on the standard affine open `D₊(s)` of `L` is generated by `A₊`**, as soon
as every homogeneous element of the kernel of `τ` lies in the ideal generated by `σ(A₊)`. -/
theorem ker_awayMap_tau
    (hker : ∀ (d : ℕ) (b : B), b ∈ ℬ d → c.tau b = 0 →
      b ∈ Ideal.span ((fun a => (c.sigma a : B)) '' (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
    {s : B} {k : ℕ} (hs : s ∈ ℬ k) :
    RingHom.ker (Away.map c.tau s) =
      Ideal.map (awayFromBase c s) (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
  refine le_antisymm (fun x hx => ?_) (map_awayFromBase_le_ker_awayMap_tau c s)
  obtain ⟨n, b, hb, rfl⟩ := Away.mk_surjective ℬ hs x
  rw [RingHom.mem_ker, Away.map_mk] at hx
  have hx' := congrArg HomogeneousLocalization.val hx
  rw [Away.val_mk, val_zero, Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff] at hx'
  obtain ⟨⟨_, N, rfl⟩, hN⟩ := hx'
  have hτ : c.tau (s ^ N * b) = 0 := by
    rw [map_mul, map_pow]
    exact hN
  have hmem : s ^ N * b ∈ ℬ ((N + n) • k) := by
    rw [add_smul]
    exact SetLike.mul_mem_graded (SetLike.pow_mem_graded N hs) hb
  have hS : (fun a => (c.sigma a : B)) '' (HomogeneousIdeal.irrelevant 𝒜).toIdeal ⊆
      (ℬ 0 : Set B) := by
    rintro _ ⟨a, -, rfl⟩
    exact (c.sigma a).2
  obtain ⟨m, r, g, hr, hsum⟩ := exists_sum_of_mem_span_of_mem_zero hS hmem
    (hker _ _ hmem hτ)
  have heq : Away.mk ℬ hs n b hb =
      ∑ i, Away.mk ℬ hs (N + n) (r i) (hr i) *
        fromZeroRingHom ℬ (Submonoid.powers s) ⟨(g i : B), hS (g i).2⟩ := by
    apply val_injective
    have hval := map_sum (algebraMap (HomogeneousLocalization ℬ (Submonoid.powers s))
      (Localization (Submonoid.powers s))) (fun i => Away.mk ℬ hs (N + n) (r i) (hr i) *
        fromZeroRingHom ℬ (Submonoid.powers s) ⟨(g i : B), hS (g i).2⟩) Finset.univ
    simp only [HomogeneousLocalization.algebraMap_apply] at hval
    rw [hval]
    simp only [val_mul, Away.val_mk]
    show _ = ∑ i, Localization.mk (r i) ⟨s ^ (N + n), _⟩ * Localization.mk (g i : B) 1
    simp only [Localization.mk_mul, mul_one]
    rw [← Localization.mk_sum, ← hsum, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp only [OneMemClass.coe_one, one_mul, pow_add]; ring⟩
  rw [heq]
  refine Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ ?_
  obtain ⟨a, ha, hga⟩ := (g i).2
  have : fromZeroRingHom ℬ (Submonoid.powers s) ⟨(g i : B), hS (g i).2⟩ = awayFromBase c s a := by
    simp only [awayFromBase, RingHom.comp_apply]
    congr 1
    exact Subtype.ext hga.symm
  rw [this]
  exact Ideal.mem_map_of_mem _ ha

/-- The closed immersion `Z = Spec A₀ ⟶ X = Spec A` is a closed immersion: `A ⟶ A₀` is
surjective. -/
theorem isClosedImmersion_zToX : IsClosedImmersion (zToX 𝒜) :=
  IsClosedImmersion.spec_of_surjective _ (GradedRing.projZeroRingHom'_surjective 𝒜)

/-- The chart `D₊(f) ≅ Spec 𝒜_(f)` followed by `Spec 𝒜_(f) ⟶ Proj 𝒜` is the inclusion of
`D₊(f)`. -/
private theorem basicOpenIsoSpec_hom_comp_awayι {d : ℕ} {f : A} (hf : f ∈ 𝒜 d) (hd : 0 < d) :
    (Proj.basicOpenIsoSpec 𝒜 f hf hd).hom ≫ Proj.awayι 𝒜 f hf hd = (Proj.basicOpen 𝒜 f).ι := by
  rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]

/-- **The zero section over a standard affine open of the cone**: over `D₊(s) = Spec ℬ_(s)` the
zero section is `Spec` of `τ` localized, `Spec 𝒜_(τ s) ⟶ Spec ℬ_(s)`. -/
theorem isPullback_awayι_zeroSection {s : B} {k : ℕ} (hs : s ∈ ℬ k) (hk : 0 < k) :
    IsPullback (Spec.map (CommRingCat.ofHom (Away.map c.tau s)))
      (Proj.awayι 𝒜 (c.tau s) (GradedRingHom.map_mem c.tau hs) hk) (Proj.awayι ℬ s hs hk)
      (zeroSection c) := by
  have h₁ := isPullback_morphismRestrict (Proj.map c.tau (irrelevant_le_map_tau c))
    (Proj.basicOpen ℬ s)
  have key : Spec.map (CommRingCat.ofHom (Away.map c.tau s)) ≫ Proj.awayι ℬ s hs hk =
      Proj.awayι 𝒜 (c.tau s) (GradedRingHom.map_mem c.tau hs) hk ≫
        Proj.map c.tau (irrelevant_le_map_tau c) :=
    (Proj.awayι_comp_map _ _ hk s hs).symm
  refine h₁.of_iso (Proj.basicOpenIsoSpec 𝒜 (c.tau s) (GradedRingHom.map_mem c.tau hs) hk)
    (Proj.basicOpenIsoSpec ℬ s hs hk) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
  · rw [← cancel_mono (Proj.awayι ℬ s hs hk)]
    simp only [Category.assoc]
    rw [key, basicOpenIsoSpec_hom_comp_awayι, morphismRestrict_ι]
    exact congrArg (· ≫ Proj.map c.tau (irrelevant_le_map_tau c))
      (basicOpenIsoSpec_hom_comp_awayι _ _).symm
  · rw [Iso.refl_hom, Category.comp_id]
    exact (basicOpenIsoSpec_hom_comp_awayι _ _).symm
  · rw [Iso.refl_hom, Category.comp_id]
    exact (basicOpenIsoSpec_hom_comp_awayι _ _).symm
  · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp, zeroSection_eq_projMap]

/-- The kernel of the projection `A ⟶ A₀` is the irrelevant ideal. -/
theorem ker_projZeroRingHom' :
    RingHom.ker (GradedRing.projZeroRingHom' 𝒜) = (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
  ext a
  show _ ↔ a ∈ HomogeneousIdeal.irrelevant 𝒜
  rw [RingHom.mem_ker, HomogeneousIdeal.mem_irrelevant_iff, ← Subtype.coe_inj]
  rfl

/-- **The zero section of a cone is the fibre product `L ×_X Z`**, as soon as every homogeneous
element of the kernel of `τ` lies in the ideal of `B` generated by `σ(A₊)`: the square formed by
the zero section `0 : P ⟶ L`, the structure morphisms `P ⟶ Z` and `L ⟶ X`, and the closed
immersion `Z ⟶ X` is cartesian. -/
theorem isPullback_zeroSection
    (hker : ∀ (d : ℕ) (b : B), b ∈ ℬ d → c.tau b = 0 →
      b ∈ Ideal.span ((fun a => (c.sigma a : B)) '' (HomogeneousIdeal.irrelevant 𝒜).toIdeal)) :
    IsPullback (zeroSection c) (Proj.toSpecZero 𝒜) (toSpecA c) (zToX 𝒜) := by
  have := isClosedImmersion_zeroSection c
  have := isClosedImmersion_zToX (𝒜 := 𝒜)
  refine isPullback_of_isClosedImmersion _ _ _ _ (zeroSection_comp_toSpecA c) ?_
  refine Scheme.IdealSheafData.ext_of_comap_eq_of_isOpenImmersion
    (fun j : (Proj.affineOpenCover ℬ).I₀ => (Proj.affineOpenCover ℬ).f j)
    (fun w => (Proj.affineOpenCover ℬ).openCover.exists_eq w) fun j => ?_
  let k : ℕ := j.1
  have hk : 0 < k := j.1.2
  let s : B := j.2.1
  have hs : s ∈ ℬ k := j.2.2
  show ((zToX 𝒜).ker.comap (toSpecA c)).comap (Proj.awayι ℬ s hs hk) =
    (zeroSection c).ker.comap (Proj.awayι ℬ s hs hk)
  rw [← AlgebraicGeometry.ker_eq_comap_ker_of_isPullback (isPullback_awayι_zeroSection c hs hk),
    ← Scheme.IdealSheafData.comap_comp]
  have hto : Proj.awayι ℬ s hs hk ≫ toSpecA c =
      Spec.map (CommRingCat.ofHom (awayFromBase c s)) := by
    rw [toSpecA, reassoc_of% Proj.awayι_toSpecZero, ← Spec.map_comp]
    rfl
  rw [hto]
  refine Scheme.IdealSheafData.ext_of_isAffine ?_
  rw [Stacks.IdealSheaf.ideal_comap_top_of_isAffine, Scheme.Hom.ker_apply, Scheme.Hom.ker_apply]
  show Ideal.map (Spec.map (CommRingCat.ofHom (awayFromBase c s))).appTop.hom
      (RingHom.ker (Spec.map (CommRingCat.ofHom (GradedRing.projZeroRingHom' 𝒜))).appTop.hom) =
    RingHom.ker (Spec.map (CommRingCat.ofHom (Away.map c.tau s))).appTop.hom
  rw [Stacks.Smooth.ker_specMap_appTop, Stacks.Smooth.ker_specMap_appTop, CommRingCat.hom_ofHom,
    CommRingCat.hom_ofHom, ker_projZeroRingHom', ker_awayMap_tau c hker hs]
  have happ : (Spec.map (CommRingCat.ofHom (awayFromBase c s))).appTop =
      (Scheme.ΓSpecIso (CommRingCat.of A)).hom ≫ CommRingCat.ofHom (awayFromBase c s) ≫
        (Scheme.ΓSpecIso (CommRingCat.of (Away ℬ s))).inv := by
    rw [← Category.assoc, Iso.eq_comp_inv]
    exact Scheme.ΓSpecIso_naturality _
  rw [happ, CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom, ← Ideal.map_map,
    ← Ideal.map_map, Ideal.map_comap_of_surjective _
      (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of A)).hom).2]
  exact Ideal.map_comap_of_equiv
    (Scheme.ΓSpecIso (CommRingCat.of (Away ℬ s))).commRingCatIsoToRingEquiv.symm

end Cone

end Stacks.AlgebraicGeometry.ProjAndSpec

end
