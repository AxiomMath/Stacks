module

public import StacksFrontier.AlgebraicGeometry.Constructions.ProjTriplePullbackEquiv

/-!
# The functor `F_d` of weight-`d` triples

Let `A = ⨁_{n ≥ 0} 𝒜 n` be a graded ring and let `d ≥ 1`. Section 27.12 attaches to a scheme `Y`
the set `F_d(Y)` of strict equivalence classes of triples `(d, L, ψ)` of weight `d`: an invertible
`𝒪_Y`-module `L` together with a graded ring map `ψ : A^{(d)} ⟶ Γ_*(Y, L)` whose degree-`d` values
generate `L`, two such being identified when they are strictly equivalent in the sense of
`Stacks.AlgebraicGeometry.ProjTripleClassifying.SectionsEquiv`. A morphism of schemes
`h : Y' ⟶ Y` acts by pullback. This file assembles that data into a functor
`Scheme.{u}ᵒᵖ ⥤ Type (u + 1)`.

## Main definitions

* `Stacks.AlgebraicGeometry.ProjTripleDegreeFunctor.DegreeTriple`: a triple of weight `d`, the
  weight being a parameter rather than a field.
* `Stacks.AlgebraicGeometry.ProjTripleDegreeFunctor.DegreeTriple.pullback`: the pullback of such a
  triple along a morphism of schemes.
* `Stacks.AlgebraicGeometry.ProjTripleDegreeFunctor.DegreeTriple.setoid`: strict equivalence of
  weight-`d` triples, as the comparison of their underlying
  `Stacks.AlgebraicGeometry.ProjTripleClassifying.DegreeSections`.
* `Stacks.AlgebraicGeometry.ProjTripleDegreeFunctor.Fd`: the set `F_d(Y)`, the quotient of the
  weight-`d` triples on `Y` by strict equivalence.
* `Stacks.AlgebraicGeometry.ProjTripleDegreeFunctor.Fd.functor`: the functor
  `F_d : Sch^{opp} ⟶ Sets` of Section 27.12 at a fixed weight.

## Main results

* `Stacks.AlgebraicGeometry.ProjTripleDegreeFunctor.Fd.mk_eq_mk_iff`: two weight-`d` triples have
  the same class exactly when their graded maps are strictly equivalent.
* `Stacks.AlgebraicGeometry.ProjTripleDegreeFunctor.Fd.pullback_id` and `Fd.pullback_comp`: the
  two functor laws, on classes.

## Implementation notes

The weight is a parameter of `DegreeTriple`, not a field as in
`Stacks.AlgebraicGeometry.ProjTripleClassifying.Triple`: `SectionsEquiv` compares graded maps of
the same weight, and a relation on `Triple` would have to transport along an equality of weights,
whose dependent elimination fails since the module and graded map are indexed by the weight.

The setoid is `sectionsSetoid` pulled back along `DegreeTriple.toDegreeSections`: invertibility
and generation are part of what `F_d` classifies but play no part in strict equivalence.

A triple carries an `𝒪_Y`-module, so `F_d(Y)` is `Type (u + 1)` for `Y : Scheme.{u}`. This is no
obstruction to representability and no `ULift` is needed: `CategoryTheory.Functor.RepresentableBy`
allows the functor's universe to differ from that of the `Hom` sets.

## References

* [Stacks Project, Section 01N4](https://stacks.math.columbia.edu/tag/01N4)
* [Stacks Project, Tag 01N9](https://stacks.math.columbia.edu/tag/01N9)
* [Stacks Project, Tag 01NC](https://stacks.math.columbia.edu/tag/01NC)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite
open AlgebraicGeometry
open Stacks.AlgebraicGeometry.MorphismToProjUniversal (psiSection)
open Stacks.AlgebraicGeometry.ProjChartFromRatios (VeroneseSections)
open Stacks.AlgebraicGeometry.ProjTripleClassifying (DegreeSections SectionsEquiv sectionsSetoid)
open Stacks.AlgebraicGeometry.ProjTriplePullback (pullbackSections
  iSup_nonvanishingOpen_pullbackSections)
open Stacks.NonvanishingOpen (nonvanishingOpen)

universe u w

namespace Stacks.AlgebraicGeometry.ProjTripleDegreeFunctor

variable {σ : Type w} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-! ### Triples of a fixed weight -/

/-- **A triple of weight `d` over `Y`**, in the vocabulary of [Stacks, Tag 01N9]: an invertible
`𝒪_Y`-module `L`, a graded ring map `ψ : A^{(d)} ⟶ Γ_*(Y, L)`, and the generation condition in the
geometric form Section 27.12 uses it — the nonvanishing opens of the degree-`d` values `ψ(f)` cover
`Y`. -/
structure DegreeTriple (d : ℕ) (Y : Scheme.{u}) : Type (u + 1) where
  /-- The invertible `𝒪_Y`-module `L`. -/
  module : Y.Modules
  /-- `L` is invertible. -/
  isInvertible : Stacks.Ample.IsInvertibleModule Y module
  /-- The graded ring map `ψ : A^{(d)} ⟶ Γ_*(Y, L)`. -/
  psi : VeroneseSections 𝒜 d module
  /-- `L` is generated by the degree-`d` values of `ψ`. -/
  generated : haveI := isInvertible;
    ⨆ f : 𝒜 d, nonvanishingOpen Y module (psiSection 𝒜 psi f) = ⊤

namespace DegreeTriple

variable {d : ℕ} {Y Y' Y'' : Scheme.{u}}

/-- The weight-`d` graded map of a triple together with the module it maps into: the data strict
equivalence compares. -/
def toDegreeSections (t : DegreeTriple 𝒜 d Y) : DegreeSections 𝒜 d Y :=
  ⟨t.module, t.psi⟩

/-- **The pullback of a weight-`d` triple along a morphism of schemes `h : Y' ⟶ Y`**: the triple
`(h^*L, h^* ∘ ψ)`. -/
def pullback (t : DegreeTriple 𝒜 d Y) (h : Y' ⟶ Y) : DegreeTriple 𝒜 d Y' where
  module := (Scheme.Modules.pullback h).obj t.module
  isInvertible := haveI := t.isInvertible; inferInstance
  psi := haveI := t.isInvertible; pullbackSections 𝒜 t.psi h
  generated := haveI := t.isInvertible
    iSup_nonvanishingOpen_pullbackSections 𝒜 t.psi h t.generated

/-- The invertible module of the pullback of `t` along `h` is `h^*L`. -/
@[simp] theorem pullback_module (t : DegreeTriple 𝒜 d Y) (h : Y' ⟶ Y) :
    (pullback 𝒜 t h).module = (Scheme.Modules.pullback h).obj t.module := rfl

/-- **Strict equivalence of weight-`d` triples**, as a `Setoid`: the comparison of the underlying
`Stacks.AlgebraicGeometry.ProjTripleClassifying.DegreeSections` by
`Stacks.AlgebraicGeometry.ProjTripleClassifying.sectionsSetoid`. Neither the invertibility of the
module nor the generation condition enters the comparison. -/
def setoid (d : ℕ) (Y : Scheme.{u}) : Setoid (DegreeTriple 𝒜 d Y) :=
  Setoid.comap (toDegreeSections 𝒜) (sectionsSetoid 𝒜 d Y)

/-- The relation of `setoid` is strict equivalence of the two graded maps. -/
theorem setoid_r (t t' : DegreeTriple 𝒜 d Y) :
    (setoid 𝒜 d Y).r t t' ↔ SectionsEquiv 𝒜 t.psi t'.psi :=
  Iff.rfl

end DegreeTriple

/-! ### The set `F_d(Y)` -/

/-- **The set `F_d(Y)` of Section 27.12 at a fixed weight `d`**: the weight-`d` triples over `Y`
modulo strict equivalence. -/
def Fd (d : ℕ) (Y : Scheme.{u}) : Type (u + 1) :=
  Quotient (DegreeTriple.setoid 𝒜 d Y)

variable {d : ℕ} {Y Y' Y'' : Scheme.{u}}

/-- The class of a weight-`d` triple in `F_d(Y)`. -/
def Fd.mk (t : DegreeTriple 𝒜 d Y) : Fd 𝒜 d Y :=
  Quotient.mk (DegreeTriple.setoid 𝒜 d Y) t

/-- **Two weight-`d` triples have the same class in `F_d(Y)` exactly when their graded maps are
strictly equivalent.** -/
theorem Fd.mk_eq_mk_iff (t t' : DegreeTriple 𝒜 d Y) :
    Fd.mk 𝒜 t = Fd.mk 𝒜 t' ↔ SectionsEquiv 𝒜 t.psi t'.psi :=
  Quotient.eq.trans (DegreeTriple.setoid_r 𝒜 t t')

/-- **The map `F_d(Y) → F_d(Y')` of Section 27.12** attached to a morphism of schemes
`h : Y' ⟶ Y`: the class of a weight-`d` triple goes to the class of its pullback. -/
def Fd.pullback (h : Y' ⟶ Y) : Fd 𝒜 d Y → Fd 𝒜 d Y' :=
  Quotient.map (fun t => DegreeTriple.pullback 𝒜 t h) fun t t' htt' =>
    haveI := t.isInvertible
    haveI := t'.isInvertible
    ProjTriplePullbackEquiv.sectionsEquiv_pullbackSections 𝒜 h htt'

/-- `Fd.pullback` sends the class of a triple to the class of its pullback. -/
@[simp] theorem Fd.pullback_mk (h : Y' ⟶ Y) (t : DegreeTriple 𝒜 d Y) :
    Fd.pullback 𝒜 h (Fd.mk 𝒜 t) = Fd.mk 𝒜 (DegreeTriple.pullback 𝒜 t h) := rfl

/-! ### The two functor laws -/

/-- **The identity law for the map `F_d(Y) → F_d(Y)` of Section 27.12**: the map attached to
`𝟙 Y` is the identity of `F_d(Y)`. -/
theorem Fd.pullback_id (ξ : Fd 𝒜 d Y) : Fd.pullback 𝒜 (𝟙 Y) ξ = ξ := by
  induction ξ using Quotient.ind with
  | _ t =>
      have := t.isInvertible
      exact (Fd.mk_eq_mk_iff 𝒜 _ _).mpr
        (ProjTripleFunctorLaws.sectionsEquiv_pullbackSections_id 𝒜 t.psi)

/-- **The composition law for the maps of Section 27.12**: the map attached to a composite
`g' ≫ g` of morphisms of schemes is the composite of the two maps. -/
theorem Fd.pullback_comp (g : Y' ⟶ Y) (g' : Y'' ⟶ Y') (ξ : Fd 𝒜 d Y) :
    Fd.pullback 𝒜 (g' ≫ g) ξ = Fd.pullback 𝒜 g' (Fd.pullback 𝒜 g ξ) := by
  induction ξ using Quotient.ind with
  | _ t =>
      have := t.isInvertible
      exact ((Fd.mk_eq_mk_iff 𝒜 _ _).mpr
        (ProjTripleFunctorLaws.sectionsEquiv_pullbackSections_comp 𝒜 g' g t.psi)).symm

/-! ### The functor -/

/-- **The functor `F_d : Sch^{opp} ⟶ Sets`** at a fixed weight `d`. It sends a scheme `Y` to the
set `F_d(Y)` of strict equivalence classes of weight-`d` triples `(d, L, ψ)` over `Y`, and a
morphism of schemes `h : Y' ⟶ Y` to the map sending the class of a triple to the class of its
pullback along `h`. -/
@[stacks 01N4 "the functor F_d : Sch^opp ⟶ Sets of this section at a fixed weight d, with both \
functor laws proved (Fd.pullback_id and Fd.pullback_comp): on objects the set F_d(Y) of strict \
equivalence classes of weight-d triples (d, L, ψ) over Y, on morphisms the pullback of a triple. \
The weight is a parameter rather than a field, so that SectionsEquiv applies with no transport. \
The target is Type (u+1), not Type u, because a triple carries an 𝒪_Y-module. Representability \
of F_d by U_d is Tag 01N9 and of the colimit F by Proj(A) is Tag 01NC; neither is proved in this \
file (Tag 01NC's is the carrier ProjTripleDegreeFunctor.F.representableBy, which is built on top \
of this functor)"]
def Fd.functor (d : ℕ) : Scheme.{u}ᵒᵖ ⥤ Type (u + 1) where
  obj Y := Fd 𝒜 d Y.unop
  map φ := TypeCat.ofHom (Fd.pullback 𝒜 (d := d) φ.unop)
  map_id _ := TypeCat.homEquiv.injective (funext fun ξ => Fd.pullback_id 𝒜 ξ)
  map_comp φ χ :=
    TypeCat.homEquiv.injective (funext fun ξ => Fd.pullback_comp 𝒜 φ.unop χ.unop ξ)

/-- `Fd.functor` sends `Y` to `F_d(Y)`. -/
@[simp] theorem Fd.functor_obj (d : ℕ) (Y : Scheme.{u}ᵒᵖ) :
    (Fd.functor 𝒜 d).obj Y = Fd 𝒜 d Y.unop := rfl

/-- `Fd.functor` acts on a morphism by `Fd.pullback`. -/
@[simp] theorem Fd.functor_map (d : ℕ) {X Y : Scheme.{u}ᵒᵖ} (φ : X ⟶ Y) (ξ : Fd 𝒜 d X.unop) :
    (Fd.functor 𝒜 d).map φ ξ = Fd.pullback 𝒜 φ.unop ξ := rfl

end Stacks.AlgebraicGeometry.ProjTripleDegreeFunctor

end
