open Stacks.NonvanishingOpen (nonvanishingOpen)
open Stacks.SectionProduct (globalSection)
open Stacks.SectionRingProjMorphism.ToSpecZero (unitSec mul_unitSec_right)
open Stacks.TensorPowers (natTensorPow)
open Stacks.TensorPowerTrivialize (resTop)

universe u w

namespace Stacks.AlgebraicGeometry.ProjTripleUnitSection

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory

variable {σ : Type w} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] {d : ℕ} {Y : Scheme.{u}} {L : Y.Modules}
  [Stacks.Ample.IsInvertibleModule Y L]

omit [Stacks.Ample.IsInvertibleModule Y L] in
/-- The unit section is a right unit for the product of global sections of the tensor powers. -/
theorem mulSections_unitGlobal_right {n : ℕ} (x : Γ(natTensorPow L n, ⊤)) :
    mulSections L x (unitGlobal L) = x := by
  conv_lhs => rw [← globalSection_secOf L x]
  refine (mulSections_globalSection L (secOf L x) (unitSec L)).trans ?_
  rw [mul_unitSec_right]
  exact globalSection_secOf L x

/-- `ψ(1)` restricts to the unit section over the nonvanishing open of any `ψ(f)`, `f ∈ A_d`. -/
theorem resTop_toFun_zero (ψ : VeroneseSections 𝒜 d L) (a : 𝒜 (0 * d)) (ha : (a : A) = 1)
    (f : 𝒜 d) :
    resTop (natTensorPow L 0) (ψ.toFun 0 a) (nonvanishingOpen Y L (psiSection 𝒜 ψ f))
      = resTop (natTensorPow L 0) (unitGlobal L)
          (nonvanishingOpen Y L (psiSection 𝒜 ψ f)) := by
  set W := nonvanishingOpen Y L (psiSection 𝒜 ψ f) with hWdef
  have h2 := congrArg
    (fun z => (natTensorPow L 0).presheaf.map (homOfLE (le_top : W ≤ ⊤)).op z)
    (divUnit_resTop_top (ψ.toFun 0 a))
  simp only at h2
  rw [Stacks.TensorPowerTrivialize.res_resTop,
    Stacks.TensorPowerTrivialize.map_smul_resTop] at h2
  have hf1 : (f : A) ∈ 𝒜 (1 * d) := by simp
  have hmul := ψ.map_mul 1 0 ⟨(f : A), hf1⟩ a ⟨(f : A), hf1⟩ (by rw [ha, mul_one])
  have h3 := resTop_mulSections_smul_right L (ψ.toFun 1 ⟨(f : A), hf1⟩) h2
  rw [← hmul, mulSections_unitGlobal_right] at h3
  have hpow : ψ.toFun 1 ⟨(f : A), hf1⟩ = ψ.pow f.2 1 :=
    ψ.toFun_eq_pow f.2 1 _ (pow_one _).symm
  rw [hpow] at h3
  have hone := eq_of_smul_restrict_eq (natTensorPow L 1) (ψ.pow f.2 1)
    (nonvanishingOpen_psiSection 𝒜 ψ f).le (by rw [one_smul]) h3
  rw [h2, ← hone, one_smul]

/-- The unit axiom of a graded ring map holds for every `ψ` satisfying the generation condition:
the degree-zero value of `ψ` at `1` is the unit section of `L^{⊗ 0} = 𝒪_Y`. -/
theorem toFun_zero_eq_unitGlobal (ψ : VeroneseSections 𝒜 d L)
    (hgen : ⨆ f : 𝒜 d, nonvanishingOpen Y L (psiSection 𝒜 ψ f) = ⊤)
    (a : 𝒜 (0 * d)) (ha : (a : A) = 1) :
    ψ.toFun 0 a = unitGlobal L := by
  refine sub_eq_zero.mp (Stacks.Algebraization.eq_zero_of_affine_cover _
    (fun f : 𝒜 d => nonvanishingOpen Y L (psiSection 𝒜 ψ f)) hgen fun B f hBV hBU => ?_)
  have e1 := fun x : Γ(natTensorPow L 0, ⊤) =>
    Stacks.TensorPowerTrivialize.res_resTop (natTensorPow L 0) x (homOfLE hBU)
  have e3 : ∀ x : Γ(natTensorPow L 0, ⊤),
      (natTensorPow L 0).val.map (homOfLE hBV).op x
        = resTop (natTensorPow L 0) x (B : Y.Opens) := fun _ => rfl
  rw [e3, ← resTopHom_apply, map_sub]
  refine sub_eq_zero_of_eq ?_
  rw [resTopHom_apply, resTopHom_apply, ← e1, ← e1, resTop_toFun_zero 𝒜 ψ a ha f]

/-! ### The unit axiom and the degree-zero ring map of a bundled triple -/

namespace Triple

open Stacks.AlgebraicGeometry.ProjTripleClassifying (Triple)

variable {𝒜}

/-- The unit axiom for a bundled triple: the degree-zero value of `ψ` at `1` is the unit section
of `L^{⊗ 0}`. -/
theorem psi_zero_eq_unitGlobal (t : Triple 𝒜 Y) (a : 𝒜 (0 * t.deg)) (ha : (a : A) = 1) :
    haveI := t.isInvertible; t.psi.toFun 0 a = unitGlobal t.module :=
  have := t.isInvertible
  toFun_zero_eq_unitGlobal 𝒜 t.psi t.generated a ha

/-- The ring map `A_0 ⟶ Γ(Y, 𝒪_Y)` of a triple. -/
def degreeZeroHom (t : Triple 𝒜 Y) : (𝒜 0) →+* Γ(Y, ⊤) :=
  haveI := t.isInvertible
  ProjTripleStructureMorphism.degreeZeroHom 𝒜 t.psi (psi_zero_eq_unitGlobal t)

end Triple

end Stacks.AlgebraicGeometry.ProjTripleUnitSection

end
