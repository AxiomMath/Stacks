module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import Mathlib.RingTheory.GradedAlgebra.Basic
public import StacksFrontier.AlgebraicGeometry.GradedSectionRing.Commutativity
public import StacksFrontier.AlgebraicGeometry.GradedSectionRing.PowerSystemComparison

/-!
# Triples over a scheme, and when two of them are equivalent

Let `S` be a graded ring. A *triple* over a scheme `T` consists of an integer `d ≥ 1`, an
invertible `𝒪_T`-module `L`, and a graded ring homomorphism `ψ : S^{(d)} → Γ_*(T, L)` such
that `L` is generated by the global sections `ψ(f)`, `f ∈ S_d`. Two triples with the *same*
`d` are strictly equivalent when an isomorphism `L ≅ L'` carries `ψ` to `ψ'`; two triples with
possibly different integers `d` and `d'` are *equivalent* when an isomorphism
`β : L^{⊗ d'} ≅ (L')^{⊗ d}` carries `ψ|_{S^{(dd')}}` to `ψ'|_{S^{(dd')}}`.

This file defines triples and the agreement condition on a pair of weights, and proves the
implications between the first three of the four equivalent conditions of
[Stacks, Tag 01NB]: the condition at the least common multiple of `d` and `d'` implies the
condition at `dd'`, which implies the condition at some positive common multiple. Both come
from one statement, `Stacks.AlgebraicGeometry.ProjTriples.Agree.mul`: the agreement condition
at a pair of weights `(a, a')` implies it at `(ak, a'k)`, with the `k`-th tensor power of `β`
as the new isomorphism.

Everything is stated for an invertible sheaf of modules on a ringed site, which specializes to
a scheme `T` by taking `O := T.presheaf` and `hO := T.ringCatSheaf.2`.

## Main definitions

* `Stacks.AlgebraicGeometry.ProjTriples.Triple`: a triple `(d, L, ψ)`.
* `Stacks.AlgebraicGeometry.ProjTriples.Agree`: given weights `a`, `a'` and an isomorphism
  `β : L^{⊗ a} ≅ (L')^{⊗ a'}`, the condition that `β ∘ ψ|_{S^{(n)}}` and `ψ'|_{S^{(n)}}`
  agree, where `n = ad = a'd'`.
* `Stacks.AlgebraicGeometry.ProjTriples.EquivalentAtLcm`,
  `Stacks.AlgebraicGeometry.ProjTriples.Equivalent` and
  `Stacks.AlgebraicGeometry.ProjTriples.EquivalentAtSome`: clauses (1), (2) and (3) of
  [Stacks, Tag 01NB].

## Main results

* `Stacks.AlgebraicGeometry.ProjTriples.Agree.mul`: **agreement at `(a, a')` implies
  agreement at `(ak, a'k)`.** This is the source's "restricting to more divisible degrees and
  powers of invertible sheaves".
* `Stacks.AlgebraicGeometry.ProjTriples.Agree.refl` and
  `Stacks.AlgebraicGeometry.ProjTriples.Equivalent.refl`: a triple agrees with itself at every
  weight, so equivalence of triples is reflexive.
* `Stacks.AlgebraicGeometry.ProjTriples.equivalent_of_equivalentAtLcm`: clause (1) implies
  clause (2).
* `Stacks.AlgebraicGeometry.ProjTriples.equivalentAtSome_of_equivalent`: clause (2) implies
  clause (3).
* `Stacks.AlgebraicGeometry.ProjTriples.equivalentAtSome_of_equivalentAtLcm`: clause (1)
  implies clause (3).

## Implementation notes

The homogeneous components of `ψ` are carried as the family of additive maps
`S_{dn} → Γ(T, L^{⊗ n})`, which is what a graded ring homomorphism out of the Veronese
subring `S^{(d)}` amounts to: the degree-`n` part of `S^{(d)}` is `S_{dn}`, and the degree-`n`
part of `Γ_*(T, L)` is `Γ(T, L^{⊗ n})`. Multiplicativity is `comp_mul`, and the degree-zero
unit is `comp_one`; global sections are taken as morphisms out of the tensor unit, as in
`StacksFrontier.AlgebraicGeometry.GradedSectionRing.Ring`.

The degree is written `d * n` rather than `n * d` so that `d * 0` reduces to `0` and
`d * (n + 1)` reduces to `d * n + d`; the same convention makes
`Stacks.Monoidal.PowerSystem.veronese` free of transport along equalities of exponents.

The restriction `ψ|_{S^{(n)}}` of `ψ` to the Veronese subring at a multiple `n = ad` of `d`
takes values in `Γ_*(T, L^{⊗ a})`, whose degree-`m` part is `Γ(T, L^{⊗ am})`; it is therefore
the subfamily `m ↦ ψ_{am}` of the components of `ψ`, which is how `Agree` reads it. The
isomorphism `β` acts on it through the tensor powers
`β^{⊗ m} : L^{⊗ am} ≅ (L')^{⊗ a'm}`, which are the comparison isomorphisms
`Stacks.Monoidal.PowerSystem.compare` of the two Veronese systems.

## References

* [Stacks Project, Tag 01NB](https://stacks.math.columbia.edu/tag/01NB)
* [Stacks Project, Tag 01CV](https://stacks.math.columbia.edu/tag/01CV)
-/

@[expose] public noncomputable section

open CategoryTheory MonoidalCategory Opposite
open Stacks.Monoidal

namespace Stacks.AlgebraicGeometry.ProjTriples

universe v u w

attribute [local instance] Stacks.SheafOfModules.monoidalCategory
  Stacks.SheafOfModules.braidedCategory Stacks.SheafOfModules.symmetricCategory

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  (O : Cᵒᵖ ⥤ CommRingCat.{w})
  (hO : Presheaf.IsSheaf J (Stacks.SheafOfModules.TensorSheafification.structureRingPresheaf O))
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasWeakSheafify J AddCommGrpCat.{w}]

/-- The non-negative tensor powers of an invertible sheaf of modules, as a power system, with
the invertibility taken as an explicit argument. -/
def tensorPowerSystemOf
    {L : SheafOfModules.{w} (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO)}
    (hL : _root_.AlgebraicGeometry.SheafOfModules.IsInvertible O hO L) :
    PowerSystem
      (SheafOfModules.{w}
        (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO)) :=
  @Stacks.SheafOfModules.Invertible.tensorPowerSystem _ _ _ O hO _ _ L hL

variable {A : Type w} [CommRing A] {σ : Type*} [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- A **triple** over `T` for the graded ring `S`: an integer `d ≥ 1`, an invertible
`𝒪_T`-module `L`, and a graded ring homomorphism `ψ : S^{(d)} → Γ_*(T, L)` such that `L` is
generated by the global sections `ψ(f)` with `f ∈ S_d`. The homomorphism is carried by its
homogeneous components `S_{dn} → Γ(T, L^{⊗ n})`. -/
structure Triple where
  /-- The integer `d ≥ 1` of the triple. -/
  deg : ℕ
  /-- The integer `d` is positive. -/
  deg_pos : 0 < deg
  /-- The invertible `𝒪_T`-module `L` of the triple. -/
  sheaf : SheafOfModules.{w} (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO)
  /-- `L` is invertible. -/
  invertible : _root_.AlgebraicGeometry.SheafOfModules.IsInvertible O hO sheaf
  /-- The degree-`n` homogeneous component `S_{dn} → Γ(T, L^{⊗ n})` of `ψ`. -/
  comp : ∀ n : ℕ, 𝒜 (deg * n) →+
    (𝟙_ (SheafOfModules.{w} (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO)) ⟶
      (tensorPowerSystemOf O hO invertible).obj n)
  /-- `ψ` sends `1` to the unit section. -/
  comp_one : comp 0 ⟨1, SetLike.one_mem_graded 𝒜⟩ = (tensorPowerSystemOf O hO invertible).sectionOne
  /-- `ψ` is multiplicative. -/
  comp_mul : ∀ (n m : ℕ) (x : 𝒜 (deg * n)) (y : 𝒜 (deg * m))
    (h : (x : A) * (y : A) ∈ 𝒜 (deg * (n + m))),
    comp (n + m) ⟨(x : A) * (y : A), h⟩ =
      (tensorPowerSystemOf O hO invertible).sectionMul (comp n x) (comp m y)
  /-- `L` is generated by the global sections `ψ(f)` with `f` of degree `d`. -/
  generates : Epi (sheaf.freeHomEquiv.symm fun f : 𝒜 (deg * 1) =>
    SheafOfModules.unitHomEquiv _ (comp 1 f ≫
      (@Stacks.SheafOfModules.Invertible.tensorPowerOneIso _ _ _ O hO _ _ sheaf invertible).hom))

namespace Triple

variable {O hO 𝒜}

/-- The system of tensor powers of the invertible module of a triple. -/
abbrev sys (t : Triple O hO 𝒜) :
    PowerSystem
      (SheafOfModules.{w}
        (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO)) :=
  tensorPowerSystemOf O hO t.invertible

/-- The system of tensor powers of `L^{⊗ a}`, with `(L^{⊗ a})^{⊗ m}` presented as
`L^{⊗ am}`. -/
abbrev pow (t : Triple O hO 𝒜) (a : ℕ) :
    PowerSystem
      (SheafOfModules.{w}
        (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO)) :=
  t.sys.veronese a

/-- The homogeneous components of `ψ` are compatible with transport along an equality of
degrees. -/
theorem comp_eqToHom (t : Triple O hO 𝒜) {n n' : ℕ} (e : n = n') (f : A)
    (hf : f ∈ 𝒜 (t.deg * n)) (hf' : f ∈ 𝒜 (t.deg * n')) :
    t.comp n ⟨f, hf⟩ ≫ eqToHom (congrArg t.sys.obj e) = t.comp n' ⟨f, hf'⟩ := by
  subst e
  simp

end Triple

variable {O hO 𝒜}

/-- Given weights `a` and `a'` and an isomorphism `β : L^{⊗ a} ≅ (L')^{⊗ a'}`, the condition
that `β ∘ ψ|_{S^{(n)}}` and `ψ'|_{S^{(n)}}` agree as graded ring maps
`S^{(n)} → Γ_*(T, (L')^{⊗ a'})`, where `n = ad = a'd'`: in degree `m` it says that `β^{⊗ m}`
carries `ψ_{am}(f)` to `ψ'_{a'm}(f)` for every homogeneous `f` of degree `mn`. -/
def Agree (t t' : Triple O hO 𝒜) (a a' : ℕ) (β : t.sys.obj a ≅ t'.sys.obj a') : Prop :=
  ∀ (m : ℕ) (f : A) (hf : f ∈ 𝒜 (t.deg * (a * m))) (hf' : f ∈ 𝒜 (t'.deg * (a' * m))),
    t.comp (a * m) ⟨f, hf⟩ ≫ (PowerSystem.compare (t.pow a) (t'.pow a') β m).hom
      = t'.comp (a' * m) ⟨f, hf'⟩

/-- **Clause (1) of Tag 01NB.** With `n = lcm(d, d')` written as `n = ad = a'd'`, there is an
isomorphism `β : L^{⊗ a} ≅ (L')^{⊗ a'}` such that `β ∘ ψ|_{S^{(n)}}` and `ψ'|_{S^{(n)}}`
agree. -/
def EquivalentAtLcm (t t' : Triple O hO 𝒜) : Prop :=
  ∃ β : t.sys.obj (Nat.lcm t.deg t'.deg / t.deg) ≅
      t'.sys.obj (Nat.lcm t.deg t'.deg / t'.deg),
    Agree t t' _ _ β

/-- **Clause (2) of Tag 01NB:** the two triples are *equivalent*, that is, there is an
isomorphism `β : L^{⊗ d'} ≅ (L')^{⊗ d}` such that `β ∘ ψ|_{S^{(dd')}}` and `ψ'|_{S^{(dd')}}`
agree. -/
def Equivalent (t t' : Triple O hO 𝒜) : Prop :=
  ∃ β : t.sys.obj t'.deg ≅ t'.sys.obj t.deg, Agree t t' t'.deg t.deg β

/-- **Clause (3) of Tag 01NB.** For some positive integer `n = ad = a'd'` there is an
isomorphism `β : L^{⊗ a} ≅ (L')^{⊗ a'}` such that `β ∘ ψ|_{S^{(n)}}` and `ψ'|_{S^{(n)}}`
agree. -/
def EquivalentAtSome (t t' : Triple O hO 𝒜) : Prop :=
  ∃ (n a a' : ℕ) (_ : 0 < n) (_ : a * t.deg = n) (_ : a' * t'.deg = n)
    (β : t.sys.obj a ≅ t'.sys.obj a'), Agree t t' a a' β

/-- **Agreement at `(a, a')` implies agreement at `(ak, a'k)`**, with the `k`-th tensor power
of `β` as the new isomorphism. This is the source's passage to more divisible degrees and
higher powers of the invertible sheaves. -/
theorem Agree.mul {t t' : Triple O hO 𝒜} {a a' : ℕ} {β : t.sys.obj a ≅ t'.sys.obj a'}
    (h : Agree t t' a a' β) (k : ℕ) :
    Agree t t' (a * k) (a' * k) (PowerSystem.compare (t.pow a) (t'.pow a') β k) := by
  intro m f hf hf'
  have e : a * k * m = a * (k * m) := mul_assoc a k m
  have e' : a' * (k * m) = a' * k * m := (mul_assoc a' k m).symm
  have hfa : f ∈ 𝒜 (t.deg * (a * (k * m))) := by rwa [← e]
  have hfa' : f ∈ 𝒜 (t'.deg * (a' * (k * m))) := by rwa [e']
  rw [PowerSystem.compare_veronese_veronese, ← Category.assoc,
    t.comp_eqToHom e f hf hfa, ← Category.assoc, h (k * m) f hfa hfa',
    t'.comp_eqToHom e' f hfa' hf']

/-- **A triple agrees with itself at every weight**, along the identity isomorphism. -/
theorem Agree.refl (t : Triple O hO 𝒜) (a : ℕ) :
    Agree t t a a (Iso.refl (t.sys.obj a)) := by
  intro m f hf hf'
  rw [show (PowerSystem.compare (t.pow a) (t.pow a) (Iso.refl (t.sys.obj a)) m).hom
      = 𝟙 _ from by rw [PowerSystem.compare_refl]; rfl]
  simp

/-- **Equivalence of triples is reflexive.** -/
theorem Equivalent.refl (t : Triple O hO 𝒜) : Equivalent t t :=
  ⟨Iso.refl _, Agree.refl t t.deg⟩

/-- Transport of the existence of an agreeing isomorphism along equalities of the weights. -/
theorem exists_agree_congr {t t' : Triple O hO 𝒜} {a a' b b' : ℕ} (e : a = b) (e' : a' = b')
    (h : ∃ β : t.sys.obj a ≅ t'.sys.obj a', Agree t t' a a' β) :
    ∃ β : t.sys.obj b ≅ t'.sys.obj b', Agree t t' b b' β := by
  subst e e'
  exact h

/-- The weight `lcm(d, d') / d` times `gcd(d, d')` is `d'`. -/
theorem lcm_div_mul_gcd_left (d d' : ℕ) (hd : 0 < d) :
    Nat.lcm d d' / d * Nat.gcd d d' = d' := by
  refine Nat.eq_of_mul_eq_mul_right hd ?_
  calc Nat.lcm d d' / d * Nat.gcd d d' * d
      = Nat.lcm d d' / d * d * Nat.gcd d d' := by ring
    _ = Nat.gcd d d' * Nat.lcm d d' := by
      rw [Nat.div_mul_cancel (Nat.dvd_lcm_left d d'), mul_comm]
    _ = d * d' := Nat.gcd_mul_lcm d d'
    _ = d' * d := mul_comm d d'

/-- The weight `lcm(d, d') / d'` times `gcd(d, d')` is `d`. -/
theorem lcm_div_mul_gcd_right (d d' : ℕ) (hd' : 0 < d') :
    Nat.lcm d d' / d' * Nat.gcd d d' = d := by
  rw [Nat.lcm_comm, Nat.gcd_comm]
  exact lcm_div_mul_gcd_left d' d hd'

/-- **Tag 01NB, (1) implies (2).** If the agreement condition holds at `n = lcm(d, d')`, then
the two triples are equivalent: tensor the isomorphism with itself `gcd(d, d')` times. -/
theorem equivalent_of_equivalentAtLcm (t t' : Triple O hO 𝒜) (h : EquivalentAtLcm t t') :
    Equivalent t t' := by
  obtain ⟨β, hβ⟩ := h
  exact exists_agree_congr
    (lcm_div_mul_gcd_left t.deg t'.deg t.deg_pos)
    (lcm_div_mul_gcd_right t.deg t'.deg t'.deg_pos)
    ⟨_, hβ.mul (Nat.gcd t.deg t'.deg)⟩

/-- **Tag 01NB, (2) implies (3).** Equivalent triples satisfy the agreement condition at some
positive common multiple of `d` and `d'`, namely at `dd'`. -/
theorem equivalentAtSome_of_equivalent (t t' : Triple O hO 𝒜) (h : Equivalent t t') :
    EquivalentAtSome t t' := by
  obtain ⟨β, hβ⟩ := h
  exact ⟨t.deg * t'.deg, t'.deg, t.deg, Nat.mul_pos t.deg_pos t'.deg_pos,
    mul_comm t'.deg t.deg, rfl, β, hβ⟩

/-- **Tag 01NB, (1) implies (3).** The agreement condition at `n = lcm(d, d')` is in
particular the agreement condition at some positive common multiple. -/
theorem equivalentAtSome_of_equivalentAtLcm (t t' : Triple O hO 𝒜) (h : EquivalentAtLcm t t') :
    EquivalentAtSome t t' := by
  obtain ⟨β, hβ⟩ := h
  exact ⟨Nat.lcm t.deg t'.deg, _, _, Nat.lcm_pos t.deg_pos t'.deg_pos,
    Nat.div_mul_cancel (Nat.dvd_lcm_left t.deg t'.deg),
    Nat.div_mul_cancel (Nat.dvd_lcm_right t.deg t'.deg), β, hβ⟩

end Stacks.AlgebraicGeometry.ProjTriples

end
