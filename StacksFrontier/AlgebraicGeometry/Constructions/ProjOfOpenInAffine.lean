module

public import Mathlib.AlgebraicGeometry.Morphisms.OpenImmersion
public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Subsemiring
public import Mathlib.RingTheory.GradedAlgebra.HomogeneousLocalization
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.Spectrum.Prime.Basic
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Blowup.RelativeProj

/-!
# An open subscheme of an affine scheme as a projective spectrum

Let `A` be a commutative ring and let `U` be an open subscheme of `Spec A`. Call `f : A`
*admissible* for `U` when its basic open `D(f)` is contained in `U`, and let `R` be the subalgebra
of the one-variable polynomial ring `A[T]` generated by the constants together with all monomials
`f Tⁿ` with `f` admissible. Grading `R` by polynomial degree makes it a graded ring whose
degree-zero part is `A`, and this file constructs an isomorphism of schemes between `Proj R` and
`U`. It is compatible with the maps to `Spec A`: the canonical morphism `Proj R → Spec R₀ = Spec A`
agrees with the open immersion of `U`.

The isomorphism is produced by exhibiting the canonical morphism `Proj R → Spec A` as an open
immersion with image `U`. Its restriction to the standard open of `f T`, for `f` admissible, is the
map of spectra induced by the localization `A → A_f`, because the degree-zero localization of `R`
away from `f T` is `A_f`; these standard opens cover `Proj R`, which gives both the open-immersion
property and the computation of the image.

## Main definitions

* `AlgebraicGeometry.openProjIdeal`: the ideal of coefficients admissible for `U`.
* `AlgebraicGeometry.openProjAlgebra`: the subalgebra `R` of `A[T]`.
* `AlgebraicGeometry.openProjGrading`: the grading of `R` by polynomial degree.
* `AlgebraicGeometry.openProjGradedRing`: the graded-ring structure carried by that grading.
* `AlgebraicGeometry.openProjDegreeZeroEquiv`: the identification of the degree-zero part of `R`
  with `A`.
* `AlgebraicGeometry.openProjStructureMap`: the canonical morphism `Proj R → Spec A`.
* `AlgebraicGeometry.projOpenIso`: the isomorphism `Proj R ≅ U`.

## Main results

* `AlgebraicGeometry.openProjGrading_isInternal`: the grading of `R` is an internal direct sum.
* `AlgebraicGeometry.openProjDegreeZeroEquiv_apply`: the degree-zero identification sends a
  coefficient to its image in `R`.
* `AlgebraicGeometry.openProjStructureMap_base_mem`: the prime of `Spec A` under a point of
  `Proj R`, described by membership of coefficients.
* `AlgebraicGeometry.openProjStructureMap_injective`: the canonical morphism is injective.
* `AlgebraicGeometry.openProjStructureMap_isOpenImmersion`: the canonical morphism is an open
  immersion.
* `AlgebraicGeometry.openProjStructureMap_range`: its image is `U`.
* `AlgebraicGeometry.projOpenIso_hom_comp`: under the isomorphism, the canonical morphism to
  `Spec A` is the inclusion of `U`.

## Implementation notes

The one-variable polynomial ring is represented as `MvPolynomial (Fin 1) A`, so that the grading by
total degree supplied by `MvPolynomial.homogeneousSubmodule` is available; the grading of `R` is the
comap of that grading along the inclusion of `R`.

The ideal of admissible coefficients is defined as the vanishing ideal of the complement of `U`.
Its elements are exactly those `f` with `D(f) ⊆ U`, which is the only property of it that is used.

The graded-ring structure on the grading of `R` is a `def` rather than an instance, since it
depends on the open `U`. Every statement mentioning `Proj R` therefore carries a `letI` inside its
type to supply that structure, and every proof begins by introducing the same instance.

## References

* [Stacks Project, Tag 0G5W](https://stacks.math.columbia.edu/tag/0G5W)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

namespace AlgebraicGeometry

universe u

variable {A : Type u} [CommRing A]

/-- The functions whose nonvanishing loci lie in `U`. -/
public def openProjIdeal (U : (Spec (.of A)).Opens) : Ideal A :=
  PrimeSpectrum.vanishingIdeal ((U : Set (Spec (.of A)))ᶜ)

/-- The subalgebra of `A[T]` generated by `A` and all `f Tⁿ` with `D(f) ⊆ U`. -/
@[stacks 0G5W "the graded subring"]
public noncomputable def openProjAlgebra (U : (Spec (.of A)).Opens) :
    Subalgebra A (MvPolynomial (Fin 1) A) :=
  Algebra.adjoin A {p | ∃ (n : ℕ) (f : A), f ∈ openProjIdeal U ∧
    p = MvPolynomial.monomial (Finsupp.single (0 : Fin 1) n) f}

/-- The degree-`n` piece of the indicated subalgebra, inherited from polynomial degree. -/
@[stacks 0G5W "the homogeneous components"]
public noncomputable def openProjGrading (U : (Spec (.of A)).Opens) (n : ℕ) :
    Submodule A (openProjAlgebra U) :=
  (MvPolynomial.homogeneousSubmodule (Fin 1) A n).comap
    (Subalgebra.val (openProjAlgebra U)).toLinearMap

/-- The generating set of `openProjAlgebra U` as a subsemiring: the constants together with the
admissible monomials. -/
private def openProjGeneratingSet (U : (Spec (.of A)).Opens) :
    Set (MvPolynomial (Fin 1) A) :=
  Set.range (algebraMap A (MvPolynomial (Fin 1) A)) ∪
    {p | ∃ (n : ℕ) (f : A), f ∈ openProjIdeal U ∧
      p = MvPolynomial.monomial (Finsupp.single (0 : Fin 1) n) f}

/-- Membership in `openProjAlgebra U` is membership in the subsemiring generated by the constants
and the admissible monomials. -/
private theorem openProjAlgebra_mem_iff (U : (Spec (.of A)).Opens)
    (p : MvPolynomial (Fin 1) A) :
    p ∈ openProjAlgebra U ↔ p ∈ Subsemiring.closure (openProjGeneratingSet U) := by
  constructor
  · intro hp
    change p ∈ Algebra.adjoin A _ at hp
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hp
    · intro x hx
      exact Subsemiring.subset_closure (Or.inr hx)
    · intro a
      exact Subsemiring.subset_closure (Or.inl ⟨a, rfl⟩)
    · intro x y hx hy ihx ihy
      exact (Subsemiring.closure (openProjGeneratingSet U)).add_mem ihx ihy
    · intro x y hx hy ihx ihy
      exact (Subsemiring.closure (openProjGeneratingSet U)).mul_mem ihx ihy
  · intro hp
    have hle : Subsemiring.closure (openProjGeneratingSet U) ≤
        (openProjAlgebra U).toSubsemiring := Subsemiring.closure_le.2 ?_
    · exact hle hp
    · rintro p (⟨a, rfl⟩ | ⟨n, f, hf, rfl⟩)
      · exact Subalgebra.algebraMap_mem _ _
      · exact Algebra.subset_adjoin ⟨n, f, hf, rfl⟩

/-- The monomial `f Tⁿ` is homogeneous of degree `n`. -/
private theorem openProj_monomial_mem_homogeneousSubmodule (f : A) (n : ℕ) :
    MvPolynomial.monomial (Finsupp.single (0 : Fin 1) n) f ∈
      MvPolynomial.homogeneousSubmodule (Fin 1) A n :=
  (MvPolynomial.mem_homogeneousSubmodule n _).2 (MvPolynomial.isHomogeneous_monomial f (by simp))

/-- The subalgebra `openProjAlgebra U` is generated by homogeneous elements, hence contains the
homogeneous components of each of its elements. -/
private theorem openProjAlgebra_homogeneous (U : (Spec (.of A)).Opens)
    [GradedRing (MvPolynomial.homogeneousSubmodule (Fin 1) A)] :
    DirectSum.SetLike.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin 1) A)
      (openProjAlgebra U).toSubsemiring := by
  classical
  have hgen : ∀ p ∈ openProjGeneratingSet U,
      SetLike.IsHomogeneousElem (MvPolynomial.homogeneousSubmodule (Fin 1) A) p := by
    intro p hp
    rcases hp with ⟨a, rfl⟩ | ⟨n, f, hf, rfl⟩
    · exact ⟨0, (MvPolynomial.mem_homogeneousSubmodule 0 _).2
        (MvPolynomial.isHomogeneous_C (Fin 1) a)⟩
    · exact ⟨n, openProj_monomial_mem_homogeneousSubmodule f n⟩
  intro n p hp
  show ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin 1) A) p n :
    MvPolynomial.homogeneousSubmodule (Fin 1) A n) : MvPolynomial (Fin 1) A) ∈
      openProjAlgebra U
  rw [openProjAlgebra_mem_iff]
  exact IsHomogeneous.subsemiringClosure_of_isHomogeneousElem
    (𝒜 := MvPolynomial.homogeneousSubmodule (Fin 1) A) hgen n hp

/-- The inclusion of the degree-`n` part of `openProjAlgebra U` into the degree-`n` homogeneous
polynomials. -/
private def openProjGradeToAmbient (U : (Spec (.of A)).Opens) (n : ℕ) :
    openProjGrading U n →ₗ[A] MvPolynomial.homogeneousSubmodule (Fin 1) A n where
  toFun x := ⟨x.val.val, x.property⟩
  map_add' _ _ := by apply Subtype.ext; rfl
  map_smul' _ _ := by apply Subtype.ext; rfl

/-- Summing a decomposition commutes with the inclusion of `openProjAlgebra U` into the polynomial
ring. -/
private theorem openProjGradeMap_coe (U : (Spec (.of A)).Opens) :
    (DirectSum.coeAddMonoidHom (MvPolynomial.homogeneousSubmodule (Fin 1) A)).comp
        (DirectSum.map (fun n => (openProjGradeToAmbient U n).toAddMonoidHom)) =
      (Subalgebra.val (openProjAlgebra U)).toAddMonoidHom.comp
        (DirectSum.coeAddMonoidHom (openProjGrading U)) := by
  apply DirectSum.addHom_ext
  intro n x
  simp [openProjGradeToAmbient]

/-- The homogeneous components of `openProjAlgebra U` realize it as an internal direct sum. -/
public theorem openProjGrading_isInternal (U : (Spec (.of A)).Opens) :
    DirectSum.IsInternal (openProjGrading U) := by
  classical
  let : DirectSum.Decomposition (MvPolynomial.homogeneousSubmodule (Fin 1) A) :=
    MvPolynomial.decomposition
  let : GradedRing (MvPolynomial.homogeneousSubmodule (Fin 1) A) :=
    MvPolynomial.gradedAlgebra
  constructor
  · intro x y hxy
    have hpoly :
        DirectSum.coeAddMonoidHom (MvPolynomial.homogeneousSubmodule (Fin 1) A)
          (DirectSum.map (fun n => (openProjGradeToAmbient U n).toAddMonoidHom) x) =
        DirectSum.coeAddMonoidHom (MvPolynomial.homogeneousSubmodule (Fin 1) A)
          (DirectSum.map (fun n => (openProjGradeToAmbient U n).toAddMonoidHom) y) := by
      have hx := congrArg (fun f : (DirectSum ℕ (fun n => openProjGrading U n) →+
          MvPolynomial (Fin 1) A) => f x) (openProjGradeMap_coe U)
      have hy := congrArg (fun f : (DirectSum ℕ (fun n => openProjGrading U n) →+
          MvPolynomial (Fin 1) A) => f y) (openProjGradeMap_coe U)
      calc
        _ = (Subalgebra.val (openProjAlgebra U)).toAddMonoidHom
            (DirectSum.coeAddMonoidHom (openProjGrading U) x) := by
              simpa only [AddMonoidHom.comp_apply] using hx
        _ = (Subalgebra.val (openProjAlgebra U)).toAddMonoidHom
            (DirectSum.coeAddMonoidHom (openProjGrading U) y) := by
              exact congrArg (fun z : openProjAlgebra U => (z : MvPolynomial (Fin 1) A)) hxy
        _ = _ := by simpa only [AddMonoidHom.comp_apply] using hy.symm
    have hsum : DirectSum.map (fun n => (openProjGradeToAmbient U n).toAddMonoidHom) x =
        DirectSum.map (fun n => (openProjGradeToAmbient U n).toAddMonoidHom) y := by
      exact (DirectSum.Decomposition.isInternal
        (MvPolynomial.homogeneousSubmodule (Fin 1) A)).injective hpoly
    have hmaps : ∀ n, Function.Injective (openProjGradeToAmbient U n) := by
      intro n a b hab
      apply Subtype.ext
      apply Subtype.ext
      exact congrArg (fun z : MvPolynomial.homogeneousSubmodule (Fin 1) A n =>
        (z : MvPolynomial (Fin 1) A)) hab
    apply DirectSum.ext
    intro n
    exact hmaps n ((DirectSum.map_eq_iff
      (fun n => (openProjGradeToAmbient U n).toAddMonoidHom) x y).mp hsum n)
  · intro q
    let d := DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin 1) A)
      (q : MvPolynomial (Fin 1) A)
    let z : DirectSum ℕ (fun n => openProjGrading U n) :=
      ∑ n ∈ d.support, DirectSum.of _ n
        ⟨⟨(d n : MvPolynomial (Fin 1) A), by
            simpa [d] using openProjAlgebra_homogeneous U n q.property⟩,
          (d n).property⟩
    refine ⟨z, ?_⟩
    apply Subtype.ext
    dsimp [z]
    simp only [map_sum, DirectSum.coeAddMonoidHom_of]
    simpa [d] using (DirectSum.sum_support_decompose
      (MvPolynomial.homogeneousSubmodule (Fin 1) A) (q : MvPolynomial (Fin 1) A))

/-- The polynomial-degree decomposition restricts to the algebra of the open. -/
@[stacks 0G5W "the grading", instance_reducible]
public noncomputable def openProjGradedRing (U : (Spec (.of A)).Opens) :
    GradedRing (openProjGrading U) := by
  classical
  letI : SetLike.GradedMonoid (openProjGrading U) := {
    one_mem := by
      change (1 : MvPolynomial (Fin 1) A) ∈
        MvPolynomial.homogeneousSubmodule (Fin 1) A 0
      rw [MvPolynomial.homogeneousSubmodule_zero]
      exact (Submodule.mem_one).2 ⟨1, by simp⟩
    mul_mem := by
      intro i j x y hx hy
      change ((x * y : openProjAlgebra U) : MvPolynomial (Fin 1) A) ∈
        MvPolynomial.homogeneousSubmodule (Fin 1) A (i + j)
      have hx' : (x : MvPolynomial (Fin 1) A) ∈
          MvPolynomial.homogeneousSubmodule (Fin 1) A i := hx
      have hy' : (y : MvPolynomial (Fin 1) A) ∈
          MvPolynomial.homogeneousSubmodule (Fin 1) A j := hy
      exact (MvPolynomial.homogeneousSubmodule_mul i j)
        (Submodule.mul_mem_mul hx' hy')
    }
  letI : DirectSum.Decomposition (openProjGrading U) :=
    DirectSum.IsInternal.chooseDecomposition (openProjGrading U)
      (openProjGrading_isInternal U)
  exact { toGradedMonoid := inferInstance, toDecomposition := inferInstance }

/-- The canonical identification of the degree-zero part with the coefficient ring. -/
@[stacks 0G5W "the degree-zero ring"]
public noncomputable def openProjDegreeZeroEquiv (U : (Spec (.of A)).Opens) :
    letI := openProjGradedRing U
    A ≃+* openProjGrading U 0 := by
  classical
  letI := openProjGradedRing U
  let f : A →+* openProjGrading U 0 :=
    { toFun := fun a =>
        ⟨algebraMap A (openProjAlgebra U) a, by
          change (algebraMap A (openProjAlgebra U) a : MvPolynomial (Fin 1) A) ∈
            MvPolynomial.homogeneousSubmodule (Fin 1) A 0
          rw [MvPolynomial.homogeneousSubmodule_zero]
          exact (Submodule.mem_one).2 ⟨a, rfl⟩⟩
      map_one' := by apply Subtype.ext; exact map_one (algebraMap A (openProjAlgebra U))
      map_mul' a b := by
        apply Subtype.ext
        exact map_mul (algebraMap A (openProjAlgebra U)) a b
      map_zero' := by apply Subtype.ext; exact map_zero (algebraMap A (openProjAlgebra U))
      map_add' a b := by
        apply Subtype.ext
        exact map_add (algebraMap A (openProjAlgebra U)) a b }
  exact RingEquiv.ofBijective f ⟨
    (fun a b h => by
      apply MvPolynomial.C_injective (Fin 1) A
      change (algebraMap A (openProjAlgebra U) a : MvPolynomial (Fin 1) A) =
        algebraMap A (openProjAlgebra U) b
      exact congrArg (fun z : openProjAlgebra U => (z : MvPolynomial (Fin 1) A))
        (congrArg Subtype.val h)),
    (fun x => by
      have hx : (x.1 : openProjAlgebra U).val ∈
          MvPolynomial.homogeneousSubmodule (Fin 1) A 0 := x.2
      rw [MvPolynomial.homogeneousSubmodule_zero] at hx
      obtain ⟨a, ha⟩ := (Submodule.mem_one).mp hx
      refine ⟨a, ?_⟩
      apply Subtype.ext
      change (algebraMap A (openProjAlgebra U) a) = x.1
      apply Subtype.ext
      change MvPolynomial.C a = (x.1 : MvPolynomial (Fin 1) A)
      simpa [MvPolynomial.algebraMap_eq] using ha)⟩

/-- The degree-zero identification sends a coefficient to its image in the subalgebra. -/
@[stacks 0G5W "the canonical degree-zero identification"]
public theorem openProjDegreeZeroEquiv_apply (U : (Spec (.of A)).Opens) (a : A) :
    letI := openProjGradedRing U
    ((openProjDegreeZeroEquiv U a : openProjGrading U 0) : openProjAlgebra U) =
      algebraMap A (openProjAlgebra U) a := by
  classical
  dsimp [openProjDegreeZeroEquiv, RingEquiv.ofBijective]
  rfl

/-- A polynomial in one variable that is homogeneous of degree `n` is the monomial of its
degree-`n` coefficient. -/
public theorem openProj_homogeneous_shape (p : MvPolynomial (Fin 1) A) (n : ℕ)
    (hp : p.IsHomogeneous n) :
    p = MvPolynomial.monomial (Finsupp.single (0 : Fin 1) n)
      (p.coeff (Finsupp.single 0 n)) := by
  classical
  refine MvPolynomial.ext _ _ fun e => ?_
  rcases eq_or_ne e (Finsupp.single (0 : Fin 1) n) with rfl | he
  · simp
  · have hz : p.coeff e = 0 := by
      by_contra hc
      refine he ?_
      have h0 : e 0 = n := by
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using hp hc
      refine Finsupp.ext fun i => ?_
      obtain rfl : i = 0 := Fin.eq_zero i
      simp [h0]
    simp [hz, MvPolynomial.coeff_monomial, Ne.symm he]
/-- The monomial `f T` of the one-variable polynomial ring. -/
private noncomputable def openProjChartElement (f : A) : MvPolynomial (Fin 1) A :=
  MvPolynomial.monomial (Finsupp.single (0 : Fin 1) 1) f

/-- The element `f T` of `openProjAlgebra U`, for an admissible coefficient `f`. Its standard open
is the chart at `f`. -/
private noncomputable def openProjChartGen (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) : openProjAlgebra U :=
  ⟨openProjChartElement f, Algebra.subset_adjoin ⟨1, f, hf, rfl⟩⟩

/-- The element `f T` is homogeneous of degree one. -/
private theorem openProjChartGen_mem (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    openProjChartGen U f hf ∈ openProjGrading U 1 :=
  openProj_monomial_mem_homogeneousSubmodule f 1

/-- The ring map from `A` to the degree-zero localization of `openProjAlgebra U` away from `f T`,
through the degree-zero part. -/
private noncomputable def openProjChartCoeffMap (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    A →+* HomogeneousLocalization.Away (openProjGrading U) (openProjChartGen U f hf) := by
  letI := openProjGradedRing U
  exact (HomogeneousLocalization.fromZeroRingHom (openProjGrading U)
      (Submonoid.powers (openProjChartGen U f hf))).comp
    (openProjDegreeZeroEquiv U).toRingHom

/-- Evaluation of `T` at `1 / f`, as a ring map from the degree-zero localization away from `f T`
to the localization `A_f`. -/
private noncomputable def openProjChartEval (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    HomogeneousLocalization.Away (openProjGrading U) (openProjChartGen U f hf) →+*
      Localization.Away f := by
  letI := openProjGradedRing U
  let ev : MvPolynomial (Fin 1) A →+* Localization.Away f :=
    MvPolynomial.eval₂Hom (algebraMap A (Localization.Away f))
      (fun _ => IsLocalization.Away.invSelf f)
  let evS : openProjAlgebra U →+* Localization.Away f :=
    ev.comp (Subalgebra.val (openProjAlgebra U))
  have hev : ev (openProjChartElement f) = 1 := by
    simp [ev, openProjChartElement]
  have hu : IsUnit (evS (openProjChartGen U f hf)) := by
    rw [show evS (openProjChartGen U f hf) = 1 by
      change ev (openProjChartElement f) = 1
      exact hev]
    exact isUnit_one
  let loc : Localization (Submonoid.powers (openProjChartGen U f hf)) →+*
      Localization.Away f :=
    IsLocalization.Away.lift (openProjChartGen U f hf) hu
  exact loc.comp
    (algebraMap
      (HomogeneousLocalization.Away (openProjGrading U) (openProjChartGen U f hf))
      (Localization (Submonoid.powers (openProjChartGen U f hf))))

/-- The degree-zero fraction `f T ^ 2 / (f T) ^ 2`, inverse to the image of `f` in the degree-zero
localization away from `f T`. -/
private noncomputable def openProjChartCoeffInv (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    HomogeneousLocalization.Away (openProjGrading U) (openProjChartGen U f hf) := by
  letI := openProjGradedRing U
  let p : MvPolynomial (Fin 1) A :=
    MvPolynomial.monomial (Finsupp.single (0 : Fin 1) 2) f
  let y : openProjAlgebra U :=
    ⟨p, Algebra.subset_adjoin ⟨2, f, hf, rfl⟩⟩
  exact HomogeneousLocalization.Away.mk (openProjGrading U) (openProjChartGen_mem U f hf) 2 y
    (openProj_monomial_mem_homogeneousSubmodule f 2)

/-- The fraction underlying a value of `openProjChartCoeffMap`. -/
private theorem openProjChartCoeffMap_val (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) (a : A) :
    letI := openProjGradedRing U
    (openProjChartCoeffMap U f hf a).val =
      Localization.mk ((openProjDegreeZeroEquiv U a : openProjGrading U 0) : openProjAlgebra U)
        ⟨1, by simp⟩ := rfl

/-- The fraction underlying `openProjChartCoeffInv`. -/
private theorem openProjChartCoeffInv_val (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    (openProjChartCoeffInv U f hf).val =
      Localization.mk
        (⟨MvPolynomial.monomial (Finsupp.single (0 : Fin 1) 2) f,
          Algebra.subset_adjoin ⟨2, f, hf, rfl⟩⟩ : openProjAlgebra U)
        ⟨(openProjChartGen U f hf) ^ 2,
          by rw [Submonoid.mem_powers_iff]; exact ⟨2, rfl⟩⟩ := rfl

/-- `openProjChartCoeffInv` is a two-sided inverse of the image of `f`. -/
private theorem openProjChartCoeff_mul_inv (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    openProjChartCoeffMap U f hf f * openProjChartCoeffInv U f hf = 1 := by
  let := openProjGradedRing U
  apply HomogeneousLocalization.val_injective _
  rw [HomogeneousLocalization.val_mul, openProjChartCoeffMap_val,
    openProjChartCoeffInv_val, HomogeneousLocalization.val_one,
    openProjDegreeZeroEquiv_apply]
  rw [Localization.mk_mul]
  have hnum :
      (algebraMap A (openProjAlgebra U) f) *
          (⟨MvPolynomial.monomial (Finsupp.single (0 : Fin 1) 2) f,
            Algebra.subset_adjoin ⟨2, f, hf, rfl⟩⟩ : openProjAlgebra U) =
        (openProjChartGen U f hf) ^ 2 := by
    apply Subtype.ext
    show MvPolynomial.C f * MvPolynomial.monomial (Finsupp.single (0 : Fin 1) 2) f =
      MvPolynomial.monomial (Finsupp.single (0 : Fin 1) 1) f ^ 2
    rw [← MvPolynomial.C_mul_X_pow_eq_monomial, ← MvPolynomial.C_mul_X_eq_monomial]
    ring
  rw [hnum]
  simp

/-- The image of `f` in the degree-zero localization away from `f T` is a unit. -/
private theorem openProjChartCoeff_isUnit (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    IsUnit (openProjChartCoeffMap U f hf f) := by
  let := openProjGradedRing U
  let : CommRing (HomogeneousLocalization.Away (openProjGrading U)
      (openProjChartGen U f hf)) := inferInstance
  exact isUnit_iff_exists_inv.mpr ⟨openProjChartCoeffInv U f hf,
    openProjChartCoeff_mul_inv U f hf⟩

/-- The ring map from `A_f` to the degree-zero localization away from `f T` obtained from
`openProjChartCoeffMap` by the universal property of the localization. -/
private noncomputable def openProjChartLift (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    Localization.Away f →+*
      HomogeneousLocalization.Away (openProjGrading U) (openProjChartGen U f hf) :=
  by
    letI := openProjGradedRing U
    exact IsLocalization.Away.lift f (openProjChartCoeff_isUnit U f hf)

/-- `openProjChartEval` undoes `openProjChartCoeffMap` on coefficients. -/
private theorem openProjChartEval_coeffMap (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) (a : A) :
    letI := openProjGradedRing U
    openProjChartEval U f hf (openProjChartCoeffMap U f hf a) =
      algebraMap A (Localization.Away f) a := by
  simp only [openProjChartEval, RingHom.comp_apply,
    HomogeneousLocalization.algebraMap_apply, openProjChartCoeffMap_val]
  rw [openProjDegreeZeroEquiv_apply]
  rw [show (⟨1, by simp⟩ : Submonoid.powers (openProjChartGen U f hf)) = 1 by
    apply Subtype.ext
    rfl]
  rw [Localization.mk_one_eq_algebraMap]
  simp [IsLocalization.Away.lift_eq]

/-- `openProjChartLift` extends `openProjChartCoeffMap`. -/
private theorem openProjChartLift_coeff (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) (a : A) :
    letI := openProjGradedRing U
    openProjChartLift U f hf (algebraMap A (Localization.Away f) a) =
      openProjChartCoeffMap U f hf a := by
  let := openProjGradedRing U
  simp [openProjChartLift, openProjChartCoeffMap, IsLocalization.Away.lift_eq]

/-- `openProjChartEval` is a left inverse of `openProjChartLift`. -/
private theorem openProjChartEval_lift (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    (openProjChartEval U f hf).comp (openProjChartLift U f hf) = RingHom.id _ := by
  let := openProjGradedRing U
  apply IsLocalization.ringHom_ext (Submonoid.powers f)
  ext a
  show openProjChartEval U f hf
      (openProjChartLift U f hf (algebraMap A (Localization.Away f) a)) =
    algebraMap A (Localization.Away f) a
  rw [openProjChartLift, IsLocalization.Away.lift_eq]
  exact openProjChartEval_coeffMap U f hf a

/-- Reduction of coefficients modulo `openProjIdeal U`. -/
private noncomputable def openProjQuotientMap (U : (Spec (.of A)).Opens) :
    MvPolynomial (Fin 1) A →+* MvPolynomial (Fin 1) (A ⧸ openProjIdeal U) :=
  MvPolynomial.map (Ideal.Quotient.mk (openProjIdeal U))

/-- Reducing coefficients modulo `openProjIdeal U` takes every element of `openProjAlgebra U` to a
constant, since the admissible monomials of positive degree die. -/
private theorem openProjQuotientMap_constant (U : (Spec (.of A)).Opens)
    (p : MvPolynomial (Fin 1) A) (hp : p ∈ openProjAlgebra U) :
    ∃ a : A ⧸ openProjIdeal U, openProjQuotientMap U p = MvPolynomial.C a := by
  change p ∈ Algebra.adjoin A _ at hp
  refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hp
  · intro x hx
    rcases hx with ⟨n, f, hf, rfl⟩
    refine ⟨0, ?_⟩
    simp [openProjQuotientMap, MvPolynomial.map_monomial,
      Ideal.Quotient.eq_zero_iff_mem.mpr hf]
  · intro a
    exact ⟨Ideal.Quotient.mk (openProjIdeal U) a, by
      simp [openProjQuotientMap, MvPolynomial.map_C]
    ⟩
  · intro x y hx hy ihx ihy
    obtain ⟨a, ha⟩ := ihx
    obtain ⟨b, hb⟩ := ihy
    refine ⟨a + b, ?_⟩
    simp only [openProjQuotientMap] at ha hb ⊢
    rw [map_add, ha, hb]
    simp
  · intro x y hx hy ihx ihy
    obtain ⟨a, ha⟩ := ihx
    obtain ⟨b, hb⟩ := ihy
    refine ⟨a * b, ?_⟩
    simp only [openProjQuotientMap] at ha hb ⊢
    rw [map_mul, ha, hb]
    simp

/-- The coefficients of an element of `openProjAlgebra U` in nonzero multidegree are admissible. -/
private theorem openProj_positive_coeff_mem (U : (Spec (.of A)).Opens)
    (p : MvPolynomial (Fin 1) A) (hp : p ∈ openProjAlgebra U)
    {e : Fin 1 →₀ ℕ} (he : e ≠ 0) : p.coeff e ∈ openProjIdeal U := by
  obtain ⟨a, ha⟩ := openProjQuotientMap_constant U p hp
  have hcoeff := congrArg (fun q : MvPolynomial (Fin 1) (A ⧸ openProjIdeal U) => q.coeff e) ha
  rw [openProjQuotientMap, MvPolynomial.coeff_map,
    MvPolynomial.coeff_C_of_ne_zero he] at hcoeff
  exact Ideal.Quotient.eq_zero_iff_mem.mp hcoeff

/-- The value of `openProjChartLift` on the fraction with numerator the degree-`n` coefficient of
`y` and denominator `f ^ n`. -/
private theorem openProjChartLift_mk (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) (n : ℕ)
    (y : openProjAlgebra U) (hy : y ∈ openProjGrading U n) :
    letI := openProjGradedRing U
    openProjChartLift U f hf
        (Localization.mk (y.val.coeff (Finsupp.single 0 n))
          (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f)) =
      HomogeneousLocalization.Away.mk (openProjGrading U)
        (openProjChartGen_mem U f hf) n y (by simpa using hy) := by
  let := openProjGradedRing U
  have hshape := openProj_homogeneous_shape y.val n (by
    show y.val ∈ MvPolynomial.homogeneousSubmodule (Fin 1) A n
    exact hy)
  let c := y.val.coeff (Finsupp.single 0 n)
  let z : openProjAlgebra U := ⟨
    MvPolynomial.monomial (Finsupp.single (0 : Fin 1) n) c,
    hshape ▸ y.property⟩
  have hyz : y = z := by
    apply Subtype.ext
    exact hshape
  have hlift : openProjChartLift U f hf
        (Localization.mk c
          (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f)) =
      openProjChartCoeffMap U f hf c *
        (openProjChartCoeffInv U f hf) ^ n := by
    rw [openProjChartLift]
    exact Localization.awayLift_mk (openProjChartCoeffMap U f hf) f
      c (openProjChartCoeffInv U f hf)
      (openProjChartCoeff_mul_inv U f hf) n
  rw [hlift]
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_pow,
    openProjChartCoeffMap_val, openProjChartCoeffInv_val,
    HomogeneousLocalization.Away.val_mk]
  rw [openProjDegreeZeroEquiv_apply, hyz]
  rw [Localization.mk_pow, Localization.mk_mul]
  rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  use 1
  simp only [OneMemClass.coe_one, one_mul, Submonoid.coe_mul]
  apply Subtype.ext
  show (MvPolynomial.monomial (Finsupp.single (0 : Fin 1) 1) f) ^ n *
      (MvPolynomial.C c * (MvPolynomial.monomial (Finsupp.single 0 2) f) ^ n) =
    (MvPolynomial.monomial (Finsupp.single (0 : Fin 1) 1) f ^ 2) ^ n *
      MvPolynomial.monomial (Finsupp.single 0 n) c
  simp only [← MvPolynomial.C_mul_X_pow_eq_monomial]
  ring

/-- `openProjChartLift` is surjective. -/
private theorem openProjChartLift_surjective (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    Function.Surjective (openProjChartLift U f hf) := by
  let := openProjGradedRing U
  intro x
  obtain ⟨n, y, hy, rfl⟩ :=
    HomogeneousLocalization.Away.mk_surjective (openProjGrading U)
      (openProjChartGen_mem U f hf) x
  refine ⟨Localization.mk (y.val.coeff (Finsupp.single 0 n))
    (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f), ?_⟩
  exact openProjChartLift_mk U f hf n y (by simpa using hy)

/-- `openProjChartLift` is a left inverse of `openProjChartEval`. -/
private theorem openProjChartLift_eval (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    (openProjChartLift U f hf).comp (openProjChartEval U f hf) = RingHom.id _ := by
  let := openProjGradedRing U
  apply RingHom.ext
  intro x
  obtain ⟨z, rfl⟩ := openProjChartLift_surjective U f hf x
  have h := congrArg (openProjChartLift U f hf)
    (DFunLike.congr_fun (openProjChartEval_lift U f hf) z)
  simpa only [RingHom.comp_apply, RingHom.id_apply] using h

/-- The degree-zero localization away from `f T` is the localization `A_f`. -/
private noncomputable def openProjChartRingEquiv (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    HomogeneousLocalization.Away (openProjGrading U) (openProjChartGen U f hf) ≃+*
      Localization.Away f :=
  letI := openProjGradedRing U
  RingEquiv.ofBijective (openProjChartEval U f hf) ⟨
    (fun x y h => by
      calc
        x = openProjChartLift U f hf (openProjChartEval U f hf x) :=
          (DFunLike.congr_fun (openProjChartLift_eval U f hf) x).symm
        _ = openProjChartLift U f hf (openProjChartEval U f hf y) := congrArg _ h
        _ = y := DFunLike.congr_fun (openProjChartLift_eval U f hf) y),
    (fun y => ⟨openProjChartLift U f hf y,
      DFunLike.congr_fun (openProjChartEval_lift U f hf) y⟩)⟩

/-- The canonical morphism to `Spec A`: the map to the spectrum of the degree-zero part, followed
by the identification of that part with `A`. -/
public noncomputable def openProjStructureMap (U : (Spec (.of A)).Opens) :
    letI := openProjGradedRing U
    AlgebraicGeometry.Proj (openProjGrading U) ⟶ Spec (.of A) :=
  letI := openProjGradedRing U
  Proj.toSpecZero (openProjGrading U) ≫
    Spec.map (CommRingCat.ofHom (openProjDegreeZeroEquiv U).toRingHom)

/-- The isomorphism of affine schemes induced by `openProjChartRingEquiv`. -/
private noncomputable def openProjChartSpecIso (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    Spec (.of (HomogeneousLocalization.Away (openProjGrading U)
      (openProjChartGen U f hf))) ≅ Spec (.of (Localization.Away f)) :=
  letI := openProjGradedRing U
  (Scheme.Spec.mapIso (openProjChartRingEquiv U f hf).toCommRingCatIso.op).symm

/-- On the chart at `f`, the canonical morphism is the map of spectra induced by the localization
`A → A_f`. -/
private theorem openProjStructureMap_chart (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    Proj.awayι (openProjGrading U) (openProjChartGen U f hf)
        (openProjChartGen_mem U f hf) (by decide) ≫ openProjStructureMap U =
      (openProjChartSpecIso U f hf).hom ≫
        Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away f))) := by
  let := openProjGradedRing U
  dsimp only [openProjStructureMap]
  rw [Proj.awayι_toSpecZero_assoc]
  simp only [openProjChartSpecIso, Iso.symm_hom, Scheme.Spec.mapIso_inv]
  dsimp [Scheme.Spec]
  rw [← Spec.map_comp, ← Spec.map_comp]
  rw [Spec.map_inj]
  ext a
  have hs : (openProjChartRingEquiv U f hf).symm
      (algebraMap A (Localization.Away f) a) =
        openProjChartLift U f hf (algebraMap A (Localization.Away f) a) := by
    apply (openProjChartRingEquiv U f hf).injective
    show openProjChartEval U f hf
        ((openProjChartRingEquiv U f hf).symm (algebraMap A (Localization.Away f) a)) =
      openProjChartEval U f hf
        (openProjChartLift U f hf (algebraMap A (Localization.Away f) a))
    calc
      openProjChartEval U f hf
          ((openProjChartRingEquiv U f hf).symm (algebraMap A (Localization.Away f) a)) =
          (openProjChartRingEquiv U f hf)
            ((openProjChartRingEquiv U f hf).symm (algebraMap A (Localization.Away f) a)) := rfl
      _ = algebraMap A (Localization.Away f) a :=
        (openProjChartRingEquiv U f hf).apply_symm_apply _
      _ = openProjChartEval U f hf
          (openProjChartLift U f hf (algebraMap A (Localization.Away f) a)) :=
        (DFunLike.congr_fun (openProjChartEval_lift U f hf) _).symm
  show (openProjChartCoeffMap U f hf a).val =
    ((openProjChartRingEquiv U f hf).symm
      (algebraMap A (Localization.Away f) a)).val
  exact congrArg HomogeneousLocalization.val <| calc
    openProjChartCoeffMap U f hf a =
        openProjChartLift U f hf (algebraMap A (Localization.Away f) a) :=
      (openProjChartLift_coeff U f hf a).symm
    _ = (openProjChartRingEquiv U f hf).symm (algebraMap A (Localization.Away f) a) :=
      hs.symm

/-- On the chart at `f`, the canonical morphism takes the point lying over a point `y` of
`Spec A_f` to the image of `y` under the localization map. -/
private theorem openProjStructureMap_awayι_chart (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) (y : Spec (.of (Localization.Away f))) :
    letI := openProjGradedRing U
    openProjStructureMap U
        (Proj.awayι (openProjGrading U) (openProjChartGen U f hf)
          (openProjChartGen_mem U f hf) (by decide)
          ((openProjChartSpecIso U f hf).inv y)) =
      Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away f))) y := by
  let := openProjGradedRing U
  have hc : (openProjChartSpecIso U f hf).hom
      ((openProjChartSpecIso U f hf).inv y) = y := by
    have hbase := congrArg
      (fun e : Spec (.of (Localization.Away f)) ⟶ Spec (.of (Localization.Away f)) => e.base)
      (openProjChartSpecIso U f hf).inv_hom_id
    have hbase' : (openProjChartSpecIso U f hf).inv.base ≫
        (openProjChartSpecIso U f hf).hom.base = 𝟙 _ := by
      simpa only [Scheme.Hom.comp_base, Scheme.Hom.id_base] using hbase
    have hbase'' := congrArg TopCat.Hom.hom hbase'
    rw [TopCat.hom_comp, TopCat.hom_id] at hbase''
    exact DFunLike.congr_fun hbase'' y
  have h := congrArg (fun φ => φ ((openProjChartSpecIso U f hf).inv y))
    (openProjStructureMap_chart U f hf)
  simp only [Scheme.Hom.comp_apply] at h
  rw [h, hc]

/-- Every point of the projective spectrum avoids some homogeneous element of positive degree. -/
private theorem openProj_exists_positive_chart (U : (Spec (.of A)).Opens)
    (x : letI := openProjGradedRing U; ProjectiveSpectrum.top (openProjGrading U)) :
    letI := openProjGradedRing U
    ∃ (n : ℕ) (_hn : 0 < n) (y : openProjAlgebra U)
      (_hy : y ∈ openProjGrading U n),
      y ∉ x.asHomogeneousIdeal := by
  let := openProjGradedRing U
  obtain ⟨i, z, hz⟩ :=
    (Proj.affineOpenCover (openProjGrading U)).openCover.exists_eq x
  let y : openProjAlgebra U := i.2.val
  have hy : y ∈ openProjGrading U i.1.1 := i.2.property
  refine ⟨i.1.1, i.1.2, y, hy, ?_⟩
  have hx : x ∈ (Proj.awayι (openProjGrading U) y hy i.1.2).opensRange := by
    show ∃ z' : (Proj.affineOpenCover (openProjGrading U)).openCover.X i,
      (Proj.awayι (openProjGrading U) y hy i.1.2) z' = x
    exact ⟨z, hz⟩
  rw [Proj.opensRange_awayι] at hx
  exact hx

/-- A coefficient lies in the prime of `Spec A` under a point of the projective spectrum exactly
when its image in `openProjAlgebra U` lies in the homogeneous ideal of that point. -/
public theorem openProjStructureMap_base_mem (U : (Spec (.of A)).Opens)
    (x : letI := openProjGradedRing U; ProjectiveSpectrum.top (openProjGrading U)) (a : A) :
    letI := openProjGradedRing U
    a ∈ ((openProjStructureMap U).base x).asIdeal ↔
      algebraMap A (openProjAlgebra U) a ∈ x.asHomogeneousIdeal.toIdeal := by
  let := openProjGradedRing U
  have hpre := AlgebraicGeometry.Proj.toSpecZero_preimage_basicOpen (openProjGrading U)
    (openProjDegreeZeroEquiv U a)
  have h0 := congr(x ∈ $hpre).to_iff
  have h1 : algebraMap A (openProjAlgebra U) a =
      ((openProjDegreeZeroEquiv U a : openProjGrading U 0) : openProjAlgebra U) :=
    (openProjDegreeZeroEquiv_apply U a).symm
  refine not_iff_not.mp ?_
  rw [h1]
  exact h0

/-- For positive `n`, the square of the monomial `f Tⁿ` is a multiple of `f T`. -/
private theorem openProj_monomial_sq (f : A) (n : ℕ) (hn : 0 < n) :
    (MvPolynomial.monomial (Finsupp.single (0 : Fin 1) n) f) ^ 2 =
      MvPolynomial.monomial (Finsupp.single (0 : Fin 1) 1) f *
        MvPolynomial.monomial (Finsupp.single (0 : Fin 1) (2 * n - 1)) f := by
  rw [← MvPolynomial.C_mul_X_pow_eq_monomial, ← MvPolynomial.C_mul_X_eq_monomial,
    ← MvPolynomial.C_mul_X_pow_eq_monomial]
  calc
    (MvPolynomial.C f * MvPolynomial.X (0 : Fin 1) ^ n) ^ 2 =
        MvPolynomial.C f ^ 2 * MvPolynomial.X (0 : Fin 1) ^ (n + n) := by
      rw [pow_two]
      calc
        _ = MvPolynomial.C f * MvPolynomial.C f *
            (MvPolynomial.X (0 : Fin 1) ^ n * MvPolynomial.X (0 : Fin 1) ^ n) := by ring
        _ = MvPolynomial.C f ^ 2 * MvPolynomial.X (0 : Fin 1) ^ (n + n) := by
          rw [pow_two, ← pow_add]
    _ = MvPolynomial.C f ^ 2 * MvPolynomial.X (0 : Fin 1) ^ (1 + (2 * n - 1)) := by
      congr 2
      omega
    _ = MvPolynomial.C f * MvPolynomial.X (0 : Fin 1) *
        (MvPolynomial.C f * MvPolynomial.X (0 : Fin 1) ^ (2 * n - 1)) := by
      rw [pow_add]
      ring

/-- The square of the monomial `f Tⁿ` is a multiple of the constant `f`. -/
private theorem openProj_monomial_sq_const (f : A) (n : ℕ) :
    (MvPolynomial.monomial (Finsupp.single (0 : Fin 1) n) f) ^ 2 =
      MvPolynomial.C f * MvPolynomial.monomial (Finsupp.single (0 : Fin 1) (2 * n)) f := by
  rw [← MvPolynomial.C_mul_X_pow_eq_monomial,
    ← MvPolynomial.C_mul_X_pow_eq_monomial]
  ring

/-- A homogeneous element of `openProjAlgebra U` of positive degree `n` is the monomial of its
degree-`n` coefficient, and that coefficient is admissible. -/
private theorem openProj_positive_chart_coeff (U : (Spec (.of A)).Opens)
    (n : ℕ) (hn : 0 < n) (y : openProjAlgebra U) (hy : y ∈ openProjGrading U n) :
    let f := y.val.coeff (Finsupp.single (0 : Fin 1) n)
    f ∈ openProjIdeal U ∧
      y.val = MvPolynomial.monomial (Finsupp.single (0 : Fin 1) n) f := by
  let f := y.val.coeff (Finsupp.single (0 : Fin 1) n)
  have he : Finsupp.single (0 : Fin 1) n ≠ 0 := by
    intro h
    have : n = 0 := by simpa using congrArg (fun e : Fin 1 →₀ ℕ => e 0) h
    omega
  have hf : f ∈ openProjIdeal U :=
    openProj_positive_coeff_mem U y.val y.property he
  have hshape := openProj_homogeneous_shape y.val n (by
    show y.val ∈ MvPolynomial.homogeneousSubmodule (Fin 1) A n
    exact hy)
  exact ⟨hf, hshape⟩

/-- A point of the projective spectrum avoiding `f T` lies in the range of the chart at `f`. -/
private theorem openProj_mem_range_chart (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U)
    (x : letI := openProjGradedRing U; ProjectiveSpectrum.top (openProjGrading U))
    : letI := openProjGradedRing U
    openProjChartGen U f hf ∉ x.asHomogeneousIdeal →
    x ∈ (Proj.awayι (openProjGrading U) (openProjChartGen U f hf)
      (openProjChartGen_mem U f hf) (by decide)).opensRange := by
  let := openProjGradedRing U
  intro hx
  rw [Proj.opensRange_awayι]
  exact hx

/-- The canonical morphism restricted to the chart at `f` is an open immersion. -/
private theorem openProjStructureMap_chart_isOpenImmersion (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) :
    letI := openProjGradedRing U
    IsOpenImmersion
      (Proj.awayι (openProjGrading U) (openProjChartGen U f hf)
        (openProjChartGen_mem U f hf) (by decide) ≫ openProjStructureMap U) := by
  let := openProjGradedRing U
  rw [openProjStructureMap_chart]
  infer_instance

/-- For positive `n`, the product of the constant `f` with the monomial `g Tⁿ` is a multiple of
`f T`. -/
private theorem openProj_monomial_mul (f g : A) (n : ℕ) (hn : 0 < n) :
    MvPolynomial.C f * MvPolynomial.monomial (Finsupp.single (0 : Fin 1) n) g =
      MvPolynomial.monomial (Finsupp.single (0 : Fin 1) 1) f *
        MvPolynomial.monomial (Finsupp.single (0 : Fin 1) (n - 1)) g := by
  rw [← MvPolynomial.C_mul_X_pow_eq_monomial, ← MvPolynomial.C_mul_X_eq_monomial,
    ← MvPolynomial.C_mul_X_pow_eq_monomial]
  calc
    MvPolynomial.C f * (MvPolynomial.C g * MvPolynomial.X (0 : Fin 1) ^ n) =
        MvPolynomial.C f * MvPolynomial.C g * MvPolynomial.X (0 : Fin 1) ^ n := by ring
    _ = MvPolynomial.C f * MvPolynomial.C g *
        MvPolynomial.X (0 : Fin 1) ^ (1 + (n - 1)) := by
      exact congrArg (fun t => MvPolynomial.C f * MvPolynomial.C g * t)
        (congrArg (fun e : ℕ => MvPolynomial.X (0 : Fin 1) ^ e) (by omega))
    _ = MvPolynomial.C f * MvPolynomial.X (0 : Fin 1) *
        (MvPolynomial.C g * MvPolynomial.X (0 : Fin 1) ^ (n - 1)) := by
      rw [pow_add]
      ring

/-- Every point of the projective spectrum lies in the chart at some admissible `f` whose image in
`openProjAlgebra U` avoids the point. -/
private theorem openProj_exists_chartData (U : (Spec (.of A)).Opens)
    (x : letI := openProjGradedRing U; ProjectiveSpectrum.top (openProjGrading U)) :
    letI := openProjGradedRing U
    ∃ f, ∃ hf : f ∈ openProjIdeal U,
      algebraMap A (openProjAlgebra U) f ∉ x.asHomogeneousIdeal.toIdeal ∧
      openProjChartGen U f hf ∉ x.asHomogeneousIdeal := by
  let := openProjGradedRing U
  obtain ⟨n, hn, y, hy, hynot⟩ := openProj_exists_positive_chart U x
  let f := y.val.coeff (Finsupp.single (0 : Fin 1) n)
  have hdata := openProj_positive_chart_coeff U n hn y hy
  have hf : f ∈ openProjIdeal U := by simpa only [f] using hdata.1
  have hshape : y.val = MvPolynomial.monomial (Finsupp.single (0 : Fin 1) n) f := by
    simpa only [f] using hdata.2
  let zEvenPoly := MvPolynomial.monomial (Finsupp.single (0 : Fin 1) (2 * n)) f
  let zEven : openProjAlgebra U :=
    ⟨zEvenPoly, Algebra.subset_adjoin ⟨2 * n, f, hf, rfl⟩⟩
  let zOddPoly := MvPolynomial.monomial (Finsupp.single (0 : Fin 1) (2 * n - 1)) f
  let zOdd : openProjAlgebra U :=
    ⟨zOddPoly, Algebra.subset_adjoin ⟨2 * n - 1, f, hf, rfl⟩⟩
  have hconstFactor : y * y = algebraMap A (openProjAlgebra U) f * zEven := by
    apply Subtype.ext
    dsimp [zEven, zEvenPoly]
    show y.val * y.val = MvPolynomial.C f *
      MvPolynomial.monomial (Finsupp.single (0 : Fin 1) (2 * n)) f
    rw [hshape]
    simpa only [pow_two] using openProj_monomial_sq_const f n
  have hchartFactor : y * y = openProjChartGen U f hf * zOdd := by
    apply Subtype.ext
    dsimp [zOdd, zOddPoly]
    show y.val * y.val = MvPolynomial.monomial (Finsupp.single (0 : Fin 1) 1) f *
      MvPolynomial.monomial (Finsupp.single (0 : Fin 1) (2 * n - 1)) f
    rw [hshape]
    simpa only [pow_two] using openProj_monomial_sq f n hn
  have : x.asHomogeneousIdeal.toIdeal.IsPrime := x.isPrime
  have key : ∀ a b : openProjAlgebra U, y * y = a * b → a ∉ x.asHomogeneousIdeal.toIdeal :=
    fun a b h ha => hynot (Ideal.IsPrime.mem_of_pow_mem inferInstance 2
      (by rw [pow_two, h]; exact Ideal.mul_mem_right b _ ha))
  have hfnot := key _ _ hconstFactor
  have hgenNot : openProjChartGen U f hf ∉ x.asHomogeneousIdeal := key _ _ hchartFactor
  exact ⟨f, hf, hfnot, hgenNot⟩

/-- The canonical morphism to `Spec A` is injective on points. -/
public theorem openProjStructureMap_injective (U : (Spec (.of A)).Opens) :
    letI := openProjGradedRing U
    Function.Injective (openProjStructureMap U) := by
  let := openProjGradedRing U
  intro x y hxy
  obtain ⟨f, hf, hfnotx, hchartx⟩ := openProj_exists_chartData U x
  have hqx : f ∉ ((openProjStructureMap U).base x).asIdeal := by
    intro hq
    exact hfnotx ((openProjStructureMap_base_mem U x f).1 hq)
  have hqeq : ((openProjStructureMap U).base x).asIdeal =
      ((openProjStructureMap U).base y).asIdeal := by
    exact congrArg (fun z : Spec (.of A) => z.asIdeal) hxy
  have hfnoty : algebraMap A (openProjAlgebra U) f ∉ y.asHomogeneousIdeal.toIdeal := by
    intro h
    have hq := (openProjStructureMap_base_mem U y f).2 h
    exact hqx (hqeq.symm ▸ hq)
  have hcharty : openProjChartGen U f hf ∉ y.asHomogeneousIdeal := by
    have : y.asHomogeneousIdeal.toIdeal.IsPrime := y.isPrime
    intro hgen
    obtain ⟨n, hn, z, hz, hznot⟩ := openProj_exists_positive_chart U y
    let g := z.val.coeff (Finsupp.single (0 : Fin 1) n)
    have hdata := openProj_positive_chart_coeff U n hn z hz
    have hg : g ∈ openProjIdeal U := by simpa only [g] using hdata.1
    have hzshape : z.val = MvPolynomial.monomial (Finsupp.single (0 : Fin 1) n) g := by
      simpa only [g] using hdata.2
    let vPoly := MvPolynomial.monomial (Finsupp.single (0 : Fin 1) (n - 1)) g
    let v : openProjAlgebra U :=
      ⟨vPoly, Algebra.subset_adjoin ⟨n - 1, g, hg, rfl⟩⟩
    have hmul : algebraMap A (openProjAlgebra U) f * z =
        openProjChartGen U f hf * v := by
      apply Subtype.ext
      dsimp [v, vPoly]
      show MvPolynomial.C f * z.val =
        MvPolynomial.monomial (Finsupp.single (0 : Fin 1) 1) f *
          MvPolynomial.monomial (Finsupp.single (0 : Fin 1) (n - 1)) g
      rw [hzshape]
      exact openProj_monomial_mul f g n hn
    have hprod : algebraMap A (openProjAlgebra U) f * z ∈ y.asHomogeneousIdeal.toIdeal := by
      rw [hmul]
      exact Ideal.mul_mem_right v y.asHomogeneousIdeal.toIdeal hgen
    rcases Ideal.IsPrime.mem_or_mem inferInstance hprod with hfmem | hzmem
    · exact hfnoty hfmem
    · exact hznot hzmem
  obtain ⟨px, hpx⟩ := openProj_mem_range_chart U f hf x hchartx
  obtain ⟨py, hpy⟩ := openProj_mem_range_chart U f hf y hcharty
  have hinj : Function.Injective
      (Proj.awayι (openProjGrading U) (openProjChartGen U f hf)
        (openProjChartGen_mem U f hf) (by decide) ≫ openProjStructureMap U) := by
    let := openProjStructureMap_chart_isOpenImmersion U f hf
    exact (Scheme.Hom.isOpenEmbedding _).injective
  have hpEq : px = py := hinj (by
    simpa only [Scheme.Hom.comp_apply, hpx, hpy] using hxy)
  calc
    x = Proj.awayι (openProjGrading U) (openProjChartGen U f hf)
          (openProjChartGen_mem U f hf) (by decide) px := hpx.symm
    _ = Proj.awayι (openProjGrading U) (openProjChartGen U f hf)
          (openProjChartGen_mem U f hf) (by decide) py := congrArg _ hpEq
    _ = y := hpy

/-- The basic open of an admissible coefficient is contained in `U`. -/
private theorem openProj_openIdeal_basicOpen_le (U : (Spec (.of A)).Opens)
    (f : A) (hf : f ∈ openProjIdeal U) : PrimeSpectrum.basicOpen f ≤ U := by
  intro x hx
  by_contra hxu
  have hfx := (PrimeSpectrum.mem_vanishingIdeal _ _).mp hf x hxu
  exact (PrimeSpectrum.mem_basicOpen f x).mp hx hfx

/-- The canonical morphism to `Spec A` is an open immersion. -/
public theorem openProjStructureMap_isOpenImmersion (U : (Spec (.of A)).Opens) :
    letI := openProjGradedRing U
    IsOpenImmersion (openProjStructureMap U) := by
  let := openProjGradedRing U
  refine IsOpenImmersion.of_forall_source_exists (openProjStructureMap U)
    (openProjStructureMap_injective U) ?_
  intro x
  obtain ⟨f, hf, hconst, hchart⟩ := openProj_exists_chartData U x
  refine ⟨Spec (.of (HomogeneousLocalization.Away (openProjGrading U)
      (openProjChartGen U f hf))),
    Proj.awayι (openProjGrading U) (openProjChartGen U f hf)
      (openProjChartGen_mem U f hf) (by decide), inferInstance, ?_,
    openProjStructureMap_chart_isOpenImmersion U f hf⟩
  exact openProj_mem_range_chart U f hf x hchart

/-- The image of the canonical morphism is `U`. The inclusion of the image uses that an admissible
coefficient has basic open inside `U`; the converse assembles a point of the projective
spectrum from a point of a chart. -/
public theorem openProjStructureMap_range (U : (Spec (.of A)).Opens) :
    letI := openProjGradedRing U
    Set.range (openProjStructureMap U) = (U : Set (Spec (.of A))) := by
  let := openProjGradedRing U
  apply Set.Subset.antisymm_iff.mpr
  constructor
  · rintro q ⟨x, rfl⟩
    obtain ⟨f, hf, hconst, hchart⟩ := openProj_exists_chartData U x
    have hq : f ∉ ((openProjStructureMap U).base x).asIdeal := by
      intro hq
      exact hconst ((openProjStructureMap_base_mem U x f).1 hq)
    exact openProj_openIdeal_basicOpen_le U f hf
      ((PrimeSpectrum.mem_basicOpen f _).2 hq)
  · intro q hq
    change (q : PrimeSpectrum A) ∈ U at hq
    obtain ⟨v, ⟨f, rfl⟩, hqf, hv⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hq U.2
    have hf : f ∈ openProjIdeal U := by
      apply (PrimeSpectrum.mem_vanishingIdeal _ _).2
      intro r hr
      by_contra hfr
      exact hr (hv ((PrimeSpectrum.mem_basicOpen f r).2 hfr))
    change (q : PrimeSpectrum A) ∈ PrimeSpectrum.basicOpen f at hqf
    have hloc : (q : PrimeSpectrum A) ∈
        Set.range (PrimeSpectrum.comap (algebraMap A (Localization.Away f))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away f) f]
      exact hqf
    obtain ⟨qf, hqfmap⟩ := hloc
    refine ⟨Proj.awayι (openProjGrading U) (openProjChartGen U f hf)
      (openProjChartGen_mem U f hf) (by decide)
      ((openProjChartSpecIso U f hf).inv qf), ?_⟩
    rw [openProjStructureMap_awayι_chart U f hf qf]
    exact congrArg (fun p : PrimeSpectrum A => (p : Spec (.of A))) hqfmap

/-- The projective spectrum of the indicated algebra is the chosen open subscheme. -/
@[stacks 0G5W "the isomorphism with the open subscheme"]
public noncomputable def projOpenIso (U : (Spec (.of A)).Opens) :
    letI := openProjGradedRing U
    AlgebraicGeometry.Proj (openProjGrading U) ≅ U.toScheme := by
  letI := openProjGradedRing U
  letI := openProjStructureMap_isOpenImmersion U
  exact IsOpenImmersion.isoOfRangeEq (openProjStructureMap U) U.ι (by
    rw [openProjStructureMap_range, Scheme.Opens.range_ι])

/-- Under the isomorphism, the canonical morphism to `Spec A` is inclusion. -/
@[stacks 0G5W "compatibility with the structure morphism"]
public theorem projOpenIso_hom_comp (U : (Spec (.of A)).Opens) :
    letI := openProjGradedRing U
    Proj.toSpecZero (openProjGrading U) ≫
      Spec.map (CommRingCat.ofHom (openProjDegreeZeroEquiv U).toRingHom) =
        (projOpenIso U).hom ≫ U.ι := by
  let := openProjGradedRing U
  let := openProjStructureMap_isOpenImmersion U
  show openProjStructureMap U = (projOpenIso U).hom ≫ U.ι
  exact (IsOpenImmersion.isoOfRangeEq_hom_fac (openProjStructureMap U) U.ι (by
    rw [openProjStructureMap_range, Scheme.Opens.range_ι])).symm

end AlgebraicGeometry
