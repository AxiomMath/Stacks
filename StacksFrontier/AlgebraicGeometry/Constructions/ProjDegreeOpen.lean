module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# The degree `d` open of the homogeneous spectrum

Let `A = ⨁_{d ≥ 0} 𝒜 d` be a graded ring and `X = Proj 𝒜`. For an integer `d` the *degree `d`
open* of `X` is the union

  `U_d = ⋃_{f ∈ 𝒜 d} D₊(f) ⊆ X`

of the projective standard opens attached to the homogeneous elements of degree exactly `d`.
These opens grow along divisibility and exhaust `X`: if `d ∣ d'` with `d'` positive then
`U_d ⊆ U_{d'}`, because `f ∈ 𝒜 d` has a power lying in `𝒜 d'` with the same standard open; and
the `U_d` for `d` positive cover `X`, because a homogeneous prime of `Proj 𝒜` does not contain
the irrelevant ideal.

Neither `X` nor `U_d` need be quasi-compact.

## Main definitions

* `AlgebraicGeometry.Proj.degreeOpen` — the open `U_d ⊆ Proj 𝒜`.

## Main results

* `AlgebraicGeometry.Proj.degreeOpen_le_of_dvd` — `U_d ⊆ U_{d'}` when `d ∣ d'` and `0 < d'`.
* `AlgebraicGeometry.Proj.basicOpen_le_degreeOpen` — each `D₊(f)` with `f ∈ 𝒜 d` lies in `U_d`.
* `AlgebraicGeometry.Proj.iSup_degreeOpen_eq_top` — the opens `U_d` for `0 < d` cover `Proj 𝒜`.

## References

* [Stacks Project, Tag 01N5](https://stacks.math.columbia.edu/tag/01N5)
-/

@[expose] public section

namespace AlgebraicGeometry.Proj

universe u w

variable {σ : Type w} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- **The degree `d` open of `Proj 𝒜`**, the union `U_d = ⋃_{f ∈ 𝒜 d} D₊(f)` of the projective
standard opens of the homogeneous elements of degree exactly `d`. -/
@[stacks 01N5]
public def degreeOpen (d : ℕ) : (Proj 𝒜).Opens :=
  ⨆ f : 𝒜 d, Proj.basicOpen 𝒜 (f : A)

/-- The standard open of a homogeneous element of degree `d` is contained in `U_d`. -/
public theorem basicOpen_le_degreeOpen {d : ℕ} {f : A} (hf : f ∈ 𝒜 d) :
    Proj.basicOpen 𝒜 f ≤ degreeOpen 𝒜 d :=
  le_iSup (fun g : 𝒜 d => Proj.basicOpen 𝒜 (g : A)) ⟨f, hf⟩

/-- **The degree opens grow along divisibility**: if `d ∣ d'` and `d'` is positive then
`U_d ⊆ U_{d'}`. A homogeneous `f` of degree `d` has `f ^ k` of degree `d' = d * k`, and
`D₊(f ^ k) = D₊(f)`. -/
@[stacks 01N5 "divisibility"]
public theorem degreeOpen_le_of_dvd {d d' : ℕ} (hdvd : d ∣ d') (hd' : 0 < d') :
    degreeOpen 𝒜 d ≤ degreeOpen 𝒜 d' := by
  obtain ⟨k, rfl⟩ := hdvd
  refine iSup_le fun f => ?_
  have hk : 0 < k := Nat.pos_of_ne_zero fun h => by simp [h] at hd'
  have hpow : (f : A) ^ k ∈ 𝒜 (d * k) := by
    simpa [smul_eq_mul, Nat.mul_comm] using SetLike.pow_mem_graded k f.2
  exact (Proj.basicOpen_pow 𝒜 (f : A) k hk).symm.trans_le (basicOpen_le_degreeOpen 𝒜 hpow)

/-- **The degree opens cover `Proj 𝒜`**: every point lies in `U_d` for some positive `d`, because
a homogeneous prime of `Proj 𝒜` does not contain the irrelevant ideal, which is generated by the
homogeneous elements of positive degree. -/
@[stacks 01N5 "covering"]
public theorem iSup_degreeOpen_eq_top :
    (⨆ d : ℕ, ⨆ _ : 0 < d, degreeOpen 𝒜 d) = ⊤ := by
  refine top_le_iff.mp fun x _ => ?_
  by_contra hx
  refine x.not_irrelevant_le ((HomogeneousIdeal.irrelevant_le 𝒜).mpr fun d hd z hz => ?_)
  by_contra hzx
  exact hx (TopologicalSpace.Opens.mem_iSup.mpr ⟨d, TopologicalSpace.Opens.mem_iSup.mpr
    ⟨hd, basicOpen_le_degreeOpen 𝒜 hz ((Proj.mem_basicOpen 𝒜 z x).mpr hzx)⟩⟩)

end AlgebraicGeometry.Proj

end
