universe u

/-! ### Generalities -/

/-- `appLE` of a morphism equal to `g`, from `U` to `g ⁻¹ᵁ U`, is `g.app U`. -/
theorem appLE_eq_app_of_eq {X Y : Scheme.{u}} {f g : X ⟶ Y} (h : f = g) (U : Y.Opens)
    (e : g ⁻¹ᵁ U ≤ f ⁻¹ᵁ U) : f.appLE U (g ⁻¹ᵁ U) e = g.app U := by
  subst h; exact Scheme.Hom.appLE_eq_app _

/-- Pulling a function back along a retraction and then along its section gives it back. -/
theorem appLE_app_of_comp_eq_id {X Y : Scheme.{u}} (s : X ⟶ Y) (p : Y ⟶ X) (h : s ≫ p = 𝟙 X)
    (U : X.Opens) (e : U ≤ (s ≫ p) ⁻¹ᵁ U) (r : Γ(X, U)) :
    (s.appLE (p ⁻¹ᵁ U) U e).hom ((p.app U).hom r) = r := by
  have h1 := Scheme.Hom.comp_appLE s p U U e
  have key : ∀ (q : X ⟶ X) (_ : q = 𝟙 X) (e : U ≤ q ⁻¹ᵁ U), q.appLE U U e = 𝟙 _ := by
    rintro q rfl e
    refine (congrArg (· ≫ X.presheaf.map (homOfLE e).op) (Scheme.Hom.id_app U)).trans ?_
    exact (Category.id_comp _).trans ((congrArg (fun i => X.presheaf.map i)
      (Subsingleton.elim (homOfLE e).op (𝟙 (op U)))).trans (X.presheaf.map_id _))
  have h2 : (s ≫ p).appLE U U e = 𝟙 _ := key _ h e
  exact (ConcreteCategory.congr_hom h1.symm r).trans
    ((ConcreteCategory.congr_hom h2 r).trans rfl)

/-- A morphism of affine schemes inducing an isomorphism on global sections is an
isomorphism. -/
theorem isIso_of_isIso_appTop {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y] (f : X ⟶ Y)
    (_ : IsIso f.appTop) : IsIso f := by
  have h : f = X.isoSpec.hom ≫ Spec.map f.appTop ≫ Y.isoSpec.inv := by
    rw [Scheme.isoSpec_hom_naturality_assoc, Iso.hom_inv_id, Category.comp_id]
  rw [h]
  infer_instance

/-- **The identification of the sections of `𝐕(ℱ)` over an affine open with the symmetric
algebra carries the constants to the pullback of functions along the projection.** -/
theorem vectorBundleSections_algebraMap {X : Scheme.{u}} (F : X.Modules) [F.IsQuasicoherent]
    {V : X.Opens} (hV : IsAffineOpen V) (r : Γ(X, V)) :
    vectorBundleSections F hV (algebraMap _ _ r) = ((vectorBundleToBase X F).app V).hom r := by
  change ((vectorBundlePushforwardIso X (F := F)).inv.right.hom.app (op V)).hom
      (Stacks.SymAlgSections.symSectionsRingEquiv F hV (algebraMap _ _ r)) = _
  rw [Stacks.SymAlgSections.symSectionsRingEquiv_algebraMap]
  have h := NatTrans.congr_app (Stacks.RelativeSpec.AlgebraSheaf.hom_comp_right_hom
    (vectorBundlePushforwardIso X (F := F)).inv) (op V)
  exact ConcreteCategory.congr_hom h r

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-! ### The comparison morphism -/

/-- The twisting sheaf `𝒪_P(1)` on `P = Proj A`. -/
abbrev twistOne : (AlgebraicGeometry.Proj 𝒜).Modules := twistingSheaf 𝒜 ((1 : ℕ) : ℤ)

/-- `𝒪_P(1)` is quasi-coherent. -/
instance isQuasicoherent_twistOne : (twistOne 𝒜).IsQuasicoherent :=
  TwistChartLocality.isQuasicoherent_twistingSheaf 𝒜 _

/-- **The morphism `L ⟶ 𝐕(𝒪_P(1))` over `P`** classified, by the universal property of the
vector bundle, by the degree-one inclusion `𝒪_P(1) ⟶ π_* 𝒪_L`. -/
def coneToVectorBundle :
    Over.mk (pi 𝒜) ⟶ vectorBundleOver (AlgebraicGeometry.Proj 𝒜) (F := twistOne 𝒜) :=
  (vectorBundleHomEquiv (twistOne 𝒜) (Over.mk (pi 𝒜))).symm (ProjConeTwist.coneTwistHom 𝒜 1)

/-- The module morphism classifying `coneToVectorBundle` is the degree-one inclusion. -/
theorem vectorBundleHomEquiv_coneToVectorBundle :
    vectorBundleHomEquiv (twistOne 𝒜) _ (coneToVectorBundle 𝒜) =
      ProjConeTwist.coneTwistHom 𝒜 1 :=
  Equiv.apply_symm_apply _ _

/-- The comparison lies over `P`. -/
@[reassoc]
theorem coneToVectorBundle_left_comp :
    (coneToVectorBundle 𝒜).left ≫ vectorBundleToBase _ (twistOne 𝒜) = pi 𝒜 :=
  Over.w (coneToVectorBundle 𝒜)

/-- The part of `L` over an open `U` of `P` is the inverse image of the part of `𝐕(𝒪_P(1))`
over `U`. -/
theorem preimage_coneToVectorBundle (U : (AlgebraicGeometry.Proj 𝒜).Opens) :
    (coneToVectorBundle 𝒜).left ⁻¹ᵁ (vectorBundleToBase _ (twistOne 𝒜) ⁻¹ᵁ U) =
      pi 𝒜 ⁻¹ᵁ U := by
  rw [← Scheme.Hom.comp_preimage, coneToVectorBundle_left_comp]

/-- The degree-one inclusion `Γ(V, 𝒪_P(1)) ⟶ Γ(π⁻¹V, 𝒪_L)` on sections. -/
def coneSection (V : (AlgebraicGeometry.Proj 𝒜).Opens) (s : Γ(twistOne 𝒜, V)) :
    Γ(AlgebraicGeometry.Proj (grading 𝒜), pi 𝒜 ⁻¹ᵁ V) :=
  ((ProjConeTwist.coneTwistHom 𝒜 1).val.app (op V)).hom s

/-- The comparison on sections over an affine open `V` of `P`, read on the symmetric algebra
`Sym(Γ(V, 𝒪_P(1)))`. -/
def sectionsHom {V : (AlgebraicGeometry.Proj 𝒜).Opens} (hV : IsAffineOpen V) :
    SymmetricAlgebra Γ(AlgebraicGeometry.Proj 𝒜, V) Γ(twistOne 𝒜, V) →+*
      Γ(AlgebraicGeometry.Proj (grading 𝒜), pi 𝒜 ⁻¹ᵁ V) :=
  ((coneToVectorBundle 𝒜).left.appLE _ _ (preimage_coneToVectorBundle 𝒜 V).ge).hom.comp
    (vectorBundleSections (twistOne 𝒜) hV)

/-- On constants the comparison on sections is the pullback of functions along `π`. -/
theorem sectionsHom_algebraMap {V : (AlgebraicGeometry.Proj 𝒜).Opens} (hV : IsAffineOpen V)
    (r : Γ(AlgebraicGeometry.Proj 𝒜, V)) :
    sectionsHom 𝒜 hV (algebraMap _ _ r) = ((pi 𝒜).app V).hom r := by
  have h1 := Scheme.Hom.comp_appLE (coneToVectorBundle 𝒜).left
    (vectorBundleToBase _ (twistOne 𝒜)) V (pi 𝒜 ⁻¹ᵁ V) (preimage_coneToVectorBundle 𝒜 V).ge
  have h2 := appLE_eq_app_of_eq (coneToVectorBundle_left_comp 𝒜) V
    (preimage_coneToVectorBundle 𝒜 V).ge
  exact (congrArg ((coneToVectorBundle 𝒜).left.appLE _ _ (preimage_coneToVectorBundle 𝒜 V).ge).hom
    (vectorBundleSections_algebraMap (twistOne 𝒜) hV r)).trans
    ((ConcreteCategory.congr_hom h1.symm r).trans (ConcreteCategory.congr_hom h2 r))

/-- On degree-one elements the comparison on sections is the degree-one inclusion. -/
theorem sectionsHom_ι {V : (AlgebraicGeometry.Proj 𝒜).Opens} (hV : IsAffineOpen V)
    (s : Γ(twistOne 𝒜, V)) :
    sectionsHom 𝒜 hV (SymmetricAlgebra.ι _ _ s) = coneSection 𝒜 V s := by
  have hp := pushforwardAlgebraMap_app (coneToVectorBundle 𝒜) V
    (preimage_coneToVectorBundle 𝒜 V).ge
  have hc := Stacks.RelativeSpec.ungradedToGradedRight_ungradedAlgebraSheafIncl
    (AlgebraicGeometry.Proj 𝒜) (symmetricAlgebra (AlgebraicGeometry.Proj 𝒜) (twistOne 𝒜))
    (symmetricAlgebra_mul_comm _ _) 1 V
    ((symmetricAlgebraGen (AlgebraicGeometry.Proj 𝒜) (twistOne 𝒜)).val.app (op V) s)
  have hι := Stacks.SymAlgSections.symSectionsRingEquiv_ι_eq_ungradedIncl (twistOne 𝒜) hV s
  have e1 : coneSection 𝒜 V s = (((vectorBundleHomEquiv (twistOne 𝒜) (Over.mk (pi 𝒜))
      (coneToVectorBundle 𝒜)).val.app (op V)).hom s) :=
    (congrArg (fun φ => (φ.val.app (op V)).hom s)
      (vectorBundleHomEquiv_coneToVectorBundle 𝒜)).symm
  have e2 := congrArg (fun φ => (φ.val.app (op V)).hom s)
    (vectorBundleHomEquiv_apply (twistOne 𝒜) (Over.mk (pi 𝒜)) (coneToVectorBundle 𝒜))
  have key : ((coneToVectorBundle 𝒜).left.appLE _ _ (preimage_coneToVectorBundle 𝒜 V).ge).hom
      (((vectorBundlePushforwardIso (AlgebraicGeometry.Proj 𝒜)
          (F := twistOne 𝒜)).inv.right.hom.app (op V)).hom
        (((symmetricAlgebraSheafComparison (twistOne 𝒜)).hom.right.hom.app (op V)).hom
          (Stacks.RelativeSpec.ungradedAlgebraSheafIncl _ _ _ 1 V
            ((symmetricAlgebraGen (AlgebraicGeometry.Proj 𝒜) (twistOne 𝒜)).val.app
              (op V) s)))) = coneSection 𝒜 V s :=
    (ConcreteCategory.congr_hom hp.symm _).trans (e2.symm.trans e1.symm)
  refine Eq.trans ?_ key
  refine (congrArg (fun y => ((coneToVectorBundle 𝒜).left.appLE _ _
    (preimage_coneToVectorBundle 𝒜 V).ge).hom (((vectorBundlePushforwardIso
      (AlgebraicGeometry.Proj 𝒜) (F := twistOne 𝒜)).inv.right.hom.app (op V)).hom y)) hι).trans ?_
  exact congrArg (fun y => ((coneToVectorBundle 𝒜).left.appLE _ _
    (preimage_coneToVectorBundle 𝒜 V).ge).hom (((vectorBundlePushforwardIso
      (AlgebraicGeometry.Proj 𝒜) (F := twistOne 𝒜)).inv.right.hom.app (op V)).hom y)) hc.symm

/-! ### The chart over `D₊(cb)` with `deg c = deg b + 1` -/

variable {𝒜} {c b g : A} {m : ℕ}

/-- The generator of `Γ(D₊(g), 𝒪_P(1))`, for `g = cb` with `deg c = m + 1` and `deg b = m`: the
section corresponding to the fibre coordinate `(c²)⁽²ᵐ⁺¹⁾ / ψ g` of the cone. -/
def chartGenerator (hc : c ∈ 𝒜 (m + 1)) (hg : g ∈ 𝒜 (2 * m + 1)) :
    Γ(twistOne 𝒜, AlgebraicGeometry.Proj.basicOpen 𝒜 g) :=
  awayGradingEquivSectionsTwist 𝒜 (2 * m + 1) hg (Nat.succ_pos _) 1
    ⟨RatioChart.coordinate hc hg, RatioChart.coordinate_mem_awayGrading hc hg⟩

/-- The degree-one inclusion sends the generator to the fibre coordinate. -/
theorem coneSection_chartGenerator (hc : c ∈ 𝒜 (m + 1)) (hg : g ∈ 𝒜 (2 * m + 1)) :
    coneSection 𝒜 (AlgebraicGeometry.Proj.basicOpen 𝒜 g) (chartGenerator hc hg) =
      (AlgebraicGeometry.Proj (grading 𝒜)).presheaf.map
        (eqToHom (pi_preimage_basicOpen 𝒜 g (2 * m + 1) hg (Nat.succ_pos _))).op
        ((AlgebraicGeometry.Proj.awayToSection (grading 𝒜) (psi 𝒜 g)).hom
          (RatioChart.coordinate hc hg)) := by
  have h1 := congrArg (fun φ => φ.hom (chartGenerator hc hg))
    (ProjConeTwist.coneTwistHom_app 𝒜 1 hg (Nat.succ_pos (2 * m)))
  refine h1.trans ?_
  exact congrArg (fun y : awayGrading 𝒜 (2 * m + 1) hg 1 =>
    (AlgebraicGeometry.Proj (grading 𝒜)).presheaf.map
      (eqToHom (pi_preimage_basicOpen 𝒜 g (2 * m + 1) hg (Nat.succ_pos _))).op
      ((AlgebraicGeometry.Proj.awayToSection (grading 𝒜) (psi 𝒜 g)).hom
        (y : Away (grading 𝒜) (psi 𝒜 g))))
    ((awayGradingEquivSectionsTwist 𝒜 (2 * m + 1) hg (Nat.succ_pos _) 1).symm_apply_apply _)

/-- **`Γ(D₊(cb), 𝒪_P(1))` is free of rank one on `chartGenerator`.** -/
theorem bijective_smul_chartGenerator (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m) (hcb : c * b = g) :
    Function.Bijective fun r : Γ(AlgebraicGeometry.Proj 𝒜, AlgebraicGeometry.Proj.basicOpen 𝒜 g) =>
      r • chartGenerator hc (DegreeOneUnitAway.mul_mem hc hb hcb) := by
  have hg := DegreeOneUnitAway.mul_mem hc hb hcb
  have hd : 0 < 2 * m + 1 := Nat.succ_pos _
  have hsmul : ∀ z : Away 𝒜 g,
      ((awayGradingEquivSectionsTwist 𝒜 (2 * m + 1) hg hd 1).symm
          ((AlgebraicGeometry.Proj.awayToSection 𝒜 g).hom z • chartGenerator hc hg) :
        Away (grading 𝒜) (psi 𝒜 g)) =
        Away.map (psi 𝒜) g z * RatioChart.coordinate hc hg := by
    intro z
    refine (awayGradingEquivSectionsTwist_symm_smul 𝒜 (2 * m + 1) hg hd 1 z
      (chartGenerator hc hg)).trans ?_
    exact congrArg (fun y : awayGrading 𝒜 (2 * m + 1) hg 1 =>
      Away.map (psi 𝒜) g z * (y : Away (grading 𝒜) (psi 𝒜 g)))
      ((awayGradingEquivSectionsTwist 𝒜 (2 * m + 1) hg hd 1).symm_apply_apply _)
  have hsurj : Function.Surjective (AlgebraicGeometry.Proj.awayToSection 𝒜 g).hom :=
    ProjConeTwist.awayToSection_surjective 𝒜 hg hd
  refine ⟨fun r₁ r₂ h => ?_, fun s => ?_⟩
  · obtain ⟨z₁, rfl⟩ := hsurj r₁
    obtain ⟨z₂, rfl⟩ := hsurj r₂
    have h' := congrArg (fun s => ((awayGradingEquivSectionsTwist 𝒜 (2 * m + 1) hg hd 1).symm s :
      Away (grading 𝒜) (psi 𝒜 g))) h
    simp only [hsmul] at h'
    have h'' := congrArg (awayToLocalization 𝒜) h'
    rw [map_mul, map_mul, RatioChart.awayToLocalization_awayMap_psi hg,
      RatioChart.awayToLocalization_awayMap_psi hg,
      RatioChart.awayToLocalization_coordinate hc hg hcb] at h''
    rw [HomogeneousLocalization.val_injective _
      ((Units.mul_left_inj (DegreeOneUnitAway.chartUnit hcb)).mp h'')]
  · obtain ⟨z, hz⟩ := RatioChart.exists_eq_awayMap_mul_coordinate hc hb hcb
      ((awayGradingEquivSectionsTwist 𝒜 (2 * m + 1) hg hd 1).symm s).2
    refine ⟨(AlgebraicGeometry.Proj.awayToSection 𝒜 g).hom z,
      (awayGradingEquivSectionsTwist 𝒜 (2 * m + 1) hg hd 1).symm.injective (Subtype.ext ?_)⟩
    exact (hsmul z).trans hz.symm

/-- **Over `D₊(cb)` the chart of the cone is the polynomial ring in the image of the generator**:
`Γ(D₊(cb), 𝒪_P)[X] ⟶ Γ(π⁻¹D₊(cb), 𝒪_L)`, `X ↦ coneSection chartGenerator`, is bijective. -/
theorem bijective_eval₂_coneSection (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m) (hcb : c * b = g) :
    Function.Bijective (eval₂RingHom ((pi 𝒜).app (AlgebraicGeometry.Proj.basicOpen 𝒜 g)).hom
      (coneSection 𝒜 _ (chartGenerator hc (DegreeOneUnitAway.mul_mem hc hb hcb)))) := by
  have hg := DegreeOneUnitAway.mul_mem hc hb hcb
  have hd : 0 < 2 * m + 1 := Nat.succ_pos _
  have hκ : IsIso (AlgebraicGeometry.Proj.awayToSection 𝒜 g) := by
    rw [← AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜 g hg hd]; infer_instance
  have hlam : IsIso (AlgebraicGeometry.Proj.awayToSection (grading 𝒜) (psi 𝒜 g)) := by
    rw [← AlgebraicGeometry.Proj.basicOpenIsoAway_hom (grading 𝒜) (psi 𝒜 g)
      ((psi 𝒜).map_mem hg) hd]
    infer_instance
  let κ : Away 𝒜 g ≃+* Γ(AlgebraicGeometry.Proj 𝒜, AlgebraicGeometry.Proj.basicOpen 𝒜 g) :=
    (asIso (AlgebraicGeometry.Proj.awayToSection 𝒜 g)).commRingCatIsoToRingEquiv
  let ρ := (AlgebraicGeometry.Proj (grading 𝒜)).presheaf.map
    (eqToHom (pi_preimage_basicOpen 𝒜 g (2 * m + 1) hg hd)).op
  let lam : Away (grading 𝒜) (psi 𝒜 g) →+*
      Γ(AlgebraicGeometry.Proj (grading 𝒜), pi 𝒜 ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 g) :=
    ρ.hom.comp (AlgebraicGeometry.Proj.awayToSection (grading 𝒜) (psi 𝒜 g)).hom
  have hlambij : Function.Bijective lam :=
    (ConcreteCategory.bijective_of_isIso ρ).comp (ConcreteCategory.bijective_of_isIso _)
  have hcomp : (eval₂RingHom ((pi 𝒜).app (AlgebraicGeometry.Proj.basicOpen 𝒜 g)).hom
      (coneSection 𝒜 _ (chartGenerator hc hg))).comp
        (Polynomial.mapRingHom (κ : Away 𝒜 g →+* _)) = lam.comp (RatioChart.polyHom hc hg) := by
    refine Polynomial.ringHom_ext (fun z => ?_) ?_
    · rw [RingHom.comp_apply, RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
        coe_eval₂RingHom, eval₂_C, RatioChart.polyHom_C]
      exact (ProjConeTwist.awayToSection_pi_app 𝒜 (2 * m + 1) hg hd z).symm
    · rw [RingHom.comp_apply, RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
        coe_eval₂RingHom, eval₂_X, RatioChart.polyHom_X, coneSection_chartGenerator]
      rfl
  have hbij := hlambij.comp (RatioChart.bijective_polyHom hc hb hcb)
  rw [← RingHom.coe_comp, ← hcomp, RingHom.coe_comp] at hbij
  exact (Function.Bijective.of_comp_iff _ (Polynomial.mapEquiv κ).bijective).mp hbij

/-- The basis of `Γ(D₊(cb), 𝒪_P(1))` given by `chartGenerator`. -/
def chartBasis (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m) (hcb : c * b = g) :
    Module.Basis PUnit.{u + 1} Γ(AlgebraicGeometry.Proj 𝒜, AlgebraicGeometry.Proj.basicOpen 𝒜 g)
      Γ(twistOne 𝒜, AlgebraicGeometry.Proj.basicOpen 𝒜 g) :=
  (Module.Basis.singleton PUnit.{u + 1} _).map
    (LinearEquiv.ofBijective
      (LinearMap.toSpanSingleton _ _ (chartGenerator hc (DegreeOneUnitAway.mul_mem hc hb hcb)))
      (bijective_smul_chartGenerator hc hb hcb))

/-- The basis vector of `chartBasis` is `chartGenerator`. -/
theorem chartBasis_apply (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m) (hcb : c * b = g) (i : PUnit) :
    chartBasis hc hb hcb i = chartGenerator hc (DegreeOneUnitAway.mul_mem hc hb hcb) := by
  rw [chartBasis, Module.Basis.map_apply, Module.Basis.singleton_apply]
  exact one_smul Γ(AlgebraicGeometry.Proj 𝒜, AlgebraicGeometry.Proj.basicOpen 𝒜 g) _

/-- The identification `Sym(Γ(D₊(cb), 𝒪_P(1))) ≃ Γ(D₊(cb), 𝒪_P)[X]` given by `chartBasis`. -/
def chartPolynomialEquiv (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m) (hcb : c * b = g) :
    SymmetricAlgebra Γ(AlgebraicGeometry.Proj 𝒜, AlgebraicGeometry.Proj.basicOpen 𝒜 g)
        Γ(twistOne 𝒜, AlgebraicGeometry.Proj.basicOpen 𝒜 g) ≃ₐ[Γ(AlgebraicGeometry.Proj 𝒜,
          AlgebraicGeometry.Proj.basicOpen 𝒜 g)]
      Polynomial Γ(AlgebraicGeometry.Proj 𝒜, AlgebraicGeometry.Proj.basicOpen 𝒜 g) :=
  (SymmetricAlgebra.equivMvPolynomial (chartBasis hc hb hcb)).trans
    (MvPolynomial.uniqueAlgEquiv _ PUnit)

/-- `chartPolynomialEquiv` sends the generator to `X`. -/
theorem chartPolynomialEquiv_symm_X (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m) (hcb : c * b = g) :
    (chartPolynomialEquiv hc hb hcb).symm Polynomial.X =
      SymmetricAlgebra.ι _ _ (chartGenerator hc (DegreeOneUnitAway.mul_mem hc hb hcb)) := by
  apply (chartPolynomialEquiv hc hb hcb).injective
  rw [AlgEquiv.apply_symm_apply, ← chartBasis_apply hc hb hcb PUnit.unit]
  change _ = (MvPolynomial.uniqueAlgEquiv _ PUnit) (SymmetricAlgebra.equivMvPolynomial
    (chartBasis hc hb hcb) (SymmetricAlgebra.ι _ _ (chartBasis hc hb hcb PUnit.unit)))
  rw [SymmetricAlgebra.equivMvPolynomial_ι_apply]
  simp

/-- **The comparison on sections over `D₊(cb)` is bijective.** -/
theorem bijective_sectionsHom (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m) (hcb : c * b = g)
    (hV : IsAffineOpen (AlgebraicGeometry.Proj.basicOpen 𝒜 g)) :
    Function.Bijective (sectionsHom 𝒜 hV) := by
  have hcomp : (sectionsHom 𝒜 hV).comp
      ((chartPolynomialEquiv hc hb hcb).symm : _ →+* _) =
      eval₂RingHom ((pi 𝒜).app (AlgebraicGeometry.Proj.basicOpen 𝒜 g)).hom
        (coneSection 𝒜 _ (chartGenerator hc (DegreeOneUnitAway.mul_mem hc hb hcb))) := by
    refine Polynomial.ringHom_ext (fun r => ?_) ?_
    · have h := (chartPolynomialEquiv hc hb hcb).symm.commutes r
      rw [Polynomial.algebraMap_eq] at h
      rw [coe_eval₂RingHom, eval₂_C]
      change sectionsHom 𝒜 hV ((chartPolynomialEquiv hc hb hcb).symm (Polynomial.C r)) = _
      rw [h, sectionsHom_algebraMap]
    · rw [coe_eval₂RingHom, eval₂_X]
      change sectionsHom 𝒜 hV ((chartPolynomialEquiv hc hb hcb).symm Polynomial.X) = _
      rw [chartPolynomialEquiv_symm_X, sectionsHom_ι]
  have h := bijective_eval₂_coneSection hc hb hcb
  rw [← hcomp, RingHom.coe_comp] at h
  exact (Function.Bijective.of_comp_iff _ (chartPolynomialEquiv hc hb hcb).symm.bijective).mp h

/-- **The comparison `L ⟶ 𝐕(𝒪_P(1))` is an isomorphism over `D₊(cb)`**, for `c` homogeneous of
degree `m + 1` and `b` homogeneous of degree `m`. -/
theorem isIso_morphismRestrict_basicOpen_mul (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m)
    (hcb : c * b = g) :
    IsIso ((coneToVectorBundle 𝒜).left ∣_
      (vectorBundleToBase _ (twistOne 𝒜) ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 g)) := by
  have hg := DegreeOneUnitAway.mul_mem hc hb hcb
  have hV : IsAffineOpen (AlgebraicGeometry.Proj.basicOpen 𝒜 g) :=
    AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 g hg (Nat.succ_pos _)
  have hU : IsAffineOpen
      (vectorBundleToBase _ (twistOne 𝒜) ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 g) :=
    isAffineOpen_preimage_vectorBundleToBase _ _ ⟨_, hV⟩
  have hsrc : IsAffineOpen ((coneToVectorBundle 𝒜).left ⁻¹ᵁ
      (vectorBundleToBase _ (twistOne 𝒜) ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 g)) := by
    rw [preimage_coneToVectorBundle, pi_preimage_basicOpen 𝒜 g _ hg (Nat.succ_pos _)]
    exact AlgebraicGeometry.Proj.isAffineOpen_basicOpen _ _ ((psi 𝒜).map_mem hg) (Nat.succ_pos _)
  have : IsAffine (vectorBundleToBase _ (twistOne 𝒜) ⁻¹ᵁ
      AlgebraicGeometry.Proj.basicOpen 𝒜 g).toScheme := hU
  have hbij : Function.Bijective ((coneToVectorBundle 𝒜).left.appLE _ _
      (preimage_coneToVectorBundle 𝒜 (AlgebraicGeometry.Proj.basicOpen 𝒜 g)).ge).hom :=
    (Function.Bijective.of_comp_iff _ (vectorBundleSections_bijective _ hV)).mp
      (bijective_sectionsHom hc hb hcb hV)
  have hiso : IsIso ((coneToVectorBundle 𝒜).left.appLE _ _
      (preimage_coneToVectorBundle 𝒜 (AlgebraicGeometry.Proj.basicOpen 𝒜 g)).ge) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  have := hiso
  have hsrc' : IsAffineOpen (pi 𝒜 ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 g) := by
    rw [← preimage_coneToVectorBundle]; exact hsrc
  have : IsAffine (pi 𝒜 ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 g).toScheme := hsrc'
  rw [← Scheme.Hom.resLE_eq_morphismRestrict, ← MorphismProperty.isomorphisms.iff]
  refine (Scheme.Hom.resLE_congr _ le_rfl rfl (preimage_coneToVectorBundle 𝒜 _)
    (MorphismProperty.isomorphisms Scheme)).mpr ?_
  refine (MorphismProperty.isomorphisms.iff _).mpr (isIso_of_isIso_appTop _ ?_)
  change IsIso ((Scheme.Hom.resLE _ _ _ _).app ⊤)
  rw [Scheme.Hom.resLE_app_top]
  exact IsIso.comp_isIso' (Iso.isIso_hom _) (IsIso.comp_isIso' hiso (Iso.isIso_inv _))

/-! ### The zero section -/

variable (𝒜) in
/-- The zero section of the cone, as a morphism of schemes over `P`. -/
def zeroSectionOver :
    Over.mk (𝟙 (AlgebraicGeometry.Proj 𝒜)) ⟶ Over.mk (pi 𝒜) :=
  Over.homMk (zeroSection 𝒜) (zeroSection_comp_pi 𝒜)

variable (𝒜) in
/-- **The comparison `L ⟶ 𝐕(𝒪_P(1))` carries the zero section of the cone to the zero section of
the vector bundle**: the zero section of the cone is its vertex, so the module morphism of the
composite is zero. -/
theorem zeroSection_comp_coneToVectorBundle :
    zeroSection 𝒜 ≫ (coneToVectorBundle 𝒜).left =
      (vectorBundleOverZeroSection (twistOne 𝒜)).left := by
  have h : zeroSectionOver 𝒜 ≫ coneToVectorBundle 𝒜 =
      vectorBundleOverZeroSection (twistOne 𝒜) := by
    apply (vectorBundleHomEquiv (twistOne 𝒜) _).injective
    refine (vectorBundleHomEquiv_comp (twistOne 𝒜) (zeroSectionOver 𝒜)
      (coneToVectorBundle 𝒜)).trans ?_
    refine Eq.trans ?_ (vectorBundleHomEquiv_vectorBundleOverZeroSection (twistOne 𝒜)).symm
    refine (congrArg (· ≫ _) (vectorBundleHomEquiv_coneToVectorBundle 𝒜)).trans ?_
    refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun U => ModuleCat.hom_ext
      (LinearMap.ext fun s => ?_))
    obtain ⟨U⟩ := U
    have hp := pushforwardAlgebraMap_app (zeroSectionOver 𝒜) U
      (preimage_le_preimage_preimage (zeroSectionOver 𝒜) U)
    exact (congrArg (fun k => k.hom (((ProjConeTwist.coneTwistHom 𝒜 1).val.app (op U)).hom s))
      hp).trans (ProjConeTwist.zeroSection_appLE_coneIota_eq_zero 𝒜 ((1 : ℕ) : ℤ)
        (by norm_num) U s)
  exact congrArg (fun k => k.left) h

/-- **Over `D₊(cb)` the ideal of the zero section of the cone is principal, generated by a
nonzerodivisor**: the image of `chartGenerator`, which corresponds to the fibre coordinate. -/
theorem ker_zeroSection_appLE_basicOpen_mul (hc : c ∈ 𝒜 (m + 1)) (hb : b ∈ 𝒜 m)
    (hcb : c * b = g) :
    _root_.IsRegular (coneSection 𝒜 _ (chartGenerator hc (DegreeOneUnitAway.mul_mem hc hb hcb))) ∧
      RingHom.ker ((zeroSection 𝒜).appLE (pi 𝒜 ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 g)
        (AlgebraicGeometry.Proj.basicOpen 𝒜 g)
        (ProjConeTwist.le_zeroSection_preimage_pi_preimage 𝒜 _)).hom =
        Ideal.span {coneSection 𝒜 _ (chartGenerator hc (DegreeOneUnitAway.mul_mem hc hb hcb))} := by
  set V := AlgebraicGeometry.Proj.basicOpen 𝒜 g
  set t := coneSection 𝒜 _ (chartGenerator hc (DegreeOneUnitAway.mul_mem hc hb hcb))
  set F := eval₂RingHom ((pi 𝒜).app V).hom t
  have hF : Function.Bijective F := bijective_eval₂_coneSection hc hb hcb
  set z := (zeroSection 𝒜).appLE (pi 𝒜 ⁻¹ᵁ V) V
    (ProjConeTwist.le_zeroSection_preimage_pi_preimage 𝒜 _)
  have hzpi : ∀ r, z.hom (((pi 𝒜).app V).hom r) = r := fun r =>
    appLE_app_of_comp_eq_id (zeroSection 𝒜) (pi 𝒜) (zeroSection_comp_pi 𝒜) V
      (ProjConeTwist.le_zeroSection_preimage_pi_preimage 𝒜 _) r
  have hzt : z.hom t = 0 :=
    ProjConeTwist.zeroSection_appLE_coneIota_eq_zero 𝒜 ((1 : ℕ) : ℤ) (by norm_num) V _
  have hcomp : z.hom.comp F = Polynomial.evalRingHom 0 := by
    refine Polynomial.ringHom_ext (fun r => ?_) ?_
    · rw [RingHom.comp_apply, coe_eval₂RingHom, eval₂_C, hzpi, coe_evalRingHom, eval_C]
    · rw [RingHom.comp_apply, coe_eval₂RingHom, eval₂_X, hzt, coe_evalRingHom, eval_X]
  have hker : RingHom.ker z.hom = (RingHom.ker (Polynomial.evalRingHom
      (0 : Γ(AlgebraicGeometry.Proj 𝒜, V)))).map F := by
    rw [← hcomp, ← RingHom.comap_ker, Ideal.map_comap_of_surjective _ hF.2]
  have hX : _root_.IsRegular (Polynomial.X : Polynomial Γ(AlgebraicGeometry.Proj 𝒜, V)) :=
    Polynomial.monic_X.isRegular
  have ht : F Polynomial.X = t := eval₂_X _ _
  refine ⟨⟨fun a a' h => ?_, fun a a' h => ?_⟩, ?_⟩
  · obtain ⟨p, rfl⟩ := hF.2 a
    obtain ⟨p', rfl⟩ := hF.2 a'
    have h' : F (Polynomial.X * p) = F (Polynomial.X * p') := by
      rw [map_mul, map_mul, ht]; exact h
    exact congrArg F (hX.1 (hF.1 h'))
  · obtain ⟨p, rfl⟩ := hF.2 a
    obtain ⟨p', rfl⟩ := hF.2 a'
    have h' : F (p * Polynomial.X) = F (p' * Polynomial.X) := by
      rw [map_mul, map_mul, ht]; exact h
    exact congrArg F (hX.2 (hF.1 h'))
  · rw [hker, Polynomial.ker_evalRingHom, map_zero, sub_zero, Ideal.map_span,
      Set.image_singleton, ht]

end Stacks.AlgebraicGeometry.ProjAndSpecInvertibleLocus

