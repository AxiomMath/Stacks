module

public import StacksFrontier.AlgebraicGeometry.Constructions.ProjTwistSectionComparison
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The homogeneous spectrum is quasi-separated

Let `S = ⨁_{d ≥ 0} 𝒮 d` be a graded ring and `X = Proj 𝒮`. Then `X` is quasi-separated, with no
hypothesis on `𝒮` whatsoever: the standard opens `D₊(f)` of the homogeneous elements `f` of
strictly positive degree cover `X`, each of them is affine, and the intersection of two of them is
`D₊(f g)`, again the standard open of a homogeneous element of positive degree and so again
affine, hence quasi-compact.

`Proj 𝒮` need not be quasi-compact: that needs the irrelevant ideal to be generated up to radical
by finitely many homogeneous elements. For projective space `ℙⁿ_R` quasi-compactness is
`Stacks.ProjAmple.compactSpace_proj_polyGrading`.

## Main results

* `Stacks.AlgebraicGeometry.ProjQuasiSeparated.iSup_basicOpen_positiveElem_eq_top` — the standard
  opens of the positive-degree homogeneous elements cover `Proj 𝒮`.
* `Stacks.AlgebraicGeometry.ProjQuasiSeparated.quasiSeparatedSpace_proj` — **`Proj 𝒮` is
  quasi-separated.**

## References

* [Stacks Project, Tag 01M4](https://stacks.math.columbia.edu/tag/01M4)
* [Stacks Project, Tag 01KO](https://stacks.math.columbia.edu/tag/01KO)
-/

@[expose] public section

open CategoryTheory TopologicalSpace
open AlgebraicGeometry
open Stacks.AlgebraicGeometry.ProjTwistComparison (PositiveElem)

namespace Stacks.AlgebraicGeometry.ProjQuasiSeparated

universe u w

variable {S : Type u} [CommRing S] {σ : Type w} [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

/-- **The standard opens of the positive-degree homogeneous elements cover `Proj 𝒮`.** A point of
`Proj 𝒮` is a homogeneous prime not containing the irrelevant ideal, which is generated by the
homogeneous elements of positive degree, so some such element does not vanish at it. -/
@[ega "II 3.1.6" "special case"]
public theorem iSup_basicOpen_positiveElem_eq_top :
    (⨆ p : PositiveElem 𝒮, AlgebraicGeometry.Proj.basicOpen 𝒮 p.1) = ⊤ := by
  refine top_le_iff.mp fun x _ => ?_
  by_contra hx
  refine x.not_irrelevant_le ((HomogeneousIdeal.irrelevant_le 𝒮).mpr fun d hd z hz => ?_)
  by_contra hzx
  exact hx (TopologicalSpace.Opens.mem_iSup.mpr
    ⟨⟨z, d, hd, hz⟩, (AlgebraicGeometry.Proj.mem_basicOpen 𝒮 z x).mpr hzx⟩)

/-- **`Proj 𝒮` is quasi-separated, for every graded ring `𝒮`.** It is covered by the affine opens
`D₊(f)` of the homogeneous elements of positive degree, and `D₊(f) ∩ D₊(g) = D₊(f g)` is one of
them again, hence quasi-compact. -/
public instance quasiSeparatedSpace_proj : QuasiSeparatedSpace (AlgebraicGeometry.Proj 𝒮) := by
  refine Scheme.quasiSeparatedSpace_of_isOpenCover
    (fun p : PositiveElem 𝒮 => AlgebraicGeometry.Proj.basicOpen 𝒮 p.1)
    (IsOpenCover.mk (iSup_basicOpen_positiveElem_eq_top 𝒮))
    (fun p => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒮 p.1 p.2.choose_spec.2
      p.2.choose_spec.1)
    fun p q => ?_
  have hmul : (p.1 * q.1) ∈ 𝒮 (p.2.choose + q.2.choose) :=
    SetLike.mul_mem_graded p.2.choose_spec.2 q.2.choose_spec.2
  have hpos : 0 < p.2.choose + q.2.choose := Nat.add_pos_left p.2.choose_spec.1 _
  have hcpt := (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒮 (p.1 * q.1) hmul hpos).isCompact
  rwa [AlgebraicGeometry.Proj.basicOpen_mul 𝒮 p.1 q.1, TopologicalSpace.Opens.coe_inf] at hcpt

end Stacks.AlgebraicGeometry.ProjQuasiSeparated

end
