* [Stacks Project, Tag 01MV](https://stacks.math.columbia.edu/tag/01MV)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite
open AlgebraicGeometry
open AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjInvertibleLocus
open Stacks.AlgebraicGeometry.ProjTwistSections
open Stacks.Veronese
open scoped DirectSum

namespace Stacks.AlgebraicGeometry.ProjDegreeOpenSections

attribute [local instance] ProjectiveSpectrum.isPrime
attribute [local instance_reducible] ProjectiveSpectrum.top
attribute [local implicit_reducible] TopCat.Sheaf sheafCompose

universe u w

variable {S : Type u} {σ : Type w} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

/-! ### The degree `d` open is a good open -/

/-- The degree `d` open lies in the locus where the ratio of two homogeneous elements whose
degrees differ by `d` trivializes the `d`-divisible twists: a homogeneous `f` of degree `d`
contributes the pair `(f, 1)`. -/
public theorem degreeOpen_le_ratioLocus (d : ℕ) :
    Proj.degreeOpen 𝒮 d ≤ ProjShared.ratioLocus 𝒮 d :=
  iSup_le fun f => ProjShared.basicOpen_le_ratioLocus 𝒮 dvd_rfl f.2

/-- **The degree `d` open is a good open for `d`**: every twist `𝒪(dn)` restricts to an
invertible module on it and every multiplication map between those twists restricts to an
isomorphism. No quasi-compactness is needed. -/
public theorem isGoodOpen_degreeOpen (d : ℕ) : IsGoodOpen 𝒮 d (Proj.degreeOpen 𝒮 d) :=
  GoodOpenClose.isGoodOpen_of_le_ratioLocus 𝒮 d (degreeOpen_le_ratioLocus 𝒮 d)

/-- The degree `d` open lies in the largest open on which the `d`-divisible twists are
invertible. -/
public theorem degreeOpen_le_whereInvertible (d : ℕ) :
    Proj.degreeOpen 𝒮 d ≤ whereInvertible 𝒮 d :=
  le_whereInvertible_of_isGoodOpen 𝒮 (isGoodOpen_degreeOpen 𝒮 d)

/-! ### Sections of the twists over an open -/

variable (Y : Opens (ProjectiveSpectrum.top 𝒮))

/-- The sections of the `k`-th twist `𝒪(k)` over an open `Y ⊆ Proj 𝒮`. -/
public abbrev twistSections (k : ℕ) : Type u :=
  (twistingSheaf 𝒮 (k : ℤ)).val.obj (op Y)

/-- The value of a sum of sections at a point is the sum of the values. -/
@[simp] public theorem add_apply (k : ℕ) (s t : twistSections 𝒮 Y k) (x : Y) :
    (s + t).1 x = s.1 x + t.1 x := rfl

/-- The zero section has value zero at every point. -/
@[simp] public theorem zero_apply (k : ℕ) (x : Y) :
    (0 : twistSections 𝒮 Y k).1 x = 0 := rfl

/-- Transporting a section along an equality of twist degrees does not change its values. -/
@[simp] public theorem cast_apply {k l : ℕ} (h : k = l) (s : twistSections 𝒮 Y k) (x : Y) :
    (cast (congrArg (twistSections 𝒮 Y) h) s).1 x = s.1 x := by
  cases h
  rfl

/-- Two sections of the same twist with the same value at every point are equal. -/
public theorem section_ext {k : ℕ} {s t : twistSections 𝒮 Y k}
    (h : ∀ x : Y, s.1 x = t.1 x) : s = t :=
  (associatedModuleSheafSectionsEquiv 𝒮 (twistGrading (S := S) 𝒮 (k : ℤ)) Y).injective
    (Subtype.ext (funext h))

/-- The restriction to `Y` of a global section of the `k`-th twist. -/
public def restrict (k : ℕ) (s : twistGlobalSections 𝒮 k) : twistSections 𝒮 Y k :=
  (twistingSheaf 𝒮 (k : ℤ)).val.map (homOfLE (le_top : Y ≤ ⊤)).op s

/-- The restriction of a global section has the same value at every point of `Y`. -/
@[simp] public theorem restrict_apply (k : ℕ) (s : twistGlobalSections 𝒮 k) (x : Y) :
    (restrict 𝒮 Y k s).1 x = s.1 ⟨x.1, trivial⟩ := rfl

/-- Restriction to `Y` as an additive homomorphism. -/
public def restrictHom (k : ℕ) : twistGlobalSections 𝒮 k →+ twistSections 𝒮 Y k where
  toFun := restrict 𝒮 Y k
  map_zero' := section_ext 𝒮 Y fun x => by
    rw [zero_apply]
    exact ProjTwistSectionRing.zero_apply 𝒮 k _
  map_add' s t := section_ext 𝒮 Y fun x => by
    rw [add_apply]
    exact ProjTwistSectionRing.add_apply 𝒮 k s t _

/-- `restrictHom` is `restrict`. -/
@[simp] public theorem restrictHom_apply (k : ℕ) (s : twistGlobalSections 𝒮 k) :
    restrictHom 𝒮 Y k s = restrict 𝒮 Y k s := rfl

/-- The pointwise product of a section of `𝒪(k)` and a section of `𝒪(l)` over `Y`, as a section
of `𝒪(k + l)`: at each point the two local fractions multiply. -/
public def mul (k l : ℕ) (s : twistSections 𝒮 Y k) (t : twistSections 𝒮 Y l) :
    twistSections 𝒮 Y (k + l) :=
  (associatedModuleSheafSectionsEquiv 𝒮 (twistGrading (S := S) 𝒮 ((k + l : ℕ) : ℤ)) Y).symm
    ⟨fun x => s.1 x * t.1 x, by
      rw [show ((k + l : ℕ) : ℤ) = (k : ℤ) + (l : ℤ) from by push_cast; ring]
      exact Stacks.ProjTwistMultiplication.mul_mem_moduleSections 𝒮 s t⟩

/-- The pointwise product has the product of the values at every point. -/
@[simp] public theorem mul_apply (k l : ℕ) (s : twistSections 𝒮 Y k) (t : twistSections 𝒮 Y l)
    (x : Y) : (mul 𝒮 Y k l s t).1 x = s.1 x * t.1 x := rfl

/-- Restriction to `Y` carries the product of two global sections to the product of their
restrictions. -/
public theorem mul_restrict (k l : ℕ) (s : twistGlobalSections 𝒮 k)
    (t : twistGlobalSections 𝒮 l) :
    mul 𝒮 Y k l (restrict 𝒮 Y k s) (restrict 𝒮 Y l t) =
      restrict 𝒮 Y (k + l) (ProjTwistSectionRing.mul 𝒮 k l s t) :=
  section_ext 𝒮 Y fun x => by
    rw [mul_apply, restrict_apply, restrict_apply, restrict_apply,
      ProjTwistSectionRing.mul_apply]

/-! ### The `d`-th Veronese section ring of an open -/

variable (d : ℕ)

/-- The degree `n` piece of the `d`-th Veronese section ring of `Y`: the sections of `𝒪(nd)`
over `Y`. -/
public abbrev veroneseTwistSections (n : ℕ) : Type u := twistSections 𝒮 Y (n * d)

/-- Transporting a section along an equality of Veronese degrees does not change its values. -/
@[simp] public theorem veroneseCast_apply {n m : ℕ} (h : n = m)
    (s : veroneseTwistSections 𝒮 Y d n) (x : Y) :
    (cast (congrArg (veroneseTwistSections 𝒮 Y d) h) s).1 x = s.1 x := by
  cases h
  rfl

/-- The pointwise product of a section of `𝒪(nd)` and a section of `𝒪(md)`, as a section of
`𝒪((n + m)d)`. -/
public def veroneseMul (n m : ℕ) (s : veroneseTwistSections 𝒮 Y d n)
    (t : veroneseTwistSections 𝒮 Y d m) : veroneseTwistSections 𝒮 Y d (n + m) :=
  cast (congrArg (twistSections 𝒮 Y) (add_mul n m d).symm) (mul 𝒮 Y (n * d) (m * d) s t)

/-- The Veronese product has the product of the values at every point. -/
@[simp] public theorem veroneseMul_apply (n m : ℕ) (s : veroneseTwistSections 𝒮 Y d n)
    (t : veroneseTwistSections 𝒮 Y d m) (x : Y) :
    (veroneseMul 𝒮 Y d n m s t).1 x = s.1 x * t.1 x := by
  rw [veroneseMul, cast_apply 𝒮 Y (add_mul n m d).symm, mul_apply]

/-- The section of `𝒪(nd)` over `Y` attached to a homogeneous element of degree `nd`: the global
section of Tag 01MP, restricted to `Y`. -/
public def veroneseSection (n : ℕ) (f : 𝒮 (n * d)) : veroneseTwistSections 𝒮 Y d n :=
  restrict 𝒮 Y (n * d) (degreeSection 𝒮 (n * d) f)

/-- The section attached to `f` has value the fraction `f / 1` at every point. -/
@[simp] public theorem veroneseSection_apply (n : ℕ) (f : 𝒮 (n * d)) (x : Y) :
    (veroneseSection 𝒮 Y d n f).1 x =
      LocalizedModule.mk (f : S) (1 : (x.1).asHomogeneousIdeal.toIdeal.primeCompl) := by
  rw [veroneseSection, restrict_apply, degreeSection_apply]

/-- The unit of the `d`-th Veronese section ring: the section attached to `1`, of degree `0`. -/
public def veroneseOne : veroneseTwistSections 𝒮 Y d 0 :=
  veroneseSection 𝒮 Y d 0 ⟨1, by rw [zero_mul]; exact SetLike.one_mem_graded 𝒮⟩

/-- The unit section has value `1` at every point. -/
@[simp] public theorem veroneseOne_apply (x : Y) : (veroneseOne 𝒮 Y d).1 x = 1 := by
  rw [veroneseOne, veroneseSection_apply]
  exact (OreLocalization.one_def ..).symm

/-! ### Bilinearity and the graded-monoid laws -/

/-- The Veronese product with the zero section on the right is zero. -/
public theorem veroneseMul_zero_right (n m : ℕ) (s : veroneseTwistSections 𝒮 Y d n) :
    veroneseMul 𝒮 Y d n m s 0 = 0 :=
  section_ext 𝒮 Y fun x => by rw [veroneseMul_apply, zero_apply, zero_apply, mul_zero]

/-- The Veronese product with the zero section on the left is zero. -/
public theorem veroneseZero_mul_left (n m : ℕ) (t : veroneseTwistSections 𝒮 Y d m) :
    veroneseMul 𝒮 Y d n m 0 t = 0 :=
  section_ext 𝒮 Y fun x => by rw [veroneseMul_apply, zero_apply, zero_apply, zero_mul]

/-- The Veronese product is additive in the right factor. -/
public theorem veroneseMul_add_right (n m : ℕ) (s : veroneseTwistSections 𝒮 Y d n)
    (t₁ t₂ : veroneseTwistSections 𝒮 Y d m) :
    veroneseMul 𝒮 Y d n m s (t₁ + t₂) =
      veroneseMul 𝒮 Y d n m s t₁ + veroneseMul 𝒮 Y d n m s t₂ :=
  section_ext 𝒮 Y fun x => by
    rw [veroneseMul_apply, add_apply, add_apply, veroneseMul_apply, veroneseMul_apply, mul_add]

/-- The Veronese product is additive in the left factor. -/
public theorem veroneseAdd_mul_left (n m : ℕ) (s₁ s₂ : veroneseTwistSections 𝒮 Y d n)
    (t : veroneseTwistSections 𝒮 Y d m) :
    veroneseMul 𝒮 Y d n m (s₁ + s₂) t =
      veroneseMul 𝒮 Y d n m s₁ t + veroneseMul 𝒮 Y d n m s₂ t :=
  section_ext 𝒮 Y fun x => by
    rw [veroneseMul_apply, add_apply, add_apply, veroneseMul_apply, veroneseMul_apply, add_mul]

/-- The unit section is a left unit for the Veronese product, up to the transport along
`0 + j = j`. -/
public theorem veroneseCast_one_mul (j : ℕ) (s : veroneseTwistSections 𝒮 Y d j) :
    cast (congrArg (veroneseTwistSections 𝒮 Y d) (zero_add j))
      (veroneseMul 𝒮 Y d 0 j (veroneseOne 𝒮 Y d) s) = s :=
  section_ext 𝒮 Y fun x => by
    rw [veroneseCast_apply 𝒮 Y d (zero_add j), veroneseMul_apply, veroneseOne_apply, one_mul]

/-- The unit section is a right unit for the Veronese product, up to the transport along
`j + 0 = j`. -/
public theorem veroneseCast_mul_one (j : ℕ) (s : veroneseTwistSections 𝒮 Y d j) :
    cast (congrArg (veroneseTwistSections 𝒮 Y d) (add_zero j))
      (veroneseMul 𝒮 Y d j 0 s (veroneseOne 𝒮 Y d)) = s :=
  section_ext 𝒮 Y fun x => by
    rw [veroneseCast_apply 𝒮 Y d (add_zero j), veroneseMul_apply, veroneseOne_apply, mul_one]

/-- The Veronese product is associative, up to the transport along `i + j + k = i + (j + k)`. -/
public theorem veroneseCast_mul_assoc (i j k : ℕ) (a : veroneseTwistSections 𝒮 Y d i)
    (b : veroneseTwistSections 𝒮 Y d j) (c : veroneseTwistSections 𝒮 Y d k) :
    cast (congrArg (veroneseTwistSections 𝒮 Y d) (add_assoc i j k))
        (veroneseMul 𝒮 Y d (i + j) k (veroneseMul 𝒮 Y d i j a b) c) =
      veroneseMul 𝒮 Y d i (j + k) a (veroneseMul 𝒮 Y d j k b c) :=
  section_ext 𝒮 Y fun x => by
    rw [veroneseCast_apply 𝒮 Y d (add_assoc i j k), veroneseMul_apply, veroneseMul_apply,
      veroneseMul_apply, veroneseMul_apply, mul_assoc]

/-- The Veronese product is commutative, up to the transport along `i + j = j + i`. -/
public theorem veroneseCast_mul_comm (i j : ℕ) (a : veroneseTwistSections 𝒮 Y d i)
    (b : veroneseTwistSections 𝒮 Y d j) :
    cast (congrArg (veroneseTwistSections 𝒮 Y d) (add_comm i j)) (veroneseMul 𝒮 Y d i j a b) =
      veroneseMul 𝒮 Y d j i b a :=
  section_ext 𝒮 Y fun x => by
    rw [veroneseCast_apply 𝒮 Y d (add_comm i j), veroneseMul_apply, veroneseMul_apply, mul_comm]

/-- **The `d`-th Veronese section ring of `Y` is a graded commutative ring**, with degree `n`
piece `Γ(Y, 𝒪(nd))`, product the pointwise product of local fractions, and unit the section
attached to `1`. -/
@[instance_reducible] public def veroneseGradedRing :
    DirectSum.GCommRing (veroneseTwistSections 𝒮 Y d) := by
  letI : GradedMonoid.GMul (veroneseTwistSections 𝒮 Y d) :=
    ⟨fun {n m} => veroneseMul 𝒮 Y d n m⟩
  letI : GradedMonoid.GOne (veroneseTwistSections 𝒮 Y d) := ⟨veroneseOne 𝒮 Y d⟩
  refine
    { mul := fun {n m} => veroneseMul 𝒮 Y d n m
      one := veroneseOne 𝒮 Y d
      mul_zero := fun {n m} s => veroneseMul_zero_right 𝒮 Y d n m s
      zero_mul := fun {n m} t => veroneseZero_mul_left 𝒮 Y d n m t
      mul_add := fun {n m} s t₁ t₂ => veroneseMul_add_right 𝒮 Y d n m s t₁ t₂
      add_mul := fun {n m} s₁ s₂ t => veroneseAdd_mul_left 𝒮 Y d n m s₁ s₂ t
      one_mul := ?_
      mul_one := ?_
      mul_assoc := ?_
      mul_comm := ?_
      natCast := fun k => k • veroneseOne 𝒮 Y d
      natCast_zero := zero_nsmul (veroneseOne 𝒮 Y d)
      natCast_succ := fun k => succ_nsmul (veroneseOne 𝒮 Y d) k
      intCast := fun z => z • veroneseOne 𝒮 Y d
      intCast_ofNat := fun k => natCast_zsmul (veroneseOne 𝒮 Y d) k
      intCast_negSucc_ofNat := fun k => negSucc_zsmul (veroneseOne 𝒮 Y d) k }
  · rintro ⟨j, s⟩
    exact Sigma.ext (zero_add j)
      (heq_of_cast_eq (congrArg (veroneseTwistSections 𝒮 Y d) (zero_add j))
        (veroneseCast_one_mul 𝒮 Y d j s))
  · rintro ⟨j, s⟩
    exact Sigma.ext (add_zero j)
      (heq_of_cast_eq (congrArg (veroneseTwistSections 𝒮 Y d) (add_zero j))
        (veroneseCast_mul_one 𝒮 Y d j s))
  · rintro ⟨i, a⟩ ⟨j, b⟩ ⟨k, c⟩
    exact Sigma.ext (add_assoc i j k)
      (heq_of_cast_eq (congrArg (veroneseTwistSections 𝒮 Y d) (add_assoc i j k))
        (veroneseCast_mul_assoc 𝒮 Y d i j k a b c))
  · rintro ⟨i, a⟩ ⟨j, b⟩
    exact Sigma.ext (add_comm i j)
      (heq_of_cast_eq (congrArg (veroneseTwistSections 𝒮 Y d) (add_comm i j))
        (veroneseCast_mul_comm 𝒮 Y d i j a b))

/-- `Γ_*(Y, 𝒪_Y(d)) = ⨁_{n ≥ 0} Γ(Y, 𝒪_Y(nd))`, the `d`-th Veronese section ring of `Y`. -/
public abbrev veroneseSectionRing : Type u := ⨁ n : ℕ, veroneseTwistSections 𝒮 Y d n

/-- The degree `n` homogeneous component of `Γ_*(Y, 𝒪_Y(d))`: the image of the `n`-th
summand. -/
public def veroneseSectionRingGrading (n : ℕ) :
    AddSubgroup (veroneseSectionRing 𝒮 Y d) :=
  (DirectSum.of (veroneseTwistSections 𝒮 Y d) n).range

/-- The homogeneous components of the Veronese section ring are closed under the product and
contain the unit. -/
public theorem veroneseSectionRingGrading_gradedMonoid :
    letI := veroneseGradedRing 𝒮 Y d
    SetLike.GradedMonoid (veroneseSectionRingGrading 𝒮 Y d) :=
  let := veroneseGradedRing 𝒮 Y d
  { one_mem := ⟨_, (DirectSum.one_def _).symm⟩
    mul_mem := by
      rintro n m s t ⟨s, rfl⟩ ⟨t, rfl⟩
      exact ⟨_, (DirectSum.of_mul_of (A := veroneseTwistSections 𝒮 Y d) s t).symm⟩ }

/-! ### The map `ψ^d` -/

/-- At a point of `Y`, the product of the fractions `p / 1` and `q / 1` is `p * q / 1`. -/
private theorem mk_one_mul_mk_one (x : Y) (p q : S) :
    (LocalizedModule.mk p (1 : (x.1).asHomogeneousIdeal.toIdeal.primeCompl)) *
        LocalizedModule.mk q (1 : (x.1).asHomogeneousIdeal.toIdeal.primeCompl) =
      LocalizedModule.mk (p * q) (1 : (x.1).asHomogeneousIdeal.toIdeal.primeCompl) :=
  Eq.trans LocalizedModule.mk_mul_mk
    (congrArg (LocalizedModule.mk (p * q)) (mul_one 1))

/-- The product of the sections attached to two homogeneous elements of Veronese degrees `n` and
`m` is the section attached to their product. -/
public theorem veroneseMul_veroneseSection (n m : ℕ) (f : 𝒮 (n * d)) (g : 𝒮 (m * d)) :
    veroneseMul 𝒮 Y d n m (veroneseSection 𝒮 Y d n f) (veroneseSection 𝒮 Y d m g) =
      veroneseSection 𝒮 Y d (n + m)
        ⟨(f : S) * (g : S), by rw [add_mul]; exact SetLike.mul_mem_graded f.2 g.2⟩ :=
  section_ext 𝒮 Y fun x => by
    rw [veroneseMul_apply, veroneseSection_apply, veroneseSection_apply, veroneseSection_apply]
    exact mk_one_mul_mk_one 𝒮 Y x _ _

/-- The degree `n` piece of the Veronese subring is the degree `nd` piece of `S`. -/
public def veroneseGradingHom (n : ℕ) : veroneseGrading 𝒮 d n →+ 𝒮 (n * d) where
  toFun a := ⟨((a : veroneseSubring 𝒮 d) : S), a.2⟩
  map_zero' := rfl
  map_add' _ _ := rfl

/-- The degreewise map of `ψ^d`, as an additive homomorphism out of the degree `n` piece of the
Veronese subring. -/
public def veroneseSectionHom (n : ℕ) :
    veroneseGrading 𝒮 d n →+ veroneseTwistSections 𝒮 Y d n :=
  (restrictHom 𝒮 Y (n * d)).comp
    ((degreeSectionHom 𝒮 (n * d)).comp (veroneseGradingHom 𝒮 d n))

/-- `veroneseSectionHom` sends `a` to the section attached to its image in `𝒮 (n * d)`. -/
@[simp] public theorem veroneseSectionHom_apply (n : ℕ) (a : veroneseGrading 𝒮 d n) :
    veroneseSectionHom 𝒮 Y d n a =
      veroneseSection 𝒮 Y d n (veroneseGradingHom 𝒮 d n a) := rfl

/-- The section attached to the unit of the Veronese subring is the unit section. -/
public theorem veroneseSectionHom_one :
    veroneseSectionHom 𝒮 Y d 0 1 = veroneseOne 𝒮 Y d :=
  section_ext 𝒮 Y fun x => by
    rw [veroneseSectionHom_apply, veroneseSection_apply, veroneseOne_apply]
    exact (OreLocalization.one_def (R := S) ..).symm

/-- The section attached to the product of two homogeneous elements of the Veronese subring is
the pointwise product of the two sections. -/
public theorem veroneseSectionHom_mul (n m : ℕ) (a : veroneseGrading 𝒮 d n)
    (b : veroneseGrading 𝒮 d m) :
    veroneseSectionHom 𝒮 Y d (n + m)
        (GradedMonoid.GMul.mul (A := fun i => (veroneseGrading 𝒮 d i : Type u)) a b) =
      veroneseMul 𝒮 Y d n m (veroneseSectionHom 𝒮 Y d n a) (veroneseSectionHom 𝒮 Y d m b) :=
  section_ext 𝒮 Y fun x => by
    rw [veroneseMul_apply, veroneseSectionHom_apply, veroneseSectionHom_apply,
      veroneseSectionHom_apply, veroneseSection_apply, veroneseSection_apply,
      veroneseSection_apply]
    exact (mk_one_mul_mk_one 𝒮 Y x _ _).symm

/-- The ring map `⨁_n 𝒮 (nd) ⟶ Γ_*(Y, 𝒪_Y(d))` assembled from the degreewise section maps. -/
public def veroneseSumHom :
    letI := veroneseGradedRing 𝒮 Y d
    (⨁ n : ℕ, veroneseGrading 𝒮 d n) →+* veroneseSectionRing 𝒮 Y d :=
  letI := veroneseGradedRing 𝒮 Y d
  DirectSum.toSemiring
    (fun n => (DirectSum.of (veroneseTwistSections 𝒮 Y d) n).comp (veroneseSectionHom 𝒮 Y d n))
    (by
      rw [AddMonoidHom.comp_apply, DirectSum.one_def]
      exact congrArg (DirectSum.of (veroneseTwistSections 𝒮 Y d) 0)
        (veroneseSectionHom_one 𝒮 Y d))
    (by
      intro n m a b
      rw [AddMonoidHom.comp_apply, AddMonoidHom.comp_apply, AddMonoidHom.comp_apply,
        DirectSum.of_mul_of]
      exact congrArg (DirectSum.of (veroneseTwistSections 𝒮 Y d) (n + m))
        (veroneseSectionHom_mul 𝒮 Y d n m a b))

/-- On a homogeneous summand the assembled ring map is the degreewise section map. -/
public theorem veroneseSumHom_of (n : ℕ) (a : veroneseGrading 𝒮 d n) :
    letI := veroneseGradedRing 𝒮 Y d
    veroneseSumHom 𝒮 Y d (DirectSum.of (fun i => (veroneseGrading 𝒮 d i : Type u)) n a) =
      DirectSum.of (veroneseTwistSections 𝒮 Y d) n (veroneseSectionHom 𝒮 Y d n a) :=
  DirectSum.toAddMonoid_of
    (fun n => (DirectSum.of (veroneseTwistSections 𝒮 Y d) n).comp (veroneseSectionHom 𝒮 Y d n))
    n a

/-- The graded ring homomorphism `S^(d) ⟶ ⨁_{n ≥ 0} Γ(Y, 𝒪(nd))`, sending a homogeneous
element of degree `nd` to the restriction to `Y` of the global section of `𝒪(nd)` it determines.

This is the twist form of the map `ψ^d` of Stacks Equation 01N6: its degree `n` target is the
group of sections of the twist `𝒪(nd)` itself, not of the `n`-th tensor power of `𝒪_{U_d}(d)`,
so its target is not the graded ring `Γ_*(U_d, 𝒪_{U_d}(d))` of [Stacks, Tag 01CV]. The map of
Equation 01N6, into that ring, is
`Stacks.AlgebraicGeometry.ProjDegreeOpenPsiTensor.psiTensor`. -/
public def psi (hd : 0 < d) :
    letI := veroneseGradingGradedRing 𝒮 d hd
    letI := veroneseGradedRing 𝒮 Y d
    veroneseGrading 𝒮 d →+*ᵍ veroneseSectionRingGrading 𝒮 Y d :=
  letI := veroneseGradingGradedRing 𝒮 d hd
  letI := veroneseGradedRing 𝒮 Y d
  { __ := (veroneseSumHom 𝒮 Y d).comp
      (DirectSum.decomposeRingEquiv (veroneseGrading 𝒮 d)).toRingHom
    map_mem := fun {n x} hx =>
      ⟨veroneseSectionHom 𝒮 Y d n ⟨x, hx⟩,
        (Eq.trans
          (congrArg (veroneseSumHom 𝒮 Y d)
            (DirectSum.decompose_of_mem (veroneseGrading 𝒮 d) hx))
          (veroneseSumHom_of 𝒮 Y d n ⟨x, hx⟩)).symm⟩ }

/-- On a homogeneous element of Veronese degree `n`, `ψ^d` is the restriction to `Y` of the
global section of `𝒪(nd)` attached to it, placed in the degree `n` summand. -/
public theorem psi_apply_homogeneous (hd : 0 < d) (n : ℕ) (a : veroneseGrading 𝒮 d n) :
    letI := veroneseGradingGradedRing 𝒮 d hd
    letI := veroneseGradedRing 𝒮 Y d
    psi 𝒮 Y d hd (a : veroneseSubring 𝒮 d) =
      DirectSum.of (veroneseTwistSections 𝒮 Y d) n (veroneseSectionHom 𝒮 Y d n a) :=
  let := veroneseGradingGradedRing 𝒮 d hd
  let := veroneseGradedRing 𝒮 Y d
  Eq.trans
    (congrArg (veroneseSumHom 𝒮 Y d) (DirectSum.decompose_of_mem (veroneseGrading 𝒮 d) a.2))
    (veroneseSumHom_of 𝒮 Y d n a)

/-! ### Global generation in degree one -/

/-- **Global generation of `𝒪_{U_d}(d)` by the image of `ψ^d` in degree one.** The nonvanishing
locus on `U_d` of the section attached to a homogeneous `f` of degree `d` is `D₊(f) ∩ U_d`; since
the `D₊(f)` for `f ∈ 𝒮 d` cover `U_d` by definition, the sections in the image of `ψ^d` in degree
one generate. -/
@[stacks 01N6 "global generation in degree one"]
public theorem nonvanishingLocus_veroneseSection_inter (f : 𝒮 (1 * d)) :
    Stacks.SheafOfModules.nonvanishingLocus
          (X := (AlgebraicGeometry.Proj 𝒮).toRingedSpace)
          (twistingSheaf 𝒮 ((1 * d : ℕ) : ℤ))
          (Stacks.SheafOfModules.sectionsOfTop _ (degreeSection 𝒮 (1 * d) f)) ∩
        (Proj.degreeOpen 𝒮 d : Set (AlgebraicGeometry.Proj 𝒮)) =
      (Proj.basicOpen 𝒮 (f : S) : Set (AlgebraicGeometry.Proj 𝒮)) ∩
        (Proj.degreeOpen 𝒮 d : Set (AlgebraicGeometry.Proj 𝒮)) :=
  Set.ext fun _z => and_congr_left fun hz =>
    mem_nonvanishingLocus_degreeSection_iff 𝒮 d 1 f (degreeOpen_le_whereInvertible 𝒮 d hz)

/-- The degree `d` open is the union of the standard opens of the homogeneous elements of degree
exactly `d`, which is the covering that makes the previous statement a generation statement. -/
public theorem degreeOpen_eq_iSup_basicOpen :
    Proj.degreeOpen 𝒮 d = ⨆ f : 𝒮 d, Proj.basicOpen 𝒮 (f : S) := rfl

end Stacks.AlgebraicGeometry.ProjDegreeOpenSections

end
