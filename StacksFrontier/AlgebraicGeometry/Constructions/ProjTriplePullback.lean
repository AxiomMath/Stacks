variable {σ : Type w} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-! ### Pulling a global section of a tensor power back, additively -/

section Sections

variable {Y Y' : Scheme.{u}} (L : Y.Modules) [IsInvertibleModule Y L] (h : Y' ⟶ Y)

/-- Pulling a global section of `L ^⊗ n` back along `h`, as an additive map. -/
def pullSectionHom (n : ℕ) :
    Γ(natTensorPow L n, ⊤) →+ Γ(natTensorPow ((Scheme.Modules.pullback h).obj L) n, ⊤) :=
  AddMonoidHom.mk' (pullSection h L n) fun x y => by
    simp only [pullSection, map_add]

/-- `pullSectionHom` is `pullSection`. -/
@[simp] theorem pullSectionHom_apply (n : ℕ) (x : Γ(natTensorPow L n, ⊤)) :
    pullSectionHom L h n x = pullSection h L n x := rfl

end Sections

/-! ### The pullback of the graded map -/

section Pullback

variable {Y Y' : Scheme.{u}} {d : ℕ} {L : Y.Modules} [IsInvertibleModule Y L]

/-- The pullback `h^* ∘ ψ` of the graded map of a triple along a morphism of schemes
`h : Y' ⟶ Y`, a graded map `A^{(d)} ⟶ Γ_*(Y', h^*L)`: in degree `n` it is the degree-`n`
component of `ψ` followed by the pullback of a global section of `L ^⊗ n`. -/
def pullbackSections (ψ : VeroneseSections 𝒜 d L) (h : Y' ⟶ Y) :
    VeroneseSections 𝒜 d ((Scheme.Modules.pullback h).obj L) where
  toFun n := (pullSectionHom L h n).comp (ψ.toFun n)
  map_mul n m a b ab hab := by
    change pullSection h L (n + m) (ψ.toFun (n + m) ab)
      = mulSections ((Scheme.Modules.pullback h).obj L)
          (pullSection h L n (ψ.toFun n a)) (pullSection h L m (ψ.toFun m b))
    rw [ψ.map_mul n m a b ab hab, pullSection_mulSections]

/-- The degree-`n` component of `pullbackSections 𝒜 ψ h` is that of `ψ` followed by
`pullSection`. -/
@[simp] theorem pullbackSections_toFun (ψ : VeroneseSections 𝒜 d L) (h : Y' ⟶ Y) (n : ℕ)
    (a : 𝒜 (n * d)) :
    (pullbackSections 𝒜 ψ h).toFun n a = pullSection h L n (ψ.toFun n a) := rfl

/-- The powers of the trivializing section of the pulled-back map are the pullbacks of those of
`ψ`. -/
theorem pullbackSections_pow (ψ : VeroneseSections 𝒜 d L) (h : Y' ⟶ Y) {f : A}
    (hf : f ∈ 𝒜 d) (n : ℕ) :
    (pullbackSections 𝒜 ψ h).pow hf n = pullSection h L n (ψ.pow hf n) := rfl

variable [Stacks.Ample.IsInvertibleModule Y L]

/-- The nonvanishing open of a degree-`d` value of the pulled-back map is the preimage of the
nonvanishing open of the corresponding value of `ψ`. -/
theorem nonvanishingOpen_psiSection_pullbackSections (ψ : VeroneseSections 𝒜 d L) (h : Y' ⟶ Y)
    (f : 𝒜 d) :
    nonvanishingOpen Y' ((Scheme.Modules.pullback h).obj L)
        (psiSection 𝒜 (pullbackSections 𝒜 ψ h) f)
      = h ⁻¹ᵁ nonvanishingOpen Y L (psiSection 𝒜 ψ f) := by
  rw [nonvanishingOpen_psiSection 𝒜 (pullbackSections 𝒜 ψ h) f, nonvanishingOpen_psiSection 𝒜 ψ f,
    pullbackSections_pow 𝒜 ψ h f.2 1, nonvanishingOpen_pullSection h L 1 (ψ.pow f.2 1)]

/-- If the nonvanishing opens of the degree-`d` values of `ψ` cover `Y`, then those of
`h^* ∘ ψ` cover `Y'`. -/
theorem iSup_nonvanishingOpen_pullbackSections (ψ : VeroneseSections 𝒜 d L) (h : Y' ⟶ Y)
    (hgen : ⨆ f : 𝒜 d, nonvanishingOpen Y L (psiSection 𝒜 ψ f) = ⊤) :
    (⨆ f : 𝒜 d, nonvanishingOpen Y' ((Scheme.Modules.pullback h).obj L)
      (psiSection 𝒜 (pullbackSections 𝒜 ψ h) f)) = ⊤ := by
  calc (⨆ f : 𝒜 d, nonvanishingOpen Y' ((Scheme.Modules.pullback h).obj L)
        (psiSection 𝒜 (pullbackSections 𝒜 ψ h) f))
      = ⨆ f : 𝒜 d, h ⁻¹ᵁ nonvanishingOpen Y L (psiSection 𝒜 ψ f) :=
        iSup_congr fun f => nonvanishingOpen_psiSection_pullbackSections 𝒜 ψ h f
    _ = h ⁻¹ᵁ ⨆ f : 𝒜 d, nonvanishingOpen Y L (psiSection 𝒜 ψ f) :=
        (Scheme.Hom.preimage_iSup h _).symm
    _ = ⊤ := by rw [hgen, Scheme.Hom.preimage_top]

end Pullback

/-! ### The pullback of a triple -/

section Triple

variable {Y Y' : Scheme.{u}}

/-- For `h : Y' ⟶ Y`, the pullback of the triple `(d, L, ψ)` over `Y` is the triple
`(d, h^*L, h^* ∘ ψ)` over `Y'`: the same integer `d`, the pullback of the invertible module, and
the degreewise pullback `pullbackSections` of the graded map. -/
@[stacks 01N4 "the pullback of a triple along a morphism of schemes h : Y' ⟶ Y: the triple \
(d, h^*L, h^* ∘ ψ), in the VeroneseSections spelling of the graded map that Tag 01N8 and Tag 01N9 \
are stated in. The two functor laws — that the pullback along an identity and the pullback along \
a composite are STRICTLY EQUIVALENT to the triple and to the twice-pulled-back triple — are \
ProjTripleFunctorLaws.sectionsEquiv_pullbackTriple_id and sectionsEquiv_pullbackTriple_comp. The \
functor F_d itself, i.e. the quotient of the triples by strict equivalence with this pullback on \
morphisms, is ProjTripleDegreeFunctor.Fd.functor; it is built at a fixed weight, on a carrier \
that takes the weight as a parameter rather than as a field, because strict equivalence compares \
two graded maps of the same weight and a triple-level version would need a transport"]
def pullbackTriple (t : ProjTripleClassifying.Triple 𝒜 Y) (h : Y' ⟶ Y) :
    ProjTripleClassifying.Triple 𝒜 Y' where
  deg := t.deg
  deg_pos := t.deg_pos
  module := (Scheme.Modules.pullback h).obj t.module
  isInvertible := haveI := t.isInvertible; inferInstance
  psi := haveI := t.isInvertible; pullbackSections 𝒜 t.psi h
  generated := haveI := t.isInvertible
    iSup_nonvanishingOpen_pullbackSections 𝒜 t.psi h t.generated

/-- The integer of the pullback of a triple is that of the triple. -/
@[simp] theorem pullbackTriple_deg (t : ProjTripleClassifying.Triple 𝒜 Y) (h : Y' ⟶ Y) :
    (pullbackTriple 𝒜 t h).deg = t.deg := rfl

/-- The invertible module of the pullback of a triple along `h` is the pullback along `h` of
that of the triple. -/
@[simp] theorem pullbackTriple_module (t : ProjTripleClassifying.Triple 𝒜 Y) (h : Y' ⟶ Y) :
    (pullbackTriple 𝒜 t h).module = (Scheme.Modules.pullback h).obj t.module := rfl

end Triple

end Stacks.AlgebraicGeometry.ProjTriplePullback

