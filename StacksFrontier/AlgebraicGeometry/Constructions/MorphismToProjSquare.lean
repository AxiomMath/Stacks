universe u w

namespace Stacks.AlgebraicGeometry.MorphismToProjSquare

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory

variable {σ : Type w} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] {d : ℕ} {Y : Scheme.{u}}

/-- **The morphism classified by `ψ^d_φ = φ^* ∘ ψ^d` is `φ`.** -/
theorem classifyingHom_pullbackSections_universal (hd : 0 < d)
    (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) :
    classifyingHom 𝒜 hd (pullbackSections 𝒜 (universalVeroneseSections 𝒜 d) φ)
        (iSup_nonvanishingOpen_pullbackSections 𝒜 (universalVeroneseSections 𝒜 d) φ
          (iSup_nonvanishingOpen_psiSection_universalVeroneseSections_eq_top 𝒜 d))
      = φ := by
  rw [ProjClassifyingPullback.classifyingHom_pullbackSections 𝒜 hd _
      (iSup_nonvanishingOpen_psiSection_universalVeroneseSections_eq_top 𝒜 d),
    ProjClassifyingPullback.classifyingHom_universalVeroneseSections 𝒜 d hd, Category.comp_id]

variable {L : Y.Modules} [Stacks.Ample.IsInvertibleModule Y L]

/-- Let `A` be a graded ring, `X = Proj(A)`, let `d ≥ 1` and let `U_d ⊆ X` be the open of
Equation 27.12.0.1. Let `Y` be a scheme, `L` an invertible `𝒪_Y`-module and
`ψ : A^{(d)} → Γ_*(Y, L)` a graded map such that `L` is generated by the sections `ψ(f)`,
`f ∈ A_d` — in the geometric form of Section 27.12, that their nonvanishing opens cover `Y`. Then
there is a **unique** pair `(φ, α)` of a morphism `φ : Y ⟶ U_d` (so the morphism `Y ⟶ X` it
defines has image in `U_d`) and an isomorphism `α : φ⁎𝒪_{U_d}(d) ≅ L` such that `ψ^d_φ` agrees
with `ψ` via `α`: the square

  `α ∘ φ^* ∘ ψ^d = ψ`

commutes in every degree `n`, i.e. `α^{⊗ n}(φ^*(ψ^d(x))) = ψ(x)` in `Γ(Y, L^{⊗ n})` for every
`x ∈ A_{nd}`. Here `ψ^d : A^{(d)} ⟶ Γ_*(U_d, 𝒪_{U_d}(d))` is
`Stacks.AlgebraicGeometry.ProjDegreeOpenUniversalTriple.universalVeroneseSections`, `φ^*` on
sections of tensor powers is `Stacks.AlgebraicGeometry.ProjChartRatioPullback.pullSection`, and
`α^{⊗ n}` is `Stacks.AmplePullbackPart1.natTensorPowCongr α n`. -/
@[stacks 01N8 "the unique pair (φ, α) of φ : Y ⟶ U_d and α : φ^*O_{U_d}(d) ≅ L making the \
square α^{⊗n}(φ^*(ψ^d(x))) = ψ(x) commute in every degree n"]
theorem existsUnique_square (hd : 0 < d) (ψ : VeroneseSections 𝒜 d L)
    (hgen : ⨆ f : 𝒜 d, nonvanishingOpen Y L (psiSection 𝒜 ψ f) = ⊤) :
    ∃! p : (φ : Y ⟶ (degreeOpen 𝒜 d).toScheme) ×
        ((Scheme.Modules.pullback φ).obj (universalTwist 𝒜 d) ≅ L),
      ∀ (n : ℕ) (x : 𝒜 (n * d)),
        (natTensorPowCongr p.2 n).hom.app ⊤
            (pullSection p.1 (universalTwist 𝒜 d) n
              ((universalVeroneseSections 𝒜 d).toFun n x))
          = ψ.toFun n x := by
  have hU := iSup_nonvanishingOpen_psiSection_universalVeroneseSections_eq_top 𝒜 d
  have hφ := fun φ : Y ⟶ (degreeOpen 𝒜 d).toScheme =>
    iSup_nonvanishingOpen_pullbackSections 𝒜 (universalVeroneseSections 𝒜 d) φ hU
  obtain ⟨β, hβ⟩ : SectionsEquiv 𝒜
      (pullbackSections 𝒜 (universalVeroneseSections 𝒜 d) (classifyingHom 𝒜 hd ψ hgen)) ψ :=
    ProjTripleMorphismConverse.sectionsEquiv_of_sameMorphism 𝒜 hd (hφ _) hgen
      (congrArg (toProj 𝒜) (classifyingHom_pullbackSections_universal 𝒜 hd _))
  refine ⟨⟨classifyingHom 𝒜 hd ψ hgen, β⟩, hβ, ?_⟩
  rintro ⟨φ, γ⟩ hγ
  have hφ0 : φ = classifyingHom 𝒜 hd ψ hgen :=
    (classifyingHom_pullbackSections_universal 𝒜 hd φ).symm.trans
      (ProjTripleClassifying.classifyingHom_eq_of_sectionsEquiv 𝒜 hd (hφ φ) hgen ⟨γ, hγ⟩)
  subst hφ0
  refine congrArg (Sigma.mk _) ?_
  have hsec : ∀ (δ : (Scheme.Modules.pullback (classifyingHom 𝒜 hd ψ hgen)).obj
      (universalTwist 𝒜 d) ≅ L),
      (∀ (n : ℕ) (x : 𝒜 (n * d)), (natTensorPowCongr δ n).hom.app ⊤
          ((pullbackSections 𝒜 (universalVeroneseSections 𝒜 d)
            (classifyingHom 𝒜 hd ψ hgen)).toFun n x) = ψ.toFun n x) →
      ∀ f : 𝒜 d, δ.hom.app ⊤ (psiSection 𝒜 (pullbackSections 𝒜
          (universalVeroneseSections 𝒜 d) (classifyingHom 𝒜 hd ψ hgen)) f)
        = psiSection 𝒜 ψ f := fun δ hδ f => by
    rw [psiSection, psiSection,
      ← ProjTripleClassifying.unitorPow_hom_app_natTensorPowCongr δ]
    exact congrArg _ (hδ 1 _)
  exact ProjSectionsUnique.iso_eq_of_app_eq hgen γ β (hsec γ hγ) (hsec β hβ)

end Stacks.AlgebraicGeometry.MorphismToProjSquare

end
