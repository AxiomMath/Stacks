module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.GradedAlgebra.Examples.IteratedSquareRoot

/-!
# `Proj` of the iterated-square-root algebra is affine

Let `S = ℂ[t][X₁, X₂, …] / (Xᵢ² - t Xᵢ₊₁)` with `deg Xᵢ = 2ⁱ⁻¹` be the infinitely generated
graded algebra of `StacksFrontier.RingTheory.GradedAlgebra.Examples.IteratedSquareRoot`. Because
`Xᵢ² = t Xᵢ₊₁` and the image of `t` lies in no point of `Proj S`, all the standard opens
`D₊(Xᵢ)` coincide. The variables generate `S` over `S₀`, so those standard opens cover
`Proj S`; hence the single standard open `D₊(X₁)` is all of `Proj S`. Since `X₁` is homogeneous
of positive degree, `D₊(X₁)` is affine, and therefore `Proj S` is an affine scheme — in
particular its underlying space is quasi-compact, even though `S` is not generated by finitely
many elements over `S₀`.

## Main results

* `Stacks.IteratedSquareRootAlgebra.basicOpen_x_eq_basicOpen_succ`: `D₊(Xᵢ) = D₊(Xᵢ₊₁)`.
* `Stacks.IteratedSquareRootAlgebra.basicOpen_x_zero_eq_top`: `D₊(X₁) = Proj S`.
* `Stacks.IteratedSquareRootAlgebra.isAffine_proj`: `Proj S` is affine.
* `Stacks.IteratedSquareRootAlgebra.compactSpace_proj`: `Proj S` is quasi-compact.
* `Stacks.IteratedSquareRootAlgebra.basicOpen_x_eq_basicOpen_succ_canonical`,
  `...basicOpen_x_zero_eq_top_canonical`, `...isAffine_proj_canonical` and
  `...compactSpace_proj_canonical`: the same four statements for the constructed grading
  `Stacks.IteratedSquareRootAlgebra.canonicalGrading`, with no grading hypothesised.

## Implementation notes

The source numbers the generators from one while `Stacks.IteratedSquareRootAlgebra.x` is
indexed by the natural numbers from zero, so `D₊(X₁)` is `basicOpen _ (x 0)` and the relation
`D₊(Xᵢ) = D₊(Xᵢ₊₁)` is stated for an arbitrary `i : ℕ`. Each statement comes in two forms: one
for an arbitrary `Grading` bundle, installed locally so that both sides of each equality refer
to that one grading, and one for `Stacks.IteratedSquareRootAlgebra.canonicalGrading`, the
grading the source specifies. The second is the form the source asserts; the first is the same
proof read over any grading with the stated properties.

Equality with `Proj S` is phrased as equality with the top open of the scheme, and
quasi-compactness as `CompactSpace` on the underlying space; the latter is then an instance
consequence of affineness.

That the variables generate `S` over `S₀` is proved from the presentation: the image of a
polynomial lies in the subalgebra generated by the variables because every coefficient of it
lies in `S₀ = ℂ[t] · 1`, which `Grading.degreeZero` records.

## References

* [Stacks Project, Tag 01MH](https://stacks.math.columbia.edu/tag/01MH)
-/

@[expose] public section

namespace Stacks.IteratedSquareRootAlgebra

open AlgebraicGeometry

/-- In the iterated-square-root algebra, consecutive generators define the same standard open
of the projective spectrum: `D₊(Xᵢ) = D₊(Xᵢ₊₁)`, because `Xᵢ² = t Xᵢ₊₁` and `D₊(t) = Proj S`. -/
public theorem basicOpen_x_eq_basicOpen_succ (s : Grading) (i : ℕ) :
    letI : GradedAlgebra s.grading := s.gradedAlgebra
    ProjectiveSpectrum.basicOpen s.grading (x i) =
      ProjectiveSpectrum.basicOpen s.grading (x (i + 1)) := by
  let : GradedAlgebra s.grading := s.gradedAlgebra
  have ht : ProjectiveSpectrum.basicOpen s.grading (algebraMap baseRing ring t) = ⊤ :=
    SetLike.ext fun p => by simpa using algebraMap_t_notMem s p
  rw [← ProjectiveSpectrum.basicOpen_pow s.grading (x i) 2 (by norm_num), s.x_sq i,
    ProjectiveSpectrum.basicOpen_mul, ht, top_inf_eq]

/-- The image of a coefficient lies in the degree-zero part of the specified grading. -/
private theorem algebraMap_mem_grading_zero (s : Grading) (r : baseRing) :
    algebraMap baseRing ring r ∈ s.grading 0 := by
  let : GradedAlgebra s.grading := s.gradedAlgebra
  rw [s.degreeZero, Algebra.algebraMap_eq_smul_one]
  exact Submodule.smul_mem _ r (Submodule.subset_span (Set.mem_singleton (1 : ring)))

/-- The variables generate `S` as an algebra over its degree-zero part. -/
private theorem adjoin_range_x_eq_top (s : Grading) :
    letI : GradedAlgebra s.grading := s.gradedAlgebra
    Algebra.adjoin (s.grading 0) (Set.range x) = ⊤ := by
  let : GradedAlgebra s.grading := s.gradedAlgebra
  let B : Subalgebra (s.grading 0) ring := Algebra.adjoin (s.grading 0) (Set.range x)
  apply top_unique
  intro y _
  have hcoeff (a : baseRing) : algebraMap baseRing ring a ∈ B :=
    B.algebraMap_mem ⟨algebraMap baseRing ring a, algebraMap_mem_grading_zero s a⟩
  have hmk (p : polynomialRing) : Ideal.Quotient.mk relationIdeal p ∈ B := by
    induction p using MvPolynomial.induction_on with
    | C a =>
        simpa only [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap] using hcoeff a
    | add p q hp hq => simpa only [map_add] using B.add_mem hp hq
    | mul_X p i hp =>
        rw [map_mul]
        exact B.mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
  exact hmk p

/-- The first standard open is the whole projective spectrum of the iterated-square-root
algebra: the `D₊(Xᵢ)` cover `Proj S` and they are all equal. -/
public theorem basicOpen_x_zero_eq_top (s : Grading) :
    letI : GradedAlgebra s.grading := s.gradedAlgebra
    Proj.basicOpen s.grading (x 0) = ⊤ := by
  let : GradedAlgebra s.grading := s.gradedAlgebra
  have hcover : (⨆ i : ℕ, Proj.basicOpen s.grading (x i)) = ⊤ :=
    Proj.iSup_basicOpen_eq_top' s.grading x (fun i => ⟨2 ^ i, s.x_mem i⟩)
      (adjoin_range_x_eq_top s)
  have heq (i : ℕ) : Proj.basicOpen s.grading (x i) = Proj.basicOpen s.grading (x 0) := by
    induction i with
    | zero => rfl
    | succ i ih =>
        show ProjectiveSpectrum.basicOpen s.grading (x (i + 1)) =
          ProjectiveSpectrum.basicOpen s.grading (x 0)
        exact (basicOpen_x_eq_basicOpen_succ s i).symm.trans ih
  exact top_le_iff.mp (hcover.ge.trans (iSup_le fun i => (heq i).le))

/-- The projective spectrum of the iterated-square-root algebra is an affine scheme. -/
public theorem isAffine_proj (s : Grading) :
    letI : GradedAlgebra s.grading := s.gradedAlgebra
    IsAffine (AlgebraicGeometry.Proj s.grading) := by
  let : GradedAlgebra s.grading := s.gradedAlgebra
  have hOpen : IsAffineOpen (Proj.basicOpen s.grading (x 0)) :=
    Proj.isAffineOpen_basicOpen s.grading (x 0) (by simpa using s.x_mem 0) (by norm_num)
  rw [basicOpen_x_zero_eq_top s] at hOpen
  exact (IsAffine.iff_of_isIso
    (AlgebraicGeometry.Scheme.topIso (AlgebraicGeometry.Proj s.grading)).hom).mp hOpen

/-- The projective spectrum of the iterated-square-root algebra is quasi-compact, although the
algebra is not of finite type over its degree-zero part. -/
public theorem compactSpace_proj (s : Grading) :
    letI : GradedAlgebra s.grading := s.gradedAlgebra
    CompactSpace (AlgebraicGeometry.Proj s.grading) := by
  let : GradedAlgebra s.grading := s.gradedAlgebra
  let : IsAffine (AlgebraicGeometry.Proj s.grading) := isAffine_proj s
  infer_instance

/-- **Stacks Project, Tag 01MH.** For the grading the source specifies, consecutive generators
define the same standard open of the projective spectrum: `D₊(Xᵢ) = D₊(Xᵢ₊₁)`. -/
public theorem basicOpen_x_eq_basicOpen_succ_canonical (i : ℕ) :
    ProjectiveSpectrum.basicOpen canonicalGrading.grading (x i) =
      ProjectiveSpectrum.basicOpen canonicalGrading.grading (x (i + 1)) :=
  basicOpen_x_eq_basicOpen_succ canonicalGrading i

/-- **Stacks Project, Tag 01MH.** For the grading the source specifies, the first standard open
is the whole projective spectrum. -/
public theorem basicOpen_x_zero_eq_top_canonical :
    Proj.basicOpen canonicalGrading.grading (x 0) = ⊤ :=
  basicOpen_x_zero_eq_top canonicalGrading

/-- **Stacks Project, Tag 01MH.** `Proj S` is an affine scheme, namely `D₊(X₁)`. -/
public theorem isAffine_proj_canonical :
    IsAffine (AlgebraicGeometry.Proj canonicalGrading.grading) :=
  isAffine_proj canonicalGrading

/-- **Stacks Project, Tag 01MH.** `Proj S` is quasi-compact, although `S` is not of finite type
over its degree-zero part. -/
public theorem compactSpace_proj_canonical :
    CompactSpace (AlgebraicGeometry.Proj canonicalGrading.grading) :=
  compactSpace_proj canonicalGrading

end Stacks.IteratedSquareRootAlgebra

end
