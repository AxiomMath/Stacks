module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Constructions.ProjSheafTensorNotIso
public import StacksFrontier.AlgebraicGeometry.Constructions.ProjTildeNotMonoidal
public import StacksFrontier.RingTheory.GradedAlgebra.ShiftTensorProduct
public import StacksFrontier.RingTheory.Localization.AwayAdjoinInvSelf

/-!
# Remark 27.10.3 in one statement

Stacks Tag 01ML observes that the canonical comparison map of Stacks Tag 01MK is in general not
an isomorphism, and exhibits an example: `k` a field, `S = k[x, y, z]` with `deg x = 1`,
`deg y = 2`, `deg z = 3`, `M = S(1)` and `N = S(2)`, so that `M ⊗_S N = S(3)`; and then
`S_z = k[x, y, z, 1/z]`, `S₍z₎ ≅ k[u, v, w]/(uw - v³)`, `M₍z₎ = S₍z₎·x + S₍z₎·y²/z`,
`N₍z₎ = S₍z₎·y + S₍z₎·x²` and `S(3)₍z₎ = S₍z₎·z`, with the fibres of `M₍z₎` and `N₍z₎` at the
maximal ideal `𝔪 = (u, v, w)` of dimension `2` and that of `S(3)₍z₎` of dimension `1`, whence
`M₍z₎ ⊗ N₍z₎ → S(3)₍z₎` is not an isomorphism.

Every one of those assertions was proved, but on eleven separate declarations, so no single
statement said what the remark says. `Stacks.ProjTensorComparison.tensorComparison_not_isomorphism`
is the remark as one theorem, under the remark's own and only hypothesis, a ground field.

## Main definitions

* `Stacks.ProjTensorComparison.situation`: the remark's data — `S = k[x, y, z]` with weights
  `1, 2, 3` and its twists — assembled from the ground field alone.

## Main results

* `Stacks.ProjTensorComparison.tensorComparison_not_isomorphism`: **Stacks Tag 01ML.** The eleven
  assertions of the remark in one theorem.

## Implementation notes

**Two witnesses.** The remark's headline — that the morphism of sheaves of modules of Stacks Tag
01MK is not an isomorphism — is the first conjunct, and it is proved for `S = k[X]` with
`deg X = 2` and `M = N = S(1)` rather than for the remark's own weights `1, 2, 3`. Since the
headline is a failure of generality, a single witness establishes it. The remark's own witness is
carried as far as the library carries it: the computation of the degree-zero localizations at `z`
and the failure of bijectivity of `M₍z₎ ⊗_{S₍z₎} N₍z₎ → S(3)₍z₎`, which is the last conjunct.
Deriving the sheaf-level failure from the weights `1, 2, 3` would need a comparison between
`Stacks.ProjStandardOpenBaseChange.twistAway` and the sheaf machinery's
`Stacks.GradedLocalization.GradedModuleDegreeZeroLocalization`, together with a localization of
the chart module at the vertex ideal; neither is in the library. Both witnesses are built from the
ground field, so the two halves are stated over the one `k`.

**The two instantiations.** `S(3)₍z₎ = S₍z₎·z` and `M ⊗_S N = S(3)` are proved in the generality
of an arbitrary graded algebra and an arbitrary pair of shifts; `localizedThirdTwist_eq_span` and
`tensorFirstSecondTwist_eq_thirdTwist` below specialise them to the remark's data, so that the
theorem itself is a tuple of the eleven component proofs.

## References

* [Stacks Project, Tag 01ML](https://stacks.math.columbia.edu/tag/01ML)
* [Stacks Project, Tag 01MK](https://stacks.math.columbia.edu/tag/01MK)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite
open AlgebraicGeometry
open Stacks.WeightedPolynomial (cubicRelationIdeal)
open scoped TensorProduct

namespace Stacks.ProjTensorComparison

universe u

attribute [local instance] ProjectiveSpectrum.isPrime
attribute [local instance_reducible] ProjectiveSpectrum.top

variable (k : Type u) [Field k]

/-- The remark's data over the ground field `k`: the polynomial ring `S = k[x, y, z]` with
weights `1`, `2`, `3`, its twists `M = S(1)`, `N = S(2)`, `S(3)`, their degree-zero localizations
at `z` and the vertex ideal. -/
def situation : WeightedPolynomialSituation.{u} where
  k := k

/-- The variable `z` is weighted homogeneous of degree three. -/
theorem z_mem_naturalGrading : (situation k).z ∈ (situation k).naturalGrading 3 := by
  show MvPolynomial.IsWeightedHomogeneous (situation k).naturalWeight (MvPolynomial.X 2) 3
  simpa [WeightedPolynomialSituation.naturalWeight] using
    (MvPolynomial.isWeightedHomogeneous_X (situation k).k (situation k).naturalWeight 2)

/-- `S(3)₍z₎ = S₍z₎ · z`: the degree-zero localization of the third twist at `z` is generated by
the image of `z`. This is `Stacks.ProjStandardOpenBaseChange.twistAway_self_eq_span` at the
remark's grading, element and degree. -/
theorem localizedThirdTwist_eq_span :
    (situation k).localizedTwist 3 =
      Submodule.span (situation k).R
        {algebraMap (situation k).S (Localization.Away (situation k).z) (situation k).z} :=
  Stacks.ProjStandardOpenBaseChange.twistAway_self_eq_span (situation k).naturalGrading
    (situation k).z 3 (z_mem_naturalGrading k)

/-- `M ⊗_S N = S(3)` for `M = S(1)` and `N = S(2)`: in each degree `n`, the image in `S` of the
span of the degree-`n` tensors is the degree-`n` piece of the third twist. This is
`GradedAlgebra.map_lid_span_shift_tmul` at the shifts `1` and `2`. -/
theorem tensorFirstSecondTwist_eq_thirdTwist (n : ℤ) :
    Submodule.map
        ((TensorProduct.lid (situation k).S (situation k).S).toLinearMap.restrictScalars
          (situation k).k)
        (Submodule.span (situation k).k
          {t : TensorProduct (situation k).S (situation k).S (situation k).S |
            ∃ i j : ℤ, i + j = n ∧
              ∃ a b : (situation k).S, a ∈ (situation k).grading (i + 1) ∧
                b ∈ (situation k).grading (j + 2) ∧
                  t = TensorProduct.tmul (situation k).S a b}) =
      (situation k).grading (n + 3) := by
  simpa using GradedAlgebra.map_lid_span_shift_tmul (situation k).grading 1 2 n

/-- **Stacks Project, Tag 01ML.** The canonical comparison morphism
`M̃ ⊗_𝒪 Ñ ⟶ (M ⊗_S N)~` of sheaves of modules on `Proj(S)` is not an isomorphism, and the
remark's example computes why. For a field `k` and `S = k[x, y, z]` with weights `1, 2, 3`,
`M = S(1)`, `N = S(2)`:

1. the comparison morphism of sheaves of modules is not an isomorphism;
2. `S_z` is `S` with `1/z` adjoined;
3. `M ⊗_S N = S(3)`, degreewise;
4. `S₍z₎ ≅ k[u, v, w]/(uw - v³)`, by the map carrying the three variables to `u`, `v`, `w`;
5. `M₍z₎ = S₍z₎ · x + S₍z₎ · y²/z`;
6. `N₍z₎ = S₍z₎ · y + S₍z₎ · x²`;
7. `S(3)₍z₎ = S₍z₎ · z`;
8. `𝔪 = (u, v, w)` is a maximal ideal of `S₍z₎`;
9. its residue field is `k`;
10. the fibres of `M₍z₎` and of `N₍z₎` at `𝔪` have dimension `2`, and that of `S(3)₍z₎`
    dimension `1`;
11. the multiplication map `M₍z₎ ⊗_{S₍z₎} N₍z₎ → S(3)₍z₎` is not bijective.

Conjunct (1) is the failure of generality asserted by Stacks Tag 01ML of the morphism
constructed in Stacks Tag 01MK, and it is witnessed by `k[X]` with `deg X = 2` and
`M = N = S(1)` rather than by the remark's own weights; see the module docstring for what a
derivation from the remark's own witness would still need. Conjunct (4) is stated as the
existence of an algebra isomorphism together with its values on the three variables, which pins
it down to the map the remark writes. -/
@[stacks 01ML "Remark 27.10.3 as one theorem: the canonical comparison morphism \
M-tilde ⊗ N-tilde ⟶ (M ⊗_S N)-tilde of sheaves of modules on Proj(S) is not an isomorphism, and \
for k[x, y, z] with weights 1, 2, 3, M = S(1) and N = S(2) the remark's computation — S_z is S \
with 1/z adjoined, M ⊗_S N = S(3) degreewise, S₍z₎ ≅ k[u, v, w]/(uw - v³) by the map sending the \
variables to u, v, w, M₍z₎ = S₍z₎x + S₍z₎y²/z, N₍z₎ = S₍z₎y + S₍z₎x², S(3)₍z₎ = S₍z₎z, the \
ideal (u, v, w) is maximal with residue field k, the fibres of M₍z₎ and N₍z₎ there have \
dimension 2 and that of S(3)₍z₎ dimension 1, and the multiplication map \
M₍z₎ ⊗ N₍z₎ → S(3)₍z₎ is not bijective. The first conjunct is witnessed by k[X] with \
deg X = 2 and M = N = S(1)"]
theorem tensorComparison_not_isomorphism :
    letI : (situation k).vertexIdeal.IsMaximal :=
      WeightedPolynomialSituation.vertexIdeal_isMaximal (situation k)
    (¬ IsIso (Stacks.AlgebraicGeometry.ProjSheafFunctoriality.associatedModuleSheafTensorMap
        (Stacks.EvenWeightProj.grading k) (Stacks.EvenWeightProj.oddTwist k)
        (Stacks.EvenWeightProj.oddTwist k))) ∧
      Algebra.adjoin (situation k).S
          ({(IsLocalization.Away.invSelf (situation k).z :
              (situation k).ordinaryLocalization)} :
            Set (situation k).ordinaryLocalization) = ⊤ ∧
      (∀ n : ℤ,
        Submodule.map
            ((TensorProduct.lid (situation k).S (situation k).S).toLinearMap.restrictScalars
              (situation k).k)
            (Submodule.span (situation k).k
              {t : TensorProduct (situation k).S (situation k).S (situation k).S |
                ∃ i j : ℤ, i + j = n ∧
                  ∃ a b : (situation k).S, a ∈ (situation k).grading (i + 1) ∧
                    b ∈ (situation k).grading (j + 2) ∧
                      t = TensorProduct.tmul (situation k).S a b}) =
          (situation k).grading (n + 3)) ∧
      (∃ e :
          (MvPolynomial (Fin 3) (situation k).k ⧸ cubicRelationIdeal (situation k).k)
            ≃ₐ[(situation k).k] (situation k).R,
        ∀ i : Fin 3,
          e (Ideal.Quotient.mk (cubicRelationIdeal (situation k).k) (MvPolynomial.X i)) =
            ![(situation k).u, (situation k).v, (situation k).w] i) ∧
      (situation k).firstTwistLocalization =
        Submodule.span (situation k).R
          {Localization.mk (situation k).x (1 : Submonoid.powers (situation k).z),
            Localization.mk ((situation k).y ^ 2)
              ⟨(situation k).z, Submonoid.mem_powers (situation k).z⟩} ∧
      (situation k).secondTwistLocalization =
        Submodule.span (situation k).R
          ({algebraMap (situation k).S (situation k).ordinaryLocalization (situation k).y,
            algebraMap (situation k).S (situation k).ordinaryLocalization
              ((situation k).x ^ 2)} : Set (situation k).ordinaryLocalization) ∧
      (situation k).localizedTwist 3 =
        Submodule.span (situation k).R
          {algebraMap (situation k).S (Localization.Away (situation k).z) (situation k).z} ∧
      (situation k).vertexIdeal.IsMaximal ∧
      Function.Bijective (algebraMap (situation k).k (situation k).vertexIdeal.ResidueField) ∧
      Module.finrank (situation k).vertexIdeal.ResidueField
        ((situation k).vertexIdeal.ResidueField ⊗[(situation k).R]
          (situation k).firstTwistLocalization) = 2 ∧
      Module.finrank ((situation k).R ⧸ (situation k).vertexIdeal)
        ((situation k).secondTwistLocalization ⧸
          (situation k).vertexIdeal •
            (⊤ : Submodule (situation k).R (situation k).secondTwistLocalization)) = 2 ∧
      Module.finrank ((situation k).R ⧸ (situation k).vertexIdeal)
        ((situation k).localizedTwist 3 ⧸
          (situation k).vertexIdeal •
            (⊤ : Submodule (situation k).R ((situation k).localizedTwist 3))) = 1 ∧
      ¬ Function.Bijective
          (WeightedPolynomialSituation.localizedTwistTensorMap (situation k)) :=
  ⟨Stacks.EvenWeightProj.not_isIso_associatedModuleSheafTensorMap k,
    IsLocalization.Away.adjoin_invSelf_eq_top (situation k).S
      (situation k).ordinaryLocalization (situation k).z,
    tensorFirstSecondTwist_eq_thirdTwist k,
    ⟨Stacks.WeightedPolynomial.degreeZeroRingEquiv (situation k),
      Stacks.WeightedPolynomial.degreeZeroRingEquiv_mk_X (situation k)⟩,
    WeightedPolynomialSituation.firstTwistLocalization_eq_span (situation k),
    WeightedPolynomialSituation.secondTwistLocalization_eq_span (situation k),
    localizedThirdTwist_eq_span k,
    WeightedPolynomialSituation.vertexIdeal_isMaximal (situation k),
    WeightedPolynomialSituation.bijective_algebraMap_vertexIdeal_residueField (situation k),
    WeightedPolynomialSituation.finrank_firstTwistLocalization_fiber (situation k),
    WeightedPolynomialSituation.finrank_secondTwistLocalization_quotient_vertexIdeal
      (situation k),
    WeightedPolynomialSituation.finrank_thirdTwistLocalization_quotient_vertexIdeal (situation k),
    WeightedPolynomialSituation.not_bijective_localizedTwistTensorMap (situation k)⟩

end Stacks.ProjTensorComparison

end
