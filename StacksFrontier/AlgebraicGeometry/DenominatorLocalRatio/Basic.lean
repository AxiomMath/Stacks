module

public import StacksFrontier.AlgebraicGeometry.Divisors.Meromorphic.Stalks
public import StacksFrontier.AlgebraicGeometry.DenominatorIdealInvertible.Basic
public import StacksFrontier.AlgebraicGeometry.DenominatorIdealSupport.Unit

/-!
# A meromorphic section of an invertible sheaf is locally a ratio of nonzerodivisors

Let `X` be a scheme, `L` an invertible sheaf of `𝒪_X`-modules and `s` a meromorphic section of
`L`.  Around every point of every open set there is an *affine* open `V` over which `L` is
trivial and over which

    b · s = toK t

for a nonzerodivisor `b ∈ Γ(X, V)` and a section `t` of `L` over `V`.  Equivalently `b` is a
denominator of `s` over `V` in the sense of Stacks Tag 02P0: it lies in the ideal of sections
whose product with `s` is regular.  This is the "shrinking further, write the section as a ratio
`a/b` with `a` and `b` nonzerodivisors" step of the proof of Tag 02P0, in the form the rest of
that proof uses it, and it needs **no** Noetherian hypothesis.

## Main results

* `Stacks.DenominatorLocalRatio.exists_affineOpen_denominator`: the statement above.
* `Stacks.DenominatorLocalRatio.exists_smul_tmulOneElt`: over an open set on which `L` is
  trivial, the sectionwise tensor product `K_X ⊗_{𝒪_X} L` is generated by `1 ⊗ t₀` for the
  trivializing section `t₀`.
* `Stacks.DenominatorLocalRatio.exists_preimage_toSheafifyMeromorphic` and
  `Stacks.DenominatorLocalRatio.exists_preimage_toSheafify`: the two local surjectivities,
  extracted in pointwise form.

## Implementation notes

The sheaf `K_X(L)` of meromorphic sections is the sheafification of the sectionwise tensor
product `K_X ⊗_{𝒪_X} L`, and `K_X` is itself the sheafification of the presheaf of total
quotient rings.  So there are two sheafifications between `s` and anything one can compute with,
and each is removed by its own local surjectivity, which is a Mathlib instance in both cases
(`CategoryTheory.Presheaf.isLocallySurjective_toSheafify`).  Between the two, invertibility is
used to collapse the tensor product: over an open set on which `L` is trivial with trivializing
section `t₀`, every element of `K_X(V) ⊗_{𝒪_X(V)} L(V)` is `q · (1 ⊗ t₀)` for a single
`q ∈ K_X(V)` — this is `Stacks.DenominatorLocalRatio.exists_smul_tmulOneElt`, proved from the
composite isomorphism `K ⊗_𝒪 L ≅ K ⊗_𝒪 𝒪 ≅ K` — so that only one denominator has to be cleared
instead of one per summand.

The nonzerodivisor property comes out at the end rather than at the beginning: the denominator
produced by `CategoryTheory.IsLocalization.surj` lies in the denominator submonoid of the total
quotient presheaf, which consists of the sections whose germ at every point is a nonzerodivisor,
and on an **affine** open that submonoid is exactly `nonZeroDivisors Γ(X, V)` by
`AlgebraicGeometry.submonoidPresheafOfStalk_obj_eq_nonZeroDivisors`, which carries no Noetherian
hypothesis.  This is why the affine shrinking is done last.  Note that
`AlgebraicGeometry.isLocalization_totalQuotientPresheaf_obj_of_isAffineOpen` is *not* used,
even though it carries no Noetherian hypothesis: it is not what is wanted, because the localization
property needed here is the
one that `TopCat.Presheaf.SubmonoidPresheaf.localizationPresheaf` carries by construction, at the
denominator submonoid itself rather than at all nonzerodivisors.

The elementary tensor-product steps are stated for an arbitrary morphism of presheaves of
commutative rings on an arbitrary category, in the vocabulary of Tag 03CU, because the module
structures on the sections of a `Stacks.PresheafOfModules.ChangeOfRings.PMod` are the ones the
  tensor product of
`Stacks.PresheafOfModules.ChangeOfRings.changeOfRings` is formed at; at the structure sheaf of a
  scheme the same expressions
need the `forget₂ CommRingCat RingCat` bridge spelled out by hand.

## References

* [Stacks Project, Tag 02P0](https://stacks.math.columbia.edu/tag/02P0)
* [Stacks Project, Tag 03CU](https://stacks.math.columbia.edu/tag/03CU)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open Stacks.DenominatorIdeal Stacks.DenominatorIdealResidue

universe w v u

namespace Stacks.DenominatorLocalRatio

/-! ### Elementary facts about the sectionwise tensor product -/

section Local

variable {C : Type u} [Category.{v} C] {O₁ O₂ : Cᵒᵖ ⥤ CommRingCat.{w}}

/-- The element `1 ⊗ t` of the sectionwise tensor product `O₂ ⊗_{O₁} G` over an object, that is
the value of the presheaf-level unit of Tag 03CU. -/
abbrev tmulOneElt (θ : O₁ ⟶ O₂) (G : Stacks.PresheafOfModules.ChangeOfRings.PMod O₁) (V : Cᵒᵖ) (t :
  (G.obj V : Type w)) :
    (((Stacks.PresheafOfModules.ChangeOfRings.changeOfRings θ).obj G).obj V : Type w) :=
  (Stacks.PresheafOfModules.ChangeOfRings.unitApp θ (𝟙
    ((Stacks.PresheafOfModules.ChangeOfRings.changeOfRings θ).obj G)) V).hom t

/-- `1 ⊗ t` is the element `tmulOneElt`, as an elementary tensor. -/
private theorem tmulOneElt_eq_tmul (θ : O₁ ⟶ O₂)
    (G : Stacks.PresheafOfModules.ChangeOfRings.PMod O₁) (V : Cᵒᵖ) (t : (G.obj V : Type w)) :
    letI := (θ.app V).hom.toAlgebra
    tmulOneElt θ G V t = (1 : (O₂.obj V : Type w)) ⊗ₜ[(O₁.obj V : Type w)] t :=
  Stacks.PresheafOfModules.ChangeOfRings.unitApp_apply θ _ V t

/-- **With a trivialization of `G` over `V`, the tensor product is generated by one element.**
Every element of `(O₂ ⊗_{O₁} G)(V)` is a multiple of `1 ⊗ t₀`, where `t₀` is the section of `G`
corresponding to `1` under the trivialization.  The reason is that the trivialization makes the
tensor product isomorphic to `O₂(V) ⊗_{O₁(V)} O₁(V)`, hence to `O₂(V)`. -/
lemma exists_smul_tmulOneElt (θ : O₁ ⟶ O₂) (G : Stacks.PresheafOfModules.ChangeOfRings.PMod O₁) (V :
  Cᵒᵖ)
    (e : (G.obj V : Type w) ≃ₗ[(O₁.obj V : Type w)] (O₁.obj V : Type w))
    (z : (((Stacks.PresheafOfModules.ChangeOfRings.changeOfRings θ).obj G).obj V : Type w)) :
    ∃ q : (O₂.obj V : Type w),
      z = q • tmulOneElt θ G V (e.symm (1 : (O₁.obj V : Type w))) := by
  let := (θ.app V).hom.toAlgebra
  set E := (TensorProduct.congr (LinearEquiv.refl (O₁.obj V : Type w) (O₂.obj V : Type w)) e).trans
    (TensorProduct.rid (O₁.obj V : Type w) (O₂.obj V : Type w)) with hE
  have hcollapse : ∀ q : (O₂.obj V : Type w),
      E (q • ((1 : (O₂.obj V : Type w)) ⊗ₜ[(O₁.obj V : Type w)]
        (e.symm (1 : (O₁.obj V : Type w))))) = q := by
    intro q
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, hE, LinearEquiv.trans_apply,
      TensorProduct.congr_tmul, LinearEquiv.refl_apply, LinearEquiv.apply_symm_apply,
      TensorProduct.rid_tmul, one_smul]
  refine ⟨E z, ?_⟩
  rw [tmulOneElt_eq_tmul]
  change z = (E z) • ((1 : (O₂.obj V : Type w)) ⊗ₜ[(O₁.obj V : Type w)]
    (e.symm (1 : (O₁.obj V : Type w))))
  exact E.injective (hcollapse (E z)).symm

/-- **Clearing a denominator.**  If `q · θ(b) = θ(a)` then multiplying `q · (1 ⊗ t)` by `θ(b)`
produces `1 ⊗ (a · t)`, an element of the image of `t ↦ 1 ⊗ t`. -/
lemma smul_smul_tmulOneElt (θ : O₁ ⟶ O₂) (G : Stacks.PresheafOfModules.ChangeOfRings.PMod O₁) (V :
  Cᵒᵖ)
    (q : (O₂.obj V : Type w)) (t : (G.obj V : Type w)) (a b : (O₁.obj V : Type w))
    (h : q * (θ.app V).hom b = (θ.app V).hom a) :
    ((θ.app V).hom b) • (q • tmulOneElt θ G V t) = tmulOneElt θ G V (a • t) := by
  let := (θ.app V).hom.toAlgebra
  have halg : ∀ r : (O₁.obj V : Type w),
      algebraMap (O₁.obj V : Type w) (O₂.obj V : Type w) r = (θ.app V).hom r := fun _ => rfl
  change ((θ.app V).hom b) • (q • ((1 : (O₂.obj V : Type w)) ⊗ₜ[(O₁.obj V : Type w)] t)) =
    (1 : (O₂.obj V : Type w)) ⊗ₜ[(O₁.obj V : Type w)] (a • t)
  rw [smul_smul, TensorProduct.smul_tmul', smul_eq_mul, mul_one,
    mul_comm ((θ.app V).hom b) q, h, ← halg, ← TensorProduct.smul_tmul,
    Algebra.algebraMap_eq_smul_one]

/-- A morphism out of the sectionwise tensor product carries `1 ⊗ t` to the value at `t` of the
corresponding morphism out of `G`, by the formula
  `Stacks.PresheafOfModules.ChangeOfRings.unitApp_apply`. -/
lemma app_tmulOneElt (θ : O₁ ⟶ O₂) (G : Stacks.PresheafOfModules.ChangeOfRings.PMod O₁) {F :
  Stacks.PresheafOfModules.ChangeOfRings.PMod O₂}
    (ψ : (Stacks.PresheafOfModules.ChangeOfRings.changeOfRings θ).obj G ⟶ F) (V : Cᵒᵖ) (t : (G.obj V
      : Type w)) :
    ψ.app V (tmulOneElt θ G V t) = Stacks.PresheafOfModules.ChangeOfRings.unitApp θ ψ V t := by
  let := (θ.app V).hom.toAlgebra
  have hgoal : (ψ.app V).hom (tmulOneElt θ G V t) = (Stacks.PresheafOfModules.ChangeOfRings.unitApp
    θ ψ V).hom t := by
    rw [Stacks.PresheafOfModules.ChangeOfRings.unitApp_apply θ ψ V t]
    rw [tmulOneElt_eq_tmul]
  exact hgoal

/-- The restriction maps of the sectionwise tensor product carry `1 ⊗ t` to `1 ⊗ t|`. -/
lemma map_tmulOneElt (θ : O₁ ⟶ O₂) (G : Stacks.PresheafOfModules.ChangeOfRings.PMod O₁) {V V' : Cᵒᵖ}
  (f : V ⟶ V')
    (t : (G.obj V : Type w)) :
    ((Stacks.PresheafOfModules.ChangeOfRings.changeOfRings θ).obj G).map f (tmulOneElt θ G V t) =
      tmulOneElt θ G V' (G.map f t) :=
  (PresheafOfModules.naturality_apply (Stacks.PresheafOfModules.ChangeOfRings.unitHom θ
    (𝟙 ((Stacks.PresheafOfModules.ChangeOfRings.changeOfRings θ).obj G))) f t).symm

/-- Restriction is semilinear on the sectionwise tensor product. -/
lemma map_smul_tmulOneElt (θ : O₁ ⟶ O₂) (G : Stacks.PresheafOfModules.ChangeOfRings.PMod O₁) {V V' :
  Cᵒᵖ} (f : V ⟶ V')
    (c : (O₂.obj V : Type w)) (t : (G.obj V : Type w)) :
    ((Stacks.PresheafOfModules.ChangeOfRings.changeOfRings θ).obj G).map f (c • tmulOneElt θ G V t)
      =
      (O₂.map f c) • tmulOneElt θ G V' (G.map f t) := by
  rw [PresheafOfModules.map_smul ((Stacks.PresheafOfModules.ChangeOfRings.changeOfRings θ).obj G) f
    c
    (tmulOneElt θ G V t), map_tmulOneElt]
  rfl

end Local

/-! ### Vocabulary for the sections of `K_X`, `K_X(L)` and `L` on a scheme

The sections of `K_X(L)` carry a module structure over the sections of `K_X` read through
`forget₂ CommRingCat RingCat`, while the ring arithmetic of those same sections is available at
the `CommRingCat` spelling.  The two carriers are the same type, but instance search does not
cross between them: a scalar whose *inferred* type is the `CommRingCat` carrier cannot be used in
a `•`, and a type ascription does not help because it leaves the inferred type alone.  Every such
scalar is therefore re-bound at the `kScalar`/`oScalar` spelling by
`obtain ⟨c', rfl⟩ : ∃ c' : kScalar X V, c = c' := ⟨c, rfl⟩`, which is a no-op on the term and
fixes the spelling for instance search. -/

variable (X : Scheme.{u}) (L : SheafOfModules.{u} (O X))

/-- The denominator submonoid presheaf of the structure sheaf: the sections whose germ at every
point of the open set is a nonzerodivisor. -/
abbrev denominators : X.presheaf.SubmonoidPresheaf :=
  X.presheaf.submonoidPresheafOfStalk (fun x ↦ nonZeroDivisors (X.presheaf.stalk x))

/-- The presheaf of total quotient rings, with its construction as the localization presheaf of
the denominator submonoid presheaf displayed; this is what makes its algebra and localization
instances available. -/
abbrev totalQuotientPre : TopCat.Presheaf CommRingCat.{u} X :=
  (denominators X).localizationPresheaf

/-- The sections of `K_X` over `V`, in the spelling the module structures are stated at. -/
abbrev kScalar (V : Opens X) : Type u := ((KRing X).obj.obj (op V) : Type u)

/-- The sections of `𝒪_X` over `V`, in the spelling the module structures are stated at. -/
abbrev oScalar (V : Opens X) : Type u := ((O X).obj.obj (op V) : Type u)

/-! ### The local ratio representation on a scheme -/

variable (s : MeromorphicSection.{u, u} X.sheaf L)

/-- The meromorphic section read as an element of the sections of `K_X(L)` over an open set. -/
abbrev sectionOver (V : Opens X) : ((K X L).val.obj (op V) : Type u) := s.val (op V)

/-- The restriction of the meromorphic section over `V` to an open `V' ≤ V` is the meromorphic
section over `V'`. -/
lemma sectionOver_restrict {V V' : Opens X} (h : V' ≤ V) :
    (K X L).val.map (homOfLE h).op (sectionOver X L s V) = sectionOver X L s V' :=
  PresheafOfModules.sections_property s (homOfLE h).op

/-- Multiplication by a section of `𝒪_X` on the meromorphic section, read through the image of
that section in `K_X`. -/
lemma sectionMap_app (V : Opens X) (b : oScalar X V) (c : kScalar X V)
    (hc : ((toK₀ X).app (op V)).hom b = c) :
    (sectionMap X L s).val.app (op V) b = c • sectionOver X L s V := by
  subst hc
  rfl

/-- **Local surjectivity of the sheafification of the tensor product.**  Every section of
`K_X(L)` is, near every point, the image of a section of the presheaf `K_X ⊗_{𝒪_X} L`. -/
lemma exists_preimage_toSheafifyMeromorphic (V : Opens X)
    (y : ((K X L).val.obj (op V) : Type u)) (x : X) (hx : x ∈ V) :
    ∃ (V' : Opens X) (h : V' ≤ V), x ∈ V' ∧
      ∃ z : ((Stacks.PresheafOfModules.ChangeOfRings.changeOfRings (toK₀ X)).obj L.val).obj (op V'),
        (toSheafifyMeromorphic X L).app (op V') z = (K X L).val.map (homOfLE h).op y := by
  have hls : CategoryTheory.Presheaf.IsLocallySurjective (Opens.grothendieckTopology X)
      ((PresheafOfModules.toPresheaf (O X).obj).map
        ((Stacks.PresheafOfModules.ChangeOfRings.restrictScalars (toK₀ X)).map
          (toSheafifyMeromorphic X L))) := by
    change CategoryTheory.Presheaf.IsLocallySurjective (Opens.grothendieckTopology X)
      (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
        (((Stacks.PresheafOfModules.ChangeOfRings.changeOfRings (toK₀ X)).obj L.val).presheaf))
    infer_instance
  obtain ⟨V', hV', ⟨z, hz⟩, hxV'⟩ :=
    (TopCat.Presheaf.isLocallySurjective_iff _).mp hls V y x hx
  exact ⟨V', hV', hxV', z, hz⟩

/-- **Local surjectivity of the sheafification of the total quotient presheaf.**  Every section
of `K_X` is, near every point, the image of a fraction. -/
lemma exists_preimage_toSheafify (V : Opens X)
    (q : (((totalQuotientSheaf X.sheaf).obj).obj (op V) : Type u)) (x : X) (hx : x ∈ V) :
    ∃ (V' : Opens X) (h : V' ≤ V), x ∈ V' ∧ ∃ r : (totalQuotientPre X).obj (op V'),
      ((toSheafify (Opens.grothendieckTopology X) (totalQuotientPre X)).app (op V')).hom r =
        ((totalQuotientSheaf X.sheaf).obj).map (homOfLE h).op q := by
  have hls : CategoryTheory.Presheaf.IsLocallySurjective (Opens.grothendieckTopology X)
      (toSheafify (Opens.grothendieckTopology X) (totalQuotientPre X)) := inferInstance
  obtain ⟨V', hV', ⟨r, hr⟩, hxV'⟩ :=
    (TopCat.Presheaf.isLocallySurjective_iff _).mp hls V q x hx
  exact ⟨V', hV', hxV', r, hr⟩

/-- **A meromorphic section of an invertible sheaf is locally a ratio of nonzerodivisors.**
Around every point of every open set `W` there is an affine open `V ≤ W` over which `L` is
trivial and a nonzerodivisor `b ∈ Γ(X, V)` with `b · s = toK t` for a section `t` of `L` over
`V`; that is, `b` is a denominator of `s` over `V`.  No Noetherian hypothesis is used. -/
theorem exists_affineOpen_denominator
    (hL : AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf (O X).property L)
    (W : Opens X) (x : X) (hx : x ∈ W) :
    ∃ V : Opens X, V ≤ W ∧ x ∈ V ∧ IsAffineOpen V ∧
      Nonempty (Stacks.SheafDescent.Trivialization X.presheaf L.val V) ∧
      ∃ b ∈ nonZeroDivisors Γ(X, V), ∃ t : (L.val.obj (op V) : Type u),
        (toK X L).val.app (op V) t = (sectionMap X L s).val.app (op V) b := by
  have := hL
  obtain ⟨Y, hY, triv⟩ := Stacks.SheafRankOne.exists_cover_trivialization_of_isInvertible
    (X := X.toRingedSpace) (O X).property L
  obtain ⟨i, hi⟩ := Opens.mem_iSup.mp (hY ▸ Opens.mem_top x)
  -- lift the section to the sectionwise tensor product near `x`
  obtain ⟨V₁, hV₁, hxV₁, z, hz⟩ := exists_preimage_toSheafifyMeromorphic X L
    (W ⊓ Y i) (sectionOver X L s (W ⊓ Y i)) x ⟨hx, hi⟩
  rw [sectionOver_restrict] at hz
  -- collapse the tensor product using a trivialization of `L` over `V₁`
  obtain ⟨q₀, hq₀⟩ := exists_smul_tmulOneElt (toK₀ X) L.val (op V₁)
    ((triv i).some.θ V₁ (homOfLE (hV₁.trans inf_le_right))) z
  -- lift `q₀` to a fraction near `x`
  obtain ⟨V₂, hV₂, hxV₂, r, hr⟩ := exists_preimage_toSheafify X V₁ q₀ x hxV₁
  -- shrink to an affine open
  obtain ⟨-, ⟨V₃, hV₃aff, rfl⟩, hxV₃, hV₃sub⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxV₂ V₂.isOpen
  have hV₃ : V₃ ≤ V₂ := hV₃sub
  have hV₃₁ : V₃ ≤ V₁ := hV₃.trans hV₂
  -- the restriction of the fraction still represents the restriction of `q`
  have hr₃ : ((toSheafify (Opens.grothendieckTopology X) (totalQuotientPre X)).app (op V₃)).hom
      ((totalQuotientPre X).map (homOfLE hV₃).op r) =
      ((totalQuotientSheaf X.sheaf).obj).map (homOfLE hV₃₁).op q₀ := by
    have hnat := ConcreteCategory.congr_hom
      ((toSheafify (Opens.grothendieckTopology X) (totalQuotientPre X)).naturality
        (homOfLE hV₃).op) r
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply, hr] at hnat
    rw [hnat]
    exact (ConcreteCategory.congr_hom
      (((totalQuotientSheaf X.sheaf).obj).map_comp (homOfLE hV₂).op (homOfLE hV₃).op) q₀).symm
  -- clear the denominator of the fraction over the affine open
  obtain ⟨⟨a₀, b₀⟩, hab⟩ := IsLocalization.surj ((denominators X).obj (op V₃))
    ((totalQuotientPre X).map (homOfLE hV₃).op r)
  obtain ⟨a, ha⟩ : ∃ a : oScalar X V₃, (a₀ : Γ(X, V₃)) = a := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : oScalar X V₃, ((b₀ : (denominators X).obj (op V₃)) : Γ(X, V₃)) = b :=
    ⟨_, rfl⟩
  obtain ⟨c, hc⟩ : ∃ c : kScalar X V₃, ((toK₀ X).app (op V₃)).hom b = c := ⟨_, rfl⟩
  -- the fraction equation inside the sheaf of total quotient rings
  have hring : ((totalQuotientSheaf X.sheaf).obj).map (homOfLE hV₃₁).op q₀ *
      ((toK₀ X).app (op V₃)).hom b = ((toK₀ X).app (op V₃)).hom a := by
    have h₁ := congrArg
      (((toSheafify (Opens.grothendieckTopology X) (totalQuotientPre X)).app (op V₃)).hom) hab
    rw [map_mul, hr₃] at h₁
    rw [← ha, ← hb]
    exact h₁
  -- the restriction of the trivializing section
  obtain ⟨t₃, ht₃⟩ : ∃ t₃ : (L.val.obj (op V₃) : Type u), L.val.map (homOfLE hV₃₁).op
      (((triv i).some.θ V₁ (homOfLE (hV₁.trans inf_le_right))).symm (1 : Γ(X, V₁))) = t₃ :=
    ⟨_, rfl⟩
  -- the cleared equation at the level of the tensor product
  obtain ⟨z₃, hz₃⟩ : ∃ z₃ : (((Stacks.PresheafOfModules.ChangeOfRings.changeOfRings (toK₀ X)).obj
    L.val).obj (op V₃) : Type u),
      ((Stacks.PresheafOfModules.ChangeOfRings.changeOfRings (toK₀ X)).obj L.val).map (homOfLE
        hV₃₁).op z = z₃ := ⟨_, rfl⟩
  have hrestrict : z₃ =
      (((totalQuotientSheaf X.sheaf).obj).map (homOfLE hV₃₁).op q₀) •
        tmulOneElt (toK₀ X) L.val (op V₃) t₃ := by
    rw [← hz₃, hq₀, ← ht₃]
    exact map_smul_tmulOneElt (toK₀ X) L.val (homOfLE hV₃₁).op q₀ _
  have hcleared : (((toK₀ X).app (op V₃)).hom b) • z₃ =
      tmulOneElt (toK₀ X) L.val (op V₃) (a • t₃) := by
    rw [hrestrict]
    exact smul_smul_tmulOneElt (toK₀ X) L.val (op V₃) _ t₃ a b hring
  -- push it through the sheafification
  have hpush : c • sectionOver X L s V₃ = (toK X L).val.app (op V₃) (a • t₃) := by
    have h1 := congrArg (fun w => (toSheafifyMeromorphic X L).app (op V₃) w) hcleared
    have h2 := map_smul ((toSheafifyMeromorphic X L).app (op V₃)).hom
      (((toK₀ X).app (op V₃)).hom b) z₃
    have h3 : sectionOver X L s V₃ = (toSheafifyMeromorphic X L).app (op V₃) z₃ := by
      rw [← hz₃,
        PresheafOfModules.naturality_apply (toSheafifyMeromorphic X L) (homOfLE hV₃₁).op z, hz]
      exact (sectionOver_restrict X L s hV₃₁).symm
    have h4 : (toK X L).val.app (op V₃) (a • t₃) =
        (toSheafifyMeromorphic X L).app (op V₃)
          (tmulOneElt (toK₀ X) L.val (op V₃) (a • t₃)) :=
      (app_tmulOneElt (toK₀ X) L.val (toSheafifyMeromorphic X L) (op V₃) (a • t₃)).symm
    rw [h3, ← hc]
    exact h2.symm.trans (h1.trans h4.symm)
  refine ⟨V₃, hV₃₁.trans (hV₁.trans inf_le_left), hxV₃, hV₃aff,
    ⟨(triv i).some.comp (homOfLE (hV₃₁.trans (hV₁.trans inf_le_right)))⟩, b, ?_, a • t₃, ?_⟩
  · rw [← AlgebraicGeometry.submonoidPresheafOfStalk_obj_eq_nonZeroDivisors X V₃ hV₃aff, ← hb]
    exact b₀.2
  · rw [sectionMap_app X L s V₃ b c hc]
    exact hpush.symm

end Stacks.DenominatorLocalRatio

