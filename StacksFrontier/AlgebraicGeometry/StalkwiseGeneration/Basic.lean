module

public import StacksFrontier.AlgebraicGeometry.AmpleLocalGeneration.Basic
public import StacksFrontier.AlgebraicGeometry.ProjectiveFromSections.Ratio

/-!
# Generation by finitely many global sections is stalkwise generation

Let `M` be an `𝒪_X`-module on a scheme `X`. There are two conditions saying that `M` is generated
by finitely many global sections:

* `Stacks.AmpleEventualGeneration.IsFinGen M`, an epimorphism `⨁_{i ∈ I} 𝒪_X ⟶ M` out of a finite
  free module, i.e. a `SheafOfModules.GeneratingSections` with finite index type;
* `Stacks.ProjectiveFromSections.GeneratesStalks t` for a finite family `t`, the statement that
  every element of every stalk `M_x` is a finite `𝒪_{X,x}`-combination of the germs of the `t i`.

[Stacks, Tag 01AN] is the equivalence of the two, and its span form
(`AlgebraicGeometry.generates_iff_stalkwise_generates`) takes the span over the stalk of the
`RingCat`-valued structure sheaf `X.ringCatSheaf`, while `GeneratesStalks` quantifies over scalars
in the `CommRingCat`-valued stalk `𝒪_{X,x} = X.presheaf.stalk x`. This file crosses that gap and
spends Tag 01AN in the direction that produces `GeneratesStalks`.

## Main definitions

* `Stacks.StalkwiseGeneration.maximalSmulRing`: the submodule `𝔪_x M_x` of a module stalk, read
  over the stalk of the `RingCat`-valued structure sheaf.

## Main results

* `Stacks.StalkwiseGeneration.exists_stalk_smul_eq`: **a scalar multiple of an element of a module
  stalk over the stalk of `X.ringCatSheaf` is also a scalar multiple of it over `𝒪_{X,x}`.** This
  is the converse of `Stacks.FinGenFromCover.exists_ringStalk_smul_eq`.
* `Stacks.StalkwiseGeneration.exists_mem_nvOpen_of_span_eq_top`: a family of global sections of an
  invertible module whose germs span a stalk has a member that does not vanish there.
* `Stacks.StalkwiseGeneration.generatesStalks_of_span_eq_top` and
  `generatesStalks_iff_span_eq_top`: **the germs of a family of global sections span every stalk
  exactly when the family generates the stalks**, the second being the form [Stacks, Tag 01NE]
  consumes. Neither invertibility nor finiteness of the index type is needed.
* `Stacks.StalkwiseGeneration.exists_generatesStalks_of_isFinGen`: **an `𝒪_X`-module generated by
  finitely many global sections carries a family `Fin (m + 1) → Γ(M, ⊤)` generating every stalk.**

## Implementation notes

**The two spellings of the stalk ring.** `X.presheaf.stalk x` and
`TopCat.Presheaf.stalk X.ringCatSheaf.obj x` are filtered colimits of the same diagram of rings
taken in `CommRingCat` and in `RingCat`, and no ring homomorphism between them is constructed
here. Both act on `M_x` by the same formula on germs — `Stacks.ModuleStalk.germ_smul` and
`Stacks.FinGenFromCover.ringStalk_germ_smul` — so a scalar multiple of a *fixed* stalk element can
be rewritten from either action to the other by representing the scalar and the element on a
common open. That is all `exists_stalk_smul_eq` does, and it suffices to transport a membership in
a span: a `Finsupp` decomposition over the one ring becomes, term by term, a decomposition over
the other.

**The padding index.** [Stacks, Tag 01NE] consumes `GeneratesStalks` at a family indexed by
`Fin (m + 1)`, which is nonempty, while the index type of a `GeneratingSections` may be empty. The
family of `exists_generatesStalks_of_isFinGen` is therefore the given one on `Fin.castSucc` and
the *zero* section on `Fin.last`; adding a member only enlarges the span of the germs, so the
spanning hypothesis survives the padding.

## References

* [Stacks Project, Tag 01AN](https://stacks.math.columbia.edu/tag/01AN)
* [Stacks Project, Tag 01NE](https://stacks.math.columbia.edu/tag/01NE)
* [Stacks Project, Tag 01CY](https://stacks.math.columbia.edu/tag/01CY)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open Stacks.Ample Stacks.ProjectiveFromSections
open scoped Stacks.ModuleStalk Stacks.FinGenFromCover

universe u

namespace Stacks.StalkwiseGeneration

variable {X : Scheme.{u}}

/-! ### Scalars on a module stalk -/

/-- **Every `RingCat`-stalk scalar multiple of an element of a module stalk is an
`𝒪_{X,x}`-scalar multiple of it.** This is the converse direction of
`Stacks.FinGenFromCover.exists_ringStalk_smul_eq`, proved the same way: both actions are given by
the same formula on germs, so representing the scalar and the stalk element on a common open
reduces the claim to an identity of sections. -/
theorem exists_stalk_smul_eq (M : X.Modules) (x : X)
    (r : (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat))
    (m : TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x) :
    ∃ r' : X.presheaf.stalk x, r • m = r' • m := by
  obtain ⟨U, hU, r₀, hr⟩ := TopCat.Presheaf.exists_germ_eq X.ringCatSheaf.obj r
  obtain ⟨V, hV, m₀, hm⟩ := TopCat.Presheaf.exists_germ_eq (C := Ab.{u}) M.presheaf m
  have hxW : x ∈ U ⊓ V := ⟨hU, hV⟩
  set r₁ : Γ(X, U ⊓ V) := X.presheaf.map (homOfLE (inf_le_left (a := U) (b := V))).op r₀ with hr₁
  set m₁ := M.presheaf.map (homOfLE (inf_le_right (a := U) (b := V))).op m₀ with hm₁
  have hrW : (TopCat.Presheaf.germ X.ringCatSheaf.obj (U ⊓ V) x hxW).hom r₁ = r :=
    (TopCat.Presheaf.germ_res_apply X.ringCatSheaf.obj (homOfLE inf_le_left) x hxW r₀).trans hr
  have hmW : (TopCat.Presheaf.germ (C := Ab.{u}) M.presheaf (U ⊓ V) x hxW).hom m₁ = m :=
    (TopCat.Presheaf.germ_res_apply (C := Ab.{u}) M.presheaf (homOfLE inf_le_right) x hxW
      m₀).trans hm
  refine ⟨(X.presheaf.germ (U ⊓ V) x hxW).hom r₁, ?_⟩
  rw [← hrW, ← hmW, ← Stacks.FinGenFromCover.ringStalk_germ_smul, Stacks.ModuleStalk.germ_smul]

/-- The submodule `𝔪_x · M_x` of a module stalk, read over the stalk of the `RingCat`-valued
structure sheaf. -/
def maximalSmulRing (M : X.Modules) (x : X) :
    Submodule (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat)
      (TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x) where
  carrier := Stacks.ModuleStalk.maximalSmul M x
  add_mem' hm hm' := Submodule.add_mem _ hm hm'
  zero_mem' := Submodule.zero_mem _
  smul_mem' c m hm := by
    obtain ⟨r, hr⟩ := exists_stalk_smul_eq M x c m
    exact hr ▸ Submodule.smul_mem _ r hm

/-- A submodule of a module stalk over the `RingCat`-valued stalk is closed under `𝒪_{X,x}`-scalar
multiplication. -/
private theorem stalk_smul_mem (M : X.Modules) (x : X)
    (S : Submodule (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat)
      (TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x))
    (r : X.presheaf.stalk x) {m : TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x} (hm : m ∈ S) :
    r • m ∈ S := by
  obtain ⟨r', hr'⟩ := Stacks.FinGenFromCover.exists_ringStalk_smul_eq M x r m
  exact hr' ▸ S.smul_mem r' hm

/-- A submodule of a module stalk absorbs the germ of a scalar multiple of any section whose own
germ it contains. -/
theorem mem_of_Γgerm_smul (M : X.Modules) (x : X) (a : Γ(X, ⊤)) (t : Γ(M, ⊤))
    (S : Submodule (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat)
      (TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x))
    (ht : (M.presheaf.Γgerm x).hom t ∈ S) :
    (M.presheaf.Γgerm x).hom (a • t) ∈ S := by
  rw [Stacks.ModuleStalk.Γgerm_smul]
  exact stalk_smul_mem M x S _ ht

/-- **A family of global sections of an invertible module whose germs span a stalk has a member
not vanishing there.** If every germ lay in `𝔪_x · M_x` then so would every element of the span,
and `Stacks.SectionProduct.exists_notMem_maximalSmul` says some element does not. -/
theorem exists_mem_nvOpen_of_span_eq_top (M : X.Modules) [IsInvertibleModule X M] {ι : Type*}
    (v : ι → Γ(M, ⊤)) (x : X)
    (h : Submodule.span (R := (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat))
      (Set.range fun i => (M.presheaf.Γgerm x).hom (v i)) = ⊤) :
    ∃ i, x ∈ Stacks.ProjectiveFromSections.nvOpen M (v i) := by
  by_contra hx
  simp only [not_exists] at hx
  obtain ⟨w, hw⟩ := Stacks.SectionProduct.exists_notMem_maximalSmul M x
  have hle : Submodule.span (R := (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat))
      (Set.range fun i => (M.presheaf.Γgerm x).hom (v i)) ≤ maximalSmulRing M x := by
    rw [Submodule.span_le]
    rintro - ⟨i, rfl⟩
    have hi := hx i
    rw [Stacks.NonvanishingOpen.mem_nonvanishingOpen, Stacks.Ample.mem_nonvanishingLocus_iff,
      not_not] at hi
    exact hi
  rw [h] at hle
  exact hw (hle Submodule.mem_top)

/-! ### Spanning germs generate the stalks -/

/-- **A family of global sections whose germs span every stalk generates the stalks.** The span of
[Stacks, Tag 01AN] is taken over the stalk of the `RingCat`-valued structure sheaf, so each term
of a `Finsupp` decomposition of a stalk element has its coefficient rewritten into `𝒪_{X,x}` by
`exists_stalk_smul_eq`; the support of the decomposition is the `Finset` that
`Stacks.ProjectiveFromSections.GeneratesStalks` asks for. -/
theorem generatesStalks_of_span_eq_top {M : X.Modules} {ι : Type*} (t : ι → Γ(M, ⊤))
    (h : ∀ x : X, Submodule.span (R := (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat))
      (Set.range fun i => (M.presheaf.Γgerm x).hom (t i)) = ⊤) :
    GeneratesStalks t := by
  classical
  intro x w
  have hw : w ∈ Submodule.span (R := (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat))
      (Set.range fun i => (M.presheaf.Γgerm x).hom (t i)) := (h x).ge Submodule.mem_top
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hw
  choose r hr using fun i => exists_stalk_smul_eq M x (c i) ((M.presheaf.Γgerm x).hom (t i))
  refine ⟨c.support, r, ?_⟩
  rw [← hc]
  exact Finset.sum_congr rfl fun i _ => hr i

/-- **The germs of a family of global sections span every stalk exactly when the family generates
the stalks.** The forward direction rewrites each coefficient of a decomposition with
`Stacks.FinGenFromCover.exists_ringStalk_smul_eq`. -/
theorem generatesStalks_iff_span_eq_top {M : X.Modules} {ι : Type*} (t : ι → Γ(M, ⊤)) :
    GeneratesStalks t ↔ ∀ x : X,
      Submodule.span (R := (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat))
        (Set.range fun i => (M.presheaf.Γgerm x).hom (t i)) = ⊤ := by
  refine ⟨fun ht x => eq_top_iff.mpr fun w _ => ?_, generatesStalks_of_span_eq_top t⟩
  obtain ⟨s, r, hw⟩ := ht x w
  refine hw ▸ Submodule.sum_mem _ fun i _ => ?_
  exact stalk_smul_mem M x _ _ (Submodule.subset_span ⟨i, rfl⟩)

/-- **An `𝒪_X`-module generated by finitely many global sections carries a family indexed by
`Fin (m + 1)` generating every stalk.** This is the shape in which the morphism to `ℙᵐ` of
[Stacks, Tag 01NE] consumes generation; the last index carries the zero section, which the
spanning hypothesis tolerates. -/
theorem exists_generatesStalks_of_isFinGen {M : X.Modules}
    (h : Stacks.AmpleEventualGeneration.IsFinGen M) :
    ∃ (m : ℕ) (t : Fin (m + 1) → Γ(M, ⊤)), GeneratesStalks t := by
  classical
  obtain ⟨I, t, hI, hspan⟩ := Stacks.AmpleLocalGeneration.isFinGenOn_of_isFinGen h ⊤
  have : Finite I := hI
  cases nonempty_fintype I
  set e := Fintype.equivFin I with he
  refine ⟨Fintype.card I, Fin.lastCases 0 fun j => t (e.symm j), ?_⟩
  refine generatesStalks_of_span_eq_top _ fun x => ?_
  refine le_antisymm le_top (le_trans (le_of_eq (hspan x (Opens.mem_top x)).symm)
    (Submodule.span_mono ?_))
  rintro - ⟨i, rfl⟩
  exact ⟨(e i).castSucc, by simp only [Fin.lastCases_castSucc, Equiv.symm_apply_apply]⟩

end Stacks.StalkwiseGeneration

end
