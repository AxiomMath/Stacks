/-! ### Transfer of a spanning family -/

/-- **Transfer of a spanning family along a semilinear surjection.** If an additive surjection
`f` satisfies `f (r • x) = σ r • f x` for a map `σ` of the two rings of scalars, then it carries
a spanning family to a spanning family. -/
public theorem span_range_eq_top_of_semilinear_surjective {R R' : Type*} [Ring R] [Ring R']
    {M N : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R' N]
    (σ : R → R') (f : M → N) (hzero : f 0 = 0) (hadd : ∀ a b, f (a + b) = f a + f b)
    (hsmul : ∀ (r : R) (x : M), f (r • x) = σ r • f x) (hf : Function.Surjective f)
    {ι : Type*} (w : ι → M) (hw : Submodule.span R (Set.range w) = ⊤) :
    Submodule.span R' (Set.range fun i => f (w i)) = ⊤ := by
  rw [Submodule.eq_top_iff']
  intro x
  obtain ⟨y, rfl⟩ := hf x
  have hmem : y ∈ Submodule.span R (Set.range w) := hw ▸ Submodule.mem_top
  induction hmem using Submodule.span_induction with
  | mem z hz => obtain ⟨i, rfl⟩ := hz; exact Submodule.subset_span ⟨i, rfl⟩
  | zero => rw [hzero]; exact Submodule.zero_mem _
  | add z w _ _ hz hw => rw [hadd]; exact Submodule.add_mem _ hz hw
  | smul r z _ hz => rw [hsmul]; exact Submodule.smul_mem _ _ hz

/-! ### Two lemmas on finite intersections -/

/-- The image of a finite nonempty intersection of opens under an open immersion is the
intersection of the images, the underlying map being injective. -/
public theorem image_inf_of_isOpenImmersion {X Y : Scheme.{u}} (j : X ⟶ Y) [IsOpenImmersion j]
    {ι : Type*} (P : ι → X.Opens) {s : Finset ι} (hs : s.Nonempty) :
    j ''ᵁ s.inf P = s.inf fun i => j ''ᵁ P i := by
  induction hs using Finset.Nonempty.cons_induction with
  | singleton a => simp
  | cons a t ha ht ih =>
      rw [Finset.inf_cons, Finset.inf_cons, ← ih]
      refine TopologicalSpace.Opens.ext ?_
      simpa using (Set.image_inter j.isOpenEmbedding.injective (s := (P a : Set X))
        (t := ((t.inf P : X.Opens) : Set X)))

/-- A finite nonempty intersection of standard opens of a projective spectrum is the standard
open of the product of the elements. -/
@[ega "II 2.3.3" "more general"]
public theorem inf_basicOpen_eq_basicOpen_prod {R : Type u} {σ : Type u} [CommRing R]
    [SetLike σ R] [AddSubgroupClass σ R] (𝒜 : ℕ → σ) [GradedRing 𝒜] {ι : Type*} (x : ι → R)
    {s : Finset ι} (hs : s.Nonempty) :
    (s.inf fun i => Proj.basicOpen 𝒜 (x i)) = Proj.basicOpen 𝒜 (∏ i ∈ s, x i) := by
  induction hs using Finset.Nonempty.cons_induction with
  | singleton a => simp
  | cons a t ha ht ih =>
      rw [Finset.inf_cons, ih, Finset.prod_cons, Proj.basicOpen_mul]

/-! ### Vanishing from degree-one generators on a basis of the base -/

section Relative

variable {S : Scheme.{u}} {A : SheafGradedAlgebra S}

/-- **The higher direct images of a twist on a relative projective spectrum vanish in degrees at
least `k`**, when the ring of homogeneous sections over every open of a basis of the base is
generated by `k` degree-one elements over its degree-zero part.

The `k` standard opens attached to those elements cover the absolute projective spectrum of the
section ring, because generation in degree one makes them a covering family
(`AlgebraicGeometry.Proj.iSup_basicOpen_eq_top'`); their images under the affine chart therefore
cover the inverse image of the open, are affine, and have affine finite intersections. The
conclusion is the Čech degree bound of [Stacks, Tag 071L] in the form
`AlgebraicGeometry.isZero_rightDerivedPlus_pushforward_of_affine_cover_bound`. -/
public theorem isZero_rightDerivedPlus_pushforward_piece (D : TwistData A) (t : ℤ) (k : ℕ)
    {B : Set S.Opens} (hB : Opens.IsBasis B)
    (hgen : ∀ V ∈ B, ∃ (_ : IsAffineOpen V) (x : Fin k → A.sectionRing V),
      (∀ i, x i ∈ A.grading V 1) ∧ Algebra.adjoin (A.grading V 0) (Set.range x) = ⊤)
    (q : ℕ) (hq : k ≤ q) :
    IsZero (((Scheme.Modules.pushforward (relativeProj A).toBase).rightDerivedPlus (q : ℤ)).obj
      (D.algebra.piece t)) := by
  have : (D.algebra.piece t).IsQuasicoherent := D.isQuasicoherent t
  refine AlgebraicGeometry.isZero_rightDerivedPlus_pushforward_of_affine_cover_bound
    (relativeProj A).toBase (D.algebra.piece t) hB k (fun V hVB => ?_) q hq
  obtain ⟨hV, x, hx, hadj⟩ := hgen V hVB
  set j := (relativeProj A).chart V hV with hj
  set P : Fin k → (AlgebraicGeometry.Proj (A.grading V)).Opens :=
    fun i => Proj.basicOpen (A.grading V) (x i) with hP
  have hPaff : ∀ i, IsAffineOpen (P i) :=
    fun i => Proj.isAffineOpen_basicOpen (A.grading V) (x i) (hx i) one_pos
  have hcov : (⨆ i, P i) = ⊤ :=
    Proj.iSup_basicOpen_eq_top' (A.grading V) x (fun i => ⟨1, hx i⟩) hadj
  refine ⟨k, fun i => j ''ᵁ P i, fun i => ?_, ?_, fun s hs => ⟨1, fun _ => s.inf
    fun i => j ''ᵁ P i, fun _ => ?_, ?_, ?_⟩⟩
  · exact j.isAffineOpen_iff_of_isOpenImmersion.mpr (hPaff i)
  · rw [← j.image_iSup, hcov]
    exact RelativeProjTwistGlue.chart_image_top (relativeProj A) V hV
  · rw [← image_inf_of_isOpenImmersion j P hs, inf_basicOpen_eq_basicOpen_prod (A.grading V) x hs]
    refine j.isAffineOpen_iff_of_isOpenImmersion.mpr
      (Proj.isAffineOpen_basicOpen (A.grading V) _ ?_ (Finset.card_pos.mpr hs))
    simpa using SetLike.prod_mem_graded (A.grading V) (fun _ : Fin k => 1) x
      (F := s) fun i _ => hx i
  · simp
  · have hcard : s.card ≤ k := by simpa using s.card_le_univ
    omega

/-- **Degree-one generators from a spanning family of the degree-one part.** If the degree-one
homogeneous sections over an open `V` are spanned, as a `Γ(S, V)`-module, by a family `y`, and
the section ring is generated over its degree-zero part by its degree-one part, then the elements
`of 1 (y i)` are degree-one elements generating the section ring.

Multiplication by a degree-zero section is the module action of `Γ(S, V)`
(`…SheafGradedAlgebra.strHom_mul_of`), so the subalgebra generated by the `of 1 (y i)` contains
the whole degree-one part. -/
public theorem exists_degreeOne_generators_of_span {I : Type*} {V : S.Opens}
    (hgen : Algebra.adjoin (A.grading V 0) (A.grading V 1 : Set (A.sectionRing V)) = ⊤)
    (y : I → A.sectionPieces V 1) (hy : Submodule.span Γ(S, V) (Set.range y) = ⊤) :
    ∃ x : I → A.sectionRing V, (∀ i, x i ∈ A.grading V 1) ∧
      Algebra.adjoin (A.grading V 0) (Set.range x) = ⊤ := by
  refine ⟨fun i => DirectSum.of (A.sectionPieces V) 1 (y i),
    fun i => A.of_mem_grading V (y i), ?_⟩
  have hsub : ∀ z : A.sectionPieces V 1, DirectSum.of (A.sectionPieces V) 1 z ∈
      Algebra.adjoin (A.grading V 0)
        (Set.range fun i => DirectSum.of (A.sectionPieces V) 1 (y i)) := by
    intro z
    have hz : z ∈ Submodule.span Γ(S, V) (Set.range y) := hy ▸ Submodule.mem_top
    induction hz using Submodule.span_induction with
    | mem a ha => obtain ⟨i, rfl⟩ := ha; exact Algebra.subset_adjoin ⟨i, rfl⟩
    | zero => rw [map_zero]; exact zero_mem _
    | add a b _ _ ha hb => rw [map_add]; exact add_mem ha hb
    | smul r a _ ha =>
        rw [← A.strHom_mul_of V r a]
        exact mul_mem (Subalgebra.algebraMap_mem _ (⟨A.strHom V r, A.strHom_mem V r⟩ :
          A.grading V 0)) ha
  refine top_unique ?_
  rw [← hgen]
  refine Algebra.adjoin_le fun z hz => ?_
  obtain ⟨zz, rfl⟩ := (A.mem_grading_iff V z).mp hz
  exact hsub zz

/-- **The higher direct images of a twist vanish in degrees at least `k`, from a spanning family
of the degree-one sections.** The variant of
`Stacks.AlgebraicGeometry.ProjectiveBundleVanishing.isZero_rightDerivedPlus_pushforward_piece`
whose hypothesis is generation in degree one together with `k` degree-one sections spanning the
degree-one part over the base, which is what a local trivialization supplies. -/
public theorem isZero_rightDerivedPlus_pushforward_piece_of_span (D : TwistData A) (t : ℤ)
    (k : ℕ) {B : Set S.Opens} (hB : Opens.IsBasis B)
    (hgen : ∀ V ∈ B, ∃ _ : IsAffineOpen V,
      (Algebra.adjoin (A.grading V 0) (A.grading V 1 : Set (A.sectionRing V)) = ⊤) ∧
        ∃ y : Fin k → A.sectionPieces V 1, Submodule.span Γ(S, V) (Set.range y) = ⊤)
    (q : ℕ) (hq : k ≤ q) :
    IsZero (((Scheme.Modules.pushforward (relativeProj A).toBase).rightDerivedPlus (q : ℤ)).obj
      (D.algebra.piece t)) := by
  refine isZero_rightDerivedPlus_pushforward_piece D t k hB (fun V hVB => ?_) q hq
  obtain ⟨hVa, hg, y, hy⟩ := hgen V hVB
  obtain ⟨x, hx, hadj⟩ :=
    exists_degreeOne_generators_of_span (A := A) (I := Fin k) (V := V) hg y hy
  exact ⟨hVa, x, hx, hadj⟩

end Relative

/-! ### Degree-one generators from a local trivialization -/

section Generators

variable {S : Scheme.{u}} (E : S.Modules)

/-- A trivialization of a module over an open restricts to a trivialization over every smaller
open. -/
public def restrictIsoFreeOfLE {I : Type u} {U V : S.Opens} (h : V ≤ U)
    (e : E.restrict U.ι ≅ SheafOfModules.free.{u} I) :
    E.restrict V.ι ≅ SheafOfModules.free.{u} I :=
  ((Scheme.Modules.restrictFunctorCongr
        (show S.homOfLE h ≫ U.ι = V.ι by simp)).app E).symm ≪≫
    ((Scheme.Modules.restrictFunctorComp (S.homOfLE h) U.ι).app E) ≪≫
    (Scheme.Modules.restrictFunctor (S.homOfLE h)).mapIso e ≪≫
    (Scheme.Modules.restrictFreeIso (S.homOfLE h) I).symm

/-- **The affine opens trivializing a finite locally free module of rank `r` form a basis.**
Local freeness gives a trivializing neighbourhood of every point, the affine opens are a basis,
and a trivialization restricts to every smaller open. -/
public theorem isBasis_trivializing {r : ℕ}
    (hfree : Scheme.Modules.IsFiniteLocallyFreeOfRank E r) :
    Opens.IsBasis {V : S.Opens | IsAffineOpen V ∧
      Nonempty (E.restrict V.ι ≅ SheafOfModules.free.{u} (ULift.{u} (Fin r)))} := by
  rw [TopologicalSpace.Opens.isBasis_iff_nbhd]
  intro U x hxU
  obtain ⟨W, hxW, ⟨e⟩⟩ := hfree x
  have hmem : x ∈ U ⊓ W := ⟨hxU, hxW⟩
  obtain ⟨V, hVmem, hxV, hVle⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp S.isBasis_affineOpens) hmem
  exact ⟨V, ⟨hVmem, ⟨restrictIsoFreeOfLE E (hVle.trans inf_le_right) e⟩⟩, hxV,
    hVle.trans inf_le_left⟩

/-- **A spanning family of sections from a trivialization.** If the restriction of `E` to an open
`V` is free on a finite index type `I`, then the sections of `E` over `V` are spanned, over
`Γ(S, V)`, by a family indexed by `I`: the standard basis of the sections of the free module,
carried across the trivialization. The two rings of scalars are identified by
`AlgebraicGeometry.Scheme.Hom.appIso`, which is why the transfer used is the semilinear one. -/
public theorem exists_span_sections {I : Type u} [Finite I] {V : S.Opens}
    (e : E.restrict V.ι ≅ SheafOfModules.free.{u} I) :
    ∃ v : I → Γ(E, V), Submodule.span Γ(S, V) (Set.range v) = ⊤ := by
  classical
  have hVtop : V.ι ''ᵁ ⊤ = V := V.ι_image_top
  rw [← hVtop]
  set L := (e.inv.val.app (op (⊤ : (V.toScheme).Opens))).hom with hL
  let _ : Module ↑Γ(S, V.ι ''ᵁ (⊤ : (V.toScheme).Opens))
      ↑((E.restrict V.ι).val.obj (op (⊤ : (V.toScheme).Opens))) :=
    inferInstanceAs (Module ↑Γ(S, V.ι ''ᵁ (⊤ : (V.toScheme).Opens))
      ↑Γ(E, V.ι ''ᵁ (⊤ : (V.toScheme).Opens)))
  refine ⟨_, span_range_eq_top_of_semilinear_surjective
    (fun r : ↑((V.toScheme).ringCatSheaf.obj.obj (op (⊤ : (V.toScheme).Opens))) =>
      (Scheme.Hom.appIso V.ι (⊤ : (V.toScheme).Opens)).inv r)
    (fun y => L y) (map_zero L) (fun a b => map_add L a b) ?_ ?_ _
    (Stacks.SheafOfModules.freeCoordBasis
      (V.toScheme).ringCatSheaf.property (ι := I) (op (⊤ : (V.toScheme).Opens))).span_eq⟩
  · intro r y
    rw [map_smul]
    exact Scheme.Modules.smul_restrictAppIso_hom_apply V.ι E ⊤ r (L y)
  · intro y
    refine ⟨(e.hom.val.app (op (⊤ : (V.toScheme).Opens))).hom y, ?_⟩
    have h : ((e.hom ≫ e.inv).val.app (op (⊤ : (V.toScheme).Opens))).hom y = y := by
      rw [e.hom_inv_id]; rfl
    exact h

variable [E.IsQuasicoherent]

/-- **A spanning family of the degree-one homogeneous sections of `Sym(E)` over an affine open.**
Over an affine open the sheafification unit `Sym¹_{Γ(S, V)}(Γ(E, V)) ⟶ Γ(V, Sym¹(E))` is
bijective (`Stacks.SymGraded.bijective_sheafifyUnit_app_of_isAffineOpen`) and the degree-one
symmetric power of a module is the image of the module, so a spanning family of `Γ(E, V)` gives
one of the degree-one homogeneous sections. -/
public theorem exists_span_sectionPieces_one {I : Type u}
    (hqc : Stacks.SymGraded.IsQuasicoherentPieces E)
    {V : S.Opens} (hV : IsAffineOpen V) (w : I → Γ(E, V))
    (hw : Submodule.span Γ(S, V) (Set.range w) = ⊤) :
    ∃ y : I → (Stacks.SymGraded.schemeSheafGradedAlgebra E hqc).sectionPieces V 1,
      Submodule.span Γ(S, V) (Set.range y) = ⊤ := by
  classical
  have hu := Stacks.SymGraded.bijective_sheafifyUnit_app_of_isAffineOpen E hV 1
  let _ : Module ↑Γ(S, V)
      ↑((Stacks.SymGraded.siteGradedPiece E.val 1).obj (op V)) :=
    inferInstanceAs (Module ↑Γ(S, V)
      (SymPow.symmetricPower 1 ↑Γ(S, V) ↑Γ(E, V)))
  let _ : Module ↑Γ(S, V) ↑((PresheafOfModules.sheafifyRestrict (𝟙 S.ringCatSheaf.obj)
      (Stacks.SymGraded.siteGradedPiece E.val 1)).obj (op V)) :=
    inferInstanceAs (Module ↑Γ(S, V)
      ((Stacks.SymGraded.schemeSheafGradedAlgebra E hqc).sectionPieces V 1))
  have h1 : Submodule.span Γ(S, V)
      (Set.range fun i => SymmetricAlgebra.toGradingOne ↑Γ(S, V) ↑Γ(E, V) (w i)) = ⊤ := by
    refine span_range_eq_top_of_semilinear_surjective id _ (map_zero _)
      (fun a b => map_add _ a b) (fun r y => map_smul _ r y) ?_ w hw
    intro z
    obtain ⟨m, hm⟩ := (SymmetricAlgebra.mem_grading_one_iff ↑Γ(S, V) ↑Γ(E, V)).mp z.2
    exact ⟨m, Subtype.ext hm⟩
  refine ⟨fun i => ((PresheafOfModules.sheafifyUnit (𝟙 S.ringCatSheaf.obj)
      (Stacks.SymGraded.siteGradedPiece E.val 1)).app (op V)).hom
      (SymmetricAlgebra.toGradingOne ↑Γ(S, V) ↑Γ(E, V) (w i)), ?_⟩
  refine span_range_eq_top_of_semilinear_surjective (R := ↑Γ(S, V)) (R' := ↑Γ(S, V)) id
    (fun z => ((PresheafOfModules.sheafifyUnit (𝟙 S.ringCatSheaf.obj)
      (Stacks.SymGraded.siteGradedPiece E.val 1)).app (op V)).hom z)
    (map_zero _) (fun a b => map_add _ a b) (fun r y => map_smul _ r y) hu.2 _ h1

end Generators

/-! ### The vanishing on a projective bundle -/

section Bundle

variable {S : Scheme.{u}} (E : S.Modules) [E.IsQuasicoherent]

/-- **The higher direct images of the twists on a projective bundle vanish outside the relative
dimension.** Let `E` be an `𝒪_S`-module which is finite locally free of constant rank `n + 1`,
let `π : 𝐏(E) = Proj_S(Sym(E)) ⟶ S` be the structure morphism of its projective bundle and let
`𝒪_{𝐏(E)}(d)` be the degree-`d` homogeneous piece of a family of twists on it. Then
`R^q π_* 𝒪_{𝐏(E)}(d)` is zero whenever `q < 0` or `q > n`.

Below degree zero this is the vanishing of any right derived functor in negative degrees. Above
degree `n` the affine opens over which `E` is free form a basis of `S`, over such an open the
section ring of `Sym(E)` is generated by `n + 1` degree-one elements, and
`Stacks.AlgebraicGeometry.ProjectiveBundleVanishing.isZero_rightDerivedPlus_pushforward_piece`
turns that into the vanishing. The vanishing in every degree `q ≠ 0, n` is
`Stacks.AlgebraicGeometry.ProjectiveBundleCohomology.isZero_higherDirectImage_twist`. -/
@[stacks 01XX "the vanishing clause in the degrees above the relative dimension and below \
zero", ega "III 2.1.15" "partial"]
public theorem isZero_rightDerivedPlus_pushforward_twist (n : ℕ)
    (hqc : Stacks.SymGraded.IsQuasicoherentPieces E)
    (hfree : Scheme.Modules.IsFiniteLocallyFreeOfRank E (n + 1))
    (D : TwistData (Stacks.SymGraded.schemeSheafGradedAlgebra E hqc)) (d : ℤ) (q : ℤ)
    (hq : q < 0 ∨ (n : ℤ) < q) :
    IsZero (((Scheme.Modules.pushforward
        (relativeProj (Stacks.SymGraded.schemeSheafGradedAlgebra E hqc)).toBase).rightDerivedPlus
      q).obj (D.algebra.piece d)) := by
  classical
  rcases hq with hq | hq
  · exact Stacks.RightDerivedPlus.isZero_rightDerivedPlus_obj _ q hq _
  · obtain ⟨p, rfl⟩ : ∃ p : ℕ, q = (p : ℤ) :=
      ⟨q.toNat, (Int.toNat_of_nonneg (by omega)).symm⟩
    refine isZero_rightDerivedPlus_pushforward_piece_of_span D d (n + 1)
      (isBasis_trivializing E hfree) (fun V hV => ?_) p (by omega)
    obtain ⟨w, hw⟩ := exists_span_sections E hV.2.some
    obtain ⟨y, hy⟩ := exists_span_sectionPieces_one E hqc hV.1 w hw
    refine ⟨hV.1,
      Stacks.SymGraded.isGeneratedInDegreeOne_schemeSheafGradedAlgebra E hqc V hV.1,
      fun i => y (ULift.up i), top_unique ?_⟩
    rw [← hy]
    refine Submodule.span_mono ?_
    rintro z ⟨i, rfl⟩
    exact ⟨i.down, rfl⟩

end Bundle

end Stacks.AlgebraicGeometry.ProjectiveBundleVanishing

