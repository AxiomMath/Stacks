module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Scheme

/-!
# The standard opens of `Proj` through the graded primes of a localization

Let `A = ⨁_{d ≥ 0} 𝒜 d` be a graded ring and `f ∈ 𝒜 m` homogeneous of positive degree `m`. The
localization `A_f` (`Localization.Away f`) carries a natural `ℤ`-grading: its homogeneous elements
are the fractions `a / fⁿ` with `a` homogeneous, and `a / fⁿ` with `a ∈ 𝒜 i` has degree
`i - n m`. Its degree-zero part is `A₍f₎` (`HomogeneousLocalization.Away 𝒜 f`). The ring maps
`A → A_f ← A₍f₎` induce maps

  `D₊(f) ← {ℤ-graded primes of A_f} → Spec A₍f₎`,

both by pulling a prime of `A_f` back, and this file shows that both are homeomorphisms.

## Main definitions

* `ProjectiveSpectrum.awayHomogeneous 𝒜 f m k`: the homogeneous elements of degree `k` of `A_f`
  for its `ℤ`-grading, `f ∈ 𝒜 m`.
* `ProjectiveSpectrum.awayGradedPrimes 𝒜 f m`: the `ℤ`-graded primes of `A_f`, those generated by
  their homogeneous elements, with the topology induced from `Spec A_f`.
* `ProjectiveSpectrum.awayGradedPrimesHomeomorph`: the homeomorphism
  `{ℤ-graded primes of A_f} ≃ₜ D₊(f)`, `𝔮 ↦ 𝔮 ∩ A`.
* `ProjectiveSpectrum.awayGradedPrimesHomeomorphSpec`: the homeomorphism
  `{ℤ-graded primes of A_f} ≃ₜ Spec A₍f₎`, `𝔮 ↦ 𝔮 ∩ A₍f₎`.

## Main results

* `ProjectiveSpectrum.exists_homeomorph_awayGradedPrimes`: both maps induced by
  `A → A_f ← A₍f₎` on the `ℤ`-graded primes of `A_f` are homeomorphisms.

## Implementation notes

The `ℤ`-grading of `A_f` enters only through its homogeneous elements: a `ℤ`-graded ideal is one
generated by homogeneous elements, which is how the source itself glosses the notion, so no
`GradedRing ℤ` structure on `Localization.Away f` is built. The degree bookkeeping `i - n m` is
recorded in `awayHomogeneous` although the notion of a graded ideal only uses the union over all
degrees.

The first homeomorphism is localization: pulling back along `A → A_f` identifies the primes of
`A_f` with the primes of `A` not containing `f`, and a prime of `A_f` is generated by homogeneous
elements exactly when its pullback is homogeneous; a homogeneous prime not containing `f` does not
contain `𝒜₊`, as `f ∈ 𝒜₊`. The second is the composite of the first with Mathlib's
`AlgebraicGeometry.projIsoSpecTopComponent`, the homeomorphism `D₊(f) ≅ Spec A₍f₎` sending `x` to
`A₍f₎ ∩ x A_f`; for `x = 𝔮 ∩ A` this is `A₍f₎ ∩ 𝔮`, the pullback of `𝔮` along `A₍f₎ → A_f`.

## References

* [Stacks: Lemma 00JP](https://stacks.math.columbia.edu/tag/00JP), assertion (6)
-/

@[expose] public section

noncomputable section

namespace ProjectiveSpectrum

open Localization

variable {A σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- The homogeneous elements of degree `k` of the localization `A_f` for its natural `ℤ`-grading,
where `f ∈ 𝒜 m`: the fractions `a / fⁿ` with `a ∈ 𝒜 i` and `i - n m = k`. -/
def awayHomogeneous (f : A) (m : ℕ) (k : ℤ) : Set (Away f) :=
  {x | ∃ (i n : ℕ) (a : A), a ∈ 𝒜 i ∧ (i : ℤ) - n * m = k ∧
    x = Localization.mk a ⟨f ^ n, (Submonoid.mem_powers_iff _ _).mpr ⟨n, rfl⟩⟩}

/-- The `ℤ`-graded prime ideals of the localization `A_f`, `f ∈ 𝒜 m`: those generated by their
homogeneous elements. As a subset of `Spec A_f` it carries the induced topology. -/
def awayGradedPrimes (f : A) (m : ℕ) : Set (PrimeSpectrum (Away f)) :=
  {q | Ideal.span ((q.asIdeal : Set (Away f)) ∩ ⋃ k, awayHomogeneous 𝒜 f m k) = q.asIdeal}

variable {𝒜}

/-- A homogeneous element `f` does not lie in the pullback of a prime of `A_f`. -/
theorem notMem_comap_away {f : A} (q : PrimeSpectrum (Away f)) :
    f ∉ q.asIdeal.comap (algebraMap A (Away f)) := fun h =>
  q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h (IsLocalization.Away.algebraMap_isUnit f))

/-- The pullback to `A` of a `ℤ`-graded prime of `A_f` is homogeneous. -/
theorem isHomogeneous_comap_of_mem_awayGradedPrimes {f : A} {m : ℕ} (f_deg : f ∈ 𝒜 m)
    {q : PrimeSpectrum (Away f)} (hq : q ∈ awayGradedPrimes 𝒜 f m) :
    (q.asIdeal.comap (algebraMap A (Away f))).IsHomogeneous 𝒜 := by
  set P := q.asIdeal.comap (algebraMap A (Away f)) with hP
  have hq' : q.asIdeal ≤ (P.homogeneousCore 𝒜).toIdeal.map (algebraMap A (Away f)) := by
    rw [← show _ = q.asIdeal from hq, Ideal.span_le]
    rintro _ ⟨hxq, hx⟩
    obtain ⟨k, i, n, a, ha, -, rfl⟩ := Set.mem_iUnion.mp hx
    have haq : algebraMap A (Away f) a ∈ q.asIdeal := by
      rw [← IsLocalization.mk'_spec (Away f) a ⟨f ^ n, (Submonoid.mem_powers_iff _ _).mpr ⟨n, rfl⟩⟩,
        ← Localization.mk_eq_mk']
      exact q.asIdeal.mul_mem_right _ hxq
    have haP : a ∈ (P.homogeneousCore 𝒜).toIdeal :=
      Ideal.mem_homogeneousCore_of_homogeneous_of_mem ⟨i, ha⟩ haq
    rw [SetLike.mem_coe, Localization.mk_eq_mk', IsLocalization.mk'_mem_map_algebraMap_iff]
    exact ⟨1, one_mem _, by simpa using haP⟩
  rw [Ideal.isHomogeneous_iff_forall_subset]
  intro i a ha
  have hmap := hq' ha
  rw [IsLocalization.algebraMap_mem_map_algebraMap_iff (Submonoid.powers f)] at hmap
  obtain ⟨_, ⟨N, rfl⟩, hN⟩ := hmap
  replace hN : f ^ N * a ∈ (P.homogeneousCore 𝒜).toIdeal := hN
  have hdeg : f ^ N ∈ 𝒜 (N • m) := SetLike.pow_mem_graded N f_deg
  have hcomp := ((P.homogeneousCore 𝒜).isHomogeneous.mem_iff 𝒜).mp hN (N • m + i)
  rw [DirectSum.coe_decompose_mul_add_of_left_mem 𝒜 hdeg] at hcomp
  have hPi : f ^ N * (DirectSum.decompose 𝒜 a i : A) ∈ P :=
    Ideal.toIdeal_homogeneousCore_le _ _ hcomp
  have : P.IsPrime := q.isPrime.comap _
  rw [Set.mem_preimage, SetLike.mem_coe, GradedRing.proj_apply]
  exact (this.mem_or_mem hPi).resolve_left fun h =>
    notMem_comap_away q (this.mem_of_pow_mem N h)

/-- The extension to `A_f` of a homogeneous prime of `A` not containing `f` is `ℤ`-graded. -/
theorem span_map_inter_awayHomogeneous (f : A) (m : ℕ) (x : ProjectiveSpectrum 𝒜) :
    Ideal.span ((x.asHomogeneousIdeal.toIdeal.map (algebraMap A (Away f)) : Set (Away f)) ∩
      ⋃ k, awayHomogeneous 𝒜 f m k) = x.asHomogeneousIdeal.toIdeal.map (algebraMap A (Away f)) := by
  refine le_antisymm (Ideal.span_le.mpr Set.inter_subset_left) ?_
  have hspan : x.asHomogeneousIdeal.toIdeal = Ideal.span ((↑) ''
      (((↑) : Subtype (SetLike.IsHomogeneousElem 𝒜) → A) ⁻¹' x.asHomogeneousIdeal.toIdeal)) :=
    (Ideal.IsHomogeneous.toIdeal_homogeneousCore_eq_self x.asHomogeneousIdeal.isHomogeneous).symm
  conv_lhs => rw [hspan]
  rw [Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, ⟨⟨a, i, ha⟩, haP, rfl⟩, rfl⟩
  refine Ideal.subset_span ⟨Ideal.mem_map_of_mem _ haP, Set.mem_iUnion.mpr ⟨i, i, 0, a, ha,
    by simp, ?_⟩⟩
  rw [← Localization.mk_one_eq_algebraMap]
  congr 1
  ext
  simp

/-- The prime of `A_f` generated by a point of `D₊(f)`. -/
theorem isPrime_map_of_mem_basicOpen {f : A} (x : basicOpen 𝒜 f) :
    (x.1.asHomogeneousIdeal.toIdeal.map (algebraMap A (Away f))).IsPrime :=
  IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f) _ _ x.1.isPrime
    ((Ideal.disjoint_powers_iff_notMem_of_isPrime _).mpr x.2)

variable (𝒜) in
/-- The homeomorphism `{ℤ-graded primes of A_f} ≃ₜ D₊(f)`, for `f` homogeneous of positive
degree, induced by `A → A_f`: a `ℤ`-graded prime `𝔮` of `A_f` goes to `𝔮 ∩ A`. -/
def awayGradedPrimesHomeomorph {f : A} {m : ℕ} (f_deg : f ∈ 𝒜 m) (hm : 0 < m) :
    awayGradedPrimes 𝒜 f m ≃ₜ basicOpen 𝒜 f where
  toFun q := ⟨⟨⟨q.1.asIdeal.comap (algebraMap A (Away f)),
      isHomogeneous_comap_of_mem_awayGradedPrimes f_deg q.2⟩, q.1.isPrime.comap _,
      fun h => notMem_comap_away q.1 (h (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 hm f_deg))⟩,
    notMem_comap_away q.1⟩
  invFun x := ⟨⟨x.1.asHomogeneousIdeal.toIdeal.map (algebraMap A (Away f)),
    isPrime_map_of_mem_basicOpen x⟩, span_map_inter_awayHomogeneous f m x.1⟩
  left_inv q := Subtype.ext <| PrimeSpectrum.ext <|
    IsLocalization.map_under (Submonoid.powers f) (Away f) q.1.asIdeal
  right_inv x := Subtype.ext <| ProjectiveSpectrum.ext <| HomogeneousIdeal.ext <|
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) (Away f) x.1.isPrime
      ((Ideal.disjoint_powers_iff_notMem_of_isPrime _).mpr x.2)
  continuous_toFun := by
    refine Continuous.subtype_mk ?_ _
    rw [(isTopologicalBasis_basic_opens 𝒜).continuous_iff]
    rintro _ ⟨a, rfl⟩
    exact (PrimeSpectrum.basicOpen (algebraMap A (Away f) a)).isOpen.preimage
      continuous_subtype_val
  continuous_invFun := by
    refine Continuous.subtype_mk ?_ _
    rw [PrimeSpectrum.isTopologicalBasis_basic_opens.continuous_iff]
    rintro _ ⟨z, rfl⟩
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers f) z
    convert (isOpen_basicOpen 𝒜 (a := a)).preimage continuous_subtype_val using 1
    ext x
    simp only [Set.mem_preimage, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, mem_basicOpen]
    rw [IsLocalization.mk'_mem_map_algebraMap_iff]
    refine not_congr ⟨?_, fun h => ⟨1, one_mem _, by simpa using h⟩⟩
    rintro ⟨_, ⟨n, rfl⟩, hn⟩
    exact (x.1.isPrime.mem_or_mem hn).resolve_left fun h => x.2 (x.1.isPrime.mem_of_pow_mem n h)

variable (𝒜) in
/-- The homeomorphism `{ℤ-graded primes of A_f} ≃ₜ Spec A₍f₎`, for `f` homogeneous of positive
degree, induced by `A₍f₎ → A_f`: a `ℤ`-graded prime `𝔮` of `A_f` goes to `𝔮 ∩ A₍f₎`
(`awayGradedPrimesHomeomorphSpec_apply_asIdeal`). -/
def awayGradedPrimesHomeomorphSpec {f : A} {m : ℕ} (f_deg : f ∈ 𝒜 m) (hm : 0 < m) :
    awayGradedPrimes 𝒜 f m ≃ₜ PrimeSpectrum (HomogeneousLocalization.Away 𝒜 f) :=
  (awayGradedPrimesHomeomorph 𝒜 f_deg hm).trans
    (TopCat.homeoOfIso (AlgebraicGeometry.projIsoSpecTopComponent f_deg hm))

theorem awayGradedPrimesHomeomorph_apply_asIdeal {f : A} {m : ℕ} (f_deg : f ∈ 𝒜 m) (hm : 0 < m)
    (q : awayGradedPrimes 𝒜 f m) :
    (awayGradedPrimesHomeomorph 𝒜 f_deg hm q).1.asHomogeneousIdeal.toIdeal =
      q.1.asIdeal.comap (algebraMap A (Away f)) :=
  rfl

theorem awayGradedPrimesHomeomorphSpec_apply_asIdeal {f : A} {m : ℕ} (f_deg : f ∈ 𝒜 m)
    (hm : 0 < m) (q : awayGradedPrimes 𝒜 f m) :
    (awayGradedPrimesHomeomorphSpec 𝒜 f_deg hm q).asIdeal =
      q.1.asIdeal.comap (algebraMap (HomogeneousLocalization.Away 𝒜 f) (Away f)) := by
  change Ideal.comap _ (Ideal.map (algebraMap A (Away f))
    (q.1.asIdeal.comap (algebraMap A (Away f)))) = _
  rw [IsLocalization.map_under (Submonoid.powers f) (Away f) q.1.asIdeal]

/-- For `f` homogeneous of positive degree, the ring maps `A → A_f ← A₍f₎` induce homeomorphisms
`D₊(f) ← {ℤ-graded primes of A_f} → Spec A₍f₎`, each sending a prime to its pullback. -/
@[stacks 00JP "Assertion (6): for `f` homogeneous of positive degree, `S → S_f ← S_(f)` induce \
  homeomorphisms `D₊(f) ← {ℤ-graded primes of S_f} → Spec(S_(f))`; the second is the first \
  composed with Mathlib's `AlgebraicGeometry.projIsoSpecTopComponent`."]
theorem exists_homeomorph_awayGradedPrimes {f : A} {m : ℕ} (f_deg : f ∈ 𝒜 m) (hm : 0 < m) :
    ∃ (e₁ : awayGradedPrimes 𝒜 f m ≃ₜ basicOpen 𝒜 f)
      (e₂ : awayGradedPrimes 𝒜 f m ≃ₜ PrimeSpectrum (HomogeneousLocalization.Away 𝒜 f)),
      (∀ q, (e₁ q).1.asHomogeneousIdeal.toIdeal = q.1.asIdeal.comap (algebraMap A (Away f))) ∧
      ∀ q, (e₂ q).asIdeal =
        q.1.asIdeal.comap (algebraMap (HomogeneousLocalization.Away 𝒜 f) (Away f)) :=
  ⟨awayGradedPrimesHomeomorph 𝒜 f_deg hm, awayGradedPrimesHomeomorphSpec 𝒜 f_deg hm,
    awayGradedPrimesHomeomorph_apply_asIdeal f_deg hm,
    awayGradedPrimesHomeomorphSpec_apply_asIdeal f_deg hm⟩

end ProjectiveSpectrum
