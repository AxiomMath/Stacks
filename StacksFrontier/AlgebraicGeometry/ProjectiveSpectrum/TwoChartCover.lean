module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Graded quotients of `R[T₀, T₁]` and their two standard charts

`AlgebraicGeometry.Proj.basicOpen_sup_basicOpen_eq_top` and
`AlgebraicGeometry.Proj.exists_sections_eq_add` cover `Proj A` by the two charts `D₊(f)` and
`D₊(g)` and write every function on `D₊(fg)` as a sum of functions on the two charts, for a graded
ring `A` and elements `f, g` of degree one such that every homogeneous element of positive degree
lies in the ideal `(f, g)`. This file checks that hypothesis for a graded ring which is a graded
quotient of the polynomial ring `R[T₀, T₁]` with its grading by total degree, `f, g` being the
images of `T₀, T₁`.

## Main results

* `AlgebraicGeometry.Proj.mem_span_pair_of_mem_map_homogeneousSubmodule`: a homogeneous element
  of positive degree of a graded quotient of `R[T₀, T₁]` lies in the ideal generated by the images
  of `T₀` and `T₁`.

## References

* [Stacks Project, Tag 0EVJ](https://stacks.math.columbia.edu/tag/0EVJ)
-/

@[expose] public noncomputable section

universe u

namespace AlgebraicGeometry.Proj

variable {R : Type u} [CommRing R] {A : Type u} [CommRing A] {σ : Type*} [SetLike σ A]
  [AddSubgroupClass σ A] (𝒜 : ℕ → σ)

/-- **Graded quotients of `R[T₀, T₁]` are generated in degree one by the two variables.** If every
homogeneous element of degree `n` of `A` is the image of a homogeneous polynomial of degree `n`
under a ring map `φ : R[T₀, T₁] → A`, then every homogeneous element of positive degree lies in
the ideal generated by `φ(T₀)` and `φ(T₁)`. -/
theorem mem_span_pair_of_mem_map_homogeneousSubmodule (φ : MvPolynomial (Fin 2) R →+* A)
    (hφ : ∀ (n : ℕ) (a : A), a ∈ 𝒜 n →
      ∃ y ∈ MvPolynomial.homogeneousSubmodule (Fin 2) R n, φ y = a)
    (n : ℕ) (hn : 0 < n) (a : A) (ha : a ∈ 𝒜 n) :
    a ∈ Ideal.span {φ (MvPolynomial.X 0), φ (MvPolynomial.X 1)} := by
  obtain ⟨y, hy, rfl⟩ := hφ n a ha
  rw [MvPolynomial.mem_homogeneousSubmodule] at hy
  have hX : y ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin 2))) := by
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    by_contra! h
    have he0 : e = 0 := Finsupp.ext fun i ↦ h i (Set.mem_univ i)
    have hdeg := hy (MvPolynomial.mem_support_iff.mp he)
    rw [he0, map_zero] at hdeg
    lia
  have hrange : Set.range (⇑φ ∘ MvPolynomial.X) =
      {φ (MvPolynomial.X 0), φ (MvPolynomial.X 1)} := by
    ext x
    simp [Fin.exists_fin_two, eq_comm]
  have hmap := Ideal.mem_map_of_mem φ hX
  rwa [Ideal.map_span, ← Set.image_comp, Set.image_univ, hrange] at hmap

end AlgebraicGeometry.Proj
