module

public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import StacksFrontier.AlgebraicGeometry.ProjectiveSpectrum.Topology

/-!
# A graded ring whose `Proj` is not quasi-compact

Let `S = ℤ[X₀, X₁, X₂, …]` (`MvPolynomial ℕ ℤ`), graded by total degree, so that every variable
has degree `1`. Its homogeneous spectrum `Proj S` is covered by the standard opens `D₊(Xᵢ)`, since
the variables generate the irrelevant ideal `S₊`, but no finitely many of them cover it: if
`D₊(X_i)`, `i ∈ t`, covered `Proj S` for a finite set `t`, then `V₊((X_i)_{i ∈ t}) = ∅`, so
`S₊ ⊆ √(X_i)_{i ∈ t}` by the emptiness criterion of `Proj` (Stacks 00JP (10)), and some power of a
variable `X_N` with `N ∉ t` would lie in the ideal generated by the `X_i`, `i ∈ t`, which it does
not, as its only monomial involves no `X_i`. Hence `Proj S` is not quasi-compact.

## Main results

* `ProjectiveSpectrum.not_compactSpace_mvPolynomial`: `Proj ℤ[X₀, X₁, …]` is not quasi-compact.
* `ProjectiveSpectrum.exists_not_compactSpace`: there is a graded ring whose `Proj` is not
  quasi-compact.

## Implementation notes

The grading of `MvPolynomial ℕ ℤ` by total degree is Mathlib's `MvPolynomial.gradedAlgebra`, on the
family `MvPolynomial.homogeneousSubmodule ℕ ℤ`; it is a local instance here, as in Mathlib.
Quasi-compactness of a topological space is `CompactSpace`.

## References

* [Stacks: Lemma 00JP](https://stacks.math.columbia.edu/tag/00JP), assertion (7)
-/

@[expose] public section

namespace ProjectiveSpectrum

open MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The irrelevant ideal of `ℤ[X₀, X₁, …]`, graded by total degree, is contained in the ideal
generated by the variables. -/
theorem irrelevant_le_span_range_X :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule ℕ ℤ)).toIdeal ≤
      Ideal.span (Set.range (X : ℕ → MvPolynomial ℕ ℤ)) := by
  intro a ha
  have h0 : homogeneousComponent 0 a = 0 := by
    rw [← decomposition.decompose'_apply]
    exact (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
  rw [homogeneousComponent_zero, C_eq_zero] at h0
  rw [← Set.image_univ, mem_ideal_span_X_image]
  intro m hm
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact (mem_support_iff.mp hm) h0
  obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
  exact ⟨i, Set.mem_univ i, by simpa using hi⟩

/-- The standard opens `D₊(Xᵢ)` cover `Proj ℤ[X₀, X₁, …]`. -/
theorem iUnion_basicOpen_X :
    ⋃ i, (basicOpen (homogeneousSubmodule ℕ ℤ) (X i : MvPolynomial ℕ ℤ) :
      Set (ProjectiveSpectrum (homogeneousSubmodule ℕ ℤ))) = Set.univ := by
  refine Set.eq_univ_of_forall fun x => ?_
  by_contra h
  simp only [Set.mem_iUnion, SetLike.mem_coe, mem_basicOpen, not_exists, not_not] at h
  exact x.not_irrelevant_le (irrelevant_le_span_range_X.trans
    (Ideal.span_le.mpr (Set.range_subset_iff.mpr h)))

/-- `Proj ℤ[X₀, X₁, …]`, graded by total degree, is not quasi-compact. -/
theorem not_compactSpace_mvPolynomial :
    ¬ CompactSpace (ProjectiveSpectrum (homogeneousSubmodule ℕ ℤ)) := by
  intro hc
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
    (fun i => (basicOpen (homogeneousSubmodule ℕ ℤ) (X i : MvPolynomial ℕ ℤ) :
      Set (ProjectiveSpectrum (homogeneousSubmodule ℕ ℤ))))
    (fun _ => isOpen_basicOpen _) iUnion_basicOpen_X.ge
  set N := t.sup id + 1 with hN
  have hNt : N ∉ t := fun h => by
    have := Finset.le_sup (f := id) h
    simp only [id_eq] at this
    omega
  let I : HomogeneousIdeal (homogeneousSubmodule ℕ ℤ) :=
    ⟨Ideal.span (X '' (t : Set ℕ)), Ideal.homogeneous_span _ _ (by
      rintro _ ⟨i, -, rfl⟩
      exact ⟨1, (mem_homogeneousSubmodule 1 _).mpr (isHomogeneous_X ℤ i)⟩)⟩
  have hI : zeroLocus (homogeneousSubmodule ℕ ℤ) (I : Set (MvPolynomial ℕ ℤ)) = ∅ := by
    refine Set.eq_empty_iff_forall_notMem.mpr fun x hx => ?_
    obtain ⟨i, hi, hxi⟩ : ∃ i ∈ t, X i ∉ x.asHomogeneousIdeal := by
      simpa using ht (Set.mem_univ x)
    exact hxi (hx (Ideal.subset_span ⟨i, hi, rfl⟩))
  have hXN : (X N : MvPolynomial ℕ ℤ) ∈ I.radical :=
    (zeroLocus_empty_iff_irrelevant_le_radical _ I).mp hI
      (HomogeneousIdeal.mem_irrelevant_of_mem _ one_pos
        ((mem_homogeneousSubmodule 1 _).mpr (isHomogeneous_X ℤ N)))
  obtain ⟨k, hk⟩ := (Ideal.mem_radical_iff (I := I.toIdeal)).mp hXN
  have hk' : (X N ^ k : MvPolynomial ℕ ℤ) ∈ Ideal.span (X '' (t : Set ℕ)) := hk
  rw [mem_ideal_span_X_image] at hk'
  obtain ⟨i, hi, hik⟩ := hk' (Finsupp.single N k) (by simp [X_pow_eq_monomial, support_monomial])
  rw [Finsupp.single_apply] at hik
  split_ifs at hik with hNi
  · exact hNt (hNi ▸ hi)
  · exact hik rfl

/-- **Stacks 00JP (7).** There is a graded ring `S` whose homogeneous spectrum `Proj S` is not
quasi-compact, namely `ℤ[X₀, X₁, …]` graded by total degree. -/
@[stacks 00JP "Assertion (7): there is a graded ring `S` with `Proj(S)` not quasi-compact, \
  namely `S = ℤ[X₁, X₂, …]` (`not_compactSpace_mvPolynomial`)."]
theorem exists_not_compactSpace :
    ∃ (S : Type) (_ : CommRing S) (𝒜 : ℕ → Submodule ℤ S) (_ : GradedRing 𝒜),
      ¬ CompactSpace (ProjectiveSpectrum 𝒜) :=
  ⟨MvPolynomial ℕ ℤ, inferInstance, homogeneousSubmodule ℕ ℤ, MvPolynomial.gradedAlgebra,
    not_compactSpace_mvPolynomial⟩

end ProjectiveSpectrum
