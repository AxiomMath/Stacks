module

public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Proper
public import Mathlib.RingTheory.GradedAlgebra.FiniteType
public import Mathlib.RingTheory.GradedAlgebra.Noetherian
public import StacksCore.Tactic.StacksAttribute

/-!
# `Proj` of a Noetherian graded ring is a Noetherian scheme

Let `A` be an `ℕ`-graded commutative ring which is Noetherian as a ring. This file proves that
the scheme `Proj 𝒜` is Noetherian, i.e. locally Noetherian and quasi-compact.

## Main results

* `Stacks.AlgebraicGeometry.Proj.finiteType_of_isNoetherianRing`: a Noetherian `ℕ`-graded ring is
  a finitely generated algebra over its degree-zero part.
* `Stacks.AlgebraicGeometry.Proj.isNoetherian_proj` is Tag 0B5Q: `Proj 𝒜` is a Noetherian scheme
  whenever the graded ring `A` is Noetherian.

## Implementation notes

Mathlib already provides everything about `Proj` that is needed once the graded ring is known to
be of finite type over its degree-zero part: `HomogeneousLocalization.Away.finiteType` makes the
standard affine charts finitely generated algebras, and
`AlgebraicGeometry.Proj.toSpecZero` is then both locally of finite type and quasi-compact. Since
`𝒜 0` is a quotient of `A` it is Noetherian, so `Spec (𝒜 0)` is a Noetherian scheme and both
halves of `IsNoetherian (Proj 𝒜)` transfer along the structure morphism.

What is missing from Mathlib is the classical fact that a Noetherian graded ring is generated, as
an algebra over its degree-zero part, by finitely many homogeneous elements of positive degree.
This is `finiteType_of_isNoetherianRing`: the irrelevant ideal is finitely generated, hence
generated by the (finitely many) homogeneous components of a finite generating set, and a
strong induction on the degree shows that the subalgebra generated by those components is
everything. `proj_mul_mem_of_forall_lt` isolates the degree bookkeeping of that induction step.

## References

* [Stacks Project, Tag 0B5Q](https://stacks.math.columbia.edu/tag/0B5Q)
-/

@[expose] public section

open AlgebraicGeometry

namespace Stacks.AlgebraicGeometry.Proj

universe u v

section FiniteType

variable {A : Type u} {σ : Type v} [CommRing A]
variable [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- Degree bookkeeping for the induction in `finiteType_of_isNoetherianRing`.

If `g` is homogeneous of positive degree `d` and lies in a subalgebra `B` which already contains
every homogeneous element of degree `< n`, then the degree-`n` component of any multiple `c * g`
lies in `B`: indeed the degree-`n` component of `c * g` is `cₙ₋d * g`, and `n - d < n`. -/
public lemma proj_mul_mem_of_forall_lt {B : Subalgebra (𝒜 0) A} {n d : ℕ} (hd : 0 < d)
    {g : A} (hg : g ∈ 𝒜 d) (hgB : g ∈ B) (hB : ∀ m < n, ∀ x ∈ 𝒜 m, x ∈ B) (c : A) :
    GradedRing.proj 𝒜 n (c * g) ∈ B := by
  classical
  rw [← DirectSum.sum_support_decompose 𝒜 c, Finset.sum_mul, map_sum]
  refine Subalgebra.sum_mem _ fun k _ => ?_
  have hkg : ((DirectSum.decompose 𝒜 c k : A) * g) ∈ 𝒜 (k + d) :=
    SetLike.mul_mem_graded (DirectSum.decompose 𝒜 c k).2 hg
  rw [GradedRing.proj_apply]
  by_cases hn : k + d = n
  · rw [hn] at hkg
    rw [DirectSum.decompose_of_mem_same 𝒜 hkg]
    exact B.mul_mem (hB k (by omega) _ (DirectSum.decompose 𝒜 c k).2) hgB
  · rw [DirectSum.decompose_of_mem_ne 𝒜 hkg hn]
    exact B.zero_mem

/-- A Noetherian `ℕ`-graded ring is a finitely generated algebra over its degree-zero part.

The irrelevant ideal `𝒜₊` is finitely generated because `A` is Noetherian; replacing a finite
generating set by the homogeneous components of its elements gives a finite generating set `s`
consisting of homogeneous elements of positive degree. A strong induction on the degree shows
that every homogeneous element of `A` lies in `Algebra.adjoin (𝒜 0) s`, and hence so does every
element of `A`. -/
@[ega "II 2.1.4" "special case"]
public theorem finiteType_of_isNoetherianRing [IsNoetherianRing A] :
    Algebra.FiniteType (𝒜 0) A := by
  classical
  obtain ⟨t, ht⟩ :=
    IsNoetherian.noetherian (R := A) (M := A) (HomogeneousIdeal.irrelevant 𝒜).toIdeal
  have htmem : ∀ x ∈ t, GradedRing.proj 𝒜 0 x = 0 := by
    intro x hx
    rw [← HomogeneousIdeal.mem_irrelevant_iff, ← HomogeneousIdeal.mem_iff, ← ht]
    exact Submodule.subset_span hx
  -- the finite set of homogeneous components of the generators of the irrelevant ideal
  let idx := Σ x : t, (DirectSum.decompose 𝒜 (x : A)).support
  let gen : idx → A := fun i => (DirectSum.decompose 𝒜 (i.1 : A) (i.2 : ℕ) : A)
  let s : Finset A := Finset.univ.image gen
  have hgen_mem : ∀ i : idx, gen i ∈ 𝒜 (i.2 : ℕ) := fun i =>
    (DirectSum.decompose 𝒜 (i.1 : A) (i.2 : ℕ)).2
  have hgen_pos : ∀ i : idx, 0 < (i.2 : ℕ) := fun i => Nat.pos_of_ne_zero fun h =>
    (GradedRing.mem_support_iff 𝒜 _ _).mp (h ▸ i.2.2) (htmem _ i.1.2)
  have hspan : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (s : Set A) := by
    rw [← ht, Submodule.span_le]
    intro x hx
    simp only [SetLike.mem_coe]
    rw [← DirectSum.sum_support_decompose 𝒜 x]
    exact Ideal.sum_mem _ fun k hk =>
      Ideal.subset_span (Finset.mem_image_of_mem gen (Finset.mem_univ ⟨⟨x, hx⟩, ⟨k, hk⟩⟩))
  -- every homogeneous element lies in the subalgebra generated by `s`
  have key : ∀ n : ℕ, ∀ x ∈ 𝒜 n, x ∈ Algebra.adjoin (𝒜 0) (s : Set A) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
      intro x hx
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · exact Subalgebra.algebraMap_mem _ (⟨x, hx⟩ : 𝒜 0)
      · obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.mp
          (hspan (HomogeneousIdeal.mem_iff.mpr (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 hn hx)))
        rw [← DirectSum.decompose_of_mem_same 𝒜 hx, ← GradedRing.proj_apply, ← hc, map_sum]
        refine Subalgebra.sum_mem _ fun a ha => ?_
        obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp ha
        rw [smul_eq_mul]
        exact proj_mul_mem_of_forall_lt 𝒜 (hgen_pos i) (hgen_mem i)
          (Algebra.subset_adjoin ha) IH _
  refine ⟨Subalgebra.fg_def.mpr ⟨(s : Set A), s.finite_toSet, ?_⟩⟩
  refine eq_top_iff.mpr fun a _ => ?_
  rw [← DirectSum.sum_support_decompose 𝒜 a]
  exact Subalgebra.sum_mem _ fun k _ => key k _ (DirectSum.decompose 𝒜 a k).2

end FiniteType

/-- **Stacks Project, Tag 0B5Q.** The projective spectrum of a Noetherian graded ring is a
Noetherian scheme. -/
@[stacks 0B5Q "proj_noetherian", ega "II 2.7.1" "(i)"]
public instance isNoetherian_proj
    {A : Type u} {σ : Type v} [CommRing A] [IsNoetherianRing A]
    [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] :
    IsNoetherian (Proj 𝒜) := by
  have : Algebra.FiniteType (𝒜 0) A := finiteType_of_isNoetherianRing 𝒜
  have : IsNoetherianRing (𝒜 0) := GradedRing.GradeZero.isNoetherianRing 𝒜
  have : IsLocallyNoetherian (Proj 𝒜) :=
    LocallyOfFiniteType.isLocallyNoetherian (AlgebraicGeometry.Proj.toSpecZero 𝒜)
  have : CompactSpace (Proj 𝒜) :=
    QuasiCompact.compactSpace_of_compactSpace (AlgebraicGeometry.Proj.toSpecZero 𝒜)
  constructor

end Stacks.AlgebraicGeometry.Proj
