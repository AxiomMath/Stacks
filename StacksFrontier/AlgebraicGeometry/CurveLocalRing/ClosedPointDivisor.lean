module

public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierStalk.StalkwiseRegular
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierStalk.VanishingIdealStalk
public import StacksFrontier.AlgebraicGeometry.Variety.Curve.SmoothStalk

/-!
# A closed point of a smooth curve is an effective Cartier divisor

Let `k` be a field and let `X` be a curve over `k` which is smooth over `k`. A closed point `x` of
`X`, taken as a reduced closed subscheme, is cut out by
`AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal` of `TopologicalSpace.Closeds.closure {x}`,
and this file shows that closed subscheme is an effective Cartier divisor.

Two inputs meet here. The local ring `𝒪_{X,x}` is a discrete valuation ring, which is
`AlgebraicGeometry.IsCurve.isDiscreteValuationRing_stalk_of_isClosed`, so its maximal ideal is
generated by a uniformizer; a uniformizer is irreducible, hence nonzero, hence a nonzerodivisor
because the local ring of a curve is a domain. And the ideal the subscheme induces in `𝒪_{X,x}` is
exactly that maximal ideal, which is
`Stacks.Divisors.stalk_vanishingIdeal_closure_singleton`. The support of the subscheme is the
single point `x`, so this one computation discharges the hypothesis of [Stacks, Tag 0AG8] in the
form `Stacks.Divisors.isEffectiveCartierDivisor_of_stalk_isPrincipal_nonZeroDivisor`, a locally
Noetherian scheme being supplied by the finite type hypothesis on a curve.

## Main results

* `Stacks.Divisors.exists_nonZeroDivisor_span_eq_maximalIdeal`: the maximal ideal of a discrete
  valuation ring is generated by a single nonzerodivisor.
* `AlgebraicGeometry.IsCurve.exists_nonZeroDivisor_stalk_vanishingIdeal_closure_singleton`: the
  stalkwise hypothesis of [Stacks, Tag 0AG8] for a closed point of a smooth curve.
* `AlgebraicGeometry.IsCurve.isEffectiveCartierDivisor_vanishingIdeal_closure_singleton`: a closed
  point of a smooth curve is an effective Cartier divisor.
* `AlgebraicGeometry.IsCurve.exists_affineOpen_ideal_eq_span_of_isClosed`: the local equation at a
  closed point of a smooth curve.

## References

* [Stacks Project, Tag 0AG8](https://stacks.math.columbia.edu/tag/0AG8)
* [Stacks Project, Tag 0B8Y](https://stacks.math.columbia.edu/tag/0B8Y)
-/

@[expose] public section

open CategoryTheory TopologicalSpace

universe u

namespace Stacks.Divisors

/-- **The maximal ideal of a discrete valuation ring is generated by a nonzerodivisor.** A
uniformizer generates it and is nonzero, and a discrete valuation ring is a domain. -/
theorem exists_nonZeroDivisor_span_eq_maximalIdeal (R : Type*) [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] :
    ∃ g ∈ nonZeroDivisors R, IsLocalRing.maximalIdeal R = Ideal.span {g} := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  exact ⟨ϖ, mem_nonZeroDivisors_of_ne_zero hϖ.ne_zero,
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ⟩

end Stacks.Divisors

namespace AlgebraicGeometry

namespace IsCurve

/-- **The stalkwise hypothesis of [Stacks, Tag 0AG8] holds for a closed point of a smooth
curve.** At every point of the support of the reduced closed subscheme `closure {x}` — that is, at
`x` itself — the ideal it induces in the local ring is generated by a single nonzerodivisor,
namely a uniformizer of the discrete valuation ring `𝒪_{X,x}`. -/
theorem exists_nonZeroDivisor_stalk_vanishingIdeal_closure_singleton (k : Type u) [Field k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsCurve k f] [Smooth f] {x : X}
    (hx : IsClosed ({x} : Set X)) (y : X)
    (hy : y ∈ (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({x} : Set X))).support) :
    ∃ g ∈ nonZeroDivisors (X.presheaf.stalk y),
      IdealSheafData.stalk
          (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({x} : Set X))) y =
        Ideal.span {g} := by
  have hyx : y = x := by
    have hmem : y ∈ ((Scheme.IdealSheafData.vanishingIdeal
      (Closeds.closure ({x} : Set X))).support : Set X) := hy
    rw [Scheme.IdealSheafData.coe_support_vanishingIdeal] at hmem
    simpa [hx.closure_eq] using hmem
  subst hyx
  have : IsDiscreteValuationRing (X.presheaf.stalk y) :=
    IsCurve.isDiscreteValuationRing_stalk_of_isClosed k f hx
  obtain ⟨g, hg, hspan⟩ :=
    Stacks.Divisors.exists_nonZeroDivisor_span_eq_maximalIdeal (X.presheaf.stalk y)
  exact ⟨g, hg, (Stacks.Divisors.stalk_vanishingIdeal_closure_singleton y).trans hspan⟩

/-- **A closed point of a smooth curve is an effective Cartier divisor.** The reduced closed
subscheme supported on a closed point `x` of a curve smooth over a field is an effective Cartier
divisor, the local equation at `x` being a uniformizer of the discrete valuation ring
`𝒪_{X,x}`. -/
theorem isEffectiveCartierDivisor_vanishingIdeal_closure_singleton (k : Type u) [Field k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsCurve k f] [Smooth f] {x : X}
    (hx : IsClosed ({x} : Set X)) :
    Stacks.Divisors.IsEffectiveCartierDivisor
      (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({x} : Set X))) := by
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  exact Stacks.Divisors.isEffectiveCartierDivisor_of_stalk_isPrincipal_nonZeroDivisor _
    (exists_nonZeroDivisor_stalk_vanishingIdeal_closure_singleton k f hx)

/-- **A closed point of a smooth curve has a local equation.** Around a closed point `x` of a
curve smooth over a field there is an affine open on which the reduced closed subscheme `{x}` is
cut out by a single nonzerodivisor. This is
`AlgebraicGeometry.IsCurve.isEffectiveCartierDivisor_vanishingIdeal_closure_singleton` read
through the forward half of the affine-local criterion,
`Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor`. -/
theorem exists_affineOpen_ideal_eq_span_of_isClosed (k : Type u) [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsCurve k f] [Smooth f] {x : X} (hx : IsClosed ({x} : Set X)) :
    ∃ (U : X.Opens) (hU : IsAffineOpen U), x ∈ U ∧
      ∃ a : Γ(X, U), _root_.IsRegular a ∧
        (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({x} : Set X))).ideal ⟨U, hU⟩ =
          Ideal.span {a} :=
  Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor _
    (isEffectiveCartierDivisor_vanishingIdeal_closure_singleton k f hx) x

end IsCurve

end AlgebraicGeometry

end
