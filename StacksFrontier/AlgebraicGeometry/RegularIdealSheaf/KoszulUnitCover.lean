module

public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Independence
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Regular
public import StacksFrontier.RingTheory.Koszul.Regular

/-!
# The unit sequence, and a Koszul cover of the whole space

Stacks tag 063D states its four regularity conditions for an ideal sheaf `J ⊆ O_X` only at the
points of `Supp(O_X/J)`; away from that support nothing is asked of `J`, and nothing has to be.
There `J` is already the whole structure sheaf: by `notMem_idealQuotientSupport_iff` a point
outside the support has an open neighbourhood `U` with `1 ∈ J(U)`, and the one-term sequence
`(1)` then generates `J` over `U` and has a Koszul complex acyclic in positive degrees.

This file records that observation and draws from it the conclusion a local-to-global argument
needs: for a Koszul-regular ideal sheaf the opens carrying a Koszul presentation cover all of
`X`, not merely the support of the quotient.

## Main results

* `isKoszulRegular_unitSequence`: the one-term sequence `(1)` in a commutative ring is
  Koszul-regular.
* `isKoszulSequenceExactOn_unitSequence`: the one-term sequence of unit sections over an open
  `U ⊆ X` has a Koszul complex acyclic in positive degrees.
* `isGeneratedByOn_unitSequence`: an ideal sheaf containing the unit section over `U` is
  generated over `U` by the one-term sequence `(1)`.
* `exists_koszulPresentation_of_notMem_idealQuotientSupport`: a point outside the support of
  `O_X/J` has a neighbourhood over which `J` is generated by a sequence whose Koszul complex is
  acyclic in positive degrees — for any ideal sheaf `J` whatsoever.
* `exists_koszulPresentation_of_isKoszulRegularIdealSheaf`: when `J` is Koszul-regular, *every*
  point of `X` has such a neighbourhood.
* `coversTop_koszulPresentationOpen` and `coversTop_koszulCover_of_isKoszulRegularIdealSheaf`:
  the opens carrying such a presentation cover `X` for the topology of its opens, stated once
  with the index type named and once as an existential over index types.

## Implementation notes

Koszul-regularity of `(1)` is proved at the level of rings and carried to sections germwise
through `isKoszulSequenceExactOn_iff_forall_germ_isKoszulRegular`, which is the form
`IsKoszulSequenceExactOn` is stated in; the germ of the unit section is the unit germ because
the germ map is a homomorphism of rings.  At the ring level the argument is the shortest
instance of Stacks tag 062F: multiplication by a unit is injective, so the one-term sequence
`(1)` is weakly regular, and a weakly regular sequence is Koszul-regular.

The cover is indexed by `KoszulPresentationOpen X J`, the subtype of opens that carry a
presentation, rather than by the points of `X`.  Nothing then has to be chosen and the index
type lands in `Type u` by construction, `Opens X` being a `Type u`; the existential form of the
covering statement simply exhibits that subtype as a witness.

A cover of all of `X`, rather than of `Supp(O_X/J)`, is what a local-to-global argument over the
opens of `X` consumes.  Only the cover is produced here; no gluing is done.

## References

* [Stacks Project, Definition 31.21.2 (Tag 063D)](https://stacks.math.columbia.edu/tag/063D)
* [Stacks Project, Lemma 15.30.1 (Tag 062F)](https://stacks.math.columbia.edu/tag/062F)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.RingedSpace

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

/-! ### The one-term unit sequence -/

section Ring

/-- **The one-term sequence `(1)` is Koszul-regular.** Multiplication by `1` on `R` is injective,
so the sequence is weakly regular, and Stacks tag 062F turns that into Koszul-regularity. -/
theorem isKoszulRegular_unitSequence (R : Type*) [CommRing R] :
    Koszul.IsKoszulRegular (fun _ : Fin 1 => (1 : R)) := by
  have hweak : RingTheory.Sequence.IsWeaklyRegular R
      (List.ofFn (fun _ : Fin 1 => (1 : R))) := by
    rw [show List.ofFn (fun _ : Fin 1 => (1 : R)) = [1] by simp]
    exact (RingTheory.Sequence.isWeaklyRegular_singleton_iff R (1 : R)).mpr
      (isUnit_one.isSMulRegular R)
  exact (Koszul.isKoszulRegularOn_self_iff _).mp
    (Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular.1 hweak)

end Ring

section Sections

variable {X : RingedSpace.{u}}

/-- The germs of the one-term sequence of unit sections are the one-term sequence of unit germs:
taking germs is a homomorphism of rings. -/
theorem germFamily_unitSequence (X : RingedSpace.{u}) (U : Opens X) (y : X) (hy : y ∈ U) :
    germFamily X U (fun _ : Fin 1 => (1 : X.presheaf.obj (op U))) y hy =
      fun _ : Fin 1 => (1 : X.presheaf.stalk y) := by
  funext i
  exact map_one _

/-- **The one-term sequence of unit sections has an acyclic Koszul complex.** Its germs are the
unit germs, and the one-term unit sequence of a ring is Koszul-regular. -/
theorem isKoszulSequenceExactOn_unitSequence (X : RingedSpace.{u}) (U : Opens X) :
    IsKoszulSequenceExactOn X U (fun _ : Fin 1 => (1 : X.presheaf.obj (op U)))
      (fun j => 0 < j) := by
  rw [isKoszulSequenceExactOn_iff_forall_germ_isKoszulRegular]
  intro y hy
  rw [germFamily_unitSequence X U y hy]
  exact isKoszulRegular_unitSequence _

/-- **An ideal sheaf containing the unit section over `U` is generated over `U` by `(1)`.** The
ideal subsheaf generated by the unit section is the whole structure sheaf on the subopens of
`U`, since the restriction of `1` is `1`, and it is contained in `J` because `1 ∈ J(U)`. -/
theorem isGeneratedByOn_unitSequence (J : (structureSheafModule X).Submodule) (U : Opens X)
    (h1 : (1 : X.presheaf.obj (op U)) ∈ J.obj (op U)) :
    IsGeneratedByOn X J U (fun _ : Fin 1 => (1 : X.presheaf.obj (op U))) := by
  intro V hVU
  have hres : (ConcreteCategory.hom ((structureSheafModule X).val.map (homOfLE hVU).op))
      (1 : X.presheaf.obj (op U)) = (1 : X.presheaf.obj (op V)) :=
    map_one (X.presheaf.map (homOfLE hVU).op).hom
  have hone : (1 : X.presheaf.obj (op V)) ∈
      (generatedIdealOn X U (fun _ : Fin 1 => (1 : X.presheaf.obj (op U)))).obj (op V) := by
    rw [← hres]
    exact (generatedIdealOn X U (fun _ : Fin 1 => (1 : X.presheaf.obj (op U)))).map_mem
      (homOfLE hVU).op
      (mem_generatedIdealOn X U (fun _ : Fin 1 => (1 : X.presheaf.obj (op U))) 0)
  have hgentop : (generatedIdealOn X U
      (fun _ : Fin 1 => (1 : X.presheaf.obj (op U)))).obj (op V) = ⊤ :=
    (Ideal.eq_top_iff_one _).mpr hone
  refine le_antisymm ?_ (generatedIdealOn_le X U
    (fun _ : Fin 1 => (1 : X.presheaf.obj (op U))) J (fun _ => h1) (op V))
  rw [hgentop]
  exact le_top

end Sections

/-! ### Off the support, and over all of `X` -/

section Cover

variable {X : RingedSpace.{u}} (J : (structureSheafModule X).Submodule)

/-- **Off the support of `O_X/J` a Koszul presentation always exists.** A point outside the
support has a neighbourhood `U` with `1 ∈ J(U)`, and over `U` the one-term sequence `(1)` both
generates `J` and has a Koszul complex acyclic in positive degrees.  No regularity hypothesis on
`J` is involved. -/
theorem exists_koszulPresentation_of_notMem_idealQuotientSupport (x : X)
    (hx : x ∉ idealQuotientSupport X J) :
    ∃ (U : Opens X) (_hx : x ∈ U) (r : ℕ) (f : Fin r → X.presheaf.obj (op U)),
      IsKoszulSequenceExactOn X U f (fun j => 0 < j) ∧ IsGeneratedByOn X J U f := by
  obtain ⟨U, hxU, h1⟩ := (notMem_idealQuotientSupport_iff J x).mp hx
  exact ⟨U, hxU, 1, fun _ => 1, isKoszulSequenceExactOn_unitSequence X U,
    isGeneratedByOn_unitSequence J U h1⟩

/-- **A Koszul-regular ideal sheaf has a Koszul presentation near every point of `X`.** On the
support of `O_X/J` this is the definition of Stacks tag 063D, part (2), and off the support it is
the one-term unit sequence. -/
theorem exists_koszulPresentation_of_isKoszulRegularIdealSheaf
    (hJ : IsKoszulRegularIdealSheaf X J) (x : X) :
    ∃ (U : Opens X) (_hx : x ∈ U) (r : ℕ) (f : Fin r → X.presheaf.obj (op U)),
      IsKoszulSequenceExactOn X U f (fun j => 0 < j) ∧ IsGeneratedByOn X J U f := by
  by_cases hx : x ∈ idealQuotientSupport X J
  · exact hJ x hx
  · exact exists_koszulPresentation_of_notMem_idealQuotientSupport J x hx

/-- The opens of `X` carrying a Koszul presentation of `J`: those `U` over which `J` is generated
by a sequence of sections whose Koszul complex is acyclic in positive degrees.  This is the index
type of the cover of `coversTop_koszulPresentationOpen`. -/
def KoszulPresentationOpen (X : RingedSpace.{u}) (J : (structureSheafModule X).Submodule) :
    Type u :=
  {U : Opens X // ∃ (r : ℕ) (f : Fin r → X.presheaf.obj (op U)),
    IsKoszulSequenceExactOn X U f (fun j => 0 < j) ∧ IsGeneratedByOn X J U f}

/-- **The opens carrying a Koszul presentation of a Koszul-regular ideal sheaf exhaust `X`.**
Every point lies in one of them, by
`exists_koszulPresentation_of_isKoszulRegularIdealSheaf`. -/
theorem iSup_koszulPresentationOpen_eq_top (hJ : IsKoszulRegularIdealSheaf X J) :
    (⨆ U : KoszulPresentationOpen X J, U.1) = ⊤ := by
  refine SetLike.ext fun x => ⟨fun _ => Opens.mem_top x, fun _ => ?_⟩
  obtain ⟨U, hxU, r, f, hkos, hgen⟩ :=
    exists_koszulPresentation_of_isKoszulRegularIdealSheaf J hJ x
  exact Opens.mem_iSup.mpr ⟨⟨U, r, f, hkos, hgen⟩, hxU⟩

/-- **A Koszul-regular ideal sheaf admits a Koszul presentation on a cover of all of `X`.** The
opens carrying one cover `X` for the topology of its opens; this is the statement with the index
type named. -/
theorem coversTop_koszulPresentationOpen (hJ : IsKoszulRegularIdealSheaf X J) :
    (Opens.grothendieckTopology X).CoversTop
      (fun U : KoszulPresentationOpen X J => U.1) :=
  (Opens.coversTop_iff _ _).mpr
    (IsOpenCover.mk (iSup_koszulPresentationOpen_eq_top J hJ))

/-- **A Koszul-regular ideal sheaf admits a Koszul presentation on a cover of all of `X`.** The
same statement as `coversTop_koszulPresentationOpen`, phrased as an existential over index types:
there is a family of opens covering `X` over each of which `J` is generated by a sequence whose
Koszul complex is acyclic in positive degrees.  Stacks tag 063D only furnishes such opens near
the support of `O_X/J`, so the content is that the one-term unit sequence fills in the rest. -/
theorem coversTop_koszulCover_of_isKoszulRegularIdealSheaf
    (hJ : IsKoszulRegularIdealSheaf X J) :
    ∃ (ι : Type u) (V : ι → Opens X),
      (Opens.grothendieckTopology X).CoversTop V ∧
        ∀ i, ∃ (r : ℕ) (f : Fin r → X.presheaf.obj (op (V i))),
          IsKoszulSequenceExactOn X (V i) f (fun j => 0 < j) ∧ IsGeneratedByOn X J (V i) f :=
  ⟨KoszulPresentationOpen X J, fun U => U.1, coversTop_koszulPresentationOpen J hJ,
    fun U => U.2⟩

end Cover

end Stacks.AlgebraicGeometry.RegularIdealSheaf
