module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Abelian
public import Mathlib.AlgebraicGeometry.AffineScheme
public import StacksFrontier.AlgebraicGeometry.QuasiRegular.Basic
public import StacksFrontier.Topology.Sheaves.Modules.SupportSection
public import StacksCore.Tactic.StacksAttribute

/-!
# Ideal sheaves generated by sections on an open set

Let `X` be a ringed space and let `J ⊆ O_X` be a sheaf of ideals, realised as a submodule of the
rank-one structure sheaf module.  A finite family `f₁, …, f_r` of sections of `O_X` over an open
`U` generates an ideal subsheaf `generatedIdealOn X U f`, the least ideal subsheaf containing them
over `U`; the family *generates* `J` over `U` when the two agree on every subopen of `U`.

The main result is that on the subopens of `U` the generated ideal subsheaf is cut out pointwise:
a section lies in it exactly when each of its germs lies in the ideal generated by the germs of
the `fᵢ`.  Everything about generation on an open set follows, in particular that it is inherited
by smaller opens.

This is the vocabulary of Stacks tag 063D, together with the local regularity condition of its
part (4) that Stacks tag 063G characterizes affine-locally.

## Main definitions

* `generatedIdealOn X U f`: the ideal subsheaf generated by the sections `f` over `U`.
* `IsGeneratedByOn X J U f`: the family `f` generates `J` over `U`.
* `idealQuotientSupport X J`: the support of `O_X / J`.
* `sectionOnRestriction X U s`: a section over `U` as a global section of `X` restricted to `U`.
* `IsQuasiRegularIdealSheaf X J`: `J` is locally generated by a sequence whose
  sheaf quasi-regularity map (Stacks tag 063B) is an isomorphism.

## Main results

* `mem_generatedIdealOn_iff`: the pointwise germ description, on subopens of `U`.
* `isGeneratedByOn_of_le`: generation over `U` is inherited by smaller opens.

## Implementation notes

The support of the quotient is `AlgebraicGeometry.RingedSpace.ModuleSheaf.supp` of the quotient
sheaf, so there is one notion of support in the development rather than two spellings of it.
`ModuleSheaf` is itself declared for a ringed space whose two universes agree, which is what
constrains `X` here; `supp` adds no constraint of its own.

## References

* [Stacks Project, Definition 31.20.1 (Tag 063D)](https://stacks.math.columbia.edu/tag/063D)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.RingTheory.QuasiRegular
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.RingedSpace

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

section Generated

/-- The ideal subsheaf of `O_X` generated by a finite family of sections over `U`: the least
ideal subsheaf whose sections over `U` contain all the `fᵢ`. -/
noncomputable def generatedIdealOn (X : RingedSpace.{u}) (U : Opens X) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op U)) : (structureSheafModule X).Submodule :=
  sInf {I : (structureSheafModule X).Submodule | ∀ i, f i ∈ I.obj (op U)}

/-- Each generating section belongs to the ideal subsheaf it generates. -/
theorem mem_generatedIdealOn (X : RingedSpace.{u}) (U : Opens X) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op U)) (i : Fin r) :
    f i ∈ (generatedIdealOn X U f).obj (op U) := by
  change (show (structureSheafModule X).val.obj (op U) from f i) ∈
    (generatedIdealOn X U f).toSubmodule.obj (op U)
  simp only [generatedIdealOn, SheafOfModules.Submodule.toSubmodule_sInf,
    PresheafOfModules.Submodule.sInf_obj]
  apply Submodule.mem_sInf.2
  rintro P ⟨I, hI, rfl⟩
  apply (Submodule.mem_iInf _).2
  rintro ⟨J, hJ, rfl⟩
  exact hJ i

/-- The generated ideal subsheaf is the least one containing the generating sections. -/
theorem generatedIdealOn_le (X : RingedSpace.{u}) (U : Opens X) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op U)) (I : (structureSheafModule X).Submodule)
    (hI : ∀ i, f i ∈ I.obj (op U)) : generatedIdealOn X U f ≤ I :=
  sInf_le hI

/-- A finite family of sections generates an ideal sheaf over an open set. -/
def IsGeneratedByOn (X : RingedSpace.{u}) (J : (structureSheafModule X).Submodule) (U : Opens X)
    {r : ℕ} (f : Fin r → X.presheaf.obj (op U)) : Prop :=
  ∀ V : Opens X, V ≤ U → J.obj (op V) = (generatedIdealOn X U f).obj (op V)

end Generated

section Quotient

/-- The quotient of the structure sheaf by an ideal subsheaf. -/
noncomputable abbrev idealQuotient (X : RingedSpace.{u})
    (J : (structureSheafModule X).Submodule) :
    SheafOfModules.{u} ((sheafCompose (Opens.grothendieckTopology X)
      (forget₂ CommRingCat.{u} RingCat.{u})).obj X.sheaf) :=
  CategoryTheory.Limits.cokernel J.ι

/-- The support of the quotient by an ideal subsheaf: the points where its stalk is nonzero. -/
noncomputable def idealQuotientSupport (X : RingedSpace.{u})
    (J : (structureSheafModule X).Submodule) : Set X :=
  RingedSpace.ModuleSheaf.supp
    (⟨(idealQuotient X J).val, (idealQuotient X J).isSheaf⟩ : RingedSpace.ModuleSheaf.{u} X)

end Quotient

section Restriction

/-- A section over an open set, regarded as a global section of the restricted ringed space. -/
def sectionOnRestriction (X : RingedSpace.{u}) (U : Opens X) (f : X.presheaf.obj (op U)) :
    (X.restrict U.isOpenEmbedding).presheaf.obj
      (op (⊤ : Opens (X.restrict U.isOpenEmbedding))) := by
  change X.presheaf.obj (op (U.isOpenEmbedding.functor.obj ⊤))
  have h : U.isOpenEmbedding.functor.obj
      (⊤ : Opens ((Opens.toTopCat X).obj U)) = U := by
    ext x
    simp
  exact h.symm ▸ f

/-- **The local quasi-regularity condition of Stacks tag 063D, part (4).** The ideal sheaf `J` is
quasi-regular when, near every point of the support of `O_X / J`, it is generated by a sequence
whose sheaf quasi-regularity map of Stacks tag 063B is an isomorphism. -/
@[stacks 063D "part (4): quasi-regular ideal sheaf", ega "IV 16.9.1" "quasi-regular"]
def IsQuasiRegularIdealSheaf (X : RingedSpace.{u})
    (J : (structureSheafModule X).Submodule) : Prop :=
  ∀ x : X, x ∈ idealQuotientSupport X J →
    ∃ (U : Opens X) (_hx : x ∈ U) (r : ℕ) (f : Fin r → X.presheaf.obj (op U)),
      IsIso (quasiRegularMap (X.restrict U.isOpenEmbedding)
        (fun i => sectionOnRestriction X U (f i))).hom ∧ IsGeneratedByOn X J U f

end Restriction

section Germs

variable {X : RingedSpace.{u}} {r : ℕ}

/-- The germs at `y` of a finite family of sections over an open set containing `y`. -/
noncomputable def germFamily (X : RingedSpace.{u}) (U : Opens X) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op U)) (y : X) (hy : y ∈ U) : Fin r → X.presheaf.stalk y :=
  fun i => X.presheaf.germ U y hy (f i)

/-- Restricting the generating family does not change its germs. -/
theorem germFamily_res (U U' : Opens X) (hU' : U' ≤ U) (f : Fin r → X.presheaf.obj (op U))
    (y : X) (hy : y ∈ U') :
    germFamily X U' (fun i => X.presheaf.map (homOfLE hU').op (f i)) y hy
      = germFamily X U f y (hU' hy) := by
  funext i
  exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hU') y hy (f i)

variable (U : Opens X) (f : Fin r → X.presheaf.obj (op U))

/-- The ideal of sections over `V` whose germ at each point of `V ⊓ U` lies in the ideal
generated by the germs of `f` there. -/
noncomputable def germIdealOnObj (V : Opens X) : Ideal (X.presheaf.obj (op V)) where
  carrier := {s | ∀ (y : X) (hyV : y ∈ V) (hyU : y ∈ U),
    X.presheaf.germ V y hyV s ∈ Jid (germFamily X U f y hyU)}
  zero_mem' y hyV hyU := by
    rw [map_zero]
    exact Ideal.zero_mem _
  add_mem' {a b} ha hb y hyV hyU := by
    rw [map_add]
    exact Ideal.add_mem _ (ha y hyV hyU) (hb y hyV hyU)
  smul_mem' c a ha y hyV hyU := by
    rw [smul_eq_mul, map_mul]
    exact Ideal.mul_mem_left _ _ (ha y hyV hyU)

/-- The ideal subsheaf of `O_X` cut out pointwise over `U` by the germs of `f`. -/
noncomputable def germIdealOn : (structureSheafModule X).Submodule where
  obj V := germIdealOnObj U f V.unop
  map {V W} i s hs y hyW hyU := by
    have h : X.presheaf.germ W.unop y hyW (X.presheaf.map i s)
        = X.presheaf.germ V.unop y (i.unop.le hyW) s :=
      TopCat.Presheaf.germ_res_apply' X.presheaf i y hyW s
    exact h ▸ hs y (i.unop.le hyW) hyU
  isSheaf {V} s hsieve y hyV hyU := by
    obtain ⟨W, g, hgs, hyW⟩ := (Opens.mem_grothendieckTopology _).mp hsieve y hyV
    have h : X.presheaf.germ W y hyW (X.presheaf.map g.op s)
        = X.presheaf.germ V.unop y (g.le hyW) s :=
      TopCat.Presheaf.germ_res_apply X.presheaf g y hyW s
    exact h ▸ hgs y hyW hyU

/-- Each section `f i` lies in `germIdealOn U f` over `U`. -/
theorem germIdealOn_mem_generators : ∀ i, f i ∈ (germIdealOn U f).obj (op U) :=
  fun i _ _ _hyU => Ideal.subset_span ⟨i, rfl⟩

/-- Membership in the generated ideal subsheaf forces the germ condition. -/
theorem germ_mem_of_mem_generatedIdealOn (V : Opens X) (s : X.presheaf.obj (op V))
    (hs : s ∈ (generatedIdealOn X U f).obj (op V)) (y : X) (hyV : y ∈ V) (hyU : y ∈ U) :
    X.presheaf.germ V y hyV s ∈ Jid (germFamily X U f y hyU) :=
  generatedIdealOn_le X U f (germIdealOn U f) (germIdealOn_mem_generators U f) (op V) hs
    y hyV hyU

/-- Conversely, over a subopen of `U` the germ condition forces membership in every ideal
subsheaf containing the generating sections: near each point the section is an `O_X`-combination
of the `fᵢ`. -/
theorem mem_of_germ_mem (I : (structureSheafModule X).Submodule)
    (hI : ∀ i, f i ∈ I.obj (op U)) (V : Opens X) (hVU : V ≤ U) (s : X.presheaf.obj (op V))
    (hs : ∀ (y : X) (hy : y ∈ V),
      X.presheaf.germ V y hy s ∈ Jid (germFamily X U f y (hVU hy))) :
    s ∈ I.obj (op V) := by
  classical
  refine I.isSheaf s ((Opens.mem_grothendieckTopology _).mpr fun x hx => ?_)
  obtain ⟨cc, hcc⟩ := Ideal.mem_span_range_iff_exists_fun.mp (hs x hx)
  obtain ⟨V₀, hxV₀, b, hb⟩ := exists_nhds_germ_eq (Finset.univ : Finset (Fin r)) x cc
  have hxW₀ : x ∈ V ⊓ V₀ := ⟨hx, hxV₀⟩
  have hinfU : V ⊓ V₀ ≤ U := le_trans (inf_le_left (a := V) (b := V₀)) hVU
  set dd : X.presheaf.obj (op (V ⊓ V₀)) :=
    X.presheaf.map (homOfLE (inf_le_left (a := V) (b := V₀))).op s
      - ∑ i, X.presheaf.map (homOfLE (inf_le_right (a := V) (b := V₀))).op (b i)
          * X.presheaf.map (homOfLE hinfU).op (f i) with hdd
  have hgerm : X.presheaf.germ (V ⊓ V₀) x hxW₀ dd = 0 := by
    rw [hdd, map_sub, map_sum, sub_eq_zero,
      TopCat.Presheaf.germ_res_apply X.presheaf
        (homOfLE (inf_le_left (a := V) (b := V₀))) x hxW₀ s, ← hcc]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul,
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hinfU) x hxW₀ (f i),
      TopCat.Presheaf.germ_res_apply X.presheaf
        (homOfLE (inf_le_right (a := V) (b := V₀))) x hxW₀ (b i),
      hb i (Finset.mem_univ i)]
    rfl
  obtain ⟨W, hxW, hWW₀, hdW⟩ :=
    exists_nhds_eq_zero_of_germ_eq_zero (V ⊓ V₀) dd x hxW₀ hgerm
  refine ⟨W, homOfLE (le_trans hWW₀ (inf_le_left (a := V) (b := V₀))), ?_, hxW⟩
  have hrel : X.presheaf.map
        (homOfLE (le_trans hWW₀ (inf_le_left (a := V) (b := V₀)))).op s
      = ∑ i, X.presheaf.map
            (homOfLE (le_trans hWW₀ (inf_le_right (a := V) (b := V₀)))).op (b i)
          * X.presheaf.map (homOfLE (le_trans hWW₀ hinfU)).op (f i) := by
    rw [hdd, map_sub, map_sum, sub_eq_zero] at hdW
    rw [← res_res (inf_le_left (a := V) (b := V₀)) hWW₀ s, hdW]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, res_res, res_res]
  change X.presheaf.map _ s ∈ _
  rw [hrel]
  exact Submodule.sum_mem _ fun i _ =>
    Submodule.smul_mem _ _ (I.toSubmodule.map_mem (homOfLE (le_trans hWW₀ hinfU)).op (hI i))

/-- **The sections of the ideal sheaf generated by `f` over `U`.** On a subopen `V` of `U` a
section of `O_X` lies in the ideal subsheaf generated by `f` exactly when each of its germs lies
in the ideal generated by the germs of the `fᵢ`. -/
theorem mem_generatedIdealOn_iff (V : Opens X) (hVU : V ≤ U) (s : X.presheaf.obj (op V)) :
    s ∈ (generatedIdealOn X U f).obj (op V) ↔
      ∀ (y : X) (hy : y ∈ V),
        X.presheaf.germ V y hy s ∈ Jid (germFamily X U f y (hVU hy)) :=
  ⟨fun hs y hy => germ_mem_of_mem_generatedIdealOn U f V s hs y hy (hVU hy),
    mem_of_germ_mem U f (generatedIdealOn X U f) (mem_generatedIdealOn X U f) V hVU s⟩

/-- Generation over `U` is inherited by any smaller open set. -/
theorem isGeneratedByOn_of_le {J : (structureSheafModule X).Submodule}
    (h : IsGeneratedByOn X J U f) (U' : Opens X) (hU' : U' ≤ U) :
    IsGeneratedByOn X J U' (fun i => X.presheaf.map (homOfLE hU').op (f i)) := by
  intro V hVU'
  rw [h V (hVU'.trans hU')]
  ext s
  exact (mem_generatedIdealOn_iff U f V (hVU'.trans hU') s).trans
    ((forall₂_congr fun y hy => by rw [germFamily_res U U' hU' f y (hVU' hy)]).trans
      (mem_generatedIdealOn_iff U' _ V hVU' s).symm)

end Germs

section RestrictStalk

/-- The germ of a section of `U`, read as a global section of `X` restricted to `U`, is its germ
on `U`. -/
theorem germ_sectionOnRestriction (X : RingedSpace.{u}) (U : Opens X)
    (s : X.presheaf.obj (op U)) (y : X) (hy : y ∈ U)
    (hy' : y ∈ U.isOpenEmbedding.functor.obj (⊤ : Opens ↥U)) :
    X.presheaf.germ (U.isOpenEmbedding.functor.obj ⊤) y hy' (sectionOnRestriction X U s)
      = X.presheaf.germ U y hy s := by
  have key : ∀ (W : Opens X) (hWU : W = U) (hyW : y ∈ W) (t : X.presheaf.obj (op W)),
      t = hWU.symm ▸ s → X.presheaf.germ W y hyW t = X.presheaf.germ U y hy s := by
    intro W hWU hyW t ht
    subst hWU
    subst ht
    rfl
  exact key _ (Opens.isOpenEmbedding_obj_top U) hy' _ rfl

/-- The stalk of the restriction of `X` to `U` at a point of `U` is the stalk of `X` there. -/
noncomputable def restrictStalkEquiv (X : RingedSpace.{u}) (U : Opens X) (y : X) (hy : y ∈ U) :
    (X.restrict U.isOpenEmbedding).presheaf.stalk (⟨y, hy⟩ : ↥U) ≃+* X.presheaf.stalk y :=
  (X.toPresheafedSpace.restrictStalkIso U.isOpenEmbedding
    (⟨y, hy⟩ : ↥U)).commRingCatIsoToRingEquiv

/-- Under that identification the germs of a family read on the restriction are the germs of the
family on `U`. -/
theorem restrictStalkEquiv_germSequence (X : RingedSpace.{u}) (U : Opens X) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op U)) (y : X) (hy : y ∈ U) (i : Fin r) :
    restrictStalkEquiv X U y hy
        (germSequence (X.restrict U.isOpenEmbedding)
          (fun j => sectionOnRestriction X U (f j)) ⟨y, hy⟩ i)
      = germFamily X U f y hy i :=
  (PresheafedSpace.restrictStalkIso_hom_eq_germ_apply X.toPresheafedSpace
    U.isOpenEmbedding (⊤ : Opens ↥U) (⟨y, hy⟩ : ↥U) trivial (sectionOnRestriction X U (f i))).trans
    (germ_sectionOnRestriction X U (f i) y hy _)

end RestrictStalk

end Stacks.AlgebraicGeometry.RegularIdealSheaf
