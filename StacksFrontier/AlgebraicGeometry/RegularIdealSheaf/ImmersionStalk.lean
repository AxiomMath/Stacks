module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Germ
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Immersion

/-!
# The stalks of the defining ideal sheaf of an immersion

Let `j : Z ⟶ X` be a morphism of schemes whose base map is an embedding, so that
`definingIdealOfHom j` is the ideal subsheaf of `O_X` of sections dying in `j_* O_Z`.  This file
identifies its stalk at `j z` with the kernel of the map of local rings `O_{X, j z} ⟶ O_{Z, z}`,
and combines that with the germ bridge of
`StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Germ`: when the defining ideal sheaf is
generated near `j z` by a regular sequence of sections, that kernel is generated by a regular
sequence of the local ring.

## Main results

* `stalkIdeal_definingIdealOfHom_eq_ker`: the stalk of the defining ideal sheaf at `j z` is
  `RingHom.ker (j.stalkMap z)`.
* `stalkIdeal_definingIdealOfHom_ne_top`: that stalk is a proper ideal, since `O_{Z, z}` is a
  local ring and in particular not the zero ring.
* `exists_isRegular_generating_ker_stalkMap_of_generators` and
  `exists_isRegular_generating_ker_stalkMap`: the kernel of the map of local rings is generated
  by a regular sequence, from local regular generators and from a regular ideal sheaf
  respectively.

## Implementation notes

The inclusion of the stalk ideal in the kernel is the statement that the germ of a section of the
ideal sheaf dies in `O_{Z, z}`.  The reverse inclusion needs a section of `O_X` on an open of `X`
restricting into a prescribed open of `Z`, which is where the embedding hypothesis enters:
`j.isEmbedding.isInducing` produces an open of `X` cutting out the given open of `Z`, and
intersecting it with the open the germ came from gives a neighbourhood on which the section lies
in the defining ideal sheaf.

Properness of the kernel is automatic, so the generator form of the last result needs no
condition on the point; the `IsRegularIdealSheaf` form still quantifies over the support of the
quotient, because that is how Stacks tag 063D is stated.

## References

* [Stacks Project, Definition 31.21.4 (Tag 063J)](https://stacks.math.columbia.edu/tag/063J)
* [Stacks Project, Lemma 37.62.11 (Tag 09RK)](https://stacks.math.columbia.edu/tag/09RK)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open RingTheory.Sequence
open RingedSpaceModuleAdjunction
open Stacks.RingTheory.QuasiRegular
open Stacks.AlgebraicGeometry.QuasiRegular

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

/-- **The stalk of the defining ideal sheaf is the kernel of the map of local rings.** For a
morphism of schemes whose base map is an embedding, the stalk at `j z` of the ideal sheaf of
sections dying in `j_* O_Z` is the kernel of `O_{X, j z} ⟶ O_{Z, z}`. -/
@[sga "3 VIIA 1.3" "Clause u⁻¹(J_u)=I_u"]
theorem stalkIdeal_definingIdealOfHom_eq_ker {Z X : Scheme.{u}} (j : Z ⟶ X) [IsImmersion j]
    (z : Z) :
    Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace) (definingIdealOfHom j) (j.base z) =
      RingHom.ker (j.stalkMap z).hom := by
  classical
  apply le_antisymm
  · rw [Stacks.RingedSpace.stalkIdeal, Ideal.span_le]
    rintro a ⟨U, hxU, s, hs, rfl⟩
    refine RingHom.mem_ker.mpr ?_
    rw [Scheme.Hom.germ_stalkMap_apply]
    have hs0 := (mem_definingIdealOfHom j U s).mp hs
    change (j.app U).hom s = 0 at hs0
    simp [hs0]
  · intro a ha
    obtain ⟨U, hxU, s, rfl⟩ := X.presheaf.exists_germ_eq a
    have hzU : z ∈ j ⁻¹ᵁ U := by simpa using hxU
    have hzero : Z.presheaf.germ (j ⁻¹ᵁ U) z hzU (j.app U s) = 0 := by
      calc
        Z.presheaf.germ (j ⁻¹ᵁ U) z hzU (j.app U s) =
            (j.stalkMap z) (X.presheaf.germ U (j.base z) hxU s) :=
          (Scheme.Hom.germ_stalkMap_apply j U z hxU s).symm
        _ = 0 := ha
    have hzero' : Z.presheaf.germ (j ⁻¹ᵁ U) z hzU (j.app U s) =
        Z.presheaf.germ ⊤ z trivial (0 : Z.presheaf.obj (op ⊤)) := by
      simpa using hzero
    obtain ⟨W, hzW, iWU, iWtop, hW⟩ :=
      Z.presheaf.germ_eq z hzU (by trivial) (j.app U s)
        (0 : Z.presheaf.obj (op ⊤)) hzero'
    obtain ⟨V, hV, hpre⟩ := j.isEmbedding.isInducing.isOpen_iff.mp W.2
    let V' : X.Opens := ⟨V ∩ U, hV.inter U.2⟩
    have hV'U : V' ≤ U := inf_le_right (a := (V : Set X)) (b := (U : Set X))
    have hpreV' : j ⁻¹ᵁ V' = W := by
      ext w
      change j.base w ∈ V ∩ U ↔ w ∈ W.1
      rw [Set.mem_inter_iff]
      refine ⟨fun h => ?_, fun hw => ⟨?_, iWU.le hw⟩⟩
      · rw [← hpre]; exact h.1
      · have : w ∈ j.base ⁻¹' V := by simpa [hpre] using hw
        exact this
    subst hpreV'
    have hs' : X.presheaf.map (homOfLE hV'U).op s ∈
        (definingIdealOfHom j).obj (op V') := by
      refine (mem_definingIdealOfHom j V' _).2 ?_
      change (j.app V').hom (X.presheaf.map (homOfLE hV'U).op s) = 0
      have hnat : (j.app V').hom (X.presheaf.map (homOfLE hV'U).op s) =
          (Z.presheaf.map ((Opens.map j.base).map (homOfLE hV'U)).op).hom
            ((j.app U).hom s) := by
        simp
      have hW0 : (Z.presheaf.map iWU.op).hom ((j.app U).hom s) = 0 := by
        simpa [Scheme.Hom.appLE] using hW
      refine hnat.trans ?_
      rw [show ((Opens.map j.base).map (homOfLE hV'U)) = iWU from Subsingleton.elim _ _]
      exact hW0
    refine Ideal.subset_span ⟨V', hzW, X.presheaf.map (homOfLE hV'U).op s, hs', ?_⟩
    exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hV'U) _ _ s

/-- The stalk of the defining ideal sheaf of an immersion is a proper ideal: it is the kernel
of a ring map into the local ring `O_{Z, z}`, which is not the zero ring. -/
theorem stalkIdeal_definingIdealOfHom_ne_top {Z X : Scheme.{u}} (j : Z ⟶ X) [IsImmersion j]
    (z : Z) :
    Stacks.RingedSpace.stalkIdeal (X := X.toLocallyRingedSpace)
      (definingIdealOfHom j) (j.base z) ≠ ⊤ := by
  rw [stalkIdeal_definingIdealOfHom_eq_ker]
  exact RingHom.ker_ne_top _

/-- **A regular generating sequence for the defining ideal sheaf generates the stalk kernel by
a regular sequence.** If the defining ideal sheaf of `j` is generated over an open `U ∋ j z` by
a regular sequence of sections, then the kernel of `O_{X, j z} ⟶ O_{Z, z}` is generated by a
regular sequence of the local ring.

The properness of the kernel is automatic, so no condition on the point is needed: this is the
sheaf-to-local-ring half of Stacks tag 09RK, stated for a single factor and consuming exactly
the local data that `IsRegularIdealSheaf` supplies at a point of the support. -/
theorem exists_isRegular_generating_ker_stalkMap_of_generators
    {Z X : Scheme.{u}} (j : Z ⟶ X) [IsImmersion j] (z : Z) (U : Opens X)
    (hzU : j.base z ∈ U) {r : ℕ} (g : Fin r → X.presheaf.obj (op U))
    (hreg : IsRegularSequenceOn X.toRingedSpace U g)
    (hgen : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom j) U g) :
    ∃ rs : List (X.presheaf.stalk (j.base z)),
      IsRegular (X.presheaf.stalk (j.base z)) rs ∧
        Ideal.ofList rs = RingHom.ker (j.stalkMap z).hom := by
  obtain ⟨rs, hr, hspan⟩ := exists_isRegular_generating_stalkIdeal_of_generators
    (X := X.toLocallyRingedSpace) (definingIdealOfHom j) U g hreg hgen (j.base z) hzU
    (stalkIdeal_definingIdealOfHom_ne_top j z)
  exact ⟨rs, hr, hspan.trans (stalkIdeal_definingIdealOfHom_eq_ker j z)⟩

/-- **A regular immersion has stalk kernels generated by regular sequences.** If the defining
ideal sheaf of a morphism of schemes with embedded base map is a regular ideal sheaf, then at
every point of the source whose image lies in the support of the quotient, the kernel of the
induced map of local rings is generated by a regular sequence. -/
theorem exists_isRegular_generating_ker_stalkMap {Z X : Scheme.{u}} (j : Z ⟶ X) [IsImmersion j]
    (h : IsRegularIdealSheaf X.toRingedSpace (definingIdealOfHom j)) (z : Z)
    (hz : j.base z ∈ idealQuotientSupport X.toRingedSpace (definingIdealOfHom j)) :
    ∃ rs : List (X.presheaf.stalk (j.base z)),
      IsRegular (X.presheaf.stalk (j.base z)) rs ∧
        Ideal.ofList rs = RingHom.ker (j.stalkMap z).hom := by
  obtain ⟨U, hzU, s, g, hreg, hgen⟩ := h (j.base z) hz
  exact exists_isRegular_generating_ker_stalkMap_of_generators j z U hzU g hreg hgen

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
