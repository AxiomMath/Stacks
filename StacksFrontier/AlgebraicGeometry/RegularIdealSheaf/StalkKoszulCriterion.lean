namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

/-! ### Koszul-regularity of a sequence generating the unit ideal -/

section UnitIdeal

variable {R : Type*} [CommRing R] {r : ℕ}

/-- A finite sequence one of whose terms is a unit is Koszul-regular: the one-term sequence
consisting of that unit is weakly regular, hence Koszul-regular, and it generates the same (unit)
ideal, so Stacks tag 066A transfers Koszul-regularity. -/
private alias koszulRegular_of_isUnit_entry := isKoszulRegular_of_isUnit_apply

/-- **A sequence generating the unit ideal of a local ring is Koszul-regular.** One of its terms
lies outside the maximal ideal, hence is a unit. -/
private theorem koszulRegular_of_span_eq_top [IsLocalRing R] (f : Fin r → R)
    (hf : Ideal.span (Set.range f) = ⊤) : Koszul.IsKoszulRegular f := by
  by_cases hex : ∃ i, IsUnit (f i)
  · obtain ⟨i, hi⟩ := hex
    exact koszulRegular_of_isUnit_entry f i hi
  · refine absurd ?_ (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    refine top_le_iff.mp ?_
    rw [← hf, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact (IsLocalRing.mem_maximalIdeal _).mpr fun hu => hex ⟨i, hu⟩

/-- A weakly regular sequence is Koszul-regular, in the `Fin r`-indexed form, by Stacks
tag 062F. -/
private theorem koszulRegular_of_isWeaklyRegular (f : Fin r → R)
    (hf : IsWeaklyRegular R (List.ofFn f)) : Koszul.IsKoszulRegular f :=
  (Koszul.isKoszulRegularOn_self_iff f).mp
    (Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular.1 hf)

end UnitIdeal

/-! ### Realising germs of an ideal subsheaf by sections of it -/

section Realise

variable {X : LocallyRingedSpace.{u}} (J : (structureSheafModule X.toRingedSpace).Submodule)

/-- Finitely many germs lying in the stalk of an ideal subsheaf are simultaneously represented by
sections *of that subsheaf* on one neighbourhood. -/
private alias exists_mem_sections_stalkIdeal_germ_eq :=
    Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_mem_sections_germ_eq

/-- **A finite family of germs in the stalk of an ideal subsheaf is the germ family of sections
of that subsheaf on one neighbourhood.** -/
private theorem exists_sections_mem_stalkIdeal_germFamily_eq (x : X) {r : ℕ}
    (g : Fin r → X.presheaf.stalk x) (hg : ∀ k, g k ∈ Stacks.RingedSpace.stalkIdeal J x) :
    ∃ (U : Opens X) (hx : x ∈ U) (f : Fin r → X.presheaf.obj (op U)),
      (∀ k, f k ∈ J.obj (op U)) ∧ germFamily X.toRingedSpace U f x hx = g := by
  obtain ⟨U, hx, σ, hσJ, hσ⟩ := exists_mem_sections_stalkIdeal_germ_eq J x g hg Finset.univ
  exact ⟨U, hx, σ, hσJ, funext fun k => hσ k (Finset.mem_univ k)⟩

end Realise

/-! ### The criterion for the defining ideal sheaf of a closed immersion -/

section IdealSheaf

/-- **A closed immersion into a locally Noetherian scheme whose stalk ideals are generated by
weakly regular sequences of one fixed length `r` has Koszul-regular defining ideal sheaf.**

The length `r` is the same at every point; this is what makes Stacks tag 066A applicable, and
the statement is false without it. -/
@[sga "6 VII 1.4" "special case"]
theorem isKoszulRegularIdealSheaf_of_stalk_isWeaklyRegular {Z Y : Scheme.{u}}
    [IsLocallyNoetherian Y] (j : Z ⟶ Y) [IsClosedImmersion j] (r : ℕ)
    (h : ∀ z : Z, ∃ g : Fin r → Y.presheaf.stalk (j.base z),
      IsWeaklyRegular (Y.presheaf.stalk (j.base z)) (List.ofFn g) ∧
        Ideal.span (Set.range g) = RingHom.ker (j.stalkMap z).hom) :
    IsKoszulRegularIdealSheaf Y.toRingedSpace (definingIdealOfHom j) := by
  classical
  -- The hypothesis, restated intrinsically at the points of the support.
  have key : ∀ y : Y, y ∈ idealQuotientSupport Y.toRingedSpace (definingIdealOfHom j) →
      ∃ g : Fin r → Y.presheaf.stalk y, Koszul.IsKoszulRegular g ∧
        Ideal.span (Set.range g)
          = Stacks.RingedSpace.stalkIdeal (X := Y.toLocallyRingedSpace)
              (definingIdealOfHom j) y := by
    intro y hy
    rw [Stacks.AlgebraicGeometry.definingIdealQuotient_support_eq_range] at hy
    obtain ⟨z, rfl⟩ := hy
    obtain ⟨g, hgw, hgspan⟩ := h z
    exact ⟨g, koszulRegular_of_isWeaklyRegular g hgw,
      hgspan.trans (stalkIdeal_definingIdealOfHom_eq_ker j z).symm⟩
  intro x hx
  obtain ⟨g, hgK, hgspan⟩ := key x hx
  obtain ⟨U, hxU, f, hfJ, hfg⟩ := exists_sections_mem_stalkIdeal_germFamily_eq
    (X := Y.toLocallyRingedSpace) (definingIdealOfHom j) x g
    fun k => hgspan ▸ Ideal.subset_span ⟨k, rfl⟩
  have hxcob : x ∈ j.coborderRange := by
    rw [Stacks.AlgebraicGeometry.definingIdealQuotient_support_eq_range] at hx
    obtain ⟨z, rfl⟩ := hx
    exact subset_coborder ⟨z, rfl⟩
  have hstalkU : Stacks.RingedSpace.stalkIdeal (X := Y.toLocallyRingedSpace)
      (definingIdealOfHom j) x = Jid (germFamily Y.toRingedSpace U f x hxU) := by
    rw [hfg]
    exact hgspan.symm
  obtain ⟨U', hxU', hU'U, hgen⟩ :=
    exists_isGeneratedByOn_definingIdealOfHom j hxcob hxU f hfJ hstalkU
  refine ⟨U', hxU', r, fun k => Y.presheaf.map (homOfLE hU'U).op (f k), ?_, hgen⟩
  rw [isKoszulSequenceExactOn_iff_forall_germ_isKoszulRegular]
  intro y hy
  have hJy : Stacks.RingedSpace.stalkIdeal (X := Y.toLocallyRingedSpace)
      (definingIdealOfHom j) y
        = Jid (germFamily Y.toRingedSpace U'
            (fun k => Y.presheaf.map (homOfLE hU'U).op (f k)) y hy) :=
    stalkIdeal_eq_Jid_germFamily (X := Y.toLocallyRingedSpace) _ U' _ hgen y hy
  by_cases hyS : y ∈ idealQuotientSupport Y.toRingedSpace (definingIdealOfHom j)
  · obtain ⟨g', hg'K, hg'span⟩ := key y hyS
    exact (Koszul.regularity_of_generators_of_eq_span_range
      (Stacks.RingedSpace.stalkIdeal (X := Y.toLocallyRingedSpace) (definingIdealOfHom j) y)
      _ hJy.symm).2.2 ⟨g', hg'span, hg'K⟩
  · obtain ⟨W, hyW, h1⟩ :=
      (notMem_idealQuotientSupport_iff (definingIdealOfHom j) y).mp hyS
    have htop : Stacks.RingedSpace.stalkIdeal (X := Y.toLocallyRingedSpace)
        (definingIdealOfHom j) y = ⊤ :=
      Ideal.eq_top_of_isUnit_mem _
        ((Stacks.RingedSpace.mem_stalkIdeal_iff _).mpr ⟨W, hyW, 1, h1, map_one _⟩) isUnit_one
    exact koszulRegular_of_span_eq_top _ (hJy.symm.trans htop)

end IdealSheaf

/-! ### The criterion for the immersion -/

section Immersion

/-- **A closed immersion into a locally Noetherian scheme whose stalk ideal at every point of the
source is generated by a weakly regular sequence of a fixed length `r` is a Koszul-regular
immersion.** -/
@[sga "6 VII 1.4" "special case"]
theorem isKoszulRegularImmersion_of_stalk_isWeaklyRegular {Z S : Scheme.{u}}
    [IsLocallyNoetherian S] (i : Z ⟶ S) [IsClosedImmersion i] (r : ℕ)
    (h : ∀ z : Z, ∃ g : Fin r → S.presheaf.stalk (i.base z),
        RingTheory.Sequence.IsWeaklyRegular (S.presheaf.stalk (i.base z)) (List.ofFn g) ∧
        (∀ k, g k ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk (i.base z))) ∧
        Ideal.span (Set.range g) = RingHom.ker (i.stalkMap z).hom) :
    IsKoszulRegularImmersion i := by
  refine isKoszulRegularIdealSheaf_of_stalk_isWeaklyRegular i.liftCoborder r fun z => ?_
  obtain ⟨g, hgw, -, hgspan⟩ := h z
  set e : S.presheaf.stalk (i.base z) ≃+*
      i.coborderRange.toScheme.presheaf.stalk (i.liftCoborder.base z) :=
    (Stacks.Conormal.coborderStalkEquiv i z).commRingCatIsoToRingEquiv with he
  have hcomp : ∀ c : S.presheaf.stalk (i.base z),
      (i.liftCoborder.stalkMap z).hom (e c) = (i.stalkMap z).hom c := fun c => by
    rw [he]
    exact Stacks.Conormal.stalkMap_coborderStalkEquiv i z c
  refine ⟨fun k => e (g k), ?_, ?_⟩
  · have hmap := (Koszul.isWeaklyRegular_ringEquiv e (List.ofFn g)).mp hgw
    rwa [List.map_ofFn, show (⇑e ∘ g) = fun k => e (g k) from rfl] at hmap
  · have hkercomap : RingHom.ker (i.stalkMap z).hom
        = Ideal.comap e (RingHom.ker (i.liftCoborder.stalkMap z).hom) := by
      ext c
      simp only [RingHom.mem_ker, Ideal.mem_comap]
      rw [hcomp c]
    have hrange : (Set.range fun k => e (g k)) = e '' Set.range g :=
      Set.range_comp (⇑e) g
    rw [hrange, ← Ideal.map_span, hgspan, hkercomap,
      Ideal.map_comap_of_surjective _ e.surjective]

end Immersion

end Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace AlgebraicGeometry

/-- **A closed immersion into a locally Noetherian scheme whose stalk ideal at every point of the
source is generated by a weakly regular sequence of a fixed length `r` is a local complete
intersection morphism.** It is a Koszul-regular immersion by
`Stacks.AlgebraicGeometry.RegularIdealSheaf.isKoszulRegularImmersion_of_stalk_isWeaklyRegular`,
and a Koszul-regular immersion is a local complete intersection morphism by Stacks tag 069L. -/
@[sga "5 III 6.8" "Direction"]
theorem isLocalCompleteIntersectionMorphism_of_stalk_isWeaklyRegular {Z S : Scheme.{u}}
    [IsLocallyNoetherian S] (i : Z ⟶ S) [IsClosedImmersion i] (r : ℕ)
    (h : ∀ z : Z, ∃ g : Fin r → S.presheaf.stalk (i.base z),
        RingTheory.Sequence.IsWeaklyRegular (S.presheaf.stalk (i.base z)) (List.ofFn g) ∧
        (∀ k, g k ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk (i.base z))) ∧
        Ideal.span (Set.range g) = RingHom.ker (i.stalkMap z).hom) :
    IsLocalCompleteIntersectionMorphism i :=
  isLocalCompleteIntersectionMorphism_of_isKoszulRegularImmersion i
    (Stacks.AlgebraicGeometry.RegularIdealSheaf.isKoszulRegularImmersion_of_stalk_isWeaklyRegular
      i r h)

end AlgebraicGeometry

end
