module

public import Mathlib.CategoryTheory.Limits.FunctorCategory.EpiMono
public import Mathlib.Data.Fin.Tuple.Take
public import Mathlib.RingTheory.Regular.RegularSequence
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Regular
public import StacksFrontier.AlgebraicGeometry.RingedSpace.IdealSheafGenerators

/-!
# Germs of a regular sequence of sections

Let `X` be a ringed space and `f₁, …, f_r` sections of `O_X` over an open `U` forming a regular
sequence in the sense of Stacks tag 063D, part (1): multiplication by `f_i` on
`O_U/(f₁, …, f_{i-1})` is monic for every `i`.  This file shows that at every point of `U` the
germs of the `f_i` form a weakly regular sequence in the local ring, and deduces that a regular
ideal sheaf has, at each point of the support of its quotient, a stalk generated by a regular
sequence of that local ring.

This is the regular-sequence counterpart of the two germ bridges of
`StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Regular`,
`isKoszulSequenceExactOn_iff_forall_germ_isKoszulRegular` and
`isKoszulSequenceExactOn_iff_forall_germ_isH1Regular`: it turns the sheaf-level condition of
Stacks tag 063D into commutative algebra in the stalks, which is how the source argues
throughout Section 31.21.

## Main results

* `germ_mem_Jid_precedingGerms_iff`: a section has its germ at `y` in the ideal generated by the
  germs of `f₁, …, f_{i-1}` exactly when some restriction of it lies in the ideal subsheaf those
  sections generate.  This is the dictionary between the sheaf-level `precedingIdeal` of Stacks
  tag 0639 and the ring-level ideal in the stalk.
* `isWeaklyRegular_germFamily_of_isRegularSequenceOn`: the germs of a regular sequence of
  sections form a weakly regular sequence in every local ring over `U`.
* `stalkIdeal_eq_Jid_germFamily`: an ideal sheaf generated over `U` by `f` has stalk at a point
  of `U` the ideal generated by the germs of `f`.
* `exists_isRegular_generating_stalkIdeal`: a regular ideal sheaf has, at a point of the support
  of its quotient whose stalk ideal is proper, a stalk generated by a regular sequence.

## Implementation notes

Monicity of multiplication is a condition on a morphism of presheaves of abelian groups, so it
is sectionwise injectivity (`injective_multiplication_app`, via
`CategoryTheory.NatTrans.mono_iff_mono_app`).  Passing from sections to germs needs no exactness
of filtered colimits: a germ killed by `f_i` is represented by a section whose restriction to a
small enough open is killed by `f_i`, and sectionwise injectivity applies there.  This is why
only one direction is proved here — the converse would additionally need the separatedness of
the sheaf quotient of Stacks tag 0639, which its `RegularSequenceMultiplicationData` does not
expose.

Weak regularity rather than regularity is the conclusion of the germwise statement because
properness of the generated ideal is a condition at the point and not a consequence of the
sequence condition; it is supplied separately, as the hypothesis `hne`, where a genuine regular
sequence is wanted.

The sequence conditions are stated on `X` restricted to `U`, so the germs are compared across
`restrictStalkEquiv` using `restrictStalkEquiv_germSequence`, and the regularity is transported
by `AddEquiv.isWeaklyRegular_congr`.

## References

* [Stacks Project, Definition 31.21.2 (Tag 063D)](https://stacks.math.columbia.edu/tag/063D)
* [Stacks Project, Lemma 31.21.1 (Tag 067P)](https://stacks.math.columbia.edu/tag/067P)
* [Stacks Project, Tag 0639](https://stacks.math.columbia.edu/tag/0639)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open RingTheory.Sequence
open Stacks.RingTheory.QuasiRegular
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.RingedSpace

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

section Preceding

variable (X : RingedSpace.{u}) {n : ℕ} (f : Fin n → X.presheaf.obj (op (⊤ : Opens X)))
  (i : Fin n)

/-- The germs at `y` of the global sections strictly preceding `f i`. -/
noncomputable def precedingGerms (y : X) : Fin i.val → X.presheaf.stalk y :=
  fun j => germSequence X f y ⟨j.val, lt_trans j.isLt i.isLt⟩

/-- The germ of the restriction to an open of a global section `f i` is the germ of `f i`. -/
private theorem germ_res_top_eq_germSequence {V : Opens X} {y : X} (hy : y ∈ V) (j : Fin n) :
    X.presheaf.germ V y hy (X.presheaf.map (homOfLE le_top).op (f j)) = germSequence X f y j := by
  rw [TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE le_top) y hy (f j)]
  rfl

/-- A section of an open `V` has its germ at `y` in the ideal generated by the germs of the
sections preceding `f i` exactly when, after restriction to some neighbourhood of `y`, it lies
in the ideal subsheaf generated by those sections. -/
theorem germ_mem_Jid_precedingGerms_iff (V : Opens X) (y : X) (hy : y ∈ V)
    (s : X.presheaf.obj (op V)) :
    X.presheaf.germ V y hy s ∈ Jid (precedingGerms X f i y) ↔
      ∃ (W : Opens X) (_ : y ∈ W) (hWV : W ≤ V),
        X.presheaf.map (homOfLE hWV).op s ∈ precedingIdeal X f i W := by
  classical
  constructor
  · intro hmem
    obtain ⟨cc, hcc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
    obtain ⟨V₀, hyV₀, b, hb⟩ := exists_nhds_germ_eq (Finset.univ : Finset (Fin i.val)) y cc
    have hyW₀ : y ∈ V ⊓ V₀ := ⟨hy, hyV₀⟩
    set dd : X.presheaf.obj (op (V ⊓ V₀)) :=
      X.presheaf.map (homOfLE (inf_le_left (a := V) (b := V₀))).op s -
        ∑ j, X.presheaf.map (homOfLE (inf_le_right (a := V) (b := V₀))).op (b j) *
          X.presheaf.map (homOfLE (le_top (a := V ⊓ V₀))).op
            (f ⟨j.val, lt_trans j.isLt i.isLt⟩) with hdd
    have hgerm : X.presheaf.germ (V ⊓ V₀) y hyW₀ dd = 0 := by
      rw [hdd, map_sub, map_sum, sub_eq_zero,
        TopCat.Presheaf.germ_res_apply X.presheaf
          (homOfLE (inf_le_left (a := V) (b := V₀))) y hyW₀ s, ← hcc]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul,
        TopCat.Presheaf.germ_res_apply X.presheaf
          (homOfLE (inf_le_right (a := V) (b := V₀))) y hyW₀ (b j),
        hb j (Finset.mem_univ j), germ_res_top_eq_germSequence]
      rfl
    obtain ⟨W, hyW, hWW₀, hdW⟩ :=
      exists_nhds_eq_zero_of_germ_eq_zero (V ⊓ V₀) dd y hyW₀ hgerm
    refine ⟨W, hyW, hWW₀.trans (inf_le_left (a := V) (b := V₀)), ?_⟩
    intro x hx
    refine ⟨W, hx, le_rfl, fun j =>
      X.presheaf.map (homOfLE (hWW₀.trans (inf_le_right (a := V) (b := V₀)))).op (b j), ?_⟩
    rw [hdd, map_sub, map_sum, sub_eq_zero] at hdW
    have hres : X.presheaf.map (homOfLE (le_refl W)).op
        (X.presheaf.map (homOfLE (hWW₀.trans (inf_le_left (a := V) (b := V₀)))).op s) =
          X.presheaf.map (homOfLE (hWW₀.trans (inf_le_left (a := V) (b := V₀)))).op s := by
      rw [AlgebraicGeometry.res_res]
    rw [hres, ← AlgebraicGeometry.res_res X V (V ⊓ V₀) W
      (inf_le_left (a := V) (b := V₀)) hWW₀ s, hdW]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_mul, AlgebraicGeometry.res_res, AlgebraicGeometry.res_res]
  · rintro ⟨W, hyW, hWV, hmem⟩
    obtain ⟨V', hyV', hV'W, a, ha⟩ := hmem y hyW
    have hgerm : X.presheaf.germ V y hy s =
        X.presheaf.germ V' y hyV'
          (X.presheaf.map (homOfLE (hV'W.trans hWV)).op s) := by
      rw [TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (hV'W.trans hWV)) y hyV' s]
    rw [hgerm, ← AlgebraicGeometry.res_res X V W V' hWV hV'W s, ha, map_sum]
    refine Ideal.sum_mem _ fun j _ => ?_
    rw [map_mul]
    exact Ideal.mul_mem_left _ _
      (Ideal.subset_span ⟨j, (germ_res_top_eq_germSequence X f hyV' _).symm⟩)

end Preceding

section Algebra

/-- An element acts regularly on the quotient of a ring by an ideal exactly when it reflects
membership in that ideal. -/
theorem isSMulRegular_quotient_of_mem_of_mul_mem {R : Type u} [CommRing R] (I : Ideal R) (a : R)
    (h : ∀ b : R, a * b ∈ I → b ∈ I) :
    IsSMulRegular (R ⧸ (I • (⊤ : Submodule R R))) a := by
  have hI : I • (⊤ : Submodule R R) = I := by simp
  intro x y hxy
  obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective (I • (⊤ : Submodule R R)) x
  obtain ⟨c, rfl⟩ := Submodule.Quotient.mk_surjective (I • (⊤ : Submodule R R)) y
  have hmem : a • b - a • c ∈ I • (⊤ : Submodule R R) :=
    (Submodule.Quotient.eq _).mp hxy
  rw [hI, smul_eq_mul, smul_eq_mul, ← mul_sub] at hmem
  have hbc : b - c ∈ I • (⊤ : Submodule R R) := by
    rw [hI]
    exact h (b - c) hmem
  exact (Submodule.Quotient.eq _).mpr hbc

end Algebra

section Mono

variable (X : RingedSpace.{u}) {n : ℕ} (f : Fin n → X.presheaf.obj (op (⊤ : Opens X)))
  (i : Fin n)

/-- Monicity of the multiplication endomorphism of `O_X/(f₀, …, f_{i-1})` is injectivity of
each of its components, because monomorphisms of presheaves of abelian groups are exactly the
sectionwise injective ones. -/
theorem injective_multiplication_app
    (h : Mono (regularSequenceMultiplication X f i).multiplication) (W : Opens X) :
    Function.Injective
      ((regularSequenceMultiplication X f i).multiplication.app (op W)) := by
  have : Mono ((regularSequenceMultiplication X f i).multiplication.app (op W)) := inferInstance
  exact (AddCommGrpCat.mono_iff_injective _).mp this

/-- **The germwise content of a regular sequence of sections.** If multiplication by `f i` on
`O_X/(f₀, …, f_{i-1})` is monic, then at every point the germ of `f i` reflects membership in
the ideal generated by the germs of the preceding sections. -/
theorem mem_Jid_precedingGerms_of_mul_mem
    (h : Mono (regularSequenceMultiplication X f i).multiplication) (y : X)
    (b : X.presheaf.stalk y) (hb : germSequence X f y i * b ∈ Jid (precedingGerms X f i y)) :
    b ∈ Jid (precedingGerms X f i y) := by
  obtain ⟨V, hyV, t, rfl⟩ := X.presheaf.exists_germ_eq b
  set D := regularSequenceMultiplication X f i
  have key : germSequence X f y i * X.presheaf.germ V y hyV t =
      X.presheaf.germ V y hyV
        (X.presheaf.map (homOfLE (le_top (a := V))).op (f i) * t) := by
    rw [map_mul, germ_res_top_eq_germSequence]
  rw [key] at hb
  obtain ⟨W, hyW, hWV, hmem⟩ :=
    (germ_mem_Jid_precedingGerms_iff X f i V y hyV _).mp hb
  have hsplit : X.presheaf.map (homOfLE hWV).op
        (X.presheaf.map (homOfLE (le_top (a := V))).op (f i) * t) =
      X.presheaf.map (homOfLE (le_top (a := W))).op (f i) *
        X.presheaf.map (homOfLE hWV).op t := by
    rw [map_mul, AlgebraicGeometry.res_res]
  rw [hsplit] at hmem
  have hzero : D.quotientMap W
      (X.presheaf.map (homOfLE (le_top (a := W))).op (f i) *
        X.presheaf.map (homOfLE hWV).op t) = 0 :=
    (D.quotientMap_eq_zero_iff W _).mpr ((D.mem_precedingIdeal_iff W _).mpr hmem)
  rw [← D.multiplication_quotientMap W (X.presheaf.map (homOfLE hWV).op t)] at hzero
  have h0 : D.quotientMap W (X.presheaf.map (homOfLE hWV).op t) = 0 := by
    refine injective_multiplication_app X f i h W ?_
    rw [hzero, map_zero]
  exact (germ_mem_Jid_precedingGerms_iff X f i V y hyV t).mpr
    ⟨W, hyW, hWV, (D.mem_precedingIdeal_iff W _).mp ((D.quotientMap_eq_zero_iff W _).mp h0)⟩

/-- The ideal generated by a finite list of elements is the ideal generated by the range of the
function the list enumerates. -/
theorem ideal_ofList_ofFn {R : Type u} [CommRing R] {m : ℕ} (g : Fin m → R) :
    Ideal.ofList (List.ofFn g) = Ideal.span (Set.range g) := by
  unfold Ideal.ofList
  congr 1
  ext a
  simp

/-- **The germs of a regular sequence of global sections form a weakly regular sequence.** At
every point of the space, the germs of `f₀, …, f_{r-1}` are a weakly regular sequence in the
local ring, because monicity of multiplication by `f i` on `O_X/(f₀, …, f_{i-1})` descends to
the stalks. -/
theorem isWeaklyRegular_germSequence_of_forall_mono
    (h : ∀ i, Mono (regularSequenceMultiplication X f i).multiplication) (y : X) :
    IsWeaklyRegular (X.presheaf.stalk y) (List.ofFn (germSequence X f y)) := by
  rw [isWeaklyRegular_iff]
  intro k hk
  rw [List.length_ofFn] at hk
  set i : Fin n := ⟨k, hk⟩ with hi
  have hlist : List.take k (List.ofFn (germSequence X f y)) =
      List.ofFn (precedingGerms X f i y) :=
    (Fin.ofFn_take_eq_take_ofFn hk.le (germSequence X f y)).symm
  have hideal : Ideal.ofList (List.take k (List.ofFn (germSequence X f y))) =
      Jid (precedingGerms X f i y) := by
    rw [hlist, ideal_ofList_ofFn]
    rfl
  have hget : (List.ofFn (germSequence X f y))[k] = germSequence X f y i := by
    simp [hi]
  rw [hideal, hget]
  exact isSMulRegular_quotient_of_mem_of_mul_mem _ _
    (mem_Jid_precedingGerms_of_mul_mem X f i (h i) y)

end Mono

section Germs

/-- **The germwise form of Stacks tag 063D, part (1).** If the sections `f₀, …, f_{r-1}` of an
open `U` form a regular sequence in the sense of Stacks tag 063D, then at every point of `U`
their germs form a weakly regular sequence in the local ring there.

This is the regular-sequence counterpart of
`isKoszulSequenceExactOn_iff_forall_germ_isKoszulRegular`: it turns the sheaf-level condition
into commutative algebra in the stalks. -/
theorem isWeaklyRegular_germFamily_of_isRegularSequenceOn (X : RingedSpace.{u}) (U : Opens X)
    {r : ℕ} (f : Fin r → X.presheaf.obj (op U)) (h : IsRegularSequenceOn X U f)
    (y : X) (hy : y ∈ U) :
    IsWeaklyRegular (X.presheaf.stalk y) (List.ofFn (germFamily X U f y hy)) := by
  have hY := isWeaklyRegular_germSequence_of_forall_mono
    (X.restrict U.isOpenEmbedding) (fun j => sectionOnRestriction X U (f j)) h ⟨y, hy⟩
  set e := restrictStalkEquiv X U y hy
  have hmap : List.ofFn (germFamily X U f y hy) =
      List.map e (List.ofFn
        (germSequence (X.restrict U.isOpenEmbedding)
          (fun j => sectionOnRestriction X U (f j)) ⟨y, hy⟩)) := by
    rw [List.map_ofFn]
    exact congrArg List.ofFn
      (funext fun j => (restrictStalkEquiv_germSequence X U f y hy j).symm)
  refine (AddEquiv.isWeaklyRegular_congr (e := e.toAddEquiv) ?_).mp hY
  rw [hmap, List.forall₂_map_right_iff]
  refine List.forall₂_same.mpr fun a _ x => ?_
  show e.toAddEquiv (a * x) = e a * e.toAddEquiv x
  exact map_mul e a x

end Germs

section IdealSheaf

variable {X : LocallyRingedSpace.{u}}
  (J : (structureSheafModule X.toRingedSpace).Submodule) (U : Opens X) {r : ℕ}
  (f : Fin r → X.presheaf.obj (op U))

/-- At a point of `U`, the stalk of an ideal subsheaf generated over `U` by the sections `f` is
the ideal of the local ring generated by the germs of those sections. -/
theorem stalkIdeal_eq_Jid_germFamily (hgen : IsGeneratedByOn X.toRingedSpace J U f)
    (y : X) (hy : y ∈ U) :
    Stacks.RingedSpace.stalkIdeal J y = Jid (germFamily X.toRingedSpace U f y hy) := by
  apply le_antisymm
  · rw [Stacks.RingedSpace.stalkIdeal, Ideal.span_le]
    rintro a ⟨V, hyV, s, hs, rfl⟩
    have hyV' : y ∈ V ⊓ U := ⟨hyV, hy⟩
    have hs' : X.presheaf.map (homOfLE (inf_le_left (a := V) (b := U))).op s ∈
        (generatedIdealOn X.toRingedSpace U f).obj (op (V ⊓ U)) := by
      rw [← hgen (V ⊓ U) (inf_le_right (a := V) (b := U))]
      exact J.map_mem (homOfLE (inf_le_left (a := V) (b := U))).op hs
    have hgermeq := (mem_generatedIdealOn_iff U f (V ⊓ U)
      (inf_le_right (a := V) (b := U)) _).mp hs' y hyV'
    rwa [TopCat.Presheaf.germ_res_apply X.presheaf
      (homOfLE (inf_le_left (a := V) (b := U))) y hyV' s] at hgermeq
  · rw [Jid, Ideal.span_le]
    rintro a ⟨i, rfl⟩
    refine Ideal.subset_span ⟨U, hy, f i, ?_, rfl⟩
    rw [hgen U le_rfl]
    exact mem_generatedIdealOn X.toRingedSpace U f i

/-- **The stalk of an ideal sheaf with a regular generating sequence.** A regular generating
sequence over an open `U` has, at every point of `U`, germs generating the stalk of the ideal
sheaf and forming a weakly regular sequence in the local ring. -/
theorem exists_isWeaklyRegular_generating_stalkIdeal_of_generators
    (hreg : IsRegularSequenceOn X.toRingedSpace U f)
    (hgen : IsGeneratedByOn X.toRingedSpace J U f) (y : X) (hy : y ∈ U) :
    ∃ rs : List (X.presheaf.stalk y),
      IsWeaklyRegular (X.presheaf.stalk y) rs ∧
        Ideal.ofList rs = Stacks.RingedSpace.stalkIdeal J y := by
  refine ⟨List.ofFn (germFamily X.toRingedSpace U f y hy),
    isWeaklyRegular_germFamily_of_isRegularSequenceOn _ U f hreg y hy, ?_⟩
  rw [ideal_ofList_ofFn, stalkIdeal_eq_Jid_germFamily J U f hgen y hy]
  rfl

/-- The same conclusion with a genuine regular sequence, which needs the stalk of the ideal
sheaf to be a proper ideal. -/
theorem exists_isRegular_generating_stalkIdeal_of_generators
    (hreg : IsRegularSequenceOn X.toRingedSpace U f)
    (hgen : IsGeneratedByOn X.toRingedSpace J U f) (y : X) (hy : y ∈ U)
    (hne : Stacks.RingedSpace.stalkIdeal J y ≠ ⊤) :
    ∃ rs : List (X.presheaf.stalk y),
      IsRegular (X.presheaf.stalk y) rs ∧
        Ideal.ofList rs = Stacks.RingedSpace.stalkIdeal J y := by
  obtain ⟨rs, hw, hspan⟩ :=
    exists_isWeaklyRegular_generating_stalkIdeal_of_generators J U f hreg hgen y hy
  refine ⟨rs, (isRegular_iff _ _).mpr ⟨hw, ?_⟩, hspan⟩
  intro htop
  rw [show Ideal.ofList rs • (⊤ : Submodule (X.presheaf.stalk y) (X.presheaf.stalk y)) =
    Ideal.ofList rs by simp] at htop
  exact hne (hspan ▸ htop.symm)

/-- **A regular ideal sheaf has stalks generated by weakly regular sequences.** At a point of
the support of `O_X/J`, the stalk `J_x` is generated by the germs of a regular generating
sequence, and those germs form a weakly regular sequence in the local ring. -/
theorem exists_isWeaklyRegular_generating_stalkIdeal
    (h : IsRegularIdealSheaf X.toRingedSpace J) (x : X)
    (hx : x ∈ idealQuotientSupport X.toRingedSpace J) :
    ∃ rs : List (X.presheaf.stalk x),
      IsWeaklyRegular (X.presheaf.stalk x) rs ∧
        Ideal.ofList rs = Stacks.RingedSpace.stalkIdeal J x := by
  obtain ⟨V, hxV, s, g, hreg, hgen⟩ := h x hx
  exact exists_isWeaklyRegular_generating_stalkIdeal_of_generators J V g hreg hgen x hxV

/-- **A regular ideal sheaf whose stalk is proper has that stalk generated by a regular
sequence.** This is the form the local-ring statements of Stacks tag 063I and its consumers
take: a genuine regular sequence, not merely a weakly regular one. -/
theorem exists_isRegular_generating_stalkIdeal
    (h : IsRegularIdealSheaf X.toRingedSpace J) (x : X)
    (hx : x ∈ idealQuotientSupport X.toRingedSpace J)
    (hne : Stacks.RingedSpace.stalkIdeal J x ≠ ⊤) :
    ∃ rs : List (X.presheaf.stalk x),
      IsRegular (X.presheaf.stalk x) rs ∧
        Ideal.ofList rs = Stacks.RingedSpace.stalkIdeal J x := by
  obtain ⟨V, hxV, s, g, hreg, hgen⟩ := h x hx
  exact exists_isRegular_generating_stalkIdeal_of_generators J V g hreg hgen x hxV hne

end IdealSheaf

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
