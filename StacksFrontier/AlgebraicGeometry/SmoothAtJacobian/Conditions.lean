module

public import Mathlib.Algebra.Category.ModuleCat.Stalk
public import Mathlib.AlgebraicGeometry.Fiber
public import Mathlib.Data.List.TFAE
public import Mathlib.RingTheory.Extension.Presentation.Submersive
public import Mathlib.RingTheory.RingHom.Flat
public import StacksFrontier.AlgebraicGeometry.Morphisms.Differentials.Relative
public import StacksFrontier.AlgebraicGeometry.Morphisms.Smooth.Defs
public import StacksFrontier.AlgebraicGeometry.Smooth.InfinitesimalLifting
public import StacksFrontier.Topology.Dimension.Krull

/-!
# The six characterizations of smoothness at a point

Stacks Tag 01V9 asserts, for a morphism of schemes locally of finite presentation and a point
of its source, the equivalence of six conditions: smoothness at the point; flatness of the
induced map of local rings together with smoothness of the scheme-theoretic fibre; two numerical
conditions on the relative differentials, one on their stalk and one on its residue-field fibre;
the existence of an affine neighbourhood over an affine open of the base on which the morphism
is standard smooth; and the existence of an affine presentation whose chosen Jacobian minor does
not vanish at the point.

**This file only states the six conditions.**  It names each of them separately, so that the
implications between them can be proved and recorded one at a time, and collects them in the
order the source uses.  `StacksFrontier.AlgebraicGeometry.SmoothAtJacobian.Jacobian` proves the
equivalence of the first, the fifth and the sixth.

## Main definitions

* `Stacks.SmoothAtJacobian.GeneratedByAtMost`: a module admits a finite generating set whose
  cardinality is bounded by a given extended natural number.
* `Stacks.SmoothAtJacobian.relativeDifferentialStalk`, with its module structure
  `relativeDifferentialStalkModule`: the stalk at the point of the sheaf of relative
  differentials.
* `Stacks.SmoothAtJacobian.relativeCotangentSpace`: the residue-field fibre of that stalk, and
  `fiberRelativeCotangentSpace` the corresponding space computed on the scheme-theoretic fibre.
* `Stacks.SmoothAtJacobian.IsFiberDifferentialsTensorEquiv` and
  `FiberDifferentialsTensorIdentification`: the specification of the canonical comparison between
  those two spaces, and the data of a comparison satisfying it together with its uniqueness.
  These are the vocabulary of the displayed equality in condition (4) of the source.
* `Stacks.SmoothAtJacobian.Condition1` through `Condition6`: the six conditions.
* `Stacks.SmoothAtJacobian.conditions`: the six conditions as a list, in the source's order.

## Implementation notes

Conditions (3) and (4) are stated with the actual stalk of the universal sheaf of relative
differentials, `AlgebraicGeometry.Scheme.Hom.relativeDifferentials`, which is the representing
object for relative derivations of the structure sheaf along
`AlgebraicGeometry.inverseImageStructureMap`.  Its module structure over the stalk of the
structure sheaf is the one Mathlib puts on the stalk of a presheaf of modules; instance search
does not find it through the definition `AlgebraicGeometry.Scheme.Modules`, so
`relativeDifferentialStalkModule` names it.

The displayed equality in condition (4) of the source is an equality of modules, which is not a
statement Lean can carry; it is represented here by the existence of a unique linear equivalence
subject to a specification on germs of universal differentials.  Both cotangent spaces are
extended to the residue field of the point; on the fibre side that scalar structure comes from
the canonical residue-field point `AlgebraicGeometry.Scheme.Hom.asFiberHom`.

Condition (6) records a pre-submersive presentation, which carries the quotient presentation
together with the injection selecting the variables used for the Jacobian minor.  This is the
invariant form of the source's choice of the first `c` of the `n` variables.

## References

* [Stacks Project, Tag 01V9](https://stacks.math.columbia.edu/tag/01V9)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped TensorProduct

universe u v

namespace Stacks.SmoothAtJacobian

/-- A module can be generated by at most `d` elements if it has a finite generating set whose
cardinality is at most `d`. -/
public abbrev GeneratedByAtMost (R : Type u) (M : Type v)
    [Semiring R] [AddCommMonoid M] [Module R M] (d : WithBot ℕ∞) : Prop :=
  ∃ s : Finset M, Submodule.span R (s : Set M) = ⊤ ∧
    (s.card : WithBot ℕ∞) ≤ d

/-- The stalk of the sheaf of relative differentials at `x`. -/
public noncomputable abbrev relativeDifferentialStalk {X S : Scheme.{u}}
    (f : X ⟶ S) (x : X) : Type u :=
  (Scheme.Hom.relativeDifferentials f).presheaf.stalk x

/-- The local-ring module structure on the stalk of relative differentials. -/
public noncomputable abbrev relativeDifferentialStalkModule {X S : Scheme.{u}}
    (f : X ⟶ S) (x : X) :
    Module (X.presheaf.stalk x) (relativeDifferentialStalk f x) :=
  PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
    (Scheme.Hom.relativeDifferentials f).val x

/-- The fibre at `x` of the stalk of the sheaf of relative differentials. -/
public noncomputable def relativeCotangentSpace {X S : Scheme.{u}}
    (f : X ⟶ S) (x : X) : ModuleCat.{u} (X.residueField x) := by
  let Ω := relativeDifferentialStalk f x
  letI := relativeDifferentialStalkModule f x
  letI : Algebra (X.presheaf.stalk x) (X.residueField x) :=
    (X.residue x).hom.toAlgebra
  exact ModuleCat.of _ (X.residueField x ⊗[X.presheaf.stalk x] Ω)

/-- The fibre at the canonical point of the relative differentials of the scheme-theoretic
fibre, with scalars extended to `κ(x)`. -/
public noncomputable def fiberRelativeCotangentSpace {X S : Scheme.{u}}
    (f : X ⟶ S) (x : X) : ModuleCat.{u} (X.residueField x) := by
  let Xs := f.fiber (f x)
  let xf := f.asFiberHom x (IsLocalRing.closedPoint (X.residueField x))
  let g := f.fiberToSpecResidueField (f x)
  let Ω := relativeDifferentialStalk g xf
  letI := relativeDifferentialStalkModule g xf
  letI : Algebra (Xs.presheaf.stalk xf) (X.residueField x) :=
    (Scheme.stalkClosedPointTo (f.asFiberHom x)).hom.toAlgebra
  exact ModuleCat.of _ (X.residueField x ⊗[Xs.presheaf.stalk xf] Ω)

/-- A comparison between the two cotangent spaces is the canonical one when it carries the germ
of the universal differential of every local section to the germ of the universal differential
of its pullback to the fibre. -/
public def IsFiberDifferentialsTensorEquiv {X S : Scheme.{u}} (f : X ⟶ S) (x : X)
    (e : relativeCotangentSpace f x ≅ fiberRelativeCotangentSpace f x) : Prop :=
  ∀ (U : X.Opens) (hxU : x ∈ U) (a : X.presheaf.obj (.op U)),
    let i := f.fiberι (f x)
    let Uf := i ⁻¹ᵁ U
    let xf := f.asFiberHom x (IsLocalRing.closedPoint (X.residueField x))
    let hxf : xf ∈ Uf := by
      change i xf ∈ U
      have hi : i xf = x := by
        change (f.asFiberHom x ≫ f.fiberι (f x))
          (IsLocalRing.closedPoint (X.residueField x)) = x
        rw [Scheme.Hom.asFiberHom_fiberι]
        exact Scheme.fromSpecResidueField_apply x _
      exact hi.symm ▸ hxU
    let Ω := relativeDifferentialStalk f x
    let Ωf := relativeDifferentialStalk (f.fiberToSpecResidueField (f x)) xf
    letI := relativeDifferentialStalkModule f x
    letI := relativeDifferentialStalkModule (f.fiberToSpecResidueField (f x)) xf
    letI : Algebra (X.presheaf.stalk x) (X.residueField x) :=
      (X.residue x).hom.toAlgebra
    letI : Algebra ((f.fiber (f x)).presheaf.stalk xf) (X.residueField x) :=
      (Scheme.stalkClosedPointTo (f.asFiberHom x)).hom.toAlgebra
    e.hom.hom (TensorProduct.tmul (X.presheaf.stalk x)
        1 (show Ω from
          ((TopCat.Presheaf.germ
            (SheafOfModules.moduleOfDifferentials
              (inverseImageStructureMap f)).val.presheaf U x hxU)).hom
            ((SheafOfModules.universalDerivation (inverseImageStructureMap f)).d a))) =
      TensorProduct.tmul ((f.fiber (f x)).presheaf.stalk xf)
        1 (show Ωf from ((TopCat.Presheaf.germ
          (SheafOfModules.moduleOfDifferentials
            (inverseImageStructureMap
              (f.fiberToSpecResidueField (f x)))).val.presheaf Uf xf hxf)).hom
          ((SheafOfModules.universalDerivation
            (inverseImageStructureMap
              (f.fiberToSpecResidueField (f x)))).d ((i.app U).hom a)))

/-- The canonical identification of the two relative cotangent spaces, together with its
universal-differential characterization and uniqueness. -/
public structure FiberDifferentialsTensorIdentification
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) where
  /-- The comparison isomorphism. -/
  equiv : relativeCotangentSpace f x ≅ fiberRelativeCotangentSpace f x
  /-- The comparison carries universal differentials to universal differentials. -/
  isCanonical : IsFiberDifferentialsTensorEquiv f x equiv
  /-- The universal-differential specification uniquely determines the comparison. -/
  unique (e : relativeCotangentSpace f x ≅ fiberRelativeCotangentSpace f x) :
    IsFiberDifferentialsTensorEquiv f x e → e = equiv

variable {X S : Scheme.{u}} (f : X ⟶ S) (x : X)

/-- Condition (1) of the source: `f` is smooth at `x`. -/
public def Condition1 : Prop :=
  InfinitesimalLifting.SmoothAt f x

/-- Condition (2) of the source: the induced map of local rings is flat, and the
scheme-theoretic fibre through `x` is smooth at `x`. -/
public def Condition2 : Prop :=
  (f.stalkMap x).hom.Flat ∧
    InfinitesimalLifting.SmoothAt (f.fiberToSpecResidueField (f x)) (f.asFiber x)

/-- Condition (3) of the source: the induced map of local rings is flat, and the stalk of the
relative differentials is generated over the local ring by at most `dim_x` elements. -/
public def Condition3 : Prop :=
  (f.stalkMap x).hom.Flat ∧
    (let B := X.presheaf.stalk x
     let Ω := relativeDifferentialStalk f x
     letI := relativeDifferentialStalkModule f x
     GeneratedByAtMost B Ω (topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x)))

/-- Condition (4) of the source: the induced map of local rings is flat, and the residue-field
fibre of the relative differentials is generated by at most `dim_x` elements. -/
public def Condition4 : Prop :=
  (f.stalkMap x).hom.Flat ∧
    (let k := X.residueField x
     GeneratedByAtMost k (relativeCotangentSpace f x)
       (topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x)))

/-- Condition (5) of the source: there are affine open neighbourhoods of `x` and of its image on
which `f` restricts to a standard smooth morphism. -/
public def Condition5 : Prop :=
  ∃ (U : X.affineOpens) (V : S.affineOpens) (_ : x ∈ U.1)
      (hUV : U.1 ≤ f ⁻¹ᵁ V.1),
    AlgebraicGeometry.IsStandardSmooth (f.resLE V.1 U.1 hUV)

/-- Condition (6) of the source: there are affine open neighbourhoods of `x` and of its image,
and a presentation of the sections over the former as an algebra over the sections over the
latter, whose chosen Jacobian minor does not vanish at `x`. -/
public def Condition6 : Prop :=
  ∃ (U : X.affineOpens) (V : S.affineOpens) (hxU : x ∈ U.1)
      (hUV : U.1 ≤ f ⁻¹ᵁ V.1),
    letI : Algebra Γ(S, V.1) Γ(X, U.1) := (f.appLE V U hUV).hom.toAlgebra
    ∃ (n c : ℕ) (P : Algebra.PreSubmersivePresentation
        Γ(S, V.1) Γ(X, U.1) (Fin n) (Fin c)),
      P.jacobian ∉ (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal

/-- The six conditions of the source, in its order.  Tag 01V9 is the assertion that this list is
`List.TFAE` whenever `f` is locally of finite presentation. -/
public def conditions : List Prop :=
  [Condition1 f x, Condition2 f x, Condition3 f x,
    Condition4 f x, Condition5 f x, Condition6 f x]

end Stacks.SmoothAtJacobian

end
