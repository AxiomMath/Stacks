module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.PullbackFree
public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.CategoryTheory.Adjunction.Limits
public import StacksFrontier.AlgebraicGeometry.Descent.FpqcQuasicoherent
public import StacksFrontier.AlgebraicGeometry.CoherentTFAE.Basic
public import StacksFrontier.AlgebraicGeometry.QcohLimits.Basic

/-!
# Kernels of maps from finite free modules on affine opens

On the spectrum of a Noetherian ring, and more generally on the slice site at an affine open of
a locally Noetherian scheme, the kernel of a morphism from a finite free module to a
quasi-coherent module is generated by finitely many sections.

## Main definitions

All declarations are in the namespace `Stacks.AlgebraicGeometry.CoherenceCriteria`.

* `generatingSectionsOfEquivalence`: generating sections pulled back along an equivalence of
  categories of sheaves of modules.
* `restrictEquiv`: restriction along an isomorphism of schemes, as an equivalence of categories of
  modules.
* `specEquiv`: the equivalence between sheaves of modules on the slice site at an affine open `V`
  and modules on `Spec Γ(X, V)`.

## Main results

* `exists_finite_generatingSections_kernel`: on the spectrum of a Noetherian ring, the kernel of a
  morphism of quasi-coherent modules whose source has finitely generated global sections is
  generated by finitely many global sections.
* `exists_finite_generatingSections_kernel_of_isAffineOpen`: on a locally Noetherian scheme, the
  kernel of a morphism from a finite free module to the restriction of a quasi-coherent module to
  the slice site at an affine open is generated by finitely many sections.
-/

@[expose] public section

open CategoryTheory Limits SheafOfModules TopologicalSpace
open AlgebraicGeometry

universe u

namespace Stacks.AlgebraicGeometry.CoherenceCriteria

/-! ### Transport along an equivalence of categories of sheaves of modules -/

section Equivalence

variable {C D : Type u} [Category.{u, u} C] [Category.{u, u} D]
  {J : GrothendieckTopology C} {K : GrothendieckTopology D}
  {R : Sheaf J RingCat.{u}} {S : Sheaf K RingCat.{u}}
  [HasWeakSheafify J AddCommGrpCat.{u}] [HasWeakSheafify K AddCommGrpCat.{u}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}] [K.WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- Generating sections pulled back along an equivalence of categories of sheaves of modules
which matches up the finite free objects. -/
noncomputable def generatingSectionsOfEquivalence (E : SheafOfModules.{u} R ≌ SheafOfModules.{u} S)
    (hfree : ∀ I : Type u, free.{u} I ≅ E.inverse.obj (free.{u} I))
    {M : SheafOfModules.{u} R} (G : (E.functor.obj M).GeneratingSections) :
    M.GeneratingSections :=
  letI : E.inverse.IsLeftAdjoint := inferInstance
  letI : E.inverse.PreservesEpimorphisms := inferInstance
  letI p : free.{u} G.I ⟶ M :=
    (hfree G.I).hom ≫ E.inverse.map G.π ≫ (E.unitIso.app M).inv
  haveI : Epi p := by dsimp [p]; infer_instance
  (free.generatingSections (R := R) G.I).ofEpi p

/-- The index type of `generatingSectionsOfEquivalence E hfree G` is that of `G`. -/
@[simp]
theorem generatingSectionsOfEquivalence_I (E : SheafOfModules.{u} R ≌ SheafOfModules.{u} S)
    (hfree : ∀ I : Type u, free.{u} I ≅ E.inverse.obj (free.{u} I))
    {M : SheafOfModules.{u} R} (G : (E.functor.obj M).GeneratingSections) :
    (generatingSectionsOfEquivalence E hfree G).I = G.I := rfl

/-- An identification of the finite free objects under the functor of an equivalence gives one
under its inverse. -/
noncomputable def freeInverseIso (E : SheafOfModules.{u} R ≌ SheafOfModules.{u} S)
    (h : ∀ I : Type u, E.functor.obj (free.{u} I) ≅ free.{u} I) (I : Type u) :
    free.{u} I ≅ E.inverse.obj (free.{u} I) :=
  E.unitIso.app (free.{u} I) ≪≫ E.inverse.mapIso (h I)

end Equivalence

/-! ### The affine core -/

/-- The global sections of a finite free module on a spectrum. -/
noncomputable def gammaFreeIso {A : CommRingCat.{u}} (I : Type u) :
    moduleSpecΓFunctor.obj (free I : (Spec A).Modules) ≅ ModuleCat.of A (I →₀ A) :=
  moduleSpecΓFunctor.mapIso (tildeFinsupp (R := A) I).symm ≪≫
    ((tilde.toTildeΓNatIso (R := A)).app (ModuleCat.of A (I →₀ A))).symm

/-- The global sections of a finite free module on a spectrum form a finite module. -/
theorem finite_gammaFree {A : CommRingCat.{u}} (I : Type u) [Finite I] :
    Module.Finite A (moduleSpecΓFunctor.obj (free I : (Spec A).Modules)) :=
  Module.Finite.equiv (gammaFreeIso (A := A) I).symm.toLinearEquiv

/-- On the spectrum of a Noetherian ring, the kernel of a morphism of quasi-coherent modules
whose source has finitely generated global sections is generated by finitely many global
sections. -/
theorem exists_finite_generatingSections_kernel {A : CommRingCat.{u}} [IsNoetherianRing A]
    {P G : (Spec A).Modules} [P.IsQuasicoherent] [G.IsQuasicoherent]
    (hP : Module.Finite A (moduleSpecΓFunctor.obj P)) (ψ : P ⟶ G) :
    ∃ σ : (kernel ψ).GeneratingSections, Finite σ.I := by
  have : (moduleSpecΓFunctor (R := A)).IsRightAdjoint := tilde.adjunction.isRightAdjoint
  have := isNoetherian_of_injective (moduleSpecΓFunctor.map (kernel.ι ψ)).hom
    ((ModuleCat.mono_iff_injective _).mp (Functor.map_mono _ (kernel.ι ψ)))
  have : (kernel ψ : (Spec A).Modules).IsQuasicoherent := QcohLimits.isQuasicoherent_kernel ψ
  have hiso : IsIso (kernel ψ : (Spec A).Modules).fromTildeΓ := inferInstance
  obtain ⟨σ, hσ⟩ :=
    CoherentTFAE.exists_finite_generatingSections_tilde (moduleSpecΓFunctor.obj (kernel ψ))
  exact ⟨GeneratingSections.equivOfIso
    (@asIso _ _ _ _ (kernel ψ : (Spec A).Modules).fromTildeΓ hiso) σ, hσ⟩

/-- Let `E` be an equivalence from sheaves of modules to modules on the spectrum of a Noetherian
ring which matches up the finite free objects, and let `M` be such that `E.functor.obj M` is
quasi-coherent. Then the kernel of a morphism `free I ⟶ M` with `I` finite is generated by finitely
many sections. -/
theorem exists_finite_generatingSections_kernel_of_equiv {A : CommRingCat.{u}}
    [IsNoetherianRing A] {C : Type u} [Category.{u, u} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{u}} [HasWeakSheafify J AddCommGrpCat.{u}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    (E : SheafOfModules.{u} R ≌ (Spec A).Modules)
    (hfree : ∀ I : Type u, E.functor.obj (free.{u} I) ≅ free (R := (Spec A).ringCatSheaf) I)
    {M : SheafOfModules.{u} R} (hM : (E.functor.obj M).IsQuasicoherent)
    {I : Type u} [Finite I] (φ : free.{u} I ⟶ M) :
    ∃ σ : (kernel φ).GeneratingSections, Finite σ.I := by
  have hqcP : (E.functor.obj (free.{u} I)).IsQuasicoherent :=
    Stacks.Descent.isQuasicoherent_of_iso (hfree I).symm inferInstance
  have hP : Module.Finite A (moduleSpecΓFunctor.obj (E.functor.obj (free.{u} I))) :=
    have h := finite_gammaFree (A := A) I
    Module.Finite.equiv (moduleSpecΓFunctor.mapIso (hfree I)).toLinearEquiv.symm
  obtain ⟨σ, hσ⟩ := exists_finite_generatingSections_kernel hP (E.functor.map φ)
  exact ⟨generatingSectionsOfEquivalence E (freeInverseIso E hfree)
    (GeneratingSections.equivOfIso (PreservesKernel.iso E.functor φ).symm σ), hσ⟩

/-! ### The spectrum of the ring of sections of an affine open -/

section Scheme

variable {X : Scheme.{u}}

/-- Restriction along an isomorphism of schemes is an equivalence of categories of modules. -/
noncomputable def restrictEquiv {Y Z : Scheme.{u}} (e : Y ≅ Z) : Y.Modules ≌ Z.Modules :=
  haveI : IsOpenImmersion e.hom := IsOpenImmersion.of_isIso e.hom
  haveI : IsOpenImmersion e.inv := IsOpenImmersion.of_isIso e.inv
  CategoryTheory.Equivalence.mk
    (Scheme.Modules.restrictFunctor e.inv)
    (Scheme.Modules.restrictFunctor e.hom)
    (Scheme.Modules.restrictFunctorId.symm ≪≫
      Scheme.Modules.restrictFunctorCongr e.hom_inv_id.symm ≪≫
      Scheme.Modules.restrictFunctorComp e.hom e.inv)
    ((Scheme.Modules.restrictFunctorComp e.inv e.hom).symm ≪≫
      Scheme.Modules.restrictFunctorCongr e.inv_hom_id ≪≫
      Scheme.Modules.restrictFunctorId)

/-- Restriction along an open immersion carries a finite free module to a finite free module. -/
noncomputable def restrictFreeIso {Y Z : Scheme.{u}} (f : Y ⟶ Z) [IsOpenImmersion f]
    (I : Type u) :
    (Scheme.Modules.restrictFunctor f).obj (free.{u} I) ≅ free.{u} I := by
  haveI : (Opens.map f.base).Final := by
    have : (Opens.map f.base).IsRightAdjoint :=
      ⟨_, ⟨f.isOpenEmbedding.isOpenMap.adjunction⟩⟩
    exact Functor.final_of_isRightAdjoint _
  letI : (SheafOfModules.pushforward (Scheme.Hom.toRingCatSheafHom f)).IsRightAdjoint :=
    (Scheme.Modules.pullbackPushforwardAdjunction f).isRightAdjoint
  exact (Scheme.Modules.restrictFunctorIsoPullback f).app (free.{u} I) ≪≫
    SheafOfModules.pullbackObjFreeIso (Scheme.Hom.toRingCatSheafHom f) I

/-- The slice-site reading of a finite free module on an open subscheme. -/
noncomputable def overEquivFreeIso (X : Scheme.{u}) (U : X.Opens) (I : Type u) :
    free (R := (U : Scheme.{u}).ringCatSheaf) I ≅
      (Scheme.Modules.overEquiv U).functor.obj (free (R := X.ringCatSheaf.over U) I) := by
  let F := (Scheme.Modules.overEquiv U).functor
  haveI : PreservesColimitsOfShape.{u, u} (Discrete I) F :=
    Functor.instPreservesColimitsOfShapeOfIsLeftAdjoint.{u, u, u, u + 1, u, u + 1} F
  exact @SheafOfModules.mapFreeIso _ _ _ _ _ _ _ _ _ _ _ _ F I this (Iso.refl _)

/-- The equivalence between sheaves of modules on the slice site at an affine open `V` and
modules on `Spec Γ(X, V)`: the composite of `AlgebraicGeometry.Scheme.Modules.overEquiv` with
restriction along `AlgebraicGeometry.IsAffineOpen.isoSpec`. -/
noncomputable def specEquiv {V : X.Opens} (hV : IsAffineOpen V) :
    SheafOfModules.{u} (X.ringCatSheaf.over V) ≌ (Spec Γ(X, V)).Modules :=
  (Scheme.Modules.overEquiv V).trans (restrictEquiv hV.isoSpec)

/-- Under `specEquiv`, the restriction of `F` to the slice site at `V` is the module
`Stacks.AlgebraicGeometry.CoherentTFAE.specRestrict` on `Spec Γ(X, V)`. -/
noncomputable def specEquivObjIso (F : X.Modules) {V : X.Opens} (hV : IsAffineOpen V) :
    (specEquiv hV).functor.obj (F.over V) ≅ CoherentTFAE.specRestrict F hV :=
  haveI : IsOpenImmersion hV.isoSpec.inv := IsOpenImmersion.of_isIso hV.isoSpec.inv
  (Scheme.Modules.restrictFunctor hV.isoSpec.inv).mapIso
    ((Scheme.Modules.overFunctorEquiv V).app F)

/-- `specEquiv` matches up the finite free modules. -/
noncomputable def specEquivFreeIso {V : X.Opens} (hV : IsAffineOpen V) (I : Type u) :
    (specEquiv hV).functor.obj (free (R := X.ringCatSheaf.over V) I) ≅
      free (R := (Spec Γ(X, V)).ringCatSheaf) I :=
  haveI : IsOpenImmersion hV.isoSpec.inv := IsOpenImmersion.of_isIso hV.isoSpec.inv
  (Scheme.Modules.restrictFunctor hV.isoSpec.inv).mapIso (overEquivFreeIso X V I).symm ≪≫
    restrictFreeIso hV.isoSpec.inv I

/-- Under `specEquiv`, a quasi-coherent module stays quasi-coherent. -/
theorem isQuasicoherent_specEquiv_over (F : X.Modules) [F.IsQuasicoherent] {V : X.Opens}
    (hV : IsAffineOpen V) : ((specEquiv hV).functor.obj (F.over V)).IsQuasicoherent :=
  Stacks.Descent.isQuasicoherent_of_iso (specEquivObjIso F hV).symm inferInstance

/-- On a locally Noetherian scheme, the kernel of a morphism from a finite free module into the
restriction of a quasi-coherent module to the slice site at an affine open is generated by finitely
many sections. -/
theorem exists_finite_generatingSections_kernel_of_isAffineOpen [IsLocallyNoetherian X]
    (F : X.Modules) [F.IsQuasicoherent] {V : X.Opens} (hV : IsAffineOpen V)
    {I : Type u} [Finite I] (φ : free (R := X.ringCatSheaf.over V) I ⟶ F.over V) :
    ∃ σ : (kernel φ).GeneratingSections, Finite σ.I :=
  have : IsNoetherianRing Γ(X, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  exists_finite_generatingSections_kernel_of_equiv (specEquiv hV) (specEquivFreeIso hV)
    (isQuasicoherent_specEquiv_over F hV) φ

end Scheme

end Stacks.AlgebraicGeometry.CoherenceCriteria

end
