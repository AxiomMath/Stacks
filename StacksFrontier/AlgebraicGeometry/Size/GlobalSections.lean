module

public import StacksFrontier.AlgebraicGeometry.Size.Cutoff
public import StacksFrontier.AlgebraicGeometry.Size.FiniteType

/-!
# Global sections of a quasi-compact scheme, and finitely generated subalgebras

Two cardinality bounds used to control the size of the index sets in Noetherian approximation.

## Main results

* `AlgebraicGeometry.Scheme.mk_globalSections_le_size`: for a quasi-compact scheme `X`,
  `#Γ(X, ⊤) ≤ size X`; the global sections embed into the sections over a finite affine cover.
* `AlgebraicGeometry.Scheme.mk_globalSections_le_aleph0`: a quasi-compact scheme of finite type
  over the integers has countably many global sections.
* `Subalgebra.mk_fg_le`: an `R`-algebra `A` has at most `max ℵ₀ #A` finitely generated
  subalgebras.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Cardinal

universe u v w

/-- **An algebra has at most `max ℵ₀ #A` finitely generated subalgebras**: such a subalgebra is
generated by a finite list of elements. -/
theorem Subalgebra.mk_fg_le (R : Type v) (A : Type w) [CommSemiring R] [Semiring A]
    [Algebra R A] : #{S : Subalgebra R A // S.FG} ≤ max ℵ₀ #A := by
  classical
  let enc : {S : Subalgebra R A // S.FG} → List A := fun S => S.2.choose.toList
  have henc : ∀ S, Algebra.adjoin R {a | a ∈ enc S} = S.1 := fun S => by
    simpa [enc] using S.2.choose_spec
  have hinj : Function.Injective enc := fun S T h => Subtype.ext (by rw [← henc S, ← henc T, h])
  exact (mk_le_of_injective hinj).trans (mk_list_le_max A)

namespace AlgebraicGeometry

/-- **The global sections of a quasi-compact scheme are no more numerous than the scheme is
large**: they embed into the product of the sections over finitely many affine opens covering
it, each bounded by the size. -/
theorem Scheme.mk_globalSections_le_size (X : Scheme.{u}) [CompactSpace X] :
    #Γ(X, ⊤) ≤ X.size := by
  classical
  obtain ⟨t, ht⟩ := (isCompact_univ (X := X)).elim_finite_subcover
    (fun U : X.affineOpens => ((U : X.Opens) : Set X)) (fun U => U.1.isOpen)
    (fun x _ => by
      obtain ⟨U, hU, hxU, -⟩ :=
        exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := (⊤ : X.Opens)) trivial
      exact Set.mem_iUnion.mpr ⟨⟨U, hU⟩, hxU⟩)
  let V : t → X.Opens := fun U => U.1.1
  have hcov : (⊤ : X.Opens) = ⨆ U, V U := by
    refine le_antisymm (fun x _ => ?_) le_top
    obtain ⟨U, hU, hx⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ x))
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨U, hU⟩, hx⟩
  have hinj : Function.Injective (fun (s : Γ(X, ⊤)) (U : t) =>
      X.presheaf.map (homOfLE (le_top : V U ≤ ⊤)).op s) := fun s s' h =>
    TopCat.Sheaf.eq_of_locally_eq' X.sheaf V ⊤ (fun U => homOfLE le_top) hcov.le s s'
      (fun U => congr_fun h U)
  refine (mk_le_of_injective hinj).trans ?_
  rw [mk_pi]
  calc Cardinal.prod (fun U : t => #Γ(X, V U))
      ≤ Cardinal.prod (fun _ : t => X.size) :=
        prod_le_prod _ _ fun U => X.mk_sections_le_size U.1
    _ = Cardinal.lift X.size ^ Cardinal.lift #t := prod_const _ _
    _ = X.size ^ (t.card : Cardinal) := by simp
    _ ≤ X.size := power_nat_le X.aleph0_le_size

/-- The terminal scheme has the size of a countable ring. -/
theorem Scheme.size_terminal : (⊤_ Scheme.{u}).size = ℵ₀ := by
  have e : (⊤_ Scheme.{u}) ≅ Spec (CommRingCat.of (ULift.{u} ℤ)) :=
    IsTerminal.uniqueUpToIso terminalIsTerminal specULiftZIsTerminal
  rw [Scheme.size_congr e, Scheme.size_Spec]
  simp

/-- **A quasi-compact scheme of finite type over the integers has countably many global
sections.** It has at most the size of the terminal scheme, by Stacks 04T7. -/
theorem Scheme.mk_globalSections_le_aleph0 (X : Scheme.{u}) [CompactSpace X]
    [LocallyOfFiniteType (terminal.from X)] : #Γ(X, ⊤) ≤ ℵ₀ :=
  X.mk_globalSections_le_size.trans
    ((Scheme.size_le_of_locallyOfFiniteType (terminal.from X)).trans Scheme.size_terminal.le)

end AlgebraicGeometry

end
