/-! ### Vanishing of the low local cohomology of a quotient of depth at least three -/

/-- **A finite module whose `𝔪`-depth is at least three has vanishing, hence finite, local
cohomology in the degrees `0`, `1` and `2`.** The local cohomology below the depth is zero, and
a zero module is finite. -/
private lemma finite_localCohomologyModule_of_three_le_depth
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (M : ModuleCat.{u} A) [Module.Finite A M]
    (hM : maximalIdeal A • (⊤ : Submodule A M) ≠ ⊤)
    (hdepth : (3 : ℕ∞) ≤ Module.depth A (maximalIdeal A) M)
    (i : ℤ) (hi : i < 3) :
    Module.Finite A (localCohomologyModule A (maximalIdeal A)
      (maximalIdeal A).fg_of_isNoetherianRing M i) := by
  have hzero : CategoryTheory.Limits.IsZero (localCohomologyModule A (maximalIdeal A)
      (maximalIdeal A).fg_of_isNoetherianRing M i) :=
    (Stacks.LocalCohomology.isZero_localCohomology_of_lt_depth.{u, u}
      (maximalIdeal A) M hM 3 hdepth i hi).of_iso
      (Stacks.LocalCohomology.localCohomologyWithSupportInIsoLocalCohomologyModule
        A (maximalIdeal A) (maximalIdeal A).fg_of_isNoetherianRing M i).symm
  have : Subsingleton (localCohomologyModule A (maximalIdeal A)
      (maximalIdeal A).fg_of_isNoetherianRing M i) :=
    ModuleCat.subsingleton_of_isZero hzero
  refine ⟨?_⟩
  rw [Submodule.eq_bot_of_subsingleton (p := (⊤ : Submodule A (localCohomologyModule A
    (maximalIdeal A) (maximalIdeal A).fg_of_isNoetherianRing M i)))]
  exact Submodule.fg_bot

/-! ### Regular sequences, their quotients and their dimensions -/

/-- Every term of a regular sequence in a local ring lies in the maximal ideal, the ideal it
generates being proper. -/
private lemma mem_maximalIdeal_of_mem_isRegular {R : Type u} [CommRing R] [IsLocalRing R]
    {rs : List R} (h : RingTheory.Sequence.IsRegular R rs) : ∀ x ∈ rs, x ∈ maximalIdeal R :=
  fun _ hx =>
    le_maximalIdeal (Stacks.CohenMacaulay.ofList_ne_top_of_isRegular h) (Ideal.subset_span hx)

/-- The quotient of a local ring by a regular sequence is local. -/
private lemma isLocalRing_quotient_ofList_of_isRegular {R : Type u} [CommRing R] [IsLocalRing R]
    {rs : List R} (h : RingTheory.Sequence.IsRegular R rs) : IsLocalRing (R ⧸ Ideal.ofList rs) :=
  have := Ideal.Quotient.nontrivial_iff.mpr (Stacks.CohenMacaulay.ofList_ne_top_of_isRegular h)
  IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective

/-- **The tail of a regular sequence is regular over the quotient by its initial segment.** If
`ts ++ us` is an `R`-regular sequence in the local ring `R` and `us` lies in the maximal ideal,
the images of `us` in `R / (ts)` form a regular sequence there. -/
private lemma isRegular_map_quotient_of_isRegular_append
    (R : Type u) [CommRing R] [IsLocalRing R]
    (ts us : List R) (hus : ∀ x ∈ us, x ∈ maximalIdeal R)
    (h : RingTheory.Sequence.IsRegular R (ts ++ us)) :
    RingTheory.Sequence.IsRegular (R ⧸ Ideal.ofList ts)
      (us.map (Ideal.Quotient.mk (Ideal.ofList ts))) := by
  have hts : RingTheory.Sequence.IsRegular R ts := by
    simpa using isRegular_take (ts ++ us) h ts.length
  have := isLocalRing_quotient_ofList_of_isRegular hts
  have : IsLocalHom (Ideal.Quotient.mk (Ideal.ofList ts)) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  refine (IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal
    (R := R ⧸ Ideal.ofList ts) ?_).mpr ?_
  · intro y hy
    rcases List.mem_map.mp hy with ⟨x, hx, rfl⟩
    exact map_nonunit _ x (hus x hx)
  · rw [← Ideal.Quotient.algebraMap_eq]
    refine (isWeaklyRegular_map_algebraMap_iff _ _ _).mpr ?_
    refine (LinearEquiv.isWeaklyRegular_congr
      (Submodule.quotEquivOfEq (Ideal.ofList ts • ⊤) (Ideal.ofList ts) (by simp)) _).mp ?_
    exact ((isWeaklyRegular_append_iff R ts us).mp h.toIsWeaklyRegular).2

/-- **A quotient of a Cohen–Macaulay local ring by a regular sequence is Cohen–Macaulay.** The
depth and the dimension both drop by the length of the sequence. -/
private lemma isMaximalCohenMacaulay_quotient
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (hR : Module.IsMaximalCohenMacaulay R R) (rs : List R)
    (hrs : RingTheory.Sequence.IsRegular R rs) (I : Ideal R) (hI : Ideal.ofList rs = I)
    [IsLocalRing (R ⧸ I)] :
    Module.IsMaximalCohenMacaulay (R ⧸ I) (R ⧸ I) := by
  subst I
  have h := ((hR.isRegular_iff_ringKrullDim_add_length_eq_ringKrullDim
    rs (mem_maximalIdeal_of_mem_isRegular hrs)).2 hrs).2 rs.length le_rfl
  generalize hs : rs.take rs.length = ts at h
  have hts : ts = rs := hs.symm.trans List.take_length
  rw [hts] at h
  exact h.choose_spec.1

/-- The maximal ideal of a local ring does not saturate a nonzero quotient of it. -/
private lemma quotient_maximalIdeal_smul_ne_top
    (A : Type u) [CommRing A] [IsLocalRing A] (J : Ideal A) (hJ : J ≠ ⊤) :
    maximalIdeal A • (⊤ : Submodule A (A ⧸ J)) ≠ ⊤ := by
  have : Nontrivial (A ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ
  have : IsLocalRing (A ⧸ J) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have : IsLocalHom (Ideal.Quotient.mk J) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  rw [Ideal.smul_top_eq_map, Ideal.Quotient.algebraMap_eq]
  intro htop
  refine (IsLocalRing.map_maximalIdeal_lt_top (Ideal.Quotient.mk J)).ne ?_
  refine (Ideal.eq_top_iff_one _).mpr ?_
  have h1 : (1 : A ⧸ J) ∈
      Submodule.restrictScalars A ((maximalIdeal A).map (Ideal.Quotient.mk J)) := by
    rw [htop]
    exact Submodule.mem_top
  simpa using h1

/-- **A Cohen–Macaulay quotient of dimension at least three has `𝔪`-depth at least three over
the ring it is a quotient of.** A maximal regular sequence on the quotient has length its
dimension, and it is the image of a sequence in the maximal ideal of the base, which is then
regular on the quotient viewed as a module over the base. -/
private lemma three_le_depth_of_surjective
    (R S : Type u) [CommRing R] [CommRing S] [IsNoetherianRing R] [IsNoetherianRing S]
    [IsLocalRing R] [IsLocalRing S] [Algebra R S] [Module.Finite R S]
    (hf : Function.Surjective (algebraMap R S))
    (hCM : Module.IsMaximalCohenMacaulay S S) (hdim : 3 ≤ ringKrullDim S) :
    (3 : ℕ∞) ≤ Module.depth R (maximalIdeal R) S := by
  have hs : maximalIdeal S • (⊤ : Ideal S) ≠ ⊤ := by
    simpa using (maximalIdeal.isMaximal S).ne_top
  obtain ⟨ys, hymem, hyreg, hylen⟩ :=
    (Module.depth_quotSMulTop_succ_eq_depth_and_exists_isRegular_append
      (maximalIdeal S) S).2 hs [] (by simp) (RingTheory.Sequence.IsRegular.nil S S)
  simp only [List.nil_append] at hyreg hylen
  obtain ⟨xs, rfl⟩ := (List.map_surjective_iff.mpr hf) ys
  have hmem : ∀ x ∈ xs, x ∈ maximalIdeal R := fun x hx => (mem_maximalIdeal x).mpr fun hu =>
    (mem_maximalIdeal _).mp (hymem _ (List.mem_map_of_mem hx)) (hu.map (algebraMap R S))
  have hreg : RingTheory.Sequence.IsRegular S xs :=
    (IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal hmem).mpr
      ((isWeaklyRegular_map_algebraMap_iff S S xs).mp hyreg.1)
  have hlen : (3 : ℕ∞) ≤ (xs.length : ℕ∞) := by
    change (Module.depth S (maximalIdeal S) S : WithBot ℕ∞) = ringKrullDim S at hCM
    rw [← hCM, ← hylen, List.length_map] at hdim
    exact WithBot.coe_le_coe.mp hdim
  exact hlen.trans (Module.le_depth_of_isRegular (maximalIdeal R) hmem hreg)

/-- Quotienting by a regular sequence and then by one more element is quotienting by the
sequence extended by that element. -/
private def quotientAppendSingletonEquiv {R : Type u} [CommRing R] (rs : List R) (f : R) :
    ((R ⧸ Ideal.ofList rs) ⧸ Ideal.span {Ideal.Quotient.mk (Ideal.ofList rs) f}) ≃+*
      R ⧸ Ideal.ofList (rs ++ [f]) := by
  have hmap : (Ideal.span {f}).map (Ideal.Quotient.mk (Ideal.ofList rs)) =
      Ideal.span {Ideal.Quotient.mk (Ideal.ofList rs) f} := by
    rw [Ideal.map_span, Set.image_singleton]
  rw [Ideal.ofList_append, Ideal.ofList_singleton, ← hmap]
  exact DoubleQuot.quotQuotEquivQuotSup (Ideal.ofList rs) (Ideal.span {f})

/-- Purity transfers along a ring isomorphism of local rings, the dimension bound being needed
only on the target. -/
private lemma hasPurity_of_ringEquiv_of_three_le_ringKrullDim {R S : Type u} [CommRing R]
    [CommRing S] [IsLocalRing R] [IsLocalRing S] (e : R ≃+* S) (hdim : 3 ≤ ringKrullDim S)
    (h : 3 ≤ ringKrullDim R → HasPurity R) : HasPurity S :=
  hasPurity_of_ringEquiv e (h (by rwa [ringKrullDim_eq_of_ringEquiv e]))

/-- Purity descends from a ring isomorphic to the `𝔪`-adic completion of a Noetherian local ring
of dimension at least three, the dimension bound being needed only on that ring. -/
private lemma hasPurity_of_ringEquiv_adicCompletion {A C : Type u} [CommRing A]
    [IsNoetherianRing A] [IsLocalRing A] [CommRing C] [IsLocalRing C]
    (e : C ≃+* AdicCompletion (maximalIdeal A) A) (hdim : 3 ≤ ringKrullDim A)
    (h : 3 ≤ ringKrullDim C → HasPurity C) : HasPurity A :=
  hasPurity_of_hasPurity_adicCompletion _ (hasPurity_of_ringEquiv_of_three_le_ringKrullDim e
    (by rwa [← ringKrullDim_adicCompletion_maximalIdeal]) h)

/-! ### The primes of `A_f` away from the closed point -/

/-- **A maximal ideal of `A_f` contracts to a prime of `A` whose quotient has dimension at most
one.** The basic open of `f` in `Spec (A / 𝔭)` consists of the generic point alone, because a
prime of `A / 𝔭` not containing `f` comes from a prime of `A` disjoint from the powers of `f`,
whose extension to `A_f` is then the given maximal ideal. A one-point nonempty open on a
Noetherian local domain forces the dimension to be at most one. -/
private lemma ringKrullDim_quotient_comap_le_one
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (f : A) (p : Ideal (Localization.Away f)) [p.IsMaximal] :
    ringKrullDim (A ⧸ p.comap (algebraMap A (Localization.Away f))) ≤ 1 := by
  classical
  let F := Localization.Away f
  let q := p.comap (algebraMap A F)
  have hq : q.IsPrime := Ideal.comap_isPrime _ p
  let B := A ⧸ q
  have : IsLocalRing B := IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  let x : B := Ideal.Quotient.mk q f
  have hf : f ∉ q := fun hf => (IsLocalization.isPrime_iff_isPrime_disjoint
    (Submonoid.powers f) F p).mp inferInstance |>.2 |>.le_bot ⟨Submonoid.mem_powers f, hf⟩
  have hx : x ≠ 0 := fun hx => hf (Ideal.Quotient.eq_zero_iff_mem.mp hx)
  have hsingle : (PrimeSpectrum.basicOpen x : Set (PrimeSpectrum B)) ⊆ {⊥} := by
    intro r hr
    let t := r.asIdeal.comap (Ideal.Quotient.mk q)
    have ht : t.IsPrime := Ideal.comap_isPrime _ _
    have hft : f ∉ t := hr
    have hd : Disjoint (Submonoid.powers f : Set A) (t : Set A) := by
      refine Set.disjoint_left.mpr ?_
      rintro y ⟨n, rfl⟩ hy
      exact hft (ht.mem_of_pow_mem _ hy)
    have htF := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f) F t ht hd
    have hp : p ≤ t.map (algebraMap A F) := by
      rw [← IsLocalization.map_under (Submonoid.powers f) F p]
      refine Ideal.map_mono ?_
      intro a ha
      change Ideal.Quotient.mk q a ∈ r.asIdeal
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha]
      exact r.asIdeal.zero_mem
    have htq : t = q := by
      rw [← IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) F ht hd,
        (Ideal.IsMaximal.eq_of_le ‹p.IsMaximal› htF.ne_top hp).symm]
    have hrbot : r.asIdeal = ⊥ := by
      refine Ideal.comap_injective_of_surjective (Ideal.Quotient.mk q)
        Ideal.Quotient.mk_surjective ?_
      simpa [t, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker] using htq
    exact Set.mem_singleton_iff.mpr (PrimeSpectrum.ext hrbot)
  by_contra hdim
  have htwo : 2 ≤ ringKrullDim B := Order.succ_le_of_lt (lt_of_not_ge hdim)
  exact (PrimeSpectrum.infinite_of_two_le_ringKrullDim B htwo _
    (PrimeSpectrum.basicOpen x).isOpen ⟨⊥, hx⟩) ((Set.finite_singleton _).subset hsingle)

/-- **The local rings of `A_f` at its maximal ideals have dimension at least three** when `A` is
Cohen–Macaulay, `f` is a nonzerodivisor and `A / fA` has dimension at least three. The
dimension of `A` is then at least four, and the dimension formula at the contracted prime
splits it as the height plus the dimension of the quotient, the latter being at most one. -/
private lemma three_le_ringKrullDim_localization_away
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (hCM : Module.IsMaximalCohenMacaulay A A) (f : A) (hf : RingTheory.Sequence.IsRegular A [f])
    (hdim : 3 ≤ ringKrullDim (A ⧸ Ideal.span {f}))
    (p : Ideal (Localization.Away f)) [p.IsMaximal] :
    3 ≤ ringKrullDim (Localization.AtPrime p) := by
  let q := p.comap (algebraMap A (Localization.Away f))
  have : q.IsPrime := Ideal.comap_isPrime _ _
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height q (Localization.AtPrime p)]
  have hco : ringKrullDim (A ⧸ q) ≤ 1 := ringKrullDim_quotient_comap_le_one A f p
  have hdrop := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular [f] hf
  rw [Ideal.ofList_singleton, List.length_singleton, Nat.cast_one] at hdrop
  have hfour : (4 : WithBot ℕ∞) ≤ ringKrullDim A := by
    rw [← hdrop]
    simpa only [add_comm, show (1 : WithBot ℕ∞) + 3 = 4 by norm_num] using add_le_add_right hdim 1
  by_contra h
  have htwo : (q.height : WithBot ℕ∞) ≤ 2 := Order.le_of_lt_succ (lt_of_not_ge h)
  have hthree : ringKrullDim A ≤ 3 := by
    rw [hCM.ringKrullDim_eq_height_add_ringKrullDim_quotient q]
    exact add_le_add htwo hco
  exact (by decide : ¬ (4 : WithBot ℕ∞) ≤ 3) (hfour.trans hthree)

/-- **Purity at a prime of a quotient of a regular local ring by a regular sequence**, granted
purity for quotients by regular sequences of the same length. The localization of
`R / (r_1, …, r_n)` at a prime `𝔮` is `R_𝔭 / (r_1, …, r_n)R_𝔭` for `𝔭` the contraction of `𝔮`,
the ring `R_𝔭` is again regular local, and the images of the `r_i` are again a regular
sequence. -/
private lemma hasPurity_localization_quotient
    (n : ℕ)
    (ih : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R]
      (rs : List R) [IsLocalRing (R ⧸ Ideal.ofList rs)],
      RingTheory.Sequence.IsRegular R rs → rs.length = n →
      3 ≤ ringKrullDim (R ⧸ Ideal.ofList rs) → HasPurity (R ⧸ Ideal.ofList rs))
    (R : Type u) [CommRing R] [IsRegularLocalRing R]
    (rs : List R) (hrs : RingTheory.Sequence.IsRegular R rs) (hlen : rs.length = n)
    (q : Ideal (R ⧸ Ideal.ofList rs)) [q.IsPrime]
    (hdim : 3 ≤ ringKrullDim (Localization.AtPrime q)) :
    HasPurity (Localization.AtPrime q) := by
  let p := q.comap (Ideal.Quotient.mk (Ideal.ofList rs))
  have : p.IsPrime := Ideal.comap_isPrime _ _
  have : IsRegularRing R :=
    ((IsLocalRing.isRegularRing_tfae (R := R)).out 1 3 :
      IsRegularLocalRing R ↔ IsRegularRing R).mp inferInstance
  let Rp := Localization.AtPrime p
  let ts := rs.map (algebraMap R Rp)
  have hts : RingTheory.Sequence.IsRegular Rp ts :=
    hrs.1.isRegular_of_isLocalization_of_mem Rp p (by
      intro x hx
      change Ideal.Quotient.mk (Ideal.ofList rs) x ∈ q
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (s := {r : R | r ∈ rs}) hx)]
      exact q.zero_mem)
  have hmap : Ideal.ofList ts = (Ideal.ofList rs).map (algebraMap R Rp) :=
    (Ideal.map_ofList _ _).symm
  let K := (Ideal.ofList rs).map (algebraMap R Rp)
  have : IsLocalization.AtPrime (Rp ⧸ K) q :=
    isLocalization_atPrime_quotient p Rp (Ideal.ofList rs) q rfl
  have : IsLocalRing (Rp ⧸ K) := IsLocalization.AtPrime.isLocalRing _ q
  have := isLocalRing_quotient_ofList_of_isRegular hts
  let e := (Ideal.quotEquivOfEq hmap).trans
    (IsLocalization.algEquiv q.primeCompl (Rp ⧸ K) (Localization.AtPrime q)).toRingEquiv
  exact hasPurity_of_ringEquiv_of_three_le_ringKrullDim e hdim
    (ih Rp ts hts (by simpa [ts] using hlen))

/-- **The hypersurface step of the induction.** Let `S` be a complete Noetherian local
Cohen–Macaulay ring and `x` a nonzerodivisor in its maximal ideal with `dim S / xS ≥ 3`. If
purity holds for `S` and for the local rings of `S_x` at its maximal ideals, it holds for
`S / xS`. -/
private lemma hasPurity_quotient_span_singleton_of_isAdicComplete
    (S : Type u) [CommRing S] [IsNoetherianRing S] [IsLocalRing S]
    [IsAdicComplete (maximalIdeal S) S] (x : S) (hx : x ∈ maximalIdeal S)
    [IsLocalRing (S ⧸ Ideal.span {x})]
    (hScm : Module.IsMaximalCohenMacaulay S S) (hxseq : RingTheory.Sequence.IsRegular S [x])
    (hdim : 3 ≤ ringKrullDim (S ⧸ Ideal.span {x}))
    (hAway : ∀ (p : Ideal (Localization.Away x)) [p.IsMaximal],
      HasPurity (Localization.AtPrime p))
    (hS : HasPurity S) :
    HasPurity (S ⧸ Ideal.span {x}) := by
  have hxsmul : IsSMulRegular S x := (isWeaklyRegular_singleton_iff S x).mp hxseq.1
  have hmul : ∀ z : S, x * z = 0 → z = 0 := fun z hz =>
    hxsmul (by simpa [smul_eq_mul] using hz)
  have hnzd : x ∈ nonZeroDivisors S :=
    mem_nonZeroDivisors_iff.mpr ⟨hmul, fun z hz => hmul z (by rwa [mul_comm x z])⟩
  have hM := quotient_maximalIdeal_smul_ne_top S (Ideal.span {x})
    (Ideal.Quotient.nontrivial_iff.mp inferInstance)
  have hdepth := three_le_depth_of_surjective S (S ⧸ Ideal.span {x})
    Ideal.Quotient.mk_surjective
    (isMaximalCohenMacaulay_quotient hScm [x] hxseq (Ideal.span {x}) (by simp)) hdim
  exact (⟨S, x, hx⟩ : LocalLefschetzSituation.{u}).hasPurity_quotientRing_of_isAdicComplete
    (isAdicComplete_of_le_of_fg_of_isAdicComplete
      (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hx)) ‹_› (Ideal.fg_of_isNoetherianRing _))
    hnzd
    (finite_localCohomologyModule_of_three_le_depth S
      (ModuleCat.of S (S ⧸ Ideal.span {x})) hM hdepth 1 (by omega))
    (finite_localCohomologyModule_of_three_le_depth S
      (ModuleCat.of S (S ⧸ Ideal.span {x})) hM hdepth 2 (by omega))
    hAway hS

/-- **The inductive step for a complete presenting ring.** Purity for `B / (t_1, …, t_m, f)`,
for `B` a complete regular local ring and `t_1, …, t_m, f` a regular sequence, granted purity
for quotients of regular local rings by shorter regular sequences. -/
private lemma hasPurity_quotient_ofList_concat_of_isAdicComplete (n : ℕ)
    (ih : ∀ m < n, ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R]
      (rs : List R) [IsLocalRing (R ⧸ Ideal.ofList rs)],
      RingTheory.Sequence.IsRegular R rs → rs.length = m →
      3 ≤ ringKrullDim (R ⧸ Ideal.ofList rs) → HasPurity (R ⧸ Ideal.ofList rs))
    (B : Type u) [CommRing B] [IsRegularLocalRing B] [IsAdicComplete (maximalIdeal B) B]
    (ts : List B) (f : B) [IsLocalRing (B ⧸ Ideal.ofList (ts ++ [f]))]
    (hxs : RingTheory.Sequence.IsRegular B (ts ++ [f])) (hlenx : (ts ++ [f]).length = n)
    (hdimx : 3 ≤ ringKrullDim (B ⧸ Ideal.ofList (ts ++ [f]))) :
    HasPurity (B ⧸ Ideal.ofList (ts ++ [f])) := by
  have hts : RingTheory.Sequence.IsRegular B ts := by
    simpa using isRegular_take (ts ++ [f]) hxs ts.length
  have := isLocalRing_quotient_ofList_of_isRegular hts
  let S := B ⧸ Ideal.ofList ts
  have : IsLocalHom (Ideal.Quotient.mk (Ideal.ofList ts)) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  let x : S := Ideal.Quotient.mk (Ideal.ofList ts) f
  have hx : x ∈ maximalIdeal S :=
    map_nonunit _ f (mem_maximalIdeal_of_mem_isRegular hxs f (by simp))
  have hxseq : RingTheory.Sequence.IsRegular S [x] :=
    isRegular_map_quotient_of_isRegular_append B ts [f]
      (fun y hy => mem_maximalIdeal_of_mem_isRegular hxs y (List.mem_append_right _ hy)) hxs
  have : Nontrivial (S ⧸ Ideal.span {x}) := Ideal.Quotient.nontrivial_iff.mpr
    (ne_top_of_le_ne_top (maximalIdeal.isMaximal S).ne_top (Ideal.span_le.mpr (by simpa)))
  have : IsLocalRing (S ⧸ Ideal.span {x}) :=
    IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  let e := quotientAppendSingletonEquiv ts f
  have hdimQ : 3 ≤ ringKrullDim (S ⧸ Ideal.span {x}) := by
    rwa [ringKrullDim_eq_of_ringEquiv e]
  have hScm := isMaximalCohenMacaulay_quotient
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      B).2 ts hts (Ideal.ofList ts) rfl
  have : IsAdicComplete (maximalIdeal S) S := (quotient_isNoetherianCompleteLocalRing
    (show IsNoetherianCompleteLocalRing B from ⟨inferInstance, inferInstance, inferInstance⟩)
    (Ideal.ofList ts) (Stacks.CohenMacaulay.ofList_ne_top_of_isRegular hts)).isComplete
  have hsmall : ts.length < n := by
    simp only [List.length_append, List.length_singleton] at hlenx
    omega
  have hihsmall := ih ts.length hsmall
  have hAway : ∀ (p : Ideal (Localization.Away x)) [p.IsMaximal],
      HasPurity (Localization.AtPrime p) := by
    intro p hp
    let eLoc := IsLocalization.localizationLocalizationAtPrimeIsoLocalization
      (Submonoid.powers x) p
    exact hasPurity_of_ringEquiv_of_three_le_ringKrullDim eLoc.toRingEquiv
      (three_le_ringKrullDim_localization_away S hScm x hxseq hdimQ p)
      (hasPurity_localization_quotient ts.length hihsmall B ts hts rfl
        (p.comap (algebraMap S (Localization.Away x))))
  refine hasPurity_of_ringEquiv e ?_
  exact hasPurity_quotient_span_singleton_of_isAdicComplete S x hx hScm hxseq hdimQ hAway
    (hihsmall B ts hts rfl (hdimQ.trans (ringKrullDim_le_of_surjective
      (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective)))

/-! ### The induction -/

/-- **Purity for a quotient of a regular local ring by a regular sequence.** Let `R` be a
regular local ring and `r_1, …, r_n` a regular sequence in it with
`dim R / (r_1, …, r_n) ≥ 3`. Then purity holds for `R / (r_1, …, r_n)`: every finite étale
cover of its punctured spectrum extends over its spectrum.

The induction is on the length of the sequence. Its step needs the presenting ring complete, so
the statement for a given length is first proved for a complete presenting ring and then
transported: the `𝔪`-adic completion of `R` is again regular local, the sequence stays regular
there because the completion map is faithfully flat, and completion commutes with the quotient,
so purity descends from the completion. The induction hypothesis is used at a localization of
the presenting ring, which is not complete, so it has to be the statement without the
completeness assumption. -/
@[sga "2 XII 3.5" "special case"]
theorem hasPurity_quotient_ofList_of_isRegular
    (n : ℕ) (R : Type u) [CommRing R] [IsRegularLocalRing R] (rs : List R)
    [IsLocalRing (R ⧸ Ideal.ofList rs)] (hrs : RingTheory.Sequence.IsRegular R rs)
    (hlen : rs.length = n) (hdim : 3 ≤ ringKrullDim (R ⧸ Ideal.ofList rs)) :
    HasPurity (R ⧸ Ideal.ofList rs) := by
  classical
  induction n using Nat.strong_induction_on generalizing R with
  | _ n ih =>
  have hc : ∀ (B : Type u) [CommRing B] [IsRegularLocalRing B]
      [IsAdicComplete (maximalIdeal B) B] (xs : List B)
      [IsLocalRing (B ⧸ Ideal.ofList xs)],
      RingTheory.Sequence.IsRegular B xs → xs.length = n →
      3 ≤ ringKrullDim (B ⧸ Ideal.ofList xs) → HasPurity (B ⧸ Ideal.ofList xs) := by
    intro B _ _ _ xs _ hxs hlenx hdimx
    rcases List.eq_nil_or_concat' xs with rfl | ⟨ts, f, rfl⟩
    · let e : B ≃+* B ⧸ Ideal.ofList ([] : List B) :=
        (RingEquiv.quotientBot B).symm.trans (Ideal.quotEquivOfEq Ideal.ofList_nil.symm)
      exact hasPurity_of_ringEquiv_of_three_le_ringKrullDim e hdimx fun h =>
        hasPurity_of_isRegularLocalRing B ((by norm_num : (2 : WithBot ℕ∞) ≤ 3).trans h)
    · exact hasPurity_quotient_ofList_concat_of_isAdicComplete n ih B ts f hxs hlenx hdimx
  let B := AdicCompletion (maximalIdeal R) R
  have : IsRegularLocalRing B :=
    isRegularLocalRing_iff_adicCompletion_maximalIdeal.mp inferInstance
  have : IsAdicComplete (maximalIdeal B) B :=
    AdicCompletion.isAdicComplete_of_fg (maximalIdeal R).fg_of_isNoetherianRing
  have : Module.FaithfullyFlat R B :=
    AdicCompletion.faithfullyFlat_of_le_ringJacobson (maximalIdeal R) (by
      rw [IsLocalRing.ringJacobson_eq_maximalIdeal])
  let xs := rs.map (algebraMap R B)
  have hxs : RingTheory.Sequence.IsRegular B xs := hrs.of_faithfullyFlat
  have := isLocalRing_quotient_ofList_of_isRegular hxs
  have hm : (maximalIdeal R).map (algebraMap R (R ⧸ Ideal.ofList rs)) =
      maximalIdeal (R ⧸ Ideal.ofList rs) :=
    IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective
  let e : (B ⧸ Ideal.ofList xs) ≃+*
      AdicCompletion (maximalIdeal (R ⧸ Ideal.ofList rs)) (R ⧸ Ideal.ofList rs) := by
    rw [← Ideal.map_ofList, ← hm]
    exact (adicCompletionQuotientAlgEquiv (maximalIdeal R) (Ideal.ofList rs)).toRingEquiv
  exact hasPurity_of_ringEquiv_adicCompletion e hdim (hc B xs hxs (by simpa [xs] using hlen))

/-- **Purity for a complete intersection of dimension at least three, [Stacks, Tag 0BPD].** Let
`(A, 𝔪)` be a Noetherian local ring which is a complete intersection of dimension at least
three. Then purity holds for `A`: every finite étale cover of the punctured spectrum of `A` is,
up to isomorphism, the restriction of a finite étale cover of `Spec A`.

Purity descends from the completion of `A`, which by hypothesis is the quotient of a regular
local ring by an ideal generated by a regular sequence. -/
@[stacks 0BPD "purity for a complete intersection local ring of dimension at least three; the \
complete intersection hypothesis is `LocalCompleteIntersection.IsCompleteIntersectionRing` \
(Tag 09Q3 (1)) and purity is `AlgebraicGeometry.HasPurity`",
  sga "2 X 3.4" "3.4(ii)",
  sga "2 XII 3.5" "partial",
  sga "2 XII 4.9" "Clause a)"]
theorem hasPurity_of_isCompleteIntersectionRing
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (hA : LocalCompleteIntersection.IsCompleteIntersectionRing A)
    (hdim : 3 ≤ ringKrullDim A) :
    HasPurity A := by
  classical
  obtain ⟨B, hB, hBreg, f, hf, _, rs, hrs, hker⟩ := hA
  let _ : CommRing B := hB
  have : IsRegularLocalRing B := hBreg
  have := isLocalRing_quotient_ofList_of_isRegular hrs
  let e : (B ⧸ Ideal.ofList rs) ≃+* AdicCompletion (maximalIdeal A) A :=
    (Ideal.quotEquivOfEq hker).trans (RingHom.quotientKerEquivOfSurjective hf)
  exact hasPurity_of_ringEquiv_adicCompletion e hdim
    (hasPurity_quotient_ofList_of_isRegular rs.length B rs hrs rfl)

end AlgebraicGeometry

