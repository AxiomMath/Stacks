module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionFullyFaithful.PrincipalComplete
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.PurityLocalCase.LocalLefschetz

/-!
# The punctured spectrum as a complement, and the ideal sheaf of its closed fibre

In the local Lefschetz situation `(A, f)` of Tag 0BLF the punctured spectrum `U = X ∖ {𝔪}` is the
complement of the zero locus of the maximal ideal, and the closed subscheme `U₀ = U ∩ X₀` of `U`
is cut out by `f`. This file records both identifications, in the exact shape the completion
results of the chapter *Algebraic and Formal Geometry* produce and the restriction result of the
chapter *Fundamental Groups of Schemes* consumes.

## Main results

* `AlgebraicGeometry.puncturedSpectrum_eq_complementZeroLocus` — the punctured spectrum of a
  local ring is the complement of the zero locus of its maximal ideal.
* `AlgebraicGeometry.ker_morphismRestrict_spec_quotientMk` — the kernel ideal sheaf of the
  restriction to an open `W ⊆ Spec A` of the closed immersion `Spec (A/I) ⟶ Spec A` is the ideal
  sheaf generated on `W` by the image of `I`.
* `AlgebraicGeometry.LocalLefschetzSituation.ker_U₀ToU` — the kernel ideal sheaf of `U₀ ⟶ U` is
  generated by the restriction of `f` to `U`.
* `AlgebraicGeometry.LocalLefschetzSituation.isNoetherian_U` — `U` is a Noetherian scheme.

## What is and is not proved

Nothing here is a Stacks tag and nothing is tagged. No statement about finite étale covers,
local cohomology, completion or henselian pairs is asserted or assumed: the content is the two
identifications above, which are what allow a statement about
`Stacks.LocalCohomology.complementZeroLocus A 𝔪` and
`Stacks.Algebraization.complementPrincipalIdealSheaf A 𝔪 f` to be read as a statement about the
punctured spectra of the local Lefschetz situation.

## Implementation notes

The kernel computation goes through Mathlib's `AlgebraicGeometry.Scheme.ker_morphismRestrict_ideal`
and `AlgebraicGeometry.Scheme.ker_of_isAffine`: on the affine `Spec A` the kernel ideal sheaf of
`Spec (A/I) ⟶ Spec A` is `ofIdealTop` of the kernel of its map on global sections, which is `I`
transported along `Scheme.ΓSpecIso`, and restriction to an open commutes with `ofIdealTop`
because both sides are the image of `I` under one and the same restriction map of the structure
sheaf of `Spec A`.

## References

* [Stacks Project, Tag 0BLF](https://stacks.math.columbia.edu/tag/0BLF)
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing TopologicalSpace
open Stacks.LocalCohomology (complementZeroLocus)

universe u

namespace AlgebraicGeometry

/-- In a local ring the zero locus of the maximal ideal is the closed point: a prime containing
the maximal ideal is the maximal ideal. -/
theorem zeroLocus_maximalIdeal_eq_singleton (A : Type u) [CommRing A] [IsLocalRing A] :
    PrimeSpectrum.zeroLocus (maximalIdeal A : Set A) = {closedPoint A} := by
  refine Set.eq_singleton_iff_unique_mem.2 ⟨(PrimeSpectrum.mem_zeroLocus _ _).2 le_rfl,
    fun x hx => PrimeSpectrum.ext ?_⟩
  exact ((maximalIdeal.isMaximal A).eq_of_le x.isPrime.ne_top
    (by exact_mod_cast (PrimeSpectrum.mem_zeroLocus _ _).1 hx)).symm

/-- The punctured spectrum of a local ring is the complement of the zero locus of its maximal
ideal. -/
theorem puncturedSpectrum_eq_complementZeroLocus (A : Type u) [CommRing A] [IsLocalRing A] :
    Stacks.Divisors.puncturedSpectrum A = complementZeroLocus A (maximalIdeal A) :=
  Opens.ext (by
    show ({closedPoint A} : Set (PrimeSpectrum A))ᶜ =
      (PrimeSpectrum.zeroLocus (maximalIdeal A : Set A))ᶜ
    exact congrArg compl (zeroLocus_maximalIdeal_eq_singleton A).symm)

/-- The kernel of the map on global sections of `Spec (A/I) ⟶ Spec A` is `I`, transported along
`Scheme.ΓSpecIso`. -/
theorem ker_appTop_spec_quotientMk (A : Type u) [CommRing A] (I : Ideal A) :
    RingHom.ker ((Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).appTop).hom =
      I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom := by
  have hnat := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (Ideal.Quotient.mk I))
  have hinj : Function.Injective
      (Scheme.ΓSpecIso (CommRingCat.of (A ⧸ I))).hom.hom :=
    (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of (A ⧸ I))).hom).1
  have hcomap : I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom =
      I.comap (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom :=
    Ideal.map_symm (Scheme.ΓSpecIso (CommRingCat.of A)).commRingCatIsoToRingEquiv
  rw [hcomap]
  ext x
  simp only [RingHom.mem_ker, Ideal.mem_comap]
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  have h : ((Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).appTop ≫
      (Scheme.ΓSpecIso (CommRingCat.of (A ⧸ I))).hom).hom x =
      ((Scheme.ΓSpecIso (CommRingCat.of A)).hom ≫
        CommRingCat.ofHom (Ideal.Quotient.mk I)).hom x := by rw [hnat]
  rw [CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply] at h
  refine ⟨fun hx => ?_, fun hx => hinj ?_⟩
  · rw [hx, map_zero] at h
    exact h.symm
  · rw [h, map_zero]
    exact hx

/-- The kernel ideal sheaf of the restriction to an open `W` of `Spec A` of the closed immersion
`Spec (A/I) ⟶ Spec A` is the ideal sheaf on `W` generated by the image of `I` in `Γ(W, 𝒪_W)`. -/
theorem ker_morphismRestrict_spec_quotientMk (A : Type u) [CommRing A] (I : Ideal A)
    (W : (Spec (CommRingCat.of A)).Opens) :
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ∣_ W).ker =
      Scheme.IdealSheafData.ofIdealTop
        (I.map ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ W.ι.appTop).hom) := by
  have : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  refine Scheme.IdealSheafData.ext (funext fun V => ?_)
  rw [Scheme.ker_morphismRestrict_ideal, Scheme.ker_of_isAffine,
    Scheme.IdealSheafData.ofIdealTop_ideal, Scheme.IdealSheafData.ofIdealTop_ideal,
    ker_appTop_spec_quotientMk, Ideal.map_map, Ideal.map_map]
  congr 1

/-- An open subscheme of the spectrum of a Noetherian ring is a Noetherian scheme: it is
locally Noetherian, and quasi-compact because the spectrum is a Noetherian space. -/
theorem isNoetherian_opens_spec (A : Type u) [CommRing A] [IsNoetherianRing A]
    (W : (Spec (CommRingCat.of A)).Opens) : IsNoetherian (W : Scheme) :=
  have : CompactSpace (W : Scheme) :=
    isCompact_iff_compactSpace.mp (NoetherianSpace.isCompact _)
  ⟨⟩

namespace LocalLefschetzSituation

variable (S : LocalLefschetzSituation.{u})

/-- The punctured spectrum `U` of `A` is the complement of the zero locus of the maximal
ideal. -/
theorem UOpen_eq_complementZeroLocus :
    S.UOpen = complementZeroLocus S.A (maximalIdeal S.A) :=
  puncturedSpectrum_eq_complementZeroLocus S.A

/-- `U₀ ⟶ U` is a closed immersion, being the restriction to `U` of the closed immersion
`X₀ ⟶ X`. -/
instance isClosedImmersion_U₀ToU : IsClosedImmersion S.U₀ToU := by
  have : IsClosedImmersion S.X₀ToX :=
    IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom (Ideal.Quotient.mk S.principalIdeal))
      Ideal.Quotient.mk_surjective
  change IsClosedImmersion (S.X₀ToX ∣_ S.UOpen)
  infer_instance

/-- The punctured spectrum `U` is a Noetherian scheme. -/
instance isNoetherian_U : IsNoetherian S.U :=
  isNoetherian_opens_spec S.A S.UOpen

/-- The kernel ideal sheaf of `U₀ ⟶ U` is generated by the restriction of `f` to `U`. -/
theorem ker_U₀ToU :
    S.U₀ToU.ker = Scheme.IdealSheafData.ofIdealTop (Ideal.span
      {((Scheme.ΓSpecIso (CommRingCat.of S.A)).inv ≫ S.UOpen.ι.appTop).hom S.f}) := by
  show (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk S.principalIdeal)) ∣_ S.UOpen).ker = _
  rw [ker_morphismRestrict_spec_quotientMk, LocalLefschetzSituation.principalIdeal,
    Ideal.map_span, Set.image_singleton]

end LocalLefschetzSituation

end AlgebraicGeometry

end
