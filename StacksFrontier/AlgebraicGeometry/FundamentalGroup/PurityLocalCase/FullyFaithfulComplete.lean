attribute [local instance 2000] HasDerivedCategory.standard

universe u

namespace AlgebraicGeometry

/-- In a local ring, localizing at a prime containing the maximal ideal changes nothing: every
element outside such a prime is outside the maximal ideal, hence a unit. So the Krull dimension
of `(A/𝔭)_𝔮` agrees with that of `A/𝔭`. -/
theorem ringKrullDim_quotient_localization_of_maximalIdeal_le (A : Type u) [CommRing A]
    [IsLocalRing A] (q : PrimeSpectrum A) (hq : maximalIdeal A ≤ q.asIdeal) (p : Ideal A) :
    ringKrullDim ((Localization.AtPrime q.asIdeal) ⧸
        p.map (algebraMap A (Localization.AtPrime q.asIdeal))) =
      ringKrullDim (A ⧸ p) := by
  have hU : q.asIdeal.primeCompl ≤ IsUnit.submonoid A := fun x hx =>
    IsLocalRing.notMem_maximalIdeal.1 fun hmem => hx (hq hmem)
  let e : A ≃ₐ[A] Localization.AtPrime q.asIdeal :=
    IsLocalization.atUnits A q.asIdeal.primeCompl hU
  have hcoe : (e.toRingEquiv : A →+* Localization.AtPrime q.asIdeal) =
      algebraMap A (Localization.AtPrime q.asIdeal) := by
    ext a
    exact e.commutes a
  refine (ringKrullDim_eq_of_ringEquiv (Ideal.quotientEquiv p
    (p.map (algebraMap A (Localization.AtPrime q.asIdeal))) e.toRingEquiv ?_)).symm
  rw [hcoe]

/-- Over a Noetherian local ring the local cohomology `H^i_𝔪(A)` vanishes in every degree
`i < n ≤ depth_𝔪(A)`. This is `Stacks.LocalCohomology.isZero_localCohomology_of_lt_depth`, the
inequality half of [Stacks, Tag 0AVZ], read through the comparison of the two models of local
cohomology; the coreflection model is the one the hypothesis of Stacks 0BM6 speaks of. The
modules of `StacksDraft.RingTheory.LocalCohomology` keep their own versions of this private, so
it is restated here. -/
@[sga "2 XII 1.5" "special case"]
private theorem isZero_localCohomologyModule_self_of_lt_depth (A : Type u) [CommRing A]
    [IsNoetherianRing A] [IsLocalRing A] (n : ℕ)
    (hn : (n : ℕ∞) ≤ Module.depth A (maximalIdeal A) A) (i : ℤ) (hi : i < n) :
    CategoryTheory.Limits.IsZero (localCohomologyModule A (maximalIdeal A)
      (Ideal.fg_of_isNoetherianRing (maximalIdeal A)) (ModuleCat.of A A) i) :=
  (Stacks.LocalCohomology.isZero_localCohomology_of_lt_depth.{u, u} (maximalIdeal A)
      (ModuleCat.of A A) (by simpa using (maximalIdeal.isMaximal A).ne_top) n hn i hi).of_iso
    (Stacks.LocalCohomology.localCohomologyWithSupportInIsoLocalCohomologyModule A
      (maximalIdeal A) (Ideal.fg_of_isNoetherianRing (maximalIdeal A)) (ModuleCat.of A A) i).symm

/-- Below the depth every power of every element annihilates `H^i_𝔪(A)`, the module being zero.
This is the shape in which Stacks 0BM6 asks for its hypothesis on `H¹_𝔪(A)` and `H²_𝔪(A)`. -/
private theorem exists_pow_smul_localCohomologyModule_self_eq_zero_of_lt_depth (A : Type u)
    [CommRing A] [IsNoetherianRing A] [IsLocalRing A] (n : ℕ)
    (hn : (n : ℕ∞) ≤ Module.depth A (maximalIdeal A) A) (i : ℤ) (hi : i < n) (g : A) :
    ∃ m : ℕ, ∀ x : localCohomologyModule A (maximalIdeal A)
      (Ideal.fg_of_isNoetherianRing (maximalIdeal A)) (ModuleCat.of A A) i, g ^ m • x = 0 := by
  have hsub := ModuleCat.subsingleton_of_isZero
    (isZero_localCohomologyModule_self_of_lt_depth A n hn i hi)
  exact ⟨0, fun _ => hsub.elim _ _⟩

namespace LocalLefschetzSituation

/-- The bridge of `fullyFaithful_finiteEtaleRestriction_of_completionFullyFaithful`, with the
open subscheme `U` of `X` generalized so that the identification of `U` with the complement of
the zero locus of `𝔪` can be substituted. -/
private theorem fullyFaithful_aux (S : LocalLefschetzSituation.{u})
    (W : (Spec (CommRingCat.of S.A)).Opens) (hW : W = S.UOpen)
    (hcompletion : CompletionFullyFaithfulOnFiniteLocallyFree (W : Scheme)
      (Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {((Scheme.ΓSpecIso (CommRingCat.of S.A)).inv ≫ W.ι.appTop).hom S.f})))
    (h0GN2 : ∀ {Z Z' : Scheme.{u}} (κ : Z' ⟶ Z) [IsClosedImmersion κ] (N : Z.Modules),
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} N →
      Stacks.Algebraization.IsInfinitesimalSectionsComplete κ
        (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf N) →
      (∀ φ ψ : N ⟶ SheafOfModules.unit Z.ringCatSheaf,
          (∀ n : ℕ, φ ≫ nthOrderUnitMap κ n = ψ ≫ nthOrderUnitMap κ n) → φ = ψ) ∧
        ∀ α : ∀ n : ℕ, N ⟶ AlgebraSheaf.underlyingModule (nthOrderAlgebra κ n),
          (∀ n : ℕ, α (n + 1) ≫ nthOrderTransitionMap κ n = α n) →
          ∃ φ : N ⟶ SheafOfModules.unit Z.ringCatSheaf,
            ∀ n : ℕ, φ ≫ nthOrderUnitMap κ n = α n)
    (halgebra : ∀ {Z : Scheme.{u}} (B C : AlgebraSheaf Z) (D : ℕ → AlgebraSheaf Z)
      (r : ∀ n : ℕ, C ⟶ D n)
      (φ : AlgebraSheaf.underlyingModule B ⟶ AlgebraSheaf.underlyingModule C),
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
        (AlgebraSheaf.underlyingModule B) →
      _root_.SheafOfModules.IsCoherent (AlgebraSheaf.underlyingModule B) →
      (∀ n : ℕ, ∃ ψ : B ⟶ D n,
        AlgebraSheaf.underlyingModuleMap ψ = φ ≫ AlgebraSheaf.underlyingModuleMap (r n)) →
      (∀ P : Z.Modules, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} P →
        _root_.SheafOfModules.IsCoherent P →
        ∀ a b : P ⟶ AlgebraSheaf.underlyingModule C,
          (∀ n : ℕ, a ≫ AlgebraSheaf.underlyingModuleMap (r n) =
            b ≫ AlgebraSheaf.underlyingModuleMap (r n)) → a = b) →
      ∃ ψ : B ⟶ C, AlgebraSheaf.underlyingModuleMap ψ = φ) :
    Nonempty (finiteEtaleBaseChange S.U₀ToU).FullyFaithful := by
  subst hW
  rw [← S.ker_U₀ToU] at hcompletion
  exact fullyFaithful_finiteEtaleBaseChange_of_completionFullyFaithful S.U₀ToU hcompletion
    h0GN2 halgebra

/-- The restriction functor `FÉt_U ⟶ FÉt_{U₀}` of the local Lefschetz situation is fully
faithful as soon as completion along `(f)𝒪_U` is fully faithful on the finite locally free
coherent sheaves on `U`.

The two hypotheses `h0GN2` and `halgebra` are those of Stacks 0EL8, inherited verbatim from
`Stacks.FundamentalGroup.fullyFaithful_finiteEtaleBaseChange_of_completionFullyFaithful`. -/
public theorem fullyFaithful_finiteEtaleRestriction_of_completionFullyFaithful
    (S : LocalLefschetzSituation.{u})
    (hcompletion : CompletionFullyFaithfulOnFiniteLocallyFree
      (complementZeroLocus S.A (maximalIdeal S.A) : Scheme)
      (complementPrincipalIdealSheaf S.A (maximalIdeal S.A) S.f))
    (h0GN2 : ∀ {Z Z' : Scheme.{u}} (κ : Z' ⟶ Z) [IsClosedImmersion κ] (N : Z.Modules),
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} N →
      Stacks.Algebraization.IsInfinitesimalSectionsComplete κ
        (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf N) →
      (∀ φ ψ : N ⟶ SheafOfModules.unit Z.ringCatSheaf,
          (∀ n : ℕ, φ ≫ nthOrderUnitMap κ n = ψ ≫ nthOrderUnitMap κ n) → φ = ψ) ∧
        ∀ α : ∀ n : ℕ, N ⟶ AlgebraSheaf.underlyingModule (nthOrderAlgebra κ n),
          (∀ n : ℕ, α (n + 1) ≫ nthOrderTransitionMap κ n = α n) →
          ∃ φ : N ⟶ SheafOfModules.unit Z.ringCatSheaf,
            ∀ n : ℕ, φ ≫ nthOrderUnitMap κ n = α n)
    (halgebra : ∀ {Z : Scheme.{u}} (B C : AlgebraSheaf Z) (D : ℕ → AlgebraSheaf Z)
      (r : ∀ n : ℕ, C ⟶ D n)
      (φ : AlgebraSheaf.underlyingModule B ⟶ AlgebraSheaf.underlyingModule C),
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
        (AlgebraSheaf.underlyingModule B) →
      _root_.SheafOfModules.IsCoherent (AlgebraSheaf.underlyingModule B) →
      (∀ n : ℕ, ∃ ψ : B ⟶ D n,
        AlgebraSheaf.underlyingModuleMap ψ = φ ≫ AlgebraSheaf.underlyingModuleMap (r n)) →
      (∀ P : Z.Modules, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} P →
        _root_.SheafOfModules.IsCoherent P →
        ∀ a b : P ⟶ AlgebraSheaf.underlyingModule C,
          (∀ n : ℕ, a ≫ AlgebraSheaf.underlyingModuleMap (r n) =
            b ≫ AlgebraSheaf.underlyingModuleMap (r n)) → a = b) →
      ∃ ψ : B ⟶ C, AlgebraSheaf.underlyingModuleMap ψ = φ) :
    Nonempty (finiteEtaleBaseChange S.U₀ToU).FullyFaithful :=
  fullyFaithful_aux S (complementZeroLocus S.A (maximalIdeal S.A))
    S.UOpen_eq_complementZeroLocus.symm hcompletion h0GN2 halgebra

/-- **[Stacks, Tag 0BM6]** in the case where `A` is in addition `f`-adically complete. In the
local Lefschetz situation assume that `H¹_𝔪(A)` and `H²_𝔪(A)` are annihilated by a power of `f`
and that `A` is henselian — or more generally that the pair `(A, (f))` is henselian. If moreover
`A` is `f`-adically complete, then `FÉt_U ⟶ FÉt_{U₀}` is fully faithful.

The `f`-adic completeness of `A` is the one hypothesis beyond the tag's own. The source's proof
obtains it by replacing `A` with its `𝔪`-adic completion, which is Stacks 0BLI, available here as
`AlgebraicGeometry.LocalLefschetzSituation.fullyFaithful_finiteEtaleRestriction_of_completion`,
together with Stacks 0ALZ for the inheritance of the annihilation hypothesis; that reduction is
*not* carried out here, so the statement is the tag restricted to an `f`-adically complete `A`.
The henselian hypothesis `hS` is the tag's hypothesis (2); it is exactly what the omitted
reduction consumes, so it is stated but not used below.

Three hypotheses about other objects are carried, each inherited verbatim from the result that
needs it and each stated about arbitrary rings or arbitrary schemes:

* `hEKP` is the chain (1) ⇒ (4) of [Stacks, Tag 0EKP], the hypothesis of
  `Stacks.Algebraization.completionFullyFaithful_of_isAdicComplete_of_annihilated`
  (Stacks 0EKS). It speaks of every Noetherian ring `B`, every ideal `𝔟 ⊆ B` and every `g ∈ B`.
* `h0GN2` is [Stacks, Tag 0GN2] in the shape in which Stacks 0EL8 uses it, and `halgebra` is the
  multiplicativity criterion for a morphism of the underlying modules of two sheaves of
  algebras; both are the hypotheses of
  `Stacks.FundamentalGroup.fullyFaithful_finiteEtaleBaseChange_of_completionFullyFaithful`
  (Stacks 0EL8) and both are stated about arbitrary schemes and arbitrary closed immersions.

None of the three mentions `A`, `f`, `U` or `U₀`, and none is about finite étale covers of a
punctured spectrum. -/
@[stacks 0BM6 "the case where `A` is in addition `f`-adically complete, the reduction to that \
case (Stacks 0BLI together with Stacks 0ALZ) not being carried out; granted hEKP (the chain \
(1) ⇒ (4) of Stacks 0EKP), h0GN2 (Stacks 0GN2) and halgebra, all three carried as general \
hypotheses about other rings and other schemes"]
public theorem fullyFaithful_finiteEtaleRestriction_of_annihilated
    (S : LocalLefschetzSituation.{u})
    (hS : HenselianLocalRing S.A ∨ HenselianPair S.A S.principalIdeal)
    (hcomplete : IsAdicComplete (Ideal.span {S.f}) S.A)
    (h1 : ∃ n, ∀ x : localCohomologyModule S.A (maximalIdeal S.A)
      (Ideal.fg_of_isNoetherianRing (maximalIdeal S.A)) (ModuleCat.of S.A S.A) 1,
      S.f ^ n • x = 0)
    (h2 : ∃ n, ∀ x : localCohomologyModule S.A (maximalIdeal S.A)
      (Ideal.fg_of_isNoetherianRing (maximalIdeal S.A)) (ModuleCat.of S.A S.A) 2,
      S.f ^ n • x = 0)
    (hEKP : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (b : Ideal B) (g : B),
      Scheme.IsQuasiAffine (complementZeroLocus B b : Scheme) →
      Function.Bijective
        (Stacks.Algebraization.ComplementTower.sectionsToLimit B b g (ModuleCat.of B B)) →
      CompletionFullyFaithfulOnFiniteLocallyFree (complementZeroLocus B b : Scheme)
        (complementPrincipalIdealSheaf B b g))
    (h0GN2 : ∀ {Z Z' : Scheme.{u}} (κ : Z' ⟶ Z) [IsClosedImmersion κ] (N : Z.Modules),
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} N →
      Stacks.Algebraization.IsInfinitesimalSectionsComplete κ
        (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf N) →
      (∀ φ ψ : N ⟶ SheafOfModules.unit Z.ringCatSheaf,
          (∀ n : ℕ, φ ≫ nthOrderUnitMap κ n = ψ ≫ nthOrderUnitMap κ n) → φ = ψ) ∧
        ∀ α : ∀ n : ℕ, N ⟶ AlgebraSheaf.underlyingModule (nthOrderAlgebra κ n),
          (∀ n : ℕ, α (n + 1) ≫ nthOrderTransitionMap κ n = α n) →
          ∃ φ : N ⟶ SheafOfModules.unit Z.ringCatSheaf,
            ∀ n : ℕ, φ ≫ nthOrderUnitMap κ n = α n)
    (halgebra : ∀ {Z : Scheme.{u}} (B C : AlgebraSheaf Z) (D : ℕ → AlgebraSheaf Z)
      (r : ∀ n : ℕ, C ⟶ D n)
      (φ : AlgebraSheaf.underlyingModule B ⟶ AlgebraSheaf.underlyingModule C),
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
        (AlgebraSheaf.underlyingModule B) →
      _root_.SheafOfModules.IsCoherent (AlgebraSheaf.underlyingModule B) →
      (∀ n : ℕ, ∃ ψ : B ⟶ D n,
        AlgebraSheaf.underlyingModuleMap ψ = φ ≫ AlgebraSheaf.underlyingModuleMap (r n)) →
      (∀ P : Z.Modules, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} P →
        _root_.SheafOfModules.IsCoherent P →
        ∀ a b : P ⟶ AlgebraSheaf.underlyingModule C,
          (∀ n : ℕ, a ≫ AlgebraSheaf.underlyingModuleMap (r n) =
            b ≫ AlgebraSheaf.underlyingModuleMap (r n)) → a = b) →
      ∃ ψ : B ⟶ C, AlgebraSheaf.underlyingModuleMap ψ = φ) :
    Nonempty (finiteEtaleBaseChange S.U₀ToU).FullyFaithful := by
  -- The henselian hypothesis is the tag's (2); it is consumed only by the reduction to the
  -- complete case, which is not performed here.
  have : HenselianLocalRing S.A ∨ HenselianPair S.A S.principalIdeal := hS
  exact fullyFaithful_finiteEtaleRestriction_of_completionFullyFaithful S
    (Stacks.Algebraization.completionFullyFaithful_of_isAdicComplete_of_annihilated
      S.A (maximalIdeal S.A) S.f S.f_mem_maximalIdeal hcomplete h1 h2 hEKP) h0GN2 halgebra

/-- **[Stacks, Tag 0EK5]** under hypothesis (c)(ii), in the case where `A` is in addition
`f`-adically complete. In the local Lefschetz situation assume that `A` has a dualizing complex,
that the pair `(A, (f))` is henselian, and that `depth(A_𝔭) + dim(A/𝔭) > 2` for every prime
`𝔭 ⊂ A` with `f ∉ 𝔭`. If moreover `A` is `f`-adically complete, then `FÉt_U ⟶ FÉt_{U₀}` is
fully faithful.

Two restrictions of the tag are recorded in the attribute.

* Hypothesis (c) of the tag is a disjunction, and only branch (ii) — the depth-plus-dimension
  inequality — is treated. Branch (c)(i) is not: deducing (ii) from it is the
  `(S₂)`-plus-dimension argument of the source, which goes through Stacks 0339, 0A80, 0AW6 and
  0AWY and is not carried out here.
* The `f`-adic completeness of `A` is the one hypothesis beyond the tag's own. The source
  obtains it by replacing `A` by its `𝔪`-adic completion, which is Stacks 0BLI, available here
  as `…fullyFaithful_finiteEtaleRestriction_of_completion`, together with Stacks 0EHW for the
  inheritance of (c)(ii); that reduction is not carried out here. The henselian hypothesis `hS`
  is the tag's hypothesis (b) and is exactly what the omitted reduction consumes, so it is
  stated but not used below.

The carried hypotheses `hEKP`, `h0GN2` and `halgebra` are the ones discussed on
`fullyFaithful_finiteEtaleRestriction_of_annihilated`; here `hEKP` arrives through
`Stacks.Algebraization.completionFullyFaithful_of_isAdicComplete_of_depth` (Stacks 0EKT) rather
than through Stacks 0EKS. None of the three mentions `A`, `f`, `U` or `U₀`, and none is about
finite étale covers. -/
@[stacks 0EK5 "under hypothesis (c)(ii), the depth-plus-dimension form, and in the case where \
`A` is in addition `f`-adically complete; branch (c)(i) and the reduction to the complete case \
are not carried out, and hEKP (the chain (1) ⇒ (4) of Stacks 0EKP), h0GN2 (Stacks 0GN2) and \
halgebra are granted as general hypotheses about other rings and other schemes"]
public theorem fullyFaithful_finiteEtaleRestriction_of_depth
    (S : LocalLefschetzSituation.{u})
    (hS : HenselianPair S.A S.principalIdeal)
    (omega : DerivedCategory (ModuleCat.{u} S.A))
    (homega : Dualizing.IsDualizingComplex (A := S.A) (K := omega))
    (hcomplete : IsAdicComplete (Ideal.span {S.f}) S.A)
    (hdepth : ∀ p : PrimeSpectrum S.A, S.f ∉ p.asIdeal →
      enatToEInt
          (Module.depth (Localization.AtPrime p.asIdeal)
            (maximalIdeal (Localization.AtPrime p.asIdeal))
            (LocalizedModule p.asIdeal.primeCompl S.A)) +
        krullDimToEInt (ringKrullDim (S.A ⧸ p.asIdeal)) > ((2 : ℤ) : EInt))
    (hEKP : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (b : Ideal B) (g : B),
      Scheme.IsQuasiAffine (complementZeroLocus B b : Scheme) →
      Function.Bijective
        (Stacks.Algebraization.ComplementTower.sectionsToLimit B b g (ModuleCat.of B B)) →
      CompletionFullyFaithfulOnFiniteLocallyFree (complementZeroLocus B b : Scheme)
        (complementPrincipalIdealSheaf B b g))
    (h0GN2 : ∀ {Z Z' : Scheme.{u}} (κ : Z' ⟶ Z) [IsClosedImmersion κ] (N : Z.Modules),
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} N →
      Stacks.Algebraization.IsInfinitesimalSectionsComplete κ
        (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf N) →
      (∀ φ ψ : N ⟶ SheafOfModules.unit Z.ringCatSheaf,
          (∀ n : ℕ, φ ≫ nthOrderUnitMap κ n = ψ ≫ nthOrderUnitMap κ n) → φ = ψ) ∧
        ∀ α : ∀ n : ℕ, N ⟶ AlgebraSheaf.underlyingModule (nthOrderAlgebra κ n),
          (∀ n : ℕ, α (n + 1) ≫ nthOrderTransitionMap κ n = α n) →
          ∃ φ : N ⟶ SheafOfModules.unit Z.ringCatSheaf,
            ∀ n : ℕ, φ ≫ nthOrderUnitMap κ n = α n)
    (halgebra : ∀ {Z : Scheme.{u}} (B C : AlgebraSheaf Z) (D : ℕ → AlgebraSheaf Z)
      (r : ∀ n : ℕ, C ⟶ D n)
      (φ : AlgebraSheaf.underlyingModule B ⟶ AlgebraSheaf.underlyingModule C),
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
        (AlgebraSheaf.underlyingModule B) →
      _root_.SheafOfModules.IsCoherent (AlgebraSheaf.underlyingModule B) →
      (∀ n : ℕ, ∃ ψ : B ⟶ D n,
        AlgebraSheaf.underlyingModuleMap ψ = φ ≫ AlgebraSheaf.underlyingModuleMap (r n)) →
      (∀ P : Z.Modules, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} P →
        _root_.SheafOfModules.IsCoherent P →
        ∀ a b : P ⟶ AlgebraSheaf.underlyingModule C,
          (∀ n : ℕ, a ≫ AlgebraSheaf.underlyingModuleMap (r n) =
            b ≫ AlgebraSheaf.underlyingModuleMap (r n)) → a = b) →
      ∃ ψ : B ⟶ C, AlgebraSheaf.underlyingModuleMap ψ = φ) :
    Nonempty (finiteEtaleBaseChange S.U₀ToU).FullyFaithful := by
  -- The henselian hypothesis is the tag's (b); it is consumed only by the reduction to the
  -- complete case, which is not performed here.
  have : HenselianPair S.A S.principalIdeal := hS
  refine fullyFaithful_finiteEtaleRestriction_of_completionFullyFaithful S
    (Stacks.Algebraization.completionFullyFaithful_of_isAdicComplete_of_depth
      S.A (maximalIdeal S.A) S.f S.f_mem_maximalIdeal omega homega hcomplete ?_ hEKP)
    h0GN2 halgebra
  intro p q hp hq _
  rw [ringKrullDim_quotient_localization_of_maximalIdeal_le S.A q hq p.asIdeal]
  exact hdepth p hp

/-- **[Stacks, Tag 0BLJ]** in the case where `A` is in addition `f`-adically complete. In the
local Lefschetz situation assume that `A` has depth at least `3` and that the pair `(A, (f))` is
henselian. Then `FÉt_U ⟶ FÉt_{U₀}` is fully faithful.

This is the source's two-line proof: depth at least `3` forces `H¹_𝔪(A) = H²_𝔪(A) = 0` by
[Stacks, Tag 0AVZ], so the annihilation hypothesis of Stacks 0BM6 holds with any exponent and
`fullyFaithful_finiteEtaleRestriction_of_annihilated` applies. The henselian hypothesis is
stated in the more general of the two forms the source offers — `(A, (f))` a henselian pair,
rather than `A` henselian — and is handed on unchanged.

The restrictions are inherited from `fullyFaithful_finiteEtaleRestriction_of_annihilated` and
are nothing beyond them: `A` is assumed `f`-adically complete, the reduction to that case
(Stacks 0BLI with Stacks 0ALZ) not being carried out, and `hEKP`, `h0GN2` and `halgebra` are
carried as discussed there. None of the three mentions `A`, `f`, `U` or `U₀`. The depth
hypothesis itself is consumed here, not carried. -/
@[stacks 0BLJ "the case where `A` is in addition `f`-adically complete, inherited from the form \
in which Stacks 0BM6 is available here: the reduction to that case (Stacks 0BLI together with \
Stacks 0ALZ) is not carried out; granted hEKP (the chain (1) ⇒ (4) of Stacks 0EKP), h0GN2 \
(Stacks 0GN2) and halgebra, all three carried as general hypotheses about other rings and other \
schemes. The passage from the depth hypothesis to the vanishing of `H¹_𝔪(A)` and `H²_𝔪(A)`, \
which is the source's own proof, is supplied unconditionally from Stacks 0AVZ"]
public theorem fullyFaithful_finiteEtaleRestriction_of_three_le_depth
    (S : LocalLefschetzSituation.{u})
    (hS : HenselianPair S.A S.principalIdeal)
    (hdepth : 3 ≤ Module.depth S.A (maximalIdeal S.A) S.A)
    (hcomplete : IsAdicComplete (Ideal.span {S.f}) S.A)
    (hEKP : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (b : Ideal B) (g : B),
      Scheme.IsQuasiAffine (complementZeroLocus B b : Scheme) →
      Function.Bijective
        (Stacks.Algebraization.ComplementTower.sectionsToLimit B b g (ModuleCat.of B B)) →
      CompletionFullyFaithfulOnFiniteLocallyFree (complementZeroLocus B b : Scheme)
        (complementPrincipalIdealSheaf B b g))
    (h0GN2 : ∀ {Z Z' : Scheme.{u}} (κ : Z' ⟶ Z) [IsClosedImmersion κ] (N : Z.Modules),
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} N →
      Stacks.Algebraization.IsInfinitesimalSectionsComplete κ
        (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf N) →
      (∀ φ ψ : N ⟶ SheafOfModules.unit Z.ringCatSheaf,
          (∀ n : ℕ, φ ≫ nthOrderUnitMap κ n = ψ ≫ nthOrderUnitMap κ n) → φ = ψ) ∧
        ∀ α : ∀ n : ℕ, N ⟶ AlgebraSheaf.underlyingModule (nthOrderAlgebra κ n),
          (∀ n : ℕ, α (n + 1) ≫ nthOrderTransitionMap κ n = α n) →
          ∃ φ : N ⟶ SheafOfModules.unit Z.ringCatSheaf,
            ∀ n : ℕ, φ ≫ nthOrderUnitMap κ n = α n)
    (halgebra : ∀ {Z : Scheme.{u}} (B C : AlgebraSheaf Z) (D : ℕ → AlgebraSheaf Z)
      (r : ∀ n : ℕ, C ⟶ D n)
      (φ : AlgebraSheaf.underlyingModule B ⟶ AlgebraSheaf.underlyingModule C),
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
        (AlgebraSheaf.underlyingModule B) →
      _root_.SheafOfModules.IsCoherent (AlgebraSheaf.underlyingModule B) →
      (∀ n : ℕ, ∃ ψ : B ⟶ D n,
        AlgebraSheaf.underlyingModuleMap ψ = φ ≫ AlgebraSheaf.underlyingModuleMap (r n)) →
      (∀ P : Z.Modules, AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} P →
        _root_.SheafOfModules.IsCoherent P →
        ∀ a b : P ⟶ AlgebraSheaf.underlyingModule C,
          (∀ n : ℕ, a ≫ AlgebraSheaf.underlyingModuleMap (r n) =
            b ≫ AlgebraSheaf.underlyingModuleMap (r n)) → a = b) →
      ∃ ψ : B ⟶ C, AlgebraSheaf.underlyingModuleMap ψ = φ) :
    Nonempty (finiteEtaleBaseChange S.U₀ToU).FullyFaithful := by
  have h3 : ((3 : ℕ) : ℕ∞) ≤ Module.depth S.A (maximalIdeal S.A) S.A := by
    exact_mod_cast hdepth
  exact fullyFaithful_finiteEtaleRestriction_of_annihilated S (Or.inr hS) hcomplete
    (exists_pow_smul_localCohomologyModule_self_eq_zero_of_lt_depth S.A 3 h3 1 (by norm_num) S.f)
    (exists_pow_smul_localCohomologyModule_self_eq_zero_of_lt_depth S.A 3 h3 2 (by norm_num) S.f)
    hEKP h0GN2 halgebra

