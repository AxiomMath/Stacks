universe u

namespace AlgebraicGeometry

/-! ### Essential images along a composite of base change functors -/

/-- **A finite étale cover reached through a composite of three morphisms, the outer two
isomorphisms.**  If a cover `Z'` of the middle target restricts to `Z` along the isomorphism `a`,
and `Z'` is itself the restriction along `b` of a cover `V`, then `Z` is the restriction of a
cover along `(a ≫ b) ≫ c` for any isomorphism `c`. -/
private lemma essImage_finiteEtaleBaseChange_comp₃ {A B C' D : Scheme.{u}} (a : A ⟶ B) (b : B ⟶ C')
    (c : C' ⟶ D) [IsIso a] [IsIso c] {Z : FiniteEtaleOver A} {Z' : FiniteEtaleOver B}
    (eZ : (finiteEtaleBaseChange a).obj Z' ≅ Z) (V : FiniteEtaleOver C')
    (eV : (finiteEtaleBaseChange b).obj V ≅ Z') :
    (finiteEtaleBaseChange ((a ≫ b) ≫ c)).essImage Z := by
  have : (finiteEtaleBaseChange c).EssSurj := essSurj_finiteEtaleBaseChange_of_isIso c
  have h1 : (finiteEtaleBaseChange b ⋙ finiteEtaleBaseChange a).essImage Z :=
    ⟨V, ⟨(finiteEtaleBaseChange a).mapIso eV ≪≫ eZ⟩⟩
  have h2 : (finiteEtaleBaseChange (a ≫ b)).essImage Z :=
    Functor.essImage.ofNatIso (finiteEtaleBaseChangeComp a b (a ≫ b) rfl).symm h1
  have h3 : (finiteEtaleBaseChange c ⋙ finiteEtaleBaseChange (a ≫ b)).essImage Z :=
    essImage_comp_of_essSurj_left _ _ h2
  exact Functor.essImage.ofNatIso
    (finiteEtaleBaseChangeComp (a ≫ b) c ((a ≫ b) ≫ c) rfl).symm h3

namespace LocalLefschetzSituation

variable (S : LocalLefschetzSituation.{u})

/-! ### Opens of `U` as neighbourhoods of `U₀` in `X` -/

/-- **An open of `U` through which `U₀ ⟶ U` factors, pushed forward to `X`, is an open `U'` of
`X` with `U₀ ⊆ U' ⊆ U`.**  Its image is contained in `U` because it is the image of an open of
`U`, and it contains `U₀` because `U₀ ⟶ X` factors through it. -/
theorem isNeighbourhood_image {W : S.U.Opens} (r : S.U₀ ⟶ W.toScheme)
    (hr : r ≫ W.ι = S.U₀ToU) :
    S.IsNeighbourhood (S.UOpen.ι ''ᵁ W) := by
  have hρ : (r ≫ (S.UOpen.ι.isoImage W).hom) ≫ (S.UOpen.ι ''ᵁ W).ι =
      S.U₀Open.ι ≫ S.X₀ToX := by
    rw [Category.assoc, Scheme.Hom.isoImage_hom_ι, ← Category.assoc, hr,
      S.U₀ToU_comp_immersion]
  refine ⟨Scheme.Opens.ι_image_le S.UOpen W, fun y hy => ?_⟩
  obtain ⟨z, hz⟩ : y ∈ Set.range (S.U₀Open.ι).base := by
    rw [Scheme.Opens.range_ι]; exact hy
  rw [Scheme.Hom.mem_preimage, ← hz, ← Scheme.Hom.comp_apply, ← hρ, Scheme.Hom.comp_apply]
  have hmem : (S.UOpen.ι ''ᵁ W).ι ((r ≫ (S.UOpen.ι.isoImage W).hom) z) ∈
      Set.range ((S.UOpen.ι ''ᵁ W).ι).base := ⟨_, rfl⟩
  rwa [Scheme.Opens.range_ι] at hmem

/-- **The canonical morphism `U₀ ⟶ U'` of the neighbourhood of
`AlgebraicGeometry.LocalLefschetzSituation.isNeighbourhood_image`**, computed through the given
factorization: it is that factorization followed by the identification of the open of `U` with
its image in `X`.  Both sides compose with the open immersion `U' ⟶ X` to `U₀ ⟶ X`. -/
theorem nbhdRestriction_image {W : S.U.Opens} (r : S.U₀ ⟶ W.toScheme)
    (hr : r ≫ W.ι = S.U₀ToU) :
    S.nbhdRestriction (S.isNeighbourhood_image r hr) =
      r ≫ (S.UOpen.ι.isoImage W).hom := by
  apply (cancel_mono (S.UOpen.ι ''ᵁ W).ι).1
  rw [S.nbhdRestriction_comp_ι, Category.assoc, Scheme.Hom.isoImage_hom_ι, ← Category.assoc, hr,
    U₀ToX, ← S.U₀ToU_comp_immersion]

/-! ### The essential surjectivity clause of Stacks 0BLV in the situation's vocabulary -/

/-- The bridge of
`AlgebraicGeometry.LocalLefschetzSituation.exists_nbhd_finiteEtale_of_isAdicComplete`, with the
open subscheme `U` of `X` and the ideal sheaf cutting out `U₀` inside it both generalized, so
that the identification of `U` with the complement of the zero locus of `𝔪` and of the ideal
sheaf with the one generated by the restriction of `f` can be substituted. -/
private theorem exists_nbhd_aux (S : LocalLefschetzSituation.{u}) (W : S.X.Opens)
    (hW : W = S.UOpen) (J : W.toScheme.IdealSheafData)
    (hJ : J = Scheme.IdealSheafData.ofIdealTop (Ideal.span
      {((Scheme.ΓSpecIso (CommRingCat.of S.A)).inv ≫ W.ι.appTop).hom S.f}))
    (hcolim : ∀ C : FiniteEtaleOver J.subscheme,
      ∃ (N : Neighborhood W.toScheme J)
        (V : FiniteEtaleOver (Neighborhood.open W.toScheme J N).toScheme),
        Nonempty ((finiteEtaleBaseChange (Neighborhood.toSchemeHom W.toScheme J N)).obj V ≅ C))
    (C : FiniteEtaleOver S.U₀) :
    ∃ (W' : S.X.Opens) (hW' : S.IsNeighbourhood W') (B : FiniteEtaleOver W'.toScheme),
      Nonempty ((finiteEtaleBaseChange (S.nbhdRestriction hW')).obj B ≅ C) := by
  subst hW
  rw [← S.ker_U₀ToU] at hJ
  subst hJ
  have hε : (asIso S.U₀ToU.toImage).hom ≫ S.U₀ToU.ker.subschemeι = S.U₀ToU :=
    S.U₀ToU.toImage_imageι
  have hεsurj : (finiteEtaleBaseChange (asIso S.U₀ToU.toImage).hom).EssSurj :=
    essSurj_finiteEtaleBaseChange_of_isIso _
  obtain ⟨N, V, ⟨e⟩⟩ :=
    hcolim ((finiteEtaleBaseChange (asIso S.U₀ToU.toImage).hom).objPreimage C)
  have hfac : ((asIso S.U₀ToU.toImage).hom ≫
      Neighborhood.toSchemeHom S.U S.U₀ToU.ker N) ≫
      (Neighborhood.open S.U S.U₀ToU.ker N).ι = S.U₀ToU := by
    rw [Category.assoc, Neighborhood.toSchemeHom_fac, hε]
  refine ⟨_, S.isNeighbourhood_image _ hfac, ?_⟩
  rw [S.nbhdRestriction_image _ hfac]
  exact essImage_finiteEtaleBaseChange_comp₃ (asIso S.U₀ToU.toImage).hom
    (Neighborhood.toSchemeHom S.U S.U₀ToU.ker N)
    (S.UOpen.ι.isoImage (Neighborhood.open S.U S.U₀ToU.ker N)).hom
    ((finiteEtaleBaseChange (asIso S.U₀ToU.toImage).hom).objObjPreimageIso C) V e

/-- The ideal sheaf `f 𝒪_U` on the complement of the zero locus of `𝔪`, written as the ideal
sheaf generated by the single global function the restriction of `f` gives. -/
private theorem idealSheafNearVanishing_eq_ofIdealTop_span_singleton
    (S : LocalLefschetzSituation.{u}) :
    idealSheafNearVanishing S.A (Ideal.span {S.f}) (maximalIdeal S.A) =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {((Scheme.ΓSpecIso (CommRingCat.of S.A)).inv ≫
          (complementZeroLocus S.A (maximalIdeal S.A)).ι.appTop).hom S.f}) := by
  show Scheme.IdealSheafData.ofIdealTop
      (Ideal.map ((Scheme.ΓSpecIso (CommRingCat.of S.A)).inv ≫
        (complementZeroLocus S.A (maximalIdeal S.A)).ι.appTop).hom (Ideal.span {S.f})) = _
  rw [Ideal.map_span, Set.image_singleton]

/-- **Every finite étale cover of `U₀` is defined over an open `U'` of `X` with `U₀ ⊆ U' ⊆ U`.**
Assume `A` is `f`-adically complete, `f` is a nonzerodivisor, and `H¹_𝔪(A/fA)` and `H²_𝔪(A/fA)`
are finite `A`-modules.  Then every finite étale cover of `U₀` is isomorphic to the restriction
of a finite étale cover of some open `U'` of `X` with `U₀ ⊆ U' ⊆ U`.

This is the essential surjectivity half of the statement that the restriction functor
`colim_{U₀ ⊆ U' ⊆ U} FÉt_{U'} ⥤ FÉt_{U₀}` is an equivalence, read in the vocabulary of the local
Lefschetz situation. -/
theorem exists_nbhd_finiteEtale_of_isAdicComplete
    (hcomplete : IsAdicComplete S.principalIdeal S.A) (hnzd : S.f ∈ nonZeroDivisors S.A)
    (hH1 : Module.Finite S.A (localCohomologyModule S.A (maximalIdeal S.A)
      (maximalIdeal S.A).fg_of_isNoetherianRing (ModuleCat.of S.A S.quotientRing) 1))
    (hH2 : Module.Finite S.A (localCohomologyModule S.A (maximalIdeal S.A)
      (maximalIdeal S.A).fg_of_isNoetherianRing (ModuleCat.of S.A S.quotientRing) 2))
    (C : FiniteEtaleOver S.U₀) :
    ∃ (W : S.X.Opens) (hW : S.IsNeighbourhood W) (B : FiniteEtaleOver W.toScheme),
      Nonempty ((finiteEtaleBaseChange (S.nbhdRestriction hW)).obj B ≅ C) := by
  refine S.exists_nbhd_aux (complementZeroLocus S.A (maximalIdeal S.A))
    S.UOpen_eq_complementZeroLocus.symm
    (idealSheafNearVanishing S.A (Ideal.span {S.f}) (maximalIdeal S.A))
    (S.idealSheafNearVanishing_eq_ofIdealTop_span_singleton) ?_ C
  exact (finiteEtaleColimitEquivalence_puncturedSpectrum_of_isAdicComplete S.A S.f
    S.f_mem_maximalIdeal hcomplete hnzd hH1 hH2).2

/-- **Every finite étale cover of `U₀` is defined over an open `U'` of `X` with `U₀ ⊆ U' ⊆ U`, as
soon as every finite étale cover of `U₀` is defined over an open neighbourhood of `U₀` inside
`U`.**  The hypothesis is the essential surjectivity clause of the restriction functor
`colim_{U₀ ⊆ U' ⊆ U} FÉt_{U'} ⥤ FÉt_{U₀}`, phrased for the punctured spectrum written as the
complement of the zero locus of `𝔪` and for `U₀` written as the closed subscheme of it cut out by
`f 𝒪_U`; the conclusion is the same clause phrased for the opens of `X` between `U₀` and `U`.

An open neighbourhood of `U₀` inside `U` and an open `U'` of `X` with `U₀ ⊆ U' ⊆ U` are the same
thing, pushed forward along the open immersion `U ⟶ X`, and `U₀` is the closed subscheme of `U`
cut out by the kernel of `U₀ ⟶ U`, which is generated by the restriction of `f`. -/
theorem exists_nbhd_finiteEtale_of_colimitEssSurj
    (hcolim : ∀ C : FiniteEtaleOver
        (idealSheafNearVanishing S.A (Ideal.span {S.f}) (maximalIdeal S.A)).subscheme,
      ∃ (N : Neighborhood (complementZeroLocus S.A (maximalIdeal S.A) : Scheme)
          (idealSheafNearVanishing S.A (Ideal.span {S.f}) (maximalIdeal S.A)))
        (V : FiniteEtaleOver (Neighborhood.open _ _ N).toScheme),
        Nonempty ((finiteEtaleBaseChange (Neighborhood.toSchemeHom _ _ N)).obj V ≅ C))
    (C : FiniteEtaleOver S.U₀) :
    ∃ (W : S.X.Opens) (hW : S.IsNeighbourhood W) (B : FiniteEtaleOver W.toScheme),
      Nonempty ((finiteEtaleBaseChange (S.nbhdRestriction hW)).obj B ≅ C) :=
  S.exists_nbhd_aux (complementZeroLocus S.A (maximalIdeal S.A))
    S.UOpen_eq_complementZeroLocus.symm
    (idealSheafNearVanishing S.A (Ideal.span {S.f}) (maximalIdeal S.A))
    (S.idealSheafNearVanishing_eq_ofIdealTop_span_singleton) hcolim C

/-! ### The two tags -/

/-- **Stacks Project, Tag 0EKA.**  Let `(A, 𝔪)` be a Noetherian local ring and let `f ∈ 𝔪`.
Assume

1. `A` is `f`-adically complete,
2. `f` is a nonzerodivisor,
3. `H¹_𝔪(A/fA)` and `H²_𝔪(A/fA)` are finite `A`-modules, and
4. purity holds for `(A_f)_𝔭` for every maximal ideal `𝔭 ⊂ A_f`.

Then the restriction functor `FÉt_U ⥤ FÉt_{U₀}` is essentially surjective.

The source proves this by the proof of Stacks 0EK9 with Stacks 0BLV in place of Stacks 0DXY, and
that is what happens here.  Hypotheses (1)–(3) are the hypotheses of Stacks 0BLV, and give an
open `U'` of `X` with `U₀ ⊆ U' ⊆ U` over which a given finite étale cover of `U₀` is already
defined.  The points of `U` outside `U'` are maximal ideals of `A_f`, so hypothesis (4) makes
purity available at each of them and the cover extends from `U'` to `U`. -/
@[stacks 0EKA "the restriction functor FÉt_U ⥤ FÉt_{U₀} is essentially surjective, under the \
tag's four hypotheses; nothing beyond them is assumed"]
theorem essSurj_finiteEtaleBaseChange_U₀ToU_of_isAdicComplete
    (hcomplete : IsAdicComplete S.principalIdeal S.A) (hnzd : S.f ∈ nonZeroDivisors S.A)
    (hH1 : Module.Finite S.A (localCohomologyModule S.A (maximalIdeal S.A)
      (maximalIdeal S.A).fg_of_isNoetherianRing (ModuleCat.of S.A S.quotientRing) 1))
    (hH2 : Module.Finite S.A (localCohomologyModule S.A (maximalIdeal S.A)
      (maximalIdeal S.A).fg_of_isNoetherianRing (ModuleCat.of S.A S.quotientRing) 2))
    (haway : ∀ (p : Ideal (Localization.Away S.f)) [p.IsMaximal],
      HasPurity (Localization.AtPrime p)) :
    (finiteEtaleBaseChange S.U₀ToU).EssSurj :=
  S.essSurj_finiteEtaleBaseChange_U₀ToU_of_forall_exists_nbhd haway
    (S.exists_nbhd_finiteEtale_of_isAdicComplete hcomplete hnzd hH1 hH2)

/-- **Stacks Project, Tag 0BPC.**  Let `(A, 𝔪)` be a Noetherian local ring and let `f ∈ 𝔪`.
Assume

1. `A` is `f`-adically complete,
2. `f` is a nonzerodivisor,
3. `H¹_𝔪(A/fA)` and `H²_𝔪(A/fA)` are finite `A`-modules,
4. purity holds for `(A_f)_𝔭` for every maximal ideal `𝔭 ⊂ A_f`, and
5. purity holds for `A`.

Then purity holds for `A / fA`.

The source proves this by the proof of Stacks 0DXZ with Stacks 0EKA in place of Stacks 0EK9, and
that is what happens here.  A finite étale cover of `U₀` is, by Stacks 0EKA, the restriction of a
finite étale cover of `U`; hypothesis (5) extends the latter over `X`; and the restriction of that
extension to `X₀ = Spec (A / fA)` is the extension of the original cover. -/
@[stacks 0BPC "purity for A/fA under the tag's five hypotheses; nothing beyond them is assumed"]
theorem hasPurity_quotientRing_of_isAdicComplete
    (hcomplete : IsAdicComplete S.principalIdeal S.A) (hnzd : S.f ∈ nonZeroDivisors S.A)
    (hH1 : Module.Finite S.A (localCohomologyModule S.A (maximalIdeal S.A)
      (maximalIdeal S.A).fg_of_isNoetherianRing (ModuleCat.of S.A S.quotientRing) 1))
    (hH2 : Module.Finite S.A (localCohomologyModule S.A (maximalIdeal S.A)
      (maximalIdeal S.A).fg_of_isNoetherianRing (ModuleCat.of S.A S.quotientRing) 2))
    (haway : ∀ (p : Ideal (Localization.Away S.f)) [p.IsMaximal],
      HasPurity (Localization.AtPrime p))
    (hpurity : HasPurity S.A) :
    HasPurity S.quotientRing :=
  S.hasPurity_quotientRing_of_forall_exists_nbhd haway
    (S.exists_nbhd_finiteEtale_of_isAdicComplete hcomplete hnzd hH1 hH2) hpurity

end LocalLefschetzSituation

