/-!
# Frobenius elements and topological generation of the fundamental group

Let `X` be a connected scheme and `x` a closed point of `X` whose residue field `κ(x)` is
finite. A choice of algebraic closure `Ω` of `κ(x)` gives a geometric point of `X` above `x`,
the arithmetic Frobenius `a ↦ a ^ #κ(x)` is an element of `Gal(Ω/κ(x)) = π₁(Spec κ(x))`, and
pushing it forward along `Spec κ(x) ⟶ X` produces an element of `π₁(X)` at that geometric
point. A further choice of isomorphism between the fibre functor there and the fibre functor at
a fixed base point transports it into `π₁(X, base)`. The elements obtained this way, as the two
choices vary, are the *Frobenius elements* at `x`; they form a full conjugacy class.

This module supplies the group-theoretic half of Stacks 03W5: Frobenius elements that lie in no
proper open normal subgroup generate `π₁(X)` topologically. The tag itself, for a smooth,
geometrically irreducible, proper curve over a finite field, is
`AlgebraicGeometry.exists_finite_closedPoints_frobeniusElements_topologicalClosure_eq_top` in
`StacksFrontier.AlgebraicGeometry.FundamentalGroup.FrobeniusSplitting.Generation`.

## Main definitions

* `AlgebraicGeometry.FrobeniusData` — the choices producing a Frobenius element at a closed
  point: an algebraic closure of the residue field and a path to the base point.
* `AlgebraicGeometry.FrobeniusData.element` — the resulting Frobenius element of `π₁(X, base)`.
* `AlgebraicGeometry.frobeniusElements` — all Frobenius elements at a family of closed points.

## Main results

* `Stacks.FundamentalGroup.exists_isOpen_normal_of_isClosed_of_ne_top` — in a profinite group a
  proper closed normal subgroup is contained in a proper open normal subgroup.
* `Stacks.FundamentalGroup.topologicalClosure_closure_eq_top_of_forall_isOpen_normal` — a
  conjugation-stable subset of a profinite group generates topologically as soon as it is
  contained in no proper open normal subgroup.
* `AlgebraicGeometry.frobeniusElements_conj_mem` — the Frobenius elements at a family of closed
  points are stable under conjugation.
* `AlgebraicGeometry.frobeniusElements_topologicalClosure_eq_top` — Frobenius elements lying in no
  proper open normal subgroup topologically generate `π₁(X, base)`.

## Implementation notes

`FrobeniusData` bundles the finiteness of the residue field, so that the Frobenius element is
available exactly at those closed points for which it is defined.

The arithmetic input of the source proof, the Riemann hypothesis for curves over a finite field
that makes one degree bound `N` suffice for every proper open normal subgroup at once, is proved
in `StacksFrontier.AlgebraicGeometry.FundamentalGroup.FrobeniusSplitting.Generation`. The rest of
the
argument is proved here: the subgroup generated by a conjugation-stable set is normal, and a
proper closed normal subgroup of a profinite group is contained in a proper open normal
subgroup.

## References

* [Stacks Project, Tag 03W5](https://stacks.math.columbia.edu/tag/03W5)
-/

@[expose] public noncomputable section

open CategoryTheory

universe u

namespace Stacks.FundamentalGroup

open scoped Pointwise

/-- The subgroup generated by a conjugation-stable subset of a group is normal. -/
public theorem normal_closure_of_conj_mem {G : Type*} [Group G] {T : Set G}
    (hconj : ∀ g : G, ∀ t ∈ T, g * t * g⁻¹ ∈ T) : (Subgroup.closure T).Normal := by
  refine ⟨fun n hn g ↦ ?_⟩
  have hmap : (Subgroup.closure T).map (MulAut.conj g).toMonoidHom ≤ Subgroup.closure T := by
    rw [MonoidHom.map_closure]
    refine (Subgroup.closure_le _).2 ?_
    rintro y ⟨t, ht, rfl⟩
    exact Subgroup.subset_closure (hconj g t ht)
  exact hmap ⟨n, hn, rfl⟩

/-- In a profinite group every proper closed normal subgroup is contained in a proper open
normal subgroup. -/
public theorem exists_isOpen_normal_of_isClosed_of_ne_top {G : Type*} [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G]
    (Γ : Subgroup G) [Γ.Normal] (hclosed : IsClosed (Γ : Set G)) (hne : Γ ≠ ⊤) :
    ∃ U : Subgroup G, U.Normal ∧ IsOpen (U : Set G) ∧ Γ ≤ U ∧ U ≠ ⊤ := by
  obtain ⟨g, hg⟩ : ∃ g : G, g ∉ Γ := by
    by_contra hall
    exact hne (eq_top_iff.2 fun x _ ↦ not_not.1 fun h ↦ hall ⟨x, h⟩)
  have hopen : IsOpen ((g • (Γ : Set G))ᶜ) :=
    ((Homeomorph.mulLeft g).isClosedMap _ hclosed).isOpen_compl
  have hone : (1 : G) ∈ (g • (Γ : Set G))ᶜ := by
    refine Set.mem_compl fun ⟨l, hl, (hgl : g * l = 1)⟩ ↦ ?_
    rw [← inv_eq_iff_mul_eq_one] at hgl
    exact hg (inv_mem_iff.mp (hgl ▸ hl))
  obtain ⟨N, hN⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hopen hone
  refine ⟨N.toOpenSubgroup.toSubgroup ⊔ Γ, inferInstance,
    Subgroup.isOpen_mono le_sup_left N.toOpenSubgroup.isOpen, le_sup_right, fun htop ↦ ?_⟩
  obtain ⟨y, hy, z, hz, hyz⟩ :=
    Subgroup.mem_sup_of_normal_left.mp (htop ▸ Subgroup.mem_top g)
  rw [← eq_mul_inv_iff_mul_eq] at hyz
  exact hN (hyz ▸ hy) (mem_leftCoset g (inv_mem_iff.mpr hz))

/-- A conjugation-stable subset of a profinite group generates the whole group topologically
as soon as it is contained in no proper open normal subgroup. -/
public theorem topologicalClosure_closure_eq_top_of_forall_isOpen_normal {G : Type*} [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G]
    {T : Set G} (hconj : ∀ g : G, ∀ t ∈ T, g * t * g⁻¹ ∈ T)
    (hgen : ∀ U : Subgroup G, U.Normal → IsOpen (U : Set G) → T ⊆ (U : Set G) → U = ⊤) :
    (Subgroup.closure T).topologicalClosure = ⊤ := by
  have hn : (Subgroup.closure T).Normal := normal_closure_of_conj_mem hconj
  have hΓ : (Subgroup.closure T).topologicalClosure.Normal :=
    Subgroup.is_normal_topologicalClosure _
  by_contra hne
  obtain ⟨U, hUnormal, hUopen, hle, hUne⟩ :=
    exists_isOpen_normal_of_isClosed_of_ne_top (Subgroup.closure T).topologicalClosure
      (Subgroup.isClosed_topologicalClosure _) hne
  exact hUne (hgen U hUnormal hUopen fun t ht ↦
    hle (Subgroup.le_topologicalClosure _ (Subgroup.subset_closure ht)))

end Stacks.FundamentalGroup

namespace AlgebraicGeometry

variable {X : Scheme.{u}} [ConnectedSpace X]

/-- The choices producing a Frobenius element at a closed point `x` with finite residue field:
an algebraic closure of `κ(x)`, which gives a geometric point of `X` above `x`, and an
isomorphism of the fibre functor there with the fibre functor at the base point. -/
public structure FrobeniusData (base : GeometricPoint X) (x : closedPoints X) where
  /-- An algebraic closure of the residue field at `x`. -/
  closure : Type u
  [field_closure : Field closure]
  [algebra_closure : Algebra (X.residueField x.1) closure]
  [isSepClosure_closure : IsSepClosure (X.residueField x.1) closure]
  [isAlgClosed_closure : IsAlgClosed closure]
  /-- The residue field at `x` is finite. -/
  finite_residueField : Finite (X.residueField x.1)
  /-- An isomorphism transporting the fibre functor at the geometric point above `x` to the
  fibre functor at the base point. -/
  path : finiteEtaleFiberFunctor
      ((algebraicClosureGeometricPoint (X.residueField x.1) closure).map
        (X.fromSpecResidueField x.1)) ≅ finiteEtaleFiberFunctor base

namespace FrobeniusData

attribute [instance] field_closure algebra_closure isSepClosure_closure isAlgClosed_closure

variable {base : GeometricPoint X} {x : closedPoints X}

/-- The image in `π₁(X)` at the geometric point above `x` of the arithmetic Frobenius of the
residue field at `x`, before transport to the base point. -/
public def localElement (c : FrobeniusData base x) :
    EtaleFundamentalGroup X
      ((algebraicClosureGeometricPoint (X.residueField x.1) c.closure).map
        (X.fromSpecResidueField x.1)) :=
  have : Finite (X.residueField x.1) := c.finite_residueField
  let _ : Fintype (X.residueField x.1) := Fintype.ofFinite _
  etaleFundamentalGroupMap (X.fromSpecResidueField x.1)
    (algebraicClosureGeometricPoint (X.residueField x.1) c.closure)
    (galoisEquivEtaleFundamentalGroup (X.residueField x.1) c.closure c.closure
      (FiniteField.frobeniusAlgEquivOfAlgebraic (X.residueField x.1) c.closure))

/-- The Frobenius element of `π₁(X, base)` determined by the choices `c`. -/
public def element (c : FrobeniusData base x) : EtaleFundamentalGroup X base :=
  etaleFundamentalGroupMulEquiv c.path c.localElement

/-- Composing the path with an element of `π₁(X, base)` conjugates the Frobenius element by
that element. -/
public theorem element_path_trans (c : FrobeniusData base x) (g : EtaleFundamentalGroup X base) :
    ({c with path := c.path ≪≫ g.asIso} : FrobeniusData base x).element =
      g * c.element * g⁻¹ :=
  (Iso.trans_conjAut c.path g.asIso c.localElement).trans
    (Aut.ext (by rw [Iso.conjAut_apply]; rfl))

end FrobeniusData

/-- All Frobenius elements of `π₁(X, base)` at the closed points of a family `S`. -/
public def frobeniusElements (base : GeometricPoint X) (S : Set (closedPoints X)) :
    Set (EtaleFundamentalGroup X base) :=
  {g | ∃ x ∈ S, ∃ c : FrobeniusData base x, c.element = g}

/-- The Frobenius elements at a family of closed points are stable under conjugation: they are a
union of conjugacy classes. -/
public theorem frobeniusElements_conj_mem {base : GeometricPoint X} {S : Set (closedPoints X)}
    (g : EtaleFundamentalGroup X base) {t : EtaleFundamentalGroup X base}
    (ht : t ∈ frobeniusElements base S) : g * t * g⁻¹ ∈ frobeniusElements base S := by
  obtain ⟨x, hx, c, rfl⟩ := ht
  exact ⟨x, hx, _, c.element_path_trans g⟩

/-- If the Frobenius elements at a family of closed points lie in no proper open normal subgroup
of `π₁(X, base)`, then they topologically generate it. -/
public theorem frobeniusElements_topologicalClosure_eq_top (base : GeometricPoint X)
    (S : Set (closedPoints X))
    (hgen : ∀ U : Subgroup (EtaleFundamentalGroup X base), U.Normal →
      IsOpen (U : Set (EtaleFundamentalGroup X base)) →
      frobeniusElements base S ⊆ (U : Set (EtaleFundamentalGroup X base)) → U = ⊤) :
    (Subgroup.closure (frobeniusElements base S)).topologicalClosure = ⊤ := by
  have := compactSpace_etaleFundamentalGroup X base
  have := totallyDisconnectedSpace_etaleFundamentalGroup X base
  exact Stacks.FundamentalGroup.topologicalClosure_closure_eq_top_of_forall_isOpen_normal
    (fun g _ ht ↦ frobeniusElements_conj_mem g ht) hgen

end AlgebraicGeometry

end
