/-!
# Tame covers along discrete valuation rings

In the situation of Abhyankar's lemma for a regular divisor ([Stacks, Tag 0EYG]), let
`π : Y' ⟶ X` be the normalization of `X` in `Y` ([Stacks, Tag 0EYH]). For a discrete valuation
ring `R` and a morphism `t : Spec R ⟶ X` meeting `D` exactly in the reduced closed point, `Y'` is
étale along lifts of `t`, and finite étale near `t(Spec R)` when the generic fibre of `Y` over
`Spec R` splits completely ([Stacks, Tag 0EYI]).

## Main results

* `AlgebraicGeometry.TameCovers.exists_lift_etaleAt_fromNormalization`: Tag 0EYI (1).
* `AlgebraicGeometry.TameCovers.exists_opens_etale_fromNormalization`: Tag 0EYI (2).
* `AlgebraicGeometry.TameCovers.etaleAt_fromNormalization_closedPoint`: the key step, `e = 1`
  for the component of the chart through a lift.

## Implementation notes

The source works with the local ring `R'` of `Spec R ×_X U` above the closed point, a discrete
valuation ring unramified over `R` in which `φ` is a uniformizer, and with the fact that
`R'[x]/(x^e - π)` is a discrete valuation ring. Here only the following is used: `R'` is local,
its maximal ideal is generated by the image of `φ` (computed through the stalks of the inverse
images of `D`, using that `R ⟶ R'` is étale) and is nonzero (`R ⟶ R'` is faithfully flat); a root
of `x^e = φ` in `R'` then forces `e = 1` by Nakayama's lemma. For (2), instead of the chart the
source's reduction "the assumption implies `e_i = 1`" is replaced by lifting each point of `Y'`
over the closed point through a `K`-point of the generic fibre, so that (1) applies.

Abhyankar's lemma itself is
`AlgebraicGeometry.exists_etale_standardTamelyRamified_of_isTamelyRamifiedInCodimensionOne`
([Stacks, Tag 0EYG]), which takes the named argument `h0EYD` (tameness pulls back,
[Stacks, Tag 0EYD]). It is threaded through as a hypothesis.

## References

* [Stacks Project, Tag 0EYI](https://stacks.math.columbia.edu/tag/0EYI)
* [Stacks Project, Tag 0EYH](https://stacks.math.columbia.edu/tag/0EYH)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.TameCovers

/-- A regular closed subscheme is reduced. -/
theorem isReduced_subscheme_of_isRegularLocalRing {X : Scheme.{u}} (D : X.IdealSheafData)
    (hDreg : ∀ z : D.subscheme, IsRegularLocalRing (D.subscheme.presheaf.stalk z)) :
    IsReduced D.subscheme := by
  have : ∀ z : D.subscheme, _root_.IsReduced (D.subscheme.presheaf.stalk z) := fun z ↦ by
    have := hDreg z
    have := IsRegularLocalRing.isDomain (D.subscheme.presheaf.stalk z)
    infer_instance
  exact isReduced_of_isReduced_stalk _

/-- In the chart of Tag 0EYG, the inverse image of the regular divisor `D` is, scheme
theoretically, the zero scheme of `φ`: both are reduced with support `V(φ)`. -/
theorem comap_eq_ker_specMap_quotient {X : Scheme.{u}} (D : X.IdealSheafData)
    (hDreg : ∀ z : D.subscheme, IsRegularLocalRing (D.subscheme.presheaf.stalk z))
    {A : CommRingCat.{u}} (g : Spec A ⟶ X) [Etale g] (φ : A)
    (hreg : IsRegularRing (A ⧸ Ideal.span {φ}))
    {gU : Spec (.of (Localization.Away φ)) ⟶ (D.support.compl : X.Opens)}
    (hpb : IsPullback gU (Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away φ))))
      (Scheme.Opens.ι (D.support.compl : X.Opens)) g) :
    D.comap g = (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {φ})))).ker := by
  refine Scheme.IdealSheafData.eq_of_isReduced_subscheme_of_support_eq _ _
    (Scheme.IdealSheafData.isReduced_subscheme_comap D g
      (isReduced_subscheme_of_isRegularLocalRing D hDreg))
    (isReduced_subscheme_ker_specMap_quotient A φ hreg) (TopologicalSpace.Closeds.ext ?_)
  rw [coe_support_ker_specMap_quotient A φ, Scheme.IdealSheafData.support_comap,
    TopologicalSpace.Closeds.coe_preimage]
  exact preimage_support_eq_zeroLocus D g φ hpb

/-- The local ring at the closed point of the spectrum of a discrete valuation ring is not a
field. -/
theorem maximalIdeal_stalk_ne_bot (R : Type u) [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] (x : Spec (.of R)) (hx : x = IsLocalRing.closedPoint R) :
    IsLocalRing.maximalIdeal ((Spec (.of R)).presheaf.stalk x) ≠ ⊥ := by
  let e := ((Spec (.of R)).presheaf.stalkCongr (Inseparable.of_eq hx) ≪≫
    stalkClosedPointIso (CommRingCat.of R)).commRingCatIsoToRingEquiv
  intro h
  apply IsDiscreteValuationRing.not_a_field R
  have := IsLocalRing.map_ringEquiv_maximalIdeal e
  rw [h, Ideal.map_bot] at this
  exact this.symm

/-- Étale morphism with `e = 1`: the standard morphism `Spec(A[x]/(x - φ)) ⟶ Spec(A)` is an
isomorphism, hence étale. -/
theorem etale_standardTamelyRamifiedMorphism_one (A : Type u) [CommRing A] (φ : A) :
    Etale (standardTamelyRamifiedMorphism A φ 1) := by
  have eq : Ideal.span {(Polynomial.X ^ 1 - Polynomial.C φ : Polynomial A)} =
      Ideal.span {Polynomial.X - Polynomial.C φ} := by rw [pow_one]
  let σ : standardTamelyRamifiedAlgebra A φ 1 ≃ₐ[A] A :=
    (Ideal.quotientEquivAlgOfEq A eq).trans (Polynomial.quotientSpanXSubCAlgEquiv φ)
  have hbij : Function.Bijective (algebraMap A (standardTamelyRamifiedAlgebra A φ 1)) := by
    have : (algebraMap A (standardTamelyRamifiedAlgebra A φ 1)) = σ.symm.toRingHom := by
      ext a; simp
    rw [this]; exact σ.symm.bijective
  have : IsIso (CommRingCat.ofHom (algebraMap A (standardTamelyRamifiedAlgebra A φ 1))) :=
    (RingEquiv.ofBijective _ hbij).toCommRingCatIso.isIso_hom
  change Etale (Spec.map (CommRingCat.ofHom (algebraMap A (standardTamelyRamifiedAlgebra A φ 1))))
  infer_instance

/-- In a local ring whose maximal ideal is generated by `a` and is nonzero, `a` has no `e`-th
root for `e ≥ 2`: such a root lies in the maximal ideal, so `a` would lie in its square and the
maximal ideal would vanish by Nakayama's lemma. -/
theorem eq_one_of_pow_eq_of_span_eq_maximalIdeal {S : Type u} [CommRing S] [IsLocalRing S]
    {a c : S} {e : ℕ} (he : 0 < e) (hspan : Ideal.span {a} = IsLocalRing.maximalIdeal S)
    (hne : IsLocalRing.maximalIdeal S ≠ ⊥) (hc : c ^ e = a) : e = 1 := by
  have ha : a ∈ IsLocalRing.maximalIdeal S := hspan ▸ Ideal.mem_span_singleton_self a
  have hcm : c ∈ IsLocalRing.maximalIdeal S := by
    by_contra hcn
    have hcu : IsUnit c := by
      by_contra h'
      exact hcn ((IsLocalRing.mem_maximalIdeal c).mpr h')
    exact (IsLocalRing.mem_maximalIdeal a).mp ha (hc ▸ hcu.pow e)
  by_contra he1
  have he2 : 2 ≤ e := by omega
  have hle : IsLocalRing.maximalIdeal S ≤
      IsLocalRing.maximalIdeal S • IsLocalRing.maximalIdeal S := by
    rw [← hspan, Ideal.span_le, Set.singleton_subset_iff, hspan, Ideal.smul_eq_mul, ← hc,
      ← Nat.sub_add_cancel he2, pow_add, pow_two]
    exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_mul hcm hcm)
  have hfg : (IsLocalRing.maximalIdeal S).FG := hspan ▸ Submodule.fg_span_singleton a
  exact hne (Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _ hfg hle
    (IsLocalRing.maximalIdeal_le_jacobson ⊥))

/-- An open set of the target of `g : Spec R ⟶ Z`, `R` local, containing the image of the closed
point contains the image of `Spec R`. -/
private theorem apply_mem_of_closedPoint_mem {R : CommRingCat.{u}} [IsLocalRing R]
    {Z : Scheme.{u}} (g : Spec R ⟶ Z) {U : Set Z} (hU : IsOpen U)
    (h : g (IsLocalRing.closedPoint R) ∈ U) (r : Spec R) : g r ∈ U :=
  ((IsLocalRing.specializes_closedPoint r).map g.continuous).mem_open hU h

section

variable (h0EYD : ∀ S : Stacks.FundamentalGroup.CodimensionOnePullbackSetup.{u},
      Stacks.FundamentalGroup.IsTamelyRamifiedInCodimensionOne S.U.ι S.f →
      Stacks.FundamentalGroup.IsTamelyRamifiedInCodimensionOne (pullback.fst S.g S.U.ι)
        S.pulledBackCover)

include h0EYD in
/-- **The ramification indices along a lift are trivial.** In the situation of [Stacks, Tag 0EYI],
let `t' : Spec R ⟶ Y'` be a lift of `t` to the normalization. Then `Y' ⟶ X` is étale at the
image of the closed point: in the chart of Tag 0EYH, the local ring `R'` of
`Spec R ×_X Spec A` above the closed point is unramified over `R`, so `φ` generates its maximal
ideal; the root of `x^e = φ` in `R'` given by `t'` forces `e = 1`. -/
theorem etaleAt_fromNormalization_closedPoint {X : Scheme.{u}} [IsLocallyNoetherian X]
    (D : X.IdealSheafData) (hD : Stacks.Divisors.IsEffectiveCartierDivisor D)
    (hDreg : ∀ z : D.subscheme, IsRegularLocalRing (D.subscheme.presheaf.stalk z))
    {Y : Scheme.{u}} (f : Y ⟶ (D.support.compl : X.Opens)) [IsFinite f] [Etale f]
    (hf : Stacks.FundamentalGroup.IsTamelyRamifiedInCodimensionOne
      (Scheme.Opens.ι (D.support.compl : X.Opens)) f)
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (t : Spec (.of R) ⟶ X)
    (ht : D.comap t = Scheme.IdealSheafData.vanishingIdeal
      ⟨({IsLocalRing.closedPoint R} : Set (Spec (.of R))),
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr
          (IsLocalRing.maximalIdeal.isMaximal R)⟩)
    (t' : Spec (.of R) ⟶ (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).normalization)
    (ht' : t' ≫ (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).fromNormalization = t) :
    EtaleAt (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).fromNormalization
      (t' (IsLocalRing.closedPoint R)) := by
  set π := (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).fromNormalization with hπ
  set s : Spec (.of R) := IsLocalRing.closedPoint R with hs
  have hflf := isFiniteLocallyFree_fromNormalization h0EYD D hD hDreg f hf
  obtain ⟨-, -, hlfp⟩ :=
    (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_locallyOfFinitePresentation π).mp hflf
  obtain ⟨A, g, hg, a, hga, φ, hA, hφ, hreg, gU, hpb, n, e, he, ι, hι⟩ :=
    exists_etale_chart_normalization h0EYD D hD hDreg f hf (t s)
  let p₁ := pullback.fst t g
  let p₂ := pullback.snd t g
  obtain ⟨w, hw₁, hw₂⟩ := Scheme.Pullback.exists_preimage_pullback (f := t) (g := g) s a hga.symm
  let T' : pullback t g ⟶ pullback π g := pullback.lift (p₁ ≫ t') p₂ (by
    rw [Category.assoc, ht', pullback.condition])
  have hT'fst : T' ≫ pullback.fst π g = p₁ ≫ t' := pullback.lift_fst _ _ _
  have hT'snd : T' ≫ pullback.snd π g = p₂ := pullback.lift_snd _ _ _
  obtain ⟨i, v, hv⟩ := (sigmaOpenCover
    (fun i ↦ Spec (.of (standardTamelyRamifiedAlgebra A φ (e i))))).exists_eq (ι.hom (T' w))
  change Sigma.ι (fun i ↦ Spec (.of (standardTamelyRamifiedAlgebra A φ (e i)))) i v = _ at hv
  have : NeZero (e i) := ⟨(he i).1.ne'⟩
  have hdesc : Sigma.ι (fun i ↦ Spec (.of (standardTamelyRamifiedAlgebra A φ (e i)))) i ≫
      Sigma.desc (fun i ↦ standardTamelyRamifiedMorphism A φ (e i)) =
        standardTamelyRamifiedMorphism A φ (e i) := Sigma.ι_comp_desc _ _
  -- the key claim: the ramification index of the component is one
  have hei : e i = 1 := by
    let R' := (pullback t g).presheaf.stalk w
    let h0 : Spec R' ⟶ ∐ fun i ↦ Spec (.of (standardTamelyRamifiedAlgebra A φ (e i))) :=
      (pullback t g).fromSpecStalk w ≫ T' ≫ ι.hom
    have hrange : Set.range h0 ⊆ Set.range (Sigma.ι
        (fun i ↦ Spec (.of (standardTamelyRamifiedAlgebra A φ (e i)))) i) := by
      rintro _ ⟨p, rfl⟩
      have hcl : h0 (IsLocalRing.closedPoint R') = Sigma.ι
          (fun i ↦ Spec (.of (standardTamelyRamifiedAlgebra A φ (e i)))) i v := by
        change ι.hom (T' ((pullback t g).fromSpecStalk w (IsLocalRing.closedPoint R'))) = _
        rw [Scheme.fromSpecStalk_closedPoint, hv]
      exact apply_mem_of_closedPoint_mem h0
        (Sigma.ι (fun i ↦ Spec (.of (standardTamelyRamifiedAlgebra A φ (e i)))) i
          ).isOpenEmbedding.isOpen_range ⟨v, hcl.symm⟩ p
    let ζ := IsOpenImmersion.lift (Sigma.ι
      (fun i ↦ Spec (.of (standardTamelyRamifiedAlgebra A φ (e i)))) i) h0 hrange
    have hζ : ζ ≫ Sigma.ι (fun i ↦ Spec (.of (standardTamelyRamifiedAlgebra A φ (e i)))) i = h0 :=
      IsOpenImmersion.lift_fac _ _ _
    let β := Spec.preimage ζ
    have hβ : Spec.map β = ζ := Spec.map_preimage ζ
    let α : A ⟶ R' := (Scheme.ΓSpecIso A).inv ≫ p₂.appTop ≫
      (pullback t g).presheaf.germ ⊤ w trivial
    let ψi : A ⟶ CommRingCat.of (standardTamelyRamifiedAlgebra A φ (e i)) :=
      CommRingCat.ofHom (algebraMap A (standardTamelyRamifiedAlgebra A φ (e i)))
    have hSα : Spec.map α = (pullback t g).fromSpecStalk w ≫ p₂ := by
      apply ext_of_isAffine
      rw [Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop]
      rw [← Iso.hom_inv_id_assoc (Scheme.ΓSpecIso A) (Spec.map α).appTop,
        ← Scheme.ΓSpecIso_inv_naturality]
      simp only [α, Category.assoc, Iso.hom_inv_id_assoc]
      congr 2
    have hι' : ι.hom ≫ Sigma.desc (fun i ↦ standardTamelyRamifiedMorphism A φ (e i)) =
        pullback.snd π g := hι
    have hαβ : ψi ≫ β = α := by
      apply Spec.map_injective
      rw [Spec.map_comp, hβ, hSα]
      change ζ ≫ standardTamelyRamifiedMorphism A φ (e i) = _
      rw [← hdesc, ← Category.assoc, hζ]
      simp only [h0, Category.assoc]
      rw [hι', hT'snd]
    -- the maximal ideal of `R'` is generated by the image of `φ`
    have hEt : EtaleAt p₁ w := (etale_iff_forall_etaleAt p₁).mp inferInstance w
    obtain ⟨hp₁flat, hmax₁, -⟩ := ((etaleAt_tfae p₁ w).out 1 7).mp hEt
    have hcomap : (D.comap g).comap p₂ = (D.comap t).comap p₁ := by
      rw [← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp,
        pullback.condition]
    have hD' : D.comap t = Scheme.IdealSheafData.vanishingIdeal
        ⟨({p₁ w} : Set (Spec (.of R))), by
          rw [hw₁]; exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr
            (IsLocalRing.maximalIdeal.isMaximal R)⟩ := by
      rw [ht]; congr 2; rw [hw₁]; rfl
    have hstalk₁ : IdealSheafData.stalk ((D.comap t).comap p₁) w =
        IsLocalRing.maximalIdeal R' := by
      rw [IdealSheafData.stalk_comap, hD',
        Stacks.Divisors.stalk_vanishingIdeal_singleton_of_isClosed]
      exact hmax₁
    have hstalk₂ : IdealSheafData.stalk ((D.comap g).comap p₂) w = Ideal.span {α φ} := by
      rw [IdealSheafData.stalk_comap, comap_eq_ker_specMap_quotient D hDreg g φ hreg hpb,
        IdealSheafData.stalk_eq_map_germ _ (p₂ w) ⟨⊤, isAffineOpen_top _⟩ trivial,
        Scheme.ker_of_isAffine, Stacks.Divisors.ideal_ofIdealTop_top, ker_appTop_specMap_quotient,
        Ideal.map_span, Set.image_singleton, Ideal.map_span, Set.image_singleton]
      congr 2
      change p₂.stalkMap w ((Spec A).presheaf.germ ⊤ (p₂ w) trivial
        ((Scheme.ΓSpecIso A).inv φ)) = _
      exact (Scheme.Hom.germ_stalkMap_apply p₂ ⊤ w trivial _).trans rfl
    have hspan : Ideal.span {α φ} = IsLocalRing.maximalIdeal R' := by
      rw [← hstalk₂, hcomap, hstalk₁]
    -- `R'` is not a field
    have hne : IsLocalRing.maximalIdeal R' ≠ ⊥ := by
      let := (p₁.stalkMap w).hom.toAlgebra
      have : Module.Flat _ R' := hp₁flat
      have : IsLocalHom (algebraMap ((Spec (.of R)).presheaf.stalk (p₁ w)) R') :=
        inferInstanceAs (IsLocalHom (p₁.stalkMap w).hom)
      have : Module.FaithfullyFlat ((Spec (.of R)).presheaf.stalk (p₁ w)) R' :=
        Module.FaithfullyFlat.of_flat_of_isLocalHom
      have hinj := FaithfulSMul.algebraMap_injective ((Spec (.of R)).presheaf.stalk (p₁ w)) R'
      obtain ⟨m0, hm0, hm0ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot
        (maximalIdeal_stalk_ne_bot R (p₁ w) hw₁)
      intro hbot
      rw [← hmax₁, Ideal.map_eq_bot_iff_le_ker] at hbot
      have h0 : algebraMap ((Spec (.of R)).presheaf.stalk (p₁ w)) R' m0 = 0 :=
        RingHom.mem_ker.mp (hbot hm0)
      exact hm0ne (hinj (h0.trans (map_zero _).symm))
    -- the root
    have hroot : β (Abhyankar.root A φ (e i)) ^ e i = α φ := by
      rw [← map_pow, Abhyankar.root_pow, ← hαβ]
      rfl
    exact eq_one_of_pow_eq_of_span_eq_maximalIdeal (he i).1 hspan hne hroot
  have hzP : pullback.fst π g (T' w) = t' s := by
    rw [← Scheme.Hom.comp_apply, hT'fst, Scheme.Hom.comp_apply, hw₁]
  rw [← hzP, etaleAt_iff_of_isPullback (IsPullback.of_hasPullback π g) (Or.inr inferInstance)]
  rw [← hι]
  apply etaleAt_isIso_comp
  rw [← hv]
  apply etaleAt_of_open_precomp
  have : Etale (standardTamelyRamifiedMorphism A φ (e i)) :=
    hei ▸ etale_standardTamelyRamifiedMorphism_one A φ
  have key := (etale_iff_forall_etaleAt _).mp this v
  rwa [← hdesc] at key

include h0EYD in
/-- In the situation of [Stacks, Tag 0EYI], the normalization is étale along the image of any
lift `t' : Spec R ⟶ Y'` of `t`. -/
theorem etaleAt_fromNormalization_of_lift {X : Scheme.{u}} [IsLocallyNoetherian X]
    (D : X.IdealSheafData) (hD : Stacks.Divisors.IsEffectiveCartierDivisor D)
    (hDreg : ∀ z : D.subscheme, IsRegularLocalRing (D.subscheme.presheaf.stalk z))
    {Y : Scheme.{u}} (f : Y ⟶ (D.support.compl : X.Opens)) [IsFinite f] [Etale f]
    (hf : Stacks.FundamentalGroup.IsTamelyRamifiedInCodimensionOne
      (Scheme.Opens.ι (D.support.compl : X.Opens)) f)
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (t : Spec (.of R) ⟶ X)
    (ht : D.comap t = Scheme.IdealSheafData.vanishingIdeal
      ⟨({IsLocalRing.closedPoint R} : Set (Spec (.of R))),
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr
          (IsLocalRing.maximalIdeal.isMaximal R)⟩)
    (t' : Spec (.of R) ⟶ (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).normalization)
    (ht' : t' ≫ (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).fromNormalization = t)
    (r : Spec (.of R)) :
    EtaleAt (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).fromNormalization (t' r) :=
  apply_mem_of_closedPoint_mem t' (isOpen_setOf_etaleAt _)
    (etaleAt_fromNormalization_closedPoint h0EYD D hD hDreg f hf R t ht t' ht') r

include h0EYD in
/-- **Stacks Project, Tag 0EYI (1).** In the situation of Abhyankar's lemma for a regular divisor
([Stacks, Tag 0EYG]), let `π : Y' ⟶ X` be the normalization of `X` in `Y` (Tag 0EYH), let `R` be
a discrete valuation ring with fraction field `K` and `t : Spec R ⟶ X` a morphism such that the
scheme theoretic inverse image `t⁻¹D` is the reduced closed point of `Spec R`. If `t|_{Spec K}`
lifts to a point `y` of `Y`, then there is a lift `t' : Spec R ⟶ Y'` of `t` extending `y`, and
`Y' ⟶ X` is étale along `t'(Spec R)`.

The argument `h0EYD` ([Stacks, Tag 0EYD]) is that of Abhyankar's lemma, [Stacks, Tag 0EYG]. -/
theorem exists_lift_etaleAt_fromNormalization {X : Scheme.{u}} [IsLocallyNoetherian X]
    (D : X.IdealSheafData) (hD : Stacks.Divisors.IsEffectiveCartierDivisor D)
    (hDreg : ∀ z : D.subscheme, IsRegularLocalRing (D.subscheme.presheaf.stalk z))
    {Y : Scheme.{u}} (f : Y ⟶ (D.support.compl : X.Opens)) [IsFinite f] [Etale f]
    (hf : Stacks.FundamentalGroup.IsTamelyRamifiedInCodimensionOne
      (Scheme.Opens.ι (D.support.compl : X.Opens)) f)
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
    (t : Spec (.of R) ⟶ X)
    (ht : D.comap t = Scheme.IdealSheafData.vanishingIdeal
      ⟨({IsLocalRing.closedPoint R} : Set (Spec (.of R))),
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr
          (IsLocalRing.maximalIdeal.isMaximal R)⟩)
    (y : Spec (.of K) ⟶ Y)
    (hy : y ≫ f ≫ Scheme.Opens.ι (D.support.compl : X.Opens) =
      Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ t) :
    ∃ t' : Spec (.of R) ⟶ (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).normalization,
      t' ≫ (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).fromNormalization = t ∧
      Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ t' =
        y ≫ (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).toNormalization ∧
      ∀ r, EtaleAt (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).fromNormalization (t' r) := by
  set π := (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).fromNormalization
  have hflf := isFiniteLocallyFree_fromNormalization h0EYD D hD hDreg f hf
  obtain ⟨hfin, -, -⟩ :=
    (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_locallyOfFinitePresentation π).mp hflf
  have hex : ValuativeCriterion.Existence π :=
    (UniversallyClosed.eq_valuativeCriterion ▸ (inferInstance : UniversallyClosed π)).1
  let S : ValuativeCommSq π :=
    { R := R, K := K, i₁ := y ≫ (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).toNormalization,
      i₂ := t, commSq := ⟨by
        rw [Category.assoc, Scheme.Hom.toNormalization_fromNormalization, hy]⟩ }
  have := hex S
  exact ⟨S.commSq.lift, S.commSq.fac_right, S.commSq.fac_left,
    etaleAt_fromNormalization_of_lift h0EYD D hD hDreg f hf R t ht _ S.commSq.fac_right⟩

include h0EYD in
/-- **Stacks Project, Tag 0EYI (2).** In the situation of Tag 0EYI (1), if `Spec K ×_X Y` is
isomorphic over `Spec K` to a disjoint union of copies of `Spec K`, then `Y' ⟶ X` is finite étale
over an open neighbourhood `V` of `t(Spec R)`.

Every point of `Y'` over the closed point of `Spec R` is a specialization of a point over the
generic point (the normalization is flat), which is a `K`-point by assumption; the valuative
criterion turns it into a lift of `t` through the given point, and (1) applies.

The argument `h0EYD` ([Stacks, Tag 0EYD]) is that of Abhyankar's lemma, [Stacks, Tag 0EYG]. -/
theorem exists_opens_etale_fromNormalization {X : Scheme.{u}} [IsLocallyNoetherian X]
    (D : X.IdealSheafData) (hD : Stacks.Divisors.IsEffectiveCartierDivisor D)
    (hDreg : ∀ z : D.subscheme, IsRegularLocalRing (D.subscheme.presheaf.stalk z))
    {Y : Scheme.{u}} (f : Y ⟶ (D.support.compl : X.Opens)) [IsFinite f] [Etale f]
    (hf : Stacks.FundamentalGroup.IsTamelyRamifiedInCodimensionOne
      (Scheme.Opens.ι (D.support.compl : X.Opens)) f)
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
    (t : Spec (.of R) ⟶ X)
    (ht : D.comap t = Scheme.IdealSheafData.vanishingIdeal
      ⟨({IsLocalRing.closedPoint R} : Set (Spec (.of R))),
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr
          (IsLocalRing.maximalIdeal.isMaximal R)⟩)
    (J : Type u)
    (eJ : pullback (Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ t)
        (f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)) ≅ ∐ fun _ : J ↦ Spec (.of K))
    (heJ : eJ.hom ≫ Sigma.desc (fun _ ↦ 𝟙 _) = pullback.fst _ _) :
    ∃ V : X.Opens, (∀ r, t r ∈ V) ∧
      IsFinite ((f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).fromNormalization ∣_ V) ∧
      Etale ((f ≫ Scheme.Opens.ι (D.support.compl : X.Opens)).fromNormalization ∣_ V) := by
  let j := Scheme.Opens.ι (D.support.compl : X.Opens)
  let F := f ≫ j
  let π := F.fromNormalization
  have hflf := isFiniteLocallyFree_fromNormalization h0EYD D hD hDreg f hf
  obtain ⟨hfin, hflat, hlfp⟩ :=
    (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_locallyOfFinitePresentation π).mp hflf
  set s : Spec (.of R) := IsLocalRing.closedPoint R
  let SRK := Spec.map (CommRingCat.ofHom (algebraMap R K))
  let tK := SRK ≫ t
  -- the generic point of `Spec R` maps to `X ∖ D`
  have htK : Set.range tK ⊆ Set.range j := by
    rintro _ ⟨p, rfl⟩
    rw [Scheme.Opens.range_ι]
    intro hpD
    have hmem : SRK p ∈ ((D.comap t).support : Set (Spec (.of R))) := by
      rw [Scheme.IdealSheafData.support_comap, TopologicalSpace.Closeds.coe_preimage]; exact hpD
    rw [ht, Scheme.IdealSheafData.coe_support_vanishingIdeal] at hmem
    have h1 : (SRK p).asIdeal = ⊥ := by
      change Ideal.comap (algebraMap R K) p.asIdeal = ⊥
      rw [@Ideal.eq_bot_of_prime _ _ p.asIdeal p.isPrime]
      exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective R K)
    have h2 : (SRK p).asIdeal = IsLocalRing.maximalIdeal R := by
      rw [show SRK p = s from hmem]; rfl
    exact IsDiscreteValuationRing.not_a_field R (h2.symm.trans h1)
  let κ := IsOpenImmersion.lift j tK htK
  have hκ : κ ≫ j = tK := IsOpenImmersion.lift_fac _ _ _
  -- the generic fibre of `Y'` is `Spec K ×_X Y`
  let N := pullback tK F
  have sq0 : IsPullback (pullback.snd tK F) (pullback.fst tK F ≫ 𝟙 _) (f ≫ j) tK := by
    simpa using (IsPullback.of_hasPullback tK F).flip
  have bottom : IsPullback κ (𝟙 _) j tK :=
    IsPullback.of_vert_isIso_mono ⟨by rw [Category.id_comp, hκ]⟩
  have sqL : IsPullback (pullback.snd tK F) (pullback.fst tK F) f κ := by
    refine IsPullback.of_bot sq0 ?_ bottom
    rw [← cancel_mono j, Category.assoc, Category.assoc, hκ]
    exact (pullback.condition).symm
  have sqN := sqL.paste_horiz (isPullback_toNormalization_ι D f)
  rw [hκ] at sqN
  let ρ := pullback.snd π t
  let M : N ⟶ pullback π t := pullback.lift (pullback.snd tK F ≫ F.toNormalization)
    (pullback.fst tK F ≫ SRK) (by
      rw [Category.assoc, Scheme.Hom.toNormalization_fromNormalization, ← pullback.condition,
        Category.assoc])
  have sqM : IsPullback M (pullback.fst tK F) ρ SRK := by
    refine IsPullback.of_right ?_ (pullback.lift_snd _ _ _) (IsPullback.of_hasPullback π t)
    rw [pullback.lift_fst]
    exact sqN
  have hexρ : ValuativeCriterion.Existence ρ :=
    (UniversallyClosed.eq_valuativeCriterion ▸ (inferInstance : UniversallyClosed ρ)).1
  -- every point of `Y'` over the closed point is étale
  have hC : ∀ y' : F.normalization, π y' = t s → EtaleAt π y' := by
    intro y' hy'
    obtain ⟨P0, hP0₁, hP0₂⟩ := Scheme.Pullback.exists_preimage_pullback (f := π) (g := t) y' s hy'
    obtain ⟨pt⟩ : Nonempty (Spec (.of K)) := inferInstance
    have hsp : SRK pt ⤳ ρ P0 := by
      change _ ⤳ pullback.snd π t P0
      rw [hP0₂]; exact IsLocalRing.specializes_closedPoint _
    obtain ⟨P1, hP1, hρP1⟩ := (Flat.generalizingMap ρ) hsp
    have hP1M : P1 ∈ Set.range M := by
      rw [range_eq_preimage_range_of_isPullback sqM]
      exact ⟨pt, hρP1.symm⟩
    obtain ⟨Q, hQ⟩ := hP1M
    obtain ⟨j0, v0, hv0⟩ := (sigmaOpenCover (fun _ : J ↦ Spec (.of K))).exists_eq (eJ.hom Q)
    change Sigma.ι (fun _ : J ↦ Spec (.of K)) j0 v0 = eJ.hom Q at hv0
    let σ := Sigma.ι (fun _ : J ↦ Spec (.of K)) j0 ≫ eJ.inv
    have heJ' : Sigma.desc (fun _ : J ↦ 𝟙 (Spec (.of K))) = eJ.inv ≫ pullback.fst tK F :=
      (Iso.eq_inv_comp eJ).mpr heJ
    have hσ : σ ≫ pullback.fst tK F = 𝟙 _ := by
      simp only [σ, Category.assoc, ← heJ']
      exact Sigma.ι_comp_desc _ _
    have hσQ : σ v0 = Q := by
      change eJ.inv (Sigma.ι (fun _ : J ↦ Spec (.of K)) j0 v0) = Q
      rw [hv0, ← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
    let σK := σ ≫ M
    have hσK : σK ≫ ρ = SRK ≫ 𝟙 _ := by
      simp only [σK, Category.assoc, sqM.w, ← Category.assoc σ, hσ, Category.id_comp,
        Category.comp_id]
    let S' : ValuativeCommSq ρ := { R := R, K := K, i₁ := σK, i₂ := 𝟙 _, commSq := ⟨hσK⟩ }
    have := hexρ S'
    let σ1 := S'.commSq.lift
    have h1l : SRK ≫ σ1 = σK := S'.commSq.fac_left
    have h1r : σ1 ≫ ρ = 𝟙 _ := S'.commSq.fac_right
    have : IsClosedImmersion (σ1 ≫ ρ) := by rw [h1r]; infer_instance
    have hcl : IsClosedImmersion σ1 := IsClosedImmersion.of_comp σ1 ρ
    have hP1σ : P1 ∈ Set.range σ1 := ⟨SRK v0, by
      change (SRK ≫ σ1) v0 = P1
      rw [h1l]
      change M (σ v0) = P1
      rw [hσQ, hQ]⟩
    obtain ⟨r0, hr0⟩ := hP1.mem_closed σ1.isClosedEmbedding.isClosed_range hP1σ
    have hr0s : r0 = s := by
      have := congrArg ρ hr0
      rw [← Scheme.Hom.comp_apply, h1r] at this
      exact this.trans hP0₂
    let t' := σ1 ≫ pullback.fst π t
    have ht' : t' ≫ π = t := by
      simp only [t', Category.assoc, pullback.condition]
      rw [← Category.assoc, h1r, Category.id_comp]
    have hy't : y' = t' s := by
      rw [← hP0₁, ← hr0, hr0s]; rfl
    rw [hy't]
    exact etaleAt_fromNormalization_of_lift h0EYD D hD hDreg f hf R t ht t' ht' s
  -- the open set over which `π` is étale
  let V : X.Opens := ⟨(π '' {y | ¬ EtaleAt π y})ᶜ,
    (π.isClosedMap _ (isOpen_setOf_etaleAt π).isClosed_compl).isOpen_compl⟩
  have hsV : t s ∈ V := fun ⟨z, hz, hzt⟩ ↦ hz (hC z hzt)
  refine ⟨V, apply_mem_of_closedPoint_mem t V.2 hsV, inferInstance, ?_⟩
  rw [etale_iff_forall_etaleAt]
  intro y
  rw [← etaleAt_iff_of_isPullback (isPullback_morphismRestrict π V).flip (Or.inr inferInstance)]
  by_contra hy
  exact y.2 ⟨_, hy, rfl⟩

end

end AlgebraicGeometry.TameCovers
