module

public import StacksFrontier.AlgebraicGeometry.Thickenings.InfinitesimalTower
public import StacksFrontier.AlgebraicGeometry.Thickenings.InfinitesimalBottomStage
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.TopologicalInvarianceFundamental.Thickening
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.FiniteEtaleRestriction
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.FiniteAlgebraization.AdicSystem
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionFunctor.FiniteLocallyFreeAdic

/-!
# The formal finite étale cover attached to a finite étale cover of a closed subscheme

Let `i : Z ⟶ X` be a closed immersion and let `Z ⟶ Z₀ ⟶ Z₁ ⟶ ⋯` be its infinitesimal
neighbourhoods (`Stacks.Thickenings.nthOrderInfinitesimalNeighbourhood`). Each inclusion is a
thickening, so base change of finite étale covers along it is an equivalence
([Stacks, Tag 0BQB]), and a finite étale cover `A ⟶ Z` lifts uniquely to a compatible system of
finite étale covers `Cₙ ⟶ Zₙ`, each the base change of the next. This is the first step of the
proof of [Stacks, Tag 0EK1] ("by Lemma 58.8.3 there is a unique finite étale morphism
`πₙ : Uₙ ⟶ Yₙ` whose base change to `Y` recovers `U₁ ⟶ Y`"), and the direct images
`ℱₙ = (Cₙ ⟶ X)_* 𝒪_{Cₙ}` form a finite locally free object of `Coh(X, I)`, where `I = ker i`.

## Main definitions

* `Stacks.FundamentalGroup.InfinitesimalLift.cover` — the cover `Cₙ ⟶ Zₙ`.
* `Stacks.FundamentalGroup.InfinitesimalLift.coverZeroIso` — the base change of `C₀` to `Z` is
  `A`.
* `Stacks.FundamentalGroup.InfinitesimalLift.step` — the transition `Cₙ ⟶ Cₙ₊₁`, with cartesian
  square `Stacks.FundamentalGroup.InfinitesimalLift.isPullback_step`.
* `Stacks.FundamentalGroup.InfinitesimalLift.toBase` — the composite `Cₙ ⟶ Zₙ ⟶ X`.
* `Stacks.FundamentalGroup.InfinitesimalLift.system` — the inverse system `n ↦ (Cₙ ⟶ X)_* 𝒪_{Cₙ}`
  of `𝒪_X`-modules.

## Main results

* `Stacks.FundamentalGroup.InfinitesimalLift.isCoherentAdicSystem_system` — the system is a
  coherent adic system along `ker i`.
* `Stacks.FundamentalGroup.InfinitesimalLift.isFiniteLocallyFreeAdic_system` — it is a finite
  locally free object of `Coh(X, ker i)`.

## Implementation notes

The construction follows the one for systems of finite algebras over the adic thickenings of a
base in `StacksFrontier.AlgebraicGeometry.FormalGeometry.FiniteAlgebraization.AdicSystem`, whose
public lemmas (`AlgebraicGeometry.AdicFiniteAlgebra.app_surjective_ker_of_isPullback`,
`isIso_cokernelDesc_of_affine_algebra`, `pushforwardAlgebraHomOfEq`) do the work: over an affine
open `U` of `X` the transition `ℱₙ₊₁(U) ⟶ ℱₙ(U)` is the restriction of sections of a base change
of the closed immersion `Zₙ ⟶ X`, cut out by `I ^ (n + 1)`, so it is surjective with kernel
generated by `I(U) ^ (n + 1)`.

## References

* [Stacks Project, Tag 0EK1](https://stacks.math.columbia.edu/tag/0EK1)
* [Stacks Project, Tag 0BQB](https://stacks.math.columbia.edu/tag/0BQB)
* [Stacks Project, Tag 087W](https://stacks.math.columbia.edu/tag/087W)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry
open Stacks.AffineAlgebraEquivalence
open Stacks.RelativeSpec (AlgebraSheaf)
open Stacks.Thickenings
open Stacks.AlgebraicGeometry.HigherDirectImageCoherent
  (idealPowerMultiple_eq_bot_of_forall_smul_eq_zero)

universe u

namespace Stacks.FundamentalGroup.InfinitesimalLift

/-! ### Lifting along a thickening -/

/-- The unique finite étale cover of `S'` restricting to a given finite étale cover of `S`, for a
thickening `S ⟶ S'`. -/
public def liftAlongThickening {S S' : Scheme.{u}} (j : S ⟶ S') (hj : IsThickening j)
    (A : FiniteEtaleOver S) : FiniteEtaleOver S' :=
  letI := finiteEtaleBaseChange_isEquivalence_of_isThickening j hj
  (finiteEtaleBaseChange j).asEquivalence.inverse.obj A

/-- The lift restricts to the given cover. -/
public def liftAlongThickeningIso {S S' : Scheme.{u}} (j : S ⟶ S') (hj : IsThickening j)
    (A : FiniteEtaleOver S) :
    (finiteEtaleBaseChange j).obj (liftAlongThickening j hj A) ≅ A :=
  letI := finiteEtaleBaseChange_isEquivalence_of_isThickening j hj
  (finiteEtaleBaseChange j).asEquivalence.counitIso.app A

variable {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (A : FiniteEtaleOver Z)

/-- The structure morphism of an infinitesimal neighbourhood of a closed immersion is a closed
immersion. -/
public instance isClosedImmersion_nthOrderToBase (n : ℕ) :
    IsClosedImmersion (nthOrderToBase i n) := by
  have hv : IsIso i.coborderRange.ι := Stacks.Divisors.isIso_coborderRange_ι i
  rw [nthOrderToBase_eq]
  infer_instance

/-! ### The covers of the infinitesimal neighbourhoods -/

/-- **The finite étale cover `Cₙ` of the `n`-th infinitesimal neighbourhood** lifting `A`. -/
public def cover : (n : ℕ) → FiniteEtaleOver (nthOrderInfinitesimalNeighbourhood i n)
  | 0 => liftAlongThickening (nthOrderInclusion i 0) (nthOrderInclusion_isThickening i 0) A
  | n + 1 => liftAlongThickening (nthOrderSucc i n) (nthOrderSucc_isThickening i n) (cover n)

/-- The base change of `C₀` to `Z` is `A`. -/
public def coverZeroIso : (finiteEtaleBaseChange (nthOrderInclusion i 0)).obj (cover i A 0) ≅ A :=
  liftAlongThickeningIso _ _ A

/-- The base change of `Cₙ₊₁` to `Zₙ` is `Cₙ`. -/
public def coverSuccIso (n : ℕ) :
    (finiteEtaleBaseChange (nthOrderSucc i n)).obj (cover i A (n + 1)) ≅ cover i A n :=
  liftAlongThickeningIso _ _ (cover i A n)

/-- The transition `Cₙ ⟶ Cₙ₊₁`. -/
public def step (n : ℕ) : (cover i A n).left ⟶ (cover i A (n + 1)).left :=
  (coverSuccIso i A n).inv.left ≫ finiteEtaleBaseChangeProj (nthOrderSucc i n) (cover i A (n + 1))

/-- **The squares of the tower are cartesian:** `Cₙ = Cₙ₊₁ ×_{Zₙ₊₁} Zₙ`. -/
public theorem isPullback_step (n : ℕ) :
    IsPullback (step i A n) (cover i A n).hom (cover i A (n + 1)).hom (nthOrderSucc i n) := by
  let e := coverSuccIso i A n
  let e' : (cover i A n).left ≅ pullback (cover i A (n + 1)).hom (nthOrderSucc i n) :=
    { hom := e.inv.left
      inv := e.hom.left
      hom_inv_id := congrArg (fun f => f.left) e.inv_hom_id
      inv_hom_id := congrArg (fun f => f.left) e.hom_inv_id }
  refine IsPullback.of_iso_pullback ⟨?_⟩ e' rfl ?_
  · rw [step, Category.assoc, finiteEtaleBaseChangeProj_comp_hom, ← Category.assoc]
    exact congrArg (· ≫ nthOrderSucc i n) (MorphismProperty.Over.w e.inv)
  · exact MorphismProperty.Over.w e.inv

/-- The composite `Cₙ ⟶ Zₙ ⟶ X`. -/
public abbrev toBase (n : ℕ) : (cover i A n).left ⟶ X :=
  (cover i A n).hom ≫ nthOrderToBase i n

/-- The transition `Cₙ ⟶ Cₙ₊₁` is a morphism over `X`. -/
@[reassoc]
public theorem step_toBase (n : ℕ) : step i A n ≫ toBase i A (n + 1) = toBase i A n := by
  rw [toBase, ← Category.assoc, (isPullback_step i A n).w, Category.assoc, nthOrderSucc_toBase]

/-- `Zₙ` is the fibre product `Zₙ₊₁ ×_X Zₙ`, the structure morphism of `Zₙ₊₁` being a
monomorphism. -/
public theorem isPullback_nthOrderSucc (n : ℕ) :
    IsPullback (nthOrderSucc i n) (𝟙 _) (nthOrderToBase i (n + 1)) (nthOrderToBase i n) := by
  refine IsPullback.of_isLimit' ⟨by simp⟩ ?_
  refine PullbackCone.IsLimit.mk _ (fun s => s.snd) (fun s => ?_) (fun s => by simp)
    (fun s m _ h2 => by simpa using h2)
  apply (cancel_mono (nthOrderToBase i (n + 1))).1
  rw [Category.assoc, nthOrderSucc_toBase, ← s.condition]

/-- **The squares over `X` are cartesian:** `Cₙ = Cₙ₊₁ ×_X Zₙ`. -/
public theorem isPullback_step_toBase (n : ℕ) :
    IsPullback (step i A n) (cover i A n).hom (toBase i A (n + 1)) (nthOrderToBase i n) := by
  simpa [-nthOrderToBase_eq] using
    (isPullback_step i A n).paste_vert (isPullback_nthOrderSucc i n)

/-- The structure morphism `Cₙ ⟶ X` is finite. -/
public instance isFinite_toBase (n : ℕ) : IsFinite (toBase i A n) := by
  have : IsFinite (cover i A n).hom := (cover i A n).prop.1
  infer_instance

/-! ### The system of direct images -/

/-- The `𝒪_X`-algebra `(Cₙ ⟶ X)_* 𝒪_{Cₙ}`. -/
public abbrev algebra (n : ℕ) : AlgebraSheaf X := pushforwardAlgebra (toBase i A n)

/-- The transition morphism of algebras `(Cₙ₊₁ ⟶ X)_* 𝒪 ⟶ (Cₙ ⟶ X)_* 𝒪`. -/
public def algebraStep (n : ℕ) : algebra i A (n + 1) ⟶ algebra i A n :=
  AdicFiniteAlgebra.pushforwardAlgebraHomOfEq (toBase i A n) (toBase i A (n + 1)) (step i A n)
    (step_toBase i A n)

/-- The preimage of an open of `X` in `Cₙ` is its preimage in `Cₙ₊₁` pulled back to `Cₙ`. -/
public theorem toBase_preimage (n : ℕ) (U : X.Opens) :
    toBase i A n ⁻¹ᵁ U = step i A n ⁻¹ᵁ (toBase i A (n + 1) ⁻¹ᵁ U) := by
  rw [← step_toBase i A n, Scheme.Hom.comp_preimage]

/-- The sections of the transition morphism of algebras. -/
public theorem algebraStep_app (n : ℕ) (U : X.Opens) :
    (algebraStep i A n).right.hom.app (op U) =
      (step i A n).appLE (toBase i A (n + 1) ⁻¹ᵁ U) (toBase i A n ⁻¹ᵁ U)
        (toBase_preimage i A n U).le :=
  AdicFiniteAlgebra.pushforwardAlgebraHomOfEq_app _ _ _ _ U

/-- The ideal sheaf cutting out `Zₙ` in `X` is `(ker i) ^ (n + 1)`. -/
public theorem ker_nthOrderToBase (n : ℕ) : (nthOrderToBase i n).ker = i.ker ^ (n + 1) :=
  Stacks.Algebraization.ker_nthInfinitesimalNeighbourhoodι i n

/-- Over an affine open of `X`, the transition on sections is surjective with kernel generated
by the `(n+1)`-st power of the ideal of `i`. -/
public theorem algebraStep_app_surjective_ker (n : ℕ) (U : X.affineOpens) :
    Function.Surjective ((algebraStep i A n).right.hom.app (op U.1)) ∧
      RingHom.ker ((algebraStep i A n).right.hom.app (op U.1)).hom =
        Ideal.map ((toBase i A (n + 1)).app U.1).hom (i.ker.ideal U ^ (n + 1)) := by
  obtain ⟨hs, hk⟩ :=
    AdicFiniteAlgebra.app_surjective_ker_of_isPullback (isPullback_step_toBase i A n) U
  rw [ker_nthOrderToBase] at hk
  have hb := AdicFiniteAlgebra.bijective_presheaf_map_of_eq
    (Y := (cover i A n).left) (toBase_preimage i A n U.1)
  rw [algebraStep_app, Scheme.Hom.appLE]
  refine ⟨fun y => ?_, ?_⟩
  · obtain ⟨z, hz⟩ := hb.2 y
    obtain ⟨w, hw⟩ := hs z
    exact ⟨w, (congrArg (fun x => ((cover i A n).left.presheaf.map
      (homOfLE (toBase_preimage i A n U.1).le).op).hom x) hw).trans hz⟩
  · have key : ∀ x : Γ((cover i A (n + 1)).left, toBase i A (n + 1) ⁻¹ᵁ U.1),
        ((cover i A n).left.presheaf.map (homOfLE (toBase_preimage i A n U.1).le).op).hom
          (((step i A n).app (toBase i A (n + 1) ⁻¹ᵁ U.1)).hom x) = 0 ↔
        x ∈ Ideal.map ((toBase i A (n + 1)).app U.1).hom (i.ker.ideal U ^ (n + 1)) := by
      intro x
      rw [map_eq_zero_iff _ hb.1, ← RingHom.mem_ker, hk]
      rfl
    ext x
    exact key x

/-- The `𝒪_X`-module `(Cₙ ⟶ X)_* 𝒪_{Cₙ}`. -/
public abbrev module (n : ℕ) : X.Modules := AlgebraSheaf.underlyingModule (algebra i A n)

/-- The transition morphism of modules. -/
public abbrev moduleStep (n : ℕ) : module i A (n + 1) ⟶ module i A n :=
  AlgebraSheaf.underlyingModuleMap (algebraStep i A n)

/-- The module `(Cₙ ⟶ X)_* 𝒪_{Cₙ}` is quasi-coherent. -/
public instance isQuasicoherent_module (n : ℕ) : (module i A n).IsQuasicoherent :=
  isQuasicoherent_pushforwardAlgebra (toBase i A n)

/-- The sections of `(Cₙ ⟶ X)_* 𝒪_{Cₙ}` over an affine open are a finite module. -/
public theorem moduleFinite_module (n : ℕ) (U : X.affineOpens) :
    Module.Finite Γ(X, U.1) Γ(module i A n, U.1) :=
  IsFinite.finite_app (toBase i A n) U.1 U.2

/-- The module `(Cₙ ⟶ X)_* 𝒪_{Cₙ}` is coherent. -/
public theorem isCoherent_module [IsLocallyNoetherian X] (n : ℕ) : (module i A n).IsCoherent :=
  Stacks.AlgebraicGeometry.CoherenceCriteria.isCoherent_of_isFiniteTildeOn _ fun U hU =>
    Stacks.AlgebraicGeometry.FiniteDirectImageCoherent.isFiniteTildeOn_of_moduleFinite_sections
      _ ⟨U, hU⟩ (moduleFinite_module i A n ⟨U, hU⟩)

/-- The identification of the sections of `Cₙ` over the preimage of `U` with the sections of
`(Cₙ ⟶ X)_* 𝒪_{Cₙ}` over `U`, as an additive map. -/
public def moduleAddHom (n : ℕ) (U : X.Opens) :
    Γ((cover i A n).left, toBase i A n ⁻¹ᵁ U) →+ Γ(module i A n, U) where
  toFun s := s
  map_zero' := rfl
  map_add' _ _ := rfl

/-- The scalar action on the sections of `(Cₙ ⟶ X)_* 𝒪_{Cₙ}` is multiplication through the
structure morphism. -/
public theorem module_smul (n : ℕ) (U : X.Opens) (r : Γ(X, U))
    (s : Γ((cover i A n).left, toBase i A n ⁻¹ᵁ U)) :
    r • moduleAddHom i A n U s = moduleAddHom i A n U (((toBase i A n).app U).hom r * s) :=
  rfl

/-- The `(n+1)`-st power of the ideal of `i` annihilates `(Cₙ ⟶ X)_* 𝒪_{Cₙ}`. -/
public theorem idealPowerMultiple_module_eq_bot (n : ℕ) :
    Stacks.Algebraization.idealPowerMultiple i.ker (n + 1) (module i A n) = ⊥ := by
  refine idealPowerMultiple_eq_bot_of_forall_smul_eq_zero _ _ _ fun U a ha m => ?_
  have h0 : ((nthOrderToBase i n).app U.1).hom a = 0 := by
    have h : a ∈ (nthOrderToBase i n).ker.ideal U := by
      rw [ker_nthOrderToBase]
      exact ha
    rw [Scheme.Hom.ker_apply] at h
    exact h
  obtain ⟨m', rfl⟩ : ∃ m', moduleAddHom i A n U.1 m' = m := ⟨m, rfl⟩
  rw [module_smul]
  have h1 : ((toBase i A n).app U.1).hom a = 0 := by
    have hc : ((toBase i A n).app U.1).hom a = ((cover i A n).hom.app _).hom
        (((nthOrderToBase i n).app U.1).hom a) := rfl
    rw [hc, h0, map_zero]
    rfl
  rw [h1, zero_mul, map_zero]

/-- The comparison `ℱₙ₊₁ / I ^ (n+1) ℱₙ₊₁ ⟶ ℱₙ`. -/
public def moduleQuot (n : ℕ) :
    Stacks.Algebraization.idealPowerQuotient i.ker (n + 1) (module i A (n + 1)) ⟶
      module i A n :=
  cokernel.desc (C := X.Modules) _ (moduleStep i A n)
    (Stacks.Algebraization.comp_eq_zero_of_idealPowerMultiple_eq_bot _ _ _
      (idealPowerMultiple_module_eq_bot i A n))

/-- The comparison factors the transition morphism through the quotient. -/
public theorem π_moduleQuot (n : ℕ) :
    cokernel.π (C := X.Modules) (Stacks.Algebraization.idealPowerMultiple
      i.ker (n + 1) (module i A (n + 1))).ι ≫ moduleQuot i A n = moduleStep i A n :=
  cokernel.π_desc (C := X.Modules) _ _ _

/-- The comparison `ℱₙ₊₁ / I ^ (n+1) ℱₙ₊₁ ⟶ ℱₙ` is an isomorphism. -/
public instance isIso_moduleQuot (n : ℕ) : IsIso (moduleQuot i A n) :=
  AdicFiniteAlgebra.isIso_cokernelDesc_of_affine_algebra _ _ (toBase i A (n + 1))
    (algebra i A n) (algebraStep i A n) _ (π_moduleQuot i A n)
    (fun U => (algebraStep_app_surjective_ker i A n U).1)
    (fun U => (algebraStep_app_surjective_ker i A n U).2.le)

/-- **The inverse system `n ↦ (Cₙ ⟶ X)_* 𝒪_{Cₙ}`** of `𝒪_X`-modules. -/
public def system : ℕᵒᵖ ⥤ X.Modules := Functor.ofOpSequence (moduleStep i A)

/-- The transition maps of the system are the morphisms `moduleStep`. -/
public theorem system_map_succ (n : ℕ) :
    (system i A).map (homOfLE (Nat.le_succ n)).op = moduleStep i A n :=
  Functor.ofOpSequence_map_homOfLE_succ _ n

/-- **The system is a coherent adic system along the ideal of `i`.** -/
public theorem isCoherentAdicSystem_system [IsLocallyNoetherian X] :
    Stacks.Coherent.IsCoherentAdicSystem i.ker (system i A) :=
  ⟨fun n => isCoherent_module i A n, fun n => idealPowerMultiple_module_eq_bot i A n,
    fun n => ⟨@asIso _ _ _ _ (moduleQuot i A n) (isIso_moduleQuot i A n),
      (π_moduleQuot i A n).trans (system_map_succ i A n).symm⟩⟩

/-- The system as an object of `Coh(X, ker i)`. -/
public def adicSystem [IsLocallyNoetherian X] : Stacks.Coherent.CoherentAdicSystems i.ker :=
  ⟨system i A, isCoherentAdicSystem_system i A⟩

/-! ### Finite local freeness -/

/-- The `n`-th infinitesimal neighbourhood is identified with the closed subscheme of `X` cut out
by `(ker i) ^ (n + 1)`, over `X`. -/
public def toSubscheme (n : ℕ) :
    nthOrderInfinitesimalNeighbourhood i n ⟶ (i.ker ^ (n + 1)).subscheme :=
  IsClosedImmersion.lift (i.ker ^ (n + 1)).subschemeι (nthOrderToBase i n)
    (by rw [Scheme.IdealSheafData.ker_subschemeι, ker_nthOrderToBase])

/-- `toSubscheme` is a morphism over `X`. -/
@[reassoc]
public theorem toSubscheme_subschemeι (n : ℕ) :
    toSubscheme i n ≫ (i.ker ^ (n + 1)).subschemeι = nthOrderToBase i n :=
  IsClosedImmersion.lift_fac _ _ _

/-- `toSubscheme` is an isomorphism. -/
public instance isIso_toSubscheme (n : ℕ) : IsIso (toSubscheme i n) :=
  IsClosedImmersion.isIso_lift _ _
    (by rw [Scheme.IdealSheafData.ker_subschemeι, ker_nthOrderToBase])

/-- **The system is a finite locally free object of `Coh(X, ker i)`:** its `n`-th term is the
direct image of the finite locally free module `(Cₙ ⟶ (ker i)^(n+1)-subscheme)_* 𝒪_{Cₙ}`. -/
public theorem isFiniteLocallyFreeAdic_system [IsLocallyNoetherian X] :
    Stacks.Algebraization.IsFiniteLocallyFreeAdic i.ker (adicSystem i A) := by
  intro n
  let c := (cover i A n).hom ≫ toSubscheme i n
  have : IsFinite (cover i A n).hom := (cover i A n).prop.1
  have : Etale (cover i A n).hom := (cover i A n).prop.2
  have hc : Stacks.Morphisms.IsFiniteLocallyFree c :=
    (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_locallyOfFinitePresentation c).mpr
      ⟨inferInstance, inferInstance, inferInstance⟩
  refine ⟨(Scheme.Modules.pushforward c).obj (SheafOfModules.unit _),
    (Scheme.Modules.isFiniteLocallyFree_iff _).mpr hc.toIsFiniteLocallyFree, ⟨?_⟩⟩
  have hfac : c ≫ (i.ker ^ (n + 1)).subschemeι = toBase i A n := by
    rw [Category.assoc, toSubscheme_subschemeι]
  exact (Scheme.Modules.pushforwardComp c (i.ker ^ (n + 1)).subschemeι).app _ ≪≫
    (Scheme.Modules.pushforwardCongr hfac).app _

end Stacks.FundamentalGroup.InfinitesimalLift

end
