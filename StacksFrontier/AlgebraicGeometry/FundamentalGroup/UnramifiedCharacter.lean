module

public import Mathlib.Analysis.Normed.Ring.Units
public import Mathlib.NumberTheory.Padics.RingHoms
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.FiniteFieldFrobeniusDense
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Trace.FrobeniusElementDegree

/-!
# Unramified `ℓ`-adic characters of the fundamental group of a scheme over a finite field

Let `k` be a finite field, `X ⟶ Spec k` a connected scheme locally of finite type, `x̄` a geometric
point and `u ∈ ℤ_ℓˣ`. The character `χ_u : π₁(X, x̄) → π₁(Spec k) → ℤ_ℓˣ` sending the geometric
Frobenius `Φ⁻¹` of `k` to `u` is continuous, trivial on the geometric fundamental group
`ker(π₁(X, x̄) → π₁(Spec k))`, and takes the value `u ^ deg y` on the geometric Frobenius element
`F_y` of every closed point `y` of `X` (which lies over `Φ ^ (-deg y)`).

The character of `π₁(Spec k)` is the extension of `ν ↦ u ^ ν` from the dense subgroup `⟨Φ⟩`
(`AlgebraicGeometry.dense_zpowers_finiteFieldFrobenius`): its graph is the closure of the
subgroup generated by `(Φ, u⁻¹)` in the compact group `π₁(Spec k) × ℤ_ℓˣ`, which projects
bijectively onto `π₁(Spec k)` because the powers of `Φ` are detected by open subgroups
(`AlgebraicGeometry.exists_isOpen_finiteFieldFrobenius_zpow_mem_dvd`) and every power `u ^ N`,
`N` the order of `u` modulo `ℓ ^ m`, is `ℓ ^ m`-adically close to `1`. No condition `ℓ ≠ p` is
needed.

## Main results

* `Stacks.exists_continuous_monoidHom_of_dense_zpowers`: on a compact Hausdorff group with a dense
  cyclic subgroup `⟨g⟩`, `g ^ j ↦ v ^ j` extends to a continuous homomorphism when the powers of
  `v` converge to `1` along those of `g`.
* `Stacks.exists_pos_forall_zpow_mul_mem_of_mem_nhds_one`: for `v ∈ ℤ_ℓˣ` and a neighbourhood
  `W` of `1`, some `N > 0` has all `v ^ (N j)` in `W`.
* `AlgebraicGeometry.exists_continuous_monoidHom_finiteFieldFrobenius`: the continuous character
  of `π₁(Spec k, z)` with a prescribed value at the Frobenius.
* `Stacks.EtaleCohomology.exists_unramifiedCharacter`: the unramified character `χ_u`.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Topology Filter

universe u

namespace Stacks

/-- **Extension of a character from a dense cyclic subgroup.** Let `G` and `H` be compact
Hausdorff groups and `g ∈ G` generate a dense subgroup. If for every neighbourhood `W` of `1` in
`H` there is a neighbourhood `O` of `1` in `G` such that `g ^ j ∈ O` forces `v ^ j ∈ W`, then there
is a continuous homomorphism `χ : G → H` with `χ g = v`. Its graph is the closure of the subgroup
generated by `(g, v)`, which projects homeomorphically onto `G`. -/
public theorem exists_continuous_monoidHom_of_dense_zpowers {G H : Type*} [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G] [Group H]
    [TopologicalSpace H] [IsTopologicalGroup H] [CompactSpace H] [T2Space H] (g : G)
    (hg : Dense (Subgroup.zpowers g : Set G)) (v : H)
    (hv : ∀ W ∈ 𝓝 (1 : H), ∃ O ∈ 𝓝 (1 : G), ∀ j : ℤ, g ^ j ∈ O → v ^ j ∈ W) :
    ∃ χ : G →* H, Continuous χ ∧ χ g = v := by
  classical
  let S : Subgroup (G × H) := Subgroup.zpowers (g, v)
  let Γ : Subgroup (G × H) := S.topologicalClosure
  have : CompactSpace Γ := isCompact_iff_compactSpace.1 S.isClosed_topologicalClosure.isCompact
  let π : Γ →* G := (MonoidHom.fst G H).comp Γ.subtype
  have hπc : Continuous π := continuous_fst.comp continuous_subtype_val
  have hgv : ((g, v) : G × H) ∈ Γ := S.le_topologicalClosure (Subgroup.mem_zpowers _)
  have hsurj : Function.Surjective π := by
    have hsub : (Subgroup.zpowers g : Set G) ⊆ Set.range π := by
      intro a ha
      obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.1 ha
      exact ⟨⟨(g, v) ^ j, Γ.zpow_mem hgv j⟩, by simp [π]⟩
    intro γ
    exact closure_minimal hsub (isCompact_range hπc).isClosed (hg γ)
  have hinj : Function.Injective π := by
    rw [injective_iff_map_eq_one]
    rintro ⟨⟨a, w⟩, hmem⟩ ha
    obtain rfl : a = 1 := ha
    have hw : ∀ W ∈ 𝓝 (1 : H), w ∈ W := by
      intro W hW
      obtain ⟨V, hV, hVW⟩ := exists_nhds_split_inv hW
      obtain ⟨O, hO, hOV⟩ := hv V hV
      have ht : Tendsto (fun h : H => w⁻¹ * h) (𝓝 w) (𝓝 1) :=
        (continuous_const.mul continuous_id).tendsto' w 1 (inv_mul_cancel w)
      have hmem' : ((1 : G), w) ∈ closure (S : Set (G × H)) := hmem
      obtain ⟨⟨a', b'⟩, ⟨ha'O, hb'⟩, hS⟩ := mem_closure_iff_nhds.1 hmem'
        (O ×ˢ ((fun h : H => w⁻¹ * h) ⁻¹' V)) (prod_mem_nhds hO (ht hV))
      obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.1 hS
      obtain ⟨rfl, rfl⟩ := Prod.ext_iff.1 hj
      simpa [div_eq_mul_inv, mul_inv_rev, inv_inv] using hVW _ (hOV j ha'O) _ hb'
    obtain rfl : w = 1 := by
      by_contra hne
      exact (hw {w}ᶜ (isOpen_compl_singleton.mem_nhds (Ne.symm hne))) rfl
    rfl
  let e : Γ ≃* G := MulEquiv.ofBijective π ⟨hinj, hsurj⟩
  let hom : Γ ≃ₜ G := hπc.homeoOfEquivCompactToT2 (f := e.toEquiv)
  refine ⟨(MonoidHom.snd G H).comp (Γ.subtype.comp e.symm.toMonoidHom), ?_, ?_⟩
  · exact continuous_snd.comp (continuous_subtype_val.comp hom.symm.continuous)
  · have he : e.symm g = ⟨(g, v), hgv⟩ := e.symm_apply_eq.2 rfl
    simp only [MonoidHom.coe_comp, Function.comp_apply, MulEquiv.coe_toMonoidHom, he]
    rfl

/-- **The powers of an `ℓ`-adic unit along a subgroup `N ℤ` are close to `1`**: for `v ∈ ℤ_ℓˣ` and
a neighbourhood `W` of `1`, there is `N > 0` with `v ^ (N j) ∈ W` for all integers `j` (take `N`
the order of `v` modulo `ℓ ^ m`, `ℓ ^ (-m)` below the radius of a ball inside `W`). -/
public theorem exists_pos_forall_zpow_mul_mem_of_mem_nhds_one (ℓ : ℕ) [Fact ℓ.Prime]
    (v : ℤ_[ℓ]ˣ) {W : Set ℤ_[ℓ]ˣ} (hW : W ∈ 𝓝 (1 : ℤ_[ℓ]ˣ)) :
    ∃ N : ℕ, 0 < N ∧ ∀ j : ℤ, v ^ ((N : ℤ) * j) ∈ W := by
  have h1 : Units.val '' W ∈ 𝓝 (1 : ℤ_[ℓ]) := by
    simpa only [Units.val_one] using Units.isOpenEmbedding_val.isOpenMap.image_mem_nhds hW
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.1 h1
  obtain ⟨m, hm⟩ := PadicInt.exists_pow_neg_lt ℓ hε
  let φ : ℤ_[ℓ]ˣ →* (ZMod (ℓ ^ m))ˣ := Units.map (PadicInt.toZModPow m).toMonoidHom
  refine ⟨orderOf (φ v), orderOf_pos _, fun j => ?_⟩
  have hφ : φ (v ^ ((orderOf (φ v) : ℤ) * j)) = 1 := by
    rw [zpow_mul, zpow_natCast, map_zpow, map_pow, pow_orderOf_eq_one, one_zpow]
  have hker : ((v ^ ((orderOf (φ v) : ℤ) * j) : ℤ_[ℓ]ˣ) : ℤ_[ℓ]) - 1 ∈
      RingHom.ker (PadicInt.toZModPow m : ℤ_[ℓ] →+* ZMod (ℓ ^ m)) := by
    rw [RingHom.mem_ker, map_sub, map_one, sub_eq_zero]
    exact congrArg Units.val hφ
  rw [PadicInt.ker_toZModPow, ← PadicInt.norm_le_pow_iff_mem_span_pow] at hker
  obtain ⟨w, hw, hwv⟩ := hball (mem_ball_iff_norm.2 (hker.trans_lt hm))
  rwa [← Units.ext hwv]

end Stacks

namespace AlgebraicGeometry

/-- **A continuous `ℓ`-adic character of `π₁(Spec k)` with a prescribed value at the
Frobenius**: for a finite field `k` with `p ^ n` elements, a geometric point `z` of `Spec k` and
`v ∈ ℤ_ℓˣ`, there is a continuous `λ : π₁(Spec k, z) → ℤ_ℓˣ` with `λ(Φ_z) = v` (the extension of
`ν ↦ v ^ ν` from `ℤ` to its closure `⟨Φ_z⟩`). -/
public theorem exists_continuous_monoidHom_finiteFieldFrobenius {k : Type u} [Field k] [Fintype k]
    (p n : ℕ) [Fact p.Prime] [CharP k p] (hq : Fintype.card k = p ^ n)
    (z : GeometricPoint (Spec (.of k))) (ℓ : ℕ) [Fact ℓ.Prime] (v : ℤ_[ℓ]ˣ) :
    ∃ χ : EtaleFundamentalGroup (Spec (.of k)) z →* ℤ_[ℓ]ˣ, Continuous χ ∧
      χ (finiteFieldFrobenius p n hq z) = v := by
  have := compactSpace_etaleFundamentalGroup (Spec (.of k)) z
  have := t2Space_etaleFundamentalGroup (Spec (.of k)) z
  refine Stacks.exists_continuous_monoidHom_of_dense_zpowers _
    (dense_zpowers_finiteFieldFrobenius p n hq z) v fun W hW => ?_
  obtain ⟨N, hN, hNW⟩ := Stacks.exists_pos_forall_zpow_mul_mem_of_mem_nhds_one ℓ v hW
  obtain ⟨O, hO, hOdvd⟩ := exists_isOpen_finiteFieldFrobenius_zpow_mem_dvd p n hq z N hN
  refine ⟨O, hO.mem_nhds O.one_mem, fun j hj => ?_⟩
  obtain ⟨i, rfl⟩ := hOdvd j hj
  exact hNW i

end AlgebraicGeometry

namespace Stacks.EtaleCohomology

/-- **The unramified character `χ_u`**
(used in [Tag 03VH](https://stacks.math.columbia.edu/tag/03VH) to twist by `u = q ^ β`): for a
connected scheme `X` locally of finite type over a finite field `k`, a geometric point `x̄` and
`u ∈ ℤ_ℓˣ`, there is a continuous character
`χ : π₁(X, x̄) → ℤ_ℓˣ`, trivial on the geometric fundamental group
`ker(π₁(X, x̄) → π₁(Spec k))`, with `χ(F_y) = u ^ deg y` at the geometric Frobenius element of
every closed point `y`. It is `π₁(X, x̄) → π₁(Spec k) → ℤ_ℓˣ`, the second map sending the
Frobenius `Φ` of `k` to `u⁻¹`. -/
public theorem exists_unramifiedCharacter {k : Type u} [Field k] [Fintype k] {X : Scheme.{u}}
    [ConnectedSpace X] (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f] (x : GeometricPoint X)
    (ℓ : ℕ) [Fact ℓ.Prime] (u : ℤ_[ℓ]ˣ) :
    ∃ χ : EtaleFundamentalGroup X x →* ℤ_[ℓ]ˣ, Continuous χ ∧
      (∀ g ∈ (etaleFundamentalGroupMap f x).toMonoidHom.ker, χ g = 1) ∧
      ∀ y : closedPoints X, χ (geometricFrobeniusFamily f x y) = u ^ residueDegree f y.1 := by
  obtain ⟨n, hp, hq⟩ := FiniteField.card k (ringChar k)
  have : Fact (ringChar k).Prime := ⟨hp⟩
  obtain ⟨χ₀, hχc, hχΦ⟩ := exists_continuous_monoidHom_finiteFieldFrobenius (ringChar k) n hq
    (x.map f) ℓ u⁻¹
  refine ⟨χ₀.comp (etaleFundamentalGroupMap f x).toMonoidHom,
    hχc.comp (etaleFundamentalGroupMap f x).continuous, fun g hg => ?_, fun y => ?_⟩
  · rw [MonoidHom.comp_apply, MonoidHom.mem_ker.1 hg, map_one]
  · have := finite_residueField f y.1 y.2
    rw [MonoidHom.comp_apply]
    show χ₀ (etaleFundamentalGroupMap f x (geometricFrobeniusFamily f x y)) = _
    rw [etaleFundamentalGroupMap_geometricFrobeniusFamily (ringChar k) n hq f x y, map_inv,
      map_pow, hχΦ, inv_pow, inv_inv]

end Stacks.EtaleCohomology

end
