/-!
# Purity at a normal surface point of small embedding dimension: the determinant step

[Stacks, Tag 0EA3] says: let `A` be an excellent regular local ring, `f : X ⟶ Spec A` of finite
type and `x ∈ X` with `𝒪_{X, x}` normal of dimension two; if `f` is étale outside the closure of
`x`, then `f` is étale at `x`.  When `𝒪_{X, x}` has embedding dimension at most three, the kernel
of a local presentation `𝒪_{X, x} = A[T_1, …, T_n]_Q / I` is generated by `n` elements, so the
module of differentials `Ω_{𝒪_{X, x}/A}` is the cokernel of a *square* Jacobian matrix.  Its
determinant is a unit at every height one prime (where `f` is étale), and this file supplies the
step that upgrades this to a unit of `𝒪_{X, x}` itself: Krull's principal ideal theorem.

## Main results

* `IsLocalRing.isUnit_of_forall_notMem_of_two_le_ringKrullDim` — in a Noetherian local ring of
  dimension at least two, an element lying in no prime ideal other than the maximal ideal is a
  unit.
* `IsLocalRing.subsingleton_of_square_presentation` — over such a ring, a module presented by a
  square matrix vanishes once it vanishes near every non-maximal prime.
* `IsLocalRing.spanFinrank_ker_add_two_le` — the kernel of a surjection from a regular local ring
  `R` onto a two-dimensional local domain of embedding dimension at most three is generated by
  `dim R - 2` elements.

## References

* [Stacks Project, Tag 0EA3](https://stacks.math.columbia.edu/tag/0EA3)
* [Stacks Project, Tag 00KV](https://stacks.math.columbia.edu/tag/00KV) (Krull's principal ideal
  theorem)
-/

@[expose] public section

universe u

namespace IsLocalRing

/-- In a Noetherian local ring of dimension at least two, an element which lies in no prime ideal
other than the maximal ideal is a unit.  Otherwise a minimal prime over the principal ideal it
generates has height at most one by Krull's principal ideal theorem, so it is not the maximal
ideal, whose height is the dimension of the ring; but it contains the element. -/
@[sga "2 X 2.1" "Hauptidealsatz step"]
theorem isUnit_of_forall_notMem_of_two_le_ringKrullDim {B : Type*} [CommRing B]
    [IsNoetherianRing B] [IsLocalRing B] (hdim : 2 ≤ ringKrullDim B) {b : B}
    (hb : ∀ p : Ideal B, p.IsPrime → p ≠ maximalIdeal B → b ∉ p) : IsUnit b := by
  by_contra hu
  have hne : Ideal.span {b} ≠ ⊤ := by rwa [Ne, Ideal.span_singleton_eq_top]
  obtain ⟨p, hp⟩ := Ideal.nonempty_minimalPrimes hne
  have hle : p.height ≤ 1 := Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ p hp
  refine hb p hp.1.1 (fun hpm => ?_) (hp.1.2 (Ideal.mem_span_singleton_self b))
  rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := B), ← hpm] at hdim
  have h2' : (2 : ℕ∞) ≤ p.height := WithBot.coe_le_coe.mp (by simpa using hdim)
  exact absurd (h2'.trans hle) (by decide)

/-- A module presented by a *square* matrix over a Noetherian local ring of dimension at least two
vanishes as soon as it is killed, near every prime other than the maximal ideal, by an element
outside that prime.  Let `φ : Bⁿ → Bⁿ` be the matrix and `π : Bⁿ → M` the cokernel map.  If
`s ∉ p` kills `M`, then `s • Bⁿ ⊆ im φ`, so `φ ∘ V = s • 1` for some `V` and
`det φ · det V = sⁿ ∉ p`; hence `det φ` lies in no prime other than the maximal ideal, it is a
unit by `IsLocalRing.isUnit_of_forall_notMem_of_two_le_ringKrullDim`, so `φ` is onto and
`M = 0`. -/
theorem subsingleton_of_square_presentation {B : Type*} [CommRing B] [IsNoetherianRing B]
    [IsLocalRing B] (hdim : 2 ≤ ringKrullDim B) {M : Type*} [AddCommGroup M] [Module B M]
    {n : ℕ} (φ : (Fin n → B) →ₗ[B] (Fin n → B)) (π : (Fin n → B) →ₗ[B] M)
    (hπ : Function.Surjective π) (hex : LinearMap.range φ = LinearMap.ker π)
    (hloc : ∀ p : Ideal B, p.IsPrime → p ≠ maximalIdeal B → ∃ s ∉ p, ∀ m : M, s • m = 0) :
    Subsingleton M := by
  have hdet : IsUnit (LinearMap.det φ) := by
    refine isUnit_of_forall_notMem_of_two_le_ringKrullDim hdim fun p hp hpm hmem => ?_
    obtain ⟨s, hs, hkill⟩ := hloc p hp hpm
    have hrange : ∀ v : Fin n → B, ∃ w, φ w = s • v := fun v => by
      rw [← LinearMap.mem_range, hex]
      simp [LinearMap.mem_ker, hkill]
    choose V hV using hrange
    let W : (Fin n → B) →ₗ[B] (Fin n → B) :=
      (Pi.basisFun B (Fin n)).constr B fun i => V (Pi.single i 1)
    have hcomp : φ ∘ₗ W = s • LinearMap.id := by
      refine (Pi.basisFun B (Fin n)).ext fun i => ?_
      simp [W, hV]
    have hpow : LinearMap.det φ * LinearMap.det W = s ^ n := by
      rw [← LinearMap.det_comp, hcomp, LinearMap.det_smul, LinearMap.det_id, mul_one,
        Module.finrank_fin_fun]
    exact hs (hp.mem_of_pow_mem n (hpow ▸ p.mul_mem_right _ hmem))
  have hsurj : Function.Surjective φ :=
    ((Module.End.isUnit_iff φ).mp ((LinearMap.isUnit_iff_isUnit_det φ).mpr hdet)).surjective
  have h0 : ∀ a : Fin n → B, π a = 0 := fun a => LinearMap.mem_ker.mp (hex ▸ hsurj a)
  refine ⟨fun a b => ?_⟩
  obtain ⟨a, rfl⟩ := hπ a
  obtain ⟨b, rfl⟩ := hπ b
  rw [h0, h0]

/-- A ring map kills the ideal generated by any element of its kernel. -/
private theorem apply_eq_zero_of_mem_span_singleton {R S : Type*} [CommRing R] [CommRing S]
    (π : R →+* S) {x : R} (hx : x ∈ RingHom.ker π) : ∀ a ∈ Ideal.span {x}, π a = 0 := fun _ ha =>
  RingHom.mem_ker.mp ((Ideal.span_singleton_le_iff_mem _).mpr hx ha)

/-- Generators of the kernel of a surjection `R ⟶ S` are obtained from generators of the kernel of
the induced map `R/(x) ⟶ S`, for `x` in the kernel, by lifting them and adding `x`. -/
theorem spanFinrank_ker_le_spanFinrank_ker_lift_add_one {R S : Type*} [CommRing R] [CommRing S]
    [IsNoetherianRing R] (π : R →+* S) {x : R} (hx : ∀ a ∈ Ideal.span {x}, π a = 0) :
    (RingHom.ker π).spanFinrank ≤
      (RingHom.ker (Ideal.Quotient.lift (Ideal.span {x}) π hx)).spanFinrank + 1 := by
  classical
  set π' := Ideal.Quotient.lift (Ideal.span {x}) π hx
  obtain ⟨t, htcard, htspan⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank (IsNoetherian.noetherian (RingHom.ker π'))
  let σ := Function.surjInv (Ideal.Quotient.mk_surjective (I := Ideal.span {x}))
  let L : Finset R := t.image σ
  have hmapL : (Ideal.span (L : Set R)).map (Ideal.Quotient.mk (Ideal.span {x})) =
      RingHom.ker π' := by
    rw [Ideal.map_span, ← htspan]
    congr 1
    ext y
    simp [L, σ, Function.surjInv_eq]
  have hker : RingHom.ker π = Ideal.span (insert x (L : Set R)) := by
    have h1 : π = π'.comp (Ideal.Quotient.mk (Ideal.span {x})) := by
      ext a
      simp [π']
    rw [h1, ← RingHom.comap_ker, ← hmapL,
      Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
      Ideal.mk_ker, Set.insert_eq, Ideal.span_union, sup_comm]
  rw [hker]
  calc (Ideal.span (insert x (L : Set R))).spanFinrank
      ≤ (insert x (L : Set R)).ncard :=
        Submodule.spanFinrank_span_le_ncard_of_finite (L.finite_toSet.insert x)
    _ ≤ (L : Set R).ncard + 1 := Set.ncard_insert_le _ _
    _ ≤ t.card + 1 := by
        rw [Set.ncard_coe_finset]
        exact Nat.add_le_add_right Finset.card_image_le 1
    _ = _ := by rw [htcard]

/-- A surjection from a local domain killing a nonzero element drops the dimension by one. -/
theorem ringKrullDim_add_one_le_of_mem_ker {R S : Type*} [CommRing R] [IsDomain R] [CommRing S]
    (π : R →+* S) (hπ : Function.Surjective π) {r : R} (hr : r ≠ 0) (hrk : π r = 0) :
    ringKrullDim S + 1 ≤ ringKrullDim R := by
  have hx := apply_eq_zero_of_mem_span_singleton π (RingHom.mem_ker.mpr hrk)
  calc ringKrullDim S + 1 ≤ ringKrullDim (R ⧸ Ideal.span {r}) + 1 := by
        gcongr
        exact ringKrullDim_le_of_surjective _
          (Ideal.Quotient.lift_surjective_of_surjective _ hx hπ)
    _ ≤ ringKrullDim R :=
        ringKrullDim_quotient_succ_le_of_nonZeroDivisor (mem_nonZeroDivisors_of_ne_zero hr)

/-- The case of the embedding dimension bound where the kernel lies in `𝔪²`: then `R` has
embedding dimension at most three, the kernel is zero when `dim R = 2`, and principal (generated
by a prime element of the factorial ring `R`) when `dim R = 3`. -/
theorem spanFinrank_ker_add_two_le_of_ker_le_sq {R S : Type*} [CommRing R] [IsRegularLocalRing R]
    [CommRing S] [IsLocalRing S] [IsDomain S] [IsNoetherianRing S] (π : R →+* S)
    (hπ : Function.Surjective π) (hdim : ringKrullDim S = 2)
    (hemb : (maximalIdeal S).spanFinrank ≤ 3) (hsq : RingHom.ker π ≤ maximalIdeal R ^ 2) :
    (RingHom.ker π).spanFinrank + 2 ≤ (maximalIdeal R).spanFinrank := by
  have _ : IsLocalHom π := hπ.isLocalHom
  have _ : IsDomain R := IsRegularLocalRing.isDomain R
  have hle3 : (maximalIdeal R).spanFinrank ≤ 3 :=
    (spanFinrank_maximalIdeal_le_of_surjective π hπ hsq).trans hemb
  have hdR : ((maximalIdeal R).spanFinrank : WithBot ℕ∞) = ringKrullDim R :=
    IsRegularLocalRing.spanFinrank_maximalIdeal
  have hge2 : 2 ≤ (maximalIdeal R).spanFinrank := by
    exact_mod_cast (hdim.symm.trans_le (ringKrullDim_le_of_surjective π hπ)).trans_eq hdR.symm
  by_cases hbot : RingHom.ker π = ⊥
  · rw [hbot, Submodule.spanFinrank_bot]
    lia
  obtain ⟨r, hrk, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hbot
  have hdrop : ∀ {T : Type _} [CommRing T] [IsDomain T] (ρ : T →+* S),
      Function.Surjective ρ → ∀ {t : T}, t ≠ 0 → ρ t = 0 → 3 ≤ ringKrullDim T := by
    intro T _ _ ρ hρ t ht hρt
    have := ringKrullDim_add_one_le_of_mem_ker ρ hρ ht hρt
    rw [hdim] at this
    exact le_trans (by norm_num) this
  have h3 : (maximalIdeal R).spanFinrank = 3 :=
    hle3.antisymm (by exact_mod_cast (hdrop π hπ hr0 hrk).trans_eq hdR.symm)
  have _ : UniqueFactorizationMonoid R := IsRegularLocalRing.uniqueFactorizationMonoid R
  obtain ⟨q, hqk, hq⟩ := (RingHom.ker_isPrime π).exists_mem_prime_of_ne_bot hbot
  have hkq : RingHom.ker π = Ideal.span {q} := by
    refine le_antisymm (fun t ht => ?_) ((Ideal.span_singleton_le_iff_mem _).mpr hqk)
    by_contra htq
    have hxq := apply_eq_zero_of_mem_span_singleton π hqk
    have _ : (Ideal.span {q}).IsPrime := (Ideal.span_singleton_prime hq.ne_zero).mpr hq
    let ρ := Ideal.Quotient.lift (Ideal.span {q}) π hxq
    have hρ : Function.Surjective ρ := Ideal.Quotient.lift_surjective_of_surjective _ _ hπ
    have ht0 : Ideal.Quotient.mk (Ideal.span {q}) t ≠ 0 := by
      rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
    have h3' := hdrop ρ hρ ht0 (by simpa [ρ] using RingHom.mem_ker.mp ht)
    have h4 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor
      (mem_nonZeroDivisors_of_ne_zero hq.ne_zero) (R := R)
    rw [← hdR, h3] at h4
    have := (add_le_add h3' (le_refl (1 : WithBot ℕ∞))).trans h4
    norm_num at this
  rw [hkq, h3]
  have : (Ideal.span {q}).spanFinrank ≤ 1 := by
    simpa using Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_singleton q) (R := R)
  lia

/-- **The kernel bound behind the small embedding dimension case.** Let `π : R ⟶ S` be a
surjection from a regular local ring onto a local domain of dimension two and embedding dimension
at most three. Then the kernel of `π` is generated by `dim R - 2` elements.

Induction on `dim R`: if the kernel contains `x ∉ 𝔪²`, then `R/(x)` is regular of dimension
`dim R - 1` and generators of the kernel of `R/(x) ⟶ S` lift, together with `x`, to generators of
the kernel of `π`; otherwise the kernel lies in `𝔪²` and
`IsLocalRing.spanFinrank_ker_add_two_le_of_ker_le_sq` applies. -/
theorem spanFinrank_ker_add_two_le {R : Type u} [CommRing R] [IsRegularLocalRing R]
    {S : Type*} [CommRing S] [IsLocalRing S] [IsDomain S] [IsNoetherianRing S] (π : R →+* S)
    (hπ : Function.Surjective π) (hdim : ringKrullDim S = 2)
    (hemb : (maximalIdeal S).spanFinrank ≤ 3) :
    (RingHom.ker π).spanFinrank + 2 ≤ (maximalIdeal R).spanFinrank := by
  suffices h : ∀ n : ℕ, ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] (π : R →+* S),
      Function.Surjective π → (maximalIdeal R).spanFinrank = n →
        (RingHom.ker π).spanFinrank + 2 ≤ n from h _ R π hπ rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro R _ _ π hπ hn
  by_cases hsq : RingHom.ker π ≤ maximalIdeal R ^ 2
  · exact hn ▸ spanFinrank_ker_add_two_le_of_ker_le_sq π hπ hdim hemb hsq
  obtain ⟨x, hxk, hx2⟩ := Set.not_subset.mp hsq
  have hxm : x ∈ maximalIdeal R := le_maximalIdeal (RingHom.ker_ne_top π) hxk
  obtain ⟨hreg, hdimq⟩ := quotient_isRegularLocalRing R x hxm hx2
  have hx := apply_eq_zero_of_mem_span_singleton π hxk
  have hπ' : Function.Surjective (Ideal.Quotient.lift (Ideal.span {x}) π hx) :=
    Ideal.Quotient.lift_surjective_of_surjective _ _ hπ
  have hn' : (maximalIdeal (R ⧸ Ideal.span {x})).spanFinrank + 1 = n := by
    have : (((maximalIdeal (R ⧸ Ideal.span {x})).spanFinrank + 1 : ℕ) : WithBot ℕ∞) =
        (n : WithBot ℕ∞) := by
      push_cast
      rw [IsRegularLocalRing.spanFinrank_maximalIdeal, hdimq, ← hn,
        IsRegularLocalRing.spanFinrank_maximalIdeal]
    exact_mod_cast this
  have h1 := ih _ (by lia) (R ⧸ Ideal.span {x}) _ hπ' rfl
  have h2 := spanFinrank_ker_le_spanFinrank_ker_lift_add_one π hx
  lia

end IsLocalRing

end
