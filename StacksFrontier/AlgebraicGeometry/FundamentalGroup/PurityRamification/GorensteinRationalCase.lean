/-!
# Purity at a normal surface point which is a Gorenstein rational singularity

[Stacks, Tag 0EA3] says: let `A` be an excellent regular local ring, `f : X ⟶ Spec A` of finite
type and `x ∈ X` with `𝒪_{X, x}` normal of dimension two; if `f` is étale outside the closure of
`x`, then `f` is étale at `x`.  This file proves that statement when in addition `𝒪_{X, x}` is
Gorenstein and defines a rational singularity ([Stacks, Tag 0B4N]).

A Gorenstein rational surface singularity which is not regular has embedding dimension three
(`AlgebraicGeometry.BlowUpDualizing.finrank_cotangentSpace_eq_three_of_isGorensteinLocalRing`, the
computation `dim_κ(𝔪/𝔪²) = 3` at the start of Section 0BGB of the source); a regular one has
embedding dimension two.  So
`AlgebraicGeometry.etaleAt_of_spanFinrank_le_three_of_etaleAt_outside_closure` applies.  In the
source's proof of Tag 0EA3, `𝒪_{X, x}` is shown to be Gorenstein by duality ([Stacks, Tag 0EA0])
and to define a rational singularity by [Stacks, Tag 0EA2] applied to a resolution of its
spectrum.

## Main results

* `AlgebraicGeometry.spanFinrank_maximalIdeal_le_three_of_isGorensteinLocalRing` — a Gorenstein
  local normal Nagata domain of dimension two defining a rational singularity has embedding
  dimension at most three.
* `AlgebraicGeometry.etaleAt_of_isGorensteinLocalRing_of_definesRationalSingularity` — the
  conclusion of [Stacks, Tag 0EA3] under its hypotheses, when `𝒪_{X, x}` is Gorenstein and
  defines a rational singularity.

## References

* [Stacks Project, Tag 0EA3](https://stacks.math.columbia.edu/tag/0EA3)
* [Stacks Project, Tag 0BGB](https://stacks.math.columbia.edu/tag/0BGB)
-/

@[expose] public section

open CategoryTheory IsLocalRing

universe u

namespace AlgebraicGeometry

/-- **A Gorenstein rational surface singularity has embedding dimension at most three.** Let `B`
be a local normal Nagata domain of dimension two which is Gorenstein and defines a rational
singularity.  Then its maximal ideal is generated by three elements.

If `B` is regular its embedding dimension is its dimension, two.  Otherwise `B`, with the
identity modification of its spectrum, is a Situation [Stacks, Tag 0B4W], and
`AlgebraicGeometry.BlowUpDualizing.finrank_cotangentSpace_eq_three_of_isGorensteinLocalRing`
gives `dim_κ(𝔪/𝔪²) = 3`. -/
theorem spanFinrank_maximalIdeal_le_three_of_isGorensteinLocalRing (B : Type u) [CommRing B]
    [IsLocalRing B] [IsNormalDomain B] (hnagata : IsNagataRing B) (hdim : ringKrullDim B = 2)
    (hrat : DefinesRationalSingularity B)
    (hG : letI : IsNoetherianRing B := hnagata.isNoetherianRing
      Dualizing.IsGorensteinLocalRing B) :
    (maximalIdeal B).spanFinrank ≤ 3 := by
  have : IsNoetherianRing B := hnagata.isNoetherianRing
  by_cases hreg : IsRegularLocalRing B
  · have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := B)
    rw [hdim] at h
    have : (maximalIdeal B).spanFinrank = 2 := by exact_mod_cast h
    lia
  · have : IsNormal (Spec (.of B)) :=
      isNormal_spec_of_isNormalRing (IsNormalRing.of_isIntegrallyClosed B)
    have hfin : (irreducibleComponents
        (Scheme.Hom.fiber (𝟙 (Spec (.of B))) (closedPoint B))).Finite := by
      have : Finite ↥((𝟙 (Spec (.of B)) : Spec (.of B) ⟶ Spec (.of B)) ⁻¹' {closedPoint B}) :=
        Set.Finite.to_subtype ((Set.finite_singleton (closedPoint B)).subset fun _ hy => hy)
      have : Finite (Scheme.Hom.fiber (𝟙 (Spec (.of B))) (closedPoint B)) :=
        .of_equiv _ (Scheme.Hom.fiberHomeo (𝟙 (Spec (.of B))) (closedPoint B)).toEquiv.symm
      exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    have := hfin.to_subtype
    let T : RationalSingularitySituation.{u} :=
      { A := B
        nagata := hnagata
        dimension_two := hdim
        definesRationalSingularity := hrat
        X := Spec (.of B)
        f := 𝟙 _
        modification := isModification_id _
        numberOfComponents := _
        components := (Finite.equivFin _).symm }
    rw [spanFinrank_maximalIdeal_eq_finrank_cotangentSpace_of_fg (IsNoetherian.noetherian _)]
    exact (BlowUpDualizing.finrank_cotangentSpace_eq_three_of_isGorensteinLocalRing T hG hreg).le

/-- **[Stacks, Tag 0EA3] at a Gorenstein rational singularity.**  Let `A` be an excellent regular
local ring, `f : X ⟶ Spec A` locally of finite type and `x ∈ X` with `𝒪_{X, x}` normal of
dimension two.  If `𝒪_{X, x}` is Gorenstein and defines a rational singularity, and `f` is étale
outside the closure of `x`, then `f` is étale at `x`.

`𝒪_{X, x}` is essentially of finite type over the excellent ring `A`, hence excellent, hence
Nagata; so it has embedding dimension at most three
(`AlgebraicGeometry.spanFinrank_maximalIdeal_le_three_of_isGorensteinLocalRing`) and
`AlgebraicGeometry.etaleAt_of_spanFinrank_le_three_of_etaleAt_outside_closure` applies. -/
theorem etaleAt_of_isGorensteinLocalRing_of_definesRationalSingularity {A : Type u} [CommRing A]
    [IsRegularLocalRing A] (hA : IsExcellent A) {X : Scheme.{u}} (f : X ⟶ Spec (.of A))
    [LocallyOfFiniteType f] (x : X) [IsNormalDomain (X.presheaf.stalk x)]
    [IsNoetherianRing (X.presheaf.stalk x)]
    (hdim : ringKrullDim (X.presheaf.stalk x) = 2)
    (hG : Dualizing.IsGorensteinLocalRing (X.presheaf.stalk x))
    (hrat : DefinesRationalSingularity (X.presheaf.stalk x))
    (het : ∀ z : X, z ∉ closure ({x} : Set X) → EtaleAt f z) : EtaleAt f x := by
  let R := (Spec (.of A)).presheaf.stalk (f x)
  let B := X.presheaf.stalk x
  let : Algebra A R := (StructureSheaf.toStalk A (f x)).hom.toAlgebra
  let : Algebra R B := (f.stalkMap x).hom.toAlgebra
  let : Algebra A B := (toStalkStalkMap f x).toAlgebra
  have : IsScalarTower A R B := IsScalarTower.of_algebraMap_eq' rfl
  have : (f x).asIdeal.IsPrime := (f x).isPrime
  have : IsLocalization.AtPrime R (f x).asIdeal := StructureSheaf.IsLocalization.to_stalk A (f x)
  have : Algebra.EssFiniteType A R := .of_isLocalization R (f x).asIdeal.primeCompl
  have : Algebra.EssFiniteType R B := LocallyOfFiniteType.stalkMap f x
  have : Algebra.EssFiniteType A B := Algebra.EssFiniteType.comp A R B
  have hB : IsExcellent B := (isQuasiExcellent_and_isExcellent_of_essFiniteType (R := A)).2 hA
  exact etaleAt_of_spanFinrank_le_three_of_etaleAt_outside_closure hA f x
    (IsNormalRing.of_isIntegrallyClosed B) hdim
    (spanFinrank_maximalIdeal_le_three_of_isGorensteinLocalRing B
      (isNagataRing_of_isQuasiExcellent hB.1) hdim hrat hG) het

end AlgebraicGeometry

end
