module

public import Mathlib.RingTheory.Etale.Kaehler
public import Mathlib.RingTheory.Extension.Cotangent.Basic
public import Mathlib.RingTheory.Support
public import Mathlib.RingTheory.TensorProduct.Free
public import Mathlib.RingTheory.Unramified.Basic
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.PurityRamification.LowEmbeddingDimension

/-!
# Differentials of a local ring cut out by as many equations as variables

Let `R → B` be a ring map with `B` Noetherian local of dimension at least two, and let `P → B` be
an `R`-extension (a surjection of `R`-algebras) such that `Ω_{P/R}` is free of rank `n` and the
kernel of `P → B` is generated by `n` elements.  By the conormal sequence
`I/I² → B ⊗_P Ω_{P/R} → Ω_{B/R} → 0` the module `Ω_{B/R}` is then the cokernel of a square
matrix (the Jacobian matrix of the `n` equations), so by
`IsLocalRing.subsingleton_of_square_presentation` it vanishes as soon as it vanishes at every
prime other than the maximal ideal.  This is the differential step of the case of
[Stacks, Tag 0EA3] in which `𝒪_{X, x}` has embedding dimension at most three.

## Main results

* `IsLocalRing.subsingleton_kaehlerDifferential_of_extension` — the vanishing of `Ω_{B/R}` from
  its vanishing near every non-maximal prime, for such an extension.
* `IsLocalRing.formallyUnramified_of_extension` — the same, phrased as formal unramifiedness:
  if each localization `B_q` at a non-maximal prime is formally unramified over `R`, so is `B`.
* `Ideal.exists_span_range_fin_eq_of_spanFinrank_le` — an ideal generated by at most `n`
  elements is the span of the range of a family indexed by `Fin n`.

## References

* [Stacks Project, Tag 0EA3](https://stacks.math.columbia.edu/tag/0EA3)
-/

@[expose] public section

open TensorProduct

universe u v w

/-- An ideal generated by at most `n` elements is spanned by a family indexed by `Fin n`: a
minimal generating finset is padded with zeros. -/
theorem Ideal.exists_span_range_fin_eq_of_spanFinrank_le {R : Type*} [CommSemiring R]
    {I : Ideal R} (hI : I.FG) {n : ℕ} (hn : I.spanFinrank ≤ n) :
    ∃ g : Fin n → R, Ideal.span (Set.range g) = I := by
  classical
  obtain ⟨s, hcard, hspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank hI
  let e := s.equivFin
  let g : Fin n → R := fun i =>
    if h : (i : ℕ) < s.card then (e.symm ⟨i, h⟩ : R) else 0
  refine ⟨g, le_antisymm ?_ ?_⟩
  · rw [← hspan, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    dsimp only [g]
    split_ifs with h
    · exact Submodule.subset_span (e.symm ⟨i, h⟩).2
    · exact zero_mem _
  · rw [← hspan, Submodule.span_le]
    intro r hr
    refine Ideal.subset_span ⟨⟨e ⟨r, hr⟩, (e ⟨r, hr⟩).2.trans_le (hcard ▸ hn)⟩, ?_⟩
    simp only [g, (e ⟨r, hr⟩).2, dite_true, Fin.eta, Equiv.symm_apply_apply]

namespace IsLocalRing

/-- **The module of differentials of a local ring cut out by `n` equations in a smooth
`n`-dimensional chart.** Let `B` be a Noetherian local `R`-algebra of dimension at least two and
`P → B` an `R`-extension with `Ω_{P/R}` free on `n` generators and kernel generated by `n`
elements `g`.  If `Ω_{B/R}` is killed, near every prime other than the maximal ideal, by an
element outside that prime, then `Ω_{B/R} = 0`.

The conormal sequence `I/I² → B ⊗_P Ω_{P/R} → Ω_{B/R} → 0`
(`Algebra.Extension.exact_cotangentComplex_toKaehler`), with `Bⁿ ↠ I/I²` given by the classes of
the `g_i` (`Algebra.Extension.Cotangent.span_eq_top_of_span_eq_ker`) and
`B ⊗_P Ω_{P/R} ≅ Bⁿ`, presents `Ω_{B/R}` as the cokernel of a square matrix, and
`IsLocalRing.subsingleton_of_square_presentation` applies. -/
theorem subsingleton_kaehlerDifferential_of_extension {R : Type u} {B : Type v} [CommRing R]
    [CommRing B] [Algebra R B] [IsNoetherianRing B] [IsLocalRing B] (hdim : 2 ≤ ringKrullDim B)
    (P : Algebra.Extension.{w} R B) {n : ℕ} (b : Module.Basis (Fin n) P.Ring Ω[P.Ring⁄R])
    (g : Fin n → P.Ring) (hg : Ideal.span (Set.range g) = P.ker)
    (hloc : ∀ p : Ideal B, p.IsPrime → p ≠ maximalIdeal B →
      ∃ s ∉ p, ∀ m : Ω[B⁄R], s • m = 0) :
    Subsingleton Ω[B⁄R] := by
  let bB : Module.Basis (Fin n) B P.CotangentSpace := Algebra.TensorProduct.basis B b
  let e := bB.equivFun
  let ψ : (Fin n → B) →ₗ[B] P.Cotangent := Fintype.linearCombination B
    (fun i => Algebra.Extension.Cotangent.mk ⟨g i, hg.le (Ideal.subset_span ⟨i, rfl⟩)⟩)
  have hψ : Function.Surjective ψ := by
    rw [← LinearMap.range_eq_top, Fintype.range_linearCombination]
    exact Algebra.Extension.Cotangent.span_eq_top_of_span_eq_ker g hg
  refine subsingleton_of_square_presentation hdim
    (e.toLinearMap ∘ₗ P.cotangentComplex ∘ₗ ψ) (P.toKaehler ∘ₗ e.symm.toLinearMap)
    (P.toKaehler_surjective.comp e.symm.surjective) ?_ hloc
  ext v
  simp only [LinearMap.mem_range, LinearMap.mem_ker, LinearMap.coe_comp, LinearEquiv.coe_coe,
    Function.comp_apply]
  constructor
  · rintro ⟨w, rfl⟩
    rw [LinearEquiv.symm_apply_apply]
    exact P.exact_cotangentComplex_toKaehler.apply_apply_eq_zero _
  · intro hv
    obtain ⟨c, hc⟩ := (P.exact_cotangentComplex_toKaehler (e.symm v)).mp hv
    obtain ⟨w, rfl⟩ := hψ c
    exact ⟨w, by rw [hc, LinearEquiv.apply_symm_apply]⟩

/-- **Formal unramifiedness of a local ring cut out by `n` equations in a smooth `n`-dimensional
chart, from formal unramifiedness at the non-maximal primes.** Let `B` be a Noetherian local
`R`-algebra of dimension at least two and `P → B` an `R`-extension with `Ω_{P/R}` free on `n`
generators and kernel generated by `n` elements.  If the localization of `B` at every prime other
than the maximal ideal is formally unramified over `R`, then `B` is formally unramified over `R`.

`Ω_{B/R}` is a quotient of `B ⊗_P Ω_{P/R} ≅ Bⁿ`, hence finite; its localization at a prime `q` is
`Ω_{B_q/R} = 0`, so `q` is outside its support, and an element of its annihilator lies outside
`q`.  Then `IsLocalRing.subsingleton_kaehlerDifferential_of_extension` applies. -/
theorem formallyUnramified_of_extension {R : Type u} {B : Type v} [CommRing R]
    [CommRing B] [Algebra R B] [IsNoetherianRing B] [IsLocalRing B] (hdim : 2 ≤ ringKrullDim B)
    (P : Algebra.Extension.{w} R B) {n : ℕ} (b : Module.Basis (Fin n) P.Ring Ω[P.Ring⁄R])
    (g : Fin n → P.Ring) (hg : Ideal.span (Set.range g) = P.ker)
    (hloc : ∀ (q : Ideal B) [q.IsPrime], q ≠ maximalIdeal B →
      Algebra.FormallyUnramified R (Localization.AtPrime q)) :
    Algebra.FormallyUnramified R B := by
  have : Module.Finite B P.CotangentSpace :=
    Module.Finite.of_basis (Algebra.TensorProduct.basis B b)
  have : Module.Finite B Ω[B⁄R] := Module.Finite.of_surjective _ P.toKaehler_surjective
  refine ⟨subsingleton_kaehlerDifferential_of_extension hdim P b g hg fun q hq hqm => ?_⟩
  have hFU := hloc q hqm
  have hall := (IsLocalizedModule.subsingleton_iff q.primeCompl
    (KaehlerDifferential.map R R B (Localization.AtPrime q))).mp inferInstance
  have hns : (⟨q, hq⟩ : PrimeSpectrum B) ∉ Module.support B Ω[B⁄R] :=
    Module.notMem_support_iff'.mpr fun m => by
      obtain ⟨r, hr, hrm⟩ := hall m
      exact ⟨r, hr, hrm⟩
  rw [Module.mem_support_iff_of_finite, SetLike.not_le_iff_exists] at hns
  obtain ⟨s, hs, hsq⟩ := hns
  exact ⟨s, hsq, Module.mem_annihilator.mp hs⟩

end IsLocalRing

end
