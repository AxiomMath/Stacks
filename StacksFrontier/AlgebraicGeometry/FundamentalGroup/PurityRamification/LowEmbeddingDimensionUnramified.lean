module

public import Mathlib.RingTheory.Kaehler.Polynomial
public import Mathlib.RingTheory.RegularLocalRing.Polynomial
public import Mathlib.RingTheory.TensorProduct.IsBaseChangeFree
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.PurityRamification.KaehlerSquarePresentation
public import StacksFrontier.RingTheory.DimensionFormula

/-!
# Formal unramifiedness of a two-dimensional local domain of embedding dimension at most three

Let `R` be a regular, universally catenary domain and `B` a local `R`-domain of dimension two and
embedding dimension at most three, essentially of finite type over `R` with `R → B` injective:
`B` is the localization of the image of `ψ₀ : R[T_1, …, T_n] → B`.  Then `B` is the quotient of
the regular local ring `P = R[T_1, …, T_n]_Q` (`Q` the inverse image of the maximal ideal of `B`)
whose dimension is at most `n + 2` by the dimension formula ([Stacks, Tag 02IJ]) applied to `P`
and to the image of `ψ₀`; hence the kernel of `P → B` is generated by `n` elements
(`IsLocalRing.spanFinrank_ker_add_two_le`), `Ω_{B/R}` is the cokernel of a square matrix, and
`B` is formally unramified over `R` as soon as its localizations at the non-maximal primes are
(`IsLocalRing.formallyUnramified_of_extension`).  This is the algebraic core of the case of
[Stacks, Tag 0EA3] in which `𝒪_{X, x}` has embedding dimension at most three.

## Main results

* `IsLocalRing.height_comap_maximalIdeal_le_add_two` — the height bound `ht Q ≤ n + 2`.
* `IsLocalRing.formallyUnramified_of_spanFinrank_maximalIdeal_le_three` — the formal
  unramifiedness of `B` over `R`.

## References

* [Stacks Project, Tag 0EA3](https://stacks.math.columbia.edu/tag/0EA3)
* [Stacks Project, Tag 02IJ](https://stacks.math.columbia.edu/tag/02IJ)
-/

@[expose] public section

universe u

namespace IsLocalRing

/-- **The height bound behind the small embedding dimension case.** Let `R` be a Noetherian,
universally catenary domain and `B` a local `R`-domain of dimension two with `R → B` injective,
which is the localization of the image of an `R`-algebra map `ψ₀ : R[T_1, …, T_n] → B`. Then the
inverse image `Q` of the maximal ideal of `B` has height at most `n + 2`.

Write `C = R[T]/ker ψ₀ ⊆ B` and `Q'` for the image of `Q` in `C`, so that `B = C_{Q'}` and
`ht Q' = 2`, and let `p` be the prime of `R` under `Q`.  The dimension formula
([Stacks, Tag 02IJ], `height_add_trdeg_residue_eq`) for `R[T]` at `Q` and for `C` at `Q'`, whose
residue fields agree, gives `ht Q + t = ht p + n` and `2 + t = ht p + trdeg_R C ≥ ht p`. -/
theorem height_comap_maximalIdeal_le_add_two {R B : Type u} [CommRing R] [IsNoetherianRing R]
    [IsDomain R] (hcat : IsUniversallyCatenary R) [CommRing B] [IsLocalRing B] [IsDomain B]
    [Algebra R B] (hinj : Function.Injective (algebraMap R B)) (hdim : ringKrullDim B = 2)
    {n : ℕ} (ψ₀ : MvPolynomial (Fin n) R →ₐ[R] B)
    (hsurj : ∀ b : B, ∃ a s, IsUnit (ψ₀ s) ∧ b * ψ₀ s = ψ₀ a) :
    (Ideal.comap ψ₀ (maximalIdeal B)).height ≤ n + 2 := by
  let P₀ := MvPolynomial (Fin n) R
  let Q₀ : Ideal P₀ := RingHom.ker ψ₀
  have : Q₀.IsPrime := RingHom.ker_isPrime _
  let C := P₀ ⧸ Q₀
  let ψ' : C →ₐ[R] B := Ideal.Quotient.liftₐ Q₀ ψ₀ fun a ha => ha
  have hψ' : ∀ a : P₀, ψ' (Ideal.Quotient.mk Q₀ a) = ψ₀ a := fun a => rfl
  have hψ'inj : Function.Injective ψ' := by
    intro c d hcd
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective d
    rw [hψ', hψ'] at hcd
    exact Ideal.Quotient.eq.mpr (by simp [Q₀, RingHom.mem_ker, hcd])
  let _ : Algebra C B := ψ'.toAlgebra
  let Q' : Ideal C := Ideal.comap ψ' (maximalIdeal B)
  have : Q'.IsPrime := Ideal.comap_isPrime _ _
  have hloc : IsLocalization.AtPrime B Q' :=
    { map_units := fun y => IsLocalRing.notMem_maximalIdeal.mp y.2
      surj := fun b => by
        obtain ⟨a, s, hs, hb⟩ := hsurj b
        exact ⟨(Ideal.Quotient.mk Q₀ a, ⟨Ideal.Quotient.mk Q₀ s,
          fun h => (IsLocalRing.mem_maximalIdeal _).mp h hs⟩), hb⟩
      exists_of_eq := fun {x y} h => ⟨1, by rw [hψ'inj h]⟩ }
  have hQ' : Q'.height = 2 := by
    have := IsLocalization.AtPrime.ringKrullDim_eq_height Q' B
    rw [hdim] at this
    exact WithBot.coe_injective this.symm
  have hinjC : Function.Injective (algebraMap R C) := by
    refine Function.Injective.of_comp (f := ψ') ?_
    have : (ψ' : C → B) ∘ algebraMap R C = algebraMap R B := funext ψ'.commutes
    rwa [this]
  let p : Ideal R := Q'.under R
  let Q : Ideal P₀ := Ideal.comap (Ideal.Quotient.mk Q₀) Q'
  have hQ : Ideal.comap ψ₀ (maximalIdeal B) = Q := rfl
  rw [hQ]
  have hcomp : (Ideal.Quotient.mk Q₀).comp (algebraMap R P₀) = algebraMap R C := rfl
  have : Q.LiesOver p := ⟨by
    change Ideal.comap (algebraMap R C) Q' = Ideal.comap (algebraMap R P₀) Q
    rw [← hcomp, ← Ideal.comap_comap]⟩
  have h1 := height_add_trdeg_residue_eq (R := R) (S := P₀)
    (MvPolynomial.C_injective _ _) hcat p Q
  have h2 := height_add_trdeg_residue_eq (R := R) (S := C) hinjC hcat p Q'
  have h3 := resfield_trdeg_comap_eq (Ideal.Quotient.mk Q₀)
    Ideal.Quotient.mk_surjective hcomp p Q'
  have htr : Cardinal.toNat (Algebra.trdeg R P₀) = n := by
    simp [P₀, MvPolynomial.trdeg_of_isDomain]
  rw [htr] at h1
  rw [hQ'] at h2
  let := Ideal.ResidueField.algebraOfLiesOver p Q
  let := Ideal.ResidueField.algebraOfLiesOver p Q'
  rw [h3] at h1
  set t : ℕ := Cardinal.toNat (Algebra.trdeg p.ResidueField Q'.ResidueField)
  have hle : Q.height + t ≤ (n + 2 : ℕ∞) + t := by
    rw [h1]
    calc p.height + n ≤ p.height + (Cardinal.toNat (Algebra.trdeg R C) : ℕ∞) + n :=
          add_le_add_left le_self_add _
      _ = (n + 2 : ℕ∞) + t := by
        rw [← h2]
        ring
  exact (ENat.add_le_add_iff_right (ENat.natCast_ne_top t)).mp hle

/-- **A two-dimensional local domain of embedding dimension at most three is formally
unramified as soon as it is so at its non-maximal primes.**  Let `R` be a regular, universally
catenary domain and `B` a local `R`-domain of dimension two and embedding dimension at most three
with `R → B` injective, which is the localization of the image of an `R`-algebra map
`ψ₀ : R[T_1, …, T_n] → B`.  If the localization of `B` at every prime other than the maximal ideal
is formally unramified over `R`, then so is `B`.

`ψ₀` extends to a surjection from `P = R[T]_Q`, `Q = ψ₀⁻¹(𝔪_B)`, which is regular local of
dimension `ht Q ≤ n + 2` (`IsLocalRing.height_comap_maximalIdeal_le_add_two`); so its kernel is
generated by `n` elements (`IsLocalRing.spanFinrank_ker_add_two_le`), `Ω_{P/R}` is free on the
`dT_i` (`P` is a localization of the polynomial ring), and
`IsLocalRing.formallyUnramified_of_extension` applies. -/
theorem formallyUnramified_of_spanFinrank_maximalIdeal_le_three {R B : Type u} [CommRing R]
    [IsDomain R] [IsRegularRing R] (hcat : IsUniversallyCatenary R) [CommRing B] [IsLocalRing B]
    [IsDomain B] [IsNoetherianRing B] [Algebra R B] (hinj : Function.Injective (algebraMap R B))
    (hdim : ringKrullDim B = 2) (hemb : (maximalIdeal B).spanFinrank ≤ 3) {n : ℕ}
    (ψ₀ : MvPolynomial (Fin n) R →ₐ[R] B)
    (hsurj : ∀ b : B, ∃ a s, IsUnit (ψ₀ s) ∧ b * ψ₀ s = ψ₀ a)
    (hloc : ∀ (q : Ideal B) [q.IsPrime], q ≠ maximalIdeal B →
      Algebra.FormallyUnramified R (Localization.AtPrime q)) :
    Algebra.FormallyUnramified R B := by
  let P₀ := MvPolynomial (Fin n) R
  let Q : Ideal P₀ := Ideal.comap ψ₀ (maximalIdeal B)
  have : Q.IsPrime := Ideal.comap_isPrime _ _
  let P := Localization.AtPrime Q
  have hunit : ∀ s : Q.primeCompl, IsUnit (ψ₀ s) := fun s =>
    IsLocalRing.notMem_maximalIdeal.mp s.2
  let ψ : P →ₐ[R] B := IsLocalization.liftAlgHom (M := Q.primeCompl) (f := ψ₀) hunit
  have hψ : Function.Surjective ψ := by
    intro b
    obtain ⟨a, s, hs, hb⟩ := hsurj b
    have hsQ : s ∈ Q.primeCompl := fun h => (IsLocalRing.mem_maximalIdeal _).mp h hs
    refine ⟨IsLocalization.mk' P a ⟨s, hsQ⟩, ?_⟩
    rw [IsLocalization.coe_liftAlgHom, IsLocalization.lift_mk'_spec]
    exact hb.symm.trans (mul_comm _ _)
  have hdimP : ((maximalIdeal P).spanFinrank : WithBot ℕ∞) ≤ ((n + 2 : ℕ) : ℕ∞) := by
    rw [IsRegularLocalRing.spanFinrank_maximalIdeal,
      IsLocalization.AtPrime.ringKrullDim_eq_height Q P]
    exact_mod_cast height_comap_maximalIdeal_le_add_two hcat hinj hdim ψ₀ hsurj
  have hdimP' : (maximalIdeal P).spanFinrank ≤ n + 2 := by exact_mod_cast hdimP
  have hker := spanFinrank_ker_add_two_le ψ.toRingHom hψ hdim hemb
  obtain ⟨g, hg⟩ := Ideal.exists_span_range_fin_eq_of_spanFinrank_le
    (IsNoetherian.noetherian (RingHom.ker ψ.toRingHom)) (n := n) (by omega)
  let E := Algebra.Extension.ofSurjective ψ hψ
  let b : Module.Basis (Fin n) P Ω[P⁄R] :=
    (KaehlerDifferential.isBaseChange_of_formallyEtale R P₀ P).basis
      (KaehlerDifferential.mvPolynomialBasis R (Fin n))
  exact formallyUnramified_of_extension (by rw [hdim]) E b g hg hloc

end IsLocalRing

end
