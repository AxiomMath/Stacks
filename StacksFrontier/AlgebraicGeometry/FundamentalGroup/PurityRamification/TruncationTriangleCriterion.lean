module

public import Mathlib.Algebra.Homology.DerivedCategory.FullyFaithful
public import Mathlib.Algebra.Homology.DerivedCategory.HomologySequence
public import Mathlib.Algebra.Homology.DerivedCategory.Linear
public import Mathlib.Algebra.Homology.DerivedCategory.TStructure
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.PurityRamification.CyclicSubmoduleBijective
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.PurityRamification.SplitTriangle

/-!
# The vanishing of `R¹f_*𝒪_X` from a trace that is an isomorphism

This file carries out, in the derived category of `A`-modules, the part of the proof of
[Stacks, Tag 0EA2] that comes after the geometric inputs. Let `A` be a Noetherian normal local
domain of dimension at least two, `N` a finite `A`-module of positive depth which is not torsion
(in the application the dualizing module `ω_A`), and `K` an object of `D(A)` with cohomology in
degrees `0` and `1` only and `H⁰(K) = A` (in the application `K = Rf_*𝒪_X`, so that `H¹(K)` is
`H¹(X, 𝒪_X)`). Suppose

* `Hom(K, N)` is a cyclic `A`-module, generated by some `φ₀` (in the application this is
  `Hom(Rf_*𝒪_X, ω_A) = Hom(𝒪_X, ω_X) = Γ(X, 𝒪_X(E)) = A`, by duality and Hartogs, `φ₀` being the
  trace composed with the section `𝒪_X ⟶ 𝒪_X(E)`),
* `H¹(K)` is killed by a power of the maximal ideal, and
* every morphism `κ[-1] ⟶ K` vanishes ([Stacks, Tag 0AXC]).

Then `H¹(K) = 0`.

## The argument

Write `A ⟶ K ⟶ H¹(K)[-1] ⟶ A[1]` for the truncation triangle and `η : A ⟶ K` for its first
morphism. The cokernel of `Hom(K, N) ⟶ Hom(A, N) = N` embeds into `Hom(H¹(K)[-1], N[1])`, which
is killed by the annihilator of `H¹(K)`; so the image of that map, the cyclic module generated by
`t = η ≫ φ₀`, contains `𝔪ᵏ N`. By `Stacks.PurityRamification.bijective_smul_of_smul_le_span` the
map `a ↦ a t` is then an isomorphism `A ≅ N`, that is, `η ≫ φ₀` is invertible. This is the
source's "the composition `A = f_*𝒪_X → f_*ω_X → ω_A` is an isomorphism". By
`Stacks.PurityRamification.eq_zero_of_isIso_mor₁_comp_of_forall_eq_zero` every morphism
`κ[-1] ⟶ H¹(K)[-1]` therefore lifts to `K` and vanishes, so `H¹(K)` has no nonzero element killed
by the maximal ideal; being killed by a power of it, it is zero.

## Main results

* `Stacks.PurityRamification.exists_comp_eq_smul_of_smul_eq_zero`: the image of
  `Hom(K, N) ⟶ Hom(A, N)` contains `c • Hom(A, N)` for every `c` killing `H¹(K)`.
* `Stacks.PurityRamification.subsingleton_homology_one_of_forall_eq_smul`: the vanishing.

## References

* [Stacks Project, Tag 0EA2](https://stacks.math.columbia.edu/tag/0EA2)
* [Stacks Project, Tag 0AXC](https://stacks.math.columbia.edu/tag/0AXC)
-/

@[expose] public noncomputable section

open CategoryTheory Limits Pretriangulated DerivedCategory

universe w u

namespace Stacks.PurityRamification

section Lift

variable {A : Type u} [CommRing A] [HasDerivedCategory.{w} (ModuleCat.{u} A)]

/-- **The cokernel of the restriction along the first morphism of a triangle is killed by the
annihilator of the third object.** Let `X ⟶ K ⟶ Y ⟶ X⟦1⟧` be a distinguished triangle in `D(A)`
and `c ∈ A` with `c • 𝟙_Y = 0`. Then for every morphism `y : X ⟶ Z`, the multiple `c • y`
extends along `X ⟶ K`. -/
theorem exists_comp_eq_smul_of_smul_id_eq_zero (T : Triangle (DerivedCategory (ModuleCat.{u} A)))
    (hT : T ∈ distTriang _) (c : A) (hc : c • 𝟙 T.obj₃ = 0) {Z : DerivedCategory (ModuleCat.{u} A)}
    (y : T.obj₁ ⟶ Z) : ∃ φ : T.obj₂ ⟶ Z, T.mor₁ ≫ φ = c • y := by
  have hc' : c • 𝟙 (T.obj₃⟦(-1 : ℤ)⟧) = 0 := by
    rw [← CategoryTheory.Functor.map_id, ← Functor.map_smul, hc, Functor.map_zero]
  have h : T.invRotate.mor₁ ≫ (c • y) = 0 := by
    have e₁ : T.invRotate.mor₁ ≫ (c • y) = c • (T.invRotate.mor₁ ≫ y) :=
      Linear.comp_smul _ _ _ _ _ _
    have e₂ : c • (T.invRotate.mor₁ ≫ y) = (c • 𝟙 (T.obj₃⟦(-1 : ℤ)⟧)) ≫ T.invRotate.mor₁ ≫ y := by
      rw [Linear.smul_comp, Category.id_comp]
      rfl
    rw [e₁, e₂, hc']
    exact zero_comp
  obtain ⟨φ, hφ⟩ := Triangle.yoneda_exact₂ T.invRotate (inv_rot_of_distTriang T hT) _ h
  exact ⟨φ, hφ.symm⟩

end Lift


section Truncation

variable {C : Type*} [Category* C] [Abelian C] [HasDerivedCategory.{w} C]

/-- An object with cohomology only in degree `a` is the single complex of any object with
isomorphic `a`-th cohomology. -/
private theorem nonempty_iso_singleFunctor_of_iso_homology (Z X : DerivedCategory C) (a : ℤ)
    [Z.IsGE a] [Z.IsLE a] (i : (homologyFunctor C a).obj Z ≅ (homologyFunctor C a).obj X) :
    Nonempty (Z ≅ (singleFunctor C a).obj ((homologyFunctor C a).obj X)) := by
  obtain ⟨Y, ⟨e⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE Z a
  exact ⟨e ≪≫ (singleFunctor C a).mapIso
    (((singleFunctorCompHomologyFunctorIso C a).app Y).symm ≪≫
      ((homologyFunctor C a).mapIso e).symm ≪≫ i)⟩

/-- The bottom truncation `τ^{<a+1}X` of an object with no cohomology below `a` is the single
complex of `H^a(X)` in degree `a`. -/
theorem nonempty_iso_singleFunctor_truncLT_succ (X : DerivedCategory C) (a : ℤ) [X.IsGE a] :
    Nonempty ((TStructure.t.truncLT (a + 1)).obj X ≅
      (singleFunctor C a).obj ((homologyFunctor C a).obj X)) := by
  have h₂ : TStructure.t.IsGE ((TStructure.t.triangleLTGE (a + 1)).obj X).obj₂ a :=
    ‹X.IsGE a›
  have h₃ : TStructure.t.IsGE
      (((TStructure.t.triangleLTGE (a + 1)).obj X).obj₃⟦(-1 : ℤ)⟧) a := by
    have h : TStructure.t.IsGE
        ((((TStructure.t.triangleLTGE (a + 1)).obj X).obj₃)⟦(-1 : ℤ)⟧) (a + 2) :=
      TStructure.t.isGE_shift ((TStructure.t.triangleLTGE (a + 1)).obj X).obj₃ (a + 1) (-1)
        (a + 2)
    exact TStructure.t.isGE_of_ge _ a (a + 2)
  have h₁ : ((TStructure.t.truncLT (a + 1)).obj X).IsGE a :=
    TStructure.t.isGE₂ ((TStructure.t.triangleLTGE (a + 1)).obj X).invRotate
      (inv_rot_of_distTriang _ (TStructure.t.triangleLTGE_distinguished (a + 1) X)) a h₃ h₂
  have h₄ : ((TStructure.t.truncLT (a + 1)).obj X).IsLE a :=
    TStructure.t.isLE_of_le _ (a + 1 - 1) a
  have : IsIso ((homologyFunctor C a).map ((TStructure.t.truncLTι (a + 1)).app X)) := by
    have hT := TStructure.t.triangleLTGE_distinguished (a + 1) X
    have : Epi ((homologyFunctor C a).map
        ((TStructure.t.triangleLTGE (a + 1)).obj X).mor₁) := by
      rw [HomologySequence.epi_homologyMap_mor₁_iff _ hT a]
      exact (isZero_of_isGE _ (a + 1) a (by omega)).eq_of_tgt _ _
    have : Mono ((homologyFunctor C a).map
        ((TStructure.t.triangleLTGE (a + 1)).obj X).mor₁) := by
      rw [HomologySequence.mono_homologyMap_mor₁_iff _ hT (a - 1) a (by omega)]
      exact (isZero_of_isGE _ (a + 1) (a - 1) (by omega)).eq_of_src _ _
    show IsIso ((homologyFunctor C a).map ((TStructure.t.triangleLTGE (a + 1)).obj X).mor₁)
    exact isIso_of_mono_of_epi _
  exact nonempty_iso_singleFunctor_of_iso_homology _ X a
    (asIso ((homologyFunctor C a).map ((TStructure.t.truncLTι (a + 1)).app X)))

/-- The top truncation `τ^{≥b}X` of an object with no cohomology above `b` is the single complex
of `H^b(X)` in degree `b`. -/
theorem nonempty_iso_singleFunctor_truncGE (X : DerivedCategory C) (b : ℤ) [X.IsLE b] :
    Nonempty ((TStructure.t.truncGE b).obj X ≅
      (singleFunctor C b).obj ((homologyFunctor C b).obj X)) := by
  have h₂ : TStructure.t.IsLE ((TStructure.t.triangleLTGE b).obj X).obj₂ b := ‹X.IsLE b›
  have h₃ : TStructure.t.IsLE
      (((TStructure.t.triangleLTGE b).obj X).obj₁⟦(1 : ℤ)⟧) b := by
    have h : TStructure.t.IsLE
        ((((TStructure.t.triangleLTGE b).obj X).obj₁)⟦(1 : ℤ)⟧) (b - 2) :=
      TStructure.t.isLE_shift ((TStructure.t.triangleLTGE b).obj X).obj₁ (b - 1) 1 (b - 2)
    exact TStructure.t.isLE_of_le _ (b - 2) b
  have h₁ : ((TStructure.t.truncGE b).obj X).IsLE b :=
    TStructure.t.isLE₂ ((TStructure.t.triangleLTGE b).obj X).rotate
      (rot_of_distTriang _ (TStructure.t.triangleLTGE_distinguished b X)) b h₂ h₃
  have : IsIso ((homologyFunctor C b).map ((TStructure.t.truncGEπ b).app X)) := by
    have hT := TStructure.t.triangleLTGE_distinguished b X
    have : Epi ((homologyFunctor C b).map
        ((TStructure.t.triangleLTGE b).obj X).mor₂) := by
      rw [HomologySequence.epi_homologyMap_mor₂_iff _ hT b (b + 1) rfl]
      exact (isZero_of_isLE ((TStructure.t.triangleLTGE b).obj X).obj₁ (b - 1) (b + 1)
        (by omega)).eq_of_tgt _ _
    have : Mono ((homologyFunctor C b).map
        ((TStructure.t.triangleLTGE b).obj X).mor₂) := by
      rw [HomologySequence.mono_homologyMap_mor₂_iff _ hT b]
      exact (isZero_of_isLE ((TStructure.t.triangleLTGE b).obj X).obj₁ (b - 1) b
        (by omega)).eq_of_src _ _
    show IsIso ((homologyFunctor C b).map ((TStructure.t.triangleLTGE b).obj X).mor₂)
    exact isIso_of_mono_of_epi _
  exact nonempty_iso_singleFunctor_of_iso_homology _ X b
    (asIso ((homologyFunctor C b).map ((TStructure.t.truncGEπ b).app X))).symm

end Truncation


section Criterion

variable {A : Type u} [CommRing A] [HasDerivedCategory.{w} (ModuleCat.{u} A)]

omit [HasDerivedCategory.{w} (ModuleCat.{u} A)] in
/-- A nonzero module all of whose elements are killed by elements outside every prime other than
the maximal ideal has a nonzero map from the residue field: the maximal ideal is its only
possible associated prime, and a nonzero module over a Noetherian ring has one. -/
theorem exists_ne_zero_of_forall_prime_ne {R : Type u} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] (M : Type u) [AddCommGroup M] [Module R M] [Nontrivial M]
    (hM : ∀ (p : Ideal R) (_ : p.IsPrime), p ≠ IsLocalRing.maximalIdeal R →
      ∃ c : R, c ∉ p ∧ ∀ x : M, c • x = 0) :
    ∃ g : IsLocalRing.ResidueField R →ₗ[R] M, g ≠ 0 := by
  obtain ⟨p, hp⟩ := associatedPrimes.nonempty R M
  have hpm : p = IsLocalRing.maximalIdeal R := by
    by_contra hne
    obtain ⟨c, hcp, hc⟩ := hM p hp.isPrime hne
    exact hcp (hp.annihilator_le (Submodule.mem_annihilator.2 fun x _ => hc x))
  subst hpm
  obtain ⟨-, g, hg⟩ := (isAssociatedPrime_iff_exists_injective_linearMap _ M).1 hp
  exact ⟨g, fun h0 => one_ne_zero (hg (by rw [map_zero]; exact LinearMap.congr_fun h0 1))⟩


omit [HasDerivedCategory.{w} (ModuleCat.{u} A)] in
/-- A morphism of `A`-modules out of `A` is multiplication against the image of `1`. -/
theorem eq_ofHom_toSpanSingleton {N : ModuleCat.{u} A} (g : ModuleCat.of A A ⟶ N) :
    g = ModuleCat.ofHom (LinearMap.toSpanSingleton A N (g.hom 1)) := by
  refine ModuleCat.hom_ext (LinearMap.ext fun a => ?_)
  show g.hom a = a • g.hom 1
  rw [← map_smul, smul_eq_mul, mul_one]

/-- Multiplication by a scalar killing a module kills its single complex. -/
theorem smul_id_singleFunctor_eq_zero (n : ℤ) (M : ModuleCat.{u} A) (c : A)
    (hc : ∀ x : M, c • x = 0) : c • 𝟙 ((singleFunctor (ModuleCat.{u} A) n).obj M) = 0 := by
  have h : c • 𝟙 M = 0 := ModuleCat.hom_ext (LinearMap.ext hc)
  rw [← (singleFunctor (ModuleCat.{u} A) n).map_id, ← Functor.map_smul, h, Functor.map_zero]

/-- **The criterion.** Let `A` be a Noetherian normal local domain of dimension at least two and
`K` an object of `D(A)` with cohomology in degrees `n` and `n + 1` only, `Hⁿ(K) ≅ A`, and
`H^{n+1}(K)` killed, for every prime `p ≠ 𝔪`, by an element outside `p`. Let `N` be a finite
`A`-module of positive depth such that `Hom(K, N[-n])` is a free `A`-module of rank one, and
suppose every morphism `κ[-n-1] ⟶ K` vanishes. Then `H^{n+1}(K) = 0` and `N ≅ A`.

In the application `n = -2`, `K = RΓ(X, 𝒪_X[2])`, `N = ω_A`, the rank-one freeness is the
hypothesis `ω_X ≅ 𝒪_X(E)` of [Stacks, Tag 0EA2] read through duality, and the vanishing of the
morphisms out of `κ[-n-1]` is [Stacks, Tag 0AXC]. -/
theorem subsingleton_homology_succ_of_forall_eq_smul [IsNoetherianRing A] [IsLocalRing A]
    [IsDomain A] [IsIntegrallyClosed A] (hdim : (2 : WithBot ℕ∞) ≤ ringKrullDim A)
    (K : DerivedCategory (ModuleCat.{u} A)) (n : ℤ) [K.IsGE n] [K.IsLE (n + 1)]
    (e₀ : (homologyFunctor (ModuleCat.{u} A) n).obj K ≅ ModuleCat.of A A)
    (hM : ∀ (p : Ideal A) (_ : p.IsPrime), p ≠ IsLocalRing.maximalIdeal A →
      ∃ c : A, c ∉ p ∧ ∀ x : (homologyFunctor (ModuleCat.{u} A) (n + 1)).obj K, c • x = 0)
    (N : ModuleCat.{u} A) [Module.Finite A N]
    (hdepth : (1 : ℕ∞) ≤ Module.depth A (IsLocalRing.maximalIdeal A) N)
    (φ₀ : K ⟶ (singleFunctor (ModuleCat.{u} A) n).obj N)
    (hgen : ∀ χ : K ⟶ (singleFunctor (ModuleCat.{u} A) n).obj N, ∃ b : A, χ = b • φ₀)
    (hfree : ∀ b : A, b • φ₀ = 0 → b = 0)
    (hκ : ∀ g : (singleFunctor (ModuleCat.{u} A) (n + 1)).obj
      (ModuleCat.of A (IsLocalRing.ResidueField A)) ⟶ K, g = 0) :
    Subsingleton ((homologyFunctor (ModuleCat.{u} A) (n + 1)).obj K) ∧
      Nonempty (N ≅ ModuleCat.of A A) := by
  set M := (homologyFunctor (ModuleCat.{u} A) (n + 1)).obj K
  let S := singleFunctor (ModuleCat.{u} A) n
  let Tr := (TStructure.t.triangleLTGE (n + 1)).obj K
  have hTr : Tr ∈ distTriang _ := TStructure.t.triangleLTGE_distinguished (n + 1) K
  let φ : Tr.obj₂ ⟶ S.obj N := φ₀
  have hgen' : ∀ χ : Tr.obj₂ ⟶ S.obj N, ∃ b : A, χ = b • φ := hgen
  have hfree' : ∀ b : A, b • φ = 0 → b = 0 := hfree
  have hκ' : ∀ g : (singleFunctor (ModuleCat.{u} A) (n + 1)).obj
      (ModuleCat.of A (IsLocalRing.ResidueField A)) ⟶ Tr.obj₂, g = 0 := hκ
  obtain ⟨e₁'⟩ := nonempty_iso_singleFunctor_truncLT_succ K n
  let e₁ : Tr.obj₁ ≅ S.obj (ModuleCat.of A A) := e₁' ≪≫ S.mapIso e₀
  obtain ⟨e₃'⟩ := nonempty_iso_singleFunctor_truncGE K (n + 1)
  let e₃ : Tr.obj₃ ≅ (singleFunctor (ModuleCat.{u} A) (n + 1)).obj M := e₃'
  -- scalars killing `M` kill the third object of the triangle
  have hc₃ : ∀ c : A, (∀ x : M, c • x = 0) → c • 𝟙 Tr.obj₃ = 0 := by
    intro c hc
    have h := smul_id_singleFunctor_eq_zero (n + 1) M c hc
    calc c • 𝟙 Tr.obj₃ = e₃.hom ≫ (c • 𝟙 _) ≫ e₃.inv := by
          rw [Linear.smul_comp, Linear.comp_smul, Category.id_comp, Iso.hom_inv_id]
      _ = 0 := by rw [h, zero_comp, comp_zero]
  -- `A` is not a field
  have hbot : (⊥ : Ideal A) ≠ IsLocalRing.maximalIdeal A := by
    intro h
    have hfield : IsField A := (IsLocalRing.isField_iff_maximalIdeal_eq).2 h.symm
    rw [ringKrullDim_eq_zero_of_isField hfield] at hdim
    exact absurd hdim (by decide)
  obtain ⟨c₀, hc₀, hc₀M⟩ := hM ⊥ Ideal.isPrime_bot hbot
  have hc₀' : c₀ ≠ 0 := fun h => hc₀ (h ▸ (Submodule.mem_bot A).2 rfl)
  -- the composite `A ⟶ K ⟶ N` and the element `t`
  let g₀ : ModuleCat.of A A ⟶ N := S.preimage (e₁.inv ≫ Tr.mor₁ ≫ φ)
  have hg₀ : S.map g₀ = e₁.inv ≫ Tr.mor₁ ≫ φ := S.map_preimage _
  have hmap : ∀ b : A, S.map (b • g₀) = e₁.inv ≫ Tr.mor₁ ≫ (b • φ) := fun b => by
    rw [Functor.map_smul, hg₀, Linear.comp_smul, Linear.comp_smul]
  set t : N := g₀.hom 1
  -- every `c • x` with `c` killing `M` is a multiple of `t`
  have ht : ∀ c ∈ Module.annihilator A M, ∀ x : N, ∃ b : A, c • x = b • t := by
    intro c hc x
    have hc' : ∀ y : M, c • y = 0 := fun y => Module.mem_annihilator.1 hc y
    obtain ⟨χ, hχ⟩ := exists_comp_eq_smul_of_smul_id_eq_zero Tr hTr c (hc₃ c hc')
      (e₁.hom ≫ S.map (ModuleCat.ofHom (LinearMap.toSpanSingleton A N x)))
    obtain ⟨b, hb⟩ := hgen' χ
    refine ⟨b, ?_⟩
    have key : S.map (b • g₀) = S.map (c • ModuleCat.ofHom (LinearMap.toSpanSingleton A N x)) := by
      calc S.map (b • g₀) = e₁.inv ≫ Tr.mor₁ ≫ (b • φ) := hmap b
        _ = e₁.inv ≫ Tr.mor₁ ≫ χ := by rw [hb]
        _ = e₁.inv ≫ (c • (e₁.hom ≫ S.map
              (ModuleCat.ofHom (LinearMap.toSpanSingleton A N x)))) := by rw [hχ]
        _ = S.map (c • ModuleCat.ofHom (LinearMap.toSpanSingleton A N x)) := by
            rw [Linear.comp_smul, Iso.inv_hom_id_assoc, Functor.map_smul]
    simpa only [ModuleCat.hom_smul, LinearMap.smul_apply, ModuleCat.hom_ofHom,
      LinearMap.toSpanSingleton_apply, one_smul] using
      (congrArg (fun h => h.hom (1 : A)) (S.map_injective key)).symm
  -- `t` has zero annihilator
  have hn₀ : ∀ b : A, b • t = 0 → b = 0 := by
    intro b hb
    have hbg : b • g₀ = 0 := by
      rw [eq_ofHom_toSpanSingleton g₀]
      refine ModuleCat.hom_ext (LinearMap.ext fun a => ?_)
      show b • (a • t) = 0
      rw [smul_comm, hb, smul_zero]
    have h1 : Tr.mor₁ ≫ (b • φ) = 0 := by
      have : e₁.inv ≫ Tr.mor₁ ≫ (b • φ) = 0 := by
        calc e₁.inv ≫ Tr.mor₁ ≫ (b • φ) = S.map (b • g₀) := (hmap b).symm
          _ = 0 := by rw [hbg, Functor.map_zero]
      simpa using e₁.hom ≫= this
    obtain ⟨g', hg'⟩ := Triangle.yoneda_exact₂ Tr hTr _ h1
    have h2 : (c₀ * b) • φ = 0 := by
      calc (c₀ * b) • φ = c₀ • (b • φ) := mul_smul _ _ _
        _ = c₀ • (Tr.mor₂ ≫ g') := by rw [hg']
        _ = Tr.mor₂ ≫ ((c₀ • 𝟙 Tr.obj₃) ≫ g') := by
            rw [Linear.smul_comp, Category.id_comp, Linear.comp_smul]
        _ = 0 := by rw [hc₃ c₀ hc₀M, zero_comp, comp_zero]
    exact (mul_eq_zero.1 (hfree' _ h2)).resolve_left hc₀'
  -- the ideal killing `M` is primary to the maximal ideal
  have hI : ∀ (p : Ideal A) (_ : p.IsPrime), p ≠ IsLocalRing.maximalIdeal A →
      ¬ Module.annihilator A M ≤ p := by
    intro p hp hpm hle
    obtain ⟨c, hcp, hc⟩ := hM p hp hpm
    exact hcp (hle (Module.mem_annihilator.2 hc))
  have hbij := bijective_smul_of_smul_le_span hdim hdepth t hn₀ (Module.annihilator A M) hI t ht
  -- so `A ⟶ K ⟶ N` is an isomorphism
  have hg₀iso : IsIso g₀ := by
    rw [eq_ofHom_toSpanSingleton g₀]
    exact (LinearEquiv.toModuleIso (LinearEquiv.ofBijective _ hbij)).isIso_hom
  have hcomp : IsIso (Tr.mor₁ ≫ φ) := by
    have : IsIso (e₁.inv ≫ Tr.mor₁ ≫ φ) := by
      rw [← hg₀]
      infer_instance
    exact IsIso.of_isIso_comp_left e₁.inv _
  refine ⟨?_, ⟨(asIso g₀).symm⟩⟩
  -- every map `κ ⟶ M` vanishes
  have hzero : ∀ h : ModuleCat.of A (IsLocalRing.ResidueField A) ⟶ M, h = 0 := by
    intro h
    have := eq_zero_of_isIso_mor₁_comp_of_forall_eq_zero Tr hTr φ hκ'
      ((singleFunctor (ModuleCat.{u} A) (n + 1)).map h ≫ e₃.inv)
    apply (singleFunctor (ModuleCat.{u} A) (n + 1)).map_injective
    rw [Functor.map_zero]
    simpa [Category.assoc] using this =≫ e₃.hom
  by_contra hns
  rw [not_subsingleton_iff_nontrivial] at hns
  obtain ⟨g, hg⟩ := exists_ne_zero_of_forall_prime_ne M hM
  exact hg (congrArg ModuleCat.Hom.hom (hzero (ModuleCat.ofHom g)))

end Criterion

end Stacks.PurityRamification

end
