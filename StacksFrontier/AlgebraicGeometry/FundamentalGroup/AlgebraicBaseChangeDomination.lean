module

public import Mathlib.FieldTheory.PurelyInseparable.Basic
public import Mathlib.RingTheory.Etale.Field
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.TorsionSheavesCurves.ScalarExtension
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.AlgebraicClosureBaseChange
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.FiniteEtaleDomination
public import StacksFrontier.AlgebraicGeometry.Limits.AdjoinFinsetSystem

/-!
# Base change along an algebraic field extension dominates finite étale covers

Let `k` be a field, `K/k` an algebraic extension and `X` a quasi-compact quasi-separated scheme
over `k`. Every finite étale cover of `X_K = X ×_k K` maps monomorphically into the base change of
a finite étale cover of `X`. Consequently, when `X_K` is connected, the homomorphism
`π₁(X_K) → π₁(X)` is injective: this is the injectivity assertion of Stacks Tag 0BTX
(for `K = k̄`).

## The argument

Write `K_s` for the separable closure of `k` in `K`.

* `X_K ⟶ X_{K_s}` is a universal homeomorphism, as `K/K_s` is purely inseparable, so it dominates
  finite étale covers (Stacks Tag 0BQN).
* `X_{K_s}` is the cofiltered limit of the `X_{k[s]}` over the finite subsets `s ⊆ K_s`, with
  affine transition morphisms (`AlgebraicGeometry.AdjoinFinset.isLimitBcCone`); each `k[s]` is a
  finite separable extension of `k`, so each `X_{k[s]} ⟶ X` is finite étale and dominates finite
  étale covers, and by Stacks Tag 0BTV so does `X_{K_s} ⟶ X`.
* Domination is stable under composition.

## Main results

* `AlgebraicGeometry.dominatesFiniteEtale_pullbackSnd_of_isSeparable` — the separable case.
* `AlgebraicGeometry.dominatesFiniteEtale_pullbackFst_of_isAlgebraic` — the algebraic case.
* `AlgebraicGeometry.injective_etaleFundamentalGroupMap_of_isAlgebraic` — injectivity of
  `π₁(X_K) → π₁(X)`.
-/

@[expose] public noncomputable section

open CategoryTheory Limits

universe u

namespace AlgebraicGeometry

variable (k : Type u) [Field k]

/-- The spectrum of the subalgebra generated by a finite subset of a separable algebraic
extension is finite étale over `Spec k`. -/
lemma finiteEtale_specMap_algebraMap_adjoin (K : Type u) [Field K] [Algebra k K]
    [Algebra.IsSeparable k K] (s : Finset K) :
    IsFinite (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (s : Set K))))) ∧
      Etale (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (s : Set K))))) := by
  set A := Algebra.adjoin k (s : Set K)
  have hfin : Module.Finite k A :=
    Algebra.finite_adjoin_of_finite_of_isIntegral s.finite_toSet
      (fun x _ ↦ Algebra.IsIntegral.isIntegral x)
  let : Field A := (Subalgebra.isField_of_algebraic A).toField
  have : Algebra.IsSeparable k A := Algebra.IsSeparable.of_algHom k K A.val
  have : Algebra.FormallyEtale k A := Algebra.FormallyEtale.of_isSeparable k A
  have : Algebra.FinitePresentation k A := Algebra.FinitePresentation.of_finiteType.mp inferInstance
  have : Algebra.Etale k A := ⟨‹_›, ‹_›⟩
  exact ⟨(IsFinite.SpecMap_iff _).mpr (RingHom.finite_algebraMap.mpr hfin),
    HasRingHomProperty.Spec_iff.mpr (RingHom.etale_algebraMap.mpr inferInstance)⟩

/-- **The separable case.** For a separable algebraic extension `K/k` and a quasi-compact
quasi-separated scheme `X` over `k`, the projection `Spec K ×_k X ⟶ X` dominates finite étale
covers. -/
theorem dominatesFiniteEtale_pullbackSnd_of_isSeparable (K : Type u) [Field K] [Algebra k K]
    [Algebra.IsSeparable k K] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [CompactSpace X]
    [QuasiSeparatedSpace X] :
    DominatesFiniteEtale (pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap k K))) f) := by
  have hstage : ∀ i : (Finset K)ᵒᵖ, IsAffineHom (pullback.snd
      (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (i.unop : Set K))))) f) :=
    fun i ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (IsPullback.of_hasPullback _ f) (isAffineHom_of_isAffine _)
  have : ∀ i : (Finset K)ᵒᵖ, CompactSpace ((AdjoinFinset.bcDiagram k K f).obj i) := by
    intro i
    have := hstage i
    show CompactSpace ↥(pullback
      (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (i.unop : Set K))))) f)
    exact QuasiCompact.compactSpace_of_compactSpace (pullback.snd
      (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (i.unop : Set K))))) f)
  have : ∀ i : (Finset K)ᵒᵖ, QuasiSeparatedSpace ((AdjoinFinset.bcDiagram k K f).obj i) := by
    intro i
    have := hstage i
    show QuasiSeparatedSpace ↥(pullback
      (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (i.unop : Set K))))) f)
    exact quasiSeparatedSpace_of_quasiSeparated (pullback.snd
      (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (i.unop : Set K))))) f)
  have : ∀ {i j : (Finset K)ᵒᵖ} (e : i ⟶ j), IsAffineHom ((AdjoinFinset.bcDiagram k K f).map e) :=
    AdjoinFinset.bcDiagram_isAffineHom k K f
  refine dominatesFiniteEtale_of_isLimit (AdjoinFinset.bcDiagram k K f) (AdjoinFinset.bcCone k K f)
    (AdjoinFinset.isLimitBcCone k K f) _
    (fun i ↦ pullback.snd (Spec.map (CommRingCat.ofHom
      (algebraMap k (Algebra.adjoin k (i.unop : Set K))))) f)
    (AdjoinFinset.bcProj_snd k K f) (fun i ↦ ?_)
  obtain ⟨h₁, h₂⟩ := finiteEtale_specMap_algebraMap_adjoin k K i.unop
  have : IsFinite (pullback.snd (Spec.map (CommRingCat.ofHom
      (algebraMap k (Algebra.adjoin k (i.unop : Set K))))) f) :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (IsPullback.of_hasPullback _ f) h₁
  have : Etale (pullback.snd (Spec.map (CommRingCat.ofHom
      (algebraMap k (Algebra.adjoin k (i.unop : Set K))))) f) :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (IsPullback.of_hasPullback _ f) h₂
  exact dominatesFiniteEtale_of_finiteEtale (pullback.snd (Spec.map (CommRingCat.ofHom
      (algebraMap k (Algebra.adjoin k (i.unop : Set K))))) f)

/-- **The algebraic case.** For an algebraic extension `K/k` and a quasi-compact
quasi-separated scheme `X` over `k`, the projection `X ×_k K ⟶ X` dominates finite étale
covers. -/
theorem dominatesFiniteEtale_pullbackFst_of_isAlgebraic (K : Type u) [Field K] [Algebra k K]
    [Algebra.IsAlgebraic k K] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [CompactSpace X]
    [QuasiSeparatedSpace X] :
    DominatesFiniteEtale (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) := by
  let Ks := separableClosure k K
  let sKs := Spec.map (CommRingCat.ofHom (algebraMap k Ks))
  let sK := Spec.map (CommRingCat.ofHom (algebraMap k K))
  let ι := Spec.map (CommRingCat.ofHom (algebraMap Ks K))
  have hι : ι ≫ sKs = sK := by
    simp only [ι, sKs, sK, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq]
  let h : pullback f sK ⟶ pullback sKs f :=
    pullback.lift (pullback.snd f sK ≫ ι) (pullback.fst f sK) (by
      rw [Category.assoc, hι, pullback.condition])
  have hcomp : h ≫ pullback.snd sKs f = pullback.fst f sK := pullback.lift_snd _ _ _
  have : UniversalHomeomorphism h := by
    have outer : IsPullback (h ≫ pullback.snd sKs f) (pullback.snd f sK) f (ι ≫ sKs) := by
      rw [hcomp, hι]
      exact IsPullback.of_hasPullback f sK
    exact ⟨MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (IsPullback.of_right outer (pullback.lift_fst _ _ _)
        (IsPullback.of_hasPullback sKs f).flip).flip
      (Stacks.EtaleCohomology.specMap_universalHomeomorphism_of_isPurelyInseparable
        Ks K).universally_isHomeomorph⟩
  exact ((dominatesFiniteEtale_of_universalHomeomorphism h).comp
    (dominatesFiniteEtale_pullbackSnd_of_isSeparable k Ks f)).of_eq hcomp

/-- **Stacks Project, Tag 0BTX, injectivity.** Let `K/k` be an algebraic field extension (for
instance an algebraic closure) and `X` a quasi-compact quasi-separated scheme over `k` whose base
change `X_K` is connected. Then `π₁(X_K, x) → π₁(X, x)` is injective. -/
theorem injective_etaleFundamentalGroupMap_of_isAlgebraic (K : Type u) [Field K] [Algebra k K]
    [Algebra.IsAlgebraic k K] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [CompactSpace X]
    [QuasiSeparatedSpace X]
    [ConnectedSpace ↥(pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))))]
    (x : GeometricPoint (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))))) :
    letI : ConnectedSpace ↥X := connectedSpace_of_connectedSpace_pullback_specMap_algebraMap k K f
    Function.Injective (etaleFundamentalGroupMap
      (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) x) :=
  let : ConnectedSpace ↥X := connectedSpace_of_connectedSpace_pullback_specMap_algebraMap k K f
  injective_etaleFundamentalGroupMap_of_dominatesFiniteEtale _ x
    (dominatesFiniteEtale_pullbackFst_of_isAlgebraic k K f)

end AlgebraicGeometry
