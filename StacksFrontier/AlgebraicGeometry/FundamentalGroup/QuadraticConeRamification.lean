module

public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.LinearAlgebra.Dimension.Constructions
public import Mathlib.RingTheory.Ideal.Height
public import Mathlib.RingTheory.KrullDimension.Field
public import Mathlib.RingTheory.KrullDimension.Polynomial
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Unramified.Locus
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.KrullDimension.IntegralExtension

/-!
# Ramification of the quotient of affine space by `±1`

Let `k` be a field in which `2 ≠ 0` and let `Y = 𝐀ⁿ_k = Spec(k[t₁, …, tₙ])`. The group `{±1}` acts
on `Y` by multiplying all the coordinates, and the invariants of that action form the subring
`k[tᵢtⱼ : i, j]` of `k[t₁, …, tₙ]`, whose spectrum is the quotient `X`. The resulting morphism
`Y → X` is finite of degree two, it is unramified at every point of `Y` which does not lie over
the vertex `𝔪 = (tᵢtⱼ)`, and it is ramified over `𝔪`, a point of codimension `n` in `X`. For
`n ≥ 2` this produces ramification in codimension `> 1`, which cannot happen for a regular base.

## Main definitions

* `MvPolynomial.negVars` — the action of `-1 ∈ {±1}` on `k[tᵢ]`, negating every variable.
* `MvPolynomial.evenSubalgebra` — the subring `k[tᵢtⱼ : i, j]` of `k[tᵢ]`.
* `MvPolynomial.vertexIdeal` — the ideal `𝔪 = (tᵢtⱼ)` of `k[tᵢtⱼ]`.

## Main results

* `MvPolynomial.mem_evenSubalgebra_iff` and
  `MvPolynomial.mem_evenSubalgebra_iff_negVars_eq` — the subring `k[tᵢtⱼ]` consists of the
  polynomials all of whose monomials have even degree, and is the ring of invariants of the
  `±1`-action.
* `MvPolynomial.finite_evenSubalgebra`, `MvPolynomial.rank_evenSubalgebra_eq_two` and
  `MvPolynomial.finrank_evenSubalgebra_eq_two` — the polynomial ring is a finite module of rank
  two over the invariants, so `Y → X` is finite of degree two.
* `MvPolynomial.isUnramifiedAt_of_under_ne_vertexIdeal` — `Y → X` is unramified at every point of
  `Y` not lying over `𝔪`.
* `MvPolynomial.not_isUnramifiedAt_idealOfVars` — `Y → X` is ramified at the vertex of `Y`, which
  lies over `𝔪`.
* `MvPolynomial.height_vertexIdeal` and `MvPolynomial.one_lt_height_vertexIdeal` — `𝔪` has height
  `n` in `k[tᵢtⱼ]` for `n` variables, hence height `> 1` as soon as `n ≥ 2`.

## References

* [Stacks Project, Tag 0BTE](https://stacks.math.columbia.edu/tag/0BTE)
-/

@[expose] public section

namespace MvPolynomial

universe u v

variable {k : Type u} [Field k] {σ : Type v}

/-! ### The `±1`-action and its invariants -/

/-- The action of `-1` in the group `{±1}` on `k[tᵢ]`, negating every variable. -/
noncomputable def negVars (k : Type u) [Field k] (σ : Type v) :
    MvPolynomial σ k →ₐ[k] MvPolynomial σ k :=
  aeval fun i ↦ -X i

/-- The `±1`-action sends a variable to its negative. -/
@[simp]
theorem negVars_X (i : σ) : negVars k σ (X i) = -X i := aeval_X _ i

/-- The `±1`-action multiplies a monomial by the sign of its total degree. -/
theorem negVars_monomial (m : σ →₀ ℕ) (c : k) :
    negVars k σ (monomial m c) = monomial m ((-1) ^ Finsupp.degree m * c) := by
  have h1 : ∀ a : σ, ((-X a : MvPolynomial σ k)) ^ (m a) = (-1) ^ (m a) * X a ^ (m a) :=
    fun a ↦ neg_pow _ _
  rw [negVars, aeval_monomial, Finsupp.degree_apply, Finsupp.prod,
    Finset.prod_congr rfl (fun i _ ↦ h1 i), Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum,
    algebraMap_eq, monomial_eq, Finsupp.prod, C_mul, map_pow, map_neg, map_one]
  ring

/-- The `±1`-action multiplies the coefficient of a monomial by the sign of its total degree. -/
theorem coeff_negVars (f : MvPolynomial σ k) (m : σ →₀ ℕ) :
    (negVars k σ f).coeff m = (-1) ^ Finsupp.degree m * f.coeff m := by
  classical
  induction f using MvPolynomial.induction_on' with
  | monomial m' c =>
      rw [negVars_monomial]
      by_cases h : m' = m
      · subst h; simp [coeff_monomial]
      · simp [coeff_monomial, h]
  | add p q hp hq => simp [hp, hq, mul_add]

/-- The `±1`-action is an involution. -/
theorem negVars_negVars (f : MvPolynomial σ k) : negVars k σ (negVars k σ f) = f :=
  DFunLike.congr_fun (MvPolynomial.algHom_ext (f := (negVars k σ).comp (negVars k σ))
    (g := AlgHom.id k _) (by simp)) f

/-- The subring `k[tᵢtⱼ : i, j]` of `k[tᵢ]` generated by the products of pairs of variables. -/
noncomputable def evenSubalgebra (k : Type u) [Field k] (σ : Type v) :
    Subalgebra k (MvPolynomial σ k) :=
  Algebra.adjoin k (Set.range fun p : σ × σ ↦ (X p.1 * X p.2 : MvPolynomial σ k))

/-- Each product `tᵢtⱼ` of two variables lies in `k[tᵢtⱼ]`. -/
theorem X_mul_X_mem_evenSubalgebra (i j : σ) : X i * X j ∈ evenSubalgebra k σ :=
  Algebra.subset_adjoin ⟨(i, j), rfl⟩

private theorem X_mul_X_eq (i j : σ) :
    (X i * X j : MvPolynomial σ k) = monomial (Finsupp.single i 1 + Finsupp.single j 1) 1 := by
  rw [monomial_single_add, ← X_pow_eq_monomial, pow_one, pow_one]

/-- Multiplying a monomial by `tᵢtⱼ` adds `eᵢ + eⱼ` to its exponent. -/
private theorem X_mul_X_mul_monomial (i j : σ) (m : σ →₀ ℕ) (c : k) :
    (X i * X j * monomial m c : MvPolynomial σ k) =
      monomial (Finsupp.single i 1 + (Finsupp.single j 1 + m)) c := by
  rw [X_mul_X_eq, monomial_mul_monomial, one_mul, add_assoc]

/-- Polynomials all of whose monomials have even total degree. -/
private def evenSupport (k : Type u) [Field k] (σ : Type v) : Subalgebra k (MvPolynomial σ k) where
  carrier := {f | ∀ m ∈ f.support, Even (Finsupp.degree m)}
  mul_mem' {f g} hf hg := by
    classical
    intro m hm
    obtain ⟨a, ha, b, hb, rfl⟩ := Finset.mem_add.mp (support_mul f g hm)
    simpa [map_add] using (hf a ha).add (hg b hb)
  add_mem' {f g} hf hg := by
    classical
    intro m hm
    rcases Finset.mem_union.mp (support_add hm) with h | h
    · exact hf m h
    · exact hg m h
  algebraMap_mem' c := by
    intro m hm
    have hm0 : m = 0 := by
      classical
      by_contra hne
      rw [algebraMap_eq, mem_support_iff, coeff_C] at hm
      simp [Ne.symm hne] at hm
    simp [hm0]

private theorem exists_add_single {m : σ →₀ ℕ} (h : m ≠ 0) :
    ∃ (i : σ) (m' : σ →₀ ℕ), m = Finsupp.single i 1 + m' := by
  obtain ⟨i, hi⟩ : ∃ i, m i ≠ 0 := by
    by_contra hc
    exact h (Finsupp.ext (by simpa using not_exists.mp hc))
  exact ⟨i, m - Finsupp.single i 1,
    (add_tsub_cancel_of_le (Finsupp.single_le_iff.mpr (Nat.one_le_iff_ne_zero.mpr hi))).symm⟩

/-- A nonzero monomial exponent of even degree is the sum of two single variables and an exponent
of even degree. -/
private theorem exists_even_factor {m : σ →₀ ℕ} (hm : Even (Finsupp.degree m)) (h0 : m ≠ 0) :
    ∃ (i j : σ) (m' : σ →₀ ℕ), Even (Finsupp.degree m') ∧
      m = Finsupp.single i 1 + (Finsupp.single j 1 + m') := by
  obtain ⟨i, m₁, hm₁⟩ := exists_add_single h0
  have hd₁ : Finsupp.degree m₁ + 1 = Finsupp.degree m := by rw [hm₁]; simp [map_add, add_comm]
  have hm₁0 : m₁ ≠ 0 := by
    rintro rfl
    rw [Nat.even_iff] at hm
    simp only [map_zero, zero_add] at hd₁
    omega
  obtain ⟨j, m₂, hm₂⟩ := exists_add_single hm₁0
  have hd₂ : Finsupp.degree m₂ + 2 = Finsupp.degree m := by
    rw [← hd₁, hm₂]; simp [map_add]; ring
  refine ⟨i, j, m₂, ?_, by rw [hm₁, hm₂]⟩
  rw [Nat.even_iff] at hm ⊢
  omega

private theorem monomial_mem_evenSubalgebra_aux :
    ∀ (d : ℕ) (m : σ →₀ ℕ), Finsupp.degree m = d → Even d → ∀ c : k,
      monomial m c ∈ evenSubalgebra k σ := by
  intro d
  induction d using Nat.strong_induction_on with
  | _ d ih =>
    intro m hmd hd c
    rcases eq_or_ne m 0 with rfl | hm0
    · simpa [algebraMap_eq] using (evenSubalgebra k σ).algebraMap_mem c
    · obtain ⟨i, j, m', he', hm'⟩ := exists_even_factor (hmd ▸ hd) hm0
      have hdm : Finsupp.degree m' + 2 = d := by
        rw [← hmd, hm']; simp [map_add]; ring
      have hmul : monomial m c = (X i * X j) * monomial m' c := by
        rw [X_mul_X_mul_monomial, ← hm']
      rw [hmul]
      exact mul_mem (X_mul_X_mem_evenSubalgebra i j)
        (ih (Finsupp.degree m') (by omega) m' rfl he' c)

/-- A monomial of even degree lies in `k[tᵢtⱼ]`. -/
theorem monomial_mem_evenSubalgebra {m : σ →₀ ℕ} (hm : Even (Finsupp.degree m)) (c : k) :
    monomial m c ∈ evenSubalgebra k σ :=
  monomial_mem_evenSubalgebra_aux _ m rfl hm c

/-- The subring `k[tᵢtⱼ]` consists of the polynomials all of whose monomials have even degree. -/
@[stacks 0BTE "the invariant subring k[tᵢtⱼ]"]
theorem mem_evenSubalgebra_iff {f : MvPolynomial σ k} :
    f ∈ evenSubalgebra k σ ↔ ∀ m ∈ f.support, Even (Finsupp.degree m) := by
  classical
  refine ⟨fun hf ↦ ?_, fun hf ↦ ?_⟩
  · refine Algebra.adjoin_le (S := evenSupport k σ) ?_ hf
    rintro _ ⟨⟨i, j⟩, rfl⟩ m hm
    simp only at hm
    rw [X_mul_X_eq] at hm
    have hm' : m = Finsupp.single i 1 + Finsupp.single j 1 := by
      simpa [support_monomial] using hm
    simp [hm', map_add]
  · rw [f.as_sum]
    exact sum_mem fun m hm ↦ monomial_mem_evenSubalgebra (hf m hm) _

/-- The subring `k[tᵢtⱼ]` is the ring of invariants of the `±1`-action, provided `2 ≠ 0`. -/
@[stacks 0BTE "the invariant subring k[tᵢtⱼ]"]
theorem mem_evenSubalgebra_iff_negVars_eq (h2 : (2 : k) ≠ 0) {f : MvPolynomial σ k} :
    f ∈ evenSubalgebra k σ ↔ negVars k σ f = f := by
  rw [mem_evenSubalgebra_iff]
  refine ⟨fun hf ↦ MvPolynomial.ext _ _ fun m ↦ ?_, fun hf m hm ↦ ?_⟩
  · rw [coeff_negVars]
    by_cases hm : m ∈ f.support
    · rw [(hf m hm).neg_one_pow, one_mul]
    · rw [notMem_support_iff.mp hm, mul_zero]
  · by_contra he
    have h := coeff_negVars f m
    rw [hf, (Nat.not_even_iff_odd.mp he).neg_one_pow] at h
    have h2c : (2 : k) * f.coeff m = 0 := by linear_combination h
    exact mem_support_iff.mp hm ((mul_eq_zero.mp h2c).resolve_left h2)

/-! ### The morphism `Y → X` is finite of degree two -/

variable (k σ) in
private noncomputable def evenPart (f : MvPolynomial σ k) : MvPolynomial σ k :=
  C (2⁻¹ : k) * (f + negVars k σ f)

variable (k σ) in
private noncomputable def oddPart (f : MvPolynomial σ k) : MvPolynomial σ k :=
  C (2⁻¹ : k) * (f - negVars k σ f)

private theorem C_inv_two_mul_two (h2 : (2 : k) ≠ 0) :
    (C (2⁻¹ : k) : MvPolynomial σ k) * 2 = 1 := by
  rw [show (2 : MvPolynomial σ k) = C (2 : k) from (map_ofNat C 2).symm, ← C_mul,
    inv_mul_cancel₀ h2, C_1]

private theorem evenPart_add_oddPart (h2 : (2 : k) ≠ 0) (f : MvPolynomial σ k) :
    evenPart k σ f + oddPart k σ f = f := by
  rw [evenPart, oddPart]
  linear_combination (f : MvPolynomial σ k) * C_inv_two_mul_two h2

private theorem negVars_evenPart (f : MvPolynomial σ k) :
    negVars k σ (evenPart k σ f) = evenPart k σ f := by
  rw [evenPart, map_mul, map_add, negVars_negVars]
  simp [negVars, add_comm]

private theorem negVars_oddPart (f : MvPolynomial σ k) :
    negVars k σ (oddPart k σ f) = -oddPart k σ f := by
  rw [oddPart, map_mul, map_sub, negVars_negVars]
  simp [negVars]
  ring

private theorem evenPart_mem (h2 : (2 : k) ≠ 0) (f : MvPolynomial σ k) :
    evenPart k σ f ∈ evenSubalgebra k σ :=
  (mem_evenSubalgebra_iff_negVars_eq h2).mpr (negVars_evenPart f)

private theorem X_mul_oddPart_mem (h2 : (2 : k) ≠ 0) (i : σ) (f : MvPolynomial σ k) :
    X i * oddPart k σ f ∈ evenSubalgebra k σ := by
  refine (mem_evenSubalgebra_iff_negVars_eq h2).mpr ?_
  rw [map_mul, negVars_X, negVars_oddPart]
  ring

/-- The polynomial ring is generated over `k[tᵢtⱼ]` by `1` and the variables. -/
theorem span_insert_one_range_X_eq_top :
    Submodule.span (evenSubalgebra k σ) (insert 1 (Set.range (X : σ → MvPolynomial σ k))) = ⊤ := by
  classical
  rw [eq_top_iff]
  intro f _
  rw [f.as_sum]
  refine Submodule.sum_mem _ fun m hm ↦ ?_
  rcases Nat.even_or_odd (Finsupp.degree m) with he | ho
  · have h : monomial m (f.coeff m) =
        (⟨monomial m (f.coeff m), monomial_mem_evenSubalgebra he _⟩ :
          evenSubalgebra k σ) • (1 : MvPolynomial σ k) := by
      rw [Algebra.smul_def]; exact (mul_one _).symm
    rw [h]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_insert _ _))
  · have hm0 : m ≠ 0 := by rintro rfl; simp at ho
    obtain ⟨i, m', hm'⟩ := exists_add_single hm0
    have he' : Even (Finsupp.degree m') := by
      have hd : Finsupp.degree m' + 1 = Finsupp.degree m := by rw [hm']; simp [map_add, add_comm]
      rw [Nat.odd_iff] at ho
      rw [Nat.even_iff]
      omega
    have h : monomial m (f.coeff m) =
        (⟨monomial m' (f.coeff m), monomial_mem_evenSubalgebra he' _⟩ :
          evenSubalgebra k σ) • X i := by
      rw [Algebra.smul_def]
      change monomial m (f.coeff m) = monomial m' (f.coeff m) * X i
      rw [show (X i : MvPolynomial σ k) = monomial (Finsupp.single i 1) 1 from
            by rw [← X_pow_eq_monomial, pow_one],
        monomial_mul_monomial, mul_one, hm', add_comm]
    rw [h]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩))

/-- The polynomial ring in finitely many variables is a finite module over `k[tᵢtⱼ]`: the morphism
`𝐀ⁿ_k → Spec(k[tᵢtⱼ])` is finite. -/
@[stacks 0BTE "the degree two morphism"]
theorem finite_evenSubalgebra [Finite σ] :
    Module.Finite (evenSubalgebra k σ) (MvPolynomial σ k) :=
  ⟨Submodule.fg_def.mpr ⟨insert 1 (Set.range (X : σ → MvPolynomial σ k)),
    (Set.finite_range _).insert 1, span_insert_one_range_X_eq_top⟩⟩

private noncomputable def evenOddEmbedding (h2 : (2 : k) ≠ 0) (i₀ : σ) :
    MvPolynomial σ k →ₗ[evenSubalgebra k σ] (evenSubalgebra k σ) × (evenSubalgebra k σ) where
  toFun f :=
    (⟨evenPart k σ f, evenPart_mem h2 f⟩, ⟨X i₀ * oddPart k σ f, X_mul_oddPart_mem h2 i₀ f⟩)
  map_add' f g := by
    refine Prod.ext (Subtype.ext ?_) (Subtype.ext ?_)
    · change evenPart k σ (f + g) = evenPart k σ f + evenPart k σ g
      simp only [evenPart, map_add]; ring
    · change X i₀ * oddPart k σ (f + g) = X i₀ * oddPart k σ f + X i₀ * oddPart k σ g
      simp only [oddPart, map_add]; ring
  map_smul' a f := by
    have ha : negVars k σ (a : MvPolynomial σ k) = a :=
      (mem_evenSubalgebra_iff_negVars_eq h2).mp a.2
    refine Prod.ext (Subtype.ext ?_) (Subtype.ext ?_)
    · change evenPart k σ ((a : MvPolynomial σ k) * f) = (a : MvPolynomial σ k) * evenPart k σ f
      simp only [evenPart, map_mul, ha]; ring
    · change X i₀ * oddPart k σ ((a : MvPolynomial σ k) * f)
        = (a : MvPolynomial σ k) * (X i₀ * oddPart k σ f)
      simp only [oddPart, map_mul, ha]; ring

private theorem evenOddEmbedding_injective (h2 : (2 : k) ≠ 0) (i₀ : σ) :
    Function.Injective (evenOddEmbedding h2 i₀) := by
  rw [injective_iff_map_eq_zero]
  intro f hf
  have h1 : evenPart k σ f = 0 := congrArg Subtype.val (Prod.ext_iff.mp hf).1
  have h2' : X i₀ * oddPart k σ f = 0 := congrArg Subtype.val (Prod.ext_iff.mp hf).2
  have ho : oddPart k σ f = 0 := by
    rcases mul_eq_zero.mp h2' with h | h
    · exact absurd h (X_ne_zero i₀)
    · exact h
  rw [← evenPart_add_oddPart h2 f, h1, ho, add_zero]

/-- The polynomial ring has rank two as a module over `k[tᵢtⱼ]`: the morphism
`𝐀ⁿ_k → Spec(k[tᵢtⱼ])` has degree two. -/
@[stacks 0BTE "the degree two morphism"]
theorem rank_evenSubalgebra_eq_two (h2 : (2 : k) ≠ 0) [Nonempty σ] :
    Module.rank (evenSubalgebra k σ) (MvPolynomial σ k) = 2 := by
  obtain ⟨i₀⟩ := (inferInstance : Nonempty σ)
  refine le_antisymm ?_ ?_
  · refine (LinearMap.rank_le_of_injective _ (evenOddEmbedding_injective h2 i₀)).trans ?_
    rw [rank_prod', CommSemiring.rank_self]
    norm_num
  · have hli : LinearIndependent (evenSubalgebra k σ) ![(1 : MvPolynomial σ k), X i₀] := by
      rw [LinearIndependent.pair_iff]
      intro s t hst
      have hs : negVars k σ (s : MvPolynomial σ k) = s :=
        (mem_evenSubalgebra_iff_negVars_eq h2).mp s.2
      have ht : negVars k σ (t : MvPolynomial σ k) = t :=
        (mem_evenSubalgebra_iff_negVars_eq h2).mp t.2
      simp only [Algebra.smul_def, Subalgebra.algebraMap_apply, mul_one] at hst
      have himg := congrArg (negVars k σ) hst
      simp only [map_add, map_mul, map_zero, hs, ht, negVars_X] at himg
      have h2R : (2 : MvPolynomial σ k) ≠ 0 := by
        rw [show (2 : MvPolynomial σ k) = C (2 : k) from (map_ofNat C 2).symm]
        simpa using h2
      have hs0 : (s : MvPolynomial σ k) = 0 := by
        have h : (2 : MvPolynomial σ k) * (s : MvPolynomial σ k) = 0 := by
          linear_combination hst + himg
        exact (mul_eq_zero.mp h).resolve_left h2R
      have ht0 : (t : MvPolynomial σ k) = 0 := by
        have h : (2 : MvPolynomial σ k) * ((t : MvPolynomial σ k) * X i₀) = 0 := by
          linear_combination hst - himg
        rcases mul_eq_zero.mp h with h | h
        · exact absurd h h2R
        · exact (mul_eq_zero.mp h).resolve_right (X_ne_zero i₀)
      exact ⟨Subtype.ext hs0, Subtype.ext ht0⟩
    simpa using hli.cardinal_lift_le_rank

/-- The polynomial ring in finitely many variables has rank two as a module over `k[tᵢtⱼ]`. -/
@[stacks 0BTE "the degree two morphism"]
theorem finrank_evenSubalgebra_eq_two (h2 : (2 : k) ≠ 0) [Nonempty σ] :
    Module.finrank (evenSubalgebra k σ) (MvPolynomial σ k) = 2 :=
  Module.finrank_eq_of_rank_eq (by rw [rank_evenSubalgebra_eq_two h2]; norm_num)

/-! ### The vertex of the quotient -/

/-- The ideal `𝔪 = (tᵢtⱼ)` of the invariant subring `k[tᵢtⱼ]`, the vertex of the quotient. -/
noncomputable def vertexIdeal (k : Type u) [Field k] (σ : Type v) :
    Ideal (evenSubalgebra k σ) :=
  Ideal.span (Set.range fun p : σ × σ ↦
    (⟨X p.1 * X p.2, X_mul_X_mem_evenSubalgebra p.1 p.2⟩ : evenSubalgebra k σ))

private theorem idealOfVars_eq_ker :
    idealOfVars σ k = RingHom.ker (constantCoeff : MvPolynomial σ k →+* k) := by
  ext f
  rw [RingHom.mem_ker, ← pow_one (idealOfVars σ k), mem_pow_idealOfVars_iff']
  refine ⟨fun h ↦ ?_, fun h x hx ↦ ?_⟩
  · rw [constantCoeff_eq]
    exact h 0 (by simp)
  · have hx0 : x = 0 := (Finsupp.degree_eq_zero_iff x).mp (by omega)
    rw [hx0]
    exact h

/-- The ideal of all the variables is maximal, with residue field `k`. -/
instance isMaximal_idealOfVars : (idealOfVars σ k).IsMaximal := by
  rw [idealOfVars_eq_ker]
  exact RingHom.ker_isMaximal_of_surjective _ fun c ↦ ⟨C c, by simp⟩

private theorem mem_vertexIdeal_of_coe_eq_monomial {a : evenSubalgebra k σ} {m : σ →₀ ℕ} {c : k}
    (h : (a : MvPolynomial σ k) = monomial m c) (h0 : m ≠ 0) : a ∈ vertexIdeal k σ := by
  classical
  rcases eq_or_ne c 0 with rfl | hc
  · have : a = 0 := Subtype.ext (by simpa using h)
    rw [this]
    exact Ideal.zero_mem _
  · have hmem : m ∈ (a : MvPolynomial σ k).support := by
      rw [mem_support_iff, h, coeff_monomial]
      simpa using hc
    have heven : Even (Finsupp.degree m) := mem_evenSubalgebra_iff.mp a.2 m hmem
    obtain ⟨i, j, m', he', hm'⟩ := exists_even_factor heven h0
    have hfac : a = (⟨X i * X j, X_mul_X_mem_evenSubalgebra i j⟩ : evenSubalgebra k σ) *
        ⟨monomial m' c, monomial_mem_evenSubalgebra he' c⟩ := by
      refine Subtype.ext ?_
      change (a : MvPolynomial σ k) = (X i * X j) * monomial m' c
      rw [h, X_mul_X_mul_monomial, ← hm']
    rw [hfac]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨(i, j), rfl⟩)

/-- The ideal `𝔪 = (tᵢtⱼ)` is the contraction to `k[tᵢtⱼ]` of the ideal `(t₁, …, tₙ)`. -/
theorem vertexIdeal_eq_under :
    vertexIdeal k σ = (idealOfVars σ k).under (evenSubalgebra k σ) := by
  classical
  refine le_antisymm ?_ fun a ha ↦ ?_
  · rw [vertexIdeal, Ideal.span_le]
    rintro _ ⟨⟨i, j⟩, rfl⟩
    exact Ideal.mem_comap.mpr (Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩))
  · have hc0 : (a : MvPolynomial σ k).coeff 0 = 0 := by
      rw [← constantCoeff_eq]
      have : (a : MvPolynomial σ k) ∈ idealOfVars σ k := ha
      rw [idealOfVars_eq_ker, RingHom.mem_ker] at this
      exact this
    have heven := mem_evenSubalgebra_iff.mp a.2
    have hsum : a = ∑ m ∈ (a : MvPolynomial σ k).support.attach,
        (⟨monomial m.1 ((a : MvPolynomial σ k).coeff m.1),
          monomial_mem_evenSubalgebra (heven m.1 m.2) _⟩ : evenSubalgebra k σ) := by
      refine Subtype.ext ?_
      push_cast
      rw [Finset.sum_attach _ fun m ↦ monomial m ((a : MvPolynomial σ k).coeff m)]
      exact ((a : MvPolynomial σ k).as_sum)
    rw [hsum]
    refine Ideal.sum_mem _ fun m _ ↦ mem_vertexIdeal_of_coe_eq_monomial rfl fun h0 ↦ ?_
    exact mem_support_iff.mp m.2 (by rw [h0]; exact hc0)

/-- The vertex `𝔪 = (tᵢtⱼ)` is a prime ideal. -/
instance isPrime_vertexIdeal : (vertexIdeal k σ).IsPrime := by
  rw [vertexIdeal_eq_under]
  exact Ideal.IsPrime.comap _

/-- The vertex `𝔪 = (tᵢtⱼ)` is a maximal ideal, with residue field `k`. -/
instance isMaximal_vertexIdeal : (vertexIdeal k σ).IsMaximal := by
  have hker : vertexIdeal k σ = RingHom.ker
      ((constantCoeff : MvPolynomial σ k →+* k).comp
        (evenSubalgebra k σ).val.toRingHom) := by
    rw [vertexIdeal_eq_under]
    ext a
    simp [Ideal.mem_comap, idealOfVars_eq_ker, RingHom.mem_ker]
  rw [hker]
  exact RingHom.ker_isMaximal_of_surjective _ fun c ↦
    ⟨⟨C c, (evenSubalgebra k σ).algebraMap_mem c⟩, by simp⟩

/-! ### Ramification away from the vertex -/

private theorem adjoin_range_X_eq_top :
    Algebra.adjoin (evenSubalgebra k σ) (Set.range (X : σ → MvPolynomial σ k)) = ⊤ := by
  rw [eq_top_iff]
  intro f hftop
  clear hftop
  have hf : f ∈ Algebra.adjoin k (Set.range (X : σ → MvPolynomial σ k)) := by
    rw [adjoin_range_X]; trivial
  induction hf using Algebra.adjoin_induction with
  | mem x hx => exact Algebra.subset_adjoin hx
  | algebraMap c =>
      rw [IsScalarTower.algebraMap_apply k (evenSubalgebra k σ) (MvPolynomial σ k)]
      exact Subalgebra.algebraMap_mem _ _
  | add x y _ _ hx hy => exact add_mem hx hy
  | mul x y _ _ hx hy => exact mul_mem hx hy

private theorem sq_X_smul_D_X_eq_zero (h2 : (2 : k) ≠ 0) (i j : σ) :
    (X i ^ 2 : MvPolynomial σ k) •
      KaehlerDifferential.D (evenSubalgebra k σ) (MvPolynomial σ k) (X j) = 0 := by
  set D := KaehlerDifferential.D (evenSubalgebra k σ) (MvPolynomial σ k) with hD
  have hXX : ∀ a b : σ, D (X a * X b) = 0 := by
    intro a b
    have hcoe : (X a * X b : MvPolynomial σ k)
        = algebraMap (evenSubalgebra k σ) (MvPolynomial σ k)
            ⟨X a * X b, X_mul_X_mem_evenSubalgebra a b⟩ := rfl
    rw [hcoe, Derivation.map_algebraMap]
  have hleib : ∀ a b : σ,
      (X a : MvPolynomial σ k) • D (X b) + (X b : MvPolynomial σ k) • D (X a) = 0 := by
    intro a b
    rw [← Derivation.leibniz]
    exact hXX a b
  have hself : ∀ a : σ, (X a : MvPolynomial σ k) • D (X a) = 0 := by
    intro a
    have h2' : (2 : MvPolynomial σ k) • ((X a : MvPolynomial σ k) • D (X a)) = 0 := by
      rw [two_smul]; exact hleib a a
    have hkey : (C (2⁻¹ : k) : MvPolynomial σ k) •
        ((2 : MvPolynomial σ k) • ((X a : MvPolynomial σ k) • D (X a)))
          = (X a : MvPolynomial σ k) • D (X a) := by
      rw [smul_smul, C_inv_two_mul_two h2, one_smul]
    rw [← hkey, h2', smul_zero]
  calc (X i ^ 2 : MvPolynomial σ k) • D (X j)
      = (X i : MvPolynomial σ k) • ((X i : MvPolynomial σ k) • D (X j)) := by rw [smul_smul, sq]
    _ = (X i : MvPolynomial σ k) • (-((X j : MvPolynomial σ k) • D (X i))) := by
        rw [eq_neg_of_add_eq_zero_left (hleib i j)]
    _ = -((X j : MvPolynomial σ k) • ((X i : MvPolynomial σ k) • D (X i))) := by
        rw [smul_neg, smul_comm]
    _ = 0 := by rw [hself i, smul_zero, neg_zero]

private theorem sq_X_smul_D_eq_zero (h2 : (2 : k) ≠ 0) (i : σ) (f : MvPolynomial σ k) :
    (X i ^ 2 : MvPolynomial σ k) •
      KaehlerDifferential.D (evenSubalgebra k σ) (MvPolynomial σ k) f = 0 := by
  let T : Subalgebra (evenSubalgebra k σ) (MvPolynomial σ k) :=
    { carrier := {g | (X i ^ 2 : MvPolynomial σ k) •
        KaehlerDifferential.D (evenSubalgebra k σ) (MvPolynomial σ k) g = 0}
      mul_mem' := fun {a b} ha hb ↦ by
        simp only [Set.mem_ofPred_eq] at ha hb ⊢
        rw [Derivation.leibniz, smul_add, smul_comm _ a, smul_comm _ b, ha, hb, smul_zero,
          smul_zero, add_zero]
      add_mem' := fun {a b} ha hb ↦ by
        simp only [Set.mem_ofPred_eq] at ha hb ⊢
        rw [map_add, smul_add, ha, hb, add_zero]
      algebraMap_mem' := fun c ↦ by
        simp only [Set.mem_ofPred_eq]
        rw [Derivation.map_algebraMap, smul_zero] }
  have hle : Algebra.adjoin (evenSubalgebra k σ) (Set.range (X : σ → MvPolynomial σ k)) ≤ T :=
    Algebra.adjoin_le (by rintro _ ⟨j, rfl⟩; exact sq_X_smul_D_X_eq_zero h2 i j)
  exact hle (by rw [adjoin_range_X_eq_top]; trivial)

/-- Every relative differential of `k[tᵢ]` over `k[tᵢtⱼ]` is killed by every `tᵢ²`. -/
theorem sq_X_smul_eq_zero (h2 : (2 : k) ≠ 0) (i : σ)
    (x : KaehlerDifferential (evenSubalgebra k σ) (MvPolynomial σ k)) :
    (X i ^ 2 : MvPolynomial σ k) • x = 0 := by
  have hx : x ∈ (⊤ : Submodule (MvPolynomial σ k)
      (KaehlerDifferential (evenSubalgebra k σ) (MvPolynomial σ k))) := Submodule.mem_top
  rw [← KaehlerDifferential.span_range_derivation] at hx
  induction hx using Submodule.span_induction with
  | mem y hy => obtain ⟨f, rfl⟩ := hy; exact sq_X_smul_D_eq_zero h2 i f
  | zero => rw [smul_zero]
  | add y z _ _ hy hz => rw [smul_add, hy, hz, add_zero]
  | smul a y _ hy => rw [smul_comm, hy, smul_zero]

/-- Unramifiedness at `q` means every relative differential is killed by some `r ∉ q`. -/
private theorem isUnramifiedAt_iff_forall_exists_smul_eq_zero (q : Ideal (MvPolynomial σ k))
    [q.IsPrime] : Algebra.IsUnramifiedAt (evenSubalgebra k σ) q ↔
      ∀ x : KaehlerDifferential (evenSubalgebra k σ) (MvPolynomial σ k),
        ∃ r : MvPolynomial σ k, r ∉ q ∧ r • x = 0 := by
  change (⟨q, ‹q.IsPrime›⟩ : PrimeSpectrum (MvPolynomial σ k)) ∈
    Algebra.unramifiedLocus (evenSubalgebra k σ) (MvPolynomial σ k) ↔ _
  rw [Algebra.unramifiedLocus_eq_compl_support, Set.mem_compl_iff, Module.notMem_support_iff']

/-- The morphism `𝐀ⁿ_k → Spec(k[tᵢtⱼ])` is unramified at every prime of `k[tᵢ]` missing one of
the variables. -/
theorem isUnramifiedAt_of_exists_X_notMem (h2 : (2 : k) ≠ 0) (q : Ideal (MvPolynomial σ k))
    [q.IsPrime] (hq : ∃ i, X i ∉ q) : Algebra.IsUnramifiedAt (evenSubalgebra k σ) q := by
  obtain ⟨i, hi⟩ := hq
  rw [isUnramifiedAt_iff_forall_exists_smul_eq_zero]
  exact fun m ↦
    ⟨X i ^ 2, by simpa [Ideal.IsPrime.pow_mem_iff_mem] using hi, sq_X_smul_eq_zero h2 i m⟩

/-- A prime of `k[tᵢ]` lies over the vertex `𝔪 = (tᵢtⱼ)` exactly when it contains every
variable. -/
theorem under_eq_vertexIdeal_iff (q : Ideal (MvPolynomial σ k)) [q.IsPrime] :
    q.under (evenSubalgebra k σ) = vertexIdeal k σ ↔ ∀ i, X i ∈ q := by
  refine ⟨fun h i ↦ ?_, fun h ↦ ?_⟩
  · have hX : (⟨X i * X i, X_mul_X_mem_evenSubalgebra i i⟩ : evenSubalgebra k σ)
        ∈ vertexIdeal k σ := Ideal.subset_span ⟨(i, i), rfl⟩
    rw [← h] at hX
    have : X i * X i ∈ q := hX
    exact (‹q.IsPrime›.mul_mem_iff_mem_or_mem.mp this).elim id id
  · have hp : (q.under (evenSubalgebra k σ)).IsPrime := Ideal.IsPrime.comap _
    refine (isMaximal_vertexIdeal.eq_of_le hp.ne_top ?_).symm
    · rw [vertexIdeal_eq_under]
      exact Ideal.comap_mono (by rw [idealOfVars, Ideal.span_le]; rintro _ ⟨i, rfl⟩; exact h i)

/-- The morphism `𝐀ⁿ_k → Spec(k[tᵢtⱼ])` is unramified at every point of `𝐀ⁿ_k` which does not
lie over the vertex `𝔪 = (tᵢtⱼ)`. -/
@[stacks 0BTE "unramified away from the vertex"]
theorem isUnramifiedAt_of_under_ne_vertexIdeal (h2 : (2 : k) ≠ 0) (q : Ideal (MvPolynomial σ k))
    [q.IsPrime] (hq : q.under (evenSubalgebra k σ) ≠ vertexIdeal k σ) :
    Algebra.IsUnramifiedAt (evenSubalgebra k σ) q :=
  isUnramifiedAt_of_exists_X_notMem h2 q
    (not_forall.mp fun h ↦ hq ((under_eq_vertexIdeal_iff q).mpr h))

/-! ### Ramification at the vertex -/

private theorem pderiv_mem_idealOfVars (i : σ) {a : MvPolynomial σ k}
    (ha : a ∈ evenSubalgebra k σ) : pderiv i a ∈ idealOfVars σ k := by
  let T : Subalgebra k (MvPolynomial σ k) :=
    { carrier := {a | ∀ j : σ, pderiv j a ∈ idealOfVars σ k}
      mul_mem' := fun {a b} ha hb j ↦ by
        rw [pderiv_mul]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (ha j)) (Ideal.mul_mem_left _ _ (hb j))
      add_mem' := fun {a b} ha hb j ↦ by
        rw [map_add]
        exact Ideal.add_mem _ (ha j) (hb j)
      algebraMap_mem' := fun c j ↦ by
        rw [algebraMap_eq, pderiv_C]
        exact Ideal.zero_mem _ }
  have hle : evenSubalgebra k σ ≤ T := by
    rw [evenSubalgebra]
    refine Algebra.adjoin_le ?_
    rintro _ ⟨⟨a, b⟩, rfl⟩ j
    simp only
    rw [pderiv_mul]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨b, rfl⟩))
      (Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨a, rfl⟩))
  exact hle ha i

/-- Partial differentiation followed by reduction at the origin, as a derivation over the
invariant subring. -/
private noncomputable def vertexDerivation (i : σ) :
    Derivation (evenSubalgebra k σ) (MvPolynomial σ k)
      (MvPolynomial σ k ⧸ idealOfVars σ k) :=
  let D : Derivation k (MvPolynomial σ k) (MvPolynomial σ k ⧸ idealOfVars σ k) :=
    (idealOfVars σ k).mkQ.compDer (pderiv i)
  { toFun := D
    map_add' := D.map_add
    map_smul' := fun c f ↦ by
      have hv : D (algebraMap (evenSubalgebra k σ) (MvPolynomial σ k) c) = 0 := by
        change (idealOfVars σ k).mkQ
          (pderiv i (algebraMap (evenSubalgebra k σ) (MvPolynomial σ k) c)) = 0
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        exact pderiv_mem_idealOfVars i c.2
      rw [Algebra.smul_def, D.leibniz, hv, smul_zero, add_zero, algebraMap_smul,
        RingHom.id_apply]
    map_one_eq_zero' := D.map_one_eq_zero
    leibniz' := D.leibniz }

private theorem vertexDerivation_X (i : σ) :
    vertexDerivation i (X i : MvPolynomial σ k) = (idealOfVars σ k).mkQ 1 := by
  change (idealOfVars σ k).mkQ (pderiv i (X i : MvPolynomial σ k)) = _
  rw [pderiv_X_self]

/-- The morphism `𝐀ⁿ_k → Spec(k[tᵢtⱼ])` is ramified at the vertex `(t₁, …, tₙ)` of `𝐀ⁿ_k`, which
lies over the vertex `𝔪 = (tᵢtⱼ)`. -/
@[stacks 0BTE "ramified at the vertex"]
theorem not_isUnramifiedAt_idealOfVars [Nonempty σ] :
    ¬ Algebra.IsUnramifiedAt (evenSubalgebra k σ) (idealOfVars σ k) := by
  obtain ⟨i⟩ := (inferInstance : Nonempty σ)
  intro h
  obtain ⟨r, hr, hr0⟩ := (isUnramifiedAt_iff_forall_exists_smul_eq_zero _).mp h
    (KaehlerDifferential.D (evenSubalgebra k σ) (MvPolynomial σ k) (X i))
  have hlift := congrArg (vertexDerivation i).liftKaehlerDifferential hr0
  rw [map_smul, Derivation.liftKaehlerDifferential_comp_D, map_zero, vertexDerivation_X,
    ← LinearMap.map_smul, smul_eq_mul, mul_one, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero] at hlift
  exact hr hlift

/-! ### The codimension of the vertex -/

variable (k) in
/-- Setting the first `j` variables to zero. -/
private noncomputable def truncAlgHom (n j : ℕ) :
    MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k :=
  aeval fun i ↦ if (i : ℕ) < j then 0 else X i

variable (k) in
private noncomputable def killAlgHom (n j : ℕ) :
    MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k :=
  aeval fun i ↦ if (i : ℕ) = j then 0 else X i

variable (k) in
private noncomputable def chainPrime (n j : ℕ) : Ideal (evenSubalgebra k (Fin n)) :=
  (RingHom.ker (truncAlgHom k n j).toRingHom).comap
    (algebraMap (evenSubalgebra k (Fin n)) (MvPolynomial (Fin n) k))

variable (k) in
private theorem mem_chainPrime_iff (n j : ℕ) (f : MvPolynomial (Fin n) k)
    (hf : f ∈ evenSubalgebra k (Fin n)) :
    (⟨f, hf⟩ : evenSubalgebra k (Fin n)) ∈ chainPrime k n j ↔ truncAlgHom k n j f = 0 := by
  simp [chainPrime, Ideal.mem_comap, RingHom.mem_ker]

variable (k) in
private theorem chainPrime_isPrime (n j : ℕ) : (chainPrime k n j).IsPrime := by
  have : (RingHom.ker (truncAlgHom k n j).toRingHom).IsPrime := RingHom.ker_isPrime _
  exact Ideal.IsPrime.comap _

variable (k) in
private theorem truncAlgHom_succ (n j : ℕ) :
    truncAlgHom k n (j + 1) = (killAlgHom k n j).comp (truncAlgHom k n j) := by
  refine MvPolynomial.algHom_ext fun i ↦ ?_
  simp only [AlgHom.comp_apply, truncAlgHom, killAlgHom, aeval_X]
  by_cases h1 : (i : ℕ) < j
  · simp [h1, Nat.lt_succ_of_lt h1]
  · by_cases h2 : (i : ℕ) = j
    · simp [h2]
    · simp [h1, h2, show ¬ ((i : ℕ) < j + 1) by omega]

variable (k) in
private theorem chainPrime_le_succ (n j : ℕ) : chainPrime k n j ≤ chainPrime k n (j + 1) := by
  rintro ⟨f, hf⟩ ha
  rw [mem_chainPrime_iff k n j f hf] at ha
  rw [mem_chainPrime_iff k n (j + 1) f hf, truncAlgHom_succ, AlgHom.comp_apply, ha, map_zero]

variable (k) in
private theorem chainPrime_lt_succ (n : ℕ) {j : ℕ} (hj : j < n) :
    chainPrime k n j < chainPrime k n (j + 1) := by
  refine lt_of_le_of_ne (chainPrime_le_succ k n j) fun heq ↦ ?_
  have hX2 : truncAlgHom k n (j + 1)
      (X (⟨j, hj⟩ : Fin n) * X (⟨j, hj⟩ : Fin n) : MvPolynomial (Fin n) k) = 0 := by
    rw [map_mul]
    simp [truncAlgHom]
  have hX2' : truncAlgHom k n j
      (X (⟨j, hj⟩ : Fin n) * X (⟨j, hj⟩ : Fin n) : MvPolynomial (Fin n) k) ≠ 0 := by
    rw [map_mul]
    simp only [truncAlgHom, aeval_X, lt_self_iff_false, ite_false]
    exact mul_ne_zero (X_ne_zero _) (X_ne_zero _)
  have hmem := (mem_chainPrime_iff k n (j + 1) _
    (X_mul_X_mem_evenSubalgebra (⟨j, hj⟩ : Fin n) (⟨j, hj⟩ : Fin n))).mpr hX2
  exact hX2' ((mem_chainPrime_iff k n j _ _).mp (heq.ge hmem))

variable (k) in
private theorem chainPrime_self (n : ℕ) : chainPrime k n n = vertexIdeal k (Fin n) := by
  have h0 : truncAlgHom k n n = aeval (0 : Fin n → MvPolynomial (Fin n) k) := by
    refine MvPolynomial.algHom_ext fun i ↦ ?_
    simp [truncAlgHom]
  have hker : RingHom.ker (truncAlgHom k n n).toRingHom = idealOfVars (Fin n) k := by
    rw [idealOfVars_eq_ker]
    ext f
    rw [RingHom.mem_ker, RingHom.mem_ker]
    change truncAlgHom k n n f = 0 ↔ _
    rw [h0, aeval_zero, algebraMap_eq, C_eq_zero]
  rw [vertexIdeal_eq_under, Ideal.under_def, chainPrime, hker]

variable (k) in
private theorem le_height_chainPrime (n : ℕ) :
    ∀ j ≤ n, (j : ℕ∞) ≤ (chainPrime k n j).height := by
  intro j hj
  induction j with
  | zero => simp
  | succ j ih =>
    have := chainPrime_isPrime k n j
    have := chainPrime_isPrime k n (j + 1)
    calc ((j + 1 : ℕ) : ℕ∞) = (j : ℕ∞) + 1 := by push_cast; ring
      _ ≤ (chainPrime k n j).height + 1 := by gcongr; exact ih (by omega)
      _ ≤ (chainPrime k n (j + 1)).height :=
          Ideal.height_add_one_le_of_lt_of_isPrime (chainPrime_lt_succ k n (by omega))

/-- The vertex `𝔪 = (tᵢtⱼ)` has height `n` in `k[tᵢtⱼ]` for `n` variables: it is a point of
codimension `n` of the quotient. -/
@[stacks 0BTE "the vertex has codimension n"]
theorem height_vertexIdeal (n : ℕ) : (vertexIdeal k (Fin n)).height = n := by
  refine le_antisymm ?_ (chainPrime_self k n ▸ le_height_chainPrime k n n le_rfl)
  have := finite_evenSubalgebra (k := k) (σ := Fin n)
  have : Algebra.IsIntegral (evenSubalgebra k (Fin n)) (MvPolynomial (Fin n) k) :=
    Algebra.IsIntegral.of_finite _ _
  have h1 : (((vertexIdeal k (Fin n)).height : ℕ∞) : WithBot ℕ∞)
      ≤ ringKrullDim (evenSubalgebra k (Fin n)) := Ideal.height_le_ringKrullDim_of_isPrime
  rw [Algebra.IsIntegral.ringKrullDim_eq (evenSubalgebra k (Fin n)) (MvPolynomial (Fin n) k),
    MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field] at h1
  simp only [ENat.card_eq_coe_natCard, Nat.card_eq_fintype_card, Fintype.card_fin, zero_add] at h1
  exact_mod_cast h1

/-- For at least two variables the vertex `𝔪 = (tᵢtⱼ)` has codimension greater than one, so the
ramification of `𝐀ⁿ_k → Spec(k[tᵢtⱼ])` is not visible in codimension one. -/
@[stacks 0BTE "ramification in codimension greater than one"]
theorem one_lt_height_vertexIdeal {n : ℕ} (hn : 2 ≤ n) : 1 < (vertexIdeal k (Fin n)).height := by
  rw [height_vertexIdeal]
  exact_mod_cast hn

end MvPolynomial
