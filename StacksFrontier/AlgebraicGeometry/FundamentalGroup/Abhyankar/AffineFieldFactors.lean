module

public import Mathlib.AlgebraicGeometry.Morphisms.SurjectiveOnStalks
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.PurityBranchLocus.CodimensionOneExtension

/-!
# Field factors of a cover of a principal open of an affine scheme

Let `R` be a ring, `g ∈ R`, `U = D(g) ⊆ Spec R`, and let `B` be a finite étale `R_g`-algebra, so
that `Spec B ⟶ Spec R_g ≅ U` is a finite étale cover of `U`. At a point `q ∉ U` with local ring
`A = 𝒪_{Spec R, q}`, the field factors of the cover in the sense of
`Stacks.FundamentalGroup.IsFieldFactorAt` are described algebraically: a field factor is a field
`L` finite over a fraction field `K` of `A`, together with a ring map `ψ : B → L` compatible with
`R → A → K → L` and such that `ψ(B)` generates `L` over `K`.

## Main definitions

* `AlgebraicGeometry.AffineFieldFactors.coverMap`: the cover `Spec B ⟶ D(g)`.

## Main results

* `AlgebraicGeometry.AffineFieldFactors.isFieldFactorAt_of_ringHom`: an algebraic field factor
  is a field factor of the cover.
* `AlgebraicGeometry.AffineFieldFactors.exists_ringHom_of_isFieldFactorAt`: every field factor of
  the cover is an algebraic one.

## References

* [Stacks Project, Tag 0EYD](https://stacks.math.columbia.edu/tag/0EYD)
* [Stacks Project, Tag 0EYG](https://stacks.math.columbia.edu/tag/0EYG)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u

namespace AlgebraicGeometry.AffineFieldFactors

variable {R : CommRingCat.{u}} (g : R) (B : Type u) [CommRing B]
  [Algebra (Localization.Away g) B]

/-- The cover `Spec B ⟶ D(g)` attached to an `R_g`-algebra `B`. -/
def coverMap : Spec (.of B) ⟶ Scheme.Opens.toScheme (X := Spec R) (PrimeSpectrum.basicOpen g) :=
  Spec.map (CommRingCat.ofHom (algebraMap (Localization.Away g) B)) ≫ (basicOpenIsoSpecAway g).inv

/-- The composite of `coverMap g B` with the inclusion `D(g) ⟶ Spec R` is `Spec` of the
structure map `R → R_g → B`. -/
lemma coverMap_ι : coverMap g B ≫ Scheme.Opens.ι (X := Spec R) (PrimeSpectrum.basicOpen g) =
    Spec.map (CommRingCat.ofHom ((algebraMap (Localization.Away g) B).comp
      (algebraMap R (Localization.Away g)))) := by
  rw [coverMap, Category.assoc, ← basicOpenIsoSpecAway_hom_SpecMap, Iso.inv_hom_id_assoc,
    ← Spec.map_comp]
  rfl

variable {g B}

/-- **A field generated by the image of a ring is a field of fractions of that image.** If `L` is
generated over a subfield `K` by the image of `ψ`, and the image of `K` lies in the subfield
generated by the image of `ψ`, then every element of `L` is a quotient `ψ b / ψ c`. -/
lemma exists_mul_eq_of_adjoin_eq_top {K L : Type u} [Field K] [Field L] [Algebra K L]
    (ψ : B →+* L) (hgen : Algebra.adjoin K (Set.range ψ) = ⊤)
    (hK : ∀ k : K, algebraMap K L k ∈ Subfield.closure (Set.range ψ)) (l : L) :
    ∃ b c : B, IsUnit (ψ c) ∧ ψ c * l = ψ b := by
  let F := Subfield.closure (Set.range ψ)
  let S : Subalgebra K L := { F.toSubring with algebraMap_mem' := hK }
  have hS : Algebra.adjoin K (Set.range ψ) ≤ S :=
    Algebra.adjoin_le fun x hx ↦ Subfield.subset_closure hx
  have hl : l ∈ F := hS (hgen ▸ Algebra.mem_top)
  obtain ⟨y, hy, z, hz, rfl⟩ := Subfield.mem_closure_iff.mp hl
  have hrange : Subring.closure (Set.range ψ) = ψ.range := by
    simp [← RingHom.coe_range]
  rw [hrange] at hy hz
  obtain ⟨b, rfl⟩ := hy
  obtain ⟨c, rfl⟩ := hz
  by_cases hc : ψ c = 0
  · exact ⟨0, 1, by simp, by simp [hc]⟩
  · exact ⟨b, c, isUnit_iff_ne_zero.mpr hc, by field_simp⟩

/-- Elements of a fraction field of a localization `A` of `R` lie in the subfield generated by the
image of `R`. -/
lemma algebraMap_mem_closure {q : Ideal R} [q.IsPrime] {A : Type u} [CommRing A] [Algebra R A]
    [IsLocalization.AtPrime A q] {K L : Type u} [Field K] [Field L]
    [Algebra A K] [IsFractionRing A K] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (S : Set L) (hS : ∀ r : R, algebraMap A L (algebraMap R A r) ∈ Subfield.closure S) (k : K) :
    algebraMap K L k ∈ Subfield.closure S := by
  have hA : ∀ a : A, algebraMap A L a ∈ Subfield.closure S := by
    intro a
    obtain ⟨⟨r, t⟩, rfl⟩ := IsLocalization.mk'_surjective (S := A) q.primeCompl a
    have ht : IsUnit (algebraMap R A t) := IsLocalization.map_units _ t
    have : algebraMap A L (IsLocalization.mk' A r t) =
        algebraMap A L (algebraMap R A r) / algebraMap A L (algebraMap R A (t : R)) := by
      rw [eq_div_iff ((ht.map _).ne_zero), ← map_mul, IsLocalization.mk'_spec]
    rw [this]
    exact div_mem (hS r) (hS t)
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := A) k
  rw [map_div₀, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
  exact div_mem (hA a) (hA b)

variable (q : Spec R) [Algebra R ((Spec R).presheaf.stalk q)]

/-- The ideal of a point of `Spec R` is prime. -/
instance : q.asIdeal.IsPrime := q.isPrime

/-- **An algebraic field factor is a field factor of the cover.** Let `q` be a point of `Spec R`
whose local ring is a localization of `R` at `q`, `K` a fraction field of `𝒪_{Spec R, q}` in which
`g` is invertible, `L` a field over `K` and `ψ : B → L` a ring map compatible with
`R → 𝒪_{Spec R, q} → L` whose image generates `L` over `K`. Then `L` is a field factor of
`Spec B ⟶ D(g)` at `q`. -/
theorem isFieldFactorAt_of_ringHom [IsLocalization.AtPrime ((Spec R).presheaf.stalk q) q.asIdeal]
    (hρ : Spec.map (CommRingCat.ofHom (algebraMap R ((Spec R).presheaf.stalk q))) =
      (Spec R).fromSpecStalk q)
    {K L : Type u} [Field K] [Field L]
    [Algebra ((Spec R).presheaf.stalk q) K] [IsFractionRing ((Spec R).presheaf.stalk q) K]
    [Algebra K L] [Algebra ((Spec R).presheaf.stalk q) L]
    [IsScalarTower ((Spec R).presheaf.stalk q) K L]
    (hg : IsUnit (algebraMap ((Spec R).presheaf.stalk q) K (algebraMap R _ g)))
    (ψ : B →+* L)
    (hψ : ∀ r : R, ψ (algebraMap (Localization.Away g) B (algebraMap R _ r)) =
      algebraMap ((Spec R).presheaf.stalk q) L (algebraMap R _ r))
    (hgen : Algebra.adjoin K (Set.range ψ) = ⊤) :
    Stacks.FundamentalGroup.IsFieldFactorAt
      (Scheme.Opens.ι (X := Spec R) (PrimeSpectrum.basicOpen g)) (coverMap g B) q K L := by
  let φ : R →+* K := (algebraMap ((Spec R).presheaf.stalk q) K).comp
    (algebraMap R ((Spec R).presheaf.stalk q))
  let gK : Localization.Away g →+* K := IsLocalization.Away.lift g (g := φ) hg
  have hgK : ∀ r : R, gK (algebraMap R _ r) = φ r := IsLocalization.Away.lift_eq g hg
  have hcomp : ψ.comp (algebraMap (Localization.Away g) B) = (algebraMap K L).comp gK := by
    refine IsLocalization.ringHom_ext (Submonoid.powers g) (RingHom.ext fun r ↦ ?_)
    simp only [RingHom.comp_apply]
    rw [hψ, hgK, RingHom.comp_apply]
    exact IsScalarTower.algebraMap_apply ((Spec R).presheaf.stalk q) K L _
  refine ⟨Spec.map (CommRingCat.ofHom gK) ≫ (basicOpenIsoSpecAway g).inv,
    Spec.map (CommRingCat.ofHom ψ), ?_, ?_, ?_⟩
  · rw [Category.assoc, ← basicOpenIsoSpecAway_hom_SpecMap, Iso.inv_hom_id_assoc, ← hρ,
      ← Spec.map_comp, ← Spec.map_comp]
    congr 1
    ext r
    exact hgK r
  · rw [coverMap, ← Category.assoc, ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
    exact congrArg (fun φ ↦ Spec.map (CommRingCat.ofHom φ) ≫ (basicOpenIsoSpecAway g).inv) hcomp
  · have : SurjectiveOnStalks (Spec.map (CommRingCat.ofHom ψ)) := by
      rw [SurjectiveOnStalks.Spec_iff]
      refine RingHom.surjectiveOnStalks_of_exists_div fun l ↦ ?_
      exact exists_mul_eq_of_adjoin_eq_top ψ hgen
        (algebraMap_mem_closure (q := q.asIdeal) (A := (Spec R).presheaf.stalk q) _ (fun r ↦ by
          rw [← hψ]
          exact Subfield.subset_closure ⟨_, rfl⟩)) l
    exact exists_ringEquiv_residueField_of_surjectiveOnStalks _

/-- **Every field factor of the cover is an algebraic one.** A field factor `L` of
`Spec B ⟶ D(g)` at `q` comes from a ring map `ψ : B → L` compatible with
`R → 𝒪_{Spec R, q} → L` whose image generates `L` over `K`. -/
theorem exists_ringHom_of_isFieldFactorAt
    (hρ : Spec.map (CommRingCat.ofHom (algebraMap R ((Spec R).presheaf.stalk q))) =
      (Spec R).fromSpecStalk q)
    {K L : Type u} [Field K] [Field L]
    [Algebra ((Spec R).presheaf.stalk q) K] [Algebra K L] [FiniteDimensional K L]
    [Algebra ((Spec R).presheaf.stalk q) L] [IsScalarTower ((Spec R).presheaf.stalk q) K L]
    (hFF : Stacks.FundamentalGroup.IsFieldFactorAt
      (Scheme.Opens.ι (X := Spec R) (PrimeSpectrum.basicOpen g)) (coverMap g B) q K L) :
    ∃ ψ : B →+* L,
      (∀ r : R, ψ (algebraMap (Localization.Away g) B (algebraMap R _ r)) =
        algebraMap ((Spec R).presheaf.stalk q) L (algebraMap R _ r)) ∧
      Algebra.adjoin K (Set.range ψ) = ⊤ := by
  obtain ⟨w, v, hw, hv, e, he⟩ := hFF
  let ψ : B →+* L := (Spec.preimage v).hom
  have hvψ : Spec.map (CommRingCat.ofHom ψ) = v := Spec.map_preimage v
  refine ⟨ψ, fun r ↦ ?_, ?_⟩
  · have h1 : v ≫ coverMap g B ≫ Scheme.Opens.ι (X := Spec R) (PrimeSpectrum.basicOpen g) =
        Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫
          Spec.map (CommRingCat.ofHom (algebraMap ((Spec R).presheaf.stalk q) K)) ≫
          Spec.map (CommRingCat.ofHom (algebraMap R ((Spec R).presheaf.stalk q))) := by
      rw [← Category.assoc, hv, Category.assoc, hw, hρ]
    rw [coverMap_ι, ← hvψ, ← Spec.map_comp, ← Spec.map_comp, ← Spec.map_comp] at h1
    have h2 := congrArg (fun φ ↦ φ.hom r) (Spec.map_injective h1)
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at h2
    rw [h2, ← IsScalarTower.algebraMap_apply]
  · let S := Algebra.adjoin K (Set.range ψ)
    have hinv : ∀ x ∈ S, x⁻¹ ∈ S := fun x hx ↦
      Subalgebra.inv_mem_of_algebraic (A := S) (x := ⟨x, hx⟩)
        (Algebra.IsAlgebraic.isAlgebraic (R := K) x)
    have : IsIso (CommRingCat.ofHom e.toRingHom) :=
      ⟨⟨CommRingCat.ofHom e.symm.toRingHom, by ext; simp, by ext; simp⟩⟩
    have : IsPreimmersion v := by
      rw [← he]
      infer_instance
    have hs : SurjectiveOnStalks (Spec.map (CommRingCat.ofHom ψ)) := by
      rw [hvψ]
      infer_instance
    rw [SurjectiveOnStalks.Spec_iff] at hs
    have hsurj := (RingHom.surjective_localRingHom_iff (f := ψ) (⊥ : Ideal L)).mp
      (hs ⊥ Ideal.isPrime_bot)
    rw [eq_top_iff]
    intro l _
    obtain ⟨x, r, c, hc, hr, h⟩ := hsurj l
    have hc0 : c ≠ 0 := fun h0 ↦ hc (h0 ▸ Submodule.zero_mem _)
    have hr0 : ψ r ≠ 0 := fun h0 ↦ hr (h0 ▸ Submodule.zero_mem _)
    have hl : l = ψ x * (ψ r)⁻¹ := by
      rw [eq_mul_inv_iff_mul_eq₀ hr0, mul_comm]
      exact mul_left_cancel₀ hc0 (by rw [← mul_assoc]; exact h)
    rw [hl]
    exact S.mul_mem (Algebra.subset_adjoin ⟨x, rfl⟩) (hinv _ (Algebra.subset_adjoin ⟨r, rfl⟩))

end AlgebraicGeometry.AffineFieldFactors
