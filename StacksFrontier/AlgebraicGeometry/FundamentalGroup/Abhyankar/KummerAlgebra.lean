/-!
# The algebra `A[x]/(x^e - f)` over a regular local ring

Let `A` be a local ring and `f ∈ 𝔪_A`. The standard tamely ramified algebra
`C = A[x]/(x^e - f)` of [Stacks, Tag 0EYF] has the following properties.

* `C / x C ≅ A / f A`, and `C` is local, the root `x` lying in its maximal ideal.
* If `A` is a domain and `f ≠ 0`, then `x` is a nonzerodivisor of `C`.
* If `A` is Noetherian and `A / f A` is regular, then `C` is a regular local ring
  ([Stacks, Tag 00NU]).
* If `A` is strictly henselian, so is `C`.

## Main results

* `AlgebraicGeometry.Abhyankar.quotRootEquiv`: `C / x C ≅ A / f A`.
* `AlgebraicGeometry.Abhyankar.isLocalRing`: `C` is local.
* `AlgebraicGeometry.Abhyankar.isRegularLocalRing`: `C` is regular.
* `AlgebraicGeometry.Abhyankar.strictlyHenselianLocalRing`: `C` is strictly henselian.

## References

* [Stacks Project, Tag 0EYG](https://stacks.math.columbia.edu/tag/0EYG)
* [Stacks Project, Tag 0EYF](https://stacks.math.columbia.edu/tag/0EYF)
-/

@[expose] public noncomputable section

open Polynomial IsLocalRing

universe u

namespace AlgebraicGeometry.Abhyankar

variable (A : Type u) [CommRing A] (f : A) (e : ℕ)

/-- The image of `x` in `A[x]/(x^e - f)`. -/
abbrev root : standardTamelyRamifiedAlgebra A f e := Ideal.Quotient.mk _ X

/-- The root satisfies `x ^ e = f` in `A[x]/(x^e - f)`. -/
lemma root_pow : root A f e ^ e = algebraMap A (standardTamelyRamifiedAlgebra A f e) f := by
  rw [← map_pow, ← Ideal.Quotient.mk_algebraMap, Polynomial.algebraMap_eq, Ideal.Quotient.eq]
  exact Ideal.subset_span rfl

/-- The map `A[x]/(x^e - f) → A/(f)` sending the root to zero. -/
def toQuot [NeZero e] : standardTamelyRamifiedAlgebra A f e →+* A ⧸ Ideal.span {f} :=
  Ideal.Quotient.lift _ (eval₂RingHom (Ideal.Quotient.mk _) 0) (by
    intro g hg
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hg
    change eval₂ (Ideal.Quotient.mk _) 0 (c * (X ^ e - C f)) = 0
    rw [eval₂_mul, eval₂_sub, eval₂_X_pow, eval₂_C, zero_pow (NeZero.ne e), zero_sub,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f), neg_zero, mul_zero])

/-- `toQuot` sends the image of `a ∈ A` to the class of `a` in `A/(f)`. -/
lemma toQuot_algebraMap [NeZero e] (a : A) :
    toQuot A f e (algebraMap A _ a) = Ideal.Quotient.mk _ a := by
  rw [← Ideal.Quotient.mk_algebraMap, Polynomial.algebraMap_eq]
  show eval₂ (Ideal.Quotient.mk _) 0 (C a) = _
  rw [eval₂_C]

/-- `toQuot` sends the root to zero. -/
lemma toQuot_root [NeZero e] : toQuot A f e (root A f e) = 0 := by
  show eval₂ (Ideal.Quotient.mk _) 0 X = 0
  rw [eval₂_X]

/-- The map `toQuot : A[x]/(x^e - f) → A/(f)` is surjective. -/
lemma toQuot_surjective [NeZero e] : Function.Surjective (toQuot A f e) := by
  intro b
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
  exact ⟨algebraMap A _ a, toQuot_algebraMap A f e a⟩

/-- The kernel of `toQuot` is the ideal generated by the root. -/
lemma ker_toQuot [NeZero e] : RingHom.ker (toQuot A f e) = Ideal.span {root A f e} := by
  apply le_antisymm
  · intro c hc
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective c
    have h0 : Ideal.Quotient.mk (Ideal.span {f}) (g.coeff 0) = 0 := by
      have : eval₂ (Ideal.Quotient.mk (Ideal.span {f})) 0 g = 0 := hc
      rwa [eval₂_at_zero] at this
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq_zero_iff_mem.mp h0)
    have hg : g = g.divX * X + C a * C f := by
      rw [← C_mul, ha]
      exact (divX_mul_X_add g).symm
    have hf' : (Ideal.Quotient.mk (Ideal.span {X ^ e - C f}) (C f) :
        standardTamelyRamifiedAlgebra A f e) = root A f e ^ e := by
      rw [root_pow, ← Ideal.Quotient.mk_algebraMap, Polynomial.algebraMap_eq]
    have hmem : root A f e ^ e ∈ Ideal.span {root A f e} :=
      Ideal.pow_mem_of_mem _ (Ideal.mem_span_singleton_self _) e (Nat.pos_of_ne_zero (NeZero.ne e))
    rw [hg, map_add, map_mul, map_mul, hf']
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
      (Ideal.mul_mem_left _ _ hmem)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact toQuot_root A f e

/-- **`C / x C ≅ A / f A`.** -/
def quotRootEquiv [NeZero e] :
    (standardTamelyRamifiedAlgebra A f e ⧸ Ideal.span {root A f e}) ≃+* A ⧸ Ideal.span {f} :=
  (Ideal.quotEquivOfEq (ker_toQuot A f e).symm).trans
    (RingHom.quotientKerEquivOfSurjective (toQuot_surjective A f e))

/-- `A[x]/(x^e - f)` is a finite `A`-module. -/
instance [NeZero e] : Module.Finite A (standardTamelyRamifiedAlgebra A f e) :=
  (monic_X_pow_sub_C f (NeZero.ne e)).finite_quotient

/-- `A[x]/(x^e - f)` is integral over `A`. -/
instance [NeZero e] : Algebra.IsIntegral A (standardTamelyRamifiedAlgebra A f e) :=
  Algebra.IsIntegral.of_finite A _

section Local

variable [IsLocalRing A] [NeZero e] {f}

/-- If `f ∈ 𝔪_A`, then `(f) ≤ 𝔪_A`. -/
lemma span_le_maximalIdeal (hf : f ∈ maximalIdeal A) : Ideal.span {f} ≤ maximalIdeal A := by
  rwa [Ideal.span_singleton_le_iff_mem]

/-- The residue map `A[x]/(x^e - f) → κ_A` sending the root to zero. -/
def toResidue (hf : f ∈ maximalIdeal A) :
    standardTamelyRamifiedAlgebra A f e →+* ResidueField A :=
  (Ideal.Quotient.factor (span_le_maximalIdeal A hf)).comp (toQuot A f e)

/-- The residue map `toResidue : A[x]/(x^e - f) → κ_A` is surjective. -/
lemma toResidue_surjective (hf : f ∈ maximalIdeal A) :
    Function.Surjective (toResidue A e hf) :=
  (Ideal.Quotient.factor_surjective (span_le_maximalIdeal A hf)).comp (toQuot_surjective A f e)

/-- A maximal ideal of `A[x]/(x^e - f)` lies over the maximal ideal of `A`. -/
private theorem comap_eq_maximalIdeal_of_isMaximal
    (M : Ideal (standardTamelyRamifiedAlgebra A f e)) [M.IsMaximal] :
    M.comap (algebraMap A _) = maximalIdeal A :=
  IsLocalRing.eq_maximalIdeal (Ideal.isMaximal_under_of_isIntegral_of_isMaximal (R := A) M)

/-- If `f ∈ 𝔪_A`, the root lies in every maximal ideal of `A[x]/(x^e - f)`. -/
lemma root_mem_of_isMaximal (hf : f ∈ maximalIdeal A)
    (M : Ideal (standardTamelyRamifiedAlgebra A f e)) [M.IsMaximal] : root A f e ∈ M := by
  have hc := comap_eq_maximalIdeal_of_isMaximal A e M
  exact (Ideal.IsMaximal.isPrime inferInstance).mem_of_pow_mem e
    (by rwa [root_pow, ← Ideal.mem_comap, hc])

/-- If `f ∈ 𝔪_A`, the kernel of `toResidue` lies in every maximal ideal of `A[x]/(x^e - f)`. -/
lemma ker_toResidue_le (hf : f ∈ maximalIdeal A)
    (M : Ideal (standardTamelyRamifiedAlgebra A f e)) [M.IsMaximal] :
    RingHom.ker (toResidue A e hf) ≤ M := by
  intro c hc
  obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (toQuot A f e c)
  have hcomp := comap_eq_maximalIdeal_of_isMaximal A e M
  have ham : a ∈ maximalIdeal A := by
    have h0 : Ideal.Quotient.factor (span_le_maximalIdeal A hf) (toQuot A f e c) = 0 := hc
    rw [← ha, Ideal.Quotient.factor_mk] at h0
    exact Ideal.Quotient.eq_zero_iff_mem.mp h0
  have hdiff : c - algebraMap A _ a ∈ RingHom.ker (toQuot A f e) := by
    rw [RingHom.mem_ker, map_sub, toQuot_algebraMap, ha, sub_self]
  rw [ker_toQuot] at hdiff
  have h1 : c - algebraMap A _ a ∈ M :=
    (Ideal.span_singleton_le_iff_mem _ |>.mpr (root_mem_of_isMaximal A e hf M)) hdiff
  have h2 : algebraMap A _ a ∈ M := by rwa [← Ideal.mem_comap, hcomp]
  simpa using M.add_mem h1 h2

/-- **`A[x]/(x^e - f)` is local** when `A` is local and `f ∈ 𝔪_A`. -/
theorem isLocalRing (hf : f ∈ maximalIdeal A) :
    IsLocalRing (standardTamelyRamifiedAlgebra A f e) := by
  have hmax : (RingHom.ker (toResidue A e hf)).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective _ (toResidue_surjective A e hf)
  exact IsLocalRing.of_unique_max_ideal
    ⟨_, hmax, fun M hM ↦ (hmax.eq_of_le hM.ne_top (ker_toResidue_le A e hf M)).symm⟩

end Local

section Domain

variable [IsDomain A] [NeZero e] {f}

/-- **The root is a nonzerodivisor** when `A` is a domain and `f ≠ 0`. -/
theorem root_mem_nonZeroDivisors (hf0 : f ≠ 0) :
    root A f e ∈ nonZeroDivisors (standardTamelyRamifiedAlgebra A f e) := by
  rw [mem_nonZeroDivisors_iff]
  refine ⟨fun c hc ↦ ?_, fun c hc ↦ ?_⟩ <;>
  · obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective c
    first
      | have hc' : Ideal.Quotient.mk (Ideal.span {X ^ e - C f}) (X * g) = 0 := by
          rwa [map_mul]
      | have hc' : Ideal.Quotient.mk (Ideal.span {X ^ e - C f}) (X * g) = 0 := by
          rwa [map_mul, mul_comm]
    obtain ⟨h, hh⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq_zero_iff_mem.mp hc')
    have hX : (X : A[X]) ∣ h * (X ^ e - C f) := ⟨g, hh⟩
    have hnd : ¬ (X : A[X]) ∣ X ^ e - C f := by
      rwa [X_dvd_iff, coeff_sub, coeff_X_pow, coeff_C_zero, if_neg (NeZero.ne e).symm, zero_sub,
        neg_eq_zero]
    obtain ⟨h', rfl⟩ := (prime_X.dvd_or_dvd hX).resolve_right hnd
    have hg : g = h' * (X ^ e - C f) := by
      apply mul_left_cancel₀ (X_ne_zero (R := A))
      rw [← hh]
      ring
    rw [hg, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

end Domain

section Regular

variable [IsRegularLocalRing A] [NeZero e] {f}

/-- **`A[x]/(x^e - f)` is regular local** when `A` is regular local, `0 ≠ f ∈ 𝔪_A` and `A/fA` is
regular. -/
theorem isRegularLocalRing (hf : f ∈ maximalIdeal A) (hf0 : f ≠ 0)
    (hreg : IsRegularLocalRing (A ⧸ Ideal.span {f})) :
    IsRegularLocalRing (standardTamelyRamifiedAlgebra A f e) := by
  have : IsDomain A := IsRegularLocalRing.isDomain A
  have := isLocalRing A e hf
  exact isRegularLocalRing_of_nonZeroDivisor _ (root A f e) (root_mem_nonZeroDivisors A e hf0)
    (IsRegularLocalRing.of_ringEquiv (quotRootEquiv A f e).symm)

end Regular

section StrictlyHenselian

variable [StrictlyHenselianLocalRing A] [NeZero e] {f}

/-- **`A[x]/(x^e - f)` is strictly henselian** when `A` is strictly henselian and
`f ∈ 𝔪_A`. -/
theorem strictlyHenselianLocalRing (hf : f ∈ maximalIdeal A) :
    @StrictlyHenselianLocalRing (standardTamelyRamifiedAlgebra A f e) _ := by
  have := isLocalRing A e hf
  obtain ⟨hhens, hloc⟩ :=
    (HenselianLocalRing.henselianLocalRing_and_finite_of_finite_of_quasiFiniteAt.{u, u, u}
      A).2.1 (standardTamelyRamifiedAlgebra A f e) inferInstance
  have := hhens
  have := hloc
  have hsurj : Function.Surjective
      (ResidueField.map (algebraMap A (standardTamelyRamifiedAlgebra A f e))) := by
    intro c
    obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective c
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective c
    refine ⟨IsLocalRing.residue A (g.coeff 0), ?_⟩
    rw [ResidueField.map_residue, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    have hmem : Ideal.Quotient.mk _ g - algebraMap A _ (g.coeff 0) ∈
        Ideal.span {root A f e} := by
      have hg : g - C (g.coeff 0) = g.divX * X := by rw [sub_eq_iff_eq_add, divX_mul_X_add]
      rw [← Ideal.Quotient.mk_algebraMap, Polynomial.algebraMap_eq, ← map_sub, hg, map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    have hle : Ideal.span {root A f e} ≤ maximalIdeal (standardTamelyRamifiedAlgebra A f e) :=
      (Ideal.span_singleton_le_iff_mem _).mpr (root_mem_of_isMaximal A e hf (maximalIdeal _))
    exact hle (by simpa using (Ideal.neg_mem_iff _).mpr hmem)
  let σ : ResidueField A ≃+* ResidueField (standardTamelyRamifiedAlgebra A f e) :=
    RingEquiv.ofBijective _ ⟨(ResidueField.map _).injective, hsurj⟩
  exact { toIsSepClosed := IsSepClosed.of_ringEquiv σ.symm }

end StrictlyHenselian

end AlgebraicGeometry.Abhyankar
