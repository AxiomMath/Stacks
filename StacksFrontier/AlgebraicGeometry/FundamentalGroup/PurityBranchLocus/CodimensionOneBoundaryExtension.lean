/-!
# The codimension-one extension input, discharged

The extension input `hExtend` (`AlgebraicGeometry.ExtendsAcrossCodimensionOneBoundary`) of
`AlgebraicGeometry.exists_finiteEtale_of_isUnramifiedInCodimensionOne` holds, by [Stacks, Tag 0H2W]
(`AlgebraicGeometry.exists_finiteEtale_extension_of_isUnramifiedInCodimensionOne`). Also: at a
point of an effective Cartier divisor `D` of a locally Noetherian scheme `X` with `D` a regular
scheme, the local ring of `X` is regular ([Stacks, Tag 00NU]): its quotient `𝒪_{D, x}` by the
stalk of the ideal of `D` is regular, and that stalk is generated by a nonzerodivisor.

[Stacks, Tag 0EYE] itself, which these served, is
`AlgebraicGeometry.exists_finiteEtale_extension_of_isEffectiveCartierDivisor` in
`StacksFrontier.AlgebraicGeometry.FundamentalGroup.PurityBranchLocus.ExtendAcrossRegularDivisor`.

## Main results

* `AlgebraicGeometry.extendsAcrossCodimensionOneBoundary`: the input `hExtend`, discharged.
* `AlgebraicGeometry.isRegularLocalRing_stalk_of_isEffectiveCartierDivisor`.

## References

* [Stacks Project, Lemma 58.31.2 (0H2W)](https://stacks.math.columbia.edu/tag/0H2W)
* [Stacks Project, Tag 00NU](https://stacks.math.columbia.edu/tag/00NU)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-- At a point of an effective Cartier divisor `D` of a locally Noetherian scheme `X` which is
a regular scheme, the local ring of `X` is regular: it is regular modulo a nonzerodivisor. -/
theorem isRegularLocalRing_stalk_of_isEffectiveCartierDivisor {X : Scheme.{u}}
    [IsLocallyNoetherian X] (D : X.IdealSheafData)
    (hD : Stacks.Divisors.IsEffectiveCartierDivisor D) (hreg : IsRegular D.subscheme)
    (x : X) (hx : x ∈ D.support) : IsRegularLocalRing (X.presheaf.stalk x) := by
  obtain ⟨z, rfl⟩ : x ∈ Set.range D.subschemeι := by rwa [D.range_subschemeι]
  have hstalk := ((isRegular_tfae D.subscheme).out 1 2).mp hreg
  let : IsRegularLocalRing (D.subscheme.presheaf.stalk z) := hstalk.2 z
  obtain ⟨f, hf, hspan⟩ :=
    exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor D hD (D.subschemeι z)
  have hquot : IsRegularLocalRing
      (X.presheaf.stalk (D.subschemeι z) ⧸ IdealSheafData.stalk D (D.subschemeι z)) :=
    IsRegularLocalRing.of_ringEquiv (IdealSheafData.subschemeStalkQuotEquiv D z).symm
  rw [hspan] at hquot
  exact isRegularLocalRing_of_nonZeroDivisor _ f hf.mem_nonZeroDivisors hquot

/-- The extension input `hExtend` of
`AlgebraicGeometry.exists_finiteEtale_of_isUnramifiedInCodimensionOne` holds: by [Stacks, Tag
0H2W] the cover extends over the whole scheme, which contains the codimension-one boundary. -/
@[sga "7 II 2.3.1" "partial"]
theorem extendsAcrossCodimensionOneBoundary : ExtendsAcrossCodimensionOneBoundary.{u} := by
  intro X _ U hdense E hunr hreg
  have : IsFinite E.hom := E.prop.1
  have : Etale E.hom := E.prop.2
  obtain ⟨Y', p, hp, hp', e, he⟩ :=
    exists_finiteEtale_extension_of_isUnramifiedInCodimensionOne U hdense E.hom hunr hreg
  let F : FiniteEtaleOver (⊤ : X.Opens).toScheme :=
    (finiteEtaleBaseChange (⊤ : X.Opens).ι).obj
      (MorphismProperty.Over.mk (P := finiteEtale) (Q := ⊤) p ⟨hp, hp'⟩)
  refine ⟨⊤, le_top, fun _ _ _ => trivial, F, ⟨?_⟩⟩
  exact ((finiteEtaleBaseChangeComp (X.homOfLE le_top) (⊤ : X.Opens).ι U.ι
    (by simp)).app _).symm ≪≫ MorphismProperty.Over.isoMk e he

end AlgebraicGeometry

end
