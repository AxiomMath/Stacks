module

public import Mathlib.NumberTheory.Padics.RingHoms
public import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed
public import Mathlib.Topology.Algebra.Group.Basic

/-!
# The `ℓ`-adic tame character

Let `κ` be a field and `ℓ` a prime.  A compatible system `ζ` of primitive `ℓ ^ k`-th roots of
unity in `κ` (`ζ (k + 1) ^ ℓ = ζ k`) identifies the group of compatible systems of `ℓ ^ k`-th
roots of unity with `ℤ_ℓ`: the system `x` corresponds to the `c ∈ ℤ_ℓ` with
`x k = ζ k ^ (c mod ℓ ^ k)` for every `k`.  Composing with a homomorphism `u` from a group into
such compatible systems gives the `ℓ`-adic character `Stacks.FundamentalGroup.ladicCharacter`.

Applied to the tame inertia character of a discretely valued field
(`Stacks.FundamentalGroup.exists_primeToChar_tameInertiaCharacter`), restricted to the orders
`ℓ ^ k`, this is the `ℓ`-adic tame character `t_ℓ : I → ℤ_ℓ(1) ≅ ℤ_ℓ` used in Grothendieck's
local monodromy theorem.

## Main results

* `Stacks.FundamentalGroup.ladicCharacter`: the `ℓ`-adic character attached to `ζ` and `u`.
* `Stacks.FundamentalGroup.ladicCharacter_spec`: `ζ k ^ (t g mod ℓ ^ k) = u g k`.
* `Stacks.FundamentalGroup.ladicCharacter_eq_iff`: this property characterizes `t g`.
* `Stacks.FundamentalGroup.ladicCharacter_eq_one_iff`: `t g = 1` iff every `u g k = 1`.
* `Stacks.FundamentalGroup.exists_compatible_isPrimitiveRoot`: compatible systems of primitive
  `ℓ ^ k`-th roots of unity exist in a separably closed field in which `ℓ` is invertible.
* `Stacks.FundamentalGroup.exists_forall_exists_eq_mul_of_compactSpace`: the image of a compact
  group under a continuous character to `ℤ_ℓ` is generated by one value.
* `Stacks.FundamentalGroup.continuous_of_isOpen_toZModPow`: a homomorphism to `ℤ_ℓ` whose
  reductions modulo every `ℓ ^ k` have open kernels is continuous.

## References

* P. Deligne, *La conjecture de Weil II*, Publ. Math. IHÉS 52 (1980), 1.7.
* [Stacks Project, Tag 03VH](https://stacks.math.columbia.edu/tag/03VH)
-/

@[expose] public noncomputable section

namespace Stacks.FundamentalGroup

variable {ℓ : ℕ} [Fact ℓ.Prime] {κ : Type*} [Field κ]

private instance neZero_of_fact_prime : NeZero ℓ := ⟨(Fact.out : ℓ.Prime).ne_zero⟩

/-- In a primitive `n`-th root of unity, exponents may be read in `ZMod n`. -/
theorem IsPrimitiveRoot.pow_val_add {n : ℕ} [NeZero n] {ζ : κˣ} (hζ : IsPrimitiveRoot ζ n)
    (a b : ZMod n) : ζ ^ (a + b).val = ζ ^ a.val * ζ ^ b.val := by
  rw [ZMod.val_add, ← pow_add]
  conv_rhs => rw [← Nat.div_add_mod (a.val + b.val) n, pow_add, pow_mul, hζ.pow_eq_one, one_pow,
    one_mul]

/-- Two elements of `ℤ_ℓ` whose residues mod every `ℓ ^ k` give the same power of a primitive
`ℓ ^ k`-th root of unity are equal. -/
theorem eq_of_forall_pow_toZModPow_eq {ζ : ℕ → κˣ} (hζ : ∀ k, IsPrimitiveRoot (ζ k) (ℓ ^ k))
    {c c' : ℤ_[ℓ]}
    (h : ∀ k, ζ k ^ (PadicInt.toZModPow k c).val = ζ k ^ (PadicInt.toZModPow k c').val) :
    c = c' := by
  refine PadicInt.ext_of_toZModPow.1 fun k => ?_
  exact ZMod.val_injective _ ((hζ k).pow_inj (ZMod.val_lt _) (ZMod.val_lt _) (h k))

/-- **A compatible system of primitive `ℓ ^ k`-th roots of unity** in a separably closed field
in which `ℓ` is invertible: `ζ k` is a primitive `ℓ ^ k`-th root of unity and
`ζ (k + 1) ^ ℓ = ζ k`. -/
theorem exists_compatible_isPrimitiveRoot [IsSepClosed κ] (hℓ : (ℓ : κ) ≠ 0) :
    ∃ ζ : ℕ → κˣ, (∀ k, IsPrimitiveRoot (ζ k) (ℓ ^ k)) ∧ ∀ k, ζ (k + 1) ^ ℓ = ζ k := by
  have : NeZero (ℓ : κ) := ⟨hℓ⟩
  have hℓ1 : 1 < ℓ := (Fact.out : ℓ.Prime).one_lt
  have step : ∀ k, ∀ z : {z : κˣ // IsPrimitiveRoot z (ℓ ^ (k + 1))},
      ∃ x : {x : κˣ // IsPrimitiveRoot x (ℓ ^ (k + 1 + 1))}, x.1 ^ ℓ = z.1 := by
    intro k z
    obtain ⟨y, hy⟩ := IsSepClosed.exists_pow_nat_eq (z.1 : κ) ℓ
    have hy0 : y ≠ 0 := by
      rintro rfl
      exact z.1.ne_zero (by rw [← hy, zero_pow (Fact.out : ℓ.Prime).ne_zero])
    let x : κˣ := Units.mk0 y hy0
    have hx : x ^ ℓ = z.1 := Units.ext (by simpa [x] using hy)
    have hxz : ∀ j, x ^ ℓ ^ (j + 1) = z.1 ^ ℓ ^ j := fun j => by rw [pow_succ', pow_mul, hx]
    refine ⟨⟨x, IsPrimitiveRoot.iff_orderOf.2 (orderOf_eq_prime_pow (hp := ⟨Fact.out⟩) ?_ ?_)⟩, hx⟩
    · rw [hxz]
      exact z.2.pow_ne_one_of_pos_of_lt (pow_ne_zero _ (by omega))
        (Nat.pow_lt_pow_right hℓ1 (Nat.lt_succ_self k))
    · rw [hxz, z.2.pow_eq_one]
  obtain ⟨z₀, hz₀⟩ := HasEnoughRootsOfUnity.exists_isPrimitiveRoot κ (ℓ ^ (0 + 1))
  let z₁ : {z : κˣ // IsPrimitiveRoot z (ℓ ^ (0 + 1))} :=
    ⟨(hz₀.isUnit (by positivity)).unit, hz₀.isUnit_unit (by positivity)⟩
  let g : ∀ k, {z : κˣ // IsPrimitiveRoot z (ℓ ^ (k + 1))} := fun k =>
    Nat.rec z₁ (fun k z => Classical.choose (step k z)) k
  refine ⟨fun k => Nat.casesOn k 1 fun k => (g k).1, fun k => ?_, fun k => ?_⟩
  · cases k with
    | zero => simp
    | succ k => exact (g k).2
  · cases k with
    | zero =>
      change (g 0).1 ^ ℓ = 1
      simpa using (g 0).2.pow_eq_one
    | succ k => exact Classical.choose_spec (step k (g k))

section Character

variable {G : Type*} [Group G] {ζ : ℕ → κˣ} (hζ : ∀ k, IsPrimitiveRoot (ζ k) (ℓ ^ k))
  (hζc : ∀ k, ζ (k + 1) ^ ℓ = ζ k) (u : G →* (ℕ → κˣ)) (hu : ∀ g k, u g k ^ (ℓ ^ k) = 1)
  (huc : ∀ g k, u g (k + 1) ^ ℓ = u g k)

include hζ hu in
/-- Each `u g k` is a power `ζ k ^ i` with `i < ℓ ^ k`. -/
theorem ladicCharacter.exists_lt_pow_eq (g : G) (k : ℕ) : ∃ i < ℓ ^ k, ζ k ^ i = u g k := by
  exact (hζ k).eq_pow_of_mem_rootsOfUnity ((mem_rootsOfUnity _ _).2 (hu g k))

/-- The discrete logarithm of `u g k` to the base `ζ k`, a natural number less than `ℓ ^ k`. -/
def ladicCharacter.dlog (g : G) (k : ℕ) : ℕ :=
  Classical.choose (ladicCharacter.exists_lt_pow_eq hζ u hu g k)

/-- The discrete logarithm `ladicCharacter.dlog` of `u g k` is less than `ℓ ^ k`, and `ζ k` raised
to it is `u g k`. -/
theorem ladicCharacter.dlog_spec (g : G) (k : ℕ) :
    ladicCharacter.dlog hζ u hu g k < ℓ ^ k ∧ ζ k ^ ladicCharacter.dlog hζ u hu g k = u g k :=
  Classical.choose_spec (ladicCharacter.exists_lt_pow_eq hζ u hu g k)

include hζc huc in
/-- The discrete logarithms `ladicCharacter.dlog` of `u g (k + 1)` and of `u g k` are congruent
modulo `ℓ ^ k`. -/
theorem ladicCharacter.pow_dvd_dlog_sub (g : G) (k : ℕ) :
    (ℓ : ℤ) ^ k ∣
      (ladicCharacter.dlog hζ u hu g (k + 1) : ℤ) - ladicCharacter.dlog hζ u hu g k := by
  have h1 := ladicCharacter.dlog_spec hζ u hu g (k + 1)
  have h0 := ladicCharacter.dlog_spec hζ u hu g k
  have key : ζ k ^ ((ladicCharacter.dlog hζ u hu g (k + 1) : ℕ) : ℤ) =
      ζ k ^ ((ladicCharacter.dlog hζ u hu g k : ℕ) : ℤ) := by
    rw [zpow_natCast, zpow_natCast, h0.2, ← hζc, ← pow_mul, mul_comm, pow_mul, h1.2, huc]
  rw [← Nat.cast_pow, ← (hζ k).zpow_eq_one_iff_dvd, zpow_sub, key, mul_inv_cancel]

/-- The `ℓ`-adic number whose residue modulo each `ℓ ^ k` is the discrete logarithm of `u g k`
to the base `ζ k`. -/
def ladicCharacter.log (g : G) : ℤ_[ℓ] :=
  PadicInt.ofIntSeq _ (PadicInt.isCauSeq_padicNorm_of_pow_dvd_sub
    (fun k => (ladicCharacter.dlog hζ u hu g k : ℤ)) ℓ
    (ladicCharacter.pow_dvd_dlog_sub hζ hζc u hu huc g))

/-- The residue of `ladicCharacter.log g` modulo `ℓ ^ k` is a discrete logarithm of `u g k` to the
base `ζ k`. -/
theorem ladicCharacter.log_spec (g : G) (k : ℕ) :
    ζ k ^ (PadicInt.toZModPow k (ladicCharacter.log hζ hζc u hu huc g)).val = u g k := by
  rw [ladicCharacter.log, PadicInt.toZModPow_ofIntSeq_of_pow_dvd_sub _ _
    (ladicCharacter.pow_dvd_dlog_sub hζ hζc u hu huc g)]
  have h := ladicCharacter.dlog_spec hζ u hu g k
  rw [Int.cast_natCast, ZMod.val_cast_of_lt h.1, h.2]

/-- **The `ℓ`-adic character** attached to a compatible system `ζ` of primitive `ℓ ^ k`-th roots
of unity and a homomorphism `u` into compatible systems of `ℓ ^ k`-th roots of unity: `t g` is
the `c ∈ ℤ_ℓ` with `u g k = ζ k ^ (c mod ℓ ^ k)` for all `k`. -/
def ladicCharacter : G →* Multiplicative ℤ_[ℓ] where
  toFun g := Multiplicative.ofAdd (ladicCharacter.log hζ hζc u hu huc g)
  map_one' := by
    refine congrArg Multiplicative.ofAdd (eq_of_forall_pow_toZModPow_eq hζ fun k => ?_)
    rw [ladicCharacter.log_spec, map_zero, ZMod.val_zero, pow_zero, map_one, Pi.one_apply]
  map_mul' g h := by
    rw [← ofAdd_add]
    refine congrArg Multiplicative.ofAdd (eq_of_forall_pow_toZModPow_eq hζ fun k => ?_)
    have : NeZero (ℓ ^ k) := ⟨pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero⟩
    rw [ladicCharacter.log_spec, map_add, IsPrimitiveRoot.pow_val_add (hζ k),
      ladicCharacter.log_spec, ladicCharacter.log_spec, map_mul, Pi.mul_apply]

/-- The defining property of the `ℓ`-adic character. -/
theorem ladicCharacter_spec (g : G) (k : ℕ) :
    ζ k ^ (PadicInt.toZModPow k (Multiplicative.toAdd (ladicCharacter hζ hζc u hu huc g))).val =
      u g k :=
  ladicCharacter.log_spec hζ hζc u hu huc g k

/-- The defining property characterizes the `ℓ`-adic character. -/
theorem ladicCharacter_eq_iff (g : G) (c : ℤ_[ℓ]) :
    Multiplicative.toAdd (ladicCharacter hζ hζc u hu huc g) = c ↔
      ∀ k, ζ k ^ (PadicInt.toZModPow k c).val = u g k := by
  refine ⟨fun h k => h ▸ ladicCharacter_spec hζ hζc u hu huc g k, fun h => ?_⟩
  exact eq_of_forall_pow_toZModPow_eq hζ fun k => by rw [ladicCharacter_spec, h]

/-- The kernel of the `ℓ`-adic character is the kernel of `u`. -/
theorem ladicCharacter_eq_one_iff (g : G) :
    ladicCharacter hζ hζc u hu huc g = 1 ↔ ∀ k, u g k = 1 := by
  rw [← toAdd_eq_zero, ladicCharacter_eq_iff]
  simp only [map_zero, ZMod.val_zero, pow_zero]
  exact forall_congr' fun _ => eq_comm

end Character

/-- Elements of `ℤ_ℓ` whose difference lies in `(ℓ ^ n)` with `n ≥ k` are within `ℓ ^ (-k)`. -/
private theorem dist_lt_of_sub_mem_span_pow {x y : ℤ_[ℓ]} {k n : ℕ} {ε : ℝ}
    (hk : (ℓ : ℝ) ^ (-(k : ℤ)) < ε) (hkn : k ≤ n)
    (h : x - y ∈ (Ideal.span {(ℓ : ℤ_[ℓ]) ^ n} : Ideal ℤ_[ℓ])) : dist x y < ε := by
  rw [← PadicInt.norm_le_pow_iff_mem_span_pow] at h
  rw [dist_eq_norm]
  refine lt_of_le_of_lt (h.trans ?_) hk
  exact zpow_le_zpow_right₀ (by exact_mod_cast (Fact.out : ℓ.Prime).one_le) (by omega)

/-- **Continuity of an `ℓ`-adic character.**  A homomorphism `t` from a topological group to
`ℤ_ℓ` all of whose reductions modulo `ℓ ^ k` have open kernel is continuous. -/
theorem continuous_of_isOpen_toZModPow {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] (t : G →* Multiplicative ℤ_[ℓ])
    (ht : ∀ k, IsOpen {g | PadicInt.toZModPow k (Multiplicative.toAdd (t g)) = 0}) :
    Continuous t := by
  suffices h : Continuous fun g => Multiplicative.toAdd (t g) from continuous_ofAdd.comp h
  refine continuous_iff_continuousAt.2 fun g => Metric.tendsto_nhds.2 fun ε hε => ?_
  obtain ⟨k, hk⟩ := PadicInt.exists_pow_neg_lt ℓ hε
  have hopen : IsOpen ((fun x => g⁻¹ * x) ⁻¹'
      {g | PadicInt.toZModPow k (Multiplicative.toAdd (t g)) = 0}) :=
    (ht k).preimage (continuous_const.mul continuous_id)
  filter_upwards [hopen.mem_nhds (by simp)] with x hx
  refine dist_lt_of_sub_mem_span_pow hk le_rfl ?_
  rw [← PadicInt.ker_toZModPow, RingHom.mem_ker]
  have : Multiplicative.toAdd (t (g⁻¹ * x)) =
      Multiplicative.toAdd (t x) - Multiplicative.toAdd (t g) := by
    rw [map_mul, map_inv, toAdd_mul, toAdd_inv, neg_add_eq_sub]
  rw [← this]
  exact hx

/-- **The image of a compact group in `ℤ_ℓ` is generated by one element.**  For a continuous
homomorphism `t` from a compact group to `ℤ_ℓ`, there is `T` with `t σ ∈ ℤ_ℓ · t T` for every
`σ`: the image is a closed subgroup of `ℤ_ℓ`, hence an ideal, hence principal. -/
theorem exists_forall_exists_eq_mul_of_compactSpace {G : Type*} [Group G] [TopologicalSpace G]
    [CompactSpace G] (t : G →* Multiplicative ℤ_[ℓ]) (ht : Continuous t) :
    ∃ T : G, ∀ σ : G, ∃ c : ℤ_[ℓ], Multiplicative.toAdd (t σ) = c * Multiplicative.toAdd (t T) := by
  let f : G → ℤ_[ℓ] := fun g => Multiplicative.toAdd (t g)
  have hf : Continuous f := continuous_toAdd.comp ht
  have hclosed : IsClosed (Set.range f) := (isCompact_range hf).isClosed
  have hadd : ∀ x ∈ Set.range f, ∀ y ∈ Set.range f, x + y ∈ Set.range f := by
    rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    exact ⟨a * b, by simp [f, toAdd_mul]⟩
  have hnsmul : ∀ x ∈ Set.range f, ∀ n : ℕ, (n : ℤ_[ℓ]) * x ∈ Set.range f := by
    rintro _ ⟨a, rfl⟩ n
    exact ⟨a ^ n, by simp [f, toAdd_pow, nsmul_eq_mul]⟩
  have hsmul : ∀ x ∈ Set.range f, ∀ c : ℤ_[ℓ], c * x ∈ Set.range f := by
    intro x hx c
    refine hclosed.mem_of_tendsto (f := fun n : ℕ => ((c.appr n : ℕ) : ℤ_[ℓ]) * x)
      (b := Filter.atTop) ?_
      (Filter.Eventually.of_forall fun n => hnsmul x hx _)
    refine Filter.Tendsto.mul_const x ?_
    refine Metric.tendsto_atTop.2 fun ε hε => ?_
    obtain ⟨k, hk⟩ := PadicInt.exists_pow_neg_lt ℓ hε
    exact ⟨k, fun n hn => by
      rw [dist_comm]
      exact dist_lt_of_sub_mem_span_pow hk hn (PadicInt.appr_spec n c)⟩
  let Iδ : Ideal ℤ_[ℓ] :=
    { carrier := Set.range f
      add_mem' := fun hx hy => hadd _ hx _ hy
      zero_mem' := ⟨1, by simp [f]⟩
      smul_mem' := fun c x hx => hsmul x hx c }
  obtain ⟨g, hg⟩ := (IsPrincipalIdealRing.principal Iδ).principal
  obtain ⟨T, rfl⟩ : g ∈ Iδ := hg ▸ Ideal.mem_span_singleton_self g
  refine ⟨T, fun σ => ?_⟩
  have hσ : f σ ∈ Iδ := ⟨σ, rfl⟩
  rw [hg] at hσ
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.1 hσ
  exact ⟨c, hc.symm⟩

end Stacks.FundamentalGroup
