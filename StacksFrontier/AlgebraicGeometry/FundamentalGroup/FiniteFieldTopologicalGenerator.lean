module

public import Mathlib.FieldTheory.Finite.GaloisField
public import Mathlib.FieldTheory.KrullTopology
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.GeometricFundamentalExactSequence
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.GaloisCategory.FieldFundamentalGroup
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.EtaleFundamental.FundamentalGroupTheorem

/-!
# A topological generator of the arithmetic quotient of `π₁` over a finite field

Let `k` be a finite field. Every open subgroup of the absolute Galois group of `k` containing the
Frobenius `a ↦ a ^ #k` is everything: on the normal closure of a finite subextension the Galois
group is cyclic, generated by the Frobenius. Through the Galois description of `π₁(Spec k)`
(Stacks 0BNE (2)) and the change of base point (Stacks 0BND (2)), `π₁(Spec k, z)` has an element
lying in no proper open subgroup, at every geometric point `z`.

For a quasi-compact quasi-separated scheme `X ⟶ Spec k` with connected base change to an
algebraic closure, the exact sequence `1 → π₁(X_k̄) → π₁(X) → π₁(Spec k) → 1` (Stacks 0BTX)
then gives `σ ∈ π₁(X)` such that every open subgroup containing `σ` and the geometric
fundamental group is all of `π₁(X)`.

## Main results

* `FiniteField.eq_top_of_frobenius_mem`.
* `AlgebraicGeometry.exists_forall_openSubgroup_eq_top_spec_finite`.
* `AlgebraicGeometry.exists_forall_openSubgroup_eq_top_of_finite`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace FiniteField

/-- **An open subgroup of the Galois group of an algebraic extension of a finite field containing
the Frobenius is everything.** -/
theorem eq_top_of_frobenius_mem (K L : Type*) [Field K] [Fintype K] [Field L] [Algebra K L]
    [Algebra.IsAlgebraic K L] (U : Subgroup Gal(L/K)) (hU : IsOpen (U : Set Gal(L/K)))
    (hF : frobeniusAlgEquivOfAlgebraic K L ∈ U) : U = ⊤ := by
  classical
  refine eq_top_iff.mpr fun τ _ => ?_
  obtain ⟨E, hE, hEU⟩ := (krullTopology_mem_nhds_one_iff K L (U : Set Gal(L/K))).mp
    (hU.mem_nhds U.one_mem)
  have : Finite E := Module.finite_of_finite K
  have hrestr : ∀ σ : Gal(L/K), ∀ x : E, ((AlgEquiv.restrictNormalHom E σ) x : L) = σ x :=
    fun σ x => AlgEquiv.restrictNormal_commutes σ E x
  have hfrob : AlgEquiv.restrictNormalHom E (frobeniusAlgEquivOfAlgebraic K L) =
      frobeniusAlgEquivOfAlgebraic K E := by
    ext x
    rw [hrestr]
    simp
  obtain ⟨m, hm⟩ := (bijective_frobeniusAlgEquivOfAlgebraic_pow K E).2
    (AlgEquiv.restrictNormalHom E τ)
  set ρ := (frobeniusAlgEquivOfAlgebraic K L) ^ (m : ℕ)
  have hρ : AlgEquiv.restrictNormalHom E ρ = AlgEquiv.restrictNormalHom E τ := by
    rwa [map_pow, hfrob]
  have hfix : ρ⁻¹ * τ ∈ E.fixingSubgroup := by
    intro ⟨x, hx⟩
    have h1 : ρ x = τ x := by
      simpa only [hrestr] using congrArg (fun φ : Gal(E/K) => (φ ⟨x, hx⟩ : L)) hρ
    change (ρ⁻¹ * τ) x = x
    rw [AlgEquiv.mul_apply, ← h1]
    exact ρ.symm_apply_apply x
  have hρU : ρ ∈ U := U.pow_mem hF _
  simpa using U.mul_mem hρU (hEU hfix)

end FiniteField

namespace AlgebraicGeometry

/-- **`π₁(Spec k)` of a finite field has an element lying in no proper open subgroup**, at every
geometric point. -/
theorem exists_forall_openSubgroup_eq_top_spec_finite (k : Type u) [Field k] [Finite k]
    (z : GeometricPoint (Spec (.of k))) :
    ∃ γ : EtaleFundamentalGroup (Spec (.of k)) z,
      ∀ U : OpenSubgroup (EtaleFundamentalGroup (Spec (.of k)) z), γ ∈ U → U = ⊤ := by
  classical
  have := Fintype.ofFinite k
  set Ω := AlgebraicClosure k
  let g := galoisEquivEtaleFundamentalGroup k Ω Ω
  obtain ⟨e⟩ := nonempty_etaleFundamentalGroupContinuousMulEquiv (Spec (.of k))
    (algebraicClosureGeometricPoint k Ω) z
  refine ⟨e (g (FiniteField.frobeniusAlgEquivOfAlgebraic k Ω)), fun U hU => ?_⟩
  let V : Subgroup Gal(Ω/k) := (U.toSubgroup.comap e.toMonoidHom).comap g.toMonoidHom
  have hV : IsOpen (V : Set Gal(Ω/k)) :=
    (U.isOpen.preimage e.continuous).preimage g.continuous
  ext γ
  simp only [OpenSubgroup.mem_top, iff_true]
  have : g.symm (e.symm γ) ∈ V :=
    FiniteField.eq_top_of_frobenius_mem k Ω V hV hU ▸ Subgroup.mem_top _
  have h2 : e (g (g.symm (e.symm γ))) = γ := by
    rw [ContinuousMulEquiv.apply_symm_apply, ContinuousMulEquiv.apply_symm_apply]
  rw [← h2]
  exact this

/-- **An element of `π₁(X)` generating `π₁(X)` modulo the geometric fundamental group.** For a
quasi-compact quasi-separated scheme `f : X ⟶ Spec k` over a finite field whose base change to
an algebraic closure `k̄` is connected, there is `σ ∈ π₁(X)` such that every open subgroup of
`π₁(X)` containing `σ` and the image of `π₁(X_k̄)` is all of `π₁(X)`. -/
theorem exists_forall_openSubgroup_eq_top_of_finite (k kbar : Type u) [Field k] [Finite k]
    [Field kbar] [Algebra k kbar] [IsAlgClosure k kbar] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [CompactSpace X] [QuasiSeparatedSpace X]
    [ConnectedSpace ↥(pullback f (Spec.map (CommRingCat.ofHom (algebraMap k kbar))))]
    (x : GeometricPoint (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k kbar))))) :
    letI : ConnectedSpace ↥X :=
      connectedSpace_of_connectedSpace_pullback_specMap_algebraMap k kbar f
    ∃ σ : EtaleFundamentalGroup X (x.map (pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap k kbar))))),
      ∀ H : OpenSubgroup (EtaleFundamentalGroup X (x.map (pullback.fst f
          (Spec.map (CommRingCat.ofHom (algebraMap k kbar)))))),
        (etaleFundamentalGroupMap (pullback.fst f
          (Spec.map (CommRingCat.ofHom (algebraMap k kbar)))) x).toMonoidHom.range ≤ H →
          σ ∈ H → H = ⊤ := by
  let : ConnectedSpace ↥X := connectedSpace_of_connectedSpace_pullback_specMap_algebraMap k kbar f
  obtain ⟨-, -, hrange, hsurj, hquot⟩ :=
    topologicalShortExact_etaleFundamentalGroupMap_isAlgClosure k kbar f x
  set φ := etaleFundamentalGroupMap f (x.map (pullback.fst f
    (Spec.map (CommRingCat.ofHom (algebraMap k kbar)))))
  obtain ⟨γ, hγ⟩ := exists_forall_openSubgroup_eq_top_spec_finite k
    ((x.map (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k kbar))))).map f)
  obtain ⟨σ, hσ⟩ := hsurj γ
  refine ⟨σ, fun H hNH hσH => ?_⟩
  rw [hrange] at hNH
  have hpre : φ.toMonoidHom ⁻¹' (H.toSubgroup.map φ.toMonoidHom : Set _) = (H : Set _) := by
    ext g
    simp only [Set.mem_preimage, SetLike.mem_coe, Subgroup.mem_map]
    refine ⟨?_, fun hg => ⟨g, hg, rfl⟩⟩
    rintro ⟨h, hh, hgh⟩
    have hk : h⁻¹ * g ∈ φ.toMonoidHom.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hgh, inv_mul_cancel]
    simpa using H.mul_mem hh (hNH hk)
  have hopen : IsOpen ((H.toSubgroup.map φ.toMonoidHom : Subgroup (EtaleFundamentalGroup
      (Spec (.of k)) ((x.map (pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap k kbar))))).map f))) : Set (EtaleFundamentalGroup
      (Spec (.of k)) ((x.map (pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap k kbar))))).map f))) := by
    rw [← hquot.isOpen_preimage]
    change IsOpen (φ.toMonoidHom ⁻¹' _)
    rw [hpre]
    exact H.isOpen
  have htop := hγ ⟨H.toSubgroup.map φ.toMonoidHom, hopen⟩ ⟨σ, hσH, hσ⟩
  ext g
  simp only [OpenSubgroup.mem_top, iff_true]
  have : φ g ∈ (⟨H.toSubgroup.map φ.toMonoidHom, hopen⟩ : OpenSubgroup _) := by
    rw [htop]
    trivial
  have h2 : g ∈ φ.toMonoidHom ⁻¹' (H.toSubgroup.map φ.toMonoidHom : Set _) := this
  rwa [hpre] at h2

end AlgebraicGeometry
