module

public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.ModuleAlgebraData
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.FiniteAlgebraization.AdicSystem
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionFullyFaithful.SectionsComplete
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CompletionFullyFaithful.TowerHoms

/-!
# The relative spectrum of an algebra whose quotient by a closed subscheme is given

Let `z : N ⟶ S` be a closed immersion and `c : C ⟶ N` an affine morphism. Let `𝒢` be a
quasi-coherent `𝒪_S`-module carrying a commutative unital algebra structure, and let
`p : 𝒢 ⟶ (C ⟶ S)_* 𝒪_C` be multiplicative and unital, surjective on every affine open with kernel
generated by the ideal of `N`. Then the relative spectrum `U = Spec_S(𝒢)` is affine over `S`, its
direct image of the structure sheaf is `𝒢`, and `C = U ×_S N`. This is the step of the proof of
[Stacks, Tag 0EK1] which recognises the restriction to `Y` of the relative spectrum of the
algebraized algebra as the given finite étale cover.

## Main results

* `Stacks.FundamentalGroup.exists_isPullback_of_algebraQuotient` — the statement above.
* `Stacks.FundamentalGroup.unit_comp_pushforward_surjective_ker` — the adjunction unit of a
  closed immersion, followed by the direct image of an isomorphism, is surjective on affine
  opens with kernel generated by the ideal of the closed immersion.

## References

* [Stacks Project, Tag 0EK1](https://stacks.math.columbia.edu/tag/0EK1)
* [Stacks Project, Tag 01SA](https://stacks.math.columbia.edu/tag/01SA)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry
open Stacks.AffineAlgebraEquivalence
open Stacks.RelativeSpec (AlgebraSheaf)
open scoped TensorProduct

universe u

namespace Stacks.FundamentalGroup

/-- An element of `𝔞 • M` lands in the extension `𝔞 S` of an ideal along a ring map
`φ : R ⟶ S` under any additive map `g : M ⟶ S` with `g (r • m) = φ r * g m`. -/
private theorem mem_map_of_mem_smul_top {R S M : Type*} [CommRing R] [CommRing S]
    [AddCommGroup M] [Module R M] (φ : R →+* S) (𝔞 : Ideal R) (g : M →+ S)
    (hsmul : ∀ (r : R) (m : M), g (r • m) = φ r * g m) {x : M}
    (hx : x ∈ 𝔞 • (⊤ : Submodule R M)) : g x ∈ Ideal.map φ 𝔞 := by
  refine Submodule.smul_induction_on hx (fun r hr m _ => ?_) (fun x y hx hy => ?_)
  · rw [hsmul]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem φ hr)
  · rw [map_add]
    exact add_mem hx hy

/-- **The relative spectrum of an algebra whose quotient by a closed subscheme is given.** -/
public theorem exists_isPullback_of_algebraQuotient {S N C : Scheme.{u}} (z : N ⟶ S)
    [IsClosedImmersion z] (c : C ⟶ N) [IsAffineHom c] (G : S.Modules) [G.IsQuasicoherent]
    (d : ModuleAlgebraData G)
    (p : G ⟶ AlgebraSheaf.underlyingModule (pushforwardAlgebra (c ≫ z)))
    (hsurj : ∀ U : S.affineOpens, Function.Surjective (p.app U.1))
    (hker : ∀ (U : S.affineOpens) (s : Γ(G, U.1)), p.app U.1 s = 0 →
      s ∈ z.ker.ideal U • (⊤ : Submodule Γ(S, U.1) Γ(G, U.1)))
    (hunit : ∀ U : S.Opensᵒᵖ, p.val.app U (d.unit.val.app U (1 : Γ(S, U.unop))) =
      (1 : Γ(C, (c ≫ z) ⁻¹ᵁ U.unop)))
    (hmul : ∀ (U : S.Opensᵒᵖ) (x y : G.val.obj U),
      p.val.app U (d.mul.app U (x ⊗ₜ[Γ(S, U.unop)] y)) =
        Mul.mul (α := Γ(C, (c ≫ z) ⁻¹ᵁ U.unop)) (p.val.app U x) (p.val.app U y)) :
    ∃ (U : Scheme.{u}) (π : U ⟶ S) (_ : IsAffineHom π)
      (_ : AlgebraSheaf.underlyingModule (pushforwardAlgebra π) ≅ G) (g : C ⟶ U),
      IsPullback g c π z := by
  let B := algebraSheafOfModule G d
  let eB := algebraSheafOfModuleIso G d
  have : AlgebraSheaf.IsQuasicoherent B :=
    ObjectProperty.IsClosedUnderIsomorphisms.of_iso
      (P := SheafOfModules.isQuasicoherent S.ringCatSheaf) eB.symm inferInstance
  let φ0 : AlgebraSheaf.underlyingModule B ⟶
      AlgebraSheaf.underlyingModule (pushforwardAlgebra (c ≫ z)) := eB.hom ≫ p
  let φ : B ⟶ pushforwardAlgebra (c ≫ z) :=
    AlgebraSheaf.homOfMultiplicative φ0 (fun U => hunit U) (fun U x y => hmul U x y)
  have hsurjB : ∀ U : S.affineOpens, Function.Surjective (φ.right.hom.app (op U.1)) :=
    fun U => hsurj U
  have hkerB : ∀ U : S.affineOpens, RingHom.ker (φ.right.hom.app (op U.1)).hom ≤
      Ideal.map (B.hom.hom.app (op U.1)).hom (z.ker.ideal U) := by
    intro U x hx
    let g : Γ(G, U.1) →+ B.right.obj.obj (op U.1) :=
      { toFun := fun x => x, map_zero' := rfl, map_add' := fun _ _ => rfl }
    exact mem_map_of_mem_smul_top (R := Γ(S, U.1)) (M := Γ(G, U.1))
      (B.hom.hom.app (op U.1)).hom (z.ker.ideal U) g
      (fun r m => (@Algebra.smul_def _ _ _ (d.toPresheafAlgebraData.commRing (op U.1)).toSemiring
        (d.toPresheafAlgebraData.algebra (op U.1)) r m))
      (hker U x hx)
  let w := relativeSpecToBase B
  let P := pushforwardAlgebraIso B
  let kO : Over.mk (c ≫ z) ⟶ Over.mk w :=
    (Stacks.AlgebraPullbackQcoh.overHomEquiv (Over.mk (c ≫ z)) (Over.mk w)).symm (P.hom ≫ φ)
  have hkO : pushforwardAlgebraMap kO = P.hom ≫ φ :=
    (Stacks.AlgebraPullbackQcoh.overHomEquiv (Over.mk (c ≫ z)) (Over.mk w)).apply_symm_apply _
  have hk : kO.left ≫ w = c ≫ z := Over.w kO
  have happ : ∀ U : S.affineOpens,
      kO.left.appLE (w ⁻¹ᵁ U.1) ((c ≫ z) ⁻¹ᵁ U.1)
          (AdicFiniteAlgebra.preimage_le_of_comp hk U.1) =
        P.hom.right.hom.app (op U.1) ≫ φ.right.hom.app (op U.1) := by
    intro U
    have h := pushforwardAlgebraMap_app kO U.1 (preimage_le_preimage_preimage kO U.1)
    rw [hkO] at h
    exact h.symm
  have hPb : ∀ U : S.affineOpens, Function.Bijective (P.hom.right.hom.app (op U.1)) := fun U =>
    ⟨Function.LeftInverse.injective (AdicFiniteAlgebra.iso_inv_hom_app P U.1),
      Function.RightInverse.surjective (AdicFiniteAlgebra.iso_hom_inv_app P U.1)⟩
  have hpb : IsPullback kO.left c w z := by
    refine AdicFiniteAlgebra.isPullback_of_appLE z w (c ≫ z) c kO.left rfl hk
      (fun U => ?_) (fun U => ?_)
    · rw [happ U]
      exact (hsurjB U).comp (hPb U).2
    · intro x hx
      rw [happ U, RingHom.mem_ker] at hx
      have h1 : P.hom.right.hom.app (op U.1) x ∈ RingHom.ker (φ.right.hom.app (op U.1)).hom := hx
      have h2 := Ideal.mem_map_of_mem (P.inv.right.hom.app (op U.1)).hom (hkerB U h1)
      rw [AdicFiniteAlgebra.iso_inv_hom_app P U.1 x] at h2
      have h4 : B.hom.hom.app (op U.1) ≫ P.inv.right.hom.app (op U.1) = w.app U.1 :=
        congrArg (fun ψ => ψ.hom.app (op U.1)) (Under.w P.inv)
      have h5 := Ideal.map_map (B.hom.hom.app (op U.1)).hom (P.inv.right.hom.app (op U.1)).hom
        (I := z.ker.ideal U)
      have h7 : Ideal.map (P.inv.right.hom.app (op U.1)).hom
          (Ideal.map (B.hom.hom.app (op U.1)).hom (z.ker.ideal U)) =
            Ideal.map (w.app U.1).hom (z.ker.ideal U) :=
        h5.trans (congrArg (fun φ => Ideal.map φ (z.ker.ideal U))
          (congrArg CommRingCat.Hom.hom h4))
      exact h7 ▸ h2
  exact ⟨relativeSpec B, w, inferInstance, AlgebraSheaf.underlyingModuleIso P ≪≫ eB, kO.left,
    hpb⟩

/-- **The adjunction unit of a closed immersion, followed by the direct image of an
isomorphism, is a quotient map by the ideal of the closed immersion** on every affine open. -/
public theorem unit_comp_pushforward_surjective_ker {S N : Scheme.{u}} (z : N ⟶ S)
    [IsClosedImmersion z] (G : S.Modules) [G.IsQuasicoherent] (M : N.Modules)
    (φ : (Scheme.Modules.pullback z).obj G ≅ M) (U : S.affineOpens) :
    Function.Surjective
        (((Scheme.Modules.pullbackPushforwardAdjunction z).unit.app G ≫
          (Scheme.Modules.pushforward z).map φ.hom).app U.1) ∧
      ∀ s : Γ(G, U.1), ((Scheme.Modules.pullbackPushforwardAdjunction z).unit.app G ≫
          (Scheme.Modules.pushforward z).map φ.hom).app U.1 s = 0 →
        s ∈ z.ker.ideal U • (⊤ : Submodule Γ(S, U.1) Γ(G, U.1)) := by
  let e := Stacks.Algebraization.idealQuotientPushforwardIso z.ker 1 G z (by rw [pow_one])
  let π := cokernel.π (C := S.Modules) (Stacks.Algebraization.idealPowerMultiple z.ker 1 G).ι
  let ψ := e.hom ≫ (Scheme.Modules.pushforward z).map φ.hom
  have hψ : IsIso ψ := inferInstance
  have hfac : (Scheme.Modules.pullbackPushforwardAdjunction z).unit.app G ≫
      (Scheme.Modules.pushforward z).map φ.hom = π ≫ ψ :=
    ((congrArg (· ≫ (Scheme.Modules.pushforward z).map φ.hom)
      (Stacks.Algebraization.idealQuotientPushforwardMap_π z.ker 1 G z
        (by rw [pow_one]))).symm.trans (Category.assoc _ _ _))
  have hπ : Function.Surjective (π.app U.1) :=
    surjective_app_of_epi_of_isAffineOpen π U.2
  have hbij := Stacks.Algebraization.bijective_app_of_isIso ψ U.1
  have happ : ∀ s, ((Scheme.Modules.pullbackPushforwardAdjunction z).unit.app G ≫
      (Scheme.Modules.pushforward z).map φ.hom).app U.1 s = ψ.app U.1 (π.app U.1 s) :=
    fun s => congrArg (fun χ : G ⟶ (Scheme.Modules.pushforward z).obj M => χ.app U.1 s) hfac
  refine ⟨fun y => ?_, fun s hs => ?_⟩
  · obtain ⟨s, hs⟩ := (hbij.2.comp hπ) y
    exact ⟨s, (happ s).trans hs⟩
  have h0 : π.app U.1 s = 0 :=
    hbij.1 (((happ s).symm.trans hs).trans (map_zero (ψ.app U.1).hom).symm)
  have h1 := (Stacks.Algebraization.cokernel_π_app_eq_zero_iff _ _ _ s).1 h0
  rwa [Stacks.Algebraization.idealPowerMultiple_toSubmodule_obj_affine, pow_one] at h1

end Stacks.FundamentalGroup

end
