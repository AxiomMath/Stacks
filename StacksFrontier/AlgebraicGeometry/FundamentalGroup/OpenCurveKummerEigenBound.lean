/-!
# Frobenius eigenvectors in `H¹(Y_k̄, μ_n)` of an open curve over a finite field

Let `Ȳ` be a smooth proper geometrically irreducible curve over a finite field `k₀` with `q`
elements, `Y ⊆ Ȳ` a nonempty open subcurve, `K` an algebraic closure of `k₀` and `F` its
Frobenius. The twist `σ = id × Spec(F)` of `Ȳ_K` permutes the finitely many points of
`Ȳ_K ∖ Y_K`, so a power `σᵐ` (the twist by `Fᵐ`) fixes them. This file shows that the
`qᵐ`-eigenvectors of `σᵐ` on `H¹(Y_K, μ_{ℓᵉ})` are bounded independently of `e`, for `ℓ` prime
to `q`, by the Kummer sequence `𝒪^*(Y_K) →δ H¹(Y_K, μ_n) →ι Pic(Y_K)[n]`:

* through `ι`: `Pic(Ȳ_K) → Pic(Y_K)` is onto with kernel generated by the points at infinity,
  fixed by `σᵐ`, so the eigenvectors of `Pic(Y_K)[n]` are at most those of `Pic(Ȳ_K)[n]`
  (bounded by the Weil pairing,
  `Stacks.Picard.exists_forall_encard_torsion_eigen_frobenius_pow_le`)
  times the finite `Pic(Y_K)[qᵐ - 1]`;
* through `δ`: the divisor at infinity embeds `𝒪^*(Y_K)/K^*` in a free group of finite rank on
  which `σᵐ` acts trivially, so the eigenvectors in the image of `δ` are at most
  `#M/(qᵐ - 1)M` for a finitely generated `M`.

## Main results

* `Stacks.Kummer.exists_forall_encard_eigen_h1RootsOfUnity_le`: the bound.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry
  Stacks.Cohomology.Torsors Stacks.EtaleCohomology

universe u

namespace Stacks.Kummer

section Twist

variable (R K : Type u) [Field R] [Field K] [Algebra R K] [DecidableEq K]
  (X : Over (Spec (.of R)))

omit [DecidableEq K] in
/-- **A Galois twist acts on constants through the automorphism**: for `c ∈ K`, the twist
`id_X × Spec(τ)` of `X_K` sends the constant function `c` to `τ c`. -/
theorem galoisTwist_appTop_baseRingMap (τ : K ≃ₐ[R] K) (c : K) :
    (Stacks.Picard.galoisTwist R K X τ).appTop.hom
        (baseRingMap (pullback.snd X.hom (spectrumMap R K)) (𝟙 _) c) =
      baseRingMap (pullback.snd X.hom (spectrumMap R K)) (𝟙 _) (τ c) := by
  set σ := Stacks.Picard.galoisTwist R K X τ
  set fS := pullback.snd X.hom (spectrumMap R K)
  have hsnd : σ ≫ fS = fS ≫ specMapAlgAut R K τ := Stacks.Picard.galoisTwist_comp_snd R K X τ
  change ((Scheme.ΓSpecIso (.of K)).inv ≫ fS.appTop ≫
      Scheme.Hom.appTop (𝟙 (pullback X.hom (spectrumMap R K))) ≫ σ.appTop).hom c =
    ((Scheme.ΓSpecIso (.of K)).inv ≫ fS.appTop ≫
      Scheme.Hom.appTop (𝟙 (pullback X.hom (spectrumMap R K)))).hom (τ c)
  simp only [Scheme.Hom.id_appTop, Category.id_comp, Category.comp_id]
  rw [← Scheme.Hom.comp_appTop, hsnd, Scheme.Hom.comp_appTop, specMapAlgAut,
    ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality, Category.assoc, CommRingCat.hom_comp,
    RingHom.comp_apply]
  rfl

omit [DecidableEq K] in
/-- The twist by `τ` is an isomorphism, with inverse the twist by `τ⁻¹`. -/
theorem isIso_galoisTwist_of_algEquiv (τ : K ≃ₐ[R] K) :
    IsIso (Stacks.Picard.galoisTwist R K X τ) :=
  ⟨Stacks.Picard.galoisTwist R K X τ⁻¹, by
    rw [← Stacks.Picard.galoisTwist_mul, mul_inv_cancel, Stacks.Picard.galoisTwist_one], by
    rw [← Stacks.Picard.galoisTwist_mul, inv_mul_cancel, Stacks.Picard.galoisTwist_one]⟩

variable {X} {Y : Over (Spec (.of R))} (j : X ⟶ Y)

/-- The base change `X_K ⟶ Y_K` of a morphism over `Spec R`. -/
abbrev baseChangeMap : pullback X.hom (spectrumMap R K) ⟶ pullback Y.hom (spectrumMap R K) :=
  pullback.map _ _ _ _ j.left (𝟙 _) (𝟙 _) (by simp) (by simp)

omit [DecidableEq K] in
/-- **Base change commutes with the Galois twists.** -/
theorem galoisTwist_comp_baseChangeMap (τ : K ≃ₐ[R] K) :
    Stacks.Picard.galoisTwist R K X τ ≫ baseChangeMap R K j =
      baseChangeMap R K j ≫ Stacks.Picard.galoisTwist R K Y τ := by
  refine pullback.hom_ext ?_ ?_
  · rw [Category.assoc, Category.assoc, Stacks.Picard.galoisTwist_comp_fst, pullback.lift_fst,
      ← Category.assoc, Stacks.Picard.galoisTwist_comp_fst]
  · rw [Category.assoc, Category.assoc, Stacks.Picard.galoisTwist_comp_snd, pullback.lift_snd,
      Category.comp_id, ← Category.assoc, Stacks.Picard.galoisTwist_comp_snd, pullback.lift_snd,
      Category.comp_id]

end Twist

section KummerCount

variable (S : Scheme.{u}) [HasExt.{u + 1} (Sheaf S.smallEtaleTopology AddCommGrpCat.{u + 1})]
  (σ : S ⟶ S)

/-- **Eigenvectors in `H¹(S, μ_n)` through the Kummer sequence.** Let `σ` be an endomorphism of
a scheme `S` on which `n` is invertible, and `φ` a homomorphism from the invertible functions to
a torsion-free group, invariant under `σ`, whose kernel consists of `n`-th powers. Then the
`q`-eigenvectors of `σ^*` on `H¹(S, μ_n)` are at most the `n`-torsion `q`-eigenvectors of `σ^*` on
`Pic(S)` times `#φ(𝒪^*(S)) / (q - 1)`. -/
theorem encard_eigen_h1RootsOfUnity_le {n : ℕ} (hn0 : n ≠ 0) (hS : IsUnit ((n : ℕ) : Γ(S, ⊤)))
    (q : ℤ) {F : Type*} [AddCommGroup F] [IsAddTorsionFree F] (φ : Additive Γ(S, ⊤)ˣ →+ F)
    (hφ : ∀ u : Γ(S, ⊤)ˣ, φ (Additive.ofMul u) = 0 → ∃ v : Γ(S, ⊤)ˣ, v ^ n = u)
    (hσφ : ∀ u : Γ(S, ⊤)ˣ,
      φ (Additive.ofMul (Units.map σ.appTop.hom.toMonoidHom u)) = φ (Additive.ofMul u)) :
    {c : Sheaf.H.{u + 1} (rootsOfUnitySheaf.{u, 0} S n) 1 |
        rootsOfUnityPullbackMap.{u, 0, u + 1} σ n 1 c = q • c}.encard ≤
      {z : Stacks.Picard.ofScheme S | (n : ℤ) • z = 0 ∧
          Stacks.Picard.schemePullbackClassHom σ z = q • z}.encard *
        (Set.univ : Set (φ.range ⧸ (zsmulAddGroupHom (α := φ.range) (q - 1)).range)).encard := by
  set e := sheafHZeroMultiplicativeAddEquiv.{u, 0, u + 1} S
  set σU := multiplicativeRestriction.{u, 0, u + 1} σ 0
  set δ := kummerδ.{u + 1, u, 0} S hn0 hS 0
  set ι := h1RootsOfUnityToPicard.{u + 1, 0, u} S n
  have hδσ : ∀ x, δ (σU x) = rootsOfUnityPullbackMap.{u, 0, u + 1} σ n 1 (δ x) := fun x =>
    (etaleCohomologyRestrictionMap_kummerExtClass.{u, 0, u + 1} σ hn0 hS 0 1 rfl x).symm
  have hexact : ∀ a, ι a = 0 → ∃ x, δ x = a := by
    intro a ha
    have h0 : Sheaf.H.map (rootsOfUnityι.{u, 0} S n) 1 a = 0 :=
      (AddEquiv.map_eq_zero_iff (etaleH1MultiplicativeAddEquivPicard.{u + 1, 0, u} S)).1 ha
    exact (mem_range_kummerδ_iff S hn0 hS 0 a).2 h0
  refine (Stacks.EigenvectorCount.encard_eigen_le_mul_of_exact (P := Stacks.Picard.ofScheme S) σU
    (rootsOfUnityPullbackMap.{u, 0, u + 1} σ n 1) (Stacks.Picard.schemePullbackClassHom σ) δ ι
    hδσ hexact q).trans (mul_le_mul' ?_ ?_)
  · refine Set.encard_le_encard ?_
    rintro _ ⟨c, hc, rfl⟩
    refine ⟨?_, ?_⟩
    · rw [← map_zsmul, natCast_zsmul, nsmul_sheafH_rootsOfUnity_eq_zero, map_zero]
    · rw [← h1RootsOfUnityToPicard_naturality, (hc : _ = q • c), map_zsmul]
  · have hδn : ∀ x, δ (n • x) = 0 := fun x =>
      (mem_range_sheafH_map_powMap_iff S hn0 hS 0 (n • x)).1 ⟨x, sheafH_map_powMap S n 0 x⟩
    have hδ0 : ∀ x, δ x = 0 → ∃ y, n • y = x := fun x hx => by
      obtain ⟨y, hy⟩ := (mem_range_sheafH_map_powMap_iff S hn0 hS 0 x).2 hx
      exact ⟨y, (sheafH_map_powMap S n 0 y).symm.trans hy⟩
    have hφ' : ∀ x, (φ.comp e.toAddMonoidHom) x = 0 → ∃ y, n • y = x := fun x hx => by
      obtain ⟨v, hv⟩ := hφ (Additive.toMul (e x)) hx
      refine ⟨e.symm (Additive.ofMul v), ?_⟩
      rw [← map_nsmul, ← ofMul_pow, hv]
      exact e.symm_apply_apply x
    have hσ' : ∀ x, (φ.comp e.toAddMonoidHom) (σU x) = (φ.comp e.toAddMonoidHom) x := fun x => by
      change φ (e (σU x)) = φ (e x)
      rw [sheafHZeroMultiplicativeAddEquiv_multiplicativeRestriction]
      exact hσφ (Additive.toMul (e x))
    have h := Stacks.EigenvectorCount.encard_image_eigen_le_of_ker_le δ hn0 hδn hδ0
      (φ.comp e.toAddMonoidHom) hφ' σU hσ' q
    have hrange : (φ.comp e.toAddMonoidHom).range = φ.range := by
      rw [AddMonoidHom.range_comp, AddMonoidHom.range_eq_top.2 e.surjective,
        ← AddMonoidHom.range_eq_map]
    rw [hrange] at h
    exact h

/-- **Eigenvectors in `H¹(S, μ_n)` of an open subcurve `S` of a smooth proper curve `C` over an
algebraically closed field**, for an automorphism `σ` of `C` restricting to `σS` on `S` and fixing
the points of `C ∖ S`: at most the `n`-torsion `Q`-eigenvectors of `σ^*` on `Pic(C)` times three
factors which do not depend on `n`. -/
theorem encard_eigen_h1RootsOfUnity_le_of_isOpenImmersion {K : Type u} [Field K] [IsAlgClosed K]
    {C : Scheme.{u}} (gC : C ⟶ Spec (.of K)) (gS : S ⟶ Spec (.of K)) [IsCurve K gC] [Smooth gC]
    [IsProper gC] [IsCurve K gS] [Smooth gS] (jK : S ⟶ C) [IsOpenImmersion jK]
    [IsLocallyNoetherian C] [AlgebraicGeometry.IsNoetherian C] [IsLocallyNoetherian S]
    [AlgebraicGeometry.IsNoetherian S] (σ' : C ⟶ C) [IsIso σ'] [IsIso σ]
    (hcomm : σ ≫ jK = jK ≫ σ')
    (hfix : ∀ b : closedPoints C, b.1 ∉ Set.range jK.base → σ'.base b.1 = b.1)
    {n : ℕ} (hn0 : n ≠ 0) (hnK : IsUnit (n : K)) (Q : ℤ) :
    {c : Sheaf.H.{u + 1} (rootsOfUnitySheaf.{u, 0} S n) 1 |
        rootsOfUnityPullbackMap.{u, 0, u + 1} σ n 1 c = Q • c}.encard ≤
      {w : Stacks.Picard.ofScheme C | (n : ℤ) • w = 0 ∧
          Stacks.Picard.schemePullbackClassHom σ' w = Q • w}.encard *
        ((Set.univ : Set (({b : closedPoints C // b.1 ∉ Set.range jK.base} →₀ ℤ) ⧸
            (zsmulAddGroupHom (α := {b : closedPoints C // b.1 ∉ Set.range jK.base} →₀ ℤ)
              (Q - 1)).range)).encard *
          {w : Stacks.Picard.ofScheme C | (Q - 1) • w = 0}.encard) *
        (Set.univ : Set ((boundaryUnitDivisor jK).range ⧸
          (zsmulAddGroupHom (α := (boundaryUnitDivisor jK).range) (Q - 1)).range)).encard := by
  have : IsNormal C := isNormal_of_isRegular C (isRegular_of_smooth_over_field gC)
  have hS : IsUnit ((n : ℕ) : Γ(S, ⊤)) := isUnit_natCast_globalSections S n gS hnK
  have hφ : ∀ u : Γ(S, ⊤)ˣ, boundaryUnitDivisor jK (Additive.ofMul u) = 0 →
      ∃ v : Γ(S, ⊤)ˣ, v ^ n = u := by
    intro u hu
    obtain ⟨s, hs⟩ := exists_units_map_appTop_eq_of_openUnitDivisor_eq_zero jK gC u
      (openUnitDivisor_eq_zero_of_boundaryUnitDivisor_eq_zero jK _ hu)
    obtain ⟨t, ht⟩ := exists_pow_eq_globalUnit C n gC (Nat.pos_of_ne_zero hn0) s
    exact ⟨Units.map jK.appTop.hom.toMonoidHom t, by rw [← map_pow, ht, hs]⟩
  refine (encard_eigen_h1RootsOfUnity_le S σ hn0 hS Q (boundaryUnitDivisor jK) hφ
    (boundaryUnitDivisor_units_map_appTop jK σ' σ hcomm hfix)).trans
    (mul_le_mul' ?_ le_rfl)
  exact encard_torsion_eigen_le_of_isOpenImmersion gC gS jK σ' σ hcomm hfix _ Q

end KummerCount

section Boundary

variable {K₀ : Type u} [Field K₀] [Fintype K₀] {Ybar Y₀ : Scheme.{u}} (r : Ybar ⟶ Spec (.of K₀))
  (j : Y₀ ⟶ Ybar) [IsOpenImmersion j]

/-- The base change `Y₀ ×_{k₀} K ⟶ Ȳ ×_{k₀} K` of an open immersion over `k₀`. -/
abbrev openBaseChange (K : Type u) [Field K] [Algebra K₀ K] :
    pullback (j ≫ r) (spectrumMap K₀ K) ⟶ pullback r (spectrumMap K₀ K) :=
  baseChangeMap K₀ K (X := Over.mk (j ≫ r)) (Y := Over.mk r) (Over.homMk j rfl)

omit [Fintype K₀] [IsOpenImmersion j] in
/-- The base change of `j` along `Ȳ ×_{k₀} K ⟶ Ȳ` is `openBaseChange r j K`: the square with
`Y₀ ×_{k₀} K ⟶ Y₀` and `Ȳ ×_{k₀} K ⟶ Ȳ` is cartesian. -/
theorem isPullback_openBaseChange (K : Type u) [Field K] [Algebra K₀ K] :
    IsPullback (pullback.fst (j ≫ r) (spectrumMap K₀ K)) (openBaseChange r j K) j
      (pullback.fst r (spectrumMap K₀ K)) := by
  refine IsPullback.flip (IsPullback.of_right ?_ ?_ (IsPullback.of_hasPullback r _).flip)
  · rw [show openBaseChange r j K ≫ pullback.snd r (spectrumMap K₀ K) =
        pullback.snd (j ≫ r) (spectrumMap K₀ K) from by simp [openBaseChange, baseChangeMap]]
    exact (IsPullback.of_hasPullback (j ≫ r) _).flip
  · simp [openBaseChange, baseChangeMap]

omit [Fintype K₀] in
/-- The base change of an open immersion over `k₀` to a field `K` is an open immersion. -/
instance (K : Type u) [Field K] [Algebra K₀ K] : IsOpenImmersion (openBaseChange r j K) :=
  MorphismProperty.of_isPullback (P := @IsOpenImmersion) (isPullback_openBaseChange r j K)
    inferInstance

end Boundary

section Nonempty

/-- The base change of a nonempty scheme over a field to an extension field is nonempty. -/
theorem nonempty_pullback_spectrumMap {K₀ : Type u} [Field K₀] {Y : Scheme.{u}}
    (g : Y ⟶ Spec (.of K₀)) [Nonempty Y] (K : Type u) [Field K] [Algebra K₀ K] :
    Nonempty ↥(pullback g (spectrumMap K₀ K) : Scheme.{u}) := by
  have : Surjective (spectrumMap K₀ K) :=
    ⟨fun _ => ⟨IsLocalRing.closedPoint K, Subsingleton.elim (α := PrimeSpectrum K₀) _ _⟩⟩
  obtain ⟨y⟩ : Nonempty Y := inferInstance
  obtain ⟨z, -⟩ := (pullback.fst g (spectrumMap K₀ K)).surjective y
  exact ⟨z⟩

end Nonempty

section Main

variable {K₀ : Type u} [Field K₀] [Fintype K₀] {Ybar Y₀ : Scheme.{u}} (r : Ybar ⟶ Spec (.of K₀))
  [IsProper r] [Smooth r] [GeometricallyIrreducible r] [IsCurve K₀ r]
  (j : Y₀ ⟶ Ybar) [IsOpenImmersion j] [IsCurve K₀ (j ≫ r)]

omit [IsProper r] in
/-- **A power of the Frobenius fixes the points at infinity.** For a smooth proper geometrically
irreducible curve `Ȳ` over a finite field and an open subcurve `Y₀`, there is `m ≥ 1` such that
the twist of `Ȳ_K` by `Fᵐ` fixes every closed point outside `Y₀,K`: the twist by `F` permutes
these finitely many points. -/
theorem exists_galoisTwist_frobenius_pow_fixed :
    ∃ m : ℕ, 0 < m ∧ ∀ b : closedPoints ↥(pullback r (spectrumMap K₀ (AlgebraicClosure K₀)) :
      Scheme.{u}),
      b.1 ∉ Set.range (openBaseChange r j (AlgebraicClosure K₀)).base →
        (Stacks.Picard.galoisTwist K₀ (AlgebraicClosure K₀) (Over.mk r)
          (FiniteField.frobeniusAlgEquivOfAlgebraic K₀ (AlgebraicClosure K₀) ^ m)).base b.1 =
          b.1 := by
  classical
  set K := AlgebraicClosure K₀
  set F := FiniteField.frobeniusAlgEquivOfAlgebraic K₀ K
  set C := pullback r (spectrumMap K₀ K)
  set jK := openBaseChange r j K
  set σ : (K ≃ₐ[K₀] K) → (C ⟶ C) := fun τ => Stacks.Picard.galoisTwist K₀ K (Over.mk r) τ
  set σS : (K ≃ₐ[K₀] K) →
      (pullback (j ≫ r) (spectrumMap K₀ K) ⟶ pullback (j ≫ r) (spectrumMap K₀ K)) :=
    fun τ => Stacks.Picard.galoisTwist K₀ K (Over.mk (j ≫ r)) τ
  have hcomm : ∀ τ, σS τ ≫ jK = jK ≫ σ τ := fun τ =>
    galoisTwist_comp_baseChangeMap K₀ K (X := Over.mk (j ≫ r)) (Y := Over.mk r) (Over.homMk j rfl) τ
  have hinv : ∀ τ (x : C), (σ τ⁻¹).base ((σ τ).base x) = x := fun τ x => by
    change (σ τ ≫ σ τ⁻¹).base x = x
    simp only [σ]
    rw [← Stacks.Picard.galoisTwist_mul, mul_inv_cancel, Stacks.Picard.galoisTwist_one]
    rfl
  -- the closed points at infinity
  set B := {b : closedPoints C | b.1 ∉ Set.range jK.base}
  have : IsCurve K₀ (Over.mk r).hom := ‹IsCurve K₀ r›
  have : Smooth (Over.mk r).hom := ‹Smooth r›
  have : GeometricallyIrreducible (Over.mk r).hom := ‹GeometricallyIrreducible r›
  have : Nonempty Y₀ := (IsCurve.toIsVariety (k := K₀) (f := j ≫ r)).toIsIntegral.nonempty
  have : IsCurve K (pullback.snd r (spectrumMap K₀ K)) :=
    Stacks.Picard.isCurve_baseChange_of_geometricallyIrreducible (Over.mk r) K
  have : IsLocallyNoetherian C :=
    LocallyOfFiniteType.isLocallyNoetherian (pullback.snd r (spectrumMap K₀ K))
  have : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace (pullback.snd r _)
  have : AlgebraicGeometry.IsNoetherian C := {}
  have hBfin : B.Finite := by
    have hZ : IsClosed (Set.range jK.base)ᶜ := jK.isOpenMap.isOpen_range.isClosed_compl
    have hgen : genericPoint C ∉ (Set.range jK.base)ᶜ := by
      obtain ⟨y⟩ := nonempty_pullback_spectrumMap (j ≫ r) K
      exact not_not.2 (((genericPoint_spec C).mem_open_set_iff jK.isOpenMap.isOpen_range).2
        ⟨_, trivial, ⟨y, rfl⟩⟩)
    refine ((finite_setOf_coheight_eq_one_of_isClosed hZ hgen).preimage
      Subtype.val_injective.injOn).subset ?_
    intro b hb
    exact ⟨hb, IsCurve.coheight_eq_one (f := pullback.snd r (spectrumMap K₀ K))
      (ne_genericPoint_of_mem_closedPoints_of_isCurve (pullback.snd r (spectrumMap K₀ K)) b)⟩
  have : Finite B := hBfin.to_subtype
  have : ∀ τ, IsIso (σ τ) := fun τ => isIso_galoisTwist_of_algEquiv K₀ K (Over.mk r) τ
  -- `σ F` permutes `B`
  have hmapB : ∀ τ, ∀ b ∈ B, IsClosed ({(σ τ).base b.1} : Set C) ∧
      (σ τ).base b.1 ∉ Set.range jK.base := by
    intro τ b hb
    refine ⟨?_, ?_⟩
    · simpa [Set.image_singleton] using (σ τ).homeomorph.isClosedMap _ b.2
    · rintro ⟨y, hy⟩
      refine hb ⟨(σS τ⁻¹).base y, ?_⟩
      change (σS τ⁻¹ ≫ jK).base y = b.1
      rw [hcomm]
      change (σ τ⁻¹).base (jK.base y) = b.1
      rw [hy, hinv]
  let f : B → B := fun b => ⟨⟨(σ F).base b.1.1, (hmapB F b.1 b.2).1⟩, (hmapB F b.1 b.2).2⟩
  have hfinj : Function.Injective f := by
    intro b₁ b₂ h
    exact Subtype.ext (Subtype.ext ((σ F).homeomorph.injective (congrArg (fun b : B => b.1.1) h)))
  let π : Equiv.Perm B := Equiv.ofBijective f (Finite.injective_iff_bijective.1 hfinj)
  refine ⟨orderOf π, orderOf_pos π, fun b hb => ?_⟩
  have hiter : ∀ k : ℕ, (σ (F ^ k)).base b.1 = ((π ^ k) ⟨b, hb⟩).1.1 := by
    intro k
    induction k with
    | zero =>
      simp only [pow_zero, σ, Stacks.Picard.galoisTwist_one]
      rfl
    | succ k ih =>
      rw [pow_succ, pow_succ', Equiv.Perm.mul_apply]
      change (Stacks.Picard.galoisTwist K₀ K (Over.mk r) (F ^ k * F)).base b.1 = _
      rw [Stacks.Picard.galoisTwist_mul]
      change (σ F).base ((σ (F ^ k)).base b.1) = _
      rw [ih]
      rfl
  rw [show Stacks.Picard.galoisTwist K₀ (AlgebraicClosure K₀) (Over.mk r) (F ^ orderOf π) =
    σ (F ^ orderOf π) from rfl, hiter, pow_orderOf_eq_one, Equiv.Perm.one_apply]

/-- **The Frobenius eigenvectors of `H¹(Y_K, μ_{ℓᵉ})` are bounded independently of `e`.** Let
`Ȳ` be a smooth proper geometrically irreducible curve over a finite field `k₀` with `q`
elements, `Y₀ ⊆ Ȳ` an open subcurve, `ℓ` a prime invertible in `k₀`, and `m ≥ 1` with `Fᵐ`
fixing the points at infinity (`exists_galoisTwist_frobenius_pow_fixed`). Then the classes
`c ∈ H¹(Y_K, μ_{ℓᵉ})` with `(id × Spec Fᵐ)^* c = qᵐ c` are at most `C` in number, `C` independent
of `e`. -/
theorem exists_forall_encard_eigen_h1RootsOfUnity_le {ℓ : ℕ} (hℓ : ℓ.Prime)
    (hℓK₀ : IsUnit (ℓ : K₀))
    [HasExt.{u + 1}
      (Sheaf (pullback (j ≫ r) (spectrumMap K₀ (AlgebraicClosure K₀))).smallEtaleTopology
      AddCommGrpCat.{u + 1})]
    (m : ℕ) (hm : 0 < m)
    (hfix : ∀ b : closedPoints ↥(pullback r (spectrumMap K₀ (AlgebraicClosure K₀)) : Scheme.{u}),
      b.1 ∉ Set.range (openBaseChange r j (AlgebraicClosure K₀)).base →
        (Stacks.Picard.galoisTwist K₀ (AlgebraicClosure K₀) (Over.mk r)
          (FiniteField.frobeniusAlgEquivOfAlgebraic K₀ (AlgebraicClosure K₀) ^ m)).base b.1 =
          b.1) :
    ∃ C : ℕ, ∀ e : ℕ,
      {c : Sheaf.H.{u + 1} (rootsOfUnitySheaf.{u, 0}
          (pullback (j ≫ r) (spectrumMap K₀ (AlgebraicClosure K₀))) (ℓ ^ e)) 1 |
        rootsOfUnityPullbackMap.{u, 0, u + 1}
          (Stacks.Picard.galoisTwist K₀ (AlgebraicClosure K₀) (Over.mk (j ≫ r))
            (FiniteField.frobeniusAlgEquivOfAlgebraic K₀ (AlgebraicClosure K₀) ^ m)) (ℓ ^ e) 1 c =
          ((Fintype.card K₀ : ℤ) ^ m) • c}.encard ≤ C := by
  classical
  let K := AlgebraicClosure K₀
  let F := FiniteField.frobeniusAlgEquivOfAlgebraic K₀ K
  let q : ℤ := (Fintype.card K₀ : ℤ)
  let C := pullback r (spectrumMap K₀ K)
  let S := pullback (j ≫ r) (spectrumMap K₀ K)
  let gC := pullback.snd r (spectrumMap K₀ K)
  let gS := pullback.snd (j ≫ r) (spectrumMap K₀ K)
  let jK := openBaseChange r j K
  let σ := Stacks.Picard.galoisTwist K₀ K (Over.mk r) (F ^ m)
  let σS := Stacks.Picard.galoisTwist K₀ K (Over.mk (j ≫ r)) (F ^ m)
  have : IsIso σ := isIso_galoisTwist_of_algEquiv K₀ K (Over.mk r) _
  have : IsIso σS := isIso_galoisTwist_of_algEquiv K₀ K (Over.mk (j ≫ r)) _
  have hcomm : σS ≫ jK = jK ≫ σ :=
    galoisTwist_comp_baseChangeMap K₀ K (X := Over.mk (j ≫ r)) (Y := Over.mk r) (Over.homMk j rfl) _
  -- the curves `C = Ȳ_K` and `S = Y₀,K`
  have : IsCurve K₀ (Over.mk r).hom := ‹IsCurve K₀ r›
  have : Smooth (Over.mk r).hom := ‹Smooth r›
  have : GeometricallyIrreducible (Over.mk r).hom := ‹GeometricallyIrreducible r›
  have : IsProper (Over.mk r).hom := ‹IsProper r›
  have : Nonempty Y₀ := (IsCurve.toIsVariety (k := K₀) (f := j ≫ r)).toIsIntegral.nonempty
  have : IsCurve K gC := Stacks.Picard.isCurve_baseChange_of_geometricallyIrreducible (Over.mk r) K
  have : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian gC
  have : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace gC
  have : AlgebraicGeometry.IsNoetherian C := {}
  have : IsNormal C := isNormal_of_isRegular C (isRegular_of_smooth_over_field gC)
  have : Nonempty S := nonempty_pullback_spectrumMap (j ≫ r) K
  have : IsIntegral S := isIntegral_of_isOpenImmersion jK
  have : QuasiCompact (j ≫ r) := (IsCurve.toIsVariety (k := K₀) (f := j ≫ r)).toQuasiCompact
  have : IsSeparated (j ≫ r) := (IsCurve.toIsVariety (k := K₀) (f := j ≫ r)).toIsSeparated
  have : LocallyOfFiniteType (j ≫ r) :=
    (IsCurve.toIsVariety (k := K₀) (f := j ≫ r)).toLocallyOfFiniteType
  have : QuasiCompact gS := inferInstanceAs (QuasiCompact (pullback.snd (j ≫ r) _))
  have : IsSeparated gS := inferInstanceAs (IsSeparated (pullback.snd (j ≫ r) _))
  have : LocallyOfFiniteType gS := inferInstanceAs (LocallyOfFiniteType (pullback.snd (j ≫ r) _))
  have : Smooth gS := inferInstanceAs (Smooth (pullback.snd (j ≫ r) _))
  have : IsCurve K gS :=
    { topologicalKrullDim_eq_one :=
        (topologicalKrullDim_baseChange K₀ K (pullback.fst (j ≫ r) (spectrumMap K₀ K)) gS (j ≫ r)
          (IsPullback.of_hasPullback (j ≫ r) (spectrumMap K₀ K))).trans
          (IsCurve.topologicalKrullDim_eq_one (j ≫ r)) }
  have : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian gS
  have : CompactSpace S := QuasiCompact.compactSpace_of_compactSpace gS
  have : AlgebraicGeometry.IsNoetherian S := {}
  -- the points at infinity
  have hBfin : {b : closedPoints C | b.1 ∉ Set.range jK.base}.Finite := by
    have hZ : IsClosed (Set.range jK.base)ᶜ := jK.isOpenMap.isOpen_range.isClosed_compl
    have hgen : genericPoint C ∉ (Set.range jK.base)ᶜ := by
      obtain ⟨y⟩ := nonempty_pullback_spectrumMap (j ≫ r) K
      exact not_not.2 (((genericPoint_spec C).mem_open_set_iff jK.isOpenMap.isOpen_range).2
        ⟨_, trivial, ⟨y, rfl⟩⟩)
    refine ((finite_setOf_coheight_eq_one_of_isClosed hZ hgen).preimage
      Subtype.val_injective.injOn).subset ?_
    intro b hb
    exact ⟨hb, IsCurve.coheight_eq_one (f := gC)
      (ne_genericPoint_of_mem_closedPoints_of_isCurve gC b)⟩
  have : Finite {b : closedPoints C // b.1 ∉ Set.range jK.base} := hBfin.to_subtype
  -- constants
  have hq0 : ((Fintype.card K₀ : ℕ) : K₀) = 0 := FiniteField.cast_card_eq_zero K₀
  have hq1 : 1 < Fintype.card K₀ := Fintype.one_lt_card
  have hqm : 1 ≤ Fintype.card K₀ ^ m := Nat.one_le_pow _ _ (by omega)
  have hd0 : q ^ m - 1 ≠ 0 := by
    have h2 : (1 : ℤ) < q ^ m := by
      change (1 : ℤ) < (Fintype.card K₀ : ℤ) ^ m
      exact_mod_cast Nat.one_lt_pow hm.ne' hq1
    omega
  have hdunit : IsUnit (((Fintype.card K₀ ^ m - 1 : ℕ) : K₀)) := by
    rw [Nat.cast_sub hqm, Nat.cast_pow, hq0, zero_pow hm.ne', Nat.cast_one, zero_sub]
    exact isUnit_one.neg
  have hd : (((Fintype.card K₀ ^ m - 1 : ℕ) : ℤ) ^ 1) = q ^ m - 1 := by
    rw [pow_one, Nat.cast_sub hqm]
    push_cast
    rfl
  -- the three factors independent of `e`
  have : AddGroup.FG ({b : closedPoints C // b.1 ∉ Set.range jK.base} → ℤ) :=
    Module.Finite.iff_addGroup_fg.1 inferInstance
  have : AddGroup.FG (boundaryUnitDivisor jK).range :=
    Stacks.EigenvectorCount.addGroupFG_addSubgroup _
  have hQ₃ := Stacks.EigenvectorCount.finite_quotient_range_zsmulAddGroupHom
    (G := (boundaryUnitDivisor jK).range) hd0
  have : AddGroup.FG ({b : closedPoints C // b.1 ∉ Set.range jK.base} →₀ ℤ) :=
    Module.Finite.iff_addGroup_fg.1 inferInstance
  have hQ₂ := Stacks.EigenvectorCount.finite_quotient_range_zsmulAddGroupHom
    (G := {b : closedPoints C // b.1 ∉ Set.range jK.base} →₀ ℤ) hd0
  have hT : Finite (Submodule.torsionBy ℤ (Stacks.Picard.ofScheme C)
      (((Fintype.card K₀ ^ m - 1 : ℕ) : ℤ) ^ 1)) :=
    Stacks.Picard.finite_torsionBy_ofScheme_baseChange_algebraicClosure (Over.mk r) hdunit 1
  have hTC : {w : Stacks.Picard.ofScheme C | (q ^ m - 1) • w = 0}.encard ≤
      Nat.card (Submodule.torsionBy ℤ (Stacks.Picard.ofScheme C)
        (((Fintype.card K₀ ^ m - 1 : ℕ) : ℤ) ^ 1)) := by
    rw [← ENat.card_eq_coe_natCard, ← Set.encard_univ]
    calc _ ≤ ((fun z : Submodule.torsionBy ℤ (Stacks.Picard.ofScheme C)
          (((Fintype.card K₀ ^ m - 1 : ℕ) : ℤ) ^ 1) => (z : Stacks.Picard.ofScheme C)) ''
            Set.univ).encard := by
          refine Set.encard_le_encard fun w hw => ⟨⟨w, ?_⟩, Set.mem_univ _, rfl⟩
          rw [Submodule.mem_torsionBy_iff, hd]
          exact hw
      _ ≤ _ := Set.encard_image_le _ _
  -- the Picard group of `Ȳ_K`
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  have hunit : ∀ n : ℕ, IsUnit ((Fintype.card K₀ : ℤ) : ZMod (ℓ ^ n)) := by
    intro n
    rw [Int.cast_natCast, ZMod.isUnit_iff_coprime]
    refine Nat.Coprime.pow_right _ ?_
    rw [Nat.coprime_comm, Nat.Prime.coprime_iff_not_dvd hℓ]
    intro hdvd
    obtain ⟨p, hp⟩ := CharP.exists K₀
    have := hp
    have hpp : p.Prime := CharP.char_is_prime K₀ p
    obtain ⟨d, -, hd'⟩ := FiniteField.card K₀ p
    rw [hd'] at hdvd
    have hℓp := (Nat.prime_dvd_prime_iff_eq hℓ hpp).1 (hℓ.dvd_of_dvd_pow hdvd)
    subst hℓp
    exact hℓK₀.ne_zero (CharP.cast_eq_zero K₀ ℓ)
  have : NeZero m := ⟨hm.ne'⟩
  obtain ⟨C₁, hC₁⟩ := Stacks.Picard.exists_forall_encard_torsion_eigen_frobenius_pow_le
    (Over.mk r) ℓ hℓ0 (Stacks.Picard.finite_torsionBy_ofScheme_baseChange_algebraicClosure
      (Over.mk r) hℓK₀) hunit
    (Stacks.Picard.exists_weilPairing_frobeniusPicardHom hℓ K₀ (Over.mk r) hℓK₀) m
  refine ⟨C₁ * (Nat.card (({b : closedPoints C // b.1 ∉ Set.range jK.base} →₀ ℤ) ⧸
        (zsmulAddGroupHom (α := {b : closedPoints C // b.1 ∉ Set.range jK.base} →₀ ℤ)
          (q ^ m - 1)).range) *
      Nat.card (Submodule.torsionBy ℤ (Stacks.Picard.ofScheme C)
        (((Fintype.card K₀ ^ m - 1 : ℕ) : ℤ) ^ 1))) *
      Nat.card ((boundaryUnitDivisor jK).range ⧸
        (zsmulAddGroupHom (α := (boundaryUnitDivisor jK).range) (q ^ m - 1)).range), fun e => ?_⟩
  have hn0 : ℓ ^ e ≠ 0 := pow_ne_zero e hℓ0
  have hnK : IsUnit ((ℓ ^ e : ℕ) : K) := by
    rw [Nat.cast_pow]
    exact (by simpa using hℓK₀.map (algebraMap K₀ K) : IsUnit (ℓ : K)).pow e
  refine (encard_eigen_h1RootsOfUnity_le_of_isOpenImmersion S σS gC gS jK σ hcomm
    (fun b hb => hfix b hb) hn0 hnK (q ^ m)).trans ?_
  push_cast
  refine mul_le_mul' (mul_le_mul' ?_ (mul_le_mul' ?_ hTC)) ?_
  · exact hC₁ e
  · rw [Set.encard_univ, ENat.card_eq_coe_natCard]
  · rw [Set.encard_univ, ENat.card_eq_coe_natCard]

end Main

end Stacks.Kummer
