/-!
# Abhyankar's lemma at the boundary of `𝐆_m`

Let `C` be a finite unramified algebra over `k[x]_x` (`k` a finite field with `q` elements)
which is tamely ramified at the boundary point `(x)` of the chart `Spec k[x]`, and let
`ψ : C → Ω` be a point over a transcendental `u ∈ Ω` (`x ↦ u`). Then there is `E₀ ≥ 1` prime to
`q`, the product of the ramification indices at `(x)`, such that for every Kummer level: a
finite field `F ⊆ Ω` over `k`, a field `K''` which is a fraction field of `F[s]` with
`s` transcendental and `s^e = u`, `E₀ ∣ e`, `q ∤ e`, the integral closure of `F[s]` in
`N = K''(ψ(C))` is unramified at every prime containing `s`.

The proof applies Abhyankar's lemma `Abhyankar.isUnramifiedWithRespectTo_of_tensor` to the local
ring `O = k[x]_{(x)}` with fraction field `K = k(u)`, the field `L = K(ψ(C))`, which is tame by
`isTamelyRamifiedWithRespectTo_of_chartZero`, and the discrete valuation ring `O' = F[s]_{(s)}`
with fraction field `K''`, uniformizer `s` and `s^e = u`; every element of `O'` is integral over
`O` (`isIntegral_inv_one_add_mul`). The integral closure of `O'` in `N` is the localization of that
of `F[s]`, so `isUnramifiedAt_of_isLocalization_integralClosure` gives unramifiedness at the primes
over `(s)`.

## Main results

* `AlgebraicGeometry.TameMultiplicativeGroup.exists_forall_isUnramifiedAt_of_tame`.
-/

@[expose] public noncomputable section

open CategoryTheory Polynomial IsLocalRing
open scoped TensorProduct

namespace AlgebraicGeometry.TameMultiplicativeGroup

/-- The algebra structure of an integral closure over its base, as a local instance with a
narrow pattern: the general `Subalgebra.algebra` is found only after a slow search when the
ambient ring is an intermediate field. -/
abbrev integralClosureAlgebraOfBase {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] :
    Algebra R (integralClosure R A) :=
  Subalgebra.algebra _

end AlgebraicGeometry.TameMultiplicativeGroup

attribute [local instance 20000]
  AlgebraicGeometry.TameMultiplicativeGroup.integralClosureAlgebraOfBase

universe u

namespace AlgebraicGeometry.TameMultiplicativeGroup

variable (k : Type u) [Field k]

/-- The boundary point `(x)` of `Spec k[x]`. -/
def originPoint : Spec (CommRingCat.of k[X]) :=
  ⟨Ideal.span {X}, (Ideal.span_singleton_prime X_ne_zero).mpr prime_X⟩

/-- The prime ideal of `originPoint k` is `(x)`. -/
theorem originPoint_asIdeal : (originPoint k).asIdeal = Ideal.span {X} := rfl

/-- The local ring of `k[x]` at `(x)` is a domain. -/
instance : IsDomain (stalkAt k (originPoint k)) :=
  IsLocalization.isDomain_of_le_nonZeroDivisors (R := k[X]) (stalkAt k (originPoint k))
    (M := (originPoint k).asIdeal.primeCompl) (Ideal.primeCompl_le_nonZeroDivisors _)

/-- The local ring of `k[x]` at `(x)` is a discrete valuation ring. -/
instance : IsDiscreteValuationRing (stalkAt k (originPoint k)) :=
  IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain k[X]
    (P := (originPoint k).asIdeal) (by
      rw [originPoint_asIdeal, Ne, Ideal.span_singleton_eq_bot]
      exact X_ne_zero) _

variable {k}

/-- The uniformizer `x` of the local ring at `(x)`. -/
abbrev originUniformizer : stalkAt k (originPoint k) := algebraMap k[X] _ X

/-- The maximal ideal of the local ring at `(x)` is generated by `x`. -/
theorem maximalIdeal_stalk_eq :
    maximalIdeal (stalkAt k (originPoint k)) = Ideal.span {originUniformizer (k := k)} := by
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (originPoint k).asIdeal
    (stalkAt k (originPoint k)), originPoint_asIdeal, Ideal.map_span, Set.image_singleton]

section FractionField

variable {Ω : Type u} [Field Ω] [Algebra k Ω] {u : Ω} (hu : Transcendental k u)

/-- `k[x] → k(u)`, `x ↦ u`. -/
def polyToAdjoin (u : Ω) : k[X] →+* IntermediateField.adjoin k {u} :=
  (aeval (IntermediateField.AdjoinSimple.gen k u)).toRingHom

/-- The image of `r` under `polyToAdjoin u` is `r(u)`. -/
theorem coe_polyToAdjoin (r : k[X]) : (polyToAdjoin u r : Ω) = aeval u r :=
  IntermediateField.AdjoinSimple.coe_aeval_gen_apply (F := k) (α := u) r

include hu in
/-- For transcendental `u`, the map `k[x] → k(u)`, `x ↦ u`, is injective. -/
theorem polyToAdjoin_injective : Function.Injective (polyToAdjoin (k := k) u) := fun r r' h ↦
  (transcendental_iff_injective.mp hu) (by
    rw [← coe_polyToAdjoin, ← coe_polyToAdjoin, h])

include hu in
/-- For transcendental `u`, every nonzero `r ∈ k[x]` maps to a unit of `k(u)`. -/
theorem isUnit_polyToAdjoin {r : k[X]} (hr : r ≠ 0) : IsUnit (polyToAdjoin (k := k) u r) := by
  rw [isUnit_iff_ne_zero, Ne, ← map_zero (polyToAdjoin u)]
  exact fun h ↦ hr (polyToAdjoin_injective hu h)

include hu in
/-- The map from the local ring at `(x)` to `k(u)`. -/
def stalkToAdjoin : stalkAt k (originPoint k) →+* IntermediateField.adjoin k {u} :=
  IsLocalization.lift (M := (originPoint k).asIdeal.primeCompl) (g := polyToAdjoin u) fun r ↦
    isUnit_polyToAdjoin hu fun h0 ↦ r.2 (h0 ▸ Ideal.zero_mem _)

/-- `stalkToAdjoin hu` extends `polyToAdjoin u` along `k[x] → k[x]_{(x)}`. -/
theorem stalkToAdjoin_algebraMap (r : k[X]) :
    stalkToAdjoin hu (algebraMap k[X] _ r) = polyToAdjoin u r :=
  IsLocalization.lift_eq _ _

/-- Via `stalkToAdjoin hu`, `k(u)` is a fraction field of the local ring at `(x)`. -/
theorem isFractionRing_stalkToAdjoin :
    letI := (stalkToAdjoin hu).toAlgebra
    IsFractionRing (stalkAt k (originPoint k)) (IntermediateField.adjoin k {u}) := by
  let := (stalkToAdjoin hu).toAlgebra
  have : FaithfulSMul (stalkAt k (originPoint k)) (IntermediateField.adjoin k {u}) := by
    refine (faithfulSMul_iff_algebraMap_injective _ _).mpr ?_
    refine (IsLocalization.lift_injective_iff (M := (originPoint k).asIdeal.primeCompl)
      (S := stalkAt k (originPoint k)) (P := IntermediateField.adjoin k {u}) _).mpr ?_
    intro x y
    rw [(IsLocalization.injective (stalkAt k (originPoint k))
      (Ideal.primeCompl_le_nonZeroDivisors (originPoint k).asIdeal)).eq_iff,
      (polyToAdjoin_injective hu).eq_iff]
  refine IsFractionRing.of_field _ _ fun z ↦ ?_
  obtain ⟨r, r', hrr'⟩ := (IntermediateField.mem_adjoin_simple_iff k (z : Ω)).mp z.2
  refine ⟨algebraMap k[X] _ r, algebraMap k[X] _ r', Subtype.ext ?_⟩
  show (z : Ω) = (stalkToAdjoin hu (algebraMap k[X] _ r) : Ω) /
    (stalkToAdjoin hu (algebraMap k[X] _ r') : Ω)
  rw [stalkToAdjoin_algebraMap, stalkToAdjoin_algebraMap, coe_polyToAdjoin, coe_polyToAdjoin, hrr']

/-- The map `k[x]_x → k(u)`. -/
def ringToAdjoin : Ring k →+* IntermediateField.adjoin k {u} :=
  IsLocalization.Away.lift (X : k[X]) (g := polyToAdjoin u)
    (by
      rw [isUnit_iff_ne_zero, Ne, Subtype.ext_iff, coe_polyToAdjoin, aeval_X]
      exact fun h0 ↦ hu (h0 ▸ isAlgebraic_zero))

/-- `ringToAdjoin hu` extends `polyToAdjoin u` along `k[x] → k[x]_x`. -/
theorem ringToAdjoin_algebraMap (r : k[X]) :
    ringToAdjoin hu (algebraMap k[X] (Ring k) r) = polyToAdjoin u r :=
  IsLocalization.lift_eq _ _

include hu in
/-- Every element of the local ring at `(x)` maps to `r(u)/r'(u)` with `r'(0) ≠ 0`. -/
theorem exists_mul_aeval_eq_stalkToAdjoin (x : stalkAt k (originPoint k)) :
    ∃ r r' : k[X], r'.coeff 0 ≠ 0 ∧
      ((stalkToAdjoin hu x : IntermediateField.adjoin k {u}) : Ω) * aeval u r' = aeval u r := by
  obtain ⟨⟨r, ⟨r', hr'⟩⟩, rfl⟩ :=
    IsLocalization.mk'_surjective (originPoint k).asIdeal.primeCompl x
  refine ⟨r, r', fun h0 ↦ hr' (Ideal.mem_span_singleton.mpr (X_dvd_iff.mpr h0)), ?_⟩
  have h1 : stalkToAdjoin hu (IsLocalization.mk' (stalkAt k (originPoint k)) r ⟨r', hr'⟩) *
      stalkToAdjoin hu (algebraMap k[X] _ r') = stalkToAdjoin hu (algebraMap k[X] _ r) := by
    rw [← map_mul, IsLocalization.mk'_spec]
  rw [stalkToAdjoin_algebraMap, stalkToAdjoin_algebraMap] at h1
  simpa only [IntermediateField.coe_mul, coe_polyToAdjoin] using
    congrArg (fun z : IntermediateField.adjoin k {u} ↦ (z : Ω)) h1

end FractionField


section Fields

/-- **`F(s)` is finite separable over a subfield containing `s^e`**, `e` invertible, when `F` is
finite. -/
theorem finiteDimensional_isSeparable_of_pow {k Ω : Type*} [Field k] [Finite k] [Field Ω]
    [Algebra k Ω] (F : IntermediateField k Ω) [FiniteDimensional k F] (K'' : IntermediateField F Ω)
    (s : K'') [IsFractionRing (Algebra.adjoin F {s}) K''] {E : Type*} [Field E] [Algebra k E]
    [Algebra E K''] [IsScalarTower k E K''] {e : ℕ} (he : (e : E) ≠ 0) (c : E)
    (hc : algebraMap E K'' c = s ^ e) (hc0 : c ≠ 0) :
    FiniteDimensional E K'' ∧ Algebra.IsSeparable E K'' := by
  have he0 : e ≠ 0 := fun h ↦ he (by rw [h, Nat.cast_zero])
  set S : Set K'' := Set.range (algebraMap F K'') ∪ {s}
  have : Finite F := Module.finite_of_finite k
  have : Finite S := ((Set.finite_range _).union (Set.finite_singleton s)).to_subtype
  have hD : ∀ x : Algebra.adjoin F {s}, (x : K'') ∈ IntermediateField.adjoin E S := by
    intro x
    refine Algebra.adjoin_induction (p := fun y _ ↦ y ∈ IntermediateField.adjoin E S)
      (fun y hy ↦ ?_) (fun f ↦ ?_) (fun _ _ _ _ ha hb ↦ add_mem ha hb)
      (fun _ _ _ _ ha hb ↦ mul_mem ha hb) x.2
    · rw [Set.mem_singleton_iff.mp hy]
      exact IntermediateField.subset_adjoin E S (Or.inr rfl)
    · exact IntermediateField.subset_adjoin E S (Or.inl ⟨f, rfl⟩)
  have htop : IntermediateField.adjoin E S = ⊤ := by
    rw [eq_top_iff]
    intro z _
    obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := Algebra.adjoin F {s}) z
    exact div_mem (hD a) (hD b)
  have hsint : _root_.IsIntegral E s :=
    IsIntegral.of_pow (Nat.pos_of_ne_zero he0) (hc ▸ isIntegral_algebraMap)
  have hFsep : ∀ f : F, IsSeparable E (algebraMap F K'' f) := fun f ↦ by
    have h : IsSeparable k (algebraMap F K'' f) := by
      unfold IsSeparable
      rw [minpoly.algebraMap_eq (algebraMap F K'').injective f]
      exact Algebra.IsSeparable.isSeparable k f
    exact h.tower_top E
  have hint : ∀ x ∈ S, _root_.IsIntegral E x := by
    rintro x (⟨f, rfl⟩ | rfl)
    · exact (hFsep f).isIntegral
    · exact hsint
  have hsep : ∀ x ∈ S, IsSeparable E x := by
    rintro x (⟨f, rfl⟩ | hx)
    · exact hFsep f
    · rw [Set.mem_singleton_iff.mp hx]
      exact Polynomial.Separable.of_dvd (separable_X_pow_sub_C c he hc0)
        (minpoly.dvd E s (by rw [map_sub, map_pow, aeval_X, aeval_C, hc, sub_self]))
  have hfd := IntermediateField.finiteDimensional_adjoin hint
  have hs := (IntermediateField.isSeparable_adjoin_iff_isSeparable E K'').mpr hsep
  rw [htop] at hfd hs
  exact ⟨IntermediateField.topEquiv.toLinearEquiv.finiteDimensional,
    Algebra.IsSeparable.of_algHom _ _ IntermediateField.topEquiv.symm.toAlgHom⟩

/-- An element of `F[s]` outside the prime `(s)` is nonzero in the ambient field. -/
private theorem coe_ne_zero_of_mem_primeCompl {F K'' : Type*} [Field F] [Field K'']
    [Algebra F K''] {s : K''} [(Ideal.span {adjoinGen F s}).IsPrime] {m : Algebra.adjoin F {s}}
    (hm : m ∈ (Ideal.span {adjoinGen F s}).primeCompl) : (m : K'') ≠ 0 := fun h0 ↦
  hm (by rw [show m = 0 from Subtype.ext h0]; exact Ideal.zero_mem _)

/-- **Elements of the local ring of `F[s]` at `(s)` are integral over `O`** when `s^e` is the
image of an element `π` of the maximal ideal of the local ring `O`. -/
theorem isIntegral_of_mem_localizationSubalgebra {O : Type*} [CommRing O] [IsLocalRing O]
    {F K'' : Type*} [Field F] [Field K''] [Algebra F K''] {s : K''} (hs : Transcendental F s)
    [IsFractionRing (Algebra.adjoin F {s}) K''] [Algebra O K''] {π : O}
    (hπ : π ∈ maximalIdeal O) {e : ℕ} (he : e ≠ 0) (hπs : algebraMap O K'' π = s ^ e)
    (hF : ∀ f : F, _root_.IsIntegral O (algebraMap F K'' f))
    [(Ideal.span {adjoinGen F s}).IsPrime] {w : K''}
    (hw : w ∈ Localization.subalgebra K'' (Ideal.span {adjoinGen F s}).primeCompl
      (Ideal.primeCompl_le_nonZeroDivisors _)) : _root_.IsIntegral O w := by
  have := Polynomial.isPrincipalIdealRing_adjoin F hs
  have hD : ∀ x : Algebra.adjoin F {s}, _root_.IsIntegral O (x : K'') := by
    intro x
    refine Algebra.adjoin_induction (p := fun y _ ↦ _root_.IsIntegral O y)
      (fun y hy ↦ ?_) (fun f ↦ hF f) (fun _ _ _ _ ha hb ↦ ha.add hb)
      (fun _ _ _ _ ha hb ↦ ha.mul hb) x.2
    rw [Set.mem_singleton_iff.mp hy]
    exact IsIntegral.of_pow (Nat.pos_of_ne_zero he) (hπs ▸ isIntegral_algebraMap)
  obtain ⟨a, b, hb, rfl⟩ := hw
  rw [IsFractionRing.mk'_eq_div]
  have hbn : ¬ adjoinGen F s ∣ b := fun h ↦ hb (Ideal.mem_span_singleton.mpr h)
  obtain ⟨c, d, hcd⟩ :=
    ((Irreducible.coprime_iff_not_dvd (irreducible_adjoinGen hs)).mpr hbn).pow_left (m := e)
  have hd0 : d ≠ 0 := by
    rintro rfl
    rw [zero_mul, add_zero] at hcd
    exact (irreducible_adjoinGen hs).not_isUnit
      ((isUnit_pow_iff he).mp (IsUnit.of_mul_eq_one_right c hcd))
  have hcd' : (c : K'') * s ^ e + (d : K'') * (b : K'') = 1 := by
    simpa using congrArg (fun z : Algebra.adjoin F {s} ↦ (z : K'')) hcd
  have hb0 := coe_ne_zero_of_mem_primeCompl hb
  have hd0' : (d : K'') ≠ 0 := fun h0 ↦ hd0 (Subtype.ext h0)
  have hy : (d : K'') * (b : K'') = 1 + algebraMap O K'' π * (-(c : K'')) := by
    rw [hπs]
    linear_combination hcd'
  have heq : algebraMap (Algebra.adjoin F {s}) K'' a / algebraMap (Algebra.adjoin F {s}) K'' b =
      (a : K'') * (d : K'') * (1 + algebraMap O K'' π * (-(c : K'')))⁻¹ := by
    rw [← hy]
    show (a : K'') / (b : K'') = _
    field_simp
  rw [heq]
  refine ((hD a).mul (hD d)).mul (isIntegral_inv_one_add_mul hπ ?_)
  simpa using hD (-c)

end Fields

section Cover

variable {Ω : Type u} [Field Ω] {C : Type u} [CommRing C] (φ : Ring k →+* C) (ψ : C →+* Ω)

/-- **The field generated by a point of a finite unramified cover** over a field `E` receiving
`k[x]_x` compatibly is finite separable over `E`, and the point is integral over `E`. -/
theorem cover_adjoin_facts (hfin : φ.Finite) (hfu : φ.FormallyUnramified) {E : Type*} [Field E]
    [Algebra E Ω] (g : Ring k →+* E) (hg : ∀ z, algebraMap E Ω (g z) = ψ (φ z)) :
    FiniteDimensional E (IntermediateField.adjoin E (Set.range ψ)) ∧
      Algebra.IsSeparable E (IntermediateField.adjoin E (Set.range ψ)) ∧
      ∀ c, _root_.IsIntegral E (ψ c) := by
  let : Algebra (Ring k) C := φ.toAlgebra
  have : Module.Finite (Ring k) C := hfin
  have : Algebra.FormallyUnramified (Ring k) C := hfu
  let : Algebra (Ring k) E := g.toAlgebra
  let : Algebra (Ring k) Ω := ((algebraMap E Ω).comp g).toAlgebra
  have : IsScalarTower (Ring k) E Ω := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  let ψA : C →ₐ[Ring k] Ω := { ψ with commutes' := fun z ↦ (hg z).symm }
  exact ⟨finiteDimensional_adjoin_range ψA, isSeparable_adjoin_range ψA, isIntegral_of_finite ψA⟩

end Cover

section Generic

/-- The inclusion of a subfield of `Ω` into a larger one. -/
def fieldInclusion {k F Ω : Type*} [Field k] [Field F] [Field Ω] [Algebra k Ω] [Algebra F Ω]
    {K : IntermediateField k Ω} {K'' : IntermediateField F Ω} (h : ∀ z ∈ K, z ∈ K'') :
    K →+* K'' where
  toFun z := ⟨z, h z z.2⟩
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

/-- For transcendental `s`, the ideal `(s)` of `F[s]` is maximal. -/
theorem isMaximal_span_adjoinGen {F K : Type*} [Field F] [Field K] [Algebra F K] {s : K}
    (hs : Transcendental F s) : (Ideal.span {adjoinGen F s}).IsMaximal := by
  have := Polynomial.isPrincipalIdealRing_adjoin F hs
  exact PrincipalIdealRing.isMaximal_of_irreducible (irreducible_adjoinGen hs)

/-- For transcendental `s`, the ideal `(s)` of `F[s]` is nonzero. -/
theorem span_adjoinGen_ne_bot {F K : Type*} [Field F] [Field K] [Algebra F K] {s : K}
    (hs : Transcendental F s) : Ideal.span {adjoinGen F s} ≠ ⊥ := by
  rw [Ne, Ideal.span_singleton_eq_bot]
  exact (irreducible_adjoinGen hs).ne_zero

/-- The local ring `F[s]_(s)`, as a subalgebra of a fraction field `K''` of `F[s]`. -/
def localAtGen {F K'' : Type*} [Field F] [Field K''] [Algebra F K''] {s : K''}
    (hs : Transcendental F s) [IsFractionRing (Algebra.adjoin F {s}) K''] :
    Subalgebra (Algebra.adjoin F {s}) K'' :=
  letI := (isMaximal_span_adjoinGen hs).isPrime
  Localization.subalgebra K'' (Ideal.span {adjoinGen F s}).primeCompl
    (Ideal.primeCompl_le_nonZeroDivisors _)

/-- `localAtGen hs` is the localization of `F[s]` at the prime `(s)`. -/
theorem isLocalization_localAtGen {F K'' : Type*} [Field F] [Field K''] [Algebra F K''] {s : K''}
    (hs : Transcendental F s) [IsFractionRing (Algebra.adjoin F {s}) K'']
    [(Ideal.span {adjoinGen F s}).IsPrime] :
    IsLocalization.AtPrime (localAtGen hs) (Ideal.span {adjoinGen F s}) :=
  Localization.subalgebra.isLocalization_subalgebra (K := K'') _ _

/-- The `F[s]`-algebra structure of `F[s]_(s)`, as a local instance with a narrow pattern. -/
abbrev localAtGenAlgebra {F K'' : Type*} [Field F] [Field K''] [Algebra F K''] {s : K''}
    (hs : Transcendental F s) [IsFractionRing (Algebra.adjoin F {s}) K''] :
    Algebra (Algebra.adjoin F {s}) (localAtGen hs) :=
  Subalgebra.algebra _

attribute [local instance high] localAtGenAlgebra

/-- The algebra structure of a ring over `K''` over `F[s]_(s)`, as a local instance with a narrow
pattern. -/
abbrev localAtGenToAlgebra {F K'' : Type*} [Field F] [Field K''] [Algebra F K''] {s : K''}
    (hs : Transcendental F s) [IsFractionRing (Algebra.adjoin F {s}) K''] {A : Type*}
    [CommRing A] [Algebra K'' A] : Algebra (localAtGen hs) A :=
  Subalgebra.toAlgebra _

attribute [local instance high] localAtGenToAlgebra

/-- `K''` is a fraction field of `localAtGen hs`. -/
theorem isFractionRing_localAtGen {F K'' : Type*} [Field F] [Field K''] [Algebra F K''] {s : K''}
    (hs : Transcendental F s) [IsFractionRing (Algebra.adjoin F {s}) K'']
    [(Ideal.span {adjoinGen F s}).IsPrime] : IsFractionRing (localAtGen hs) K'' :=
  Localization.subalgebra.isFractionRing (K := K'') _ _

/-- Membership in `localAtGen hs` is membership in the localization subalgebra of `K''` at the
complement of `(s)`. -/
theorem mem_localAtGen {F K'' : Type*} [Field F] [Field K''] [Algebra F K''] {s : K''}
    (hs : Transcendental F s) [IsFractionRing (Algebra.adjoin F {s}) K''] {w : K''}
    [(Ideal.span {adjoinGen F s}).IsPrime] :
    w ∈ localAtGen hs ↔ w ∈ Localization.subalgebra K'' (Ideal.span {adjoinGen F s}).primeCompl
      (Ideal.primeCompl_le_nonZeroDivisors _) := Iff.rfl

/-- A tensor product of algebras maps onto a ring generated over the second factor by the image
of the first. -/
theorem productMap_surjective_of_adjoin {K L K'' N : Type*} [Field K] [CommRing L] [Algebra K L]
    [Field K''] [Algebra K K''] [CommRing N] [Algebra K'' N] [Algebra K N] [IsScalarTower K K'' N]
    (f : L →ₐ[K] N) (hf : Algebra.adjoin K'' (Set.range f) = ⊤) :
    Function.Surjective (Algebra.TensorProduct.productMap f (IsScalarTower.toAlgHom K K'' N)) := by
  rw [← AlgHom.range_eq_top, Algebra.TensorProduct.productMap_range, eq_top_iff]
  intro y _
  have hy : y ∈ Algebra.adjoin K'' (Set.range f) := hf ▸ Algebra.mem_top
  refine Algebra.adjoin_induction
    (p := fun x _ ↦ x ∈ f.range ⊔ (IsScalarTower.toAlgHom K K'' N).range) (fun x hx ↦ ?_)
    (fun r ↦ ?_) (fun _ _ _ _ h₁ h₂ ↦ add_mem h₁ h₂) (fun _ _ _ _ h₁ h₂ ↦ mul_mem h₁ h₂) hy
  · obtain ⟨l, rfl⟩ := hx
    exact le_sup_left (a := f.range) ⟨l, rfl⟩
  · exact le_sup_right (b := (IsScalarTower.toAlgHom K K'' N).range) ⟨r, rfl⟩

/-- **Abhyankar's lemma for `F[s]_(s)`.** Let `O` be a discrete valuation ring with uniformizer `π`
and fraction field `K`, and `L` a tame finite separable extension of `K` whose ramification indices
divide `e`. If `O` maps into the discrete valuation ring `O' = F[s]_(s)` with `π ↦ s^e`, `O'` is
integral over `O`, and `N` is a quotient of `L ⊗_K K''`, then the integral closure of `O'` in `N`
is formally unramified. -/
theorem formallyUnramified_localAtGen {O K L : Type u} [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [Field K] [Algebra O K] [IsFractionRing O K] [Field L]
    [Algebra K L] [Algebra O L] [IsScalarTower O K L] [FiniteDimensional K L]
    [Algebra.IsSeparable K L] (htame : IsDiscreteValuationRing.IsTamelyRamifiedWithRespectTo O K L)
    {e : ℕ} (he0 : e ≠ 0)
    (hdiv : ∀ m : Ideal (integralClosure O L), m.IsMaximal → m.LiesOver (maximalIdeal O) →
      Ideal.ramificationIdx' (maximalIdeal O) m ∣ e)
    {F K'' : Type u} [Field F] [Field K''] [Algebra F K''] {s : K''} (hs : Transcendental F s)
    [IsFractionRing (Algebra.adjoin F {s}) K''] [Algebra K K''] [Algebra O K'']
    [IsScalarTower O K K''] [FiniteDimensional K K''] [Algebra.IsSeparable K K'']
    {π : O} (hπ : maximalIdeal O = Ideal.span {π}) (hπs : algebraMap O K'' π = s ^ e)
    (hmem : ∀ x : O, algebraMap O K'' x ∈ localAtGen hs)
    (hF : ∀ f : F, _root_.IsIntegral O (algebraMap F K'' f))
    {N : Type u} [Field N] [Algebra K'' N] [FiniteDimensional K'' N] [Algebra.IsSeparable K'' N]
    [Algebra K N] [IsScalarTower K K'' N] (t : L ⊗[K] K'' →ₐ[K] N) (ht : Function.Surjective t)
    (htF : ∀ f, t (1 ⊗ₜ f) = algebraMap K'' N f) :
    Algebra.FormallyUnramified (localAtGen hs) (integralClosure (localAtGen hs) N) := by
  have hP₀ := isMaximal_span_adjoinGen hs
  have := Polynomial.isPrincipalIdealRing_adjoin F hs
  have : IsLocalization.AtPrime (localAtGen hs) (Ideal.span {adjoinGen F s}) :=
    isLocalization_localAtGen hs
  have : IsFractionRing (localAtGen hs) K'' := isFractionRing_localAtGen hs
  have : IsDiscreteValuationRing (localAtGen hs) :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain (Algebra.adjoin F {s})
      (span_adjoinGen_ne_bot hs) (localAtGen hs)
  have hϖ : maximalIdeal (localAtGen hs) =
      Ideal.span {algebraMap (Algebra.adjoin F {s}) (localAtGen hs) (adjoinGen F s)} := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (Ideal.span {adjoinGen F s}) (localAtGen hs),
      Ideal.map_span, Set.image_singleton]
  let : Algebra O (localAtGen hs) :=
    ((algebraMap O K'').codRestrict (localAtGen hs) hmem).toAlgebra
  have : IsScalarTower O (localAtGen hs) K'' := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hπϖ : algebraMap O (localAtGen hs) π =
      algebraMap (Algebra.adjoin F {s}) (localAtGen hs) (adjoinGen F s) ^ e :=
    Subtype.ext hπs
  have hπmem : π ∈ maximalIdeal O := by
    rw [hπ]
    exact Ideal.mem_span_singleton_self _
  have hint : ∀ w : localAtGen hs, _root_.IsIntegral O (algebraMap (localAtGen hs) K'' w) :=
    fun w ↦ isIntegral_of_mem_localizationSubalgebra hs hπmem he0 hπs hF
      ((mem_localAtGen hs).mp w.2)
  have : IsScalarTower (localAtGen hs) K'' N := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hUnr := Abhyankar.isUnramifiedWithRespectTo_of_tensor htame (Nat.pos_of_ne_zero he0) hdiv
    hint π hπ _ hϖ hπϖ t ht htF
  exact (IsDiscreteValuationRing.isUnramifiedWithRespectTo_iff_formallyUnramified
    (localAtGen hs) K'' N).mp hUnr

/-- **Primes over `(s)`.** If the integral closure of `F[s]_(s)` in a field `N` is formally
unramified, the integral closure of `F[s]` in `N` is unramified at every prime containing `s`. -/
theorem isUnramifiedAt_of_formallyUnramified_localAtGen {F K'' N : Type*} [Field F] [Field K'']
    [Algebra F K''] {s : K''} (hs : Transcendental F s) [IsFractionRing (Algebra.adjoin F {s}) K'']
    [Field N] [Algebra K'' N]
    [Algebra.FormallyUnramified (localAtGen hs) (integralClosure (localAtGen hs) N)]
    (P : Ideal (integralClosure (Algebra.adjoin F {s}) N)) [P.IsPrime]
    (hsP : algebraMap (Algebra.adjoin F {s}) (integralClosure (Algebra.adjoin F {s}) N)
      (adjoinGen F s) ∈ P) :
    Algebra.IsUnramifiedAt (Algebra.adjoin F {s}) P := by
  have hP₀ := isMaximal_span_adjoinGen hs
  have : IsLocalization.AtPrime (localAtGen hs) (Ideal.span {adjoinGen F s}) :=
    isLocalization_localAtGen hs
  have hle : Ideal.span {adjoinGen F s} ≤
      P.comap (algebraMap (Algebra.adjoin F {s}) (integralClosure (Algebra.adjoin F {s}) N)) :=
    (Ideal.span_singleton_le_iff_mem _).mpr hsP
  have heq := (hP₀.eq_of_le (Ideal.comap_isPrime _ P).ne_top hle).symm
  have hdisj : Disjoint ((Ideal.span {adjoinGen F s}).primeCompl : Set (Algebra.adjoin F {s}))
      (P.comap (algebraMap (Algebra.adjoin F {s}) (integralClosure (Algebra.adjoin F {s}) N))) :=
    Set.disjoint_left.mpr fun m hm hmP ↦ hm (heq ▸ hmP)
  have hM : ∀ m ∈ (Ideal.span {adjoinGen F s}).primeCompl,
      algebraMap (Algebra.adjoin F {s}) N m ≠ 0 := fun m hm h0 ↦
    coe_ne_zero_of_mem_primeCompl hm ((algebraMap K'' N).injective (h0.trans (map_zero _).symm))
  have : IsScalarTower (Algebra.adjoin F {s}) (localAtGen hs) N :=
    IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  exact isUnramifiedAt_of_isLocalization_integralClosure (Rf := localAtGen hs) _ hM P hdisj

set_option maxHeartbeats 1600000 in
/-- **Abhyankar's lemma at a Kummer level**, in the form used for `𝐆_m`. Let `O` be a discrete
valuation ring with uniformizer `π`, fraction field `K ⊆ Ω` and a tame field factor `L ⊆ Ω`
whose ramification indices divide `e`, invertible in the finite field `k ⊆ O`. Let `K'' ⊆ Ω`
contain `K` and be a fraction field of `F[s]`, `F` finite over `k`, with `π = s^e` and every
element of `O` of the form `r(s^e)/r'(s^e)`, `r'(0) ≠ 0`. Then for `N ⊆ Ω` finite separable over
`K''`, containing `L` and generated by it over `K''`, the integral closure of `F[s]` in `N` is
unramified at every prime containing `s`. -/
theorem isUnramifiedAt_of_abhyankar {k Ω : Type u} [Field k] [Finite k] [Field Ω] [Algebra k Ω]
    {O : Type u} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    {K : IntermediateField k Ω} [Algebra O K] [IsFractionRing O K] (ιk : k →+* O)
    (hιk : ∀ c : k, ((algebraMap O K (ιk c) : K) : Ω) = algebraMap k Ω c)
    {L : IntermediateField K Ω} [FiniteDimensional K L] [Algebra.IsSeparable K L] [Algebra O L]
    [IsScalarTower O K L] (htame : IsDiscreteValuationRing.IsTamelyRamifiedWithRespectTo O K L)
    {π : O} (hπ : maximalIdeal O = Ideal.span {π}) {e : ℕ} (he : ((e : ℕ) : k) ≠ 0)
    (hdiv : ∀ m : Ideal (integralClosure O L), m.IsMaximal → m.LiesOver (maximalIdeal O) →
      Ideal.ramificationIdx' (maximalIdeal O) m ∣ e)
    {F : IntermediateField k Ω} [FiniteDimensional k F] {K'' : IntermediateField F Ω} {s : K''}
    (hs : Transcendental F s) [IsFractionRing (Algebra.adjoin F {s}) K'']
    (hKK'' : ∀ z ∈ K, z ∈ K'') (hπs : ((algebraMap O K π : K) : Ω) = (s : Ω) ^ e)
    (hO : ∀ x : O, ∃ r r' : k[X], r'.coeff 0 ≠ 0 ∧
      ((algebraMap O K x : K) : Ω) * aeval ((s : Ω) ^ e) r' = aeval ((s : Ω) ^ e) r)
    {N : IntermediateField K'' Ω} [FiniteDimensional K'' N] [Algebra.IsSeparable K'' N]
    (hLN : ∀ z ∈ L, z ∈ N) (hNgen : ∀ y ∈ N, y ∈ Algebra.adjoin K'' (L : Set Ω))
    (P : Ideal (integralClosure (Algebra.adjoin F {s}) N)) [P.IsPrime]
    (hsP : algebraMap (Algebra.adjoin F {s}) (integralClosure (Algebra.adjoin F {s}) N)
      (adjoinGen F s) ∈ P) :
    Algebra.IsUnramifiedAt (Algebra.adjoin F {s}) P := by
  let : Algebra (Algebra.adjoin F {s}) N := inferInstance
  let : SMul (Algebra.adjoin F {s}) N := Algebra.toSMul
  have he0 : e ≠ 0 := fun h ↦ he (by rw [h, Nat.cast_zero])
  have hFmonic : ∀ f : F, (minpoly k f).Monic := fun f ↦
    minpoly.monic (Algebra.IsIntegral.isIntegral (R := k) f)
  have := Polynomial.isPrincipalIdealRing_adjoin F hs
  have hP₀ := isMaximal_span_adjoinGen hs
  -- `K ⊆ K''` is finite separable
  let : Algebra K K'' := (fieldInclusion hKK'').toAlgebra
  let : SMul K K'' := Algebra.toSMul
  let : Module K K'' := Algebra.toModule
  have : IsScalarTower k K K'' := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hcK : algebraMap K K'' (algebraMap O K π) = s ^ e := Subtype.ext hπs
  have hπ0 : algebraMap O K π ≠ 0 := by
    refine (map_ne_zero_iff _ (IsFractionRing.injective O K)).mpr fun h0 ↦ ?_
    apply IsDiscreteValuationRing.not_a_field O
    rw [hπ, h0, Ideal.span_singleton_eq_bot]
  have heK : ((e : ℕ) : K) ≠ 0 := by
    rw [← map_natCast (algebraMap k K)]
    exact (_root_.map_ne_zero _).mpr he
  obtain ⟨hKfd, hKsep⟩ := finiteDimensional_isSeparable_of_pow F K'' s heK _ hcK hπ0
  let : Algebra K N := ((algebraMap K'' N).comp (fieldInclusion hKK'')).toAlgebra
  let : SMul K N := Algebra.toSMul
  let : Module K N := Algebra.toModule
  have : IsScalarTower K K'' N := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  let : Algebra O K'' := ((algebraMap K K'').comp (algebraMap O K)).toAlgebra
  let : SMul O K'' := Algebra.toSMul
  have : IsScalarTower O K K'' := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hπs'' : algebraMap O K'' π = s ^ e := hcK
  -- the map `O → (localAtGen hs)`
  let h₀ : k[X] →+* Algebra.adjoin F {s} := eval₂RingHom (algebraMap k _) (adjoinGen F s ^ e)
  have hcoe : ∀ r : k[X], ((h₀ r : K'') : Ω) = aeval ((s : Ω) ^ e) r := fun r ↦ by
    let g : Algebra.adjoin F {s} →+* Ω :=
      K''.val.toRingHom.comp (Algebra.adjoin F {s}).val.toRingHom
    have h1 := Polynomial.hom_eval₂ r (algebraMap k (Algebra.adjoin F {s})) g (adjoinGen F s ^ e)
    have h2 : g.comp (algebraMap k (Algebra.adjoin F {s})) = algebraMap k Ω :=
      RingHom.ext fun _ ↦ rfl
    rw [h2, map_pow] at h1
    rw [aeval_def]
    exact h1
  have hev : ∀ r : k[X], evalZero hs (h₀ r) = algebraMap k F (r.coeff 0) := by
    intro r
    have h1 := Polynomial.hom_eval₂ r (algebraMap k _) (evalZero hs).toRingHom (adjoinGen F s ^ e)
    have h2 : (evalZero hs).toRingHom.comp (algebraMap k (Algebra.adjoin F {s})) =
        algebraMap k F :=
      RingHom.ext fun c ↦ (evalZero hs).commutes (algebraMap k F c)
    show (evalZero hs).toRingHom (eval₂ (algebraMap k _) (adjoinGen F s ^ e) r) = _
    rw [h1, h2, map_pow, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, evalZero_adjoinGen,
      zero_pow he0, eval₂_at_zero]
  have hmemO : ∀ x : O, algebraMap O K'' x ∈ (localAtGen hs) := by
    intro x
    obtain ⟨r, r', hr', hx⟩ := hO x
    have hr'P : h₀ r' ∈ (Ideal.span {adjoinGen F s}).primeCompl := fun hmem ↦ hr' (by
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hmem
      have := congrArg (evalZero hs) hc
      rw [map_mul, evalZero_adjoinGen, zero_mul, hev] at this
      exact (algebraMap k F).injective (this.trans (map_zero _).symm))
    have hr'0 := coe_ne_zero_of_mem_primeCompl hr'P
    rw [mem_localAtGen hs]
    refine ⟨h₀ r, h₀ r', hr'P, ?_⟩
    rw [IsFractionRing.mk'_eq_div]
    refine (eq_div_iff hr'0).mpr (Subtype.ext ?_)
    show ((algebraMap O K x : K) : Ω) * ((h₀ r' : K'') : Ω) = ((h₀ r : K'') : Ω)
    exact (congrArg (((algebraMap O K x : K) : Ω) * ·) (hcoe r')).trans (hx.trans (hcoe r).symm)
  have hkO'' : (algebraMap O K'').comp ιk = algebraMap k K'' :=
    RingHom.ext fun c ↦ Subtype.ext (hιk c)
  have hF : ∀ f : F, _root_.IsIntegral O (algebraMap F K'' f) := fun f ↦ by
    refine ⟨(minpoly k f).map ιk, (hFmonic f).map _, ?_⟩
    rw [eval₂_map, hkO'', ← aeval_def, aeval_algebraMap_apply, minpoly.aeval, map_zero]
  -- the map `L ⊗_K K'' → N`
  let fL : L →ₐ[K] N :=
    { toFun := fun z ↦ ⟨z, hLN z z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl
      commutes' := fun _ ↦ rfl }
  have hfL : Algebra.adjoin K'' (Set.range fL) = ⊤ := by
    rw [eq_top_iff]
    intro y _
    have hmap : (Algebra.adjoin K'' (Set.range fL)).map N.val =
        Algebra.adjoin K'' (L : Set Ω) := by
      rw [AlgHom.map_adjoin]
      congr 1
      ext z
      constructor
      · rintro ⟨_, ⟨l, rfl⟩, rfl⟩
        exact l.2
      · intro hz
        exact ⟨⟨z, hLN z hz⟩, ⟨⟨z, hz⟩, rfl⟩, rfl⟩
    have hy : (y : Ω) ∈ (Algebra.adjoin K'' (Set.range fL)).map N.val := by
      rw [hmap]
      exact hNgen y y.2
    obtain ⟨y', hy', hyy'⟩ := hy
    rwa [← Subtype.ext hyy']
  let t := Algebra.TensorProduct.productMap fL (IsScalarTower.toAlgHom K K'' N)
  have ht : Function.Surjective t := productMap_surjective_of_adjoin fL hfL
  have htF : ∀ f, t (1 ⊗ₜ f) = algebraMap K'' N f := fun f ↦ by
    rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
    rfl
  -- Abhyankar's lemma
  have : Algebra.FormallyUnramified (localAtGen hs) (integralClosure (localAtGen hs) N) :=
    formallyUnramified_localAtGen (O := O) (K := K) (L := L) (K'' := K'') (N := N) htame he0 hdiv
      hs hπ hπs'' hmemO hF t ht htF
  exact isUnramifiedAt_of_formallyUnramified_localAtGen hs P hsP

/-- **Abhyankar's lemma at a Kummer level, for a point of a cover.** The form of
`isUnramifiedAt_of_abhyankar` in which `L = K(ψ(C))` and `N = K''(ψ(C))` come from a point `ψ` of a
finite unramified algebra `C` over `k[x]_x`, and `π ↦ u = s^e`. -/
theorem isUnramifiedAt_of_abhyankar_of_cover {k Ω : Type u} [Field k] [Finite k] [Field Ω]
    [Algebra k Ω] {O : Type u} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    {K : IntermediateField k Ω} [Algebra O K] [IsFractionRing O K] (ιk : k →+* O)
    (hιk : ∀ c : k, ((algebraMap O K (ιk c) : K) : Ω) = algebraMap k Ω c)
    {C : Type u} [CommRing C] (φ : Ring k →+* C) (hfin : φ.Finite) (hfu : φ.FormallyUnramified)
    (ψ : C →+* Ω) (g : Ring k →+* K) (hg : ∀ z, ((g z : K) : Ω) = ψ (φ z))
    {L : IntermediateField K Ω} (hL : L = IntermediateField.adjoin K (Set.range ψ))
    [FiniteDimensional K L] [Algebra.IsSeparable K L] [Algebra O L]
    [IsScalarTower O K L] (htame : IsDiscreteValuationRing.IsTamelyRamifiedWithRespectTo O K L)
    {π : O} (hπ : maximalIdeal O = Ideal.span {π}) {u : Ω}
    (hπu : ((algebraMap O K π : K) : Ω) = u) (hKu : ∀ z ∈ K, z ∈ IntermediateField.adjoin k {u})
    (hO : ∀ x : O, ∃ r r' : k[X], r'.coeff 0 ≠ 0 ∧
      ((algebraMap O K x : K) : Ω) * aeval u r' = aeval u r)
    {e : ℕ} (he : ((e : ℕ) : k) ≠ 0)
    (hdiv : ∀ m : Ideal (integralClosure O L), m.IsMaximal → m.LiesOver (maximalIdeal O) →
      Ideal.ramificationIdx' (maximalIdeal O) m ∣ e)
    {F : IntermediateField k Ω} [FiniteDimensional k F] {K'' : IntermediateField F Ω} {s : K''}
    (hs : Transcendental F s) [IsFractionRing (Algebra.adjoin F {s}) K'']
    (hse : (s : Ω) ^ e = u) {N : IntermediateField K'' Ω}
    (hN : IntermediateField.adjoin K'' (Set.range ψ) = N)
    (P : Ideal (integralClosure (Algebra.adjoin F {s}) N)) [P.IsPrime]
    (hsP : algebraMap (Algebra.adjoin F {s}) (integralClosure (Algebra.adjoin F {s}) N)
      (adjoinGen F s) ∈ P) :
    Algebra.IsUnramifiedAt (Algebra.adjoin F {s}) P := by
  subst hN hse
  have hKK'' : ∀ z ∈ K, z ∈ K'' := fun z hz ↦
    (IntermediateField.adjoin_simple_le_iff.mpr
      (show (s : Ω) ^ e ∈ K''.restrictScalars k from pow_mem s.2 e)) (hKu z hz)
  obtain ⟨hNfd, hNsep, hNint⟩ :=
    cover_adjoin_facts φ ψ hfin hfu ((fieldInclusion hKK'').comp g) fun z ↦ hg z
  have hψN : ∀ c, ψ c ∈ IntermediateField.adjoin K'' (Set.range ψ) := fun c ↦
    IntermediateField.subset_adjoin K'' _ ⟨c, rfl⟩
  have hKN : ∀ z ∈ K, z ∈ IntermediateField.adjoin K'' (Set.range ψ) := fun z hz ↦
    (IntermediateField.adjoin K'' (Set.range ψ)).algebraMap_mem (⟨z, hKK'' z hz⟩ : K'')
  let N' : IntermediateField K Ω :=
    { (IntermediateField.adjoin K'' (Set.range ψ)).toSubfield with
      algebraMap_mem' := fun c ↦ hKN c c.2 }
  have hLN : L ≤ N' := hL ▸ IntermediateField.adjoin_le_iff.mpr (Set.range_subset_iff.mpr hψN)
  have hNgen : ∀ y ∈ IntermediateField.adjoin K'' (Set.range ψ),
      y ∈ Algebra.adjoin K'' (L : Set Ω) := by
    intro y hy
    rw [← IntermediateField.mem_toSubalgebra,
      IntermediateField.adjoin_toSubalgebra_of_isAlgebraic (fun x hx ↦ by
        obtain ⟨c, rfl⟩ := hx
        exact (hNint c).isAlgebraic)] at hy
    refine Algebra.adjoin_mono (Set.range_subset_iff.mpr fun c ↦ ?_) hy
    rw [hL]
    exact IntermediateField.subset_adjoin K _ (Set.mem_range_self c)
  exact isUnramifiedAt_of_abhyankar ιk hιk htame hπ he hdiv hs hKK'' hπu hO
    (fun z hz ↦ hLN hz) hNgen P hsP

end Generic

section Main

variable {Ω : Type u} [Field Ω] [Algebra k Ω] {C : Type u} [CommRing C]

/-- The residue characteristic at `(x)` is that of `k`. -/
theorem ringChar_residue_originPoint :
    ringChar (stalkAt k (originPoint k) ⧸ maximalIdeal (stalkAt k (originPoint k))) =
      ringChar k := by
  let : Algebra k (stalkAt k (originPoint k) ⧸ maximalIdeal (stalkAt k (originPoint k))) :=
    ((Ideal.Quotient.mk _).comp ((algebraMap k[X] _).comp (algebraMap k k[X]))).toAlgebra
  exact (Algebra.ringChar_eq k _).symm

variable [Finite k]

set_option maxHeartbeats 1600000 in
/-- **Abhyankar's lemma at the boundary point `(x)`.** For a finite unramified cover of
`𝐆_{m,k}` tame at `(x)` and a point of it over `x ↦ u`, there is `E₀` prime to `q` such that at
every Kummer level `s^e = u` with `E₀ ∣ e` and `q ∤ e`, the integral closure of `F[s]` in
`K''(ψ(C))` is unramified at the primes containing `s`. -/
theorem exists_forall_isUnramifiedAt_of_tame (φ : Ring k →+* C) (hfin : φ.Finite)
    (hfu : φ.FormallyUnramified)
    (htame : Stacks.FundamentalGroup.IsTamelyRamifiedInCodimensionOne (chartZero k)
      (Spec.map (CommRingCat.ofHom φ)))
    (ψ : C →+* Ω) {u : Ω} (hu : Transcendental k u)
    (hψ : ∀ r : k[X], ψ (φ (algebraMap k[X] (Ring k) r)) = aeval u r) :
    ∃ E₀ : ℕ, E₀ ≠ 0 ∧ (ringChar k).Coprime E₀ ∧ ∀ e : ℕ, E₀ ∣ e → (ringChar k).Coprime e →
      ∀ (F : IntermediateField k Ω) [FiniteDimensional k F] (K'' : IntermediateField F Ω)
        (s : K''), Transcendental F s → ∀ [IsFractionRing (Algebra.adjoin F {s}) K''],
        (s : Ω) ^ e = u → ∀ (N : IntermediateField K'' Ω),
        IntermediateField.adjoin K'' (Set.range ψ) = N →
        ∀ (P : Ideal (integralClosure (Algebra.adjoin F {s}) N)) [P.IsPrime],
          algebraMap (Algebra.adjoin F {s}) (integralClosure (Algebra.adjoin F {s}) N)
            (adjoinGen F s) ∈ P → Algebra.IsUnramifiedAt (Algebra.adjoin F {s}) P := by
  classical
  -- the local field `K = k(u)` at `(x)` and the field factor `L = K(ψ(C))`
  set O := stalkAt k (originPoint k)
  set K := IntermediateField.adjoin k {u}
  let : Algebra O K := (stalkToAdjoin hu).toAlgebra
  have : IsFractionRing O K := isFractionRing_stalkToAdjoin hu
  have hOK : ∀ r : k[X], algebraMap O K (algebraMap k[X] O r) = polyToAdjoin u r :=
    stalkToAdjoin_algebraMap hu
  have hgK : ∀ z, algebraMap K Ω (ringToAdjoin hu z) = ψ (φ z) := by
    have : ((algebraMap K Ω).comp (ringToAdjoin hu)) = ψ.comp φ := by
      refine IsLocalization.ringHom_ext (Submonoid.powers (X : k[X])) (RingHom.ext fun r ↦ ?_)
      simp only [RingHom.comp_apply]
      rw [ringToAdjoin_algebraMap, hψ]
      exact coe_polyToAdjoin r
    exact fun z ↦ RingHom.congr_fun this z
  obtain ⟨hLfd, hLsep, -⟩ := cover_adjoin_facts φ ψ hfin hfu (ringToAdjoin hu) hgK
  set L := IntermediateField.adjoin K (Set.range ψ)
  let : Algebra O L := ((algebraMap K L).comp (algebraMap O K)).toAlgebra
  have : IsScalarTower O K L := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  let ψL : C →+* L := ψ.codRestrict L fun c ↦ IntermediateField.subset_adjoin K _ ⟨c, rfl⟩
  have hψL : ∀ r : k[X], ψL (φ (algebraMap k[X] (Ring k) r)) =
      algebraMap O L (algebraMap k[X] O r) := fun r ↦ Subtype.ext (by
    show ψ (φ _) = ((algebraMap O K (algebraMap k[X] O r) : K) : Ω)
    rw [hOK, hψ, coe_polyToAdjoin])
  have hgen : Algebra.adjoin K (Set.range ψL) = ⊤ := by
    have hrange : Set.range ψL = Subtype.val ⁻¹' Set.range ψ := by
      ext x
      constructor
      · rintro ⟨c, rfl⟩
        exact ⟨c, rfl⟩
      · rintro ⟨c, hc⟩
        exact ⟨c, Subtype.ext hc⟩
    rw [← IntermediateField.adjoin_toSubalgebra_of_isAlgebraic
      (fun x _ ↦ Algebra.IsAlgebraic.isAlgebraic x), hrange, adjoin_preimage_val_eq_top,
      IntermediateField.top_toSubalgebra]
  have htameL : IsDiscreteValuationRing.IsTamelyRamifiedWithRespectTo O K L :=
    isTamelyRamifiedWithRespectTo_of_chartZero φ htame (originPoint k) (Ideal.subset_span rfl)
      K L ψL hψL hgen
  -- the product of the ramification indices
  have : IsDedekindDomain (integralClosure O L) := integralClosure.isDedekindDomain O K L
  have : Module.IsTorsionFree O (integralClosure O L) :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr fun x y h ↦ IsFractionRing.injective O K
      ((algebraMap K L).injective (congrArg Subtype.val h))
  have : Algebra.IsIntegral O (integralClosure O L) := inferInstance
  have : Fintype k := Fintype.ofFinite k
  set E₀ : ℕ := ∏ P : (maximalIdeal O).primesOver (integralClosure O L),
    Ideal.ramificationIdx' (maximalIdeal O) P.1
  have hp : (ringChar k).Prime := by
    obtain ⟨p, hchar, n, hp, -⟩ := FiniteField.card' k
    rw [ringChar.eq k p]
    exact hp
  have hcopP : ∀ P : (maximalIdeal O).primesOver (integralClosure O L),
      (ringChar k).Coprime (Ideal.ramificationIdx' (maximalIdeal O) P.1) := by
    rintro ⟨P, hPp, hPl⟩
    have := hPp
    have := hPl
    have hc : P.comap (algebraMap O (integralClosure O L)) = maximalIdeal O :=
      (Ideal.LiesOver.over (P := P) (p := maximalIdeal O)).symm
    have hmax : P.IsMaximal := Ideal.isMaximal_of_isIntegral_of_isMaximal_under (R := O) P (by
      rw [Ideal.under, hc]
      infer_instance)
    rcases (htameL P hmax hPl).2 with h0 | h
    · rw [ringChar_residue_originPoint] at h0
      exact absurd h0 hp.ne_zero
    · rwa [ringChar_residue_originPoint] at h
  have hE₀ : E₀ ≠ 0 := Finset.prod_ne_zero_iff.mpr fun P _ h0 ↦ by
    have := hcopP P
    rw [h0, Nat.coprime_zero_right] at this
    exact hp.one_lt.ne' this
  have hdivE₀ : ∀ m : Ideal (integralClosure O L), m.IsMaximal → m.LiesOver (maximalIdeal O) →
      Ideal.ramificationIdx' (maximalIdeal O) m ∣ E₀ := fun m hm hl ↦
    Finset.dvd_prod_of_mem (fun P : (maximalIdeal O).primesOver (integralClosure O L) ↦
      Ideal.ramificationIdx' (maximalIdeal O) P.1) (Finset.mem_univ ⟨m, hm.isPrime, hl⟩)
  have hcopE₀ : (ringChar k).Coprime E₀ := Nat.Coprime.prod_right fun P _ ↦ hcopP P
  clear_value E₀
  refine ⟨E₀, hE₀, hcopE₀, ?_⟩
  intro e hE₀e hecop F _ K'' s hs _ hse N hN P _ hsP
  have : CharP k (ringChar k) := ringChar.charP k
  have hek : ((e : ℕ) : k) ≠ 0 := by
    rw [Ne, CharP.cast_eq_zero_iff k (ringChar k)]
    exact fun hdvd ↦ hp.one_lt.ne' (Nat.Coprime.eq_one_of_dvd hecop hdvd)
  have hιk : ∀ c : k, ((algebraMap O K ((algebraMap k[X] O).comp (algebraMap k k[X]) c) : K) : Ω) =
      algebraMap k Ω c := fun c ↦ by
    rw [RingHom.comp_apply, hOK, coe_polyToAdjoin, ← C_eq_algebraMap, aeval_C]
  have hπu : ((algebraMap O K originUniformizer : K) : Ω) = u := by
    rw [hOK, coe_polyToAdjoin, aeval_X]
  exact isUnramifiedAt_of_abhyankar_of_cover _ hιk φ hfin hfu ψ (ringToAdjoin hu) hgK rfl htameL
    maximalIdeal_stalk_eq hπu (fun z hz ↦ hz) (exists_mul_aeval_eq_stalkToAdjoin hu) hek
    (fun m hm hl ↦ (hdivE₀ m hm hl).trans hE₀e) hs hse hN P hsP

end Main

