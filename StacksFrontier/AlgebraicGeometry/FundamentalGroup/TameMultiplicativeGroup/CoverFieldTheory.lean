module

public import Mathlib.FieldTheory.SeparableClosure
public import Mathlib.RingTheory.Unramified.Field
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic

/-!
# Points of a finite unramified algebra in a field

Let `C` be a finite formally unramified `A`-algebra and `ψ : C → Ω` an `A`-algebra map into a
field, and let `E ⊆ Ω` be a field over `A`. The `E`-subalgebra of `Ω` generated by `ψ(C)` is the
image of the finite formally unramified `E`-algebra `E ⊗_A C`, hence a finite field extension of
`E` which is formally unramified, that is separable. So every `ψ(c)` is separable and integral
over `E`, and `E(ψ(C))` is a finite separable extension of `E`.

## Main results

* `AlgebraicGeometry.TameMultiplicativeGroup.isSeparable_of_formallyUnramified`: each `ψ(c)` is
  separable over `E`.
* `AlgebraicGeometry.TameMultiplicativeGroup.isIntegral_of_finite`: each `ψ(c)` is integral over
  `E`.
* `AlgebraicGeometry.TameMultiplicativeGroup.finiteDimensional_adjoin_range`: `E(ψ(C))` is
  finite-dimensional over `E`.
* `AlgebraicGeometry.TameMultiplicativeGroup.isSeparable_adjoin_range`: `E(ψ(C))` is separable
  over `E`.
-/

@[expose] public noncomputable section

open scoped TensorProduct

namespace AlgebraicGeometry.TameMultiplicativeGroup

variable {A C E Ω : Type*} [CommRing A] [CommRing C] [Field E] [Field Ω] [Algebra A C]
  [Algebra A E] [Algebra E Ω] [Algebra A Ω] [IsScalarTower A E Ω] (ψ : C →ₐ[A] Ω)

/-- The `E`-algebra map `E ⊗_A C → Ω` of `ψ`. -/
def tensorLift : E ⊗[A] C →ₐ[E] Ω :=
  Algebra.TensorProduct.lift (Algebra.ofId E Ω) ψ fun _ _ ↦ Commute.all _ _

/-- The map `tensorLift ψ` sends `e ⊗ c` to `e * ψ(c)`. -/
theorem tensorLift_tmul (e : E) (c : C) : tensorLift ψ (e ⊗ₜ c) = algebraMap E Ω e * ψ c :=
  Algebra.TensorProduct.lift_tmul _ _ _ _ _

/-- Each `ψ(c)` lies in the image of `E ⊗_A C`. -/
theorem mem_range_tensorLift (c : C) : ψ c ∈ (tensorLift (E := E) ψ).range :=
  ⟨1 ⊗ₜ c, by
    show tensorLift ψ (1 ⊗ₜ c) = ψ c
    rw [tensorLift_tmul, map_one, one_mul]⟩

variable [Module.Finite A C]

/-- The image of `E ⊗_A C` in `Ω` is a finite `E`-module. -/
instance : Module.Finite E (tensorLift (E := E) ψ).range :=
  Module.Finite.of_surjective (tensorLift (E := E) ψ).rangeRestrict.toLinearMap
    (tensorLift (E := E) ψ).rangeRestrict_surjective

/-- The image of `E ⊗_A C` in `Ω` is a field. -/
theorem isField_range_tensorLift : IsField (tensorLift (E := E) ψ).range :=
  isField_of_isIntegral_of_isField' (Field.toIsField E)

/-- The image of `E ⊗_A C`, as an intermediate field. -/
def rangeField : IntermediateField E Ω :=
  { (tensorLift (E := E) ψ).range with
    inv_mem' := fun x hx ↦ (tensorLift (E := E) ψ).range.inv_mem_of_algebraic
      (x := ⟨x, hx⟩) (Algebra.IsIntegral.isIntegral (R := E)
        (⟨x, hx⟩ : (tensorLift (E := E) ψ).range)).isAlgebraic.algebraMap }

/-- Each `ψ(c)` lies in `rangeField ψ`. -/
theorem mem_rangeField (c : C) : ψ c ∈ rangeField (E := E) ψ := mem_range_tensorLift ψ c

/-- The intermediate field `rangeField ψ` is finite-dimensional over `E`. -/
instance : FiniteDimensional E (rangeField (E := E) ψ) :=
  inferInstanceAs (Module.Finite E (tensorLift (E := E) ψ).range)

/-- The elements `ψ(c)` are integral over `E`. -/
theorem isIntegral_of_finite (c : C) : _root_.IsIntegral E (ψ c) :=
  (Algebra.IsIntegral.isIntegral (R := E) (⟨ψ c, mem_rangeField ψ c⟩ :
    rangeField (E := E) ψ)).algebraMap

/-- The field `E(ψ(C))` is contained in `rangeField ψ`. -/
theorem adjoin_range_le_rangeField :
    IntermediateField.adjoin E (Set.range ψ) ≤ rangeField (E := E) ψ :=
  IntermediateField.adjoin_le_iff.mpr (Set.range_subset_iff.mpr fun c ↦ mem_rangeField ψ c)

/-- **`E(ψ(C))` is finite over `E`.** -/
theorem finiteDimensional_adjoin_range :
    FiniteDimensional E (IntermediateField.adjoin E (Set.range ψ)) :=
  FiniteDimensional.of_injective
    (IntermediateField.inclusion (adjoin_range_le_rangeField ψ)).toLinearMap
    (IntermediateField.inclusion (adjoin_range_le_rangeField ψ)).injective

variable [Algebra.FormallyUnramified A C]

/-- **The elements `ψ(c)` are separable over `E`.** -/
theorem isSeparable_of_formallyUnramified (c : C) : IsSeparable E (ψ c) := by
  have : Algebra.FormallyUnramified E (rangeField (E := E) ψ) :=
    Algebra.FormallyUnramified.of_surjective (tensorLift (E := E) ψ).rangeRestrict
      (tensorLift (E := E) ψ).rangeRestrict_surjective
  have : Algebra.IsSeparable E (rangeField (E := E) ψ) :=
    Algebra.FormallyUnramified.isSeparable E _
  have h := Algebra.IsSeparable.isSeparable E (⟨ψ c, mem_rangeField ψ c⟩ : rangeField (E := E) ψ)
  rwa [IsSeparable, ← minpoly.algHom_eq (rangeField (E := E) ψ).val Subtype.val_injective] at h

/-- **`E(ψ(C))` is separable over `E`.** -/
theorem isSeparable_adjoin_range :
    Algebra.IsSeparable E (IntermediateField.adjoin E (Set.range ψ)) :=
  (IntermediateField.isSeparable_adjoin_iff_isSeparable E Ω).mpr fun _ ⟨c, hc⟩ ↦
    hc ▸ isSeparable_of_formallyUnramified ψ c

end AlgebraicGeometry.TameMultiplicativeGroup

end
