/-!
# Injectivity on fundamental groups of a closed immersion in positive characteristic

Let `i : Z ⟶ X` be a closed immersion of connected affine schemes over `𝐅_p`. Then the induced
map `π₁(Z, z) ⟶ π₁(X, z)` on étale fundamental groups is injective.

The kernel of the induced map is trivial as soon as every finite étale cover of `Z` admits a
monomorphism into the restriction to `Z` of a finite étale cover of `X`: the element acts
trivially on the fibre of the restriction, hence on the subfibre. Such a dominating cover is
produced by the characteristic-`p` device of tag 0G1H — over `𝐅_p` a finite étale cover of a
closed subscheme of `𝐀ⁿ` is an open-and-closed part of the restriction of a finite étale cover
of `𝐀ⁿ` — after `Z` has been replaced by a closed subscheme of an affine space. That replacement
is the limit step: `Γ(Z, ⊤)` is the filtered colimit of the subalgebras generated by its finite
subsets, so the given cover already comes from one of them by tag 0BTV, and a finite-type
`𝐅_p`-algebra is a quotient of a polynomial ring in finitely many variables. Surjectivity of
`Γ(X, ⊤) ⟶ Γ(Z, ⊤)` lifts the chosen generators to `Γ(X, ⊤)`, which is what makes the square
over the affine space commute and lets the cover of `𝐀ⁿ` be pulled back to `X`.

## Main results

* `AlgebraicGeometry.injective_etaleFundamentalGroupMap_of_forall_exists_mono` — triviality of
  the kernel in the presence of dominating finite étale covers of the ambient scheme.
* `AlgebraicGeometry.injective_etaleFundamentalGroupMap_of_isClosedImmersion` — Stacks 0G1I.

## Implementation notes

Being a scheme over `𝐅_p` is the condition `(p : Γ(X, ⊤)) = 0` on the ring of global sections,
`p` prime; no base field is part of the data, and the closed subscheme inherits the condition
through the surjection on global sections. The field used internally is `ULift (ZMod p)`, which
is where tag 0G1H — stated over a field in the universe of the schemes — is applied.

## References

* [Stacks Project, Tag 0G1I](https://stacks.math.columbia.edu/tag/0G1I)
* [Stacks Project, Tag 0G1H](https://stacks.math.columbia.edu/tag/0G1H)
* [Stacks Project, Tag 0BTV](https://stacks.math.columbia.edu/tag/0BTV)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-! ### Triviality of the kernel -/

/-- The fibre functor at a geometric point is injective on a morphism of finite étale covers
whose underlying morphism of schemes is a monomorphism. -/
private theorem injective_finiteEtaleFiberFunctor_map {X : Scheme.{u}} (x : GeometricPoint X)
    {V W : FiniteEtaleOver X} (j : V ⟶ W) [Mono j.left] :
    Function.Injective ((finiteEtaleFiberFunctor x).map j) := by
  intro a b hab
  apply Subtype.ext
  apply (cancel_mono j.left).1
  simpa [finiteEtaleFiberFunctor] using congrArg Subtype.val hab

/-- An element of the fundamental group acting trivially on the fibre of a cover acts trivially
on the fibre of any cover mapping into it by a monomorphism. -/
private theorem app_eq_self_of_mono_factor {Z : Scheme.{u}} [ConnectedSpace Z]
    (z : GeometricPoint Z) (σ : EtaleFundamentalGroup Z z) {V W : FiniteEtaleOver Z}
    (j : V ⟶ W) [Mono j.left]
    (hW : ∀ y : finiteEtaleFiber z W, (σ.app W).hom y = y)
    (y : finiteEtaleFiber z V) :
    (σ.app V).hom y = y := by
  apply injective_finiteEtaleFiberFunctor_map z j
  have hn := congrArg (fun f ↦ f y) (NatTrans.naturality σ.hom j)
  change (σ.app W).hom ((finiteEtaleFiberFunctor z).map j y)
    = (finiteEtaleFiberFunctor z).map j ((σ.app V).hom y) at hn
  rw [hW] at hn
  exact hn.symm

/-- An element of the kernel of the induced map acts trivially on the fibre of the restriction
to `Z` of any finite étale cover of `X`. -/
private theorem app_eq_self_of_finiteEtaleBaseChange {Z X : Scheme.{u}} [ConnectedSpace Z]
    [ConnectedSpace X] (i : Z ⟶ X) (z : GeometricPoint Z) (σ : EtaleFundamentalGroup Z z)
    (hσ : etaleFundamentalGroupMap i z σ = 1) (U : FiniteEtaleOver X)
    (y : finiteEtaleFiber z ((finiteEtaleBaseChange i).obj U)) :
    (σ.app ((finiteEtaleBaseChange i).obj U)).hom y = y := by
  apply (finiteEtaleFiberProjectionEquiv i z U).injective
  show finiteEtaleFiberProjection i z U
      ((σ.app ((finiteEtaleBaseChange i).obj U)).hom y) = _
  rw [etaleFundamentalGroupMap_finiteEtaleFiberProjection i z U σ y, hσ]
  rfl

/-- **Triviality of the kernel from dominating covers.** Let `i : Z ⟶ X` be a morphism of
connected schemes such that every finite étale cover of `Z` maps monomorphically into the
restriction to `Z` of a finite étale cover of `X`. Then the induced map on étale fundamental
groups is injective. -/
theorem injective_etaleFundamentalGroupMap_of_forall_exists_mono {Z X : Scheme.{u}}
    [ConnectedSpace Z] [ConnectedSpace X] (i : Z ⟶ X) (z : GeometricPoint Z)
    (hdom : ∀ V : FiniteEtaleOver Z, ∃ (U : FiniteEtaleOver X)
      (j : V ⟶ (finiteEtaleBaseChange i).obj U), Mono j.left) :
    Function.Injective (etaleFundamentalGroupMap i z) := by
  refine (injective_iff_map_eq_one _).mpr fun σ hσ ↦ ?_
  apply Aut.ext
  ext V y
  obtain ⟨U, j, _⟩ := hdom V
  exact app_eq_self_of_mono_factor z σ j (app_eq_self_of_finiteEtaleBaseChange i z σ hσ U) y

/-! ### Transport of dominating covers -/

/-- The underlying morphism of schemes of an isomorphism of finite étale covers is an
isomorphism. -/
private theorem isIso_left_of_iso {S : Scheme.{u}} {V W : FiniteEtaleOver S} (e : V ≅ W) :
    IsIso e.hom.left :=
  ⟨e.inv.left, by rw [← MorphismProperty.Comma.comp_left, e.hom_inv_id]; rfl,
    by rw [← MorphismProperty.Comma.comp_left, e.inv_hom_id]; rfl⟩

/-- Base change preserves monomorphisms between finite étale covers. -/
private theorem mono_finiteEtaleBaseChange_map_left {S T : Scheme.{u}} (q : T ⟶ S)
    {V W : FiniteEtaleOver S} (j : V ⟶ W) [Mono j.left] :
    Mono ((finiteEtaleBaseChange q).map j).left := by
  refine ⟨fun a b hab ↦ finiteEtaleBaseChangeProj_hom_ext q V ((cancel_mono j.left).1 ?_) ?_⟩
  · rw [Category.assoc, Category.assoc, ← finiteEtaleBaseChangeProj_naturality q j,
      reassoc_of% hab]
  · rw [← MorphismProperty.Over.w ((finiteEtaleBaseChange q).map j), reassoc_of% hab]

/-- **Transport of a dominating cover along a commuting square.** Given a commuting square
`i ≫ h = q ≫ i₀`, a cover of `Z` coming from a cover `W` of `Z₀` and a monomorphism from `W`
into the restriction of a cover `U` of `X₀`, the restriction to `X` of `U` dominates the given
cover of `Z`. -/
private theorem exists_mono_of_commSq {Z X Z₀ X₀ : Scheme.{u}} (i : Z ⟶ X) (q : Z ⟶ Z₀)
    (i₀ : Z₀ ⟶ X₀) (h : X ⟶ X₀) (hsq : i ≫ h = q ≫ i₀) {V : FiniteEtaleOver Z}
    {W : FiniteEtaleOver Z₀} (e : V ≅ (finiteEtaleBaseChange q).obj W)
    (U : FiniteEtaleOver X₀) (j : W ⟶ (finiteEtaleBaseChange i₀).obj U) [Mono j.left] :
    ∃ (U' : FiniteEtaleOver X) (j' : V ⟶ (finiteEtaleBaseChange i).obj U'), Mono j'.left := by
  let η : finiteEtaleBaseChange i₀ ⋙ finiteEtaleBaseChange q
      ≅ finiteEtaleBaseChange h ⋙ finiteEtaleBaseChange i :=
    (finiteEtaleBaseChangeComp q i₀ (i ≫ h) hsq).symm ≪≫ finiteEtaleBaseChangeComp i h
  refine ⟨(finiteEtaleBaseChange h).obj U,
    e.hom ≫ (finiteEtaleBaseChange q).map j ≫ η.hom.app U, ?_⟩
  have : IsIso e.hom.left := isIso_left_of_iso e
  have : IsIso (η.hom.app U).left := isIso_left_of_iso (η.app U)
  have := mono_finiteEtaleBaseChange_map_left q j
  rw [MorphismProperty.Comma.comp_left, MorphismProperty.Comma.comp_left]
  infer_instance

/-! ### Descent of a cover to a finitely generated subalgebra -/

/-- The subalgebras of `R` generated by the finite subsets, with their inclusions. -/
private def fgSubalgebraDiagram (k : Type u) [CommRing k] (R : CommRingCat.{u}) [Algebra k R] :
    Finset R ⥤ CommRingCat.{u} where
  obj s := .of (Algebra.adjoin k (s : Set R))
  map f := CommRingCat.ofHom
    (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom f)))).toRingHom
  map_id _ := by ext; rfl
  map_comp _ _ := by ext; rfl

/-- The cocone on the finitely generated subalgebras of `R` with vertex `R`. -/
private def fgSubalgebraCocone (k : Type u) [CommRing k] (R : CommRingCat.{u}) [Algebra k R] :
    Cocone (fgSubalgebraDiagram k R) where
  pt := R
  ι :=
    { app := fun s ↦ CommRingCat.ofHom (Algebra.adjoin k (s : Set R)).val.toRingHom
      naturality := fun _ _ _ ↦ by ext; rfl }

/-- A ring is the filtered colimit of the subalgebras generated by its finite subsets. -/
private def fgSubalgebraCoconeIsColimit (k : Type u) [CommRing k] (R : CommRingCat.{u})
    [Algebra k R] : IsColimit (fgSubalgebraCocone k R) := by
  classical
  letI := reflectsColimit_of_reflectsIsomorphisms (fgSubalgebraDiagram k R) (forget CommRingCat)
  apply isColimitOfReflects (forget CommRingCat)
  apply Types.FilteredColimit.isColimitOf'
  · intro x
    exact ⟨{x}, ⟨x, Algebra.subset_adjoin (Finset.mem_singleton_self x)⟩, rfl⟩
  · intro s x y hxy
    exact ⟨s, 𝟙 s, congrArg _ (Subtype.ext hxy)⟩

/-- `Spec R` is the inverse limit of the spectra of the subalgebras generated by the finite
subsets of `R`. -/
private def fgSubalgebraSpecCone (k : Type u) [CommRing k] (R : CommRingCat.{u}) [Algebra k R] :
    Cone ((fgSubalgebraDiagram k R).op ⋙ Scheme.Spec) :=
  Scheme.Spec.mapCone (fgSubalgebraCocone k R).op

/-- The cone of spectra of finitely generated subalgebras is a limit cone. -/
private def fgSubalgebraSpecConeIsLimit (k : Type u) [CommRing k] (R : CommRingCat.{u})
    [Algebra k R] : IsLimit (fgSubalgebraSpecCone k R) :=
  isLimitOfPreserves Scheme.Spec (fgSubalgebraCoconeIsColimit k R).op

/-- **A finite étale cover of an affine scheme comes from a finitely generated subalgebra.**
A finite étale cover of `Spec R` is the base change of a finite étale cover of the spectrum of
a finitely generated `k`-subalgebra of `R`. -/
@[ega "IV 11.2.7" "special case"]
private theorem exists_fgSubalgebra_finiteEtale_model (k : Type u) [CommRing k]
    (R : CommRingCat.{u}) [Algebra k R] {Z : Scheme.{u}} (e : Z ≅ Spec R)
    (V : FiniteEtaleOver Z) :
    ∃ (R₀ : Subalgebra k R) (W : FiniteEtaleOver (Spec (.of R₀))), R₀.FG ∧
      Nonempty (V ≅ (finiteEtaleBaseChange
        (e.hom ≫ Spec.map (CommRingCat.ofHom R₀.val.toRingHom))).obj W) := by
  have : ∀ i, IsAffine (((fgSubalgebraDiagram k R).op ⋙ Scheme.Spec).obj i) :=
    fun _ ↦ inferInstanceAs (IsAffine (Spec _))
  have : ∀ {i j : (Finset R)ᵒᵖ} (f : i ⟶ j),
      IsAffineHom (((fgSubalgebraDiagram k R).op ⋙ Scheme.Spec).map f) := fun _ ↦ inferInstance
  have : ∀ i, CompactSpace (((fgSubalgebraDiagram k R).op ⋙ Scheme.Spec).obj i) :=
    fun _ ↦ Scheme.compactSpace_of_isAffine _
  have : ∀ i, QuasiSeparatedSpace (((fgSubalgebraDiagram k R).op ⋙ Scheme.Spec).obj i) :=
    fun _ ↦ quasiSeparatedSpace_of_isAffine _
  have : IsIso (show Z ⟶ (fgSubalgebraSpecCone k R).pt from e.hom) :=
    ⟨e.inv, e.hom_inv_id, e.inv_hom_id⟩
  obtain ⟨s, W, hW⟩ := exists_finiteEtale_model ((fgSubalgebraDiagram k R).op ⋙ Scheme.Spec)
    ((fgSubalgebraSpecCone k R).extend e.hom)
    (IsLimit.extendIso (s := fgSubalgebraSpecCone k R) e.hom
      (fgSubalgebraSpecConeIsLimit k R)) V
  exact ⟨Algebra.adjoin k (s.unop : Set R), W, ⟨s.unop, rfl⟩, hW⟩

/-! ### The characteristic-`p` device -/

/-- **A dominating finite étale cover over affine space.** Over a field of positive
characteristic, a finite étale cover of a closed subscheme of affine space maps monomorphically
into the restriction of a finite étale cover of affine space. -/
private theorem exists_finiteEtale_mono_over_affineSpace (k : Type u) [Field k] (p : ℕ)
    [CharP k p] (hp : 0 < p) (n : ℕ) {Z₀ : Scheme.{u}}
    (i₀ : Z₀ ⟶ Spec (.of (MvPolynomial (Fin n) k))) [IsClosedImmersion i₀]
    (W : FiniteEtaleOver Z₀) :
    ∃ (U : FiniteEtaleOver (Spec (.of (MvPolynomial (Fin n) k))))
      (j : W ⟶ (finiteEtaleBaseChange i₀).obj U), Mono j.left := by
  have : IsFinite W.hom := W.prop.1
  have : Etale W.hom := W.prop.2
  obtain ⟨U, f, hf, hef, j, _, hclosed, hcomp⟩ :=
    exists_finiteEtale_openClosed_pullback k p hp n i₀ W.hom
  have hj : Mono j := ((IsClosedImmersion.iff_isFinite_and_mono j).mp hclosed).2
  exact ⟨MorphismProperty.Over.mk ⊤ f ⟨hf, hef⟩,
    MorphismProperty.Over.homMk j hcomp trivial, hj⟩

/-- **A dominating finite étale cover over an affine scheme in positive characteristic.**
A finite étale cover of the source of a closed immersion of affine schemes in characteristic
`p` maps monomorphically into the restriction of a finite étale cover of the target. -/
private theorem exists_finiteEtale_mono_of_isClosedImmersion_aux (k : Type u) [Field k] (p : ℕ)
    [CharP k p] (hp : 0 < p) {Z X : Scheme.{u}} [IsAffine Z] [IsAffine X] (i : Z ⟶ X)
    [IsClosedImmersion i] (alg : Algebra k Γ(X, ⊤)) (V : FiniteEtaleOver Z) :
    ∃ (U : FiniteEtaleOver X) (j : V ⟶ (finiteEtaleBaseChange i).obj U), Mono j.left := by
  classical
  let : Algebra k Γ(X, ⊤) := alg
  let : Algebra Γ(X, ⊤) Γ(Z, ⊤) := i.appTop.hom.toAlgebra
  let : Algebra k Γ(Z, ⊤) := (i.appTop.hom.comp (algebraMap k Γ(X, ⊤))).toAlgebra
  have : IsScalarTower k Γ(X, ⊤) Γ(Z, ⊤) := .of_algebraMap_eq fun _ ↦ rfl
  obtain ⟨R₀, W, hR₀fg, ⟨equiv⟩⟩ :=
    exists_fgSubalgebra_finiteEtale_model k Γ(Z, ⊤) Z.isoSpec V
  obtain ⟨n, φ₀, hsurj₀⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
    ((Subalgebra.fg_iff_finiteType R₀).mp hR₀fg)
  have hα : Function.Surjective i.appTop.hom :=
    (IsClosedImmersion.isAffine_surjective_of_isAffine i).2
  choose lift hlift using fun j : Fin n ↦ hα (φ₀ (MvPolynomial.X j) : Γ(Z, ⊤))
  let φA : MvPolynomial (Fin n) k →ₐ[k] Γ(X, ⊤) := MvPolynomial.aeval lift
  have halg : algebraMap Γ(X, ⊤) Γ(Z, ⊤) = i.appTop.hom := rfl
  have hfactorAlg :
      (IsScalarTower.toAlgHom k Γ(X, ⊤) Γ(Z, ⊤)).comp φA = R₀.val.comp φ₀ := by
    apply MvPolynomial.algHom_ext
    intro j
    simpa [φA, IsScalarTower.toAlgHom, halg] using hlift j
  let i₀ : Spec (.of R₀) ⟶ Spec (.of (MvPolynomial (Fin n) k)) :=
    Spec.map (CommRingCat.ofHom φ₀.toRingHom)
  have : IsClosedImmersion i₀ := IsClosedImmersion.spec_of_surjective _ hsurj₀
  let q₀ : Spec Γ(Z, ⊤) ⟶ Spec (.of R₀) := Spec.map (CommRingCat.ofHom R₀.val.toRingHom)
  let h : X ⟶ Spec (.of (MvPolynomial (Fin n) k)) :=
    X.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom φA.toRingHom)
  have hcat : CommRingCat.ofHom (R₀.val.toRingHom.comp φ₀.toRingHom)
      = CommRingCat.ofHom φA.toRingHom ≫ i.appTop :=
    CommRingCat.hom_ext (congrArg AlgHom.toRingHom hfactorAlg).symm
  have hsq : i ≫ h = (Z.isoSpec.hom ≫ q₀) ≫ i₀ := by
    calc i ≫ h = (i ≫ X.isoSpec.hom) ≫ Spec.map (CommRingCat.ofHom φA.toRingHom) := by
          rw [Category.assoc]
      _ = Z.isoSpec.hom ≫ Spec.map i.appTop
            ≫ Spec.map (CommRingCat.ofHom φA.toRingHom) := by
          rw [← Scheme.isoSpec_hom_naturality i, Category.assoc]
      _ = Z.isoSpec.hom
            ≫ Spec.map (CommRingCat.ofHom (R₀.val.toRingHom.comp φ₀.toRingHom)) := by
          rw [hcat, Spec.map_comp]
      _ = (Z.isoSpec.hom ≫ q₀) ≫ i₀ := by
          rw [Category.assoc, ← Spec.map_comp]
          rfl
  obtain ⟨U, j, _⟩ := exists_finiteEtale_mono_over_affineSpace k p hp n i₀ W
  exact exists_mono_of_commSq i (Z.isoSpec.hom ≫ q₀) i₀ h hsq equiv U j

/-- **Stacks Project, Tag 0G1I.** A closed immersion of connected affine schemes over `𝐅_p`
induces an injection on étale fundamental groups. Being a scheme over `𝐅_p` is spelled as
`p` being zero in the ring of global sections of the ambient scheme. -/
@[stacks 0G1I]
theorem injective_etaleFundamentalGroupMap_of_isClosedImmersion (p : ℕ) (hp : p.Prime)
    {Z X : Scheme.{u}} [ConnectedSpace Z] [ConnectedSpace X] [IsAffine Z] [IsAffine X]
    (i : Z ⟶ X) [IsClosedImmersion i] (hX : (p : Γ(X, ⊤)) = 0) (z : GeometricPoint Z) :
    Function.Injective (etaleFundamentalGroupMap i z) := by
  have := Fact.mk hp
  exact injective_etaleFundamentalGroupMap_of_forall_exists_mono i z fun V ↦
    exists_finiteEtale_mono_of_isClosedImmersion_aux (ULift.{u} (ZMod p)) p hp.pos i
      ((ZMod.castHom (ringChar.dvd hX) Γ(X, ⊤)).comp
        (ULift.ringEquiv : ULift.{u} (ZMod p) ≃+* ZMod p).toRingHom).toAlgebra V

end AlgebraicGeometry

end
