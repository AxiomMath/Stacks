/-!
# The geometric and arithmetic fundamental groups of a scheme over a field

Let `k` be a field with algebraic closure `k̄`, and let `X` be a quasi-compact and
quasi-separated scheme over `k` whose base change `X_{k̄}` is connected. This file proves Stacks
0BTX: the sequence of étale fundamental groups

```
1 → π₁(X_{k̄}) → π₁(X) → π₁(Spec k) → 1
```

is a short exact sequence of profinite groups.

## Main results

* `AlgebraicGeometry.injective_etaleFundamentalGroupMap_of_finiteEtale` — a finite étale
  morphism of connected schemes induces an injection on étale fundamental groups.
* `AlgebraicGeometry.mem_range_etaleFundamentalGroupMap_of_map_eq_one` — an element of `π₁(X)`
  that is trivial in `π₁(B)` lies in the image of `π₁(V ×_B X)` for every finite étale cover
  `V` of `B` with connected base change.
* `AlgebraicGeometry.injective_etaleFundamentalGroupMap_of_isLimit` and
  `AlgebraicGeometry.mem_range_etaleFundamentalGroupMap_of_isLimit` — injectivity, and membership
  in the image, for the homomorphism induced by the map from a cofiltered limit to a fixed
  scheme, read off the stages.
* `AlgebraicGeometry.injective_and_ker_le_range_etaleFundamentalGroupMap_of_isSeparable` — for a
  separable algebraic extension `L/k`, `π₁(X_L) → π₁(X)` is injective and its image contains the
  kernel of `π₁(X) → π₁(Spec k)`.
* `AlgebraicGeometry.shortExact_etaleFundamentalGroupMap_isAlgClosure` — **Stacks 0BTX.**

## Proof

The proof follows the alternative route in which no Galois-stable closed subset is needed. Write
`L` for the separable closure of `k` in `k̄`.

First, `X_L` is the limit of the schemes `X_E = X ×_k Spec E`, over the subfields `E = k[s]` of
`L` generated by finite subsets `s`. Each `E` is finite separable over `k`, so `X_E ⟶ X` is finite
étale. The stages `X_E` are connected because `X_{k̄}` maps onto them. By Stacks 0BTV
(`AlgebraicGeometry.etaleFundamentalGroup_homeomorph_compatibleFamilies`), `π₁(X_L)` is the
limit of the `π₁(X_E)`.

* Each `π₁(X_E) → π₁(X)` is injective, because `X_E ⟶ X` is finite étale, so the limit map
  `π₁(X_L) → π₁(X)` is injective.
* The image of `π₁(X_E) → π₁(X)` is the stabilizer of the point of the fibre of `X_E` given by
  the base point (`AlgebraicGeometry.range_etaleFundamentalGroupMap_eq_stabilizer`). Since
  `X_E` is the base change of the finite étale cover `Spec E` of `Spec k`, an element of the
  kernel of `π₁(X) → π₁(Spec k)` fixes every point of its fibre. So a kernel element lies in the
  image of every `π₁(X_E)`. The preimages form a compatible family, because the maps to `π₁(X)`
  are injective, so they come from one element of `π₁(X_L)`.

Second, `k̄/L` is purely inseparable, so `X_{k̄} ⟶ X_L` is a universal homeomorphism and induces
an isomorphism of fundamental groups (Stacks 0BQN,
`AlgebraicGeometry.etaleFundamentalGroupMap_bijective_of_universalHomeomorphism`). Combined with
the surjectivity of `π₁(X) → π₁(Spec k)` and the triviality of the composite, which the base
proves in `AlgebraicGeometry.surjective_etaleFundamentalGroupMap_isAlgClosed` and
`AlgebraicGeometry.etaleFundamentalGroupMap_comp_eq_one_isAlgClosed`, this gives the short
exact sequence.

## References

* [Stacks Project, Tag 0BTX](https://stacks.math.columbia.edu/tag/0BTX)
* [Stacks Project, Tag 0BTV](https://stacks.math.columbia.edu/tag/0BTV)
* [Stacks Project, Tag 0BQN](https://stacks.math.columbia.edu/tag/0BQN)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-! ### Finite étale morphisms -/

/-- **A finite étale morphism of connected schemes is injective on étale fundamental groups.**
A finite étale cover `V` of `T` is finite étale over `S` through `f`, and `V` embeds into the
base change of that cover to `T` by the graph of its structure morphism. -/
theorem injective_etaleFundamentalGroupMap_of_finiteEtale {T S : Scheme.{u}} [ConnectedSpace T]
    [ConnectedSpace S] (f : T ⟶ S) (hf : finiteEtale f) (t : GeometricPoint T) :
    Function.Injective (etaleFundamentalGroupMap f t) := by
  refine injective_etaleFundamentalGroupMap_of_forall_exists_mono f t fun V ↦ ?_
  let a : V.left ⟶ pullback (V.hom ≫ f) f :=
    pullback.lift (𝟙 V.left) V.hom (Category.id_comp _)
  refine ⟨(finiteEtaleCompose hf).obj V,
    MorphismProperty.Over.homMk a (pullback.lift_snd _ _ _) trivial, ?_⟩
  refine ⟨fun {Z} b c h ↦ ?_⟩
  have h' := congrArg (· ≫ pullback.fst (V.hom ≫ f) f) h
  change (b ≫ a) ≫ pullback.fst (V.hom ≫ f) f = (c ≫ a) ≫ pullback.fst (V.hom ≫ f) f at h'
  simpa only [a, Category.assoc, pullback.lift_fst, Category.comp_id] using h'

/-- **An element of the kernel lies in the image of the fundamental group of a base-changed
cover.** Let `f : X ⟶ B` be a morphism of connected schemes and `V` a finite étale cover of `B`
whose base change `T = V ×_B X` is connected. An element of `π₁(X)` sent to `1` in `π₁(B)` fixes
every point of the fibre of `T`, in particular the point given by the base point, so it lies in
the image of `π₁(T) → π₁(X)`, which is that point's stabilizer. -/
theorem mem_range_etaleFundamentalGroupMap_of_map_eq_one {X B : Scheme.{u}} [ConnectedSpace X]
    [ConnectedSpace B] (f : X ⟶ B) (V : FiniteEtaleOver B) [ConnectedSpace ↥(pullback V.hom f)]
    (t : GeometricPoint (pullback V.hom f))
    (σ : EtaleFundamentalGroup X (t.map (pullback.snd V.hom f)))
    (hσ : etaleFundamentalGroupMap f (t.map (pullback.snd V.hom f)) σ = 1) :
    σ ∈ (etaleFundamentalGroupMap (pullback.snd V.hom f) t).toMonoidHom.range := by
  have hW : finiteEtale (pullback.snd V.hom f) := ((finiteEtaleBaseChange f).obj V).prop
  rw [range_etaleFundamentalGroupMap_eq_stabilizer hW t, MulAction.mem_stabilizer_iff]
  apply (finiteEtaleFiberProjectionEquiv f (t.map (pullback.snd V.hom f)) V).injective
  have h := etaleFundamentalGroupMap_finiteEtaleFiberProjection f (t.map (pullback.snd V.hom f))
    V σ (finiteEtaleOverSourcePoint hW t)
  rwa [hσ] at h

/-- If `a ≫ b = c` and two elements have equal images under `c`, their images under `b ∘ a`
agree. -/
private theorem map_map_eq_of_map_eq {X Y Z : Scheme.{u}} [ConnectedSpace X] [ConnectedSpace Y]
    [ConnectedSpace Z] (a : X ⟶ Y) (b : Y ⟶ Z) (c : X ⟶ Z) (h : a ≫ b = c) (x : GeometricPoint X)
    {σ τ : EtaleFundamentalGroup X x}
    (hστ : etaleFundamentalGroupMap c x σ = etaleFundamentalGroupMap c x τ) :
    etaleFundamentalGroupMap b (x.map a) (etaleFundamentalGroupMap a x σ) =
      etaleFundamentalGroupMap b (x.map a) (etaleFundamentalGroupMap a x τ) :=
  eq_of_heq ((etaleFundamentalGroupMap_triangle a b c h x σ).trans
    ((heq_of_eq hστ).trans (etaleFundamentalGroupMap_triangle a b c h x τ).symm))

/-! ### Fundamental groups of a cofiltered limit, read off the stages -/

section Limit

variable {I : Type u} [Category.{u} I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Cone D)
  (hc : IsLimit c) [∀ {i j : I} (a : i ⟶ j), IsAffineHom (D.map a)]
  [∀ i : I, CompactSpace (D.obj i)] [∀ i : I, QuasiSeparatedSpace (D.obj i)]
  [∀ i : I, ConnectedSpace (D.obj i)] [ConnectedSpace c.pt]
  {X : Scheme.{u}} [ConnectedSpace X] (g : c.pt ⟶ X) (p : ∀ i, D.obj i ⟶ X)
  (hp : ∀ i, c.π.app i ≫ p i = g)

include hc hp in
/-- **Injectivity from the stages.** If every stage `Xᵢ` of a cofiltered limit `X_∞` of
quasi-compact and quasi-separated schemes with affine transition morphisms maps to `X` compatibly
with `g : X_∞ ⟶ X`, and each `π₁(Xᵢ) → π₁(X)` is injective, then so is `π₁(X_∞) → π₁(X)`: an
element of `π₁(X_∞)` is determined by its images in the `π₁(Xᵢ)` (Stacks 0BTV). -/
theorem injective_etaleFundamentalGroupMap_of_isLimit
    (hi : ∀ i (z : GeometricPoint (D.obj i)), Function.Injective (etaleFundamentalGroupMap (p i) z))
    (x : GeometricPoint c.pt) :
    Function.Injective (etaleFundamentalGroupMap g x) := by
  let (j : I) : ConnectedSpace (((Functor.const I).obj c.pt).obj j) :=
    inferInstanceAs (ConnectedSpace c.pt)
  let i₀ : I := Classical.choice IsCofiltered.nonempty
  obtain ⟨hconn, hGroup, hTop, e, he⟩ :=
    etaleFundamentalGroup_homeomorph_compatibleFamilies D c hc i₀ x
  intro σ τ hστ
  apply e.injective
  apply Subtype.ext
  funext j
  rw [he, he]
  apply hi j.left (x.map (c.π.app j.left))
  exact map_map_eq_of_map_eq _ _ _ (hp j.left) x hστ

include hc hp in
/-- **Membership in the image from the stages.** In the situation of
`AlgebraicGeometry.injective_etaleFundamentalGroupMap_of_isLimit`, suppose moreover that the maps
`pᵢ : Xᵢ ⟶ X` are compatible with the transition morphisms. An element of `π₁(X)` that lies in
the image of every `π₁(Xᵢ)` lies in the image of `π₁(X_∞)`: its preimages form a compatible family,
by injectivity, and Stacks 0BTV provides an element of `π₁(X_∞)` with these coordinates. -/
theorem mem_range_etaleFundamentalGroupMap_of_isLimit
    (hD : ∀ {i j} (a : i ⟶ j), D.map a ≫ p j = p i)
    (hi : ∀ i (z : GeometricPoint (D.obj i)), Function.Injective (etaleFundamentalGroupMap (p i) z))
    (x : GeometricPoint c.pt) (σ : EtaleFundamentalGroup X (x.map g))
    (hσ : ∀ i, ∃ τ : EtaleFundamentalGroup (D.obj i) (x.map (c.π.app i)),
      HEq (etaleFundamentalGroupMap (p i) (x.map (c.π.app i)) τ) σ) :
    σ ∈ (etaleFundamentalGroupMap g x).toMonoidHom.range := by
  classical
  choose τ hτ using hσ
  let (j : I) : ConnectedSpace (((Functor.const I).obj c.pt).obj j) :=
    inferInstanceAs (ConnectedSpace c.pt)
  let i₀ : I := Classical.choice IsCofiltered.nonempty
  obtain ⟨hconn, hGroup, hTop, e, he⟩ :=
    etaleFundamentalGroup_homeomorph_compatibleFamilies D c hc i₀ x
  have hinjHEq : ∀ (i : I) {z z' : GeometricPoint (D.obj i)} (_ : z = z')
      {a : EtaleFundamentalGroup (D.obj i) z} {b : EtaleFundamentalGroup (D.obj i) z'},
      HEq (etaleFundamentalGroupMap (p i) z a) (etaleFundamentalGroupMap (p i) z' b) →
        HEq a b := by
    rintro i z _ rfl a b h
    exact heq_of_eq (hi i z (eq_of_heq h))
  have hcompatible : CompatibleFundamentalGroupFamily D c i₀ x (fun j ↦ τ j.left) := by
    intro i j a
    apply hinjHEq j.left (geometricPoint_map_cone D c x a.left)
    exact (etaleFundamentalGroupMap_triangle (D.map a.left) (p j.left) (p i.left) (hD a.left)
      (x.map (c.π.app i.left)) (τ i.left)).trans ((hτ i.left).trans (hτ j.left).symm)
  obtain ⟨ρ, hρ⟩ := e.surjective ⟨fun j ↦ τ j.left, hcompatible⟩
  refine ⟨ρ, ?_⟩
  have hcoord := congrArg (fun q ↦ q.1 (Over.mk (𝟙 i₀))) hρ
  simp only [he] at hcoord
  exact eq_of_heq
    ((etaleFundamentalGroupMap_triangle (c.π.app i₀) (p i₀) g (hp i₀) x ρ).symm.trans
      ((heq_of_eq (congrArg (etaleFundamentalGroupMap (p i₀) (x.map (c.π.app i₀))) hcoord)).trans
        (hτ i₀)))

end Limit

/-! ### Base change to a separable algebraic extension -/

section Separable

variable (k L : Type u) [Field k] [Field L] [Algebra k L]

/-- The subalgebra `k[s]` generated by a finite subset of an algebraic extension is finite over
`k`. -/
private theorem module_finite_adjoin_finset [Algebra.IsAlgebraic k L] (s : Finset L) :
    Module.Finite k (Algebra.adjoin k (s : Set L)) :=
  Algebra.finite_adjoin_of_finite_of_isIntegral s.finite_toSet
    fun x _ ↦ (Algebra.IsAlgebraic.isAlgebraic (R := k) x).isIntegral

/-- `Spec k[s] ⟶ Spec k` is finite. -/
private theorem isFinite_specMap_adjoin_finset [Algebra.IsAlgebraic k L] (s : Finset L) :
    IsFinite (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (s : Set L))))) := by
  rw [IsFinite.SpecMap_iff]
  exact RingHom.finite_algebraMap.mpr (module_finite_adjoin_finset k L s)

/-- `Spec k[s] ⟶ Spec k` is étale when `L/k` is separable: `k[s]` is then a finite separable
field extension of `k`. -/
private theorem etale_specMap_adjoin_finset [Algebra.IsSeparable k L] (s : Finset L) :
    Etale (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (s : Set L))))) := by
  let A := Algebra.adjoin k (s : Set L)
  have := module_finite_adjoin_finset k L s
  let : Field A := (Subalgebra.isField_of_algebraic A).toField
  have : Algebra.IsSeparable k A := Algebra.IsSeparable.of_algHom k L A.val
  have : Algebra.FinitePresentation k A :=
    (Algebra.FinitePresentation.of_finiteType (R := k) (A := A)).mp inferInstance
  have : Algebra.FormallyEtale k A := Algebra.FormallyEtale.of_isSeparable k A
  have : Algebra.Etale k A := ⟨inferInstance, inferInstance⟩
  exact HasRingHomProperty.Spec_iff.mpr (RingHom.etale_algebraMap.mpr inferInstance)

/-- `Spec L ⟶ Spec k[s]` is surjective: `L` is integral over the subalgebra `k[s]`. -/
private theorem surjective_specMap_val_adjoin_finset [Algebra.IsAlgebraic k L] (s : Finset L) :
    Surjective (Spec.map (CommRingCat.ofHom (Algebra.adjoin k (s : Set L)).val.toRingHom)) := by
  let A := Algebra.adjoin k (s : Set L)
  have hint : (A.val.toRingHom : A →+* L).IsIntegral := fun x ↦
    (Algebra.IsAlgebraic.isAlgebraic (R := k) x).isIntegral.tower_top
  exact ⟨RingHom.IsIntegral.comap_surjective hint Subtype.val_injective⟩

/-- The projection `X_L ⟶ X_{k[s]}` is the base change of `Spec L ⟶ Spec k[s]`. -/
private theorem isPullback_bcProj {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) (s : (Finset L)ᵒᵖ) :
    IsPullback (AdjoinFinset.bcProj k L f s)
      (pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap k L))) f)
      (pullback.fst (Spec.map (CommRingCat.ofHom
        (algebraMap k (Algebra.adjoin k (s.unop : Set L))))) f)
      (Spec.map (CommRingCat.ofHom (Algebra.adjoin k (s.unop : Set L)).val.toRingHom)) := by
  have hcomp : Spec.map (CommRingCat.ofHom (Algebra.adjoin k (s.unop : Set L)).val.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (s.unop : Set L)))) =
      Spec.map (CommRingCat.ofHom (algebraMap k L)) := by
    rw [← Spec.map_comp]
    rfl
  refine IsPullback.of_right (h₁₂ := pullback.snd _ f) (v₁₃ := f)
    (h₂₂ := Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (s.unop : Set L)))))
    ?_ (AdjoinFinset.bcProj_fst k L f s) (IsPullback.of_hasPullback _ _).flip
  rw [AdjoinFinset.bcProj_snd, hcomp]
  exact (IsPullback.of_hasPullback _ _).flip

/-- Mapping a geometric point along two composable morphisms is mapping it along the
composite. -/
private theorem geometricPoint_map_map_of_comp {X Y Z : Scheme.{u}} (a : X ⟶ Y) (b : Y ⟶ Z)
    (c : X ⟶ Z) (h : a ≫ b = c) (x : GeometricPoint X) : (x.map a).map b = x.map c := by
  cases x
  simp only [GeometricPoint.map, Category.assoc, h]

/-- An element of the kernel at a geometric point equal to the image of `y`, under a morphism
whose image at `y` contains the kernel, comes from the source. The two base points are only
propositionally equal, hence the heterogeneous equality. -/
private theorem exists_heq_of_ker_le_range {Y Z S : Scheme.{u}} [ConnectedSpace Y]
    [ConnectedSpace Z] [ConnectedSpace S] (b : Y ⟶ Z) (f : Z ⟶ S) (y : GeometricPoint Y)
    (z : GeometricPoint Z) (hz : y.map b = z)
    (hb : ∀ σ : EtaleFundamentalGroup Z (y.map b), etaleFundamentalGroupMap f (y.map b) σ = 1 →
      σ ∈ (etaleFundamentalGroupMap b y).toMonoidHom.range)
    (σ : EtaleFundamentalGroup Z z) (hσ : etaleFundamentalGroupMap f z σ = 1) :
    ∃ τ : EtaleFundamentalGroup Y y, HEq (etaleFundamentalGroupMap b y τ) σ := by
  subst z
  obtain ⟨τ, hτ⟩ := hb σ hσ
  exact ⟨τ, heq_of_eq hτ⟩

/-- **The separable case of Stacks 0BTX.** Let `L/k` be a separable algebraic extension and `X` a
quasi-compact and quasi-separated scheme over `k` whose base change `X_L` is connected. Then
`π₁(X_L) → π₁(X)` is injective, and its image contains the kernel of `π₁(X) → π₁(Spec k)`.

`X_L` is the limit of the `X_{k[s]}`, `s ⊆ L` finite, each of which is finite étale over `X`;
see the module docstring. -/
@[sga "1 IX 6.1" "partial", sga "7 I 5.2" "partial"]
theorem injective_and_ker_le_range_etaleFundamentalGroupMap_of_isSeparable
    [Algebra.IsSeparable k L] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [CompactSpace X]
    [QuasiSeparatedSpace X] [ConnectedSpace X]
    [ConnectedSpace ↥(pullback (Spec.map (CommRingCat.ofHom (algebraMap k L))) f)]
    (x : GeometricPoint (pullback (Spec.map (CommRingCat.ofHom (algebraMap k L))) f)) :
    Function.Injective (etaleFundamentalGroupMap
        (pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap k L))) f) x) ∧
      (etaleFundamentalGroupMap f
          (x.map (pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap k L))) f))).toMonoidHom.ker
        ≤ (etaleFundamentalGroupMap (pullback.snd
          (Spec.map (CommRingCat.ofHom (algebraMap k L))) f) x).toMonoidHom.range := by
  let g := pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap k L))) f
  let D := AdjoinFinset.bcDiagram k L f
  let c := AdjoinFinset.bcCone k L f
  let hc : IsLimit c := AdjoinFinset.isLimitBcCone k L f
  let V : (Finset L)ᵒᵖ → FiniteEtaleOver (Spec (.of k)) := fun s ↦
    MorphismProperty.Over.mk ⊤
      (Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (s.unop : Set L)))))
      ⟨isFinite_specMap_adjoin_finset k L s.unop, etale_specMap_adjoin_finset k L s.unop⟩
  let p : ∀ s, D.obj s ⟶ X := fun s ↦ pullback.snd (V s).hom f
  have hpfe : ∀ s, finiteEtale (p s) := fun s ↦ ((finiteEtaleBaseChange f).obj (V s)).prop
  have : ∀ s, IsFinite (p s) := fun s ↦ (hpfe s).1
  have : ConnectedSpace c.pt :=
    inferInstanceAs (ConnectedSpace ↥(pullback (Spec.map (CommRingCat.ofHom (algebraMap k L))) f))
  have : ∀ s, CompactSpace (D.obj s) := fun s ↦ QuasiCompact.compactSpace_of_compactSpace (p s)
  have : ∀ s, QuasiSeparatedSpace (D.obj s) := fun s ↦ quasiSeparatedSpace_of_quasiSeparated (p s)
  have hDconn : ∀ s, ConnectedSpace (D.obj s) := fun s ↦ by
    have : Surjective (AdjoinFinset.bcProj k L f s) :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback (isPullback_bcProj k L f s).flip
        (surjective_specMap_val_adjoin_finset k L s.unop)
    exact (AdjoinFinset.bcProj k L f s).surjective.connectedSpace
      (AdjoinFinset.bcProj k L f s).continuous
  have : ∀ {s t : (Finset L)ᵒᵖ} (a : s ⟶ t), IsAffineHom (D.map a) := fun a ↦
    AdjoinFinset.bcDiagram_isAffineHom k L f a
  have hp : ∀ s, c.π.app s ≫ p s = g := fun s ↦ AdjoinFinset.bcProj_snd k L f s
  have hD : ∀ {s t} (a : s ⟶ t), D.map a ≫ p t = p s := fun a ↦
    Over.w ((Over.pullback f).map ((AdjoinFinset.specOverDiagram k L).map a))
  have hi : ∀ s (z : GeometricPoint (D.obj s)),
      Function.Injective (etaleFundamentalGroupMap (p s) z) := fun s z ↦
    injective_etaleFundamentalGroupMap_of_finiteEtale (p s) (hpfe s) z
  refine ⟨injective_etaleFundamentalGroupMap_of_isLimit D c hc g p hp hi x, fun σ hσ ↦ ?_⟩
  refine mem_range_etaleFundamentalGroupMap_of_isLimit D c hc g p hp hD hi x σ fun s ↦ ?_
  have : ConnectedSpace ↥(pullback (V s).hom f) := hDconn s
  exact exists_heq_of_ker_le_range (p s) f (x.map (c.π.app s)) (x.map g)
    (geometricPoint_map_map_of_comp _ _ _ (hp s) x)
    (mem_range_etaleFundamentalGroupMap_of_map_eq_one f (V s) (x.map (c.π.app s)))
    σ hσ

end Separable

/-! ### The short exact sequence -/

/-- A composite of morphisms injective on étale fundamental groups is injective on them. -/
private theorem injective_etaleFundamentalGroupMap_of_comp {X Y Z : Scheme.{u}}
    [ConnectedSpace X] [ConnectedSpace Y] [ConnectedSpace Z] (a : X ⟶ Y) (b : Y ⟶ Z) (c : X ⟶ Z)
    (h : a ≫ b = c) (x : GeometricPoint X) (ha : Function.Injective (etaleFundamentalGroupMap a x))
    (hb : Function.Injective (etaleFundamentalGroupMap b (x.map a))) :
    Function.Injective (etaleFundamentalGroupMap c x) := fun _ _ hστ ↦
  ha (hb (map_map_eq_of_map_eq a b c h x hστ))

/-- If `a` is surjective on étale fundamental groups, an element in the image of `b` lies in the
image of the composite `c = a ≫ b`. -/
private theorem mem_range_etaleFundamentalGroupMap_of_comp {X Y Z : Scheme.{u}}
    [ConnectedSpace X] [ConnectedSpace Y] [ConnectedSpace Z] (a : X ⟶ Y) (b : Y ⟶ Z) (c : X ⟶ Z)
    (h : a ≫ b = c) (x : GeometricPoint X)
    (ha : Function.Surjective (etaleFundamentalGroupMap a x))
    (σ : EtaleFundamentalGroup Z (x.map c))
    (hσ : ∃ τ : EtaleFundamentalGroup Y (x.map a), HEq (etaleFundamentalGroupMap b (x.map a) τ) σ) :
    σ ∈ (etaleFundamentalGroupMap c x).toMonoidHom.range := by
  obtain ⟨τ, hτ⟩ := hσ
  obtain ⟨ρ, rfl⟩ := ha τ
  exact ⟨ρ, eq_of_heq ((etaleFundamentalGroupMap_triangle a b c h x ρ).symm.trans hτ)⟩

/-- **Stacks Project, Tag 0BTX.** Let `k` be a field with algebraic closure `k̄`, and `X` a
quasi-compact and quasi-separated scheme over `k` whose base change `X_{k̄}` is connected. Then
`X` is connected
(`AlgebraicGeometry.connectedSpace_of_connectedSpace_pullback_specMap_algebraMap`), and for a
geometric point `x` of `X_{k̄}` the sequence of continuous homomorphisms of étale fundamental
groups

```
1 → π₁(X_{k̄}, x) → π₁(X, x) → π₁(Spec k, x) → 1
```

induced by the projection `X_{k̄} ⟶ X` and the structure morphism `X ⟶ Spec k` is exact. The
first map is injective, its image is the kernel of the second, and the second is surjective. The
three groups are profinite (`AlgebraicGeometry.isProfiniteTop_etaleFundamentalGroup`).

The proof is described in the module docstring. -/
@[stacks 0BTX "the full short exact sequence: injectivity, exactness in the middle, \
surjectivity",
  sga "1 IX 6.1" "special case",
  sga "1 XIII 4.4" "special case",
  sga "7 I 5.2" "more general"]
theorem shortExact_etaleFundamentalGroupMap_isAlgClosure (k kbar : Type u) [Field k]
    [Field kbar] [Algebra k kbar] [IsAlgClosure k kbar] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [CompactSpace X] [QuasiSeparatedSpace X]
    [ConnectedSpace ↥(pullback f (Spec.map (CommRingCat.ofHom (algebraMap k kbar))))]
    (x : GeometricPoint (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k kbar))))) :
    letI : ConnectedSpace ↥X :=
      connectedSpace_of_connectedSpace_pullback_specMap_algebraMap k kbar f
    Function.Injective (etaleFundamentalGroupMap
        (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k kbar)))) x) ∧
      (etaleFundamentalGroupMap
          (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k kbar)))) x).toMonoidHom.range =
        (etaleFundamentalGroupMap f (x.map (pullback.fst f
          (Spec.map (CommRingCat.ofHom (algebraMap k kbar)))))).toMonoidHom.ker ∧
      Function.Surjective (etaleFundamentalGroupMap f
        (x.map (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k kbar)))))) := by
  have : ConnectedSpace ↥X := connectedSpace_of_connectedSpace_pullback_specMap_algebraMap k kbar f
  have : IsAlgClosed kbar := IsAlgClosure.isAlgClosed k
  have : Algebra.IsAlgebraic k kbar := IsAlgClosure.isAlgebraic
  let L := separableClosure k kbar
  let gbar := Spec.map (CommRingCat.ofHom (algebraMap k kbar))
  let gL := Spec.map (CommRingCat.ofHom (algebraMap k L))
  let e := Spec.map (CommRingCat.ofHom (algebraMap L kbar))
  have hcomp : e ≫ gL = gbar := by
    rw [← Spec.map_comp]
    exact congrArg Spec.map (congrArg CommRingCat.ofHom
      (IsScalarTower.algebraMap_eq k L kbar).symm)
  let q : pullback f gbar ⟶ pullback gL f :=
    pullback.lift (pullback.snd f gbar ≫ e) (pullback.fst f gbar)
      (by rw [Category.assoc, hcomp, pullback.condition])
  have hq : q ≫ pullback.snd gL f = pullback.fst f gbar := pullback.lift_snd _ _ _
  have hsq : IsPullback q (pullback.snd f gbar) (pullback.fst gL f) e := by
    refine IsPullback.of_right (h₁₂ := pullback.snd gL f) (v₁₃ := f) (h₂₂ := gL) ?_
      (pullback.lift_fst _ _ _) (IsPullback.of_hasPullback gL f).flip
    rw [hq, hcomp]
    exact IsPullback.of_hasPullback f gbar
  have : UniversalHomeomorphism q :=
    ⟨(MorphismProperty.universally_isStableUnderBaseChange
      (topologically @IsHomeomorph)).of_isPullback hsq.flip
      (universalHomeomorphism_specMap_algebraMap L kbar).universally_isHomeomorph⟩
  have : ConnectedSpace ↥(pullback gL f) :=
    (UniversalHomeomorphism.universally_isHomeomorph (f := q) _ _ _
      IsPullback.of_id_snd).surjective.connectedSpace q.continuous
  obtain ⟨hinj, hker⟩ :=
    injective_and_ker_le_range_etaleFundamentalGroupMap_of_isSeparable k L f (x.map q)
  have hbij := etaleFundamentalGroupMap_bijective_of_universalHomeomorphism q x
  refine ⟨injective_etaleFundamentalGroupMap_of_comp q _ _ hq x hbij.1 hinj, le_antisymm ?_ ?_,
    surjective_etaleFundamentalGroupMap_isAlgClosed k kbar f _⟩
  · rintro _ ⟨τ, rfl⟩
    exact DFunLike.congr_fun (etaleFundamentalGroupMap_comp_eq_one_isAlgClosed k kbar f x) τ
  · intro σ hσ
    exact mem_range_etaleFundamentalGroupMap_of_comp q _ _ hq x hbij.2 σ
      (exists_heq_of_ker_le_range (pullback.snd gL f) f (x.map q) _
        (geometricPoint_map_map_of_comp q _ _ hq x) (fun τ hτ ↦ hker hτ) σ hσ)

