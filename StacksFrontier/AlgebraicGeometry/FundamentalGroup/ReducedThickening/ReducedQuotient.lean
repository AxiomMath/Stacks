module

public import Mathlib.RingTheory.Nilpotent.Lemmas
public import StacksFrontier.RingTheory.AdicCompletion.TateModule.FiniteComplete
public import StacksFrontier.RingTheory.Dualizing.DerivedHomothety.DerivedCoextensionIsDualizing

/-!
# Dualizing complexes and adic completeness pass to a quotient

Let `A` be a Noetherian ring and `I ⊆ A` an ideal.  Two hypotheses that occur together in the
study of finite étale covers of a punctured spectrum — that `A` has a dualizing complex, and that
`A` is `f`-adically complete for an element `f ∈ A` — are inherited by the quotient `A / I`:

* a dualizing complex over `A / I` is the derived coextension `RHom_A(A / I, ω)` of one over `A`,
  because the quotient map is a finite ring homomorphism;
* `A / I` is a finite `A`-module, hence `f`-adically complete as an `A`-module, and the ideal of
  `A / I` generated by the image of `f` is the image of `(f)`, so `A / I` is complete for its own
  principal ideal.

The case `I = nilradical A` is the reduction of `A`, where these two statements say that the
reduction of a ring with a dualizing complex which is `f`-adically complete is again such a ring.

## Main results

* `Stacks.FundamentalGroup.exists_isDualizingComplex_quotient` — a quotient of a Noetherian ring
  with a dualizing complex has a dualizing complex.
* `Stacks.FundamentalGroup.isAdicComplete_span_singleton_quotient` — the quotient of an
  `f`-adically complete Noetherian ring is complete for the principal ideal generated by the
  image of `f`.
* `Stacks.FundamentalGroup.exists_isDualizingComplex_quotient_nilradical` and
  `Stacks.FundamentalGroup.isAdicComplete_span_singleton_quotient_nilradical` — the two statements
  at the nilradical, where the quotient is the reduction of `A`.

## Implementation notes

The derived category of `A`-modules is taken in the standard model
`CategoryTheory.HasDerivedCategory.standard`, which is the model
`Dualizing.IsDualizingComplex` is read in by the results cited here; a dualizing complex in any
other model is carried to this one by `Dualizing.exists_isDualizingComplex_iff_of_models`.

Adic completeness of `A / I` as an `A`-module and as a ring for the image ideal are the two sides
of `IsAdicComplete.map_algebraMap_iff`; the image of a principal ideal is principal on the image
generator, which is `Ideal.map_span` at a singleton.

## References

* [Stacks Project, Tag 0A7I](https://stacks.math.columbia.edu/tag/0A7I)
* [Stacks Project, Tag 0AX0](https://stacks.math.columbia.edu/tag/0AX0)
-/

@[expose] public noncomputable section

open CategoryTheory

attribute [local instance] HasDerivedCategory.standard

universe u

namespace Stacks.FundamentalGroup

/-- **A quotient of a Noetherian ring with a dualizing complex has a dualizing complex.** The
quotient map `A ⟶ A / I` is surjective, hence a finite ring homomorphism, and the derived
coextension `RHom_A(A / I, ω)` of a dualizing complex `ω` over `A` is a dualizing complex over
`A / I`.

This is [Stacks, Tag 0A7I], whose statement is carried by
`Dualizing.isDualizingComplex_derivedHom_of_finite`, read as an existence statement at a
quotient. -/
theorem exists_isDualizingComplex_quotient (A : Type u) [CommRing A] [IsNoetherianRing A]
    (I : Ideal A)
    (hdual : ∃ K : DerivedCategory (ModuleCat.{u} A), Dualizing.IsDualizingComplex K) :
    ∃ L : DerivedCategory (ModuleCat.{u} (A ⧸ I)), Dualizing.IsDualizingComplex L := by
  obtain ⟨K, hK⟩ := hdual
  exact ⟨(Dualizing.derivedHom (Ideal.Quotient.mk I)).obj K,
    Dualizing.isDualizingComplex_derivedHom_of_finite _
      (RingHom.Finite.of_surjective _ Ideal.Quotient.mk_surjective) K hK⟩

/-- **The reduction of a Noetherian ring with a dualizing complex has a dualizing complex.** The
case `I = nilradical A` of `Stacks.FundamentalGroup.exists_isDualizingComplex_quotient`. -/
theorem exists_isDualizingComplex_quotient_nilradical (A : Type u) [CommRing A]
    [IsNoetherianRing A]
    (hdual : ∃ K : DerivedCategory (ModuleCat.{u} A), Dualizing.IsDualizingComplex K) :
    ∃ L : DerivedCategory (ModuleCat.{u} (A ⧸ nilradical A)), Dualizing.IsDualizingComplex L :=
  exists_isDualizingComplex_quotient A (nilradical A) hdual

/-- **A quotient of an `f`-adically complete Noetherian ring is complete for the image of `f`.**
The quotient `A / I` is a finite `A`-module, so it is `(f)`-adically complete as an `A`-module; and
the ideal of `A / I` generated by the image of `f` is the image of `(f)`, so this is completeness
of `A / I` for its own principal ideal. -/
theorem isAdicComplete_span_singleton_quotient (A : Type u) [CommRing A] [IsNoetherianRing A]
    (I : Ideal A) (f : A) (hcomplete : IsAdicComplete (Ideal.span {f}) A) :
    IsAdicComplete (Ideal.span {(Ideal.Quotient.mk I f)}) (A ⧸ I) := by
  have := hcomplete
  have h : IsAdicComplete (Ideal.span {f}) (A ⧸ I) :=
    AdicCompletion.isAdicComplete_of_finite_of_isNoetherianRing _ _
  have h2 := (IsAdicComplete.map_algebraMap_iff (S := A ⧸ I) (Ideal.span {f}) (A ⧸ I)).mpr h
  rwa [Ideal.map_span, Set.image_singleton] at h2

/-- **The reduction of an `f`-adically complete Noetherian ring is complete for the image of
`f`.** The case `I = nilradical A` of
`Stacks.FundamentalGroup.isAdicComplete_span_singleton_quotient`. -/
theorem isAdicComplete_span_singleton_quotient_nilradical (A : Type u) [CommRing A]
    [IsNoetherianRing A] (f : A) (hcomplete : IsAdicComplete (Ideal.span {f}) A) :
    IsAdicComplete (Ideal.span {(Ideal.Quotient.mk (nilradical A) f)}) (A ⧸ nilradical A) :=
  isAdicComplete_span_singleton_quotient A (nilradical A) f hcomplete

end Stacks.FundamentalGroup

end
