module

public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.GaloisCategory.FieldFundamentalGroup
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.GaloisCategory.InertiaDiagram
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.NormalLocalExactSequence
public import StacksFrontier.RingTheory.Invariant.InertiaFixedField

/-!
# The kernel of the right vertical arrow of the inertia diagram

Let `(A, 𝔪)` be a normal local domain with fraction field `K`, let `L = K^sep` be a separable
closure of `K`, let `B = A^sep` be the integral closure of `A` in `L`, let `q = 𝔪^sep` be a prime
of `B` lying over `𝔪` and let `I = q.inertia Gal(L/K)` be the inertia group at `q`. With
`U = Spec K` and `X = Spec A`, the right vertical arrow of the diagram of Stacks Tag 0BSW is
`π₁(U) → π₁(X)`. This file proves that **its kernel is the smallest closed normal subgroup of
`Gal(K^sep/K)` containing `I`**, the last of the four assertions of the source about that
diagram.

The proof has two halves. The identification `Gal(K^sep/K) = π₁(Spec K)` of Stacks Tag 0BNE is
natural in the base field: for `K ⊆ E ⊆ K^sep` it carries the image of `π₁(Spec E)` onto the
subgroup of `Gal(K^sep/K)` fixing `E`. And the local exact sequence of Stacks Tag 0BSM says that
the kernel of `π₁(Spec K) → π₁(Spec A)` is the smallest closed normal subgroup containing the
image of `π₁(Spec K^sh)`, for `K^sh` the fraction field of a strict henselization of `A`. Taking
`E = K^sh` and using that `K^sh = (K^sep)^I`
(`IsIntegralClosure.isFractionRing_inertiaFixedField` together with
`IsIntegralClosure.isHenselization_inertiaInvariants`) turns the second statement into the
first, the fixing subgroup of `(K^sep)^I` being `I` itself.

## Main results

* `AlgebraicGeometry.galoisEquivEtaleFundamentalGroup_naturality` — the identification of Stacks
  Tag 0BNE is natural in the base field.
* `AlgebraicGeometry.galoisEquiv_preimage_range_etaleFundamentalGroupMap` — under it, the image
  of `π₁(Spec E)` in `π₁(Spec K)` corresponds to the subgroup of `Gal(K^sep/K)` fixing `E`.
* `AlgebraicGeometry.comap_ker_etaleFundamentalGroupMap_eq_normalClosure_fixingSubgroup` —
  **the local exact sequence of Stacks Tag 0BSM read inside `Gal(K^sep/K)`: the kernel of
  `π₁(Spec K) → π₁(Spec A)` is the closed normal subgroup generated by the subgroup of
  `Gal(K^sep/K)` fixing the strictly henselized fraction field.**

## Implementation notes

The kernel of the right vertical arrow is a subgroup of `π₁(Spec K)`, and `I` is a subgroup of
`Gal(K^sep/K)`; the two are compared by pulling the kernel back along
`AlgebraicGeometry.galoisEquivEtaleFundamentalGroup`, which is the idiom of
`AlgebraicGeometry.ker_galoisToFundamentalGroup_eq_comap`.

The strict henselization used is `IsIntegralClosure.inertiaInvariants A K L q`, that is
`((A^sep)_{𝔪^sep})^I`, and its fraction field is `IsIntegralClosure.inertiaFixedField A K L q`,
that is `(K^sep)^I`. Only the fixing subgroup of that field enters the statement, so the final
result mentions neither.

Naturality of Stacks Tag 0BNE is proved from its only characterization,
`AlgebraicGeometry.galoisEquivEtaleFundamentalGroup_apply`, which describes the action of
`Gal(K^sep/K)` on a point of a fibre lifted to `K^sep`: a point of the fibre over `Spec K` is
lifted through the fibre of the base change to `Spec E`, where both sides are computed, and the
two computations agree because restriction of scalars does not change the underlying field
automorphism. The geometric point of `Spec K` obtained from the chosen algebraic closure by way
of `Spec E` is only equal to, not syntactically the same as, the one obtained directly, so the
transport along that equality is carried explicitly.

## References

* [Stacks Project, Tag 0BSW](https://stacks.math.columbia.edu/tag/0BSW)
* [Stacks Project, Tag 0BSM](https://stacks.math.columbia.edu/tag/0BSM)
* [Stacks Project, Tag 0BNE](https://stacks.math.columbia.edu/tag/0BNE)
* [Stacks Project, Tag 0BND](https://stacks.math.columbia.edu/tag/0BND)

## Tags

inertia group, étale fundamental group, absolute Galois group, strict henselization,
closed normal subgroup
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing Stacks.FundamentalGroup

universe u

namespace AlgebraicGeometry

/-! ### Transport of a closed normal subgroup -/

/-- Pulling a closed normal subgroup back along an isomorphism of topological groups gives the
closed normal subgroup generated by the preimage. -/
private theorem comap_normalClosure_topologicalClosure
    {G H : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [Group H] [TopologicalSpace H] [IsTopologicalGroup H]
    (e : G ≃ₜ* H) (s : Set H) :
    ((Subgroup.normalClosure s).topologicalClosure).comap e.toMonoidHom =
      (Subgroup.normalClosure (e ⁻¹' s)).topologicalClosure := by
  apply SetLike.coe_injective
  show e ⁻¹' closure (Subgroup.normalClosure s : Set H) = _
  rw [show e ⁻¹' closure (Subgroup.normalClosure s : Set H) =
    closure (e ⁻¹' (Subgroup.normalClosure s : Set H)) from
      e.toHomeomorph.preimage_closure _]
  congr 1
  exact congrArg (fun S : Subgroup G => (S : Set G))
    (Subgroup.comap_normalClosure s e.toMulEquiv).symm

/-! ### Naturality of the identification of Stacks Tag 0BNE -/

/-- Transporting a natural automorphism of the fibre functor along an equality of the base point
does not change its value on a point of a fibre. -/
private theorem etaleFundamentalGroup_cast_app_val
    {X : Scheme.{u}} [ConnectedSpace X] (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    {a b : Spec (.of Ω) ⟶ X} (h : a = b)
    (σ : EtaleFundamentalGroup X (.mk Ω a))
    (Y : FiniteEtaleOver X)
    (p : finiteEtaleFiber (.mk Ω a) Y) :
    ((((congrArg (GeometricPoint.mk Ω) h) ▸ σ).app Y).hom ⟨p.1, p.2.trans h⟩).1 =
      (((σ.app Y).hom p).1) := by
  cases h
  rfl

/-- A point of the geometric fibre of a finite étale cover of `Spec K` at an algebraic closure
comes from a point over a separable closure. -/
private theorem finiteEtaleFiber_exists_lift
    (K L Ω : Type u) [Field K] [Field L] [Field Ω]
    [Algebra K L] [IsSepClosure K L] [Algebra L Ω] [Algebra K Ω]
    [IsScalarTower K L Ω] [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω]
    (Y : FiniteEtaleOver (Spec (.of K)))
    (p : finiteEtaleFiber (algebraicClosureGeometricPoint K Ω) Y) :
    ∃ r : Spec (.of L) ⟶ Y.left,
      p.1 = Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ r := by
  let e := finiteEtaleFiberIso K L Ω
  obtain ⟨y, hy⟩ := (ConcreteCategory.bijective_of_isIso (e.hom.app Y)).2 p
  refine ⟨(separableFiberEquiv K L Ω Y y).1, ?_⟩
  rw [← hy]
  exact finiteEtaleFiberIso_apply K L Ω Y y

/-- **Naturality of the identification of Stacks Tag 0BNE in the base field.** For a tower
`K ⊆ E ⊆ K^sep` with `K^sep` a separable closure of both, the identification
`Gal(K^sep/E) = π₁(Spec E)` is carried by the homomorphism induced by `Spec E → Spec K` to the
identification `Gal(K^sep/K) = π₁(Spec K)` precomposed with restriction of scalars. -/
theorem galoisEquivEtaleFundamentalGroup_naturality
    (K E L Ω : Type u) [Field K] [Field E] [Field L] [Field Ω]
    [Algebra K E] [Algebra E L] [Algebra K L] [IsScalarTower K E L]
    [IsSepClosure K L] [IsSepClosure E L]
    [Algebra L Ω] [Algebra E Ω] [Algebra K Ω]
    [IsScalarTower E L Ω] [IsScalarTower K L Ω]
    [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [Algebra.IsAlgebraic E Ω] :
    ∃ hx : (algebraicClosureGeometricPoint E Ω).map
        (Spec.map (CommRingCat.ofHom (algebraMap K E))) =
        algebraicClosureGeometricPoint K Ω,
      ∀ σ : Gal(L/E),
        hx ▸ etaleFundamentalGroupMap (Spec.map (CommRingCat.ofHom (algebraMap K E)))
          (algebraicClosureGeometricPoint E Ω)
          (galoisEquivEtaleFundamentalGroup E L Ω σ) =
        galoisEquivEtaleFundamentalGroup K L Ω (σ.restrictScalars K) := by
  have ht : (algebraMap E Ω).comp (algebraMap K E) = algebraMap K Ω := by
    ext a
    simp only [RingHom.comp_apply, IsScalarTower.algebraMap_apply E L Ω,
      ← IsScalarTower.algebraMap_apply K E L, ← IsScalarTower.algebraMap_apply K L Ω]
  have hhom : Spec.map (CommRingCat.ofHom (algebraMap E Ω)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K E)) =
      Spec.map (CommRingCat.ofHom (algebraMap K Ω)) := by
    rw [← Spec.map_comp]
    exact congrArg (fun f => Spec.map (CommRingCat.ofHom f)) ht
  refine ⟨congrArg (GeometricPoint.mk Ω) hhom, fun σ => ?_⟩
  apply Iso.ext
  apply NatTrans.ext
  funext Y
  apply ConcreteCategory.hom_ext
  intro p
  apply Subtype.ext
  set f := Spec.map (CommRingCat.ofHom (algebraMap K E))
  set x := algebraicClosureGeometricPoint E Ω
  let p' : finiteEtaleFiber (x.map f) Y := ⟨p.1, p.2.trans hhom.symm⟩
  refine Eq.trans (etaleFundamentalGroup_cast_app_val Ω hhom
    (etaleFundamentalGroupMap f x (galoisEquivEtaleFundamentalGroup E L Ω σ)) Y p') ?_
  obtain ⟨pE, hpE⟩ := (finiteEtaleFiberProjectionEquiv f x Y).surjective p'
  obtain ⟨r, hr⟩ := finiteEtaleFiber_exists_lift E L Ω _ pE
  have hK : p.1 = Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫
      (r ≫ pullback.fst Y.hom f) := by
    have hp : finiteEtaleFiberProjection f x Y pE = p' := hpE
    have hp' : pE.1 ≫ pullback.fst Y.hom f = p.1 := congrArg Subtype.val hp
    rw [← hp', hr]
    exact Category.assoc _ _ _
  refine Eq.trans ?_ (galoisEquivEtaleFundamentalGroup_apply K L Ω Y
    (σ.restrictScalars K) p _ hK).symm
  have hp'' : ((etaleFundamentalGroupMap f x
        (galoisEquivEtaleFundamentalGroup E L Ω σ)).app Y).hom p' =
      finiteEtaleFiberProjection f x Y
        (((galoisEquivEtaleFundamentalGroup E L Ω σ).app _).hom pE) := by
    rw [← hpE]
    exact (etaleFundamentalGroupMap_finiteEtaleFiberProjection f x Y
      (galoisEquivEtaleFundamentalGroup E L Ω σ) pE).symm
  refine Eq.trans (congrArg Subtype.val hp'') ?_
  show (((galoisEquivEtaleFundamentalGroup E L Ω σ).app _).hom pE).1 ≫
    pullback.fst Y.hom f = _
  refine Eq.trans (congrArg (· ≫ pullback.fst Y.hom f)
    (galoisEquivEtaleFundamentalGroup_apply E L Ω _ σ pE r hr)) ?_
  exact (Category.assoc _ _ _).trans
    (congrArg (Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ ·)
      (Category.assoc _ _ _))

/-- The image of `Gal(L/E)` in `Gal(L/K)` is the subgroup fixing `E`. -/
private theorem range_restrictScalars_eq_fixingSubgroup
    (K E L : Type*) [Field K] [Field E] [Field L]
    [Algebra K E] [Algebra E L] [Algebra K L] [IsScalarTower K E L] :
    (AlgEquiv.restrictScalarsHom K : Gal(L/E) →* Gal(L/K)).range =
      (IsScalarTower.toAlgHom K E L).fieldRange.fixingSubgroup := by
  ext σ
  constructor
  · rintro ⟨τ, rfl⟩ a
    obtain ⟨b, hb⟩ := a.property
    show τ (a : L) = (a : L)
    rw [← hb]
    exact τ.commutes b
  · exact fun hσ =>
      ⟨{ σ.toRingEquiv with commutes' := fun a => hσ ⟨algebraMap E L a, ⟨a, rfl⟩⟩ }, rfl⟩

/-- **The image of `π₁(Spec E)` in `π₁(Spec K)` is the subgroup fixing `E`**, read inside
`Gal(K^sep/K)` through the identification of Stacks Tag 0BNE. -/
theorem galoisEquiv_preimage_range_etaleFundamentalGroupMap
    (K E L Ω : Type u) [Field K] [Field E] [Field L] [Field Ω]
    [Algebra K E] [Algebra E L] [Algebra K L] [IsScalarTower K E L]
    [IsSepClosure K L] [IsSepClosure E L]
    [Algebra L Ω] [Algebra E Ω] [Algebra K Ω]
    [IsScalarTower E L Ω] [IsScalarTower K L Ω]
    [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [Algebra.IsAlgebraic E Ω] :
    ∃ hx : (algebraicClosureGeometricPoint E Ω).map
        (Spec.map (CommRingCat.ofHom (algebraMap K E))) =
        algebraicClosureGeometricPoint K Ω,
      (galoisEquivEtaleFundamentalGroup K L Ω) ⁻¹'
        Set.range (fun τ : EtaleFundamentalGroup (Spec (.of E))
            (algebraicClosureGeometricPoint E Ω) =>
          hx ▸ etaleFundamentalGroupMap (Spec.map (CommRingCat.ofHom (algebraMap K E)))
            (algebraicClosureGeometricPoint E Ω) τ) =
        ((IsScalarTower.toAlgHom K E L).fieldRange.fixingSubgroup : Set Gal(L/K)) := by
  obtain ⟨hx, hn⟩ := galoisEquivEtaleFundamentalGroup_naturality K E L Ω
  refine ⟨hx, ?_⟩
  rw [← range_restrictScalars_eq_fixingSubgroup K E L]
  ext σ
  constructor
  · rintro ⟨τ, hτ⟩
    obtain ⟨s, rfl⟩ := (galoisEquivEtaleFundamentalGroup E L Ω).surjective τ
    exact ⟨s, (galoisEquivEtaleFundamentalGroup K L Ω).injective ((hn s).symm.trans hτ)⟩
  · rintro ⟨s, rfl⟩
    exact ⟨galoisEquivEtaleFundamentalGroup E L Ω s, hn s⟩

/-! ### The kernel of the right vertical arrow -/

/-- **The local exact sequence of Stacks Tag 0BSM, read inside `Gal(K^sep/K)`.** If the kernel of
`π₁(Spec K) → π₁(Spec A)` is the closed normal subgroup generated by the image of `π₁(Spec E)`,
for `K ⊆ E ⊆ K^sep`, then its preimage in `Gal(K^sep/K)` under the identification of Stacks Tag
0BNE is the closed normal subgroup generated by the subgroup fixing `E`. -/
theorem comap_ker_etaleFundamentalGroupMap_eq_normalClosure_fixingSubgroup
    (A K E L Ω : Type u) [CommRing A] [ConnectedSpace (Spec (.of A))]
    [Field K] [Field E] [Field L] [Field Ω] [Algebra A K]
    [Algebra K E] [Algebra E L] [Algebra K L] [IsScalarTower K E L]
    [IsSepClosure K L] [IsSepClosure E L]
    [Algebra L Ω] [Algebra E Ω] [Algebra K Ω]
    [IsScalarTower E L Ω] [IsScalarTower K L Ω]
    [IsAlgClosed Ω] [Algebra.IsAlgebraic K Ω] [Algebra.IsAlgebraic E Ω]
    (hexact : ∀ (z : GeometricPoint (Spec (.of K)))
        (hz : (algebraicClosureGeometricPoint E Ω).map
            (Spec.map (CommRingCat.ofHom (algebraMap K E))) = z),
        MonoidHom.ker (etaleFundamentalGroupMap
            (Spec.map (CommRingCat.ofHom (algebraMap A K))) z).toMonoidHom =
          (Subgroup.normalClosure (Set.range
            (fun τ : EtaleFundamentalGroup (Spec (.of E))
                (algebraicClosureGeometricPoint E Ω) =>
              hz ▸ etaleFundamentalGroupMap
                (Spec.map (CommRingCat.ofHom (algebraMap K E)))
                (algebraicClosureGeometricPoint E Ω) τ))).topologicalClosure) :
    Subgroup.comap (galoisEquivEtaleFundamentalGroup K L Ω).toMonoidHom
        (MonoidHom.ker (etaleFundamentalGroupMap
          (Spec.map (CommRingCat.ofHom (algebraMap A K)))
          (algebraicClosureGeometricPoint K Ω)).toMonoidHom) =
      (Subgroup.normalClosure
          ((IsScalarTower.toAlgHom K E L).fieldRange.fixingSubgroup :
            Set Gal(L/K))).topologicalClosure := by
  obtain ⟨hx, hpre⟩ := galoisEquiv_preimage_range_etaleFundamentalGroupMap K E L Ω
  rw [hexact _ hx, comap_normalClosure_topologicalClosure, hpre]

end AlgebraicGeometry

end
