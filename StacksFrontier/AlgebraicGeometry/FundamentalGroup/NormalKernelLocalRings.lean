    obtain ⟨r, hrprime, hrunder⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain
        (R := integralClosure Γ(X, U) (F : Type u))
        (S := integralClosure Γ(X, U) L) q
        (le_of_eq_of_le ((RingHom.injective_iff_ker_eq_bot _).1 hinj) bot_le)
    let := hrprime
    -- Stacks Tag 0BSX, with its instances supplied by hand: searching for the scalar towers
    -- between the two integral closures exhausts the typeclass heartbeat budget.
    have h0BSX := @IsIntegralClosure.image_stabilizer_and_inertia_restrictNormalHom
      Γ(X, U) (X.residueField (genericPoint X)) (F : Type u) L
      (integralClosure Γ(X, U) (F : Type u)) (integralClosure Γ(X, U) L)
      inferInstance inferInstance inferInstance inferInstance inferInstance inferInstance
      inferInstance inferInstance inferInstance inferInstance
      inferInstance inferInstance inferInstance inferInstance
      inferInstance inferInstance
      inferInstance inferInstance inferInstance
      inferInstance inferInstance inferInstance
      algBC algBL twrABC
      twrBFL twrBCL
      inferInstance inferInstance inferInstance
      inferInstance inferInstance inferInstance
      inferInstance inferInstance
      r hrprime
    let := IsIntegralClosure.MulSemiringAction Γ(X, U)
      (X.residueField (genericPoint X)) (F : Type u) (integralClosure Γ(X, U) (F : Type u))
    let σK : Gal((F : Type u) / X.residueField (genericPoint X)) :=
      { σ.toRingEquiv with
        commutes' := fun a => by
          obtain ⟨b, rfl⟩ := (functionFieldEquivGenericResidueField X).surjective a
          exact σ.commutes b }
    have hσK : σK ∈ q.inertia Gal((F : Type u) / X.residueField (genericPoint X)) := by
      rw [Ideal.mem_inertia]
      intro y
      have hy := hσ.2 y
