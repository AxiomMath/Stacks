        rw [algebraMap_galRestrict_apply Γ(X, U) σK y,
          algebraMap_galRestrict_apply Γ(X, U) σ y]
        rfl
      change galRestrict Γ(X, U) (X.residueField (genericPoint X)) (F : Type u)
        (integralClosure Γ(X, U) (F : Type u)) σK y - y ∈ q
      rw [heq]
      exact hy
    have hmem : σK ∈ (q.inertia Gal((F : Type u) / X.residueField (genericPoint X)) :
        Set Gal((F : Type u) / X.residueField (genericPoint X))) := hσK
    rw [← hrunder, ← h0BSX.2] at hmem
    obtain ⟨τ, hτ, hres⟩ := hmem
    have hτgen : τ ∈ inertiaGenerators X L :=
      inertiaOverAffineOpen_subset_inertiaGenerators X L U hU hne ⟨r, hrprime, hτ⟩
    have hτker : τ ∈ (AlgEquiv.restrictNormalHom (F : Type u) :
        Gal(L / X.residueField (genericPoint X)) →*
          Gal((F : Type u) / X.residueField (genericPoint X))).ker := by
      rw [IntermediateField.restrictNormalHom_ker]
      exact hF hτgen
    have hσK1 : σK = 1 := hres ▸ hτker
    exact AlgEquiv.ext fun x => by
      have := AlgEquiv.ext_iff.mp hσK1 x
      exact this
  exact ((normalization_unramified_tfae X (F : Type u) f hi).out 1 3).mp hunram

/-- **Stacks Tag 0BTD, the reverse inclusion `(1) ⊆ (2)`.** Let `X` be a normal integral scheme
with function field `K`. The kernel of the surjection `Gal(K^sep/K) → π₁(X)` is contained in the
smallest closed normal subgroup of `Gal(K^sep/K)` containing the inertia group `I_y` for every
point `y` of the normalization `X^sep` of `X` in `K^sep`.

This is the second half of the source's proof. Subgroup `(2)` is closed and normal, so it is the
subgroup fixing its fixed field `F`, and `F` is normal over `K`; hence it suffices to see that
every element of the kernel fixes each element `x` of `F`. The finite Galois subextension
generated by `x` lies in `F`, so every inertia group restricts to the identity on it, so `X` is
unramified in it by
`AlgebraicGeometry.isFinite_etale_fromNormalization_of_inertiaGenerators_subset`, so every
element of the kernel fixes it by
`AlgebraicGeometry.mem_fixingSubgroup_of_galoisToFundamentalGroup_eq_one`. -/
@[stacks 0BTD "the inclusion of subgroup (1) in subgroup (2), and only that inclusion: \
subgroup (1) is the kernel of Gal(K^sep/K) → π₁(X) and subgroup (2) is the closed normal \
subgroup generated by the inertia groups I_y; the reverse inclusion (2) ⊆ (3) needs the \
conjugacy of I_y with Gal(K^sep/K_x^sh) from Tag 0BSW, is \
AlgebraicGeometry.inertiaClosedNormalSubgroup_le_stalkKerClosedNormalSubgroup below"]
theorem ker_galoisToFundamentalGroup_le_inertiaClosedNormalSubgroup
    (Ω : Type u) [Field Ω] [Algebra L Ω] [Algebra (X.residueField (genericPoint X)) Ω]
    [IsScalarTower (X.residueField (genericPoint X)) L Ω]
    [IsAlgClosed Ω] [Algebra.IsAlgebraic (X.residueField (genericPoint X)) Ω] :
    (galoisToFundamentalGroup X L Ω).toMonoidHom.ker ≤ inertiaClosedNormalSubgroup X L := by
  intro σ hσ
  rw [MonoidHom.mem_ker] at hσ
  have hclosed := isClosed_inertiaClosedNormalSubgroup X L
  have hfix : (IntermediateField.fixedField (inertiaClosedNormalSubgroup X L)).fixingSubgroup =
      inertiaClosedNormalSubgroup X L :=
    InfiniteGalois.fixingSubgroup_fixedField ⟨inertiaClosedNormalSubgroup X L, hclosed⟩
  rw [← hfix]
  refine (IntermediateField.mem_fixingSubgroup_iff _ σ).2 fun x hx => ?_
  -- the fixed field of subgroup (2) is normal over `K`
  have hnormalF : Normal (X.residueField (genericPoint X))
      (IntermediateField.fixedField (inertiaClosedNormalSubgroup X L)) := by
    exact (IsGalois.of_fixedField_normal_subgroup (inertiaClosedNormalSubgroup X L)).to_normal
  -- the finite Galois subextension generated by `x`
  set Fx := FiniteGaloisIntermediateField.adjoin (X.residueField (genericPoint X))
    ({x} : Set L) with hFxdef
  have hxFx : x ∈ Fx.toIntermediateField :=
    FiniteGaloisIntermediateField.subset_adjoin _ _ rfl
  have hFxle : Fx.toIntermediateField ≤
      IntermediateField.fixedField (inertiaClosedNormalSubgroup X L) := by
    rw [hFxdef, FiniteGaloisIntermediateField.adjoin_val,
      IntermediateField.normalClosure_le_iff_of_normal]
    exact IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hx)
  -- every inertia group restricts to the identity on it
  have hgen : inertiaGenerators X L ⊆
      (Fx.toIntermediateField.fixingSubgroup :
        Set Gal(L / X.residueField (genericPoint X))) := by
    intro g hg
    refine IntermediateField.fixingSubgroup_antitone hFxle ?_
    rw [hfix]
    exact inertiaGenerators_subset_inertiaClosedNormalSubgroup X L hg
  -- so `X` is unramified in it, and the kernel fixes it
  have hfe := isFinite_etale_fromNormalization_of_inertiaGenerators_subset X L
    Fx.toIntermediateField hgen
  have hfixed := mem_fixingSubgroup_of_galoisToFundamentalGroup_eq_one X L Ω
    Fx.toIntermediateField hfe σ hσ
  exact (IntermediateField.mem_fixingSubgroup_iff _ σ).1 hfixed x hxFx


/-! #### The inclusion `(2) ⊆ (3)` -/

section SubgroupThree

variable (Ω : Type u) [Field Ω] [Algebra L Ω]
  [Algebra (X.residueField (genericPoint X)) Ω]
  [IsScalarTower (X.residueField (genericPoint X)) L Ω]
  [IsAlgClosed Ω] [Algebra.IsAlgebraic (X.residueField (genericPoint X)) Ω]

/-- **Subgroup (3) of Stacks Tag 0BTD, read inside `Gal(K^sep/K)`.** The smallest closed normal
subgroup of `π₁(Spec K)` containing the kernel of `π₁(Spec K) → π₁(Spec 𝒪_{X,x})` for every point
`x` of `X`, pulled back along the identification `Gal(K^sep/K) = π₁(Spec K)` of Stacks Tag 0BNE.
This is the subgroup appearing in
`AlgebraicGeometry.comap_normalClosure_iUnion_ker_le_ker_galoisToFundamentalGroup`. -/
def stalkKerClosedNormalSubgroup : Subgroup Gal(L / X.residueField (genericPoint X)) :=
  Subgroup.comap (galoisEquivEtaleFundamentalGroup
      (X.residueField (genericPoint X)) L Ω).toMonoidHom
    ((Subgroup.normalClosure (⋃ x : X,
      (((etaleFundamentalGroupMap (Spec.map (stalkToGenericResidueField X x))
        (algebraicClosureGeometricPoint
          (X.residueField (genericPoint X)) Ω)).toMonoidHom.ker : Subgroup
            (EtaleFundamentalGroup (Spec (X.residueField (genericPoint X)))
              (algebraicClosureGeometricPoint
                (X.residueField (genericPoint X)) Ω))) : Set _))).topologicalClosure)

/-- `stalkKerClosedNormalSubgroup X L Ω` is a normal subgroup. -/
instance : (stalkKerClosedNormalSubgroup X L Ω).Normal :=
  (Subgroup.is_normal_topologicalClosure _).comap _

/-- `stalkKerClosedNormalSubgroup X L Ω` is closed in `Gal(K^sep/K)`. -/
theorem isClosed_stalkKerClosedNormalSubgroup :
    IsClosed ((stalkKerClosedNormalSubgroup X L Ω : Subgroup _) :
      Set Gal(L / X.residueField (genericPoint X))) := by
  rw [stalkKerClosedNormalSubgroup, Subgroup.coe_comap]
  exact (Subgroup.isClosed_topologicalClosure _).preimage
    (galoisEquivEtaleFundamentalGroup (X.residueField (genericPoint X)) L Ω).continuous

/-- Membership in subgroup (3) is being carried into the closed normal subgroup generated by the
kernels of `π₁(Spec K) → π₁(Spec 𝒪_{X,x})`. -/
theorem mem_stalkKerClosedNormalSubgroup_iff
    (σ : Gal(L/X.residueField (genericPoint X))) :
    σ ∈ stalkKerClosedNormalSubgroup X L Ω ↔
      galoisEquivEtaleFundamentalGroup (X.residueField (genericPoint X)) L Ω σ ∈
        (Subgroup.normalClosure (⋃ x : X,
          (((etaleFundamentalGroupMap (Spec.map (stalkToGenericResidueField X x))
            (algebraicClosureGeometricPoint
              (X.residueField (genericPoint X)) Ω)).toMonoidHom.ker : Subgroup
                (EtaleFundamentalGroup (Spec (X.residueField (genericPoint X)))
                  (algebraicClosureGeometricPoint
                    (X.residueField (genericPoint X)) Ω))) :
            Set _))).topologicalClosure := Iff.rfl

/-- **Stacks Tag 0BTD, the inclusion `(2) ⊆ (3)`.** Let `X` be a normal integral scheme with
function field `K`. The smallest closed normal subgroup of `Gal(K^sep/K)` containing the inertia
group `I_y` for every point `y` of the normalization `X^sep` of `X` in `K^sep` is contained in the
smallest closed normal subgroup containing the kernel of `π₁(Spec K) → π₁(Spec 𝒪_{X,x})` for
every point `x` of `X`.

This is the inclusion the source gets from the conjugacy of `I_y` with `Gal(K^sep/K_x^sh)`. A
point `y` of `X^sep` over a nonempty affine open `U` of `X` is a prime `r` of the integral closure
`C` of `Γ(X, U)` in `K^sep`; the point `x` of `U` it lies over is the prime `r ∩ Γ(X, U)`, and
`𝒪_{X,x}` is the localization of `Γ(X, U)` there. Taking the integral closure commutes with that
localization and the inertia group is insensitive to it
(`IsIntegralClosure.exists_isMaximal_inertia_eq_of_isLocalization`), so `I_y` is the inertia group
at a maximal ideal of the integral closure of `𝒪_{X,x}` in `K^sep`; by
`Stacks.RamificationTheory.comap_ker_etaleFundamentalGroupMap_eq_normalClosure_inertia` that
inertia group lies in the kernel of `π₁(Spec K) → π₁(Spec 𝒪_{X,x})`.

With `AlgebraicGeometry.comap_normalClosure_iUnion_ker_le_ker_galoisToFundamentalGroup` and
`AlgebraicGeometry.ker_galoisToFundamentalGroup_le_inertiaClosedNormalSubgroup` this closes the
cycle `(3) ⊆ (1) ⊆ (2) ⊆ (3)`, so the three subgroups of the source are equal. -/
@[stacks 0BTD "the inclusion of subgroup (2) in subgroup (3), which together with the \
inclusions (3) ⊆ (1) and (1) ⊆ (2) above gives the equality of the three subgroups; subgroup (3) \
is written with the kernels of π₁(Spec K) → π₁(Spec 𝒪_{X,x}) as generators and is read inside \
Gal(K^sep/K) through the identification of Tag 0BNE"]
theorem inertiaClosedNormalSubgroup_le_stalkKerClosedNormalSubgroup :
    inertiaClosedNormalSubgroup X L ≤ stalkKerClosedNormalSubgroup X L Ω := by
  rw [inertiaClosedNormalSubgroup_le_iff X L (isClosed_stalkKerClosedNormalSubgroup X L Ω)]
  intro σ hσ
  simp only [inertiaGenerators, Set.mem_iUnion] at hσ
  obtain ⟨U, hU, hne, hr⟩ := hσ
  let := hne
  let := isFractionRing_sections_genericResidueField X U hU
  let := isIntegrallyClosed_sections X U hU
  let := isFractionRing_integralClosure_sections X L U hU
  let := IsIntegralClosure.MulSemiringAction Γ(X, U)
    (X.residueField (genericPoint X)) L (integralClosure Γ(X, U) L)
  obtain ⟨r, hrprime, hrmem⟩ := hr
  let := hrprime
  -- the point of `U` that `r` lies over, and the local ring there
  have : (r.under Γ(X, U)).IsPrime := inferInstance
  have hrover : r.LiesOver (r.under Γ(X, U)) := ⟨rfl⟩
  have hx : hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩ ∈ U := by
    have hmemrange : hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩ ∈
        Set.range hU.fromSpec := Set.mem_range_self _
    rwa [hU.range_fromSpec] at hmemrange
  let : Algebra Γ(X, U)
      (X.presheaf.stalk (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩)) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨_, hx⟩
  have : IsLocalization.AtPrime
      (X.presheaf.stalk (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩))
      (r.under Γ(X, U)) :=
    hU.isLocalization_stalk' ⟨r.under Γ(X, U), inferInstance⟩ hx
  let : Algebra (X.presheaf.stalk (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩)) L :=
    ((algebraMap (X.residueField (genericPoint X)) L).comp
      (algebraMap (X.presheaf.stalk (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩))
        (X.residueField (genericPoint X)))).toAlgebra
  have : IsScalarTower
      (X.presheaf.stalk (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩))
      (X.residueField (genericPoint X)) L := .of_algebraMap_eq' rfl
  -- the sections, the local ring and the function field form a tower
  have hcomp : X.presheaf.germ U (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩) hx ≫
      stalkToGenericResidueField X (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩) =
      X.germToFunctionField U ≫ X.residue (genericPoint X) := by
    change X.presheaf.germ U _ hx ≫
      (X.presheaf.stalkSpecializes _ ≫ X.residue (genericPoint X)) = _
    rw [← Category.assoc, X.presheaf.germ_stalkSpecializes]
  have htowerK : IsScalarTower Γ(X, U)
      (X.presheaf.stalk (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩))
      (X.residueField (genericPoint X)) := by
    refine IsScalarTower.of_algebraMap_eq' ?_
    change _ = RingHom.comp (CommRingCat.Hom.hom
        (stalkToGenericResidueField X (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩)))
      (CommRingCat.Hom.hom
        (X.presheaf.germ U (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩) hx))
    rw [← CommRingCat.hom_comp, hcomp]
    rfl
  have : IsScalarTower Γ(X, U)
      (X.presheaf.stalk (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩)) L :=
    .of_algebraMap_eq fun a => by
      rw [IsScalarTower.algebraMap_apply Γ(X, U) (X.residueField (genericPoint X)) L,
        IsScalarTower.algebraMap_apply Γ(X, U)
          (X.presheaf.stalk (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩))
          (X.residueField (genericPoint X)),
        ← IsScalarTower.algebraMap_apply
          (X.presheaf.stalk (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩))
          (X.residueField (genericPoint X)) L]
  let : IsIntegrallyClosed
      (X.presheaf.stalk (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩)) :=
    IsNormal.stalk_normal _
  -- the inertia group at `r` is an inertia group at a maximal ideal over the local ring
  obtain ⟨Q, hQmax, hQover, hQin⟩ :=
    IsIntegralClosure.exists_isMaximal_inertia_eq_of_isLocalization Γ(X, U)
      (X.presheaf.stalk (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩))
      (X.residueField (genericPoint X)) L (r.under Γ(X, U)) r
  have := hQmax.isPrime
  have := hQover
  have hker :=
    Stacks.RamificationTheory.comap_ker_etaleFundamentalGroupMap_eq_normalClosure_inertia
    (X.presheaf.stalk (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩))
    (X.residueField (genericPoint X)) L Ω Q
  have hmem : galoisEquivEtaleFundamentalGroup (X.residueField (genericPoint X)) L Ω σ ∈
      MonoidHom.ker (etaleFundamentalGroupMap
        (Spec.map (stalkToGenericResidueField X
          (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩)))
        (algebraicClosureGeometricPoint
          (X.residueField (genericPoint X)) Ω)).toMonoidHom :=
    hker.ge (Stacks.FundamentalGroup.subset_normalClosure_topologicalClosure _
      (hQin.ge hrmem))
  exact (mem_stalkKerClosedNormalSubgroup_iff X L Ω σ).mpr
    (Stacks.FundamentalGroup.subset_normalClosure_topologicalClosure _
      (Set.mem_iUnion_of_mem (hU.fromSpec ⟨r.under Γ(X, U), inferInstance⟩) hmem))

/-- **Stacks Tag 0BTD.** Let `X` be a normal integral scheme with function field `K`. The three
subgroups of `Gal(K^sep/K)` of the source are equal: the kernel of `Gal(K^sep/K) → π₁(X)`, the
smallest closed normal subgroup containing the inertia group `I_y` at every point `y` of the
normalization of `X` in `K^sep`, and the smallest closed normal subgroup containing the kernel of
`π₁(Spec K) → π₁(Spec 𝒪_{X,x})` for every point `x` of `X`.

The three inclusions `(3) ⊆ (1)`, `(1) ⊆ (2)` and `(2) ⊆ (3)` proved above close into a cycle. -/
@[stacks 0BTD "the equality of the three subgroups, assembled from the cycle \
(3) ⊆ (1) ⊆ (2) ⊆ (3); subgroup (1) is the kernel of Gal(K^sep/K) → π₁(X) rather than the \
subgroup fixing the maximal unramified subextension, so no Noetherian hypothesis is needed, and \
subgroup (3) is written with the kernels of π₁(Spec K) → π₁(Spec 𝒪_{X,x}) as generators"]
theorem ker_galoisToFundamentalGroup_eq_inertiaClosedNormalSubgroup_and_stalkKer :
    (galoisToFundamentalGroup X L Ω).toMonoidHom.ker = inertiaClosedNormalSubgroup X L ∧
      (galoisToFundamentalGroup X L Ω).toMonoidHom.ker =
        stalkKerClosedNormalSubgroup X L Ω := by
  have h12 := ker_galoisToFundamentalGroup_le_inertiaClosedNormalSubgroup X L Ω
  have h23 := inertiaClosedNormalSubgroup_le_stalkKerClosedNormalSubgroup X L Ω
  have h31 : stalkKerClosedNormalSubgroup X L Ω ≤
      (galoisToFundamentalGroup X L Ω).toMonoidHom.ker :=
    comap_normalClosure_iUnion_ker_le_ker_galoisToFundamentalGroup X L Ω
  exact ⟨le_antisymm h12 (h23.trans h31), le_antisymm (h12.trans h23) h31⟩

end SubgroupThree

