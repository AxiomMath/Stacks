      (IsScalarTower.algebraMap_apply Γ(X, U) (F : Type u) L a)
    let twrBFL : IsScalarTower (integralClosure Γ(X, U) (F : Type u)) (F : Type u) L :=
      .of_algebraMap_eq fun _ => rfl
