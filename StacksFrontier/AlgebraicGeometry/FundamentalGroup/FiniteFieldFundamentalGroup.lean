module

public import Mathlib.FieldTheory.Finite.GaloisField
public import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.EtaleFundamental.FundamentalGroupTheorem
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.GaloisCategory.FieldFundamentalGroup
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.MorphismMap

/-!
# The étale fundamental group of a finite field is commutative

Let `k` be a finite field. Every finite extension of `k` is Galois with cyclic Galois group,
generated by the Frobenius `a ↦ a ^ #k`. Restricting to the finite subextension generated by one
element, any two automorphisms of an algebraic extension `L / k` therefore commute on that
element, so `Gal(L/k)` is commutative.

Through the Galois description of `π₁(Spec k)` (Stacks 0BNE (2)) at the geometric point given by
an algebraic closure, and the change of geometric base point (Stacks 0BND (2)), the étale
fundamental group of `Spec k` at *every* geometric point is commutative. For a morphism
`X ⟶ Spec k` from a connected scheme, every commutator of `π₁(X, x)` therefore lies in the
kernel of the induced map to `π₁(Spec k)`, the geometric fundamental group: the quotient of
`π₁(X, x)` by its geometric part is abelian.

## Main results

* `FiniteField.algEquiv_mul_comm` — the Galois group of an algebraic extension of a finite field
  is commutative.
* `AlgebraicGeometry.etaleFundamentalGroup_mul_comm_of_finite` — `π₁(Spec k, x)` is commutative
  for a finite field `k` and any geometric point `x`.
* `AlgebraicGeometry.commutator_mem_ker_etaleFundamentalGroupMap_of_finite` — for `X ⟶ Spec k`
  with `k` finite, every commutator of `π₁(X, x)` lies in the kernel of the induced map.

## References

* [Stacks Project, Tag 0BNE](https://stacks.math.columbia.edu/tag/0BNE)
* [Stacks Project, Tag 0BND](https://stacks.math.columbia.edu/tag/0BND)
-/

@[expose] public section

universe u

namespace FiniteField

/-- **The Galois group of an algebraic extension of a finite field is commutative.** Two
automorphisms agree in either order on every element `x`, because both restrict to the finite
subextension `k⟮x⟯`, which is Galois with cyclic Galois group. -/
theorem algEquiv_mul_comm (K L : Type*) [Field K] [Finite K] [Field L] [Algebra K L]
    [Algebra.IsAlgebraic K L] (σ τ : Gal(L/K)) : σ * τ = τ * σ := by
  ext x
  let E : IntermediateField K L := IntermediateField.adjoin K {x}
  have : FiniteDimensional K E :=
    IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral x)
  have : Finite E := Module.finite_of_finite K
  let _ : CommGroup Gal(E/K) := IsCyclic.commGroup
  have hx : x ∈ E := IntermediateField.mem_adjoin_simple_self K x
  have key : ∀ a b : Gal(L/K), (a * b) x =
      ((AlgEquiv.restrictNormalHom E a * AlgEquiv.restrictNormalHom E b) ⟨x, hx⟩ : L) := by
    intro a b
    rw [← map_mul, AlgEquiv.restrictNormalHom_apply]
  rw [key, key, mul_comm (AlgEquiv.restrictNormalHom E σ)]

end FiniteField

namespace AlgebraicGeometry

open CategoryTheory

/-- **The étale fundamental group of a finite field is commutative**, at every geometric point:
it is isomorphic to the étale fundamental group at the geometric point given by an algebraic
closure (Stacks 0BND (2)), which is the absolute Galois group (Stacks 0BNE (2)), commutative by
`FiniteField.algEquiv_mul_comm`. -/
theorem etaleFundamentalGroup_mul_comm_of_finite (k : Type u) [Field k] [Finite k]
    (x : GeometricPoint (Spec (.of k))) (σ τ : EtaleFundamentalGroup (Spec (.of k)) x) :
    σ * τ = τ * σ := by
  obtain ⟨e⟩ := nonempty_etaleFundamentalGroupContinuousMulEquiv (Spec (.of k)) x
    (algebraicClosureGeometricPoint k (AlgebraicClosure k))
  let g := (galoisEquivEtaleFundamentalGroup k (AlgebraicClosure k) (AlgebraicClosure k)).symm
  apply e.injective
  apply g.injective
  simp only [map_mul]
  exact FiniteField.algEquiv_mul_comm _ _ _ _

/-- **The geometric fundamental group contains every commutator.** For a morphism `f : X ⟶ Spec k`
from a connected scheme to the spectrum of a finite field, every commutator of `π₁(X, x)` lies in
the kernel of the induced map `π₁(X, x) → π₁(Spec k)`, because the target is commutative. -/
theorem commutator_mem_ker_etaleFundamentalGroupMap_of_finite {X : Scheme.{u}}
    [ConnectedSpace X] (k : Type u) [Field k] [Finite k] (f : X ⟶ Spec (.of k))
    (x : GeometricPoint X) (a b : EtaleFundamentalGroup X x) :
    a * b * a⁻¹ * b⁻¹ ∈ (etaleFundamentalGroupMap f x).toMonoidHom.ker := by
  rw [MonoidHom.mem_ker, map_mul, map_mul, map_mul, map_inv, map_inv,
    etaleFundamentalGroup_mul_comm_of_finite k _ ((etaleFundamentalGroupMap f x).toMonoidHom a)]
  group

end AlgebraicGeometry
