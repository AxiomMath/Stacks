module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Trace.FrobeniusElementDegree
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Trace.FieldValuedPointCount
public import StacksFrontier.AlgebraicGeometry.FundamentalGroup.GaloisCategory.OpenSubgroups
public import StacksFrontier.Topology.Algebra.Group.ClosureZPowersExtension
public import Mathlib.FieldTheory.Finite.GaloisField

/-!
# The Frobenius generates the étale fundamental group of a finite field topologically

Let `k` be a finite field with `q = p ^ n` elements and `z` a geometric point of `Spec k`, given
by an algebraically closed field `Ω`. The Frobenius `Φ ∈ π₁(Spec k, z)` acts on geometric fibres
by precomposition with `x ↦ x ^ q` on `Ω`. The subgroup `⟨Φ⟩` is dense in `π₁(Spec k, z)` for
the topology of Stacks 0BMR.

For a scheme `X ⟶ Spec k` with `π₁(X, x) ⟶ π₁(Spec k)` and an element `φ` over `Φ⁻¹`, the
subgroup generated by the geometric fundamental group and `φ` is dense, and the powers of `φ` are
detected by open subgroups containing the geometric fundamental group.

## Main results

* `AlgebraicGeometry.finiteFieldFrobenius_pow_smul_finiteFieldExtensionCover_eq_iff` — `Φ ^ d`
  fixes a point of the fibre of `Spec κ` iff `[κ : k] ∣ d`.
* `AlgebraicGeometry.dense_zpowers_finiteFieldFrobenius` — `⟨Φ⟩` is dense in `π₁(Spec k, z)`.
* `AlgebraicGeometry.exists_isOpen_finiteFieldFrobenius_zpow_mem_dvd` — for `L > 0` an open
  subgroup of `π₁(Spec k, z)` containing `Φ ^ j` only for `L ∣ j`.
* `AlgebraicGeometry.dense_ker_sup_zpowers_of_etaleFundamentalGroupMap_eq_inv` — the geometric
  fundamental group and `φ` generate a dense subgroup of `π₁(X, x)`.
* `AlgebraicGeometry.exists_isOpen_ker_le_zpow_mem_dvd` — for `L > 0` an open subgroup of
  `π₁(X, x)` containing the geometric fundamental group and containing `φ ^ j` only for `L ∣ j`.
* `AlgebraicGeometry.encard_invariant_le_encard_extension_etaleFundamentalGroup` — for an open
  normal subgroup `U` of `π₁(X, x)` and `ψ = φ ^ [π₁(X, x) : U]`, the locally constant additive
  maps on `H ⊓ U` (`H` the geometric fundamental group) invariant under conjugation by `ψ` are at
  most as many as the locally constant additive maps killing `ψ` on an open subgroup.
-/

@[expose] public noncomputable section

open CategoryTheory Limits

universe u

namespace AlgebraicGeometry

section FiniteField

variable {k : Type u} [Field k] [Fintype k]

/-- The spectrum of a finite field extension `κ / k` as a finite étale cover of `Spec k`. -/
def finiteFieldExtensionCover (κ : Type u) [Field κ] [Algebra k κ] [Module.Finite k κ] :
    FiniteEtaleOver (Spec (.of k)) :=
  MorphismProperty.Over.mk ⊤ (Spec.map (CommRingCat.ofHom (algebraMap k κ)))
    ⟨by
      rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom]
      exact RingHom.finite_algebraMap.mpr inferInstance,
    by
      rw [HasRingHomProperty.Spec_iff (P := @Etale), CommRingCat.hom_ofHom]
      have : Finite κ := Module.finite_of_finite k
      have : Algebra.IsSeparable k κ := inferInstance
      have : Algebra.FormallyEtale k κ := Algebra.FormallyEtale.of_isSeparable k κ
      have : Algebra.FinitePresentation k κ := Algebra.FinitePresentation.of_finiteType.mp
        inferInstance
      exact RingHom.etale_algebraMap.mpr ⟨inferInstance, inferInstance⟩⟩

variable (p n : ℕ) [Fact p.Prime] [CharP k p] (hq : Fintype.card k = p ^ n)
  (z : GeometricPoint (Spec (.of k)))

/-- **`Φ ^ d` fixes a point of the fibre of `Spec κ` iff `a ^ (q ^ d) = a` on `κ`.** -/
theorem finiteFieldFrobenius_pow_smul_eq_iff (κ : Type u) [Field κ] [Algebra k κ]
    [Module.Finite k κ] (d : ℕ)
    (y : (finiteEtaleFiberFunctor z).obj (finiteFieldExtensionCover κ)) :
    (finiteFieldFrobenius p n hq z) ^ d • y = y ↔ ∀ a : κ, a ^ (p ^ n) ^ d = a := by
  have := z.charP_residueField p
  let yv : Spec (.of z.residueField) ⟶ Spec (.of κ) := y.1
  obtain ⟨e, he⟩ := Spec.map_surjective yv
  have hy : (((finiteFieldFrobenius p n hq z) ^ d • y : (finiteEtaleFiberFunctor z).obj _) :
      finiteEtaleFiber z _).1 =
      Spec.map (CommRingCat.ofHom (iterateFrobenius z.residueField p (n * d))) ≫ y.1 :=
    finiteFieldFrobenius_pow_app_coe_specMap p n hq z d _ y
  have hiff : (finiteFieldFrobenius p n hq z) ^ d • y = y ↔
      (Spec.map (CommRingCat.ofHom (iterateFrobenius z.residueField p (n * d))) ≫ Spec.map e :
        Spec (.of z.residueField) ⟶ Spec (.of κ)) = Spec.map e := by
    rw [Subtype.ext_iff]
    show (((finiteFieldFrobenius p n hq z) ^ d • y : (finiteEtaleFiberFunctor z).obj _) :
      finiteEtaleFiber z _).1 = yv ↔ _
    rw [hy]
    show Spec.map (CommRingCat.ofHom (iterateFrobenius z.residueField p (n * d))) ≫ yv = yv ↔ _
    rw [← he]
  rw [hiff, ← Spec.map_comp]
  constructor
  · intro h a
    have h'' := congrArg (fun g => g.hom a) (Spec.map_injective h)
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
      Function.comp_apply, iterateFrobenius_def] at h''
    apply e.hom.injective
    rw [map_pow, ← pow_mul, h'']
  · intro h
    congr 1
    ext a
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
      Function.comp_apply, iterateFrobenius_def]
    rw [pow_mul, ← map_pow, h a]

/-- On a finite extension `κ` of `k`, `a ^ (q ^ d) = a` for all `a` iff `[κ : k] ∣ d`. -/
theorem forall_pow_card_pow_eq_iff (κ : Type u) [Field κ] [Algebra k κ] [Module.Finite k κ]
    (d : ℕ) : (∀ a : κ, a ^ (Fintype.card k) ^ d = a) ↔ Module.finrank k κ ∣ d := by
  have : Finite κ := Module.finite_of_finite k
  rw [← FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic k κ, orderOf_dvd_iff_pow_eq_one]
  constructor
  · intro h
    ext a
    rw [AlgEquiv.coe_pow, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate]
    exact h a
  · intro h a
    simpa only [AlgEquiv.coe_pow, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate,
      AlgEquiv.one_apply] using congrArg (fun σ : Gal(κ/k) => σ a) h

/-- **`Φ ^ d` fixes a point of the fibre of `Spec κ` iff `[κ : k] ∣ d`.** -/
theorem finiteFieldFrobenius_pow_smul_finiteFieldExtensionCover_eq_iff (κ : Type u) [Field κ]
    [Algebra k κ] [Module.Finite k κ] (d : ℕ)
    (y : (finiteEtaleFiberFunctor z).obj (finiteFieldExtensionCover κ)) :
    (finiteFieldFrobenius p n hq z) ^ d • y = y ↔ Module.finrank k κ ∣ d := by
  rw [finiteFieldFrobenius_pow_smul_eq_iff p n hq z κ d y, ← hq, forall_pow_card_pow_eq_iff]

/-- The fibre of `Spec κ` at `z` has at most `[κ : k]` points: they are `k`-embeddings `κ → Ω`. -/
theorem natCard_fiber_finiteFieldExtensionCover_le (κ : Type u) [Field κ] [Algebra k κ]
    [Module.Finite k κ] :
    Nat.card ((finiteEtaleFiberFunctor z).obj (finiteFieldExtensionCover κ)) ≤
      Module.finrank k κ := by
  obtain ⟨φz, hφz⟩ := Spec.map_surjective z.hom
  let : Algebra k z.residueField := φz.hom.toAlgebra
  have hpt : ∀ y : (finiteEtaleFiberFunctor z).obj (finiteFieldExtensionCover κ),
      ∃ e : CommRingCat.of κ ⟶ CommRingCat.of z.residueField,
        (y.1 : Spec (.of z.residueField) ⟶ Spec (.of κ)) = Spec.map e ∧
          CommRingCat.ofHom (algebraMap k κ) ≫ e = φz := by
    intro y
    obtain ⟨e, he⟩ := Spec.map_surjective (y.1 : Spec (.of z.residueField) ⟶ Spec (.of κ))
    refine ⟨e, he.symm, Spec.map_injective ?_⟩
    rw [Spec.map_comp, hφz, he]
    exact y.2
  choose e he using hpt
  let emb : (finiteEtaleFiberFunctor z).obj (finiteFieldExtensionCover κ) →
      (κ →ₐ[k] z.residueField) := fun y =>
    { toRingHom := (e y).hom
      commutes' := fun c => congrArg (fun g => g.hom c) (he y).2 }
  have hinj : Function.Injective emb := by
    intro y y' h
    apply Subtype.ext
    show (y.1 : Spec (.of z.residueField) ⟶ Spec (.of κ)) = y'.1
    rw [(he y).1, (he y').1]
    congr 1
    ext a
    exact congrArg (fun g : κ →ₐ[k] z.residueField => g a) h
  exact (Nat.card_le_card_of_injective emb hinj).trans (card_algHom_le_finrank k κ z.residueField)

/-- **`Φ` acts transitively on the fibre of `Spec κ`.** -/
theorem exists_finiteFieldFrobenius_pow_smul_eq (κ : Type u) [Field κ] [Algebra k κ]
    [Module.Finite k κ] (y y' : (finiteEtaleFiberFunctor z).obj (finiteFieldExtensionCover κ)) :
    ∃ i : ℕ, (finiteFieldFrobenius p n hq z) ^ i • y = y' := by
  set Φ := finiteFieldFrobenius p n hq z
  set m := Module.finrank k κ
  have : Finite ((finiteEtaleFiberFunctor z).obj (finiteFieldExtensionCover κ)) :=
    finite_finiteEtaleFiber z _
  let orb : Fin m → (finiteEtaleFiberFunctor z).obj (finiteFieldExtensionCover κ) :=
    fun i => Φ ^ (i : ℕ) • y
  have hinj : Function.Injective orb := by
    intro i j hij
    wlog hle : (i : ℕ) ≤ j generalizing i j
    · exact (this hij.symm (le_of_not_ge hle)).symm
    have hfix : Φ ^ ((j : ℕ) - i) • (Φ ^ (i : ℕ) • y) = Φ ^ (i : ℕ) • y := by
      rw [smul_smul, ← pow_add, Nat.sub_add_cancel hle]
      exact hij.symm
    have hdvd := (finiteFieldFrobenius_pow_smul_finiteFieldExtensionCover_eq_iff p n hq z κ _
      _).1 hfix
    have hlt : (j : ℕ) - i < m := by omega
    have h0 : (j : ℕ) - i = 0 := Nat.eq_zero_of_dvd_of_lt hdvd hlt
    exact Fin.ext (by omega)
  have hbij := hinj.bijective_of_nat_card_le (by
    rw [Nat.card_fin]
    exact natCard_fiber_finiteFieldExtensionCover_le z κ)
  obtain ⟨i, hi⟩ := hbij.2 y'
  exact ⟨i, hi⟩

/-- **Every point of a geometric fibre over `Spec k` comes from the spectrum of a residue
field**: for a finite étale cover `W` of `Spec k` and a point `y` of its fibre, there are a
finite extension `κ` of `k`, a morphism of covers `Spec κ → W` and a point of the fibre of
`Spec κ` mapping to `y`. -/
theorem exists_finiteFieldExtensionCover_hom (W : FiniteEtaleOver (Spec (.of k)))
    (y : (finiteEtaleFiberFunctor z).obj W) :
    ∃ (κ : Type u) (_ : Field κ) (_ : Algebra k κ) (_ : Module.Finite k κ)
      (ι : finiteFieldExtensionCover κ ⟶ W)
      (y' : (finiteEtaleFiberFunctor z).obj (finiteFieldExtensionCover κ)),
      (finiteEtaleFiberFunctor z).map ι y' = y := by
  have hfac0 := (Scheme.SpecToEquivOfField z.residueField W.left).symm_apply_apply y.1
  generalize (Scheme.SpecToEquivOfField z.residueField W.left) y.1 = q at hfac0
  obtain ⟨w, e⟩ := q
  rw [Scheme.SpecToEquivOfField_symm_apply] at hfac0
  have : IsFinite W.hom := W.prop.1
  let : Algebra k (W.left.residueField w) := (fieldToResidue W.hom w).hom.toAlgebra
  have : DiscreteTopology W.left := discreteTopology_of_isFinite_over_field k W.hom
  have hclosed : IsClosed ({w} : Set W.left) := isClosed_discrete _
  have : Algebra.FiniteType k (W.left.residueField w) :=
    Stacks.EtaleCohomology.finiteType_fieldToResidue W.hom w hclosed
  have : Module.Finite k (W.left.residueField w) :=
    finite_of_finite_type_of_isJacobsonRing k (W.left.residueField w)
  have hι : W.left.fromSpecResidueField w ≫ W.hom =
      Spec.map (CommRingCat.ofHom (algebraMap k (W.left.residueField w))) := by
    have := (Stacks.EtaleCohomology.fromSpecResidueField_comp_eq_iff W.hom
      (W.left.residueField w) w (𝟙 (W.left.residueField w))).2 (by simp; rfl)
    calc W.left.fromSpecResidueField w ≫ W.hom =
        (Spec.map (𝟙 (W.left.residueField w)) ≫ W.left.fromSpecResidueField w) ≫ W.hom := by
          rw [Spec.map_id, Category.id_comp]
      _ = _ := this
  let ι : finiteFieldExtensionCover (W.left.residueField w) ⟶ W :=
    MorphismProperty.Over.homMk (W.left.fromSpecResidueField w) hι
  refine ⟨W.left.residueField w, inferInstance, inferInstance, inferInstance, ι,
    ⟨Spec.map e, ?_⟩, Subtype.ext hfac0⟩
  show Spec.map e ≫ Spec.map (CommRingCat.ofHom (algebraMap k (W.left.residueField w))) = z.hom
  refine (congrArg (Spec.map e ≫ ·) hι.symm).trans ?_
  rw [← Category.assoc, hfac0, y.2]

/-- **`⟨Φ⟩` is dense in `π₁(Spec k, z)`** for the topology of Stacks 0BMR. -/
theorem dense_zpowers_finiteFieldFrobenius :
    Dense ((Subgroup.zpowers (finiteFieldFrobenius p n hq z) :
      Subgroup (EtaleFundamentalGroup (Spec (.of k)) z)) :
        Set (EtaleFundamentalGroup (Spec (.of k)) z)) := by
  set Φ := finiteFieldFrobenius p n hq z
  intro γ
  rw [mem_closure_iff_nhds]
  intro t ht
  have ht1 : {g : EtaleFundamentalGroup (Spec (.of k)) z | γ * g ∈ t} ∈
      nhds (1 : EtaleFundamentalGroup (Spec (.of k)) z) := by
    have hc : Continuous fun g : EtaleFundamentalGroup (Spec (.of k)) z => γ * g :=
      continuous_const.mul continuous_id
    have := hc.continuousAt (x := 1)
    simp only [ContinuousAt, mul_one] at this
    exact this ht
  obtain ⟨O, ⟨W, y, rfl⟩, hO⟩ :=
    (EtaleFundamentalGroup.nhds_one_hasBasis_isOpenSubgroup _ z).mem_iff.1 ht1
  obtain ⟨κ, _, _, _, ι, y', rfl⟩ := exists_finiteFieldExtensionCover_hom z W y
  obtain ⟨i, hi⟩ := exists_finiteFieldFrobenius_pow_smul_eq p n hq z κ y' (γ • y')
  have hnat : ∀ (σ : EtaleFundamentalGroup (Spec (.of k)) z) (a : (finiteEtaleFiberFunctor z).obj
      (finiteFieldExtensionCover κ)),
      σ • (finiteEtaleFiberFunctor z).map ι a = (finiteEtaleFiberFunctor z).map ι (σ • a) :=
    fun σ a => by
      show (σ.hom.app W) ((finiteEtaleFiberFunctor z).map ι a) =
        (finiteEtaleFiberFunctor z).map ι ((σ.hom.app _) a)
      exact NatTrans.naturality_apply σ.hom ι a
  refine ⟨Φ ^ i, ?_, pow_mem (Subgroup.mem_zpowers Φ) i⟩
  have hmem : γ⁻¹ * Φ ^ i ∈ MulAction.stabilizer (EtaleFundamentalGroup (Spec (.of k)) z)
      ((finiteEtaleFiberFunctor z).map ι y') := by
    rw [MulAction.mem_stabilizer_iff, mul_smul, hnat, hi, ← hnat, inv_smul_smul]
  simpa only [Set.mem_setOf_eq, mul_inv_cancel_left] using hO hmem

/-- **The powers of `Φ` are detected by an open subgroup**: for `L > 0` the stabilizer of a point
of the fibre of `Spec κ`, `κ` of degree `L` over `k`, contains `Φ ^ j` only when `L ∣ j`. -/
theorem exists_isOpen_finiteFieldFrobenius_zpow_mem_dvd (L : ℕ) (hL : 0 < L) :
    ∃ O : Subgroup (EtaleFundamentalGroup (Spec (.of k)) z),
      IsOpen (O : Set (EtaleFundamentalGroup (Spec (.of k)) z)) ∧
        ∀ j : ℤ, (finiteFieldFrobenius p n hq z) ^ j ∈ O → (L : ℤ) ∣ j := by
  have : NeZero L := ⟨hL.ne'⟩
  let E := FiniteField.Extension k p L
  let ψ : E →ₐ[k] AlgebraicClosure k := IsAlgClosed.lift
  let κ := ψ.fieldRange
  have : Module.Finite k κ := LinearEquiv.finiteDimensional ψ.equivFieldRange.toLinearEquiv
  have hκ : Module.finrank k κ = L := by
    rw [← ψ.equivFieldRange.toLinearEquiv.finrank_eq, FiniteField.finrank_extension]
  obtain ⟨φz, hφz⟩ := Spec.map_surjective z.hom
  let : Algebra k z.residueField := φz.hom.toAlgebra
  let ε : κ →ₐ[k] z.residueField := IsAlgClosed.lift
  let y : (finiteEtaleFiberFunctor z).obj (finiteFieldExtensionCover κ) :=
    ⟨Spec.map (CommRingCat.ofHom ε.toRingHom), by
      show Spec.map (CommRingCat.ofHom ε.toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap k κ)) = z.hom
      rw [← Spec.map_comp, ← hφz]
      congr 1
      ext c
      exact ε.commutes c⟩
  refine ⟨MulAction.stabilizer _ y,
    EtaleFundamentalGroup.isOpen_coe_of_isOpenSubgroup ⟨_, y, rfl⟩, fun j hj => ?_⟩
  have hnat : (finiteFieldFrobenius p n hq z) ^ j.natAbs • y = y := by
    rcases Int.natAbs_eq j with h | h
    · rwa [MulAction.mem_stabilizer_iff, h, zpow_natCast] at hj
    · have hj' := Subgroup.inv_mem _ hj
      rwa [MulAction.mem_stabilizer_iff, h, zpow_neg, inv_inv, zpow_natCast] at hj'
  have := (finiteFieldFrobenius_pow_smul_finiteFieldExtensionCover_eq_iff p n hq z κ _ y).1 hnat
  rw [hκ] at this
  exact Int.natCast_dvd.2 this

/-! ### Consequences for a scheme over `k` -/

variable {X : Scheme.{u}} [ConnectedSpace X] (f : X ⟶ Spec (.of k)) (x : GeometricPoint X)
  (φ : EtaleFundamentalGroup X x)
  (hφ : etaleFundamentalGroupMap f x φ = (finiteFieldFrobenius p n hq (x.map f))⁻¹)

include hφ in
/-- **The powers of a Frobenius lift `φ` are detected by open subgroups containing the geometric
fundamental group** `ker(π₁(X, x) → π₁(Spec k))`. -/
theorem exists_isOpen_ker_le_zpow_mem_dvd (L : ℕ) (hL : 0 < L) :
    ∃ O : Subgroup (EtaleFundamentalGroup X x), IsOpen (O : Set (EtaleFundamentalGroup X x)) ∧
      (etaleFundamentalGroupMap f x).toMonoidHom.ker ≤ O ∧
        ∀ j : ℤ, φ ^ j ∈ O → (L : ℤ) ∣ j := by
  obtain ⟨O, hOo, hO⟩ := exists_isOpen_finiteFieldFrobenius_zpow_mem_dvd p n hq (x.map f) L hL
  refine ⟨O.comap (etaleFundamentalGroupMap f x).toMonoidHom,
    hOo.preimage (etaleFundamentalGroupMap f x).continuous, fun g hg => ?_, fun j hj => ?_⟩
  · rw [Subgroup.mem_comap, (MonoidHom.mem_ker).1 hg]
    exact O.one_mem
  · rw [Subgroup.mem_comap, map_zpow] at hj
    change (etaleFundamentalGroupMap f x φ) ^ j ∈ O at hj
    rw [hφ, inv_zpow'] at hj
    have := hO (-j) hj
    rwa [Int.dvd_neg] at this

include hφ in
/-- **The geometric fundamental group and a Frobenius lift `φ` generate a dense subgroup** of
`π₁(X, x)`. -/
theorem dense_ker_sup_zpowers_of_etaleFundamentalGroupMap_eq_inv :
    Dense (((etaleFundamentalGroupMap f x).toMonoidHom.ker ⊔ Subgroup.zpowers φ :
      Subgroup (EtaleFundamentalGroup X x)) : Set (EtaleFundamentalGroup X x)) := by
  have : ∀ Y, Finite ((finiteEtaleFiberFunctor x).obj Y) := finite_finiteEtaleFiber x
  have : ∀ Y, Finite ((finiteEtaleFiberFunctor (x.map f)).obj Y) :=
    finite_finiteEtaleFiber (x.map f)
  set F := etaleFundamentalGroupMap f x
  set K := F.toMonoidHom.ker
  set S := (K ⊔ Subgroup.zpowers φ).topologicalClosure
  have hS : IsClosed (S : Set (EtaleFundamentalGroup X x)) := Subgroup.isClosed_topologicalClosure _
  have himage : IsClosed (F '' (S : Set (EtaleFundamentalGroup X x))) :=
    (hS.isCompact.image F.continuous).isClosed
  have hzp : ((Subgroup.zpowers (finiteFieldFrobenius p n hq (x.map f))) :
      Set (EtaleFundamentalGroup (Spec (.of k)) (x.map f))) ⊆
        F '' (S : Set (EtaleFundamentalGroup X x)) := by
    rintro _ ⟨j, rfl⟩
    refine ⟨φ ^ (-j), Subgroup.le_topologicalClosure _ (Subgroup.mem_sup_right
      (Subgroup.zpow_mem_zpowers φ _)), ?_⟩
    show F.toMonoidHom (φ ^ (-j)) = _
    rw [map_zpow]
    show (F φ) ^ (-j) = _
    rw [hφ, inv_zpow', neg_neg]
  have hall : F '' (S : Set (EtaleFundamentalGroup X x)) = Set.univ := by
    refine Set.eq_univ_of_univ_subset ?_
    rw [← (dense_zpowers_finiteFieldFrobenius p n hq (x.map f)).closure_eq]
    exact closure_minimal hzp himage
  rw [dense_iff_closure_eq, Set.eq_univ_iff_forall]
  intro g
  obtain ⟨s, hs, hgs⟩ := hall.symm ▸ Set.mem_univ (F g)
  have hker : g * s⁻¹ ∈ K := by
    rw [MonoidHom.mem_ker, map_mul, map_inv]
    show F g * (F s)⁻¹ = 1
    rw [hgs, mul_inv_cancel]
  have := S.mul_mem (Subgroup.le_topologicalClosure _ (Subgroup.mem_sup_left hker)) hs
  rwa [inv_mul_cancel_right] at this

omit [Fintype k] in
/-- The geometric fundamental group `ker(π₁(X, x) → π₁(Spec k))` is closed. -/
theorem isClosed_ker_etaleFundamentalGroupMap :
    IsClosed (((etaleFundamentalGroupMap f x).toMonoidHom.ker :
      Subgroup (EtaleFundamentalGroup X x)) : Set (EtaleFundamentalGroup X x)) := by
  have : ∀ Y, Finite ((finiteEtaleFiberFunctor (x.map f)).obj Y) :=
    finite_finiteEtaleFiber (x.map f)
  exact isClosed_singleton.preimage (etaleFundamentalGroupMap f x).continuous

include hφ in
/-- **Invariant characters of `π₁(X_k̄) ∩ U` are counted by characters of an open subgroup.**
For an open normal subgroup `U` of `π₁(X, x)` and `ψ = φ ^ [π₁ : U]`, the locally constant
additive maps `χ : H ⊓ U → A` (`H` the geometric fundamental group) invariant under conjugation
by `ψ` are at most as many as the locally constant additive maps on the open subgroup
`V = (H ⊓ U) ⊔ closure ⟨ψ⟩` killing `ψ`. -/
theorem encard_invariant_le_encard_extension_etaleFundamentalGroup {A : Type*} [AddCommGroup A]
    (U : Subgroup (EtaleFundamentalGroup X x)) [U.Normal]
    (hUo : IsOpen (U : Set (EtaleFundamentalGroup X x))) :
    IsOpen (((etaleFundamentalGroupMap f x).toMonoidHom.ker ⊓ U ⊔
        (Subgroup.zpowers (φ ^ U.index)).topologicalClosure :
          Subgroup (EtaleFundamentalGroup X x)) : Set (EtaleFundamentalGroup X x)) ∧
    {χ : ↥((etaleFundamentalGroupMap f x).toMonoidHom.ker ⊓ U) → A |
        (∀ a b, χ (a * b) = χ a + χ b) ∧ IsLocallyConstant χ ∧
        ∀ a b : ↥((etaleFundamentalGroupMap f x).toMonoidHom.ker ⊓ U),
          (b : EtaleFundamentalGroup X x) = φ ^ U.index * a * (φ ^ U.index)⁻¹ → χ b = χ a}.encard ≤
      {χ' : ↥((etaleFundamentalGroupMap f x).toMonoidHom.ker ⊓ U ⊔
          (Subgroup.zpowers (φ ^ U.index)).topologicalClosure) → A |
        (∀ a b, χ' (a * b) = χ' a + χ' b) ∧ IsLocallyConstant χ' ∧
        χ' ⟨φ ^ U.index, Subgroup.mem_sup_right
          (Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers _))⟩ = 0}.encard := by
  have : ∀ Y, Finite ((finiteEtaleFiberFunctor x).obj Y) := finite_finiteEtaleFiber x
  have hH := isClosed_ker_etaleFundamentalGroupMap f x
  have hdense := dense_ker_sup_zpowers_of_etaleFundamentalGroupMap_eq_inv p n hq f x φ hφ
  have hO := exists_isOpen_ker_le_zpow_mem_dvd p n hq f x φ hφ
  exact ⟨(Stacks.LAdic.isOpen_and_exists_extension (A := A) hH hdense hO hUo).1,
    Stacks.LAdic.encard_invariant_le_encard_extension hH hdense hO hUo⟩

end FiniteField

end AlgebraicGeometry
