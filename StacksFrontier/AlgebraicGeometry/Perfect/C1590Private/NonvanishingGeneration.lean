module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ToposPullbackLocalGeneration
public import StacksFrontier.AlgebraicGeometry.AmpleFromAffineNonvanishing.Basic
public import StacksFrontier.AlgebraicGeometry.AmplePowers.ModuleStalk
public import StacksFrontier.AlgebraicGeometry.NonvanishingPullback.GlobalSections
public import StacksFrontier.AlgebraicGeometry.NonvanishingSpelling.Trivialize

/-!
# Global generation of an invertible module through nonvanishing loci

For an invertible module `ℒ` on a scheme `Y`, the nonvanishing locus `Y_s` of a global section `s`
is the open set where `s` generates `ℒ` (Stacks 01CY). This file records the two directions of
the dictionary between global generation and these loci:

* a family of global sections whose nonvanishing loci cover `Y` generates `ℒ`
  (`AlgebraicGeometry.C1590Private.nonempty_generatingSections_of_forall_mem_nonvanishingLocus`);
* if `ℒ` is globally generated, every point lies in the nonvanishing locus of some global section
  (`AlgebraicGeometry.C1590Private.exists_mem_nonvanishingLocus_of_generatingSections`);

and that a linear combination of global sections can only be nonvanishing at a point where one of
them is (`AlgebraicGeometry.C1590Private.exists_mem_nonvanishingLocus_of_sum_smul`).

## Implementation notes

The nonvanishing locus is `Stacks.Ample.nonvanishingLocus`, the spelling of the openness theorem
`Stacks.NonvanishingOpen.isOpen_nonvanishingLocus` and of the pullback statement
`Stacks.NonvanishingPullback.preimage_nonvanishingLocus_pullbackGlobalSections` (Stacks 0H78).
These are unregistered helpers.

## References

* [Stacks Project, Tag 01CY](https://stacks.math.columbia.edu/tag/01CY)
* [Stacks Project, Tag 0H78](https://stacks.math.columbia.edu/tag/0H78)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite

universe u

namespace AlgebraicGeometry.C1590Private

variable {Y : Scheme.{u}}

/-- **Sections whose nonvanishing loci cover generate.** A finite family of global sections of an
invertible module whose nonvanishing loci cover the scheme generates the module: over the
nonvanishing locus of `sᵢ` every section is a multiple of `sᵢ` (Stacks 01CY). -/
theorem nonempty_generatingSections_of_forall_mem_nonvanishingLocus (M : Y.Modules)
    [Stacks.Ample.IsInvertibleModule Y M] {r : ℕ} (s : Fin r → Γ(M, ⊤))
    (h : ∀ y : Y, ∃ i, y ∈ Stacks.Ample.nonvanishingLocus M (s i)) :
    Nonempty M.GeneratingSections := by
  classical
  let s' : Fin r → M.sections := fun i => (Stacks.NonvanishingSpelling.sectionsEquiv Y M).symm (s i)
  have key : ∀ (U : Y.Opens) (x : M.val.obj (op U)),
      Stacks.Sheaves.LocalGeneration.spanSieve M (fun i => (s' i).val (op U)) x ∈
        Opens.grothendieckTopology Y U := by
    intro U x
    rw [Opens.mem_grothendieckTopology]
    intro y hy
    obtain ⟨i, hi⟩ := h y
    let W : Y.Opens := U ⊓ Stacks.NonvanishingOpen.nonvanishingOpen Y M (s i)
    refine ⟨W, homOfLE inf_le_left, ?_, ⟨hy, hi⟩⟩
    obtain ⟨a, ha⟩ := (Stacks.NonvanishingSpelling.bijective_smul Y M (s i)
      (W := W) inf_le_right).2 (M.presheaf.map (homOfLE inf_le_left).op x)
    let a' : Y.ringCatSheaf.obj.obj (op W) := a
    refine ⟨fun j => if j = i then a' else 0, ?_⟩
    refine (Fintype.sum_eq_single i fun j hj => ?_).trans ?_
    · dsimp only
      rw [ite_eq_right hj, zero_smul]
    dsimp only
    rw [ite_eq_left rfl]
    have h1 : (s' i).val (op U) = M.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op (s i) :=
      Stacks.NonvanishingSpelling.sectionsEquiv_symm_eval Y M (s i) U
    have hres : Stacks.Sheaves.LocalGeneration.restr M (homOfLE (inf_le_left : W ≤ U)).op
        ((s' i).val (op U)) = M.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op (s i) := by
      change M.presheaf.map (homOfLE (inf_le_left : W ≤ U)).op ((s' i).val (op U)) = _
      rw [h1, ← ConcreteCategory.comp_apply, ← Functor.map_comp]
      rfl
    exact (congrArg (fun t => a' • t) hres).trans ha
  obtain ⟨σ, -⟩ :=
    Stacks.Sheaves.LocalGeneration.exists_generatingSections_of_locally_spanning_sections M r s'
      key
  exact ⟨σ⟩

/-- **A generating family has a member nonvanishing at every point.** If an invertible module is
generated by a family of global sections, every point lies in the nonvanishing locus of one of
them. -/
theorem exists_mem_nonvanishingLocus_of_generatingSections (M : Y.Modules)
    [Stacks.Ample.IsInvertibleModule Y M] (σ : M.GeneratingSections) (y : Y) :
    ∃ i, y ∈ Stacks.Ample.nonvanishingLocus M
      (Stacks.NonvanishingSpelling.sectionsEquiv Y M (σ.s i)) := by
  obtain ⟨i, hi⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing M σ y
  refine ⟨i, ?_⟩
  rw [← Stacks.NonvanishingSpelling.stalkNonvanishingLocus_eq]
  exact hi

/-- **A linear combination is nonvanishing only where a summand is.** If `∑ cᵢ • bᵢ` does not
vanish at `y`, then some `bᵢ` does not vanish at `y`: the germs vanishing at `y` form the
submodule `𝔪_y · M_y`. -/
theorem exists_mem_nonvanishingLocus_of_sum_smul (M : Y.Modules) {ι : Type*} (S : Finset ι)
    (c : ι → Γ(Y, ⊤)) (b : ι → Γ(M, ⊤)) {y : Y}
    (hy : y ∈ Stacks.Ample.nonvanishingLocus M (∑ i ∈ S, c i • b i)) :
    ∃ i ∈ S, y ∈ Stacks.Ample.nonvanishingLocus M (b i) := by
  by_contra! h
  refine hy ?_
  rw [map_sum]
  refine Submodule.sum_mem _ fun i hi => ?_
  rw [Stacks.ModuleStalk.Γgerm_smul]
  exact Submodule.smul_mem _ _ (not_not.1 (h i hi))

/-- **Nonvanishing is invariant under isomorphism.** -/
theorem mem_nonvanishingLocus_iso_iff {M N : Y.Modules} (e : M ≅ N) (s : Γ(M, ⊤)) (y : Y) :
    y ∈ Stacks.Ample.nonvanishingLocus N (e.hom.app ⊤ s) ↔
      y ∈ Stacks.Ample.nonvanishingLocus M s := by
  refine not_congr ?_
  rw [← Stacks.ModuleStalk.mapFun_Γgerm]
  exact Stacks.ModuleStalk.mem_maximalSmul_mapFun_iff e y _

end AlgebraicGeometry.C1590Private

end
