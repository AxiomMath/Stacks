module

public import StacksFrontier.AlgebraicGeometry.Perfect.ProperFlatFamily.UnitModel
public import StacksFrontier.AlgebraicGeometry.Descent.EffectiveEpi.QuasicoherentSectionsEqualizer
public import StacksFrontier.AlgebraicGeometry.Descent.GermSourceAndTarget.Flat
public import StacksFrontier.AlgebraicGeometry.ModuleLimits.Invertible
public import StacksFrontier.AlgebraicGeometry.Variety.Geometrically.ProperGlobalSections

/-!
# The unit of a proper flat family is bijective near a point where it is so on the fibre

Let `f : X ⟶ Spec A` be proper, flat and of finite presentation and let `p` be a prime of `A` such
that `κ(p) ⟶ Γ(X_p, 𝒪_{X_p})` is bijective. Then there is `a ∉ p` such that `A_a ⟶ Γ(X, 𝒪_X)_a` is
bijective: the kernel of `A ⟶ Γ(X, 𝒪_X)` is killed by a power of `a`, and every global function
times a power of `a` comes from `A`.

This is the local form of part (a) of [Stacks, Tag 0E62]. The proof is the source's: the unit
`A ⟶ RΓ(X, 𝒪_X)` is a map of perfect complexes ([Stacks, Tag 0B91]), which by hypothesis is an
isomorphism on `H⁰` of the fibre at `p`; its source has no `H¹`, so it is injective on `H¹` of the
fibre, and `StacksDraft.Perfect.exists_away_of_fibre_elementwise` spreads both conditions out.

## Main results

* `Stacks.AlgebraicGeometry.ProperFlatGlobalSections.exists_away_unit_bijective`
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped ChangeOfRings

universe u

namespace Stacks.AlgebraicGeometry.ProperFlatGlobalSections

variable {A : Type u} [CommRing A]

/-- Every element of the extension of scalars of a module generated by `e₀` is `c ⊗ e₀`. -/
theorem exists_eq_tmul_of_generator {B : Type u} [CommRing B] (ψ : A →+* B)
    {M : ModuleCat.{u} A} (e₀ : M) (hgen : ∀ m : M, ∃ r : A, m = r • e₀)
    (x : (ModuleCat.extendScalars.{u, u, u} ψ).obj M) :
    ∃ c : B, x = c ⊗ₜ[A, ψ] e₀ := by
  induction x using TensorProduct.inductionOn with
  | tmul b m =>
    obtain ⟨r, rfl⟩ := hgen m
    exact ⟨ψ r * (show B from b), (TensorProduct.smul_tmul (R := A) r b e₀).symm⟩
  | add x y hx hy =>
    obtain ⟨c, rfl⟩ := hx
    obtain ⟨d, rfl⟩ := hy
    exact ⟨c + d, (TensorProduct.add_tmul
      (show (ModuleCat.restrictScalars.{u} ψ).obj (ModuleCat.of B B) from c) d e₀).symm⟩

/-- The degree-zero term of `A` placed in degree zero is generated by the image of `1`. -/
theorem baseUnitComplex_gen (m : (baseUnitComplex A).X 0) :
    ∃ r : A, m = r • (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0
      (ModuleCat.of A A)).inv (1 : A) := by
  set e := HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (ModuleCat.of A A)
  refine ⟨e.hom m, ?_⟩
  rw [← map_smul, smul_eq_mul, mul_one, Iso.hom_inv_id_apply]

/-- The degree-one term of `A` placed in degree zero vanishes after any extension of scalars. -/
private theorem extendScalarsCx_baseUnitComplex_X_one_eq_zero {B : Type u} [CommRing B]
    (ψ : A →+* B) (z : (StacksDraft.Perfect.extendScalarsCx ψ (baseUnitComplex A)).X 1) : z = 0 :=
  @Subsingleton.elim _ ((ModuleCat.isZero_iff_subsingleton).1
    ((ModuleCat.extendScalars.{u, u, u} ψ).map_isZero
      (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 _ 1 (by decide)))) z 0

section Map

variable {X : Scheme.{u}} (f : X ⟶ Spec (.of A))
  {I : Type u} (U : I → X.Opens) (hU : (⊤ : X.Opens) = ⨆ i, U i)

/-- The degree-zero component of `unitModelMap` sends `r ∈ A` to `unitCochain f U hU r`. -/
theorem unitModelMap_f_zero_apply (hcov : (⊤ : X.Opens) ≤ ⨆ i, U i) (r : A) :
    (unitModelMap f U hU hcov).f 0
        ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (ModuleCat.of A A)).inv r) =
      unitCochain f U hU r := by
  have h := HomologicalComplex.mkHomFromSingle_f (unitCochain f U hU) (fun k hk => by
    obtain rfl : k = 1 := by simpa using hk.symm
    exact unitCochain_comp_d f U hU hcov)
  refine (congr($h ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0
    (ModuleCat.of A A)).inv r))).trans ?_
  rw [ConcreteCategory.comp_apply, Iso.inv_hom_id_apply]

/-- The degree-zero unit cochain of `r ∈ A` is the alternating Čech cochain whose components are
the restrictions of the global section `r • 1` of the structure sheaf. -/
theorem unitCochain_apply (r : A) :
    letI := Stacks.Cech.sectionsModule f (SheafOfModules.unit X.ringCatSheaf) ⊤
    unitCochain f U hU r =
      (baseAlternatingCechComplexXIso f U hU (SheafOfModules.unit X.ringCatSheaf) 0).inv
        (Stacks.Cech.sectionsToAlternatingₗ f U (SheafOfModules.unit X.ringCatSheaf)
          (fun _ => le_top) (r • (show Γ(SheafOfModules.unit X.ringCatSheaf, ⊤) from
            (1 : Γ(X, ⊤))))) :=
  rfl

/-- The alternating Čech cochain of a global function is a cocycle of the `A`-linear model. -/
private theorem baseAlternatingCechComplex_d_sectionsToAlternatingₗ (s : Γ(X, ⊤)) :
    letI := Stacks.Cech.sectionsModule f (SheafOfModules.unit X.ringCatSheaf) ⊤
    (baseAlternatingCechComplex f U hU (SheafOfModules.unit X.ringCatSheaf)).d 0 1
      ((baseAlternatingCechComplexXIso f U hU (SheafOfModules.unit X.ringCatSheaf) 0).inv
        (Stacks.Cech.sectionsToAlternatingₗ f U (SheafOfModules.unit X.ringCatSheaf)
          (fun _ => le_top) (show Γ(SheafOfModules.unit X.ringCatSheaf, ⊤) from s))) = 0 := by
  set O : X.Modules := SheafOfModules.unit X.ringCatSheaf
  let := Stacks.Cech.sectionsModule f O ⊤
  let := Stacks.Cech.cochainModule f U O 0
  let := Stacks.Cech.cochainModule f U O 1
  have hm : Stacks.Cech.sectionsToAlternatingₗ f U O (fun _ => le_top) (show Γ(O, ⊤) from s) ∈
      LinearMap.ker (Stacks.Cech.alternatingCechModuleD f U O 0) :=
    Stacks.Cech.range_sectionsToAlternatingₗ f U O (fun _ => le_top) hU.le ▸
      LinearMap.mem_range_self _ _
  change (baseAlternatingCechComplex f U hU O).d ((0 : ℕ) : ℤ) ((0 + 1 : ℕ) : ℤ) _ = 0
  refine (congr($(baseAlternatingCechComplexXIso_inv_comp_d f U hU O 0)
    (Stacks.Cech.sectionsToAlternatingₗ f U O (fun _ => le_top) (show Γ(O, ⊤) from s)))).trans ?_
  change (baseAlternatingCechComplexXIso f U hU O (0 + 1)).inv
    (Stacks.Cech.alternatingCechModuleD f U O 0 _) = 0
  rw [LinearMap.mem_ker.1 hm]
  exact ((baseAlternatingCechComplexXIso f U hU O (0 + 1)).inv).hom.map_zero

end Map

section Main

attribute [local instance 10000] HasDerivedCategory.standard

variable {X : Scheme.{u}} (f : X ⟶ Spec (.of A))

/-- The pullback of the unit section is the unit section, through `pullbackUnitIso`. -/
private theorem pullbackUnitIso_pullbackSections_one {X' : Scheme.{u}} (g : X' ⟶ X) :
    (Scheme.Modules.pullbackUnitIso g).hom.app ⊤
      (Stacks.Cech.pullbackSections g (SheafOfModules.unit X.ringCatSheaf) ⊤
        (show Γ(SheafOfModules.unit X.ringCatSheaf, ⊤) from (1 : Γ(X, ⊤)))) =
      (show Γ(SheafOfModules.unit X'.ringCatSheaf, ⊤) from (1 : Γ(X', ⊤))) := by
  have h := AlgebraicGeometry.SectionsEqualizer.pullbackUnitIso_unit g (1 : Γ(X, ⊤))
  have h2 := AlgebraicGeometry.SectionsEqualizer.pullbackGlobalSections_unit g
    (SheafOfModules.unit X.ringCatSheaf) (show Γ(SheafOfModules.unit X.ringCatSheaf, ⊤) from
      (1 : Γ(X, ⊤)))
  refine Eq.trans ?_ (h.trans (map_one (Scheme.Hom.appTop g).hom))
  exact congrArg (fun z => (Scheme.Modules.pullbackUnitIso g).hom.app ⊤ z) h2.symm

/-- The structural ring map at the top open is the global one. -/
theorem baseRingHom_top_apply {B : Type u} [CommRing B] {Y : Scheme.{u}}
    (h : Y ⟶ Spec (.of B)) (b : B) :
    (Stacks.Cech.baseRingHom h ⊤).hom b = (Stacks.Cech.globalRingHom h).hom b := by
  change (Y.presheaf.map (homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)).op).hom
    ((Stacks.Cech.globalRingHom h).hom b) = _
  rw [show (homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)).op = 𝟙 _ from rfl, CategoryTheory.Functor.map_id]
  rfl

/-- The structural ring map to an open equal to the whole scheme is bijective when the global one
is. -/
theorem bijective_baseRingHom_of_eq_top {B : Type u} [CommRing B] {Y : Scheme.{u}}
    (h : Y ⟶ Spec (.of B)) {W : Y.Opens} (hW : W = ⊤)
    (hb : Function.Bijective (Stacks.Cech.globalRingHom h).hom) :
    Function.Bijective (Stacks.Cech.baseRingHom h W).hom := by
  subst hW
  rwa [RingHom.ext (baseRingHom_top_apply h)]

/-- The `A`-module structure on the global sections of `𝒪_X` is multiplication through the ring
map `A ⟶ Γ(X, 𝒪_X)`. -/
private theorem smul_globalSections_unit_eq_mul (r : A)
    (t : Γ(SheafOfModules.unit X.ringCatSheaf, ⊤)) :
    letI := Stacks.Cech.sectionsModule f (SheafOfModules.unit X.ringCatSheaf) ⊤
    (show Γ(X, ⊤) from r • t) =
      (Stacks.Cech.globalRingHom f).hom r * (show Γ(X, ⊤) from t) := by
  change (Stacks.Cech.baseRingHom f ⊤).hom r * _ = _
  rw [baseRingHom_top_apply]

/-- The unit model map kills the elements of `A` that vanish as global functions on `X`. -/
private theorem unitModelMap_f_zero_eq_zero_of_globalRingHom_eq_zero {I : Type u} (U : I → X.Opens)
    (hU : (⊤ : X.Opens) = ⨆ i, U i) (hcov : (⊤ : X.Opens) ≤ ⨆ i, U i) {r : A}
    (hr : (Stacks.Cech.globalRingHom f).hom r = 0) :
    (unitModelMap f U hU hcov).f 0
      ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (ModuleCat.of A A)).inv r) = 0 := by
  set O : X.Modules := SheafOfModules.unit X.ringCatSheaf
  let := Stacks.Cech.sectionsModule f O ⊤
  set one : Γ(O, ⊤) := (show Γ(O, ⊤) from (1 : Γ(X, ⊤)))
  have : r • one = 0 := by
    change (show Γ(X, ⊤) from r • one) = 0
    rw [smul_globalSections_unit_eq_mul, hr, zero_mul]
  refine (unitModelMap_f_zero_apply f U hU hcov r).trans ((unitCochain_apply f U hU r).trans ?_)
  exact (congrArg (fun t => (baseAlternatingCechComplexXIso f U hU O 0).inv
    (Stacks.Cech.sectionsToAlternatingₗ f U O (fun _ => le_top) t)) this).trans
    ((congrArg (baseAlternatingCechComplexXIso f U hU O 0).inv (map_zero _)).trans
      ((baseAlternatingCechComplexXIso f U hU O 0).inv.hom.map_zero))

/-- If the unit model map sends `r ∈ A` to `b` times the Čech cochain of a global function `s`,
then `r = b * s` as global functions on `X`. -/
private theorem globalRingHom_eq_mul_of_unitModelMap_f_zero_eq_smul {I : Type u} (U : I → X.Opens)
    (hU : (⊤ : X.Opens) = ⨆ i, U i) (hcov : (⊤ : X.Opens) ≤ ⨆ i, U i) {r b : A} {s : Γ(X, ⊤)}
    (h : letI := Stacks.Cech.sectionsModule f (SheafOfModules.unit X.ringCatSheaf) ⊤
      (unitModelMap f U hU hcov).f 0
          ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (ModuleCat.of A A)).inv r) =
        b • (baseAlternatingCechComplexXIso f U hU (SheafOfModules.unit X.ringCatSheaf) 0).inv
          (Stacks.Cech.sectionsToAlternatingₗ f U (SheafOfModules.unit X.ringCatSheaf)
            (fun _ => le_top) (show Γ(SheafOfModules.unit X.ringCatSheaf, ⊤) from s))) :
    (Stacks.Cech.globalRingHom f).hom r = (Stacks.Cech.globalRingHom f).hom b * s := by
  set O : X.Modules := SheafOfModules.unit X.ringCatSheaf
  let := Stacks.Cech.sectionsModule f O ⊤
  set s' : Γ(O, ⊤) := (show Γ(O, ⊤) from s)
  set one : Γ(O, ⊤) := (show Γ(O, ⊤) from (1 : Γ(X, ⊤)))
  have hy : b • (baseAlternatingCechComplexXIso f U hU O 0).inv
      (Stacks.Cech.sectionsToAlternatingₗ f U O (fun _ => le_top) s') =
      (baseAlternatingCechComplexXIso f U hU O 0).inv
        (Stacks.Cech.sectionsToAlternatingₗ f U O (fun _ => le_top) (b • s')) := by
    refine Eq.symm ((congrArg (fun t => (baseAlternatingCechComplexXIso f U hU O 0).inv t)
      (LinearMap.map_smul (Stacks.Cech.sectionsToAlternatingₗ f U O (fun _ => le_top))
        b s')).trans ?_)
    exact (baseAlternatingCechComplexXIso f U hU O 0).inv.hom.map_smul b
      (Stacks.Cech.sectionsToAlternatingₗ f U O (fun _ => le_top) s')
  have h' := Stacks.Cech.sectionsToAlternatingₗ_injective f U O (fun _ => le_top) hcov
    ((ConcreteCategory.bijective_of_isIso (baseAlternatingCechComplexXIso f U hU O 0).inv).1
      ((unitCochain_apply f U hU r).symm.trans
      ((unitModelMap_f_zero_apply f U hU hcov r).symm.trans (h.trans hy))))
  exact (mul_one _).symm.trans ((smul_globalSections_unit_eq_mul f r one).symm.trans
    ((congrArg (fun t : Γ(O, ⊤) => (show Γ(X, ⊤) from t)) h').trans
      (smul_globalSections_unit_eq_mul f b s')))

/-- If `B ⟶ Γ(Y, 𝒪_Y)` is bijective, then every section of the pullback of `𝒪_X` along
`g : Y ⟶ X` over `g ⁻¹ᵁ ⊤` is a unique `B`-multiple of the pullback of `1`. -/
private theorem bijective_smul_pullbackSections_one {B : Type u} [CommRing B] {Y : Scheme.{u}}
    (h : Y ⟶ Spec (.of B)) (g : Y ⟶ X)
    (hb : Function.Bijective (Stacks.Cech.globalRingHom h).hom) :
    letI := Stacks.Cech.sectionsModule h
      ((Scheme.Modules.pullback g).obj (SheafOfModules.unit X.ringCatSheaf)) (g ⁻¹ᵁ ⊤)
    Function.Bijective fun c : B => c • Stacks.Cech.pullbackSections g
      (SheafOfModules.unit X.ringCatSheaf) ⊤
        (show Γ(SheafOfModules.unit X.ringCatSheaf, ⊤) from (1 : Γ(X, ⊤))) := by
  set O : X.Modules := SheafOfModules.unit X.ringCatSheaf
  set Og : Y.Modules := (Scheme.Modules.pullback g).obj O
  let := Stacks.Cech.sectionsModule h Og (g ⁻¹ᵁ ⊤)
  set pbs1 := Stacks.Cech.pullbackSections g O ⊤ (show Γ(O, ⊤) from (1 : Γ(X, ⊤)))
  set eF := (Scheme.Modules.pullbackUnitIso g).hom.app (g ⁻¹ᵁ ⊤)
  set eF' : Γ(Og, g ⁻¹ᵁ ⊤) → Γ(Y, g ⁻¹ᵁ ⊤) := fun z => eF z
  have heF1 : eF' pbs1 = (1 : Γ(Y, (g ⁻¹ᵁ ⊤))) :=
    (AlgebraicGeometry.SectionsEqualizer.moduleHom_app_preimage_top g _ pbs1).trans
      (pullbackUnitIso_pullbackSections_one g)
  have hE : ∀ c : B, eF' (c • pbs1) = (Stacks.Cech.baseRingHom h (g ⁻¹ᵁ ⊤)).hom c := fun c =>
    (Scheme.Modules.Hom.app_smul (Scheme.Modules.pullbackUnitIso g).hom
      ((Stacks.Cech.baseRingHom h (g ⁻¹ᵁ ⊤)).hom c) pbs1).trans
      ((congrArg (fun z => (Stacks.Cech.baseRingHom h (g ⁻¹ᵁ ⊤)).hom c * z) heF1).trans
        (mul_one _))
  have hinv : ∀ z, ((Scheme.Modules.pullbackUnitIso g).inv.app (g ⁻¹ᵁ ⊤)) (eF z) = z := fun z =>
    (ConcreteCategory.congr_hom (congrArg (fun t => Scheme.Modules.Hom.app t (g ⁻¹ᵁ ⊤))
      (Iso.hom_inv_id (Scheme.Modules.pullbackUnitIso g))) z).trans (CategoryTheory.id_apply z)
  have hbij := bijective_baseRingHom_of_eq_top h g.preimage_top hb
  refine ⟨fun c c' hcc' => hbij.1 ((hE c).symm.trans ((congrArg eF' hcc').trans (hE c'))),
    fun s => ?_⟩
  obtain ⟨c, hc⟩ := hbij.2 (eF' s)
  exact ⟨c, (hinv _).symm.trans ((congrArg ((Scheme.Modules.pullbackUnitIso g).inv.app
    (g ⁻¹ᵁ ⊤)) ((hE c).trans hc)).trans (hinv s))⟩

section Fibre

variable [IsSeparated f] [(SheafOfModules.unit X.ringCatSheaf).IsQuasicoherent]
  {I : Type u} [Finite I] (U : I → X.Opens) (hU : (⊤ : X.Opens) = ⨆ i, U i)
  (hUaff : ∀ i, IsAffineOpen (U i)) (p : Ideal A) [p.IsPrime] {Xp : Scheme.{u}}
  {fp : Xp ⟶ Spec (.of p.ResidueField)} {gp : Xp ⟶ X}
  (hsq : IsPullback gp fp f (Spec.map (CommRingCat.ofHom (algebraMap A p.ResidueField))))

/-- On the fibre at `p`, the unit model map sends `c ⊗ 1` to `c` times the Čech cochain of the
pullback of `1`. -/
private theorem fibreTransport_extendScalarsCxMap_unitModelMap_f_zero (c : p.ResidueField) :
    letI := Stacks.Cech.sectionsModule fp
      ((Scheme.Modules.pullback gp).obj (SheafOfModules.unit X.ringCatSheaf)) (gp ⁻¹ᵁ ⊤)
    (fibreTransport (algebraMap A p.ResidueField) hsq (SheafOfModules.unit X.ringCatSheaf) U hU
        hUaff 0).hom
      ((StacksDraft.Perfect.extendScalarsCxMap (unitModelMap f U hU hU.le)
        (algebraMap A p.ResidueField)).f 0
          (c ⊗ₜ[A, algebraMap A p.ResidueField]
            (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (ModuleCat.of A A)).inv
              (1 : A))) =
      c • Stacks.Cech.sectionsToAlternatingₗ fp (fun i => gp ⁻¹ᵁ U i)
        ((Scheme.Modules.pullback gp).obj (SheafOfModules.unit X.ringCatSheaf))
        (Stacks.Cech.preimage_le_of_le U (fun _ => le_top) gp (fun i => gp ⁻¹ᵁ U i)
          (Equiv.refl I) (preimage_eq_preimage_equivRefl gp U))
        (Stacks.Cech.pullbackSections gp (SheafOfModules.unit X.ringCatSheaf) ⊤
          (show Γ(SheafOfModules.unit X.ringCatSheaf, ⊤) from (1 : Γ(X, ⊤)))) := by
  set O : X.Modules := SheafOfModules.unit X.ringCatSheaf
  set u := unitModelMap f U hU hU.le
  set e := HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (ModuleCat.of A A)
  set ψ := algebraMap A p.ResidueField
  set one : Γ(O, ⊤) := (show Γ(O, ⊤) from (1 : Γ(X, ⊤)))
  have h1 : (StacksDraft.Perfect.extendScalarsCxMap u ψ).f 0 (c ⊗ₜ[A, ψ] e.inv (1 : A)) =
      c • (show (ModuleCat.extendScalars.{u, u, u} ψ).obj
        ((baseAlternatingCechComplex f U hU O).X 0) from
          (1 : p.ResidueField) ⊗ₜ[A, ψ] unitCochain f U hU (1 : A)) := by
    change ((ModuleCat.extendScalars.{u, u, u} ψ).map (u.f 0)).hom _ = _
    rw [ModuleCat.ExtendScalars.map_tmul, unitModelMap_f_zero_apply]
    refine Eq.trans ?_ (ModuleCat.ExtendScalars.smul_tmul ψ c 1 _).symm
    rw [mul_one]
  rw [h1, map_smul]
  congr 1
  let : Algebra A p.ResidueField := ψ.toAlgebra
  have h2 := fibreTransport_one_tmul ψ hsq O U hU hUaff 0 (unitCochain f U hU (1 : A))
  let := Stacks.Cech.sectionsModule f O ⊤
  have h3 : (baseAlternatingCechComplexXIso f U hU O 0).hom (unitCochain f U hU (1 : A)) =
      Stacks.Cech.sectionsToAlternatingₗ f U O (fun _ => le_top) one := by
    refine (Iso.inv_hom_id_apply (baseAlternatingCechComplexXIso f U hU O 0) _).trans ?_
    exact congrArg (Stacks.Cech.sectionsToAlternatingₗ f U O (fun _ => le_top))
      (one_smul A one)
  refine h2.trans ((congrArg _ h3).trans ?_)
  exact Stacks.Cech.alternatingCochainBaseChangeₗ_sectionsToAlternatingₗ f U O
    (fun _ => le_top) gp (fun i => gp ⁻¹ᵁ U i) (Equiv.refl I)
    (preimage_eq_preimage_equivRefl gp U) ψ fp
    (fun W => Stacks.Cech.baseRingHom_comp_app ψ f fp gp hsq W) one

include hsq hUaff in
/-- If `κ(p) ⟶ Γ(X_p, 𝒪)` is bijective, the base change of the unit model map to `κ(p)` is
injective in degree zero. -/
private theorem eq_zero_of_extendScalarsCxMap_unitModelMap_f_zero_eq_zero
    (hfib : Function.Bijective (Stacks.Cech.globalRingHom fp).hom)
    (x : (StacksDraft.Perfect.extendScalarsCx (algebraMap A p.ResidueField)
      (baseUnitComplex A)).X 0)
    (hx : (StacksDraft.Perfect.extendScalarsCxMap (unitModelMap f U hU hU.le)
      (algebraMap A p.ResidueField)).f 0 x = 0) : x = 0 := by
  obtain ⟨c, rfl⟩ := exists_eq_tmul_of_generator (algebraMap A p.ResidueField)
    ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (ModuleCat.of A A)).inv (1 : A))
    baseUnitComplex_gen x
  let := Stacks.Cech.sectionsModule fp
    ((Scheme.Modules.pullback gp).obj (SheafOfModules.unit X.ringCatSheaf)) (gp ⁻¹ᵁ ⊤)
  have h := fibreTransport_extendScalarsCxMap_unitModelMap_f_zero f U hU hUaff p hsq c
  rw [show (StacksDraft.Perfect.extendScalarsCxMap (unitModelMap f U hU hU.le)
      (algebraMap A p.ResidueField)).f 0 (c ⊗ₜ[A, algebraMap A p.ResidueField]
        (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (ModuleCat.of A A)).inv
          (1 : A)) = 0 from hx, map_zero, ← map_smul] at h
  obtain rfl : c = 0 := (bijective_smul_pullbackSections_one fp gp hfib).1
    ((Stacks.Cech.sectionsToAlternatingₗ_injective fp (fun i => gp ⁻¹ᵁ U i)
      ((Scheme.Modules.pullback gp).obj (SheafOfModules.unit X.ringCatSheaf)) _
      (le_top.trans (top_eq_iSup_preimage gp U hU).le)
      (h.symm.trans (map_zero _).symm)).trans (zero_smul _ _).symm)
  exact TensorProduct.zero_tmul (M := (ModuleCat.restrictScalars.{u}
    (algebraMap A p.ResidueField)).obj (ModuleCat.of p.ResidueField p.ResidueField)) _

include hsq hUaff in
/-- If `κ(p) ⟶ Γ(X_p, 𝒪)` is bijective, every degree-zero cocycle of the fibre of the Čech
model comes from the fibre of `A`. -/
private theorem exists_extendScalarsCxMap_unitModelMap_f_zero_eq
    (hfib : Function.Bijective (Stacks.Cech.globalRingHom fp).hom) :
    ∀ y : (StacksDraft.Perfect.extendScalarsCx (algebraMap A p.ResidueField)
      (baseAlternatingCechComplex f U hU (SheafOfModules.unit X.ringCatSheaf))).X 0,
    (StacksDraft.Perfect.extendScalarsCx (algebraMap A p.ResidueField)
      (baseAlternatingCechComplex f U hU (SheafOfModules.unit X.ringCatSheaf))).d 0 1 y = 0 →
    ∃ x : (StacksDraft.Perfect.extendScalarsCx (algebraMap A p.ResidueField)
        (baseUnitComplex A)).X 0,
      (StacksDraft.Perfect.extendScalarsCx (algebraMap A p.ResidueField)
        (baseUnitComplex A)).d 0 1 x = 0 ∧
      (StacksDraft.Perfect.extendScalarsCxMap (unitModelMap f U hU hU.le)
        (algebraMap A p.ResidueField)).f 0 x = y := by
  set O : X.Modules := SheafOfModules.unit X.ringCatSheaf
  set D := baseAlternatingCechComplex f U hU O
  set u := unitModelMap f U hU hU.le
  set e := HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (ModuleCat.of A A)
  set ψ := algebraMap A p.ResidueField
  set one : Γ(O, ⊤) := (show Γ(O, ⊤) from (1 : Γ(X, ⊤)))
  set Up : I → Xp.Opens := fun i => gp ⁻¹ᵁ U i
  set Op : Xp.Modules := (Scheme.Modules.pullback gp).obj O
  set τ := fibreTransport ψ hsq O U hU hUaff
  let := Stacks.Cech.sectionsModule fp Op (gp ⁻¹ᵁ ⊤)
  set hUp := Stacks.Cech.preimage_le_of_le U (fun _ => le_top) gp Up (Equiv.refl I)
    (preimage_eq_preimage_equivRefl gp U)
  set ι' := Stacks.Cech.sectionsToAlternatingₗ fp Up Op hUp
  set pbs1 := Stacks.Cech.pullbackSections gp O ⊤ one
  have hτu : ∀ c : p.ResidueField, (τ 0).hom ((StacksDraft.Perfect.extendScalarsCxMap u ψ).f 0
      (c ⊗ₜ[A, ψ] e.inv (1 : A))) = c • ι' pbs1 :=
    fibreTransport_extendScalarsCxMap_unitModelMap_f_zero f U hU hUaff p hsq
  intro y hy
  have hd0 : Stacks.Cech.alternatingCechModuleD fp Up Op 0 ((τ 0).hom y) = 0 := by
    refine (fibreTransport_d_apply ψ hsq O U hU hUaff 0 y).symm.trans ?_
    change (τ (0 + 1)).hom ((StacksDraft.Perfect.extendScalarsCx ψ D).d 0 1 y) = 0
    rw [hy, map_zero]
  obtain ⟨s', hs'⟩ : (τ 0).hom y ∈ LinearMap.range ι' :=
    Stacks.Cech.range_sectionsToAlternatingₗ fp Up Op hUp
      (le_top.trans (top_eq_iSup_preimage gp U hU).le) ▸ hd0
  obtain ⟨c, rfl⟩ : ∃ c : p.ResidueField, c • pbs1 = s' :=
    (bijective_smul_pullbackSections_one fp gp hfib).2 s'
  refine ⟨c ⊗ₜ[A, ψ] e.inv (1 : A), extendScalarsCx_baseUnitComplex_X_one_eq_zero ψ _,
    (ConcreteCategory.bijective_of_isIso (τ 0).hom).1 ?_⟩
  rw [hτu c, ← hs', map_smul]

end Fibre

/-- **The unit of a proper flat family is bijective near a point where it is so on the fibre.**
Let `f : X ⟶ Spec A` be proper, flat and locally of finite presentation, and let `p` be a prime of
`A` such that, on the fibre `X_p` (any base change of `f` along `Spec κ(p) ⟶ Spec A`), the ring map
`κ(p) ⟶ Γ(X_p, 𝒪_{X_p})` is bijective. Then there is `a ∉ p` such that the kernel of
`A ⟶ Γ(X, 𝒪_X)` is killed by a power of `a`, and every global function becomes, after
multiplication by a power of `a`, a function coming from `A`. -/
theorem exists_away_unit_bijective [IsProper f] [Flat f] [LocallyOfFinitePresentation f]
    (p : Ideal A) [p.IsPrime] {Xp : Scheme.{u}} {fp : Xp ⟶ Spec (.of p.ResidueField)}
    {gp : Xp ⟶ X}
    (hsq : IsPullback gp fp f (Spec.map (CommRingCat.ofHom (algebraMap A p.ResidueField))))
    (hfib : Function.Bijective (Stacks.Cech.globalRingHom fp).hom) :
    ∃ a : A, a ∉ p ∧
      (∀ r : A, (Stacks.Cech.globalRingHom f).hom r = 0 → ∃ n : ℕ, a ^ n * r = 0) ∧
      (∀ s : Γ(X, ⊤), ∃ (r : A) (n : ℕ),
        (Stacks.Cech.globalRingHom f).hom r = (Stacks.Cech.globalRingHom f).hom (a ^ n) * s) := by
  classical
  obtain ⟨I, hI, hlin, U, hU, hUaff, haff⟩ := exists_finiteAffineCover_of_isProper f
  have : (SheafOfModules.unit X.ringCatSheaf).IsFinitePresentation :=
    Stacks.AlgebraicGeometry.ModuleLimits.isFinitePresentation_unit X
  have : (SheafOfModules.unit X.ringCatSheaf).IsQuasicoherent :=
    isQuasicoherent_of_isFinitePresentation _
  have hflat : IsFlatOver f.toLRSHom.toShHom (SheafOfModules.unit X.ringCatSheaf) := fun x =>
    (AlgebraicGeometry.MorphismOfGerms.flat_stalkMap_iff_isFlatOverAt_unit f x).1
      (Flat.stalkMap f x)
  set D := baseAlternatingCechComplex f U hU (SheafOfModules.unit X.ringCatSheaf)
  have hDperf : StacksDraft.Perfect.IsPerfect (DerivedCategory.Q.obj D) :=
    StacksDraft.Perfect.isPerfect_of_iso (alternatingCechIsoDerivedGlobalSectionsOverBase f U hU
        (SheafOfModules.unit X.ringCatSheaf) haff)
      (isPerfect_derivedGlobalSectionsOverBase_of_isProper f _ hflat)
  have hDflat : ∀ i, Module.Flat A (D.X i) :=
    flat_baseAlternatingCechComplex_X f U hU _ hUaff hflat
  have : (baseUnitComplex A).IsStrictlyLE (Fintype.card I : ℤ) :=
    CochainComplex.isStrictlyLE_of_le _ 0 _ (by omega)
  have : D.IsStrictlyGE 0 := isStrictlyGE_baseAlternatingCechComplex f U hU _
  have : D.IsStrictlyLE (Fintype.card I : ℤ) := isStrictlyLE_baseAlternatingCechComplex f U hU _
  set e := HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (ModuleCat.of A A)
  obtain ⟨a, ha, hker, hsurj⟩ := StacksDraft.Perfect.exists_away_of_fibre_elementwise
    (unitModelMap f U hU hU.le) (Fintype.card I : ℤ) (isPerfect_baseUnitComplex A) hDperf p
    (fun x _ hx => eq_zero_of_extendScalarsCxMap_unitModelMap_f_zero_eq_zero f U hU hUaff p hsq
      hfib x hx)
    (exists_extendScalarsCxMap_unitModelMap_f_zero_eq f U hU hUaff p hsq hfib)
    (fun x _ y _ => ⟨0, by rw [map_zero, extendScalarsCx_baseUnitComplex_X_one_eq_zero _ x]⟩)
  refine ⟨a, ha, fun r hr => ?_, fun s => ?_⟩
  · obtain ⟨n, hn⟩ := hker (e.inv r)
      (@Subsingleton.elim _ ((ModuleCat.isZero_iff_subsingleton).1
        (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 _ 1 (by decide))) _ 0)
      (unitModelMap_f_zero_eq_zero_of_globalRingHom_eq_zero f U hU hU.le hr)
    refine ⟨n, ?_⟩
    have h := congrArg e.hom.hom hn
    rwa [← map_smul, Iso.inv_hom_id_apply, map_zero, smul_eq_mul] at h
  · obtain ⟨x, -, n, hx⟩ := hsurj _ (baseAlternatingCechComplex_d_sectionsToAlternatingₗ f U hU s)
    obtain ⟨r, rfl⟩ := baseUnitComplex_gen x
    refine ⟨r, n, globalRingHom_eq_mul_of_unitModelMap_f_zero_eq_smul f U hU hU.le
      ((congrArg (fun z => (unitModelMap f U hU hU.le).f 0 z) ?_).trans hx)⟩
    rw [← map_smul, smul_eq_mul, mul_one]

/-- An ideal is the unit ideal if at every maximal ideal `m` it contains a power of some `a ∉ m`. -/
private theorem eq_top_of_forall_isMaximal_exists_pow_mem (I : Ideal A)
    (h : ∀ m : Ideal A, m.IsMaximal → ∃ a ∉ m, ∃ n : ℕ, a ^ n ∈ I) : I = ⊤ := by
  by_contra hne
  obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal I hne
  obtain ⟨a, ha, n, hn⟩ := h m hm
  exact ha (hm.isPrime.mem_of_pow_mem n (hle hn))

/-- A ring map is injective if, at every maximal ideal `m`, its kernel is killed by powers of
some `a ∉ m`. -/
private theorem injective_of_forall_isMaximal_exists_pow_mul_eq_zero {B : Type*} [CommRing B]
    (φ : A →+* B)
    (h : ∀ m : Ideal A, m.IsMaximal → ∃ a ∉ m, ∀ r, φ r = 0 → ∃ n : ℕ, a ^ n * r = 0) :
    Function.Injective φ := by
  refine (injective_iff_map_eq_zero φ).2 fun t ht => ?_
  have h1 : (1 : A) ∈ Submodule.annihilator (R := A) (M := A) (Submodule.span A {t}) :=
    (eq_top_of_forall_isMaximal_exists_pow_mem _ fun m hm => by
      obtain ⟨a, ha, hker⟩ := h m hm
      obtain ⟨n, hn⟩ := hker t ht
      exact ⟨a, ha, n, (Submodule.mem_annihilator_span_singleton _ _).2 (by rwa [smul_eq_mul])⟩)
      ▸ Submodule.mem_top
  simpa using (Submodule.mem_annihilator_span_singleton _ _).1 h1

/-- A ring map `φ : A →+* B` is surjective if, at every maximal ideal `m`, there is `a ∉ m` such
that every element of `B` times a power of `φ a` lies in the image of `φ`. -/
private theorem surjective_of_forall_isMaximal_exists_pow_mul {B : Type*} [CommRing B] (φ : A →+* B)
    (h : ∀ m : Ideal A, m.IsMaximal → ∃ a ∉ m, ∀ s, ∃ (r : A) (n : ℕ), φ r = φ (a ^ n) * s) :
    Function.Surjective φ := by
  intro s
  let J : Ideal A :=
    { carrier := {b | ∃ r : A, φ r = φ b * s}
      add_mem' := by
        rintro b b' ⟨r, hr⟩ ⟨r', hr'⟩
        exact ⟨r + r', by rw [map_add, map_add, hr, hr', add_mul]⟩
      zero_mem' := ⟨0, by rw [map_zero, zero_mul]⟩
      smul_mem' := by
        rintro c b ⟨r, hr⟩
        exact ⟨c * r, by rw [smul_eq_mul, map_mul, map_mul, hr, mul_assoc]⟩ }
  have hJ : J = ⊤ := eq_top_of_forall_isMaximal_exists_pow_mem J fun m hm => by
    obtain ⟨a, ha, hsurj⟩ := h m hm
    obtain ⟨r, n, hr⟩ := hsurj s
    exact ⟨a, ha, n, r, hr⟩
  obtain ⟨r, hr⟩ : (1 : A) ∈ J := hJ ▸ Submodule.mem_top
  exact ⟨r, by rw [hr, map_one, one_mul]⟩

/-- **The unit of a proper flat family with geometrically integral fibres over an affine base is
bijective.** For `f : X ⟶ Spec A` proper, flat, locally of finite presentation and geometrically
integral, the ring map `A ⟶ Γ(X, 𝒪_X)` is bijective: at every prime the fibre has only constant
functions ([Stacks, Tag 0BUG] (8)), so by `exists_away_unit_bijective` its kernel and cokernel
vanish after localizing at every prime. -/
theorem bijective_globalRingHom_of_geometricallyIntegral [IsProper f] [Flat f]
    [LocallyOfFinitePresentation f] [GeometricallyIntegral f] :
    Function.Bijective (Stacks.Cech.globalRingHom f).hom := by
  classical
  have hloc (p : Ideal A) [p.IsPrime] := by
    let φ := Spec.map (CommRingCat.ofHom (algebraMap A p.ResidueField))
    exact exists_away_unit_bijective f p (IsPullback.of_hasPullback f φ)
      ((ConcreteCategory.isIso_iff_bijective _).mp
        (isIso_globalSections_of_geometricallyIntegral p.ResidueField (pullback.snd f φ)))
  exact ⟨injective_of_forall_isMaximal_exists_pow_mul_eq_zero _ fun m _ =>
      (hloc m).imp fun _ h => ⟨h.1, h.2.1⟩,
    surjective_of_forall_isMaximal_exists_pow_mul _ fun m _ =>
      (hloc m).imp fun _ h => ⟨h.1, h.2.2⟩⟩

end Main

