/-!
# The Grothendieck ring of vector bundles on a scheme

Let `X` be a scheme and write `Vect(X)` for the finite locally free `𝒪_X`-modules. The
Grothendieck group `K₀(Vect(X))` is the abelian group generated by a class `[ℰ]` for each
finite locally free module, subject to the relations `[ℰ] = [ℰ'] + [ℰ'']` coming from short
exact sequences `0 → ℰ' → ℰ → ℰ'' → 0` of finite locally free modules, and by no others.
Tensor product makes it a commutative ring with unit `[𝒪_X]`.

## Main definitions

* `AlgebraicGeometry.VectorBundleKZero`: the group `K₀(Vect(X))`.
* `AlgebraicGeometry.VectorBundleKZero.classOf`: the class of a sheaf of modules.

## Main results

* `AlgebraicGeometry.VectorBundleKZero.classOf_shortExact`: the defining relation.
* `AlgebraicGeometry.VectorBundleKZero.addHom_ext`: an additive map out of `K₀(Vect(X))` is
  determined by its values on finite locally free modules.
* `AlgebraicGeometry.VectorBundleKZero.liftAddHom`: an additive map out of `K₀(Vect(X))` from a
  function on sheaves of modules vanishing off the finite locally free ones and additive on
  their short exact sequences.
* `AlgebraicGeometry.VectorBundleKZero.instCommRing`: the commutative ring structure, whose
  multiplication is tensor product (`classOf_mul`) and whose unit is the class of the
  structure sheaf (`classOf_unit`).
* `AlgebraicGeometry.VectorBundleKZero.exists_tensorProduct_commRing`: the three properties of
  that ring structure, asserted together.

## Implementation notes

`Vect(X)` is not an abelian category, so `K₀(Vect(X))` is not an instance of
`CategoryTheory.GrothendieckGroup`, which quotients the free abelian group on an abelian
category by its short exact sequences. Instead the free abelian group is taken on *all* of
`X.Modules` and the relations kill every generator that is not finite locally free, so that
`classOf` is defined on every sheaf of modules and vanishes off `Vect(X)`. The short exact
sequences imposed are short exact in `Mod(𝒪_X)` between finite locally free modules, which is
what the source means by a short exact sequence of `Vect(X)`.

The tensor product used is the sheafification of the sectionwise tensor product,
`Stacks.SheafOfModules.TensorStalkRingedSpace.tensorSheaf`. Its associativity, commutativity
and unit come from the symmetric monoidal structure
`SheafOfModules.monoidalCategorySheafTensor`, whose tensor product is this one and whose unit
is `SheafOfModules.unit`; no local trivialisations are needed.

That a tensor product of finite locally free modules is again finite locally free is deduced
from the equivalence of "finite locally free" with "flat and of finite presentation"
(`AlgebraicGeometry.Scheme.Modules.flat_finitePresentation_locallyFree_fiberRank_tfae`),
both of which are stable under tensor product.

## References

* [Stacks Project, Tag 0FDK](https://stacks.math.columbia.edu/tag/0FDK)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits MonoidalCategory
open scoped ZeroObject
open Stacks.FiniteLocallyFree Stacks.SheafOfModules.TensorStalkRingedSpace

universe u

namespace AlgebraicGeometry

variable (X : Scheme.{u})

/-- The tensor product `ℰ ⊗_{𝒪_X} ℱ` of two sheaves of modules on a scheme, namely the
sheafification of the sectionwise tensor product, formed through the underlying ringed space of
`X`. The same object formed directly over `X.ringCatSheaf` is
`AlgebraicGeometry.Scheme.Modules.tensorObj` in
`StacksFrontier.AlgebraicGeometry.Modules.TensorStalkGenerators`. -/
@[sga "4 IV 12.7" "special case"]
noncomputable abbrev Scheme.Modules.tensorObjRingedSpace (M N : X.Modules) : X.Modules :=
  (((Stacks.SheafOfModules.Tensor.sheafTensor
    ⟨((X.toRingedSpace)).presheaf, ((X.toRingedSpace)).IsSheaf⟩).obj (M)).obj (N))

/-- The generators of the relations defining `K₀(Vect(X))`: every sheaf of modules that is not
finite locally free, and `[ℱ] - [ℰ] - [𝒢]` for every short exact sequence
`0 → ℰ → ℱ → 𝒢 → 0` of finite locally free modules. -/
def vectorBundleRelations : Set (FreeAbelianGroup X.Modules) :=
  {p |
    (∃ M : X.Modules,
      ¬ IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M ∧ p = FreeAbelianGroup.of M) ∨
    (∃ (E F G : X.Modules) (f : E ⟶ F) (g : F ⟶ G) (w : f ≫ g = 0),
      IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) E ∧
        IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) F ∧
        IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) G ∧
        Mono f ∧ Epi g ∧ (ShortComplex.mk f g w).Exact ∧
          p = FreeAbelianGroup.of F - FreeAbelianGroup.of E - FreeAbelianGroup.of G)}

/-- The subgroup of relations defining `K₀(Vect(X))`. -/
def vectorBundleRelationsSubgroup : AddSubgroup (FreeAbelianGroup X.Modules) :=
  AddSubgroup.closure (vectorBundleRelations X)

/-- **Stacks Project, Tag 0FDK.** The Grothendieck group `K₀(Vect(X))` of finite locally free
modules on a scheme `X`: the free abelian group on sheaves of modules, modulo the classes of
the modules that are not finite locally free and the relations from short exact sequences of
finite locally free modules. It is a commutative ring under tensor product. -/
@[sga "6 0 3.1" "(X)",
  sga "6 0 4.1" "partial",
  sga "6 IV 2.2" "special case",
  sga "6 V 2.2" "schemes, special case",
  sga "6 V 3.9.1" "(X), special case",
  sga "6 VIII 2.5",
  sga "6 X 1.2"]
abbrev VectorBundleKZero : Type (u + 1) :=
  FreeAbelianGroup X.Modules ⧸ vectorBundleRelationsSubgroup X

namespace VectorBundleKZero

/-- The class `[ℰ]` of a sheaf of modules in `K₀(Vect(X))`. It is zero unless `ℰ` is finite
locally free. -/
def classOf (M : X.Modules) : VectorBundleKZero X :=
  QuotientAddGroup.mk' (vectorBundleRelationsSubgroup X) (FreeAbelianGroup.of M)

variable {X}

/-- A defining relation of `K₀(Vect(X))` maps to zero in the quotient. -/
private theorem mk_eq_zero_of_mem_vectorBundleRelations {p : FreeAbelianGroup X.Modules}
    (hp : p ∈ vectorBundleRelations X) :
    QuotientAddGroup.mk' (vectorBundleRelationsSubgroup X) p = 0 :=
  (QuotientAddGroup.eq_zero_iff _).2 (AddSubgroup.subset_closure hp)

/-- A sheaf of modules that is not finite locally free has class zero in `K₀(Vect(X))`. -/
theorem classOf_eq_zero_of_not_isFiniteLocallyFree (M : X.Modules)
    (hM : ¬ IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M) : classOf X M = 0 :=
  mk_eq_zero_of_mem_vectorBundleRelations (Or.inl ⟨M, hM, rfl⟩)

/-- **Stacks Project, Tag 0FDK.** The defining relation of `K₀(Vect(X))`: a short exact
sequence `0 → ℰ → ℱ → 𝒢 → 0` of finite locally free modules gives `[ℱ] = [ℰ] + [𝒢]`. -/
theorem classOf_shortExact {E F G : X.Modules} (f : E ⟶ F) (g : F ⟶ G) [Mono f] [Epi g]
    (w : f ≫ g = 0) (hE : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) E)
    (hF : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) F)
    (hG : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) G)
    (h : (ShortComplex.mk f g w).Exact) :
    classOf X F = classOf X E + classOf X G := by
  have := mk_eq_zero_of_mem_vectorBundleRelations
    (Or.inr ⟨E, F, G, f, g, w, hE, hF, hG, inferInstance, inferInstance, h, rfl⟩)
  rwa [map_sub, map_sub, sub_sub, sub_eq_zero] at this

/-- A free module on the empty index type is a zero object. -/
theorem isZero_free_pempty (X : Scheme.{u}) :
    IsZero (SheafOfModules.free (R := X.ringCatSheaf) PEmpty.{u + 1}) := by
  refine (IsZero.iff_id_eq_zero _).2 ?_
  refine (SheafOfModules.free (R := X.ringCatSheaf) PEmpty.{u + 1}).freeHomEquiv.injective ?_
  funext i
  exact PEmpty.elim i

/-- The zero module is finite locally free. -/
instance isFiniteLocallyFree_zero (X : Scheme.{u}) :
    IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) (0 : X.Modules) :=
  IsFiniteLocallyFree.of_iso (R := X.ringCatSheaf)
    (M := SheafOfModules.free (R := X.ringCatSheaf) PEmpty.{u + 1})
    (isZero_free_pempty X).isoZero

/-- The class of the zero module is zero. -/
@[simp] theorem classOf_zero (X : Scheme.{u}) : classOf X (0 : X.Modules) = 0 := by
  have : Mono (0 : (0 : X.Modules) ⟶ (0 : X.Modules)) :=
    ⟨fun _ _ _ => (isZero_zero X.Modules).eq_of_tgt _ _⟩
  have : Epi (0 : (0 : X.Modules) ⟶ (0 : X.Modules)) :=
    ⟨fun _ _ _ => (isZero_zero X.Modules).eq_of_src _ _⟩
  have h := classOf_shortExact (0 : (0 : X.Modules) ⟶ (0 : X.Modules)) 0 (by simp)
    (isFiniteLocallyFree_zero X) (isFiniteLocallyFree_zero X) (isFiniteLocallyFree_zero X)
    (ShortComplex.exact_of_isZero_X₂ _ (isZero_zero _))
  simpa using h

/-- Isomorphic finite locally free modules have the same class. -/
theorem classOf_eq_of_iso {M N : X.Modules} (e : M ≅ N)
    (hM : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M) : classOf X M = classOf X N := by
  have hN : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) N :=
    @IsFiniteLocallyFree.of_iso.{u, u, u} _ _ _ _ _ _ _ _ e hM
  have hex : (ShortComplex.mk e.hom (0 : N ⟶ (0 : X.Modules)) (by simp)).Exact :=
    (ShortComplex.exact_iff_epi _ rfl).2 inferInstance
  have h := classOf_shortExact e.hom (0 : N ⟶ (0 : X.Modules)) (by simp) hM hN
    (isFiniteLocallyFree_zero X) hex
  rw [classOf_zero] at h
  exact h.symm

/-- An additive map out of `K₀(Vect(X))` is determined by its values on the classes of finite
locally free modules. -/
@[ext] theorem addHom_ext {A : Type*} [AddCommGroup A] {φ ψ : VectorBundleKZero X →+ A}
    (h : ∀ M : X.Modules, IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M →
      φ (classOf X M) = ψ (classOf X M)) : φ = ψ := by
  refine QuotientAddGroup.addMonoidHom_ext _ (FreeAbelianGroup.lift_ext _ _ fun M => ?_)
  by_cases hM : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M
  · exact h M hM
  · show φ (classOf X M) = ψ (classOf X M)
    rw [classOf_eq_zero_of_not_isFiniteLocallyFree M hM, map_zero, map_zero]

/-- **An additive map out of `K₀(Vect(X))` from a function on sheaves of modules.** A function
which vanishes off the finite locally free modules and is additive on short exact sequences of
finite locally free modules descends to the Grothendieck group, by the very definition of the
relations imposed. Together with `AlgebraicGeometry.VectorBundleKZero.addHom_ext`, which says
that such a map is determined by its values on the finite locally free modules, this is the
universal property of `K₀(Vect(X))`. -/
def liftAddHom {A : Type*} [AddCommGroup A] (c : X.Modules → A)
    (hzero : ∀ M : X.Modules,
      ¬ IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M → c M = 0)
    (hadd : ∀ {E F G : X.Modules} (f : E ⟶ F) (g : F ⟶ G) (w : f ≫ g = 0),
      IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) E →
        IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) F →
          IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) G →
            Mono f → Epi g → (ShortComplex.mk f g w).Exact → c F = c E + c G) :
    VectorBundleKZero X →+ A := by
  refine QuotientAddGroup.lift _ (FreeAbelianGroup.lift c) ((AddSubgroup.closure_le _).2 ?_)
  rintro p (⟨M, hM, rfl⟩ | ⟨E, F, G, f, g, w, hE, hF, hG, hmono, hepi, hexact, rfl⟩)
  · exact AddMonoidHom.mem_ker.2 ((FreeAbelianGroup.lift_apply_of c M).trans (hzero M hM))
  · refine AddMonoidHom.mem_ker.2 ?_
    rw [map_sub, map_sub, FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of,
      FreeAbelianGroup.lift_apply_of, hadd f g w hE hF hG hmono hepi hexact]
    abel

/-- The value of `AlgebraicGeometry.VectorBundleKZero.liftAddHom` on the class of a sheaf of
modules is the value of the given function. -/
@[simp] theorem liftAddHom_classOf {A : Type*} [AddCommGroup A] (c : X.Modules → A)
    (hzero : ∀ M : X.Modules,
      ¬ IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M → c M = 0)
    (hadd : ∀ {E F G : X.Modules} (f : E ⟶ F) (g : F ⟶ G) (w : f ≫ g = 0),
      IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) E →
        IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) F →
          IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) G →
            Mono f → Epi g → (ShortComplex.mk f g w).Exact → c F = c E + c G)
    (M : X.Modules) : liftAddHom c hzero hadd (classOf X M) = c M :=
  FreeAbelianGroup.lift_apply_of c M

end VectorBundleKZero

section Tensor

variable {X}

/-- The structure sheaf is finite locally free. -/
instance isFiniteLocallyFree_unit (X : Scheme.{u}) :
    IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf)
      (SheafOfModules.unit X.ringCatSheaf) :=
  @IsFiniteLocallyFree.of_iso.{u, u, u} _ _ _ _ _ _
    (SheafOfModules.free (R := X.ringCatSheaf) PUnit.{u + 1}) _
    (Stacks.SheafOfModules.Site.freePUnitIso (R := X.ringCatSheaf)) inferInstance

/-- **Stacks Project, Tag 0FDK.** A tensor product of finite locally free modules on a scheme
is finite locally free: finite local freeness is flatness together with finite presentation,
and both are stable under tensor product. -/
instance isFiniteLocallyFree_tensorObj (M N : X.Modules)
    [hM : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M]
    [hN : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) N] :
    IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf)
      (Scheme.Modules.tensorObjRingedSpace X M N) := by
  have hflat : AlgebraicGeometry.SheafOfModules.IsFlat
      (C := TopologicalSpace.Opens X.toTopCat) (J := Opens.grothendieckTopology X.toTopCat)
      (O := X.sheaf) (Scheme.Modules.tensorObjRingedSpace X M N) :=
    Stacks.SheafOfModules.FlatTensor.isFlat_tensor M N
      (Scheme.Modules.isFlat_of_isFiniteLocallyFree M)
      (Scheme.Modules.isFlat_of_isFiniteLocallyFree N)
  have hfp : SheafOfModules.IsFinitePresentation.{u, u, u}
      (Scheme.Modules.tensorObjRingedSpace X M N) :=
    @AlgebraicGeometry.SheafOfModules.tensorSheaf_isFinitePresentation X.toRingedSpace M N
      (isFinitePresentation M) (isFinitePresentation N)
  have hslice : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
      (R := X.ringCatSheaf) (Scheme.Modules.tensorObjRingedSpace X M N) :=
    ((Scheme.Modules.flat_finitePresentation_locallyFree_fiberRank_tfae
      (Scheme.Modules.tensorObjRingedSpace X M N)).out 1 4).mp (And.intro hflat hfp)
  exact Stacks.StalkFreeBridge.finiteLocallyFree_isFiniteLocallyFree
    (Scheme.Modules.tensorObjRingedSpace X M N) (hM := hslice)

/-- Commutativity of the tensor product of sheaves of modules on a scheme, from the symmetric
monoidal structure on `Mod(𝒪_X)` whose tensor product it is. -/
noncomputable def Scheme.Modules.tensorObjBraiding (M N : X.Modules) :
    Scheme.Modules.tensorObjRingedSpace X M N ≅ Scheme.Modules.tensorObjRingedSpace X N M :=
  @BraidedCategory.braiding
    (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) _
    (SheafOfModules.monoidalCategorySheafTensor X.sheaf)
    (SheafOfModules.symmetricCategorySheafTensor X.sheaf).toBraidedCategory M N

/-- Associativity of the tensor product of sheaves of modules on a scheme. -/
noncomputable def Scheme.Modules.tensorObjAssociator (M N P : X.Modules) :
    Scheme.Modules.tensorObjRingedSpace X (Scheme.Modules.tensorObjRingedSpace X M N) P ≅
      Scheme.Modules.tensorObjRingedSpace X M (Scheme.Modules.tensorObjRingedSpace X N P) :=
  @MonoidalCategoryStruct.associator
    (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) _
    (SheafOfModules.monoidalCategorySheafTensor X.sheaf).toMonoidalCategoryStruct M N P

/-- The structure sheaf is a left unit for the tensor product of sheaves of modules. -/
noncomputable def Scheme.Modules.tensorObjLeftUnitor (M : X.Modules) :
    Scheme.Modules.tensorObjRingedSpace X (SheafOfModules.unit X.ringCatSheaf) M ≅ M :=
  @MonoidalCategoryStruct.leftUnitor
    (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) _
    (SheafOfModules.monoidalCategorySheafTensor X.sheaf).toMonoidalCategoryStruct M

/-- Tensoring a short exact sequence of sheaves of modules on a scheme by a flat sheaf of
modules gives a short exact sequence. -/
theorem Scheme.Modules.tensorObj_shortExact {E F G : X.Modules} (f : E ⟶ F) (g : F ⟶ G)
    [Mono f] [Epi g] (w : f ≫ g = 0) (h : (ShortComplex.mk f g w).Exact) (N : X.Modules)
    (hN : AlgebraicGeometry.SheafOfModules.IsFlat
      (C := TopologicalSpace.Opens X.toTopCat) (J := Opens.grothendieckTopology X.toTopCat)
      (O := X.sheaf) N) :
    ∃ (f' : Scheme.Modules.tensorObjRingedSpace X E N ⟶ Scheme.Modules.tensorObjRingedSpace X F N)
      (g' : Scheme.Modules.tensorObjRingedSpace X F N ⟶ Scheme.Modules.tensorObjRingedSpace X G N)
      (w' : f' ≫ g' = 0), (ShortComplex.mk f' g' w').ShortExact := by
  have hSEX : (ShortComplex.mk f g w).ShortExact :=
    { exact := h, mono_f := by dsimp; infer_instance, epi_g := by dsimp; infer_instance }
  obtain ⟨w', hSE⟩ := Stacks.SheafOfModules.sheafTensorRight_shortExact_of_flat_factor.{u, u, u, u}
    (ShortComplex.mk f g w) N hSEX hN
  exact ⟨_, _, w', hSE⟩

end Tensor

namespace VectorBundleKZero

open scoped Classical in
/-- The class of the tensor product of two sheaves of modules when both are finite locally
free, and zero otherwise. -/
noncomputable def classOfTensor (X : Scheme.{u}) (M N : X.Modules) : VectorBundleKZero X :=
  if IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M ∧
      IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) N then
    classOf X (Scheme.Modules.tensorObjRingedSpace X M N) else 0

variable {X}

/-- On finite locally free modules, `classOfTensor` is the class of the tensor product. -/
theorem classOfTensor_of_isFiniteLocallyFree (M N : X.Modules)
    (hM : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M)
    (hN : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) N) :
    classOfTensor X M N = classOf X (Scheme.Modules.tensorObjRingedSpace X M N) := by
  simp only [classOfTensor]
  split_ifs with h
  · rfl
  · exact absurd ⟨hM, hN⟩ h

/-- `classOfTensor` vanishes when its first argument is not finite locally free. -/
theorem classOfTensor_eq_zero_left (M N : X.Modules)
    (hM : ¬ IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M) :
    classOfTensor X M N = 0 := by
  simp only [classOfTensor]
  split_ifs with h
  · exact absurd h.1 hM
  · rfl

/-- `classOfTensor` vanishes when its second argument is not finite locally free. -/
theorem classOfTensor_eq_zero_right (M N : X.Modules)
    (hN : ¬ IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) N) :
    classOfTensor X M N = 0 := by
  simp only [classOfTensor]
  split_ifs with h
  · exact absurd h.2 hN
  · rfl

/-- **Stacks Project, Tag 0FDK.** The class of a tensor product is symmetric in its two
arguments, because the tensor product of sheaves of modules is. -/
theorem classOfTensor_comm (M N : X.Modules) : classOfTensor X M N = classOfTensor X N M := by
  by_cases hM : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M
  · by_cases hN : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) N
    · have := hM
      have := hN
      rw [classOfTensor_of_isFiniteLocallyFree M N hM hN,
        classOfTensor_of_isFiniteLocallyFree N M hN hM]
      exact classOf_eq_of_iso (Scheme.Modules.tensorObjBraiding M N) inferInstance
    · rw [classOfTensor_eq_zero_right M N hN, classOfTensor_eq_zero_left N M hN]
  · rw [classOfTensor_eq_zero_left M N hM, classOfTensor_eq_zero_right N M hM]

/-- Additivity of `classOfTensor` in its first argument, along a short exact sequence of
finite locally free modules. -/
theorem classOfTensor_shortExact_left {E F G : X.Modules} (f : E ⟶ F) (g : F ⟶ G) [Mono f]
    [Epi g] (w : f ≫ g = 0) (hE : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) E)
    (hF : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) F)
    (hG : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) G)
    (h : (ShortComplex.mk f g w).Exact) (N : X.Modules) :
    classOfTensor X F N = classOfTensor X E N + classOfTensor X G N := by
  by_cases hN : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) N
  · have := hE
    have := hF
    have := hG
    have := hN
    obtain ⟨f', g', w', hSE⟩ := Scheme.Modules.tensorObj_shortExact f g w h N
      (Scheme.Modules.isFlat_of_isFiniteLocallyFree N)
    have := hSE.mono_f
    have := hSE.epi_g
    rw [classOfTensor_of_isFiniteLocallyFree E N hE hN,
      classOfTensor_of_isFiniteLocallyFree F N hF hN,
      classOfTensor_of_isFiniteLocallyFree G N hG hN]
    exact classOf_shortExact f' g' w' inferInstance inferInstance inferInstance hSE.exact
  · rw [classOfTensor_eq_zero_right E N hN, classOfTensor_eq_zero_right F N hN,
      classOfTensor_eq_zero_right G N hN, add_zero]

/-- Additivity of `classOfTensor` in its second argument. -/
theorem classOfTensor_shortExact_right {E F G : X.Modules} (f : E ⟶ F) (g : F ⟶ G) [Mono f]
    [Epi g] (w : f ≫ g = 0) (hE : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) E)
    (hF : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) F)
    (hG : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) G)
    (h : (ShortComplex.mk f g w).Exact) (M : X.Modules) :
    classOfTensor X M F = classOfTensor X M E + classOfTensor X M G := by
  rw [classOfTensor_comm M F, classOfTensor_comm M E, classOfTensor_comm M G]
  exact classOfTensor_shortExact_left f g w hE hF hG h M

/-- Multiplication by the class of a single sheaf of modules. -/
noncomputable def mulLeft (X : Scheme.{u}) (M : X.Modules) :
    VectorBundleKZero X →+ VectorBundleKZero X :=
  QuotientAddGroup.lift (vectorBundleRelationsSubgroup X)
    (FreeAbelianGroup.lift fun N => classOfTensor X M N) <| by
      refine (AddSubgroup.closure_le _).2 ?_
      rintro p (⟨N, hN, rfl⟩ | ⟨E, F, G, f, g, w, hE, hF, hG, hf, hg, hex, rfl⟩)
      · change (FreeAbelianGroup.lift fun N => classOfTensor X M N) (FreeAbelianGroup.of N) = 0
        rw [FreeAbelianGroup.lift_apply_of]
        exact classOfTensor_eq_zero_right M N hN
      · have := hf
        have := hg
        change (FreeAbelianGroup.lift fun N => classOfTensor X M N)
          (FreeAbelianGroup.of F - FreeAbelianGroup.of E - FreeAbelianGroup.of G) = 0
        simp only [map_sub, FreeAbelianGroup.lift_apply_of]
        rw [classOfTensor_shortExact_right f g w hE hF hG hex M]
        abel

/-- Multiplying the class of `N` by `M` gives the class of `M ⊗ N`. -/
@[simp] theorem mulLeft_classOf (M N : X.Modules) :
    mulLeft X M (classOf X N) = classOfTensor X M N :=
  FreeAbelianGroup.lift_apply_of _ N

/-- The multiplication of `K₀(Vect(X))`, induced by the tensor product. -/
noncomputable def mul (X : Scheme.{u}) :
    VectorBundleKZero X →+ VectorBundleKZero X →+ VectorBundleKZero X :=
  QuotientAddGroup.lift (vectorBundleRelationsSubgroup X)
    (FreeAbelianGroup.lift fun M => mulLeft X M) <| by
      refine (AddSubgroup.closure_le _).2 ?_
      rintro p (⟨M, hM, rfl⟩ | ⟨E, F, G, f, g, w, hE, hF, hG, hf, hg, hex, rfl⟩)
      · change (FreeAbelianGroup.lift fun M => mulLeft X M) (FreeAbelianGroup.of M) = 0
        rw [FreeAbelianGroup.lift_apply_of]
        refine addHom_ext fun N _ => ?_
        rw [mulLeft_classOf, AddMonoidHom.zero_apply,
          classOfTensor_eq_zero_left M N hM]
      · have := hf
        have := hg
        change (FreeAbelianGroup.lift fun M => mulLeft X M)
          (FreeAbelianGroup.of F - FreeAbelianGroup.of E - FreeAbelianGroup.of G) = 0
        simp only [map_sub, FreeAbelianGroup.lift_apply_of]
        refine addHom_ext fun N _ => ?_
        simp only [AddMonoidHom.sub_apply, AddMonoidHom.zero_apply, mulLeft_classOf]
        rw [classOfTensor_shortExact_left f g w hE hF hG hex N]
        abel

/-- The product of two classes of sheaves of modules. -/
@[simp] theorem mul_classOf (M N : X.Modules) :
    mul X (classOf X M) (classOf X N) = classOfTensor X M N := by
  rw [show mul X (classOf X M) = mulLeft X M from FreeAbelianGroup.lift_apply_of _ M,
    mulLeft_classOf]

/-- Multiplication by the class of a module is `mulLeft`. -/
theorem mul_classOf_eq_mulLeft (M : X.Modules) : mul X (classOf X M) = mulLeft X M :=
  FreeAbelianGroup.lift_apply_of _ M

/-- Multiplication by the class of a module that is not finite locally free is zero. -/
theorem mulLeft_eq_zero (M : X.Modules)
    (hM : ¬ IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M) : mulLeft X M = 0 :=
  addHom_ext fun N _ => by
    rw [mulLeft_classOf, AddMonoidHom.zero_apply, classOfTensor_eq_zero_left M N hM]

/-- Right multiplication by an element of `K₀(Vect(X))`. -/
noncomputable def mulRight (b : VectorBundleKZero X) :
    VectorBundleKZero X →+ VectorBundleKZero X :=
  AddMonoidHom.mk' (fun a => mul X a b) fun p q => by rw [map_add]; rfl

/-- Right multiplication is the multiplication with its arguments exchanged. -/
@[simp] theorem mulRight_apply (a b : VectorBundleKZero X) : mulRight b a = mul X a b := rfl

/-- **Stacks Project, Tag 0FDK.** The multiplication of `K₀(Vect(X))` is commutative, because
the tensor product of sheaves of modules is. -/
theorem mul_comm' (a b : VectorBundleKZero X) : mul X a b = mul X b a := by
  have key : ∀ M : X.Modules, mul X (classOf X M) = mulRight (classOf X M) :=
    fun M => addHom_ext fun N _ => by
      rw [mulRight_apply, mul_classOf, mul_classOf, classOfTensor_comm]
  have h : mulRight b = mul X b := addHom_ext fun M _ => by
    rw [mulRight_apply, ← mulRight_apply b (classOf X M), ← key M]
  exact DFunLike.congr_fun h a

/-- Multiplication by the class of a module that is not finite locally free is zero. -/
theorem mul_classOf_eq_zero_left (M : X.Modules)
    (hM : ¬ IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M) (b : VectorBundleKZero X) :
    mul X (classOf X M) b = 0 := by
  rw [mul_classOf_eq_mulLeft, mulLeft_eq_zero M hM, AddMonoidHom.zero_apply]

/-- Multiplication by the class of a module that is not finite locally free is zero. -/
theorem mul_classOf_eq_zero_right (N : X.Modules)
    (hN : ¬ IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) N) (a : VectorBundleKZero X) :
    mul X a (classOf X N) = 0 := by
  rw [mul_comm', mul_classOf_eq_zero_left N hN]

/-- **Stacks Project, Tag 0FDK.** The class of the structure sheaf is a left unit for the
multiplication of `K₀(Vect(X))`. -/
theorem one_mul' (a : VectorBundleKZero X) :
    mul X (classOf X (SheafOfModules.unit X.ringCatSheaf)) a = a := by
  have h : mul X (classOf X (SheafOfModules.unit X.ringCatSheaf)) = AddMonoidHom.id _ :=
    addHom_ext fun N hN => by
      have := hN
      refine (mul_classOf _ N).trans ?_
      rw [classOfTensor_of_isFiniteLocallyFree _ _ (isFiniteLocallyFree_unit X) hN]
      exact classOf_eq_of_iso (Scheme.Modules.tensorObjLeftUnitor N)
        (@isFiniteLocallyFree_tensorObj X (SheafOfModules.unit X.ringCatSheaf) N
          (isFiniteLocallyFree_unit X) hN)
  rw [h, AddMonoidHom.id_apply]

/-- Associativity of the multiplication of `K₀(Vect(X))` on classes of sheaves of modules. -/
theorem mul_assoc_classOf (M N P : X.Modules) :
    mul X (mul X (classOf X M) (classOf X N)) (classOf X P) =
      mul X (classOf X M) (mul X (classOf X N) (classOf X P)) := by
  by_cases hM : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M
  · by_cases hN : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) N
    · by_cases hP : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) P
      · have := hM
        have := hN
        have := hP
        rw [mul_classOf, mul_classOf,
          classOfTensor_of_isFiniteLocallyFree M N hM hN,
          classOfTensor_of_isFiniteLocallyFree N P hN hP, mul_classOf, mul_classOf,
          classOfTensor_of_isFiniteLocallyFree _ P inferInstance hP,
          classOfTensor_of_isFiniteLocallyFree M _ hM inferInstance]
        exact classOf_eq_of_iso (Scheme.Modules.tensorObjAssociator M N P) inferInstance
      · rw [mul_classOf N P, classOfTensor_eq_zero_right N P hP, map_zero,
          mul_classOf_eq_zero_right P hP]
    · rw [mul_classOf, classOfTensor_eq_zero_right M N hN, mul_classOf,
        classOfTensor_eq_zero_left N P hN, map_zero, map_zero, AddMonoidHom.zero_apply]
  · rw [mul_classOf_eq_zero_left M hM, mul_classOf_eq_zero_left M hM, map_zero,
      AddMonoidHom.zero_apply]

/-- **Stacks Project, Tag 0FDK.** The multiplication of `K₀(Vect(X))` is associative. -/
theorem mul_assoc' (a b c : VectorBundleKZero X) :
    mul X (mul X a b) c = mul X a (mul X b c) := by
  have step₀ : ∀ M N : X.Modules, mul X (mul X (classOf X M) (classOf X N)) =
      (mul X (classOf X M)).comp (mul X (classOf X N)) :=
    fun M N => addHom_ext fun P _ => mul_assoc_classOf M N P
  have step₁ : ∀ (M : X.Modules) (c : VectorBundleKZero X),
      (mulRight c).comp (mul X (classOf X M)) = (mul X (classOf X M)).comp (mulRight c) :=
    fun M c => addHom_ext fun N _ =>
      congrArg (fun φ : VectorBundleKZero X →+ VectorBundleKZero X => φ c) (step₀ M N)
  have step₂ : ∀ b c : VectorBundleKZero X,
      (mulRight c).comp (mulRight b) = mulRight (mul X b c) :=
    fun b c => addHom_ext fun M _ =>
      congrArg (fun φ : VectorBundleKZero X →+ VectorBundleKZero X => φ b) (step₁ M c)
  exact congrArg (fun φ : VectorBundleKZero X →+ VectorBundleKZero X => φ a) (step₂ b c)

/-- **Stacks Project, Tag 0FDK.** The commutative ring structure on `K₀(Vect(X))`: the
multiplication is induced by the tensor product of sheaves of modules, and the unit is the
class of the structure sheaf. -/
@[sga "6 IV 2.7" "(X), special case"]
noncomputable instance instCommRing (X : Scheme.{u}) : CommRing (VectorBundleKZero X) where
  mul a b := mul X a b
  one := classOf X (SheafOfModules.unit X.ringCatSheaf)
  left_distrib a b c := map_add (mul X a) b c
  right_distrib a b c := map_add (mulRight c) a b
  zero_mul a := by
    change mul X 0 a = 0
    rw [map_zero, AddMonoidHom.zero_apply]
  mul_zero a := map_zero (mul X a)
  mul_assoc a b c := mul_assoc' a b c
  mul_comm a b := mul_comm' a b
  one_mul a := one_mul' a
  mul_one a := (mul_comm' a _).trans (one_mul' a)

/-- **Stacks Project, Tag 0FDK.** The unit of `K₀(Vect(X))` is the class of the structure
sheaf. -/
@[simp] theorem classOf_unit (X : Scheme.{u}) :
    classOf X (SheafOfModules.unit X.ringCatSheaf) = 1 := rfl

/-- **Stacks Project, Tag 0FDK.** Multiplication in `K₀(Vect(X))` is tensor product. -/
@[simp] theorem classOf_mul (M N : X.Modules)
    (hM : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M)
    (hN : IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) N) :
    classOf X M * classOf X N = classOf X (Scheme.Modules.tensorObjRingedSpace X M N) :=
  (mul_classOf M N).trans (classOfTensor_of_isFiniteLocallyFree M N hM hN)

/-- **Stacks Project, Tag 0FDK.** `K₀(Vect(X))` carries a commutative ring structure whose
additive group is the one it already has, whose multiplication is the tensor product of finite
locally free modules, and whose unit is the class of the structure sheaf. -/
@[stacks 0FDK "vector_bundle_grothendieck_ring", sga "6 IV 2.7" "b) K'_naif ring str."]
theorem exists_tensorProduct_commRing (X : Scheme.{u}) :
    ∃ r : CommRing (VectorBundleKZero X),
      r.toAddCommGroup = (inferInstance : AddCommGroup (VectorBundleKZero X)) ∧
        (∀ M N : X.Modules, IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) M →
          IsFiniteLocallyFree.{u, u, u} (R := X.ringCatSheaf) N →
            r.mul (classOf X M) (classOf X N) =
              classOf X (Scheme.Modules.tensorObjRingedSpace X M N)) ∧
        classOf X (SheafOfModules.unit X.ringCatSheaf) = r.one :=
  ⟨instCommRing X, rfl, fun M N hM hN => classOf_mul M N hM hN, rfl⟩

end VectorBundleKZero

