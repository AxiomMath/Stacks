module

public import StacksFrontier.AlgebraicGeometry.Perfect.SupportClosedSubset.ConormalClass.ChartSections
public import StacksFrontier.AlgebraicGeometry.Morphisms.Support.FiniteType
public import StacksFrontier.AlgebraicGeometry.QuasiRegular.StalkGenerators

/-!
# Two charts give the same twisted class

Let `i : Z ⟶ X` be a closed immersion and `(W, f)`, `(W', g)` two charts of `i` by `c`
generators of its ideal.  On `U ⊆ W ∩ W'` the twisted classes of the two charts agree.  Locally
`g = a f` for a matrix `a` of functions; the wedge changes by `det(a)`
(`Stacks.Perfect.ConormalClass.wedge_det`) and the class of the fraction by `det(a)⁻¹` in the
sense of Stacks 0G7S (`Stacks.Perfect.ConormalClass.topClass_app_det`), so the twisted classes
agree.  This is the independence of the choice of generators of Stacks 0G7T.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open MonoidalCategory
open Stacks.AlgebraicGeometry.RegularIdealSheaf
open Stacks.Perfect.SupportedFraction (supportCohomologySheaf supportCohomologySheafMap globalSmul)

universe u

namespace Stacks.Perfect.ConormalClass

attribute [local instance 10000] HasDerivedCategory.standard
attribute [local instance] modulesMonoidal

variable {X : Scheme.{u}}

/-! ### Evaluation at a local section, read back on the open -/

section EvalSec

variable {Y : Scheme.{u}} (L G : Y.Modules)

/-- `ev_ω` on a local section over an open `P ⊆ V`, read as a section of `G` over `P`. -/
def evalSecAt (V : Y.Opens) (ω : Γ(L, V)) (P : Y.Opens) (hP : P ≤ V)
    (m : Γ(dualModule L ⊗ G, P)) : Γ(G, P) :=
  G.presheaf.map (homOfLE (le_image_preimage hP)).op ((evalAt L G V ω).app P m)

/-- Evaluating at the restriction of `ω` to `V₂ ⊆ V` agrees with evaluating at `ω`. -/
theorem evalSecAt_restrict {V₂ V : Y.Opens} (h : V₂ ≤ V) (ω : Γ(L, V)) (P : Y.Opens)
    (hP : P ≤ V₂) (m : Γ(dualModule L ⊗ G, P)) :
    evalSecAt L G V₂ (L.presheaf.map (homOfLE h).op ω) P hP m =
      evalSecAt L G V ω P (hP.trans h) m := by
  have e := congrArg (fun φ => φ.app P m) (evalAt_restrict h G L ω)
  change G.presheaf.map (homOfLE (le_image_preimage hP)).op
      ((evalAt L G V₂ (L.presheaf.map (homOfLE h).op ω)).app P m) = _
  rw [e]
  exact modules_map_map_eq G (homOfLE (inter_mono_restrict h P))
    (homOfLE (le_image_preimage hP)) (homOfLE (le_image_preimage (hP.trans h))) (𝟙 P)
    ((evalAt L G V ω).app P m) |>.trans (by rw [op_id, G.presheaf.map_id]; rfl)

/-- Evaluation at `a • ω` is the restriction of `a` to `P` times evaluation at `ω`. -/
theorem evalSecAt_smul (V : Y.Opens) (ω : Γ(L, V)) (a : Γ(Y, V)) (P : Y.Opens) (hP : P ≤ V)
    (m : Γ(dualModule L ⊗ G, P)) :
    evalSecAt L G V (a • ω) P hP m =
      Y.presheaf.map (homOfLE hP).op a • evalSecAt L G V ω P hP m := by
  have e := congrArg (fun φ => φ.app P m) (evalAt_smul L G V ω a)
  change G.presheaf.map (homOfLE (le_image_preimage hP)).op ((evalAt L G V (a • ω)).app P m) = _
  rw [e]
  change G.presheaf.map (homOfLE (le_image_preimage hP)).op
      ((globalSmul (Y.presheaf.map (homOfLE V.ι_image_top.le).op a) ((res V).obj G)).app
        (V.ι ⁻¹ᵁ P) ((evalAt L G V ω).app P m)) = _
  refine (congrArg (G.presheaf.map (homOfLE (le_image_preimage hP)).op).hom
    (globalSmul_res_app V G _ (V.ι ⁻¹ᵁ P) ((evalAt L G V ω).app P m))).trans ?_
  refine (Scheme.Modules.map_smul G _ _ _).trans ?_
  refine congrArg (fun r : Γ(Y, P) => r • evalSecAt L G V ω P hP m) ?_
  unfold restrictFun
  exact (presheaf_map_map_map_eq Y.presheaf _ _ _ (homOfLE hP).op (𝟙 _) a).trans
    (by rw [Y.presheaf.map_id]; rfl)

end EvalSec

/-! ### Local facts -/

/-- **An epimorphism of modules is locally surjective on sections.** -/
theorem exists_app_eq_of_epi {M N : X.Modules} (φ : M ⟶ N) [Epi φ] {U : X.Opens} (y : Γ(N, U))
    (x : X) (hx : x ∈ U) :
    ∃ (U' : X.Opens) (_ : x ∈ U') (hU' : U' ≤ U) (s : Γ(M, U')),
      φ.app U' s = N.presheaf.map (homOfLE hU').op y := by
  have : @Epi (SheafOfModules X.ringCatSheaf) _ M N φ := ‹Epi φ›
  have hls := SheafOfModules.isLocallySurjective_toSheaf_of_epi (M := M) (N := N) φ
  have hmem := Presheaf.imageSieve_mem (Opens.grothendieckTopology X)
    ((SheafOfModules.toSheaf _).map φ).hom (U := op U) y
  obtain ⟨V, g, ⟨s, hs⟩, hxV⟩ := (Opens.mem_grothendieckTopology _).1 hmem x hx
  exact ⟨V, hxV, leOfHom g, s, hs⟩

section Generation

variable (J : (Stacks.RingedSpace.structureSheafModule X.toRingedSpace).Submodule)

/-- **Sections of an ideal generated by `f` are locally combinations of the `fᵢ`.** -/
theorem exists_matrix_of_isGeneratedByOn {W : X.Opens} {c : ℕ} (f : Fin c → Γ(X, W))
    (hgen : IsGeneratedByOn X.toRingedSpace J W f) {U : X.Opens} (hU : U ≤ W) {c' : ℕ}
    (g : Fin c' → Γ(X, U)) (hg : ∀ j, g j ∈ J.obj (op U)) (x : X) (hx : x ∈ U) :
    ∃ (U' : X.Opens) (_ : x ∈ U') (hU' : U' ≤ U) (A : Matrix (Fin c') (Fin c) Γ(X, U')),
      ∀ j, X.presheaf.map (homOfLE hU').op (g j) =
        ∑ k, A j k * X.presheaf.map (homOfLE (hU'.trans hU)).op (f k) := by
  classical
  have hmem : ∀ j, X.presheaf.germ U x hx (g j) ∈
      Jid (germFamily X.toRingedSpace W f x (hU hx)) := fun j =>
    germ_mem_of_mem_generatedIdealOn W f U (g j) ((hgen U hU) ▸ hg j) x hx (hU hx)
  choose cc hcc using fun j => Ideal.mem_span_range_iff_exists_fun.mp (hmem j)
  obtain ⟨V₀, hxV₀, b, hb⟩ := Stacks.AlgebraicGeometry.QuasiRegular.exists_nhds_germ_eq
    (X := X.toRingedSpace) (Finset.univ : Finset (Fin c' × Fin c)) x (fun p => cc p.1 p.2)
  set O : X.Opens := U ⊓ V₀
  have hxO : x ∈ O := ⟨hx, hxV₀⟩
  let d : Fin c' → Γ(X, O) := fun j => X.presheaf.map (homOfLE inf_le_left).op (g j) -
    ∑ k, X.presheaf.map (homOfLE inf_le_right).op (b (j, k)) *
      X.presheaf.map (homOfLE (inf_le_left.trans hU)).op (f k)
  have hd : ∀ j ∈ (Finset.univ : Finset (Fin c')), X.presheaf.germ O x hxO (d j) = 0 := by
    intro j _
    simp only [d, map_sub, map_sum, map_mul, sub_eq_zero]
    rw [TopCat.Presheaf.germ_res_apply, ← hcc j]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply,
      hb (j, k) (Finset.mem_univ _)]
    rfl
  obtain ⟨U', hxU', hU'O, hU'⟩ :=
    exists_nhds_forall_restrict_eq_zero (X := X.toRingedSpace) x hxO Finset.univ d hd
  refine ⟨U', hxU', hU'O.trans inf_le_left,
    fun j k => X.presheaf.map (homOfLE (hU'O.trans inf_le_right)).op (b (j, k)), fun j => ?_⟩
  have h := hU' j (Finset.mem_univ j)
  simp only [d, map_sub, map_sum, map_mul, sub_eq_zero] at h
  refine Eq.trans ?_ (h.trans ?_)
  · exact presheaf_map_eq_map_map X.presheaf _ _ _ (g j)
  · refine Finset.sum_congr rfl fun k _ => ?_
    rw [presheaf_map_map_eq X.presheaf _ _ (homOfLE (hU'O.trans inf_le_right)).op (𝟙 _),
      presheaf_map_map_eq X.presheaf _ _ (homOfLE ((hU'O.trans inf_le_left).trans hU)).op (𝟙 _),
      X.presheaf.map_id]
    rfl

end Generation

/-! ### The class of a chart on the image of a section of `ℱ` -/

section Unit

variable {Z : Scheme.{u}} {i : Z ⟶ X} [IsClosedImmersion i] {c : ℕ} (F : X.Modules)
  {W : X.Opens} {f : Fin c → Γ(X, W)}
  (hgen : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom i) W f)

/-- **On the image of a section of `ℱ`, `c̄_{W,f}` is the class of the chart.** -/
theorem chartDescSec_unit (U : X.Opens) (hU : U ≤ W) (s : Γ(F, U)) :
    chartDescSec F hgen U hU
      (((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app F).app U s) =
      (topClass W F (isClosed_chartSupport W (chartEq W f)) (chartEq W f) subset_rfl).app U s := by
  have e := congrArg (fun φ => φ.app U s)
    (unit_comp_chartDescent i W f F hgen (isClosed_chartSupport W (chartEq W f)) subset_rfl)
  change (supportCohomologySheaf (isClosed_chartSupport W (chartEq W f)) F (c : ℤ)).presheaf.map
      (homOfLE (le_image_preimage hU)).op ((chartDescent i W f F hgen
        (isClosed_chartSupport W (chartEq W f)) subset_rfl).app U
        (((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app F).app U s)) = _
  rw [show (chartDescent i W f F hgen (isClosed_chartSupport W (chartEq W f)) subset_rfl).app U
      (((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app F).app U s) = _ from e]
  exact modules_map_map_self _ _ _ _

end Unit

/-! ### Restricting a chart -/

section Restrict

variable {Z : Scheme.{u}} {i : Z ⟶ X} [IsClosedImmersion i] {c : ℕ}
  {W : X.Opens} {f : Fin c → Γ(X, W)}
  (hgen : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom i) W f)
  {U' : X.Opens} (hU' : U' ≤ W)

/-- The restriction of the generators of a chart to a smaller open. -/
abbrev restrictGen : Fin c → Γ(X, U') := fun j => X.presheaf.map (homOfLE hU').op (f j)

omit [IsClosedImmersion i] in
include hgen in
/-- The restrictions to `U' ⊆ W` of generators of the ideal of `i` on `W` generate it on `U'`. -/
theorem isGeneratedByOn_restrictGen :
    IsGeneratedByOn X.toRingedSpace (definingIdealOfHom i) U' (restrictGen (f := f) hU') :=
  isGeneratedByOn_of_le W f hgen U' hU'

/-- The equations of the restricted chart are the restrictions of the equations of the chart. -/
theorem chartEq_restrictGen :
    chartEq U' (restrictGen (f := f) hU') = restrictEquations hU' (chartEq W f) :=
  funext fun j => presheaf_map_map_eq X.presheaf _ _ _ _ (f j)

variable (F : X.Modules)

omit hgen in
/-- A set containing the support of the chart restricted to `U'` contains the support of the chart
on `W`. -/
theorem chartSupport_subset_of_restrict {T : Set X}
    (hsub : chartSupport U' (chartEq U' (restrictGen (f := f) hU')) ⊆ T) :
    chartSupport W (chartEq W f) ⊆ T :=
  (chartSupport_subset_restrict hU' (chartEq W f)).trans
    ((chartEq_restrictGen hU') ▸ hsub)

/-- **The class of a chart, on a section whose evaluation comes from `ℱ`**, read in any
`ℋ^c_T(ℱ)` with `T` containing the support of the restricted chart. -/
theorem chartSec_theta_eq (m : Γ(twistSource i c F, U')) (s : Γ(F, U'))
    (hs : ((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app F).app U' s =
      chartEvalSec F hgen U' hU' m)
    {T : Set X} (hT : IsClosed T)
    (hsub : chartSupport U' (chartEq U' (restrictGen (f := f) hU')) ⊆ T) :
    (supportChangeH (isClosed_zeroLocus i) hT
        ((zeroLocus_subset_chartSupport W f hgen).trans
          (chartSupport_subset_of_restrict hU' hsub)) F (c : ℤ)).app U'
        (chartSec F hgen U' hU' m) =
      (topClass U' F hT (chartEq U' (restrictGen (f := f) hU')) hsub).app U' s := by
  have hTa := chartSupport_subset_of_restrict hU' hsub
  have hcomp := supportChangeH_comp (isClosed_zeroLocus i) (isClosed_chartSupport W (chartEq W f))
    (zeroLocus_subset_chartSupport W f hgen) hT hTa F (c : ℤ)
  rw [← hcomp]
  change (supportChangeH _ hT hTa F (c : ℤ)).app U'
      ((chartTheta F hgen).app U' (chartSec F hgen U' hU' m)) = _
  rw [chartTheta_chartSec, ← hs, chartDescSec_unit]
  refine (congrArg (fun φ => φ.app U' s)
    (topClass_supportChange W F (isClosed_chartSupport W (chartEq W f)) hT hTa (chartEq W f)
      subset_rfl)).trans ?_
  have h2 := topClass_restrict hU' F hT (chartEq W f) (subset_rfl.trans hTa)
    ((chartEq_restrictGen hU') ▸ hsub)
  refine (congrArg (fun φ => φ.app U' s) h2.symm).trans ?_
  exact congrArg (fun φ => φ.app U' s)
    (topClass_congr U' F hT (chartEq_restrictGen hU').symm _ hsub)

end Restrict

/-! ### Changing the generators by a matrix -/

section Matrix

variable {Z : Scheme.{u}} {i : Z ⟶ X} [IsClosedImmersion i] {c : ℕ} (F : X.Modules)

/-- Equal families of equations have equal wedges. -/
theorem wedge_congr {A : X.Opens} {f g : Fin c → Γ(X, A)} (h : f = g)
    (hf : ∀ j, (i.app A).hom (f j) = 0) (hg : ∀ j, (i.app A).hom (g j) = 0) :
    wedge i f hf = wedge i g hg := by
  subst h
  rfl

/-- **The evaluation changes by the determinant.** If on `U ⊆ W ∩ W'` the generators of the
second chart are `a` times those of the first, then the evaluation at the wedge of the second is
`det(a)` times the evaluation at the wedge of the first. -/
theorem chartEvalSec_matrix {Wa Wb : X.Opens} {fa : Fin c → Γ(X, Wa)} {fb : Fin c → Γ(X, Wb)}
    (ha : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom i) Wa fa)
    (hb : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom i) Wb fb)
    {U : X.Opens} (hUa : U ≤ Wa) (hUb : U ≤ Wb) (A : Matrix (Fin c) (Fin c) Γ(X, U))
    (hA : ∀ j, restrictGen (f := fb) hUb j = ∑ k, A j k * restrictGen (f := fa) hUa k)
    (m : Γ(twistSource i c F, U)) :
    chartEvalSec F hb U hUb m = A.det • chartEvalSec F ha U hUa m := by
  set L := line i c
  set G := (Scheme.Modules.pullback i).obj F
  have hfa := app_chart_eq_zero Wa fa ha
  have hfb := app_chart_eq_zero Wb fb hb
  have hra := app_chart_eq_zero U _ (isGeneratedByOn_restrictGen ha hUa)
  have hrb := app_chart_eq_zero U _ (isGeneratedByOn_restrictGen hb hUb)
  have hwb : L.presheaf.map (homOfLE (i.preimage_mono hUb)).op (wedge i fb hfb) =
      (i.app U).hom A.det • L.presheaf.map (homOfLE (i.preimage_mono hUa)).op (wedge i fa hfa) := by
    rw [← wedge_restrict i hUb fb hfb hrb, ← wedge_restrict i hUa fa hfa hra]
    exact wedge_det i _ _ hra hrb A hA
  have e : ∀ {W : X.Opens} {f : Fin c → Γ(X, W)}
      (h : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom i) W f) (hU : U ≤ W),
      chartEvalSec F h U hU m = evalSecAt L G (i ⁻¹ᵁ U) (L.presheaf.map
        (homOfLE (i.preimage_mono hU)).op (wedge i f (app_chart_eq_zero W f h)))
        (i ⁻¹ᵁ U) le_rfl m :=
    fun h hU => (evalSecAt_restrict L G (i.preimage_mono hU) _ (i ⁻¹ᵁ U) le_rfl m).symm
  rw [e hb hUb, e ha hUa, hwb]
  refine (evalSecAt_smul L G (i ⁻¹ᵁ U) _ ((i.app U).hom A.det) (i ⁻¹ᵁ U) le_rfl m).trans ?_
  have hz : Z.presheaf.map (homOfLE (le_refl (i ⁻¹ᵁ U))).op ((i.app U).hom A.det) =
      (i.app U).hom A.det := by
    rw [show homOfLE (le_refl (i ⁻¹ᵁ U)) = 𝟙 _ from rfl, op_id, Z.presheaf.map_id]
    rfl
  exact congrArg (· • _) hz

end Matrix

/-! ### Independence of the chart -/

section Agree

variable {Z : Scheme.{u}} {i : Z ⟶ X} [IsClosedImmersion i] {c : ℕ} (F : X.Modules)

omit [IsClosedImmersion i] in
/-- Restricting the generators restricted to `U₁` further to `U₂ ⊆ U₁` gives the generators
restricted to `U₂`. -/
theorem restrictGen_restrictGen {W U₁ U₂ : X.Opens} (f : Fin c → Γ(X, W)) (h₁ : U₁ ≤ W)
    (h₂ : U₂ ≤ U₁) (j : Fin c) :
    X.presheaf.map (homOfLE h₂).op (restrictGen (f := f) h₁ j) =
      restrictGen (f := f) (h₂.trans h₁) j :=
  (presheaf_map_eq_map_map X.presheaf _ _ _ (f j)).symm

/-- **Two charts give the same twisted class** on the opens contained in both. -/
theorem chartSec_agree {Wa Wb : X.Opens} {fa : Fin c → Γ(X, Wa)} {fb : Fin c → Γ(X, Wb)}
    (ha : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom i) Wa fa)
    (hb : IsGeneratedByOn X.toRingedSpace (definingIdealOfHom i) Wb fb)
    {U : X.Opens} (hUa : U ≤ Wa) (hUb : U ≤ Wb) (m : Γ(twistSource i c F, U)) :
    chartSec F ha U hUa m = chartSec F hb U hUb m := by
  classical
  set H := supportCohomologySheaf (isClosed_zeroLocus i) F (c : ℤ)
  set η := (Scheme.Modules.pullbackPushforwardAdjunction i).unit.app F
  have : Epi η := Stacks.ClosedImmersion.epi_unit_app i F
  have key : ∀ x ∈ U, ∃ (U₂ : X.Opens) (_ : x ∈ U₂) (h : U₂ ≤ U),
      H.presheaf.map (homOfLE h).op (chartSec F ha U hUa m) =
        H.presheaf.map (homOfLE h).op (chartSec F hb U hUb m) := by
    intro x hx
    obtain ⟨U₁, hx₁, h₁, A, hA⟩ := exists_matrix_of_isGeneratedByOn (definingIdealOfHom i) fa ha
      hUa (restrictGen (f := fb) hUb)
      (fun j => app_chart_eq_zero U _ (isGeneratedByOn_restrictGen hb hUb) j) x hx
    obtain ⟨U₂, hx₂, h₂, s, hs⟩ := exists_app_eq_of_epi η
      (chartEvalSec F ha U₁ (h₁.trans hUa) ((twistSource i c F).presheaf.map (homOfLE h₁).op m))
      x hx₁
    refine ⟨U₂, hx₂, h₂.trans h₁, ?_⟩
    set m' := (twistSource i c F).presheaf.map (homOfLE (h₂.trans h₁)).op m
    have hm' : (twistSource i c F).presheaf.map (homOfLE h₂).op
        ((twistSource i c F).presheaf.map (homOfLE h₁).op m) = m' :=
      (modules_map_eq_map_map _ _ _ _ m).symm
    have hsa : η.app U₂ s = chartEvalSec F ha U₂ ((h₂.trans h₁).trans hUa) m' :=
      hs.trans ((chartEvalSec_restrict F ha h₂ (h₁.trans hUa) _).symm.trans
        (congrArg (chartEvalSec F ha U₂ ((h₂.trans h₁).trans hUa)) hm'))
    let A' : Matrix (Fin c) (Fin c) Γ(X, U₂) := fun j k => X.presheaf.map (homOfLE h₂).op (A j k)
    have hA' : ∀ j, restrictGen (f := fb) ((h₂.trans h₁).trans hUb) j =
        ∑ k, A' j k * restrictGen (f := fa) ((h₂.trans h₁).trans hUa) k := by
      intro j
      have e := congrArg (X.presheaf.map (homOfLE h₂).op).hom (hA j)
      rw [map_sum] at e
      refine Eq.trans ?_ (e.trans (Finset.sum_congr rfl fun k _ => ?_))
      · exact (restrictGen_restrictGen fb (h₁.trans hUb) h₂ j).symm.trans
          (congrArg (X.presheaf.map (homOfLE h₂).op).hom (restrictGen_restrictGen fb hUb h₁ j).symm)
      · rw [map_mul]
        exact congrArg (A' j k * ·) (presheaf_map_eq_map_map X.presheaf _ _ _ (fa k)).symm
    have hsb : η.app U₂ (A'.det • s) = chartEvalSec F hb U₂ ((h₂.trans h₁).trans hUb) m' := by
      rw [Scheme.Modules.Hom.app_smul, hsa]
      exact (chartEvalSec_matrix F ha hb _ _ A' hA' m').symm
    let Ta := chartSupport U₂ (chartEq U₂ (restrictGen (f := fa) ((h₂.trans h₁).trans hUa)))
    let Tb := chartSupport U₂ (chartEq U₂ (restrictGen (f := fb) ((h₂.trans h₁).trans hUb)))
    have hT : IsClosed (Ta ∪ Tb) := (isClosed_chartSupport _ _).union (isClosed_chartSupport _ _)
    have hZa := chartSec_theta_eq ha ((h₂.trans h₁).trans hUa) F m' s hsa hT Set.subset_union_left
    have hZb := chartSec_theta_eq hb ((h₂.trans h₁).trans hUb) F m' (A'.det • s) hsb hT
      Set.subset_union_right
    have hbij := bijective_supportChangeH_app (isClosed_zeroLocus i) hT
      ((zeroLocus_subset_chartSupport Wa fa ha).trans
        (chartSupport_subset_of_restrict ((h₂.trans h₁).trans hUa) Set.subset_union_left))
      U₂ (fun y hy hyT => hyT.elim
        (mem_zeroLocus_of_mem_chartSupport U₂ _
          (isGeneratedByOn_restrictGen ha ((h₂.trans h₁).trans hUa)) y hy)
        (mem_zeroLocus_of_mem_chartSupport U₂ _
          (isGeneratedByOn_restrictGen hb ((h₂.trans h₁).trans hUb)) y hy)) F (c : ℤ) le_rfl
    rw [← chartSec_restrict F ha (h₂.trans h₁) hUa, ← chartSec_restrict F hb (h₂.trans h₁) hUb]
    refine hbij.1 (hZa.trans (Eq.trans ?_ hZb.symm))
    let φ := X.presheaf.map (homOfLE U₂.ι_image_top.le).op
    have hdet := topClass_app_det U₂ F hT
      (chartEq U₂ (restrictGen (f := fa) ((h₂.trans h₁).trans hUa)))
      (chartEq U₂ (restrictGen (f := fb) ((h₂.trans h₁).trans hUb)))
      (fun j k => φ (A' j k))
      (fun j => by
        change φ _ = _
        rw [hA' j, map_sum]
        exact Finset.sum_congr rfl fun k _ => map_mul _ _ _)
      Set.subset_union_left Set.subset_union_right (le_refl U₂) s
    refine hdet.trans (congrArg _ (congrArg (· • s) ?_))
    have hd : Matrix.det (fun j k => φ (A' j k)) = φ A'.det := (RingHom.map_det φ.hom A').symm
    exact (congrArg (restrictFun U₂ (le_refl U₂)) hd).trans (presheaf_map_map_self _ _ _)
  choose U₂ hx₂ h₂ hU₂ using key
  refine TopCat.Sheaf.eq_of_locally_eq' (F := (⟨H.presheaf, H.isSheaf⟩ : TopCat.Sheaf Ab.{u} X))
    (fun x : U => U₂ x.1 x.2) U (fun x => homOfLE (h₂ x.1 x.2))
    (fun y hy => Opens.mem_iSup.mpr ⟨⟨y, hy⟩, hx₂ y hy⟩) _ _ fun x => hU₂ x.1 x.2

end Agree

