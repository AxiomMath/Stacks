module

public import StacksFrontier.AlgebraicGeometry.Perfect.SupportClosedSubset.ConormalClass.TwistGlue
public import StacksFrontier.AlgebraicGeometry.Conormal.SplitCotangentFibre
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.NakayamaGenerators
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ExteriorPowerShortExact
public import StacksFrontier.AlgebraicGeometry.ClosedImmersionFinitePresentation.Basic
public import StacksFrontier.AlgebraicGeometry.FiniteLocallyFreeRank.ShortExact

/-!
# A closed immersion with locally free conormal sheaf is locally cut out by equations

Let `i : Z ⟶ X` be a closed immersion of finite presentation whose conormal sheaf is finite
locally free of rank `c`.  Every point of `Z` has an open neighbourhood `W` in `X` and sections
`f₁, …, f_c ∈ Γ(W, 𝒪_X)` generating the ideal sheaf of `Z` over `W`.

At `z ∈ Z` with image `x`, the stalk `I_x` of the ideal sheaf is finitely generated and
`I_x/I_x² = 𝒞_{Z/X, z}` is free of rank `c` over `𝒪_{Z,z}`; lifts of a basis generate `I_x`
by Nakayama's lemma, hence generate the ideal sheaf near `x`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.AlgebraicGeometry.RegularIdealSheaf
open Stacks.RingedSpace

universe u

namespace Stacks.Perfect.ConormalClass

/-! ### Generators of the cotangent module of a surjection -/

section Cotangent

variable {R : Type u} [CommRing R]

/-- If the cotangent module of an ideal is spanned by the classes of `v₁, …, v_c`, then the ideal
is contained in `(v) + I²`. -/
theorem le_span_sup_sq {I : Ideal R} {c : ℕ} (v : Fin c → I)
    (hv : ∀ y : I.Cotangent, ∃ r : Fin c → R, y = ∑ k, r k • I.toCotangent (v k)) :
    I ≤ Ideal.span (Set.range fun k => (v k : R)) ⊔ I ^ 2 := by
  intro a ha
  obtain ⟨r, hr⟩ := hv (I.toCotangent ⟨a, ha⟩)
  have hsub : I.toCotangent (⟨a, ha⟩ - ∑ k, r k • v k) = 0 := by
    rw [map_sub, map_sum, hr]
    simp only [map_smul, sub_self]
  rw [Ideal.toCotangent_eq_zero] at hsub
  have hcoe : ((⟨a, ha⟩ - ∑ k, r k • v k : I) : R) = a - ∑ k, r k * (v k : R) := by
    rw [Submodule.coe_sub, Submodule.coe_sum]
    rfl
  rw [hcoe] at hsub
  refine Submodule.mem_sup.2 ⟨∑ k, r k * (v k : R), ?_, a - ∑ k, r k * (v k : R), hsub, by ring⟩
  exact Submodule.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)

/-- Through the identification of the target of a surjection with the quotient by its kernel,
scalars of the target act on the cotangent module as their lifts do. -/
theorem smul_cotangent_of_surjective {S : Type u} [CommRing S] (φ : R →+* S)
    (hφ : Function.Surjective φ) (r : R) (y : (RingHom.ker φ).Cotangent) :
    letI : Module S (RingHom.ker φ).Cotangent :=
      Module.compHom (RingHom.ker φ).Cotangent
        (RingHom.quotientKerEquivOfSurjective hφ).symm.toRingHom
    φ r • y = r • y := by
  change (RingHom.quotientKerEquivOfSurjective hφ).symm (φ r) • y = r • y
  rw [RingHom.quotientKerEquivOfSurjective_symm_apply, ← Ideal.Quotient.algebraMap_eq,
    algebraMap_smul]

end Cotangent

/-! ### Charts from the local freeness of the conormal sheaf -/

section Exists

variable {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]

attribute [local instance] Stacks.Conormal.conormalSheafStalkModule
  Stacks.Conormal.cotangentStalkModule

/-- The ideal sheaf of `i` is generated by finitely many sections on an affine open around any
point. -/
theorem exists_isGeneratedByOn_affine [LocallyOfFinitePresentation i] (x : X) :
    ∃ (V : X.Opens) (_ : x ∈ V) (r : ℕ) (g : Fin r → Γ(X, V)),
      IsGeneratedByOn X.toRingedSpace (definingIdealOfHom i) V g := by
  obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (X := X) (U := ⊤) (x := x) trivial
  have hfg := (locallyOfFinitePresentation_iff_fg_ker i).mp inferInstance ⟨V, hV⟩
  rw [Scheme.Hom.ker_apply] at hfg
  obtain ⟨r, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  exact ⟨V, hxV, r, g,
    Stacks.AlgebraicGeometry.isGeneratedByOn_definingIdealOfHom_of_ker_app_eq_span i hV g hg.symm⟩

/-- **A closed immersion of finite presentation whose conormal sheaf is finite locally free of
rank `c` is cut out near every point of `Z` by `c` equations.** -/
theorem exists_chart [LocallyOfFinitePresentation i] (c : ℕ)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} (conormal i) c] (z : Z) :
    ∃ a : ChartIndex i c, i.base z ∈ a.1.1 := by
  classical
  set φ := (i.liftCoborder.stalkMap z).hom
  have hφ : Function.Surjective φ := i.liftCoborder.stalkMap_surjective z
  set K := RingHom.ker φ
  let := Stacks.SheafOfModules.FlatShortExact.stalkModule (X := Z.toRingedSpace) (conormal i) z
  obtain ⟨e⟩ := AlgebraicGeometry.SheafOfModules.nonempty_stalkLinearEquiv_fin (conormal i) c z
  set Ψ := Stacks.Conormal.conormalSheafStalkEquivCotangent i z
  have hspan : ∀ y : K.Cotangent, ∃ β : Fin c → Z.presheaf.stalk z,
      y = ∑ k, β k • Ψ (e.symm (Finsupp.single k 1)) := by
    intro y
    refine ⟨fun k => e (Ψ.symm y) k, ?_⟩
    have h1 : Ψ.symm y = ∑ k, e (Ψ.symm y) k • e.symm (Finsupp.single k 1) := by
      refine (e.symm_apply_apply (Ψ.symm y)).symm.trans ?_
      conv_lhs => rw [← Finsupp.univ_sum_single (e (Ψ.symm y))]
      rw [map_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [← Finsupp.smul_single_one, map_smul]
    refine (Ψ.apply_symm_apply y).symm.trans ((congrArg Ψ h1).trans ?_)
    refine (map_sum Ψ _ _).trans ?_
    exact Finset.sum_congr rfl fun k _ => map_smul Ψ _ _
  choose κ hκ using fun k => Ideal.toCotangent_surjective K (Ψ (e.symm (Finsupp.single k 1)))
  have hspan' : ∀ y : K.Cotangent, ∃ r : Fin c →
      i.coborderRange.toScheme.presheaf.stalk (i.liftCoborder.base z),
      y = ∑ k, r k • K.toCotangent (κ k) := fun y => by
    obtain ⟨β, hβ⟩ := hspan y
    choose r hr using fun k => hφ (β k)
    refine ⟨r, hβ.trans (Finset.sum_congr rfl fun k _ => ?_)⟩
    rw [← hr k, hκ k]
    exact smul_cotangent_of_surjective φ hφ (r k) _
  have hK := le_span_sup_sq κ hspan'
  set x := i.base z
  set J := definingIdealOfHom i
  set cob := Stacks.Conormal.coborderStalkEquiv i z
  have hJ : stalkIdeal (X := X.toLocallyRingedSpace) J x = RingHom.ker (i.stalkMap z).hom :=
    stalkIdeal_definingIdealOfHom_eq_ker i z
  let b : Fin c → X.presheaf.stalk x := fun k => cob.inv.hom (κ k)
  have hmem : ∀ y ∈ K, cob.inv.hom y ∈ stalkIdeal (X := X.toLocallyRingedSpace) J x :=
    fun y hy => by
    have : cob.hom.hom (cob.inv.hom y) = y := by simp
    rw [hJ, RingHom.mem_ker, ← Stacks.Conormal.stalkMap_coborderStalkEquiv, this]
    exact hy
  have hb : ∀ k, b k ∈ stalkIdeal (X := X.toLocallyRingedSpace) J x := fun k => hmem _ (κ k).2
  have hle0 : stalkIdeal (X := X.toLocallyRingedSpace) J x ≤
      Ideal.span (Set.range b) ⊔ stalkIdeal (X := X.toLocallyRingedSpace) J x ^ 2 := by
    intro a ha
    have h1 : cob.hom.hom a ∈ K := by
      rw [RingHom.mem_ker, Stacks.Conormal.stalkMap_coborderStalkEquiv]
      rwa [hJ] at ha
    have hmap : Ideal.map cob.inv.hom K ≤ stalkIdeal (X := X.toLocallyRingedSpace) J x := by
      exact Ideal.map_le_iff_le_comap.2 hmem
    have h3 : Ideal.map cob.inv.hom (Ideal.span (Set.range fun k => (κ k :
        i.coborderRange.toScheme.presheaf.stalk (i.liftCoborder.base z))) ⊔ K ^ 2) ≤
        Ideal.span (Set.range b) ⊔ stalkIdeal (X := X.toLocallyRingedSpace) J x ^ 2 := by
      rw [Ideal.map_sup, Ideal.map_span, Ideal.map_pow]
      refine sup_le_sup (le_of_eq ?_) ?_
      · rw [← Set.range_comp]
        rfl
      · rw [sq, sq]
        exact Ideal.mul_mono hmap hmap
    have h4 : a = cob.inv.hom (cob.hom.hom a) := by
      rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
    rw [h4]
    exact h3 (Ideal.mem_map_of_mem _ (hK h1))
  choose U hxU t ht hgerm using fun k => (mem_stalkIdeal_iff J).mp (hb k)
  set U₀ : X.Opens := ⨅ k, U k
  have hxU₀ : x ∈ U₀ := by
    rw [← SetLike.mem_coe, Opens.coe_iInf]
    exact Set.mem_iInter.2 hxU
  let f : Fin c → Γ(X, U₀) := fun k => X.presheaf.map (homOfLE (iInf_le U k)).op (t k)
  have hf : ∀ k, f k ∈ J.obj (op U₀) := fun k => J.toSubmodule.map_mem _ (ht k)
  have hgf : germFamily X.toRingedSpace U₀ f x hxU₀ = b := funext fun k =>
    (TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (iInf_le U k)) x hxU₀ (t k)).trans
      (hgerm k)
  obtain ⟨V, hxV, r, g, hg⟩ := exists_isGeneratedByOn_affine i x
  obtain ⟨V', hxV', hV'U, hgen⟩ := exists_isGeneratedByOn_of_le_sup_sq (X := X.toLocallyRingedSpace)
    J (stalkIdeal_definingIdealOfHom_ne_top i z) hxV g hg hxU₀ f hf (by rwa [hgf])
  exact ⟨⟨⟨V', fun k => X.presheaf.map (homOfLE hV'U).op (f k)⟩, hgen⟩, hxV'⟩

end Exists

end Stacks.Perfect.ConormalClass
