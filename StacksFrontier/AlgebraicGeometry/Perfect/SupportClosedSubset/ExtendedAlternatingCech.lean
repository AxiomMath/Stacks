module

public import Mathlib.Algebra.Category.Grp.Biproducts
public import Mathlib.Algebra.Category.Grp.Limits
public import Mathlib.Algebra.Homology.HomologicalComplex
public import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
public import Mathlib.AlgebraicGeometry.Modules.Sheaf
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Topology.Sheaves.Cohomology.Cech.AlternatingCochainGroups
public import StacksFrontier.Topology.Sheaves.Cohomology.Locality.CohomologyVanishesLocally

/-!
# The extended alternating Čech complex of global equations

A finite family `f : Fin c → Γ(X, ⊤)` of global functions on a scheme `X` defines a closed
subscheme — the one cut out by the ideal they generate — and an extended alternating Čech
complex of sheaves of modules. Its degree-zero term is the coefficient module itself; its
positive-degree terms are finite direct sums of the direct images of the restrictions of the
coefficient module to the intersections of the principal opens `X.basicOpen (f i)`; its
differential out of degree zero is the canonical restriction map, and in positive degrees it is
the signed alternating restriction map.

This file packages the construction as data: a structure `Data` recording the complex together
with the isomorphisms identifying its terms and the sectionwise formulas pinning down its
differentials, a structure `FunctorData` recording functoriality in the coefficient module, and
a term `functor` inhabiting the latter.

## Main definitions

* `equationsIdeal` and `equationsClosedSubscheme`: the ideal of global sections generated by
  the equations and the closed subscheme it cuts out.
* `equationsOpen` and `restrictedModule`: the intersection of the principal opens belonging to
  a strictly increasing tuple of indices, and the direct image of the restriction of a module
  to it.
* `restrictedModuleSection`: the canonical sectionwise identification of a section of such a
  direct image with a section over the intersection of the ambient open and the principal
  opens.
* `Data`: the complex together with the isomorphisms and the sectionwise formulas that specify
  it.
* `FunctorData`: functoriality of the complex in the coefficient module.
* `functor`: the canonical construction.
* `data`: the extended alternating Čech complex of a single coefficient module.

All of these live in the namespace `AlgebraicGeometry.ExtendedAlternatingCech`.

## Main results

The construction has the displayed terms and, on every open subset, the signed alternating
restriction differential.

## Implementation notes

Indices are strictly increasing tuples in `Fin c`, corresponding to the subsets
`1 ≤ i₀ < ⋯ < iₚ ≤ c`. Finite categorical products represent the displayed finite direct sums.
The sectionwise characterizations specify the canonical restriction maps, including the map out
of degree zero, and are compatible with the isomorphisms to the displayed direct-image summands.

The restriction maps between the direct-image terms are assembled from Mathlib's pushforward
and restriction isomorphisms, each of whose section formulas is a restriction map of the
coefficient module. Those formulas are read off by naming the sections of a restricted module
through `AlgebraicGeometry.Scheme.Modules.restrictAppIso` rather than through the equality of
section groups it witnesses, and by then contracting the composite of restriction maps to a
single one; the opens in that composite all agree, so the contraction is reflexivity.

The cochain-level operations on ordered Čech cochains (`CechCochains.OrdCochain`,
`CechCochains.ordD`) are those of Tag 01FJ.

## References

* [Stacks Project, Tag 0G7I](https://stacks.math.columbia.edu/tag/0G7I)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open scoped AlgebraicGeometry

universe u

namespace AlgebraicGeometry.ExtendedAlternatingCech

variable {X : Scheme.{u}} {c : ℕ} (f : Fin c → Γ(X, ⊤))

/-- The ideal of global sections generated by the given equations. -/
public def equationsIdeal : Ideal Γ(X, ⊤) := Ideal.span (Set.range f)

/-- The closed subscheme cut out by the given equations. -/
@[stacks 0G7I "closed subscheme cut out by the equations"]
public def equationsClosedSubscheme : Scheme.{u} :=
  (Scheme.IdealSheafData.ofIdealTop (equationsIdeal f)).subscheme

/-- The intersection of the principal opens belonging to an increasing tuple. -/
@[stacks 0G7I "principal-open intersections"]
public def equationsOpen (p : ℕ) (s : CechCochains.OrdIndex (I := Fin c) p) : X.Opens :=
  ⨅ k, X.basicOpen (f (s.1 k))

/-- The direct image to `X` of a module restricted to a principal intersection. -/
@[reducible, stacks 0G7I "direct images of restrictions"]
public def restrictedModule (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) : X.Modules :=
  (Scheme.Modules.pushforward (equationsOpen f p s).ι).obj
    ((Scheme.Modules.pullback (equationsOpen f p s).ι).obj F)

/-- The canonical identification of a section of a restricted direct image with a
section on the intersection of the ambient open and the principal opens. -/
public def restrictedModuleSection (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) (V : X.Opens) :
    Γ(restrictedModule f F p s, V) →+
      Γ(F, CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1) := by
  let U := equationsOpen f p s
  let i := U.ι
  have h : i ''ᵁ (i ⁻¹ᵁ V) =
      CechCochains.inter (fun j => V ⊓ X.basicOpen (f j)) s.1 := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    simp only [U, equationsOpen, CechCochains.inter,
      inf_comm (⨅ k, X.basicOpen (f (s.1 k))) V, inf_iInf]
  let e : Γ(F, i ''ᵁ (i ⁻¹ᵁ V)) ≃+
      Γ(F, CechCochains.inter (fun j => V ⊓ X.basicOpen (f j)) s.1) := by
    rw [← h]
  exact e.toAddMonoidHom.comp ((F.restrictAppIso i (i ⁻¹ᵁ V)).hom.hom.comp
    (((Scheme.Modules.restrictFunctorIsoPullback i).inv.app F).app (i ⁻¹ᵁ V)).hom)

/-- The image of the preimage of `V` under the inclusion of `U` is `U ⊓ V`. -/
private lemma image_preimage_ι_eq_inf (U V : X.Opens) : U.ι ''ᵁ U.ι ⁻¹ᵁ V = U ⊓ V := by
  rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]

/-- The intersection of `V` with the principal opens is `equationsOpen ⊓ V`. -/
private lemma inter_basicOpen_eq (p : ℕ) (s : CechCochains.OrdIndex (I := Fin c) p)
    (V : X.Opens) :
    CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1 = equationsOpen f p s ⊓ V := by
  simp only [equationsOpen, CechCochains.inter, inf_comm (⨅ k, X.basicOpen (f (s.1 k))) V,
    inf_iInf]

private noncomputable def restrictedModuleSectionEquiv
    (F : X.Modules) (p : ℕ) (s : CechCochains.OrdIndex (I := Fin c) p)
    (V : X.Opens) :
    Γ(restrictedModule f F p s, V) ≃+
      Γ(F, CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1) := by
  let i := (equationsOpen f p s).ι
  have h : i ''ᵁ (i ⁻¹ᵁ V) =
      CechCochains.inter (fun j => V ⊓ X.basicOpen (f j)) s.1 :=
    (image_preimage_ι_eq_inf _ V).trans (inter_basicOpen_eq f p s V).symm
  exact ((((asIso (((Scheme.Modules.restrictFunctorIsoPullback i).inv.app F).app
      (i ⁻¹ᵁ V))).addCommGroupIsoToAddEquiv).trans
    (F.restrictAppIso i (i ⁻¹ᵁ V)).addCommGroupIsoToAddEquiv).trans
    ((F.presheaf.mapIso (eqToIso h).symm.op).addCommGroupIsoToAddEquiv))

private lemma presheaf_addEquiv_eqToIso (F : X.Modules) (A B : X.Opens)
    (open_eq : A = B) :
    (F.presheaf.mapIso (eqToIso open_eq).symm.op).addCommGroupIsoToAddEquiv =
      (show Γ(F, A) ≃+ Γ(F, B) from by rw [← open_eq]) := by
  subst B
  ext section_value
  simp

private lemma restrictedModuleSectionEquiv_toAddMonoidHom
    (F : X.Modules) (p : ℕ) (s : CechCochains.OrdIndex (I := Fin c) p) (V : X.Opens) :
    (restrictedModuleSectionEquiv f F p s V).toAddMonoidHom =
      restrictedModuleSection f F p s V := by
  unfold restrictedModuleSectionEquiv restrictedModuleSection
  dsimp only
  rw [presheaf_addEquiv_eqToIso]
  rfl

/-- Data of the extended alternating Čech complex. The sectionwise isomorphisms
identify every differential with the ordinary alternating restriction formula. -/
public structure Data (F : X.Modules) where
  /-- The underlying cochain complex of `𝒪_X`-modules. -/
  complex : CochainComplex X.Modules ℕ
  /-- The degree-zero term is isomorphic to `F`. -/
  zeroIso : complex.X 0 ≅ F
  /-- The degree-`p + 1` term is the product of the restricted modules indexed by
  `CechCochains.OrdIndex p`. -/
  termIso (p : ℕ) : complex.X (p + 1) ≅
    ∏ᶜ fun s : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p s
  sectionsIso (p : ℕ) (V : X.Opens) :
    Γ(complex.X (p + 1), V) ≃+
      CechCochains.OrdCochain (fun i => V ⊓ X.basicOpen (f i))
        (Scheme.Modules.presheaf F) p
  sectionsIso_compat (p : ℕ) (V : X.Opens)
      (x : Γ(complex.X (p + 1), V))
      (s : CechCochains.OrdIndex (I := Fin c) p) :
    sectionsIso p V x s =
      restrictedModuleSection f F p s V
        (((termIso p).hom ≫ Pi.π _ s).app V x)
  differential_zero (V : X.Opens) (x : Γ(complex.X 0, V))
      (s : CechCochains.OrdIndex (I := Fin c) 0) :
    sectionsIso 0 V ((complex.d 0 1).app V x) s =
      (Scheme.Modules.presheaf F).map
        (homOfLE (show
          CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1 ≤ V from
            (iInf_le _ (0 : Fin 1)).trans inf_le_left)).op
          ((zeroIso.hom).app V x)
  differential_succ (p : ℕ) (V : X.Opens)
      (x : Γ(complex.X (p + 1), V)) :
    sectionsIso (p + 1) V ((complex.d (p + 1) (p + 2)).app V x) =
      CechCochains.ordD (fun i => V ⊓ X.basicOpen (f i))
        (Scheme.Modules.presheaf F) p (sectionsIso p V x)

/-- The extended complex is natural in its coefficient module. The component
formula says that its map is the componentwise map of restricted sections. -/
public structure FunctorData where
  /-- The extended alternating Čech complex of each module `F`. -/
  obj (F : X.Modules) : Data f F
  /-- The morphism of complexes induced by a morphism of modules. -/
  map {F G : X.Modules} (φ : F ⟶ G) : (obj F).complex ⟶ (obj G).complex
  map_id (F : X.Modules) : map (𝟙 F) = 𝟙 (obj F).complex
  map_comp {F G H : X.Modules} (φ : F ⟶ G) (ψ : G ⟶ H) :
    map (φ ≫ ψ) = map φ ≫ map ψ
  map_zero {F G : X.Modules} (φ : F ⟶ G) :
    (map φ).f 0 ≫ (obj G).zeroIso.hom = (obj F).zeroIso.hom ≫ φ
  map_sections {F G : X.Modules} (φ : F ⟶ G) (p : ℕ)
      (V : X.Opens) (x : Γ((obj F).complex.X (p + 1), V))
      (s : CechCochains.OrdIndex (I := Fin c) p) :
    (obj G).sectionsIso p V (((map φ).f (p + 1)).app V x) s =
      φ.app (CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1)
        ((obj F).sectionsIso p V x s)

private noncomputable def openDirectImageSectionImageEquiv
    (U V : X.Opens) (F : X.Modules) :
    Γ(F, U.ι ''ᵁ U.ι ⁻¹ᵁ V) ≃+ Γ(F, U ⊓ V) := by
  exact (F.presheaf.mapIso (eqToIso (image_preimage_ι_eq_inf U V)).symm.op
    ).addCommGroupIsoToAddEquiv

private noncomputable def openDirectImageSection
    (U : X.Opens) (F : X.Modules) (V : X.Opens) :
    Γ((Scheme.Modules.pushforward U.ι).obj
        ((Scheme.Modules.pullback U.ι).obj F), V) →+
      Γ(F, U ⊓ V) :=
  (openDirectImageSectionImageEquiv U V F).toAddMonoidHom.comp
    ((F.restrictAppIso U.ι (U.ι ⁻¹ᵁ V)).hom.hom.comp
      (((Scheme.Modules.restrictFunctorIsoPullback U.ι).inv.app F).app
        (U.ι ⁻¹ᵁ V)).hom)

private lemma openDirectImageSectionImageEquiv_apply
    (U V : X.Opens) (F : X.Modules)
    (x : Γ(F, U.ι ''ᵁ U.ι ⁻¹ᵁ V)) :
    (openDirectImageSectionImageEquiv U V F).toAddMonoidHom x =
      F.presheaf.map (eqToHom (image_preimage_ι_eq_inf U V).symm).op x := by
  simp [openDirectImageSectionImageEquiv, eqToHom_map]

/-- The sectionwise formula for `openDirectImageSection`: restrict along the inclusion, read the
result as a section over the image open, and transport along the equality of opens. -/
private lemma openDirectImageSection_apply
    (U : X.Opens) (F : X.Modules) (V : X.Opens)
    (x : Γ((Scheme.Modules.pushforward U.ι).obj
      ((Scheme.Modules.pullback U.ι).obj F), V)) :
    openDirectImageSection U F V x =
      F.presheaf.map (eqToHom (image_preimage_ι_eq_inf U V).symm).op
        ((F.restrictAppIso U.ι (U.ι ⁻¹ᵁ V)).hom.hom
          ((((Scheme.Modules.restrictFunctorIsoPullback U.ι).inv.app F).app
            (U.ι ⁻¹ᵁ V)).hom x)) := by
  show (openDirectImageSectionImageEquiv U V F).toAddMonoidHom
      ((F.restrictAppIso U.ι (U.ι ⁻¹ᵁ V)).hom.hom
        ((((Scheme.Modules.restrictFunctorIsoPullback U.ι).inv.app F).app
          (U.ι ⁻¹ᵁ V)).hom x)) = _
  rw [openDirectImageSectionImageEquiv_apply]

private lemma restrictedModuleSectionEquiv_openDirectImageSection
    (F : X.Modules) (p : ℕ) (s : CechCochains.OrdIndex (I := Fin c) p)
    (V : X.Opens) (x : Γ(restrictedModule f F p s, V)) :
    restrictedModuleSectionEquiv f F p s V x =
      F.presheaf.map (eqToHom (inter_basicOpen_eq f p s V)).op
        (openDirectImageSection (equationsOpen f p s) F V x) := by
  have h₁ : (equationsOpen f p s).ι ''ᵁ ((equationsOpen f p s).ι ⁻¹ᵁ V) =
      CechCochains.inter (fun j => V ⊓ X.basicOpen (f j)) s.1 :=
    (image_preimage_ι_eq_inf _ V).trans (inter_basicOpen_eq f p s V).symm
  let y : Γ((Scheme.Modules.pullback (equationsOpen f p s).ι).obj F,
      (equationsOpen f p s).ι ⁻¹ᵁ V) := by
    simpa only [restrictedModule, Scheme.Modules.pushforward_obj_obj] using x
  simp only [restrictedModuleSectionEquiv]
  show F.presheaf.map (eqToHom h₁.symm).op
      ((F.restrictAppIso (equationsOpen f p s).ι
          ((equationsOpen f p s).ι ⁻¹ᵁ V)).hom.hom
        (((Scheme.Modules.restrictFunctorIsoPullback (equationsOpen f p s).ι).inv.app F).app
          ((equationsOpen f p s).ι ⁻¹ᵁ V) y)) = _
  rw [openDirectImageSection_apply, ← F.presheaf.map_comp_apply]
  congr 1

private lemma restrictPullback_section_cancel
    (U : X.Opens) (F : X.Modules) (V : U.toScheme.Opens)
    (x : Γ((Scheme.Modules.restrictFunctor U.ι).obj F, V)) :
    ((Scheme.Modules.restrictFunctorIsoPullback U.ι).inv.app F).app V
      (((Scheme.Modules.restrictFunctorIsoPullback U.ι).hom.app F).app V x) = x := by
  have h := (Scheme.Modules.restrictFunctorIsoPullback U.ι).hom_inv_id_app F
  have h' := congrArg (fun φ => φ.app V) h
  rw [Scheme.Modules.Hom.comp_app, Scheme.Modules.Hom.id_app] at h'
  exact congrArg (fun φ => φ.hom x) h'

private lemma restrictPullbackIso_module_inv_naturality
    {Y Z : Scheme} (j : Y ⟶ Z) [IsOpenImmersion j]
    {M N : Z.Modules} (φ : M ⟶ N) (A : Y.Opens) :
    ((Scheme.Modules.pullback j).map φ).app A ≫
        ((Scheme.Modules.restrictFunctorIsoPullback j).inv.app N).app A =
      ((Scheme.Modules.restrictFunctorIsoPullback j).inv.app M).app A ≫
        ((Scheme.Modules.restrictFunctor j).map φ).app A := by
  have h := congrArg (fun θ => θ.app A)
    (NatIso.naturality_1 (Scheme.Modules.restrictFunctorIsoPullback j) φ)
  simp only [Scheme.Modules.Hom.comp_app] at h
  calc
    _ = (((Scheme.Modules.restrictFunctorIsoPullback j).inv.app M).app A ≫
          ((Scheme.Modules.restrictFunctor j).map φ).app A) ≫
        (((Scheme.Modules.restrictFunctorIsoPullback j).hom.app N).app A ≫
          ((Scheme.Modules.restrictFunctorIsoPullback j).inv.app N).app A) := by
      rw [← h]
      simp only [Category.assoc]
    _ = _ := by simp

private lemma restrictAppIso_moduleMap_naturality
    {Y Z : Scheme} (j : Y ⟶ Z) [IsOpenImmersion j]
    {M N : Z.Modules} (φ : M ⟶ N) (A : Y.Opens) :
    ((Scheme.Modules.restrictFunctor j).map φ).app A ≫
        (N.restrictAppIso j A).hom =
      (M.restrictAppIso j A).hom ≫ φ.app (j ''ᵁ A) :=
  rfl

private noncomputable def openDirectImageRestrictionCoreRestrict
    {U V : X.Opens} (hUV : U ≤ V) (F : X.Modules) :
    (Scheme.Modules.pushforward V.ι).obj ((Scheme.Modules.restrictFunctor V.ι).obj F) ⟶
      (Scheme.Modules.pushforward U.ι).obj ((Scheme.Modules.restrictFunctor U.ι).obj F) := by
  let k : U.toScheme ⟶ V.toScheme := X.homOfLE hUV
  have hk : k ≫ V.ι = U.ι := Scheme.homOfLE_ι X hUV
  exact (Scheme.Modules.pushforward V.ι).map
        ((Scheme.Modules.restrictAdjunction k).unit.app
          ((Scheme.Modules.restrictFunctor V.ι).obj F)) ≫
      (Scheme.Modules.pushforwardComp k V.ι).hom.app
        ((Scheme.Modules.restrictFunctor k).obj ((Scheme.Modules.restrictFunctor V.ι).obj F)) ≫
      (Scheme.Modules.pushforward (k ≫ V.ι)).map
        ((Scheme.Modules.restrictFunctorComp k V.ι).inv.app F) ≫
      (Scheme.Modules.pushforwardCongr hk).hom.app
        ((Scheme.Modules.restrictFunctor (k ≫ V.ι)).obj F) ≫
      (Scheme.Modules.pushforward U.ι).map
        ((Scheme.Modules.restrictFunctorCongr hk).hom.app F)

private noncomputable def openDirectImageRestrictionCore
    {U V : X.Opens} (hUV : U ≤ V) (F : X.Modules) :
    (Scheme.Modules.pushforward V.ι).obj
        ((Scheme.Modules.pullback V.ι).obj F) ⟶
      (Scheme.Modules.pushforward U.ι).obj
        ((Scheme.Modules.restrictFunctor U.ι).obj F) := by
  exact
    (Scheme.Modules.pushforward V.ι).map
        ((Scheme.Modules.restrictFunctorIsoPullback V.ι).inv.app F) ≫
      openDirectImageRestrictionCoreRestrict hUV F

private noncomputable def openDirectImageRestriction
    {U V : X.Opens} (hUV : U ≤ V) (F : X.Modules) :
    (Scheme.Modules.pushforward V.ι).obj
        ((Scheme.Modules.pullback V.ι).obj F) ⟶
      (Scheme.Modules.pushforward U.ι).obj
        ((Scheme.Modules.pullback U.ι).obj F) :=
  openDirectImageRestrictionCore hUV F ≫
    (Scheme.Modules.pushforward U.ι).map
      ((Scheme.Modules.restrictFunctorIsoPullback U.ι).hom.app F)

private noncomputable def openDirectImageUnit
    (U : X.Opens) (F : X.Modules) :
    F ⟶ (Scheme.Modules.pushforward U.ι).obj
      ((Scheme.Modules.pullback U.ι).obj F) :=
  (Scheme.Modules.restrictAdjunction U.ι).unit.app F ≫
    (Scheme.Modules.pushforward U.ι).map
      ((Scheme.Modules.restrictFunctorIsoPullback U.ι).hom.app F)

private lemma openDirectImageSection_pushforwardIsoHom
    (U W : X.Opens) (F : X.Modules)
    (x : Γ((Scheme.Modules.restrictFunctor U.ι).obj F, U.ι ⁻¹ᵁ W)) :
    openDirectImageSection U F W
        (((Scheme.Modules.pushforward U.ι).map
          ((Scheme.Modules.restrictFunctorIsoPullback U.ι).hom.app F)).app W x) =
      (openDirectImageSectionImageEquiv U W F).toAddMonoidHom
        ((F.restrictAppIso U.ι (U.ι ⁻¹ᵁ W)).hom.hom x) := by
  show (openDirectImageSectionImageEquiv U W F).toAddMonoidHom
      ((F.restrictAppIso U.ι (U.ι ⁻¹ᵁ W)).hom.hom
        (((Scheme.Modules.restrictFunctorIsoPullback U.ι).inv.app F).app
          (U.ι ⁻¹ᵁ W)
          (((Scheme.Modules.restrictFunctorIsoPullback U.ι).hom.app F).app
            (U.ι ⁻¹ᵁ W) x))) = _
  rw [restrictPullback_section_cancel]

private lemma openDirectImageUnit_section
    (U W : X.Opens) (F : X.Modules) (x : Γ(F, W)) :
    openDirectImageSection U F W ((openDirectImageUnit U F).app W x) =
      F.presheaf.map (homOfLE (show U ⊓ W ≤ W from inf_le_right)).op x := by
  let y : Γ((Scheme.Modules.restrictFunctor U.ι).obj F, U.ι ⁻¹ᵁ W) :=
    (((Scheme.Modules.restrictAdjunction U.ι).unit.app F).app W) x
  have hy : y = F.presheaf.map (homOfLE (U.ι.image_preimage_le W)).op x := by
    simp only [y, Scheme.Modules.restrictAdjunction_unit_app_app]
    rfl
  show openDirectImageSection U F W
      (((Scheme.Modules.pushforward U.ι).map
          ((Scheme.Modules.restrictFunctorIsoPullback U.ι).hom.app F)).app W y) = _
  rw [openDirectImageSection_pushforwardIsoHom]
  rw [hy]
  rw [openDirectImageSectionImageEquiv_apply]
  simp only [Scheme.Modules.restrictAppIso, Iso.refl_hom]
  show F.presheaf.map (eqToHom (image_preimage_ι_eq_inf U W).symm).op
      (F.presheaf.map (homOfLE (U.ι.image_preimage_le W)).op x) =
    F.presheaf.map (homOfLE (show U ⊓ W ≤ W from inf_le_right)).op x
  rw [← F.presheaf.map_comp_apply]
  congr 1

/-- A morphism of modules commutes with restriction maps of sections. -/
private lemma moduleMap_presheaf_map {F G : X.Modules} (φ : F ⟶ G)
    {U V : X.Opens} (i : op V ⟶ op U) (x : Γ(F, V)) :
    G.presheaf.map i (φ.app V x) = φ.app U (F.presheaf.map i x) :=
  (congrArg (fun morphism => morphism x) (φ.mapPresheaf.naturality i)).symm

private lemma openDirectImageSection_moduleMap
    {U : X.Opens} {F G : X.Modules} (φ : F ⟶ G) (W : X.Opens)
    (x : Γ((Scheme.Modules.pushforward U.ι).obj
      ((Scheme.Modules.pullback U.ι).obj F), W)) :
    openDirectImageSection U G W
        ((((Scheme.Modules.pushforward U.ι).map
          ((Scheme.Modules.pullback U.ι).map φ)).app W) x) =
      φ.app (U ⊓ W) (openDirectImageSection U F W x) := by
  let x' : Γ((Scheme.Modules.pullback U.ι).obj F, U.ι ⁻¹ᵁ W) := by
    simpa only [Scheme.Modules.pushforward_obj_obj] using x
  have hxx : x' = x := rfl
  have hI : U ⊓ W = U.ι ''ᵁ (U.ι ⁻¹ᵁ W) := (image_preimage_ι_eq_inf U W).symm
  have h₁ :
      (((Scheme.Modules.restrictFunctorIsoPullback U.ι).inv.app G).app (U.ι ⁻¹ᵁ W))
          ((((Scheme.Modules.pullback U.ι).map φ).app (U.ι ⁻¹ᵁ W)) x') =
        (((Scheme.Modules.restrictFunctor U.ι).map φ).app (U.ι ⁻¹ᵁ W))
          ((((Scheme.Modules.restrictFunctorIsoPullback U.ι).inv.app F).app
            (U.ι ⁻¹ᵁ W)) x') :=
    congrArg (fun g => g x')
      (restrictPullbackIso_module_inv_naturality U.ι φ (U.ι ⁻¹ᵁ W))
  have h₂ (y : Γ((Scheme.Modules.restrictFunctor U.ι).obj F, U.ι ⁻¹ᵁ W)) :
      (G.restrictAppIso U.ι (U.ι ⁻¹ᵁ W)).hom
          ((((Scheme.Modules.restrictFunctor U.ι).map φ).app (U.ι ⁻¹ᵁ W)) y) =
        φ.app (U.ι ''ᵁ (U.ι ⁻¹ᵁ W)) ((F.restrictAppIso U.ι (U.ι ⁻¹ᵁ W)).hom y) :=
    congrArg (fun g => g y) (restrictAppIso_moduleMap_naturality U.ι φ (U.ι ⁻¹ᵁ W))
  rw [openDirectImageSection_apply, openDirectImageSection_apply]
  simp only [Scheme.Modules.pushforward_map_app]
  rw [← hxx]
  show G.presheaf.map (eqToHom hI).op
      ((G.restrictAppIso U.ι (U.ι ⁻¹ᵁ W)).hom
        ((((Scheme.Modules.restrictFunctorIsoPullback U.ι).inv.app G).app (U.ι ⁻¹ᵁ W))
          ((((Scheme.Modules.pullback U.ι).map φ).app (U.ι ⁻¹ᵁ W)) x'))) =
    φ.app (U ⊓ W)
      (F.presheaf.map (eqToHom hI).op
        ((F.restrictAppIso U.ι (U.ι ⁻¹ᵁ W)).hom
          ((((Scheme.Modules.restrictFunctorIsoPullback U.ι).inv.app F).app
            (U.ι ⁻¹ᵁ W)) x')))
  rw [h₁, h₂]
  exact moduleMap_presheaf_map φ _ _

private lemma imagePreimage_mono {U V : X.Opens} (hUV : U ≤ V) (W : X.Opens) :
    U.ι ''ᵁ (U.ι ⁻¹ᵁ W) ≤ V.ι ''ᵁ (V.ι ⁻¹ᵁ W) := by
  rw [image_preimage_ι_eq_inf, image_preimage_ι_eq_inf]
  exact inf_le_inf_right _ hUV

private lemma restrictAppIso_hom_apply_clean {Y Z : Scheme.{u}} (g : Y ⟶ Z)
    [IsOpenImmersion g] (M : Z.Modules) (A : Y.Opens) (z : Γ(M, g ''ᵁ A)) :
    (M.restrictAppIso g A).hom.hom z = z := rfl

private lemma coreRestrict_clean {U V W : X.Opens} (hUV : U ≤ V) (F : X.Modules)
    (x : Γ((Scheme.Modules.pushforward V.ι).obj
        ((Scheme.Modules.restrictFunctor V.ι).obj F), W)) :
    (F.restrictAppIso U.ι (U.ι ⁻¹ᵁ W)).hom.hom
        (((openDirectImageRestrictionCoreRestrict hUV F).app W) x) =
      F.presheaf.map (homOfLE (imagePreimage_mono hUV W)).op
        ((F.restrictAppIso V.ι (V.ι ⁻¹ᵁ W)).hom.hom x) := by
  have hk : X.homOfLE hUV ≫ V.ι = U.ι := Scheme.homOfLE_ι X hUV
  have hpre : U.ι ⁻¹ᵁ W = (X.homOfLE hUV ≫ V.ι) ⁻¹ᵁ W := by rw [hk]
  have h₁ : V.ι ''ᵁ (X.homOfLE hUV ''ᵁ (X.homOfLE hUV ⁻¹ᵁ (V.ι ⁻¹ᵁ W))) ≤
      V.ι ''ᵁ (V.ι ⁻¹ᵁ W) :=
    V.ι.image_mono ((X.homOfLE hUV).image_preimage_le _)
  have h₃ : (X.homOfLE hUV ≫ V.ι) ''ᵁ ((X.homOfLE hUV ≫ V.ι) ⁻¹ᵁ W) ≤
      V.ι ''ᵁ (X.homOfLE hUV ''ᵁ (X.homOfLE hUV ⁻¹ᵁ (V.ι ⁻¹ᵁ W))) :=
    le_of_eq (by simp only [Scheme.Hom.comp_image, Scheme.Hom.comp_preimage])
  have h₄ : (X.homOfLE hUV ≫ V.ι) ''ᵁ (U.ι ⁻¹ᵁ W) ≤
      (X.homOfLE hUV ≫ V.ι) ''ᵁ ((X.homOfLE hUV ≫ V.ι) ⁻¹ᵁ W) :=
    (X.homOfLE hUV ≫ V.ι).image_mono (le_of_eq hpre)
  have h₅ : U.ι ''ᵁ (U.ι ⁻¹ᵁ W) ≤ (X.homOfLE hUV ≫ V.ι) ''ᵁ (U.ι ⁻¹ᵁ W) :=
    le_of_eq (by simp only [hk])
  show F.presheaf.map (homOfLE h₅).op (F.presheaf.map (homOfLE h₄).op
      (F.presheaf.map (homOfLE h₃).op (F.presheaf.map (homOfLE h₁).op
        ((F.restrictAppIso V.ι (V.ι ⁻¹ᵁ W)).hom.hom x)))) = _
  simp only [← F.presheaf.map_comp_apply]
  rfl

private lemma openDirectImageRestrictionCoreRestrict_section
    {U V W : X.Opens} (hUV : U ≤ V) (F : X.Modules)
    (x : Γ((Scheme.Modules.pushforward V.ι).obj
        ((Scheme.Modules.restrictFunctor V.ι).obj F), W)) :
    (openDirectImageSectionImageEquiv U W F).toAddMonoidHom
        ((F.restrictAppIso U.ι (U.ι ⁻¹ᵁ W)).hom.hom
          (((openDirectImageRestrictionCoreRestrict hUV F).app W) x)) =
    F.presheaf.map (homOfLE (show U ⊓ W ≤ V ⊓ W from inf_le_inf_right _ hUV)).op
        ((openDirectImageSectionImageEquiv V W F).toAddMonoidHom
          ((F.restrictAppIso V.ι (V.ι ⁻¹ᵁ W)).hom.hom x)) := by
  rw [openDirectImageSectionImageEquiv_apply, openDirectImageSectionImageEquiv_apply,
    coreRestrict_clean]
  simp only [← F.presheaf.map_comp_apply]
  rfl

private lemma openDirectImageRestrictionCore_section
    {U V W : X.Opens} (hUV : U ≤ V) (F : X.Modules)
    (x : Γ((Scheme.Modules.pushforward V.ι).obj
        ((Scheme.Modules.pullback V.ι).obj F), W)) :
    (openDirectImageSectionImageEquiv U W F).toAddMonoidHom
        ((F.restrictAppIso U.ι (U.ι ⁻¹ᵁ W)).hom.hom
          (((openDirectImageRestrictionCore hUV F).app W) x)) =
      F.presheaf.map (homOfLE (show U ⊓ W ≤ V ⊓ W from inf_le_inf_right _ hUV)).op
        (openDirectImageSection V F W x) := by
  let z : Γ((Scheme.Modules.pushforward V.ι).obj
      ((Scheme.Modules.restrictFunctor V.ι).obj F), W) :=
    (((Scheme.Modules.pushforward V.ι).map
      ((Scheme.Modules.restrictFunctorIsoPullback V.ι).inv.app F)).app W) x
  show (openDirectImageSectionImageEquiv U W F).toAddMonoidHom
      ((F.restrictAppIso U.ι (U.ι ⁻¹ᵁ W)).hom.hom
        (((openDirectImageRestrictionCoreRestrict hUV F).app W) z)) =
      F.presheaf.map (homOfLE (show U ⊓ W ≤ V ⊓ W from inf_le_inf_right _ hUV)).op
      ((openDirectImageSectionImageEquiv V W F).toAddMonoidHom
        ((F.restrictAppIso V.ι (V.ι ⁻¹ᵁ W)).hom.hom z))
  exact openDirectImageRestrictionCoreRestrict_section hUV F z

private lemma openDirectImageRestriction_section
    {U V W : X.Opens} (hUV : U ≤ V) (F : X.Modules)
    (x : Γ((Scheme.Modules.pushforward V.ι).obj
        ((Scheme.Modules.pullback V.ι).obj F), W)) :
    openDirectImageSection U F W
        (((openDirectImageRestriction hUV F).app W) x) =
      F.presheaf.map (homOfLE (show U ⊓ W ≤ V ⊓ W from inf_le_inf_right _ hUV)).op
        (openDirectImageSection V F W x) := by
  show openDirectImageSection U F W
      ((((Scheme.Modules.pushforward U.ι).map
        ((Scheme.Modules.restrictFunctorIsoPullback U.ι).hom.app F)).app W)
        (((openDirectImageRestrictionCore hUV F).app W) x)) = _
  calc
    _ = (openDirectImageSectionImageEquiv U W F).toAddMonoidHom
          ((F.restrictAppIso U.ι (U.ι ⁻¹ᵁ W)).hom.hom
            (((openDirectImageRestrictionCore hUV F).app W) x)) :=
      openDirectImageSection_pushforwardIsoHom U W F
        (((openDirectImageRestrictionCore hUV F).app W) x)
    _ = F.presheaf.map
          (homOfLE (show U ⊓ W ≤ V ⊓ W from inf_le_inf_right _ hUV)).op
          (openDirectImageSection V F W x) := openDirectImageRestrictionCore_section hUV F x

@[reducible]
private noncomputable def term (F : X.Modules) : ℕ → X.Modules
  | 0 => F
  | p + 1 => ∏ᶜ fun s : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p s

private lemma sections_preservesFiniteLimits (V : X.Opens) :
    PreservesFiniteLimits (secF X.ringCatSheaf V : X.Modules ⥤ AddCommGrpCat.{u}) := by
  show PreservesFiniteLimits
    (SheafOfModules.evaluation X.ringCatSheaf (op V) ⋙
      forget₂ (ModuleCat.{u} ((X.ringCatSheaf).obj.obj (op V))) AddCommGrpCat.{u})
  infer_instance

private noncomputable def categoricalProductAddEquiv {ι : Type 0}
    (G : ι → AddCommGrpCat.{u}) [HasProduct G] :
    (∏ᶜ G).carrier ≃+ ∀ i, (G i).carrier :=
  (IsLimit.conePointUniqueUpToIso (limit.isLimit (Discrete.functor G))
    (AddCommGrpCat.HasLimit.productLimitCone G).isLimit).addCommGroupIsoToAddEquiv

private lemma categoricalProductAddEquiv_apply {ι : Type 0}
    (G : ι → AddCommGrpCat.{u}) [HasProduct G]
    (x : (∏ᶜ G).carrier) (i : ι) :
    categoricalProductAddEquiv G x i = (Pi.π G i) x := by
  let P := limit.isLimit (Discrete.functor G)
  let Q := (AddCommGrpCat.HasLimit.productLimitCone G).isLimit
  show ((IsLimit.conePointUniqueUpToIso P Q).hom x) i = _
  have h := IsLimit.conePointUniqueUpToIso_hom_comp P Q (Discrete.mk i)
  have hx := congrArg (fun g : (∏ᶜ G) ⟶ G i => g.hom x) h
  show ((IsLimit.conePointUniqueUpToIso P Q).hom.hom x) i =
    (limit.π (Discrete.functor G) (Discrete.mk i)).hom x
  exact hx

private noncomputable def productSectionsEquiv {ι : Type 0} [Finite ι] (G : ι → X.Modules)
    (V : X.Opens) : Γ(∏ᶜ G, V) ≃+ ∀ i, Γ(G i, V) := by
  let ΓV := secF X.ringCatSheaf V
  letI : PreservesFiniteLimits ΓV := sections_preservesFiniteLimits (X := X) V
  exact ((PreservesProduct.iso ΓV G).addCommGroupIsoToAddEquiv).trans
    (categoricalProductAddEquiv fun i => ΓV.obj (G i))

private lemma productSectionsEquiv_apply {ι : Type 0} [Finite ι] (G : ι → X.Modules)
    (V : X.Opens) (x : Γ(∏ᶜ G, V)) (i : ι) :
    productSectionsEquiv G V x i = (Pi.π G i).app V x := by
  let ΓV := secF X.ringCatSheaf V
  let _ : PreservesFiniteLimits ΓV := sections_preservesFiniteLimits (X := X) V
  show categoricalProductAddEquiv (fun j => ΓV.obj (G j))
      ((PreservesProduct.iso ΓV G).hom x) i = _
  rw [categoricalProductAddEquiv_apply]
  show ((PreservesProduct.iso ΓV G).hom ≫ Pi.π _ i) x = _
  show (piComparison ΓV G ≫ Pi.π _ i) x = _
  have h := congrArg (fun g : _ ⟶ ΓV.obj (G i) => g x)
    (piComparison_comp_π ΓV G i)
  exact h.trans rfl

private noncomputable def positiveTermSectionsEquiv (F : X.Modules) (p : ℕ)
    (V : X.Opens) :
    Γ(term f F (p + 1), V) ≃+
      CechCochains.OrdCochain (fun i => V ⊓ X.basicOpen (f i))
        (Scheme.Modules.presheaf F) p := by
  let G : CechCochains.OrdIndex (I := Fin c) p → X.Modules :=
    fun s => restrictedModule f F p s
  change Γ(∏ᶜ G, V) ≃+ _
  exact (productSectionsEquiv G V).trans
    (AddEquiv.piCongrRight fun s => restrictedModuleSectionEquiv f F p s V)

private lemma positiveTermSectionsEquiv_apply (F : X.Modules) (p : ℕ)
    (V : X.Opens) (x : Γ(term f F (p + 1), V))
    (s : CechCochains.OrdIndex (I := Fin c) p) :
    positiveTermSectionsEquiv f F p V x s =
      restrictedModuleSectionEquiv f F p s V
        ((Pi.π (fun t : CechCochains.OrdIndex (I := Fin c) p =>
          restrictedModule f F p t) s).app V x) := by
  show (AddEquiv.piCongrRight
      (fun t => restrictedModuleSectionEquiv f F p t V)
      (productSectionsEquiv (fun t : CechCochains.OrdIndex (I := Fin c) p =>
        restrictedModule f F p t) V x)) s = _
  rw [AddEquiv.piCongrRight_apply]
  show restrictedModuleSectionEquiv f F p s V
      ((productSectionsEquiv (fun t : CechCochains.OrdIndex (I := Fin c) p =>
        restrictedModule f F p t) V) (show Γ(∏ᶜ (fun t : CechCochains.OrdIndex (I := Fin c) p =>
          restrictedModule f F p t), V) from x) s) = _
  rw [productSectionsEquiv_apply]

private lemma equationsOpen_face_le (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) (p + 1)) (j : Fin (p + 2)) :
    equationsOpen f (p + 1) s ≤
      equationsOpen f p ⟨s.1 ∘ j.succAbove, CechCochains.strictMono_omit s.2 j⟩ := by
  unfold equationsOpen
  exact le_iInf fun k => iInf_le _ (j.succAbove k)

private noncomputable def positiveDifferential (F : X.Modules)
    (p : ℕ) : term f F (p + 1) ⟶ term f F ((p + 1) + 1) :=
  Pi.lift fun s : CechCochains.OrdIndex (I := Fin c) (p + 1) =>
    ∑ j : Fin (p + 2),
      ((-1 : ℤ) ^ (j : ℕ)) •
        (Pi.π (fun t : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p t)
            ⟨s.1 ∘ j.succAbove, CechCochains.strictMono_omit s.2 j⟩ ≫
          openDirectImageRestriction (equationsOpen_face_le f p s j) F)

private noncomputable def differential (F : X.Modules) (p : ℕ) :
    term f F p ⟶ term f F (p + 1) := by
  cases p with
  | zero =>
      change F ⟶ ∏ᶜ fun s : CechCochains.OrdIndex (I := Fin c) 0 =>
        (Scheme.Modules.pushforward (equationsOpen f 0 s).ι).obj
          ((Scheme.Modules.pullback (equationsOpen f 0 s).ι).obj F)
      simpa only [term, restrictedModule] using
        (Pi.lift fun s => openDirectImageUnit (equationsOpen f 0 s) F)
  | succ p =>
      simpa only [term, Nat.add_one] using (positiveDifferential f F p)

private lemma differential_zero_eq (F : X.Modules) :
    differential f F 0 =
      Pi.lift fun s => openDirectImageUnit (equationsOpen f 0 s) F := by
  rfl

private lemma differential_succ_eq (F : X.Modules) (p : ℕ) :
    differential f F (p + 1) = positiveDifferential f F p := by
  rfl

/-- The sectionwise formula for the restriction map of Tag 01FJ. -/
private lemma restr_apply {T : TopCat} (G : TopCat.Presheaf AddCommGrpCat T)
    {V W : Opens T} (h : W ≤ V) (y : G.obj (op V)) :
    CechCochains.restr G h y = G.map (homOfLE h).op y :=
  rfl

/-- The global-sections-over-`V` functor on modules, as a functor to abelian groups. -/
private noncomputable def sectionsFunctor (V : X.Opens) :
    X.Modules ⥤ AddCommGrpCat.{u} :=
  Scheme.Modules.toPresheaf X ⋙
    (evaluation (Opens (↑X.toPresheafedSpace))ᵒᵖ AddCommGrpCat.{u}).obj (op V)

private instance sectionsFunctor_additive (V : X.Opens) :
    (sectionsFunctor (X := X) V).Additive where
  map_add := rfl

private lemma addCommGrp_signedSum_apply {Index : Type*}
    {Source Target : AddCommGrpCat.{u}} (indices : Finset Index)
    (coefficient : Index → ℤ) (morphism : Index → (Source ⟶ Target))
    (section_value : Source) :
    (∑ index ∈ indices, coefficient index • morphism index) section_value =
      ∑ index ∈ indices, coefficient index • morphism index section_value := by
  classical
  induction indices using Finset.induction_on with
  | empty => simp
  | @insert index indices not_mem induction_hypothesis =>
      rw [Finset.sum_insert not_mem, Finset.sum_insert not_mem,
        AddCommGrpCat.hom_add_apply, induction_hypothesis]
      rfl

/-- A signed finite sum of morphisms of modules acts on sections term by term. -/
private lemma signedSum_app_apply {A B : X.Modules} {Index : Type*}
    (indices : Finset Index) (coefficient : Index → ℤ)
    (morphism : Index → (A ⟶ B)) (V : X.Opens) (x : Γ(A, V)) :
    ((∑ index ∈ indices, coefficient index • morphism index).app V) x =
      ∑ index ∈ indices, coefficient index • (((morphism index).app V) x) := by
  have hmap : ((∑ index ∈ indices, coefficient index • morphism index).app V) =
      (sectionsFunctor V).map (∑ index ∈ indices, coefficient index • morphism index) :=
    rfl
  rw [hmap, Functor.map_sum]
  simp only [Functor.map_zsmul]
  exact addCommGrp_signedSum_apply indices coefficient
    (fun index => (sectionsFunctor V).map (morphism index)) x

private lemma differential_succ_sections (F : X.Modules)
    (p : ℕ) (V : X.Opens)
    (x : Γ(term f F (p + 1), V)) :
    positiveTermSectionsEquiv f F (p + 1) V
      ((differential f F (p + 1)).app V x) =
    CechCochains.ordD (fun i => V ⊓ X.basicOpen (f i))
      (Scheme.Modules.presheaf F) p (positiveTermSectionsEquiv f F p V x) := by
  rw [differential_succ_eq]
  funext s
  rw [positiveTermSectionsEquiv_apply]
  show restrictedModuleSectionEquiv f F (p + 1) s V
      (((positiveDifferential f F p ≫
        Pi.π (fun t : CechCochains.OrdIndex (I := Fin c) (p + 1) =>
          restrictedModule f F (p + 1) t) s).app V) x) = _
  simp only [positiveDifferential, Pi.lift_comp_π]
  simp only [CechCochains.ordD, AddMonoidHom.coe_mk]
  rw [signedSum_app_apply]
  rw [map_sum]
  simp only [map_zsmul]
  apply Finset.sum_congr rfl
  intro omitted_index _
  congr 1
  rw [Scheme.Modules.Hom.comp_app, AddCommGrpCat.comp_apply,
    restrictedModuleSectionEquiv_openDirectImageSection,
    openDirectImageRestriction_section, restr_apply,
    positiveTermSectionsEquiv_apply, restrictedModuleSectionEquiv_openDirectImageSection]
  simp only [← F.presheaf.map_comp_apply]
  congr 1

private lemma differential_succ_sections_apply (F : X.Modules) (p : ℕ) (V : X.Opens)
    (x : Γ(term f F (p + 1), V)) (s : CechCochains.OrdIndex (I := Fin c) (p + 1)) :
    positiveTermSectionsEquiv f F (p + 1) V
        ((differential f F (p + 1)).app V x) s =
      ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
        CechCochains.restr (Scheme.Modules.presheaf F)
          (CechCochains.inter_le_omit (fun i => V ⊓ X.basicOpen (f i)) s.1 j)
          (positiveTermSectionsEquiv f F p V x
            ⟨s.1 ∘ j.succAbove, CechCochains.strictMono_omit s.2 j⟩) :=
  congrFun (differential_succ_sections f F p V x) s

private noncomputable def augmentedOrdCochain (F : X.Modules) (V : X.Opens)
    (x : Γ(F, V)) :
    CechCochains.OrdCochain (fun i => V ⊓ X.basicOpen (f i))
      (Scheme.Modules.presheaf F) 0 :=
  fun s => (Scheme.Modules.presheaf F).map
    (homOfLE (show CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1 ≤ V from
      (iInf_le _ (0 : Fin 1)).trans inf_le_left)).op x

private lemma augmentedOrdCochain_ordD_zero (F : X.Modules) (V : X.Opens)
    (x : Γ(F, V)) :
    CechCochains.ordD (fun i => V ⊓ X.basicOpen (f i))
      (Scheme.Modules.presheaf F) 0 (augmentedOrdCochain f F V x) = 0 := by
  funext s
  let W := CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1
  have hWV : W ≤ V := (iInf_le _ (0 : Fin (0 + 2))).trans inf_le_left
  have hface (j : Fin 2) :
      CechCochains.restr (Scheme.Modules.presheaf F)
          (CechCochains.inter_le_omit (fun i => V ⊓ X.basicOpen (f i)) s.1 j)
          (augmentedOrdCochain f F V x
            ⟨s.1 ∘ j.succAbove, CechCochains.strictMono_omit s.2 j⟩) =
        (Scheme.Modules.presheaf F).map (homOfLE hWV).op x := by
    simp only [restr_apply, augmentedOrdCochain]
    rw [← F.presheaf.map_comp_apply]
    congr 1
  show (∑ j : Fin 2,
      ((-1 : ℤ) ^ (j : ℕ)) •
        CechCochains.restr (Scheme.Modules.presheaf F)
          (CechCochains.inter_le_omit (fun i => V ⊓ X.basicOpen (f i)) s.1 j)
          (augmentedOrdCochain f F V x
            ⟨s.1 ∘ j.succAbove, CechCochains.strictMono_omit s.2 j⟩)) = 0
  rw [Fin.sum_univ_two]
  rw [hface 0, hface 1]
  simp

private lemma differential_zero_sections (F : X.Modules)
    (V : X.Opens) (x : Γ(F, V)) :
    positiveTermSectionsEquiv f F 0 V
      ((differential f F 0).app V x) =
    augmentedOrdCochain f F V x := by
  funext s
  rw [positiveTermSectionsEquiv_apply]
  rw [differential_zero_eq]
  show restrictedModuleSectionEquiv f F 0 s V
      (((Pi.lift (fun t : CechCochains.OrdIndex (I := Fin c) 0 =>
        openDirectImageUnit (equationsOpen f 0 t) F) ≫
        Pi.π (fun t : CechCochains.OrdIndex (I := Fin c) 0 =>
          (Scheme.Modules.pushforward (equationsOpen f 0 t).ι).obj
            ((Scheme.Modules.pullback (equationsOpen f 0 t).ι).obj F)) s).app V) x) = _
  rw [Pi.lift_comp_π]
  rw [restrictedModuleSectionEquiv_openDirectImageSection]
  rw [openDirectImageUnit_section]
  simp only [augmentedOrdCochain]
  rw [← F.presheaf.map_comp_apply]
  congr 1

private noncomputable def complex (F : X.Modules) :
    CochainComplex X.Modules ℕ :=
  CochainComplex.of (term f F) (differential f F) (fun n => by
      cases n with
      | zero =>
          apply SheafOfModules.hom_ext
          ext V x
          let W : X.Opens := V.unop
          apply (positiveTermSectionsEquiv f F 1 W).injective
          change positiveTermSectionsEquiv f F 1 W
              (((differential f F 1).app W)
                (((differential f F 0).app W) x)) = _
          rw [differential_succ_sections f F 0 W
            ((differential f F 0).app W x)]
          rw [differential_zero_sections f F W x]
          have h := augmentedOrdCochain_ordD_zero f F W x
          rw [h]
          change 0 = positiveTermSectionsEquiv f F 1 W 0
          simp
      | succ n =>
          apply SheafOfModules.hom_ext
          ext V x
          let W : X.Opens := V.unop
          apply (positiveTermSectionsEquiv f F (n + 2) W).injective
          change positiveTermSectionsEquiv f F (n + 2) W
              (((differential f F (n + 2)).app W)
                (((differential f F (n + 1)).app W) x)) = _
          rw [differential_succ_sections f F (n + 1) W
            ((differential f F (n + 1)).app W x)]
          rw [differential_succ_sections f F n W x]
          rw [CechCochains.ordD_ordD]
          change 0 = positiveTermSectionsEquiv f F (n + 2) W 0
          simp)

private lemma complex_d (F : X.Modules) (p : ℕ) :
    (complex f F).d p (p + 1) = differential f F p := by
  show CochainComplex.of.d (term f F) (differential f F) p (p + 1) = _
  exact CochainComplex.of_d _ _ p

private lemma sectionsIso_compat_aux (F : X.Modules) (p : ℕ) (V : X.Opens)
    (x : Γ(term f F (p + 1), V)) (s : CechCochains.OrdIndex (I := Fin c) p) :
    positiveTermSectionsEquiv f F p V x s =
      restrictedModuleSection f F p s V
        ((𝟙 (term f F (p + 1)) ≫
            Pi.π (fun t : CechCochains.OrdIndex (I := Fin c) p =>
              restrictedModule f F p t) s).app V x) := by
  rw [Category.id_comp, ← restrictedModuleSectionEquiv_toAddMonoidHom]
  exact positiveTermSectionsEquiv_apply f F p V x s

private noncomputable def dataFor (F : X.Modules) : Data f F := by
  refine {
  complex := complex f F
  zeroIso := Iso.refl F
  termIso p := Iso.refl _
  sectionsIso := positiveTermSectionsEquiv f F
  sectionsIso_compat := ?_
  differential_zero := ?_
  differential_succ := ?_ }
  · intro p V x s
    exact sectionsIso_compat_aux f F p V x s
  · intro V x s
    rw [complex_d]
    have h := differential_zero_sections f F V x
    exact congrArg (fun z => z s) h
  · intro p V x
    rw [complex_d]
    exact differential_succ_sections f F p V x

private noncomputable def restrictedModuleMap {F G : X.Modules} (φ : F ⟶ G)
    (p : ℕ) (s : CechCochains.OrdIndex (I := Fin c) p) :
    restrictedModule f F p s ⟶ restrictedModule f G p s :=
  (Scheme.Modules.pushforward (equationsOpen f p s).ι).map
    ((Scheme.Modules.pullback (equationsOpen f p s).ι).map φ)

private lemma restrictedModuleSectionEquiv_moduleMap
    {F G : X.Modules} (φ : F ⟶ G) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) (V : X.Opens)
    (x : Γ(restrictedModule f F p s, V)) :
    restrictedModuleSectionEquiv f G p s V
        (((restrictedModuleMap f φ p s).app V) x) =
    φ.app (CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1)
        (restrictedModuleSectionEquiv f F p s V x) := by
  let U := equationsOpen f p s
  let xD : Γ((Scheme.Modules.pushforward U.ι).obj
      ((Scheme.Modules.pullback U.ι).obj F), V) := x
  have hxx : xD = x := rfl
  rw [restrictedModuleSectionEquiv_openDirectImageSection,
    restrictedModuleSectionEquiv_openDirectImageSection, restrictedModuleMap, ← hxx]
  rw [openDirectImageSection_moduleMap, moduleMap_presheaf_map]

private lemma restrictedModuleMap_id (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) :
    restrictedModuleMap f (𝟙 F) p s = 𝟙 _ := by
  simp [restrictedModuleMap, restrictedModule]

private lemma restrictedModuleMap_comp {F G H : X.Modules}
    (φ : F ⟶ G) (ψ : G ⟶ H) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) :
    restrictedModuleMap f (φ ≫ ψ) p s =
      restrictedModuleMap f φ p s ≫ restrictedModuleMap f ψ p s := by
  simp [restrictedModuleMap]

private noncomputable def termMap {F G : X.Modules} (φ : F ⟶ G)
    (n : ℕ) : term f F n ⟶ term f G n := by
  cases n with
  | zero => exact φ
  | succ p =>
      change (∏ᶜ fun s : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p s) ⟶
        (∏ᶜ fun s : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f G p s)
      exact Pi.lift fun s => Pi.π _ s ≫ restrictedModuleMap f φ p s

private lemma termMap_succ {F G : X.Modules} (φ : F ⟶ G) (p : ℕ) :
    termMap f φ (p + 1) =
      Pi.lift fun s : CechCochains.OrdIndex (I := Fin c) p =>
        Pi.π (fun t : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p t) s ≫
          restrictedModuleMap f φ p s := by
  rfl

private lemma termMap_id (F : X.Modules) (n : ℕ) :
    termMap f (𝟙 F) n = 𝟙 _ := by
  cases n with
  | zero => rfl
  | succ p =>
      show (Pi.lift fun s : CechCochains.OrdIndex (I := Fin c) p =>
        Pi.π (fun t : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p t) s ≫
          restrictedModuleMap f (𝟙 F) p s) =
        𝟙 (∏ᶜ fun s : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p s)
      apply Pi.hom_ext
      intro s
      rw [Pi.lift_comp_π, restrictedModuleMap_id]
      simp only [Category.id_comp, Category.comp_id]

private lemma termMap_comp {F G H : X.Modules}
    (φ : F ⟶ G) (ψ : G ⟶ H) (n : ℕ) :
    termMap f (φ ≫ ψ) n = termMap f φ n ≫ termMap f ψ n := by
  cases n with
  | zero => rfl
  | succ p =>
      show (Pi.lift fun s : CechCochains.OrdIndex (I := Fin c) p =>
        Pi.π (fun t : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p t) s ≫
          restrictedModuleMap f (φ ≫ ψ) p s) =
        (Pi.lift fun s : CechCochains.OrdIndex (I := Fin c) p =>
          Pi.π (fun t : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p t) s ≫
            restrictedModuleMap f φ p s) ≫
          Pi.lift (fun s : CechCochains.OrdIndex (I := Fin c) p =>
            Pi.π (fun t : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f G p t) s ≫
              restrictedModuleMap f ψ p s)
      apply Pi.hom_ext
      intro s
      rw [Pi.lift_comp_π, restrictedModuleMap_comp]
      conv_rhs => rw [Category.assoc, Pi.lift_comp_π, ← Category.assoc, Pi.lift_comp_π]
      simp only [Category.assoc]

private lemma termMap_sections {F G : X.Modules}
    (φ : F ⟶ G) (p : ℕ) (V : X.Opens)
    (x : Γ(term f F (p + 1), V))
    (s : CechCochains.OrdIndex (I := Fin c) p) :
    positiveTermSectionsEquiv f G p V
        ((termMap f φ (p + 1)).app V x) s =
      φ.app (CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1)
        (positiveTermSectionsEquiv f F p V x s) := by
  rw [positiveTermSectionsEquiv_apply]
  show restrictedModuleSectionEquiv f G p s V
      (((termMap f φ (p + 1) ≫ Pi.π _ s).app V) x) = _
  rw [termMap_succ, Pi.lift_comp_π, Scheme.Modules.Hom.comp_app, AddCommGrpCat.comp_apply,
    restrictedModuleSectionEquiv_moduleMap, positiveTermSectionsEquiv_apply]

private lemma termMap_comm {F G : X.Modules} (φ : F ⟶ G) (n : ℕ) :
    termMap f φ n ≫ differential f G n =
      differential f F n ≫ termMap f φ (n + 1) := by
  apply Scheme.Modules.hom_ext
  intro V
  ext x
  apply (positiveTermSectionsEquiv f G n V).injective
  simp only [Scheme.Modules.Hom.comp_app, AddCommGrpCat.comp_apply]
  cases n with
  | zero =>
      show positiveTermSectionsEquiv f G 0 V
          ((differential f G 0).app V (φ.app V x)) = _
      rw [differential_zero_sections]
      funext s
      rw [termMap_sections, differential_zero_sections]
      exact moduleMap_presheaf_map φ _ x
  | succ p =>
      funext s
      rw [differential_succ_sections_apply, termMap_sections,
        differential_succ_sections_apply]
      simp only [restr_apply, map_sum, map_zsmul]
      refine Finset.sum_congr rfl fun omitted_index _ => ?_
      rw [termMap_sections, moduleMap_presheaf_map]

private noncomputable def complexMap {F G : X.Modules} (φ : F ⟶ G) :
    complex f F ⟶ complex f G :=
  CochainComplex.ofHom (termMap f φ) (fun degree => by
    rw [complex_d, complex_d]
    exact termMap_comm f φ degree)

/-- **Stacks Project, Tag 0G7I.** The extended alternating Čech complex of a
module with respect to finitely many global equations, including its canonical
augmentation, signed restriction differentials, and functoriality. -/
@[stacks 0G7I "extended alternating Čech complex and signed differentials"]
public def functor : FunctorData f := private_decl% (by
  exact {
  obj := dataFor f
  map := complexMap f
  map_id F := HomologicalComplex.hom_ext _ _ fun degree => termMap_id f F degree
  map_comp φ ψ := HomologicalComplex.hom_ext _ _ fun degree => termMap_comp f φ ψ degree
  map_zero φ := by
    change φ ≫ 𝟙 _ = 𝟙 _ ≫ φ
    simp
  map_sections φ p V x s := termMap_sections f φ p V x s })

/-- The extended alternating Čech complex of a coefficient module. -/
public abbrev data (F : X.Modules) : Data f F := (functor f).obj F

end AlgebraicGeometry.ExtendedAlternatingCech
