module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
public import Mathlib.AlgebraicGeometry.Modules.Sheaf
public import Mathlib.Algebra.Homology.HomologicalComplex
public import StacksFrontier.AlgebraicGeometry.RelativeMayerVietoris.Restriction
public import StacksFrontier.Topology.Sheaves.Cohomology.Cech.AlternatingCochainGroups

/-!
# The extended alternating Čech complex of global equations (Stacks 0G7I)

Let `X` be a scheme and `f : Fin c → Γ(X, ⊤)` a finite family of global functions.  They cut
out a closed subscheme `Z ⊆ X`, and for every strictly increasing tuple `i₀ < ⋯ < i_p` in
`Fin c` they determine the open `U_{i₀…i_p} = ⋂_k X.basicOpen (f i_k)` on which all the
`f i_k` are invertible.  For an `𝒪_X`-module `F` one sets

`F_{i₀…i_p} = (U_{i₀…i_p} → X)_* (F|_{U_{i₀…i_p}})`,

and the *extended alternating Čech complex* of `F` is the cochain complex of `𝒪_X`-modules

`0 → F → ⨁_{i₀} F_{i₀} → ⋯ → ⨁_{i₀<⋯<i_p} F_{i₀…i_p} → ⋯ → F_{1…c} → 0`

with `F` in degree `0` and the differentials given by the alternating sums of the canonical
restriction maps `F_{i₀…î_j…i_{p+1}} → F_{i₀…i_{p+1}}`, with sign `(-1)^j`.

## Main definitions

* `equationsIdeal` and `equationsClosedSubscheme` give the closed subscheme cut out by the
  equations.
* `equationsOpen` and `restrictedModule` describe the principal intersections and the direct
  images of the restricted modules.
* `restrictedModuleSection` gives their canonical sectionwise identification.
* `ExtendedAlternatingCechData` specifies the complex and its maps.
* `ExtendedAlternatingCechFunctorData` specifies functoriality in the module.

## Implementation notes

Indices are strictly increasing tuples in `Fin c`, i.e. the type
`CechCochains.OrdIndex (I := Fin c) p` of `StacksDraft.Ch20.Sec23.Tag01FJ`, which is the index
type of the *ordered* Čech cochains `CechCochains.OrdCochain` with differential
`CechCochains.ordD`.
Reusing that development is what lets the sectionwise characterizations of the differentials
below be stated as literal equalities with the ordinary alternating restriction formula,
rather than respelling the signs here.  Finite categorical products represent the displayed
finite direct sums, and the sectionwise characterizations are compatible with the
isomorphisms to the displayed direct-image summands.

The `restrictFunctor` model of `restrictedModule` — the direct image along the inclusion of an
open of the restriction of a module to it — is
`Stacks.AlgebraicGeometry.RelativeMayerVietoris.pushRestrict`, taken from there rather than
respelled here; `canPR` below is its restriction map for an inclusion of opens.

## References

* [Stacks Project, Tag 0G7I](https://stacks.math.columbia.edu/tag/0G7I)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open Stacks.AlgebraicGeometry.RelativeMayerVietoris (pushRestrict)
open scoped AlgebraicGeometry

universe u

namespace Stacks.Perfect.ExtendedAlternatingCech

variable {X : Scheme.{u}} {c : ℕ} (f : Fin c → Γ(X, ⊤))

/-- The ideal of global sections generated by the given equations. -/
public def equationsIdeal : Ideal Γ(X, ⊤) := Ideal.span (Set.range f)

/-- The closed subscheme cut out by the given equations. -/
@[stacks 0G7I "closed subscheme cut out by the equations"]
public def equationsClosedSubscheme : Scheme.{u} :=
  (Scheme.IdealSheafData.ofIdealTop (equationsIdeal f)).subscheme

/-- The intersection of the principal opens belonging to an increasing tuple. -/
@[stacks 0G7I "principal-open intersections"]
public def equationsOpen (p : ℕ) (s : CechCochains.OrdIndex (I := Fin c) p) : X.Opens :=
  ⨅ k, X.basicOpen (f (s.1 k))

/-- The direct image to `X` of a module restricted to a principal intersection. -/
@[stacks 0G7I "direct images of restrictions"]
public def restrictedModule (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) : X.Modules :=
  (Scheme.Modules.pushforward (equationsOpen f p s).ι).obj
    ((Scheme.Modules.pullback (equationsOpen f p s).ι).obj F)

/-- The canonical identification of a section of a restricted direct image with a
section on the intersection of the ambient open and the principal opens. -/
public def restrictedModuleSection (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) (V : X.Opens) :
    Γ(restrictedModule f F p s, V) →+
      Γ(F, CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1) := by
  let U := equationsOpen f p s
  let i := U.ι
  have h : i ''ᵁ (i ⁻¹ᵁ V) =
      CechCochains.inter (fun j => V ⊓ X.basicOpen (f j)) s.1 := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    simp only [U, equationsOpen, CechCochains.inter, inf_comm (⨅ k, X.basicOpen (f (s.1 k))) V,
      inf_iInf]
  let e : Γ(F, i ''ᵁ (i ⁻¹ᵁ V)) ≃+
      Γ(F, CechCochains.inter (fun j => V ⊓ X.basicOpen (f j)) s.1) := by
    rw [← h]
  exact e.toAddMonoidHom.comp ((F.restrictAppIso i (i ⁻¹ᵁ V)).hom.hom.comp
    (((Scheme.Modules.restrictFunctorIsoPullback i).inv.app F).app (i ⁻¹ᵁ V)).hom)

/-- Data of the extended alternating Čech complex. The sectionwise isomorphisms
identify every differential with the ordinary alternating restriction formula. -/
public structure ExtendedAlternatingCechData (F : X.Modules) where
  /-- The underlying cochain complex of `𝒪_X`-modules. -/
  complex : CochainComplex X.Modules ℕ
  /-- Degree `0` is the coefficient module itself. -/
  zeroIso : complex.X 0 ≅ F
  /-- Degree `p + 1` is the product of the direct images of the restrictions of `F` to the
  `(p + 1)`-fold principal intersections. -/
  termIso (p : ℕ) : complex.X (p + 1) ≅
    ∏ᶜ fun s : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p s
  /-- On every open, the degree-`(p + 1)` sections are the ordered Čech `p`-cochains. -/
  sectionsIso (p : ℕ) (V : X.Opens) :
    Γ(complex.X (p + 1), V) ≃+
      CechCochains.OrdCochain (fun i => V ⊓ X.basicOpen (f i))
        (Scheme.Modules.presheaf F) p
  /-- The sectionwise identification is the componentwise one. -/
  sectionsIso_compat (p : ℕ) (V : X.Opens)
      (x : Γ(complex.X (p + 1), V))
      (s : CechCochains.OrdIndex (I := Fin c) p) :
    sectionsIso p V x s =
      restrictedModuleSection f F p s V
        (((termIso p).hom ≫ Pi.π _ s).app V x)
  /-- The augmentation `F → ⨁_{i₀} F_{i₀}` is the restriction map. -/
  differential_zero (V : X.Opens) (x : Γ(complex.X 0, V))
      (s : CechCochains.OrdIndex (I := Fin c) 0) :
    sectionsIso 0 V ((complex.d 0 1).app V x) s =
      (Scheme.Modules.presheaf F).map
        (homOfLE (show
          CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1 ≤ V from
            (iInf_le _ (0 : Fin 1)).trans inf_le_left)).op
          ((zeroIso.hom).app V x)
  /-- In positive degrees the differential is the signed alternating restriction map. -/
  differential_succ (p : ℕ) (V : X.Opens)
      (x : Γ(complex.X (p + 1), V)) :
    sectionsIso (p + 1) V ((complex.d (p + 1) (p + 2)).app V x) =
      CechCochains.ordD (fun i => V ⊓ X.basicOpen (f i))
        (Scheme.Modules.presheaf F) p (sectionsIso p V x)

/-- The extended complex is natural in its coefficient module. The component
formula says that its map is the componentwise map of restricted sections. -/
public structure ExtendedAlternatingCechFunctorData where
  /-- The complex attached to a coefficient module. -/
  obj (F : X.Modules) : ExtendedAlternatingCechData f F
  /-- The induced map of complexes. -/
  map {F G : X.Modules} (φ : F ⟶ G) : (obj F).complex ⟶ (obj G).complex
  /-- Functoriality: identities. -/
  map_id (F : X.Modules) : map (𝟙 F) = 𝟙 (obj F).complex
  /-- Functoriality: composition. -/
  map_comp {F G H : X.Modules} (φ : F ⟶ G) (ψ : G ⟶ H) :
    map (φ ≫ ψ) = map φ ≫ map ψ
  /-- In degree `0` the induced map is the map itself. -/
  map_zero {F G : X.Modules} (φ : F ⟶ G) :
    (map φ).f 0 ≫ (obj G).zeroIso.hom = (obj F).zeroIso.hom ≫ φ
  /-- In positive degrees the induced map is the componentwise map on sections. -/
  map_sections {F G : X.Modules} (φ : F ⟶ G) (p : ℕ)
      (V : X.Opens) (x : Γ((obj F).complex.X (p + 1), V))
      (s : CechCochains.OrdIndex (I := Fin c) p) :
    (obj G).sectionsIso p V (((map φ).f (p + 1)).app V x) s =
      φ.app (CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1)
        ((obj F).sectionsIso p V x s)


/-!
## Construction of the extended alternating Čech complex

The construction is carried out through the `restrictFunctor` model of `restrictedModule`:
`Γ((W.ι)_* ((W.ι)^* F), V)` is only isomorphic to `Γ(F, W ⊓ V)`, whereas for
`Scheme.Modules.restrictFunctor` the corresponding identification holds by definition
(`Scheme.Modules.restrictAppIso` is `Iso.refl`).  So all canonical maps are built on the
`restrictFunctor` side, where their effect on sections collapses to a single `F.presheaf.map`,
and then transported to the statement's `pullback` model along `toRPhom`/`toRPinv`.
-/

section Helpers

/-- Applying a composite of morphisms of modules to a section. -/
public theorem comp_app_apply {M N K : X.Modules} (φ : M ⟶ N) (ψ : N ⟶ K) (V : X.Opens)
    (x : Γ(M, V)) : (φ ≫ ψ).app V x = ψ.app V (φ.app V x) := rfl

/-- Two successive restrictions of a section compose. -/
public theorem map_map_apply (F : X.Modules) {W₁ W₂ W₃ : X.Opens}
    (g : W₂ ⟶ W₁) (h : W₃ ⟶ W₂) (y : Γ(F, W₁)) :
    F.presheaf.map h.op (F.presheaf.map g.op y) = F.presheaf.map (h ≫ g).op y := by
  rw [← CategoryTheory.comp_apply, ← Functor.map_comp, ← op_comp]

/-- `Opens` is a thin category, so a restriction map depends only on its endpoints. -/
public theorem map_eq_apply (F : X.Modules) {W₁ W₂ : X.Opens} (g h : W₂ ⟶ W₁) (y : Γ(F, W₁)) :
    F.presheaf.map g.op y = F.presheaf.map h.op y := by rw [Subsingleton.elim g h]

/-- A composite of two restrictions is the canonical restriction. -/
public theorem collapse2 (F : X.Modules) {W₀ W₁ W₂ : X.Opens}
    (g₁ : W₁ ⟶ W₀) (g₂ : W₂ ⟶ W₁) (g : W₂ ⟶ W₀) (y : Γ(F, W₀)) :
    F.presheaf.map g₂.op (F.presheaf.map g₁.op y) = F.presheaf.map g.op y := by
  rw [map_map_apply]
  exact map_eq_apply _ _ _ _

/-- Two composites of two restrictions with the same endpoints agree. -/
public theorem collapse2_eq (F : X.Modules) {W₀ W₁ W₂ W₁' : X.Opens}
    (g₁ : W₁ ⟶ W₀) (g₂ : W₂ ⟶ W₁) (g₁' : W₁' ⟶ W₀) (g₂' : W₂ ⟶ W₁') (y : Γ(F, W₀)) :
    F.presheaf.map g₂.op (F.presheaf.map g₁.op y)
      = F.presheaf.map g₂'.op (F.presheaf.map g₁'.op y) := by
  rw [map_map_apply, map_map_apply]
  exact map_eq_apply _ _ _ _

/-- A composite of four restrictions is the canonical restriction. -/
public theorem collapse4 (F : X.Modules) {W₀ W₁ W₂ W₃ W₄ : X.Opens}
    (g₁ : W₁ ⟶ W₀) (g₂ : W₂ ⟶ W₁) (g₃ : W₃ ⟶ W₂) (g₄ : W₄ ⟶ W₃)
    (g : W₄ ⟶ W₀) (y : Γ(F, W₀)) :
    F.presheaf.map g₄.op (F.presheaf.map g₃.op (F.presheaf.map g₂.op (F.presheaf.map g₁.op y)))
      = F.presheaf.map g.op y := by
  rw [map_map_apply, map_map_apply, map_map_apply]
  exact map_eq_apply _ _ _ _

/-- The ordered Čech restriction map is the presheaf restriction. -/
public theorem restr_eq (F : X.Modules) {W₁ W₂ : X.Opens} (h : W₂ ≤ W₁) (y : Γ(F, W₁)) :
    CechCochains.restr F.presheaf h y = F.presheaf.map (homOfLE h).op y := rfl

/-- Transport of sections along an equality of opens. -/
public noncomputable def transportEquiv (F : X.Modules) {A B : X.Opens} (hAB : A = B) :
    Γ(F, A) ≃+ Γ(F, B) := by rw [← hAB]

/-- Transport along an equality of opens is the restriction map along `eqToHom`. -/
public theorem transportEquiv_apply (F : X.Modules) {A B : X.Opens} (hAB : A = B)
    (y : Γ(F, A)) : transportEquiv F hAB y = F.presheaf.map (eqToHom hAB.symm).op y := by
  subst hAB
  simp [transportEquiv]

end Helpers

section Product

/-- `Scheme.Modules.toPresheaf` at the bare functor-category type, where the instances
describing preservation of limits by evaluation are available. -/
public noncomputable def toPsh (X : Scheme.{u}) : X.Modules ⥤ ((Opens ↥X)ᵒᵖ ⥤ Ab.{u}) :=
  Scheme.Modules.toPresheaf X

/-- The forgetful functor to presheaves of abelian groups preserves products. -/
local instance toPshShape (J : Type) :
    PreservesLimitsOfShape (Discrete J) (toPsh X) := by
  have h : PreservesLimitsOfSize.{0, 0} (Scheme.Modules.toPresheaf X) :=
    preservesSmallestLimits_of_preservesLimits _
  exact (inferInstance : PreservesLimitsOfShape (Discrete J) (Scheme.Modules.toPresheaf X))

/-- Sections over `V` as a functor to abelian groups. -/
public noncomputable abbrev ev (X : Scheme.{u}) (V : X.Opens) : X.Modules ⥤ Ab.{u} :=
  toPsh X ⋙ (CategoryTheory.evaluation (Opens ↥X)ᵒᵖ Ab.{u}).obj (op V)

/-- Evaluation of presheaves of abelian groups at an open preserves products. -/
local instance evalShape (J : Type) (V : X.Opens) :
    PreservesLimitsOfShape (Discrete J)
      ((CategoryTheory.evaluation (Opens ↥X)ᵒᵖ Ab.{u}).obj (op V)) :=
  Limits.evaluation_preservesLimitsOfShape _

/-- Taking sections over an open preserves products of modules. -/
local instance evShape (J : Type) (V : X.Opens) :
    PreservesLimitsOfShape (Discrete J) (ev X V) :=
  comp_preservesLimitsOfShape (toPsh X)
    ((CategoryTheory.evaluation (Opens ↥X)ᵒᵖ Ab.{u}).obj (op V))

/-- An isomorphism of abelian groups as an additive equivalence. -/
public noncomputable def abIsoEquiv {A B : Ab.{u}} (e : A ≅ B) : ToType A ≃+ ToType B :=
  AddEquiv.ofBijective (AddCommGrpCat.Hom.hom e.hom) (ConcreteCategory.bijective_of_isIso e.hom)

/-- Elements of a product of abelian groups are dependent functions. -/
public noncomputable def abProdEquiv {J : Type} (A : J → Ab.{u}) :
    ToType (∏ᶜ A) ≃+ ∀ j, ToType (A j) :=
  AddEquiv.mk' (Limits.Concrete.productEquiv A) (fun x y => by
    funext j
    simp only [Limits.Concrete.productEquiv_apply_apply, Pi.add_apply, map_add])

/-- The componentwise map on sections of a product of modules. -/
public noncomputable def prodSectionsHom {J : Type} (G : J → X.Modules) (V : X.Opens) :
    Γ(∏ᶜ G, V) →+ ∀ j, Γ(G j, V) :=
  AddMonoidHom.mk' (fun x j => AddCommGrpCat.Hom.hom ((Pi.π G j).app V) x)
    (fun a b => funext fun _ => map_add _ a b)

/-- The componentwise map on sections of a product of modules is bijective. -/
public theorem prodSectionsHom_bij {J : Type} (G : J → X.Modules) (V : X.Opens) :
    Function.Bijective (prodSectionsHom G V) := by
  have h : (prodSectionsHom G V : Γ(∏ᶜ G, V) → ∀ j, Γ(G j, V)) = fun x =>
      abProdEquiv (fun j => (ev X V).obj (G j))
        (abIsoEquiv (PreservesProduct.iso (ev X V) G) x) := by
    funext x j
    have e1 : abProdEquiv (fun j => (ev X V).obj (G j))
          (abIsoEquiv (PreservesProduct.iso (ev X V) G) x) j
        = ConcreteCategory.hom (Pi.π (fun j => (ev X V).obj (G j)) j)
            (ConcreteCategory.hom (PreservesProduct.iso (ev X V) G).hom x) :=
      Limits.Concrete.productEquiv_apply_apply _ _ _
    rw [e1, show (PreservesProduct.iso (ev X V) G).hom = piComparison (ev X V) G from rfl]
    exact (congr($(piComparison_comp_π (ev X V) G j) x)).symm
  rw [h]
  exact (abProdEquiv _).bijective.comp (abIsoEquiv _).bijective

/-- Sections of a product of modules are the dependent functions of sections. -/
public noncomputable def prodSections {J : Type} (G : J → X.Modules) (V : X.Opens) :
    Γ(∏ᶜ G, V) ≃+ ∀ j, Γ(G j, V) :=
  AddEquiv.ofBijective (prodSectionsHom G V) (prodSectionsHom_bij G V)

/-- A component of `prodSections` is the section of the corresponding factor. -/
public theorem prodSections_apply {J : Type} (G : J → X.Modules) (V : X.Opens)
    (x : Γ(∏ᶜ G, V)) (j : J) :
    prodSections G V x j = AddCommGrpCat.Hom.hom ((Pi.π G j).app V) x := rfl

end Product

section Canonical

/-- The image of the preimage of `V` under an open immersion of an open. -/
public theorem imagePreimage_eq (A : X.Opens) (V : X.Opens) :
    A.ι ''ᵁ (A.ι ⁻¹ᵁ V) = A ⊓ V := by
  rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]

/-- The image of the preimage of `V` is monotone in the open `A`. -/
public theorem imagePreimage_mono {A B : X.Opens} (hAB : A ≤ B) (V : X.Opens) :
    A.ι ''ᵁ (A.ι ⁻¹ᵁ V) ≤ B.ι ''ᵁ (B.ι ⁻¹ᵁ V) := by
  rw [imagePreimage_eq, imagePreimage_eq]
  exact inf_le_inf_right V hAB

/-- The canonical restriction map `(B.ι)_* (F|_B) ⟶ (A.ι)_* (F|_A)` for `A ≤ B`, built from
the unit of the restriction adjunction along the inclusion `A ⟶ B`. -/
public noncomputable def canPR (F : X.Modules) {A B : X.Opens} (hAB : A ≤ B) :
    pushRestrict F B ⟶ pushRestrict F A :=
  (Scheme.Modules.pushforward B.ι).map
      ((Scheme.Modules.restrictAdjunction (X.homOfLE hAB)).unit.app
        ((Scheme.Modules.restrictFunctor B.ι).obj F)) ≫
    (Scheme.Modules.pushforwardComp (X.homOfLE hAB) B.ι).hom.app _ ≫
    (Scheme.Modules.pushforward (X.homOfLE hAB ≫ B.ι)).map
      ((Scheme.Modules.restrictFunctorComp (X.homOfLE hAB) B.ι).inv.app F) ≫
    (Scheme.Modules.pushforwardCongr (X.homOfLE_ι hAB)).hom.app _ ≫
    (Scheme.Modules.pushforward A.ι).map
      ((Scheme.Modules.restrictFunctorCongr (X.homOfLE_ι hAB)).hom.app F)

/-- The composition isomorphism of direct images is the identity on sections. -/
public theorem pcomp_apply {A B : X.Opens} (hAB : A ≤ B) (W : (A : Scheme.{u}).Modules)
    (V : X.Opens)
    (z : Γ((Scheme.Modules.pushforward B.ι).obj
      ((Scheme.Modules.pushforward (X.homOfLE hAB)).obj W), V)) :
    ((Scheme.Modules.pushforwardComp (X.homOfLE hAB) B.ι).hom.app W).app V z = z := rfl

/-- On sections, `canPR` is the presheaf restriction along `A ⊓ V ≤ B ⊓ V`. -/
public theorem canPR_app_apply (F : X.Modules) {A B : X.Opens} (hAB : A ≤ B) (V : X.Opens)
    (y : Γ(pushRestrict F B, V)) :
    (canPR F hAB).app V y = F.presheaf.map (homOfLE (imagePreimage_mono hAB V)).op y := by
  dsimp only [canPR, comp_app_apply]
  rw [pcomp_apply]
  dsimp only [Scheme.Modules.pushforward_map_app,
    Scheme.Modules.restrictAdjunction_unit_app_app,
    Scheme.Modules.restrictFunctorComp_inv_app_app,
    Scheme.Modules.pushforwardCongr_hom_app_app,
    Scheme.Modules.restrictFunctorCongr_hom_app_app, Scheme.Modules.restrict_map]
  exact collapse4 F (W₀ := B.ι ''ᵁ (B.ι ⁻¹ᵁ V)) (W₄ := A.ι ''ᵁ (A.ι ⁻¹ᵁ V)) _ _ _ _
    (homOfLE (imagePreimage_mono hAB V)) y

end Canonical

section Transport

/-- The open `U_{i₀…i_p} ⊓ V`, as the image of the preimage of `V`. -/
public theorem himage (p : ℕ) (s : CechCochains.OrdIndex (I := Fin c) p) (V : X.Opens) :
    (equationsOpen f p s).ι ''ᵁ ((equationsOpen f p s).ι ⁻¹ᵁ V) =
      CechCochains.inter (fun j => V ⊓ X.basicOpen (f j)) s.1 := by
  rw [imagePreimage_eq]
  simp only [equationsOpen, CechCochains.inter, inf_comm (⨅ k, X.basicOpen (f (s.1 k))) V, inf_iInf]

/-- Comparison from the `restrictFunctor` model to the statement's `pullback` model. -/
public noncomputable def toRPhom (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) :
    pushRestrict F (equationsOpen f p s) ⟶ restrictedModule f F p s :=
  (Scheme.Modules.pushforward (equationsOpen f p s).ι).map
    ((Scheme.Modules.restrictFunctorIsoPullback (equationsOpen f p s).ι).hom.app F)

/-- Comparison from the statement's `pullback` model to the `restrictFunctor` model. -/
public noncomputable def toRPinv (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) :
    restrictedModule f F p s ⟶ pushRestrict F (equationsOpen f p s) :=
  (Scheme.Modules.pushforward (equationsOpen f p s).ι).map
    ((Scheme.Modules.restrictFunctorIsoPullback (equationsOpen f p s).ι).inv.app F)

/-- `toRPinv` is a left inverse of `toRPhom`. -/
public theorem toRPhom_toRPinv (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) :
    toRPhom f F p s ≫ toRPinv f F p s = 𝟙 _ :=
  ((Scheme.Modules.pushforward (equationsOpen f p s).ι).mapIso
    ((Scheme.Modules.restrictFunctorIsoPullback (equationsOpen f p s).ι).app F)).hom_inv_id

/-- `toRPinv` is a right inverse of `toRPhom`. -/
public theorem toRPinv_toRPhom (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) :
    toRPinv f F p s ≫ toRPhom f F p s = 𝟙 _ :=
  ((Scheme.Modules.pushforward (equationsOpen f p s).ι).mapIso
    ((Scheme.Modules.restrictFunctorIsoPullback (equationsOpen f p s).ι).app F)).inv_hom_id

/-- On sections, `toRPinv` is the inverse of the comparison of the restriction and the
pullback along the open immersion. -/
public theorem toRPinv_app (F : X.Modules) (p : ℕ) (s : CechCochains.OrdIndex (I := Fin c) p)
    (V : X.Opens) (z : Γ(restrictedModule f F p s, V)) :
    (toRPinv f F p s).app V z
      = ((Scheme.Modules.restrictFunctorIsoPullback (equationsOpen f p s).ι).inv.app F).app
          ((equationsOpen f p s).ι ⁻¹ᵁ V) z := rfl

/-- Applying `toRPhom` and then `toRPinv` to a section gives it back. -/
public theorem toRPinv_toRPhom_app (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) (V : X.Opens)
    (w : Γ(pushRestrict F (equationsOpen f p s), V)) :
    (toRPinv f F p s).app V ((toRPhom f F p s).app V w) = w := by
  rw [← comp_app_apply, toRPhom_toRPinv]
  rfl

/-- `restrictedModuleSection` is transport along `himage` of the `restrictFunctor`-model
section. -/
public theorem restrictedModuleSection_apply' (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) (V : X.Opens)
    (z : Γ(restrictedModule f F p s, V)) :
    restrictedModuleSection f F p s V z
      = transportEquiv F (himage f p s V)
          (((Scheme.Modules.restrictFunctorIsoPullback (equationsOpen f p s).ι).inv.app F).app
            ((equationsOpen f p s).ι ⁻¹ᵁ V) z) := rfl

/-- `restrictedModuleSection` is the transport of the `restrictFunctor`-model sections. -/
public theorem restrictedModuleSection_apply (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) (V : X.Opens)
    (z : Γ(restrictedModule f F p s, V)) :
    restrictedModuleSection f F p s V z
      = F.presheaf.map (eqToHom (himage f p s V).symm).op ((toRPinv f F p s).app V z) := by
  rw [restrictedModuleSection_apply']
  exact transportEquiv_apply F (himage f p s V) _

/-- The sectionwise identification of `restrictedModule` is bijective. -/
public theorem restrictedModuleSection_bijective (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) (V : X.Opens) :
    Function.Bijective (restrictedModuleSection f F p s V) := by
  have : IsIso (toRPinv f F p s) :=
    ⟨toRPhom f F p s, toRPinv_toRPhom f F p s, toRPhom_toRPinv f F p s⟩
  have hb : Function.Bijective (fun z : Γ(restrictedModule f F p s, V) =>
      (toRPinv f F p s).app V z) :=
    ConcreteCategory.bijective_of_isIso ((ev X V).map (toRPinv f F p s))
  have he : (restrictedModuleSection f F p s V : Γ(restrictedModule f F p s, V) → _)
      = (transportEquiv F (himage f p s V)) ∘
          fun z : Γ(restrictedModule f F p s, V) => (toRPinv f F p s).app V z := by
    funext z
    rw [restrictedModuleSection_apply']
    rfl
  rw [he]
  exact (transportEquiv F (himage f p s V)).bijective.comp hb

/-- The sectionwise identification of `restrictedModule`, as an additive equivalence. -/
public noncomputable def rmsEquiv (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) (V : X.Opens) :
    Γ(restrictedModule f F p s, V) ≃+
      Γ(F, CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1) :=
  AddEquiv.ofBijective (restrictedModuleSection f F p s V)
    (restrictedModuleSection_bijective f F p s V)

end Transport

section Differential

/-- An inclusion of principal intersections persists after intersecting with `V`. -/
public theorem interMono {p q : ℕ} {s : CechCochains.OrdIndex (I := Fin c) p}
    {t : CechCochains.OrdIndex (I := Fin c) q}
    (h : equationsOpen f q t ≤ equationsOpen f p s) (V : X.Opens) :
    CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) t.1
      ≤ CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1 := by
  rw [← himage f p s V, ← himage f q t V]
  exact imagePreimage_mono h V

/-- The principal intersection belonging to a tuple, intersected with `V`, lies in `V`. -/
public theorem interLe (p : ℕ) (s : CechCochains.OrdIndex (I := Fin c) p) (V : X.Opens) :
    CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1 ≤ V := by
  rw [← himage f p s V, imagePreimage_eq]
  exact inf_le_right

/-- The canonical restriction between the direct images belonging to two increasing tuples. -/
public noncomputable def canR (F : X.Modules) {p q : ℕ}
    (s : CechCochains.OrdIndex (I := Fin c) p) (t : CechCochains.OrdIndex (I := Fin c) q)
    (h : equationsOpen f q t ≤ equationsOpen f p s) :
    restrictedModule f F p s ⟶ restrictedModule f F q t :=
  toRPinv f F p s ≫ canPR F h ≫ toRPhom f F q t

/-- On sections, `canR` is the ordered Čech restriction map. -/
public theorem canR_section (F : X.Modules) {p q : ℕ}
    (s : CechCochains.OrdIndex (I := Fin c) p) (t : CechCochains.OrdIndex (I := Fin c) q)
    (h : equationsOpen f q t ≤ equationsOpen f p s) (V : X.Opens)
    (z : Γ(restrictedModule f F p s, V)) :
    restrictedModuleSection f F q t V ((canR f F s t h).app V z)
      = CechCochains.restr F.presheaf (interMono f h V)
          (restrictedModuleSection f F p s V z) := by
  rw [restrictedModuleSection_apply, restrictedModuleSection_apply, restr_eq,
    show (canR f F s t h).app V z
      = (toRPhom f F q t).app V ((canPR F h).app V ((toRPinv f F p s).app V z)) from rfl,
    toRPinv_toRPhom_app, canPR_app_apply]
  exact collapse2_eq F (W₀ := (equationsOpen f p s).ι ''ᵁ ((equationsOpen f p s).ι ⁻¹ᵁ V))
    _ _ _ _ _

/-- The augmentation `F ⟶ F_{i₀…i_p}`. -/
public noncomputable def augR (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) : F ⟶ restrictedModule f F p s :=
  (Scheme.Modules.restrictAdjunction (equationsOpen f p s).ι).unit.app F ≫ toRPhom f F p s

/-- On sections, the augmentation is the restriction map. -/
public theorem augR_section (F : X.Modules) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) (V : X.Opens) (x : Γ(F, V)) :
    restrictedModuleSection f F p s V ((augR f F p s).app V x)
      = F.presheaf.map (homOfLE (interLe f p s V)).op x := by
  rw [restrictedModuleSection_apply,
    show (augR f F p s).app V x
      = (toRPhom f F p s).app V
          (((Scheme.Modules.restrictAdjunction (equationsOpen f p s).ι).unit.app F).app V x)
        from rfl,
    toRPinv_toRPhom_app, Scheme.Modules.restrictAdjunction_unit_app_app]
  exact collapse2 F (W₀ := V) _ _ (homOfLE (interLe f p s V)) x

end Differential


section Complex

/-- The degree-`(p+1)` term: the product over strictly increasing `(p+1)`-tuples of the
direct images of the restrictions of `F` to the principal intersections. -/
public noncomputable abbrev prodTerm (F : X.Modules) (p : ℕ) : X.Modules :=
  ∏ᶜ fun s : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p s

/-- On every open, the degree-`(p+1)` sections are the ordered Čech `p`-cochains. -/
public noncomputable def secIso (F : X.Modules) (p : ℕ) (V : X.Opens) :
    Γ(prodTerm f F p, V) ≃+
      CechCochains.OrdCochain (fun i => V ⊓ X.basicOpen (f i)) (Scheme.Modules.presheaf F) p :=
  (prodSections (fun s : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p s) V).trans
    (AddEquiv.piCongrRight fun s => rmsEquiv f F p s V)

/-- A component of `secIso` is the sectionwise identification of the corresponding factor. -/
public theorem secIso_apply (F : X.Modules) (p : ℕ) (V : X.Opens)
    (x : Γ(prodTerm f F p, V)) (s : CechCochains.OrdIndex (I := Fin c) p) :
    secIso f F p V x s
      = restrictedModuleSection f F p s V
          ((Pi.π (fun u : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p u) s).app
            V x) := rfl

/-- Evaluating a morphism of modules at a fixed section, as an additive map. -/
public noncomputable def appApplyHom {M N : X.Modules} (V : X.Opens) (x : Γ(M, V)) :
    (M ⟶ N) →+ Γ(N, V) :=
  AddMonoidHom.mk' (fun φ => φ.app V x)
    (fun a b => by rw [Scheme.Modules.Hom.add_app]; rfl)

/-- Omitting an index enlarges the principal intersection. -/
public theorem omitLe {p : ℕ} (t : CechCochains.OrdIndex (I := Fin c) (p + 1)) (j : Fin (p + 2)) :
    equationsOpen f (p + 1) t
      ≤ equationsOpen f p ⟨t.1 ∘ j.succAbove, CechCochains.strictMono_omit t.2 j⟩ :=
  CechCochains.inter_le_omit (fun i => X.basicOpen (f i)) t.1 j

/-- The augmentation `F ⟶ ⨁_{i₀} F_{i₀}`. -/
public noncomputable def difZero (F : X.Modules) : F ⟶ prodTerm f F 0 :=
  Pi.lift fun s : CechCochains.OrdIndex (I := Fin c) 0 => augR f F 0 s

/-- The signed alternating restriction differential. -/
public noncomputable def difSucc (F : X.Modules) (p : ℕ) :
    prodTerm f F p ⟶ prodTerm f F (p + 1) :=
  Pi.lift fun t : CechCochains.OrdIndex (I := Fin c) (p + 1) =>
    ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
      (Pi.π (fun u : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p u)
          ⟨t.1 ∘ j.succAbove, CechCochains.strictMono_omit t.2 j⟩ ≫
        canR f F _ t (omitLe f t j))

/-- The ordered Čech differential, unfolded. -/
public theorem ordD_apply (F : X.Modules) (V : X.Opens) (p : ℕ)
    (cc : CechCochains.OrdCochain (fun i => V ⊓ X.basicOpen (f i))
      (Scheme.Modules.presheaf F) p)
    (t : CechCochains.OrdIndex (I := Fin c) (p + 1)) :
    CechCochains.ordD (fun i => V ⊓ X.basicOpen (f i)) (Scheme.Modules.presheaf F) p cc t
      = ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
          CechCochains.restr (Scheme.Modules.presheaf F)
            (CechCochains.inter_le_omit (fun i => V ⊓ X.basicOpen (f i)) t.1 j)
            (cc ⟨t.1 ∘ j.succAbove, CechCochains.strictMono_omit t.2 j⟩) := rfl

/-- In positive degrees, the differential is the signed alternating restriction map. -/
public theorem secIso_difSucc (F : X.Modules) (p : ℕ) (V : X.Opens)
    (x : Γ(prodTerm f F p, V)) :
    secIso f F (p + 1) V ((difSucc f F p).app V x)
      = CechCochains.ordD (fun i => V ⊓ X.basicOpen (f i)) (Scheme.Modules.presheaf F) p
          (secIso f F p V x) := by
  funext t
  rw [secIso_apply, ordD_apply, ← comp_app_apply, difSucc, Pi.lift_comp_π]
  change restrictedModuleSection f F (p + 1) t V (appApplyHom V x (∑ j, _)) = _
  rw [map_sum, map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [AddMonoidHom.map_zsmul, AddMonoidHom.map_zsmul]
  congr 1
  rw [show ∀ g, appApplyHom V x g = g.app V x from fun _ => rfl, comp_app_apply, canR_section]
  rfl

/-- In degree `0`, the differential is the augmentation. -/
public theorem secIso_difZero (F : X.Modules) (V : X.Opens) (x : Γ(F, V))
    (s : CechCochains.OrdIndex (I := Fin c) 0) :
    secIso f F 0 V ((difZero f F).app V x) s
      = F.presheaf.map (homOfLE (interLe f 0 s V)).op x := by
  rw [secIso_apply, ← comp_app_apply, difZero, Pi.lift_comp_π]
  exact augR_section f F 0 s V x

end Complex


section Assemble

/-- Morphisms of modules are equal when they agree on all sections. -/
private theorem hom_ext_apply {M N : X.Modules} {a b : M ⟶ N}
    (h : ∀ (V : X.Opens) (x : Γ(M, V)), a.app V x = b.app V x) : a = b :=
  Scheme.Modules.hom_ext _ _ fun V => AddCommGrpCat.hom_ext (AddMonoidHom.ext (h V))

/-- The ordered Čech differential kills an augmented degree-`0` cochain. -/
public theorem ordD_aug (F : X.Modules) (V : X.Opens) (x : Γ(F, V))
    (cc : CechCochains.OrdCochain (fun i => V ⊓ X.basicOpen (f i))
      (Scheme.Modules.presheaf F) 0)
    (hcc : ∀ s, cc s = F.presheaf.map (homOfLE (interLe f 0 s V)).op x) :
    CechCochains.ordD (fun i => V ⊓ X.basicOpen (f i)) (Scheme.Modules.presheaf F) 0 cc = 0 := by
  funext t
  rw [ordD_apply, Fin.sum_univ_two, restr_eq, restr_eq, hcc, hcc,
    collapse2 F (W₀ := V) _ _ (homOfLE (interLe f 1 t V)) x,
    collapse2 F (W₀ := V) _ _ (homOfLE (interLe f 1 t V)) x]
  simp

/-- The augmentation followed by the first differential is zero. -/
public theorem difZero_difSucc (F : X.Modules) : difZero f F ≫ difSucc f F 0 = 0 := by
  refine hom_ext_apply fun V x => ?_
  change (difSucc f F 0).app V ((difZero f F).app V x) = 0
  refine (secIso f F 1 V).injective ?_
  rw [map_zero, secIso_difSucc]
  exact ordD_aug f F V x _ (secIso_difZero f F V x)

/-- Two successive differentials in positive degrees compose to zero. -/
public theorem difSucc_difSucc (F : X.Modules) (p : ℕ) :
    difSucc f F p ≫ difSucc f F (p + 1) = 0 := by
  refine hom_ext_apply fun V x => ?_
  change (difSucc f F (p + 1)).app V ((difSucc f F p).app V x) = 0
  refine (secIso f F (p + 2) V).injective ?_
  rw [map_zero, secIso_difSucc, secIso_difSucc, CechCochains.ordD_ordD]

/-- The terms of the extended alternating Čech complex. -/
public noncomputable def term (F : X.Modules) : ℕ → X.Modules
  | 0 => F
  | (p + 1) => prodTerm f F p

/-- The differentials of the extended alternating Čech complex. -/
public noncomputable def dif (F : X.Modules) : ∀ n : ℕ, term f F n ⟶ term f F (n + 1)
  | 0 => difZero f F
  | (p + 1) => difSucc f F p

/-- Two successive differentials of the extended alternating Čech complex compose to zero. -/
public theorem dif_dif (F : X.Modules) (n : ℕ) : dif f F n ≫ dif f F (n + 1) = 0 := by
  cases n with
  | zero => exact difZero_difSucc f F
  | succ p => exact difSucc_difSucc f F p

/-- The extended alternating Čech complex of `F`. -/
public noncomputable def cplx (F : X.Modules) : CochainComplex X.Modules ℕ :=
  CochainComplex.of (term f F) (dif f F) (dif_dif f F)

/-- The differential of `cplx` out of degree `0` is the augmentation. -/
public theorem cplx_d_zero (F : X.Modules) : (cplx f F).d 0 1 = difZero f F :=
  CochainComplex.of_d (term f F) (dif f F) 0

/-- The differential of `cplx` out of degree `p + 1` is `difSucc`. -/
public theorem cplx_d_succ (F : X.Modules) (p : ℕ) :
    (cplx f F).d (p + 1) (p + 2) = difSucc f F p :=
  CochainComplex.of_d (term f F) (dif f F) (p + 1)

/-- The extended alternating Čech complex of `F`, with all its sectionwise data. -/
public noncomputable def data (F : X.Modules) : ExtendedAlternatingCechData f F where
  complex := cplx f F
  zeroIso := Iso.refl _
  termIso _ := Iso.refl _
  sectionsIso p V := secIso f F p V
  sectionsIso_compat p V x s := secIso_apply f F p V x s
  differential_zero V x s := by
    rw [cplx_d_zero]
    exact secIso_difZero f F V x s
  differential_succ p V x := by
    rw [cplx_d_succ]
    exact secIso_difSucc f F p V x

end Assemble


section Functorial

/-- Naturality of restriction maps in the module. -/
public theorem app_naturality {F G : X.Modules} (φ : F ⟶ G) {W₁ W₂ : X.Opens}
    (g : W₂ ⟶ W₁) (y : Γ(F, W₁)) :
    G.presheaf.map g.op (φ.app W₁ y) = φ.app W₂ (F.presheaf.map g.op y) :=
  (congr($(φ.mapPresheaf.naturality g.op) y)).symm

/-- Applying a morphism of modules to sections, as an additive map. -/
public noncomputable def appHom {F G : X.Modules} (φ : F ⟶ G) (W : X.Opens) :
    Γ(F, W) →+ Γ(G, W) := AddCommGrpCat.Hom.hom (φ.app W)

/-- `appHom φ W` applies `φ` to sections over `W`. -/
public theorem appHom_apply {F G : X.Modules} (φ : F ⟶ G) (W : X.Opens) (y : Γ(F, W)) :
    appHom φ W y = φ.app W y := rfl

/-- `restrictedModule` is functorial in the coefficient module. -/
public noncomputable def mapR {F G : X.Modules} (φ : F ⟶ G) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) :
    restrictedModule f F p s ⟶ restrictedModule f G p s :=
  (Scheme.Modules.pushforward (equationsOpen f p s).ι).map
    ((Scheme.Modules.pullback (equationsOpen f p s).ι).map φ)

/-- `mapR` preserves identities. -/
public theorem mapR_id (F : X.Modules) (p : ℕ) (s : CechCochains.OrdIndex (I := Fin c) p) :
    mapR f (𝟙 F) p s = 𝟙 _ := by
  rw [mapR, CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]
  rfl

/-- `mapR` preserves composition. -/
public theorem mapR_comp {F G H : X.Modules} (φ : F ⟶ G) (ψ : G ⟶ H) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) :
    mapR f (φ ≫ ψ) p s = mapR f φ p s ≫ mapR f ψ p s := by
  rw [mapR, mapR, mapR, CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp]
  rfl

/-- On sections over `W`, the restriction of `φ` to an open `A` is `φ` over the image of `W`. -/
public theorem restrictFunctor_map_app {F G : X.Modules} (A : X.Opens) (φ : F ⟶ G)
    (W : (A : Scheme.{u}).Opens) :
    ((Scheme.Modules.restrictFunctor A.ι).map φ).app W = φ.app (A.ι ''ᵁ W) := rfl

/-- `mapR` is compatible with the comparison to the `restrictFunctor` model. -/
public theorem mapR_toRPinv {F G : X.Modules} (φ : F ⟶ G) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) :
    mapR f φ p s ≫ toRPinv f G p s
      = toRPinv f F p s ≫ (Scheme.Modules.pushforward (equationsOpen f p s).ι).map
          ((Scheme.Modules.restrictFunctor (equationsOpen f p s).ι).map φ) := by
  have h := congrArg (Scheme.Modules.pushforward (equationsOpen f p s).ι).map
    ((Scheme.Modules.restrictFunctorIsoPullback (equationsOpen f p s).ι).inv.naturality φ)
  rwa [Functor.map_comp, Functor.map_comp] at h

/-- On sections, `mapR` acts by applying `φ`. -/
public theorem mapR_section {F G : X.Modules} (φ : F ⟶ G) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) (V : X.Opens)
    (z : Γ(restrictedModule f F p s, V)) :
    restrictedModuleSection f G p s V ((mapR f φ p s).app V z)
      = φ.app (CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1)
          (restrictedModuleSection f F p s V z) := by
  rw [restrictedModuleSection_apply, restrictedModuleSection_apply,
    show (toRPinv f G p s).app V ((mapR f φ p s).app V z)
      = (mapR f φ p s ≫ toRPinv f G p s).app V z from rfl,
    mapR_toRPinv, comp_app_apply, Scheme.Modules.pushforward_map_app,
    restrictFunctor_map_app]
  exact app_naturality φ (eqToHom (himage f p s V).symm) _

/-- The induced map on the degree-`(p+1)` terms. -/
public noncomputable def prodMap {F G : X.Modules} (φ : F ⟶ G) (p : ℕ) :
    prodTerm f F p ⟶ prodTerm f G p :=
  Pi.lift fun s : CechCochains.OrdIndex (I := Fin c) p =>
    Pi.π (fun u : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p u) s ≫
      mapR f φ p s

/-- On sections, `prodMap` acts componentwise by applying `φ`. -/
public theorem prodMap_section {F G : X.Modules} (φ : F ⟶ G) (p : ℕ) (V : X.Opens)
    (x : Γ(prodTerm f F p, V)) (s : CechCochains.OrdIndex (I := Fin c) p) :
    secIso f G p V ((prodMap f φ p).app V x) s
      = φ.app (CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1)
          (secIso f F p V x s) := by
  rw [secIso_apply, secIso_apply, ← comp_app_apply, prodMap, Pi.lift_comp_π, comp_app_apply,
    mapR_section]

/-- The ordered Čech differential is natural in the coefficient presheaf. -/
public theorem ordD_naturality {F G : X.Modules} (φ : F ⟶ G) (V : X.Opens) (p : ℕ)
    (cc : CechCochains.OrdCochain (fun i => V ⊓ X.basicOpen (f i))
      (Scheme.Modules.presheaf F) p)
    (dd : CechCochains.OrdCochain (fun i => V ⊓ X.basicOpen (f i))
      (Scheme.Modules.presheaf G) p)
    (h : ∀ s, dd s
      = φ.app (CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) s.1) (cc s))
    (t : CechCochains.OrdIndex (I := Fin c) (p + 1)) :
    CechCochains.ordD (fun i => V ⊓ X.basicOpen (f i)) (Scheme.Modules.presheaf G) p dd t
      = φ.app (CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) t.1)
          (CechCochains.ordD (fun i => V ⊓ X.basicOpen (f i))
            (Scheme.Modules.presheaf F) p cc t) := by
  rw [ordD_apply, ordD_apply, ← appHom_apply,
    map_sum (appHom φ (CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) t.1))]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [AddMonoidHom.map_zsmul]
  congr 1
  rw [h, restr_eq, restr_eq, appHom_apply, app_naturality]

end Functorial


section Assembly

/-- A component of `prodMap` is the projection followed by `mapR`. -/
public theorem prodMap_π {F G : X.Modules} (φ : F ⟶ G) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) :
    prodMap f φ p ≫
        Pi.π (fun u : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f G p u) s
      = Pi.π (fun u : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p u) s
        ≫ mapR f φ p s := Limits.Pi.lift_comp_π _ s

/-- `prodMap_π`, composed on the right with a further morphism. -/
public theorem prodMap_π_assoc {F G : X.Modules} (φ : F ⟶ G) (p : ℕ)
    (s : CechCochains.OrdIndex (I := Fin c) p) {Z : X.Modules}
    (g : restrictedModule f G p s ⟶ Z) :
    prodMap f φ p ≫
        Pi.π (fun u : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f G p u) s ≫ g
      = Pi.π (fun u : CechCochains.OrdIndex (I := Fin c) p => restrictedModule f F p u) s
        ≫ mapR f φ p s ≫ g := by
  rw [← Category.assoc, prodMap_π, Category.assoc]

/-- `prodMap` preserves identities. -/
public theorem prodMap_id (F : X.Modules) (p : ℕ) : prodMap f (𝟙 F) p = 𝟙 _ := by
  refine Limits.Pi.hom_ext _ _ fun s => ?_
  rw [prodMap_π, mapR_id, Category.comp_id, Category.id_comp]

/-- `prodMap` preserves composition. -/
public theorem prodMap_comp {F G H : X.Modules} (φ : F ⟶ G) (ψ : G ⟶ H) (p : ℕ) :
    prodMap f (φ ≫ ψ) p = prodMap f φ p ≫ prodMap f ψ p := by
  refine Limits.Pi.hom_ext _ _ fun s => ?_
  simp only [prodMap_π, prodMap_π_assoc, mapR_comp, Category.assoc]

/-- The chain map induced by a morphism of coefficient modules. -/
public noncomputable def cmap {F G : X.Modules} (φ : F ⟶ G) :
    ∀ n : ℕ, term f F n ⟶ term f G n
  | 0 => φ
  | (p + 1) => prodMap f φ p

/-- The induced maps commute with the augmentations. -/
public theorem cmap_comm_zero {F G : X.Modules} (φ : F ⟶ G) :
    φ ≫ difZero f G = difZero f F ≫ prodMap f φ 0 := by
  refine hom_ext_apply fun V x => ?_
  refine (secIso f G 0 V).injective ?_
  funext s
  rw [comp_app_apply, comp_app_apply, secIso_difZero, prodMap_section, secIso_difZero]
  exact app_naturality φ (homOfLE (interLe f 0 s V)) x

/-- The induced maps commute with the differentials in positive degrees. -/
public theorem cmap_comm_succ {F G : X.Modules} (φ : F ⟶ G) (p : ℕ) :
    prodMap f φ p ≫ difSucc f G p = difSucc f F p ≫ prodMap f φ (p + 1) := by
  refine hom_ext_apply fun V x => ?_
  refine (secIso f G (p + 1) V).injective ?_
  funext t
  rw [comp_app_apply, comp_app_apply, secIso_difSucc, prodMap_section, secIso_difSucc]
  exact ordD_naturality f φ V p (secIso f F p V x)
    (secIso f G p V ((prodMap f φ p).app V x)) (prodMap_section f φ p V x) t

/-- The map of extended alternating Čech complexes induced by a morphism of modules. -/
public noncomputable def cplxMap {F G : X.Modules} (φ : F ⟶ G) : cplx f F ⟶ cplx f G where
  f := cmap f φ
  comm' i j hij := by
    obtain rfl : i + 1 = j := hij
    cases i with
    | zero =>
      rw [show (cplx f G).d 0 (0 + 1) = difZero f G from cplx_d_zero f G,
        show (cplx f F).d 0 (0 + 1) = difZero f F from cplx_d_zero f F]
      exact cmap_comm_zero f φ
    | succ p =>
      rw [show (cplx f G).d (p + 1) (p + 1 + 1) = difSucc f G p from cplx_d_succ f G p,
        show (cplx f F).d (p + 1) (p + 1 + 1) = difSucc f F p from cplx_d_succ f F p]
      exact cmap_comm_succ f φ p

/-- **Stacks Project, Tag 0G7I.** The extended alternating Čech complex of a
module with respect to finitely many global equations, including its canonical
augmentation, signed restriction differentials, and functoriality. -/
@[stacks 0G7I "extended alternating Čech complex and signed differentials"]
public def extendedAlternatingCechFunctor :
    ExtendedAlternatingCechFunctorData f where
  obj F := data f F
  map φ := cplxMap f φ
  map_id F := by
    refine HomologicalComplex.hom_ext _ _ fun n => ?_
    cases n with
    | zero => rfl
    | succ p => exact prodMap_id f F p
  map_comp φ ψ := by
    refine HomologicalComplex.hom_ext _ _ fun n => ?_
    cases n with
    | zero => rfl
    | succ p => exact prodMap_comp f φ ψ p
  map_zero φ := by
    change φ ≫ 𝟙 _ = 𝟙 _ ≫ φ
    rw [Category.comp_id, Category.id_comp]
  map_sections φ p V x s := prodMap_section f φ p V x s

/-- The extended alternating Čech complex of a coefficient module. -/
public abbrev extendedAlternatingCech (F : X.Modules) :
    ExtendedAlternatingCechData f F := (extendedAlternatingCechFunctor f).obj F

end Assembly

end Stacks.Perfect.ExtendedAlternatingCech

