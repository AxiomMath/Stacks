/-!
# Fractions in the last Čech term depend only on the residue class

For a finite family of global equations, the class of a fraction with denominator their product
in the sheaf cokernel of the last Čech differential depends only on its numerator modulo the
submodule sheaf generated by the equations.

## Main results

* `AlgebraicGeometry.ExtendedAlternatingCech.cokernel_π_app_eq_of_eq_mod_equations`: the local
  independence of the numerator, on every open cover.
* `AlgebraicGeometry.ExtendedAlternatingCech.eq_of_eq_mod_equations_empty`: the empty family of
  equations.

## Implementation notes

The last term and differential are taken from the extended alternating Čech complex of Tag 0G7I.
A fraction is specified by the equation saying that multiplication by the product of the
equations recovers its numerator on the full principal-open intersection. Membership in the
submodule sheaf generated by the equations is local: on a cover, the numerator difference is a
linear combination of the equations. The conclusion is equality in the categorical sheaf
cokernel; locally the fraction difference is a boundary. Writing the number of equations as
`c + 1` makes the last differential include the one-equation case. For the empty family, the
complex's degree-zero term is the coefficient module and there is no preceding differential.

## References

* [Stacks Project, Tag 0G7Q](https://stacks.math.columbia.edu/tag/0G7Q)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open scoped AlgebraicGeometry

universe u

namespace AlgebraicGeometry.ExtendedAlternatingCech

private lemma exists_omit_index {p : ℕ}
    (q : CechCochains.OrdIndex (I := Fin (p + 2)) p) :
    ∃ i : Fin (p + 2), q.1 = i.succAbove := by
  classical
  let S : Set (Fin (p + 2)) := Set.range q.1
  have hcard : S.ncard = p + 1 := by
    rw [Set.ncard_eq_toFinset_card]
    simp [S, Finset.card_image_of_injective, q.2.injective]
  have hnot : S ≠ Set.univ := by
    intro h
    rw [h, Set.ncard_univ] at hcard
    simp at hcard
  obtain ⟨i, hi⟩ : ∃ i : Fin (p + 2), i ∉ S := by
    by_contra! hh
    exact hnot (Set.eq_univ_of_forall hh)
  have hsub : S ⊆ ({i}ᶜ : Set (Fin (p + 2))) := by
    rintro x ⟨j, rfl⟩
    exact fun hx => hi ⟨j, hx⟩
  have hcompl : ({i}ᶜ : Set (Fin (p + 2))).ncard = p + 1 := by
    rw [Set.ncard_compl, Set.ncard_singleton, Nat.card_fin]
    omega
  have heq : S = ({i}ᶜ : Set (Fin (p + 2))) :=
    Set.eq_of_subset_of_ncard_le hsub (hcompl.trans hcard.symm).le
  have hrange : Set.range q.1 = Set.range i.succAbove := by
    simpa [S, Fin.range_succAbove] using heq
  exact ⟨i, q.2.eq_of_range_eq (Fin.strictMono_succAbove i) hrange⟩

private def topOrdIndex (n : ℕ) :
    CechCochains.OrdIndex (I := Fin (n + 2)) (n + 1) :=
  ⟨id, strictMono_id⟩

private lemma topOrdIndex_unique {n : ℕ}
    (q : CechCochains.OrdIndex (I := Fin (n + 2)) (n + 1)) :
    q = topOrdIndex n := by
  apply Subtype.ext
  apply q.2.eq_of_range_eq (strictMono_id : StrictMono (id : Fin (n + 2) → Fin (n + 2)))
  have hcard : (Set.range q.1).ncard = n + 2 := by
    rw [Set.ncard_eq_toFinset_card]
    simp [Finset.card_image_of_injective, q.2.injective]
  have heq : Set.range q.1 = Set.univ := by
    apply Set.eq_of_subset_of_ncard_le (Set.subset_univ _)
    rw [hcard, Set.ncard_univ]
    simp
  simpa [topOrdIndex] using heq

private def faceOrdIndex (n : ℕ) (i : Fin (n + 2)) :
    CechCochains.OrdIndex (I := Fin (n + 2)) n :=
  ⟨i.succAbove, Fin.strictMono_succAbove i⟩

private lemma faceOrdIndex_injective {n : ℕ} {i j : Fin (n + 2)}
    (h : faceOrdIndex n i = faceOrdIndex n j) : i = j :=
  Fin.succAbove_left_injective (congrArg Subtype.val h)

private lemma exists_faceOrdIndex {n : ℕ}
    (q : CechCochains.OrdIndex (I := Fin (n + 2)) n) :
    ∃ i : Fin (n + 2), q = faceOrdIndex n i := by
  obtain ⟨i, hi⟩ := exists_omit_index q
  exact ⟨i, Subtype.ext hi⟩

private noncomputable def omittedIndex {n : ℕ}
    (q : CechCochains.OrdIndex (I := Fin (n + 2)) n) : Fin (n + 2) :=
  Classical.choose (exists_faceOrdIndex q)

private lemma omittedIndex_spec {n : ℕ}
    (q : CechCochains.OrdIndex (I := Fin (n + 2)) n) :
    q = faceOrdIndex n (omittedIndex q) :=
  Classical.choose_spec (exists_faceOrdIndex q)

private lemma omittedIndex_faceOrdIndex {n : ℕ} (i : Fin (n + 2)) :
    omittedIndex (faceOrdIndex n i) = i :=
  faceOrdIndex_injective (omittedIndex_spec (faceOrdIndex n i)).symm

private lemma sections_ext_of_cover {X : Scheme} (M : X.Modules) {ι : Type*}
    (V : X.Opens) (U : ι → X.Opens) (hU : ∀ j, U j ≤ V)
    (hcover : ⨆ j, U j = V) (a b : Γ(M, V))
    (h : ∀ j, (M.presheaf.map (homOfLE (hU j)).op) a =
      (M.presheaf.map (homOfLE (hU j)).op) b) : a = b := by
  let P := M.presheaf ⋙ forget AddCommGrpCat
  have hP : Presieve.IsSheaf (Opens.grothendieckTopology X) P :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      (GrothendieckTopology.HasSheafCompose.isSheaf _ M.isSheaf)
  let S : Presieve V := Presieve.ofArrows U (fun j => homOfLE (hU j))
  have hS : Sieve.generate S ∈ Opens.grothendieckTopology X V := by
    rw [Opens.mem_grothendieckTopology]
    intro x hx
    have hx' : x ∈ (⨆ j, U j) := by rwa [hcover]
    obtain ⟨j, hj⟩ := Opens.mem_iSup.mp hx'
    exact ⟨U j, homOfLE (hU j), Sieve.le_generate _ _ _
      (Presieve.ofArrows.mk j), hj⟩
  apply (hP.isSheafFor S hS).isSeparatedFor.ext
  rintro _ _ ⟨j⟩
  exact h j

private lemma section_map_natural {X : Scheme} {M N : X.Modules} (φ : M ⟶ N)
    {W V : X.Opens} (hWV : W ≤ V) (x : Γ(M, V)) :
    (N.presheaf.map (homOfLE hWV).op) (φ.app V x) =
      φ.app W ((M.presheaf.map (homOfLE hWV).op) x) := by
  have h := φ.mapPresheaf.naturality (homOfLE hWV).op
  exact (congrArg (fun g => g.hom x) h).symm

/-- The intersection of the principal opens inside `W` is contained in `W`. -/
private lemma cech_inter_le {X : Scheme} {c : ℕ} (f : Fin c → Γ(X, ⊤)) (W : X.Opens) {p : ℕ}
    (q : CechCochains.OrdIndex (I := Fin c) p) :
    CechCochains.inter (fun i => W ⊓ X.basicOpen (f i)) q.1 ≤ W :=
  (iInf_le _ 0).trans inf_le_left

private lemma cech_inter_mono {X : Scheme} {c : ℕ} (f : Fin c → Γ(X, ⊤))
    (p : ℕ) (q : CechCochains.OrdIndex (I := Fin c) p) {W V : X.Opens}
    (hWV : W ≤ V) :
    CechCochains.inter (fun i => W ⊓ X.basicOpen (f i)) q.1 ≤
      CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) q.1 := by
  simpa only [CechCochains.inter] using
    (iInf_mono (fun _ : Fin (p + 1) => inf_le_inf hWV le_rfl))

private lemma rw_addEquiv_eqToHom_apply {X : Scheme} (F : X.Modules)
    {U V : X.Opens} (h : U = V) (x : Γ(F, U)) :
    (show Γ(F, U) ≃+ Γ(F, V) from by rw [← h]) x =
      (F.presheaf.map (eqToHom h.symm).op) x := by
  cases h
  simp

private lemma image_preimage_equationsOpen {X : Scheme.{u}} {c : ℕ} (f : Fin c → Γ(X, ⊤))
    (p : ℕ) (q : CechCochains.OrdIndex (I := Fin c) p) (W : X.Opens) :
    (equationsOpen f p q).ι ''ᵁ ((equationsOpen f p q).ι ⁻¹ᵁ W) =
      CechCochains.inter (fun j => W ⊓ X.basicOpen (f j)) q.1 := by
  rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
  simp only [equationsOpen, CechCochains.inter,
    inf_comm (⨅ k, X.basicOpen (f (q.1 k))) W, inf_iInf]

private lemma restrictAppIso_pullback_restrict {Y X : Scheme.{u}} (i : Y ⟶ X)
    [IsOpenImmersion i] (F : X.Modules) {W V : Y.Opens} (h : W ≤ V)
    (z : Γ((Scheme.Modules.pullback i).obj F, V)) :
    (F.presheaf.map (homOfLE (i.image_mono h)).op)
        ((F.restrictAppIso i V).hom
          (((Scheme.Modules.restrictFunctorIsoPullback i).inv.app F).app V z)) =
      (F.restrictAppIso i W).hom
        (((Scheme.Modules.restrictFunctorIsoPullback i).inv.app F).app W
          (((Scheme.Modules.pullback i).obj F).presheaf.map (homOfLE h).op z)) := by
  have hn := section_map_natural
    (((Scheme.Modules.restrictFunctorIsoPullback i).symm.app F).hom) h z
  have hRA := congrArg (fun g => g.hom
    (((Scheme.Modules.restrictFunctorIsoPullback i).inv.app F).app V z))
    (Scheme.Modules.map_restrictAppIso_hom i F (homOfLE h).op)
  calc
    _ = (F.restrictAppIso i W).hom
        ((F.restrict i).presheaf.map (homOfLE h).op
          (((Scheme.Modules.restrictFunctorIsoPullback i).inv.app F).app V z)) :=
        hRA.symm
    _ = _ := congrArg (fun a => (F.restrictAppIso i W).hom a) hn

private lemma map_apply_eq_of_comp {X : Scheme} (F : X.Modules) {A B C D : X.Opens}
    (f₁ : B ⟶ A) (g₁ : C ⟶ B) (f₂ : D ⟶ A) (g₂ : C ⟶ D) (x : Γ(F, A)) :
    F.presheaf.map g₁.op (F.presheaf.map f₁.op x) =
      F.presheaf.map g₂.op (F.presheaf.map f₂.op x) := by
  rw [← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp,
    Subsingleton.elim (g₁ ≫ f₁) (g₂ ≫ f₂)]

private lemma restrictedModuleSection_restrict {X : Scheme.{u}} {c : ℕ}
    (f : Fin c → Γ(X, ⊤)) (F : X.Modules) (p : ℕ)
    (q : CechCochains.OrdIndex (I := Fin c) p) {W V : X.Opens} (hWV : W ≤ V)
    (z : Γ(restrictedModule f F p q, V)) :
    (F.presheaf.map (homOfLE (cech_inter_mono f p q hWV)).op)
        (restrictedModuleSection f F p q V z) =
    restrictedModuleSection f F p q W
        ((restrictedModule f F p q).presheaf.map (homOfLE hWV).op z) := by
  let i := (equationsOpen f p q).ι
  have hpre : i ⁻¹ᵁ W ≤ i ⁻¹ᵁ V := fun _ hx => hWV hx
  have hW : i ''ᵁ (i ⁻¹ᵁ W) =
      CechCochains.inter (fun j => W ⊓ X.basicOpen (f j)) q.1 :=
    image_preimage_equationsOpen f p q W
  have hV : i ''ᵁ (i ⁻¹ᵁ V) =
      CechCochains.inter (fun j => V ⊓ X.basicOpen (f j)) q.1 :=
    image_preimage_equationsOpen f p q V
  have hcore :
      (F.presheaf.map (homOfLE (i.image_mono hpre)).op)
          ((F.restrictAppIso i (i ⁻¹ᵁ V)).hom
            (((Scheme.Modules.restrictFunctorIsoPullback i).inv.app F).app (i ⁻¹ᵁ V) z)) =
        (F.restrictAppIso i (i ⁻¹ᵁ W)).hom
          (((Scheme.Modules.restrictFunctorIsoPullback i).inv.app F).app (i ⁻¹ᵁ W)
            (((Scheme.Modules.pullback i).obj F).presheaf.map (homOfLE hpre).op z)) :=
    restrictAppIso_pullback_restrict i F hpre
      (show Γ((Scheme.Modules.pullback i).obj F, i ⁻¹ᵁ V) from z)
  simp only [restrictedModule, Scheme.Modules.pushforward_obj_obj] at z ⊢
  let IW := i ''ᵁ (i ⁻¹ᵁ W)
  let IV := i ''ᵁ (i ⁻¹ᵁ V)
  let JW := CechCochains.inter (fun j => W ⊓ X.basicOpen (f j)) q.1
  let JV := CechCochains.inter (fun j => V ⊓ X.basicOpen (f j)) q.1
  let eW : Γ(F, IW) ≃+ Γ(F, JW) := by
    show Γ(F, i ''ᵁ (i ⁻¹ᵁ W)) ≃+ Γ(F, CechCochains.inter
      (fun j => W ⊓ X.basicOpen (f j)) q.1)
    rw [← hW]
  let eV : Γ(F, IV) ≃+ Γ(F, JV) := by
    show Γ(F, i ''ᵁ (i ⁻¹ᵁ V)) ≃+ Γ(F, CechCochains.inter
      (fun j => V ⊓ X.basicOpen (f j)) q.1)
    rw [← hV]
  let av : Γ(F, IV) := (F.restrictAppIso i (i ⁻¹ᵁ V)).hom
    (((Scheme.Modules.restrictFunctorIsoPullback i).inv.app F).app (i ⁻¹ᵁ V) z)
  let aw : Γ(F, IW) := (F.restrictAppIso i (i ⁻¹ᵁ W)).hom
    (((Scheme.Modules.restrictFunctorIsoPullback i).inv.app F).app (i ⁻¹ᵁ W)
      (((Scheme.Modules.pullback i).obj F).presheaf.map (homOfLE hpre).op z))
  have hsV : restrictedModuleSection f F p q V z = eV av := rfl
  have hsW : restrictedModuleSection f F p q W
      ((restrictedModule f F p q).presheaf.map (homOfLE hWV).op z) = eW aw := rfl
  have heV (a : Γ(F, IV)) : eV a = (F.presheaf.map (eqToHom hV.symm).op) a := by
    simpa [eV, IV, JV] using rw_addEquiv_eqToHom_apply F hV a
  have heW (a : Γ(F, IW)) : eW a = (F.presheaf.map (eqToHom hW.symm).op) a := by
    simpa [eW, IW, JW] using rw_addEquiv_eqToHom_apply F hW a
  show (F.presheaf.map (homOfLE (cech_inter_mono f p q hWV)).op)
      (restrictedModuleSection f F p q V z) =
    restrictedModuleSection f F p q W
      ((restrictedModule f F p q).presheaf.map (homOfLE hWV).op z)
  rw [hsV, hsW, heV, heW, map_apply_eq_of_comp F _ _ (homOfLE (i.image_mono hpre))
    (eqToHom hW.symm) av]
  exact congrArg (fun b => (F.presheaf.map (eqToHom hW.symm).op) b) hcore

private lemma sectionsIso_restrict {X : Scheme.{u}} {c : ℕ}
    (f : Fin c → Γ(X, ⊤)) (F : X.Modules) (p : ℕ)
    {W V : X.Opens} (hWV : W ≤ V)
    (x : Γ((data f F).complex.X (p + 1), V))
    (q : CechCochains.OrdIndex (I := Fin c) p) :
    (F.presheaf.map (homOfLE (cech_inter_mono f p q hWV)).op)
        ((data f F).sectionsIso p V x q) =
      (data f F).sectionsIso p W
        (((data f F).complex.X (p + 1)).presheaf.map (homOfLE hWV).op x) q := by
  let ψ := ((data f F).termIso p).hom ≫ Pi.π _ q
  have hnat := section_map_natural ψ hWV x
  rw [Data.sectionsIso_compat, Data.sectionsIso_compat]
  show (F.presheaf.map (homOfLE (cech_inter_mono f p q hWV)).op)
      (restrictedModuleSection f F p q V (ψ.app V x)) =
    restrictedModuleSection f F p q W
      (ψ.app W (((data f F).complex.X (p + 1)).presheaf.map (homOfLE hWV).op x))
  rw [← hnat]
  exact restrictedModuleSection_restrict f F p q hWV (ψ.app V x)

private lemma unit_on_basic_open_le {X : Scheme} {V : X.Opens} (f : Γ(X, ⊤))
    (hV : V ≤ X.basicOpen f) :
    IsUnit ((X.presheaf.map (homOfLE (show V ≤ ⊤ from le_top)).op) f) := by
  have hunit : IsUnit ((X.presheaf.map
      (homOfLE (show X.basicOpen f ≤ ⊤ from le_top)).op) f) :=
    X.toRingedSpace.isUnit_res_basicOpen f
  have hmap := hunit.map (X.presheaf.map (homOfLE hV).op).hom
  convert hmap using 1
  simp [← X.presheaf.map_comp_apply, ← op_comp, homOfLE_comp]

private lemma unit_prod_on_inter {X : Scheme.{u}} {c : ℕ}
    (f : Fin c → Γ(X, ⊤)) (V : X.Opens) (p : ℕ)
    (q : CechCochains.OrdIndex (I := Fin c) p) :
    IsUnit ((X.presheaf.map (homOfLE (show
      CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) q.1 ≤ ⊤ from le_top)).op)
      (∏ k, f (q.1 k))) := by
  rw [map_prod, IsUnit.prod_univ_iff]
  exact fun k => unit_on_basic_open_le (f (q.1 k)) ((iInf_le _ k).trans inf_le_right)

private lemma unit_inverse_smul {R M : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] (u : Rˣ) (x : M) :
    (u : R) • ((↑(u⁻¹) : R) • x) = x := by
  rw [smul_smul, Units.mul_inv, one_smul]

lemma sign_smul_sign {M : Type*} [AddCommGroup M] (i : ℕ) (x : M) :
    ((-1 : ℤ) ^ i) • (((-1 : ℤ) ^ i) • x) = x := by
  rw [smul_smul, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_smul]

/-- For no equations, the fraction is just the numerator itself, and the
quotient by the zero ideal changes nothing. -/
@[stacks 0G7Q "fraction_class_well_defined"]
public lemma eq_of_eq_mod_equations_empty
    {X : Scheme.{u}} (f : Fin 0 → Γ(X, ⊤)) (F : X.Modules) (V : X.Opens)
    (s t : Γ(F, V))
    (x y : Γ((data f F).complex.X 0, V))
    (hmod : s - t = ∑ i : Fin 0,
      (X.presheaf.map (homOfLE le_top : V ⟶ ⊤).op (f i)) •
        (0 : Γ(F, V)))
    (hx : ((data f F).zeroIso.hom).app V x = s)
    (hy : ((data f F).zeroIso.hom).app V y = t) :
    x = y := by
  have hxy : ((data f F).zeroIso.hom).app V x = ((data f F).zeroIso.hom).app V y :=
    hx.trans ((sub_eq_zero.mp (by simpa using hmod)).trans hy.symm)
  let e := asIso ((data f F).zeroIso.hom.app V)
  exact (e.hom_inv_id_apply x).symm.trans ((congrArg e.inv hxy).trans (e.hom_inv_id_apply y))

private lemma cokernel_π_app_eq_of_app_eq_sub {X : Scheme.{u}} {A B : X.Modules} (d : A ⟶ B)
    (W : X.Opens) {u v : Γ(B, W)} (z : Γ(A, W)) (h : d.app W z = u - v) :
    (cokernel.π d).app W u = (cokernel.π d).app W v := by
  have hkill : (cokernel.π d).app W (d.app W z) = 0 :=
    congrArg (fun φ => (φ.app W).hom z) (cokernel.condition d)
  rw [← sub_add_cancel u v, ← h, map_add, hkill, zero_add]

private lemma prod_smul_sectionsIso_restrict {X : Scheme.{u}} {c : ℕ}
    (f : Fin (c + 1) → Γ(X, ⊤)) (F : X.Modules) {W V : X.Opens} (hWV : W ≤ V)
    (s : Γ(F, V)) (x : Γ((data f F).complex.X (c + 1), V))
    (q : CechCochains.OrdIndex (I := Fin (c + 1)) c)
    (hx : (X.presheaf.map (homOfLE le_top :
        CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) q.1 ⟶ ⊤).op (∏ i, f i)) •
        ((data f F).sectionsIso c V x q) =
      F.presheaf.map (homOfLE (cech_inter_le f V q)).op s) :
    (X.presheaf.map (homOfLE le_top :
        CechCochains.inter (fun i => W ⊓ X.basicOpen (f i)) q.1 ⟶ ⊤).op (∏ i, f i)) •
        ((data f F).sectionsIso c W
          (((data f F).complex.X (c + 1)).presheaf.map (homOfLE hWV).op x) q) =
      F.presheaf.map (homOfLE ((cech_inter_le f W q).trans hWV)).op s := by
  have h := congrArg (F.presheaf.map (homOfLE (cech_inter_mono f c q hWV)).op) hx
  rw [Scheme.Modules.map_smul, sectionsIso_restrict f F c hWV x q] at h
  simpa only [← Functor.map_comp_apply, ← op_comp, homOfLE_comp] using h

private lemma exists_boundary_one {X : Scheme.{u}} (f : Fin 1 → Γ(X, ⊤)) (F : X.Modules)
    (W : X.Opens) (x y : Γ((data f F).complex.X 1, W)) (a : Γ(F, W))
    (q : CechCochains.OrdIndex (I := Fin 1) 0)
    (hTU : CechCochains.inter (fun i => W ⊓ X.basicOpen (f i)) q.1 ≤ W)
    (hxy : (data f F).sectionsIso 0 W x q - (data f F).sectionsIso 0 W y q =
      F.presheaf.map (homOfLE hTU).op a) :
    ∃ z, ((data f F).complex.d 0 1).app W z = x - y := by
  refine ⟨(data f F).zeroIso.inv.app W a, ((data f F).sectionsIso 0 W).injective ?_⟩
  rw [map_sub]
  funext q'
  obtain rfl : q' = q := Subtype.ext (funext fun _ => Subsingleton.elim _ _)
  have hz : (data f F).zeroIso.hom.app W ((data f F).zeroIso.inv.app W a) = a :=
    congrArg (fun φ => (φ.app W).hom a) (data f F).zeroIso.inv_hom_id
  rw [Data.differential_zero, hz]
  exact hxy.symm

private def boundaryCochain {X : Scheme.{u}} {n : ℕ} (f : Fin (n + 2) → Γ(X, ⊤))
    (F : X.Modules) (W : X.Opens) (a : Fin (n + 2) → Γ(F, W)) :
    CechCochains.OrdCochain (fun i => W ⊓ X.basicOpen (f i)) (Scheme.Modules.presheaf F) n :=
  fun q => ((-1 : ℤ) ^ (omittedIndex q : ℕ)) •
    ((↑((unit_prod_on_inter f W n q).unit⁻¹) :
        Γ(X, CechCochains.inter (fun i => W ⊓ X.basicOpen (f i)) q.1)) •
      F.presheaf.map (homOfLE (cech_inter_le f W q)).op (a (omittedIndex q)))

private lemma prod_res_eq_mul_face {X : Scheme.{u}} {n : ℕ} (f : Fin (n + 2) → Γ(X, ⊤))
    (W : X.Opens) (i : Fin (n + 2))
    (h : CechCochains.inter (fun k => W ⊓ X.basicOpen (f k)) (topOrdIndex n).1 ≤
      CechCochains.inter (fun k => W ⊓ X.basicOpen (f k)) (faceOrdIndex n i).1) :
    X.presheaf.map (homOfLE le_top :
        CechCochains.inter (fun k => W ⊓ X.basicOpen (f k)) (topOrdIndex n).1 ⟶ ⊤).op
        (∏ k, f k) =
      X.presheaf.map (homOfLE le_top :
          CechCochains.inter (fun k => W ⊓ X.basicOpen (f k)) (topOrdIndex n).1 ⟶ ⊤).op
          (f i) *
        X.presheaf.map (homOfLE h).op (X.presheaf.map (homOfLE le_top :
          CechCochains.inter (fun k => W ⊓ X.basicOpen (f k)) (faceOrdIndex n i).1 ⟶ ⊤).op
          (∏ k : Fin (n + 1), f ((faceOrdIndex n i).1 k))) := by
  rw [Fin.prod_univ_succAbove f i, map_mul, ← X.presheaf.map_comp_apply, ← op_comp]
  rfl

private lemma smul_face_boundaryCochain {X : Scheme.{u}} {n : ℕ} (f : Fin (n + 2) → Γ(X, ⊤))
    (F : X.Modules) (W : X.Opens) (a : Fin (n + 2) → Γ(F, W))
    (hTopU : CechCochains.inter (fun k => W ⊓ X.basicOpen (f k)) (topOrdIndex n).1 ≤ W)
    (i : Fin (n + 2)) :
    X.presheaf.map (homOfLE le_top :
        CechCochains.inter (fun k => W ⊓ X.basicOpen (f k)) (topOrdIndex n).1 ⟶ ⊤).op
        (∏ k, f k) •
      (((-1 : ℤ) ^ (i : ℕ)) • CechCochains.restr (Scheme.Modules.presheaf F)
        (CechCochains.inter_le_omit (fun k => W ⊓ X.basicOpen (f k)) (topOrdIndex n).1 i)
        (boundaryCochain f F W a ⟨(topOrdIndex n).1 ∘ i.succAbove,
          CechCochains.strictMono_omit (topOrdIndex n).2 i⟩)) =
      X.presheaf.map (homOfLE le_top :
          CechCochains.inter (fun k => W ⊓ X.basicOpen (f k)) (topOrdIndex n).1 ⟶ ⊤).op
          (f i) •
        F.presheaf.map (homOfLE hTopU).op (a i) := by
  have hTi : CechCochains.inter (fun k => W ⊓ X.basicOpen (f k)) (topOrdIndex n).1 ≤
      CechCochains.inter (fun k => W ⊓ X.basicOpen (f k)) (faceOrdIndex n i).1 :=
    CechCochains.inter_le_omit _ _ i
  have hWi := cech_inter_le f W (faceOrdIndex n i)
  have hu := unit_prod_on_inter f W n (faceOrdIndex n i)
  have hz : boundaryCochain f F W a (faceOrdIndex n i) = ((-1 : ℤ) ^ (i : ℕ)) •
      ((↑(hu.unit⁻¹) :
          Γ(X, CechCochains.inter (fun k => W ⊓ X.basicOpen (f k)) (faceOrdIndex n i).1)) •
        F.presheaf.map (homOfLE hWi).op (a i)) := by
    simp [boundaryCochain, omittedIndex_faceOrdIndex]
  have h := congrArg (F.presheaf.map (homOfLE hTi).op)
    (unit_inverse_smul hu.unit (F.presheaf.map (homOfLE hWi).op (a i)))
  rw [Scheme.Modules.map_smul, Scheme.Modules.map_smul] at h
  rw [prod_res_eq_mul_face f W i hTi, mul_smul]
  congr 1
  show _ • (((-1 : ℤ) ^ (i : ℕ)) •
    F.presheaf.map (homOfLE hTi).op (boundaryCochain f F W a (faceOrdIndex n i))) = _
  rw [hz, map_zsmul, sign_smul_sign]
  simpa [← F.presheaf.map_comp_apply, ← op_comp, homOfLE_comp] using h

private lemma exists_boundary_succ {X : Scheme.{u}} {n : ℕ} (f : Fin (n + 2) → Γ(X, ⊤))
    (F : X.Modules) (W : X.Opens) (x y : Γ((data f F).complex.X (n + 2), W))
    (a : Fin (n + 2) → Γ(F, W))
    (hTopU : CechCochains.inter (fun i => W ⊓ X.basicOpen (f i)) (topOrdIndex n).1 ≤ W)
    (hxy : X.presheaf.map (homOfLE le_top :
        CechCochains.inter (fun i => W ⊓ X.basicOpen (f i)) (topOrdIndex n).1 ⟶ ⊤).op
        (∏ i, f i) •
        ((data f F).sectionsIso (n + 1) W x (topOrdIndex n) -
          (data f F).sectionsIso (n + 1) W y (topOrdIndex n)) =
      ∑ i, X.presheaf.map (homOfLE le_top :
          CechCochains.inter (fun i => W ⊓ X.basicOpen (f i)) (topOrdIndex n).1 ⟶ ⊤).op
          (f i) •
        F.presheaf.map (homOfLE hTopU).op (a i)) :
    ∃ z, ((data f F).complex.d (n + 1) (n + 2)).app W z = x - y := by
  have hu : IsUnit (X.presheaf.map (homOfLE le_top :
      CechCochains.inter (fun i => W ⊓ X.basicOpen (f i)) (topOrdIndex n).1 ⟶ ⊤).op
      (∏ i, f i)) :=
    unit_prod_on_inter f W (n + 1) (topOrdIndex n)
  refine ⟨((data f F).sectionsIso n W).symm (boundaryCochain f F W a),
    ((data f F).sectionsIso (n + 1) W).injective ?_⟩
  rw [(data f F).differential_succ n W, AddEquiv.apply_symm_apply, map_sub]
  funext q
  obtain rfl := topOrdIndex_unique q
  show _ = (data f F).sectionsIso (n + 1) W x (topOrdIndex n) -
    (data f F).sectionsIso (n + 1) W y (topOrdIndex n)
  apply hu.smul_left_cancel.mp
  rw [hxy]
  show _ • (∑ i : Fin (n + 2), ((-1 : ℤ) ^ (i : ℕ)) •
    CechCochains.restr (Scheme.Modules.presheaf F)
      (CechCochains.inter_le_omit (fun k => W ⊓ X.basicOpen (f k)) (topOrdIndex n).1 i)
      (boundaryCochain f F W a ⟨(topOrdIndex n).1 ∘ i.succAbove,
        CechCochains.strictMono_omit (topOrdIndex n).2 i⟩)) = _
  rw [Finset.smul_sum]
  exact Finset.sum_congr rfl fun i _ => smul_face_boundaryCochain f F W a hTopU i

private lemma exists_boundary_of_eq_mod_equations {X : Scheme.{u}} {c : ℕ}
    (f : Fin (c + 1) → Γ(X, ⊤)) (F : X.Modules) {W V : X.Opens} (hWV : W ≤ V)
    (s t : Γ(F, V)) (x y : Γ((data f F).complex.X (c + 1), V))
    (a : Fin (c + 1) → Γ(F, W))
    (hmod : (Scheme.Modules.presheaf F).map (homOfLE hWV).op (s - t) =
      ∑ i, (X.presheaf.map (homOfLE le_top : W ⟶ ⊤).op (f i)) • a i)
    (hx : ∀ q : CechCochains.OrdIndex (I := Fin (c + 1)) c,
      (X.presheaf.map (homOfLE le_top :
        CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) q.1 ⟶ ⊤).op
        (∏ i, f i)) •
        ((data f F).sectionsIso c V x q) =
      (Scheme.Modules.presheaf F).map
        (homOfLE (show
          CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) q.1 ≤ V from
            (iInf_le _ (0 : Fin (c + 1))).trans inf_le_left)).op s)
    (hy : ∀ q : CechCochains.OrdIndex (I := Fin (c + 1)) c,
      (X.presheaf.map (homOfLE le_top :
        CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) q.1 ⟶ ⊤).op
        (∏ i, f i)) •
        ((data f F).sectionsIso c V y q) =
      (Scheme.Modules.presheaf F).map
        (homOfLE (show
          CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) q.1 ≤ V from
            (iInf_le _ (0 : Fin (c + 1))).trans inf_le_left)).op t) :
    ∃ z, ((data f F).complex.d c (c + 1)).app W z =
      ((data f F).complex.X (c + 1)).presheaf.map (homOfLE hWV).op x -
        ((data f F).complex.X (c + 1)).presheaf.map (homOfLE hWV).op y := by
  have key (q : CechCochains.OrdIndex (I := Fin (c + 1)) c) :
      X.presheaf.map (homOfLE le_top :
        CechCochains.inter (fun i => W ⊓ X.basicOpen (f i)) q.1 ⟶ ⊤).op (∏ i, f i) •
        ((data f F).sectionsIso c W (((data f F).complex.X (c + 1)).presheaf.map
            (homOfLE hWV).op x) q -
          (data f F).sectionsIso c W (((data f F).complex.X (c + 1)).presheaf.map
            (homOfLE hWV).op y) q) =
      ∑ i, X.presheaf.map (homOfLE le_top :
          CechCochains.inter (fun i => W ⊓ X.basicOpen (f i)) q.1 ⟶ ⊤).op (f i) •
        F.presheaf.map (homOfLE (cech_inter_le f W q)).op (a i) := by
    rw [smul_sub, prod_smul_sectionsIso_restrict f F hWV s x q (hx q),
      prod_smul_sectionsIso_restrict f F hWV t y q (hy q), ← map_sub]
    have hm := congrArg (F.presheaf.map (homOfLE (cech_inter_le f W q)).op) hmod
    rw [map_sum] at hm
    simpa only [Scheme.Modules.map_smul, ← Functor.map_comp_apply, ← op_comp,
      homOfLE_comp] using hm
  cases c with
  | zero =>
      let q : CechCochains.OrdIndex (I := Fin 1) 0 :=
        ⟨fun _ => 0, by
          intro i j hij
          fin_cases i
          fin_cases j
          simp_all⟩
      have hWB : CechCochains.inter (fun i => W ⊓ X.basicOpen (f i)) q.1 ≤
          X.basicOpen (f 0) := by
        simp only [CechCochains.inter, q]
        exact (iInf_le _ 0).trans inf_le_right
      have hk := key q
      rw [Fin.prod_univ_one, Fin.sum_univ_one] at hk
      exact exists_boundary_one f F W _ _ (a 0) q (cech_inter_le f W q)
        ((unit_on_basic_open_le (f 0) hWB).smul_left_cancel.mp hk)
  | succ n =>
      exact exists_boundary_succ f F W _ _ a (cech_inter_le f W _) (key _)

/-- Fractions with congruent numerators have the same class in the final
Čech cokernel. -/
@[stacks 0G7Q "fraction_class_well_defined"]
public lemma cokernel_π_app_eq_of_eq_mod_equations
    {X : Scheme.{u}} {c : ℕ} {ι : Type*} (f : Fin (c + 1) → Γ(X, ⊤))
    (F : X.Modules) (V : X.Opens) (U : ι → X.Opens)
    (hU : ∀ i, U i ≤ V) (hcover : ⨆ i, U i = V)
    (s t : Γ(F, V))
    (x y : Γ((data f F).complex.X (c + 1), V))
    (a : ∀ j : ι, Fin (c + 1) → Γ(F, U j))
    (hmod : ∀ j,
      (Scheme.Modules.presheaf F).map (homOfLE (hU j)).op (s - t) =
        ∑ i, (X.presheaf.map (homOfLE le_top : U j ⟶ ⊤).op (f i)) • a j i)
    (hx : ∀ q : CechCochains.OrdIndex (I := Fin (c + 1)) c,
      (X.presheaf.map (homOfLE le_top :
        CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) q.1 ⟶ ⊤).op
        (∏ i, f i)) •
        ((data f F).sectionsIso c V x q) =
      (Scheme.Modules.presheaf F).map
        (homOfLE (show
          CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) q.1 ≤ V from
            (iInf_le _ (0 : Fin (c + 1))).trans inf_le_left)).op s)
    (hy : ∀ q : CechCochains.OrdIndex (I := Fin (c + 1)) c,
      (X.presheaf.map (homOfLE le_top :
        CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) q.1 ⟶ ⊤).op
        (∏ i, f i)) •
        ((data f F).sectionsIso c V y q) =
      (Scheme.Modules.presheaf F).map
        (homOfLE (show
          CechCochains.inter (fun i => V ⊓ X.basicOpen (f i)) q.1 ≤ V from
            (iInf_le _ (0 : Fin (c + 1))).trans inf_le_left)).op t) :
    (cokernel.π ((data f F).complex.d c (c + 1))).app V x =
      (cokernel.π ((data f F).complex.d c (c + 1))).app V y := by
  apply sections_ext_of_cover (cokernel _) V U hU hcover
  intro j
  rw [section_map_natural (cokernel.π ((data f F).complex.d c (c + 1))) (hU j) x,
    section_map_natural (cokernel.π ((data f F).complex.d c (c + 1))) (hU j) y]
  obtain ⟨z, hz⟩ :=
    exists_boundary_of_eq_mod_equations f F (hU j) s t x y (a j) (hmod j) hx hy
  exact cokernel_π_app_eq_of_app_eq_sub _ _ z hz

end AlgebraicGeometry.ExtendedAlternatingCech
