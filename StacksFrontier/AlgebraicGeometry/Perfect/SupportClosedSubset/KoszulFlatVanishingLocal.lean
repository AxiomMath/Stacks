namespace AlgebraicGeometry

/-- **Restriction to an open subscheme preserves flatness of a quasi-coherent module.**

Flatness of a quasi-coherent module is equivalent to flatness of each module of sections over an
affine open (`AlgebraicGeometry.isFlat_iff_forall_flat_sections`), an affine open `W` of the open
subscheme `V` is the affine open `V.ι ''ᵁ W` of `X`, and the sections of the restriction over `W`
are the sections of the module over that affine open, with the same scalars. -/
public theorem isFlat_restrictFunctor {X : Scheme.{u}} (V : X.Opens) (F : X.Modules)
    [F.IsQuasicoherent]
    (hF : AlgebraicGeometry.SheafOfModules.IsFlat
      (C := TopologicalSpace.Opens X.toTopCat)
      (J := Opens.grothendieckTopology X.toTopCat) (O := X.sheaf) F) :
    AlgebraicGeometry.SheafOfModules.IsFlat
      (C := TopologicalSpace.Opens V.toScheme.toTopCat)
      (J := Opens.grothendieckTopology V.toScheme.toTopCat) (O := V.toScheme.sheaf)
      ((Scheme.Modules.restrictFunctor V.ι).obj F) := by
  have hqc : ((Scheme.Modules.restrictFunctor V.ι).obj F).IsQuasicoherent :=
    Scheme.Modules.isQuasicoherent_restrictFunctor V.ι F
  refine isFlat_of_forall_flat_sections _ ?_
  intro W hW
  have himg : IsAffineOpen (V.ι ''ᵁ W) := hW.image_of_isOpenImmersion V.ι
  have h := flat_sections_of_isFlat F hF himg
  have e := Stacks.Conormal.CotangentAppIso.restrictFunctorSectionsIso F V W
  let iM : Module Γ(↑V, W) (F.val.obj (Opposite.op (V.ι ''ᵁ W))) :=
    (F.val.obj (Opposite.op (V.ι ''ᵁ W))).isModule
  have hM : Module.Flat Γ(↑V, W) (F.val.obj (Opposite.op (V.ι ''ᵁ W))) := h
  exact Module.Flat.of_linearEquiv e.toLinearEquiv

end AlgebraicGeometry

namespace Stacks.Perfect.LocalCohomologyDegrees

attribute [local instance] HasDerivedCategory.standard

/-- **A Koszul-regular sequence of global functions on an affine scheme restricts to a
Koszul-regular sequence on every affine open.**  The restriction map `Γ(Y, ⊤) → Γ(Y, W)` between
affine opens is flat, and a Koszul-regular sequence stays Koszul-regular under flat base change
(Stacks 062H). -/
public theorem isKoszulRegular_restrictOpen_of_isAffine {Y : Scheme.{u}} [IsAffine Y] {c : ℕ}
    (f : Fin c → Γ(Y, ⊤)) (hf : Koszul.IsKoszulRegular f) (W : Y.Opens) (hW : IsAffineOpen W) :
    Koszul.IsKoszulRegular (fun i => TopCat.Presheaf.restrictOpen (f i) W le_top) := by
  have hflat : RingHom.Flat (Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom :=
    Stacks.Adequate.flat_presheaf_map_of_isAffineOpen hW (isAffineOpen_top Y) le_top
  let : Algebra Γ(Y, ⊤) Γ(Y, W) := (Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.toAlgebra
  have : Module.Flat Γ(Y, ⊤) Γ(Y, W) := hflat
  exact Stacks.AlgebraicGeometry.RegularIdealSheaf.isKoszulRegular_algebraMap_of_flat f hf

/-- **Stacks Project, Tag 0G7P**, the vanishing below degree `c`.  Let `X` be a scheme and let
`Z ⊆ X` be a closed subset which can locally be cut out by a Koszul-regular sequence of `c`
elements of the structure sheaf.  Then the local cohomology sheaves of a flat quasi-coherent
`𝒪_X`-module vanish below degree `c`:

`ℋ ^i_Z(ℱ) = 0` for `i < c`.

The proof is the localization argument of Stacks 0G7N applied to the global-equations statement
`Stacks.Perfect.KoszulFlatVanishing.isZero_homology_derivedSupportedSections_of_lt`: the local
cohomology sheaf is computed on a resolution of `ℱ` by injectives, it vanishes as soon as it does
on an open cover, and over an affine open of the cover the equations are global and their
restrictions to the affine opens there are Koszul-regular by
`isKoszulRegular_restrictOpen_of_isAffine`, while the restriction of `ℱ` is flat and
quasi-coherent by `AlgebraicGeometry.isFlat_restrictFunctor` and
`AlgebraicGeometry.Scheme.Modules.isQuasicoherent_restrictFunctor`. -/
public theorem isZero_homology_derivedSupportedSections_of_locallyKoszulRegular_of_lt
    {X : Scheme.{u}} (Z : Set X) (hZ : IsClosed Z) (c : ℕ)
    (hcut : ∀ x : X, ∃ U : X.Opens, x ∈ U ∧ IsAffineOpen U ∧
      ∃ f : Fin c → Γ(U.toScheme, ⊤), Koszul.IsKoszulRegular f ∧
        U.ι ⁻¹' Z = equationsClosedSet f)
    (F : X.Modules) [F.IsQuasicoherent]
    (hflat : AlgebraicGeometry.SheafOfModules.IsFlat
      (C := TopologicalSpace.Opens X.toTopCat)
      (J := Opens.grothendieckTopology X.toTopCat) (O := X.sheaf) F)
    (i : ℤ) (hi : i < (c : ℤ)) :
    IsZero ((DerivedCategory.homologyFunctor
        (SheafOfModules.{u} (structureSheafRing (closedSubsetRingedSpace X.toRingedSpace Z))) i).obj
      ((derivedSupportedSectionsOnClosed X.toRingedSpace Z hZ).obj
        ((DerivedCategory.singleFunctor X.Modules 0).obj F))) := by
  classical
  obtain ⟨I, r, hr, hinj, hIGE⟩ :=
    CochainComplex.Plus.modelCategoryQuillen.exists_quasiIso_injective
      ((CochainComplex.singleFunctor X.Modules 0).obj F) 0
  have hKI : I.IsKInjective := @CochainComplex.isKInjective_of_injective _ _ _ I 0 hIGE hinj
  have hQr : IsIso (DerivedCategory.Q.map r) :=
    (DerivedCategory.isIso_Q_map_iff_quasiIso _ r).2 hr
  have eF : (DerivedCategory.singleFunctor X.Modules 0).obj F ≅ DerivedCategory.Q.obj I :=
    (DerivedCategory.singleFunctorIsoCompQ X.Modules 0).app F ≪≫
      @asIso _ _ _ _ (DerivedCategory.Q.map r) hQr
  refine IsZero.of_iso ?_ ((DerivedCategory.homologyFunctor _ i).mapIso
    ((derivedSupportedSectionsOnClosed X.toRingedSpace Z hZ).mapIso eF))
  refine isZero_homology_derivedSupportedSections_of_isZero X.toRingedSpace Z hZ I hKI i ?_
  choose V hxV hVaff f hfK hfZ using hcut
  refine Stacks.AlgebraicGeometry.TopDegreeBaseChange.isZero_of_isZero_restrict_cover V ?_ _ ?_
  · refine eq_top_iff.2 ?_
    intro x _
    exact TopologicalSpace.Opens.mem_iSup.2 ⟨x, hxV x⟩
  intro x
  refine IsZero.of_iso ?_ (mapHomologyIso
    (Scheme.Modules.restrictFunctor (V x).ι)
    (((supportedSectionsFunctor X.toRingedSpace Z).mapHomologicalComplex
      (ComplexShape.up ℤ)).obj I) i).symm
  obtain ⟨e⟩ := exists_supportedSectionsComplexRestrictIso Z (V x) I
  refine IsZero.of_iso ?_ ((HomologicalComplex.homologyFunctor _ (ComplexShape.up ℤ) i).mapIso e)
  -- the restricted resolution
  have hinj' : ∀ n, Injective
      ((((Scheme.Modules.restrictFunctor (V x).ι).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj I).X n) := fun n =>
    have : Injective (I.X n) := hinj n
    injective_restrictFunctor_obj (V x) (I.X n)
  have hIGE' := isStrictlyGE_restrictFunctor (V x) I hIGE
  have hKI' : CochainComplex.IsKInjective
      (((Scheme.Modules.restrictFunctor (V x).ι).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj I) :=
    @CochainComplex.isKInjective_of_injective _ _ _ _ 0 hIGE' hinj'
  have hZ' : IsClosed ((V x).ι ⁻¹' Z) := hZ.preimage (V x).ι.continuous
  refine isZero_homology_supportedSectionsComplex_of_isZero (V x).toScheme.toRingedSpace
    ((V x).ι ⁻¹' Z) hZ' _ hKI' i ?_
  -- compare with the single complex on the open subscheme
  have eI : DerivedCategory.Q.obj
        (((Scheme.Modules.restrictFunctor (V x).ι).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj I) ≅
      (DerivedCategory.singleFunctor (V x).toScheme.Modules 0).obj
        ((Scheme.Modules.restrictFunctor (V x).ι).obj F) :=
    ((Scheme.Modules.restrictFunctor (V x).ι).mapDerivedCategoryFactors.app I).symm ≪≫
      (Scheme.Modules.restrictFunctor (V x).ι).mapDerivedCategory.mapIso eF.symm ≪≫
      ((Scheme.Modules.restrictFunctor (V x).ι).mapDerivedCategorySingleFunctor 0).app F
  refine IsZero.of_iso ?_ ((DerivedCategory.homologyFunctor _ i).mapIso
    ((derivedSupportedSectionsOnClosed (V x).toScheme.toRingedSpace ((V x).ι ⁻¹' Z) hZ').mapIso
      eI))
  -- the global-equations case on the open subscheme
  have : IsAffine (V x).toScheme := hVaff x
  have hqc : ((Scheme.Modules.restrictFunctor (V x).ι).obj F).IsQuasicoherent :=
    Scheme.Modules.isQuasicoherent_restrictFunctor (V x).ι F
  have hflat' := AlgebraicGeometry.isFlat_restrictFunctor (V x) F hflat
  have hfaff : ∀ W : (V x).toScheme.affineOpens,
      Koszul.IsKoszulRegular
        (fun j => TopCat.Presheaf.restrictOpen (f x j) (W : (V x).toScheme.Opens) le_top) :=
    fun W => isKoszulRegular_restrictOpen_of_isAffine (f x) (hfK x) W.1 W.2
  have key : ∀ (Z' : Set (V x).toScheme) (hZ'' : IsClosed Z'),
      Z' = equationsClosedSet (f x) →
      IsZero ((DerivedCategory.homologyFunctor
          (SheafOfModules.{u} (structureSheafRing (closedSubsetRingedSpace
            (V x).toScheme.toRingedSpace Z'))) i).obj
        ((derivedSupportedSectionsOnClosed (V x).toScheme.toRingedSpace Z' hZ'').obj
          ((DerivedCategory.singleFunctor (V x).toScheme.Modules 0).obj
            ((Scheme.Modules.restrictFunctor (V x).ι).obj F)))) := by
    intro Z' hZ'' hEq
    subst hEq
    exact Stacks.Perfect.KoszulFlatVanishing.isZero_homology_derivedSupportedSections_of_lt
      hflat' hfaff i hi
  exact key _ hZ' (hfZ x)

/-- **Stacks Project, Tag 0G7P.**  Let `X` be a scheme.  Let `Z ⊆ X` be a closed subset which can
locally be cut out by a Koszul-regular sequence having `c` elements.  Then

`ℋ ^i_Z(ℱ) = 0` for `i ≠ c`

for every flat, quasi-coherent `𝒪_X`-module `ℱ`.

Above degree `c` this is Stacks 0G7N, which needs neither the Koszul-regularity of the equations
nor the flatness of `ℱ`
(`isZero_homology_derivedSupportedSections_of_locallyKoszulRegular`); below degree `c` it needs
both and is
`isZero_homology_derivedSupportedSections_of_locallyKoszulRegular_of_lt`.

"Locally" is read with affine open neighbourhoods, which by Stacks 063G is the same condition as
the source's; see the implementation notes of this file. -/
@[stacks 0G7P "the whole statement: for a closed subset locally cut out by a Koszul-regular
sequence of c elements and a flat quasi-coherent module, the vanishing of the local cohomology
sheaf in every degree other than c; exactly the source's conditions, with locally read
over affine open neighbourhoods, which Stacks 063G shows is the same condition"]
public theorem isZero_homology_derivedSupportedSections_of_locallyKoszulRegular_of_ne
    {X : Scheme.{u}} (Z : Set X) (hZ : IsClosed Z) (c : ℕ)
    (hcut : ∀ x : X, ∃ U : X.Opens, x ∈ U ∧ IsAffineOpen U ∧
      ∃ f : Fin c → Γ(U.toScheme, ⊤), Koszul.IsKoszulRegular f ∧
        U.ι ⁻¹' Z = equationsClosedSet f)
    (F : X.Modules) [F.IsQuasicoherent]
    (hflat : AlgebraicGeometry.SheafOfModules.IsFlat
      (C := TopologicalSpace.Opens X.toTopCat)
      (J := Opens.grothendieckTopology X.toTopCat) (O := X.sheaf) F)
    (i : ℤ) (hi : i ≠ (c : ℤ)) :
    IsZero ((DerivedCategory.homologyFunctor
        (SheafOfModules.{u} (structureSheafRing (closedSubsetRingedSpace X.toRingedSpace Z))) i).obj
      ((derivedSupportedSectionsOnClosed X.toRingedSpace Z hZ).obj
        ((DerivedCategory.singleFunctor X.Modules 0).obj F))) := by
  rcases lt_or_gt_of_ne hi with h | h
  · exact isZero_homology_derivedSupportedSections_of_locallyKoszulRegular_of_lt Z hZ c hcut F
      hflat i h
  · exact isZero_homology_derivedSupportedSections_of_locallyKoszulRegular Z hZ c
      (fun x => (hcut x).imp fun _ hU => ⟨hU.1, hU.2.2.imp fun _ hf => ⟨hf.1, hf.2⟩⟩) F i h

end Stacks.Perfect.LocalCohomologyDegrees

