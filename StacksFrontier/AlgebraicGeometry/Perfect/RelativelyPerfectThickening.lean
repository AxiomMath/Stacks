namespace Stacks.Thickenings

/-! ### The ring-level engine -/

/-- A flat `R`-algebra `A` is Tor independent from every `R`-algebra `B`: the higher Tor modules
`Torᵢ^R(A, B)` are computed by tensoring a projective resolution of `B` with the flat module `A`,
and that preserves exactness. -/
lemma torIndependent_of_flat_left
    {R A B : Type u} [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] [Module.Flat R A] :
    RingTheory.TorIndependence.TorIndependent R A B := by
  rw [RingTheory.TorIndependence.torIndependent_iff_isZero_tor]
  intro p hp
  obtain ⟨n, rfl⟩ : ∃ n, p = n + 1 := ⟨p - 1, by omega⟩
  exact isZero_Tor_succ_of_flat (ModuleCat.of R A) (ModuleCat.of R B) n

/-- **The Tor-amplitude half of Stacks 0DJG, with no finiteness hypothesis on `A'`.**

Let `R' → R` be a surjective ring map with nilpotent kernel, let `A'` be a flat `R'`-algebra and
let `A` be the base change `A' ⊗_{R'} R`, presented as a pushout square. If the derived extension
of scalars of `K' ∈ D(A')` to `A` has Tor amplitude in `[a, b]` over `R`, then `K'` has Tor
amplitude in `[a, b]` over `R'`.

Restricting to `R` and extending along `R' → R` agree, which is Stacks 065Z — the comparison is
invertible because `A'` is flat over `R'`, hence Tor independent from `R` over `R'` (Stacks 0661)
— and the transfer along `R' → R` is then the nilpotent dévissage of Stacks 0H75.

Unlike Stacks 0DJG this carries no `Algebra.FinitePresentation` hypothesis: finite presentation
enters only the pseudo-coherence half of that tag. That matters because the intended application
is at local rings, which are not of finite presentation over the local rings of the base. -/
public theorem hasTorAmplitudeCanonical_of_derivedExtensionScalars
    {R' A' R A : Type u} [CommRing R'] [CommRing A'] [CommRing R] [CommRing A]
    [Algebra R' A'] [Algebra R' R] [Algebra R' A] [Algebra A' A] [Algebra R A]
    [IsScalarTower R' A' A] [IsScalarTower R' R A] [Algebra.IsPushout R' A' R A]
    [Module.Flat R' A']
    (hsurj : Function.Surjective (algebraMap R' R))
    (hnil : IsNilpotent (RingHom.ker (algebraMap R' R)))
    (K' : DerivedCategory (ModuleCat.{u} A'))
    (K : DerivedCategory (ModuleCat.{u} A))
    (eK : (CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars.{u, u, u}
      (algebraMap A' A)).functor.obj K' ≅ K)
    (a b : ℤ)
    (hK : StacksDraft.TorAmplitude.HasTorAmplitudeCanonical R
      ((ModuleCat.restrictScalars (algebraMap R A)).mapDerivedCategory.obj K) a b) :
    StacksDraft.TorAmplitude.HasTorAmplitudeCanonical R'
      ((ModuleCat.restrictScalars (algebraMap R' A')).mapDerivedCategory.obj K') a b := by
  let Dbase := CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars.{u, u, u}
    (algebraMap R' R)
  let Dtop := CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars.{u, u, u}
    (algebraMap A' A)
  let Res := (ModuleCat.restrictScalars (algebraMap R' A')).mapDerivedCategory
  let sq : (algebraMap A' A).comp (algebraMap R' A') =
      (algebraMap R A).comp (algebraMap R' R) :=
    (IsScalarTower.algebraMap_eq R' A' A).symm.trans (IsScalarTower.algebraMap_eq R' R A)
  let cmp :=
    @RingTheory.TorIndependence.derivedBaseChangeComparison.{u, u, u, u, u, u + 1, u + 1, u + 1,
      u + 1}
    R' A' R A _ _ _ _ _ _ _ _
    (algebraMap R' A') (algebraMap R' R) (algebraMap A' A) (algebraMap R A)
    sq Dbase.functor Dtop.functor Dbase.comparison Dtop.comparison
    Dbase.isLeftDerived Dtop.isLeftDerived
  have hcmp : IsIso cmp.2.1 :=
    @RingTheory.TorIndependence.derivedBaseChangeComparison_isIso_of_torIndependent.{u, u, u, u,
      u, u + 1, u + 1, u + 1, u + 1}
    R' A' R A _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
    torIndependent_of_flat_left Dbase.functor Dtop.functor Dbase.comparison Dtop.comparison
    Dbase.isLeftDerived Dtop.isLeftDerived
  have hcmpK : IsIso (cmp.2.1.app K') := by
    have : IsIso cmp.2.1 := hcmp
    infer_instance
  have hbase : StacksDraft.TorAmplitude.HasTorAmplitudeCanonical R
      (Dbase.functor.obj (Res.obj K')) a b :=
    AlgebraicGeometry.BaseChangeTorAmplitude.hasTorAmplitudeCanonical_of_iso
      (asIso (cmp.2.1.app K') ≪≫
        (ModuleCat.restrictScalars (algebraMap R A)).mapDerivedCategory.mapIso eK).symm a b hK
  exact (StacksDraft.TorAmplitude.hasTorAmplitudeIn_canonical_iff R' (Res.obj K') a b).mp
    ((@StacksDraft.TorAmplitude.hasTorAmplitudeIn_derivedExtensionScalars_iff_sameUniverse.{u}
      R' R _ _ (algebraMap R' R) hsurj hnil Dbase.functor Dbase.comparison Dbase.isLeftDerived
      (CochainComplex.DerivedTensor.canonicalDerivedTensorProduct R')
      (CochainComplex.DerivedTensor.canonicalDerivedTensorProduct R)
      (Res.obj K') a b).mp
        ((StacksDraft.TorAmplitude.hasTorAmplitudeIn_canonical_iff R
          (Dbase.functor.obj (Res.obj K')) a b).mpr hbase))

/-! ### The local rings of a finite-order thickening -/

/-- Kernels, and their nilpotence, transport across a square whose horizontal legs are
bijective. -/
private lemma isNilpotent_ker_of_bijective_square {A B C D : Type*}
    [CommRing A] [CommRing B] [CommRing C] [CommRing D]
    (α : A →+* C) (β : B →+* D) (φ : A →+* B) (ψ : C →+* D)
    (hα : Function.Bijective α) (hβ : Function.Bijective β)
    (hsq : β.comp φ = ψ.comp α)
    (hψ : IsNilpotent (RingHom.ker ψ)) : IsNilpotent (RingHom.ker φ) := by
  let eA : A ≃+* C := RingEquiv.ofBijective α hα
  let eB : B ≃+* D := RingEquiv.ofBijective β hβ
  have hsq' : eB.toRingHom.comp φ = ψ.comp eA.toRingHom := hsq
  have hker : Ideal.map eA.toRingHom (RingHom.ker φ) = RingHom.ker ψ := by
    ext c
    rw [Ideal.mem_map_iff_of_surjective eA.toRingHom eA.surjective]
    constructor
    · rintro ⟨a, ha, rfl⟩
      rw [RingHom.mem_ker] at ha ⊢
      simpa [ha] using (DFunLike.congr_fun hsq' a).symm
    · intro hc
      obtain ⟨a, rfl⟩ := eA.surjective c
      refine ⟨a, ?_, rfl⟩
      rw [RingHom.mem_ker] at hc ⊢
      exact eB.injective (by simpa [hc] using DFunLike.congr_fun hsq' a)
  obtain ⟨n, hn⟩ := hψ
  rw [Ideal.zero_eq_bot] at hn
  refine ⟨n, ?_⟩
  rw [Ideal.zero_eq_bot]
  refine le_antisymm (fun a ha => Ideal.mem_bot.mpr ?_) bot_le
  have h1 : Ideal.map eA.toRingHom (RingHom.ker φ ^ n) = RingHom.ker ψ ^ n := by
    rw [Ideal.map_pow, hker]
  have h2 : eA a ∈ RingHom.ker ψ ^ n := h1 ▸ Ideal.mem_map_of_mem _ ha
  rw [hn, Ideal.mem_bot] at h2
  exact eA.injective (by simpa using h2)

/-- **The local rings of a finite-order thickening.** For a finite-order thickening
`i : X ⟶ X'` and a point `x` of `X`, the stalk map `𝒪_{X', i x} ⟶ 𝒪_{X, x}` is surjective with
nilpotent kernel.

Surjectivity is surjectivity on stalks of a closed immersion. For the kernel, choose an affine
open `U ∋ i x` of `X'`; on it the thickening is the surjection `Γ(X', U) ⟶ Γ(X, i⁻¹U)`, whose
kernel is the value of the kernel ideal sheaf there and so has a vanishing power. The stalk map
is `Localization.localRingHom` of that surjection, by
`AlgebraicGeometry.IsAffineOpen.arrowStalkMapIso`, and the kernel of a localization of a
surjection is the localization of the kernel, by `IsLocalization.ker_map`. -/
public theorem surjective_and_isNilpotent_ker_stalkMap {X X' : Scheme.{u}} {i : X ⟶ X'}
    (hi : IsFiniteOrderThickening i) (x : X) :
    Function.Surjective (i.stalkMap x).hom ∧
      IsNilpotent (RingHom.ker (i.stalkMap x).hom) := by
  have : IsClosedImmersion i := hi.1
  refine ⟨i.stalkMap_surjective x, ?_⟩
  obtain ⟨-, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X'.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (i.base x)) isOpen_univ
  have hUa : IsAffineOpen U := hU
  have hV : IsAffineOpen (i ⁻¹ᵁ U) := hUa.preimage i
  have hxV : x ∈ i ⁻¹ᵁ U := hxU
  set g : Γ(X', U) →+* Γ(X, i ⁻¹ᵁ U) := (i.appLE U (i ⁻¹ᵁ U) le_rfl).hom with hgdef
  have hgsurj : Function.Surjective g := by
    rw [hgdef, Scheme.Hom.appLE_eq_app i]
    exact i.app_surjective U hUa
  obtain ⟨n, hn⟩ := hi.2
  have hpow : RingHom.ker g ^ (n + 1) = ⊥ := by
    have hker : RingHom.ker g = i.ker.ideal ⟨U, hUa⟩ := by
      rw [hgdef, Scheme.Hom.appLE_eq_app i, i.ker_apply ⟨U, hUa⟩]
    rw [hker]
    simpa [Scheme.IdealSheafData.ideal_pow, Scheme.IdealSheafData.ideal_bot] using
      congrArg (fun J : X'.IdealSheafData => J.ideal ⟨U, hUa⟩) hn
  set p := hUa.primeIdealOf ⟨i.base x, hxV⟩
  set q := hV.primeIdealOf ⟨x, hxV⟩
  have hcomap : p.asIdeal = Ideal.comap g q.asIdeal :=
    congr($(IsAffineOpen.comap_primeIdealOf_appLE U hUa (i ⁻¹ᵁ U) hV le_rfl hxV).1).symm
  have hT : Submonoid.map g p.asIdeal.primeCompl = q.asIdeal.primeCompl := by
    simpa only [hcomap] using Ideal.map_primeCompl_comap_of_surjective g hgsurj q.asIdeal
  set loc := Localization.localRingHom p.asIdeal q.asIdeal g hcomap with hloc
  have hkerLoc : RingHom.ker loc =
      Ideal.map (algebraMap Γ(X', U) (Localization.AtPrime p.asIdeal)) (RingHom.ker g) := by
    simpa [hloc, Localization.localRingHom] using
      IsLocalization.ker_map (Localization.AtPrime q.asIdeal) g hT
  have hnilLoc : IsNilpotent (RingHom.ker loc) :=
    ⟨n + 1, by simp [hkerLoc, ← Ideal.map_pow, hpow]⟩
  set iso := IsAffineOpen.arrowStalkMapIso i U hUa (i ⁻¹ᵁ U) hV le_rfl hxV
  have hbijL : Function.Bijective iso.hom.left.hom :=
    (ConcreteCategory.isIso_iff_bijective iso.hom.left).mp inferInstance
  have hbijR : Function.Bijective iso.hom.right.hom :=
    (ConcreteCategory.isIso_iff_bijective iso.hom.right).mp inferInstance
  have hwsq : iso.hom.right.hom.comp (i.stalkMap x).hom = loc.comp iso.hom.left.hom := by
    simpa only [CommRingCat.hom_comp, Arrow.mk_hom, CommRingCat.hom_ofHom] using
      (congrArg CommRingCat.Hom.hom iso.hom.w).symm
  exact isNilpotent_ker_of_bijective_square iso.hom.left.hom iso.hom.right.hom
    (i.stalkMap x).hom loc hbijL hbijR hwsq hnilLoc

/-! ### The Tor-amplitude transfer at a point -/

/-- **Stacks 0DJY at a point, for the Tor-dimension clause.** Consider a cartesian diagram of
schemes with `i : X ⟶ X'`, `f : X ⟶ Y`, `f' : X' ⟶ Y'` and `j : Y ⟶ Y'`, with `f'` flat and `j`
a finite-order thickening. Let `E'` be an object of `D(𝒪_{X'})` and let `x` be a point of `X`.
If the stalk of `Li^*E'` at `x`, read over the local ring `𝒪_{Y, f x}`, has Tor amplitude in
`[a, b]`, then the stalk of `E'` at `i x`, read over the local ring `𝒪_{Y', j (f x)}`, has Tor
amplitude in `[a, b]`.

This is the whole local content of the Tor-dimension clause of the tag. The four local rings
form a pushout square, by
`Stacks.Cohomology.StalkPushout.isPushout_stalkMap_toAlgebra_of_isPullback`, because `j` — hence
its base change `i` — is a closed immersion; `𝒪_{X', i x}` is flat over `𝒪_{Y', j (f x)}`
because `f'` is flat; `𝒪_{Y', j (f x)} ⟶ 𝒪_{Y, f x}` is surjective with nilpotent kernel by
`Stacks.Thickenings.surjective_and_isNilpotent_ker_stalkMap`; and the stalk of a derived pullback
is the derived extension of scalars along the stalk map, by
`AlgebraicGeometry.derivedPullbackStalkIso`. The conclusion is then
`Stacks.Thickenings.hasTorAmplitudeCanonical_of_derivedExtensionScalars`.

The base point of the conclusion is written `j (f x)` rather than `f' (i x)`: the two are equal
only propositionally, and the structure map `𝒪_{Y', j (f x)} ⟶ 𝒪_{X', i x}` is accordingly the
stalk map of `f'` precomposed with `TopCat.Presheaf.stalkCongr`. That is the spelling the
pushout square of local rings is stated at. -/
public theorem hasTorAmplitudeCanonical_derivedStalk_of_isPullback
    {X X' Y Y' : Scheme.{u}} {i : X ⟶ X'} {f : X ⟶ Y} {f' : X' ⟶ Y'} {j : Y ⟶ Y'}
    (hpb : IsPullback i f f' j) (hj : IsFiniteOrderThickening j) [Flat f']
    (x : X) (hpt : j.base (f.base x) = f'.base (i.base x))
    (E' : DerivedCategory X'.Modules) (a b : ℤ)
    (hE : StacksDraft.TorAmplitude.HasTorAmplitudeCanonical (Y.presheaf.stalk (f.base x))
      ((ModuleCat.restrictScalars (f.stalkMap x).hom).mapDerivedCategory.obj
        ((AlgebraicGeometry.derivedStalkFunctor x).obj
          ((Stacks.Cohomology.DerivedAdjunctionOnRingedSpaces.derivedPullback
            i.toLRSHom.toShHom).obj E'))) a b) :
    StacksDraft.TorAmplitude.HasTorAmplitudeCanonical
        (Y'.presheaf.stalk (j.base (f.base x)))
      ((ModuleCat.restrictScalars
          ((Y'.presheaf.stalkCongr (Inseparable.of_eq hpt)).hom ≫
            f'.stalkMap (i.base x)).hom).mapDerivedCategory.obj
        ((AlgebraicGeometry.derivedStalkFunctor (i.base x)).obj E')) a b := by
  have hj' : IsClosedImmersion j := hj.1
  let : Algebra (Y'.presheaf.stalk (j.base (f.base x))) (Y.presheaf.stalk (f.base x)) :=
    (j.stalkMap (f.base x)).hom.toAlgebra
  let : Algebra (Y'.presheaf.stalk (j.base (f.base x))) (X'.presheaf.stalk (i.base x)) :=
    ((Y'.presheaf.stalkCongr (Inseparable.of_eq hpt)).hom ≫
      f'.stalkMap (i.base x)).hom.toAlgebra
  let : Algebra (Y'.presheaf.stalk (j.base (f.base x))) (X.presheaf.stalk x) :=
    ((Y'.presheaf.stalkCongr (Inseparable.of_eq hpt)).hom ≫ f'.stalkMap (i.base x) ≫
      i.stalkMap x).hom.toAlgebra
  let : Algebra (Y.presheaf.stalk (f.base x)) (X.presheaf.stalk x) :=
    (f.stalkMap x).hom.toAlgebra
  let : Algebra (X'.presheaf.stalk (i.base x)) (X.presheaf.stalk x) :=
    (i.stalkMap x).hom.toAlgebra
  have htower₁ : IsScalarTower (Y'.presheaf.stalk (j.base (f.base x)))
      (Y.presheaf.stalk (f.base x)) (X.presheaf.stalk x) :=
    IsScalarTower.of_algebraMap_eq' (by
      rw [RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra,
        RingHom.algebraMap_toAlgebra, ← CommRingCat.hom_comp,
        ← Stacks.Cohomology.StalkPushout.stalkMap_comm_of_isPullback hpb x hpt])
  have htower₂ : IsScalarTower (Y'.presheaf.stalk (j.base (f.base x)))
      (X'.presheaf.stalk (i.base x)) (X.presheaf.stalk x) :=
    IsScalarTower.of_algebraMap_eq' (by
      rw [RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra,
        RingHom.algebraMap_toAlgebra, ← CommRingCat.hom_comp, Category.assoc])
  have hpush : Algebra.IsPushout (Y'.presheaf.stalk (j.base (f.base x)))
      (X'.presheaf.stalk (i.base x)) (Y.presheaf.stalk (f.base x)) (X.presheaf.stalk x) :=
    (Stacks.Cohomology.StalkPushout.isPushout_stalk_of_isPullback hpb x hpt
      (RingHom.algebraMap_toAlgebra _) (RingHom.algebraMap_toAlgebra _)
      (RingHom.algebraMap_toAlgebra _)).symm
  have hflat : Module.Flat (Y'.presheaf.stalk (j.base (f.base x)))
      (X'.presheaf.stalk (i.base x)) := by
    have hcong : Function.Bijective
        (Y'.presheaf.stalkCongr (Inseparable.of_eq hpt)).hom.hom :=
      (ConcreteCategory.isIso_iff_bijective
        (Y'.presheaf.stalkCongr (Inseparable.of_eq hpt)).hom).mp inferInstance
    have : ((Y'.presheaf.stalkCongr (Inseparable.of_eq hpt)).hom ≫
        f'.stalkMap (i.base x)).hom.Flat :=
      RingHom.Flat.comp (RingHom.Flat.of_bijective hcong)
        (AlgebraicGeometry.Flat.stalkMap f' (i.base x))
    exact this
  obtain ⟨hsurj, hnil⟩ := surjective_and_isNilpotent_ker_stalkMap hj (f.base x)
  refine hasTorAmplitudeCanonical_of_derivedExtensionScalars
    (by simpa only [RingHom.algebraMap_toAlgebra] using hsurj)
    (by simpa only [RingHom.algebraMap_toAlgebra] using hnil)
    ((AlgebraicGeometry.derivedStalkFunctor (i.base x)).obj E') _ ?_ a b hE
  have halg : algebraMap (X'.presheaf.stalk (i.base x)) (X.presheaf.stalk x) =
      (i.stalkMap x).hom := RingHom.algebraMap_toAlgebra _
  exact (eqToIso (congrArg (fun φ : X'.presheaf.stalk (i.base x) →+* X.presheaf.stalk x =>
      (CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars.{u, u, u}
        φ).functor.obj ((AlgebraicGeometry.derivedStalkFunctor (i.base x)).obj E'))
    halg)).trans ((AlgebraicGeometry.derivedPullbackStalkIso i x).app E').symm

/-! ### Entering the covering of the Tor-dimension clause -/

/-- Canonical Tor amplitude depends only on the isomorphism class of an object of `D(R)`. -/
private lemma hasTorAmplitudeCanonical_iff_of_iso {R : Type u} [CommRing R]
    {E F : DerivedCategory (ModuleCat.{u} R)} (e : E ≅ F) (a b : ℤ) :
    StacksDraft.TorAmplitude.HasTorAmplitudeCanonical R E a b ↔
      StacksDraft.TorAmplitude.HasTorAmplitudeCanonical R F a b :=
  ⟨AlgebraicGeometry.BaseChangeTorAmplitude.hasTorAmplitudeCanonical_of_iso e a b,
    AlgebraicGeometry.BaseChangeTorAmplitude.hasTorAmplitudeCanonical_of_iso e.symm a b⟩

open StacksDraft.TorAmplitude AlgebraicGeometry.AffineRelativeTorAmplitude in
/-- Canonical Tor amplitude is unchanged by restricting scalars along a ring isomorphism, for an
arbitrary object of the derived category. This is
`hasTorAmplitudeCanonical_restrictScalars_ringEquiv_iff` of
`AlgebraicGeometry.AffineRelativeTorAmplitude`, stated there for an object in the image of
`DerivedCategory.Q`, transported along the canonical representative
`DerivedCategory.Q.objPreimage`. -/
theorem hasTorAmplitudeCanonical_restrictScalars_ringEquiv_iff'
    {R S : Type u} [CommRing R] [CommRing S] (e : R ≃+* S)
    (E : DerivedCategory (ModuleCat.{u} S)) (a b : ℤ) :
    HasTorAmplitudeCanonical R
        ((ModuleCat.restrictScalars e.toRingHom).mapDerivedCategory.obj E) a b ↔
      HasTorAmplitudeCanonical S E a b := by
  set K := DerivedCategory.Q.objPreimage E
  have eK : DerivedCategory.Q.obj K ≅ E := DerivedCategory.Q.objObjPreimageIso E
  have ei : (ModuleCat.restrictScalars e.toRingHom).mapDerivedCategory.obj E ≅
      DerivedCategory.Q.obj (((ModuleCat.restrictScalars e.toRingHom).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj K) :=
    (ModuleCat.restrictScalars e.toRingHom).mapDerivedCategory.mapIso eK.symm ≪≫
      (ModuleCat.restrictScalars e.toRingHom).mapDerivedCategoryFactors.app K
  rw [← hasTorAmplitudeCanonical_iff_of_iso eK a b]
  exact (hasTorAmplitudeCanonical_iff_of_iso ei a b).trans
    (hasTorAmplitudeCanonical_restrictScalars_ringEquiv_iff e K a b)

open StacksDraft.TorAmplitude in
/-- **Stacks 09U9 on an open subspace of a bare ringed space, with the stalks read upstairs.**
The restriction of an object of `D(𝒪_W)` to an open `U` has Tor amplitude in `[a, b]` on `W|_U`
exactly when at every point of `U` its stalk has canonical Tor amplitude in `[a, b]` over the
stalk ring of `W`.

Stacks 09U9 for the ringed space `W|_U` is
`Stacks.SheafOfModules.DerivedTensorStalk.hasTorAmplitudeCanonical_forall_stalk_iff`; its
quantifier runs over the points of `U`, and at such a point the stalk of the restriction is the
stalk on `W`, by `AlgebraicGeometry.RingedSpace.restrictModulesStalkNatIso` transported to
derived categories by `CategoryTheory.Functor.mapDerivedCategoryCompIso`. The change of
coefficient ring is along `AlgebraicGeometry.RingedSpace.restrictModulesStalkRingIso`, a ring
isomorphism, so it does not move canonical Tor amplitude. -/
public theorem hasTorAmplitude_restrictModules_iff_forall_stalk (W : RingedSpace.{u, u})
    (U : Opens W.carrier) (G : DerivedCategory (OXMod.{u, u} W)) (a b : ℤ) :
    Stacks.Cohomology.TorAmplitude.HasTorAmplitude (W.restrict U.isOpenEmbedding)
        ((RingedSpace.restrictModules.{u, u} W U).mapDerivedCategory.obj G) a b ↔
      ∀ y : W.carrier, y ∈ U →
        HasTorAmplitudeCanonical
          (TopCat.Presheaf.stalk (C := RingCat.{u}) (structureSheafOfRings.{u} W).obj y)
          ((AlgebraicGeometry.SheafOfModules.stalkFunctor (structureSheafOfRings.{u} W) y
            ).mapDerivedCategory.obj G) a b := by
  have per : ∀ (y : W.carrier) (hy : y ∈ U),
      HasTorAmplitudeCanonical
          (TopCat.Presheaf.stalk (C := RingCat.{u})
            (structureSheafOfRings.{u} (W.restrict U.isOpenEmbedding)).obj ⟨y, hy⟩)
          ((AlgebraicGeometry.SheafOfModules.stalkFunctor
            (structureSheafOfRings.{u} (W.restrict U.isOpenEmbedding)) ⟨y, hy⟩
              ).mapDerivedCategory.obj
            ((RingedSpace.restrictModules.{u, u} W U).mapDerivedCategory.obj G)) a b ↔
        HasTorAmplitudeCanonical
          (TopCat.Presheaf.stalk (C := RingCat.{u}) (structureSheafOfRings.{u} W).obj y)
          ((AlgebraicGeometry.SheafOfModules.stalkFunctor (structureSheafOfRings.{u} W) y
            ).mapDerivedCategory.obj G) a b := by
    intro y hy
    have hbij : Function.Bijective (RingedSpace.restrictModulesStalkRingIso W U hy).hom.hom :=
      (ConcreteCategory.isIso_iff_bijective
        (RingedSpace.restrictModulesStalkRingIso W U hy).hom).mp inferInstance
    have eobj := ((Functor.mapDerivedCategoryCompIsoOfCompIso
        (RingedSpace.restrictModulesStalkNatIso W U hy) ≪≫
      (Functor.mapDerivedCategoryCompIsoOfCompIso (Iso.refl
        (AlgebraicGeometry.SheafOfModules.stalkFunctor (structureSheafOfRings.{u} W) y ⋙
          ModuleCat.restrictScalars.{u}
            (RingedSpace.restrictModulesStalkRingIso W U hy).hom.hom))).symm).app G)
    exact (hasTorAmplitudeCanonical_iff_of_iso eobj a b).trans
      (hasTorAmplitudeCanonical_restrictScalars_ringEquiv_iff' (RingEquiv.ofBijective _ hbij) _ a b)
  exact (Stacks.SheafOfModules.DerivedTensorStalk.hasTorAmplitudeCanonical_forall_stalk_iff
      (W.restrict U.isOpenEmbedding).sheaf _ a b).trans
    ⟨fun h y hy => (per y hy).1 (h ⟨y, hy⟩), fun h z => (per z.1 z.2).2 (h z.1 z.2)⟩

/-! ### The pseudo-coherence conjunct of Stacks 0DJY -/

/-- **The pseudo-coherence conjunct of Stacks 0DJY.** In a cartesian diagram of schemes with
`i : X ⟶ X'`, `f : X ⟶ Y`, `f' : X' ⟶ Y'` and `j : Y ⟶ Y'`, with `j` a finite-order thickening,
an object `E'` of `D(𝒪_{X'})` whose derived pullback `Li^*E'` is pseudo-coherent is itself
pseudo-coherent.

A base change of a finite-order thickening is a finite-order thickening (Stacks 09ZU), so `i` is
one, and the conclusion is Stacks 0DJX. Neither flatness nor local finite presentation of `f'` is
used, and the family of derived tensor products plays no role, so neither appears.

This is the first of the two conjuncts of the conclusion of Stacks 0DJY. The second, locally
finite Tor dimension over `f'^{-1}𝒪_{Y'}`, is not proved here; its local content is
`Stacks.Thickenings.hasTorAmplitudeCanonical_derivedStalk_of_isPullback` above, and what is
missing between the two is recorded in the implementation notes of this file. -/
@[stacks 0DJY "the pseudo-coherence conjunct of the conclusion; the Tor-dimension conjunct is \
not proved — see the implementation notes of this module"]
public theorem isPseudoCoherent_of_isPullback_of_isFiniteOrderThickening
    {X X' Y Y' : Scheme.{u}} (i : X ⟶ X') (f : X ⟶ Y) (f' : X' ⟶ Y') (j : Y ⟶ Y')
    (hpb : IsPullback i f f' j) (hj : IsFiniteOrderThickening j)
    (E' : DerivedCategory (OXMod.{u, u} X'.toRingedSpace))
    (hE : RingedSpace.IsPseudoCoherent (X := X.toRingedSpace)
      ((Stacks.Cohomology.DerivedAdjunctionOnRingedSpaces.derivedPullback
        i.toLRSHom.toShHom).obj E')) :
    RingedSpace.IsPseudoCoherent (X := X'.toRingedSpace) E' :=
  isPseudoCoherent_of_derivedPullback i (isFiniteOrderThickening_of_isPullback hpb hj) E' hE

end Stacks.Thickenings

end
