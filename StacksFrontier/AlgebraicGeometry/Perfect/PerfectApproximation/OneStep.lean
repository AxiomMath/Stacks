/-!
# The one-step construction for approximation by perfect complexes

Fix a scheme `X`, a closed subset `T` and an object `F` of the derived category of
`𝒪_X`-modules whose cohomology vanishes above a degree `t`. The one-step construction of the
proof of Tag 08EQ produces a perfect object supported on `T`, with the same vanishing, mapping
to `F` surjectively on `H^t`. This file supplies two of its ingredients: the passage from
finitely many such maps to a single one, and the perfect object itself on an affine scheme,
namely the sheafified Koszul complex on equations cutting out `T`.

## Main results

* `DerivedCategory.exists_comp_eq_of_fin` and `DerivedCategory.exists_epi_homology_of_fin`:
  finitely many morphisms to `F` from objects of a class stable in the middle of a
  distinguished triangle factor through a single morphism from such an object, the biproduct of
  their sources; if they are jointly epimorphic on `H^t`, that morphism is epimorphic on `H^t`.
* `AlgebraicGeometry.PerfectApproximation.exists_isAdmissible_epi_homology_of_fin`: the same for
  the perfect objects supported on `T`, giving exactly the conclusion that the hypothesis
  `hstep` of `AlgebraicGeometry.PerfectApproximation.approximationHolds_of_oneStep` asks for.
* `Stacks.AffineTilde.isAdmissible_Q_obj_tildeComplex_extend_seqComplex`: the complex of
  `𝒪_{Spec R}`-modules associated to the Koszul complex of `f₁, …, f_r`, placed in the
  cohomological degrees `-r, …, 0`, is perfect and has cohomology supported on
  `V(f₁, …, f_r)`; by
  `Stacks.AffineTilde.isZero_homology_Q_obj_tildeComplex_extend_seqComplex` its cohomology
  vanishes in positive degrees.

## Implementation notes

A pretriangulated category has finite biproducts, so the direct sum appearing in the source's
"taking a finite direct sum of these maps" is available in `D(C)` with no extra hypothesis, and
the split triangle `P₁ ⟶ P₁ ⊞ P₂ ⟶ P₂` is distinguished. Both the perfectness and the
cohomological support of a biproduct therefore follow from their two-out-of-three forms, so the
assembly is stated for an arbitrary class of objects with that stability.

Perfectness of a complex does not transport across `~` in the generality in which
`m`-pseudo-coherence does (Tag 08E7), but it does not need to: the Koszul complex is a bounded
complex of finite free modules, so the complex it determines on `Spec R` is *strictly* perfect,
and Tag 08CM's definition is met with the one-member covering by the whole space. Perfectness
is read at `Stacks.Cohomology.PerfectComplexes.IsPerfect`, the spelling of
`AlgebraicGeometry.PerfectApproximation.IsAdmissible`; it is the same predicate as
`AlgebraicGeometry.RingedSpace.IsPerfect` at coinciding universes.

The cohomological support of the Koszul complex comes from Tag 0663: the ideal generated by the
sequence annihilates every Koszul homology module, so at a point where some `f i` is invertible
the stalk of the associated sheaf vanishes.

## References

* [Stacks Project, Tag 08EQ](https://stacks.math.columbia.edu/tag/08EQ)
* [Stacks Project, Tag 08CM](https://stacks.math.columbia.edu/tag/08CM)
* [Stacks Project, Tag 0663](https://stacks.math.columbia.edu/tag/0663)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open scoped ZeroObject

namespace DerivedCategory

universe w v u

variable {C : Type u} [Category.{v} C] [Abelian C] [HasDerivedCategory.{w} C]

/-- The middle vertex of a distinguished triangle whose outer vertices have vanishing
cohomology in degree `n` has vanishing cohomology in degree `n`. -/
theorem isZero_homology_obj₂_of_distinguished (T : Triangle (DerivedCategory C))
    (hT : T ∈ distTriang (DerivedCategory C)) (n : ℤ)
    (h₁ : IsZero ((homologyFunctor C n).obj T.obj₁))
    (h₃ : IsZero ((homologyFunctor C n).obj T.obj₃)) :
    IsZero ((homologyFunctor C n).obj T.obj₂) := by
  have hmono : Mono ((homologyFunctor C n).map T.mor₂) :=
    (HomologySequence.mono_homologyMap_mor₂_iff T hT n).2 (h₁.eq_of_src _ _)
  rw [IsZero.iff_id_eq_zero]
  exact (cancel_mono ((homologyFunctor C n).map T.mor₂)).1 (h₃.eq_of_tgt _ _)

/-- Finitely many morphisms to `F` from objects of a class `R` containing the zero objects and
stable in the middle of a distinguished triangle all factor through a single morphism to `F`
from an object of `R`, namely the biproduct of their sources. -/
theorem exists_comp_eq_of_fin {F : DerivedCategory C} (R : DerivedCategory C → Prop)
    (hR₀ : ∀ Z : DerivedCategory C, IsZero Z → R Z)
    (hR₂ : ∀ T : Triangle (DerivedCategory C), T ∈ distTriang (DerivedCategory C) →
      R T.obj₁ → R T.obj₃ → R T.obj₂)
    (t : ℤ) (n : ℕ) (P : Fin n → DerivedCategory C) (hP : ∀ j, R (P j))
    (hvan : ∀ (j : Fin n) (i : ℤ), t < i → IsZero ((homologyFunctor C i).obj (P j)))
    (α : ∀ j, P j ⟶ F) :
    ∃ Z : DerivedCategory C, R Z ∧
      (∀ i : ℤ, t < i → IsZero ((homologyFunctor C i).obj Z)) ∧
        ∃ γ : Z ⟶ F, ∀ j, ∃ u : P j ⟶ Z, u ≫ γ = α j := by
  induction n with
  | zero =>
    exact ⟨0, hR₀ _ (isZero_zero _),
      fun i _ => (homologyFunctor C i).map_isZero (isZero_zero _), 0, fun j => j.elim0⟩
  | succ n ih =>
    obtain ⟨Z', hZ', hZ'van, γ', hγ'⟩ := ih (fun k => P k.succ) (fun k => hP k.succ)
      (fun k => hvan k.succ) (fun k => α k.succ)
    refine ⟨P 0 ⊞ Z', ?_, ?_, biprod.desc (α 0) γ', ?_⟩
    · exact hR₂ _ (binaryBiproductTriangle_distinguished (P 0) Z') (hP 0) hZ'
    · intro i hi
      exact isZero_homology_obj₂_of_distinguished _
        (binaryBiproductTriangle_distinguished (P 0) Z') i (hvan 0 i hi) (hZ'van i hi)
    · refine Fin.cases ⟨biprod.inl, by simp⟩ (fun k => ?_)
      obtain ⟨u, hu⟩ := hγ' k
      exact ⟨u ≫ biprod.inr, by rw [Category.assoc, biprod.inr_desc, hu]⟩

/-- A jointly epimorphic finite family of morphisms to `F` is dominated, in degree `t`, by a
single morphism to `F` from an object of `R`. -/
theorem exists_epi_homology_of_fin {F : DerivedCategory C} (R : DerivedCategory C → Prop)
    (hR₀ : ∀ Z : DerivedCategory C, IsZero Z → R Z)
    (hR₂ : ∀ T : Triangle (DerivedCategory C), T ∈ distTriang (DerivedCategory C) →
      R T.obj₁ → R T.obj₃ → R T.obj₂)
    (t : ℤ) (n : ℕ) (P : Fin n → DerivedCategory C) (hP : ∀ j, R (P j))
    (hvan : ∀ (j : Fin n) (i : ℤ), t < i → IsZero ((homologyFunctor C i).obj (P j)))
    (α : ∀ j, P j ⟶ F)
    (hjoint : ∀ (Y : C) (g₁ g₂ : (homologyFunctor C t).obj F ⟶ Y),
      (∀ j, (homologyFunctor C t).map (α j) ≫ g₁ =
        (homologyFunctor C t).map (α j) ≫ g₂) → g₁ = g₂) :
    ∃ Z : DerivedCategory C, R Z ∧
      (∀ i : ℤ, t < i → IsZero ((homologyFunctor C i).obj Z)) ∧
        ∃ γ : Z ⟶ F, Epi ((homologyFunctor C t).map γ) := by
  obtain ⟨Z, hZ, hZvan, γ, hγ⟩ := exists_comp_eq_of_fin R hR₀ hR₂ t n P hP hvan α
  refine ⟨Z, hZ, hZvan, γ, ⟨fun {Y} g₁ g₂ hg => hjoint Y g₁ g₂ fun j => ?_⟩⟩
  obtain ⟨u, hu⟩ := hγ j
  rw [← hu, Functor.map_comp, Category.assoc, Category.assoc, hg]

end DerivedCategory

namespace AlgebraicGeometry.PerfectApproximation

universe u

attribute [local instance] HasDerivedCategory.standard

variable (X : Scheme.{u})

/-- A zero object of the derived category of `𝒪_X`-modules is admissible for every subset. -/
theorem isAdmissible_of_isZero (T : Set X) {P : DerivedCategory.{u + 1} X.Modules}
    (hP : IsZero P) : IsAdmissible X T P := by
  refine ⟨RingedSpace.isPerfect_of_isZero.{u, u + 1} (X := X.toRingedSpace) hP,
    fun i x _ => ?_⟩
  refine (SheafOfModules.isZero_stalkFunctor_obj_iff X.ringCatSheaf x _).1 ?_
  have hzero : IsZero ((DerivedCategory.homologyFunctor X.Modules i).obj P) :=
    Functor.map_isZero _ hP
  exact Functor.map_isZero _ hzero

/-- **The one-step construction, assembled from finitely many pieces.** Let `F` be an object of
the derived category of `𝒪_X`-modules and `t` a degree. Given finitely many perfect objects
supported on `T`, each with vanishing cohomology above `t`, mapping to `F` so that the induced
maps on `H^t` are jointly epimorphic, there is a single such object mapping to `F` by an
epimorphism on `H^t`.

This is the conclusion required by the hypothesis `hstep` of
`AlgebraicGeometry.PerfectApproximation.approximationHolds_of_oneStep`. -/
theorem exists_isAdmissible_epi_homology_of_fin (T : Set X) (t : ℤ)
    (F : DerivedCategory.{u + 1} X.Modules) (n : ℕ)
    (P : Fin n → DerivedCategory.{u + 1} X.Modules) (hP : ∀ j, IsAdmissible X T (P j))
    (hvan : ∀ (j : Fin n) (i : ℤ), t < i →
      IsZero ((DerivedCategory.homologyFunctor X.Modules i).obj (P j)))
    (α : ∀ j, P j ⟶ F)
    (hjoint : ∀ (Y : X.Modules)
      (g₁ g₂ : (DerivedCategory.homologyFunctor X.Modules t).obj F ⟶ Y),
      (∀ j, (DerivedCategory.homologyFunctor X.Modules t).map (α j) ≫ g₁ =
        (DerivedCategory.homologyFunctor X.Modules t).map (α j) ≫ g₂) → g₁ = g₂) :
    ∃ P' : DerivedCategory.{u + 1} X.Modules, IsAdmissible X T P' ∧
      (∀ i : ℤ, t < i → IsZero ((DerivedCategory.homologyFunctor X.Modules i).obj P')) ∧
        ∃ α' : P' ⟶ F, Epi ((DerivedCategory.homologyFunctor X.Modules t).map α') :=
  DerivedCategory.exists_epi_homology_of_fin (IsAdmissible X T)
    (fun _ hZ => isAdmissible_of_isZero X T hZ)
    (fun S hS h₁ h₃ => isAdmissible_obj₂_of_distinguished X T S hS h₁ h₃)
    t n P hP hvan α hjoint

end AlgebraicGeometry.PerfectApproximation

namespace Stacks.AffineTilde

open AlgebraicGeometry

universe u

attribute [local instance] HasDerivedCategory.standard

variable {R : CommRingCat.{u}} {r : ℕ}

/-- Each term of the Koszul complex of `r` elements, placed in the cohomological degrees
`-r, …, 0`, is a finite free module: it is an exterior power of `Rʳ`, or zero. -/
theorem finite_free_extend_seqComplex_X (f : Fin r → R) (i : ℤ) :
    Module.Finite R (((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat).X i) ∧
      Module.Free R (((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat).X i) := by
  classical
  by_cases h : ∃ j : ℕ, ComplexShape.embeddingDownNat.f j = i
  · obtain ⟨j, hj⟩ := h
    have hFin : Module.Finite R ((Koszul.seqComplex f).X j) := by
      change Module.Finite R (⋀[R]^j (Fin r → R)); infer_instance
    have hFree : Module.Free R ((Koszul.seqComplex f).X j) := by
      change Module.Free R (⋀[R]^j (Fin r → R)); infer_instance
    have e := ((Koszul.seqComplex f).extendXIso ComplexShape.embeddingDownNat hj).toLinearEquiv
    exact ⟨Module.Finite.equiv e.symm, Module.Free.of_equiv e.symm⟩
  · have hz := (Koszul.seqComplex f).isZero_extend_X ComplexShape.embeddingDownNat i
      (by simpa using h)
    have hsub : Subsingleton
        (((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat).X i) :=
      ModuleCat.isZero_iff_subsingleton.mp hz
    exact ⟨Module.Finite.of_finite, inferInstance⟩

/-- The Koszul complex of `r` elements, placed in the cohomological degrees `-r, …, 0`, has
zero terms outside that range. -/
theorem isZero_extend_seqComplex_X_of_lt_or_lt (f : Fin r → R) (i : ℤ)
    (hi : i < -(r : ℤ) ∨ 0 < i) :
    IsZero (((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat).X i) := by
  classical
  by_cases h : ∃ j : ℕ, ComplexShape.embeddingDownNat.f j = i
  · obtain ⟨j, hj⟩ := h
    have hr : r < j := by
      change -(j : ℤ) = i at hj
      rcases hi with hi | hi <;> lia
    exact (Koszul.seqComplex_isZero_of_lt f j hr).of_iso
      ((Koszul.seqComplex f).extendXIso ComplexShape.embeddingDownNat hj)
  · exact (Koszul.seqComplex f).isZero_extend_X ComplexShape.embeddingDownNat i (by simpa using h)

/-- **The sheafified Koszul complex is strictly perfect.** The complex of
`𝒪_{Spec R}`-modules associated to the Koszul complex of `f₁, …, f_r`, placed in the
cohomological degrees `-r, …, 0`, is bounded with finite free terms. -/
theorem isStrictlyPerfect_tildeComplex_extend_seqComplex (f : Fin r → R) :
    StrictlyPerfect.IsStrictlyPerfect (X := (Spec R).toRingedSpace)
      (tildeComplex ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat)) := by
  refine isStrictlyPerfect_tildeComplex _ ?_ (finite_free_extend_seqComplex_X f)
  refine Set.Finite.subset (Set.finite_Icc (-(r : ℤ)) 0) fun i hi => ?_
  simp only [Set.mem_ofPred_eq] at hi
  refine Set.mem_Icc.2 ⟨?_, ?_⟩ <;> by_contra hcon
  · exact hi (isZero_extend_seqComplex_X_of_lt_or_lt f i (Or.inl (by lia)))
  · exact hi (isZero_extend_seqComplex_X_of_lt_or_lt f i (Or.inr (by lia)))

/-- A localization of a module annihilated by an element of the localizing submonoid vanishes. -/
theorem subsingleton_of_annihilator_of_isLocalizedModule {A M N : Type*} [CommRing A]
    [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N] (S : Submonoid A)
    (φ : M →ₗ[A] N) [IsLocalizedModule S φ] (a : S)
    (ha : (a : A) ∈ Module.annihilator A M) : Subsingleton N := by
  have hzero (n : N) : n = 0 := by
    obtain ⟨⟨m, s⟩, rfl⟩ := IsLocalizedModule.mk'_surjective S φ n
    refine IsLocalizedModule.smul_injective φ a ?_
    change (a : A) • IsLocalizedModule.mk' φ m s = (a : A) • (0 : N)
    rw [← IsLocalizedModule.mk'_smul, (Module.mem_annihilator.mp ha) m,
      IsLocalizedModule.mk'_zero, smul_zero]
  exact ⟨fun x y => (hzero x).trans (hzero y).symm⟩

/-- The stalk of `M̃` at a point off the vanishing locus of an element annihilating `M` is
zero. -/
theorem isZero_stalk_tilde_of_annihilator (M : ModuleCat.{u} R) (x : PrimeSpectrum R) (a : R)
    (ha : a ∈ Module.annihilator R M) (hx : a ∉ x.asIdeal) :
    IsZero ((tilde M).presheaf.stalk x) :=
  have : Subsingleton ((tilde M).presheaf.stalk x) :=
    subsingleton_of_annihilator_of_isLocalizedModule x.asIdeal.primeCompl
      (tilde.toStalk M x).hom ⟨a, hx⟩ ha
  AddCommGrpCat.isZero_of_subsingleton _

/-- The cohomology sheaves of the complex of `𝒪_{Spec R}`-modules associated to a complex of
`R`-modules are the sheaves associated to its cohomology modules: `~` is exact. -/
theorem nonempty_homology_Q_obj_tildeComplex_iso (M : CochainComplex (ModuleCat.{u} R) ℤ)
    (n : ℤ) :
    Nonempty ((DerivedCategory.homologyFunctor (Spec R).Modules n).obj
        (DerivedCategory.Q.obj (tildeComplex M)) ≅
      (tilde.functor R).obj (M.homology n)) :=
  have : PreservesFiniteLimits (tilde.functor R) := AlgebraicGeometry.tilde.preservesFiniteLimits R
  have : PreservesFiniteColimits (tilde.functor R) := preservesFiniteColimits_tildeFunctor R
  ⟨(DerivedCategory.homologyFunctorFactors.{u + 1} (Spec R).Modules n).app
      (((tilde.functor R).mapHomologicalComplex (ComplexShape.up ℤ)).obj M) ≪≫
    (M.sc n).mapHomologyIso (tilde.functor R)⟩

/-- `~` of the homology of the Koszul complex, placed in the cohomological degrees `-r, …, 0`,
vanishes in positive degrees. -/
private theorem isZero_tilde_homology_extend_seqComplex (f : Fin r → R) (n : ℤ) (hn : 0 < n) :
    IsZero ((tilde.functor R).obj
      (((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat).homology n)) :=
  (tilde.functor R).map_isZero
    (((Koszul.seqComplex f).extend_exactAt ComplexShape.embeddingDownNat n
      (fun j => by simp only [ComplexShape.embeddingDownNat_f]; lia)).isZero_homology)

/-- The sheafified Koszul complex, placed in the cohomological degrees `-r, …, 0`, has
vanishing cohomology in positive degrees. -/
theorem isZero_homology_Q_obj_tildeComplex_extend_seqComplex (f : Fin r → R) (n : ℤ)
    (hn : 0 < n) :
    IsZero ((DerivedCategory.homologyFunctor (Spec R).Modules n).obj
      (DerivedCategory.Q.obj
        (tildeComplex ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat)))) := by
  obtain ⟨e⟩ := nonempty_homology_Q_obj_tildeComplex_iso
    ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat) n
  exact IsZero.of_iso (isZero_tilde_homology_extend_seqComplex f n hn) e

/-- **The sheafified Koszul complex is supported on the zero locus of its sequence.** Away from
that locus one of the `f i` is invertible, and it annihilates every Koszul homology module. -/
theorem cohomologySupportedOn_Q_obj_tildeComplex_extend_seqComplex (f : Fin r → R) :
    CohomologySupportedOn (Spec R).ringCatSheaf (PrimeSpectrum.zeroLocus (Set.range f))
      (DerivedCategory.Q.obj
        (tildeComplex ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat))) := by
  classical
  intro n x hx
  obtain ⟨e⟩ := nonempty_homology_Q_obj_tildeComplex_iso
    ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat) n
  set S := Scheme.Modules.toPresheaf (Spec R) ⋙
    TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x with hS
  change IsZero (S.obj ((DerivedCategory.homologyFunctor (Spec R).Modules n).obj
    (DerivedCategory.Q.obj
      (tildeComplex ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat)))))
  refine IsZero.of_iso ?_ (S.mapIso e)
  by_cases hn : n ≤ 0
  · refine IsZero.of_iso ?_ (S.mapIso ((tilde.functor R).mapIso
      ((Koszul.seqComplex f).extendHomologyIso ComplexShape.embeddingDownNat
        (j := (-n).toNat) (j' := n) (by simp only [ComplexShape.embeddingDownNat_f]; lia))))
    have hx' : ¬ ∀ j, f j ∈ x.asIdeal := fun hh => hx (by rintro _ ⟨j, rfl⟩; exact hh j)
    obtain ⟨j, hj⟩ := Classical.not_forall.mp hx'
    exact isZero_stalk_tilde_of_annihilator _ x (f j)
      ((Koszul.koszulSeq_smul_nullHomotopic_and_span_le_annihilator f).2 _
        (Ideal.subset_span ⟨j, rfl⟩)) hj
  · exact S.map_isZero (isZero_tilde_homology_extend_seqComplex f n (not_le.1 hn))

/-- **The sheafified Koszul complex is perfect.** The object of the derived category of
`𝒪_{Spec R}`-modules represented by the Koszul complex of `f₁, …, f_r` is perfect, being
represented by a strictly perfect complex. -/
theorem isPerfect_Q_obj_tildeComplex_extend_seqComplex (f : Fin r → R) :
    Stacks.Cohomology.PerfectComplexes.IsPerfect (X := (Spec R).toRingedSpace)
      (DerivedCategory.Q.obj
        (tildeComplex ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat))) :=
  RingedSpace.isPerfect_Q_obj_of_isStrictlyPerfect.{u, u + 1} (X := (Spec R).toRingedSpace)
    (isStrictlyPerfect_tildeComplex_extend_seqComplex f)

/-- **The sheafified Koszul complex is an admissible approximating object for the zero locus of
its sequence**: it is perfect and its cohomology is supported on `V(f₁, …, f_r)`. -/
theorem isAdmissible_Q_obj_tildeComplex_extend_seqComplex (f : Fin r → R) :
    PerfectApproximation.IsAdmissible (Spec R) (PrimeSpectrum.zeroLocus (Set.range f))
      (DerivedCategory.Q.obj
        (tildeComplex ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat))) :=
  ⟨isPerfect_Q_obj_tildeComplex_extend_seqComplex f,
    cohomologySupportedOn_Q_obj_tildeComplex_extend_seqComplex f⟩

end Stacks.AffineTilde

end
