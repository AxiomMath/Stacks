module

public import StacksFrontier.AlgebraicGeometry.Perfect.LimitHomDescent
public import StacksFrontier.AlgebraicGeometry.EmptyLimitCounterexample.Basic
public import StacksFrontier.AlgebraicGeometry.Perfect.VectorBundleComparison
public import StacksFrontier.AlgebraicGeometry.Perfect.VectorBundleKGroup
public import StacksFrontier.Topology.Sheaves.Cohomology.DerivedPullback.UnitComparison

/-!
# Stacks 09RE over an index set one universe up

Stacks 09RE fails when the index set of Situation 09RD is not in the universe of the schemes.
The spectra of the subrings of a large field generated by its finite subsets, indexed by those
finite subsets, form a situation of type 09RD with an empty limit and nonempty stages. With
`E₀ = K₀ = 𝒪_{S₀}`, which is perfect with quasi-coherent cohomology, the group `Hom(E, K)` is
zero, while the identity and the zero endomorphism of `E_0` are different at every later stage.

## Main results

* `AlgebraicGeometry.DescentSituation.exists_not_isHomColimit`: the counterexample.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open Stacks.EmptyLimitCounterexample

attribute [local instance 10000] HasDerivedCategory.standard

universe u

namespace AlgebraicGeometry.DescentSituation

/-- Conjugating an endomorphism equal to the identity gives the identity. -/
theorem inv_comp_comp_hom_of_eq_id {C : Type*} [Category C] {X Y : C} (e : X ≅ Y) (f : X ⟶ X)
    (hf : f = 𝟙 X) : e.inv ≫ f ≫ e.hom = 𝟙 Y := by
  subst hf
  simp

/-- Conjugating a zero morphism gives zero. -/
theorem inv_comp_comp_hom_of_eq_zero {C : Type*} [Category C] [Preadditive C] {X Y X' Y' : C}
    (e : X ≅ Y) (e' : X' ≅ Y') (f : X ⟶ X') (hf : f = 0) : e.inv ≫ f ≫ e'.hom = 0 := by
  subst hf
  simp

/-- The structure sheaf placed in degree zero, as an object of `D(𝒪_X)`. -/
abbrev unitObj (X : Scheme.{u}) : Stacks.LimitHomDescent.DMod X :=
  (DerivedCategory.singleFunctor X.Modules 0).obj (SheafOfModules.unit X.ringCatSheaf)

/-- The structure sheaf in degree zero is perfect. -/
theorem isPerfect_unitObj (X : Scheme.{u}) :
    Stacks.Cohomology.PerfectComplexes.IsPerfect (X := X.toRingedSpace) (unitObj X) :=
  ⟨(CochainComplex.singleFunctor X.Modules 0).obj (SheafOfModules.unit X.ringCatSheaf),
    isPerfectComplex_single_of_isFiniteLocallyFree X _ (isFiniteLocallyFree_unit X),
    ⟨((DerivedCategory.singleFunctorIsoCompQ X.Modules 0).app _).symm⟩⟩

/-- The structure sheaf in degree zero of a scheme with a nonzero ring of global sections is not
zero. -/
theorem not_isZero_unitObj (X : Scheme.{u}) [Nontrivial Γ(X, ⊤)] : ¬ IsZero (unitObj X) := by
  intro h
  have h₁ : IsZero (SheafOfModules.unit X.ringCatSheaf) :=
    (IsZero.iff_id_eq_zero _).2
      ((DerivedCategory.singleFunctor X.Modules 0).map_injective
        (((DerivedCategory.singleFunctor X.Modules 0).map_id _).trans
          ((h.eq_of_src _ _).trans
            ((DerivedCategory.singleFunctor X.Modules 0).map_zero _ _).symm)))
  exact not_subsingleton Γ(X, ⊤)
    (ModuleCat.subsingleton_of_isZero
      ((SheafOfModules.evaluation X.ringCatSheaf (op ⊤)).map_isZero h₁))

/-- On an empty scheme the structure sheaf in degree zero is zero. -/
theorem isZero_unitObj (X : Scheme.{u}) [IsEmpty X] : IsZero (unitObj X) := by
  have : IsZero (SheafOfModules.unit X.ringCatSheaf) := by
    refine (IsZero.iff_id_eq_zero _).2 ?_
    ext U
    exact Subsingleton.elim (α := Γ(X, U.unop)) _ _
  exact (DerivedCategory.singleFunctor X.Modules 0).map_isZero this

/-- **Situation 09RD over an index set one universe up with an empty limit**: the spectra of the
subrings of `bigField` generated by its finite subsets, indexed by those finite subsets. -/
def emptyLimitSituation : AlgebraicGeometry.DescentSituation.{u + 1, u} (Finset bigField.{u}) where
  system := schemeDiagram bigField.{u}
  transition_affine _ := inferInstance
  quasiCompact _ := inferInstance
  quasiSeparated _ := inferInstance
  limitCone := emptyCone bigField.{u}
  isLimit := isLimitEmptyConeBigField.{u}
  base := ∅

/-- The subring `stage bigField T` of `bigField` generated by a finite subset `T` is nontrivial. -/
instance (T : Finset bigField.{u}) :
    Nontrivial (Stacks.EmptyLimitCounterexample.stage bigField.{u} T) :=
  (stageEquiv bigField.{u} T).toEquiv.nontrivial

/-- The global sections of each stage scheme of `emptyLimitSituation` form a nontrivial ring. -/
instance (T : Finset bigField.{u}) :
    Nontrivial Γ((emptyLimitSituation.{u}).stage T, ⊤) :=
  (Scheme.ΓSpecIso (CommRingCat.of (Stacks.EmptyLimitCounterexample.stage bigField.{u} T)))
    |>.commRingCatIsoToRingEquiv.toEquiv.nontrivial

/-- The limit scheme of `emptyLimitSituation` is empty. -/
instance : IsEmpty (emptyLimitSituation.{u}).limitScheme :=
  inferInstanceAs (IsEmpty (∅ : Scheme.{u}))

/-- The structure sheaf in degree zero, pulled back to a scheme, is its structure sheaf in
degree zero. -/
def pbUnitObjIso {X Y : Scheme.{u}} (f : X ⟶ Y) :
    (Stacks.LimitHomDescent.pb f).obj (unitObj Y) ≅ unitObj X :=
  Stacks.Cohomology.DerivedPullbackUnit.derivedPullbackUnitIso f.toLRSHom.toShHom

/-- **Stacks 09RE fails over an index set one universe up**: there is a situation of type 09RD
indexed by a preorder in `Type (u+1)` and an object `E₀ = K₀` of `D(𝒪_{S₀})` which is perfect,
pseudo-coherent, of finite Tor dimension, and has quasi-coherent cohomology, for which
`Hom(E, K)` is not the filtered colimit of the `Hom(E_i, K_i)`. -/
theorem exists_not_isHomColimit :
    ∃ (I : Type (u + 1)) (_ : Preorder I) (_ : IsDirected I (· ≤ ·))
      (D : DescentSituation.{u + 1, u} I) (E₀ : DerivedCategory (D.stage D.base).Modules),
      Stacks.Cohomology.PerfectComplexes.IsPerfect (X := (D.stage D.base).toRingedSpace) E₀ ∧
        (∀ n : ℤ, SheafOfModules.isQuasicoherent (D.stage D.base).ringCatSheaf
          ((DerivedCategory.homologyFunctor (D.stage D.base).Modules n).obj E₀)) ∧
        ¬ IsHomColimit E₀ E₀ := by
  refine ⟨Finset bigField.{u}, inferInstance, inferInstance, emptyLimitSituation.{u},
    unitObj _, isPerfect_unitObj _,
    PerfectApproximation.isQuasicoherent_homology_of_isPerfect _ _ (isPerfect_unitObj _), ?_⟩
  intro h
  let D := emptyLimitSituation.{u}
  have hlim : IsZero (limitObj (D := D) (unitObj _)) :=
    (isZero_unitObj D.limitScheme).of_iso (pbUnitObjIso _)
  obtain ⟨j, hij, hj⟩ := h.exists_trans_eq ⟨D.base, le_rfl⟩ (𝟙 _) 0 (hlim.eq_of_src _ _)
  have h0 : homTransition (D := D) (unitObj _) (unitObj _) _ j hij 0 = 0 :=
    inv_comp_comp_hom_of_eq_zero (C := Stacks.LimitHomDescent.DMod (D.stage j.1)) _ _ _
      (Functor.map_zero _ _ _)
  have h1 : homTransition (D := D) (unitObj _) (unitObj _) _ j hij (𝟙 _) = 𝟙 _ :=
    inv_comp_comp_hom_of_eq_id _ _ (CategoryTheory.Functor.map_id _ _)
  exact not_isZero_unitObj (D.stage j.1)
    (((IsZero.iff_id_eq_zero _).2 (h1.symm.trans (hj.trans h0))).of_iso (pbUnitObjIso _).symm)

end AlgebraicGeometry.DescentSituation

end
