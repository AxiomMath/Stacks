module

public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.IsTensorProduct
public import Mathlib.RingTheory.TensorProduct.Basic
public import StacksFrontier.AlgebraicGeometry.Flatness.StalkIdealSheaf

/-!
# The local rings of a base change of a closed immersion form a pushout square

Let
```
Z' --i'--> X'
|          |
g          f
v          v
Z --i----> X
```
be a cartesian square of schemes with `i` a closed immersion, and let `z'` be a point of `Z'`.
This file proves that the four local rings at `z'`, `g z'`, `i' z'` and `i (g z')` form a pushout
square of commutative rings, that is, `𝒪_{Z', z'} = 𝒪_{Z, g z'} ⊗_{𝒪_{X, x}} 𝒪_{X', i' z'}`.

This is the hypothesis `Algebra.IsPushout` of Stacks 0661
(`RingTheory.TorIndependence.derivedBaseChangeComparison_isIso_of_torIndependent`), which is the
algebraic input of Stacks 0E23.

## Main results

* `Stacks.Cohomology.StalkPushout.isPushout_of_surjective_of_ker`: the ring-theoretic statement.
  If `R → A` and `R' → A'` are surjective and `ker (R' → A')` is the ideal generated by the image
  of `ker (R → A)`, then `R → A`, `R → R'`, `R' → A'`, `A → A'` is a pushout square of algebras.
  Mathlib has the pushout predicate and the linear algebra of `(R ⧸ I) ⊗[R] M`, but no lemma in
  this shape.
* `Stacks.Cohomology.StalkPushout.stalkMap_comm_of_isPullback`: the square of stalk maps commutes,
  after the comparison of the two presentations `i (g z')` and `f (i' z')` of the point of `X`.
* `Stacks.Cohomology.StalkPushout.isPushout_stalk_of_isPullback`: the pushout statement on stalks,
  for ambient algebra structures identified with the stalk maps.
* `Stacks.Cohomology.StalkPushout.isPushout_stalkMap_toAlgebra_of_isPullback`: the same with the
  algebra structures taken to be the ones the stalk maps induce, which exhibits the hypotheses of
  the previous statement as satisfiable.

## Implementation notes

*The ring-theoretic step.* The surjection `R → A` makes
`Algebra.TensorProduct.includeRight : R' →ₐ[R] A ⊗[R] R'` surjective
(`Algebra.TensorProduct.includeRight_surjective`), so every element of `A ⊗[R] R'` is `1 ⊗ₜ r'`
and the comparison `A ⊗[R] R' →ₐ[R] A'` is surjective as soon as `R' → A'` is. For injectivity,
`includeRight` kills the ideal generated by the image of `ker (R → A)` — one computation,
`1 ⊗ₜ (y • 1) = (y • 1) ⊗ₜ 1 = 0` for `y` in that kernel, extended to the ideal by
`Ideal.map_le_iff_le_comap` — and by hypothesis that ideal is all of `ker (R' → A')`. So the
route is bijectivity of one explicit algebra map rather than the chain of linear equivalences
through `TensorProduct.quotTensorEquivQuotSMul`; the quotient never has to be named.

*How the square enters.* Commutativity of the square of schemes gives
`i (g z') = f (i' z')` only as an equality of points, not definitionally, so the comparison map
`𝒪_{X, i (g z')} ⟶ 𝒪_{X', i' z'}` carries a `TopCat.Presheaf.stalkCongr`; that equality is taken
as a hypothesis, exactly as in `Stacks.Flatness.ker_stalkMap_of_isPullback`, and
`congrArg (fun h => h.base z') sq.w` proves it. The commuting square of stalk maps is then
`AlgebraicGeometry.Scheme.Hom.stalkMap_congr_hom` applied to the two composites `g ≫ i` and
`i' ≫ f`, each expanded by `AlgebraicGeometry.Scheme.Hom.stalkMap_comp`.

*The two surjectivity hypotheses* are `AlgebraicGeometry.Scheme.Hom.stalkMap_surjective` for `i`
and for `i'`; the latter is a closed immersion because closed immersions are stable under base
change. *The kernel hypothesis* is `Stacks.Flatness.ker_stalkMap_of_isPullback`, stated
at exactly this orientation.

Nothing here is tagged: Stacks 0E23 is the statement that the derived base change map is an
isomorphism, and no clause of it is proved here. This is one of its inputs.

## References

* [Stacks Project, Tag 0E23](https://stacks.math.columbia.edu/tag/0E23)
* [Stacks Project, Tag 0661](https://stacks.math.columbia.edu/tag/0661)
* [Stacks Project, Tag 01JY](https://stacks.math.columbia.edu/tag/01JY)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TensorProduct TopologicalSpace

namespace Stacks.Cohomology.StalkPushout

/-! ### The ring-theoretic statement -/

section Algebraic

universe uR uA uRp uAp

variable {R : Type uR} {A : Type uA} {R' : Type uRp} {A' : Type uAp}
  [CommRing R] [CommRing A] [CommRing R'] [CommRing A']
  [Algebra R A] [Algebra R R'] [Algebra R A'] [Algebra A A'] [Algebra R' A']
  [IsScalarTower R A A'] [IsScalarTower R R' A']

/-- The canonical algebra map `A ⊗[R] R' ⟶ A'` of a commutative square of algebras. -/
noncomputable def comparison : (A ⊗[R] R') →ₐ[R] A' :=
  Algebra.TensorProduct.lift (IsScalarTower.toAlgHom R A A')
    (IsScalarTower.toAlgHom R R' A') fun _ _ => Commute.all _ _

/-- The comparison map sends `1 ⊗ₜ r'` to the image of `r'` in `A'`. -/
@[simp]
theorem comparison_one_tmul (r' : R') :
    comparison (R := R) (A := A) (R' := R') (A' := A') ((1 : A) ⊗ₜ[R] r') =
      algebraMap R' A' r' := by
  simp [comparison]

/-- The inclusion of the right factor kills the ideal generated by the image of the kernel of
`R → A`: for `y` in that kernel, `1 ⊗ₜ (y • 1) = (y • 1) ⊗ₜ 1 = 0`. -/
theorem map_ker_le_ker_includeRight :
    Ideal.map (algebraMap R R') (RingHom.ker (algebraMap R A)) ≤
      RingHom.ker (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := R')).toRingHom := by
  rw [Ideal.map_le_iff_le_comap]
  intro y hy
  rw [RingHom.mem_ker] at hy
  simp only [Ideal.mem_comap, RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
    Algebra.TensorProduct.includeRight_apply]
  rw [Algebra.algebraMap_eq_smul_one (R := R) (A := R') y, ← TensorProduct.smul_tmul,
    ← Algebra.algebraMap_eq_smul_one, hy, TensorProduct.zero_tmul]

/-- The comparison `A ⊗[R] R' ⟶ A'` is bijective when `R → A` and `R' → A'` are surjective and
`ker (R' → A')` is the ideal generated by the image of `ker (R → A)`. -/
theorem comparison_bijective (hA : Function.Surjective (algebraMap R A))
    (hA' : Function.Surjective (algebraMap R' A'))
    (hker : RingHom.ker (algebraMap R' A') =
      Ideal.map (algebraMap R R') (RingHom.ker (algebraMap R A))) :
    Function.Bijective (comparison (R := R) (A := A) (R' := R') (A' := A')) := by
  have hincl : Function.Surjective
      (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := R')) :=
    Algebra.TensorProduct.includeRight_surjective (R := R) (S := A) R' hA
  refine ⟨?_, fun a' => ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨r', rfl⟩ := hincl z
    rw [Algebra.TensorProduct.includeRight_apply] at hz ⊢
    rw [comparison_one_tmul] at hz
    have hmem : r' ∈ Ideal.map (algebraMap R R') (RingHom.ker (algebraMap R A)) := by
      rw [← hker, RingHom.mem_ker]; exact hz
    have h0 := map_ker_le_ker_includeRight (R := R) (A := A) (R' := R') hmem
    rw [RingHom.mem_ker] at h0
    simpa only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      Algebra.TensorProduct.includeRight_apply] using h0
  · obtain ⟨r', rfl⟩ := hA' a'
    exact ⟨(1 : A) ⊗ₜ[R] r', comparison_one_tmul r'⟩

/-- **A quotient square of algebras is a pushout square.** If `R → A` and `R' → A'` are
surjective and `ker (R' → A')` is the ideal generated by the image of `ker (R → A)`, then
`A' = A ⊗[R] R'`.

Mathlib has `Algebra.IsPushout` and the identification `(R ⧸ I) ⊗[R] M ≃ M ⧸ I • M`
(`TensorProduct.quotTensorEquivQuotSMul`) but no lemma in this shape. -/
theorem isPushout_of_surjective_of_ker (hA : Function.Surjective (algebraMap R A))
    (hA' : Function.Surjective (algebraMap R' A'))
    (hker : RingHom.ker (algebraMap R' A') =
      Ideal.map (algebraMap R R') (RingHom.ker (algebraMap R A))) :
    Algebra.IsPushout R A R' A' := by
  rw [Algebra.isPushout_iff]
  refine IsTensorProduct.of_equiv
    (LinearEquiv.ofBijective
      (comparison (R := R) (A := A) (R' := R') (A' := A')).toLinearMap
      (comparison_bijective hA hA' hker)) ?_
  intro a b
  simp [comparison, Algebra.smul_def]

end Algebraic

/-! ### The square of stalk maps -/

section Geometric

universe u

variable {Z' X' Z X : Scheme.{u}} {i' : Z' ⟶ X'} {g : Z' ⟶ Z} {f : X' ⟶ X} {i : Z ⟶ X}

/-- **The square of local rings of a cartesian square commutes.** The two routes from
`𝒪_{X, i (g z')}` to `𝒪_{Z', z'}` agree, after comparing the two presentations `i (g z')` and
`f (i' z')` of the same point of `X` by `TopCat.Presheaf.stalkCongr`. -/
theorem stalkMap_comm_of_isPullback (sq : IsPullback i' g f i) (z' : Z')
    (hpt : i (g z') = f (i' z')) :
    i.stalkMap (g z') ≫ g.stalkMap z' =
      (X.presheaf.stalkCongr (Inseparable.of_eq hpt)).hom ≫
        f.stalkMap (i' z') ≫ i'.stalkMap z' := by
  rw [← Scheme.Hom.stalkMap_comp, ← Scheme.Hom.stalkMap_comp]
  exact Scheme.Hom.stalkMap_congr_hom (g ≫ i) (i' ≫ f) sq.w.symm z'

variable (sq : IsPullback i' g f i) (z' : Z') (hpt : i (g z') = f (i' z'))

include sq in
/-- **The local rings of a base change of a closed immersion form a pushout square.** For a
cartesian square with `i` a closed immersion and a point `z'` of `Z'`,
`𝒪_{Z', z'} = 𝒪_{Z, g z'} ⊗_{𝒪_{X, i (g z')}} 𝒪_{X', i' z'}`.

The algebra structures are arbitrary, subject to their structure maps being the stalk maps of the
square; `Stacks.Cohomology.StalkPushout.isPushout_stalkMap_toAlgebra_of_isPullback` is the
instance with the structures the stalk maps induce. -/
theorem isPushout_stalk_of_isPullback [IsClosedImmersion i]
    [Algebra (X.presheaf.stalk (i (g z'))) (Z.presheaf.stalk (g z'))]
    [Algebra (X.presheaf.stalk (i (g z'))) (X'.presheaf.stalk (i' z'))]
    [Algebra (X.presheaf.stalk (i (g z'))) (Z'.presheaf.stalk z')]
    [Algebra (Z.presheaf.stalk (g z')) (Z'.presheaf.stalk z')]
    [Algebra (X'.presheaf.stalk (i' z')) (Z'.presheaf.stalk z')]
    [IsScalarTower (X.presheaf.stalk (i (g z'))) (Z.presheaf.stalk (g z'))
      (Z'.presheaf.stalk z')]
    [IsScalarTower (X.presheaf.stalk (i (g z'))) (X'.presheaf.stalk (i' z'))
      (Z'.presheaf.stalk z')]
    (hiA : algebraMap (X.presheaf.stalk (i (g z'))) (Z.presheaf.stalk (g z')) =
      (i.stalkMap (g z')).hom)
    (hfR : algebraMap (X.presheaf.stalk (i (g z'))) (X'.presheaf.stalk (i' z')) =
      ((X.presheaf.stalkCongr (Inseparable.of_eq hpt)).hom ≫ f.stalkMap (i' z')).hom)
    (hiA' : algebraMap (X'.presheaf.stalk (i' z')) (Z'.presheaf.stalk z') =
      (i'.stalkMap z').hom) :
    Algebra.IsPushout (X.presheaf.stalk (i (g z'))) (Z.presheaf.stalk (g z'))
      (X'.presheaf.stalk (i' z')) (Z'.presheaf.stalk z') := by
  have hi' : IsClosedImmersion i' := MorphismProperty.of_isPullback sq.flip inferInstance
  refine isPushout_of_surjective_of_ker ?_ ?_ ?_
  · rw [hiA]; exact i.stalkMap_surjective (g z')
  · rw [hiA']; exact i'.stalkMap_surjective z'
  · rw [hiA', hfR, hiA]
    exact Stacks.Flatness.ker_stalkMap_of_isPullback sq z' hpt

include sq in
/-- The pushout statement with the algebra structures induced by the stalk maps themselves. This
exhibits the hypotheses of `Stacks.Cohomology.StalkPushout.isPushout_stalk_of_isPullback` as
satisfiable. -/
theorem isPushout_stalkMap_toAlgebra_of_isPullback [IsClosedImmersion i] :
    letI : Algebra (X.presheaf.stalk (i (g z'))) (Z.presheaf.stalk (g z')) :=
      (i.stalkMap (g z')).hom.toAlgebra
    letI : Algebra (X.presheaf.stalk (i (g z'))) (X'.presheaf.stalk (i' z')) :=
      ((X.presheaf.stalkCongr (Inseparable.of_eq hpt)).hom ≫ f.stalkMap (i' z')).hom.toAlgebra
    letI : Algebra (X.presheaf.stalk (i (g z'))) (Z'.presheaf.stalk z') :=
      ((X.presheaf.stalkCongr (Inseparable.of_eq hpt)).hom ≫ f.stalkMap (i' z') ≫
        i'.stalkMap z').hom.toAlgebra
    letI : Algebra (Z.presheaf.stalk (g z')) (Z'.presheaf.stalk z') :=
      (g.stalkMap z').hom.toAlgebra
    letI : Algebra (X'.presheaf.stalk (i' z')) (Z'.presheaf.stalk z') :=
      (i'.stalkMap z').hom.toAlgebra
    haveI : IsScalarTower (X.presheaf.stalk (i (g z'))) (Z.presheaf.stalk (g z'))
        (Z'.presheaf.stalk z') :=
      IsScalarTower.of_algebraMap_eq' (by
        rw [RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra,
          RingHom.algebraMap_toAlgebra, ← CommRingCat.hom_comp,
          ← stalkMap_comm_of_isPullback sq z' hpt])
    haveI : IsScalarTower (X.presheaf.stalk (i (g z'))) (X'.presheaf.stalk (i' z'))
        (Z'.presheaf.stalk z') :=
      IsScalarTower.of_algebraMap_eq' (by
        rw [RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra,
          RingHom.algebraMap_toAlgebra, ← CommRingCat.hom_comp, Category.assoc])
    Algebra.IsPushout (X.presheaf.stalk (i (g z'))) (Z.presheaf.stalk (g z'))
      (X'.presheaf.stalk (i' z')) (Z'.presheaf.stalk z') := by
  refine @isPushout_stalk_of_isPullback _ _ _ _ _ _ _ _ sq z' hpt ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
  all_goals first | infer_instance | exact RingHom.algebraMap_toAlgebra _

end Geometric

end Stacks.Cohomology.StalkPushout

end
