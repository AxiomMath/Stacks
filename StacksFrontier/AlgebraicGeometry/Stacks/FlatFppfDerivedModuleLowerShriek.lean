instance hasPointwiseLeftDerivedFunctor_moduleLowerShriek_standard :
    (lowerShriekOnHomotopy (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳)) ⋙
        @DerivedCategory.Qh _ _ _ (HasDerivedCategory.standard (SheafOfModules.{u}
          (SmallModel.targetRing (fppfTopology B S hS 𝒳)
            (ambientStructureSheaf B S hS 𝒳))))).HasPointwiseLeftDerivedFunctor
      (sourceQuasiIso (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))) :=
  letI := HasDerivedCategory.standard (SheafOfModules.{u} (inverseImageRing (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))))
  letI := HasDerivedCategory.standard (SheafOfModules.{u}
    (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳)))
  hasPointwiseLeftDerivedLowerShriek_of_essentiallySmall _ _ _ _ (moduleLowerShriekAcyclic B S hS 𝒳)

/-- **`Lg_!` is computed degreewise, at the standard models of the derived categories**: the
comparison `Stacks.Cohomology.DerivedLowerShriek.derivedLowerShriekComparison` of the general
theory, which is formed at `HasDerivedCategory.standard`, is invertible on a bounded above complex
of direct sums of the `j_{U!} 𝒪_U`. -/
theorem isIso_derivedModuleLowerShriekComparison_app
    (L : CochainComplex (SheafOfModules.{u} (inverseImageRing (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳)))) ℤ)
    [L.IsStrictlyLE 0]
    (hL : ∀ n, IsSumOfExtensionByZeroUnits (inverseImageRing (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))) (L.X n)) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u} (inverseImageRing (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))))
    letI := HasDerivedCategory.standard (SheafOfModules.{u}
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳)))
    haveI := hasPointwiseLeftDerivedLowerShriek_of_essentiallySmall (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))
      (moduleLowerShriekAcyclic B S hS 𝒳)
    IsIso ((derivedLowerShriekComparison (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))).app
        ((HomotopyCategory.quotient _ (ComplexShape.up ℤ)).obj L)) :=
  let := HasDerivedCategory.standard (SheafOfModules.{u} (inverseImageRing (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))))
  let := HasDerivedCategory.standard (SheafOfModules.{u}
    (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳)))
