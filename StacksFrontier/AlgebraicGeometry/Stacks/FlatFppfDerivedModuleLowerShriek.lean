namespace AlgebraicGeometry.Stack.FlatFppf

universe u w t t'

attribute [local instance] hasSheafCompose_forget_ringCat hasSheafCompose_forget_commRingCat
  Stacks.hasSheafCompose_forget₂_commRingCat isContinuous_inclusion_topology
  isCocontinuous_inclusion_topology hasSheafify_addCommGrpCat
  wEqualsLocallyBijective_addCommGrpCat hasSheafify_fppf_addCommGrpCat
  wEqualsLocallyBijective_fppf_addCommGrpCat hasSheafify_associatedTopology_ab
  wEqualsLocallyBijective_fppfTopology_addCommGrpCat Stacks.essentiallySmall_over

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  (𝒳 : Stack.AlgebraicStacks.{u, w} B S hS)

/-- The covering-pullback condition of Stacks 00WV for the inclusion of the flat-fppf site, read
at the topology `AlgebraicGeometry.Stack.FlatFppf.topology` generated by the chosen covering
families, which agrees with the inherited one by
`AlgebraicGeometry.Stack.FlatFppf.inclusionTopology_eq_topology`. -/
theorem preservesCoveringPullbacks_inclusion_topology :
    Stacks.Sites.PreservesCoveringPullbacks (topology B S hS 𝒳) (objectProperty B S hS 𝒳).ι := by
  rw [← inclusionTopology_eq_topology]
  exact preservesCoveringPullbacks_inclusion B S hS 𝒳

attribute [local instance] preservesCoveringPullbacks_inclusion_topology

/-- Right Kan extensions of presheaves of rings along the inclusion of the flat objects exist,
the comma categories indexing them being essentially small. -/
theorem hasPointwiseRightKanExtension_inclusion_ringCat :
    ∀ F : (FlatFppf B S hS 𝒳)ᵒᵖ ⥤ RingCat.{u},
      (objectProperty B S hS 𝒳).ι.op.HasPointwiseRightKanExtension F := fun _ Y => by
  have := hasLimitsOfShape_of_essentiallySmall.{u}
    (StructuredArrow Y (objectProperty B S hS 𝒳).ι.op) RingCat.{u}
  infer_instance

/-- Right Kan extensions of presheaves of abelian groups along the inclusion of the flat objects
exist, the comma categories indexing them being essentially small. -/
theorem hasPointwiseRightKanExtension_inclusion_addCommGrpCat :
    ∀ F : (FlatFppf B S hS 𝒳)ᵒᵖ ⥤ AddCommGrpCat.{u},
      (objectProperty B S hS 𝒳).ι.op.HasPointwiseRightKanExtension F := fun _ Y => by
  have := hasLimitsOfShape_of_essentiallySmall.{u}
    (StructuredArrow Y (objectProperty B S hS 𝒳).ι.op) AddCommGrpCat.{u}
  infer_instance

attribute [local instance] hasPointwiseRightKanExtension_inclusion_ringCat
  hasPointwiseRightKanExtension_inclusion_addCommGrpCat

/-- **Stacks 0789 (2), `g^* g_! = id`, at restriction of modules**: the unit of the adjunction
between lower shriek and restriction of sheaves of modules along the inclusion of the flat
objects is invertible, the inclusion being fully faithful. -/
theorem isIso_adjunctionModules_unit_inclusion :
    IsIso (adjunctionModules (topology B S hS 𝒳) (fppfTopology B S hS 𝒳)
      (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))).unit :=
  isIso_adjunctionModules_unit _ _ _ _

/-- **The acyclicity statement of Stacks 07AC for modules on the flat-fppf site**: the lower shriek
of sheaves of modules along the inclusion of the flat objects carries every bounded above acyclic
complex of direct sums of the `j_{U!} 𝒪_U` to an acyclic complex. This is Stacks 0D6X for modules,
through `Stacks.Cohomology.DerivedLowerShriek.lowerShriekModules_acyclic_of_essentiallySmall`. -/
theorem moduleLowerShriekAcyclic (a : ℤ)
    (L : CochainComplex (SheafOfModules.{u} (inverseImageRing (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳)))) ℤ)
    (hLE : L.IsStrictlyLE a)
    (hLP : ∀ n, IsSumOfExtensionByZeroUnits (inverseImageRing (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))) (L.X n))
    (hLac : L.Acyclic) :
    (((lowerShriekModules (topology B S hS 𝒳) (fppfTopology B S hS 𝒳)
      (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳)
        (ambientStructureSheaf B S hS 𝒳))).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj L).Acyclic :=
  SmallModel.lowerShriekModules_acyclic_of_essentiallySmall _ _ _ _ a L hLE hLP hLac

section Derived

-- the abelian structure of the library on sheaves of modules whose sections contain the site
-- would be met first by instance search here, with a universe constraint it cannot solve
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

variable [HasDerivedCategory.{t} (fppfModules B S hS 𝒳)]
  [HasDerivedCategory.{t'} (flatFppfModules B S hS 𝒳)]

/-- The chosen derived category of `AlgebraicGeometry.Stack.fppfModules`, read at the spelling of
the same category in the general theory. -/
local instance hasDerivedCategory_targetModules :
    HasDerivedCategory.{t} (SheafOfModules.{u}
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))) :=
  ‹HasDerivedCategory.{t} (fppfModules B S hS 𝒳)›

/-- The chosen derived category of `AlgebraicGeometry.Stack.FlatFppf.flatFppfModules`, read at
the spelling of the same category in the general theory. -/
local instance hasDerivedCategory_sourceModules :
    HasDerivedCategory.{t'} (SheafOfModules.{u} (inverseImageRing (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳)))) :=
  ‹HasDerivedCategory.{t'} (flatFppfModules B S hS 𝒳)›

/-- **Stacks 07AS (4), existence**: the lower shriek `g_!` of sheaves of modules for the
flat-fppf site has an unbounded left derived functor, defined at every object, for any models of
the two derived categories. -/
instance hasPointwiseLeftDerivedFunctor_moduleLowerShriek :
    (lowerShriekOnHomotopy (topology B S hS 𝒳) (fppfTopology B S hS 𝒳)
      (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳)) ⋙
        DerivedCategory.Qh).HasPointwiseLeftDerivedFunctor
      (sourceQuasiIso (topology B S hS 𝒳) (fppfTopology B S hS 𝒳)
      (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))) :=
  hasPointwiseLeftDerivedLowerShriek_of_essentiallySmall _ _ _ _
    (moduleLowerShriekAcyclic B S hS 𝒳)

/-- Sheaves of modules on the fppf site of an algebraic stack form a Grothendieck abelian
category, the site being essentially small. -/
instance isGrothendieckAbelian_fppfModules :
    IsGrothendieckAbelian.{u} (SheafOfModules.{u}
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))) :=
  SheafOfModules.isGrothendieckAbelian_of_essentiallySmall _

/-- **The derived lower shriek `Lg_! : D(𝒪_{𝒳_{flat,fppf}}) ⥤ D(𝒪_𝒳)` of Stacks 07AS (4)**: the
total left derived functor of lower shriek of sheaves of modules along the inclusion of the flat
objects, with no hypothesis, for any models of the two derived categories. -/
def derivedModuleLowerShriek :
    DerivedCategory (flatFppfModules B S hS 𝒳) ⥤ DerivedCategory (fppfModules B S hS 𝒳) :=
  totalLeftDerivedLowerShriek (topology B S hS 𝒳) (fppfTopology B S hS 𝒳)
      (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))

/-- The comparison `Qh ⋙ Lg_! ⟶ g_! ⋙ Qh` exhibiting `Lg_!` as the left derived functor of
`g_!`. -/
abbrev derivedModuleLowerShriekCounit :
    DerivedCategory.Qh ⋙ derivedModuleLowerShriek B S hS 𝒳 ⟶
      lowerShriekOnHomotopy (topology B S hS 𝒳) (fppfTopology B S hS 𝒳)
      (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳)) ⋙
        DerivedCategory.Qh :=
  totalLeftDerivedLowerShriekCounit (topology B S hS 𝒳) (fppfTopology B S hS 𝒳)
      (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))

/-- **Stacks 07AS (4), adjointness**: `Lg_!` is left adjoint to `g^*`, the restriction of
complexes of modules to the flat objects, with no hypothesis, for any models. -/
def derivedModuleLowerShriekAdjunction :
    derivedModuleLowerShriek B S hS 𝒳 ⊣ derivedModuleRestriction B S hS 𝒳 :=
  totalLeftDerivedLowerShriekAdjunction (topology B S hS 𝒳) (fppfTopology B S hS 𝒳)
      (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))
    (moduleLowerShriekAcyclic B S hS 𝒳)

/-- **Stacks 07AS (4), `g^* Lg_! = id`**: the unit of `Lg_! ⊣ g^*` is invertible, with no
hypothesis. -/
theorem isIso_derivedModuleLowerShriekAdjunction_unit :
    IsIso (derivedModuleLowerShriekAdjunction B S hS 𝒳).unit :=
  isIso_totalLeftDerivedLowerShriekAdjunction_unit _ _ _ _ (moduleLowerShriekAcyclic B S hS 𝒳)
    (isIso_adjunctionModules_unit_inclusion B S hS 𝒳)

/-- **Stacks 07AS (4), `g^* Lg_! = id`, as an isomorphism of functors**: restriction after the
derived lower shriek is canonically the identity of `D(𝒪_{𝒳_{flat,fppf}})`, the inverse of the
unit of `Lg_! ⊣ g^*`. -/
def derivedModuleLowerShriekRestrictionIso :
    derivedModuleLowerShriek B S hS 𝒳 ⋙ derivedModuleRestriction B S hS 𝒳 ≅
      𝟭 (DerivedCategory (flatFppfModules B S hS 𝒳)) :=
  have := isIso_derivedModuleLowerShriekAdjunction_unit B S hS 𝒳
  (asIso (derivedModuleLowerShriekAdjunction B S hS 𝒳).unit).symm

/-- **`Lg_!` is computed degreewise on bounded above complexes of direct sums of the
`j_{U!} 𝒪_U`** (Stacks 0794, as used by Stacks 07B9): for such a complex `L` bounded above by `0`,
the comparison `Lg_!(L) ⟶ g_!(L)` exhibiting `Lg_!` as a left derived functor is an
isomorphism. -/
theorem isIso_derivedModuleLowerShriekCounit_app
    (L : CochainComplex (SheafOfModules.{u} (inverseImageRing (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳)))) ℤ)
    (hL0 : CochainComplex.IsStrictlyLE L 0)
    (hL : ∀ n, IsSumOfExtensionByZeroUnits (inverseImageRing (topology B S hS 𝒳)
      (fppfTopology B S hS 𝒳) (objectProperty B S hS 𝒳).ι
      (SmallModel.targetRing (fppfTopology B S hS 𝒳) (ambientStructureSheaf B S hS 𝒳))) (L.X n)) :
    IsIso ((derivedModuleLowerShriekCounit B S hS 𝒳).app
        ((HomotopyCategory.quotient _ (ComplexShape.up ℤ)).obj L)) :=
  isIso_totalLeftDerivedLowerShriekCounit_app _ _ _ _ (moduleLowerShriekAcyclic B S hS 𝒳) L hL0 hL

/-- `g^*` on the derived categories commutes with the shift, being induced by an exact functor. -/
local instance commShift_derivedModuleRestriction_local :
    (derivedModuleRestriction B S hS 𝒳).CommShift ℤ :=
  inferInstanceAs ((moduleRestriction B S hS 𝒳).mapDerivedCategory.CommShift ℤ)

/-- `g^*` on the derived categories is triangulated, being induced by an exact functor. -/
local instance isTriangulated_derivedModuleRestriction_local :
    (derivedModuleRestriction B S hS 𝒳).IsTriangulated :=
  inferInstanceAs (moduleRestriction B S hS 𝒳).mapDerivedCategory.IsTriangulated

/-- **`Lg_!` commutes with the shift**: the compatibility with the shift of the left adjoint of
the shift-compatible functor `g^*`. -/
instance commShift_derivedModuleLowerShriek :
    (derivedModuleLowerShriek B S hS 𝒳).CommShift ℤ :=
  (derivedModuleLowerShriekAdjunction B S hS 𝒳).leftAdjointCommShift ℤ

/-- The adjunction `Lg_! ⊣ g^*` is compatible with the shifts. -/
instance commShift_derivedModuleLowerShriekAdjunction :
    (derivedModuleLowerShriekAdjunction B S hS 𝒳).CommShift ℤ :=
  (derivedModuleLowerShriekAdjunction B S hS 𝒳).commShift_of_rightAdjoint ℤ

/-- **`Lg_!` is a triangulated functor**, being left adjoint to the triangulated functor `g^*`:
it carries distinguished triangles to distinguished triangles. -/
instance isTriangulated_derivedModuleLowerShriek :
    (derivedModuleLowerShriek B S hS 𝒳).IsTriangulated :=
  Adjunction.isTriangulated_leftAdjoint (derivedModuleLowerShriekAdjunction B S hS 𝒳)

end Derived

