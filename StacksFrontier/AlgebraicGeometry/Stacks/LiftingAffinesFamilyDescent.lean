module

public import StacksFrontier.AlgebraicGeometry.Stacks.LiftingAffinesFamilyDescentAux
public import StacksFrontier.CategoryTheory.Sites.Stack.EffectiveDescentGenerators

/-!
# Descent of smooth lifts along a covering family (Stacks 0CJU)

Let `D` be a descent datum for the category of smooth lifts of Stacks 0CJP, relative to the sieve
generated by a family `{f l : N l ⟶ U}` of the spaces-étale site of `W`. Suppose given a smooth
lift `ζ` with morphisms `m l : D.obj (f l) ⟶ ζ` over morphisms `ιX l : N l ⟶ ζ.base` which are
monomorphisms, pairwise disjoint and jointly surjective on points (in the application `ζ.base`
is the disjoint union of the `N l`), and a morphism `ε : ζ.base ⟶ U` with `ιX l ≫ ε = f l`.

The descent datum then becomes a descent datum along the single morphism `ε`: over the fibre
product `ζ.base ×_U ζ.base` there are two morphisms `σ₁, σ₂ : η ⟶ ζ`, the first a lift of the
first projection and the second glued, along the cover of the fibre product by the
`N k ×_U N l`, from the gluing isomorphisms of `D`. They are reflexive, symmetric and transitive,
because on every point they are computed by the transfer of morphisms along the gluing
isomorphisms (`CategoryTheory.Functor.SieveDescentDatum.transferHom`), which is the identity on
the diagonal and composes by the cocycle condition.

## Main results

* `AlgebraicGeometry.Stack.EtaleSmoothLift.exists_sigma₂_of_family`: the second morphism.
* `AlgebraicGeometry.Stack.EtaleSmoothLift.refl_of_family`,
  `AlgebraicGeometry.Stack.EtaleSmoothLift.symm_of_family`,
  `AlgebraicGeometry.Stack.EtaleSmoothLift.trans_of_family`: the two morphisms form an
  equivalence relation.
* `AlgebraicGeometry.Stack.EtaleSmoothLift.isEffective_of_family`: the descent datum is
  effective, by the descent along the single morphism `ε`
  (`AlgebraicGeometry.Stack.EtaleSmoothLift.exists_descent_single`).
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Functor

universe u w

namespace AlgebraicGeometry.Stack

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {𝒳 𝒳' : AlgebraicStacks.{u, w} B S hS} {ι : 𝒳 ⟶ 𝒳'} {hι : IsThickening ι}
  {W : AlgebraicSpaces B S hS}
  {x : (algebraicSpaceStackFunctor B S hS).obj W ⟶ 𝒳}
  {hx : AlgebraicStacks.IsSmooth B S hS x}

namespace EtaleSmoothLift

attribute [local instance] isFibered_proj

section FamilyDescent

variable {U : Space.SpacesEtale B S hS W} {L : Type u} {N : L → Space.SpacesEtale B S hS W}
  {f : ∀ l, N l ⟶ U}
  (D : (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).SieveDescentDatum (Sieve.ofArrows N f))

/-- The object of the descent datum at a generator. -/
abbrev famObj (l : L) : (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).Fiber (N l) :=
  D.obj (f l) (SieveDescentDatum.ofArrows_gen l)

/-- The chosen pullback morphism of the object at `f k` along the first projection of
`N k ×_U N l`. -/
abbrev famPr (k l : L) :
    IsPreFibered.pullbackObj (famObj D k).2 (pullback.fst (f k) (f l)) ⟶ (famObj D k).1 :=
  IsPreFibered.pullbackMap (famObj D k).2 (pullback.fst (f k) (f l))

/-- `famPr D k l` lies over the first projection `N k ×_U N l ⟶ N k`. -/
theorem isHomLift_famPr (k l : L) :
    (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift (pullback.fst (f k) (f l))
      (famPr D k l) :=
  isHomLift_pullbackMap_of_fiber _ _

/-- Composites of morphisms lifting `f` and `g` lift `f ≫ g`. -/
private theorem isHomLift_proj_comp {a b c : EtaleSmoothLift B S hS ι hι W x hx}
    {R R' R'' : Space.SpacesEtale B S hS W} {f : R ⟶ R'} {g : R' ⟶ R''} {φ : a ⟶ b} {ψ : b ⟶ c}
    (hφ : (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift f φ)
    (hψ : (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift g ψ) :
    (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift (f ≫ g) (φ ≫ ψ) :=
  @IsHomLift.comp _ _ _ _ proj _ _ _ _ _ _ _ _ _ _ hφ hψ

variable {ζ η : EtaleSmoothLift B S hS ι hι W x hx} {ιX : ∀ l, N l ⟶ ζ.base}
  {ε : ζ.base ⟶ U} (hε : ∀ l, ιX l ≫ ε = f l)
  {σ₁ : η ⟶ ζ} {pr₂ : η.base ⟶ ζ.base} (hP : IsPullback (Hom.base σ₁) pr₂ ε ε)

include hε in
/-- The two composites `N k ×_U N l ⟶ ζ.base ⟶ U` through `ιX k` and `ιX l` agree. -/
theorem famJ_w (k l : L) :
    (pullback.fst (f k) (f l) ≫ ιX k) ≫ ε = (pullback.snd (f k) (f l) ≫ ιX l) ≫ ε := by
  rw [Category.assoc, Category.assoc, hε, hε, pullback.condition]

/-- The morphism `N k ×_U N l ⟶ ζ.base ×_U ζ.base`. -/
def famJ (k l : L) : pullback (f k) (f l) ⟶ η.base :=
  hP.lift (pullback.fst (f k) (f l) ≫ ιX k) (pullback.snd (f k) (f l) ≫ ιX l) (famJ_w hε k l)

/-- The composite of `famJ` with the first projection is `N k ×_U N l ⟶ N k ⟶ ζ.base`. -/
theorem famJ_fst (k l : L) :
    famJ hε hP k l ≫ Hom.base σ₁ = pullback.fst (f k) (f l) ≫ ιX k :=
  hP.lift_fst _ _ _

/-- The composite of `famJ` with the second projection is `N k ×_U N l ⟶ N l ⟶ ζ.base`. -/
theorem famJ_snd (k l : L) : famJ hε hP k l ≫ pr₂ = pullback.snd (f k) (f l) ≫ ιX l :=
  hP.lift_snd _ _ _

include hε hP in
/-- **The fibre products `N k ×_U N l` cover `ζ.base ×_U ζ.base`** (Stacks 03H4, twice). -/
theorem exists_point_famJ
    (hcov : ∀ q : Space.points B S hS ζ.base.obj.left.obj, ∃ (l : L)
      (y : Space.points B S hS (N l).obj.left.obj),
        Space.pointsMap B S hS _ (ιX l).hom.left.hom y = q)
    (q : Space.points B S hS η.base.obj.left.obj) :
    ∃ (k l : L) (r : Space.points B S hS (pullback (f k) (f l)).obj.left.obj),
      Space.pointsMap B S hS _ (famJ hε hP k l).hom.left.hom r = q := by
  obtain ⟨k, y, hy⟩ := hcov (Space.pointsMap B S hS _ (Hom.base σ₁).hom.left.hom q)
  let a : pullback (f k) ε ⟶ η.base := hP.lift (pullback.fst (f k) ε ≫ ιX k)
    (pullback.snd (f k) ε) (by rw [Category.assoc, hε, pullback.condition])
  have ha₁ : a ≫ Hom.base σ₁ = pullback.fst (f k) ε ≫ ιX k := hP.lift_fst _ _ _
  have ha₂ : a ≫ pr₂ = pullback.snd (f k) ε := hP.lift_snd _ _ _
  have sqA : IsPullback a (pullback.fst (f k) ε) (Hom.base σ₁) (ιX k) := by
    refine IsPullback.of_right (h₁₂ := pr₂) (h₂₂ := ε) (v₁₃ := ε) ?_ ha₁ hP.flip
    rw [ha₂, hε]
    exact (IsPullback.of_hasPullback (f k) ε).flip
  obtain ⟨w₁, hw₁, -⟩ := Space.SpacesEtale.exists_point_of_isPullback_toSpaces sqA q y hy.symm
  obtain ⟨l, y', hy'⟩ := hcov (Space.pointsMap B S hS _ (pullback.snd (f k) ε).hom.left.hom w₁)
  let b : pullback (f k) (f l) ⟶ pullback (f k) ε :=
    pullback.lift (pullback.fst (f k) (f l)) (pullback.snd (f k) (f l) ≫ ιX l)
      (by rw [Category.assoc, hε, pullback.condition])
  have hb₁ : b ≫ pullback.fst (f k) ε = pullback.fst (f k) (f l) := pullback.lift_fst _ _ _
  have hb₂ : b ≫ pullback.snd (f k) ε = pullback.snd (f k) (f l) ≫ ιX l :=
    pullback.lift_snd _ _ _
  have sqB : IsPullback b (pullback.snd (f k) (f l)) (pullback.snd (f k) ε) (ιX l) := by
    refine IsPullback.of_right (h₁₂ := pullback.fst (f k) ε) (h₂₂ := ε) (v₁₃ := f k) ?_ hb₂
      (IsPullback.of_hasPullback (f k) ε)
    rw [hb₁, hε]
    exact IsPullback.of_hasPullback (f k) (f l)
  obtain ⟨r, hr, -⟩ := Space.SpacesEtale.exists_point_of_isPullback_toSpaces sqB w₁ y' hy'.symm
  have hj : famJ hε hP k l = b ≫ a := by
    refine hP.hom_ext ?_ ?_
    · rw [famJ_fst, Category.assoc, ha₁, ← Category.assoc, hb₁]
    · rw [famJ_snd, Category.assoc, ha₂, hb₂]
  refine ⟨k, l, r, ?_⟩
  rw [hj]
  show Space.pointsMap B S hS _ (b.hom.left.hom ≫ a.hom.left.hom) r = q
  rw [Space.pointsMap_comp_apply, hr, hw₁]

variable (m : ∀ l, (famObj D l).1 ⟶ ζ)
  (hm : ∀ l, (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift (ιX l) (m l))

include hm in
/-- `famPr D k l ≫ m k` lies over `famJ hε hP k l ≫ Hom.base σ₁`. -/
theorem isHomLift_famPr_comp (k l : L) :
    (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift
      (famJ hε hP k l ≫ Hom.base σ₁) (famPr D k l ≫ m k) :=
  isHomLift_of_eq_base (famJ_fst hε hP k l).symm
    (isHomLift_proj_comp (isHomLift_famPr D k l) (hm k))

/-- The morphism from the chosen pullback of the object at `f k` along `N k ×_U N l ⟶ N k` to
`η`, over `N k ×_U N l ⟶ ζ.base ×_U ζ.base`, lifting its composite with `m k` through `σ₁`. -/
def famM (k l : L) :
    IsPreFibered.pullbackObj (famObj D k).2 (pullback.fst (f k) (f l)) ⟶ η :=
  liftThrough σ₁ (famJ hε hP k l) (famPr D k l ≫ m k) (isHomLift_famPr_comp D hε hP m hm k l)

/-- `famM` lies over `famJ hε hP k l`. -/
theorem isHomLift_famM (k l : L) :
    (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift (famJ hε hP k l)
      (famM D hε hP m hm k l) :=
  isHomLift_liftThrough _ _ _ _

/-- The composite of `famM` with `σ₁` is `famPr D k l ≫ m k`. -/
theorem famM_comp (k l : L) : famM D hε hP m hm k l ≫ σ₁ = famPr D k l ≫ m k :=
  liftThrough_comp _ _ _ _

/-- The morphism from the chosen pullback of the object at `f k` along `N k ×_U N l ⟶ N k` to
`ζ`, over `N k ×_U N l ⟶ N l ⟶ ζ.base`: the transfer of the chosen pullback morphism along the
gluing isomorphism of `D`, followed by `m l`. -/
def famN (k l : L) :
    IsPreFibered.pullbackObj (famObj D k).2 (pullback.fst (f k) (f l)) ⟶ ζ :=
  D.transferHom (SieveDescentDatum.ofArrows_gen k) (SieveDescentDatum.ofArrows_gen l)
    (pullback.fst (f k) (f l)) (pullback.snd (f k) (f l)) pullback.condition (famPr D k l)
    (isHomLift_famPr D k l) ≫ m l

include hm in
/-- `famN D m k l` lies over `N k ×_U N l ⟶ N l ⟶ ζ.base`. -/
theorem isHomLift_famN (k l : L) :
    (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift
      (pullback.snd (f k) (f l) ≫ ιX l) (famN D m k l) :=
  isHomLift_proj_comp (D.isHomLift_transferHom _ _ _ _ _ _ _) (hm l)

include hm in
/-- **The second morphism over the fibre product**, glued along the cover by the
`N k ×_U N l` from the gluing isomorphisms of `D`. Its compatibility on overlaps is the
disjointness of the `ιX l`: over a point of two distinct summands there is nothing to check, and
over one summand the two pieces are transfers of one morphism along one pair. -/
theorem exists_sigma₂_of_family
    (hcov : ∀ q : Space.points B S hS ζ.base.obj.left.obj, ∃ (l : L)
      (y : Space.points B S hS (N l).obj.left.obj),
        Space.pointsMap B S hS _ (ιX l).hom.left.hom y = q)
    (hinj : ∀ (l : L) {Z : Space.SpacesEtale B S hS W} (u u' : Z ⟶ N l),
      u ≫ ιX l = u' ≫ ιX l → u = u')
    (hdisj : ∀ (k l : L), k ≠ l → ∀ {Z : Space.SpacesEtale B S hS W} (u : Z ⟶ N k)
      (u' : Z ⟶ N l), u ≫ ιX k = u' ≫ ιX l → IsEmpty (Space.points B S hS Z.obj.left.obj)) :
    ∃ σ₂ : η ⟶ ζ, Hom.base σ₂ = pr₂ ∧ ∀ k l, famM D hε hP m hm k l ≫ σ₂ = famN D m k l := by
  classical
  have hpts : ∀ q : Space.points B S hS η.base.obj.left.obj, ∃ (kl : L × L)
      (r : Space.points B S hS
        (IsPreFibered.pullbackObj (famObj D kl.1).2
          (pullback.fst (f kl.1) (f kl.2))).base.obj.left.obj),
        Space.pointsMap B S hS _ (Hom.base (famM D hε hP m hm kl.1 kl.2)).hom.left.hom r = q := by
    intro q
    obtain ⟨k, l, r, hr⟩ := exists_point_famJ hε hP hcov q
    refine ⟨(k, l), ?_⟩
    rw [base_eq_eqToHom_comp _ (isHomLift_famM D hε hP m hm k l)]
    obtain ⟨r', hr'⟩ := Space.SpacesEtale.exists_pointsMap_eqToHom_comp
      (@IsHomLift.domain_eq _ _ _ _ proj _ _ _ _ _ _ (isHomLift_famM D hε hP m hm k l))
      (famJ hε hP k l) r
    exact ⟨r', hr'.trans hr⟩
  obtain ⟨σ₂, ⟨hσ₂b, hσ₂⟩, -⟩ := existsUnique_hom_of_jointlySurjective (ξ := η) (η := ζ)
    (K := L × L) (fun kl => famM D hε hP m hm kl.1 kl.2) hpts
    (fun kl => famN D m kl.1 kl.2) pr₂ (fun kl => by
      rw [base_eq_eqToHom_comp _ (isHomLift_famM D hε hP m hm kl.1 kl.2),
        base_eq_eqToHom_comp _ (isHomLift_famN D m hm kl.1 kl.2)]
      exact (Category.assoc _ _ _).trans (congrArg _ (famJ_snd hε hP _ _)))
    (by
      rintro ⟨k, l⟩ ⟨k', l'⟩ ω a b - hab
      dsimp only at a b hab ⊢
      set ga := Hom.base a ≫ eqToHom
        (@IsHomLift.domain_eq _ _ _ _ proj _ _ _ _ _ _ (isHomLift_famM D hε hP m hm k l))
      set gb := Hom.base b ≫ eqToHom
        (@IsHomLift.domain_eq _ _ _ _ proj _ _ _ _ _ _ (isHomLift_famM D hε hP m hm k' l'))
      have hga := isHomLift_base_comp_eqToHom a
        (@IsHomLift.domain_eq _ _ _ _ proj _ _ _ _ _ _ (isHomLift_famM D hε hP m hm k l))
      have hgb := isHomLift_base_comp_eqToHom b
        (@IsHomLift.domain_eq _ _ _ _ proj _ _ _ _ _ _ (isHomLift_famM D hε hP m hm k' l'))
      have hA := isHomLift_proj_comp hga
        (isHomLift_famM D hε hP m hm k l)
      have hB := isHomLift_proj_comp hgb
        (isHomLift_famM D hε hP m hm k' l')
      rw [← hab] at hB
      have hj : ga ≫ famJ hε hP k l = gb ≫ famJ hε hP k' l' := isHomLift_base_unique hA hB
      have h₁ : ga ≫ pullback.fst (f k) (f l) ≫ ιX k =
          gb ≫ pullback.fst (f k') (f l') ≫ ιX k' := by
        simpa only [Category.assoc, famJ_fst] using congrArg (· ≫ Hom.base σ₁) hj
      have h₂ : ga ≫ pullback.snd (f k) (f l) ≫ ιX l =
          gb ≫ pullback.snd (f k') (f l') ≫ ιX l' := by
        simpa only [Category.assoc, famJ_snd] using congrArg (· ≫ pr₂) hj
      have hσ : (a ≫ famPr D k l) ≫ m k = (b ≫ famPr D k' l') ≫ m k' := by
        simpa only [Category.assoc, famM_comp] using congrArg (· ≫ σ₁) hab
      have hN := isHomLift_proj_comp hga (isHomLift_famN D m hm k l)
      have hN' := isHomLift_proj_comp hgb (isHomLift_famN D m hm k' l')
      have hbase : Hom.base (a ≫ famN D m k l) = Hom.base (b ≫ famN D m k' l') :=
        (base_eq_of_isHomLift _ hN).trans (h₂.trans (base_eq_of_isHomLift _ hN').symm)
      have hempty : IsEmpty (Space.points B S hS ω.base.obj.left.obj) →
          a ≫ famN D m k l = b ≫ famN D m k' l' :=
        fun h => hom_eq_of_isEmpty_points h _ _ hbase
      by_cases hk : k = k'
      · subst hk
        have hu : ga ≫ pullback.fst (f k) (f l) = gb ≫ pullback.fst (f k) (f l') :=
          hinj k _ _ (by simpa only [Category.assoc] using h₁)
        by_cases hl : l = l'
        · subst hl
          have hv : ga ≫ pullback.snd (f k) (f l) = gb ≫ pullback.snd (f k) (f l) :=
            hinj l _ _ (by simpa only [Category.assoc] using h₂)
          have hα : a ≫ famPr D k l = b ≫ famPr D k l :=
            hom_eq_of_comp_eq_of_isHomLift (m k) (hm k)
              (isHomLift_proj_comp hga (isHomLift_famPr D k l))
              (isHomLift_of_eq_base hu.symm
                (isHomLift_proj_comp hgb (isHomLift_famPr D k l)))
              hσ
          have hw : ∀ (g : ω.base ⟶ pullback (f k) (f l)),
              (g ≫ pullback.fst (f k) (f l)) ≫ f k = (g ≫ pullback.snd (f k) (f l)) ≫ f l :=
            fun g => by rw [Category.assoc, Category.assoc, pullback.condition]
          unfold famN
          rw [← Category.assoc, ← Category.assoc,
            D.comp_transferHom _ _ _ _ _ ga _ _ a hga (hw ga)
              (isHomLift_proj_comp hga (isHomLift_famPr D k l)),
            D.comp_transferHom _ _ _ _ _ gb _ _ b hgb (hw gb)
              (isHomLift_proj_comp hgb (isHomLift_famPr D k l)),
            D.transferHom_congr _ _ hu hv (hw ga) (hw gb) hα]
        · exact hempty (hdisj l l' hl (ga ≫ pullback.snd (f k) (f l))
            (gb ≫ pullback.snd (f k) (f l')) (by simpa only [Category.assoc] using h₂))
      · exact hempty (hdisj k k' hk (ga ≫ pullback.fst (f k) (f l))
          (gb ≫ pullback.fst (f k') (f l')) (by simpa only [Category.assoc] using h₁)))
  exact ⟨σ₂, hσ₂b, fun k l => hσ₂ (k, l)⟩

include hm in
/-- A morphism into `ζ` whose base factors through `ιX k` factors through `m k`. -/
theorem exists_factor_famObj {ω : EtaleSmoothLift B S hS ι hι W x hx} (t : ω ⟶ ζ) {k : L}
    (v : ω.base ⟶ N k) (h : Hom.base t = v ≫ ιX k) :
    ∃ α : ω ⟶ (famObj D k).1,
      (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift v α ∧ α ≫ m k = t :=
  exists_lift_of_isHomLift (m k) (hm k) v t (isHomLift_of_eq_base h (isHomLift_base t))

include hε hP in
/-- The two bases of a morphism into `η` agree over `U`. -/
theorem comp_eq_comp_of_base {ω : EtaleSmoothLift B S hS ι hι W x hx} (d : ω ⟶ η) {k l : L}
    {u : ω.base ⟶ N k} {v : ω.base ⟶ N l} (hu : Hom.base d ≫ Hom.base σ₁ = u ≫ ιX k)
    (hv : Hom.base d ≫ pr₂ = v ≫ ιX l) : u ≫ f k = v ≫ f l := by
  rw [← hε, ← hε, ← Category.assoc, ← hu, Category.assoc, hP.w, ← Category.assoc, hv,
    Category.assoc]

variable {σ₂ : η ⟶ ζ} (hσ₂b : Hom.base σ₂ = pr₂)
  (hσ₂ : ∀ k l, famM D hε hP m hm k l ≫ σ₂ = famN D m k l)

include hσ₂b hσ₂ in
/-- **The second morphism is computed by the transfer.** If `d ≫ σ₁ = α ≫ m k` and
`d ≫ σ₂ = β ≫ m l`, then `β` is the transfer of `α` along the gluing isomorphism of `D`. -/
theorem eq_transferHom_of_comp_eq {ω : EtaleSmoothLift B S hS ι hι W x hx} (d : ω ⟶ η)
    {k l : L} {u : ω.base ⟶ N k} {v : ω.base ⟶ N l} (huv : u ≫ f k = v ≫ f l)
    (α : ω ⟶ (famObj D k).1) (β : ω ⟶ (famObj D l).1)
    (hα : (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift u α)
    (hβ : (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift v β)
    (h₁ : d ≫ σ₁ = α ≫ m k) (h₂ : d ≫ σ₂ = β ≫ m l) :
    β = D.transferHom (SieveDescentDatum.ofArrows_gen k) (SieveDescentDatum.ofArrows_gen l)
      u v huv α hα := by
  have hbase : ∀ {j : L} {w : ω.base ⟶ N j} {γ : ω ⟶ (famObj D j).1} {t : ω ⟶ ζ},
      (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift w γ → t = γ ≫ m j →
        Hom.base t = w ≫ ιX j := fun hγ ht =>
    isHomLift_base_unique (isHomLift_base _) (ht ▸ isHomLift_proj_comp hγ (hm _))
  have hd₁ : Hom.base d ≫ Hom.base σ₁ = u ≫ ιX k := hbase hα h₁
  have hd₂ : Hom.base d ≫ pr₂ = v ≫ ιX l := by
    rw [← hσ₂b]
    exact hbase hβ h₂
  have hw : Hom.base d = pullback.lift u v huv ≫ famJ hε hP k l := by
    refine hP.hom_ext ?_ ?_
    · rw [Category.assoc, famJ_fst, pullback.lift_fst_assoc, hd₁]
    · rw [Category.assoc, famJ_snd, pullback.lift_snd_assoc, hd₂]
  obtain ⟨e, he, hed⟩ := exists_lift_of_isHomLift (famM D hε hP m hm k l)
    (isHomLift_famM D hε hP m hm k l) (pullback.lift u v huv) d
    (isHomLift_of_eq_base hw (isHomLift_base d))
  have hα' : α = e ≫ famPr D k l :=
    hom_eq_of_comp_eq_of_isHomLift (m k) (hm k) hα
      (isHomLift_of_eq_base (pullback.lift_fst _ _ _)
        (isHomLift_proj_comp he (isHomLift_famPr D k l)))
      (by rw [← h₁, ← hed, Category.assoc, Category.assoc, famM_comp])
  have hβ' : β = e ≫ D.transferHom (SieveDescentDatum.ofArrows_gen k)
      (SieveDescentDatum.ofArrows_gen l) (pullback.fst (f k) (f l)) (pullback.snd (f k) (f l))
      pullback.condition (famPr D k l) (isHomLift_famPr D k l) :=
    hom_eq_of_comp_eq_of_isHomLift (m l) (hm l) hβ
      (isHomLift_of_eq_base (pullback.lift_snd _ _ _)
        (isHomLift_proj_comp he
          (D.isHomLift_transferHom _ _ _ _ _ _ _)))
      (by rw [← h₂, ← hed, Category.assoc, Category.assoc, hσ₂]; rfl)
  rw [hβ', D.comp_transferHom _ _ _ _ _ (pullback.lift u v huv) _ _ e he
    (by rw [Category.assoc, Category.assoc, pullback.condition])
    (isHomLift_proj_comp he (isHomLift_famPr D k l))]
  exact D.transferHom_congr _ _ (pullback.lift_fst _ _ _) (pullback.lift_snd _ _ _) _ _
    hα'.symm _ _

/-- A morphism into `η` whose base composed with `pr₂` factors through `ιX l` has its
`σ₂`-composite factoring through `m l`. -/
private theorem exists_factor_famObj_sigma₂
    (hm : ∀ l, (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift (ιX l) (m l))
    (hσ₂b : Hom.base σ₂ = pr₂) {ω : EtaleSmoothLift B S hS ι hι W x hx} (d : ω ⟶ η)
    {l : L} {v : ω.base ⟶ N l} (h : Hom.base d ≫ pr₂ = v ≫ ιX l) :
    ∃ β : ω ⟶ (famObj D l).1,
      (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift v β ∧ β ≫ m l = d ≫ σ₂ :=
  exists_factor_famObj D m hm (d ≫ σ₂) v (by rw [← hσ₂b] at h; exact h)

variable (hcov : ∀ q : Space.points B S hS ζ.base.obj.left.obj, ∃ (l : L)
      (y : Space.points B S hS (N l).obj.left.obj),
        Space.pointsMap B S hS _ (ιX l).hom.left.hom y = q)

include hσ₂b hσ₂ hcov in
/-- **Reflexivity**: the lift of the identity of `ζ` through `σ₁` over the diagonal is a
section of `σ₂` too, since the transfer along a pair `(u, u)` is the identity. -/
theorem refl_of_family : ∃ r : ζ ⟶ η, r ≫ σ₁ = 𝟙 ζ ∧ r ≫ σ₂ = 𝟙 ζ := by
  obtain ⟨r, hr, hr₁⟩ := exists_lift_of_isHomLift σ₁ (isHomLift_base σ₁)
    (hP.lift (𝟙 _) (𝟙 _) rfl) (𝟙 ζ)
    (isHomLift_of_eq_base (hP.lift_fst _ _ _).symm
      (IsHomLift.id (p := (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _)) rfl))
  have hrb : Hom.base r = hP.lift (𝟙 _) (𝟙 _) rfl := base_eq_of_isHomLift r hr
  refine ⟨r, hr₁, hom_eq_of_forall_comp_eq ιX hcov (𝟙 ζ.base) ?_ fun l ω' t v hv => ?_⟩
  · show Hom.base r ≫ Hom.base σ₂ = 𝟙 _
    rw [hrb, hσ₂b, hP.lift_snd]
  · rw [Category.comp_id] at hv
    obtain ⟨α, hα, hαt⟩ := exists_factor_famObj D m hm t v hv
    obtain ⟨β, hβ, hβt⟩ := exists_factor_famObj_sigma₂ D m hm hσ₂b (t ≫ r) (v := v) (by
      show Hom.base t ≫ Hom.base r ≫ pr₂ = _
      rw [hrb, hP.lift_snd, Category.comp_id, hv])
    have key := eq_transferHom_of_comp_eq D hε hP m hm hσ₂b hσ₂ (t ≫ r) rfl α β hα hβ
      (by rw [Category.assoc, hr₁, Category.comp_id, hαt]) hβt.symm
    rw [D.transferHom_self] at key
    rw [← Category.assoc, ← hβt, key, hαt, Category.comp_id]

include hσ₂b hσ₂ hcov in
/-- **Symmetry**: the lift of `σ₂` through `σ₁` over the swap of the factors is exchanged with
`σ₁` by `σ₂`, since transfers compose and the transfer back and forth is the identity. -/
theorem symm_of_family : ∃ v : η ⟶ η, v ≫ σ₁ = σ₂ ∧ v ≫ σ₂ = σ₁ := by
  obtain ⟨v, hv, hv₁⟩ := exists_lift_of_isHomLift σ₁ (isHomLift_base σ₁)
    (hP.lift pr₂ (Hom.base σ₁) hP.w.symm) σ₂
    (isHomLift_of_eq_base (by rw [hP.lift_fst, hσ₂b]) (isHomLift_base σ₂))
  have hvb : Hom.base v = hP.lift pr₂ (Hom.base σ₁) hP.w.symm := base_eq_of_isHomLift v hv
  have hb : Hom.base (v ≫ σ₂) = Hom.base σ₁ := by
    show Hom.base v ≫ Hom.base σ₂ = _
    rw [hvb, hσ₂b, hP.lift_snd]
  refine ⟨v, hv₁, hom_eq_of_forall_comp_eq ιX hcov (Hom.base σ₁) hb
    fun k ω' t u₁ hu₁ => ?_⟩
  refine hom_eq_of_forall_comp_eq ιX hcov (Hom.base t ≫ pr₂)
    (by show Hom.base t ≫ Hom.base (v ≫ σ₂) = Hom.base t ≫ Hom.base σ₁; rw [hb])
    fun l ω'' t' u₂ hu₂ => ?_
  simp only [← Category.assoc]
  set T := t' ≫ t
  have hT₁ : Hom.base T ≫ Hom.base σ₁ = (Hom.base t' ≫ u₁) ≫ ιX k := by
    show (Hom.base t' ≫ Hom.base t) ≫ _ = _
    rw [Category.assoc, hu₁, Category.assoc]
  have hT₂ : Hom.base T ≫ pr₂ = u₂ ≫ ιX l := by
    show (Hom.base t' ≫ Hom.base t) ≫ _ = _
    rw [Category.assoc, hu₂]
  have h₁₂ := comp_eq_comp_of_base hε hP T hT₁ hT₂
  obtain ⟨α₁, hα₁, hα₁t⟩ := exists_factor_famObj D m hm (T ≫ σ₁) (Hom.base t' ≫ u₁) hT₁
  obtain ⟨α₂, hα₂, hα₂t⟩ := exists_factor_famObj_sigma₂ D m hm hσ₂b T hT₂
  obtain ⟨β, hβ, hβt⟩ := exists_factor_famObj D m hm ((T ≫ v) ≫ σ₂) (Hom.base t' ≫ u₁)
    (by show Hom.base T ≫ Hom.base (v ≫ σ₂) = _; rw [hb, hT₁])
  have e₁ := eq_transferHom_of_comp_eq D hε hP m hm hσ₂b hσ₂ T h₁₂ α₁ α₂ hα₁ hα₂ hα₁t.symm
    hα₂t.symm
  have e₂ := eq_transferHom_of_comp_eq D hε hP m hm hσ₂b hσ₂ (T ≫ v) h₁₂.symm α₂ β hα₂ hβ
    (by rw [Category.assoc, hv₁, hα₂t]) hβt.symm
  have e₃ : β = α₁ := by
    rw [e₂, D.transferHom_congr _ _ rfl rfl h₁₂.symm h₁₂.symm e₁ hα₂
        (D.isHomLift_transferHom _ _ _ _ h₁₂ α₁ hα₁),
      D.transferHom_transferHom _ _ _ _ _ _ h₁₂ h₁₂.symm rfl, D.transferHom_self]
  rw [← hβt, e₃, hα₁t]

include hσ₂b hσ₂ hcov in
/-- **Transitivity**: for `a, b : ω ⟶ η` with `a ≫ σ₂ = b ≫ σ₁`, the lift of `a ≫ σ₁` through
`σ₁` over the pair of outer projections has `σ₂`-composite `b ≫ σ₂`, by the cocycle condition. -/
theorem trans_of_family (ω : EtaleSmoothLift B S hS ι hι W x hx) (a b : ω ⟶ η)
    (hab : a ≫ σ₂ = b ≫ σ₁) : ∃ c : ω ⟶ η, c ≫ σ₁ = a ≫ σ₁ ∧ c ≫ σ₂ = b ≫ σ₂ := by
  have hab' : Hom.base a ≫ pr₂ = Hom.base b ≫ Hom.base σ₁ := by
    rw [← hσ₂b]
    exact congrArg Hom.base hab
  have hw : (Hom.base a ≫ Hom.base σ₁) ≫ ε = (Hom.base b ≫ pr₂) ≫ ε := by
    rw [Category.assoc, hP.w, ← Category.assoc, hab', Category.assoc, hP.w, Category.assoc]
  obtain ⟨c, hc, hc₁⟩ := exists_lift_of_isHomLift σ₁ (isHomLift_base σ₁)
    (hP.lift _ _ hw) (a ≫ σ₁)
    (isHomLift_of_eq_base (hP.lift_fst _ _ _).symm (isHomLift_base (a ≫ σ₁)))
  have hcb : Hom.base c = hP.lift _ _ hw := base_eq_of_isHomLift c hc
  have hb : Hom.base (c ≫ σ₂) = Hom.base (b ≫ σ₂) := by
    show Hom.base c ≫ Hom.base σ₂ = Hom.base b ≫ Hom.base σ₂
    rw [hcb, hσ₂b, hP.lift_snd]
  refine ⟨c, hc₁, hom_eq_of_forall_comp_eq ιX hcov (Hom.base a ≫ Hom.base σ₁) hb
    fun k ω₁ t₁ u₁ hu₁ => ?_⟩
  refine hom_eq_of_forall_comp_eq ιX hcov (Hom.base t₁ ≫ Hom.base a ≫ pr₂)
    (by show Hom.base t₁ ≫ Hom.base (c ≫ σ₂) = Hom.base t₁ ≫ Hom.base (b ≫ σ₂); rw [hb])
    fun l ω₂ t₂ u₂ hu₂ => ?_
  refine hom_eq_of_forall_comp_eq ιX hcov (Hom.base t₂ ≫ Hom.base t₁ ≫ Hom.base b ≫ pr₂)
    (by
      show Hom.base t₂ ≫ Hom.base t₁ ≫ Hom.base (c ≫ σ₂) =
        Hom.base t₂ ≫ Hom.base t₁ ≫ Hom.base (b ≫ σ₂)
      rw [hb])
    fun n ω₃ t₃ u₃ hu₃ => ?_
  simp only [← Category.assoc]
  set T := (t₃ ≫ t₂) ≫ t₁
  have hT₁ : Hom.base (T ≫ a) ≫ Hom.base σ₁ =
      (Hom.base t₃ ≫ Hom.base t₂ ≫ u₁) ≫ ιX k := by
    change ((Hom.base t₃ ≫ Hom.base t₂) ≫ Hom.base t₁) ≫ Hom.base a ≫ _ = _ at *
    simp only [Category.assoc] at hu₁ ⊢
    rw [hu₁]
  have hT₂ : Hom.base (T ≫ a) ≫ pr₂ = (Hom.base t₃ ≫ u₂) ≫ ιX l := by
    show (((Hom.base t₃ ≫ Hom.base t₂) ≫ Hom.base t₁) ≫ Hom.base a) ≫ _ = _
    simp only [Category.assoc] at hu₂ ⊢
    rw [hu₂]
  have hT₃ : Hom.base (T ≫ b) ≫ pr₂ = u₃ ≫ ιX n := by
    show (((Hom.base t₃ ≫ Hom.base t₂) ≫ Hom.base t₁) ≫ Hom.base b) ≫ _ = _
    simp only [Category.assoc] at hu₃ ⊢
    rw [hu₃]
  have hT₂' : Hom.base (T ≫ b) ≫ Hom.base σ₁ = (Hom.base t₃ ≫ u₂) ≫ ιX l := by
    rw [← hT₂]
    show (Hom.base T ≫ Hom.base b) ≫ _ = (Hom.base T ≫ Hom.base a) ≫ _
    rw [Category.assoc, Category.assoc, hab']
  have hTc₁ : Hom.base (T ≫ c) ≫ Hom.base σ₁ =
      (Hom.base t₃ ≫ Hom.base t₂ ≫ u₁) ≫ ιX k := by
    rw [← hT₁]
    show (Hom.base T ≫ Hom.base c) ≫ _ = (Hom.base T ≫ Hom.base a) ≫ _
    rw [hcb, Category.assoc, Category.assoc, hP.lift_fst]
  have hTc₃ : Hom.base (T ≫ c) ≫ pr₂ = u₃ ≫ ιX n := by
    rw [← hT₃]
    show (Hom.base T ≫ Hom.base c) ≫ _ = (Hom.base T ≫ Hom.base b) ≫ _
    rw [hcb, Category.assoc, Category.assoc, hP.lift_snd]
  have h₁₂ := comp_eq_comp_of_base hε hP (T ≫ a) hT₁ hT₂
  have h₂₃ := comp_eq_comp_of_base hε hP (T ≫ b) hT₂' hT₃
  have h₁₃ := comp_eq_comp_of_base hε hP (T ≫ c) hTc₁ hTc₃
  obtain ⟨α₁, hα₁, hα₁t⟩ := exists_factor_famObj D m hm ((T ≫ a) ≫ σ₁) _ hT₁
  obtain ⟨α₂, hα₂, hα₂t⟩ := exists_factor_famObj_sigma₂ D m hm hσ₂b (T ≫ a) hT₂
  obtain ⟨α₃, hα₃, hα₃t⟩ := exists_factor_famObj_sigma₂ D m hm hσ₂b (T ≫ b) hT₃
  obtain ⟨β, hβ, hβt⟩ := exists_factor_famObj_sigma₂ D m hm hσ₂b (T ≫ c) hTc₃
  have e₁ := eq_transferHom_of_comp_eq D hε hP m hm hσ₂b hσ₂ (T ≫ a) h₁₂ α₁ α₂ hα₁ hα₂
    hα₁t.symm hα₂t.symm
  have e₂ := eq_transferHom_of_comp_eq D hε hP m hm hσ₂b hσ₂ (T ≫ b) h₂₃ α₂ α₃ hα₂ hα₃
    (by rw [Category.assoc, ← hab, ← Category.assoc, hα₂t]) hα₃t.symm
  have e₃ := eq_transferHom_of_comp_eq D hε hP m hm hσ₂b hσ₂ (T ≫ c) h₁₃ α₁ β hα₁ hβ
    (by rw [Category.assoc, hc₁, ← Category.assoc, hα₁t]) hβt.symm
  have e₄ : β = α₃ := by
    rw [e₃, e₂, D.transferHom_congr _ _ rfl rfl h₂₃ h₂₃ e₁ hα₂
        (D.isHomLift_transferHom _ _ _ _ h₁₂ α₁ hα₁),
      D.transferHom_transferHom _ _ _ _ _ _ h₁₂ h₂₃ h₁₃]
  rw [← hβt, e₄, hα₃t]

/-- **Effectivity of a descent datum along a covering family, from a smooth lift over a disjoint
union of its members.** Let `D` be a descent datum relative to the sieve generated by
`{f l : N l ⟶ U}`, and `m l : D.obj (f l) ⟶ ζ` morphisms over monomorphisms `ιX l : N l ⟶ ζ.base`
which are pairwise disjoint and jointly surjective on points, with `ιX l ≫ ε = f l` for an
étale surjective `ε : ζ.base ⟶ U` out of a representable space. Then `D` is effective: the
two morphisms over `ζ.base ×_U ζ.base` form an equivalence relation, so `ζ` descends along `ε`
by `AlgebraicGeometry.Stack.EtaleSmoothLift.exists_descent_single`, and the composites of the
`m l` with the descent are cartesian and compatible with the gluing isomorphisms by
`CategoryTheory.Functor.SieveDescentDatum.isEffective_of_generators`. -/
theorem isEffective_of_family (ζ : EtaleSmoothLift B S hS ι hι W x hx)
    (hrep : ζ.base.obj.left.obj.IsRepresentable) (ιX : ∀ l, N l ⟶ ζ.base)
    (hcov : ∀ q : Space.points B S hS ζ.base.obj.left.obj, ∃ (l : L)
      (y : Space.points B S hS (N l).obj.left.obj),
        Space.pointsMap B S hS _ (ιX l).hom.left.hom y = q)
    (hinj : ∀ (l : L) {Z : Space.SpacesEtale B S hS W} (u u' : Z ⟶ N l),
      u ≫ ιX l = u' ≫ ιX l → u = u')
    (hdisj : ∀ (k l : L), k ≠ l → ∀ {Z : Space.SpacesEtale B S hS W} (u : Z ⟶ N k)
      (u' : Z ⟶ N l), u ≫ ιX k = u' ≫ ιX l → IsEmpty (Space.points B S hS Z.obj.left.obj))
    (ε : ζ.base ⟶ U) (hε : ∀ l, ιX l ≫ ε = f l)
    (hsurj : Space.IsSurjective B S hS ε.hom.left.hom) (m : ∀ l, (famObj D l).1 ⟶ ζ)
    (hm : ∀ l, (proj : EtaleSmoothLift B S hS ι hι W x hx ⥤ _).IsHomLift (ιX l) (m l)) :
    D.IsEffective := by
  obtain ⟨η, σ₁, hη, hσ₁⟩ := exists_hom_base_eq ζ (pullback.fst ε ε)
  have hP : IsPullback (Hom.base σ₁) (eqToHom hη ≫ pullback.snd ε ε) ε ε := by
    rw [hσ₁]
    exact (IsPullback.of_hasPullback ε ε).of_iso (eqToIso hη).symm (Iso.refl _) (Iso.refl _)
      (Iso.refl _) (by simp) (by simp) (by simp) (by simp)
  obtain ⟨σ₂, hσ₂b, hσ₂⟩ := exists_sigma₂_of_family D hε hP m hm hcov hinj hdisj
  have hpb : IsPullback (Hom.base σ₁) (Hom.base σ₂) ε ε := hσ₂b ▸ hP
  obtain ⟨Z, M, hM, hMσ⟩ := exists_descent_single σ₁ σ₂ hrep hsurj hpb
    (refl_of_family D hε hP m hm hσ₂b hσ₂ hcov) (symm_of_family D hε hP m hm hσ₂b hσ₂ hcov)
    (fun ω a b _ hab => trans_of_family D hε hP m hm hσ₂b hσ₂ hcov ω a b hab)
  refine SieveDescentDatum.isEffective_of_generators D Z (fun l => m l ≫ M) (fun l => ?_)
    (fun l n => ?_)
  · have hl := isHomLift_of_eq_base (hε l)
      (isHomLift_proj_comp (hm l) hM)
    have hs := @Functor.IsFiberedInGroupoids.isStronglyCartesian_homLift _ _ _ _ proj
      isFiberedInGroupoids_proj _ _ _ _ (f l) (m l ≫ M) hl
    exact @Functor.IsStronglyCartesian.isCartesian_of_isStronglyCartesian _ _ _ _ proj _ _ _ _
      (f l) (m l ≫ M) hs
  · have t := D.transferHom_pullbackMap (SieveDescentDatum.ofArrows_gen l)
      (SieveDescentDatum.ofArrows_gen n) (pullback.fst (f l) (f n)) (pullback.snd (f l) (f n))
      pullback.condition
    refine Eq.trans (Category.assoc _ _ _).symm ?_
    refine Eq.trans (congrArg (· ≫ m n ≫ M) t.symm) ?_
    refine Eq.trans (Category.assoc _ _ _).symm ?_
    show famN D m l n ≫ M = _
    rw [← hσ₂, Category.assoc, ← hMσ, ← Category.assoc, famM_comp, Category.assoc]

end FamilyDescent

