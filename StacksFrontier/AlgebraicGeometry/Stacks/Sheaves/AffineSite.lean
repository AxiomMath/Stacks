module

public import StacksCore.CategoryTheory.FiberedInGroupoids
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Stacks.AssociatedSite
public import StacksFrontier.AlgebraicGeometry.Topologies.Fppf

/-!
# The affine subcategory over the big fppf site, and its topologies (Stacks 0H09, 0H0A)

Let `p : 𝒳 ⥤ (Sch/S)_{fppf}` be a category over the big fppf category of a scheme `S`. Its
*affine subcategory* `𝒳_{affine}` is the full subcategory of the objects lying over an affine
scheme. Stacks 0H09 calls it the associated affine site, with the chaotic topology, for which
sheaves and presheaves agree; Stacks 0H0A equips it instead with the structure of a site for each
of the Zariski, étale, smooth, syntomic and fppf topologies, by giving it the topology inherited
(Stacks 06NV) from the corresponding topology on the affine schemes over `S`.

As for `AlgebraicGeometry.Stack.associatedTopology` itself, the construction uses nothing about
which topology is chosen, so it is given here once for an arbitrary topology on the category of
affine schemes over `S`; the five associated affine sites of the source are its values at the
five big affine topologies.

## Main definitions

* `AlgebraicGeometry.Stack.IsAffineObject` and `AlgebraicGeometry.Stack.AffineCategory`: the
  objects of `𝒳` lying over an affine scheme, and the full subcategory they span.
* `AlgebraicGeometry.Stack.AffineCategory.toAffine`: the structure functor restricted to the
  affine subcategory, landing in the affine schemes over `S`.
* `AlgebraicGeometry.Stack.associatedAffineTopology`: **Stacks 0H0A**, the associated affine
  site.
* `AlgebraicGeometry.Stack.associatedAffineChaoticTopology` and
  `AlgebraicGeometry.Stack.sheafAssociatedAffineChaoticEquivalence`: **Stacks 0H09**, the
  associated affine site with its chaotic topology, and the equivalence between its sheaves and
  the presheaves on the affine subcategory.

## Main results

* `AlgebraicGeometry.Stack.AffineCategory.isStronglyCartesian_toAffine`: for a category fibred
  in groupoids, every arrow of the affine subcategory is strongly cartesian over its image.
* `AlgebraicGeometry.Stack.generate_mem_associatedAffineTopology`: a family of the affine
  subcategory whose image is covering generates a covering sieve, which is the description of
  the coverings of `𝒳_{affine, τ}` in the paragraph following the source's definition.

## Implementation notes

The affine subcategory does not depend on the topology: it has the same objects and the same
arrows in all five cases, and only the inherited topology varies. The restricted structure
functor is the lift of `inclusion ⋙ p` through the affine objects of the big fppf slice, which
is exactly where the affineness of the objects is used.

`CategoryTheory.Functor.inheritedTopology` is the topology generated by the families of strongly
cartesian arrows whose image is covering, so the covering description of the source is an
instance of `CategoryTheory.Precoverage.generate_mem_toGrothendieck` once every arrow of the
affine subcategory is known to be strongly cartesian; that is what
`AffineCategory.isStronglyCartesian_toAffine` supplies, and it is where fibredness in groupoids
enters. Fibredness is not needed to *define* the inherited topology.

The chaotic topology of Stacks 0H09 is Mathlib's `CategoryTheory.GrothendieckTopology.trivial`,
which is the bottom topology, so its sheaves are the presheaves by
`CategoryTheory.sheafBotEquivalence`.

## References

* [Stacks Project, Tag 0H09](https://stacks.math.columbia.edu/tag/0H09)
* [Stacks Project, Tag 0H0A](https://stacks.math.columbia.edu/tag/0H0A)
-/

@[expose] public section

open CategoryTheory

section
open CategoryTheory.Limits
universe u₀ v₀

/-- Sheaves of sets on a site have colimits of the size of the join of the two universes of the
site, restated in its constructed form: the instance search that finds it is not cheap, and the
finite coproducts of sheafified representables that the colimit conditions of Stacks 0GN3 and
0GN4 speak of need it. -/
instance sheafOfTypes_hasColimitsOfSize_join {C : Type u₀} [Category.{v₀} C]
    (J : GrothendieckTopology C) :
    HasColimitsOfSize.{max u₀ v₀, max u₀ v₀} (Sheaf J (Type max u₀ v₀)) :=
  Sheaf.instHasColimitsOfSize

end

namespace AlgebraicGeometry.Stack

universe u v w

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {𝒳 : Type v} [Category.{w} 𝒳] (p : 𝒳 ⥤ BigFppfOver B S hS)

/-- The objects of a category over the big fppf category of `S` whose underlying schemes are
affine. -/
abbrev IsAffineObject : ObjectProperty 𝒳 :=
  fun x ↦ IsAffine ((p ⋙ BigFppfOver.toScheme B S hS).obj x)

/-- **Stacks 0H0A.** The affine subcategory of a category over the big fppf category of `S`:
the full subcategory of the objects lying over an affine scheme. -/
@[stacks 0H0A "the affine subcategory"]
abbrev AffineCategory := (IsAffineObject B S hS p).FullSubcategory

namespace AffineCategory

/-- The inclusion of the affine subcategory into the ambient category. -/
abbrev inclusion : AffineCategory B S hS p ⥤ 𝒳 := (IsAffineObject B S hS p).ι

/-- The structure functor restricted to the affine subcategory, landing in the affine schemes
over `S`. -/
def toAffine : AffineCategory B S hS p ⥤ BigAffineFppf B S hS :=
  ObjectProperty.lift (IsAffineOver B S hS) (inclusion B S hS p ⋙ p) (fun x ↦ x.property)

/-- **Stacks 0H0A.** Every arrow between affine objects of a category fibred in groupoids is
strongly cartesian for the restricted structure functor. -/
@[stacks 0H0A "arrows are strongly cartesian"]
theorem isStronglyCartesian_toAffine (hp : p.IsFiberedInGroupoids)
    {x y : AffineCategory B S hS p} (φ : y ⟶ x) :
    (toAffine B S hS p).IsStronglyCartesian ((toAffine B S hS p).map φ) φ := by
  let q := toAffine B S hS p
  refine ⟨fun {z} g ψ hψ ↦ ?_⟩
  have hcomm : g.hom ≫ p.map φ.hom = p.map ψ.hom :=
    congrArg (fun f ↦ f.hom) (IsHomLift.eq_of_isHomLift q (g ≫ q.map φ) ψ)
  obtain ⟨χ, hχ, huniq⟩ := hp.unique_lift φ.hom ψ.hom g.hom hcomm
  refine ⟨ObjectProperty.homMk χ, ⟨?_, ObjectProperty.hom_ext _ hχ.2⟩, ?_⟩
  · rw [← (ObjectProperty.hom_ext _ hχ.1 : q.map (ObjectProperty.homMk χ) = g)]
    infer_instance
  · intro χ' ⟨hχ'lift, hχ'fac⟩
    exact ObjectProperty.hom_ext _ (huniq χ'.hom
      ⟨congrArg (fun f ↦ f.hom) (IsHomLift.eq_of_isHomLift q g χ').symm,
        congrArg (fun f ↦ f.hom) hχ'fac⟩)

end AffineCategory

/-- **Stacks 0H0A.** The associated affine site of a category `p : 𝒳 ⥤ (Sch/S)_{fppf}` and a
topology `τ` on the affine schemes over `S`: the topology the affine subcategory inherits
from `τ`.

The five associated affine sites of the source — Zariski, étale, smooth, syntomic and fppf —
are the values of this at the five big affine topologies. -/
@[stacks 0H0A "the associated affine topology"]
abbrev associatedAffineTopology (τ : GrothendieckTopology (BigAffineFppf B S hS)) :
    GrothendieckTopology (AffineCategory B S hS p) :=
  (AffineCategory.toAffine B S hS p).inheritedTopology τ

/-- **Stacks 0H0A.** A family in the affine subcategory of a category fibred in groupoids whose
image in the affine schemes over `S` generates a covering sieve generates a covering sieve for
the associated affine topology.

This is the description of the coverings of `𝒳_{affine, τ}` in the paragraph following the
source's definition. -/
@[stacks 0H0A "the covering families"]
theorem generate_mem_associatedAffineTopology (hp : p.IsFiberedInGroupoids)
    (τ : GrothendieckTopology (BigAffineFppf B S hS))
    (E : Covering.{v, w, u + 1} (AffineCategory B S hS p))
    (hE : Sieve.generate (E.2.map (AffineCategory.toAffine B S hS p)).presieve₀ ∈
      τ ((AffineCategory.toAffine B S hS p).obj E.1)) :
    Sieve.generate E.2.presieve₀ ∈ associatedAffineTopology B S hS p τ E.1 := by
  apply Precoverage.generate_mem_toGrothendieck
  refine ⟨fun _ _ _ ↦ AffineCategory.isStronglyCartesian_toAffine B S hS p hp _, ?_⟩
  rwa [GrothendieckTopology.mem_toPrecoverage_iff, ← PreZeroHypercover.presieve₀_map]

/-- **Stacks 0H09.** The associated affine site of a category `p : 𝒳 ⥤ (Sch/S)_{fppf}`: the
affine subcategory `𝒳_{affine}` carrying the chaotic topology, in which the maximal sieve is
the only covering sieve. -/
@[stacks 0H09]
abbrev associatedAffineChaoticTopology : GrothendieckTopology (AffineCategory B S hS p) :=
  GrothendieckTopology.trivial _

/-- **Stacks 0H09.** Sheaves on the associated affine site are the same as presheaves on the
affine subcategory: the forgetful functor from sheaves to presheaves is an equivalence. -/
@[stacks 0H09 "sheaves are presheaves"]
def sheafAssociatedAffineChaoticEquivalence (A : Type*) [Category A] :
    Sheaf (associatedAffineChaoticTopology B S hS p) A ≌ (AffineCategory B S hS p)ᵒᵖ ⥤ A :=
  sheafBotEquivalence A

end AlgebraicGeometry.Stack

end
