module

public import StacksFrontier.AlgebraicGeometry.Stacks.LocalEssentialSurjectivity
public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.BaseSites

/-!
# Fppf-local lifts along a surjective, flat, locally finitely presented 1-morphism

Let `f : 𝒳 ⟶ 𝒴` be a 1-morphism of categories fibred in groupoids over the big fppf site of a
scheme `S`, representable by algebraic spaces, and suppose every algebraic space representing the
base change of `f` along a scheme-valued point of `𝒴` has surjective, flat and locally finitely
presented structural morphism. Then every object `y` of `𝒴` admits an object `x` of `𝒳` and a
morphism `a : f(x) ⟶ y` whose singleton generates a covering sieve of the fppf topology `𝒴`
inherits from the site.

## Main results

* `CategoryTheory.Functor.functorPullback_mem_inheritedTopology`: the pullback along the structure
  functor of a covering sieve of the base covers in the inherited topology.
* `CategoryTheory.Functor.generate_singleton_mem_inheritedTopology`: a morphism of the total
  category which is strongly cartesian and through which every arrow of a covering sieve of the
  base factors has a covering singleton.
* `CategoryTheory.Functor.generate_singleton_mem_inheritedTopology_of_isHomLift`: the same with the
  factorisation tested against a morphism of the base the given morphism lies over.
* `AlgebraicGeometry.Stack.exists_fppfLocalLift`: every object of `𝒴` is covered, fppf locally,
  by the image of an object of `𝒳`.

## References

* [Stacks Project, Tag 03YK](https://stacks.math.columbia.edu/tag/03YK)
* [Stacks Project, Tag 06NV](https://stacks.math.columbia.edu/tag/06NV)
* [Stacks Project, Tag 06TP](https://stacks.math.columbia.edu/tag/06TP)
* [Stacks Project, Tag 06XH](https://stacks.math.columbia.edu/tag/06XH)
-/

@[expose] public section

open CategoryTheory Opposite

namespace CategoryTheory.Functor

universe v₁ u₁ v₂ u₂

variable {𝒮 : Type u₁} {𝒞 : Type u₂} [Category.{v₁} 𝒮] [Category.{v₂} 𝒞]

/-- **A covering sieve of the base pulls back to a covering sieve of the inherited topology.**
For a fibred category `p : 𝒮 ⥤ 𝒞` over a site `(𝒞, J)` and an object `a` of `𝒮`, the pullback
along `p` of a covering sieve of `p a` covers `a` in the topology `𝒮` inherits from `𝒞`. -/
theorem functorPullback_mem_inheritedTopology (p : 𝒮 ⥤ 𝒞) [p.IsFibered]
    (J : GrothendieckTopology 𝒞) (a : 𝒮) {R : Sieve (p.obj a)} (hR : R ∈ J (p.obj a)) :
    R.functorPullback p ∈ p.inheritedTopology J a := by
  let I : Type (max u₁ v₁) :=
    Σ c : 𝒮, {h : c ⟶ a // p.IsStronglyCartesian (p.map h) h ∧ R.arrows (p.map h)}
  let Y' : I → 𝒮 := fun i => i.1
  let g : ∀ i, Y' i ⟶ a := fun i => i.2.1
  have hgc : ∀ i, p.IsStronglyCartesian (p.map (g i)) (g i) := fun i => i.2.2.1
  have himg : Sieve.ofArrows (fun i => p.obj (Y' i)) (fun i => p.map (g i)) = R := by
    apply le_antisymm
    · exact (Sieve.generate_le_iff _ _).2 fun _ _ ⟨i⟩ => i.2.2.2
    · intro V u hu
      obtain ⟨c, h, hc⟩ := CategoryTheory.Functor.IsPreFibered.exists_isCartesian' u
      have : p.IsCartesian u h := hc
      have : p.IsStronglyCartesian u h := inferInstance
      obtain rfl : p.obj c = V := IsHomLift.domain_eq p u h
      obtain rfl : u = p.map h := IsHomLift.eq_of_isHomLift p u h
      exact Sieve.ofArrows_mk _ _ (⟨c, h, inferInstance, hu⟩ : I)
  have hmem : Presieve.ofArrows Y' g ∈ p.inheritedPrecoverage J.toPrecoverage a := by
    refine ⟨fun _ _ ⟨i⟩ => hgc i, ?_⟩
    rw [GrothendieckTopology.mem_toPrecoverage_iff, Presieve.map_ofArrows]
    show Sieve.ofArrows (fun i => p.obj (Y' i)) (fun i => p.map (g i)) ∈ J _
    exact himg ▸ hR
  rw [Functor.inheritedTopology_eq]
  exact (p.inheritedTopology J).superset_covering
    ((Sieve.generate_le_iff _ _).2 fun _ _ ⟨i⟩ => i.2.2.2)
    (Precoverage.generate_mem_toGrothendieck hmem)

/-- **A strongly cartesian morphism through which a covering sieve factors has a covering
singleton.** Let `a : x ⟶ y` be a morphism of the total category of a fibred category
`p : 𝒮 ⥤ 𝒞` which is strongly cartesian over its own image, and let `R` be a covering sieve of
`p y` each of whose arrows factors through `p a`. Then the sieve generated by `a` alone covers `y`
in the inherited topology. -/
theorem generate_singleton_mem_inheritedTopology (p : 𝒮 ⥤ 𝒞) [p.IsFibered]
    (J : GrothendieckTopology 𝒞) {x y : 𝒮} (a : x ⟶ y)
    (hcart : p.IsStronglyCartesian (p.map a) a)
    {R : Sieve (p.obj y)} (hR : R ∈ J (p.obj y))
    (hfac : ∀ ⦃W : 𝒞⦄ (u : W ⟶ p.obj y), R.arrows u → ∃ v : W ⟶ p.obj x, v ≫ p.map a = u) :
    Sieve.generate (Presieve.singleton a) ∈ p.inheritedTopology J y := by
  refine (p.inheritedTopology J).superset_covering ?_
    (p.functorPullback_mem_inheritedTopology J y hR)
  intro Z b hb
  change R.arrows (p.map b) at hb
  obtain ⟨v, hv⟩ := hfac (p.map b) hb
  obtain ⟨c, ⟨_, hca⟩, _⟩ :=
    CategoryTheory.Functor.IsStronglyCartesian.universal_property p (p.map a) a v (p.map b)
      hv.symm b
  exact ⟨_, c, a, Presieve.singleton_self a, hca⟩

/-- **A strongly cartesian lift of a morphism through which a covering sieve factors has a
covering singleton.** Let `a : x ⟶ y` be a strongly cartesian morphism of the total category of
a fibred category `p : 𝒮 ⥤ 𝒞` lying over `m : V ⟶ U`, and let `R` be a covering sieve of `U` each
of whose arrows factors through `m`. Then the sieve generated by `a` alone covers `y` in the
inherited topology. -/
theorem generate_singleton_mem_inheritedTopology_of_isHomLift (p : 𝒮 ⥤ 𝒞) [p.IsFibered]
    (J : GrothendieckTopology 𝒞) {x y : 𝒮} (a : x ⟶ y)
    (hcart : p.IsStronglyCartesian (p.map a) a)
    {U V : 𝒞} (m : V ⟶ U) (hlift : p.IsHomLift m a)
    {R : Sieve U} (hR : R ∈ J U)
    (hfac : ∀ ⦃W : 𝒞⦄ (u : W ⟶ U), R.arrows u → ∃ v : W ⟶ V, v ≫ m = u) :
    Sieve.generate (Presieve.singleton a) ∈ p.inheritedTopology J y := by
  obtain rfl : p.obj x = V := IsHomLift.domain_eq p m a
  obtain rfl : p.obj y = U := IsHomLift.codomain_eq p m a
  obtain rfl : m = p.map a := IsHomLift.eq_of_isHomLift p m a
  exact p.generate_singleton_mem_inheritedTopology J a hcart hR hfac

end CategoryTheory.Functor

namespace AlgebraicGeometry.Stack

universe u v w

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- Let `f : 𝒳 ⟶ 𝒴` be a 1-morphism of categories fibred in groupoids over the big fppf site of
`S` which is representable by algebraic spaces, and suppose that every algebraic space
representing the base change of `f` along a scheme-valued point of `𝒴` has surjective, flat and
locally finitely presented structural morphism. Then every object `y` of `𝒴` admits an object `x`
of `𝒳` and a morphism `a : f(x) ⟶ y` whose singleton generates a covering sieve of the fppf
topology `𝒴` inherits from the site. -/
@[stacks 06XH "fppf_local_lifts"]
theorem exists_fppfLocalLift
    {𝒳 𝒴 : CatFiberedInGroupoids.{u, v, u + 1, w} (BigFppfOver B S hS)} (f : 𝒳 ⟶ 𝒴)
    (hf : IsRepresentableByAlgebraicSpaces B S hS f.hom)
    (hprops : ∀ (T : BigFppfOver B S hS)
      (y : BigFppfOver B T.left.1 T.left.2 ⥤ 𝒴.val.obj)
      (_hy : y ⋙ 𝒴.val.p = Over.map T.hom)
      (F : (BigFppfOver B T.left.1 T.left.2)ᵒᵖ ⥤ Type u)
      (hF : IsAlgebraicSpace B T.left.1 T.left.2 F),
      Nonempty (StacksRepresentableCFG.EquivalenceOver
        (TwoFibreProductOver.fst (Over.map T.hom) 𝒳.val.p 𝒴.val.p y
          (CatFiberedInGroupoids.homFunctor f))
        (presheafOfCategories (F ⋙ typeToCat)).p) →
      (let g := (algebraicSpaceMap B S hS T
        ((spacesOverSmallerBaseFunctor B T.left.1 S T.left.2 hS T.hom).obj ⟨F, hF⟩)).hom
       Space.IsSurjective B S hS g ∧ Space.IsFlat B S hS g ∧
         Space.IsLocallyOfFinitePresentation B S hS g))
    (y : 𝒴.val.obj) :
    ∃ (x : 𝒳.val.obj) (a : (CatFiberedInGroupoids.homFunctor f).obj x ⟶ y),
      Sieve.generate (Presieve.singleton a) ∈
        BigFppfOver.associatedTopology B S hS 𝒴.val.p .fppf y := by
  obtain ⟨T, m, hflat, hlfp, hsurj, z, φ, hφ⟩ :=
    exists_scheme_lift_of_isSurjective_isFlat_isLocallyOfFinitePresentation B S hS f hf hprops
      (𝒴.val.p.obj y) (Functor.Fiber.mk rfl)
  have : 𝒴.val.p.IsFibered := 𝒴.isFiberedInGroupoids.isFibered
  refine ⟨z, φ, ?_⟩
  refine Functor.generate_singleton_mem_inheritedTopology_of_isHomLift 𝒴.val.p
    (BigFppfOver.baseOverTopology B S hS .fppf) φ
    (𝒴.isFiberedInGroupoids.isStronglyCartesian φ) _ hφ
    (mem_topology_of_family B S hS (I := PUnit.{u + 2}) (fun _ => T) (fun _ => m)
      (fun _ => hflat) (fun _ => hlfp) (fun x => ⟨PUnit.unit, hsurj.1 x⟩)) ?_
  rintro W u ⟨W', k, -, ⟨i⟩, rfl⟩
  exact ⟨k, rfl⟩

end AlgebraicGeometry.Stack

end
