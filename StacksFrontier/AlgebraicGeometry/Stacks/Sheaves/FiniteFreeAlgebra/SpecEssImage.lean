module

public import StacksFrontier.AlgebraicGeometry.Descent.SectionsPullbackComparison.Comparison
public import StacksFrontier.AlgebraicGeometry.Stacks.Sheaves.FiniteFreeAlgebra.AffineTrivialization
public import StacksFrontier.AlgebraicGeometry.Stacks.Sheaves.FiniteFreeAlgebra.SpecFiniteCover
public import StacksFrontier.CategoryTheory.Sites.Descent.IsStack.FiberIso
public import StacksFrontier.CategoryTheory.Sites.Stack.TwoFibreProductMorPresheafMap

/-!
# Clause (2) of Stacks 02ZN for the 1-morphism `Spec`

Let `S` be a scheme of a big fppf site and let `d` be a positive natural number. Every degree-`d`
finite locally free cover of an object of the big fppf site over `S` is, locally on that object,
the cover attached to a free `d`-dimensional algebra structure on its global sections: the base is
covered by affine opens over each of which the cover becomes the spectrum of the algebra of such
a structure, and the restriction of the cover along any arrow of the resulting covering sieve is
isomorphic, in the fibre, to the image under `Spec` of an object of the pointwise groupoid
fibration of free rank-`d` structures.

This is clause (2) of Stacks 02ZN for the 1-morphism `Spec` of Stacks 05YQ, that is, clause (b)
of the proof of 05YQ; it is one of the two hypotheses that
`AlgebraicGeometry.Stack.nonempty_isEquivalenceOver_extend_toQuotientStack` consumes.

## Main results

* `AlgebraicGeometry.FiniteFreeAlgebra.exists_openSubObj_specCoverHom`: a degree-`d` finite
  locally free cover is, over an affine open neighbourhood of any point of its base, in the image
  of `Spec` — in the form of a morphism of `ℋ_d` lying over the open immersion.
* `AlgebraicGeometry.FiniteFreeAlgebra.essImage_pullbackFiber_of_factors_openSubObj`: the chosen
  restriction of a cover along any arrow factoring through an open over which the cover is
  trivialised lies in the essential image of `Spec`.
* `AlgebraicGeometry.FiniteFreeAlgebra.exists_opens_essImage_specFiniteCover`: **clause (b) of the
  proof of Stacks 05YQ with its covering exhibited**, as a family of opens of the base, one
  through each point.
* `AlgebraicGeometry.FiniteFreeAlgebra.essImage_specFiniteCover`: **clause (2) of Stacks 02ZN for
  `Spec`.** Every object of a fibre of `ℋ_d` lies, along a covering sieve, in the essential image
  of `Spec` on fibres.

## Implementation notes

The geometric content is
`AlgebraicGeometry.FiniteFreeAlgebra.exists_isAffineOpen_isPullback_cover`, which produces the
affine open and the trivialising cartesian square of schemes;
`AlgebraicGeometry.FiniteFreeAlgebra.exists_openSubObj_specCoverHom` only carries that square
into the site, through `AlgebraicGeometry.BigFppfOver.openSubObj` and
`AlgebraicGeometry.FiniteFreeAlgebra.isPullback_of_isPullback_toScheme`.

The covering sieve is the one generated by the chosen affine opens, one for each point of the
base, and it covers by
`AlgebraicGeometry.BigFppfOver.sieve₀_mem_baseTopology_of_isOpenImmersion`: its members are open
immersions and they are jointly surjective because each contains its own point. The step is the
one that
`AlgebraicGeometry.BigFppfOver.mem_baseTopology_sieve₀_affineSubordinateCover` takes for the
family of all affine opens.

An arrow of that sieve factors through one of the chosen opens, and the composite of the morphism
of `ℋ_d` attached to that factor — the extension of scalars of the structure along it — with the
trivialisation is a morphism of `ℋ_d` over the arrow. Since `ℋ_d` is fibred in groupoids, every
such morphism is cartesian, so it is identified with the chosen pullback by
`CategoryTheory.Functor.fiberIsoOfCartesian`, which is the isomorphism the essential-image
statement asks for.

## References

* [Stacks Project, Tag 02ZN](https://stacks.math.columbia.edu/tag/02ZN)
* [Stacks Project, Tag 05YQ](https://stacks.math.columbia.edu/tag/05YQ)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits CommRingCat

universe u

namespace AlgebraicGeometry.FiniteFreeAlgebra

attribute [local instance] FiniteFreeAlgebra.groupoid

variable {𝒞 : BigFppfSite.{u}} {S : Scheme.{u}} {hS : 𝒞.Contains S} {d : ℕ} [NeZero d]

/-- The category `ℋ_d` of degree-`d` finite locally free covers is fibred over the big fppf site
over `S`, being fibred in groupoids over it. -/
instance isFibered_finiteCoverProjection :
    (AlgebraicGeometry.Stack.finiteCoverProjection
      (B := 𝒞) (S := S) (hS := hS) (d := d)).IsFibered :=
  (AlgebraicGeometry.Stack.isFiberedInGroupoids_finiteCoverProjection
    (B := 𝒞) (S := S) (hS := hS) (d := d)).isFibered

/-! ### Trivialising a cover over an affine open of its base -/

/-- **A degree-`d` finite locally free cover is, over an affine open neighbourhood of any point
of its base, in the image of `Spec`.** The neighbourhood is read as an object of the big fppf
site over `S` and the identification as a morphism of `ℋ_d` whose base component is the open
immersion of that neighbourhood. -/
theorem exists_openSubObj_specCoverHom (P : AlgebraicGeometry.Stack.FiniteCover 𝒞 S hS d)
    (u : P.U.left.obj) :
    ∃ (V : P.U.left.obj.Opens) (_ : u ∈ V)
      (m : FiniteFreeAlgebra ↑Γ(V.toScheme, ⊤) d)
      (φ : specCoverObject (BigFppfOver.openSubObj 𝒞 S hS P.U V) m ⟶ P),
      φ.f = BigFppfOver.openSubHom 𝒞 S hS P.U V := by
  have : Stacks.Morphisms.IsFiniteLocallyFreeOfRank
      ((BigFppfOver.toScheme 𝒞 S hS).map P.q) d := P.finiteLocallyFree
  obtain ⟨V, -, huV, m, ψ, hψ⟩ :=
    exists_isAffineOpen_isPullback_cover (d := d) ((BigFppfOver.toScheme 𝒞 S hS).map P.q) u
  have hq : (BigFppfOver.toScheme 𝒞 S hS).map P.q ≫ P.U.hom.hom = P.Z.hom.hom := by
    have h := congrArg 𝒞.inclusion.map (Over.w P.q)
    rwa [Functor.map_comp] at h
  refine ⟨V, huV, m,
    { f := BigFppfOver.openSubHom 𝒞 S hS P.U V
      g := Over.homMk (ObjectProperty.homMk ψ) (by
        refine 𝒞.inclusion.map_injective ?_
        rw [Functor.map_comp]
        change ψ ≫ P.Z.hom.hom =
          (cover V.toScheme m).hom ≫ (V.ι ≫ P.U.hom.hom)
        rw [← hq, ← Category.assoc, hψ.w, Category.assoc])
      square := isPullback_of_isPullback_toScheme hψ }, rfl⟩

/-- **A family of opens of an object of the big fppf site over `S`, one through each point of
its underlying scheme, generates a covering sieve.** Its members are open immersions and they are
jointly surjective, so
`AlgebraicGeometry.BigFppfOver.sieve₀_mem_baseTopology_of_isOpenImmersion` applies. -/
theorem mem_topology_sieve₀_openSubObj (T : BigFppfOver 𝒞 S hS)
    (V : ↥T.left.obj → T.left.obj.Opens) (hmem : ∀ y, y ∈ V y) :
    (⟨ULift.{u + 1} ↥T.left.obj, fun i => BigFppfOver.openSubObj 𝒞 S hS T (V i.down),
        fun i => BigFppfOver.openSubHom 𝒞 S hS T (V i.down)⟩ :
      PreZeroHypercover.{u + 1} T).sieve₀ ∈ BigFppfOver.topology 𝒞 S hS T := by
  set C : PreZeroHypercover.{u + 1} T := ⟨ULift.{u + 1} ↥T.left.obj,
    fun i => BigFppfOver.openSubObj 𝒞 S hS T (V i.down),
    fun i => BigFppfOver.openSubHom 𝒞 S hS T (V i.down)⟩
  rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
  exact BigFppfOver.sieve₀_mem_baseTopology_of_isOpenImmersion 𝒞 .fppf
    (C.map (Over.forget (𝒞.obj hS)))
    (fun y => ⟨⟨y⟩, ⟨⟨y, hmem y⟩, rfl⟩⟩)
    (fun i => inferInstanceAs (IsOpenImmersion (V i.down).ι))

/-! ### Clause (2) of Stacks 02ZN -/

/-- **A cover trivialised over an open of its base lies in the essential image of `Spec` over
every object mapping into that open.** Given the trivialisation `φ` of
`AlgebraicGeometry.FiniteFreeAlgebra.exists_openSubObj_specCoverHom` over an open `V'` of the base
of `P` and a factorisation of `f : W ⟶ P.U` through the open immersion of `V'`, the chosen
restriction of `P` along `f` is isomorphic in the fibre over `W` to the image under `Spec` of the
free structure obtained from `m` by extension of scalars along `h`.

This is the content of clause (2) of Stacks 02ZN for `Spec`, separated from the choice of
covering: the arrow `f` is arbitrary. The morphism of `ℋ_d` exhibiting the isomorphism is the
extension of scalars along `h` followed by `φ`; since `ℋ_d` is fibred in groupoids that morphism
is strongly cartesian over `f`, so `CategoryTheory.Functor.fiberIsoOfCartesian` identifies its
source with the chosen restriction. -/
theorem essImage_pullbackFiber_of_factors_openSubObj
    (P : AlgebraicGeometry.Stack.FiniteCover 𝒞 S hS d)
    {V' : P.U.left.obj.Opens} {m : FiniteFreeAlgebra ↑Γ(V'.toScheme, ⊤) d}
    (φ : specCoverObject (BigFppfOver.openSubObj 𝒞 S hS P.U V') m ⟶ P)
    (hφ : φ.f = BigFppfOver.openSubHom 𝒞 S hS P.U V')
    {W : BigFppfOver 𝒞 S hS}
    {f : W ⟶ (AlgebraicGeometry.Stack.finiteCoverProjection
      (B := 𝒞) (S := S) (hS := hS) (d := d)).obj P}
    {h : W ⟶ BigFppfOver.openSubObj 𝒞 S hS P.U V'}
    (hfac : h ≫ BigFppfOver.openSubHom 𝒞 S hS P.U V' = f) :
    (Functor.fiberFunctorOfCompEq
        (isFibredOneMorphism_specFiniteCover 𝒞 S hS d).comp_eq W).essImage
      (Functor.pullbackFiber (AlgebraicGeometry.Stack.finiteCoverProjection
        (B := 𝒞) (S := S) (hS := hS) (d := d)) ⟨P, rfl⟩ f) := by
  set n := m.map ((BigFppfOver.toScheme 𝒞 S hS).map h).appTop.hom with hn
  refine ⟨⟨⟨W, n⟩, rfl⟩, ⟨?_⟩⟩
  set Ψ := specCoverHom h (StructureIso.refl n) ≫ φ with hΨ
  have hΦ : (AlgebraicGeometry.Stack.finiteCoverProjection
      (B := 𝒞) (S := S) (hS := hS) (d := d)).map Ψ = f := by
    rw [hΨ]
    change h ≫ φ.f = f
    rw [hφ]
    exact hfac
  have hlift : (AlgebraicGeometry.Stack.finiteCoverProjection
      (B := 𝒞) (S := S) (hS := hS) (d := d)).IsHomLift f Ψ := hΦ ▸ IsHomLift.map _ _
  have hcart := (AlgebraicGeometry.Stack.isFiberedInGroupoids_finiteCoverProjection
    (B := 𝒞) (S := S) (hS := hS) (d := d)).isStronglyCartesian_homLift f Ψ
  exact (Functor.fiberIsoOfCartesian f
    (Functor.IsPreFibered.pullbackMap (a := P) rfl f) Ψ inferInstance
    (Functor.IsStronglyCartesian.isCartesian_of_isStronglyCartesian _ f Ψ)).symm

/-- **Clause (b) of the proof of Stacks 05YQ with its covering exhibited: the covering is by
opens of the base.** For every degree-`d` finite locally free cover `x` of an object `U` of the
big fppf site over `S` there is an open neighbourhood of each point of `U` over which the chosen
restriction of `x` lies in the essential image of the functor induced by `Spec` on the fibres.

This is the statement `AlgebraicGeometry.FiniteFreeAlgebra.essImage_specFiniteCover` records as
membership of a covering sieve, with the geometry of the covering kept: an object of `ℋ_d` is in
the essential image of `Spec` *Zariski*-locally on its base, because a basis of a finite locally
free algebra whose first vector is the unit exists over a standard open cover. That is what the
fppf sieve of the other statement forgets, and what the étale descent of algebraicity needs. The
opens are returned as a family indexed by the points of the base, so that two covers of one base
can be trivialised over a common family by intersecting. -/
theorem exists_opens_essImage_specFiniteCover (U : BigFppfOver 𝒞 S hS)
    (x : (AlgebraicGeometry.Stack.finiteCoverProjection
      (B := 𝒞) (S := S) (hS := hS) (d := d)).Fiber U) :
    ∃ O : ↥U.left.obj → U.left.obj.Opens, (∀ t, t ∈ O t) ∧
      ∀ t, (Functor.fiberFunctorOfCompEq
          (isFibredOneMorphism_specFiniteCover 𝒞 S hS d).comp_eq
          (BigFppfOver.openSubObj 𝒞 S hS U (O t))).essImage
        (Functor.pullbackFiber (AlgebraicGeometry.Stack.finiteCoverProjection
          (B := 𝒞) (S := S) (hS := hS) (d := d)) x
          (BigFppfOver.openSubHom 𝒞 S hS U (O t))) := by
  obtain ⟨P, rfl⟩ := x
  choose V hmem m φ hφ using exists_openSubObj_specCoverHom P
  exact ⟨V, hmem, fun t => essImage_pullbackFiber_of_factors_openSubObj P (φ t) (hφ t)
    (h := 𝟙 _) (Category.id_comp _)⟩

/-- **Clause (2) of Stacks 02ZN for the 1-morphism `Spec` of Stacks 05YQ**, that is, clause (b)
of the proof of 05YQ. For every object `U` of the big fppf site over `S` and every degree-`d`
finite locally free cover `x` of `U` there is a covering sieve of `U` such that along each of its
arrows `f : V ⟶ U` the chosen restriction of `x` lies in the essential image of the functor
induced by `Spec` on the fibres over `V`.

The sieve is generated by the affine opens of `U` over which the cover is trivialised by
`AlgebraicGeometry.FiniteFreeAlgebra.exists_openSubObj_specCoverHom`. -/
theorem essImage_specFiniteCover (U : BigFppfOver 𝒞 S hS)
    (x : (AlgebraicGeometry.Stack.finiteCoverProjection
      (B := 𝒞) (S := S) (hS := hS) (d := d)).Fiber U) :
    ∃ R ∈ BigFppfOver.topology 𝒞 S hS U,
      ∀ ⦃V : BigFppfOver 𝒞 S hS⦄ ⦃f : V ⟶ U⦄, R.arrows f →
        (Functor.fiberFunctorOfCompEq
            (isFibredOneMorphism_specFiniteCover 𝒞 S hS d).comp_eq V).essImage
          (Functor.pullbackFiber (AlgebraicGeometry.Stack.finiteCoverProjection
            (B := 𝒞) (S := S) (hS := hS) (d := d)) x f) := by
  obtain ⟨P, rfl⟩ := x
  choose V hmem m φ hφ using exists_openSubObj_specCoverHom P
  refine ⟨_, mem_topology_sieve₀_openSubObj P.U V hmem, ?_⟩
  · rintro W f ⟨-, h, -, ⟨i⟩, hfac⟩
    exact essImage_pullbackFiber_of_factors_openSubObj P (φ i.down) (hφ i.down) hfac

end AlgebraicGeometry.FiniteFreeAlgebra

end
