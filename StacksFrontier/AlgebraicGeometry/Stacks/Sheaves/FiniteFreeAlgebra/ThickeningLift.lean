module

public import Mathlib.LinearAlgebra.TensorProduct.Quotient
public import StacksFrontier.AlgebraicGeometry.Different.FiniteSyntomicMorphisms.UniversalTable
public import StacksFrontier.AlgebraicGeometry.FiniteLocallyFreeRank.AffineTarget
public import StacksFrontier.AlgebraicGeometry.InvertibleRankOneModule.Basic
public import StacksFrontier.AlgebraicGeometry.Stacks.Sheaves.FiniteFreeAlgebra.StructureLift
public import StacksFrontier.AlgebraicGeometry.Thickenings

/-!
# Lifting a degree-`d` cover of structure constants along a first-order thickening

Let `ι : T ⟶ T'` be a first-order thickening of affine schemes, let `p' : Z' ⟶ T'` be finite
locally free of degree `d`, and let `Zx ⟶ T` be the base change of `p'` along `ι`. If the global
sections of `Zx` are the algebra of a free `d`-dimensional structure `m` over the global sections
of `T`, then the global sections of `Z'` are the algebra of a free `d`-dimensional structure `m'`
over the global sections of `T'` extending to `m`, compatibly with the base change.

## Main results

* `AlgebraicGeometry.FiniteFreeAlgebra.ker_appTop_eq_map_ker_of_isPullback`: for a closed
  immersion `ι` of affine schemes, the kernel of the map of global sections of the base change of
  `ι` along an affine morphism is generated by the kernel of `ι` on global sections.
* `AlgebraicGeometry.FiniteFreeAlgebra.exists_structure_lift_of_thickening`: the extension of
  the structure constants along a first-order thickening.

## References

* [Stacks Project, Tag 04EX](https://stacks.math.columbia.edu/tag/04EX)
* [Stacks Project, Tag 051F](https://stacks.math.columbia.edu/tag/051F)
* [Stacks Project, Tag 05YM](https://stacks.math.columbia.edu/tag/05YM)
* [Stacks Project, Tag 05YQ](https://stacks.math.columbia.edu/tag/05YQ)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

open scoped TensorProduct

universe u

namespace AlgebraicGeometry.FiniteFreeAlgebra

/-- For a pullback square, the induced maps on global sections commute. -/
private theorem appTop_comp_apply_of_isPullback {T T' Z' Zx : Scheme.{u}}
    {ι : T ⟶ T'} {p' : Z' ⟶ T'} {px : Zx ⟶ T} {α : Zx ⟶ Z'}
    (hα : IsPullback α px p' ι) (c : Γ(T', ⊤)) :
    α.appTop.hom (p'.appTop.hom c) = px.appTop.hom (ι.appTop.hom c) := by
  simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] using
    congr((Scheme.Hom.appTop $(hα.w)).hom c)

/-- If `ι : T ⟶ T'` is a closed immersion of affine schemes with kernel `I` on global sections and
`Zx` is the base change of an affine `Z' ⟶ T'` along `ι`, then the kernel of `Γ(Z') → Γ(Zx)` is the
ideal generated by `I`. -/
theorem ker_appTop_eq_map_ker_of_isPullback {T T' Z' Zx : Scheme.{u}}
    [IsAffine T] [IsAffine T'] [IsAffine Z'] [IsAffine Zx]
    {ι : T ⟶ T'} {p' : Z' ⟶ T'} {px : Zx ⟶ T} {α : Zx ⟶ Z'}
    (hα : IsPullback α px p' ι)
    (hsurj : Function.Surjective ι.appTop.hom) :
    letI : Algebra Γ(T', ⊤) Γ(T, ⊤) := ι.appTop.hom.toAlgebra
    letI : Algebra Γ(T', ⊤) Γ(Z', ⊤) := p'.appTop.hom.toAlgebra
    RingHom.ker α.appTop.hom =
      Ideal.map (algebraMap Γ(T', ⊤) Γ(Z', ⊤)) (RingHom.ker ι.appTop.hom) := by
  classical
  let : Algebra Γ(T', ⊤) Γ(T, ⊤) := ι.appTop.hom.toAlgebra
  let : Algebra Γ(T', ⊤) Γ(Z', ⊤) := p'.appTop.hom.toAlgebra
  refine le_antisymm ?_ ?_
  · intro z hz
    have hz0 : α.appTop.hom z = 0 := hz
    let e : Zx ≅ pullback ι p' :=
      (hα.flip).isoIsPullback _ _ (IsPullback.of_hasPullback ι p')
    have hesnd : e.hom ≫ pullback.snd ι p' = α :=
      IsPullback.isoIsPullback_hom_snd _ _ (hα.flip) (IsPullback.of_hasPullback ι p')
    have hfac : α.appTop.hom z = e.hom.appTop.hom ((pullback.snd ι p').appTop.hom z) := by
      rw [← hesnd, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    have hinj : Function.Injective e.hom.appTop.hom := by
      have : IsIso e.hom := Iso.isIso_hom e
      have : IsIso (Scheme.Hom.appTop e.hom) := by
        change IsIso (Scheme.Γ.map e.hom.op)
        infer_instance
      exact (ConcreteCategory.bijective_of_isIso (Scheme.Hom.appTop e.hom)).1
    have hsndz : (pullback.snd ι p').appTop.hom z = 0 := by
      refine hinj ?_
      rw [← hfac, hz0, map_zero]
    have htensor : (1 : Γ(T, ⊤)) ⊗ₜ[Γ(T', ⊤)] z = 0 := by
      have hψ : affinePullbackΓTensorEquiv ι p' ((pullback.snd ι p').appTop.hom z) =
          (1 : Γ(T, ⊤)) ⊗ₜ[Γ(T', ⊤)] z :=
        affinePullbackΓTensorEquiv_snd ι p' z
      rw [← hψ, hsndz, map_zero]
    let eR : (Γ(T', ⊤) ⧸ RingHom.ker ι.appTop.hom) ≃+* Γ(T, ⊤) :=
      RingHom.quotientKerEquivOfSurjective (f := ι.appTop.hom) hsurj
    have heRmk : ∀ r : Γ(T', ⊤),
        eR (Ideal.Quotient.mk (RingHom.ker ι.appTop.hom) r) = ι.appTop.hom r := fun r =>
      RingHom.quotientKerEquivOfSurjective_apply_mk (f := ι.appTop.hom) hsurj r
    let χ : Γ(T, ⊤) →ₗ[Γ(T', ⊤)] (Γ(T', ⊤) ⧸ RingHom.ker ι.appTop.hom) :=
      { toFun := eR.symm
        map_add' := eR.symm.map_add
        map_smul' := by
          intro r x
          have hr : eR.symm (ι.appTop.hom r) =
              Ideal.Quotient.mk (RingHom.ker ι.appTop.hom) r := by
            rw [← heRmk r, eR.symm_apply_apply]
          change eR.symm (r • x) = r • eR.symm x
          rw [Algebra.smul_def, Algebra.smul_def, map_mul]
          exact congrArg (fun w => w * eR.symm x) hr }
    have hmem : z ∈ RingHom.ker ι.appTop.hom • (⊤ : Submodule Γ(T', ⊤) Γ(Z', ⊤)) := by
      have hΛ : (TensorProduct.quotTensorEquivQuotSMul Γ(Z', ⊤)
            (RingHom.ker ι.appTop.hom)) (χ.rTensor Γ(Z', ⊤)
            ((1 : Γ(T, ⊤)) ⊗ₜ[Γ(T', ⊤)] z)) = Submodule.Quotient.mk z := by
        have h1 : χ (1 : Γ(T, ⊤)) = 1 := by
          change eR.symm (1 : Γ(T, ⊤)) = 1
          rw [← map_one eR, eR.symm_apply_apply]
        rw [LinearMap.rTensor_tmul, h1]
        exact TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul _ z
      have hzero : Submodule.Quotient.mk
          (p := RingHom.ker ι.appTop.hom • (⊤ : Submodule Γ(T', ⊤) Γ(Z', ⊤))) z = 0 := by
        rw [← hΛ, htensor, map_zero, map_zero]
      exact (Submodule.Quotient.mk_eq_zero _).mp hzero
    simpa only [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem] using hmem
  · rw [Ideal.map_le_iff_le_comap]
    intro c hc
    have hc0 : ι.appTop.hom c = 0 := hc
    change α.appTop.hom (p'.appTop.hom c) = 0
    rw [appTop_comp_apply_of_isPullback hα c, hc0, map_zero]

/-- Let `ι : T ⟶ T'` be a first-order thickening with `T'` affine, let `p' : Z' ⟶ T'` be finite
locally free of degree `d`, and let `Zx ⟶ T` be the base change of `p'` along `ι`. If the global
sections of `Zx` are the algebra of a free `d`-dimensional structure `m` over `Γ(T, 𝒪_T)`, then the
global sections of `Z'` are the algebra of a free `d`-dimensional structure `m'` over
`Γ(T', 𝒪_{T'})` whose extension of scalars along `ι` is `m`, compatibly with the base change. -/
theorem exists_structure_lift_of_thickening (d : ℕ) [NeZero d]
    {T T' Z' Zx : Scheme.{u}} [IsAffine T'] {ι : T ⟶ T'} {p' : Z' ⟶ T'}
    (hι : Stacks.Thickenings.IsFirstOrderThickening ι)
    (hp' : Stacks.Morphisms.IsFiniteLocallyFreeOfRank p' d)
    {px : Zx ⟶ T} {α : Zx ⟶ Z'} (hα : IsPullback α px p' ι)
    (m : FiniteFreeAlgebra Γ(T, ⊤) d)
    (eA : letI : Algebra Γ(T, ⊤) Γ(Zx, ⊤) := px.appTop.hom.toAlgebra
      Γ(Zx, ⊤) ≃ₐ[Γ(T, ⊤)] Carrier m) :
    letI : Algebra Γ(T', ⊤) Γ(T, ⊤) := ι.appTop.hom.toAlgebra
    letI : Algebra Γ(T', ⊤) Γ(Z', ⊤) := p'.appTop.hom.toAlgebra
    letI : Algebra Γ(T, ⊤) Γ(Zx, ⊤) := px.appTop.hom.toAlgebra
    ∃ (m' : FiniteFreeAlgebra Γ(T', ⊤) d) (eA' : Γ(Z', ⊤) ≃ₐ[Γ(T', ⊤)] Carrier m'),
      map ι.appTop.hom m' = m ∧
        ∀ (z : Γ(Z', ⊤)) (k : Fin d),
          ι.appTop.hom (eA' z k) = eA (α.appTop.hom z) k := by
  classical
  let : Algebra Γ(T', ⊤) Γ(T, ⊤) := ι.appTop.hom.toAlgebra
  let : Algebra Γ(T', ⊤) Γ(Z', ⊤) := p'.appTop.hom.toAlgebra
  let : Algebra Γ(T, ⊤) Γ(Zx, ⊤) := px.appTop.hom.toAlgebra
  have : IsClosedImmersion ι := hι.1
  have : IsAffine T := isAffine_of_isAffineHom ι
  have : IsAffineHom p' := hp'.toIsAffineHom
  have : IsAffine Z' := isAffine_of_isAffineHom p'
  have : IsAffineHom px :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @IsAffineHom) hα
      hp'.toIsAffineHom
  have : IsAffine Zx := isAffine_of_isAffineHom px
  have : IsClosedImmersion α :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @IsClosedImmersion)
      hα.flip hι.1
  have hsurj : Function.Surjective ι.appTop.hom :=
    Scheme.Hom.app_surjective ι ⊤ (isAffineOpen_top T')
  have hnil : IsNilpotent (RingHom.ker ι.appTop.hom) := by
    let U₀ : T'.affineOpens := ⟨⊤, isAffineOpen_top T'⟩
    have hker : (Scheme.Hom.ker ι).ideal U₀ = RingHom.ker ι.appTop.hom :=
      Scheme.Hom.ker_apply ι U₀
    refine ⟨2, ?_⟩
    rw [← hker]
    exact congrArg (fun J : T'.IdealSheafData => J.ideal U₀) hι.2
  have hφ : Function.Surjective α.appTop.hom :=
    Scheme.Hom.app_surjective α ⊤ (isAffineOpen_top Z')
  have hker : RingHom.ker α.appTop.hom =
      Ideal.map (algebraMap Γ(T', ⊤) Γ(Z', ⊤))
        (RingHom.ker (algebraMap Γ(T', ⊤) Γ(T, ⊤))) :=
    ker_appTop_eq_map_ker_of_isPullback hα hsurj
  have : Module.Flat Γ(T', ⊤) Γ(Z', ⊤) :=
    Module.flat_of_isFiniteLocallyFreeOfRank
      ((Stacks.Morphisms.isFiniteLocallyFreeOfRank_iff_module_of_isAffine p' d rfl).mp hp')
  exact exists_structure_lift_of_nilpotent_ker hsurj hnil α.appTop.hom hφ hker
    (appTop_comp_apply_of_isPullback hα) m eA

end AlgebraicGeometry.FiniteFreeAlgebra

end
