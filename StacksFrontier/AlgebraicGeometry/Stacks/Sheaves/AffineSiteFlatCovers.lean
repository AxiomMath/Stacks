/-!
# The affine site of a category fibred in groupoids, with its finite flat coverings

Let `p : 𝒳 ⥤ (Sch/S)_{fppf}` be a category fibred in groupoids. Its affine subcategory
`𝒳_{affine}` of Stacks 0H0A lies over the affine schemes over `S` through
`AlgebraicGeometry.Stack.AffineCategory.toAffine`, and so over the category of schemes through
`AlgebraicGeometry.Stack.AffineCategory.toScheme`. This file collects what the descent arguments
on `𝒳_{affine}` need to know about that functor and about the five topologies of Stacks 0H0A.

## Main definitions

* `AlgebraicGeometry.BigAffineFppf.siteKindTopology`: the five big affine topologies of Stacks
  0H0A — Zariski, étale, smooth, syntomic and fppf — on the common category of affine schemes
  over `S`, indexed by `AlgebraicGeometry.SiteKind`.
* `AlgebraicGeometry.Stack.AffineCategory.toScheme`: the underlying affine scheme of an object of
  `𝒳_{affine}`.

## Main results

* `AlgebraicGeometry.Stack.AffineCategory.hasPullbacks` and
  `AlgebraicGeometry.Stack.AffineCategory.preservesPullbacks_toScheme`: `𝒳_{affine}` has fibre
  products and the underlying scheme functor preserves them.
* `Stacks.Sites.exists_finite_flat_covering_refinement`: a covering sieve of a topology
  generated by finite flat coverings contains a finite flat family which is itself covering.
* `AlgebraicGeometry.Stack.AffineCategory.exists_finite_flat_covering`: **every covering sieve
  of each of the five associated affine topologies contains a finite family which is covering,
  and which on the underlying schemes is a flat covering.**

## Implementation notes

The underlying categories of the five big affine sites of `S` are the same category
`AlgebraicGeometry.BigAffineFppf`, so their topologies are five topologies on one category; this
is the form in which Stacks 0H0A and 0H0C are stated in this development.

## References

* [Stacks Project, Tag 0H0A](https://stacks.math.columbia.edu/tag/0H0A)
* [Stacks Project, Tag 06WY](https://stacks.math.columbia.edu/tag/06WY)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v w i

/-- Flatness of morphisms of schemes, named as a `MorphismProperty` so that instance search finds
the stability instances of its precoverage. -/
private abbrev AlgebraicGeometry.flatSchemeMorphisms :
    MorphismProperty AlgebraicGeometry.Scheme.{u} :=
  @AlgebraicGeometry.Flat

namespace Stacks.Sites

/-- **A covering sieve of a topology generated by finite flat coverings contains a finite flat
covering family.** Unlike `Stacks.Sites.exists_finite_flat_refinement`, the family produced is
itself covering, so a sheaf satisfies the sheaf axiom for it. -/
theorem exists_finite_flat_covering_refinement
    {C : Type v} [Category.{w} C] [HasPullbacks C]
    (L : C ⥤ AlgebraicGeometry.Scheme.{u}) [PreservesLimitsOfShape WalkingCospan L]
    (P : Precoverage C)
    (hP : ∀ {U : C} (R : Presieve U), R ∈ P U →
      R.uncurry.Finite ∧ R.map L ∈ AlgebraicGeometry.Scheme.precoverage
        @AlgebraicGeometry.Flat (L.obj U))
    {U : C} (S : Sieve U) (hS : S ∈ P.toGrothendieck U) :
    ∃ E : PreZeroHypercover.{max v w} U, Finite E.I₀ ∧
      (E.map L).presieve₀ ∈ AlgebraicGeometry.Scheme.precoverage @AlgebraicGeometry.Flat
        (L.obj U) ∧
      E.sieve₀ ∈ P.toGrothendieck U ∧ E.sieve₀ ≤ S := by
  let _ : Precoverage.HasIsos
      ((AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Flat)).comap L) :=
    inferInstanceAs (Precoverage.HasIsos
      ((AlgebraicGeometry.Scheme.precoverage
        AlgebraicGeometry.flatSchemeMorphisms.{u}).comap L))
  let _ : Precoverage.IsStableUnderBaseChange
      ((AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Flat)).comap L) :=
    inferInstanceAs (Precoverage.IsStableUnderBaseChange
      ((AlgebraicGeometry.Scheme.precoverage
        AlgebraicGeometry.flatSchemeMorphisms.{u}).comap L))
  let _ : Precoverage.IsStableUnderComposition
      ((AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Flat)).comap L) :=
    inferInstanceAs (Precoverage.IsStableUnderComposition
      ((AlgebraicGeometry.Scheme.precoverage
        AlgebraicGeometry.flatSchemeMorphisms.{u}).comap L))
  let K : Pretopology C := Pretopology.finite C ⊓
    ((AlgebraicGeometry.Scheme.precoverage @AlgebraicGeometry.Flat).comap L).toPretopology ⊓
      P.toGrothendieck.toPretopology
  have hle : P.toGrothendieck ≤ K.toGrothendieck := by
    refine Precoverage.toGrothendieck_le_iff_le_toPrecoverage.mpr fun X R hR => ?_
    change Sieve.generate R ∈ K.toGrothendieck X
    exact ⟨R, ⟨⟨(hP R hR).1, (hP R hR).2⟩, Precoverage.generate_mem_toGrothendieck hR⟩,
      Sieve.le_generate R⟩
  obtain ⟨R, hR, hRS⟩ := (Pretopology.mem_toGrothendieck K U S).mp (hle U hS)
  let E : PreZeroHypercover U :=
    { I₀ := R.uncurry, X := fun i => i.1.1, f := fun i => i.1.2 }
  have he : E.presieve₀ = R := by
    funext V f
    refine propext ⟨?_, fun hf => Presieve.ofArrows.mk (⟨⟨V, f⟩, hf⟩ : R.uncurry)⟩
    rintro ⟨i⟩
    exact i.2
  refine ⟨E, hR.1.1.to_subtype, ?_, ?_, ?_⟩
  · rw [PreZeroHypercover.presieve₀_map, he]
    exact hR.1.2
  · change Sieve.generate E.presieve₀ ∈ _
    rw [he]
    exact hR.2
  · change Sieve.generate E.presieve₀ ≤ S
    rw [he]
    exact (Sieve.generate_le_iff _ _).mpr hRS

end Stacks.Sites

/-- A finite family whose image under `L` is a flat covering is a finite flat covering family. -/
private theorem finite_flat_presieve₀ {C : Type v} [Category.{w} C]
    (L : C ⥤ AlgebraicGeometry.Scheme.{u}) {U : C} (E : PreZeroHypercover.{max v w} U)
    [Finite E.I₀]
    (h : (E.map L).presieve₀ ∈ AlgebraicGeometry.Scheme.precoverage
      @AlgebraicGeometry.Flat (L.obj U)) :
    E.presieve₀.uncurry.Finite ∧ E.presieve₀.map L ∈
      AlgebraicGeometry.Scheme.precoverage @AlgebraicGeometry.Flat (L.obj U) :=
  ⟨Precoverage.ofArrows_mem_finite _ _, by rwa [← PreZeroHypercover.presieve₀_map]⟩

namespace AlgebraicGeometry.BigAffineEtale

/-- The covering families of the big affine étale site are finite, and on the underlying schemes
they are flat coverings. -/
theorem finite_flat_of_mem_precoverage (B : BigEtaleSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) {U : BigAffineEtale B S hS} (R : Presieve U)
    (hR : R ∈ precoverage B S hS U) :
    R.uncurry.Finite ∧
      R.map (toScheme B S hS) ∈ Scheme.precoverage @Flat ((toScheme B S hS).obj U) := by
  obtain ⟨E, rfl, hE⟩ := hR
  have : Finite E.I₀ := hE.2.2.1
  obtain ⟨hs, het⟩ := (Scheme.presieve₀_mem_precoverage_iff (E.map (toScheme B S hS))).mp
    (BigEtaleSite.IsCovering.etale hE.1)
  exact finite_flat_presieve₀ _ E ((Scheme.presieve₀_mem_precoverage_iff _).mpr
    ⟨hs, fun i => by have := het i; infer_instance⟩)

end AlgebraicGeometry.BigAffineEtale

namespace AlgebraicGeometry.BigAffineZariski

/-- The covering families of the big affine Zariski site are finite, and on the underlying
schemes they are flat coverings. -/
theorem finite_flat_of_mem_precoverage (B : BigZariskiSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) {U : BigAffineZariski B S hS} (R : Presieve U)
    (hR : R ∈ precoverage B S hS U) :
    R.uncurry.Finite ∧
      R.map (toScheme B S hS) ∈ Scheme.precoverage @Flat ((toScheme B S hS).obj U) := by
  obtain ⟨E, rfl, hE⟩ := hR
  obtain ⟨h, hstd⟩ := hE.2
  have : Finite E.I₀ := hstd.1
  exact finite_flat_presieve₀ _ E
    (Scheme.precoverage_mono (fun _ _ f (_ : IsOpenImmersion f) => (inferInstance : Flat f)) _ h)

end AlgebraicGeometry.BigAffineZariski

namespace AlgebraicGeometry.BigAffineSmooth

/-- The covering families of the big affine smooth site are finite, and on the underlying
schemes they are flat coverings. -/
theorem finite_flat_of_mem_precoverage (B : BigSmoothSite.{u}) (S : Scheme.{u})
    (hS : S.size < B.cutoff) {U : BigAffineSmooth B S hS} (R : Presieve U)
    (hR : R ∈ precoverage B S hS U) :
    R.uncurry.Finite ∧
      R.map (toScheme B S hS) ∈ Scheme.precoverage @Flat ((toScheme B S hS).obj U) := by
  obtain ⟨E, rfl, hE⟩ := hR
  obtain ⟨hI, -⟩ := hE.2
  have hs : (E.map (toScheme B S hS)).presieve₀ ∈ Scheme.precoverage @Smooth _ := hE.1.1
  exact finite_flat_presieve₀ _ E
    (Scheme.precoverage_mono (fun _ _ f (_ : Smooth f) => (inferInstance : Flat f)) _ hs)

end AlgebraicGeometry.BigAffineSmooth

namespace AlgebraicGeometry.BigAffineSyntomic

/-- The covering families of the big affine syntomic site are finite, and on the underlying
schemes they are flat coverings. -/
theorem finite_flat_of_mem_precoverage (B : BigSyntomicSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) {U : BigAffineSyntomic B S hS} (R : Presieve U)
    (hR : R ∈ precoverage B S hS U) :
    R.uncurry.Finite ∧
      R.map (toScheme B S hS) ∈ Scheme.precoverage @Flat ((toScheme B S hS).obj U) := by
  obtain ⟨E, rfl, hE⟩ := hR
  have : Finite E.I₀ := hE.2.finite_index
  have hs : (E.map (toScheme B S hS)).presieve₀ ∈ Scheme.precoverage @Syntomic _ :=
    isSyntomicCovering_iff_mem_precoverage.mp hE.1.1
  exact finite_flat_presieve₀ _ E
    (Scheme.precoverage_mono (fun _ _ _ hf => AlgebraicGeometry.flat hf) _ hs)

end AlgebraicGeometry.BigAffineSyntomic

namespace AlgebraicGeometry.BigAffineFppf

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The five big affine topologies of Stacks 0H0A on the affine schemes over `S`, all on the
category `AlgebraicGeometry.BigAffineFppf` they share. -/
def siteKindPrecoverage : SiteKind → Precoverage (BigAffineFppf B S hS)
  | .zariski => BigAffineZariski.precoverage B.toBigZariskiSite S hS
  | .etale => BigAffineEtale.precoverage B.toBigEtaleSite S hS
  | .smooth => BigAffineSmooth.precoverage B.toBigSmoothSite S hS
  | .syntomic => BigAffineSyntomic.precoverage B.toBigSyntomicSite S hS
  | .fppf => BigAffineFppf.precoverage B S hS

/-- **The five big affine sites of Stacks 0H0A**, as topologies on the affine schemes over `S`:
the topologies generated by the standard Zariski, étale, smooth, syntomic and fppf coverings. -/
abbrev siteKindTopology (τ : SiteKind) : GrothendieckTopology (BigAffineFppf B S hS) :=
  (siteKindPrecoverage B S hS τ).toGrothendieck

/-- The covering families of each of the five big affine sites are finite, and on the
underlying schemes they are flat coverings. -/
theorem finite_flat_of_mem_siteKindPrecoverage (τ : SiteKind) {U : BigAffineFppf B S hS}
    (R : Presieve U) (hR : R ∈ siteKindPrecoverage B S hS τ U) :
    R.uncurry.Finite ∧
      R.map (toScheme B S hS) ∈ Scheme.precoverage @Flat ((toScheme B S hS).obj U) := by
  cases τ with
  | fppf =>
    obtain ⟨E, rfl, hE⟩ := hR
    have : Finite E.I₀ := hE.2.finite_index
    refine finite_flat_presieve₀ _ E ((Scheme.presieve₀_mem_precoverage_iff _).mpr
      ⟨fun x => ?_, hE.2.flat⟩)
    have hx : x ∈ ⋃ i, Set.range ((toScheme B S hS).map (E.f i)) := by
      rw [hE.2.jointly_surjective]
      exact Set.mem_univ x
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
    exact ⟨i, hi⟩
  | etale =>
    exact BigAffineEtale.finite_flat_of_mem_precoverage B.toBigEtaleSite S hS R hR
  | zariski =>
    exact BigAffineZariski.finite_flat_of_mem_precoverage B.toBigZariskiSite S hS R hR
  | smooth =>
    exact BigAffineSmooth.finite_flat_of_mem_precoverage B.toBigSmoothSite S hS R hR
  | syntomic =>
    exact BigAffineSyntomic.finite_flat_of_mem_precoverage B.toBigSyntomicSite S hS R hR

end AlgebraicGeometry.BigAffineFppf

namespace AlgebraicGeometry.Stack.AffineCategory

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {𝒳 : Type v} [Category.{w} 𝒳] (p : 𝒳 ⥤ BigFppfOver B S hS)

/-- The underlying affine scheme of an object of the affine subcategory. -/
abbrev toScheme : AffineCategory B S hS p ⥤ Scheme.{u} :=
  toAffine B S hS p ⋙ BigAffineFppf.toScheme B S hS

/-- The underlying scheme of an object of the affine subcategory is affine. -/
instance isAffine_toScheme_obj (x : AffineCategory B S hS p) :
    IsAffine ((toScheme B S hS p).obj x) :=
  x.property

/-- **Stacks 06WY for the affine subcategory.** The affine subcategory of a category fibred in
groupoids has fibre products: it is fibred in groupoids over the affine schemes over `S`, which
have them. -/
theorem hasPullbacks (hp : p.IsFiberedInGroupoids) : HasPullbacks (AffineCategory B S hS p) :=
  @hasPullbacks_of_hasLimit_cospan _ _ fun {_ _ _} {f g} =>
    (isFiberedInGroupoids_toAffine B S hS p hp).hasPullback (toAffine B S hS p) f g

/-- The structure functor of the affine subcategory carries fibre products to fibre products. -/
theorem preservesPullbacks_toAffine (hp : p.IsFiberedInGroupoids) :
    PreservesLimitsOfShape WalkingCospan (toAffine B S hS p) := by
  have := hasPullbacks B S hS p hp
  have hq := isFiberedInGroupoids_toAffine B S hS p hp
  refine ⟨fun {K} => ?_⟩
  have key : ∀ {X Y Z : AffineCategory B S hS p} (g : X ⟶ Z) (h : Y ⟶ Z),
      PreservesLimit (cospan g h) (toAffine B S hS p) := by
    intro X Y Z g h
    have hX : IsPullback (pullback.fst g h) (pullback.snd g h) g h :=
      IsPullback.of_hasPullback g h
    have hBase := hq.map_isPullback (toAffine B S hS p) g h
      (pullback.fst g h) (pullback.snd g h) hX
    exact preservesLimit_of_preserves_limit_cone hX.isLimit
      ((isLimitMapConePullbackConeEquiv (toAffine B S hS p) hX.w).symm hBase.isLimit)
  have := key (K.map WalkingCospan.Hom.inl) (K.map WalkingCospan.Hom.inr)
  exact preservesLimit_of_iso_diagram _ (diagramIsoCospan K).symm

/-- The underlying scheme functor of the affine subcategory carries fibre products to fibre
products. -/
theorem preservesPullbacks_toScheme (hp : p.IsFiberedInGroupoids) :
    PreservesLimitsOfShape WalkingCospan (toScheme B S hS p) := by
  have := preservesPullbacks_toAffine B S hS p hp
  exact comp_preservesLimitsOfShape _ _

/-- **The coverings of the five associated affine sites are refined by finite flat coverings.**
Every covering sieve of `𝒳_{affine, τ}` contains a finite family which is itself covering, and
which on the underlying affine schemes is a flat covering: its members are flat and jointly
surjective.

The family is obtained by refining the image sieve downstairs, which is a covering sieve of the
big affine `τ`-site, by a finite standard `τ`-covering, and lifting its members back to
`𝒳_{affine}` along the structure functor, which is fibred in groupoids. -/
theorem exists_finite_flat_covering (hp : p.IsFiberedInGroupoids) (τ : SiteKind)
    {x : AffineCategory B S hS p} (T : Sieve x)
    (hT : T ∈ associatedAffineTopology B S hS p (BigAffineFppf.siteKindTopology B S hS τ) x) :
    ∃ E : PreZeroHypercover.{u + 1} x, Finite E.I₀ ∧
      (E.map (toScheme B S hS p)).presieve₀ ∈
        Scheme.precoverage @Flat ((toScheme B S hS p).obj x) ∧
      E.sieve₀ ∈ associatedAffineTopology B S hS p (BigAffineFppf.siteKindTopology B S hS τ) x ∧
      E.sieve₀ ≤ T := by
  classical
  let q := toAffine B S hS p
  let L := BigAffineFppf.toScheme B S hS
  have hq := isFiberedInGroupoids_toAffine B S hS p hp
  have hT' : T.functorPushforward q ∈ BigAffineFppf.siteKindTopology B S hS τ (q.obj x) :=
    (Functor.mem_inheritedTopology_iff_functorPushforward q _ hq T).mp hT
  obtain ⟨E, hfin, hflat, hcov, hle⟩ := Stacks.Sites.exists_finite_flat_covering_refinement
    L (BigAffineFppf.siteKindPrecoverage B S hS τ)
    (fun R hR => BigAffineFppf.finite_flat_of_mem_siteKindPrecoverage B S hS τ R hR) _ hT'
  have hmem : ∀ k : E.I₀, ∃ (y : AffineCategory B S hS p) (g : y ⟶ x) (h : E.X k ⟶ q.obj y),
      T g ∧ E.f k = h ≫ q.map g := fun k => hle _ (Sieve.ofArrows_mk _ _ k)
  choose y g h hg hfac using hmem
  choose z φ hφ using fun k => hq.exists_lift (h k) (y k) rfl
  have _ : ∀ k, q.IsHomLift (h k) (φ k) := hφ
  have hmap : ∀ k, q.map (φ k ≫ g k) =
      eqToHom (IsHomLift.domain_eq q (h k) (φ k)) ≫ E.f k := by
    intro k
    rw [q.map_comp, IsHomLift.fac' q (h k) (φ k), hfac k]
    simp
  let E' : PreZeroHypercover.{u + 1} x := ⟨E.I₀, z, fun k => φ k ≫ g k⟩
  obtain ⟨hsurj, hfl⟩ := (Scheme.presieve₀_mem_precoverage_iff (E.map L)).mp hflat
  refine ⟨E', hfin, ?_, ?_, ?_⟩
  · refine (Scheme.presieve₀_mem_precoverage_iff (E'.map (toScheme B S hS p))).mpr ⟨?_, ?_⟩
    · intro a
      obtain ⟨k, b, rfl⟩ := hsurj a
      have := hφ k
      let e := L.map (eqToHom (IsHomLift.domain_eq q (h k) (φ k)))
      obtain ⟨c, rfl⟩ := (inferInstance : Surjective e).surj b
      refine ⟨k, c, ?_⟩
      change (L.map (q.map (φ k ≫ g k))) c = _
      rw [hmap k, L.map_comp, Scheme.Hom.comp_apply]
      rfl
    · intro k
      change Flat (L.map (q.map (φ k ≫ g k)))
      rw [hmap k, L.map_comp]
      have := hfl k
      change Flat (L.map (E.f k)) at this
      infer_instance
  · apply (Functor.mem_inheritedTopology_iff_functorPushforward q _ hq _).mpr
    refine GrothendieckTopology.superset_covering _ ?_ hcov
    rintro _ _ ⟨_, a, _, ⟨k⟩, rfl⟩
    refine ⟨z k, φ k ≫ g k, a ≫ eqToHom (IsHomLift.domain_eq q (h k) (φ k)).symm,
      Sieve.ofArrows_mk _ _ k, ?_⟩
    rw [hmap k]
    simp
  · rintro _ _ ⟨_, a, _, ⟨k⟩, rfl⟩
    rw [← Category.assoc]
    exact T.downward_closed (hg k) (a ≫ φ k)

end AlgebraicGeometry.Stack.AffineCategory

end
