module

public import StacksFrontier.AlgebraicGeometry.Stacks.LisseEtaleDerivedModuleLowerShriek
public import StacksFrontier.AlgebraicGeometry.Stacks.SubsiteDerivedModuleBaseChange
public import StacksFrontier.CategoryTheory.Sites.Cohomology.LowerShriek.ULiftModuleDerivedLowerShriek

/-!
# The derived lower shriek of modules for the lisse-étale site, at module universe `u + 1`

The sheaves of modules of **Stacks 07AV** on the sites of an algebraic stack have their sections in
`Type (u + 1)`, one universe above the structure sheaf of **Stacks 06TV**: those are the categories
`SheafOfModules.{u + 1} (AlgebraicGeometry.Stack.LisseEtale.ambientRingStructureSheaf 𝒳)` and
`SheafOfModules.{u + 1} (AlgebraicGeometry.Stack.LisseEtale.subsiteRingStructureSheaf 𝒳)`, with
`g^* = AlgebraicGeometry.Stack.LisseEtale.moduleInverseImage`. This file gives **Stacks 07AS** part
(2) on them: the left derived functor `Lg_!`, left adjoint to `g^*`, with `g^* Lg_! = id`, with no
hypothesis. It is the instance of `Stacks.Cohomology.DerivedLowerShriek.ULift`, which transports
the construction from the structure sheaf raised to `Type (u + 1)`.

## Main definitions

* `AlgebraicGeometry.Stack.LisseEtale.derivedModuleLowerShriekSucc`: `Lg_!`.
* `AlgebraicGeometry.Stack.LisseEtale.derivedModuleLowerShriekSuccAdjunction`: `Lg_! ⊣ g^*`.

## Main results

* `AlgebraicGeometry.Stack.LisseEtale.isIso_derivedModuleLowerShriekSuccAdjunction_unit`:
  `g^* Lg_! = id`.

## References

* [Stacks Project, Tag 07AS](https://stacks.math.columbia.edu/tag/07AS)
* [Stacks Project, Tag 07AV](https://stacks.math.columbia.edu/tag/07AV)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Stack.LisseEtale

universe u w t t'

attribute [local instance] isContinuous_inclusion_topology' isCocontinuous_inclusion_topology'
  Stacks.hasSheafCompose_forget₂_commRingCat

-- the abelian structure of the library on sheaves of modules whose sections contain the site
-- would be met first by instance search here, with a universe constraint it cannot solve
attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  (𝒳 : Stack.AlgebraicStacks.{u, w} B S hS)

/-- The covering-pullback condition of Stacks 00WV for the inclusion of the lisse-étale site, at
the topology generated by the chosen covering families, which agrees with the inherited one by
`AlgebraicGeometry.Stack.LisseEtale.inclusionTopology_eq_topology`. -/
theorem preservesCoveringPullbacks_inclusion_topology :
    Stacks.Sites.PreservesCoveringPullbacks (topology.{u, w} B S hS 𝒳)
      (smoothObject.{u, w} B S hS 𝒳).ι := by
  rw [← inclusionTopology_eq_topology.{u, w} B S hS 𝒳 (closedUnderSmoothMorphisms B S hS 𝒳)]
  exact preservesCoveringPullbacks_inclusion B S hS 𝒳

attribute [local instance] preservesCoveringPullbacks_inclusion_topology

/-- The category of an algebraic stack is essentially small in `Type (u + 1)`. -/
local instance essentiallySmall_obj_largeSections : EssentiallySmall.{u + 1} 𝒳.val.val.obj :=
  FlatFppf.essentiallySmall_obj_coefficient.{u, w, u + 1} B S hS 𝒳

/-- The lisse-étale site of an algebraic stack is essentially small in `Type (u + 1)`. -/
local instance essentiallySmall_lisseEtale_largeSections :
    EssentiallySmall.{u + 1} (LisseEtale.{u, w} B S hS 𝒳) :=
  essentiallySmall_lisseEtale.{u, w} B S hS 𝒳

/-- Sheafification of abelian presheaves with sections in `Type (u + 1)` on the lisse-étale site,
at the topology generated by the chosen covering families. -/
local instance hasSheafify_topology_largeSections :
    HasSheafify (topology.{u, w} B S hS 𝒳) AddCommGrpCat.{u + 1} :=
  GrothendieckTopology.hasSheafify_addCommGrpCat.{u + 1, u, u + 1} _

/-- On the lisse-étale site, sheafification of abelian presheaves with sections in `Type (u + 1)`
inverts exactly the locally bijective morphisms. -/
local instance wEqualsLocallyBijective_topology_largeSections :
    (topology.{u, w} B S hS 𝒳).WEqualsLocallyBijective AddCommGrpCat.{u + 1} :=
  AlgebraicGeometry.SheafOfModules.wEqualsLocallyBijective_addCommGrpCat.{u + 1, u + 1, u} _

/-- Sheafification of abelian presheaves with sections in `Type (u + 1)` on the étale site. -/
local instance hasSheafify_ambientTopology_largeSections :
    HasSheafify (ambientTopology B S hS 𝒳) AddCommGrpCat.{u + 1} :=
  GrothendieckTopology.hasSheafify_addCommGrpCat.{u + 1, u, u + 1} _

/-- On the étale site, sheafification of abelian presheaves with sections in `Type (u + 1)`
inverts exactly the locally bijective morphisms. -/
local instance wEqualsLocallyBijective_ambientTopology_largeSections :
    (ambientTopology B S hS 𝒳).WEqualsLocallyBijective AddCommGrpCat.{u + 1} :=
  AlgebraicGeometry.SheafOfModules.wEqualsLocallyBijective_addCommGrpCat.{u + 1, u + 1, u} _

/-- Right Kan extensions of presheaves of rings in `Type (u + 1)` along the inclusion of the smooth
objects exist. -/
local instance hasPointwiseRightKanExtension_inclusion_ringCat_largeSections :
    ∀ F : (LisseEtale.{u, w} B S hS 𝒳)ᵒᵖ ⥤ RingCat.{u + 1},
      (smoothObject.{u, w} B S hS 𝒳).ι.op.HasPointwiseRightKanExtension F := fun _ Y => by
  have := hasLimitsOfShape_of_essentiallySmall.{u + 1}
    (StructuredArrow Y (smoothObject.{u, w} B S hS 𝒳).ι.op) RingCat.{u + 1}
  infer_instance

/-- Right Kan extensions of presheaves of abelian groups in `Type (u + 1)` along the inclusion of
the smooth objects exist. -/
local instance hasPointwiseRightKanExtension_inclusion_addCommGrpCat_largeSections :
    ∀ F : (LisseEtale.{u, w} B S hS 𝒳)ᵒᵖ ⥤ AddCommGrpCat.{u + 1},
      (smoothObject.{u, w} B S hS 𝒳).ι.op.HasPointwiseRightKanExtension F := fun _ Y => by
  have := hasLimitsOfShape_of_essentiallySmall.{u + 1}
    (StructuredArrow Y (smoothObject.{u, w} B S hS 𝒳).ι.op) AddCommGrpCat.{u + 1}
  infer_instance

variable [HasDerivedCategory.{t} (SheafOfModules.{u + 1} (subsiteRingStructureSheaf B S hS 𝒳))]
  [HasDerivedCategory.{t'} (SheafOfModules.{u + 1} (ambientRingStructureSheaf B S hS 𝒳))]

/-- The chosen derived category of the modules on the subsite, read at the spelling of the same
category in the general theory. -/
local instance hasDerivedCategory_sourceModules_largeSections :
    HasDerivedCategory.{t} (SheafOfModules.{u + 1}
      (Stacks.Cohomology.DerivedLowerShriek.inverseImageRing (topology.{u, w} B S hS 𝒳)
        (ambientTopology B S hS 𝒳) (smoothObject.{u, w} B S hS 𝒳).ι
        (Stacks.SheafOfModules.Tensor.ringSheaf
          (Stack.structureSheaf B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
      (etaleTopology_le_topology B))))) :=
  ‹HasDerivedCategory.{t} (SheafOfModules.{u + 1} (subsiteRingStructureSheaf B S hS 𝒳))›

/-- The chosen derived category of the modules on the ambient site, read at the spelling of the
same category in the general theory. -/
local instance hasDerivedCategory_targetModules_largeSections :
    HasDerivedCategory.{t'} (SheafOfModules.{u + 1}
      (Stacks.SheafOfModules.Tensor.ringSheaf
        (Stack.structureSheaf B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
      (etaleTopology_le_topology B)))) :=
  ‹HasDerivedCategory.{t'} (SheafOfModules.{u + 1} (ambientRingStructureSheaf B S hS 𝒳))›

/-- **The derived lower shriek `Lg_!` of Stacks 07AS (2) at module universe `u + 1`.** -/
abbrev derivedModuleLowerShriekSucc :
    DerivedCategory (SheafOfModules.{u + 1} (subsiteRingStructureSheaf B S hS 𝒳)) ⥤
      DerivedCategory (SheafOfModules.{u + 1} (ambientRingStructureSheaf B S hS 𝒳)) :=
  Stacks.Cohomology.DerivedLowerShriek.ULift.derivedLowerShriek.{u + 1} (topology.{u, w} B S hS 𝒳)
    (ambientTopology B S hS 𝒳) (smoothObject.{u, w} B S hS 𝒳).ι
    (Stack.structureSheaf B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
      (etaleTopology_le_topology B))

/-- **Stacks 07AS (2), adjointness, at module universe `u + 1`**: `Lg_! ⊣ g^*`, `g^*` being
`AlgebraicGeometry.Stack.LisseEtale.moduleInverseImage` on the derived categories. -/
def derivedModuleLowerShriekSuccAdjunction :
    derivedModuleLowerShriekSucc B S hS 𝒳 ⊣ (moduleInverseImage B S hS 𝒳).mapDerivedCategory :=
  Stacks.Cohomology.DerivedLowerShriek.ULift.derivedLowerShriekAdjunction.{u + 1}
    (topology.{u, w} B S hS 𝒳) (ambientTopology B S hS 𝒳) (smoothObject.{u, w} B S hS 𝒳).ι
    (Stack.structureSheaf B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
      (etaleTopology_le_topology B))

/-- **Stacks 07AS (2), `g^* Lg_! = id`, at module universe `u + 1`**: the unit of `Lg_! ⊣ g^*` is
invertible, with no hypothesis. -/
theorem isIso_derivedModuleLowerShriekSuccAdjunction_unit :
    IsIso (LisseEtale.derivedModuleLowerShriekSuccAdjunction B S hS 𝒳).unit :=
  Stacks.Cohomology.DerivedLowerShriek.ULift.isIso_derivedLowerShriekAdjunction_unit.{u + 1}
    (topology.{u, w} B S hS 𝒳) (ambientTopology B S hS 𝒳) (smoothObject.{u, w} B S hS 𝒳).ι
    (Stack.structureSheaf B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
      (etaleTopology_le_topology B))

/-- **`Lg_!` is computed degreewise at module universe `u + 1`** (Stacks 0794): for a complex
`L` bounded above by `0` whose terms are carried by the universe transport
`Stacks.Cohomology.DerivedLowerShriek.ULift.sourceModulesEquivalence` to direct sums of the
`j_{U!} 𝒪_U`, `Lg_!(L) ≅ g_!(L)`, with `g_!` the lower shriek `Stacks.SheafOfModules.lowerShriek`
of sheaves of modules, the left adjoint of `moduleInverseImage`. -/
def derivedModuleLowerShriekSuccObjQIso
    (L : CochainComplex (SheafOfModules.{u + 1} (subsiteRingStructureSheaf B S hS 𝒳)) ℤ)
    (hL0 : CochainComplex.IsStrictlyLE L 0)
    (hL : ∀ n, Stacks.Cohomology.DerivedLowerShriek.IsSumOfExtensionByZeroUnits
      (Stacks.Cohomology.DerivedLowerShriek.inverseImageRing (topology.{u, w} B S hS 𝒳)
        (ambientTopology B S hS 𝒳) (smoothObject.{u, w} B S hS 𝒳).ι
        (Stacks.SheafOfModules.Tensor.ringSheaf
          (Stacks.Cohomology.DerivedLowerShriek.ULift.liftedStructureSheaf.{u + 1}
            (ambientTopology B S hS 𝒳)
            (Stack.structureSheaf B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
      (etaleTopology_le_topology B)))))
      ((Stacks.Cohomology.DerivedLowerShriek.ULift.sourceModulesEquivalence.{u + 1}
        (topology.{u, w} B S hS 𝒳) (ambientTopology B S hS 𝒳)
        (smoothObject.{u, w} B S hS 𝒳).ι
        (Stack.structureSheaf B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
      (etaleTopology_le_topology B))).functor.obj (L.X n))) :
    (derivedModuleLowerShriekSucc B S hS 𝒳).obj (DerivedCategory.Q.obj L) ≅
      DerivedCategory.Q.obj (((Stacks.SheafOfModules.lowerShriek.{u + 1} (topology.{u, w} B S hS 𝒳)
        (ambientTopology B S hS 𝒳) (smoothObject.{u, w} B S hS 𝒳).ι
        (ambientRingStructureSheaf B S hS 𝒳)).mapHomologicalComplex (ComplexShape.up ℤ)).obj L) :=
  Stacks.Cohomology.DerivedLowerShriek.ULift.derivedLowerShriekObjQIso.{u + 1}
    (topology.{u, w} B S hS 𝒳) (ambientTopology B S hS 𝒳)
    (smoothObject.{u, w} B S hS 𝒳).ι
    (Stack.structureSheaf B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
      (etaleTopology_le_topology B)) L hL0 hL

end AlgebraicGeometry.Stack.LisseEtale

end
