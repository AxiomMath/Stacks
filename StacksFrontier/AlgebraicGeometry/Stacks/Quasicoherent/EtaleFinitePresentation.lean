module

public import StacksFrontier.Algebra.Module.FinitePresentation.BaseChangeRelations
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FinitePresentationSections
public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.AffineSectionExtension
public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.EtaleAffineCovering
public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.InternalHomSiteAgreement
public import StacksFrontier.AlgebraicGeometry.Topologies.FinitePresentationOnSiteUniverses
public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.DerivedQuasicoherent

/-!
# Finite presentation on the étale site from finitely presented affine sections

Let `p : 𝒳 ⥤ (Sch/S)_{fppf}` be a category fibred in groupoids and let `F` be a quasi-coherent
module on its associated fppf site whose sections `F(y)` over every object `y` lying over an
affine scheme are finitely presented over `Γ(y)`. Then the restriction of `F` to the associated
étale site is of finite presentation in the sense of Modules on Sites, Definition 03DL (7)
(`AlgebraicGeometry.FibredSite.isFinitePresentationOnSite_restrictSiteModules_etale`). This is the
converse of `AlgebraicGeometry.FibredSite.finitePresentation_obj_of_isFinitePresentationOnSite`.

## Proof

Every object has an étale covering by affine objects. Over an affine `y`, choose a finite
presentation `Aᵐ → Aⁿ → F(y) → 0` with `A = Γ(y)`. A quasi-coherent module is cartesian between
affine objects (Descent, Proposition 03DX), so over every affine `W ⟶ y` the sections `F(W)` are
`Γ(W) ⊗_A F(y)`; tensor product being right exact, the images of the `n` generators generate
`F(W)` and the images of the `m` relations generate the relations among them
(`Module.exists_sum_eq_of_bijective_liftBaseChange`,
`Module.exists_coeffs_of_bijective_liftBaseChange`). Affine objects cover every object, so this is
the section-level presentation data of Stacks 03DL, which
`Stacks.SheafOfModules.exists_isFinite_presentation_over_of_relations` turns into a finite
presentation of `F` on the étale slice at `y`.

## References

* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u w

namespace AlgebraicGeometry.FibredSite

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
  {𝒳 : Type (u + 1)} [Category.{u} 𝒳] {p : 𝒳 ⥤ BigFppfOver B S hS}
  {hp : p.IsFiberedInGroupoids}

attribute [local instance] objModule

/-- Sections of a quasi-coherent module over an affine object, base changed to an affine object
mapping to it, are generated by restrictions of generators. -/
theorem exists_sum_restriction_eq
    (F : SheafOfModules.{u} (ringStructureSheafCore B S hS p hp .fppf))
    (hF : F.IsQuasicoherentOnSite) {y W : 𝒳} (k : W ⟶ y)
    (hy : IsAffineOver B S hS (p.obj y)) (hW : IsAffineOver B S hS (p.obj W))
    {n : ℕ} (f : (Fin n → objRing B S hS p y) →ₗ[objRing B S hS p y] F.val.obj (op y))
    (hf : Function.Surjective f) (x : F.val.obj (op W)) :
    ∃ b : Fin n → objRing B S hS p W,
      ∑ i, b i • F.val.restrictₛₗ k.op (f (Pi.single i 1)) = x := by
  let := objAlgebra B S hS p k
  let : Module (objRing B S hS p y) (F.val.obj (op W)) :=
    Module.compHom _ (algebraMap (objRing B S hS p y) (objRing B S hS p W))
  have : IsScalarTower (objRing B S hS p y) (objRing B S hS p W) (F.val.obj (op W)) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  exact Module.exists_sum_eq_of_bijective_liftBaseChange f hf (restrictionLinear F k)
    (bijective_liftBaseChange_of_eq_restriction F hF k hy hW _ fun _ => rfl) x

/-- Relations among the restrictions of generators are base changes of relations. -/
theorem exists_coeffs_restriction
    (F : SheafOfModules.{u} (ringStructureSheafCore B S hS p hp .fppf))
    (hF : F.IsQuasicoherentOnSite) {y W : 𝒳} (k : W ⟶ y)
    (hy : IsAffineOver B S hS (p.obj y)) (hW : IsAffineOver B S hS (p.obj W))
    {n m : ℕ} (f : (Fin n → objRing B S hS p y) →ₗ[objRing B S hS p y] F.val.obj (op y))
    (g : (Fin m → objRing B S hS p y) →ₗ[objRing B S hS p y] (Fin n → objRing B S hS p y))
    (hf : Function.Surjective f) (hfg : Function.Exact g f) (b : Fin n → objRing B S hS p W)
    (hb : ∑ i, b i • F.val.restrictₛₗ k.op (f (Pi.single i 1)) = 0) :
    ∃ c : Fin m → objRing B S hS p W, ∀ i,
      b i = ∑ j, c j * ((BigFppfOver.toScheme B S hS).map (p.map k)).appTop.hom
        (g (Pi.single j 1) i) := by
  let := objAlgebra B S hS p k
  let : Module (objRing B S hS p y) (F.val.obj (op W)) :=
    Module.compHom _ (algebraMap (objRing B S hS p y) (objRing B S hS p W))
  have : IsScalarTower (objRing B S hS p y) (objRing B S hS p W) (F.val.obj (op W)) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  exact Module.exists_coeffs_of_bijective_liftBaseChange f g hf hfg (restrictionLinear F k)
    (bijective_liftBaseChange_of_eq_restriction F hF k hy hW _ fun _ => rfl) b hb

variable (B S hS p hp) in
/-- **The étale restriction of a quasi-coherent module with finitely presented sections over an
affine object has a finite global presentation on the étale slice at that object.** -/
theorem hasFiniteGlobalPresentation_over_restrictSiteModules_etale
    (F : SheafOfModules.{u} (ringStructureSheafCore B S hS p hp .fppf))
    (hF : F.IsQuasicoherentOnSite) {y : 𝒳} (hy : IsAffineOver B S hS (p.obj y))
    (hfp : Module.FinitePresentation (objRing B S hS p y) (F.val.obj (op y))) :
    ((restrictSiteModules B S hS p hp .etale F).over y).HasFiniteGlobalPresentation := by
  let J := BigFppfOver.associatedTopology B S hS p .etale
  let G := restrictSiteModules B S hS p hp .etale F
  have : ∀ X : 𝒳, HasSheafify (J.over X) AddCommGrpCat.{u} := fun X =>
    have := essentiallySmall_over B S hS p hp X
    hasSheafifyEssentiallySmallSite.{_, _, _, _, u} _ _
  have : ∀ X : 𝒳, (J.over X).WEqualsLocallyBijective AddCommGrpCat.{u} := fun X =>
    wEqualsLocallyBijective_over B S hS p hp .etale X
  obtain ⟨n, m, f, g, hf, hfg⟩ := Module.FinitePresentation.exists_fin' (objRing B S hS p y)
    (F.val.obj (op y))
  let s : Fin n → G.val.obj (op y) := fun i => f (Pi.single i 1)
  let t : Fin m → Fin n → (ringStructureSheafCore B S hS p hp .etale).obj.obj (op y) :=
    fun j i => g (Pi.single j 1) i
  have hrel : ∀ j, ∑ i, t j i • s i = 0 := by
    intro j
    have : ∑ i, t j i • s i = f (g (Pi.single j 1)) := by
      conv_rhs => rw [show g (Pi.single j 1) = ∑ i, g (Pi.single j 1) i • Pi.single i 1 by
        ext; simp [Pi.single_apply]]
      rw [map_sum]
      exact Finset.sum_congr rfl fun i _ => (map_smul f _ _).symm
    rw [this]
    exact (hfg _).2 ⟨_, rfl⟩
  have hA : ∀ V : 𝒳, Sieve.generate (fun W (_ : W ⟶ V) => IsAffineOver B S hS (p.obj W)) ∈
      J V := fun V =>
    mem_etale_of_forall_isAffine B S hS p hp V _ fun W f hW => ⟨W, 𝟙 W, f, hW, Category.id_comp f⟩
  have hgen : Stacks.SheafOfModules.GeneratesLocally J G.val s := by
    intro V f' x
    refine ⟨_, hA V, ?_⟩
    rintro W _ ⟨W', h, g', hg', rfl⟩
    obtain ⟨b, hb⟩ := exists_sum_restriction_eq F hF (g' ≫ f') hy hg' f hf
      (G.val.restrictₛₗ g'.op x)
    refine ⟨fun i => (ringStructureSheafCore B S hS p hp .etale).obj.map h.op (b i), ?_⟩
    have e := congrArg (F.val.restrictₛₗ h.op) hb
    rw [map_sum] at e
    refine Eq.trans (Finset.sum_congr rfl fun i _ => ?_) (e.trans ?_)
    · rw [map_smulₛₗ]
      congr 1
      change _ = F.val.map h.op (F.val.map (g' ≫ f').op (s i))
      rw [← PresheafOfModules.map_comp_apply, ← op_comp, ← Category.assoc]
      rfl
    · exact (PresheafOfModules.map_comp_apply F.val g'.op h.op x).symm
  have hall : ∀ (W : 𝒳) (g'' : W ⟶ y)
      (a : Fin n → ToType ((ringStructureSheafCore B S hS p hp .etale).obj.obj (op W))),
      ∑ i, a i • Stacks.SheafOfModules.res G g'' (s i) = 0 →
      ∃ T : Sieve W, T ∈ J W ∧ ∀ (Z : 𝒳) (h : Z ⟶ W), T h →
        ∃ c : Fin m → ToType ((ringStructureSheafCore B S hS p hp .etale).obj.obj (op Z)),
          ∀ i, Stacks.SheafOfModules.resR _ h (a i) =
            ∑ j, c j * Stacks.SheafOfModules.resR _ (h ≫ g'') (t j i) := by
    intro W g'' a ha
    refine ⟨_, hA W, ?_⟩
    rintro Z _ ⟨Z', k, h', hZ', rfl⟩
    let b : Fin n → objRing B S hS p Z' := fun i =>
      (ringStructureSheafCore B S hS p hp .etale).obj.map h'.op (a i)
    have hb : ∑ i, b i • F.val.restrictₛₗ (h' ≫ g'').op (f (Pi.single i 1)) = 0 := by
      have e := congrArg (G.val.restrictₛₗ h'.op) ha
      rw [map_sum, map_zero] at e
      refine Eq.trans (Finset.sum_congr rfl fun i _ => ?_) e
      rw [map_smulₛₗ]
      exact congrArg (b i • ·) (PresheafOfModules.map_comp_apply G.val g''.op h'.op (s i))
    obtain ⟨c, hc⟩ := exists_coeffs_restriction F hF (h' ≫ g'') hy hZ' f g hf hfg b hb
    refine ⟨fun j => (ringStructureSheafCore B S hS p hp .etale).obj.map k.op (c j), fun i => ?_⟩
    let R := ringStructureSheafCore B S hS p hp .etale
    have e₁ : Stacks.SheafOfModules.resR R (k ≫ h') (a i) =
        Stacks.SheafOfModules.resR R k (b i) :=
      (Stacks.SheafOfModules.resR_resR R h' k (a i)).symm
    have e₂ : ∀ j, Stacks.SheafOfModules.resR R ((k ≫ h') ≫ g'') (t j i) =
        Stacks.SheafOfModules.resR R k
          (((BigFppfOver.toScheme B S hS).map (p.map (h' ≫ g''))).appTop.hom
            (g (Pi.single j 1) i)) := fun j =>
      (congrArg (fun q => Stacks.SheafOfModules.resR R q (t j i)) (Category.assoc k h' g'')).trans
        (Stacks.SheafOfModules.resR_resR R (h' ≫ g'') k (t j i)).symm
    rw [e₁, hc i]
    exact (map_sum (R.obj.map k.op).hom _ _).trans
      (Finset.sum_congr rfl fun j _ => (map_mul (R.obj.map k.op).hom _ _).trans
        (congrArg (_ * ·) (e₂ j).symm))
  obtain ⟨P, hP⟩ := Stacks.SheafOfModules.exists_isFinite_presentation_over_of_relations G s t
    hrel hgen hall
  have := hasWeakSheafify_over B S hS p hp .etale y
  exact SheafOfModules.HasFiniteGlobalPresentation.of_presentation' P hP

variable (B S hS p hp) in
/-- **A quasi-coherent module whose sections over affine objects are finitely presented is, on the
associated étale site, of finite presentation.** -/
theorem isFinitePresentationOnSite_restrictSiteModules_etale_of_isFiberedInGroupoids
    (F : SheafOfModules.{u} (ringStructureSheafCore B S hS p hp .fppf))
    (hF : F.IsQuasicoherentOnSite)
    (hfp : ∀ y, IsAffine ((BigFppfOver.toScheme B S hS).obj (p.obj y)) →
      Module.FinitePresentation ((ringStructureSheafCore B S hS p hp .fppf).obj.obj (op y))
        (F.val.obj (op y))) :
    (restrictSiteModules B S hS p hp .etale F).IsFinitePresentationOnSite := by
  constructor
  intro U
  obtain ⟨I, y, φ, haff, hcov⟩ := exists_affine_etale_ofArrows B S hS p hp U
  exact ⟨I, y, φ, hcov, fun j =>
    hasFiniteGlobalPresentation_over_restrictSiteModules_etale B S hS p hp F hF (haff j)
      (hfp _ (haff j))⟩

variable (B S hS) in
/-- **A quasi-coherent module on an algebraic stack whose sections over affine objects are
finitely presented is of finite presentation on the étale site.**  This is the converse of
`AlgebraicGeometry.FibredSite.finitePresentation_obj_of_isFinitePresentationOnSite`, read on the
associated étale site. -/
theorem isFinitePresentationOnSite_restrictSiteModules_etale
    (𝒴 : Stack.AlgebraicStacks.{u, w} B S hS) (F : Stack.fppfModules B S hS 𝒴)
    (hF : F.IsQuasicoherentOnSite)
    (hfp : ∀ y, IsAffine ((BigFppfOver.toScheme B S hS).obj (𝒴.val.val.p.obj y)) →
      Module.FinitePresentation ((ringStructureSheafCore B S hS 𝒴.val.val.p
        𝒴.val.isFiberedInGroupoids .fppf).obj.obj (op y)) (F.val.obj (op y))) :
    (restrictSiteModules B S hS 𝒴.val.val.p 𝒴.val.isFiberedInGroupoids .etale
      F).IsFinitePresentationOnSite :=
  isFinitePresentationOnSite_restrictSiteModules_etale_of_isFiberedInGroupoids B S hS _ _ F hF
    hfp

end AlgebraicGeometry.FibredSite

end
