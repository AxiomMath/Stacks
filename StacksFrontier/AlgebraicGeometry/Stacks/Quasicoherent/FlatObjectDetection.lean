module

public import StacksFrontier.AlgebraicGeometry.Stacks.AffineCoveringFamily
public import StacksFrontier.AlgebraicGeometry.Stacks.SubsiteLocalFactorizations
public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.AffineSectionExtension

/-!
# Quasi-coherent modules on an algebraic stack are detected on flat objects

Let `𝒳` be an algebraic stack over `S`. An object `x` of `𝒳` is *flat* when the 1-morphism
`x : U → 𝒳` it names out of the scheme it lies over is flat (**Stacks 0H14**, the objects of the
flat-fppf site of **Stacks 0787**). This file proves that a morphism out of a quasi-coherent
module on the fppf site of `𝒳` is determined by what it does on the sections over flat objects,
and that a morphism between quasi-coherent modules is an isomorphism as soon as it is bijective
on the sections over every flat object.

These are the two facts behind the source's sentence, in the proof of **Stacks 076X**, that the
pullback `QCoh(𝒪_𝒳) → QCoh(𝒪_U)` along a smooth surjective `U → 𝒳` is *faithful*: a smooth
morphism out of a scheme is a flat object, and what is seen on flat objects is everything.

## Main results

* `AlgebraicGeometry.Stack.affineFlatFactorization_mem`: every object of `𝒳` is covered,
  for the fppf topology, by objects lying over affine schemes which admit a morphism to a flat
  object lying over an affine scheme.
* `AlgebraicGeometry.Stack.hom_ext_of_flatObject`: two morphisms out of a quasi-coherent module
  which agree on the sections over every flat object are equal.
* `AlgebraicGeometry.Stack.isIso_of_flatObject`: a morphism of quasi-coherent modules which is
  bijective on the sections over every flat object is an isomorphism.

## Implementation notes

The proofs rest on two inputs. The first is local: by **Stacks 06XH** every object of `𝒳` is
covered by objects mapping to the flat object named by a smooth atlas
(`AlgebraicGeometry.Stack.FlatFppf.hasLocalFactorizations_inclusion`), and an affine open
covering, lifted cartesianly, refines both ends of such a morphism to objects lying over affine
schemes; the lift of an open immersion into a flat object is flat
(`AlgebraicGeometry.Stack.flatObject_of_flat`). The second is the base change property of a
quasi-coherent module between objects lying over affine schemes, **Descent, Proposition 03DX**,
in the form `AlgebraicGeometry.FibredSite.semilinearMap_ext_of_restriction`: the sections over
`y` are generated by the restrictions of the sections over `x` along any morphism `y ⟶ x`.

## References

* [Stacks Project, Tag 076X](https://stacks.math.columbia.edu/tag/076X)
* [Stacks Project, Tag 0H14](https://stacks.math.columbia.edu/tag/0H14)
* [Stacks Project, Tag 06XH](https://stacks.math.columbia.edu/tag/06XH)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Stack

universe u w

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  (𝒳 : Stack.AlgebraicStacks.{u, w} B S hS)

/-- The presieve on an object `y` of an algebraic stack of the morphisms whose source lies over
an affine scheme and admits a morphism to a flat object lying over an affine scheme. -/
def affineFlatFactorization (y : 𝒳.val.val.obj) : Presieve y := fun Y _ =>
  IsAffineOver B S hS (𝒳.val.val.p.obj Y) ∧
    ∃ x : 𝒳.val.val.obj, flatObject B S hS 𝒳.val x ∧
      IsAffineOver B S hS (𝒳.val.val.p.obj x) ∧ Nonempty (Y ⟶ x)

/-- **Every object of an algebraic stack is covered by affine objects mapping to flat affine
objects.** A smooth atlas covers every object by objects mapping to a flat object
(**Stacks 06XH**); the target is covered by flat affine objects, lifting an affine open covering
of the scheme it lies over; and the source of the pulled back covering is covered by affine
objects in turn. -/
theorem affineFlatFactorization_mem (y : 𝒳.val.val.obj) :
    Sieve.generate (affineFlatFactorization B S hS 𝒳 y) ∈ fppfTopology B S hS 𝒳.val y := by
  refine GrothendieckTopology.transitive _
    (FlatFppf.hasLocalFactorizations_inclusion B S hS 𝒳 y) _ ?_
  rintro Y h ⟨d, ⟨n⟩⟩
  obtain ⟨I, z, g, hcov, haff, hflat⟩ := exists_isAffine_covering_of_object B S hS 𝒳.val d.obj
  refine GrothendieckTopology.transitive _
    (GrothendieckTopology.pullback_stable _ n hcov) _ ?_
  rintro Y' k ⟨Z, a, b, ⟨i⟩, hab⟩
  obtain ⟨I', w, e, hcov', haff', -⟩ := exists_isAffine_covering_of_object B S hS 𝒳.val Y'
  refine GrothendieckTopology.superset_covering _ ?_ hcov'
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨j⟩
  refine ⟨w j, 𝟙 _, e j ≫ k ≫ h, ⟨haff' j, z i,
    flatObject_of_flat B S hS 𝒳 (g i) (hflat i) d.property, haff i, ⟨e j ≫ a⟩⟩, ?_⟩
  simp

section Modules

attribute [local instance] FibredSite.objModule

variable {B S hS 𝒳}

/-- The component of a morphism of sheaves of modules at an object, as a linear map over the ring
of that object. -/
private noncomputable def appLinear
    {T P : SheafOfModules.{u} (FibredSite.ringStructureSheafCore B S hS 𝒳.val.val.p
      𝒳.val.isFiberedInGroupoids .fppf)} (ψ : T ⟶ P) (x : 𝒳.val.val.obj) :
    T.val.obj (op x) →ₗ[FibredSite.objRing B S hS 𝒳.val.val.p x] P.val.obj (op x) :=
  { toFun := fun t => ψ.val.app (op x) t
    map_add' := map_add (ψ.val.app (op x)).hom
    map_smul' := (ψ.val.app (op x)).hom.map_smul }

/-- A section of a sheaf of modules on an algebraic stack is determined by its restrictions to
the affine objects which map to flat affine objects. -/
theorem sections_ext_of_affineFlatFactorization
    {R : Sheaf (fppfTopology B S hS 𝒳.val) RingCat.{u}} (P : SheafOfModules.{u} R)
    {y : 𝒳.val.val.obj} {σ τ : P.val.obj (op y)}
    (h : ∀ ⦃Y : 𝒳.val.val.obj⦄ (f : Y ⟶ y), affineFlatFactorization B S hS 𝒳 y f →
      P.val.map f.op σ = P.val.map f.op τ) : σ = τ := by
  refine (P.isSheaf_sections.isSheafFor _
    (affineFlatFactorization_mem B S hS 𝒳 y)).isSeparatedFor.ext ?_
  rintro Y g ⟨Z, k, f, hf, rfl⟩
  change P.val.map (k ≫ f).op σ = P.val.map (k ≫ f).op τ
  rw [op_comp, P.val.map_comp_apply, P.val.map_comp_apply, h f hf]

/-- **A morphism out of a quasi-coherent module on an algebraic stack is determined on flat
objects.** Two morphisms `T ⟶ P` of sheaves of modules on the fppf site of `𝒳`, with `T`
quasi-coherent, which agree on the sections over every flat object are equal.

Every object is covered by affine objects mapping to flat affine objects
(`AlgebraicGeometry.Stack.affineFlatFactorization_mem`), and over such an affine object the
sections of `T` are spanned by the restrictions of the sections over the flat affine object it
maps to, by Descent, Proposition 03DX
(`AlgebraicGeometry.FibredSite.semilinearMap_ext_of_restriction`). -/
theorem hom_ext_of_flatObject
    {T P : SheafOfModules.{u} (FibredSite.ringStructureSheafCore B S hS 𝒳.val.val.p
      𝒳.val.isFiberedInGroupoids .fppf)} (hT : T.IsQuasicoherentOnSite) {ψ₁ ψ₂ : T ⟶ P}
    (h : ∀ x : 𝒳.val.val.obj, flatObject B S hS 𝒳.val x →
      ψ₁.val.app (op x) = ψ₂.val.app (op x)) : ψ₁ = ψ₂ := by
  refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun y => ?_)
  refine ModuleCat.hom_ext (LinearMap.ext fun σ => ?_)
  refine sections_ext_of_affineFlatFactorization P (fun Y f hf => ?_)
  obtain ⟨hY, x, hx, hxa, ⟨n⟩⟩ := hf
  rw [← PresheafOfModules.naturality_apply, ← PresheafOfModules.naturality_apply]
  exact LinearMap.congr_fun (FibredSite.semilinearMap_ext_of_restriction T hT n hxa hY
    (θ₁ := appLinear ψ₁ Y) (θ₂ := appLinear ψ₂ Y) fun s => by
      change ψ₁.val.app (op Y) (T.val.map n.op s) = ψ₂.val.app (op Y) (T.val.map n.op s)
      rw [PresheafOfModules.naturality_apply, PresheafOfModules.naturality_apply, h x hx]) _

/-- **Bijectivity spreads from a flat affine object to the affine objects mapping to it.** For a
morphism `ψ : T ⟶ P` of quasi-coherent modules and a morphism `n : Y ⟶ x` between objects lying
over affine schemes, if `ψ` is bijective on the sections over `x` then it is bijective on the
sections over `Y`: by Descent, Proposition 03DX, the sections over `Y` are the base change of the
sections over `x`, for both modules, compatibly with `ψ`. -/
theorem bijective_app_of_bijective_app
    {T P : SheafOfModules.{u} (FibredSite.ringStructureSheafCore B S hS 𝒳.val.val.p
      𝒳.val.isFiberedInGroupoids .fppf)} (hT : T.IsQuasicoherentOnSite)
    (hP : P.IsQuasicoherentOnSite) (ψ : T ⟶ P) {x Y : 𝒳.val.val.obj} (n : Y ⟶ x)
    (hx : IsAffineOver B S hS (𝒳.val.val.p.obj x)) (hY : IsAffineOver B S hS (𝒳.val.val.p.obj Y))
    (hψ : Function.Bijective (ψ.val.app (op x))) :
    Function.Bijective (ψ.val.app (op Y)) := by
  let A := FibredSite.objRing B S hS 𝒳.val.val.p x
  let A' := FibredSite.objRing B S hS 𝒳.val.val.p Y
  let := FibredSite.objAlgebra B S hS 𝒳.val.val.p n
  let : Module A (T.val.obj (op Y)) := Module.compHom _ (algebraMap A A')
  let : Module A (P.val.obj (op Y)) := Module.compHom _ (algebraMap A A')
  have : IsScalarTower A A' (T.val.obj (op Y)) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have : IsScalarTower A A' (P.val.obj (op Y)) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let eT := LinearEquiv.ofBijective _ (FibredSite.bijective_liftBaseChange_of_eq_restriction T hT
    n hx hY (FibredSite.restrictionLinear T n) (fun _ => rfl))
  let eP := LinearEquiv.ofBijective _ (FibredSite.bijective_liftBaseChange_of_eq_restriction P hP
    n hx hY (FibredSite.restrictionLinear P n) (fun _ => rfl))
  let ex : T.val.obj (op x) ≃ₗ[A] P.val.obj (op x) := LinearEquiv.ofBijective
    (appLinear ψ x) hψ
  let ψY := appLinear ψ Y
  have key : ψY.comp eT.toLinearMap =
      eP.toLinearMap.comp (ex.baseChange A A' _ _).toLinearMap := by
    refine TensorProduct.AlgebraTensorModule.ext fun c t => ?_
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe]
    exact (map_smul ψY c _).trans (congrArg (c • ·)
      (PresheafOfModules.naturality_apply ψ.val n.op t))
  have hbij : Function.Bijective (ψY.comp eT.toLinearMap) := by
    rw [key]
    exact eP.toEquiv.bijective.comp (ex.baseChange A A' _ _).toEquiv.bijective
  exact (Function.Bijective.of_comp_iff _ eT.bijective).1 hbij

/-- **A morphism of quasi-coherent modules on an algebraic stack which is bijective on the
sections over every flat object is bijective on the sections over every object.** -/
theorem bijective_app_of_flatObject
    {T P : SheafOfModules.{u} (FibredSite.ringStructureSheafCore B S hS 𝒳.val.val.p
      𝒳.val.isFiberedInGroupoids .fppf)} (hT : T.IsQuasicoherentOnSite)
    (hP : P.IsQuasicoherentOnSite) (ψ : T ⟶ P)
    (h : ∀ x : 𝒳.val.val.obj, flatObject B S hS 𝒳.val x →
      Function.Bijective (ψ.val.app (op x))) (y : 𝒳.val.val.obj) :
    Function.Bijective (ψ.val.app (op y)) := by
  have hloc : ∀ ⦃z Y : 𝒳.val.val.obj⦄ (f : Y ⟶ z), affineFlatFactorization B S hS 𝒳 z f →
      Function.Bijective (ψ.val.app (op Y)) := by
    rintro z Y f ⟨hY, x, hx, hxa, ⟨n⟩⟩
    exact bijective_app_of_bijective_app hT hP ψ n hxa hY (h x hx)
  have hinj : ∀ z : 𝒳.val.val.obj, Function.Injective (ψ.val.app (op z)) := by
    intro z a b hab
    refine sections_ext_of_affineFlatFactorization T (fun Y f hf => ?_)
    apply (hloc f hf).1
    rw [PresheafOfModules.naturality_apply, PresheafOfModules.naturality_apply, hab]
  refine ⟨hinj y, fun s => ?_⟩
  let R := affineFlatFactorization B S hS 𝒳 y
  have hsh : Presieve.IsSheafFor
      (T.val.presheaf ⋙ CategoryTheory.forget AddCommGrpCat.{u}) R := by
    rw [Presieve.isSheafFor_iff_generate]
    exact T.isSheaf_sections.isSheafFor _ (affineFlatFactorization_mem B S hS 𝒳 y)
  let pre : ∀ ⦃Y : 𝒳.val.val.obj⦄ (f : Y ⟶ y), R f → T.val.obj (op Y) := fun Y f hf =>
    (Equiv.ofBijective _ (hloc f hf)).symm (P.val.map f.op s)
  have ht : ∀ ⦃Y : 𝒳.val.val.obj⦄ (f : Y ⟶ y) (hf : R f),
      ψ.val.app (op Y) (pre f hf) = P.val.map f.op s := fun Y f hf =>
    (Equiv.ofBijective _ (hloc f hf)).apply_symm_apply _
  let t : Presieve.FamilyOfElements
      (T.val.presheaf ⋙ CategoryTheory.forget AddCommGrpCat.{u}) R := fun Y f hf => pre f hf
  have hcompat : t.Compatible := by
    intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
    apply hinj Z
    change ψ.val.app (op Z) (T.val.map g₁.op (pre f₁ hf₁)) =
      ψ.val.app (op Z) (T.val.map g₂.op (pre f₂ hf₂))
    rw [PresheafOfModules.naturality_apply, PresheafOfModules.naturality_apply, ht f₁ hf₁,
      ht f₂ hf₂, ← P.val.map_comp_apply, ← P.val.map_comp_apply, ← op_comp, ← op_comp, hcomm]
  let a : T.val.obj (op y) := hsh.amalgamate t hcompat
  have ha : ∀ ⦃Y : 𝒳.val.val.obj⦄ (f : Y ⟶ y) (hf : R f), T.val.map f.op a = pre f hf :=
    fun Y f hf => hsh.valid_glue hcompat f hf
  refine ⟨a, sections_ext_of_affineFlatFactorization P (fun Y f hf => ?_)⟩
  rw [← PresheafOfModules.naturality_apply, ha f hf, ht f hf]

/-- **A morphism of quasi-coherent modules on an algebraic stack which is bijective on the
sections over every flat object is an isomorphism.** This is the conservativity of restricting
`QCoh(𝒪_𝒳)` to the flat objects; with `AlgebraicGeometry.Stack.hom_ext_of_flatObject` it says
that the flat objects of an algebraic stack see everything about its quasi-coherent modules. -/
theorem isIso_of_flatObject
    {T P : SheafOfModules.{u} (FibredSite.ringStructureSheafCore B S hS 𝒳.val.val.p
      𝒳.val.isFiberedInGroupoids .fppf)} (hT : T.IsQuasicoherentOnSite)
    (hP : P.IsQuasicoherentOnSite) (ψ : T ⟶ P)
    (h : ∀ x : 𝒳.val.val.obj, flatObject B S hS 𝒳.val x →
      Function.Bijective (ψ.val.app (op x))) : IsIso ψ := by
  have : IsIso ((SheafOfModules.forget _ ⋙ PresheafOfModules.toPresheaf _).map ψ) := by
    refine (NatTrans.isIso_iff_isIso_app _).2 fun y => ?_
    rw [ConcreteCategory.isIso_iff_bijective]
    exact bijective_app_of_flatObject hT hP ψ h y.unop
  exact isIso_of_reflects_iso ψ (SheafOfModules.forget _ ⋙ PresheafOfModules.toPresheaf _)

end Modules

end AlgebraicGeometry.Stack

end
