/-!
# The bounded quasi-coherent modules form an essentially small class

Let `𝒳` be an essentially small category fibred in groupoids over the big fppf site of `S`. A
quasi-coherent module on `𝒳` is *bounded* (`AlgebraicGeometry.FibredSite.IsAffineBounded`) when
its sections over the representatives of the affine objects have cardinality at most
`AlgebraicGeometry.FibredSite.affineBound`. This file proves that the bounded quasi-coherent
modules form an essentially small class
(`AlgebraicGeometry.FibredSite.essentiallySmall_isAffineBounded`), the smallness step of the
separator of `QCoh(𝒪_𝒳)` needed by the coherator of Stacks 0778 and Stacks 0781.

## Proof

Every bounded module `G` is a quotient of one fixed sheaf of modules
(`AlgebraicGeometry.FibredSite.exists_epi_boundedUniversalSource`): the coproduct, over the
representative affine objects `X` and the elements of a set of cardinality `affineBound`, of the
free sheaf of modules on the representable presheaf of `X`. The map out of the summand at
`(X, n)` sends the tautological section to the `n`-th element of a surjection onto `G(X)`, so the
map is surjective on the sections over every affine object, every affine object being isomorphic
to a representative, and affine objects cover. Sheaves of modules on an essentially small site
form a well-powered abelian category, in which the quotients of a fixed object form an essentially
small class.

## References

* [Stacks Project, Tag 0778](https://stacks.math.columbia.edu/tag/0778)
* [Stacks Project, Tag 0781](https://stacks.math.columbia.edu/tag/0781)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite Cardinal

universe u

namespace AlgebraicGeometry.FibredSite

open Stack Stack.AffineCategory

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {𝒳 : Type (u + 1)} [Category.{u} 𝒳] [EssentiallySmall.{u} 𝒳] (p : 𝒳 ⥤ BigFppfOver B S hS)
  (hp : p.IsFiberedInGroupoids)

/-- A set of size at most `μ` is the image of `μ.out`, as soon as it is inhabited. -/
theorem exists_surjective_out_of_mk_le {A : Type u} [Nonempty A] {μ : Cardinal.{u}}
    (h : #A ≤ μ) : ∃ σ : μ.out → A, Function.Surjective σ := by
  rw [← Cardinal.mk_out μ, Cardinal.le_def] at h
  obtain ⟨ι⟩ := h
  exact ⟨Function.invFun ι, Function.invFun_surjective ι.injective⟩

section Generator

variable [HasWeakSheafify (BigFppfOver.associatedTopology B S hS p .fppf) AddCommGrpCat.{u}]
  [(BigFppfOver.associatedTopology B S hS p .fppf).WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- The sheaf of modules freely generated by a section over an object `X`: the sheafification
of the free presheaf of modules on the representable presheaf of `X`. -/
abbrev freeYonedaSheaf (X : 𝒳) : SheafOfModules.{u} (ringStructureSheafCore B S hS p hp .fppf) :=
  (PresheafOfModules.sheafification (𝟙 (ringStructureSheafCore B S hS p hp .fppf).obj)).obj
    ((PresheafOfModules.free _).obj (yoneda.obj X))

/-- The tautological section of `freeYonedaSheaf` over `X`. -/
def freeYonedaSheafSection (X : 𝒳) : (freeYonedaSheaf B S hS p hp X).val.obj (op X) :=
  ((PresheafOfModules.sheafificationAdjunction
    (𝟙 (ringStructureSheafCore B S hS p hp .fppf).obj)).unit.app _).app (op X)
    (ModuleCat.freeMk (𝟙 X))

/-- The morphism out of `freeYonedaSheaf` determined by a section. -/
def freeYonedaSheafDesc {G : SheafOfModules.{u} (ringStructureSheafCore B S hS p hp .fppf)}
    {X : 𝒳} (x : G.val.obj (op X)) : freeYonedaSheaf B S hS p hp X ⟶ G :=
  ((PresheafOfModules.sheafificationAdjunction
    (𝟙 (ringStructureSheafCore B S hS p hp .fppf).obj)).homEquiv _ _).symm
    (PresheafOfModules.freeYonedaEquiv.symm x)

omit [EssentiallySmall.{u} 𝒳] in
/-- The morphism `freeYonedaSheafDesc x` sends the tautological section `freeYonedaSheafSection X`
to `x`. -/
theorem freeYonedaSheafDesc_app
    {G : SheafOfModules.{u} (ringStructureSheafCore B S hS p hp .fppf)} {X : 𝒳}
    (x : G.val.obj (op X)) :
    (freeYonedaSheafDesc B S hS p hp x).val.app (op X) (freeYonedaSheafSection B S hS p hp X) =
      x := by
  let adj := PresheafOfModules.sheafificationAdjunction
    (𝟙 (ringStructureSheafCore B S hS p hp .fppf).obj)
  have h := adj.homEquiv_unit _ _ (freeYonedaSheafDesc B S hS p hp x)
  have e : adj.homEquiv _ _ (freeYonedaSheafDesc B S hS p hp x) =
      PresheafOfModules.freeYonedaEquiv.symm x := Equiv.apply_symm_apply _ _
  rw [e] at h
  exact (congrArg (fun φ => φ.app (op X) (ModuleCat.freeMk (𝟙 X))) h).symm.trans
    (PresheafOfModules.freeYonedaEquiv_symm_app _ X x)

end Generator

section Universal

variable [HasWeakSheafify (BigFppfOver.associatedTopology B S hS p .fppf) AddCommGrpCat.{u}]
  [(BigFppfOver.associatedTopology B S hS p .fppf).WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- The universal source of the bounded quasi-coherent modules: a coproduct of `affineBound`
copies of the free sheaf of modules on each representative affine object. -/
abbrev boundedUniversalSource : SheafOfModules.{u} (ringStructureSheafCore B S hS p hp .fppf) :=
  ∐ fun k : (Σ _ : AffineRep B S hS p, (affineBound B S hS p).out) =>
    freeYonedaSheaf B S hS p hp (affineRep B S hS p k.1).unop.obj

/-- **Every bounded quasi-coherent module is a quotient of the universal source.** -/
theorem exists_epi_boundedUniversalSource (G : quasicoherentModules.{u, u + 1, u, u} B S hS p hp)
    (hG : IsAffineBounded B S hS p hp G) :
    ∃ φ : boundedUniversalSource B S hS p hp ⟶ G.obj, Epi φ := by
  have : HasSheafify (BigFppfOver.associatedTopology B S hS p .fppf) AddCommGrpCat.{u} :=
    hasSheafifyEssentiallySmallSite.{_, _, _, _, u} _ _
  choose σ hσ using fun i : AffineRep B S hS p =>
    exists_surjective_out_of_mk_le (hG i)
  let X := fun i : AffineRep B S hS p => (affineRep B S hS p i).unop.obj
  let φ : boundedUniversalSource B S hS p hp ⟶ G.obj :=
    Sigma.desc fun k => freeYonedaSheafDesc B S hS p hp (G := G.obj) (X := X k.1) (σ k.1 k.2)
  refine ⟨φ, SheafOfModules.epi_of_surjective_on_covering_objects
    (fun V => IsAffine ((BigFppfOver.toScheme B S hS).obj (p.obj V))) (fun U T hT =>
      BigFppfOver.associatedTopology_le_fppf B S hS p .etale U
        (mem_etale_of_forall_isAffine B S hS p hp U T hT)) φ fun V hV => ?_⟩
  obtain ⟨i, ⟨e⟩⟩ := exists_affineRep_iso B S hS p (op ⟨V, hV⟩)
  let e' : X i ≅ V := ((Stack.AffineCategory.inclusion B S hS p).mapIso e.unop).symm
  intro x
  obtain ⟨n, hn⟩ := hσ i (G.obj.val.map e'.hom.op x)
  refine ⟨(boundedUniversalSource B S hS p hp).val.map e'.inv.op
    ((Sigma.ι _ ⟨i, n⟩ : _ ⟶ boundedUniversalSource B S hS p hp).val.app (op (X i))
      (freeYonedaSheafSection B S hS p hp (X i))), ?_⟩
  rw [PresheafOfModules.naturality_apply, ← SheafOfModules.comp_val_app_apply, Sigma.ι_desc,
    freeYonedaSheafDesc_app, hn, ← PresheafOfModules.map_comp_apply, ← op_comp, e'.inv_hom_id,
    op_id, PresheafOfModules.map_id_apply]

end Universal

/-- **The bounded quasi-coherent modules form an essentially small class.** Each of them is a
quotient of one fixed sheaf of modules, a coproduct of free sheaves of modules on the
representative affine objects, and the quotients of a fixed object of the abelian category of
sheaves of modules, which is well-powered over an essentially small site, form an essentially
small class; the inclusion of the quasi-coherent modules is fully faithful. -/
theorem essentiallySmall_isAffineBounded :
    ObjectProperty.EssentiallySmall.{u} (IsAffineBounded B S hS p hp) := by
  have := hasWeakSheafify_associated B S hS p
  have := wEqualsLocallyBijective_associated B S hS p
  let := PresheafOfModules.locallySmall_of_essentiallySmall.{u}
    (ringStructureSheafCore B S hS p hp .fppf).obj
  let := locallySmall_of_faithful
    (SheafOfModules.forget (ringStructureSheafCore B S hS p hp .fppf))
  have hwp : WellPowered.{u} (SheafOfModules.{u} (ringStructureSheafCore B S hS p hp .fppf)) :=
    SheafOfModules.wellPowered_of_essentiallySmall _
  have hE := CardinalGenerated.essentiallySmall_epiImages (boundedUniversalSource B S hS p hp)
  refine ObjectProperty.EssentiallySmall.of_functor _ (ObjectProperty.ι _)
    (ObjectProperty.EssentiallySmall.of_le
      (Q := fun M => ∃ f : boundedUniversalSource B S hS p hp ⟶ M, Epi f) ?_) fun Y => ?_
  · rintro Y ⟨G, hG, ⟨e⟩⟩
    obtain ⟨φ, hφ⟩ := exists_epi_boundedUniversalSource B S hS p hp G hG
    exact ⟨φ ≫ e.hom, epi_comp' hφ (IsIso.epi_of_iso e.hom)⟩
  · by_cases h : ∃ G₀, (IsAffineBounded B S hS p hp ⊓
        fun G => Nonempty ((ObjectProperty.ι _).obj G ≅ Y)) G₀
    · obtain ⟨G₀, -, ⟨e₀⟩⟩ := h
      refine ⟨.ofObj (fun _ : PUnit.{u + 1} => G₀), inferInstance, fun G ⟨_, ⟨e⟩⟩ => ?_⟩
      exact ⟨G₀, ObjectProperty.ofObj_apply _ PUnit.unit,
        ⟨(ObjectProperty.fullyFaithfulι _).preimageIso (e ≪≫ e₀.symm)⟩⟩
    · exact ⟨.ofObj (fun e : PEmpty.{u + 1} => e.elim), inferInstance,
        fun G hG => (h ⟨G, hG⟩).elim⟩

end AlgebraicGeometry.FibredSite

end
