-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe w' w v₂ u₂ v u

namespace CategoryTheory.Presheaf

section Glue

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) (Q : C → Prop)
  (P : Cᵒᵖ ⥤ Type w)
  (hQ : ∀ ⦃V : C⦄, Q V → ∀ S : Sieve V, S ∈ J V → Presieve.IsSheafFor P (S : Presieve V))
  (hcov : ∀ X : C, ∃ (I : Type w') (Y : I → C) (g : ∀ i, Y i ⟶ X),
    (∀ i, Q (Y i)) ∧ Sieve.ofArrows Y g ∈ J X ∧
      Presieve.IsSheafFor P (Presieve.ofArrows Y g))

include hQ hcov

/-- **A presheaf satisfying the sheaf condition for every covering sieve of every distinguished
object, and for one covering family by distinguished objects of every object, is separated for
every covering sieve of every object.**  Two sections of the given sieve's family agree after
restriction to a member of the chosen family, because there they are two amalgamations of one
family for a covering sieve of a distinguished object; and the chosen family is separating. -/
theorem isSeparatedFor_of_isSheafFor_objects {X : C} (S : Sieve X) (hS : S ∈ J X) :
    Presieve.IsSeparatedFor P (S : Presieve X) := by
  obtain ⟨I, Y, g, hQY, hcovX, hsh⟩ := hcov X
  intro y t₁ t₂ ht₁ ht₂
  refine hsh.isSeparatedFor.ext ?_
  rintro Z f ⟨i⟩
  refine (hQ (hQY i) (S.pullback (g i)) (J.pullback_stable _ hS)).isSeparatedFor
    (y.pullback (g i)) _ _ ?_ ?_
  · intro V d hd
    simpa [Presieve.FamilyOfElements.pullback, op_comp, Functor.map_comp, types_comp_apply]
      using ht₁ (d ≫ g i) hd
  · intro V d hd
    simpa [Presieve.FamilyOfElements.pullback, op_comp, Functor.map_comp, types_comp_apply]
      using ht₂ (d ≫ g i) hd

/-- **A presheaf satisfying the sheaf condition for every covering sieve of every distinguished
object, and for one covering family by distinguished objects of every object, is a sheaf.**

Over the members of the chosen family of an object the given compatible family has unique
amalgamations, by the hypothesis at the distinguished objects; those amalgamations are a compatible
family for the chosen family, because two of them agree over any object mapping to two members —
there they amalgamate one family for a covering sieve, and separatedness applies — so they glue to
a section over the object.  That section restricts to the given family along an arrow of the
covering sieve because the two agree after restriction to each fibre product of that arrow with a
member of the chosen family, and those fibre products are a covering family. -/
theorem isSheaf_of_isSheafFor_objects [HasPullbacks C] : Presieve.IsSheaf J P := by
  have hmap : ∀ {V W Z : C} (a : V ⟶ W) (b : W ⟶ Z) (s : P.obj (op Z)),
      P.map (a ≫ b).op s = P.map a.op (P.map b.op s) := by
    intro V W Z a b s
    rw [op_comp, Functor.map_comp, types_comp_apply]
  have hsep : ∀ ⦃X : C⦄ (S : Sieve X), S ∈ J X → Presieve.IsSeparatedFor P (S : Presieve X) :=
    fun X S hS => isSeparatedFor_of_isSheafFor_objects J Q P hQ hcov S hS
  intro X S hS
  rw [← Presieve.isSeparatedFor_and_exists_isAmalgamation_iff_isSheafFor]
  refine ⟨hsep S hS, fun y hy => ?_⟩
  have hyeq : ∀ {W : C} (a a' : W ⟶ X) (_ : a = a') (ha : S.arrows a) (ha' : S.arrows a'),
      y a ha = y a' ha' := by
    rintro W a a' rfl ha ha'
    rfl
  obtain ⟨I, Y, g, hQY, hcovX, hsh⟩ := hcov X
  choose t ht using fun i => ((hQ (hQY i) (S.pullback (g i)) (J.pullback_stable _ hS))
    (y.pullback (g i)) (hy.pullback (g i))).exists
  have ht' : ∀ (i : I) {V : C} (b : V ⟶ Y i) (hb : S.arrows (b ≫ g i)),
      P.map b.op (t i) = y (b ≫ g i) hb :=
    fun i _ b hb => ht i b hb
  have hcompat : Presieve.Arrows.Compatible P g t := by
    intro i j Z gi gj hgij
    refine (hsep (S.pullback (gi ≫ g i)) (J.pullback_stable _ hS)).ext ?_
    intro V d hd
    have hdi : S.arrows ((d ≫ gi) ≫ g i) := by
      rw [Category.assoc]
      exact hd
    have hdj : S.arrows ((d ≫ gj) ≫ g j) := by
      rw [Category.assoc, ← hgij]
      exact hd
    calc P.map d.op (P.map gi.op (t i)) = P.map (d ≫ gi).op (t i) := (hmap _ _ _).symm
      _ = y ((d ≫ gi) ≫ g i) hdi := ht' i (d ≫ gi) hdi
      _ = y ((d ≫ gj) ≫ g j) hdj := hyeq _ _ (by rw [Category.assoc, Category.assoc, hgij]) hdi hdj
      _ = P.map (d ≫ gj).op (t j) := (ht' j (d ≫ gj) hdj).symm
      _ = P.map d.op (P.map gj.op (t j)) := hmap _ _ _
  rw [Presieve.isSheafFor_arrows_iff] at hsh
  obtain ⟨T, hT, -⟩ := hsh t hcompat
  refine ⟨T, fun {Z} f hf => ?_⟩
  have hpb : Sieve.ofArrows (fun i => pullback f (g i))
      (fun i => pullback.fst f (g i)) ∈ J Z := by
    refine J.superset_covering ?_ (J.pullback_stable f hcovX)
    intro V d hd
    rw [Sieve.pullback_apply, Sieve.mem_ofArrows_iff] at hd
    obtain ⟨i, b, hb⟩ := hd
    exact (Sieve.mem_ofArrows_iff _ _ _).2 ⟨i, pullback.lift d b hb,
      (pullback.lift_fst d b hb).symm⟩
  refine (Presieve.isSeparatedFor_iff_generate.2 (hsep _ hpb)).ext ?_
  rintro V d ⟨i⟩
  have hcond : pullback.fst f (g i) ≫ f = pullback.snd f (g i) ≫ g i := pullback.condition
  have hs1 : S.arrows (pullback.snd f (g i) ≫ g i) := by
    rw [← hcond]
    exact S.downward_closed hf _
  calc P.map (pullback.fst f (g i)).op (P.map f.op T)
      = P.map (pullback.fst f (g i) ≫ f).op T := (hmap _ _ _).symm
    _ = P.map (pullback.snd f (g i) ≫ g i).op T := by rw [hcond]
    _ = P.map (pullback.snd f (g i)).op (P.map (g i).op T) := hmap _ _ _
    _ = P.map (pullback.snd f (g i)).op (t i) := by rw [hT i]
    _ = y (pullback.snd f (g i) ≫ g i) hs1 := ht' i _ hs1
    _ = y (pullback.fst f (g i) ≫ f) (S.downward_closed hf _) := hyeq _ _ hcond.symm _ _
    _ = P.map (pullback.fst f (g i)).op (y f hf) := hy.to_sieveCompatible f _ hf

omit hQ hcov

/-- **A presheaf with values in an arbitrary category satisfying the sheaf condition for every
covering sieve of every distinguished object, and for one covering family by distinguished objects
of every object, is a sheaf.**  Both hypotheses and the conclusion are tested against each object
of the target category, so this is `CategoryTheory.Presheaf.isSheaf_of_isSheafFor_objects` applied
one object at a time. -/
theorem isSheaf_of_isSheafFor_objects' [HasPullbacks C] {A : Type u₂} [Category.{v₂} A]
    (F : Cᵒᵖ ⥤ A)
    (hQ' : ∀ ⦃V : C⦄, Q V → ∀ S : Sieve V, S ∈ J V → ∀ M : A,
      Presieve.IsSheafFor (F ⋙ coyoneda.obj (op M)) (S : Presieve V))
    (hcov' : ∀ X : C, ∃ (I : Type w') (Y : I → C) (g : ∀ i, Y i ⟶ X),
      (∀ i, Q (Y i)) ∧ Sieve.ofArrows Y g ∈ J X ∧
        ∀ M : A, Presieve.IsSheafFor (F ⋙ coyoneda.obj (op M)) (Presieve.ofArrows Y g)) :
    Presheaf.IsSheaf J F := fun M =>
  isSheaf_of_isSheafFor_objects.{w'} J Q _ (fun _ hV T hT => hQ' hV T hT M) fun X => by
    obtain ⟨I, Y, g, hQY, hcovX, hsh⟩ := hcov' X
    exact ⟨I, Y, g, hQY, hcovX, hsh M⟩

end Glue

/-- The two-element poset `false ≤ true` has fibre products: it is a lattice, in which the fibre
product of two morphisms is the infimum of their sources, the universal property being automatic
because the morphisms between two objects of a poset form a subsingleton. -/
theorem hasPullbacks_bool : HasPullbacks Bool :=
  @hasPullbacks_of_hasLimit_cospan _ _ fun {X Y _} {_ _} =>
    ⟨⟨⟨PullbackCone.mk (W := X ⊓ Y) (homOfLE inf_le_left) (homOfLE inf_le_right)
        (Subsingleton.elim _ _),
      PullbackCone.isLimitAux _
        (fun s => homOfLE (le_inf (leOfHom s.fst) (leOfHom s.snd)))
        (fun _ => Subsingleton.elim _ _) (fun _ => Subsingleton.elim _ _)
        (fun _ _ _ => Subsingleton.elim _ _)⟩⟩⟩

/-- **The sheaf condition for the covering sieves of a distinguished class of objects does not
imply the sheaf condition**, even when the distinguished objects cover every object of the site and
the site has fibre products.  So the hypothesis of
`CategoryTheory.Presheaf.isSheaf_of_isSheafFor_objects` at the objects outside the class cannot be
dropped.

The site is the two-element poset `false ≤ true` with the topology
`CategoryTheory.GrothendieckTopology.ofGenerator (false : Bool)`, whose covering sieves are those
containing every morphism out of `false`, and the distinguished class is `{false}`.  The first
component below is the covering hypothesis: `false` is a covering family of each of the two
objects.  The second is the failure: the only covering sieve of `false` is the maximal one, for
which every presheaf satisfies the sheaf condition, so the hypothesis at the distinguished objects
holds for every presheaf; but the presheaf represented by `false` is not a sheaf, because the
morphism `false ⟶ true` generates a covering sieve of `true` and a section over `false` has no
amalgamation over `true`, there being no morphism `true ⟶ false`.

The site has fibre products by `CategoryTheory.Presheaf.hasPullbacks_bool`, so the implication
fails already for sites satisfying the hypotheses of
`CategoryTheory.Presheaf.isSheaf_of_isSheafFor_objects`; what is missing is exactly the sheaf
condition for one covering family of the object outside the class.

This refutes the implication for an arbitrary site, and so refutes every argument for it that uses
only the topology and the covering class.  It does not transfer to any individual site: a site
with more structure may satisfy the implication for reasons this one has none of. -/
theorem not_isSheaf_of_isSheafFor_objects_eqFalse :
    (∀ X : Bool, ∃ (I : Type) (Y : I → Bool) (g : ∀ i, Y i ⟶ X),
        (∀ i, Y i = false) ∧
          Sieve.ofArrows Y g ∈ GrothendieckTopology.ofGenerator (false : Bool) X) ∧
      ¬ ∀ P : Boolᵒᵖ ⥤ Type,
        (∀ ⦃V : Bool⦄, V = false → ∀ S : Sieve V,
            S ∈ GrothendieckTopology.ofGenerator (false : Bool) V →
            Presieve.IsSheafFor P (S : Presieve V)) →
          Presieve.IsSheaf (GrothendieckTopology.ofGenerator (false : Bool)) P := by
  refine ⟨fun X => ⟨Unit, fun _ => false, fun _ => homOfLE (Bool.false_le X),
    fun _ => rfl, fun f => ?_⟩, fun H => ?_⟩
  · rw [show f = homOfLE (Bool.false_le X) from Subsingleton.elim _ _]
    exact Sieve.le_generate _ _ _ (Presieve.ofArrows.mk ())
  · have hvac : ∀ ⦃V : Bool⦄, V = false → ∀ S : Sieve V,
        S ∈ GrothendieckTopology.ofGenerator (false : Bool) V →
        Presieve.IsSheafFor (yoneda.obj (false : Bool)) (S : Presieve V) := by
      rintro V rfl S hS
      rw [Sieve.id_mem_iff_eq_top.1 (hS (𝟙 (false : Bool)))]
      simpa using Presieve.isSheafFor_top (yoneda.obj (false : Bool)) (X := (false : Bool))
    have hcov : Sieve.generate (Presieve.singleton (homOfLE (Bool.false_le true))) ∈
        GrothendieckTopology.ofGenerator (false : Bool) true := fun f => by
      rw [show f = homOfLE (Bool.false_le true) from Subsingleton.elim _ _]
      exact Sieve.le_generate _ _ _ Presieve.singleton.mk
    have h1 : Presieve.IsSheafFor (yoneda.obj (false : Bool))
        (Presieve.singleton (homOfLE (Bool.false_le true))) :=
      (Presieve.isSheafFor_iff_generate _).2 (H _ hvac _ hcov)
    rw [Presieve.isSheafFor_singleton] at h1
    obtain ⟨y, -⟩ :=
      (h1 (𝟙 (false : Bool)) fun p₁ p₂ _ => by rw [Subsingleton.elim p₁ p₂]).exists
    exact absurd (leOfHom y) (by decide)

end CategoryTheory.Presheaf

namespace AlgebraicGeometry.FibredSite

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {𝒳 : Type v} [Category.{w} 𝒳] (p : 𝒳 ⥤ BigFppfOver B S hS)
  {A : Type u₂} [Category.{v₂} A]

/-- **A presheaf on a slice of the associated fppf site which satisfies the sheaf condition for
every covering sieve of every affine object, and for one covering family by affine objects of every
non-affine object, is a sheaf.**

This is the comparison step with the hypothesis at the non-affine objects isolated.  At an affine
object no second hypothesis is needed: the affine objects carry a covering family of every object
(`AlgebraicGeometry.FibredSite.exists_affine_ofArrows_over`), and over an affine object the sheaf
condition for the sieve that family generates is already assumed.  At a non-affine object the
covering family is the one `hnonaff` supplies.  That hypothesis is not known to follow from
`haff`: `CategoryTheory.Presheaf.not_isSheaf_of_isSheafFor_objects_eqFalse` shows no argument
using only the topology and the class of affine objects can produce it.  Whether it holds here for
reasons particular to the fppf site — affine open covers, fibre products of schemes, faithfully
flat descent — is left open.

The index type of the family in `hnonaff` is `Type (u + 1)` with `u` the universe of the schemes,
not a free universe parameter: it is the universe of the index types
`AlgebraicGeometry.FibredSite.exists_affine_ofArrows_over` produces, which the affine case of the
proof consumes.  `CategoryTheory.Presheaf.isSheaf_of_isSheafFor_objects'` is the same statement at
a free index universe, for a caller who needs one.

The fibre products the gluing argument needs are those of a category fibred in groupoids over the
big fppf category of schemes over `S`, Stacks 06WY. -/
theorem isSheaf_over_of_isSheafFor_affine_of_exists_isSheafFor (hp : p.IsFiberedInGroupoids)
    (x : 𝒳) (F : (Over x)ᵒᵖ ⥤ A)
    (haff : ∀ W : Over x, IsAffineOver B S hS (p.obj W.left) → ∀ T : Sieve W,
      T ∈ ((BigFppfOver.associatedTopology B S hS p .fppf).over x) W →
      ∀ M : A, Presieve.IsSheafFor (F ⋙ coyoneda.obj (op M)) (T : Presieve W))
    (hnonaff : ∀ W : Over x, ¬ IsAffineOver B S hS (p.obj W.left) →
      ∃ (I : Type (u + 1)) (Y : I → Over x) (a : ∀ j, Y j ⟶ W),
        (∀ j, IsAffineOver B S hS (p.obj (Y j).left)) ∧
          Sieve.ofArrows Y a ∈ ((BigFppfOver.associatedTopology B S hS p .fppf).over x) W ∧
            ∀ M : A, Presieve.IsSheafFor (F ⋙ coyoneda.obj (op M)) (Presieve.ofArrows Y a)) :
    Presheaf.IsSheaf ((BigFppfOver.associatedTopology B S hS p .fppf).over x) F := by
  classical
  have := BigFppfOver.hasPullbacks_of_isFiberedInGroupoids B S hS p hp
  refine Presheaf.isSheaf_of_isSheafFor_objects'.{u + 1} _
    (fun W => IsAffineOver B S hS (p.obj W.left)) F haff fun W => ?_
  by_cases hW : IsAffineOver B S hS (p.obj W.left)
  · obtain ⟨I, Y, a, hYaff, hcovW⟩ := exists_affine_ofArrows_over B S hS p hp x W
    exact ⟨I, Y, a, hYaff, hcovW, fun M =>
      (Presieve.isSheafFor_iff_generate _).2 (haff W hW _ hcovW M)⟩
  · exact hnonaff W hW

end AlgebraicGeometry.FibredSite

end
