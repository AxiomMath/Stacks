variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {𝒳 : Type v} [Category.{w} 𝒳] (p : 𝒳 ⥤ BigFppfOver B S hS)

/-- **The sheaf condition for a covering family of affine objects of an affine object of a slice
of the associated fppf site follows from the sheaf condition for the finite covering families of
affine objects whose image in schemes is an fppf covering family**, given separatedness of the
presheaf for the covering sieves of the affine objects.

The separatedness is what makes the reduction go, and without it the reduction is false: the
amalgamation the fppf case produces over the refinement
(`AlgebraicGeometry.FibredSite.exists_finite_affine_fppf_ofArrows_le_over`) restricts correctly
along the arrows of the refinement, which are not the arrows of the given family.  What repairs
that is that the restriction of the amalgamation along a member of the given family, and the
section the family assigns to that member, agree after restriction along every arrow of the
pullback of the refined sieve along that member; that pullback is a covering sieve of an affine
object, and separatedness there identifies the two.  Uniqueness of the amalgamation is
separatedness at the object covered.

The refinement may be taken fppf precisely because refining the *sieve* is allowed here: the
given family is not assumed flat, and indeed a finite covering family of affine objects need not
have a flat member. -/
theorem isSheafFor_affine_of_isSheafFor_fppf (hp : p.IsFiberedInGroupoids) {x : 𝒳}
    (F : (Over x)ᵒᵖ ⥤ Type z)
    (hsep : ∀ Z : Over x, IsAffineOver B S hS (p.obj Z.left) →
      ∀ T : Sieve Z, T ∈ ((BigFppfOver.associatedTopology B S hS p .fppf).over x) Z →
        Presieve.IsSeparatedFor F (T : Presieve Z))
    (W : Over x) (hW : IsAffineOver B S hS (p.obj W.left))
    (hfppf : ∀ (k : ℕ) (Y' : Fin k → Over x) (g' : ∀ j, Y' j ⟶ W),
      (∀ j, IsAffineOver B S hS (p.obj (Y' j).left)) →
      Sieve.ofArrows Y' g' ∈ ((BigFppfOver.associatedTopology B S hS p .fppf).over x) W →
      Presieve.ofArrows (fun j => (BigFppfOver.toScheme B S hS).obj (p.obj (Y' j).left))
          (fun j => (BigFppfOver.toScheme B S hS).map (p.map (g' j).left)) ∈
        Scheme.fppfPrecoverage ((BigFppfOver.toScheme B S hS).obj (p.obj W.left)) →
        Presieve.IsSheafFor F (Presieve.ofArrows Y' g'))
    {ιi : Type*} (Y : ιi → Over x) (g : ∀ i, Y i ⟶ W)
    (hY : ∀ i, IsAffineOver B S hS (p.obj (Y i).left))
    (hcov : Sieve.ofArrows Y g ∈ ((BigFppfOver.associatedTopology B S hS p .fppf).over x) W) :
    Presieve.IsSheafFor F (Presieve.ofArrows Y g) := by
  have mc : ∀ {U V V' : Over x} (α : U ⟶ V) (β : V ⟶ V') (t : F.obj (op V')),
      F.map α.op (F.map β.op t) = F.map (α ≫ β).op t := fun α β t =>
    (Functor.map_comp_apply F β.op α.op t).symm
  obtain ⟨k, Y', g', hY'aff, hmem, hcov', hfp⟩ :=
    exists_finite_affine_fppf_ofArrows_le_over B S hS p hp W.hom hW (Sieve.ofArrows Y g) hcov
  choose σ hh hfac using fun j => (Sieve.mem_ofArrows_iff _ _ _).1 (hmem j)
  rw [Presieve.isSheafFor_arrows_iff]
  intro s hs
  have hs' : Presieve.Arrows.Compatible F g' fun j => F.map (hh j).op (s (σ j)) := by
    intro j₁ j₂ Z₀ k₁ k₂ hk
    have hcc : (k₁ ≫ hh j₁) ≫ g (σ j₁) = (k₂ ≫ hh j₂) ≫ g (σ j₂) := by
      rw [Category.assoc, Category.assoc, ← hfac j₁, ← hfac j₂]; exact hk
    rw [mc k₁ (hh j₁), mc k₂ (hh j₂)]
    exact hs (σ j₁) (σ j₂) Z₀ (k₁ ≫ hh j₁) (k₂ ≫ hh j₂) hcc
  obtain ⟨t, ht, -⟩ := (Presieve.isSheafFor_arrows_iff ..).1
    (hfppf k Y' g' hY'aff hcov' hfp) _ hs'
  have key : ∀ i, F.map (g i).op t = s i := by
    intro i
    refine (hsep (Y i) (hY i) ((Sieve.ofArrows Y' g').pullback (g i))
      (((BigFppfOver.associatedTopology B S hS p .fppf).over x).pullback_stable _ hcov')).ext ?_
    intro Z₀ f hf
    obtain ⟨j, c, hc⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hf
    have hcomp : (c ≫ hh j) ≫ g (σ j) = f ≫ g i := by
      rw [Category.assoc, ← hfac j, ← hc]
    have h1 : F.map f.op (F.map (g i).op t) = F.map (c ≫ hh j).op (s (σ j)) := by
      rw [mc f (g i) t, hc, ← mc c (g' j) t, ht j, mc c (hh j) (s (σ j))]
    rw [h1, hs (σ j) i Z₀ (c ≫ hh j) f hcomp]
  refine ⟨t, key, ?_⟩
  change ∀ t' : F.obj (op W), (∀ i, F.map (g i).op t' = s i) → t' = t
  intro t' ht'
  refine (hsep W hW (Sieve.ofArrows Y g) hcov).ext ?_
  intro Z₀ f hf
  obtain ⟨i, b, hb⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hf
  rw [hb, ← mc b (g i) t', ← mc b (g i) t, ht' i, key i]

section CokernelSheafCondition

variable (hp : p.IsFiberedInGroupoids) {x : 𝒳} {K I : Type y}
  {Q P : SheafOfModules.{max t u} ((ringStructureSheafCore B S hS p hp .fppf).over x)}
  (κ : ∀ _ : K, SheafOfModules.uliftForPresentation.{max v w, w, u, u, t}
    (SheafOfModules.unit ((ringStructureSheafCore B S hS p hp .fppf).over x)) ⟶ Q)
  (ι : ∀ _ : I, SheafOfModules.uliftForPresentation.{max v w, w, u, u, t}
    (SheafOfModules.unit ((ringStructureSheafCore B S hS p hp .fppf).over x)) ⟶ P)
  (hQ : IsColimit (Cofan.mk Q κ)) (hP : IsColimit (Cofan.mk P ι)) (a : Q ⟶ P)

include hp κ ι hQ hP in
/-- **The sheaf condition asked for by
`AlgebraicGeometry.FibredSite.surjective_val_app_of_isSheafFor_affine_of_isColimit` reduces to the
case of a family which is fppf in schemes.**

This is `AlgebraicGeometry.FibredSite.isSheafFor_affine_of_isSheafFor_fppf` for the cokernel of a
presenting morphism computed in presheaves of modules, whose separatedness hypothesis at the
affine objects is discharged by
`AlgebraicGeometry.FibredSite.isSeparatedFor_affine_of_injective_map` from
`AlgebraicGeometry.FibredSite.injective_map_cokernel_of_isAffineOver`.

So the whole of what the cokernel step of a global presentation still asks for is the sheaf
condition for one finite covering family of affine objects whose image in schemes is an fppf
covering family, which is what
`PresheafOfModules.isSheafFor_ofArrows_of_amitsurDiff₀` computes from the Amitsur complex of the
product of the rings of global functions on the members. -/
theorem isSheafFor_cokernel_affine_of_isSheafFor_fppf (W : Over x)
    (hW : IsAffineOver B S hS (p.obj W.left))
    (hfppf : ∀ (k : ℕ) (Y' : Fin k → Over x) (g' : ∀ j, Y' j ⟶ W),
      (∀ j, IsAffineOver B S hS (p.obj (Y' j).left)) →
      Sieve.ofArrows Y' g' ∈ ((BigFppfOver.associatedTopology B S hS p .fppf).over x) W →
      Presieve.ofArrows (fun j => (BigFppfOver.toScheme B S hS).obj (p.obj (Y' j).left))
          (fun j => (BigFppfOver.toScheme B S hS).map (p.map (g' j).left)) ∈
        Scheme.fppfPrecoverage ((BigFppfOver.toScheme B S hS).obj (p.obj W.left)) →
        Presieve.IsSheafFor
          ((cokernel a.val).presheaf ⋙ CategoryTheory.forget AddCommGrpCat.{max t u})
          (Presieve.ofArrows Y' g')) :
    ∀ (k : ℕ) (Y : Fin k → Over x) (g : ∀ i, Y i ⟶ W),
      (∀ i, IsAffineOver B S hS (p.obj (Y i).left)) →
      Sieve.ofArrows Y g ∈ ((BigFppfOver.associatedTopology B S hS p .fppf).over x) W →
        Presieve.IsSheafFor
          ((cokernel a.val).presheaf ⋙ CategoryTheory.forget AddCommGrpCat.{max t u})
          (Presieve.ofArrows Y g) :=
  fun _ Y g hY hcov =>
    isSheafFor_affine_of_isSheafFor_fppf B S hS p hp _
      (fun Z hZ T hT => isSeparatedFor_affine_of_injective_map B S hS p hp _
        (injective_map_cokernel_of_isAffineOver B S hS p hp κ ι hQ hP a) Z hZ T hT)
      W hW hfppf Y g hY hcov

end CokernelSheafCondition

end AlgebraicGeometry.FibredSite

