-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TensorProduct

universe y z v w u t

namespace Module.FaithfullyFlat

/-- **An element whose image in the base change along every factor of a finite product of algebras
vanishes is zero**, provided the product is faithfully flat.  The tensor product commutes with a
finite product (`TensorProduct.piRight`), so the images of `1 ⊗ₜ m` in the base changes along the
factors are the components of its image in the base change along the product; if they all vanish
then so does `1 ⊗ₜ m` there, and faithful flatness of the product gives `m = 0` by
`Module.FaithfullyFlat.one_tmul_eq_zero_iff`.

This is the form in which faithful flatness of a covering *family* is used: no factor need be
faithfully flat on its own. -/
@[sga "1 IV 2.6" "(i)⇒(iv)", sga "1 VIII 1.5" "partial"]
theorem eq_zero_of_forall_one_tmul_eq_zero (A : Type*) [CommRing A] (M : Type*) [AddCommGroup M]
    [Module A M] {ιi : Type*} [Finite ιi] (Bi : ιi → Type*) [∀ i, Ring (Bi i)]
    [∀ i, Algebra A (Bi i)] [Module.FaithfullyFlat A (∀ i, Bi i)] {m : M}
    (hm : ∀ i, (1 : Bi i) ⊗ₜ[A] m = 0) : m = 0 := by
  classical
  have _ := Fintype.ofFinite ιi
  rw [← Module.FaithfullyFlat.one_tmul_eq_zero_iff (A := ∀ i, Bi i) A M m]
  have h1 : TensorProduct.comm A (∀ i, Bi i) M ((1 : ∀ i, Bi i) ⊗ₜ[A] m)
      = m ⊗ₜ[A] (1 : ∀ i, Bi i) := rfl
  have h2 : TensorProduct.piRight A A M Bi (m ⊗ₜ[A] (1 : ∀ i, Bi i)) = 0 := by
    ext i
    simpa using (TensorProduct.comm A (Bi i) M).congr_arg (hm i)
  exact (TensorProduct.comm A (∀ i, Bi i) M).injective
    (by rw [h1, map_zero]; exact (TensorProduct.piRight A A M Bi).injective (by rw [h2, map_zero]))

end Module.FaithfullyFlat

namespace Module.BaseChange

/-- **The base change of a module along a finite product of algebras is the product of its base
changes along the factors**, in the form in which member-wise comparisons of the base changes with
something else are assembled into one comparison for the product.

The identification is `TensorProduct.piRight` conjugated by `TensorProduct.comm`, since the latter
is stated for the product in the right-hand factor and a base change has its algebra on the left;
the hypothesis is that each factor's base change has already been identified with a given group,
and the conclusion identifies the base change along the product with the product of those groups,
carrying a pure tensor to the family of the pure tensors of its components.

Only the additive structures are compared.  The base change along the product is a module over the
product and each factor's base change is a module over that factor, so there is no ring over which
a single linear comparison could be stated; what consumes this is the degree-one term of an
Amitsur complex, where additivity is all that is used. -/
theorem exists_piAddEquiv (A : Type*) [CommRing A] (M : Type*) [AddCommGroup M] [Module A M]
    {ιi : Type*} [Finite ιi] (Bi : ιi → Type*) [∀ i, CommRing (Bi i)]
    [∀ i, Algebra A (Bi i)] (Ni : ιi → Type*) [∀ i, AddCommGroup (Ni i)]
    (e : ∀ i, Bi i ⊗[A] M ≃+ Ni i) :
    ∃ E : (∀ i, Bi i) ⊗[A] M ≃+ (∀ i, Ni i),
      ∀ (b : ∀ i, Bi i) (m : M) (i : ιi), E (b ⊗ₜ[A] m) i = e i (b i ⊗ₜ[A] m) := by
  classical
  have _ := Fintype.ofFinite ιi
  refine ⟨AddEquiv.trans
      ((TensorProduct.comm A (∀ i, Bi i) M).trans (TensorProduct.piRight A A M Bi)).toAddEquiv
      ((AddEquiv.piCongrRight fun i => (TensorProduct.comm A M (Bi i)).toAddEquiv).trans
        (AddEquiv.piCongrRight e)),
    fun b m i => ?_⟩
  change e i (TensorProduct.comm A M (Bi i)
    (TensorProduct.piRight A A M Bi (TensorProduct.comm A (∀ i, Bi i) M
      (b ⊗ₜ[A] m)) i)) = e i (b i ⊗ₜ[A] m)
  rfl

end Module.BaseChange

namespace PresheafOfModules

variable {C : Type u} [Category.{v} C] {R : Cᵒᵖ ⥤ RingCat.{z}}

/-- **Restriction to the members of a finite family is injective on the sections of a presheaf of
modules over an object**, as soon as the sections over the object inject, member by member, into
the sections over that member through a map which takes `1 ⊗ₜ n` to the restriction of `n`, and
the product of the coefficient rings of those base changes is faithfully flat.

A section whose restrictions all vanish has `1 ⊗ₜ n = 0` in each factor, and
`Module.FaithfullyFlat.eq_zero_of_forall_one_tmul_eq_zero` makes it zero.  Only injectivity of
each comparison is used, so the comparisons are taken as maps of additive groups rather than as
equivalences. -/
theorem injective_map_of_forall_injective_baseChange
    {N : PresheafOfModules.{y} R} {T : C} {ιi : Type*} [Finite ιi] {W : ιi → C}
    (g : ∀ i, W i ⟶ T) (A : Type*) [CommRing A] [Module A (N.obj (op T))]
    (Bi : ιi → Type*) [∀ i, CommRing (Bi i)] [∀ i, Algebra A (Bi i)]
    [Module.FaithfullyFlat A (∀ i, Bi i)]
    (e : ∀ i, Bi i ⊗[A] N.obj (op T) →+ N.obj (op (W i)))
    (he : ∀ i, Function.Injective (e i))
    (hone : ∀ (i) (n), e i ((1 : Bi i) ⊗ₜ[A] n) = N.restrictₛₗ (g i).op n) :
    Function.Injective fun n : N.obj (op T) => fun i => N.map (g i).op n := by
  intro n n' hnn'
  refine sub_eq_zero.1
    (Module.FaithfullyFlat.eq_zero_of_forall_one_tmul_eq_zero A _ Bi fun i => he i ?_)
  rw [map_zero, hone i]
  have h : N.restrictₛₗ (g i).op n = N.restrictₛₗ (g i).op n' := congrFun hnn' i
  rw [map_sub, h, sub_self]

/-- **The sheaf condition for a covering family of a presheaf of modules, from degree-zero
exactness of an Amitsur complex.**

The data are a faithfully flat algebra `Sa` over a commutative ring `A` acting on the sections
over the object covered, an identification `eW` of the degree-one term `Sa ⊗[A] N(T)` of the
Amitsur complex with the product of the sections over the members of the family, under which the
pure tensors `1 ⊗ₜ n` are the restrictions of `n`, an injection `eV` of the degree-two term into
the product of the sections over a choice of fibre products of pairs of members, and the equation
identifying the degree-zero Amitsur differential with the difference of the two restrictions to
those fibre products.

Compatibility of a family of sections over the members makes the difference of the two
restrictions vanish, hence the Amitsur differential vanish, so
`Module.Descent.exact_amitsur_degree_zero` exhibits the family as the restriction of a section
over the object covered; and `Module.FaithfullyFlat.one_tmul_eq_zero_iff` makes that section
unique.

No sheaf and no topology occur among the hypotheses: the objects `Pb i j` are an arbitrary family
of objects with a pair of morphisms into the members making the two composites agree, which a
fibre product supplies but which nothing here needs to be one. -/
theorem isSheafFor_ofArrows_of_amitsurDiff₀
    {N : PresheafOfModules.{y} R} {T : C} {ιi : Type*} {W : ιi → C} (g : ∀ i, W i ⟶ T)
    (A Sa : Type*) [CommRing A] [CommRing Sa] [Algebra A Sa] [Module.FaithfullyFlat A Sa]
    [Module A (N.obj (op T))]
    (Pb : ιi → ιi → C) (pr₁ : ∀ i j, Pb i j ⟶ W i) (pr₂ : ∀ i j, Pb i j ⟶ W j)
    (hpr : ∀ i j, pr₁ i j ≫ g i = pr₂ i j ≫ g j)
    (eW : Sa ⊗[A] N.obj (op T) →+ (∀ i, N.obj (op (W i)))) (heW : Function.Bijective eW)
    (heWone : ∀ (n : N.obj (op T)) i, eW ((1 : Sa) ⊗ₜ[A] n) i = N.map (g i).op n)
    (eV : Sa ⊗[A] (Sa ⊗[A] N.obj (op T)) →+ (∀ i j, N.obj (op (Pb i j))))
    (heV : Function.Injective eV)
    (hd₀ : ∀ (c : Sa ⊗[A] N.obj (op T)) i j,
      eV (Module.Descent.amitsurDiff₀ A Sa (N.obj (op T)) c) i j
        = N.restrictₛₗ (pr₁ i j).op (eW c i) - N.restrictₛₗ (pr₂ i j).op (eW c j)) :
    Presieve.IsSheafFor (N.presheaf ⋙ CategoryTheory.forget AddCommGrpCat.{y})
      (Presieve.ofArrows W g) := by
  rw [Presieve.isSheafFor_arrows_iff]
  intro s hs
  obtain ⟨c, hc⟩ := heW.2 s
  have hz : Module.Descent.amitsurDiff₀ A Sa (N.obj (op T)) c = 0 := by
    refine heV (funext fun i => funext fun j => ?_)
    have hcompat : N.restrictₛₗ (pr₁ i j).op (s i) = N.restrictₛₗ (pr₂ i j).op (s j) :=
      hs i j (Pb i j) (pr₁ i j) (pr₂ i j) (hpr i j)
    rw [hd₀ c i j, hc, hcompat, sub_self]
    exact (congrFun (congrFun (map_zero eV) i) j).symm
  obtain ⟨n, hn⟩ := (Module.Descent.exact_amitsur_degree_zero A Sa (N.obj (op T)) c).1 hz
  have hone : (1 : Sa) ⊗ₜ[A] n = c := hn
  have hres : ∀ i, N.map (g i).op n = s i := fun i => by rw [← heWone n i, hone, hc]
  refine ⟨n, hres, ?_⟩
  change ∀ n' : N.obj (op T), (∀ i, N.map (g i).op n' = s i) → n' = n
  intro n' hn'
  refine sub_eq_zero.1 ((Module.FaithfullyFlat.one_tmul_eq_zero_iff (A := Sa) A
    (N.obj (op T)) (n' - n)).1 (heW.1 (funext fun i => ?_)))
  rw [map_zero, heWone (n' - n) i, map_sub, hres i, hn' i]
  exact sub_self _

end PresheafOfModules

namespace AlgebraicGeometry

/-- **The ring of global functions on a fibre product of affine schemes is the tensor product of
the rings of global functions of the two factors over that of the base.**  This is Mathlib's
`AlgebraicGeometry.isPushout_appTop_of_isPullback`, which says that the square of rings of global
functions of a fibre product square of affine schemes is a pushout in `CommRingCat`, read through
`CommRingCat.isPushout_iff_isPushout`, which identifies a pushout square of commutative rings
with the statement that the comparison map out of the tensor product is an isomorphism.

As everywhere here the algebra structures are the consumer's own, identified with the maps of
global functions by hypothesis, so that the conclusion is about the consumer's tensor product. -/
theorem algebra_isPushout_appTop_of_isPullback {X Y Z Pb : Scheme.{u}} [IsAffine X] [IsAffine Y]
    [IsAffine Z] {fst : Pb ⟶ X} {snd : Pb ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z}
    (h : IsPullback fst snd f g)
    [Algebra Γ(Z, ⊤) Γ(X, ⊤)] [Algebra Γ(Z, ⊤) Γ(Y, ⊤)] [Algebra Γ(X, ⊤) Γ(Pb, ⊤)]
    [Algebra Γ(Y, ⊤) Γ(Pb, ⊤)] [Algebra Γ(Z, ⊤) Γ(Pb, ⊤)]
    [IsScalarTower Γ(Z, ⊤) Γ(X, ⊤) Γ(Pb, ⊤)] [IsScalarTower Γ(Z, ⊤) Γ(Y, ⊤) Γ(Pb, ⊤)]
    (hf : algebraMap Γ(Z, ⊤) Γ(X, ⊤) = f.appTop.hom)
    (hg : algebraMap Γ(Z, ⊤) Γ(Y, ⊤) = g.appTop.hom)
    (hfst : algebraMap Γ(X, ⊤) Γ(Pb, ⊤) = fst.appTop.hom)
    (hsnd : algebraMap Γ(Y, ⊤) Γ(Pb, ⊤) = snd.appTop.hom) :
    Algebra.IsPushout Γ(Z, ⊤) Γ(X, ⊤) Γ(Y, ⊤) Γ(Pb, ⊤) := by
  refine CommRingCat.isPushout_iff_isPushout.1 ?_
  rw [hf, hg, hfst, hsnd]
  simpa using isPushout_appTop_of_isPullback h

end AlgebraicGeometry

namespace AlgebraicGeometry.FibredSite

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {𝒳 : Type v} [Category.{w} 𝒳] (p : 𝒳 ⥤ BigFppfOver B S hS) (hp : p.IsFiberedInGroupoids)
  {x : 𝒳}

include hp in
/-- **The ring of global functions on a fibre product of affine objects of a slice of the
associated fppf site is the tensor product of the rings of global functions of the two factors over
that of the object they lie over.**

A fibre product square of a slice is carried to a fibre product square of `𝒳` by the projection of
the slice, a cospan being a connected shape; to a fibre product square of the big fppf category by
the structure functor, every morphism of a category fibred in groupoids being strongly cartesian;
and to a fibre product square of schemes by the functor to schemes.  So
`AlgebraicGeometry.algebra_isPushout_appTop_of_isPullback` applies to the underlying schemes.

The square is a hypothesis rather than the fibre product of a chosen pair of morphisms, so that
the statement does not have to assert that the slice has fibre products; a caller holding two
morphisms gets the square from `CategoryTheory.IsPullback.of_hasPullback` together with
`AlgebraicGeometry.BigFppfOver.hasPullbacks_of_isFiberedInGroupoids`, and affineness of the fibre
product from `AlgebraicGeometry.FibredSite.isAffineOver_pullback`.

This is the ring-theoretic description of the double self-products of a covering family which
descent along the family runs through: the degree-two term of the Amitsur complex of the product
of the rings of the members is the product over pairs of these tensor products. -/
@[sga "3 V 4.1" "more general", sga "3 VIB 11.1" "clause (a), special case"]
theorem algebra_isPushout_gamma_of_isPullback {W Y D Pb : Over x} {fst : Pb ⟶ Y} {snd : Pb ⟶ D}
    {f : Y ⟶ W} {g : D ⟶ W} (h : IsPullback fst snd f g)
    (hW : IsAffineOver B S hS (p.obj W.left)) (hY : IsAffineOver B S hS (p.obj Y.left))
    (hD : IsAffineOver B S hS (p.obj D.left))
    [Algebra Γ((BigFppfOver.toScheme B S hS).obj (p.obj W.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj Y.left), ⊤)]
    [Algebra Γ((BigFppfOver.toScheme B S hS).obj (p.obj W.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj D.left), ⊤)]
    [Algebra Γ((BigFppfOver.toScheme B S hS).obj (p.obj Y.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj Pb.left), ⊤)]
    [Algebra Γ((BigFppfOver.toScheme B S hS).obj (p.obj D.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj Pb.left), ⊤)]
    [Algebra Γ((BigFppfOver.toScheme B S hS).obj (p.obj W.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj Pb.left), ⊤)]
    [IsScalarTower Γ((BigFppfOver.toScheme B S hS).obj (p.obj W.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj Y.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj Pb.left), ⊤)]
    [IsScalarTower Γ((BigFppfOver.toScheme B S hS).obj (p.obj W.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj D.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj Pb.left), ⊤)]
    (hf : algebraMap Γ((BigFppfOver.toScheme B S hS).obj (p.obj W.left), ⊤)
        Γ((BigFppfOver.toScheme B S hS).obj (p.obj Y.left), ⊤) =
      ((BigFppfOver.toScheme B S hS).map (p.map f.left)).appTop.hom)
    (hg : algebraMap Γ((BigFppfOver.toScheme B S hS).obj (p.obj W.left), ⊤)
        Γ((BigFppfOver.toScheme B S hS).obj (p.obj D.left), ⊤) =
      ((BigFppfOver.toScheme B S hS).map (p.map g.left)).appTop.hom)
    (hfst : algebraMap Γ((BigFppfOver.toScheme B S hS).obj (p.obj Y.left), ⊤)
        Γ((BigFppfOver.toScheme B S hS).obj (p.obj Pb.left), ⊤) =
      ((BigFppfOver.toScheme B S hS).map (p.map fst.left)).appTop.hom)
    (hsnd : algebraMap Γ((BigFppfOver.toScheme B S hS).obj (p.obj D.left), ⊤)
        Γ((BigFppfOver.toScheme B S hS).obj (p.obj Pb.left), ⊤) =
      ((BigFppfOver.toScheme B S hS).map (p.map snd.left)).appTop.hom) :
    Algebra.IsPushout Γ((BigFppfOver.toScheme B S hS).obj (p.obj W.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj Y.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj D.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj Pb.left), ⊤) := by
  have h1 : IsPullback fst.left snd.left f.left g.left := h.map (Over.forget x)
  have h2 := (Functor.IsFiberedInGroupoids.map_isPullback p hp f.left g.left _ _ h1).map
    (BigFppfOver.toScheme B S hS)
  have _ : IsAffine ((BigFppfOver.toScheme B S hS).obj (p.obj W.left)) := hW
  have _ : IsAffine ((BigFppfOver.toScheme B S hS).obj (p.obj Y.left)) := hY
  have _ : IsAffine ((BigFppfOver.toScheme B S hS).obj (p.obj D.left)) := hD
  exact algebra_isPushout_appTop_of_isPullback h2 hf hg hfst hsnd

variable {K I : Type y}
  {Q P : SheafOfModules.{max t u} ((ringStructureSheafCore B S hS p hp .fppf).over x)}
  {N : PresheafOfModules.{max t u} ((ringStructureSheafCore B S hS p hp .fppf).over x).obj}
  (κ : ∀ _ : K, SheafOfModules.uliftForPresentation.{max v w, w, u, u, t}
    (SheafOfModules.unit ((ringStructureSheafCore B S hS p hp .fppf).over x)) ⟶ Q)
  (ι : ∀ _ : I, SheafOfModules.uliftForPresentation.{max v w, w, u, u, t}
    (SheafOfModules.unit ((ringStructureSheafCore B S hS p hp .fppf).over x)) ⟶ P)
  (hQ : IsColimit (Cofan.mk Q κ)) (hP : IsColimit (Cofan.mk P ι))
  (a : Q ⟶ P) (π : P.val ⟶ N) (hπ : PresheafOfModules.IsPresheafCokernel a.val π)

include hp κ ι hQ hP hπ in
/-- **Restriction to the members of a finite family of affine objects whose image in schemes is an
fppf covering family is injective on the sections of the presheaf cokernel of a presentation over
an affine object.**

Member by member the sections of the presheaf cokernel over a member are the base change of its
sections over the object covered
(`SheafOfModules.exists_baseChangeEquiv_of_isPresheafCokernel`, with the four bases supplied by
`AlgebraicGeometry.FibredSite.tautBasisOfIsAffineOverCoeffs` at the two affine objects); the
product of the rings of global functions on the members is faithfully flat over the ring of
global functions on the object covered
(`AlgebraicGeometry.FibredSite.faithfullyFlat_pi_gamma_of_ofArrows_mem_fppfPrecoverage`); and
`PresheafOfModules.injective_map_of_forall_injective_baseChange` combines the two.

Neither a coproduct of the family inside the site nor the first cohomology of anything occurs:
what replaces the coproduct is the finite product of the rings of global functions. -/
theorem injective_map_of_isPresheafCokernel_of_fppf {ιi : Type*} [Finite ιi]
    (Z : Over x) (hZ : IsAffineOver B S hS (p.obj Z.left)) (Y : ιi → Over x)
    (g : ∀ i, Y i ⟶ Z) (hY : ∀ i, IsAffineOver B S hS (p.obj (Y i).left))
    (hfppf : Presieve.ofArrows (fun i => (BigFppfOver.toScheme B S hS).obj (p.obj (Y i).left))
        (fun i => (BigFppfOver.toScheme B S hS).map (p.map (g i).left)) ∈
      Scheme.fppfPrecoverage ((BigFppfOver.toScheme B S hS).obj (p.obj Z.left))) :
    Function.Injective fun n : N.obj (op Z) => fun i => N.map (g i).op n := by
  let alg : ∀ i, Algebra Γ((BigFppfOver.toScheme B S hS).obj (p.obj Z.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj (Y i).left), ⊤) := fun i =>
    RingHom.toAlgebra ((BigFppfOver.toScheme B S hS).map (p.map (g i).left)).appTop.hom
  have hff : Module.FaithfullyFlat Γ((BigFppfOver.toScheme B S hS).obj (p.obj Z.left), ⊤)
      (∀ i, Γ((BigFppfOver.toScheme B S hS).obj (p.obj (Y i).left), ⊤)) :=
    faithfullyFlat_pi_gamma_of_ofArrows_mem_fppfPrecoverage B S hS p Y g hZ hY hfppf fun _ => rfl
  let mZ : ∀ M : type_of% N,
      Module Γ((BigFppfOver.toScheme B S hS).obj (p.obj Z.left), ⊤) (M.obj (op Z)) := fun M =>
    inferInstanceAs (Module
      (((ringStructureSheafCore B S hS p hp .fppf).over x).obj.obj (op Z)) (M.obj (op Z)))
  let mY : ∀ (M : type_of% N) (i), Module Γ((BigFppfOver.toScheme B S hS).obj (p.obj (Y i).left), ⊤)
      (M.obj (op (Y i))) := fun M i =>
    inferInstanceAs (Module
      (((ringStructureSheafCore B S hS p hp .fppf).over x).obj.obj (op (Y i)))
      (M.obj (op (Y i))))
  let mY' : ∀ (M : type_of% N) (i), Module Γ((BigFppfOver.toScheme B S hS).obj (p.obj Z.left), ⊤)
      (M.obj (op (Y i))) := fun M i =>
    Module.compHom _ (algebraMap Γ((BigFppfOver.toScheme B S hS).obj (p.obj Z.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj (Y i).left), ⊤))
  have tw : ∀ (M : type_of% N) (i),
      IsScalarTower Γ((BigFppfOver.toScheme B S hS).obj (p.obj Z.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj (Y i).left), ⊤) (M.obj (op (Y i))) :=
    fun _ _ => IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let res : ∀ (M : type_of% N) (i),
      M.obj (op Z) →ₗ[Γ((BigFppfOver.toScheme B S hS).obj (p.obj Z.left), ⊤)]
        M.obj (op (Y i)) := fun M i =>
    { toFun := fun q => M.map (g i).op q
      map_add' := map_add (M.map (g i).op).hom
      map_smul' := fun c q => (M.map_smul (g i).op c q).symm ▸ rfl }
  have hall : ∀ i, ∃ e : Γ((BigFppfOver.toScheme B S hS).obj (p.obj (Y i).left), ⊤) ⊗[
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj Z.left), ⊤)] (N.obj (op Z)) ≃ₗ[
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj (Y i).left), ⊤)] (N.obj (op (Y i))),
      ∀ n, e ((1 : Γ((BigFppfOver.toScheme B S hS).obj (p.obj (Y i).left), ⊤)) ⊗ₜ n)
        = N.restrictₛₗ (g i).op n := fun i =>
    SheafOfModules.exists_baseChangeEquiv_of_isPresheafCokernel (N := N) κ ι (g i)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj Z.left), ⊤)
      Γ((BigFppfOver.toScheme B S hS).obj (p.obj (Y i).left), ⊤)
      (tautBasisOfIsAffineOverCoeffs B S hS p hp κ hQ Z hZ
        (sectionRingEquivGamma B S hS p hp .fppf Z) (fun _ _ => rfl))
      (tautBasisOfIsAffineOverCoeffs B S hS p hp κ hQ (Y i) (hY i)
        (sectionRingEquivGamma B S hS p hp .fppf (Y i)) (fun _ _ => rfl))
      (tautBasisOfIsAffineOverCoeffs B S hS p hp ι hP Z hZ
        (sectionRingEquivGamma B S hS p hp .fppf Z) (fun _ _ => rfl))
      (tautBasisOfIsAffineOverCoeffs B S hS p hp ι hP (Y i) (hY i)
        (sectionRingEquivGamma B S hS p hp .fppf (Y i)) (fun _ _ => rfl))
      (fun k => tautBasisOfIsAffineOverCoeffs_apply B S hS p hp κ hQ Z hZ _ _ k)
      (fun k => tautBasisOfIsAffineOverCoeffs_apply B S hS p hp κ hQ (Y i) (hY i) _ _ k)
      (fun j => tautBasisOfIsAffineOverCoeffs_apply B S hS p hp ι hP Z hZ _ _ j)
      (fun j => tautBasisOfIsAffineOverCoeffs_apply B S hS p hp ι hP (Y i) (hY i) _ _ j)
      (res Q.val i)
      (fun _ => rfl)
      (res P.val i)
      (fun _ => rfl)
      (res N i)
      (fun _ => rfl) a π hπ
      (a.val.app (op Z)).hom (fun _ => rfl)
      (π.app (op Z)).hom (fun _ => rfl)
      (a.val.app (op (Y i))).hom (fun _ => rfl)
      (π.app (op (Y i))).hom (fun _ => rfl)
  choose e he using hall
  exact PresheafOfModules.injective_map_of_forall_injective_baseChange g
    Γ((BigFppfOver.toScheme B S hS).obj (p.obj Z.left), ⊤)
    (fun i => Γ((BigFppfOver.toScheme B S hS).obj (p.obj (Y i).left), ⊤))
    (fun i => (e i).toLinearMap.toAddMonoidHom) (fun i => (e i).injective) he

include hp κ ι hQ hP hπ in
/-- **Restriction to the members of a covering family of an affine object is injective on the
sections of the presheaf cokernel of a presentation.**  Neither affineness nor flatness of the
members is assumed.

A covering sieve of an affine object contains a finite family of affine objects whose image in
schemes is an fppf covering family
(`AlgebraicGeometry.FibredSite.exists_finite_affine_fppf_ofArrows_le_over`), for which
`AlgebraicGeometry.FibredSite.injective_map_of_isPresheafCokernel_of_fppf` applies; and every
member of that refinement factors through a member of the given family, so a section whose
restrictions along the given family agree has agreeing restrictions along the refinement.

The refinement has to be taken in this order.  The analogous refinement by affine objects alone
(`AlgebraicGeometry.FibredSite.exists_finite_affine_ofArrows_le_over`) records nothing about
flatness, and a finite affine family inside a covering sieve can have a non-flat member, so its
output cannot be strengthened after the fact. -/
theorem injective_map_of_isPresheafCokernel (Z : Over x)
    (hZ : IsAffineOver B S hS (p.obj Z.left)) {ιi : Type*} (Y : ιi → Over x) (g : ∀ i, Y i ⟶ Z)
    (hcov : Sieve.ofArrows Y g ∈ ((BigFppfOver.associatedTopology B S hS p .fppf).over x) Z) :
    Function.Injective fun n : N.obj (op Z) => fun i => N.map (g i).op n := by
  obtain ⟨k, Y', g', hY'aff, hmem, -, hfppf⟩ :=
    exists_finite_affine_fppf_ofArrows_le_over B S hS p hp Z.hom hZ (Sieve.ofArrows Y g) hcov
  intro s s' hss'
  refine injective_map_of_isPresheafCokernel_of_fppf B S hS p hp κ ι hQ hP a π hπ Z hZ Y' g'
    hY'aff hfppf (funext fun j => ?_)
  obtain ⟨i, hh, hfac⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 (hmem j)
  have key : ∀ n : N.obj (op Z), N.map (g' j).op n = N.map hh.op (N.map (g i).op n) := fun n => by
    rw [hfac]; exact N.map_comp_apply (g i).op hh.op n
  change N.map (g' j).op s = N.map (g' j).op s'
  have h0 : N.map (g i).op s = N.map (g i).op s' := congrFun hss' i
  rw [key s, key s', h0]

include hp κ ι hQ hP in
/-- **Restriction to the members of a finite covering family of affine objects is injective on the
sections, over an affine object, of the cokernel of a presenting morphism computed in presheaves
of modules.**

This is `AlgebraicGeometry.FibredSite.injective_map_of_isPresheafCokernel` for the categorical
cokernel, whose projection has the required property by
`PresheafOfModules.isPresheafCokernel_cokernelπ`.  It is the injectivity hypothesis of
`AlgebraicGeometry.FibredSite.surjective_val_app_of_isSheafFor_affine_of_injective_map` and of
`AlgebraicGeometry.FibredSite.surjective_val_app_of_isSheafFor_affine_of_isColimit`, in the shape
those statements ask for it: no sieve and no topology occurs beyond membership of one covering
family, and affineness of the members, which the refinement supplies for itself, is not used. -/
theorem injective_map_cokernel_of_isAffineOver :
    ∀ Z : Over x, IsAffineOver B S hS (p.obj Z.left) →
      ∀ (k : ℕ) (Y : Fin k → Over x) (g : ∀ i, Y i ⟶ Z),
        (∀ i, IsAffineOver B S hS (p.obj (Y i).left)) →
        Sieve.ofArrows Y g ∈ ((BigFppfOver.associatedTopology B S hS p .fppf).over x) Z →
          Function.Injective fun s : (cokernel a.val).obj (op Z) =>
            fun i => (cokernel a.val).map (g i).op s :=
  fun Z hZ _ Y g _ hcov =>
    injective_map_of_isPresheafCokernel B S hS p hp κ ι hQ hP a (cokernel.π a.val)
      (PresheafOfModules.isPresheafCokernel_cokernelπ a.val) Z hZ Y g hcov

