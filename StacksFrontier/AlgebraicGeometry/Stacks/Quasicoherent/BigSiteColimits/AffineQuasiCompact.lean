@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe w u v uC vC

namespace CategoryTheory.GrothendieckTopology

/-- **The finite subcovering property passes to a slice site.**  A covering sieve of an object
`W` of the slice of a site at `x` is the sieve of a covering sieve of the underlying object
`W.left`, a finite family inside the latter lifts to the slice by equipping each member with the
composite structure morphism, and the sieve generated by the lifted family corresponds to the
sieve generated by the original one. -/
@[sga "4 VI 1.5.1" "partial"]
theorem hasFiniteSubcovering_over {C : Type uC} [Category.{vC} C]
    (J : GrothendieckTopology C) {x : C} (W : Over x)
    (h : J.HasFiniteSubcovering W.left) : (J.over x).HasFiniteSubcovering W := by
  intro S hS
  obtain ⟨n, Z, g, hgS, hcov⟩ := h (Sieve.overEquiv W S) ((J.mem_over_iff S).1 hS)
  refine ⟨n, fun i ↦ Over.mk (g i ≫ W.hom), fun i ↦ Over.homMk (g i), fun i ↦ ?_, ?_⟩
  · exact (Sieve.overEquiv_iff S (g i)).1 (hgS i)
  · rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
    exact hcov

end CategoryTheory.GrothendieckTopology

namespace AlgebraicGeometry

namespace Scheme

/-- **Quasi-compactness cuts an fppf covering family down to a finite subfamily.**  A flat
morphism locally of finite presentation is an open map, so the images of the members of the
family form an open cover of the target; a quasi-compact target is covered by finitely many of
them, and the subfamily they index is again jointly surjective with flat, finitely presented
members. -/
theorem exists_finset_ofArrows_mem_fppfPrecoverage {T : Scheme.{u}} [CompactSpace T]
    {I : Type w} {X : I → Scheme.{u}} {f : ∀ i, X i ⟶ T}
    (hf : Presieve.ofArrows X f ∈ Scheme.fppfPrecoverage T) :
    ∃ s : Finset I, Presieve.ofArrows (fun i : {i // i ∈ s} ↦ X i.1) (fun i ↦ f i.1) ∈
      Scheme.fppfPrecoverage T := by
  rw [Scheme.fppfPrecoverage, Scheme.ofArrows_mem_precoverage_iff] at hf
  obtain ⟨hsurj, hprop⟩ := hf
  have hopen : ∀ i, IsOpen (Set.range (f i)) := fun i ↦ by
    have : Flat (f i) := (hprop i).1
    have : LocallyOfFinitePresentation (f i) := (hprop i).2
    exact (f i).isOpenMap.isOpen_range
  obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover (fun i ↦ Set.range (f i)) hopen
    (fun x _ ↦ by obtain ⟨i, hi⟩ := hsurj x; exact Set.mem_iUnion.2 ⟨i, hi⟩)
  refine ⟨s, ?_⟩
  rw [Scheme.fppfPrecoverage, Scheme.ofArrows_mem_precoverage_iff]
  refine ⟨fun x ↦ ?_, fun i ↦ hprop i.1⟩
  obtain ⟨i, hi, hx⟩ := Set.mem_iUnion₂.1 (hs (Set.mem_univ x))
  exact ⟨⟨i, hi⟩, hx⟩

end Scheme

namespace BigFppfSite

/-- The precoverage of a big fppf site is the precoverage presented by its selected covering
families. -/
theorem precoverage_eq_sitePrecoverage (B : BigFppfSite.{u}) :
    B.precoverage = sitePrecoverage B.IsCovering := rfl

/-- **A selected covering family of a quasi-compact object of a big fppf site has a finite
selected subfamily.**  The selected collection consists of the fppf covering families whose
index type obeys a fixed cardinal bound; a subfamily indexed by a subtype obeys the same bound,
and `AlgebraicGeometry.Scheme.exists_finset_ofArrows_mem_fppfPrecoverage` supplies the fppf
condition. -/
theorem exists_finset_isCovering_restrictIndex (B : BigFppfSite.{u}) {T : B.Schemes}
    (E : PreZeroHypercover.{u + 1} T) (hE : B.IsCovering ⟨T, E⟩)
    [CompactSpace (B.inclusion.obj T)] :
    ∃ s : Finset E.I₀,
      B.IsCovering ⟨T, E.restrictIndex (Subtype.val : {i // i ∈ s} → E.I₀)⟩ := by
  classical
  have hfppf : (E.map B.inclusion).presieve₀ ∈
      Scheme.fppfPrecoverage (B.inclusion.obj T) := by
    have h := hE.1
    rwa [IsFppfCovering, Precoverage.mem_comap_iff, ← PreZeroHypercover.presieve₀_map] at h
  obtain ⟨s, hs⟩ := Scheme.exists_finset_ofArrows_mem_fppfPrecoverage hfppf
  refine ⟨s, ?_, ?_⟩
  · rw [IsFppfCovering, Precoverage.mem_comap_iff, ← PreZeroHypercover.presieve₀_map]
    exact hs
  · exact le_trans (Cardinal.mk_subtype_le _) hE.2

/-- **A quasi-compact object of a big fppf site has the finite subcovering property.**  A
covering sieve contains a selected covering family, that family has a finite selected subfamily,
and the subfamily generates a covering sieve because it is selected. -/
theorem hasFiniteSubcovering (B : BigFppfSite.{u}) (T : B.Schemes)
    [CompactSpace (B.inclusion.obj T)] : B.topology.HasFiniteSubcovering T := by
  classical
  intro S hS
  obtain ⟨E, hE, hES⟩ := B.exists_isCovering_sieve₀_le hS
  obtain ⟨s, hsub⟩ := B.exists_finset_isCovering_restrictIndex E hE
  set σ : Fin s.card → E.I₀ := fun i ↦ ((s.equivFin.symm i : {i // i ∈ s}) : E.I₀) with hσ
  refine ⟨s.card, fun i ↦ E.X (σ i), fun i ↦ E.f (σ i), fun i ↦ ?_, ?_⟩
  · exact hES _ (Sieve.le_generate _ _ _ (Presieve.ofArrows.mk (σ i)))
  · have key : Presieve.ofArrows (fun i ↦ E.X (σ i)) (fun i ↦ E.f (σ i)) =
        (E.restrictIndex (Subtype.val : {i // i ∈ s} → E.I₀)).presieve₀ :=
      PreZeroHypercover.presieve₀_restrictIndex_equiv
        (E := E.restrictIndex (Subtype.val : {i // i ∈ s} → E.I₀)) s.equivFin.symm
    change Sieve.generate (Presieve.ofArrows (fun i ↦ E.X (σ i)) (fun i ↦ E.f (σ i))) ∈ _
    rw [key]
    exact B.precoverage.generate_mem_toGrothendieck ⟨_, rfl, hsub⟩

/-- An object of a big fppf site whose underlying scheme is affine is quasi-compact. -/
theorem compactSpace_of_isAffine (B : BigFppfSite.{u}) (T : B.Schemes)
    (hT : IsAffine (B.inclusion.obj T)) : CompactSpace (B.inclusion.obj T) :=
  have := hT
  inferInstance

/-- **An affine object of a big fppf site has the finite subcovering property.** -/
theorem hasFiniteSubcovering_of_isAffine (B : BigFppfSite.{u}) (T : B.Schemes)
    (hT : IsAffine (B.inclusion.obj T)) : B.topology.HasFiniteSubcovering T :=
  have := B.compactSpace_of_isAffine T hT
  B.hasFiniteSubcovering T

end BigFppfSite

namespace BigFppfOver

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **An affine object of the big fppf site of a scheme has the finite subcovering property.**
Its topology is the localization at `S` of the topology of the big fppf site, so this is
`AlgebraicGeometry.BigFppfSite.hasFiniteSubcovering_of_isAffine` transported along
`CategoryTheory.GrothendieckTopology.hasFiniteSubcovering_over`. -/
theorem hasFiniteSubcovering (T : BigFppfOver B S hS)
    (hT : IsAffine ((toScheme B S hS).obj T)) :
    (topology B S hS).HasFiniteSubcovering T :=
  B.topology.hasFiniteSubcovering_over T (B.hasFiniteSubcovering_of_isAffine T.left hT)

/-- **An affine object of a slice of the big fppf site of a scheme has the finite subcovering
property.**  This is the shape in which the computation of the sections of a coproduct of copies
of the structure sheaf over an affine consumes it: the slice at the object over which a
quasi-coherent module is presented, and in it the object `Over.mk f` attached to a morphism from
an affine. -/
theorem hasFiniteSubcovering_over {U V : BigFppfOver B S hS} (f : V ⟶ U)
    (hV : IsAffine ((toScheme B S hS).obj V)) :
    ((topology B S hS).over U).HasFiniteSubcovering (Over.mk f) :=
  (topology B S hS).hasFiniteSubcovering_over (Over.mk f)
    (hasFiniteSubcovering B S hS V hV)

/-- **An affine object of the site associated with a category fibred in groupoids over the big
fppf category of schemes has the finite subcovering property.**  A covering sieve of the
inherited topology contains an inherited covering family, which is a family of strongly
cartesian morphisms whose images cover downstairs; a finite subfamily of a covering sieve
generated by those images exists because the base object is affine; and each of its members
lifts along the structure functor, because the fibred category is fibred in groupoids, to a
morphism of the fibred category which factors through a member of the original family and is
therefore in the sieve.  The lifted family is finite because the base family is, and it is
again an inherited covering family: its members are strongly cartesian, every morphism of a
category fibred in groupoids being so, and their images generate the same covering sieve. -/
theorem hasFiniteSubcovering_associatedTopology {𝒳 : Type v} [Category.{w} 𝒳]
    (p : 𝒳 ⥤ BigFppfOver B S hS) (hp : p.IsFiberedInGroupoids) (x : 𝒳)
    (hx : IsAffine ((toScheme B S hS).obj (p.obj x))) :
    (associatedTopology B S hS p .fppf).HasFiniteSubcovering x := by
  have hfib : p.IsFibered := hp.isFibered
  intro Sv hSv
  rw [associatedTopology, Functor.inheritedTopology,
    Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition] at hSv
  obtain ⟨R, hR, hRS⟩ := hSv
  have hbase : Sieve.generate (R.map p) ∈ baseOverTopology B S hS .fppf (p.obj x) := hR.2
  obtain ⟨n, Y, h, hhY, hcov⟩ := hasFiniteSubcovering B S hS (p.obj x) hx _ hbase
  have hex : ∀ j, ∃ (wj : 𝒳) (fj : wj ⟶ x) (cj : Y j ⟶ p.obj wj),
      R fj ∧ cj ≫ p.map fj = h j := by
    intro j
    obtain ⟨Z, a, b, hb, hfac⟩ := hhY j
    obtain ⟨hu⟩ := hb
    exact ⟨_, _, a, hu, hfac⟩
  choose wo fo co hRfo hfaco using hex
  choose zo ψ hψ using fun j ↦ hp.exists_lift (co j) (wo j) rfl
  have hdom : ∀ j, p.obj (zo j) = Y j := fun j ↦ by
    have := hψ j; exact IsHomLift.domain_eq p (co j) (ψ j)
  refine ⟨n, zo, fun j ↦ ψ j ≫ fo j, fun j ↦ Sv.downward_closed (hRS _ _ (hRfo j)) _, ?_⟩
  refine Precoverage.generate_mem_toGrothendieck ⟨?_, ?_⟩
  · rintro _ _ ⟨j⟩
    exact hp.isStronglyCartesian _
  · rw [GrothendieckTopology.mem_toPrecoverage_iff, Presieve.map_ofArrows]
    refine (baseOverTopology B S hS .fppf).superset_covering ?_ hcov
    rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
    intro j
    refine (Sieve.mem_ofArrows_iff _ _ _).2 ⟨j, eqToHom (hdom j).symm, ?_⟩
    have := hψ j
    have hfacψ := IsHomLift.fac p (co j) (ψ j)
    rw [p.map_comp, ← Category.assoc, ← hfaco j]
    simpa using congrArg (fun t ↦ t ≫ p.map (fo j)) hfacψ

/-- **An affine object of a slice of the site associated with a category fibred in groupoids over
the big fppf category of schemes has the finite subcovering property.**  This is the shape in
which the computation of the sections of a coproduct of copies of the structure sheaf over an
affine consumes it: the slice at the object over which a quasi-coherent module is presented,
and in it the object `Over.mk f` attached to a morphism from an affine. -/
theorem hasFiniteSubcovering_over_associatedTopology {𝒳 : Type v} [Category.{w} 𝒳]
    (p : 𝒳 ⥤ BigFppfOver B S hS) (hp : p.IsFiberedInGroupoids) {x y : 𝒳} (f : y ⟶ x)
    (hy : IsAffine ((toScheme B S hS).obj (p.obj y))) :
    ((associatedTopology B S hS p .fppf).over x).HasFiniteSubcovering (Over.mk f) :=
  (associatedTopology B S hS p .fppf).hasFiniteSubcovering_over (Over.mk f)
    (hasFiniteSubcovering_associatedTopology B S hS p hp y hy)

end BigFppfOver

end AlgebraicGeometry

end
