module

public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.AffineQuasicoherentDirectImage
public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.FppfModulesDirectImageUnit
public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.PointPullbackExactness

/-!
# The unit `M ⟶ g_{QCoh,*} g^* M` at a point, and transformations of point pullbacks

Let `g : 𝒰 ⟶ 𝒳` be an affine 1-morphism of algebraic stacks, `x` a point of `𝒳` over `Spec R`
and `(x₀, g(x₀) ⟶ x)` a terminal object of `CostructuredArrow g x`.  The pullback to `x` of the
unit `M ⟶ g_{QCoh,*} g^* M`, read through `x^*(g_{QCoh,*} N) ≃ N(x₀)`
(`pointPullbackQuasicoherentDirectImageAddEquiv`), is restriction of sections of `M` along
`g(x₀) ⟶ x`; it is injective when that restriction is faithfully flat on functions.

This is the uniqueness half of step 4 of the proof of Stacks 0GRP: a transformation
`σ : x₁^* ⟶ x₂^*` between point pullbacks is determined by its components on the direct images
`g_{QCoh,*} N`, and, when `𝒰` has a final object over an affine scheme (the stack of an affine
scheme), by its component on `g_{QCoh,*} 𝒪_𝒰` alone, the sections of every quasi-coherent module
over an affine object being generated by the images of maps `𝒪_𝒰 ⟶ N`.

## Main definitions

* `AlgebraicGeometry.Stack.AlgebraicStacks.quasicoherentUnitOfIsAffineHom`: the unit
  `M ⟶ g_{QCoh,*} g^* M` of `g^* ⊣ g_*` for `g` affine, as a map of quasi-coherent modules.

## Main results

* `AlgebraicGeometry.Stack.AlgebraicStacks.pointPullbackQuasicoherentDirectImageAddEquiv_unit`:
  the unit at a point is restriction along the terminal arrow.
* `AlgebraicGeometry.Stack.AlgebraicStacks.natTrans_ext_of_app_quasicoherentDirectImage`: two
  transformations `x₁^* ⟶ x₂^*` agreeing on every `g_{QCoh,*} N` are equal.
* `AlgebraicGeometry.Stack.AlgebraicStacks.iSup_range_unit_map_app_eq_top_of_isTerminal`:
  generation of quasi-coherent modules by `𝒪` on a stack with a final affine object.
* `AlgebraicGeometry.Stack.AlgebraicStacks.natTrans_ext_of_app_quasicoherentDirectImage_unit`:
  two transformations agreeing on `g_{QCoh,*} 𝒪_𝒰` are equal.

## Implementation notes

The unit is not taken from `quasicoherentPullbackDirectImageAdjunction`: identifying that
restricted adjunction's unit with the unit of modules followed by the coherator unit forces the
elaborator to compare coherator maps by unfolding, which does not terminate in reasonable time.
Any map `M ⟶ g_{QCoh,*} N` whose pullback to `x₂` is injective serves for uniqueness, and the
explicit one is used.  The inverse image is spelled `quasicoherentPullbackObj`, whose underlying
module is literally `fppfModulesPullback g M`, for the same reason.

## References

* [Stacks Project, Tag 0GRP](https://stacks.math.columbia.edu/tag/0GRP)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u w

attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

namespace AlgebraicGeometry.Stack.AlgebraicStacks

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  {𝒳 𝒴 : AlgebraicStacks.{u, w} B S hS} (f : 𝒳 ⟶ 𝒴) (hf : IsAffineHom B S hS f)

/-- The inverse image `f^* M` of a quasi-coherent module, as an object of `QCoh(𝒪_𝒳)` whose
underlying module is literally `AlgebraicGeometry.Stack.fppfModulesPullback f M`.  It is
`(quasicoherentPullback f).obj M` by `rfl`; the spelling keeps the comparison with the module-level
statements about `fppfModulesPullback` syntactic, which unification otherwise does by unfolding
the structure sheaves. -/
abbrev quasicoherentPullbackObj (M : quasicoherentModules B S hS 𝒴) :
    quasicoherentModules B S hS 𝒳 :=
  ⟨(fppfModulesPullback B S hS f).obj M.obj, ((quasicoherentPullback B S hS f).obj M).property⟩

/-- The unit `M ⟶ f_* f^* M` of `f^* ⊣ f_*` at a quasi-coherent module `M` on `𝒴`, as a map of
quasi-coherent modules into `f_{QCoh,*} f^* M` for `f` affine. -/
def quasicoherentUnitOfIsAffineHom (M : quasicoherentModules B S hS 𝒴) :
    M ⟶ (quasicoherentDirectImage B S hS f).obj (quasicoherentPullbackObj B S hS f M) :=
  ObjectProperty.homMk (X := M)
      (Y := (affineQuasicoherentDirectImage B S hS f hf).obj (quasicoherentPullbackObj B S hS f M))
      ((fppfModulesPullbackPushforwardAdjunction B S hS f).unit.app M.obj) ≫
    (affineQuasicoherentDirectImageIso B S hS f hf).inv.app
      (quasicoherentPullbackObj B S hS f M)

variable {R : Type u} [CommRing R] {y : 𝒴.val.val.obj}
  (e : (BigFppfOver.toScheme B S hS).obj (𝒴.val.val.p.obj y) ≅ Spec (CommRingCat.of R))
  {t : CostructuredArrow (CatFiberedInGroupoids.homFunctor f.hom) y} (ht : IsTerminal t)

/-- **The unit at a point is restriction along the terminal arrow.** For `f` affine and a
terminal arrow `(x₀, f(x₀) ⟶ y)`, the pullback to `y` of the unit `M ⟶ f_{QCoh,*} f^* M`, read
through `y^*(f_{QCoh,*} N) ≃ N(x₀)`, is restriction of sections of `M` along `f(x₀) ⟶ y`. -/
theorem pointPullbackQuasicoherentDirectImageAddEquiv_unit (M : quasicoherentModules B S hS 𝒴)
    (m : (pointPullback B S hS 𝒴 y e).obj M) :
    pointPullbackQuasicoherentDirectImageAddEquiv B S hS f hf e ht
        (quasicoherentPullbackObj B S hS f M)
        (((pointPullback B S hS 𝒴 y e).map (quasicoherentUnitOfIsAffineHom B S hS f hf M)).hom
          m) =
      (M.obj.val.map t.hom.op).hom m := by
  have hid : (pointPullback B S hS 𝒴 y e).map (quasicoherentUnitOfIsAffineHom B S hS f hf M) ≫
      (pointPullback B S hS 𝒴 y e).map
        ((affineQuasicoherentDirectImageIso B S hS f hf).hom.app
          (quasicoherentPullbackObj B S hS f M)) =
      (pointPullback B S hS 𝒴 y e).map (ObjectProperty.homMk (X := M)
        (Y := (affineQuasicoherentDirectImage B S hS f hf).obj
          (quasicoherentPullbackObj B S hS f M))
        ((fppfModulesPullbackPushforwardAdjunction B S hS f).unit.app M.obj)) := by
    rw [← CategoryTheory.Functor.map_comp, quasicoherentUnitOfIsAffineHom, Category.assoc,
      Iso.inv_hom_id_app, Category.comp_id]
  have h₁ := congrArg (fun g => ((stackModuleDirectImageSectionsIsoOfIsTerminal B S hS f .fppf
    ht).hom.app (quasicoherentPullbackObj B S hS f M).obj).hom (g.hom m)) hid
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at h₁
  show ((stackModuleDirectImageSectionsIsoOfIsTerminal B S hS f .fppf ht).hom.app
      (quasicoherentPullbackObj B S hS f M).obj).hom
      (((pointPullback B S hS 𝒴 y e).map ((affineQuasicoherentDirectImageIso B S hS f
        hf).hom.app (quasicoherentPullbackObj B S hS f M))).hom
        (((pointPullback B S hS 𝒴 y e).map
          (quasicoherentUnitOfIsAffineHom B S hS f hf M)).hom m)) = _
  rw [h₁, stackModuleDirectImageSectionsIsoOfIsTerminal_fppf]
  exact fppfModulesPushforwardSectionsIsoOfIsTerminal_hom_app_unit B S hS f M.obj ht m

include hf ht in
/-- **The pullback to a point of the unit of `f^* ⊣ f_{QCoh,*}` is injective** when the
restriction of functions along the terminal arrow `f(x₀) ⟶ y` is faithfully flat. -/
theorem injective_pointPullback_map_unit
    (hx₀ : IsAffine ((BigFppfOver.toScheme B S hS).obj
      (𝒴.val.val.p.obj ((CatFiberedInGroupoids.homFunctor f.hom).obj t.left))))
    (hflat : ((FibredSite.structureSheaf B S hS 𝒴.val.val.p 𝒴.val.isFiberedInGroupoids
      .fppf).obj.map t.hom.op).hom.FaithfullyFlat)
    (M : quasicoherentModules B S hS 𝒴) :
    Function.Injective ((pointPullback B S hS 𝒴 y e).map
      (quasicoherentUnitOfIsAffineHom B S hS f hf M)).hom := by
  intro a b hab
  have h := congrArg (pointPullbackQuasicoherentDirectImageAddEquiv B S hS f hf e ht
    (quasicoherentPullbackObj B S hS f M)) hab
  rw [pointPullbackQuasicoherentDirectImageAddEquiv_unit,
    pointPullbackQuasicoherentDirectImageAddEquiv_unit] at h
  exact FibredSite.injective_map_of_faithfullyFlat B S hS 𝒴.val.val.p 𝒴.val.isFiberedInGroupoids
    M.property t.hom hx₀ (isAffine_point B S hS 𝒴 y e) hflat h

include hf ht in
/-- **A transformation out of a point pullback is determined on direct images along an affine
chart.** Let `f : 𝒳 ⟶ 𝒴` be affine and `y₂` a point of `𝒴` over `Spec R` with a terminal arrow
`(x₀, f(x₀) ⟶ y₂)` along which restriction of functions is faithfully flat. Two transformations
`σ τ : y₁^* ⟶ y₂^*` which agree on every `f_{QCoh,*} N` are equal: the pullback to `y₂` of the
unit `M ⟶ f_{QCoh,*} f^* M` is injective. -/
theorem natTrans_ext_of_app_quasicoherentDirectImage {y₁ : 𝒴.val.val.obj}
    (e₁ : (BigFppfOver.toScheme B S hS).obj (𝒴.val.val.p.obj y₁) ≅ Spec (CommRingCat.of R))
    (hx₀ : IsAffine ((BigFppfOver.toScheme B S hS).obj
      (𝒴.val.val.p.obj ((CatFiberedInGroupoids.homFunctor f.hom).obj t.left))))
    (hflat : ((FibredSite.structureSheaf B S hS 𝒴.val.val.p 𝒴.val.isFiberedInGroupoids
      .fppf).obj.map t.hom.op).hom.FaithfullyFlat)
    {σ τ : pointPullback B S hS 𝒴 y₁ e₁ ⟶ pointPullback B S hS 𝒴 y e}
    (h : ∀ N : quasicoherentModules B S hS 𝒳,
      σ.app ((quasicoherentDirectImage B S hS f).obj N) =
        τ.app ((quasicoherentDirectImage B S hS f).obj N)) : σ = τ := by
  refine NatTrans.ext (funext fun M => ModuleCat.hom_ext (LinearMap.ext fun m => ?_))
  refine injective_pointPullback_map_unit B S hS f hf e ht hx₀ hflat M ?_
  rw [← NatTrans.naturality_apply σ, ← NatTrans.naturality_apply τ,
    h (quasicoherentPullbackObj B S hS f M)]

include hf ht in
/-- **Agreement on `f_{QCoh,*} O` propagates to every `f_{QCoh,*} N` generated by maps from `O`.**
Let `(x₀, f(x₀) ⟶ y₁)` be a terminal arrow and `N` a quasi-coherent module on `𝒳` whose sections
over `x₀` are additively generated by the images of the maps `O ⟶ N`. Two transformations
`σ τ : y₁^* ⟶ y₂^*` which agree on `f_{QCoh,*} O` agree on `f_{QCoh,*} N`: through
`y₁^*(f_{QCoh,*} N) ≃ N(x₀)`, the image of `y₁^*(f_{QCoh,*} h)` for `h : O ⟶ N` is the image of
`h` over `x₀`. -/
theorem natTrans_app_quasicoherentDirectImage_eq_of_iSup_range {y₂ : 𝒴.val.val.obj}
    (e₂ : (BigFppfOver.toScheme B S hS).obj (𝒴.val.val.p.obj y₂) ≅ Spec (CommRingCat.of R))
    {σ τ : pointPullback B S hS 𝒴 y e ⟶ pointPullback B S hS 𝒴 y₂ e₂}
    (O : quasicoherentModules B S hS 𝒳)
    (hO : σ.app ((quasicoherentDirectImage B S hS f).obj O) =
      τ.app ((quasicoherentDirectImage B S hS f).obj O))
    (N : quasicoherentModules B S hS 𝒳)
    (hN : ⨆ h : O ⟶ N, (LinearMap.range (h.hom.val.app (op t.left)).hom).toAddSubgroup = ⊤) :
    σ.app ((quasicoherentDirectImage B S hS f).obj N) =
      τ.app ((quasicoherentDirectImage B S hS f).obj N) := by
  refine ModuleCat.hom_ext (LinearMap.ext fun m => ?_)
  obtain ⟨z, rfl⟩ :=
    (pointPullbackQuasicoherentDirectImageAddEquiv B S hS f hf e ht N).symm.surjective m
  refine AddSubgroup.iSup_induction
    (fun h : O ⟶ N => (LinearMap.range (h.hom.val.app (op t.left)).hom).toAddSubgroup)
    (C := fun z => (σ.app ((quasicoherentDirectImage B S hS f).obj N)).hom
      ((pointPullbackQuasicoherentDirectImageAddEquiv B S hS f hf e ht N).symm z) =
      (τ.app ((quasicoherentDirectImage B S hS f).obj N)).hom
      ((pointPullbackQuasicoherentDirectImageAddEquiv B S hS f hf e ht N).symm z))
    (hN ▸ AddSubgroup.mem_top z) ?_ ?_ ?_
  · intro h z hz
    obtain ⟨c, rfl⟩ := LinearMap.mem_range.1 hz
    have hw : (pointPullbackQuasicoherentDirectImageAddEquiv B S hS f hf e ht N).symm
        ((h.hom.val.app (op t.left)).hom c) = ((pointPullback B S hS 𝒴 y e).map
          ((quasicoherentDirectImage B S hS f).map h)).hom
          ((pointPullbackQuasicoherentDirectImageAddEquiv B S hS f hf e ht O).symm c) := by
      rw [AddEquiv.symm_apply_eq, pointPullbackQuasicoherentDirectImageAddEquiv_naturality,
        AddEquiv.apply_symm_apply]
    rw [hw, NatTrans.naturality_apply σ, NatTrans.naturality_apply τ, hO]
  · simp only [map_zero]
  · intro z₁ z₂ h₁ h₂
    simp only [map_add, h₁, h₂]

section Generation

variable (𝒰 : AlgebraicStacks.{u, w} B S hS) {u₀ : 𝒰.val.val.obj} (hu₀ : IsTerminal u₀)
  (hu₀a : IsAffine ((BigFppfOver.toScheme B S hS).obj (𝒰.val.val.p.obj u₀)))

include hu₀ in
/-- A section `m` over the final object `u₀` is the image of `1` under some map `𝒪 ⟶ N`, up to
restriction to `x`. -/
private theorem exists_unit_hom_app_one_eq_map_of_isTerminal {x : 𝒰.val.val.obj}
    (N : quasicoherentModules B S hS 𝒰) (m : N.obj.val.obj (op u₀)) :
    ∃ h : (⟨SheafOfModules.unit _, SheafOfModules.isQuasicoherentOnSite_unit _⟩ :
        quasicoherentModules B S hS 𝒰) ⟶ N,
      (h.hom.val.app (op x)).hom (1 : (FibredSite.ringStructureSheafCore B S hS 𝒰.val.val.p
        𝒰.val.isFiberedInGroupoids .fppf).obj.obj (op x)) =
        N.obj.val.map (hu₀.from x).op m := by
  let s : N.obj.val.sections := PresheafOfModules.sectionsMk
    (fun X => N.obj.val.map (hu₀.from X.unop).op m) (fun X Y g => by
      rw [← PresheafOfModules.map_comp_apply]
      exact congrArg (fun a : op u₀ ⟶ Y => (N.obj.val.map a).hom m)
        (show (hu₀.from X.unop).op ≫ g = (hu₀.from Y.unop).op from
          Quiver.Hom.unop_inj (hu₀.hom_ext _ _)))
  exact ⟨ObjectProperty.homMk (N.obj.unitHomEquiv.symm s),
    (N.obj.unitHomEquiv_apply_coe _ (op x)).symm.trans
      (congrArg (fun s' : N.obj.val.sections => s'.val (op x))
        (N.obj.unitHomEquiv.apply_symm_apply s))⟩

include hu₀ hu₀a in
/-- **On an algebraic stack with a final object over an affine scheme, the sections of a
quasi-coherent module over an affine object are generated by the images of maps from `𝒪`.** A
section `m` over the final object `u₀` is a global section, the image of `1` under a map
`𝒪 ⟶ N`, and `N(x) = Γ(x) ⊗_{Γ(u₀)} N(u₀)` for `x` over an affine scheme, `N` being cartesian
between affine objects. -/
theorem iSup_range_unit_map_app_eq_top_of_isTerminal {x : 𝒰.val.val.obj}
    (hx : IsAffine ((BigFppfOver.toScheme B S hS).obj (𝒰.val.val.p.obj x)))
    (N : quasicoherentModules B S hS 𝒰) :
    ⨆ h : (⟨SheafOfModules.unit _, SheafOfModules.isQuasicoherentOnSite_unit _⟩ :
        quasicoherentModules B S hS 𝒰) ⟶ N,
      (LinearMap.range (h.hom.val.app (op x)).hom).toAddSubgroup = ⊤ := by
  let 𝒪 := (FibredSite.ringStructureSheafCore B S hS 𝒰.val.val.p 𝒰.val.isFiberedInGroupoids
    .fppf).obj
  let k : x ⟶ u₀ := hu₀.from x
  have hβ := FibredSite.isIso_restrictionBaseChange_of_isQuasicoherentOnSite N.obj N.property k
    hx hu₀a
  let P := ⨆ h : (⟨SheafOfModules.unit _, SheafOfModules.isQuasicoherentOnSite_unit _⟩ :
      quasicoherentModules B S hS 𝒰) ⟶ N, (LinearMap.range (h.hom.val.app (op x)).hom).toAddSubgroup
  let β := Stacks.PresheafOfModules.restrictionBaseChange.{u + 1, u, u, u}
    (R := (FibredSite.structureSheaf B S hS 𝒰.val.val.p 𝒰.val.isFiberedInGroupoids .fppf).obj)
    N.obj.val k.op
  have hQ : ∀ T, β.hom T ∈ P := fun T => by
    induction T using TensorProduct.induction_on with
    | zero => exact (congrArg (· ∈ P) (map_zero β.hom)).mpr (zero_mem P)
    | tmul c m =>
      obtain ⟨h, hh⟩ :=
        exists_unit_hom_app_one_eq_map_of_isTerminal B S hS 𝒰 hu₀ (x := x) N m
      have key : β.hom (c ⊗ₜ m) = (h.hom.val.app (op x)).hom c := by
        refine (Stacks.PresheafOfModules.restrictionBaseChange_tmul.{u + 1, u, u, u}
          (R := (FibredSite.structureSheaf B S hS 𝒰.val.val.p 𝒰.val.isFiberedInGroupoids
            .fppf).obj) N.obj.val k.op c m).trans ?_
        refine Eq.trans ?_ (congrArg (h.hom.val.app (op x)).hom
          (mul_one (show ↑(𝒪.obj (op x)) from c)))
        refine Eq.trans ?_ ((h.hom.val.app (op x)).hom.map_smul (show ↑(𝒪.obj (op x)) from c)
          (1 : 𝒪.obj (op x))).symm
        exact congrArg (fun z : ↑(N.obj.val.obj (op x)) => (show ↑(𝒪.obj (op x)) from c) • z)
          hh.symm
      rw [key]
      exact AddSubgroup.mem_iSup_of_mem h ⟨c, rfl⟩
    | add a b ha hb =>
      exact (congrArg (· ∈ P) (map_add β.hom a b)).mpr (add_mem ha hb)
  refine eq_top_iff.2 fun n _ => ?_
  obtain ⟨T, rfl⟩ := ((ConcreteCategory.isIso_iff_bijective _).1 hβ).2 n
  exact hQ T

end Generation

include hf ht in
/-- **Transformations between point pullbacks are determined on `f_{QCoh,*} 𝒪`**, for `f` affine
out of an algebraic stack with a final object over an affine scheme (the stack of an affine
scheme). Let `(x₁, f(x₁) ⟶ y₁)` and `(x₂, f(x₂) ⟶ y₂)` be terminal arrows, `x₁` over an affine
scheme and restriction of functions along `f(x₂) ⟶ y₂` faithfully flat. Two transformations
`σ τ : y₁^* ⟶ y₂^*` which agree on `f_{QCoh,*} 𝒪` are equal. -/
theorem natTrans_ext_of_app_quasicoherentDirectImage_unit {u₀ : 𝒳.val.val.obj}
    (hu₀ : IsTerminal u₀)
    (hu₀a : IsAffine ((BigFppfOver.toScheme B S hS).obj (𝒳.val.val.p.obj u₀)))
    {y₁ : 𝒴.val.val.obj}
    (e₁ : (BigFppfOver.toScheme B S hS).obj (𝒴.val.val.p.obj y₁) ≅ Spec (CommRingCat.of R))
    {t₁ : CostructuredArrow (CatFiberedInGroupoids.homFunctor f.hom) y₁} (ht₁ : IsTerminal t₁)
    (hx₁ : IsAffine ((BigFppfOver.toScheme B S hS).obj (𝒳.val.val.p.obj t₁.left)))
    (hx₀ : IsAffine ((BigFppfOver.toScheme B S hS).obj
      (𝒴.val.val.p.obj ((CatFiberedInGroupoids.homFunctor f.hom).obj t.left))))
    (hflat : ((FibredSite.structureSheaf B S hS 𝒴.val.val.p 𝒴.val.isFiberedInGroupoids
      .fppf).obj.map t.hom.op).hom.FaithfullyFlat)
    {σ τ : pointPullback B S hS 𝒴 y₁ e₁ ⟶ pointPullback B S hS 𝒴 y e}
    (hO : σ.app ((quasicoherentDirectImage B S hS f).obj
        ⟨SheafOfModules.unit _, SheafOfModules.isQuasicoherentOnSite_unit _⟩) =
      τ.app ((quasicoherentDirectImage B S hS f).obj
        ⟨SheafOfModules.unit _, SheafOfModules.isQuasicoherentOnSite_unit _⟩)) : σ = τ :=
  natTrans_ext_of_app_quasicoherentDirectImage B S hS f hf e ht e₁ hx₀ hflat fun N =>
    natTrans_app_quasicoherentDirectImage_eq_of_iSup_range B S hS f hf e₁ ht₁ e _ hO N
      (iSup_range_unit_map_app_eq_top_of_isTerminal B S hS 𝒳 hu₀ hu₀a hx₁ N)

end AlgebraicGeometry.Stack.AlgebraicStacks
