module

public import StacksFrontier.AlgebraicGeometry.Spaces.Representable.Bootstrap.Unconditional
import all StacksFrontier.AlgebraicGeometry.Spaces.Groupoids.QuotientStackSquares.IsomorphismSheafAlgebraic

/-!
# Descending algebraicity of a large sheaf along one fppf covering morphism

Let `T` be an object of the big fppf site of `S` and let `P` be a sheaf on the slice over `T`,
with values in an arbitrary universe. Suppose that along one morphism `v : V ⟶ T` of the site
which is surjective, flat and locally of finite presentation the restriction of `P`, read on the
big fppf site of `V`, is — after universe lifts — an algebraic space over `V`. Then `P`, read on
the big fppf site of `T`, is — after universe lifts — an algebraic space over `T`.

This is the globalization step of Stacks 04TB, with nothing of the quotient stack left in it, and
with the bootstrap theorem Stacks 04S6 part (3) — which the descent along `v` consumes through
Stacks 04SK — supplied by the unconditional
`AlgebraicGeometry.Space.isAlgebraicSpace_of_relativelyRepresentable_of_presheaf`. The proof is the
one of `AlgebraicGeometry.Stack.isAlgebraicSpace_isomPresheaf`: the sections of `P` are small,
because they are small over the members of the sieve generated by `v` and smallness spreads from a
covering sieve over an essentially small site; the `Type u` model is the pointwise `Shrink`; its
restriction to `V` is the given algebraic space; and Stacks 04SK descends it along the one-member
covering `{v}`.

A covering sieve can always be refined to one generated by a single such morphism, the members of
a size-bounded refinement being gathered into one object of the site; that refinement, with the
summands recorded as a covering by monomorphisms with empty pairwise intersections, is
`AlgebraicGeometry.Stack.exists_single_cover_of_mem_topology`, extracted from the proof of
`AlgebraicGeometry.Stack.exists_single_cover_presented_pair`.

## Main results

* `AlgebraicGeometry.Stack.exists_single_cover_of_mem_topology`: a covering sieve is refined by a
  disjoint union of its members, whose structure morphism is surjective, flat and locally of
  finite presentation.
* `AlgebraicGeometry.Stack.exists_isAlgebraicSpace_of_single_cover`: the descent of algebraicity
  along one such morphism.

## References

* [Stacks Project, Tag 04SK](https://stacks.math.columbia.edu/tag/04SK)
* [Stacks Project, Tag 04S6](https://stacks.math.columbia.edu/tag/04S6)
* [Stacks Project, Tag 04TB](https://stacks.math.columbia.edu/tag/04TB)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Stack

universe u w

variable (C : BigFppfSite.{u}) (S : Scheme.{u}) (hS : C.Contains S)

/-- **A covering sieve is refined by a disjoint union of its members.** For a covering sieve `R`
of an object `T` of the big fppf site of `S` there are a family `Wᵢ ⟶ T` of members of `R`,
indexed by a type of the working universe, an object `V` of the site which is their coproduct,
with summand inclusions `jᵢ` that are étale monomorphisms with empty pairwise intersections and
jointly surjective, and the induced morphism `f : V ⟶ T`, which is surjective, flat and locally of
finite presentation. -/
theorem exists_single_cover_of_mem_topology {T : BigFppfOver C S hS} {R : Sieve T}
    (hR : R ∈ BigFppfOver.topology C S hS T) :
    ∃ (I : Type u) (Wi : I → BigFppfOver C S hS) (fi : ∀ i, Wi i ⟶ T)
      (V : BigFppfOver C S hS) (j : ∀ i, Wi i ⟶ V) (f : V ⟶ T),
      (∀ i, R.arrows (fi i)) ∧ (∀ i, j i ≫ f = fi i) ∧
      (∀ i, Mono (j i)) ∧ Sieve.ofArrows Wi j ∈ BigFppfOver.topology C S hS V ∧
      (∀ {i k}, i ≠ k → ∀ {Y : BigFppfOver C S hS} (a : Y ⟶ Wi i) (b : Y ⟶ Wi k),
        a ≫ j i = b ≫ j k → ⊥ ∈ BigFppfOver.topology C S hS Y) ∧
      (∀ i, Etale (C.inclusion.map (j i).left)) ∧
      (∀ x : C.inclusion.obj V.left, ∃ i, x ∈ Set.range (C.inclusion.map (j i).left)) ∧
      Flat (C.inclusion.map f.left) ∧ LocallyOfFinitePresentation (C.inclusion.map f.left) ∧
      Surjective (C.inclusion.map f.left) := by
  classical
  obtain ⟨W, hcard, hsize, hmem⟩ := exists_small_fppf_refinement_in_sieve C S hS hR
  have hW i : C.Contains (W.X i) := (hsize i).trans_lt T.left.property
  let wi i : C.obj (hW i) ⟶ T.left := C.inclusion.preimage (W.f i)
  let Wi i : BigFppfOver C S hS := Over.mk (wi i ≫ T.hom)
  let fi i : Wi i ⟶ T := Over.homMk (wi i)
  have hfi i : R (fi i) := (Sieve.overEquiv_iff _ _).mp (hmem i (hW i))
  have hsum : C.Contains (∐ (fun i => (BigFppfOver.toScheme C S hS).obj (Wi i))) :=
    (schemeSize_coproduct_le W.X T.left.obj.size T.left.obj.aleph0_le_size hcard
      hsize).trans_lt T.left.property
  obtain ⟨V, j, ⟨hV⟩, e, he⟩ := exists_coproduct_of_contains C S hS Wi hsum
  obtain ⟨hm, hj, hd⟩ := coproduct_cover C S hS Wi V j e he
  let f : V ⟶ T := Cofan.IsColimit.desc hV fi
  have hfac i : j i ≫ f = fi i := Cofan.IsColimit.fac hV fi i
  have hmap : e.hom ≫ C.inclusion.map f.left = Sigma.desc W.f := by
    refine Sigma.hom_ext _ _ fun i => ?_
    rw [← Category.assoc, he i]
    change C.inclusion.map (j i).left ≫ C.inclusion.map f.left = _
    rw [← C.inclusion.map_comp]
    change C.inclusion.map (j i ≫ f).left = _
    rw [hfac, Sigma.ι_comp_desc]
    exact C.inclusion.map_preimage (X := C.obj (hW i)) (Y := T.left) (W.f i)
  have := W.flat
  have := W.lfp
  have hfFlat : Flat (C.inclusion.map f.left) := by
    have : MorphismProperty.RespectsIso (@Flat.{u}) := Flat.isStableUnderBaseChange.respectsIso
    apply (MorphismProperty.cancel_left_of_respectsIso (@Flat.{u}) e.hom _).mp
    rw [hmap]
    infer_instance
  have hfLfp : LocallyOfFinitePresentation (C.inclusion.map f.left) := by
    have : IsZariskiLocalAtSource (@LocallyOfFinitePresentation.{u}) :=
      HasRingHomProperty.instIsZariskiLocalAtSource (Q := RingHom.FinitePresentation)
    have : MorphismProperty.RespectsIso (@LocallyOfFinitePresentation.{u}) :=
      locallyOfFinitePresentation_isStableUnderBaseChange.respectsIso
    apply (MorphismProperty.cancel_left_of_respectsIso
      (@LocallyOfFinitePresentation.{u}) e.hom _).mp
    rw [hmap]
    exact IsZariskiLocalAtSource.sigmaDesc (P := @LocallyOfFinitePresentation.{u}) W.lfp
  have hfSurj : Surjective (C.inclusion.map f.left) := by
    refine ⟨fun t => ?_⟩
    obtain ⟨i, a, ha⟩ := W.jointly_surjective t
    refine ⟨e.hom ((Sigma.ι W.X i) a), ?_⟩
    exact (congrArg (fun q : W.X i ⟶ T.left.obj => q a)
      (show Sigma.ι W.X i ≫ e.hom ≫ C.inclusion.map f.left = W.f i by
        rw [hmap, Sigma.ι_comp_desc])).trans ha
  have hopen i : Etale (C.inclusion.map (j i).left) := by
    change Etale ((BigFppfOver.toScheme C S hS).map (j i))
    rw [← he i]
    infer_instance
  have hjs (x : C.inclusion.obj V.left) :
      ∃ i, x ∈ Set.range (C.inclusion.map (j i).left) := by
    obtain ⟨y, rfl⟩ := e.hom.homeomorph.surjective x
    obtain ⟨⟨i, a⟩, rfl⟩ :=
      (sigmaMk (fun i => (BigFppfOver.toScheme C S hS).obj (Wi i))).surjective y
    refine ⟨i, a, ?_⟩
    change (BigFppfOver.toScheme C S hS).map (j i) a = _
    rw [← he i, Scheme.Hom.comp_apply, sigmaMk_mk]
    rfl
  exact ⟨W.ι, Wi, fi, V, j, f, hfi, hfac, hm, hj, hd, hopen, hjs, hfFlat, hfLfp, hfSurj⟩

/-- The one-member family given by a surjective, flat, locally finitely presented morphism of the
big fppf site is an fppf covering of the underlying schemes. -/
private theorem singleton_presieve₀_mem_fppfPrecoverage {U V : BigFppfOver C S hS} (v : V ⟶ U)
    (hflat : Flat (C.inclusion.map v.left))
    (hlfp : LocallyOfFinitePresentation (C.inclusion.map v.left))
    (hsurj : Surjective (C.inclusion.map v.left)) :
    ((PreZeroHypercover.singleton v).map (BigFppfOver.toScheme C S hS)).presieve₀ ∈
      Scheme.fppfPrecoverage ((BigFppfOver.toScheme C S hS).obj U) := by
  rw [PreZeroHypercover.presieve₀, Scheme.fppfPrecoverage, Scheme.ofArrows_mem_precoverage_iff]
  refine ⟨fun t => ?_, fun _ => ⟨hflat, hlfp⟩⟩
  obtain ⟨z, hz⟩ := hsurj.surj t
  exact ⟨PUnit.unit, z, hz⟩

set_option synthInstance.maxHeartbeats 400000 in
-- instance search for presheaves and sheaves on slices of the big fppf site is deep
/-- **Descending algebraicity of a large sheaf along one fppf covering morphism.** Let `P` be a
sheaf on the slice of the big fppf site of `S` over `T`, with values in any universe, and let
`v : V ⟶ T` be a morphism of the site which is surjective, flat and locally of finite
presentation. If the restriction of `P` along `v`, read on the big fppf site of `V`, is identified
after universe lifts with an algebraic space `F₀` over `V`, then `P`, read on the big fppf site of
`T`, is identified after universe lifts with an algebraic space over `T`.

This is the globalization step of Stacks 04TB with the quotient stack removed, and with Stacks
04S6 part (3) supplied unconditionally. -/
theorem exists_isAlgebraicSpace_of_single_cover {T : BigFppfOver C S hS}
    (P : (Over T)ᵒᵖ ⥤ Type w)
    (hP : Presheaf.IsSheaf ((BigFppfOver.topology C S hS).over T) P)
    {V : BigFppfOver C S hS} (v : V ⟶ T)
    (hflat : Flat (C.inclusion.map v.left))
    (hlfp : LocallyOfFinitePresentation (C.inclusion.map v.left))
    (hsurj : Surjective (C.inclusion.map v.left))
    (F₀ : (BigFppfOver C V.left.1 V.left.2)ᵒᵖ ⥤ Type u)
    (hF₀ : IsAlgebraicSpace C V.left.1 V.left.2 F₀)
    (e₀ : F₀ ⋙ uliftFunctor.{w, u} ≅
      ((Over.iteratedSliceBackward V).op ⋙ (Over.map v).op ⋙ P) ⋙ uliftFunctor.{u, w}) :
    ∃ F : (BigFppfOver C T.left.1 T.left.2)ᵒᵖ ⥤ Type u,
      IsAlgebraicSpace C T.left.1 T.left.2 F ∧
        Nonempty (F ⋙ uliftFunctor.{w, u} ≅
          ((Over.iteratedSliceBackward T).op ⋙ P) ⋙ uliftFunctor.{u, w}) := by
  classical
  let J := BigFppfOver.topology C S hS
  let I := (Over.iteratedSliceBackward T).op ⋙ P
  let E₁ : PreZeroHypercover.{u + 1} T := PreZeroHypercover.singleton v
  have hR : E₁.sieve₀ ∈ J T :=
    sieve_mem_of_fppf C S hS E₁ (singleton_presieve₀_mem_fppfPrecoverage C S hS v hflat hlfp hsurj)
  have hlocalSmall : ∀ ⦃A⦄ (f : A ⟶ T), E₁.sieve₀ f → Small.{u} (P.obj (op (Over.mk f))) := by
    intro A f hf
    obtain ⟨Z, h, g, hg, rfl⟩ := hf
    obtain ⟨i⟩ := hg
    obtain ⟨⟩ := i
    change A ⟶ V at h
    let a : BigFppfOver C V.left.1 V.left.2 := Over.mk h.left
    let ea : Over.mk (h ≫ v) ≅ (Over.map v).obj ((Over.iteratedSliceBackward V).obj a) :=
      Over.isoMk (Over.isoMk (Iso.refl A.left) (by
        change 𝟙 A.left ≫ h.left ≫ V.hom = A.hom
        rw [Category.id_comp]
        exact Over.w h)) (by
        apply Over.OverMorphism.ext
        change 𝟙 A.left ≫ h.left ≫ v.left = (h ≫ v).left
        simp)
    exact Small.mk' ((P.mapIso ea.op).toEquiv.symm.trans
      (Equiv.ulift.symm.trans ((e₀.app (op a)).toEquiv.symm.trans Equiv.ulift)))
  let R' := (Sieve.overEquiv (Over.mk (𝟙 T))).symm E₁.sieve₀
  have : EssentiallySmall.{u} (BigFppfOver C S hS) := essentiallySmall_bigFppfOver C S hS
  have : EssentiallySmall.{u} (Over T) := essentiallySmall_sliceOver T
  have hR' : R' ∈ (J.over T) (Over.mk (𝟙 T)) :=
    J.overEquiv_symm_mem_over (Over.mk (𝟙 T)) E₁.sieve₀ hR
  have hlocalSmall' : ∀ ⦃A⦄ (f : A ⟶ Over.mk (𝟙 T)), R' f → Small.{u} (P.obj (op A)) := by
    intro A f hf
    have hf' : E₁.sieve₀ f.left := by
      change (Sieve.overEquiv (Over.mk (𝟙 T))).symm E₁.sieve₀ f at hf
      change E₁.sieve₀ ((Over.forget T).map f) at hf
      simpa using hf
    have hA : Over.mk f.left = A := by
      refine CostructuredArrow.obj_ext _ _ rfl ?_
      simpa using (Over.w f).symm
    rw [← hA]
    exact hlocalSmall f.left hf'
  have hsmallI : ∀ U : (BigFppfOver C T.left.1 T.left.2)ᵒᵖ, Small.{u} (I.obj U) := by
    intro U
    exact small_of_locally_small_on_sieve_essentiallySmall hP R' hR' hlocalSmall'
      (Over.mkIdTerminal.from ((Over.iteratedSliceBackward T).obj U.unop))
  let F : (BigFppfOver C T.left.1 T.left.2)ᵒᵖ ⥤ Type u := {
    obj U := Shrink (I.obj U)
    map {U V} f := TypeCat.ofHom
      ((equivShrink (I.obj V)).toFun ∘ I.map f ∘ (equivShrink (I.obj U)).symm)
    map_id U := by
      ext z
      simp [Function.comp_def]
    map_comp f g := by
      ext z
      simp [Function.comp_def] }
  let eF : F ⋙ uliftFunctor.{w, u} ≅ I ⋙ uliftFunctor.{u, w} := NatIso.ofComponents
    (fun U => (Equiv.ulift.trans ((equivShrink (I.obj U)).symm.trans Equiv.ulift.symm)).toIso)
    (by
      intro U V f
      ext z
      change ULift.up ((equivShrink (I.obj V)).symm
        (equivShrink (I.obj V) (I.map f ((equivShrink (I.obj U)).symm z.down)))) = _
      simp only [Equiv.symm_apply_apply]
      rfl)
  let J' := BigFppfOver.topology C T.left.obj T.left.property
  have : (Over.iteratedSliceBackward T).IsContinuous J' (J.over T) := by
    change T.iteratedSliceBackward.IsContinuous (C.topology.over T.left)
      ((C.topology.over (C.obj hS)).over T)
    infer_instance
  have hI : Presheaf.IsSheaf J' I :=
    ((Over.iteratedSliceBackward T).sheafPushforwardContinuous (Type w)
      J' (J.over T)).obj ⟨P, hP⟩ |>.property
  have hFsheaf : Presheaf.IsSheaf J' F := Presheaf.isSheaf_of_isSheaf_comp J' F
    uliftFunctor.{w, u} ((Presheaf.isSheaf_of_iso_iff eF).mpr
      (Presheaf.isSheaf_comp_of_isSheaf J' I uliftFunctor.{u, w} hI))
  refine ⟨F, ?_, ⟨eF⟩⟩
  let eA : F₀ ⋙ uliftFunctor.{w, u} ≅
      ((Over.map v.left).op ⋙ F) ⋙ uliftFunctor.{w, u} :=
    e₀ ≪≫
      Functor.isoWhiskerRight
        (Functor.isoWhiskerRight (NatIso.op (iteratedSliceBackwardMapNatIso v).symm) P)
        uliftFunctor.{u, w} ≪≫
      (Functor.isoWhiskerLeft (Over.map v.left).op eF).symm
  let L := (Functor.whiskeringRight
    (BigFppfOver C V.left.obj V.left.property)ᵒᵖ (Type u) (Type (max u w))).obj
    uliftFunctor.{w, u}
  have hres : IsAlgebraicSpace C V.left.obj V.left.property ((Over.map v.left).op ⋙ F) :=
    Space.isAlgebraicSpace_of_iso C V.left.obj V.left.property (L.preimageIso eA) hF₀
  have hprod : IsAlgebraicSpace C T.left.obj T.left.property
      (yoneda.obj (Over.mk v.left) ⨯ F) :=
    (isAlgebraicSpace_restrict_iff_product C V.left.obj T.left.obj
      V.left.property T.left.property v.left F).mp hres
  let E : PreZeroHypercover.{u + 1} (Over.mk (𝟙 T.left)) :=
    PreZeroHypercover.singleton (Over.homMk v.left : Over.mk v.left ⟶ Over.mk (𝟙 T.left))
  have hE : BigFppfOver.IsCovering C T.left.obj T.left.property
      ⟨Over.mk (𝟙 (C.obj T.left.property)), E⟩ :=
    ⟨isFppfCovering_of_presieve₀_mem C T.left.obj T.left.property E
      (singleton_presieve₀_mem_fppfPrecoverage C T.left.obj T.left.property
        (Over.homMk v.left : Over.mk v.left ⟶ Over.mk (𝟙 T.left)) hflat hlfp hsurj),
      (C.coverings_isSite.1 (𝟙 T.left)).2⟩
  let H : Sheaf J' (Type u) := ⟨yoneda.obj (Over.mk v.left) ⨯ F, hprod.isSheaf⟩
  have hc : IsColimit (Cofan.mk H (fun _ : E.I₀ => 𝟙 H)) :=
    Cofan.IsColimit.mk _ (fun c => c.inj PUnit.unit) (by rintro c ⟨⟩; simp)
      (by rintro c m hm; simpa using hm PUnit.unit)
  exact isAlgebraicSpace_of_isCovering hFsheaf E hE (fun _ => hprod) (fun _ => 𝟙 H) hc hprod

end AlgebraicGeometry.Stack

end
