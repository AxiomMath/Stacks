module

public import StacksFrontier.AlgebraicGeometry.Curves.GenusCurve.BaseChange
public import StacksFrontier.AlgebraicGeometry.HomogeneousAwayMapCriteria.Basic
public import StacksFrontier.AlgebraicGeometry.ProjQuotientChartIdeal.Basic
public import StacksFrontier.AlgebraicGeometry.ProjSaturation.IdealOfClosedSubscheme
public import StacksFrontier.AlgebraicGeometry.Curves.PlaneCurveGenus
public import StacksFrontier.AlgebraicGeometry.Stacks.WeierstrassFamilyProper

/-!
# Global functions and genus of a plane Weierstrass cubic over a field

Let `k` be a field and `E ⊂ P²_k` the plane cubic of a Weierstrass equation over `k`. This file
proves that `H⁰(E, 𝒪_E) = k` and that `E` has genus one, which is what [Stacks, Tag 072S]
asserts about the fibres of the Weierstrass family. No hypothesis on the discriminant is needed.

## Main results

* `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.idealOfClosedSubscheme_embeddingOf`: over
  a field, the homogeneous ideal of the plane cubic `E ⊂ P²_k` is generated by the cubic.
* `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.embeddingOf_projToSpecCoeff`: the
  projection of `E` is its closed immersion into `P²_R` followed by the structure morphism of
  `P²_R`.
* `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass`
  `.finrank_structureSheafCohomology_projectionOf_zero` and
  `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.genus_projectionOf`: over a field,
  `dim_k H⁰(E, 𝒪_E) = 1` and the genus of `E` is `1`.
* `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.finrank_structureSheafCohomology_iso_comp`:
  the dimensions of the cohomology groups of the structure sheaf of a proper scheme over a field
  do not change under precomposition of the structure morphism with an isomorphism.

## Implementation notes

The cohomology of a plane curve is computed in
`StacksFrontier.AlgebraicGeometry.Curves.PlaneCurveGenus` from the long exact sequence of
`0 → 𝒪(-3) → 𝒪 → i_* 𝒪_E → 0`, whose only input about `E` is that its homogeneous ideal is
generated by the cubic `F`; the hypotheses of [Stacks, Tag 0BYB] bundled in
`AlgebraicGeometry.ProjectiveSpectrum.Proj.PlaneCurveData` are only there to produce such an
equation, so the two windows of the sequence are used directly
(`Stacks.ProjectiveSpace.Cohomology.nonempty_structureSheafCohomologyIsoTwistCohomologyZero` and
`Stacks.ProjectiveSpace.Cohomology`
`.finrank_structureSheafCohomology_eq_finrank_twistCohomology_neg`).

That the homogeneous ideal of `E = Proj (k[x, y, z]/(F))` is `(F)` is read off the chart kernels
of the quotient map of `StacksFrontier.AlgebraicGeometry.ProjClosedImmersion.Quotient`, as in
`Stacks.Curves.InseparableGenus.idealOfClosedSubscheme_planeCubicEmbedding`: `F` is an equation
of `E`, and an
equation `b` of `E` has `y ^ k · b ∈ (F)` on the chart `D₊(y)`. Since `y` does not divide `F`
(`F(1, 0, 0) = -1`) and `y` is prime, `F` divides `b`. One coordinate suffices, so no
irreducibility of `F` is used.

## References

* [Stacks Project, Tag 072S](https://stacks.math.columbia.edu/tag/072S)
* [Stacks Project, Tag 0BYD](https://stacks.math.columbia.edu/tag/0BYD)
* [Stacks Project, Tag 0BXK](https://stacks.math.columbia.edu/tag/0BXK)
-/

@[expose] public noncomputable section

open CategoryTheory MvPolynomial
open AlgebraicGeometry.ProjectiveSpectrum.Proj (idealOfClosedSubscheme chartFraction
  mem_idealOfClosedSubscheme chartFraction_mem_ker_app_of_mem_idealOfClosedSubscheme
  mem_idealOfClosedSubscheme_of_forall_chartFraction_mem_ker
  projectiveSpace_ker_eq_zeroScheme_of_idealOfClosedSubscheme_eq_span)
open Stacks.ProjectiveSpace.Cohomology

universe u

namespace AlgebraicGeometry.ModuliEllipticCurves.Weierstrass

attribute [local instance] MvPolynomial.gradedAlgebra

section Invariance

variable (k : Type u) [Field k]

/-- **The dimensions of the cohomology of the structure sheaf are invariant under isomorphism.**
For a proper scheme `p : B ⟶ Spec k` and an isomorphism `e : A ≅ B`, `H^n` of the structure sheaf
of `A` over `e ≫ p` has the same dimension as that of `B` over `p`: the square with `e` on top is
a base change along the identity of `Spec k`. -/
theorem finrank_structureSheafCohomology_iso_comp {A B : Scheme.{u}} (p : B ⟶ Spec (.of k))
    [IsProper p] (e : A ≅ B) (n : ℕ) :
    Module.finrank k (structureSheafCohomology (e.hom ≫ p) n) =
      Module.finrank k (structureSheafCohomology p n) := by
  have h : IsPullback e.hom (e.hom ≫ p) p (Spec.map (CommRingCat.ofHom (algebraMap k k))) := by
    rw [show Spec.map (CommRingCat.ofHom (algebraMap k k)) = 𝟙 (Spec (.of k)) by simp]
    exact IsPullback.of_horiz_isIso ⟨by simp⟩
  calc
    Module.finrank k (structureSheafCohomology (e.hom ≫ p) n)
        = Module.finrank k (cohomologyOverField k (e.hom ≫ p)
            (SheafOfModules.unit A.ringCatSheaf) n) :=
      (structureSheafCohomologyIsoCohomologyOverField k (e.hom ≫ p) n).toLinearEquiv.finrank_eq
    _ = Module.finrank k (cohomologyOverField k (e.hom ≫ p)
          ((Scheme.Modules.pullback e.hom).obj (SheafOfModules.unit B.ringCatSheaf)) n) :=
      (finrank_cohomologyOverField_eq_of_iso k (e.hom ≫ p)
        (Scheme.Modules.pullbackUnitIso e.hom) n).symm
    _ = Module.finrank k (cohomologyOverField k p (SheafOfModules.unit B.ringCatSheaf) n) :=
      finrank_cohomologyOverField_baseChange_field k k e.hom (e.hom ≫ p) p h _ n
    _ = Module.finrank k (structureSheafCohomology p n) :=
      (structureSheafCohomologyIsoCohomologyOverField k p n).toLinearEquiv.finrank_eq.symm

end Invariance

section Ring

variable {R : Type u} [CommRing R] (C : WeierstrassCurve R)

/-- **The chart kernel of the embedding of the plane cubic.** On the standard open `D₊(f)` of a
homogeneous `f` of positive degree, the fraction `a / fⁿ` is killed by the embedding of the plane
cubic into `P²_R` exactly when some `fᵏ · a` lies in `(F)`. -/
theorem awayToSection_mem_ker_app_embeddingOf_iff {m : ℕ} {f : MvPolynomial (Fin 3) R}
    (hf : f ∈ homogeneousSubmodule (Fin 3) R m) (hm : 0 < m) (n : ℕ) (a : MvPolynomial (Fin 3) R)
    (ha : a ∈ homogeneousSubmodule (Fin 3) R (n • m)) :
    (Proj.awayToSection (homogeneousSubmodule (Fin 3) R) f).hom
        (HomogeneousLocalization.Away.mk _ hf n a ha) ∈
        RingHom.ker ((embeddingOf C).app (Proj.basicOpen _ f)).hom ↔
      ∃ k : ℕ, f ^ k * a ∈ (cubicIdealOf C).toIdeal := by
  refine (Stacks.ProjQuotientChartIdeal.awayToSection_mem_ker_app_projMap_iff
    (Stacks.HomogeneousIdeal.quotientMk (cubicIdealOf C)) _ hf hm _).trans ?_
  rw [Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff]
  exact exists_congr fun k => Ideal.Quotient.eq_zero_iff_mem

/-- The Weierstrass cubic is an equation of the plane cubic: it lies in the homogeneous ideal of
the closed subscheme of `P²_R` it cuts out. -/
theorem cubicOf_mem_idealOfClosedSubscheme :
    cubicOf C ∈ idealOfClosedSubscheme _ (embeddingOf C) := by
  have hz1 : cubicOf C ∈ homogeneousSubmodule (Fin 3) R (3 • 1) := cubicOf_mem C
  refine mem_idealOfClosedSubscheme_of_forall_chartFraction_mem_ker _ Nat.one_pos
    (fun g : homogeneousSubmodule (Fin 3) R 1 => (g : MvPolynomial (Fin 3) R)) (fun g => g.2)
    (Stacks.AlgebraicGeometry.ProjDegreeOne.iSup_basicOpen_degreeOne_eq_top _
      (MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top (Fin 3) R))
    (embeddingOf C) (m := 3) ⟨cubicOf C, hz1⟩ fun g => ?_
  refine (awayToSection_mem_ker_app_embeddingOf_iff C g.2 Nat.one_pos 3 _ hz1).mpr ⟨0, ?_⟩
  rw [pow_zero, one_mul]
  exact Ideal.mem_span_singleton_self _

/-- An equation `b` of the plane cubic, homogeneous of some degree, has `yᵏ · b ∈ (F)` for some
`k`: this is the chart kernel on `D₊(y)`. -/
theorem exists_X_one_pow_mul_mem_of_mem_idealOfClosedSubscheme {m : ℕ}
    (b : homogeneousSubmodule (Fin 3) R m)
    (hb : (b : MvPolynomial (Fin 3) R) ∈ idealOfClosedSubscheme _ (embeddingOf C)) :
    ∃ k : ℕ, X 1 ^ k * (b : MvPolynomial (Fin 3) R) ∈ (cubicIdealOf C).toIdeal := by
  have hgen := MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top (Fin 3) R
  have inst : ∀ j : ℤ, SheafOfModules.IsInvertible
      (AlgebraicGeometry.Proj (homogeneousSubmodule (Fin 3) R)).sheaf.obj
      (AlgebraicGeometry.Proj (homogeneousSubmodule (Fin 3) R)).ringCatSheaf.property
      (AlgebraicGeometry.ProjectiveSpectrum.Proj.twistingSheaf _ j) :=
    AlgebraicGeometry.ProjectiveSpectrum.Proj.algebraicGeometry_isInvertible_twistingSheaf _ hgen
  have hX : (X 1 : MvPolynomial (Fin 3) R) ∈ homogeneousSubmodule (Fin 3) R 1 :=
    isHomogeneous_X R 1
  have hb1 : (b : MvPolynomial (Fin 3) R) ∈ homogeneousSubmodule (Fin 3) R (m • 1) := by
    rw [smul_eq_mul, mul_one]
    exact b.2
  exact (awayToSection_mem_ker_app_embeddingOf_iff C hX Nat.one_pos m _ hb1).mp
    (chartFraction_mem_ker_app_of_mem_idealOfClosedSubscheme _ hX Nat.one_pos
      (embeddingOf C) m ⟨_, hb1⟩ hb)

/-- The Weierstrass cubic takes the value `-1` at `(1 : 0 : 0)`. -/
theorem eval_cubicOf_one_zero_zero : eval ![1, 0, 0] (cubicOf C) = -1 := by
  simp [cubicOf, WeierstrassCurve.Projective.polynomial]

/-- The coordinate `y` does not divide the Weierstrass cubic. -/
theorem not_X_one_dvd_cubicOf [Nontrivial R] : ¬ (X 1 : MvPolynomial (Fin 3) R) ∣ cubicOf C := by
  rintro ⟨q, hq⟩
  have h := congrArg (eval ![1, 0, 0]) hq
  rw [eval_cubicOf_one_zero_zero, map_mul, eval_X] at h
  simp at h

/-- The Weierstrass cubic is nonzero. -/
theorem cubicOf_ne_zero [Nontrivial R] : cubicOf C ≠ 0 := fun h =>
  not_X_one_dvd_cubicOf C (h ▸ dvd_zero _)

/-- The embedding of the plane cubic into `P²_R` is a morphism over the degree-zero parts. -/
theorem embeddingOf_toSpecZero :
    embeddingOf C ≫ Proj.toSpecZero (homogeneousSubmodule (Fin 3) R) =
      Proj.toSpecZero (gradingOf C) ≫ Spec.map (CommRingCat.ofHom
        (Stacks.HomogeneousIdeal.quotientMk (cubicIdealOf C)).gradedZeroRingHom) :=
  AlgebraicGeometry.Proj.map_toSpecZero _ _

/-- **The projection of the plane cubic is its embedding into `P²_R` followed by the structure
morphism of `P²_R`.** -/
theorem embeddingOf_projToSpecCoeff :
    embeddingOf C ≫ Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff R 2 =
      projectionOf C := by
  have key : CommRingCat.ofHom ((GradedRing.projZeroRingHom'
      (homogeneousSubmodule (Fin 3) R)).comp (algebraMap R (MvPolynomial (Fin 3) R))) ≫
      CommRingCat.ofHom (Stacks.HomogeneousIdeal.quotientMk (cubicIdealOf C)).gradedZeroRingHom =
      CommRingCat.ofHom (toGradingZeroOf C) := by
    ext a
    show Ideal.Quotient.mk _ (DirectSum.decompose (homogeneousSubmodule (Fin 3) R)
      (MvPolynomial.C a) 0 : MvPolynomial (Fin 3) R) = Ideal.Quotient.mk _ (MvPolynomial.C a)
    rw [DirectSum.decompose_of_mem_same _ (isHomogeneous_C _ _)]
  unfold Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff
  rw [← Category.assoc]
  refine (congrArg (· ≫ _) (embeddingOf_toSpecZero C)).trans ((Category.assoc _ _ _).trans ?_)
  refine (congrArg (Proj.toSpecZero (gradingOf C) ≫ ·) (Spec.map_comp _ _).symm).trans ?_
  exact congrArg (fun φ => Proj.toSpecZero (gradingOf C) ≫ Spec.map φ) key

end Ring

section Field

variable {k : Type u} [Field k] (C : WeierstrassCurve k)

/-- **Over a field, the homogeneous ideal of the plane cubic is generated by the Weierstrass
cubic.** -/
theorem idealOfClosedSubscheme_embeddingOf :
    idealOfClosedSubscheme _ (embeddingOf C) = Ideal.span {cubicOf C} := by
  refine le_antisymm (Ideal.span_le.mpr ?_) ?_
  · rintro - ⟨n, b, rfl, hzero⟩
    obtain ⟨p, hp⟩ := exists_X_one_pow_mul_mem_of_mem_idealOfClosedSubscheme C b
      (mem_idealOfClosedSubscheme _ _ n b hzero)
    change _ ∈ Ideal.span {cubicOf C} at hp
    rw [Ideal.mem_span_singleton] at hp
    rw [SetLike.mem_coe, Ideal.mem_span_singleton]
    let _ := UniqueFactorizationMonoid.toGCDMonoid (MvPolynomial (Fin 3) k)
    have hrel : IsRelPrime (cubicOf C) ((X 1 : MvPolynomial (Fin 3) k) ^ p) :=
      (((MvPolynomial.X_prime (R := k) (i := (1 : Fin 3))).irreducible.isRelPrime_iff_not_dvd.mpr
        (not_X_one_dvd_cubicOf C)).pow_left).symm
    exact hrel.dvd_of_dvd_mul_left hp
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact cubicOf_mem_idealOfClosedSubscheme C

/-- **Over a field, the global functions on the plane cubic are the constants:**
`dim_k H⁰(E, 𝒪_E) = 1`. -/
@[stacks 072S "H⁰ of a fibre is one-dimensional"]
theorem finrank_structureSheafCohomology_projectionOf_zero :
    Module.finrank k (structureSheafCohomology (projectionOf C) 0) = 1 := by
  have hker := projectiveSpace_ker_eq_zeroScheme_of_idealOfClosedSubscheme_eq_span k 3
    (embeddingOf C) ⟨cubicOf C, cubicOf_mem C⟩ (idealOfClosedSubscheme_embeddingOf C)
  have e := (nonempty_structureSheafCohomologyIsoTwistCohomologyZero k 2 0 3 (embeddingOf C)
    ⟨cubicOf C, cubicOf_mem C⟩ (cubicOf_ne_zero C) hker
    (isZero_twistCohomology_plane_zero k (by norm_num)) (isZero_twistCohomology_plane_one k _)).some
  rw [← embeddingOf_projToSpecCoeff]
  exact (e.toLinearEquiv.trans (twistCohomologyZeroEquivBase k 2)).finrank_eq.trans
    (Module.finrank_self k)

/-- **Over a field, the plane cubic has genus one:** `(3 - 1)(3 - 2)/2 = 1`. -/
@[stacks 072S "a fibre has genus one"]
theorem genus_projectionOf : genus (projectionOf C) = 1 := by
  have hker := projectiveSpace_ker_eq_zeroScheme_of_idealOfClosedSubscheme_eq_span k 3
    (embeddingOf C) ⟨cubicOf C, cubicOf_mem C⟩ (idealOfClosedSubscheme_embeddingOf C)
  rw [genus_eq_finrank_structureSheafCohomology, ← embeddingOf_projToSpecCoeff,
    finrank_structureSheafCohomology_eq_finrank_twistCohomology_neg k 2 1 3 (embeddingOf C)
      ⟨cubicOf C, cubicOf_mem C⟩ (cubicOf_ne_zero C) hker (isZero_twistCohomology_plane_one k 0)
      (isZero_twistCohomology k 2 0 2 (by norm_num)),
    finrank_twistCohomology_plane_top]

end Field

end AlgebraicGeometry.ModuliEllipticCurves.Weierstrass
