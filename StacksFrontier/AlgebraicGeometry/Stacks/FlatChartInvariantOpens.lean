module

public import StacksFrontier.AlgebraicGeometry.Stacks.FlatChartOpenChart
public import StacksFrontier.AlgebraicGeometry.Spaces.OpenSubspaceSections
public import StacksFrontier.AlgebraicGeometry.Spaces.QuasiFiniteLocusOnCharts
public import StacksFrontier.AlgebraicGeometry.Spaces.Representability
public import StacksFrontier.AlgebraicGeometry.Stacks.RelativeEtaleComposition
public import StacksFrontier.AlgebraicGeometry.Stacks.EtaleOpenImmersion
public import StacksFrontier.AlgebraicGeometry.Stacks.StabilizerPreservingLocus
public import StacksFrontier.AlgebraicGeometry.Stacks.EtaleSeparatedChartBaseChange

/-!
# Opens of a chart as subfunctors: invariance and covering

For an object `W` of the big fppf site and an open `Q` of its underlying scheme,
`AlgebraicGeometry.Space.subspaceOfOpens W Q` is the open subspace of `h_W` whose sections are
the morphisms `T ⟶ W` factoring through `Q`. This file records the two facts about these
subfunctors that the construction of open substacks from invariant opens of a chart consumes:

* `AlgebraicGeometry.Stack.FlatChart.preimage_subspaceOfOpens_le`: for morphisms `s t : V ⟶ W` of
  the site with `s⁻¹(Q) = t⁻¹(Q)`, the inverse image of the subspace under `h_s` is contained in
  its inverse image under `h_t`;
* `AlgebraicGeometry.Stack.FlatChart.exists_covering_subspaceOfOpens`: if opens `Q i` cover `W`,
  then every section of `h_W` lies, Zariski-locally, in one of the subspaces.

It also records that the restriction of an étale, stabilizer-preserving 1-morphism to an open
substack of its source is again étale and stabilizer-preserving
(`AlgebraicGeometry.Stack.FlatChart.isEtale_inclusion_comp` and
`AlgebraicGeometry.Stack.FlatChart.inducesIsomorphismAt_inclusion_comp`), which is how the open
substacks of the proof of Stacks 0DUS meet the hypotheses of Stacks 0DUQ.

## References

* [Stacks Project, Tag 0DUS](https://stacks.math.columbia.edu/tag/0DUS)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Stack

universe u w

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

namespace FlatChart

/-- A morphism `r ≫ s` lies in `subspaceOfOpens W Q` iff `r` maps every point into `s⁻¹(Q)`. -/
private theorem comp_mem_subspaceOfOpens_iff {T V W : BigFppfOver B S hS} (r : T ⟶ V) (s : V ⟶ W)
    (Q : ((BigFppfOver.toScheme B S hS).obj W).Opens) :
    r ≫ s ∈ (Space.subspaceOfOpens B S hS W Q).obj (op T) ↔
      ∀ y, (BigFppfOver.toScheme B S hS).map r y ∈ (BigFppfOver.toScheme B S hS).map s ⁻¹ᵁ Q := by
  rw [Space.mem_subspaceOfOpens_iff]
  simp only [Functor.map_comp, Scheme.Hom.comp_apply]
  rfl

/-- **Invariance of the subspace of an invariant open.** If two morphisms `s t : V ⟶ W` of the
site have the same inverse image of an open `Q` of `W`, then a section of `h_V` whose image under
`s` factors through `Q` has image under `t` factoring through `Q`. -/
theorem preimage_subspaceOfOpens_le {V W : BigFppfOver B S hS} (s t : V ⟶ W)
    (Q : ((BigFppfOver.toScheme B S hS).obj W).Opens)
    (hQ : (BigFppfOver.toScheme B S hS).map s ⁻¹ᵁ Q = (BigFppfOver.toScheme B S hS).map t ⁻¹ᵁ Q) :
    (Space.subspaceOfOpens B S hS W Q).preimage (yoneda.map s) ≤
      (Space.subspaceOfOpens B S hS W Q).preimage (yoneda.map t) := by
  intro T r hr
  change r ≫ s ∈ (Space.subspaceOfOpens B S hS W Q).obj T at hr
  show r ≫ t ∈ (Space.subspaceOfOpens B S hS W Q).obj T
  rw [comp_mem_subspaceOfOpens_iff] at hr ⊢
  exact fun y => hQ ▸ hr y

/-- **A Zariski cover of a chart gives a covering family of subspaces.** If the opens `Q i` cover
the underlying scheme of `W`, then every morphism `u : T ⟶ W` of the site lies, over the members
of a covering sieve of `T`, in one of the subspaces `subspaceOfOpens W (Q i)`: the sieve is the
one generated by the open cover of `T` by the inverse images of the `Q i`. -/
theorem exists_covering_subspaceOfOpens {W : BigFppfOver B S hS} {I : Type*}
    (Q : I → ((BigFppfOver.toScheme B S hS).obj W).Opens) (hQ : ∀ w, ∃ i, w ∈ Q i)
    (T : BigFppfOver B S hS) (u : (yoneda.obj W).obj (op T)) :
    ∃ R ∈ BigFppfOver.topology B S hS T, ∀ ⦃V : BigFppfOver B S hS⦄ (k : V ⟶ T), R k →
      ∃ i, (yoneda.obj W).map k.op u ∈ (Space.subspaceOfOpens B S hS W (Q i)).obj (op V) := by
  let O : I → ((BigFppfOver.toScheme B S hS).obj T).Opens :=
    fun i => (BigFppfOver.toScheme B S hS).map u ⁻¹ᵁ Q i
  refine ⟨Sieve.ofArrows (fun i => BigFppfOver.openSubObj B S hS T (O i))
    (fun i => BigFppfOver.openSubHom B S hS T (O i)), ?_, ?_⟩
  · refine BigFppfOver.ofArrows_mem_topology_of_isOpenImmersion B S hS _ (fun i => ?_) (fun x => ?_)
    · rw [Space.openSubHom_toScheme]
      infer_instance
    · obtain ⟨i, hi⟩ := hQ ((BigFppfOver.toScheme B S hS).map u x)
      refine ⟨i, ?_⟩
      rw [Space.openSubHom_toScheme, Scheme.Opens.range_ι]
      exact hi
  · rintro V k ⟨_, g, _, ⟨i⟩, rfl⟩
    refine ⟨i, ?_⟩
    show (g ≫ BigFppfOver.openSubHom B S hS T (O i)) ≫ u ∈
      (Space.subspaceOfOpens B S hS W (Q i)).obj (op V)
    rw [comp_mem_subspaceOfOpens_iff]
    intro y
    rw [Functor.map_comp, Scheme.Hom.comp_apply, Space.openSubHom_toScheme]
    exact ((BigFppfOver.toScheme B S hS).map g y).2

/-- **The restriction of an étale 1-morphism representable by algebraic spaces to an open
substack of its source is étale.** Both the inclusion of the open substack and the 1-morphism are
étale in the relative sense of Stacks 04XB (an open immersion of algebraic spaces is étale), the
relative notion composes (Stacks 045B), and a relatively étale 1-morphism is étale
(Stacks 0CIL). -/
theorem isEtale_inclusion_comp {𝒳 𝒳' : AlgebraicStacks.{u, w} B S hS} (𝒰 : OpenSubstack 𝒳')
    (h : 𝒳' ⟶ 𝒳) (hrep : IsRepresentableByAlgebraicSpaces B S hS h.hom.hom)
    (he : IsEtale B S hS h) :
    IsEtale B S hS (𝒰.inclusion B S hS ≫ h) :=
  AlgebraicStacks.isEtale_of_isRelativelyEtale B S hS _
    (isRelativelyEtale_comp B S hS _ _
      (isRelativelyEtale_of_isOpenImmersion B S hS (𝒰.inclusion B S hS).hom
        𝒰.isOpenImmersion.1 𝒰.isOpenImmersion.2)
      (isRelativelyEtale_of_isEtale B S hS h hrep he))

/-- **The restriction of a 1-morphism inducing isomorphisms on all automorphism groups to an open
substack of its source does so too** (Stacks 0DTW). -/
theorem inducesIsomorphismAt_inclusion_comp {𝒳 𝒳' : AlgebraicStacks.{u, w} B S hS}
    (𝒰 : OpenSubstack 𝒳') (h : 𝒳' ⟶ 𝒳) (hauto : ∀ q, InducesIsomorphismAt B S hS h q) :
    ∀ q, InducesIsomorphismAt B S hS (𝒰.inclusion B S hS ≫ h) q :=
  fun q => inducesIsomorphismAt_openSubstackInclusion_comp B S hS 𝒰 h q (hauto _)

end FlatChart

end AlgebraicGeometry.Stack

end
