/-!
# Morphisms at a stage, and the structure maps of a groupoid at a stage

The restriction of morphisms between stage objects to later stages and their reading over the
limit `X = lim X_i` (Stacks 07SK, full faithfulness); a groupoid in algebraic spaces over `X`
read in the slice over `X`; the first step of the descent of such a groupoid to a stage, models
of its object and arrow spaces with source, target, identity and inverse
(`AlgebraicGeometry.Stack.ConventionalStackDescentSystem.nonempty_stageMaps`); fibre products of
stage objects; composable pairs over the limit; and statements holding at every late enough stage.
-/

@[expose] public section

universe u v w

section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Stack.ConventionalStackDescentSystem


variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {hZ : B.Contains (⊤_ Scheme.{u})} {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)]
    [Nonempty I] (C : ConventionalStackDescentSystem B S hS hZ I)

/-- An object at a stage `X_i` of the system which is an algebraic space of finite presentation
over `X_i`: the objects Stacks 07SK is about. -/
abbrev IsStageObject {i : Iᵒᵖ} (Y : Over (C.diagram.obj i)) : Prop :=
  IsAlgebraicSpace B S hS Y.left ∧ Space.IsFinitePresentation B S hS Y.hom

/-- The base change of a stage object to a later stage is a stage object. -/
theorem IsStageObject.pullback {i j : Iᵒᵖ} (e : j ⟶ i) {Y : Over (C.diagram.obj i)}
    (hY : C.IsStageObject Y) : C.IsStageObject ((Over.pullback (C.diagram.map e)).obj Y) := by
  have hP : IsAlgebraicSpace B S hS (Limits.pullback Y.hom (C.diagram.map e)) :=
    isAlgebraicSpace_pullback B S hS _ _ hY.1 (C.stage_isAlgebraicSpace j)
      (C.stage_isAlgebraicSpace i)
  exact ⟨hP, Space.IsFinitePresentation.of_isPullback B S hS hP hY.1
    (C.stage_isAlgebraicSpace j) (C.stage_isAlgebraicSpace i)
    (IsPullback.of_hasPullback Y.hom (C.diagram.map e)) hY.2⟩

/-- **Restriction of a morphism at a stage to a later stage.** A morphism between the base
changes of two objects of a base stage `b` to a stage `j`, transported to the base changes to a
later stage `k`, along `a : k ⟶ j` with `a ≫ e = E`. -/
noncomputable def restrictHom {b j k : Iᵒᵖ} (e : j ⟶ b) (a : k ⟶ j) (E : k ⟶ b) (w : a ≫ e = E)
    {Y Z : Over (C.diagram.obj b)}
    (m : (Over.pullback (C.diagram.map e)).obj Y ⟶ (Over.pullback (C.diagram.map e)).obj Z) :
    (Over.pullback (C.diagram.map E)).obj Y ⟶ (Over.pullback (C.diagram.map E)).obj Z :=
  Over.transportHom (C.diagram.map a) (C.diagram.map e) (C.diagram.map E)
    (by rw [← w, C.diagram.map_comp]) m

/-- **A morphism at a stage, read over the limit.** -/
noncomputable def limitHom {b j : Iᵒᵖ} (e : j ⟶ b) {Y Z : Over (C.diagram.obj b)}
    (m : (Over.pullback (C.diagram.map e)).obj Y ⟶ (Over.pullback (C.diagram.map e)).obj Z) :
    (Over.pullback (limit.π C.diagram b)).obj Y ⟶ (Over.pullback (limit.π C.diagram b)).obj Z :=
  Over.transportHom (limit.π C.diagram j) (C.diagram.map e) (limit.π C.diagram b)
    (limit.w C.diagram e) m

/-- Restriction to a later stage preserves composition. -/
theorem restrictHom_comp {b j k : Iᵒᵖ} (e : j ⟶ b) (a : k ⟶ j) (E : k ⟶ b) (w : a ≫ e = E)
    {Y Z W : Over (C.diagram.obj b)}
    (m : (Over.pullback (C.diagram.map e)).obj Y ⟶ (Over.pullback (C.diagram.map e)).obj Z)
    (m' : (Over.pullback (C.diagram.map e)).obj Z ⟶ (Over.pullback (C.diagram.map e)).obj W) :
    C.restrictHom e a E w (m ≫ m') = C.restrictHom e a E w m ≫ C.restrictHom e a E w m' :=
  Over.transportHom_comp _ _ _ _ m m'

/-- Restriction to a later stage preserves identities. -/
theorem restrictHom_id {b j k : Iᵒᵖ} (e : j ⟶ b) (a : k ⟶ j) (E : k ⟶ b) (w : a ≫ e = E)
    (Y : Over (C.diagram.obj b)) :
    C.restrictHom e a E w (𝟙 ((Over.pullback (C.diagram.map e)).obj Y)) = 𝟙 _ :=
  Over.transportHom_id _ _ _ _ Y

/-- The restriction of the base change of a morphism at the base stage is its base change to the
later stage. -/
theorem restrictHom_map {b j k : Iᵒᵖ} (e : j ⟶ b) (a : k ⟶ j) (E : k ⟶ b) (w : a ≫ e = E)
    {Y Z : Over (C.diagram.obj b)} (m₀ : Y ⟶ Z) :
    C.restrictHom e a E w ((Over.pullback (C.diagram.map e)).map m₀) =
      (Over.pullback (C.diagram.map E)).map m₀ :=
  Over.transportHom_map _ _ _ _ m₀

/-- Reading over the limit preserves composition. -/
theorem limitHom_comp {b j : Iᵒᵖ} (e : j ⟶ b) {Y Z W : Over (C.diagram.obj b)}
    (m : (Over.pullback (C.diagram.map e)).obj Y ⟶ (Over.pullback (C.diagram.map e)).obj Z)
    (m' : (Over.pullback (C.diagram.map e)).obj Z ⟶ (Over.pullback (C.diagram.map e)).obj W) :
    C.limitHom e (m ≫ m') = C.limitHom e m ≫ C.limitHom e m' :=
  Over.transportHom_comp _ _ _ _ m m'

/-- Reading over the limit preserves identities. -/
theorem limitHom_id {b j : Iᵒᵖ} (e : j ⟶ b) (Y : Over (C.diagram.obj b)) :
    C.limitHom e (𝟙 ((Over.pullback (C.diagram.map e)).obj Y)) = 𝟙 _ :=
  Over.transportHom_id _ _ _ _ Y

/-- The reading over the limit of the base change of a morphism at the base stage is its base
change to the limit. -/
theorem limitHom_map {b j : Iᵒᵖ} (e : j ⟶ b) {Y Z : Over (C.diagram.obj b)} (m₀ : Y ⟶ Z) :
    C.limitHom e ((Over.pullback (C.diagram.map e)).map m₀) =
      (Over.pullback (limit.π C.diagram b)).map m₀ :=
  Over.transportHom_map _ _ _ _ m₀

/-- Reading over the limit does not see a restriction. -/
theorem limitHom_restrictHom {b j k : Iᵒᵖ} (e : j ⟶ b) (a : k ⟶ j) (E : k ⟶ b) (w : a ≫ e = E)
    {Y Z : Over (C.diagram.obj b)}
    (m : (Over.pullback (C.diagram.map e)).obj Y ⟶ (Over.pullback (C.diagram.map e)).obj Z) :
    C.limitHom E (C.restrictHom e a E w m) = C.limitHom e m := by
  unfold limitHom restrictHom
  rw [Over.transportHom_transportHom]
  exact Over.transportHom_congr (limit.w C.diagram a) _ _ _ _ m

/-- Restricting twice is restricting once. -/
theorem restrictHom_restrictHom {b j k l : Iᵒᵖ} (e : j ⟶ b) (a : k ⟶ j) (E : k ⟶ b)
    (w : a ≫ e = E) (a' : l ⟶ k) (E' : l ⟶ b) (w' : a' ≫ E = E')
    {Y Z : Over (C.diagram.obj b)}
    (m : (Over.pullback (C.diagram.map e)).obj Y ⟶ (Over.pullback (C.diagram.map e)).obj Z) :
    C.restrictHom E a' E' w' (C.restrictHom e a E w m) =
      C.restrictHom e (a' ≫ a) E' (by rw [Category.assoc, w, w']) m := by
  unfold restrictHom
  rw [Over.transportHom_transportHom]
  exact Over.transportHom_congr (C.diagram.map_comp a' a).symm _ _ _ _ m

/-- **Fullness of Stacks 07SK at a base stage.** Every morphism over the limit between the base
changes of two stage objects is the reading over the limit of a morphism at some later stage. -/
theorem exists_limitHom_eq {b : Iᵒᵖ} {Y Z : Over (C.diagram.obj b)} (hY : C.IsStageObject Y)
    (hZ' : C.IsStageObject Z)
    (f : (Over.pullback (limit.π C.diagram b)).obj Y ⟶
      (Over.pullback (limit.π C.diagram b)).obj Z) :
    ∃ (j : Iᵒᵖ) (e : j ⟶ b)
      (m : (Over.pullback (C.diagram.map e)).obj Y ⟶ (Over.pullback (C.diagram.map e)).obj Z),
      C.limitHom e m = f := by
  obtain ⟨j, e, g, α, β, hα, hβ, hcomm⟩ :=
    Space.exists_morphism_after_baseChange_of_siteContainsBaseChangeLimits
      (B := B) (S := S) (hS := hS) (hZ := hZ) (D := C.diagram) (hD := C.stage_isAlgebraicSpace)
      (hAffine := C.transition_affine) (hQc := C.stage_quasiCompact)
      (hQs := C.stage_quasiSeparated) (hconv := C.convention) (hDlim := C.limit_isAlgebraicSpace)
      b Y Z hY.1 hZ'.1 hY.2 hZ'.2 f
  refine ⟨j, e, g, ?_⟩
  have key : ∀ (T : Over (C.diagram.obj b))
      (γ : (Over.pullback (limit.π C.diagram j)).obj ((Over.pullback (C.diagram.map e)).obj T) ≅
        (Over.pullback (limit.π C.diagram b)).obj T),
      Over.Hom.left γ.hom ≫ pullback.fst T.hom (limit.π C.diagram b) =
        pullback.fst ((Over.pullback (C.diagram.map e)).obj T).hom (limit.π C.diagram j) ≫
          pullback.fst T.hom (C.diagram.map e) →
      γ.hom = (Over.pullbackPasteIso (limit.π C.diagram j) (C.diagram.map e)
        (limit.π C.diagram b) (limit.w C.diagram e)).hom.app T := fun T γ hγ => by
    apply Over.OverMorphism.ext
    apply pullback.hom_ext
    · rw [Over.pullbackPasteIso_hom_app_left_fst]
      exact hγ
    · exact (Over.w γ.hom).trans (Over.w ((Over.pullbackPasteIso (limit.π C.diagram j)
        (C.diagram.map e) (limit.π C.diagram b) (limit.w C.diagram e)).hom.app T)).symm
  have hαe := key Y α hα
  have hβe := key Z β hβ
  unfold limitHom Over.transportHom
  rw [← hβe, ← hcomm, ← Category.assoc, hαe]
  simp

/-- **Faithfulness of Stacks 07SK at a base stage.** Two morphisms at a stage which agree over the
limit agree after restriction to some later stage. -/
theorem exists_restrictHom_eq_of_limitHom_eq {b j : Iᵒᵖ} (e : j ⟶ b)
    {Y Z : Over (C.diagram.obj b)} (hY : C.IsStageObject Y) (hZ' : C.IsStageObject Z)
    (m m' : (Over.pullback (C.diagram.map e)).obj Y ⟶ (Over.pullback (C.diagram.map e)).obj Z)
    (h : C.limitHom e m = C.limitHom e m') :
    ∃ (k : Iᵒᵖ) (a : k ⟶ j),
      C.restrictHom e a (a ≫ e) rfl m = C.restrictHom e a (a ≫ e) rfl m' := by
  have h' : (Over.pullback (limit.π C.diagram j)).map m =
      (Over.pullback (limit.π C.diagram j)).map m' := by
    have := congrArg (fun t => (Over.pullbackPasteIso (limit.π C.diagram j) (C.diagram.map e)
      (limit.π C.diagram b) (limit.w C.diagram e)).hom.app Y ≫ t ≫
        (Over.pullbackPasteIso (limit.π C.diagram j) (C.diagram.map e)
          (limit.π C.diagram b) (limit.w C.diagram e)).inv.app Z) h
    simp only [limitHom, Over.transportHom, Category.assoc, Iso.hom_inv_id_app_assoc,
      Iso.hom_inv_id_app] at this
    exact (Category.comp_id _).symm.trans (this.trans (Category.comp_id _))
  obtain ⟨k, a, hk⟩ := Space.eventually_eq_of_baseChange_eq_of_siteContainsBaseChangeLimits
    (B := B) (S := S) (hS := hS) (D := C.diagram) (hD := C.stage_isAlgebraicSpace)
    (hAffine := C.transition_affine) (hQc := C.stage_quasiCompact)
    (hconv := C.convention) j _ _ (hY.pullback C e).1
    (hZ'.pullback C e).1 (hY.pullback C e).2
    (hZ'.pullback C e).2 m m' h'
  exact ⟨k, a, by
    unfold restrictHom Over.transportHom
    rw [hk]⟩

end AlgebraicGeometry.Stack.ConventionalStackDescentSystem

end

/-! ### Descent of a groupoid to a stage -/

section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Stack.ConventionalStackDescentSystem


variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {hZ : B.Contains (⊤_ Scheme.{u})} {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)]
    [Nonempty I] (C : ConventionalStackDescentSystem B S hS hZ I)

omit [IsDirected I (· ≤ ·)] [Nonempty I] in
/-- Two morphisms of the index category of the system are equal: it is a preorder. -/
theorem index_hom_eq {j k : Iᵒᵖ} (f g : j ⟶ k) : f = g :=
  Quiver.Hom.unop_inj (Subsingleton.elim _ _)

/-- Restriction along equal maps is the same restriction. -/
theorem restrictHom_congr {b j k : Iᵒᵖ} (e : j ⟶ b) {a a' : k ⟶ j} (h : a = a') (E : k ⟶ b)
    (w : a ≫ e = E) (w' : a' ≫ e = E) {Y Z : Over (C.diagram.obj b)}
    (m : (Over.pullback (C.diagram.map e)).obj Y ⟶ (Over.pullback (C.diagram.map e)).obj Z) :
    C.restrictHom e a E w m = C.restrictHom e a' E w' m := by
  subst h
  rfl

/-- An equation which holds after restriction to a stage holds after restriction to any later
stage. -/
theorem restrictHom_eq_of_eq {b j k₁ k : Iᵒᵖ} (e : j ⟶ b) (a₁ : k₁ ⟶ j)
    {Y Z : Over (C.diagram.obj b)}
    {m m' : (Over.pullback (C.diagram.map e)).obj Y ⟶ (Over.pullback (C.diagram.map e)).obj Z}
    (h : C.restrictHom e a₁ (a₁ ≫ e) rfl m = C.restrictHom e a₁ (a₁ ≫ e) rfl m')
    (c : k ⟶ k₁) (a : k ⟶ j) :
    C.restrictHom e a (a ≫ e) rfl m = C.restrictHom e a (a ≫ e) rfl m' := by
  have hc : c ≫ a₁ = a := index_hom_eq _ _
  subst hc
  have h' := congrArg (C.restrictHom (a₁ ≫ e) c ((c ≫ a₁) ≫ e) (Category.assoc _ _ _).symm) h
  rwa [restrictHom_restrictHom, restrictHom_restrictHom] at h'

/-! ### The groupoid over the limit, read in the slice over the limit -/

variable {C} (G : GroupoidInAlgebraicSpaces B S hS C.limitSpace)

/-- The object space of a groupoid over the limit, as an object over the limit. -/
noncomputable abbrev limObjects : Over (limit C.diagram) := Over.mk G.objectsToBase.hom

/-- The arrow space of a groupoid over the limit, as an object over the limit. -/
noncomputable abbrev limArrows : Over (limit C.diagram) := Over.mk G.arrowsToBase.hom

/-- The source map, over the limit. -/
noncomputable def limSource : limArrows G ⟶ limObjects G :=
  Over.homMk G.source.hom (congrArg (fun k => k.hom) G.source_over)

/-- The target map, over the limit. -/
noncomputable def limTarget : limArrows G ⟶ limObjects G :=
  Over.homMk G.target.hom (congrArg (fun k => k.hom) G.target_over)

/-- The identity, over the limit. -/
noncomputable def limIdentity : limObjects G ⟶ limArrows G :=
  Over.homMk (groupoidIdentityHom G) (by
    have h1 : groupoidIdentityHom G ≫ G.source.hom = 𝟙 G.objects.obj :=
      congrArg (fun k => k.hom) (groupoidObject G).identity_source
    have h2 : G.source.hom ≫ G.objectsToBase.hom = G.arrowsToBase.hom :=
      congrArg (fun k => k.hom) G.source_over
    change groupoidIdentityHom G ≫ G.arrowsToBase.hom = G.objectsToBase.hom
    rw [← h2, ← Category.assoc, h1, Category.id_comp])

/-- The inverse, over the limit. -/
noncomputable def limInverse : limArrows G ⟶ limArrows G :=
  Over.homMk (groupoidInverseHom G) (by
    have h1 : groupoidInverseHom G ≫ G.source.hom = G.target.hom :=
      congrArg (fun k => k.hom) (groupoidObject G).inverse_source
    have h2 : G.source.hom ≫ G.objectsToBase.hom = G.arrowsToBase.hom :=
      congrArg (fun k => k.hom) G.source_over
    have h3 : G.target.hom ≫ G.objectsToBase.hom = G.arrowsToBase.hom :=
      congrArg (fun k => k.hom) G.target_over
    change groupoidInverseHom G ≫ G.arrowsToBase.hom = G.arrowsToBase.hom
    rw [← h2, ← Category.assoc, h1, h3, h2])

/-- The source of the identity at an object is that object. -/
theorem limIdentity_limSource : limIdentity G ≫ limSource G = 𝟙 _ :=
  Over.OverMorphism.ext (congrArg (fun k => k.hom) (groupoidObject G).identity_source)

/-- The target of the identity at an object is that object. -/
theorem limIdentity_limTarget : limIdentity G ≫ limTarget G = 𝟙 _ :=
  Over.OverMorphism.ext (congrArg (fun k => k.hom) (groupoidObject G).identity_target)

/-- The source of the inverse of an arrow is its target. -/
theorem limInverse_limSource : limInverse G ≫ limSource G = limTarget G :=
  Over.OverMorphism.ext (congrArg (fun k => k.hom) (groupoidObject G).inverse_source)

/-- The target of the inverse of an arrow is its source. -/
theorem limInverse_limTarget : limInverse G ≫ limTarget G = limSource G :=
  Over.OverMorphism.ext (congrArg (fun k => k.hom) (groupoidObject G).inverse_target)

/-! ### The first step: the structure maps, the identity and the inverse -/

variable (C)

/-- **The object and arrow spaces of a groupoid over the limit at a stage, with source, target,
identity and inverse.** A stage `X_b`, models `U_b` and `R_b` of the object and arrow spaces of
finite presentation over it, identified over the limit with the object and arrow spaces of `G`,
and four morphisms over `X_b` satisfying the four laws of a groupoid which involve no composition
and reading over the limit as the source, target, identity and inverse of `G`. -/
structure StageMaps where
  /-- The stage. -/
  stage : Iᵒᵖ
  /-- The model of the object space. -/
  objects : Over (C.diagram.obj stage)
  /-- The model of the arrow space. -/
  arrows : Over (C.diagram.obj stage)
  objects_isStageObject : C.IsStageObject objects
  arrows_isStageObject : C.IsStageObject arrows
  /-- The identification of the object space over the limit. -/
  objectsIso : limObjects G ≅ (Over.pullback (limit.π C.diagram stage)).obj objects
  /-- The identification of the arrow space over the limit. -/
  arrowsIso : limArrows G ≅ (Over.pullback (limit.π C.diagram stage)).obj arrows
  /-- The source map. -/
  source : arrows ⟶ objects
  /-- The target map. -/
  target : arrows ⟶ objects
  /-- The identity. -/
  identity : objects ⟶ arrows
  /-- The inverse. -/
  inverse : arrows ⟶ arrows
  identity_source : identity ≫ source = 𝟙 objects
  identity_target : identity ≫ target = 𝟙 objects
  inverse_source : inverse ≫ source = target
  inverse_target : inverse ≫ target = source
  map_source : (Over.pullback (limit.π C.diagram stage)).map source =
    arrowsIso.inv ≫ limSource G ≫ objectsIso.hom
  map_target : (Over.pullback (limit.π C.diagram stage)).map target =
    arrowsIso.inv ≫ limTarget G ≫ objectsIso.hom
  map_identity : (Over.pullback (limit.π C.diagram stage)).map identity =
    objectsIso.inv ≫ limIdentity G ≫ arrowsIso.hom
  map_inverse : (Over.pullback (limit.π C.diagram stage)).map inverse =
    arrowsIso.inv ≫ limInverse G ≫ arrowsIso.hom

/-- A morphism at a stage, read over the limit through the base change to that stage. -/
theorem map_eq_limitHom {b j : Iᵒᵖ} (e : j ⟶ b) {Y Z : Over (C.diagram.obj b)}
    (m : (Over.pullback (C.diagram.map e)).obj Y ⟶ (Over.pullback (C.diagram.map e)).obj Z) :
    (Over.pullback (limit.π C.diagram j)).map m =
      (Over.pullbackPasteIso (limit.π C.diagram j) (C.diagram.map e) (limit.π C.diagram b)
          (limit.w C.diagram e)).hom.app Y ≫ C.limitHom e m ≫
        (Over.pullbackPasteIso (limit.π C.diagram j) (C.diagram.map e) (limit.π C.diagram b)
          (limit.w C.diagram e)).inv.app Z := by
  simp [limitHom, Over.transportHom]

/-- The identification over the limit of the base change of a stage model to a later stage. -/
noncomputable def laterIso {b j : Iᵒᵖ} (e : j ⟶ b) {Y : Over (C.diagram.obj b)}
    {L : Over (limit C.diagram)} (ι : L ≅ (Over.pullback (limit.π C.diagram b)).obj Y) :
    L ≅ (Over.pullback (limit.π C.diagram j)).obj ((Over.pullback (C.diagram.map e)).obj Y) :=
  ι ≪≫ ((Over.pullbackPasteIso (limit.π C.diagram j) (C.diagram.map e) (limit.π C.diagram b)
    (limit.w C.diagram e)).app Y).symm

/-- A morphism at a stage which reads over the limit as a conjugate of a morphism over the limit
reads, after base change to that stage, as the same conjugate. -/
theorem map_eq_of_limitHom_eq {b j : Iᵒᵖ} (e : j ⟶ b) {Y Z : Over (C.diagram.obj b)}
    {L M : Over (limit C.diagram)} (ιY : L ≅ (Over.pullback (limit.π C.diagram b)).obj Y)
    (ιZ : M ≅ (Over.pullback (limit.π C.diagram b)).obj Z) (f : L ⟶ M)
    (m : (Over.pullback (C.diagram.map e)).obj Y ⟶ (Over.pullback (C.diagram.map e)).obj Z)
    (h : C.limitHom e m = ιY.inv ≫ f ≫ ιZ.hom) :
    (Over.pullback (limit.π C.diagram j)).map m =
      (C.laterIso e ιY).inv ≫ f ≫ (C.laterIso e ιZ).hom := by
  rw [C.map_eq_limitHom e m, h]
  simp [laterIso]

omit [Nonempty I] in
/-- Two stages have a common later stage. -/
theorem exists_le_le (j k : Iᵒᵖ) : ∃ (l : Iᵒᵖ) (_ : l ⟶ j) (_ : l ⟶ k), True :=
  ⟨IsCofiltered.min j k, IsCofiltered.minToLeft j k, IsCofiltered.minToRight j k, trivial⟩

/-- **The first step of the descent: source, target, identity and inverse at a stage.** Given
models at two stages of the object and arrow spaces of a groupoid over the limit, there is a
stage carrying models of both together with the source, target, identity and inverse and the four
laws among them which involve no composition. -/
theorem nonempty_stageMaps
    (iU : Iᵒᵖ) (Uᵢ : Over (C.diagram.obj iU)) (hUalg : IsAlgebraicSpace B S hS Uᵢ.left)
    (hUfp : Space.IsFinitePresentation B S hS Uᵢ.hom)
    (eU : Over.mk G.objectsToBase.hom ≅ (Over.pullback (limit.π C.diagram iU)).obj Uᵢ)
    (iR : Iᵒᵖ) (Rᵢ : Over (C.diagram.obj iR)) (hRalg : IsAlgebraicSpace B S hS Rᵢ.left)
    (hRfp : Space.IsFinitePresentation B S hS Rᵢ.hom)
    (eR : Over.mk G.arrowsToBase.hom ≅ (Over.pullback (limit.π C.diagram iR)).obj Rᵢ) :
    Nonempty (C.StageMaps G) := by
  classical
  obtain ⟨b₀, aU, aR, -⟩ := exists_le_le iU iR
  let U₀ := (Over.pullback (C.diagram.map aU)).obj Uᵢ
  let R₀ := (Over.pullback (C.diagram.map aR)).obj Rᵢ
  have hU₀ : C.IsStageObject U₀ := IsStageObject.pullback C aU ⟨hUalg, hUfp⟩
  have hR₀ : C.IsStageObject R₀ := IsStageObject.pullback C aR ⟨hRalg, hRfp⟩
  let ιU : limObjects G ≅ (Over.pullback (limit.π C.diagram b₀)).obj U₀ := C.laterIso aU eU
  let ιR : limArrows G ≅ (Over.pullback (limit.π C.diagram b₀)).obj R₀ := C.laterIso aR eR
  obtain ⟨js, es, ms, hms⟩ := C.exists_limitHom_eq hR₀ hU₀ (ιR.inv ≫ limSource G ≫ ιU.hom)
  obtain ⟨jt, et, mt, hmt⟩ := C.exists_limitHom_eq hR₀ hU₀ (ιR.inv ≫ limTarget G ≫ ιU.hom)
  obtain ⟨je, ee, me, hme⟩ := C.exists_limitHom_eq hU₀ hR₀ (ιU.inv ≫ limIdentity G ≫ ιR.hom)
  obtain ⟨ji, ei, mi, hmi⟩ := C.exists_limitHom_eq hR₀ hR₀ (ιR.inv ≫ limInverse G ≫ ιR.hom)
  obtain ⟨k₁, ks, kt, -⟩ := exists_le_le js jt
  obtain ⟨k₂, ke, ki, -⟩ := exists_le_le je ji
  obtain ⟨b', c₁, c₂, -⟩ := exists_le_le k₁ k₂
  let E : b' ⟶ b₀ := (c₁ ≫ ks) ≫ es
  let s' := C.restrictHom es (c₁ ≫ ks) E rfl ms
  let t' := C.restrictHom et (c₁ ≫ kt) E (index_hom_eq _ _) mt
  let e' := C.restrictHom ee (c₂ ≫ ke) E (index_hom_eq _ _) me
  let i' := C.restrictHom ei (c₂ ≫ ki) E (index_hom_eq _ _) mi
  have hs' : C.limitHom E s' = ιR.inv ≫ limSource G ≫ ιU.hom :=
    (C.limitHom_restrictHom _ _ _ _ _).trans hms
  have ht' : C.limitHom E t' = ιR.inv ≫ limTarget G ≫ ιU.hom :=
    (C.limitHom_restrictHom _ _ _ _ _).trans hmt
  have he' : C.limitHom E e' = ιU.inv ≫ limIdentity G ≫ ιR.hom :=
    (C.limitHom_restrictHom _ _ _ _ _).trans hme
  have hi' : C.limitHom E i' = ιR.inv ≫ limInverse G ≫ ιR.hom :=
    (C.limitHom_restrictHom _ _ _ _ _).trans hmi
  have q₁ : C.limitHom E (e' ≫ s') = C.limitHom E (𝟙 _) := by
    rw [C.limitHom_comp, C.limitHom_id, he', hs']
    simp [reassoc_of% limIdentity_limSource G]
  have q₂ : C.limitHom E (e' ≫ t') = C.limitHom E (𝟙 _) := by
    rw [C.limitHom_comp, C.limitHom_id, he', ht']
    simp [reassoc_of% limIdentity_limTarget G]
  have q₃ : C.limitHom E (i' ≫ s') = C.limitHom E t' := by
    rw [C.limitHom_comp, hi', hs', ht']
    simp [reassoc_of% limInverse_limSource G]
  have q₄ : C.limitHom E (i' ≫ t') = C.limitHom E s' := by
    rw [C.limitHom_comp, hi', ht', hs']
    simp [reassoc_of% limInverse_limTarget G]
  obtain ⟨l₁, d₁, r₁⟩ := C.exists_restrictHom_eq_of_limitHom_eq E hU₀ hU₀ _ _ q₁
  obtain ⟨l₂, d₂, r₂⟩ := C.exists_restrictHom_eq_of_limitHom_eq E hU₀ hU₀ _ _ q₂
  obtain ⟨l₃, d₃, r₃⟩ := C.exists_restrictHom_eq_of_limitHom_eq E hR₀ hU₀ _ _ q₃
  obtain ⟨l₄, d₄, r₄⟩ := C.exists_restrictHom_eq_of_limitHom_eq E hR₀ hU₀ _ _ q₄
  obtain ⟨n₁, f₁, f₂, -⟩ := exists_le_le l₁ l₂
  obtain ⟨n₂, f₃, f₄, -⟩ := exists_le_le l₃ l₄
  obtain ⟨b₁, g₁, g₂, -⟩ := exists_le_le n₁ n₂
  let a : b₁ ⟶ b' := (g₁ ≫ f₁) ≫ d₁
  have r₁' := C.restrictHom_eq_of_eq E d₁ r₁ (g₁ ≫ f₁) a
  have r₂' := C.restrictHom_eq_of_eq E d₂ r₂ (g₁ ≫ f₂) a
  have r₃' := C.restrictHom_eq_of_eq E d₃ r₃ (g₂ ≫ f₃) a
  have r₄' := C.restrictHom_eq_of_eq E d₄ r₄ (g₂ ≫ f₄) a
  rw [C.restrictHom_comp, C.restrictHom_id] at r₁' r₂'
  rw [C.restrictHom_comp] at r₃' r₄'
  let E₁ : b₁ ⟶ b₀ := a ≫ E
  exact ⟨{ stage := b₁
           objects := (Over.pullback (C.diagram.map E₁)).obj U₀
           arrows := (Over.pullback (C.diagram.map E₁)).obj R₀
           objects_isStageObject := hU₀.pullback C E₁
           arrows_isStageObject := hR₀.pullback C E₁
           objectsIso := C.laterIso E₁ ιU
           arrowsIso := C.laterIso E₁ ιR
           source := C.restrictHom E a E₁ rfl s'
           target := C.restrictHom E a E₁ rfl t'
           identity := C.restrictHom E a E₁ rfl e'
           inverse := C.restrictHom E a E₁ rfl i'
           identity_source := r₁'
           identity_target := r₂'
           inverse_source := r₃'
           inverse_target := r₄'
           map_source := C.map_eq_of_limitHom_eq E₁ ιR ιU _ _
             ((C.limitHom_restrictHom _ _ _ _ _).trans hs')
           map_target := C.map_eq_of_limitHom_eq E₁ ιR ιU _ _
             ((C.limitHom_restrictHom _ _ _ _ _).trans ht')
           map_identity := C.map_eq_of_limitHom_eq E₁ ιU ιR _ _
             ((C.limitHom_restrictHom _ _ _ _ _).trans he')
           map_inverse := C.map_eq_of_limitHom_eq E₁ ιR ιR _ _
             ((C.limitHom_restrictHom _ _ _ _ _).trans hi') }⟩

/-! ### Fibre products of stage objects -/

/-- A morphism between two stage objects is of finite presentation. -/
theorem isFinitePresentation_left {i : Iᵒᵖ} {Y Z : Over (C.diagram.obj i)}
    (hY : C.IsStageObject Y) (hZ' : C.IsStageObject Z) (m : Y ⟶ Z) :
    Space.IsFinitePresentation B S hS m.left := by
  have hY2 := hY.2
  rw [← Over.w m] at hY2
  exact ⟨Space.isLocallyOfFinitePresentation_of_comp B S hS hY.1 hZ'.1
      (C.stage_isAlgebraicSpace i) m.left Z.hom hY2.1
      (Space.isLocallyOfFiniteType_of_isLocallyOfFinitePresentation B S hS hZ'.2.1),
    Space.isQuasiCompact_of_comp_of_isQuasiSeparated B S hS m.left Z.hom hY.1
      (C.stage_isAlgebraicSpace i) hY2.2.1 hZ'.2.2.2,
    Space.isQuasiSeparated_of_comp B S hS m.left Z.hom hY2.2.2⟩

/-- A fibre product of stage objects is a stage object. -/
theorem IsStageObject.of_isPullback {i : Iᵒᵖ} {P Y Z W : Over (C.diagram.obj i)}
    {fst : P ⟶ Y} {snd : P ⟶ W} {f : Y ⟶ Z} {g : W ⟶ Z} (hP : IsPullback fst snd f g)
    (hY : C.IsStageObject Y) (hZ' : C.IsStageObject Z) (hW : C.IsStageObject W) :
    C.IsStageObject P := by
  have hP' : IsPullback fst.left snd.left f.left g.left := hP.map (Over.forget _)
  have hPalg : IsAlgebraicSpace B S hS P.left :=
    Space.isAlgebraicSpace_of_iso B S hS hP'.isoPullback.symm
      (isAlgebraicSpace_pullback B S hS f.left g.left hY.1 hW.1 hZ'.1)
  have hsnd : Space.IsFinitePresentation B S hS snd.left :=
    Space.IsFinitePresentation.of_isPullback B S hS hPalg hY.1 hW.1 hZ'.1 hP'
      (C.isFinitePresentation_left hY hZ' f)
  refine ⟨hPalg, ?_⟩
  rw [← Over.w snd]
  exact Space.isFinitePresentation_comp B S hS hPalg hW.1 (C.stage_isAlgebraicSpace i)
    snd.left W.hom hsnd hW.2

/-! ### Composable pairs over the limit -/

variable {C}

/-- The composable pairs of arrows of a groupoid over the limit, as an object over the limit. -/
noncomputable abbrev limPairs : Over (limit C.diagram) :=
  Over.mk (pullback.fst G.source.hom G.target.hom ≫ G.arrowsToBase.hom)

/-- The first arrow of a composable pair, over the limit. -/
noncomputable def limFst : limPairs G ⟶ limArrows G :=
  Over.homMk (pullback.fst G.source.hom G.target.hom) rfl

/-- The second arrow of a composable pair, over the limit. -/
noncomputable def limSnd : limPairs G ⟶ limArrows G :=
  Over.homMk (pullback.snd G.source.hom G.target.hom) (by
    have h2 : G.source.hom ≫ G.objectsToBase.hom = G.arrowsToBase.hom :=
      congrArg (fun k => k.hom) G.source_over
    have h3 : G.target.hom ≫ G.objectsToBase.hom = G.arrowsToBase.hom :=
      congrArg (fun k => k.hom) G.target_over
    change pullback.snd G.source.hom G.target.hom ≫ G.arrowsToBase.hom =
      pullback.fst G.source.hom G.target.hom ≫ G.arrowsToBase.hom
    calc pullback.snd G.source.hom G.target.hom ≫ G.arrowsToBase.hom
        = (pullback.snd G.source.hom G.target.hom ≫ G.target.hom) ≫ G.objectsToBase.hom := by
          rw [Category.assoc, h3]
      _ = (pullback.fst G.source.hom G.target.hom ≫ G.source.hom) ≫ G.objectsToBase.hom := by
          rw [pullback.condition]
      _ = pullback.fst G.source.hom G.target.hom ≫ G.arrowsToBase.hom := by
          rw [Category.assoc, h2])

/-- The composition, over the limit. -/
noncomputable def limComp : limPairs G ⟶ limArrows G :=
  Over.homMk G.comp.hom (congrArg (fun k => k.hom) G.comp_over)

/-- The composable pairs over the limit are the fibre product of source and target over the
limit. -/
theorem isPullback_limPairs :
    IsPullback (limFst G) (limSnd G) (limSource G) (limTarget G) :=
  IsPullback.of_map (Over.forget _)
    (Over.OverMorphism.ext (by
      change pullback.fst G.source.hom G.target.hom ≫ G.source.hom =
        pullback.snd G.source.hom G.target.hom ≫ G.target.hom
      exact pullback.condition))
    (IsPullback.of_hasPullback G.source.hom G.target.hom)

/-- The source of a composite is the source of the second arrow of the pair. -/
theorem limComp_limSource : limComp G ≫ limSource G = limSnd G ≫ limSource G :=
  Over.OverMorphism.ext (by
    have h : G.comp.hom ≫ G.source.hom = pullback.snd G.source.hom G.target.hom ≫ G.source.hom :=
      congrArg (fun k => k.hom) (groupoidObject G).comp_source
    exact h)

/-- The target of a composite is the target of the first arrow of the pair. -/
theorem limComp_limTarget : limComp G ≫ limTarget G = limFst G ≫ limTarget G :=
  Over.OverMorphism.ext (by
    have h : G.comp.hom ≫ G.target.hom = pullback.fst G.source.hom G.target.hom ≫ G.target.hom :=
      congrArg (fun k => k.hom) (groupoidObject G).comp_target
    exact h)

/-! ### The laws of a groupoid over the limit, on generalized elements of the slice -/

/-- The composite of the identity at the target of an arrow with the arrow is the arrow, on
generalized elements. -/
theorem limComp_unitLeft {X : Over (limit C.diagram)} (a : X ⟶ limArrows G)
    (k : X ⟶ limPairs G) (h₁ : k ≫ limFst G = a ≫ limTarget G ≫ limIdentity G)
    (h₂ : k ≫ limSnd G = a) : k ≫ limComp G = a :=
  Over.OverMorphism.ext ((groupoidPresheafObject G).comp_identity_left a.left k.left
    (congrArg (fun φ => φ.left) h₁) (congrArg (fun φ => φ.left) h₂))

/-- The composite of an arrow with the identity at its source is the arrow, on generalized
elements. -/
theorem limComp_unitRight {X : Over (limit C.diagram)} (a : X ⟶ limArrows G)
    (k : X ⟶ limPairs G) (h₁ : k ≫ limFst G = a)
    (h₂ : k ≫ limSnd G = a ≫ limSource G ≫ limIdentity G) : k ≫ limComp G = a :=
  Over.OverMorphism.ext ((groupoidPresheafObject G).comp_identity_right a.left k.left
    (congrArg (fun φ => φ.left) h₁) (congrArg (fun φ => φ.left) h₂))

/-- The composite of the inverse of an arrow with the arrow is the identity at its source, on
generalized elements. -/
theorem limComp_inverseLeft {X : Over (limit C.diagram)} (a : X ⟶ limArrows G)
    (k : X ⟶ limPairs G) (h₁ : k ≫ limFst G = a ≫ limInverse G) (h₂ : k ≫ limSnd G = a) :
    k ≫ limComp G = a ≫ limSource G ≫ limIdentity G :=
  Over.OverMorphism.ext ((groupoidPresheafObject G).comp_inverse_left a.left k.left
    (congrArg (fun φ => φ.left) h₁) (congrArg (fun φ => φ.left) h₂))

/-- The composite of an arrow with its inverse is the identity at its target, on generalized
elements. -/
theorem limComp_inverseRight {X : Over (limit C.diagram)} (a : X ⟶ limArrows G)
    (k : X ⟶ limPairs G) (h₁ : k ≫ limFst G = a) (h₂ : k ≫ limSnd G = a ≫ limInverse G) :
    k ≫ limComp G = a ≫ limTarget G ≫ limIdentity G :=
  Over.OverMorphism.ext ((groupoidPresheafObject G).comp_inverse_right a.left k.left
    (congrArg (fun φ => φ.left) h₁) (congrArg (fun φ => φ.left) h₂))

/-- Composition is associative, on generalized elements. -/
theorem limComp_assoc {X : Over (limit C.diagram)} (k l m n : X ⟶ limPairs G)
    (hkl : k ≫ limSnd G = l ≫ limFst G) (hm₁ : m ≫ limFst G = k ≫ limComp G)
    (hm₂ : m ≫ limSnd G = l ≫ limSnd G) (hn₁ : n ≫ limFst G = k ≫ limFst G)
    (hn₂ : n ≫ limSnd G = l ≫ limComp G) : m ≫ limComp G = n ≫ limComp G :=
  Over.OverMorphism.ext ((groupoidPresheafObject G).comp_assoc k.left l.left m.left n.left
    (congrArg (fun φ => φ.left) hkl) (congrArg (fun φ => φ.left) hm₁)
    (congrArg (fun φ => φ.left) hm₂) (congrArg (fun φ => φ.left) hn₁)
    (congrArg (fun φ => φ.left) hn₂))

/-! ### Statements which hold at every late enough stage -/

/-- A statement about the stages beyond `j` which holds from some index on. -/
def Eventually (j : Iᵒᵖ) (P : ∀ l : Iᵒᵖ, (l ⟶ j) → Prop) : Prop :=
  ∃ k : I, ∀ (l : Iᵒᵖ) (c : l ⟶ j), k ≤ l.unop → P l c

omit [Nonempty I] in
/-- Two statements which hold eventually hold together eventually. -/
theorem Eventually.and {j : Iᵒᵖ} {P Q : ∀ l : Iᵒᵖ, (l ⟶ j) → Prop} (hP : Eventually j P)
    (hQ : Eventually j Q) : Eventually j (fun l c => P l c ∧ Q l c) := by
  obtain ⟨k₁, h₁⟩ := hP
  obtain ⟨k₂, h₂⟩ := hQ
  obtain ⟨k, hk₁, hk₂⟩ := directed_of (· ≤ ·) k₁ k₂
  exact ⟨k, fun l c hl => ⟨h₁ l c (hk₁.trans hl), h₂ l c (hk₂.trans hl)⟩⟩

omit [Nonempty I] in
/-- A statement which holds eventually holds at some stage. -/
theorem Eventually.exists {j : Iᵒᵖ} {P : ∀ l : Iᵒᵖ, (l ⟶ j) → Prop} (hP : Eventually j P) :
    ∃ (l : Iᵒᵖ) (c : l ⟶ j), P l c := by
  obtain ⟨k, h⟩ := hP
  obtain ⟨k', hk, hj⟩ := directed_of (· ≤ ·) k j.unop
  exact ⟨Opposite.op k', (homOfLE hj).op, h _ _ hk⟩

variable (C) in
/-- **Faithfulness of Stacks 07SK, eventually.** Two morphisms at a stage which agree over the
limit agree after restriction to every late enough stage. -/
theorem eventually_restrictHom_eq {b j : Iᵒᵖ} (e : j ⟶ b) {Y Z : Over (C.diagram.obj b)}
    (hY : C.IsStageObject Y) (hZ' : C.IsStageObject Z)
    {m m' : (Over.pullback (C.diagram.map e)).obj Y ⟶ (Over.pullback (C.diagram.map e)).obj Z}
    (h : C.limitHom e m = C.limitHom e m') :
    Eventually j (fun _ c => C.restrictHom e c (c ≫ e) rfl m =
      C.restrictHom e c (c ≫ e) rfl m') := by
  obtain ⟨k, a, hk⟩ := C.exists_restrictHom_eq_of_limitHom_eq e hY hZ' m m' h
  exact ⟨k.unop, fun l c hl => C.restrictHom_eq_of_eq e a hk (homOfLE hl).op c⟩

end AlgebraicGeometry.Stack.ConventionalStackDescentSystem

