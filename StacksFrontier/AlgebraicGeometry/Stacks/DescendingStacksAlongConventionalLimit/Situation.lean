/-!
# The situation of Stacks 0CN4 under the convention, and its reduction

The situation `AlgebraicGeometry.Stack.ConventionalStackDescentSystem` of Stacks 0CN4: a directed
inverse system `(X_i)` of quasi-compact, quasi-separated algebraic spaces over `S` with affine
transition morphisms satisfying the chapter's standing convention of Section 70.2 (tag 07SD), with
limit `X = lim X_i`; the forms of Stacks 07SF, 07SK and 0CN2 in it; the reduction of Stacks 0CN4
to the descent of a groupoid to a stage and to a model of its quotient stack at the stage; and the
transport of morphisms between base changes along an iterated base change.

## Implementation notes

The situation `AlgebraicGeometry.Stack.ConventionalStackDescentSystem` replaces the bound on the
index of `AlgebraicGeometry.Stack.StackDescentSystem` by the convention, and the descent results
of Limits of Spaces used in the proof (Stacks 07SF, 07SK, 0CN2) are their forms under the
convention, `AlgebraicGeometry.Space.isAlgebraicSpace_limit_of_siteContainsBaseChangeLimits`,
`AlgebraicGeometry.Space.isAffineHom_limitπ_of_siteContainsBaseChangeLimits`,
`AlgebraicGeometry.Space.exists_model_of_finitePresentation_of_siteContainsBaseChangeLimits`,
`AlgebraicGeometry.Space.exists_morphism_after_baseChange_of_siteContainsBaseChangeLimits`,
`AlgebraicGeometry.Space.eventually_eq_of_baseChange_eq_of_siteContainsBaseChangeLimits` and
`AlgebraicGeometry.Space.exists_isSmooth_mapAt_of_siteContainsBaseChangeLimits`.

## References

* [Stacks Project, Tag 0CN4](https://stacks.math.columbia.edu/tag/0CN4)
* [Stacks Project, Tag 07SD](https://stacks.math.columbia.edu/tag/07SD)
-/

@[expose] public section

universe u v w

/-! ### The situation of Stacks 0CN4 under the convention -/

section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Stack

/-- **The situation of Stacks 0CN4, under the chapter's convention**: a directed inverse system
of quasi-compact, quasi-separated algebraic spaces over `S` with affine transition morphisms
satisfying the convention of Section 70.2 (tag 07SD), with no bound on the index. -/
structure ConventionalStackDescentSystem (B : BigFppfSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S)
    (hZ : B.Contains (⊤_ Scheme.{u})) (I : Type u) [Preorder I] [IsDirected I (· ≤ ·)]
    [Nonempty I] where
  /-- The inverse system `(X_i)` of presheaves on the big fppf site over `S`, carried as a
  covariant diagram on the cofiltered category `Iᵒᵖ`. -/
  diagram : Iᵒᵖ ⥤ (BigFppfOver B S hS)ᵒᵖ ⥤ Type u
  /-- Every stage is an algebraic space over `S`. -/
  stage_isAlgebraicSpace : ∀ i, IsAlgebraicSpace B S hS (diagram.obj i)
  /-- Every transition morphism is affine. -/
  transition_affine : ∀ {i j : Iᵒᵖ} (f : i ⟶ j), Space.IsAffineHom B S hS (diagram.map f)
  /-- Every stage is quasi-compact. -/
  stage_quasiCompact : ∀ i, Space.IsQuasiCompactSpace B S hS (diagram.obj i)
  /-- Every stage is quasi-separated. -/
  stage_quasiSeparated : ∀ i, Space.IsAbsolutelyQuasiSeparated B S hS hZ (diagram.obj i)
  /-- The chapter's convention of Section 70.2 (tag 07SD). -/
  convention : Space.SiteContainsBaseChangeLimits B S hS diagram

namespace ConventionalStackDescentSystem

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {hZ : B.Contains (⊤_ Scheme.{u})} {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)]
    [Nonempty I]
    (C : ConventionalStackDescentSystem B S hS hZ I)

/-- **Stacks 07SF.** The limit `X = lim X_i` of the system is an algebraic space over `S`. -/
theorem limit_isAlgebraicSpace (C : ConventionalStackDescentSystem B S hS hZ I) :
    IsAlgebraicSpace B S hS (limit C.diagram) :=
  Space.isAlgebraicSpace_limit_of_siteContainsBaseChangeLimits B S hS C.diagram C.convention
    C.stage_isAlgebraicSpace C.transition_affine C.stage_quasiCompact

/-- Each projection `X ⟶ X_i` out of the limit is affine, the transition morphisms being so. -/
theorem limitπ_isAffineHom (C : ConventionalStackDescentSystem B S hS hZ I)
    (i : Iᵒᵖ) : Space.IsAffineHom B S hS (limit.π C.diagram i) :=
  Space.isAffineHom_limitπ_of_siteContainsBaseChangeLimits B S hS C.diagram C.convention
    C.transition_affine i

/-- The limit `X = lim X_i` is quasi-compact: the projection to a stage is affine, hence
quasi-compact, and the base change of that projection along the identity of the stage is the
limit itself. -/
theorem limit_quasiCompact (C : ConventionalStackDescentSystem B S hS hZ I) :
    Space.IsQuasiCompactSpace B S hS (limit C.diagram) := by
  obtain ⟨i⟩ : Nonempty Iᵒᵖ := inferInstance
  have hqc : Space.IsQuasiCompact B S hS (limit.π C.diagram i) :=
    Space.isQuasiCompact_of_isAffineHom' B S hS (limit.π C.diagram i)
      C.limit_isAlgebraicSpace (C.stage_isAlgebraicSpace i) (C.limitπ_isAffineHom i)
  let e : pullback (𝟙 (C.diagram.obj i)) (limit.π C.diagram i) ≅ limit C.diagram :=
    asIso (pullback.snd (𝟙 (C.diagram.obj i)) (limit.π C.diagram i))
  exact Space.isQuasiCompactSpace_of_iso B S hS e
    (hqc (C.diagram.obj i) (C.stage_isAlgebraicSpace i) (C.stage_quasiCompact i)
      (𝟙 (C.diagram.obj i)))

/-- The limit `X = lim X_i` is quasi-separated: it is affine, hence quasi-separated, over a
quasi-separated stage. -/
theorem limit_quasiSeparated (C : ConventionalStackDescentSystem B S hS hZ I) :
    Space.IsAbsolutelyQuasiSeparated B S hS hZ (limit C.diagram) := by
  obtain ⟨i⟩ : Nonempty Iᵒᵖ := inferInstance
  exact Space.isAbsolutelyQuasiSeparated_of_isQuasiSeparated B S hS hZ
    C.limit_isAlgebraicSpace (C.stage_quasiSeparated i)
    (Space.isQuasiSeparated_of_isAffineHom B S hS (limit.π C.diagram i)
      C.limit_isAlgebraicSpace (C.stage_isAlgebraicSpace i) (C.limitπ_isAffineHom i))

/-- The limit `X = lim X_i`, as an object of the category of algebraic spaces over `S`. -/
noncomputable abbrev limitSpace : AlgebraicSpaces B S hS :=
  ⟨limit C.diagram, C.limit_isAlgebraicSpace⟩

/-- The stage `X_i`, as an object of the category of algebraic spaces over `S`. -/
abbrev stageSpace (C : ConventionalStackDescentSystem B S hS hZ I)
    (i : Iᵒᵖ) : AlgebraicSpaces B S hS :=
  ⟨C.diagram.obj i, C.stage_isAlgebraicSpace i⟩

/-- The projection `X ⟶ X_i`, as a morphism of algebraic spaces over `S`. -/
noncomputable abbrev limitProjection (C : ConventionalStackDescentSystem B S hS hZ I)
    (i : Iᵒᵖ) : C.limitSpace ⟶ C.stageSpace i :=
  ObjectProperty.homMk (limit.π C.diagram i)

/-- The limit `X = lim X_i`, as an algebraic stack over `S`. -/
noncomputable abbrev limitStack (C : ConventionalStackDescentSystem B S hS hZ I) :
    AlgebraicStacks.{u, w} B S hS :=
  algebraicSpaceStack.{u, w} B S hS (limit C.diagram) C.limit_isAlgebraicSpace

/-- The stage `X_i`, as an algebraic stack over `S`. -/
abbrev stageStack (C : ConventionalStackDescentSystem B S hS hZ I)
    (i : Iᵒᵖ) : AlgebraicStacks.{u, w} B S hS :=
  algebraicSpaceStack.{u, w} B S hS (C.diagram.obj i) (C.stage_isAlgebraicSpace i)

/-- The projection `X ⟶ X_i`, as a 1-morphism of algebraic stacks over `S`. -/
noncomputable abbrev limitStackProjection (C : ConventionalStackDescentSystem B S hS hZ I)
    (i : Iᵒᵖ) :
    C.limitStack.{u, w} ⟶ C.stageStack.{u, w} i :=
  Bicategory.InducedBicategory.mkHom (associatedMap B S hS (limit.π C.diagram i)).1

/-! ### Stacks 07SK in the situation of Stacks 0CN4 -/

/-- **Stacks 07SK, essential surjectivity, in the situation of Stacks 0CN4.** An algebraic space
of finite presentation over the limit `X = lim X_i` is the base change, along some projection
`X ⟶ X_i`, of an algebraic space of finite presentation over `X_i`. -/
theorem exists_stage_model_of_isFinitePresentation_over_limit
    (C : ConventionalStackDescentSystem B S hS hZ I)
    {F : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hF : IsAlgebraicSpace B S hS F)
    (p : F ⟶ limit C.diagram) (hp : Space.IsFinitePresentation B S hS p) :
    ∃ (i : Iᵒᵖ) (Fᵢ : Over (C.diagram.obj i)),
      IsAlgebraicSpace B S hS Fᵢ.left ∧ Space.IsFinitePresentation B S hS Fᵢ.hom ∧
        Nonempty (Over.mk p ≅ (Over.pullback (limit.π C.diagram i)).obj Fᵢ) :=
  Space.exists_model_of_finitePresentation_of_siteContainsBaseChangeLimits (B := B) (S := S)
    (hS := hS) (hZ := hZ) (D := C.diagram) (hD := C.stage_isAlgebraicSpace)
    (hAffine := C.transition_affine) (hQc := C.stage_quasiCompact)
    (hQs := C.stage_quasiSeparated) (hconv := C.convention) (hDlim := C.limit_isAlgebraicSpace)
    (Over.mk p) hF hp

/-- **Stacks 07SK, essential surjectivity, for the object space of a groupoid over the limit.**
The object space of a groupoid in algebraic spaces over `X` which is of finite presentation over
`X` comes from a stage. -/
theorem exists_stage_model_objects (C : ConventionalStackDescentSystem B S hS hZ I)
    (G : GroupoidInAlgebraicSpaces B S hS C.limitSpace)
    (hU : Space.IsFinitePresentation B S hS G.objectsToBase.hom) :
    ∃ (i : Iᵒᵖ) (Uᵢ : Over (C.diagram.obj i)),
      IsAlgebraicSpace B S hS Uᵢ.left ∧ Space.IsFinitePresentation B S hS Uᵢ.hom ∧
        Nonempty (Over.mk G.objectsToBase.hom ≅
          (Over.pullback (limit.π C.diagram i)).obj Uᵢ) :=
  C.exists_stage_model_of_isFinitePresentation_over_limit G.objects.property
    G.objectsToBase.hom hU

/-- **Stacks 07SK, essential surjectivity, for the arrow space of a groupoid over the limit.**
The arrow space of a groupoid in algebraic spaces over `X` which is of finite presentation over
`X` comes from a stage. -/
theorem exists_stage_model_arrows (C : ConventionalStackDescentSystem B S hS hZ I)
    (G : GroupoidInAlgebraicSpaces B S hS C.limitSpace)
    (hR : Space.IsFinitePresentation B S hS G.arrowsToBase.hom) :
    ∃ (i : Iᵒᵖ) (Rᵢ : Over (C.diagram.obj i)),
      IsAlgebraicSpace B S hS Rᵢ.left ∧ Space.IsFinitePresentation B S hS Rᵢ.hom ∧
        Nonempty (Over.mk G.arrowsToBase.hom ≅
          (Over.pullback (limit.π C.diagram i)).obj Rᵢ) :=
  C.exists_stage_model_of_isFinitePresentation_over_limit G.arrows.property
    G.arrowsToBase.hom hR

/-! ### Stacks 0CN2 in the situation of Stacks 0CN4 -/

/-- **The situation of Stacks 084W attached to a morphism over a stage.** A morphism of algebraic
spaces of finite presentation over a stage `X_i` of the system, read as a morphism descent system
in the sense of Stacks 084W (`AlgebraicGeometry.Space.MorphismDescentSituation`).

The source and the target are quasi-compact and quasi-separated, being of finite presentation
over the quasi-compact, quasi-separated stage. -/
noncomputable def morphismDescentSystem (i : Iᵒᵖ) (X₀ Y₀ : Over (C.diagram.obj i))
    (hX₀ : IsAlgebraicSpace B S hS X₀.left) (hY₀ : IsAlgebraicSpace B S hS Y₀.left)
    (hX₀fp : Space.IsFinitePresentation B S hS X₀.hom)
    (hY₀fp : Space.IsFinitePresentation B S hS Y₀.hom) (f₀ : X₀ ⟶ Y₀) :
    Space.MorphismDescentSituation B S hS hZ I where
  base := C.diagram
  base_isAlgebraicSpace := fun j => C.stage_isAlgebraicSpace (Opposite.op j)
  transition_affine := C.transition_affine
  limit_isAlgebraicSpace := C.limit_isAlgebraicSpace
  initial := i.unop
  source₀ := X₀.left
  target₀ := Y₀.left
  sourceToBase := X₀.hom
  targetToBase := Y₀.hom
  map₀ := f₀.left
  map₀_over := Over.w f₀
  source₀_isAlgebraicSpace := hX₀
  target₀_isAlgebraicSpace := hY₀
  base₀_quasiCompact := C.stage_quasiCompact i
  base₀_quasiSeparated := C.stage_quasiSeparated i
  source₀_quasiCompact :=
    Space.isQuasiCompactSpace_of_isFinitePresentation B S hS X₀.hom
      (C.stage_isAlgebraicSpace i) (C.stage_quasiCompact i) hX₀fp
  source₀_quasiSeparated :=
    Space.isAbsolutelyQuasiSeparated_of_isQuasiSeparated B S hS hZ hX₀
      (C.stage_quasiSeparated i) hX₀fp.2.2
  target₀_quasiCompact :=
    Space.isQuasiCompactSpace_of_isFinitePresentation B S hS Y₀.hom
      (C.stage_isAlgebraicSpace i) (C.stage_quasiCompact i) hY₀fp
  target₀_quasiSeparated :=
    Space.isAbsolutelyQuasiSeparated_of_isQuasiSeparated B S hS hZ hY₀
      (C.stage_quasiSeparated i) hY₀fp.2.2

/-- **Stacks 0CN2 in the situation of Stacks 0CN4.** A morphism of algebraic spaces of finite
presentation over a stage whose base change to the limit is smooth, and which is itself locally of
finite presentation, becomes smooth after base change along some further transition morphism of
the system. -/
theorem exists_isSmooth_mapAt_of_isSmooth_mapLimit (C : ConventionalStackDescentSystem B S hS hZ I)
    (i : Iᵒᵖ) (X₀ Y₀ : Over (C.diagram.obj i))
    (hX₀ : IsAlgebraicSpace B S hS X₀.left) (hY₀ : IsAlgebraicSpace B S hS Y₀.left)
    (hX₀fp : Space.IsFinitePresentation B S hS X₀.hom)
    (hY₀fp : Space.IsFinitePresentation B S hS Y₀.hom) (f₀ : X₀ ⟶ Y₀)
    (hfp : Space.IsLocallyOfFinitePresentation B S hS f₀.left)
    (hsmooth : Space.IsSmooth B S hS
      (C.morphismDescentSystem i X₀ Y₀ hX₀ hY₀ hX₀fp hY₀fp f₀).mapLimit) :
    ∃ (j : Iᵒᵖ) (g : j ⟶ i),
      Space.IsSmooth B S hS
        ((C.morphismDescentSystem i X₀ Y₀ hX₀ hY₀ hX₀fp hY₀fp f₀).mapAt j.unop
          (leOfHom g.unop)) := by
  obtain ⟨k, hk, h⟩ :=
    Space.MorphismDescentSituation.exists_isSmooth_mapAt_of_siteContainsBaseChangeLimits
    (C.morphismDescentSystem i X₀ Y₀ hX₀ hY₀ hX₀fp hY₀fp f₀) C.convention hsmooth hfp
  exact ⟨Opposite.op k, (homOfLE hk).op, h⟩

variable (C : ConventionalStackDescentSystem B S hS hZ I)

/-- **Stacks 07SK and Stacks 0CN2 read on a groupoid object.** A smooth groupoid in algebraic
spaces over the limit `X` whose object and arrow spaces are of finite presentation over `X` is,
up to equivalence of quotient stacks over `X`, the base change of a smooth groupoid over some
stage `X_i` whose object and arrow spaces are of finite presentation over `X_i`. -/
abbrev SmoothGroupoidDescendsToStage : Prop :=
  ∀ G : GroupoidInAlgebraicSpaces B S hS C.limitSpace,
    GroupoidInAlgebraicSpaces.IsSmooth B S hS G →
    Space.IsFinitePresentation B S hS G.objectsToBase.hom →
    Space.IsFinitePresentation B S hS G.arrowsToBase.hom →
    ∃ (i : Iᵒᵖ) (Gᵢ : GroupoidInAlgebraicSpaces B S hS (C.stageSpace i)),
      GroupoidInAlgebraicSpaces.IsSmooth B S hS Gᵢ ∧
        Space.IsFinitePresentation B S hS Gᵢ.objectsToBase.hom ∧
        Space.IsFinitePresentation B S hS Gᵢ.arrowsToBase.hom ∧
        Nonempty (BasedCategory.EquivalenceOver (quotientStackToBase G)
          (quotientStackToBase (Space.baseChange Gᵢ (C.limitProjection i)).groupoid))

/-- **Stacks 07SK and Stacks 0CN2 for a groupoid object with descended object and arrow
spaces.** Given a smooth groupoid over the limit `X` together with models of its object and arrow
spaces over two stages, there is a smooth groupoid over a stage, with object and arrow spaces of
finite presentation over it, whose base change to `X` has, over `X`, the same quotient stack. -/
abbrev GroupoidStructureDescendsToStage : Prop :=
  ∀ G : GroupoidInAlgebraicSpaces B S hS C.limitSpace,
    GroupoidInAlgebraicSpaces.IsSmooth B S hS G →
    ∀ (iU : Iᵒᵖ) (Uᵢ : Over (C.diagram.obj iU)),
      IsAlgebraicSpace B S hS Uᵢ.left → Space.IsFinitePresentation B S hS Uᵢ.hom →
      (Over.mk G.objectsToBase.hom ≅ (Over.pullback (limit.π C.diagram iU)).obj Uᵢ) →
    ∀ (iR : Iᵒᵖ) (Rᵢ : Over (C.diagram.obj iR)),
      IsAlgebraicSpace B S hS Rᵢ.left → Space.IsFinitePresentation B S hS Rᵢ.hom →
      (Over.mk G.arrowsToBase.hom ≅ (Over.pullback (limit.π C.diagram iR)).obj Rᵢ) →
    ∃ (i : Iᵒᵖ) (Gᵢ : GroupoidInAlgebraicSpaces B S hS (C.stageSpace i)),
      GroupoidInAlgebraicSpaces.IsSmooth B S hS Gᵢ ∧
        Space.IsFinitePresentation B S hS Gᵢ.objectsToBase.hom ∧
        Space.IsFinitePresentation B S hS Gᵢ.arrowsToBase.hom ∧
        Nonempty (BasedCategory.EquivalenceOver (quotientStackToBase G)
          (quotientStackToBase (Space.baseChange Gᵢ (C.limitProjection i)).groupoid))

/-- **Stacks 07SK and Stacks 0CN2 for a groupoid object.** If the groupoid structure of a smooth
groupoid over the limit descends once its object and arrow spaces do, then every smooth groupoid
over the limit whose object and arrow spaces are of finite presentation over the limit descends
to a stage. -/
theorem smoothGroupoidDescendsToStage (C : ConventionalStackDescentSystem B S hS hZ I)
    (hStructure : C.GroupoidStructureDescendsToStage) :
    C.SmoothGroupoidDescendsToStage := by
  intro G hGsmooth hU hR
  obtain ⟨iU, Uᵢ, hUalg, hUfp, ⟨eU⟩⟩ := C.exists_stage_model_objects G hU
  obtain ⟨iR, Rᵢ, hRalg, hRfp, ⟨eR⟩⟩ := C.exists_stage_model_arrows G hR
  exact hStructure G hGsmooth iU Uᵢ hUalg hUfp eU iR Rᵢ hRalg hRfp eR

/-! ### The stage model: the universe datum, Stacks 06Q2, and the Stacks 04Y1 comparison -/

/-- **A model of a quotient stack in the 2-category of algebraic stacks over `S`.** An algebraic
stack over `S` with a 1-morphism to the stage `X_i`, together with an identification over `X_i` of
its category with the quotient stack `[U_i/R_i]`.

A quotient stack is not itself an object of `AlgebraicGeometry.Stack.AlgebraicStacks`, since its
hom sets lie one universe higher. -/
structure QuotientStackModel (i : Iᵒᵖ)
    (Gᵢ : GroupoidInAlgebraicSpaces B S hS (C.stageSpace i)) where
  /-- The algebraic stack over `S` modelling `[U_i/R_i]`. -/
  stack : AlgebraicStacks.{u, w} B S hS
  /-- Its structure 1-morphism to the stage. -/
  structureMorphism : stack ⟶ C.stageStack.{u, w} i
  /-- The identification with the quotient stack, over the stage. -/
  equivOver : BasedCategory.EquivalenceOver (quotientStackToBase Gᵢ)
    structureMorphism.hom.hom

/-- **The universe-lifting datum for a quotient stack.** Every algebraic quotient stack of a
groupoid over a stage has a model in the 2-category of algebraic stacks over `S`.

The statement asserts no property of `[U_i/R_i]` beyond its algebraicity, only that the quotient
stack, a `CategoryTheory.BasedCategory.{u + 1, u + 1}`, is equivalent over the stage to an object
whose hom sets lie in universe `u`. -/
abbrev StageStackModel : Prop :=
  ∀ (i : Iᵒᵖ) (Gᵢ : GroupoidInAlgebraicSpaces B S hS (C.stageSpace i)),
    IsAlgebraicStack.{u, w} B S hS (quotientStack Gᵢ) →
      Nonempty (C.QuotientStackModel.{u, w} i Gᵢ)

/-- **Stacks 06Q2 for the model of a quotient stack.** The model of the quotient stack of a smooth
groupoid whose object and arrow spaces are of finite presentation over the stage is of finite
presentation over the stage. -/
abbrev ModelIsFinitePresentation : Prop :=
  ∀ (i : Iᵒᵖ) (Gᵢ : GroupoidInAlgebraicSpaces B S hS (C.stageSpace i))
    (M : C.QuotientStackModel.{u, w} i Gᵢ),
    GroupoidInAlgebraicSpaces.IsSmooth B S hS Gᵢ →
    Space.IsFinitePresentation B S hS Gᵢ.objectsToBase.hom →
    Space.IsFinitePresentation B S hS Gᵢ.arrowsToBase.hom →
      AlgebraicStacks.IsFinitePresentation B S hS M.structureMorphism

/-- **Stacks 044P, 044R, 046Q and 04Y1 for a base-changed groupoid.** The quotient stack of the
base change of `G_i` along `X ⟶ X_i` is, over `X`, the 2-fibre product of the model of `[U_i/R_i]`
with `X` over `X_i`. -/
abbrev ModelBaseChangeComparison : Prop :=
  ∀ (i : Iᵒᵖ) (Gᵢ : GroupoidInAlgebraicSpaces B S hS (C.stageSpace i))
    (M : C.QuotientStackModel.{u, w} i Gᵢ),
    Nonempty (BasedCategory.EquivalenceOver
      (quotientStackToBase (Space.baseChange Gᵢ (C.limitProjection i)).groupoid)
      (twoFibreProductSquareAlgebraicStacks.{u, w} B S hS M.structureMorphism
        (C.limitStackProjection.{u, w} i)).snd.hom.hom)

/-- **The stage model of a smooth groupoid.** For every smooth groupoid `G_i` over a stage `X_i`
with algebraic quotient stack and object and arrow spaces of finite presentation over `X_i`,
there is an algebraic stack `𝒳_i` of finite presentation over `X_i` such that the quotient stack
of the base change of `G_i` to `X` is, over `X`, the 2-fibre product `𝒳_i ×_{X_i} X`. -/
abbrev StageModelOfSmoothGroupoid : Prop :=
  ∀ (i : Iᵒᵖ) (Gᵢ : GroupoidInAlgebraicSpaces B S hS (C.stageSpace i)),
    IsAlgebraicStack.{u, w} B S hS (quotientStack Gᵢ) →
    GroupoidInAlgebraicSpaces.IsSmooth B S hS Gᵢ →
    Space.IsFinitePresentation B S hS Gᵢ.objectsToBase.hom →
    Space.IsFinitePresentation B S hS Gᵢ.arrowsToBase.hom →
    ∃ (𝒳ᵢ : AlgebraicStacks.{u, w} B S hS) (fᵢ : 𝒳ᵢ ⟶ C.stageStack.{u, w} i),
      AlgebraicStacks.IsFinitePresentation B S hS fᵢ ∧
        Nonempty (BasedCategory.EquivalenceOver
          (quotientStackToBase (Space.baseChange Gᵢ (C.limitProjection i)).groupoid)
          (twoFibreProductSquareAlgebraicStacks.{u, w} B S hS fᵢ
            (C.limitStackProjection.{u, w} i)).snd.hom.hom)

/-- A smooth groupoid over a stage has a stage model as soon as its quotient stack has a model
in the 2-category of algebraic stacks, every such model is of finite presentation over the stage,
and every such model compares with the quotient stack of the base change to the limit. -/
theorem stageModelOfSmoothGroupoid (C : ConventionalStackDescentSystem B S hS hZ I)
    (hModel : C.StageStackModel.{u, w})
    (hFp : C.ModelIsFinitePresentation.{u, w})
    (hComparison : C.ModelBaseChangeComparison.{u, w}) :
    C.StageModelOfSmoothGroupoid.{u, w} := by
  intro i Gᵢ hGᵢalg hGᵢsmooth hGᵢobjects hGᵢarrows
  obtain ⟨M⟩ := hModel i Gᵢ hGᵢalg
  exact ⟨M.stack, M.structureMorphism,
    hFp i Gᵢ M hGᵢsmooth hGᵢobjects hGᵢarrows, hComparison i Gᵢ M⟩

/-- **Stacks 0CN4.** Let `(X_i)` be a directed inverse system of quasi-compact, quasi-separated
algebraic spaces over `S` with affine transition morphisms, and let `X = lim X_i`. If `𝒳` is an
algebraic stack of finite presentation over `X`, then there are a stage `i` and an algebraic
stack `𝒳_i` of finite presentation over `X_i` with `𝒳 ≅ 𝒳_i ×_{X_i} X` as algebraic stacks
over `X`, provided that algebraic stacks of finite presentation over a quasi-compact,
quasi-separated algebraic space have smooth groupoid presentations, that smooth groupoids over
the limit descend to a stage once their object and arrow spaces do, and that quotient stacks of
smooth groupoids at a stage have models of finite presentation comparing with base change. -/
theorem exists_stage_model_of_isFinitePresentation (C : ConventionalStackDescentSystem B S hS hZ I)
    (hPresentation : GroupoidPresentationOfAffineSmoothChart.{u, w} B S hS hZ)
    (hDescent : C.GroupoidStructureDescendsToStage)
    (hStageStackModel : C.StageStackModel.{u, w})
    (hModelFinitePresentation : C.ModelIsFinitePresentation.{u, w})
    (hModelComparison : C.ModelBaseChangeComparison.{u, w})
    (𝒳 : AlgebraicStacks.{u, w} B S hS) (f : 𝒳 ⟶ C.limitStack.{u, w})
    (hf : AlgebraicStacks.IsFinitePresentation B S hS f) :
    ∃ (i : Iᵒᵖ) (𝒳ᵢ : AlgebraicStacks.{u, w} B S hS) (fᵢ : 𝒳ᵢ ⟶ C.stageStack.{u, w} i),
      AlgebraicStacks.IsFinitePresentation B S hS fᵢ ∧
        ∃ e : Bicategory.Equivalence 𝒳
          (twoFibreProductAlgebraicStack.{u, w} B S hS fᵢ
            (C.limitStackProjection.{u, w} i)),
          Nonempty (e.hom ≫ (twoFibreProductSquareAlgebraicStacks.{u, w} B S hS fᵢ
            (C.limitStackProjection.{u, w} i)).snd ≅ f) := by
  obtain ⟨P⟩ := hasSmoothPresentationOverBase.{u, w} B S hS hZ hPresentation
    C.limitSpace C.limit_quasiCompact C.limit_quasiSeparated 𝒳 f hf
  obtain ⟨i, Gᵢ, hGᵢsmooth, hGᵢobjects, hGᵢarrows, ⟨eDescent⟩⟩ :=
    C.smoothGroupoidDescendsToStage hDescent P.groupoid P.isSmooth
      P.objects_finitePresentation P.arrows_finitePresentation
  have hGᵢalgebraic : IsAlgebraicStack.{u, w} B S hS (quotientStack Gᵢ) :=
    isAlgebraicStack_quotientStack_of_isSmooth hGᵢsmooth
  obtain ⟨𝒳ᵢ, fᵢ, hfᵢ, ⟨eModel⟩⟩ :=
    C.stageModelOfSmoothGroupoid hStageStackModel hModelFinitePresentation hModelComparison
      i Gᵢ hGᵢalgebraic hGᵢsmooth hGᵢobjects hGᵢarrows
  refine ⟨i, 𝒳ᵢ, fᵢ, hfᵢ,
    equivalenceOfBasedEquivalence.{u, w} B S hS ((P.equivOver.trans eDescent).trans eModel).equiv,
    ⟨isoMkAlgebraicStacks.{u, w} B S hS ((P.equivOver.trans eDescent).trans eModel).compIso⟩⟩

end ConventionalStackDescentSystem

end AlgebraicGeometry.Stack

end

/-! ### Morphisms at a stage and over the limit -/

section

open CategoryTheory CategoryTheory.Limits

namespace CategoryTheory.Over


variable {𝒜 : Type u} [Category.{v} 𝒜] [HasPullbacks 𝒜]

attribute [local simp] pullback.lift_fst pullback.lift_snd pullback.lift_fst_assoc
  pullback.lift_snd_assoc

/-- The comparison from an iterated fibre product to the fibre product along the composite. -/
noncomputable def pullbackPasteHom {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C') (h : A ⟶ C')
    (w : f ≫ g = h) (Y : Over C') :
    Limits.pullback (pullback.snd Y.hom g) f ⟶ Limits.pullback Y.hom h :=
  pullback.lift (pullback.fst _ _ ≫ pullback.fst _ _) (pullback.snd _ _) (by
    rw [Category.assoc, pullback.condition (f := Y.hom) (g := g), ← Category.assoc,
      pullback.condition (f := pullback.snd Y.hom g) (g := f), Category.assoc, w])

/-- The comparison from the fibre product along the composite to the iterated fibre product. -/
noncomputable def pullbackPasteInv {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C') (h : A ⟶ C')
    (w : f ≫ g = h) (Y : Over C') :
    Limits.pullback Y.hom h ⟶ Limits.pullback (pullback.snd Y.hom g) f :=
  pullback.lift (pullback.lift (pullback.fst _ _) (pullback.snd _ _ ≫ f) (by
      rw [pullback.condition, Category.assoc, w])) (pullback.snd _ _) (by
    rw [pullback.lift_snd])

/-- The first projection of `pullbackPasteHom` is the composite of the two first projections. -/
@[reassoc (attr := simp)]
theorem pullbackPasteHom_fst {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C') (h : A ⟶ C')
    (w : f ≫ g = h) (Y : Over C') :
    pullbackPasteHom f g h w Y ≫ pullback.fst Y.hom h =
      pullback.fst (pullback.snd Y.hom g) f ≫ pullback.fst Y.hom g :=
  pullback.lift_fst _ _ _

/-- The second projection of `pullbackPasteHom` is the second projection of the iterated fibre
product. -/
@[reassoc (attr := simp)]
theorem pullbackPasteHom_snd {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C') (h : A ⟶ C')
    (w : f ≫ g = h) (Y : Over C') :
    pullbackPasteHom f g h w Y ≫ pullback.snd Y.hom h = pullback.snd (pullback.snd Y.hom g) f :=
  pullback.lift_snd _ _ _

/-- `pullbackPasteInv` followed by the two first projections is the first projection. -/
@[reassoc (attr := simp)]
theorem pullbackPasteInv_fst_fst {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C') (h : A ⟶ C')
    (w : f ≫ g = h) (Y : Over C') :
    pullbackPasteInv f g h w Y ≫ pullback.fst (pullback.snd Y.hom g) f ≫ pullback.fst Y.hom g =
      pullback.fst Y.hom h := by
  simp [pullbackPasteInv]

/-- `pullbackPasteInv` followed by the first and then the second projection is the second
projection followed by `f`. -/
@[reassoc (attr := simp)]
theorem pullbackPasteInv_fst_snd {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C') (h : A ⟶ C')
    (w : f ≫ g = h) (Y : Over C') :
    pullbackPasteInv f g h w Y ≫ pullback.fst (pullback.snd Y.hom g) f ≫ pullback.snd Y.hom g =
      pullback.snd Y.hom h ≫ f := by
  simp [pullbackPasteInv]

/-- The second projection of `pullbackPasteInv` is the second projection. -/
@[reassoc (attr := simp)]
theorem pullbackPasteInv_snd {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C') (h : A ⟶ C')
    (w : f ≫ g = h) (Y : Over C') :
    pullbackPasteInv f g h w Y ≫ pullback.snd (pullback.snd Y.hom g) f = pullback.snd Y.hom h := by
  simp [pullbackPasteInv]

/-- **Two successive base changes are one base change along the composite.** For `f ≫ g = h`,
the canonical isomorphism of functors `Over C' ⥤ Over A` from base change along `g` followed by
base change along `f` to base change along `h`, with its components the canonical comparisons of
iterated fibre products. -/
noncomputable def pullbackPasteIso {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C') (h : A ⟶ C')
    (w : f ≫ g = h) : Over.pullback g ⋙ Over.pullback f ≅ Over.pullback h :=
  NatIso.ofComponents
    (fun Y => Over.isoMk
      { hom := pullbackPasteHom f g h w Y
        inv := pullbackPasteInv f g h w Y
        hom_inv_id := by
          apply pullback.hom_ext
          · apply pullback.hom_ext
            · simp
            · simp only [Category.assoc]
              change pullbackPasteHom f g h w Y ≫ pullbackPasteInv f g h w Y ≫
                  pullback.fst (pullback.snd Y.hom g) f ≫ pullback.snd Y.hom g =
                𝟙 _ ≫ pullback.fst (pullback.snd Y.hom g) f ≫ pullback.snd Y.hom g
              rw [pullbackPasteInv_fst_snd, pullbackPasteHom_snd_assoc, Category.id_comp]
              exact (pullback.condition (f := pullback.snd Y.hom g) (g := f)).symm
          · simp
        inv_hom_id := by apply pullback.hom_ext <;> simp }
      (by simp))
    (by
      intro Y Z m
      ext
      apply pullback.hom_ext
      · simp
      · simp)

/-- The first projection of a component of `pullbackPasteIso` is the composite of the two first
projections. -/
@[reassoc (attr := simp)]
theorem pullbackPasteIso_hom_app_left_fst {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C')
    (h : A ⟶ C') (w : f ≫ g = h) (Y : Over C') :
    ((pullbackPasteIso f g h w).hom.app Y).left ≫ pullback.fst Y.hom h =
      pullback.fst (pullback.snd Y.hom g) f ≫ pullback.fst Y.hom g :=
  pullbackPasteHom_fst f g h w Y

/-- The second projection of a component of `pullbackPasteIso` is the second projection of the
iterated fibre product. -/
@[reassoc (attr := simp)]
theorem pullbackPasteIso_hom_app_left_snd {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C')
    (h : A ⟶ C') (w : f ≫ g = h) (Y : Over C') :
    ((pullbackPasteIso f g h w).hom.app Y).left ≫ pullback.snd Y.hom h =
      pullback.snd (pullback.snd Y.hom g) f :=
  pullbackPasteHom_snd f g h w Y

/-- A component of the inverse of `pullbackPasteIso` followed by the two first projections is
the first projection. -/
@[reassoc (attr := simp)]
theorem pullbackPasteIso_inv_app_left_fst_fst {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C')
    (h : A ⟶ C') (w : f ≫ g = h) (Y : Over C') :
    ((pullbackPasteIso f g h w).inv.app Y).left ≫ pullback.fst (pullback.snd Y.hom g) f ≫
      pullback.fst Y.hom g = pullback.fst Y.hom h :=
  pullbackPasteInv_fst_fst f g h w Y

/-- A component of the inverse of `pullbackPasteIso` followed by the first and then the second
projection is the second projection followed by `f`. -/
@[reassoc (attr := simp)]
theorem pullbackPasteIso_inv_app_left_fst_snd {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C')
    (h : A ⟶ C') (w : f ≫ g = h) (Y : Over C') :
    ((pullbackPasteIso f g h w).inv.app Y).left ≫ pullback.fst (pullback.snd Y.hom g) f ≫
      pullback.snd Y.hom g = pullback.snd Y.hom h ≫ f :=
  pullbackPasteInv_fst_snd f g h w Y

/-- The second projection of a component of the inverse of `pullbackPasteIso` is the second
projection. -/
@[reassoc (attr := simp)]
theorem pullbackPasteIso_inv_app_left_snd {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C')
    (h : A ⟶ C') (w : f ≫ g = h) (Y : Over C') :
    ((pullbackPasteIso f g h w).inv.app Y).left ≫ pullback.snd (pullback.snd Y.hom g) f =
      pullback.snd Y.hom h :=
  pullbackPasteInv_snd f g h w Y

/-- A morphism between two base changes along `g`, transported to the base changes along `h`
through one further base change along `f`, for `f ≫ g = h`. -/
noncomputable def transportHom {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C') (h : A ⟶ C')
    (w : f ≫ g = h) {Y Z : Over C'} (m : (Over.pullback g).obj Y ⟶ (Over.pullback g).obj Z) :
    (Over.pullback h).obj Y ⟶ (Over.pullback h).obj Z :=
  (pullbackPasteIso f g h w).inv.app Y ≫ (Over.pullback f).map m ≫
    (pullbackPasteIso f g h w).hom.app Z

/-- Transport preserves composition. -/
theorem transportHom_comp {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C') (h : A ⟶ C')
    (w : f ≫ g = h) {Y Z W : Over C'} (m : (Over.pullback g).obj Y ⟶ (Over.pullback g).obj Z)
    (m' : (Over.pullback g).obj Z ⟶ (Over.pullback g).obj W) :
    transportHom f g h w (m ≫ m') = transportHom f g h w m ≫ transportHom f g h w m' := by
  simp [transportHom]

/-- Transport preserves identities. -/
theorem transportHom_id {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C') (h : A ⟶ C')
    (w : f ≫ g = h) (Y : Over C') :
    transportHom f g h w (𝟙 ((Over.pullback g).obj Y)) = 𝟙 _ := by
  simp [transportHom]

/-- The transport of the base change along `g` of a morphism is its base change along `h`. -/
theorem transportHom_map {A B' C' : 𝒜} (f : A ⟶ B') (g : B' ⟶ C') (h : A ⟶ C')
    (w : f ≫ g = h) {Y Z : Over C'} (m₀ : Y ⟶ Z) :
    transportHom f g h w ((Over.pullback g).map m₀) = (Over.pullback h).map m₀ := by
  have := (pullbackPasteIso f g h w).hom.naturality m₀
  simp only [Functor.comp_map] at this
  simp [transportHom, this]

/-- Transporting twice is transporting once along the composite. -/
theorem transportHom_transportHom {A₁ A B' C' : 𝒜} (f₁ : A₁ ⟶ A) (f : A ⟶ B') (g : B' ⟶ C')
    (h : A ⟶ C') (h₁ : A₁ ⟶ C') (w : f ≫ g = h) (w₁ : f₁ ≫ h = h₁) {Y Z : Over C'}
    (m : (Over.pullback g).obj Y ⟶ (Over.pullback g).obj Z) :
    transportHom f₁ h h₁ w₁ (transportHom f g h w m) =
      transportHom (f₁ ≫ f) g h₁ (by rw [Category.assoc, w, w₁]) m := by
  have key : ∀ {W : 𝒜} (k : Limits.pullback Y.hom g ⟶ W),
      ((pullbackPasteIso f₁ h h₁ w₁).inv.app Y).left ≫ pullback.fst (pullback.snd Y.hom h) f₁ ≫
        ((pullbackPasteIso f g h w).inv.app Y).left ≫ pullback.fst (pullback.snd Y.hom g) f ≫ k =
      ((pullbackPasteIso (f₁ ≫ f) g h₁ (by rw [Category.assoc, w, w₁])).inv.app Y).left ≫
        pullback.fst (pullback.snd Y.hom g) (f₁ ≫ f) ≫ k := by
    intro W k
    simp only [← Category.assoc]
    congr 1
    apply pullback.hom_ext <;> simp
  ext
  apply pullback.hom_ext
  · simp [transportHom, key]
  · have h₁m := Over.w (transportHom (f₁ ≫ f) g h₁ (by rw [Category.assoc, w, w₁]) m)
    have h₂m := Over.w (transportHom f₁ h h₁ w₁ (transportHom f g h w m))
    simp only [Over.pullback_obj_hom] at h₁m h₂m
    rw [h₁m, h₂m]

/-- Transport along equal first maps is the same transport. -/
theorem transportHom_congr {A B' C' : 𝒜} {f f' : A ⟶ B'} (hf : f = f') (g : B' ⟶ C')
    (h : A ⟶ C') (w : f ≫ g = h) (w' : f' ≫ g = h) {Y Z : Over C'}
    (m : (Over.pullback g).obj Y ⟶ (Over.pullback g).obj Z) :
    transportHom f g h w m = transportHom f' g h w' m := by
  subst hf
  rfl

end CategoryTheory.Over

end

end
