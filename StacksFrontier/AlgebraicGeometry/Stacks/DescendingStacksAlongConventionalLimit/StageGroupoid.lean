/-!
# Stacks 0CN4 for systems satisfying the chapter's convention

Let `(X_i)` be a directed inverse system of quasi-compact, quasi-separated algebraic spaces over
`S` with affine transition morphisms satisfying the chapter's standing convention of Section 70.2
(tag 07SD), `AlgebraicGeometry.Space.SiteContainsBaseChangeLimits`, and let `X = lim X_i`. Every
algebraic stack `𝒳` of finite presentation over `X` is a base change from a finite stage: there
are an `i` and an algebraic stack `𝒳_i` of finite presentation over `X_i` with
`𝒳 ≅ 𝒳_i ×_{X_i} X` as algebraic stacks over `X` (Stacks 0CN4).

No bound is placed on the index. The Noetherian approximations of Stacks 07SU satisfy the
convention (`AlgebraicGeometry.Space.hasConventionalNoetherianApproximation_of_etaleAtlas`) but
no bound on the index, and the reduction of Chow's lemma for algebraic stacks (Stacks 0CQ8) to
the Noetherian case applies Stacks 0CN4 to them.

This file builds the groupoid at a stage whose base change to the limit is the given groupoid,
and assembles Stacks 0CN4 from the steps of its proof.

## Main results

* `AlgebraicGeometry.Stack.AlgebraicStacks.finitePresentationStackDescendsStatement_holds`:
  the statement `AlgebraicGeometry.Stack.AlgebraicStacks.FinitePresentationStackDescendsStatement`
  holds.

## References

* [Stacks Project, Tag 0CN4](https://stacks.math.columbia.edu/tag/0CN4)
* [Stacks Project, Tag 07SD](https://stacks.math.columbia.edu/tag/07SD)
-/

section

universe u v w

section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Stack.ConventionalStackDescentSystem

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {hZ : B.Contains (⊤_ Scheme.{u})} {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)]
    [Nonempty I] (C : ConventionalStackDescentSystem B S hS hZ I)

/-- Pullbacks of presheaves on the big fppf site (instance search times out without this
shortcut). -/
local instance hasPullbacks_presheaf_stageGroupoid :
    HasPullbacks ((BigFppfOver B S hS)ᵒᵖ ⥤ Type u) := inferInstance

local instance (priority := high) hasPullback_presheaf_stageGroupoid
    {X Y Z : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : X ⟶ Z) (g : Y ⟶ Z) :
    HasLimit (cospan f g) :=
  HasLimitsOfShape.has_limit _

local instance hasPullbacks_over_presheaf_stageGroupoid
    (X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u) : HasPullbacks (Over X) := inferInstance

local instance (priority := high) hasPullback_over_presheaf_stageGroupoid
    {X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {Y Z W : Over X} (f : Y ⟶ W) (g : Z ⟶ W) :
    HasLimit (cospan f g) :=
  HasLimitsOfShape.has_limit _

variable {C} (G : GroupoidInAlgebraicSpaces B S hS C.limitSpace)

namespace StageMaps

variable {G} (M : C.StageMaps G)

/-! #### The groupoid at the stage -/

namespace StageGroupoid

variable {M} (N : M.StageGroupoid)

/-- The groupoid object of the slice over the stage. -/
noncomputable def groupoidObject : Deformation.GroupoidObject (Over (C.diagram.obj N.stage)) :=
  Deformation.GroupoidObject.ofUniversalLaws
    ((Over.pullback (C.diagram.map N.toBase)).obj M.objects)
    ((Over.pullback (C.diagram.map N.toBase)).obj M.arrows)
    ((Over.pullback (C.diagram.map N.toBase)).obj M.pairs)
    ((Over.pullback (C.diagram.map N.toBase)).obj M.triples)
    ((Over.pullback (C.diagram.map N.toBase)).map M.source)
    ((Over.pullback (C.diagram.map N.toBase)).map M.target)
    ((Over.pullback (C.diagram.map N.toBase)).map M.identity)
    ((Over.pullback (C.diagram.map N.toBase)).map M.inverse)
    ((Over.pullback (C.diagram.map N.toBase)).map M.pairFst)
    ((Over.pullback (C.diagram.map N.toBase)).map M.pairSnd)
    ((IsPullback.of_hasPullback M.source M.target).map _) N.comp
    ((Over.pullback (C.diagram.map N.toBase)).map M.tripleFst)
    ((Over.pullback (C.diagram.map N.toBase)).map M.tripleSnd)
    ((IsPullback.of_hasPullback M.pairSnd M.pairFst).map _)
    (by rw [← Functor.map_comp, M.identity_source, CategoryTheory.Functor.map_id])
    (by rw [← Functor.map_comp, M.identity_target, CategoryTheory.Functor.map_id])
    (by rw [← Functor.map_comp, M.inverse_source])
    (by rw [← Functor.map_comp, M.inverse_target])
    (by rw [N.comp_source, Functor.map_comp])
    (by rw [N.comp_target, Functor.map_comp])
    ((Over.pullback (C.diagram.map N.toBase)).map M.unitLeft)
    (by rw [← Functor.map_comp, M.unitLeft_fst, Functor.map_comp])
    (by rw [← Functor.map_comp, M.unitLeft_snd, CategoryTheory.Functor.map_id]) N.unitLeft_comp
    ((Over.pullback (C.diagram.map N.toBase)).map M.unitRight)
    (by rw [← Functor.map_comp, M.unitRight_fst, CategoryTheory.Functor.map_id])
    (by rw [← Functor.map_comp, M.unitRight_snd, Functor.map_comp]) N.unitRight_comp
    ((Over.pullback (C.diagram.map N.toBase)).map M.inverseLeft)
    (by rw [← Functor.map_comp, M.inverseLeft_fst])
    (by rw [← Functor.map_comp, M.inverseLeft_snd, CategoryTheory.Functor.map_id])
    (by rw [N.inverseLeft_comp, Functor.map_comp])
    ((Over.pullback (C.diagram.map N.toBase)).map M.inverseRight)
    (by rw [← Functor.map_comp, M.inverseRight_fst, CategoryTheory.Functor.map_id])
    (by rw [← Functor.map_comp, M.inverseRight_snd])
    (by rw [N.inverseRight_comp, Functor.map_comp])
    N.assocLeft N.assocRight N.assocLeft_fst (by rw [N.assocLeft_snd, Functor.map_comp])
    (by rw [N.assocRight_fst, Functor.map_comp]) N.assocRight_snd N.assoc

/-- **The groupoid in algebraic spaces at the stage.** -/
noncomputable def groupoid : GroupoidInAlgebraicSpaces B S hS (C.stageSpace N.stage) :=
  GroupoidInAlgebraicSpaces.ofOverGroupoidObject (C.stageSpace N.stage) N.groupoidObject
    (M.objects_isStageObject.pullback C N.toBase).1 (M.arrows_isStageObject.pullback C N.toBase).1

/-- The groupoid at the stage is smooth. -/
theorem groupoid_isSmooth : GroupoidInAlgebraicSpaces.IsSmooth B S hS N.groupoid :=
  ⟨N.source_isSmooth, N.target_isSmooth⟩

/-- The object space of the groupoid at the stage is of finite presentation over the stage. -/
theorem groupoid_objects_isFinitePresentation :
    Space.IsFinitePresentation B S hS N.groupoid.objectsToBase.hom :=
  (M.objects_isStageObject.pullback C N.toBase).2

/-- The arrow space of the groupoid at the stage is of finite presentation over the stage. -/
theorem groupoid_arrows_isFinitePresentation :
    Space.IsFinitePresentation B S hS N.groupoid.arrowsToBase.hom :=
  (M.arrows_isStageObject.pullback C N.toBase).2

/-- The identification of the object space over the limit at the stage of `N`. -/
noncomputable abbrev objectsIso := C.laterIso N.toBase M.objectsIso

/-- The identification of the arrow space over the limit at the stage of `N`. -/
noncomputable abbrev arrowsIso := C.laterIso N.toBase M.arrowsIso

/-- The identification of the composable pairs over the limit at the stage of `N`. -/
noncomputable abbrev pairsIso := C.laterIso N.toBase M.pairsIso

/-- The source at the stage of `N` reads over the limit as the source of `G`. -/
theorem map_source : (Over.pullback (limit.π C.diagram N.stage)).map
    ((Over.pullback (C.diagram.map N.toBase)).map M.source) =
      N.arrowsIso.inv ≫ limSource G ≫ N.objectsIso.hom :=
  C.map_eq_of_limitHom_eq N.toBase M.arrowsIso M.objectsIso _ _
    (by rw [C.limitHom_map, M.map_source])

/-- The target at the stage of `N` reads over the limit as the target of `G`. -/
theorem map_target : (Over.pullback (limit.π C.diagram N.stage)).map
    ((Over.pullback (C.diagram.map N.toBase)).map M.target) =
      N.arrowsIso.inv ≫ limTarget G ≫ N.objectsIso.hom :=
  C.map_eq_of_limitHom_eq N.toBase M.arrowsIso M.objectsIso _ _
    (by rw [C.limitHom_map, M.map_target])

/-- The first arrow of a composable pair at the stage of `N` reads over the limit as the first
arrow of a composable pair of `G`. -/
theorem map_pairFst : (Over.pullback (limit.π C.diagram N.stage)).map
    ((Over.pullback (C.diagram.map N.toBase)).map M.pairFst) =
      N.pairsIso.inv ≫ limFst G ≫ N.arrowsIso.hom :=
  C.map_eq_of_limitHom_eq N.toBase M.pairsIso M.arrowsIso _ _
    (by rw [C.limitHom_map, M.map_pairFst])

/-- The second arrow of a composable pair at the stage of `N` reads over the limit as the second
arrow of a composable pair of `G`. -/
theorem map_pairSnd : (Over.pullback (limit.π C.diagram N.stage)).map
    ((Over.pullback (C.diagram.map N.toBase)).map M.pairSnd) =
      N.pairsIso.inv ≫ limSnd G ≫ N.arrowsIso.hom :=
  C.map_eq_of_limitHom_eq N.toBase M.pairsIso M.arrowsIso _ _
    (by rw [C.limitHom_map, M.map_pairSnd])

/-- The composition at the stage of `N` reads over the limit as the composition of `G`. -/
theorem map_comp : (Over.pullback (limit.π C.diagram N.stage)).map N.comp =
    N.pairsIso.inv ≫ limComp G ≫ N.arrowsIso.hom :=
  C.map_eq_of_limitHom_eq N.toBase M.pairsIso M.arrowsIso _ _ N.limitHom_comp

/-- The map on object spaces from `G` to the base change of the stage groupoid. -/
noncomputable abbrev mapObjects : G.objects.obj ⟶
    (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.objects.obj :=
  N.objectsIso.hom.left ≫ (pullbackSymmetry _ _).hom

/-- The map on arrow spaces from `G` to the base change of the stage groupoid. -/
noncomputable abbrev mapArrows : G.arrows.obj ⟶
    (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.arrows.obj :=
  N.arrowsIso.hom.left ≫ (pullbackSymmetry _ _).hom

/-- `mapObjects` lies over the limit. -/
theorem mapObjects_fst : N.mapObjects ≫
    pullback.fst (C.limitProjection N.stage).hom N.groupoid.objectsToBase.hom =
      G.objectsToBase.hom :=
  (Category.assoc _ _ _).trans (iso_hom_left_pullbackSymmetry_fst _ N.objectsIso)

/-- `mapArrows` lies over the limit. -/
theorem mapArrows_fst : N.mapArrows ≫
    pullback.fst (C.limitProjection N.stage).hom N.groupoid.arrowsToBase.hom =
      G.arrowsToBase.hom :=
  (Category.assoc _ _ _).trans (iso_hom_left_pullbackSymmetry_fst _ N.arrowsIso)

/-- The component of `mapObjects` in the object space at the stage is the identification of the
object space followed by the first projection. -/
theorem mapObjects_snd : N.mapObjects ≫
    pullback.snd (C.limitProjection N.stage).hom N.groupoid.objectsToBase.hom =
      N.objectsIso.hom.left ≫ pullback.fst _ (limit.π C.diagram N.stage) :=
  (Category.assoc _ _ _).trans
    (congrArg (N.objectsIso.hom.left ≫ ·) (pullbackSymmetry_hom_comp_snd _ _))

/-- The component of `mapArrows` in the arrow space at the stage is the identification of the
arrow space followed by the first projection. -/
theorem mapArrows_snd : N.mapArrows ≫
    pullback.snd (C.limitProjection N.stage).hom N.groupoid.arrowsToBase.hom =
      N.arrowsIso.hom.left ≫ pullback.fst _ (limit.π C.diagram N.stage) :=
  (Category.assoc _ _ _).trans
    (congrArg (N.arrowsIso.hom.left ≫ ·) (pullbackSymmetry_hom_comp_snd _ _))

/-- `mapArrows` intertwines a map `a` of `G` with a map `c` of the base change of the stage
groupoid, when both lie over the limit and the stage and `a` reads as `b` at the stage. -/
private theorem mapArrows_comp_eq_of_map {a : G.arrows.obj ⟶ G.objects.obj}
    {b : N.groupoid.arrows.obj ⟶ N.groupoid.objects.obj}
    {c : (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.arrows.obj ⟶
      (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.objects.obj}
    (ha : a ≫ G.objectsToBase.hom = G.arrowsToBase.hom)
    (hc₁ : c ≫ pullback.fst (C.limitProjection N.stage).hom N.groupoid.objectsToBase.hom =
      pullback.fst (C.limitProjection N.stage).hom N.groupoid.arrowsToBase.hom)
    (hc₂ : c ≫ pullback.snd (C.limitProjection N.stage).hom N.groupoid.objectsToBase.hom =
      pullback.snd (C.limitProjection N.stage).hom N.groupoid.arrowsToBase.hom ≫ b)
    (hb : N.arrowsIso.hom.left ≫ pullback.fst _ (limit.π C.diagram N.stage) ≫ b =
      a ≫ N.objectsIso.hom.left ≫ pullback.fst _ (limit.π C.diagram N.stage)) :
    N.mapArrows ≫ c = a ≫ N.mapObjects := by
  refine pullback.hom_ext
    (((Category.assoc _ _ _).trans ((congrArg (N.mapArrows ≫ ·) hc₁).trans N.mapArrows_fst)).trans
      ((Category.assoc _ _ _).trans ((congrArg (a ≫ ·) N.mapObjects_fst).trans ha)).symm)
    (((Category.assoc _ _ _).trans ((congrArg (N.mapArrows ≫ ·) hc₂).trans
      ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ b) N.mapArrows_snd).trans
        ((Category.assoc _ _ _).trans hb))))).trans
      ((Category.assoc _ _ _).trans (congrArg (a ≫ ·) N.mapObjects_snd)).symm)

/-- `mapObjects` and `mapArrows` commute with the source maps. -/
theorem mapArrows_source : N.mapArrows ≫
    (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.source.hom =
      G.source.hom ≫ N.mapObjects :=
  N.mapArrows_comp_eq_of_map (congrArg (fun k => k.hom) G.source_over)
    (Space.baseChange_source_comp_fst _ _) (Space.baseChange_source_comp_snd _ _)
    (pullback_fst_comp_of_map_eq _ N.arrowsIso N.objectsIso _ _ N.map_source)

/-- `mapObjects` and `mapArrows` commute with the target maps. -/
theorem mapArrows_target : N.mapArrows ≫
    (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.target.hom =
      G.target.hom ≫ N.mapObjects :=
  N.mapArrows_comp_eq_of_map (congrArg (fun k => k.hom) G.target_over)
    (Space.baseChange_target_comp_fst _ _) (Space.baseChange_target_comp_snd _ _)
    (pullback_fst_comp_of_map_eq _ N.arrowsIso N.objectsIso _ _ N.map_target)

/-- The map on composable pairs from `G` to the base change of the stage groupoid. -/
noncomputable abbrev mapPairs := pullback.map G.source.hom G.target.hom
  (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.source.hom
  (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.target.hom
  N.mapArrows N.mapArrows N.mapObjects N.mapArrows_source.symm N.mapArrows_target.symm

/-- `mapPairs`, followed by the comparison of composable pairs of the base change with the
composable pairs at the stage, is the identification of composable pairs followed by the first
projection. -/
theorem mapPairs_comparison : N.mapPairs ≫
    (Space.baseChangeComposableToOld N.groupoid (C.limitProjection N.stage)).hom ≫
      GroupoidInAlgebraicSpaces.overPairsComparison (C.stageSpace N.stage) N.groupoidObject =
    N.pairsIso.hom.left ≫ pullback.fst _ (limit.π C.diagram N.stage) := by
  refine (GroupoidInAlgebraicSpaces.overGroupoidPresheafObject (C.stageSpace N.stage)
    N.groupoidObject).isPullback_pairs.hom_ext ?_ ?_
  · have h₁ := pullback_fst_comp_of_map_eq _ N.pairsIso N.arrowsIso _ _ N.map_pairFst
    have h₂ := Space.baseChangeComposableToOld_comp_fst N.groupoid (C.limitProjection N.stage)
    have h₃ := GroupoidInAlgebraicSpaces.overPairsComparison_fst (C.stageSpace N.stage)
      N.groupoidObject
    have e₁ : N.mapPairs ≫ pullback.fst
        (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.source.hom
        (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.target.hom =
          pullback.fst G.source.hom G.target.hom ≫ N.mapArrows := pullback.lift_fst _ _ _
    refine ((Category.assoc _ _ _).trans ((Category.assoc _ _ _).trans ?_)).trans
      ((Category.assoc _ _ _).trans h₁).symm
    exact (congrArg (fun k => N.mapPairs ≫ (Space.baseChangeComposableToOld N.groupoid
        (C.limitProjection N.stage)).hom ≫ k) h₃).trans
      ((congrArg (N.mapPairs ≫ ·) h₂).trans ((Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ pullback.snd _ _) e₁).trans ((Category.assoc _ _ _).trans
          (congrArg (pullback.fst _ _ ≫ ·) N.mapArrows_snd)))))
  · have h₁ := pullback_fst_comp_of_map_eq _ N.pairsIso N.arrowsIso _ _ N.map_pairSnd
    have h₂ := Space.baseChangeComposableToOld_comp_snd N.groupoid (C.limitProjection N.stage)
    have h₃ := GroupoidInAlgebraicSpaces.overPairsComparison_snd (C.stageSpace N.stage)
      N.groupoidObject
    have e₁ : N.mapPairs ≫ pullback.snd
        (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.source.hom
        (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.target.hom =
          pullback.snd G.source.hom G.target.hom ≫ N.mapArrows := pullback.lift_snd _ _ _
    refine ((Category.assoc _ _ _).trans ((Category.assoc _ _ _).trans ?_)).trans
      ((Category.assoc _ _ _).trans h₁).symm
    exact (congrArg (fun k => N.mapPairs ≫ (Space.baseChangeComposableToOld N.groupoid
        (C.limitProjection N.stage)).hom ≫ k) h₃).trans
      ((congrArg (N.mapPairs ≫ ·) h₂).trans ((Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ pullback.snd _ _) e₁).trans ((Category.assoc _ _ _).trans
          (congrArg (pullback.snd _ _ ≫ ·) N.mapArrows_snd)))))

/-- `mapPairs` and `mapArrows` commute with the compositions. -/
theorem mapPairs_comp : N.mapPairs ≫
    (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.comp.hom =
      G.comp.hom ≫ N.mapArrows := by
  have e₁ : N.mapPairs ≫ pullback.fst
      (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.source.hom
      (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid.target.hom =
        pullback.fst G.source.hom G.target.hom ≫ N.mapArrows := pullback.lift_fst _ _ _
  have r₁ : (G.comp.hom ≫ N.mapArrows) ≫
      pullback.fst (C.limitProjection N.stage).hom N.groupoid.arrowsToBase.hom =
        pullback.fst G.source.hom G.target.hom ≫ G.arrowsToBase.hom :=
    (Category.assoc _ _ _).trans ((congrArg (G.comp.hom ≫ ·) N.mapArrows_fst).trans
      (congrArg (fun k => k.hom) G.comp_over))
  have r₂ : (G.comp.hom ≫ N.mapArrows) ≫
      pullback.snd (C.limitProjection N.stage).hom N.groupoid.arrowsToBase.hom =
        G.comp.hom ≫ N.arrowsIso.hom.left ≫ pullback.fst _ (limit.π C.diagram N.stage) :=
    (Category.assoc _ _ _).trans (congrArg (G.comp.hom ≫ ·) N.mapArrows_snd)
  refine pullback.hom_ext (Eq.trans ?_ r₁.symm) (Eq.trans ?_ r₂.symm)
  · exact ((Category.assoc _ _ _).trans
      (congrArg (N.mapPairs ≫ ·) (Space.baseChange_comp_comp_fst _ _))).trans
      ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ pullback.fst _ _) e₁).trans
        ((Category.assoc _ _ _).trans
          (congrArg (pullback.fst G.source.hom G.target.hom ≫ ·) N.mapArrows_fst))))
  · exact ((Category.assoc _ _ _).trans
      (congrArg (N.mapPairs ≫ ·) (Space.baseChange_comp_comp_snd _ _))).trans
      (((congrArg (N.mapPairs ≫ ·) (Category.assoc _ _ _).symm).trans
        (Category.assoc _ _ _).symm).trans
        ((congrArg (· ≫ N.comp.left) N.mapPairs_comparison).trans
          ((Category.assoc _ _ _).trans
            (pullback_fst_comp_of_map_eq _ N.pairsIso N.arrowsIso _ _ N.map_comp))))

/-- The morphism from `G` to the base change of the stage groupoid to the limit. -/
noncomputable def toBaseChangeHom : GroupoidInAlgebraicSpaces.Hom G
    (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid :=
  GroupoidInAlgebraicSpaces.Hom.mkOfComp N.mapObjects N.mapArrows N.mapArrows_source
    N.mapArrows_target N.mapPairs_comp N.mapObjects_fst N.mapArrows_fst

/-- **The groupoid over the limit is the base change of the stage groupoid.** -/
noncomputable def isoBaseChange : GroupoidInAlgebraicSpaces.Iso G
    (Space.baseChange N.groupoid (C.limitProjection N.stage)).groupoid :=
  GroupoidInAlgebraicSpaces.Iso.mk' N.toBaseChangeHom
    ((pullbackSymmetry _ _).inv ≫ N.objectsIso.inv.left)
    ((pullbackSymmetry _ _).inv ≫ N.arrowsIso.inv.left)
    ((Category.assoc _ _ _).trans ((congrArg (N.objectsIso.hom.left ≫ ·)
      (Iso.hom_inv_id_assoc _ _)).trans (congrArg (fun φ => φ.left) N.objectsIso.hom_inv_id)))
    ((Category.assoc _ _ _).trans ((congrArg ((pullbackSymmetry _ _).inv ≫ ·)
      ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ (pullbackSymmetry _ _).hom)
        (congrArg (fun φ => φ.left) N.objectsIso.inv_hom_id)).trans (Category.id_comp _)))).trans
      (Iso.inv_hom_id _)))
    ((Category.assoc _ _ _).trans ((congrArg (N.arrowsIso.hom.left ≫ ·)
      (Iso.hom_inv_id_assoc _ _)).trans (congrArg (fun φ => φ.left) N.arrowsIso.hom_inv_id)))
    ((Category.assoc _ _ _).trans ((congrArg ((pullbackSymmetry _ _).inv ≫ ·)
      ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ (pullbackSymmetry _ _).hom)
        (congrArg (fun φ => φ.left) N.arrowsIso.inv_hom_id)).trans (Category.id_comp _)))).trans
      (Iso.inv_hom_id _)))

end StageGroupoid

end StageMaps

variable (C) in
/-- **Stacks 07SK and Stacks 0CN2 for a groupoid object, given models of its object and arrow
spaces.** A smooth groupoid in algebraic spaces over the limit, whose object and arrow spaces
come from stages, is, up to equivalence of quotient stacks over the limit, the base change of a
smooth groupoid over some stage whose object and arrow spaces are of finite presentation. -/
theorem groupoidStructureDescendsToStage : C.GroupoidStructureDescendsToStage := by
  intro G hG iU Uᵢ hUalg hUfp eU iR Rᵢ hRalg hRfp eR
  obtain ⟨M⟩ := C.nonempty_stageMaps G iU Uᵢ hUalg hUfp eU iR Rᵢ hRalg hRfp eR
  obtain ⟨N⟩ := M.nonempty_stageGroupoid hG
  exact ⟨N.stage, N.groupoid, N.groupoid_isSmooth, N.groupoid_objects_isFinitePresentation,
    N.groupoid_arrows_isFinitePresentation,
    nonempty_equivalenceOver_quotientStackToBase_of_iso N.isoBaseChange⟩

end AlgebraicGeometry.Stack.ConventionalStackDescentSystem


end

/-! ### Stacks 0CN4 from the steps of its proof -/

section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Stack
variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
namespace ConventionalStackDescentSystem

variable {B S hS} {hZ : B.Contains (⊤_ Scheme.{u})}
variable {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)] [Nonempty I]
    (C : ConventionalStackDescentSystem B S hS hZ I)

/-- A model of a quotient stack at a stage is a model over the stage, in the sense of
`AlgebraicGeometry.Stack.QuotientStackModel`. -/
def QuotientStackModel.toModel {C : ConventionalStackDescentSystem B S hS hZ I}
    {i : Iᵒᵖ} {Gᵢ : GroupoidInAlgebraicSpaces B S hS (C.stageSpace i)}
    (M : C.QuotientStackModel.{u, w} i Gᵢ) : Stack.QuotientStackModel.{u, w} (C.stageSpace i) Gᵢ :=
  ⟨M.stack, M.structureMorphism, M.equivOver⟩

/-- A model over the stage, in the sense of `AlgebraicGeometry.Stack.QuotientStackModel`, is a
model of the quotient stack at that stage. -/
def QuotientStackModel.ofModel {C : ConventionalStackDescentSystem B S hS hZ I}
    {i : Iᵒᵖ} {Gᵢ : GroupoidInAlgebraicSpaces B S hS (C.stageSpace i)}
    (M : Stack.QuotientStackModel.{u, w} (C.stageSpace i) Gᵢ) : C.QuotientStackModel.{u, w} i Gᵢ :=
  ⟨M.stack, M.structureMorphism, M.equivOver⟩

/-- **Stacks 0CN4 from the five steps of its proof and Stacks 04TK.** Let `(X_i)` be a directed
inverse system of quasi-compact, quasi-separated algebraic spaces over `S` with affine transition
morphisms, and let `X = lim X_i`. Given Stacks 04TK and the five steps of the source's proof —
the groupoid presentation over the base, the descent of the groupoid to a stage, the small-hom
model of the quotient stack at the stage, its finite presentation and the base-change comparison —
every algebraic stack `𝒳` of finite presentation over `X` is `𝒳_i ×_{X_i} X` for an algebraic
stack `𝒳_i` of finite presentation over some `X_i`. -/
theorem exists_stage_model_of_inputs (C : ConventionalStackDescentSystem B S hS hZ I)
    (h04TK : Theorem04TK.{u, w} B S hS)
    (hPresentation : GroupoidPresentationOfAffineSmoothChart.{u, w} B S hS hZ)
    (hDescent : C.GroupoidStructureDescendsToStage)
    (hStageStackModel : C.StageStackModel.{u, w})
    (hModelFinitePresentation : C.ModelIsFinitePresentation.{u, w})
    (hModelComparison : C.ModelBaseChangeComparison.{u, w})
    (𝒳 : AlgebraicStacks.{u, w} B S hS) (f : 𝒳 ⟶ C.limitStack.{u, w})
    (hf : AlgebraicStacks.IsFinitePresentation B S hS f) :
    ∃ (i : Iᵒᵖ) (𝒳ᵢ : AlgebraicStacks.{u, w} B S hS) (fᵢ : 𝒳ᵢ ⟶ C.stageStack.{u, w} i),
      AlgebraicStacks.IsFinitePresentation B S hS fᵢ ∧
        ∃ e : Bicategory.Equivalence 𝒳
          (twoFibreProductAlgebraicStack.{u, w} B S hS fᵢ
            (C.limitStackProjection.{u, w} i)),
          Nonempty (e.hom ≫ (twoFibreProductSquareAlgebraicStacks.{u, w} B S hS fᵢ
            (C.limitStackProjection.{u, w} i)).snd ≅ f) := by
  obtain ⟨P⟩ := hasSmoothPresentationOverBase.{u, w} B S hS hZ hPresentation
    C.limitSpace C.limit_quasiCompact C.limit_quasiSeparated 𝒳 f hf
  obtain ⟨i, Gᵢ, hGᵢsmooth, hGᵢobjects, hGᵢarrows, ⟨eDescent⟩⟩ :=
    C.smoothGroupoidDescendsToStage hDescent P.groupoid P.isSmooth
      P.objects_finitePresentation P.arrows_finitePresentation
  have hGᵢalgebraic : IsAlgebraicStack.{u, w} B S hS (quotientStack Gᵢ) :=
    h04TK _ Gᵢ hGᵢsmooth
  obtain ⟨𝒳ᵢ, fᵢ, hfᵢ, ⟨eModel⟩⟩ :=
    C.stageModelOfSmoothGroupoid hStageStackModel hModelFinitePresentation hModelComparison
      i Gᵢ hGᵢalgebraic hGᵢsmooth hGᵢobjects hGᵢarrows
  refine ⟨i, 𝒳ᵢ, fᵢ, hfᵢ,
    equivalenceOfBasedEquivalence.{u, w} B S hS ((P.equivOver.trans eDescent).trans eModel).equiv,
    ⟨isoMkAlgebraicStacks.{u, w} B S hS ((P.equivOver.trans eDescent).trans eModel).compIso⟩⟩

end ConventionalStackDescentSystem
end AlgebraicGeometry.Stack


end

/-! ### Finite presentation of the model at a stage -/

section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Stack

namespace ConventionalStackDescentSystem

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {hZ : B.Contains (⊤_ Scheme.{u})} {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)]
    [Nonempty I]

variable (C : ConventionalStackDescentSystem B S hS hZ I) in
/-- **Stacks 06Q2 for the model of a quotient stack at a stage.** The model of the quotient stack
of a smooth groupoid in algebraic spaces over a stage `X_i`, whose object and arrow spaces are of
finite presentation over `X_i`, is of finite presentation over `X_i`. -/
theorem modelIsFinitePresentation (C : ConventionalStackDescentSystem B S hS hZ I) :
    C.ModelIsFinitePresentation.{u, w} := by
  intro i G M hsm hU hR
  have halg := isAlgebraicStack_quotientStack_of_isSmooth_unconditional.{u, w} hsm
  exact ⟨M.toModel.isLocallyOfFinitePresentation_structureMorphism halg hsm hU.1,
    M.toModel.isQuasiCompactMorphism_structureMorphism halg hU.2.1,
    M.toModel.isQuasiSeparated_structureMorphism (C.stage_quasiSeparated i) halg hsm hU hR⟩

end ConventionalStackDescentSystem
end AlgebraicGeometry.Stack


end

/-! ### The model of a quotient stack at a stage -/

section

open CategoryTheory CategoryTheory.Functor Opposite

namespace AlgebraicGeometry.Stack
variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
