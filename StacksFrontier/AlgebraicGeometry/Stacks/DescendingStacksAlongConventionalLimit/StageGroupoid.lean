/-! ### The base-change comparison -/

section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Stack
variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
variable {Y X' : AlgebraicSpaces B S hS} (G : GroupoidInAlgebraicSpaces B S hS Y) (g : X' ⟶ Y)
namespace ConventionalStackDescentSystem

variable {hZ : B.Contains (⊤_ Scheme.{u})} {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)]
  [Nonempty I]

/-- **Stacks 044P, 044R, 046Q and 04Y1 for a base-changed groupoid.** At a stage `X_i` of the
system, the quotient stack of the base change of a groupoid `G_i` over `X_i` to the
limit `X` is, over `X`, the 2-fibre product of any model of `[U_i/R_i]` with `X` over `X_i`. -/
theorem modelBaseChangeComparison (C : ConventionalStackDescentSystem B S hS hZ I) :
    C.ModelBaseChangeComparison.{u, w} := fun i Gᵢ M =>
  nonempty_equivalenceOver_baseChange_twoFibreProduct Gᵢ (C.limitProjection i) M.stack
    M.structureMorphism M.equivOver

end ConventionalStackDescentSystem
end AlgebraicGeometry.Stack

end

/-! ### Stacks 0CN4 -/

section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Stack.ConventionalStackDescentSystem


variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {hZ : B.Contains (⊤_ Scheme.{u})} {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)]
    [Nonempty I]
    (C : ConventionalStackDescentSystem B S hS hZ I)

/-- **Stacks 0CN4.** Let `(X_i)` be a directed inverse system of quasi-compact, quasi-separated
algebraic spaces over `S` with affine transition morphisms, and let `X = lim X_i`. If `𝒳` is an
algebraic stack of finite presentation over `X`, then there are a stage `i` and an algebraic
stack `𝒳_i` of finite presentation over `X_i` with `𝒳 ≅ 𝒳_i ×_{X_i} X` as algebraic stacks
over `X`. -/
theorem exists_stage_model_of_isFinitePresentation_unconditional
    (𝒳 : AlgebraicStacks.{u, w} B S hS) (f : 𝒳 ⟶ C.limitStack.{u, w})
    (hf : AlgebraicStacks.IsFinitePresentation B S hS f) :
    ∃ (i : Iᵒᵖ) (𝒳ᵢ : AlgebraicStacks.{u, w} B S hS) (fᵢ : 𝒳ᵢ ⟶ C.stageStack.{u, w} i),
      AlgebraicStacks.IsFinitePresentation B S hS fᵢ ∧
        ∃ e : Bicategory.Equivalence 𝒳
          (twoFibreProductAlgebraicStack.{u, w} B S hS fᵢ
            (C.limitStackProjection.{u, w} i)),
          Nonempty (e.hom ≫ (twoFibreProductSquareAlgebraicStacks.{u, w} B S hS fᵢ
            (C.limitStackProjection.{u, w} i)).snd ≅ f) :=
  C.exists_stage_model_of_inputs
    (fun _ _ hG => isAlgebraicStack_quotientStack_of_isSmooth_unconditional.{u, w} hG)
    (groupoidPresentationOfAffineSmoothChart.{u, w} B S hS hZ)
    C.groupoidStructureDescendsToStage C.stageStackModel C.modelIsFinitePresentation
    C.modelBaseChangeComparison 𝒳 f hf

end AlgebraicGeometry.Stack.ConventionalStackDescentSystem


end

/-! ### The statement -/

namespace AlgebraicGeometry.Stack.AlgebraicStacks

open CategoryTheory CategoryTheory.Limits

/-- **Stacks 0CN4, under the chapter's convention.** For a directed inverse system of
quasi-compact, quasi-separated algebraic spaces with affine transition morphisms satisfying the
convention of Section 70.2, every algebraic stack of finite presentation over the limit is the
base change of one of finite presentation over a stage. -/
public theorem finitePresentationStackDescendsStatement_holds (B : BigFppfSite.{u}) (S : Scheme.{u})
    (hS : B.Contains S) : FinitePresentationStackDescendsStatement.{u, w} B S hS := by
  intro I _ _ _ D hX hD hAff hqc hqs hconv 𝒳 f hf
  let C : ConventionalStackDescentSystem B S hS B.contains_terminal I :=
    { diagram := D
      stage_isAlgebraicSpace := hD
      transition_affine := hAff
      stage_quasiCompact := hqc
      stage_quasiSeparated := hqs
      convention := hconv }
  obtain ⟨i, 𝒳ᵢ, fᵢ, hfᵢ, e, he⟩ :=
    C.exists_stage_model_of_isFinitePresentation_unconditional 𝒳 f hf
  exact ⟨i, 𝒳ᵢ, fᵢ, hfᵢ, e, he⟩

end AlgebraicGeometry.Stack.AlgebraicStacks

