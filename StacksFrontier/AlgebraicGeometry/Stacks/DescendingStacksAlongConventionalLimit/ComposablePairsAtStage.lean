/-!
# Composable pairs and triples at a stage, and the composition at a later stage

Smoothness of base changes in a slice; the composable pairs and triples of the stage models of a
groupoid over the limit `X = lim X_i`, read over `X`; and the second step of the descent of the
groupoid to a stage, a composition at a later stage with the laws of a groupoid
(`AlgebraicGeometry.Stack.ConventionalStackDescentSystem.StageMaps.nonempty_stageGroupoid`).
-/

@[expose] public section

universe u v w

section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Stack.ConventionalStackDescentSystem

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}
    {hZ : B.Contains (⊤_ Scheme.{u})} {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)]
    [Nonempty I] (C : ConventionalStackDescentSystem B S hS hZ I)

variable {C} (G : GroupoidInAlgebraicSpaces B S hS C.limitSpace)

/-! ### Smoothness of base changes in a slice -/

section Smooth

variable {W X : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (hW : IsAlgebraicSpace B S hS W)
  (hX : IsAlgebraicSpace B S hS X) (g : W ⟶ X)

/-- A morphism of the slice whose base change reads, through two identifications, as a given
morphism, read on the first factors of the fibre products. -/
theorem pullback_fst_comp_of_map_eq {L N : Over W} {Y Z : Over X}
    (ιY : L ≅ (Over.pullback g).obj Y) (ιZ : N ≅ (Over.pullback g).obj Z) (y : Y ⟶ Z)
    (f : L ⟶ N) (h : (Over.pullback g).map y = ιY.inv ≫ f ≫ ιZ.hom) :
    ιY.hom.left ≫ pullback.fst Y.hom g ≫ y.left = f.left ≫ ιZ.hom.left ≫ pullback.fst Z.hom g := by
  have h' : ιY.hom ≫ (Over.pullback g).map y = f ≫ ιZ.hom := by rw [h, Iso.hom_inv_id_assoc]
  have h'' := congrArg (fun φ => φ.left) h'
  simp only [Over.comp_left] at h''
  have hy : ((Over.pullback g).map y).left ≫ pullback.fst Z.hom g =
      pullback.fst Y.hom g ≫ y.left := pullback.lift_fst _ _ _
  rw [← hy, ← Category.assoc, h'', Category.assoc]

/-- An identification with a base change, followed by the symmetry of the fibre product, covers
the structure morphism. -/
theorem iso_hom_left_pullbackSymmetry_fst {L : Over W} {Y : Over X}
    (ι : L ≅ (Over.pullback g).obj Y) :
    ι.hom.left ≫ (pullbackSymmetry Y.hom g).hom ≫ pullback.fst g Y.hom = L.hom := by
  rw [pullbackSymmetry_hom_comp_fst]
  exact Over.w ι.hom

include hW hX in
/-- The base change, in the slice, of a smooth morphism of algebraic spaces is smooth. -/
theorem isSmooth_pullback_map_left {Y Z : Over X} (hY : IsAlgebraicSpace B S hS Y.left)
    (hZ' : IsAlgebraicSpace B S hS Z.left) (y : Y ⟶ Z) (hy : Space.IsSmooth B S hS y.left) :
    Space.IsSmooth B S hS ((Over.pullback g).map y).left := by
  have hPY : IsAlgebraicSpace B S hS (pullback Y.hom g) :=
    isAlgebraicSpace_pullback B S hS _ _ hY hW hX
  have hPZ : IsAlgebraicSpace B S hS (pullback Z.hom g) :=
    isAlgebraicSpace_pullback B S hS _ _ hZ' hW hX
  have hp : ((Over.pullback g).map y).left ≫ pullback.fst Z.hom g =
      pullback.fst Y.hom g ≫ y.left := pullback.lift_fst _ _ _
  have hs : ((Over.pullback g).map y).left ≫ pullback.snd Z.hom g = pullback.snd Y.hom g :=
    Over.w ((Over.pullback g).map y)
  have outer : IsPullback (((Over.pullback g).map y).left ≫ pullback.snd Z.hom g)
      (pullback.fst Y.hom g) g (y.left ≫ Z.hom) := by
    rw [hs, Over.w y]
    exact (IsPullback.of_hasPullback Y.hom g).flip
  have sq : IsPullback ((Over.pullback g).map y).left (pullback.fst Y.hom g)
      (pullback.fst Z.hom g) y.left :=
    IsPullback.of_right outer hp (IsPullback.of_hasPullback Z.hom g).flip
  let PY : AlgebraicSpaces B S hS := ⟨_, hPY⟩
  let PZ : AlgebraicSpaces B S hS := ⟨_, hPZ⟩
  let Y' : AlgebraicSpaces B S hS := ⟨_, hY⟩
  let Z' : AlgebraicSpaces B S hS := ⟨_, hZ'⟩
  have sq' : IsPullback (ObjectProperty.homMk ((Over.pullback g).map y).left : PY ⟶ PZ)
      (ObjectProperty.homMk (pullback.fst Y.hom g) : PY ⟶ Y')
      (ObjectProperty.homMk (pullback.fst Z.hom g) : PZ ⟶ Z')
      (ObjectProperty.homMk y.left : Y' ⟶ Z') :=
    IsPullback.of_map_of_faithful (ObjectProperty.ι _) sq
  exact (Space.isSmooth_isStableUnderBaseChange B S hS).of_isPullback sq'.flip hy

/-- A smooth morphism of algebraic spaces, precomposed and postcomposed with isomorphisms, is
smooth. -/
private theorem isSmooth_comp_comp_of_isIso {X₁ X₂ X₃ X₄ : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    (h₁ : IsAlgebraicSpace B S hS X₁) (h₂ : IsAlgebraicSpace B S hS X₂)
    (h₃ : IsAlgebraicSpace B S hS X₃) (h₄ : IsAlgebraicSpace B S hS X₄)
    (i : X₁ ⟶ X₂) [IsIso i] (f : X₂ ⟶ X₃) (j : X₃ ⟶ X₄) [IsIso j]
    (hf : Space.IsSmooth B S hS f) : Space.IsSmooth B S hS (i ≫ f ≫ j) :=
  Space.isSmooth_comp B S hS h₁ h₂ h₄ i _ (Space.isSmooth_of_isIso B S hS h₁ h₂ i)
    (Space.isSmooth_comp B S hS h₂ h₃ h₄ f j hf (Space.isSmooth_of_isIso B S hS h₃ h₄ j))

/-- The base change of a morphism of the slice, read through the symmetry of the fibre
product. -/
theorem pullbackSymmetry_hom_comp_pullback_map_left {Y Z : Over X} (y : Y ⟶ Z)
    (w : pullback.fst g Y.hom ≫ g = (pullback.snd g Y.hom ≫ y.left) ≫ Z.hom) :
    (pullbackSymmetry Y.hom g).hom ≫ pullback.lift (pullback.fst g Y.hom)
        (pullback.snd g Y.hom ≫ y.left) w =
      ((Over.pullback g).map y).left ≫ (pullbackSymmetry Z.hom g).hom := by
  apply pullback.hom_ext
  · rw [Category.assoc, Category.assoc, pullback.lift_fst, pullbackSymmetry_hom_comp_fst,
      pullbackSymmetry_hom_comp_fst]
    exact (Over.w ((Over.pullback g).map y)).symm
  · rw [Category.assoc, Category.assoc, pullback.lift_snd, pullbackSymmetry_hom_comp_snd_assoc,
      pullbackSymmetry_hom_comp_snd]
    exact (pullback.lift_fst _ _ _ : ((Over.pullback g).map y).left ≫ pullback.fst Z.hom g =
      pullback.fst Y.hom g ≫ y.left).symm

include hW hX in
/-- Smoothness of the base change of a morphism of the slice does not see the order of the
factors of the fibre product. -/
theorem isSmooth_pullback_map_left_iff {Y Z : Over X} (hY : IsAlgebraicSpace B S hS Y.left)
    (hZ' : IsAlgebraicSpace B S hS Z.left) (y : Y ⟶ Z)
    (w : pullback.fst g Y.hom ≫ g = (pullback.snd g Y.hom ≫ y.left) ≫ Z.hom) :
    Space.IsSmooth B S hS (pullback.lift (pullback.fst g Y.hom)
        (pullback.snd g Y.hom ≫ y.left) w) ↔
      Space.IsSmooth B S hS ((Over.pullback g).map y).left := by
  have hPY : IsAlgebraicSpace B S hS (pullback Y.hom g) :=
    isAlgebraicSpace_pullback B S hS _ _ hY hW hX
  have hPZ : IsAlgebraicSpace B S hS (pullback Z.hom g) :=
    isAlgebraicSpace_pullback B S hS _ _ hZ' hW hX
  have hPY' : IsAlgebraicSpace B S hS (pullback g Y.hom) :=
    isAlgebraicSpace_pullback B S hS _ _ hW hY hX
  have hPZ' : IsAlgebraicSpace B S hS (pullback g Z.hom) :=
    isAlgebraicSpace_pullback B S hS _ _ hW hZ' hX
  have key := pullbackSymmetry_hom_comp_pullback_map_left g y w
  constructor
  · intro h
    have e : ((Over.pullback g).map y).left = (pullbackSymmetry Y.hom g).hom ≫
        pullback.lift (pullback.fst g Y.hom) (pullback.snd g Y.hom ≫ y.left) w ≫
          (pullbackSymmetry Z.hom g).inv := by
      rw [← Category.assoc, key, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rw [e]
    exact isSmooth_comp_comp_of_isIso hPY hPY' hPZ' hPZ _ _ _ h
  · intro h
    have e : pullback.lift (pullback.fst g Y.hom) (pullback.snd g Y.hom ≫ y.left) w =
        (pullbackSymmetry Y.hom g).inv ≫ ((Over.pullback g).map y).left ≫
          (pullbackSymmetry Z.hom g).hom := by
      rw [← key, Iso.inv_hom_id_assoc]
    rw [e]
    exact isSmooth_comp_comp_of_isIso hPY' hPY hPZ hPZ' _ _ _ h

end Smooth

/-! ### Composable pairs and triples at the stage -/

namespace StageMaps

variable {G} (M : C.StageMaps G)

/-- The composable pairs of arrows at the stage. -/
noncomputable abbrev pairs : Over (C.diagram.obj M.stage) := pullback M.source M.target

/-- The first arrow of a composable pair at the stage. -/
noncomputable abbrev pairFst : M.pairs ⟶ M.arrows := pullback.fst M.source M.target

/-- The second arrow of a composable pair at the stage. -/
noncomputable abbrev pairSnd : M.pairs ⟶ M.arrows := pullback.snd M.source M.target

/-- The composable triples of arrows at the stage. -/
noncomputable abbrev triples : Over (C.diagram.obj M.stage) := pullback M.pairSnd M.pairFst

/-- The first pair of a composable triple at the stage. -/
noncomputable abbrev tripleFst : M.triples ⟶ M.pairs := pullback.fst M.pairSnd M.pairFst

/-- The second pair of a composable triple at the stage. -/
noncomputable abbrev tripleSnd : M.triples ⟶ M.pairs := pullback.snd M.pairSnd M.pairFst

/-- The composable pairs at the stage form a stage object. -/
theorem pairs_isStageObject : C.IsStageObject M.pairs :=
  IsStageObject.of_isPullback C (IsPullback.of_hasPullback _ _) M.arrows_isStageObject
    M.objects_isStageObject M.arrows_isStageObject

/-- The composable triples at the stage form a stage object. -/
theorem triples_isStageObject : C.IsStageObject M.triples :=
  IsStageObject.of_isPullback C (IsPullback.of_hasPullback _ _) M.pairs_isStageObject
    M.arrows_isStageObject M.pairs_isStageObject

/-- The pair of the identity at the target of an arrow with the arrow. -/
noncomputable def unitLeft : M.arrows ⟶ M.pairs :=
  pullback.lift (M.target ≫ M.identity) (𝟙 _)
    (by rw [Category.assoc, M.identity_source, Category.comp_id, Category.id_comp])

/-- The pair of an arrow with the identity at its source. -/
noncomputable def unitRight : M.arrows ⟶ M.pairs :=
  pullback.lift (𝟙 _) (M.source ≫ M.identity)
    (by rw [Category.id_comp, Category.assoc, M.identity_target, Category.comp_id])

/-- The pair of the inverse of an arrow with the arrow. -/
noncomputable def inverseLeft : M.arrows ⟶ M.pairs :=
  pullback.lift M.inverse (𝟙 _) (by rw [M.inverse_source, Category.id_comp])

/-- The pair of an arrow with its inverse. -/
noncomputable def inverseRight : M.arrows ⟶ M.pairs :=
  pullback.lift (𝟙 _) M.inverse (by rw [Category.id_comp, M.inverse_target])

/-- The first arrow of `unitLeft` is the identity at the target. -/
@[reassoc (attr := simp)] theorem unitLeft_fst : M.unitLeft ≫ M.pairFst = M.target ≫ M.identity :=
  pullback.lift_fst _ _ _
/-- The second arrow of `unitLeft` is the given arrow. -/
@[reassoc (attr := simp)] theorem unitLeft_snd : M.unitLeft ≫ M.pairSnd = 𝟙 _ :=
  pullback.lift_snd _ _ _
/-- The first arrow of `unitRight` is the given arrow. -/
@[reassoc (attr := simp)] theorem unitRight_fst : M.unitRight ≫ M.pairFst = 𝟙 _ :=
  pullback.lift_fst _ _ _
/-- The second arrow of `unitRight` is the identity at the source. -/
@[reassoc (attr := simp)] theorem unitRight_snd :
    M.unitRight ≫ M.pairSnd = M.source ≫ M.identity :=
  pullback.lift_snd _ _ _
/-- The first arrow of `inverseLeft` is the inverse. -/
@[reassoc (attr := simp)] theorem inverseLeft_fst : M.inverseLeft ≫ M.pairFst = M.inverse :=
  pullback.lift_fst _ _ _
/-- The second arrow of `inverseLeft` is the given arrow. -/
@[reassoc (attr := simp)] theorem inverseLeft_snd : M.inverseLeft ≫ M.pairSnd = 𝟙 _ :=
  pullback.lift_snd _ _ _
/-- The first arrow of `inverseRight` is the given arrow. -/
@[reassoc (attr := simp)] theorem inverseRight_fst : M.inverseRight ≫ M.pairFst = 𝟙 _ :=
  pullback.lift_fst _ _ _
/-- The second arrow of `inverseRight` is the inverse. -/
@[reassoc (attr := simp)] theorem inverseRight_snd : M.inverseRight ≫ M.pairSnd = M.inverse :=
  pullback.lift_snd _ _ _

/-! #### Reading the stage over the limit -/

/-- The source over the limit, read through the identifications with the stage models, is the
base change of the source at the stage. -/
@[reassoc (attr := simp)]
theorem arrowsIso_inv_limSource : M.arrowsIso.inv ≫ limSource G =
    (Over.pullback (limit.π C.diagram M.stage)).map M.source ≫ M.objectsIso.inv := by
  rw [M.map_source]; simp

/-- The target over the limit, read through the identifications with the stage models, is the
base change of the target at the stage. -/
@[reassoc (attr := simp)]
theorem arrowsIso_inv_limTarget : M.arrowsIso.inv ≫ limTarget G =
    (Over.pullback (limit.π C.diagram M.stage)).map M.target ≫ M.objectsIso.inv := by
  rw [M.map_target]; simp

/-- The identity over the limit, read through the identifications with the stage models, is the
base change of the identity at the stage. -/
@[reassoc (attr := simp)]
theorem objectsIso_inv_limIdentity : M.objectsIso.inv ≫ limIdentity G =
    (Over.pullback (limit.π C.diagram M.stage)).map M.identity ≫ M.arrowsIso.inv := by
  rw [M.map_identity]; simp

/-- The inverse over the limit, read through the identification with the stage model, is the
base change of the inverse at the stage. -/
@[reassoc (attr := simp)]
theorem arrowsIso_inv_limInverse : M.arrowsIso.inv ≫ limInverse G =
    (Over.pullback (limit.π C.diagram M.stage)).map M.inverse ≫ M.arrowsIso.inv := by
  rw [M.map_inverse]; simp

/-- The composable pairs over the limit are the fibre product of the base changes to the limit
of the source and the target at the stage. -/
theorem isPullback_limPairs_arrowsIso :
    IsPullback (limFst G ≫ M.arrowsIso.hom) (limSnd G ≫ M.arrowsIso.hom)
      ((Over.pullback (limit.π C.diagram M.stage)).map M.source)
      ((Over.pullback (limit.π C.diagram M.stage)).map M.target) :=
  (isPullback_limPairs G).of_iso (Iso.refl _) M.arrowsIso M.arrowsIso M.objectsIso
    (by simp) (by simp) (by rw [M.map_source, Iso.hom_inv_id_assoc])
    (by rw [M.map_target, Iso.hom_inv_id_assoc])

/-- The identification over the limit of the composable pairs at the stage with those of the
groupoid over the limit. -/
noncomputable def pairsIso :
    limPairs G ≅ (Over.pullback (limit.π C.diagram M.stage)).obj M.pairs :=
  IsPullback.isoIsPullback _ _ M.isPullback_limPairs_arrowsIso
    ((IsPullback.of_hasPullback M.source M.target).map _)

/-- `pairsIso` is compatible with the first arrows of composable pairs. -/
@[reassoc (attr := simp)]
theorem pairsIso_hom_pairFst : M.pairsIso.hom ≫
    (Over.pullback (limit.π C.diagram M.stage)).map M.pairFst = limFst G ≫ M.arrowsIso.hom :=
  IsPullback.isoIsPullback_hom_fst _ _ _ _

/-- `pairsIso` is compatible with the second arrows of composable pairs. -/
@[reassoc (attr := simp)]
theorem pairsIso_hom_pairSnd : M.pairsIso.hom ≫
    (Over.pullback (limit.π C.diagram M.stage)).map M.pairSnd = limSnd G ≫ M.arrowsIso.hom :=
  IsPullback.isoIsPullback_hom_snd _ _ _ _

/-- The inverse of `pairsIso` is compatible with the first arrows of composable pairs. -/
@[reassoc (attr := simp)]
theorem pairsIso_inv_limFst : M.pairsIso.inv ≫ limFst G =
    (Over.pullback (limit.π C.diagram M.stage)).map M.pairFst ≫ M.arrowsIso.inv := by
  rw [← cancel_epi M.pairsIso.hom, Iso.hom_inv_id_assoc, pairsIso_hom_pairFst_assoc,
    Iso.hom_inv_id, Category.comp_id]

/-- The inverse of `pairsIso` is compatible with the second arrows of composable pairs. -/
@[reassoc (attr := simp)]
theorem pairsIso_inv_limSnd : M.pairsIso.inv ≫ limSnd G =
    (Over.pullback (limit.π C.diagram M.stage)).map M.pairSnd ≫ M.arrowsIso.inv := by
  rw [← cancel_epi M.pairsIso.hom, Iso.hom_inv_id_assoc, pairsIso_hom_pairSnd_assoc,
    Iso.hom_inv_id, Category.comp_id]

/-- The first arrow of a composable pair at the stage reads over the limit as the first arrow of
a composable pair of `G`. -/
theorem map_pairFst : (Over.pullback (limit.π C.diagram M.stage)).map M.pairFst =
    M.pairsIso.inv ≫ limFst G ≫ M.arrowsIso.hom := by
  rw [pairsIso_inv_limFst_assoc, Iso.inv_hom_id, Category.comp_id]

/-- The second arrow of a composable pair at the stage reads over the limit as the second arrow
of a composable pair of `G`. -/
theorem map_pairSnd : (Over.pullback (limit.π C.diagram M.stage)).map M.pairSnd =
    M.pairsIso.inv ≫ limSnd G ≫ M.arrowsIso.hom := by
  rw [pairsIso_inv_limSnd_assoc, Iso.inv_hom_id, Category.comp_id]

/-- The first bracketing of a composable triple at the stage, read over the limit. -/
noncomputable def limAssocLeft :
    (Over.pullback (limit.π C.diagram M.stage)).obj M.triples ⟶ limPairs G :=
  (isPullback_limPairs G).lift
    ((Over.pullback (limit.π C.diagram M.stage)).map M.tripleFst ≫ M.pairsIso.inv ≫ limComp G)
    ((Over.pullback (limit.π C.diagram M.stage)).map M.tripleSnd ≫
      (Over.pullback (limit.π C.diagram M.stage)).map M.pairSnd ≫ M.arrowsIso.inv) (by
    simp only [Category.assoc, limComp_limSource, pairsIso_inv_limSnd_assoc,
      arrowsIso_inv_limSource, arrowsIso_inv_limTarget, ← Functor.map_comp_assoc]
    congr 2
    rw [← Category.assoc, pullback.condition (f := M.pairSnd), Category.assoc,
      pullback.condition (f := M.source)])

/-- The second bracketing of a composable triple at the stage, read over the limit. -/
noncomputable def limAssocRight :
    (Over.pullback (limit.π C.diagram M.stage)).obj M.triples ⟶ limPairs G :=
  (isPullback_limPairs G).lift
    ((Over.pullback (limit.π C.diagram M.stage)).map M.tripleFst ≫
      (Over.pullback (limit.π C.diagram M.stage)).map M.pairFst ≫ M.arrowsIso.inv)
    ((Over.pullback (limit.π C.diagram M.stage)).map M.tripleSnd ≫ M.pairsIso.inv ≫ limComp G)
    (by
    simp only [Category.assoc, limComp_limTarget, pairsIso_inv_limFst_assoc,
      arrowsIso_inv_limSource, arrowsIso_inv_limTarget, ← Functor.map_comp_assoc]
    congr 2
    rw [pullback.condition (f := M.source), ← Category.assoc, pullback.condition (f := M.pairSnd),
      Category.assoc])

/-- The first arrow of `limAssocLeft` is the composite of the first pair of the triple. -/
@[reassoc (attr := simp)]
theorem limAssocLeft_fst : M.limAssocLeft ≫ limFst G =
    (Over.pullback (limit.π C.diagram M.stage)).map M.tripleFst ≫ M.pairsIso.inv ≫ limComp G :=
  IsPullback.lift_fst _ _ _ _

/-- The second arrow of `limAssocLeft` is the last arrow of the triple. -/
@[reassoc (attr := simp)]
theorem limAssocLeft_snd : M.limAssocLeft ≫ limSnd G =
    (Over.pullback (limit.π C.diagram M.stage)).map M.tripleSnd ≫
      (Over.pullback (limit.π C.diagram M.stage)).map M.pairSnd ≫ M.arrowsIso.inv :=
  IsPullback.lift_snd _ _ _ _

/-- The first arrow of `limAssocRight` is the first arrow of the triple. -/
@[reassoc (attr := simp)]
theorem limAssocRight_fst : M.limAssocRight ≫ limFst G =
    (Over.pullback (limit.π C.diagram M.stage)).map M.tripleFst ≫
      (Over.pullback (limit.π C.diagram M.stage)).map M.pairFst ≫ M.arrowsIso.inv :=
  IsPullback.lift_fst _ _ _ _

/-- The second arrow of `limAssocRight` is the composite of the second pair of the triple. -/
@[reassoc (attr := simp)]
theorem limAssocRight_snd : M.limAssocRight ≫ limSnd G =
    (Over.pullback (limit.π C.diagram M.stage)).map M.tripleSnd ≫ M.pairsIso.inv ≫ limComp G :=
  IsPullback.lift_snd _ _ _ _

/-- The base change of the source at the stage, read through the identifications with the stage
models, is the source over the limit. -/
@[reassoc (attr := simp)]
theorem arrowsIso_hom_map_source : M.arrowsIso.hom ≫
    (Over.pullback (limit.π C.diagram M.stage)).map M.source = limSource G ≫ M.objectsIso.hom := by
  rw [M.map_source, Iso.hom_inv_id_assoc]

/-- The base change of the target at the stage, read through the identifications with the stage
models, is the target over the limit. -/
@[reassoc (attr := simp)]
theorem arrowsIso_hom_map_target : M.arrowsIso.hom ≫
    (Over.pullback (limit.π C.diagram M.stage)).map M.target = limTarget G ≫ M.objectsIso.hom := by
  rw [M.map_target, Iso.hom_inv_id_assoc]

/-- The base change of the identity at the stage, read through the identifications with the
stage models, is the identity over the limit. -/
@[reassoc (attr := simp)]
theorem objectsIso_hom_map_identity : M.objectsIso.hom ≫
    (Over.pullback (limit.π C.diagram M.stage)).map M.identity =
      limIdentity G ≫ M.arrowsIso.hom := by
  rw [M.map_identity, Iso.hom_inv_id_assoc]

/-- The base change of the inverse at the stage, read through the identification with the stage
model, is the inverse over the limit. -/
@[reassoc (attr := simp)]
theorem arrowsIso_hom_map_inverse : M.arrowsIso.hom ≫
    (Over.pullback (limit.π C.diagram M.stage)).map M.inverse =
      limInverse G ≫ M.arrowsIso.hom := by
  rw [M.map_inverse, Iso.hom_inv_id_assoc]

/-- A morphism at a stage beyond the stage of `M` is smooth, after base change, if it is so at an
earlier stage. -/
theorem isSmooth_map_left_of_le {j l : Iᵒᵖ} (g : j ⟶ M.stage) (d : l ⟶ j) (E : l ⟶ M.stage)
    {Y Z : Over (C.diagram.obj M.stage)} (hY : C.IsStageObject Y) (hZ' : C.IsStageObject Z)
    (y : Y ⟶ Z) (h : Space.IsSmooth B S hS ((Over.pullback (C.diagram.map g)).map y).left) :
    Space.IsSmooth B S hS ((Over.pullback (C.diagram.map E)).map y).left := by
  have w : C.diagram.map d ≫ C.diagram.map g = C.diagram.map E := by
    rw [← Functor.map_comp, index_hom_eq (d ≫ g) E]
  rw [← Over.transportHom_map (C.diagram.map d) (C.diagram.map g) _ w y]
  have hY₁ := hY.pullback C E
  have hZ₁ := hZ'.pullback C E
  have hY₂ := (hY.pullback C g).pullback C d
  have hZ₂ := (hZ'.pullback C g).pullback C d
  have hb := isSmooth_pullback_map_left (C.stage_isAlgebraicSpace l) (C.stage_isAlgebraicSpace j)
    (C.diagram.map d) (hY.pullback C g).1 (hZ'.pullback C g).1 _ h
  let e₁ := (Over.forget _).mapIso ((Over.pullbackPasteIso (C.diagram.map d) (C.diagram.map g)
    (C.diagram.map E) w).app Y)
  let e₂ := (Over.forget _).mapIso ((Over.pullbackPasteIso (C.diagram.map d) (C.diagram.map g)
    (C.diagram.map E) w).app Z)
  exact isSmooth_comp_comp_of_isIso hY₁.1 hY₂.1 hZ₂.1 hZ₁.1 e₁.inv _ e₂.hom hb

/-! #### The composition and the laws involving it, at a later stage -/

/-- **The composition of a groupoid over the limit at a stage, with the laws of a groupoid.** A
stage beyond the stage of `M`, a composition there, two bracketings of composable triples, the
laws of a groupoid relating them to the base changes of the source, target, identity and inverse
of `M`, and smoothness of the base changes of the source and the target; the composition reads
over the limit as the composition of `G`. -/
structure StageGroupoid where
  /-- The stage. -/
  stage : Iᵒᵖ
  /-- The transition to the stage of `M`. -/
  toBase : stage ⟶ M.stage
  /-- The composition. -/
  comp : (Over.pullback (C.diagram.map toBase)).obj M.pairs ⟶
    (Over.pullback (C.diagram.map toBase)).obj M.arrows
  /-- The first bracketing of a composable triple. -/
  assocLeft : (Over.pullback (C.diagram.map toBase)).obj M.triples ⟶
    (Over.pullback (C.diagram.map toBase)).obj M.pairs
  /-- The second bracketing of a composable triple. -/
  assocRight : (Over.pullback (C.diagram.map toBase)).obj M.triples ⟶
    (Over.pullback (C.diagram.map toBase)).obj M.pairs
  comp_source : comp ≫ (Over.pullback (C.diagram.map toBase)).map M.source =
    (Over.pullback (C.diagram.map toBase)).map (M.pairSnd ≫ M.source)
  comp_target : comp ≫ (Over.pullback (C.diagram.map toBase)).map M.target =
    (Over.pullback (C.diagram.map toBase)).map (M.pairFst ≫ M.target)
  unitLeft_comp : (Over.pullback (C.diagram.map toBase)).map M.unitLeft ≫ comp = 𝟙 _
  unitRight_comp : (Over.pullback (C.diagram.map toBase)).map M.unitRight ≫ comp = 𝟙 _
  inverseLeft_comp : (Over.pullback (C.diagram.map toBase)).map M.inverseLeft ≫ comp =
    (Over.pullback (C.diagram.map toBase)).map (M.source ≫ M.identity)
  inverseRight_comp : (Over.pullback (C.diagram.map toBase)).map M.inverseRight ≫ comp =
    (Over.pullback (C.diagram.map toBase)).map (M.target ≫ M.identity)
  assocLeft_fst : assocLeft ≫ (Over.pullback (C.diagram.map toBase)).map M.pairFst =
    (Over.pullback (C.diagram.map toBase)).map M.tripleFst ≫ comp
  assocLeft_snd : assocLeft ≫ (Over.pullback (C.diagram.map toBase)).map M.pairSnd =
    (Over.pullback (C.diagram.map toBase)).map (M.tripleSnd ≫ M.pairSnd)
  assocRight_fst : assocRight ≫ (Over.pullback (C.diagram.map toBase)).map M.pairFst =
    (Over.pullback (C.diagram.map toBase)).map (M.tripleFst ≫ M.pairFst)
  assocRight_snd : assocRight ≫ (Over.pullback (C.diagram.map toBase)).map M.pairSnd =
    (Over.pullback (C.diagram.map toBase)).map M.tripleSnd ≫ comp
  assoc : assocLeft ≫ comp = assocRight ≫ comp
  limitHom_comp : C.limitHom toBase comp = M.pairsIso.inv ≫ limComp G ≫ M.arrowsIso.hom
  /-- The base change of the source of `M` to the stage is smooth. -/
  source_isSmooth :
    Space.IsSmooth B S hS ((Over.pullback (C.diagram.map toBase)).map M.source).left
  /-- The base change of the target of `M` to the stage is smooth. -/
  target_isSmooth :
    Space.IsSmooth B S hS ((Over.pullback (C.diagram.map toBase)).map M.target).left

/-- A morphism of the slice over the limit, conjugated by two isomorphisms, is smooth if it is. -/
theorem isSmooth_left_conj {L N : Over (limit C.diagram)} {Y Z : Over (C.diagram.obj M.stage)}
    (hL : IsAlgebraicSpace B S hS L.left) (hN : IsAlgebraicSpace B S hS N.left)
    (hY : C.IsStageObject Y) (hZ' : C.IsStageObject Z)
    (ιY : L ≅ (Over.pullback (limit.π C.diagram M.stage)).obj Y)
    (ιZ : N ≅ (Over.pullback (limit.π C.diagram M.stage)).obj Z) (f : L ⟶ N)
    (hf : Space.IsSmooth B S hS f.left) : Space.IsSmooth B S hS (ιY.inv ≫ f ≫ ιZ.hom).left := by
  have hY' : IsAlgebraicSpace B S hS (pullback Y.hom (limit.π C.diagram M.stage)) :=
    isAlgebraicSpace_pullback B S hS _ _ hY.1 C.limit_isAlgebraicSpace (C.stage_isAlgebraicSpace _)
  have hZ'' : IsAlgebraicSpace B S hS (pullback Z.hom (limit.π C.diagram M.stage)) :=
    isAlgebraicSpace_pullback B S hS _ _ hZ'.1 C.limit_isAlgebraicSpace (C.stage_isAlgebraicSpace _)
  exact isSmooth_comp_comp_of_isIso hY' hL hN hZ'' ((Over.forget _).mapIso ιY).inv f.left
    ((Over.forget _).mapIso ιZ).hom hf

/-- **Stacks 0CN2 at the stage of `M`.** A morphism from the arrow space to the object space at
the stage of `M` whose reading over the limit is smooth becomes smooth at every late enough
stage. -/
theorem eventually_isSmooth {j : Iᵒᵖ} (e : j ⟶ M.stage) (y : M.arrows ⟶ M.objects)
    (hy : Space.IsSmooth B S hS ((Over.pullback (limit.π C.diagram M.stage)).map y).left) :
    Eventually j (fun _ c =>
      Space.IsSmooth B S hS ((Over.pullback (C.diagram.map (c ≫ e))).map y).left) := by
  have hR := M.arrows_isStageObject
  have hU := M.objects_isStageObject
  obtain ⟨js, gs, hs⟩ := C.exists_isSmooth_mapAt_of_isSmooth_mapLimit M.stage M.arrows M.objects
    hR.1 hU.1 hR.2 hU.2 y (C.isFinitePresentation_left hR hU y).1
    ((isSmooth_pullback_map_left_iff C.limit_isAlgebraicSpace (C.stage_isAlgebraicSpace _)
      (limit.π C.diagram M.stage) hR.1 hU.1 y _).2 hy)
  have hgs : Space.IsSmooth B S hS ((Over.pullback (C.diagram.map gs)).map y).left :=
    (isSmooth_pullback_map_left_iff (C.stage_isAlgebraicSpace js) (C.stage_isAlgebraicSpace _)
      (C.diagram.map gs) hR.1 hU.1 y _).1 hs
  exact ⟨js.unop, fun l c hl => M.isSmooth_map_left_of_le gs (homOfLE hl).op (c ≫ e) hR hU y hgs⟩

/-- For a smooth groupoid `G`, the base change to the limit of the source at the stage is
smooth. -/
theorem isSmooth_map_source (hG : GroupoidInAlgebraicSpaces.IsSmooth B S hS G) :
    Space.IsSmooth B S hS ((Over.pullback (limit.π C.diagram M.stage)).map M.source).left := by
  rw [M.map_source]
  exact M.isSmooth_left_conj G.arrows.property G.objects.property M.arrows_isStageObject
    M.objects_isStageObject _ _ _ hG.1

/-- For a smooth groupoid `G`, the base change to the limit of the target at the stage is
smooth. -/
theorem isSmooth_map_target (hG : GroupoidInAlgebraicSpaces.IsSmooth B S hS G) :
    Space.IsSmooth B S hS ((Over.pullback (limit.π C.diagram M.stage)).map M.target).left := by
  rw [M.map_target]
  exact M.isSmooth_left_conj G.arrows.property G.objects.property M.arrows_isStageObject
    M.objects_isStageObject _ _ _ hG.2

/-- **The composition and the laws of a groupoid descend to a stage.** Stacks 07SK, fullness,
descends the composition and the two bracketings of composable triples; its faithfulness clause
descends each law, which holds over the limit because it holds in `G`; and Stacks 0CN2 makes the
source and the target smooth at a late enough stage. -/
theorem nonempty_stageGroupoid (hG : GroupoidInAlgebraicSpaces.IsSmooth B S hS G) :
    Nonempty M.StageGroupoid := by
  classical
  have hU := M.objects_isStageObject
  have hR := M.arrows_isStageObject
  have hP := M.pairs_isStageObject
  have hT := M.triples_isStageObject
  obtain ⟨j₁, e₁, m₁, hm₁⟩ :=
    C.exists_limitHom_eq hP hR (M.pairsIso.inv ≫ limComp G ≫ M.arrowsIso.hom)
  obtain ⟨j₂, e₂, l₁, hl₁⟩ := C.exists_limitHom_eq hT hP (M.limAssocLeft ≫ M.pairsIso.hom)
  obtain ⟨j₃, e₃, r₁, hr₁⟩ := C.exists_limitHom_eq hT hP (M.limAssocRight ≫ M.pairsIso.hom)
  obtain ⟨k, c₁, c₂, -⟩ := exists_le_le j₁ j₂
  obtain ⟨j, d, c₃, -⟩ := exists_le_le k j₃
  let e : j ⟶ M.stage := (d ≫ c₁) ≫ e₁
  let m := C.restrictHom e₁ (d ≫ c₁) e rfl m₁
  let aL := C.restrictHom e₂ (d ≫ c₂) e (index_hom_eq _ _) l₁
  let aR := C.restrictHom e₃ c₃ e (index_hom_eq _ _) r₁
  have hm : C.limitHom e m = M.pairsIso.inv ≫ limComp G ≫ M.arrowsIso.hom :=
    (C.limitHom_restrictHom _ _ _ _ _).trans hm₁
  have haL : C.limitHom e aL = M.limAssocLeft ≫ M.pairsIso.hom :=
    (C.limitHom_restrictHom _ _ _ _ _).trans hl₁
  have haR : C.limitHom e aR = M.limAssocRight ≫ M.pairsIso.hom :=
    (C.limitHom_restrictHom _ _ _ _ _).trans hr₁
  let Φ := Over.pullback (C.diagram.map e)
  have q₁ : C.limitHom e (m ≫ Φ.map M.source) = C.limitHom e (Φ.map (M.pairSnd ≫ M.source)) := by
    simp only [Φ, C.limitHom_comp, C.limitHom_map, hm]
    simp [reassoc_of% limComp_limSource G]
  have q₂ : C.limitHom e (m ≫ Φ.map M.target) = C.limitHom e (Φ.map (M.pairFst ≫ M.target)) := by
    simp only [Φ, C.limitHom_comp, C.limitHom_map, hm]
    simp [reassoc_of% limComp_limTarget G]
  have q₃ : C.limitHom e (Φ.map M.unitLeft ≫ m) = C.limitHom e (𝟙 _) := by
    simp only [Φ, C.limitHom_comp, C.limitHom_map, C.limitHom_id, hm]
    have h := limComp_unitLeft G M.arrowsIso.inv
      ((Over.pullback (limit.π C.diagram M.stage)).map M.unitLeft ≫ M.pairsIso.inv)
      (by simp only [Category.assoc, pairsIso_inv_limFst, arrowsIso_inv_limTarget_assoc,
            objectsIso_inv_limIdentity, ← Functor.map_comp_assoc, unitLeft_fst])
      (by simp only [Category.assoc, pairsIso_inv_limSnd, ← Functor.map_comp_assoc,
            unitLeft_snd, CategoryTheory.Functor.map_id, Category.id_comp])
    rw [← Category.assoc, ← Category.assoc, h, Iso.inv_hom_id]
  have q₄ : C.limitHom e (Φ.map M.unitRight ≫ m) = C.limitHom e (𝟙 _) := by
    simp only [Φ, C.limitHom_comp, C.limitHom_map, C.limitHom_id, hm]
    have h := limComp_unitRight G M.arrowsIso.inv
      ((Over.pullback (limit.π C.diagram M.stage)).map M.unitRight ≫ M.pairsIso.inv)
      (by simp only [Category.assoc, pairsIso_inv_limFst, ← Functor.map_comp_assoc,
            unitRight_fst, CategoryTheory.Functor.map_id, Category.id_comp])
      (by simp only [Category.assoc, pairsIso_inv_limSnd, arrowsIso_inv_limSource_assoc,
            objectsIso_inv_limIdentity, ← Functor.map_comp_assoc, unitRight_snd])
    rw [← Category.assoc, ← Category.assoc, h, Iso.inv_hom_id]
  have q₅ : C.limitHom e (Φ.map M.inverseLeft ≫ m) =
      C.limitHom e (Φ.map (M.source ≫ M.identity)) := by
    simp only [Φ, C.limitHom_comp, C.limitHom_map, hm]
    have h := limComp_inverseLeft G M.arrowsIso.inv
      ((Over.pullback (limit.π C.diagram M.stage)).map M.inverseLeft ≫ M.pairsIso.inv)
      (by simp only [Category.assoc, pairsIso_inv_limFst, arrowsIso_inv_limInverse,
            ← Functor.map_comp_assoc, inverseLeft_fst])
      (by simp only [Category.assoc, pairsIso_inv_limSnd, ← Functor.map_comp_assoc,
            inverseLeft_snd, CategoryTheory.Functor.map_id, Category.id_comp])
    rw [← Category.assoc, ← Category.assoc, h]
    simp
  have q₆ : C.limitHom e (Φ.map M.inverseRight ≫ m) =
      C.limitHom e (Φ.map (M.target ≫ M.identity)) := by
    simp only [Φ, C.limitHom_comp, C.limitHom_map, hm]
    have h := limComp_inverseRight G M.arrowsIso.inv
      ((Over.pullback (limit.π C.diagram M.stage)).map M.inverseRight ≫ M.pairsIso.inv)
      (by simp only [Category.assoc, pairsIso_inv_limFst, ← Functor.map_comp_assoc,
            inverseRight_fst, CategoryTheory.Functor.map_id, Category.id_comp])
      (by simp only [Category.assoc, pairsIso_inv_limSnd, arrowsIso_inv_limInverse,
            ← Functor.map_comp_assoc, inverseRight_snd])
    rw [← Category.assoc, ← Category.assoc, h]
    simp
  have q₇ : C.limitHom e (aL ≫ Φ.map M.pairFst) = C.limitHom e (Φ.map M.tripleFst ≫ m) := by
    simp only [Φ, C.limitHom_comp, C.limitHom_map, hm, haL]
    simp
  have q₈ : C.limitHom e (aL ≫ Φ.map M.pairSnd) =
      C.limitHom e (Φ.map (M.tripleSnd ≫ M.pairSnd)) := by
    simp only [Φ, C.limitHom_comp, C.limitHom_map, haL]
    simp
  have q₉ : C.limitHom e (aR ≫ Φ.map M.pairFst) =
      C.limitHom e (Φ.map (M.tripleFst ≫ M.pairFst)) := by
    simp only [Φ, C.limitHom_comp, C.limitHom_map, haR]
    simp
  have q₁₀ : C.limitHom e (aR ≫ Φ.map M.pairSnd) = C.limitHom e (Φ.map M.tripleSnd ≫ m) := by
    simp only [Φ, C.limitHom_comp, C.limitHom_map, hm, haR]
    simp
  have q₁₁ : C.limitHom e (aL ≫ m) = C.limitHom e (aR ≫ m) := by
    simp only [C.limitHom_comp, hm, haL, haR, Category.assoc, Iso.hom_inv_id_assoc]
    have h := limComp_assoc G
      ((Over.pullback (limit.π C.diagram M.stage)).map M.tripleFst ≫ M.pairsIso.inv)
      ((Over.pullback (limit.π C.diagram M.stage)).map M.tripleSnd ≫ M.pairsIso.inv)
      M.limAssocLeft M.limAssocRight
      (by simp only [Category.assoc, pairsIso_inv_limSnd, pairsIso_inv_limFst,
            ← Functor.map_comp_assoc, pullback.condition])
      (by simp) (by simp) (by simp) (by simp)
    rw [← Category.assoc, h, Category.assoc]
  obtain ⟨F, c, w₁, w₂, w₃, w₄, w₅, w₆, w₇, w₈, w₉, w₁₀, w₁₁, hs, ht⟩ :=
    Eventually.exists
      ((C.eventually_restrictHom_eq e hP hU q₁).and
      ((C.eventually_restrictHom_eq e hP hU q₂).and
      ((C.eventually_restrictHom_eq e hR hR q₃).and
      ((C.eventually_restrictHom_eq e hR hR q₄).and
      ((C.eventually_restrictHom_eq e hR hR q₅).and
      ((C.eventually_restrictHom_eq e hR hR q₆).and
      ((C.eventually_restrictHom_eq e hT hR q₇).and
      ((C.eventually_restrictHom_eq e hT hR q₈).and
      ((C.eventually_restrictHom_eq e hT hR q₉).and
      ((C.eventually_restrictHom_eq e hT hR q₁₀).and
      ((C.eventually_restrictHom_eq e hT hR q₁₁).and
      ((M.eventually_isSmooth e M.source (M.isSmooth_map_source hG)).and
      (M.eventually_isSmooth e M.target (M.isSmooth_map_target hG))))))))))))))
  simp only [Φ, C.restrictHom_comp, C.restrictHom_map, C.restrictHom_id] at w₁ w₂ w₃ w₄ w₅ w₆
  simp only [Φ, C.restrictHom_comp, C.restrictHom_map] at w₇ w₈ w₉ w₁₀ w₁₁
  exact ⟨{ stage := F
           toBase := c ≫ e
           comp := C.restrictHom e c (c ≫ e) rfl m
           assocLeft := C.restrictHom e c (c ≫ e) rfl aL
           assocRight := C.restrictHom e c (c ≫ e) rfl aR
           comp_source := w₁
           comp_target := w₂
           unitLeft_comp := w₃
           unitRight_comp := w₄
           inverseLeft_comp := w₅
           inverseRight_comp := w₆
           assocLeft_fst := w₇
           assocLeft_snd := w₈
           assocRight_fst := w₉
           assocRight_snd := w₁₀
           assoc := w₁₁
           limitHom_comp := (C.limitHom_restrictHom _ _ _ _ _).trans hm
