module

public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
public import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.GroupScheme.OverField.GradedAction

/-!
# The multiplicative group acting on infinite affine space with `p`-power weights

Over a commutative ring `k` and for a natural number `p`, the polynomial ring
`k[x_0, x_1, x_2, …]` carries the integer grading in which `x_i` has degree `p^i`.  The
multiplicative-group action on `U = Spec(k[x_0, x_1, x_2, …])` that this grading defines is
`t · (x_0, x_1, x_2, …) = (t x_0, t^p x_1, t^{p^2} x_2, …)`.

## Main definitions

* `AlgebraicGeometry.PPowerWeighted.weight` and `AlgebraicGeometry.PPowerWeighted.grading`:
  the degree `p^i` of the variable `x_i`, and the resulting integer grading of
  `k[x_0, x_1, x_2, …]`.
The affine scheme `U = Spec(k[x_0, x_1, x_2, …])` this file works over is
`AlgebraicGeometry.infiniteAffineSpace`
(`StacksFrontier/AlgebraicGeometry/Scheme/Separation/DoubledOrigin.lean`); the copy that used to
stand here under the name `totalSpace` was the same definition.

* `AlgebraicGeometry.PPowerWeighted.action`: the action of the multiplicative group scheme on
  `U` attached to this grading, together with its coaction.
* `AlgebraicGeometry.PPowerWeighted.coordinateIdeal`: the ideal generated by a set of the
  coordinates, cutting out the closed subscheme of `U` on which they vanish.

## Main results

* `AlgebraicGeometry.PPowerWeighted.action_μ_X`: the coaction sends `x_i` to `x_i ⊗ T^{p^i}`,
  so the group element `t` scales `x_i` by `t^{p^i}`.
* `AlgebraicGeometry.PPowerWeighted.isHomogeneous_coordinateIdeal`: an ideal generated by
  coordinates is homogeneous for this grading, hence its zero locus in `U` is invariant under
  the action.

## Implementation notes

The construction needs no hypothesis on `p` and none on `k` beyond commutativity, although the
source states it for a prime `p` and a field `k`.  The grading is the weighted-homogeneous
grading of `MvPolynomial ℕ k` for the weight function `i ↦ p ^ i`, and the action is the one a
grading defines on the spectrum, whose coaction sends a homogeneous element of degree `n` to
`a ⊗ T^n`.

Only the construction of `U` and of the action is formalized here.  That the quotient
`[U/G_m]` is an algebraic stack, that its strata — where `x_0, …, x_{i-1}` vanish and `x_i`
does not, and where all the coordinates vanish — are reduced locally closed substacks which
are gerbes over schemes banded by `μ_{p^i}` and by `G_m`, and that no coarser stratification
by gerbes exists, are not proved here.

## References

* [Stacks Project, Tag 06RE](https://stacks.math.columbia.edu/tag/06RE)
-/

@[expose] public section

open CategoryTheory
open scoped TensorProduct

universe u

namespace AlgebraicGeometry.PPowerWeighted

/-- The degree of the variable `x_i` in the `p`-power grading of `k[x_0, x_1, x_2, …]`. -/
def weight (p i : ℕ) : ℤ := (p : ℤ) ^ i

/-- The grading of `k[x_0, x_1, x_2, …]` in which the variable `x_i` has degree `p^i`. -/
def grading (k : Type u) [CommRing k] (p : ℕ) : ℤ → Submodule k (MvPolynomial ℕ k) :=
  MvPolynomial.weightedHomogeneousSubmodule k (weight p)

/-- The `p`-power grading makes `k[x_0, x_1, x_2, …]` a graded ring. -/
noncomputable instance instGradedRingGrading (k : Type u) [CommRing k] (p : ℕ) :
    GradedRing (grading k p) :=
  MvPolynomial.weightedGradedAlgebra k (weight p)

/-- The variable `x_i` is homogeneous of degree `p^i`. -/
theorem X_mem_grading (k : Type u) [CommRing k] (p i : ℕ) :
    (MvPolynomial.X i : MvPolynomial ℕ k) ∈ grading k p (weight p i) :=
  (MvPolynomial.mem_weightedHomogeneousSubmodule k _ _ _).2
    (MvPolynomial.isWeightedHomogeneous_X (R := k) (weight p) i)

/-- **Stacks 06RE.** The action of the multiplicative group scheme on
`U = Spec(k[x_0, x_1, x_2, …])` attached to the grading giving `x_i` the degree `p^i`, namely
`t · (x_0, x_1, x_2, …) = (t x_0, t^p x_1, t^{p^2} x_2, …)`. -/
@[stacks 06RE "the weighted multiplicative-group action on Spec k[x_0, x_1, x_2, ...]"]
noncomputable def action (k : Type u) [CommRing k] (p : ℕ) : GradedGmAction (grading k p) :=
  gradedGmAction (grading k p)

/-- **Stacks 06RE.** The coaction of the action sends the variable `x_i` to `x_i ⊗ T^{p^i}`:
the group element `t` scales the coordinate `x_i` by `t^{p^i}`. -/
@[stacks 06RE "the coaction on the variables: x_i goes to x_i tensor T^{p^i}"]
theorem action_μ_X (k : Type u) [CommRing k] (p i : ℕ) :
    (action k p).μ (MvPolynomial.X i) =
      (MvPolynomial.X i : MvPolynomial ℕ k) ⊗ₜ[ℤ] LaurentPolynomial.T ((p : ℤ) ^ i) :=
  (action k p).μ_homogeneous (weight p i) _ (X_mem_grading k p i)

/-- The ideal of `k[x_0, x_1, x_2, …]` generated by the coordinates indexed by `s`.  Its zero
locus is the closed subscheme of `U` on which those coordinates vanish. -/
noncomputable def coordinateIdeal (k : Type u) [CommRing k] (s : Set ℕ) :
    Ideal (MvPolynomial ℕ k) :=
  Ideal.span (MvPolynomial.X '' s)

/-- An ideal generated by coordinates is homogeneous for the `p`-power grading, so the closed
subscheme of `U` it cuts out is invariant under the action. -/
theorem isHomogeneous_coordinateIdeal (k : Type u) [CommRing k] (p : ℕ) (s : Set ℕ) :
    (coordinateIdeal k s).IsHomogeneous (grading k p) :=
  Ideal.homogeneous_span _ _ fun _ hx => by
    obtain ⟨i, _, rfl⟩ := hx
    exact ⟨weight p i, X_mem_grading k p i⟩

end AlgebraicGeometry.PPowerWeighted

end
