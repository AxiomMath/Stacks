module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Topologies.Fppf.FibreProducts

/-!
# Refining a covering sieve of a big fppf site by an fpqc covering family

Let `B` be a big fppf site, let `S` be a scheme contained in it and let `U` be an object of the
big fppf category over `S`. This file shows that every covering sieve of `U` is refined by a
covering *family* `{V l ⟶ U}` whose underlying family of morphisms of schemes is an fpqc
covering family.

Both halves are forced by the construction of the site. The topology of `B` is the Grothendieck
topology generated by the site's own chosen covering families, so a covering sieve contains the
generated sieve of one of them, by induction over the generation; and a chosen covering family
is an fppf covering family, hence an fpqc one.

This is the step "in order to prove effectivity we may first refine the covering" of the proof
of the stack condition for the category of finite locally free covers: it is the input of
`CategoryTheory.Functor.hasEffectiveDescent_of_familyRefinements`, which asks for a covering
family inside each covering sieve, and the fpqc conclusion is what the descent of schemes along
the refinement consumes.

## Main results

* `AlgebraicGeometry.BigFppfSite.exists_isCovering_presieve₀_le`: a covering sieve of the
  underlying category of a big fppf site contains one of the site's chosen covering families.
* `AlgebraicGeometry.BigFppfOver.exists_fpqc_family_refining`: a covering sieve of the big fppf
  category over `S` contains a covering family whose underlying morphisms of schemes form an
  fpqc covering family.

## Implementation notes

The index type of the refining family is `Type (u + 1)`, the universe in which the index types
of the site's chosen covering families live; it is not shrunk, because the
consumer `CategoryTheory.Functor.hasEffectiveDescent_of_familyRefinements` is free in that
universe and the descent of schemes used afterwards,
`AlgebraicGeometry.DescentData.isFamilyEffective_of_isAffineHom_of_anyIndex`, places no
restriction on it either.

## References

* [Stacks Project, Tag 021R](https://stacks.math.columbia.edu/tag/021R)
* [Stacks Project, Tag 021S](https://stacks.math.columbia.edu/tag/021S)
* [Stacks Project, Tag 023Q](https://stacks.math.columbia.edu/tag/023Q)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-- **A covering sieve of the underlying category of a big fppf site contains one of the site's
own chosen covering families.** The topology is generated by those families, so the statement is
an induction over the generation: a generated sieve contains its own family, the maximal sieve
contains the identity, a pullback contains the base change supplied by the base-change axiom of
the site, and a transitive composite contains the composite supplied by the composition
axiom. -/
theorem BigFppfSite.exists_isCovering_presieve₀_le (B : BigFppfSite.{u}) {T : B.Schemes}
    {R : Sieve T} (hR : R ∈ B.topology T) :
    ∃ E : PreZeroHypercover.{u + 1} T, B.IsCovering ⟨T, E⟩ ∧ E.presieve₀ ≤ R.arrows := by
  rw [BigFppfSite.topology, Precoverage.mem_toGrothendieck_iff] at hR
  induction hR with
  | of T P hP =>
      obtain ⟨E, hEq, hE⟩ := hP
      refine ⟨E, hE, ?_⟩
      rw [hEq]
      exact Sieve.le_generate _
  | top T =>
      exact ⟨PreZeroHypercover.singleton (𝟙 T), B.coverings_isSite.1 (𝟙 T), by
        intro Y f hf
        trivial⟩
  | pullback T R hR Y f ih =>
      obtain ⟨E, hE, hle⟩ := ih
      obtain ⟨P, p₁, p₂, hpb, hP⟩ := B.coverings_isSite.2.2 ⟨T, E⟩ hE Y f
      refine ⟨⟨E.I₀, P, p₂⟩, hP, ?_⟩
      rw [Presieve.ofArrows_le_iff]
      intro i
      rw [Sieve.pullback_apply, ← (hpb i).w]
      exact R.downward_closed (hle _ _ ⟨i⟩) (p₁ i)
  | transitive T R Q hR hRQ ihR ihRQ =>
      obtain ⟨E, hE, hle⟩ := ihR
      have hlocal (i : E.I₀) := ihRQ (hle _ _ ⟨i⟩)
      choose E' hE' hE'le using hlocal
      refine ⟨E.bind E', B.coverings_isSite.2.1 ⟨T, E⟩ hE (fun i ↦ ⟨E.X i, E' i⟩) hE'
        (fun _ ↦ rfl), ?_⟩
      rw [Presieve.ofArrows_le_iff]
      rintro ⟨i, j⟩
      exact hE'le i _ _ ⟨j⟩

namespace BigFppfOver

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- **A covering sieve of the big fppf category over `S` contains a covering family whose
underlying morphisms of schemes form an fpqc covering family.** The sieve comes from a covering
sieve of the ambient category, which contains one of the site's chosen covering families; that
family is transported into the slice by composing its morphisms with the structure morphism of
the base, and it is an fppf, hence fpqc, covering family of schemes. -/
theorem exists_fpqc_family_refining {U : BigFppfOver B S hS} (R : Sieve U)
    (hR : R ∈ BigFppfOver.topology B S hS U) :
    ∃ (L : Type (u + 1)) (V : L → BigFppfOver B S hS) (f : ∀ l, V l ⟶ U),
      (∀ l, R.arrows (f l)) ∧
      Sieve.ofArrows V f ∈ BigFppfOver.topology B S hS U ∧
      Presieve.ofArrows (fun l ↦ (BigFppfOver.toScheme B S hS).obj (V l))
        (fun l ↦ (BigFppfOver.toScheme B S hS).map (f l)) ∈
        Scheme.fpqcPrecoverage ((BigFppfOver.toScheme B S hS).obj U) := by
  rw [GrothendieckTopology.mem_over_iff] at hR
  obtain ⟨E, hE, hle⟩ := B.exists_isCovering_presieve₀_le hR
  refine ⟨E.I₀, fun l ↦ Over.mk (E.f l ≫ U.hom), fun l ↦ Over.homMk (E.f l), fun l ↦ ?_, ?_, ?_⟩
  · exact (Sieve.overEquiv_iff R (E.f l)).1 (hle _ _ ⟨l⟩)
  · rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
    exact Precoverage.generate_mem_toGrothendieck ⟨E, rfl, hE⟩
  · refine Scheme.fppfPrecoverage_le_fpqcPrecoverage _ ?_
    have hEfp : AlgebraicGeometry.IsFppfCovering ⟨U.left, E⟩ :=
      B.isFppfCovering_of_isCovering hE
    simpa [AlgebraicGeometry.IsFppfCovering, PreZeroHypercover.presieve₀_map] using hEfp

end BigFppfOver

end AlgebraicGeometry

end
