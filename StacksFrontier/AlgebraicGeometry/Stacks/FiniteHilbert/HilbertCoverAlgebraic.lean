/-!
# The category of degree-`d` finite locally free covers is a stack

Let `ℋ_d` be the category of degree-`d` finite locally free covers in the big fppf site of a
scheme `S`. Descent data of `ℋ_d` relative to a jointly surjective flat family locally of finite
presentation are effective, so `ℋ_d` is a stack, and a stack in groupoids, for the fppf topology.
Since `ℋ_d` is an algebraic stack (Stacks 05YQ,
`AlgebraicGeometry.Stack.isAlgebraicStack_finiteCoverFibered`), so is the finite Hilbert stack
`ℋ_d(𝒳)` of an algebraic space `𝒳` over `S` (Stacks 05YS).

## Main results

* `AlgebraicGeometry.Stack.affineFamilyEffectiveDescent`: descent data of `ℋ_d` relative to the
  sieve generated by a jointly surjective flat family locally of finite presentation with affine
  sources are effective.
* `AlgebraicGeometry.Stack.hasEffectiveDescent_finiteCoverProjection`: condition (3) of Stacks
  026F for `ℋ_d`.
* `AlgebraicGeometry.Stack.isStack_finiteCoverFibered` and
  `AlgebraicGeometry.Stack.isStackInGroupoids_finiteCoverFibered`: `ℋ_d` is a stack, and a stack
  in groupoids, for the fppf topology.
* `AlgebraicGeometry.Stack.isAlgebraicStack_absoluteHilbertFibered`: the finite Hilbert stack
  `ℋ_d(𝒳)` of an algebraic space over `S` is an algebraic stack.

## Implementation notes

The hypothesis `NeZero d` is the scope of the source: `ℋ_d` is introduced only for `d ≥ 1`
(Examples of Stacks, Section 95.18, Stacks 05WA), and Section 97.13 (Stacks 05YL), which contains
Stacks 05YQ, opens with "Let `d ≥ 1` be an integer."

## References

* [Stacks Project, Tag 026F](https://stacks.math.columbia.edu/tag/026F)
* [Stacks Project, Tag 05WA](https://stacks.math.columbia.edu/tag/05WA)
* [Stacks Project, Tag 05YL](https://stacks.math.columbia.edu/tag/05YL)
* [Stacks Project, Tag 05YQ](https://stacks.math.columbia.edu/tag/05YQ)
* [Stacks Project, Tag 05YS](https://stacks.math.columbia.edu/tag/05YS)
-/

@[expose] public section

open CategoryTheory

universe u w

namespace AlgebraicGeometry.Stack

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S) (d : ℕ)

/-- Descent data of `ℋ_d` relative to the sieve generated by a jointly surjective flat family
locally of finite presentation with affine sources are effective. -/
theorem affineFamilyEffectiveDescent : AffineFamilyEffectiveDescent B S hS d :=
  fun _T _ι _X _g _ hflat hlfp hsurj D ↦
    isEffective_of_flat_of_locallyOfFinitePresentation D hflat hlfp hsurj

/-- **Condition (3) of Stacks 026F for the category of degree-`d` finite locally free covers.**
Every descent datum of `ℋ_d` relative to every covering sieve of the big fppf site of `S` is
effective. -/
theorem hasEffectiveDescent_finiteCoverProjection :
    (finiteCoverProjection (B := B) (S := S) (hS := hS) (d := d)).HasEffectiveDescent
      (BigFppfOver.topology B S hS) :=
  hasEffectiveDescent_finiteCoverProjection_of_affineRefinements B S hS d
    (affineFamilyEffectiveDescent B S hS d)

/-- **The category of degree-`d` finite locally free covers is a stack** for the fppf topology on
the big fppf site of `S`. -/
theorem isStack_finiteCoverFibered :
    (finiteCoverFibered B S hS d).val.p.IsStack (BigFppfOver.topology B S hS) :=
  isStack_finiteCoverFibered_of_affineRefinements B S hS d
    (affineFamilyEffectiveDescent B S hS d)

/-- **The category of degree-`d` finite locally free covers is a stack in groupoids** for the
fppf topology on the big fppf site of `S`. -/
theorem isStackInGroupoids_finiteCoverFibered :
    (finiteCoverFibered B S hS d).val.p.IsStackInGroupoids.{w} (BigFppfOver.topology B S hS) :=
  isStackInGroupoids_finiteCoverFibered_of_affineRefinements B S hS d
    (affineFamilyEffectiveDescent B S hS d)

/-- The finite Hilbert stack `ℋ_d(𝒳)` of an algebraic space `𝒳` over `S` is an algebraic
stack. -/
@[stacks 05YS "`NeZero d` restricts nothing: Examples of Stacks, Section 95.18 (Stacks 05WA) \
introduces `ℋ_d(X)` only `For each integer d ≥ 1`, and the source's proof of this lemma cites \
Stacks 05YQ, which stands under the `Let d ≥ 1 be an integer` of Section 97.13 (Stacks 05YL)"]
theorem isAlgebraicStack_absoluteHilbertFibered [NeZero d]
    (𝒳 : StackInGroupoids.{w, u, u, u + 1, u + 1} (BigFppfOver B S hS)
      (BigFppfOver.topology B S hS))
    (h𝒳 : IsRepresentableByAlgebraicSpace B S hS
      (CatFiberedInGroupoids.mk 𝒳.toBasedCategory
        𝒳.isStackInGroupoids.isFiberedInGroupoids)) :
    IsAlgebraicStack.{u, w} B S hS (absoluteHilbertFibered 𝒳 d).val :=
  isAlgebraicStack_absoluteHilbertCategory 𝒳 d h𝒳

end AlgebraicGeometry.Stack

end
