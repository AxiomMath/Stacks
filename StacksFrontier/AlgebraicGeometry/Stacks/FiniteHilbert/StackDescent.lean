module

public import StacksFrontier.AlgebraicGeometry.Stacks.FiniteHilbert.DescentCocones
public import StacksFrontier.AlgebraicGeometry.Stacks.FiniteHilbert.StackCoverDescent
import all StacksFrontier.AlgebraicGeometry.Stacks.FiniteHilbert.StackIsom

/-!
# The relative finite Hilbert category is a stack in groupoids

Let `F : 𝒳 ⟶ 𝒴` be a 1-morphism of stacks in groupoids over the big fppf site of a scheme `S`
and let `d` be a natural number. This file proves that every descent datum of the relative finite
Hilbert category `ℋ_d(𝒳/𝒴)` relative to a covering family is effective, the third of the three
conditions of Stacks 05WB, and concludes that `ℋ_d(𝒳/𝒴)` is a stack in groupoids.

Let `{U i ⟶ U}` be a covering family and let `ξ i = (U i, Z i, y i, x i, α i)` be a descent datum
of `ℋ_d(𝒳/𝒴)` relative to it.

1. The covers `Z i ⟶ U i` form a descent datum of schemes whose structure morphisms are affine,
   so they descend to a scheme `Z` over `U` which is again finite locally free of degree `d`
   (Stacks 0245 and Stacks 02VO). The descent is carried out over a refinement of the family by
   a covering family whose underlying family of schemes is an fpqc covering family, and the
   result is extended to the sieve generated by the family.
2. The objects `y i` of `𝒴` descend to an object `y` over `U`, because `𝒴` is a stack in
   groupoids.
3. The objects `x i` of `𝒳` descend to an object `x` over `Z`, because `𝒳` is a stack in
   groupoids and `{Z i ⟶ Z}` is a covering family of `Z`, being the base change of `{U i ⟶ U}`
   along `Z ⟶ U`.
4. The identifications `α i` glue to an identification `α : F x ⟶ y` over `Z ⟶ U`, because the
   `Isom` presheaves of `𝒴` are sheaves.

The quintuple `(U, Z, y, x, α)` is then an object of `ℋ_d(𝒳/𝒴)` over `U` receiving a cocone from
the datum.

## Main results

* `AlgebraicGeometry.Stack.FiniteHilbert.descentDatum_isEffective`: condition (3) of Stacks 05WB,
  effectivity of every descent datum of `ℋ_d(𝒳/𝒴)` relative to a covering family of the big fppf
  site.
* `AlgebraicGeometry.Stack.isStackInGroupoids_finiteHilbertProjection`: `ℋ_d(𝒳/𝒴)` is a stack in
  groupoids over the big fppf site of `S`.

## Implementation notes

Conditions (1) and (2) of Stacks 05WB are
`AlgebraicGeometry.Stack.isFiberedInGroupoids_finiteHilbertProjection` and
`AlgebraicGeometry.Stack.isom_isSheaf_finiteHilbertProjection`.

## References

* [Stacks Project, Tag 05WB](https://stacks.math.columbia.edu/tag/05WB)
* [Stacks Project, Tag 05WA](https://stacks.math.columbia.edu/tag/05WA)
* [Stacks Project, Tag 02ZI](https://stacks.math.columbia.edu/tag/02ZI)
* [Stacks Project, Tag 0245](https://stacks.math.columbia.edu/tag/0245)
* [Stacks Project, Tag 02VO](https://stacks.math.columbia.edu/tag/02VO)
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Functor

namespace AlgebraicGeometry.Stack

universe u w

namespace FiniteHilbert

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {d : ℕ}
  {𝒳 𝒴 : StackInGroupoids.{w} (BigFppfOver B S hS) (BigFppfOver.topology B S hS)}
  {F : 𝒳.toBasedCategory ⥤ᵇ 𝒴.toBasedCategory}

-- The base object of a quintuple agrees with its image under the projection by unfolding.
attribute [local implicit_reducible] Functor.Fiber Functor.Fiber.fiberInclusion Functor.Fiber.mk
  finiteHilbertProjection

/-! ### The two component 1-morphisms -/

/-- The 1-morphism of categories over the big fppf site from the relative finite Hilbert category
to `𝒴`, remembering only the object of `𝒴` of a quintuple and the `𝒴` component of a
morphism. -/
def targetFunctor :
    (finiteHilbertCategory (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) ⥤ᵇ 𝒴.toBasedCategory where
  toFunctor :=
    { obj := Object.y
      map := fun φ => φ.b
      map_id := fun _ => rfl
      map_comp := fun _ _ => rfl }
  w := by
    refine CategoryTheory.Functor.ext (fun P : Object B S hS 𝒳 𝒴 F d => P.y_over) ?_
    intro P Q φ
    have := φ.b_over
    exact CategoryTheory.IsHomLift.fac' 𝒴.toBasedCategory.p φ.f φ.b

/-- The cover component of an isomorphism of the relative finite Hilbert category is an
isomorphism. -/
theorem isIso_g {P Q : Object B S hS 𝒳 𝒴 F d} (φ : P ⟶ Q) [IsIso φ] : IsIso φ.g :=
  Functor.map_isIso (sourceFunctor (B := B) (S := S) (hS := hS)
    (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) φ

/-! ### Restrictions and their cover components -/

/-- The base component of a chosen restriction in the relative finite Hilbert category is the
factorization it is taken along, read through the identifications of the base objects. -/
private theorem restriction_hom_f {U V : BigFppfOver B S hS} {f : V ⟶ U}
    {P : Object B S hS 𝒳 𝒴 F d} {hP : P.U = U}
    (r : Restriction (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) f P hP) :
    r.hom.f = eqToHom r.hpt ≫ f ≫ eqToHom hP.symm := by
  have := r.isHomLift_hom
  exact CategoryTheory.IsHomLift.fac' (finiteHilbertProjection (B := B) (S := S) (hS := hS)
    (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) f r.hom

/-- **A chosen restriction of an object of the relative finite Hilbert category presents its cover
as a base change.** -/
theorem restriction_isPullback {U V : BigFppfOver B S hS} {f : V ⟶ U}
    {P : Object B S hS 𝒳 𝒴 F d} {hP : P.U = U}
    (r : Restriction (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) f P hP) :
    IsPullback r.hom.g (r.pt.q ≫ eqToHom r.hpt) (P.q ≫ eqToHom hP) f := by
  have hf := restriction_hom_f r
  refine r.hom.square.of_iso (Iso.refl _) (Iso.refl _) (eqToIso r.hpt) (eqToIso hP)
    (by simp) (by simp) (by simp) ?_
  simp only [eqToIso.hom, hf, Category.assoc, eqToHom_trans, eqToHom_refl, Category.comp_id]

/-- The base component of the canonical comparison of two restrictions of an object of the
relative finite Hilbert category is `g`, read through the identifications of the base objects. -/
theorem restriction_compTo_f {U V W : BigFppfOver B S hS} (g : W ⟶ V) (f : V ⟶ U)
    {m : W ⟶ U} (hm : m = g ≫ f) {P : Object B S hS 𝒳 𝒴 F d} {hP : P.U = U}
    (r : Restriction (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) f P hP)
    (s : Restriction (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) m P hP) :
    (Restriction.compTo (finiteHilbertProjection (B := B) (S := S) (hS := hS)
        (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) g f hm r s).f =
      eqToHom s.hpt ≫ g ≫ eqToHom r.hpt.symm := by
  exact Restriction.compTo_map (finiteHilbertProjection (B := B) (S := S) (hS := hS)
    (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) g f hm r s

/-- The cover component of a fibre morphism of the relative finite Hilbert category commutes with
the two covers, read over the common base object. -/
theorem fibreHom_g_comp_q {U : BigFppfOver B S hS} {P Q : Object B S hS 𝒳 𝒴 F d}
    (hP : P.U = U) (hQ : Q.U = U) (φ : P ⟶ Q)
    (hφ : FibreHom (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) P Q hP hQ φ) :
    φ.g ≫ (Q.q ≫ eqToHom hQ) = P.q ≫ eqToHom hP := by
  rw [← Category.assoc, φ.square.w, Hom.f_eq_of_fibreHom hP hQ φ hφ]
  simp

/-- **A fibre isomorphism of the relative finite Hilbert category identifies the two covers over
the common base object.** -/
def fibreIsoSource {U : BigFppfOver B S hS} {P Q : Object B S hS 𝒳 𝒴 F d}
    (hP : P.U = U) (hQ : Q.U = U) (φ : P ⟶ Q)
    (hφ : FibreHom (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) P Q hP hQ φ) (hi : IsIso φ) :
    Over.mk (P.q ≫ eqToHom hP) ≅ Over.mk (Q.q ≫ eqToHom hQ) := by
  have : IsIso φ.g := isIso_g φ
  exact Over.isoMk (asIso φ.g) (fibreHom_g_comp_q hP hQ φ hφ)

/-! ### Cartesianness of a square of the site checked on a covering family -/

/-- The pullbacks of a covering family along any morphism form a covering family. -/
private theorem ofArrows_pullback_fst_mem [HasPullbacks (BigFppfOver B S hS)]
    {ι : Type*} {Vi : ι → BigFppfOver B S hS} {U T : BigFppfOver B S hS} (v : ∀ i, Vi i ⟶ U)
    (hv : Sieve.ofArrows Vi v ∈ BigFppfOver.topology B S hS U) (e : T ⟶ U) :
    Sieve.ofArrows (fun i => pullback e (v i)) (fun i => pullback.fst e (v i)) ∈
      BigFppfOver.topology B S hS T :=
  ofArrows_mem_of_isPullback _ v hv e _ (fun i => pullback.snd e (v i))
    fun _ => IsPullback.of_hasPullback _ _

/-- **A commuting square of the big fppf site which becomes cartesian after base change along a
covering family is cartesian.** -/
theorem isPullback_of_site_cover {X Z V U : BigFppfOver B S hS}
    (a : X ⟶ Z) (b : X ⟶ V) (q : Z ⟶ U) (f : V ⟶ U) (h : a ≫ q = b ≫ f)
    {ι : Type*} {Vi Xi : ι → BigFppfOver B S hS} (v : ∀ i, Vi i ⟶ V)
    (hv : Sieve.ofArrows Vi v ∈ BigFppfOver.topology B S hS V)
    (x : ∀ i, Xi i ⟶ X) (p : ∀ i, Xi i ⟶ Vi i)
    (sq : ∀ i, IsPullback (x i) (p i) b (v i))
    (sq' : ∀ i, IsPullback (x i ≫ a) (p i) q (v i ≫ f)) :
    IsPullback a b q f := by
  classical
  have := hasPullbacks_bigFppfOver B S hS
  have huniq : ∀ {T' : BigFppfOver B S hS} {m n : T' ⟶ X},
      m ≫ a = n ≫ a → m ≫ b = n ≫ b → m = n := by
    intro T' m n hma hmb
    refine site_hom_ext (fun i => pullback.fst (m ≫ b) (v i))
      (ofArrows_pullback_fst_mem v hv _) fun i => ?_
    let m' := (sq i).lift (pullback.fst (m ≫ b) (v i) ≫ m) (pullback.snd (m ≫ b) (v i)) (by
      simpa only [Category.assoc] using pullback.condition (f := m ≫ b) (g := v i))
    let n' := (sq i).lift (pullback.fst (m ≫ b) (v i) ≫ n) (pullback.snd (m ≫ b) (v i)) (by
      rw [Category.assoc, ← hmb]
      exact pullback.condition)
    have hm' : m' ≫ x i = pullback.fst (m ≫ b) (v i) ≫ m := (sq i).lift_fst _ _ _
    have hn' : n' ≫ x i = pullback.fst (m ≫ b) (v i) ≫ n := (sq i).lift_fst _ _ _
    have heq : m' = n' := (sq' i).hom_ext
      (by simpa only [← Category.assoc, hm', hn'] using
        congrArg (fun z => pullback.fst (m ≫ b) (v i) ≫ z) hma)
      (((sq i).lift_snd _ _ _).trans ((sq i).lift_snd _ _ _).symm)
    exact ((sq i).lift_fst _ _ _).symm.trans
      ((congrArg (fun z => z ≫ x i) heq).trans ((sq i).lift_fst _ _ _))
  have hex : ∀ {T : BigFppfOver B S hS} (c : T ⟶ Z) (e : T ⟶ V), c ≫ q = e ≫ f →
      ∃! l : T ⟶ X, l ≫ a = c ∧ l ≫ b = e := by
    intro T c e hc
    have ht := ofArrows_pullback_fst_mem v hv e
    let l i := (sq' i).lift (pullback.fst e (v i) ≫ c) (pullback.snd e (v i)) (by
      rw [Category.assoc, hc, ← Category.assoc, pullback.condition, Category.assoc])
    have hl₁ (i : ι) : l i ≫ (x i ≫ a) = pullback.fst e (v i) ≫ c := (sq' i).lift_fst _ _ _
    have hl₂ (i : ι) : l i ≫ p i = pullback.snd e (v i) := (sq' i).lift_snd _ _ _
    have hlb (i : ι) : (l i ≫ x i) ≫ b = pullback.fst e (v i) ≫ e := by
      rw [Category.assoc, (sq i).w, ← Category.assoc, hl₂]
      exact pullback.condition.symm
    obtain ⟨m, hm, -⟩ := existsUnique_site_hom (fun i => pullback.fst e (v i)) ht X
      (fun i => l i ≫ x i) (by
        intro T' i j c' e' hh
        refine huniq ?_ ?_
        · simpa only [Category.assoc, hl₁] using congrArg (fun z => z ≫ c) hh
        · calc (c' ≫ (l i ≫ x i)) ≫ b = c' ≫ pullback.fst e (v i) ≫ e := by
                rw [Category.assoc, hlb]
            _ = e' ≫ pullback.fst e (v j) ≫ e := by rw [← Category.assoc, hh, Category.assoc]
            _ = (e' ≫ (l j ≫ x j)) ≫ b := by rw [Category.assoc, hlb])
    have hma : m ≫ a = c := by
      refine site_hom_ext (fun i => pullback.fst e (v i)) ht fun i => ?_
      rw [← Category.assoc, hm, Category.assoc, hl₁]
    have hmb : m ≫ b = e := by
      refine site_hom_ext (fun i => pullback.fst e (v i)) ht fun i => ?_
      rw [← Category.assoc, hm, hlb]
    exact ⟨m, ⟨hma, hmb⟩, fun n hn => huniq (hn.1.trans hma.symm) (hn.2.trans hmb.symm)⟩
  exact IsPullback.of_isLimit (PullbackCone.IsLimit.mk h
    (fun s => (hex s.fst s.snd s.condition).choose)
    (fun s => (hex s.fst s.snd s.condition).choose_spec.1.1)
    (fun s => (hex s.fst s.snd s.condition).choose_spec.1.2)
    (fun s m h₁ h₂ => (hex s.fst s.snd s.condition).choose_spec.2 m ⟨h₁, h₂⟩))

/-! ### Extending a cocone on a covering family to a cocone on the sieve -/

/-- **A cocone on a covering subfamily extends to a cocone on the whole sieve.** For a diagram
over a covering sieve with cartesian, strictly composable transition squares, a family of
morphisms out of the components at the members of a covering family contained in the sieve, each
exhibiting its component as a base change of a fixed object `Z` and agreeing on all overlaps,
extends to a compatible family of such morphisms over *every* arrow of the sieve. -/
theorem CartesianSieveDiagram.exists_cocone {U : BigFppfOver B S hS} {R : Sieve U}
    (D : CartesianSieveDiagram R) {ι : Type*} {V : ι → BigFppfOver B S hS} (f : ∀ i, V i ⟶ U)
    (hf : Sieve.ofArrows V f ∈ BigFppfOver.topology B S hS U)
    (hR : ∀ i, R (f i)) {Z : BigFppfOver B S hS} (q : Z ⟶ U)
    (g : ∀ i, D.obj (f i) (hR i) ⟶ Z)
    (sq : ∀ i, IsPullback (g i) (D.q (f i) (hR i)) q (f i))
    (hg : ∀ {W : BigFppfOver B S hS} (i j : ι) (a : W ⟶ V i) (b : W ⟶ V j)
      (h : a ≫ f i = b ≫ f j),
      D.map (hR i) (R.downward_closed (hR i) a) a rfl ≫ g i =
        D.map (hR j) (R.downward_closed (hR i) a) b h.symm ≫ g j) :
    ∃ ζ : ∀ {V : BigFppfOver B S hS} (f : V ⟶ U) (hf : R f), D.obj f hf ⟶ Z,
      (∀ {V : BigFppfOver B S hS} (f : V ⟶ U) (hf : R f), IsPullback (ζ f hf) (D.q f hf) q f) ∧
      ∀ {V W : BigFppfOver B S hS} {f : V ⟶ U} (hf : R f) {g : W ⟶ U} (hg : R g)
        (a : W ⟶ V) (ha : a ≫ f = g), D.map hf hg a ha ≫ ζ f hf = ζ g hg := by
  classical
  have := hasPullbacks_bigFppfOver B S hS
  have htrans {T : BigFppfOver B S hS} (i j : ι) (x : T ⟶ D.obj (f i) (hR i))
      (a : T ⟶ V j) (h : x ≫ D.q (f i) (hR i) ≫ f i = a ≫ f j) :
      D.transport (hR i) (hR j) x a h ≫ g j = x ≫ g i := by
    dsimp only [CartesianSieveDiagram.transport]
    rw [Category.assoc, ← hg i j (x ≫ D.q (f i) (hR i)) a
      (by simpa only [Category.assoc] using h), ← Category.assoc, IsPullback.lift_fst]
  have hex : ∀ {W : BigFppfOver B S hS} (b : W ⟶ U) (hb : R b),
      ∃ z : D.obj b hb ⟶ Z, ∀ {T : BigFppfOver B S hS} (x : T ⟶ D.obj b hb)
        (i : ι) (a : T ⟶ V i) (h : x ≫ D.q b hb ≫ b = a ≫ f i),
        x ≫ z = D.transport hb (hR i) x a h ≫ g i := by
    intro W b hb
    have hr (i : ι) : pullback.fst (D.q b hb ≫ b) (f i) ≫ D.q b hb ≫ b =
        pullback.snd (D.q b hb ≫ b) (f i) ≫ f i := pullback.condition
    have ht := ofArrows_pullback_fst_mem f hf (D.q b hb ≫ b)
    obtain ⟨z, hz, -⟩ := existsUnique_site_hom
      (fun i => pullback.fst (D.q b hb ≫ b) (f i)) ht Z
      (fun i => D.transport hb (hR i) (pullback.fst (D.q b hb ≫ b) (f i))
        (pullback.snd (D.q b hb ≫ b) (f i)) (hr i) ≫ g i) (by
        intro T i j c e hce
        have h₁ : (c ≫ pullback.fst (D.q b hb ≫ b) (f i)) ≫ D.q b hb ≫ b =
            (c ≫ pullback.snd (D.q b hb ≫ b) (f i)) ≫ f i := by
          simpa only [Category.assoc] using congrArg (fun z => c ≫ z) (hr i)
        have h₂ : (c ≫ pullback.snd (D.q b hb ≫ b) (f i)) ≫ f i =
            (e ≫ pullback.snd (D.q b hb ≫ b) (f j)) ≫ f j := by
          rw [← h₁, hce]
          simpa only [Category.assoc] using congrArg (fun z => e ≫ z) (hr j)
        have heq := htrans i j
          (D.transport hb (hR i) (c ≫ pullback.fst (D.q b hb ≫ b) (f i))
            (c ≫ pullback.snd (D.q b hb ≫ b) (f i)) h₁)
          (e ≫ pullback.snd (D.q b hb ≫ b) (f j))
          (by rw [← Category.assoc, D.transport_q]; exact h₂)
        rw [D.transport_comp hb (hR i) (hR j) (c ≫ pullback.fst (D.q b hb ≫ b) (f i))
          (c ≫ pullback.snd (D.q b hb ≫ b) (f i))
          (e ≫ pullback.snd (D.q b hb ≫ b) (f j)) h₁ h₂] at heq
        simp only [hce] at heq
        have hleft := D.transport_precomp hb (hR i) (pullback.fst (D.q b hb ≫ b) (f i))
          (pullback.snd (D.q b hb ≫ b) (f i)) (hr i) c
        have hright := D.transport_precomp hb (hR j) (pullback.fst (D.q b hb ≫ b) (f j))
          (pullback.snd (D.q b hb ≫ b) (f j)) (hr j) e
        have hh := heq.symm
        simp only [← hce] at hh hright
        rw [hleft, hright] at hh
        simpa only [Category.assoc] using hh)
    refine ⟨z, fun {T} x i a h => ?_⟩
    calc x ≫ z = pullback.lift x a h ≫ pullback.fst (D.q b hb ≫ b) (f i) ≫ z := by
          rw [← Category.assoc, pullback.lift_fst]
      _ = pullback.lift x a h ≫ (D.transport hb (hR i)
            (pullback.fst (D.q b hb ≫ b) (f i)) (pullback.snd (D.q b hb ≫ b) (f i)) (hr i) ≫
              g i) := by rw [hz]
      _ = _ := by
          rw [← Category.assoc, ← D.transport_precomp]
          simp only [pullback.lift_fst, pullback.lift_snd]
  let ζ {W : BigFppfOver B S hS} (b : W ⟶ U) (hb : R b) := (hex b hb).choose
  have hζ {W : BigFppfOver B S hS} (b : W ⟶ U) (hb : R b) {T : BigFppfOver B S hS}
      (x : T ⟶ D.obj b hb) (i : ι) (a : T ⟶ V i)
      (h : x ≫ D.q b hb ≫ b = a ≫ f i) :
      x ≫ ζ b hb = D.transport hb (hR i) x a h ≫ g i := (hex b hb).choose_spec x i a h
  have hζq {W : BigFppfOver B S hS} (b : W ⟶ U) (hb : R b) : ζ b hb ≫ q = D.q b hb ≫ b := by
    have ht := ofArrows_pullback_fst_mem f hf (D.q b hb ≫ b)
    refine site_hom_ext (fun i => pullback.fst (D.q b hb ≫ b) (f i)) ht fun i => ?_
    rw [← Category.assoc, hζ b hb (pullback.fst (D.q b hb ≫ b) (f i)) i
        (pullback.snd (D.q b hb ≫ b) (f i)) pullback.condition,
      Category.assoc, (sq i).w, ← Category.assoc, D.transport_q]
    exact pullback.condition.symm
  have hnat {V' W : BigFppfOver B S hS} {b : V' ⟶ U} (hb : R b) {c : W ⟶ U} (hc : R c)
      (a : W ⟶ V') (ha : a ≫ b = c) : D.map hb hc a ha ≫ ζ b hb = ζ c hc := by
    have ht := ofArrows_pullback_fst_mem f hf (D.q c hc ≫ c)
    refine site_hom_ext (fun i => pullback.fst (D.q c hc ≫ c) (f i)) ht fun i => ?_
    rw [← Category.assoc,
      hζ b hb (pullback.fst (D.q c hc ≫ c) (f i) ≫ D.map hb hc a ha) i
        (pullback.snd (D.q c hc ≫ c) (f i))
        (by
          simp only [Category.assoc, reassoc_of% (D.square hb hc a ha).w, ha]
          exact pullback.condition),
      hζ c hc (pullback.fst (D.q c hc ≫ c) (f i)) i (pullback.snd (D.q c hc ≫ c) (f i))
        pullback.condition,
      D.transport_map_comp]
  refine ⟨ζ, ?_, fun {V W b} hb {c} hc a ha => hnat hb hc a ha⟩
  intro W b hb
  have hζi (i : ι) : ζ (f i) (hR i) = g i := by
    have hh := hζ (f i) (hR i) (𝟙 _) i ((𝟙 _) ≫ D.q (f i) (hR i)) (by simp)
    rw [D.transport_self] at hh
    simpa only [Category.id_comp] using hh
  refine isPullback_of_site_cover _ _ _ _ (hζq b hb) (fun i => pullback.fst b (f i))
    (ofArrows_pullback_fst_mem f hf b)
    (fun i => D.map hb (R.downward_closed hb (pullback.fst b (f i))) (pullback.fst b (f i)) rfl)
    (fun i => D.q (pullback.fst b (f i) ≫ b) (R.downward_closed hb (pullback.fst b (f i))))
    (fun i => D.square hb (R.downward_closed hb (pullback.fst b (f i)))
      (pullback.fst b (f i)) rfl) fun i => ?_
  have he : D.map hb (R.downward_closed hb (pullback.fst b (f i))) (pullback.fst b (f i)) rfl ≫
      ζ b hb =
      D.map (hR i) (R.downward_closed hb (pullback.fst b (f i))) (pullback.snd b (f i))
        pullback.condition.symm ≫ g i := by
    rw [hnat hb (R.downward_closed hb (pullback.fst b (f i))), ← hζi,
      hnat (hR i) (R.downward_closed hb (pullback.fst b (f i)))]
  rw [he]
  simpa only [show pullback.snd b (f i) ≫ f i = pullback.fst b (f i) ≫ b from
    pullback.condition.symm] using
    (D.square (hR i) (R.downward_closed hb (pullback.fst b (f i))) (pullback.snd b (f i))
      pullback.condition.symm).paste_horiz (sq i)

/-! ### The diagram of covers of a descent datum relative to a sieve -/

section SourceDiagram

variable {U : BigFppfOver B S hS} {R : Sieve U}

local instance : (finiteHilbertProjection (B := B) (S := S) (hS := hS)
    (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)).IsFibered :=
  (isFiberedInGroupoids_finiteHilbertProjection (B := B) (S := S) (hS := hS)
    (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)).isFibered

variable (D : SieveDescentDatum (finiteHilbertProjection (B := B) (S := S) (hS := hS)
  (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) R)

/-- The base component of a transition morphism of a descent datum relative to a sieve is the
factorization it is taken along. -/
theorem sieveDatumMap_f {V W : BigFppfOver B S hS} {f : V ⟶ U} (hf : R f) {g : W ⟶ U} (hg : R g)
    (a : W ⟶ V) (ha : a ≫ f = g) :
    (sieveDatumMap D hf hg a ha).f =
      eqToHom (D.obj g hg).2 ≫ a ≫ eqToHom (D.obj f hf).2.symm := by
  have := (sieveDatumMap_cartesian D hf hg a ha).toIsHomLift
  exact CategoryTheory.IsHomLift.fac' (finiteHilbertProjection (B := B) (S := S) (hS := hS)
    (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) a (sieveDatumMap D hf hg a ha)

/-- **The covers of a descent datum relative to a sieve form a diagram with cartesian, strictly
composable transition squares.** -/
def sourceDiagram : CartesianSieveDiagram R where
  obj f hf := (D.obj f hf).1.Z
  q f hf := (D.obj f hf).1.q ≫ eqToHom (D.obj f hf).2
  map {V W f} hf {g} hg a ha := (sieveDatumMap D hf hg a ha).g
  square {V W f} hf {g} hg a ha := by
    have hh := (sieveDatumMap D hf hg a ha).square
    rw [sieveDatumMap_f] at hh
    exact hh.of_iso (Iso.refl _) (Iso.refl _) (eqToIso (D.obj _ _).2) (eqToIso (D.obj _ _).2)
      (by simp) (by simp) (by simp) (by simp)
  map_comp {V W Z f} hf {g} hg {b} hb a a' ha ha' :=
    congrArg Hom.g (sieveDatumMap_comp D hf hg hb a a' ha ha')

/-- **The covers of a descent datum relative to a sieve descend over a covering family of the
sieve whose underlying family of schemes is an fpqc covering family**, to a finite locally free
cover of degree `d` of the base. -/
theorem sieve_exists_fpqc_cocone {ι : Type*} {V : ι → BigFppfOver B S hS} (f : ∀ i, V i ⟶ U)
    (hR : ∀ i, R (f i))
    (hf : Presieve.ofArrows (fun i => (BigFppfOver.toScheme B S hS).obj (V i))
      (fun i => (BigFppfOver.toScheme B S hS).map (f i)) ∈
      Scheme.fpqcPrecoverage ((BigFppfOver.toScheme B S hS).obj U)) :
    ∃ (Z : BigFppfOver B S hS) (q : Z ⟶ U)
      (g : ∀ i, (sourceDiagram D).obj (f i) (hR i) ⟶ Z),
      Stacks.Morphisms.IsFiniteLocallyFreeOfRank
        ((BigFppfOver.toScheme B S hS).map q) d ∧
      (∀ i, IsPullback (g i) ((sourceDiagram D).q (f i) (hR i)) q (f i)) ∧
      ∀ {W : BigFppfOver B S hS} (i j : ι) (a : W ⟶ V i) (b : W ⟶ V j)
        (h : a ≫ f i = b ≫ f j),
        (sourceDiagram D).map (hR i) (R.downward_closed (hR i) a) a rfl ≫ g i =
          (sourceDiagram D).map (hR j) (R.downward_closed (hR i) a) b h.symm ≫ g j := by
  classical
  have := hasPullbacks_bigFppfOver B S hS
  let H := BigFppfOver.toScheme B S hS
  let p (i j : ι) := pullback.fst (f i) (f j)
  let r (i j : ι) := pullback.snd (f i) (f j)
  let f₂ (i j : ι) := p i j ≫ f i
  let h₂ (i j : ι) := R.downward_closed (hR i) (p i j)
  let P (i : ι) := (D.obj (f i) (hR i)).1
  let Q (i j : ι) := (D.obj (f₂ i j) (h₂ i j)).1
  let c (i j : ι) := sieveDatumMap D (hR i) (h₂ i j) (p i j) rfl
  let e (i j : ι) := sieveDatumMap D (hR j) (h₂ i j) (r i j) pullback.condition.symm
  let f' (i : ι) := eqToHom (D.obj (f i) (hR i)).2 ≫ f i
  have hfpqc : Presieve.ofArrows (fun i => H.obj (P i).U) (fun i => H.map (f' i)) ∈
      Scheme.fpqcPrecoverage (H.obj U) := by
    have he {X Y : ι → BigFppfOver B S hS} (h : ∀ i, X i = Y i) (a : ∀ i, Y i ⟶ U) :
        Presieve.ofArrows (fun i => H.obj (X i)) (fun i => H.map (eqToHom (h i) ≫ a i)) =
          Presieve.ofArrows (fun i => H.obj (Y i)) (fun i => H.map (a i)) := by
      cases funext h
      simp
    exact (he (fun i => (D.obj (f i) (hR i)).2) f).symm ▸ hf
  have sq₂ (i j : ι) : IsPullback (c i j).f (e i j).f (f' i) (f' j) := by
    dsimp only [c, e]
    rw [sieveDatumMap_f, sieveDatumMap_f]
    exact (IsPullback.of_hasPullback (f i) (f j)).of_iso
      (eqToIso (D.obj (f₂ i j) (h₂ i j)).2.symm)
      (eqToIso (D.obj (f i) (hR i)).2.symm)
      (eqToIso (D.obj (f j) (hR j)).2.symm) (Iso.refl _)
      (by simp [p]) (by simp [r]) (by simp [f']) (by simp [f'])
  let t (i j k : ι) := pullback.fst (f₂ i j) (f k)
  let s (i j k : ι) := pullback.snd (f₂ i j) (f k)
  let f₃ (i j k : ι) := t i j k ≫ f₂ i j
  let h₃ (i j k : ι) := R.downward_closed (h₂ i j) (t i j k)
  let T (i j k : ι) := (D.obj (f₃ i j k) (h₃ i j k)).1
  let s₂₃ (i j k : ι) : pullback (f₂ i j) (f k) ⟶ pullback (f j) (f k) :=
    pullback.lift (t i j k ≫ r i j) (s i j k) (by
      rw [Category.assoc, ← pullback.condition]
      exact pullback.condition)
  let s₁₃ (i j k : ι) : pullback (f₂ i j) (f k) ⟶ pullback (f i) (f k) :=
    pullback.lift (t i j k ≫ p i j) (s i j k) (by
      rw [Category.assoc]
      exact pullback.condition)
  have hs₂₃ (i j k : ι) : s₂₃ i j k ≫ f₂ j k = f₃ i j k := by
    dsimp only [s₂₃, f₂, f₃, p, r]
    rw [← Category.assoc, pullback.lift_fst, Category.assoc, ← pullback.condition]
  have hs₁₃ (i j k : ι) : s₁₃ i j k ≫ f₂ i k = f₃ i j k := by
    dsimp only [s₁₃, f₂, f₃, p]
    rw [← Category.assoc, pullback.lift_fst, Category.assoc]
  let b₁₂ (i j k : ι) := sieveDatumMap D (h₂ i j) (h₃ i j k) (t i j k) rfl
  let b₂₃ (i j k : ι) := sieveDatumMap D (h₂ j k) (h₃ i j k) (s₂₃ i j k) (hs₂₃ i j k)
  let b₁₃ (i j k : ι) := sieveDatumMap D (h₂ i k) (h₃ i j k) (s₁₃ i j k) (hs₁₃ i j k)
  have hc₁ (i j k : ι) : b₁₂ i j k ≫ c i j = b₁₃ i j k ≫ c i k := by
    dsimp only [b₁₂, b₁₃, c]
    rw [sieveDatumMap_comp, sieveDatumMap_comp]
    simp only [s₁₃, p, pullback.lift_fst]
  have hc₂ (i j k : ι) : b₁₂ i j k ≫ e i j = b₂₃ i j k ≫ c j k := by
    dsimp only [b₁₂, b₂₃, c, e]
    rw [sieveDatumMap_comp, sieveDatumMap_comp]
    simp only [s₂₃, p, pullback.lift_fst]
  have hc₃ (i j k : ι) : b₂₃ i j k ≫ e j k = b₁₃ i j k ≫ e i k := by
    dsimp only [b₂₃, b₁₃, e]
    rw [sieveDatumMap_comp, sieveDatumMap_comp]
    simp only [s₂₃, s₁₃, r, pullback.lift_snd]
  have sq₃ (i j k : ι) : IsPullback (b₁₂ i j k).f (b₂₃ i j k ≫ e j k).f
      ((c i j).f ≫ f' i) (f' k) := by
    dsimp only [b₁₂, b₂₃, e, c]
    rw [sieveDatumMap_comp]
    simp only [s₂₃, r, pullback.lift_snd]
    rw [sieveDatumMap_f, sieveDatumMap_f, sieveDatumMap_f]
    exact (IsPullback.of_hasPullback (f₂ i j) (f k)).of_iso
      (eqToIso (D.obj (f₃ i j k) (h₃ i j k)).2.symm)
      (eqToIso (D.obj (f₂ i j) (h₂ i j)).2.symm)
      (eqToIso (D.obj (f k) (hR k)).2.symm) (Iso.refl _)
      (by simp [t]) (by simp [s]) (by simp [f', f₂]) (by simp [f'])
  obtain ⟨Z, q, g, hsq, hg⟩ := exists_fpqc_cocone_of_diagram P f' hfpqc Q c e sq₂ T
    b₁₂ b₂₃ b₁₃ hc₁ hc₂ hc₃ sq₃
  have hsq' (i : ι) : IsPullback (g i) (H.map ((sourceDiagram D).q (f i) (hR i)))
      q (H.map (f i)) :=
    (hsq i).of_iso (Iso.refl _) (Iso.refl _) (H.mapIso (eqToIso (D.obj (f i) (hR i)).2))
      (Iso.refl _) (by simp) (by simp [sourceDiagram, H, P]) (by simp) (by simp [H, f'])
  have hrank (i : ι) : Stacks.Morphisms.IsFiniteLocallyFreeOfRank
      (H.map ((sourceDiagram D).q (f i) (hR i))) d := by
    have htransport {A T' T'' : BigFppfOver B S hS} (a : A ⟶ T') (h : T' = T'')
        (ha : Stacks.Morphisms.IsFiniteLocallyFreeOfRank (H.map a) d) :
        Stacks.Morphisms.IsFiniteLocallyFreeOfRank (H.map (a ≫ eqToHom h)) d := by
      cases h
      simpa using ha
    exact htransport _ _ (P i).finiteLocallyFree
  have hq := isFiniteLocallyFreeOfRank_of_fpqcCover _ _ hf q d fun i => by
    have hs : IsPullback (hsq' i).isoPullback.inv (pullback.snd q (H.map (f i)))
        (H.map ((sourceDiagram D).q (f i) (hR i))) (𝟙 (H.obj (V i))) := by
      refine IsPullback.of_horiz_isIso ⟨?_⟩
      rw [Category.comp_id, Iso.inv_comp_eq]
      exact (hsq' i).isoPullback_hom_snd.symm
    exact @Stacks.Morphisms.IsFiniteLocallyFreeOfRank.of_isPullback _ _ _ _ _ _ _ _ _ hs (hrank i)
  obtain ⟨Z', q', g', hq', hs', hg'⟩ := exists_site_cocone_of_scheme_cocone f
    (fun i => (sourceDiagram D).q (f i) (hR i)) q d hq g hsq'
  refine ⟨Z', q', g', hq', hs', ?_⟩
  intro W i j a b hab
  have hl : pullback.lift a b hab ≫ f₂ i j = a ≫ f i := by
    dsimp only [f₂, p]
    rw [← Category.assoc, pullback.lift_fst]
  have hm₁ : sieveDatumMap D (h₂ i j) (R.downward_closed (hR i) a) (pullback.lift a b hab) hl ≫
      c i j = sieveDatumMap D (hR i) (R.downward_closed (hR i) a) a rfl := by
    dsimp only [c]
    rw [sieveDatumMap_comp]
    simp only [p, pullback.lift_fst]
  have hm₂ : sieveDatumMap D (h₂ i j) (R.downward_closed (hR i) a) (pullback.lift a b hab) hl ≫
      e i j = sieveDatumMap D (hR j) (R.downward_closed (hR i) a) b hab.symm := by
    dsimp only [e]
    rw [sieveDatumMap_comp]
    simp only [r, pullback.lift_snd]
  refine hg' i j _ _ ?_
  have hm₁g : (sieveDatumMap D (h₂ i j) (R.downward_closed (hR i) a)
      (pullback.lift a b hab) hl).g ≫ (c i j).g =
      (sieveDatumMap D (hR i) (R.downward_closed (hR i) a) a rfl).g := congrArg Hom.g hm₁
  have hm₂g : (sieveDatumMap D (h₂ i j) (R.downward_closed (hR i) a)
      (pullback.lift a b hab) hl).g ≫ (e i j).g =
      (sieveDatumMap D (hR j) (R.downward_closed (hR i) a) b hab.symm).g := congrArg Hom.g hm₂
  have hh := congrArg (fun z => H.map (sieveDatumMap D (h₂ i j) (R.downward_closed (hR i) a)
    (pullback.lift a b hab) hl).g ≫ z) (hg i j)
  change H.map (sieveDatumMap D (h₂ i j) (R.downward_closed (hR i) a)
      (pullback.lift a b hab) hl).g ≫ H.map (c i j).g ≫ g i =
    H.map (sieveDatumMap D (h₂ i j) (R.downward_closed (hR i) a)
      (pullback.lift a b hab) hl).g ≫ H.map (e i j).g ≫ g j at hh
  rwa [← H.map_comp_assoc, ← H.map_comp_assoc, hm₁g, hm₂g] at hh

/-- A family of morphisms out of the covers of a descent datum relative to a sieve, compatible with
its transition morphisms, is compatible with its gluing isomorphisms over every pair of morphisms
`a`, `b` with `a ≫ f = b ≫ g`. -/
theorem sourceSieve_compatible {Z : BigFppfOver B S hS}
    (ζ : ∀ {V : BigFppfOver B S hS} (f : V ⟶ U) (hf : R f), (D.obj f hf).1.Z ⟶ Z)
    (hnat : ∀ {V W : BigFppfOver B S hS} {f : V ⟶ U} (hf : R f) {g : W ⟶ U} (hg : R g)
      (a : W ⟶ V) (ha : a ≫ f = g), (sieveDatumMap D hf hg a ha).g ≫ ζ f hf = ζ g hg)
    {V W T : BigFppfOver B S hS} {f : V ⟶ U} (hf : R f) {g : W ⟶ U} (hg : R g)
    (a : T ⟶ V) (b : T ⟶ W) (h : a ≫ f = b ≫ g) :
    (Fiber.fiberInclusion.map (D.iso hf hg a b h).hom).g ≫
        (IsPreFibered.pullbackMap (D.obj g hg).2 b).g ≫ ζ g hg =
      (IsPreFibered.pullbackMap (D.obj f hf).2 a).g ≫ ζ f hf := by
  let G := sourceFunctor (B := B) (S := S) (hS := hS) (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)
  have hi := sieveDatumMap_glue D hf hg (R.downward_closed hf a) a b rfl h.symm
  have hj := sieveDatumMap_glue D hf hf (R.downward_closed hf a) a a rfl rfl
  rw [D.iso_self, CategoryTheory.Functor.map_id, Category.id_comp] at hj
  have hi' := congrArg (fun z => G.map z ≫ ζ g hg) hi
  have hj' := congrArg (fun z => G.map z ≫ ζ f hf) hj
  simp only [G.map_comp] at hi' hj'
  change _ ≫ (sieveDatumMap D hg (R.downward_closed hf a) b h.symm).g ≫ ζ g hg = _ at hi'
  change _ ≫ (sieveDatumMap D hf (R.downward_closed hf a) a rfl).g ≫ ζ f hf = _ at hj'
  rw [hnat] at hi' hj'
  exact hi'.symm.trans hj'

end SourceDiagram

/-! ### Effectivity of a descent datum of the relative finite Hilbert category -/

section Effectivity

variable {U : BigFppfOver B S hS} {I : Type w} {V : I → BigFppfOver B S hS} {f : ∀ i, V i ⟶ U}
  {Vij : I → I → BigFppfOver B S hS}
  {pr₁ : ∀ i j, Vij i j ⟶ V i} {pr₂ : ∀ i j, Vij i j ⟶ V j}
  {hVij : ∀ i j, IsPullback (pr₁ i j) (pr₂ i j) (f i) (f j)}
  {Vijk : I → I → I → BigFppfOver B S hS}
  {s₁₂ : ∀ i j k, Vijk i j k ⟶ Vij i j} {s₂₃ : ∀ i j k, Vijk i j k ⟶ Vij j k}
  {hVijk : ∀ i j k, IsPullback (s₁₂ i j k) (s₂₃ i j k) (pr₂ i j) (pr₁ j k)}
  {q₁ : ∀ i j k, Vijk i j k ⟶ V i} {q₂ : ∀ i j k, Vijk i j k ⟶ V j}
  {q₃ : ∀ i j k, Vijk i j k ⟶ V k}
  {hq₁ : ∀ i j k, q₁ i j k = s₁₂ i j k ≫ pr₁ i j}
  {hq₂ : ∀ i j k, q₂ i j k = s₁₂ i j k ≫ pr₂ i j}
  {hq₃ : ∀ i j k, q₃ i j k = s₂₃ i j k ≫ pr₂ j k}

/-- **The objects of `𝒴` of a descent datum of the relative finite Hilbert category descend** to
an object of `𝒴` over `U`. -/
theorem descentDatum_exists_target_cocone
    (hf : Sieve.ofArrows V f ∈ BigFppfOver.topology B S hS U)
    (D : CategoryTheory.Functor.DescentDatum (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d))
      V f Vij pr₁ pr₂ hVij Vijk s₁₂ s₂₃ hVijk q₁ q₂ q₃ hq₁ hq₂ hq₃) :
    ∃ (y : 𝒴.toBasedCategory.obj) (_hy : 𝒴.toBasedCategory.p.obj y = U)
      (b : ∀ i, (D.x i).y ⟶ y),
      (∀ i, 𝒴.toBasedCategory.p.IsHomLift (f i) (b i)) ∧
      ∀ i j, (D.xrij i j).hom.b ≫ b i = (D.φ i j).b ≫ (D.xrji i j).hom.b ≫ b j :=
  exists_cocone_of_isStackInGroupoids targetFunctor 𝒴.isStackInGroupoids hf D

/-- **The covers of a descent datum, once descended, make the overlaps genuine fibre products.**
Given a cocone on the covers over a descended cover `q : Z ⟶ U`, the cover of the overlap `(i, j)`
is the fibre product of the covers of `i` and of `j` over `Z`. -/
theorem descentDatum_source_overlap
    (D : CategoryTheory.Functor.DescentDatum (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d))
      V f Vij pr₁ pr₂ hVij Vijk s₁₂ s₂₃ hVijk q₁ q₂ q₃ hq₁ hq₂ hq₃)
    {Z : BigFppfOver B S hS} (q : Z ⟶ U) (g : ∀ i, (D.x i).Z ⟶ Z)
    (sq : ∀ i, IsPullback (g i) ((D.x i).q ≫ eqToHom (D.hx i)) q (f i))
    (hg : ∀ i j, (D.xrij i j).hom.g ≫ g i =
      (D.φ i j).g ≫ (D.xrji i j).hom.g ≫ g j) (i j : I) :
    IsPullback (D.xrij i j).hom.g ((D.φ i j).g ≫ (D.xrji i j).hom.g) (g i) (g j) := by
  have hφ : (D.φ i j).g ≫ ((D.xrji i j).pt.q ≫ eqToHom (D.xrji i j).hpt) =
      (D.xrij i j).pt.q ≫ eqToHom (D.xrij i j).hpt :=
    Over.w (fibreIsoSource _ _ _ (D.φ_fibreHom i j) (D.φ_iso i j)).hom
  have hr := restriction_isPullback (D.xrij i j)
  have hs := restriction_isPullback (D.xrji i j)
  have houter := (hr.paste_vert (hVij i j)).flip
  have he : ((D.φ i j).g ≫ (D.xrji i j).hom.g) ≫ ((D.x j).q ≫ eqToHom (D.hx j)) =
      ((D.xrij i j).pt.q ≫ eqToHom (D.xrij i j).hpt) ≫ pr₂ i j := by
    rw [Category.assoc, hs.w, ← Category.assoc, hφ]
  rw [← he, ← (sq i).w] at houter
  exact (houter.of_right (by simpa only [Category.assoc] using (hg i j).symm) (sq j).flip).flip

/-- **The objects of `𝒳` of a descent datum of the relative finite Hilbert category descend over
the descended cover.** Given a cocone on the covers of the datum over `q : Z ⟶ U` exhibiting each
cover as a base change of `q`, the objects of `𝒳` of the datum descend to an object of `𝒳` over
`Z`. -/
theorem descentDatum_exists_source_cocone
    (hf : Sieve.ofArrows V f ∈ BigFppfOver.topology B S hS U)
    (D : CategoryTheory.Functor.DescentDatum (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d))
      V f Vij pr₁ pr₂ hVij Vijk s₁₂ s₂₃ hVijk q₁ q₂ q₃ hq₁ hq₂ hq₃)
    {Z : BigFppfOver B S hS} (q : Z ⟶ U) (g : ∀ i, (D.x i).Z ⟶ Z)
    (sq : ∀ i, IsPullback (g i) ((D.x i).q ≫ eqToHom (D.hx i)) q (f i))
    (hg : ∀ i j, (D.xrij i j).hom.g ≫ g i =
      (D.φ i j).g ≫ (D.xrji i j).hom.g ≫ g j) :
    ∃ (x : 𝒳.toBasedCategory.obj) (_hx : 𝒳.toBasedCategory.p.obj x = Z)
      (a : ∀ i, (D.x i).x ⟶ x),
      (∀ i, 𝒳.toBasedCategory.p.IsHomLift (g i) (a i)) ∧
      ∀ i j, (D.xrij i j).hom.a ≫ a i = (D.φ i j).a ≫ (D.xrji i j).hom.a ≫ a j := by
  have : (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)).IsFibered :=
    (isFiberedInGroupoids_finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)).isFibered
  let c (i j : I) := (D.xrij i j).hom
  let e (i j : I) := D.φ i j ≫ (D.xrji i j).hom
  let a₁ (i j k : I) := (D.wi i j k).hom
  let a₂ (i j k : I) := D.αij i j k ≫ (D.wj i j k).hom
  let a₃ (i j k : I) := D.αik i j k ≫ (D.wk i j k).hom
  let b₁₂ (i j k : I) := Restriction.compTo (finiteHilbertProjection (B := B) (S := S) (hS := hS)
    (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) (s₁₂ i j k) (pr₁ i j) (hq₁ i j k)
    (D.xrij i j) (D.wi i j k)
  let b₂₃ (i j k : I) := D.αij i j k ≫
    Restriction.compTo (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) (s₂₃ i j k) (pr₁ j k)
      ((hq₂ i j k).trans (hVijk i j k).w) (D.xrij j k) (D.wj i j k)
  let b₁₃ (i j k : I) := Restriction.compTo (finiteHilbertProjection (B := B) (S := S) (hS := hS)
    (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) (D.s₁₃ i j k) (pr₁ i k) (D.hs₁₃₁ i j k).symm
    (D.xrij i k) (D.wi i j k)
  have h₁₂₁ (i j k : I) : b₁₂ i j k ≫ c i j = a₁ i j k := Restriction.compTo_hom _ _ _ _ _ _
  have h₁₂₂ (i j k : I) : b₁₂ i j k ≫ e i j = a₂ i j k := by
    have h := D.αij_restr i j k
    change D.αij i j k ≫ _ = b₁₂ i j k ≫ D.φ i j at h
    dsimp only [e, a₂]
    rw [← Category.assoc, ← h, Category.assoc, Restriction.compTo_hom]
  have h₂₃₂ (i j k : I) : b₂₃ i j k ≫ c j k = a₂ i j k := by
    dsimp only [b₂₃, c, a₂]
    rw [Category.assoc, Restriction.compTo_hom]
  have h₂₃₃ (i j k : I) : b₂₃ i j k ≫ e j k = a₃ i j k := by
    have h := D.αjk_restr i j k
    dsimp only [b₂₃, e, a₃]
    rw [Category.assoc, ← Category.assoc _ (D.φ j k), ← h, Category.assoc,
      Restriction.compTo_hom, ← Category.assoc, ← D.cocycle]
  have h₁₃₁ (i j k : I) : b₁₃ i j k ≫ c i k = a₁ i j k := Restriction.compTo_hom _ _ _ _ _ _
  have h₁₃₃ (i j k : I) : b₁₃ i j k ≫ e i k = a₃ i j k := by
    have h := D.αik_restr i j k
    change D.αik i j k ≫ _ = b₁₃ i j k ≫ D.φ i k at h
    dsimp only [e, a₃]
    rw [← Category.assoc, ← h, Category.assoc, Restriction.compTo_hom]
  have hc (i j : I) : (c i j).f =
      eqToHom (D.xrij i j).hpt ≫ pr₁ i j ≫ eqToHom (D.hx i).symm := by
    exact restriction_hom_f (D.xrij i j)
  have he (i j : I) : (e i j).f =
      eqToHom (D.xrij i j).hpt ≫ pr₂ i j ≫ eqToHom (D.hx j).symm := by
    have h1 := Hom.f_eq_of_fibreHom _ _ _ (D.φ_fibreHom i j)
    change (D.φ i j).f ≫ (D.xrji i j).hom.f = _
    rw [h1, restriction_hom_f (D.xrji i j)]
    simp
  have hb₁₂ (i j k : I) : (b₁₂ i j k).f =
      eqToHom (D.wi i j k).hpt ≫ s₁₂ i j k ≫ eqToHom (D.xrij i j).hpt.symm :=
    restriction_compTo_f (s₁₂ i j k) (pr₁ i j) (hq₁ i j k) (D.xrij i j) (D.wi i j k)
  have hb₂₃ (i j k : I) : (b₂₃ i j k).f =
      eqToHom (D.wi i j k).hpt ≫ s₂₃ i j k ≫ eqToHom (D.xrij j k).hpt.symm := by
    have hl := (D.isHomLift_id_αij i j k).1
    have h1 : (D.αij i j k).f = _ :=
      CategoryTheory.IsHomLift.fac' (finiteHilbertProjection (B := B) (S := S) (hS := hS)
        (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) (𝟙 (Vijk i j k)) (D.αij i j k)
    change (D.αij i j k).f ≫ _ = _
    rw [h1, restriction_compTo_f]
    simp
  have htriple (i j k : I) : IsPullback (b₁₂ i j k).g (b₂₃ i j k).g (e i j).g (c j k).g := by
    refine Hom.isPullback_g _ _ _ _ ((h₁₂₂ i j k).trans (h₂₃₂ i j k).symm) ?_
    rw [hb₁₂, hb₂₃, he, hc]
    exact (hVijk i j k).of_iso (eqToIso (D.wi i j k).hpt.symm)
      (eqToIso (D.xrij i j).hpt.symm) (eqToIso (D.xrij j k).hpt.symm)
      (eqToIso (D.hx j).symm) (by simp) (by simp) (by simp) (by simp)
  have hgcover := ofArrows_mem_of_isPullback _ f hf q g
    (fun i => (D.x i).q ≫ eqToHom (D.hx i)) sq
  obtain ⟨x, hx, a, ha, hcompat⟩ := exists_cocone_of_cartesian_presentation
    (E := 𝒳.toBasedCategory) (V := fun i => (D.x i).Z) (f := g)
    (Vij := fun i j => (D.xrij i j).pt.Z)
    (pr₁ := fun i j => (c i j).g) (pr₂ := fun i j => (e i j).g)
    (hVij := descentDatum_source_overlap D q g sq hg)
    (Vijk := fun i j k => (D.wi i j k).pt.Z)
    (s₁₂ := fun i j k => (b₁₂ i j k).g) (s₂₃ := fun i j k => (b₂₃ i j k).g)
    (hVijk := htriple)
    (q₁ := fun i j k => (a₁ i j k).g) (q₂ := fun i j k => (a₂ i j k).g)
    (q₃ := fun i j k => (a₃ i j k).g)
    (hq₁ := fun i j k => (congrArg Hom.g (h₁₂₁ i j k)).symm)
    (hq₂ := fun i j k => (congrArg Hom.g (h₁₂₂ i j k)).symm)
    (hq₃ := fun i j k => (congrArg Hom.g (h₂₃₃ i j k)).symm)
    𝒳.isStackInGroupoids hgcover
    (fun i => (D.x i).x) (fun i => (D.x i).x_over)
    (fun i j => (D.xrij i j).pt.x) (fun i j => (D.xrij i j).pt.x_over)
    (fun i j => (c i j).a) (fun i j => (e i j).a)
    (fun i j => (c i j).a_over) (fun i j => (e i j).a_over)
    (fun i j k => (D.wi i j k).pt.x) (fun i j k => (D.wi i j k).pt.x_over)
    (fun i j k => (a₁ i j k).a) (fun i j k => (a₂ i j k).a) (fun i j k => (a₃ i j k).a)
    (fun i j k => (a₁ i j k).a_over) (fun i j k => (a₂ i j k).a_over)
    (fun i j k => (a₃ i j k).a_over)
    (fun i j k => (b₁₃ i j k).g)
    (fun i j k => congrArg Hom.g (h₁₃₁ i j k))
    (fun i j k => congrArg Hom.g (h₁₃₃ i j k))
    (fun i j k => (b₁₂ i j k).a) (fun i j k => (b₂₃ i j k).a) (fun i j k => (b₁₃ i j k).a)
    (fun i j k => (b₁₂ i j k).a_over) (fun i j k => (b₂₃ i j k).a_over)
    (fun i j k => (b₁₃ i j k).a_over)
    (fun i j k => congrArg Hom.a (h₁₂₁ i j k))
    (fun i j k => congrArg Hom.a (h₁₂₂ i j k))
    (fun i j k => congrArg Hom.a (h₂₃₂ i j k))
    (fun i j k => congrArg Hom.a (h₂₃₃ i j k))
    (fun i j k => congrArg Hom.a (h₁₃₁ i j k))
    (fun i j k => congrArg Hom.a (h₁₃₃ i j k))
  refine ⟨x, hx, a, ha, fun i j => ?_⟩
  have h := hcompat i j
  change (D.xrij i j).hom.a ≫ a i = ((D.φ i j).a ≫ (D.xrji i j).hom.a) ≫ a j at h
  simpa only [Category.assoc] using h

/-- A descent datum of the relative finite Hilbert category is effective once its covers have
descended to a finite locally free cover `q : Z ⟶ U` of degree `d` and its objects of `𝒳` have
descended to an object of `𝒳` over `Z`. -/
theorem descentDatum_isEffective_of_source_cocone
    (hf : Sieve.ofArrows V f ∈ BigFppfOver.topology B S hS U)
    (D : CategoryTheory.Functor.DescentDatum (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d))
      V f Vij pr₁ pr₂ hVij Vijk s₁₂ s₂₃ hVijk q₁ q₂ q₃ hq₁ hq₂ hq₃)
    (Z : BigFppfOver B S hS) (q : Z ⟶ U)
    (hq : Stacks.Morphisms.IsFiniteLocallyFreeOfRank
      ((BigFppfOver.toScheme B S hS).map q) d)
    (g : ∀ i, (D.x i).Z ⟶ Z)
    (sq : ∀ i, IsPullback (g i) ((D.x i).q ≫ eqToHom (D.hx i)) q (f i))
    (hg : ∀ i j, (D.xrij i j).hom.g ≫ g i =
      (D.φ i j).g ≫ (D.xrji i j).hom.g ≫ g j)
    (x : 𝒳.toBasedCategory.obj) (hx : 𝒳.toBasedCategory.p.obj x = Z)
    (a : ∀ i, (D.x i).x ⟶ x)
    (ha : ∀ i, 𝒳.toBasedCategory.p.IsHomLift (g i) (a i))
    (hacompat : ∀ i j, (D.xrij i j).hom.a ≫ a i =
      (D.φ i j).a ≫ (D.xrji i j).hom.a ≫ a j) : D.IsEffective := by
  obtain ⟨y, hy, b, hb, hbcompat⟩ := descentDatum_exists_target_cocone hf D
  have hgcover := ofArrows_mem_of_isPullback _ f hf q g
    (fun i => (D.x i).q ≫ eqToHom (D.hx i)) sq
  have hsq := descentDatum_source_overlap D q g sq hg
  have hαb (i : I) : 𝒴.toBasedCategory.p.IsHomLift (g i ≫ q) ((D.x i).α ≫ b i) := by
    have := (D.x i).α_over
    have := hb i
    have hα : 𝒴.toBasedCategory.p.IsHomLift ((D.x i).q ≫ eqToHom (D.hx i)) (D.x i).α := by
      refine CategoryTheory.IsHomLift.of_fac' _ _ _ ((F.w_obj _).trans (D.x i).x_over)
        ((D.x i).y_over.trans (D.hx i)) ?_
      simpa using CategoryTheory.IsHomLift.fac' 𝒴.toBasedCategory.p (D.x i).q (D.x i).α
    rw [(sq i).w]
    infer_instance
  have hright (i j : I) : 𝒴.toBasedCategory.p.IsHomLift
      ((D.φ i j).g ≫ (D.xrji i j).hom.g)
      (F.map (D.φ i j).a ≫ F.map (D.xrji i j).hom.a) := by
    have := (D.φ i j).a_over
    have := (D.xrji i j).hom.a_over
    infer_instance
  have hleft (i j : I) : 𝒴.toBasedCategory.p.IsHomLift
      (D.xrij i j).hom.g (F.map (D.xrij i j).hom.a) := by
    have := (D.xrij i j).hom.a_over
    infer_instance
  have halift (i : I) : 𝒴.toBasedCategory.p.IsHomLift (g i) (F.map (a i)) := by
    have := ha i
    infer_instance
  obtain ⟨α, hα, hαfac⟩ := exists_hom_over_of_local_cocones (hVij := hsq)
    𝒴.isStackInGroupoids hgcover q (F.obj x) y ((F.w_obj x).trans hx) hy
    (fun i => F.obj (D.x i).x) (fun i => (F.w_obj _).trans (D.x i).x_over)
    (fun i => F.map (a i)) (fun i => (D.x i).α ≫ b i) halift hαb
    (fun i j => F.obj (D.xrij i j).pt.x)
    (fun i j => (F.w_obj _).trans (D.xrij i j).pt.x_over)
    (fun i j => F.map (D.xrij i j).hom.a)
    (fun i j => F.map (D.φ i j).a ≫ F.map (D.xrji i j).hom.a)
    hleft hright
    (fun i j => by
      simpa only [Functor.map_comp, Category.assoc] using congrArg F.map (hacompat i j))
    (fun i j => by
      calc _ = (D.xrij i j).pt.α ≫ (D.xrij i j).hom.b ≫ b i := by
            rw [← Category.assoc, (D.xrij i j).hom.compatible, Category.assoc]
        _ = (D.xrij i j).pt.α ≫ (D.φ i j).b ≫ (D.xrji i j).hom.b ≫ b j := by rw [hbcompat]
        _ = _ := by
            rw [← Category.assoc (D.xrij i j).pt.α, ← (D.φ i j).compatible]
            simpa only [Category.assoc] using congrArg
              (fun z => F.map (D.φ i j).a ≫ z ≫ b j) (D.xrji i j).hom.compatible.symm)
  let P : Object B S hS 𝒳 𝒴 F d := ⟨U, Z, q, hq, y, hy, x, hx, α, hα⟩
  let ν (i : I) : D.x i ⟶ P :=
    { f := eqToHom (D.hx i) ≫ f i
      g := g i
      square := by
        change IsPullback (g i) (D.x i).q q (eqToHom (D.hx i) ≫ f i)
        simpa only [Iso.refl_hom, eqToIso.hom, Category.id_comp, Category.comp_id,
          Category.assoc, eqToHom_trans, eqToHom_refl] using
          (sq i).of_iso (Iso.refl _) (Iso.refl _) (eqToIso (D.hx i).symm) (Iso.refl _)
            (by simp) (by simp) (by simp) (by simp)
      b := b i
      b_over := by
        refine CategoryTheory.IsHomLift.of_fac' _ _ _ (D.x i).y_over hy ?_
        simpa using CategoryTheory.IsHomLift.fac' 𝒴.toBasedCategory.p (f i) (b i)
      a := a i
      a_over := ha i
      compatible := hαfac i }
  refine descentDatum_isEffective_of_cocone
    (A := finiteHilbertCategory) isFiberedInGroupoids_finiteHilbertProjection D P rfl ν
    (fun i => ?_) (fun i j => ?_)
  · refine CategoryTheory.IsHomLift.of_fac' (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) (f i) (ν i) (D.hx i) rfl ?_
    simp [finiteHilbertProjection, ν]
  · refine Hom.ext ?_ (hg i j).symm (hbcompat i j).symm (hacompat i j).symm
    have h3 := Hom.f_eq_of_fibreHom _ _ _ (D.φ_fibreHom i j)
    change (D.φ i j).f ≫ (D.xrji i j).hom.f ≫ (eqToHom (D.hx j) ≫ f j) =
      (D.xrij i j).hom.f ≫ (eqToHom (D.hx i) ≫ f i)
    rw [restriction_hom_f (D.xrij i j), restriction_hom_f (D.xrji i j), h3]
    simp only [Category.assoc, eqToHom_trans_assoc, eqToHom_trans, eqToHom_refl,
      Category.id_comp]
    rw [(hVij i j).w]

/-- A descent datum of the relative finite Hilbert category is effective once its covers have
descended, inside the big fppf category over `S`, to a finite locally free cover `q : Z ⟶ U` of
degree `d`. -/
theorem descentDatum_isEffective_of_scheme_cocone
    (hf : Sieve.ofArrows V f ∈ BigFppfOver.topology B S hS U)
    (D : CategoryTheory.Functor.DescentDatum (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d))
      V f Vij pr₁ pr₂ hVij Vijk s₁₂ s₂₃ hVijk q₁ q₂ q₃ hq₁ hq₂ hq₃)
    (Z : BigFppfOver B S hS) (q : Z ⟶ U)
    (hq : Stacks.Morphisms.IsFiniteLocallyFreeOfRank
      ((BigFppfOver.toScheme B S hS).map q) d)
    (g : ∀ i, (D.x i).Z ⟶ Z)
    (sq : ∀ i, IsPullback (g i) ((D.x i).q ≫ eqToHom (D.hx i)) q (f i))
    (hg : ∀ i j, (D.xrij i j).hom.g ≫ g i =
      (D.φ i j).g ≫ (D.xrji i j).hom.g ≫ g j) : D.IsEffective := by
  obtain ⟨x, hx, a, ha, hcompat⟩ := descentDatum_exists_source_cocone hf D q g sq hg
  exact descentDatum_isEffective_of_source_cocone hf D Z q hq g sq hg x hx a ha hcompat

-- The diagram of covers of a sieve datum agrees with the functor remembering the cover by
-- unfolding.
attribute [local implicit_reducible] sourceFunctor sourceDiagram

/-- **Condition (3) of Stacks 05WB: every descent datum of the relative finite Hilbert category
relative to a covering family of the big fppf site is effective.** -/
theorem descentDatum_isEffective
    (hf : Sieve.ofArrows V f ∈ BigFppfOver.topology B S hS U)
    (D : CategoryTheory.Functor.DescentDatum (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d))
      V f Vij pr₁ pr₂ hVij Vijk s₁₂ s₂₃ hVijk q₁ q₂ q₃ hq₁ hq₂ hq₃) : D.IsEffective := by
  classical
  have : (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)).IsFibered :=
    (isFiberedInGroupoids_finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)).isFibered
  have hex : ∀ (W : BigFppfOver B S hS) (h : W ⟶ U), (Sieve.ofArrows V f).arrows h →
      ∃ (i : I) (a : W ⟶ V i), a ≫ f i = h :=
    fun _ _ hh => exists_factorization_of_ofArrows hh
  choose idx arr harr using hex
  let SD := D.toSieve idx arr harr
  obtain ⟨E, hE, hER, hEfpqc⟩ := exists_fpqc_cover_refining B S hS V f hf
  obtain ⟨Z, q, g, hq, sq, hg⟩ := sieve_exists_fpqc_cocone SD E.f hER hEfpqc
  obtain ⟨ζ, hζsq, hζnat⟩ := CartesianSieveDiagram.exists_cocone (sourceDiagram SD)
    E.f hE hER q g sq hg
  let G := sourceFunctor (B := B) (S := S) (hS := hS) (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)
  let κ i := Fiber.fiberInclusion.map (D.kappa idx arr harr i).hom
  let ν i := (κ i).g ≫ ζ (f i) (Sieve.ofArrows_mk V f i)
  have hνsq (i : I) : IsPullback (ν i) ((D.x i).q ≫ eqToHom (D.hx i)) q (f i) := by
    have hκ : (finiteHilbertProjection (B := B) (S := S) (hS := hS)
        (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)).IsHomLift (𝟙 (V i)) (κ i) :=
      (D.kappa idx arr harr i).hom.2
    have hκf : (κ i).f = _ :=
      CategoryTheory.IsHomLift.fac' (finiteHilbertProjection (B := B) (S := S) (hS := hS)
        (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)) (𝟙 (V i)) (κ i)
    have hκsq := (κ i).square
    rw [hκf] at hκsq
    have hs : IsPullback (κ i).g ((D.x i).q ≫ eqToHom (D.hx i))
        ((sourceDiagram SD).q (f i) (Sieve.ofArrows_mk V f i)) (𝟙 (V i)) :=
      hκsq.of_iso (Iso.refl _) (Iso.refl _) (eqToIso (D.hx i))
        (eqToIso (SD.obj (f i) (Sieve.ofArrows_mk V f i)).2)
        (by simp) (by simp) (by simp [sourceDiagram, SD, Fiber.fiberInclusion]) (by simp)
    simpa only [Category.id_comp] using
      hs.paste_horiz (hζsq (f i) (Sieve.ofArrows_mk V f i))
  refine descentDatum_isEffective_of_scheme_cocone hf D Z q hq ν hνsq fun i j => ?_
  have hA : Fiber.fiberInclusion.map ((D.xrij i j).fiberIso.symm ≪≫
        pullbackFiberIso (D.kappa idx arr harr i) (pr₁ i j)).hom ≫
      IsPreFibered.pullbackMap (SD.obj (f i) (Sieve.ofArrows_mk V f i)).2 (pr₁ i j) =
      (D.xrij i j).hom ≫ κ i := by
    simp [κ, SD, Iso.trans_hom, Iso.symm_hom, pullbackFiberIso_hom, Functor.map_comp,
      Category.assoc, pullbackFiberHom_fac, Restriction.fiberIso_inv_fac_assoc]
  have hB : Fiber.fiberInclusion.map (fibreIsoMk (D.φ_fibreHom i j) (D.φ_iso i j) ≪≫
        (D.xrji i j).fiberIso.symm ≪≫
        pullbackFiberIso (D.kappa idx arr harr j) (pr₂ i j)).hom ≫
      IsPreFibered.pullbackMap (SD.obj (f j) (Sieve.ofArrows_mk V f j)).2 (pr₂ i j) =
      D.φ i j ≫ (D.xrji i j).hom ≫ κ j := by
    simp [κ, SD, Iso.trans_hom, Iso.symm_hom, pullbackFiberIso_hom, Functor.map_comp,
      Category.assoc, pullbackFiberHom_fac, Restriction.fiberIso_inv_fac_assoc,
      fibreIsoMk_hom, fiberInclusion_map_fibreHomMk]
  have hC : (fibreIsoMk (D.φ_fibreHom i j) (D.φ_iso i j) ≪≫ (D.xrji i j).fiberIso.symm ≪≫
        pullbackFiberIso (D.kappa idx arr harr j) (pr₂ i j)).hom =
      ((D.xrij i j).fiberIso.symm ≪≫
          pullbackFiberIso (D.kappa idx arr harr i) (pr₁ i j)).hom ≫
        (SD.iso (Sieve.ofArrows_mk V f i) (Sieve.ofArrows_mk V f j)
          (pr₁ i j) (pr₂ i j) (hVij i j).w).hom := by
    simp only [Iso.trans_hom, Iso.symm_hom, pullbackFiberIso_hom, fibreIsoMk_hom, Category.assoc]
    rw [← D.glueIso_comp_kappa idx arr harr i j,
      CategoryTheory.Functor.DescentDatum.glueIso_hom, Restriction.fiberMor]
    simp [Category.assoc, Iso.inv_hom_id_assoc]
  have hcompat := sourceSieve_compatible SD ζ hζnat
    (Sieve.ofArrows_mk V f i) (Sieve.ofArrows_mk V f j) (pr₁ i j) (pr₂ i j) (hVij i j).w
  have hA' := congrArg G.map hA
  have hB' := congrArg G.map hB
  have hC' := congrArg (fun z => G.map (Fiber.fiberInclusion.map z)) hC
  simp only [Functor.map_comp] at hA' hB' hC'
  change G.map (D.xrij i j).hom ≫ G.map (κ i) ≫ ζ (f i) _ =
    G.map (D.φ i j) ≫ G.map (D.xrji i j).hom ≫ G.map (κ j) ≫ ζ (f j) _
  have hA'' := congrArg (fun z => z ≫ ζ (f i) (Sieve.ofArrows_mk V f i)) hA'
  have hB'' := congrArg (fun z => z ≫ ζ (f j) (Sieve.ofArrows_mk V f j)) hB'
  simp only [Category.assoc] at hA'' hB''
  rw [← hA'', ← hB'', hC']
  simp only [Category.assoc]
  exact (congrArg (fun z => G.map (Fiber.fiberInclusion.map
    ((D.xrij i j).fiberIso.symm ≪≫ pullbackFiberIso (D.kappa idx arr harr i) (pr₁ i j)).hom) ≫ z)
    hcompat).symm

end Effectivity

end FiniteHilbert

/-! ### Stacks 05WB -/

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {d : ℕ}
  {𝒳 𝒴 : StackInGroupoids.{w} (BigFppfOver B S hS) (BigFppfOver.topology B S hS)}
  {F : 𝒳.toBasedCategory ⥤ᵇ 𝒴.toBasedCategory}

/-- The relative finite Hilbert category `ℋ_d(𝒳/𝒴)` of a 1-morphism `F : 𝒳 ⟶ 𝒴` of stacks in
groupoids over the big fppf site of a scheme `S`, endowed with its forgetful functor to the site,
is a stack in groupoids over `(Sch/S)_fppf`. -/
@[stacks 05WB]
theorem isStackInGroupoids_finiteHilbertProjection :
    (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)).IsStackInGroupoids.{w}
      (BigFppfOver.topology B S hS) := by
  refine ⟨isFiberedInGroupoids_finiteHilbertProjection, ?_, ?_⟩
  · intro U P Q hP hQ I V f hf Vij pr₁ pr₂ hVij xr yr xrij yrij
    exact isom_isSheaf_finiteHilbertProjection P Q hP hQ V f hf Vij pr₁ pr₂ hVij xr yr xrij yrij
  · intro U I V f hf Vij pr₁ pr₂ hVij Vijk s₁₂ s₂₃ hVijk q₁ q₂ q₃ hq₁ hq₂ hq₃ D
    exact FiniteHilbert.descentDatum_isEffective hf D

end AlgebraicGeometry.Stack

