module

public import StacksFrontier.AlgebraicGeometry.Descent.Scheme.FibreProductGluing
public import StacksFrontier.AlgebraicGeometry.Stacks.FiniteHilbert.HilbertCoverDatumBaseChange

/-!
# The gluing data of schemes carried by a descent datum of `ℋ_d`

A descent datum of the category `ℋ_d` of degree-`d` finite locally free covers relative to the
sieve generated by a family `g i : X i ⟶ T` of the big fppf site of `S` attaches a cover
`Z i ⟶ X i` to each member of the family and, to each object of the site mapping into two of the
sources compatibly over `T`, an isomorphism of the two fibre-product covers. Descent of *schemes*
along the family, `AlgebraicGeometry.DescentData`, asks instead for one isomorphism

```
Z i ×_T X j ≅ X i ×_T Z j
```

over the pairwise base, for each pair of indices. This file produces it: the object of the site
mapping into `X i` and into `X j` is their fibre product there, the two fibre-product covers of
it are `Z i ×_{X i} (X i ×_T X j)` and `Z j ×_{X j} (X i ×_T X j)`, and those are the two
displayed fibre products over `T` — because the canonical functor to schemes preserves fibre
products, and a fibre product of a fibre product contracts.

## Main definitions

* `AlgebraicGeometry.Stack.datumSchemeGluing`: the gluing isomorphism of schemes attached to a
  pair of indices.

## Main results

* `AlgebraicGeometry.Stack.isPullback_datumCoverSource` and
  `AlgebraicGeometry.Stack.isPullback_datumCoverTarget`: the two contractions, which identify the
  underlying scheme of each fibre-product cover of the pairwise base with the corresponding fibre
  product over the base of the family.
* `AlgebraicGeometry.Stack.datumSchemeGluing_hom_comp_fst` and
  `AlgebraicGeometry.Stack.datumSchemeGluing_hom_comp_snd`: the gluing isomorphism lies over the
  pairwise base. These are the two hypotheses `ht₁` and `ht₂` of
  `AlgebraicGeometry.DescentData.ofFibreGluing`.

## Implementation notes

Nothing here is a statement about the *cocycle*: the two conditions proved are the ones that say
the isomorphism lies over the pairwise base, and they follow from
`AlgebraicGeometry.Stack.datumGluing_hom_comp_snd` — the gluing isomorphism of the datum is an
isomorphism over the object of the site — together with the two cartesian squares. The cocycle
condition of `AlgebraicGeometry.DescentData.ofFibreGluing` is stated on generalized points over
an arbitrary scheme, and deriving it needs the base-change axiom of the datum,
`AlgebraicGeometry.Stack.datumGluing_comp_fst_of_fac`, as well as these contractions.

The contractions are produced as `CategoryTheory.IsPullback` statements and turned into
isomorphisms by `CategoryTheory.IsPullback.isoPullback`, rather than by naming an iterated
`CategoryTheory.Limits.pullback` comparison: the two legs of the contracted square are then
available as `CategoryTheory.IsPullback.isoPullback_inv_fst` and
`CategoryTheory.IsPullback.isoPullback_inv_snd`, which is exactly what the two conditions below
consume.

No tag attribute sits on anything here. Translating a sieve-indexed descent datum of Stacks 026B
into gluing data of schemes relative to a covering family is bookkeeping internal to the
formalisation.

## References

* [Stacks Project, Tag 026B](https://stacks.math.columbia.edu/tag/026B)
* [Stacks Project, Tag 023W](https://stacks.math.columbia.edu/tag/023W)
* [Stacks Project, Tag 0245](https://stacks.math.columbia.edu/tag/0245)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u v

namespace AlgebraicGeometry.Stack

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {d : ℕ}
  {T : BigFppfOver B S hS} {ι : Type v} {X : ι → BigFppfOver B S hS} {g : ∀ i, X i ⟶ T}
  (D : (finiteCoverProjection (B := B) (S := S) (hS := hS) (d := d)).SieveDescentDatum
    (Sieve.ofArrows X g))

/-- **The fibre-product cover of the pairwise base attached to the first index, contracted.** The
cover `Z i ×_{X i} (X i ×_T X j)` of `X i ×_T X j` is, read over `T`, the fibre product
`Z i ×_T X j`. -/
theorem isPullback_datumCoverSource (i j : ι) :
    IsPullback
      ((BigFppfOver.toScheme B S hS).map (pullback.fst
        (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) (pullback.fst (g i) (g j))))
      ((BigFppfOver.toScheme B S hS).map (pullback.snd
          (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) (pullback.fst (g i) (g j))) ≫
        (BigFppfOver.toScheme B S hS).map (pullback.snd (g i) (g j)))
      ((BigFppfOver.toScheme B S hS).map
          (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ≫
        (BigFppfOver.toScheme B S hS).map (g i))
      ((BigFppfOver.toScheme B S hS).map (g j)) :=
  ((IsPullback.of_hasPullback _ _).map (BigFppfOver.toScheme B S hS)).paste_vert
    ((IsPullback.of_hasPullback (g i) (g j)).map (BigFppfOver.toScheme B S hS))

/-- **The fibre-product cover of the pairwise base attached to the second index, contracted.** The
cover `Z j ×_{X j} (X i ×_T X j)` of `X i ×_T X j` is, read over `T`, the fibre product
`X i ×_T Z j`. -/
theorem isPullback_datumCoverTarget (i j : ι) :
    IsPullback
      ((BigFppfOver.toScheme B S hS).map (pullback.snd
          (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) (pullback.snd (g i) (g j))) ≫
        (BigFppfOver.toScheme B S hS).map (pullback.fst (g i) (g j)))
      ((BigFppfOver.toScheme B S hS).map (pullback.fst
        (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) (pullback.snd (g i) (g j))))
      ((BigFppfOver.toScheme B S hS).map (g i))
      ((BigFppfOver.toScheme B S hS).map
          (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) ≫
        (BigFppfOver.toScheme B S hS).map (g j)) :=
  (((IsPullback.of_hasPullback _ _).map (BigFppfOver.toScheme B S hS)).paste_vert
    (((IsPullback.of_hasPullback (g i) (g j)).map (BigFppfOver.toScheme B S hS)).flip)).flip

/-- **The gluing isomorphism of schemes attached to a pair of indices.** It is the gluing
isomorphism of the datum at the two projections of the fibre product `X i ×_T X j` of the site,
read through the two contractions
`AlgebraicGeometry.Stack.isPullback_datumCoverSource` and
`AlgebraicGeometry.Stack.isPullback_datumCoverTarget`. -/
def datumSchemeGluing (i j : ι) :
    pullback
        ((BigFppfOver.toScheme B S hS).map
            (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ≫
          (BigFppfOver.toScheme B S hS).map (g i))
        ((BigFppfOver.toScheme B S hS).map (g j)) ≅
      pullback ((BigFppfOver.toScheme B S hS).map (g i))
        ((BigFppfOver.toScheme B S hS).map
            (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) ≫
          (BigFppfOver.toScheme B S hS).map (g j)) :=
  (isPullback_datumCoverSource D i j).isoPullback.symm ≪≫
    (BigFppfOver.toScheme B S hS).mapIso
      (datumGluing D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g j)
        (pullback.fst (g i) (g j)) (pullback.snd (g i) (g j)) pullback.condition) ≪≫
    (isPullback_datumCoverTarget D i j).isoPullback

/-- The gluing isomorphism of the datum at the projections of `X i ×_T X j`, mapped to schemes, is
an isomorphism over `X i ×_T X j`. -/
private theorem map_datumGluing_hom_comp_snd (i j : ι) :
    (BigFppfOver.toScheme B S hS).map (datumGluing D (Sieve.ofArrows_mk X g i)
        (Sieve.ofArrows_mk X g j) (pullback.fst (g i) (g j)) (pullback.snd (g i) (g j))
        pullback.condition).hom ≫
      (BigFppfOver.toScheme B S hS).map (pullback.snd
        (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) (pullback.snd (g i) (g j))) =
    (BigFppfOver.toScheme B S hS).map (pullback.snd
      (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) (pullback.fst (g i) (g j))) := by
  rw [← Functor.map_comp, datumGluing_hom_comp_snd]

/-- **The gluing isomorphism of schemes preserves the first component of the pairwise base.**
This is the hypothesis `ht₁` of `AlgebraicGeometry.DescentData.ofFibreGluing`. -/
theorem datumSchemeGluing_hom_comp_fst (i j : ι) :
    (datumSchemeGluing D i j).hom ≫
        pullback.fst ((BigFppfOver.toScheme B S hS).map (g i))
          ((BigFppfOver.toScheme B S hS).map
              (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) ≫
            (BigFppfOver.toScheme B S hS).map (g j)) =
      pullback.fst
          ((BigFppfOver.toScheme B S hS).map
              (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ≫
            (BigFppfOver.toScheme B S hS).map (g i))
          ((BigFppfOver.toScheme B S hS).map (g j)) ≫
        (BigFppfOver.toScheme B S hS).map
          (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) := by
  have hmap := map_datumGluing_hom_comp_snd D i j
  have hA := ((IsPullback.of_hasPullback
    (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) (pullback.fst (g i) (g j))).map
      (BigFppfOver.toScheme B S hS)).w
  simp only [datumSchemeGluing, Iso.trans_hom, Iso.symm_hom, Functor.mapIso_hom, Category.assoc,
    (isPullback_datumCoverTarget D i j).isoPullback_hom_fst]
  rw [← Category.assoc ((BigFppfOver.toScheme B S hS).map _), hmap, ← hA, ← Category.assoc,
    (isPullback_datumCoverSource D i j).isoPullback_inv_fst]

/-- **The gluing isomorphism of schemes preserves the second component of the pairwise base.**
This is the hypothesis `ht₂` of `AlgebraicGeometry.DescentData.ofFibreGluing`. -/
theorem datumSchemeGluing_hom_comp_snd (i j : ι) :
    (datumSchemeGluing D i j).hom ≫
        pullback.snd ((BigFppfOver.toScheme B S hS).map (g i))
            ((BigFppfOver.toScheme B S hS).map
                (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) ≫
              (BigFppfOver.toScheme B S hS).map (g j)) ≫
          (BigFppfOver.toScheme B S hS).map
            (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) =
      pullback.snd
        ((BigFppfOver.toScheme B S hS).map
            (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ≫
          (BigFppfOver.toScheme B S hS).map (g i))
        ((BigFppfOver.toScheme B S hS).map (g j)) := by
  have hmap := map_datumGluing_hom_comp_snd D i j
  have hB := ((IsPullback.of_hasPullback
    (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) (pullback.snd (g i) (g j))).map
      (BigFppfOver.toScheme B S hS)).w
  simp only [datumSchemeGluing, Iso.trans_hom, Iso.symm_hom, Functor.mapIso_hom, Category.assoc]
  rw [← Category.assoc ((isPullback_datumCoverTarget D i j).isoPullback.hom),
    (isPullback_datumCoverTarget D i j).isoPullback_hom_snd, hB,
    ← Category.assoc ((BigFppfOver.toScheme B S hS).map _), hmap,
    (isPullback_datumCoverSource D i j).isoPullback_inv_snd]

end AlgebraicGeometry.Stack

end
