-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Stack

universe u v w ws

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  (𝒳 𝒴 : StackInGroupoids.{ws, u, max u v, u + 1, max (u + 1) v w}
    (BigFppfOver B S hS) (BigFppfOver.topology B S hS))
  (F : 𝒳.toBasedCategory ⥤ᵇ 𝒴.toBasedCategory) (d : ℕ)

/-- The relative finite Hilbert category `ℋ_d(𝒳/𝒴)`, regarded as an object of the 2-category of
categories fibred in groupoids over the big fppf site. -/
@[reducible] noncomputable def finiteHilbertCFG :
    CatFiberedInGroupoids.{u, max u v, u + 1, max (u + 1) v w} (BigFppfOver B S hS) :=
  CatFiberedInGroupoids.mk
    (finiteHilbertCategory (B := B) (S := S) (hS := hS) (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d))
    isFiberedInGroupoids_finiteHilbertProjection

/-- The 1-morphism `p : ℋ_d(𝒳/𝒴) ⟶ 𝒴` of Stacks 05WD, regarded as a 1-morphism of the
2-category of categories fibred in groupoids over the big fppf site. -/
@[reducible] noncomputable def finiteHilbertToTargetCFG :
    finiteHilbertCFG.{u, v, w, ws} B S hS 𝒳 𝒴 F d ⟶
      CatFiberedInGroupoids.mk 𝒴.toBasedCategory
        𝒴.isStackInGroupoids.isFiberedInGroupoids :=
  Bicategory.InducedBicategory.mkHom
    (forgetTarget (B := B) (S := S) (hS := hS) (d := d) (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F))

/-! ### Spreading out a cover and an object along a limit -/

/-- The scheme morphism underlying a morphism of the big fppf site over `S` commutes with the
structure morphisms to `S`. -/
private theorem toScheme_map_comp_inclusion_map_hom {X Y : BigFppfOver B S hS} (f : X ⟶ Y) :
    (BigFppfOver.toScheme B S hS).map f ≫ B.inclusion.map Y.hom = B.inclusion.map X.hom := by
  change B.inclusion.map f.left ≫ B.inclusion.map Y.hom = _
  rw [← Functor.map_comp, Over.w f]

/-- Factorisation through a strongly cartesian morphism: a morphism lifting `f'`, where `f'`
factors through the base `f` of the cartesian morphism `φ`, factors through `φ` by a lift of the
factorisation. -/
private theorem exists_lift_comp_eq_of_isStronglyCartesian {𝒳 𝒮 : Type*} [Category 𝒳]
    [Category 𝒮] (p : 𝒳 ⥤ 𝒮) {R R' S : 𝒮} {a a' b : 𝒳} (f : R ⟶ S) (φ : a ⟶ b)
    [p.IsStronglyCartesian f φ] (g : R' ⟶ R) (f' : R' ⟶ S) (hf' : f' = g ≫ f) (φ' : a' ⟶ b)
    [p.IsHomLift f' φ'] : ∃ ψ : a' ⟶ a, p.IsHomLift g ψ ∧ ψ ≫ φ = φ' :=
  ⟨_, Functor.IsStronglyCartesian.map_isHomLift p f φ hf' φ',
    Functor.IsStronglyCartesian.fac p f φ hf' φ'⟩

/-- The base changes `U_k ×_{U_{i'}} Z'` of an affine morphism `q' : Z' ⟶ U_{i'}` to the later
stages `k ⟶ i'` of a diagram of affine objects of the site, as a diagram of affine objects of the
site indexed by `Over i'`. Its underlying diagram of schemes is
`AlgebraicGeometry.Scheme.baseChangeDiagram`. -/
private noncomputable def stageBaseChange {I : Type u} [Category.{u} I]
    (D : I ⥤ BigAffineFppf B S hS) (i' : I) {Z' : BigFppfOver B S hS}
    (q' : Z' ⟶ (BigAffineFppf.inclusion B S hS).obj (D.obj i'))
    (hq' : IsAffineHom ((BigFppfOver.toScheme B S hS).map q')) :
    Over i' ⥤ BigAffineFppf B S hS :=
  (IsAffineOver B S hS).lift
    (((schemeSizeBelow B.cutoff).lift
        (Scheme.baseChangeDiagram (D ⋙ BigAffineFppf.toScheme B S hS) i'
          (Over.mk ((BigFppfOver.toScheme B S hS).map q')))
        (fun k => Scheme.size_pullback_lt _ _ (D.obj k.left).obj.left.property
          Z'.left.property)).toOver (B.obj hS)
      (fun k => ObjectProperty.homMk (pullback.snd _ _ ≫ B.inclusion.map Z'.hom))
      (fun e => by
        ext1
        exact Scheme.baseChangeDiagram_map_snd_assoc _ _ _ e _))
    (fun k => by
      have : IsAffine ((BigFppfOver.toScheme B S hS).obj
          ((BigAffineFppf.inclusion B S hS).obj (D.obj i'))) := (D.obj i').property
      have : IsAffine ((BigAffineFppf.toScheme B S hS).obj (D.obj k.left)) :=
        (D.obj k.left).property
      have : IsAffine ((BigFppfOver.toScheme B S hS).obj Z') :=
        isAffine_of_isAffineHom ((BigFppfOver.toScheme B S hS).map q')
      change IsAffine (pullback ((D ⋙ BigAffineFppf.toScheme B S hS).map k.hom)
        ((BigFppfOver.toScheme B S hS).map q'))
      infer_instance)

/-- The cone with vertex `Z` over `AlgebraicGeometry.Stack.stageBaseChange`, for a square
`g ≫ q' = q ≫ (U ⟶ U_{i'})` with `Z` affine which is cartesian in schemes. Its legs are those of
`AlgebraicGeometry.Scheme.baseChangeCone`, read through the identification of `Z` with the base
change of `q'` to the limit. -/
private noncomputable def stageBaseChangeCone {I : Type u} [Category.{u} I]
    (D : I ⥤ BigAffineFppf B S hS) (c : Cone D) (i' : I) {Z' : BigFppfOver B S hS}
    (q' : Z' ⟶ (BigAffineFppf.inclusion B S hS).obj (D.obj i'))
    (hq' : IsAffineHom ((BigFppfOver.toScheme B S hS).map q'))
    {Z : BigFppfOver B S hS} (hZ : IsAffine ((BigFppfOver.toScheme B S hS).obj Z))
    (q : Z ⟶ (BigAffineFppf.inclusion B S hS).obj c.pt) (g : Z ⟶ Z')
    (hsq : IsPullback ((BigFppfOver.toScheme B S hS).map g)
      ((BigFppfOver.toScheme B S hS).map q) ((BigFppfOver.toScheme B S hS).map q')
      ((BigAffineFppf.toScheme B S hS).map (c.π.app i'))) :
    Cone (stageBaseChange B S hS D i' q' hq') where
  pt := ⟨Z, hZ⟩
  π :=
    { app := fun k => ObjectProperty.homMk (Over.homMk (ObjectProperty.homMk
        (hsq.flip.isoPullback.hom ≫
          (Scheme.baseChangeCone (D ⋙ BigAffineFppf.toScheme B S hS) i'
            (Over.mk ((BigFppfOver.toScheme B S hS).map q'))
            ((BigAffineFppf.toScheme B S hS).mapCone c)).π.app k))
        (by
          ext1
          have h1 : (hsq.flip.isoPullback.hom ≫
              (Scheme.baseChangeCone (D ⋙ BigAffineFppf.toScheme B S hS) i'
                (Over.mk ((BigFppfOver.toScheme B S hS).map q'))
                ((BigAffineFppf.toScheme B S hS).mapCone c)).π.app k) ≫
              pullback.snd ((D ⋙ BigAffineFppf.toScheme B S hS).map k.hom)
                ((BigFppfOver.toScheme B S hS).map q') = (BigFppfOver.toScheme B S hS).map g :=
            (Category.assoc _ _ _).trans
              ((congrArg (hsq.flip.isoPullback.hom ≫ ·)
                (Scheme.baseChangeCone_π_snd _ _ _ _ k)).trans hsq.flip.isoPullback_hom_snd)
          exact (Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ B.inclusion.map Z'.hom) h1).trans
              (toScheme_map_comp_inclusion_map_hom B S hS g))))
      naturality := fun k k' e => by
        refine (Category.id_comp _).trans ?_
        ext1; ext1; ext1
        exact (congrArg (hsq.flip.isoPullback.hom ≫ ·)
          ((Scheme.baseChangeCone (D ⋙ BigAffineFppf.toScheme B S hS) i'
            (Over.mk ((BigFppfOver.toScheme B S hS).map q'))
            ((BigAffineFppf.toScheme B S hS).mapCone c)).w e).symm).trans
          (Category.assoc _ _ _).symm }

/-- The cone `AlgebraicGeometry.Stack.stageBaseChangeCone` is a limit in schemes when the
original cone is: the limit of the base changes of `q'` is the base change of `q'` to the
limit. -/
private noncomputable def stageBaseChangeCone_isLimit {I : Type u} [Category.{u} I]
    [IsCofiltered I] (D : I ⥤ BigAffineFppf B S hS) (c : Cone D)
    (hc : IsLimit ((BigAffineFppf.toScheme B S hS).mapCone c)) (i' : I)
    {Z' : BigFppfOver B S hS} (q' : Z' ⟶ (BigAffineFppf.inclusion B S hS).obj (D.obj i'))
    (hq' : IsAffineHom ((BigFppfOver.toScheme B S hS).map q'))
    {Z : BigFppfOver B S hS} (hZ : IsAffine ((BigFppfOver.toScheme B S hS).obj Z))
    (q : Z ⟶ (BigAffineFppf.inclusion B S hS).obj c.pt) (g : Z ⟶ Z')
    (hsq : IsPullback ((BigFppfOver.toScheme B S hS).map g)
      ((BigFppfOver.toScheme B S hS).map q) ((BigFppfOver.toScheme B S hS).map q')
      ((BigAffineFppf.toScheme B S hS).map (c.π.app i'))) :
    IsLimit ((BigAffineFppf.toScheme B S hS).mapCone
      (stageBaseChangeCone B S hS D c i' q' hq' hZ q g hsq)) :=
  let s := Scheme.baseChangeCone (D ⋙ BigAffineFppf.toScheme B S hS) i'
    (Over.mk ((BigFppfOver.toScheme B S hS).map q')) ((BigAffineFppf.toScheme B S hS).mapCone c)
  let e : (BigFppfOver.toScheme B S hS).obj Z ≅ s.pt := hsq.flip.isoPullback
  IsLimit.ofIsoLimit
    (Scheme.isLimitBaseChangeCone (D ⋙ BigAffineFppf.toScheme B S hS) i'
      (Over.mk ((BigFppfOver.toScheme B S hS).map q')) ((BigAffineFppf.toScheme B S hS).mapCone c)
      hc)
    ((Cone.extendIso s e.symm).trans (Cone.ext (Iso.refl _) fun _ => (Category.id_comp _).symm))

/-- **The cover spreads out.** A degree-`d` finite locally free cover of an affine limit of
affine objects of the site is the base change of a degree-`d` finite locally free cover of some
stage which lies under a given one, the base change square being cartesian in schemes. This is
Stacks 01ZM and the degree-`d` form of Stacks 06AC, together with Stacks 000R (5) to place the
spread-out cover in the site. -/
private theorem exists_cover_spreadOut {I : Type u} [Category.{u} I] [IsCofiltered I]
    (D : I ⥤ BigAffineFppf B S hS) (c : Cone D)
    (hc : IsLimit ((BigAffineFppf.toScheme B S hS).mapCone c)) (i : I)
    (Z : BigFppfOver B S hS) (q : Z ⟶ (BigAffineFppf.inclusion B S hS).obj c.pt)
    (hq : Stacks.Morphisms.IsFiniteLocallyFreeOfRank ((BigFppfOver.toScheme B S hS).map q) d) :
    ∃ (i' : I) (_ : i' ⟶ i) (Z' : BigFppfOver B S hS)
      (q' : Z' ⟶ (BigAffineFppf.inclusion B S hS).obj (D.obj i')),
      Stacks.Morphisms.IsFiniteLocallyFreeOfRank ((BigFppfOver.toScheme B S hS).map q') d ∧
        ∃ g : Z ⟶ Z', IsPullback ((BigFppfOver.toScheme B S hS).map g)
          ((BigFppfOver.toScheme B S hS).map q) ((BigFppfOver.toScheme B S hS).map q')
          ((BigAffineFppf.toScheme B S hS).map (c.π.app i')) := by
  let T := BigFppfOver.toScheme B S hS
  let Ds := D ⋙ BigAffineFppf.toScheme B S hS
  let cs := (BigAffineFppf.toScheme B S hS).mapCone c
  have : ∀ a : I, IsAffine (Ds.obj a) := fun a => (D.obj a).property
  have : ∀ {a b : I} (f : a ⟶ b), IsAffineHom (Ds.map f) := fun _ => inferInstance
  have : ∀ a : I, CompactSpace (Ds.obj a) := fun _ => inferInstance
  have : ∀ a : I, QuasiSeparatedSpace (Ds.obj a) := fun _ => inferInstance
  -- the cover is of finite presentation (Stacks 02KB)
  have hflf := Stacks.Morphisms.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree (T.map q) d
  obtain ⟨hfin, -, hlfp⟩ :=
    (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_locallyOfFinitePresentation
      (T.map q)).mp hflf
  have hqc : QuasiCompact (T.map q) := inferInstance
  have hqs : QuasiSeparated (T.map q) := inferInstance
  have hfp : FinitePresentation (Over.mk (T.map q) : Over cs.pt).hom := ⟨hlfp, hqc, hqs⟩
  -- Stacks 01ZM: it is the base change of a scheme of finite presentation over a stage
  obtain ⟨i₁, X₁, hX₁, ⟨e⟩⟩ :=
    LimitFPObjectDescent.exists_model_of_finitePresentation Ds cs hc (Over.mk (T.map q)) hfp
  have hw : e.hom.left ≫ pullback.snd X₁.hom (cs.π.app i₁) = T.map q := Over.w e.hom
  have : Stacks.Morphisms.IsFiniteLocallyFreeOfRank
      ((Over.pullback (cs.π.app i₁)).obj X₁).hom d := by
    have h : e.inv.left ≫ T.map q = pullback.snd X₁.hom (cs.π.app i₁) := Over.w e.inv
    change Stacks.Morphisms.IsFiniteLocallyFreeOfRank (pullback.snd X₁.hom (cs.π.app i₁)) d
    rw [← h]
    exact Stacks.Morphisms.isFiniteLocallyFreeOfRank_precomp ((Over.forget _).mapIso e.symm) _ hq
  -- Stacks 06AC, degree `d`: the model is finite locally free of degree `d` at a later stage
  obtain ⟨i₂, g₂, h₂⟩ :=
    exists_isFiniteLocallyFreeOfRank_overPullbackObj_of_isLimit Ds cs hc i₁ X₁ hX₁ d
  let i' := IsCofiltered.min i₂ i
  let k : i' ⟶ i₁ := IsCofiltered.minToLeft i₂ i ≫ g₂
  have hk : Stacks.Morphisms.IsFiniteLocallyFreeOfRank (pullback.snd X₁.hom (Ds.map k)) d := by
    have : Stacks.Morphisms.IsFiniteLocallyFreeOfRank (pullback.snd X₁.hom (Ds.map g₂)) d := h₂
    have hsq' := isPullback_pullback_snd_comp X₁.hom (Ds.map g₂)
      (Ds.map (IsCofiltered.minToLeft i₂ i))
    rw [← Ds.map_comp] at hsq'
    exact (prop_iff_of_isPullback (Stacks.Morphisms.IsFiniteLocallyFreeOfRank.property.{u} d)
      hsq' (IsPullback.of_hasPullback X₁.hom (Ds.map k))).mp
      (Stacks.Morphisms.IsFiniteLocallyFreeOfRank.of_isPullback
        (IsPullback.of_hasPullback (pullback.snd X₁.hom (Ds.map g₂))
          (Ds.map (IsCofiltered.minToLeft i₂ i))))
  -- Stacks 000R (5): the spread-out cover lies in the site
  have hZ' : B.Contains (pullback X₁.hom (Ds.map k)) := by
    have := Stacks.Morphisms.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree
      (pullback.snd X₁.hom (Ds.map k)) d
    have : IsFinite (pullback.snd X₁.hom (Ds.map k)) :=
      Stacks.Morphisms.IsFiniteLocallyFree.isFinite _
    exact Scheme.size_lt_of_locallyOfFiniteType_of_quasiCompact (pullback.snd X₁.hom (Ds.map k))
      (D.obj i').obj.left.property
  let Z' : BigFppfOver B S hS := Over.mk (ObjectProperty.homMk
    (pullback.snd X₁.hom (Ds.map k) ≫ B.inclusion.map (D.obj i').obj.hom) :
      B.obj hZ' ⟶ B.obj hS)
  let q' : Z' ⟶ (BigAffineFppf.inclusion B S hS).obj (D.obj i') :=
    Over.homMk (ObjectProperty.homMk (pullback.snd X₁.hom (Ds.map k))) rfl
  have hcond : (e.hom.left ≫ pullback.fst X₁.hom (cs.π.app i₁)) ≫ X₁.hom =
      (T.map q ≫ cs.π.app i') ≫ Ds.map k := by
    rw [Category.assoc, pullback.condition, ← Category.assoc, hw, Category.assoc, cs.w k]
  let gs : T.obj Z ⟶ pullback X₁.hom (Ds.map k) := pullback.lift _ _ hcond
  have hgs₁ : gs ≫ pullback.fst X₁.hom (Ds.map k) =
      e.hom.left ≫ pullback.fst X₁.hom (cs.π.app i₁) := pullback.lift_fst _ _ _
  have hgs₂ : gs ≫ pullback.snd X₁.hom (Ds.map k) = T.map q ≫ cs.π.app i' :=
    pullback.lift_snd _ _ _
  let g : Z ⟶ Z' := Over.homMk (ObjectProperty.homMk gs) (by
    ext1
    change gs ≫ pullback.snd X₁.hom (Ds.map k) ≫ B.inclusion.map (D.obj i').obj.hom = _
    rw [← Category.assoc, hgs₂, Category.assoc]
    exact (congrArg (T.map q ≫ ·) (toScheme_map_comp_inclusion_map_hom B S hS
      ((BigAffineFppf.inclusion B S hS).map (c.π.app i')))).trans
      (toScheme_map_comp_inclusion_map_hom B S hS q))
  refine ⟨i', IsCofiltered.minToRight i₂ i, Z', q', hk, g, ?_⟩
  -- the outer rectangle is the cartesian square of the model, transported along `e`
  have hout : IsPullback (e.hom.left ≫ pullback.fst X₁.hom (cs.π.app i₁)) (T.map q) X₁.hom
      (cs.π.app i₁) :=
    IsPullback.of_iso_pullback ⟨by
      rw [Category.assoc, pullback.condition, ← Category.assoc, hw]⟩
      ((Over.forget _).mapIso e) rfl hw
  have hout' : IsPullback (gs ≫ pullback.fst X₁.hom (Ds.map k)) (T.map q) X₁.hom
      (cs.π.app i' ≫ Ds.map k) := by
    rwa [hgs₁, cs.w k]
  exact IsPullback.of_right hout' hgs₂ (IsPullback.of_hasPullback X₁.hom (Ds.map k))

/-- **The object spreads out.** Given a cover `Z ⟶ U` of the limit which is the base change of a
degree-`d` finite locally free cover `Z' ⟶ U_{i'}` of a stage lying under `i`, an object `x` of
`𝒳` over `Z` and an identification `α` of `F x` with an object `y` of `𝒴` at the stage `i`, there
is a later stage at which the cover, `x` and `α` are all defined. The stage of the cover is base
changed further along the system, and `x` and `α` are spread out over the resulting system of
base changes of `Z'`, whose limit is `Z`, by limit preservation on objects of `F`. -/
private theorem exists_object_spreadOut
    (hlim : BigFppfOver.IsLimitPreservingOnObjects.{u, u, u} B S hS
      (CatFiberedInGroupoids.mk 𝒳.toBasedCategory 𝒳.isStackInGroupoids.isFiberedInGroupoids)
      (CatFiberedInGroupoids.mk 𝒴.toBasedCategory 𝒴.isStackInGroupoids.isFiberedInGroupoids)
      (Bicategory.InducedBicategory.mkHom F))
    {I : Type u} [Category.{u} I] [IsCofiltered I]
    (D : I ⥤ BigAffineFppf B S hS) (c : Cone D)
    (hc : IsLimit ((BigAffineFppf.toScheme B S hS).mapCone c)) (i : I)
    (Z : BigFppfOver B S hS) (q : Z ⟶ (BigAffineFppf.inclusion B S hS).obj c.pt)
    (i' : I) (j : i' ⟶ i) (Z' : BigFppfOver B S hS)
    (q' : Z' ⟶ (BigAffineFppf.inclusion B S hS).obj (D.obj i'))
    (hq' : Stacks.Morphisms.IsFiniteLocallyFreeOfRank ((BigFppfOver.toScheme B S hS).map q') d)
    (g : Z ⟶ Z')
    (hsq : IsPullback ((BigFppfOver.toScheme B S hS).map g)
      ((BigFppfOver.toScheme B S hS).map q) ((BigFppfOver.toScheme B S hS).map q')
      ((BigAffineFppf.toScheme B S hS).map (c.π.app i')))
    (x : 𝒳.toBasedCategory.obj) (hx : 𝒳.toBasedCategory.p.obj x = Z)
    (y : 𝒴.toBasedCategory.obj)
    (hy : 𝒴.toBasedCategory.p.obj y = (BigAffineFppf.inclusion B S hS).obj (D.obj i))
    (α : F.obj x ⟶ y)
    (hα : 𝒴.toBasedCategory.p.IsHomLift
      (q ≫ (BigAffineFppf.inclusion B S hS).map (c.π.app i)) α) :
    ∃ (i'' : I) (j'' : i'' ⟶ i) (Z'' : BigFppfOver B S hS)
      (q'' : Z'' ⟶ (BigAffineFppf.inclusion B S hS).obj (D.obj i'')),
      Stacks.Morphisms.IsFiniteLocallyFreeOfRank ((BigFppfOver.toScheme B S hS).map q'') d ∧
        ∃ g'' : Z ⟶ Z'',
          IsPullback g'' q q'' ((BigAffineFppf.inclusion B S hS).map (c.π.app i'')) ∧
            ∃ (x' : 𝒳.toBasedCategory.obj) (_ : 𝒳.toBasedCategory.p.obj x' = Z'')
              (a : x ⟶ x'), 𝒳.toBasedCategory.p.IsHomLift g'' a ∧
              ∃ η : F.obj x' ⟶ y,
                𝒴.toBasedCategory.p.IsHomLift
                    (q'' ≫ (BigAffineFppf.inclusion B S hS).map (D.map j'')) η ∧
                  F.map a ≫ η = α := by
  let T := BigFppfOver.toScheme B S hS
  let inc := BigAffineFppf.inclusion B S hS
  let Ds := D ⋙ BigAffineFppf.toScheme B S hS
  have hq'a : IsAffineHom (T.map q') := hq'.toIsAffineHom
  have hqa : IsAffineHom (T.map q) := MorphismProperty.of_isPullback hsq hq'a
  have : IsAffine (T.obj (inc.obj c.pt)) := c.pt.property
  have hZa : IsAffine (T.obj Z) := isAffine_of_isAffineHom (T.map q)
  let D' := stageBaseChange B S hS D i' q' hq'a
  let c' := stageBaseChangeCone B S hS D c i' q' hq'a hZa q g hsq
  have hc' : IsLimit ((BigAffineFppf.toScheme B S hS).mapCone c') :=
    stageBaseChangeCone_isLimit B S hS D c hc i' q' hq'a hZa q g hsq
  -- the first projection of a stage of the new system
  let ρ : ∀ k : Over i', inc.obj (D'.obj k) ⟶ inc.obj (D.obj k.left) := fun k =>
    Over.homMk (ObjectProperty.homMk (pullback.fst (Ds.map k.hom) (T.map q'))) (by
      ext1
      change pullback.fst (Ds.map k.hom) (T.map q') ≫ B.inclusion.map (D.obj k.left).obj.hom =
        pullback.snd (Ds.map k.hom) (T.map q') ≫ B.inclusion.map Z'.hom
      exact (congrArg (pullback.fst (Ds.map k.hom) (T.map q') ≫ ·)
        (toScheme_map_comp_inclusion_map_hom B S hS (inc.map (D.map k.hom)))).symm.trans
        ((pullback.condition_assoc _).trans (congrArg (pullback.snd (Ds.map k.hom) (T.map q') ≫ ·)
          (toScheme_map_comp_inclusion_map_hom B S hS q'))))
  have hρ : ∀ k, T.map (ρ k) = pullback.fst (Ds.map k.hom) (T.map q') := fun _ => rfl
  have hπ₁ : ∀ k, T.map (inc.map (c'.π.app k)) ≫ pullback.fst (Ds.map k.hom) (T.map q') =
      T.map q ≫ T.map (inc.map (c.π.app k.left)) := fun k =>
    (Category.assoc _ _ _).trans
      ((congrArg (hsq.flip.isoPullback.hom ≫ ·) (Scheme.baseChangeCone_π_fst _ _ _ _ k)).trans
        ((Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ T.map (inc.map (c.π.app k.left))) hsq.flip.isoPullback_hom_fst)))
  have hπ₂ : ∀ k, T.map (inc.map (c'.π.app k)) ≫ pullback.snd (Ds.map k.hom) (T.map q') =
      T.map g := fun k =>
    (Category.assoc _ _ _).trans
      ((congrArg (hsq.flip.isoPullback.hom ≫ ·) (Scheme.baseChangeCone_π_snd _ _ _ _ k)).trans
        hsq.flip.isoPullback_hom_snd)
  -- the object of `𝒴` at the first stage of the new system, and the identification there
  let o : Over i' := Over.mk (𝟙 i')
  let f₀ : inc.obj (D'.obj o) ⟶ inc.obj (D.obj i) := ρ o ≫ inc.map (D.map j)
  obtain ⟨y₀, φ₀, hφ₀⟩ := 𝒴.isStackInGroupoids.isFiberedInGroupoids.exists_lift f₀ y hy
  have hφ₀c : 𝒴.toBasedCategory.p.IsStronglyCartesian f₀ φ₀ :=
    𝒴.isStackInGroupoids.isFiberedInGroupoids.isStronglyCartesian_homLift _ φ₀
  have hy₀ : 𝒴.toBasedCategory.p.obj y₀ = inc.obj (D'.obj o) :=
    IsHomLift.domain_eq 𝒴.toBasedCategory.p f₀ φ₀
  have hfac : q ≫ inc.map (c.π.app i) = inc.map (c'.π.app o) ≫ f₀ := by
    refine T.map_injective ?_
    have e1 : T.map (q ≫ inc.map (c.π.app i)) =
        T.map q ≫ T.map (inc.map (c.π.app i' ≫ D.map j)) := by rw [c.w, Functor.map_comp]
    have e2 : T.map (inc.map (c'.π.app o) ≫ f₀) = (T.map (inc.map (c'.π.app o)) ≫
        pullback.fst (Ds.map o.hom) (T.map q')) ≫ T.map (inc.map (D.map j)) := by
      simp only [f₀, Functor.map_comp]
      rfl
    have e3 : T.map q ≫ T.map (inc.map (c.π.app i' ≫ D.map j)) =
        (T.map (inc.map (c'.π.app o)) ≫ pullback.fst (Ds.map o.hom) (T.map q')) ≫
          T.map (inc.map (D.map j)) := by
      rw [hπ₁ o]
      simp only [Functor.map_comp]
      rfl
    exact e1.trans (e3.trans e2.symm)
  obtain ⟨γ, hγl, hγfac⟩ :=
    exists_lift_comp_eq_of_isStronglyCartesian (R' := Z) 𝒴.toBasedCategory.p f₀ φ₀ _ _ hfac α
  have : 𝒴.toBasedCategory.p.IsHomLift (inc.map (c'.π.app o)) γ := hγl
  have hγc : 𝒴.toBasedCategory.p.IsStronglyCartesian (inc.map (c'.π.app o)) γ :=
    𝒴.isStackInGroupoids.isFiberedInGroupoids.isStronglyCartesian_homLift _ γ
  -- limit preservation on objects of `F` along the new system
  obtain ⟨k, a, x', xU, δ, β, γ', hδ, hβ, hβiso, hγ', hcomm⟩ :=
    hlim (Over i') D' c' hc' o ⟨y₀, hy₀⟩ ⟨x, hx⟩ γ hγc
  have hcomm' : F.map δ ≫ γ' = F.map β ≫ γ := hcomm
  have hka : a.left = k.hom := by simpa [o] using Over.w a
  refine ⟨k.left, k.hom ≫ j, inc.obj (D'.obj k), ρ k, ?_, inc.map (c'.π.app k), ?_, x'.1, x'.2,
    inv β ≫ δ, ?_, γ' ≫ φ₀, ?_, ?_⟩
  · have := hq'
    exact Stacks.Morphisms.IsFiniteLocallyFreeOfRank.of_isPullback
      (IsPullback.of_hasPullback (Ds.map k.hom) (T.map q')).flip
  · refine IsPullback.of_map_of_faithful T ?_
    have hout : IsPullback (T.map (inc.map (c'.π.app k)) ≫ pullback.snd (Ds.map k.hom) (T.map q'))
        (T.map q) (T.map q') (T.map (inc.map (c.π.app k.left)) ≫ Ds.map k.hom) := by
      rw [hπ₂]
      change IsPullback _ _ _ (T.map (inc.map (c.π.app k.left)) ≫ T.map (inc.map (D.map k.hom)))
      rw [← Functor.map_comp, ← Functor.map_comp, c.w]
      exact hsq
    refine IsPullback.of_right hout ?_ (IsPullback.of_hasPullback (Ds.map k.hom) (T.map q')).flip
    exact hπ₁ k
  · have : 𝒳.toBasedCategory.p.IsHomLift (𝟙 ((BigAffineFppf.inclusion B S hS).obj c'.pt)) β :=
      hβ
    have : 𝒳.toBasedCategory.p.IsHomLift (inc.map (c'.π.app k)) δ := hδ.toIsHomLift
    have h := IsHomLift.comp 𝒳.toBasedCategory.p
      (𝟙 ((BigAffineFppf.inclusion B S hS).obj c'.pt)) (inc.map (c'.π.app k)) (inv β) δ
    rwa [Category.id_comp] at h
  · have : 𝒴.toBasedCategory.p.IsHomLift (inc.map (D'.map a)) γ' := hγ'.toIsHomLift
    have heq : inc.map (D'.map a) ≫ f₀ = ρ k ≫ inc.map (D.map (k.hom ≫ j)) := by
      refine T.map_injective ?_
      simp only [f₀, Functor.map_comp, hρ]
      refine (Scheme.baseChangeDiagram_map_fst_assoc Ds i' (Over.mk (T.map q')) a
        (Ds.map j)).trans ?_
      rw [hka]
      rfl
    rw [← heq]
    exact IsHomLift.comp 𝒴.toBasedCategory.p _ _ γ' φ₀
  · rw [Functor.map_comp, Category.assoc, ← Category.assoc (F.map δ), hcomm',
      Category.assoc, hγfac, ← Category.assoc, ← Functor.map_comp, IsIso.inv_hom_id]
    simp

/-- **Spreading out an object of `ℋ_d(𝒳/𝒴)` over an affine limit.** This is the geometric
content of the proof of Stacks 06CH: a degree-`d` finite locally free cover `q : Z ⟶ U` of an
affine limit, an object `x` of `𝒳` over `Z` and an identification `α : F x ⟶ y` with an object `y`
of `𝒴` at the stage `i` are all defined at some later stage `i'`, as a degree-`d` finite locally
free cover `q' : Z' ⟶ U_{i'}` with base change `q`, an object `x'` of `𝒳` over `Z'` restricting to
`x`, and an identification `η` restricting to `α`. -/
private theorem exists_spreadOut
    (hlim : BigFppfOver.IsLimitPreservingOnObjects.{u, u, u} B S hS
      (CatFiberedInGroupoids.mk 𝒳.toBasedCategory 𝒳.isStackInGroupoids.isFiberedInGroupoids)
      (CatFiberedInGroupoids.mk 𝒴.toBasedCategory 𝒴.isStackInGroupoids.isFiberedInGroupoids)
      (Bicategory.InducedBicategory.mkHom F))
    {I : Type u} [Category.{u} I] [IsCofiltered I]
    (D : I ⥤ BigAffineFppf B S hS) (c : Cone D)
    (hc : IsLimit ((BigAffineFppf.toScheme B S hS).mapCone c)) (i : I)
    (Z : BigFppfOver B S hS) (q : Z ⟶ (BigAffineFppf.inclusion B S hS).obj c.pt)
    (hq : Stacks.Morphisms.IsFiniteLocallyFreeOfRank ((BigFppfOver.toScheme B S hS).map q) d)
    (x : 𝒳.toBasedCategory.obj) (hx : 𝒳.toBasedCategory.p.obj x = Z)
    (y : 𝒴.toBasedCategory.obj)
    (hy : 𝒴.toBasedCategory.p.obj y = (BigAffineFppf.inclusion B S hS).obj (D.obj i))
    (α : F.obj x ⟶ y)
    (hα : 𝒴.toBasedCategory.p.IsHomLift
      (q ≫ (BigAffineFppf.inclusion B S hS).map (c.π.app i)) α) :
    ∃ (i' : I) (j : i' ⟶ i) (Z' : BigFppfOver B S hS)
      (q' : Z' ⟶ (BigAffineFppf.inclusion B S hS).obj (D.obj i')),
      Stacks.Morphisms.IsFiniteLocallyFreeOfRank ((BigFppfOver.toScheme B S hS).map q') d ∧
        ∃ g : Z ⟶ Z',
          IsPullback g q q' ((BigAffineFppf.inclusion B S hS).map (c.π.app i')) ∧
            ∃ (x' : 𝒳.toBasedCategory.obj) (_ : 𝒳.toBasedCategory.p.obj x' = Z')
              (a : x ⟶ x'), 𝒳.toBasedCategory.p.IsHomLift g a ∧
              ∃ η : F.obj x' ⟶ y,
                𝒴.toBasedCategory.p.IsHomLift
                    (q' ≫ (BigAffineFppf.inclusion B S hS).map (D.map j)) η ∧
                  F.map a ≫ η = α := by
  obtain ⟨i', j, Z', q', hq', g, hsq⟩ := exists_cover_spreadOut B S hS d D c hc i Z q hq
  exact exists_object_spreadOut B S hS 𝒳 𝒴 F d hlim D c hc i Z q i' j Z' q' hq' g hsq x hx y hy
    α hα

/-- Every morphism of the relative finite Hilbert category is strongly cartesian over the
morphism of base objects that it lies over, because that category is fibred in groupoids. -/
private theorem isStronglyCartesian_finiteHilbertHom
    {P Q : FiniteHilbert.Object B S hS 𝒳 𝒴 F d} (φ : P ⟶ Q)
    {V U : BigFppfOver B S hS} (f : V ⟶ U) (hV : P.U = V) (hU : Q.U = U)
    (hf : φ.f ≫ eqToHom hU = eqToHom hV ≫ f) :
    (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)).IsStronglyCartesian f φ :=
  have : (finiteHilbertProjection (B := B) (S := S) (hS := hS)
      (𝒳 := 𝒳) (𝒴 := 𝒴) (F := F) (d := d)).IsHomLift f φ :=
    IsHomLift.of_commsq _ f φ hV hU hf
  isFiberedInGroupoids_finiteHilbertProjection.isStronglyCartesian_homLift f φ

/-- Transport of a pullback square along an equality of one of its corners. -/
private theorem isPullback_comp_eqToHom_iff {C : Type*} [Category C] {W X Y Y' Z : C}
    (h : Y = Y') (fst : W ⟶ X) (snd : W ⟶ Y) (f : X ⟶ Z) (g : Y' ⟶ Z) :
    IsPullback fst (snd ≫ eqToHom h) f g ↔ IsPullback fst snd f (eqToHom h ≫ g) := by
  cases h
  simp

/-- **Stacks 06CH.** Let `F : 𝒳 ⟶ 𝒴` be a 1-morphism of stacks in groupoids over the big fppf
site of `S` which is representable by algebraic spaces (Stacks 02ZW) and locally of finite
presentation (every algebraic space representing a base change of `F` along a scheme-valued
point of `𝒴` has locally finitely presented structural morphism, Stacks 03YK). Then
`p : ℋ_d(𝒳/𝒴) ⟶ 𝒴` is limit preserving on objects (Stacks 06CU).

The affine limits `U = lim U_i` of Stacks 06CU are indexed, as in the source, by a set: the
index category lies in the universe of the schemes.

Given an object `Ξ = (U, Z, y, x, α)` of `ℋ_d(𝒳/𝒴)` over the limit and a comparison of `y` with
an object `y_i` of `𝒴` at the stage `i`, the cover `Z`, the object `x` and the identification `α`
composed with that comparison spread out to a cover `Z_{i'}`, an object `x_{i'}` and an
identification `η` at a later stage `i'` (Stacks 01ZM and the degree-`d` form of Stacks 06AC for
the cover, Stacks 06CX for the object and the identification). Lift `y_i`
along `U_{i'} ⟶ U_i` to `y_{i'}`; the lift is strongly cartesian, so `η` factors uniquely
through it, giving the identification `α_{i'}` of `Ξ_{i'}`, and the comparison factors uniquely
through it, giving the morphism of objects of `𝒴` of the morphism `Ξ ⟶ Ξ_{i'}`. The remaining
fields of that morphism are the spread-out data, and its compatibility condition holds because
both of its sides factor the same morphism through the lift. -/
@[stacks 06CH "p : ℋ_d(𝒳/𝒴) ⟶ 𝒴 is limit preserving on objects"]
theorem isLimitPreservingOnObjects_finiteHilbertToTargetCFG
    (hFrep : IsRepresentableByAlgebraicSpaces B S hS F)
    (hFlfp : ∀ (U : BigFppfOver B S hS)
      (y : BigFppfOver B U.left.1 U.left.2 ⥤ 𝒴.toBasedCategory.obj),
      y ⋙ 𝒴.toBasedCategory.p = Over.map U.hom →
      ∀ (P : (BigFppfOver B U.left.1 U.left.2)ᵒᵖ ⥤ Type u)
        (hP : IsAlgebraicSpace B U.left.1 U.left.2 P),
        Nonempty (StacksRepresentableCFG.EquivalenceOver
          (TwoFibreProductOver.fst (Over.map U.hom) 𝒳.toBasedCategory.p 𝒴.toBasedCategory.p y
            F.toFunctor) (presheafOfCategories (P ⋙ typeToCat)).p) →
        Space.IsLocallyOfFinitePresentation B S hS (algebraicSpaceMap B S hS U
          ((spacesOverSmallerBaseFunctor B U.left.1 S U.left.2 hS U.hom).obj ⟨P, hP⟩)).hom) :
    BigFppfOver.IsLimitPreservingOnObjects.{u, u, u} B S hS
      (finiteHilbertCFG.{u, v, w, ws} B S hS 𝒳 𝒴 F d)
      (CatFiberedInGroupoids.mk 𝒴.toBasedCategory
        𝒴.isStackInGroupoids.isFiberedInGroupoids)
      (finiteHilbertToTargetCFG.{u, v, w, ws} B S hS 𝒳 𝒴 F d) := by
  have hlim : BigFppfOver.IsLimitPreservingOnObjects.{u, u, u} B S hS
      (CatFiberedInGroupoids.mk 𝒳.toBasedCategory 𝒳.isStackInGroupoids.isFiberedInGroupoids)
      (CatFiberedInGroupoids.mk 𝒴.toBasedCategory 𝒴.isStackInGroupoids.isFiberedInGroupoids)
      (Bicategory.InducedBicategory.mkHom F) :=
    (isLimitPreservingOnObjects_iff_isLocallyOfFinitePresentation B S hS
      (CatFiberedInGroupoids.mk 𝒳.toBasedCategory 𝒳.isStackInGroupoids.isFiberedInGroupoids)
      (CatFiberedInGroupoids.mk 𝒴.toBasedCategory 𝒴.isStackInGroupoids.isFiberedInGroupoids)
      (Bicategory.InducedBicategory.mkHom F) hFrep).mpr hFlfp
  intro I _ _ D c hc i y P γ hγ
  obtain ⟨γ, rfl⟩ : ∃ γ' : P.1.y ⟶ y.1, γ' = γ := ⟨γ, rfl⟩
  -- the cover of `Ξ`, transported to a morphism whose target is the limit object
  have hP : P.1.U = (BigAffineFppf.inclusion B S hS).obj c.pt := P.2
  have hq : Stacks.Morphisms.IsFiniteLocallyFreeOfRank
      ((BigFppfOver.toScheme B S hS).map (P.1.q ≫ eqToHom hP)) d := by
    have hPq := P.1.finiteLocallyFree
    rw [Functor.map_comp, eqToHom_map]
    exact Stacks.Morphisms.isFiniteLocallyFreeOfRank_postcomp
      (eqToIso (congrArg (BigFppfOver.toScheme B S hS).obj hP)) _ hPq
  -- the identification of `Ξ` composed with the given comparison
  have hγl : 𝒴.toBasedCategory.p.IsHomLift
      ((BigAffineFppf.inclusion B S hS).map (c.π.app i)) γ := hγ.toIsHomLift
  have hαl : 𝒴.toBasedCategory.p.IsHomLift
      ((P.1.q ≫ eqToHom hP) ≫ (BigAffineFppf.inclusion B S hS).map (c.π.app i))
      (P.1.α ≫ γ) := by
    have h₁ : 𝒴.toBasedCategory.p.IsHomLift P.1.q P.1.α := P.1.α_over
    simpa only [Category.assoc] using
      IsHomLift.comp 𝒴.toBasedCategory.p P.1.q
        (eqToHom hP ≫ (BigAffineFppf.inclusion B S hS).map (c.π.app i)) P.1.α
        γ
  obtain ⟨i', j, Z', q', hq', g, hsq, x', hx', a, ha, η, hη, hcompat⟩ :=
    exists_spreadOut B S hS 𝒳 𝒴 F d hlim D c hc i P.1.Z (P.1.q ≫ eqToHom hP) hq P.1.x
      P.1.x_over y.1 y.2 (P.1.α ≫ γ) hαl
  -- lift `y` to the stage `i'`; the lift is strongly cartesian
  obtain ⟨yQ, γ', hγ'⟩ :=
    𝒴.isStackInGroupoids.isFiberedInGroupoids.exists_lift
      ((BigAffineFppf.inclusion B S hS).map (D.map j)) y.1 y.2
  have hγ'sc : 𝒴.toBasedCategory.p.IsStronglyCartesian
      ((BigAffineFppf.inclusion B S hS).map (D.map j)) γ' :=
    𝒴.isStackInGroupoids.isFiberedInGroupoids.isStronglyCartesian_homLift _ γ'
  -- the identification of the new object: factor `η` through the lift
  obtain ⟨αQ, hαQl, hαQfac⟩ :=
    exists_lift_comp_eq_of_isStronglyCartesian 𝒴.toBasedCategory.p
      ((BigAffineFppf.inclusion B S hS).map (D.map j)) γ' q' _ rfl η
  -- the morphism of objects of `𝒴`: factor the given comparison through the lift
  have hfb : eqToHom hP ≫ (BigAffineFppf.inclusion B S hS).map (c.π.app i) =
      (eqToHom hP ≫ (BigAffineFppf.inclusion B S hS).map (c.π.app i')) ≫
        (BigAffineFppf.inclusion B S hS).map (D.map j) := by
    rw [Category.assoc, ← Functor.map_comp, c.w j]
  obtain ⟨b, hbl, hbfac⟩ :=
    exists_lift_comp_eq_of_isStronglyCartesian 𝒴.toBasedCategory.p
      ((BigAffineFppf.inclusion B S hS).map (D.map j)) γ' _ _ hfb γ
  -- the spread-out square, transported back to the base object of `Ξ`
  have hsq' : IsPullback g P.1.q q'
      (eqToHom hP ≫ (BigAffineFppf.inclusion B S hS).map (c.π.app i')) :=
    (isPullback_comp_eqToHom_iff hP g P.1.q q'
      ((BigAffineFppf.inclusion B S hS).map (c.π.app i'))).mp hsq
  -- compatibility of the two identifications
  have hFa : 𝒴.toBasedCategory.p.IsHomLift g (F.map a) :=
    BasedFunctor.preserves_isHomLift F g a
  have hleft : 𝒴.toBasedCategory.p.IsHomLift (g ≫ q') (F.map a ≫ αQ) :=
    IsHomLift.comp 𝒴.toBasedCategory.p g q' (F.map a) _
  have hright : 𝒴.toBasedCategory.p.IsHomLift (g ≫ q') (P.1.α ≫ b) := by
    have h₁ : 𝒴.toBasedCategory.p.IsHomLift P.1.q P.1.α := P.1.α_over
    rw [hsq'.w]
    exact IsHomLift.comp 𝒴.toBasedCategory.p P.1.q _ P.1.α _
  have hcomp : F.map a ≫ αQ = P.1.α ≫ b := by
    refine Functor.IsStronglyCartesian.ext 𝒴.toBasedCategory.p
      ((BigAffineFppf.inclusion B S hS).map (D.map j)) γ' (g ≫ q') ?_
    rw [Category.assoc, Category.assoc, hαQfac, hbfac, hcompat]
  -- the new object, the morphism to it, and the comparison square
  refine ⟨i', j,
    ⟨{ U := (BigAffineFppf.inclusion B S hS).obj (D.obj i')
       Z := Z'
       q := q'
       finiteLocallyFree := hq'
       y := yQ
       x := x'
       x_over := hx'
       α := αQ
       α_over := hαQl
       y_over := IsHomLift.domain_eq 𝒴.toBasedCategory.p
         ((BigAffineFppf.inclusion B S hS).map (D.map j)) γ' }, rfl⟩,
    P,
    { f := eqToHom hP ≫ (BigAffineFppf.inclusion B S hS).map (c.π.app i')
      g := g
      square := hsq'
      b := b
      b_over := hbl
      a := a
      a_over := ha
      compatible := hcomp },
    𝟙 P.1, γ', ?_, IsHomLift.id P.2, inferInstance, hγ'sc, ?_⟩
  · exact isStronglyCartesian_finiteHilbertHom B S hS 𝒳 𝒴 F d _
      ((BigAffineFppf.inclusion B S hS).map (c.π.app i')) hP rfl (by simp)
  · exact (Category.id_comp γ).symm ▸ hbfac

