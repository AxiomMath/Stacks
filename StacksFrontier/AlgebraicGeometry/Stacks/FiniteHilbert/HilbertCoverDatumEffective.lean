module

public import StacksFrontier.AlgebraicGeometry.Descent.FamilyEffectivityLargeIndex
public import StacksFrontier.AlgebraicGeometry.Stacks.FiniteHilbert.HilbertCoverDatumRealization
public import StacksFrontier.AlgebraicGeometry.Stacks.FiniteHilbert.HilbertCoverDatumScheme
public import StacksFrontier.CategoryTheory.Sites.Stack.StackBridge.ReverseEffective
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Effective descent in `ℋ_d` along a flat covering family

A descent datum of the category `ℋ_d` of degree-`d` finite locally free covers relative to the
sieve generated by a family `g i : X i ⟶ T` of the big fppf site of `S` is *effective* when it
comes from a single cover of `T`. This file proves that it is, as soon as the underlying family
of morphisms of schemes is a jointly surjective family of flat morphisms locally of finite
presentation — no affineness of the sources, and at an arbitrary index universe.

## Main definitions

* `AlgebraicGeometry.Stack.datumSchemeDescentData`: the descent datum of schemes carried by a
  descent datum of `ℋ_d`.
* `AlgebraicGeometry.Stack.fiberHomOfIsPullback`: a cartesian square exhibiting the cover of an
  object of a fibre of `ℋ_d` as a base change, read as a morphism of `ℋ_d`.

## Main results

* `AlgebraicGeometry.Stack.fibreAct_datumSchemeGluing`: the action of the gluing data of schemes,
  at a generalized point coming from the site, is the datum's gluing isomorphism.
* `AlgebraicGeometry.Stack.fibreCocycle_datumSchemeGluing`: the cocycle condition of the gluing
  data of schemes carried by the datum.
* `AlgebraicGeometry.Stack.exists_descendedCover_compat`: **the descended cover**, together with
  its compatibility with every gluing isomorphism of the datum.
* `AlgebraicGeometry.Stack.exists_descent_of_arrow`: the cover attached to an arbitrary arrow of
  the sieve is a base change of the descended cover.
* `AlgebraicGeometry.Stack.isEffective_of_isPullback_of_compat`: a datum whose covers descend is
  effective.
* `AlgebraicGeometry.Stack.isEffective_of_flat_of_locallyOfFinitePresentation`: **effectivity
  along a jointly surjective flat family locally of finite presentation.**

## References

* [Stacks Project, Tag 0245](https://stacks.math.columbia.edu/tag/0245)
* [Stacks Project, Tag 026B](https://stacks.math.columbia.edu/tag/026B)
* [Stacks Project, Tag 026F](https://stacks.math.columbia.edu/tag/026F)
* [Stacks Project, Tag 05YQ](https://stacks.math.columbia.edu/tag/05YQ)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u v

namespace AlgebraicGeometry.Stack

attribute [local implicit_reducible] finiteCoverPointObj finiteCoverProjection
  CategoryTheory.Functor.Fiber CategoryTheory.Functor.Fiber.fiberInclusion

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {d : ℕ}
  {T : BigFppfOver B S hS} {ι : Type v} {X : ι → BigFppfOver B S hS} {g : ∀ i, X i ⟶ T}
  (D : (finiteCoverProjection (B := B) (S := S) (hS := hS) (d := d)).SieveDescentDatum
    (Sieve.ofArrows X g))

/-- The canonical functor to schemes carries the equation `a ≫ fiberCoverHom _ ≫ g i = b ≫ g j`,
for a point `a` of the cover attached to the `i`-th member of the generating family and a point
`b` of the `j`-th source, to the corresponding equation of morphisms of schemes. -/
theorem toScheme_comp_fiberCoverHom_comp {i j : ι} {Q : BigFppfOver B S hS}
    (a : Q ⟶ (D.obj (g i) (Sieve.ofArrows_mk X g i)).1.Z) (b : Q ⟶ X j)
    (hab : a ≫ fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)) ≫ g i = b ≫ g j) :
    (BigFppfOver.toScheme B S hS).map a ≫
        (BigFppfOver.toScheme B S hS).map
          (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ≫
          (BigFppfOver.toScheme B S hS).map (g i) =
      (BigFppfOver.toScheme B S hS).map b ≫ (BigFppfOver.toScheme B S hS).map (g j) := by
  rw [← (BigFppfOver.toScheme B S hS).map_comp, ← (BigFppfOver.toScheme B S hS).map_comp,
    ← (BigFppfOver.toScheme B S hS).map_comp, hab]

/-- A section `σ` of the second projection of a fibre product has first projection lying over
the second leg. -/
private theorem section_fst_comp_eq {C : Type*} [Category C] {A B P : C} (c : A ⟶ B)
    (a : P ⟶ B) [HasPullback c a] (σ : P ⟶ pullback c a) (hσ : σ ≫ pullback.snd c a = 𝟙 P) :
    (σ ≫ pullback.fst c a) ≫ c = a := by
  rw [Category.assoc, pullback.condition, ← Category.assoc, hσ, Category.id_comp]

/-- A morphism `p` with `p ≫ c = a` gives a section of the second projection of `pullback c a`. -/
private theorem exists_section_of_comp_eq {C : Type*} [Category C] {A B Q : C} (c : A ⟶ B)
    (a : Q ⟶ B) (p : Q ⟶ A) (h : p ≫ c = a) [HasPullback c a] :
    ∃ σ : Q ⟶ pullback c a, σ ≫ pullback.fst c a = p ∧ σ ≫ pullback.snd c a = 𝟙 Q :=
  ⟨pullback.lift p (𝟙 Q) (by rw [h, Category.id_comp]), pullback.lift_fst _ _ _,
    pullback.lift_snd _ _ _⟩

/-- If `a = γ ≫ b`, there is a comparison morphism `pullback c a ⟶ pullback c b`. -/
private theorem exists_pullback_hom_of_eq_comp {C : Type*} [Category C] {A B P Q : C}
    (c : A ⟶ B) (a : P ⟶ B) (b : Q ⟶ B) (γ : P ⟶ Q) (h : a = γ ≫ b) [HasPullback c a]
    [HasPullback c b] :
    ∃ μ : pullback c a ⟶ pullback c b, μ ≫ pullback.fst c b = pullback.fst c a ∧
      μ ≫ pullback.snd c b = pullback.snd c a ≫ γ :=
  ⟨pullback.lift _ _ (by rw [Category.assoc, ← h]; exact pullback.condition),
    pullback.lift_fst _ _ _, pullback.lift_snd _ _ _⟩

/-- A section of the cover attached to `g i` over `α` gives the equation of morphisms of schemes
of `toScheme_comp_fiberCoverHom_comp`. -/
private theorem toScheme_section_comp {i j : ι} {Q : BigFppfOver B S hS} {α : Q ⟶ X i}
    {β : Q ⟶ X j} (hαβ : α ≫ g i = β ≫ g j)
    (σ : Q ⟶ pullback (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α)
    (hσ : σ ≫ pullback.snd (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α = 𝟙 Q) :
    (BigFppfOver.toScheme B S hS).map
        (σ ≫ pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α) ≫
      (BigFppfOver.toScheme B S hS).map
        (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ≫
        (BigFppfOver.toScheme B S hS).map (g i) =
      (BigFppfOver.toScheme B S hS).map β ≫ (BigFppfOver.toScheme B S hS).map (g j) :=
  toScheme_comp_fiberCoverHom_comp D
    (σ ≫ pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α) β
    (by rw [← Category.assoc, section_fst_comp_eq _ _ σ hσ, hαβ])

/-- A morphism in the sieve generated by the family factors through a member of the family. -/
private theorem exists_comp_eq_of_arrows {V : BigFppfOver B S hS} {f : V ⟶ T}
    (hf : (Sieve.ofArrows X g).arrows f) : ∃ (i : ι) (κ : V ⟶ X i), κ ≫ g i = f := by
  obtain ⟨i, κ, hfe⟩ := Sieve.ofArrows.exists hf
  exact ⟨i, κ, hfe.symm⟩

/-- **The action of the gluing data of schemes, at a generalized point coming from the site.**
A point of the fibre product `Z i ×_T X j` which comes from an object `Q` of the site — a
morphism `σ` into the fibre-product cover `Z i ×_{X i} Q` splitting its structure morphism,
together with the second component `β : Q ⟶ X j` — is acted on by the gluing isomorphism of the
datum at the pair `(α, β)`, where `α` is the first component. -/
theorem fibreAct_datumSchemeGluing (i j : ι) {Q : BigFppfOver B S hS}
    (α : Q ⟶ X i) (β : Q ⟶ X j) (hαβ : α ≫ g i = β ≫ g j)
    (σ : Q ⟶ pullback (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α)
    (hσ : σ ≫ pullback.snd (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α = 𝟙 Q)
    (h : (BigFppfOver.toScheme B S hS).map
            (σ ≫ pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α) ≫
          (BigFppfOver.toScheme B S hS).map
            (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ≫
            (BigFppfOver.toScheme B S hS).map (g i) =
        (BigFppfOver.toScheme B S hS).map β ≫ (BigFppfOver.toScheme B S hS).map (g j)) :
    DescentData.fibreAct (fun i ↦ (BigFppfOver.toScheme B S hS).map (g i))
        (fun i ↦ Over.mk ((BigFppfOver.toScheme B S hS).map
          (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)))))
        (fun i j ↦ (datumSchemeGluing D i j).hom) i j
        ((BigFppfOver.toScheme B S hS).map
          (σ ≫ pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α))
        ((BigFppfOver.toScheme B S hS).map β) h =
      (BigFppfOver.toScheme B S hS).map (σ ≫
        (datumGluing D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g j) α β hαβ).hom ≫
        pullback.fst (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) β) := by
  obtain ⟨γ, hγ₁, hγ₂⟩ : ∃ γ : Q ⟶ pullback (g i) (g j),
      γ ≫ pullback.fst (g i) (g j) = α ∧ γ ≫ pullback.snd (g i) (g j) = β :=
    ⟨pullback.lift α β hαβ, pullback.lift_fst _ _ _, pullback.lift_snd _ _ _⟩
  obtain ⟨μ, hμ₁, hμ₂⟩ := exists_pullback_hom_of_eq_comp
    (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α (pullback.fst (g i) (g j)) γ
    hγ₁.symm
  have key : (datumSchemeGluing D i j).hom ≫
        pullback.snd ((BigFppfOver.toScheme B S hS).map (g i))
          ((BigFppfOver.toScheme B S hS).map
              (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) ≫
            (BigFppfOver.toScheme B S hS).map (g j)) =
      (isPullback_datumCoverSource D i j).isoPullback.inv ≫
        (BigFppfOver.toScheme B S hS).map (datumGluing D (Sieve.ofArrows_mk X g i)
            (Sieve.ofArrows_mk X g j) (pullback.fst (g i) (g j)) (pullback.snd (g i) (g j))
            pullback.condition).hom ≫
          (BigFppfOver.toScheme B S hS).map (pullback.fst
            (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j)))
            (pullback.snd (g i) (g j))) := by
    simp only [datumSchemeGluing, Iso.trans_hom, Iso.symm_hom, Functor.mapIso_hom, Category.assoc,
      IsPullback.isoPullback_hom_snd]
  have hlift : pullback.lift ((BigFppfOver.toScheme B S hS).map
          (σ ≫ pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α))
        ((BigFppfOver.toScheme B S hS).map β) h ≫
        (isPullback_datumCoverSource D i j).isoPullback.inv =
      (BigFppfOver.toScheme B S hS).map (σ ≫ μ) := by
    have hA : (σ ≫ μ) ≫ pullback.snd (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)))
          (pullback.fst (g i) (g j)) = γ := by
      rw [Category.assoc, hμ₂, ← Category.assoc, hσ, Category.id_comp]
    rw [Iso.comp_inv_eq]
    refine pullback.hom_ext ?_ ?_
    · rw [pullback.lift_fst, Category.assoc,
        (isPullback_datumCoverSource D i j).isoPullback_hom_fst,
        ← (BigFppfOver.toScheme B S hS).map_comp, Category.assoc, hμ₁]
    · rw [pullback.lift_snd, Category.assoc,
        (isPullback_datumCoverSource D i j).isoPullback_hom_snd,
        ← Category.assoc, ← (BigFppfOver.toScheme B S hS).map_comp,
        ← (BigFppfOver.toScheme B S hS).map_comp]
      refine congrArg (BigFppfOver.toScheme B S hS).map ?_
      rw [hA, hγ₂]
  rw [DescentData.fibreAct]
  simp only [Over.mk_hom]
  rw [key, ← Category.assoc, hlift,
    datumGluing_comp_fst_of_fac D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g j)
      (pullback.fst (g i) (g j)) (pullback.snd (g i) (g j)) pullback.condition γ α β hαβ
      hγ₁ hγ₂ μ hμ₁ hμ₂]
  simp only [(BigFppfOver.toScheme B S hS).map_comp, Category.assoc]

/-- **The cocycle condition of the gluing data of schemes carried by a descent datum of `ℋ_d`**,
at generalized points over an arbitrary scheme. -/
theorem fibreCocycle_datumSchemeGluing :
    DescentData.FibreCocycle (fun i ↦ (BigFppfOver.toScheme B S hS).map (g i))
      (fun i ↦ Over.mk ((BigFppfOver.toScheme B S hS).map
        (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)))))
      (fun i j ↦ (datumSchemeGluing D i j).hom) := by
  have hcongr := DescentData.fibreAct_congr (fun i ↦ (BigFppfOver.toScheme B S hS).map (g i))
    (fun i ↦ Over.mk ((BigFppfOver.toScheme B S hS).map
      (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)))))
    (fun i j ↦ (datumSchemeGluing D i j).hom)
  have hcomp := DescentData.comp_fibreAct (fun i ↦ (BigFppfOver.toScheme B S hS).map (g i))
    (fun i ↦ Over.mk ((BigFppfOver.toScheme B S hS).map
      (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)))))
    (fun i j ↦ (datumSchemeGluing D i j).hom)
  intro i j k Z v x y hv hw hvx
  obtain ⟨P, p₁, p₂, hP⟩ : ∃ (P : BigFppfOver B S hS)
      (p₁ : P ⟶ (D.obj (g i) (Sieve.ofArrows_mk X g i)).1.Z) (p₂ : P ⟶ X j),
      IsPullback p₁ p₂ (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)) ≫ g i) (g j) :=
    ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  obtain ⟨Q, q₁, q₂, hQ⟩ : ∃ (Q : BigFppfOver B S hS) (q₁ : Q ⟶ P) (q₂ : Q ⟶ X k),
      IsPullback q₁ q₂ (p₂ ≫ g j) (g k) := ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  obtain ⟨α, hα⟩ : ∃ α : Q ⟶ X i,
      α = q₁ ≫ p₁ ≫ fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)) := ⟨_, rfl⟩
  obtain ⟨β, hβ⟩ : ∃ β : Q ⟶ X j, β = q₁ ≫ p₂ := ⟨_, rfl⟩
  have hαβ : α ≫ g i = β ≫ g j := by
    rw [hα, hβ, Category.assoc, Category.assoc, hP.w, Category.assoc]
  have hβδ : β ≫ g j = q₂ ≫ g k := by
    rw [hβ, Category.assoc]; exact hQ.w
  obtain ⟨si, hsi₁, hsi₂⟩ := exists_section_of_comp_eq
    (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α (q₁ ≫ p₁) (by rw [hα, Category.assoc])
  obtain ⟨sj, hsj⟩ : ∃ sj : Q ⟶
        pullback (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) β,
      sj = si ≫ (datumGluing D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g j)
        α β hαβ).hom := ⟨_, rfl⟩
  have hsj₂ : sj ≫ pullback.snd (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) β =
      𝟙 Q := by rw [hsj, Category.assoc, datumGluing_hom_comp_snd, hsi₂]
  have hsjf : si ≫ (datumGluing D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g j)
        α β hαβ).hom ≫
        pullback.fst (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) β =
      sj ≫ pullback.fst (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) β := by
    rw [hsj, Category.assoc]
  have hu1 := toScheme_section_comp D hαβ si hsi₂
  have hu2 := toScheme_section_comp D hβδ sj hsj₂
  have hu3 := toScheme_section_comp D (hαβ.trans hβδ) si hsi₂
  have hA := (fibreAct_datumSchemeGluing D i j α β hαβ si hsi₂ hu1).trans
    (congrArg (BigFppfOver.toScheme B S hS).map hsjf)
  have hB := fibreAct_datumSchemeGluing D j k β q₂ hβδ sj hsj₂ hu2
  have hC := fibreAct_datumSchemeGluing D i k α q₂ (hαβ.trans hβδ) si hsi₂ hu3
  have hEq : sj ≫ (datumGluing D (Sieve.ofArrows_mk X g j) (Sieve.ofArrows_mk X g k)
          β q₂ hβδ).hom ≫
        pullback.fst (fiberCoverHom (D.obj (g k) (Sieve.ofArrows_mk X g k))) q₂ =
      si ≫ (datumGluing D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g k) α q₂
          (hαβ.trans hβδ)).hom ≫
        pullback.fst (fiberCoverHom (D.obj (g k) (Sieve.ofArrows_mk X g k))) q₂ := by
    rw [hsj, ← datumGluing_trans D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g j)
      (Sieve.ofArrows_mk X g k) α β q₂ hαβ hβδ (hαβ.trans hβδ)]
    simp only [Category.assoc]
  have hu2' := hu2
  rw [← hA] at hu2'
  have huniv := ((hcongr j k hA rfl hu2' hu2).trans hB).trans
    ((congrArg (BigFppfOver.toScheme B S hS).map hEq).trans hC.symm)
  obtain ⟨m, hm₁, hm₂⟩ : ∃ m : Z ⟶ (BigFppfOver.toScheme B S hS).obj P,
      m ≫ (BigFppfOver.toScheme B S hS).map p₁ = v ∧
        m ≫ (BigFppfOver.toScheme B S hS).map p₂ = x :=
    ⟨(hP.map (BigFppfOver.toScheme B S hS)).lift v x (by
        rw [(BigFppfOver.toScheme B S hS).map_comp]; exact hv),
      IsPullback.lift_fst _ _ _ _, IsPullback.lift_snd _ _ _ _⟩
  obtain ⟨n, hn₁, hn₂⟩ : ∃ n : Z ⟶ (BigFppfOver.toScheme B S hS).obj Q,
      n ≫ (BigFppfOver.toScheme B S hS).map q₁ = m ∧
        n ≫ (BigFppfOver.toScheme B S hS).map q₂ = y :=
    ⟨(hQ.map (BigFppfOver.toScheme B S hS)).lift m y (by
        rw [(BigFppfOver.toScheme B S hS).map_comp, ← Category.assoc, hm₂]; exact hw),
      IsPullback.lift_fst _ _ _ _, IsPullback.lift_snd _ _ _ _⟩
  have hk1 : n ≫ (BigFppfOver.toScheme B S hS).map (si ≫
      pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α) = v := by
    rw [hsi₁, (BigFppfOver.toScheme B S hS).map_comp, ← Category.assoc, hn₁, hm₁]
  have hk2 : n ≫ (BigFppfOver.toScheme B S hS).map β = x := by
    rw [hβ, (BigFppfOver.toScheme B S hS).map_comp, ← Category.assoc, hn₁, hm₂]
  have hsidev : (n ≫ (BigFppfOver.toScheme B S hS).map (si ≫
          pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α)) ≫
        (BigFppfOver.toScheme B S hS).map
          (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ≫
          (BigFppfOver.toScheme B S hS).map (g i) =
      (n ≫ (BigFppfOver.toScheme B S hS).map β) ≫
        (BigFppfOver.toScheme B S hS).map (g j) := by
    rw [hk1, hk2]; exact hv
  have hstep := (hcomp i j n _ _ hu1 hsidev).trans (hcongr i j hk1 hk2 hsidev hv)
  have hside2 : (n ≫ (BigFppfOver.toScheme B S hS).map (si ≫
          pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α)) ≫
        (BigFppfOver.toScheme B S hS).map
          (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ≫
          (BigFppfOver.toScheme B S hS).map (g i) =
      (n ≫ (BigFppfOver.toScheme B S hS).map q₂) ≫
        (BigFppfOver.toScheme B S hS).map (g k) := by
    rw [hk1, hn₂]; exact hv.trans hw
  have hside := hvx
  rw [← hstep, ← hn₂] at hside
  refine Eq.trans (hcongr j k hstep.symm hn₂.symm hvx hside) ?_
  refine Eq.trans (hcomp j k n _ _ hu2' hside).symm ?_
  refine Eq.trans (congrArg (fun m ↦ n ≫ m) huniv) ?_
  refine Eq.trans (hcomp i k n _ _ hu3 hside2) ?_
  exact hcongr i k hk1 hn₂ hside2 (hv.trans hw)

/-! ### The descended cover -/

/-- **The descent datum of schemes carried by a descent datum of `ℋ_d`.** Its component at `i` is
the underlying scheme of the cover the datum attaches to the `i`-th member of the generating
family, and its gluing isomorphisms are `AlgebraicGeometry.Stack.datumSchemeGluing`. -/
def datumSchemeDescentData : DescentData (fun i ↦ (BigFppfOver.toScheme B S hS).map (g i)) :=
  DescentData.ofFibreGluing (fun i ↦ (BigFppfOver.toScheme B S hS).map (g i))
    (fun i ↦ Over.mk ((BigFppfOver.toScheme B S hS).map
      (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)))))
    (fun i j ↦ datumSchemeGluing D i j)
    (fun i j ↦ datumSchemeGluing_hom_comp_fst D i j)
    (fun i j ↦ datumSchemeGluing_hom_comp_snd D i j)
    (fibreCocycle_datumSchemeGluing D)

attribute [local implicit_reducible] datumSchemeDescentData DescentData.ofFibreGluing

/-- The component of `datumSchemeDescentData D` at `i` is the cover attached to `g i`. -/
@[simp]
theorem datumSchemeDescentData_obj (i : ι) :
    (datumSchemeDescentData D).obj i = Over.mk ((BigFppfOver.toScheme B S hS).map
      (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)))) := rfl

/-- The gluing isomorphisms of `datumSchemeDescentData D` are those of `datumSchemeGluing D`. -/
@[simp]
theorem datumSchemeDescentData_gluingPullbackIso_hom (i j : ι) :
    ((datumSchemeDescentData D).gluingPullbackIso i j).hom = (datumSchemeGluing D i j).hom :=
  DescentData.ofFibreGluing_gluingPullbackIso_hom _ _ _ _ _ _ i j

/-- **The descent datum of schemes carried by a descent datum of `ℋ_d` is effective** when the
underlying family of morphisms of schemes is an fpqc covering. -/
theorem isFamilyEffective_datumSchemeDescentData
    (hcov : Presieve.ofArrows (fun i ↦ (BigFppfOver.toScheme B S hS).obj (X i))
      (fun i ↦ (BigFppfOver.toScheme B S hS).map (g i)) ∈
        Scheme.fpqcPrecoverage ((BigFppfOver.toScheme B S hS).obj T)) :
    (datumSchemeDescentData D).IsFamilyEffective :=
  DescentData.isFamilyEffective_of_isAffineHom_of_anyIndex _ hcov (datumSchemeDescentData D)
    fun i ↦ (isFiniteLocallyFreeOfRank_fiberCoverHom
      (D.obj (g i) (Sieve.ofArrows_mk X g i))).toIsAffineHom

/-- **The cover of the base of the sieve descended from a descent datum of `ℋ_d`.** When the
underlying family of morphisms of schemes is an fpqc covering, there are a degree-`d` cover
`w : W ⟶ T` and morphisms `ν i` exhibiting the cover attached to `g i` as the base change of `w`
along `g i`, compatibly with *every* gluing isomorphism of the datum. -/
@[sga "3 X 5.4" "special case"]
theorem exists_descendedCover_compat
    (hcov : Presieve.ofArrows (fun i ↦ (BigFppfOver.toScheme B S hS).obj (X i))
      (fun i ↦ (BigFppfOver.toScheme B S hS).map (g i)) ∈
        Scheme.fpqcPrecoverage ((BigFppfOver.toScheme B S hS).obj T)) :
    ∃ (W : BigFppfOver B S hS) (w : W ⟶ T)
      (ν : ∀ i, (D.obj (g i) (Sieve.ofArrows_mk X g i)).1.Z ⟶ W),
      Stacks.Morphisms.IsFiniteLocallyFreeOfRank
          ((BigFppfOver.toScheme B S hS).map w) d ∧
        (∀ i, IsPullback (ν i)
          (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) w (g i)) ∧
        ∀ (i j : ι) ⦃Z : BigFppfOver B S hS⦄ (ε : Z ⟶ X i) (ε' : Z ⟶ X j)
          (heq : ε ≫ g i = ε' ≫ g j),
          (datumGluing D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g j) ε ε' heq).hom ≫
              pullback.fst (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) ε' ≫ ν j =
            pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ε ≫ ν i := by
  obtain ⟨C⟩ := DescentData.nonempty_chart_of_isFamilyEffective _
    (isFamilyEffective_datumSchemeDescentData D hcov)
  obtain ⟨W, w, pr, e, hw, -, hpre, hsq⟩ :=
    exists_objectOver_isPullback_of_isPullback_toScheme (d := d)
      (X := X) (Zo := fun i ↦ (D.obj (g i) (Sieve.ofArrows_mk X g i)).1.Z) (g := g)
      (c := fun i ↦ fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)))
      (fun i ↦ isFiniteLocallyFreeOfRank_fiberCoverHom _) hcov C.base.hom C.proj C.isPullback
  refine ⟨W, w, pr, hw, hsq, ?_⟩
  have hstar : ∀ (i j : ι) {Q : BigFppfOver B S hS} (α : Q ⟶ X i) (β : Q ⟶ X j)
      (hαβ : α ≫ g i = β ≫ g j)
      (σ : Q ⟶ pullback (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α),
      σ ≫ pullback.snd (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α = 𝟙 Q →
        σ ≫ (datumGluing D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g j)
              α β hαβ).hom ≫
            pullback.fst (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) β ≫ pr j =
          σ ≫ pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α ≫
            pr i := by
    intro i j Q α β hαβ σ hσ
    have hu := toScheme_section_comp D hαβ σ hσ
    have hchart := C.compat i j
    simp only [datumSchemeDescentData_obj, datumSchemeDescentData_gluingPullbackIso_hom,
      Over.mk_hom] at hchart
    have h2 : DescentData.fibreAct (fun i ↦ (BigFppfOver.toScheme B S hS).map (g i))
          (fun i ↦ Over.mk ((BigFppfOver.toScheme B S hS).map
            (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)))))
          (fun i j ↦ (datumSchemeGluing D i j).hom) i j
          ((BigFppfOver.toScheme B S hS).map
            (σ ≫ pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α))
          ((BigFppfOver.toScheme B S hS).map β) hu ≫ C.proj j =
        (BigFppfOver.toScheme B S hS).map
            (σ ≫ pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α) ≫
          C.proj i := by
      rw [DescentData.fibreAct]
      simp only [Over.mk_hom]
      rw [Category.assoc, Category.assoc, hchart, ← Category.assoc, pullback.lift_fst]
    rw [fibreAct_datumSchemeGluing D i j α β hαβ σ hσ hu] at h2
    have h5 : (σ ≫
          (datumGluing D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g j) α β hαβ).hom ≫
            pullback.fst (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) β) ≫ pr j =
        (σ ≫ pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) α) ≫
          pr i := by
      refine (BigFppfOver.toScheme B S hS).map_injective ?_
      refine (cancel_mono e.hom).mp ?_
      simp only [(BigFppfOver.toScheme B S hS).map_comp, Category.assoc, hpre]
      simpa only [(BigFppfOver.toScheme B S hS).map_comp, Category.assoc] using h2
    simpa only [Category.assoc] using h5
  intro i j Z ε ε' heq
  obtain ⟨γ, hγ⟩ : ∃ γ : pullback (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ε ⟶ Z,
      γ = pullback.snd (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ε := ⟨_, rfl⟩
  have hγε : pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ε ≫
      fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)) = γ ≫ ε := by
    rw [hγ]; exact pullback.condition
  have heqγ : (γ ≫ ε) ≫ g i = (γ ≫ ε') ≫ g j := by
    rw [Category.assoc, Category.assoc, heq]
  obtain ⟨σ, hσ₁, hσ₂⟩ := exists_section_of_comp_eq
    (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) (γ ≫ ε)
    (pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ε) hγε
  obtain ⟨μ, hμ₁, hμ₂⟩ := exists_pullback_hom_of_eq_comp
    (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) (γ ≫ ε) ε γ rfl
  have hσμ : σ ≫ μ = 𝟙 _ := by
    refine pullback.hom_ext ?_ ?_
    · rw [Category.assoc, hμ₁, hσ₁]
      simp only [Category.id_comp]
    · rw [Category.assoc, hμ₂, ← Category.assoc, hσ₂]
      simp only [Category.id_comp]
      exact hγ
  have hfac := datumGluing_comp_fst_of_fac D (Sieve.ofArrows_mk X g i)
    (Sieve.ofArrows_mk X g j) ε ε' heq γ (γ ≫ ε) (γ ≫ ε') heqγ rfl rfl μ hμ₁ hμ₂
  have hfac' : (datumGluing D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g j)
          (γ ≫ ε) (γ ≫ ε') heqγ).hom ≫
        pullback.fst (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) (γ ≫ ε') ≫
          pr j =
      μ ≫ (datumGluing D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g j) ε ε' heq).hom ≫
        pullback.fst (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) ε' ≫ pr j := by
    rw [← Category.assoc, hfac, Category.assoc, Category.assoc]
  have hR : σ ≫ pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i)))
        (γ ≫ ε) ≫ pr i =
      pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ε ≫ pr i := by
    rw [← Category.assoc, hσ₁]
  have hkey := hstar i j (γ ≫ ε) (γ ≫ ε') heqγ σ hσ₂
  rwa [hR, hfac', ← Category.assoc σ μ, hσμ, Category.id_comp] at hkey

/-! ### Effectivity -/

/-- **A cartesian square exhibiting the cover of an object of a fibre of `ℋ_d` as a base change
of a cover is a morphism of `ℋ_d` over the base morphism.** Its base component is
`eqToHom x.2 ≫ f`, the base object of an object of the fibre over `V` being only equal to `V`. -/
def fiberHomOfIsPullback {V : BigFppfOver B S hS}
    (x : (finiteCoverProjection (B := B) (S := S) (hS := hS) (d := d)).Fiber V)
    (Q : FiniteCover B S hS d) (f : V ⟶ Q.U) (ν : x.1.Z ⟶ Q.Z)
    (hsq : IsPullback ν (fiberCoverHom x) Q.q f) : x.1 ⟶ Q :=
  ⟨eqToHom x.2 ≫ f, ν, by
    obtain ⟨Px, hPx⟩ := x
    subst hPx
    simpa using hsq⟩

/-- The base component of `fiberHomOfIsPullback x Q f ν hsq` is `eqToHom x.2 ≫ f`. -/
@[simp]
theorem fiberHomOfIsPullback_f {V : BigFppfOver B S hS}
    (x : (finiteCoverProjection (B := B) (S := S) (hS := hS) (d := d)).Fiber V)
    (Q : FiniteCover B S hS d) (f : V ⟶ Q.U) (ν : x.1.Z ⟶ Q.Z)
    (hsq : IsPullback ν (fiberCoverHom x) Q.q f) :
    (fiberHomOfIsPullback x Q f ν hsq).f = eqToHom x.2 ≫ f := rfl

/-- The cover component of `fiberHomOfIsPullback x Q f ν hsq` is `ν`. -/
@[simp]
theorem fiberHomOfIsPullback_g {V : BigFppfOver B S hS}
    (x : (finiteCoverProjection (B := B) (S := S) (hS := hS) (d := d)).Fiber V)
    (Q : FiniteCover B S hS d) (f : V ⟶ Q.U) (ν : x.1.Z ⟶ Q.Z)
    (hsq : IsPullback ν (fiberCoverHom x) Q.q f) :
    (fiberHomOfIsPullback x Q f ν hsq).g = ν := rfl

/-- `AlgebraicGeometry.Stack.fiberHomOfIsPullback` is cartesian over the base morphism `f`. -/
theorem isCartesian_fiberHomOfIsPullback {V : BigFppfOver B S hS}
    (x : (finiteCoverProjection (B := B) (S := S) (hS := hS) (d := d)).Fiber V)
    (Q : FiniteCover B S hS d) (f : V ⟶ Q.U) (ν : x.1.Z ⟶ Q.Z)
    (hsq : IsPullback ν (fiberCoverHom x) Q.q f) :
    (finiteCoverProjection (B := B) (S := S) (hS := hS) (d := d)).IsCartesian f
      (fiberHomOfIsPullback x Q f ν hsq) :=
  isCartesian_of_isHomLift f _ (CategoryTheory.IsHomLift.of_fac'
    (finiteCoverProjection (B := B) (S := S) (hS := hS) (d := d)) f _ x.2 rfl (by
      show eqToHom x.2 ≫ f = eqToHom x.2 ≫ f ≫ eqToHom rfl
      simp))

/-- **The cover attached by the datum to an arbitrary arrow of the sieve is a base change of the
descended cover, compatibly with every gluing isomorphism.** Given morphisms `ν i` exhibiting the
covers attached to the generating family as base changes of `w`, compatibly with the gluing
isomorphisms, the cover attached to an arrow `f` of the sieve is the base change of `w` along `f`
by a morphism `νf` compatible with the gluing isomorphism at every factorization of a morphism
`ε ≫ f` through a member of the family. -/
theorem exists_descent_of_arrow {W : BigFppfOver B S hS} {w : W ⟶ T}
    (ν : ∀ i, (D.obj (g i) (Sieve.ofArrows_mk X g i)).1.Z ⟶ W)
    (hsq : ∀ i, IsPullback (ν i)
      (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) w (g i))
    (hcompat : ∀ (i j : ι) ⦃Z : BigFppfOver B S hS⦄ (ε : Z ⟶ X i) (ε' : Z ⟶ X j)
      (heq : ε ≫ g i = ε' ≫ g j),
      (datumGluing D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g j) ε ε' heq).hom ≫
          pullback.fst (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) ε' ≫ ν j =
        pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ε ≫ ν i)
    {V : BigFppfOver B S hS} (f : V ⟶ T) (hf : (Sieve.ofArrows X g).arrows f) :
    ∃ νf : (D.obj f hf).1.Z ⟶ W,
      IsPullback νf (fiberCoverHom (D.obj f hf)) w f ∧
        ∀ ⦃Z : BigFppfOver B S hS⦄ (ε : Z ⟶ V) (i : ι) (η : Z ⟶ X i) (hη : ε ≫ f = η ≫ g i),
          pullback.fst (fiberCoverHom (D.obj f hf)) ε ≫ νf =
            (datumGluing D hf (Sieve.ofArrows_mk X g i) ε η hη).hom ≫
              pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) η ≫ ν i := by
  obtain ⟨i₀, ε₀, hε₀⟩ := exists_comp_eq_of_arrows hf
  have heq₀ : 𝟙 V ≫ f = ε₀ ≫ g i₀ := by rw [Category.id_comp, hε₀]
  refine ⟨(IsPullback.id_horiz (fiberCoverHom (D.obj f hf))).isoPullback.hom ≫
      (datumGluing D hf (Sieve.ofArrows_mk X g i₀) (𝟙 V) ε₀ heq₀).hom ≫
        pullback.fst (fiberCoverHom (D.obj (g i₀) (Sieve.ofArrows_mk X g i₀))) ε₀ ≫ ν i₀,
    ?_, ?_⟩
  · have s1 : IsPullback ((IsPullback.id_horiz (fiberCoverHom (D.obj f hf))).isoPullback.hom ≫
          (datumGluing D hf (Sieve.ofArrows_mk X g i₀) (𝟙 V) ε₀ heq₀).hom)
        (fiberCoverHom (D.obj f hf))
        (pullback.snd (fiberCoverHom (D.obj (g i₀) (Sieve.ofArrows_mk X g i₀))) ε₀) (𝟙 V) :=
      IsPullback.of_horiz_isIso ⟨by
        rw [Category.assoc, datumGluing_hom_comp_snd, IsPullback.isoPullback_hom_snd,
          Category.comp_id]⟩
    have s2 : IsPullback (pullback.fst
          (fiberCoverHom (D.obj (g i₀) (Sieve.ofArrows_mk X g i₀))) ε₀ ≫ ν i₀)
        (pullback.snd (fiberCoverHom (D.obj (g i₀) (Sieve.ofArrows_mk X g i₀))) ε₀) w
        (ε₀ ≫ g i₀) := (IsPullback.of_hasPullback _ _).paste_horiz (hsq i₀)
    have hpaste := s1.paste_horiz s2
    rwa [Category.assoc, Category.id_comp, hε₀] at hpaste
  · intro Z ε i η hη
    obtain ⟨μ, hμ₁, hμ₂⟩ := exists_pullback_hom_of_eq_comp (fiberCoverHom (D.obj f hf)) ε
      (𝟙 V) ε (Category.comp_id ε).symm
    have hμiso : pullback.fst (fiberCoverHom (D.obj f hf)) ε ≫
        (IsPullback.id_horiz (fiberCoverHom (D.obj f hf))).isoPullback.hom = μ := by
      refine pullback.hom_ext ?_ ?_
      · rw [Category.assoc, IsPullback.isoPullback_hom_fst, Category.comp_id, hμ₁]
      · rw [Category.assoc, IsPullback.isoPullback_hom_snd, hμ₂]
        exact pullback.condition
    have heqε : ε ≫ f = (ε ≫ ε₀) ≫ g i₀ := by rw [Category.assoc, hε₀]
    have hfac := datumGluing_comp_fst_of_fac D hf (Sieve.ofArrows_mk X g i₀) (𝟙 V) ε₀ heq₀
      ε ε (ε ≫ ε₀) heqε (Category.comp_id ε) rfl μ hμ₁ hμ₂
    have hL : pullback.fst (fiberCoverHom (D.obj f hf)) ε ≫
          ((IsPullback.id_horiz (fiberCoverHom (D.obj f hf))).isoPullback.hom ≫
            (datumGluing D hf (Sieve.ofArrows_mk X g i₀) (𝟙 V) ε₀ heq₀).hom ≫
              pullback.fst (fiberCoverHom (D.obj (g i₀)
                (Sieve.ofArrows_mk X g i₀))) ε₀ ≫ ν i₀) =
        (datumGluing D hf (Sieve.ofArrows_mk X g i₀) ε (ε ≫ ε₀) heqε).hom ≫
          pullback.fst (fiberCoverHom (D.obj (g i₀) (Sieve.ofArrows_mk X g i₀)))
            (ε ≫ ε₀) ≫ ν i₀ := by
      rw [← Category.assoc, hμiso, ← Category.assoc (datumGluing D hf
          (Sieve.ofArrows_mk X g i₀) ε (ε ≫ ε₀) heqε).hom, hfac]
      simp only [Category.assoc]
    rw [hL, ← datumGluing_trans D hf (Sieve.ofArrows_mk X g i₀) (Sieve.ofArrows_mk X g i)
      ε (ε ≫ ε₀) η heqε (heqε.symm.trans hη) hη, Category.assoc,
      hcompat i₀ i (ε ≫ ε₀) η (heqε.symm.trans hη)]

/-- **A descent datum of `ℋ_d` relative to the sieve generated by a covering family is effective
as soon as the covers it attaches to the family descend to a cover of the base**, compatibly with
every gluing isomorphism of the datum. -/
theorem isEffective_of_isPullback_of_compat {W : BigFppfOver B S hS} {w : W ⟶ T}
    (hw : Stacks.Morphisms.IsFiniteLocallyFreeOfRank
      ((BigFppfOver.toScheme B S hS).map w) d)
    (ν : ∀ i, (D.obj (g i) (Sieve.ofArrows_mk X g i)).1.Z ⟶ W)
    (hsq : ∀ i, IsPullback (ν i)
      (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) w (g i))
    (hcompat : ∀ (i j : ι) ⦃Z : BigFppfOver B S hS⦄ (ε : Z ⟶ X i) (ε' : Z ⟶ X j)
      (heq : ε ≫ g i = ε' ≫ g j),
      (datumGluing D (Sieve.ofArrows_mk X g i) (Sieve.ofArrows_mk X g j) ε ε' heq).hom ≫
          pullback.fst (fiberCoverHom (D.obj (g j) (Sieve.ofArrows_mk X g j))) ε' ≫ ν j =
        pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) ε ≫ ν i) :
    D.IsEffective := by
  classical
  obtain ⟨νν, hνν₁, hνν₂⟩ : ∃ νν : ∀ {V : BigFppfOver B S hS} (f : V ⟶ T)
        (hf : (Sieve.ofArrows X g).arrows f), (D.obj f hf).1.Z ⟶ W,
      (∀ {V : BigFppfOver B S hS} (f : V ⟶ T) (hf : (Sieve.ofArrows X g).arrows f),
          IsPullback (νν f hf) (fiberCoverHom (D.obj f hf)) w f) ∧
        ∀ {V : BigFppfOver B S hS} (f : V ⟶ T) (hf : (Sieve.ofArrows X g).arrows f)
          ⦃Z : BigFppfOver B S hS⦄ (ε : Z ⟶ V) (i : ι) (η : Z ⟶ X i)
          (hη : ε ≫ f = η ≫ g i),
          pullback.fst (fiberCoverHom (D.obj f hf)) ε ≫ νν f hf =
            (datumGluing D hf (Sieve.ofArrows_mk X g i) ε η hη).hom ≫
              pullback.fst (fiberCoverHom (D.obj (g i) (Sieve.ofArrows_mk X g i))) η ≫ ν i :=
    ⟨fun f hf ↦ (exists_descent_of_arrow D ν hsq hcompat f hf).choose,
      fun f hf ↦ (exists_descent_of_arrow D ν hsq hcompat f hf).choose_spec.1,
      fun f hf ↦ (exists_descent_of_arrow D ν hsq hcompat f hf).choose_spec.2⟩
  have hG : ∀ ⦃V₁ V₂ Z : BigFppfOver B S hS⦄ ⦃f₁ : V₁ ⟶ T⦄
      (hf₁ : (Sieve.ofArrows X g).arrows f₁) ⦃f₂ : V₂ ⟶ T⦄
      (hf₂ : (Sieve.ofArrows X g).arrows f₂) (ε₁ : Z ⟶ V₁) (ε₂ : Z ⟶ V₂)
      (hc : ε₁ ≫ f₁ = ε₂ ≫ f₂),
      (datumGluing D hf₁ hf₂ ε₁ ε₂ hc).hom ≫
          pullback.fst (fiberCoverHom (D.obj f₂ hf₂)) ε₂ ≫ νν f₂ hf₂ =
        pullback.fst (fiberCoverHom (D.obj f₁ hf₁)) ε₁ ≫ νν f₁ hf₁ := by
    intro V₁ V₂ Z f₁ hf₁ f₂ hf₂ ε₁ ε₂ hc
    obtain ⟨i, κ, hκ⟩ := exists_comp_eq_of_arrows hf₂
    have hη₂ : ε₂ ≫ f₂ = (ε₂ ≫ κ) ≫ g i := by rw [Category.assoc, hκ]
    have hη₁ : ε₁ ≫ f₁ = (ε₂ ≫ κ) ≫ g i := hc.trans hη₂
    rw [hνν₂ f₁ hf₁ ε₁ i (ε₂ ≫ κ) hη₁, hνν₂ f₂ hf₂ ε₂ i (ε₂ ≫ κ) hη₂,
      ← datumGluing_trans D hf₁ hf₂ (Sieve.ofArrows_mk X g i) ε₁ ε₂ (ε₂ ≫ κ) hc hη₂ hη₁,
      Category.assoc]
  refine D.isEffective_of_chosenOverlaps ⟨⟨T, W, w, hw⟩, rfl⟩
    (fun {V} f hf ↦ fiberHomOfIsPullback (D.obj f hf) ⟨T, W, w, hw⟩ f (νν f hf) (hνν₁ f hf))
    (fun {V} f hf ↦ isCartesian_fiberHomOfIsPullback _ _ _ _ _) ?_
  intro V₁ V₂ f₁ hf₁ f₂ hf₂
  refine (cancel_epi (Functor.Fiber.fiberInclusion.map
    (pullbackFiberIsoPointObj (D.obj f₁ hf₁) (pullback.fst f₁ f₂)).inv)).mp ?_
  rw [← datumCoverIso_hom_comp_fiberPointHom_assoc D hf₁ hf₂ (pullback.fst f₁ f₂)
      (pullback.snd f₁ f₂) pullback.condition,
    fiberInclusion_pullbackFiberIsoPointObj_inv_comp_assoc]
  refine FiniteCover.Hom.ext ?_ ?_
  · have h1 := fiberPointObj_hom_f_eq_id (D.obj f₁ hf₁) (D.obj f₂ hf₂)
      (pullback.fst f₁ f₂) (pullback.snd f₁ f₂)
      (datumCoverIso D hf₁ hf₂ (pullback.fst f₁ f₂) (pullback.snd f₁ f₂)
        pullback.condition).hom
    have h2 : (fiberPointHom (D.obj f₂ hf₂) (Over.mk (pullback.snd f₁ f₂))).f ≫
          (eqToHom (D.obj f₂ hf₂).2 ≫ f₂) =
        (fiberPointHom (D.obj f₁ hf₁) (Over.mk (pullback.fst f₁ f₂))).f ≫
          (eqToHom (D.obj f₁ hf₁).2 ≫ f₁) := by
      simp only [fiberPointHom_f, Over.mk_hom, Category.assoc, eqToHom_trans_assoc,
        eqToHom_refl, Category.id_comp]
      exact (pullback.condition (f := f₁) (g := f₂)).symm
    show (Subtype.val (datumCoverIso D hf₁ hf₂ (pullback.fst f₁ f₂) (pullback.snd f₁ f₂)
            pullback.condition).hom).f ≫
          ((fiberPointHom (D.obj f₂ hf₂) (Over.mk (pullback.snd f₁ f₂))).f ≫
            (eqToHom (D.obj f₂ hf₂).2 ≫ f₂)) =
        (fiberPointHom (D.obj f₁ hf₁) (Over.mk (pullback.fst f₁ f₂))).f ≫
          (eqToHom (D.obj f₁ hf₁).2 ≫ f₁)
    rw [h1]
    exact (Category.id_comp _).trans h2
  · show (Subtype.val (datumCoverIso D hf₁ hf₂ (pullback.fst f₁ f₂) (pullback.snd f₁ f₂)
            pullback.condition).hom).g ≫
          ((fiberPointHom (D.obj f₂ hf₂) (Over.mk (pullback.snd f₁ f₂))).g ≫ νν f₂ hf₂) =
        (fiberPointHom (D.obj f₁ hf₁) (Over.mk (pullback.fst f₁ f₂))).g ≫ νν f₁ hf₁
    simp only [fiberPointHom_g, Over.mk_hom]
    exact hG hf₁ hf₂ (pullback.fst f₁ f₂) (pullback.snd f₁ f₂) pullback.condition


/-- **A descent datum of `ℋ_d` relative to the sieve generated by a jointly surjective family of
flat morphisms locally of finite presentation is effective.** -/
theorem isEffective_of_flat_of_locallyOfFinitePresentation
    (hflat : ∀ i, Flat ((BigFppfOver.toScheme B S hS).map (g i)))
    (hlfp : ∀ i, LocallyOfFinitePresentation ((BigFppfOver.toScheme B S hS).map (g i)))
    (hsurj : ∀ x : (BigFppfOver.toScheme B S hS).obj T,
      ∃ i, x ∈ Set.range ((BigFppfOver.toScheme B S hS).map (g i))) :
    D.IsEffective := by
  obtain ⟨W, w, ν, hw, hsq, hcompat⟩ := exists_descendedCover_compat D
    (mem_fpqcPrecoverage_of_flat_of_locallyOfFinitePresentation _ hflat hlfp hsurj)
  exact isEffective_of_isPullback_of_compat D hw ν hsq hcompat

