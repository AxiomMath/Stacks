module

public import StacksFrontier.AlgebraicGeometry.Stacks.SubsitePrimedFactorizations
public import StacksFrontier.AlgebraicGeometry.Topologies.Fppf.CoveringSieves
public import StacksFrontier.CategoryTheory.Sites.Gerbe.Equivalence
public import StacksFrontier.CategoryTheory.Sites.SectionsAlongAFunctorConnected
import all StacksFrontier.AlgebraicGeometry.Stacks.SubsitePrimedFactorizations

/-!
# Local connectedness of the factorizations through the primed 2-fibre product

Let `f : 𝒳 ⟶ 𝒴` be a 1-morphism of algebraic stacks over a scheme `S` and let `y` be a smooth
(respectively flat) object of `𝒴` lying over a scheme `V`. This file proves, with no hypothesis,
the second local condition of **Stacks 07AK** for the inclusion of the primed 2-fibre product
`(V ×_{y, 𝒴} 𝒳)'` into `V ×_{y, 𝒴} 𝒳`: any two morphisms from an object of the 2-fibre product
to primed objects are, locally on that object, joined by a *zigzag* in the category of such
morphisms. This is the hypothesis `hconn` of
`CategoryTheory.SubsitePushforward.primedPushforwardAmbientEquiv`.

Only the zigzag form can hold. The dominating form
`Stacks.Sites.HasConnectedLocalFactorizations` already fails for `𝒴 = Spec k`, `𝒳 = A¹` and
`V = A¹`; see the module documentation of
`StacksFrontier.CategoryTheory.Sites.SectionsAlongAFunctorConnected`.

## Main results

* `AlgebraicGeometry.Stack.LisseEtale.hasLocallyConnectedFactorizations_primedInclusion` and
  `AlgebraicGeometry.Stack.FlatFppf.hasLocallyConnectedFactorizations_primedInclusion`: the
  condition for the primed 2-fibre product, in the smooth and in the flat case.
* `AlgebraicGeometry.Stack.hasLocallyConnectedFactorizations_of_atlas`: the same condition for
  any algebraic stack with a smooth surjective atlas and any full subcategory closed under the
  pullbacks the topology calls for and containing the distinguished object of every smooth
  atlas.
* `AlgebraicGeometry.Stack.generate_singleton_mem_baseOverTopology_etale` and
  `AlgebraicGeometry.Stack.generate_singleton_mem_baseOverTopology_fppf`: a smooth surjective
  morphism of objects of the site generates a covering sieve of the étale, respectively of the
  fppf, topology — the only input that distinguishes the two cases.

## Implementation notes

Everything is deduced from one statement about an algebraic stack `𝒜` with a smooth surjective
atlas `a : U₀ ⟶ 𝒜`, namely
`AlgebraicGeometry.Stack.hasLocallyConnectedFactorizations_of_atlas`. Writing `A₀` for the
distinguished object of `a`, the zigzag joining two morphisms `φ₁ : T ⟶ d₁`, `φ₂ : T ⟶ d₂` to
primed objects has length four,
`(d₁, hφ₁) ← (E₁, χ₁) → (A₀, γ₁) ← (Ď, δ) → (A₀, γ₂) ← (E₂, χ₂) → (d₂, hφ₂)`, and is assembled
from two halves by the transitivity of a topology:

* the outer steps lift `dᵢ` along `a` after a covering of the scheme `dᵢ` lies over
  (**Stacks 06XH**); the lift `Eᵢ` lies over a *smooth* morphism of schemes, so it is primed by
  the closure condition of **Stacks 07AK** (1), and it has a canonical morphism to `A₀` because
  the identity is terminal in the slice over `U₀`;
* the middle step is the 2-fibre product `D := U₀ ×_{a, 𝒜, a} U₀`, an algebraic stack by
  **Stacks 04T2** whose first projection is smooth by **Stacks 075W**. Its atlas `D₀` has a
  distinguished object whose first component is a smooth object of `U₀`, so its image `Ď` in
  `𝒜` is primed; and `Ď` carries two morphisms to `A₀`, the canonical one and the one through
  the comparison isomorphism of that object of `D`. A pair of morphisms `γ₁, γ₂ : T ⟶ A₀` is
  exactly an object of `D` over the scheme `T` lies over, and lifting it to `D₀` produces the
  morphism `δ`: the compatibility `δ ≫ β̌₂ = h ≫ γ₂` is the commuting square carried by the
  morphism of `D` that the lift supplies.

## References

* [Stacks Project, Tag 04T2](https://stacks.math.columbia.edu/tag/04T2)
* [Stacks Project, Tag 055V](https://stacks.math.columbia.edu/tag/055V)
* [Stacks Project, Tag 06XH](https://stacks.math.columbia.edu/tag/06XH)
* [Stacks Project, Tag 075W](https://stacks.math.columbia.edu/tag/075W)
* [Stacks Project, Tag 07AK](https://stacks.math.columbia.edu/tag/07AK)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Stack

universe u w

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-! ### Covering sieves generated by one smooth surjective morphism -/

/-- **A smooth surjective morphism of objects of the site generates a covering sieve of the
étale topology.** It is refined by an étale covering each member of which factors through it
(**Stacks 055V**), and the sieve it generates therefore contains a covering sieve. -/
theorem generate_singleton_mem_baseOverTopology_etale {U : BigFppfOver B S hS} {W : B.Schemes}
    (m : W ⟶ U.left) (hsm : Smooth (B.inclusion.map m))
    (hsurj : Surjective (B.inclusion.map m)) :
    Sieve.generate (Presieve.singleton
        (Over.homMk m rfl : (Over.mk (m ≫ U.hom) : BigFppfOver B S hS) ⟶ U))
      ∈ BigFppfOver.baseOverTopology B S hS .etale U := by
  obtain ⟨I, Wf, e, hetale, hjs, hfacs⟩ :=
    exists_etaleRefinement_of_smooth_surjective B m hsm hsurj
  refine GrothendieckTopology.superset_covering _ ?_
    (mem_etaleOverTopology_of_family B S hS Wf e hetale hjs)
  rintro V u ⟨V', b, -, ⟨i⟩, rfl⟩
  obtain ⟨c, hc⟩ := hfacs i
  set g : V ⟶ (Over.mk (m ≫ U.hom) : BigFppfOver B S hS) :=
    b ≫ Over.homMk c (by simp [← hc]) with hg
  refine ⟨_, g, _, Presieve.singleton_self _, ?_⟩
  rw [hg, Category.assoc]
  congr 1
  exact Over.OverMorphism.ext (by simp [hc])

/-- **A smooth surjective morphism of objects of the site generates a covering sieve of the fppf
topology.** A smooth morphism is flat and locally of finite presentation, so its one-member
family is an fppf covering. -/
theorem generate_singleton_mem_baseOverTopology_fppf {U : BigFppfOver B S hS} {W : B.Schemes}
    (m : W ⟶ U.left) (hsm : Smooth (B.inclusion.map m))
    (hsurj : Surjective (B.inclusion.map m)) :
    Sieve.generate (Presieve.singleton
        (Over.homMk m rfl : (Over.mk (m ≫ U.hom) : BigFppfOver B S hS) ⟶ U))
      ∈ BigFppfOver.baseOverTopology B S hS .fppf U := by
  have := hsm
  have := hsurj
  refine GrothendieckTopology.superset_covering _ ?_
    (mem_topology_of_family B S hS (I := PUnit.{u + 2}) (fun _ => W) (fun _ => m)
      (fun _ => inferInstance) (fun _ => inferInstance) (fun x => ⟨PUnit.unit, hsurj.1 x⟩))
  rintro V u ⟨V', b, -, ⟨i⟩, rfl⟩
  exact ⟨(Over.mk (m ≫ U.hom) : BigFppfOver B S hS), b, _, Presieve.singleton_self _, rfl⟩

/-- A morphism of a category over the big fppf category of `S` lying over a morphism of the base
whose underlying morphism of schemes is smooth itself lies over a smooth morphism of schemes. -/
private theorem smooth_toScheme_map_of_isHomLift {X : Type*} [Category X]
    (p : X ⥤ BigFppfOver B S hS) {U V : BigFppfOver B S hS} {x y : X}
    (k : U ⟶ V) (α : x ⟶ y) (hα : p.IsHomLift k α)
    (hk : Smooth ((BigFppfOver.toScheme B S hS).map k)) :
    Smooth ((BigFppfOver.toScheme B S hS).map (p.map α)) := by
  have := hα
  have := hk
  rw [IsHomLift.fac' p k α]
  simp only [Functor.map_comp]
  infer_instance

/-- Lying over a morphism of the base is transported along a factorization of that morphism
through a second one between objects identified with its source and target. -/
private lemma isHomLift_of_fac_eqToHom {X : Type*} [Category X] {C : Type*} [Category C]
    (p : X ⥤ C) {R R' S' S : C} {x y : X} (k : R ⟶ S) (f : R' ⟶ S') (φ : x ⟶ y)
    (hR : R = R') (hS : S' = S) (hk : k = eqToHom hR ≫ f ≫ eqToHom hS)
    (hφ : p.IsHomLift k φ) : p.IsHomLift f φ := by
  subst hR
  subst hS
  simp only [eqToHom_refl, Category.id_comp, Category.comp_id] at hk
  subst hk
  exact hφ

/-- An arrow of the sieve generated by a single morphism factors through that morphism. -/
private lemma exists_fac_of_generate_singleton {X : Type*} [Category X] {U V W : X}
    (f : V ⟶ U) (u : W ⟶ U) (hu : (Sieve.generate (Presieve.singleton f)).arrows u) :
    ∃ v : W ⟶ V, v ≫ f = u := by
  obtain ⟨Y, v, f', hf', hv⟩ := hu
  cases hf'
  exact ⟨v, hv⟩

/-- **The first of the two compatibilities of the middle zigzag, abstractly.** Two morphisms
`ga`, `za` out of one object into two others, both compatible with chosen morphisms `tg`, `tz`,
`tx` into a common object, give equal composites after applying a functor and composing with a
morphism `ν` that factors `γ` through the image of `tz`. -/
private lemma comp_map_eq_of_fac {C D : Type*} [Category C] [Category D] (F : C ⥤ D)
    {cx cg cz u : C} (tx : cx ⟶ u) (tg : cg ⟶ u) (tz : cz ⟶ u)
    (ga : cx ⟶ cg) (za : cx ⟶ cz) (hga : ga ≫ tg = tx) (hza : za ≫ tz = tx)
    {X T : D} (σ : X ⟶ F.obj cx) (ν : F.obj cz ⟶ T) (γ : T ⟶ F.obj u)
    (hν : ν ≫ γ = F.map tz) :
    (σ ≫ F.map ga) ≫ F.map tg = (σ ≫ F.map za ≫ ν) ≫ γ := by
  simp only [Category.assoc, hν, ← F.map_comp, hga, hza]

/-- **The second of the two compatibilities of the middle zigzag, abstractly.** The same with
the two morphisms into the common object preceded by comparison isomorphisms, intertwined with
`ga` and `za` by two commuting squares. -/
private lemma comp_map_eq_of_fac_comm {C D : Type*} [Category C] [Category D] (F : C ⥤ D)
    {cx cg cz u cxy cgy czy : C} (ty : cxy ⟶ u) (tgy : cgy ⟶ u) (tzy : czy ⟶ u)
    (gb : cxy ⟶ cgy) (zb : cxy ⟶ czy) (hgb : gb ≫ tgy = ty) (hzb : zb ≫ tzy = ty)
    (ga : cx ⟶ cg) (za : cx ⟶ cz)
    (ιx : F.obj cx ⟶ F.obj cxy) (ιg : F.obj cg ⟶ F.obj cgy) (ιz : F.obj cz ⟶ F.obj czy)
    (hga : F.map ga ≫ ιg = ιx ≫ F.map gb) (hza : F.map za ≫ ιz = ιx ≫ F.map zb)
    {X T : D} (σ : X ⟶ F.obj cx) (ν : F.obj cz ⟶ T) (γ : T ⟶ F.obj u)
    (hν : ν ≫ γ = ιz ≫ F.map tzy) :
    (σ ≫ F.map ga) ≫ ιg ≫ F.map tgy = (σ ≫ F.map za ≫ ν) ≫ γ := by
  simp only [Category.assoc, hν, reassoc_of% hga, reassoc_of% hza, ← F.map_comp, hgb, hzb]

/-! ### The slice of an algebraic stack at a smooth surjective atlas -/

section Atlas

variable {𝒜 : Stack.AlgebraicStacks.{u, w} B S hS} {U₀ : BigFppfOver B S hS}
  (a : schemeStack.{u, w} B S hS U₀ ⟶ 𝒜)

/-- The unique morphism of the slice over `U₀` from an object to the terminal object `𝟙 U₀`. -/
private def toUnit (z : Over U₀) : z ⟶ Over.mk (𝟙 U₀) := Over.homMk z.hom (by simp)

/-- Any morphism of the slice over `U₀` into `𝟙 U₀` is the canonical one. -/
private lemma eq_toUnit {z : Over U₀} (g : z ⟶ Over.mk (𝟙 U₀)) : g = toUnit B S hS z :=
  Over.mkIdTerminal.hom_ext g _

/-- The functor `U₀/S ⥤ 𝒜` underlying the atlas. -/
private abbrev atlasFunctor := CatFiberedInGroupoids.homFunctor a.hom

/-- The distinguished object of the atlas: the image of the identity of `U₀`. -/
private abbrev atlasObj := (atlasFunctor B S hS a).obj (Over.mk (𝟙 U₀))

/-- The image under the atlas of a morphism of the slice over `U₀` lies over that morphism. -/
private lemma isHomLift_atlasFunctor_map {z z' : Over U₀} (g : z ⟶ z') :
    𝒜.val.val.p.IsHomLift g.left ((atlasFunctor B S hS a).map g) :=
  PresheafOfCategories.isHomLift_map_of_comp (q := Over.forget U₀) a.hom.hom.w g.left g
    (CategoryTheory.IsHomLift.of_fac' (Over.forget U₀) g.left g rfl rfl (by simp))

/-- The distinguished object of the atlas lies over `U₀`. -/
private lemma base_atlasObj : 𝒜.val.val.p.obj (atlasObj B S hS a) = U₀ :=
  Functor.congr_obj a.hom.hom.w (Over.mk (𝟙 U₀))

/-- The morphism of the base that a morphism to the distinguished object of the atlas lies
over, read as a morphism to `U₀`. -/
private def baseOf {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) :
    𝒜.val.val.p.obj T ⟶ U₀ :=
  𝒜.val.val.p.map γ ≫ eqToHom (base_atlasObj B S hS a)

/-- A morphism to the distinguished object of the atlas lies over
`AlgebraicGeometry.Stack.baseOf`. -/
private lemma isHomLift_baseOf {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) :
    𝒜.val.val.p.IsHomLift (baseOf B S hS a γ) γ :=
  CategoryTheory.IsHomLift.of_fac' 𝒜.val.val.p _ γ rfl (base_atlasObj B S hS a)
    (by simp [baseOf])

/-- The object of the slice over `U₀` that a morphism to the distinguished object of the atlas
names: its base morphism. -/
private def objOf {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) : Over U₀ :=
  Over.mk (baseOf B S hS a γ)

/-- The canonical morphism from the image of `AlgebraicGeometry.Stack.objOf` to the
distinguished object of the atlas. -/
private def betaOf {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) :
    (atlasFunctor B S hS a).obj (objOf B S hS a γ) ⟶ atlasObj B S hS a :=
  (atlasFunctor B S hS a).map (toUnit B S hS (objOf B S hS a γ))

/-- `AlgebraicGeometry.Stack.betaOf` lies over the same morphism of the base as `γ`. -/
private lemma isHomLift_betaOf {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) :
    𝒜.val.val.p.IsHomLift (baseOf B S hS a γ) (betaOf B S hS a γ) :=
  isHomLift_atlasFunctor_map B S hS a (toUnit B S hS (objOf B S hS a γ))

/-- `AlgebraicGeometry.Stack.betaOf` is strongly cartesian over the morphism of the base that `γ`
lies over. -/
private lemma isStronglyCartesian_betaOf {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) :
    𝒜.val.val.p.IsStronglyCartesian (baseOf B S hS a γ) (betaOf B S hS a γ) :=
  have := isHomLift_betaOf B S hS a γ
  have := isHomLift_baseOf B S hS a γ
  𝒜.val.isFiberedInGroupoids.isStronglyCartesian_homLift _ _

/-- **The cartesian factorization of a morphism to the distinguished object of the atlas.**
`AlgebraicGeometry.Stack.betaOf` is strongly cartesian over the morphism of the base that `γ`
lies over, so `γ` factors through it by a morphism lying over an identity. -/
private def kappa {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) :
    T ⟶ (atlasFunctor B S hS a).obj (objOf B S hS a γ) :=
  haveI := isHomLift_baseOf B S hS a γ
  haveI := isStronglyCartesian_betaOf B S hS a γ
  Functor.IsStronglyCartesian.map 𝒜.val.val.p (baseOf B S hS a γ) (betaOf B S hS a γ)
    (Category.id_comp _).symm γ

/-- The cartesian factorization composed with `AlgebraicGeometry.Stack.betaOf` is `γ`. -/
private lemma kappa_comp_betaOf {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) :
    kappa B S hS a γ ≫ betaOf B S hS a γ = γ :=
  have := isHomLift_baseOf B S hS a γ
  have := isStronglyCartesian_betaOf B S hS a γ
  Functor.IsStronglyCartesian.fac 𝒜.val.val.p (baseOf B S hS a γ) (betaOf B S hS a γ)
    (Category.id_comp _).symm γ

/-- The cartesian factorization lies over an identity. -/
private lemma isHomLift_kappa {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) :
    𝒜.val.val.p.IsHomLift (𝟙 (𝒜.val.val.p.obj T)) (kappa B S hS a γ) :=
  have := isHomLift_baseOf B S hS a γ
  have := isStronglyCartesian_betaOf B S hS a γ
  Functor.IsStronglyCartesian.map_isHomLift 𝒜.val.val.p (baseOf B S hS a γ)
    (betaOf B S hS a γ) (Category.id_comp _).symm γ

/-- The cartesian factorization is an isomorphism: it lies over an identity and the fibres of a
category fibred in groupoids are groupoids. -/
private lemma isIso_kappa {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) :
    IsIso (kappa B S hS a γ) :=
  Functor.IsFiberedInGroupoids.isIso_of_isHomLift_id 𝒜.val.isFiberedInGroupoids _
    (isHomLift_kappa B S hS a γ)

/-- The cartesian factorization of `AlgebraicGeometry.Stack.kappa`, as an isomorphism. -/
private def kappaIso {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) :
    T ≅ (atlasFunctor B S hS a).obj (objOf B S hS a γ) :=
  have := isIso_kappa B S hS a γ
  asIso (kappa B S hS a γ)

/-- The composite of the inverse of the cartesian factorization with `γ` is the canonical
morphism out of the image of `AlgebraicGeometry.Stack.objOf`. -/
private lemma kappaIso_inv_comp {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) :
    (kappaIso B S hS a γ).inv ≫ γ = betaOf B S hS a γ := by
  rw [Iso.inv_comp_eq]
  exact (kappa_comp_betaOf B S hS a γ).symm

/-- The cartesian factorization isomorphism lies over an identity. -/
private lemma isHomLift_kappaIso_hom {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) :
    𝒜.val.val.p.IsHomLift (𝟙 (𝒜.val.val.p.obj T)) (kappaIso B S hS a γ).hom :=
  isHomLift_kappa B S hS a γ

/-- `AlgebraicGeometry.Stack.betaOf` spelled out as the image of the canonical morphism to the
terminal object of the slice over `U₀`. -/
private lemma kappaIso_hom_comp_map_toUnit {T : 𝒜.val.val.obj} (γ : T ⟶ atlasObj B S hS a) :
    (kappaIso B S hS a γ).hom ≫
        (atlasFunctor B S hS a).map (toUnit B S hS (objOf B S hS a γ)) = γ :=
  kappa_comp_betaOf B S hS a γ

/-- The composite of the inverse of the cartesian factorization of `γ₁` with the cartesian
factorization of `γ₂` lies over an identity, so it is a legitimate comparison isomorphism for an
object of the atlas square. -/
private lemma isHomLift_kappaIso_inv_comp_hom {T : 𝒜.val.val.obj}
    (γ₁ γ₂ : T ⟶ atlasObj B S hS a) :
    𝒜.val.val.p.IsHomLift (𝟙 (𝒜.val.val.p.obj T))
      ((kappaIso B S hS a γ₁).inv ≫ (kappaIso B S hS a γ₂).hom) := by
  have h₁ := isHomLift_kappaIso_hom B S hS a γ₁
  have h₂ := isHomLift_kappaIso_hom B S hS a γ₂
  have h₃ : 𝒜.val.val.p.IsHomLift (𝟙 (𝒜.val.val.p.obj T)) (kappaIso B S hS a γ₁).inv :=
    IsHomLift.lift_id_inv 𝒜.val.val.p _ (kappaIso B S hS a γ₁)
  exact IsHomLift.comp_of_lift_id 𝒜.val.val.p (𝒜.val.val.p.obj T) _ _

/-- **The 2-fibre product `U₀ ×_{a, 𝒜, a} U₀` of the atlas with itself**, as a 2-commutative
square of algebraic stacks (**Stacks 04T2**). -/
private abbrev atlasSquare : Bicategory.TwoCommSq a a :=
  twoFibreProductSquareAlgebraicStacks B S hS a a

/-- **Stacks 075W for the atlas square.** Its first projection is a base change of the atlas,
hence smooth. -/
private theorem isSmooth_atlasSquare_fst (hasm : AlgebraicStacks.IsSmooth B S hS a) :
    AlgebraicStacks.IsSmooth B S hS (atlasSquare B S hS a).fst :=
  AlgebraicStacks.isSmooth_baseChange B S hS a a (atlasSquare B S hS a)
    (isTwoFibreProduct_twoFibreProductSquareAlgebraicStacks B S hS a a) hasm

/-- **The object of the atlas square determined by a pair of morphisms to the distinguished
object of the atlas.** Its two components are the objects of the slice over `U₀` that `γ₁` and
`γ₂` name, and its comparison isomorphism is the composite of their cartesian factorizations. -/
private abbrev squareObj {T : 𝒜.val.val.obj} (γ₁ γ₂ : T ⟶ atlasObj B S hS a) :
    (atlasSquare B S hS a).pt.val.val.obj :=
  { base := 𝒜.val.val.p.obj T
    x := objOf B S hS a γ₁
    y := objOf B S hS a γ₂
    hx := rfl
    hy := rfl
    iso := (kappaIso B S hS a γ₁).symm ≪≫ kappaIso B S hS a γ₂
    vertical := isHomLift_kappaIso_inv_comp_hom B S hS a γ₁ γ₂ }

/-- `AlgebraicGeometry.Stack.squareObj` lies over the object of the base that `T` lies over. -/
private lemma squareObj_base {T : 𝒜.val.val.obj} (γ₁ γ₂ : T ⟶ atlasObj B S hS a) :
    (atlasSquare B S hS a).pt.val.val.p.obj (squareObj B S hS a γ₁ γ₂)
      = 𝒜.val.val.p.obj T := rfl

/-- The inverse cartesian factorization of `γ₁` composed with `γ₁` is the canonical morphism out
of the first component of `AlgebraicGeometry.Stack.squareObj`. -/
private lemma kappaIso_inv_comp_fst {T : 𝒜.val.val.obj} (γ₁ γ₂ : T ⟶ atlasObj B S hS a) :
    (kappaIso B S hS a γ₁).inv ≫ γ₁ = (atlasFunctor B S hS a).map
      (toUnit B S hS (squareObj B S hS a γ₁ γ₂).x) :=
  kappaIso_inv_comp B S hS a γ₁

/-- The inverse cartesian factorization of `γ₁` composed with `γ₂` is the comparison
isomorphism of `AlgebraicGeometry.Stack.squareObj` — the composite displayed on the right —
followed by the canonical morphism out of its second component. -/
private lemma kappaIso_inv_comp_snd {T : 𝒜.val.val.obj} (γ₁ γ₂ : T ⟶ atlasObj B S hS a) :
    (kappaIso B S hS a γ₁).inv ≫ γ₂
      = ((kappaIso B S hS a γ₁).inv ≫ (kappaIso B S hS a γ₂).hom) ≫
        (atlasFunctor B S hS a).map (toUnit B S hS (objOf B S hS a γ₂)) := by
  rw [Category.assoc, kappaIso_hom_comp_map_toUnit]

end Atlas

/-! ### Lifting an object along a smooth surjective atlas -/

/-- **Stacks 06XH in the form used here.** Along a smooth surjective 1-morphism from the
algebraic stack of an object of the site, every object of a fibre of the target lifts after a
covering of the base, provided a smooth surjective morphism of the base generates a covering
sieve. This is the common shape of Stacks 06XH (2) and of Stacks 06QA; the hypothesis `hgen` is
what chooses between the étale and the fppf topology. -/
theorem exists_covering_fibre_lift (τ : SiteKind)
    (hgen : ∀ {U : BigFppfOver B S hS} {W : B.Schemes} (m : W ⟶ U.left),
      Smooth (B.inclusion.map m) → Surjective (B.inclusion.map m) →
        Sieve.generate (Presieve.singleton
            (Over.homMk m rfl : (Over.mk (m ≫ U.hom) : BigFppfOver B S hS) ⟶ U))
          ∈ BigFppfOver.baseOverTopology B S hS τ U)
    {𝒞 : Stack.AlgebraicStacks.{u, w} B S hS} {W₀ : BigFppfOver B S hS}
    (g : schemeStack.{u, w} B S hS W₀ ⟶ 𝒞) (hsurj : IsSurjective B S hS g)
    (hsm : AlgebraicStacks.IsSmooth B S hS g)
    (U : BigFppfOver B S hS) (z : 𝒞.val.val.obj) (hz : 𝒞.val.val.p.obj z = U) :
    ∃ R ∈ BigFppfOver.baseOverTopology B S hS τ U,
      ∀ ⦃V : BigFppfOver B S hS⦄ ⦃k : V ⟶ U⦄, R.arrows k →
        ∃ (x : Over W₀) (α : (CatFiberedInGroupoids.homFunctor g.hom).obj x ⟶ z),
          𝒞.val.val.p.IsHomLift k α := by
  obtain ⟨T, m, hmsm, hmsurj, zz, φ, hφ⟩ :=
    exists_scheme_lift_of_isSurjective_isSmooth B S hS g hsurj hsm U ⟨z, hz⟩
  refine ⟨_, hgen m hmsm hmsurj, ?_⟩
  rintro V k ⟨-, b, -, ⟨⟩, rfl⟩
  have hw : CatFiberedInGroupoids.homFunctor g.hom ⋙ 𝒞.val.val.p =
      (schemeStack.{u, w} B S hS W₀).val.val.p := g.hom.hom.w
  have hzbase : (schemeStack.{u, w} B S hS W₀).val.val.p.obj zz
      = (Over.mk (m ≫ U.hom) : BigFppfOver B S hS) := by
    have h₀ := hφ
    rw [← hw]
    exact IsHomLift.domain_eq 𝒞.val.val.p
      (Over.homMk m rfl : (Over.mk (m ≫ U.hom) : BigFppfOver B S hS) ⟶ U) φ
  obtain ⟨z', ρ, hρ⟩ :=
    (schemeStack.{u, w} B S hS W₀).val.isFiberedInGroupoids.exists_lift b zz hzbase
  refine ⟨z', (CatFiberedInGroupoids.homFunctor g.hom).map ρ ≫ φ, ?_⟩
  have h₁ : 𝒞.val.val.p.IsHomLift b ((CatFiberedInGroupoids.homFunctor g.hom).map ρ) :=
    PresheafOfCategories.isHomLift_map_of_comp hw b ρ hρ
  have h₂ := hφ
  exact IsHomLift.comp 𝒞.val.val.p b
    (Over.homMk m rfl : (Over.mk (m ≫ U.hom) : BigFppfOver B S hS) ⟶ U)
    ((CatFiberedInGroupoids.homFunctor g.hom).map ρ) φ

/-! ### The two outer steps of the zigzag -/

section Main

variable {𝒜 : Stack.AlgebraicStacks.{u, w} B S hS} {U₀ : BigFppfOver B S hS}
  (a : schemeStack.{u, w} B S hS U₀ ⟶ 𝒜) (P : ObjectProperty 𝒜.val.val.obj) (τ : SiteKind)

/-- The hypothesis that a smooth surjective morphism of objects of the site generates a covering
sieve of `τ`, abbreviated. -/
private abbrev GeneratesCovering : Prop :=
  ∀ {U : BigFppfOver B S hS} {W : B.Schemes} (m : W ⟶ U.left),
    Smooth (B.inclusion.map m) → Surjective (B.inclusion.map m) →
      Sieve.generate (Presieve.singleton
          (Over.homMk m rfl : (Over.mk (m ≫ U.hom) : BigFppfOver B S hS) ⟶ U))
        ∈ BigFppfOver.baseOverTopology B S hS τ U

/-- The closure condition of Stacks 07AK (1) in the single form both of its halves imply: the
subcategory is closed under the morphisms lying over a morphism of schemes that is smooth. -/
private theorem closed_of_isClosedUnderSitePullback
    (hcl : IsClosedUnderSitePullback B S hS 𝒜.val.val.p P τ)
    {x y : 𝒜.val.val.obj} (α : x ⟶ y)
    (hα : Smooth ((BigFppfOver.toScheme B S hS).map (𝒜.val.val.p.map α))) (hy : P y) : P x := by
  have h₀ : Smooth (B.inclusion.map (𝒜.val.val.p.map α).left) := hα
  rcases hcl with ⟨-, h⟩ | ⟨-, h⟩
  · exact h α h₀ hy
  · exact h α inferInstance inferInstance hy

/-- **A zigzag of length two through a common source.** Two morphisms `k₁`, `k₂` out of `T'`
that factor through one morphism `δ` to an object `Dc` of the subcategory are joined. -/
private theorem zigzag_of_common_source {Dc : 𝒜.val.val.obj} (hPD : P Dc) {T' : 𝒜.val.val.obj}
    {d₁ d₂ : P.FullSubcategory} (δ : T' ⟶ Dc) (β₁ : Dc ⟶ d₁.obj) (β₂ : Dc ⟶ d₂.obj)
    {k₁ : T' ⟶ d₁.obj} {k₂ : T' ⟶ d₂.obj} (hu : δ ≫ β₁ = k₁) (hv : δ ≫ β₂ = k₂) :
    Zigzag (StructuredArrow.mk (T := P.ι) (Y := d₁) k₁)
      (StructuredArrow.mk (T := P.ι) (Y := d₂) k₂) :=
  Zigzag.of_inv_hom
    (StructuredArrow.homMk
      (f := StructuredArrow.mk (T := P.ι) (Y := (⟨Dc, hPD⟩ : P.FullSubcategory)) δ)
      (f' := StructuredArrow.mk (T := P.ι) (Y := d₁) k₁) (ObjectProperty.homMk β₁) hu)
    (StructuredArrow.homMk
      (f := StructuredArrow.mk (T := P.ι) (Y := (⟨Dc, hPD⟩ : P.FullSubcategory)) δ)
      (f' := StructuredArrow.mk (T := P.ι) (Y := d₂) k₂) (ObjectProperty.homMk β₂) hv)

/-- **The zigzag at one arrow of the covering sieve.** With `α : a(z) ⟶ d` a lift of `d` along
the atlas over `km` and `h` an arrow along which `hφ` factors through `km` downstairs, the
universal property of `α` produces the morphism `χ` of
`AlgebraicGeometry.Stack.zigzag_of_cartesian_lift`. -/
private theorem exists_zigzag_of_lift (hA₀ : P (atlasObj B S hS a))
    {T : 𝒜.val.val.obj} (d : P.FullSubcategory) (φ : T ⟶ d.obj)
    {z : Over U₀} {U : BigFppfOver B S hS} (km : U ⟶ 𝒜.val.val.p.obj d.obj)
    (α : (atlasFunctor B S hS a).obj z ⟶ d.obj) (hα : 𝒜.val.val.p.IsHomLift km α)
    (hPz : P ((atlasFunctor B S hS a).obj z))
    {T' : 𝒜.val.val.obj} (h : T' ⟶ T)
    (hh : (Sieve.generate (Presieve.singleton km)).arrows (𝒜.val.val.p.map (h ≫ φ))) :
    ∃ γ : T' ⟶ atlasObj B S hS a,
      Zigzag (StructuredArrow.mk (T := P.ι) (Y := d) (h ≫ φ))
        (StructuredArrow.mk (T := P.ι)
          (Y := (⟨atlasObj B S hS a, hA₀⟩ : P.FullSubcategory)) γ) := by
  obtain ⟨g, hg⟩ := exists_fac_of_generate_singleton km _ hh
  have := hα
  have : 𝒜.val.val.p.IsStronglyCartesian km α :=
    𝒜.val.isFiberedInGroupoids.isStronglyCartesian_homLift km α
  exact ⟨Functor.IsStronglyCartesian.map 𝒜.val.val.p km α hg.symm (h ≫ φ) ≫
    (atlasFunctor B S hS a).map (toUnit B S hS z),
    zigzag_of_common_source B S hS P hPz _ α _
      (Functor.IsStronglyCartesian.fac 𝒜.val.val.p km α hg.symm (h ≫ φ)) rfl⟩

/-- **The outer step of the zigzag.** Let `d` be an object of the subcategory and let
`φ : T ⟶ d` be a morphism. Then `T` carries a covering sieve along each arrow `h` of which
`(d, hφ)` is joined by a zigzag of length two to `(A₀, γ)` for some morphism `γ` to the
distinguished object of the atlas: `d` lifts along the atlas over a smooth surjective morphism
of schemes (**Stacks 06XH**), the lift is in the subcategory by the closure condition, and it
has a canonical morphism to `A₀`. -/
private theorem exists_zigzag_to_atlasObj (hgen : GeneratesCovering B S hS τ)
    (hasm : AlgebraicStacks.IsSmooth B S hS a) (hasurj : IsSurjective B S hS a)
    (hcl : IsClosedUnderSitePullback B S hS 𝒜.val.val.p P τ) (hA₀ : P (atlasObj B S hS a))
    (T : 𝒜.val.val.obj) (d : P.FullSubcategory) (φ : T ⟶ d.obj) :
    ∃ R ∈ BigFppfOver.associatedTopology B S hS 𝒜.val.val.p τ T,
      ∀ ⦃T' : 𝒜.val.val.obj⦄ ⦃h : T' ⟶ T⦄, R.arrows h →
        ∃ γ : T' ⟶ atlasObj B S hS a,
          Zigzag (StructuredArrow.mk (T := P.ι) (Y := d) (h ≫ φ))
            (StructuredArrow.mk (T := P.ι)
              (Y := (⟨atlasObj B S hS a, hA₀⟩ : P.FullSubcategory)) γ) := by
  have : 𝒜.val.val.p.IsFibered := 𝒜.val.isFiberedInGroupoids.isFibered
  obtain ⟨W, m, hmsm, hmsurj, z, α, hα⟩ :=
    exists_scheme_lift_of_isSurjective_isSmooth B S hS a hasurj hasm
      (𝒜.val.val.p.obj d.obj) (Functor.Fiber.mk rfl)
  refine ⟨Sieve.functorPullback 𝒜.val.val.p
      (Sieve.pullback (𝒜.val.val.p.map φ) (Sieve.generate (Presieve.singleton
        (Over.homMk m rfl : (Over.mk (m ≫ (𝒜.val.val.p.obj d.obj).hom) :
          BigFppfOver B S hS) ⟶ 𝒜.val.val.p.obj d.obj)))), ?_, ?_⟩
  · exact Functor.functorPullback_mem_inheritedTopology 𝒜.val.val.p _ T
      ((BigFppfOver.baseOverTopology B S hS τ).pullback_stable _ (hgen m hmsm hmsurj))
  · intro T' h hh
    exact exists_zigzag_of_lift B S hS a P hA₀ d φ _ α hα
      (closed_of_isClosedUnderSitePullback B S hS P τ hcl α
        (smooth_toScheme_map_of_isHomLift B S hS 𝒜.val.val.p _ α hα hmsm) d.property)
      h (by rw [𝒜.val.val.p.map_comp]; exact hh)

/-! ### The middle step of the zigzag -/

/-- **The middle step of the zigzag.** Any two morphisms `γ₁, γ₂` from an object `T` to the
distinguished object of the atlas are, locally on `T`, joined by a zigzag of length two through
the image in `𝒜` of the distinguished object of an atlas of the 2-fibre product
`U₀ ×_{a, 𝒜, a} U₀`: that object is in the subcategory because the atlas square's first
projection is smooth (**Stacks 075W**), the pair `(γ₁, γ₂)` names an object of the atlas square
over the object of the base that `T` lies over, and lifting that object to the atlas of the
square (**Stacks 06XH**) produces the mediating morphism together with its two
compatibilities. -/
private theorem connectedFactorizationSieve_atlasObj_mem (hgen : GeneratesCovering B S hS τ)
    (hasm : AlgebraicStacks.IsSmooth B S hS a) (hA₀ : P (atlasObj B S hS a))
    (hPsm : ∀ (W : BigFppfOver B S hS) (g : schemeStack.{u, w} B S hS W ⟶ 𝒜),
      AlgebraicStacks.IsSmooth B S hS g →
        P ((CatFiberedInGroupoids.homFunctor g.hom).obj (Over.mk (𝟙 W))))
    (T : 𝒜.val.val.obj) (γ₁ γ₂ : T ⟶ atlasObj B S hS a) :
    Stacks.Sites.connectedFactorizationSieve P.ι
        (d₁ := (⟨atlasObj B S hS a, hA₀⟩ : P.FullSubcategory))
        (d₂ := (⟨atlasObj B S hS a, hA₀⟩ : P.FullSubcategory)) γ₁ γ₂
      ∈ BigFppfOver.associatedTopology B S hS 𝒜.val.val.p τ T := by
  have : 𝒜.val.val.p.IsFibered := 𝒜.val.isFiberedInGroupoids.isFibered
  obtain ⟨D₀, e, hesm, hesurj⟩ :=
    exists_smooth_surjective_schemeStack.{u, w} B S hS (atlasSquare B S hS a).pt
  have hPD : P ((atlasFunctor B S hS a).obj
      ((CatFiberedInGroupoids.homFunctor e.hom).obj (Over.mk (𝟙 D₀))).x) :=
    hPsm D₀ (e ≫ (atlasSquare B S hS a).fst ≫ a)
      (AlgebraicStacks.isSmooth_comp B S hS e _ hesm
        (AlgebraicStacks.isSmooth_comp B S hS _ a
          (isSmooth_atlasSquare_fst B S hS a hasm) hasm))
  obtain ⟨R, hR, hlift⟩ :=
    exists_covering_fibre_lift B S hS τ hgen e hesurj hesm (𝒜.val.val.p.obj T)
      (squareObj B S hS a γ₁ γ₂) (squareObj_base B S hS a γ₁ γ₂)
  refine GrothendieckTopology.superset_covering _ ?_
    (Functor.functorPullback_mem_inheritedTopology 𝒜.val.val.p _ T hR)
  intro T' h hh
  obtain ⟨xx, ζ, hζ⟩ := hlift hh
  have hζ' := hζ
  have hdom := IsHomLift.domain_eq (atlasSquare B S hS a).pt.val.val.p (𝒜.val.val.p.map h) ζ
  have hcod := IsHomLift.codomain_eq (atlasSquare B S hS a).pt.val.val.p (𝒜.val.val.p.map h) ζ
  have hfac : ζ.hbase = eqToHom hdom ≫ 𝒜.val.val.p.map h ≫ eqToHom hcod.symm :=
    IsHomLift.fac' (atlasSquare B S hS a).pt.val.val.p (𝒜.val.val.p.map h) ζ
  have h1 : 𝒜.val.val.p.IsHomLift ζ.hbase ((atlasFunctor B S hS a).map ζ.a) :=
    PresheafOfCategories.isHomLift_map_of_comp a.hom.hom.w ζ.hbase ζ.a ζ.ha
  have h2 : 𝒜.val.val.p.IsHomLift (𝟙 (𝒜.val.val.p.obj T)) (kappaIso B S hS a γ₁).inv :=
    have := isHomLift_kappaIso_hom B S hS a γ₁
    IsHomLift.lift_id_inv 𝒜.val.val.p _ (kappaIso B S hS a γ₁)
  have h3 : 𝒜.val.val.p.IsHomLift ζ.hbase
      ((atlasFunctor B S hS a).map ζ.a ≫ (kappaIso B S hS a γ₁).inv) :=
    IsHomLift.comp_lift_id_right' 𝒜.val.val.p ζ.hbase _ (𝒜.val.val.p.obj T) _
  have h4 : 𝒜.val.val.p.IsHomLift (𝒜.val.val.p.map h)
      ((atlasFunctor B S hS a).map ζ.a ≫ (kappaIso B S hS a γ₁).inv) :=
    isHomLift_of_fac_eqToHom 𝒜.val.val.p ζ.hbase (𝒜.val.val.p.map h) _
      hdom hcod.symm hfac h3
  have hcart : 𝒜.val.val.p.IsStronglyCartesian (𝒜.val.val.p.map h)
      ((atlasFunctor B S hS a).map ζ.a ≫ (kappaIso B S hS a γ₁).inv) :=
    have := h4
    𝒜.val.isFiberedInGroupoids.isStronglyCartesian_homLift _ _
  have := hcart
  obtain ⟨σ, ⟨-, hσ⟩, -⟩ := Functor.IsStronglyCartesian.universal_property 𝒜.val.val.p
    (𝒜.val.val.p.map h) ((atlasFunctor B S hS a).map ζ.a ≫ (kappaIso B S hS a γ₁).inv)
    (𝟙 _) (𝒜.val.val.p.map h) (Category.id_comp _).symm h
  refine zigzag_of_common_source B S hS P hPD
    (σ ≫ (atlasFunctor B S hS a).map
      ((CatFiberedInGroupoids.homFunctor e.hom).map (toUnit B S hS xx)).a)
    ((atlasFunctor B S hS a).map (toUnit B S hS
      ((CatFiberedInGroupoids.homFunctor e.hom).obj (Over.mk (𝟙 D₀))).x))
    (((CatFiberedInGroupoids.homFunctor e.hom).obj (Over.mk (𝟙 D₀))).iso.hom ≫
      (atlasFunctor B S hS a).map (toUnit B S hS
        ((CatFiberedInGroupoids.homFunctor e.hom).obj (Over.mk (𝟙 D₀))).y)) ?_ ?_
  · rw [← hσ]
    exact comp_map_eq_of_fac (atlasFunctor B S hS a)
      (toUnit B S hS ((CatFiberedInGroupoids.homFunctor e.hom).obj xx).x) _ _
      ((CatFiberedInGroupoids.homFunctor e.hom).map (toUnit B S hS xx)).a ζ.a
      (eq_toUnit B S hS _) (eq_toUnit B S hS _) σ (kappaIso B S hS a γ₁).inv γ₁
      (kappaIso_inv_comp_fst B S hS a γ₁ γ₂)
  · rw [← hσ]
    exact comp_map_eq_of_fac_comm (atlasFunctor B S hS a)
      (toUnit B S hS ((CatFiberedInGroupoids.homFunctor e.hom).obj xx).y) _ _
      ((CatFiberedInGroupoids.homFunctor e.hom).map (toUnit B S hS xx)).b ζ.b
      (eq_toUnit B S hS _) (eq_toUnit B S hS _)
      ((CatFiberedInGroupoids.homFunctor e.hom).map (toUnit B S hS xx)).a ζ.a
      ((CatFiberedInGroupoids.homFunctor e.hom).obj xx).iso.hom _ _
      ((CatFiberedInGroupoids.homFunctor e.hom).map (toUnit B S hS xx)).w ζ.w
      σ (kappaIso B S hS a γ₁).inv γ₂ (kappaIso_inv_comp_snd B S hS a γ₁ γ₂)

/-! ### Local connectedness from a smooth surjective atlas -/

/-- **Local connectedness of the factorizations through a subcategory containing the
distinguished object of every smooth atlas.** Let `𝒜` be an algebraic stack with a smooth
surjective atlas `a : U₀ ⟶ 𝒜`, let `τ` be a topology for which a smooth surjective morphism of
schemes generates a covering sieve, and let `P` cut out a full subcategory of `𝒜` which is
closed under the pullbacks `τ` calls for (**Stacks 07AK** (1)) and which holds at the
distinguished object of every smooth 1-morphism to `𝒜` out of the algebraic stack of an object
of the site. Then any two morphisms from an object of `𝒜` to objects of the subcategory are,
locally on that object, joined by a zigzag in the category of such morphisms.

The zigzag has length four: two outer steps through lifts along `a`, and a middle step through
an atlas of the 2-fibre product `U₀ ×_{a, 𝒜, a} U₀`; the two halves are combined by the
transitivity of a topology. -/
theorem hasLocallyConnectedFactorizations_of_atlas
    (hgen : ∀ {U : BigFppfOver B S hS} {W : B.Schemes} (m : W ⟶ U.left),
      Smooth (B.inclusion.map m) → Surjective (B.inclusion.map m) →
        Sieve.generate (Presieve.singleton
            (Over.homMk m rfl : (Over.mk (m ≫ U.hom) : BigFppfOver B S hS) ⟶ U))
          ∈ BigFppfOver.baseOverTopology B S hS τ U)
    (hasm : AlgebraicStacks.IsSmooth B S hS a) (hasurj : IsSurjective B S hS a)
    (hcl : IsClosedUnderSitePullback B S hS 𝒜.val.val.p P τ)
    (hPsm : ∀ (W : BigFppfOver B S hS) (g : schemeStack.{u, w} B S hS W ⟶ 𝒜),
      AlgebraicStacks.IsSmooth B S hS g →
        P ((CatFiberedInGroupoids.homFunctor g.hom).obj (Over.mk (𝟙 W)))) :
    Stacks.Sites.HasLocallyConnectedFactorizations
      (BigFppfOver.associatedTopology B S hS 𝒜.val.val.p τ) P.ι := by
  have hA₀ : P (atlasObj B S hS a) := hPsm U₀ a hasm
  intro T d₁ d₂ φ₁ φ₂
  obtain ⟨R₁, hR₁, hz₁⟩ :=
    exists_zigzag_to_atlasObj B S hS a P τ hgen hasm hasurj hcl hA₀ T d₁ φ₁
  obtain ⟨R₂, hR₂, hz₂⟩ :=
    exists_zigzag_to_atlasObj B S hS a P τ hgen hasm hasurj hcl hA₀ T d₂ φ₂
  refine GrothendieckTopology.transitive _
    ((BigFppfOver.associatedTopology B S hS 𝒜.val.val.p τ).intersection_covering hR₁ hR₂) _ ?_
  intro T' h hh
  obtain ⟨γ₁, hγ₁⟩ := hz₁ hh.1
  obtain ⟨γ₂, hγ₂⟩ := hz₂ hh.2
  refine GrothendieckTopology.superset_covering _ ?_
    (connectedFactorizationSieve_atlasObj_mem B S hS a P τ hgen hasm hA₀ hPsm T' γ₁ γ₂)
  intro T'' h' hh'
  have k₁ := zigzag_obj_of_zigzag (StructuredArrow.map (T := P.ι) h') hγ₁
  have k₂ := zigzag_obj_of_zigzag (StructuredArrow.map (T := P.ι) h') hγ₂
  have k := (k₁.trans hh').trans k₂.symm
  have hgoal : Zigzag (StructuredArrow.mk (T := P.ι) ((h' ≫ h) ≫ φ₁))
      (StructuredArrow.mk (T := P.ι) ((h' ≫ h) ≫ φ₂)) := by
    simp only [Category.assoc]
    exact k
  exact hgoal

end Main


/-! ### The two subsites of Stacks 07AK -/

section Primed

variable {𝒳 𝒴 : Stack.AlgebraicStacks.{u, w} B S hS} (f : 𝒳 ⟶ 𝒴)

namespace LisseEtale

/-- **Local connectedness of the factorizations for the primed 2-fibre product, the smooth
case.** Any two morphisms from an object of `V ×_{y, 𝒴} 𝒳` to objects whose `𝒳`-component is
smooth are, locally in the étale topology the 2-fibre product inherits from the base, joined by
a zigzag in the category of such morphisms.

This is `AlgebraicGeometry.Stack.hasLocallyConnectedFactorizations_of_atlas` at the primed
atlas of `AlgebraicGeometry.Stack.LisseEtale.exists_primed_atlas`: the closure condition is
`AlgebraicGeometry.Stack.LisseEtale.isClosedUnderSitePullback_primedObjectProperty`, and the
distinguished object of a smooth 1-morphism to the 2-fibre product is a primed object because
the projection to `𝒳` is smooth. -/
theorem hasLocallyConnectedFactorizations_primedInclusion (y : LisseEtale.{u, w} B S hS 𝒴) :
    Stacks.Sites.HasLocallyConnectedFactorizations
      (ambientTwoFibreProductTopology B S hS f y .etale)
      (primedObjectProperty B S hS f y).ι := by
  obtain ⟨U₀, a, hasm, hasurj, -⟩ := exists_primed_atlas B S hS f y
  refine hasLocallyConnectedFactorizations_of_atlas B S hS a _ .etale
    (fun m hm hmsurj => generate_singleton_mem_baseOverTopology_etale B S hS m hm hmsurj)
    hasm hasurj (isClosedUnderSitePullback_primedObjectProperty B S hS f y) ?_
  intro W g hg
  exact smoothObject_map.{u, w} B S hS (ambientSquare B S hS f y).snd
    (isSmooth_ambientSquare_snd B S hS f y)
    ⟨_, smoothObject_map.{u, w} B S hS g hg ⟨_, smoothObject_schemeStack_id B S hS W⟩⟩

end LisseEtale

namespace FlatFppf

/-- **Local connectedness of the factorizations for the primed 2-fibre product, the flat case.**
Any two morphisms from an object of `V ×_{y, 𝒴} 𝒳` to objects whose `𝒳`-component is flat are,
locally in the fppf topology the 2-fibre product inherits from the base, joined by a zigzag in
the category of such morphisms.

This is `AlgebraicGeometry.Stack.hasLocallyConnectedFactorizations_of_atlas` at the primed
atlas of `AlgebraicGeometry.Stack.FlatFppf.exists_primed_atlas`: the closure condition is
`AlgebraicGeometry.Stack.FlatFppf.isClosedUnderSitePullback_primedObjectProperty`, and the
distinguished object of a smooth 1-morphism to the 2-fibre product is a primed object because
the projection to `𝒳` is flat and a smooth 1-morphism is flat. -/
theorem hasLocallyConnectedFactorizations_primedInclusion (y : FlatFppf B S hS 𝒴) :
    Stacks.Sites.HasLocallyConnectedFactorizations
      (ambientTwoFibreProductTopology B S hS f y .fppf)
      (primedObjectProperty B S hS f y).ι := by
  obtain ⟨U₀, a, hasm, hasurj, -⟩ := exists_primed_atlas B S hS f y
  refine hasLocallyConnectedFactorizations_of_atlas B S hS a _ .fppf
    (fun m hm hmsurj => generate_singleton_mem_baseOverTopology_fppf B S hS m hm hmsurj)
    hasm hasurj (isClosedUnderSitePullback_primedObjectProperty B S hS f y) ?_
  intro W g hg
  exact flatObject_map B S hS (ambientSquare B S hS f y).snd
    (isFlat_ambientSquare_snd B S hS f y)
    ⟨_, flatObject_map B S hS g (AlgebraicStacks.isFlat_of_isSmooth B S hS g hg)
      ⟨_, AlgebraicStacks.isFlat_of_isSmooth B S hS _
        (smoothObject_schemeStack_id.{u, w} B S hS W)⟩⟩

end FlatFppf

end Primed

end AlgebraicGeometry.Stack

