@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open Stacks.Cohomology.ColimitsOfCohomology

attribute [local instance] essentiallySmall_join hasSheafify_ab_join enoughInjectives_sheaf_join
  globalSections_additive_join

universe v₀ u₀

/-- Sheaves of sets on a site have coproducts over an index type in `Type`, built from the
colimits of the size of the join of the two universes of the site. The instance is needed to form
the finite coproducts of sheafified representables condition (4) of Stacks 0GN4 speaks of, and is
restated in this constructed form — rather than as the
`CategoryTheory.Limits.HasColimitsOfSize` at the join universe which the files proving
Stacks 0GN3 and Stacks 0GN4 install — because with the imports of this file the search that
descends from that statement to the coproduct over a finite index type does not terminate within
the elaborator's budget. Pinning the instance at the shape actually used costs nothing and is
local to this file. It is anonymous because
`StacksFrontier/AlgebraicGeometry/Stacks/ColimitsOfCohomologyProductDictionary.lean` exports a
declaration of the same name whose `instance` attribute is local to it. -/
local instance {C : Type u₀} [Category.{v₀} C]
    (J : GrothendieckTopology C) {ι : Type} (A : ι → Sheaf J (Type max u₀ v₀)) :
    HasCoproduct A :=
  letI : HasColimitsOfSize.{max u₀ v₀, max u₀ v₀} (Sheaf J (Type max u₀ v₀)) :=
    Sheaf.instHasColimitsOfSize
  letI : HasColimitsOfSize.{0, 0} (Sheaf J (Type max u₀ v₀)) := hasColimitsOfSizeShrink _
  inferInstance

namespace AlgebraicGeometry.Stack

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
variable (𝒳 : CatFiberedInGroupoids.{u, u, u + 1, u + 1} (BigFppfOver B S hS))

/-- **Condition (4) of Stacks 0GN4 for the fppf site, from a factorisation over a single
morphism.** Let `a, b : x ⟶ x'` be two morphisms of the fppf site of `𝒳` and let `V_i` be a finite
family of objects with morphisms `p_i : V_i ⟶ x` equalizing `a` and `b`, and suppose every
morphism `α : y ⟶ x` with `α ≫ a = α ≫ b` admits a *single* morphism `g : w ⟶ y` whose singleton
generates a covering sieve of `y` and through which `α` factors, compatibly with some `p_i`. Then
`∐_i h_{V_i}^# ⟶ Equalizer(h_a^#, h_b^#)` is a surjection of fppf sheaves of sets.

This is `AlgebraicGeometry.Stack.isLocallySurjective_equalizerLift_fppfTopology_of_exists_covering`
with the covering sieve taken to be the one generated by `g`: an arrow of that sieve is `e ≫ g`
for some `e`, and `e ≫ r` factors it. The single-morphism form is the one the source's argument
produces, a smooth presentation of a 2-fibre product being a single morphism. -/
theorem isLocallySurjective_equalizerLift_fppfTopology_of_exists_singleton_lift
    {x x' : 𝒳.val.obj} (a b : x ⟶ x') {m : ℕ} (V : Fin m → 𝒳.val.obj)
    (p : ∀ i, V i ⟶ x) (hp : ∀ i, p i ≫ a = p i ≫ b)
    (h : ∀ (y : 𝒳.val.obj) (α : y ⟶ x), α ≫ a = α ≫ b →
      ∃ (w : 𝒳.val.obj) (g : w ⟶ y),
        Sieve.generate (Presieve.singleton g) ∈ fppfTopology B S hS 𝒳 y ∧
          ∃ (i : Fin m) (r : w ⟶ V i), r ≫ p i = g ≫ α) :
    Sheaf.IsLocallySurjective (Limits.Sigma.desc fun i =>
      equalizer.lift
        (f := (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map a)
        (g := (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map b)
        ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (p i)) (by
          simpa only [Functor.map_comp] using
            congrArg (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (hp i))) := by
  refine isLocallySurjective_equalizerLift_fppfTopology_of_exists_covering B S hS 𝒳 a b V p hp ?_
  intro y α hα
  obtain ⟨w, g, hcov, i, r, hr⟩ := h y α hα
  refine ⟨Sieve.generate (Presieve.singleton g), hcov, ?_⟩
  rintro z _ ⟨W, e, _, ⟨⟩, rfl⟩
  exact ⟨i, e ≫ r, by rw [Category.assoc, hr, ← Category.assoc]⟩

/-- **Condition (4) of Stacks 0GN4 for the fppf site, with the covering taken downstairs.** The
hypothesis of
`AlgebraicGeometry.Stack.isLocallySurjective_equalizerLift_fppfTopology_of_exists_singleton_lift`
with the covering requirement moved to the big fppf category over `S`: it is enough that an
equalizing `α` factor through a single `g : w ⟶ y` whose image is refined by a covering sieve of
`p(y)`, in the sense that every arrow of that sieve factors through `p(g)`.

The passage upstairs is `CategoryTheory.Functor.generate_singleton_mem_inheritedTopology`, every
morphism of a category fibred in groupoids being strongly cartesian; the fppf topology of
Stacks 06TP is the topology inherited from `AlgebraicGeometry.BigFppfOver.topology`, so the
conclusion of that lemma is literally a covering sieve of the fppf site and no transport is
needed. -/
theorem isLocallySurjective_equalizerLift_fppfTopology_of_exists_base_covering
    {x x' : 𝒳.val.obj} (a b : x ⟶ x') {m : ℕ} (V : Fin m → 𝒳.val.obj)
    (p : ∀ i, V i ⟶ x) (hp : ∀ i, p i ≫ a = p i ≫ b)
    (h : ∀ (y : 𝒳.val.obj) (α : y ⟶ x), α ≫ a = α ≫ b →
      ∃ (w : 𝒳.val.obj) (g : w ⟶ y) (R : Sieve (𝒳.val.p.obj y)),
        R ∈ BigFppfOver.topology B S hS (𝒳.val.p.obj y) ∧
          (∀ ⦃T : BigFppfOver B S hS⦄ (u : T ⟶ 𝒳.val.p.obj y), R.arrows u →
            ∃ v : T ⟶ 𝒳.val.p.obj w, v ≫ 𝒳.val.p.map g = u) ∧
          ∃ (i : Fin m) (r : w ⟶ V i), r ≫ p i = g ≫ α) :
    Sheaf.IsLocallySurjective (Limits.Sigma.desc fun i =>
      equalizer.lift
        (f := (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map a)
        (g := (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map b)
        ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (p i)) (by
          simpa only [Functor.map_comp] using
            congrArg (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (hp i))) := by
  have : 𝒳.val.p.IsFibered := 𝒳.isFiberedInGroupoids.isFibered
  refine isLocallySurjective_equalizerLift_fppfTopology_of_exists_singleton_lift
    B S hS 𝒳 a b V p hp ?_
  intro y α hα
  obtain ⟨w, g, R, hR, hfac, hrest⟩ := h y α hα
  exact ⟨w, g, 𝒳.val.p.generate_singleton_mem_inheritedTopology
    (BigFppfOver.topology B S hS) g (𝒳.isFiberedInGroupoids.isStronglyCartesian g) hR hfac,
    hrest⟩

/-- **Condition (4) of Stacks 0GN4 for the fppf site, from base data alone.** The hypothesis of
`AlgebraicGeometry.Stack.isLocallySurjective_equalizerLift_fppfTopology_of_exists_base_covering`
with the factorisation of `α` through `p_i` replaced, through
`CategoryTheory.Functor.IsStronglyCartesian.homEquivBase`, by a morphism `c` of the big fppf
category over `S`: apart from the one covering morphism `g : w ⟶ y`, the hypothesis now mentions
only morphisms of the base.

Unlike its counterpart for condition (3),
`AlgebraicGeometry.Stack.isLocallySurjective_prodLift_fppfTopology_of_exists_base_hom`, there is
no side condition on `c`. The bijection of
`AlgebraicGeometry.Stack.homPairEquivBase` has to cut out the base morphisms whose induced
factorisation also matches the second morphism of the pair — the condition carrying the comparison
isomorphism of a quadruple of Stacks 0040 — and condition (4) has no second morphism, so here the
universal property of a strongly cartesian morphism is used raw. Every morphism of a category
fibred in groupoids is strongly cartesian over its image, so the instance the bijection needs is
automatic. -/
theorem isLocallySurjective_equalizerLift_fppfTopology_of_exists_base_hom
    {x x' : 𝒳.val.obj} (a b : x ⟶ x') {m : ℕ} (V : Fin m → 𝒳.val.obj)
    (p : ∀ i, V i ⟶ x) (hp : ∀ i, p i ≫ a = p i ≫ b)
    (h : ∀ (y : 𝒳.val.obj) (α : y ⟶ x), α ≫ a = α ≫ b →
      ∃ (w : 𝒳.val.obj) (g : w ⟶ y) (R : Sieve (𝒳.val.p.obj y)),
        R ∈ BigFppfOver.topology B S hS (𝒳.val.p.obj y) ∧
          (∀ ⦃T : BigFppfOver B S hS⦄ (u : T ⟶ 𝒳.val.p.obj y), R.arrows u →
            ∃ v : T ⟶ 𝒳.val.p.obj w, v ≫ 𝒳.val.p.map g = u) ∧
          ∃ (i : Fin m) (c : 𝒳.val.p.obj w ⟶ 𝒳.val.p.obj (V i)),
            c ≫ 𝒳.val.p.map (p i) = 𝒳.val.p.map (g ≫ α)) :
    Sheaf.IsLocallySurjective (Limits.Sigma.desc fun i =>
      equalizer.lift
        (f := (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map a)
        (g := (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map b)
        ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (p i)) (by
          simpa only [Functor.map_comp] using
            congrArg (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (hp i))) := by
  refine isLocallySurjective_equalizerLift_fppfTopology_of_exists_base_covering
    B S hS 𝒳 a b V p hp ?_
  intro y α hα
  obtain ⟨w, g, R, hR, hfac, i, c, hc⟩ := h y α hα
  have hcart := Functor.IsStronglyCartesian.homEquivBase 𝒳.val.p (p i)
    (hk := 𝒳.isFiberedInGroupoids.isStronglyCartesian (p i)) (g ≫ α)
  exact ⟨w, g, R, hR, hfac, i, _, (hcart.symm ⟨c, hc⟩).2⟩

/-- **Condition (4) of Stacks 0GN4 at an arbitrary topology of Stacks 06TP, from one equalizing
morphism which dominates every equalizing morphism after a covering taken downstairs.** Let
`a, b : x ⟶ x'` be two morphisms of the site of `𝒳` at a topology `τ` on the underlying category of
schemes of `B`, and let `p_V : V ⟶ x` be a morphism with `p_V ≫ a = p_V ≫ b`. Suppose that for
every morphism `α : y ⟶ x` of the site with `α ≫ a = α ≫ b` there is a covering sieve `R` of the
*scheme* `y` lies over such that over each member `k` of `R` there are a morphism `g : w ⟶ y` of
the site lying over `k` and a factorisation `r : w ⟶ V` of `g ≫ α` through `p_V`. Then
`∐ h_V^# ⟶ Equalizer(h_a^#, h_b^#)` is a surjection of sheaves of sets, for the one-member family
`V` with the morphism `p_V`.

This is the analogue for condition (4) of
`AlgebraicGeometry.Stack`
`.isLocallySurjective_prodLift_associatedTopology_of_exists_quadruple_dominating_base`, and it is
the shape **Stacks 06QA**, `AlgebraicGeometry.Stack.exists_fppfCovering_fibre_lift`, produces at
the fppf topology for a surjective, flat, locally finitely presented 1-morphism onto an algebraic
stack, and **Stacks 06XH** part (2), `AlgebraicGeometry.Stack.exists_etaleCovering_fibre_lift`,
produces at the étale topology for a surjective smooth one; see the module documentation for which
algebraic stack is meant and what is needed to produce `p_V` from a presentation of it.

Nothing of a particular topology is used. The sheaf-level criterion
`CategoryTheory.Sheaf.isLocallySurjective_sigmaDesc_equalizerLift_of_exists_covering` holds on any
site, and the family of morphisms `g` is a covering family of `y` because every morphism of a
category fibred in groupoids is strongly cartesian over its image and the images of the members
generate `R`, each one agreeing with its member after the comparison isomorphism of
`CategoryTheory.Functor.IsHomLift.domain_eq`; the topology of Stacks 06TP is the topology inherited
from the localization of `τ` at `S`, so that covering family generates a covering sieve of the site
with no transport. -/
theorem isLocallySurjective_equalizerLift_associatedTopology_of_exists_dominating_base
    (τ : GrothendieckTopology B.Schemes)
    {x x' : 𝒳.val.obj} (a b : x ⟶ x') {V : 𝒳.val.obj} (pV : V ⟶ x) (hpV : pV ≫ a = pV ≫ b)
    (h : ∀ (y : 𝒳.val.obj) (α : y ⟶ x), α ≫ a = α ≫ b →
      ∃ R ∈ τ.over (B.obj hS) (𝒳.val.p.obj y),
        ∀ ⦃T : BigFppfOver B S hS⦄ ⦃k : T ⟶ 𝒳.val.p.obj y⦄, R.arrows k →
          ∃ (w : 𝒳.val.obj) (g : w ⟶ y) (r : w ⟶ V),
            𝒳.val.p.IsHomLift k g ∧ r ≫ pV = g ≫ α) :
    Sheaf.IsLocallySurjective (Limits.Sigma.desc fun _ : Fin 1 =>
      equalizer.lift
        (f := (Sheaf.sheafifiedYoneda (associatedTopology B S hS 𝒳.val.p τ)).map a)
        (g := (Sheaf.sheafifiedYoneda (associatedTopology B S hS 𝒳.val.p τ)).map b)
        ((Sheaf.sheafifiedYoneda (associatedTopology B S hS 𝒳.val.p τ)).map pV) (by
          simpa only [Functor.map_comp] using
            congrArg (Sheaf.sheafifiedYoneda (associatedTopology B S hS 𝒳.val.p τ)).map hpV)) := by
  classical
  refine Sheaf.isLocallySurjective_sigmaDesc_equalizerLift_of_exists_covering a b
    (fun _ : Fin 1 => V) (fun _ => pV) (fun _ => hpV) ?_
  intro y α hα
  obtain ⟨R, hR, hlift⟩ := h y α hα
  have hch : ∀ i : Σ T : BigFppfOver B S hS, {k : T ⟶ 𝒳.val.p.obj y // R.arrows k},
      ∃ (w : 𝒳.val.obj) (g : w ⟶ y) (r : w ⟶ V),
        𝒳.val.p.IsHomLift i.2.1 g ∧ r ≫ pV = g ≫ α := fun i => hlift i.2.2
  choose w g r hg hr using hch
  refine ⟨Sieve.ofArrows w g, ?_, ?_⟩
  · rw [associatedTopology, Functor.inheritedTopology_eq]
    refine Precoverage.generate_mem_toGrothendieck
      ⟨fun _ q _ => Functor.IsFiberedInGroupoids.isStronglyCartesian
        𝒳.isFiberedInGroupoids q, ?_⟩
    rw [GrothendieckTopology.mem_toPrecoverage_iff, Presieve.map_ofArrows]
    refine (τ.over (B.obj hS)).superset_covering ?_ hR
    intro T k hk
    let i : Σ T' : BigFppfOver B S hS, {k' : T' ⟶ 𝒳.val.p.obj y // R.arrows k'} := ⟨T, k, hk⟩
    have hinst := hg i
    have hdom : 𝒳.val.p.obj (w i) = T := IsHomLift.domain_eq 𝒳.val.p k (g i)
    have hfac : 𝒳.val.p.map (g i) = eqToHom hdom ≫ k := by
      simpa using IsHomLift.fac' 𝒳.val.p k (g i)
    refine ⟨𝒳.val.p.obj (w i), eqToHom hdom.symm, 𝒳.val.p.map (g i),
      Presieve.ofArrows.mk i, ?_⟩
    rw [hfac, eqToHom_trans_assoc]
    simp
  · intro z gg hgg
    obtain ⟨i, c, hc⟩ := (Sieve.mem_ofArrows_iff w g gg).1 hgg
    exact ⟨0, c ≫ r i, by rw [Category.assoc, hr i, ← Category.assoc, ← hc]⟩

/-- **Condition (4) of Stacks 0GN4 for the fppf site, from one equalizing morphism which dominates
every equalizing morphism after a covering taken downstairs.** This is
`AlgebraicGeometry.Stack`
`.isLocallySurjective_equalizerLift_associatedTopology_of_exists_dominating_base` at the big fppf
topology of `B`, the fppf topology of Stacks 06TP being the topology the total category inherits
from `AlgebraicGeometry.BigFppfOver.topology`; it is the shape **Stacks 06QA**,
`AlgebraicGeometry.Stack.exists_fppfCovering_fibre_lift`, produces for a surjective, flat, locally
finitely presented 1-morphism onto an algebraic stack. -/
theorem isLocallySurjective_equalizerLift_fppfTopology_of_exists_dominating_base
    {x x' : 𝒳.val.obj} (a b : x ⟶ x') {V : 𝒳.val.obj} (pV : V ⟶ x) (hpV : pV ≫ a = pV ≫ b)
    (h : ∀ (y : 𝒳.val.obj) (α : y ⟶ x), α ≫ a = α ≫ b →
      ∃ R ∈ BigFppfOver.topology B S hS (𝒳.val.p.obj y),
        ∀ ⦃T : BigFppfOver B S hS⦄ ⦃k : T ⟶ 𝒳.val.p.obj y⦄, R.arrows k →
          ∃ (w : 𝒳.val.obj) (g : w ⟶ y) (r : w ⟶ V),
            𝒳.val.p.IsHomLift k g ∧ r ≫ pV = g ≫ α) :
    Sheaf.IsLocallySurjective (Limits.Sigma.desc fun _ : Fin 1 =>
      equalizer.lift
        (f := (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map a)
        (g := (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map b)
        ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map pV) (by
          simpa only [Functor.map_comp] using
            congrArg (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map hpV)) :=
  isLocallySurjective_equalizerLift_associatedTopology_of_exists_dominating_base
    B S hS 𝒳 B.topology a b pV hpV h

universe w

/-- **Condition (4) of Stacks 0GN4 for the fppf site of an algebraic stack, from one geometric
statement**, in the exact shape
`AlgebraicGeometry.Stack.isIso_colimit_post_rightDerived_globalSections_fppf` consumes as its
hypothesis `h_equalizer`: for two objects `x`, `x'` of the site lying over affine schemes and two
morphisms `a, b : x ⟶ x'` there is a finite family of objects lying over affine schemes, each with
a morphism to `x` equalizing `a` and `b`, whose sheafified representables jointly cover the
equalizer of `h_a^#` and `h_b^#`.

The family has one member, as in the source, and the hypothesis `h_affine_dominating` asks exactly
for that member: an object `V` lying over an affine scheme with an equalizing morphism
`p_V : V ⟶ x` which dominates every equalizing morphism of the site after a covering taken in the
big fppf category over `S`, localized at the chosen topology `τ`. The covering assertion is then
`AlgebraicGeometry.Stack`
`.isLocallySurjective_equalizerLift_associatedTopology_of_exists_dominating_base`. See the module
documentation for which 2-fibre product the source covers by an affine scheme to produce `V`, and
why the two geometric inputs that discharged condition (3) in
`StacksFrontier/AlgebraicGeometry/Stacks/ColimitsOfCohomologyProductAffineCover.lean` do not produce
it. -/
theorem exists_fin_affineObjects_isLocallySurjective_equalizerLift_of_dominating_of_topology
    (𝒴 : AlgebraicStacks.{u, w} B S hS) (τ : GrothendieckTopology B.Schemes)
    (h_affine_dominating : ∀ {x x' : 𝒴.val.val.obj} (a b : x ⟶ x'),
      x ∈ affineObjects B S hS 𝒴.val → x' ∈ affineObjects B S hS 𝒴.val →
      ∃ (V : 𝒴.val.val.obj) (pV : V ⟶ x), V ∈ affineObjects B S hS 𝒴.val ∧
        pV ≫ a = pV ≫ b ∧
        ∀ (y : 𝒴.val.val.obj) (α : y ⟶ x), α ≫ a = α ≫ b →
          ∃ R ∈ τ.over (B.obj hS) (𝒴.val.val.p.obj y),
            ∀ ⦃T : BigFppfOver B S hS⦄ ⦃k : T ⟶ 𝒴.val.val.p.obj y⦄, R.arrows k →
              ∃ (w : 𝒴.val.val.obj) (g : w ⟶ y) (r : w ⟶ V),
                𝒴.val.val.p.IsHomLift k g ∧ r ≫ pV = g ≫ α) :
    ∀ {x x' : 𝒴.val.val.obj} (a b : x ⟶ x'),
      x ∈ affineObjects B S hS 𝒴.val → x' ∈ affineObjects B S hS 𝒴.val →
      ∃ (m : ℕ) (V : Fin m → 𝒴.val.val.obj),
        (∀ i, V i ∈ affineObjects B S hS 𝒴.val) ∧
          ∃ (p : ∀ i, V i ⟶ x) (hp : ∀ i, p i ≫ a = p i ≫ b),
          Sheaf.IsLocallySurjective (Limits.Sigma.desc fun i =>
            equalizer.lift
              (f := (Sheaf.sheafifiedYoneda
                (associatedTopology B S hS 𝒴.val.val.p τ)).map a)
              (g := (Sheaf.sheafifiedYoneda
                (associatedTopology B S hS 𝒴.val.val.p τ)).map b)
              ((Sheaf.sheafifiedYoneda
                (associatedTopology B S hS 𝒴.val.val.p τ)).map (p i)) (by
                simpa only [Functor.map_comp] using
                  congrArg (Sheaf.sheafifiedYoneda
                    (associatedTopology B S hS 𝒴.val.val.p τ)).map (hp i))) := by
  intro x x' a b hx hx'
  obtain ⟨V, pV, hVaff, hpV, hdom⟩ := h_affine_dominating a b hx hx'
  exact ⟨1, fun _ => V, fun _ => hVaff, fun _ => pV, fun _ => hpV,
    isLocallySurjective_equalizerLift_associatedTopology_of_exists_dominating_base B S hS 𝒴.val τ
      a b pV hpV hdom⟩

/-- **Condition (4) of Stacks 0GN4 for the fppf site of an algebraic stack, from the one geometric
statement that is still missing**, in the exact shape
`AlgebraicGeometry.Stack.isIso_colimit_post_rightDerived_globalSections_fppf` consumes as its
hypothesis `h_equalizer`.

This is
`AlgebraicGeometry.Stack`
`.exists_fin_affineObjects_isLocallySurjective_equalizerLift_of_dominating_of_topology` above at
the big fppf topology of `B`, the fppf topology of Stacks 06TP being the topology the total
category inherits from `AlgebraicGeometry.BigFppfOver.topology`. -/
theorem exists_fin_affineObjects_isLocallySurjective_equalizerLift_of_exists_affine_dominating
    (𝒴 : AlgebraicStacks.{u, w} B S hS)
    (h_affine_dominating : ∀ {x x' : 𝒴.val.val.obj} (a b : x ⟶ x'),
      x ∈ affineObjects B S hS 𝒴.val → x' ∈ affineObjects B S hS 𝒴.val →
      ∃ (V : 𝒴.val.val.obj) (pV : V ⟶ x), V ∈ affineObjects B S hS 𝒴.val ∧
        pV ≫ a = pV ≫ b ∧
        ∀ (y : 𝒴.val.val.obj) (α : y ⟶ x), α ≫ a = α ≫ b →
          ∃ R ∈ BigFppfOver.topology B S hS (𝒴.val.val.p.obj y),
            ∀ ⦃T : BigFppfOver B S hS⦄ ⦃k : T ⟶ 𝒴.val.val.p.obj y⦄, R.arrows k →
              ∃ (w : 𝒴.val.val.obj) (g : w ⟶ y) (r : w ⟶ V),
                𝒴.val.val.p.IsHomLift k g ∧ r ≫ pV = g ≫ α) :
    ∀ {x x' : 𝒴.val.val.obj} (a b : x ⟶ x'),
      x ∈ affineObjects B S hS 𝒴.val → x' ∈ affineObjects B S hS 𝒴.val →
      ∃ (m : ℕ) (V : Fin m → 𝒴.val.val.obj),
        (∀ i, V i ∈ affineObjects B S hS 𝒴.val) ∧
          ∃ (p : ∀ i, V i ⟶ x) (hp : ∀ i, p i ≫ a = p i ≫ b),
          Sheaf.IsLocallySurjective (Limits.Sigma.desc fun i =>
            equalizer.lift
              (f := (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒴.val)).map a)
              (g := (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒴.val)).map b)
              ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒴.val)).map (p i)) (by
                simpa only [Functor.map_comp] using
                  congrArg (Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒴.val)).map (hp i))) :=
  exists_fin_affineObjects_isLocallySurjective_equalizerLift_of_dominating_of_topology.{u, w}
    B S hS 𝒴 B.topology h_affine_dominating

/-- **Stacks 0GQV in the fppf topology for a quasi-compact algebraic stack which is quasi-separated
over a quasi-separated base scheme, from one geometric statement.**

This is
`AlgebraicGeometry.Stack`
`.isIso_colimit_post_rightDerived_globalSections_fppf_of_isQuasiSeparatedOver`
with its condition (4) discharged by
`AlgebraicGeometry.Stack`
`.exists_fin_affineObjects_isLocallySurjective_equalizerLift_of_exists_affine_dominating`, whose
hypothesis is repeated here verbatim. Condition (3) of Stacks 0GN4 is proved in
`StacksFrontier/AlgebraicGeometry/Stacks/ColimitsOfCohomologyProductAffineCover.lean` and conditions
(1) and (2) are discharged there and in
`StacksFrontier/AlgebraicGeometry/Stacks/ColimitsOfCohomology.lean`, so `h_affine_dominating` is the
*only* thing standing between this and the full assertion of Stacks 0GQV in the fppf topology. It
is proved as `AlgebraicGeometry.Stack.exists_affine_dominating` in
`StacksFrontier/AlgebraicGeometry/Stacks/ColimitsOfCohomologyEqualizerAffineCover.lean`, where this
result with it discharged is
`AlgebraicGeometry.Stack.isIso_colimit_post_rightDerived_globalSections_fppf_of_isQuasiCompact`;
see the module documentation for what it asks. -/
theorem isIso_colimit_post_rightDerived_globalSections_fppf_of_exists_affine_dominating
    (𝒴 : AlgebraicStacks.{u, w} B S hS) (hqsS : QuasiSeparatedSpace S)
    (hqc : IsQuasiCompactStack.{u, w} B S hS 𝒴.val 𝒴.property)
    (h𝒴 : IsQuasiSeparatedOver.{u, w} B S hS 𝒴)
    (h_affine_dominating : ∀ {x x' : 𝒴.val.val.obj} (a b : x ⟶ x'),
      x ∈ affineObjects B S hS 𝒴.val → x' ∈ affineObjects B S hS 𝒴.val →
      ∃ (V : 𝒴.val.val.obj) (pV : V ⟶ x), V ∈ affineObjects B S hS 𝒴.val ∧
        pV ≫ a = pV ≫ b ∧
        ∀ (y : 𝒴.val.val.obj) (α : y ⟶ x), α ≫ a = α ≫ b →
          ∃ R ∈ BigFppfOver.topology B S hS (𝒴.val.val.p.obj y),
            ∀ ⦃T : BigFppfOver B S hS⦄ ⦃k : T ⟶ 𝒴.val.val.p.obj y⦄, R.arrows k →
              ∃ (w : 𝒴.val.val.obj) (g : w ⟶ y) (r : w ⟶ V),
                𝒴.val.val.p.IsHomLift k g ∧ r ≫ pV = g ≫ α)
    (p : ℕ) {I : Type (u + 1)} [SmallCategory I] [IsFiltered I]
    (F : I ⥤ Sheaf (fppfTopology B S hS 𝒴.val) Ab.{u + 1}) :
    IsIso (colimit.post F
      ((Sheaf.Γ (fppfTopology B S hS 𝒴.val) Ab.{u + 1}).rightDerived p)) :=
  isIso_colimit_post_rightDerived_globalSections_fppf_of_isQuasiSeparatedOver.{u, w}
    B S hS 𝒴 hqsS hqc h𝒴
    (exists_fin_affineObjects_isLocallySurjective_equalizerLift_of_exists_affine_dominating.{u, w}
      B S hS 𝒴 h_affine_dominating)
    p F

end AlgebraicGeometry.Stack

