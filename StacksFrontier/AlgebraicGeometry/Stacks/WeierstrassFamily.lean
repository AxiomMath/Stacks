/-!
# The Weierstrass family over the locus where the discriminant is invertible

Let `Δ ∈ ℤ[a₁, a₂, a₃, a₄, a₆]` be the discriminant of the generic Weierstrass equation and let
`W = Spec(ℤ[a₁, a₂, a₃, a₄, a₆, 1/Δ])`. Inside `P²_W` sits the plane cubic
`E_W : zy² + a₁xyz + a₃yz² = x³ + a₂x²z + a₄xz² + a₆z³`, the projection `f_W : E_W → W` is the
structure morphism of `E_W` over `W`, and the point `(0 : 1 : 0)` is a section `0_W` of `f_W`.

## Main definitions

* `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.base` is `W`.
* `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.total` is `E_W`, and
  `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.embedding` is its closed immersion into
  `P²_W`.
* `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.projection` is `f_W` and
  `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.zero` is `0_W`.
* `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.family` is the triple `(E_W, f_W, 0_W)`.
* `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.projOf` and
  `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.familyOf` are the same constructions for a
  Weierstrass equation over an arbitrary ring `R`: the plane cubic in `P²_R` and the pointed
  family over `Spec R` it defines. The objects over `W` are these for the generic equation.

## Main results

* `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.Δ_eq` writes the discriminant out as a
  polynomial in the coefficients, and
  `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.Δ_smul_eq` records that it is homogeneous
  of degree `12` for `deg aᵢ = i`.
* `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.isUnit_curve_Δ`: the discriminant of the
  Weierstrass equation over `W` is invertible, so that equation is an elliptic curve in the sense
  of `WeierstrassCurve.IsElliptic`.
* `AlgebraicGeometry.ModuliEllipticCurves.Weierstrass.zero_projection`: `0_W` is a section of
  `f_W`.

## Implementation notes

The discriminant is Mathlib's `WeierstrassCurve.Δ`, which is the polynomial displayed in the
source: `Δ_eq` is that display, verbatim, and `Δ_smul_eq` is its homogeneity. The cubic cutting
out `E_W` is Mathlib's `WeierstrassCurve.Projective.polynomial`, which is the homogeneous
Weierstrass equation of the source, so `x`, `y`, `z` are the variables `0`, `1`, `2` of
`W[x, y, z]` and `(0 : 1 : 0)` is evaluation at `![0, 1, 0]`.

`P²_W` is `Proj W[x, y, z]` for the grading by total degree and `E_W` is `Proj` of the quotient
of `W[x, y, z]` by the homogeneous ideal generated by the cubic, so `E_W ⟶ P²_W` is the morphism
of `Proj` along that quotient map and is a closed immersion with no side condition. Its
structure morphism over `W` is `AlgebraicGeometry.Proj.toSpecZero` followed by the
identification of the degree-zero part of the quotient with the coordinate ring of `W`, which is
an isomorphism: it is surjective because a homogeneous polynomial of degree zero is a constant,
and injective because evaluation at `(0 : 1 : 0)` undoes it. The section is built from that same
evaluation `W[x, y, z]/(F) → Γ(W)`, which is defined because the cubic vanishes at `(0 : 1 : 0)`;
it is a morphism into `Proj` because the class of `y` is homogeneous of degree one and is sent
to `1`.

The coefficients live in the canonical universe copy `ULift.{u} ℤ` of the integers, as in
`AlgebraicGeometry.projectiveSpaceAtUniverse`, so that `W` and the whole family live in an
arbitrary universe rather than only in universe zero.

## References

* [Stacks Project, Tag 072S](https://stacks.math.columbia.edu/tag/072S)
-/

@[expose] public noncomputable section

open CategoryTheory MvPolynomial

universe u

namespace AlgebraicGeometry.ModuliEllipticCurves.Weierstrass

attribute [local instance] MvPolynomial.gradedAlgebra

/-! ### The discriminant -/

/-- The discriminant of a Weierstrass equation, written out as a polynomial in the five
coefficients. -/
@[stacks 072S "the discriminant Δ, written out"]
theorem Δ_eq {R : Type*} [CommRing R] (W : WeierstrassCurve R) :
    W.Δ = -W.a₆ * W.a₁ ^ 6 + W.a₄ * W.a₃ * W.a₁ ^ 5
      + ((-W.a₃ ^ 2 - 12 * W.a₆) * W.a₂ + W.a₄ ^ 2) * W.a₁ ^ 4
      + (8 * W.a₄ * W.a₃ * W.a₂ + (W.a₃ ^ 3 + 36 * W.a₆ * W.a₃)) * W.a₁ ^ 3
      + ((-8 * W.a₃ ^ 2 - 48 * W.a₆) * W.a₂ ^ 2 + 8 * W.a₄ ^ 2 * W.a₂
        + (-30 * W.a₄ * W.a₃ ^ 2 + 72 * W.a₆ * W.a₄)) * W.a₁ ^ 2
      + (16 * W.a₄ * W.a₃ * W.a₂ ^ 2 + (36 * W.a₃ ^ 3 + 144 * W.a₆ * W.a₃) * W.a₂
        - 96 * W.a₄ ^ 2 * W.a₃) * W.a₁
      + (-16 * W.a₃ ^ 2 - 64 * W.a₆) * W.a₂ ^ 3 + 16 * W.a₄ ^ 2 * W.a₂ ^ 2
      + (72 * W.a₄ * W.a₃ ^ 2 + 288 * W.a₆ * W.a₄) * W.a₂
      + (-27 * W.a₃ ^ 4 - 216 * W.a₆ * W.a₃ ^ 2 - 64 * W.a₄ ^ 3 - 432 * W.a₆ ^ 2) := by
  simp only [WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆,
    WeierstrassCurve.b₈]
  ring

/-- The discriminant is homogeneous of degree `12` in the coefficients, where `aᵢ` has degree
`i`: scaling `aᵢ` by `tⁱ` scales `Δ` by `t¹²`. -/
@[stacks 072S "Δ is homogeneous of degree 12 for deg aᵢ = i"]
theorem Δ_smul_eq {R : Type*} [CommRing R] (t a₁ a₂ a₃ a₄ a₆ : R) :
    (⟨t * a₁, t ^ 2 * a₂, t ^ 3 * a₃, t ^ 4 * a₄, t ^ 6 * a₆⟩ : WeierstrassCurve R).Δ =
      t ^ 12 * (⟨a₁, a₂, a₃, a₄, a₆⟩ : WeierstrassCurve R).Δ := by
  simp only [Δ_eq]
  ring

/-! ### The Weierstrass scheme `W` -/

/-- The polynomial ring `ℤ[a₁, a₂, a₃, a₄, a₆]` on the five coefficients of a Weierstrass
equation. -/
abbrev coeffRing : Type u := MvPolynomial (Fin 5) (ULift.{u} ℤ)

/-- The generic Weierstrass equation, whose coefficients are the five variables of
`ℤ[a₁, a₂, a₃, a₄, a₆]`. -/
def generic : WeierstrassCurve coeffRing.{u} := ⟨X 0, X 1, X 2, X 3, X 4⟩

/-- The discriminant `Δ ∈ ℤ[a₁, a₂, a₃, a₄, a₆]` of the generic Weierstrass equation. -/
abbrev discriminant : coeffRing.{u} := generic.Δ

/-- The ring `ℤ[a₁, a₂, a₃, a₄, a₆, 1/Δ]`. -/
abbrev baseRing : Type u := Localization.Away discriminant.{u}

/-- The Weierstrass scheme `W = Spec(ℤ[a₁, a₂, a₃, a₄, a₆, 1/Δ])`. -/
@[stacks 072S "the Weierstrass scheme W"]
abbrev base : Scheme.{u} := Spec (CommRingCat.of baseRing.{u})

/-- The generic Weierstrass equation read over `W`. -/
def curve : WeierstrassCurve baseRing.{u} := generic.{u}.baseChange baseRing.{u}

/-- The discriminant of the Weierstrass equation over `W` is invertible. -/
theorem isUnit_curve_Δ : IsUnit curve.{u}.Δ := by
  rw [curve, WeierstrassCurve.baseChange, WeierstrassCurve.map_Δ]
  exact IsLocalization.Away.algebraMap_isUnit _

/-- The Weierstrass equation over `W` is an elliptic curve. -/
instance : curve.{u}.IsElliptic := ⟨isUnit_curve_Δ⟩

/-! ### The plane cubic of a Weierstrass equation over any ring -/

section Generic

variable {R : Type u} [CommRing R] (C : WeierstrassCurve R)

/-- The homogeneous Weierstrass cubic `zy² + a₁xyz + a₃yz² - x³ - a₂x²z - a₄xz² - a₆z³` of a
Weierstrass equation over `R`, in the homogeneous coordinates `x`, `y`, `z` of `P²_R`. -/
abbrev cubicOf : MvPolynomial (Fin 3) R := C.toProjective.polynomial

/-- The Weierstrass cubic is homogeneous of degree `3`. -/
theorem cubicOf_mem : cubicOf C ∈ homogeneousSubmodule (Fin 3) R 3 := by
  rw [cubicOf, WeierstrassCurve.Projective.polynomial]
  refine Submodule.sub_mem _ (Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) ?_)
    (Submodule.add_mem _ (Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) ?_) ?_) <;>
    rw [mem_homogeneousSubmodule]
  · exact ((isHomogeneous_X _ _).pow 2).mul (isHomogeneous_X _ _)
  · exact (((isHomogeneous_C _ _).mul (isHomogeneous_X _ _)).mul (isHomogeneous_X _ _)).mul
      (isHomogeneous_X _ _)
  · exact ((isHomogeneous_C _ _).mul (isHomogeneous_X _ _)).mul ((isHomogeneous_X _ _).pow 2)
  · exact (isHomogeneous_X _ _).pow 3
  · exact ((isHomogeneous_C _ _).mul ((isHomogeneous_X _ _).pow 2)).mul (isHomogeneous_X _ _)
  · exact ((isHomogeneous_C _ _).mul (isHomogeneous_X _ _)).mul ((isHomogeneous_X _ _).pow 2)
  · exact (isHomogeneous_C _ _).mul ((isHomogeneous_X _ _).pow 3)

/-- The homogeneous ideal of `R[x, y, z]` generated by the Weierstrass cubic. -/
def cubicIdealOf : HomogeneousIdeal (homogeneousSubmodule (Fin 3) R) where
  toSubmodule := Ideal.span {cubicOf C}
  is_homogeneous' := Ideal.homogeneous_span _ _ <| by
    rintro x hx
    rw [Set.mem_singleton_iff] at hx
    exact ⟨3, hx ▸ cubicOf_mem C⟩

/-- The homogeneous coordinate ring `R[x, y, z]/(F)` of the plane cubic. -/
abbrev coordRingOf : Type u := MvPolynomial (Fin 3) R ⧸ (cubicIdealOf C).toIdeal

/-- The grading of the homogeneous coordinate ring of the plane cubic by total degree. -/
abbrev gradingOf : ℕ → AddSubgroup (coordRingOf C) :=
  Stacks.HomogeneousIdeal.quotientGrading (cubicIdealOf C)

/-- The plane cubic `E ⊂ P²_R` cut out by a Weierstrass equation over `R`. -/
def projOf : Scheme.{u} := Proj (gradingOf C)

/-- The closed immersion of the plane cubic into `P²_R`. -/
def embeddingOf : projOf C ⟶ Proj (homogeneousSubmodule (Fin 3) R) :=
  Proj.map (Stacks.HomogeneousIdeal.quotientMk (cubicIdealOf C))
    (Proj.irrelevant_le_map_of_surjective _ (Stacks.HomogeneousIdeal.surjective_quotientMk _))

/-- The morphism from the plane cubic to `P²_R` is a closed immersion. -/
instance : IsClosedImmersion (embeddingOf C) := Proj.isClosedImmersion_map_quotientMk _

/-- The coefficient ring `R` sits in the homogeneous coordinate ring of the plane cubic as the
degree-zero part, as the classes of the constants. -/
def toGradingZeroOf : R →+* gradingOf C 0 where
  toFun a := ⟨Ideal.Quotient.mk _ (MvPolynomial.C a),
    Stacks.HomogeneousIdeal.mk_mem_quotientGrading _
      (by rw [mem_homogeneousSubmodule]; exact isHomogeneous_C _ _)⟩
  map_one' := Subtype.ext (by simp)
  map_mul' a b := Subtype.ext (by simp)
  map_zero' := Subtype.ext (by simp)
  map_add' a b := Subtype.ext (by simp)

/-- Evaluation of the homogeneous coordinate ring of the plane cubic at the point
`(0 : 1 : 0)`. -/
def evalZeroOf : coordRingOf C →+* R :=
  Ideal.Quotient.lift _ (aeval (![0, 1, 0] : Fin 3 → R)).toRingHom <| by
    intro a ha
    obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    simp [cubicOf, WeierstrassCurve.Projective.polynomial]

/-- Evaluating the class of a constant `a` at `(0 : 1 : 0)` gives back `a`. -/
theorem evalZeroOf_toGradingZeroOf (a : R) :
    evalZeroOf C ((toGradingZeroOf C a : coordRingOf C)) = a := by
  simp only [toGradingZeroOf, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, evalZeroOf,
    Ideal.Quotient.lift_mk, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_C,
    Algebra.algebraMap_self_apply]

/-- The map from `R` to the degree-zero part of the homogeneous coordinate ring of the plane cubic
is bijective. -/
theorem bijective_toGradingZeroOf : Function.Bijective (toGradingZeroOf C) := by
  refine ⟨fun a b hab => ?_, fun x => ?_⟩
  · have h := congrArg (fun y : gradingOf C 0 => evalZeroOf C (y : coordRingOf C)) hab
    rwa [evalZeroOf_toGradingZeroOf, evalZeroOf_toGradingZeroOf] at h
  · obtain ⟨p, hp, hpx⟩ := (Stacks.HomogeneousIdeal.mem_quotientGrading_iff _ x.1).mp x.2
    rw [mem_homogeneousSubmodule, ← totalDegree_zero_iff_isHomogeneous,
      totalDegree_eq_zero_iff_eq_C] at hp
    refine ⟨p.coeff 0, Subtype.ext ?_⟩
    change (Ideal.Quotient.mk (cubicIdealOf C).toIdeal) (MvPolynomial.C (p.coeff 0)) =
      (x : coordRingOf C)
    exact (congrArg (Ideal.Quotient.mk (cubicIdealOf C).toIdeal) hp).symm.trans hpx

/-- The degree-zero part of the homogeneous coordinate ring of the plane cubic is `R`. -/
def gradingZeroEquivOf : R ≃+* gradingOf C 0 :=
  RingEquiv.ofBijective (toGradingZeroOf C) (bijective_toGradingZeroOf C)

/-- The map from `R` to the degree-zero part of the homogeneous coordinate ring of the plane cubic
is an isomorphism of commutative rings. -/
instance isIso_ofHom_toGradingZeroOf : IsIso (CommRingCat.ofHom (toGradingZeroOf C)) := by
  have h : CommRingCat.ofHom (toGradingZeroOf C) = (gradingZeroEquivOf C).toCommRingCatIso.hom :=
    CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
  rw [h]
  infer_instance

/-- The projection `E ⟶ Spec R` of the plane cubic. -/
def projectionOf : projOf C ⟶ Spec (CommRingCat.of R) :=
  Proj.toSpecZero (gradingOf C) ≫ Spec.map (CommRingCat.ofHom (toGradingZeroOf C))

/-- Evaluation at `(0 : 1 : 0)`, as a map to the global sections of `Spec R`. -/
def evalZeroGlobalOf : coordRingOf C →+* Γ(Spec (CommRingCat.of R), ⊤) :=
  ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom).comp (evalZeroOf C)

/-- The irrelevant ideal of the homogeneous coordinate ring of the plane cubic generates the unit
ideal under evaluation at `(0 : 1 : 0)`. -/
theorem map_irrelevant_eq_top_of :
    (HomogeneousIdeal.irrelevant (gradingOf C)).toIdeal.map (evalZeroGlobalOf C) = ⊤ := by
  rw [Ideal.eq_top_iff_one]
  have hy : (Ideal.Quotient.mk (cubicIdealOf C).toIdeal (X 1)) ∈
      (HomogeneousIdeal.irrelevant (gradingOf C)).toIdeal :=
    HomogeneousIdeal.mem_irrelevant_of_mem _ Nat.one_pos
      (Stacks.HomogeneousIdeal.mk_mem_quotientGrading _
        (by rw [mem_homogeneousSubmodule]; exact isHomogeneous_X _ _))
  have h1 : evalZeroGlobalOf C (Ideal.Quotient.mk (cubicIdealOf C).toIdeal (X 1)) = 1 := by
    simp [evalZeroGlobalOf, evalZeroOf]
  exact h1 ▸ Ideal.mem_map_of_mem _ hy

/-- The section `Spec R ⟶ E` at infinity, the point `(0 : 1 : 0)`. -/
def zeroOf : Spec (CommRingCat.of R) ⟶ projOf C :=
  Proj.fromOfGlobalSections (gradingOf C) (evalZeroGlobalOf C) (map_irrelevant_eq_top_of C)

/-- The point `(0 : 1 : 0)` is a section of the projection of the plane cubic to `Spec R`. -/
theorem zeroOf_projectionOf : zeroOf C ≫ projectionOf C = 𝟙 _ := by
  have key : CommRingCat.ofHom (((evalZeroGlobalOf C).comp
      (algebraMap (gradingOf C 0) (coordRingOf C))).comp (toGradingZeroOf C)) =
      (Scheme.ΓSpecIso (CommRingCat.of R)).inv := by
    refine CommRingCat.hom_ext (RingHom.ext fun a => ?_)
    simpa only [CommRingCat.hom_ofHom, RingHom.comp_apply, SetLike.GradeZero.algebraMap_apply,
      evalZeroGlobalOf] using congrArg
        (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom (evalZeroOf_toGradingZeroOf C a)
  change Proj.fromOfGlobalSections (gradingOf C) (evalZeroGlobalOf C)
      (map_irrelevant_eq_top_of C) ≫ Proj.toSpecZero (gradingOf C) ≫
      Spec.map (CommRingCat.ofHom (toGradingZeroOf C)) = 𝟙 _
  rw [Proj.fromOfGlobalSections_toSpecZero_assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, key]
  exact toSpecΓ_SpecMap_ΓSpecIso_inv _

/-- The plane cubic of a Weierstrass equation over `R`, with its section `(0 : 1 : 0)` at
infinity, as a pointed family over `Spec R`. -/
def familyOf : PointedFamily (Spec (CommRingCat.of R)) where
  total := projOf C
  map := projectionOf C
  zero := zeroOf C
  zero_map := zeroOf_projectionOf C

end Generic

/-! ### The plane cubic `E_W` -/

/-- The homogeneous Weierstrass cubic `zy² + a₁xyz + a₃yz² - x³ - a₂x²z - a₄xz² - a₆z³` over
`W`, in the homogeneous coordinates `x`, `y`, `z` of `P²_W`. -/
abbrev cubic : MvPolynomial (Fin 3) baseRing.{u} := cubicOf curve.{u}

/-- The homogeneous coordinate ring `W[x, y, z]/(F)` of `E_W`. -/
abbrev coordRing : Type u := coordRingOf curve.{u}

/-- The grading of the homogeneous coordinate ring of `E_W` by total degree. -/
abbrev grading : ℕ → AddSubgroup coordRing.{u} := gradingOf curve.{u}

/-- The projective plane `P²_W = Proj W[x, y, z]` over `W`. -/
def projectivePlane : Scheme.{u} := Proj (homogeneousSubmodule (Fin 3) baseRing.{u})

/-- The plane cubic `E_W ⊂ P²_W` cut out by the Weierstrass equation over `W`. -/
@[stacks 072S "the plane cubic E_W"]
abbrev total : Scheme.{u} := projOf curve.{u}

/-- The closed immersion of `E_W` into `P²_W`. -/
@[stacks 072S "E_W is a closed subscheme of P²_W"]
abbrev embedding : total.{u} ⟶ projectivePlane.{u} := embeddingOf curve.{u}

/-! ### The projection `f_W` and the section `0_W` -/

/-- The projection `f_W : E_W ⟶ W`. -/
@[stacks 072S "the projection f_W : E_W → W"]
abbrev projection : total.{u} ⟶ base.{u} := projectionOf curve.{u}

/-- The section `0_W : W ⟶ E_W` at infinity, the point `(0 : 1 : 0)`. -/
@[stacks 072S "the section 0_W = (0 : 1 : 0)"]
abbrev zero : base.{u} ⟶ total.{u} := zeroOf curve.{u}

/-- The point `0_W` is a section of `f_W`. -/
theorem zero_projection : zero.{u} ≫ projection.{u} = 𝟙 base.{u} := zeroOf_projectionOf _

/-! ### The family -/

/-- The Weierstrass family `(E_W, f_W, 0_W)`: the plane cubic over
`W = Spec(ℤ[a₁, a₂, a₃, a₄, a₆, 1/Δ])` with the section `(0 : 1 : 0)` at infinity. -/
@[stacks 072S "the triple (E_W, f_W, 0_W)"]
abbrev family : PointedFamily base.{u} := familyOf curve.{u}

end AlgebraicGeometry.ModuliEllipticCurves.Weierstrass

end
