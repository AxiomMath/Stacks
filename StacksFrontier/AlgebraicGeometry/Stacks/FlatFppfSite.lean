module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Stacks.AssociatedSite
public import StacksFrontier.AlgebraicGeometry.Stacks.FlatAlgebraicStack
public import StacksFrontier.AlgebraicGeometry.Stacks.SmoothLocalMorphism

/-!
# The flat-fppf site of an algebraic stack (Stacks 0787, `flat_fppf_site`)

Let `𝒳` be an algebraic stack over `S`. Stacks 0787 calls an object `x` of `𝒳`, lying over a
scheme `U` over `S`, *flat* when the 1-morphism `x : U → 𝒳` it names under the 2-Yoneda lemma is
flat, and takes the full subcategory of the flat objects. A family of morphisms of flat objects
covers when its image in the big fppf category of `S` is one of that site's chosen covering
families, and the topology is the one those families generate.

## Main definitions

* `AlgebraicGeometry.Stack.flatObject`: flatness of an object of a category fibred in groupoids
  over the big fppf category of `S`.
* `AlgebraicGeometry.Stack.FlatFppf`: **Stacks 0787**, `flat_fppf_site` — the underlying
  category.
* `AlgebraicGeometry.Stack.FlatFppf.inclusion`: its inclusion into the objects of the stack.
* `AlgebraicGeometry.Stack.FlatFppf.IsCovering`: **Stacks 0787**, `flat_fppf_site` — the
  covering families.
* `AlgebraicGeometry.Stack.FlatFppf.precoverage` and
  `AlgebraicGeometry.Stack.FlatFppf.topology`: **Stacks 0787**, `flat_fppf_site` — the site
  structure.

## Implementation notes

`flatObject` is a declaration of **Stacks 0H14**, not of 0787; it is written here because
nothing in the library carries it yet and 0787 is what consumes it, and it is registered under
0787's own part key by `add_to_stacks` rather than under 0H14. **A formalization of Stacks
0H14 should reuse this declaration** rather than introduce a duplicate constant. Its two
ingredients are both in the library: the 1-morphism `x : U → 𝒳` is
`AlgebraicGeometry.Stack.objectMorphism` (`AssociatedSite.lean`), and flatness of it is the
existential smooth-diagram criterion `AlgebraicGeometry.Stack.HasPropertyOnSomeSmoothDiagram`
(condition (2) of **Stacks 06FM**) at `AlgebraicGeometry.Space.IsFlat` (**Stacks 03ML**) — the
same proposition `AlgebraicGeometry.Stack.AlgebraicStacks.IsFlat` (**Stacks 06PW**)
writes out, now applied to a 1-morphism out of a represented category rather than to a
1-morphism of algebraic stacks.

The covering predicate keeps the *family-level* condition of the ambient site rather than only
asking that the generated sieve cover: a family of flat objects covers when its image under the
structure functor is one of the chosen covering families of
`AlgebraicGeometry.BigFppfOver.IsCovering` (**Stacks 021S**, part (1)). Every arrow of a category
fibred in groupoids is cartesian, so no cartesianness clause is needed. The topology is the
Grothendieck topology generated by exactly those families.

**The `lisse_etale_site` part key of Stacks 0787 is not formalized here.** It is the same
construction with smoothness in place of flatness and the étale coverings of **Stacks 03FF** in
place of the fppf ones, and all of that is available —
`AlgebraicGeometry.Stack.AlgebraicStacks.IsSmooth` (**Stacks 075U**) and
`AlgebraicGeometry.etaleCovering` (`@[stacks 03FF "étale coverings"]`) are both in the library.
What is missing is one step of its `schemeStack`: a scheme over `S` has to be read as an
algebraic stack through **Stacks 03YS part (3)**,
`AlgebraicGeometry.Stack.isDeligneMumfordStack_schemeFibredCategory`, which this file does not
have available — only part (2),
`AlgebraicGeometry.Stack.isDeligneMumfordStack_fibredCategory`, and its two producers of
`AlgebraicGeometry.Stack.IsAlgebraicStack` are the one for the category of an algebraic *space*
and the one for a 2-fibre product, neither of which applies to
`AlgebraicGeometry.Stack.schemeFibredCategory` without a transport along the equivalence of
`AlgebraicSpaceStack.lean`. That is 03YS's work, not 0787's.

## References

* [Stacks Project, Tag 021S](https://stacks.math.columbia.edu/tag/021S)
* [Stacks Project, Tag 06FM](https://stacks.math.columbia.edu/tag/06FM)
* [Stacks Project, Tag 0787](https://stacks.math.columbia.edu/tag/0787)
* [Stacks Project, Tag 0H14](https://stacks.math.columbia.edu/tag/0H14)
-/

@[expose] public section

open CategoryTheory

namespace AlgebraicGeometry.Stack

universe u w

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **Stacks 0H14.** An object `x` of a category fibred in groupoids over the big fppf category
of `S` is *flat* when the 1-morphism it names under the 2-Yoneda lemma, from the category
represented by the scheme it lies over, is a flat 1-morphism in the sense of **Stacks 06PW**. -/
abbrev flatObject (𝒳 : CatFiberedInGroupoids.{u, u, u + 1, u + 1} (BigFppfOver B S hS))
    (x : 𝒳.val.obj) : Prop :=
  HasPropertyOnSomeSmoothDiagram B S hS
    (fun _ _ g => Space.IsFlat B S hS g)
    (objectMorphism B S hS 𝒳 (Functor.Fiber.mk (a := x) rfl))

add_to_stacks 0787 "flat_fppf_site: flat objects" AlgebraicGeometry.Stack.flatObject

variable (𝒳 : Stack.AlgebraicStacks.{u, w} B S hS)

/-- **Stacks 0787**, `flat_fppf_site`. The full subcategory of the flat objects of an algebraic
stack over `S`. -/
@[stacks 0787 "the flat-fppf site: its underlying category of flat objects"]
abbrev FlatFppf := ObjectProperty.FullSubcategory (flatObject B S hS 𝒳.val)

namespace FlatFppf

/-- The inclusion of the flat objects of an algebraic stack into all of its objects. -/
abbrev inclusion : FlatFppf B S hS 𝒳 ⥤ 𝒳.val.val.obj :=
  ObjectProperty.ι (flatObject B S hS 𝒳.val)

/-- **Stacks 0787**, `flat_fppf_site`. A family of morphisms of flat objects of an algebraic
stack covers when its image in the big fppf category of `S` is a chosen covering family
there. -/
@[stacks 0787 "the flat-fppf site: its coverings"]
abbrev IsCovering (E : Covering (FlatFppf B S hS 𝒳)) : Prop :=
  BigFppfOver.IsCovering B S hS
    ⟨𝒳.val.val.p.obj ((inclusion B S hS 𝒳).obj E.1),
      (E.2.map (inclusion B S hS 𝒳)).map 𝒳.val.val.p⟩

/-- The precoverage of the flat-fppf site: the families of flat objects inherited from the
chosen fppf covering families of the big site. -/
def precoverage : Precoverage (FlatFppf B S hS 𝒳) where
  coverings U := {R | ∃ E : PreZeroHypercover.{u + 1} U,
    R = E.presieve₀ ∧ IsCovering B S hS 𝒳 ⟨U, E⟩}

/-- **Stacks 0787**, `flat_fppf_site`. The Grothendieck topology of the flat-fppf site: the one
generated by the inherited fppf covering families between flat objects. -/
@[stacks 0787 "the flat-fppf site: its Grothendieck topology"]
abbrev topology : GrothendieckTopology (FlatFppf B S hS 𝒳) :=
  (precoverage B S hS 𝒳).toGrothendieck

end FlatFppf

end AlgebraicGeometry.Stack

end
