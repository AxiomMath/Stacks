module

public import StacksFrontier.AlgebraicGeometry.Stacks.RestrictionDirectImageComparison

/-!
# Chart diagrams out of morphisms of the target, and the factorization lemma

Equation 075M compares the two direct images around the square of Stacks 073N, and
`StacksFrontier/AlgebraicGeometry/Stacks/RestrictionDirectImageComparison.lean` builds the
comparison map out of `AlgebraicGeometry.Space.comparisonChartHom`, the morphism
`f(u_F W) ⟶ u_G V` of `𝒴` attached to a commutative diagram `d` of étale scheme charts.

This file is about the morphisms of `𝒴` into `u_G V`, and it says two things about them.

* **Every** morphism `f(u_F W) ⟶ u_G V`, for `W` an étale scheme chart of `F`, is
  `comparisonChartHom` of a chart diagram, namely of
  `AlgebraicGeometry.Space.chartDiagramOfHom`. Nothing is lost in passing from arbitrary
  morphisms of `𝒴` out of the image of an étale chart to chart diagrams: the two are the same
  data, because `AlgebraicGeometry.Space.schemeChartFunctor` is an equivalence and the
  compatibility `ha` identifies `f(u_F W)` with the chart `W ⟶ F ⟶ G`.
* The **factorization lemma**: a morphism `κ : f(Z) ⟶ u_G V` out of the image of an *arbitrary*
  object `Z` of `𝒳` which admits *any* morphism to the image of an étale chart factors through
  a `comparisonChartHom`. This is the statement that makes the étale charts of `F` suffice for
  the comparison map, even though an arbitrary object of `𝒳` is an arbitrary scheme chart of `F`
  and is not covered by étale ones in any sieve generated by morphisms out of them.

  The chart the factorization uses is not the given one: a morphism `Z ⟶ u_F W₁` carries no
  compatibility with `κ`, so `κ` does not factor through `f(u_F W₁)`. What it does factor
  through is the chart `W₁ ×_G V`, which is étale over `F` because `V ⟶ G` is étale and `W₁` is
  étale over `F`, and which carries the morphism to `V` that a chart diagram needs. That chart
  is a scheme because an étale chart of `G` is a representable morphism.

## Main definitions

* `AlgebraicGeometry.Space.chartDiagramOfHom`: the chart diagram of a morphism
  `f(u_F W) ⟶ u_G V` of `𝒴`.
* `AlgebraicGeometry.Space.chartProdChart`: the étale scheme chart `W ×_G V` of `F` attached to
  an étale scheme chart `W` of `F` and an étale scheme chart `V` of `G`.

## Main results

* `AlgebraicGeometry.Space.comparisonChartHom_chartDiagramOfHom`: the chart diagram of a
  morphism has that morphism as its `comparisonChartHom`.
* `AlgebraicGeometry.Space.exists_chartDiagram_comparisonChartHom_factor`: **the factorization
  lemma.**

## References

* [Stacks Project, Tag 075M](https://stacks.math.columbia.edu/tag/075M)
* [Stacks Project, Tag 073M](https://stacks.math.columbia.edu/tag/073M)
* [Stacks Project, Tag 03ED](https://stacks.math.columbia.edu/tag/03ED)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Space

universe u v w v' w'

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  (F G : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u)
  {𝒳 : Type v} [Category.{w} 𝒳] {𝒴 : Type v'} [Category.{w'} 𝒴]
  (p : 𝒳 ⥤ BigFppfOver B S hS) (q : 𝒴 ⥤ BigFppfOver B S hS)
  (hF : IsAlgebraicSpace B S hS F) (hG : IsAlgebraicSpace B S hS G)
  (eF : StacksRepresentableCFG.EquivalenceOver p
    (presheafOfCategories (F ⋙ typeToCat)).p)
  (eG : StacksRepresentableCFG.EquivalenceOver q
    (presheafOfCategories (G ⋙ typeToCat)).p)
  (f : 𝒳 ⥤ 𝒴)
  (fSpace : (⟨F, hF⟩ : AlgebraicSpaces B S hS) ⟶ ⟨G, hG⟩)
  (ha : schemeChartFunctor B S hS F p eF ⋙ f ≅
    CostructuredArrow.map fSpace.hom ⋙ schemeChartFunctor B S hS G q eG)

/-! ### The chart diagram of a morphism of the target -/

/-- The morphism of scheme charts of `G`, from the chart `W ⟶ F ⟶ G` to the chart `V`, which a
morphism `κ : f(u_F W) ⟶ u_G V` of `𝒴` determines: the compatibility `ha` identifies `f(u_F W)`
with the image of the first chart under `AlgebraicGeometry.Space.schemeChartFunctor`, which is
an equivalence. -/
noncomputable def chartHomOfHom (Z : CostructuredArrow yoneda F) (V : SmallEtale B S hS G)
    (κ : f.obj ((schemeChartFunctor B S hS F p eF).obj Z) ⟶
      (restrictionFunctor B S hS G q eG).obj V) :
    (CostructuredArrow.map fSpace.hom).obj Z ⟶ V.1 :=
  (schemeChartFunctor B S hS G q eG).preimage (ha.inv.app Z ≫ κ)

/-- The image of `AlgebraicGeometry.Space.chartHomOfHom` under the scheme chart functor of `G`
is `ha.inv.app Z ≫ κ`. -/
theorem schemeChartFunctor_map_chartHomOfHom (Z : CostructuredArrow yoneda F)
    (V : SmallEtale B S hS G)
    (κ : f.obj ((schemeChartFunctor B S hS F p eF).obj Z) ⟶
      (restrictionFunctor B S hS G q eG).obj V) :
    (schemeChartFunctor B S hS G q eG).map
        (chartHomOfHom B S hS F G p q hF hG eF eG f fSpace ha Z V κ) =
      ha.inv.app Z ≫ κ :=
  (schemeChartFunctor B S hS G q eG).map_preimage _

/-- The compatibility `ha` followed by the image of `AlgebraicGeometry.Space.chartHomOfHom` is
`κ`. -/
private theorem ha_hom_app_comp_map_chartHomOfHom (Z : CostructuredArrow yoneda F)
    (V : SmallEtale B S hS G)
    (κ : f.obj ((schemeChartFunctor B S hS F p eF).obj Z) ⟶
      (restrictionFunctor B S hS G q eG).obj V) :
    ha.hom.app Z ≫ (schemeChartFunctor B S hS G q eG).map
        (chartHomOfHom B S hS F G p q hF hG eF eG f fSpace ha Z V κ) = κ := by
  rw [schemeChartFunctor_map_chartHomOfHom]
  exact Iso.hom_inv_id_app_assoc ha Z κ

/-- **The chart diagram of a morphism of the target.**  A morphism `κ : f(u_F W) ⟶ u_G V` of
`𝒴`, with `W` an étale scheme chart of `F` and `V` one of `G`, is the `comparisonChartHom` of a
commutative diagram of étale scheme charts, namely of this one. -/
noncomputable def chartDiagramOfHom (W : SmallEtale B S hS F) (V : SmallEtale B S hS G)
    (κ : f.obj ((restrictionFunctor B S hS F p eF).obj W) ⟶
      (restrictionFunctor B S hS G q eG).obj V) :
    ChartDiagram B S hS F G fSpace.hom where
  U := W
  V := V
  g := (chartHomOfHom B S hS F G p q hF hG eF eG f fSpace ha W.1 V κ).left
  comm := (CostructuredArrow.w
    (chartHomOfHom B S hS F G p q hF hG eF eG f fSpace ha W.1 V κ)).symm

/-- The chart of `F` of `AlgebraicGeometry.Space.chartDiagramOfHom` is `W`. -/
@[simp] theorem chartDiagramOfHom_U (W : SmallEtale B S hS F) (V : SmallEtale B S hS G)
    (κ : f.obj ((restrictionFunctor B S hS F p eF).obj W) ⟶
      (restrictionFunctor B S hS G q eG).obj V) :
    (chartDiagramOfHom B S hS F G p q hF hG eF eG f fSpace ha W V κ).U = W :=
  rfl

/-- The chart of `G` of `AlgebraicGeometry.Space.chartDiagramOfHom` is `V`. -/
@[simp] theorem chartDiagramOfHom_V (W : SmallEtale B S hS F) (V : SmallEtale B S hS G)
    (κ : f.obj ((restrictionFunctor B S hS F p eF).obj W) ⟶
      (restrictionFunctor B S hS G q eG).obj V) :
    (chartDiagramOfHom B S hS F G p q hF hG eF eG f fSpace ha W V κ).V = V :=
  rfl

/-- **Every morphism of `𝒴` out of the image of an étale chart into the image of an étale chart
is a `comparisonChartHom`.** -/
theorem comparisonChartHom_chartDiagramOfHom (W : SmallEtale B S hS F)
    (V : SmallEtale B S hS G)
    (κ : f.obj ((restrictionFunctor B S hS F p eF).obj W) ⟶
      (restrictionFunctor B S hS G q eG).obj V) :
    comparisonChartHom B S hS p q eF eG f fSpace ha
        (chartDiagramOfHom B S hS F G p q hF hG eF eG f fSpace ha W V κ) = κ := by
  have hmk : CostructuredArrow.homMk
        (chartDiagramOfHom B S hS F G p q hF hG eF eG f fSpace ha W V κ).g
        (chartDiagramOfHom B S hS F G p q hF hG eF eG f fSpace ha W V κ).comm.symm =
      chartHomOfHom B S hS F G p q hF hG eF eG f fSpace ha W.1 V κ :=
    CostructuredArrow.hom_ext _ _ rfl
  show ha.hom.app W.1 ≫ (schemeChartFunctor B S hS G q eG).map
    (CostructuredArrow.homMk _ _) = κ
  rw [hmk]
  exact ha_hom_app_comp_map_chartHomOfHom B S hS F G p q hF hG eF eG f fSpace ha W.1 V κ

/-! ### The product of an étale chart of `F` with an étale chart of `G` -/

/-- The étale scheme chart `W ×_G V` of `F` attached to an étale scheme chart `W` of `F` and an
étale scheme chart `V` of `G`.

It is a scheme because an étale chart of `G` is a representable morphism, and it is étale over
`F` because the projection to `W` is a base change of the étale `V ⟶ G` and `W` is étale over
`F`. -/
noncomputable def chartProdChart (W : SmallEtale B S hS F) (V : SmallEtale B S hS G) :
    SmallEtale B S hS F :=
  ⟨CostructuredArrow.mk
      (yoneda.map (V.property.rep.snd (W.1.hom ≫ fSpace.hom)) ≫ W.1.hom),
    presheaf_etale_of_isEtale B S hS
      (isEtale_comp B S hS
        (isEtale_of_presheaf_etale B S hS
          ((presheaf_yoneda_map_etale_iff B S hS
            (V.property.rep.snd (W.1.hom ≫ fSpace.hom))).mpr
              (V.property.property_snd (W.1.hom ≫ fSpace.hom))))
        (isEtale_of_presheaf_etale B S hS W.property))⟩

/-- The structure morphism of `W ×_G V` to `F` is the projection to `W` followed by the
structure morphism of `W`. -/
theorem chartProdChart_hom (W : SmallEtale B S hS F) (V : SmallEtale B S hS G) :
    (chartProdChart B S hS F G hF hG fSpace W V).1.hom =
      yoneda.map (V.property.rep.snd (W.1.hom ≫ fSpace.hom)) ≫ W.1.hom :=
  rfl

/-- The projection of `W ×_G V` to the chart `V` of `G`, as a morphism of the big fppf site. -/
noncomputable abbrev chartProdChartToV (W : SmallEtale B S hS F) (V : SmallEtale B S hS G) :
    (SmallEtale.toOver B S hS F).obj (chartProdChart B S hS F G hF hG fSpace W V) ⟶
      (SmallEtale.toOver B S hS G).obj V :=
  V.property.rep.fst' (W.1.hom ≫ fSpace.hom)

/-- The square of `AlgebraicGeometry.Space.chartProdChart` commutes, so that the chart together
with its projection to `V` is a commutative diagram of étale scheme charts. -/
theorem chartProdChart_comm (W : SmallEtale B S hS F) (V : SmallEtale B S hS G) :
    (chartProdChart B S hS F G hF hG fSpace W V).1.hom ≫ fSpace.hom =
      yoneda.map (chartProdChartToV B S hS F G hF hG fSpace W V) ≫ V.1.hom := by
  refine Eq.trans (Category.assoc _ _ _) ?_
  exact (V.property.rep.isPullback' (W.1.hom ≫ fSpace.hom)).w.symm

/-- **The diagram of étale scheme charts of `AlgebraicGeometry.Space.chartProdChart`.** -/
noncomputable def chartProdChartDiagram (W : SmallEtale B S hS F) (V : SmallEtale B S hS G) :
    ChartDiagram B S hS F G fSpace.hom where
  U := chartProdChart B S hS F G hF hG fSpace W V
  V := V
  g := chartProdChartToV B S hS F G hF hG fSpace W V
  comm := chartProdChart_comm B S hS F G hF hG fSpace W V

/-- The morphism of scheme charts of `F` into `W ×_G V` determined by a morphism of charts into
`W` and a morphism of charts of `G` into `V`: the universal property of the fibre product. -/
noncomputable def chartProdChartLift (W : SmallEtale B S hS F) (V : SmallEtale B S hS G)
    (Z : CostructuredArrow yoneda F) (ν : Z ⟶ W.1)
    (ζ : (CostructuredArrow.map fSpace.hom).obj Z ⟶ V.1) :
    Z.left ⟶ (SmallEtale.toOver B S hS F).obj (chartProdChart B S hS F G hF hG fSpace W V) :=
  V.property.rep.lift' ζ.left ν.left
    (Eq.trans (CostructuredArrow.w ζ)
      (Eq.trans (congrArg (fun m ↦ m ≫ fSpace.hom) (CostructuredArrow.w ν).symm)
        (Category.assoc _ _ _)))

/-- The lift into `W ×_G V` followed by the projection to `W` is the given morphism into `W`. -/
theorem chartProdChartLift_snd (W : SmallEtale B S hS F) (V : SmallEtale B S hS G)
    (Z : CostructuredArrow yoneda F) (ν : Z ⟶ W.1)
    (ζ : (CostructuredArrow.map fSpace.hom).obj Z ⟶ V.1) :
    chartProdChartLift B S hS F G hF hG fSpace W V Z ν ζ ≫
        V.property.rep.snd (W.1.hom ≫ fSpace.hom) = ν.left :=
  V.property.rep.lift'_snd _ _ _

/-- The lift into `W ×_G V` followed by the projection to `V` is the given morphism into `V`. -/
theorem chartProdChartLift_fst (W : SmallEtale B S hS F) (V : SmallEtale B S hS G)
    (Z : CostructuredArrow yoneda F) (ν : Z ⟶ W.1)
    (ζ : (CostructuredArrow.map fSpace.hom).obj Z ⟶ V.1) :
    chartProdChartLift B S hS F G hF hG fSpace W V Z ν ζ ≫
        chartProdChartToV B S hS F G hF hG fSpace W V = ζ.left :=
  V.property.rep.lift'_fst _ _ _

/-- The lift into `W ×_G V` is a morphism over `F`: composed with the structure morphism of
`W ×_G V` it gives the structure morphism of `Z`. -/
theorem chartProdChartLift_w (W : SmallEtale B S hS F) (V : SmallEtale B S hS G)
    (Z : CostructuredArrow yoneda F) (ν : Z ⟶ W.1)
    (ζ : (CostructuredArrow.map fSpace.hom).obj Z ⟶ V.1) :
    yoneda.map (chartProdChartLift B S hS F G hF hG fSpace W V Z ν ζ) ≫
        (chartProdChart B S hS F G hF hG fSpace W V).1.hom = Z.hom := by
  refine Eq.trans (Category.assoc _ _ _).symm ?_
  refine Eq.trans (congrArg (fun m ↦ m ≫ W.1.hom) (yoneda.map_comp _ _).symm) ?_
  exact Eq.trans (congrArg (fun m ↦ yoneda.map m ≫ W.1.hom)
    (chartProdChartLift_snd B S hS F G hF hG fSpace W V Z ν ζ)) (CostructuredArrow.w ν)

/-- The morphism of scheme charts of `F` into `W ×_G V`, as a morphism of the category of
scheme charts. -/
noncomputable def chartProdChartLiftHom (W : SmallEtale B S hS F) (V : SmallEtale B S hS G)
    (Z : CostructuredArrow yoneda F) (ν : Z ⟶ W.1)
    (ζ : (CostructuredArrow.map fSpace.hom).obj Z ⟶ V.1) :
    Z ⟶ (chartProdChart B S hS F G hF hG fSpace W V).1 :=
  CostructuredArrow.homMk (chartProdChartLift B S hS F G hF hG fSpace W V Z ν ζ)
    (chartProdChartLift_w B S hS F G hF hG fSpace W V Z ν ζ)

/-- The lift into `W ×_G V`, read as a morphism of scheme charts of `G` and followed by the
projection to `V`, is the given morphism into `V`. -/
theorem chartProdChartLiftHom_comp_toV (W : SmallEtale B S hS F) (V : SmallEtale B S hS G)
    (Z : CostructuredArrow yoneda F) (ν : Z ⟶ W.1)
    (ζ : (CostructuredArrow.map fSpace.hom).obj Z ⟶ V.1) :
    (CostructuredArrow.map fSpace.hom).map
          (chartProdChartLiftHom B S hS F G hF hG fSpace W V Z ν ζ) ≫
        CostructuredArrow.homMk
          (chartProdChartDiagram B S hS F G hF hG fSpace W V).g
          (chartProdChartDiagram B S hS F G hF hG fSpace W V).comm.symm = ζ :=
  CostructuredArrow.hom_ext _ _
    (chartProdChartLift_fst B S hS F G hF hG fSpace W V Z ν ζ)

/-! ### The factorization lemma -/

/-- **`comparisonChartHom` precomposed with the image of a morphism of scheme charts.** The
morphism `f(u_F W) ⟶ u_G V` of a chart diagram, precomposed with the image under `f` of the
morphism of `𝒳` attached to a morphism `μ` of scheme charts into `W`, is the compatibility `ha`
at the source chart followed by the image of `μ` read as a morphism of scheme charts of `G` into
`V`. This is naturality of `ha`, and the source chart is an arbitrary scheme chart of `F`: it is
not required to be étale. -/
theorem comparisonChartHom_comp_schemeChartFunctor_map
    (d : ChartDiagram B S hS F G fSpace.hom) (Z : CostructuredArrow yoneda F) (μ : Z ⟶ d.U.1) :
    f.map ((schemeChartFunctor B S hS F p eF).map μ) ≫
        comparisonChartHom B S hS p q eF eG f fSpace ha d =
      ha.hom.app Z ≫ (schemeChartFunctor B S hS G q eG).map
        ((CostructuredArrow.map fSpace.hom).map μ ≫
          CostructuredArrow.homMk d.g d.comm.symm) := by
  have key : ∀ h₀ : (CostructuredArrow.map fSpace.hom).obj d.U.1 ⟶ d.V.1,
      (schemeChartFunctor B S hS F p eF ⋙ f).map μ ≫
          ha.hom.app d.U.1 ≫ (schemeChartFunctor B S hS G q eG).map h₀ =
        ha.hom.app Z ≫ (schemeChartFunctor B S hS G q eG).map
          ((CostructuredArrow.map fSpace.hom).map μ ≫ h₀) := by
    intro h₀
    rw [← Category.assoc, ha.hom.naturality μ, Category.assoc, Functor.comp_map,
      ← Functor.map_comp]
  exact key _

/-- **The factorization lemma.** Let `V` be an étale scheme chart of `G`, let `Z` be an object of
`𝒳` admitting *some* morphism to the object attached to *some* étale scheme chart `W` of `F`, and
let `κ : f(Z) ⟶ u_G V` be an arbitrary morphism of `𝒴`. Then `κ` factors through the
`comparisonChartHom` of a commutative diagram of étale scheme charts over `V`.

The chart of the diagram is `W ×_G V`, not `W`: the given morphism `Z ⟶ u_F W` carries no
compatibility with `κ`, so `κ` does not factor through `f(u_F W)` — but the pair consisting of
that morphism and of the morphism of scheme charts of `G` that `κ` is through the compatibility
`ha` does define a morphism into `W ×_G V`, and that chart carries the morphism to `V` which a
chart diagram needs.

This is what makes the étale charts of `F` suffice for the comparison map of equation 075M: an
object of `𝒳` is an arbitrary scheme chart of `F`, and the objects coming from étale charts of
`F` do *not* generate a covering sieve of it by morphisms out of them — they only cover it in
the sense of `CategoryTheory.GrothendieckTopology.CoversTop`, i.e. the sources of a covering
sieve admit morphisms to them, which is exactly the hypothesis `n` below. -/
theorem exists_chartDiagram_comparisonChartHom_factor
    (V : SmallEtale B S hS G) (Z : 𝒳) (W : SmallEtale B S hS F)
    (n : Z ⟶ (restrictionFunctor B S hS F p eF).obj W)
    (κ : f.obj Z ⟶ (restrictionFunctor B S hS G q eG).obj V) :
    ∃ (W₂ : SmallEtale B S hS F)
      (g : (SmallEtale.toOver B S hS F).obj W₂ ⟶ (SmallEtale.toOver B S hS G).obj V)
      (comm : W₂.1.hom ≫ fSpace.hom = yoneda.map g ≫ V.1.hom)
      (m : Z ⟶ (restrictionFunctor B S hS F p eF).obj W₂),
      f.map m ≫ comparisonChartHom B S hS p q eF eG f fSpace ha ⟨W₂, V, g, comm⟩ = κ := by
  obtain ⟨Z₀, ⟨ι⟩⟩ : ∃ Z₀ : CostructuredArrow yoneda F,
      Nonempty ((schemeChartFunctor B S hS F p eF).obj Z₀ ≅ Z) :=
    ⟨(schemeChartFunctor B S hS F p eF).objPreimage Z,
      ⟨(schemeChartFunctor B S hS F p eF).objObjPreimageIso Z⟩⟩
  set ν : Z₀ ⟶ W.1 := (schemeChartFunctor B S hS F p eF).preimage (ι.hom ≫ n) with hν
  set ζ : (CostructuredArrow.map fSpace.hom).obj Z₀ ⟶ V.1 :=
    chartHomOfHom B S hS F G p q hF hG eF eG f fSpace ha Z₀ V (f.map ι.hom ≫ κ) with hζ
  refine ⟨chartProdChart B S hS F G hF hG fSpace W V,
    chartProdChartToV B S hS F G hF hG fSpace W V,
    chartProdChart_comm B S hS F G hF hG fSpace W V,
    ι.inv ≫ (schemeChartFunctor B S hS F p eF).map
      (chartProdChartLiftHom B S hS F G hF hG fSpace W V Z₀ ν ζ), ?_⟩
  have hstep := comparisonChartHom_comp_schemeChartFunctor_map B S hS F G p q hF hG eF eG f
    fSpace ha (chartProdChartDiagram B S hS F G hF hG fSpace W V) Z₀
    (chartProdChartLiftHom B S hS F G hF hG fSpace W V Z₀ ν ζ)
  have h2 : ha.hom.app Z₀ ≫ (schemeChartFunctor B S hS G q eG).map
        ((CostructuredArrow.map fSpace.hom).map
            (chartProdChartLiftHom B S hS F G hF hG fSpace W V Z₀ ν ζ) ≫
          CostructuredArrow.homMk
            (chartProdChartDiagram B S hS F G hF hG fSpace W V).g
            (chartProdChartDiagram B S hS F G hF hG fSpace W V).comm.symm) =
      f.map ι.hom ≫ κ := by
    rw [chartProdChartLiftHom_comp_toV]
    exact ha_hom_app_comp_map_chartHomOfHom B S hS F G p q hF hG eF eG f fSpace ha Z₀ V _
  show f.map (ι.inv ≫ (schemeChartFunctor B S hS F p eF).map
        (chartProdChartLiftHom B S hS F G hF hG fSpace W V Z₀ ν ζ)) ≫
      comparisonChartHom B S hS p q eF eG f fSpace ha
        (chartProdChartDiagram B S hS F G hF hG fSpace W V) = κ
  rw [f.map_comp]
  refine (Category.assoc _ _ _).trans ?_
  refine (congrArg (f.map ι.inv ≫ ·) hstep).trans ?_
  refine (congrArg (f.map ι.inv ≫ ·) h2).trans ?_
  refine (Category.assoc _ _ _).symm.trans ?_
  refine (congrArg (· ≫ κ) (f.map_comp ι.inv ι.hom).symm).trans ?_
  rw [ι.inv_hom_id, f.map_id]
  exact Category.id_comp κ

end AlgebraicGeometry.Space

end
