open CategoryTheory CategoryTheory.Limits Opposite

universe v₀ u₀

/-- Sheaves of sets on a site have coproducts over an index type in `Type`, built from the
colimits of the size of the join of the two universes of the site. The instance is needed to form
the finite coproducts of sheafified representables the conditions below speak of, and is restated
in this constructed form — rather than as the `CategoryTheory.Limits.HasColimitsOfSize` at the
join universe which the files proving Stacks 0GN3 and Stacks 0GN4 install — because with the
imports of this file the search that descends from that statement to the coproduct over a finite
index type does not terminate within the elaborator's budget. Pinning the instance at the shape
actually used costs nothing and is local to this file. -/
@[sga "3 IV 4.4.1" "(ii)", sga "4 II 4.8" "special case", sga "4 IV 1.1.2" "b), special case"]
local instance sheafOfTypes_hasCoproduct_join {C : Type u₀} [Category.{v₀} C]
    (J : GrothendieckTopology C) {ι : Type} (A : ι → Sheaf J (Type max u₀ v₀)) :
    HasCoproduct A :=
  letI : HasColimitsOfSize.{max u₀ v₀, max u₀ v₀} (Sheaf J (Type max u₀ v₀)) :=
    Sheaf.instHasColimitsOfSize
  letI : HasColimitsOfSize.{0, 0} (Sheaf J (Type max u₀ v₀)) := hasColimitsOfSizeShrink _
  inferInstance

namespace CategoryTheory.Functor

universe v₁ u₁ v₂ u₂

variable {𝒮 : Type u₁} {𝒳 : Type u₂} [Category.{v₁} 𝒮] [Category.{v₂} 𝒳]

/-- **The factorisations through a strongly cartesian morphism are the factorisations of its
image.** Let `p : 𝒳 ⥤ 𝒮` be a functor, let `k : V ⟶ x` be a morphism of `𝒳` which is strongly
cartesian over its own image, and let `α : y ⟶ x` be any morphism of `𝒳`. Then taking the image
under `p` is a bijection from the morphisms `r : y ⟶ V` with `r ≫ k = α` onto the morphisms
`c : p(y) ⟶ p(V)` with `c ≫ p(k) = p(α)`.

This is the universal property of a strongly cartesian morphism read as a bijection: surjectivity
is the existence of the induced morphism and injectivity is its uniqueness. In a category fibred
in groupoids every morphism is strongly cartesian, so the hypothesis holds of every `k` there, and
nothing else of the fibred structure is used. -/
def IsStronglyCartesian.homEquivBase (p : 𝒳 ⥤ 𝒮) {V x y : 𝒳} (k : V ⟶ x)
    [hk : p.IsStronglyCartesian (p.map k) k] (α : y ⟶ x) :
    {r : y ⟶ V // r ≫ k = α} ≃ {c : p.obj y ⟶ p.obj V // c ≫ p.map k = p.map α} where
  toFun r := ⟨p.map r.1, by rw [← p.map_comp, r.2]⟩
  invFun c := ⟨IsStronglyCartesian.map p (p.map k) k (f' := p.map α) (g := c.1) c.2.symm α,
    IsStronglyCartesian.fac p (p.map k) k c.2.symm α⟩
  left_inv r := by
    ext
    exact (IsStronglyCartesian.map_uniq p (p.map k) k (g := p.map r.1)
      (by rw [← p.map_comp, r.2]) α r.1 r.2).symm
  right_inv c := by
    ext
    have : p.IsHomLift c.1
        (IsStronglyCartesian.map p (p.map k) k (f' := p.map α) (g := c.1) c.2.symm α) :=
      inferInstance
    exact (IsHomLift.eq_of_isHomLift p c.1 _).symm

/-- The base morphism attached to a factorisation is its image under the functor. -/
@[simp]
theorem IsStronglyCartesian.homEquivBase_apply_coe (p : 𝒳 ⥤ 𝒮) {V x y : 𝒳} (k : V ⟶ x)
    [hk : p.IsStronglyCartesian (p.map k) k] (α : y ⟶ x) (r : {r : y ⟶ V // r ≫ k = α}) :
    (IsStronglyCartesian.homEquivBase p k α r).1 = p.map r.1 :=
  rfl

/-- The factorisation attached to a base morphism lies over that base morphism. -/
@[simp]
theorem IsStronglyCartesian.map_homEquivBase_symm_coe (p : 𝒳 ⥤ 𝒮) {V x y : 𝒳} (k : V ⟶ x)
    [hk : p.IsStronglyCartesian (p.map k) k] (α : y ⟶ x)
    (c : {c : p.obj y ⟶ p.obj V // c ≫ p.map k = p.map α}) :
    p.map ((IsStronglyCartesian.homEquivBase p k α).symm c).1 = c.1 :=
  congrArg Subtype.val ((IsStronglyCartesian.homEquivBase p k α).apply_symm_apply c)

/-- **A factorisation through a strongly cartesian morphism is determined by its image.** Two
morphisms `r, r' : y ⟶ V` with `r ≫ k = r' ≫ k` and `p(r) = p(r')` are equal, for `k` strongly
cartesian over its own image.

This is the injectivity half of
`CategoryTheory.Functor.IsStronglyCartesian.homEquivBase`, and is what makes the universally
quantified clause of `AlgebraicGeometry.Stack.homPairEquivBase` a condition on one morphism rather
than on many. -/
theorem IsStronglyCartesian.eq_of_map_eq (p : 𝒳 ⥤ 𝒮) {V x y : 𝒳} (k : V ⟶ x)
    [hk : p.IsStronglyCartesian (p.map k) k] {α : y ⟶ x} {r r' : y ⟶ V}
    (hr : r ≫ k = α) (hr' : r' ≫ k = α) (hmap : p.map r' = p.map r) :
    r' = r :=
  congrArg Subtype.val
    ((IsStronglyCartesian.homEquivBase p k α).injective
      (a₁ := ⟨r', hr'⟩) (a₂ := ⟨r, hr⟩) (Subtype.ext hmap))

end CategoryTheory.Functor

namespace AlgebraicGeometry.Stack

universe u

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
variable (𝒳 : CatFiberedInGroupoids.{u, u, u + 1, u + 1} (BigFppfOver B S hS))

/-- **A pair of morphisms of the fppf site is a base morphism together with one condition.** Fix
objects `x`, `x'` and `V` of the fppf site of `𝒳` with morphisms `p_V : V ⟶ x` and `q_V : V ⟶ x'`,
and let `α : y ⟶ x`, `β : y ⟶ x'` be a pair of morphisms out of a further object. Then taking the
image under the structure functor is a bijection from the factorisations of the pair through
`(p_V, q_V)` — the morphisms `r : y ⟶ V` with `r ≫ p_V = α` and `r ≫ q_V = β` — onto the
morphisms `c : p(y) ⟶ p(V)` of the big fppf category over `S` such that `c ≫ p(p_V) = p(α)` and
every morphism of the site lying over `c` which factors `α` through `p_V` also factors `β` through
`q_V`.

The first condition is base data; the second is the one condition that is not. For `y` lying over
a scheme `T`, the pair `(α, β)` presents `y` simultaneously as a pullback of `x` and as a pullback
of `x'`, hence carries an isomorphism between those two pullbacks over `T`, and the second
condition says that `c` respects it — that isomorphism datum being exactly what an object of the
2-fibre product `U ×_{x, 𝒳, x'} U'` carries beyond its two base morphisms. There is at most one
morphism of the site lying over `c` and factoring `α` through `p_V`, by
`CategoryTheory.Functor.IsStronglyCartesian.eq_of_map_eq`, so the quantified condition is a
condition on a single morphism; see the module documentation for why producing it is what
condition (2)(c) of Stacks 0GMS still needs. -/
def homPairEquivBase {x x' V y : 𝒳.val.obj} (pV : V ⟶ x) (qV : V ⟶ x')
    (α : y ⟶ x) (β : y ⟶ x') :
    {r : y ⟶ V // r ≫ pV = α ∧ r ≫ qV = β} ≃
      {c : 𝒳.val.p.obj y ⟶ 𝒳.val.p.obj V //
        c ≫ 𝒳.val.p.map pV = 𝒳.val.p.map α ∧
          ∀ r : y ⟶ V, 𝒳.val.p.map r = c → r ≫ pV = α → r ≫ qV = β} :=
  letI : 𝒳.val.p.IsStronglyCartesian (𝒳.val.p.map pV) pV :=
    𝒳.isFiberedInGroupoids.isStronglyCartesian pV
  { toFun := fun r =>
      ⟨𝒳.val.p.map r.1, by rw [← Functor.map_comp, r.2.1], fun r' hmap hr' => by
        rw [Functor.IsStronglyCartesian.eq_of_map_eq 𝒳.val.p pV r.2.1 hr' hmap]
        exact r.2.2⟩
    invFun := fun c =>
      ⟨((Functor.IsStronglyCartesian.homEquivBase 𝒳.val.p pV α).symm ⟨c.1, c.2.1⟩).1,
        ((Functor.IsStronglyCartesian.homEquivBase 𝒳.val.p pV α).symm ⟨c.1, c.2.1⟩).2,
        c.2.2 _
          (Functor.IsStronglyCartesian.map_homEquivBase_symm_coe 𝒳.val.p pV α ⟨c.1, c.2.1⟩)
          ((Functor.IsStronglyCartesian.homEquivBase 𝒳.val.p pV α).symm ⟨c.1, c.2.1⟩).2⟩
    left_inv := fun r => by
      have h : ((Functor.IsStronglyCartesian.homEquivBase 𝒳.val.p pV α).symm
          ((Functor.IsStronglyCartesian.homEquivBase 𝒳.val.p pV α) ⟨r.1, r.2.1⟩)).1 = r.1 :=
        congrArg Subtype.val
          ((Functor.IsStronglyCartesian.homEquivBase 𝒳.val.p pV α).symm_apply_apply ⟨r.1, r.2.1⟩)
      exact Subtype.ext h
    right_inv := fun c =>
      Subtype.ext
        (Functor.IsStronglyCartesian.map_homEquivBase_symm_coe 𝒳.val.p pV α ⟨c.1, c.2.1⟩) }

/-- **Condition (2)(c) of Stacks 0GMS for the fppf site, from a factorisation over a single
morphism.** Let `V_i` be a finite family of objects of the fppf site of `𝒳` with morphisms
`p_i : V_i ⟶ x` and `q_i : V_i ⟶ x'`, and suppose every pair of morphisms `α : y ⟶ x`,
`β : y ⟶ x'` admits a *single* morphism `g : w ⟶ y` whose singleton generates a covering sieve of
`y` and through which the pair factors, compatibly with some `(p_i, q_i)`. Then
`∐_i h_{V_i}^# ⟶ h_x^# ⨯ h_{x'}^#` is a surjection of fppf sheaves of sets.

This is `AlgebraicGeometry.Stack.isLocallySurjective_prodLift_fppfTopology_of_exists_covering`
with the covering sieve taken to be the one generated by `g`: an arrow of that sieve is `e ≫ g`
for some `e`, and `e ≫ r` factors it. The single-morphism form is the one the source's argument
produces, a smooth presentation of a 2-fibre product being a single morphism. -/
theorem isLocallySurjective_prodLift_fppfTopology_of_exists_singleton_lift
    {x x' : 𝒳.val.obj} {m : ℕ} (V : Fin m → 𝒳.val.obj)
    (p : ∀ i, V i ⟶ x) (q : ∀ i, V i ⟶ x')
    (h : ∀ (y : 𝒳.val.obj) (α : y ⟶ x) (β : y ⟶ x'),
      ∃ (w : 𝒳.val.obj) (g : w ⟶ y),
        Sieve.generate (Presieve.singleton g) ∈ fppfTopology B S hS 𝒳 y ∧
          ∃ (i : Fin m) (r : w ⟶ V i), r ≫ p i = g ≫ α ∧ r ≫ q i = g ≫ β) :
    Sheaf.IsLocallySurjective (Limits.Sigma.desc fun i =>
      prod.lift ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (p i))
        ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (q i))) := by
  refine isLocallySurjective_prodLift_fppfTopology_of_exists_covering B S hS 𝒳 V p q ?_
  intro y α β
  obtain ⟨w, g, hcov, i, r, hr, hr'⟩ := h y α β
  refine ⟨Sieve.generate (Presieve.singleton g), hcov, ?_⟩
  rintro z g' ⟨W, e, gg, hgg, rfl⟩
  cases hgg
  exact ⟨i, e ≫ r, by rw [Category.assoc, hr, ← Category.assoc],
    by rw [Category.assoc, hr', ← Category.assoc]⟩

/-- **Condition (2)(c) of Stacks 0GMS for the fppf site, with the covering taken downstairs.** The
hypothesis of
`AlgebraicGeometry.Stack.isLocallySurjective_prodLift_fppfTopology_of_exists_singleton_lift` with
the covering requirement moved to the big fppf category over `S`: it is enough that the pair
`(α, β)` factor through a single `g : w ⟶ y` whose image is refined by a covering sieve of `p(y)`,
in the sense that every arrow of that sieve factors through `p(g)`.

The passage upstairs is `CategoryTheory.Functor.generate_singleton_mem_inheritedTopology`, every
morphism of a category fibred in groupoids being strongly cartesian; the fppf topology of
Stacks 06TP is the topology inherited from `AlgebraicGeometry.BigFppfOver.topology`, so the
conclusion of that lemma is literally a covering sieve of the fppf site. -/
theorem isLocallySurjective_prodLift_fppfTopology_of_exists_base_covering
    {x x' : 𝒳.val.obj} {m : ℕ} (V : Fin m → 𝒳.val.obj)
    (p : ∀ i, V i ⟶ x) (q : ∀ i, V i ⟶ x')
    (h : ∀ (y : 𝒳.val.obj) (α : y ⟶ x) (β : y ⟶ x'),
      ∃ (w : 𝒳.val.obj) (g : w ⟶ y) (R : Sieve (𝒳.val.p.obj y)),
        R ∈ BigFppfOver.topology B S hS (𝒳.val.p.obj y) ∧
          (∀ ⦃T : BigFppfOver B S hS⦄ (u : T ⟶ 𝒳.val.p.obj y), R.arrows u →
            ∃ v : T ⟶ 𝒳.val.p.obj w, v ≫ 𝒳.val.p.map g = u) ∧
          ∃ (i : Fin m) (r : w ⟶ V i), r ≫ p i = g ≫ α ∧ r ≫ q i = g ≫ β) :
    Sheaf.IsLocallySurjective (Limits.Sigma.desc fun i =>
      prod.lift ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (p i))
        ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (q i))) := by
  have : 𝒳.val.p.IsFibered := 𝒳.isFiberedInGroupoids.isFibered
  refine isLocallySurjective_prodLift_fppfTopology_of_exists_singleton_lift B S hS 𝒳 V p q ?_
  intro y α β
  obtain ⟨w, g, R, hR, hfac, hrest⟩ := h y α β
  exact ⟨w, g, 𝒳.val.p.generate_singleton_mem_inheritedTopology
    (BigFppfOver.topology B S hS) g (𝒳.isFiberedInGroupoids.isStronglyCartesian g) hR hfac,
    hrest⟩

/-- **Condition (2)(c) of Stacks 0GMS for the fppf site, from base data alone.** The hypothesis of
`AlgebraicGeometry.Stack.isLocallySurjective_prodLift_fppfTopology_of_exists_base_covering` with
the factorisation of the pair replaced, through
`AlgebraicGeometry.Stack.homPairEquivBase`, by a morphism `c` of the big fppf category over `S`:
apart from the one covering morphism `g : w ⟶ y`, the hypothesis now mentions only morphisms of
the base and the single condition that a morphism of the site lying over `c` and factoring
`g ≫ α` through `p_i` also factors `g ≫ β` through `q_i`.

This is the form of condition (2)(c) that the source's argument is set up to discharge: `g` and
the covering sieve of `p(y)` come from base-changing a surjective smooth presentation of the
2-fibre product `U ×_{x, 𝒳, x'} U'` by an affine scheme, and `c` from the presentation itself. See
the module documentation for the one step that is still missing, namely the identification of the
objects of that 2-fibre product with the pairs of morphisms of the site, which is what would
supply the last condition. -/
theorem isLocallySurjective_prodLift_fppfTopology_of_exists_base_hom
    {x x' : 𝒳.val.obj} {m : ℕ} (V : Fin m → 𝒳.val.obj)
    (p : ∀ i, V i ⟶ x) (q : ∀ i, V i ⟶ x')
    (h : ∀ (y : 𝒳.val.obj) (α : y ⟶ x) (β : y ⟶ x'),
      ∃ (w : 𝒳.val.obj) (g : w ⟶ y) (R : Sieve (𝒳.val.p.obj y)),
        R ∈ BigFppfOver.topology B S hS (𝒳.val.p.obj y) ∧
          (∀ ⦃T : BigFppfOver B S hS⦄ (u : T ⟶ 𝒳.val.p.obj y), R.arrows u →
            ∃ v : T ⟶ 𝒳.val.p.obj w, v ≫ 𝒳.val.p.map g = u) ∧
          ∃ (i : Fin m) (c : 𝒳.val.p.obj w ⟶ 𝒳.val.p.obj (V i)),
            c ≫ 𝒳.val.p.map (p i) = 𝒳.val.p.map (g ≫ α) ∧
              ∀ r : w ⟶ V i, 𝒳.val.p.map r = c → r ≫ p i = g ≫ α → r ≫ q i = g ≫ β) :
    Sheaf.IsLocallySurjective (Limits.Sigma.desc fun i =>
      prod.lift ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (p i))
        ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (q i))) := by
  refine isLocallySurjective_prodLift_fppfTopology_of_exists_base_covering B S hS 𝒳 V p q ?_
  intro y α β
  obtain ⟨w, g, R, hR, hfac, i, c, hc, hmatch⟩ := h y α β
  exact ⟨w, g, R, hR, hfac, i, _,
    ((homPairEquivBase B S hS 𝒳 (p i) (q i) (g ≫ α) (g ≫ β)).symm ⟨c, hc, hmatch⟩).2⟩

section Quadruples

-- `Functor.Fiber` is a plain `def`, so an object of the site and the object of a fibre of the
-- structure functor it names are not interchangeable at `implicit` transparency; and
-- `Bicategory.InducedBicategory`, which `CatFiberedInGroupoids` abbreviates, is semireducible,
-- so `𝒳.val` is not type-correct at that transparency either. Without both, `rw` declines to
-- abstract over any subterm of the goals below.
attribute [local implicit_reducible] Functor.Fiber Bicategory.InducedBicategory

/-- An object of the fppf site of `𝒳`, read as an object of the fibre of the structure functor
over the scheme it lies over. This is the form in which the 2-Yoneda lemma, hence
`CategoryTheory.TwoFibreProductOver.twoYonedaPair`, consumes it. -/
abbrev fibreObj (x : 𝒳.val.obj) : 𝒳.val.p.Fiber (𝒳.val.p.obj x) := Functor.Fiber.mk rfl

/-- The 2-fibre product `U ×_{x, 𝒳, x'} U'` of the slices represented by two objects `x`, `x'`
of the fppf site of `𝒳` through the 2-Yoneda lemma, `U` and `U'` being the schemes they lie
over. Its objects are the quadruples of Stacks 0040; see
`CategoryTheory.TwoFibreProductOver.twoYonedaPair`. -/
abbrev twoFibreProductObjects (x x' : 𝒳.val.obj) : Type (u + 1) :=
  TwoFibreProductOver.twoYonedaPair 𝒳.isFiberedInGroupoids (fibreObj B S hS 𝒳 x)
    (fibreObj B S hS 𝒳 x')

variable {x x' : 𝒳.val.obj}

/-- The object of the fppf site a quadruple of `U ×_{x, 𝒳, x'} U'` classifies. -/
abbrev quadObj (P : twoFibreProductObjects B S hS 𝒳 x x') : 𝒳.val.obj :=
  TwoFibreProductOver.TwoYonedaPair.objOf 𝒳.isFiberedInGroupoids (fibreObj B S hS 𝒳 x)
    (fibreObj B S hS 𝒳 x') P

/-- The first of the two morphisms of the fppf site a quadruple of `U ×_{x, 𝒳, x'} U'`
classifies. -/
abbrev quadFst (P : twoFibreProductObjects B S hS 𝒳 x x') : quadObj B S hS 𝒳 P ⟶ x :=
  TwoFibreProductOver.TwoYonedaPair.fstHom 𝒳.isFiberedInGroupoids (fibreObj B S hS 𝒳 x)
    (fibreObj B S hS 𝒳 x') P

/-- The second of the two morphisms of the fppf site a quadruple of `U ×_{x, 𝒳, x'} U'`
classifies. -/
abbrev quadSnd (P : twoFibreProductObjects B S hS 𝒳 x x') : quadObj B S hS 𝒳 P ⟶ x' :=
  TwoFibreProductOver.TwoYonedaPair.sndHom 𝒳.isFiberedInGroupoids (fibreObj B S hS 𝒳 x)
    (fibreObj B S hS 𝒳 x') P

/-- The morphism of the fppf site a morphism of quadruples of `U ×_{x, 𝒳, x'} U'` induces
between the objects they classify: the image under the 2-Yoneda functor of `x` of the first
component of the morphism of quadruples. -/
abbrev quadMap {P P' : twoFibreProductObjects B S hS 𝒳 x x'} (ψ : P ⟶ P') :
    quadObj B S hS 𝒳 P ⟶ quadObj B S hS 𝒳 P' :=
  (Functor.TwoYoneda.liftFunctor 𝒳.val.p 𝒳.isFiberedInGroupoids (𝒳.val.p.obj x)
    (fibreObj B S hS 𝒳 x)).map ψ.a

/-- A morphism of quadruples carries the first classified morphism of its source to the first
classified morphism of its target. This is
`CategoryTheory.TwoFibreProductOver.TwoYonedaPair.map_comp_fstHom` at the fppf site. -/
theorem quadMap_comp_quadFst {P P' : twoFibreProductObjects B S hS 𝒳 x x'} (ψ : P ⟶ P') :
    quadMap B S hS 𝒳 ψ ≫ quadFst B S hS 𝒳 P' = quadFst B S hS 𝒳 P :=
  TwoFibreProductOver.TwoYonedaPair.map_comp_fstHom 𝒳.isFiberedInGroupoids
    (fibreObj B S hS 𝒳 x) (fibreObj B S hS 𝒳 x') ψ

/-- A morphism of quadruples carries the second classified morphism of its source to the second
classified morphism of its target. This is
`CategoryTheory.TwoFibreProductOver.TwoYonedaPair.map_comp_sndHom` at the fppf site. -/
theorem quadMap_comp_quadSnd {P P' : twoFibreProductObjects B S hS 𝒳 x x'} (ψ : P ⟶ P') :
    quadMap B S hS 𝒳 ψ ≫ quadSnd B S hS 𝒳 P' = quadSnd B S hS 𝒳 P :=
  TwoFibreProductOver.TwoYonedaPair.map_comp_sndHom 𝒳.isFiberedInGroupoids
    (fibreObj B S hS 𝒳 x) (fibreObj B S hS 𝒳 x') ψ

/-- **Every pair of morphisms of the fppf site out of one object is classified by a quadruple of
`U ×_{x, 𝒳, x'} U'`.** This is
`CategoryTheory.TwoFibreProductOver.TwoYonedaPair.exists_quadruple_of_hom_pair` at the fppf site:
the quadruple lies over the scheme the source of the pair lies over, and the identification of
that source with the object the quadruple classifies carries the two classified morphisms back to
the given pair. -/
theorem exists_quadruple_of_hom_pair (y : 𝒳.val.obj) (α : y ⟶ x) (β : y ⟶ x') :
    ∃ (P : twoFibreProductObjects B S hS 𝒳 x x') (e : y ≅ quadObj B S hS 𝒳 P),
      P.base = 𝒳.val.p.obj y ∧ e.hom ≫ quadFst B S hS 𝒳 P = α ∧
        e.hom ≫ quadSnd B S hS 𝒳 P = β :=
  TwoFibreProductOver.TwoYonedaPair.exists_quadruple_of_hom_pair 𝒳.isFiberedInGroupoids
    (fibreObj B S hS 𝒳 x) (fibreObj B S hS 𝒳 x') α β

/-- **The hom-set form of condition (2)(c) of Stacks 0GMS for the fppf site, from one quadruple
which dominates every quadruple locally.** This is the site-level content of
`AlgebraicGeometry.Stack.isLocallySurjective_prodLift_fppfTopology_of_exists_quadruple_dominating`:
the hypothesis that
`AlgebraicGeometry.Stack.isLocallySurjective_prodLift_fppfTopology_of_exists_covering` consumes,
for the one-member family the quadruple `Q` classifies, namely that every pair of morphisms
`α : y ⟶ x`, `β : y ⟶ x'` of the site factors through `(quadFst Q, quadSnd Q)` after passing to a
covering of `y`.

It is stated separately from the sheaf-level conclusion because, mentioning nothing but the
hom-sets of the site, it transports along an equivalence of sites across a universe gap — by
`CategoryTheory.exists_covering_hom_pair_inverse` — which the sheaf-level condition does not.

A pair `α : y ⟶ x`, `β : y ⟶ x'` is classified by a quadruple `P` over the scheme `y` lies over,
by `AlgebraicGeometry.Stack.exists_quadruple_of_hom_pair`; the covering sieve the hypothesis
attaches to `P` pulls back along the identification of `y` with the object `P` classifies, a
Grothendieck topology being stable under pullback; and the factorisation through `P'` composes
with the morphism `P' ⟶ Q` to a factorisation of the pair through the two morphisms `Q`
classifies, because a morphism of quadruples carries classified morphisms to classified morphisms
(`CategoryTheory.TwoFibreProductOver.TwoYonedaPair.map_comp_fstHom` and `.map_comp_sndHom`). -/
theorem exists_covering_hom_pair_of_exists_quadruple_dominating
    (Q : twoFibreProductObjects B S hS 𝒳 x x')
    (h : ∀ P : twoFibreProductObjects B S hS 𝒳 x x',
      ∃ T ∈ fppfTopology B S hS 𝒳 (quadObj B S hS 𝒳 P),
        ∀ ⦃z : 𝒳.val.obj⦄ (g : z ⟶ quadObj B S hS 𝒳 P), T.arrows g →
          ∃ (P' : twoFibreProductObjects B S hS 𝒳 x x') (ψ : P' ⟶ P) (_ : P' ⟶ Q)
            (c : z ⟶ quadObj B S hS 𝒳 P'), c ≫ quadMap B S hS 𝒳 ψ = g) :
    ∀ (y : 𝒳.val.obj) (α : y ⟶ x) (β : y ⟶ x'),
      ∃ T : Sieve y, T ∈ fppfTopology B S hS 𝒳 y ∧
        ∀ ⦃z : 𝒳.val.obj⦄ (g : z ⟶ y), T.arrows g →
          ∃ (i : Fin 1) (r : z ⟶ (fun _ : Fin 1 => quadObj B S hS 𝒳 Q) i),
            r ≫ quadFst B S hS 𝒳 Q = g ≫ α ∧ r ≫ quadSnd B S hS 𝒳 Q = g ≫ β := by
  intro y α β
  obtain ⟨P, e, -, hα, hβ⟩ := exists_quadruple_of_hom_pair B S hS 𝒳 y α β
  obtain ⟨T, hT, hlift⟩ := h P
  refine ⟨Sieve.pullback e.hom T, (fppfTopology B S hS 𝒳).pullback_stable e.hom hT, ?_⟩
  intro z g hg
  obtain ⟨P', ψ, χ, c, hc⟩ := hlift (g ≫ e.hom) hg
  refine ⟨0, c ≫ quadMap B S hS 𝒳 χ, ?_, ?_⟩
  · rw [Category.assoc, quadMap_comp_quadFst, ← hα, ← Category.assoc, ← hc, Category.assoc,
      quadMap_comp_quadFst]
  · rw [Category.assoc, quadMap_comp_quadSnd, ← hβ, ← Category.assoc, ← hc, Category.assoc,
      quadMap_comp_quadSnd]

/-- **Condition (2)(c) of Stacks 0GMS for the fppf site, from one quadruple which dominates
every quadruple locally.** Let `x`, `x'` be objects of the fppf site of `𝒳` and let `Q` be an
object of the 2-fibre product `U ×_{x, 𝒳, x'} U'` of the slices they represent. Suppose every
object `P` of that 2-fibre product carries a covering sieve of the object of the site it
classifies over whose members `P` is dominated by an object admitting a morphism to `Q` — that
is, every arrow `g` of the sieve factors as a morphism into the object some `P'` classifies
followed by the morphism `P' ⟶ P` induces, with `P'` admitting a morphism to `Q`. Then
`∐ h_{V}^# ⟶ h_x^# ⨯ h_{x'}^#` is a surjection of fppf sheaves of sets, for the one-member
family `V = ` the object `Q` classifies with its two classified morphisms.

This is where the absolute half of the dictionary between quadruples and pairs of morphisms is
used, in both directions. A pair `α : y ⟶ x`, `β : y ⟶ x'` is classified by a quadruple `P` over
the scheme `y` lies over, by
`AlgebraicGeometry.Stack.exists_quadruple_of_hom_pair`; the covering sieve the hypothesis
attaches to `P` pulls back along the identification of `y` with the object `P` classifies to a
covering sieve of `y`, a Grothendieck topology being stable under pullback; and the factorisation
through `P'` composes with the morphism `P' ⟶ Q` to a factorisation of the pair through the two
morphisms `Q` classifies, because a morphism of quadruples carries classified morphisms to
classified morphisms
(`CategoryTheory.TwoFibreProductOver.TwoYonedaPair.map_comp_fstHom` and `.map_comp_sndHom`).

The hypothesis is the statement that the 1-morphism `Q` names is *locally essentially
surjective*; see the module documentation for what still has to be done to produce a `Q`
satisfying it from a surjective smooth presentation of the 2-fibre product by an affine
scheme. -/
theorem isLocallySurjective_prodLift_fppfTopology_of_exists_quadruple_dominating
    (Q : twoFibreProductObjects B S hS 𝒳 x x')
    (h : ∀ P : twoFibreProductObjects B S hS 𝒳 x x',
      ∃ T ∈ fppfTopology B S hS 𝒳 (quadObj B S hS 𝒳 P),
        ∀ ⦃z : 𝒳.val.obj⦄ (g : z ⟶ quadObj B S hS 𝒳 P), T.arrows g →
          ∃ (P' : twoFibreProductObjects B S hS 𝒳 x x') (ψ : P' ⟶ P) (_ : P' ⟶ Q)
            (c : z ⟶ quadObj B S hS 𝒳 P'), c ≫ quadMap B S hS 𝒳 ψ = g) :
    Sheaf.IsLocallySurjective (Limits.Sigma.desc fun _ : Fin 1 =>
      prod.lift ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (quadFst B S hS 𝒳 Q))
        ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (quadSnd B S hS 𝒳 Q))) :=
  isLocallySurjective_prodLift_fppfTopology_of_exists_covering B S hS 𝒳
    (fun _ : Fin 1 => quadObj B S hS 𝒳 Q) (fun _ => quadFst B S hS 𝒳 Q)
    (fun _ => quadSnd B S hS 𝒳 Q)
    (exists_covering_hom_pair_of_exists_quadruple_dominating B S hS 𝒳 Q h)

/-- **One quadruple dominating every quadruple after a covering taken downstairs dominates every
quadruple after a covering taken upstairs.** This is the site-level content of
`AlgebraicGeometry.Stack`
`.isLocallySurjective_prodLift_fppfTopology_of_exists_quadruple_dominating_base`: it converts the
hypothesis of that result into the hypothesis of
`AlgebraicGeometry.Stack.isLocallySurjective_prodLift_fppfTopology_of_exists_quadruple_dominating`,
so that the latter's hom-set form
`AlgebraicGeometry.Stack.exists_covering_hom_pair_of_exists_quadruple_dominating` becomes
reachable from the shape **Stacks 06QA** produces.

The family of induced morphisms of the site is a covering family of the object `P` classifies:
every morphism of a category fibred in groupoids is strongly cartesian over its image, and the
images of the members generate `R`, each one agreeing with its member after the comparison
isomorphism of `CategoryTheory.Functor.IsHomLift.domain_eq`. The fppf topology of Stacks 06TP is
the topology inherited from `AlgebraicGeometry.BigFppfOver.topology`, so that covering family
generates a covering sieve of the fppf site with no transport. -/
theorem exists_covering_quadMap_of_exists_quadruple_dominating_base
    (Q : twoFibreProductObjects B S hS 𝒳 x x')
    (h : ∀ P : twoFibreProductObjects B S hS 𝒳 x x',
      ∃ R ∈ BigFppfOver.topology B S hS (𝒳.val.p.obj (quadObj B S hS 𝒳 P)),
        ∀ ⦃T : BigFppfOver B S hS⦄ ⦃k : T ⟶ 𝒳.val.p.obj (quadObj B S hS 𝒳 P)⦄, R.arrows k →
          ∃ (P' : twoFibreProductObjects B S hS 𝒳 x x') (ψ : P' ⟶ P) (_ : P' ⟶ Q),
            𝒳.val.p.IsHomLift k (quadMap B S hS 𝒳 ψ)) :
    ∀ P : twoFibreProductObjects B S hS 𝒳 x x',
      ∃ T ∈ fppfTopology B S hS 𝒳 (quadObj B S hS 𝒳 P),
        ∀ ⦃z : 𝒳.val.obj⦄ (g : z ⟶ quadObj B S hS 𝒳 P), T.arrows g →
          ∃ (P' : twoFibreProductObjects B S hS 𝒳 x x') (ψ : P' ⟶ P) (_ : P' ⟶ Q)
            (c : z ⟶ quadObj B S hS 𝒳 P'), c ≫ quadMap B S hS 𝒳 ψ = g := by
  classical
  intro P
  obtain ⟨R, hR, hlift⟩ := h P
  have hch : ∀ i : Σ T : BigFppfOver B S hS,
      {k : T ⟶ 𝒳.val.p.obj (quadObj B S hS 𝒳 P) // R.arrows k},
      ∃ (P' : twoFibreProductObjects B S hS 𝒳 x x') (ψ : P' ⟶ P) (_ : P' ⟶ Q),
        𝒳.val.p.IsHomLift i.2.1 (quadMap B S hS 𝒳 ψ) := fun i => hlift i.2.2
  choose P' ψ χ hψ using hch
  refine ⟨Sieve.ofArrows (fun i => quadObj B S hS 𝒳 (P' i))
    (fun i => quadMap B S hS 𝒳 (ψ i)), ?_, ?_⟩
  · rw [fppfTopology, associatedTopology, Functor.inheritedTopology_eq]
    refine Precoverage.generate_mem_toGrothendieck
      ⟨fun _ q _ => Functor.IsFiberedInGroupoids.isStronglyCartesian
        𝒳.isFiberedInGroupoids q, ?_⟩
    rw [GrothendieckTopology.mem_toPrecoverage_iff, Presieve.map_ofArrows]
    refine (BigFppfOver.topology B S hS).superset_covering ?_ hR
    intro T k hk
    let i : Σ T' : BigFppfOver B S hS,
        {k' : T' ⟶ 𝒳.val.p.obj (quadObj B S hS 𝒳 P) // R.arrows k'} := ⟨T, k, hk⟩
    have hinst := hψ i
    have hdom : 𝒳.val.p.obj (quadObj B S hS 𝒳 (P' i)) = T :=
      IsHomLift.domain_eq 𝒳.val.p k (quadMap B S hS 𝒳 (ψ i))
    have hfac : 𝒳.val.p.map (quadMap B S hS 𝒳 (ψ i)) = eqToHom hdom ≫ k := by
      simpa using IsHomLift.fac' 𝒳.val.p k (quadMap B S hS 𝒳 (ψ i))
    refine ⟨𝒳.val.p.obj (quadObj B S hS 𝒳 (P' i)), eqToHom hdom.symm,
      𝒳.val.p.map (quadMap B S hS 𝒳 (ψ i)), Presieve.ofArrows.mk i, ?_⟩
    rw [hfac, eqToHom_trans_assoc]
    simp
  · intro z g hg
    obtain ⟨i, c, hc⟩ := (Sieve.mem_ofArrows_iff (fun i => quadObj B S hS 𝒳 (P' i))
      (fun i => quadMap B S hS 𝒳 (ψ i)) g).1 hg
    exact ⟨P' i, ψ i, χ i, c, hc.symm⟩

/-- **Condition (2)(c) of Stacks 0GMS for the fppf site, from one quadruple which dominates every
quadruple after a covering taken downstairs.** The hypothesis of
`AlgebraicGeometry.Stack.isLocallySurjective_prodLift_fppfTopology_of_exists_quadruple_dominating`
with the covering requirement moved to the big fppf category over `S`: for every object `P` of
the 2-fibre product `U ×_{x, 𝒳, x'} U'` it is enough to have a covering sieve `R` of the *scheme*
the object `P` classifies lies over, together with, over each member `k` of `R`, an object `P'`
admitting a morphism to `Q` and a morphism `P' ⟶ P` whose induced morphism of the site lies
over `k`.

This is exactly the shape **Stacks 06QA** produces for a surjective, flat, locally finitely
presented 1-morphism into the 2-fibre product, so it is the form in which an affine smooth
presentation of that 2-fibre product discharges condition (2)(c); see the module documentation.

The family of induced morphisms of the site is a covering family of the object `P` classifies:
every morphism of a category fibred in groupoids is strongly cartesian over its image, and the
images of the members generate `R`, each one agreeing with its member after the comparison
isomorphism of `CategoryTheory.Functor.IsHomLift.domain_eq`. The fppf topology of Stacks 06TP is
the topology inherited from `AlgebraicGeometry.BigFppfOver.topology`, so that covering family
generates a covering sieve of the fppf site with no transport. -/
theorem isLocallySurjective_prodLift_fppfTopology_of_exists_quadruple_dominating_base
    (Q : twoFibreProductObjects B S hS 𝒳 x x')
    (h : ∀ P : twoFibreProductObjects B S hS 𝒳 x x',
      ∃ R ∈ BigFppfOver.topology B S hS (𝒳.val.p.obj (quadObj B S hS 𝒳 P)),
        ∀ ⦃T : BigFppfOver B S hS⦄ ⦃k : T ⟶ 𝒳.val.p.obj (quadObj B S hS 𝒳 P)⦄, R.arrows k →
          ∃ (P' : twoFibreProductObjects B S hS 𝒳 x x') (ψ : P' ⟶ P) (_ : P' ⟶ Q),
            𝒳.val.p.IsHomLift k (quadMap B S hS 𝒳 ψ)) :
    Sheaf.IsLocallySurjective (Limits.Sigma.desc fun _ : Fin 1 =>
      prod.lift ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (quadFst B S hS 𝒳 Q))
        ((Sheaf.sheafifiedYoneda (fppfTopology B S hS 𝒳)).map (quadSnd B S hS 𝒳 Q))) :=
  isLocallySurjective_prodLift_fppfTopology_of_exists_quadruple_dominating B S hS 𝒳 Q
    (exists_covering_quadMap_of_exists_quadruple_dominating_base B S hS 𝒳 Q h)

universe w

/-- The slice represented by an object of the fppf site of an algebraic stack, read as an object
of the 2-category of algebraic stacks. It is an algebraic stack by **Stacks 04X5**,
`AlgebraicGeometry.Stack.isAlgebraicStack_schemeFibredCategory`. -/
abbrev sliceAlgebraicStack (𝒴 : AlgebraicStacks.{u, w} B S hS) (y : 𝒴.val.val.obj) :
    AlgebraicStacks.{u, w} B S hS :=
  ⟨schemeFibredCategory B S hS (𝒴.val.val.p.obj y),
    isAlgebraicStack_schemeFibredCategory B S hS _⟩

/-- The 2-Yoneda 1-morphism `AlgebraicGeometry.Stack.objectMorphism` of an object of the fppf
site, read in the 2-category of algebraic stacks: the 1-morphisms of that 2-category are those
of the ambient 2-category of categories fibred in groupoids, so no condition has to be
checked. -/
abbrev objectMorphismAlgebraicStacks (𝒴 : AlgebraicStacks.{u, w} B S hS) (y : 𝒴.val.val.obj) :
    sliceAlgebraicStack B S hS 𝒴 y ⟶ 𝒴 :=
  Bicategory.InducedBicategory.mkHom
    (objectMorphism B S hS 𝒴.val (fibreObj B S hS 𝒴.val y))

/-- **The objects of the 2-fibre product `U ×_{x, 𝒳, x'} U'` of algebraic stacks are exactly the
quadruples this file speaks of.** For two objects `x`, `x'` of the fppf site of an algebraic
stack `𝒴`, the total category of
`AlgebraicGeometry.Stack.twoFibreProductAlgebraicStack` at the two 2-Yoneda 1-morphisms of `x`
and `x'` is `AlgebraicGeometry.Stack.twoFibreProductObjects` on the nose.

Nothing is transported: the 2-fibre product of algebraic stacks has the 2-fibre product of
categories fibred in groupoids as its total category, that one is
`CategoryTheory.TwoFibreProductOver` at the two structure functors and the two underlying
functors of the 1-morphisms, and the underlying functor of `objectMorphism` is
`CategoryTheory.Functor.TwoYoneda.liftFunctor`. The content of this lemma is that there is no
translation step between the 2-fibre product the source of Stacks 0GMS covers by an affine
scheme and the quadruples the two results above quantify over. -/
theorem obj_twoFibreProductAlgebraicStack_objectMorphism (𝒴 : AlgebraicStacks.{u, w} B S hS)
    (y y' : 𝒴.val.val.obj) :
    (twoFibreProductAlgebraicStack B S hS (objectMorphismAlgebraicStacks B S hS 𝒴 y)
        (objectMorphismAlgebraicStacks B S hS 𝒴 y')).val.val.obj =
      twoFibreProductObjects B S hS 𝒴.val y y' :=
  rfl

end Quadruples

end AlgebraicGeometry.Stack

