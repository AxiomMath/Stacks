/-!
# The constructed inherited topology satisfies the inherited-topology characterisation

`CategoryTheory.Functor.inheritedTopology` builds a topology on a fibred category `q : 𝒳 ⥤ 𝒞`
out of a topology `J` on the base, while `CategoryTheory.Functor.IsInheritedTopology` is the
predicate singling out that topology among all topologies on `𝒳`. This file proves that the
construction satisfies the predicate, so that the predicate is inhabited, and that the
construction commutes with passing to a slice of the base: a functor to `𝒞/U` inherits from
`J.over U` exactly the topology its composite with `Over.forget U` inherits from `J`.

## Main results

* `CategoryTheory.Functor.isInheritedTopology_inheritedTopology`: the topology
  `q.inheritedTopology J` is the topology inherited from `(𝒞, J)` along `q`.
* `CategoryTheory.Functor.inheritedTopology_comp_overForget`: for `p : 𝒳 ⥤ 𝒞/U` fibred in
  groupoids, `(p ⋙ Over.forget U).inheritedTopology J = p.inheritedTopology (J.over U)`.

## Implementation notes

Both proofs work with `CategoryTheory.Functor.inheritedPrecoverage`, the collection of covering
families, rather than with the topology it generates. For the first,
`CategoryTheory.Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition` reduces membership
in the generated topology to the existence of a covering family refining the sieve, which is the
shape the characterisation is stated in. For the second, the two collections of covering families
are equal on the nose, a stronger statement than equality of the generated topologies and the one
that the sieve-generation lemmas prove directly.

## References

* [Stacks Project, Tag 06NU](https://stacks.math.columbia.edu/tag/06NU)
* [Stacks Project, Tag 06NV](https://stacks.math.columbia.edu/tag/06NV)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe w v₁ u₁ v₂ u₂

namespace CategoryTheory.Functor

/-- The topology `CategoryTheory.Functor.inheritedTopology` constructs on a fibred category
`q : 𝒳 ⥤ 𝒞` over a site `(𝒞, J)` is the topology inherited from `(𝒞, J)` along `q`, in the
sense of `CategoryTheory.Functor.IsInheritedTopology`: a family of strongly cartesian morphisms
generates a covering sieve upstairs exactly when its family of images generates a covering sieve
downstairs.

Covering families of `CategoryTheory.Functor.inheritedPrecoverage` are stable under composition,
so a sieve is covering for the generated topology exactly when some covering family refines it.
A covering family refining `Sieve.ofArrows Y' g` has covering image, and that image sieve is
contained in the sieve generated by the images of the `g i`; conversely the family of the `g i`
itself is a covering family refining the sieve as soon as its images cover. -/
lemma isInheritedTopology_inheritedTopology {C : Type u₁} [Category.{v₁} C] {X : Type u₂}
    [Category.{v₂} X] (q : X ⥤ C) [q.IsFibered] [HasPullbacks C] (J : GrothendieckTopology C) :
    IsInheritedTopology.{w} q J (q.inheritedTopology J) := by
  intro Y I Y' g hg
  let K := q.inheritedPrecoverage J.toPrecoverage
  have : K.IsStableUnderComposition := inferInstance
  rw [show q.inheritedTopology J = K.toGrothendieck from rfl,
    Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition]
  constructor
  · rintro ⟨R, hR, hRS⟩
    have hRbase : Sieve.generate (R.map q) ∈ J (q.obj Y) :=
      (GrothendieckTopology.mem_toPrecoverage_iff J (R.map q)).mp hR.2
    have hRS' : Sieve.generate R ≤ Sieve.ofArrows Y' g := by
      rwa [Sieve.generate_le_iff]
    apply J.superset_covering ?_ hRbase
    rw [Sieve.generate_map_eq_functorPushforward]
    calc
      (Sieve.generate R).functorPushforward q ≤
          (Sieve.ofArrows Y' g).functorPushforward q :=
        (Sieve.functorPushforward_monotone (F := q) _) hRS'
      _ = Sieve.ofArrows (fun i ↦ q.obj (Y' i)) (fun i ↦ q.map (g i)) :=
        Sieve.functorPushforward_ofArrows q g
  · intro hbase
    refine ⟨Presieve.ofArrows Y' g, ⟨fun _ _ ⟨i⟩ ↦ hg i, ?_⟩,
      fun _ _ ⟨i⟩ ↦ Sieve.ofArrows_mk Y' g i⟩
    rw [GrothendieckTopology.mem_toPrecoverage_iff]
    simpa [Presieve.map_ofArrows] using hbase

/-- For `p : 𝒳 ⥤ 𝒞/U` fibred in groupoids, the topology `p` inherits from the localization
`J.over U` is the topology that the composite `p ⋙ Over.forget U` inherits from `J` itself.

The two collections of covering families coincide: a family of morphisms of `𝒳` is strongly
cartesian for `p` exactly when it is strongly cartesian for the composite, both holding of every
morphism because `p` and the composite are fibred in groupoids, and a sieve of `𝒞/U` is covering
for `J.over U` exactly when the sieve it determines on `𝒞` is covering for `J`, which the
sieve-generation lemmas identify with the condition on the images under the composite. -/
lemma inheritedTopology_comp_overForget {C : Type u₁} [Category.{v₁} C] {X : Type u₂}
    [Category.{v₂} X] (U : C) (p : X ⥤ Over U) (hp : p.IsFiberedInGroupoids)
    (J : GrothendieckTopology C) :
    (p ⋙ Over.forget U).inheritedTopology J = p.inheritedTopology (J.over U) := by
  let q := p ⋙ Over.forget U
  have hq : q.IsFiberedInGroupoids :=
    IsFiberedInGroupoids.comp p (Over.forget U) hp (IsFiberedInGroupoids.over_forget U)
  have hgen (Y : X) (R : Presieve Y) :
      Sieve.generate (R.map q) =
        Sieve.generate (Presieve.functorPushforward (Over.forget U) (R.map p)) := by
    calc
      Sieve.generate (R.map q) = (Sieve.generate R).functorPushforward q := by
        rw [Sieve.generate_map_eq_functorPushforward]
      _ = ((Sieve.generate R).functorPushforward p).functorPushforward (Over.forget U) := by
        rw [Sieve.functorPushforward_comp]
      _ = (Sieve.generate (R.map p)).functorPushforward (Over.forget U) := by
        rw [Sieve.generate_map_eq_functorPushforward]
      _ = Sieve.generate (Presieve.functorPushforward (Over.forget U) (R.map p)) :=
        (CategoryTheory.Functor.generate_presieveFunctorPushforward_eq (Over.forget U)
          (R.map p)).symm
  have hpre : q.inheritedPrecoverage J.toPrecoverage =
      p.inheritedPrecoverage (J.over U).toPrecoverage := by
    have key (Y : X) (R : Presieve Y) : Sieve.generate (R.map q) ∈ J (q.obj Y) ↔
        Sieve.generate (R.map p) ∈ J.over U (p.obj Y) := by
      rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_generate, ← hgen Y R]
      simp [q]
    ext Y R
    constructor
    · rintro ⟨_, hR⟩
      exact ⟨fun _ f _ ↦ hp.isStronglyCartesian f,
        (GrothendieckTopology.mem_toPrecoverage_iff _ _).mpr
          ((key Y R).mp ((GrothendieckTopology.mem_toPrecoverage_iff _ _).mp hR))⟩
    · rintro ⟨_, hR⟩
      exact ⟨fun _ f _ ↦ hq.isStronglyCartesian f,
        (GrothendieckTopology.mem_toPrecoverage_iff _ _).mpr
          ((key Y R).mpr ((GrothendieckTopology.mem_toPrecoverage_iff _ _).mp hR))⟩
  simp [q, inheritedTopology_eq, hpre]

end CategoryTheory.Functor

end
