module

public import StacksFrontier.CategoryTheory.Sites.Cohomology.LowerShriek.ULiftDerivedLowerShriekComparison
public import StacksFrontier.AlgebraicGeometry.Stacks.LisseEtaleDerivedModuleLowerShriek
public import StacksFrontier.AlgebraicGeometry.Stacks.LisseEtaleDerivedModuleLowerShriekLargeSections

/-!
# The derived lower shriek of modules for the lisse-étale site at two universes

Let `𝒳` be an algebraic stack. The derived lower shriek `Lg_!` of sheaves of modules along the
inclusion of the lisse-étale site of `𝒳` exists at the module universe `u` of the rings
(`AlgebraicGeometry.Stack.LisseEtale.derivedModuleLowerShriek`) and at the module universe `u + 1`
of the sheaves of modules of Stacks 07AV
(`AlgebraicGeometry.Stack.LisseEtale.derivedModuleLowerShriekSucc`). This file identifies, for a
module `H` with sections in `Type u`, the universe lift of `H^p(Lg_! H)` with
`H^p(Lg_!(Λ H))`, `Λ H` being the universe lift of `H`, read on the lisse-étale topology of the
second construction (which agrees with that of the first,
`AlgebraicGeometry.Stack.LisseEtale.inclusionTopology_eq_topology`).

## Main definitions

* `AlgebraicGeometry.Stack.LisseEtale.moduleULift`: `Λ : Mod_u(𝒪_{𝒳_{lisse,étale}}) ⥤
  Mod_{u+1}(𝒪_{𝒳_{lisse,étale}})`.

## Main results

* `AlgebraicGeometry.Stack.LisseEtale.nonempty_uliftHomologyDerivedModuleLowerShriekIso`:
  `Λ H^p(Lg_! H) ≅ H^p(Lg_!(Λ H))`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open Stacks.Cohomology.DerivedLowerShriek

namespace AlgebraicGeometry.Stack.LisseEtale

universe u w

attribute [-instance] Stacks.Cohomology.SiteModules.moduleSheavesAbelian
  Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck

attribute [local instance] isContinuous_inclusion' isCocontinuous_inclusion'
  isContinuous_inclusion_topology' isCocontinuous_inclusion_topology'
  Stacks.hasSheafCompose_forget₂_commRingCat Stacks.essentiallySmall_over
  preservesCoveringPullbacks_inclusion preservesCoveringPullbacks_inclusion_topology
  GrothendieckTopology.hasSheafify_addCommGrpCat
  GrothendieckTopology.wEqualsLocallyBijective_addCommGrpCat

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  (𝒳 : Stack.AlgebraicStacks.{u, w} B S hS)

/-- The raising `Λ` of the universe of the sections of sheaves of modules on the lisse-étale site,
from the universe `u` of 07BA's `Lg_!` to the universe `u + 1` of Stacks 07AV, read on the
topology generated by the chosen covering families. -/
abbrev moduleULift :
    SheafOfModules.{u} (inverseImageRing (subsiteTopology B S hS 𝒳.val.val.p (etaleTopology B)
      (smoothObject.{u, w} B S hS 𝒳))
      (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) (smoothObject.{u, w} B S hS 𝒳).ι
      (SmallModel.targetRing (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        (associatedRingedTopos B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
          (etaleTopology_le_topology B)).O)) ⥤
      SheafOfModules.{u + 1} (subsiteRingStructureSheaf B S hS 𝒳) :=
  ULiftComparison.sourceULift _ _ _ _ ⋙
    ULiftComparison.changeTopology (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
      (smoothObject.{u, w} B S hS 𝒳).ι _
      (inclusionTopology_eq_topology.{u, w} B S hS 𝒳 (closedUnderSmoothMorphisms B S hS 𝒳))


/-- **`Λ H^p(Lg_! H) ≅ H^p(Lg_!(Λ H))` for the lisse-étale site.** For a sheaf of modules `H` on
the lisse-étale site of `𝒳` with sections in `Type u` and every `p`, the universe lift of the
`p`-th cohomology sheaf of 07BA's `Lg_!(H)` (Stacks 07AS (2), module universe `u`) is the `p`-th
cohomology sheaf of `Lg_!(Λ H)` at the module universe `u + 1` of Stacks 07AV, at the standard
models of the derived categories. -/
theorem nonempty_uliftHomologyDerivedModuleLowerShriekIso
    (H : SheafOfModules.{u} (inverseImageRing (subsiteTopology B S hS 𝒳.val.val.p (etaleTopology B)
      (smoothObject.{u, w} B S hS 𝒳))
      (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) (smoothObject.{u, w} B S hS 𝒳).ι
      (SmallModel.targetRing (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        (associatedRingedTopos B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
          (etaleTopology_le_topology B)).O)))
    (p : ℤ) :
    letI := abelianEtaleModules B S hS 𝒳
    letI := abelianLisseEtaleModules B S hS 𝒳
    letI := HasDerivedCategory.standard (SheafOfModules.{u} (inverseImageRing
      (subsiteTopology B S hS 𝒳.val.val.p (etaleTopology B) (smoothObject.{u, w} B S hS 𝒳))
      (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) (smoothObject.{u, w} B S hS 𝒳).ι
      (SmallModel.targetRing (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        (associatedRingedTopos B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
          (etaleTopology_le_topology B)).O)))
    letI := HasDerivedCategory.standard (SheafOfModules.{u}
      (SmallModel.targetRing (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        (associatedRingedTopos B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
          (etaleTopology_le_topology B)).O))
    letI := HasDerivedCategory.standard
      (SheafOfModules.{u + 1} (subsiteRingStructureSheaf B S hS 𝒳))
    letI := HasDerivedCategory.standard
      (SheafOfModules.{u + 1} (ambientRingStructureSheaf B S hS 𝒳))
    Nonempty ((ULiftComparison.targetULift _ _).obj ((DerivedCategory.homologyFunctor _ p).obj
        ((derivedModuleLowerShriek B S hS 𝒳).obj ((DerivedCategory.singleFunctor _ 0).obj H))) ≅
      (DerivedCategory.homologyFunctor
        (SheafOfModules.{u + 1} (ambientRingStructureSheaf B S hS 𝒳)) p).obj
        ((derivedModuleLowerShriekSucc B S hS 𝒳).obj
        ((DerivedCategory.singleFunctor _ 0).obj ((moduleULift B S hS 𝒳).obj H)))) := by
  have : EssentiallySmall.{u + 1} 𝒳.val.val.obj :=
    FlatFppf.essentiallySmall_obj_coefficient.{u, w, u + 1} B S hS 𝒳
  have : EssentiallySmall.{u + 1} (LisseEtale.{u, w} B S hS 𝒳) :=
    essentiallySmall_lisseEtale.{u, w} B S hS 𝒳
  have : HasSheafify (topology.{u, w} B S hS 𝒳) AddCommGrpCat.{u + 1} :=
    GrothendieckTopology.hasSheafify_addCommGrpCat.{u + 1, u, u + 1} _
  have : (topology.{u, w} B S hS 𝒳).WEqualsLocallyBijective AddCommGrpCat.{u + 1} :=
    AlgebraicGeometry.SheafOfModules.wEqualsLocallyBijective_addCommGrpCat.{u + 1, u + 1, u} _
  have : HasSheafify (subsiteTopology B S hS 𝒳.val.val.p (etaleTopology B)
      (smoothObject.{u, w} B S hS 𝒳)) AddCommGrpCat.{u + 1} :=
    GrothendieckTopology.hasSheafify_addCommGrpCat.{u + 1, u, u + 1} _
  have : (subsiteTopology B S hS 𝒳.val.val.p (etaleTopology B)
      (smoothObject.{u, w} B S hS 𝒳)).WEqualsLocallyBijective AddCommGrpCat.{u + 1} :=
    AlgebraicGeometry.SheafOfModules.wEqualsLocallyBijective_addCommGrpCat.{u + 1, u + 1, u} _
  have : HasSheafify (ambientTopology B S hS 𝒳) AddCommGrpCat.{u + 1} :=
    GrothendieckTopology.hasSheafify_addCommGrpCat.{u + 1, u, u + 1} _
  have : (ambientTopology B S hS 𝒳).WEqualsLocallyBijective AddCommGrpCat.{u + 1} :=
    AlgebraicGeometry.SheafOfModules.wEqualsLocallyBijective_addCommGrpCat.{u + 1, u + 1, u} _
  let := abelianEtaleModules B S hS 𝒳
  let := abelianLisseEtaleModules B S hS 𝒳
  let := HasDerivedCategory.standard (SheafOfModules.{u} (inverseImageRing
      (subsiteTopology B S hS 𝒳.val.val.p (etaleTopology B) (smoothObject.{u, w} B S hS 𝒳))
      (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) (smoothObject.{u, w} B S hS 𝒳).ι
      (SmallModel.targetRing (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        (associatedRingedTopos B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
          (etaleTopology_le_topology B)).O)))
  let := HasDerivedCategory.standard (SheafOfModules.{u}
      (SmallModel.targetRing (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
        (associatedRingedTopos B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
          (etaleTopology_le_topology B)).O))
  let := HasDerivedCategory.standard (SheafOfModules.{u + 1} (inverseImageRing
      (topology.{u, w} B S hS 𝒳)
      (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B)) (smoothObject.{u, w} B S hS 𝒳).ι
      (Stacks.SheafOfModules.Tensor.ringSheaf
        (associatedRingedTopos B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
          (etaleTopology_le_topology B)).O)))
  let := HasDerivedCategory.standard (SheafOfModules.{u + 1}
      (Stacks.SheafOfModules.Tensor.ringSheaf
        (associatedRingedTopos B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
          (etaleTopology_le_topology B)).O))
  exact ULiftComparison.nonempty_homologyDerivedLowerShriekULiftIso_of_eq
    (subsiteTopology B S hS 𝒳.val.val.p (etaleTopology B) (smoothObject.{u, w} B S hS 𝒳))
    (topology.{u, w} B S hS 𝒳) (associatedTopology B S hS 𝒳.val.val.p (etaleTopology B))
    (smoothObject.{u, w} B S hS 𝒳).ι
    (inclusionTopology_eq_topology.{u, w} B S hS 𝒳 (closedUnderSmoothMorphisms B S hS 𝒳))
    (associatedRingedTopos B S hS 𝒳.val.val.p 𝒳.val.isFiberedInGroupoids (etaleTopology B)
      (etaleTopology_le_topology B)).O H p

end AlgebraicGeometry.Stack.LisseEtale

end
