/-!
# The local image of a field-valued point is covered by it, flatly and of finite presentation

Let `𝒳` be an algebraic stack over `S`, let `F` be the spectrum of a field and let
`g : F ⟶ 𝒳` be a 1-morphism which is locally of finite type. The factorization
`AlgebraicGeometry.Stack.toLocalImage` of `g` through the strictly full subcategory of objects
fppf-locally in its image is surjective, flat and locally of finite presentation, in the relative
sense of **Stacks 03YK**, and that subcategory is an algebraic stack.

## Main results

* `AlgebraicGeometry.Stack.isStack_localImageStack`: the subcategory fppf-locally in the image of
  `g` is a stack.
* `AlgebraicGeometry.Stack.isRepresentableByAlgebraicSpaces_toLocalImage`: the factorization is
  representable by algebraic spaces.
* `AlgebraicGeometry.Stack.relativeProperty_relationSquareFst_of_prop_relationTarget`: a property
  of the target morphism of the self-intersection groupoid is a relative property of the first
  projection of the self-intersection.
* `relativeProperty_surjective_flat_locallyOfFinitePresentation_toLocalImage`: the three relative
  properties of the factorization.
* `AlgebraicGeometry.Stack.isAlgebraicStack_fullSubcategoryBased_localImage_fieldPoint`: the
  subcategory locally generated by the point is an algebraic stack.

## References

* [Stacks Project, Tag 03YK](https://stacks.math.columbia.edu/tag/03YK)
* [Stacks Project, Tag 045D](https://stacks.math.columbia.edu/tag/045D)
* [Stacks Project, Tag 04T4](https://stacks.math.columbia.edu/tag/04T4)
* [Stacks Project, Tag 04XB](https://stacks.math.columbia.edu/tag/04XB)
* [Stacks Project, Tag 06G4](https://stacks.math.columbia.edu/tag/06G4)
-/

@[expose] public section

open CategoryTheory

namespace AlgebraicGeometry.Stack

universe u w

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

section Stackhood

variable {𝒰 : CatFiberedInGroupoids.{u, u, u + 1, u + 1} (BigFppfOver B S hS)}
  {𝒴 : AlgebraicStacks.{u, w} B S hS} (g : 𝒰 ⟶ 𝒴.val)

/-- **The property of being fppf-locally in the image of `g` is closed under isomorphism**, being
inherited along arbitrary morphisms. -/
instance isClosedUnderIsomorphisms_localImage :
    (localImage g).IsClosedUnderIsomorphisms where
  of_iso e h := localImage_of_hom g e.inv h

/-- Membership of `AlgebraicGeometry.Stack.localImage` and membership of its isomorphism closure
are the same condition, the property being closed under isomorphism. -/
theorem localImage_isoClosure_iff {xi : 𝒴.val.val.obj} :
    (localImage g).isoClosure xi ↔ localImage g xi := by
  rw [ObjectProperty.isoClosure_eq_self (localImage g)]

/-- **The strictly full subcategory of objects fppf-locally in the image of `g` is a stack.** -/
theorem isStack_localImageStack :
    (localImageStack g).val.p.IsStack (BigFppfOver.topology B S hS) := by
  classical
  obtain ⟨h𝒴fib, ⟨h𝒴stk, -⟩, -, -⟩ := 𝒴.property
  have hp : Functor.IsStack 𝒴.val.val.p (BigFppfOver.topology B S hS) := h𝒴stk
  have : 𝒴.val.val.p.IsPreFibered := hp.isFibered.toIsPreFibered
  refine Functor.IsStack.fullSubcategory_of_isClosedUnderIsomorphisms
    𝒴.val.val.p (BigFppfOver.topology B S hS) hp (localImage g) ?_ ?_
  · intro V U y x k phi _ hx
    exact (localImage_isoClosure_iff B S hS g).2 (localImage_of_hom g phi hx)
  · rintro U I Ui fi hcov ⟨xo, rfl⟩ hx
    refine (localImage_isoClosure_iff B S hS g).2 ?_
    refine localImage_of_locally g (R := Sieve.generate (Presieve.ofArrows Ui fi)) hcov ?_
    rintro V k ⟨Z, h, f, ⟨i⟩, rfl⟩
    set y : 𝒴.val.val.p.Fiber (Ui i) :=
      Functor.pullbackFiber 𝒴.val.val.p ⟨xo, rfl⟩ (fi i) with hy
    have hya : localImage g y.1 := (localImage_isoClosure_iff B S hS g).1 (hx i)
    refine ⟨(Functor.pullbackFiber 𝒴.val.val.p y h).1,
      Functor.IsPreFibered.pullbackMap y.2 h ≫
        Functor.IsPreFibered.pullbackMap (rfl : 𝒴.val.val.p.obj xo = _) (fi i),
      ?_, localImage_of_hom g (Functor.IsPreFibered.pullbackMap y.2 h) hya⟩
    have h1 : 𝒴.val.val.p.IsHomLift h (Functor.IsPreFibered.pullbackMap y.2 h) :=
      inferInstance
    have h2 : 𝒴.val.val.p.IsHomLift (fi i)
        (Functor.IsPreFibered.pullbackMap (rfl : 𝒴.val.val.p.obj xo = _) (fi i)) :=
      inferInstance
    infer_instance

end Stackhood

/-- **The factorization of a 1-morphism through the subcategory it locally generates is
representable by algebraic spaces** as soon as the 1-morphism is. -/
theorem isRepresentableByAlgebraicSpaces_toLocalImage
    {𝒰 : CatFiberedInGroupoids.{u, u, u + 1, u + 1} (BigFppfOver B S hS)}
    {𝒴 : AlgebraicStacks.{u, w} B S hS} (g : 𝒰 ⟶ 𝒴.val)
    (hg : IsRepresentableByAlgebraicSpaces B S hS g.hom) :
    IsRepresentableByAlgebraicSpaces B S hS (toLocalImage g).hom := by
  have : (fullSubcategoryBasedInclusion 𝒴 (localImage g)).toFunctor.Full :=
    ObjectProperty.full_ι (localImage g)
  have : (fullSubcategoryBasedInclusion 𝒴 (localImage g)).toFunctor.Faithful :=
    ObjectProperty.faithful_ι (localImage g)
  intro W _ _ y hy
  obtain ⟨Fs, hFs, ⟨e⟩⟩ := hg W
    (y ⋙ (fullSubcategoryBasedInclusion 𝒴 (localImage g)).toFunctor) hy
  refine ⟨Fs, hFs, ⟨(TwoFibreProductOver.mapBaseFstEquivalenceOver
    (pT := Over.map W.hom) (p𝒜 := 𝒰.val.p) (G := y)
    (F := CatFiberedInGroupoids.homFunctor (toLocalImage g))
    (b := (fullSubcategoryBasedInclusion 𝒴 (localImage g)).toFunctor) rfl).trans e⟩⟩

section Representability

attribute [local instance] Space.isFlat_isStableUnderBaseChange
  Space.isLocallyOfFinitePresentation_isStableUnderBaseChange

variable {𝒰 : CatFiberedInGroupoids.{u, u, u + 1, u + 1} (BigFppfOver B S hS)}
  {𝒴 : AlgebraicStacks.{u, w} B S hS} (g : 𝒰 ⟶ 𝒴.val)

/-- **The base change of the inclusion of the subcategory locally generated by `g` along a
scheme-valued point of `𝒴` is a stack in setoids.** -/
theorem isStackInSetoids_twoFibreProduct_localImage (V : BigFppfOver B S hS)
    (y : (schemeFibredCategory B S hS V).val ⥤ᵇ 𝒴.val.val) :
    (twoFibreProduct B S hS 𝒴.val (localImageStack g) (schemeFibredCategory B S hS V)
        (fullSubcategoryBasedInclusion 𝒴 (localImage g)) y).val.p.IsStackInSetoids
      (BigFppfOver.topology B S hS) := by
  obtain ⟨h𝒴fib, ⟨h𝒴stk, -⟩, -, -⟩ := 𝒴.property
  have : (fullSubcategoryBasedInclusion 𝒴 (localImage g)).toFunctor.Faithful :=
    ObjectProperty.faithful_ι (localImage g)
  exact Functor.isStackInSetoids_twoFibreProduct (BigFppfOver.topology B S hS)
    (isStack_localImageStack B S hS g) (localImageStack g).isFiberedInGroupoids
    (isStackInSetoids_of_isRepresentableByAlgebraicSpace B S hS
      (schemeFibredCategory B S hS V)
      (isRepresentableByAlgebraicSpace_schemeFibredCategory B S hS V))
    h𝒴stk
    (BigFppfOver.isFibredOneMorphism_homFunctor B S hS
      (Bicategory.InducedBicategory.mkHom
        (fullSubcategoryBasedInclusion 𝒴 (localImage g)) : localImageStack g ⟶ 𝒴.val))
    (BigFppfOver.isFibredOneMorphism_homFunctor B S hS
      (Bicategory.InducedBicategory.mkHom y : schemeFibredCategory B S hS V ⟶ 𝒴.val))

/-- **The inclusion of the subcategory locally generated by a flat, surjective 1-morphism locally
of finite presentation out of a category representable by an algebraic space is representable by
algebraic spaces.** -/
theorem isRepresentableByAlgebraicSpaces_fullSubcategoryBasedInclusion_localImage
    (h𝒰 : IsRepresentableByAlgebraicSpace B S hS 𝒰)
    (hg : IsRepresentableByAlgebraicSpaces B S hS g.hom)
    (hsurj : RelativeProperty B S hS (Space.surjectiveMorphismProperty B S hS) (toLocalImage g))
    (hflat : RelativeProperty B S hS
      (fun ⦃X Y : AlgebraicSpaces B S hS⦄ (k : X ⟶ Y) => Space.IsFlat B S hS k.hom)
      (toLocalImage g))
    (hlfp : RelativeProperty B S hS
      (fun ⦃X Y : AlgebraicSpaces B S hS⦄ (k : X ⟶ Y) =>
        Space.IsLocallyOfFinitePresentation B S hS k.hom) (toLocalImage g)) :
    IsRepresentableByAlgebraicSpaces B S hS
      (fullSubcategoryBasedInclusion 𝒴 (localImage g)) := by
  have hflatloc : MorphismProperty.IsLocalAtTarget
      (fun ⦃X Y : AlgebraicSpaces B S hS⦄ (k : X ⟶ Y) => Space.IsFlat B S hS k.hom)
      (Space.Topology.fppf.precoverage.{u, u + 1} B S hS) :=
    (Space.isFlat_isLocalAtTarget_fpqc B S hS).of_le
      (Space.fppfPrecoverage_le_fpqcPrecoverage B S hS)
  have htoLocal := isRepresentableByAlgebraicSpaces_toLocalImage B S hS g hg
  refine isRepresentableByAlgebraicSpaces_of_forall_twoFibreProduct B S hS 𝒴.val
    (localImageStack g) (fullSubcategoryBasedInclusion 𝒴 (localImage g)) ?_
  intro V y
  have hy : IsRepresentableByAlgebraicSpaces B S hS y :=
    isRepresentableByAlgebraicSpaces_of_isAlgebraicStack B S hS 𝒴.property
      (isRepresentableByAlgebraicSpace_schemeFibredCategory B S hS V)
      (Bicategory.InducedBicategory.mkHom y : schemeFibredCategory B S hS V ⟶ 𝒴.val)
  refine (isRepresentableByAlgebraicSpace_twoFibreProduct_swap_iff B S hS 𝒴.val
    (localImageStack g) (schemeFibredCategory B S hS V)
    (fullSubcategoryBasedInclusion 𝒴 (localImage g)) y).1
    (isRepresentableByAlgebraicSpace_of_isStackInSetoids_of_baseChange B S hS
    (toLocalImage g)
    (Bicategory.InducedBicategory.mkHom
      (twoFibreProductFst B S hS 𝒴.val (localImageStack g) (schemeFibredCategory B S hS V)
        (fullSubcategoryBasedInclusion 𝒴 (localImage g)) y))
    (isStackInSetoids_twoFibreProduct_localImage B S hS g V y) h𝒰 htoLocal hsurj hflat hlfp
    (isRepresentableByAlgebraicSpaces_twoFibreProductFst B S hS 𝒴.val (localImageStack g)
      (schemeFibredCategory B S hS V) (fullSubcategoryBasedInclusion 𝒴 (localImage g)) y hy))

/-- **The subcategory locally generated by a flat presentation out of a category representable by
an algebraic space is an algebraic stack.** -/
theorem isAlgebraicStack_fullSubcategoryBased_localImage
    (h𝒰 : IsRepresentableByAlgebraicSpace B S hS 𝒰)
    (hg : IsRepresentableByAlgebraicSpaces B S hS g.hom)
    (hsurj : RelativeProperty B S hS (Space.surjectiveMorphismProperty B S hS) (toLocalImage g))
    (hflat : RelativeProperty B S hS
      (fun ⦃X Y : AlgebraicSpaces B S hS⦄ (k : X ⟶ Y) => Space.IsFlat B S hS k.hom)
      (toLocalImage g))
    (hlfp : RelativeProperty B S hS
      (fun ⦃X Y : AlgebraicSpaces B S hS⦄ (k : X ⟶ Y) =>
        Space.IsLocallyOfFinitePresentation B S hS k.hom) (toLocalImage g)) :
    IsAlgebraicStack.{u, w} B S hS (fullSubcategoryBased 𝒴 (localImage g)) :=
  isAlgebraicStack_source_of_isRepresentableByAlgebraicSpaces.{u, w} B S hS
    (𝒳 := localImageStack g) (𝒴 := 𝒴.val)
    (Bicategory.InducedBicategory.mkHom (fullSubcategoryBasedInclusion 𝒴 (localImage g)))
    (isRepresentableByAlgebraicSpaces_fullSubcategoryBasedInclusion_localImage B S hS g h𝒰 hg
      hsurj hflat hlfp)
    𝒴.property

end Representability

section FieldPoint

variable (𝒴 : AlgebraicStacks.{u, w} B S hS) (F : FieldSpectrum B S hS)
  (g : (schemeFibredCategory B S hS F.base) ⟶ 𝒴.val)

/-- The algebraic space representing the algebraic stack of the spectrum of a field: the
presheaf represented by its object of the site. -/
abbrev fieldPointSpace : AlgebraicSpaces B S hS :=
  ⟨yoneda.obj F.base, isAlgebraicSpace_yoneda B S hS F.base⟩

/-- The identification of the algebraic stack of the spectrum of a field with the category of
elements of the presheaf it represents. -/
abbrev fieldPointEquivalenceOver :
    StacksRepresentableCFG.EquivalenceOver
      (schemeFibredCategory B S hS F.base).val.p
      (presheafOfCategories ((fieldPointSpace B S hS F).obj ⋙ typeToCat)).p :=
  PresheafOfCategories.sliceElementsEquivalenceOver F.base

variable (R : AlgebraicSpaces B S hS)
  (eR : StacksRepresentableCFG.EquivalenceOver
    (SelfIntersection.relation B S hS (schemeFibredCategory B S hS F.base) 𝒴.val g.hom).val.p
    (presheafOfCategories (R.obj ⋙ typeToCat)).p)

/-- **A property of the target morphism of the self-intersection groupoid is a relative property
of the first projection of the self-intersection.** -/
theorem relativeProperty_relationSquareFst_of_prop_relationTarget
    (P : MorphismProperty (AlgebraicSpaces B S hS)) [P.IsStableUnderBaseChange]
    [P.IsLocalAtTarget (Space.Topology.fppf.precoverage.{u, u} B S hS)]
    (hP : P (SelfIntersection.relationTarget (fieldPointEquivalenceOver B S hS F) eR)) :
    RelativeProperty B S hS P
      (CatFiberedInGroupoids.twoFibreProductSquare.{u, u, u + 1, u + 1} g g).fst := by
  have hRrep : IsRepresentableByAlgebraicSpace B S hS
      (SelfIntersection.relation B S hS (schemeFibredCategory B S hS F.base) 𝒴.val g.hom) :=
    ⟨R.obj, R.property, ⟨eR⟩⟩
  have h𝒰rep : IsRepresentableByAlgebraicSpace B S hS
      (schemeFibredCategory B S hS F.base) :=
    isRepresentableByAlgebraicSpace_schemeFibredCategory B S hS F.base
  have hfst : IsRepresentableByAlgebraicSpaces B S hS
      (CatFiberedInGroupoids.twoFibreProductSquare.{u, u, u + 1, u + 1} g g).fst.hom :=
    isRepresentableByAlgebraicSpaces_of_isRepresentableByAlgebraicSpace B S hS _ hRrep h𝒰rep
  exact (hasRelativeProperty_iff_prop_representingMap.{u, u} B S hS P
    (CatFiberedInGroupoids.twoFibreProductSquare.{u, u, u + 1, u + 1} g g).fst hfst
    R.obj (fieldPointSpace B S hS F).obj R.property (fieldPointSpace B S hS F).property eR
    (fieldPointEquivalenceOver B S hS F)).mpr hP

/-- **The target morphism of the self-intersection of a field-valued point is flat.** -/
theorem isFlat_relationTarget :
    Space.IsFlat B S hS
      (SelfIntersection.relationTarget (fieldPointEquivalenceOver B S hS F) eR).hom :=
  Space.isFlat_to_field B S hS R.property F.isSpec _

/-- **The target morphism of the self-intersection of a point is surjective.** -/
theorem isSurjective_relationTarget :
    Space.IsSurjective B S hS
      (SelfIntersection.relationTarget (fieldPointEquivalenceOver B S hS F) eR).hom :=
  QuotientAtlas.isSurjective_target
    (SelfIntersection.selfIntersectionGroupoid (fieldPointEquivalenceOver B S hS F) eR
      (SelfIntersection.isFiberedInSetoids_source (fieldPointEquivalenceOver B S hS F)))

/-- **The target morphism of the self-intersection of a locally-of-finite-type field-valued point
is locally of finite presentation.** -/
theorem isLocallyOfFinitePresentation_relationTarget
    (hg : IsRepresentableByAlgebraicSpaces B S hS g.hom)
    (hglft : RelativeProperty B S hS
      (spaceProperty B S hS
        (fun _ _ h => Space.IsLocallyOfFiniteType B S hS h)) g) :
    Space.IsLocallyOfFinitePresentation B S hS
      (SelfIntersection.relationTarget (fieldPointEquivalenceOver B S hS F) eR).hom := by
  have hlat : (spaceProperty B S hS
      (fun _ _ h => Space.IsLocallyOfFiniteType B S hS h)).IsLocalAtTarget
      (Space.Topology.fppf.precoverage.{u, u} B S hS) :=
    (Space.isLocallyOfFiniteType_isLocalAtTarget_fpqc B S hS).of_le
      (Space.fppfPrecoverage_le_fpqcPrecoverage B S hS)
  have hbc : (spaceProperty B S hS
      (fun _ _ h => Space.IsLocallyOfFiniteType B S hS h)).IsStableUnderBaseChange :=
    Space.isLocallyOfFiniteType_isStableUnderBaseChange B S hS
  have hlft := SelfIntersection.prop_relationTarget B S hS
    (schemeFibredCategory B S hS F.base) 𝒴.val g (fieldPointSpace B S hS F) R
    (fieldPointEquivalenceOver B S hS F) eR
    (spaceProperty B S hS (fun _ _ h => Space.IsLocallyOfFiniteType B S hS h)) hg hglft
  exact Space.isLocallyOfFinitePresentation_of_isLocallyOfFiniteType B S hS R.property
    (fieldPointSpace B S hS F).property _
    (hasEtaleLocalProperty_isLocallyNoetherian_fieldSpectrum B S hS F) hlft

/-- **A property of the target morphism of the self-intersection is a relative property of the
factorization through the subcategory locally generated by the point.** -/
theorem relativeProperty_toLocalImage_of_prop_relationTarget
    (P : MorphismProperty (AlgebraicSpaces B S hS)) [P.IsStableUnderBaseChange]
    [P.IsLocalAtTarget (Space.Topology.fppf.precoverage.{u, u} B S hS)]
    (hP : P (SelfIntersection.relationTarget (fieldPointEquivalenceOver B S hS F) eR)) :
    RelativeProperty B S hS P (toLocalImage g) :=
  relativeProperty_toLocalImage g P
    (relativeProperty_relationSquareFst_of_prop_relationTarget B S hS 𝒴 F g R eR P hP)

/-- **The factorization of a locally-of-finite-type field-valued point through the subcategory it
locally generates is relatively surjective, flat and locally of finite presentation.** -/
theorem relativeProperty_surjective_flat_locallyOfFinitePresentation_toLocalImage
    (hg : IsRepresentableByAlgebraicSpaces B S hS g.hom)
    (hglft : RelativeProperty B S hS
      (spaceProperty B S hS
        (fun _ _ h => Space.IsLocallyOfFiniteType B S hS h)) g) :
    RelativeProperty B S hS (Space.surjectiveMorphismProperty B S hS) (toLocalImage g) ∧
      RelativeProperty B S hS
        (fun ⦃X Y : AlgebraicSpaces B S hS⦄ (k : X ⟶ Y) => Space.IsFlat B S hS k.hom)
        (toLocalImage g) ∧
      RelativeProperty B S hS
        (fun ⦃X Y : AlgebraicSpaces B S hS⦄ (k : X ⟶ Y) =>
          Space.IsLocallyOfFinitePresentation B S hS k.hom)
        (toLocalImage g) := by
  obtain ⟨Rf, hRf, ⟨eR⟩⟩ :=
    SelfIntersection.isRepresentableByAlgebraicSpace_relation_of_isAlgebraicStack B S hS
      (schemeFibredCategory B S hS F.base) 𝒴.val g.hom 𝒴.property
      (isRepresentableByAlgebraicSpace_schemeFibredCategory B S hS F.base)
  refine ⟨relativeProperty_toLocalImage_of_prop_relationTarget B S hS 𝒴 F g ⟨Rf, hRf⟩ eR
      (Space.surjectiveMorphismProperty B S hS)
      (isSurjective_relationTarget B S hS 𝒴 F g ⟨Rf, hRf⟩ eR),
    @relativeProperty_toLocalImage_of_prop_relationTarget B S hS 𝒴 F g ⟨Rf, hRf⟩ eR
      (fun ⦃X Y : AlgebraicSpaces B S hS⦄ (k : X ⟶ Y) => Space.IsFlat B S hS k.hom)
      (Space.isFlat_isStableUnderBaseChange B S hS)
      (Space.isFlat_isLocalAtTarget_fppf B S hS)
      (isFlat_relationTarget B S hS 𝒴 F g ⟨Rf, hRf⟩ eR),
    relativeProperty_toLocalImage_of_prop_relationTarget B S hS 𝒴 F g ⟨Rf, hRf⟩ eR
      (fun ⦃X Y : AlgebraicSpaces B S hS⦄ (k : X ⟶ Y) =>
        Space.IsLocallyOfFinitePresentation B S hS k.hom)
      (isLocallyOfFinitePresentation_relationTarget B S hS 𝒴 F g ⟨Rf, hRf⟩ eR hg hglft)⟩

/-- **The subcategory of `𝒴` locally generated by a locally-of-finite-type field-valued point is
an algebraic stack.** -/
theorem isAlgebraicStack_fullSubcategoryBased_localImage_fieldPoint
    (hg : IsRepresentableByAlgebraicSpaces B S hS g.hom)
    (hglft : RelativeProperty B S hS
      (spaceProperty B S hS
        (fun _ _ h => Space.IsLocallyOfFiniteType B S hS h)) g) :
    IsAlgebraicStack.{u, w} B S hS (fullSubcategoryBased 𝒴 (localImage g)) := by
  obtain ⟨hsurj, hflat, hlfp⟩ :=
    relativeProperty_surjective_flat_locallyOfFinitePresentation_toLocalImage
      B S hS 𝒴 F g hg hglft
  exact isAlgebraicStack_fullSubcategoryBased_localImage B S hS g
    (isRepresentableByAlgebraicSpace_schemeFibredCategory B S hS F.base) hg hsurj hflat hlfp

end FieldPoint

end AlgebraicGeometry.Stack

end
