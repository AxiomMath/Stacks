variable (p : ℕ) [NeZero p] [Fact p.Prime] {k : Type u} [Field k] [CharP k p]
  (𝒞 : BigFppfSite.{u}) (hS : 𝒞.Contains (Spec (.of (Polynomial k))))

/-- The right derived functors of `Γ(S, f_* -)` at `𝒪_𝒳`, lifted to the universe of the objects
of `𝒳`, are the cohomology of the global sections over the pointwise quotient of the restriction
of an injective resolution of `𝒪_𝒳`. -/
def cyclicRightDerivedIsoPointwise.{w}
    (R : InjectiveResolution (SheafOfModules.unit (FibredSite.ringStructureSheafCore 𝒞 _ hS
      (cyclicClassifyingStack.{u, w} p 𝒞 hS).val.val.p
        (cyclicClassifyingStack.{u, w} p 𝒞 hS).val.isFiberedInGroupoids .fppf))) (m : ℕ) :
    (cyclicBaseStackULift.{u, w} 𝒞 hS).obj
        (((cyclicPushforwardSections.{u, w} p 𝒞 hS).rightDerived m).obj
          (SheafOfModules.unit _)) ≅
      (((Stacks.CechTop.globalSectionsOverBase (cyclicPointwiseRing p 𝒞 hS)
        (cyclicPointwiseBaseRingHom p 𝒞 hS)).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj (((cyclicPointwiseRestriction p 𝒞 hS).mapHomologicalComplex
            (ComplexShape.up ℕ)).obj R.cocomplex)).homology m :=
  R.mapRightDerivedObjIsoOfCompIso (cyclicPushforwardSections.{u, w} p 𝒞 hS)
    (cyclicBaseStackULift.{u, w} 𝒞 hS) (cyclicPointwiseRestriction p 𝒞 hS)
    (Stacks.CechTop.globalSectionsOverBase (cyclicPointwiseRing p 𝒞 hS)
      (cyclicPointwiseBaseRingHom p 𝒞 hS))
    (cyclicPushforwardSectionsIsoPointwise.{u, w} p 𝒞 hS) m
    (hL := by
      unfold cyclicBaseStackULift
      exact (inferInstance :
        (ModuleCat.uliftFunctor.{u + 1} (cyclicBaseRing 𝒞 hS)).PreservesZeroMorphisms))
    (hR₁ := (inferInstance : (cyclicPointwiseRestriction p 𝒞 hS).PreservesZeroMorphisms))
    (hL' := by
      unfold cyclicBaseStackULift
      exact (inferInstance :
        (ModuleCat.uliftFunctor.{u + 1} (cyclicBaseRing 𝒞 hS)).PreservesHomology))

/-- **Stacks 07DC: `R^m Γ(S, f_* -)(𝒪_𝒳)` has `Γ(S, 𝒪_S) = k[x]` as a linear retract.** Let `k`
be a field of characteristic `p`, `S = Spec k[x]`, `𝒳 = [S/(ℤ/pℤ)]` and `f : 𝒳 ⟶ S` the structure
morphism. For every `m ≥ 0` there are a class `e` in the `m`-th right derived functor of
`Γ(S, f_* -)` at `𝒪_𝒳` and a `Γ(S, 𝒪_S)`-linear form `ψ` on it with `ψ e = 1`. -/
theorem exists_linearMap_rightDerived_cyclicPushforwardSections.{w} (m : ℕ) :
    ∃ (e : ((cyclicPushforwardSections.{u, w} p 𝒞 hS).rightDerived m).obj
        (SheafOfModules.unit _))
      (ψ : ((cyclicPushforwardSections.{u, w} p 𝒞 hS).rightDerived m).obj
          (SheafOfModules.unit _) ⟶ cyclicBaseStackRingModule.{u, w} 𝒞 hS),
      ψ.hom e = (1 : cyclicBaseStackRing.{u, w} 𝒞 hS) := by
  let R : InjectiveResolution (SheafOfModules.unit (FibredSite.ringStructureSheafCore 𝒞 _ hS
      (cyclicClassifyingStack.{u, w} p 𝒞 hS).val.val.p
        (cyclicClassifyingStack.{u, w} p 𝒞 hS).val.isFiberedInGroupoids .fppf)) :=
    injectiveResolution _
  obtain ⟨ζ'⟩ := nonempty_iso_homology_globalSections_cechFunctorOverBase p 𝒞 hS R m
  obtain ⟨e₀, Ψ₀, he₀⟩ := exists_homology_cechFunctorOverBase_cyclic p 𝒞 hS m
  let ζ := cyclicRightDerivedIsoPointwise.{u, w} p 𝒞 hS R m ≪≫ ζ'
  let up : ((cyclicPushforwardSections.{u, w} p 𝒞 hS).rightDerived m).obj
      (SheafOfModules.unit _) → (cyclicBaseStackULift.{u, w} 𝒞 hS).obj
        (((cyclicPushforwardSections.{u, w} p 𝒞 hS).rightDerived m).obj
          (SheafOfModules.unit _)) := fun x => ULift.up x
  obtain ⟨ψ, hψ⟩ := ModuleCat.exists_hom_self_apply_eq_one
    (((cyclicPushforwardSections.{u, w} p 𝒞 hS).rightDerived m).obj (SheafOfModules.unit _))
    (fun x => (Ψ₀ (ζ.hom (up x))).down)
    (fun x y => by
      change (Ψ₀ (ζ.hom (up x + up y))).down = (Ψ₀ (ζ.hom (up x))).down + (Ψ₀ (ζ.hom (up y))).down
      rw [map_add, map_add]
      rfl)
    (fun a x => by
      refine (congrArg (fun y => (Ψ₀ y).down) (ζ.hom.hom.map_smul a (up x))).trans ?_
      refine (congrArg ULift.down (Ψ₀.hom.map_smul a (ζ.hom (up x)))).trans ?_
      let r : (cyclicPointwiseRing p 𝒞 hS).obj.obj (op (cyclicPointwiseUnitObject p 𝒞 hS)) :=
        (Ψ₀ (ζ.hom (up x))).down
      change Stacks.CechTop.baseToSections (cyclicPointwiseRing p 𝒞 hS)
        (cyclicPointwiseBaseRingHom p 𝒞 hS) (op (cyclicPointwiseUnitObject p 𝒞 hS)) a * r = _
      exact congrArg (· * r) (baseToSections_cyclicPointwiseUnitObject p 𝒞 hS a))
    (ζ.inv e₀).down (by
      change (Ψ₀ (ζ.hom (up (ζ.inv e₀).down))).down = _
      rw [show up (ζ.inv e₀).down = ζ.inv e₀ from rfl, Iso.inv_hom_id_apply, he₀]
      rfl)
  exact ⟨(ζ.inv e₀).down, ψ, hψ⟩

end Final


