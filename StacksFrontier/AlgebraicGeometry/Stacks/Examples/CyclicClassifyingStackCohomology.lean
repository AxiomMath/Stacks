namespace CategoryTheory.InjectiveResolution

variable {C D E C' : Type*} [Category* C] [Category* D] [Category* E] [Category* C'] [Abelian C]
  [HasInjectiveResolutions C] [Abelian D] [Abelian E] [HasZeroMorphisms C']

/-- **Right derived functors through an isomorphism of composites.** If `F ⋙ L ≅ R₁ ⋙ R₂` with
`L` preserving homology, then `L` of `Rⁿ F(X)` is the `n`-th cohomology of `R₂ (R₁ I)` for an
injective resolution `I` of `X`. -/
def mapRightDerivedObjIsoOfCompIso {X : C} (I : InjectiveResolution X) (F : C ⥤ D) [F.Additive]
    (L : D ⥤ E) [hL : L.PreservesZeroMorphisms] [hL' : L.PreservesHomology] (R₁ : C ⥤ C')
    [hR₁ : R₁.PreservesZeroMorphisms] (R₂ : C' ⥤ E) [R₂.PreservesZeroMorphisms]
    (Φ : F ⋙ L ≅ R₁ ⋙ R₂) (n : ℕ) :
    L.obj ((F.rightDerived n).obj X) ≅
      ((R₂.mapHomologicalComplex _).obj ((R₁.mapHomologicalComplex _).obj I.cocomplex)).homology
        n :=
  L.mapIso (I.isoRightDerivedObj F n) ≪≫
    ((((F.mapHomologicalComplex _).obj I.cocomplex).sc n).mapHomologyIso L).symm ≪≫
    (HomologicalComplex.homologyFunctor E _ n).mapIso
      (HomologicalComplex.Hom.isoOfComponents
        (C₁ := (L.mapHomologicalComplex _).obj ((F.mapHomologicalComplex _).obj I.cocomplex))
        (C₂ := (R₂.mapHomologicalComplex _).obj ((R₁.mapHomologicalComplex _).obj I.cocomplex))
        (fun i => Φ.app (I.cocomplex.X i))
        (fun i j _ => (Φ.hom.naturality (I.cocomplex.d i j)).symm))

end CategoryTheory.InjectiveResolution

/-- **A linear form to the ring from an additive, homogeneous function.** -/
theorem ModuleCat.exists_hom_self_apply_eq_one {R : Type*} [Ring R] (M : ModuleCat R)
    (g : M → R) (hadd : ∀ x y, g (x + y) = g x + g y) (hsmul : ∀ (a : R) x, g (a • x) = a * g x)
    (e : M) (he : g e = 1) : ∃ ψ : M ⟶ ModuleCat.of R R, ψ.hom e = 1 :=
  ⟨ModuleCat.ofHom { toFun := g, map_add' := hadd, map_smul' := hsmul }, he⟩

